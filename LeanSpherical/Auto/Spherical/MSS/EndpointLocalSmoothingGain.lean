theorem integrable_norm_pow_four_prod_of_continuous_of_interval_integral_bound
    {F : Real → Euclidean 2 → Complex}
    (hFcont : Continuous (Function.uncurry F))
    (hFspatial : ∀ t : Icc (1 : Real) 2,
      Integrable (fun x : Euclidean 2 => ‖F t.1 x‖ ^ 4) volume)
    {g : Real → Real}
    (hg : Integrable g (volume.restrict (Icc (1 : Real) 2)))
    (hbound : ∀ t : Icc (1 : Real) 2,
      (∫ x : Euclidean 2, ‖F t.1 x‖ ^ 4) ≤ g t.1) :
    Integrable (fun p : Real × Euclidean 2 => ‖F p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  let : IsFiniteMeasure ν := by
    dsimp only [ν]
    infer_instance
  let G : Real × Euclidean 2 → Real := fun p => ‖F p.1 p.2‖ ^ 4
  have hGmeas : AEStronglyMeasurable G (ν.prod volume) :=
    (hFcont.norm.pow 4).aestronglyMeasurable
  change Integrable G (ν.prod volume)
  refine (integrable_prod_iff hGmeas).2 ?_
  constructor
  · filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
    simpa only [G] using hFspatial ⟨t, ht⟩
  · have hGoutermeas : AEStronglyMeasurable (fun t : Real =>
        ∫ x : Euclidean 2, G (t, x)) ν :=
      ((hFcont.norm.pow 4).stronglyMeasurable.integral_prod_right').aestronglyMeasurable
    have hGouter : Integrable (fun t : Real => ∫ x : Euclidean 2, G (t, x)) ν := by
      refine Integrable.mono' (by simpa only [ν] using hg) hGoutermeas ?_
      filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
      have hnonneg : 0 ≤ ∫ x : Euclidean 2, G (t, x) :=
        integral_nonneg fun x => pow_nonneg (norm_nonneg _) _
      rw [Real.norm_of_nonneg hnonneg]
      simpa only [G] using hbound ⟨t, ht⟩
    convert hGouter using 1
    funext t
    apply integral_congr_ae
    filter_upwards with x
    change ‖‖F t x‖ ^ (4 : Nat)‖ = ‖F t x‖ ^ 4
    rw [Real.norm_of_nonneg (pow_nonneg (norm_nonneg _) _)]

theorem aux_integrable_norm_pow_four_prod_of_continuous_of_spatial_bound
    {F U : Real → Euclidean 2 → Complex}
    (hFcont : Continuous (Function.uncurry F))
    (hUprod : Integrable (fun p : Real × Euclidean 2 => ‖U p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume))
    (hFspatial : ∀ t : Icc (1 : Real) 2,
      Integrable (fun x : Euclidean 2 => ‖F t.1 x‖ ^ 4) volume)
    {c : Real}
    (hbound : ∀ t : Icc (1 : Real) 2,
      (∫ x : Euclidean 2, ‖F t.1 x‖ ^ 4) ≤
        c * ∫ x : Euclidean 2, ‖U t.1 x‖ ^ 4) :
    Integrable (fun p : Real × Euclidean 2 => ‖F p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  let : IsFiniteMeasure ν := by
    dsimp only [ν]
    infer_instance
  let G : Real × Euclidean 2 → Real := fun p => ‖F p.1 p.2‖ ^ 4
  let V : Real × Euclidean 2 → Real := fun p => ‖U p.1 p.2‖ ^ 4
  have hVprod : Integrable V (ν.prod volume) := by
    simpa only [V, ν] using hUprod
  have hVouter : Integrable (fun t : Real => ∫ x : Euclidean 2, V (t, x)) ν :=
    hVprod.integral_prod_left
  have hGmeas : AEStronglyMeasurable G (ν.prod volume) :=
    (hFcont.norm.pow 4).aestronglyMeasurable
  change Integrable G (ν.prod volume)
  refine (integrable_prod_iff hGmeas).2 ?_
  constructor
  · filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
    simpa only [G] using hFspatial ⟨t, ht⟩
  · have hGoutermeas : AEStronglyMeasurable (fun t : Real =>
        ∫ x : Euclidean 2, G (t, x)) ν :=
      ((hFcont.norm.pow 4).stronglyMeasurable.integral_prod_right').aestronglyMeasurable
    have hdom : Integrable (fun t : Real => c * ∫ x : Euclidean 2, V (t, x)) ν :=
      hVouter.const_mul c
    have hGouter : Integrable (fun t : Real => ∫ x : Euclidean 2, G (t, x)) ν := by
      refine Integrable.mono' hdom hGoutermeas ?_
      filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
      have hnonneg : 0 ≤ ∫ x : Euclidean 2, G (t, x) :=
        integral_nonneg fun x => pow_nonneg (norm_nonneg _) _
      have hle : (∫ x : Euclidean 2, G (t, x)) ≤
          c * ∫ x : Euclidean 2, V (t, x) := by
        simpa only [G, V] using hbound ⟨t, ht⟩
      rw [Real.norm_of_nonneg hnonneg]
      exact hle
    convert hGouter using 1
    funext t
    apply integral_congr_ae
    filter_upwards with x
    change ‖‖F t x‖ ^ (4 : Nat)‖ = ‖F t x‖ ^ 4
    rw [Real.norm_of_nonneg (pow_nonneg (norm_nonneg _) _)]

private theorem aux_circleEndpointWaveContribution_slice_eq_aux
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat)
