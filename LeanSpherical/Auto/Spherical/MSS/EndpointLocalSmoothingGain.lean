theorem aux_dyadicTimeScale_rpow_shift_four_le
    (j : Nat) (ρ : Real) :
    (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ (1 + 4 * ρ) ≤
      (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ (-3 + 4 * ρ) := by
  have hδ : 0 < _root_.Auto.Spherical.MSS.dyadicTimeScale j := by
    dsimp [_root_.Auto.Spherical.MSS.dyadicTimeScale]
    exact zpow_pos (by norm_num) _
  rw [show 1 + 4 * ρ = (-3 + 4 * ρ) + 4 by ring,
    Real.rpow_add hδ]
  exact (mul_le_iff_le_one_right (Real.rpow_pos_of_pos hδ _)).2
    (Real.rpow_le_one hδ.le (aux_dyadicTimeScale_le_one j) (by norm_num))

private theorem aux_integrable_norm_pow_four_of_dyadicBall_majorant
    (u : SchwartzMap (Euclidean 2) Complex) (G : Euclidean 2 → Complex)
    (hGcont : Continuous G) {a K : Real}
    (hpoint : ∀ x : Euclidean 2, ‖G x‖ ≤ a *
      (K * _root_.Auto.HardyLittlewoodMaximal.dyadicBallMaximal 2
        (u : Euclidean 2 → Complex) x)) :
    Integrable (fun x : Euclidean 2 => ‖G x‖ ^ 4) volume := by
  obtain ⟨H, hH, hhardy⟩ :=
    _root_.Auto.HardyLittlewoodMaximal.dyadic_hardy_littlewood_maximal_strong_type_schwartz
      (d := 2) (by norm_num) (p := 4) (by norm_num)
  let M : Euclidean 2 → Real :=
    _root_.Auto.HardyLittlewoodMaximal.dyadicBallMaximal 2
      (u : Euclidean 2 → Complex)
  have hM := hhardy u
  have hMnonneg (x : Euclidean 2) : 0 ≤ M x := ENNReal.toReal_nonneg
  have hMpowInt : Integrable (fun x : Euclidean 2 => M x ^ 4) := by
    have h := hM.1.integrable_norm_rpow (by norm_num : (ENNReal.ofReal (4 : Real)) ≠ 0)
      ENNReal.ofReal_ne_top
    convert h using 1
    funext x
    rw [Real.norm_eq_abs, abs_of_nonneg (hMnonneg x),
      ENNReal.toReal_ofReal (by norm_num : (0 : Real) ≤ 4)]
    norm_num
  have hpowpoint (x : Euclidean 2) :
      ‖G x‖ ^ 4 ≤ (a ^ (4 : Nat) * K ^ (4 : Nat)) * M x ^ 4 := by
    have h := hpoint x
    change ‖G x‖ ≤ a * (K * M x) at h
    calc
      ‖G x‖ ^ 4 ≤ (a * (K * M x)) ^ 4 :=
        pow_le_pow_left₀ (norm_nonneg _) h 4
      _ = (a ^ (4 : Nat) * K ^ (4 : Nat)) * M x ^ 4 := by ring
  have hdomInt : Integrable (fun x : Euclidean 2 =>
      (a ^ (4 : Nat) * K ^ (4 : Nat)) * M x ^ 4) := hMpowInt.const_mul _
  refine Integrable.mono' hdomInt (hGcont.norm.pow 4).aestronglyMeasurable ?_
  filter_upwards with x
  change ‖‖G x‖ ^ (4 : Nat)‖ ≤ _
  rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (norm_nonneg _) _)]
  exact hpowpoint x

private theorem aux_integrable_norm_pow_four_aux_circleAnnularEndpointWaveContribution
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Icc (1 : Real) 2)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun x : Euclidean 2 =>
      ‖aux_circleAnnularEndpointWaveContribution C σ j t.1 f x‖ ^ 4) volume := by
