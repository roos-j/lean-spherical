    (max
      (_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize
        (aux_circleEndpointTimeDerivativeInputProfile C .plus))
      (_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize
        (aux_circleEndpointTimeDerivativeInputProfile C .minus)))
  refine ⟨A, le_max_left _ _, ?_⟩
  intro σ
  cases σ <;> dsimp [A]
  · exact (le_max_left _ _).trans (le_max_right _ _)
  · exact (le_max_right _ _).trans (le_max_right _ _)

theorem exists_integral_norm_pow_four_circleEndpointTimeDerivativeInput_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
      (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      (∫ x : Euclidean 2, ‖circleEndpointTimeDerivativeInput C σ j f x‖ ^ 4) ≤
        B * ∫ x : Euclidean 2, ‖f x‖ ^ 4 := by
  rcases aux_hasCircleEndpointTimeDerivativeInputUniformKernelBound C with
    ⟨A, hA, hkernel⟩
  obtain ⟨K, hK, hterm⟩ :=
    _root_.Auto.MikhlinHormander.uniform_relativeSchwartzMultiplierAt_majorant_of_kernel_bound
      (aux_circleEndpointTimeDerivativeInputProfile C) hA hkernel
  obtain ⟨H, hH, hhardy⟩ :=
    _root_.Auto.HardyLittlewoodMaximal.dyadic_hardy_littlewood_maximal_strong_type_schwartz
      (d := 2) (by norm_num) (p := 4) (by norm_num)
  refine ⟨K ^ (4 : Nat) * H, by positivity, ?_⟩
  intro σ j f
  let E : Euclidean 2 → Complex := circleEndpointTimeDerivativeInput C σ j f
  let M : Euclidean 2 → Real :=
    _root_.Auto.HardyLittlewoodMaximal.dyadicBallMaximal 2
      (f : Euclidean 2 → Complex)
  have hM := hhardy f
  have hMnonneg (x : Euclidean 2) : 0 ≤ M x := ENNReal.toReal_nonneg
  have hMpowInt : Integrable (fun x : Euclidean 2 => M x ^ 4) := by
    have h := hM.1.integrable_norm_rpow (by norm_num : (ENNReal.ofReal (4 : Real)) ≠ 0)
      ENNReal.ofReal_ne_top
    convert h using 1
    funext x
    rw [Real.norm_eq_abs, abs_of_nonneg (hMnonneg x),
      ENNReal.toReal_ofReal (by norm_num : (0 : Real) ≤ 4)]
    norm_num
  have hEcont : Continuous E := by
    rw [show E = fun x =>
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
        (aux_circleEndpointTimeDerivativeInputProfile C σ)
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) f x by
      funext x
      exact aux_circleEndpointTimeDerivativeInput_eq_relativeMultiplierAt C σ j f x]
    exact _root_.Auto.MikhlinHormander.continuous_relativeSchwartzMultiplierAt
      (aux_circleEndpointTimeDerivativeInputProfile C σ) f
      (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j)
  have hpoint (x : Euclidean 2) : ‖E x‖ ^ 4 ≤ K ^ 4 * M x ^ 4 := by
    have h : ‖E x‖ ≤ K * M x := by
      dsimp [E, M]
      rw [aux_circleEndpointTimeDerivativeInput_eq_relativeMultiplierAt]
      exact hterm σ f
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) x
    calc
      ‖E x‖ ^ 4 ≤ (K * M x) ^ 4 :=
        pow_le_pow_left₀ (norm_nonneg _) h 4
      _ = K ^ 4 * M x ^ 4 := by ring
  have hdomInt : Integrable (fun x : Euclidean 2 => K ^ 4 * M x ^ 4) :=
    hMpowInt.const_mul _
  have hEpowInt : Integrable (fun x : Euclidean 2 => ‖E x‖ ^ 4) := by
    refine Integrable.mono' hdomInt (hEcont.norm.pow 4).aestronglyMeasurable ?_
    filter_upwards with x
    change ‖‖E x‖ ^ (4 : Nat)‖ ≤ _
    rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (norm_nonneg _) _)]
    exact hpoint x
  have hfinal :
      (∫ x : Euclidean 2, ‖circleEndpointTimeDerivativeInput C σ j f x‖ ^ 4) ≤
        (K ^ 4 * H) * ∫ x : Euclidean 2, ‖f x‖ ^ 4 := by
    calc
      (∫ x : Euclidean 2, ‖circleEndpointTimeDerivativeInput C σ j f x‖ ^ 4) =
          ∫ x : Euclidean 2, ‖E x‖ ^ 4 := rfl
      _ ≤ ∫ x : Euclidean 2, K ^ 4 * M x ^ 4 :=
        integral_mono hEpowInt hdomInt hpoint
      _ = K ^ 4 * ∫ x : Euclidean 2, M x ^ 4 := by rw [integral_const_mul]
      _ ≤ K ^ 4 * (H * ∫ x : Euclidean 2, ‖f x‖ ^ 4) := by
        apply mul_le_mul_of_nonneg_left
          (show (∫ x : Euclidean 2, M x ^ 4) ≤ H * ∫ x : Euclidean 2, ‖f x‖ ^ 4 by
            convert hM.2 using 1
            · apply integral_congr_ae
              filter_upwards with x
              change M x ^ (4 : Nat) = M x ^ (4 : Real)
              exact (Real.rpow_natCast (M x) 4).symm
            · congr 1
              apply integral_congr_ae
              filter_upwards with x
              exact (Real.rpow_natCast ‖f x‖ 4).symm)
          (by positivity)
      _ = (K ^ 4 * H) * ∫ x : Euclidean 2, ‖f x‖ ^ 4 := by ring
  exact hfinal

theorem aux_dyadicFrequencyPower_eq_dyadicTimeScale
    (j : Nat) (ρ : Real) :
    (2 : Real) ^ ((j : Real) * (1 - 4 * ρ)) =
      (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ (-1 + 4 * ρ) := by
  let R : Real := (2 : Real) ^ j
  have hR : 0 ≤ R := by
    dsimp [R]
    positivity
  have hδ : _root_.Auto.Spherical.MSS.dyadicTimeScale j = R⁻¹ := by
    simp [R, _root_.Auto.Spherical.MSS.dyadicTimeScale, zpow_neg]
  rw [hδ, ← Real.rpow_neg_eq_inv_rpow]
  rw [show R = (2 : Real) ^ (j : Real) by
    dsimp [R]
    rw [Real.rpow_natCast]]
  rw [← Real.rpow_mul (by norm_num : (0 : Real) ≤ 2)]
  congr 1
  ring

theorem aux_norm_inv_circleEndpointDyadicNormalization_pow_four
    (j : Nat) :
    ‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 =
      (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ (2 : Nat) := by
  let R : Real := (2 : Real) ^ j
  have hR : 0 ≤ R := by
    dsimp [R]
    positivity
  have hRpos : 0 < R := by
    dsimp [R]
    positivity
  have hRne : R ≠ 0 := ne_of_gt hRpos
  have hsqrt : 0 < Real.sqrt R := Real.sqrt_pos.2 hRpos
  have hδ : _root_.Auto.Spherical.MSS.dyadicTimeScale j = R⁻¹ := by
    simp [R, _root_.Auto.Spherical.MSS.dyadicTimeScale, zpow_neg]
  rw [norm_inv, norm_circleEndpointDyadicNormalization]
  change (Real.sqrt R)⁻¹ ^ 4 = _
  rw [hδ, inv_pow]
  field_simp [hRne]
  nlinarith [Real.sq_sqrt hR]

theorem aux_dyadicTimeScale_le_one (j : Nat) :
    _root_.Auto.Spherical.MSS.dyadicTimeScale j ≤ 1 := by
