        ‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 =
      (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ (-2 : Real) := by
  let R : Real := (2 : Real) ^ j
  have hR : 0 ≤ R := by
    dsimp [R]
    positivity
  have hRpos : 0 < R := by
    dsimp [R]
    positivity
  have hRne : R ≠ 0 := ne_of_gt hRpos
  have hδ : _root_.Auto.Spherical.MSS.dyadicTimeScale j = R⁻¹ := by
    simp [R, _root_.Auto.Spherical.MSS.dyadicTimeScale, zpow_neg]
  rw [aux_norm_inv_circleEndpointDyadicNormalization_pow_four, hδ]
  change ‖(R : Complex)‖ ^ 4 * (R⁻¹) ^ 2 = (R⁻¹) ^ (-2 : Real)
  rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hR,
    Real.rpow_neg (inv_nonneg.mpr hR)]
  have hright : (R⁻¹ ^ (2 : Real))⁻¹ = R ^ 2 := by
    norm_num [Real.rpow_two, inv_pow]
  rw [hright]
  rw [inv_pow]
  field_simp [hRne]

