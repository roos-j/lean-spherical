/-- Uniform finite-order derivative bounds for the complete compact-annular
time-derivative family. -/
private theorem exists_unif_norm_iteratedFDeriv_circleAnnularEndptTimeDerivSchwartzFamily_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) (n : Nat) :
    ∃ B : Real, 0 ≤ B ∧ ∀ (u : aux_CircleAnnularEndpointLocalIndex)
      (η : Euclidean 2),
      ‖iteratedFDeriv Real n
        (aux_circleAnnularEndpointTimeDerivativeSchwartzFamily C u :
          Euclidean 2 → Complex) η‖ ≤ B := by
  choose H hHpos hH using fun i : Nat =>
    exists_unif_norm_iteratedFDeriv_circleEndptScRadialAmplitudeTimeDerivComp_le i
  let qS : SchwartzMap (Euclidean 2) Complex :=
    _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
  let q : Euclidean 2 → Complex := qS
  let c : Complex := ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex)
  let B : Real := ‖c‖ * ∑ i ∈ Finset.range (n + 1),
    (n.choose i : Real) * H i * SchwartzMap.seminorm Complex 0 (n - i) qS
  have hqnonneg (m : Nat) : 0 ≤ SchwartzMap.seminorm Complex 0 m qS := by
    exact le_trans (norm_nonneg _) (qS.norm_iteratedFDeriv_le_seminorm Complex m 0)
  have hB : 0 ≤ B := by
    dsimp [B]
    apply mul_nonneg (norm_nonneg _)
    apply Finset.sum_nonneg
    intro i hi
    exact mul_nonneg
      (mul_nonneg (by positivity) (hHpos i).le)
      (hqnonneg (n - i))
  refine ⟨B, hB, ?_⟩
  intro u η
  let K : Set (Euclidean 2) :=
    Metric.closedBall 0 (16 : Real) ∩ {y : Euclidean 2 | (1 / 4 : Real) ≤ ‖y‖}
  have hKclosed : IsClosed K := by
    dsimp [K]
    apply IsClosed.inter Metric.isClosed_closedBall
    exact isClosed_le continuous_const continuous_norm
  have htsupp : tsupport
      (aux_circleAnnularEndpointTimeDerivativeSchwartzFamily C u :
        Euclidean 2 → Complex) ⊆ K := by
    change closure (Function.support
      (aux_circleAnnularEndpointTimeDerivativeSchwartzFamily C u :
        Euclidean 2 → Complex)) ⊆ K
    exact closure_minimal
      (circleAnnularEndpointTimeDerivativeSchwartzFamily_support_subset_annulus C u) hKclosed
  by_cases hηK : η ∈ K
  · have hηouter : ‖η‖ ≤ 16 := by
      simpa only [K, Metric.mem_closedBall, dist_zero_right] using hηK.1
    have hηinner : (1 / 4 : Real) ≤ ‖η‖ := hηK.2
    have hηne : η ≠ 0 := by
      intro hzero
      subst η
      norm_num at hηinner
    let s : Set (Euclidean 2) := ({0}ᶜ : Set (Euclidean 2))
    have hsopen : IsOpen s := by
      simpa only [s] using (isOpen_compl_singleton : IsOpen ({0}ᶜ : Set (Euclidean 2)))
    have hsunique : UniqueDiffOn Real s := hsopen.uniqueDiffOn
    have hηs : η ∈ s := by simpa [s] using hηne
    let g : Real → Complex :=
      circleEndpointScaledRadialAmplitudeTimeDerivative u.1 u.2.1 u.2.2
    let f : Euclidean 2 → Real := fun y => ‖y‖
    let h : Euclidean 2 → Complex := fun y => g (f y)
    have hg : ContDiff Real n g := by
      dsimp [g]
      exact (contDiff_circleEndpointScaledRadialAmplitudeTimeDerivative
        u.1 u.2.1 u.2.2).of_le
        (show (n : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) by
          exact WithTop.coe_le_coe.mpr le_top)
    have hf : ContDiffOn Real n f s := by
      intro x hx
      exact (contDiffAt_norm Real (by simpa [s] using hx)).contDiffWithinAt
    have hh : ContDiffOn Real n h s := by
      change ContDiffOn Real n (g ∘ f) s
      exact hg.comp_contDiffOn hf
    have hq : ContDiff Real n q := by
      change ContDiff Real n (qS : Euclidean 2 → Complex)
      exact qS.smooth n
    have hradialAt : ContDiffAt Real n h η := by
      change ContDiffAt Real n (g ∘ f) η
      exact hg.contDiffAt.comp η (contDiffAt_norm Real hηne)
    have hqAt : ContDiffAt Real n q η := hq.contDiffAt
    have hprodAt : ContDiffAt Real n (fun y => h y * q y) η := hradialAt.mul hqAt
    have hprod := norm_iteratedFDerivWithin_mul_le
      hh hq.contDiffOn hsunique hηs
      (show (n : WithTop ENat) ≤ (n : WithTop ENat) by rfl)
    have hprodEq : iteratedFDerivWithin Real n (fun y => h y * q y) s η =
        iteratedFDeriv Real n (fun y => h y * q y) η :=
      iteratedFDerivWithin_eq_iteratedFDeriv hsunique hprodAt hηs
    have hsum :
        ∑ i ∈ Finset.range (n + 1),
          (n.choose i : Real) * ‖iteratedFDerivWithin Real i h s η‖ *
            ‖iteratedFDerivWithin Real (n - i) q s η‖ ≤
        ∑ i ∈ Finset.range (n + 1),
          (n.choose i : Real) * H i * SchwartzMap.seminorm Complex 0 (n - i) qS := by
      apply Finset.sum_le_sum
      intro i hi
      have hin : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      have hradialAt_i : ContDiffAt Real i h η := by
        change ContDiffAt Real i (g ∘ f) η
        exact (hg.of_le (by exact_mod_cast hin)).contDiffAt.comp η
          (contDiffAt_norm Real hηne)
      have hqAt_i : ContDiffAt Real (n - i : Nat) q η := by
        change ContDiffAt Real (n - i : Nat) (qS : Euclidean 2 → Complex) η
        exact qS.contDiffAt (n - i)
      have hradialEq : iteratedFDerivWithin Real i h s η = iteratedFDeriv Real i h η :=
        iteratedFDerivWithin_eq_iteratedFDeriv hsunique hradialAt_i hηs
      have hqEq : iteratedFDerivWithin Real (n - i) q s η =
          iteratedFDeriv Real (n - i) q η :=
        iteratedFDerivWithin_eq_iteratedFDeriv hsunique hqAt_i hηs
      rw [hradialEq, hqEq]
      have hradial : ‖iteratedFDeriv Real i h η‖ ≤ H i := by
        change ‖iteratedFDeriv Real i
          (fun y : Euclidean 2 =>
            circleEndpointScaledRadialAmplitudeTimeDerivative
              u.1 u.2.1 u.2.2.1 ‖y‖) η‖ ≤ H i
        exact hH i u.1 u.2.1 u.2.2.1 η u.2.2.2.1 hηinner hηouter
      have hqbound : ‖iteratedFDeriv Real (n - i) q η‖ ≤
          SchwartzMap.seminorm Complex 0 (n - i) qS := by
        change ‖iteratedFDeriv Real (n - i) (qS : Euclidean 2 → Complex) η‖ ≤ _
        exact qS.norm_iteratedFDeriv_le_seminorm Complex (n - i) η
      calc
        (n.choose i : Real) * ‖iteratedFDeriv Real i h η‖ *
            ‖iteratedFDeriv Real (n - i) q η‖ ≤
          (n.choose i : Real) * H i * ‖iteratedFDeriv Real (n - i) q η‖ :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left hradial (by positivity)) (norm_nonneg _)
        _ ≤ (n.choose i : Real) * H i * SchwartzMap.seminorm Complex 0 (n - i) qS :=
          mul_le_mul_of_nonneg_left hqbound
            (mul_nonneg (by positivity) (hHpos i).le)
    have hfamilyEq :
        (aux_circleAnnularEndpointTimeDerivativeSchwartzFamily C u :
          Euclidean 2 → Complex) = fun y => c * (h y * q y) := by
      funext y
      change circleAnnularEndpointTimeDerivativeScaledSymbol C u.1 u.2.1 u.2.2 y = _
      rw [circleAnnularEndpointTimeDerivativeScaledSymbol_apply]
      dsimp [c, h, q, qS, g, f]
      ring
    have hscalar : (fun y : Euclidean 2 => c * (h y * q y)) =
        fun y => c • (h y * q y) := by
      funext y
      simp [smul_eq_mul]
    calc
      ‖iteratedFDeriv Real n
          (aux_circleAnnularEndpointTimeDerivativeSchwartzFamily C u :
            Euclidean 2 → Complex) η‖ =
          ‖c‖ * ‖iteratedFDeriv Real n (fun y => h y * q y) η‖ := by
            rw [hfamilyEq, hscalar, iteratedFDeriv_const_smul_apply' hprodAt, norm_smul]
      _ = ‖c‖ * ‖iteratedFDerivWithin Real n (fun y => h y * q y) s η‖ := by
            rw [hprodEq]
      _ ≤ ‖c‖ * ∑ i ∈ Finset.range (n + 1),
          (n.choose i : Real) * ‖iteratedFDerivWithin Real i h s η‖ *
            ‖iteratedFDerivWithin Real (n - i) q s η‖ :=
          mul_le_mul_of_nonneg_left hprod (norm_nonneg _)
      _ ≤ B := by
            exact mul_le_mul_of_nonneg_left hsum (norm_nonneg _)
  · have hnot : η ∉ Function.support (iteratedFDeriv Real n
        (aux_circleAnnularEndpointTimeDerivativeSchwartzFamily C u :
          Euclidean 2 → Complex)) := by
      intro hmem
      exact hηK (htsupp (support_iteratedFDeriv_subset n hmem))
    have hzero : iteratedFDeriv Real n
        (aux_circleAnnularEndpointTimeDerivativeSchwartzFamily C u :
          Euclidean 2 → Complex) η = 0 := by
      by_contra hne
      exact hnot (Function.mem_support.mpr hne)
    rw [hzero]
    simpa using hB

private theorem exists_integral_norm_circleAnnularEndpointTimeDerivativeSchwartzFamily_le
