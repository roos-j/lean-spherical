/-- The compact radial input multiplier which turns a dyadic half-wave into
its time derivative after multiplication by `2^j`. -/
noncomputable def circleEndpointTimeDerivativeInputMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) :
    Euclidean 2 → Complex :=
  fun ξ =>
    (((σ.toReal * (2 * Real.pi) *
        (((2 : Real) ^ j)⁻¹ * ‖ξ‖) : Real) : Complex) * Complex.I) *
      _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j ξ

private theorem circleEndpointTimeDerivativeInputMultiplier_eventuallyEq_zero_at_zero
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) :
    Filter.EventuallyEq (nhds (0 : Euclidean 2))
      (circleEndpointTimeDerivativeInputMultiplier C σ j) (fun _ => 0) := by
  let rhigh : Real := (2 : Real) ^ ((j : Int) + 3)
  let rlow : Real := (2 : Real) ^ ((j : Int) - 2)
  have hhigh : 0 < rhigh := by
    dsimp [rhigh]
    positivity
  have hlow : 0 < rlow := by
    dsimp [rlow]
    positivity
  filter_upwards [Metric.ball_mem_nhds (0 : Euclidean 2) (lt_min hhigh hlow)] with ξ hξ
  have hξnorm : ‖ξ‖ < min rhigh rlow := by
    simpa only [Metric.mem_ball, dist_zero_right] using hξ
  have hright : ‖rhigh⁻¹ • ξ‖ ≤ 1 := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hhigh)]
    rw [show rhigh⁻¹ * ‖ξ‖ = ‖ξ‖ / rhigh by ring]
    exact (div_le_one₀ hhigh).mpr (hξnorm.le.trans (min_le_left _ _))
  have hleft : ‖rlow⁻¹ • ξ‖ ≤ 1 := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hlow)]
    rw [show rlow⁻¹ * ‖ξ‖ = ‖ξ‖ / rlow by ring]
    exact (div_le_one₀ hlow).mpr (hξnorm.le.trans (min_le_right _ _))
  have hfat :
      _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j ξ = 0 := by
    rw [_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier_eq_shiftedFatMultiplier,
      _root_.Auto.LittlewoodPaley.shiftedFatMultiplier_apply]
    simp only [sub_zero]
    change C.cutoff (rhigh⁻¹ • ξ) - C.cutoff (rlow⁻¹ • ξ) = 0
    rw [C.cutoff_one _ hright, C.cutoff_one _ hleft]
    ring
  simp [circleEndpointTimeDerivativeInputMultiplier, hfat]

theorem hasCompactSupport_circleEndpointTimeDerivativeInputMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) :
    HasCompactSupport (circleEndpointTimeDerivativeInputMultiplier C σ j) := by
  let rhigh : Real := (2 : Real) ^ ((j : Int) + 3)
  let rlow : Real := (2 : Real) ^ ((j : Int) - 2)
  have hhigh : 0 < rhigh := by
    dsimp [rhigh]
    positivity
  have hlow : 0 < rlow := by
    dsimp [rlow]
    positivity
  apply HasCompactSupport.intro
    (isCompact_closedBall (0 : Euclidean 2) (2 * max rhigh rlow))
  intro ξ hξ
  have hξnorm : 2 * max rhigh rlow ≤ ‖ξ‖ := by
    rw [Metric.mem_closedBall, dist_zero_right] at hξ
    exact le_of_not_ge hξ
  have hright : 2 ≤ ‖rhigh⁻¹ • ξ‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hhigh)]
    rw [show rhigh⁻¹ * ‖ξ‖ = ‖ξ‖ / rhigh by ring]
    apply (le_div_iff₀ hhigh).mpr
    calc
      2 * rhigh ≤ 2 * max rhigh rlow :=
        mul_le_mul_of_nonneg_left (le_max_left _ _) (by norm_num)
      _ ≤ ‖ξ‖ := hξnorm
  have hleft : 2 ≤ ‖rlow⁻¹ • ξ‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hlow)]
    rw [show rlow⁻¹ * ‖ξ‖ = ‖ξ‖ / rlow by ring]
    apply (le_div_iff₀ hlow).mpr
    calc
      2 * rlow ≤ 2 * max rhigh rlow :=
        mul_le_mul_of_nonneg_left (le_max_right _ _) (by norm_num)
      _ ≤ ‖ξ‖ := hξnorm
  have hfat :
      _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j ξ = 0 := by
    rw [_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier_eq_shiftedFatMultiplier,
      _root_.Auto.LittlewoodPaley.shiftedFatMultiplier_apply]
    simp only [sub_zero]
    change C.cutoff (rhigh⁻¹ • ξ) - C.cutoff (rlow⁻¹ • ξ) = 0
    rw [C.cutoff_zero _ hright, C.cutoff_zero _ hleft]
    ring
  simp [circleEndpointTimeDerivativeInputMultiplier, hfat]

theorem contDiff_circleEndpointTimeDerivativeInputMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) :
    ContDiff Real (⊤ : ℕ∞)
      (circleEndpointTimeDerivativeInputMultiplier C σ j) := by
  rw [contDiff_iff_contDiffAt]
  intro ξ
  by_cases hξ : ξ = 0
  · subst ξ
    exact (contDiffAt_const (c := (0 : Complex))).congr_of_eventuallyEq
      (circleEndpointTimeDerivativeInputMultiplier_eventuallyEq_zero_at_zero C σ j)
  · have hnorm : ContDiffAt Real (⊤ : ℕ∞) (fun η : Euclidean 2 => ‖η‖) ξ :=
      contDiffAt_norm Real hξ
    have hcoefReal : ContDiffAt Real (⊤ : ℕ∞)
        (fun η : Euclidean 2 =>
          σ.toReal * (2 * Real.pi) * (((2 : Real) ^ j)⁻¹ * ‖η‖)) ξ := by
      exact (contDiffAt_const.mul contDiffAt_const).mul
        (contDiffAt_const.mul hnorm)
    have hcoef : ContDiffAt Real (⊤ : ℕ∞)
        (fun η : Euclidean 2 =>
          ((σ.toReal * (2 * Real.pi) * (((2 : Real) ^ j)⁻¹ * ‖η‖) : Real) : Complex) *
            Complex.I) ξ :=
      (Complex.ofRealCLM.contDiff.contDiffAt.comp ξ hcoefReal).mul contDiffAt_const
    have hcut : ContDiffAt Real (⊤ : ℕ∞)
        (_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j) ξ :=
      ((_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j).smooth
        (⊤ : ℕ∞)).contDiffAt
    exact hcoef.mul hcut

noncomputable def circleEndpointTimeDerivativeInputSchwartzSymbol
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) :
    SchwartzMap (Euclidean 2) Complex :=
  (hasCompactSupport_circleEndpointTimeDerivativeInputMultiplier C σ j).toSchwartzMap
    (contDiff_circleEndpointTimeDerivativeInputMultiplier C σ j)

private theorem circleEndpointTimeDerivativeInputSchwartzSymbol_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (ξ : Euclidean 2) :
    circleEndpointTimeDerivativeInputSchwartzSymbol C σ j ξ =
      circleEndpointTimeDerivativeInputMultiplier C σ j ξ := rfl

theorem circleEndpointTimeDerivativeInputMultiplier_scaled_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (η : Euclidean 2) :
    circleEndpointTimeDerivativeInputMultiplier C σ j ((2 : Real) ^ j • η) =
      ((σ.toReal * (2 * Real.pi) * ‖η‖ : Real) : Complex) * Complex.I *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff η := by
  unfold circleEndpointTimeDerivativeInputMultiplier
  rw [_root_.Auto.MikhlinHormander.fatDyadicBandpassMultiplier_eq_prototype_scale]
  have hpow : 0 ≤ (2 : Real) ^ j := by positivity
  have hpow_ne : (2 : Real) ^ j ≠ 0 := ne_of_gt (by positivity)
  rw [smul_smul, inv_mul_cancel₀ hpow_ne, one_smul]
  rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hpow]
  push_cast
  field_simp

noncomputable def circleEndpointTimeDerivativeInput
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) : SchwartzMap (Euclidean 2) Complex :=
  𝓕⁻ (SchwartzMap.smulLeftCLM Complex
    (circleEndpointTimeDerivativeInputSchwartzSymbol C σ j :
      Euclidean 2 → Complex)
    (𝓕 f))

theorem circleEndpointTimeDerivativeInput_fourier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) (ξ : Euclidean 2) :
    𝓕 (circleEndpointTimeDerivativeInput C σ j f : Euclidean 2 → Complex) ξ =
      circleEndpointTimeDerivativeInputMultiplier C σ j ξ *
        𝓕 (f : Euclidean 2 → Complex) ξ := by
  unfold circleEndpointTimeDerivativeInput
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  simp only [SchwartzMap.smulLeftCLM_apply
    (circleEndpointTimeDerivativeInputSchwartzSymbol C σ j).hasTemperateGrowth,
    smul_eq_mul, circleEndpointTimeDerivativeInputSchwartzSymbol_apply,
    SchwartzMap.fourier_coe]

/-- The radial input multiplier exactly extracts one dyadic frequency from
the half-wave time derivative. -/
theorem dyadicHalfWaveSymbol_mul_circleEndpointTimeDerivativeInputMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (ξ : Euclidean 2) :
    (((2 : Real) ^ j : Real) : Complex) *
        (_root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ j t ξ *
          circleEndpointTimeDerivativeInputMultiplier C σ j ξ) =
      _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t ξ *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ := by
  let d : Real := (2 : Real) ^ j
  let h : Complex := _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t ξ
  let b : Complex :=
    _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ
  let q : Complex :=
    ((σ.toReal * (2 * Real.pi) * (d⁻¹ * ‖ξ‖) : Real) : Complex) * Complex.I
  let r : Complex := ((σ.toReal * (2 * Real.pi) * ‖ξ‖ : Real) : Complex) * Complex.I
  let fat : Complex :=
    _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j ξ
  have hdne : d ≠ 0 := by
    dsimp [d]
    positivity
  have hband : b * fat = b := by
    dsimp [b, fat]
    exact _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier_mul_fatDyadicBandpassMultiplier C j ξ
  have hcoef : (d : Complex) * q = r := by
    dsimp [d, q, r]
    push_cast
    field_simp
  change (d : Complex) * (h * b * (q * fat)) = r * h * b
  calc
    (d : Complex) * (h * b * (q * fat)) = h * (b * fat) * ((d : Complex) * q) := by ring
    _ = h * b * r := by rw [hband, hcoef]
    _ = r * h * b := by ring

private theorem aux_circleAnnularEndpointTimeDerivativeScaledSchwartzSymbol_at_dyadicScale
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
