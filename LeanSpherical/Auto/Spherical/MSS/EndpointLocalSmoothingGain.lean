theorem circleEndpointTimeDerivativeInputMultiplier_scaled_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (η : Euclidean 2) :
    circleEndpointTimeDerivativeInputMultiplier C σ j ((2 : Real) ^ j • η) =
      ((σ.toReal * (2 * Real.pi) * ‖η‖ : Real) : Complex) * Complex.I *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff η := by
  unfold circleEndpointTimeDerivativeInputMultiplier
  rw [_root_.Auto.MikhlinHormander.fatDyadicBandpassMultiplier_eq_prototype_scale]
  have hpow : 0 ≤ (2 : Real) ^ j := by positivity
  have hpow_ne : (2 : Real) ^ j ≠ 0 := ne_of_gt (by positivity)
  rw [smul_smul, inv_mul_cancel₀ hpow_ne, one_smul]
  rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hpow]
  push_cast
  field_simp

noncomputable def circleEndpointTimeDerivativeInput
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) : SchwartzMap (Euclidean 2) Complex :=
  𝓕⁻ (SchwartzMap.smulLeftCLM Complex
    (circleEndpointTimeDerivativeInputSchwartzSymbol C σ j :
      Euclidean 2 → Complex)
