  obtain ⟨B, hB, hderiv⟩ :=
    exists_unif_norm_iteratedFDeriv_circleAnnularEndptTimeDerivSchwartzFamily_le C 0
  let K : Set (Euclidean 2) := Metric.closedBall 0 ((2 : Real) ^ (4 : Int))
  let A₀ : Real := B * (volume K).toReal
  have hKmeas : MeasurableSet K := measurableSet_closedBall
  have hKfinite : volume K ≠ ∞ := (measure_closedBall_lt_top : volume K < ∞).ne
  have hA₀ : 0 ≤ A₀ := mul_nonneg hB ENNReal.toReal_nonneg
  refine ⟨A₀, hA₀, ?_⟩
  intro u
  apply _root_.Auto.MikhlinHormander.integral_norm_le_of_support_subset_of_norm_le
    (aux_circleAnnularEndpointTimeDerivativeSchwartzFamily C u : Euclidean 2 → Complex)
    K hKmeas hKfinite
  · simpa using (aux_circleAnnularEndpointTimeDerivativeSchwartzFamily C u).integrable.norm
  · intro η
