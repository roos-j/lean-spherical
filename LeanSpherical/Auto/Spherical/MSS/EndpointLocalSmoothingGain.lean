private theorem aux_circleEndpointTimeDerivativeInputMultiplier_eq_profile_scale
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (ξ : Euclidean 2) :
    circleEndpointTimeDerivativeInputMultiplier C σ j ξ =
      aux_circleEndpointTimeDerivativeInputProfile C σ
        (((2 : Real) ^ j)⁻¹ • ξ) := by
  let d : Real := (2 : Real) ^ j
  have hd : d ≠ 0 := by
    dsimp [d]
    positivity
  have hscale : d • (d⁻¹ • ξ) = ξ := by
    rw [smul_smul, mul_inv_cancel₀ hd, one_smul]
  have hmain := circleEndpointTimeDerivativeInputMultiplier_scaled_apply C σ j (d⁻¹ • ξ)
  rw [hscale] at hmain
  simpa only [d, aux_circleEndpointTimeDerivativeInputProfile_apply,
    aux_circleEndpointTimeDerivativeInputProfileFun] using hmain

private theorem aux_circleEndpointTimeDerivativeInput_eq_relativeMultiplierAt
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    circleEndpointTimeDerivativeInput C σ j f x =
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
        (aux_circleEndpointTimeDerivativeInputProfile C σ)
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) f x := by
  have hInvPoint :
      circleEndpointTimeDerivativeInput C σ j f x =
        𝓕⁻ (𝓕 (circleEndpointTimeDerivativeInput C σ j f)) x := by
    exact congrFun
      (congrArg (fun g : SchwartzMap (Euclidean 2) Complex =>
        (g : Euclidean 2 → Complex))
        (FourierTransform.fourierInv_fourier_eq
          (circleEndpointTimeDerivativeInput C σ j f)).symm) x
  rw [hInvPoint]
  unfold _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
  rw [SchwartzMap.fourierInv_coe, SchwartzMap.fourier_coe]
  apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
  funext ξ
  rw [circleEndpointTimeDerivativeInput_fourier,
    aux_circleEndpointTimeDerivativeInputMultiplier_eq_profile_scale]
  simp only [_root_.Auto.MikhlinHormander.dyadicFrequencyScale]

private theorem aux_hasCircleEndpointTimeDerivativeInputUniformKernelBound
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ A : Real, 0 ≤ A ∧ ∀ σ : _root_.Auto.Spherical.MSS.WaveSign,
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize
        (aux_circleEndpointTimeDerivativeInputProfile C σ) ≤ A := by
