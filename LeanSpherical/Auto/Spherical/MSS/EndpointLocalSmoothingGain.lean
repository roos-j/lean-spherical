private theorem exists_compactFourierIBPConstant_circleAnnularEndptTimeDerivSchwartzFamily_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ A₁ : Real, 0 ≤ A₁ ∧ ∀ u : aux_CircleAnnularEndpointLocalIndex,
      _root_.Auto.MikhlinHormander.compactFourierIBPConstant (N := 4)
