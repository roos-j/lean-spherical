      _root_.Auto.MikhlinHormander.compactFourierIBPConstant (N := 4)
        (aux_circleAnnularEndpointTimeDerivativeSchwartzFamily C u :
          Euclidean 2 → Complex) ≤ A₁) :
    aux_HasCircleAnnularEndpointTimeDerivativeUniformKernelBound C := by
  refine ⟨A₀ + A₁, add_nonneg hA₀ hA₁, ?_⟩
  intro u
  calc
    _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize
        (aux_circleAnnularEndpointTimeDerivativeSchwartzFamily C u) ≤
        (∫ η : Euclidean 2,
          ‖aux_circleAnnularEndpointTimeDerivativeSchwartzFamily C u η‖) +
          _root_.Auto.MikhlinHormander.compactFourierIBPConstant (N := 4)
            (aux_circleAnnularEndpointTimeDerivativeSchwartzFamily C u :
              Euclidean 2 → Complex) :=
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize_le_compactFourierIBP
        (aux_circleAnnularEndpointTimeDerivativeSchwartzFamily C u)
