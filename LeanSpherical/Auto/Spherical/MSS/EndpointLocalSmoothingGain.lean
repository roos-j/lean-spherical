noncomputable def aux_circleAnnularEndpointTimeDerivativeScaledSchwartzSymbol
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    SchwartzMap (Euclidean 2) Complex :=
