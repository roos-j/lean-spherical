theorem circleEndpointTimeDerivativeInput_fourier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) (ξ : Euclidean 2) :
    𝓕 (circleEndpointTimeDerivativeInput C σ j f : Euclidean 2 → Complex) ξ =
      circleEndpointTimeDerivativeInputMultiplier C σ j ξ *
        𝓕 (f : Euclidean 2 → Complex) ξ := by
  unfold circleEndpointTimeDerivativeInput
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  simp only [SchwartzMap.smulLeftCLM_apply
    (circleEndpointTimeDerivativeInputSchwartzSymbol C σ j).hasTemperateGrowth,
    smul_eq_mul, circleEndpointTimeDerivativeInputSchwartzSymbol_apply,
    SchwartzMap.fourier_coe]

/-- The radial input multiplier exactly extracts one dyadic frequency from
the half-wave time derivative. -/
theorem dyadicHalfWaveSymbol_mul_circleEndpointTimeDerivativeInputMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (ξ : Euclidean 2) :
    (((2 : Real) ^ j : Real) : Complex) *
        (_root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ j t ξ *
          circleEndpointTimeDerivativeInputMultiplier C σ j ξ) =
      _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t ξ *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ := by
  let d : Real := (2 : Real) ^ j
  let h : Complex := _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t ξ
  let b : Complex :=
    _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ
  let q : Complex :=
    ((σ.toReal * (2 * Real.pi) * (d⁻¹ * ‖ξ‖) : Real) : Complex) * Complex.I
  let r : Complex := ((σ.toReal * (2 * Real.pi) * ‖ξ‖ : Real) : Complex) * Complex.I
  let fat : Complex :=
    _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j ξ
  have hdne : d ≠ 0 := by
    dsimp [d]
    positivity
  have hband : b * fat = b := by
    dsimp [b, fat]
    exact _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier_mul_fatDyadicBandpassMultiplier C j ξ
  have hcoef : (d : Complex) * q = r := by
    dsimp [d, q, r]
    push_cast
    field_simp
  change (d : Complex) * (h * b * (q * fat)) = r * h * b
  calc
    (d : Complex) * (h * b * (q * fat)) = h * (b * fat) * ((d : Complex) * q) := by ring
    _ = h * b * r := by rw [hband, hcoef]
    _ = r * h * b := by ring

private theorem aux_circleAnnularEndpointTimeDerivativeScaledSchwartzSymbol_at_dyadicScale
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
