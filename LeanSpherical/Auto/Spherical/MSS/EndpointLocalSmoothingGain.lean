      (∫ x : JointWaveSpaceTime,‖O x‖^4) ≤
        C*conormal^4*mu^3*(h^(4*N))⁻¹*(∫ y : Euclidean 2,‖f y‖^4) := by
  obtain ⟨C,hC,hsource⟩ :=
    normalizedCircleBothSheetNormalDefectConormalSourceWideOperator_uniform_fourth
