      circleAnnularEndpointTimeDerivativeScaledSymbol C σ j t η := by
  change circleAnnularEndpointTimeDerivativeSchwartzSymbol C σ j t
      ((2 : Real) ^ j • η) =
    circleAnnularEndpointTimeDerivativeScaledSymbol C σ j t η
  rw [circleAnnularEndpointTimeDerivativeSchwartzSymbol_apply]
  rfl

