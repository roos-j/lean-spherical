theorem integrable_norm_pow_four_circleEndpointWaveContribution_prod_of_gain
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {ρ : Real}
    (hgain : _root_.Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 ρ)
    (j : Nat) (hj : 1 ≤ j)
    (σ : _root_.Auto.Spherical.MSS.WaveSign)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun p : Real × Euclidean 2 =>
      ‖circleEndpointWaveContribution C σ j p.1 f p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
  obtain ⟨B, hB, hfixed⟩ :=
    exists_integral_norm_pow_four_circleAnnularEndpointWaveContribution_le C
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleEndpointWaveContribution C σ j t f x
  let U : Real → Euclidean 2 → Complex := fun t x =>
    circleAnnularEndpointHalfWaveOutput C σ j t f x
  have hjoint := continuous_and_hasDerivAt_circleEndpointWaveContribution C σ j f
  have hFcont : Continuous (Function.uncurry F) := by
    simpa only [F] using hjoint.1
  have hUprod : Integrable (fun p : Real × Euclidean 2 => ‖U p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    have h := aux_integrable_norm_pow_four_dyadicHalfWave_prod_of_gain C hgain j hj σ f
    refine h.congr ?_
    filter_upwards with p
    change ‖_root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ j p.1 f p.2‖ ^ 4 =
      ‖circleAnnularEndpointHalfWaveOutput C σ j p.1 f p.2‖ ^ 4
    rw [circleAnnularEndpointHalfWaveOutput_apply]
  have hFspatial : ∀ t : Icc (1 : Real) 2,
      Integrable (fun x : Euclidean 2 => ‖F t.1 x‖ ^ 4) volume := by
    intro t
    have h := aux_integrable_norm_pow_four_aux_circleAnnularEndpointWaveContribution C σ j t f
    refine h.congr ?_
    filter_upwards with x
    change ‖aux_circleAnnularEndpointWaveContribution C σ j t.1 f x‖ ^ 4 =
      ‖circleEndpointWaveContribution C σ j t.1 f x‖ ^ 4
    rw [aux_circleEndpointWaveContribution_slice_eq_aux]
  have hbound : ∀ t : Icc (1 : Real) 2,
      (∫ x : Euclidean 2, ‖F t.1 x‖ ^ 4) ≤
        (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * B) *
          ∫ x : Euclidean 2, ‖U t.1 x‖ ^ 4 := by
    intro t
    change (∫ x : Euclidean 2, ‖circleEndpointWaveContribution C σ j t.1 f x‖ ^ 4) ≤
      ‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * B *
        ∫ x : Euclidean 2, ‖circleAnnularEndpointHalfWaveOutput C σ j t.1 f x‖ ^ 4
    calc
      (∫ x : Euclidean 2, ‖circleEndpointWaveContribution C σ j t.1 f x‖ ^ 4) =
          ∫ x : Euclidean 2, ‖aux_circleAnnularEndpointWaveContribution C σ j t.1 f x‖ ^ 4 := by
            apply integral_congr_ae
            filter_upwards with x
            rw [aux_circleEndpointWaveContribution_slice_eq_aux C σ j t f x]
      _ ≤ _ := hfixed σ j t f
  exact aux_integrable_norm_pow_four_prod_of_continuous_of_spatial_bound
    (F := F) (U := U)
    (c := ‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * B)
    hFcont hUprod hFspatial hbound

theorem exists_ivlInteg_integral_norm_pow_four_circleEndpointWaveContribution_le_gain
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {ρ : Real}
    (hgain : _root_.Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 ρ) :
    ∃ A : Real, 0 < A ∧ ∀ (j : Nat), 1 ≤ j →
      ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
        (f : SchwartzMap (Euclidean 2) Complex),
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
        ‖circleEndpointWaveContribution C σ j t f x‖ ^ 4) ≤
          A * (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ (1 + 4 * ρ) *
            ∫ x : Euclidean 2, ‖f x‖ ^ 4 := by
  obtain ⟨B, hB, hfixed⟩ :=
    exists_integral_norm_pow_four_circleAnnularEndpointWaveContribution_le C
  obtain ⟨L, hL, hUbound⟩ :=
    exists_intervalIntegral_integral_norm_pow_four_dyadicHalfWave_le_gain C hgain
  refine ⟨B * L ^ (4 : Nat), mul_pos hB (pow_pos hL _), ?_⟩
  intro j hj σ f
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleEndpointWaveContribution C σ j t f x
  let U : Real → Euclidean 2 → Complex := fun t x =>
    circleAnnularEndpointHalfWaveOutput C σ j t f x
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 4
  have hFprod : Integrable (fun p : Real × Euclidean 2 => ‖F p.1 p.2‖ ^ 4)
      (ν.prod volume) := by
    simpa only [ν, F] using
      integrable_norm_pow_four_circleEndpointWaveContribution_prod_of_gain
        C hgain j hj σ f
  have hUprod : Integrable (fun p : Real × Euclidean 2 => ‖U p.1 p.2‖ ^ 4)
      (ν.prod volume) := by
    have h := aux_integrable_norm_pow_four_dyadicHalfWave_prod_of_gain C hgain j hj σ f
    refine h.congr ?_
    filter_upwards with p
    change ‖_root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ j p.1 f p.2‖ ^ 4 =
      ‖circleAnnularEndpointHalfWaveOutput C σ j p.1 f p.2‖ ^ 4
    rw [circleAnnularEndpointHalfWaveOutput_apply]
  have hFouter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖F t x‖ ^ 4) ν :=
    hFprod.integral_prod_left
  have hUouter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖U t x‖ ^ 4) ν :=
    hUprod.integral_prod_left
  have hFinterval : IntervalIntegrable (fun t : Real => ∫ x : Euclidean 2, ‖F t x‖ ^ 4)
      volume 1 2 := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num : (1 : Real) ≤ 2)]
    exact hFouter
  have hUinterval : IntervalIntegrable (fun t : Real => ∫ x : Euclidean 2, ‖U t x‖ ^ 4)
      volume 1 2 := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num : (1 : Real) ≤ 2)]
    exact hUouter
  have hpoint (t : Real) (ht : t ∈ Icc (1 : Real) 2) :
      (∫ x : Euclidean 2, ‖F t x‖ ^ 4) ≤
        (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * B) *
          ∫ x : Euclidean 2, ‖U t x‖ ^ 4 := by
    let ts : Icc (1 : Real) 2 := ⟨t, ht⟩
    change (∫ x : Euclidean 2, ‖circleEndpointWaveContribution C σ j t f x‖ ^ 4) ≤
      ‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * B *
        ∫ x : Euclidean 2, ‖circleAnnularEndpointHalfWaveOutput C σ j t f x‖ ^ 4
    calc
      (∫ x : Euclidean 2, ‖circleEndpointWaveContribution C σ j t f x‖ ^ 4) =
          ∫ x : Euclidean 2, ‖aux_circleAnnularEndpointWaveContribution C σ j t f x‖ ^ 4 := by
            apply integral_congr_ae
            filter_upwards with x
            exact congrArg (fun z : Complex => ‖z‖ ^ 4)
              (aux_circleEndpointWaveContribution_slice_eq_aux C σ j ts f x)
      _ ≤ _ := hfixed σ j ts f
  have hFtoU :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 4) ≤
        (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * B) *
          ∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖U t x‖ ^ 4 := by
    calc
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 4) ≤
          ∫ t in (1 : Real)..2,
            (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * B) *
              ∫ x : Euclidean 2, ‖U t x‖ ^ 4 := by
            exact intervalIntegral.integral_mono_on (by norm_num) hFinterval
              (hUinterval.const_mul _) hpoint
      _ = (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * B) *
          ∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖U t x‖ ^ 4 := by
            rw [intervalIntegral.integral_const_mul]
  have hUenergy :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖U t x‖ ^ 4) ≤
        L ^ (4 : Nat) * (2 : Real) ^ ((j : Real) * (1 - 4 * ρ)) * E := by
    calc
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖U t x‖ ^ 4) =
          ∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
            ‖_root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ j t f x‖ ^ 4 := by
              apply intervalIntegral.integral_congr_ae
              filter_upwards with t ht
              apply integral_congr_ae
              filter_upwards with x
              change ‖circleAnnularEndpointHalfWaveOutput C σ j t f x‖ ^ 4 = _
              rw [circleAnnularEndpointHalfWaveOutput_apply]
      _ ≤ _ := by simpa only [E] using hUbound j hj σ f
  have hcore := hFtoU.trans
    (mul_le_mul_of_nonneg_left hUenergy (by positivity :
      0 ≤ ‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * B))
  have hδ : 0 < _root_.Auto.Spherical.MSS.dyadicTimeScale j := by
    dsimp [_root_.Auto.Spherical.MSS.dyadicTimeScale]
    exact zpow_pos (by norm_num) _
  change (∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
      ‖F t x‖ ^ 4) ≤
    (B * L ^ (4 : Nat)) * (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ (1 + 4 * ρ) * E
  calc
    (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 4) ≤
        ‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * B *
          (L ^ (4 : Nat) * (2 : Real) ^ ((j : Real) * (1 - 4 * ρ)) * E) := hcore
    _ = (B * L ^ (4 : Nat)) * (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^
          (1 + 4 * ρ) * E := by
      rw [aux_norm_inv_circleEndpointDyadicNormalization_pow_four,
        aux_dyadicFrequencyPower_eq_dyadicTimeScale]
      have hpow :
          (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ (2 : Real) *
            (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ (-1 + 4 * ρ) =
          (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ (1 + 4 * ρ) := by
        rw [← Real.rpow_add hδ]
        congr 1
        ring
      calc
        (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ (2 : Nat) * B *
            (L ^ (4 : Nat) *
              (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ (-1 + 4 * ρ) * E) =
            (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ (2 : Real) * B *
              (L ^ (4 : Nat) *
                (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ (-1 + 4 * ρ) * E) := by
              norm_num [Real.rpow_natCast]
        _ = B * L ^ (4 : Nat) *
              ((_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ (2 : Real) *
                (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ (-1 + 4 * ρ)) * E := by ring
        _ = _ := by rw [hpow]

private theorem aux_circleEndpointWaveContributionTimeDerivative_slice_eq_aux_sum
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat)
    (t : Icc (1 : Real) 2) (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) :
    circleEndpointWaveContributionTimeDerivative C σ j t.1 f x =
      aux_circleAnnularEndpointTimeDerivativeWaveContribution C σ j t.1 f x +
        (((2 : Real) ^ j : Real) : Complex) *
          aux_circleAnnularEndpointWaveContribution C σ j t.1
            (circleEndpointTimeDerivativeInput C σ j f) x := by
  rw [← circleEndpointWaveContributionTimeDerivativeFactored_eq_literal C σ j t f]
  let n : Complex := (circleEndpointDyadicNormalization j)⁻¹
  let d : Complex := (((2 : Real) ^ j : Real) : Complex)
  let R₁ : Complex :=
    _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
      (aux_circleAnnularEndpointTimeDerivativeSchwartzFamily C ⟨σ, ⟨j, t⟩⟩)
      (aux_circleAnnularEndpointFrequencyScale ⟨σ, ⟨j, t⟩⟩)
      (circleAnnularEndpointHalfWaveOutput C σ j t.1 f) x
  let R₂ : Complex :=
    _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
      (aux_circleAnnularEndpointSchwartzFamily C ⟨σ, ⟨j, t⟩⟩)
      (aux_circleAnnularEndpointFrequencyScale ⟨σ, ⟨j, t⟩⟩)
      (circleAnnularEndpointHalfWaveOutput C σ j t.1
        (circleEndpointTimeDerivativeInput C σ j f)) x
  have h₁ : aux_circleAnnularEndpointTimeDerivativeWaveContribution C σ j t.1 f x =
      n * R₁ := by
    simpa only [n, R₁] using
      aux_circleAnnularEndpointTimeDerivWaveContribution_eq_relativeMult_halfWave
        C σ j t f x
  have h₂ : aux_circleAnnularEndpointWaveContribution C σ j t.1
      (circleEndpointTimeDerivativeInput C σ j f) x = n * R₂ := by
    simpa only [n, R₂] using
      aux_circleAnnularEndpointWaveContribution_eq_relativeMultiplier_halfWave
        C σ j t (circleEndpointTimeDerivativeInput C σ j f) x
  change n * (R₁ + d * R₂) = _
  calc
    n * (R₁ + d * R₂) = n * R₁ + d * (n * R₂) := by ring
    _ = _ := by rw [← h₁, ← h₂]

theorem aux_norm_add_pow_four_le (a b : Complex) :
    ‖a + b‖ ^ 4 ≤ 8 * (‖a‖ ^ 4 + ‖b‖ ^ 4) := by
  let x : Real := ‖a‖
  let y : Real := ‖b‖
  have hx : 0 ≤ x := norm_nonneg _
  have hy : 0 ≤ y := norm_nonneg _
  have hsq : (x + y) ^ 2 ≤ 2 * (x ^ 2 + y ^ 2) := by
    nlinarith [sq_nonneg (x - y)]
  have hsq₂ : (x ^ 2 + y ^ 2) ^ 2 ≤ 2 * (x ^ 4 + y ^ 4) := by
    nlinarith [sq_nonneg (x ^ 2 - y ^ 2)]
  have hquartic : (x + y) ^ 4 ≤ 8 * (x ^ 4 + y ^ 4) := by
    calc
      (x + y) ^ 4 = ((x + y) ^ 2) ^ 2 := by ring
      _ ≤ (2 * (x ^ 2 + y ^ 2)) ^ 2 :=
        pow_le_pow_left₀ (sq_nonneg (x + y)) hsq 2
      _ = 4 * (x ^ 2 + y ^ 2) ^ 2 := by ring
      _ ≤ 4 * (2 * (x ^ 4 + y ^ 4)) :=
        mul_le_mul_of_nonneg_left hsq₂ (by norm_num)
      _ = 8 * (x ^ 4 + y ^ 4) := by ring
  calc
    ‖a + b‖ ^ 4 ≤ (‖a‖ + ‖b‖) ^ 4 :=
      pow_le_pow_left₀ (norm_nonneg _) (norm_add_le a b) 4
    _ = (x + y) ^ 4 := rfl
    _ ≤ 8 * (x ^ 4 + y ^ 4) := hquartic
    _ = 8 * (‖a‖ ^ 4 + ‖b‖ ^ 4) := rfl

private theorem aux_norm_pow_four_circleEndpointWaveContributionTimeDerivative_le_aux
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat)
    (t : Icc (1 : Real) 2) (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) :
    ‖circleEndpointWaveContributionTimeDerivative C σ j t.1 f x‖ ^ 4 ≤
      8 * (‖aux_circleAnnularEndpointTimeDerivativeWaveContribution C σ j t.1 f x‖ ^ 4 +
        ‖(((2 : Real) ^ j : Real) : Complex) *
          aux_circleAnnularEndpointWaveContribution C σ j t.1
            (circleEndpointTimeDerivativeInput C σ j f) x‖ ^ 4) := by
  rw [aux_circleEndpointWaveContributionTimeDerivative_slice_eq_aux_sum C σ j t f x]
  exact aux_norm_add_pow_four_le _ _

private theorem aux_aestronglyMeasurable_relativeSchwartzMultiplierAt
    {d : Nat} (φ : SchwartzMap (Euclidean d) Complex)
    (r : Ioi (0 : Real)) (f : SchwartzMap (Euclidean d) Complex) :
    AEStronglyMeasurable
      (_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt φ r f) volume := by
  let q : SchwartzMap (Euclidean d) Complex :=
    SchwartzMap.smulLeftCLM Complex
      (_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierSymbol φ r :
        Euclidean d → Complex) (𝓕 f)
  let qinv : SchwartzMap (Euclidean d) Complex :=
    (𝓕⁻ q : SchwartzMap (Euclidean d) Complex)
  have hq : AEStronglyMeasurable (qinv : Euclidean d → Complex) volume :=
    qinv.continuous.aestronglyMeasurable
  refine hq.congr ?_
  filter_upwards with x
  rw [_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt_eq_fourierInv_symbol]
  rw [show qinv = (𝓕⁻ q : SchwartzMap (Euclidean d) Complex) by rfl,
    SchwartzMap.fourierInv_coe]
  simp only [q, SchwartzMap.fourier_coe,
    SchwartzMap.smulLeftCLM_apply
      (_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierSymbol φ r).hasTemperateGrowth,
    smul_eq_mul]

private theorem aux_integrable_norm_pow_four_circleEndpointWaveContributionTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat)
    (t : Icc (1 : Real) 2) (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun x : Euclidean 2 =>
      ‖circleEndpointWaveContributionTimeDerivative C σ j t.1 f x‖ ^ 4) volume := by
  let A : Euclidean 2 → Complex := fun x =>
    aux_circleAnnularEndpointTimeDerivativeWaveContribution C σ j t.1 f x
  let P : SchwartzMap (Euclidean 2) Complex :=
    circleEndpointTimeDerivativeInput C σ j f
  let D : Euclidean 2 → Complex := fun x =>
    aux_circleAnnularEndpointWaveContribution C σ j t.1 P x
  let d : Complex := (((2 : Real) ^ j : Real) : Complex)
  have hA : Integrable (fun x : Euclidean 2 => ‖A x‖ ^ 4) volume := by
    simpa only [A] using
      aux_integrable_norm_pow_four_aux_circleAnnularEndpointTimeDerivativeWaveContribution
        C σ j t f
