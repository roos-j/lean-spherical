private theorem aux_circleAnnularEndpointTimeDerivativeScaledSchwartzSymbol_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
