def aux_HasCircleAnnularEndpointUniformKernelBound
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) : Prop :=
  ∃ A : Real, 0 ≤ A ∧ ∀ u : aux_CircleAnnularEndpointLocalIndex,
    _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize
      (aux_circleAnnularEndpointSchwartzFamily C u) ≤ A

/-- A finite Fourier-side certificate for the uniform endpoint-kernel datum.

The first term is the unit-frequency symbol mass, while the second is the
order-four compact Fourier integration-by-parts constant.  Thus the remaining
endpoint analysis is explicitly reduced to uniform bounds for finitely many
frequency derivatives on the fixed annulus; no pointwise smoothness is being
silently promoted to a uniform physical-kernel estimate. -/
theorem aux_hasCircleAnnularEndpointUniformKernelBound_of_uniform_fourierData
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (A₀ A₁ : Real) (hA₀ : 0 ≤ A₀) (hA₁ : 0 ≤ A₁)
    (hmass : ∀ u : aux_CircleAnnularEndpointLocalIndex,
      ∫ η : Euclidean 2, ‖aux_circleAnnularEndpointSchwartzFamily C u η‖ ≤ A₀)
    (hibp : ∀ u : aux_CircleAnnularEndpointLocalIndex,
      _root_.Auto.MikhlinHormander.compactFourierIBPConstant (N := 4)
        (aux_circleAnnularEndpointSchwartzFamily C u : Euclidean 2 → Complex) ≤ A₁) :
    aux_HasCircleAnnularEndpointUniformKernelBound C := by
  refine ⟨A₀ + A₁, add_nonneg hA₀ hA₁, ?_⟩
  intro u
  calc
    _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize
        (aux_circleAnnularEndpointSchwartzFamily C u) ≤
        (∫ η : Euclidean 2, ‖aux_circleAnnularEndpointSchwartzFamily C u η‖) +
          _root_.Auto.MikhlinHormander.compactFourierIBPConstant (N := 4)
            (aux_circleAnnularEndpointSchwartzFamily C u : Euclidean 2 → Complex) :=
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize_le_compactFourierIBP
        (aux_circleAnnularEndpointSchwartzFamily C u)
    _ ≤ A₀ + A₁ := add_le_add (hmass u) (hibp u)

/-- The common compact support and the proved finite-order endpoint
derivative bounds give a uniform order-four Fourier integration-by-parts
constant for the rescaled endpoint family. -/
theorem exists_compactFourierIBPConstant_circleAnnularEndpointSchwartzFamily_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ A₁ : Real, 0 ≤ A₁ ∧ ∀ u : aux_CircleAnnularEndpointLocalIndex,
      _root_.Auto.MikhlinHormander.compactFourierIBPConstant (N := 4)
        (aux_circleAnnularEndpointSchwartzFamily C u : Euclidean 2 → Complex) ≤ A₁ := by
  choose B hB hderiv using fun n : Nat =>
    exists_uniform_norm_iteratedFDeriv_circleAnnularEndpointSchwartzFamily_le C n
  let R : Real := (2 : Real) ^ (4 : Int)
  let A₁ : Real := (2 : Real) ^ 4 * ∑ n ∈ Finset.range (4 + 1),
    B n * (volume (Metric.closedBall (0 : Euclidean 2) R)).toReal
  have hA₁ : 0 ≤ A₁ := by
    dsimp [A₁]
    apply mul_nonneg (by positivity)
    apply Finset.sum_nonneg
    intro n hn
    exact mul_nonneg (hB n) ENNReal.toReal_nonneg
  refine ⟨A₁, hA₁, ?_⟩
  intro u
  have hmain :=
    Auto.MikhlinHormander.compactFourierIBPConstant_le_of_support_subset_of_uniform_deriv_bound
      (aux_circleAnnularEndpointSchwartzFamily C u : Euclidean 2 → Complex)
      ((aux_circleAnnularEndpointSchwartzFamily C u).smooth 4)
      (R := R) (circleAnnularEndpointSchwartzFamily_support_subset C u) B
      (fun n hn η => hderiv n u η)
  simpa [A₁, R] using hmain

/-- The rescaled circle endpoint family has the unconditional uniform
physical-kernel bound required by the compact-annular Mikhlin argument. -/
theorem hasCircleAnnularEndpointUniformKernelBound
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    aux_HasCircleAnnularEndpointUniformKernelBound C := by
  obtain ⟨A₀, hA₀, hmass⟩ := exists_integral_norm_circleAnnularEndpointSchwartzFamily_le C
  obtain ⟨A₁, hA₁, hibp⟩ :=
    exists_compactFourierIBPConstant_circleAnnularEndpointSchwartzFamily_le C
  exact aux_hasCircleAnnularEndpointUniformKernelBound_of_uniform_fourierData
    C A₀ A₁ hA₀ hA₁ hmass hibp

/-- The maximal compact-annular multiplier family associated to the local
circle endpoint symbols. It is real-valued because it takes a pointwise
supremum of complex multiplier norms. -/
noncomputable def aux_circleAnnularEndpointMultiplierMaximal
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Real :=
  _root_.Auto.MikhlinHormander.annularSchwartzMultiplier
    (aux_circleAnnularEndpointSchwartzFamily C)
    aux_circleAnnularEndpointFrequencyScale f

/-- At a fixed endpoint parameter, evaluating the unit-frequency Schwartz
symbol at its reciprocal dyadic radius recovers the literal physical
annular endpoint multiplier. -/
theorem aux_circleAnnularEndpointScaledSchwartzSymbol_at_dyadicScale
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (ξ : Euclidean 2) :
    aux_circleAnnularEndpointScaledSchwartzSymbol C σ j t
        ((aux_circleAnnularEndpointDyadicScale j).1 • ξ) =
      circleAnnularEndpointSchwartzSymbol C σ j t ξ := by
  rw [aux_circleAnnularEndpointScaledSchwartzSymbol_apply,
    circleAnnularEndpointScaledSymbol]
  simp [aux_circleAnnularEndpointDyadicScale,
    circleAnnularEndpointSchwartzSymbol_apply]

/-- The reciprocal dyadic-scale presentation retains the exact endpoint
factorization through the MSS half-wave symbol. -/
theorem aux_circleAnnularEndpointScaledSchwartzSymbol_factorization_at_dyadicScale
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (ξ : Euclidean 2) :
    (circleEndpointDyadicNormalization j)⁻¹ *
        aux_circleAnnularEndpointScaledSchwartzSymbol C σ j t
          ((aux_circleAnnularEndpointDyadicScale j).1 • ξ) *
        _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ j t ξ =
      ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖ξ‖)) *
        _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t ξ *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ := by
  rw [aux_circleAnnularEndpointScaledSchwartzSymbol_at_dyadicScale]
  exact circleAnnularEndpointSchwartzSymbol_factorization C σ j t ξ

/-- At a fixed endpoint parameter, the correctly scaled member of the
abstract compact-annular family is the literal Fourier multiplier by the
annular endpoint symbol. -/
theorem aux_circleAnnularEndpointRelativeMultiplierAt_dyadicScale
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Icc (1 : Real) 2)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
        (aux_circleAnnularEndpointSchwartzFamily C ⟨σ, ⟨j, t⟩⟩)
        (aux_circleAnnularEndpointFrequencyScale ⟨σ, ⟨j, t⟩⟩) f x =
      𝓕⁻ (fun ξ : Euclidean 2 =>
        circleAnnularEndpointSchwartzSymbol C σ j t.1 ξ *
          𝓕 (f : Euclidean 2 → Complex) ξ) x := by
  unfold _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext ξ
  change aux_circleAnnularEndpointScaledSchwartzSymbol C σ j t.1
      ((aux_circleAnnularEndpointDyadicScale j).1 • ξ) *
        𝓕 (f : Euclidean 2 → Complex) ξ = _
  rw [aux_circleAnnularEndpointScaledSchwartzSymbol_at_dyadicScale]

/-- The literal dyadic half-wave output, packaged as a Schwartz function for
the compact-annular relative-multiplier family. -/
noncomputable def circleAnnularEndpointHalfWaveOutput
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) : SchwartzMap (Euclidean 2) Complex :=
  𝓕⁻ (SchwartzMap.smulLeftCLM Complex
    (_root_.Auto.Spherical.MSS.dyadicHalfWaveSchwartzSymbol C σ j t :
      Euclidean 2 → Complex)
    (𝓕 f))

/-- Fourier-side formula for the Schwartz half-wave output used by the
annular endpoint factorization. -/
theorem circleAnnularEndpointHalfWaveOutput_fourier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) (ξ : Euclidean 2) :
    𝓕 (circleAnnularEndpointHalfWaveOutput C σ j t f : Euclidean 2 → Complex) ξ =
      _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ j t ξ *
        𝓕 (f : Euclidean 2 → Complex) ξ := by
  unfold circleAnnularEndpointHalfWaveOutput
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  simp only [SchwartzMap.smulLeftCLM_apply
    (_root_.Auto.Spherical.MSS.dyadicHalfWaveSchwartzSymbol C σ j t).hasTemperateGrowth,
    smul_eq_mul, _root_.Auto.Spherical.MSS.dyadicHalfWaveSchwartzSymbol_apply,
    SchwartzMap.fourier_coe]

/-- The packaged endpoint half-wave output is pointwise the literal dyadic
half-wave, so the relative-multiplier factorization does not replace the
physical MSS operator by an auxiliary realization. -/
theorem circleAnnularEndpointHalfWaveOutput_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    circleAnnularEndpointHalfWaveOutput C σ j t f x =
      _root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ j t f x := by
  unfold circleAnnularEndpointHalfWaveOutput
  rw [SchwartzMap.fourierInv_coe]
  apply congrArg (fun q : Euclidean 2 → Complex => 𝓕⁻ q x)
  funext ξ
  simp only [SchwartzMap.smulLeftCLM_apply
    (_root_.Auto.Spherical.MSS.dyadicHalfWaveSchwartzSymbol C σ j t).hasTemperateGrowth,
    smul_eq_mul, _root_.Auto.Spherical.MSS.dyadicHalfWaveSchwartzSymbol_apply,
    _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol, SchwartzMap.fourier_coe]

/-- The endpoint contribution written with the fat annular Schwartz symbol.
It agrees with the original low-pass presentation after multiplication by
the dyadic half-wave, but has a literal compact Schwartz multiplier factor. -/
noncomputable def aux_circleAnnularEndpointWaveContribution
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun ξ : Euclidean 2 =>
    (circleEndpointDyadicNormalization j)⁻¹ *
      circleAnnularEndpointSchwartzSymbol C σ j t ξ *
      _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ j t ξ *
      𝓕 (f : Euclidean 2 → Complex) ξ) x

/-- Each physical annular endpoint term is exactly one member of the proved
compact-annular relative multiplier family acting on the literal dyadic
half-wave output. -/
theorem aux_circleAnnularEndpointWaveContribution_eq_relativeMultiplier_halfWave
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Icc (1 : Real) 2)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    aux_circleAnnularEndpointWaveContribution C σ j t.1 f x =
      (circleEndpointDyadicNormalization j)⁻¹ *
        _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
          (aux_circleAnnularEndpointSchwartzFamily C ⟨σ, ⟨j, t⟩⟩)
          (aux_circleAnnularEndpointFrequencyScale ⟨σ, ⟨j, t⟩⟩)
          (circleAnnularEndpointHalfWaveOutput C σ j t.1 f) x := by
  rw [aux_circleAnnularEndpointRelativeMultiplierAt_dyadicScale]
  rw [aux_const_mul_fourierInv]
  unfold aux_circleAnnularEndpointWaveContribution
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext ξ
  rw [circleAnnularEndpointHalfWaveOutput_fourier]
  ring

/-- Uniform annular stability of the literal endpoint contribution.  After
the stationary normalization, every local-time/sign/scale endpoint is a
compact relative multiplier applied to the actual dyadic half-wave output;
the proved kernel certificate therefore gives one dyadic
Hardy--Littlewood-maximal majorant for all of them. -/
theorem exists_circleAnnularEndpointWaveContribution_dyadicBall_stability
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ K : Real, 0 < K ∧ ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
      (j : Nat) (t : Icc (1 : Real) 2)
      (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2),
      ‖aux_circleAnnularEndpointWaveContribution C σ j t.1 f x‖ ≤
        ‖(circleEndpointDyadicNormalization j)⁻¹‖ *
          (K * _root_.Auto.HardyLittlewoodMaximal.dyadicBallMaximal 2
            (circleAnnularEndpointHalfWaveOutput C σ j t.1 f : Euclidean 2 → Complex) x) := by
  rcases hasCircleAnnularEndpointUniformKernelBound C with ⟨A, hA, hkernel⟩
  obtain ⟨K, hK, hterm⟩ :=
    _root_.Auto.MikhlinHormander.uniform_relativeSchwartzMultiplierAt_majorant_of_kernel_bound
      (aux_circleAnnularEndpointSchwartzFamily C) hA hkernel
  refine ⟨K, hK, ?_⟩
  intro σ j t f x
  rw [aux_circleAnnularEndpointWaveContribution_eq_relativeMultiplier_halfWave]
  rw [norm_mul]
  exact mul_le_mul_of_nonneg_left
    (hterm ⟨σ, ⟨j, t⟩⟩ (circleAnnularEndpointHalfWaveOutput C σ j t.1 f)
      (aux_circleAnnularEndpointFrequencyScale ⟨σ, ⟨j, t⟩⟩) x)
    (norm_nonneg _)

/-- Fixed-time `L⁴` stability of the literal annular endpoint contribution.
This is the spatial consequence of the uniform compact-annular multiplier
certificate: the local-time endpoint is controlled by the corresponding
literal dyadic half-wave output, uniformly in sign and dyadic scale. -/
theorem exists_integral_norm_pow_four_circleAnnularEndpointWaveContribution_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
      (j : Nat) (t : Icc (1 : Real) 2)
      (f : SchwartzMap (Euclidean 2) Complex),
      (∫ x : Euclidean 2, ‖aux_circleAnnularEndpointWaveContribution C σ j t.1 f x‖ ^ 4) ≤
        ‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * B *
          ∫ x : Euclidean 2, ‖circleAnnularEndpointHalfWaveOutput C σ j t.1 f x‖ ^ 4 := by
  rcases exists_circleAnnularEndpointWaveContribution_dyadicBall_stability C with
    ⟨K, hK, hstability⟩
  obtain ⟨H, hH, hhardy⟩ :=
    _root_.Auto.HardyLittlewoodMaximal.dyadic_hardy_littlewood_maximal_strong_type_schwartz
      (d := 2) (by norm_num) (p := 4) (by norm_num)
  refine ⟨K ^ 4 * H, mul_pos (Real.rpow_pos_of_pos hK _) hH, ?_⟩
  intro σ j t f
  let u : SchwartzMap (Euclidean 2) Complex :=
    circleAnnularEndpointHalfWaveOutput C σ j t.1 f
  let E : Euclidean 2 → Complex := aux_circleAnnularEndpointWaveContribution C σ j t.1 f
  let M : Euclidean 2 → Real :=
    _root_.Auto.HardyLittlewoodMaximal.dyadicBallMaximal 2
      (u : Euclidean 2 → Complex)
  have hM := hhardy u
  have hMnonneg (x : Euclidean 2) : 0 ≤ M x := ENNReal.toReal_nonneg
  have hMpowInt : Integrable (fun x : Euclidean 2 => M x ^ 4) := by
    have h := hM.1.integrable_norm_rpow (by norm_num : (ENNReal.ofReal (4 : Real)) ≠ 0)
      ENNReal.ofReal_ne_top
    convert h using 1
    funext x
    rw [Real.norm_eq_abs, abs_of_nonneg (hMnonneg x),
      ENNReal.toReal_ofReal (by norm_num : (0 : Real) ≤ 4)]
    norm_num
  have hEcont : Continuous E := by
    rw [show E = fun x => (circleEndpointDyadicNormalization j)⁻¹ *
        _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
          (aux_circleAnnularEndpointSchwartzFamily C ⟨σ, ⟨j, t⟩⟩)
          (aux_circleAnnularEndpointFrequencyScale ⟨σ, ⟨j, t⟩⟩) u x by
      funext x
      exact aux_circleAnnularEndpointWaveContribution_eq_relativeMultiplier_halfWave C σ j t f x]
    exact (_root_.Auto.MikhlinHormander.continuous_relativeSchwartzMultiplierAt
      (aux_circleAnnularEndpointSchwartzFamily C ⟨σ, ⟨j, t⟩⟩) u
      (aux_circleAnnularEndpointFrequencyScale ⟨σ, ⟨j, t⟩⟩)).const_mul _
  have hpoint (x : Euclidean 2) : ‖E x‖ ^ 4 ≤
      (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * K ^ 4) * M x ^ 4 := by
    have h := hstability σ j t f x
    change ‖E x‖ ≤ _ at h
    calc
      ‖E x‖ ^ 4 ≤ (‖(circleEndpointDyadicNormalization j)⁻¹‖ * (K * M x)) ^ 4 :=
        pow_le_pow_left₀ (norm_nonneg _) h 4
      _ = (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * K ^ 4) * M x ^ 4 := by
        ring
  have hdomInt : Integrable (fun x : Euclidean 2 =>
      (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * K ^ 4) * M x ^ 4) :=
    hMpowInt.const_mul _
  have hEpowInt : Integrable (fun x : Euclidean 2 => ‖E x‖ ^ 4) := by
    refine Integrable.mono' hdomInt (hEcont.norm.pow 4).aestronglyMeasurable ?_
    filter_upwards with x
    change ‖‖E x‖ ^ (4 : Nat)‖ ≤ _
    rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (norm_nonneg _) _)]
    exact hpoint x
  calc
    (∫ x : Euclidean 2, ‖aux_circleAnnularEndpointWaveContribution C σ j t.1 f x‖ ^ 4) =
        ∫ x : Euclidean 2, ‖E x‖ ^ 4 := rfl
    _ ≤ ∫ x : Euclidean 2, (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * K ^ 4) * M x ^ 4 :=
      integral_mono hEpowInt hdomInt hpoint
    _ = (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * K ^ 4) *
        ∫ x : Euclidean 2, M x ^ 4 := by rw [integral_const_mul]
    _ ≤ (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * K ^ 4) *
        (H * ∫ x : Euclidean 2, ‖u x‖ ^ 4) := by
      apply mul_le_mul_of_nonneg_left
        (show (∫ x : Euclidean 2, M x ^ 4) ≤ H * ∫ x : Euclidean 2, ‖u x‖ ^ 4 by
          convert hM.2 using 1
          · apply integral_congr_ae
            filter_upwards with x
            change M x ^ (4 : Nat) = M x ^ (4 : Real)
            exact (Real.rpow_natCast (M x) 4).symm
          · congr 1
            apply integral_congr_ae
            filter_upwards with x
            exact (Real.rpow_natCast ‖u x‖ 4).symm)
        (by positivity)
    _ = ‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * (K ^ 4 * H) *
        ∫ x : Euclidean 2, ‖u x‖ ^ 4 := by ring
    _ = _ := by simp [u]

/-- The annular endpoint contribution has the same literal Fourier-side
factorization as the original endpoint contribution. -/
theorem aux_circleAnnularEndpointWaveContribution_factorization
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    aux_circleAnnularEndpointWaveContribution C σ j t f x =
      𝓕⁻ (fun ξ : Euclidean 2 =>
        ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude σ (2 * Real.pi * (t * ‖ξ‖)) *
          _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t ξ *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ *
          𝓕 (f : Euclidean 2 → Complex) ξ) x := by
  unfold aux_circleAnnularEndpointWaveContribution
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext ξ
  rw [circleAnnularEndpointSchwartzSymbol_factorization]

/-- On the active dyadic half-wave the annular Schwartz endpoint and the
original low-pass endpoint give exactly the same physical-space term. -/
theorem aux_circleAnnularEndpointWaveContribution_eq_circleEndpointWaveContribution
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) :
    aux_circleAnnularEndpointWaveContribution C σ j t f =
      circleEndpointWaveContribution C σ j t f := by
  funext x
  rw [aux_circleAnnularEndpointWaveContribution_factorization,
    circleEndpointWaveContribution_factorization]

/-- Exact three-wave circle decomposition with both endpoint terms written
through their fat annular Schwartz multipliers. This is the form to which the
conditional uniform compact-annular multiplier estimate applies. -/
theorem aux_circleDyadicBandpassThreeWaveDecomposition_annularEndpoint
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) {t : Real} (ht : 0 ≤ t)
    (x : Euclidean 2) :
    circularAverage t
        (dyadicBandpassProjection
          (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j) f :
          Euclidean 2 → Complex) x =
      aux_circleAnnularEndpointWaveContribution C _root_.Auto.Spherical.MSS.WaveSign.minus
          j t f x +
        aux_circleAnnularEndpointWaveContribution C _root_.Auto.Spherical.MSS.WaveSign.plus
          j t f x + circleMiddleWaveContribution C j t f x := by
  rw [circleDyadicBandpassThreeWaveDecomposition C j f ht x,
    ← aux_circleAnnularEndpointWaveContribution_eq_circleEndpointWaveContribution,
    ← aux_circleAnnularEndpointWaveContribution_eq_circleEndpointWaveContribution]

/-- Under the explicit uniform endpoint-kernel hypothesis, the entire local
time/sign/scale endpoint family has one dyadic Hardy--Littlewood maximal
majorant. This is the pointwise multiplier input used before applying the
local-smoothing estimate. -/
theorem aux_circleAnnularEndpointMultiplierMaximal_majorant_of_uniformKernelBound
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (hkernel : aux_HasCircleAnnularEndpointUniformKernelBound C) :
    ∃ K : Real, 0 < K ∧ ∀ (f : SchwartzMap (Euclidean 2) Complex)
      (x : Euclidean 2),
      aux_circleAnnularEndpointMultiplierMaximal C f x ≤
        K * _root_.Auto.HardyLittlewoodMaximal.dyadicBallMaximal 2
          (f : Euclidean 2 → Complex) x := by
  rcases hkernel with ⟨A, hA, hfamily⟩
  simpa only [aux_circleAnnularEndpointMultiplierMaximal] using
    (_root_.Auto.MikhlinHormander.annularSchwartzMultiplier_majorant_of_kernel_bound
      (aux_circleAnnularEndpointSchwartzFamily C)
      aux_circleAnnularEndpointFrequencyScale hA hfamily)

/-- The unconditional endpoint majorant obtained from the uniform Fourier-side
certificate. -/
theorem aux_circleAnnularEndpointMultiplierMaximal_majorant
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ K : Real, 0 < K ∧ ∀ (f : SchwartzMap (Euclidean 2) Complex)
      (x : Euclidean 2),
      aux_circleAnnularEndpointMultiplierMaximal C f x ≤
        K * _root_.Auto.HardyLittlewoodMaximal.dyadicBallMaximal 2
          (f : Euclidean 2 → Complex) x :=
  aux_circleAnnularEndpointMultiplierMaximal_majorant_of_uniformKernelBound C
    (hasCircleAnnularEndpointUniformKernelBound C)

/-- Conditional form of the uniform strong type for the circle endpoint
cutoff family. -/
theorem aux_circleAnnularEndpointMultiplierMaximal_strong_type_of_uniformKernelBound
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {p : Real} (hp : 1 < p)
    (hkernel : aux_HasCircleAnnularEndpointUniformKernelBound C) :
    ∃ B : Real, 0 < B ∧ ∀ f : SchwartzMap (Euclidean 2) Complex,
      MemLp (aux_circleAnnularEndpointMultiplierMaximal C f) (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean 2, (aux_circleAnnularEndpointMultiplierMaximal C f x) ^ p) ≤
        B * ∫ x : Euclidean 2, ‖f x‖ ^ p := by
  rcases hkernel with ⟨A, hA, hfamily⟩
  simpa only [aux_circleAnnularEndpointMultiplierMaximal] using
    (_root_.Auto.MikhlinHormander.annularSchwartzMultiplier_strong_type_of_kernel_bound
      (d := 2) (by norm_num) hp
      (aux_circleAnnularEndpointSchwartzFamily C)
      aux_circleAnnularEndpointFrequencyScale hA hfamily)

/-- The unconditional strong type for the complete local endpoint family. -/
theorem aux_circleAnnularEndpointMultiplierMaximal_strong_type
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {p : Real} (hp : 1 < p) :
    ∃ B : Real, 0 < B ∧ ∀ f : SchwartzMap (Euclidean 2) Complex,
      MemLp (aux_circleAnnularEndpointMultiplierMaximal C f) (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean 2, (aux_circleAnnularEndpointMultiplierMaximal C f x) ^ p) ≤
        B * ∫ x : Euclidean 2, ‖f x‖ ^ p :=
  aux_circleAnnularEndpointMultiplierMaximal_strong_type_of_uniformKernelBound C hp
    (hasCircleAnnularEndpointUniformKernelBound C)

/-! ### Literal endpoint time derivative and its uniform annular factor

The literal time derivative is separated into a scale-uniform derivative-annular
factor and a compact radial input factor for the differentiated half-wave. -/

noncomputable def circleEndpointWaveContributionTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun xi : Euclidean 2 =>
    circleEndpointBandpassMultiplierTimeDerivative C σ j t xi *
      𝓕 (f : Euclidean 2 → Complex) xi) x

theorem circleEndpointWaveContributionTimeDerivative_eq_fourierInv_multiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    circleEndpointWaveContributionTimeDerivative C σ j t f x =
      𝓕⁻ (fun xi : Euclidean 2 =>
        circleEndpointBandpassMultiplierTimeDerivative C σ j t xi *
          𝓕 (f : Euclidean 2 → Complex) xi) x := rfl

/-- A compact Schwartz presentation of the literal endpoint multiplier,
used only to validate the ensuing Plancherel estimates. -/
private noncomputable def circleEndpointBandpassSchwartzSymbol
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    SchwartzMap (Euclidean 2) Complex :=
  (circleEndpointDyadicNormalization j)⁻¹ •
    SchwartzMap.smulLeftCLM Complex
      (circleAnnularEndpointSchwartzSymbol C σ j t : Euclidean 2 → Complex)
      (_root_.Auto.Spherical.MSS.dyadicHalfWaveSchwartzSymbol C σ j t)

private theorem circleEndpointBandpassSchwartzSymbol_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (xi : Euclidean 2) :
    circleEndpointBandpassSchwartzSymbol C σ j t xi =
      ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
        _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi := by
  unfold circleEndpointBandpassSchwartzSymbol
  change (circleEndpointDyadicNormalization j)⁻¹ •
      (SchwartzMap.smulLeftCLM Complex
        (circleAnnularEndpointSchwartzSymbol C σ j t : Euclidean 2 → Complex)
        (_root_.Auto.Spherical.MSS.dyadicHalfWaveSchwartzSymbol C σ j t) xi) = _
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (circleAnnularEndpointSchwartzSymbol C σ j t).hasTemperateGrowth,
    _root_.Auto.Spherical.MSS.dyadicHalfWaveSchwartzSymbol_apply]
  simpa only [smul_eq_mul, mul_assoc] using
    circleAnnularEndpointSchwartzSymbol_factorization C σ j t xi

/-- The amplitude part of the endpoint time derivative retains stationary
square-root decay: differentiating in time contributes `‖ξ‖`, which is
cancelled by the extra stationary derivative decay. -/
private theorem exists_norm_circleEndpointAmplitudeTimeDerivative_decay :
    ∃ A : Real, 0 < A ∧ ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
      (t : Real) (xi : Euclidean 2), 1 ≤ t →
      1 ≤ 2 * Real.pi * (t * ‖xi‖) →
      ‖circleEndpointAmplitudeTimeDerivative σ t xi‖ ≤
        A / Real.sqrt (2 * Real.pi * (t * ‖xi‖)) := by
  obtain ⟨A, hA, hdecay⟩ := exists_iteratedDeriv_circleEndpointAmplitude_abs_decay 1
  refine ⟨A, hA, ?_⟩
  intro σ t xi ht hlarge
  let R : Real := 2 * Real.pi * ‖xi‖
  let L : Real := 2 * Real.pi * (t * ‖xi‖)
  have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one hlarge
  have hspos : 0 < Real.sqrt L := Real.sqrt_pos.2 hLpos
  have hRnonneg : 0 ≤ R := by
    dsimp [R]
    positivity
  have hRle : R ≤ L := by
    dsimp [R, L]
    have htnorm : ‖xi‖ ≤ t * ‖xi‖ :=
      le_mul_of_one_le_left (norm_nonneg xi) ht
    exact mul_le_mul_of_nonneg_left htnorm (by positivity)
  have hderiv := hdecay σ L (by
    rw [abs_of_nonneg hLpos.le]
    exact hlarge)
  have hderiv' : ‖deriv (circleEndpointAmplitude σ) L‖ ≤
      A / Real.sqrt L ^ 3 := by
    simpa [Auto.Spherical.OscillatoryIntegralAux.quadraticMomentScale,
      abs_of_nonneg hLpos.le] using hderiv
  have hden : Real.sqrt L ^ 3 = Real.sqrt L * L := by
    calc
      Real.sqrt L ^ 3 = Real.sqrt L * (Real.sqrt L) ^ 2 := by ring
      _ = Real.sqrt L * L := by rw [Real.sq_sqrt hLpos.le]
  have hratio : R * (A / Real.sqrt L ^ 3) ≤ A / Real.sqrt L := by
    rw [hden]
    calc
      R * (A / (Real.sqrt L * L)) = (R / L) * (A / Real.sqrt L) := by
        field_simp
      _ ≤ 1 * (A / Real.sqrt L) := by
        gcongr
        exact (div_le_one₀ hLpos).mpr hRle
      _ = A / Real.sqrt L := by ring
  change ‖(R : Complex) * deriv (circleEndpointAmplitude σ) L‖ ≤ A / Real.sqrt L
  rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg hRnonneg]
  calc
    R * ‖deriv (circleEndpointAmplitude σ) L‖ ≤
        R * (A / Real.sqrt L ^ 3) :=
      mul_le_mul_of_nonneg_left hderiv' hRnonneg
    _ ≤ A / Real.sqrt L := hratio

/-- Fixed-time endpoint multiplier size before taking any time supremum. -/
private theorem exists_norm_circleEndpointBandpassMultiplier_le_dyadicSqrtInverse
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
      (j : Nat) (t : Real) (xi : Euclidean 2), 1 ≤ t → t ≤ 2 →
      ‖((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
        _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ ≤
        B / Real.sqrt (dyadicScale j) := by
  obtain ⟨A, hA, hamp⟩ := exists_circleEndpointAmplitude_decay
  let K : Real := ‖((surfaceMass 2)⁻¹ : Complex)‖ * surfaceMass 1
  let B : Real := 2 * K * A
  have hmass2 : ((surfaceMass 2 : Real) : Complex) ≠ 0 := by
    exact_mod_cast surfaceMass_ne_zero (by norm_num : 0 < 2)
  have hK : 0 < K := by
    dsimp [K]
    have hinv : 0 < ‖((surfaceMass 2)⁻¹ : Complex)‖ :=
      norm_pos_iff.mpr (inv_ne_zero hmass2)
    have hmass1 : 0 < surfaceMass 1 := surfaceMass_pos (by norm_num)
    positivity
  have hB : 0 < B := by
    dsimp only [B]
    positivity
  refine ⟨B, hB, ?_⟩
  intro σ j t xi ht _
  by_cases hband :
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0
  · rw [show ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
        _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0 by
          simp [hband]]
    rw [norm_zero]
    exact div_nonneg hB.le (Real.sqrt_nonneg _)
  · let L : Real := 2 * Real.pi * (t * ‖xi‖)
    have hfrequency : dyadicScale j ≤ L := by
      simpa only [dyadicScale] using
        aux_dyadicFrequency_le_circleEndpointFrequency C j t xi ht hband
    have hscaleone : 1 ≤ dyadicScale j := by
      calc
        1 = dyadicScale 0 := by simp [dyadicScale]
        _ ≤ dyadicScale j := dyadicScale_mono (Nat.zero_le j)
    have hlarge : 1 ≤ L := hscaleone.trans hfrequency
    have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one hlarge
    have hscalePos : 0 < dyadicScale j := dyadicScale_pos j
    have hsqrtScale : 0 < Real.sqrt (dyadicScale j) := Real.sqrt_pos.2 hscalePos
    have hamp' : ‖circleEndpointAmplitude σ L‖ ≤ A / Real.sqrt L :=
      hamp σ L hlarge
    have hratio : A / Real.sqrt L ≤ A / Real.sqrt (dyadicScale j) :=
      div_le_div_of_nonneg_left hA.le hsqrtScale
        (Real.sqrt_le_sqrt hfrequency)
    have hcut :
        ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ ≤ 2 :=
      _root_.Auto.LittlewoodPaley.norm_dyadicBandpassMultiplier_le_two C j xi
    have hinner : ‖circleEndpointAmplitude σ L‖ *
        ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ ≤
        (A / Real.sqrt L) * 2 := by
      exact mul_le_mul hamp' hcut (norm_nonneg _) (div_nonneg hA.le (Real.sqrt_nonneg _))
    have hmass1 : 0 ≤ surfaceMass 1 := (surfaceMass_pos (by norm_num)).le
    change ‖((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      circleEndpointAmplitude σ L *
      _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ ≤
      B / Real.sqrt (dyadicScale j)
    calc
      ‖((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude σ L *
          _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ =
          K * (‖circleEndpointAmplitude σ L‖ *
            ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖) := by
          unfold K
          rw [norm_mul, norm_mul, norm_mul, norm_mul, Complex.norm_real,
            Real.norm_of_nonneg hmass1,
            _root_.Auto.Spherical.MSS.norm_halfWaveMultiplier]
          ring
      _ ≤ K * ((A / Real.sqrt L) * 2) :=
        mul_le_mul_of_nonneg_left hinner hK.le
      _ = (2 * K) * (A / Real.sqrt L) := by ring
      _ ≤ (2 * K) * (A / Real.sqrt (dyadicScale j)) := by
        exact mul_le_mul_of_nonneg_left hratio (by positivity)
      _ = B / Real.sqrt (dyadicScale j) := by
        dsimp [B]
        ring

/-- Plancherel turns the literal stationary endpoint multiplier estimate into
the exact fixed-time `L²` gain of one half dyadic power. -/
theorem exists_integral_norm_sq_circleEndpointWaveContribution_le_dyadicSqrtInverse
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
      (j : Nat) (t : Real), 1 ≤ t → t ≤ 2 →
      ∀ f : SchwartzMap (Euclidean 2) Complex,
        (∫ x : Euclidean 2, ‖circleEndpointWaveContribution C σ j t f x‖ ^ 2) ≤
          (B / Real.sqrt (dyadicScale j)) ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨B, hB, hpoint⟩ :=
    exists_norm_circleEndpointBandpassMultiplier_le_dyadicSqrtInverse C
  refine ⟨B, hB, ?_⟩
  intro σ j t ht htop f
  let m : SchwartzMap (Euclidean 2) Complex :=
    circleEndpointBandpassSchwartzSymbol C σ j t
  have hm_bound (xi : Euclidean 2) : ‖m xi‖ ≤ B / Real.sqrt (dyadicScale j) := by
    rw [show m xi = circleEndpointBandpassSchwartzSymbol C σ j t xi by rfl,
      circleEndpointBandpassSchwartzSymbol_apply]
    exact hpoint σ j t xi ht htop
  have hmult := _root_.Auto.Spherical.Auxiliary.integral_norm_sq_fourierInv_schwartz_multiplier_le
    m (𝓕 f) (div_nonneg hB.le (Real.sqrt_nonneg _)) hm_bound
  calc
    (∫ x : Euclidean 2, ‖circleEndpointWaveContribution C σ j t f x‖ ^ 2) =
        ∫ x : Euclidean 2, ‖𝓕⁻ (fun xi : Euclidean 2 =>
          m xi * 𝓕 (f : Euclidean 2 → Complex) xi) x‖ ^ 2 := by
          congr 1
          funext x
          rw [circleEndpointWaveContribution_factorization C σ j t f x]
          congr 2
          apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
          funext xi
          rw [show m xi = circleEndpointBandpassSchwartzSymbol C σ j t xi by rfl,
            circleEndpointBandpassSchwartzSymbol_apply]
    _ ≤ (B / Real.sqrt (dyadicScale j)) ^ 2 *
        ∫ xi : Euclidean 2, ‖𝓕 (f : Euclidean 2 → Complex) xi‖ ^ 2 := hmult
    _ = (B / Real.sqrt (dyadicScale j)) ^ 2 *
        ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
      rw [_root_.Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq]

private theorem norm_halfWaveMultiplierTimeDerivative
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (t : Real) (xi : Euclidean 2) :
    ‖_root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t xi‖ =
      2 * Real.pi * ‖xi‖ := by
  cases σ <;>
    simp [
      _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative,
      _root_.Auto.Spherical.MSS.WaveSign.toReal,
      _root_.Auto.Spherical.MSS.norm_halfWaveMultiplier,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg, Real.pi_pos.le,
      ]

/-- The literal endpoint multiplier time derivative has the expected
`sqrt (2^j)` size.  Thus fixed-time endpoint energy is `O(2^j)`, precisely
balancing the `O(2^{-j})` energy of the undifferentiated endpoint. -/
private theorem exists_norm_circleEndpointBandpassMultiplierTimeDerivative_le_dyadicSqrt
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
      (j : Nat) (t : Real) (xi : Euclidean 2), 1 ≤ t → t ≤ 2 →
      ‖circleEndpointBandpassMultiplierTimeDerivative C σ j t xi‖ ≤
        B * Real.sqrt (dyadicScale j) := by
  obtain ⟨A, hA, hamp⟩ := exists_circleEndpointAmplitude_decay
  obtain ⟨D, hD, htime⟩ := exists_norm_circleEndpointAmplitudeTimeDerivative_decay
  let K : Real := ‖((surfaceMass 2)⁻¹ : Complex)‖ * surfaceMass 1
  let B : Real := 2 * K * (D + 8 * Real.pi * A)
  have hmass2 : ((surfaceMass 2 : Real) : Complex) ≠ 0 := by
    exact_mod_cast surfaceMass_ne_zero (by norm_num : 0 < 2)
  have hK : 0 < K := by
    dsimp [K]
    have hinv : 0 < ‖((surfaceMass 2)⁻¹ : Complex)‖ :=
      norm_pos_iff.mpr (inv_ne_zero hmass2)
    have hmass1 : 0 < surfaceMass 1 := surfaceMass_pos (by norm_num)
    positivity
  have hB : 0 < B := by
    dsimp [B]
    positivity
  refine ⟨B, hB, ?_⟩
  intro σ j t xi ht _
  by_cases hband :
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0
  · rw [show circleEndpointBandpassMultiplierTimeDerivative C σ j t xi = 0 by
        simp [circleEndpointBandpassMultiplierTimeDerivative, hband]]
    rw [norm_zero]
    positivity
  · let d : Real := dyadicScale j
    let L : Real := 2 * Real.pi * (t * ‖xi‖)
    let R : Real := 2 * Real.pi * ‖xi‖
    have hdpos : 0 < d := by
      dsimp [d]
      exact dyadicScale_pos j
    have hdone : 1 ≤ d := by
      dsimp [d]
      calc
        1 = dyadicScale 0 := by simp [dyadicScale]
        _ ≤ dyadicScale j := dyadicScale_mono (Nat.zero_le j)
    have hfrequency : d ≤ L := by
      dsimp [d, L]
      simpa only [dyadicScale] using
        aux_dyadicFrequency_le_circleEndpointFrequency C j t xi ht hband
    have hlarge : 1 ≤ L := hdone.trans hfrequency
    have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one hlarge
    have hspos : 0 < Real.sqrt d := Real.sqrt_pos.2 hdpos
    have hsquare : (Real.sqrt d) * Real.sqrt d = d := by
      rw [← pow_two]
      exact Real.sq_sqrt hdpos.le
    have hxi : ‖xi‖ < (2 : Real) ^ (j + 2) := by
      by_contra hnot
      exact hband
        (_root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_le_norm C
          (le_of_not_gt hnot))
    have hpow : (2 : Real) ^ (j + 2) = 4 * d := by
      dsimp [d, dyadicScale]
      rw [show j + 2 = j + 2 by rfl, pow_add]
      ring
    have hxiupper : ‖xi‖ ≤ 4 * d := by
      calc
        ‖xi‖ ≤ (2 : Real) ^ (j + 2) := hxi.le
        _ = 4 * d := hpow
    have hRnonneg : 0 ≤ R := by
      dsimp [R]
      positivity
    have hRupper : R ≤ 8 * Real.pi * d := by
      dsimp [R]
      calc
        2 * Real.pi * ‖xi‖ ≤ 2 * Real.pi * (4 * d) :=
          mul_le_mul_of_nonneg_left hxiupper (by positivity)
        _ = 8 * Real.pi * d := by ring
    have hsqrt_le : Real.sqrt d ≤ Real.sqrt L := Real.sqrt_le_sqrt hfrequency
    have hampRaw : ‖circleEndpointAmplitude σ L‖ ≤ A / Real.sqrt L :=
      hamp σ L hlarge
    have hampBound : ‖circleEndpointAmplitude σ L‖ ≤ A / Real.sqrt d :=
      hampRaw.trans (div_le_div_of_nonneg_left hA.le hspos hsqrt_le)
    have htimeRaw : ‖circleEndpointAmplitudeTimeDerivative σ t xi‖ ≤
        D / Real.sqrt L := htime σ t xi ht hlarge
    have htimeBound : ‖circleEndpointAmplitudeTimeDerivative σ t xi‖ ≤
        D / Real.sqrt d :=
      htimeRaw.trans (div_le_div_of_nonneg_left hD.le hspos hsqrt_le)
    have hinv_le : (1 : Real) / Real.sqrt d ≤ Real.sqrt d := by
      apply (div_le_iff₀ hspos).mpr
      rw [hsquare]
      exact hdone
    have htimeSqrt : ‖circleEndpointAmplitudeTimeDerivative σ t xi‖ ≤
        D * Real.sqrt d := by
      calc
        ‖circleEndpointAmplitudeTimeDerivative σ t xi‖ ≤ D / Real.sqrt d := htimeBound
        _ = D * (1 / Real.sqrt d) := by ring
        _ ≤ D * Real.sqrt d := mul_le_mul_of_nonneg_left hinv_le hD.le
    have hhalfTime := norm_halfWaveMultiplierTimeDerivative σ t xi
    have hsecond : ‖circleEndpointAmplitude σ L *
        _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t xi‖ ≤
        (8 * Real.pi * A) * Real.sqrt d := by
      rw [norm_mul, hhalfTime]
      calc
        ‖circleEndpointAmplitude σ L‖ * R ≤ (A / Real.sqrt d) * R :=
          mul_le_mul_of_nonneg_right hampBound hRnonneg
        _ ≤ (A / Real.sqrt d) * (8 * Real.pi * d) :=
          mul_le_mul_of_nonneg_left hRupper (div_nonneg hA.le hspos.le)
        _ = (8 * Real.pi * A) * Real.sqrt d := by
          have hfactor : d / Real.sqrt d = Real.sqrt d := by
            calc
              d / Real.sqrt d = (Real.sqrt d * Real.sqrt d) / Real.sqrt d := by
                rw [hsquare]
              _ = Real.sqrt d := by
                field_simp
          calc
            (A / Real.sqrt d) * (8 * Real.pi * d) =
                (8 * Real.pi * A) * (d / Real.sqrt d) := by ring
            _ = _ := by rw [hfactor]
    have hfirst : ‖circleEndpointAmplitudeTimeDerivative σ t xi *
        _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi‖ ≤
        D * Real.sqrt d := by
      rw [norm_mul, _root_.Auto.Spherical.MSS.norm_halfWaveMultiplier, mul_one]
      exact htimeSqrt
    have hsum : ‖circleEndpointAmplitudeTimeDerivative σ t xi *
          _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi +
        circleEndpointAmplitude σ L *
          _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t xi‖ ≤
        (D + 8 * Real.pi * A) * Real.sqrt d := by
      calc
        _ ≤ ‖circleEndpointAmplitudeTimeDerivative σ t xi *
          _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi‖ +
          ‖circleEndpointAmplitude σ L *
            _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t xi‖ :=
          norm_add_le _ _
        _ ≤ D * Real.sqrt d + (8 * Real.pi * A) * Real.sqrt d :=
          add_le_add hfirst hsecond
        _ = (D + 8 * Real.pi * A) * Real.sqrt d := by ring
    have hcut :
        ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ ≤ 2 :=
      _root_.Auto.LittlewoodPaley.norm_dyadicBandpassMultiplier_le_two C j xi
    have hinner : ‖circleEndpointAmplitudeTimeDerivative σ t xi *
          _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi +
        circleEndpointAmplitude σ L *
          _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t xi‖ *
        ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ ≤
        ((D + 8 * Real.pi * A) * Real.sqrt d) * 2 :=
      mul_le_mul hsum hcut (norm_nonneg _) (by positivity)
    have hmass1 : 0 ≤ surfaceMass 1 := (surfaceMass_pos (by norm_num)).le
    change ‖((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      (circleEndpointAmplitudeTimeDerivative σ t xi *
          _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi +
        circleEndpointAmplitude σ L *
          _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t xi) *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ ≤
      B * Real.sqrt (dyadicScale j)
    calc
      ‖((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          (circleEndpointAmplitudeTimeDerivative σ t xi *
              _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi +
            circleEndpointAmplitude σ L *
              _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t xi) *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ =
          K * (‖circleEndpointAmplitudeTimeDerivative σ t xi *
              _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi +
            circleEndpointAmplitude σ L *
              _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t xi‖ *
            ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖) := by
          unfold K
          rw [norm_mul, norm_mul, norm_mul, Complex.norm_real,
            Real.norm_of_nonneg hmass1]
          ring
      _ ≤ K * (((D + 8 * Real.pi * A) * Real.sqrt d) * 2) :=
        mul_le_mul_of_nonneg_left hinner hK.le
      _ = B * Real.sqrt d := by
        dsimp [B]
        ring
      _ = B * Real.sqrt (dyadicScale j) := by rfl

private theorem circleEndpointBandpassMultiplierTimeDerivative_eventuallyEq_zero_at_zero
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    circleEndpointBandpassMultiplierTimeDerivative C σ j t =ᶠ[nhds 0] fun _ => 0 := by
  filter_upwards [Metric.ball_mem_nhds (0 : Euclidean 2) zero_lt_one] with xi hxi
  have hxinorm : ‖xi‖ < 1 := by
    simpa only [Metric.mem_ball, dist_zero_right] using hxi
  have hone : 1 ≤ (2 : Real) ^ j :=
    one_le_pow₀ (by norm_num : (1 : Real) ≤ 2)
  have hband :
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0 :=
    _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_norm_le C
      (hxinorm.le.trans hone)
  simp [circleEndpointBandpassMultiplierTimeDerivative, hband]

private theorem contDiff_circleEndpointBandpassMultiplierTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    ContDiff Real (⊤ : ℕ∞) (circleEndpointBandpassMultiplierTimeDerivative C σ j t) := by
  rw [contDiff_iff_contDiffAt]
  intro xi
  by_cases hxi : xi = 0
  · subst xi
    exact (contDiffAt_const (c := (0 : Complex))).congr_of_eventuallyEq
      (circleEndpointBandpassMultiplierTimeDerivative_eventuallyEq_zero_at_zero C σ j t)
  · have hnorm : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 => ‖eta‖) xi :=
      contDiffAt_norm Real hxi
    have hscale : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
        ((2 * Real.pi * ‖eta‖ : Real) : Complex)) xi := by
      have hscaleReal : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
          2 * Real.pi * ‖eta‖) xi := by
        fun_prop
      exact Complex.ofRealCLM.contDiff.contDiffAt.comp xi hscaleReal
    have harg : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
        2 * Real.pi * (t * ‖eta‖)) xi := by
      fun_prop
    have hderiv : ContDiff Real (⊤ : ℕ∞) (deriv (circleEndpointAmplitude σ)) :=
      (contDiff_infty_iff_deriv.mp (contDiff_circleEndpointAmplitude σ)).2
    have hampTime : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
        circleEndpointAmplitudeTimeDerivative σ t eta) xi := by
      unfold circleEndpointAmplitudeTimeDerivative
      exact hscale.mul (hderiv.contDiffAt.comp xi harg)
    have hamp : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖eta‖))) xi :=
      (contDiff_circleEndpointAmplitude σ).contDiffAt.comp xi harg
    have hhalf : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
        _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t eta) xi :=
      _root_.Auto.Spherical.MSS.halfWaveMultiplier_contDiffAt_of_ne_zero σ t hxi
    have hhalfTime : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
        _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t eta) xi := by
      unfold _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative
      have hcoef : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
          (((σ.toReal * (2 * Real.pi) * ‖eta‖ : Real) : Complex) * Complex.I)) xi := by
        have hcoefReal : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
            σ.toReal * (2 * Real.pi) * ‖eta‖) xi := by
          fun_prop
        exact (Complex.ofRealCLM.contDiff.contDiffAt.comp xi hcoefReal).mul contDiffAt_const
      exact hcoef.mul hhalf
    have hcut : ContDiffAt Real (⊤ : ℕ∞)
        (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j) xi :=
      ((_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j).smooth
        (⊤ : ℕ∞)).contDiffAt
    unfold circleEndpointBandpassMultiplierTimeDerivative
    exact (((contDiffAt_const.mul contDiffAt_const).mul
      (hampTime.mul hhalf |>.add (hamp.mul hhalfTime))).mul hcut)

private theorem hasCompactSupport_circleEndpointBandpassMultiplierTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    HasCompactSupport (circleEndpointBandpassMultiplierTimeDerivative C σ j t) := by
  apply HasCompactSupport.intro
    (isCompact_closedBall (0 : Euclidean 2) ((2 : Real) ^ (j + 2)))
  intro xi hxi
  have hnorm : (2 : Real) ^ (j + 2) ≤ ‖xi‖ := by
    rw [Metric.mem_closedBall, dist_zero_right] at hxi
    exact le_of_not_ge hxi
  have hband :
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0 :=
    _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_le_norm C hnorm
  simp [circleEndpointBandpassMultiplierTimeDerivative, hband]

private noncomputable def circleEndpointBandpassMultiplierTimeDerivativeSchwartzSymbol
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    SchwartzMap (Euclidean 2) Complex :=
  (hasCompactSupport_circleEndpointBandpassMultiplierTimeDerivative C σ j t).toSchwartzMap
    (contDiff_circleEndpointBandpassMultiplierTimeDerivative C σ j t)

private theorem circleEndpointBandpassMultiplierTimeDerivativeSchwartzSymbol_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (xi : Euclidean 2) :
    circleEndpointBandpassMultiplierTimeDerivativeSchwartzSymbol C σ j t xi =
      circleEndpointBandpassMultiplierTimeDerivative C σ j t xi := rfl

/-- The derivative endpoint contribution has fixed-time `L²` energy of
order `2^j`; this is the sharp scaling expected from differentiating the
half-wave phase once in time. -/
theorem exists_integral_norm_sq_circleEndpointWaveContributionTimeDerivative_le_dyadicSqrt
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
      (j : Nat) (t : Real), 1 ≤ t → t ≤ 2 →
      ∀ f : SchwartzMap (Euclidean 2) Complex,
        (∫ x : Euclidean 2,
          ‖circleEndpointWaveContributionTimeDerivative C σ j t f x‖ ^ 2) ≤
          (B * Real.sqrt (dyadicScale j)) ^ 2 *
            ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨B, hB, hpoint⟩ :=
    exists_norm_circleEndpointBandpassMultiplierTimeDerivative_le_dyadicSqrt C
  refine ⟨B, hB, ?_⟩
  intro σ j t ht htop f
  let m : SchwartzMap (Euclidean 2) Complex :=
    circleEndpointBandpassMultiplierTimeDerivativeSchwartzSymbol C σ j t
  have hm_bound (xi : Euclidean 2) : ‖m xi‖ ≤ B * Real.sqrt (dyadicScale j) := by
    rw [show m xi = circleEndpointBandpassMultiplierTimeDerivativeSchwartzSymbol C σ j t xi by rfl,
      circleEndpointBandpassMultiplierTimeDerivativeSchwartzSymbol_apply]
    exact hpoint σ j t xi ht htop
  have hmult := _root_.Auto.Spherical.Auxiliary.integral_norm_sq_fourierInv_schwartz_multiplier_le
    m (𝓕 f) (mul_nonneg hB.le (Real.sqrt_nonneg _)) hm_bound
  calc
    (∫ x : Euclidean 2,
        ‖circleEndpointWaveContributionTimeDerivative C σ j t f x‖ ^ 2) =
        ∫ x : Euclidean 2, ‖𝓕⁻ (fun xi : Euclidean 2 =>
          m xi * 𝓕 (f : Euclidean 2 → Complex) xi) x‖ ^ 2 := by
          rfl
    _ ≤ (B * Real.sqrt (dyadicScale j)) ^ 2 *
        ∫ xi : Euclidean 2, ‖𝓕 (f : Euclidean 2 → Complex) xi‖ ^ 2 := hmult
    _ = (B * Real.sqrt (dyadicScale j)) ^ 2 *
        ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
      rw [_root_.Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq]

/-- The time derivative of the normalized radial endpoint amplitude.  This
is the multiplier-side derivative after the half-wave has been factored into
the input, so it is the appropriate candidate for a uniform annular kernel
certificate. -/
private noncomputable def circleEndpointScaledRadialAmplitudeTimeDerivative
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    Real → Complex :=
  fun ρ => circleEndpointDyadicNormalization j *
    ((2 * Real.pi * (2 : Real) ^ j * ρ : Real) : Complex) *
      deriv (circleEndpointAmplitude σ)
        ((2 * Real.pi * t * (2 : Real) ^ j) * ρ)

/-- Euler's identity turns the parameter derivative into `ρ/t` times one
radial derivative.  It exposes a direct route from the existing uniform
radial symbol bounds to the derivative family. -/
private theorem circleEndpointScaledRadialAmplitudeTimeDerivative_eq_rho_div_t_mul_deriv
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) (ht : t ≠ 0) :
    circleEndpointScaledRadialAmplitudeTimeDerivative σ j t =
      fun ρ => ((ρ / t : Real) : Complex) *
        deriv (circleEndpointScaledRadialAmplitude σ j t) ρ := by
  funext ρ
  rw [show deriv (circleEndpointScaledRadialAmplitude σ j t) ρ =
      iteratedDeriv 1 (circleEndpointScaledRadialAmplitude σ j t) ρ by
        rw [iteratedDeriv_one]]
  rw [iteratedDeriv_circleEndpointScaledRadialAmplitude σ j 1 t]
  simp only [pow_one, Complex.real_smul]
  rw [iteratedDeriv_one]
  unfold circleEndpointScaledRadialAmplitudeTimeDerivative
  have hscalar : 2 * Real.pi * (2 : Real) ^ j * ρ =
      (ρ / t) * (2 * Real.pi * t * (2 : Real) ^ j) := by
    field_simp [ht]
  have hcast : ((2 * Real.pi * (2 : Real) ^ j * ρ : Real) : Complex) =
      ((ρ / t : Real) : Complex) *
        ((2 * Real.pi * t * (2 : Real) ^ j : Real) : Complex) := by
    exact_mod_cast hscalar
  rw [hcast]
  ring

private theorem iteratedDeriv_complex_ofReal_id
    (k : Nat) (ρ : Real) :
    iteratedDeriv k (fun r : Real => (r : Complex)) ρ =
      if k = 0 then (ρ : Complex) else if k = 1 then 1 else 0 := by
  cases k with
  | zero => simp
  | succ k =>
      rw [iteratedDeriv_succ']
      have hderiv : deriv (fun r : Real => (r : Complex)) = fun _ => (1 : Complex) := by
        funext r
        exact (hasDerivAt_id r).ofReal_comp.deriv
      rw [hderiv, iteratedDeriv_const]
      cases k <;> simp

private theorem norm_iteratedDeriv_timeEulerFactor_le
    (k : Nat) (t ρ : Real) (ht : 1 ≤ t) (hρ : 0 ≤ ρ) (hρtop : ρ ≤ 16) :
    ‖iteratedDeriv k (fun r : Real => ((t⁻¹ : Real) : Complex) * (r : Complex)) ρ‖ ≤ 16 := by
  rw [iteratedDeriv_const_mul_field]
  rw [iteratedDeriv_complex_ofReal_id]
  have htpos : 0 < t := lt_of_lt_of_le zero_lt_one ht
  have hinvnonneg : 0 ≤ t⁻¹ := inv_nonneg.mpr htpos.le
  have hinvle : t⁻¹ ≤ 1 := (inv_le_one₀ htpos).mpr ht
  by_cases hk0 : k = 0
  · subst k
    simp only [ite_true, norm_mul, Complex.norm_real]
    rw [Real.norm_of_nonneg hinvnonneg, Real.norm_of_nonneg hρ]
    calc
      t⁻¹ * ρ ≤ 1 * 16 := mul_le_mul hinvle hρtop hρ (by norm_num)
      _ = 16 := by norm_num
  · have hkpos : 0 < k := Nat.pos_of_ne_zero hk0
    simp only [if_neg hk0]
    by_cases hk1 : k = 1
    · subst k
      simp only [ite_true, norm_mul, Complex.norm_real,
        Real.norm_of_nonneg hinvnonneg, norm_one]
      simp only [mul_one]
      calc
        t⁻¹ ≤ 1 := hinvle
        _ ≤ 16 := by norm_num
    · simp [hk1]

private theorem norm_iteratedDeriv_mul_le
    {n : Nat} {f g : Real → Complex} {x : Real} {A B : Real}
    (hf : ContDiff Real (⊤ : ℕ∞) f)
    (hg : ContDiff Real (⊤ : ℕ∞) g)
    (hA : 0 ≤ A) (_hB : 0 ≤ B)
    (hfa : ∀ k : Nat, k ≤ n → ‖iteratedDeriv k f x‖ ≤ A)
    (hgb : ∀ k : Nat, k ≤ n → ‖iteratedDeriv k g x‖ ≤ B) :
    ‖iteratedDeriv n (fun u : Real => f u * g u) x‖ ≤
      ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) * A * B := by
  change ‖iteratedDeriv n (f * g) x‖ ≤ _
  rw [iteratedDeriv_mul
    ((hf.of_le (show (n : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) by
      exact WithTop.coe_le_coe.mpr le_top)).contDiffAt)
    ((hg.of_le (show (n : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) by
      exact WithTop.coe_le_coe.mpr le_top)).contDiffAt)]
  calc
    ‖∑ i ∈ Finset.range (n + 1), n.choose i * iteratedDeriv i f x *
        iteratedDeriv (n - i) g x‖ ≤
      ∑ i ∈ Finset.range (n + 1),
        ‖n.choose i * iteratedDeriv i f x * iteratedDeriv (n - i) g x‖ :=
      norm_sum_le _ _
    _ ≤ ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) * A * B := by
      apply Finset.sum_le_sum
      intro i hi
      have hi' : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      have hleft := hfa i hi'
      have hright := hgb (n - i) (Nat.sub_le _ _)
      rw [norm_mul, norm_mul, norm_natCast]
      calc
        (n.choose i : Real) * ‖iteratedDeriv i f x‖ *
            ‖iteratedDeriv (n - i) g x‖ =
            (n.choose i : Real) *
              (‖iteratedDeriv i f x‖ * ‖iteratedDeriv (n - i) g x‖) := by ring
        _ ≤ (n.choose i : Real) * (A * B) :=
          mul_le_mul_of_nonneg_left
            (mul_le_mul hleft hright (norm_nonneg _) hA)
            (Nat.cast_nonneg (n.choose i))
        _ = (n.choose i : Real) * A * B := by ring

private theorem contDiff_circleEndpointScaledRadialAmplitude
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    ContDiff Real (⊤ : ℕ∞) (circleEndpointScaledRadialAmplitude σ j t) := by
  unfold circleEndpointScaledRadialAmplitude
  apply ContDiff.mul
  · fun_prop
  · apply (contDiff_circleEndpointAmplitude σ).comp
    fun_prop

/-- Every fixed radial derivative of the multiplier-side time derivative is
uniform on the fixed positive annulus.  The proof is deliberately routed
through the existing all-order radial endpoint bounds via Euler's identity. -/
private theorem exists_uniform_norm_iteratedDeriv_circleEndpointScRadialAmplitudeTimeDeriv_le
    (n : Nat) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
      (j : Nat) (t ρ : Real), 1 ≤ t → (1 / 4 : Real) ≤ ρ → ρ ≤ 16 →
      ‖iteratedDeriv n
        (circleEndpointScaledRadialAmplitudeTimeDerivative σ j t) ρ‖ ≤ B := by
  choose H hHpos hH using fun k : Nat =>
    exists_uniform_norm_iteratedDeriv_circleEndpointScaledRadialAmplitude_le (k + 1)
  let A : Real := ∑ k ∈ Finset.range (n + 1), H k
  have hApos : 0 < A := by
    have hmem : 0 ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hle : H 0 ≤ A := by
      dsimp [A]
      exact Finset.single_le_sum (fun k hk => (hHpos k).le) hmem
    exact lt_of_lt_of_le (hHpos 0) hle
  let B : Real := ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) * 16 * A
  have hBpos : 0 < B := by
    have hmem : 0 ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hterm : 0 < (n.choose 0 : Real) * 16 * A := by
      simp only [Nat.choose_zero_right, Nat.cast_one, one_mul, Nat.ofNat_pos,
          mul_pos_iff_of_pos_left]
      positivity
    have hle : (n.choose 0 : Real) * 16 * A ≤ B := by
      dsimp [B]
      exact Finset.single_le_sum
        (s := Finset.range (n + 1))
        (f := fun i : Nat => (n.choose i : Real) * 16 * A)
        (fun i hi => by positivity) hmem
    exact lt_of_lt_of_le hterm hle
  refine ⟨B, hBpos, ?_⟩
  intro σ j t ρ ht hρ hρtop
  let F : Real → Complex := circleEndpointScaledRadialAmplitude σ j t
  let U : Real → Complex := fun r => ((t⁻¹ : Real) : Complex) * (r : Complex)
  have htne : t ≠ 0 := ne_of_gt (lt_of_lt_of_le zero_lt_one ht)
  have hformula : circleEndpointScaledRadialAmplitudeTimeDerivative σ j t =
      fun r => U r * deriv F r := by
    rw [circleEndpointScaledRadialAmplitudeTimeDerivative_eq_rho_div_t_mul_deriv
      σ j t htne]
    funext r
    dsimp [U]
    push_cast
    ring
  have hU : ContDiff Real (⊤ : ℕ∞) U := by
    dsimp [U]
    exact contDiff_const.mul Complex.ofRealCLM.contDiff
  have hF : ContDiff Real (⊤ : ℕ∞) F := by
    dsimp [F]
    exact contDiff_circleEndpointScaledRadialAmplitude σ j t
  have hF' : ContDiff Real (⊤ : ℕ∞) (deriv F) :=
    (contDiff_infty_iff_deriv.mp hF).2
  have hUbound (k : Nat) (hk : k ≤ n) : ‖iteratedDeriv k U ρ‖ ≤ 16 := by
    dsimp [U]
    exact norm_iteratedDeriv_timeEulerFactor_le k t ρ ht
      (by linarith) hρtop
  have hF'bound (k : Nat) (hk : k ≤ n) : ‖iteratedDeriv k (deriv F) ρ‖ ≤ A := by
    rw [← iteratedDeriv_succ']
    have hmain := hH k σ j t ρ ht hρ hρtop
    have hmem : k ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hle : H k ≤ A := by
      dsimp [A]
      exact Finset.single_le_sum (fun l hl => (hHpos l).le) hmem
    exact hmain.trans hle
  rw [hformula]
  have hprod := norm_iteratedDeriv_mul_le (n := n) hU hF'
    (by norm_num) hApos.le hUbound hF'bound
  exact hprod

private theorem contDiff_circleEndpointScaledRadialAmplitudeTimeDerivative
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    ContDiff Real (⊤ : ℕ∞)
      (circleEndpointScaledRadialAmplitudeTimeDerivative σ j t) := by
  unfold circleEndpointScaledRadialAmplitudeTimeDerivative
  apply ContDiff.mul
  · apply ContDiff.mul
    · fun_prop
    · exact Complex.ofRealCLM.contDiff.comp (contDiff_const.mul contDiff_id)
  · apply ((contDiff_infty_iff_deriv.mp
      (contDiff_circleEndpointAmplitude σ)).2).comp
    fun_prop

/-- The radial time-derivative family has uniformly bounded multivariable
derivatives on the fixed positive annulus. -/
private theorem exists_unif_norm_iteratedFDeriv_circleEndptScRadialAmplitudeTimeDerivComp_le
    (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
      (j : Nat) (t : Real) (η : Euclidean 2),
      1 ≤ t → (1 / 4 : Real) ≤ ‖η‖ → ‖η‖ ≤ 16 →
      ‖iteratedFDeriv Real n
        (fun y : Euclidean 2 =>
          circleEndpointScaledRadialAmplitudeTimeDerivative σ j t ‖y‖) η‖ ≤ C := by
  choose A hApos hAbound using fun i : Nat =>
    exists_uniform_norm_iteratedDeriv_circleEndpointScRadialAmplitudeTimeDeriv_le i
  choose D hDpos hDbound using fun i : Nat =>
    _root_.Auto.MikhlinHormander.exists_norm_iteratedFDeriv_norm_bound_on_annulus
      (d := 2) (r := 1 / 4) (R := 16) i (by norm_num : (0 : Real) < 1 / 4)
  let CA : Real := ∑ i ∈ Finset.range (n + 1), A i
  let CD : Real := (∑ i ∈ Finset.range (n + 1), D i) + 1
  have hCApos : 0 < CA := by
    have hmem : 0 ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hle : A 0 ≤ CA := by
      dsimp [CA]
      exact Finset.single_le_sum (fun i hi => (hApos i).le) hmem
    exact lt_of_lt_of_le (hApos 0) hle
  have hCDone : 1 ≤ CD := by
    dsimp [CD]
    have hsum : 0 ≤ ∑ i ∈ Finset.range (n + 1), D i :=
      Finset.sum_nonneg fun i hi => (hDpos i).le
    linarith
  refine ⟨((Nat.factorial n : Nat) : Real) * CA * CD ^ n, by positivity, ?_⟩
  intro σ j t η ht hηinner hηouter
  let s : Set (Euclidean 2) := ({0}ᶜ : Set (Euclidean 2))
  have hsopen : IsOpen s := by
    simpa only [s] using (isOpen_compl_singleton : IsOpen ({0}ᶜ : Set (Euclidean 2)))
  have hsunique : UniqueDiffOn Real s := hsopen.uniqueDiffOn
  have hηne : η ≠ 0 := by
    intro hzero
    subst η
    norm_num at hηinner
  have hηs : η ∈ s := by simpa [s] using hηne
  let g : Real → Complex :=
    circleEndpointScaledRadialAmplitudeTimeDerivative σ j t
  let f : Euclidean 2 → Real := fun y => ‖y‖
  have hg : ContDiff Real n g := by
    dsimp [g]
    exact (contDiff_circleEndpointScaledRadialAmplitudeTimeDerivative σ j t).of_le
      (show (n : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) by
        exact WithTop.coe_le_coe.mpr le_top)
  have hf : ContDiffOn Real n f s := by
    intro x hx
    exact (contDiffAt_norm Real (by simpa [s] using hx)).contDiffWithinAt
  have hgfAt : ContDiffAt Real n (g ∘ f) η :=
    hg.contDiffAt.comp η (contDiffAt_norm Real hηne)
  have hC : ∀ i, i ≤ n → ‖iteratedFDerivWithin Real i g Set.univ (f η)‖ ≤ CA := by
    intro i hi
    rw [iteratedFDerivWithin_univ]
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv]
    have hbase := hAbound i σ j t (f η) ht (by simpa [f] using hηinner)
      (by simpa [f] using hηouter)
    have hmem : i ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hle : A i ≤ CA := by
      dsimp [CA]
      exact Finset.single_le_sum (fun l hl => (hApos l).le) hmem
    exact hbase.trans hle
  have hD : ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDerivWithin Real i f s η‖ ≤ CD ^ i := by
    intro i hi1 hi
    have hfeq : iteratedFDerivWithin Real i f s η = iteratedFDeriv Real i f η :=
      iteratedFDerivWithin_eq_iteratedFDeriv hsunique
        ((contDiffAt_norm Real hηne).of_le
          (show (i : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) by
            exact WithTop.coe_le_coe.mpr le_top)) hηs
    rw [hfeq]
    have hbase := hDbound i η hηinner hηouter
    have hmem : i ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hle : D i ≤ CD := by
      dsimp [CD]
      calc
        D i ≤ ∑ l ∈ Finset.range (n + 1), D l :=
          Finset.single_le_sum (fun l hl => (hDpos l).le) hmem
        _ ≤ (∑ l ∈ Finset.range (n + 1), D l) + 1 := by linarith
    have hpow : CD ≤ CD ^ i := by
      obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hi1)
      rw [pow_succ]
      calc
        CD = 1 * CD := (one_mul _).symm
        _ ≤ CD ^ m * CD :=
          mul_le_mul_of_nonneg_right (one_le_pow₀ hCDone) (le_trans (by norm_num) hCDone)
    exact hbase.trans (hle.trans hpow)
  have hcomp := norm_iteratedFDerivWithin_comp_le
    (g := g) (f := f) (s := s) (t := Set.univ)
    hg.contDiffOn hf (show (n : WithTop ENat) ≤ (n : WithTop ENat) by rfl)
    uniqueDiffOn_univ hsunique (by simp) hηs hC hD
  have hEq : iteratedFDerivWithin Real n (g ∘ f) s η =
      iteratedFDeriv Real n (g ∘ f) η :=
    iteratedFDerivWithin_eq_iteratedFDeriv hsunique hgfAt hηs
  change ‖iteratedFDeriv Real n (g ∘ f) η‖ ≤ _
  rw [← hEq]
  exact hcomp

/-- The time derivative of the compact annular endpoint factor, with the
oscillatory half-wave deliberately left outside this multiplier. -/
noncomputable def circleAnnularEndpointMultiplierTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    Euclidean 2 → Complex :=
  fun ξ => circleEndpointDyadicNormalization j *
    ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      circleEndpointAmplitudeTimeDerivative σ t ξ *
      _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j ξ

/-- Exact Fourier-side factorization of the first product-rule term. -/
theorem circleAnnularEndpointMultiplierTimeDerivative_factorization
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (ξ : Euclidean 2) :
    (circleEndpointDyadicNormalization j)⁻¹ *
        circleAnnularEndpointMultiplierTimeDerivative C σ j t ξ *
        _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ j t ξ =
      ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
        circleEndpointAmplitudeTimeDerivative σ t ξ *
        _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t ξ *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ := by
  have hnormal : circleEndpointDyadicNormalization j ≠ 0 :=
    circleEndpointDyadicNormalization_ne_zero j
  calc
    (circleEndpointDyadicNormalization j)⁻¹ *
          circleAnnularEndpointMultiplierTimeDerivative C σ j t ξ *
          _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ j t ξ =
        ((circleEndpointDyadicNormalization j)⁻¹ * circleEndpointDyadicNormalization j) *
          (((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
            circleEndpointAmplitudeTimeDerivative σ t ξ *
            _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t ξ) *
          (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ *
            _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j ξ) := by
      unfold circleAnnularEndpointMultiplierTimeDerivative
        _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol
      ring
    _ = ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitudeTimeDerivative σ t ξ *
          _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t ξ *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ := by
      rw [inv_mul_cancel₀ hnormal,
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier_mul_fatDyadicBandpassMultiplier]
      ring

/-- Unit-frequency form of the annular endpoint-factor derivative. -/
private noncomputable def circleAnnularEndpointTimeDerivativeScaledSymbol
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    Euclidean 2 → Complex :=
  fun η => circleAnnularEndpointMultiplierTimeDerivative C σ j t
    ((2 : Real) ^ j • η)

/-- After dyadic rescaling, the derivative annular factor is a fixed compact
cutoff times the uniformly controlled Euler radial symbol. -/
private theorem circleAnnularEndpointTimeDerivativeScaledSymbol_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (η : Euclidean 2) :
    circleAnnularEndpointTimeDerivativeScaledSymbol C σ j t η =
      ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
        circleEndpointScaledRadialAmplitudeTimeDerivative σ j t ‖η‖ *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff η := by
  unfold circleAnnularEndpointTimeDerivativeScaledSymbol
    circleAnnularEndpointMultiplierTimeDerivative
    circleEndpointScaledRadialAmplitudeTimeDerivative
    circleEndpointAmplitudeTimeDerivative
  rw [_root_.Auto.MikhlinHormander.fatDyadicBandpassMultiplier_eq_prototype_scale]
  have hpow : 0 ≤ (2 : Real) ^ j := by positivity
  have hpow_ne : (2 : Real) ^ j ≠ 0 := ne_of_gt (by positivity)
  rw [smul_smul, inv_mul_cancel₀ hpow_ne, one_smul]
  rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hpow]
  have harg : 2 * Real.pi * (t * ((2 : Real) ^ j * ‖η‖)) =
      (2 * Real.pi * t * (2 : Real) ^ j) * ‖η‖ := by ring
  rw [harg]
  ring

private theorem circleAnnularEndpointMultiplierTimeDerivative_eventuallyEq_zero_at_zero
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    Filter.EventuallyEq (nhds (0 : Euclidean 2))
      (circleAnnularEndpointMultiplierTimeDerivative C σ j t) (fun _ => 0) := by
  let rhigh : Real := (2 : Real) ^ ((j : Int) + 3)
  let rlow : Real := (2 : Real) ^ ((j : Int) - 2)
  have hhigh : 0 < rhigh := by
    dsimp [rhigh]
    positivity
  have hlow : 0 < rlow := by
    dsimp [rlow]
    positivity
  filter_upwards [Metric.ball_mem_nhds (0 : Euclidean 2) (lt_min hhigh hlow)] with ξ hξ
  have hξnorm : ‖ξ‖ < min rhigh rlow := by
    simpa only [Metric.mem_ball, dist_zero_right] using hξ
  have hright : ‖rhigh⁻¹ • ξ‖ ≤ 1 := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hhigh)]
    rw [show rhigh⁻¹ * ‖ξ‖ = ‖ξ‖ / rhigh by ring]
    exact (div_le_one₀ hhigh).mpr (hξnorm.le.trans (min_le_left _ _))
  have hleft : ‖rlow⁻¹ • ξ‖ ≤ 1 := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hlow)]
    rw [show rlow⁻¹ * ‖ξ‖ = ‖ξ‖ / rlow by ring]
    exact (div_le_one₀ hlow).mpr (hξnorm.le.trans (min_le_right _ _))
  have hfat :
      _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j ξ = 0 := by
    rw [_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier_eq_shiftedFatMultiplier,
      _root_.Auto.LittlewoodPaley.shiftedFatMultiplier_apply]
    simp only [sub_zero]
    change C.cutoff (rhigh⁻¹ • ξ) - C.cutoff (rlow⁻¹ • ξ) = 0
    rw [C.cutoff_one _ hright, C.cutoff_one _ hleft]
    ring
  simp [circleAnnularEndpointMultiplierTimeDerivative, hfat]

theorem hasCompactSupport_circleAnnularEndpointMultiplierTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    HasCompactSupport (circleAnnularEndpointMultiplierTimeDerivative C σ j t) := by
  let rhigh : Real := (2 : Real) ^ ((j : Int) + 3)
  let rlow : Real := (2 : Real) ^ ((j : Int) - 2)
  have hhigh : 0 < rhigh := by
    dsimp [rhigh]
    positivity
  have hlow : 0 < rlow := by
    dsimp [rlow]
    positivity
  apply HasCompactSupport.intro
    (isCompact_closedBall (0 : Euclidean 2) (2 * max rhigh rlow))
  intro ξ hξ
  have hξnorm : 2 * max rhigh rlow ≤ ‖ξ‖ := by
    rw [Metric.mem_closedBall, dist_zero_right] at hξ
    exact le_of_not_ge hξ
  have hright : 2 ≤ ‖rhigh⁻¹ • ξ‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hhigh)]
    rw [show rhigh⁻¹ * ‖ξ‖ = ‖ξ‖ / rhigh by ring]
    apply (le_div_iff₀ hhigh).mpr
    calc
      2 * rhigh ≤ 2 * max rhigh rlow :=
        mul_le_mul_of_nonneg_left (le_max_left _ _) (by norm_num)
      _ ≤ ‖ξ‖ := hξnorm
  have hleft : 2 ≤ ‖rlow⁻¹ • ξ‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hlow)]
    rw [show rlow⁻¹ * ‖ξ‖ = ‖ξ‖ / rlow by ring]
    apply (le_div_iff₀ hlow).mpr
    calc
      2 * rlow ≤ 2 * max rhigh rlow :=
        mul_le_mul_of_nonneg_left (le_max_right _ _) (by norm_num)
      _ ≤ ‖ξ‖ := hξnorm
  have hfat :
      _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j ξ = 0 := by
    rw [_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier_eq_shiftedFatMultiplier,
      _root_.Auto.LittlewoodPaley.shiftedFatMultiplier_apply]
    simp only [sub_zero]
    change C.cutoff (rhigh⁻¹ • ξ) - C.cutoff (rlow⁻¹ • ξ) = 0
    rw [C.cutoff_zero _ hright, C.cutoff_zero _ hleft]
    ring
  simp [circleAnnularEndpointMultiplierTimeDerivative, hfat]

private theorem contDiffAt_circleEndpointAmplitudeTimeDerivative_of_ne_zero
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (t : Real)
    {ξ : Euclidean 2} (hξ : ξ ≠ 0) :
    ContDiffAt Real (⊤ : ℕ∞)
      (fun η : Euclidean 2 => circleEndpointAmplitudeTimeDerivative σ t η) ξ := by
  have hnorm : ContDiffAt Real (⊤ : ℕ∞) (fun η : Euclidean 2 => ‖η‖) ξ :=
    contDiffAt_norm Real hξ
  have hcoefReal : ContDiffAt Real (⊤ : ℕ∞)
      (fun η : Euclidean 2 => 2 * Real.pi * ‖η‖) ξ :=
    contDiffAt_const.mul hnorm
  have hcoef : ContDiffAt Real (⊤ : ℕ∞)
      (fun η : Euclidean 2 => ((2 * Real.pi * ‖η‖ : Real) : Complex)) ξ :=
    Complex.ofRealCLM.contDiff.contDiffAt.comp ξ hcoefReal
  have harg : ContDiffAt Real (⊤ : ℕ∞)
      (fun η : Euclidean 2 => 2 * Real.pi * (t * ‖η‖)) ξ := by
    fun_prop
  have hderiv : ContDiffAt Real (⊤ : ℕ∞)
      (fun η : Euclidean 2 => deriv (circleEndpointAmplitude σ)
        (2 * Real.pi * (t * ‖η‖))) ξ :=
    ((contDiff_infty_iff_deriv.mp (contDiff_circleEndpointAmplitude σ)).2).contDiffAt.comp ξ harg
  change ContDiffAt Real (⊤ : ℕ∞)
    (fun η : Euclidean 2 => ((2 * Real.pi * ‖η‖ : Real) : Complex) *
      deriv (circleEndpointAmplitude σ) (2 * Real.pi * (t * ‖η‖))) ξ
  exact hcoef.mul hderiv

theorem contDiff_circleAnnularEndpointMultiplierTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    ContDiff Real (⊤ : ℕ∞)
      (circleAnnularEndpointMultiplierTimeDerivative C σ j t) := by
  rw [contDiff_iff_contDiffAt]
  intro ξ
  by_cases hξ : ξ = 0
  · subst ξ
    exact (contDiffAt_const (c := (0 : Complex))).congr_of_eventuallyEq
      (circleAnnularEndpointMultiplierTimeDerivative_eventuallyEq_zero_at_zero C σ j t)
  · have hamp := contDiffAt_circleEndpointAmplitudeTimeDerivative_of_ne_zero σ t hξ
    have hcut : ContDiffAt Real (⊤ : ℕ∞)
        (_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j) ξ :=
      ((_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j).smooth
        (⊤ : ℕ∞)).contDiffAt
    unfold circleAnnularEndpointMultiplierTimeDerivative
    exact (((contDiffAt_const.mul contDiffAt_const).mul contDiffAt_const).mul hamp).mul hcut

noncomputable def circleAnnularEndpointTimeDerivativeSchwartzSymbol
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    SchwartzMap (Euclidean 2) Complex :=
  (hasCompactSupport_circleAnnularEndpointMultiplierTimeDerivative C σ j t).toSchwartzMap
    (contDiff_circleAnnularEndpointMultiplierTimeDerivative C σ j t)

private theorem circleAnnularEndpointTimeDerivativeSchwartzSymbol_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (ξ : Euclidean 2) :
    circleAnnularEndpointTimeDerivativeSchwartzSymbol C σ j t ξ =
