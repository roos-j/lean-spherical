    (vartheta : SchwartzMap Real Complex)
    (scale : Real) (a chi : Euclidean 2 → Complex) (radialCutoff : Real → Complex)
    (n : Int)
    (hR : ∀ xi : Euclidean 2,
      R xi = radialCutoff ((Real.sqrt scale)⁻¹ * ‖xi‖ - n))
    (hB : ∀ xi : Euclidean 2, B xi =
      chi xi * a (scale⁻¹ • xi) *
        (R xi * FourierTransform.fourier (f : Euclidean 2 → Complex) xi)) :
    (fun z : WaveSpaceTime =>
      vartheta z.2 * FourierTransform.fourierInv
        (fun xi : Euclidean 2 =>
          B xi * halfWaveMultiplier WaveSign.plus z.2 xi) z.1) =
      angularPiece scale a chi (vartheta : Real → Complex)
        (radialPiece radialCutoff scale n (f : Euclidean 2 → Complex)) := by
  funext z
  unfold angularPiece
  apply congrArg (fun q : Euclidean 2 → Complex =>
    vartheta z.2 * FourierTransform.fourierInv q z.1)
  funext xi
  rw [fourier_radialPiece_eq_schwartzProfile_mul_fourier
    radialCutoff scale n R f hR xi]
  rw [hB xi]
  ring

/-- With norm agreement on the supplied amplitude support, the same regular
angular/radial model has the literal normal-projection-plus-tail
decomposition. -/
theorem angularPiece_eq_projection_add_normalTail_of_schwartzRadialProfile
    (B R f u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (scale : Real) (a chi : Euclidean 2 → Complex) (radialCutoff : Real → Complex)
    (n : Int)
    (hR : ∀ xi : Euclidean 2,
      R xi = radialCutoff ((Real.sqrt scale)⁻¹ * ‖xi‖ - n))
    (hB : ∀ xi : Euclidean 2, B xi =
      chi xi * a (scale⁻¹ • xi) *
        (R xi * FourierTransform.fourier (f : Euclidean 2 → Complex) xi))
    (hrho : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), rho xi = ‖xi‖) :
    angularPiece scale a chi (vartheta : Real → Complex)
        (radialPiece radialCutoff scale n (f : Euclidean 2 → Complex)) =
      temporalSchwartzAnnularNormalProjection B u vartheta beta rho +
        temporalSchwartzAnnularNormalTail B u vartheta beta rho := by
  rw [← temporalSchwartzHalfWave_eq_angularPiece_of_schwartzRadialProfile
    B R f vartheta scale a chi radialCutoff n hR hB]
  exact temporalSchwartzHalfWave_eq_projection_add_normalTail
    B u vartheta beta rho hrho

/-- Exact Fourier formula for the normal tail.  The leading factor records
precisely the part discarded by the supplied spatial/normal Schwartz cutoff. -/
theorem spaceTimeFourier_temporalSchwartzAnnularNormalTail
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (zeta : WaveSpaceTime) :
    spaceTimeFourier
        (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta =
      (1 - u zeta.1 * beta (zeta.2 - rho zeta.1)) *
        (B zeta.1 * FourierTransform.fourier
          (vartheta : Real → Complex) (zeta.2 - rho zeta.1)) := by
  unfold temporalSchwartzAnnularNormalTail
  rw [spaceTimeFourier_jointSchwartzRaw]
  change FourierTransform.fourier
      (FourierTransform.fourierInv
        (jointSchwartzModulatedAnnularProfile B vartheta rho -
          jointSchwartzSpectralCutoffProduct
            (jointSchwartzSpatialNormalCutoff u beta rho)
            (FourierTransform.fourierInv
              (jointSchwartzModulatedAnnularProfile B vartheta rho))) :
          JointWaveSpaceTime → Complex)
      (WithLp.toLp 2 zeta) = _
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  rw [sub_apply]
  rw [jointSchwartzSpectralCutoffProduct,
    SchwartzMap.smulLeftCLM_apply_apply
      (jointSchwartzSpatialNormalCutoff u beta rho).hasTemperateGrowth]
  rw [FourierTransform.fourier_fourierInv_eq,
    jointSchwartzSpatialNormalCutoff_apply,
    jointSchwartzModulatedAnnularProfile_apply]
  ring

private theorem aux_spaceTimeFourier_temporalSchwartzAnnularNormalTail_eq_zero
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hu : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), u xi = 1)
    (zeta : WaveSpaceTime)
    (hbeta : beta (zeta.2 - rho zeta.1) = 1) :
    spaceTimeFourier
        (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta = 0 := by
  rw [spaceTimeFourier_temporalSchwartzAnnularNormalTail]
  by_cases hB : B zeta.1 = 0
  · simp [hB]
  · rw [hu zeta.1 hB, hbeta]
    ring

/-- The tail spectrum can occur only on the supplied annular profile support
and where the supplied normal cutoff is not one.  This is not a plate-support
claim for the unprojected temporal-Schwartz half-wave. -/
theorem support_spaceTimeFourier_temporalSchwartzAnnularNormalTail
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hu : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), u xi = 1) :
    Function.support
        (spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) ⊆
      {zeta | zeta.1 ∈ Function.support (B : Euclidean 2 → Complex) ∧
        beta (zeta.2 - rho zeta.1) ≠ 1} := by
  intro zeta hzeta
  change spaceTimeFourier
      (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta ≠ 0 at hzeta
  constructor
  · intro hB
    apply hzeta
    rw [spaceTimeFourier_temporalSchwartzAnnularNormalTail]
    simp [hB]
  · intro hbeta
    exact hzeta
      (aux_spaceTimeFourier_temporalSchwartzAnnularNormalTail_eq_zero
        B u vartheta beta rho hu zeta hbeta)

private theorem aux_exists_fourier_vartheta_rapid
    (vartheta : SchwartzMap Real Complex) (N : Nat) :
    ∃ D : Real, 0 ≤ D ∧ ∀ s : Real,
      (1 + |s|) ^ N * ‖FourierTransform.fourier (vartheta : Real → Complex) s‖ ≤ D := by
  let h : SchwartzMap Real Complex := 𝓕 vartheta
  let A : Real := 2 ^ N * ((Finset.Iic (N, 0)).sup fun q =>
    SchwartzMap.seminorm Complex q.1 q.2) h
  let D : Real := |A|
  refine ⟨D, ?_, ?_⟩
  · exact abs_nonneg _
  · intro s
    have hs := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := Complex)
      (m := (N, 0)) (k := N) (n := 0) (le_refl N) (le_refl 0) h s
    change (1 + |s|) ^ N * ‖FourierTransform.fourier (vartheta : Real → Complex) s‖ ≤ D
    simpa only [D, A, h, Real.norm_eq_abs, norm_iteratedFDeriv_zero,
      SchwartzMap.fourier_coe] using hs.trans (le_abs_self _)

/-- The literal temporal-Schwartz normal tail has arbitrary pointwise rapid
Fourier decay in its normal coordinate whenever the spatial cutoff is one on
the supplied amplitude support.  This is a Fourier-side estimate only. -/
theorem exists_nonneg_one_add_normal_pow_mul_norm_spaceTimeFourier_temporalSchwartzAnnularNormalTail_le_of_eq_one_on_support
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hu : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), u xi = 1)
    (N : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ zeta : WaveSpaceTime,
      (1 + |zeta.2 - rho zeta.1|) ^ N *
        ‖spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta‖ ≤ C := by
  obtain ⟨D, hDnonneg, hD⟩ := aux_exists_fourier_vartheta_rapid vartheta N
  let B0 : Real := SchwartzMap.seminorm Complex 0 0 B
  let beta0 : Real := SchwartzMap.seminorm Complex 0 0 beta
  have hB0nonneg : 0 ≤ B0 := by
    exact (norm_nonneg (B 0)).trans
      (SchwartzMap.norm_le_seminorm Complex B 0)
  have hbeta0nonneg : 0 ≤ beta0 := by
    exact (norm_nonneg (beta 0)).trans
      (SchwartzMap.norm_le_seminorm Complex beta 0)
  refine ⟨B0 * (1 + beta0) * D, ?_, ?_⟩
  · exact mul_nonneg (mul_nonneg hB0nonneg (add_nonneg zero_le_one hbeta0nonneg)) hDnonneg
  · intro zeta
    let s : Real := zeta.2 - rho zeta.1
    have hB : ‖B zeta.1‖ ≤ B0 := by
      exact SchwartzMap.norm_le_seminorm Complex B zeta.1
    have hbeta : ‖beta s‖ ≤ beta0 := by
      exact SchwartzMap.norm_le_seminorm Complex beta s
    have hcut : ‖(1 : Complex) - beta s‖ ≤ 1 + beta0 := by
      calc
        ‖(1 : Complex) - beta s‖ ≤ ‖(1 : Complex)‖ + ‖beta s‖ := norm_sub_le _ _
        _ = 1 + ‖beta s‖ := by rw [norm_one]
        _ ≤ 1 + beta0 := by gcongr
    have hnormal : (1 + |s|) ^ N *
        ‖FourierTransform.fourier (vartheta : Real → Complex) s‖ ≤ D := hD s
    rw [spaceTimeFourier_temporalSchwartzAnnularNormalTail]
    by_cases hBzero : B zeta.1 = 0
    · simpa [hBzero] using
        (mul_nonneg (mul_nonneg hB0nonneg (add_nonneg zero_le_one hbeta0nonneg)) hDnonneg)
    · rw [hu zeta.1 hBzero]
      have hmain : (1 + |s|) ^ N *
          ‖((1 : Complex) - beta s) *
            (B zeta.1 * FourierTransform.fourier (vartheta : Real → Complex) s)‖ ≤
          B0 * (1 + beta0) * D := by
        calc
        (1 + |s|) ^ N * ‖((1 : Complex) - beta s) *
            (B zeta.1 * FourierTransform.fourier (vartheta : Real → Complex) s)‖ =
            ‖B zeta.1‖ * ‖(1 : Complex) - beta s‖ *
              ((1 + |s|) ^ N *
                ‖FourierTransform.fourier (vartheta : Real → Complex) s‖) := by
              rw [norm_mul, norm_mul]
              ring
        _ ≤ B0 * (1 + beta0) * D := by
          gcongr
      simpa only [s, one_mul] using hmain

/-- If the supplied normal cutoff is one on the normal ball of radius `R`,
the same literal tail has arbitrary pointwise Fourier decay in `R`.  This is
still only a pointwise spectral statement. -/
theorem exists_nonneg_one_add_normal_pow_mul_norm_spaceTimeFourier_temporalSchwartzAnnularNormalTail_le_of_eq_one_on_support_of_eq_one_on_normal_ball
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hu : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), u xi = 1)
    {R : Real} (hR : 0 ≤ R)
    (hbeta : ∀ s : Real, |s| ≤ R → beta s = 1)
    (N : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ zeta : WaveSpaceTime,
      (1 + R) ^ N *
        ‖spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta‖ ≤ C := by
  obtain ⟨C, hCnonneg, hC⟩ :=
    exists_nonneg_one_add_normal_pow_mul_norm_spaceTimeFourier_temporalSchwartzAnnularNormalTail_le_of_eq_one_on_support
      B u vartheta beta rho hu N
  refine ⟨C, hCnonneg, ?_⟩
  intro zeta
  by_cases hs : |zeta.2 - rho zeta.1| ≤ R
  · have htailzero :
        spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta = 0 := by
      rw [spaceTimeFourier_temporalSchwartzAnnularNormalTail]
      by_cases hBzero : B zeta.1 = 0
      · simp [hBzero]
      · rw [hu zeta.1 hBzero, hbeta _ hs]
        ring
    simpa [htailzero] using hCnonneg
  · have hRle : R ≤ |zeta.2 - rho zeta.1| := by
      exact le_of_not_ge hs
    have hweight : (1 + R) ^ N ≤
        (1 + |zeta.2 - rho zeta.1|) ^ N := by
      gcongr
    calc
      (1 + R) ^ N *
          ‖spaceTimeFourier
            (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta‖ ≤
          (1 + |zeta.2 - rho zeta.1|) ^ N *
            ‖spaceTimeFourier
              (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta‖ :=
        mul_le_mul_of_nonneg_right hweight (norm_nonneg _)
      _ ≤ C := hC zeta

private theorem aux_normalShear_measurePreserving
    (rho : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Real) :
    MeasurePreserving
      (fun z : WaveSpaceTime => (z.1, z.2 - rho z.1)) volume volume := by
  rw [Measure.volume_eq_prod]
  refine (MeasurePreserving.id (volume : Measure (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2))).skew_product
    (g := fun xi (t : Real) => t - rho xi) ?_ ?_
  · exact measurable_snd.sub (rho.continuous.measurable.comp measurable_fst)
  · filter_upwards with xi
    simpa only [sub_eq_add_neg] using
      (measurePreserving_add_right (volume : Measure Real) (-rho xi)).map_eq

private theorem aux_jointSchwartzRaw_precompRadialShear_eq_comp_normalShear
    (rho : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Real)
    (Q : SchwartzMap JointWaveSpaceTime Complex) :
    jointSchwartzRaw (jointSchwartzPrecompRadialShear rho Q) =
      (jointSchwartzRaw Q) ∘
        (fun z : WaveSpaceTime => (z.1, z.2 - rho z.1)) := by
  funext z
  change (jointSchwartzPrecompRadialShear rho Q) (WithLp.toLp 2 z) =
    Q (WithLp.toLp 2 (z.1, z.2 - rho z.1))
  exact jointSchwartzPrecompRadialShear_apply rho Q z

private noncomputable def aux_normalTailWeightedTemporalProfile
    (vartheta : SchwartzMap Real Complex) (N : Nat) :
    SchwartzMap Real Complex :=
  SchwartzMap.smulLeftCLM Complex
    (fun s : Real => (1 + s ^ 2) ^ N)
    (FourierTransform.fourier vartheta)

private theorem aux_normalTailWeightedTemporalProfile_apply
    (vartheta : SchwartzMap Real Complex) (N : Nat) (s : Real) :
    aux_normalTailWeightedTemporalProfile vartheta N s =
      ((1 + s ^ 2) ^ N : Real) •
        FourierTransform.fourier (vartheta : Real → Complex) s := by
  unfold aux_normalTailWeightedTemporalProfile
  rw [SchwartzMap.smulLeftCLM_apply
    (show (fun s : Real => (1 + s ^ 2) ^ N).HasTemperateGrowth by fun_prop)]
  simp only [SchwartzMap.fourier_coe]

private theorem aux_one_add_abs_pow_le_two_pow_mul_one_add_sq_pow
    (s : Real) (N : Nat) :
    (1 + |s|) ^ N ≤ (2 : Real) ^ N * (1 + s ^ 2) ^ N := by
  have habs : |s| ≤ 1 + s ^ 2 := by
    apply abs_le.2
    constructor
    · nlinarith [sq_nonneg (s + 1 / 2)]
    · nlinarith [sq_nonneg (s - 1 / 2)]
  have hbase : 1 + |s| ≤ 2 * (1 + s ^ 2) := by
    nlinarith
  calc
    (1 + |s|) ^ N ≤ (2 * (1 + s ^ 2)) ^ N := by
      exact pow_le_pow_left₀ (by positivity) hbase N
    _ = (2 : Real) ^ N * (1 + s ^ 2) ^ N := by
      rw [mul_pow]

private theorem aux_normalTail_weighted_fourier_le_sheared_envelope
    (B u : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Real)
    (N : Nat) {M R : Real}
    (hu : ∀ xi ∈ Function.support (B : Auto.Spherical.SurfaceMeasureDecay.Euclidean 2 → Complex), u xi = 1)
    (hM : 0 ≤ M) (hR : 0 ≤ R)
    (hbeta : ∀ s : Real, |s| ≤ R → beta s = 1)
    (hdefect : ∀ s : Real, ‖(1 : Complex) - beta s‖ ≤ M)
    (zeta : WaveSpaceTime) :
    (1 + R) ^ N *
        ‖spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta‖ ≤
      (M * (2 : Real) ^ N) *
        ‖jointSchwartzRaw
          (jointSchwartzPrecompRadialShear rho
            (jointSchwartzExternalProduct B
              (aux_normalTailWeightedTemporalProfile vartheta N))) zeta‖ := by
  let s : Real := zeta.2 - rho zeta.1
  let Q : SchwartzMap JointWaveSpaceTime Complex :=
    jointSchwartzExternalProduct B (aux_normalTailWeightedTemporalProfile vartheta N)
  let G : SchwartzMap JointWaveSpaceTime Complex :=
    jointSchwartzPrecompRadialShear rho Q
  have hGnorm : ‖jointSchwartzRaw G zeta‖ =
      (1 + s ^ 2) ^ N *
        ‖B zeta.1 * FourierTransform.fourier (vartheta : Real → Complex) s‖ := by
    change ‖G (WithLp.toLp 2 zeta)‖ = _
    dsimp only [G]
    rw [jointSchwartzPrecompRadialShear_apply]
    dsimp only [Q]
    rw [jointSchwartzExternalProduct_apply]
    rw [aux_normalTailWeightedTemporalProfile_apply]
    rw [norm_mul, norm_smul, Real.norm_eq_abs,
      abs_of_nonneg (pow_nonneg (by positivity) _), norm_mul]
    ring
  change (1 + R) ^ N *
      ‖spaceTimeFourier
        (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta‖ ≤
    (M * (2 : Real) ^ N) * ‖jointSchwartzRaw G zeta‖
  by_cases hs : |s| ≤ R
  · have htailzero :
        spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta = 0 := by
      rw [spaceTimeFourier_temporalSchwartzAnnularNormalTail]
      by_cases hBzero : B zeta.1 = 0
      · simp [hBzero]
      · rw [hu zeta.1 hBzero, hbeta s hs]
        simp
    rw [htailzero]
    have hright : 0 ≤ (M * (2 : Real) ^ N) * ‖jointSchwartzRaw G zeta‖ :=
      mul_nonneg (mul_nonneg hM (pow_nonneg (by norm_num) _)) (norm_nonneg _)
    simpa using hright
  · have hslt : R < |s| := lt_of_not_ge hs
    have hweight : (1 + R) ^ N ≤ (2 : Real) ^ N * (1 + s ^ 2) ^ N := by
      calc
        (1 + R) ^ N ≤ (1 + |s|) ^ N := by
          apply pow_le_pow_left₀
          · linarith
          · linarith
        _ ≤ (2 : Real) ^ N * (1 + s ^ 2) ^ N :=
          aux_one_add_abs_pow_le_two_pow_mul_one_add_sq_pow s N
    have htail :
        ‖spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta‖ ≤
          M * ‖B zeta.1 * FourierTransform.fourier (vartheta : Real → Complex) s‖ := by
      rw [spaceTimeFourier_temporalSchwartzAnnularNormalTail]
      by_cases hBzero : B zeta.1 = 0
      · simp [hBzero]
      · rw [hu zeta.1 hBzero]
        simp only [one_mul]
        rw [norm_mul]
        exact mul_le_mul_of_nonneg_right (hdefect s) (norm_nonneg _)
    calc
      (1 + R) ^ N *
          ‖spaceTimeFourier
            (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta‖ ≤
          (1 + R) ^ N *
            (M * ‖B zeta.1 * FourierTransform.fourier (vartheta : Real → Complex) s‖) :=
        mul_le_mul_of_nonneg_left htail (pow_nonneg (by linarith) _)
      _ = M * ((1 + R) ^ N *
            ‖B zeta.1 * FourierTransform.fourier (vartheta : Real → Complex) s‖) := by
        ring
      _ ≤ M * (((2 : Real) ^ N * (1 + s ^ 2) ^ N) *
            ‖B zeta.1 * FourierTransform.fourier (vartheta : Real → Complex) s‖) := by
        exact mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_right hweight (norm_nonneg _)) hM
      _ = (M * (2 : Real) ^ N) * ‖jointSchwartzRaw G zeta‖ := by
        rw [hGnorm]
        ring

private theorem aux_eLpNorm_jointSchwartzRaw_precompRadialShear_eq
    (rho : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Real)
    (Q : SchwartzMap JointWaveSpaceTime Complex) (p : ENNReal) :
    eLpNorm (jointSchwartzRaw (jointSchwartzPrecompRadialShear rho Q)) p volume =
      eLpNorm (jointSchwartzRaw Q) p volume := by
  rw [aux_jointSchwartzRaw_precompRadialShear_eq_comp_normalShear]
  apply eLpNorm_comp_measurePreserving
  · apply Measurable.aestronglyMeasurable
    change Measurable (fun z : WaveSpaceTime => Q (WithLp.toLp 2 z))
    exact Q.continuous.measurable.comp (WithLp.measurable_toLp 2 WaveSpaceTime)
  · exact aux_normalShear_measurePreserving rho

private theorem aux_eLpNorm_jointSchwartzRaw_eq
    (Q : SchwartzMap JointWaveSpaceTime Complex) (p : ENNReal) :
    eLpNorm (jointSchwartzRaw Q) p volume =
      eLpNorm (Q : JointWaveSpaceTime → Complex) p volume := by
  let e : WaveSpaceTime → JointWaveSpaceTime := WithLp.toLp 2
  have hpres : MeasurePreserving e volume volume := by
    simpa only [e] using
      (WithLp.volume_preserving_toLp (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Real)
  change eLpNorm ((Q : JointWaveSpaceTime → Complex) ∘ e) p volume =
    eLpNorm (Q : JointWaveSpaceTime → Complex) p volume
  exact eLpNorm_comp_measurePreserving (Q.memLp p volume).aestronglyMeasurable hpres

private theorem aux_eLpNorm_weighted_normalTail_le_sheared_envelope
    (B u : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Real)
    (N : Nat) {M R : Real}
    (hu : ∀ xi ∈ Function.support (B : Auto.Spherical.SurfaceMeasureDecay.Euclidean 2 → Complex), u xi = 1)
    (hM : 0 ≤ M) (hR : 0 ≤ R)
    (hbeta : ∀ s : Real, |s| ≤ R → beta s = 1)
    (hdefect : ∀ s : Real, ‖(1 : Complex) - beta s‖ ≤ M) :
    ENNReal.ofReal ((1 + R) ^ N) *
        eLpNorm (temporalSchwartzAnnularNormalTail B u vartheta beta rho) 2 volume ≤
      ENNReal.ofReal (M * (2 : Real) ^ N) *
        eLpNorm (jointSchwartzRaw
          (jointSchwartzPrecompRadialShear rho
            (jointSchwartzExternalProduct B
              (aux_normalTailWeightedTemporalProfile vartheta N)))) 2 volume := by
  let Q : SchwartzMap JointWaveSpaceTime Complex :=
    jointSchwartzExternalProduct B (aux_normalTailWeightedTemporalProfile vartheta N)
  let G : SchwartzMap JointWaveSpaceTime Complex :=
    jointSchwartzPrecompRadialShear rho Q
  let T : Real := (1 + R) ^ N
  let D : Real := M * (2 : Real) ^ N
  have hT : 0 ≤ T := pow_nonneg (by linarith) _
  have hD : 0 ≤ D := mul_nonneg hM (pow_nonneg (by norm_num) _)
  have hpoint (zeta : WaveSpaceTime) :
      T * ‖spaceTimeFourier
        (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta‖ ≤
        D * ‖jointSchwartzRaw G zeta‖ := by
    dsimp only [T, D, G, Q]
    exact aux_normalTail_weighted_fourier_le_sheared_envelope
      B u vartheta beta rho N hu hM hR hbeta hdefect zeta
  have hnorm (zeta : WaveSpaceTime) :
      ‖T • spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta‖ ≤
        ‖D • jointSchwartzRaw G zeta‖ := by
    rw [norm_smul, norm_smul, Real.norm_eq_abs, abs_of_nonneg hT,
      Real.norm_eq_abs, abs_of_nonneg hD]
    exact hpoint zeta
  have hEL :
      eLpNorm (T • spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) 2 volume ≤
        eLpNorm (D • jointSchwartzRaw G) 2 volume :=
    eLpNorm_mono hnorm
  calc
    ENNReal.ofReal ((1 + R) ^ N) *
        eLpNorm (temporalSchwartzAnnularNormalTail B u vartheta beta rho) 2 volume =
        eLpNorm (T • spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) 2 volume := by
      dsimp only [T]
      rw [eLpNorm_const_smul, Real.enorm_eq_ofReal hT,
        eLpNorm_spaceTimeFourier_temporalSchwartzAnnularNormalTail_two_eq]
    _ ≤ eLpNorm (D • jointSchwartzRaw G) 2 volume := hEL
    _ = ENNReal.ofReal (M * (2 : Real) ^ N) *
        eLpNorm (jointSchwartzRaw G) 2 volume := by
      dsimp only [D]
      rw [eLpNorm_const_smul, Real.enorm_eq_ofReal hD]

/-- A uniform bounded normal-cutoff defect and normal-ball agreement give an
arbitrarily rapid global L2 normal-tail bound for the supplied regular
Schwartz model. The constant is chosen before the cutoff, shear, and radius;
this is not a statement about raw compact-time packets or plate support. -/
theorem exists_finite_uniform_one_add_normal_radius_pow_mul_eLpNorm_two_temporalSchwartzAnnularNormalTail
    (B : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (N : Nat) (M : Real) (hM : 0 ≤ M) :
    ∃ C : ENNReal, C < ∞ ∧ ∀
      (u : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Complex)
      (beta : SchwartzMap Real Complex)
      (rho : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Real) {R : Real},
      (∀ xi ∈ Function.support (B : Auto.Spherical.SurfaceMeasureDecay.Euclidean 2 → Complex), u xi = 1) →
      0 ≤ R →
      (∀ s : Real, |s| ≤ R → beta s = 1) →
      (∀ s : Real, ‖(1 : Complex) - beta s‖ ≤ M) →
      ENNReal.ofReal ((1 + R) ^ N) *
        eLpNorm (temporalSchwartzAnnularNormalTail B u vartheta beta rho) 2 volume ≤ C := by
  let Q : SchwartzMap JointWaveSpaceTime Complex :=
    jointSchwartzExternalProduct B (aux_normalTailWeightedTemporalProfile vartheta N)
  let C : ENNReal := ENNReal.ofReal (M * (2 : Real) ^ N) *
    eLpNorm (jointSchwartzRaw Q) 2 volume
  have hQtop : eLpNorm (jointSchwartzRaw Q) 2 volume < ∞ := by
    rw [aux_eLpNorm_jointSchwartzRaw_eq Q 2]
    exact lt_top_iff_ne_top.mpr (Q.memLp 2 volume).eLpNorm_ne_top
  refine ⟨C, ?_, ?_⟩
  · dsimp only [C]
    exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top hQtop
  · intro u beta rho R hu hR hbeta hdefect
    have hbound := aux_eLpNorm_weighted_normalTail_le_sheared_envelope
      B u vartheta beta rho N hu hM hR hbeta hdefect
    rw [aux_eLpNorm_jointSchwartzRaw_precompRadialShear_eq rho Q 2] at hbound
    exact hbound

private theorem aux_norm_fourierInv_apply_le_toLp_one
    (P : SchwartzMap JointWaveSpaceTime Complex) (w : JointWaveSpaceTime) :
    ‖FourierTransform.fourierInv (P : JointWaveSpaceTime → Complex) w‖ ≤
      ‖P.toLp 1 volume‖ := by
  rw [← SchwartzMap.fourierInv_coe]
  rw [SchwartzMap.fourierInv_apply_eq]
  change ‖(FourierTransform.fourier P) (-w)‖ ≤ ‖P.toLp 1 volume‖
  exact SchwartzMap.norm_fourier_apply_le_toLp_one P (-w)

private theorem aux_aestronglyMeasurable_jointSchwartzRaw
    (P : SchwartzMap JointWaveSpaceTime Complex) :
    AEStronglyMeasurable (jointSchwartzRaw P) volume := by
  have htoLp : Continuous (WithLp.toLp 2 : WaveSpaceTime → JointWaveSpaceTime) :=
    WithLp.prod_continuous_toLp 2 _ _
  change AEStronglyMeasurable (fun z : WaveSpaceTime => P (WithLp.toLp 2 z)) volume
  exact (P.continuous.comp htoLp).aestronglyMeasurable

private theorem aux_eLpNorm_top_jointSchwartzRaw_fourierInv_le
    (P : SchwartzMap JointWaveSpaceTime Complex) :
    eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) ⊤ volume ≤
      ENNReal.ofReal ‖P.toLp 1 volume‖ := by
  rw [eLpNorm_exponent_top]
  apply eLpNormEssSup_le_of_ae_bound
  filter_upwards with z
  change ‖(FourierTransform.fourierInv P : SchwartzMap JointWaveSpaceTime Complex)
    (WithLp.toLp 2 z)‖ ≤ ‖P.toLp 1 volume‖
  rw [SchwartzMap.fourierInv_coe]
  exact aux_norm_fourierInv_apply_le_toLp_one P _

private theorem aux_eLpNorm_four_rpow_two_jointSchwartzRaw_fourierInv_le
    (P : SchwartzMap JointWaveSpaceTime Complex) :
    (eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) 4 volume) ^ (2 : Real) ≤
      eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) 2 volume *
        ENNReal.ofReal ‖P.toLp 1 volume‖ := by
  calc
    (eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) 4 volume) ^ (2 : Real) ≤
        eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) 2 volume *
          eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) ⊤ volume :=
      Auto.LpSpaceFacts.eLpNorm_four_rpow_two_le_two_mul_top _
        (aux_aestronglyMeasurable_jointSchwartzRaw _)
    _ ≤ eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) 2 volume *
          ENNReal.ofReal ‖P.toLp 1 volume‖ := by
        simpa only [mul_comm] using
          mul_le_mul_left (aux_eLpNorm_top_jointSchwartzRaw_fourierInv_le P)
            (eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) 2 volume)

private theorem aux_weighted_eLpNorm_four_sq_jointSchwartzRaw_fourierInv_le
    (P : SchwartzMap JointWaveSpaceTime Complex)
    (R : Real) (N : Nat) (A : ENNReal)
    (hA : (ENNReal.ofReal (1 + R)) ^ (2 * N) *
        eLpNorm (spaceTimeFourier
          (jointSchwartzRaw (FourierTransform.fourierInv P))) 2 volume ≤ A) :
    ((ENNReal.ofReal (1 + R)) ^ N *
        eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) 4 volume) ^ 2 ≤
      A * ENNReal.ofReal ‖P.toLp 1 volume‖ := by
  have hplain := aux_eLpNorm_four_rpow_two_jointSchwartzRaw_fourierInv_le P
  have hfour :
      (eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) 4 volume) ^ 2 ≤
        eLpNorm (spaceTimeFourier
          (jointSchwartzRaw (FourierTransform.fourierInv P))) 2 volume *
          ENNReal.ofReal ‖P.toLp 1 volume‖ := by
    rw [← eLpNorm_spaceTimeFourier_jointSchwartzRaw_two_eq
      (FourierTransform.fourierInv P)] at hplain
    simpa only [ENNReal.rpow_two] using hplain
  calc
    ((ENNReal.ofReal (1 + R)) ^ N *
        eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) 4 volume) ^ 2 =
        (ENNReal.ofReal (1 + R)) ^ (2 * N) *
          (eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) 4 volume) ^ 2 := by
      rw [mul_pow]
      congr 1
      simpa only [pow_mul, Nat.mul_comm]
    _ ≤ (ENNReal.ofReal (1 + R)) ^ (2 * N) *
          (eLpNorm (spaceTimeFourier
            (jointSchwartzRaw (FourierTransform.fourierInv P))) 2 volume *
            ENNReal.ofReal ‖P.toLp 1 volume‖) := by
      gcongr
    _ = ((ENNReal.ofReal (1 + R)) ^ (2 * N) *
          eLpNorm (spaceTimeFourier
            (jointSchwartzRaw (FourierTransform.fourierInv P))) 2 volume) *
          ENNReal.ofReal ‖P.toLp 1 volume‖ := by
      ring
    _ ≤ A * ENNReal.ofReal ‖P.toLp 1 volume‖ := by
      exact mul_le_mul_left hA _

private noncomputable def aux_temporalSchwartzAnnularNormalTailSpectrum
    (B u : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Real) :
    SchwartzMap JointWaveSpaceTime Complex :=
  jointSchwartzModulatedAnnularProfile B vartheta rho -
    jointSchwartzSpectralCutoffProduct
      (jointSchwartzSpatialNormalCutoff u beta rho)
      (FourierTransform.fourierInv
        (jointSchwartzModulatedAnnularProfile B vartheta rho))

private theorem aux_temporalSchwartzAnnularNormalTailSpectrum_apply_toLp_eq
    (B u : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Real)
    (z : WaveSpaceTime) :
    aux_temporalSchwartzAnnularNormalTailSpectrum B u vartheta beta rho
        (WithLp.toLp 2 z) =
      spaceTimeFourier
        (temporalSchwartzAnnularNormalTail B u vartheta beta rho) z := by
  rw [temporalSchwartzAnnularNormalTail,
    spaceTimeFourier_jointSchwartzRaw]
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  rfl

private theorem aux_weighted_eLpNorm_four_sq_temporalSchwartzAnnularNormalTail_le
    (B u : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Real)
    (R : Real) (N : Nat) (A : ENNReal)
    (hA : (ENNReal.ofReal (1 + R)) ^ (2 * N) *
        eLpNorm (spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) 2 volume ≤ A) :
    ((ENNReal.ofReal (1 + R)) ^ N *
        eLpNorm (temporalSchwartzAnnularNormalTail B u vartheta beta rho) 4 volume) ^ 2 ≤
      A * ENNReal.ofReal
        ‖(aux_temporalSchwartzAnnularNormalTailSpectrum B u vartheta beta rho).toLp
          1 volume‖ := by
  simpa only [temporalSchwartzAnnularNormalTail,
    aux_temporalSchwartzAnnularNormalTailSpectrum] using
    aux_weighted_eLpNorm_four_sq_jointSchwartzRaw_fourierInv_le
      (aux_temporalSchwartzAnnularNormalTailSpectrum B u vartheta beta rho) R N A hA

private theorem aux_enorm_toLp_one_tailSpectrum_eq_fourierTail
    (B u : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Real) :
    ENNReal.ofReal
        ‖(aux_temporalSchwartzAnnularNormalTailSpectrum B u vartheta beta rho).toLp
            1 volume‖ =
      eLpNorm
        (spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) 1 volume := by
  let P := aux_temporalSchwartzAnnularNormalTailSpectrum B u vartheta beta rho
  calc
    ENNReal.ofReal ‖P.toLp 1 volume‖ = ‖P.toLp 1 volume‖ₑ := by
      rw [ofReal_norm]
    _ = eLpNorm (P : JointWaveSpaceTime → Complex) 1 volume :=
      Lp.enorm_toLp (P.memLp 1 volume)
    _ = eLpNorm (jointSchwartzRaw P) 1 volume :=
      (aux_eLpNorm_jointSchwartzRaw_eq P 1).symm
    _ = eLpNorm
        (spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) 1 volume := by
      apply eLpNorm_congr_ae
      filter_upwards with z
      change P (WithLp.toLp 2 z) = _
      exact aux_temporalSchwartzAnnularNormalTailSpectrum_apply_toLp_eq
        B u vartheta beta rho z

private theorem aux_tailFourier_norm_le_smul_profile
    (B u : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Real)
    (M : Real)
    (hM : 0 ≤ M)
    (hu : ∀ xi ∈ Function.support (B : Auto.Spherical.SurfaceMeasureDecay.Euclidean 2 → Complex), u xi = 1)
    (hbeta : ∀ s : Real, ‖(1 : Complex) - beta s‖ ≤ M)
    (zeta : WaveSpaceTime) :
    ‖spaceTimeFourier
        (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta‖ ≤
      ‖(M : Complex) •
        jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho) zeta‖ := by
  rw [spaceTimeFourier_temporalSchwartzAnnularNormalTail]
  change ‖(1 - u zeta.1 * beta (zeta.2 - rho zeta.1)) *
      (B zeta.1 * FourierTransform.fourier
        (vartheta : Real → Complex) (zeta.2 - rho zeta.1))‖ ≤
    ‖(M : Complex) •
      jointSchwartzModulatedAnnularProfile B vartheta rho (WithLp.toLp 2 zeta)‖
  rw [jointSchwartzModulatedAnnularProfile_apply]
  rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hM]
  by_cases hB : B zeta.1 = 0
  · simp [hB]
  · rw [hu zeta.1 hB]
    simp only [one_mul]
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (hbeta _) (norm_nonneg _)

private theorem aux_eLpNorm_one_spaceTimeFourier_temporalSchwartzAnnularNormalTail_le_external
    (B u : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Real)
    (M : Real)
    (hM : 0 ≤ M)
    (hu : ∀ xi ∈ Function.support (B : Auto.Spherical.SurfaceMeasureDecay.Euclidean 2 → Complex), u xi = 1)
    (hbeta : ∀ s : Real, ‖(1 : Complex) - beta s‖ ≤ M) :
    eLpNorm
        (spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) 1 volume ≤
      ENNReal.ofReal M *
        eLpNorm
          (jointSchwartzRaw
            (jointSchwartzExternalProduct B (FourierTransform.fourier vartheta)))
          1 volume := by
  have htransport :
      eLpNorm (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho))
          1 volume =
        eLpNorm
          (jointSchwartzRaw
            (jointSchwartzExternalProduct B (FourierTransform.fourier vartheta)))
          1 volume := by
    change eLpNorm
        (jointSchwartzRaw
          (jointSchwartzPrecompRadialShear rho
            (jointSchwartzExternalProduct B (FourierTransform.fourier vartheta))))
          1 volume = _
    exact aux_eLpNorm_jointSchwartzRaw_precompRadialShear_eq rho
      (jointSchwartzExternalProduct B (FourierTransform.fourier vartheta)) 1
  calc
    eLpNorm
        (spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) 1 volume ≤
        eLpNorm
          ((M : Complex) •
            jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho))
          1 volume :=
      eLpNorm_mono
        (aux_tailFourier_norm_le_smul_profile B u vartheta beta rho M hM hu hbeta)
    _ = ‖(M : Complex)‖ₑ *
          eLpNorm (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho))
            1 volume :=
      eLpNorm_const_smul (M : Complex)
        (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho)) 1 volume
    _ = ENNReal.ofReal M *
          eLpNorm (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho))
            1 volume := by
      congr 1
      simp [← ofReal_norm, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hM]
    _ = ENNReal.ofReal M *
          eLpNorm
            (jointSchwartzRaw
              (jointSchwartzExternalProduct B (FourierTransform.fourier vartheta)))
            1 volume := by
      rw [htransport]

private theorem aux_weighted_eLpNorm_four_sq_temporalSchwartzAnnularNormalTail_le_of_L2_L1
    (B u : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Real)
    (R : Real) (N : Nat) (A L : ENNReal)
    (hA : (ENNReal.ofReal (1 + R)) ^ (2 * N) *
        eLpNorm (temporalSchwartzAnnularNormalTail B u vartheta beta rho) 2 volume ≤ A)
    (hL : eLpNorm
        (spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) 1 volume ≤ L) :
    ((ENNReal.ofReal (1 + R)) ^ N *
        eLpNorm (temporalSchwartzAnnularNormalTail B u vartheta beta rho) 4 volume) ^ 2 ≤
      A * L := by
  have hA' : (ENNReal.ofReal (1 + R)) ^ (2 * N) *
      eLpNorm
        (spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) 2 volume ≤ A := by
    rw [eLpNorm_spaceTimeFourier_temporalSchwartzAnnularNormalTail_two_eq]
    exact hA
  have hinterp :=
    aux_weighted_eLpNorm_four_sq_temporalSchwartzAnnularNormalTail_le
      B u vartheta beta rho R N A hA'
  rw [aux_enorm_toLp_one_tailSpectrum_eq_fourierTail B u vartheta beta rho] at hinterp
  exact hinterp.trans (by simpa only [mul_comm] using mul_le_mul_left hL A)

/-- A bounded normal-cutoff defect and normal-ball agreement give an
arbitrarily rapid uniform squared L4 envelope for the supplied regular
joint-Schwartz normal-tail model. This has no raw-packet or local-smoothing
content. -/
theorem exists_finite_uniform_one_add_normal_radius_pow_mul_eLpNorm_four_sq_temporalSchwartzAnnularNormalTail
    (B : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (N : Nat) (M : Real) (hM : 0 ≤ M) :
    ∃ C : ENNReal, C < ∞ ∧ ∀
      (u : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Complex)
      (beta : SchwartzMap Real Complex)
      (rho : SchwartzMap (Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) Real) {R : Real},
      (∀ xi ∈ Function.support (B : Auto.Spherical.SurfaceMeasureDecay.Euclidean 2 → Complex), u xi = 1) →
      0 ≤ R →
      (∀ s : Real, |s| ≤ R → beta s = 1) →
      (∀ s : Real, ‖(1 : Complex) - beta s‖ ≤ M) →
      ((ENNReal.ofReal (1 + R)) ^ N *
        eLpNorm (temporalSchwartzAnnularNormalTail B u vartheta beta rho) 4 volume) ^ 2 ≤ C := by
  obtain ⟨C₂, hC₂top, hC₂⟩ :=
    exists_finite_uniform_one_add_normal_radius_pow_mul_eLpNorm_two_temporalSchwartzAnnularNormalTail
      B vartheta (2 * N) M hM
  let Q : SchwartzMap JointWaveSpaceTime Complex :=
    jointSchwartzExternalProduct B (FourierTransform.fourier vartheta)
  let C : ENNReal := C₂ *
    (ENNReal.ofReal M * eLpNorm (jointSchwartzRaw Q) 1 volume)
  have hQtop : eLpNorm (jointSchwartzRaw Q) 1 volume < ∞ := by
    rw [aux_eLpNorm_jointSchwartzRaw_eq Q 1]
    exact lt_top_iff_ne_top.mpr (Q.memLp 1 volume).eLpNorm_ne_top
  refine ⟨C, ?_, ?_⟩
  · dsimp only [C]
    exact ENNReal.mul_lt_top hC₂top
      (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hQtop)
  · intro u beta rho R hu hR hball hdefect
    have hOne : 0 ≤ 1 + R := by linarith
    have hA : (ENNReal.ofReal (1 + R)) ^ (2 * N) *
        eLpNorm (temporalSchwartzAnnularNormalTail B u vartheta beta rho) 2 volume ≤ C₂ := by
      rw [← ENNReal.ofReal_pow hOne]
      exact hC₂ u beta rho hu hR hball hdefect
    have hL :
        eLpNorm
            (spaceTimeFourier
              (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) 1 volume ≤
          ENNReal.ofReal M * eLpNorm (jointSchwartzRaw Q) 1 volume := by
      dsimp only [Q]
      exact aux_eLpNorm_one_spaceTimeFourier_temporalSchwartzAnnularNormalTail_le_external
        B u vartheta beta rho M hM hu hdefect
    simpa only [C] using
      aux_weighted_eLpNorm_four_sq_temporalSchwartzAnnularNormalTail_le_of_L2_L1
        B u vartheta beta rho R N C₂
          (ENNReal.ofReal M * eLpNorm (jointSchwartzRaw Q) 1 volume) hA hL

private theorem aux_ennreal_le_one_add_of_sq_le
    {x C : ENNReal} (h : x ^ 2 ≤ C) : x ≤ 1 + C := by
  rcases le_total x 1 with hx | hx
  · exact hx.trans (by simp)
  · calc
      x = x * 1 := (mul_one x).symm
      _ ≤ x * x := by simpa [mul_comm] using mul_le_mul_left hx x
      _ = x ^ 2 := (pow_two x).symm
      _ ≤ C := h
      _ ≤ 1 + C := by simp

theorem aux_exists_finite_uniform_weighted_normalTail_finset
    (radialIndices angularIndices : Finset Int)
    (B : Int → Int → SchwartzMap (Euclidean 2) Complex)
    (vartheta : Int → Int → SchwartzMap Real Complex)
    (N : Nat) (M : Real) (hM : 0 ≤ M) :
    ∃ D : ENNReal, D < ∞ ∧ ∀
      (u : Int → Int → SchwartzMap (Euclidean 2) Complex)
      (beta : Int → Int → SchwartzMap Real Complex)
      (rho : Int → Int → SchwartzMap (Euclidean 2) Real) {normalRadius : Real},
      (∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
        ∀ xi ∈ Function.support (B n nu : Euclidean 2 → Complex), u n nu xi = 1) →
      0 ≤ normalRadius →
      (∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
        ∀ s : Real, |s| ≤ normalRadius → beta n nu s = 1) →
      (∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
        ∀ s : Real, ‖(1 : Complex) - beta n nu s‖ ≤ M) →
      (ENNReal.ofReal (1 + normalRadius)) ^ N *
        (∑ n ∈ radialIndices, ∑ nu ∈ angularIndices,
          eLpNorm
            (temporalSchwartzAnnularNormalTail
              (B n nu) (u n nu) (vartheta n nu) (beta n nu) (rho n nu)) 4 volume) ≤ D := by
  choose C hCtop hC using fun n nu =>
    exists_finite_uniform_one_add_normal_radius_pow_mul_eLpNorm_four_sq_temporalSchwartzAnnularNormalTail
      (B n nu) (vartheta n nu) N M hM
  let D : ENNReal := ∑ n ∈ radialIndices, ∑ nu ∈ angularIndices, (1 + C n nu)
  refine ⟨D, ?_, ?_⟩
  · dsimp only [D]
    rw [ENNReal.sum_lt_top]
    intro n hn
    rw [ENNReal.sum_lt_top]
    intro nu hnu
    exact ENNReal.add_lt_top.mpr ⟨by simp, hCtop n nu⟩
  · intro u beta rho normalRadius hu hnormalRadius hball hdefect
    dsimp only [D]
    calc
      (ENNReal.ofReal (1 + normalRadius)) ^ N *
          (∑ n ∈ radialIndices, ∑ nu ∈ angularIndices,
            eLpNorm
              (temporalSchwartzAnnularNormalTail
                (B n nu) (u n nu) (vartheta n nu) (beta n nu) (rho n nu)) 4 volume) =
          ∑ n ∈ radialIndices, ∑ nu ∈ angularIndices,
            (ENNReal.ofReal (1 + normalRadius)) ^ N *
              eLpNorm
                (temporalSchwartzAnnularNormalTail
                  (B n nu) (u n nu) (vartheta n nu) (beta n nu) (rho n nu)) 4 volume := by
            simp only [Finset.mul_sum]
      _ ≤ ∑ n ∈ radialIndices, ∑ nu ∈ angularIndices, (1 + C n nu) := by
        apply Finset.sum_le_sum
        intro n hn
        apply Finset.sum_le_sum
        intro nu hnu
        apply aux_ennreal_le_one_add_of_sq_le
        exact hC n nu (u n nu) (beta n nu) (rho n nu)
          (hu n hn nu hnu) hnormalRadius (hball n hn nu hnu)
          (hdefect n hn nu hnu)

/-- A supplied regular angular/radial model is uniformly approximated by its
temporal-Schwartz normal projection, with the squared L4 error controlled by
the literal normal tail. This is a one-packet regular-model statement only. -/
theorem exists_finite_uniform_one_add_normal_radius_pow_mul_eLpNorm_four_sq_angularPiece_sub_projection_of_schwartzRadialProfile
    (B R f : SchwartzMap (Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (scale : Real) (a chi : Euclidean 2 → Complex) (radialCutoff : Real → Complex)
    (n : Int) (N : Nat) (M : Real) (hM : 0 ≤ M)
    (hR : ∀ xi : Euclidean 2,
      R xi = radialCutoff ((Real.sqrt scale)⁻¹ * ‖xi‖ - n))
    (hB : ∀ xi : Euclidean 2, B xi =
      chi xi * a (scale⁻¹ • xi) *
        (R xi * FourierTransform.fourier (f : Euclidean 2 → Complex) xi)) :
    ∃ C : ENNReal, C < ∞ ∧ ∀
      (u : SchwartzMap (Euclidean 2) Complex)
      (beta : SchwartzMap Real Complex)
      (rho : SchwartzMap (Euclidean 2) Real) {normalRadius : Real},
      (∀ xi ∈ Function.support (B : Euclidean 2 → Complex), u xi = 1) →
      (∀ xi ∈ Function.support (B : Euclidean 2 → Complex), rho xi = ‖xi‖) →
      0 ≤ normalRadius →
      (∀ s : Real, |s| ≤ normalRadius → beta s = 1) →
      (∀ s : Real, ‖(1 : Complex) - beta s‖ ≤ M) →
      ((ENNReal.ofReal (1 + normalRadius)) ^ N *
        eLpNorm
          (angularPiece scale a chi (vartheta : Real → Complex)
            (radialPiece radialCutoff scale n (f : Euclidean 2 → Complex)) -
            temporalSchwartzAnnularNormalProjection B u vartheta beta rho)
          4 volume) ^ 2 ≤ C := by
  obtain ⟨C, hCtop, hC⟩ :=
    exists_finite_uniform_one_add_normal_radius_pow_mul_eLpNorm_four_sq_temporalSchwartzAnnularNormalTail
      B vartheta N M hM
  refine ⟨C, hCtop, ?_⟩
  intro u beta rho normalRadius hu hrho hnormalRadius hball hdefect
  have hsplit :=
    angularPiece_eq_projection_add_normalTail_of_schwartzRadialProfile
      B R f u vartheta beta rho scale a chi radialCutoff n hR hB hrho
  have htail :
      angularPiece scale a chi (vartheta : Real → Complex)
          (radialPiece radialCutoff scale n (f : Euclidean 2 → Complex)) -
          temporalSchwartzAnnularNormalProjection B u vartheta beta rho =
        temporalSchwartzAnnularNormalTail B u vartheta beta rho := by
    rw [hsplit]
    abel
  rw [htail]
  exact hC u beta rho hu hnormalRadius hball hdefect

/-- A finite exactly decomposed family is approximated in L4 by its main
terms with the sum of supplied tail bounds. This is finite Minkowski only:
it has no square-function, continuum, or local-smoothing content. -/
theorem eLpNorm_four_finset_sum_sub_le_sum_of_eq_add_of_tail_bounds
    {ι : Type*} (indices : Finset ι)
    (main tail full : ι → WaveSpaceTime → Complex)
    (hdecomp : ∀ i ∈ indices, full i = main i + tail i)
    (htailMeas : ∀ i ∈ indices, AEStronglyMeasurable (tail i) volume)
    (E : ι → ENNReal)
    (hE : ∀ i ∈ indices, eLpNorm (tail i) 4 volume ≤ E i) :
    eLpNorm ((∑ i ∈ indices, full i) - ∑ i ∈ indices, main i) 4 volume ≤
      ∑ i ∈ indices, E i := by
  have hsum : (∑ i ∈ indices, full i) - ∑ i ∈ indices, main i =
      ∑ i ∈ indices, tail i := by
    rw [← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro i hi
    rw [hdecomp i hi]
    simp
  rw [hsum]
  calc
    eLpNorm (∑ i ∈ indices, tail i) 4 volume ≤
        ∑ i ∈ indices, eLpNorm (tail i) 4 volume := by
      apply eLpNorm_sum_le
      · intro i hi
        exact htailMeas i hi
      · norm_num
    _ ≤ ∑ i ∈ indices, E i := by
      apply Finset.sum_le_sum
      intro i hi
      exact hE i hi

/-- The Fourier transform of the projected temporal-Schwartz annular
positive half-wave is exactly its joint spatial/normal cutoff times the
unprojected profile. -/
theorem spaceTimeFourier_temporalSchwartzAnnularNormalProjection
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hrho : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), rho xi = ‖xi‖)
    (zeta : WaveSpaceTime) :
    spaceTimeFourier
        (temporalSchwartzAnnularNormalProjection B u vartheta beta rho) zeta =
      jointSchwartzSpatialNormalCutoff u beta rho (WithLp.toLp 2 zeta) *
        spaceTimeFourier
          (fun z : WaveSpaceTime =>
            vartheta z.2 * FourierTransform.fourierInv
              (fun xi : Euclidean 2 =>
                B xi * halfWaveMultiplier WaveSign.plus z.2 xi) z.1) zeta := by
  unfold temporalSchwartzAnnularNormalProjection
  rw [spaceTimeFourier_jointSchwartzSpectralCutoffOutput]
  change jointSchwartzSpectralCutoffProduct
      (jointSchwartzSpatialNormalCutoff u beta rho)
      (FourierTransform.fourierInv
        (jointSchwartzModulatedAnnularProfile B vartheta rho))
      (WithLp.toLp 2 zeta) = _
  rw [jointSchwartzSpectralCutoffProduct,
    SchwartzMap.smulLeftCLM_apply_apply
      (jointSchwartzSpatialNormalCutoff u beta rho).hasTemperateGrowth]
  rw [FourierTransform.fourier_fourierInv_eq]
  simp only [smul_eq_mul]
  rw [spaceTimeFourier_temporalSchwartzHalfWave_eq_jointSchwartzModulatedAnnularProfile
    B vartheta rho hrho zeta]

/-- The supplied temporal-Schwartz normal projection has the literal joint
Fourier amplitude determined by its spatial and normal profiles.  This remains
joint in `(ξ, τ)` and is not identified with a separable spectral packet. -/
theorem spaceTimeFourier_temporalSchwartzAnnularNormalProjection_eq_jointAmplitude
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hu : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), u xi = 1)
    (xi : Euclidean 2) (tau : Real) :
    spaceTimeFourier
        (temporalSchwartzAnnularNormalProjection B u vartheta beta rho) (xi, tau) =
      B xi *
        (beta (tau - rho xi) *
          FourierTransform.fourier (vartheta : Real → Complex) (tau - rho xi)) := by
  unfold temporalSchwartzAnnularNormalProjection
  rw [spaceTimeFourier_jointSchwartzSpectralCutoffOutput]
  change jointSchwartzSpectralCutoffProduct
      (jointSchwartzSpatialNormalCutoff u beta rho)
      (FourierTransform.fourierInv
        (jointSchwartzModulatedAnnularProfile B vartheta rho))
      (WithLp.toLp 2 (xi, tau)) = _
  rw [jointSchwartzSpectralCutoffProduct,
    SchwartzMap.smulLeftCLM_apply_apply
      (jointSchwartzSpatialNormalCutoff u beta rho).hasTemperateGrowth]
  rw [FourierTransform.fourier_fourierInv_eq]
  rw [jointSchwartzSpatialNormalCutoff_apply,
    jointSchwartzModulatedAnnularProfile_apply]
  by_cases hB : B xi = 0
  · simp [hB]
  · have hxi : xi ∈ Function.support (B : Euclidean 2 → Complex) := hB
    rw [hu xi hxi]
    ring

private def aux_spatialNormalStrip
    (B : Euclidean 2 → Complex) (beta : Real → Complex)
    (rho : Euclidean 2 → Real) : Set WaveSpaceTime :=
  {zeta | zeta.1 ∈ Function.support B ∧
    zeta.2 - rho zeta.1 ∈ Function.support beta}

private theorem aux_jointSchwartzSpatialNormalCutoff_mul_spaceTimeFourier_temporalSchwartzHalfWave
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hrho : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), rho xi = ‖xi‖)
    (hu : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), u xi = 1)
    (zeta : WaveSpaceTime) :
    jointSchwartzSpatialNormalCutoff u beta rho (WithLp.toLp 2 zeta) *
        spaceTimeFourier
          (fun z : WaveSpaceTime =>
            vartheta z.2 * FourierTransform.fourierInv
              (fun xi : Euclidean 2 =>
                B xi * halfWaveMultiplier WaveSign.plus z.2 xi) z.1) zeta =
      B zeta.1 *
        (beta (zeta.2 - rho zeta.1) *
          FourierTransform.fourier (vartheta : Real → Complex)
            (zeta.2 - rho zeta.1)) := by
  rw [spaceTimeFourier_temporalSchwartzHalfWave_eq_jointSchwartzModulatedAnnularProfile
    B vartheta rho hrho zeta,
    jointSchwartzModulatedAnnularProfile_apply,
    jointSchwartzSpatialNormalCutoff_apply]
  by_cases hB : B zeta.1 = 0
  · simp [hB]
  · rw [hu zeta.1 hB]
    ring

private theorem aux_support_spaceTimeFourier_temporalSchwartzAnnularNormalProjection_subset_spatialNormalStrip
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hrho : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), rho xi = ‖xi‖)
    (hu : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), u xi = 1) :
    Function.support
        (spaceTimeFourier
          (temporalSchwartzAnnularNormalProjection B u vartheta beta rho)) ⊆
      aux_spatialNormalStrip (B : Euclidean 2 → Complex) (beta : Real → Complex)
        (rho : Euclidean 2 → Real) := by
  intro zeta hzeta
  change spaceTimeFourier
      (temporalSchwartzAnnularNormalProjection B u vartheta beta rho) zeta ≠ 0 at hzeta
  rw [spaceTimeFourier_temporalSchwartzAnnularNormalProjection
    B u vartheta beta rho hrho zeta] at hzeta
  rw [aux_jointSchwartzSpatialNormalCutoff_mul_spaceTimeFourier_temporalSchwartzHalfWave
    B u vartheta beta rho hrho hu zeta] at hzeta
  change B zeta.1 *
      (beta (zeta.2 - rho zeta.1) *
        FourierTransform.fourier (vartheta : Real → Complex)
          (zeta.2 - rho zeta.1)) ≠ 0 at hzeta
  rcases mul_ne_zero_iff.mp hzeta with ⟨hB, htail⟩
  rcases mul_ne_zero_iff.mp htail with ⟨hbeta, _⟩
  exact ⟨hB, hbeta⟩

/-- Explicit spatial, vertical-label, and normal-width hypotheses put the
Fourier support of the projected temporal-Schwartz annular half-wave in a
conic plate.  This is a statement about the projected model only. -/
theorem support_spaceTimeFourier_temporalSchwartzAnnularNormalProjection_subset_conicPlate
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (scale gamma angularConstant : Real) (n : Int) (direction : Euclidean 2)
    (hrho : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), rho xi = ‖xi‖)
    (hu : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), u xi = 1)
    (hspatial : Function.support (B : Euclidean 2 → Complex) ⊆
      {xi | scale / 4 ≤ ‖xi‖ ∧ ‖xi‖ ≤ 4 * scale ∧
        xi ∈ angularSector direction
          (angularConstant * scale ^ (-(1 / 2 : Real)))})
    (hvertical : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex),
      ∀ s ∈ Function.support (beta : Real → Complex),
        |(Real.sqrt scale)⁻¹ * (rho xi + s) - n| ≤ 1)
    (hnormal : ∀ s ∈ Function.support (beta : Real → Complex),
      |s| ≤ 2 * scale ^ gamma) :
    Function.support
        (spaceTimeFourier
          (temporalSchwartzAnnularNormalProjection B u vartheta beta rho)) ⊆
      conicPlate scale gamma angularConstant n direction := by
  intro zeta hzeta
  have hstrip :=
    aux_support_spaceTimeFourier_temporalSchwartzAnnularNormalProjection_subset_spatialNormalStrip
      B u vartheta beta rho hrho hu hzeta
  rcases hstrip with ⟨hB, hbeta⟩
  rcases hspatial hB with ⟨hlow, hhigh, hangular⟩
  refine ⟨hlow, hhigh, hangular, ?_, ?_⟩
  · have hvertical' := hvertical zeta.1 hB (zeta.2 - rho zeta.1) hbeta
    have hsum : rho zeta.1 + (zeta.2 - rho zeta.1) = zeta.2 := by
      ring
    rw [hsum] at hvertical'
    exact hvertical'
  · rw [← hrho zeta.1 hB]
    exact hnormal (zeta.2 - rho zeta.1) hbeta

/-- A joint-Schwartz spectral realization with a conically supported cutoff
gives the plate-support condition used by the retained raw-model transfer
hypothesis `overlapSquareFunctionRawHypothesis`.  The proved overlap theorem
uses joint-Schwartz spectral profiles directly.  This statement intentionally
does not apply to raw compact physical-time half-waves. -/
theorem support_spaceTimeFourier_wavefrontProjection_subset_conicPlate_of_jointSchwartzRealization
    (angularCutoff : Euclidean 2 → Complex) (normalCutoff : Real → Complex)
    (scale gamma angularConstant : Real) (n : Int) (direction : Euclidean 2)
    (q G : SchwartzMap JointWaveSpaceTime Complex)
    (hrealize : ∀ ζ : WaveSpaceTime,
      wavefrontMultiplier angularCutoff normalCutoff scale gamma ζ *
          FourierTransform.fourier (G : JointWaveSpaceTime → Complex)
            (WithLp.toLp 2 ζ) =
        q (WithLp.toLp 2 ζ) *
          FourierTransform.fourier (G : JointWaveSpaceTime → Complex)
            (WithLp.toLp 2 ζ))
    (hq : Function.support (fun ζ : WaveSpaceTime => q (WithLp.toLp 2 ζ)) ⊆
      conicPlate scale gamma angularConstant n direction) :
    Function.support
        (spaceTimeFourier
          (wavefrontProjection angularCutoff normalCutoff scale gamma
            (jointSchwartzRaw G))) ⊆
      conicPlate scale gamma angularConstant n direction := by
  rw [wavefrontProjection_eq_jointSchwartzSpectralCutoffOutput_of_realization
    angularCutoff normalCutoff scale gamma q G hrealize]
  intro ζ hζ
  change spaceTimeFourier (jointSchwartzSpectralCutoffOutput q G) ζ ≠ 0 at hζ
  rw [spaceTimeFourier_jointSchwartzSpectralCutoffOutput q G ζ] at hζ
  apply hq
  intro hqzero
  apply hζ
  change q (WithLp.toLp 2 ζ) = 0 at hqzero
  rw [jointSchwartzSpectralCutoffProduct,
    SchwartzMap.smulLeftCLM_apply_apply q.hasTemperateGrowth, hqzero]
  simp

/-- A spectral tensor packet, localized in the radial label by the literal
vertical multiplier.  Its temporal factor is Schwartz; in particular this is
not a compact physical-time-cutoff half-wave. -/
noncomputable def spectralRadialNormalPacket
    (β : Real → Complex) (scale : Real) (n : Int)
    (F : SchwartzMap (Euclidean 2) Complex) (g : SchwartzMap Real Complex) :
    WaveSpaceTime → Complex :=
  verticalProjection β scale n (verticalSeparablePacket F (g : Real → Complex))

/-- The exact space-time Fourier multiplier formula for the literal spectral
tensor packet.  A Schwartz representative for the one-dimensional vertical
multiplier is the only regularity input. -/
theorem spaceTimeFourier_spectralRadialNormalPacket_of_schwartzProfile
    (β : Real → Complex) (scale : Real) (n : Int)
    (m g : SchwartzMap Real Complex)
    (hprofile : ∀ τ : Real, m τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : SchwartzMap (Euclidean 2) Complex) (ξ : Euclidean 2) (τ : Real) :
    spaceTimeFourier (spectralRadialNormalPacket β scale n F g) (ξ, τ) =
      verticalMultiplier β scale n (ξ, τ) *
        spaceTimeFourier (verticalSeparablePacket F (g : Real → Complex)) (ξ, τ) := by
  exact spaceTimeFourier_verticalProjection_verticalSeparablePacket_of_schwartzProfile
    β scale n m g hprofile F ξ τ

/-- Exact conic-plate support for a genuinely spectral Schwartz tensor
packet.  The normal condition is imposed on the joint spectral support;
there is deliberately no assertion for a compact physical-time cutoff. -/
theorem support_spaceTimeFourier_spectralRadialNormalPacket_subset_conicPlate
    (β : Real → Complex) (scale gamma angularConstant : Real) (n : Int)
    (direction : Euclidean 2)
    (m g : SchwartzMap Real Complex)
    (hprofile : ∀ τ : Real, m τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : SchwartzMap (Euclidean 2) Complex)
    (hspatial : Function.support (𝓕 (F : Euclidean 2 → Complex)) ⊆
      {ξ | scale / 4 ≤ ‖ξ‖ ∧ ‖ξ‖ ≤ 4 * scale ∧
        ξ ∈ angularSector direction (angularConstant * scale ^ (-(1 / 2 : Real)))})
    (hvertical : ∀ τ : Real,
      β ((Real.sqrt scale)⁻¹ * τ - n) ≠ 0 →
        |(Real.sqrt scale)⁻¹ * τ - n| ≤ 1)
    (hnormal : ∀ ξ : Euclidean 2,
      ξ ∈ Function.support (𝓕 (F : Euclidean 2 → Complex)) →
      ∀ τ : Real, τ ∈ Function.support (𝓕 (g : Real → Complex)) →
      β ((Real.sqrt scale)⁻¹ * τ - n) ≠ 0 →
        |τ - ‖ξ‖| ≤ 2 * scale ^ gamma) :
    Function.support (spaceTimeFourier (spectralRadialNormalPacket β scale n F g)) ⊆
      conicPlate scale gamma angularConstant n direction := by
  intro ζ hζ
  change spaceTimeFourier (spectralRadialNormalPacket β scale n F g) ζ ≠ 0 at hζ
  rw [spaceTimeFourier_spectralRadialNormalPacket_of_schwartzProfile
    β scale n m g hprofile F ζ.1 ζ.2] at hζ
  rw [verticalMultiplier, spaceTimeFourier_verticalSeparablePacket] at hζ
  rcases mul_ne_zero_iff.mp hζ with ⟨hβ, hproduct⟩
  rcases mul_ne_zero_iff.mp hproduct with ⟨hF, hg⟩
  rcases hspatial hF with ⟨hlower, hupper, hangular⟩
  exact ⟨hlower, hupper, hangular, hvertical ζ.2 hβ,
    hnormal ζ.1 hF ζ.2 hg hβ⟩

/-- A spectral radial/normal packet whose spatial frequency factor is an
actual Schwartz cube multiplier.  The physical spatial factor is its inverse
Fourier transform, so this model interfaces directly with the finite cube
cutoffs while remaining spectral in time. -/
noncomputable def spectralCubeRadialNormalPacket
    (β : Real → Complex) (scale : Real) (n : Int)
    (cubeProfile : SchwartzMap (Euclidean 2) Complex)
    (g : SchwartzMap Real Complex) : WaveSpaceTime → Complex :=
  spectralRadialNormalPacket β scale n
    (𝓕⁻ cubeProfile : SchwartzMap (Euclidean 2) Complex) g

/-- Exact Fourier formula for the spectral packet built from a literal
Schwartz cube multiplier. -/
theorem spaceTimeFourier_spectralCubeRadialNormalPacket_of_schwartzProfile
    (β : Real → Complex) (scale : Real) (n : Int)
    (temporalProfile g : SchwartzMap Real Complex)
    (hprofile : ∀ τ : Real, temporalProfile τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (cubeProfile : SchwartzMap (Euclidean 2) Complex) (ξ : Euclidean 2) (τ : Real) :
    spaceTimeFourier
        (spectralCubeRadialNormalPacket β scale n cubeProfile g) (ξ, τ) =
      β ((Real.sqrt scale)⁻¹ * τ - n) *
        (cubeProfile ξ * 𝓕 (g : Real → Complex) τ) := by
  rw [spectralCubeRadialNormalPacket,
    spaceTimeFourier_spectralRadialNormalPacket_of_schwartzProfile
      β scale n temporalProfile g hprofile]
  rw [verticalMultiplier, spaceTimeFourier_verticalSeparablePacket]
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]

/-- An actual spectral cube packet has exact conic-plate support once the
cube profile and temporal Schwartz profile obey the displayed radial,
angular, vertical, and normal support conditions. -/
theorem support_spaceTimeFourier_spectralCubeRadialNormalPacket_subset_conicPlate
    (β : Real → Complex) (scale gamma angularConstant : Real) (n : Int)
    (direction : Euclidean 2)
    (temporalProfile g : SchwartzMap Real Complex)
    (hprofile : ∀ τ : Real, temporalProfile τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (cubeProfile : SchwartzMap (Euclidean 2) Complex)
    (hspatial : Function.support (cubeProfile : Euclidean 2 → Complex) ⊆
      {ξ | scale / 4 ≤ ‖ξ‖ ∧ ‖ξ‖ ≤ 4 * scale ∧
        ξ ∈ angularSector direction (angularConstant * scale ^ (-(1 / 2 : Real)))})
    (hvertical : ∀ τ : Real,
      β ((Real.sqrt scale)⁻¹ * τ - n) ≠ 0 →
        |(Real.sqrt scale)⁻¹ * τ - n| ≤ 1)
    (hnormal : ∀ ξ : Euclidean 2,
      ξ ∈ Function.support (cubeProfile : Euclidean 2 → Complex) →
      ∀ τ : Real, τ ∈ Function.support (𝓕 (g : Real → Complex)) →
      β ((Real.sqrt scale)⁻¹ * τ - n) ≠ 0 →
        |τ - ‖ξ‖| ≤ 2 * scale ^ gamma) :
    Function.support
        (spaceTimeFourier (spectralCubeRadialNormalPacket β scale n cubeProfile g)) ⊆
      conicPlate scale gamma angularConstant n direction := by
  intro ζ hζ
  change spaceTimeFourier
      (spectralCubeRadialNormalPacket β scale n cubeProfile g) ζ ≠ 0 at hζ
  rw [spaceTimeFourier_spectralCubeRadialNormalPacket_of_schwartzProfile
    β scale n temporalProfile g hprofile cubeProfile ζ.1 ζ.2] at hζ
  rcases mul_ne_zero_iff.mp hζ with ⟨hβ, hproduct⟩
  rcases mul_ne_zero_iff.mp hproduct with ⟨hcube, hg⟩
  rcases hspatial hcube with ⟨hlower, hupper, hangular⟩
  exact ⟨hlower, hupper, hangular, hvertical ζ.2 hβ,
    hnormal ζ.1 hcube ζ.2 hg hβ⟩

/-- The preceding literal spectral packets supply the Fourier-support premise
used by `overlapSquareFunctionRawHypothesis`, simultaneously for a finite
radial/angular family. -/
theorem spectralCubeRadialNormalPackets_satisfy_conicPlateSupport
    (β : Real → Complex) (scale gamma angularConstant : Real)
    (radialIndices angularIndices : Finset Int) (directions : Int → Euclidean 2)
    (temporalProfiles g : Int → Int → SchwartzMap Real Complex)
    (cubeProfiles : Int → Int → SchwartzMap (Euclidean 2) Complex)
    (hprofile : ∀ n ∈ radialIndices, ∀ ν ∈ angularIndices, ∀ τ : Real,
      temporalProfiles n ν τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (hspatial : ∀ n ∈ radialIndices, ∀ ν ∈ angularIndices,
      Function.support (cubeProfiles n ν : Euclidean 2 → Complex) ⊆
        {ξ | scale / 4 ≤ ‖ξ‖ ∧ ‖ξ‖ ≤ 4 * scale ∧
          ξ ∈ angularSector (directions ν)
            (angularConstant * scale ^ (-(1 / 2 : Real)))})
    (hvertical : ∀ n ∈ radialIndices, ∀ τ : Real,
      β ((Real.sqrt scale)⁻¹ * τ - n) ≠ 0 →
        |(Real.sqrt scale)⁻¹ * τ - n| ≤ 1)
    (hnormal : ∀ n ∈ radialIndices, ∀ ν ∈ angularIndices,
      ∀ ξ : Euclidean 2,
      ξ ∈ Function.support (cubeProfiles n ν : Euclidean 2 → Complex) →
      ∀ τ : Real, τ ∈ Function.support (𝓕 (g n ν : Real → Complex)) →
      β ((Real.sqrt scale)⁻¹ * τ - n) ≠ 0 →
        |τ - ‖ξ‖| ≤ 2 * scale ^ gamma) :
    ∀ n ∈ radialIndices, ∀ ν ∈ angularIndices,
      Function.support
          (spaceTimeFourier
            (spectralCubeRadialNormalPacket β scale n (cubeProfiles n ν) (g n ν))) ⊆
        conicPlate scale gamma angularConstant n (directions ν) := by
  intro n hn ν hν
  exact support_spaceTimeFourier_spectralCubeRadialNormalPacket_subset_conicPlate
    β scale gamma angularConstant n (directions ν)
    (temporalProfiles n ν) (g n ν) (hprofile n hn ν hν)
    (cubeProfiles n ν) (hspatial n hn ν hν)
    (hvertical n hn) (hnormal n hn ν hν)

/-- The two-parameter square function used after wave-front localization. -/
noncomputable def angularRadialSquareFunction (radialIndices angularIndices : Finset Int)
    (H : Int → Int → WaveSpaceTime → Complex) : WaveSpaceTime → Real :=
  fun z => Real.sqrt (∑ n ∈ radialIndices, ∑ ν ∈ angularIndices, ‖H n ν z‖ ^ 2)

/- The next finite-index helpers are deliberately private.  They formulate the
underlying `ℓ²` calculation on an arbitrary finite index type, rather than
changing the existing `Int`-indexed vertical-square API. -/
private noncomputable def aux_finiteSquareFunction {ι : Type*} [DecidableEq ι]
    (indices : Finset ι) (H : ι → WaveSpaceTime → Complex) : WaveSpaceTime → Real :=
  fun z => Real.sqrt (∑ i ∈ indices, ‖H i z‖ ^ 2)

private theorem aux_finiteSquareFunction_eq_norm_piLp
    {ι : Type*} [DecidableEq ι]
    (indices : Finset ι) (H : ι → WaveSpaceTime → Complex)
    (z : WaveSpaceTime) :
    aux_finiteSquareFunction indices H z =
      ‖(WithLp.toLp 2 (fun i : (↥indices) => H i z) :
        PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex))‖ := by
  rw [PiLp.norm_eq_of_L2]
  change aux_finiteSquareFunction indices H z =
    Real.sqrt (∑ i : (↥indices), ‖H i z‖ ^ (2 : Nat))
  rw [Finset.sum_coe_sort indices (fun i => ‖H i z‖ ^ (2 : Nat))]
  rfl

private theorem aux_finiteSquareFunction_sub_le_sum_norm_tail
    {ι : Type*} [DecidableEq ι]
    (indices : Finset ι)
    (full main tail : ι → WaveSpaceTime → Complex)
    (hdecomp : ∀ i ∈ indices, ∀ z, full i z = main i z + tail i z)
    (z : WaveSpaceTime) :
    ‖aux_finiteSquareFunction indices full z -
        aux_finiteSquareFunction indices main z‖ ≤
      ∑ i ∈ indices, ‖tail i z‖ := by
  let F : PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex) :=
    WithLp.toLp 2 (fun i : (↥indices) => full i z)
  let M : PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex) :=
    WithLp.toLp 2 (fun i : (↥indices) => main i z)
  let T : PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex) :=
    WithLp.toLp 2 (fun i : (↥indices) => tail i z)
  let e : (↥indices) → PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex) :=
    fun i => PiLp.single 2 i (tail i z)
  have hFM : F = M + T := by
    dsimp [F, M, T]
    rw [← WithLp.toLp_add]
    congr 1
    funext i
    exact hdecomp i i.property z
  have hTsum : T = ∑ i : (↥indices), e i := by
    dsimp [T]
    rw [← WithLp.toLp_sum]
    congr 1
    ext i
    simp
  calc
    ‖aux_finiteSquareFunction indices full z -
        aux_finiteSquareFunction indices main z‖ = ‖‖F‖ - ‖M‖‖ := by
      rw [aux_finiteSquareFunction_eq_norm_piLp,
        aux_finiteSquareFunction_eq_norm_piLp]
    _ ≤ ‖F - M‖ := abs_norm_sub_norm_le _ _
    _ = ‖T‖ := by rw [hFM, add_sub_cancel_left]
    _ = ‖∑ i : (↥indices), e i‖ := by rw [hTsum]
    _ ≤ ∑ i : (↥indices), ‖e i‖ := by
      exact norm_sum_le (Finset.univ : Finset (↥indices)) e
    _ = ∑ i ∈ indices, ‖tail i z‖ := by
      simp only [e, PiLp.norm_single]
      exact Finset.sum_coe_sort indices (fun i => ‖tail i z‖)

private theorem aux_eLpNorm_four_finiteSquareFunction_sub_le_sum_of_eq_add_of_tail_bounds
    {ι : Type*} [DecidableEq ι]
    (indices : Finset ι)
    (full main tail : ι → WaveSpaceTime → Complex)
    (hdecomp : ∀ i ∈ indices, ∀ z, full i z = main i z + tail i z)
    (htailMeas : ∀ i ∈ indices, AEStronglyMeasurable (tail i) volume)
    (E : ι → ENNReal)
    (hE : ∀ i ∈ indices, eLpNorm (tail i) 4 volume ≤ E i) :
    eLpNorm (aux_finiteSquareFunction indices full -
      aux_finiteSquareFunction indices main) 4 volume ≤
        ∑ i ∈ indices, E i := by
  let G : WaveSpaceTime → Real := fun z => ∑ i ∈ indices, ‖tail i z‖
  have hGnonneg (z : WaveSpaceTime) : 0 ≤ G z := by
    exact Finset.sum_nonneg fun _ _ => norm_nonneg _
  have hmono (z : WaveSpaceTime) :
      ‖(aux_finiteSquareFunction indices full -
          aux_finiteSquareFunction indices main) z‖ ≤ ‖G z‖ := by
    change |(aux_finiteSquareFunction indices full -
      aux_finiteSquareFunction indices main) z| ≤ |G z|
    rw [abs_of_nonneg (hGnonneg z)]
    exact aux_finiteSquareFunction_sub_le_sum_norm_tail
      indices full main tail hdecomp z
  calc
    eLpNorm (aux_finiteSquareFunction indices full -
        aux_finiteSquareFunction indices main) 4 volume ≤ eLpNorm G 4 volume :=
      eLpNorm_mono hmono
    _ = eLpNorm (fun z => ∑ i ∈ indices, ‖tail i z‖) 4 volume := rfl
    _ = eLpNorm (∑ i ∈ indices, fun z => ‖tail i z‖) 4 volume := by
      congr 1
      funext z
      simp only [Finset.sum_apply]
    _ ≤ ∑ i ∈ indices, eLpNorm (fun z => ‖tail i z‖) 4 volume := by
      apply eLpNorm_sum_le
      · intro i hi
        exact (htailMeas i hi).norm
      · norm_num
    _ = ∑ i ∈ indices, eLpNorm (tail i) 4 volume := by
      apply Finset.sum_congr rfl
      intro i hi
      exact eLpNorm_norm (tail i)
    _ ≤ ∑ i ∈ indices, E i := by
      apply Finset.sum_le_sum
      intro i hi
      exact hE i hi

private theorem aux_angularRadialSquareFunction_eq_finiteSquareFunction_product
    (radialIndices angularIndices : Finset Int)
    (H : Int → Int → WaveSpaceTime → Complex) :
    angularRadialSquareFunction radialIndices angularIndices H =
      aux_finiteSquareFunction (radialIndices.product angularIndices)
        (fun i z => H i.1 i.2 z) := by
  funext z
  unfold angularRadialSquareFunction aux_finiteSquareFunction
  apply congrArg Real.sqrt
  exact (Finset.sum_product radialIndices angularIndices
    (fun i : Int × Int => ‖H i.1 i.2 z‖ ^ (2 : Nat))).symm

/-- A two-index finite square function is stable in `L⁴` under componentwise
additive tails.  This is an elementary finite `ℓ²`/Minkowski estimate, with no
square-function, continuum, or local-smoothing assertion. -/
theorem eLpNorm_four_angularRadialSquareFunction_sub_le_sum_of_eq_add_of_tail_bounds
    (radialIndices angularIndices : Finset Int)
    (full main tail : Int → Int → WaveSpaceTime → Complex)
    (hdecomp : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices, ∀ z,
      full n nu z = main n nu z + tail n nu z)
    (htailMeas : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      AEStronglyMeasurable (tail n nu) volume)
    (E : Int → Int → ENNReal)
    (hE : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      eLpNorm (tail n nu) 4 volume ≤ E n nu) :
    eLpNorm
        (angularRadialSquareFunction radialIndices angularIndices full -
          angularRadialSquareFunction radialIndices angularIndices main)
        4 volume ≤
      ∑ n ∈ radialIndices, ∑ nu ∈ angularIndices, E n nu := by
  let full' : Int × Int → WaveSpaceTime → Complex := fun i z => full i.1 i.2 z
  let main' : Int × Int → WaveSpaceTime → Complex := fun i z => main i.1 i.2 z
  let tail' : Int × Int → WaveSpaceTime → Complex := fun i z => tail i.1 i.2 z
  let E' : Int × Int → ENNReal := fun i => E i.1 i.2
  have hdecomp' : ∀ i ∈ radialIndices.product angularIndices, ∀ z,
      full' i z = main' i z + tail' i z := by
    intro i hi z
    obtain ⟨hn, hnu⟩ := Finset.mem_product.mp hi
    exact hdecomp i.1 hn i.2 hnu z
  have htailMeas' : ∀ i ∈ radialIndices.product angularIndices,
      AEStronglyMeasurable (tail' i) volume := by
    intro i hi
    obtain ⟨hn, hnu⟩ := Finset.mem_product.mp hi
    exact htailMeas i.1 hn i.2 hnu
  have hE' : ∀ i ∈ radialIndices.product angularIndices,
      eLpNorm (tail' i) 4 volume ≤ E' i := by
    intro i hi
    obtain ⟨hn, hnu⟩ := Finset.mem_product.mp hi
    exact hE i.1 hn i.2 hnu
  have hfinite := aux_eLpNorm_four_finiteSquareFunction_sub_le_sum_of_eq_add_of_tail_bounds
    (radialIndices.product angularIndices) full' main' tail' hdecomp' htailMeas' E' hE'
  have hfull : angularRadialSquareFunction radialIndices angularIndices full =
      aux_finiteSquareFunction (radialIndices.product angularIndices) full' := by
    dsimp only [full']
    exact aux_angularRadialSquareFunction_eq_finiteSquareFunction_product
      radialIndices angularIndices full
  have hmain : angularRadialSquareFunction radialIndices angularIndices main =
      aux_finiteSquareFunction (radialIndices.product angularIndices) main' := by
    dsimp only [main']
    exact aux_angularRadialSquareFunction_eq_finiteSquareFunction_product
      radialIndices angularIndices main
  rw [hfull, hmain]
  calc
    eLpNorm
        (aux_finiteSquareFunction (radialIndices.product angularIndices) full' -
          aux_finiteSquareFunction (radialIndices.product angularIndices) main')
        4 volume ≤
      ∑ i ∈ radialIndices.product angularIndices, E' i := hfinite
    _ = ∑ n ∈ radialIndices, ∑ nu ∈ angularIndices, E n nu := by
      dsimp only [E']
      exact Finset.sum_product radialIndices angularIndices (fun i : Int × Int => E i.1 i.2)

theorem aux_aestronglyMeasurable_angularRadialSquareFunction
    (radialIndices angularIndices : Finset Int)
    (H : Int → Int → WaveSpaceTime → Complex)
    (hH : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      AEStronglyMeasurable (H n nu) volume) :
    AEStronglyMeasurable
      (angularRadialSquareFunction radialIndices angularIndices H) volume := by
  unfold angularRadialSquareFunction
  apply Real.continuous_sqrt.comp_aestronglyMeasurable
  apply Finset.aestronglyMeasurable_fun_sum radialIndices
  intro n hn
  apply Finset.aestronglyMeasurable_fun_sum angularIndices
  intro nu hnu
  exact (hH n hn nu hnu).norm.pow 2

/-- The square function after recombining the angular pieces for each fixed
radial label.  It is the left-hand square function in the plate-overlap
consequence from the MSS blueprint. -/
noncomputable def aux_angularRadialRecombinedSquareFunction
    (radialIndices angularIndices : Finset Int)
    (H : Int → Int → WaveSpaceTime → Complex) : WaveSpaceTime → Real :=
  fun z => Real.sqrt (∑ n ∈ radialIndices, ‖∑ ν ∈ angularIndices, H n ν z‖ ^ 2)

/-- The finite recombined angular/radial square function is stable in `L⁴`
under componentwise additive tails.  This is a finite `ℓ²`/Minkowski estimate;
it does not assert a square-function estimate, a continuum limit, or local
smoothing. -/
theorem eLpNorm_four_aux_angularRadialRecombinedSquareFunction_sub_le_sum_of_eq_add_of_tail_bounds
    (radialIndices angularIndices : Finset Int)
    (full main tail : Int → Int → WaveSpaceTime → Complex)
    (hdecomp : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices, ∀ z,
      full n nu z = main n nu z + tail n nu z)
    (htailMeas : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      AEStronglyMeasurable (tail n nu) volume)
    (E : Int → Int → ENNReal)
    (hE : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      eLpNorm (tail n nu) 4 volume ≤ E n nu) :
    eLpNorm
        (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices full -
          aux_angularRadialRecombinedSquareFunction radialIndices angularIndices main)
        4 volume ≤ ∑ n ∈ radialIndices, ∑ nu ∈ angularIndices, E n nu := by
  let full' : Int → WaveSpaceTime → Complex :=
    fun n z => ∑ nu ∈ angularIndices, full n nu z
  let main' : Int → WaveSpaceTime → Complex :=
    fun n z => ∑ nu ∈ angularIndices, main n nu z
  let tail' : Int → WaveSpaceTime → Complex :=
    fun n z => ∑ nu ∈ angularIndices, tail n nu z
  let E' : Int → ENNReal := fun n => ∑ nu ∈ angularIndices, E n nu
  have hdecomp' : ∀ n ∈ radialIndices, ∀ z, full' n z = main' n z + tail' n z := by
    intro n hn z
    dsimp [full', main', tail']
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro nu hnu
    exact hdecomp n hn nu hnu z
  have htailMeas' : ∀ n ∈ radialIndices, AEStronglyMeasurable (tail' n) volume := by
    intro n hn
    dsimp [tail']
    apply Finset.aestronglyMeasurable_fun_sum angularIndices
    intro nu hnu
    exact htailMeas n hn nu hnu
  have hE' : ∀ n ∈ radialIndices, eLpNorm (tail' n) 4 volume ≤ E' n := by
    intro n hn
    have htail'_eq : tail' n = ∑ nu ∈ angularIndices, tail n nu := by
      funext z
      simp only [tail', Finset.sum_apply]
    rw [htail'_eq]
    dsimp only [E']
    calc
      eLpNorm (∑ nu ∈ angularIndices, tail n nu) 4 volume ≤
          ∑ nu ∈ angularIndices, eLpNorm (tail n nu) 4 volume := by
        apply eLpNorm_sum_le
        · intro nu hnu
          exact htailMeas n hn nu hnu
        · norm_num
      _ ≤ ∑ nu ∈ angularIndices, E n nu := by
        apply Finset.sum_le_sum
        intro nu hnu
        exact hE n hn nu hnu
  have hvertical := eLpNorm_four_verticalSquareFunction_sub_le_sum_of_eq_add_of_tail_bounds
    radialIndices full' main' tail' hdecomp' htailMeas' E' hE'
  have hfull : aux_angularRadialRecombinedSquareFunction radialIndices angularIndices full =
      verticalSquareFunction radialIndices full' := by
    rfl
  have hmain : aux_angularRadialRecombinedSquareFunction radialIndices angularIndices main =
      verticalSquareFunction radialIndices main' := by
    rfl
  rw [hfull, hmain]
  simpa only [E'] using hvertical

private theorem aux_aestronglyMeasurable_aux_angularRadialRecombinedSquareFunction
    (radialIndices angularIndices : Finset Int)
    (H : Int → Int → WaveSpaceTime → Complex)
    (hH : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      AEStronglyMeasurable (H n nu) volume) :
    AEStronglyMeasurable
      (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices H) volume := by
  unfold aux_angularRadialRecombinedSquareFunction
  apply Real.continuous_sqrt.comp_aestronglyMeasurable
  apply Finset.aestronglyMeasurable_fun_sum radialIndices
  intro n hn
  apply AEStronglyMeasurable.pow
  apply AEStronglyMeasurable.norm
  apply Finset.aestronglyMeasurable_fun_sum angularIndices
  intro nu hnu
  exact hH n hn nu hnu

theorem aux_eLpNorm_aux_angularRadialRecombinedSquareFunction_full_le_main_add_sum_tails
    (radialIndices angularIndices : Finset Int)
    (full main tail : Int → Int → WaveSpaceTime → Complex)
    (hdecomp : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices, ∀ z,
      full n nu z = main n nu z + tail n nu z)
    (hmainMeas : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      AEStronglyMeasurable (main n nu) volume)
    (htailMeas : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      AEStronglyMeasurable (tail n nu) volume)
    (E : Int → Int → ENNReal)
    (hE : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      eLpNorm (tail n nu) 4 volume ≤ E n nu) :
    eLpNorm
        (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices full)
        4 volume ≤
      eLpNorm
          (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices main)
          4 volume + ∑ n ∈ radialIndices, ∑ nu ∈ angularIndices, E n nu := by
  have hfullMeas : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      AEStronglyMeasurable (full n nu) volume := by
    intro n hn nu hnu
    exact ((hmainMeas n hn nu hnu).add (htailMeas n hn nu hnu)).congr
      (Filter.Eventually.of_forall fun z => (hdecomp n hn nu hnu z).symm)
  have hfullRec := aux_aestronglyMeasurable_aux_angularRadialRecombinedSquareFunction
    radialIndices angularIndices full hfullMeas
  have hmainRec := aux_aestronglyMeasurable_aux_angularRadialRecombinedSquareFunction
    radialIndices angularIndices main hmainMeas
  have htriangle :
      eLpNorm
          (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices full)
          4 volume ≤
        eLpNorm
            (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices full -
              aux_angularRadialRecombinedSquareFunction radialIndices angularIndices main)
            4 volume +
          eLpNorm
            (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices main)
            4 volume := by
    calc
      eLpNorm
          (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices full)
          4 volume =
          eLpNorm
            ((aux_angularRadialRecombinedSquareFunction radialIndices angularIndices full -
              aux_angularRadialRecombinedSquareFunction radialIndices angularIndices main) +
              aux_angularRadialRecombinedSquareFunction radialIndices angularIndices main)
            4 volume := by
          congr 1
          funext z
          simp only [Pi.sub_apply, Pi.add_apply]
          abel
      _ ≤ _ := eLpNorm_add_le (hfullRec.sub hmainRec) hmainRec (by norm_num)
  calc
    eLpNorm
        (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices full)
        4 volume ≤
      eLpNorm
          (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices full -
            aux_angularRadialRecombinedSquareFunction radialIndices angularIndices main)
          4 volume +
        eLpNorm
          (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices main)
          4 volume := htriangle
    _ ≤ (∑ n ∈ radialIndices, ∑ nu ∈ angularIndices, E n nu) +
        eLpNorm
          (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices main)
          4 volume := by
      gcongr
      exact eLpNorm_four_aux_angularRadialRecombinedSquareFunction_sub_le_sum_of_eq_add_of_tail_bounds
        radialIndices angularIndices full main tail hdecomp htailMeas E hE
    _ = _ := add_comm _ _

/-- The vector-valued estimate removing vertical projections from a finite
joint-Schwartz radial/angular family.  This is the common-positive-time-kernel
Minkowski step in the MSS blueprint.  The Schwartz cutoff is exactly the
regularity needed to construct its integrable inverse-Fourier kernel. -/
def removeVerticalProjections (beta : SchwartzMap Real Complex) : Prop :=
  ∃ C : Real, 0 < C ∧ ∀ scale : Real, 2 ≤ scale →
    ∀ radialIndices angularIndices : Finset Int,
      ∀ H : Int → Int → SchwartzMap JointWaveSpaceTime Complex,
        eLpNorm
            (angularRadialSquareFunction radialIndices angularIndices
              (fun n ν => verticalProjection (beta : Real → Complex) scale n
                (jointSchwartzRaw (H n ν))))
            (4 : ENNReal) volume ≤
          ENNReal.ofReal C *
            eLpNorm (angularRadialSquareFunction radialIndices angularIndices
              (fun n ν => jointSchwartzRaw (H n ν)))
              (4 : ENNReal) volume

/-- The radial, angular, and vertically localized half-wave summand before
wave-front projection. -/
noncomputable def angularRadialWave (verticalCutoff radialCutoff : Real → Complex)
    (angularCutoff : Int → Euclidean 2 → Complex) (scale : Real)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex) (n ν : Int)
    (f : Euclidean 2 → Complex) : WaveSpaceTime → Complex :=
  verticalProjection verticalCutoff scale n
    (angularPiece scale a (angularCutoff ν) ϑ
      (radialPiece radialCutoff scale n f))

/-- The wave-front projected version of an angular/radial half-wave summand. -/
noncomputable def wavefrontAngularRadialWave
    (verticalCutoff radialCutoff : Real → Complex)
    (angularCutoff wavefrontCutoff : Int → Euclidean 2 → Complex)
    (normalCutoff : Real → Complex) (scale gamma : Real)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex) (n ν : Int)
    (f : Euclidean 2 → Complex) : WaveSpaceTime → Complex :=
  wavefrontProjection (wavefrontCutoff ν) normalCutoff scale gamma
    (angularRadialWave verticalCutoff radialCutoff angularCutoff scale a ϑ n ν f)

/-- The scale-indexed cutoff and geometry data in the wave-front localization
lemma.  The angular partition genuinely depends on the scale: its aperture is
of order `scale⁻¹ᐟ²`. -/
structure MSSWavefrontCutoffData where
  radialTime : MSSRadialTimeCutoffs
  angularConstant : Real
  angularConstant_pos : 0 < angularConstant
  angularIndices : Real → Finset Int
  directions : Real → Int → Euclidean 2
  chi : Real → Int → Euclidean 2 → Complex
  tildeChi : Real → Int → Euclidean 2 → Complex
  normal : SchwartzMap Real Complex
  angular_card : ∃ C_a : Real, 0 < C_a ∧ ∀ scale : Real, 2 ≤ scale →
    ((angularIndices scale).card : Real) ≤ C_a * Real.sqrt scale
  direction_unit : ∀ scale : Real, ∀ nu ∈ angularIndices scale,
    ‖directions scale nu‖ = 1
  chi_support : ∀ scale : Real, ∀ nu ∈ angularIndices scale,
    Function.support (chi scale nu) ⊆
      angularSector (directions scale nu)
        (angularConstant * scale ^ (-(1 / 2 : Real)))
  tildeChi_support : ∀ scale : Real, ∀ nu ∈ angularIndices scale,
    Function.support (tildeChi scale nu) ⊆
      angularSector (directions scale nu)
        (angularConstant * scale ^ (-(1 / 2 : Real)))
  tildeChi_one_on_chi_support : ∀ scale : Real, ∀ nu ∈ angularIndices scale,
    ∀ xi : Euclidean 2, chi scale nu xi ≠ 0 → tildeChi scale nu xi = 1
  normal_tsupport_subset : tsupport (normal : Real → Complex) ⊆ Set.Ioo (-2) 2
  normal_support : ∀ s : Real, normal s ≠ 0 → |s| < 2
  normal_one_on_unit : ∀ s : Real, |s| ≤ 1 → normal s = 1

/-- Smooth packet data used internally by wave-front localization.  These are
cutoff/profile data, rather than a postulated residual or operator estimate. -/
structure MSSWavefrontKernelData extends MSSWavefrontCutoffData where
  gamma : Real
  gamma_pos : 0 < gamma
  gamma_lt_tenth : gamma < 1 / 10
  spatialProfile : Real → Int → Int → SchwartzMap (Euclidean 2) Complex
  spatialProfile_apply : ∀ scale n nu xi,
    spatialProfile scale n nu xi =
      chi scale nu xi *
        (radialTime.amplitude (scale⁻¹ • xi) *
          radialTime.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n))
  normalCoordinate : Real → SchwartzMap (Euclidean 2) Real
  normalCoordinate_apply : ∀ scale xi,
    normalCoordinate scale xi =
      scale * radialTime.normalExtension (scale⁻¹ • xi)
  normalTail : Real → SchwartzMap Real Complex
  normalTail_apply : ∀ scale u,
    normalTail scale u =
      ((1 : Complex) - normal (scale ^ (-gamma) * u)) *
        FourierTransform.fourier (radialTime.time : Real → Complex) u

/-- Global Schwartz realizations of the raw radial and enlarged angular
profiles.  The radial identity is required only at positive scale, which is
the natural domain of the radial normalization and of every localization
consumer.  These realizations are the exact raw-to-joint bridge needed for
the literal Fourier calculations; no localization conclusion is included in
this data. -/
structure MSSWavefrontRawProfileRealization (D : MSSWavefrontKernelData) where
  radialProfile : Real → Int → SchwartzMap (Euclidean 2) Complex
  radialProfile_apply : ∀ scale n, 0 < scale → ∀ xi,
    radialProfile scale n xi =
      D.radialTime.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n)
  wavefrontAngularProfile : Real → Int → SchwartzMap (Euclidean 2) Complex
  wavefrontAngularProfile_eq_on_spatial : ∀ scale n nu xi,
    D.spatialProfile scale n nu xi ≠ 0 →
      wavefrontAngularProfile scale nu xi = D.tildeChi scale nu xi

/-- The only nonautomatic regularity hypothesis in the localization result:
for each finite derivative order, the scale-indexed spatial profiles have an
`L¹` bound with some polynomial scale loss. -/
structure MSSWavefrontSpatialProfilePolynomialRegularity
    (D : MSSWavefrontKernelData) where
  spatialExponent : Nat → Nat
  derivative_l1 : ∀ r : Nat, ∃ A : Real, 0 ≤ A ∧
    ∀ (scale : Real) (n nu : Int), 2 ≤ scale →
      n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
      (∫ xi : Euclidean 2,
        ‖iteratedFDeriv Real r
          (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖) ≤
        A * scale ^ spatialExponent r

/-- The literal scale-indexed angular/radial summand determined by the cutoff
data. -/
noncomputable def mssAngularRadialWave (D : MSSWavefrontCutoffData)
    (scale : Real) (n nu : Int) (f : Euclidean 2 → Complex) :
    WaveSpaceTime → Complex :=
  angularRadialWave (D.radialTime.vertical : Real → Complex)
    (D.radialTime.radial : Real → Complex) (D.chi scale) scale
    (D.radialTime.amplitude : Euclidean 2 → Complex)
    (D.radialTime.time : Real → Complex) n nu f

/-- The corresponding literal wave-front projection, using the enlarged
scale-indexed angular cutoff and fixed normal cutoff. -/
noncomputable def mssWavefrontAngularRadialWave
    (D : MSSWavefrontCutoffData) (scale gamma : Real) (n nu : Int)
    (f : Euclidean 2 → Complex) : WaveSpaceTime → Complex :=
  wavefrontProjection (D.tildeChi scale nu) (D.normal : Real → Complex) scale gamma
    (mssAngularRadialWave D scale n nu f)

/-- The rapid `L⁴` square-function error clause of wave-front localization.
The radial family is the canonical relevant enumeration from the blueprint. -/
def wavefrontLocalizationError (D : MSSWavefrontCutoffData) (gamma : Real) : Prop :=
  0 < gamma → gamma < 1 / 10 →
  ∀ N : Nat, 1 ≤ N → ∃ C : Real, 0 < C ∧ ∀ scale : Real, 2 ≤ scale →
    ∀ f : SchwartzMap (Euclidean 2) Complex,
      eLpNorm
          (angularRadialSquareFunction (relevantRadialIndexEnumeration scale)
            (D.angularIndices scale)
            (fun n nu => fun z =>
              mssAngularRadialWave D scale n nu (f : Euclidean 2 → Complex) z -
                mssWavefrontAngularRadialWave D scale gamma n nu
                  (f : Euclidean 2 → Complex) z))
          (4 : ENNReal) volume ≤
        ENNReal.ofReal (C * (scale⁻¹) ^ N) *
          eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume

/-- The Fourier-support clause of wave-front localization, restricted to the
active radial and angular index families. -/
def wavefrontPlateSupport (D : MSSWavefrontCutoffData) (gamma : Real) : Prop :=
  ∀ scale : Real, 2 ≤ scale → ∀ n nu : Int,
    n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
    ∀ f : SchwartzMap (Euclidean 2) Complex,
      Function.support
          (spaceTimeFourier
            (mssWavefrontAngularRadialWave D scale gamma n nu
              (f : Euclidean 2 → Complex))) ⊆
        conicPlate scale gamma D.angularConstant n (D.directions scale nu)

/-- The two blueprint clauses of wave-front localization. -/
def wavefrontLocalization (D : MSSWavefrontCutoffData) (gamma : Real) : Prop :=
  wavefrontLocalizationError D gamma ∧ wavefrontPlateSupport D gamma

/- Private proof machinery for the active wave-front-localization item. -/
open scoped BigOperators

private noncomputable def scratchWavefrontVerticalProfile
    (D : MSSWavefrontKernelData) (scale : Real) (n : Int)
    (hscale : 0 < scale) : SchwartzMap Real Complex :=
  let root : Real := Real.sqrt scale
  let A : Real ≃L[Real] Real :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 root⁻¹ (by
        dsimp only [root]
        exact inv_ne_zero (Real.sqrt_ne_zero'.mpr hscale)))
  ((SchwartzMap.compCLMOfContinuousLinearEquiv Complex A) D.radialTime.vertical).compSubConstCLM
    Complex (root * n)

private theorem scratchWavefrontVerticalProfile_apply
    (D : MSSWavefrontKernelData) (scale : Real) (n : Int)
    (hscale : 0 < scale) (tau : Real) :
    scratchWavefrontVerticalProfile D scale n hscale tau =
      D.radialTime.vertical ((Real.sqrt scale)⁻¹ * tau - n) := by
  unfold scratchWavefrontVerticalProfile
  dsimp
  change D.radialTime.vertical
      ((Real.sqrt scale)⁻¹ * (tau - Real.sqrt scale * n)) = _
  have hroot : Real.sqrt scale ≠ 0 := Real.sqrt_ne_zero'.mpr hscale
  field_simp [hroot]

private def scratchWavefrontJointVerticalFactor
    (m : SchwartzMap Real Complex) : JointWaveSpaceTime → Complex :=
  fun z => m z.snd

private theorem scratchWavefrontJointVerticalFactor_hasTemperateGrowth
    (m : SchwartzMap Real Complex) :
    (scratchWavefrontJointVerticalFactor m).HasTemperateGrowth := by
  change (m ∘ WithLp.sndL 2 Real (Euclidean 2) Real).HasTemperateGrowth
  exact m.hasTemperateGrowth.comp
    (WithLp.sndL 2 Real (Euclidean 2) Real).hasTemperateGrowth

private noncomputable def scratchWavefrontApplyVertical
    (m : SchwartzMap Real Complex)
    (Q : SchwartzMap JointWaveSpaceTime Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  SchwartzMap.smulLeftCLM Complex (scratchWavefrontJointVerticalFactor m) Q

private theorem scratchWavefrontApplyVertical_apply
    (m : SchwartzMap Real Complex)
    (Q : SchwartzMap JointWaveSpaceTime Complex) (zeta : WaveSpaceTime) :
    scratchWavefrontApplyVertical m Q (WithLp.toLp 2 zeta) =
      m zeta.2 * Q (WithLp.toLp 2 zeta) := by
  unfold scratchWavefrontApplyVertical
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (scratchWavefrontJointVerticalFactor_hasTemperateGrowth m)]
  rfl

/-- The f-independent error multiplier for one canonical `(n,ν)` packet.
It is a genuine joint Schwartz multiplier; the input Fourier transform is
not part of this definition. -/
private noncomputable def scratchWavefrontPacketResidualMultiplier
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale)
    (n nu : Int) : SchwartzMap JointWaveSpaceTime Complex :=
  scratchWavefrontApplyVertical
    (scratchWavefrontVerticalProfile D scale n hscale)
    (jointSchwartzModulatedAnnularProfile
      (D.spatialProfile scale n nu)
      (FourierTransform.fourierInv (D.normalTail scale))
      (D.normalCoordinate scale))

/-- Literal formula for the f-independent residual multiplier. -/
private theorem scratchWavefrontPacketResidualMultiplier_apply
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale)
    (n nu : Int) (zeta : WaveSpaceTime) :
    scratchWavefrontPacketResidualMultiplier D scale hscale n nu
        (WithLp.toLp 2 zeta) =
      D.radialTime.vertical ((Real.sqrt scale)⁻¹ * zeta.2 - n) *
        (D.spatialProfile scale n nu zeta.1 *
          D.normalTail scale (zeta.2 - D.normalCoordinate scale zeta.1)) := by
  unfold scratchWavefrontPacketResidualMultiplier
  rw [scratchWavefrontApplyVertical_apply,
    scratchWavefrontVerticalProfile_apply,
    jointSchwartzModulatedAnnularProfile_apply]
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]

/-- On the support of the compact spatial packet, the auxiliary normal
coordinate is the literal Euclidean norm. -/
private theorem normalCoordinate_eq_norm_on_spatial_support
    (D : MSSWavefrontKernelData) {scale : Real} (hscale : 0 < scale)
    (n nu : Int) {xi : Euclidean 2}
    (hxi : D.spatialProfile scale n nu xi ≠ 0) :
    D.normalCoordinate scale xi = ‖xi‖ := by
  rw [D.spatialProfile_apply] at hxi
  rcases mul_ne_zero_iff.mp hxi with ⟨_, hxi⟩
  rcases mul_ne_zero_iff.mp hxi with ⟨hamp, _⟩
  rw [D.normalCoordinate_apply,
    D.radialTime.normalExtension_eq_norm_on_amplitude
      (scale⁻¹ • xi) hamp,
    norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hscale)]
  field_simp [hscale.ne']

/-- On an active spatial packet the multiplier is exactly the normal-cutoff
defect times the expected vertical, angular, radial, amplitude, and temporal
Fourier factors.  This is the raw `(n,ν)` factorization needed before kernel
estimates. -/
private theorem scratchWavefrontPacketResidualMultiplier_apply_on_spatial_support
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale)
    (n nu : Int) (zeta : WaveSpaceTime)
    (hspatial : D.spatialProfile scale n nu zeta.1 ≠ 0) :
    scratchWavefrontPacketResidualMultiplier D scale hscale n nu
        (WithLp.toLp 2 zeta) =
      D.radialTime.vertical ((Real.sqrt scale)⁻¹ * zeta.2 - n) *
        (D.chi scale nu zeta.1 *
          (D.radialTime.amplitude (scale⁻¹ • zeta.1) *
            (D.radialTime.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n) *
              (((1 : Complex) - D.normal
                (scale ^ (-D.gamma) * (zeta.2 - ‖zeta.1‖))) *
                FourierTransform.fourier (D.radialTime.time : Real → Complex)
                  (zeta.2 - ‖zeta.1‖)))) ) := by
  rw [scratchWavefrontPacketResidualMultiplier_apply,
    normalCoordinate_eq_norm_on_spatial_support D hscale n nu hspatial,
    D.normalTail_apply,
    D.spatialProfile_apply]
  ring

/-- The literal spectral error operator associated with the f-independent
packet multiplier.  This is the actual `f → space-time` object for the
kernel route, before its convolution representation is invoked. -/
private noncomputable def scratchWavefrontPacketResidual
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale)
    (n nu : Int) (f : SchwartzMap (Euclidean 2) Complex) :
    WaveSpaceTime → Complex :=
  spaceTimeFourierInv (fun zeta : WaveSpaceTime =>
    jointSchwartzRaw (scratchWavefrontPacketResidualMultiplier D scale hscale n nu) zeta *
      FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1)

/-- The residual definition exposes the intended f-independent Fourier
factorization pointwise, with no operator-norm hypothesis. -/
private theorem scratchWavefrontPacketResidual_eq_inverse_factorizedSpectrum
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale)
    (n nu : Int) (f : SchwartzMap (Euclidean 2) Complex) :
    scratchWavefrontPacketResidual D scale hscale n nu f =
      spaceTimeFourierInv (fun zeta : WaveSpaceTime =>
        jointSchwartzRaw (scratchWavefrontPacketResidualMultiplier D scale hscale n nu) zeta *
          FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1) := rfl

private noncomputable def wfVerticalProfile
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) : SchwartzMap Real Complex :=
  let root : Real := Real.sqrt scale
  let A : Real ≃L[Real] Real :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 root⁻¹ (by
        dsimp only [root]
        exact inv_ne_zero (Real.sqrt_ne_zero'.mpr hscale)))
  ((SchwartzMap.compCLMOfContinuousLinearEquiv Complex A) beta).compSubConstCLM
    Complex (root * n)

private theorem wfVerticalProfile_apply
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) (tau : Real) :
    wfVerticalProfile beta scale n hscale tau =
      beta ((Real.sqrt scale)⁻¹ * tau - n) := by
  unfold wfVerticalProfile
  dsimp
  change beta ((Real.sqrt scale)⁻¹ * (tau - Real.sqrt scale * n)) = _
  have hroot : Real.sqrt scale ≠ 0 := Real.sqrt_ne_zero'.mpr hscale
  field_simp [hroot]

private noncomputable def wfNormalProfile
    (normal : SchwartzMap Real Complex) (scale gamma : Real)
    (hscale : 0 < scale) : SchwartzMap Real Complex :=
  let A : Real ≃L[Real] Real :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 (scale ^ (-gamma))
        (ne_of_gt (Real.rpow_pos_of_pos hscale _)))
  (SchwartzMap.compCLMOfContinuousLinearEquiv Complex A) normal

private theorem wfNormalProfile_apply
    (normal : SchwartzMap Real Complex) (scale gamma : Real)
    (hscale : 0 < scale) (s : Real) :
    wfNormalProfile normal scale gamma hscale s =
      normal (scale ^ (-gamma) * s) := by
  unfold wfNormalProfile
  dsimp
  rfl

/-- Regular data for one literal angular--radial half-wave packet. -/
private structure WFAngularRadialProfiles
    (D : MSSRadialTimeCutoffs) (scale : Real) (n : Int)
    (chi tildeChi : Euclidean 2 → Complex)
    (f : SchwartzMap (Euclidean 2) Complex) where
  radial : SchwartzMap (Euclidean 2) Complex
  spatial : SchwartzMap (Euclidean 2) Complex
  normalExtension : SchwartzMap (Euclidean 2) Real
  wavefrontAngular : SchwartzMap (Euclidean 2) Complex
  radial_eq : ∀ xi : Euclidean 2,
    radial xi = D.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n)
  spatial_eq : ∀ xi : Euclidean 2,
    spatial xi = chi xi * D.amplitude (scale⁻¹ • xi) *
      (radial xi * FourierTransform.fourier (f : Euclidean 2 → Complex) xi)
  normal_eq_norm : ∀ xi ∈ Function.support (spatial : Euclidean 2 → Complex),
    normalExtension xi = ‖xi‖
  wavefrontAngular_eq : ∀ xi ∈ Function.support (spatial : Euclidean 2 → Complex),
    wavefrontAngular xi = tildeChi xi

private def wfJointTemporalMultiplier
    (m : SchwartzMap Real Complex) : JointWaveSpaceTime → Complex :=
  fun z => m z.snd

private theorem wfJointTemporalMultiplier_hasTemperateGrowth
    (m : SchwartzMap Real Complex) :
    (wfJointTemporalMultiplier m).HasTemperateGrowth := by
  change (m ∘ WithLp.sndL 2 Real (Euclidean 2) Real).HasTemperateGrowth
  exact m.hasTemperateGrowth.comp
    (WithLp.sndL 2 Real (Euclidean 2) Real).hasTemperateGrowth

private noncomputable def wfApplyVerticalSpectrum
    (m : SchwartzMap Real Complex)
    (Q : SchwartzMap JointWaveSpaceTime Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  SchwartzMap.smulLeftCLM Complex (wfJointTemporalMultiplier m) Q

private theorem wfApplyVerticalSpectrum_apply
    (m : SchwartzMap Real Complex)
    (Q : SchwartzMap JointWaveSpaceTime Complex) (zeta : WaveSpaceTime) :
    wfApplyVerticalSpectrum m Q (WithLp.toLp 2 zeta) =
      m zeta.2 * Q (WithLp.toLp 2 zeta) := by
  unfold wfApplyVerticalSpectrum
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (wfJointTemporalMultiplier_hasTemperateGrowth m)]
  unfold wfJointTemporalMultiplier
  rfl

private noncomputable def wfBaseSpectrum
    (D : MSSRadialTimeCutoffs) {scale : Real} {n : Int}
    {chi tildeChi : Euclidean 2 → Complex} {f : SchwartzMap (Euclidean 2) Complex}
    (P : WFAngularRadialProfiles D scale n chi tildeChi f) :
    SchwartzMap JointWaveSpaceTime Complex :=
  jointSchwartzModulatedAnnularProfile P.spatial D.time P.normalExtension

private noncomputable def wfSourceSpectrum
    (D : MSSRadialTimeCutoffs) (scale : Real) (n : Int) (hscale : 0 < scale)
    {chi tildeChi : Euclidean 2 → Complex} {f : SchwartzMap (Euclidean 2) Complex}
    (P : WFAngularRadialProfiles D scale n chi tildeChi f) :
    SchwartzMap JointWaveSpaceTime Complex :=
  wfApplyVerticalSpectrum (wfVerticalProfile D.vertical scale n hscale)
    (wfBaseSpectrum D P)

private noncomputable def wfSourceJointSchwartz
    (D : MSSRadialTimeCutoffs) (scale : Real) (n : Int) (hscale : 0 < scale)
    {chi tildeChi : Euclidean 2 → Complex} {f : SchwartzMap (Euclidean 2) Complex}
    (P : WFAngularRadialProfiles D scale n chi tildeChi f) :
    SchwartzMap JointWaveSpaceTime Complex :=
  FourierTransform.fourierInv (wfSourceSpectrum D scale n hscale P)

private noncomputable def wfWavefrontJointCutoff
    (normal : SchwartzMap Real Complex) (scale gamma : Real) (hscale : 0 < scale)
    {D : MSSRadialTimeCutoffs} {n : Int}
    {chi tildeChi : Euclidean 2 → Complex} {f : SchwartzMap (Euclidean 2) Complex}
    (P : WFAngularRadialProfiles D scale n chi tildeChi f) :
    SchwartzMap JointWaveSpaceTime Complex :=
  jointSchwartzSpatialNormalCutoff P.wavefrontAngular
    (wfNormalProfile normal scale gamma hscale) P.normalExtension

/-- The exact joint-Schwartz frequency residual used by the raw packet
factorization.  This is public in the scratch bridge so later kernel work can
compare it directly with an f-independent multiplier. -/
private noncomputable def wfResidualSpectrum
    (D : MSSRadialTimeCutoffs) (normal : SchwartzMap Real Complex)
    (scale gamma : Real) (n : Int) (hscale : 0 < scale)
    {chi tildeChi : Euclidean 2 → Complex} {f : SchwartzMap (Euclidean 2) Complex}
    (P : WFAngularRadialProfiles D scale n chi tildeChi f) :
    SchwartzMap JointWaveSpaceTime Complex :=
  wfSourceSpectrum D scale n hscale P -
    jointSchwartzSpectralCutoffProduct
      (wfWavefrontJointCutoff normal scale gamma hscale P)
      (wfSourceJointSchwartz D scale n hscale P)

/-- Before the vertical window is applied, the literal raw angular/radial
packet is the inverse joint Fourier transform of its supplied Schwartz
spectrum. -/
private theorem wfBasePhysical_eq_angularPiece
    (D : MSSRadialTimeCutoffs) (scale : Real) (n : Int)
    (chi tildeChi : Euclidean 2 → Complex)
    (f : SchwartzMap (Euclidean 2) Complex)
    (P : WFAngularRadialProfiles D scale n chi tildeChi f) :
    jointSchwartzRaw (FourierTransform.fourierInv (wfBaseSpectrum D P)) =
      angularPiece scale (D.amplitude : Euclidean 2 → Complex) chi
        (D.time : Real → Complex)
        (radialPiece (D.radial : Real → Complex) scale n
          (f : Euclidean 2 → Complex)) := by
  funext z
  calc
    jointSchwartzRaw (FourierTransform.fourierInv (wfBaseSpectrum D P)) z =
        spaceTimeFourierInv (jointSchwartzRaw (wfBaseSpectrum D P)) z := by
          simpa only [jointSchwartzRaw, SchwartzMap.fourierInv_coe] using
            (spaceTimeFourierInv_jointSchwartzRaw (wfBaseSpectrum D P) z).symm
    _ = (fun z : WaveSpaceTime =>
        D.time z.2 * FourierTransform.fourierInv (fun xi : Euclidean 2 =>
          P.spatial xi * halfWaveMultiplier WaveSign.plus z.2 xi) z.1) z := by
          unfold wfBaseSpectrum
          exact spaceTimeFourierInv_jointSchwartzModulatedAnnularProfile_eq_halfWave_of_eq_norm_on_support
            P.spatial D.time P.normalExtension P.normal_eq_norm z
    _ = angularPiece scale (D.amplitude : Euclidean 2 → Complex) chi
        (D.time : Real → Complex)
        (radialPiece (D.radial : Real → Complex) scale n
          (f : Euclidean 2 → Complex)) z := by
          exact congrFun
            (temporalSchwartzHalfWave_eq_angularPiece_of_schwartzRadialProfile
              P.spatial P.radial f D.time scale (D.amplitude : Euclidean 2 → Complex)
              chi (D.radial : Real → Complex) n P.radial_eq P.spatial_eq) z

/-- Applying a literal vertical window to an inverse joint-Schwartz spectrum
is again an inverse joint-Schwartz spectrum, with its exact affine temporal
factor. -/
private theorem wf_verticalProjection_eq_jointSchwartzRaw
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) (Q : SchwartzMap JointWaveSpaceTime Complex) :
    verticalProjection (beta : Real → Complex) scale n
        (jointSchwartzRaw (FourierTransform.fourierInv Q)) =
      jointSchwartzRaw (FourierTransform.fourierInv
        (wfApplyVerticalSpectrum (wfVerticalProfile beta scale n hscale) Q)) := by
  let m : SchwartzMap Real Complex := wfVerticalProfile beta scale n hscale
  let P : SchwartzMap JointWaveSpaceTime Complex := wfApplyVerticalSpectrum m Q
  have hmult :
      (fun zeta : WaveSpaceTime =>
        verticalMultiplier (beta : Real → Complex) scale n zeta *
          spaceTimeFourier (jointSchwartzRaw (FourierTransform.fourierInv Q)) zeta) =
        jointSchwartzRaw P := by
    funext zeta
    rw [spaceTimeFourier_jointSchwartzRaw]
    change verticalMultiplier (beta : Real → Complex) scale n zeta *
        FourierTransform.fourier
          (FourierTransform.fourierInv Q : JointWaveSpaceTime → Complex)
          (WithLp.toLp 2 zeta) = P (WithLp.toLp 2 zeta)
    rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
    dsimp only [P, m]
    rw [wfApplyVerticalSpectrum_apply, wfVerticalProfile_apply]
    rfl
  unfold verticalProjection
  rw [hmult]
  funext z
  simpa only [P, jointSchwartzRaw, SchwartzMap.fourierInv_coe] using
    (spaceTimeFourierInv_jointSchwartzRaw P z)

/-- The full literal angular/radial/vertical wave has a genuine
joint-Schwartz representative. -/
private theorem angularRadialWave_eq_jointSchwartzRaw_of_profiles
    (D : MSSRadialTimeCutoffs) (scale : Real) (n : Int)
    (angularCutoff wavefrontCutoff : Int → Euclidean 2 → Complex) (nu : Int)
    (f : SchwartzMap (Euclidean 2) Complex) (hscale : 0 < scale)
    (P : WFAngularRadialProfiles D scale n (angularCutoff nu) (wavefrontCutoff nu) f) :
    angularRadialWave (D.vertical : Real → Complex) (D.radial : Real → Complex)
        angularCutoff scale (D.amplitude : Euclidean 2 → Complex) (D.time : Real → Complex) n nu
        (f : Euclidean 2 → Complex) =
      jointSchwartzRaw (wfSourceJointSchwartz D scale n hscale P) := by
  unfold angularRadialWave wfSourceJointSchwartz wfSourceSpectrum
  rw [← wfBasePhysical_eq_angularPiece D scale n (angularCutoff nu) (wavefrontCutoff nu) f P]
  exact wf_verticalProjection_eq_jointSchwartzRaw D.vertical scale n hscale
    (wfBaseSpectrum D P)

private theorem wfSourceSpectrum_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (n : Int)
    (chi tildeChi : Euclidean 2 → Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (hscale : 0 < scale)
    (P : WFAngularRadialProfiles D scale n chi tildeChi f)
    (zeta : WaveSpaceTime) :
    wfSourceSpectrum D scale n hscale P (WithLp.toLp 2 zeta) =
      D.vertical ((Real.sqrt scale)⁻¹ * zeta.2 - n) *
        (P.spatial zeta.1 * FourierTransform.fourier
          (D.time : Real → Complex) (zeta.2 - P.normalExtension zeta.1)) := by
  unfold wfSourceSpectrum wfBaseSpectrum
  rw [wfApplyVerticalSpectrum_apply, wfVerticalProfile_apply,
    jointSchwartzModulatedAnnularProfile_apply]

/-- Exact space--time Fourier formula for the joint-Schwartz source packet. -/
private theorem spaceTimeFourier_wfSourceJointSchwartz
    (D : MSSRadialTimeCutoffs) (scale : Real) (n : Int)
    (chi tildeChi : Euclidean 2 → Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (hscale : 0 < scale)
    (P : WFAngularRadialProfiles D scale n chi tildeChi f)
    (zeta : WaveSpaceTime) :
    spaceTimeFourier (jointSchwartzRaw (wfSourceJointSchwartz D scale n hscale P)) zeta =
      D.vertical ((Real.sqrt scale)⁻¹ * zeta.2 - n) *
        (P.spatial zeta.1 * FourierTransform.fourier
          (D.time : Real → Complex) (zeta.2 - P.normalExtension zeta.1)) := by
  unfold wfSourceJointSchwartz
  rw [spaceTimeFourier_jointSchwartzRaw]
  change FourierTransform.fourier
      (FourierTransform.fourierInv (wfSourceSpectrum D scale n hscale P) :
        JointWaveSpaceTime → Complex) (WithLp.toLp 2 zeta) = _
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  exact wfSourceSpectrum_apply D scale n chi tildeChi f hscale P zeta

/-- The raw factorization made explicit: vertical, angular, annular, radial,
input Fourier, and temporal-normal factors occur in their literal order. -/
private theorem spaceTimeFourier_angularRadialWave_of_profiles
    (D : MSSRadialTimeCutoffs) (scale : Real) (n : Int)
    (angularCutoff wavefrontCutoff : Int → Euclidean 2 → Complex) (nu : Int)
    (f : SchwartzMap (Euclidean 2) Complex) (hscale : 0 < scale)
    (P : WFAngularRadialProfiles D scale n (angularCutoff nu) (wavefrontCutoff nu) f)
    (zeta : WaveSpaceTime) :
    spaceTimeFourier
        (angularRadialWave (D.vertical : Real → Complex) (D.radial : Real → Complex)
          angularCutoff scale (D.amplitude : Euclidean 2 → Complex)
          (D.time : Real → Complex) n nu (f : Euclidean 2 → Complex)) zeta =
      D.vertical ((Real.sqrt scale)⁻¹ * zeta.2 - n) *
        ((angularCutoff nu zeta.1 * D.amplitude (scale⁻¹ • zeta.1)) *
          (P.radial zeta.1 * FourierTransform.fourier
            (f : Euclidean 2 → Complex) zeta.1) *
          FourierTransform.fourier (D.time : Real → Complex)
            (zeta.2 - P.normalExtension zeta.1)) := by
  rw [angularRadialWave_eq_jointSchwartzRaw_of_profiles
    D scale n angularCutoff wavefrontCutoff nu f hscale P]
  rw [spaceTimeFourier_wfSourceJointSchwartz D scale n
    (angularCutoff nu) (wavefrontCutoff nu) f hscale P zeta]
  rw [P.spatial_eq]

/-- On the exact source spectrum, the raw wave-front multiplier is represented
by a genuine joint-Schwartz cutoff.  The two supplied local extension fields
are used only after nonvanishing forces the spatial profile to be active. -/
private theorem wfWavefrontJointCutoff_realizes_wavefrontMultiplier
    (D : MSSRadialTimeCutoffs) (normal : SchwartzMap Real Complex)
    (scale gamma : Real) (n : Int)
    (chi tildeChi : Euclidean 2 → Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (hscale : 0 < scale)
    (P : WFAngularRadialProfiles D scale n chi tildeChi f)
    (zeta : WaveSpaceTime) :
    wavefrontMultiplier tildeChi (normal : Real → Complex) scale gamma zeta *
        FourierTransform.fourier
          (wfSourceJointSchwartz D scale n hscale P : JointWaveSpaceTime → Complex)
          (WithLp.toLp 2 zeta) =
      wfWavefrontJointCutoff normal scale gamma hscale P (WithLp.toLp 2 zeta) *
        FourierTransform.fourier
          (wfSourceJointSchwartz D scale n hscale P : JointWaveSpaceTime → Complex)
          (WithLp.toLp 2 zeta) := by
  by_cases hsource : FourierTransform.fourier
      (wfSourceJointSchwartz D scale n hscale P : JointWaveSpaceTime → Complex)
      (WithLp.toLp 2 zeta) = 0
  · simp [hsource]
  · have hfactor := spaceTimeFourier_wfSourceJointSchwartz D scale n chi tildeChi f
      hscale P zeta
    rw [spaceTimeFourier_jointSchwartzRaw] at hfactor
    rw [hfactor] at hsource
    have hbase : P.spatial zeta.1 * FourierTransform.fourier
        (D.time : Real → Complex) (zeta.2 - P.normalExtension zeta.1) ≠ 0 :=
      (mul_ne_zero_iff.mp hsource).2
    have hspatial : P.spatial zeta.1 ≠ 0 := (mul_ne_zero_iff.mp hbase).1
    rw [wavefrontMultiplier]
    unfold wfWavefrontJointCutoff
    rw [jointSchwartzSpatialNormalCutoff_apply, wfNormalProfile_apply,
      P.wavefrontAngular_eq zeta.1 hspatial,
      P.normal_eq_norm zeta.1 hspatial]

/-- Exact Fourier-side residual identity.  This is the kernel-proof input:
the residual carries the literal defect `1 - Q_nu` times the fully factored
source spectrum, rather than an abstract replacement wave. -/
private theorem wfResidualSpectrum_apply
    (D : MSSRadialTimeCutoffs) (normal : SchwartzMap Real Complex)
    (scale gamma : Real) (n : Int)
    (chi tildeChi : Euclidean 2 → Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (hscale : 0 < scale)
    (P : WFAngularRadialProfiles D scale n chi tildeChi f)
    (zeta : WaveSpaceTime) :
    wfResidualSpectrum D normal scale gamma n hscale P (WithLp.toLp 2 zeta) =
      ((1 : Complex) - wavefrontMultiplier tildeChi (normal : Real → Complex)
        scale gamma zeta) *
        (D.vertical ((Real.sqrt scale)⁻¹ * zeta.2 - n) *
          (P.spatial zeta.1 * FourierTransform.fourier
            (D.time : Real → Complex) (zeta.2 - P.normalExtension zeta.1))) := by
  let S : SchwartzMap JointWaveSpaceTime Complex :=
    wfSourceSpectrum D scale n hscale P
  let G : SchwartzMap JointWaveSpaceTime Complex :=
    wfSourceJointSchwartz D scale n hscale P
  let q : SchwartzMap JointWaveSpaceTime Complex :=
    wfWavefrontJointCutoff normal scale gamma hscale P
  have hG : FourierTransform.fourier (G : JointWaveSpaceTime → Complex)
      (WithLp.toLp 2 zeta) = S (WithLp.toLp 2 zeta) := by
    dsimp only [G, S, wfSourceJointSchwartz]
    rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  have hrealized : q (WithLp.toLp 2 zeta) * S (WithLp.toLp 2 zeta) =
      wavefrontMultiplier tildeChi (normal : Real → Complex) scale gamma zeta *
        S (WithLp.toLp 2 zeta) := by
    rw [← hG]
    exact (wfWavefrontJointCutoff_realizes_wavefrontMultiplier D normal scale gamma n
      chi tildeChi f hscale P zeta).symm
  change S (WithLp.toLp 2 zeta) -
      jointSchwartzSpectralCutoffProduct q G (WithLp.toLp 2 zeta) = _
  rw [jointSchwartzSpectralCutoffProduct,
    SchwartzMap.smulLeftCLM_apply_apply q.hasTemperateGrowth]
  rw [smul_eq_mul]
  change S (WithLp.toLp 2 zeta) - q (WithLp.toLp 2 zeta) *
      FourierTransform.fourier (G : JointWaveSpaceTime → Complex)
        (WithLp.toLp 2 zeta) = _
  rw [hG, hrealized]
  rw [wfSourceSpectrum_apply D scale n chi tildeChi f hscale P zeta]
  ring

/-- The raw wave-front projection of one active angular/radial wave is a
joint-Schwartz spectral cutoff output, with no unproved raw Fourier bridge. -/
private theorem wavefrontAngularRadialWave_eq_jointSchwartzSpectralCutoffOutput_of_profiles
    (D : MSSRadialTimeCutoffs) (normal : SchwartzMap Real Complex)
    (scale gamma : Real) (n : Int)
    (angularCutoff wavefrontCutoff : Int → Euclidean 2 → Complex) (nu : Int)
    (f : SchwartzMap (Euclidean 2) Complex) (hscale : 0 < scale)
    (P : WFAngularRadialProfiles D scale n (angularCutoff nu) (wavefrontCutoff nu) f) :
    wavefrontAngularRadialWave (D.vertical : Real → Complex) (D.radial : Real → Complex)
        angularCutoff wavefrontCutoff (normal : Real → Complex) scale gamma
        (D.amplitude : Euclidean 2 → Complex) (D.time : Real → Complex) n nu
        (f : Euclidean 2 → Complex) =
      jointSchwartzSpectralCutoffOutput
        (wfWavefrontJointCutoff normal scale gamma hscale P)
        (wfSourceJointSchwartz D scale n hscale P) := by
  unfold wavefrontAngularRadialWave
  rw [angularRadialWave_eq_jointSchwartzRaw_of_profiles
    D scale n angularCutoff wavefrontCutoff nu f hscale P]
  exact wavefrontProjection_eq_jointSchwartzSpectralCutoffOutput_of_realization
    (wavefrontCutoff nu) (normal : Real → Complex) scale gamma
    (wfWavefrontJointCutoff normal scale gamma hscale P)
    (wfSourceJointSchwartz D scale n hscale P)
    (wfWavefrontJointCutoff_realizes_wavefrontMultiplier D normal scale gamma n
      (angularCutoff nu) (wavefrontCutoff nu) f hscale P)

/-- Physical-space form of the same kernel input: the literal difference in
the wave-front localization lemma is exactly the inverse joint Fourier
transform of `wfResidualSpectrum`. -/
private theorem angularRadialWave_sub_wavefrontAngularRadialWave_eq_jointSchwartzRaw_of_profiles
    (D : MSSRadialTimeCutoffs) (normal : SchwartzMap Real Complex)
    (scale gamma : Real) (n : Int)
    (angularCutoff wavefrontCutoff : Int → Euclidean 2 → Complex) (nu : Int)
    (f : SchwartzMap (Euclidean 2) Complex) (hscale : 0 < scale)
    (P : WFAngularRadialProfiles D scale n (angularCutoff nu) (wavefrontCutoff nu) f) :
    angularRadialWave (D.vertical : Real → Complex) (D.radial : Real → Complex)
        angularCutoff scale (D.amplitude : Euclidean 2 → Complex) (D.time : Real → Complex)
        n nu (f : Euclidean 2 → Complex) -
      wavefrontAngularRadialWave (D.vertical : Real → Complex) (D.radial : Real → Complex)
        angularCutoff wavefrontCutoff (normal : Real → Complex) scale gamma
        (D.amplitude : Euclidean 2 → Complex) (D.time : Real → Complex) n nu
        (f : Euclidean 2 → Complex) =
      jointSchwartzRaw (FourierTransform.fourierInv
        (wfResidualSpectrum D normal scale gamma n hscale P)) := by
  rw [angularRadialWave_eq_jointSchwartzRaw_of_profiles
    D scale n angularCutoff wavefrontCutoff nu f hscale P]
  rw [wavefrontAngularRadialWave_eq_jointSchwartzSpectralCutoffOutput_of_profiles
    D normal scale gamma n angularCutoff wavefrontCutoff nu f hscale P]
  unfold jointSchwartzSpectralCutoffOutput wfSourceJointSchwartz wfResidualSpectrum
  funext z
  change (FourierTransform.fourierInv (wfSourceSpectrum D scale n hscale P) :
      SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 z) -
      (FourierTransform.fourierInv
        (jointSchwartzSpectralCutoffProduct
          (wfWavefrontJointCutoff normal scale gamma hscale P)
          (FourierTransform.fourierInv (wfSourceSpectrum D scale n hscale P))) :
        SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 z) =
      (FourierTransform.fourierInv
        (wfSourceSpectrum D scale n hscale P -
          jointSchwartzSpectralCutoffProduct
            (wfWavefrontJointCutoff normal scale gamma hscale P)
            (FourierTransform.fourierInv (wfSourceSpectrum D scale n hscale P))) :
        SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 z)
  have hsub : FourierTransform.fourierInv
      (wfSourceSpectrum D scale n hscale P -
        jointSchwartzSpectralCutoffProduct
          (wfWavefrontJointCutoff normal scale gamma hscale P)
          (FourierTransform.fourierInv (wfSourceSpectrum D scale n hscale P))) =
      FourierTransform.fourierInv (wfSourceSpectrum D scale n hscale P) -
        FourierTransform.fourierInv
          (jointSchwartzSpectralCutoffProduct
            (wfWavefrontJointCutoff normal scale gamma hscale P)
            (FourierTransform.fourierInv (wfSourceSpectrum D scale n hscale P))) := by
      rw [sub_eq_add_neg, FourierTransform.fourierInv_add,
        FourierTransform.fourierInv_neg]
      rfl
  rw [hsub]
  rfl

private theorem wf_normal_thickness_of_support
    {scale gamma u : Real} (hscale : 0 < scale)
    (hu : |scale ^ (-gamma) * u| < 2) :
    |u| ≤ 2 * scale ^ gamma := by
  have hpowpos : 0 < scale ^ gamma := Real.rpow_pos_of_pos hscale _
  have hinv : scale ^ (-gamma) = (scale ^ gamma)⁻¹ := by
    rw [← Real.rpow_neg hscale.le]
  rw [hinv, abs_mul, abs_inv, abs_of_pos hpowpos] at hu
  have hu' : |u| / (scale ^ gamma) < 2 := by
    rw [div_eq_mul_inv]
    simpa [mul_comm] using hu
  have hlt : |u| < 2 * scale ^ gamma :=
    (div_lt_iff₀ hpowpos).mp hu'
  exact hlt.le

private theorem wf_annular_of_scaled_amplitude_nonzero
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 2 ≤ scale)
    (xi : Euclidean 2)
    (hamp : D.amplitude (scale⁻¹ • xi) ≠ 0) :
    scale / 4 ≤ ‖xi‖ ∧ ‖xi‖ ≤ 4 * scale := by
  have hscale_pos : 0 < scale := by linarith
  have hsupport := D.amplitude_support_annulus (scale⁻¹ • xi) hamp
  rw [norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hscale_pos] at hsupport
  have hsupport' : ‖xi‖ / scale ∈ Icc (1 / 2 : Real) 2 := by
    simpa [div_eq_mul_inv, mul_comm] using hsupport
  constructor
  · have hhalf : scale / 2 ≤ ‖xi‖ := by
      rw [show scale / 2 = (1 / 2 : Real) * scale by ring]
      exact (le_div_iff₀ hscale_pos).mp hsupport'.1
    linarith
  · have htwo : ‖xi‖ ≤ 2 * scale :=
      (div_le_iff₀ hscale_pos).mp hsupport'.2
    linarith

/-- Direct plate support for one active angular/radial wave.  This uses the
exact raw-to-joint factorization above, so no independent raw Fourier
realization hypothesis remains. -/
private theorem support_wavefrontAngularRadialWave_subset_conicPlate_of_profiles
    (D : MSSRadialTimeCutoffs) (normal : SchwartzMap Real Complex)
    (scale gamma angularConstant : Real) (direction : Euclidean 2) (n : Int)
    (angularCutoff wavefrontCutoff : Int → Euclidean 2 → Complex) (nu : Int)
    (f : SchwartzMap (Euclidean 2) Complex) (hscale : 2 ≤ scale)
    (P : WFAngularRadialProfiles D scale n (angularCutoff nu) (wavefrontCutoff nu) f)
    (hangular : Function.support (wavefrontCutoff nu) ⊆
      angularSector direction (angularConstant * scale ^ (-(1 / 2 : Real))))
    (hnormal : ∀ s : Real, normal s ≠ 0 → |s| < 2) :
    Function.support
        (spaceTimeFourier
          (wavefrontAngularRadialWave (D.vertical : Real → Complex)
            (D.radial : Real → Complex) angularCutoff wavefrontCutoff
            (normal : Real → Complex) scale gamma
            (D.amplitude : Euclidean 2 → Complex) (D.time : Real → Complex) n nu
            (f : Euclidean 2 → Complex))) ⊆
      conicPlate scale gamma angularConstant n direction := by
  have hscale_pos : 0 < scale := by linarith
  rw [wavefrontAngularRadialWave_eq_jointSchwartzSpectralCutoffOutput_of_profiles
    D normal scale gamma n angularCutoff wavefrontCutoff nu f hscale_pos P]
  intro zeta hzeta
  change spaceTimeFourier
      (jointSchwartzSpectralCutoffOutput
        (wfWavefrontJointCutoff normal scale gamma hscale_pos P)
        (wfSourceJointSchwartz D scale n hscale_pos P)) zeta ≠ 0 at hzeta
  rw [spaceTimeFourier_jointSchwartzSpectralCutoffOutput] at hzeta
  rw [jointSchwartzSpectralCutoffProduct,
    SchwartzMap.smulLeftCLM_apply_apply
      (wfWavefrontJointCutoff normal scale gamma hscale_pos P).hasTemperateGrowth,
    SchwartzMap.fourier_coe, smul_eq_mul] at hzeta
  have hmultSource :
      wavefrontMultiplier (wavefrontCutoff nu) (normal : Real → Complex)
          scale gamma zeta *
        FourierTransform.fourier
          (wfSourceJointSchwartz D scale n hscale_pos P : JointWaveSpaceTime → Complex)
          (WithLp.toLp 2 zeta) ≠ 0 := by
    rw [wfWavefrontJointCutoff_realizes_wavefrontMultiplier D normal scale gamma n
      (angularCutoff nu) (wavefrontCutoff nu) f hscale_pos P zeta]
    exact hzeta
  rcases mul_ne_zero_iff.mp hmultSource with ⟨hmult, hsource⟩
  rw [wavefrontMultiplier] at hmult
  rcases mul_ne_zero_iff.mp hmult with ⟨hangularActive, hnormalActive⟩
  have hsourceFactor := spaceTimeFourier_wfSourceJointSchwartz D scale n
    (angularCutoff nu) (wavefrontCutoff nu) f hscale_pos P zeta
  have hsourceRaw : spaceTimeFourier
      (jointSchwartzRaw (wfSourceJointSchwartz D scale n hscale_pos P)) zeta ≠ 0 := by
    rw [spaceTimeFourier_jointSchwartzRaw]
    exact hsource
  rw [hsourceFactor] at hsourceRaw
  rcases mul_ne_zero_iff.mp hsourceRaw with ⟨hvertical, hspatialTime⟩
  have hspatial : P.spatial zeta.1 ≠ 0 := (mul_ne_zero_iff.mp hspatialTime).1
  rw [P.spatial_eq] at hspatial
  have hamp : D.amplitude (scale⁻¹ • zeta.1) ≠ 0 := by
    exact (mul_ne_zero_iff.mp (mul_ne_zero_iff.mp hspatial).1).2
  refine ⟨(wf_annular_of_scaled_amplitude_nonzero D scale hscale zeta.1 hamp).1,
    (wf_annular_of_scaled_amplitude_nonzero D scale hscale zeta.1 hamp).2,
    hangular hangularActive, ?_, ?_⟩
  · exact (D.vertical_support _ hvertical).le
  · apply wf_normal_thickness_of_support hscale_pos
    exact hnormal _ hnormalActive


private noncomputable def scratchWavefrontInputSpatialProfile
    (D : MSSWavefrontKernelData) (scale : Real) (n nu : Int)
    (f : SchwartzMap (Euclidean 2) Complex) : SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex (D.spatialProfile scale n nu : Euclidean 2 → Complex)
    (FourierTransform.fourier f)

private theorem scratchWavefrontInputSpatialProfile_apply
    (D : MSSWavefrontKernelData) (scale : Real) (n nu : Int)
    (f : SchwartzMap (Euclidean 2) Complex) (xi : Euclidean 2) :
    scratchWavefrontInputSpatialProfile D scale n nu f xi =
      D.spatialProfile scale n nu xi *
        FourierTransform.fourier (f : Euclidean 2 → Complex) xi := by
  unfold scratchWavefrontInputSpatialProfile
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (D.spatialProfile scale n nu).hasTemperateGrowth]
  rw [smul_eq_mul]
  rw [← SchwartzMap.fourier_coe]

/-- The profile package realizing one literal raw packet. -/
private noncomputable def scratchWavefrontRawProfiles
    (D : MSSWavefrontKernelData) (R : MSSWavefrontRawProfileRealization D)
    (scale : Real) (hscale : 0 < scale) (n nu : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    WFAngularRadialProfiles D.radialTime scale n (D.chi scale nu) (D.tildeChi scale nu) f where
  radial := R.radialProfile scale n
  spatial := scratchWavefrontInputSpatialProfile D scale n nu f
  normalExtension := D.normalCoordinate scale
  wavefrontAngular := R.wavefrontAngularProfile scale nu
  radial_eq := R.radialProfile_apply scale n hscale
  spatial_eq := by
    intro xi
    rw [scratchWavefrontInputSpatialProfile_apply, D.spatialProfile_apply,
      R.radialProfile_apply scale n hscale]
    ring
  normal_eq_norm := by
    intro xi hxi
    change scratchWavefrontInputSpatialProfile D scale n nu f xi ≠ 0 at hxi
    rw [scratchWavefrontInputSpatialProfile_apply] at hxi
    have hspatial : D.spatialProfile scale n nu xi ≠ 0 :=
      (mul_ne_zero_iff.mp hxi).1
    exact normalCoordinate_eq_norm_on_spatial_support D
      hscale n nu hspatial
  wavefrontAngular_eq := by
    intro xi hxi
    change scratchWavefrontInputSpatialProfile D scale n nu f xi ≠ 0 at hxi
    rw [scratchWavefrontInputSpatialProfile_apply] at hxi
    have hspatial : D.spatialProfile scale n nu xi ≠ 0 :=
      (mul_ne_zero_iff.mp hxi).1
    exact R.wavefrontAngularProfile_eq_on_spatial scale n nu xi hspatial

private def scratchWavefrontJointInputFourierFactor
    (f : SchwartzMap (Euclidean 2) Complex) : JointWaveSpaceTime → Complex :=
  fun z => FourierTransform.fourier (f : Euclidean 2 → Complex) z.fst

private theorem scratchWavefrontJointInputFourierFactor_hasTemperateGrowth
    (f : SchwartzMap (Euclidean 2) Complex) :
    (scratchWavefrontJointInputFourierFactor f).HasTemperateGrowth := by
  change ((FourierTransform.fourier (f : Euclidean 2 → Complex)) ∘
    WithLp.fstL 2 Real (Euclidean 2) Real).HasTemperateGrowth
  rw [← SchwartzMap.fourier_coe]
  exact (FourierTransform.fourier f).hasTemperateGrowth.comp
    (WithLp.fstL 2 Real (Euclidean 2) Real).hasTemperateGrowth

/-- The joint-Schwartz spectrum obtained by attaching the input Fourier
transform to the f-independent packet multiplier. -/
private noncomputable def scratchWavefrontPacketResidualSpectrum
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale)
    (n nu : Int) (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  SchwartzMap.smulLeftCLM Complex (scratchWavefrontJointInputFourierFactor f)
    (scratchWavefrontPacketResidualMultiplier D scale hscale n nu)

private theorem scratchWavefrontPacketResidualSpectrum_apply
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale)
    (n nu : Int) (f : SchwartzMap (Euclidean 2) Complex) (zeta : WaveSpaceTime) :
    scratchWavefrontPacketResidualSpectrum D scale hscale n nu f
        (WithLp.toLp 2 zeta) =
      FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1 *
        scratchWavefrontPacketResidualMultiplier D scale hscale n nu
          (WithLp.toLp 2 zeta) := by
  unfold scratchWavefrontPacketResidualSpectrum
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (scratchWavefrontJointInputFourierFactor_hasTemperateGrowth f)]
  rfl

private theorem scratchWavefrontPacketResidualSpectrum_eq_rawResidualSpectrum
    (D : MSSWavefrontKernelData) (R : MSSWavefrontRawProfileRealization D)
    (scale : Real) (hscale : 0 < scale) (n nu : Int)
    (hnu : nu ∈ D.angularIndices scale)
    (f : SchwartzMap (Euclidean 2) Complex) :
    wfResidualSpectrum D.radialTime D.normal scale D.gamma n hscale
      (scratchWavefrontRawProfiles D R scale hscale n nu f) =
      scratchWavefrontPacketResidualSpectrum D scale hscale n nu f := by
  ext z
  have hz : WithLp.toLp 2 (z.fst, z.snd) = z := by
    apply (WithLp.ext_iff 2).2
    rfl
  rw [← hz]
  let P := scratchWavefrontRawProfiles D R scale hscale n nu f
  let M := scratchWavefrontPacketResidualMultiplier D scale hscale n nu
  rw [wfResidualSpectrum_apply, scratchWavefrontPacketResidualSpectrum_apply]
  by_cases hspatial : D.spatialProfile scale n nu z.fst = 0
  · have hPzero : P.spatial z.fst = 0 := by
      change scratchWavefrontInputSpatialProfile D scale n nu f z.fst = 0
      rw [scratchWavefrontInputSpatialProfile_apply, hspatial, zero_mul]
    rw [scratchWavefrontPacketResidualMultiplier_apply, hspatial, hPzero]
    ring
  · have hchi : D.chi scale nu z.fst ≠ 0 := by
      rw [D.spatialProfile_apply] at hspatial
      exact (mul_ne_zero_iff.mp hspatial).1
    have htilde : D.tildeChi scale nu z.fst = 1 :=
      D.tildeChi_one_on_chi_support scale nu hnu z.fst hchi
    have hnormal : D.normalCoordinate scale z.fst = ‖z.fst‖ :=
      normalCoordinate_eq_norm_on_spatial_support D hscale n nu hspatial
    have hPspatial : P.spatial z.fst =
        D.spatialProfile scale n nu z.fst *
          FourierTransform.fourier (f : Euclidean 2 → Complex) z.fst := by
      change scratchWavefrontInputSpatialProfile D scale n nu f z.fst = _
      exact scratchWavefrontInputSpatialProfile_apply D scale n nu f z.fst
    rw [hPspatial]
    rw [show P.normalExtension z.fst = ‖z.fst‖ by
      rw [show P = scratchWavefrontRawProfiles D R scale hscale n nu f by rfl]
      exact hnormal]
    rw [scratchWavefrontPacketResidualMultiplier_apply,
      D.normalTail_apply, hnormal, wavefrontMultiplier, htilde]
    ring

private theorem scratchWavefrontPacketResidual_eq_jointSchwartzRaw_fourierInvSpectrum
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale)
    (n nu : Int) (f : SchwartzMap (Euclidean 2) Complex) :
    scratchWavefrontPacketResidual D scale hscale n nu f =
      jointSchwartzRaw (FourierTransform.fourierInv
        (scratchWavefrontPacketResidualSpectrum D scale hscale n nu f)) := by
  funext z
  rw [scratchWavefrontPacketResidual_eq_inverse_factorizedSpectrum]
  change spaceTimeFourierInv (fun zeta : WaveSpaceTime =>
      jointSchwartzRaw (scratchWavefrontPacketResidualMultiplier D scale hscale n nu) zeta *
        FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1) z = _
  calc
    spaceTimeFourierInv (fun zeta : WaveSpaceTime =>
        jointSchwartzRaw (scratchWavefrontPacketResidualMultiplier D scale hscale n nu) zeta *
          FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1) z =
        spaceTimeFourierInv
          (jointSchwartzRaw
            (scratchWavefrontPacketResidualSpectrum D scale hscale n nu f)) z := by
          congr 1
          funext zeta
          change scratchWavefrontPacketResidualMultiplier D scale hscale n nu
              (WithLp.toLp 2 zeta) *
              FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1 =
            scratchWavefrontPacketResidualSpectrum D scale hscale n nu f
              (WithLp.toLp 2 zeta)
          rw [scratchWavefrontPacketResidualSpectrum_apply]
          ring
    _ = jointSchwartzRaw (FourierTransform.fourierInv
        (scratchWavefrontPacketResidualSpectrum D scale hscale n nu f)) z := by
          rw [spaceTimeFourierInv_jointSchwartzRaw]
          exact (congrFun (SchwartzMap.fourierInv_coe
            (scratchWavefrontPacketResidualSpectrum D scale hscale n nu f))
              (WithLp.toLp 2 z)).symm

/-- Literal raw packet equality: the f-independent residual multiplier used
by the kernel proof is exactly `angularRadialWave - wavefrontAngularRadialWave`.
-/
private theorem mssAngularRadialWave_sub_mssWavefrontAngularRadialWave_eq_packetResidual
    (D : MSSWavefrontKernelData) (R : MSSWavefrontRawProfileRealization D)
    (scale : Real) (hscale : 0 < scale) (n nu : Int)
    (hnu : nu ∈ D.angularIndices scale)
    (f : SchwartzMap (Euclidean 2) Complex) :
    mssAngularRadialWave D.toMSSWavefrontCutoffData scale n nu (f : Euclidean 2 → Complex) -
      mssWavefrontAngularRadialWave D.toMSSWavefrontCutoffData scale D.gamma n nu
        (f : Euclidean 2 → Complex) =
      scratchWavefrontPacketResidual D scale hscale n nu f := by
  change angularRadialWave (D.radialTime.vertical : Real → Complex)
      (D.radialTime.radial : Real → Complex) (D.chi scale) scale
      (D.radialTime.amplitude : Euclidean 2 → Complex)
      (D.radialTime.time : Real → Complex) n nu (f : Euclidean 2 → Complex) -
    wavefrontAngularRadialWave (D.radialTime.vertical : Real → Complex)
      (D.radialTime.radial : Real → Complex) (D.chi scale) (D.tildeChi scale)
      (D.normal : Real → Complex) scale D.gamma
      (D.radialTime.amplitude : Euclidean 2 → Complex)
      (D.radialTime.time : Real → Complex) n nu (f : Euclidean 2 → Complex) = _
  rw [angularRadialWave_sub_wavefrontAngularRadialWave_eq_jointSchwartzRaw_of_profiles
    D.radialTime D.normal scale D.gamma n (D.chi scale) (D.tildeChi scale) nu f hscale
    (scratchWavefrontRawProfiles D R scale hscale n nu f)]
  rw [scratchWavefrontPacketResidual_eq_jointSchwartzRaw_fourierInvSpectrum]
  rw [scratchWavefrontPacketResidualSpectrum_eq_rawResidualSpectrum
    D R scale hscale n nu hnu f]

/-- The literal raw residual is measurable, as needed by finite square-function
aggregation. -/
private theorem mssAngularRadialWave_sub_mssWavefrontAngularRadialWave_aestronglyMeasurable
    (D : MSSWavefrontKernelData) (R : MSSWavefrontRawProfileRealization D)
    (scale : Real) (hscale : 0 < scale) (n nu : Int)
    (hnu : nu ∈ D.angularIndices scale)
    (f : SchwartzMap (Euclidean 2) Complex) :
    AEStronglyMeasurable
      (mssAngularRadialWave D.toMSSWavefrontCutoffData scale n nu (f : Euclidean 2 → Complex) -
        mssWavefrontAngularRadialWave D.toMSSWavefrontCutoffData scale D.gamma n nu
          (f : Euclidean 2 → Complex)) volume := by
  rw [mssAngularRadialWave_sub_mssWavefrontAngularRadialWave_eq_packetResidual
    D R scale hscale n nu hnu f]
  rw [scratchWavefrontPacketResidual_eq_jointSchwartzRaw_fourierInvSpectrum]
  change AEStronglyMeasurable (fun z : WaveSpaceTime =>
    (FourierTransform.fourierInv
      (scratchWavefrontPacketResidualSpectrum D scale hscale n nu f) :
        SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 z)) volume
  exact ((FourierTransform.fourierInv
      (scratchWavefrontPacketResidualSpectrum D scale hscale n nu f)).continuous.comp
    (WithLp.prod_continuous_toLp 2 (Euclidean 2) Real)).aestronglyMeasurable

/- Private one-packet kernel closure for wave-front localization. -/
open scoped BigOperators

private theorem scratch_wavefront_jointSchwartzRaw_integrable_prod
    (M : SchwartzMap JointWaveSpaceTime Complex) :
    Integrable (fun z : WaveSpaceTime => M (WithLp.toLp 2 z))
      (volume.prod volume) := by
  have hpres : MeasurePreserving
      (MeasurableEquiv.toLp 2 WaveSpaceTime) volume volume :=
    WithLp.volume_preserving_toLp (Euclidean 2) Real
  exact
    (hpres.integrable_comp_emb
      (MeasurableEquiv.toLp 2 (Euclidean 2 × Real)).measurableEmbedding).mpr
      M.integrable

private theorem scratch_wavefront_source_kernel_triple_integrable
    (M : SchwartzMap JointWaveSpaceTime Complex)
    (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) (t : Real) :
    Integrable (fun zy : WaveSpaceTime × Euclidean 2 =>
      (Real.fourierChar (inner Real zy.1.2 t) : Complex) *
        (Real.fourierChar (inner Real zy.1.1 x) : Complex) *
          M (WithLp.toLp 2 zy.1) *
            (Real.fourierChar (-inner Real zy.2 zy.1.1) : Complex) * f zy.2)
      ((volume.prod volume).prod volume) := by
  let Mraw : WaveSpaceTime → Complex := fun z => M (WithLp.toLp 2 z)
  have hbase : Integrable (fun zy : WaveSpaceTime × Euclidean 2 =>
      Mraw zy.1 * f zy.2) ((volume.prod volume).prod volume) :=
    (scratch_wavefront_jointSchwartzRaw_integrable_prod M).mul_prod f.integrable
  refine hbase.congr' ?_ ?_
  · fun_prop
  · filter_upwards with zy
    simp only [Mraw, norm_mul, Circle.norm_coe, one_mul]
    ring

private theorem scratch_wavefront_spaceTimeFourierInv_eq_productIntegral
    (G : WaveSpaceTime → Complex)
    (hG : Integrable G (volume.prod volume))
    (u : Euclidean 2) (t : Real) :
    spaceTimeFourierInv G (u, t) =
      ∫ z : WaveSpaceTime,
        (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 u) : Complex) * G z := by
  let Q : Euclidean 2 → Real → Complex := fun xi tau =>
    (Real.fourierChar (inner Real tau t) : Complex) *
      (Real.fourierChar (inner Real xi u) : Complex) * G (xi, tau)
  have hQ : Integrable (Function.uncurry Q) (volume.prod volume) := by
    have hphaseT : Continuous (fun z : WaveSpaceTime =>
        (Real.fourierChar (inner Real z.2 t) : Complex)) := by
      fun_prop
    have hphaseU : Continuous (fun z : WaveSpaceTime =>
        (Real.fourierChar (inner Real z.1 u) : Complex)) := by
      fun_prop
    refine hG.congr' ?_ ?_
    · exact
        ((hphaseT.aestronglyMeasurable.mul hphaseU.aestronglyMeasurable).mul
          hG.aestronglyMeasurable)
    · filter_upwards with z
      simp only [Q, Function.uncurry, norm_mul, Circle.norm_coe, one_mul]
  have hleft :
      spaceTimeFourierInv G (u, t) = ∫ tau : Real, ∫ xi : Euclidean 2, Q xi tau := by
    unfold spaceTimeFourierInv
    rw [Real.fourierInv_eq]
    apply integral_congr_ae
    filter_upwards with tau
    rw [Real.fourierInv_eq]
    change
      (Real.fourierChar (inner Real tau t) : Complex) *
          ∫ xi : Euclidean 2,
            (Real.fourierChar (inner Real xi u) : Complex) * G (xi, tau) =
        ∫ xi : Euclidean 2, Q xi tau
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with xi
    simp only [Q]
    ring
  have hQswap : Integrable
      (Function.uncurry (fun tau : Real => fun xi : Euclidean 2 => Q xi tau))
      (volume.prod volume) := by
    convert hQ.swap using 1
    ext z
    rcases z with ⟨tau, xi⟩
    rfl
  have hswap :
      (∫ tau : Real, ∫ xi : Euclidean 2, Q xi tau) =
        ∫ xi : Euclidean 2, ∫ tau : Real, Q xi tau :=
    integral_integral_swap hQswap
  have hprod :
      (∫ xi : Euclidean 2, ∫ tau : Real, Q xi tau) =
        ∫ z : WaveSpaceTime, Q z.1 z.2 := by
    rw [Measure.volume_eq_prod]
    exact (integral_prod (Function.uncurry Q) hQ).symm
  calc
    spaceTimeFourierInv G (u, t) = ∫ tau : Real, ∫ xi : Euclidean 2, Q xi tau := hleft
    _ = ∫ xi : Euclidean 2, ∫ tau : Real, Q xi tau := hswap
    _ = ∫ z : WaveSpaceTime, Q z.1 z.2 := hprod
    _ = ∫ z : WaveSpaceTime,
        (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 u) : Complex) * G z := by
      rfl

private theorem scratch_wavefront_jointSchwartz_mul_spatialFourier_integrable
    (M : SchwartzMap JointWaveSpaceTime Complex)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun z : WaveSpaceTime =>
      M (WithLp.toLp 2 z) *
        FourierTransform.fourier (f : Euclidean 2 → Complex) z.1)
      (volume.prod volume) := by
  let Mraw : WaveSpaceTime → Complex := fun z => M (WithLp.toLp 2 z)
  have hfhat_le (xi : Euclidean 2) :
      ‖FourierTransform.fourier (f : Euclidean 2 → Complex) xi‖ ≤
        ∫ y : Euclidean 2, ‖f y‖ := by
    rw [Real.fourier_eq]
    calc
      ‖∫ y : Euclidean 2,
          Real.fourierChar (-inner Real y xi) • (f : Euclidean 2 → Complex) y‖ ≤
          ∫ y : Euclidean 2,
            ‖Real.fourierChar (-inner Real y xi) • (f : Euclidean 2 → Complex) y‖ :=
        norm_integral_le_integral_norm _
      _ = ∫ y : Euclidean 2, ‖f y‖ := by
        simp only [Circle.norm_smul]
  refine Integrable.mono'
    ((scratch_wavefront_jointSchwartzRaw_integrable_prod M).norm.mul_const
      (∫ y : Euclidean 2, ‖f y‖)) ?_ ?_
  · exact
      (scratch_wavefront_jointSchwartzRaw_integrable_prod M).aestronglyMeasurable.mul
        (((FourierTransform.fourier f : SchwartzMap (Euclidean 2) Complex).continuous.comp
          continuous_fst).aestronglyMeasurable)
  · filter_upwards with z
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (hfhat_le z.1)
      (norm_nonneg (M (WithLp.toLp 2 z)))

/-- A joint Schwartz multiplier acting on spatial Fourier data is literally
spatial convolution by its inverse joint Fourier kernel. -/
private theorem scratch_wavefront_inverse_factorizedSpectrum_eq_sourceKernel
    (M : SchwartzMap JointWaveSpaceTime Complex)
    (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) (t : Real) :
    spaceTimeFourierInv
        (fun zeta : WaveSpaceTime =>
          jointSchwartzRaw M zeta *
            FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1)
        (x, t) =
      ∫ y : Euclidean 2,
        spaceTimeFourierInv (jointSchwartzRaw M) (x - y, t) * f y := by
  let Mraw : WaveSpaceTime → Complex := fun z => M (WithLp.toLp 2 z)
  have hM : Integrable Mraw (volume.prod volume) :=
    scratch_wavefront_jointSchwartzRaw_integrable_prod M
  have hMfhat : Integrable (fun z : WaveSpaceTime =>
      Mraw z * FourierTransform.fourier (f : Euclidean 2 → Complex) z.1)
      (volume.prod volume) := by
    simpa only [Mraw] using
      scratch_wavefront_jointSchwartz_mul_spatialFourier_integrable M f
  have htriple := scratch_wavefront_source_kernel_triple_integrable M f x t
  have hfourier (z : WaveSpaceTime) :
      (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
            FourierTransform.fourier (f : Euclidean 2 → Complex) z.1 =
        ∫ y : Euclidean 2,
          (Real.fourierChar (inner Real z.2 t) : Complex) *
            (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
              (Real.fourierChar (-inner Real y z.1) : Complex) * f y := by
    rw [Real.fourier_eq]
    change
      (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
          ∫ y : Euclidean 2,
            (Real.fourierChar (-inner Real y z.1) : Complex) * f y = _
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with y
    ring
  have hphase (xi y : Euclidean 2) :
      (Real.fourierChar (inner Real xi x) : Complex) *
          (Real.fourierChar (-inner Real y xi) : Complex) =
        (Real.fourierChar (inner Real xi (x - y)) : Complex) := by
    have harg :
        inner Real xi x + -inner Real y xi = inner Real xi (x - y) := by
      rw [inner_sub_right, real_inner_comm y xi]
      ring
    rw [← Circle.coe_mul, ← Real.fourierChar.map_add_eq_mul, harg]
  have hinner (y : Euclidean 2) :
      (∫ z : WaveSpaceTime,
        (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
            (Real.fourierChar (-inner Real y z.1) : Complex) * f y) =
        spaceTimeFourierInv Mraw (x - y, t) * f y := by
    calc
      (∫ z : WaveSpaceTime,
        (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
            (Real.fourierChar (-inner Real y z.1) : Complex) * f y) =
          ∫ z : WaveSpaceTime,
            ((Real.fourierChar (inner Real z.2 t) : Complex) *
              (Real.fourierChar (inner Real z.1 (x - y)) : Complex) * Mraw z) * f y := by
            apply integral_congr_ae
            filter_upwards with z
            rw [← hphase z.1 y]
            ring
      _ = (∫ z : WaveSpaceTime,
            (Real.fourierChar (inner Real z.2 t) : Complex) *
              (Real.fourierChar (inner Real z.1 (x - y)) : Complex) * Mraw z) * f y := by
            rw [integral_mul_const]
      _ = spaceTimeFourierInv Mraw (x - y, t) * f y := by
            rw [← scratch_wavefront_spaceTimeFourierInv_eq_productIntegral Mraw hM (x - y) t]
  calc
    spaceTimeFourierInv
        (fun zeta : WaveSpaceTime =>
          jointSchwartzRaw M zeta *
            FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1)
        (x, t) =
        ∫ z : WaveSpaceTime,
          (Real.fourierChar (inner Real z.2 t) : Complex) *
            (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
              FourierTransform.fourier (f : Euclidean 2 → Complex) z.1 := by
          simpa only [Mraw, jointSchwartzRaw, mul_assoc] using
            (scratch_wavefront_spaceTimeFourierInv_eq_productIntegral
              (fun z : WaveSpaceTime =>
                Mraw z * FourierTransform.fourier (f : Euclidean 2 → Complex) z.1)
              hMfhat x t)
    _ = ∫ z : WaveSpaceTime, ∫ y : Euclidean 2,
          (Real.fourierChar (inner Real z.2 t) : Complex) *
            (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
              (Real.fourierChar (-inner Real y z.1) : Complex) * f y := by
          apply integral_congr_ae
          filter_upwards with z
          exact hfourier z
    _ = ∫ y : Euclidean 2, ∫ z : WaveSpaceTime,
          (Real.fourierChar (inner Real z.2 t) : Complex) *
            (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
              (Real.fourierChar (-inner Real y z.1) : Complex) * f y :=
      integral_integral_swap htriple
    _ = ∫ y : Euclidean 2,
          spaceTimeFourierInv Mraw (x - y, t) * f y := by
          apply integral_congr_ae
          filter_upwards with y
          exact hinner y
    _ = ∫ y : Euclidean 2,
          spaceTimeFourierInv (jointSchwartzRaw M) (x - y, t) * f y := by
      rfl

/-- Orientation form used by the mixed Young inequality. -/
private theorem scratch_wavefront_sourceKernel_convolution_orientation
    (K : WaveSpaceTime → Complex) (f : Euclidean 2 → Complex)
    (x : Euclidean 2) (t : Real) :
    (∫ y : Euclidean 2, K (x - y, t) * f y) =
      ∫ y : Euclidean 2, K (y, t) * f (x - y) := by
  let H : Euclidean 2 → Complex := fun u => K (u, t) * f (x - u)
  calc
    (∫ y : Euclidean 2, K (x - y, t) * f y) =
        ∫ y : Euclidean 2, H (x - y) := by
          apply integral_congr_ae
          filter_upwards with y
          simp only [H]
          have hxy : x - (x - y) = y := by abel
          rw [hxy]
    _ = ∫ u : Euclidean 2, H u :=
      integral_sub_left_eq_self H volume x
    _ = ∫ y : Euclidean 2, K (y, t) * f (x - y) := by
      rfl


private theorem scratch_wavefront_weighted_factor_of_holder
    {p r : Real} (hpq : r.HolderConjugate p) (a b : ENNReal) :
    a * b = a ^ r⁻¹ * (a * b ^ p) ^ p⁻¹ := by
  have hp0 : 0 < p := hpq.symm.pos
  have hr0 : 0 < r := hpq.pos
  have hbinv : (b ^ p) ^ p⁻¹ = b := by
    calc
      (b ^ p) ^ p⁻¹ = b ^ (p * p⁻¹) := (ENNReal.rpow_mul _ _ _).symm
      _ = b := by rw [mul_inv_cancel₀ hp0.ne', ENNReal.rpow_one]
  rw [ENNReal.mul_rpow_of_nonneg _ _ hpq.symm.inv_nonneg]
  rw [hbinv]
  calc
    a * b = a ^ (r⁻¹ + p⁻¹) * b := by
      rw [hpq.inv_add_inv_eq_one, ENNReal.rpow_one]
    _ = (a ^ r⁻¹ * a ^ p⁻¹) * b := by
      rw [ENNReal.rpow_add_of_nonneg _ _ hpq.inv_nonneg hpq.symm.inv_nonneg]
    _ = a ^ r⁻¹ * (a ^ p⁻¹ * b) := by ring

private theorem scratch_wavefront_lintegral_spatial_p_pointwise
    (p r : Real) (hpq : r.HolderConjugate p)
    (K q : Euclidean 2 → ENNReal)
    (hK : Measurable K) (hq : Measurable q) (x : Euclidean 2) :
    (∫⁻ y : Euclidean 2, K y * q (x - y)) ^ p ≤
      (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
        ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p := by
  have hp0 : 0 < p := hpq.symm.pos
  have hr0 : 0 < r := hpq.pos
  let a : Euclidean 2 → ENNReal := fun y => K y ^ r⁻¹
  let b : Euclidean 2 → ENNReal := fun y =>
    (K y * q (x - y) ^ p) ^ p⁻¹
  have ha : AEMeasurable a volume := by
    exact (hK.pow measurable_const).aemeasurable
  have hqx : Measurable (fun y : Euclidean 2 => q (x - y)) :=
    hq.comp (measurable_const.sub measurable_id)
  have hb : AEMeasurable b volume := by
    exact ((hK.mul (hqx.pow measurable_const)).pow measurable_const).aemeasurable
  have hholder := ENNReal.lintegral_mul_le_Lp_mul_Lq volume hpq ha hb
  have hleft : (∫⁻ y : Euclidean 2, (a * b) y) =
      ∫⁻ y : Euclidean 2, K y * q (x - y) := by
    apply lintegral_congr
    intro y
    simp only [a, b, Pi.mul_apply]
    exact (scratch_wavefront_weighted_factor_of_holder hpq (K y) (q (x - y))).symm
  have hfirst :
      (∫⁻ y : Euclidean 2, a y ^ r) = ∫⁻ y : Euclidean 2, K y := by
    apply lintegral_congr
    intro y
    simp only [a]
    rw [← ENNReal.rpow_mul, inv_mul_cancel₀ hr0.ne', ENNReal.rpow_one]
  have hsecond :
      (∫⁻ y : Euclidean 2, b y ^ p) =
        ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p := by
    apply lintegral_congr
    intro y
    simp only [b]
    rw [← ENNReal.rpow_mul, inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one]
  have hholder' :
      (∫⁻ y : Euclidean 2, K y * q (x - y)) ≤
        (∫⁻ y : Euclidean 2, K y) ^ r⁻¹ *
          (∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) ^ p⁻¹ := by
    rw [hleft, hfirst, hsecond] at hholder
    simpa only [one_div] using hholder
  have hrp : r⁻¹ * p = p - 1 := by
    rw [← hpq.symm.one_sub_inv]
    field_simp [hp0.ne']
  have hpow := ENNReal.rpow_le_rpow hholder' hp0.le
  calc
    (∫⁻ y : Euclidean 2, K y * q (x - y)) ^ p ≤
        ((∫⁻ y : Euclidean 2, K y) ^ r⁻¹ *
          (∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) ^ p⁻¹) ^ p := hpow
    _ = (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
        ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
      rw [← ENNReal.rpow_mul, ← ENNReal.rpow_mul, hrp,
        inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one]

private theorem scratch_wavefront_lintegral_spatial_p_young
    (p r : Real) (hpq : r.HolderConjugate p)
    (K q : Euclidean 2 → ENNReal)
    (hK : Measurable K) (hq : Measurable q) :
    ∫⁻ x : Euclidean 2, (∫⁻ y : Euclidean 2, K y * q (x - y)) ^ p ≤
      (∫⁻ y : Euclidean 2, K y) ^ p * ∫⁻ x : Euclidean 2, q x ^ p := by
  have hpone : 1 ≤ p := hpq.symm.lt.le
  let H : Euclidean 2 × Euclidean 2 → ENNReal := fun z =>
    K z.2 * q (z.1 - z.2) ^ p
  have hH : Measurable H := by
    exact (hK.comp measurable_snd).mul
      ((hq.comp (measurable_fst.sub measurable_snd)).pow measurable_const)
  have hinner : Measurable (fun x : Euclidean 2 =>
      ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) := by
    exact hH.lintegral_prod_right
  have htranslate (y : Euclidean 2) :
      (∫⁻ x : Euclidean 2, q (x - y) ^ p) = ∫⁻ x : Euclidean 2, q x ^ p := by
    exact (measurePreserving_sub_right (volume : Measure (Euclidean 2)) y).lintegral_comp
      (hq.pow measurable_const)
  have hdouble :
      (∫⁻ x : Euclidean 2, ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) =
        (∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x ^ p := by
    calc
      (∫⁻ x : Euclidean 2, ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) =
          ∫⁻ y : Euclidean 2, ∫⁻ x : Euclidean 2, K y * q (x - y) ^ p := by
            exact lintegral_lintegral_swap hH.aemeasurable
      _ = ∫⁻ y : Euclidean 2, K y * (∫⁻ x : Euclidean 2, q (x - y) ^ p) := by
            apply lintegral_congr
            intro y
            simpa only [Function.comp_apply, Pi.sub_apply, id_eq] using
              (lintegral_const_mul (K y)
                ((hq.comp (measurable_id.sub measurable_const)).pow measurable_const))
      _ = ∫⁻ y : Euclidean 2, K y * (∫⁻ x : Euclidean 2, q x ^ p) := by
            apply lintegral_congr
            intro y
            rw [htranslate y]
      _ = (∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x ^ p :=
            lintegral_mul_const _ hK
  calc
    (∫⁻ x : Euclidean 2, (∫⁻ y : Euclidean 2, K y * q (x - y)) ^ p) ≤
        ∫⁻ x : Euclidean 2, (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
          (∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) := by
      apply lintegral_mono
      intro x
      exact scratch_wavefront_lintegral_spatial_p_pointwise p r hpq K q hK hq x
    _ = (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
        (∫⁻ x : Euclidean 2, ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) := by
      rw [lintegral_const_mul _ hinner]
    _ = (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
        ((∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x ^ p) := by
      rw [hdouble]
    _ = (∫⁻ y : Euclidean 2, K y) ^ p * ∫⁻ x : Euclidean 2, q x ^ p := by
      calc
        (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
            ((∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x ^ p) =
            ((∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
              ∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x ^ p := by
          ring
        _ =
            ((∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
              (∫⁻ y : Euclidean 2, K y) ^ (1 : Real)) *
              ∫⁻ x : Euclidean 2, q x ^ p := by rw [ENNReal.rpow_one]
        _ = (∫⁻ y : Euclidean 2, K y) ^ ((p - 1) + 1) *
              ∫⁻ x : Euclidean 2, q x ^ p := by
          rw [← ENNReal.rpow_add_of_nonneg _ _
            (sub_nonneg.mpr hpone) (by norm_num : (0 : Real) ≤ 1)]
        _ = (∫⁻ y : Euclidean 2, K y) ^ p * ∫⁻ x : Euclidean 2, q x ^ p := by
          congr 2
          ring

private theorem scratch_wavefront_complex_spatial_convolution_p_moment
    (p : Real) (hp : 1 < p)
    (K f : Euclidean 2 → Complex)
    (hK : Measurable K) (hf : Measurable f) :
    ∫⁻ x : Euclidean 2,
        ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ^ p ≤
      (∫⁻ y : Euclidean 2, ‖K y‖ₑ) ^ p *
        ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ p := by
  have hpq : p.conjExponent.HolderConjugate p :=
    (Real.HolderConjugate.conjExponent hp).symm
  have hpoint (x : Euclidean 2) :
      ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ≤
        ∫⁻ y : Euclidean 2, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
    change ‖∫ y : Euclidean 2, K y * f (x - y)‖ₑ ≤ _
    calc
      ‖∫ y : Euclidean 2, K y * f (x - y)‖ₑ ≤
          ∫⁻ y : Euclidean 2, ‖K y * f (x - y)‖ₑ :=
        enorm_integral_le_lintegral_enorm _
      _ = ∫⁻ y : Euclidean 2, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
        apply lintegral_congr
        intro y
        rw [enorm_mul]
  calc
    (∫⁻ x : Euclidean 2,
        ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ^ p) ≤
        ∫⁻ x : Euclidean 2,
          (∫⁻ y : Euclidean 2, ‖K y‖ₑ * ‖f (x - y)‖ₑ) ^ p := by
      apply lintegral_mono
      intro x
      exact ENNReal.rpow_le_rpow (hpoint x) (by positivity)
    _ ≤ (∫⁻ y : Euclidean 2, ‖K y‖ₑ) ^ p *
        ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ p :=
      scratch_wavefront_lintegral_spatial_p_young p p.conjExponent hpq
        (fun y => ‖K y‖ₑ) (fun x => ‖f x‖ₑ) hK.enorm hf.enorm

private theorem scratch_wavefront_ennreal_rpow_inv_cancel
    (p : Real) (hp : 0 < p) (a : ENNReal) :
    (a ^ p) ^ p⁻¹ = a := by
  calc
    (a ^ p) ^ p⁻¹ = a ^ (p * p⁻¹) := (ENNReal.rpow_mul _ _ _).symm
    _ = a := by rw [mul_inv_cancel₀ hp.ne', ENNReal.rpow_one]

private theorem scratch_wavefront_complex_spatial_convolution_p_young
    (p : Real) (hp : 1 < p)
    (K f : Euclidean 2 → Complex)
    (hK : Measurable K) (hf : Measurable f) :
    eLpNorm (K ⋆[ContinuousLinearMap.mul Complex Complex] f) (ENNReal.ofReal p) volume ≤
      (∫⁻ y : Euclidean 2, ‖K y‖ₑ) * eLpNorm f (ENNReal.ofReal p) volume := by
  have hp0 : 0 < p := lt_trans zero_lt_one hp
  let L : ENNReal := ∫⁻ y : Euclidean 2, ‖K y‖ₑ
  let J : ENNReal := ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ p
  have hmoment :
      (∫⁻ x : Euclidean 2,
          ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ^ p) ≤ L ^ p * J := by
    simpa only [L, J] using
      scratch_wavefront_complex_spatial_convolution_p_moment p hp K f hK hf
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top]
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top]
  simp only [ENNReal.toReal_ofReal hp0.le]
  have hroot : (∫⁻ x : Euclidean 2,
          ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ^ p) ^ p⁻¹ ≤
        L * J ^ p⁻¹ := by
    calc
      (∫⁻ x : Euclidean 2,
          ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ^ p) ^ p⁻¹ ≤
          (L ^ p * J) ^ p⁻¹ :=
        ENNReal.rpow_le_rpow hmoment (inv_nonneg.mpr hp0.le)
      _ = (L ^ p) ^ p⁻¹ * J ^ p⁻¹ :=
        ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hp0.le)
      _ = L * J ^ p⁻¹ := by
        rw [scratch_wavefront_ennreal_rpow_inv_cancel p hp0]
  convert hroot using 1 <;> simp only [L, J, one_div]

private theorem scratch_wavefront_mixed_p_lift_of_slice_moment
    (p : Real) (hp : 0 < p)
    (G : WaveSpaceTime → Complex) (A : Real → ENNReal)
    (f : Euclidean 2 → Complex)
    (hG : AEMeasurable G volume)
    (hA : Measurable A)
    (hpoint : ∀ t : Real,
      ∫⁻ x : Euclidean 2, ‖G (x, t)‖ₑ ^ p ≤
        A t * ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ p) :
    eLpNorm G (ENNReal.ofReal p) volume ≤
      (∫⁻ t : Real, A t) ^ p⁻¹ * eLpNorm f (ENNReal.ofReal p) volume := by
  let F : WaveSpaceTime → ENNReal := fun z => ‖G z‖ₑ ^ p
  let J : ENNReal := ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ p
  have hF : AEMeasurable F volume := by
    exact hG.enorm.pow measurable_const.aemeasurable
  have hFprod : AEMeasurable F
      ((volume : Measure (Euclidean 2)).prod volume) := by
    rw [← Measure.volume_eq_prod (Euclidean 2) Real]
    exact hF
  have hFswap : AEMeasurable (fun z : Real × Euclidean 2 => F z.swap)
      (volume.prod volume) := by
    change AEMeasurable (F ∘ Prod.swap) (volume.prod volume)
    exact hFprod.comp_quasiMeasurePreserving
      ((Measure.measurePreserving_swap : MeasurePreserving Prod.swap
        (volume.prod volume) (volume.prod volume)).quasiMeasurePreserving)
  have hFubini :
      (∫⁻ z : WaveSpaceTime, F z) =
        ∫⁻ t : Real, ∫⁻ x : Euclidean 2, F (x, t) := by
    rw [Measure.volume_eq_prod (Euclidean 2) Real]
    calc
      (∫⁻ z : Euclidean 2 × Real, F z ∂volume.prod volume) =
          ∫⁻ z : Real × Euclidean 2, F z.swap ∂volume.prod volume :=
        (lintegral_prod_swap F).symm
      _ = ∫⁻ t : Real, ∫⁻ x : Euclidean 2, F (x, t) := by
        rw [lintegral_prod _ hFswap]
        rfl
  have hmoment :
      (∫⁻ z : WaveSpaceTime, F z) ≤ (∫⁻ t : Real, A t) * J := by
    calc
      (∫⁻ z : WaveSpaceTime, F z) =
          ∫⁻ t : Real, ∫⁻ x : Euclidean 2, F (x, t) := hFubini
      _ ≤ ∫⁻ t : Real, A t * J := by
        apply lintegral_mono
        intro t
        simpa only [F, J] using hpoint t
      _ = (∫⁻ t : Real, A t) * J := lintegral_mul_const J hA
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ENNReal.ofReal_ne_zero_iff.mpr hp) ENNReal.ofReal_ne_top]
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ENNReal.ofReal_ne_zero_iff.mpr hp) ENNReal.ofReal_ne_top]
  simp only [ENNReal.toReal_ofReal hp.le]
  have hroot : (∫⁻ z : WaveSpaceTime, F z) ^ p⁻¹ ≤
      (∫⁻ t : Real, A t) ^ p⁻¹ * J ^ p⁻¹ := by
    calc
      (∫⁻ z : WaveSpaceTime, F z) ^ p⁻¹ ≤
          ((∫⁻ t : Real, A t) * J) ^ p⁻¹ :=
        ENNReal.rpow_le_rpow hmoment (inv_nonneg.mpr hp.le)
      _ = (∫⁻ t : Real, A t) ^ p⁻¹ * J ^ p⁻¹ :=
        ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hp.le)
  convert hroot using 1 <;> simp only [F, J, one_div]

/-- Literal mixed Young at the one exponent used by the wave-front lemma.
The left side is the actual space--time convolution of a kernel with spatial
input data; the coefficient is precisely the `L⁴` norm of its spatial slice
mass. -/
private theorem scratch_wavefront_mixed_spatial_convolution_four_young
    (K : WaveSpaceTime → Complex) (f : Euclidean 2 → Complex)
    (hK : Continuous K) (hf : Continuous f) :
    eLpNorm (fun z : WaveSpaceTime => ∫ y : Euclidean 2,
        K (y, z.2) * f (z.1 - y)) 4 volume ≤
      eLpNorm (fun t : Real => ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ) 4 volume *
        eLpNorm f 4 volume := by
  let G : WaveSpaceTime → Complex :=
    fun z => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y)
  let S : Real → ENNReal := fun t =>
    ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ
  let A : Real → ENNReal := fun t =>
    S t ^ (4 : Real)
  have hjoint : Continuous (fun zy : WaveSpaceTime × Euclidean 2 =>
      K (zy.2, zy.1.2) * f (zy.1.1 - zy.2)) :=
    (hK.comp (continuous_snd.prodMk continuous_fst.snd)).mul
      (hf.comp (continuous_fst.fst.sub continuous_snd))
  have hG : AEMeasurable G volume := by
    exact hjoint.stronglyMeasurable.integral_prod_right'.aemeasurable
  have hKswap : Measurable (fun z : Real × Euclidean 2 => ‖K z.swap‖ₑ) :=
    hK.measurable.enorm.comp measurable_swap
  have hA0 : Measurable S := by
    exact hKswap.lintegral_prod_right
  have hA : Measurable A := by
    exact hA0.pow measurable_const
  have hpoint : ∀ t : Real,
      ∫⁻ x : Euclidean 2, ‖G (x, t)‖ₑ ^ (4 : Real) ≤
        A t * ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ (4 : Real) := by
    intro t
    have hKt : Measurable (fun x : Euclidean 2 => K (x, t)) :=
      hK.measurable.comp (measurable_id.prodMk measurable_const)
    simpa only [G, A, convolution_def, ContinuousLinearMap.mul_apply'] using
      scratch_wavefront_complex_spatial_convolution_p_moment 4 (by norm_num)
        (fun x : Euclidean 2 => K (x, t)) f hKt hf.measurable
  have hmain := scratch_wavefront_mixed_p_lift_of_slice_moment 4 (by norm_num)
    G A f hG hA hpoint
  have hcoef : (∫⁻ t : Real, S t ^ (4 : Real)) ^ (4 : Real)⁻¹ =
      eLpNorm S 4 volume := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by simp)]
    simp only [enorm_eq_self, ENNReal.toReal_ofNat, one_div]
  rw [show (∫⁻ t : Real, A t) ^ (4 : Real)⁻¹ = eLpNorm S 4 volume by
    simpa only [A] using hcoef] at hmain
  have hfour : ENNReal.ofReal (4 : Real) = (4 : ENNReal) := by norm_num
  simpa only [G, S, hfour] using hmain

private theorem scratch_jointSchwartzRaw_pointwise_product_decay
    (K : SchwartzMap JointWaveSpaceTime Complex) (a b : Nat)
    (x : Euclidean 2) (t : Real) :
    (1 + ‖x‖) ^ a * (1 + |t|) ^ b *
        ‖jointSchwartzRaw K (x, t)‖ ≤
      (2 : Real) ^ (a + b) *
        ((Finset.Iic (a + b, 0)).sup fun m =>
          SchwartzMap.seminorm Complex m.1 m.2) K := by
  let z : JointWaveSpaceTime := WithLp.toLp 2 (x, t)
  have hx : ‖x‖ ≤ ‖z‖ := by
    dsimp only [z]
    simpa using (WithLp.norm_fst_le (p := 2) (Euclidean 2)
      (WithLp.toLp 2 (x, t)))
  have ht : |t| ≤ ‖z‖ := by
    dsimp only [z]
    have hraw := WithLp.norm_snd_le (p := 2) (Euclidean 2)
      (WithLp.toLp 2 (x, t))
    simpa only [WithLp.toLp_snd, Real.norm_eq_abs] using hraw
  have hweight : (1 + ‖x‖) ^ a * (1 + |t|) ^ b ≤
      (1 + ‖z‖) ^ (a + b) := by
    rw [pow_add]
    gcongr <;> linarith
  have hsemi := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := Complex)
    (m := (a + b, (0 : Nat))) (k := a + b) (n := (0 : Nat))
      (le_refl _) (le_refl _) K z
  simp only [norm_iteratedFDeriv_zero, pow_zero, mul_one] at hsemi
  change (1 + ‖x‖) ^ a * (1 + |t|) ^ b * ‖K (WithLp.toLp 2 (x, t))‖ ≤ _
  change (1 + ‖x‖) ^ a * (1 + |t|) ^ b * ‖K z‖ ≤ _
  calc
    (1 + ‖x‖) ^ a * (1 + |t|) ^ b * ‖K z‖ ≤
        (1 + ‖z‖) ^ (a + b) * ‖K z‖ := by
      exact mul_le_mul_of_nonneg_right hweight (norm_nonneg _)
    _ ≤ _ := hsemi

/-- The spatial `L¹` slice mass of a joint Schwartz profile decays faster
than any prescribed polynomial in the time coordinate.  The deliberately
unsimplified right side is a finite Schwartz seminorm times the fixed
integrable planar weight, which is the form needed by the mixed Young
estimate. -/
private theorem scratch_weighted_spatial_mass_jointSchwartzRaw_le
    (K : SchwartzMap JointWaveSpaceTime Complex) (b : Nat) (t : Real) :
    (1 + |t|) ^ b *
        (∫ x : Euclidean 2, ‖jointSchwartzRaw K (x, t)‖) ≤
      (2 : Real) ^ 4 *
        ((2 : Real) ^ (4 + b) *
          ((Finset.Iic (4 + b, 0)).sup fun m =>
            SchwartzMap.seminorm Complex m.1 m.2) K +
        (2 : Real) ^ (4 + b) *
          ((Finset.Iic (4 + b, 0)).sup fun m =>
            SchwartzMap.seminorm Complex m.1 m.2) K) *
        (∫ x : Euclidean 2, (1 + ‖x‖) ^ (-(4 : Real))) := by
  let T : Real := (1 + |t|) ^ b
  let S : Real := (2 : Real) ^ (4 + b) *
    ((Finset.Iic (4 + b, 0)).sup fun m =>
      SchwartzMap.seminorm Complex m.1 m.2) K
  have hT : 0 ≤ T := by
    dsimp only [T]
    positivity
  have htoLp : Continuous (WithLp.toLp 2 : WaveSpaceTime → JointWaveSpaceTime) :=
    WithLp.prod_continuous_toLp 2 _ _
  have hrawcont : Continuous (fun z : WaveSpaceTime => K (WithLp.toLp 2 z)) :=
    K.continuous.comp htoLp
  have hmeas : AEStronglyMeasurable
      (fun x : Euclidean 2 => T * ‖jointSchwartzRaw K (x, t)‖) volume := by
    change AEStronglyMeasurable
      (fun x : Euclidean 2 => T * ‖K (WithLp.toLp 2 (x, t))‖) volume
    exact (continuous_const.mul
      ((hrawcont.comp (continuous_id.prodMk continuous_const)).norm)).aestronglyMeasurable
  have hB : ∀ x : Euclidean 2,
      ‖T * ‖jointSchwartzRaw K (x, t)‖‖ ≤ S := by
    intro x
    have hpoint := scratch_jointSchwartzRaw_pointwise_product_decay K 4 b x t
    have hone : 1 ≤ (1 + ‖x‖) ^ 4 :=
      one_le_pow₀ (by linarith [norm_nonneg x])
    have hnonneg : 0 ≤ T * ‖jointSchwartzRaw K (x, t)‖ :=
      mul_nonneg hT (norm_nonneg _)
    rw [Real.norm_eq_abs, abs_of_nonneg hnonneg]
    calc
      T * ‖jointSchwartzRaw K (x, t)‖ ≤
          (1 + ‖x‖) ^ 4 * (T * ‖jointSchwartzRaw K (x, t)‖) :=
        le_mul_of_one_le_left hnonneg hone
      _ = (1 + ‖x‖) ^ 4 * (1 + |t|) ^ b *
          ‖jointSchwartzRaw K (x, t)‖ := by
        dsimp only [T]
        ring
      _ ≤ S := hpoint
  have hA : ∀ x : Euclidean 2,
      ‖x‖ ^ 4 * ‖T * ‖jointSchwartzRaw K (x, t)‖‖ ≤ S := by
    intro x
    have hpoint := scratch_jointSchwartzRaw_pointwise_product_decay K 4 b x t
    have hnonneg : 0 ≤ T * ‖jointSchwartzRaw K (x, t)‖ :=
      mul_nonneg hT (norm_nonneg _)
    rw [Real.norm_eq_abs, abs_of_nonneg hnonneg]
    calc
      ‖x‖ ^ 4 * (T * ‖jointSchwartzRaw K (x, t)‖) ≤
          (1 + ‖x‖) ^ 4 * (T * ‖jointSchwartzRaw K (x, t)‖) := by
        gcongr
        linarith [norm_nonneg x]
      _ = (1 + ‖x‖) ^ 4 * (1 + |t|) ^ b *
          ‖jointSchwartzRaw K (x, t)‖ := by
        dsimp only [T]
        ring
      _ ≤ S := hpoint
  have hkernel := Auto.MikhlinHormander.integral_norm_le_uniform_and_power_decay
    (d := 2) (N := 4) (f := fun x : Euclidean 2 =>
      T * ‖jointSchwartzRaw K (x, t)‖)
    (by norm_num) hmeas hB hA
  have hleft :
      T * (∫ x : Euclidean 2, ‖jointSchwartzRaw K (x, t)‖) =
        ∫ x : Euclidean 2, ‖T * ‖jointSchwartzRaw K (x, t)‖‖ := by
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with x
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hT (norm_nonneg _))]
  change T * (∫ x : Euclidean 2, ‖jointSchwartzRaw K (x, t)‖) ≤ _
  rw [hleft]
  exact hkernel

private theorem scratch_wavefront_fourierInv_seminorm_le_derivativeIntegrals
    (Q : SchwartzMap JointWaveSpaceTime Complex) (N : Nat) :
    SchwartzMap.seminorm Complex N 0
      (𝓕⁻ Q : SchwartzMap JointWaveSpaceTime Complex) ≤
      (2 : Real) ^ N * ∑ n ∈ Finset.range (N + 1),
        ∫ zeta : JointWaveSpaceTime,
          ‖iteratedFDeriv Real n (Q : JointWaveSpaceTime → Complex) zeta‖ := by
  apply SchwartzMap.seminorm_le_bound Complex N 0
    (𝓕⁻ Q : SchwartzMap JointWaveSpaceTime Complex)
  · exact mul_nonneg (by positivity)
      (Finset.sum_nonneg fun _ _ => integral_nonneg fun _ => norm_nonneg _)
  · intro x
    rw [norm_iteratedFDeriv_zero]
    rw [SchwartzMap.fourierInv_coe]
    change ‖x‖ ^ N * ‖𝓕⁻ (Q : JointWaveSpaceTime → Complex) x‖ ≤ _
    have h := Real.pow_mul_norm_iteratedFDeriv_fourier_le
      (f := (Q : JointWaveSpaceTime → Complex)) (K := 0) (N := N)
      (Q.smooth N)
      (fun k n hk hn => by
        have hk' : k = 0 := by simpa using hk
        subst k
        simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume Q 0 n)
      (k := 0) (n := N) (by simp) (by simp) (-x)
    simpa [Real.fourierInv_eq_fourier_neg] using h

/-- The honest analytic input left after the cutoff algebra: all finite
frequency derivative `L¹` norms of the explicit one-packet multiplier are
rapid in scale, uniformly over the canonical finite `(n,ν)` family. -/
private def scratchWavefrontRapidMultiplierBounds
    (D : MSSWavefrontKernelData) : Prop :=
  ∀ (r N : Nat), ∃ C : Real, 0 ≤ C ∧
    ∀ (scale : Real) (hscale : 0 < scale) (n nu : Int), 2 ≤ scale →
      n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
      scale ^ N *
        (∫ z : JointWaveSpaceTime,
          ‖iteratedFDeriv Real r
            (scratchWavefrontPacketResidualMultiplier D scale hscale n nu :
              JointWaveSpaceTime → Complex) z‖) ≤ C

/-- Six physical weights suffice for a planar spatial slice with quadratic
time decay.  This extracts that finite seminorm budget directly from the
frequency-side regularity condition. -/
private theorem scratchWavefrontRapidMultiplierBounds.exists_iic_seminorm_bound
    {D : MSSWavefrontKernelData}
    (hrapid : scratchWavefrontRapidMultiplierBounds D) (N : Nat) :
    ∃ C : Real, 0 ≤ C ∧
      ∀ (scale : Real) (hscale : 0 < scale) (n nu : Int), 2 ≤ scale →
        n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
        scale ^ N *
          ((Finset.Iic (6, 0)).sup fun m =>
            SchwartzMap.seminorm Complex m.1 m.2)
          (𝓕⁻ (scratchWavefrontPacketResidualMultiplier D scale hscale n nu) :
            SchwartzMap JointWaveSpaceTime Complex) ≤ C := by
  let c : Nat → Real := fun r => (hrapid r N).choose
  have hc_nonneg (r : Nat) : 0 ≤ c r := (hrapid r N).choose_spec.1
  have hc_bound (r : Nat) :
      ∀ (scale : Real) (hscale : 0 < scale) (n nu : Int), 2 ≤ scale →
        n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
        scale ^ N *
          (∫ z : JointWaveSpaceTime,
            ‖iteratedFDeriv Real r
              (scratchWavefrontPacketResidualMultiplier D scale hscale n nu :
                JointWaveSpaceTime → Complex) z‖) ≤ c r := by
    intro scale hscale n nu hscale_two hn hnu
    exact (hrapid r N).choose_spec.2 scale hscale n nu hscale_two hn hnu
  let CD : Real := ∑ r ∈ Finset.range 7, c r
  have hCD_nonneg : 0 ≤ CD := by
    dsimp only [CD]
    exact Finset.sum_nonneg fun r _ => hc_nonneg r
  refine ⟨(2 : Real) ^ 6 * CD, mul_nonneg (by positivity) hCD_nonneg, ?_⟩
  intro scale hscale n nu hscale_two hn hnu
  let M : SchwartzMap JointWaveSpaceTime Complex :=
    scratchWavefrontPacketResidualMultiplier D scale hscale n nu
  let J : Finset (Nat × Nat) := Finset.Iic (6, 0)
  let P : Nat × Nat → Seminorm Complex (SchwartzMap JointWaveSpaceTime Complex) :=
    fun m => SchwartzMap.seminorm Complex m.1 m.2
  have hscaleNpos : 0 < scale ^ N := pow_pos hscale N
  have hscaleNnonneg : 0 ≤ scale ^ N := hscaleNpos.le
  have hsum {k : Nat} (hk : k ≤ 6) :
      scale ^ N *
        (∑ r ∈ Finset.range (k + 1),
          ∫ z : JointWaveSpaceTime,
            ‖iteratedFDeriv Real r (M : JointWaveSpaceTime → Complex) z‖) ≤ CD := by
    rw [Finset.mul_sum]
    calc
      ∑ r ∈ Finset.range (k + 1), scale ^ N *
          (∫ z : JointWaveSpaceTime,
            ‖iteratedFDeriv Real r (M : JointWaveSpaceTime → Complex) z‖) ≤
          ∑ r ∈ Finset.range (k + 1), c r := by
            apply Finset.sum_le_sum
            intro r hr
            simpa only [M] using hc_bound r scale hscale n nu hscale_two hn hnu
      _ ≤ CD := by
            dsimp only [CD]
            apply Finset.sum_le_sum_of_subset_of_nonneg
            · exact (Finset.range_subset_range).2 (by omega)
            · intro r hr hnot
              exact hc_nonneg r
  have hPscaled (m : Nat × Nat) (hm : m ∈ J) :
      scale ^ N * P m (𝓕⁻ M) ≤ (2 : Real) ^ 6 * CD := by
    have hmle : m ≤ (6, 0) := Finset.mem_Iic.mp (by simpa only [J] using hm)
    have hmone : m.1 ≤ 6 := hmle.1
    have hmtwo : m.2 = 0 := Nat.eq_zero_of_le_zero hmle.2
    change scale ^ N *
        SchwartzMap.seminorm Complex m.1 m.2 (𝓕⁻ M : SchwartzMap JointWaveSpaceTime Complex) ≤
      (2 : Real) ^ 6 * CD
    rw [hmtwo]
    have hsemi := scratch_wavefront_fourierInv_seminorm_le_derivativeIntegrals M m.1
    have hsum' := hsum hmone
    have hsum'_nonneg : 0 ≤
        scale ^ N *
          (∑ r ∈ Finset.range (m.1 + 1),
            ∫ z : JointWaveSpaceTime,
              ‖iteratedFDeriv Real r (M : JointWaveSpaceTime → Complex) z‖) := by
      apply mul_nonneg hscaleNnonneg
      exact Finset.sum_nonneg fun _ _ => integral_nonneg fun _ => norm_nonneg _
    calc
      scale ^ N *
          (SchwartzMap.seminorm Complex m.1 0
            (𝓕⁻ M : SchwartzMap JointWaveSpaceTime Complex) : Real) ≤
          scale ^ N *
            ((2 : Real) ^ m.1 *
              ∑ r ∈ Finset.range (m.1 + 1),
                ∫ z : JointWaveSpaceTime,
                  ‖iteratedFDeriv Real r (M : JointWaveSpaceTime → Complex) z‖) := by
            exact mul_le_mul_of_nonneg_left hsemi hscaleNnonneg
      _ = (2 : Real) ^ m.1 *
          (scale ^ N *
            ∑ r ∈ Finset.range (m.1 + 1),
              ∫ z : JointWaveSpaceTime,
                ‖iteratedFDeriv Real r (M : JointWaveSpaceTime → Complex) z‖) := by ring
      _ ≤ (2 : Real) ^ 6 * CD := by
            exact mul_le_mul (pow_le_pow_right₀ (by norm_num) hmone) hsum'
              hsum'_nonneg (by positivity)
  have hsup : J.sup P (𝓕⁻ M) ≤ ((2 : Real) ^ 6 * CD) / scale ^ N := by
    apply Seminorm.finset_sup_apply_le
    · exact div_nonneg (mul_nonneg (by positivity) hCD_nonneg) hscaleNnonneg
    intro m hm
    apply (mul_le_mul_iff_of_pos_left hscaleNpos).mp
    calc
      scale ^ N * P m (𝓕⁻ M) ≤ (2 : Real) ^ 6 * CD := hPscaled m hm
      _ = scale ^ N * (((2 : Real) ^ 6 * CD) / scale ^ N) := by
        field_simp [hscaleNpos.ne']
  change scale ^ N * J.sup P (𝓕⁻ M) ≤ (2 : Real) ^ 6 * CD
  calc
    scale ^ N * J.sup P (𝓕⁻ M) ≤
        scale ^ N * (((2 : Real) ^ 6 * CD) / scale ^ N) :=
      mul_le_mul_of_nonneg_left hsup hscaleNnonneg
    _ = (2 : Real) ^ 6 * CD := by field_simp [hscaleNpos.ne']

/-- The finite physical seminorm budget gives a uniform spatial `L¹` kernel
slice with quadratic temporal decay. -/
private theorem scratchWavefrontRapidMultiplierBounds.exists_weighted_sliceMass_bound
    {D : MSSWavefrontKernelData}
    (hrapid : scratchWavefrontRapidMultiplierBounds D) (N : Nat) :
    ∃ A : Real, 0 ≤ A ∧
      ∀ (scale : Real) (hscale : 0 < scale) (n nu : Int), 2 ≤ scale →
        n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
        ∀ t : Real,
          (1 + |t|) ^ 2 *
            (∫ x : Euclidean 2,
              ‖jointSchwartzRaw
                (𝓕⁻ (scratchWavefrontPacketResidualMultiplier D scale hscale n nu) :
                  SchwartzMap JointWaveSpaceTime Complex) (x, t)‖) ≤
            A * (scale⁻¹) ^ N := by
  rcases hrapid.exists_iic_seminorm_bound N with ⟨C, hC, hCbound⟩
  let I : Real := ∫ x : Euclidean 2, (1 + ‖x‖) ^ (-(4 : Real))
  let L : Real := (2 : Real) ^ 4 * ((2 : Real) ^ 6 + (2 : Real) ^ 6) * I
  have hI : 0 ≤ I := by
    dsimp only [I]
    exact integral_nonneg fun _ => Real.rpow_nonneg (by positivity) _
  have hL : 0 ≤ L := by
    dsimp only [L]
    exact mul_nonneg (mul_nonneg (by positivity) (by positivity)) hI
  refine ⟨L * C, mul_nonneg hL hC, ?_⟩
  intro scale hscale n nu hscale_two hn hnu t
  let M : SchwartzMap JointWaveSpaceTime Complex :=
    scratchWavefrontPacketResidualMultiplier D scale hscale n nu
  let K : SchwartzMap JointWaveSpaceTime Complex := 𝓕⁻ M
  let S : Real := ((Finset.Iic (6, 0)).sup fun m =>
    SchwartzMap.seminorm Complex m.1 m.2) K
  have hscaleNpos : 0 < scale ^ N := pow_pos hscale N
  have hS : scale ^ N * S ≤ C := by
    simpa only [M, K, S] using hCbound scale hscale n nu hscale_two hn hnu
  have hSbound : S ≤ C * (scale⁻¹) ^ N := by
    calc
      S ≤ C / scale ^ N :=
        (le_div_iff₀ hscaleNpos).2 (by simpa [mul_comm] using hS)
      _ = C * (scale⁻¹) ^ N := by
        rw [div_eq_mul_inv, inv_pow]
  have hslice := scratch_weighted_spatial_mass_jointSchwartzRaw_le K 2 t
  calc
    (1 + |t|) ^ 2 *
        (∫ x : Euclidean 2, ‖jointSchwartzRaw K (x, t)‖) ≤
        (2 : Real) ^ 4 * ((2 : Real) ^ 6 * S + (2 : Real) ^ 6 * S) * I := by
          simpa only [K, S] using hslice
    _ = L * S := by
      dsimp only [L]
      ring
    _ ≤ L * (C * (scale⁻¹) ^ N) :=
      mul_le_mul_of_nonneg_left hSbound hL
    _ = (L * C) * (scale⁻¹) ^ N := by ring

/-- Conversion of a real weighted spatial integral estimate into the
ENNReal slice-mass form consumed by mixed Young. -/
private theorem scratch_wavefront_lintegral_enorm_slice_le_of_weighted_integral_norm_le
    {E : Type*} [NormedAddCommGroup E]
    (K : Euclidean 2 → Real → E)
    (hK : ∀ t : Real, Integrable (fun x : Euclidean 2 => K x t) volume)
    (A scale : Real) (N : Nat)
    (hbound : ∀ t : Real,
      (1 + |t|) ^ 2 *
          (∫ x : Euclidean 2, ‖K x t‖) ≤ A * (scale⁻¹) ^ N) :
    ∀ t : Real,
      (∫⁻ x : Euclidean 2, ‖K x t‖ₑ) ≤
        ENNReal.ofReal (A * (scale⁻¹) ^ N) *
          ENNReal.ofReal (((1 + |t|)⁻¹) ^ 2) := by
  intro t
  have hbase_pos : 0 < 1 + |t| := by positivity
  have hweight_pos : 0 < (1 + |t|) ^ 2 := pow_pos hbase_pos _
  have hInonneg : 0 ≤ ∫ x : Euclidean 2, ‖K x t‖ :=
    integral_nonneg fun _ => norm_nonneg _
  have hBnonneg : 0 ≤ A * (scale⁻¹) ^ N := by
    exact (mul_nonneg hweight_pos.le hInonneg).trans (hbound t)
  have hreal :
      (∫ x : Euclidean 2, ‖K x t‖) ≤
        (A * (scale⁻¹) ^ N) * ((1 + |t|)⁻¹) ^ 2 := by
    calc
      (∫ x : Euclidean 2, ‖K x t‖) ≤
          (A * (scale⁻¹) ^ N) / (1 + |t|) ^ 2 :=
        (le_div_iff₀ hweight_pos).2 (by simpa [mul_comm] using hbound t)
      _ = (A * (scale⁻¹) ^ N) * ((1 + |t|)⁻¹) ^ 2 := by
        rw [div_eq_mul_inv, ← inv_pow]
  change (∫⁻ x : Euclidean 2, ‖K x t‖ₑ) ≤ _
  rw [← ofReal_integral_norm_eq_lintegral_enorm (hK t)]
  calc
    ENNReal.ofReal (∫ x : Euclidean 2, ‖K x t‖) ≤
        ENNReal.ofReal
          ((A * (scale⁻¹) ^ N) * ((1 + |t|)⁻¹) ^ 2) :=
      ENNReal.ofReal_le_ofReal hreal
    _ = ENNReal.ofReal (A * (scale⁻¹) ^ N) *
        ENNReal.ofReal (((1 + |t|)⁻¹) ^ 2) :=
      ENNReal.ofReal_mul hBnonneg

private def scratch_wavefront_tailWeight (t : Real) : Real := (1 + t ^ 2)⁻¹

private theorem scratch_wavefront_tailWeight_nonneg (t : Real) :
    0 ≤ scratch_wavefront_tailWeight t := by
  unfold scratch_wavefront_tailWeight
  positivity

private theorem scratch_wavefront_tailWeight_le_one (t : Real) :
    scratch_wavefront_tailWeight t ≤ 1 := by
  unfold scratch_wavefront_tailWeight
  have hbase : 1 ≤ 1 + t ^ 2 := by nlinarith [sq_nonneg t]
  exact (inv_le_one₀ (by positivity)).mpr hbase

private theorem scratch_wavefront_tailWeight_continuous :
    Continuous scratch_wavefront_tailWeight := by
  unfold scratch_wavefront_tailWeight
  exact (continuous_const.add (continuous_id.pow 2)).inv₀
    (fun t => by
      have : 0 < 1 + t ^ 2 := by nlinarith [sq_nonneg t]
      exact ne_of_gt this)

private theorem scratch_wavefront_tailWeight_integrable :
    Integrable scratch_wavefront_tailWeight := by
  exact integrable_inv_one_add_sq

private theorem scratch_wavefront_tailWeight_rpow_integrable
    (p : ENNReal) (hp : 1 ≤ p) (htop : p ≠ ∞) :
    Integrable (fun t : Real => scratch_wavefront_tailWeight t ^ p.toReal) := by
  refine scratch_wavefront_tailWeight_integrable.mono' ?_ ?_
  · exact (scratch_wavefront_tailWeight_continuous.rpow_const
      (fun _ => Or.inr ENNReal.toReal_nonneg)).aestronglyMeasurable
  · filter_upwards with t
    rw [Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg (scratch_wavefront_tailWeight_nonneg t) _)]
    have hpReal : 1 ≤ p.toReal := by
      simpa using ENNReal.toReal_mono htop hp
    exact Real.rpow_le_self_of_le_one
      (scratch_wavefront_tailWeight_nonneg t) (scratch_wavefront_tailWeight_le_one t) hpReal

private theorem scratch_wavefront_tailWeight_eLpNorm_lt_top
    (p : ENNReal) (hp : 1 ≤ p) :
    eLpNorm scratch_wavefront_tailWeight p volume < ∞ := by
  by_cases htop : p = ∞
  · rw [htop, eLpNorm_exponent_top]
    exact eLpNormEssSup_lt_top_of_ae_bound
      (Eventually.of_forall fun t => by
        rw [Real.norm_eq_abs, abs_of_nonneg (scratch_wavefront_tailWeight_nonneg t)]
        exact scratch_wavefront_tailWeight_le_one t)
  · have hp0 : p ≠ 0 := by
      exact ne_of_gt (lt_of_lt_of_le zero_lt_one hp)
    apply (eLpNorm_lt_top_iff_lintegral_rpow_enorm_lt_top hp0 htop).mpr
    have hpow := scratch_wavefront_tailWeight_rpow_integrable p hp htop
    have hfin :
        (∫⁻ t : Real, ‖scratch_wavefront_tailWeight t ^ p.toReal‖ₑ) < ∞ :=
      hpow.hasFiniteIntegral
    convert hfin using 1
    apply lintegral_congr
    intro t
    exact (Real.enorm_rpow_of_nonneg (scratch_wavefront_tailWeight_nonneg t)
      ENNReal.toReal_nonneg).symm

private theorem scratch_wavefront_eLpNorm_sliceMass_le_tailWeight
    (p : ENNReal) (S : Real → ENNReal) (c : ENNReal)
    (hS : ∀ t : Real,
      S t ≤ c * ENNReal.ofReal (scratch_wavefront_tailWeight t)) :
    eLpNorm S p volume ≤ c * eLpNorm scratch_wavefront_tailWeight p volume := by
  apply eLpNorm_le_mul_eLpNorm_of_ae_le_mul'' p
    scratch_wavefront_tailWeight_continuous.aestronglyMeasurable
  filter_upwards with t
  simpa [Real.enorm_of_nonneg (scratch_wavefront_tailWeight_nonneg t)] using hS t

private theorem scratch_wavefront_absTail_le_tailWeight (t : Real) :
    ((1 + |t|)⁻¹) ^ (2 : Nat) ≤ scratch_wavefront_tailWeight t := by
  have hpos : 0 < (1 + t ^ 2 : Real) := by nlinarith [sq_nonneg t]
  have hden : 1 + t ^ 2 ≤ (1 + |t|) ^ (2 : Nat) := by
    nlinarith [sq_abs t, abs_nonneg t]
  unfold scratch_wavefront_tailWeight
  have hinv := one_div_le_one_div_of_le hpos hden
  simpa [one_div, inv_pow] using hinv

/-- Quadratic temporal slice decay gives a rapid `L⁴` slice-mass bound with
one scale-independent coefficient. -/
private theorem scratch_wavefront_exists_eLpNorm_sliceMass_four_decay
    (A : Real) (N : Nat) (hA : 0 ≤ A) :
    ∃ C : Real, 0 < C ∧ ∀ scale : Real, 0 < scale →
      ∀ S : Real → ENNReal,
      (∀ t : Real,
        S t ≤ ENNReal.ofReal
          (A * (scale⁻¹) ^ N * ((1 + |t|)⁻¹) ^ (2 : Nat))) →
      eLpNorm S 4 volume ≤ ENNReal.ofReal (C * (scale⁻¹) ^ N) := by
  let W : ENNReal := eLpNorm scratch_wavefront_tailWeight 4 volume
  let B : Real := W.toReal
  have hWlt : W < ∞ := scratch_wavefront_tailWeight_eLpNorm_lt_top 4 (by norm_num)
  have hW : W ≠ ∞ := hWlt.ne
  refine ⟨A * B + 1, ?_, ?_⟩
  · have hAB : 0 ≤ A * B := mul_nonneg hA ENNReal.toReal_nonneg
    linarith
  · intro scale hscale S hS
    have hsnonneg : 0 ≤ (scale⁻¹) ^ N :=
      pow_nonneg (inv_nonneg.mpr hscale.le) _
    have hAsnonneg : 0 ≤ A * (scale⁻¹) ^ N :=
      mul_nonneg hA hsnonneg
    have htail : ∀ t : Real,
        S t ≤ ENNReal.ofReal (A * (scale⁻¹) ^ N) *
          ENNReal.ofReal (scratch_wavefront_tailWeight t) := by
      intro t
      have ht := hS t
      rw [ENNReal.ofReal_mul hAsnonneg] at ht
      refine ht.trans ?_
      gcongr
      exact scratch_wavefront_absTail_le_tailWeight t
    have hcoeff := scratch_wavefront_eLpNorm_sliceMass_le_tailWeight 4 S
      (ENNReal.ofReal (A * (scale⁻¹) ^ N)) htail
    calc
      eLpNorm S 4 volume ≤ ENNReal.ofReal (A * (scale⁻¹) ^ N) * W := hcoeff
      _ = ENNReal.ofReal ((A * B) * (scale⁻¹) ^ N) := by
        rw [← ENNReal.ofReal_toReal hW]
        rw [← ENNReal.ofReal_mul hAsnonneg]
        congr 1
        ring
      _ ≤ ENNReal.ofReal ((A * B + 1) * (scale⁻¹) ^ N) := by
        apply ENNReal.ofReal_le_ofReal
        calc
          (A * B) * (scale⁻¹) ^ N ≤
              (A * B) * (scale⁻¹) ^ N + 1 * (scale⁻¹) ^ N :=
            le_add_of_nonneg_right (by simpa using hsnonneg)
          _ = (A * B + 1) * (scale⁻¹) ^ N := by ring

/-- A joint Schwartz inverse transform has integrable planar slices. -/
private theorem scratch_wavefront_integrable_jointSchwartzRaw_slice
    (K : SchwartzMap JointWaveSpaceTime Complex) (t : Real) :
    Integrable (fun x : Euclidean 2 => jointSchwartzRaw K (x, t)) volume := by
  let S : Real := (2 : Real) ^ 4 *
    ((Finset.Iic (4, 0)).sup fun m =>
      SchwartzMap.seminorm Complex m.1 m.2) K
  have hrawcont : Continuous (fun x : Euclidean 2 =>
      jointSchwartzRaw K (x, t)) := by
    change Continuous (fun x : Euclidean 2 => K (WithLp.toLp 2 (x, t)))
    exact K.continuous.comp
      ((WithLp.prod_continuous_toLp 2 (Euclidean 2) Real).comp
        (continuous_id.prodMk continuous_const))
  have hmeas : AEStronglyMeasurable (fun x : Euclidean 2 =>
      jointSchwartzRaw K (x, t)) volume := hrawcont.aestronglyMeasurable
  have hpoint : ∀ x : Euclidean 2,
      ‖jointSchwartzRaw K (x, t)‖ ≤ S * (1 + ‖x‖) ^ (-(4 : Real)) := by
    intro x
    let z : JointWaveSpaceTime := WithLp.toLp 2 (x, t)
    have hx : ‖x‖ ≤ ‖z‖ := by
      dsimp only [z]
      simpa using (WithLp.norm_fst_le (p := 2) (Euclidean 2)
        (WithLp.toLp 2 (x, t)))
    have hweight : (1 + ‖x‖) ^ 4 ≤ (1 + ‖z‖) ^ 4 := by
      gcongr
    have hsemi := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := Complex)
      (m := (4, (0 : Nat))) (k := 4) (n := (0 : Nat))
      (le_refl _) (le_refl _) K z
    simp only [norm_iteratedFDeriv_zero] at hsemi
    change ‖K z‖ ≤ S * (1 + ‖x‖) ^ (-(4 : Real))
    have hbase_pos : 0 < (1 + ‖x‖) ^ (4 : Nat) := by positivity
    have hsemi' : (1 + ‖x‖) ^ (4 : Nat) * ‖K z‖ ≤ S := by
      calc
        (1 + ‖x‖) ^ (4 : Nat) * ‖K z‖ ≤
            (1 + ‖z‖) ^ (4 : Nat) * ‖K z‖ :=
          mul_le_mul_of_nonneg_right hweight (norm_nonneg _)
        _ ≤ S := hsemi
    have hdiv : ‖K z‖ ≤ S / (1 + ‖x‖) ^ (4 : Nat) :=
      (le_div_iff₀ hbase_pos).2 (by simpa [mul_comm] using hsemi')
    rw [div_eq_mul_inv, ← inv_pow] at hdiv
    calc
      ‖K z‖ ≤ S * (1 + ‖x‖)⁻¹ ^ (4 : Nat) := hdiv
      _ = S * (1 + ‖x‖) ^ (-(4 : Real)) := by
        congr 1
        rw [Real.rpow_neg (by positivity)]
        norm_num [Real.rpow_natCast, inv_pow]
  have hweight : Integrable (fun x : Euclidean 2 =>
      S * (1 + ‖x‖) ^ (-(4 : Real))) volume := by
    have hdim : (Module.finrank Real (Euclidean 2) : Real) < 4 := by norm_num
    exact (integrable_one_add_norm hdim).const_mul S
  exact hweight.mono' hmeas (Eventually.of_forall hpoint)

/-- One-packet rapid wave-front localization.  This is an actual
`f → space-time` estimate for the inverse multiplier residual, obtained from
the explicit spectral derivative condition by Fourier integration by parts,
kernel slices, and mixed Young. -/
private theorem scratchWavefrontRapidMultiplierBounds.exists_packet_L4_rapid_bound
    {D : MSSWavefrontKernelData}
    (hrapid : scratchWavefrontRapidMultiplierBounds D) (N : Nat) :
    ∃ C : Real, 0 < C ∧
      ∀ (scale : Real) (hscale : 0 < scale) (n nu : Int), 2 ≤ scale →
        n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
        ∀ f : SchwartzMap (Euclidean 2) Complex,
          eLpNorm (scratchWavefrontPacketResidual D scale hscale n nu f) 4 volume ≤
            ENNReal.ofReal (C * (scale⁻¹) ^ N) *
              eLpNorm (f : Euclidean 2 → Complex) 4 volume := by
  rcases hrapid.exists_weighted_sliceMass_bound N with ⟨A, hA, hAbound⟩
  rcases scratch_wavefront_exists_eLpNorm_sliceMass_four_decay A N hA with
    ⟨C, hCpos, hCbound⟩
  refine ⟨C, hCpos, ?_⟩
  intro scale hscale n nu hscale_two hn hnu f
  let M : SchwartzMap JointWaveSpaceTime Complex :=
    scratchWavefrontPacketResidualMultiplier D scale hscale n nu
  let K : WaveSpaceTime → Complex :=
    spaceTimeFourierInv (jointSchwartzRaw M)
  have hKraw : K = jointSchwartzRaw (𝓕⁻ M : SchwartzMap JointWaveSpaceTime Complex) := by
    funext z
    dsimp only [K]
    rw [spaceTimeFourierInv_jointSchwartzRaw]
    change FourierTransform.fourierInv (M : JointWaveSpaceTime → Complex)
        (WithLp.toLp 2 z) =
      (𝓕⁻ M : SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 z)
    exact (congrFun (SchwartzMap.fourierInv_coe M) (WithLp.toLp 2 z)).symm
  have hKcont : Continuous K := by
    rw [hKraw]
    change Continuous (fun z : WaveSpaceTime =>
      (𝓕⁻ M : SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 z))
    exact (𝓕⁻ M).continuous.comp
      (WithLp.prod_continuous_toLp 2 (Euclidean 2) Real)
  have hKslice : ∀ t : Real,
      Integrable (fun x : Euclidean 2 => K (x, t)) volume := by
    intro t
    rw [hKraw]
    exact scratch_wavefront_integrable_jointSchwartzRaw_slice (𝓕⁻ M) t
  have hweighted : ∀ t : Real,
      (1 + |t|) ^ 2 *
          (∫ x : Euclidean 2, ‖K (x, t)‖) ≤ A * (scale⁻¹) ^ N := by
    intro t
    rw [hKraw]
    simpa only [M] using hAbound scale hscale n nu hscale_two hn hnu t
  let S : Real → ENNReal := fun t =>
    ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ
  have hS : ∀ t : Real,
      S t ≤ ENNReal.ofReal
        (A * (scale⁻¹) ^ N * ((1 + |t|)⁻¹) ^ (2 : Nat)) := by
    intro t
    dsimp only [S]
    have hslice := scratch_wavefront_lintegral_enorm_slice_le_of_weighted_integral_norm_le
      (fun x t => K (x, t)) hKslice A scale N hweighted t
    rw [ENNReal.ofReal_mul (mul_nonneg hA
      (pow_nonneg (inv_nonneg.mpr hscale.le) _))]
    exact hslice
  have hSbound := hCbound scale hscale S hS
  have hYoung := scratch_wavefront_mixed_spatial_convolution_four_young
    K (f : Euclidean 2 → Complex) hKcont f.continuous
  have hres : scratchWavefrontPacketResidual D scale hscale n nu f =
      fun z : WaveSpaceTime => ∫ y : Euclidean 2,
        K (y, z.2) * f (z.1 - y) := by
    funext z
    change spaceTimeFourierInv (fun zeta : WaveSpaceTime =>
      jointSchwartzRaw M zeta *
        FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1) z = _
    calc
      spaceTimeFourierInv (fun zeta : WaveSpaceTime =>
        jointSchwartzRaw M zeta *
          FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1) z =
          ∫ y : Euclidean 2,
            spaceTimeFourierInv (jointSchwartzRaw M) (z.1 - y, z.2) * f y :=
        scratch_wavefront_inverse_factorizedSpectrum_eq_sourceKernel M f z.1 z.2
      _ = ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y) := by
        rw [scratch_wavefront_sourceKernel_convolution_orientation]
  rw [hres]
  calc
    eLpNorm (fun z : WaveSpaceTime => ∫ y : Euclidean 2,
        K (y, z.2) * f (z.1 - y)) 4 volume ≤
        eLpNorm S 4 volume * eLpNorm (f : Euclidean 2 → Complex) 4 volume := by
          simpa only [S] using hYoung
    _ ≤ ENNReal.ofReal (C * (scale⁻¹) ^ N) *
        eLpNorm (f : Euclidean 2 → Complex) 4 volume :=
      mul_le_mul_left hSbound _

/- Private normal-gap and finite-aggregation closure for wave-front localization. -/
open scoped BigOperators

/- Source-local versions of the radial-time derivative and normal-shear
   ingredients. The corresponding earlier declarations are lexical-private
   to the radial-time localization development; these remain private and
   serve only the present wave-front closure. -/

private noncomputable def scratchScaledNormalCoordinate
    (D : MSSRadialTimeCutoffs) (scale : Real) (xi : Euclidean 2) : Real :=
  scale * D.normalExtension (scale⁻¹ • xi)

private theorem exists_scratch_scaledNormalExtension_iteratedFDeriv_uniform_bound
    (D : MSSRadialTimeCutoffs) (k : Nat) (hk : 1 ≤ k) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ xi : Euclidean 2,
        ‖iteratedFDeriv Real k
          (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) xi‖ ≤ C := by
  obtain ⟨C, hCpos, hC⟩ := D.normalExtension.decay 0 k
  refine ⟨C, hCpos.le, ?_⟩
  intro scale hscale hscaleone xi
  have hfun :
      (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) =
        fun y : Euclidean 2 => scale • D.normalExtension (scale⁻¹ • y) := by
    funext y
    rw [scratchScaledNormalExtension_apply]
    rfl
  have hsmooth : ContDiff Real k
      (fun y : Euclidean 2 => D.normalExtension (scale⁻¹ • y)) := by
    exact (D.normalExtension.smooth (k : ℕ∞)).comp
      (contDiff_id.const_smul scale⁻¹)
  have hchain : iteratedFDeriv Real k
      (fun y : Euclidean 2 => D.normalExtension (scale⁻¹ • y)) xi =
        scale⁻¹ ^ k • iteratedFDeriv Real k
          (D.normalExtension : Euclidean 2 → Real) (scale⁻¹ • xi) := by
    simpa using congrFun
      (iteratedFDeriv_comp_const_smul scale⁻¹
        (D.normalExtension.smooth (k : ℕ∞))) xi
  rw [hfun]
  change ‖iteratedFDeriv Real k
      (scale • (fun y : Euclidean 2 => D.normalExtension (scale⁻¹ • y))) xi‖ ≤ C
  rw [iteratedFDeriv_const_smul_apply hsmooth.contDiffAt, hchain,
    norm_smul, norm_smul]
  simp only [Real.norm_eq_abs, abs_of_pos hscale,
    abs_pow, abs_of_nonneg (inv_nonneg.mpr hscale.le)]
  have hpow : scale * scale⁻¹ ^ k ≤ 1 := by
    have hinv : scale⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hscaleone
    have hinv0 : 0 ≤ scale⁻¹ := inv_nonneg.mpr hscale.le
    have hinvpow : scale⁻¹ ^ (k - 1) ≤ 1 :=
      pow_le_one₀ hinv0 hinv
    have hk' : k = (k - 1) + 1 := (Nat.sub_add_cancel hk).symm
    calc
      scale * scale⁻¹ ^ k = scale * scale⁻¹ ^ ((k - 1) + 1) := by
        rw [congrArg (fun j : Nat => scale⁻¹ ^ j) hk']
      _ = scale * (scale⁻¹ ^ (k - 1) * scale⁻¹) := by rw [pow_succ]
      _ = (scale * scale⁻¹) * scale⁻¹ ^ (k - 1) := by ring
      _ = scale⁻¹ ^ (k - 1) := by field_simp [hscale.ne']
      _ ≤ 1 := hinvpow
  calc
    scale * (scale⁻¹ ^ k *
        ‖iteratedFDeriv Real k (D.normalExtension : Euclidean 2 → Real)
          (scale⁻¹ • xi)‖) =
      (scale * scale⁻¹ ^ k) *
        ‖iteratedFDeriv Real k (D.normalExtension : Euclidean 2 → Real)
          (scale⁻¹ • xi)‖ := by ring
    _ ≤ 1 * ‖iteratedFDeriv Real k (D.normalExtension : Euclidean 2 → Real)
      (scale⁻¹ • xi)‖ := by
      gcongr
    _ ≤ C := by
      simpa using hC (scale⁻¹ • xi)

private noncomputable def scratchJointNormalDifference
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) :
    JointWaveSpaceTime → Real :=
  fun z => z.snd - scratchScaledNormalExtension D scale hscale z.fst

private theorem scratchJointNormalDifference_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (xi : Euclidean 2) (tau : Real) :
    scratchJointNormalDifference D scale hscale (WithLp.toLp 2 (xi, tau)) =
      tau - scratchScaledNormalCoordinate D scale xi := by
  simp [scratchJointNormalDifference, scratchScaledNormalExtension_apply,
    scratchScaledNormalCoordinate]

private noncomputable def scratchTemporalDerivativeProfile
    (h : SchwartzMap Real Complex) (i : Nat) : SchwartzMap Real Complex :=
  (SchwartzMap.derivCLM Complex Complex)^[i] h

private theorem scratchTemporalDerivativeProfile_apply
    (h : SchwartzMap Real Complex) (i : Nat) (u : Real) :
    scratchTemporalDerivativeProfile h i u =
      iteratedDeriv i (h : Real → Complex) u := by
  induction i generalizing u with
  | zero => simp [scratchTemporalDerivativeProfile, iteratedDeriv_zero]
  | succ i ih =>
      rw [scratchTemporalDerivativeProfile, Function.iterate_succ_apply',
        SchwartzMap.derivCLM_apply]
      change deriv (fun v : Real => scratchTemporalDerivativeProfile h i v) u = _
      rw [show (fun v : Real => scratchTemporalDerivativeProfile h i v) =
        iteratedDeriv i (h : Real → Complex) by
          funext v
          exact ih v,
        ← iteratedDeriv_succ]

private noncomputable def scratchWeightedTemporalDerivativeProfile
    (h : SchwartzMap Real Complex) (i N : Nat) : SchwartzMap Real Complex :=
  SchwartzMap.smulLeftCLM Complex (fun s : Real => (1 + s ^ 2) ^ N)
    (scratchTemporalDerivativeProfile h i)

private theorem scratchWeightedTemporalDerivativeProfile_apply
    (h : SchwartzMap Real Complex) (i N : Nat) (u : Real) :
    scratchWeightedTemporalDerivativeProfile h i N u =
      ((1 + u ^ 2) ^ N : Real) • iteratedDeriv i (h : Real → Complex) u := by
  unfold scratchWeightedTemporalDerivativeProfile
  rw [SchwartzMap.smulLeftCLM_apply
    (show (fun s : Real => (1 + s ^ 2) ^ N).HasTemperateGrowth by fun_prop)]
  change ((1 + u ^ 2) ^ N : Real) • scratchTemporalDerivativeProfile h i u = _
  rw [scratchTemporalDerivativeProfile_apply]

/-- Outside the normal tube, a fixed polynomially weighted Schwartz
derivative dominates the unweighted derivative with the desired scale gain. -/
private theorem scale_pow_mul_norm_iteratedFDeriv_time_le_weighted_profile
    (h : SchwartzMap Real Complex) (i N : Nat) (scale u : Real)
    (hscale : 0 ≤ scale) (hu : Real.sqrt scale ≤ |u|) :
    scale ^ N * ‖iteratedFDeriv Real i (h : Real → Complex) u‖ ≤
      ‖scratchWeightedTemporalDerivativeProfile h i N u‖ := by
  rw [scratchWeightedTemporalDerivativeProfile_apply, norm_smul,
    Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (by positivity) _),
    norm_iteratedFDeriv_eq_norm_iteratedDeriv]
  have hscale_le_u2 : scale ≤ u ^ 2 := by
    calc
      scale = Real.sqrt scale ^ 2 := by rw [Real.sq_sqrt hscale]
      _ ≤ |u| ^ 2 := by
        exact pow_le_pow_left₀ (Real.sqrt_nonneg _) hu _
      _ = u ^ 2 := by rw [sq_abs]
  have hscale_le : scale ≤ 1 + u ^ 2 := hscale_le_u2.trans (by linarith)
  have hpow : scale ^ N ≤ (1 + u ^ 2) ^ N := by
    exact pow_le_pow_left₀ hscale hscale_le N
  gcongr

private theorem norm_iteratedFDeriv_continuousLinearMap_le_one
    (L : JointWaveSpaceTime →L[Real] Real) (hL : ‖L‖ ≤ 1)
    (k : Nat) (hk : 1 ≤ k) (z : JointWaveSpaceTime) :
    ‖iteratedFDeriv Real k (L : JointWaveSpaceTime → Real) z‖ ≤ 1 := by
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, (Nat.sub_add_cancel hk).symm⟩
  rw [← norm_iteratedFDeriv_fderiv]
  have hf : fderiv Real (L : JointWaveSpaceTime → Real) = fun _ => L := by
    funext w
    exact L.fderiv
  rw [hf]
  cases j with
  | zero =>
      simpa [norm_iteratedFDeriv_zero] using hL
  | succ j =>
      rw [iteratedFDeriv_const_of_ne (Nat.succ_ne_zero j) L]
      simp

private theorem scratch_joint_fstL_norm_le_one :
    ‖WithLp.fstL 2 Real (Euclidean 2) Real‖ ≤ 1 := by
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
  intro z
  simpa using WithLp.norm_fst_le (p := 2) (Euclidean 2) z

private theorem scratch_joint_sndL_norm_le_one :
    ‖WithLp.sndL 2 Real (Euclidean 2) Real‖ ≤ 1 := by
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
  intro z
  simpa using WithLp.norm_snd_le (p := 2) (Euclidean 2) z

private theorem norm_iteratedFDeriv_scratchScaledNormalExtension_comp_fst_le
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (k : Nat) (z : JointWaveSpaceTime) :
    ‖iteratedFDeriv Real k
      (fun w : JointWaveSpaceTime =>
        scratchScaledNormalExtension D scale hscale w.fst) z‖ ≤
      ‖iteratedFDeriv Real k
        (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) z.fst‖ := by
  let L : JointWaveSpaceTime →L[Real] Euclidean 2 :=
    WithLp.fstL 2 Real (Euclidean 2) Real
  change ‖iteratedFDeriv Real k
    ((scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) ∘ L) z‖ ≤ _
  rw [L.iteratedFDeriv_comp_right
    ((scratchScaledNormalExtension D scale hscale).smooth (k : ℕ∞)) z
    le_rfl]
  calc
    ‖(iteratedFDeriv Real k
        (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) (L z)).compContinuousLinearMap
          (fun _ => L)‖ ≤
        ‖iteratedFDeriv Real k
          (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) (L z)‖ *
          ∏ _ : Fin k, ‖L‖ :=
      ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv Real k
          (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) (L z)‖ *
          ∏ _ : Fin k, (1 : Real) := by
      gcongr
      exact scratch_joint_fstL_norm_le_one
    _ = ‖iteratedFDeriv Real k
          (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) z.fst‖ := by
      simp [L]

private theorem exists_scratchJointNormalDifference_iteratedFDeriv_uniform_bound
    (D : MSSRadialTimeCutoffs) (k : Nat) (hk : 1 ≤ k) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ z : JointWaveSpaceTime,
        ‖iteratedFDeriv Real k
          (scratchJointNormalDifference D scale hscale : JointWaveSpaceTime → Real) z‖ ≤ C := by
  obtain ⟨C, hCnonneg, hC⟩ :=
    exists_scratch_scaledNormalExtension_iteratedFDeriv_uniform_bound D k hk
  refine ⟨1 + C, by linarith, ?_⟩
  intro scale hscale hscaleone z
  let Ls : JointWaveSpaceTime →L[Real] Real :=
    WithLp.sndL 2 Real (Euclidean 2) Real
  let Lf : JointWaveSpaceTime →L[Real] Euclidean 2 :=
    WithLp.fstL 2 Real (Euclidean 2) Real
  let rho : SchwartzMap (Euclidean 2) Real := scratchScaledNormalExtension D scale hscale
  have hsnd : ContDiffAt Real k (fun w : JointWaveSpaceTime => Ls w) z := by
    fun_prop
  have hrhofst : ContDiffAt Real k (fun w : JointWaveSpaceTime => rho (Lf w)) z := by
    exact ((rho.smooth (k : ℕ∞)).comp_continuousLinearMap (g := Lf)).contDiffAt
  have hrepr : (scratchJointNormalDifference D scale hscale : JointWaveSpaceTime → Real) =
      fun w => Ls w - rho (Lf w) := by
    funext w
    change w.snd - scratchScaledNormalExtension D scale hscale w.fst =
      WithLp.sndL 2 Real (Euclidean 2) Real w -
        scratchScaledNormalExtension D scale hscale
          (WithLp.fstL 2 Real (Euclidean 2) Real w)
    rfl
  rw [hrepr,
    show (fun w : JointWaveSpaceTime => Ls w - rho (Lf w)) =
      (fun w => Ls w) - (fun w => rho (Lf w)) by rfl,
    iteratedFDeriv_sub_apply hsnd hrhofst]
  calc
    ‖iteratedFDeriv Real k (fun w : JointWaveSpaceTime => Ls w) z -
        iteratedFDeriv Real k (fun w : JointWaveSpaceTime => rho (Lf w)) z‖ ≤
        ‖iteratedFDeriv Real k (fun w : JointWaveSpaceTime => Ls w) z‖ +
          ‖iteratedFDeriv Real k (fun w : JointWaveSpaceTime => rho (Lf w)) z‖ :=
      norm_sub_le _ _
    _ ≤ 1 + C := by
      gcongr
      · exact norm_iteratedFDeriv_continuousLinearMap_le_one Ls
          (by simpa [Ls] using scratch_joint_sndL_norm_le_one) k hk z
      · exact (norm_iteratedFDeriv_scratchScaledNormalExtension_comp_fst_le
          D scale hscale k z).trans (hC scale hscale hscaleone z.fst)

private theorem scratch_normal_shear_measurePreserving
    (rho : SchwartzMap (Euclidean 2) Real) :
    MeasurePreserving
      (fun z : WaveSpaceTime => (z.1, z.2 - rho z.1)) volume volume := by
  rw [Measure.volume_eq_prod]
  refine (MeasurePreserving.id (volume : Measure (Euclidean 2))).skew_product
    (g := fun xi (t : Real) => t - rho xi) ?_ ?_
  · exact measurable_snd.sub (rho.continuous.measurable.comp measurable_fst)
  · filter_upwards with xi
    simpa only [sub_eq_add_neg] using
      (measurePreserving_add_right (volume : Measure Real) (-rho xi)).map_eq

/-- The literal nonnegative spatial--normal product is integrable after a
normal shear whenever its spatial factor is integrable and its temporal
factor is Schwartz. -/
private theorem integrable_sheared_norm_mul_norm
    {E : Type*} [NormedAddCommGroup E]
    (A : Euclidean 2 → E) (hA : Integrable A)
    (H : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    Integrable (fun z : WaveSpaceTime =>
      ‖A z.1‖ * ‖H (z.2 - rho z.1)‖) := by
  let shear : WaveSpaceTime → WaveSpaceTime :=
    fun z => (z.1, z.2 - rho z.1)
  let P : WaveSpaceTime → Real := fun z => ‖A z.1‖ * ‖H z.2‖
  have hP : Integrable P volume := by
    rw [Measure.volume_eq_prod]
    exact hA.norm.mul_prod H.integrable.norm
  have hshear : MeasurePreserving shear volume volume := by
    simpa only [shear] using scratch_normal_shear_measurePreserving rho
  have hcomp : Integrable (P ∘ shear) volume :=
    (hshear.integrable_comp hP.aestronglyMeasurable).mpr hP
  have heq : P ∘ shear = fun z : WaveSpaceTime =>
      ‖A z.1‖ * ‖H (z.2 - rho z.1)‖ := by
    funext z
    rfl
  rw [← heq]
  exact hcomp

/-- The same literal shear product on the joint Hilbert `WithLp` coordinate
model is integrable; this is transport through `WithLp.toLp`. -/
private theorem integrable_joint_sheared_norm_mul_norm
    {E : Type*} [NormedAddCommGroup E]
    (A : Euclidean 2 → E) (hA : Integrable A)
    (H : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    Integrable (fun z : JointWaveSpaceTime =>
      ‖A z.fst‖ * ‖H (z.snd - rho z.fst)‖) := by
  let Q : JointWaveSpaceTime → Real := fun z =>
    ‖A z.fst‖ * ‖H (z.snd - rho z.fst)‖
  change Integrable Q volume
  have hraw := integrable_sheared_norm_mul_norm A hA H rho
  have hpres : MeasurePreserving
      (WithLp.toLp 2 : WaveSpaceTime → JointWaveSpaceTime) volume volume := by
    simpa only using (WithLp.volume_preserving_toLp (Euclidean 2) Real)
  rw [← hpres.integrable_comp_emb
    (MeasurableEquiv.toLp 2 WaveSpaceTime).measurableEmbedding]
  have heq : Q ∘ (WithLp.toLp 2 : WaveSpaceTime → JointWaveSpaceTime) =
      fun p : WaveSpaceTime => ‖A p.1‖ * ‖H (p.2 - rho p.1)‖ := by
    funext p
    rfl
  rw [heq]
  exact hraw

/-- Literal Fubini-plus-shear identity for an arbitrary integrable spatial
factor and a Schwartz temporal profile. -/
private theorem integral_sheared_norm_mul_norm_eq
    {E : Type*} [NormedAddCommGroup E]
    (A : Euclidean 2 → E) (hA : Integrable A)
    (H : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    (∫ z : WaveSpaceTime, ‖A z.1‖ * ‖H (z.2 - rho z.1)‖) =
      (∫ xi : Euclidean 2, ‖A xi‖) * ∫ t : Real, ‖H t‖ := by
  let shear : WaveSpaceTime → WaveSpaceTime :=
    fun z => (z.1, z.2 - rho z.1)
  let P : WaveSpaceTime → Real := fun z => ‖A z.1‖ * ‖H z.2‖
  have hPmeas : AEStronglyMeasurable P volume := by
    rw [Measure.volume_eq_prod]
    exact (hA.aestronglyMeasurable.norm.comp_fst).mul
      (H.continuous.aestronglyMeasurable.norm.comp_snd)
  have hshear : MeasurePreserving shear volume volume := by
    simpa only [shear] using scratch_normal_shear_measurePreserving rho
  have hPmeas_map : AEStronglyMeasurable P (Measure.map shear volume) := by
    rw [hshear.map_eq]
    exact hPmeas
  have htransport : (∫ z : WaveSpaceTime, P (shear z)) = ∫ z : WaveSpaceTime, P z := by
    calc
      (∫ z : WaveSpaceTime, P (shear z)) =
          ∫ z : WaveSpaceTime, P z ∂Measure.map shear volume := by
            exact (integral_map hshear.measurable.aemeasurable hPmeas_map).symm
      _ = ∫ z : WaveSpaceTime, P z := by rw [hshear.map_eq]
  calc
    (∫ z : WaveSpaceTime, ‖A z.1‖ * ‖H (z.2 - rho z.1)‖) =
        ∫ z : WaveSpaceTime, P (shear z) := by rfl
    _ = ∫ z : WaveSpaceTime, P z := htransport
    _ = (∫ xi : Euclidean 2, ‖A xi‖) * ∫ t : Real, ‖H t‖ := by
      rw [Measure.volume_eq_prod]
      exact integral_prod_mul (fun xi : Euclidean 2 => ‖A xi‖)
        (fun t : Real => ‖H t‖)

/-- `WithLp.volume_preserving_toLp` transports the raw Fubini formula to the
joint frequency Hilbert model without any extra regularity on `A`. -/
private theorem integral_joint_sheared_norm_mul_norm_eq
    {E : Type*} [NormedAddCommGroup E]
    (A : Euclidean 2 → E) (hA : Integrable A)
    (H : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    (∫ z : JointWaveSpaceTime, ‖A z.fst‖ * ‖H (z.snd - rho z.fst)‖) =
      (∫ xi : Euclidean 2, ‖A xi‖) * ∫ t : Real, ‖H t‖ := by
  let Q : JointWaveSpaceTime → Real := fun z =>
    ‖A z.fst‖ * ‖H (z.snd - rho z.fst)‖
  have hpres : MeasurePreserving
      (WithLp.toLp 2 : WaveSpaceTime → JointWaveSpaceTime) volume volume := by
    simpa only using (WithLp.volume_preserving_toLp (Euclidean 2) Real)
  have htransport :
      (∫ p : WaveSpaceTime, Q (WithLp.toLp 2 p)) =
        ∫ z : JointWaveSpaceTime, Q z :=
    hpres.integral_comp
      (MeasurableEquiv.toLp 2 WaveSpaceTime).measurableEmbedding Q
  calc
    (∫ z : JointWaveSpaceTime, ‖A z.fst‖ * ‖H (z.snd - rho z.fst)‖) =
        ∫ z : JointWaveSpaceTime, Q z := by rfl
    _ = ∫ p : WaveSpaceTime, Q (WithLp.toLp 2 p) := htransport.symm
    _ = ∫ p : WaveSpaceTime, ‖A p.1‖ * ‖H (p.2 - rho p.1)‖ := by rfl
    _ = (∫ xi : Euclidean 2, ‖A xi‖) * ∫ t : Real, ‖H t‖ :=
      integral_sheared_norm_mul_norm_eq A hA H rho

private def scratchScaledNormalDefect
    (normal : SchwartzMap Real Complex) (scale gamma : Real) : Real → Complex :=
  fun u => (1 : Complex) - normal (scale ^ (-gamma) * u)

private theorem scratchScaledNormalDefect_eq_zero_near
    (normal : SchwartzMap Real Complex)
    (hnormal : ∀ s : Real, |s| ≤ 1 → normal s = 1)
    (scale gamma u : Real) (hscale : 0 < scale)
    (hnear : |u| < scale ^ gamma) :
    ∀ k : Nat,
      iteratedFDeriv Real k (scratchScaledNormalDefect normal scale gamma) u = 0 := by
  intro k
  have hpowpos : 0 < scale ^ (-gamma) := Real.rpow_pos_of_pos hscale _
  have hrecip : scale ^ (-gamma) * scale ^ gamma = 1 := by
    rw [← Real.rpow_add hscale]
    norm_num
  have hscaled : |scale ^ (-gamma) * u| < 1 := by
    rw [abs_mul, abs_of_pos hpowpos]
    have := (mul_lt_mul_of_pos_left hnear hpowpos)
    simpa only [hrecip] using this
  let U : Set Real := {v | |scale ^ (-gamma) * v| < 1}
  have hUopen : IsOpen U := by
    change IsOpen ((fun v : Real => |scale ^ (-gamma) * v|) ⁻¹' Set.Iio 1)
    exact isOpen_lt (continuous_const.mul continuous_id).abs continuous_const
  have hu : u ∈ U := hscaled
  have hUnear : U ∈ nhds u := hUopen.mem_nhds hu
  have hlocal : scratchScaledNormalDefect normal scale gamma =ᶠ[nhds u]
      (fun _ : Real => (0 : Complex)) := by
    filter_upwards [hUnear] with v hv
    change (1 : Complex) - normal (scale ^ (-gamma) * v) = 0
    rw [hnormal _ hv.le]
    ring
  have hderiv := (hlocal.iteratedFDeriv Real k).self_of_nhds
  simpa using hderiv

private theorem scratchScaledNormalDefect_derivative_gap
    (normal : SchwartzMap Real Complex)
    (hnormal : ∀ s : Real, |s| ≤ 1 → normal s = 1)
    (scale gamma u : Real) (hscale : 0 < scale)
    {k : Nat}
    (hneq : iteratedFDeriv Real k
      (scratchScaledNormalDefect normal scale gamma) u ≠ 0) :
    scale ^ gamma ≤ |u| := by
  by_contra hnot
  have hnear : |u| < scale ^ gamma := lt_of_not_ge hnot
  exact hneq (scratchScaledNormalDefect_eq_zero_near normal hnormal
    scale gamma u hscale hnear k)

private theorem scratchScaledNormalDefect_derivative_uniform
    (normal : SchwartzMap Real Complex) (gamma : Real) (hgamma : 0 < gamma)
    (k : Nat) :
    ∃ B : Real, 0 ≤ B ∧ ∀ (scale u : Real), 2 ≤ scale →
      ‖iteratedFDeriv Real k (scratchScaledNormalDefect normal scale gamma) u‖ ≤ B := by
  by_cases hk : k = 0
  · subst k
    let B : Real := 1 + SchwartzMap.seminorm Complex 0 0 normal
    refine ⟨B, ?_, ?_⟩
    · dsimp only [B]
      positivity
    · intro scale u hscale
      rw [norm_iteratedFDeriv_zero]
      calc
        ‖(1 : Complex) - normal (scale ^ (-gamma) * u)‖ ≤
            ‖(1 : Complex)‖ + ‖normal (scale ^ (-gamma) * u)‖ := norm_sub_le _ _
        _ = 1 + ‖normal (scale ^ (-gamma) * u)‖ := by rw [norm_one]
        _ ≤ 1 + SchwartzMap.seminorm Complex 0 0 normal := by
          gcongr
          exact SchwartzMap.norm_le_seminorm Complex normal _
        _ = B := rfl
  · let B : Real := SchwartzMap.seminorm Complex 0 k normal
    refine ⟨B, ?_, ?_⟩
    · exact (norm_nonneg (iteratedFDeriv Real k (normal : Real → Complex) 0)).trans
        (normal.norm_iteratedFDeriv_le_seminorm Complex k 0)
    · intro scale u hscale
      let a : Real := scale ^ (-gamma)
      let L : Real →L[Real] Real := a • ContinuousLinearMap.id Real Real
      have hscalepos : 0 < scale := by linarith
      have ha : 0 < a := Real.rpow_pos_of_pos hscalepos _
      have hale : a ≤ 1 := by
        dsimp only [a]
        exact Real.rpow_le_one_of_one_le_of_nonpos (by linarith) (by linarith)
      have hLnorm : ‖L‖ ≤ 1 := by
        refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
        intro x
        change ‖a • x‖ ≤ 1 * ‖x‖
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos ha, one_mul]
        exact mul_le_of_le_one_left (norm_nonneg _) hale
      have hcomp : (fun v : Real => normal (a * v)) =
          (normal : Real → Complex) ∘ L := by
        funext v
        rfl
      have hderiv : iteratedFDeriv Real k
          (fun v : Real => normal (a * v)) u =
          (iteratedFDeriv Real k (normal : Real → Complex) (a * u)).compContinuousLinearMap
            (fun _ => L) := by
        rw [hcomp]
        exact L.iteratedFDeriv_comp_right (normal.smooth (k : ℕ∞)) u le_rfl
      have hnormal : ‖iteratedFDeriv Real k
          (normal : Real → Complex) (a * u)‖ ≤ B := by
        dsimp only [B]
        exact normal.norm_iteratedFDeriv_le_seminorm Complex k _
      have hscaled : ‖iteratedFDeriv Real k
          (fun v : Real => normal (a * v)) u‖ ≤ B := by
        rw [hderiv]
        calc
          ‖(iteratedFDeriv Real k (normal : Real → Complex) (a * u)).compContinuousLinearMap
              (fun _ => L)‖ ≤
              ‖iteratedFDeriv Real k (normal : Real → Complex) (a * u)‖ *
                ∏ _ : Fin k, ‖L‖ :=
            ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
          _ ≤ ‖iteratedFDeriv Real k (normal : Real → Complex) (a * u)‖ *
                ∏ _ : Fin k, (1 : Real) := by
            gcongr
          _ = ‖iteratedFDeriv Real k (normal : Real → Complex) (a * u)‖ := by simp
          _ ≤ B := hnormal
      have hconst : iteratedFDeriv Real k (fun _ : Real => (1 : Complex)) u = 0 :=
        congrFun (iteratedFDeriv_const_of_ne hk 1) u
      change ‖iteratedFDeriv Real k
        (fun v : Real => (1 : Complex) - normal (a * v)) u‖ ≤ B
      rw [show (fun v : Real => (1 : Complex) - normal (a * v)) =
          (fun _ : Real => (1 : Complex)) - fun v : Real => normal (a * v) by rfl]
      have hconstSmooth : ContDiff Real (k : ℕ∞)
          (fun _ : Real => (1 : Complex)) := contDiff_const
      have hnormalSmooth : ContDiff Real (k : ℕ∞)
          (fun v : Real => normal (a * v)) := by
        rw [hcomp]
        exact (normal.smooth _).comp_continuousLinearMap (g := L)
      rw [iteratedFDeriv_sub hconstSmooth hnormalSmooth]
      simp only [Pi.sub_apply, hconst, zero_sub, norm_neg]
      exact hscaled

private theorem exists_scratch_wavefront_temporalTail_weightedProfile_all
    (h : SchwartzMap Real Complex) (gamma : Real) (hgamma : 0 < gamma)
    (N : Nat) :
    ∃ q : Nat, ∀ (i : Nat) (scale u : Real), 2 ≤ scale →
      scale ^ gamma ≤ |u| →
      scale ^ N * ‖iteratedFDeriv Real i (h : Real → Complex) u‖ ≤
        ‖scratchWeightedTemporalDerivativeProfile h i q u‖ := by
  obtain ⟨q, hq⟩ := exists_nat_ge ((N : Real) / (2 * gamma))
  refine ⟨q, ?_⟩
  intro i scale u hscale hgap
  let R : Real := scale ^ (2 * gamma)
  have hscaleone : 1 ≤ scale := by linarith
  have hscalenonneg : 0 ≤ scale := zero_le_one.trans hscaleone
  have hRnonneg : 0 ≤ R := Real.rpow_nonneg hscalenonneg _
  have hsqrt : Real.sqrt R = scale ^ gamma := by
    dsimp only [R]
    rw [Real.sqrt_eq_rpow, ← Real.rpow_mul hscalenonneg]
    congr 1
    ring
  have hgap' : Real.sqrt R ≤ |u| := by simpa only [hsqrt] using hgap
  have hmain := scale_pow_mul_norm_iteratedFDeriv_time_le_weighted_profile
    h i q R u hRnonneg hgap'
  have hpowexp : (N : Real) ≤ 2 * gamma * q := by
    have hpos : 0 < 2 * gamma := by positivity
    have h := (div_le_iff₀ hpos).mp hq
    nlinarith [h]
  have hpow : scale ^ N ≤ R ^ q := by
    rw [← Real.rpow_natCast]
    change scale ^ (N : Real) ≤ (scale ^ (2 * gamma)) ^ q
    rw [← Real.rpow_natCast, ← Real.rpow_mul hscalenonneg]
    exact Real.rpow_le_rpow_of_exponent_le hscaleone hpowexp
  calc
    scale ^ N * ‖iteratedFDeriv Real i (h : Real → Complex) u‖ ≤
        R ^ q * ‖iteratedFDeriv Real i (h : Real → Complex) u‖ := by
          gcongr
    _ ≤ ‖scratchWeightedTemporalDerivativeProfile h i q u‖ := hmain

/-- A uniform finite weighted-Schwartz envelope for every temporal
derivative that can occur in an order-`r` chain rule.  This is derived from
the literal cutoff defect and the gap, rather than being a residual
assumption. -/
private theorem exists_scratch_wavefront_normalTail_derivative_weightedEnvelope_all
    (normal h : SchwartzMap Real Complex)
    (hnormal : ∀ s : Real, |s| ≤ 1 → normal s = 1)
    (gamma : Real) (hgamma : 0 < gamma)
    (r N : Nat) :
    ∃ (q : Nat) (C : Real), 0 ≤ C ∧
      ∀ {i : Nat}, i ≤ r → ∀ (scale u : Real), 2 ≤ scale →
        scale ^ N *
          ‖iteratedFDeriv Real i
            (fun v : Real =>
              scratchScaledNormalDefect normal scale gamma v * h v) u‖ ≤
          C * ∑ j ∈ Finset.range (r + 1),
            ‖scratchWeightedTemporalDerivativeProfile h j q u‖ := by
  let q : Nat :=
    (exists_scratch_wavefront_temporalTail_weightedProfile_all
      h gamma hgamma N).choose
  have htime (i : Nat) : ∀ (scale u : Real), 2 ≤ scale →
      scale ^ gamma ≤ |u| →
      scale ^ N * ‖iteratedFDeriv Real i (h : Real → Complex) u‖ ≤
        ‖scratchWeightedTemporalDerivativeProfile h i q u‖ := by
    simpa only [q] using
      (exists_scratch_wavefront_temporalTail_weightedProfile_all
        h gamma hgamma N).choose_spec i
  let B : Nat → Real := fun j =>
    (scratchScaledNormalDefect_derivative_uniform normal gamma hgamma j).choose
  have hBnonneg (j : Nat) : 0 ≤ B j :=
    (scratchScaledNormalDefect_derivative_uniform normal gamma hgamma j).choose_spec.1
  have hB (j : Nat) : ∀ (scale u : Real), 2 ≤ scale →
      ‖iteratedFDeriv Real j (scratchScaledNormalDefect normal scale gamma) u‖ ≤ B j := by
    simpa only [B] using
      (scratchScaledNormalDefect_derivative_uniform normal gamma hgamma j).choose_spec.2
  let Ci : Nat → Real := fun i => ∑ a ∈ Finset.range (i + 1),
    (i.choose a : Real) * B a
  have hCinonneg (i : Nat) : 0 ≤ Ci i := by
    dsimp only [Ci]
    apply Finset.sum_nonneg
    intro a ha
    exact mul_nonneg (by positivity) (hBnonneg a)
  let C : Real := ∑ i ∈ Finset.range (r + 1), Ci i
  have hCnonneg : 0 ≤ C := by
    dsimp only [C]
    exact Finset.sum_nonneg fun i hi => hCinonneg i
  have hCileC {i : Nat} (hi : i ≤ r) : Ci i ≤ C := by
    dsimp only [C]
    exact Finset.single_le_sum (s := Finset.range (r + 1)) (f := Ci)
      (fun j hj => hCinonneg j)
      (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
  refine ⟨q, C, hCnonneg, ?_⟩
  intro i hi scale u hscale
  let d : Real → Complex := scratchScaledNormalDefect normal scale gamma
  let S : Real := ∑ j ∈ Finset.range (r + 1),
    ‖scratchWeightedTemporalDerivativeProfile h j q u‖
  have hSnonneg : 0 ≤ S := by
    dsimp only [S]
    apply Finset.sum_nonneg
    intro j hj
    exact norm_nonneg _
  have hd : ContDiff Real (i : ℕ∞) d := by
    dsimp only [d, scratchScaledNormalDefect]
    let a : Real →L[Real] Real := (scale ^ (-gamma)) • ContinuousLinearMap.id Real Real
    change ContDiff Real (i : ℕ∞) (fun v : Real =>
      (1 : Complex) - normal (a v))
    exact contDiff_const.sub ((normal.smooth _).comp_continuousLinearMap (g := a))
  have hh : ContDiff Real (i : ℕ∞) (h : Real → Complex) := h.smooth _
  have hprod := norm_iteratedFDeriv_mul_le hd hh u le_rfl
  have hpoint :
      scale ^ N * ‖iteratedFDeriv Real i (fun v : Real => d v * h v) u‖ ≤
        Ci i * S := by
    calc
      scale ^ N * ‖iteratedFDeriv Real i (fun v : Real => d v * h v) u‖ ≤
          scale ^ N *
            ∑ a ∈ Finset.range (i + 1),
              (i.choose a : Real) * ‖iteratedFDeriv Real a d u‖ *
                ‖iteratedFDeriv Real (i - a) (h : Real → Complex) u‖ := by
            exact mul_le_mul_of_nonneg_left hprod (pow_nonneg (by linarith) _)
      _ = ∑ a ∈ Finset.range (i + 1),
            (i.choose a : Real) * ‖iteratedFDeriv Real a d u‖ *
              (scale ^ N * ‖iteratedFDeriv Real (i - a) (h : Real → Complex) u‖) := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro a ha
            ring
      _ ≤ ∑ a ∈ Finset.range (i + 1),
            (i.choose a : Real) * B a * S := by
            apply Finset.sum_le_sum
            intro a ha
            by_cases hzero : iteratedFDeriv Real a d u = 0
            · rw [hzero]
              simp only [norm_zero, mul_zero, zero_mul]
              exact mul_nonneg (mul_nonneg (by positivity) (hBnonneg a)) hSnonneg
            · have hgap : scale ^ gamma ≤ |u| :=
                scratchScaledNormalDefect_derivative_gap normal hnormal scale gamma u
                  (by linarith) hzero
              have htime' := htime (i - a) scale u hscale hgap
              have hterm :
                  ‖scratchWeightedTemporalDerivativeProfile h (i - a) q u‖ ≤ S := by
                dsimp only [S]
                exact Finset.single_le_sum (s := Finset.range (r + 1))
                  (f := fun j => ‖scratchWeightedTemporalDerivativeProfile h j q u‖)
                  (fun j hj => norm_nonneg _)
                  (Finset.mem_range.mpr
                    (Nat.lt_succ_of_le (le_trans (Nat.sub_le _ _) hi)))
              have htimeS :
                  scale ^ N * ‖iteratedFDeriv Real (i - a) (h : Real → Complex) u‖ ≤ S :=
                htime'.trans hterm
              have hderiv := hB a scale u hscale
              have hchoose : 0 ≤ (i.choose a : Real) := by positivity
              have hfirst : (i.choose a : Real) * ‖iteratedFDeriv Real a d u‖ ≤
                  (i.choose a : Real) * B a :=
                mul_le_mul_of_nonneg_left hderiv hchoose
              calc
                (i.choose a : Real) * ‖iteratedFDeriv Real a d u‖ *
                    (scale ^ N * ‖iteratedFDeriv Real (i - a) (h : Real → Complex) u‖) ≤
                    ((i.choose a : Real) * B a) *
                      (scale ^ N * ‖iteratedFDeriv Real (i - a) (h : Real → Complex) u‖) :=
                  mul_le_mul_of_nonneg_right hfirst (by positivity)
                _ ≤ ((i.choose a : Real) * B a) * S :=
                  mul_le_mul_of_nonneg_left htimeS (mul_nonneg hchoose (hBnonneg a))
                _ = (i.choose a : Real) * B a * S := by ring
      _ = Ci i * S := by
            dsimp only [Ci]
            rw [Finset.sum_mul]
  calc
    scale ^ N * ‖iteratedFDeriv Real i
        (fun v : Real =>
          scratchScaledNormalDefect normal scale gamma v * h v) u‖ =
        scale ^ N * ‖iteratedFDeriv Real i (fun v : Real => d v * h v) u‖ := by rfl
    _ ≤ Ci i * S := hpoint
    _ ≤ C * S := mul_le_mul_of_nonneg_right (hCileC hi) hSnonneg
    _ = C * ∑ j ∈ Finset.range (r + 1),
          ‖scratchWeightedTemporalDerivativeProfile h j q u‖ := rfl


private theorem exists_scratchWavefront_shearedNormalTail_derivative_weightedEnvelope
    (D : MSSWavefrontKernelData) (r N : Nat) :
    ∃ (L : Nat) (C : Real), 0 ≤ C ∧
      ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
        ∀ z : JointWaveSpaceTime,
          scale ^ N *
            ‖iteratedFDeriv Real r
              (fun w : JointWaveSpaceTime =>
                D.normalTail scale
                  (scratchJointNormalDifference D.radialTime scale hscale w)) z‖ ≤
            C * ∑ i ∈ Finset.range (r + 1),
              ‖scratchWeightedTemporalDerivativeProfile
                (FourierTransform.fourier D.radialTime.time) i L
                (scratchJointNormalDifference D.radialTime scale hscale z)‖ := by
  let h : SchwartzMap Real Complex := FourierTransform.fourier D.radialTime.time
  let L : Nat :=
    (exists_scratch_wavefront_normalTail_derivative_weightedEnvelope_all
      D.normal h D.normal_one_on_unit D.gamma D.gamma_pos r N).choose
  let A : Real :=
    (exists_scratch_wavefront_normalTail_derivative_weightedEnvelope_all
      D.normal h D.normal_one_on_unit D.gamma D.gamma_pos r N).choose_spec.choose
  have hAnonneg : 0 ≤ A := by
    simpa only [A, L] using
      (exists_scratch_wavefront_normalTail_derivative_weightedEnvelope_all
        D.normal h D.normal_one_on_unit D.gamma D.gamma_pos r N).choose_spec.choose_spec.1
  have hA {i : Nat} (hi : i ≤ r) : ∀ (scale u : Real), 2 ≤ scale →
      scale ^ N * ‖iteratedFDeriv Real i
        (fun v : Real => scratchScaledNormalDefect D.normal scale D.gamma v * h v) u‖ ≤
        A * ∑ j ∈ Finset.range (r + 1),
          ‖scratchWeightedTemporalDerivativeProfile h j L u‖ := by
    simpa only [A, L] using
      (exists_scratch_wavefront_normalTail_derivative_weightedEnvelope_all
        D.normal h D.normal_one_on_unit D.gamma D.gamma_pos r N).choose_spec.choose_spec.2 hi
  let B : Nat → Real := fun i => if hi : 1 ≤ i then
    (exists_scratchJointNormalDifference_iteratedFDeriv_uniform_bound
      D.radialTime i hi).choose else 0
  have hB {i : Nat} (hi : 1 ≤ i) :
      ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
        ∀ z : JointWaveSpaceTime,
          ‖iteratedFDeriv Real i
            (scratchJointNormalDifference D.radialTime scale hscale :
              JointWaveSpaceTime → Real) z‖ ≤ B i := by
    simpa only [B, dif_pos hi] using
      (exists_scratchJointNormalDifference_iteratedFDeriv_uniform_bound
        D.radialTime i hi).choose_spec.2
  let R : Real := ∑ i ∈ Finset.range (r + 1), max 1 (B i)
  have hRone : 1 ≤ R := by
    dsimp only [R]
    calc
      1 ≤ max 1 (B 0) := le_max_left _ _
      _ ≤ ∑ i ∈ Finset.range (r + 1), max 1 (B i) :=
        Finset.single_le_sum (s := Finset.range (r + 1))
          (f := fun i => max 1 (B i))
          (fun i hi => le_trans zero_le_one (le_max_left _ _))
          (Finset.mem_range.mpr (Nat.succ_pos r))
  have hBleR {i : Nat} (hi : i ≤ r) : B i ≤ R := by
    calc
      B i ≤ max 1 (B i) := le_max_right _ _
      _ ≤ ∑ j ∈ Finset.range (r + 1), max 1 (B j) :=
        Finset.single_le_sum (s := Finset.range (r + 1))
          (f := fun j => max 1 (B j))
          (fun j hj => le_trans zero_le_one (le_max_left _ _))
          (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
  let C : Real := (r.factorial : Real) * A * R ^ r
  refine ⟨L, C, ?_, ?_⟩
  · exact mul_nonneg (mul_nonneg (by positivity) hAnonneg)
      (pow_nonneg (le_trans zero_le_one hRone) _)
  intro scale hscale hscale_two z
  let q : JointWaveSpaceTime → Real := scratchJointNormalDifference D.radialTime scale hscale
  let H : Real → Complex := D.normalTail scale
  let S : Real := ∑ i ∈ Finset.range (r + 1),
    ‖scratchWeightedTemporalDerivativeProfile h i L (q z)‖
  have hSnonneg : 0 ≤ S := by
    dsimp only [S]
    apply Finset.sum_nonneg
    intro i hi
    exact norm_nonneg _
  have hH : H = fun v : Real =>
      scratchScaledNormalDefect D.normal scale D.gamma v * h v := by
    funext v
    dsimp only [H, h, scratchScaledNormalDefect]
    rw [D.normalTail_apply]
    rw [← SchwartzMap.fourier_coe]
  have hq : ContDiff Real (r : ℕ∞) q := by
    let Ls : JointWaveSpaceTime →L[Real] Real :=
      WithLp.sndL 2 Real (Euclidean 2) Real
    let Lf : JointWaveSpaceTime →L[Real] Euclidean 2 :=
      WithLp.fstL 2 Real (Euclidean 2) Real
    let rho : SchwartzMap (Euclidean 2) Real :=
      scratchScaledNormalExtension D.radialTime scale hscale
    change ContDiff Real (r : ℕ∞) (fun w => Ls w - rho (Lf w))
    exact Ls.contDiff.sub ((rho.smooth _).comp_continuousLinearMap (g := Lf))
  have hHsmooth : ContDiff Real (r : ℕ∞) H := by
    dsimp only [H]
    exact (D.normalTail scale).smooth _
  have hscaleNpos : 0 < scale ^ N := pow_pos hscale N
  have houter {i : Nat} (hi : i ≤ r) :
      ‖iteratedFDeriv Real i H (q z)‖ ≤ (A * S) / scale ^ N := by
    have hraw := hA hi scale (q z) hscale_two
    rw [← hH] at hraw
    have hbound : scale ^ N * ‖iteratedFDeriv Real i H (q z)‖ ≤ A * S := by
      simpa only [S] using hraw
    apply (le_div_iff₀ hscaleNpos).2
    calc
      ‖iteratedFDeriv Real i H (q z)‖ * scale ^ N =
          scale ^ N * ‖iteratedFDeriv Real i H (q z)‖ := by ring
      _ ≤ A * S := hbound
  have hinner {i : Nat} (hi1 : 1 ≤ i) (hi : i ≤ r) :
      ‖iteratedFDeriv Real i q z‖ ≤ R ^ i := by
    calc
      ‖iteratedFDeriv Real i q z‖ ≤ B i := by
        dsimp only [q]
        exact hB hi1 scale hscale (by linarith) z
      _ ≤ R := hBleR hi
      _ ≤ R ^ i := le_self_pow₀ hRone (Nat.ne_of_gt (Nat.zero_lt_of_lt hi1))
  have hchain := norm_iteratedFDeriv_comp_le hHsmooth hq
      (by simp : (r : WithTop ℕ∞) ≤ ((r : ℕ∞) : WithTop ℕ∞)) z
      (fun i hi => houter hi)
      (fun i hi1 hi => hinner hi1 hi)
  change scale ^ N *
      ‖iteratedFDeriv Real r (fun w : JointWaveSpaceTime => H (q w)) z‖ ≤
        C * S
  calc
    scale ^ N *
        ‖iteratedFDeriv Real r (fun w : JointWaveSpaceTime => H (q w)) z‖ ≤
        scale ^ N * ((r.factorial : Real) * ((A * S) / scale ^ N) * R ^ r) := by
          exact mul_le_mul_of_nonneg_left hchain hscaleNpos.le
    _ = ((r.factorial : Real) * A * R ^ r) * S := by
          field_simp [hscaleNpos.ne']
    _ = C * S := rfl

private noncomputable def scratchWavefrontNormalTailProfile
    (D : MSSWavefrontKernelData) (scale : Real) (n nu : Int) :
    SchwartzMap JointWaveSpaceTime Complex :=
  jointSchwartzModulatedAnnularProfile
    (D.spatialProfile scale n nu)
    (FourierTransform.fourierInv (D.normalTail scale))
    (D.normalCoordinate scale)

/-- The temporal window viewed as a function on joint frequency space. -/
private def scratchWavefrontLiftVertical
    (m : SchwartzMap Real Complex) : JointWaveSpaceTime → Complex :=
  fun z => m z.snd

private theorem scratchWavefrontLiftVertical_smooth
    (m : SchwartzMap Real Complex) (r : ℕ∞) :
    ContDiff Real r (scratchWavefrontLiftVertical m) := by
  change ContDiff Real r (m ∘ WithLp.sndL 2 Real (Euclidean 2) Real)
  exact (m.smooth r).comp_continuousLinearMap
    (g := WithLp.sndL 2 Real (Euclidean 2) Real)

private theorem scratchWavefrontPacketResidualMultiplier_eq_vertical_mul_tail
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale)
    (n nu : Int) :
    (scratchWavefrontPacketResidualMultiplier D scale hscale n nu :
      JointWaveSpaceTime → Complex) =
      fun z =>
        scratchWavefrontLiftVertical
          (scratchWavefrontVerticalProfile D scale n hscale) z *
          scratchWavefrontNormalTailProfile D scale n nu z := by
  funext z
  have hz : WithLp.toLp 2 (z.fst, z.snd) = z := by
    apply (WithLp.ext_iff 2).2
    rfl
  rw [← hz]
  rw [scratchWavefrontPacketResidualMultiplier,
    scratchWavefrontApplyVertical_apply]
  rfl

/-- Quantitative regularity of the supplied cutoff profiles.  These are
frequency-side estimates on the data only.  In particular there is no
physical-space norm and no input function in either field. -/
private structure ScratchWavefrontCutoffProfileRegularity
    (D : MSSWavefrontKernelData) : Prop where
  /-- Uniform derivatives of the fixed vertical cutoff after its allowed
translation/dilation. -/
  vertical_derivative_uniform : ∀ r : Nat, ∃ B : Real, 0 ≤ B ∧
    ∀ (scale : Real) (hscale : 0 < scale) (n : Int), 2 ≤ scale →
      ∀ z : JointWaveSpaceTime,
        ‖iteratedFDeriv Real r
          (scratchWavefrontLiftVertical
            (scratchWavefrontVerticalProfile D scale n hscale)) z‖ ≤ B
  /-- The normal-gap tail estimate after the polynomial spatial packet cost.
This is the scale-uniform cutoff/symbol datum supplied by the angular
partition construction. -/
  normal_tail_profile_rapid : ∀ r N : Nat, ∃ C : Real, 0 ≤ C ∧
    ∀ (scale : Real) (hscale : 0 < scale) (n nu : Int), 2 ≤ scale →
      n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
      scale ^ N *
        (∫ z : JointWaveSpaceTime,
          ‖iteratedFDeriv Real r
            (scratchWavefrontNormalTailProfile D scale n nu :
              JointWaveSpaceTime → Complex) z‖) ≤ C

/-- The cutoff-profile regularity gives the derivative-integral condition
used by the kernel closure.  This is a genuine finite Leibniz calculation:
the multiplier bound is derived here and is not a hypothesis of the final
packet estimate. -/
private theorem ScratchWavefrontCutoffProfileRegularity.to_rapidMultiplierBounds
    {D : MSSWavefrontKernelData}
    (hreg : ScratchWavefrontCutoffProfileRegularity D) :
    scratchWavefrontRapidMultiplierBounds D := by
  intro r N
  let B : Nat → Real := fun a => (hreg.vertical_derivative_uniform a).choose
  have hBnonneg (a : Nat) : 0 ≤ B a :=
    (hreg.vertical_derivative_uniform a).choose_spec.1
  have hB (a : Nat) :
      ∀ (scale : Real) (hscale : 0 < scale) (n : Int), 2 ≤ scale →
        ∀ z : JointWaveSpaceTime,
          ‖iteratedFDeriv Real a
            (scratchWavefrontLiftVertical
              (scratchWavefrontVerticalProfile D scale n hscale)) z‖ ≤ B a := by
    simpa only [B] using (hreg.vertical_derivative_uniform a).choose_spec.2
  let C : Nat → Real := fun a => (hreg.normal_tail_profile_rapid a N).choose
  have hCnonneg (a : Nat) : 0 ≤ C a :=
    (hreg.normal_tail_profile_rapid a N).choose_spec.1
  have hC (a : Nat) :
      ∀ (scale : Real) (hscale : 0 < scale) (n nu : Int), 2 ≤ scale →
        n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
        scale ^ N *
          (∫ z : JointWaveSpaceTime,
            ‖iteratedFDeriv Real a
              (scratchWavefrontNormalTailProfile D scale n nu :
                JointWaveSpaceTime → Complex) z‖) ≤ C a := by
    simpa only [C] using (hreg.normal_tail_profile_rapid a N).choose_spec.2
  let E : Real := ∑ a ∈ Finset.range (r + 1),
    (r.choose a : Real) * B a * C (r - a)
  refine ⟨E, ?_, ?_⟩
  · dsimp only [E]
    apply Finset.sum_nonneg
    intro a ha
    exact mul_nonneg
      (mul_nonneg (by positivity) (hBnonneg a))
      (hCnonneg (r - a))
  intro scale hscale n nu hscale_two hn hnu
  let V : JointWaveSpaceTime → Complex :=
    scratchWavefrontLiftVertical
      (scratchWavefrontVerticalProfile D scale n hscale)
  let T : SchwartzMap JointWaveSpaceTime Complex :=
    scratchWavefrontNormalTailProfile D scale n nu
  let M : SchwartzMap JointWaveSpaceTime Complex :=
    scratchWavefrontPacketResidualMultiplier D scale hscale n nu
  have hMfactor : (M : JointWaveSpaceTime → Complex) = fun z => V z * T z := by
    simpa only [M, V, T] using
      scratchWavefrontPacketResidualMultiplier_eq_vertical_mul_tail
        D scale hscale n nu
  have hV : ContDiff Real (r : ℕ∞) V := by
    dsimp only [V]
    exact scratchWavefrontLiftVertical_smooth
      (scratchWavefrontVerticalProfile D scale n hscale) _
  have hT : ContDiff Real (r : ℕ∞) (T : JointWaveSpaceTime → Complex) :=
    T.smooth _
  let R : JointWaveSpaceTime → Real := fun z =>
    ∑ a ∈ Finset.range (r + 1),
      (r.choose a : Real) * B a *
        (scale ^ N * ‖iteratedFDeriv Real (r - a)
          (T : JointWaveSpaceTime → Complex) z‖)
  have hRnonneg (z : JointWaveSpaceTime) : 0 ≤ R z := by
    dsimp only [R]
    apply Finset.sum_nonneg
    intro a ha
    exact mul_nonneg
      (mul_nonneg (by positivity) (hBnonneg a))
      (mul_nonneg
        (pow_nonneg (le_trans (by norm_num) hscale_two) _)
        (norm_nonneg _))
  have hpoint (z : JointWaveSpaceTime) :
      scale ^ N * ‖iteratedFDeriv Real r (M : JointWaveSpaceTime → Complex) z‖ ≤ R z := by
    have hprod := norm_iteratedFDeriv_mul_le hV hT z le_rfl
    rw [hMfactor]
    calc
      scale ^ N * ‖iteratedFDeriv Real r (fun w => V w * T w) z‖ ≤
          scale ^ N *
            ∑ a ∈ Finset.range (r + 1),
              (r.choose a : Real) * ‖iteratedFDeriv Real a V z‖ *
                ‖iteratedFDeriv Real (r - a) (T : JointWaveSpaceTime → Complex) z‖ := by
            exact mul_le_mul_of_nonneg_left hprod
              (pow_nonneg (le_trans (by norm_num) hscale_two) _)
      _ = ∑ a ∈ Finset.range (r + 1),
            (r.choose a : Real) *
              (scale ^ N * ‖iteratedFDeriv Real a V z‖) *
                ‖iteratedFDeriv Real (r - a)
                  (T : JointWaveSpaceTime → Complex) z‖ := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro a ha
            ring
      _ ≤ ∑ a ∈ Finset.range (r + 1),
            (r.choose a : Real) *
              (scale ^ N * B a) *
                ‖iteratedFDeriv Real (r - a)
                  (T : JointWaveSpaceTime → Complex) z‖ := by
            apply Finset.sum_le_sum
            intro a ha
            have hderiv := hB a scale hscale n hscale_two z
            have hscaleN : 0 ≤ scale ^ N :=
              pow_nonneg (le_trans (by norm_num) hscale_two) _
            have hscaled : scale ^ N * ‖iteratedFDeriv Real a V z‖ ≤
                scale ^ N * B a :=
              mul_le_mul_of_nonneg_left hderiv hscaleN
            have hchoose : 0 ≤ (r.choose a : Real) := by positivity
            have hfirst : (r.choose a : Real) *
                (scale ^ N * ‖iteratedFDeriv Real a V z‖) ≤
                (r.choose a : Real) * (scale ^ N * B a) :=
              mul_le_mul_of_nonneg_left hscaled hchoose
            exact mul_le_mul_of_nonneg_right hfirst (norm_nonneg _)
      _ = R z := by
            dsimp only [R]
            apply Finset.sum_congr rfl
            intro a ha
            ring
  have htermIntegrable (a : Nat) : Integrable (fun z : JointWaveSpaceTime =>
      (r.choose a : Real) * B a *
        (scale ^ N * ‖iteratedFDeriv Real (r - a)
          (T : JointWaveSpaceTime → Complex) z‖)) volume := by
    have hTa : Integrable (fun z : JointWaveSpaceTime =>
        ‖iteratedFDeriv Real (r - a)
          (T : JointWaveSpaceTime → Complex) z‖) volume := by
      simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume T 0 (r - a)
    have hconst : Integrable (fun z : JointWaveSpaceTime =>
        ((r.choose a : Real) * B a * scale ^ N) *
          ‖iteratedFDeriv Real (r - a)
            (T : JointWaveSpaceTime → Complex) z‖) volume :=
      hTa.const_mul _
    simpa only [mul_assoc] using hconst
  have hRintegrable : Integrable R volume := by
    dsimp only [R]
    exact integrable_finsetSum _ fun a ha => htermIntegrable a
  have hleftnonneg : ∀ z : JointWaveSpaceTime,
      0 ≤ scale ^ N * ‖iteratedFDeriv Real r (M : JointWaveSpaceTime → Complex) z‖ := by
    intro z
    positivity
  have hint :
      ∫ z : JointWaveSpaceTime,
        scale ^ N * ‖iteratedFDeriv Real r (M : JointWaveSpaceTime → Complex) z‖ ≤
      ∫ z : JointWaveSpaceTime, R z :=
    integral_mono_of_nonneg (Eventually.of_forall hleftnonneg) hRintegrable
      (Eventually.of_forall hpoint)
  have hRformula :
      (∫ z : JointWaveSpaceTime, R z) =
        ∑ a ∈ Finset.range (r + 1),
          (r.choose a : Real) * B a *
            (scale ^ N *
              ∫ z : JointWaveSpaceTime,
                ‖iteratedFDeriv Real (r - a)
                  (T : JointWaveSpaceTime → Complex) z‖) := by
    calc
      (∫ z : JointWaveSpaceTime, R z) =
          ∑ a ∈ Finset.range (r + 1),
            ∫ z : JointWaveSpaceTime,
              (r.choose a : Real) * B a *
                (scale ^ N * ‖iteratedFDeriv Real (r - a)
                  (T : JointWaveSpaceTime → Complex) z‖) := by
            dsimp only [R]
            exact integral_finsetSum _ fun a ha => htermIntegrable a
      _ = ∑ a ∈ Finset.range (r + 1),
          (r.choose a : Real) * B a *
            (scale ^ N *
              ∫ z : JointWaveSpaceTime,
                ‖iteratedFDeriv Real (r - a)
                  (T : JointWaveSpaceTime → Complex) z‖) := by
            apply Finset.sum_congr rfl
            intro a ha
            calc
              (∫ z : JointWaveSpaceTime,
                  (r.choose a : Real) * B a *
                    (scale ^ N * ‖iteratedFDeriv Real (r - a)
                      (T : JointWaveSpaceTime → Complex) z‖)) =
                  ∫ z : JointWaveSpaceTime,
                    ((r.choose a : Real) * B a) *
                      (scale ^ N * ‖iteratedFDeriv Real (r - a)
                        (T : JointWaveSpaceTime → Complex) z‖) := by
                    apply integral_congr_ae
                    filter_upwards with z
                    ring
              _ = ((r.choose a : Real) * B a) *
                  ∫ z : JointWaveSpaceTime,
                    scale ^ N * ‖iteratedFDeriv Real (r - a)
                      (T : JointWaveSpaceTime → Complex) z‖ :=
                    integral_const_mul _ _
              _ = ((r.choose a : Real) * B a) *
                  (scale ^ N *
                    ∫ z : JointWaveSpaceTime,
                      ‖iteratedFDeriv Real (r - a)
                        (T : JointWaveSpaceTime → Complex) z‖) := by
                    rw [integral_const_mul]
  calc
    scale ^ N *
        (∫ z : JointWaveSpaceTime,
          ‖iteratedFDeriv Real r (M : JointWaveSpaceTime → Complex) z‖) =
        ∫ z : JointWaveSpaceTime,
          scale ^ N * ‖iteratedFDeriv Real r (M : JointWaveSpaceTime → Complex) z‖ := by
            rw [integral_const_mul]
    _ ≤ ∫ z : JointWaveSpaceTime, R z := hint
    _ = ∑ a ∈ Finset.range (r + 1),
          (r.choose a : Real) * B a *
            (scale ^ N *
              ∫ z : JointWaveSpaceTime,
                ‖iteratedFDeriv Real (r - a)
                  (T : JointWaveSpaceTime → Complex) z‖) := hRformula
    _ ≤ ∑ a ∈ Finset.range (r + 1),
          (r.choose a : Real) * B a * C (r - a) := by
            apply Finset.sum_le_sum
            intro a ha
            have hcoef : 0 ≤ (r.choose a : Real) * B a :=
              mul_nonneg (by positivity) (hBnonneg a)
            simpa only [mul_assoc] using
              mul_le_mul_of_nonneg_left
                (hC (r - a) scale hscale n nu hscale_two hn hnu) hcoef
    _ = E := rfl

/-- The packet (L^4) estimate now consumes only cutoff-profile regularity.
The multiplier derivative estimate is an internal consequence above. -/
private theorem ScratchWavefrontCutoffProfileRegularity.exists_packet_L4_rapid_bound
    {D : MSSWavefrontKernelData}
    (hreg : ScratchWavefrontCutoffProfileRegularity D) (N : Nat) :
    ∃ C : Real, 0 < C ∧
      ∀ (scale : Real) (hscale : 0 < scale) (n nu : Int), 2 ≤ scale →
        n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
        ∀ f : SchwartzMap (Euclidean 2) Complex,
          eLpNorm (scratchWavefrontPacketResidual D scale hscale n nu f) 4 volume ≤
            ENNReal.ofReal (C * (scale⁻¹) ^ N) *
              eLpNorm (f : Euclidean 2 → Complex) 4 volume :=
  hreg.to_rapidMultiplierBounds.exists_packet_L4_rapid_bound N

/-- Exact derivative formula for the literal scale/translation vertical
window. -/
private theorem scratchWavefront_iteratedFDeriv_verticalProfile_eq
    (D : MSSWavefrontKernelData) (scale : Real) (n : Int)
    (hscale : 0 < scale) (k : Nat) (tau : Real) :
    iteratedFDeriv Real k
      (scratchWavefrontVerticalProfile D scale n hscale : Real → Complex) tau =
      (Real.sqrt scale)⁻¹ ^ k • iteratedFDeriv Real k
        (D.radialTime.vertical : Real → Complex)
        ((Real.sqrt scale)⁻¹ * tau - n) := by
  let root : Real := Real.sqrt scale
  let a : Real := root⁻¹
  let c : Real := root * n
  have hroot : root ≠ 0 := by
    exact Real.sqrt_ne_zero'.mpr hscale
  have hfun : (scratchWavefrontVerticalProfile D scale n hscale : Real → Complex) =
      fun t : Real => (fun y : Real => D.radialTime.vertical (a • y)) (t - c) := by
    funext t
    rw [scratchWavefrontVerticalProfile_apply]
    change D.radialTime.vertical ((Real.sqrt scale)⁻¹ * t - n) =
      D.radialTime.vertical (a * (t - c))
    dsimp only [a, c, root]
    field_simp [hroot]
  rw [hfun]
  have hsub :
      iteratedFDeriv Real k
        (fun t : Real => (fun y : Real => D.radialTime.vertical (a • y)) (t - c)) tau =
      iteratedFDeriv Real k (fun y : Real => D.radialTime.vertical (a • y)) (tau - c) := by
    simpa using (iteratedFDeriv_comp_sub (𝕜 := Real)
      (f := fun y : Real => D.radialTime.vertical (a • y)) k c tau)
  rw [hsub]
  rw [iteratedFDeriv_comp_const_smul a (D.radialTime.vertical.smooth (k : ℕ∞))]
  simp only [smul_eq_mul, a, c, root]
  congr 1
  field_simp [hroot]

/-- Fixed-order bounds for the literal vertical cutoff, uniform under all
allowed scale translations and dilations. -/
private theorem exists_scratchWavefrontVerticalProfile_iteratedFDeriv_uniform_bound
    (D : MSSWavefrontKernelData) (k : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ (n : Int) (tau : Real),
        ‖iteratedFDeriv Real k
          (scratchWavefrontVerticalProfile D scale n hscale : Real → Complex) tau‖ ≤ C := by
  obtain ⟨C, hCpos, hC⟩ := D.radialTime.vertical.decay 0 k
  refine ⟨C, hCpos.le, ?_⟩
  intro scale hscale hscaleone n tau
  rw [scratchWavefront_iteratedFDeriv_verticalProfile_eq]
  rw [norm_smul, Real.norm_eq_abs]
  have hroot : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
  rw [abs_of_nonneg (pow_nonneg (inv_nonneg.mpr hroot.le) k)]
  calc
    (Real.sqrt scale)⁻¹ ^ k *
        ‖iteratedFDeriv Real k (D.radialTime.vertical : Real → Complex)
          ((Real.sqrt scale)⁻¹ * tau - n)‖ ≤
        1 * ‖iteratedFDeriv Real k (D.radialTime.vertical : Real → Complex)
          ((Real.sqrt scale)⁻¹ * tau - n)‖ := by
          gcongr
          exact pow_le_one₀ (inv_nonneg.mpr hroot.le)
            (inv_le_one_of_one_le₀ (Real.one_le_sqrt.mpr hscaleone))
    _ ≤ C := by simpa using hC ((Real.sqrt scale)⁻¹ * tau - n)

/-- Projection onto the temporal coordinate does not enlarge an iterated
derivative. -/
private theorem scratchWavefront_norm_iteratedFDeriv_joint_snd_le
    (h : SchwartzMap Real Complex) (k : Nat) (z : JointWaveSpaceTime) :
    ‖iteratedFDeriv Real k
        (fun w : JointWaveSpaceTime => h (WithLp.sndL 2 Real (Euclidean 2) Real w)) z‖ ≤
      ‖iteratedFDeriv Real k (h : Real → Complex) z.snd‖ := by
  let L : JointWaveSpaceTime →L[Real] Real :=
    WithLp.sndL 2 Real (Euclidean 2) Real
  have hL : ‖L‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
    intro w
    simpa [L] using WithLp.norm_snd_le (p := 2) (Euclidean 2) w
  change ‖iteratedFDeriv Real k ((h : Real → Complex) ∘ L) z‖ ≤
    ‖iteratedFDeriv Real k (h : Real → Complex) (L z)‖
  rw [L.iteratedFDeriv_comp_right (h.smooth (⊤ : ℕ∞)) z (by exact_mod_cast le_top)]
  calc
    ‖(iteratedFDeriv Real k (h : Real → Complex) (L z)).compContinuousLinearMap
        (fun _ => L)‖ ≤
      ‖iteratedFDeriv Real k (h : Real → Complex) (L z)‖ * ∏ _ : Fin k, ‖L‖ :=
        ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv Real k (h : Real → Complex) (L z)‖ * ∏ _ : Fin k, (1 : Real) := by
      gcongr
    _ = ‖iteratedFDeriv Real k (h : Real → Complex) (L z)‖ := by simp

/-- No additional vertical regularity axiom is needed: it follows from the
fixed Schwartz vertical cutoff and the prescribed dilation. -/
private theorem scratchWavefront_vertical_derivative_uniform
    (D : MSSWavefrontKernelData) :
    ∀ r : Nat, ∃ B : Real, 0 ≤ B ∧
      ∀ (scale : Real) (hscale : 0 < scale) (n : Int), 2 ≤ scale →
        ∀ z : JointWaveSpaceTime,
          ‖iteratedFDeriv Real r
            (scratchWavefrontLiftVertical
              (scratchWavefrontVerticalProfile D scale n hscale)) z‖ ≤ B := by
  intro r
  obtain ⟨B, hBnonneg, hB⟩ :=
    exists_scratchWavefrontVerticalProfile_iteratedFDeriv_uniform_bound D r
  refine ⟨B, hBnonneg, ?_⟩
  intro scale hscale n hscale_two z
  exact (scratchWavefront_norm_iteratedFDeriv_joint_snd_le
    (scratchWavefrontVerticalProfile D scale n hscale) r z).trans
    (hB scale hscale (by linarith) n z.snd)

private theorem normalCoordinate_eq_scratchScaledNormalExtension
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale)
    (xi : Euclidean 2) :
    D.normalCoordinate scale xi =
      scratchScaledNormalExtension D.radialTime scale hscale xi := by
  rw [D.normalCoordinate_apply, scratchScaledNormalExtension_apply]

private theorem jointNormalDifference_eq_scratch
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale) :
    (fun z : JointWaveSpaceTime => z.snd - D.normalCoordinate scale z.fst) =
      scratchJointNormalDifference D.radialTime scale hscale := by
  funext z
  unfold scratchJointNormalDifference
  rw [normalCoordinate_eq_scratchScaledNormalExtension D scale hscale z.fst]


private theorem norm_iteratedFDeriv_spatialProfile_comp_fst_le
    (B : SchwartzMap (Euclidean 2) Complex) (r : Nat) (z : JointWaveSpaceTime) :
    ‖iteratedFDeriv Real r (fun w : JointWaveSpaceTime => B w.fst) z‖ ≤
      ‖iteratedFDeriv Real r (B : Euclidean 2 → Complex) z.fst‖ := by
  let L : JointWaveSpaceTime →L[Real] Euclidean 2 :=
    WithLp.fstL 2 Real (Euclidean 2) Real
  have hL : ‖L‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
    intro w
    simpa [L] using WithLp.norm_fst_le (p := 2) (Euclidean 2) w
  change ‖iteratedFDeriv Real r ((B : Euclidean 2 → Complex) ∘ L) z‖ ≤ _
  rw [L.iteratedFDeriv_comp_right (B.smooth (r : ℕ∞)) z le_rfl]
  calc
    ‖(iteratedFDeriv Real r (B : Euclidean 2 → Complex) (L z)).compContinuousLinearMap
        (fun _ => L)‖ ≤
        ‖iteratedFDeriv Real r (B : Euclidean 2 → Complex) (L z)‖ *
          ∏ _ : Fin r, ‖L‖ :=
      ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv Real r (B : Euclidean 2 → Complex) (L z)‖ *
          ∏ _ : Fin r, (1 : Real) := by
      gcongr
    _ = ‖iteratedFDeriv Real r (B : Euclidean 2 → Complex) z.fst‖ := by
      simp [L]

/-- The normal-tail profile is literally a spatial profile times the
normal-tail factor along the source normal shear. -/
private theorem scratchWavefrontNormalTailProfile_apply_eq_spatial_mul_shearedTail
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale)
    (n nu : Int) (z : JointWaveSpaceTime) :
    scratchWavefrontNormalTailProfile D scale n nu z =
      D.spatialProfile scale n nu z.fst *
        D.normalTail scale
          (scratchJointNormalDifference D.radialTime scale hscale z) := by
  have hz : WithLp.toLp 2 (z.fst, z.snd) = z := by
    apply (WithLp.ext_iff 2).2
    rfl
  rw [← hz]
  unfold scratchWavefrontNormalTailProfile
  rw [jointSchwartzModulatedAnnularProfile_apply,
    ← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  rw [← jointNormalDifference_eq_scratch D scale hscale]
  simp only [WithLp.toLp_fst, WithLp.toLp_snd]

/-- The lower-level normal-tail/shear datum used by the spatial assembly.
It has no angular or spatial profile in it: this is precisely the part
derived from the fixed temporal and normal cutoffs. -/
private def ScratchShearedNormalTailRapidEnvelope
    (D : MSSWavefrontKernelData) : Prop :=
  ∀ (r N : Nat), ∃ (L : Nat) (C : Real), 0 ≤ C ∧
    ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
      ∀ z : JointWaveSpaceTime,
        scale ^ N *
          ‖iteratedFDeriv Real r
            (fun w : JointWaveSpaceTime =>
              D.normalTail scale
                (scratchJointNormalDifference D.radialTime scale hscale w)) z‖ ≤
          C * ∑ i ∈ Finset.range (r + 1),
            ‖scratchWeightedTemporalDerivativeProfile
              (FourierTransform.fourier D.radialTime.time) i L
              (scratchJointNormalDifference D.radialTime scale hscale z)‖

private theorem scratchJointNormalDifference_contDiff
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (r : Nat) :
    ContDiff Real (r : ℕ∞) (scratchJointNormalDifference D scale hscale) := by
  unfold scratchJointNormalDifference
  exact (WithLp.sndL 2 Real (Euclidean 2) Real).contDiff.sub
    (((scratchScaledNormalExtension D scale hscale).smooth (r : ℕ∞)).comp_continuousLinearMap
      (g := WithLp.fstL 2 Real (Euclidean 2) Real))

/-- Finite Leibniz plus Fubini converts the cutoff-only sheared envelope and
the spatial polynomial profile bounds into the required rapid derivative-L¹
estimate for the full normal-tail profile. -/
private theorem MSSWavefrontSpatialProfilePolynomialRegularity.normalTailProfile_rapid
    {D : MSSWavefrontKernelData}
    (hspatial : MSSWavefrontSpatialProfilePolynomialRegularity D)
    (hshear : ScratchShearedNormalTailRapidEnvelope D) :
    ∀ r N : Nat, ∃ C : Real, 0 ≤ C ∧
      ∀ (scale : Real) (hscale : 0 < scale) (n nu : Int), 2 ≤ scale →
        n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
        scale ^ N *
          (∫ z : JointWaveSpaceTime,
            ‖iteratedFDeriv Real r
              (scratchWavefrontNormalTailProfile D scale n nu :
                JointWaveSpaceTime → Complex) z‖) ≤ C := by
  intro r N
  let P : Nat := ∑ a ∈ Finset.range (r + 1), hspatial.spatialExponent a
  let A : Nat → Real := fun a => (hspatial.derivative_l1 a).choose
  have hAnonneg (a : Nat) : 0 ≤ A a :=
    (hspatial.derivative_l1 a).choose_spec.1
  have hA (a : Nat) : ∀ (scale : Real) (n nu : Int), 2 ≤ scale →
      n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
      (∫ xi : Euclidean 2,
        ‖iteratedFDeriv Real a
          (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖) ≤
        A a * scale ^ hspatial.spatialExponent a := by
    simpa only [A] using (hspatial.derivative_l1 a).choose_spec.2
  have hP (a : Nat) (ha : a ∈ Finset.range (r + 1)) :
      hspatial.spatialExponent a ≤ P := by
    dsimp only [P]
    exact Finset.single_le_sum (s := Finset.range (r + 1))
      (f := hspatial.spatialExponent) (fun _ _ => Nat.zero_le _) ha
  let L : Nat → Nat := fun a => (hshear (r - a) (N + P)).choose
  let B : Nat → Real := fun a =>
    (hshear (r - a) (N + P)).choose_spec.choose
  have hB (a : Nat) : 0 ≤ B a ∧
      ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
        ∀ z : JointWaveSpaceTime,
          scale ^ (N + P) *
            ‖iteratedFDeriv Real (r - a)
              (fun w : JointWaveSpaceTime =>
                D.normalTail scale
                  (scratchJointNormalDifference D.radialTime scale hscale w)) z‖ ≤
            B a * ∑ i ∈ Finset.range (r - a + 1),
              ‖scratchWeightedTemporalDerivativeProfile
                (FourierTransform.fourier D.radialTime.time) i (L a)
                (scratchJointNormalDifference D.radialTime scale hscale z)‖ := by
    simpa only [L, B] using
      (hshear (r - a) (N + P)).choose_spec.choose_spec
  let C : Real := ∑ a ∈ Finset.range (r + 1),
    ∑ i ∈ Finset.range (r - a + 1),
      (r.choose a : Real) * B a * A a *
        (∫ t : Real,
          ‖scratchWeightedTemporalDerivativeProfile
            (FourierTransform.fourier D.radialTime.time) i (L a) t‖)
  have hCnonneg : 0 ≤ C := by
    dsimp only [C]
    apply Finset.sum_nonneg
    intro a ha
    apply Finset.sum_nonneg
    intro i hi
    exact mul_nonneg
      (mul_nonneg (mul_nonneg (by positivity) (hB a).1) (hAnonneg a))
      (integral_nonneg fun _ => norm_nonneg _)
  refine ⟨C, hCnonneg, ?_⟩
  intro scale hscale n nu hscale_two hn hnu
  let q : JointWaveSpaceTime → Real :=
    scratchJointNormalDifference D.radialTime scale hscale
  let F : SchwartzMap JointWaveSpaceTime Complex :=
    scratchWavefrontNormalTailProfile D scale n nu
  let U : JointWaveSpaceTime → Complex := fun z =>
    D.spatialProfile scale n nu z.fst
  let V : JointWaveSpaceTime → Complex := fun z => D.normalTail scale (q z)
  have hFfactor : (F : JointWaveSpaceTime → Complex) = fun z => U z * V z := by
    funext z
    dsimp only [F, U, V, q]
    exact scratchWavefrontNormalTailProfile_apply_eq_spatial_mul_shearedTail
      D scale hscale n nu z
  have hU : ContDiff Real (r : ℕ∞) U := by
    dsimp only [U]
    exact ((D.spatialProfile scale n nu).smooth (r : ℕ∞)).comp_continuousLinearMap
      (g := WithLp.fstL 2 Real (Euclidean 2) Real)
  have hV : ContDiff Real (r : ℕ∞) V := by
    dsimp only [V, q]
    exact ((D.normalTail scale).smooth (r : ℕ∞)).comp
      (scratchJointNormalDifference_contDiff D.radialTime scale hscale r)
  let M : JointWaveSpaceTime → Real := fun z =>
    ∑ a ∈ Finset.range (r + 1),
      ∑ i ∈ Finset.range (r - a + 1),
        (r.choose a : Real) * B a *
          ‖iteratedFDeriv Real a
            (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
          ‖scratchWeightedTemporalDerivativeProfile
            (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖
  have hMnonneg (z : JointWaveSpaceTime) : 0 ≤ M z := by
    dsimp only [M]
    apply Finset.sum_nonneg
    intro a ha
    apply Finset.sum_nonneg
    intro i hi
    exact mul_nonneg
      (mul_nonneg (mul_nonneg (by positivity) (hB a).1) (norm_nonneg _))
      (norm_nonneg _)
  have hpoint (z : JointWaveSpaceTime) :
      scale ^ (N + P) *
        ‖iteratedFDeriv Real r (F : JointWaveSpaceTime → Complex) z‖ ≤ M z := by
    have hprod := norm_iteratedFDeriv_mul_le hU hV z le_rfl
    rw [hFfactor]
    calc
      scale ^ (N + P) *
          ‖iteratedFDeriv Real r (fun w => U w * V w) z‖ ≤
          scale ^ (N + P) *
            ∑ a ∈ Finset.range (r + 1), (r.choose a : Real) *
              ‖iteratedFDeriv Real a U z‖ *
              ‖iteratedFDeriv Real (r - a) V z‖ := by
            exact mul_le_mul_of_nonneg_left hprod
              (pow_nonneg (by linarith) _)
      _ = ∑ a ∈ Finset.range (r + 1), (r.choose a : Real) *
            ‖iteratedFDeriv Real a U z‖ *
            (scale ^ (N + P) * ‖iteratedFDeriv Real (r - a) V z‖) := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro a ha
            ring
      _ ≤ ∑ a ∈ Finset.range (r + 1), (r.choose a : Real) *
            ‖iteratedFDeriv Real a U z‖ *
            (B a * ∑ i ∈ Finset.range (r - a + 1),
              ‖scratchWeightedTemporalDerivativeProfile
                (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖) := by
            apply Finset.sum_le_sum
            intro a ha
            have htail := (hB a).2 scale hscale hscale_two z
            exact mul_le_mul_of_nonneg_left htail
              (mul_nonneg (by positivity) (norm_nonneg _))
      _ ≤ ∑ a ∈ Finset.range (r + 1), (r.choose a : Real) *
            ‖iteratedFDeriv Real a
              (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
            (B a * ∑ i ∈ Finset.range (r - a + 1),
              ‖scratchWeightedTemporalDerivativeProfile
                (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖) := by
            apply Finset.sum_le_sum
            intro a ha
            have hfactor_nonneg : 0 ≤ B a *
                ∑ i ∈ Finset.range (r - a + 1),
                  ‖scratchWeightedTemporalDerivativeProfile
                    (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖ :=
              mul_nonneg (hB a).1
                (Finset.sum_nonneg fun _ _ => norm_nonneg _)
            have hinner := mul_le_mul_of_nonneg_right
              (norm_iteratedFDeriv_spatialProfile_comp_fst_le
                (D.spatialProfile scale n nu) a z) hfactor_nonneg
            calc
              (r.choose a : Real) * ‖iteratedFDeriv Real a U z‖ *
                  (B a * ∑ i ∈ Finset.range (r - a + 1),
                    ‖scratchWeightedTemporalDerivativeProfile
                      (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖) =
                  (r.choose a : Real) *
                    (‖iteratedFDeriv Real a U z‖ *
                      (B a * ∑ i ∈ Finset.range (r - a + 1),
                        ‖scratchWeightedTemporalDerivativeProfile
                          (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖)) := by
                    ring
              _ ≤ (r.choose a : Real) *
                    (‖iteratedFDeriv Real a
                      (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
                      (B a * ∑ i ∈ Finset.range (r - a + 1),
                        ‖scratchWeightedTemporalDerivativeProfile
                          (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖)) :=
                  mul_le_mul_of_nonneg_left hinner (by positivity)
              _ = (r.choose a : Real) *
                    ‖iteratedFDeriv Real a
                      (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
                    (B a * ∑ i ∈ Finset.range (r - a + 1),
                      ‖scratchWeightedTemporalDerivativeProfile
                        (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖) := by
                  ring
      _ = M z := by
            dsimp only [M]
            apply Finset.sum_congr rfl
            intro a ha
            calc
              (r.choose a : Real) *
                  ‖iteratedFDeriv Real a
                    (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
                  (B a * ∑ i ∈ Finset.range (r - a + 1),
                    ‖scratchWeightedTemporalDerivativeProfile
                      (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖) =
                  ((r.choose a : Real) *
                    ‖iteratedFDeriv Real a
                      (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ * B a) *
                    ∑ i ∈ Finset.range (r - a + 1),
                      ‖scratchWeightedTemporalDerivativeProfile
                        (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖ := by
                    ring
              _ = ∑ i ∈ Finset.range (r - a + 1),
                    ((r.choose a : Real) *
                      ‖iteratedFDeriv Real a
                        (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ * B a) *
                      ‖scratchWeightedTemporalDerivativeProfile
                        (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖ := by
                    rw [Finset.mul_sum]
              _ = ∑ i ∈ Finset.range (r - a + 1),
                    (r.choose a : Real) * B a *
                      ‖iteratedFDeriv Real a
                        (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
                      ‖scratchWeightedTemporalDerivativeProfile
                        (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖ := by
                    apply Finset.sum_congr rfl
                    intro i hi
                    ring
  have hMterm (a i : Nat) : Integrable (fun z : JointWaveSpaceTime =>
      (r.choose a : Real) * B a *
        ‖iteratedFDeriv Real a
          (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
        ‖scratchWeightedTemporalDerivativeProfile
          (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖) := by
    have hspatial_int : Integrable (fun xi : Euclidean 2 =>
        ‖iteratedFDeriv Real a
          (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖) := by
      simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume
        (D.spatialProfile scale n nu) 0 a
    have hbase := integrable_joint_sheared_norm_mul_norm
      (fun xi : Euclidean 2 =>
        ‖iteratedFDeriv Real a
          (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖)
      hspatial_int
      (scratchWeightedTemporalDerivativeProfile
        (FourierTransform.fourier D.radialTime.time) i (L a))
      (scratchScaledNormalExtension D.radialTime scale hscale)
    have hscaled := hbase.const_mul ((r.choose a : Real) * B a)
    simpa only [q, scratchJointNormalDifference, norm_norm, mul_assoc] using hscaled
  have hMint : Integrable M := by
    dsimp only [M]
    apply integrable_finsetSum
    intro a ha
    apply integrable_finsetSum
    intro i hi
    exact hMterm a i
  have hMformula :
      (∫ z : JointWaveSpaceTime, M z) =
        ∑ a ∈ Finset.range (r + 1),
          ∑ i ∈ Finset.range (r - a + 1),
            (r.choose a : Real) * B a *
              (∫ xi : Euclidean 2,
                ‖iteratedFDeriv Real a
                  (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖) *
              (∫ t : Real,
                ‖scratchWeightedTemporalDerivativeProfile
                  (FourierTransform.fourier D.radialTime.time) i (L a) t‖) := by
    calc
      (∫ z : JointWaveSpaceTime, M z) =
          ∑ a ∈ Finset.range (r + 1),
            ∫ z : JointWaveSpaceTime,
              ∑ i ∈ Finset.range (r - a + 1),
                (r.choose a : Real) * B a *
                  ‖iteratedFDeriv Real a
                    (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
                  ‖scratchWeightedTemporalDerivativeProfile
                    (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖ := by
            dsimp only [M]
            exact integral_finsetSum _ fun a ha =>
              integrable_finsetSum _ fun i hi => hMterm a i
      _ = ∑ a ∈ Finset.range (r + 1),
            ∑ i ∈ Finset.range (r - a + 1),
              ∫ z : JointWaveSpaceTime,
                (r.choose a : Real) * B a *
                  ‖iteratedFDeriv Real a
                    (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
                  ‖scratchWeightedTemporalDerivativeProfile
                    (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖ := by
            apply Finset.sum_congr rfl
            intro a ha
            exact integral_finsetSum _ fun i hi => hMterm a i
      _ = ∑ a ∈ Finset.range (r + 1),
            ∑ i ∈ Finset.range (r - a + 1),
              (r.choose a : Real) * B a *
                (∫ xi : Euclidean 2,
                  ‖iteratedFDeriv Real a
                    (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖) *
                (∫ t : Real,
                  ‖scratchWeightedTemporalDerivativeProfile
                    (FourierTransform.fourier D.radialTime.time) i (L a) t‖) := by
            apply Finset.sum_congr rfl
            intro a ha
            apply Finset.sum_congr rfl
            intro i hi
            have hspatial_int : Integrable (fun xi : Euclidean 2 =>
                ‖iteratedFDeriv Real a
                  (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖) := by
              simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume
                (D.spatialProfile scale n nu) 0 a
            calc
              (∫ z : JointWaveSpaceTime,
                  (r.choose a : Real) * B a *
                    ‖iteratedFDeriv Real a
                      (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
                    ‖scratchWeightedTemporalDerivativeProfile
                      (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖) =
                  ((r.choose a : Real) * B a) *
                    ∫ z : JointWaveSpaceTime,
                      ‖iteratedFDeriv Real a
                        (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
                      ‖scratchWeightedTemporalDerivativeProfile
                        (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖ := by
                    calc
                      (∫ z : JointWaveSpaceTime,
                          (r.choose a : Real) * B a *
                            ‖iteratedFDeriv Real a
                              (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
                            ‖scratchWeightedTemporalDerivativeProfile
                              (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖) =
                          ∫ z : JointWaveSpaceTime,
                            ((r.choose a : Real) * B a) *
                              (‖iteratedFDeriv Real a
                                (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
                                ‖scratchWeightedTemporalDerivativeProfile
                                  (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖) := by
                            apply integral_congr_ae
                            filter_upwards with z
                            ring
                      _ = ((r.choose a : Real) * B a) *
                            ∫ z : JointWaveSpaceTime,
                              ‖iteratedFDeriv Real a
                                (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
                              ‖scratchWeightedTemporalDerivativeProfile
                                (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖ :=
                            integral_const_mul _ _
              _ = ((r.choose a : Real) * B a) *
                    ((∫ xi : Euclidean 2,
                      ‖iteratedFDeriv Real a
                        (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖) *
                      ∫ t : Real,
                        ‖scratchWeightedTemporalDerivativeProfile
                          (FourierTransform.fourier D.radialTime.time) i (L a) t‖) := by
                    have hshearEq := integral_joint_sheared_norm_mul_norm_eq
                      (fun xi : Euclidean 2 =>
                        ‖iteratedFDeriv Real a
                          (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖)
                      hspatial_int
                      (scratchWeightedTemporalDerivativeProfile
                        (FourierTransform.fourier D.radialTime.time) i (L a))
                      (scratchScaledNormalExtension D.radialTime scale hscale)
                    exact congrArg (fun x : Real => ((r.choose a : Real) * B a) * x)
                      (by simpa only [q, scratchJointNormalDifference, norm_norm] using hshearEq)
              _ = (r.choose a : Real) * B a *
                    (∫ xi : Euclidean 2,
                      ‖iteratedFDeriv Real a
                        (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖) *
                    (∫ t : Real,
                      ‖scratchWeightedTemporalDerivativeProfile
                        (FourierTransform.fourier D.radialTime.time) i (L a) t‖) := by
                    ring
  have hscaleone : 1 ≤ scale := by linarith
  have hscalePpos : 0 < scale ^ P := pow_pos (by linarith) _
  have hspatial_bound (a : Nat) (ha : a ∈ Finset.range (r + 1)) :
      (∫ xi : Euclidean 2,
        ‖iteratedFDeriv Real a
          (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖) ≤
        A a * scale ^ P := by
    have hpower : scale ^ hspatial.spatialExponent a ≤ scale ^ P :=
      pow_le_pow_right₀ hscaleone (hP a ha)
    calc
      (∫ xi : Euclidean 2,
        ‖iteratedFDeriv Real a
          (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖) ≤
          A a * scale ^ hspatial.spatialExponent a :=
        hA a scale n nu hscale_two hn hnu
      _ ≤ A a * scale ^ P := mul_le_mul_of_nonneg_left hpower (hAnonneg a)
  have hMbound : (∫ z : JointWaveSpaceTime, M z) ≤ C * scale ^ P := by
    rw [hMformula]
    calc
      ∑ a ∈ Finset.range (r + 1),
          ∑ i ∈ Finset.range (r - a + 1),
            (r.choose a : Real) * B a *
              (∫ xi : Euclidean 2,
                ‖iteratedFDeriv Real a
                  (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖) *
              (∫ t : Real,
                ‖scratchWeightedTemporalDerivativeProfile
                  (FourierTransform.fourier D.radialTime.time) i (L a) t‖) ≤
          ∑ a ∈ Finset.range (r + 1),
            ∑ i ∈ Finset.range (r - a + 1),
              (r.choose a : Real) * B a * (A a * scale ^ P) *
                (∫ t : Real,
                  ‖scratchWeightedTemporalDerivativeProfile
                    (FourierTransform.fourier D.radialTime.time) i (L a) t‖) := by
            apply Finset.sum_le_sum
            intro a ha
            apply Finset.sum_le_sum
            intro i hi
            exact mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_left (hspatial_bound a ha)
                (mul_nonneg (by positivity) (hB a).1))
              (integral_nonneg fun _ => norm_nonneg _)
      _ = C * scale ^ P := by
            dsimp only [C]
            rw [Finset.sum_mul]
            apply Finset.sum_congr rfl
            intro a ha
            rw [Finset.sum_mul]
            apply Finset.sum_congr rfl
            intro i hi
            ring
  have hFint : Integrable (fun z : JointWaveSpaceTime =>
      ‖iteratedFDeriv Real r (F : JointWaveSpaceTime → Complex) z‖) := by
    simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume F 0 r
  have hscaledFint : Integrable (fun z : JointWaveSpaceTime =>
      scale ^ (N + P) * ‖iteratedFDeriv Real r (F : JointWaveSpaceTime → Complex) z‖) :=
    hFint.const_mul _
  have hInt : scale ^ (N + P) *
      (∫ z : JointWaveSpaceTime,
        ‖iteratedFDeriv Real r (F : JointWaveSpaceTime → Complex) z‖) ≤
      ∫ z : JointWaveSpaceTime, M z := by
    rw [← integral_const_mul]
    exact integral_mono_of_nonneg
      (Eventually.of_forall fun z =>
        mul_nonneg (pow_nonneg (by linarith) _) (norm_nonneg _))
      hMint (Eventually.of_forall hpoint)
  have hbig : scale ^ (N + P) *
      (∫ z : JointWaveSpaceTime,
        ‖iteratedFDeriv Real r (F : JointWaveSpaceTime → Complex) z‖) ≤
      C * scale ^ P := hInt.trans hMbound
  apply (mul_le_mul_iff_of_pos_right hscalePpos).mp
  calc
    (scale ^ N *
        (∫ z : JointWaveSpaceTime,
          ‖iteratedFDeriv Real r
            (scratchWavefrontNormalTailProfile D scale n nu :
              JointWaveSpaceTime → Complex) z‖)) * scale ^ P =
        scale ^ (N + P) *
          (∫ z : JointWaveSpaceTime,
            ‖iteratedFDeriv Real r (F : JointWaveSpaceTime → Complex) z‖) := by
          dsimp only [F]
          rw [pow_add]
          ring
    _ ≤ C * scale ^ P := hbig

/-- The preceding spatial assembly has no residual analytic hypothesis: its
sheared input is supplied by the normal-gap/Leibniz theorem derived from the
literal cutoff and temporal Schwartz profile. -/
private theorem MSSWavefrontSpatialProfilePolynomialRegularity.normalTailProfile_rapid_derived
    {D : MSSWavefrontKernelData}
    (hspatial : MSSWavefrontSpatialProfilePolynomialRegularity D) :
    ∀ r N : Nat, ∃ C : Real, 0 ≤ C ∧
      ∀ (scale : Real) (hscale : 0 < scale) (n nu : Int), 2 ≤ scale →
        n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
        scale ^ N *
          (∫ z : JointWaveSpaceTime,
            ‖iteratedFDeriv Real r
              (scratchWavefrontNormalTailProfile D scale n nu :
                JointWaveSpaceTime → Complex) z‖) ≤ C := by
  apply hspatial.normalTailProfile_rapid
  intro r N
  simpa only [ScratchShearedNormalTailRapidEnvelope] using
    exists_scratchWavefront_shearedNormalTail_derivative_weightedEnvelope D r N

/-- Consequently the old cutoff-profile regularity package is itself a
derived consequence of the lower-level spatial polynomial condition: neither
of its two analytic fields is left as an axiom. -/
private theorem MSSWavefrontSpatialProfilePolynomialRegularity.to_cutoffProfileRegularity
    {D : MSSWavefrontKernelData}
    (hspatial : MSSWavefrontSpatialProfilePolynomialRegularity D) :
    ScratchWavefrontCutoffProfileRegularity D where
  vertical_derivative_uniform := scratchWavefront_vertical_derivative_uniform D
  normal_tail_profile_rapid := by
    intro r N
    obtain ⟨C, hCnonneg, hC⟩ := hspatial.normalTailProfile_rapid_derived r N
    refine ⟨C, hCnonneg, ?_⟩
    intro scale hscale n nu hscale_two hn hnu
    exact hC scale hscale n nu hscale_two hn hnu

private theorem scratch_eLpNorm_four_angularRadialSquareFunction_le_sum_of_bounds
    (radialIndices angularIndices : Finset Int)
    (tail : Int → Int → WaveSpaceTime → Complex)
    (htailMeas : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      AEStronglyMeasurable (tail n nu) volume)
    (E : Int → Int → ENNReal)
    (hE : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      eLpNorm (tail n nu) 4 volume ≤ E n nu) :
    eLpNorm (angularRadialSquareFunction radialIndices angularIndices tail) 4 volume ≤
      ∑ n ∈ radialIndices, ∑ nu ∈ angularIndices, E n nu := by
  have hraw := eLpNorm_four_angularRadialSquareFunction_sub_le_sum_of_eq_add_of_tail_bounds
    radialIndices angularIndices tail (fun _ _ _ => 0) tail
    (by
      intro n hn nu hnu z
      simp)
    htailMeas E hE
  have hzero : angularRadialSquareFunction radialIndices angularIndices
      (fun _ _ _ => 0) = 0 := by
    funext z
    simp [angularRadialSquareFunction]
  rw [hzero, sub_zero] at hraw
  exact hraw

/-- If every packet has the same `L⁴` majorant, the finite aggregation costs
exactly the number of radial--angular pairs. -/
private theorem scratch_eLpNorm_four_angularRadialSquareFunction_le_card_mul
    (radialIndices angularIndices : Finset Int)
    (tail : Int → Int → WaveSpaceTime → Complex)
    (htailMeas : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      AEStronglyMeasurable (tail n nu) volume)
    (E : ENNReal)
    (hE : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      eLpNorm (tail n nu) 4 volume ≤ E) :
    eLpNorm (angularRadialSquareFunction radialIndices angularIndices tail) 4 volume ≤
      ((radialIndices.card * angularIndices.card : Nat) : ENNReal) * E := by
  calc
    eLpNorm (angularRadialSquareFunction radialIndices angularIndices tail) 4 volume ≤
        ∑ n ∈ radialIndices, ∑ nu ∈ angularIndices, E :=
      scratch_eLpNorm_four_angularRadialSquareFunction_le_sum_of_bounds
        radialIndices angularIndices tail htailMeas (fun _ _ => E) hE
    _ = ((radialIndices.card * angularIndices.card : Nat) : ENNReal) * E := by
      simp [Nat.cast_mul, mul_assoc]

/-- The canonical radial enumeration and the scale-indexed angular family
contain at most `11 * Cₐ * scale` packet pairs.  The angular constant is the
one bundled in the cutoff data. -/
private theorem scratch_canonicalRadialAngular_pair_card_le
    (D : MSSWavefrontCutoffData) {scale : Real} (hscale : 2 ≤ scale) :
    (((relevantRadialIndexEnumeration scale).card *
        (D.angularIndices scale).card : Nat) : ENNReal) ≤
      ENNReal.ofReal (11 * D.angular_card.choose * scale) := by
  let Ca : Real := D.angular_card.choose
  have hCa_pos : 0 < Ca := D.angular_card.choose_spec.1
  have hCa : ((D.angularIndices scale).card : Real) ≤ Ca * Real.sqrt scale :=
    D.angular_card.choose_spec.2 scale hscale
  have hrad : ((relevantRadialIndexEnumeration scale).card : Real) ≤
      11 * Real.sqrt scale :=
    card_relevantRadialIndexEnumeration_le_eleven_mul_sqrt hscale
  have hroot_nonneg : 0 ≤ Real.sqrt scale := Real.sqrt_nonneg _
  have hright_nonneg : 0 ≤ 11 * Real.sqrt scale := by positivity
  have hang_nonneg : 0 ≤ ((D.angularIndices scale).card : Real) := by positivity
  have hpairs_real :
      (((relevantRadialIndexEnumeration scale).card *
          (D.angularIndices scale).card : Nat) : Real) ≤
        11 * Ca * scale := by
    rw [Nat.cast_mul]
    calc
      ((relevantRadialIndexEnumeration scale).card : Real) *
          ((D.angularIndices scale).card : Real) ≤
          (11 * Real.sqrt scale) * (Ca * Real.sqrt scale) :=
        mul_le_mul hrad hCa hang_nonneg hright_nonneg
      _ = 11 * Ca * (Real.sqrt scale) ^ 2 := by ring
      _ = 11 * Ca * scale := by
        rw [Real.sq_sqrt (by linarith : 0 ≤ scale)]
  rw [← ENNReal.ofReal_natCast]
  exact ENNReal.ofReal_le_ofReal (by simpa only [Ca] using hpairs_real)

/-- Combining the exact finite Minkowski bound with the two cardinality
estimates loses only one power of `scale`. -/
private theorem scratch_eLpNorm_four_canonicalAngularRadialSquareFunction_le_scale_mul
    (D : MSSWavefrontCutoffData) {scale : Real} (hscale : 2 ≤ scale)
    (tail : Int → Int → WaveSpaceTime → Complex)
    (htailMeas : ∀ n ∈ relevantRadialIndexEnumeration scale,
      ∀ nu ∈ D.angularIndices scale, AEStronglyMeasurable (tail n nu) volume)
    (E : ENNReal)
    (hE : ∀ n ∈ relevantRadialIndexEnumeration scale,
      ∀ nu ∈ D.angularIndices scale,
        eLpNorm (tail n nu) 4 volume ≤ E) :
    eLpNorm (angularRadialSquareFunction (relevantRadialIndexEnumeration scale)
        (D.angularIndices scale) tail) 4 volume ≤
      ENNReal.ofReal (11 * D.angular_card.choose * scale) * E := by
  calc
    eLpNorm (angularRadialSquareFunction (relevantRadialIndexEnumeration scale)
        (D.angularIndices scale) tail) 4 volume ≤
        (((relevantRadialIndexEnumeration scale).card *
          (D.angularIndices scale).card : Nat) : ENNReal) * E :=
      scratch_eLpNorm_four_angularRadialSquareFunction_le_card_mul
        (relevantRadialIndexEnumeration scale) (D.angularIndices scale)
        tail htailMeas E hE
    _ ≤ ENNReal.ofReal (11 * D.angular_card.choose * scale) * E :=
      mul_le_mul_of_nonneg_right
        (scratch_canonicalRadialAngular_pair_card_le D hscale) bot_le

/-- A one-power loss from the finite packet family is absorbed by asking for
one additional power of rapid decay in each packet.  This is the exact
numerical closure used after the one-packet kernel bound. -/
private theorem scratch_eLpNorm_four_canonicalAngularRadialSquareFunction_rapid
    (D : MSSWavefrontCutoffData) {scale : Real} (hscale : 2 ≤ scale)
    (N : Nat) (C : Real)
    (tail : Int → Int → WaveSpaceTime → Complex)
    (htailMeas : ∀ n ∈ relevantRadialIndexEnumeration scale,
      ∀ nu ∈ D.angularIndices scale, AEStronglyMeasurable (tail n nu) volume)
    (F : ENNReal)
    (hpacket : ∀ n ∈ relevantRadialIndexEnumeration scale,
      ∀ nu ∈ D.angularIndices scale,
        eLpNorm (tail n nu) 4 volume ≤
          ENNReal.ofReal (C * (scale⁻¹) ^ (N + 1)) * F) :
    eLpNorm (angularRadialSquareFunction (relevantRadialIndexEnumeration scale)
        (D.angularIndices scale) tail) 4 volume ≤
      ENNReal.ofReal (11 * D.angular_card.choose * C * (scale⁻¹) ^ N) * F := by
  let E : ENNReal := ENNReal.ofReal (C * (scale⁻¹) ^ (N + 1)) * F
  have hsum := scratch_eLpNorm_four_canonicalAngularRadialSquareFunction_le_scale_mul
    D hscale tail htailMeas E (by
      intro n hn nu hnu
      exact hpacket n hn nu hnu)
  calc
    eLpNorm (angularRadialSquareFunction (relevantRadialIndexEnumeration scale)
        (D.angularIndices scale) tail) 4 volume ≤
        ENNReal.ofReal (11 * D.angular_card.choose * scale) * E := hsum
    _ = ENNReal.ofReal (11 * D.angular_card.choose * C * (scale⁻¹) ^ N) * F := by
      dsimp only [E]
      rw [← mul_assoc]
      rw [← ENNReal.ofReal_mul]
      · congr 2
        have hscale_pos : 0 < scale := by linarith
        have hcancel : scale * scale⁻¹ = 1 :=
          mul_inv_cancel₀ (ne_of_gt hscale_pos)
        rw [show (scale⁻¹) ^ (N + 1) = (scale⁻¹) ^ N * scale⁻¹ by
          rw [pow_succ]]
        calc
          (11 * D.angular_card.choose * scale) *
              (C * ((scale⁻¹) ^ N * scale⁻¹)) =
              (11 * D.angular_card.choose * C * (scale⁻¹) ^ N) *
                (scale * scale⁻¹) := by ring
          _ = 11 * D.angular_card.choose * C * (scale⁻¹) ^ N := by
            rw [hcancel, mul_one]
      · have hCa_pos : 0 < D.angular_card.choose := D.angular_card.choose_spec.1
        positivity

/-- The one-packet rapid kernel estimate aggregates over the canonical
radial and angular families with a single lost power of `scale`.  The
measurability premise is intentionally explicit: it is a property of the
literal physical packet realization, not an additional operator bound. -/
private theorem scratchWavefrontRapidMultiplierBounds.exists_squareFunction_L4_rapid_bound
    {D : MSSWavefrontKernelData}
    (hrapid : scratchWavefrontRapidMultiplierBounds D) (N : Nat)
    (hmeas : ∀ (scale : Real) (hscale : 0 < scale) (n nu : Int),
      2 ≤ scale → n ∈ relevantRadialIndexEnumeration scale →
        nu ∈ D.angularIndices scale →
          ∀ f : SchwartzMap (Euclidean 2) Complex,
            AEStronglyMeasurable
              (scratchWavefrontPacketResidual D scale hscale n nu f) volume) :
    ∃ C : Real, 0 < C ∧
      ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
        ∀ f : SchwartzMap (Euclidean 2) Complex,
          eLpNorm
              (angularRadialSquareFunction (relevantRadialIndexEnumeration scale)
                (D.angularIndices scale)
                (fun n nu => scratchWavefrontPacketResidual D scale hscale n nu f))
              4 volume ≤
            ENNReal.ofReal (C * (scale⁻¹) ^ N) *
              eLpNorm (f : Euclidean 2 → Complex) 4 volume := by
  rcases hrapid.exists_packet_L4_rapid_bound (N + 1) with ⟨C, hCpos, hpacket⟩
  refine ⟨11 * D.angular_card.choose * C, ?_, ?_⟩
  · have hCa_pos : 0 < D.angular_card.choose := D.angular_card.choose_spec.1
    positivity
  · intro scale hscale hscale_two f
    exact scratch_eLpNorm_four_canonicalAngularRadialSquareFunction_rapid
      D.toMSSWavefrontCutoffData hscale_two N C
      (fun n nu => scratchWavefrontPacketResidual D scale hscale n nu f)
      (fun n hn nu hnu => hmeas scale hscale n nu hscale_two hn hnu f)
      (eLpNorm (f : Euclidean 2 → Complex) 4 volume)
       (fun n hn nu hnu => hpacket scale hscale n nu hscale_two hn hnu f)

/-- Private bridge from the derived packet estimate to the literal raw
square-function error in the wave-front-localization statement. -/
private theorem wavefrontLocalizationError_of_MSSWavefrontKernelData
    (D : MSSWavefrontKernelData) (R : MSSWavefrontRawProfileRealization D)
    (hspatial : MSSWavefrontSpatialProfilePolynomialRegularity D)
    (_hgamma : 0 < D.gamma) (_hgammaSmall : D.gamma < 1 / 10) :
    wavefrontLocalizationError D.toMSSWavefrontCutoffData D.gamma := by
  intro _ _ N _hN
  let hrapid : scratchWavefrontRapidMultiplierBounds D :=
    hspatial.to_cutoffProfileRegularity.to_rapidMultiplierBounds
  obtain ⟨C, hCpos, hbound⟩ :=
    hrapid.exists_squareFunction_L4_rapid_bound N (by
      intro scale hscale n nu hscale_two hn hnu f
      rw [← mssAngularRadialWave_sub_mssWavefrontAngularRadialWave_eq_packetResidual
        D R scale hscale n nu hnu f]
      exact mssAngularRadialWave_sub_mssWavefrontAngularRadialWave_aestronglyMeasurable
        D R scale hscale n nu hnu f)
  refine ⟨C, hCpos, ?_⟩
  intro scale hscale_two f
  have hscale : 0 < scale := by linarith
  have hsq :
      angularRadialSquareFunction (relevantRadialIndexEnumeration scale)
        (D.angularIndices scale)
        (fun n nu => fun z =>
          mssAngularRadialWave D.toMSSWavefrontCutoffData scale n nu
              (f : Euclidean 2 → Complex) z -
            mssWavefrontAngularRadialWave D.toMSSWavefrontCutoffData scale D.gamma n nu
              (f : Euclidean 2 → Complex) z) =
      angularRadialSquareFunction (relevantRadialIndexEnumeration scale)
        (D.angularIndices scale)
        (fun n nu => scratchWavefrontPacketResidual D scale hscale n nu f) := by
    funext z
    unfold angularRadialSquareFunction
    apply congrArg Real.sqrt
    apply Finset.sum_congr rfl
    intro n hn
    apply Finset.sum_congr rfl
    intro nu hnu
    change ‖mssAngularRadialWave D.toMSSWavefrontCutoffData scale n nu
        (f : Euclidean 2 → Complex) z -
        mssWavefrontAngularRadialWave D.toMSSWavefrontCutoffData scale D.gamma n nu
          (f : Euclidean 2 → Complex) z‖ ^ 2 =
      ‖scratchWavefrontPacketResidual D scale hscale n nu f z‖ ^ 2
    have heq :=
      mssAngularRadialWave_sub_mssWavefrontAngularRadialWave_eq_packetResidual
        D R scale hscale n nu hnu f
    have heqz :
        mssAngularRadialWave D.toMSSWavefrontCutoffData scale n nu
            (f : Euclidean 2 → Complex) z -
          mssWavefrontAngularRadialWave D.toMSSWavefrontCutoffData scale D.gamma n nu
            (f : Euclidean 2 → Complex) z =
          scratchWavefrontPacketResidual D scale hscale n nu f z := by
      simpa only [Pi.sub_apply] using congrFun heq z
    rw [heqz]
  rw [hsq]
  exact hbound scale hscale hscale_two f

/-- Private literal Fourier-support bridge for active wave-front packets. -/
private theorem wavefrontPlateSupport_of_MSSWavefrontKernelData
    (D : MSSWavefrontKernelData) (R : MSSWavefrontRawProfileRealization D) :
    wavefrontPlateSupport D.toMSSWavefrontCutoffData D.gamma := by
  intro scale hscale_two n nu _hn hnu f
  have hscale : 0 < scale := by linarith
  let P := scratchWavefrontRawProfiles D R scale hscale n nu f
  change Function.support
      (spaceTimeFourier
        (wavefrontAngularRadialWave (D.radialTime.vertical : Real → Complex)
          (D.radialTime.radial : Real → Complex) (D.chi scale) (D.tildeChi scale)
          (D.normal : Real → Complex) scale D.gamma
          (D.radialTime.amplitude : Euclidean 2 → Complex)
          (D.radialTime.time : Real → Complex) n nu (f : Euclidean 2 → Complex))) ⊆ _
  exact support_wavefrontAngularRadialWave_subset_conicPlate_of_profiles
    D.radialTime D.normal scale D.gamma D.angularConstant (D.directions scale nu) n
    (D.chi scale) (D.tildeChi scale) nu f hscale_two P
    (D.tildeChi_support scale nu hnu) D.normal_support

/-- The active blueprint wave-front-localization lemma.  Its error clause is
derived from scale-indexed cutoff/profile regularity, and its support clause
is the literal conic-plate Fourier support of every active packet. -/
theorem wavefrontLocalization_of_MSSWavefrontKernelData
    (D : MSSWavefrontKernelData) (R : MSSWavefrontRawProfileRealization D)
    (hspatial : MSSWavefrontSpatialProfilePolynomialRegularity D) :
    wavefrontLocalization D.toMSSWavefrontCutoffData D.gamma := by
  refine ⟨?_, ?_⟩
  · exact wavefrontLocalizationError_of_MSSWavefrontKernelData D R hspatial
      D.gamma_pos D.gamma_lt_tenth
  · exact wavefrontPlateSupport_of_MSSWavefrontKernelData D R


end
