def angularSectorGeometry (scale : Real) (indices : Finset Int)
    (directions : Int → Euclidean 2)
    (sectorRadius spacingLower spacingUpper : Real) : Prop :=
  0 < sectorRadius ∧ sectorRadius ≤ 1 / 4 ∧
  0 < spacingLower ∧ 0 < spacingUpper ∧
  ∃ center : Euclidean 2, ‖center‖ = 1 ∧
    ∀ ν ∈ indices, ‖directions ν‖ = 1 ∧
      ‖directions ν - center‖ ≤ sectorRadius ∧
      ∀ ν' ∈ indices,
        spacingLower * ((ν - ν').natAbs : Real) *
            scale ^ (-(1 / 2 : Real)) ≤ ‖directions ν - directions ν'‖ ∧
        ‖directions ν - directions ν'‖ ≤
          spacingUpper * ((ν - ν').natAbs : Real) *
            scale ^ (-(1 / 2 : Real))

