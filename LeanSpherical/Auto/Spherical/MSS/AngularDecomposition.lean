      sectorRadius spacingLower spacingUpper)
    {ν ν' : Int} (hν : ν ∈ indices) (hν' : ν' ∈ indices)
    (hdirections : directions ν = directions ν') : ν = ν' := by
  rcases hgeometry with ⟨_, _, hspacingLower, _, center, hcenter, hdata⟩
  by_contra hne
  have hlabel : 0 < ((ν - ν').natAbs : Real) := by
    exact_mod_cast Int.natAbs_pos.mpr (sub_ne_zero.mpr hne)
