    (normalCutoff : Real → Complex) (scale gamma : Real)
    (G : WaveSpaceTime → Complex) : WaveSpaceTime → Complex :=
  spaceTimeFourierInv (fun ζ =>
    wavefrontMultiplier angularCutoff normalCutoff scale gamma ζ *
      spaceTimeFourier G ζ)

/-- The conic plate supporting a wave-front localized radial/angular piece.
The angular sector is represented by normalized Euclidean distance from its
central direction, an equivalent concrete aperture convention. -/
def conicPlate (scale gamma angularConstant : Real) (n : Int)
    (direction : Euclidean 2) : Set WaveSpaceTime :=
  {ζ | scale / 4 ≤ ‖ζ.1‖ ∧ ‖ζ.1‖ ≤ 4 * scale ∧
    ζ.1 ∈ angularSector direction
      (angularConstant * scale ^ (-(1 / 2 : Real))) ∧
    |(Real.sqrt scale)⁻¹ * ζ.2 - n| ≤ 1 ∧
    |ζ.2 - ‖ζ.1‖| ≤ 2 * scale ^ gamma}

