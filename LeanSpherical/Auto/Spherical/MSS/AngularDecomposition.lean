def wavefrontMultiplier (angularCutoff : Euclidean 2 → Complex)
    (normalCutoff : Real → Complex) (scale gamma : Real) :
    WaveSpaceTime → Complex :=
  fun ζ => angularCutoff ζ.1 *
    normalCutoff (scale ^ (-gamma) * (ζ.2 - ‖ζ.1‖))

