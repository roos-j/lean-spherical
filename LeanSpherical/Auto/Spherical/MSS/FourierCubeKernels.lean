  classical
  have hsum : ∀ ξ : Euclidean 2,
      ∑ cube ∈ cubes, m cube ξ = radialMultiplier ξ := by
    intro ξ
    calc
      ∑ cube ∈ cubes, m cube ξ =
          ∑ cube ∈ cubes, radialMultiplier ξ * cubePartition cube ξ := by
            apply Finset.sum_congr rfl
            intro cube hcube
            exact hfactor cube hcube ξ
      _ = radialMultiplier ξ * ∑ cube ∈ cubes, cubePartition cube ξ := by
            rw [Finset.mul_sum]
      _ = radialMultiplier ξ := by
            by_cases hzero : radialMultiplier ξ = 0
            · rw [hzero]
              simp
            · rw [hpartition ξ hzero, mul_one]
  have hsynthesis :
      (fun x => ∑ cube ∈ cubes, fourierCubeProjection (m cube) f x) =
        radialPiece β scale n (f : Euclidean 2 → Complex) :=
    sum_fourierCubeProjection_eq_radialPiece_of_sum_eq
      cubes m radialMultiplier β scale n f hradial hsum
  exact congrArg
    (fun g : Euclidean 2 → Complex => angularPiece scale a χ ϑ g)
    hsynthesis |>.symm

/-- Applying the conic half-wave operator to the finite radial synthesis
gives exactly the corresponding conic radial summand. -/
theorem conicOperator_sum_fourierCubeProjection_eq_radialPiece_of_sum_eq
    {κ : Type*} (cubes : Finset κ)
    (m : κ → SchwartzMap (Euclidean 2) Complex)
    (radialMultiplier : SchwartzMap (Euclidean 2) Complex)
    (β : Real → Complex) (scale : Real) (n : Int)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex)
    (f : SchwartzMap (Euclidean 2) Complex)
    (hradial : ∀ ξ : Euclidean 2,
      radialMultiplier ξ = β ((Real.sqrt scale)⁻¹ * ‖ξ‖ - n))
    (hsum : ∀ ξ : Euclidean 2, ∑ cube ∈ cubes, m cube ξ = radialMultiplier ξ) :
    conicOperator scale a ϑ
        (fun x => ∑ cube ∈ cubes, fourierCubeProjection (m cube) f x) =
      conicOperator scale a ϑ (radialPiece β scale n (f : Euclidean 2 → Complex)) := by
  rw [sum_fourierCubeProjection_eq_radialPiece_of_sum_eq
    cubes m radialMultiplier β scale n f hradial hsum]

/-- The literal spatial kernel of the existing planar Fourier-cube
projection. -/
noncomputable def fourierCubePhysicalKernel
    (m : SchwartzMap (Euclidean 2) Complex) (x y : Euclidean 2) : Complex :=
  Auto.Spherical.Auxiliary.fourierCubeSourceKernel m x y

/-- The existing Fourier-cube projection is exactly its physical kernel
integral. -/
theorem fourierCubeProjection_eq_physicalKernel
    (m f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    fourierCubeProjection m f x =
      ∫ y : Euclidean 2, fourierCubePhysicalKernel m x y * f y := by
  simpa only [fourierCubeProjection, fourierCubePhysicalKernel] using
    (Auto.Spherical.Auxiliary.fourierCubeProjection_eq_sourceKernel m f x)

theorem integrable_fourierCubePhysicalKernel
    (m : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    Integrable (fun y : Euclidean 2 => fourierCubePhysicalKernel m x y) volume := by
  exact Auto.Spherical.Auxiliary.integrable_fourierCubeSourceKernel m x

/-- The source mass of a planar cube projection is independent of its
output point. -/
theorem integral_norm_fourierCubePhysicalKernel_eq
    (m : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    (∫ y : Euclidean 2, ‖fourierCubePhysicalKernel m x y‖) =
      ∫ y : Euclidean 2, ‖Auto.Spherical.Auxiliary.fourierCubeKernel m y‖ := by
  exact Auto.Spherical.Auxiliary.integral_norm_fourierCubeSourceKernel_eq m x

/-- A concrete finite family of the existing cube cutoffs has a uniform
spatial source-mass bound. -/
theorem exists_uniform_fourierCubePhysicalKernelMass
    {ι : Type*} (cubes : Finset ι)
    (m : ι → SchwartzMap (Euclidean 2) Complex) :
    ∃ A : Real, 0 ≤ A ∧ ∀ cube ∈ cubes, ∀ x : Euclidean 2,
      Integrable (fun y : Euclidean 2 => fourierCubePhysicalKernel (m cube) x y)
        volume ∧
      (∫ y : Euclidean 2, ‖fourierCubePhysicalKernel (m cube) x y‖) ≤ A := by
  refine ⟨Auto.Spherical.Auxiliary.finiteFourierCubeKernelMass cubes m,
    Auto.Spherical.Auxiliary.finiteFourierCubeKernelMass_nonneg cubes m, ?_⟩
  intro cube hcube x
  exact ⟨integrable_fourierCubePhysicalKernel (m cube) x,
    by simpa only [fourierCubePhysicalKernel] using
      (Auto.Spherical.Auxiliary.integral_norm_fourierCubeSourceKernel_le_finiteMass
        cubes m hcube x)⟩

/-- The literal frequency symbol obtained by multiplying a dyadic half-wave
symbol by concrete angular and cube Schwartz cutoffs. -/
noncomputable def angularDyadicCubeSchwartzSymbol
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex (χ : Euclidean 2 → Complex)
    (SchwartzMap.smulLeftCLM Complex (m : Euclidean 2 → Complex)
      (dyadicHalfWaveSchwartzSymbol C σ j t))

theorem angularDyadicCubeSchwartzSymbol_apply
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m : SchwartzMap (Euclidean 2) Complex) (ξ : Euclidean 2) :
    angularDyadicCubeSchwartzSymbol C σ j t χ m ξ =
      χ ξ * m ξ * dyadicHalfWaveSchwartzSymbol C σ j t ξ := by
  rw [angularDyadicCubeSchwartzSymbol,
    SchwartzMap.smulLeftCLM_apply_apply χ.hasTemperateGrowth,
    SchwartzMap.smulLeftCLM_apply_apply m.hasTemperateGrowth]
  simp only [smul_eq_mul]
  ring

/-- The spatial kernel of the literal angular half-wave/cube symbol. -/
noncomputable def angularDyadicCubeKernel
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  𝓕⁻ (angularDyadicCubeSchwartzSymbol C σ j t χ m)

/-- The corresponding space-time source kernel, including the concrete time
cutoff. -/
noncomputable def angularDyadicCubeSpaceTimeKernel
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ m : SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (z : WaveSpaceTime) (y : Euclidean 2) : Complex :=
  ϑ z.2 * angularDyadicCubeKernel C σ j z.2 χ m (z.1 - y)

/-- The physical output of the literal angular half-wave/cube multiplier. -/
noncomputable def angularDyadicCubePiece
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun ξ : Euclidean 2 =>
    angularDyadicCubeSchwartzSymbol C σ j t χ m ξ *
      𝓕 (f : Euclidean 2 → Complex) ξ) x

/-- The angular half-wave/cube piece has its exact literal source-kernel
representation. -/
theorem angularDyadicCubePiece_eq_sourceKernel
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    angularDyadicCubePiece C σ j t χ m f x =
      ∫ y : Euclidean 2,
        angularDyadicCubeKernel C σ j t χ m (x - y) * f y := by
  simpa only [angularDyadicCubePiece, angularDyadicCubeKernel,
    Auto.Spherical.Auxiliary.fourierCubeSourceKernel,
    Auto.Spherical.Auxiliary.fourierCubeKernel] using
    (Auto.Spherical.Auxiliary.fourierCubeProjection_eq_sourceKernel
      (angularDyadicCubeSchwartzSymbol C σ j t χ m) f x)

/-- Each fixed space-time slice of the literal angular half-wave/cube kernel
is integrable in its source variable. -/
theorem angularDyadicCubeSpaceTimeKernel_integrable
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ m : SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (z : WaveSpaceTime) :
    Integrable (fun y : Euclidean 2 =>
      angularDyadicCubeSpaceTimeKernel C σ j χ m ϑ z y) volume := by
  exact ((angularDyadicCubeKernel C σ j z.2 χ m).integrable.comp_sub_left z.1)
    |>.const_mul (ϑ z.2)

/-- The source `L¹` mass of the literal kernel is its time-cutoff magnitude
times the spatial kernel mass. -/
theorem integral_norm_angularDyadicCubeSpaceTimeKernel_eq
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ m : SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (z : WaveSpaceTime) :
    (∫ y : Euclidean 2,
      ‖angularDyadicCubeSpaceTimeKernel C σ j χ m ϑ z y‖) =
      ‖ϑ z.2‖ * ∫ u : Euclidean 2,
        ‖angularDyadicCubeKernel C σ j z.2 χ m u‖ := by
  unfold angularDyadicCubeSpaceTimeKernel
  calc
    (∫ y : Euclidean 2, ‖ϑ z.2 *
        angularDyadicCubeKernel C σ j z.2 χ m (z.1 - y)‖) =
        ∫ y : Euclidean 2, ‖ϑ z.2‖ *
          ‖angularDyadicCubeKernel C σ j z.2 χ m (z.1 - y)‖ := by
      apply integral_congr_ae
      filter_upwards with y
      rw [norm_mul]
    _ = ‖ϑ z.2‖ * ∫ y : Euclidean 2,
          ‖angularDyadicCubeKernel C σ j z.2 χ m (z.1 - y)‖ :=
      integral_const_mul _ _
    _ = ‖ϑ z.2‖ * ∫ u : Euclidean 2,
          ‖angularDyadicCubeKernel C σ j z.2 χ m u‖ := by
      rw [integral_sub_left_eq_self
        (fun u : Euclidean 2 => ‖angularDyadicCubeKernel C σ j z.2 χ m u‖)
        volume z.1]

/-- The existing level-`j` angular piece of a Fourier-cube projection is
exactly the literal angular half-wave/cube source-kernel integral. -/
theorem angularPiece_dyadicCube_eq_spaceTimeKernel
    (C : lpCutoffs 2) (j : Nat) (χ m f : SchwartzMap (Euclidean 2) Complex)
    (ϑ : Real → Complex) (z : WaveSpaceTime) :
    angularPiece ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0)
      (χ : Euclidean 2 → Complex) ϑ (fourierCubeProjection m f) z =
      ∫ y : Euclidean 2,
        angularDyadicCubeSpaceTimeKernel C WaveSign.plus j χ m ϑ z y * f y := by
  have hproj : fourierCubeProjection m f =
      (Auto.Spherical.Auxiliary.fourierCubeProjectedSchwartz m f :
        Euclidean 2 → Complex) := by
    funext x
    exact (Auto.Spherical.Auxiliary.fourierCubeProjectedSchwartz_apply m f x).symm
  rw [hproj]
  unfold angularPiece
  have hsymbol :
      (fun ξ : Euclidean 2 =>
        χ ξ * dyadicBandpassMultiplier C.cutoff 0 (((2 : Real) ^ j)⁻¹ • ξ) *
          halfWaveMultiplier WaveSign.plus z.2 ξ *
          𝓕 (Auto.Spherical.Auxiliary.fourierCubeProjectedSchwartz m f :
            Euclidean 2 → Complex) ξ) =
        fun ξ : Euclidean 2 =>
          angularDyadicCubeSchwartzSymbol C WaveSign.plus j z.2 χ m ξ *
            𝓕 (f : Euclidean 2 → Complex) ξ := by
    funext ξ
    rw [Auto.Spherical.Auxiliary.fourier_fourierCubeProjectedSchwartz_apply,
      angularDyadicCubeSchwartzSymbol_apply,
      dyadicHalfWaveSchwartzSymbol_apply, dyadicHalfWaveSymbol,
      ← dyadicBandpassMultiplier_eq_levelZero_scaled C j ξ]
    ring
  rw [hsymbol]
  change ϑ z.2 * angularDyadicCubePiece C WaveSign.plus j z.2 χ m f z.1 = _
  rw [angularDyadicCubePiece_eq_sourceKernel]
  unfold angularDyadicCubeSpaceTimeKernel
  rw [← integral_const_mul]
  apply integral_congr_ae
  filter_upwards with y
  ring

/-- The literal angular half-wave/cube symbol is compactly supported.  The
dyadic half-wave cutoff supplies the support; the angular and cube factors do
not enlarge it. -/
theorem hasCompactSupport_angularDyadicCubeSchwartzSymbol
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m : SchwartzMap (Euclidean 2) Complex) :
    HasCompactSupport (angularDyadicCubeSchwartzSymbol C σ j t χ m :
      Euclidean 2 → Complex) := by
  have hhalf : HasCompactSupport (dyadicHalfWaveSchwartzSymbol C σ j t :
      Euclidean 2 → Complex) :=
    hasCompactSupport_dyadicHalfWaveSchwartzSymbol C σ j t
  have hprod : HasCompactSupport (fun ξ : Euclidean 2 =>
      (χ ξ * m ξ) * dyadicHalfWaveSchwartzSymbol C σ j t ξ) :=
    HasCompactSupport.mul_left hhalf
  have heq : (angularDyadicCubeSchwartzSymbol C σ j t χ m :
      Euclidean 2 → Complex) = fun ξ =>
      (χ ξ * m ξ) * dyadicHalfWaveSchwartzSymbol C σ j t ξ := by
    funext ξ
    rw [angularDyadicCubeSchwartzSymbol_apply]
  rw [heq]
  exact hprod

/-- The literal angular half-wave/cube symbol is smooth to every order. -/
theorem contDiff_angularDyadicCubeSchwartzSymbol
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m : SchwartzMap (Euclidean 2) Complex) :
    ContDiff Real (⊤ : ℕ∞) (angularDyadicCubeSchwartzSymbol C σ j t χ m :
      Euclidean 2 → Complex) := by
  exact (angularDyadicCubeSchwartzSymbol C σ j t χ m).smooth ⊤

/-- A concrete Fourier-cube cutoff centered at `scale • direction`, with
side-radius `width * sqrt scale`.  This is the frequency support interface
for a ray-directed MSS packet; it is not a tube-decay hypothesis. -/
def isScaledRayCubeCutoff (scale width : Real) (direction : Euclidean 2)
    (m : SchwartzMap (Euclidean 2) Complex) : Prop :=
  isFourierCubeCutoff (scale • direction) (width * Real.sqrt scale) m

/-- The concrete ray-cube multiplier obtained from one fixed Schwartz
prototype by translation to `scale • direction` and dilation by the cube
side-radius.  The positivity proof is only used to select the invertible
dilation; the resulting function is literally the stated affine pullback. -/
def scaledRayCubeCutoff (prototype : SchwartzMap (Euclidean 2) Complex)
    (scale width : Real) (direction : Euclidean 2)
    (hradius : 0 < width * Real.sqrt scale) :
    SchwartzMap (Euclidean 2) Complex :=
  translatedDilatedSchwartzCutoff prototype (scale • direction)
    (width * Real.sqrt scale) hradius.ne'

/-- Pointwise normal form of the concrete scaled ray-cube cutoff. -/
theorem scaledRayCubeCutoff_apply (prototype : SchwartzMap (Euclidean 2) Complex)
    (scale width : Real) (direction xi : Euclidean 2)
    (hradius : 0 < width * Real.sqrt scale) :
    scaledRayCubeCutoff prototype scale width direction hradius xi =
      prototype ((width * Real.sqrt scale)⁻¹ • (xi - scale • direction)) := by
  exact translatedDilatedSchwartzCutoff_apply prototype (scale • direction) xi
    (width * Real.sqrt scale) hradius.ne'

/-- A prototype supported in the unit coordinate cube produces a genuine
Fourier-cube cutoff at every positive translated/dilated scale. -/
theorem isFourierCubeCutoff_translatedDilatedSchwartzCutoff
    (prototype : SchwartzMap (Euclidean 2) Complex) (center : Euclidean 2)
    {radius : Real} (hradius : 0 < radius)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      frequencyCube 0 1) :
    isFourierCubeCutoff center radius
      (translatedDilatedSchwartzCutoff prototype center radius hradius.ne') := by
  refine ⟨hradius.le, ?_⟩
  intro xi hxi
  change translatedDilatedSchwartzCutoff prototype center radius hradius.ne' xi ≠ 0 at hxi
  have hne : prototype (radius⁻¹ • (xi - center)) ≠ 0 := by
    simpa only [translatedDilatedSchwartzCutoff_apply] using hxi
  have hunit := hprototype hne
  rw [mem_frequencyCube_iff] at hunit ⊢
  intro i
  have hdiv : |xi i - center i| / radius ≤ 1 := by
    simpa [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_inv,
      abs_of_pos hradius, div_eq_mul_inv, mul_comm] using hunit i
  simpa using (div_le_iff₀ hradius).mp hdiv

/-- The concrete affine pullback satisfies the existing ray-cube support
interface whenever its fixed prototype is supported in the unit cube. -/
theorem isScaledRayCubeCutoff_scaledRayCubeCutoff
    (prototype : SchwartzMap (Euclidean 2) Complex) (scale width : Real)
    (direction : Euclidean 2) (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      frequencyCube 0 1) :
    isScaledRayCubeCutoff scale width direction
      (scaledRayCubeCutoff prototype scale width direction hradius) :=
  isFourierCubeCutoff_translatedDilatedSchwartzCutoff prototype
    (scale • direction) hradius hprototype

/-- Exact all-order derivative-integral scaling for the concrete planar
ray-cube multiplier.  This supplies the cutoff-normalization half of the
residual seminorm bridge; phase mismatch estimates remain separate. -/
theorem integral_norm_iteratedFDeriv_scaledRayCubeCutoff
    (prototype : SchwartzMap (Euclidean 2) Complex) (scale width : Real)
    (direction : Euclidean 2) (hradius : 0 < width * Real.sqrt scale) (n : Nat) :
    ∫ xi : Euclidean 2,
      ‖iteratedFDeriv Real n
        (scaledRayCubeCutoff prototype scale width direction hradius) xi‖ =
      (width * Real.sqrt scale) ^ 2 *
        ((width * Real.sqrt scale)⁻¹) ^ n *
          ∫ eta : Euclidean 2, ‖iteratedFDeriv Real n prototype eta‖ := by
  have hdim : Module.finrank Real (Euclidean 2) = 2 := by norm_num
  simpa only [scaledRayCubeCutoff, hdim] using
    (integral_norm_iteratedFDeriv_translatedDilatedSchwartzCutoff prototype
      (scale • direction) hradius n)

/-- A Euclidean-ball prototype support gives the corresponding literal ball
support after the scaled ray-cube affine pullback.  This complements the
coordinate-cube support interface with the radial control needed for the
half-wave phase calculation. -/
theorem support_scaledRayCubeCutoff_subset_closedBall
    (prototype : SchwartzMap (Euclidean 2) Complex) (scale width : Real)
    (direction : Euclidean 2) (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1) :
    Function.support
      (scaledRayCubeCutoff prototype scale width direction hradius :
        Euclidean 2 → Complex) ⊆
      Metric.closedBall (scale • direction) (width * Real.sqrt scale) := by
  intro ξ hξ
  change scaledRayCubeCutoff prototype scale width direction hradius ξ ≠ 0 at hξ
  have hne : prototype
      ((width * Real.sqrt scale)⁻¹ • (ξ - scale • direction)) ≠ 0 := by
    simpa only [scaledRayCubeCutoff_apply] using hξ
  have hunit := hprototype hne
  rw [Metric.mem_closedBall, dist_zero_right] at hunit
  rw [Metric.mem_closedBall, dist_eq_norm]
  have hscale : 0 < width * Real.sqrt scale := hradius
  have hnorm : ‖(width * Real.sqrt scale)⁻¹ • (ξ - scale • direction)‖ =
      (width * Real.sqrt scale)⁻¹ * ‖ξ - scale • direction‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hscale)]
  rw [hnorm] at hunit
  have hscale_id (a : Real) : a =
      (width * Real.sqrt scale) * ((width * Real.sqrt scale)⁻¹ * a) := by
    let r : Real := width * Real.sqrt scale
    have hr : r ≠ 0 := by
      dsimp [r]
      exact hscale.ne'
    change a = r * (r⁻¹ * a)
    calc
      a = 1 * a := by ring
      _ = (r * r⁻¹) * a := by rw [mul_inv_cancel₀ hr]
      _ = r * (r⁻¹ * a) := by ring
  calc
    ‖ξ - scale • direction‖ =
        (width * Real.sqrt scale) *
          ((width * Real.sqrt scale)⁻¹ * ‖ξ - scale • direction‖) := by
      exact hscale_id _
    _ ≤ (width * Real.sqrt scale) * 1 :=
      mul_le_mul_of_nonneg_left hunit hscale.le
    _ = width * Real.sqrt scale := by ring

/-- All frequency derivatives of the concrete cube cutoff remain in the
same closed affine ball. -/
theorem support_iteratedFDeriv_scaledRayCubeCutoff_subset_closedBall
    (prototype : SchwartzMap (Euclidean 2) Complex) (scale width : Real)
    (direction : Euclidean 2) (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1) (n : Nat) :
    Function.support (iteratedFDeriv Real n
      (scaledRayCubeCutoff prototype scale width direction hradius :
        Euclidean 2 → Complex)) ⊆
      Metric.closedBall (scale • direction) (width * Real.sqrt scale) := by
  have hsupport := support_scaledRayCubeCutoff_subset_closedBall
    prototype scale width direction hradius hprototype
  have htsupport : tsupport
      (scaledRayCubeCutoff prototype scale width direction hradius :
        Euclidean 2 → Complex) ⊆
      Metric.closedBall (scale • direction) (width * Real.sqrt scale) :=
    closure_minimal hsupport Metric.isClosed_closedBall
  exact (support_iteratedFDeriv_subset n).trans htsupport

/-- The literal angular half-wave/cube symbol stays in the concrete frequency
cube supporting its cube multiplier. -/
theorem support_angularDyadicCubeSchwartzSymbol_subset_frequencyCube
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m : SchwartzMap (Euclidean 2) Complex) (center : Euclidean 2)
    (radius : Real) (hm : isFourierCubeCutoff center radius m) :
    Function.support (angularDyadicCubeSchwartzSymbol C σ j t χ m :
      Euclidean 2 → Complex) ⊆ frequencyCube center radius := by
  intro ξ hξ
  apply hm.2
  intro hzero
  apply hξ
  rw [angularDyadicCubeSchwartzSymbol_apply, hzero]
  ring

private noncomputable def aux_angularDyadicCubeProjectedSchwartz
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  𝓕⁻ (SchwartzMap.smulLeftCLM Complex
    (angularDyadicCubeSchwartzSymbol C σ j t χ m : Euclidean 2 → Complex) (𝓕 f))

private theorem aux_angularDyadicCubeProjectedSchwartz_apply
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    aux_angularDyadicCubeProjectedSchwartz C σ j t χ m f x =
      angularDyadicCubePiece C σ j t χ m f x := by
  simp only [aux_angularDyadicCubeProjectedSchwartz, SchwartzMap.fourierInv_coe,
    SchwartzMap.smulLeftCLM_apply
      (angularDyadicCubeSchwartzSymbol C σ j t χ m).hasTemperateGrowth,
    smul_eq_mul, SchwartzMap.fourier_coe, angularDyadicCubePiece]

/-- The fixed-time spatial Fourier transform of the literal angular/cube
half-wave piece is exactly its cube-localized multiplier times the input
Fourier transform.  This is a spatial statement only. -/
theorem fourier_angularDyadicCubePiece_apply
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m f : SchwartzMap (Euclidean 2) Complex) (ξ : Euclidean 2) :
    𝓕 (angularDyadicCubePiece C σ j t χ m f) ξ =
      angularDyadicCubeSchwartzSymbol C σ j t χ m ξ *
        𝓕 (f : Euclidean 2 → Complex) ξ := by
  have hpiece : angularDyadicCubePiece C σ j t χ m f =
      (aux_angularDyadicCubeProjectedSchwartz C σ j t χ m f :
        Euclidean 2 → Complex) := by
    funext x
    exact (aux_angularDyadicCubeProjectedSchwartz_apply C σ j t χ m f x).symm
  rw [hpiece]
  rw [← SchwartzMap.fourier_coe]
  unfold aux_angularDyadicCubeProjectedSchwartz
  rw [FourierTransform.fourier_fourierInv_eq]
  simp only [SchwartzMap.smulLeftCLM_apply_apply
    (angularDyadicCubeSchwartzSymbol C σ j t χ m).hasTemperateGrowth,
    smul_eq_mul, SchwartzMap.fourier_coe]

/-- Every fixed-time spatial Fourier slice of a literal angular/cube piece
stays in the frequency cube supporting its cube multiplier.  It does not
claim space-time conic-plate support. -/
theorem support_fourier_angularDyadicCubePiece_subset_frequencyCube
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m f : SchwartzMap (Euclidean 2) Complex)
    (center : Euclidean 2) (radius : Real) (hm : isFourierCubeCutoff center radius m) :
    Function.support (𝓕 (angularDyadicCubePiece C σ j t χ m f)) ⊆
      frequencyCube center radius := by
  intro ξ hξ
  apply hm.2
  intro hzero
  apply hξ
  rw [fourier_angularDyadicCubePiece_apply,
    angularDyadicCubeSchwartzSymbol_apply, hzero]
  ring

/-- Specialization of the fixed-time Fourier-support theorem to the concrete
scaled ray cube.  The conclusion remains spatial and makes no normal-frequency
or conic-plate assertion. -/
theorem support_fourier_scaledRayAngularDyadicCubePiece_subset_frequencyCube
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t scale width : Real)
    (direction : Euclidean 2) (χ prototype f : SchwartzMap (Euclidean 2) Complex)
    (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      frequencyCube 0 1) :
    Function.support (𝓕 (angularDyadicCubePiece C σ j t χ
      (scaledRayCubeCutoff prototype scale width direction hradius) f)) ⊆
      frequencyCube (scale • direction) (width * Real.sqrt scale) := by
  exact support_fourier_angularDyadicCubePiece_subset_frequencyCube
    C σ j t χ (scaledRayCubeCutoff prototype scale width direction hradius) f
    (scale • direction) (width * Real.sqrt scale)
    (isScaledRayCubeCutoff_scaledRayCubeCutoff prototype scale width direction hradius hprototype)

/-- Remove the plus-wave ray translation from a literal angular/cube symbol.
Its inverse Fourier transform is the original spatial kernel evaluated in
the translated residual coordinate. -/
noncomputable def angularDyadicCubeResidualSymbol
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (direction : Euclidean 2) (χ m : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  Auto.Spherical.Auxiliary.planeWaveModulatedCompactSchwartz (-(t • direction))
    (angularDyadicCubeSchwartzSymbol C σ j t χ m : Euclidean 2 → Complex)
    (hasCompactSupport_angularDyadicCubeSchwartzSymbol C σ j t χ m)
    (contDiff_angularDyadicCubeSchwartzSymbol C σ j t χ m)

/-- Pointwise formula for the ray-residual symbol. -/
theorem angularDyadicCubeResidualSymbol_apply
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (direction : Euclidean 2) (χ m : SchwartzMap (Euclidean 2) Complex)
    (ξ : Euclidean 2) :
    angularDyadicCubeResidualSymbol C σ j t direction χ m ξ =
      ((Real.fourierChar (inner Real (-(t • direction)) ξ) : Circle) : Complex) *
        angularDyadicCubeSchwartzSymbol C σ j t χ m ξ := by
  exact Auto.Spherical.Auxiliary.planeWaveModulatedCompactSchwartz_apply
    (-(t • direction)) (angularDyadicCubeSchwartzSymbol C σ j t χ m :
      Euclidean 2 → Complex)
    (hasCompactSupport_angularDyadicCubeSchwartzSymbol C σ j t χ m)
    (contDiff_angularDyadicCubeSchwartzSymbol C σ j t χ m) ξ

/-- The actual ray-residual amplitude before multiplication by a particular
cube cutoff.  Its phase is the half-wave phase after the light-ray
translation has been removed. -/
noncomputable def angularDyadicResidualBaseSymbol
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (direction : Euclidean 2) (χ : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  Auto.Spherical.Auxiliary.planeWaveModulatedCompactSchwartz (-(t • direction))
    (fun ξ : Euclidean 2 => χ ξ * dyadicHalfWaveSchwartzSymbol C σ j t ξ)
    (HasCompactSupport.mul_left
      (hasCompactSupport_dyadicHalfWaveSchwartzSymbol C σ j t))
    ((χ.smooth (⊤ : ℕ∞)).mul
      ((dyadicHalfWaveSchwartzSymbol C σ j t).smooth (⊤ : ℕ∞)))

/-- Pointwise form of the residual base amplitude. -/
theorem angularDyadicResidualBaseSymbol_apply
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (direction ξ : Euclidean 2) (χ : SchwartzMap (Euclidean 2) Complex) :
    angularDyadicResidualBaseSymbol C σ j t direction χ ξ =
      ((Real.fourierChar (inner Real (-(t • direction)) ξ) : Circle) : Complex) *
        (χ ξ * dyadicHalfWaveSchwartzSymbol C σ j t ξ) := by
  exact Auto.Spherical.Auxiliary.planeWaveModulatedCompactSchwartz_apply
    (-(t • direction))
    (fun η : Euclidean 2 => χ η * dyadicHalfWaveSchwartzSymbol C σ j t η)
    (HasCompactSupport.mul_left
      (hasCompactSupport_dyadicHalfWaveSchwartzSymbol C σ j t))
    ((χ.smooth (⊤ : ℕ∞)).mul
      ((dyadicHalfWaveSchwartzSymbol C σ j t).smooth (⊤ : ℕ∞))) ξ

/-- The residual symbol factors exactly into the actual phase-mismatch base
amplitude and the cube cutoff. -/
theorem angularDyadicCubeResidualSymbol_eq_residualBase_mul
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (direction ξ : Euclidean 2) (χ m : SchwartzMap (Euclidean 2) Complex) :
    angularDyadicCubeResidualSymbol C σ j t direction χ m ξ =
      angularDyadicResidualBaseSymbol C σ j t direction χ ξ * m ξ := by
  rw [angularDyadicCubeResidualSymbol_apply,
    angularDyadicResidualBaseSymbol_apply,
    angularDyadicCubeSchwartzSymbol_apply]
  ring

/-- The literal phase remaining after translating along `direction`. -/
def angularDyadicRayPhaseMismatch
    (σ : WaveSign) (direction ξ : Euclidean 2) : Real :=
  σ.toReal * ‖ξ‖ - inner Real direction ξ

/-- Positive radial dilations have the expected all-order homogeneity away
from the origin.  The proof works on the punctured open space, so it does
not incorrectly treat the norm as globally smooth. -/
theorem iteratedFDeriv_norm_smul_pos
    {d : Nat} (n : Nat) (scale : Real) (hscale : 0 < scale)
    (x : Euclidean d) (hx : x ≠ 0) :
    (scale ^ n) • iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) (scale • x) =
      scale • iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) x := by
  let e : Euclidean d ≃L[Real] Euclidean d :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 scale hscale.ne')
  let s : Set (Euclidean d) := {y | y ≠ 0}
  have hs : IsOpen s := by
    simpa [s] using (isOpen_ne : IsOpen {y : Euclidean d | y ≠ 0})
  have hxs : x ∈ s := hx
  have hexs : e x ∈ s := by
    change scale • x ≠ 0
    exact smul_ne_zero hscale.ne' hx
  have hpre : e ⁻¹' s = s := by
    ext y
    change (scale • y ≠ 0) ↔ y ≠ 0
    constructor
    · exact fun hy hy0 => hy (by simp [hy0])
    · exact fun hy => smul_ne_zero hscale.ne' hy
  have hcomp := e.iteratedFDerivWithin_comp_right
    (fun y : Euclidean d => ‖y‖) hs.uniqueDiffOn hexs n
  have hleft : iteratedFDeriv Real n (fun y : Euclidean d => ‖e y‖) x =
      (scale ^ n) • iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) (e x) := by
    have hcomp' : iteratedFDerivWithin Real n
        ((fun y : Euclidean d => ‖y‖) ∘ e) s x =
        (iteratedFDerivWithin Real n (fun y : Euclidean d => ‖y‖) s (e x)).compContinuousLinearMap
          (fun _ => e) := by
      simpa only [hpre] using hcomp
    rw [iteratedFDerivWithin_of_isOpen n hs hxs,
      iteratedFDerivWithin_of_isOpen n hs hexs] at hcomp'
    rw [show (fun y : Euclidean d => ‖e y‖) = (fun y : Euclidean d => ‖y‖) ∘ e by rfl]
    rw [hcomp']
    ext m
    simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    change iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) (e x)
      (fun i => scale • m i) = _
    simpa using (iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) (e x)).map_smul_univ
      (fun _ : Fin n => scale) m
  have hhom : (fun y : Euclidean d => ‖e y‖) =
      fun y : Euclidean d => scale • ‖y‖ := by
    funext y
    change ‖scale • y‖ = scale • ‖y‖
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hscale]
    rfl
  rw [hhom] at hleft
  have hsmul : iteratedFDeriv Real n (fun y : Euclidean d => scale • ‖y‖) x =
      scale • iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) x := by
    change iteratedFDeriv Real n (scale • (fun y : Euclidean d => ‖y‖)) x = _
    exact iteratedFDeriv_const_smul_apply (a := scale)
      (contDiffAt_norm (n := (n : WithTop ℕ∞)) Real hx)
  rw [hsmul] at hleft
  simpa [e] using hleft.symm

private theorem exists_norm_iteratedFDeriv_norm_bound_on_unitAnnulus
    (d n : Nat) :
    ∃ A : Real, 0 ≤ A ∧ ∀ x : Euclidean d,
      (1 / 2 : Real) ≤ ‖x‖ → ‖x‖ ≤ 2 →
        ‖iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) x‖ ≤ A := by
  let K : Set (Euclidean d) := {x | (1 / 2 : Real) ≤ ‖x‖ ∧ ‖x‖ ≤ 2}
  have hKclosed : IsClosed K := by
    exact (isClosed_le continuous_const continuous_norm).inter
      (isClosed_le continuous_norm continuous_const)
  have hKsubset : K ⊆ Metric.closedBall (0 : Euclidean d) 2 := by
    intro x hx
    change dist x 0 ≤ 2
    simpa [dist_zero_right] using hx.2
  have hK : IsCompact K :=
    (isCompact_closedBall (0 : Euclidean d) 2).of_isClosed_subset hKclosed hKsubset
  have hcont : ContinuousOn (fun x : Euclidean d =>
      iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) x) K := by
    intro x hx
    have hx0 : x ≠ 0 := by
      intro hx0
      subst x
      change (1 / 2 : Real) ≤ ‖(0 : Euclidean d)‖ ∧ ‖(0 : Euclidean d)‖ ≤ 2 at hx
      norm_num at hx
    have hcd : ContDiffAt Real (⊤ : WithTop ℕ∞)
        (fun y : Euclidean d => ‖y‖) x :=
      contDiffAt_norm Real hx0
    exact (hcd.continuousAt_iteratedFDeriv (by simp)).continuousWithinAt
  obtain ⟨B, hB⟩ := hK.exists_bound_of_continuousOn hcont
  refine ⟨max B 0, le_max_right _ _, ?_⟩
  intro x hlow hupp
  exact (hB x ⟨hlow, hupp⟩).trans (le_max_left _ _)

/-- A compact normalized annulus controls every fixed radial derivative on
all positive dilates.  Equivalently, the `n`-th derivative of the norm has
size `O(scale^(1 - n))` when the frequency has size comparable to `scale`. -/
theorem exists_scaled_norm_iteratedFDeriv_bound
    (d n : Nat) (hn : 1 ≤ n) :
    ∃ A : Real, 0 ≤ A ∧ ∀ (scale : Real) (ξ : Euclidean d),
      0 < scale → scale / 2 ≤ ‖ξ‖ → ‖ξ‖ ≤ 2 * scale →
        scale ^ (n - 1) * ‖iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) ξ‖ ≤ A := by
  obtain ⟨A, hA0, hA⟩ := exists_norm_iteratedFDeriv_norm_bound_on_unitAnnulus d n
  refine ⟨A, hA0, ?_⟩
  intro scale ξ hscale hlow hupp
  let η : Euclidean d := scale⁻¹ • ξ
  have hηnorm : ‖η‖ = scale⁻¹ * ‖ξ‖ := by
    dsimp [η]
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hscale)]
  have hηlower : (1 / 2 : Real) ≤ ‖η‖ := by
    rw [hηnorm]
    calc
      (1 / 2 : Real) = scale⁻¹ * (scale / 2) := by
        field_simp [hscale.ne']
      _ ≤ scale⁻¹ * ‖ξ‖ :=
        mul_le_mul_of_nonneg_left hlow (inv_nonneg.mpr hscale.le)
  have hηupper : ‖η‖ ≤ 2 := by
    rw [hηnorm]
    calc
      scale⁻¹ * ‖ξ‖ ≤ scale⁻¹ * (2 * scale) :=
        mul_le_mul_of_nonneg_left hupp (inv_nonneg.mpr hscale.le)
      _ = 2 := by field_simp [hscale.ne']
  have hη0 : η ≠ 0 := by
    intro hη0
    rw [hη0, norm_zero] at hηlower
    norm_num at hηlower
  have hAη := hA η hηlower hηupper
  have hscaleη : scale • η = ξ := by
    dsimp [η]
    rw [smul_smul, mul_inv_cancel₀ hscale.ne', one_smul]
  have hid := iteratedFDeriv_norm_smul_pos n scale hscale η hη0
  rw [hscaleη] at hid
  have hidnorm : scale ^ n * ‖iteratedFDeriv Real n
      (fun y : Euclidean d => ‖y‖) ξ‖ =
      scale * ‖iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) η‖ := by
    have h := congrArg norm hid
    simpa [norm_smul, Real.norm_eq_abs, abs_of_pos hscale,
      abs_of_pos (pow_pos hscale _)] using h
  apply le_of_mul_le_mul_left ?_ hscale
  calc
    scale * (scale ^ (n - 1) * ‖iteratedFDeriv Real n
        (fun y : Euclidean d => ‖y‖) ξ‖) =
        scale ^ n * ‖iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) ξ‖ := by
      have hsum : (n - 1) + 1 = n := Nat.sub_add_cancel hn
      calc
        scale * (scale ^ (n - 1) * ‖iteratedFDeriv Real n
            (fun y : Euclidean d => ‖y‖) ξ‖) =
            (scale ^ (n - 1) * scale) * ‖iteratedFDeriv Real n
              (fun y : Euclidean d => ‖y‖) ξ‖ := by ring
        _ = scale ^ ((n - 1) + 1) * ‖iteratedFDeriv Real n
              (fun y : Euclidean d => ‖y‖) ξ‖ := by rw [pow_succ]
        _ = scale ^ n * ‖iteratedFDeriv Real n
              (fun y : Euclidean d => ‖y‖) ξ‖ := by rw [hsum]
    _ = scale * ‖iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) η‖ := hidnorm
    _ ≤ scale * A := mul_le_mul_of_nonneg_left hAη hscale.le

private theorem iteratedFDeriv_innerSL_two
    {d : Nat} (direction x : Euclidean d) :
    iteratedFDeriv Real 2 (innerSL Real direction : Euclidean d → Real) x = 0 := by
  have hfd : fderiv Real (innerSL Real direction : Euclidean d → Real) =
      fun _ : Euclidean d => innerSL Real direction := by
    funext y
    exact ContinuousLinearMap.fderiv _
  ext m
  rw [iteratedFDeriv_two_apply]
  rw [hfd]
  simp

private theorem iteratedFDeriv_innerSL_eq_zero_of_two_le
    {d : Nat} (direction : Euclidean d) {n : Nat} (hn : 2 ≤ n) :
    ∀ x : Euclidean d,
      iteratedFDeriv Real n (innerSL Real direction : Euclidean d → Real) x = 0 := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hn
  induction k with
  | zero =>
      intro x
      simpa using iteratedFDeriv_innerSL_two direction x
  | succ k ih =>
      intro x
      have hzero : iteratedFDeriv Real (2 + k)
          (innerSL Real direction : Euclidean d → Real) = 0 := by
        funext y
        exact ih (by omega) y
      have hindex : 2 + (k + 1) = (2 + k) + 1 := by omega
      rw [hindex, iteratedFDeriv_succ_eq_comp_left, hzero, fderiv_zero]
      exact (continuousMultilinearCurryLeftEquiv Real
        (fun _ : Fin ((2 + k) + 1) => Euclidean d) Real).symm.map_zero

/-- In derivative orders at least two, the translated plus-sheet ray phase
has exactly the same frequency derivatives as the radial norm: the ray term
is linear and therefore disappears. -/
theorem iteratedFDeriv_angularDyadicRayPhaseMismatch_plus_eq_norm_of_two_le
    {n : Nat} (hn : 2 ≤ n) (direction ξ : Euclidean 2) (hξ : ξ ≠ 0) :
    iteratedFDeriv Real n
        (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ =
      iteratedFDeriv Real n (fun η : Euclidean 2 => ‖η‖) ξ := by
  unfold angularDyadicRayPhaseMismatch
  simp only [WaveSign.toReal, one_mul]
  change iteratedFDeriv Real n
      ((fun η : Euclidean 2 => ‖η‖) - (innerSL Real direction : Euclidean 2 → Real)) ξ = _
  rw [iteratedFDeriv_sub_apply
    (contDiffAt_norm (n := (n : WithTop ℕ∞)) Real hξ)
    ((innerSL Real direction).contDiff.contDiffAt)]
  rw [iteratedFDeriv_innerSL_eq_zero_of_two_le direction hn ξ, sub_zero]

private theorem norm_bounds_of_mem_scaledRayBall
    {scale radius : Real} {direction ξ : Euclidean 2}
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * radius ≤ scale)
    (hξ : ξ ∈ Metric.closedBall (scale • direction) radius) :
    scale / 2 ≤ ‖ξ‖ ∧ ‖ξ‖ ≤ 2 * scale := by
  rw [Metric.mem_closedBall, dist_eq_norm] at hξ
  have hcenter : ‖scale • direction‖ = scale := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hscale, hunit, mul_one]
  constructor
  · have hreverse := norm_sub_norm_le (scale • direction) ξ
    rw [hcenter] at hreverse
    have hdist : ‖scale • direction - ξ‖ ≤ radius := by
      simpa only [norm_sub_rev] using hξ
    linarith
  · have hforward := norm_le_norm_add_norm_sub (scale • direction) ξ
    rw [hcenter] at hforward
    have hdist : ‖scale • direction - ξ‖ ≤ radius := by
      simpa only [norm_sub_rev] using hξ
    linarith

private theorem exists_scaledRayBall_plusMismatch_higherDerivativeBound
    (n : Nat) (hn : 2 ≤ n) :
    ∃ A : Real, 0 ≤ A ∧ ∀ (scale radius : Real) (direction ξ : Euclidean 2),
      0 < scale → ‖direction‖ = 1 → 2 * radius ≤ scale →
      ξ ∈ Metric.closedBall (scale • direction) radius →
        scale ^ (n - 1) * ‖iteratedFDeriv Real n
          (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ‖ ≤ A := by
  obtain ⟨A, hA0, hA⟩ := exists_scaled_norm_iteratedFDeriv_bound 2 n (by omega)
  refine ⟨A, hA0, ?_⟩
  intro scale radius direction ξ hscale hunit hsmall hξ
  have hrange := norm_bounds_of_mem_scaledRayBall hscale hunit hsmall hξ
  have hξ0 : ξ ≠ 0 := by
    intro hξ0
    subst ξ
    simp only [norm_zero] at hrange
    linarith
  rw [iteratedFDeriv_angularDyadicRayPhaseMismatch_plus_eq_norm_of_two_le
    hn direction ξ hξ0]
  exact hA scale ξ hscale hrange.1 hrange.2

/-- Every fixed higher derivative of the literal plus-sheet phase mismatch
is uniformly normalized on the support of every derivative of a matched
scaled ray-cube cutoff.  The constant depends only on the order; this is the
finite-order radial calculus input for higher-decay ray localization. -/
theorem exists_scaledRayCubeCutoff_plusMismatch_higherDerivativeBound
    (n : Nat) (hn : 2 ≤ n) :
    ∃ A : Real, 0 ≤ A ∧ ∀
      (prototype : SchwartzMap (Euclidean 2) Complex) (scale width : Real)
      (direction : Euclidean 2) (hradius : 0 < width * Real.sqrt scale),
      Function.support (prototype : Euclidean 2 → Complex) ⊆ Metric.closedBall 0 1 →
      0 < scale → ‖direction‖ = 1 → 2 * (width * Real.sqrt scale) ≤ scale →
      ∀ (k : Nat) {ξ : Euclidean 2}, ξ ∈ Function.support (iteratedFDeriv Real k
        (scaledRayCubeCutoff prototype scale width direction hradius :
          Euclidean 2 → Complex)) →
        scale ^ (n - 1) * ‖iteratedFDeriv Real n
          (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ‖ ≤ A := by
  obtain ⟨A, hA0, hA⟩ := exists_scaledRayBall_plusMismatch_higherDerivativeBound n hn
  refine ⟨A, hA0, ?_⟩
  intro prototype scale width direction hradius hprototype hscale hunit hsmall k ξ hξ
  have hball := support_iteratedFDeriv_scaledRayCubeCutoff_subset_closedBall
    prototype scale width direction hradius hprototype k hξ
  exact hA scale (width * Real.sqrt scale) direction ξ hscale hunit hsmall hball

private theorem fderiv_norm_eq_inv_smul_innerSL
    (ξ : Euclidean 2) (hξ : ξ ≠ 0) :
    fderiv Real (fun η : Euclidean 2 => ‖η‖) ξ =
      (‖ξ‖)⁻¹ • innerSL Real ξ := by
  have hdiff : DifferentiableAt Real (fun η : Euclidean 2 => ‖η‖) ξ :=
    (contDiffAt_norm Real hξ).differentiableAt one_ne_zero
  have hder := hdiff.hasFDerivAt.norm_sq.fderiv
  have hfun : (fun η : Euclidean 2 => ‖(‖η‖ : Real)‖ ^ 2) =
      fun η : Euclidean 2 => ‖η‖ ^ 2 := by
    funext η
    rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg η)]
  rw [hfun, fderiv_norm_sq_apply] at hder
  have hcomp : (innerSL Real (‖ξ‖)).comp
      (fderiv Real (fun η : Euclidean 2 => ‖η‖) ξ) =
      ‖ξ‖ • fderiv Real (fun η : Euclidean 2 => ‖η‖) ξ := by
    ext v
    simp [ContinuousLinearMap.comp_apply, innerSL_apply_apply]
    ring
  rw [hcomp] at hder
  have hmul : ‖ξ‖ • fderiv Real (fun η : Euclidean 2 => ‖η‖) ξ =
      innerSL Real ξ := by
    ext v
    have hv := congrArg (fun L : Euclidean 2 →L[Real] Real => L v) hder
    simp at hv
    simpa using hv.symm
  have hnorm : ‖ξ‖ ≠ 0 := norm_ne_zero_iff.mpr hξ
  calc
    fderiv Real (fun η : Euclidean 2 => ‖η‖) ξ =
        (1 : Real) • fderiv Real (fun η : Euclidean 2 => ‖η‖) ξ := by simp
    _ = ((‖ξ‖)⁻¹ * ‖ξ‖) • fderiv Real (fun η : Euclidean 2 => ‖η‖) ξ := by
      rw [inv_mul_cancel₀ hnorm]
    _ = (‖ξ‖)⁻¹ • (‖ξ‖ • fderiv Real (fun η : Euclidean 2 => ‖η‖) ξ) := by
      rw [smul_smul]
    _ = (‖ξ‖)⁻¹ • innerSL Real ξ := by rw [hmul]

/-- Away from the origin, the first frequency derivative of the literal
ray phase is its radial gradient minus the ray direction. -/
theorem fderiv_angularDyadicRayPhaseMismatch
    (σ : WaveSign) (direction ξ : Euclidean 2) (hξ : ξ ≠ 0) :
    fderiv Real (angularDyadicRayPhaseMismatch σ direction) ξ =
      σ.toReal • ((‖ξ‖)⁻¹ • innerSL Real ξ) - innerSL Real direction := by
  unfold angularDyadicRayPhaseMismatch
  change fderiv Real
      ((σ.toReal) • (fun η : Euclidean 2 => ‖η‖) -
        (innerSL Real direction : Euclidean 2 → Real)) ξ = _
  have hnorm : DifferentiableAt Real (fun η : Euclidean 2 => ‖η‖) ξ :=
    (contDiffAt_norm Real hξ).differentiableAt one_ne_zero
  have hlinear : DifferentiableAt Real (innerSL Real direction) ξ :=
    (innerSL Real direction).differentiableAt
  rw [fderiv_sub (hnorm.const_smul σ.toReal) hlinear]
  rw [fderiv_const_smul hnorm σ.toReal]
  rw [fderiv_norm_eq_inv_smul_innerSL ξ hξ]
  change σ.toReal • ((‖ξ‖)⁻¹ • innerSL Real ξ) -
      fderiv Real (innerSL Real direction) ξ = _
  rw [ContinuousLinearMap.fderiv]

private theorem norm_ge_half_scale_of_mem_scaledRayBall
    {scale radius : Real} {direction ξ : Euclidean 2}
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * radius ≤ scale)
    (hξ : ξ ∈ Metric.closedBall (scale • direction) radius) :
    scale / 2 ≤ ‖ξ‖ := by
  rw [Metric.mem_closedBall, dist_eq_norm] at hξ
  have hcenter : ‖scale • direction‖ = scale := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hscale, hunit, mul_one]
  have hreverse := norm_sub_norm_le (scale • direction) ξ
  have hdist : ‖scale • direction - ξ‖ ≤ radius := by
    simpa only [norm_sub_rev] using hξ
  rw [hcenter] at hreverse
  linarith

private theorem fderiv_angularDyadicRayPhaseMismatch_plus_eq_innerSL_sub
    (direction ξ : Euclidean 2) (hξ : ξ ≠ 0) :
    fderiv Real (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ =
      innerSL Real ((‖ξ‖)⁻¹ • ξ - direction) := by
  rw [fderiv_angularDyadicRayPhaseMismatch WaveSign.plus direction ξ hξ]
  simp only [WaveSign.toReal, one_smul]
  ext v
  simp

private theorem norm_fderiv_angularDyadicRayPhaseMismatch_plus_eq
    (direction ξ : Euclidean 2) (hξ : ξ ≠ 0) :
    ‖fderiv Real (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ‖ =
      ‖(‖ξ‖)⁻¹ • ξ - direction‖ := by
  rw [fderiv_angularDyadicRayPhaseMismatch_plus_eq_innerSL_sub direction ξ hξ]
  exact innerSL_apply_norm (𝕜 := Real) _

private theorem normalized_sub_le_four_mul_radius_div_scale
    {scale radius : Real} {direction ξ : Euclidean 2}
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * radius ≤ scale)
    (hξ : ξ ∈ Metric.closedBall (scale • direction) radius) :
    ‖(‖ξ‖)⁻¹ • ξ - direction‖ ≤ 4 * radius / scale := by
  rw [Metric.mem_closedBall, dist_eq_norm] at hξ
  have hlower : scale / 2 ≤ ‖ξ‖ :=
    norm_ge_half_scale_of_mem_scaledRayBall hscale hunit hsmall
      (by simpa [Metric.mem_closedBall, dist_eq_norm] using hξ)
  have hnormpos : 0 < ‖ξ‖ := by linarith
  have hnormne : ‖ξ‖ ≠ 0 := hnormpos.ne'
  have hcenter : ‖scale • direction‖ = scale := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hscale, hunit, mul_one]
  have hnormdiff : |scale - ‖ξ‖| ≤ radius := by
    have h := abs_norm_sub_norm_le ξ (scale • direction)
    rw [hcenter] at h
    have h' : |scale - ‖ξ‖| ≤ ‖ξ - scale • direction‖ := by
      simpa [abs_sub_comm, norm_sub_rev] using h
    exact h'.trans hξ
  have hradius : 0 ≤ radius := (abs_nonneg (scale - ‖ξ‖)).trans hnormdiff
  have hinsidenorm : ‖ξ - ‖ξ‖ • direction‖ ≤ 2 * radius := by
    calc
      ‖ξ - ‖ξ‖ • direction‖ =
          ‖(ξ - scale • direction) + (scale - ‖ξ‖) • direction‖ := by
        congr 1
        module
      _ ≤ ‖ξ - scale • direction‖ + ‖(scale - ‖ξ‖) • direction‖ := norm_add_le _ _
      _ = ‖ξ - scale • direction‖ + |scale - ‖ξ‖| * ‖direction‖ := by
        rw [norm_smul, Real.norm_eq_abs]
      _ = ‖ξ - scale • direction‖ + |scale - ‖ξ‖| * 1 := by rw [hunit]
      _ = ‖ξ - scale • direction‖ + |scale - ‖ξ‖| := by ring
      _ ≤ radius + radius := add_le_add hξ hnormdiff
      _ = radius + radius * 1 := by ring
      _ = 2 * radius := by ring
  have hnormal : (‖ξ‖)⁻¹ ≤ 2 / scale := by
    have hhalfpos : 0 < scale / 2 := by linarith
    have hinv : (‖ξ‖)⁻¹ ≤ (scale / 2)⁻¹ :=
      (inv_le_inv₀ hnormpos hhalfpos).2 hlower
    calc
      (‖ξ‖)⁻¹ ≤ (scale / 2)⁻¹ := hinv
      _ = 2 / scale := by field_simp [hscale.ne']
  have hrewrite : (‖ξ‖)⁻¹ • ξ - direction =
      (‖ξ‖)⁻¹ • (ξ - ‖ξ‖ • direction) := by
    rw [smul_sub, smul_smul, inv_mul_cancel₀ hnormne, one_smul]
  calc
    ‖(‖ξ‖)⁻¹ • ξ - direction‖ =
        (‖ξ‖)⁻¹ * ‖ξ - ‖ξ‖ • direction‖ := by
      rw [hrewrite, norm_smul, Real.norm_eq_abs,
        abs_of_pos (inv_pos.mpr hnormpos)]
    _ ≤ (‖ξ‖)⁻¹ * (2 * radius) :=
      mul_le_mul_of_nonneg_left hinsidenorm (inv_nonneg.mpr hnormpos.le)
    _ ≤ (2 / scale) * (2 * radius) :=
      mul_le_mul_of_nonneg_right hnormal (mul_nonneg (by norm_num) hradius)
    _ = 4 * radius / scale := by ring

private theorem abs_angularDyadicRayPhaseMismatch_plus_le_two_mul_radius
    {scale radius : Real} {direction ξ : Euclidean 2}
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hξ : ξ ∈ Metric.closedBall (scale • direction) radius) :
    |angularDyadicRayPhaseMismatch WaveSign.plus direction ξ| ≤ 2 * radius := by
  rw [Metric.mem_closedBall, dist_eq_norm] at hξ
  have hcenter : ‖scale • direction‖ = scale := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hscale, hunit, mul_one]
  have hnormdiff : |‖ξ‖ - scale| ≤ radius := by
    have h := abs_norm_sub_norm_le ξ (scale • direction)
    rw [hcenter] at h
    exact h.trans hξ
  have hinnerdiff : |inner Real direction (scale • direction - ξ)| ≤ radius := by
    calc
      |inner Real direction (scale • direction - ξ)| ≤
          ‖direction‖ * ‖scale • direction - ξ‖ := abs_real_inner_le_norm _ _
      _ = ‖scale • direction - ξ‖ := by rw [hunit, one_mul]
      _ ≤ radius := by simpa only [norm_sub_rev] using hξ
  unfold angularDyadicRayPhaseMismatch
  simp only [WaveSign.toReal, one_mul]
  calc
    |‖ξ‖ - inner Real direction ξ| =
        |(‖ξ‖ - scale) + inner Real direction (scale • direction - ξ)| := by
      congr 1
      rw [inner_sub_right, inner_smul_right, real_inner_self_eq_norm_sq, hunit]
      ring
    _ ≤ |‖ξ‖ - scale| + |inner Real direction (scale • direction - ξ)| := abs_add_le _ _
    _ ≤ radius + radius := add_le_add hnormdiff hinnerdiff
    _ = 2 * radius := by ring

/-- On the support of every derivative of a concrete scaled ray-cube cutoff,
the literal plus-sheet phase mismatch has explicit zeroth- and first-order
frequency derivative bounds.  The smallness condition makes the cutoff ball
stay away from the frequency origin; the estimate is phase-specific and does
not assert a corresponding minus-sheet statement for the current shared
frequency/ray-direction parameterization. -/
theorem norm_iteratedFDeriv_angularDyRayPhaseMismatch_plus_zero_one_on_scRayCubeCutoff
    (prototype : SchwartzMap (Euclidean 2) Complex) (scale width : Real)
    (direction : Euclidean 2) (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (n : Nat) {ξ : Euclidean 2}
    (hξ : ξ ∈ Function.support (iteratedFDeriv Real n
      (scaledRayCubeCutoff prototype scale width direction hradius :
        Euclidean 2 → Complex))) :
    ‖iteratedFDeriv Real 0
        (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ‖ ≤
      2 * (width * Real.sqrt scale) ∧
    ‖iteratedFDeriv Real 1
        (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ‖ ≤
      4 * (width * Real.sqrt scale) / scale := by
  have hball := support_iteratedFDeriv_scaledRayCubeCutoff_subset_closedBall
    prototype scale width direction hradius hprototype n hξ
  have hzero : ξ ≠ 0 := by
    have hlower := norm_ge_half_scale_of_mem_scaledRayBall hscale hunit hsmall hball
    intro hzero
    subst ξ
    simp only [norm_zero] at hlower
    linarith
  constructor
  · rw [norm_iteratedFDeriv_zero]
    exact abs_angularDyadicRayPhaseMismatch_plus_le_two_mul_radius hscale hunit hball
  · rw [norm_iteratedFDeriv_one]
    rw [norm_fderiv_angularDyadicRayPhaseMismatch_plus_eq direction ξ hzero]
    exact normalized_sub_le_four_mul_radius_div_scale
      hscale hunit hsmall hball

/-- Compact time support turns the preceding mismatch estimate into an
explicit bound for the actual real phase argument `2π t (‖ξ‖ - ⟪direction,ξ⟫)`.
It is the literal phase-calculus input for the first-order residual-symbol
estimate; derivatives of the angular and dyadic amplitudes remain separate. -/
theorem norm_iterFDeriv_time_angDyRayPhaseMismatch_plus_zero_one_on_scRayCubeCutoff
    (prototype : SchwartzMap (Euclidean 2) Complex) (scale width : Real)
    (direction : Euclidean 2) (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (T t : Real) (hT : 0 ≤ T) (ht : |t| ≤ T)
    (n : Nat) {ξ : Euclidean 2}
    (hξ : ξ ∈ Function.support (iteratedFDeriv Real n
      (scaledRayCubeCutoff prototype scale width direction hradius :
        Euclidean 2 → Complex))) :
    ‖iteratedFDeriv Real 0
        (fun η : Euclidean 2 => (2 * Real.pi * t) •
          angularDyadicRayPhaseMismatch WaveSign.plus direction η) ξ‖ ≤
      4 * Real.pi * T * (width * Real.sqrt scale) ∧
    ‖iteratedFDeriv Real 1
        (fun η : Euclidean 2 => (2 * Real.pi * t) •
          angularDyadicRayPhaseMismatch WaveSign.plus direction η) ξ‖ ≤
      8 * Real.pi * T * (width * Real.sqrt scale) / scale := by
  have hphase := norm_iteratedFDeriv_angularDyRayPhaseMismatch_plus_zero_one_on_scRayCubeCutoff
    prototype scale width direction hradius hprototype hscale hunit hsmall n hξ
  have hphase0 : ‖angularDyadicRayPhaseMismatch WaveSign.plus direction ξ‖ ≤
      2 * (width * Real.sqrt scale) := by
    simpa only [norm_iteratedFDeriv_zero] using hphase.1
  have hball := support_iteratedFDeriv_scaledRayCubeCutoff_subset_closedBall
    prototype scale width direction hradius hprototype n hξ
  have hzero : ξ ≠ 0 := by
    have hlower := norm_ge_half_scale_of_mem_scaledRayBall hscale hunit hsmall hball
    intro hzero
    subst ξ
    simp only [norm_zero] at hlower
    linarith
  have htime : |2 * Real.pi * t| ≤ 2 * Real.pi * T := by
    rw [abs_mul, abs_mul, abs_of_nonneg (by positivity : 0 ≤ (2 : Real)),
      abs_of_nonneg Real.pi_pos.le]
    exact mul_le_mul_of_nonneg_left ht (by positivity)
  have hphaseDiff : DifferentiableAt Real
      (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ := by
    unfold angularDyadicRayPhaseMismatch
    change DifferentiableAt Real
      ((WaveSign.plus.toReal) • (fun η : Euclidean 2 => ‖η‖) -
        (innerSL Real direction : Euclidean 2 → Real)) ξ
    exact (((contDiffAt_norm Real hzero).differentiableAt one_ne_zero).const_smul _).sub
      ((innerSL Real direction).differentiableAt)
  constructor
  · rw [norm_iteratedFDeriv_zero, norm_smul]
    calc
      |2 * Real.pi * t| * ‖angularDyadicRayPhaseMismatch WaveSign.plus direction ξ‖ ≤
          (2 * Real.pi * T) * (2 * (width * Real.sqrt scale)) :=
        mul_le_mul htime hphase0 (norm_nonneg _) (by positivity)
      _ = 4 * Real.pi * T * (width * Real.sqrt scale) := by ring
  · rw [norm_iteratedFDeriv_one]
    change ‖fderiv Real
      ((2 * Real.pi * t) • angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ‖ ≤ _
    rw [fderiv_const_smul hphaseDiff]
    rw [norm_smul]
    calc
      |2 * Real.pi * t| * ‖fderiv Real
          (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ‖ ≤
          (2 * Real.pi * T) * (4 * (width * Real.sqrt scale) / scale) :=
        mul_le_mul htime (by
          simpa only [norm_iteratedFDeriv_one] using hphase.2)
          (norm_nonneg _) (by positivity)
      _ = 8 * Real.pi * T * (width * Real.sqrt scale) / scale := by ring

/-- The residual base amplitude has exactly the phase mismatch
`σ‖ξ‖ - ⟪direction, ξ⟫`; the other factor is the literal angular/dyadic
cutoff amplitude. -/
theorem angularDyadicResidualBaseSymbol_eq_phaseMismatch
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (direction ξ : Euclidean 2) (χ : SchwartzMap (Euclidean 2) Complex) :
    angularDyadicResidualBaseSymbol C σ j t direction χ ξ =
      Complex.exp
          (((2 * Real.pi * t * angularDyadicRayPhaseMismatch σ direction ξ : Real) : Complex) *
            Complex.I) *
        (χ ξ * dyadicBandpassMultiplier C.cutoff j ξ) := by
  rw [angularDyadicResidualBaseSymbol_apply,
    dyadicHalfWaveSchwartzSymbol_apply, dyadicHalfWaveSymbol]
  simp only [Real.fourierChar_apply]
  rw [halfWaveMultiplier]
  rw [show
    Complex.exp (((2 * Real.pi * inner Real (-(t • direction)) ξ : Real) : Complex) *
        Complex.I) *
        (χ ξ *
          (Complex.exp (((σ.toReal * (2 * Real.pi) * t * ‖ξ‖ : Real) : Complex) *
            Complex.I) * dyadicBandpassMultiplier C.cutoff j ξ)) =
      (Complex.exp (((2 * Real.pi * inner Real (-(t • direction)) ξ : Real) : Complex) *
          Complex.I) *
        Complex.exp (((σ.toReal * (2 * Real.pi) * t * ‖ξ‖ : Real) : Complex) *
          Complex.I)) *
        (χ ξ * dyadicBandpassMultiplier C.cutoff j ξ) by ring]
  rw [← Complex.exp_add]
  congr 1
  simp [angularDyadicRayPhaseMismatch, inner_neg_left, inner_smul_left]
  ring_nf

/-- The literal angular--dyadic amplitude remaining after the ray phase is
removed.  It is a genuine Schwartz multiplier, so its seminorms provide
concrete finite-order amplitude constants. -/
noncomputable def angularDyadicResidualAmplitude
    (C : lpCutoffs 2) (j : Nat) (χ : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex (χ : Euclidean 2 → Complex)
    (dyadicBandpassMultiplier C.cutoff j)

/-- Pointwise form of the literal angular--dyadic residual amplitude. -/
theorem angularDyadicResidualAmplitude_apply
    (C : lpCutoffs 2) (j : Nat) (χ : SchwartzMap (Euclidean 2) Complex)
    (ξ : Euclidean 2) :
    angularDyadicResidualAmplitude C j χ ξ =
      χ ξ * dyadicBandpassMultiplier C.cutoff j ξ := by
  rw [angularDyadicResidualAmplitude,
    SchwartzMap.smulLeftCLM_apply_apply χ.hasTemperateGrowth]
  simp only [smul_eq_mul]

private theorem norm_angularDyadicResidualAmplitude_zero_one
    (C : lpCutoffs 2) (j : Nat) (χ : SchwartzMap (Euclidean 2) Complex)
    (ξ : Euclidean 2) :
    ‖angularDyadicResidualAmplitude C j χ ξ‖ ≤
      SchwartzMap.seminorm Real 0 0 (angularDyadicResidualAmplitude C j χ) ∧
    ‖fderiv Real (angularDyadicResidualAmplitude C j χ :
        Euclidean 2 → Complex) ξ‖ ≤
      SchwartzMap.seminorm Real 0 1 (angularDyadicResidualAmplitude C j χ) := by
  constructor
  · simpa using SchwartzMap.le_seminorm Real 0 0
      (angularDyadicResidualAmplitude C j χ) ξ
  · rw [← norm_iteratedFDeriv_one]
    simpa using SchwartzMap.le_seminorm Real 0 1
      (angularDyadicResidualAmplitude C j χ) ξ

private theorem norm_fderiv_exp_ofReal_mul_I_le
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    (g : E → Real) (x : E) (hg : DifferentiableAt Real g x) :
    ‖fderiv Real (fun y => Complex.exp (((g y : Real) : Complex) * Complex.I)) x‖ ≤
      ‖fderiv Real g x‖ := by
  let L : Real →L[Real] Complex := Complex.ofRealCLM.smulRight Complex.I
  have hL : ∀ r : Real, L r = ((r : Complex) * Complex.I) := by
    intro r
    simp [L, ContinuousLinearMap.smulRight_apply, smul_eq_mul]
  have hcomp : HasFDerivAt (fun y => L (g y))
      (L.comp (fderiv Real g x)) x := by
    exact L.hasFDerivAt.comp x hg.hasFDerivAt
  have hexp := hcomp.cexp.fderiv
  have hfun : (fun y => Complex.exp (((g y : Real) : Complex) * Complex.I)) =
      fun y => Complex.exp (L (g y)) := by
    funext y
    rw [hL]
  rw [hfun, hexp]
  apply ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg _)
  intro v
  rw [smul_apply, norm_smul, hL (g x),
    Complex.norm_exp_ofReal_mul_I]
  simp only [one_mul, ContinuousLinearMap.comp_apply]
  change ‖L (fderiv Real g x v)‖ ≤ ‖fderiv Real g x‖ * ‖v‖
  rw [hL]
  simp only [norm_mul, Complex.norm_real, Complex.norm_I, mul_one]
  exact (fderiv Real g x).le_opNorm v

private theorem angularDyadicResidualBaseSymbol_plus_eq_phaseAmplitude
    (C : lpCutoffs 2) (j : Nat) (t : Real)
    (direction ξ : Euclidean 2) (χ : SchwartzMap (Euclidean 2) Complex) :
    angularDyadicResidualBaseSymbol C WaveSign.plus j t direction χ ξ =
      Complex.exp
        (((((2 * Real.pi * t) •
          angularDyadicRayPhaseMismatch WaveSign.plus direction ξ : Real) : Complex) *
          Complex.I)) * angularDyadicResidualAmplitude C j χ ξ := by
  rw [angularDyadicResidualBaseSymbol_eq_phaseMismatch,
    angularDyadicResidualAmplitude_apply]
  congr 1

private theorem norm_fderiv_angularDyadicResidualBaseSymbol_plus
    (C : lpCutoffs 2) (j : Nat) (T t scale width : Real)
    (direction : Euclidean 2) (χ prototype : SchwartzMap (Euclidean 2) Complex)
    (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (hT : 0 ≤ T) (ht : |t| ≤ T)
    (n : Nat) {ξ : Euclidean 2}
    (hξ : ξ ∈ Function.support (iteratedFDeriv Real n
      (scaledRayCubeCutoff prototype scale width direction hradius :
        Euclidean 2 → Complex))) :
    ‖fderiv Real (angularDyadicResidualBaseSymbol C WaveSign.plus j t direction χ :
      Euclidean 2 → Complex) ξ‖ ≤
      SchwartzMap.seminorm Real 0 1 (angularDyadicResidualAmplitude C j χ) +
        (8 * Real.pi * T * (width * Real.sqrt scale) / scale) *
          SchwartzMap.seminorm Real 0 0 (angularDyadicResidualAmplitude C j χ) := by
  let g : Euclidean 2 → Real :=
    (2 * Real.pi * t) • angularDyadicRayPhaseMismatch WaveSign.plus direction
  let phase : Euclidean 2 → Complex := fun η =>
    Complex.exp (((g η : Real) : Complex) * Complex.I)
  let amp : SchwartzMap (Euclidean 2) Complex := angularDyadicResidualAmplitude C j χ
  have hball := support_iteratedFDeriv_scaledRayCubeCutoff_subset_closedBall
    prototype scale width direction hradius hprototype n hξ
  have hzero : ξ ≠ 0 := by
    have hlower := norm_ge_half_scale_of_mem_scaledRayBall hscale hunit hsmall hball
    intro hzero
    subst ξ
    simp only [norm_zero] at hlower
    linarith
  have hmisdiff : DifferentiableAt Real
      (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ := by
    unfold angularDyadicRayPhaseMismatch
    change DifferentiableAt Real
      ((WaveSign.plus.toReal) • (fun η : Euclidean 2 => ‖η‖) -
        (innerSL Real direction : Euclidean 2 → Real)) ξ
    exact (((contDiffAt_norm Real hzero).differentiableAt one_ne_zero).const_smul _).sub
      ((innerSL Real direction).differentiableAt)
  have hg : DifferentiableAt Real g ξ := by
    simpa only [g] using hmisdiff.const_smul (2 * Real.pi * t)
  let L : Real →L[Real] Complex := Complex.ofRealCLM.smulRight Complex.I
  have hphaseDiff : DifferentiableAt Real phase ξ := by
    change DifferentiableAt Real (fun η => Complex.exp (L (g η))) ξ
    exact (L.differentiableAt.comp ξ hg).cexp
  have hampDiff : DifferentiableAt Real (amp : Euclidean 2 → Complex) ξ :=
    amp.differentiableAt
  have hphaseDeriv := norm_fderiv_exp_ofReal_mul_I_le g ξ hg
  have htime :=
    norm_iterFDeriv_time_angDyRayPhaseMismatch_plus_zero_one_on_scRayCubeCutoff
      prototype scale width direction hradius hprototype hscale hunit hsmall T t hT ht n hξ
  have hgDeriv : ‖fderiv Real g ξ‖ ≤
      8 * Real.pi * T * (width * Real.sqrt scale) / scale := by
    rw [← norm_iteratedFDeriv_one]
    exact htime.2
  have hphaseDeriv' : ‖fderiv Real phase ξ‖ ≤
      8 * Real.pi * T * (width * Real.sqrt scale) / scale := by
    exact hphaseDeriv.trans hgDeriv
  have hamp := norm_angularDyadicResidualAmplitude_zero_one C j χ ξ
  have hbase : (angularDyadicResidualBaseSymbol C WaveSign.plus j t direction χ :
      Euclidean 2 → Complex) = fun η => phase η * amp η := by
    funext η
    rw [angularDyadicResidualBaseSymbol_plus_eq_phaseAmplitude]
    rfl
  rw [hbase]
  change ‖fderiv Real (phase * (amp : Euclidean 2 → Complex)) ξ‖ ≤ _
  rw [fderiv_mul hphaseDiff hampDiff]
  calc
    ‖phase ξ • fderiv Real (amp : Euclidean 2 → Complex) ξ +
        amp ξ • fderiv Real phase ξ‖ ≤
      ‖phase ξ • fderiv Real (amp : Euclidean 2 → Complex) ξ‖ +
        ‖amp ξ • fderiv Real phase ξ‖ := norm_add_le _ _
    _ = ‖phase ξ‖ * ‖fderiv Real (amp : Euclidean 2 → Complex) ξ‖ +
        ‖amp ξ‖ * ‖fderiv Real phase ξ‖ := by rw [norm_smul, norm_smul]
    _ ≤ 1 * SchwartzMap.seminorm Real 0 1 amp +
        SchwartzMap.seminorm Real 0 0 amp *
          (8 * Real.pi * T * (width * Real.sqrt scale) / scale) := by
      apply add_le_add
      · apply mul_le_mul
        · change ‖Complex.exp (((g ξ : Real) : Complex) * Complex.I)‖ ≤ 1
          rw [Complex.norm_exp_ofReal_mul_I]
        · exact hamp.2
        · positivity
        · norm_num
      · apply mul_le_mul
        · exact hamp.1
        · exact hphaseDeriv'
        · positivity
        · positivity
    _ = SchwartzMap.seminorm Real 0 1 (angularDyadicResidualAmplitude C j χ) +
        (8 * Real.pi * T * (width * Real.sqrt scale) / scale) *
          SchwartzMap.seminorm Real 0 0 (angularDyadicResidualAmplitude C j χ) := by
      change _ = SchwartzMap.seminorm Real 0 1 amp + _
      ring

/-- On every derivative support of a matched plus-sheet scaled ray cutoff,
the actual residual base symbol has literal zeroth- and first-order bounds.
The constants are the seminorms of the actual angular--dyadic amplitude and
the compact-time phase-mismatch contribution. -/
theorem norm_iteratedFDeriv_angDyResidualBaseSymbol_plus_zero_one_on_scRayCubeCutoff
    (C : lpCutoffs 2) (j : Nat) (T t scale width : Real)
    (direction : Euclidean 2) (χ prototype : SchwartzMap (Euclidean 2) Complex)
    (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (hT : 0 ≤ T) (ht : |t| ≤ T)
    (n : Nat) {ξ : Euclidean 2}
    (hξ : ξ ∈ Function.support (iteratedFDeriv Real n
      (scaledRayCubeCutoff prototype scale width direction hradius :
        Euclidean 2 → Complex))) :
    ‖iteratedFDeriv Real 0
        (angularDyadicResidualBaseSymbol C WaveSign.plus j t direction χ :
          Euclidean 2 → Complex) ξ‖ ≤
      SchwartzMap.seminorm Real 0 0 (angularDyadicResidualAmplitude C j χ) ∧
    ‖iteratedFDeriv Real 1
        (angularDyadicResidualBaseSymbol C WaveSign.plus j t direction χ :
          Euclidean 2 → Complex) ξ‖ ≤
      SchwartzMap.seminorm Real 0 1 (angularDyadicResidualAmplitude C j χ) +
        (8 * Real.pi * T * (width * Real.sqrt scale) / scale) *
          SchwartzMap.seminorm Real 0 0 (angularDyadicResidualAmplitude C j χ) := by
  constructor
  · rw [norm_iteratedFDeriv_zero,
      angularDyadicResidualBaseSymbol_plus_eq_phaseAmplitude,
      norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
    exact (norm_angularDyadicResidualAmplitude_zero_one C j χ ξ).1
  · rw [norm_iteratedFDeriv_one]
    exact norm_fderiv_angularDyadicResidualBaseSymbol_plus
      C j T t scale width direction χ prototype hradius hprototype hscale hunit hsmall
      hT ht n hξ

/-- Exact translation from the literal spatial kernel to its ray-residual
kernel.  This is the physical-coordinate input for a genuine tube-decay
estimate, with no modeled replacement kernel. -/
theorem angularDyadicCubeKernel_eq_residual_shifted
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (direction : Euclidean 2) (χ m : SchwartzMap (Euclidean 2) Complex)
    (u : Euclidean 2) :
    angularDyadicCubeKernel C σ j t χ m u =
      Auto.Spherical.Auxiliary.fourierCubeKernel
        (angularDyadicCubeResidualSymbol C σ j t direction χ m)
        (u + t • direction) := by
  simp only [angularDyadicCubeKernel,
    Auto.Spherical.Auxiliary.fourierCubeKernel]
  symm
  unfold angularDyadicCubeResidualSymbol
  rw [SchwartzMap.fourierInv_coe, SchwartzMap.fourierInv_coe]
  rw [Auto.Spherical.Auxiliary.fourierInv_planeWaveModulatedCompactSchwartz_eq_translate]
  simp only [add_neg_cancel_right]

/-- The literal finite physical kernel obtained by summing actual angular
half-wave/cube symbols. -/
noncomputable def angularDyadicCubeKernelSum {κ : Type*}
    (cubes : Finset κ) (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ : SchwartzMap (Euclidean 2) Complex)
    (m : κ → SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  𝓕⁻ (∑ cube ∈ cubes, angularDyadicCubeSchwartzSymbol C σ j t χ (m cube))

/-- Finite summation commutes with the literal angular half-wave/cube
physical kernel. -/
theorem angularDyadicCubeKernelSum_eq_sum {κ : Type*}
    (cubes : Finset κ) (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ : SchwartzMap (Euclidean 2) Complex)
    (m : κ → SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    angularDyadicCubeKernelSum cubes C σ j t χ m x =
      ∑ cube ∈ cubes, angularDyadicCubeKernel C σ j t χ (m cube) x := by
  classical
  unfold angularDyadicCubeKernelSum angularDyadicCubeKernel
  rw [fourierInv_sum]
  change (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean 2) Complex)
    (Euclidean 2) Complex)
      (∑ cube ∈ cubes, 𝓕⁻ (angularDyadicCubeSchwartzSymbol C σ j t χ (m cube))) x = _
  rw [map_sum, Finset.sum_apply]
  rfl

/-- The finite space-time packet kernel associated to a family of actual
angular dyadic cube multipliers. -/
noncomputable def angularDyadicCubeSpaceTimeKernelSum {κ : Type*}
    (cubes : Finset κ) (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ : SchwartzMap (Euclidean 2) Complex)
    (m : κ → SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (z : WaveSpaceTime) (y : Euclidean 2) : Complex :=
  ϑ z.2 * angularDyadicCubeKernelSum cubes C σ j z.2 χ m (z.1 - y)

/-- Finite packet summation commutes exactly with the literal space-time
source kernel. -/
theorem angularDyadicCubeSpaceTimeKernelSum_eq_sum {κ : Type*}
    (cubes : Finset κ) (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ : SchwartzMap (Euclidean 2) Complex)
    (m : κ → SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (z : WaveSpaceTime) (y : Euclidean 2) :
    angularDyadicCubeSpaceTimeKernelSum cubes C σ j χ m ϑ z y =
      ∑ cube ∈ cubes,
        angularDyadicCubeSpaceTimeKernel C σ j χ (m cube) ϑ z y := by
  unfold angularDyadicCubeSpaceTimeKernelSum angularDyadicCubeSpaceTimeKernel
  rw [angularDyadicCubeKernelSum_eq_sum, Finset.mul_sum]

/-- A literal cube packet kernel remains integrable after multiplication by
Schwartz data. -/
theorem integrable_angularDyadicCubeSpaceTimeKernel_mul {κ : Type*}
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ : SchwartzMap (Euclidean 2) Complex)
    (m : κ → SchwartzMap (Euclidean 2) Complex) (cube : κ)
    (ϑ : Real → Complex) (f : SchwartzMap (Euclidean 2) Complex)
    (z : WaveSpaceTime) :
    Integrable (fun y : Euclidean 2 =>
      angularDyadicCubeSpaceTimeKernel C σ j χ (m cube) ϑ z y * f y) volume := by
  apply (angularDyadicCubeSpaceTimeKernel_integrable C σ j χ (m cube) ϑ z).mul_bdd
  · exact f.continuous.aestronglyMeasurable
  · filter_upwards with y
    exact SchwartzMap.norm_le_seminorm Complex f y

/-- The actual finite packet sum obtained by integrating the summed source
kernel against Schwartz data. -/
noncomputable def angularDyadicCubePacket {κ : Type*}
    (cubes : Finset κ) (C : lpCutoffs 2) (j : Nat)
    (χ : SchwartzMap (Euclidean 2) Complex)
    (m : κ → SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (z : WaveSpaceTime) : Complex :=
  ∫ y : Euclidean 2,
    angularDyadicCubeSpaceTimeKernelSum cubes C WaveSign.plus j χ m ϑ z y * f y

private theorem angularDyadicCubePacket_eq_sum_of_integrable {κ : Type*}
    (cubes : Finset κ) (C : lpCutoffs 2) (j : Nat)
    (χ : SchwartzMap (Euclidean 2) Complex)
    (m : κ → SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (z : WaveSpaceTime)
    (hint : ∀ cube ∈ cubes, Integrable (fun y : Euclidean 2 =>
      angularDyadicCubeSpaceTimeKernel C WaveSign.plus j χ (m cube) ϑ z y * f y) volume) :
    angularDyadicCubePacket cubes C j χ m ϑ f z =
      ∑ cube ∈ cubes,
        angularPiece ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0)
          (χ : Euclidean 2 → Complex) ϑ (fourierCubeProjection (m cube) f) z := by
  unfold angularDyadicCubePacket
  simp_rw [angularDyadicCubeSpaceTimeKernelSum_eq_sum]
  have hpoint : (fun y : Euclidean 2 =>
      (∑ cube ∈ cubes,
        angularDyadicCubeSpaceTimeKernel C WaveSign.plus j χ (m cube) ϑ z y) * f y) =
      fun y : Euclidean 2 => ∑ cube ∈ cubes,
        angularDyadicCubeSpaceTimeKernel C WaveSign.plus j χ (m cube) ϑ z y * f y := by
    funext y
    rw [Finset.sum_mul]
  rw [hpoint, integral_finsetSum cubes hint]
  apply Finset.sum_congr rfl
  intro cube hcube
  exact (angularPiece_dyadicCube_eq_spaceTimeKernel C j χ (m cube) f ϑ z).symm

/-- A concrete finite angular half-wave packet is exactly the sum of its
literal cube-projected angular pieces.  This is a reconstruction identity,
not a claim that the cube family covers every angular packet. -/
theorem angularDyadicCubePacket_eq_sum {κ : Type*}
    (cubes : Finset κ) (C : lpCutoffs 2) (j : Nat)
    (χ : SchwartzMap (Euclidean 2) Complex)
    (m : κ → SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (z : WaveSpaceTime) :
    angularDyadicCubePacket cubes C j χ m ϑ f z =
      ∑ cube ∈ cubes,
        angularPiece ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0)
          (χ : Euclidean 2 → Complex) ϑ (fourierCubeProjection (m cube) f) z := by
  apply angularDyadicCubePacket_eq_sum_of_integrable
  intro cube hcube
  exact integrable_angularDyadicCubeSpaceTimeKernel_mul
    C WaveSign.plus j χ m cube ϑ f z

/-- A singleton literal packet is its time cutoff times the fixed-time cube
piece.  Together with the fixed-time Fourier-support theorem above, this
records the concrete spatial-frequency content of one packet without claiming
space-time conic-plate support. -/
theorem angularDyadicCubePacket_singleton_eq_timeCutoff_mul_piece
    {κ : Type*} (cube : κ) (C : lpCutoffs 2) (j : Nat)
    (χ : SchwartzMap (Euclidean 2) Complex)
    (m : κ → SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (z : WaveSpaceTime) :
    angularDyadicCubePacket ({cube} : Finset κ) C j χ m ϑ f z =
      ϑ z.2 * angularDyadicCubePiece C WaveSign.plus j z.2 χ (m cube) f z.1 := by
  classical
  rw [angularDyadicCubePacket_eq_sum]
  simp only [Finset.sum_singleton]
  rw [angularPiece_dyadicCube_eq_spaceTimeKernel]
  unfold angularDyadicCubeSpaceTimeKernel
  rw [show (fun y : Euclidean 2 =>
      (ϑ z.2 * angularDyadicCubeKernel C WaveSign.plus j z.2 χ (m cube) (z.1 - y)) * f y) =
      fun y => ϑ z.2 *
        (angularDyadicCubeKernel C WaveSign.plus j z.2 χ (m cube) (z.1 - y) * f y) by
        funext y
        ring]
  rw [integral_const_mul]
  rw [← angularDyadicCubePiece_eq_sourceKernel]

/-- The smooth, normalized kernel used by the two-dimensional light-ray
maximal operator.  Writing the decay exponent as a natural number avoids a
separate real-power theory while retaining the arbitrary high decay used by
the proof. -/
def lightRayKernel (δ : Real) (N : Nat) (ω y : Euclidean 2)
    (z : WaveSpaceTime) : Real :=
  (δ⁻¹) ^ 2 * (1 + δ⁻¹ * ‖z.1 + z.2 • ω - y‖)⁻¹ ^ N

/-- Modulation does not enlarge the literal frequency cube of an
angular/cube packet. -/
theorem support_angularDyadicCubeResidualSymbol_subset_frequencyCube
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t scale width : Real)
    (direction : Euclidean 2) (χ m : SchwartzMap (Euclidean 2) Complex)
    (hm : isScaledRayCubeCutoff scale width direction m) :
    Function.support (angularDyadicCubeResidualSymbol C σ j t direction χ m :
      Euclidean 2 → Complex) ⊆
        frequencyCube (scale • direction) (width * Real.sqrt scale) := by
  intro ξ hξ
  have hsymbol : angularDyadicCubeSchwartzSymbol C σ j t χ m ξ ≠ 0 := by
    intro hzero
    apply hξ
    rw [angularDyadicCubeResidualSymbol_apply, hzero, mul_zero]
  exact support_angularDyadicCubeSchwartzSymbol_subset_frequencyCube C σ j t χ m
    (scale • direction) (width * Real.sqrt scale) hm hsymbol

/-- A physical Schwartz seminorm of the literal ray-residual symbol is
controlled by the finite sum of its actual frequency-side derivative `L¹`
norms.  This is the Fourier integration-by-parts reduction needed for ray
localization.  It deliberately does not claim a scale- or time-uniform bound:
the current cube interface records support but not cutoff derivative bounds,
and a uniform phase estimate also requires a bounded time support. -/
theorem angularDyadicCubeResidualSymbol_fourierInv_seminorm_le_derivativeIntegrals
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (direction : Euclidean 2) (χ m : SchwartzMap (Euclidean 2) Complex)
    (N : Nat) :
    SchwartzMap.seminorm ℂ N 0
      (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m) :
        SchwartzMap (Euclidean 2) ℂ) ≤
      (2 : Real) ^ N * ∑ n ∈ Finset.range (N + 1),
        ∫ ξ : Euclidean 2,
          ‖iteratedFDeriv Real n
            (angularDyadicCubeResidualSymbol C σ j t direction χ m :
              Euclidean 2 → Complex) ξ‖ := by
  apply SchwartzMap.seminorm_le_bound Complex N 0
    (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m) :
      SchwartzMap (Euclidean 2) ℂ)
  · exact mul_nonneg (by positivity)
      (Finset.sum_nonneg fun _ _ => integral_nonneg fun _ => norm_nonneg _)
  · intro x
    rw [norm_iteratedFDeriv_zero]
    rw [SchwartzMap.fourierInv_coe]
    change ‖x‖ ^ N * ‖𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m :
      Euclidean 2 → Complex) x‖ ≤ _
    have h := Real.pow_mul_norm_iteratedFDeriv_fourier_le
      (f := (angularDyadicCubeResidualSymbol C σ j t direction χ m :
        Euclidean 2 → Complex)) (K := 0) (N := N)
      ((angularDyadicCubeResidualSymbol C σ j t direction χ m).smooth N)
      (fun k n hk hn => by
        have hk' : k = 0 := by simpa using hk
        subst k
        simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume
          (angularDyadicCubeResidualSymbol C σ j t direction χ m) 0 n)
      (k := 0) (n := N) (by simp) (by simp) (-x)
    simpa [Real.fourierInv_eq_fourier_neg] using h

/-- Explicit residual Schwartz-seminorm bounds give literal light-ray decay
for an angular half-wave/cube kernel.  The constant `T` controls the concrete
time cutoff.  This is a theorem about the actual Fourier kernel, not a
replacement localization predicate. -/
theorem norm_angularDyadicCubeSpaceTimeKernel_le_lightRayKernel_of_residual_seminorm
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ m : SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (δ A T : Real) (N : Nat) (direction : Euclidean 2)
    (hδ : 0 < δ) (hϑ : ∀ t, ‖ϑ t‖ ≤ T)
    (hN : ∀ t, SchwartzMap.seminorm ℂ N 0
      (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m) :
        SchwartzMap (Euclidean 2) ℂ) ≤ (A * (δ⁻¹) ^ 2) * δ ^ N)
    (hzero : ∀ t, SchwartzMap.seminorm ℂ 0 0
      (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m) :
        SchwartzMap (Euclidean 2) ℂ) ≤ A * (δ⁻¹) ^ 2)
    (z : WaveSpaceTime) (y : Euclidean 2) :
    ‖angularDyadicCubeSpaceTimeKernel C σ j χ m ϑ z y‖ ≤
      (T * (2 : Real) ^ N * A) * lightRayKernel δ N direction y z := by
  have hT : 0 ≤ T := (norm_nonneg (ϑ 0)).trans (hϑ 0)
  have hdecay := Auto.Spherical.Auxiliary.norm_fourierCubeKernel_le_scaled_seminorm_decay
    (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m)
    δ (A * (δ⁻¹) ^ 2) N hδ (hzero z.2) (hN z.2)
    (z.1 + z.2 • direction - y)
  have htranslate : (z.1 - y) + z.2 • direction =
      z.1 + z.2 • direction - y := by
    module
  calc
    ‖angularDyadicCubeSpaceTimeKernel C σ j χ m ϑ z y‖ =
        ‖ϑ z.2‖ * ‖angularDyadicCubeKernel C σ j z.2 χ m (z.1 - y)‖ := by
      rw [angularDyadicCubeSpaceTimeKernel, norm_mul]
    _ = ‖ϑ z.2‖ * ‖Auto.Spherical.Auxiliary.fourierCubeKernel
          (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m)
          (z.1 + z.2 • direction - y)‖ := by
      rw [angularDyadicCubeKernel_eq_residual_shifted, htranslate]
    _ ≤ T * ‖Auto.Spherical.Auxiliary.fourierCubeKernel
          (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m)
          (z.1 + z.2 • direction - y)‖ :=
      mul_le_mul_of_nonneg_right (hϑ z.2) (norm_nonneg _)
    _ ≤ T * ((2 : Real) ^ N * (A * (δ⁻¹) ^ 2) *
          (1 + δ⁻¹ * ‖z.1 + z.2 • direction - y‖)⁻¹ ^ N) :=
      mul_le_mul_of_nonneg_left hdecay hT
    _ = (T * (2 : Real) ^ N * A) * lightRayKernel δ N direction y z := by
      unfold lightRayKernel
      ring

/-- A concrete scaled Fourier cube together with the two residual seminorm
bounds is a literal ray-localized packet: the first conclusion records its
frequency support, and the second gives its physical light-ray decay. -/
theorem angularDyadicCubePacket_ray_localized_of_residual_seminorm
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ m : SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (scale width δ A T : Real) (N : Nat) (direction : Euclidean 2)
    (hm : isScaledRayCubeCutoff scale width direction m)
    (hδ : 0 < δ) (hϑ : ∀ t, ‖ϑ t‖ ≤ T)
    (hN : ∀ t, SchwartzMap.seminorm ℂ N 0
      (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m) :
        SchwartzMap (Euclidean 2) ℂ) ≤ (A * (δ⁻¹) ^ 2) * δ ^ N)
    (hzero : ∀ t, SchwartzMap.seminorm ℂ 0 0
      (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m) :
        SchwartzMap (Euclidean 2) ℂ) ≤ A * (δ⁻¹) ^ 2) :
    (∀ t, Function.support (angularDyadicCubeResidualSymbol C σ j t direction χ m :
      Euclidean 2 → Complex) ⊆
        frequencyCube (scale • direction) (width * Real.sqrt scale)) ∧
    (∀ z y, ‖angularDyadicCubeSpaceTimeKernel C σ j χ m ϑ z y‖ ≤
      (T * (2 : Real) ^ N * A) * lightRayKernel δ N direction y z) := by
  refine ⟨?_, ?_⟩
  · intro t
    exact support_angularDyadicCubeResidualSymbol_subset_frequencyCube
      C σ j t scale width direction χ m hm
  · intro z y
    exact norm_angularDyadicCubeSpaceTimeKernel_le_lightRayKernel_of_residual_seminorm
      C σ j χ m ϑ δ A T N direction hδ hϑ hN hzero z y

/-- Explicit finite `L¹` bounds for derivatives of the actual residual
angular/cube symbol give literal frequency-cube support and light-ray decay.
The hypotheses expose the remaining analytic input rather than replacing it
with a localization predicate: to verify them uniformly one still needs
quantitative cutoff derivative bounds and a bounded time support for `ϑ`. -/
theorem angularDyadicCubePacket_ray_localized_of_residual_derivativeIntegrals
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ m : SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (scale width δ A T : Real) (N : Nat) (direction : Euclidean 2)
    (hm : isScaledRayCubeCutoff scale width direction m)
    (hδ : 0 < δ) (hϑ : ∀ t, ‖ϑ t‖ ≤ T)
    (hderivN : ∀ t, (2 : Real) ^ N *
      (∑ n ∈ Finset.range (N + 1), ∫ ξ : Euclidean 2,
        ‖iteratedFDeriv Real n
          (angularDyadicCubeResidualSymbol C σ j t direction χ m :
            Euclidean 2 → Complex) ξ‖) ≤
        (A * (δ⁻¹) ^ 2) * δ ^ N)
    (hderiv0 : ∀ t, ∫ ξ : Euclidean 2,
      ‖angularDyadicCubeResidualSymbol C σ j t direction χ m ξ‖ ≤
        A * (δ⁻¹) ^ 2) :
    (∀ t, Function.support (angularDyadicCubeResidualSymbol C σ j t direction χ m :
      Euclidean 2 → Complex) ⊆
        frequencyCube (scale • direction) (width * Real.sqrt scale)) ∧
    (∀ z y, ‖angularDyadicCubeSpaceTimeKernel C σ j χ m ϑ z y‖ ≤
      (T * (2 : Real) ^ N * A) * lightRayKernel δ N direction y z) := by
  apply angularDyadicCubePacket_ray_localized_of_residual_seminorm
    C σ j χ m ϑ scale width δ A T N direction hm hδ hϑ
  · intro t
    exact (angularDyadicCubeResidualSymbol_fourierInv_seminorm_le_derivativeIntegrals
      C σ j t direction χ m N).trans (hderivN t)
  · intro t
    calc
      SchwartzMap.seminorm ℂ 0 0
        (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m) :
          SchwartzMap (Euclidean 2) ℂ) ≤
          (2 : Real) ^ 0 * ∑ n ∈ Finset.range (0 + 1),
            ∫ ξ : Euclidean 2,
              ‖iteratedFDeriv Real n
                (angularDyadicCubeResidualSymbol C σ j t direction χ m :
                  Euclidean 2 → Complex) ξ‖ :=
        angularDyadicCubeResidualSymbol_fourierInv_seminorm_le_derivativeIntegrals
          C σ j t direction χ m 0
      _ = ∫ ξ : Euclidean 2,
          ‖angularDyadicCubeResidualSymbol C σ j t direction χ m ξ‖ := by
        simp
      _ ≤ A * (δ⁻¹) ^ 2 := hderiv0 t

/-- The natural physical width for a cube of frequency radius `sqrt scale`
is `1 / sqrt scale`.  This specializes the preceding literal localization
theorem to the MSS ray scale. -/
theorem scaledRayCube_angularDyadicCubePacket_ray_localized_of_residual_seminorm
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ m : SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (scale width A T : Real) (N : Nat) (direction : Euclidean 2)
    (hscale : 0 < scale)
    (hm : isScaledRayCubeCutoff scale width direction m)
    (hϑ : ∀ t, ‖ϑ t‖ ≤ T)
    (hN : ∀ t, SchwartzMap.seminorm ℂ N 0
      (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m) :
        SchwartzMap (Euclidean 2) ℂ) ≤
        (A * (Real.sqrt scale) ^ 2) * (Real.sqrt scale)⁻¹ ^ N)
    (hzero : ∀ t, SchwartzMap.seminorm ℂ 0 0
      (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m) :
        SchwartzMap (Euclidean 2) ℂ) ≤ A * (Real.sqrt scale) ^ 2) :
    (∀ t, Function.support (angularDyadicCubeResidualSymbol C σ j t direction χ m :
      Euclidean 2 → Complex) ⊆
        frequencyCube (scale • direction) (width * Real.sqrt scale)) ∧
    (∀ z y, ‖angularDyadicCubeSpaceTimeKernel C σ j χ m ϑ z y‖ ≤
      (T * (2 : Real) ^ N * A) *
        lightRayKernel (Real.sqrt scale)⁻¹ N direction y z) := by
  have hδ : 0 < (Real.sqrt scale)⁻¹ :=
    inv_pos.mpr (Real.sqrt_pos.2 hscale)
  have hN' : ∀ t, SchwartzMap.seminorm ℂ N 0
      (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m) :
        SchwartzMap (Euclidean 2) ℂ) ≤
        (A * ((Real.sqrt scale)⁻¹)⁻¹ ^ 2) * (Real.sqrt scale)⁻¹ ^ N := by
    intro t
    simpa only [inv_inv] using hN t
  have hzero' : ∀ t, SchwartzMap.seminorm ℂ 0 0
      (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m) :
        SchwartzMap (Euclidean 2) ℂ) ≤ A * ((Real.sqrt scale)⁻¹)⁻¹ ^ 2 := by
    intro t
    simpa only [inv_inv] using hzero t
  exact angularDyadicCubePacket_ray_localized_of_residual_seminorm
    C σ j χ m ϑ scale width (Real.sqrt scale)⁻¹ A T N direction
    hm hδ hϑ hN' hzero'

/-- The explicit derivative budget contributed by one concrete scaled ray
cube cutoff.  The sum is the literal Leibniz expansion: the base-amplitude
derivative bound `B k` multiplies the exactly scaled `L¹` norm of the
order-`n-k` derivative of the fixed prototype. -/
def scaledRayCubeResidualDerivativeBound
    (prototype : SchwartzMap (Euclidean 2) Complex) (scale width : Real)
    (B : Nat → Real) (n : Nat) : Real :=
  ∑ k ∈ Finset.range (n + 1), (n.choose k : Real) * B k *
    ((width * Real.sqrt scale) ^ 2 *
      ((width * Real.sqrt scale)⁻¹) ^ (n - k) *
      ∫ η : Euclidean 2, ‖iteratedFDeriv Real (n - k) prototype η‖)

/-- Explicit derivative bounds for the actual phase-mismatch base amplitude
give an `L¹` derivative bound for the literal residual symbol with the
concrete scaled ray-cube cutoff.  This is a proved Leibniz estimate, not a
new localization predicate. -/
theorem integral_norm_iteratedFDeriv_angularDyadicCubeResidualSymbol_le_scaledRayCubeCutoff
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (direction : Euclidean 2) (χ prototype : SchwartzMap (Euclidean 2) Complex)
    (scale width : Real) (hradius : 0 < width * Real.sqrt scale)
    (N : Nat) (B : Nat → Real)
    (hbase : ∀ k ≤ N, ∀ ξ : Euclidean 2,
      ‖iteratedFDeriv Real k
        (angularDyadicResidualBaseSymbol C σ j t direction χ) ξ‖ ≤ B k)
    {n : Nat} (hn : n ≤ N) :
    ∫ ξ : Euclidean 2,
      ‖iteratedFDeriv Real n
        (angularDyadicCubeResidualSymbol C σ j t direction χ
          (scaledRayCubeCutoff prototype scale width direction hradius)) ξ‖ ≤
      scaledRayCubeResidualDerivativeBound prototype scale width B n := by
  let m : SchwartzMap (Euclidean 2) Complex :=
    scaledRayCubeCutoff prototype scale width direction hradius
  let base : SchwartzMap (Euclidean 2) Complex :=
    angularDyadicResidualBaseSymbol C σ j t direction χ
  have hfactor :
      (angularDyadicCubeResidualSymbol C σ j t direction χ m :
        Euclidean 2 → Complex) =
        fun ξ => base ξ * m ξ := by
    funext ξ
    exact angularDyadicCubeResidualSymbol_eq_residualBase_mul
      C σ j t direction ξ χ m
  have hresint : Integrable (fun ξ : Euclidean 2 =>
      ‖iteratedFDeriv Real n
        (angularDyadicCubeResidualSymbol C σ j t direction χ m) ξ‖) volume := by
    simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume
      (angularDyadicCubeResidualSymbol C σ j t direction χ m) 0 n
  have hsumint : Integrable (fun ξ : Euclidean 2 =>
      ∑ k ∈ Finset.range (n + 1),
        (n.choose k : Real) * B k * ‖iteratedFDeriv Real (n - k) m ξ‖) volume := by
    apply integrable_finsetSum
    intro k hk
    have hmint : Integrable (fun ξ : Euclidean 2 =>
        ‖iteratedFDeriv Real (n - k) m ξ‖) volume := by
      simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume m 0 (n - k)
    exact hmint.const_mul ((n.choose k : Real) * B k)
  calc
    ∫ ξ : Euclidean 2,
        ‖iteratedFDeriv Real n
          (angularDyadicCubeResidualSymbol C σ j t direction χ m) ξ‖ ≤
        ∫ ξ : Euclidean 2,
          ∑ k ∈ Finset.range (n + 1),
            (n.choose k : Real) * B k * ‖iteratedFDeriv Real (n - k) m ξ‖ := by
      apply integral_mono hresint hsumint
      intro ξ
      rw [hfactor]
      calc
        ‖iteratedFDeriv Real n (fun y => base y * m y) ξ‖ ≤
            ∑ k ∈ Finset.range (n + 1),
              (n.choose k : Real) * ‖iteratedFDeriv Real k base ξ‖ *
                ‖iteratedFDeriv Real (n - k) m ξ‖ :=
          norm_iteratedFDeriv_mul_le (base.smooth (N : ℕ∞))
            (m.smooth (N : ℕ∞)) ξ (by exact_mod_cast hn)
        _ ≤ ∑ k ∈ Finset.range (n + 1),
              (n.choose k : Real) * B k *
                ‖iteratedFDeriv Real (n - k) m ξ‖ := by
          apply Finset.sum_le_sum
          intro k hk
          have hk' : k ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
          have hkN : k ≤ N := le_trans hk' hn
          have hBk : 0 ≤ B k :=
            (norm_nonneg (iteratedFDeriv Real k base 0)).trans (hbase k hkN 0)
          exact mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left (hbase k hkN ξ) (by positivity))
            (norm_nonneg _)
    _ = ∑ k ∈ Finset.range (n + 1),
          (n.choose k : Real) * B k *
            ∫ ξ : Euclidean 2, ‖iteratedFDeriv Real (n - k) m ξ‖ := by
      rw [integral_finsetSum]
      · apply Finset.sum_congr rfl
        intro k hk
        rw [integral_const_mul]
      · intro k hk
        have hmint : Integrable (fun ξ : Euclidean 2 =>
            ‖iteratedFDeriv Real (n - k) m ξ‖) volume := by
          simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume m 0 (n - k)
        exact hmint.const_mul ((n.choose k : Real) * B k)
    _ = scaledRayCubeResidualDerivativeBound prototype scale width B n := by
      unfold scaledRayCubeResidualDerivativeBound
      apply Finset.sum_congr rfl
      intro k hk
      rw [show m = scaledRayCubeCutoff prototype scale width direction hradius by rfl,
        integral_norm_iteratedFDeriv_scaledRayCubeCutoff]

/-- A cutoff-supported version of the residual Leibniz estimate.  A base
derivative is only needed where the paired derivative of the concrete cube
cutoff is nonzero; this is the form compatible with local phase bounds on a
matched ray cube. -/
theorem integral_norm_iterFDeriv_angDyCubeResSymbol_le_scRayCubeCutoff_of_suppBounds
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (direction : Euclidean 2) (χ prototype : SchwartzMap (Euclidean 2) Complex)
    (scale width : Real) (hradius : 0 < width * Real.sqrt scale)
    (N : Nat) (B : Nat → Real)
    (hbase : ∀ k ≤ N, ∀ ℓ ≤ N - k, ∀ ξ : Euclidean 2,
      ξ ∈ Function.support (iteratedFDeriv Real ℓ
        (scaledRayCubeCutoff prototype scale width direction hradius :
          Euclidean 2 → Complex)) →
      ‖iteratedFDeriv Real k
        (angularDyadicResidualBaseSymbol C σ j t direction χ) ξ‖ ≤ B k)
    {n : Nat} (hn : n ≤ N) :
    ∫ ξ : Euclidean 2,
      ‖iteratedFDeriv Real n
        (angularDyadicCubeResidualSymbol C σ j t direction χ
          (scaledRayCubeCutoff prototype scale width direction hradius)) ξ‖ ≤
      scaledRayCubeResidualDerivativeBound prototype scale width B n := by
  let m : SchwartzMap (Euclidean 2) Complex :=
    scaledRayCubeCutoff prototype scale width direction hradius
  let base : SchwartzMap (Euclidean 2) Complex :=
    angularDyadicResidualBaseSymbol C σ j t direction χ
  have hfactor :
      (angularDyadicCubeResidualSymbol C σ j t direction χ m :
        Euclidean 2 → Complex) =
        fun ξ => base ξ * m ξ := by
    funext ξ
    exact angularDyadicCubeResidualSymbol_eq_residualBase_mul
      C σ j t direction ξ χ m
  have hresint : Integrable (fun ξ : Euclidean 2 =>
      ‖iteratedFDeriv Real n
        (angularDyadicCubeResidualSymbol C σ j t direction χ m) ξ‖) volume := by
    simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume
      (angularDyadicCubeResidualSymbol C σ j t direction χ m) 0 n
  have hsumint : Integrable (fun ξ : Euclidean 2 =>
      ∑ k ∈ Finset.range (n + 1),
        (n.choose k : Real) * B k * ‖iteratedFDeriv Real (n - k) m ξ‖) volume := by
    apply integrable_finsetSum
    intro k hk
    have hmint : Integrable (fun ξ : Euclidean 2 =>
        ‖iteratedFDeriv Real (n - k) m ξ‖) volume := by
      simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume m 0 (n - k)
    exact hmint.const_mul ((n.choose k : Real) * B k)
  calc
    ∫ ξ : Euclidean 2,
        ‖iteratedFDeriv Real n
          (angularDyadicCubeResidualSymbol C σ j t direction χ m) ξ‖ ≤
        ∫ ξ : Euclidean 2,
          ∑ k ∈ Finset.range (n + 1),
            (n.choose k : Real) * B k * ‖iteratedFDeriv Real (n - k) m ξ‖ := by
      apply integral_mono hresint hsumint
      intro ξ
      rw [hfactor]
      calc
        ‖iteratedFDeriv Real n (fun y => base y * m y) ξ‖ ≤
            ∑ k ∈ Finset.range (n + 1),
              (n.choose k : Real) * ‖iteratedFDeriv Real k base ξ‖ *
                ‖iteratedFDeriv Real (n - k) m ξ‖ :=
          norm_iteratedFDeriv_mul_le (base.smooth (N : ℕ∞))
            (m.smooth (N : ℕ∞)) ξ (by exact_mod_cast hn)
        _ ≤ ∑ k ∈ Finset.range (n + 1),
              (n.choose k : Real) * B k *
                ‖iteratedFDeriv Real (n - k) m ξ‖ := by
          apply Finset.sum_le_sum
          intro k hk
          have hk' : k ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
          have hkN : k ≤ N := le_trans hk' hn
          by_cases hzero : iteratedFDeriv Real (n - k) m ξ = 0
          · simp [hzero]
          · have hsupport : ξ ∈ Function.support
                (iteratedFDeriv Real (n - k) m) := hzero
            have hlocal : ‖iteratedFDeriv Real k base ξ‖ ≤ B k :=
              hbase k hkN (n - k) (Nat.sub_le_sub_right hn k) ξ hsupport
            exact mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_left hlocal (by positivity))
              (norm_nonneg _)
    _ = ∑ k ∈ Finset.range (n + 1),
          (n.choose k : Real) * B k *
            ∫ ξ : Euclidean 2, ‖iteratedFDeriv Real (n - k) m ξ‖ := by
      rw [integral_finsetSum]
      · apply Finset.sum_congr rfl
        intro k hk
        rw [integral_const_mul]
      · intro k hk
        have hmint : Integrable (fun ξ : Euclidean 2 =>
            ‖iteratedFDeriv Real (n - k) m ξ‖) volume := by
          simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume m 0 (n - k)
        exact hmint.const_mul ((n.choose k : Real) * B k)
    _ = scaledRayCubeResidualDerivativeBound prototype scale width B n := by
      unfold scaledRayCubeResidualDerivativeBound
      apply Finset.sum_congr rfl
      intro k hk
      rw [show m = scaledRayCubeCutoff prototype scale width direction hradius by rfl,
        integral_norm_iteratedFDeriv_scaledRayCubeCutoff]

/-- The literal first-order residual derivative budget for a matched
plus-sheet scaled ray cube. -/
noncomputable def scaledRayCubePlusResidualFirstDerivativeBound
    (C : lpCutoffs 2) (j : Nat) (χ : SchwartzMap (Euclidean 2) Complex)
    (T scale width : Real) : Nat → Real := fun k =>
  if k = 0 then
    SchwartzMap.seminorm Real 0 0 (angularDyadicResidualAmplitude C j χ)
  else if k = 1 then
    SchwartzMap.seminorm Real 0 1 (angularDyadicResidualAmplitude C j χ) +
      (8 * Real.pi * T * (width * Real.sqrt scale) / scale) *
        SchwartzMap.seminorm Real 0 0 (angularDyadicResidualAmplitude C j χ)
  else 0

/-- The actual plus-sheet residual symbol has a concrete derivative-integral
bound through order one on a matched scaled ray cube.  No global
phase-mismatch derivative hypothesis is used. -/
theorem integral_norm_iterFDeriv_angDyCubeResSymbol_plus_le_scRayCubeCutoff_firstOrder
    (C : lpCutoffs 2) (j : Nat) (T t scale width : Real)
    (direction : Euclidean 2) (χ prototype : SchwartzMap (Euclidean 2) Complex)
    (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (hT : 0 ≤ T) (ht : |t| ≤ T)
    {n : Nat} (hn : n ≤ 1) :
    ∫ ξ : Euclidean 2,
      ‖iteratedFDeriv Real n
        (angularDyadicCubeResidualSymbol C WaveSign.plus j t direction χ
          (scaledRayCubeCutoff prototype scale width direction hradius)) ξ‖ ≤
      scaledRayCubeResidualDerivativeBound prototype scale width
        (scaledRayCubePlusResidualFirstDerivativeBound C j χ T scale width) n := by
  apply integral_norm_iterFDeriv_angDyCubeResSymbol_le_scRayCubeCutoff_of_suppBounds
    C WaveSign.plus j t direction χ prototype scale width hradius 1
    (scaledRayCubePlusResidualFirstDerivativeBound C j χ T scale width) ?_ hn
  intro k hk ℓ hℓ ξ hξ
  have hbound := norm_iteratedFDeriv_angDyResidualBaseSymbol_plus_zero_one_on_scRayCubeCutoff
    C j T t scale width direction χ prototype hradius hprototype hscale hunit hsmall
    hT ht ℓ hξ
  interval_cases k
  · simpa [scaledRayCubePlusResidualFirstDerivativeBound] using hbound.1
  · simpa [scaledRayCubePlusResidualFirstDerivativeBound] using hbound.2

private theorem norm_angularDyadicCubeSpaceTimeKernel_le_lightRayKernel_of_residual_seminorm_at_time
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ m : SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (δ A T : Real) (N : Nat) (direction : Euclidean 2)
    (hδ : 0 < δ) (z : WaveSpaceTime) (y : Euclidean 2)
    (hϑ : ‖ϑ z.2‖ ≤ T)
    (hN : SchwartzMap.seminorm Complex N 0
      (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m) :
        SchwartzMap (Euclidean 2) Complex) ≤
      (A * (δ⁻¹) ^ 2) * δ ^ N)
    (hzero : SchwartzMap.seminorm Complex 0 0
      (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m) :
        SchwartzMap (Euclidean 2) Complex) ≤ A * (δ⁻¹) ^ 2) :
    ‖angularDyadicCubeSpaceTimeKernel C σ j χ m ϑ z y‖ ≤
      (T * (2 : Real) ^ N * A) * lightRayKernel δ N direction y z := by
  have hT : 0 ≤ T := (norm_nonneg (ϑ z.2)).trans hϑ
  have hdecay := Auto.Spherical.Auxiliary.norm_fourierCubeKernel_le_scaled_seminorm_decay
    (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m)
    δ (A * (δ⁻¹) ^ 2) N hδ hzero hN
    (z.1 + z.2 • direction - y)
  have htranslate : (z.1 - y) + z.2 • direction =
      z.1 + z.2 • direction - y := by
    module
  calc
    ‖angularDyadicCubeSpaceTimeKernel C σ j χ m ϑ z y‖ =
        ‖ϑ z.2‖ * ‖angularDyadicCubeKernel C σ j z.2 χ m (z.1 - y)‖ := by
      rw [angularDyadicCubeSpaceTimeKernel, norm_mul]
    _ = ‖ϑ z.2‖ * ‖Auto.Spherical.Auxiliary.fourierCubeKernel
          (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m)
          (z.1 + z.2 • direction - y)‖ := by
      rw [angularDyadicCubeKernel_eq_residual_shifted, htranslate]
    _ ≤ T * ‖Auto.Spherical.Auxiliary.fourierCubeKernel
          (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m)
          (z.1 + z.2 • direction - y)‖ :=
      mul_le_mul_of_nonneg_right hϑ (norm_nonneg _)
    _ ≤ T * ((2 : Real) ^ N * (A * (δ⁻¹) ^ 2) *
          (1 + δ⁻¹ * ‖z.1 + z.2 • direction - y‖)⁻¹ ^ N) :=
      mul_le_mul_of_nonneg_left hdecay hT
    _ = (T * (2 : Real) ^ N * A) * lightRayKernel δ N direction y z := by
      unfold lightRayKernel
      ring

/-- A compactly time-supported cutoff permits the concrete residual
derivative calculation to be used only on its support.  The hypotheses give
uniform derivative bounds for the *explicit* phase-mismatch amplitude on the
time slab and the resulting finite scaled-cutoff budgets.  No bound for the
unbounded-time phase is asserted. -/
theorem scaledRayCubeCutoff_ray_localized_of_residualBaseBounds_on_compactTimeSupport
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ prototype : SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (scale width δ A T t₀ t₁ : Real) (N : Nat) (direction : Euclidean 2)
    (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      frequencyCube 0 1)
    (hδ : 0 < δ) (hA : 0 ≤ A) (hϑ : ∀ t, ‖ϑ t‖ ≤ T)
    (hϑ_support : ∀ t, ϑ t ≠ 0 → t ∈ Icc t₀ t₁)
    (B : Nat → Real)
    (hbase : ∀ t ∈ Icc t₀ t₁, ∀ k ≤ N, ∀ ℓ ≤ N - k, ∀ ξ : Euclidean 2,
      ξ ∈ Function.support (iteratedFDeriv Real ℓ
        (scaledRayCubeCutoff prototype scale width direction hradius :
          Euclidean 2 → Complex)) →
      ‖iteratedFDeriv Real k
        (angularDyadicResidualBaseSymbol C σ j t direction χ) ξ‖ ≤ B k)
    (hbudgetN : (2 : Real) ^ N *
      (∑ n ∈ Finset.range (N + 1),
        scaledRayCubeResidualDerivativeBound prototype scale width B n) ≤
        (A * (δ⁻¹) ^ 2) * δ ^ N)
    (hbudget0 : scaledRayCubeResidualDerivativeBound prototype scale width B 0 ≤
      A * (δ⁻¹) ^ 2) :
    (∀ t, Function.support
      (angularDyadicCubeResidualSymbol C σ j t direction χ
        (scaledRayCubeCutoff prototype scale width direction hradius) :
        Euclidean 2 → Complex) ⊆
        frequencyCube (scale • direction) (width * Real.sqrt scale)) ∧
    (∀ z y, ‖angularDyadicCubeSpaceTimeKernel C σ j χ
      (scaledRayCubeCutoff prototype scale width direction hradius) ϑ z y‖ ≤
      (T * (2 : Real) ^ N * A) * lightRayKernel δ N direction y z) := by
  let m : SchwartzMap (Euclidean 2) Complex :=
    scaledRayCubeCutoff prototype scale width direction hradius
  have hm : isScaledRayCubeCutoff scale width direction m := by
    exact isScaledRayCubeCutoff_scaledRayCubeCutoff prototype scale width direction
      hradius hprototype
  refine ⟨?_, ?_⟩
  · intro t
    exact support_angularDyadicCubeResidualSymbol_subset_frequencyCube
      C σ j t scale width direction χ m hm
  · intro z y
    by_cases hϑ_zero : ϑ z.2 = 0
    · have hT : 0 ≤ T := (norm_nonneg (ϑ z.2)).trans (hϑ z.2)
      have hlight : 0 ≤ lightRayKernel δ N direction y z := by
        unfold lightRayKernel
        positivity
      calc
        ‖angularDyadicCubeSpaceTimeKernel C σ j χ m ϑ z y‖ = 0 := by
          simp [angularDyadicCubeSpaceTimeKernel, hϑ_zero]
        _ ≤ (T * (2 : Real) ^ N * A) * lightRayKernel δ N direction y z :=
          mul_nonneg
            (mul_nonneg (mul_nonneg hT (by positivity)) hA)
            hlight
    · have htime : z.2 ∈ Icc t₀ t₁ := hϑ_support z.2 hϑ_zero
      have hsum :
          (2 : Real) ^ N *
            (∑ n ∈ Finset.range (N + 1), ∫ ξ : Euclidean 2,
              ‖iteratedFDeriv Real n
                (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m) ξ‖) ≤
          (2 : Real) ^ N *
            (∑ n ∈ Finset.range (N + 1),
              scaledRayCubeResidualDerivativeBound prototype scale width B n) := by
        apply mul_le_mul_of_nonneg_left
        · apply Finset.sum_le_sum
          intro n hn
          exact integral_norm_iterFDeriv_angDyCubeResSymbol_le_scRayCubeCutoff_of_suppBounds
            C σ j z.2 direction χ prototype scale width hradius N B
            (fun k hk ℓ hℓ ξ hξ => hbase z.2 htime k hk ℓ hℓ ξ hξ)
            (Nat.lt_succ_iff.mp (Finset.mem_range.mp hn))
        · positivity
      have hderivN :
          (2 : Real) ^ N *
            (∑ n ∈ Finset.range (N + 1), ∫ ξ : Euclidean 2,
              ‖iteratedFDeriv Real n
                (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m) ξ‖) ≤
            (A * (δ⁻¹) ^ 2) * δ ^ N :=
        hsum.trans hbudgetN
      have hderiv0 :
          ∫ ξ : Euclidean 2,
            ‖angularDyadicCubeResidualSymbol C σ j z.2 direction χ m ξ‖ ≤
              A * (δ⁻¹) ^ 2 := by
        calc
          ∫ ξ : Euclidean 2,
              ‖angularDyadicCubeResidualSymbol C σ j z.2 direction χ m ξ‖ =
            ∫ ξ : Euclidean 2,
              ‖iteratedFDeriv Real 0
                (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m) ξ‖ := by
              simp
          _ ≤ scaledRayCubeResidualDerivativeBound prototype scale width B 0 :=
            integral_norm_iterFDeriv_angDyCubeResSymbol_le_scRayCubeCutoff_of_suppBounds
              C σ j z.2 direction χ prototype scale width hradius N B
              (fun k hk ℓ hℓ ξ hξ => hbase z.2 htime k hk ℓ hℓ ξ hξ)
              (Nat.zero_le _)
          _ ≤ A * (δ⁻¹) ^ 2 := hbudget0
      have hseminormN : SchwartzMap.seminorm Complex N 0
          (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m) :
            SchwartzMap (Euclidean 2) Complex) ≤
          (A * (δ⁻¹) ^ 2) * δ ^ N :=
        (angularDyadicCubeResidualSymbol_fourierInv_seminorm_le_derivativeIntegrals
          C σ j z.2 direction χ m N).trans hderivN
      have hseminorm0 : SchwartzMap.seminorm Complex 0 0
          (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m) :
            SchwartzMap (Euclidean 2) Complex) ≤ A * (δ⁻¹) ^ 2 := by
        calc
          SchwartzMap.seminorm Complex 0 0
              (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m) :
                SchwartzMap (Euclidean 2) Complex) ≤
              (2 : Real) ^ 0 *
                ∑ n ∈ Finset.range (0 + 1), ∫ ξ : Euclidean 2,
                  ‖iteratedFDeriv Real n
                    (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m) ξ‖ :=
            angularDyadicCubeResidualSymbol_fourierInv_seminorm_le_derivativeIntegrals
              C σ j z.2 direction χ m 0
          _ = ∫ ξ : Euclidean 2,
              ‖angularDyadicCubeResidualSymbol C σ j z.2 direction χ m ξ‖ := by
              simp
          _ ≤ A * (δ⁻¹) ^ 2 := hderiv0
      exact norm_angularDyadicCubeSpaceTimeKernel_le_lightRayKernel_of_residual_seminorm_at_time
        C σ j χ m ϑ δ A T N direction hδ z y
        (hϑ z.2) hseminormN hseminorm0

/-- The compact-time ray-localization bridge with the literal matched
plus-sheet first-order residual budget.  The only remaining numerical inputs
are the displayed finite budgets; no global residual derivative hypothesis is
assumed.  Its decay order is one, so higher-order radial phase calculus is
still required before using it for an integrable high-decay light-ray kernel. -/
theorem scRayCubeCutoff_ray_loc_of_concretePlusFirstDerivBounds_on_compactTimeSupport
    (C : lpCutoffs 2) (j : Nat)
    (χ prototype : SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (scale width δ A T t₀ t₁ : Real) (direction : Euclidean 2)
    (hradius : 0 < width * Real.sqrt scale)
    (hprototype_cube : Function.support (prototype : Euclidean 2 → Complex) ⊆
      frequencyCube 0 1)
    (hprototype_ball : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (hδ : 0 < δ) (hA : 0 ≤ A) (hT : 0 ≤ T)
    (hϑ : ∀ t, ‖ϑ t‖ ≤ T)
    (hϑ_support : ∀ t, ϑ t ≠ 0 → t ∈ Icc t₀ t₁)
    (hslab : ∀ t ∈ Icc t₀ t₁, |t| ≤ T)
    (hbudgetN : (2 : Real) ^ 1 *
      (∑ n ∈ Finset.range (1 + 1),
        scaledRayCubeResidualDerivativeBound prototype scale width
          (scaledRayCubePlusResidualFirstDerivativeBound C j χ T scale width) n) ≤
        (A * (δ⁻¹) ^ 2) * δ ^ 1)
    (hbudget0 : scaledRayCubeResidualDerivativeBound prototype scale width
      (scaledRayCubePlusResidualFirstDerivativeBound C j χ T scale width) 0 ≤
        A * (δ⁻¹) ^ 2) :
    (∀ t, Function.support
      (angularDyadicCubeResidualSymbol C WaveSign.plus j t direction χ
        (scaledRayCubeCutoff prototype scale width direction hradius) :
        Euclidean 2 → Complex) ⊆
        frequencyCube (scale • direction) (width * Real.sqrt scale)) ∧
    (∀ z y, ‖angularDyadicCubeSpaceTimeKernel C WaveSign.plus j χ
      (scaledRayCubeCutoff prototype scale width direction hradius) ϑ z y‖ ≤
      (T * (2 : Real) ^ 1 * A) * lightRayKernel δ 1 direction y z) := by
  apply scaledRayCubeCutoff_ray_localized_of_residualBaseBounds_on_compactTimeSupport
    C WaveSign.plus j χ prototype ϑ scale width δ A T t₀ t₁ 1 direction
    hradius hprototype_cube hδ hA hϑ hϑ_support
    (scaledRayCubePlusResidualFirstDerivativeBound C j χ T scale width)
  · intro t ht k hk ℓ hℓ ξ hξ
    have hbound := norm_iteratedFDeriv_angDyResidualBaseSymbol_plus_zero_one_on_scRayCubeCutoff
      C j T t scale width direction χ prototype hradius hprototype_ball hscale hunit hsmall
      hT (hslab t ht) ℓ hξ
    interval_cases k
    · simpa [scaledRayCubePlusResidualFirstDerivativeBound] using hbound.1
    · simpa [scaledRayCubePlusResidualFirstDerivativeBound] using hbound.2
  · exact hbudgetN
  · exact hbudget0

/-!
### Literal high-order matched-ray packet bounds

The following finite-order calculation combines the all-order radial
phase-mismatch bounds above with the literal residual amplitude and the
existing scaled-cutoff Leibniz bridge.  Its final packet coefficient is
deliberately displayed with its dependence on the cutoff radius; the current
cutoff/amplitude hypotheses do not normalize that dependence uniformly in the
ray scale.
-/

private noncomputable def realMulI : Real →ₗᵢ[Real] Complex where
  toLinearMap := (Complex.ofRealCLM.smulRight Complex.I).toLinearMap
  norm_map' := by
    intro r
    simp

private lemma norm_iteratedFDeriv_exp_ofReal_mul_I_le_two
    (n : Nat) (r : Real) :
    ‖iteratedFDeriv Real n
      (fun s : Real => Complex.exp (((s : Complex) * Complex.I))) r‖ ≤ 2 := by
  let c : Real → Complex := fun s => (Real.cos s : Complex)
  let s : Real → Complex := fun q => (Real.sin q : Complex) * Complex.I
  have hcos : ContDiff Real (n : ℕ∞) Real.cos := Real.contDiff_cos
  have hsin : ContDiff Real (n : ℕ∞) Real.sin := Real.contDiff_sin
  have hfun : (fun q : Real => Complex.exp (((q : Complex) * Complex.I))) = c + s := by
    funext q
    simp [c, s, Complex.exp_mul_I]
  have hc : c = Complex.ofRealLI ∘ Real.cos := by rfl
  have hs : s = realMulI ∘ Real.sin := by rfl
  rw [hfun, hc, hs]
  rw [iteratedFDeriv_add (Complex.ofRealLI.contDiff.comp hcos)
    (realMulI.contDiff.comp hsin)]
  calc
      ‖iteratedFDeriv Real n c r + iteratedFDeriv Real n s r‖ ≤
          ‖iteratedFDeriv Real n c r‖ + ‖iteratedFDeriv Real n s r‖ := norm_add_le _ _
      _ ≤ 1 + 1 := by
        apply add_le_add
        · rw [hc, Complex.ofRealLI.norm_iteratedFDeriv_comp_left]
          · rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv]
            simpa [Real.norm_eq_abs] using Real.abs_iteratedDeriv_cos_le_one n r
          · exact hcos.contDiffAt
          · exact_mod_cast le_rfl
        · rw [hs, realMulI.norm_iteratedFDeriv_comp_left]
          · rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv]
            simpa [Real.norm_eq_abs] using Real.abs_iteratedDeriv_sin_le_one n r
          · exact hsin.contDiffAt
          · exact_mod_cast le_rfl
      _ = 2 := by norm_num

private lemma norm_iteratedFDeriv_comp_le_on_open
    {E F G : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    [NormedAddCommGroup F] [NormedSpace Real F]
    [NormedAddCommGroup G] [NormedSpace Real G]
    (s : Set E) (hs : IsOpen s) (f : E → F) (g : F → G)
    (N n : Nat) (hf : ContDiffOn Real (N : ℕ∞) f s)
    (hg : ContDiff Real (N : ℕ∞) g) {x : E} (hx : x ∈ s)
    (hnN : n ≤ N)
    {C D : Real}
    (hC : ∀ i, i ≤ n → ‖iteratedFDeriv Real i g (f x)‖ ≤ C)
    (hD : ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDeriv Real i f x‖ ≤ D ^ i) :
    ‖iteratedFDeriv Real n (g ∘ f) x‖ ≤ (n.factorial : Real) * C * D ^ n := by
  have hn : (n : WithTop ℕ∞) ≤ (↑(N : ℕ∞) : WithTop ℕ∞) := by
    exact_mod_cast hnN
  have hcomp := norm_iteratedFDerivWithin_comp_le
    (s := s) (t := Set.univ) (n := n) (N := (N : ℕ∞))
    hg.contDiffOn hf
    hn
    uniqueDiffOn_univ hs.uniqueDiffOn (by simp) hx
    (C := C) (D := D)
    (by
      intro i hi
      simpa only [iteratedFDerivWithin_univ] using hC i hi)
    (by
      intro i hi1 hin
      rw [iteratedFDerivWithin_of_isOpen i hs hx]
      exact hD i hi1 hin)
  rw [iteratedFDerivWithin_of_isOpen n hs hx] at hcomp
  exact hcomp

private noncomputable def timeAngularDyadicRayPhaseMismatchPlus
    (t : Real) (direction : Euclidean 2) : Euclidean 2 → Real := fun ξ =>
  (2 * Real.pi * t) • angularDyadicRayPhaseMismatch WaveSign.plus direction ξ

private lemma timeAngularDyadicRayPhaseMismatchPlus_contDiffOn
    (N : Nat) (t : Real) (direction : Euclidean 2) :
    ContDiffOn Real (N : ℕ∞) (timeAngularDyadicRayPhaseMismatchPlus t direction)
      {ξ : Euclidean 2 | ξ ≠ 0} := by
  intro ξ hξ
  have hnorm : ContDiffAt Real (N : ℕ∞) (fun η : Euclidean 2 => ‖η‖) ξ :=
    contDiffAt_norm Real hξ
  have hinner : ContDiffAt Real (N : ℕ∞)
      (innerSL Real direction : Euclidean 2 → Real) ξ :=
    (innerSL Real direction).contDiff.contDiffAt
  have hphasefun : timeAngularDyadicRayPhaseMismatchPlus t direction =
      fun η : Euclidean 2 => (2 * Real.pi * t) * (‖η‖ - inner Real direction η) := by
    funext η
    simp [timeAngularDyadicRayPhaseMismatchPlus, angularDyadicRayPhaseMismatch,
      WaveSign.toReal, smul_eq_mul]
  rw [hphasefun]
  exact ((hnorm.sub hinner).const_smul (2 * Real.pi * t)).contDiffWithinAt
    (s := {η : Euclidean 2 | η ≠ 0})

private lemma norm_iteratedFDeriv_timeAngularDyadicRayPhaseMismatchPlusExp_le
    (N n : Nat) (t : Real) (direction : Euclidean 2) {ξ : Euclidean 2}
    (hξ : ξ ≠ 0) (hn : n ≤ N) {D : Real}
    (hD : ∀ i, 1 ≤ i → i ≤ n →
      ‖iteratedFDeriv Real i (timeAngularDyadicRayPhaseMismatchPlus t direction) ξ‖ ≤ D ^ i) :
    ‖iteratedFDeriv Real n
      (fun η : Euclidean 2 => Complex.exp
        (((timeAngularDyadicRayPhaseMismatchPlus t direction η : Real) : Complex) * Complex.I)) ξ‖ ≤
      (n.factorial : Real) * 2 * D ^ n := by
  let e : Real → Complex := fun r => Complex.exp (((r : Complex) * Complex.I))
  have he : ContDiff Real (N : ℕ∞) e := by
    let L : Real →L[Real] Complex := Complex.ofRealCLM.smulRight Complex.I
    change ContDiff Real (N : ℕ∞) (fun r => Complex.exp (L r))
    exact Complex.contDiff_exp.comp L.contDiff
  have hsopen : IsOpen {η : Euclidean 2 | η ≠ 0} := by
    simpa using (isOpen_ne : IsOpen {η : Euclidean 2 | η ≠ 0})
  have hcomp := norm_iteratedFDeriv_comp_le_on_open
    {η : Euclidean 2 | η ≠ 0} hsopen
    (timeAngularDyadicRayPhaseMismatchPlus t direction) e N n
    (timeAngularDyadicRayPhaseMismatchPlus_contDiffOn N t direction) he hξ hn
    (C := 2) (D := D)
    (fun i hi => norm_iteratedFDeriv_exp_ofReal_mul_I_le_two i
      (timeAngularDyadicRayPhaseMismatchPlus t direction ξ)) hD
  change ‖iteratedFDeriv Real n (e ∘ timeAngularDyadicRayPhaseMismatchPlus t direction) ξ‖ ≤ _
  exact hcomp

private lemma norm_iteratedFDeriv_timeAngularDyadicRayPhaseMismatchPlus_high_le
    (A : Nat → Real)
    (hA : ∀ m : Nat, 0 ≤ A m ∧ ∀
      (prototype : SchwartzMap (Euclidean 2) Complex) (scale width : Real)
      (direction : Euclidean 2) (hradius : 0 < width * Real.sqrt scale),
      Function.support (prototype : Euclidean 2 → Complex) ⊆ Metric.closedBall 0 1 →
      0 < scale → ‖direction‖ = 1 → 2 * (width * Real.sqrt scale) ≤ scale →
      ∀ (k : Nat) {ξ : Euclidean 2}, ξ ∈ Function.support (iteratedFDeriv Real k
        (scaledRayCubeCutoff prototype scale width direction hradius :
          Euclidean 2 → Complex)) →
        scale ^ ((m + 2) - 1) * ‖iteratedFDeriv Real (m + 2)
          (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ‖ ≤ A m)
    (prototype : SchwartzMap (Euclidean 2) Complex) (scale width T t : Real)
    (direction : Euclidean 2) (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (hT : 0 ≤ T) (ht : |t| ≤ T)
    (m k : Nat) {ξ : Euclidean 2}
    (hξ : ξ ∈ Function.support (iteratedFDeriv Real k
      (scaledRayCubeCutoff prototype scale width direction hradius :
        Euclidean 2 → Complex))) :
    ‖iteratedFDeriv Real (m + 2) (timeAngularDyadicRayPhaseMismatchPlus t direction) ξ‖ ≤
      (2 * Real.pi * T) * A m * (scale ^ (m + 1))⁻¹ := by
  have hphase := (hA m).2 prototype scale width direction hradius hprototype hscale hunit hsmall k
      hξ
  have hpow : 0 < scale ^ (m + 1) := pow_pos hscale _
  have hmis : ‖iteratedFDeriv Real (m + 2)
      (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ‖ ≤
      A m * (scale ^ (m + 1))⁻¹ := by
    have hrewrite : (m + 2) - 1 = m + 1 := by omega
    rw [hrewrite] at hphase
    have hdiv : ‖iteratedFDeriv Real (m + 2)
        (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ‖ ≤
        A m / scale ^ (m + 1) := by
      apply (le_div_iff₀ hpow).mpr
      simpa [mul_comm] using hphase
    simpa only [div_eq_mul_inv] using hdiv
  have htime : |2 * Real.pi * t| ≤ 2 * Real.pi * T := by
    rw [abs_mul, abs_mul, abs_of_nonneg (by positivity : 0 ≤ (2 : Real)),
      abs_of_nonneg Real.pi_pos.le]
    exact mul_le_mul_of_nonneg_left ht (by positivity)
  have hmisdiff : ContDiffAt Real (m + 2 : ℕ∞)
      (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ := by
    unfold angularDyadicRayPhaseMismatch
    simp only [WaveSign.toReal, one_mul]
    exact (contDiffAt_norm Real (by
      intro hzero
      have hball := support_iteratedFDeriv_scaledRayCubeCutoff_subset_closedBall
        prototype scale width direction hradius hprototype k hξ
      subst ξ
      rw [Metric.mem_closedBall, dist_eq_norm] at hball
      have hcenter : ‖scale • direction‖ = scale := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos hscale, hunit, mul_one]
      have hscalele : scale ≤ width * Real.sqrt scale := by
        simpa only [norm_sub_rev, sub_zero, hcenter] using hball
      nlinarith)).sub ((innerSL Real direction).contDiff.contDiffAt)
  change ‖iteratedFDeriv Real (m + 2)
    ((2 * Real.pi * t) • angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ‖ ≤ _
  rw [iteratedFDeriv_const_smul_apply (a := 2 * Real.pi * t) hmisdiff]
  rw [norm_smul]
  exact (mul_le_mul htime hmis (norm_nonneg _) (by positivity)).trans_eq (by ring)

private lemma norm_iteratedFDeriv_timeAngularDyadicRayPhaseMismatchPlus_one_le
    (prototype : SchwartzMap (Euclidean 2) Complex) (scale width T t : Real)
    (direction : Euclidean 2) (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (hT : 0 ≤ T) (ht : |t| ≤ T)
    (k : Nat) {ξ : Euclidean 2}
    (hξ : ξ ∈ Function.support (iteratedFDeriv Real k
      (scaledRayCubeCutoff prototype scale width direction hradius :
        Euclidean 2 → Complex))) :
    ‖iteratedFDeriv Real 1 (timeAngularDyadicRayPhaseMismatchPlus t direction) ξ‖ ≤
      8 * Real.pi * T * (width * Real.sqrt scale) / scale := by
  have h := norm_iterFDeriv_time_angDyRayPhaseMismatch_plus_zero_one_on_scRayCubeCutoff
    prototype scale width direction hradius hprototype hscale hunit hsmall T t hT ht k hξ
  change ‖iteratedFDeriv Real 1
    (fun η : Euclidean 2 => (2 * Real.pi * t) •
      angularDyadicRayPhaseMismatch WaveSign.plus direction η) ξ‖ ≤ _
  simpa only [norm_iteratedFDeriv_one] using h.2

private theorem exists_scaleControlled_timeAngularDyadicRayPhaseMismatchPlusDerivativePowerBound
    (N : Nat) (prototype : SchwartzMap (Euclidean 2) Complex)
    (scale width T : Real) (direction : Euclidean 2)
    (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (hT : 0 ≤ T) :
    ∃ D : Real, 1 ≤ D ∧ ∀ (t : Real), |t| ≤ T → ∀ (i k : Nat),
      1 ≤ i → i ≤ N → ∀ {ξ : Euclidean 2},
      ξ ∈ Function.support (iteratedFDeriv Real k
        (scaledRayCubeCutoff prototype scale width direction hradius :
          Euclidean 2 → Complex)) →
      ‖iteratedFDeriv Real i (timeAngularDyadicRayPhaseMismatchPlus t direction) ξ‖ ≤ D ^ i := by
  choose A hA0 hA using fun m : Nat =>
    exists_scaledRayCubeCutoff_plusMismatch_higherDerivativeBound (m + 2) (by omega)
  let d₁ : Real := 8 * Real.pi * T * (width * Real.sqrt scale) / scale
  let dHigh : Nat → Real := fun m =>
    (2 * Real.pi * T) * A m * (scale ^ (m + 1))⁻¹
  let D : Real := 1 + d₁ + ∑ m ∈ Finset.range (N + 1), dHigh m
  have hd₁0 : 0 ≤ d₁ := by
    dsimp [d₁]
    positivity
  have hdHigh0 : ∀ m : Nat, 0 ≤ dHigh m := by
    intro m
    dsimp [dHigh]
    exact mul_nonneg (mul_nonneg (mul_nonneg (by positivity) hT) (hA0 m))
      (inv_nonneg.mpr (pow_nonneg hscale.le _))
  have hsum0 : 0 ≤ ∑ m ∈ Finset.range (N + 1), dHigh m := by
    exact Finset.sum_nonneg fun m hm => hdHigh0 m
  have hD1 : 1 ≤ D := by
    dsimp [D]
    linarith
  refine ⟨D, hD1, ?_⟩
  intro t ht i k hi1 hiN ξ hξ
  have hDpow : D ≤ D ^ i := le_self_pow₀ hD1 (Nat.ne_of_gt hi1)
  by_cases hi_eq : i = 1
  · subst i
    have hphase := norm_iteratedFDeriv_timeAngularDyadicRayPhaseMismatchPlus_one_le
      prototype scale width T t direction hradius hprototype hscale hunit hsmall hT ht k hξ
    have hd₁le : d₁ ≤ D := by
      dsimp [D]
      linarith
    simpa only [pow_one] using hphase.trans (hd₁le.trans hDpow)
  · have hi2 : 2 ≤ i := by omega
    let m : Nat := i - 2
    have him : m + 2 = i := by
      dsimp [m]
      omega
    have hmrange : m ∈ Finset.range (N + 1) := by
      apply Finset.mem_range.mpr
      dsimp [m]
      omega
    have hphase := norm_iteratedFDeriv_timeAngularDyadicRayPhaseMismatchPlus_high_le
      A (fun m => ⟨hA0 m, hA m⟩) prototype scale width T t direction hradius hprototype
      hscale hunit hsmall hT ht m k hξ
    rw [him] at hphase
    have hdHighle : dHigh m ≤ D := by
      have hterm : dHigh m ≤ ∑ q ∈ Finset.range (N + 1), dHigh q := by
        exact Finset.single_le_sum (fun q hq => hdHigh0 q) hmrange
      dsimp [D]
      linarith
    exact hphase.trans (hdHighle.trans hDpow)

private lemma norm_iteratedFDeriv_mul_le_on_open
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    (s : Set E) (hs : IsOpen s) (f g : E → Complex)
    (N n : Nat) (hf : ContDiffOn Real (N : ℕ∞) f s)
    (hg : ContDiffOn Real (N : ℕ∞) g s) {x : E} (hx : x ∈ s)
    (hn : n ≤ N) :
    ‖iteratedFDeriv Real n (fun y => f y * g y) x‖ ≤
      ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) *
        ‖iteratedFDeriv Real i f x‖ * ‖iteratedFDeriv Real (n - i) g x‖ := by
  have hn' : (n : WithTop ℕ∞) ≤ (↑(N : ℕ∞) : WithTop ℕ∞) := by
    exact_mod_cast hn
  have h := norm_iteratedFDerivWithin_mul_le hf hg hs.uniqueDiffOn hx hn'
  rw [iteratedFDerivWithin_of_isOpen n hs hx] at h
  calc
    ‖iteratedFDeriv Real n (fun y => f y * g y) x‖ ≤
        ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) *
          ‖iteratedFDerivWithin Real i f s x‖ *
            ‖iteratedFDerivWithin Real (n - i) g s x‖ := h
    _ = ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) *
          ‖iteratedFDeriv Real i f x‖ * ‖iteratedFDeriv Real (n - i) g x‖ := by
      apply Finset.sum_congr rfl
      intro i hi
      rw [iteratedFDerivWithin_of_isOpen i hs hx,
        iteratedFDerivWithin_of_isOpen (n - i) hs hx]

/-- The literal finite-order base-amplitude budget for the matched plus ray. -/
noncomputable def scaledRayCubePlusResidualBaseDerivativeBound
    (C : lpCutoffs 2) (j : Nat) (χ : SchwartzMap (Euclidean 2) Complex)
    (D : Real) : Nat → Real := fun n =>
  ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) *
    ((i.factorial : Real) * 2 * D ^ i) *
      SchwartzMap.seminorm Real 0 (n - i) (angularDyadicResidualAmplitude C j χ)

/-- The all-order radial phase calculus gives explicit finite-order bounds for
the literal plus-sheet residual base amplitude on every derivative support of
a matched scaled ray cube. -/
theorem exists_scaledRayCubeCutoff_plusResidualBaseDerivativeBounds
    (C : lpCutoffs 2) (j N : Nat) (χ prototype : SchwartzMap (Euclidean 2) Complex)
    (scale width T : Real) (direction : Euclidean 2)
    (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (hT : 0 ≤ T) :
    ∃ (D : Real) (B : Nat → Real), 1 ≤ D ∧ (∀ n, 0 ≤ B n) ∧
      ∀ (t : Real), |t| ≤ T → ∀ (n k : Nat), n ≤ N → ∀ {ξ : Euclidean 2},
        ξ ∈ Function.support (iteratedFDeriv Real k
          (scaledRayCubeCutoff prototype scale width direction hradius :
            Euclidean 2 → Complex)) →
        ‖iteratedFDeriv Real n
          (angularDyadicResidualBaseSymbol C WaveSign.plus j t direction χ) ξ‖ ≤ B n := by
  obtain ⟨D, hD1, hD⟩ :=
    exists_scaleControlled_timeAngularDyadicRayPhaseMismatchPlusDerivativePowerBound
      N prototype scale width T direction hradius hprototype hscale hunit hsmall hT
  let B : Nat → Real := scaledRayCubePlusResidualBaseDerivativeBound C j χ D
  have hD0 : 0 ≤ D := le_trans zero_le_one hD1
  have hB0 : ∀ n, 0 ≤ B n := by
    intro n
    dsimp [B, scaledRayCubePlusResidualBaseDerivativeBound]
    apply Finset.sum_nonneg
    intro i hi
    have hfactor : 0 ≤ (i.factorial : Real) * 2 * D ^ i := by positivity
    have hsemi : 0 ≤ SchwartzMap.seminorm Real 0 (n - i) (angularDyadicResidualAmplitude C j χ) :=
      (norm_nonneg _).trans
        (SchwartzMap.norm_iteratedFDeriv_le_seminorm
          Real (angularDyadicResidualAmplitude C j χ) (n - i) 0)
    exact mul_nonneg (mul_nonneg (Nat.cast_nonneg _) hfactor) hsemi
  refine ⟨D, B, hD1, hB0, ?_⟩
  intro t ht n k hn ξ hξ
  let phase : Euclidean 2 → Complex := fun η => Complex.exp
    (((timeAngularDyadicRayPhaseMismatchPlus t direction η : Real) : Complex) * Complex.I)
  let amp : SchwartzMap (Euclidean 2) Complex := angularDyadicResidualAmplitude C j χ
  let U : Set (Euclidean 2) := {η : Euclidean 2 | η ≠ 0}
  have hU : IsOpen U := by
    simpa [U] using (isOpen_ne : IsOpen {η : Euclidean 2 | η ≠ 0})
  have hphaseSmooth : ContDiffOn Real (N : ℕ∞) phase U := by
    let e : Real → Complex := fun r => Complex.exp (((r : Complex) * Complex.I))
    have he : ContDiff Real (N : ℕ∞) e := by
      let L : Real →L[Real] Complex := Complex.ofRealCLM.smulRight Complex.I
      change ContDiff Real (N : ℕ∞) (fun r => Complex.exp (L r))
      exact Complex.contDiff_exp.comp L.contDiff
    change ContDiffOn Real (N : ℕ∞) (e ∘ timeAngularDyadicRayPhaseMismatchPlus t direction) U
    exact he.comp_contDiffOn (timeAngularDyadicRayPhaseMismatchPlus_contDiffOn N t direction)
  have hampSmooth : ContDiffOn Real (N : ℕ∞) (amp : Euclidean 2 → Complex) U := by
    exact ((amp.smooth (N : ℕ∞)).contDiffOn).mono (subset_univ _)
  have hball := support_iteratedFDeriv_scaledRayCubeCutoff_subset_closedBall
    prototype scale width direction hradius hprototype k hξ
  have hξ0 : ξ ≠ 0 := by
    intro hzero
    subst ξ
    rw [Metric.mem_closedBall, dist_eq_norm] at hball
    have hcenter : ‖scale • direction‖ = scale := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hscale, hunit, mul_one]
    have hscalele : scale ≤ width * Real.sqrt scale := by
      simpa only [norm_sub_rev, sub_zero, hcenter] using hball
    nlinarith
  have hphaseBound : ∀ i ≤ n, ‖iteratedFDeriv Real i phase ξ‖ ≤
      (i.factorial : Real) * 2 * D ^ i := by
    intro i hi
    dsimp [phase]
    apply norm_iteratedFDeriv_timeAngularDyadicRayPhaseMismatchPlusExp_le N i t direction hξ0
      (Nat.le_trans hi hn)
    intro r hr1 hri
    exact hD t ht r k hr1 (Nat.le_trans hri (Nat.le_trans hi hn)) hξ
  have hbaseeq : (angularDyadicResidualBaseSymbol C WaveSign.plus j t direction χ :
      Euclidean 2 → Complex) = fun η => phase η * amp η := by
    funext η
    simp only [phase, amp, angularDyadicResidualBaseSymbol_eq_phaseMismatch,
      angularDyadicResidualAmplitude_apply]
    simp [timeAngularDyadicRayPhaseMismatchPlus, angularDyadicRayPhaseMismatch,
      WaveSign.toReal, smul_eq_mul]
  calc
    ‖iteratedFDeriv Real n
        (angularDyadicResidualBaseSymbol C WaveSign.plus j t direction χ) ξ‖ =
      ‖iteratedFDeriv Real n (fun η => phase η * amp η) ξ‖ := by rw [hbaseeq]
    _ ≤ ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) *
        ‖iteratedFDeriv Real i phase ξ‖ * ‖iteratedFDeriv Real (n - i) amp ξ‖ :=
      norm_iteratedFDeriv_mul_le_on_open U hU phase amp N n hphaseSmooth hampSmooth
        hξ0 hn
    _ ≤ B n := by
      dsimp [B, scaledRayCubePlusResidualBaseDerivativeBound]
      apply Finset.sum_le_sum
      intro i hi
      have hin : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      have hphasei := hphaseBound i hin
      have hampa : ‖iteratedFDeriv Real (n - i) amp ξ‖ ≤
          SchwartzMap.seminorm Real 0 (n - i) amp := by
        simpa using SchwartzMap.le_seminorm Real 0 (n - i) amp ξ
      have hcoef : 0 ≤ (n.choose i : Real) := Nat.cast_nonneg _
      have hphaseBudget0 : 0 ≤ (i.factorial : Real) * 2 * D ^ i := by positivity
      have hamp0 : 0 ≤ ‖iteratedFDeriv Real (n - i) amp ξ‖ := norm_nonneg _
      calc
        (n.choose i : Real) * ‖iteratedFDeriv Real i phase ξ‖ *
            ‖iteratedFDeriv Real (n - i) amp ξ‖ ≤
          (n.choose i : Real) * ((i.factorial : Real) * 2 * D ^ i) *
            ‖iteratedFDeriv Real (n - i) amp ξ‖ := by
              exact mul_le_mul_of_nonneg_right
                (mul_le_mul_of_nonneg_left hphasei hcoef) hamp0
        _ ≤ (n.choose i : Real) * ((i.factorial : Real) * 2 * D ^ i) *
            SchwartzMap.seminorm Real 0 (n - i) amp := by
              exact mul_le_mul_of_nonneg_left hampa
                (mul_nonneg hcoef hphaseBudget0)

/-- The all-order base-amplitude calculation feeds the existing literal
cutoff-supported residual Leibniz bridge. -/
theorem exists_scaledRayCubeCutoff_plusResidualDerivativeIntegralBounds
    (C : lpCutoffs 2) (j N : Nat) (χ prototype : SchwartzMap (Euclidean 2) Complex)
    (scale width T : Real) (direction : Euclidean 2)
    (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (hT : 0 ≤ T) :
    ∃ (D : Real) (B : Nat → Real), 1 ≤ D ∧ (∀ n, 0 ≤ B n) ∧
      ∀ (t : Real), |t| ≤ T → ∀ n ≤ N,
        ∫ ξ : Euclidean 2,
          ‖iteratedFDeriv Real n
            (angularDyadicCubeResidualSymbol C WaveSign.plus j t direction χ
              (scaledRayCubeCutoff prototype scale width direction hradius)) ξ‖ ≤
          scaledRayCubeResidualDerivativeBound prototype scale width B n := by
  obtain ⟨D, B, hD1, hB0, hbase⟩ :=
    exists_scaledRayCubeCutoff_plusResidualBaseDerivativeBounds
      C j N χ prototype scale width T direction hradius hprototype hscale hunit hsmall hT
  refine ⟨D, B, hD1, hB0, ?_⟩
  intro t ht n hn
  apply integral_norm_iterFDeriv_angDyCubeResSymbol_le_scRayCubeCutoff_of_suppBounds
    C WaveSign.plus j t direction χ prototype scale width hradius N B ?_ hn
  intro k hk ell hell ξ hξ
  exact hbase t ht k ell hk hξ

/-- The exact finite coefficient which turns derivative-integral budgets into
packet localization at reciprocal cube radius. -/
noncomputable def scaledRayCubePacketBudget
    (radius S R₀ : Real) (N : Nat) : Real :=
  S * (radius ^ 2 * (radius⁻¹) ^ N)⁻¹ + R₀ * (radius ^ 2)⁻¹

private lemma scaledRayCubePacketBudget_nonneg
    {radius S R₀ : Real} {N : Nat} (hradius : 0 < radius)
    (hS : 0 ≤ S) (hR₀ : 0 ≤ R₀) :
    0 ≤ scaledRayCubePacketBudget radius S R₀ N := by
  unfold scaledRayCubePacketBudget
  apply add_nonneg
  · exact mul_nonneg hS (inv_nonneg.mpr (by positivity))
  · exact mul_nonneg hR₀ (inv_nonneg.mpr (by positivity))

private lemma le_scaledRayCubePacketBudget_high
    {radius S R₀ : Real} {N : Nat} (hradius : 0 < radius)
    (hR₀ : 0 ≤ R₀) :
    S ≤ (scaledRayCubePacketBudget radius S R₀ N * radius ^ 2) *
      (radius⁻¹) ^ N := by
  let X : Real := radius ^ 2 * (radius⁻¹) ^ N
  have hX : 0 < X := by
    dsimp [X]
    positivity
  have hX0 : 0 ≤ X := le_of_lt hX
  have hXne : X ≠ 0 := ne_of_gt hX
  have hmain : S = (S * X⁻¹) * X := by
    calc
      S = S * (X⁻¹ * X) := by rw [inv_mul_cancel₀ hXne, mul_one]
      _ = (S * X⁻¹) * X := by ring
  have htail : 0 ≤ R₀ * (radius ^ 2)⁻¹ := by
    exact mul_nonneg hR₀ (inv_nonneg.mpr (by positivity))
  unfold scaledRayCubePacketBudget
  calc
    S = (S * X⁻¹) * X := hmain
    _ ≤ (S * X⁻¹ + R₀ * (radius ^ 2)⁻¹) * X :=
      mul_le_mul_of_nonneg_right (le_add_of_nonneg_right htail) hX0
    _ = (S * (radius ^ 2 * (radius⁻¹) ^ N)⁻¹ + R₀ * (radius ^ 2)⁻¹) *
        radius ^ 2 * (radius⁻¹) ^ N := by
      dsimp [X]
      ring

private lemma le_scaledRayCubePacketBudget_zero
    {radius S R₀ : Real} {N : Nat} (hradius : 0 < radius)
    (hS : 0 ≤ S) :
    R₀ ≤ scaledRayCubePacketBudget radius S R₀ N * radius ^ 2 := by
  have hsq : 0 < radius ^ 2 := by positivity
  have hsq0 : 0 ≤ radius ^ 2 := le_of_lt hsq
  have hsqne : radius ^ 2 ≠ 0 := ne_of_gt hsq
  have hmain : R₀ = (R₀ * (radius ^ 2)⁻¹) * radius ^ 2 := by
    calc
      R₀ = R₀ * ((radius ^ 2)⁻¹ * radius ^ 2) := by
        rw [inv_mul_cancel₀ hsqne, mul_one]
      _ = (R₀ * (radius ^ 2)⁻¹) * radius ^ 2 := by ring
  have hhead : 0 ≤ S * (radius ^ 2 * (radius⁻¹) ^ N)⁻¹ := by
    exact mul_nonneg hS (inv_nonneg.mpr (by positivity))
  unfold scaledRayCubePacketBudget
  calc
    R₀ = (R₀ * (radius ^ 2)⁻¹) * radius ^ 2 := hmain
    _ ≤ (S * (radius ^ 2 * (radius⁻¹) ^ N)⁻¹ + R₀ * (radius ^ 2)⁻¹) *
        radius ^ 2 :=
      mul_le_mul_of_nonneg_right (le_add_of_nonneg_left hhead) hsq0

private lemma scaledRayCubeResidualDerivativeBound_nonneg
    (prototype : SchwartzMap (Euclidean 2) Complex) (scale width : Real)
    (hradius : 0 < width * Real.sqrt scale)
    (B : Nat → Real) (hB : ∀ n, 0 ≤ B n) (n : Nat) :
    0 ≤ scaledRayCubeResidualDerivativeBound prototype scale width B n := by
  unfold scaledRayCubeResidualDerivativeBound
  apply Finset.sum_nonneg
  intro k hk
  apply mul_nonneg
  · exact mul_nonneg (Nat.cast_nonneg _) (hB k)
  · apply mul_nonneg
    · exact mul_nonneg (sq_nonneg _) (pow_nonneg (inv_nonneg.mpr hradius.le) _)
    · exact integral_nonneg fun ξ => norm_nonneg _

/-- The completely explicit, generally scale-dependent, localization
coefficient attached to the concrete high-order residual budget. -/
noncomputable def scaledRayCubePlusResidualLocalizationBudget
    (prototype : SchwartzMap (Euclidean 2) Complex) (scale width : Real)
    (B : Nat → Real) (N : Nat) : Real :=
  scaledRayCubePacketBudget (width * Real.sqrt scale)
    ((2 : Real) ^ N * ∑ n ∈ Finset.range (N + 1),
      scaledRayCubeResidualDerivativeBound prototype scale width B n)
    (scaledRayCubeResidualDerivativeBound prototype scale width B 0) N

/-- A literal matched plus-sheet scaled ray cube has arbitrary finite packet
decay on a compact time support.  Its coefficient is the displayed
`scaledRayCubePlusResidualLocalizationBudget`; no scale-uniform bound is
claimed here. -/
theorem exists_scaledRayCubeCutoff_plus_ray_localized_of_explicitHighOrderBounds
    (C : lpCutoffs 2) (j N : Nat)
    (χ prototype : SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (scale width T t₀ t₁ : Real) (direction : Euclidean 2)
    (hradius : 0 < width * Real.sqrt scale)
    (hprototype_cube : Function.support (prototype : Euclidean 2 → Complex) ⊆
      frequencyCube 0 1)
    (hprototype_ball : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (hT : 0 ≤ T) (hϑ : ∀ t, ‖ϑ t‖ ≤ T)
    (hϑ_support : ∀ t, ϑ t ≠ 0 → t ∈ Icc t₀ t₁)
    (hslab : ∀ t ∈ Icc t₀ t₁, |t| ≤ T) :
    ∃ (D : Real) (B : Nat → Real), 1 ≤ D ∧ (∀ n, 0 ≤ B n) ∧
      (∀ t, Function.support
        (angularDyadicCubeResidualSymbol C WaveSign.plus j t direction χ
          (scaledRayCubeCutoff prototype scale width direction hradius) :
          Euclidean 2 → Complex) ⊆
          frequencyCube (scale • direction) (width * Real.sqrt scale)) ∧
      (∀ z y, ‖angularDyadicCubeSpaceTimeKernel C WaveSign.plus j χ
        (scaledRayCubeCutoff prototype scale width direction hradius) ϑ z y‖ ≤
        (T * (2 : Real) ^ N *
          scaledRayCubePlusResidualLocalizationBudget prototype scale width B N) *
          lightRayKernel (width * Real.sqrt scale)⁻¹ N direction y z) := by
  obtain ⟨D, B, hD1, hB0, hbase⟩ :=
    exists_scaledRayCubeCutoff_plusResidualBaseDerivativeBounds
      C j N χ prototype scale width T direction hradius hprototype_ball hscale hunit hsmall hT
  let radius : Real := width * Real.sqrt scale
  let S : Real := (2 : Real) ^ N * ∑ n ∈ Finset.range (N + 1),
    scaledRayCubeResidualDerivativeBound prototype scale width B n
  let R₀ : Real := scaledRayCubeResidualDerivativeBound prototype scale width B 0
  let A : Real := scaledRayCubePacketBudget radius S R₀ N
  have hradius' : 0 < radius := by
    simpa [radius] using hradius
  have hS : 0 ≤ S := by
    dsimp [S]
    apply mul_nonneg
    · positivity
    · apply Finset.sum_nonneg
      intro n hn
      exact scaledRayCubeResidualDerivativeBound_nonneg
        prototype scale width hradius B hB0 n
  have hR₀ : 0 ≤ R₀ := by
    dsimp [R₀]
    exact scaledRayCubeResidualDerivativeBound_nonneg
      prototype scale width hradius B hB0 0
  have hA : 0 ≤ A := scaledRayCubePacketBudget_nonneg hradius' hS hR₀
  refine ⟨D, B, hD1, hB0, ?_⟩
  apply scaledRayCubeCutoff_ray_localized_of_residualBaseBounds_on_compactTimeSupport
    C WaveSign.plus j χ prototype ϑ scale width radius⁻¹ A T t₀ t₁ N direction
    hradius hprototype_cube (inv_pos.mpr hradius') hA hϑ hϑ_support B
  · intro t ht k hk ell hell ξ hξ
    exact hbase t (hslab t ht) k ell hk hξ
  · change S ≤ (A * (radius⁻¹)⁻¹ ^ 2) * (radius⁻¹) ^ N
    simpa only [inv_inv] using
      (le_scaledRayCubePacketBudget_high hradius' hR₀)
  · change R₀ ≤ A * (radius⁻¹)⁻¹ ^ 2
    simpa only [inv_inv] using
      (le_scaledRayCubePacketBudget_zero hradius' hS)

/-- The finite square function formed from a family of planar Fourier-cube
projections. -/
noncomputable def fourierCubeSquareFunction {ι : Type*} (cubes : Finset ι)
    (m : ι → SchwartzMap (Euclidean 2) Complex)
    (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Real :=
  fun x => Real.sqrt (∑ cube ∈ cubes, ‖fourierCubeProjection (m cube) f x‖ ^ 2)

/-- The finite Fourier-cube square function is pointwise nonnegative. -/
theorem fourierCubeSquareFunction_nonneg {ι : Type*} (cubes : Finset ι)
    (m : ι → SchwartzMap (Euclidean 2) Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    0 ≤ fourierCubeSquareFunction cubes m f x :=
  Real.sqrt_nonneg _

/-- Squaring and integrating the finite physical-space Fourier-cube square
function gives exactly the sum of the individual projection energies. -/
theorem integral_sq_fourierCubeSquareFunction_eq {ι : Type*} (cubes : Finset ι)
    (m : ι → SchwartzMap (Euclidean 2) Complex)
    (f : SchwartzMap (Euclidean 2) Complex) :
    (∫ x : Euclidean 2, fourierCubeSquareFunction cubes m f x ^ 2) =
      ∑ cube ∈ cubes, ∫ x : Euclidean 2,
        ‖fourierCubeProjection (m cube) f x‖ ^ 2 := by
  classical
  unfold fourierCubeSquareFunction
  calc
    (∫ x : Euclidean 2,
        (Real.sqrt (∑ cube ∈ cubes, ‖fourierCubeProjection (m cube) f x‖ ^ 2)) ^ 2) =
        ∫ x : Euclidean 2, ∑ cube ∈ cubes,
          ‖fourierCubeProjection (m cube) f x‖ ^ 2 := by
      apply integral_congr_ae
      filter_upwards with x
      rw [Real.sq_sqrt]
      exact Finset.sum_nonneg fun cube hcube => sq_nonneg _
    _ = ∑ cube ∈ cubes, ∫ x : Euclidean 2,
        ‖fourierCubeProjection (m cube) f x‖ ^ 2 := by
      rw [integral_finsetSum]
      intro cube hcube
      simpa only [fourierCubeProjection, SchwartzMap.fourier_coe] using
        (integrable_norm_sq_fourierInv_schwartz_multiplier (m cube) (𝓕 f))

/-- The exact frequency-side energy formula for a finite family of planar
Fourier-cube projections.  This is the finite `L²` square-function identity
underlying the cube step of the MSS argument. -/
theorem integral_sq_fourierCubeSquareFunction_eq_frequency {ι : Type*}
    (cubes : Finset ι) (m : ι → SchwartzMap (Euclidean 2) Complex)
    (f : SchwartzMap (Euclidean 2) Complex) :
    (∫ x : Euclidean 2, fourierCubeSquareFunction cubes m f x ^ 2) =
      ∫ ξ : Euclidean 2,
        (∑ cube ∈ cubes, ‖m cube ξ‖ ^ 2) *
          ‖𝓕 (f : Euclidean 2 → Complex) ξ‖ ^ 2 := by
  classical
  calc
    (∫ x : Euclidean 2, fourierCubeSquareFunction cubes m f x ^ 2) =
        ∑ cube ∈ cubes, ∫ x : Euclidean 2,
          ‖fourierCubeProjection (m cube) f x‖ ^ 2 :=
      integral_sq_fourierCubeSquareFunction_eq cubes m f
    _ = ∑ cube ∈ cubes, ∫ ξ : Euclidean 2,
        ‖m cube ξ * 𝓕 (f : Euclidean 2 → Complex) ξ‖ ^ 2 := by
      apply Finset.sum_congr rfl
      intro cube hcube
      simpa only [fourierCubeProjection, SchwartzMap.fourier_coe] using
        (integral_norm_sq_fourierInv_schwartz_multiplier_eq (m cube) (𝓕 f))
    _ = ∫ ξ : Euclidean 2, ∑ cube ∈ cubes,
        ‖m cube ξ * 𝓕 (f : Euclidean 2 → Complex) ξ‖ ^ 2 := by
      rw [integral_finsetSum]
      intro cube hcube
      let h : SchwartzMap (Euclidean 2) Complex :=
        SchwartzMap.smulLeftCLM Complex (m cube : Euclidean 2 → Complex) (𝓕 f)
      have hsq : Integrable (fun ξ : Euclidean 2 => ‖h ξ‖ ^ 2) volume :=
        (memLp_two_iff_integrable_sq_norm h.continuous.aestronglyMeasurable).mp
          (h.memLp 2 volume)
      simpa only [h, SchwartzMap.smulLeftCLM_apply (m cube).hasTemperateGrowth,
        smul_eq_mul, SchwartzMap.fourier_coe] using hsq
    _ = ∫ ξ : Euclidean 2,
        (∑ cube ∈ cubes, ‖m cube ξ‖ ^ 2) *
          ‖𝓕 (f : Euclidean 2 → Complex) ξ‖ ^ 2 := by
      apply integral_congr_ae
      filter_upwards with ξ
      simp only [norm_mul, mul_pow, Finset.sum_mul]

/-- The honest finite `L²` Fourier-cube square-function estimate.  The
constant is exactly the pointwise square overlap of the cutoff family; no
all-`p` Rubio de Francia assertion is being used here. -/
theorem integral_sq_fourierCubeSquareFunction_le_of_square_overlap {ι : Type*}
    (cubes : Finset ι) (m : ι → SchwartzMap (Euclidean 2) Complex)
    (f : SchwartzMap (Euclidean 2) Complex) {C : Real}
    (hoverlap : ∀ ξ : Euclidean 2, ∑ cube ∈ cubes, ‖m cube ξ‖ ^ 2 ≤ C) :
    (∫ x : Euclidean 2, fourierCubeSquareFunction cubes m f x ^ 2) ≤
      C * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  calc
    (∫ x : Euclidean 2, fourierCubeSquareFunction cubes m f x ^ 2) =
        ∑ cube ∈ cubes, ∫ x : Euclidean 2,
          ‖fourierCubeProjection (m cube) f x‖ ^ 2 :=
      integral_sq_fourierCubeSquareFunction_eq cubes m f
    _ ≤ C * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
      simpa only [fourierCubeProjection] using
        (sum_integral_norm_sq_fourierInv_schwartz_multipliers_le cubes m f hoverlap)

/-- The finite Rademacher-signed sum of a family of Fourier-cube
projections.  It is used below only for a conditional Khintchine reduction;
arbitrary translated cube families do not have a uniform bound for every
deterministic signing. -/
noncomputable def finiteRademacherFourierCubeSum {ι : Type*} [DecidableEq ι]
    (cubes signs : Finset ι) (m : ι → SchwartzMap (Euclidean 2) Complex)
    (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex :=
  fun x => rademacherSignedSum cubes signs
    (fun cube => fourierCubeProjection (m cube) f x)

/-- A deliberately strong uniform signed `L⁴` hypothesis for finite planar
Fourier-cube projections.  It is sufficient for the Rademacher reduction
below, but is not implied by separated/lattice cube geometry: arbitrary
deterministic signings can fail to be uniformly `L⁴` bounded.  It is not
asserted here for the MSS cubes. -/
def HasUniformFiniteRademacherFourierCubeL4 {ι : Type*} [DecidableEq ι]
    (m : ι → SchwartzMap (Euclidean 2) Complex) : Prop :=
  ∃ B : Real, 0 < B ∧ ∀ (cubes signs : Finset ι)
    (f : SchwartzMap (Euclidean 2) Complex), signs ∈ cubes.powerset →
      Integrable (fun x : Euclidean 2 =>
        ‖finiteRademacherFourierCubeSum cubes signs m f x‖ ^ (4 : Nat)) volume ∧
      (∫ x : Euclidean 2,
        ‖finiteRademacherFourierCubeSum cubes signs m f x‖ ^ (4 : Nat)) ≤
          B * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat)

/-- The averaged signed fourth-moment hypothesis for a finite family of
Fourier-cube projections. The finite sum is normalized by the number of
signings, so this asks for the Rademacher average rather than a bound for
every deterministic signing. It is not asserted here for any cube family. -/
def HasAverageFiniteRademacherFourierCubeL4 {ι : Type*} [DecidableEq ι]
    (m : ι → SchwartzMap (Euclidean 2) Complex) : Prop :=
  ∃ B : Real, 0 < B ∧ ∀ (cubes : Finset ι)
    (f : SchwartzMap (Euclidean 2) Complex),
      (∀ signs ∈ cubes.powerset,
        Integrable (fun x : Euclidean 2 =>
          ‖finiteRademacherFourierCubeSum cubes signs m f x‖ ^ (4 : Nat)) volume) ∧
      (∑ signs ∈ cubes.powerset,
        ∫ x : Euclidean 2,
          ‖finiteRademacherFourierCubeSum cubes signs m f x‖ ^ (4 : Nat)) ≤
        (cubes.powerset.card : Real) *
          (B * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat))

/-- The uniform finite-family `L⁴` square-function assertion for planar
Fourier-cube projections. -/
def uniformFiniteFourierCubeSquareFunctionL4 {ι : Type*} [DecidableEq ι]
    (m : ι → SchwartzMap (Euclidean 2) Complex) : Prop :=
  ∃ B : Real, 0 < B ∧ ∀ (cubes : Finset ι)
    (f : SchwartzMap (Euclidean 2) Complex),
      (∫ x : Euclidean 2, fourierCubeSquareFunction cubes m f x ^ (4 : Nat)) ≤
        B * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat)

/-- A uniform signed fourth-moment bound for a finite family of Fourier-cube
projections implies the corresponding fourth-moment square-function bound.

This is the finite Khintchine/Rademacher reduction only.  The supplied signed
estimate is a sufficient stronger hypothesis, not something inferred from
`L²` square overlap or expected for arbitrary translated cube families. -/
theorem integral_fourth_fourierCubeSquareFunction_le_of_uniform_signed
    {ι : Type*} [DecidableEq ι] (cubes : Finset ι)
    (m : ι → SchwartzMap (Euclidean 2) Complex)
    (f : SchwartzMap (Euclidean 2) Complex) {B : Real}
    (hsigned : ∀ signs ∈ cubes.powerset,
      Integrable (fun x : Euclidean 2 =>
        ‖finiteRademacherFourierCubeSum cubes signs m f x‖ ^ (4 : Nat)) volume ∧
      (∫ x : Euclidean 2,
        ‖finiteRademacherFourierCubeSum cubes signs m f x‖ ^ (4 : Nat)) ≤
          B * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat)) :
    (∫ x : Euclidean 2, fourierCubeSquareFunction cubes m f x ^ (4 : Nat)) ≤
      B * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat) := by
  classical
  let g : ι → Euclidean 2 → Complex := fun cube x =>
    fourierCubeProjection (m cube) f x
  have hsign : ∀ signs ∈ cubes.powerset,
      Integrable (fun x : Euclidean 2 =>
        ‖rademacherSignedSum cubes signs (fun cube => g cube x)‖ ^ (4 : Nat)) volume := by
    intro signs hsigns
    simpa only [g, finiteRademacherFourierCubeSum] using (hsigned signs hsigns).1
  have hmoment := integral_rademacherFourthMomentLower volume cubes g hsign
  have hsumBound :
      (∑ signs ∈ cubes.powerset,
        ∫ x : Euclidean 2,
          ‖rademacherSignedSum cubes signs (fun cube => g cube x)‖ ^ (4 : Nat)) ≤
        (cubes.powerset.card : Real) *
          (B * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat)) := by
    calc
      (∑ signs ∈ cubes.powerset,
        ∫ x : Euclidean 2,
          ‖rademacherSignedSum cubes signs (fun cube => g cube x)‖ ^ (4 : Nat)) ≤
          ∑ signs ∈ cubes.powerset,
            (B * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat)) := by
              apply Finset.sum_le_sum
              intro signs hsigns
              simpa only [g, finiteRademacherFourierCubeSum] using
                (hsigned signs hsigns).2
      _ = (cubes.powerset.card : Real) *
          (B * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat)) := by
            rw [Finset.sum_const]
            simp only [nsmul_eq_mul]
  have hcard : 0 < (cubes.powerset.card : Real) := by positivity
  have henergy :
      (∫ x : Euclidean 2, finiteSquareEnergy cubes g x ^ (2 : Nat)) ≤
        B * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat) := by
    apply le_of_mul_le_mul_left _ hcard
    exact hmoment.trans hsumBound
  calc
    (∫ x : Euclidean 2, fourierCubeSquareFunction cubes m f x ^ (4 : Nat)) =
        ∫ x : Euclidean 2, finiteSquareEnergy cubes g x ^ (2 : Nat) := by
          apply integral_congr_ae
          filter_upwards with x
          unfold fourierCubeSquareFunction finiteSquareEnergy
          have hnonneg : 0 ≤ ∑ cube ∈ cubes,
              ‖fourierCubeProjection (m cube) f x‖ ^ 2 :=
            Finset.sum_nonneg fun cube hcube => sq_nonneg _
          calc
            (Real.sqrt (∑ cube ∈ cubes,
                ‖fourierCubeProjection (m cube) f x‖ ^ 2)) ^ (4 : Nat) =
                (Real.sqrt (∑ cube ∈ cubes,
                  ‖fourierCubeProjection (m cube) f x‖ ^ 2) ^ 2) ^ 2 := by ring
            _ = (∑ cube ∈ cubes,
                ‖fourierCubeProjection (m cube) f x‖ ^ 2) ^ 2 := by
                  rw [Real.sq_sqrt hnonneg]
    _ ≤ B * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat) := henergy

/-- An averaged finite Rademacher fourth-moment estimate for a family of
Fourier-cube projections implies its fourth-moment square-function estimate.

The premise is deliberately the *average* over all signings.  This is a
Khintchine reduction, not an analytic proof that an arbitrary family of cube
multipliers has such an average bound. -/
theorem integral_fourth_fourierCubeSquareFunction_le_of_average
    {ι : Type*} [DecidableEq ι] (cubes : Finset ι)
    (m : ι → SchwartzMap (Euclidean 2) Complex)
    (f : SchwartzMap (Euclidean 2) Complex) {B : Real}
    (haverage :
      (∀ signs ∈ cubes.powerset,
        Integrable (fun x : Euclidean 2 =>
          ‖finiteRademacherFourierCubeSum cubes signs m f x‖ ^ (4 : Nat)) volume) ∧
      (∑ signs ∈ cubes.powerset,
        ∫ x : Euclidean 2,
          ‖finiteRademacherFourierCubeSum cubes signs m f x‖ ^ (4 : Nat)) ≤
        (cubes.powerset.card : Real) *
          (B * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat))) :
    (∫ x : Euclidean 2, fourierCubeSquareFunction cubes m f x ^ (4 : Nat)) ≤
      B * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat) := by
  classical
  let g : ι → Euclidean 2 → Complex := fun cube x =>
    fourierCubeProjection (m cube) f x
  have hsign : ∀ signs ∈ cubes.powerset,
      Integrable (fun x : Euclidean 2 =>
        ‖rademacherSignedSum cubes signs (fun cube => g cube x)‖ ^ (4 : Nat)) volume := by
    intro signs hsigns
    simpa only [g, finiteRademacherFourierCubeSum] using (haverage.1 signs hsigns)
  have hmoment := integral_rademacherFourthMomentLower volume cubes g hsign
  have hsumBound :
      (∑ signs ∈ cubes.powerset,
        ∫ x : Euclidean 2,
          ‖rademacherSignedSum cubes signs (fun cube => g cube x)‖ ^ (4 : Nat)) ≤
        (cubes.powerset.card : Real) *
          (B * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat)) := by
    simpa only [g, finiteRademacherFourierCubeSum] using haverage.2
  have hcard : 0 < (cubes.powerset.card : Real) := by positivity
  have henergy :
      (∫ x : Euclidean 2, finiteSquareEnergy cubes g x ^ (2 : Nat)) ≤
        B * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat) := by
    apply le_of_mul_le_mul_left _ hcard
    exact hmoment.trans hsumBound
  calc
    (∫ x : Euclidean 2, fourierCubeSquareFunction cubes m f x ^ (4 : Nat)) =
        ∫ x : Euclidean 2, finiteSquareEnergy cubes g x ^ (2 : Nat) := by
          apply integral_congr_ae
          filter_upwards with x
          unfold fourierCubeSquareFunction finiteSquareEnergy
          have hnonneg : 0 ≤ ∑ cube ∈ cubes,
              ‖fourierCubeProjection (m cube) f x‖ ^ 2 :=
            Finset.sum_nonneg fun cube hcube => sq_nonneg _
          calc
            (Real.sqrt (∑ cube ∈ cubes,
                ‖fourierCubeProjection (m cube) f x‖ ^ 2)) ^ (4 : Nat) =
                (Real.sqrt (∑ cube ∈ cubes,
                  ‖fourierCubeProjection (m cube) f x‖ ^ 2) ^ 2) ^ 2 := by ring
            _ = (∑ cube ∈ cubes,
                ‖fourierCubeProjection (m cube) f x‖ ^ 2) ^ 2 := by
                  rw [Real.sq_sqrt hnonneg]
    _ ≤ B * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat) := henergy

/-- Uniform signed `L⁴` Fourier-cube estimates imply the corresponding
uniform finite-family `L⁴` square-function estimate. -/
theorem uniformFiniteFourierCubeSquareFunctionL4_of_signed {ι : Type*}
    [DecidableEq ι] (m : ι → SchwartzMap (Euclidean 2) Complex)
    (hsigned : HasUniformFiniteRademacherFourierCubeL4 m) :
    uniformFiniteFourierCubeSquareFunctionL4 m := by
  rcases hsigned with ⟨B, hB, hsigned⟩
  refine ⟨B, hB, ?_⟩
  intro cubes f
  apply integral_fourth_fourierCubeSquareFunction_le_of_uniform_signed cubes m f
  intro signs hsigns
  exact hsigned cubes signs f hsigns

/-- Uniform averaged Rademacher `L⁴` estimates imply the corresponding
uniform finite-family fourth-moment Fourier-cube square-function estimate.
This records only the finite Khintchine reduction; it does not establish the
averaged hypothesis for the cube family. -/
theorem uniformFiniteFourierCubeSquareFunctionL4_of_average {ι : Type*}
    [DecidableEq ι] (m : ι → SchwartzMap (Euclidean 2) Complex)
    (haverage : HasAverageFiniteRademacherFourierCubeL4 m) :
    uniformFiniteFourierCubeSquareFunctionL4 m := by
  rcases haverage with ⟨B, hB, haverage⟩
  refine ⟨B, hB, ?_⟩
  intro cubes f
  exact integral_fourth_fourierCubeSquareFunction_le_of_average cubes m f
    (haverage cubes f)


end
