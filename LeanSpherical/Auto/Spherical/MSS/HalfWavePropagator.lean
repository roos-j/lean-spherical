theorem fixedTimePhysicalLInfinityEndpoint (C : lpCutoffs 2) (σ : WaveSign)
    (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex)
    {A : Real} (hfbound : ∀ x, ‖f x‖ ≤ A) (x : Euclidean 2) :
    ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤ A * dyadicHalfWaveKernelL1 C σ j t := by
  exact norm_dyadicHalfWave_le_kernelL1 C σ j t f hfbound x

/-- Scale-explicit form of the physical fixed-time endpoint.  This is an
exact reduction of the dyadic kernel bound to the level-zero kernel at time
`2^j t`; it does not assert a numerical oscillatory-kernel estimate. -/
theorem fixedTimePhysicalLInfinityEndpoint_scaled (C : lpCutoffs 2)
    (σ : WaveSign) (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex)
    {A : Real} (hfbound : ∀ x, ‖f x‖ ≤ A) (x : Euclidean 2) :
    ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
      A * dyadicHalfWaveKernelL1 C σ 0 ((2 : Real) ^ j * t) := by
  rw [← dyadicHalfWaveKernelL1_eq_levelZero_scaled]
  exact fixedTimePhysicalLInfinityEndpoint C σ j t f hfbound x

/-- Any explicit upper bound for the physical kernel `L¹` norm yields the
corresponding fixed-time physical `L∞` estimate. -/
theorem fixedTimePhysicalLInfinityEndpoint_of_kernelL1_le (C : lpCutoffs 2)
    (σ : WaveSign) (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex)
    {A B : Real} (hfbound : ∀ x, ‖f x‖ ≤ A)
    (hkernel : dyadicHalfWaveKernelL1 C σ j t ≤ B) (x : Euclidean 2) :
    ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤ A * B := by
  have hA : 0 ≤ A := le_trans (norm_nonneg (f 0)) (hfbound 0)
  calc
    ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤ A * dyadicHalfWaveKernelL1 C σ j t :=
      fixedTimePhysicalLInfinityEndpoint C σ j t f hfbound x
    _ ≤ A * B := mul_le_mul_of_nonneg_left hkernel hA

/-- The compact cutoff half-wave symbol has an integrable physical-space
kernel.  This is the qualitative kernel fact supplied directly by the
Schwartz calculus; obtaining a numerical bound on this norm over a time
range requires a separate oscillatory-kernel estimate. -/
theorem waveKernelL1 (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real) :
    Integrable (dyadicHalfWaveKernel C σ j t : Euclidean 2 → Complex) := by
  exact (dyadicHalfWaveKernel C σ j t).integrable

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- The inverse Fourier transform turns a frequency Laplacian into
multiplication by `-4 π² ‖x‖²` in the plane. -/
private theorem fourierInv_laplacian_eq_normSq_smul
    (q : SchwartzMap (Euclidean 2) Complex) :
    (𝓕⁻ (Laplacian.laplacian q) : SchwartzMap (Euclidean 2) Complex) =
        ((-(2 * Real.pi) ^ 2 : Real) : Complex) •
          (SchwartzMap.smulLeftCLM Complex
            (fun x : Euclidean 2 => ‖x‖ ^ 2)
            (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) := by
  classical
  let b := stdOrthonormalBasis Real (Euclidean 2)
  rw [SchwartzMap.laplacian_eq_sum b q]
  rw [fourierInv_sum]
  ext x
  change (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean 2) Complex)
      (Euclidean 2) Complex)
      (∑ i, 𝓕⁻ (LineDeriv.lineDerivOp (b i)
        (LineDeriv.lineDerivOp (b i) q))) x = _
  rw [map_sum, Finset.sum_apply]
  simp_rw [SchwartzMap.fourierInv_lineDerivOp_eq]
  have hsmul (a : Complex) (f : SchwartzMap (Euclidean 2) Complex) :
      (a • f) x = a * f x := by
    simp [smul_eq_mul]
  have hmul_inner (i : Fin (Module.finrank Real (Euclidean 2)))
      (f : SchwartzMap (Euclidean 2) Complex) :
      (SchwartzMap.smulLeftCLM Complex (fun y => inner Real y (b i)) f) x =
        ((inner Real x (b i) : Real) : Complex) * f x := by
    simpa [smul_eq_mul] using
      congrFun (SchwartzMap.smulLeftCLM_apply
        (show (fun y : Euclidean 2 => inner Real y (b i)).HasTemperateGrowth by fun_prop) f) x
  have hmul_norm (f : SchwartzMap (Euclidean 2) Complex) :
      (SchwartzMap.smulLeftCLM Complex
        (fun y : Euclidean 2 => ‖y‖ ^ 2) f) x =
        ((‖x‖ ^ 2 : Real) : Complex) * f x := by
    simpa [smul_eq_mul] using congrFun (SchwartzMap.smulLeftCLM_apply
      (show (fun y : Euclidean 2 => ‖y‖ ^ 2).HasTemperateGrowth by fun_prop) f) x
  change (∑ i, ((-(2 * ↑Real.pi * Complex.I) : Complex) •
      (SchwartzMap.smulLeftCLM Complex (fun y => inner Real y (b i))
        ((-(2 * ↑Real.pi * Complex.I) : Complex) •
          (SchwartzMap.smulLeftCLM Complex (fun y => inner Real y (b i))
            (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)))) :
        SchwartzMap (Euclidean 2) Complex) x) =
      (((-(2 * Real.pi) ^ 2 : Real) : Complex) •
        (SchwartzMap.smulLeftCLM Complex
          (fun y : Euclidean 2 => ‖y‖ ^ 2)
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex))) x
  simp_rw [hsmul]
  simp_rw [hmul_inner, hmul_norm]
  simp_rw [hsmul]
  simp_rw [hmul_inner]
  have hc : (-(2 * ↑Real.pi * Complex.I) : Complex) *
      (-(2 * ↑Real.pi * Complex.I) : Complex) =
      ((-(2 * Real.pi) ^ 2 : Real) : Complex) := by
    push_cast
    calc
      -(2 * ↑Real.pi * Complex.I) * -(2 * ↑Real.pi * Complex.I) =
          (2 * (Real.pi : Complex)) ^ 2 * (Complex.I * Complex.I) := by ring
      _ = -(2 * (Real.pi : Complex)) ^ 2 := by rw [Complex.I_mul_I]; ring
      _ = -(2 * ↑Real.pi) ^ 2 := by ring
  calc
    (∑ i, (-(2 * ↑Real.pi * Complex.I) : Complex) *
        (((inner Real x (b i) : Real) : Complex) *
          ((-(2 * ↑Real.pi * Complex.I) : Complex) *
            (((inner Real x (b i) : Real) : Complex) *
              (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x)))) =
        ∑ i, ((-(2 * Real.pi) ^ 2 : Real) : Complex) *
          ((inner Real x (b i) : Real) : Complex) ^ 2 *
            (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x := by
      apply Finset.sum_congr rfl
      intro i hi
      calc
        _ = ((-(2 * ↑Real.pi * Complex.I) : Complex) *
            (-(2 * ↑Real.pi * Complex.I) : Complex)) *
            ((inner Real x (b i) : Real) : Complex) ^ 2 *
              (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x := by ring
        _ = _ := by rw [hc]
    _ = ((-(2 * Real.pi) ^ 2 : Real) : Complex) *
        (∑ i, ((inner Real x (b i) : Real) : Complex) ^ 2) *
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x := by
      rw [Finset.mul_sum, Finset.sum_mul]
    _ = ((-(2 * Real.pi) ^ 2 : Real) : Complex) *
        (((‖x‖ ^ 2 : Real) : Complex) *
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x) := by
      rw [show ∑ i, ((inner Real x (b i) : Real) : Complex) ^ 2 =
        ((‖x‖ ^ 2 : Real) : Complex) by
          norm_cast
          exact b.sum_sq_inner_left x]
      ring

/-- The exact Fourier identity behind the quadratic distance-to-cone weight.
The phase-specific argument only has to bound the cancelled frequency symbol
on the left. -/
theorem fourierInv_cancelled_laplacian_eq_cone_quadratic
    (q : SchwartzMap (Euclidean 2) Complex) (s : Real) :
    (𝓕⁻ (-Laplacian.laplacian q -
        (((2 * Real.pi * s) ^ 2 : Real) : Complex) • q) :
        SchwartzMap (Euclidean 2) Complex) =
      (((2 * Real.pi) ^ 2 : Real) : Complex) •
        (SchwartzMap.smulLeftCLM Complex
          (fun x : Euclidean 2 => ‖x‖ ^ 2 - s ^ 2)
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) := by
  rw [sub_eq_add_neg, fourierInv_add, fourierInv_neg, fourierInv_neg,
    fourierInv_smul, fourierInv_laplacian_eq_normSq_smul]
  ext x
  have hsmul (a : Complex) (f : SchwartzMap (Euclidean 2) Complex) :
      (a • f) x = a * f x := by
    simp [smul_eq_mul]
  have hmul_norm (f : SchwartzMap (Euclidean 2) Complex) :
      (SchwartzMap.smulLeftCLM Complex
        (fun y : Euclidean 2 => ‖y‖ ^ 2) f) x =
        ((‖x‖ ^ 2 : Real) : Complex) * f x := by
    simpa [smul_eq_mul] using congrFun (SchwartzMap.smulLeftCLM_apply
      (show (fun y : Euclidean 2 => ‖y‖ ^ 2).HasTemperateGrowth by fun_prop) f) x
  have hmul_cone (f : SchwartzMap (Euclidean 2) Complex) :
      (SchwartzMap.smulLeftCLM Complex
        (fun y : Euclidean 2 => ‖y‖ ^ 2 - s ^ 2) f) x =
        ((‖x‖ ^ 2 - s ^ 2 : Real) : Complex) * f x := by
    simpa [smul_eq_mul] using congrFun (SchwartzMap.smulLeftCLM_apply
      (show (fun y : Euclidean 2 => ‖y‖ ^ 2 - s ^ 2).HasTemperateGrowth by fun_prop) f) x
  change (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean 2) Complex)
      (Euclidean 2) Complex)
      (-((( -(2 * Real.pi) ^ 2 : Real) : Complex) •
          (SchwartzMap.smulLeftCLM Complex (fun y : Euclidean 2 => ‖y‖ ^ 2)
            (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex))) +
        -((((2 * Real.pi * s) ^ 2 : Real) : Complex) •
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex))) x = _
  rw [map_add, map_neg, map_neg]
  simp only [Pi.add_apply, Pi.neg_apply]
  change
    -(((-(2 * Real.pi) ^ 2 : Real) : Complex) •
        (SchwartzMap.smulLeftCLM Complex (fun y : Euclidean 2 => ‖y‖ ^ 2)
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex))) x +
      -((((2 * Real.pi * s) ^ 2 : Real) : Complex) •
        (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) x =
      (((2 * Real.pi) ^ 2 : Real) : Complex) *
        (SchwartzMap.smulLeftCLM Complex
          (fun y : Euclidean 2 => ‖y‖ ^ 2 - s ^ 2)
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) x
  rw [hsmul, hsmul]
  rw [hmul_norm, hmul_cone]
  push_cast
  ring

/-- The quadratic weight measuring distance to the planar wave cone at time
`s`.  Dividing the radial discrepancy `‖x‖² - s²` by `s` makes the resulting
reciprocal weight have mass of order `s`. -/
def coneWeight (s : Real) (x : Euclidean 2) : Real :=
  1 + ((‖x‖ ^ 2 - s ^ 2) / s) ^ 2

/-- The reciprocal of the planar wave-cone weight. -/
def coneReciprocal (s : Real) (x : Euclidean 2) : Real :=
  (coneWeight s x)⁻¹

/-- The planar cone weight is strictly positive, including at `s = 0`. -/
theorem coneWeight_pos (s : Real) (x : Euclidean 2) : 0 < coneWeight s x := by
  unfold coneWeight
  positivity

private theorem integrable_radius_coneReciprocal (s : Real) (hs : 0 < s) :
    IntegrableOn (fun r : Real => r * (1 + ((r ^ 2 - s ^ 2) / s) ^ 2)⁻¹) (Ioi 0) := by
  let g : Real → Real := fun u => (1 + u ^ 2)⁻¹
  let q : Real → Real := fun u => g ((u - s ^ 2) / s)
  have hg : Integrable g := by
    simpa only [g] using integrable_inv_one_add_sq
  have hq : Integrable q := by
    have hshift : Integrable (fun u : Real => g (u - s)) := hg.comp_sub_right s
    have hscale : Integrable (fun u : Real => g ((s : Real)⁻¹ * u - s)) := by
      exact (MeasureTheory.integrable_comp_mul_left_iff
        (fun u : Real => g (u - s)) (inv_ne_zero hs.ne')).mpr hshift
    refine hscale.congr ?_
    filter_upwards with u
    dsimp only [q]
    congr 1
    field_simp [hs.ne']
  have hqIoi : IntegrableOn q (Ioi 0) := hq.integrableOn
  have hqSquareIoi : IntegrableOn (fun r : Real => r * q (r ^ 2)) (Ioi 0) := by
    have h := (integrableOn_Ioi_comp_rpow_iff' q (by norm_num : (2 : Real) ≠ 0)).mpr hqIoi
    norm_num at h
    simpa only [smul_eq_mul, one_mul] using h
  refine hqSquareIoi.congr ?_
  filter_upwards with r
  rfl

/-- The radial integral of the reciprocal wave-cone weight is an elementary
one-dimensional Cauchy profile. -/
theorem integral_radius_coneReciprocal (s : Real) (hs : 0 < s) :
    (∫ r : Real in Ioi 0, r * (1 + ((r ^ 2 - s ^ 2) / s) ^ 2)⁻¹) =
      (s / 2) * (∫ u : Real in Ioi (-s), (1 + u ^ 2)⁻¹) := by
  let g : Real → Real := fun u => (1 + u ^ 2)⁻¹
  let f : Real → Real := fun r => (r ^ 2 - s ^ 2) / s
  let f' : Real → Real := fun r => (2 * r) / s
  let q : Real → Real := fun u => g ((u - s ^ 2) / s)
  have hg : Integrable g := by
    simpa only [g] using integrable_inv_one_add_sq
  have hq : Integrable q := by
    have hshift : Integrable (fun u : Real => g (u - s)) := hg.comp_sub_right s
    have hscale : Integrable (fun u : Real => g ((s : Real)⁻¹ * u - s)) := by
      exact (MeasureTheory.integrable_comp_mul_left_iff
        (fun u : Real => g (u - s)) (inv_ne_zero hs.ne')).mpr hshift
    refine hscale.congr ?_
    filter_upwards with u
    dsimp only [q]
    congr 1
    field_simp [hs.ne']
  have hqIoi : IntegrableOn q (Ioi 0) := hq.integrableOn
  have hqSquareIoi : IntegrableOn (fun r : Real => r * q (r ^ 2)) (Ioi 0) := by
    have h := (integrableOn_Ioi_comp_rpow_iff' q (by norm_num : (2 : Real) ≠ 0)).mpr hqIoi
    norm_num at h
    simpa only [smul_eq_mul, one_mul] using h
  have hqSquareIci : IntegrableOn (fun r : Real => r * q (r ^ 2)) (Ici 0) :=
    (integrableOn_Ici_iff_integrableOn_Ioi).mpr hqSquareIoi
  have hcomp : IntegrableOn (fun r : Real => (g ∘ f) r * f' r) (Ici 0) := by
    have h := hqSquareIci.const_mul (2 / s)
    refine h.congr ?_
    filter_upwards with r
    dsimp only [f, f', q, Function.comp_apply]
    field_simp [hs.ne']
  have hfcont : Continuous f := by
    dsimp only [f]
    fun_prop
  have hftend : Tendsto f atTop atTop := by
    apply tendsto_atTop.2
    intro b
    filter_upwards [eventually_ge_atTop (max 1 (s * b + s ^ 2))] with r hr
    have hrone : 1 ≤ r := (le_max_left _ _).trans hr
    have hrlin : r ≤ r ^ 2 := by nlinarith
    have hbound : s * b + s ^ 2 ≤ r ^ 2 :=
      (le_max_right _ _).trans (hr.trans hrlin)
    dsimp only [f]
    apply (le_div_iff₀ hs).mpr
    nlinarith
  have hfderiv : ∀ r ∈ Ioi (0 : Real), HasDerivWithinAt f (f' r) (Ioi r) r := by
    intro r hr
    have hpow : HasDerivAt (fun x : Real => x ^ 2) (2 * r) r := by
      simpa using! (hasDerivAt_id r).pow 2
    simpa only [f, f'] using ((hpow.sub_const (s ^ 2)).div_const s).hasDerivWithinAt
  have hgcont : Continuous g := by
    dsimp only [g]
    apply Continuous.inv₀
    · fun_prop
    · intro u
      positivity
  have hchange := integral_comp_mul_deriv_Ioi
    (f := f) (f' := f') (g := g) (a := (0 : Real)) hfcont.continuousOn hftend hfderiv
      hgcont.continuousOn hg.integrableOn hcomp
  have hfactor : (fun r : Real => r * (1 + ((r ^ 2 - s ^ 2) / s) ^ 2)⁻¹) =
      fun r => (s / 2) * ((g ∘ f) r * f' r) := by
    funext r
    dsimp only [f, f', g, Function.comp_apply]
    field_simp [hs.ne']
  have hfzero : f 0 = -s := by
    dsimp only [f]
    field_simp [hs.ne']
    ring
  rw [hfactor, integral_const_mul, hchange, hfzero]

/-- The reciprocal planar wave-cone weight is integrable for positive time. -/
theorem integrable_coneReciprocal (s : Real) (hs : 0 < s) :
    Integrable (fun x : Euclidean 2 => coneReciprocal s x) := by
  let w : Real → Real := fun r => (1 + ((r ^ 2 - s ^ 2) / s) ^ 2)⁻¹
  have hrewrite : (fun x : Euclidean 2 => coneReciprocal s x) =
      fun x => w ‖x‖ := rfl
  rw [hrewrite]
  rw [integrable_fun_norm_addHaar (E := Euclidean 2)
    (μ := (volume : Measure (Euclidean 2)))]
  norm_num [finrank_euclideanSpace_fin, smul_eq_mul]
  exact integrable_radius_coneReciprocal s hs

/-- The total mass of the reciprocal planar wave-cone weight is `O(s)`. -/
theorem integral_coneReciprocal_le (s : Real) (hs : 0 < s) :
    (∫ x : Euclidean 2, coneReciprocal s x) ≤
      (volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s := by
  have hrad := integral_fun_norm_addHaar (E := Euclidean 2)
    (μ := (volume : Measure (Euclidean 2)))
    (fun r : Real => (1 + ((r ^ 2 - s ^ 2) / s) ^ 2)⁻¹)
  have hrewrite : (fun x : Euclidean 2 => coneReciprocal s x) =
      fun x => (1 + ((‖x‖ ^ 2 - s ^ 2) / s) ^ 2)⁻¹ := rfl
  rw [hrewrite]
  have hmeasure : 0 ≤ volume.real (Metric.ball (0 : Euclidean 2) 1) :=
    MeasureTheory.measureReal_nonneg
  have hpi : 0 ≤ Real.pi := Real.pi_pos.le
  have hI : (∫ u : Real in Ioi (-s), (1 + u ^ 2)⁻¹) ≤ Real.pi := by
    rw [integral_Ioi_inv_one_add_sq, Real.arctan_neg]
    linarith [Real.arctan_lt_pi_div_two s]
  have hradius := integral_radius_coneReciprocal s hs
  norm_num [finrank_euclideanSpace_fin, smul_eq_mul] at hrad
  rw [hradius] at hrad
  rw [hrad]
  calc
    2 * (volume.real (Metric.ball (0 : Euclidean 2) 1) *
        ((s / 2) * ∫ u : Real in Ioi (-s), (1 + u ^ 2)⁻¹)) ≤
      2 * (volume.real (Metric.ball (0 : Euclidean 2) 1) *
        ((s / 2) * Real.pi)) := by
      gcongr
    _ = (volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s := by
      ring

private theorem weighted_cauchy_schwarz
    (K : Euclidean 2 → Complex) (w : Euclidean 2 → Real)
    (hwpos : ∀ x, 0 < w x)
    (henergy : Integrable (fun x => w x * ‖K x‖ ^ 2))
    (hinv : Integrable (fun x => (w x)⁻¹)) :
    (∫ x : Euclidean 2, ‖K x‖) ≤
      (∫ x : Euclidean 2, w x * ‖K x‖ ^ 2) ^ ((2 : Real)⁻¹) *
        (∫ x : Euclidean 2, (w x)⁻¹) ^ ((2 : Real)⁻¹) := by
  let F : Euclidean 2 → Real := fun x => Real.sqrt (w x * ‖K x‖ ^ 2)
  let G : Euclidean 2 → Real := fun x => Real.sqrt ((w x)⁻¹)
  have hFmeas : AEStronglyMeasurable F volume := by
    exact Real.continuous_sqrt.comp_aestronglyMeasurable henergy.aestronglyMeasurable
  have hGmeas : AEStronglyMeasurable G volume := by
    exact Real.continuous_sqrt.comp_aestronglyMeasurable hinv.aestronglyMeasurable
  have hFsq : Integrable (fun x => F x ^ 2) := by
    refine henergy.congr ?_
    filter_upwards with x
    dsimp only [F]
    exact (Real.sq_sqrt (mul_nonneg (hwpos x).le (sq_nonneg _))).symm
  have hGsq : Integrable (fun x => G x ^ 2) := by
    refine hinv.congr ?_
    filter_upwards with x
    dsimp only [G]
    exact (Real.sq_sqrt (inv_nonneg.mpr (hwpos x).le)).symm
  have hFmem : MemLp F 2 volume :=
    (memLp_two_iff_integrable_sq hFmeas).mpr hFsq
  have hGmem : MemLp G 2 volume :=
    (memLp_two_iff_integrable_sq hGmeas).mpr hGsq
  have hFmem' : MemLp F (ENNReal.ofReal 2) volume := by
    norm_num
    exact hFmem
  have hGmem' : MemLp G (ENNReal.ofReal 2) volume := by
    norm_num
    exact hGmem
  have hholder := integral_mul_le_Lp_mul_Lq_of_nonneg (f := F) (g := G)
    Real.HolderConjugate.two_two
    (Eventually.of_forall fun x => Real.sqrt_nonneg _)
    (Eventually.of_forall fun x => Real.sqrt_nonneg _) hFmem' hGmem'
  have hleft : (fun x : Euclidean 2 => ‖K x‖) = fun x => F x * G x := by
    funext x
    dsimp only [F, G]
    have hroot : Real.sqrt (w x) ≠ 0 := ne_of_gt (Real.sqrt_pos.2 (hwpos x))
    symm
    calc
      Real.sqrt (w x * ‖K x‖ ^ 2) * Real.sqrt ((w x)⁻¹) =
          (Real.sqrt (w x) * Real.sqrt (‖K x‖ ^ 2)) * (Real.sqrt (w x))⁻¹ := by
        rw [Real.sqrt_mul (hwpos x).le, Real.sqrt_inv]
      _ = ‖K x‖ := by
        rw [Real.sqrt_sq (norm_nonneg _)]
        field_simp
  have hFint : (∫ x : Euclidean 2, F x ^ 2) =
      ∫ x : Euclidean 2, w x * ‖K x‖ ^ 2 := by
    apply integral_congr_ae
    filter_upwards with x
    dsimp only [F]
    exact Real.sq_sqrt (mul_nonneg (hwpos x).le (sq_nonneg _))
  have hGint : (∫ x : Euclidean 2, G x ^ 2) =
      ∫ x : Euclidean 2, (w x)⁻¹ := by
    apply integral_congr_ae
    filter_upwards with x
    dsimp only [G]
    exact Real.sq_sqrt (inv_nonneg.mpr (hwpos x).le)
  calc
    (∫ x : Euclidean 2, ‖K x‖) = ∫ x : Euclidean 2, F x * G x := by rw [hleft]
    _ ≤ (∫ x : Euclidean 2, F x ^ (2 : Real)) ^ (1 / (2 : Real)) *
        (∫ x : Euclidean 2, G x ^ (2 : Real)) ^ (1 / (2 : Real)) := hholder
    _ = (∫ x : Euclidean 2, w x * ‖K x‖ ^ 2) ^ ((2 : Real)⁻¹) *
        (∫ x : Euclidean 2, (w x)⁻¹) ^ ((2 : Real)⁻¹) := by
      rw [show (fun x : Euclidean 2 => F x ^ (2 : Real)) = fun x => F x ^ 2 by
        funext x
        rw [Real.rpow_two],
        show (fun x : Euclidean 2 => G x ^ (2 : Real)) = fun x => G x ^ 2 by
        funext x
        rw [Real.rpow_two], hFint, hGint]
      ring_nf

/-- A conditional weighted-`L²` estimate implies the planar wave-kernel
`L¹` bound needed for the sharp half-wave endpoint.  The only hypothesis is
integrability of the cone-weighted energy; the Fourier-side cancellation is
supplied separately. -/
theorem integral_norm_le_coneWeightedEnergy
    (K : Euclidean 2 → Complex) (s : Real) (hs : 0 < s)
    (henergy : Integrable (fun x => coneWeight s x * ‖K x‖ ^ 2)) :
    (∫ x : Euclidean 2, ‖K x‖) ≤
      (∫ x : Euclidean 2, coneWeight s x * ‖K x‖ ^ 2) ^ ((2 : Real)⁻¹) *
        ((volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s) ^ ((2 : Real)⁻¹) := by
  have hinv : Integrable (fun x : Euclidean 2 => (coneWeight s x)⁻¹) := by
    simpa only [coneReciprocal] using integrable_coneReciprocal s hs
  have hcs := weighted_cauchy_schwarz K (coneWeight s) (coneWeight_pos s) henergy hinv
  calc
    (∫ x : Euclidean 2, ‖K x‖) ≤
        (∫ x : Euclidean 2, coneWeight s x * ‖K x‖ ^ 2) ^ ((2 : Real)⁻¹) *
          (∫ x : Euclidean 2, (coneWeight s x)⁻¹) ^ ((2 : Real)⁻¹) := hcs
    _ ≤ (∫ x : Euclidean 2, coneWeight s x * ‖K x‖ ^ 2) ^ ((2 : Real)⁻¹) *
        ((volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s) ^ ((2 : Real)⁻¹) := by
      apply mul_le_mul_of_nonneg_left
      · apply Real.rpow_le_rpow
        · exact integral_nonneg fun x => inv_nonneg.mpr (coneWeight_pos s x).le
        · simpa only [coneReciprocal] using integral_coneReciprocal_le s hs
        · positivity
      · exact Real.rpow_nonneg
          (integral_nonneg fun x => mul_nonneg (coneWeight_pos s x).le (sq_nonneg _)) _

/-- The frequency-space wave operator whose leading `s²` contribution is
cancelled by the half-wave phase. -/
def cancelledWaveLaplacian
    (q : SchwartzMap (Euclidean 2) Complex) (s : Real) :
    SchwartzMap (Euclidean 2) Complex :=
  -Laplacian.laplacian q - (((2 * Real.pi * s) ^ 2 : Real) : Complex) • q

private def radialPhase (a : Real) : Euclidean 2 → Complex :=
  fun x => Complex.exp (((a * ‖x‖ : Real) : Complex) * Complex.I)

private def radialPhaseCoeff (a : Real) (x v : Euclidean 2) : Complex :=
  (((a * ‖x‖⁻¹ * inner Real x v : Real) : Complex) * Complex.I)

private def radialLaplacianCoeff (a : Real) (x : Euclidean 2) : Complex :=
  (((a * ‖x‖⁻¹ : Real) : Complex) * Complex.I)

private theorem radial_phase_laplacian_mul_cancelled
    (chi : Euclidean 2 → Complex) (a b : Real) (x : Euclidean 2)
    (hx : x ≠ 0) (hchi : ContDiffAt Real 2 chi x) (hsq : a ^ 2 = b ^ 2) :
    -Laplacian.laplacian (fun y => radialPhase a y * chi y) x -
        ((b ^ 2 : Real) : Complex) * (radialPhase a x * chi x) =
      -radialPhase a x *
        (Laplacian.laplacian chi x +
          (∑ i, (radialPhaseCoeff a x (stdOrthonormalBasis Real (Euclidean 2) i) *
                fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) +
            fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) *
              radialPhaseCoeff a x (stdOrthonormalBasis Real (Euclidean 2) i))) +
          radialLaplacianCoeff a x * chi x) := by
  have hphase : ContDiffAt Real 2 (radialPhase a) x := by
    have hnorm : ContDiffAt Real 2 (fun y : Euclidean 2 => ‖y‖) x :=
      contDiffAt_norm Real hx
    have hreal : ContDiffAt Real 2 (fun y : Euclidean 2 => a * ‖y‖) x := by
      fun_prop
    have hcomplex : ContDiffAt Real 2
        (fun y : Euclidean 2 => ((a * ‖y‖ : Real) : Complex)) x := by
      exact Complex.ofRealCLM.contDiff.contDiffAt.comp x hreal
    exact (hcomplex.mul contDiffAt_const).cexp
  rw [laplacian_mul_at (radialPhase a) chi hphase hchi]
  rw [show Laplacian.laplacian (radialPhase a) x =
      radialPhase a x * (-((a ^ 2 : Real) : Complex) +
        radialLaplacianCoeff a x) by
    change Laplacian.laplacian (fun y : Euclidean 2 =>
      Complex.exp (((a * ‖y‖ : Real) : Complex) * Complex.I)) x =
        Complex.exp (((a * ‖x‖ : Real) : Complex) * Complex.I) *
          (-((a ^ 2 : Real) : Complex) +
            (((a * ‖x‖⁻¹ : Real) : Complex) * Complex.I))
    exact laplacian_radial_phase_eq a x hx]
  simp_rw [show ∀ i,
      fderiv Real (radialPhase a) x (stdOrthonormalBasis Real (Euclidean 2) i) =
        radialPhase a x *
          radialPhaseCoeff a x (stdOrthonormalBasis Real (Euclidean 2) i) by
      intro i
      change fderiv Real (fun y : Euclidean 2 =>
        Complex.exp (((a * ‖y‖ : Real) : Complex) * Complex.I)) x
          (stdOrthonormalBasis Real (Euclidean 2) i) =
        Complex.exp (((a * ‖x‖ : Real) : Complex) * Complex.I) *
          (((a * ‖x‖⁻¹ *
            inner Real x (stdOrthonormalBasis Real (Euclidean 2) i) : Real) : Complex) *
              Complex.I)
      exact fderiv_radial_phase_apply a x
        (stdOrthonormalBasis Real (Euclidean 2) i) hx]
  have hcross : ∀ i,
      radialPhase a x * radialPhaseCoeff a x (stdOrthonormalBasis Real (Euclidean 2) i) *
          fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) +
        fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) *
          (radialPhase a x * radialPhaseCoeff a x (stdOrthonormalBasis Real (Euclidean 2) i)) =
        radialPhase a x *
          (radialPhaseCoeff a x (stdOrthonormalBasis Real (Euclidean 2) i) *
            fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) +
          fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) *
            radialPhaseCoeff a x (stdOrthonormalBasis Real (Euclidean 2) i)) := by
    intro i
    ring
  simp_rw [hcross]
  rw [← Finset.mul_sum]
  have hsqC : (a : Complex) ^ 2 = (b : Complex) ^ 2 := by
    exact_mod_cast hsq
  push_cast
  rw [hsqC]
  ring

private def halfWavePhaseParameter (σ : WaveSign) (s : Real) : Real :=
  σ.toReal * (2 * Real.pi) * s

private def levelZeroCutoff (C : lpCutoffs 2) : Euclidean 2 → Complex :=
  dyadicBandpassMultiplier C.cutoff 0

private def levelZeroCutoffLaplacian (C : lpCutoffs 2) : Euclidean 2 → Complex :=
  Laplacian.laplacian (levelZeroCutoff C)

private def levelZeroRadialCutoffTerm (C : lpCutoffs 2) (σ : WaveSign) :
    Euclidean 2 → Complex := fun x =>
  (∑ i, (radialPhaseCoeff (halfWavePhaseParameter σ 1) x
        (stdOrthonormalBasis Real (Euclidean 2) i) *
      fderiv Real (levelZeroCutoff C) x
        (stdOrthonormalBasis Real (Euclidean 2) i) +
    fderiv Real (levelZeroCutoff C) x
        (stdOrthonormalBasis Real (Euclidean 2) i) *
      radialPhaseCoeff (halfWavePhaseParameter σ 1) x
        (stdOrthonormalBasis Real (Euclidean 2) i))) +
    radialLaplacianCoeff (halfWavePhaseParameter σ 1) x * levelZeroCutoff C x

private theorem halfWaveMultiplier_eq_radialPhase (σ : WaveSign) (s : Real) :
    halfWaveMultiplier σ s = radialPhase (halfWavePhaseParameter σ s) := by
  rfl

private theorem levelZeroCutoff_contDiffAt (C : lpCutoffs 2) (x : Euclidean 2) :
    ContDiffAt Real 2 (levelZeroCutoff C) x := by
  exact (dyadicBandpassMultiplier C.cutoff 0).smooth 2 |>.contDiffAt

private theorem phase_parameter_sq (σ : WaveSign) (s : Real) :
    (halfWavePhaseParameter σ s) ^ 2 = (2 * Real.pi * s) ^ 2 := by
  cases σ <;> simp [halfWavePhaseParameter, WaveSign.toReal]

private theorem radialPhaseCoeff_scale (σ : WaveSign) (s : Real) (x v : Euclidean 2) :
    radialPhaseCoeff (halfWavePhaseParameter σ s) x v =
      s * radialPhaseCoeff (halfWavePhaseParameter σ 1) x v := by
  simp only [radialPhaseCoeff, halfWavePhaseParameter]
  push_cast
  ring

private theorem radialLaplacianCoeff_scale (σ : WaveSign) (s : Real) (x : Euclidean 2) :
    radialLaplacianCoeff (halfWavePhaseParameter σ s) x =
      s * radialLaplacianCoeff (halfWavePhaseParameter σ 1) x := by
  simp only [radialLaplacianCoeff, halfWavePhaseParameter]
  push_cast
  ring

private theorem cancelled_levelZero_phase_formula
    (C : lpCutoffs 2) (σ : WaveSign) (s : Real) (x : Euclidean 2) (hx : x ≠ 0) :
    cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s x =
      -halfWaveMultiplier σ s x *
        (levelZeroCutoffLaplacian C x + s * levelZeroRadialCutoffTerm C σ x) := by
  have hfun : (dyadicHalfWaveSchwartzSymbol C σ 0 s : Euclidean 2 → Complex) =
      fun y => radialPhase (halfWavePhaseParameter σ s) y * levelZeroCutoff C y := by
    funext y
    rw [dyadicHalfWaveSchwartzSymbol_apply]
    rfl
  rw [cancelledWaveLaplacian]
  simp only [sub_apply, neg_apply, smul_apply,
    SchwartzMap.laplacian_apply, smul_eq_mul]
  change -Laplacian.laplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s :
      Euclidean 2 → Complex) x -
      (((2 * Real.pi * s) ^ 2 : Real) : Complex) *
        dyadicHalfWaveSchwartzSymbol C σ 0 s x = _
  rw [hfun]
  rw [radial_phase_laplacian_mul_cancelled (levelZeroCutoff C)
    (halfWavePhaseParameter σ s) (2 * Real.pi * s) x hx
    (levelZeroCutoff_contDiffAt C x) (phase_parameter_sq σ s)]
  rw [← halfWaveMultiplier_eq_radialPhase]
  simp only [levelZeroCutoffLaplacian, levelZeroRadialCutoffTerm]
  have hsum : (∑ i, (radialPhaseCoeff (halfWavePhaseParameter σ s) x
          (stdOrthonormalBasis Real (Euclidean 2) i) *
        fderiv Real (levelZeroCutoff C) x
          (stdOrthonormalBasis Real (Euclidean 2) i) +
      fderiv Real (levelZeroCutoff C) x
          (stdOrthonormalBasis Real (Euclidean 2) i) *
        radialPhaseCoeff (halfWavePhaseParameter σ s) x
          (stdOrthonormalBasis Real (Euclidean 2) i))) =
        s * (∑ i,
          (radialPhaseCoeff (halfWavePhaseParameter σ 1) x
            (stdOrthonormalBasis Real (Euclidean 2) i) *
            fderiv Real (levelZeroCutoff C) x
              (stdOrthonormalBasis Real (Euclidean 2) i) +
          fderiv Real (levelZeroCutoff C) x
            (stdOrthonormalBasis Real (Euclidean 2) i) *
            radialPhaseCoeff (halfWavePhaseParameter σ 1) x
              (stdOrthonormalBasis Real (Euclidean 2) i))) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    rw [radialPhaseCoeff_scale]
    ring
  have hradial : radialLaplacianCoeff (halfWavePhaseParameter σ s) x *
      levelZeroCutoff C x =
      s * (radialLaplacianCoeff (halfWavePhaseParameter σ 1) x *
        levelZeroCutoff C x) := by
    rw [radialLaplacianCoeff_scale]
    ring
  rw [hsum, hradial]
  ring

private theorem halfWaveMultiplier_neg_one_mul_one
    (σ : WaveSign) (x : Euclidean 2) :
    halfWaveMultiplier σ (-1) x * halfWaveMultiplier σ 1 x = 1 := by
  rw [← halfWaveMultiplier_add]
  norm_num [halfWaveMultiplier_zero]

private theorem cancelled_levelZero_phase_affine
    (C : lpCutoffs 2) (σ : WaveSign) (s : Real) (x : Euclidean 2) (hx : x ≠ 0) :
    cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s x =
      halfWaveMultiplier σ s x *
        (cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 0) 0 x +
          s * (halfWaveMultiplier σ (-1) x *
              cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 1) 1 x -
            cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 0) 0 x)) := by
  rw [cancelled_levelZero_phase_formula C σ s x hx,
    cancelled_levelZero_phase_formula C σ 0 x hx,
    cancelled_levelZero_phase_formula C σ 1 x hx]
  rw [halfWaveMultiplier_zero]
  have hinv : halfWaveMultiplier σ (-1) x * halfWaveMultiplier σ 1 x = 1 :=
    halfWaveMultiplier_neg_one_mul_one σ x
  have hdephase : halfWaveMultiplier σ (-1) x *
      (halfWaveMultiplier σ 1 x *
        (levelZeroCutoffLaplacian C x + levelZeroRadialCutoffTerm C σ x)) =
      levelZeroCutoffLaplacian C x + levelZeroRadialCutoffTerm C σ x := by
    calc
      _ = (halfWaveMultiplier σ (-1) x * halfWaveMultiplier σ 1 x) *
          (levelZeroCutoffLaplacian C x + levelZeroRadialCutoffTerm C σ x) := by ring
      _ = (1 : Complex) *
          (levelZeroCutoffLaplacian C x + levelZeroRadialCutoffTerm C σ x) := by rw [hinv]
      _ = _ := by ring
  norm_num
  rw [hdephase]
  ring

private theorem integral_norm_sq_phase_affine_le
    (r r0 r1 A p : Euclidean 2 → Complex) (s : Real)
    (hs : 1 ≤ s) (hp : ∀ x, ‖p x‖ = 1)
    (hidentity : ∀ᵐ x ∂volume, r x = p x * (r0 x + s * A x))
    (hA : ∀ x, ‖A x‖ ≤ ‖r1 x‖ + ‖r0 x‖)
    (hr : Integrable (fun x => ‖r x‖ ^ 2))
    (hr0 : Integrable (fun x => ‖r0 x‖ ^ 2))
    (hr1 : Integrable (fun x => ‖r1 x‖ ^ 2)) :
    (∫ x : Euclidean 2, ‖r x‖ ^ 2) ≤
      s ^ 2 * (8 * (∫ x : Euclidean 2, ‖r0 x‖ ^ 2) +
        2 * (∫ x : Euclidean 2, ‖r1 x‖ ^ 2)) := by
  have hH : Integrable (fun x : Euclidean 2 =>
      8 * ‖r0 x‖ ^ 2 + 2 * ‖r1 x‖ ^ 2) :=
    (hr0.const_mul 8).add (hr1.const_mul 2)
  have hHs : Integrable (fun x : Euclidean 2 =>
      s ^ 2 * (8 * ‖r0 x‖ ^ 2 + 2 * ‖r1 x‖ ^ 2)) :=
    hH.const_mul (s ^ 2)
  have hpoint : ∀ᵐ x : Euclidean 2 ∂volume,
      ‖r x‖ ^ 2 ≤ s ^ 2 * (8 * ‖r0 x‖ ^ 2 + 2 * ‖r1 x‖ ^ 2) :=
    hidentity.mono fun x hident => by
    rw [hident, norm_mul, hp x, one_mul]
    have hnonneg : 0 ≤ 2 * ‖r0 x‖ + ‖r1 x‖ := by positivity
    have hs0 : 0 ≤ s := by linarith
    have hlin : ‖r0 x + s * A x‖ ≤ s * (2 * ‖r0 x‖ + ‖r1 x‖) := by
      calc
        ‖r0 x + s * A x‖ ≤ ‖r0 x‖ + ‖s * A x‖ := norm_add_le _ _
        _ = ‖r0 x‖ + s * ‖A x‖ := by
          rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (by linarith)]
        _ ≤ ‖r0 x‖ + s * (‖r1 x‖ + ‖r0 x‖) := by
          exact add_le_add_right
            (mul_le_mul_of_nonneg_left (hA x) hs0) _
        _ ≤ s * (2 * ‖r0 x‖ + ‖r1 x‖) := by
          nlinarith [norm_nonneg (r0 x), norm_nonneg (r1 x)]
    have hsq : ‖r0 x + s * A x‖ ^ 2 ≤
        (s * (2 * ‖r0 x‖ + ‖r1 x‖)) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) (mul_nonneg hs0 hnonneg)).mpr hlin
    calc
      ‖r0 x + s * A x‖ ^ 2 ≤ (s * (2 * ‖r0 x‖ + ‖r1 x‖)) ^ 2 := hsq
      _ ≤ s ^ 2 * (8 * ‖r0 x‖ ^ 2 + 2 * ‖r1 x‖ ^ 2) := by
        nlinarith [sq_nonneg (2 * ‖r0 x‖ - ‖r1 x‖)]
  calc
    (∫ x : Euclidean 2, ‖r x‖ ^ 2) ≤
        ∫ x : Euclidean 2, s ^ 2 * (8 * ‖r0 x‖ ^ 2 + 2 * ‖r1 x‖ ^ 2) :=
      integral_mono_ae hr hHs hpoint
    _ = s ^ 2 * (8 * (∫ x : Euclidean 2, ‖r0 x‖ ^ 2) +
        2 * (∫ x : Euclidean 2, ‖r1 x‖ ^ 2)) := by
      rw [integral_const_mul, integral_add (hr0.const_mul 8) (hr1.const_mul 2),
        integral_const_mul, integral_const_mul]

/-- The cancelled frequency-side energy of the level-zero cutoff half-wave is
uniformly `O(s²)` for both half-wave orientations. -/
theorem exists_cancelled_levelZero_dyadicHalfWave_energy_bound
    (C : lpCutoffs 2) :
    ∃ R : Real, ∀ (σ : WaveSign) (s : Real), 2 ≤ s →
      (∫ ξ : Euclidean 2,
        ‖cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s ξ‖ ^ 2) ≤
          R * s ^ 2 := by
  let r0 : WaveSign → Euclidean 2 → Complex := fun σ =>
    cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 0) 0
  let r1 : WaveSign → Euclidean 2 → Complex := fun σ =>
    cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 1) 1
  let H : WaveSign → Real := fun σ =>
    8 * (∫ x : Euclidean 2, ‖r0 σ x‖ ^ 2) +
      2 * (∫ x : Euclidean 2, ‖r1 σ x‖ ^ 2)
  let R : Real := H WaveSign.plus + H WaveSign.minus
  have hHnonneg (σ : WaveSign) : 0 ≤ H σ := by
    dsimp only [H]
    exact add_nonneg
      (mul_nonneg (by norm_num) (integral_nonneg fun x => sq_nonneg (‖r0 σ x‖)))
      (mul_nonneg (by norm_num) (integral_nonneg fun x => sq_nonneg (‖r1 σ x‖)))
  have hHle (σ : WaveSign) : H σ ≤ R := by
    cases σ <;> dsimp only [R] <;> linarith [hHnonneg WaveSign.plus,
      hHnonneg WaveSign.minus]
  refine ⟨R, ?_⟩
  intro σ s hs
  let r : Euclidean 2 → Complex :=
    cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s
  let A : Euclidean 2 → Complex := fun x =>
    halfWaveMultiplier σ (-1) x * r1 σ x - r0 σ x
  have hr : Integrable (fun x => ‖r x‖ ^ 2) := by
    dsimp only [r]
    exact (cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s).memLp
      2 volume |>.integrable_norm_pow (by norm_num)
  have hr0 : Integrable (fun x => ‖r0 σ x‖ ^ 2) := by
    dsimp only [r0]
    exact (cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 0) 0).memLp
      2 volume |>.integrable_norm_pow (by norm_num)
  have hr1 : Integrable (fun x => ‖r1 σ x‖ ^ 2) := by
    dsimp only [r1]
    exact (cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 1) 1).memLp
      2 volume |>.integrable_norm_pow (by norm_num)
  have hA : ∀ x, ‖A x‖ ≤ ‖r1 σ x‖ + ‖r0 σ x‖ := by
    intro x
    dsimp only [A]
    calc
      ‖halfWaveMultiplier σ (-1) x * r1 σ x - r0 σ x‖ ≤
          ‖halfWaveMultiplier σ (-1) x * r1 σ x‖ + ‖r0 σ x‖ := norm_sub_le _ _
      _ = ‖r1 σ x‖ + ‖r0 σ x‖ := by
        rw [norm_mul, norm_halfWaveMultiplier, one_mul]
  have hidentity : ∀ᵐ x : Euclidean 2 ∂volume,
      r x = halfWaveMultiplier σ s x * (r0 σ x + s * A x) := by
    have hne : ∀ᵐ x : Euclidean 2 ∂volume, x ≠ 0 := by
      simp [ae_iff, measure_singleton]
    filter_upwards [hne] with x hx
    exact cancelled_levelZero_phase_affine C σ s x hx
  have hbound := integral_norm_sq_phase_affine_le r (r0 σ) (r1 σ) A
    (halfWaveMultiplier σ s) s (by linarith) (norm_halfWaveMultiplier σ s)
    hidentity hA hr hr0 hr1
  change (∫ ξ : Euclidean 2,
    ‖cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s ξ‖ ^ 2) ≤
      R * s ^ 2
  calc
    (∫ ξ : Euclidean 2,
      ‖cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s ξ‖ ^ 2) =
        ∫ x : Euclidean 2, ‖r x‖ ^ 2 := by rfl
    _ ≤ s ^ 2 * H σ := hbound
    _ ≤ s ^ 2 * R := mul_le_mul_of_nonneg_left (hHle σ) (sq_nonneg _)
    _ = R * s ^ 2 := by ring

private theorem integral_norm_sq_fourierInv_schwartz_eq
    (q : SchwartzMap (Euclidean 2) Complex) :
    (∫ x : Euclidean 2, ‖(𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2) =
      ∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2 := by
  calc
    (∫ x : Euclidean 2, ‖(𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2) =
        ∫ ξ : Euclidean 2,
          ‖𝓕 ((𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex) ξ‖ ^ 2 :=
      (_root_.Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq
        (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)).symm
    _ = ∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2 := by
      apply integral_congr_ae
      filter_upwards with ξ
      rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]

private theorem cone_weight_pointwise
    (q : SchwartzMap (Euclidean 2) Complex) (s : Real) (hs : s ≠ 0)
    (x : Euclidean 2) :
    coneWeight s x * ‖(𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2 =
      ‖(𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2 +
        s⁻¹ ^ 2 * ‖(SchwartzMap.smulLeftCLM Complex
          (fun y : Euclidean 2 => ‖y‖ ^ 2 - s ^ 2)
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) x‖ ^ 2 := by
  have hmul :
      (SchwartzMap.smulLeftCLM Complex
        (fun y : Euclidean 2 => ‖y‖ ^ 2 - s ^ 2)
        (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) x =
      ((‖x‖ ^ 2 - s ^ 2 : Real) : Complex) *
        (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x := by
    simpa [smul_eq_mul] using congrFun (SchwartzMap.smulLeftCLM_apply
      (show (fun y : Euclidean 2 => ‖y‖ ^ 2 - s ^ 2).HasTemperateGrowth by fun_prop)
      (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) x
  rw [coneWeight, hmul, norm_mul, Complex.norm_real, Real.norm_eq_abs, mul_pow, sq_abs]
  field_simp [hs]

/-- The physical cone-weighted energy of an inverse Fourier transform is
integrable at every nonzero time. -/
theorem integrable_coneWeightedEnergy_fourierInv
    (q : SchwartzMap (Euclidean 2) Complex) (s : Real) (hs : s ≠ 0) :
    Integrable (fun x : Euclidean 2 =>
      coneWeight s x * ‖(𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2) := by
  let K : SchwartzMap (Euclidean 2) Complex := 𝓕⁻ q
  let P : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex (fun x : Euclidean 2 => ‖x‖ ^ 2 - s ^ 2) K
  have hK : Integrable (fun x : Euclidean 2 => ‖K x‖ ^ 2) :=
    (K.memLp 2 volume).integrable_norm_pow (by norm_num)
  have hP : Integrable (fun x : Euclidean 2 => ‖P x‖ ^ 2) :=
    (P.memLp 2 volume).integrable_norm_pow (by norm_num)
  have hsum : Integrable (fun x : Euclidean 2 =>
      ‖K x‖ ^ 2 + s⁻¹ ^ 2 * ‖P x‖ ^ 2) :=
    hK.add (hP.const_mul _)
  refine hsum.congr ?_
  filter_upwards with x
  dsimp only [K, P]
  exact (cone_weight_pointwise q s hs x).symm

private theorem integral_cone_moment_le_cancelled
    (q : SchwartzMap (Euclidean 2) Complex) (s : Real) :
    (∫ x : Euclidean 2, ‖(SchwartzMap.smulLeftCLM Complex
      (fun y : Euclidean 2 => ‖y‖ ^ 2 - s ^ 2)
      (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) x‖ ^ 2) ≤
      ∫ ξ : Euclidean 2, ‖cancelledWaveLaplacian q s ξ‖ ^ 2 := by
  let K : SchwartzMap (Euclidean 2) Complex := 𝓕⁻ q
  let P : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex (fun x : Euclidean 2 => ‖x‖ ^ 2 - s ^ 2) K
  let r : SchwartzMap (Euclidean 2) Complex := cancelledWaveLaplacian q s
  let c : Complex := (((2 * Real.pi) ^ 2 : Real) : Complex)
  have hphase : (𝓕⁻ r : SchwartzMap (Euclidean 2) Complex) = c • P := by
    dsimp only [r, c, P, K, cancelledWaveLaplacian]
    exact fourierInv_cancelled_laplacian_eq_cone_quadratic q s
  have hc : (1 : Real) ≤ ‖c‖ := by
    dsimp only [c]
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
    nlinarith [Real.one_le_pi_div_two]
  have hP : Integrable (fun x : Euclidean 2 => ‖P x‖ ^ 2) :=
    (P.memLp 2 volume).integrable_norm_pow (by norm_num)
  have hR : Integrable (fun x : Euclidean 2 =>
      ‖(𝓕⁻ r : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2) :=
    ((𝓕⁻ r : SchwartzMap (Euclidean 2) Complex).memLp 2 volume).integrable_norm_pow
      (by norm_num)
  have hpoint (x : Euclidean 2) : ‖P x‖ ^ 2 ≤
      ‖(𝓕⁻ r : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2 := by
    rw [hphase, smul_apply, norm_smul]
    apply (sq_le_sq₀ (norm_nonneg _) (mul_nonneg (norm_nonneg _) (norm_nonneg _))).mpr
    exact le_mul_of_one_le_left (norm_nonneg _) hc
  change (∫ x : Euclidean 2, ‖P x‖ ^ 2) ≤ ∫ ξ : Euclidean 2, ‖r ξ‖ ^ 2
  calc
    (∫ x : Euclidean 2, ‖P x‖ ^ 2) ≤
        ∫ x : Euclidean 2, ‖(𝓕⁻ r : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2 :=
      integral_mono hP hR hpoint
    _ = ∫ ξ : Euclidean 2, ‖r ξ‖ ^ 2 :=
      integral_norm_sq_fourierInv_schwartz_eq r

/-- Plancherel converts the physical cone-weighted energy of `𝓕⁻ q` into
the ordinary energy of `q` plus the scaled energy of the cancelled wave
Laplacian.  This is the bridge from Fourier-side phase calculus to the sharp
kernel estimate. -/
theorem integral_coneWeightedEnergy_fourierInv_le
    (q : SchwartzMap (Euclidean 2) Complex) (s : Real) (hs : 0 < s) :
    (∫ x : Euclidean 2,
      coneWeight s x * ‖(𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2) ≤
      (∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2) + s⁻¹ ^ 2 *
        ∫ ξ : Euclidean 2, ‖cancelledWaveLaplacian q s ξ‖ ^ 2 := by
  let K : SchwartzMap (Euclidean 2) Complex := 𝓕⁻ q
  let P : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex (fun x : Euclidean 2 => ‖x‖ ^ 2 - s ^ 2) K
  let r : SchwartzMap (Euclidean 2) Complex := cancelledWaveLaplacian q s
  have hK : Integrable (fun x : Euclidean 2 => ‖K x‖ ^ 2) :=
    (K.memLp 2 volume).integrable_norm_pow (by norm_num)
  have hP : Integrable (fun x : Euclidean 2 => ‖P x‖ ^ 2) :=
    (P.memLp 2 volume).integrable_norm_pow (by norm_num)
  have hweight : (∫ x : Euclidean 2,
      coneWeight s x * ‖K x‖ ^ 2) =
      ∫ x : Euclidean 2, ‖K x‖ ^ 2 + s⁻¹ ^ 2 * ‖P x‖ ^ 2 := by
    apply integral_congr_ae
    filter_upwards with x
    dsimp only [K, P]
    exact cone_weight_pointwise q s hs.ne' x
  have hsum : (∫ x : Euclidean 2, ‖K x‖ ^ 2 + s⁻¹ ^ 2 * ‖P x‖ ^ 2) =
      (∫ x : Euclidean 2, ‖K x‖ ^ 2) + s⁻¹ ^ 2 *
        ∫ x : Euclidean 2, ‖P x‖ ^ 2 := by
    rw [integral_add hK (hP.const_mul _), integral_const_mul]
  have hmoment : (∫ x : Euclidean 2, ‖P x‖ ^ 2) ≤
      ∫ ξ : Euclidean 2, ‖r ξ‖ ^ 2 := by
    simpa only [P, K, r] using integral_cone_moment_le_cancelled q s
  have hinv : 0 ≤ s⁻¹ ^ 2 := sq_nonneg _
  calc
    (∫ x : Euclidean 2, coneWeight s x * ‖(𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2) =
        ∫ x : Euclidean 2, coneWeight s x * ‖K x‖ ^ 2 := by rfl
    _ = ∫ x : Euclidean 2, ‖K x‖ ^ 2 + s⁻¹ ^ 2 * ‖P x‖ ^ 2 := hweight
    _ = (∫ x : Euclidean 2, ‖K x‖ ^ 2) + s⁻¹ ^ 2 *
        ∫ x : Euclidean 2, ‖P x‖ ^ 2 := hsum
    _ ≤ (∫ x : Euclidean 2, ‖K x‖ ^ 2) + s⁻¹ ^ 2 *
        ∫ ξ : Euclidean 2, ‖r ξ‖ ^ 2 := by gcongr
    _ = (∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2) + s⁻¹ ^ 2 *
        ∫ ξ : Euclidean 2, ‖r ξ‖ ^ 2 := by
      rw [show (∫ x : Euclidean 2, ‖K x‖ ^ 2) = ∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2 by
        simpa only [K] using integral_norm_sq_fourierInv_schwartz_eq q]

/-- A pointwise square bound for a compactly supported planar Schwartz
function integrates to the bound times the measure of its support container. -/
theorem integral_norm_sq_le_of_support_subset
    (q : SchwartzMap (Euclidean 2) Complex) (K : Set (Euclidean 2))
    (hK : MeasurableSet K) (hKfinite : volume K ≠ (⊤ : ENNReal))
    {A : Real} (hpoint : ∀ ξ : Euclidean 2, ‖q ξ‖ ^ 2 ≤ A)
    (hsupport : Function.support (q : Euclidean 2 → Complex) ⊆ K) :
    (∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2) ≤ A * volume.real K := by
  have hq : Integrable (fun ξ : Euclidean 2 => ‖q ξ‖ ^ 2) :=
    (q.memLp 2 volume).integrable_norm_pow (by norm_num)
  have hI : Integrable (K.indicator (fun _ : Euclidean 2 => A)) := by
    rw [integrable_indicator_iff hK]
    exact integrableOn_const hKfinite (by finiteness)
  have hmono : (fun ξ : Euclidean 2 => ‖q ξ‖ ^ 2) ≤
      K.indicator (fun _ : Euclidean 2 => A) := by
    intro ξ
    by_cases hξ : ξ ∈ K
    · rw [indicator_of_mem hξ]
      exact hpoint ξ
    · rw [indicator_of_notMem hξ]
      have hzero : q ξ = 0 := by
        by_contra hqzero
        exact hξ (hsupport (Function.mem_support.mpr hqzero))
      simp [hzero]
  calc
    (∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2) ≤
        ∫ ξ : Euclidean 2, K.indicator (fun _ : Euclidean 2 => A) ξ :=
      integral_mono hq hI hmono
    _ = volume.real K * A := by
      simpa only [smul_eq_mul] using
        (integral_indicator_const (μ := volume) (e := A) hK)
    _ = A * volume.real K := by ring

/-- A pointwise `O(s)` bound on a compactly supported planar Schwartz
function yields the scale-compatible `O(s²)` energy estimate. -/
theorem integral_norm_sq_le_scaled_of_norm_le_of_support_subset
    (q : SchwartzMap (Euclidean 2) Complex) (K : Set (Euclidean 2))
    (hK : MeasurableSet K) (hKfinite : volume K ≠ (⊤ : ENNReal))
    {B s : Real} (hB : 0 ≤ B) (hs : 0 ≤ s)
    (hpoint : ∀ ξ : Euclidean 2, ‖q ξ‖ ≤ B * s)
    (hsupport : Function.support (q : Euclidean 2 → Complex) ⊆ K) :
    (∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2) ≤ (B ^ 2 * volume.real K) * s ^ 2 := by
  have hBs : 0 ≤ B * s := mul_nonneg hB hs
  have hpointSq : ∀ ξ : Euclidean 2, ‖q ξ‖ ^ 2 ≤ (B * s) ^ 2 := by
    intro ξ
    nlinarith [norm_nonneg (q ξ), hpoint ξ, hBs]
  calc
    (∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2) ≤ (B * s) ^ 2 * volume.real K :=
      integral_norm_sq_le_of_support_subset q K hK hKfinite hpointSq hsupport
    _ = (B ^ 2 * volume.real K) * s ^ 2 := by ring

/-- The level-zero cutoff half-wave symbols have a uniform `L²` bound,
independent of orientation and time. -/
theorem integral_norm_sq_levelZero_dyadicHalfWaveSchwartzSymbol_le
    (C : lpCutoffs 2) (σ : WaveSign) (s : Real) :
    (∫ ξ : Euclidean 2,
      ‖dyadicHalfWaveSchwartzSymbol C σ 0 s ξ‖ ^ 2) ≤
      4 * volume.real (Metric.closedBall (0 : Euclidean 2) 4) := by
  apply integral_norm_sq_le_of_support_subset
    (q := dyadicHalfWaveSchwartzSymbol C σ 0 s)
    (K := Metric.closedBall (0 : Euclidean 2) 4)
  · exact measurableSet_closedBall
  · exact measure_closedBall_lt_top.ne
  · intro ξ
    nlinarith [norm_nonneg (dyadicHalfWaveSchwartzSymbol C σ 0 s ξ),
      norm_dyadicHalfWaveSchwartzSymbol_le_two C σ 0 s ξ]
  · intro ξ hξ
    by_contra hξK
    have hnorm : (4 : Real) ≤ ‖ξ‖ := by
      rw [Metric.mem_closedBall, dist_zero_right] at hξK
      exact le_of_not_ge hξK
    have hband : dyadicBandpassMultiplier C.cutoff 0 ξ = 0 :=
      dyadicBandpass_eq_zero_of_le_norm C (by
        norm_num
        exact hnorm)
    have hzero : dyadicHalfWaveSchwartzSymbol C σ 0 s ξ = 0 := by
      rw [dyadicHalfWaveSchwartzSymbol_apply, dyadicHalfWaveSymbol, hband, mul_zero]
    change dyadicHalfWaveSchwartzSymbol C σ 0 s ξ ≠ 0 at hξ
    exact hξ hzero

/-- A uniform level-zero cone-weighted energy bound for both wave signs.

This is the precise Fourier-side cancellation input needed for the sharp
physical kernel endpoint.  It is deliberately separated from the
physical-space Cauchy--Schwarz and scaling argument. -/
def HasUniformConeWeightedKernelEnergy (C : lpCutoffs 2) : Prop :=
  ∃ A : Real, 0 < A ∧ ∀ (σ : WaveSign) (s : Real), 2 ≤ s →
    Integrable (fun x : Euclidean 2 =>
      coneWeight s x * ‖dyadicHalfWaveKernel C σ 0 s x‖ ^ 2) ∧
      (∫ x : Euclidean 2,
        coneWeight s x * ‖dyadicHalfWaveKernel C σ 0 s x‖ ^ 2) ≤ A

/-- Uniform ordinary and cancelled frequency-side energies imply the
level-zero cone-weighted kernel energy used by the sharp MSS kernel bound. -/
theorem hasUniformConeWeightedKernelEnergy_of_frequencyBounds
    (C : lpCutoffs 2) {Q R : Real}
    (hQ : ∀ (σ : WaveSign) (s : Real), 2 ≤ s →
      (∫ ξ : Euclidean 2,
        ‖dyadicHalfWaveSchwartzSymbol C σ 0 s ξ‖ ^ 2) ≤ Q)
    (hR : ∀ (σ : WaveSign) (s : Real), 2 ≤ s →
      (∫ ξ : Euclidean 2,
        ‖cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s ξ‖ ^ 2) ≤
          R * s ^ 2) :
    HasUniformConeWeightedKernelEnergy C := by
  let A : Real := |Q| + |R| + 1
  have hA : 0 < A := by
    dsimp only [A]
    positivity
  refine ⟨A, hA, ?_⟩
  intro σ s hs
  have hs0 : s ≠ 0 := by linarith
  constructor
  · simpa only [dyadicHalfWaveKernel] using
      integrable_coneWeightedEnergy_fourierInv
        (dyadicHalfWaveSchwartzSymbol C σ 0 s) s hs0
  · calc
      (∫ x : Euclidean 2,
        coneWeight s x * ‖dyadicHalfWaveKernel C σ 0 s x‖ ^ 2) ≤
          (∫ ξ : Euclidean 2,
            ‖dyadicHalfWaveSchwartzSymbol C σ 0 s ξ‖ ^ 2) + s⁻¹ ^ 2 *
              ∫ ξ : Euclidean 2,
                ‖cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s ξ‖ ^ 2 := by
            simpa only [dyadicHalfWaveKernel] using
              integral_coneWeightedEnergy_fourierInv_le
                (dyadicHalfWaveSchwartzSymbol C σ 0 s) s (by linarith)
      _ ≤ Q + s⁻¹ ^ 2 * (R * s ^ 2) := by
        gcongr
        · exact hQ σ s hs
        · exact hR σ s hs
      _ = Q + R := by
        field_simp [hs0]
      _ ≤ A := by
        dsimp only [A]
        linarith [le_abs_self Q, le_abs_self R]

/-- After the elementary cutoff-symbol energy is absorbed, the cancelled
frequency energy alone is sufficient for the uniform kernel cone energy. -/
theorem hasUniformConeWeightedKernelEnergy_of_cancelledEnergyBound
    (C : lpCutoffs 2) {R : Real}
    (hR : ∀ (σ : WaveSign) (s : Real), 2 ≤ s →
      (∫ ξ : Euclidean 2,
        ‖cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s ξ‖ ^ 2) ≤
          R * s ^ 2) :
    HasUniformConeWeightedKernelEnergy C := by
  apply hasUniformConeWeightedKernelEnergy_of_frequencyBounds C
    (Q := 4 * volume.real (Metric.closedBall (0 : Euclidean 2) 4)) (R := R)
  · intro σ s _
    exact integral_norm_sq_levelZero_dyadicHalfWaveSchwartzSymbol_le C σ s
  · exact hR

/-- The level-zero cutoff half-wave has uniformly bounded cone-weighted
physical energy.  Its proof is the Fourier-side phase cancellation above,
combined with Plancherel. -/
theorem hasUniformConeWeightedKernelEnergy (C : lpCutoffs 2) :
    HasUniformConeWeightedKernelEnergy C := by
  rcases exists_cancelled_levelZero_dyadicHalfWave_energy_bound C with ⟨R, hR⟩
  exact hasUniformConeWeightedKernelEnergy_of_cancelledEnergyBound C hR

/-- At level zero, a cone-weighted energy bound controls the physical
kernel `L¹` norm. -/
theorem levelZeroKernelL1_le_of_coneWeightedEnergy
    (C : lpCutoffs 2) (σ : WaveSign) (s : Real) (hs : 0 < s)
    {A : Real}
    (henergy : Integrable (fun x : Euclidean 2 =>
      coneWeight s x * ‖dyadicHalfWaveKernel C σ 0 s x‖ ^ 2))
    (hbound : (∫ x : Euclidean 2,
      coneWeight s x * ‖dyadicHalfWaveKernel C σ 0 s x‖ ^ 2) ≤ A) :
    dyadicHalfWaveKernelL1 C σ 0 s ≤
      A ^ ((2 : Real)⁻¹) *
        ((volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s) ^ ((2 : Real)⁻¹) := by
  have hmain := integral_norm_le_coneWeightedEnergy
    (dyadicHalfWaveKernel C σ 0 s) s hs henergy
  have henergy_nonneg : 0 ≤ ∫ x : Euclidean 2,
      coneWeight s x * ‖dyadicHalfWaveKernel C σ 0 s x‖ ^ 2 :=
    integral_nonneg fun x => mul_nonneg (coneWeight_pos s x).le (sq_nonneg _)
  have hfactor_nonneg : 0 ≤
      ((volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s) ^ ((2 : Real)⁻¹) := by
    apply Real.rpow_nonneg
    exact mul_nonneg (mul_nonneg MeasureTheory.measureReal_nonneg Real.pi_pos.le) hs.le
  change (∫ x : Euclidean 2, ‖dyadicHalfWaveKernel C σ 0 s x‖) ≤ _
  calc
    (∫ x : Euclidean 2, ‖dyadicHalfWaveKernel C σ 0 s x‖) ≤
        (∫ x : Euclidean 2,
          coneWeight s x * ‖dyadicHalfWaveKernel C σ 0 s x‖ ^ 2) ^ ((2 : Real)⁻¹) *
          ((volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s) ^ ((2 : Real)⁻¹) := hmain
    _ ≤ A ^ ((2 : Real)⁻¹) *
        ((volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s) ^ ((2 : Real)⁻¹) :=
      mul_le_mul_of_nonneg_right
        (Real.rpow_le_rpow henergy_nonneg hbound (by positivity)) hfactor_nonneg

/-- A uniform level-zero cone-energy estimate yields the sharp `2^{j/2}`
bound for every dyadic physical kernel on the MSS unit time interval. -/
theorem waveKernelL1_sharp_of_uniformConeWeightedEnergy
    (C : lpCutoffs 2) (hcone : HasUniformConeWeightedKernelEnergy C) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : WaveSign) (j : Nat), 1 ≤ j →
      ∀ t : Real, t ∈ Icc (1 : Real) 2 →
        dyadicHalfWaveKernelL1 C σ j t ≤ B * Real.sqrt ((2 : Real) ^ j) := by
  rcases hcone with ⟨A, hA, hcone⟩
  let D : Real := volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi
  let B : Real := 1 + A ^ ((2 : Real)⁻¹) * (D * 2) ^ ((2 : Real)⁻¹)
  have hD : 0 ≤ D := by
    dsimp only [D]
    exact mul_nonneg MeasureTheory.measureReal_nonneg Real.pi_pos.le
  have hD2 : 0 ≤ D * (2 : Real) := mul_nonneg hD (by norm_num)
  have hB : 0 < B := by
    have hterm : 0 ≤ A ^ ((2 : Real)⁻¹) * (D * 2) ^ ((2 : Real)⁻¹) :=
      mul_nonneg (Real.rpow_nonneg hA.le _) (Real.rpow_nonneg hD2 _)
    dsimp only [B]
    linarith
  refine ⟨B, hB, ?_⟩
  intro σ j hj t ht
  let q : Real := (2 : Real) ^ j
  let s : Real := q * t
  have hqpos : 0 < q := by
    dsimp only [q]
    positivity
  have hqnonneg : 0 ≤ q := hqpos.le
  have hqge : 2 ≤ q := by
    dsimp only [q]
    calc
      (2 : Real) = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ j := by exact pow_le_pow_right₀ (by norm_num) hj
  have hspos : 0 < s := by
    dsimp only [s]
    exact mul_pos hqpos (lt_of_lt_of_le (by norm_num) ht.1)
  have hsge : 2 ≤ s := by
    dsimp only [s]
    calc
      (2 : Real) ≤ q := hqge
      _ = q * 1 := (mul_one q).symm
      _ ≤ q * t := mul_le_mul_of_nonneg_left ht.1 hqnonneg
  obtain ⟨henergy, henergy_bound⟩ := hcone σ s hsge
  have hlevel := levelZeroKernelL1_le_of_coneWeightedEnergy
    C σ s hspos henergy henergy_bound
  have hscale : dyadicHalfWaveKernelL1 C σ j t = dyadicHalfWaveKernelL1 C σ 0 s := by
    simpa only [s, q] using dyadicHalfWaveKernelL1_eq_levelZero_scaled C σ j t
  rw [hscale]
  have hst : s ≤ q * 2 := by
    dsimp only [s]
    exact mul_le_mul_of_nonneg_left ht.2 hqnonneg
  have hDst : D * s ≤ D * (q * 2) := mul_le_mul_of_nonneg_left hst hD
  have hcone_nonneg : 0 ≤ D * s := mul_nonneg hD hspos.le
  calc
    dyadicHalfWaveKernelL1 C σ 0 s ≤ A ^ ((2 : Real)⁻¹) * (D * s) ^ ((2 : Real)⁻¹) := by
      simpa only [D] using hlevel
    _ ≤ A ^ ((2 : Real)⁻¹) * (D * (q * 2)) ^ ((2 : Real)⁻¹) := by
      apply mul_le_mul_of_nonneg_left
      · exact Real.rpow_le_rpow hcone_nonneg hDst (by positivity)
      · exact Real.rpow_nonneg hA.le _
    _ = (A ^ ((2 : Real)⁻¹) * (D * 2) ^ ((2 : Real)⁻¹)) * Real.sqrt q := by
      rw [show D * (q * 2) = (D * 2) * q by ring,
        Real.mul_rpow hD2 hqnonneg]
      have hqsqrt : q ^ ((2 : Real)⁻¹) = Real.sqrt q := by
        rw [show (2 : Real)⁻¹ = 1 / 2 by norm_num, ← Real.sqrt_eq_rpow]
      rw [hqsqrt]
      ring
    _ ≤ B * Real.sqrt ((2 : Real) ^ j) := by
      change (A ^ ((2 : Real)⁻¹) * (D * 2) ^ ((2 : Real)⁻¹)) * Real.sqrt q ≤
        B * Real.sqrt q
      apply mul_le_mul_of_nonneg_right
      · dsimp only [B]
        linarith
      · exact Real.sqrt_nonneg _

/-- The physical fixed-time `L∞` endpoint that follows formally from any
sharp dyadic kernel `L¹` estimate. -/
theorem mssLInfinityEndpoint_of_waveKernelL1_sharp
    (C : lpCutoffs 2) {B : Real}
    (hkernel : ∀ (σ : WaveSign) (j : Nat), 1 ≤ j →
      ∀ t : Real, t ∈ Icc (1 : Real) 2 →
        dyadicHalfWaveKernelL1 C σ j t ≤ B * Real.sqrt ((2 : Real) ^ j)) :
    ∀ (σ : WaveSign) (j : Nat), 1 ≤ j →
      ∀ t : Real, t ∈ Icc (1 : Real) 2 →
        ∀ (f : SchwartzMap (Euclidean 2) Complex) {A : Real},
          (∀ x, ‖f x‖ ≤ A) → ∀ x,
            ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
              (B * Real.sqrt ((2 : Real) ^ j)) * A := by
  intro σ j hj t ht f A hf x
  have hA : 0 ≤ A := le_trans (norm_nonneg (f 0)) (hf 0)
  calc
    ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
        A * dyadicHalfWaveKernelL1 C σ j t :=
      fixedTimePhysicalLInfinityEndpoint C σ j t f hf x
    _ ≤ A * (B * Real.sqrt ((2 : Real) ^ j)) :=
      mul_le_mul_of_nonneg_left (hkernel σ j hj t ht) hA
    _ = (B * Real.sqrt ((2 : Real) ^ j)) * A := by ring

/-- The conditional MSS physical `L∞` endpoint resulting from a uniform
level-zero cone-weighted energy bound. -/
theorem mssLInfinityEndpoint_of_uniformConeWeightedEnergy
    (C : lpCutoffs 2) (hcone : HasUniformConeWeightedKernelEnergy C) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : WaveSign) (j : Nat), 1 ≤ j →
      ∀ t : Real, t ∈ Icc (1 : Real) 2 →
        ∀ (f : SchwartzMap (Euclidean 2) Complex) {A : Real},
          (∀ x, ‖f x‖ ≤ A) → ∀ x,
            ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
              (B * Real.sqrt ((2 : Real) ^ j)) * A := by
  rcases waveKernelL1_sharp_of_uniformConeWeightedEnergy C hcone with ⟨B, hB, hkernel⟩
  exact ⟨B, hB, mssLInfinityEndpoint_of_waveKernelL1_sharp C hkernel⟩

/-- The sharp dyadic planar half-wave kernel bound on the MSS unit-time
interval. -/
theorem waveKernelL1_sharp (C : lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : WaveSign) (j : Nat), 1 ≤ j →
      ∀ t : Real, t ∈ Icc (1 : Real) 2 →
        dyadicHalfWaveKernelL1 C σ j t ≤ B * Real.sqrt ((2 : Real) ^ j) :=
  waveKernelL1_sharp_of_uniformConeWeightedEnergy C
    (hasUniformConeWeightedKernelEnergy C)

/-- The fixed-time planar MSS `L∞` endpoint obtained from the sharp kernel
bound. -/
theorem mssLInfinityEndpoint (C : lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : WaveSign) (j : Nat), 1 ≤ j →
      ∀ t : Real, t ∈ Icc (1 : Real) 2 →
        ∀ (f : SchwartzMap (Euclidean 2) Complex) {A : Real},
          (∀ x, ‖f x‖ ≤ A) → ∀ x,
            ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
              (B * Real.sqrt ((2 : Real) ^ j)) * A :=
  mssLInfinityEndpoint_of_uniformConeWeightedEnergy C
    (hasUniformConeWeightedKernelEnergy C)

/-- Fixed-time pointwise endpoint obtained directly from Fourier inversion.
It is an `L∞` estimate in the physical output variable, with the natural
Fourier-`L¹` norm on the Schwartz input. -/
theorem fixedTimeFourierL1Endpoint (C : lpCutoffs 2) (σ : WaveSign)
    (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) :
    ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
      2 * ∫ ξ : Euclidean 2, ‖𝓕 (f : Euclidean 2 → Complex) ξ‖ := by
  have hfourier : Integrable (𝓕 (f : Euclidean 2 → Complex)) := by
    rw [← SchwartzMap.fourier_coe]
    exact (𝓕 f).integrable
  have hmajor : Integrable (fun ξ : Euclidean 2 =>
      2 * ‖𝓕 (f : Euclidean 2 → Complex) ξ‖) :=
    hfourier.norm.const_mul (2 : Real)
  rw [dyadicHalfWave, Real.fourierInv_eq']
  simp only [smul_eq_mul]
  calc
    ‖∫ ξ : Euclidean 2,
        Complex.exp (((2 * Real.pi * inner Real ξ x : Real) : Complex) * Complex.I) *
          (halfWaveMultiplier σ t ξ * dyadicBandpassMultiplier C.cutoff j ξ *
            𝓕 (f : Euclidean 2 → Complex) ξ)‖ ≤
        ∫ ξ : Euclidean 2, 2 * ‖𝓕 (f : Euclidean 2 → Complex) ξ‖ := by
      refine norm_integral_le_of_norm_le
        (f := fun ξ : Euclidean 2 =>
          Complex.exp (((2 * Real.pi * inner Real ξ x : Real) : Complex) * Complex.I) *
            (halfWaveMultiplier σ t ξ * dyadicBandpassMultiplier C.cutoff j ξ *
              𝓕 (f : Euclidean 2 → Complex) ξ))
        (g := fun ξ : Euclidean 2 => 2 * ‖𝓕 (f : Euclidean 2 → Complex) ξ‖)
        hmajor ?_
      filter_upwards with ξ
      rw [norm_mul, norm_mul, norm_mul, Complex.norm_exp_ofReal_mul_I,
        norm_halfWaveMultiplier]
      simpa only [one_mul] using mul_le_mul_of_nonneg_right
        (norm_dyadicBandpassMultiplier_le_two C j ξ)
        (norm_nonneg _)
    _ = 2 * ∫ ξ : Euclidean 2, ‖𝓕 (f : Euclidean 2 → Complex) ξ‖ := by
      rw [integral_const_mul]

/-- Blueprint-facing name for the proved fixed-time pointwise (`L∞` in the
output variable) endpoint. -/
theorem lInfinityEndpoint (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (t : Real) (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
      2 * ∫ ξ : Euclidean 2, ‖𝓕 (f : Euclidean 2 → Complex) ξ‖ :=
  fixedTimeFourierL1Endpoint C σ j t f x

/-- The square of a fixed-time cutoff half-wave is integrable.  This is the
Schwartz regularity input needed to apply product-measure Fubini. -/
theorem integrable_norm_sq_dyadicHalfWave (C : lpCutoffs 2) (σ : WaveSign)
    (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun x : Euclidean 2 => ‖dyadicHalfWave C.cutoff σ j t f x‖ ^ 2) := by
  let h : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex
      (dyadicHalfWaveSchwartzSymbol C σ j t : Euclidean 2 → Complex) (𝓕 f)
  let g : SchwartzMap (Euclidean 2) Complex := 𝓕⁻ h
  have hEq : (fun x : Euclidean 2 => dyadicHalfWave C.cutoff σ j t f x) = g := by
    funext x
    change 𝓕⁻ (fun ξ : Euclidean 2 =>
      halfWaveMultiplier σ t ξ * dyadicBandpassMultiplier C.cutoff j ξ *
        𝓕 (f : Euclidean 2 → Complex) ξ) x =
      (𝓕⁻ h : SchwartzMap (Euclidean 2) Complex) x
    rw [SchwartzMap.fourierInv_coe]
    apply congrArg (fun q : Euclidean 2 → Complex => 𝓕⁻ q x)
    funext ξ
    simp only [h, SchwartzMap.smulLeftCLM_apply
      (dyadicHalfWaveSchwartzSymbol C σ j t).hasTemperateGrowth, smul_eq_mul,
      dyadicHalfWaveSchwartzSymbol_apply, dyadicHalfWaveSymbol,
      SchwartzMap.fourier_coe]
  have hpow : (fun x : Euclidean 2 => ‖dyadicHalfWave C.cutoff σ j t f x‖ ^ 2) =
      fun x => ‖g x‖ ^ 2 := by
    funext x
    rw [congrFun hEq x]
  rw [hpow]
  exact (g.memLp 2 volume).integrable_norm_pow (by norm_num)

/-- The local space--time measure used for the time interval `[1,2]`. -/
def localSmoothingMeasure : Measure (Euclidean 2 × Real) :=
  (volume : Measure (Euclidean 2)).prod (volume.restrict (Icc (1 : Real) 2))

/-- The frequency-localized half-wave considered as a space--time function. -/
def dyadicHalfWaveSpaceTime (χ : SchwartzMap (Euclidean 2) Complex)
    (σ : WaveSign) (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    Euclidean 2 × Real → Complex :=
  fun z => dyadicHalfWave χ σ j z.2 f z.1

/-- A cutoff half-wave is jointly continuous in space and time.  The proof
uses compact frequency support to turn the inverse Fourier integral into a
continuous parametric integral. -/
theorem continuous_dyadicHalfWaveSpaceTime (C : lpCutoffs 2) (σ : WaveSign)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    Continuous (dyadicHalfWaveSpaceTime C.cutoff σ j f) := by
  let K : Set (Euclidean 2) := Metric.closedBall 0 ((2 : Real) ^ (j + 2))
  have hK : IsCompact K := isCompact_closedBall _ _
  have hKmeas : MeasurableSet K := hK.measurableSet
  let G : (Euclidean 2 × Real) → Euclidean 2 → Complex := fun z ξ =>
    (Real.fourierChar (inner Real ξ z.1) : Complex) *
      (halfWaveMultiplier σ z.2 ξ * dyadicBandpassMultiplier C.cutoff j ξ *
        𝓕 (f : Euclidean 2 → Complex) ξ)
  have hGcont : Continuous (Function.uncurry G) := by
    change Continuous (fun q : (Euclidean 2 × Real) × Euclidean 2 =>
      (Real.fourierChar (inner Real q.2 q.1.1) : Complex) *
        (halfWaveMultiplier σ q.1.2 q.2 * dyadicBandpassMultiplier C.cutoff j q.2 *
          𝓕 (f : Euclidean 2 → Complex) q.2))
    have hchar : Continuous (fun q : (Euclidean 2 × Real) × Euclidean 2 =>
        (Real.fourierChar (inner Real q.2 q.1.1) : Complex)) := by
      fun_prop
    have hphaseArg : Continuous (fun q : (Euclidean 2 × Real) × Euclidean 2 =>
        ((σ.toReal * (2 * Real.pi) * q.1.2 * ‖q.2‖ : Real) : Complex) * Complex.I) :=
      ((Complex.continuous_ofReal.comp (by fun_prop)).mul continuous_const)
    have hphase : Continuous (fun q : (Euclidean 2 × Real) × Euclidean 2 =>
        halfWaveMultiplier σ q.1.2 q.2) := by
      change Continuous (fun q : (Euclidean 2 × Real) × Euclidean 2 =>
        Complex.exp (((σ.toReal * (2 * Real.pi) * q.1.2 * ‖q.2‖ : Real) : Complex) *
          Complex.I))
      exact Complex.continuous_exp.comp hphaseArg
    exact hchar.mul ((hphase.mul
      ((dyadicBandpassMultiplier C.cutoff j).continuous.comp continuous_snd)).mul
        ((𝓕 f).continuous.comp continuous_snd))
  have hGsupport (z : Euclidean 2 × Real) : Function.support (G z) ⊆ K := by
    intro ξ hξ
    by_contra hξK
    have hnorm : (2 : Real) ^ (j + 2) ≤ ‖ξ‖ := by
      change ξ ∉ Metric.closedBall 0 ((2 : Real) ^ (j + 2)) at hξK
      rw [Metric.mem_closedBall, dist_zero_right] at hξK
      exact le_of_not_ge hξK
    have hband : dyadicBandpassMultiplier C.cutoff j ξ = 0 :=
      dyadicBandpass_eq_zero_of_le_norm C hnorm
    change G z ξ ≠ 0 at hξ
    exact hξ (by simp [G, hband])
  have hGintegral (z : Euclidean 2 × Real) :
      (∫ ξ : Euclidean 2, G z ξ) = ∫ ξ in K, G z ξ := by
    rw [← MeasureTheory.integral_indicator hKmeas]
    rw [Set.indicator_eq_self.mpr (hGsupport z)]
  have hEq (z : Euclidean 2 × Real) :
      dyadicHalfWaveSpaceTime C.cutoff σ j f z = ∫ ξ in K, G z ξ := by
    rw [show dyadicHalfWaveSpaceTime C.cutoff σ j f z =
        ∫ ξ : Euclidean 2, G z ξ by
      dsimp only [dyadicHalfWaveSpaceTime, dyadicHalfWave, G]
      rw [Real.fourierInv_eq]
      rfl]
    exact hGintegral z
  rw [show dyadicHalfWaveSpaceTime C.cutoff σ j f = fun z => ∫ ξ in K, G z ξ by
    funext z
    exact hEq z]
  exact continuous_parametric_integral_of_continuous (μ := volume) hGcont hK

/-- The joint-continuity result supplies the measurability input for Fubini
and space--time norm arguments. -/
theorem aestronglyMeasurable_dyadicHalfWaveSpaceTime (C : lpCutoffs 2)
    (σ : WaveSign) (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    AEStronglyMeasurable (dyadicHalfWaveSpaceTime C.cutoff σ j f)
      localSmoothingMeasure :=
  (continuous_dyadicHalfWaveSpaceTime C σ j f).aestronglyMeasurable

/-- The local square of a cutoff half-wave is integrable on the unit time
slab.  This is the Fubini regularity part of the local `L²` endpoint. -/
theorem integrable_norm_sq_dyadicHalfWaveSpaceTime (C : lpCutoffs 2)
    (σ : WaveSign) (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun z : Euclidean 2 × Real =>
      ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖ ^ 2) localSmoothingMeasure := by
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  let F : Euclidean 2 × Real → Real := fun z =>
    ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖ ^ 2
  let J : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hFmeas : AEStronglyMeasurable F ((volume : Measure (Euclidean 2)).prod ν) := by
    change AEStronglyMeasurable F localSmoothingMeasure
    convert (aestronglyMeasurable_dyadicHalfWaveSpaceTime C σ j f).norm.pow 2 using 1
  have hsliceInt (t : Real) : Integrable (fun x : Euclidean 2 => F (x, t)) := by
    simpa only [F, dyadicHalfWaveSpaceTime] using
      integrable_norm_sq_dyadicHalfWave C σ j t f
  have hsliceBound (t : Real) :
      (∫ x : Euclidean 2, F (x, t)) ≤ 4 * J := by
    simpa only [F, J, dyadicHalfWaveSpaceTime] using
      fixedTimeL2Endpoint C σ j t f
  have houterMeas : AEStronglyMeasurable (fun t : Real =>
      ∫ x : Euclidean 2, F (x, t)) ν := by
    convert hFmeas.prod_swap.integral_prod_right' using 1
    funext t
    apply integral_congr_ae
    filter_upwards with x
    rfl
  have hconst : Integrable (fun _ : Real => 4 * J) ν :=
    integrable_const _
  have houterInt : Integrable (fun t : Real => ∫ x : Euclidean 2, F (x, t)) ν :=
    hconst.mono' houterMeas (by
      filter_upwards with t
      rw [Real.norm_of_nonneg (integral_nonneg fun x => sq_nonneg _)]
      exact hsliceBound t)
  have houterNormInt : Integrable (fun t : Real =>
      ∫ x : Euclidean 2, ‖F (x, t)‖) ν := by
    convert houterInt using 1
    funext t
    apply integral_congr_ae
    filter_upwards with x
    exact Real.norm_of_nonneg (by dsimp only [F]; exact sq_nonneg _)
  have hFint : Integrable F ((volume : Measure (Euclidean 2)).prod ν) :=
    (integrable_prod_iff' hFmeas).mpr
      ⟨Filter.Eventually.of_forall hsliceInt, houterNormInt⟩
  change Integrable F ((volume : Measure (Euclidean 2)).prod ν)
  exact hFint

/-- Fubini upgrades the uniform fixed-time Plancherel estimate to the local
space--time square-integral estimate.  The time interval has length one. -/
theorem integral_norm_sq_dyadicHalfWaveSpaceTime_le_four (C : lpCutoffs 2)
    (σ : WaveSign) (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    (∫ z : Euclidean 2 × Real,
      ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖ ^ 2 ∂localSmoothingMeasure) ≤
      4 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  let F : Euclidean 2 × Real → Real := fun z =>
    ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖ ^ 2
  let J : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hFmeas : AEStronglyMeasurable F ((volume : Measure (Euclidean 2)).prod ν) := by
    change AEStronglyMeasurable F localSmoothingMeasure
    convert (aestronglyMeasurable_dyadicHalfWaveSpaceTime C σ j f).norm.pow 2 using 1
  have hsliceInt (t : Real) : Integrable (fun x : Euclidean 2 => F (x, t)) := by
    simpa only [F, dyadicHalfWaveSpaceTime] using
      integrable_norm_sq_dyadicHalfWave C σ j t f
  have hsliceBound (t : Real) :
      (∫ x : Euclidean 2, F (x, t)) ≤ 4 * J := by
    simpa only [F, J, dyadicHalfWaveSpaceTime] using
      fixedTimeL2Endpoint C σ j t f
  have hJnonneg : 0 ≤ J := by
    dsimp only [J]
    exact integral_nonneg fun _ => sq_nonneg _
  have houterMeas : AEStronglyMeasurable (fun t : Real =>
      ∫ x : Euclidean 2, F (x, t)) ν := by
    convert hFmeas.prod_swap.integral_prod_right' using 1
    funext t
    apply integral_congr_ae
    filter_upwards with x
    rfl
  have hconst : Integrable (fun _ : Real => 4 * J) ν :=
    integrable_const _
  have houterInt : Integrable (fun t : Real => ∫ x : Euclidean 2, F (x, t)) ν :=
    hconst.mono' houterMeas (by
      filter_upwards with t
      rw [Real.norm_of_nonneg (integral_nonneg fun x => sq_nonneg _)]
      exact hsliceBound t)
  have houterNormInt : Integrable (fun t : Real =>
      ∫ x : Euclidean 2, ‖F (x, t)‖) ν := by
    convert houterInt using 1
    funext t
    apply integral_congr_ae
    filter_upwards with x
    exact Real.norm_of_nonneg (by dsimp only [F]; exact sq_nonneg _)
  have hFint : Integrable F ((volume : Measure (Euclidean 2)).prod ν) :=
    (integrable_prod_iff' hFmeas).mpr
      ⟨Filter.Eventually.of_forall hsliceInt, houterNormInt⟩
  have hνuniv : ν.real Set.univ = 1 := by
    dsimp only [ν]
    rw [measureReal_restrict_apply_univ, Real.volume_real_Icc_of_le (by norm_num)]
    norm_num
  change (∫ z : Euclidean 2 × Real, F z ∂(volume : Measure (Euclidean 2)).prod ν) ≤
    4 * J
  calc
    (∫ z : Euclidean 2 × Real, F z ∂(volume : Measure (Euclidean 2)).prod ν) =
        ∫ t : Real, ∫ x : Euclidean 2, F (x, t) ∂volume ∂ν :=
      integral_prod_symm F hFint
    _ ≤ ∫ _ : Real, 4 * J ∂ν :=
      integral_mono houterInt hconst hsliceBound
    _ = 4 * J := by
      rw [integral_const, smul_eq_mul, hνuniv, one_mul]

/-- The full space--time `L²` endpoint in the form interpolated in the MSS
argument.  This is a target predicate rather than a claim: the source-checked
fixed-time Plancherel theorem is `l2Endpoint`; passing it through Fubini
requires the remaining joint-measurability layer. -/
def localL2Endpoint (C : lpCutoffs 2) : Prop :=
  ∀ j : Nat, ∀ f : SchwartzMap (Euclidean 2) Complex, ∀ σ : WaveSign,
    eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j f) (ENNReal.ofReal 2)
        localSmoothingMeasure ≤
      ENNReal.ofReal 2 *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal 2) volume

/-- The local space--time `L²` endpoint, obtained from the fixed-time
Plancherel estimate by Fubini over the unit-length time interval. -/
theorem localL2Endpoint_proof (C : lpCutoffs 2) : localL2Endpoint C := by
  intro j f σ
  let u : Euclidean 2 × Real → Complex := dyadicHalfWaveSpaceTime C.cutoff σ j f
  have huMeas : AEStronglyMeasurable u localSmoothingMeasure := by
    simpa only [u] using aestronglyMeasurable_dyadicHalfWaveSpaceTime C σ j f
  have huSqInt : Integrable (fun z : Euclidean 2 × Real => ‖u z‖ ^ 2)
      localSmoothingMeasure := by
    simpa only [u] using integrable_norm_sq_dyadicHalfWaveSpaceTime C σ j f
  have huMem : MemLp u 2 localSmoothingMeasure :=
    (memLp_two_iff_integrable_sq_norm huMeas).mpr huSqInt
  have hfMem : MemLp (f : Euclidean 2 → Complex) 2 volume := f.memLp 2 volume
  let Iu : Real := ∫ z : Euclidean 2 × Real, ‖u z‖ ^ 2 ∂localSmoothingMeasure
  let If : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hsq : Iu ≤ 4 * If := by
    simpa only [Iu, If, u] using
      integral_norm_sq_dyadicHalfWaveSpaceTime_le_four C σ j f
  have hsqrt : Real.sqrt Iu ≤ 2 * Real.sqrt If := by
    calc
      Real.sqrt Iu ≤ Real.sqrt (4 * If) := Real.sqrt_le_sqrt hsq
      _ = 2 * Real.sqrt If := by
        calc
          Real.sqrt (4 * If) = Real.sqrt ((2 : Real) ^ 2) * Real.sqrt If := by
            rw [show (4 : Real) = 2 ^ 2 by norm_num, Real.sqrt_mul
              (by positivity : (0 : Real) ≤ 2 ^ 2)]
          _ = 2 * Real.sqrt If := by
            congr 1
            exact Real.sqrt_sq (by norm_num : (0 : Real) ≤ 2)
  have hroot : Iu ^ (2 : Real)⁻¹ ≤ 2 * If ^ (2 : Real)⁻¹ := by
    rw [show (2 : Real)⁻¹ = 1 / 2 by norm_num, ← Real.sqrt_eq_rpow,
      ← Real.sqrt_eq_rpow]
    exact hsqrt
  have hNormu : eLpNorm u 2 localSmoothingMeasure =
      ENNReal.ofReal (Iu ^ (2 : Real)⁻¹) := by
    rw [huMem.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    norm_num [Iu]
  have hNormf : eLpNorm (f : Euclidean 2 → Complex) 2 volume =
      ENNReal.ofReal (If ^ (2 : Real)⁻¹) := by
    rw [hfMem.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    norm_num [If]
  change eLpNorm u (ENNReal.ofReal 2) localSmoothingMeasure ≤
    ENNReal.ofReal 2 * eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal 2) volume
  norm_num
  rw [hNormu, hNormf]
  calc
    ENNReal.ofReal (Iu ^ (2 : Real)⁻¹) ≤
        ENNReal.ofReal (2 * If ^ (2 : Real)⁻¹) := ENNReal.ofReal_le_ofReal hroot
    _ = ENNReal.ofReal (2 : Real) * ENNReal.ofReal (If ^ (2 : Real)⁻¹) := by
      rw [ENNReal.ofReal_mul (by norm_num)]
    _ ≤ 2 * ENNReal.ofReal (If ^ (2 : Real)⁻¹) := by norm_num

/-- A positive local-smoothing gain for the planar half-wave at exponent `p`.

This is the precise form required by the Bourgain reduction.  It is only a
definition here; proving it is the geometric Mockenhaupt--Seeger--Sogge part
of this development. -/
def HasPositiveLocalSmoothingGain (χ : SchwartzMap (Euclidean 2) Complex)
    (p ρ : Real) : Prop :=
  2 < p ∧ 0 < ρ ∧ ∃ C : Real, 0 < C ∧
    ∀ j : Nat, 1 ≤ j → ∀ f : SchwartzMap (Euclidean 2) Complex,
      ∀ σ : WaveSign,
        eLpNorm (dyadicHalfWaveSpaceTime χ σ j f) (ENNReal.ofReal p)
            localSmoothingMeasure ≤
          ENNReal.ofReal (C * (2 : Real) ^
            ((j : Real) * (1 / 2 - 1 / p - ρ))) *
            eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume

/-- The MSS gain, in its piecewise form on the full real line.  The intended
range is `2 < p < ∞`. -/
def mssGain (p : Real) : Real :=
  if p ≤ 4 then (1 / 2) * (1 / 2 - 1 / p) else 1 / (2 * p)

/-- First branch of the MSS gain. -/
theorem mssGain_of_le_four {p : Real} (hp : p ≤ 4) :
    mssGain p = (1 / 2) * (1 / 2 - 1 / p) := by
  simp [mssGain, hp]

/-- Second branch of the MSS gain. -/
theorem mssGain_of_four_lt {p : Real} (hp : 4 < p) :
    mssGain p = 1 / (2 * p) := by
  simp [mssGain, not_le.mpr hp]

/-- The two formulas defining the MSS gain agree at `p = 4`. -/
theorem mssGain_four : mssGain 4 = 1 / 8 := by
  norm_num [mssGain]

/-- The MSS gain is positive throughout its intended range. -/
theorem mssGain_pos {p : Real} (hp : 2 < p) : 0 < mssGain p := by
  by_cases hfour : p ≤ 4
  · rw [mssGain_of_le_four hfour]
    have hp0 : 0 < p := lt_trans (by norm_num) hp
    have hrecip : 1 / p < 1 / 2 := by
      rw [div_lt_div_iff₀ hp0 (by norm_num : (0 : Real) < 2)]
      simpa using hp
    positivity
  · rw [mssGain, if_neg hfour]
    have hp0 : 0 < p := lt_trans (by norm_num) hp
    positivity

/-- The exact continuous local-smoothing assertion in the introductory MSS
theorem.  It is packaged as a proposition so that the geometric proof and
the later Bourgain reduction have a common, normalization-sensitive target. -/
def localSmoothing (χ : SchwartzMap (Euclidean 2) Complex)
    (p η : Real) : Prop :=
  2 < p ∧ 0 < η ∧ ∃ C : Real, 0 < C ∧
    ∀ j : Nat, 1 ≤ j → ∀ f : SchwartzMap (Euclidean 2) Complex,
      ∀ σ : WaveSign,
        eLpNorm (dyadicHalfWaveSpaceTime χ σ j f) (ENNReal.ofReal p)
            localSmoothingMeasure ≤
          ENNReal.ofReal (C * (2 : Real) ^
            ((j : Real) * (1 / 2 - 1 / p - mssGain p + η))) *
            eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume

/-- The `p = 4` endpoint form of the MSS local-smoothing theorem.  At this
exponent `mssGain_four` turns the power in `localSmoothing` into
`1 / 8 + η`, exactly as in the blueprint. -/
def p4LocalSmoothing (χ : SchwartzMap (Euclidean 2) Complex) : Prop :=
  ∀ η : Real, 0 < η → localSmoothing χ 4 η

/-- The positive-gain form required by the circular-maximal reduction is an
immediate algebraic consequence of the exact local-smoothing statement once
the permitted loss is smaller than the MSS gain. -/
theorem localSmoothing_to_hasPositiveLocalSmoothingGain
    {χ : SchwartzMap (Euclidean 2) Complex} {p η : Real}
    (hlocal : localSmoothing χ p η) (hη : η < mssGain p) :
    HasPositiveLocalSmoothingGain χ p (mssGain p - η) := by
  rcases hlocal with ⟨hp, hηpos, C, hC, hbound⟩
  refine ⟨hp, sub_pos.mpr hη, C, hC, ?_⟩
  intro j hj f σ
  have hexponent :
      (j : Real) * (1 / 2 - 1 / p - (mssGain p - η)) =
        (j : Real) * (1 / 2 - 1 / p - mssGain p + η) := by
    ring
  rw [hexponent]
  exact hbound j hj f σ

/-- The conditional `p = 4` MSS endpoint supplies every smaller positive
gain needed by the Bourgain reduction. -/
theorem p4LocalSmoothing_to_hasPositiveLocalSmoothingGain
    {χ : SchwartzMap (Euclidean 2) Complex} (hlocal : p4LocalSmoothing χ)
    {ρ : Real} (hρ : 0 < ρ) (hρlt : ρ < (1 / 8 : Real)) :
    HasPositiveLocalSmoothingGain χ 4 ρ := by
  let η : Real := (1 / 8 : Real) - ρ
  have hη : 0 < η := by
    dsimp only [η]
    linarith
  have hηlt : η < mssGain 4 := by
    rw [mssGain_four]
    dsimp only [η]
    linarith
  have hgain := localSmoothing_to_hasPositiveLocalSmoothingGain
    (hlocal η hη) hηlt
  have heq : mssGain 4 - η = ρ := by
    rw [mssGain_four]
    dsimp only [η]
    ring
  rw [heq] at hgain
  exact hgain

/-- The time mesh used in the discretized MSS statement. -/
def dyadicTimeScale (j : Nat) : Real := (2 : Real) ^ (-(j : Int))

/-- A finite maximal `2^{-j}`-separated subset of the time interval `[1,2]`.
The covering clause is the finite-set form of maximality: every point in the
interval lies strictly within one mesh width of a selected time. -/
def MaximalSeparated (j : Nat) (T : Finset Real) : Prop :=
  (∀ t ∈ T, t ∈ Icc (1 : Real) 2) ∧
  (∀ ⦃s⦄, s ∈ T → ∀ ⦃t⦄, t ∈ T → s ≠ t →
    dyadicTimeScale j ≤ |s - t|) ∧
  ∀ t ∈ Icc (1 : Real) 2, ∃ s ∈ T, |t - s| < dyadicTimeScale j

/-- The exact discretized full-time local-smoothing assertion from the
introductory blueprint.  `ENNReal` powers encode the outer `ℓ^p` norm without
introducing an artificial finiteness hypothesis on individual norms. -/
def discreteLocalSmoothing (χ : SchwartzMap (Euclidean 2) Complex)
    (p η : Real) : Prop :=
  2 < p ∧ 0 < η ∧ ∃ C : Real, 0 < C ∧
    ∀ j : Nat, 1 ≤ j → ∀ T : Finset Real, MaximalSeparated j T →
      ∀ f : SchwartzMap (Euclidean 2) Complex, ∀ σ : WaveSign,
        (∑ t ∈ T,
          (eLpNorm (dyadicHalfWave χ σ j t f) (ENNReal.ofReal p) volume) ^ p) ^
            (p⁻¹) ≤
          ENNReal.ofReal (C * (2 : Real) ^
            ((j : Real) * (1 / 2 - mssGain p + η))) *
            eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume

/-- The physical space--time used for the constant-coefficient wave equation. -/
abbrev WaveSpaceTime := Euclidean 2 × Real

/-- Space--time Fourier transform in Mathlib's unitary `2π` convention.
It is written as the iterated spatial and temporal transforms, so it uses
the existing Fourier APIs directly on `Euclidean 2` and `Real`. -/
noncomputable def spaceTimeFourier (G : WaveSpaceTime → Complex) :
    WaveSpaceTime → Complex :=
  fun ζ => 𝓕 (fun t : Real => 𝓕 (fun x : Euclidean 2 => G (x, t)) ζ.1) ζ.2

/-- Inverse space--time Fourier transform in the same convention, again
written as an iterated transform. -/
noncomputable def spaceTimeFourierInv (G : WaveSpaceTime → Complex) :
    WaveSpaceTime → Complex :=
  fun z => 𝓕⁻ (fun τ : Real => 𝓕⁻ (fun η : Euclidean 2 => G (η, τ)) z.1) z.2

/-- The Hilbert coordinate model for genuinely joint Schwartz space--time
data.  The raw product `WaveSpaceTime` does not itself carry the joint inner
product structure needed by `SchwartzMap`; `WithLp 2` supplies that structure
without changing the underlying product coordinates. -/
abbrev JointWaveSpaceTime := WithLp 2 WaveSpaceTime

private theorem aux_joint_norm_le_coordinate_sum (z : JointWaveSpaceTime) :
    ‖z‖ ≤ ‖z.fst‖ + ‖z.snd‖ := by
  have hz : z = WithLp.idemFst z + WithLp.idemSnd z := by
    have hz' := DFunLike.congr_fun
      (WithLp.idemFst_add_idemSnd (p := 2) (α := Euclidean 2) (β := Real)) z
    change WithLp.idemFst z + WithLp.idemSnd z = z at hz'
    exact hz'.symm
  calc
    ‖z‖ = ‖WithLp.idemFst z + WithLp.idemSnd z‖ := congrArg norm hz
    _ ≤ ‖WithLp.idemFst z‖ + ‖WithLp.idemSnd z‖ :=
      norm_add_le _ _
    _ = ‖z.fst‖ + ‖z.snd‖ := by
      simp only [WithLp.idemFst_apply, WithLp.idemSnd_apply,
        WithLp.norm_toLp_fst, WithLp.norm_toLp_snd]

private theorem aux_joint_one_add_norm_pow_le
    (k : Nat) (z : JointWaveSpaceTime) :
    (1 + ‖z‖) ^ k ≤ (1 + ‖z.fst‖) ^ k * (1 + ‖z.snd‖) ^ k := by
  have hbase : 1 + ‖z‖ ≤ (1 + ‖z.fst‖) * (1 + ‖z.snd‖) := by
    calc
      1 + ‖z‖ ≤ 1 + (‖z.fst‖ + ‖z.snd‖) := by
        gcongr
        exact aux_joint_norm_le_coordinate_sum z
      _ ≤ (1 + ‖z.fst‖) * (1 + ‖z.snd‖) := by
        nlinarith [mul_nonneg (norm_nonneg z.fst) (norm_nonneg z.snd)]
  calc
    (1 + ‖z‖) ^ k ≤ ((1 + ‖z.fst‖) * (1 + ‖z.snd‖)) ^ k := by
      gcongr
    _ = (1 + ‖z.fst‖) ^ k * (1 + ‖z.snd‖) ^ k := mul_pow _ _ _

theorem aux_joint_norm_pow_le_coordinate_weights
    (k : Nat) (z : JointWaveSpaceTime) :
    ‖z‖ ^ k ≤ (1 + ‖z.fst‖) ^ k * (1 + ‖z.snd‖) ^ k := by
  calc
    ‖z‖ ^ k ≤ (1 + ‖z‖) ^ k :=
      pow_le_pow_left₀ (norm_nonneg _) (by linarith [norm_nonneg z]) _
    _ ≤ (1 + ‖z.fst‖) ^ k * (1 + ‖z.snd‖) ^ k :=
      aux_joint_one_add_norm_pow_le k z

private theorem aux_joint_fstL_norm_le_one :
    ‖WithLp.fstL 2 Real (Euclidean 2) Real‖ ≤ 1 := by
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
  intro z
  simpa using WithLp.norm_fst_le (p := 2) (Euclidean 2) z

private theorem aux_joint_sndL_norm_le_one :
    ‖WithLp.sndL 2 Real (Euclidean 2) Real‖ ≤ 1 := by
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
  intro z
  simpa using WithLp.norm_snd_le (p := 2) (Euclidean 2) z

private theorem aux_iteratedFDeriv_joint_fst_le
    (B : SchwartzMap (Euclidean 2) Complex)
    (n : Nat) (z : JointWaveSpaceTime) :
    ‖iteratedFDeriv Real n
        (fun w : JointWaveSpaceTime => B (WithLp.fstL 2 Real (Euclidean 2) Real w)) z‖ ≤
      ‖iteratedFDeriv Real n B z.fst‖ := by
  let L : JointWaveSpaceTime →L[Real] Euclidean 2 :=
    WithLp.fstL 2 Real (Euclidean 2) Real
  change ‖iteratedFDeriv Real n (B ∘ L) z‖ ≤
    ‖iteratedFDeriv Real n B (L z)‖
  rw [L.iteratedFDeriv_comp_right (B.smooth (⊤ : ℕ∞)) z (by exact_mod_cast le_top)]
  calc
    ‖(iteratedFDeriv Real n B (L z)).compContinuousLinearMap (fun _ => L)‖ ≤
        ‖iteratedFDeriv Real n B (L z)‖ * ∏ _ : Fin n, ‖L‖ :=
      ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv Real n B (L z)‖ * ∏ _ : Fin n, (1 : Real) := by
      gcongr
      exact aux_joint_fstL_norm_le_one
    _ = ‖iteratedFDeriv Real n B (L z)‖ := by simp

private theorem aux_iteratedFDeriv_joint_snd_le
    (h : SchwartzMap Real Complex)
    (n : Nat) (z : JointWaveSpaceTime) :
    ‖iteratedFDeriv Real n
        (fun w : JointWaveSpaceTime => h (WithLp.sndL 2 Real (Euclidean 2) Real w)) z‖ ≤
      ‖iteratedFDeriv Real n h z.snd‖ := by
  let L : JointWaveSpaceTime →L[Real] Real :=
    WithLp.sndL 2 Real (Euclidean 2) Real
  change ‖iteratedFDeriv Real n (h ∘ L) z‖ ≤
    ‖iteratedFDeriv Real n h (L z)‖
  rw [L.iteratedFDeriv_comp_right (h.smooth (⊤ : ℕ∞)) z (by exact_mod_cast le_top)]
  calc
    ‖(iteratedFDeriv Real n h (L z)).compContinuousLinearMap (fun _ => L)‖ ≤
        ‖iteratedFDeriv Real n h (L z)‖ * ∏ _ : Fin n, ‖L‖ :=
      ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv Real n h (L z)‖ * ∏ _ : Fin n, (1 : Real) := by
      gcongr
      exact aux_joint_sndL_norm_le_one
    _ = ‖iteratedFDeriv Real n h (L z)‖ := by simp

theorem aux_weighted_iteratedFDeriv_joint_fst_le
    (B : SchwartzMap (Euclidean 2) Complex)
    (k n : Nat) (z : JointWaveSpaceTime) :
    (1 + ‖z.fst‖) ^ k *
        ‖iteratedFDeriv Real n
          (fun w : JointWaveSpaceTime => B (WithLp.fstL 2 Real (Euclidean 2) Real w)) z‖ ≤
      2 ^ k * ((Finset.Iic (k, n)).sup fun m =>
        SchwartzMap.seminorm Complex m.1 m.2) B := by
  calc
    (1 + ‖z.fst‖) ^ k *
        ‖iteratedFDeriv Real n
          (fun w : JointWaveSpaceTime => B (WithLp.fstL 2 Real (Euclidean 2) Real w)) z‖ ≤
        (1 + ‖z.fst‖) ^ k * ‖iteratedFDeriv Real n B z.fst‖ := by
      gcongr
      exact aux_iteratedFDeriv_joint_fst_le B n z
    _ ≤ 2 ^ k * ((Finset.Iic (k, n)).sup fun m =>
        SchwartzMap.seminorm Complex m.1 m.2) B :=
      SchwartzMap.one_add_le_sup_seminorm_apply (m := (k, n)) (k := k) (n := n)
        (le_refl _) (le_refl _) B z.fst

theorem aux_weighted_iteratedFDeriv_joint_snd_le
    (h : SchwartzMap Real Complex)
    (k n : Nat) (z : JointWaveSpaceTime) :
    (1 + ‖z.snd‖) ^ k *
        ‖iteratedFDeriv Real n
          (fun w : JointWaveSpaceTime => h (WithLp.sndL 2 Real (Euclidean 2) Real w)) z‖ ≤
      2 ^ k * ((Finset.Iic (k, n)).sup fun m =>
        SchwartzMap.seminorm Complex m.1 m.2) h := by
  calc
    (1 + ‖z.snd‖) ^ k *
        ‖iteratedFDeriv Real n
          (fun w : JointWaveSpaceTime => h (WithLp.sndL 2 Real (Euclidean 2) Real w)) z‖ ≤
        (1 + ‖z.snd‖) ^ k * ‖iteratedFDeriv Real n h z.snd‖ := by
      gcongr
      exact aux_iteratedFDeriv_joint_snd_le h n z
    _ ≤ 2 ^ k * ((Finset.Iic (k, n)).sup fun m =>
        SchwartzMap.seminorm Complex m.1 m.2) h :=
      SchwartzMap.one_add_le_sup_seminorm_apply (m := (k, n)) (k := k) (n := n)
        (le_refl _) (le_refl _) h z.snd

/-- The joint Schwartz external product of a planar spectral profile and a temporal profile.
Its raw `WaveSpaceTime` representative is the literal product of the two coordinate functions. -/
noncomputable def jointSchwartzExternalProduct
    (B : SchwartzMap (Euclidean 2) Complex)
    (h : SchwartzMap Real Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  { toFun := fun z =>
      B (WithLp.fstL 2 Real (Euclidean 2) Real z) *
        h (WithLp.sndL 2 Real (Euclidean 2) Real z)
    smooth' := by
      fun_prop
    decay' := by
      intro k n
      let b : JointWaveSpaceTime → Complex := fun w =>
        B (WithLp.fstL 2 Real (Euclidean 2) Real w)
      let c : JointWaveSpaceTime → Complex := fun w =>
        h (WithLp.sndL 2 Real (Euclidean 2) Real w)
      have hb := by
        simpa only [b] using
          (B.smooth ⊤).comp_continuousLinearMap
            (g := WithLp.fstL 2 Real (Euclidean 2) Real)
      have hc := by
        simpa only [c] using
          (h.smooth ⊤).comp_continuousLinearMap
            (g := WithLp.sndL 2 Real (Euclidean 2) Real)
      let C : Real := ∑ i ∈ Finset.range (n + 1),
        (n.choose i : Real) *
          (2 ^ k * ((Finset.Iic (k, i)).sup fun m =>
            SchwartzMap.seminorm Complex m.1 m.2) B) *
          (2 ^ k * ((Finset.Iic (k, n - i)).sup fun m =>
            SchwartzMap.seminorm Complex m.1 m.2) h)
      refine ⟨C, fun z => ?_⟩
      change ‖z‖ ^ k * ‖iteratedFDeriv Real n (fun w : JointWaveSpaceTime => b w * c w) z‖ ≤ C
      calc
        ‖z‖ ^ k * ‖iteratedFDeriv Real n (fun w : JointWaveSpaceTime => b w * c w) z‖ ≤
            ‖z‖ ^ k * ∑ i ∈ Finset.range (n + 1),
              (n.choose i : Real) * ‖iteratedFDeriv Real i b z‖ *
                ‖iteratedFDeriv Real (n - i) c z‖ := by
          gcongr
          exact norm_iteratedFDeriv_mul_le hb hc z (by exact_mod_cast le_top)
        _ = ∑ i ∈ Finset.range (n + 1),
            ‖z‖ ^ k * ((n.choose i : Real) * ‖iteratedFDeriv Real i b z‖ *
              ‖iteratedFDeriv Real (n - i) c z‖) := by
          rw [Finset.mul_sum]
        _ ≤ C := by
          dsimp only [C]
          apply Finset.sum_le_sum
          intro i hi
          have hprod :
              ‖z‖ ^ k * ‖iteratedFDeriv Real i b z‖ *
                  ‖iteratedFDeriv Real (n - i) c z‖ ≤
                (2 ^ k * ((Finset.Iic (k, i)).sup fun m =>
                  SchwartzMap.seminorm Complex m.1 m.2) B) *
                (2 ^ k * ((Finset.Iic (k, n - i)).sup fun m =>
                  SchwartzMap.seminorm Complex m.1 m.2) h) := by
            calc
              ‖z‖ ^ k * ‖iteratedFDeriv Real i b z‖ *
                    ‖iteratedFDeriv Real (n - i) c z‖ ≤
                  ((1 + ‖z.fst‖) ^ k * (1 + ‖z.snd‖) ^ k) *
                    ‖iteratedFDeriv Real i b z‖ *
                    ‖iteratedFDeriv Real (n - i) c z‖ := by
                gcongr
                exact aux_joint_norm_pow_le_coordinate_weights k z
              _ = ((1 + ‖z.fst‖) ^ k * ‖iteratedFDeriv Real i b z‖) *
                  ((1 + ‖z.snd‖) ^ k * ‖iteratedFDeriv Real (n - i) c z‖) := by
                ring
              _ ≤ _ := by
                apply mul_le_mul
                · simpa only [b] using aux_weighted_iteratedFDeriv_joint_fst_le B k i z
                · simpa only [c] using aux_weighted_iteratedFDeriv_joint_snd_le h k (n - i) z
                · positivity
                · positivity
          calc
            ‖z‖ ^ k * ((n.choose i : Real) * ‖iteratedFDeriv Real i b z‖ *
                ‖iteratedFDeriv Real (n - i) c z‖) =
                (n.choose i : Real) *
                  (‖z‖ ^ k * ‖iteratedFDeriv Real i b z‖ *
                    ‖iteratedFDeriv Real (n - i) c z‖) := by
              ring
            _ ≤ (n.choose i : Real) *
                ((2 ^ k * ((Finset.Iic (k, i)).sup fun m =>
                  SchwartzMap.seminorm Complex m.1 m.2) B) *
                (2 ^ k * ((Finset.Iic (k, n - i)).sup fun m =>
                  SchwartzMap.seminorm Complex m.1 m.2) h)) := by
              gcongr
            _ = _ := by ring }

/-- The raw-coordinate formula for `jointSchwartzExternalProduct`. -/
theorem jointSchwartzExternalProduct_apply
    (B : SchwartzMap (Euclidean 2) Complex)
    (h : SchwartzMap Real Complex)
    (z : WaveSpaceTime) :
    jointSchwartzExternalProduct B h (WithLp.toLp 2 z) = B z.1 * h z.2 := by
  change B ((WithLp.toLp 2 z).fst) * h ((WithLp.toLp 2 z).snd) = B z.1 * h z.2
  simp

private theorem aux_smoothAnnularNormExtension_eventuallyEq_zero_at_zero
    (u : SchwartzMap (Euclidean 2) Real)
    (ε : Real) (hε : 0 < ε)
    (hzero : ∀ x : Euclidean 2, ‖x‖ < ε → u x = 0) :
    (fun x : Euclidean 2 => u x * ‖x‖) =ᶠ[𝓝 0] fun _ => 0 := by
  filter_upwards [Metric.ball_mem_nhds (0 : Euclidean 2) hε] with x hx
  change dist x 0 < ε at hx
  rw [dist_zero_right] at hx
  simp [hzero x hx]

theorem aux_contDiff_smoothAnnularNormExtension
    (u : SchwartzMap (Euclidean 2) Real)
    (ε : Real) (hε : 0 < ε)
    (hzero : ∀ x : Euclidean 2, ‖x‖ < ε → u x = 0) :
    ContDiff Real (⊤ : ℕ∞) (fun x : Euclidean 2 => u x * ‖x‖) := by
  rw [contDiff_iff_contDiffAt]
  intro x
  by_cases hx : x = 0
  · subst x
    exact (contDiffAt_const (c := (0 : Real))).congr_of_eventuallyEq
      (aux_smoothAnnularNormExtension_eventuallyEq_zero_at_zero u ε hε hzero)
  · exact ((u.smooth (⊤ : ℕ∞)).contDiffAt).mul (contDiffAt_norm Real hx)

/-- A compactly supported Schwartz cutoff that vanishes near the origin can be
multiplied by the radial norm while remaining Schwartz. -/
noncomputable def smoothAnnularNormExtension
    (u : SchwartzMap (Euclidean 2) Real)
    (hucompact : HasCompactSupport (u : Euclidean 2 → Real))
    (ε : Real) (hε : 0 < ε)
    (hzero : ∀ x : Euclidean 2, ‖x‖ < ε → u x = 0) :
    SchwartzMap (Euclidean 2) Real :=
  (hucompact.mul_right).toSchwartzMap
    (aux_contDiff_smoothAnnularNormExtension u ε hε hzero)

/-- The literal evaluation formula for `smoothAnnularNormExtension`. -/
theorem smoothAnnularNormExtension_apply
    (u : SchwartzMap (Euclidean 2) Real)
    (hucompact : HasCompactSupport (u : Euclidean 2 → Real))
    (ε : Real) (hε : 0 < ε)
    (hzero : ∀ x : Euclidean 2, ‖x‖ < ε → u x = 0)
    (x : Euclidean 2) :
    smoothAnnularNormExtension u hucompact ε hε hzero x = u x * ‖x‖ := by
  rfl

/-- On a point where the cutoff is one, the annular extension is the radial norm. -/
theorem smoothAnnularNormExtension_eq_norm_of_eq_one
    (u : SchwartzMap (Euclidean 2) Real)
    (hucompact : HasCompactSupport (u : Euclidean 2 → Real))
    (ε : Real) (hε : 0 < ε)
    (hzero : ∀ x : Euclidean 2, ‖x‖ < ε → u x = 0)
    (x : Euclidean 2) (hx : u x = 1) :
    smoothAnnularNormExtension u hucompact ε hε hzero x = ‖x‖ := by
  rw [smoothAnnularNormExtension_apply, hx, one_mul]

/-- If an annular cutoff equals one on a planar Schwartz profile's frequency support,
its norm extension agrees there with the radial norm. -/
theorem smoothAnnularNormExtension_eq_norm_on_support
    (u : SchwartzMap (Euclidean 2) Real)
    (hucompact : HasCompactSupport (u : Euclidean 2 → Real))
    (ε : Real) (hε : 0 < ε)
    (hzero : ∀ x : Euclidean 2, ‖x‖ < ε → u x = 0)
    (B : SchwartzMap (Euclidean 2) Complex)
    (hone : ∀ x ∈ Function.support (B : Euclidean 2 → Complex), u x = 1) :
    ∀ x ∈ Function.support (B : Euclidean 2 → Complex),
      smoothAnnularNormExtension u hucompact ε hε hzero x = ‖x‖ := by
  intro x hx
  exact smoothAnnularNormExtension_eq_norm_of_eq_one u hucompact ε hε hzero x (hone x hx)

noncomputable def jointSchwartzSndEmbedding :
    Real →L[Real] JointWaveSpaceTime :=
  (WithLp.prodContinuousLinearEquiv 2 Real (Euclidean 2) Real).symm.toContinuousLinearMap.comp
    (ContinuousLinearMap.inr Real (Euclidean 2) Real)

/-- The spectral shear which translates the temporal frequency by a smooth radial profile. -/
noncomputable def jointRadialShear
    (rho : SchwartzMap (Euclidean 2) Real) :
    JointWaveSpaceTime → JointWaveSpaceTime :=
  fun z => z - jointSchwartzSndEmbedding (rho z.fst)

private theorem jointRadialShear_apply
    (rho : SchwartzMap (Euclidean 2) Real) (z : JointWaveSpaceTime) :
    jointRadialShear rho z =
      WithLp.toLp 2 (z.fst, z.snd - rho z.fst) := by
  apply (WithLp.ext_iff 2).2
  change WithLp.ofLp z - (0, rho z.fst) =
    (z.fst, z.snd - rho z.fst)
  apply Prod.ext <;> simp

theorem jointRadialShear_hasTemperateGrowth
    (rho : SchwartzMap (Euclidean 2) Real) :
    (jointRadialShear rho).HasTemperateGrowth := by
  let L : JointWaveSpaceTime →L[Real] Euclidean 2 :=
    WithLp.fstL 2 Real (Euclidean 2) Real
  let e : Real →L[Real] JointWaveSpaceTime := jointSchwartzSndEmbedding
  have hρ : (rho ∘ L).HasTemperateGrowth :=
    rho.hasTemperateGrowth.comp L.hasTemperateGrowth
  have hρ' : (fun z : JointWaveSpaceTime => rho z.fst).HasTemperateGrowth := by
    change (fun z : JointWaveSpaceTime => rho (L z)).HasTemperateGrowth at hρ
    change (fun z : JointWaveSpaceTime => rho (L z)).HasTemperateGrowth
    exact hρ
  have he : (e : Real → JointWaveSpaceTime).HasTemperateGrowth :=
    e.hasTemperateGrowth
  have heρ : (fun z : JointWaveSpaceTime => e (rho z.fst)).HasTemperateGrowth := by
    change (e ∘ fun z : JointWaveSpaceTime => rho z.fst).HasTemperateGrowth
    exact he.comp hρ'
  have hid : (fun z : JointWaveSpaceTime => z).HasTemperateGrowth :=
    Function.HasTemperateGrowth.id'
  change (fun z : JointWaveSpaceTime =>
    z - jointSchwartzSndEmbedding (rho z.fst)).HasTemperateGrowth
  have hfun :
      (fun z : JointWaveSpaceTime => z) -
          (fun z : JointWaveSpaceTime => jointSchwartzSndEmbedding (rho z.fst)) =
        fun z : JointWaveSpaceTime => z - jointSchwartzSndEmbedding (rho z.fst) := by
    ext z
    rfl
  rw [← hfun]
  simpa only [e] using hid.sub heρ

theorem jointRadialShear_proper
    (rho : SchwartzMap (Euclidean 2) Real) :
    ∃ (k : Nat) (C : Real), ∀ z : JointWaveSpaceTime,
      ‖z‖ ≤ C * (1 + ‖jointRadialShear rho z‖) ^ k := by
  rcases rho.decay 0 0 with ⟨C, hCpos, hC⟩
  refine ⟨1, 2 + C, fun z => ?_⟩
  have hρ : ‖rho z.fst‖ ≤ C := by
    simpa using hC z.fst
  have hfst : (jointRadialShear rho z).fst = z.fst := by
    rw [jointRadialShear_apply]
    simp
  have hsnd : (jointRadialShear rho z).snd = z.snd - rho z.fst := by
    rw [jointRadialShear_apply]
    simp
  have hsnd' : z.snd = (jointRadialShear rho z).snd + rho z.fst := by
    rw [hsnd]
    ring
  calc
    ‖z‖ ≤ ‖z.fst‖ + ‖z.snd‖ := aux_joint_norm_le_coordinate_sum z
    _ = ‖(jointRadialShear rho z).fst‖ +
          ‖(jointRadialShear rho z).snd + rho z.fst‖ := by rw [hfst, hsnd']
    _ ≤ ‖(jointRadialShear rho z).fst‖ +
          (‖(jointRadialShear rho z).snd‖ + ‖rho z.fst‖) := by
      gcongr
      exact norm_add_le _ _
    _ ≤ ‖jointRadialShear rho z‖ + (‖jointRadialShear rho z‖ + C) := by
      exact add_le_add
        (WithLp.norm_fst_le (p := 2) (Euclidean 2) _)
        (add_le_add (WithLp.norm_snd_le (p := 2) (Euclidean 2) _) hρ)
    _ ≤ (2 + C) * (1 + ‖jointRadialShear rho z‖) ^ 1 := by
      rw [pow_one]
      nlinarith [norm_nonneg (jointRadialShear rho z)]

/-- Precompose a joint Schwartz spectral profile with the smooth radial shear
`(ξ, τ) ↦ (ξ, τ - rho ξ)`.  This is a spectral Schwartz construction only. -/
noncomputable def jointSchwartzPrecompRadialShear
    (rho : SchwartzMap (Euclidean 2) Real)
    (Q : SchwartzMap JointWaveSpaceTime Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  SchwartzMap.compCLM Complex (jointRadialShear_hasTemperateGrowth rho)
    (jointRadialShear_proper rho) Q

/-- The raw product-coordinate formula for `jointSchwartzPrecompRadialShear`. -/
theorem jointSchwartzPrecompRadialShear_apply
    (rho : SchwartzMap (Euclidean 2) Real)
    (Q : SchwartzMap JointWaveSpaceTime Complex)
    (z : WaveSpaceTime) :
    jointSchwartzPrecompRadialShear rho Q (WithLp.toLp 2 z) =
      Q (WithLp.toLp 2 (z.1, z.2 - rho z.1)) := by
  change (Q ∘ jointRadialShear rho) (WithLp.toLp 2 z) =
    Q (WithLp.toLp 2 (z.1, z.2 - rho z.1))
  rw [Function.comp_apply, jointRadialShear_apply]
  simp

/-- The joint spectral profile obtained by applying the smooth radial shear
to a planar-frequency and temporal-Schwartz external product. -/
noncomputable def jointSchwartzModulatedAnnularProfile
    (B : SchwartzMap (Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    SchwartzMap JointWaveSpaceTime Complex :=
  jointSchwartzPrecompRadialShear rho
    (jointSchwartzExternalProduct B (FourierTransform.fourier vartheta))

/-- The raw product-coordinate formula for the modulated annular profile. -/
theorem jointSchwartzModulatedAnnularProfile_apply
    (B : SchwartzMap (Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (z : WaveSpaceTime) :
    jointSchwartzModulatedAnnularProfile B vartheta rho (WithLp.toLp 2 z) =
      B z.1 * FourierTransform.fourier (vartheta : Real → Complex) (z.2 - rho z.1) := by
  unfold jointSchwartzModulatedAnnularProfile
  rw [jointSchwartzPrecompRadialShear_apply, jointSchwartzExternalProduct_apply]
  simp only [SchwartzMap.fourier_coe]

/-- If the radial profile agrees with the norm on the planar profile support,
the modulated annular profile has the literal norm phase there. -/
theorem jointSchwartzModulatedAnnularProfile_eq_norm_on_support
    (B : SchwartzMap (Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hrho : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), rho xi = ‖xi‖)
    (z : WaveSpaceTime) (hz : z.1 ∈ Function.support (B : Euclidean 2 → Complex)) :
    jointSchwartzModulatedAnnularProfile B vartheta rho (WithLp.toLp 2 z) =
      B z.1 * FourierTransform.fourier (vartheta : Real → Complex) (z.2 - ‖z.1‖) := by
  rw [jointSchwartzModulatedAnnularProfile_apply, hrho z.1 hz]

/-- The physical-coordinate representative of a joint Schwartz function.
This is deliberately a spectral/Schwartz construction, rather than an
assertion about a compact physical-time cutoff. -/
noncomputable def jointSchwartzRaw
    (G : SchwartzMap JointWaveSpaceTime Complex) : WaveSpaceTime → Complex :=
  fun z => G (WithLp.toLp 2 z)

/-- The `WithLp` product coordinate map is volume preserving for the global
Haar/Borel measure selected by the joint Fourier transform.  The explicit
argument through Borel measurability avoids identifying that measure structure
definitionally with `WithLp.measurableSpace`. -/
private theorem aux_jointWaveSpaceTime_volumePreserving_toLp :
    MeasurePreserving
      (WithLp.toLp 2 : Euclidean 2 × Real → JointWaveSpaceTime)
      (volume.prod volume) volume := by
  let μ : Measure JointWaveSpaceTime := volume
  have hmeas : Measurable
      (WithLp.toLp 2 : Euclidean 2 × Real → JointWaveSpaceTime) :=
    WithLp.measurable_toLp 2 (Euclidean 2 × Real)
  refine ⟨hmeas, ?_⟩
  ext s hs
  rw [Measure.map_apply hmeas hs]
  have hsBorel : @MeasurableSet JointWaveSpaceTime
      (borel JointWaveSpaceTime) s := by
    rwa [← BorelSpace.measurable_eq (α := JointWaveSpaceTime)]
  have hmeasure :
      (volume.prod volume)
          ((WithLp.toLp 2 : Euclidean 2 × Real → JointWaveSpaceTime) ⁻¹' s) =
        μ s := by
    letI : MeasurableSpace JointWaveSpaceTime :=
      WithLp.measurableSpace 2 (Euclidean 2 × Real)
    letI : BorelSpace JointWaveSpaceTime :=
      WithLp.borelSpace 2 (Euclidean 2) Real
    letI : MeasureSpace JointWaveSpaceTime := { volume := μ }
    have hs' : MeasurableSet s := by
      rwa [BorelSpace.measurable_eq (α := JointWaveSpaceTime)]
    have hpres := WithLp.volume_preserving_toLp (Euclidean 2) Real
    calc
      (volume.prod volume)
          ((WithLp.toLp 2 : Euclidean 2 × Real → JointWaveSpaceTime) ⁻¹' s) =
          Measure.map (WithLp.toLp 2 : Euclidean 2 × Real → JointWaveSpaceTime)
            (volume.prod volume) s :=
        (Measure.map_apply (WithLp.measurable_toLp 2 (Euclidean 2 × Real)) hs').symm
      _ = μ s := by
        simpa only [Measure.volume_eq_prod] using
          congrArg (fun ν : Measure JointWaveSpaceTime => ν s) hpres.map_eq
  exact hmeasure

/-- Rewrite the joint Fourier integral in the product coordinates used by
`spaceTimeFourier`. -/
private theorem aux_integral_jointSchwartz_to_product
    (G : SchwartzMap JointWaveSpaceTime Complex) (ζ : WaveSpaceTime) :
    (integral volume (fun v : JointWaveSpaceTime =>
      Real.fourierChar (-inner Real v (WithLp.toLp 2 ζ)) • G v)) =
    (integral volume (fun p : WaveSpaceTime =>
      Real.fourierChar (-inner Real (WithLp.toLp 2 p) (WithLp.toLp 2 ζ)) •
        G (WithLp.toLp 2 p))) := by
  have hpres : MeasurePreserving
      (MeasurableEquiv.toLp 2 WaveSpaceTime) volume volume :=
    WithLp.volume_preserving_toLp (Euclidean 2) Real
  let φ : JointWaveSpaceTime → Complex := fun v =>
    Real.fourierChar (-inner Real v (WithLp.toLp 2 ζ)) • G v
  have htransport :
      integral volume (fun p : WaveSpaceTime =>
        φ (MeasurableEquiv.toLp 2 WaveSpaceTime p)) =
      integral volume φ :=
    hpres.integral_comp' φ
  simpa only [φ, MeasurableEquiv.coe_toLp] using htransport.symm

/-- The joint `WithLp` Fourier character splits into its spatial and temporal
product factors. -/
private theorem aux_fourierChar_jointWaveSpaceTime_toLp_prod
    (x ξ : Euclidean 2) (t τ : Real) (c : Complex) :
    Real.fourierChar
        (-inner Real (WithLp.toLp 2 (x, t)) (WithLp.toLp 2 (ξ, τ))) • c =
      Real.fourierChar (-inner Real t τ) •
        (Real.fourierChar (-inner Real x ξ) • c) := by
  simp only [WithLp.prod_inner_apply]
  rw [neg_add, Real.fourierChar.map_add_eq_mul, mul_smul]
  rw [← mul_smul, ← mul_smul, mul_comm]

/-- The literal iterated space--time Fourier transform of a joint Schwartz
representative agrees with the canonical Fourier transform on the Hilbert
`WithLp` model. -/
theorem spaceTimeFourier_jointSchwartzRaw
    (G : SchwartzMap JointWaveSpaceTime Complex) (ζ : WaveSpaceTime) :
    spaceTimeFourier (jointSchwartzRaw G) ζ =
      FourierTransform.fourier (G : JointWaveSpaceTime → Complex)
        (WithLp.toLp 2 ζ) := by
  let K : Euclidean 2 → Real → Complex := fun x t =>
    Real.fourierChar (-inner Real t ζ.2) •
      (Real.fourierChar (-inner Real x ζ.1) •
        jointSchwartzRaw G (x, t))
  have hK : Integrable (Function.uncurry K) (volume.prod volume) := by
    have hpres := aux_jointWaveSpaceTime_volumePreserving_toLp
    have hraw : Integrable (fun p : Euclidean 2 × Real =>
        G (WithLp.toLp 2 p)) (volume.prod volume) :=
      (hpres.integrable_comp_emb
        (MeasurableEquiv.toLp 2 (Euclidean 2 × Real)).measurableEmbedding).mpr G.integrable
    refine hraw.congr' ?_ ?_
    · exact
        ((Real.continuous_fourierChar.comp (by fun_prop)).aestronglyMeasurable.smul
          ((Real.continuous_fourierChar.comp (by fun_prop)).aestronglyMeasurable.smul
            hraw.aestronglyMeasurable))
    filter_upwards with p
    simp only [K, Function.uncurry, jointSchwartzRaw, Circle.norm_smul]
  have hleft :
      spaceTimeFourier (jointSchwartzRaw G) ζ =
        ∫ t : Real, ∫ x : Euclidean 2, K x t := by
    unfold spaceTimeFourier
    rw [Real.fourier_eq]
    apply integral_congr_ae
    filter_upwards with t
    rw [Real.fourier_eq]
    change
      (↑(Real.fourierChar (-inner Real t ζ.2)) : Complex) •
          ∫ v : Euclidean 2,
            (↑(Real.fourierChar (-inner Real v ζ.1)) : Complex) •
              G (WithLp.toLp 2 (v, t)) =
        ∫ x : Euclidean 2,
          (↑(Real.fourierChar (-inner Real t ζ.2)) : Complex) •
            ((↑(Real.fourierChar (-inner Real x ζ.1)) : Complex) •
              G (WithLp.toLp 2 (x, t)))
    rw [← integral_smul]
  have hswap :
      (∫ t : Real, ∫ x : Euclidean 2, K x t) =
        ∫ x : Euclidean 2, ∫ t : Real, K x t :=
    integral_integral_swap hK.swap
  have hprod :
      (∫ x : Euclidean 2, ∫ t : Real, K x t) =
        ∫ p : WaveSpaceTime, K p.1 p.2 := by
    rw [Measure.volume_eq_prod]
    exact (integral_prod (Function.uncurry K) hK).symm
  have hfactor :
      (∫ p : WaveSpaceTime, K p.1 p.2) =
        ∫ p : WaveSpaceTime,
          Real.fourierChar
              (-inner Real (WithLp.toLp 2 p) (WithLp.toLp 2 ζ)) •
            G (WithLp.toLp 2 p) := by
    apply integral_congr_ae
    filter_upwards with p
    simpa only [K, jointSchwartzRaw] using
      (aux_fourierChar_jointWaveSpaceTime_toLp_prod p.1 ζ.1 p.2 ζ.2
        (G (WithLp.toLp 2 p))).symm
  calc
    spaceTimeFourier (jointSchwartzRaw G) ζ =
        ∫ t : Real, ∫ x : Euclidean 2, K x t := hleft
    _ = ∫ x : Euclidean 2, ∫ t : Real, K x t := hswap
    _ = ∫ p : WaveSpaceTime, K p.1 p.2 := hprod
    _ = ∫ p : WaveSpaceTime,
          Real.fourierChar
              (-inner Real (WithLp.toLp 2 p) (WithLp.toLp 2 ζ)) •
            G (WithLp.toLp 2 p) := hfactor
    _ = ∫ v : JointWaveSpaceTime,
          Real.fourierChar (-inner Real v (WithLp.toLp 2 ζ)) • G v :=
      (aux_integral_jointSchwartz_to_product G ζ).symm
    _ = FourierTransform.fourier (G : JointWaveSpaceTime → Complex)
          (WithLp.toLp 2 ζ) :=
      (Real.fourier_eq _ _).symm

private theorem aux_eLpNorm_two_fourier_jointSchwartz
    (G : SchwartzMap JointWaveSpaceTime Complex) :
    eLpNorm (FourierTransform.fourier (G : JointWaveSpaceTime → Complex)) 2 volume =
      eLpNorm (G : JointWaveSpaceTime → Complex) 2 volume := by
  calc
    eLpNorm (FourierTransform.fourier (G : JointWaveSpaceTime → Complex)) 2 volume =
        ‖(FourierTransform.fourier G).toLp 2 volume‖ₑ :=
      (Lp.enorm_toLp ((FourierTransform.fourier G).memLp 2 volume)).symm
    _ = ‖FourierTransform.fourier (G.toLp 2 volume)‖ₑ := by
      rw [SchwartzMap.toLp_fourier_eq]
    _ = ‖G.toLp 2 volume‖ₑ := by
      rw [enorm_eq_iff_norm_eq]
      exact Lp.norm_fourier_eq _
    _ = eLpNorm (G : JointWaveSpaceTime → Complex) 2 volume :=
      Lp.enorm_toLp (G.memLp 2 volume)

/-- The literal iterated Fourier transform preserves the `L²` seminorm of a
joint-Schwartz representative in product space--time coordinates. -/
theorem eLpNorm_spaceTimeFourier_jointSchwartzRaw_two_eq
    (G : SchwartzMap JointWaveSpaceTime Complex) :
    eLpNorm (spaceTimeFourier (jointSchwartzRaw G)) 2 volume =
      eLpNorm (jointSchwartzRaw G) 2 volume := by
  let e : WaveSpaceTime → JointWaveSpaceTime := WithLp.toLp 2
  have hpres : MeasurePreserving e volume volume := by
    simpa only [e] using
      (WithLp.volume_preserving_toLp (Euclidean 2) Real)
  calc
    eLpNorm (spaceTimeFourier (jointSchwartzRaw G)) 2 volume =
        eLpNorm ((FourierTransform.fourier (G : JointWaveSpaceTime → Complex)) ∘ e)
          2 volume := by
      apply eLpNorm_congr_ae
      filter_upwards with zeta
      simpa only [Function.comp_apply] using
        (spaceTimeFourier_jointSchwartzRaw G zeta)
    _ = eLpNorm (FourierTransform.fourier (G : JointWaveSpaceTime → Complex)) 2 volume :=
      eLpNorm_comp_measurePreserving
        ((FourierTransform.fourier G).memLp 2 volume).aestronglyMeasurable hpres
    _ = eLpNorm (G : JointWaveSpaceTime → Complex) 2 volume :=
      aux_eLpNorm_two_fourier_jointSchwartz G
    _ = eLpNorm (jointSchwartzRaw G) 2 volume := by
      symm
      exact eLpNorm_comp_measurePreserving (G.memLp 2 volume).aestronglyMeasurable hpres

/-- The iterated inverse transform is the iterated forward transform at the
negated frequency. -/
private theorem aux_spaceTimeFourierInv_eq_spaceTimeFourier_neg
    (H : WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    spaceTimeFourierInv H z = spaceTimeFourier H (-z) := by
  simp only [spaceTimeFourierInv, spaceTimeFourier,
    Real.fourierInv_eq_fourier_neg, Prod.fst_neg, Prod.snd_neg]

/-- The literal iterated inverse space--time Fourier transform of a joint
Schwartz representative agrees with canonical inverse Fourier transform on
the Hilbert `WithLp` model. -/
theorem spaceTimeFourierInv_jointSchwartzRaw
    (P : SchwartzMap JointWaveSpaceTime Complex) (z : WaveSpaceTime) :
    spaceTimeFourierInv (jointSchwartzRaw P) z =
      FourierTransform.fourierInv (P : JointWaveSpaceTime → Complex)
        (WithLp.toLp 2 z) := by
  calc
    spaceTimeFourierInv (jointSchwartzRaw P) z =
        spaceTimeFourier (jointSchwartzRaw P) (-z) :=
      aux_spaceTimeFourierInv_eq_spaceTimeFourier_neg _ _
    _ = FourierTransform.fourier (P : JointWaveSpaceTime → Complex)
          (WithLp.toLp 2 (-z)) :=
      spaceTimeFourier_jointSchwartzRaw P (-z)
    _ = FourierTransform.fourier (P : JointWaveSpaceTime → Complex)
          (-(WithLp.toLp 2 z)) := by simp
    _ = FourierTransform.fourierInv (P : JointWaveSpaceTime → Complex)
          (WithLp.toLp 2 z) :=
      (Real.fourierInv_eq_fourier_neg _ _).symm

/-- Applying the iterated space--time Fourier transform after the iterated
inverse transform recovers a joint Schwartz profile in raw product
coordinates. -/
theorem spaceTimeFourier_spaceTimeFourierInv_jointSchwartzRaw
    (P : SchwartzMap JointWaveSpaceTime Complex) (zeta : WaveSpaceTime) :
    spaceTimeFourier (spaceTimeFourierInv (jointSchwartzRaw P)) zeta =
      P (WithLp.toLp 2 zeta) := by
  have hraw :
      spaceTimeFourierInv (jointSchwartzRaw P) =
        jointSchwartzRaw (FourierTransform.fourierInv P) := by
    funext z
    rw [spaceTimeFourierInv_jointSchwartzRaw]
    change FourierTransform.fourierInv (P : JointWaveSpaceTime → Complex)
        (WithLp.toLp 2 z) =
      (FourierTransform.fourierInv P : SchwartzMap JointWaveSpaceTime Complex)
        (WithLp.toLp 2 z)
    exact (congrFun (SchwartzMap.fourierInv_coe P) (WithLp.toLp 2 z)).symm
  rw [hraw, spaceTimeFourier_jointSchwartzRaw]
  have hpair :
      FourierTransform.fourier
          ((FourierTransform.fourierInv P : SchwartzMap JointWaveSpaceTime Complex) :
            JointWaveSpaceTime → Complex) =
        (P : JointWaveSpaceTime → Complex) := by
    rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  exact congrFun hpair (WithLp.toLp 2 zeta)

private theorem aux_fourierInv_fourier_sub_schwartz
    (vartheta : SchwartzMap Real Complex) (a t : Real) :
    FourierTransform.fourierInv
        (fun tau : Real => FourierTransform.fourier (vartheta : Real → Complex) (tau - a)) t =
      Real.fourierChar (a * t) • vartheta t := by
  rw [Real.fourierInv_eq_fourier_neg]
  have hshift := VectorFourier.fourierIntegral_comp_add_right
    (V := Real) (W := Real) (E := Complex)
    Real.fourierChar volume (innerₗ Real)
    (FourierTransform.fourier (vartheta : Real → Complex)) (-a)
  change VectorFourier.fourierIntegral Real.fourierChar volume (innerₗ Real)
      (fun tau : Real => FourierTransform.fourier (vartheta : Real → Complex) (tau - a)) (-t) = _
  have htranslate :
      (fun tau : Real => FourierTransform.fourier (vartheta : Real → Complex) (tau - a)) =
        Function.comp (FourierTransform.fourier (vartheta : Real → Complex))
          (fun tau : Real => tau + (-a)) := by
    funext tau
    congr 1
  rw [htranslate, hshift]
  have hdouble :
      FourierTransform.fourier
          (FourierTransform.fourier (vartheta : Real → Complex)) (-t) = vartheta t := by
    calc
      FourierTransform.fourier
          (FourierTransform.fourier (vartheta : Real → Complex)) (-t) =
          FourierTransform.fourierInv
            (FourierTransform.fourier (vartheta : Real → Complex)) t :=
        (Real.fourierInv_eq_fourier_neg _ t).symm
      _ = (FourierTransform.fourierInv
            (FourierTransform.fourier vartheta) : SchwartzMap Real Complex) t := by
        simpa only [SchwartzMap.fourier_coe] using
          (congrFun (SchwartzMap.fourierInv_coe
            (FourierTransform.fourier vartheta)) t).symm
      _ = vartheta t := congrArg (fun q : SchwartzMap Real Complex => q t)
        (FourierTransform.fourierInv_fourier_eq vartheta)
  have hdoubleVec :
      VectorFourier.fourierIntegral Real.fourierChar volume (innerₗ Real)
          (FourierTransform.fourier (vartheta : Real → Complex)) (-t) = vartheta t := by
    change FourierTransform.fourier
      (FourierTransform.fourier (vartheta : Real → Complex)) (-t) = vartheta t
    exact hdouble
  change Real.fourierChar ((innerₗ Real (-a)) (-t)) •
      VectorFourier.fourierIntegral Real.fourierChar volume (innerₗ Real)
        (FourierTransform.fourier (vartheta : Real → Complex)) (-t) =
      Real.fourierChar (a * t) • vartheta t
  rw [hdoubleVec]
  congr 1
  simp only [innerₗ_apply_apply, Real.inner_apply]
  congr 1
  ring

private theorem aux_temporal_shift_integral
    (vartheta : SchwartzMap Real Complex) (a t : Real) :
    (∫ tau : Real,
      (Real.fourierChar (inner Real tau t) : Complex) *
        FourierTransform.fourier (vartheta : Real → Complex) (tau - a)) =
      (Real.fourierChar (a * t) : Complex) * vartheta t := by
  calc
    (∫ tau : Real,
      (Real.fourierChar (inner Real tau t) : Complex) *
        FourierTransform.fourier (vartheta : Real → Complex) (tau - a)) =
        FourierTransform.fourierInv
          (fun tau : Real => FourierTransform.fourier (vartheta : Real → Complex) (tau - a)) t := by
      rw [Real.fourierInv_eq]
      apply integral_congr_ae
      filter_upwards with tau
      rfl
    _ = Real.fourierChar (a * t) • vartheta t :=
      aux_fourierInv_fourier_sub_schwartz vartheta a t
    _ = (Real.fourierChar (a * t) : Complex) * vartheta t := by
      rfl

private theorem aux_integrable_jointSchwartzModulatedAnnularProfile_raw
    (B : SchwartzMap (Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    Integrable (fun p : WaveSpaceTime =>
      jointSchwartzModulatedAnnularProfile B vartheta rho (WithLp.toLp 2 p))
      (volume.prod volume) := by
  let G : SchwartzMap JointWaveSpaceTime Complex :=
    jointSchwartzModulatedAnnularProfile B vartheta rho
  have hpres : MeasurePreserving
      (MeasurableEquiv.toLp 2 WaveSpaceTime) volume volume :=
    WithLp.volume_preserving_toLp (Euclidean 2) Real
  have hraw : Integrable (fun p : WaveSpaceTime => G (WithLp.toLp 2 p))
      (volume.prod volume) :=
    (hpres.integrable_comp_emb
      (MeasurableEquiv.toLp 2 (Euclidean 2 × Real)).measurableEmbedding).mpr G.integrable
  simpa only [G] using hraw

private theorem aux_integrable_inverse_jointSchwartzModulatedAnnularProfile_kernel
    (B : SchwartzMap (Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (z : WaveSpaceTime) :
    Integrable (Function.uncurry (fun xi : Euclidean 2 => fun tau : Real =>
      Real.fourierChar (inner Real tau z.2) •
        (Real.fourierChar (inner Real xi z.1) •
          jointSchwartzModulatedAnnularProfile B vartheta rho (WithLp.toLp 2 (xi, tau)))))
      (volume.prod volume) := by
  let K : Euclidean 2 → Real → Complex := fun xi tau =>
    Real.fourierChar (inner Real tau z.2) •
      (Real.fourierChar (inner Real xi z.1) •
        jointSchwartzModulatedAnnularProfile B vartheta rho (WithLp.toLp 2 (xi, tau)))
  change Integrable (Function.uncurry K) (volume.prod volume)
  have hraw := aux_integrable_jointSchwartzModulatedAnnularProfile_raw B vartheta rho
  refine hraw.congr' ?_ ?_
  · exact
      ((Real.continuous_fourierChar.comp (by fun_prop)).aestronglyMeasurable.smul
        ((Real.continuous_fourierChar.comp (by fun_prop)).aestronglyMeasurable.smul
          hraw.aestronglyMeasurable))
  · filter_upwards with p
    simp only [K, Function.uncurry, Circle.norm_smul]

/-- Inverting the joint modulated annular Schwartz profile factors into its
temporal Schwartz factor and the corresponding spatial oscillatory inverse
transform. -/
theorem spaceTimeFourierInv_jointSchwartzModulatedAnnularProfile
    (B : SchwartzMap (Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (z : WaveSpaceTime) :
    spaceTimeFourierInv
        (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho)) z =
      vartheta z.2 * FourierTransform.fourierInv
        (fun xi : Euclidean 2 =>
          B xi * (Real.fourierChar (rho xi * z.2) : Complex)) z.1 := by
  let K : Euclidean 2 → Real → Complex := fun xi tau =>
    Real.fourierChar (inner Real tau z.2) •
      (Real.fourierChar (inner Real xi z.1) •
        jointSchwartzModulatedAnnularProfile B vartheta rho (WithLp.toLp 2 (xi, tau)))
  have hK : Integrable (Function.uncurry K) (volume.prod volume) := by
    simpa only [K] using
      aux_integrable_inverse_jointSchwartzModulatedAnnularProfile_kernel B vartheta rho z
  have hleft :
      spaceTimeFourierInv
          (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho)) z =
        ∫ tau : Real, ∫ xi : Euclidean 2, K xi tau := by
    unfold spaceTimeFourierInv
    rw [Real.fourierInv_eq]
    apply integral_congr_ae
    filter_upwards with tau
    rw [Real.fourierInv_eq]
    change
      (Real.fourierChar (inner Real tau z.2) : Complex) *
          ∫ xi : Euclidean 2,
            (Real.fourierChar (inner Real xi z.1) : Complex) *
              jointSchwartzModulatedAnnularProfile B vartheta rho
                (WithLp.toLp 2 (xi, tau)) =
        ∫ xi : Euclidean 2, K xi tau
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with xi
    simp only [K, Circle.smul_def, smul_eq_mul]
  have hKswap : Integrable
      (Function.uncurry (fun tau : Real => fun xi : Euclidean 2 => K xi tau))
      (volume.prod volume) := by
    convert hK.swap using 1
    ext w
    rcases w with ⟨tau, xi⟩
    rfl
  have hswap :
      (∫ tau : Real, ∫ xi : Euclidean 2, K xi tau) =
        ∫ xi : Euclidean 2, ∫ tau : Real, K xi tau :=
    integral_integral_swap hKswap
  have hinner (xi : Euclidean 2) :
      (∫ tau : Real, K xi tau) =
        ((Real.fourierChar (inner Real xi z.1) : Complex) * B xi) *
          ((Real.fourierChar (rho xi * z.2) : Complex) * vartheta z.2) := by
    have htemporal :
        (∫ tau : Real,
          (Real.fourierChar (inner Real tau z.2) : Complex) *
            FourierTransform.fourier (vartheta : Real → Complex) (tau - rho xi)) =
          (Real.fourierChar (rho xi * z.2) : Complex) * vartheta z.2 :=
      aux_temporal_shift_integral vartheta (rho xi) z.2
    calc
      (∫ tau : Real, K xi tau) =
          ((Real.fourierChar (inner Real xi z.1) : Complex) * B xi) *
            ∫ tau : Real,
              (Real.fourierChar (inner Real tau z.2) : Complex) *
                FourierTransform.fourier (vartheta : Real → Complex) (tau - rho xi) := by
          rw [← integral_const_mul]
          apply integral_congr_ae
          filter_upwards with tau
          simp only [K, Circle.smul_def, smul_eq_mul]
          rw [jointSchwartzModulatedAnnularProfile_apply]
          ring
      _ = ((Real.fourierChar (inner Real xi z.1) : Complex) * B xi) *
          ((Real.fourierChar (rho xi * z.2) : Complex) * vartheta z.2) := by
        rw [htemporal]
  calc
    spaceTimeFourierInv
        (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho)) z =
        ∫ tau : Real, ∫ xi : Euclidean 2, K xi tau := hleft
    _ = ∫ xi : Euclidean 2, ∫ tau : Real, K xi tau := hswap
    _ = ∫ xi : Euclidean 2,
        ((Real.fourierChar (inner Real xi z.1) : Complex) * B xi) *
          ((Real.fourierChar (rho xi * z.2) : Complex) * vartheta z.2) := by
      apply integral_congr_ae
      filter_upwards with xi
      exact hinner xi
    _ = vartheta z.2 * FourierTransform.fourierInv
        (fun xi : Euclidean 2 =>
          B xi * (Real.fourierChar (rho xi * z.2) : Complex)) z.1 := by
      rw [Real.fourierInv_eq]
      change
        (∫ xi : Euclidean 2,
          ((Real.fourierChar (inner Real xi z.1) : Complex) * B xi) *
            ((Real.fourierChar (rho xi * z.2) : Complex) * vartheta z.2)) =
          vartheta z.2 * ∫ xi : Euclidean 2,
            (Real.fourierChar (inner Real xi z.1) : Complex) *
              (B xi * (Real.fourierChar (rho xi * z.2) : Complex))
      rw [← integral_const_mul]
      apply integral_congr_ae
      filter_upwards with xi
      ring

private theorem aux_spaceTimeFourierInv_jointSchwartzModulatedAnnularProfile_eq_norm_on_support
    (B : SchwartzMap (Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hrho : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), rho xi = ‖xi‖)
    (z : WaveSpaceTime) :
    spaceTimeFourierInv
        (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho)) z =
      vartheta z.2 * FourierTransform.fourierInv
        (fun xi : Euclidean 2 =>
          B xi * (Real.fourierChar (‖xi‖ * z.2) : Complex)) z.1 := by
  have hprofile :
      (fun xi : Euclidean 2 =>
        B xi * (Real.fourierChar (rho xi * z.2) : Complex)) =
      fun xi : Euclidean 2 =>
        B xi * (Real.fourierChar (‖xi‖ * z.2) : Complex) := by
    funext xi
    by_cases hB : B xi = 0
    · simp [hB]
    · rw [hrho xi hB]
  calc
    spaceTimeFourierInv
        (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho)) z =
        vartheta z.2 * FourierTransform.fourierInv
          (fun xi : Euclidean 2 =>
            B xi * (Real.fourierChar (rho xi * z.2) : Complex)) z.1 :=
      spaceTimeFourierInv_jointSchwartzModulatedAnnularProfile B vartheta rho z
    _ = vartheta z.2 * FourierTransform.fourierInv
        (fun xi : Euclidean 2 =>
          B xi * (Real.fourierChar (‖xi‖ * z.2) : Complex)) z.1 := by
      rw [hprofile]

private theorem aux_fourierChar_norm_eq_halfWaveMultiplier_plus
    (t : Real) (xi : Euclidean 2) :
    (Real.fourierChar (‖xi‖ * t) : Complex) =
      halfWaveMultiplier WaveSign.plus t xi := by
  rw [Real.fourierChar_apply]
  simp only [halfWaveMultiplier, WaveSign.toReal]
  congr 2
  push_cast
  ring

/-- If the radial extension equals the norm on the planar Schwartz profile
support, the joint inverse profile is the positive half-wave weighted by its
temporal Schwartz factor. -/
theorem spaceTimeFourierInv_jointSchwModulatedAnnProf_eq_halfWave_of_eq_norm_on_supp
    (B : SchwartzMap (Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hrho : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), rho xi = ‖xi‖)
    (z : WaveSpaceTime) :
    spaceTimeFourierInv
        (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho)) z =
      vartheta z.2 * FourierTransform.fourierInv
        (fun xi : Euclidean 2 =>
          B xi * halfWaveMultiplier WaveSign.plus z.2 xi) z.1 := by
  rw [aux_spaceTimeFourierInv_jointSchwartzModulatedAnnularProfile_eq_norm_on_support
    B vartheta rho hrho z]
  congr 2
  apply congrArg (fun f : Euclidean 2 → Complex =>
    FourierTransform.fourierInv f z.1)
  funext xi
  rw [aux_fourierChar_norm_eq_halfWaveMultiplier_plus]

/-- The iterated space--time Fourier transform of the supplied
temporal-Schwartz positive annular half-wave is its joint modulated annular
profile.  This is a spectral identity, with no conic-support assertion. -/
theorem spaceTimeFourier_temporalSchwartzHalfWave_eq_jointSchwartzModulatedAnnularProfile
    (B : SchwartzMap (Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hrho : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), rho xi = ‖xi‖)
    (zeta : WaveSpaceTime) :
    spaceTimeFourier
        (fun z : WaveSpaceTime =>
          vartheta z.2 * FourierTransform.fourierInv
            (fun xi : Euclidean 2 =>
              B xi * halfWaveMultiplier WaveSign.plus z.2 xi) z.1) zeta =
      jointSchwartzModulatedAnnularProfile B vartheta rho (WithLp.toLp 2 zeta) := by
  have hphysical :
      (fun z : WaveSpaceTime =>
        vartheta z.2 * FourierTransform.fourierInv
          (fun xi : Euclidean 2 =>
            B xi * halfWaveMultiplier WaveSign.plus z.2 xi) z.1) =
        spaceTimeFourierInv
          (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho)) := by
    funext z
    exact (spaceTimeFourierInv_jointSchwModulatedAnnProf_eq_halfWave_of_eq_norm_on_supp
      B vartheta rho hrho z).symm
  rw [hphysical]
  exact spaceTimeFourier_spaceTimeFourierInv_jointSchwartzRaw
    (jointSchwartzModulatedAnnularProfile B vartheta rho) zeta

/-! ### The normalized circular incidence family

For the thin-annulus application of MSS (1993), Section 2 and Theorem 6.1,
write `x = r X`, `y = (t₀ + r u) ω` and `ε = r / t₀`. Rationalization
extends the exact incidence phase smoothly through `ε = 0`. In particular,
no frequency-dependent approximation of the phase is made here.
-/

/-- Rationalized normalized distance from a thin annulus to a small output
ball. For unit `ω` and nonzero `ε`, this is exactly
`(‖(1 + ε * u) • ω - ε • X‖ - 1) / ε`. -/
def normalizedCircleIncidence (ε : Real) (X ω : Euclidean 2) (u : Real) : Real :=
  (2 * inner Real ω (u • ω - X) + ε * ‖u • ω - X‖ ^ 2) /
    (‖ω + ε • (u • ω - X)‖ + 1)

/-- The denominator used to remove the apparent singularity at zero scale
is positive at every parameter value. -/
theorem normalizedCircleIncidence_denominator_pos
    (ε : Real) (X ω : Euclidean 2) (u : Real) :
    0 < ‖ω + ε • (u • ω - X)‖ + 1 := by
  positivity

/-- Exact distance identity for the normalized incidence phase, including
zero scale. This identity avoids dividing by the scale parameter. -/
theorem normalizedCircleIncidence_mul_scale
    (ε : Real) (X ω : Euclidean 2) (u : Real) (hω : ‖ω‖ = 1) :
    ε * normalizedCircleIncidence ε X ω u =
      ‖ω + ε • (u • ω - X)‖ - 1 := by
  have hsq := norm_add_sq_real ω (ε • (u • ω - X))
  rw [hω, real_inner_smul_right, norm_smul, Real.norm_eq_abs,
    mul_pow, sq_abs] at hsq
  have hden := ne_of_gt (normalizedCircleIncidence_denominator_pos ε X ω u)
  unfold normalizedCircleIncidence
  rw [← mul_div_assoc, div_eq_iff hden]
  nlinarith

/-- The normalized phase equals the actual circular distance quotient at
every positive or negative nonzero scale. -/
theorem normalizedCircleIncidence_eq_distance_quotient
    {ε : Real} (hε : ε ≠ 0) (X ω : Euclidean 2) (u : Real) (hω : ‖ω‖ = 1) :
    normalizedCircleIncidence ε X ω u =
      (‖(1 + ε * u) • ω - ε • X‖ - 1) / ε := by
  apply (eq_div_iff hε).mpr
  rw [mul_comm, normalizedCircleIncidence_mul_scale ε X ω u hω]
  congr 2
  module

/-- At zero scale the family is the dual Radon incidence relation. -/
theorem normalizedCircleIncidence_zero
    (X ω : Euclidean 2) (u : Real) (hω : ‖ω‖ = 1) :
    normalizedCircleIncidence 0 X ω u = u - inner Real ω X := by
  simp only [normalizedCircleIncidence, zero_mul, zero_smul, add_zero,
    inner_sub_right, real_inner_smul_right, real_inner_self_eq_norm_sq, hω]
  ring

/-- The exact physical distance after simultaneous output and input-annulus
normalization. All radii remain in their original geometric meaning. -/
theorem normalizedCircleIncidence_physical_distance
    {t₀ : Real} (ht₀ : 0 < t₀) (r : Real)
    (X ω : Euclidean 2) (u : Real) (hω : ‖ω‖ = 1) :
    ‖(t₀ + r * u) • ω - r • X‖ =
      t₀ + r * normalizedCircleIncidence (r / t₀) X ω u := by
  have heq : (t₀ + r * u) • ω - r • X =
      t₀ • (ω + (r / t₀) • (u • ω - X)) := by
    rw [smul_add, smul_smul, mul_div_cancel₀ _ ht₀.ne']
    module
  rw [heq, norm_smul, Real.norm_eq_abs, abs_of_pos ht₀]
  have h := normalizedCircleIncidence_mul_scale (r / t₀) X ω u hω
  field_simp [ht₀.ne'] at h
  nlinarith

/-- Joint smoothness in all normalized parameters wherever the source and
output points are distinct. In particular this includes zero scale. -/
theorem normalizedCircleIncidence_contDiffAt
    (z : Real × Euclidean 2 × Euclidean 2 × Real)
    (hz : z.2.2.1 + z.1 • (z.2.2.2 • z.2.2.1 - z.2.1) ≠ 0) :
    ContDiffAt Real (⊤ : ℕ∞)
      (fun q : Real × Euclidean 2 × Euclidean 2 × Real =>
        normalizedCircleIncidence q.1 q.2.1 q.2.2.1 q.2.2.2) z := by
  let v : (Real × Euclidean 2 × Euclidean 2 × Real) → Euclidean 2 :=
    fun q => q.2.2.2 • q.2.2.1 - q.2.1
  have hv : ContDiff Real (⊤ : ℕ∞) v := by dsimp [v]; fun_prop
  have hw : ContDiff Real (⊤ : ℕ∞)
      (fun q : Real × Euclidean 2 × Euclidean 2 × Real => q.2.2.1) := by fun_prop
  have he : ContDiff Real (⊤ : ℕ∞)
      (fun q : Real × Euclidean 2 × Euclidean 2 × Real => q.1) := by fun_prop
  have hn := (hw.add (he.smul hv)).contDiffAt.norm Real hz
  exact (((contDiffAt_const.mul (hw.contDiffAt.inner Real hv.contDiffAt)).add
    (he.contDiffAt.mul ((hv.norm_sq (𝕜 := Real)).contDiffAt))).div
      (hn.add contDiffAt_const)
      (ne_of_gt (normalizedCircleIncidence_denominator_pos z.1 z.2.1 z.2.2.1 z.2.2.2)))

/-- A scale-independent separation bound for the normalized source and
output. The hypothesis allows any fixed compact input/output coordinate box. -/
theorem normalizedCircleIncidence_separation
    (ε : Real) (X ω : Euclidean 2) (u : Real) (hω : ‖ω‖ = 1)
    (hsmall : |ε| * (|u| + ‖X‖) ≤ 1 / 2) :
    1 / 2 ≤ ‖ω + ε • (u • ω - X)‖ := by
  have hv : ‖u • ω - X‖ ≤ |u| + ‖X‖ := by
    simpa only [norm_smul, Real.norm_eq_abs, hω, mul_one] using norm_sub_le (u • ω) X
  have htriangle := norm_sub_norm_le ω (ω + ε • (u • ω - X))
  simp only [hω, sub_add_cancel_left, norm_neg, norm_smul, Real.norm_eq_abs] at htriangle
  have hprod := mul_le_mul_of_nonneg_left hv (abs_nonneg ε)
  linarith

/-- Smoothness of the exact family on the full uniformly separated
parameter region, including its limiting dual Radon member. -/
theorem normalizedCircleIncidence_contDiffAt_of_small
    (ε : Real) (X ω : Euclidean 2) (u : Real) (hω : ‖ω‖ = 1)
    (hsmall : |ε| * (|u| + ‖X‖) ≤ 1 / 2) :
    ContDiffAt Real (⊤ : ℕ∞)
      (fun q : Real × Euclidean 2 × Euclidean 2 × Real =>
        normalizedCircleIncidence q.1 q.2.1 q.2.2.1 q.2.2.2) (ε, X, ω, u) := by
  apply normalizedCircleIncidence_contDiffAt
  apply norm_pos_iff.mp
  exact lt_of_lt_of_le (by norm_num : (0 : Real) < 1 / 2)
    (normalizedCircleIncidence_separation ε X ω u hω hsmall)

/-- Continuity of the exact incidence family at the limiting scale. This
conclusion has no relation between the frequency and the scale parameters. -/
theorem normalizedCircleIncidence_tendsto_zero
    (X ω : Euclidean 2) (u : Real) (hω : ‖ω‖ = 1) :
    Tendsto (fun ε : Real => normalizedCircleIncidence ε X ω u)
      (𝓝 0) (𝓝 (u - inner Real ω X)) := by
  have hc := (normalizedCircleIncidence_contDiffAt_of_small 0 X ω u hω
    (by norm_num)).continuousAt
  have hmap : ContinuousAt
      (fun ε : Real => (ε, X, ω, u)) 0 := by fun_prop
  simpa only [Function.comp_def, normalizedCircleIncidence_zero X ω u hω] using
    hc.tendsto.comp hmap.tendsto

/-- Every fixed number of joint phase derivatives is bounded uniformly on
a compact set of separated normalized parameters. The scale may range
through zero in this compact set. -/
theorem normalizedCircleIncidence_uniform_derivatives
    (K : Set (Real × Euclidean 2 × Euclidean 2 × Real)) (hK : IsCompact K)
    (hsep : ∀ z ∈ K, z.2.2.1 + z.1 • (z.2.2.2 • z.2.2.1 - z.2.1) ≠ 0)
    (n : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ z ∈ K,
      ‖iteratedFDeriv Real n
        (fun q : Real × Euclidean 2 × Euclidean 2 × Real =>
          normalizedCircleIncidence q.1 q.2.1 q.2.2.1 q.2.2.2) z‖ ≤ C := by
  have hc : ContinuousOn (iteratedFDeriv Real n
      (fun q : Real × Euclidean 2 × Euclidean 2 × Real =>
        normalizedCircleIncidence q.1 q.2.1 q.2.2.1 q.2.2.2)) K := by
    intro z hz
    exact ((normalizedCircleIncidence_contDiffAt z (hsep z hz)).continuousAt_iteratedFDeriv
      (by simp)).continuousWithinAt
  obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn hc
  exact ⟨max C 0, le_max_right _ _, fun z hz => (hC z hz).trans (le_max_left _ _)⟩

/-- Unit spatial conormal to the exact circular incidence family. -/
def normalizedCircleNormal (ε : Real) (X ω : Euclidean 2) (u : Real) : Euclidean 2 :=
  ‖ω + ε • (u • ω - X)‖⁻¹ • (ω + ε • (u • ω - X))

/-- The output conormal lies on the ordinary light cone for every scale;
this is an exact identity, not only a limiting property. -/
theorem norm_normalizedCircleNormal
    (ε : Real) (X ω : Euclidean 2) (u : Real)
    (hne : ω + ε • (u • ω - X) ≠ 0) :
    ‖normalizedCircleNormal ε X ω u‖ = 1 := by
  unfold normalizedCircleNormal
  rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (inv_nonneg.mpr (norm_nonneg _)),
    inv_mul_cancel₀ (norm_ne_zero_iff.mpr hne)]

/-- At zero scale the exact normal is the original angular direction. -/
theorem normalizedCircleNormal_zero
    (X ω : Euclidean 2) (u : Real) (hω : ‖ω‖ = 1) :
    normalizedCircleNormal 0 X ω u = ω := by
  simp [normalizedCircleNormal, hω]

/-- Differentiating the Euclidean norm along a nonzero smooth planar curve.
This is the elementary derivative used for the normalized incidence jets. -/
theorem hasDerivAt_planar_norm {f : Real → Euclidean 2} {f' : Euclidean 2}
    {s : Real} (hf : HasDerivAt f f' s) (hne : f s ≠ 0) :
    HasDerivAt (fun v => ‖f v‖) (inner Real (f s) f' / ‖f s‖) s := by
  have h := hf.norm_sq.sqrt (pow_ne_zero 2 (norm_ne_zero_iff.mpr hne))
  simpa only [Real.sqrt_sq (norm_nonneg _),
    mul_div_mul_left _ _ (by norm_num : (2 : Real) ≠ 0)] using h

/-- Spatial directional derivative of the normalized circular phase. Its
negative gradient is the exact unit normal, including at zero scale. -/
theorem normalizedCircleIncidence_hasDerivAt_spatial
    (ε : Real) (X Y ω : Euclidean 2) (u : Real) (hω : ‖ω‖ = 1)
    (hne : ω + ε • (u • ω - X) ≠ 0) :
    HasDerivAt (fun a : Real => normalizedCircleIncidence ε (X + a • Y) ω u)
      (-inner Real (normalizedCircleNormal ε X ω u) Y) 0 := by
  by_cases he : ε = 0
  · subst ε
    simp only [normalizedCircleIncidence_zero _ ω u hω,
      normalizedCircleNormal_zero X ω u hω, inner_add_right, real_inner_smul_right]
    convert (hasDerivAt_const 0 u).sub
      ((hasDerivAt_const 0 (inner Real ω X)).add
        ((hasDerivAt_id 0).mul_const (inner Real ω Y))) using 1 <;> first | rfl | simp
  · have hv : HasDerivAt
        (fun a : Real => ω + ε • (u • ω - (X + a • Y))) (-ε • Y) 0 := by
      convert (hasDerivAt_const (0 : Real) ω).add
        (((hasDerivAt_const (0 : Real) (u • ω)).sub
          ((hasDerivAt_const (0 : Real) X).add
            ((hasDerivAt_id (0 : Real)).smul_const Y))).const_smul ε)
        using 1 <;> first | rfl | simp
    have hn := hasDerivAt_planar_norm hv (by simpa using hne)
    have hquot := (hn.sub_const 1).div_const ε
    have hfun : (fun a : Real => normalizedCircleIncidence ε (X + a • Y) ω u) =
        (fun a : Real => (‖ω + ε • (u • ω - (X + a • Y))‖ - 1) / ε) := by
      funext a
      apply (eq_div_iff he).mpr
      simpa only [mul_comm] using normalizedCircleIncidence_mul_scale ε (X + a • Y) ω u hω
    rw [hfun]
    convert hquot using 1
    simp only [zero_smul, add_zero, normalizedCircleNormal,
      real_inner_smul_right, real_inner_smul_left]
    field_simp

/-- Radial-input derivative of the normalized incidence relation. -/
theorem normalizedCircleIncidence_hasDerivAt_radial
    (ε : Real) (X ω : Euclidean 2) (u : Real) (hω : ‖ω‖ = 1)
    (hne : ω + ε • (u • ω - X) ≠ 0) :
    HasDerivAt (fun v : Real => normalizedCircleIncidence ε X ω v)
      (inner Real (normalizedCircleNormal ε X ω u) ω) u := by
  by_cases he : ε = 0
  · subst ε
    simp only [normalizedCircleIncidence_zero X ω _ hω,
      normalizedCircleNormal_zero X ω u hω, real_inner_self_eq_norm_sq, hω, one_pow]
    exact (hasDerivAt_id u).sub_const _
  · have hv : HasDerivAt (fun v : Real => ω + ε • (v • ω - X)) (ε • ω) u := by
      convert (hasDerivAt_const u ω).add
        ((((hasDerivAt_id u).smul_const ω).sub_const X).const_smul ε)
        using 1 <;> first | rfl | simp
    have hn := hasDerivAt_planar_norm hv hne
    have hquot := (hn.sub_const 1).div_const ε
    have hfun : (fun v : Real => normalizedCircleIncidence ε X ω v) =
        (fun v : Real => (‖ω + ε • (v • ω - X)‖ - 1) / ε) := by
      funext v
      apply (eq_div_iff he).mpr
      simpa only [mul_comm] using normalizedCircleIncidence_mul_scale ε X ω v hω
    rw [hfun]
    convert hquot using 1
    simp only [normalizedCircleNormal, real_inner_smul_right, real_inner_smul_left]
    field_simp

/-- The normalized displacement has a uniform upper bound on the same
coordinate region used for its lower bound. -/
theorem normalizedCircleIncidence_distance_le
    (ε : Real) (X ω : Euclidean 2) (u : Real) (hω : ‖ω‖ = 1)
    (hsmall : |ε| * (|u| + ‖X‖) ≤ 1 / 2) :
    ‖ω + ε • (u • ω - X)‖ ≤ 3 / 2 := by
  have hv : ‖u • ω - X‖ ≤ |u| + ‖X‖ := by
    simpa only [norm_smul, Real.norm_eq_abs, hω, mul_one] using norm_sub_le (u • ω) X
  have htriangle := norm_add_le ω (ε • (u • ω - X))
  rw [hω, norm_smul, Real.norm_eq_abs] at htriangle
  have hprod := mul_le_mul_of_nonneg_left hv (abs_nonneg ε)
  linarith

/-- The radial-input Jacobian is uniformly positive. Consequently the
normalized circle is a graph in the radial input coordinate. -/
theorem normalizedCircleIncidence_radial_jacobian_lower
    (ε : Real) (X ω : Euclidean 2) (u : Real) (hω : ‖ω‖ = 1)
    (hsmall : |ε| * (|u| + ‖X‖) ≤ 1 / 2) :
    1 / 3 ≤ inner Real (normalizedCircleNormal ε X ω u) ω := by
  let v := ω + ε • (u • ω - X)
  have hvpos : 0 < ‖v‖ := lt_of_lt_of_le (by norm_num : (0 : Real) < 1 / 2)
    (normalizedCircleIncidence_separation ε X ω u hω hsmall)
  have hvupper : ‖v‖ ≤ 3 / 2 := normalizedCircleIncidence_distance_le ε X ω u hω hsmall
  have hinner : |inner Real X ω| ≤ ‖X‖ := by
    simpa only [hω, mul_one] using abs_real_inner_le_norm X ω
  have hinner' : |u - inner Real X ω| ≤ |u| + ‖X‖ :=
    (abs_sub u (inner Real X ω)).trans (add_le_add le_rfl hinner)
  have habs : |ε * (u - inner Real X ω)| ≤ 1 / 2 := by
    rw [abs_mul]
    exact (mul_le_mul_of_nonneg_left hinner' (abs_nonneg ε)).trans hsmall
  have hvinner : inner Real v ω = 1 + ε * (u - inner Real X ω) := by
    simp [v, inner_add_left, real_inner_smul_left, inner_sub_left,
      hω]
  change 1 / 3 ≤ inner Real (‖v‖⁻¹ • v) ω
  rw [real_inner_smul_left, ← div_eq_inv_mul, le_div_iff₀ hvpos, hvinner]
  have := (abs_le.mp habs).1
  linarith

/-- Derivative of unit-vector normalization along a nonzero planar curve.
The formula is the orthogonal projection of the velocity onto the tangent
line, divided by the radius. -/
theorem hasDerivAt_planar_normalize {f : Real → Euclidean 2} {f' : Euclidean 2}
    {s : Real} (hf : HasDerivAt f f' s) (hne : f s ≠ 0) :
    HasDerivAt (fun v => ‖f v‖⁻¹ • f v)
      (‖f s‖⁻¹ • f' - (inner Real (f s) f' / ‖f s‖ ^ 3) • f s) s := by
  have hn := hasDerivAt_planar_norm hf hne
  have h := (hn.inv (norm_ne_zero_iff.mpr hne)).smul hf
  convert h using 1
  ext i
  simp only [PiLp.sub_apply, PiLp.smul_apply, PiLp.add_apply, smul_eq_mul, Pi.inv_apply]
  field_simp [norm_ne_zero_iff.mpr hne]
  ring

/-- Joint smoothness of the unit conormal away from incidence collisions. -/
theorem normalizedCircleNormal_contDiffAt
    (z : Real × Euclidean 2 × Euclidean 2 × Real)
    (hz : z.2.2.1 + z.1 • (z.2.2.2 • z.2.2.1 - z.2.1) ≠ 0) :
    ContDiffAt Real (⊤ : ℕ∞)
      (fun q : Real × Euclidean 2 × Euclidean 2 × Real =>
        normalizedCircleNormal q.1 q.2.1 q.2.2.1 q.2.2.2) z := by
  let v : (Real × Euclidean 2 × Euclidean 2 × Real) → Euclidean 2 :=
    fun q => q.2.2.1 + q.1 • (q.2.2.2 • q.2.2.1 - q.2.1)
  have hv : ContDiff Real (⊤ : ℕ∞) v := by dsimp [v]; fun_prop
  exact ((hv.contDiffAt.norm Real hz).inv (norm_ne_zero_iff.mpr hz)).smul hv.contDiffAt

/-- Exact inverse normal coordinates on a normalized incidence circle. -/
theorem normalizedCircle_inverse_displacement
    (ε : Real) (X η : Euclidean 2) (s : Real) (hη : ‖η‖ = 1)
    (hsep : η + ε • (s • η - -X) ≠ 0) :
    let u := normalizedCircleIncidence ε (-X) η s
    let ω := normalizedCircleNormal ε (-X) η s
    ω + ε • (u • ω - X) = (1 + ε * s) • η := by
  dsimp
  let v := η + ε • (s • η - -X)
  have hv : ‖v‖ ≠ 0 := norm_ne_zero_iff.mpr hsep
  have hu := normalizedCircleIncidence_mul_scale ε (-X) η s hη
  have hu' : 1 + ε * normalizedCircleIncidence ε (-X) η s = ‖v‖ := by
    dsimp [v]; linarith
  change ‖v‖⁻¹ • v + ε •
    (normalizedCircleIncidence ε (-X) η s • (‖v‖⁻¹ • v) - X) =
    (1 + ε * s) • η
  calc
    _ = (1 + ε * normalizedCircleIncidence ε (-X) η s) •
        (‖v‖⁻¹ • v) - ε • X := by module
    _ = v - ε • X := by rw [hu', smul_smul, mul_inv_cancel₀ hv, one_smul]
    _ = (1 + ε * s) • η := by dsimp [v]; module

/-- The inverse normal chart lies on the prescribed incidence level. -/
theorem normalizedCircle_inverse_incidence
    (ε : Real) (X η : Euclidean 2) (s : Real) (hη : ‖η‖ = 1)
    (hsep : η + ε • (s • η - -X) ≠ 0) (hs : 0 < 1 + ε * s) :
    normalizedCircleIncidence ε X
      (normalizedCircleNormal ε (-X) η s)
      (normalizedCircleIncidence ε (-X) η s) = s := by
  have hω := norm_normalizedCircleNormal ε (-X) η s hsep
  have hv := normalizedCircle_inverse_displacement ε X η s hη hsep
  by_cases hε : ε = 0
  · subst ε
    rw [normalizedCircleNormal_zero _ _ _ hη,
      normalizedCircleIncidence_zero _ _ _ hη,
      normalizedCircleIncidence_zero _ _ _ hη, inner_neg_right]
    ring
  · have h := normalizedCircleIncidence_mul_scale ε X
      (normalizedCircleNormal ε (-X) η s)
      (normalizedCircleIncidence ε (-X) η s) hω
    rw [hv, norm_smul, Real.norm_eq_abs, abs_of_pos hs, hη] at h
    apply mul_left_cancel₀ hε
    nlinarith

/-- In inverse normal coordinates the output normal is exactly the chosen
unit direction. Thus the output conormal cone is the ordinary light cone,
for every admissible scale, not merely at the limiting scale. -/
theorem normalizedCircle_inverse_normal
    (ε : Real) (X η : Euclidean 2) (s : Real) (hη : ‖η‖ = 1)
    (hsep : η + ε • (s • η - -X) ≠ 0) (hs : 0 < 1 + ε * s) :
    normalizedCircleNormal ε X
      (normalizedCircleNormal ε (-X) η s)
      (normalizedCircleIncidence ε (-X) η s) = η := by
  have hv := normalizedCircle_inverse_displacement ε X η s hη hsep
  unfold normalizedCircleNormal
  change ‖normalizedCircleNormal ε (-X) η s +
      ε • (normalizedCircleIncidence ε (-X) η s •
        normalizedCircleNormal ε (-X) η s - X)‖⁻¹ •
    (normalizedCircleNormal ε (-X) η s +
      ε • (normalizedCircleIncidence ε (-X) η s •
        normalizedCircleNormal ε (-X) η s - X)) = η
  rw [hv, norm_smul, Real.norm_eq_abs, abs_of_pos hs, hη, mul_one,
    smul_smul, inv_mul_cancel₀ hs.ne', one_smul]

theorem abs_normalizedCircleIncidence_le
    (ε : Real) (X ω : Euclidean 2) (u : Real) (hω : ‖ω‖ = 1) :
    |normalizedCircleIncidence ε X ω u| ≤ |u| + ‖X‖ := by
  have hv : ‖u • ω - X‖ ≤ |u| + ‖X‖ := by
    simpa only [norm_smul, Real.norm_eq_abs, hω, mul_one] using norm_sub_le (u • ω) X
  by_cases hε : ε = 0
  · subst ε
    rw [normalizedCircleIncidence_zero _ _ _ hω]
    have hi : |inner Real ω X| ≤ ‖X‖ := by
      simpa only [hω, one_mul] using abs_real_inner_le_norm ω X
    exact (abs_sub u (inner Real ω X)).trans (add_le_add le_rfl hi)
  · have h := abs_norm_sub_norm_le (ω + ε • (u • ω - X)) ω
    rw [hω, add_sub_cancel_left, norm_smul, Real.norm_eq_abs,
      ← normalizedCircleIncidence_mul_scale ε X ω u hω, abs_mul] at h
    exact (mul_le_mul_iff_right₀ (abs_pos.mpr hε)).mp
      (h.trans (mul_le_mul_of_nonneg_left hv (abs_nonneg ε)))

/-- The circular averaging family in exact normalized annular coordinates.
The sphere variable parametrizes the physical circle by its output normal. -/
def normalizedCircleAverage (ε : Real) (h : Euclidean 2 → Real → Complex)
    (X : Euclidean 2) (s : Real) : Complex :=
  ∫ η : Metric.sphere (0 : Euclidean 2) 1,
    h (normalizedCircleNormal ε (-X) η s)
      (normalizedCircleIncidence ε (-X) η s) ∂unitSurfaceMeasure 2

/-- Physical source points expressed through the exact inverse normal chart. -/
theorem normalizedCircle_source_coordinates {t₀ : Real} (ht₀ : 0 < t₀)
    (r : Real) (X η : Euclidean 2) (s : Real) (hη : ‖η‖ = 1)
    (hsep : η + (r / t₀) • (s • η - -X) ≠ 0) :
    (t₀ + r * normalizedCircleIncidence (r / t₀) (-X) η s) •
        normalizedCircleNormal (r / t₀) (-X) η s =
      r • X + (t₀ + r * s) • η := by
  have hv := normalizedCircle_inverse_displacement (r / t₀) X η s hη hsep
  have heq : t₀ * (r / t₀) = r := by field_simp
  have hh := congrArg (fun v : Euclidean 2 => t₀ • v) hv
  simp only [smul_add, smul_sub, smul_smul, heq, mul_add, mul_one] at hh
  simp only [← mul_assoc, heq] at hh
  calc
    _ = (t₀ • normalizedCircleNormal (r / t₀) (-X) η s +
        ((r * normalizedCircleIncidence (r / t₀) (-X) η s) •
          normalizedCircleNormal (r / t₀) (-X) η s - r • X)) + r • X := by module
    _ = _ := by rw [hh]; module

/-- Exact rescaling of a physical circular average, with no error term and
no restriction on the frequency of the input. -/
theorem sphericalAverage_eq_normalizedCircleAverage {t₀ : Real} (ht₀ : 0 < t₀)
    (r : Real) (X : Euclidean 2) (s : Real) (f : Euclidean 2 → Complex)
    (hsmall : |r / t₀| * (|s| + ‖X‖) ≤ 1 / 2) :
    sphericalAverage 2 f (t₀ + r * s) (r • X) =
      normalizedCircleAverage (r / t₀)
        (fun ω u => f ((t₀ + r * u) • ω)) X s := by
  unfold sphericalAverage normalizedCircleAverage
  apply integral_congr_ae
  filter_upwards [] with η
  congr 1
  apply (normalizedCircle_source_coordinates ht₀ r X η s
    (mem_sphere_zero_iff_norm.mp η.2) ?_).symm
  apply norm_pos_iff.mp
  have h := normalizedCircleIncidence_separation (r / t₀) (-X) η s
    (mem_sphere_zero_iff_norm.mp η.2) (by simpa using hsmall)
  linarith

/-- The limiting operator is the dual Radon transform. -/
theorem normalizedCircleAverage_zero (h : Euclidean 2 → Real → Complex)
    (X : Euclidean 2) (s : Real) :
    normalizedCircleAverage 0 h X s =
      ∫ η : Metric.sphere (0 : Euclidean 2) 1,
        h η (s + inner Real (η : Euclidean 2) X) ∂unitSurfaceMeasure 2 := by
  unfold normalizedCircleAverage
  apply integral_congr_ae
  filter_upwards [] with η
  rw [normalizedCircleNormal_zero _ _ _ (mem_sphere_zero_iff_norm.mp η.2),
    normalizedCircleIncidence_zero _ _ _ (mem_sphere_zero_iff_norm.mp η.2),
    inner_neg_right, sub_neg_eq_add]

/-- The exact radial Jacobian in the annular change of variables. -/
theorem lintegral_affine_radial_change (t₀ : Real) {r : Real} (hr : 0 < r)
    (G : Real → ℝ≥0∞) (hG : Measurable G) :
    ENNReal.ofReal r * (∫⁻ u : Real, G (t₀ + r * u)) = ∫⁻ v : Real, G v := by
  have hm : Measurable (fun v : Real => G (t₀ + v)) := by fun_prop
  calc
    _ = ∫⁻ v : Real, G (t₀ + v) ∂(ENNReal.ofReal r • Measure.map (r * ·) volume) := by
      rw [lintegral_smul_measure, lintegral_map hm (by fun_prop), smul_eq_mul]
    _ = ∫⁻ v : Real, G (t₀ + v) := by
      rw [show ENNReal.ofReal r • Measure.map (r * ·) volume = volume by
        simpa only [abs_of_pos hr] using Real.smul_map_volume_mul_left hr.ne']
    _ = _ := lintegral_add_left_eq_self G t₀

/-- The input annular-coordinate moment costs at most `2 / (t₀ * r)`.
This is the input-side factor in the normalized weighted shell estimate. -/
theorem normalizedCircle_input_moment_le {t₀ r : Real} (ht₀ : 0 < t₀) (hr : 0 < r)
    (S : Set Real) (hS : MeasurableSet S) (hpositive : ∀ u ∈ S, t₀ / 2 ≤ t₀ + r * u)
    (H : Euclidean 2 → ℝ≥0∞) (hH : Measurable H) :
    ENNReal.ofReal (t₀ * r / 2) *
      (∫⁻ ω : Metric.sphere (0 : Euclidean 2) 1,
        (∫⁻ u in S, H ((t₀ + r * u) • (ω : Euclidean 2))) ∂unitSurfaceMeasure 2) ≤
      ∫⁻ x : Euclidean 2, H x := by
  have hinner (ω : Metric.sphere (0 : Euclidean 2) 1) :
      ENNReal.ofReal (t₀ * r / 2) *
        (∫⁻ u in S, H ((t₀ + r * u) • (ω : Euclidean 2))) ≤
      ∫⁻ v in Ioi (0 : Real), ENNReal.ofReal v * H (v • (ω : Euclidean 2)) := by
    let G : Real → ℝ≥0∞ := (Ioi (0 : Real)).indicator
      (fun v => ENNReal.ofReal v * H (v • (ω : Euclidean 2)))
    have hG : Measurable G := by
      exact Measurable.indicator (by fun_prop) measurableSet_Ioi
    have hlocal : ENNReal.ofReal (t₀ / 2) *
        (∫⁻ u in S, H ((t₀ + r * u) • (ω : Euclidean 2))) ≤
        ∫⁻ u : Real, G (t₀ + r * u) := by
      rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
      apply le_trans (setLIntegral_mono' hS ?_) (setLIntegral_le_lintegral _ _)
      intro u hu
      dsimp [G]
      rw [indicator_of_mem (show t₀ + r * u ∈ Ioi (0 : Real) by
        have := hpositive u hu; change 0 < t₀ + r * u; linarith)]
      exact mul_le_mul' (ENNReal.ofReal_le_ofReal (hpositive u hu)) le_rfl
    calc
      _ = ENNReal.ofReal r * (ENNReal.ofReal (t₀ / 2) *
          ∫⁻ u in S, H ((t₀ + r * u) • (ω : Euclidean 2))) := by
        rw [← mul_assoc, ← ENNReal.ofReal_mul hr.le]
        congr 2
        ring
      _ ≤ ENNReal.ofReal r * ∫⁻ u : Real, G (t₀ + r * u) :=
        mul_le_mul' le_rfl hlocal
      _ = ∫⁻ v : Real, G v := lintegral_affine_radial_change t₀ hr G hG
      _ = _ := lintegral_indicator measurableSet_Ioi _
  rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  apply le_trans (lintegral_mono hinner)
  rw [lintegral_polar_unitSurfaceMeasure (by norm_num : 0 < 2)]
  have hp : Measurable (fun q : Metric.sphere (0 : Euclidean 2) 1 × Ioi (0 : Real) =>
      H (q.2.1 • (q.1 : Euclidean 2))) := by fun_prop
  rw [lintegral_prod _ hp.aemeasurable]
  apply lintegral_mono
  intro ω
  dsimp only
  rw [lintegral_volumeIoiPow (2 - 1) (fun v : Real => H (v • (ω : Euclidean 2)))
    (by fun_prop)]
  norm_num

/-- Planar polar integration with the literal radial Jacobian. -/
theorem normalizedCircle_lintegral_polar
    (H : Euclidean 2 → ℝ≥0∞) (hH : Measurable H) :
    (∫⁻ y : Euclidean 2, H y) =
      ∫⁻ ω : Metric.sphere (0 : Euclidean 2) 1,
        (∫⁻ t in Ioi (0 : Real),
          ENNReal.ofReal t * H (t • (ω : Euclidean 2))) ∂unitSurfaceMeasure 2 := by
  rw [lintegral_polar_unitSurfaceMeasure (by norm_num : 0 < 2)]
  rw [lintegral_prod _ (by fun_prop)]
  apply lintegral_congr
  intro ω
  simpa using lintegral_volumeIoiPow 1
    (fun t : Real => H (t • (ω : Euclidean 2))) (by fun_prop)

/-- Centered polar integration identifies the weak circular kernel. -/
theorem normalizedCircle_lintegral_centered
    (F : Euclidean 2 → ℝ≥0∞) (G : Real → ℝ≥0∞)
    (hF : Measurable F) (hG : Measurable G) (x : Euclidean 2) :
    (∫⁻ t in Ioi (0 : Real), ENNReal.ofReal t *
      ∫⁻ ω : Metric.sphere (0 : Euclidean 2) 1,
        G t * F (x + t • (ω : Euclidean 2)) ∂unitSurfaceMeasure 2) =
      ∫⁻ y : Euclidean 2, G ‖y - x‖ * F y := by
  have ht : (∫⁻ y : Euclidean 2, G ‖y - x‖ * F y) =
      ∫⁻ z : Euclidean 2, G ‖z‖ * F (x + z) := by
    simpa only [add_sub_cancel_left] using
      (lintegral_add_left_eq_self (fun y : Euclidean 2 => G ‖y - x‖ * F y) x).symm
  rw [ht, normalizedCircle_lintegral_polar _ (by fun_prop)]
  have hfactor (t : Real) :
      ENNReal.ofReal t * (∫⁻ ω : Metric.sphere (0 : Euclidean 2) 1,
        G t * F (x + t • (ω : Euclidean 2)) ∂unitSurfaceMeasure 2) =
      ∫⁻ ω : Metric.sphere (0 : Euclidean 2) 1,
        ENNReal.ofReal t * (G t * F (x + t • (ω : Euclidean 2))) ∂unitSurfaceMeasure 2 :=
    (lintegral_const_mul' _ _ ENNReal.ofReal_ne_top).symm
  simp_rw [hfactor]
  rw [lintegral_lintegral_swap (by fun_prop)]
  apply lintegral_congr
  intro ω
  apply setLIntegral_congr_fun measurableSet_Ioi
  intro t ht
  dsimp only
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos ht,
    mem_sphere_zero_iff_norm.mp ω.2, mul_one]


/-- Weak coarea identity for the circular averaging kernel. -/
theorem normalizedCircle_lintegral_coarea
    (F : Euclidean 2 → ℝ≥0∞) (G : Real → ℝ≥0∞)
    (hF : Measurable F) (hG : Measurable G) (x : Euclidean 2) :
    (∫⁻ t in Ioi (0 : Real), ENNReal.ofReal t *
      ∫⁻ ω : Metric.sphere (0 : Euclidean 2) 1,
        G t * F (x + t • (ω : Euclidean 2)) ∂unitSurfaceMeasure 2) =
      ∫⁻ ω : Metric.sphere (0 : Euclidean 2) 1,
        (∫⁻ v in Ioi (0 : Real), ENNReal.ofReal v *
          (G ‖v • (ω : Euclidean 2) - x‖ * F (v • (ω : Euclidean 2))))
          ∂unitSurfaceMeasure 2 := by
  rw [normalizedCircle_lintegral_centered F G hF hG x]
  exact normalizedCircle_lintegral_polar _ (by fun_prop)

/-- Affine radial change of variables with the positive-radius domain. -/
theorem normalizedCircle_lintegral_radial_change
    (t₀ : Real) {r : Real} (hr : 0 < r)
    (H : Real → ℝ≥0∞) (hH : Measurable H) :
    ENNReal.ofReal r *
      (∫⁻ u in {u : Real | 0 < t₀ + r * u}, H (t₀ + r * u)) =
      ∫⁻ t in Ioi (0 : Real), H t := by
  have h := lintegral_affine_radial_change t₀ hr
    ((Ioi (0 : Real)).indicator H) (hH.indicator measurableSet_Ioi)
  rw [lintegral_indicator measurableSet_Ioi] at h
  rw [← h]
  congr 1
  rw [← lintegral_indicator (show MeasurableSet {u : Real | 0 < t₀ + r * u} by
    exact isOpen_lt continuous_const (by fun_prop) |>.measurableSet)]
  apply lintegral_congr
  intro u
  simp only [indicator_apply, mem_ofPred_eq, mem_Ioi]


/-- Complex-valued weak coarea, written with product measures so that no
unjustified interchange of conditionally integrable expressions is used. -/
theorem normalizedCircle_integral_coarea
    (F : Euclidean 2 → Complex) (G : Real → Complex) (x : Euclidean 2) :
    (∫ p : Metric.sphere (0 : Euclidean 2) 1 × Ioi (0 : Real),
      G p.2.1 * F (x + p.2.1 • (p.1 : Euclidean 2))
      ∂((unitSurfaceMeasure 2).prod (Measure.volumeIoiPow 1))) =
    ∫ p : Metric.sphere (0 : Euclidean 2) 1 × Ioi (0 : Real),
      G ‖p.2.1 • (p.1 : Euclidean 2) - x‖ * F (p.2.1 • (p.1 : Euclidean 2))
      ∂((unitSurfaceMeasure 2).prod (Measure.volumeIoiPow 1)) := by
  have hpolar (H : Euclidean 2 → Complex) :
      (∫ y : Euclidean 2, H y) =
        ∫ p : Metric.sphere (0 : Euclidean 2) 1 × Ioi (0 : Real),
          H (p.2.1 • (p.1 : Euclidean 2))
          ∂((unitSurfaceMeasure 2).prod (Measure.volumeIoiPow 1)) :=
    Auto.RadialFourierTransform.integral_polar_unitSurfaceMeasure (by norm_num) H
  calc
    _ = ∫ p : Metric.sphere (0 : Euclidean 2) 1 × Ioi (0 : Real),
        G ‖p.2.1 • (p.1 : Euclidean 2)‖ * F (x + p.2.1 • (p.1 : Euclidean 2))
        ∂((unitSurfaceMeasure 2).prod (Measure.volumeIoiPow 1)) := by
      apply integral_congr_ae
      filter_upwards [] with p
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos p.2.2,
        mem_sphere_zero_iff_norm.mp p.1.2, mul_one]
    _ = ∫ z : Euclidean 2, G ‖z‖ * F (x + z) := (hpolar (fun z => G ‖z‖ * F (x + z))).symm
    _ = ∫ y : Euclidean 2, G ‖y - x‖ * F y := by
      simpa only [add_sub_cancel_left] using
        integral_add_left_eq_self (fun y : Euclidean 2 => G ‖y - x‖ * F y) x
    _ = _ := hpolar (fun y => G ‖y - x‖ * F y)


/-- Physical radial frequencies become the exact normalized incidence
frequency, without a restriction relating the scale to the frequency. -/
theorem normalizedCircleIncidence_physical_radial_frequency
    {t₀ r : Real} (ht₀ : 0 < t₀) (hr : r ≠ 0)
    (X ω : Euclidean 2) (v : Real) (hω : ‖ω‖ = 1) :
    (‖v • ω - r • X‖ - t₀) / r =
      normalizedCircleIncidence (r / t₀) X ω ((v - t₀) / r) := by
  have hv : t₀ + r * ((v - t₀) / r) = v := by field_simp; ring
  have h := normalizedCircleIncidence_physical_distance ht₀ r X ω ((v - t₀) / r) hω
  rw [hv] at h
  rw [h]
  field_simp
  ring

/-- Exact weak normalized kernel representation. The radial power measure
contains the geometric radial Jacobian on both sides. -/
theorem normalizedCircle_integral_kernel
    {t₀ r : Real} (ht₀ : 0 < t₀) (hr : r ≠ 0)
    (F : Euclidean 2 → Complex) (K : Real → Complex)
    (X : Euclidean 2) (s : Real) :
    (∫ p : Metric.sphere (0 : Euclidean 2) 1 × Ioi (0 : Real),
      K (s - (p.2.1 - t₀) / r) * F (r • X + p.2.1 • (p.1 : Euclidean 2))
      ∂((unitSurfaceMeasure 2).prod (Measure.volumeIoiPow 1))) =
    ∫ p : Metric.sphere (0 : Euclidean 2) 1 × Ioi (0 : Real),
      K (s - normalizedCircleIncidence (r / t₀) X (p.1 : Euclidean 2)
        ((p.2.1 - t₀) / r)) * F (p.2.1 • (p.1 : Euclidean 2))
      ∂((unitSurfaceMeasure 2).prod (Measure.volumeIoiPow 1)) := by
  rw [normalizedCircle_integral_coarea F (fun t => K (s - (t - t₀) / r)) (r • X)]
  apply integral_congr_ae
  filter_upwards [] with p
  rw [normalizedCircleIncidence_physical_radial_frequency ht₀ hr X p.1 p.2.1
    (mem_sphere_zero_iff_norm.mp p.1.2)]

/-- The conormal-frequency kernel of the normalized circular family.
The geometric amplitude is displayed separately from the scalar
inverse Fourier transform. -/
def normalizedCircleFrequencyKernel (ε : Real) (b : Real → Complex)
    (X ω : Euclidean 2) (u s : Real) : Complex :=
  (((1 + ε * u) / (1 + ε * s) : Real) : Complex) *
    FourierTransform.fourierInv b (s - normalizedCircleIncidence ε X ω u)

theorem normalizedCircleFrequencyKernel_eq_oscillatory
    (ε : Real) (b : Real → Complex)
    (X ω : Euclidean 2) (u s : Real) :
    normalizedCircleFrequencyKernel ε b X ω u s =
      (((1 + ε * u) / (1 + ε * s) : Real) : Complex) *
        ∫ ρ : Real,
          (Real.fourierChar ((s - normalizedCircleIncidence ε X ω u) * ρ) : Complex) *
            b ρ := by
  rw [normalizedCircleFrequencyKernel, Real.fourierInv_eq]
  simp only [RCLike.inner_apply, conj_trivial, mul_comm,
    Circle.smul_def, smul_eq_mul]


/-- Affine radial substitution for complex kernels. -/
theorem normalizedCircle_integral_radial_change
    (t₀ : Real) {r : Real} (hr : 0 < r) (H : Real → Complex) :
    (r : Complex) *
      (∫ u in {u : Real | 0 < t₀ + r * u}, H (t₀ + r * u)) =
      ∫ t in Ioi (0 : Real), H t := by
  have hchange (J : Real → Complex) :
      (r : Complex) * (∫ u : Real, J (t₀ + r * u)) = ∫ t : Real, J t := by
    have heq := Measure.integral_comp_mul_left (fun v : Real => J (t₀ + v)) r
    rw [abs_of_pos (inv_pos.mpr hr), integral_add_left_eq_self] at heq
    rw [heq]
    change (r : Complex) * (((r⁻¹ : Real) : Complex) * _) = _
    rw [← mul_assoc, ← Complex.ofReal_mul, mul_inv_cancel₀ hr.ne',
      Complex.ofReal_one, one_mul]
  have h := hchange ((Ioi (0 : Real)).indicator H)
  rw [integral_indicator measurableSet_Ioi] at h
  rw [← h]
  congr 1
  rw [← integral_indicator (show MeasurableSet {u : Real | 0 < t₀ + r * u} by
    exact isOpen_lt continuous_const (by fun_prop) |>.measurableSet)]
  apply integral_congr_ae
  filter_upwards [] with u
  simp only [indicator_apply, mem_ofPred_eq, mem_Ioi]


/-- The weak coarea identity in terms of the actual circular-average
operator. The hypotheses are the ordinary absolute-integrability conditions
for the two applications of Fubini. -/
theorem normalizedCircle_integral_average
    (F : Euclidean 2 → Complex) (G : Real → Complex) (x : Euclidean 2)
    (hleft : Integrable
      (fun p : Metric.sphere (0 : Euclidean 2) 1 × Ioi (0 : Real) =>
        G p.2.1 * F (x + p.2.1 • (p.1 : Euclidean 2)))
      ((unitSurfaceMeasure 2).prod (Measure.volumeIoiPow 1)))
    (hright : Integrable
      (fun p : Metric.sphere (0 : Euclidean 2) 1 × Ioi (0 : Real) =>
        G ‖p.2.1 • (p.1 : Euclidean 2) - x‖ * F (p.2.1 • (p.1 : Euclidean 2)))
      ((unitSurfaceMeasure 2).prod (Measure.volumeIoiPow 1))) :
    (∫ t in Ioi (0 : Real), (t : Complex) * (G t * sphericalAverage 2 F t x)) =
    ∫ ω : Metric.sphere (0 : Euclidean 2) 1,
      (∫ v in Ioi (0 : Real), (v : Complex) *
        (G ‖v • (ω : Euclidean 2) - x‖ * F (v • (ω : Euclidean 2))))
      ∂unitSurfaceMeasure 2 := by
  have h := normalizedCircle_integral_coarea F G x
  rw [integral_prod_symm _ hleft, integral_prod _ hright] at h
  simp_rw [integral_const_mul] at h
  change (∫ t : Ioi (0 : Real), G t * sphericalAverage 2 F t x
      ∂Measure.volumeIoiPow 1) = _ at h
  rw [Auto.Spherical.Auxiliary.integral_volumeIoiPow_eq_setIntegral 1
    (fun t => G t * sphericalAverage 2 F t x)] at h
  simp only [pow_one] at h
  rw [h]
  apply integral_congr_ae
  filter_upwards [] with ω
  simpa only [pow_one] using
    Auto.Spherical.Auxiliary.integral_volumeIoiPow_eq_setIntegral 1
      (fun v => G ‖v • (ω : Euclidean 2) - x‖ * F (v • (ω : Euclidean 2)))


/-- Rescaled weak kernel formula, including both radial Jacobians. -/
theorem normalizedCircle_integral_average_rescaled
    {t₀ r : Real} (ht₀ : 0 < t₀) (hr : 0 < r)
    (F : Euclidean 2 → Complex) (K : Real → Complex) (X : Euclidean 2) (s : Real)
    (hleft : Integrable
      (fun p : Metric.sphere (0 : Euclidean 2) 1 × Ioi (0 : Real) =>
        K (s - (p.2.1 - t₀) / r) * F (r • X + p.2.1 • (p.1 : Euclidean 2)))
      ((unitSurfaceMeasure 2).prod (Measure.volumeIoiPow 1)))
    (hright : Integrable
      (fun p : Metric.sphere (0 : Euclidean 2) 1 × Ioi (0 : Real) =>
        K (s - (‖p.2.1 • (p.1 : Euclidean 2) - r • X‖ - t₀) / r) *
          F (p.2.1 • (p.1 : Euclidean 2)))
      ((unitSurfaceMeasure 2).prod (Measure.volumeIoiPow 1))) :
    (∫ τ in {τ : Real | 0 < t₀ + r * τ},
      ((t₀ + r * τ : Real) : Complex) *
        (K (s - τ) * sphericalAverage 2 F (t₀ + r * τ) (r • X))) =
    ∫ ω : Metric.sphere (0 : Euclidean 2) 1,
      (∫ u in {u : Real | 0 < t₀ + r * u},
        ((t₀ + r * u : Real) : Complex) *
          (K (s - normalizedCircleIncidence (r / t₀) X ω u) *
            F ((t₀ + r * u) • (ω : Euclidean 2))))
      ∂unitSurfaceMeasure 2 := by
  have hlin (u : Real) : (t₀ + r * u - t₀) / r = u := by field_simp; ring
  have hout := normalizedCircle_integral_radial_change t₀ hr
    (fun t => (t : Complex) *
      (K (s - (t - t₀) / r) * sphericalAverage 2 F t (r • X)))
  simp only [hlin] at hout
  apply mul_left_cancel₀ (show (r : Complex) ≠ 0 by exact_mod_cast hr.ne')
  rw [hout, normalizedCircle_integral_average F
    (fun t => K (s - (t - t₀) / r)) (r • X) hleft hright,
    ← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [] with ω
  have hin := normalizedCircle_integral_radial_change t₀ hr
    (fun v => (v : Complex) *
      (K (s - (‖v • (ω : Euclidean 2) - r • X‖ - t₀) / r) *
        F (v • (ω : Euclidean 2))))
  rw [← hin]
  congr 1
  apply setIntegral_congr_fun (show MeasurableSet {u : Real | 0 < t₀ + r * u} by
    exact isOpen_lt continuous_const (by fun_prop) |>.measurableSet)
  intro u hu
  dsimp only
  rw [normalizedCircleIncidence_physical_radial_frequency ht₀ hr.ne' X ω
    (t₀ + r * u) (mem_sphere_zero_iff_norm.mp ω.2), hlin]


/-- The radial-density amplitude is smooth across zero scale. -/
theorem normalizedCircleAmplitude_contDiffAt
    (z : Real × Real × Real) (hz : 1 + z.1 * z.2.2 ≠ 0) :
    ContDiffAt Real (⊤ : ℕ∞)
      (fun q : Real × Real × Real => (1 + q.1 * q.2.1) / (1 + q.1 * q.2.2)) z := by
  exact (show ContDiffAt Real (⊤ : ℕ∞) (fun q : Real × Real × Real =>
    1 + q.1 * q.2.1) z by fun_prop).div (by fun_prop) hz

/-- Uniform symbol seminorms of the geometric amplitude on compact
normalized parameter regions separated from a zero output radius. -/
theorem normalizedCircleAmplitude_uniform_derivatives
    (K : Set (Real × Real × Real)) (hK : IsCompact K)
    (hsep : ∀ z ∈ K, 1 + z.1 * z.2.2 ≠ 0) (n : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ z ∈ K,
      ‖iteratedFDeriv Real n
        (fun q : Real × Real × Real => (1 + q.1 * q.2.1) / (1 + q.1 * q.2.2)) z‖ ≤ C := by
  have hc : ContinuousOn (iteratedFDeriv Real n
      (fun q : Real × Real × Real => (1 + q.1 * q.2.1) / (1 + q.1 * q.2.2))) K := by
    intro z hz
    exact ((normalizedCircleAmplitude_contDiffAt z (hsep z hz)).continuousAt_iteratedFDeriv
      (by simp)).continuousWithinAt
  obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn hc
  exact ⟨max C 0, le_max_right _ _, fun z hz => (hC z hz).trans (le_max_left _ _)⟩

/-- Uniform upper and lower bounds for the geometric amplitude on the
normalized coordinate region. -/
theorem normalizedCircleAmplitude_bounds (ε u s : Real)
    (hsmall : |ε| * (|u| + |s|) ≤ 1 / 2) :
    1 / 3 ≤ (1 + ε * u) / (1 + ε * s) ∧
      (1 + ε * u) / (1 + ε * s) ≤ 3 := by
  have hu : |ε * u| ≤ 1 / 2 := by
    rw [abs_mul]
    nlinarith [abs_nonneg ε, abs_nonneg u, abs_nonneg s]
  have hs : |ε * s| ≤ 1 / 2 := by
    rw [abs_mul]
    nlinarith [abs_nonneg ε, abs_nonneg u, abs_nonneg s]
  obtain ⟨hu₀, hu₁⟩ := abs_le.mp hu
  obtain ⟨hs₀, hs₁⟩ := abs_le.mp hs
  have hp : 0 < 1 + ε * s := by linarith
  constructor
  · apply (le_div_iff₀ hp).mpr
    linarith
  · apply (div_le_iff₀ hp).mpr
    linarith


/-- Cancellation of the output radial density in the normalized Fourier
kernel leaves exactly the input polar Jacobian. -/
theorem normalizedCircleFrequencyKernel_mul_radius
    {t₀ r : Real} (ht₀ : 0 < t₀) (X ω : Euclidean 2) (u s : Real)
    (hs : t₀ + r * s ≠ 0) (b : Real → Complex) :
    ((t₀ + r * s : Real) : Complex) *
      normalizedCircleFrequencyKernel (r / t₀) b X ω u s =
    ((t₀ + r * u : Real) : Complex) *
      FourierTransform.fourierInv b (s - normalizedCircleIncidence (r / t₀) X ω u) := by
  have hd : 1 + r / t₀ * s ≠ 0 := by
    intro h
    apply hs
    field_simp at h
    nlinarith
  have hc : (t₀ + r * s) * ((1 + r / t₀ * u) / (1 + r / t₀ * s)) =
      t₀ + r * u := by
    field_simp
  rw [normalizedCircleFrequencyKernel, ← mul_assoc, ← Complex.ofReal_mul, hc]

/-- The exact conormal-frequency representation of the temporally smoothed
circular average. The two positive radial-density factors are explicit. -/
theorem normalizedCircle_integral_frequencyKernel
    {t₀ r : Real} (ht₀ : 0 < t₀) (hr : 0 < r)
    (F : Euclidean 2 → Complex) (b : Real → Complex) (X : Euclidean 2) (s : Real)
    (hs : t₀ + r * s ≠ 0)
    (hleft : Integrable
      (fun p : Metric.sphere (0 : Euclidean 2) 1 × Ioi (0 : Real) =>
        FourierTransform.fourierInv b (s - (p.2.1 - t₀) / r) *
          F (r • X + p.2.1 • (p.1 : Euclidean 2)))
      ((unitSurfaceMeasure 2).prod (Measure.volumeIoiPow 1)))
    (hright : Integrable
      (fun p : Metric.sphere (0 : Euclidean 2) 1 × Ioi (0 : Real) =>
        FourierTransform.fourierInv b
          (s - (‖p.2.1 • (p.1 : Euclidean 2) - r • X‖ - t₀) / r) *
          F (p.2.1 • (p.1 : Euclidean 2)))
      ((unitSurfaceMeasure 2).prod (Measure.volumeIoiPow 1))) :
    (∫ τ in {τ : Real | 0 < t₀ + r * τ},
      ((t₀ + r * τ : Real) : Complex) *
        (FourierTransform.fourierInv b (s - τ) *
          sphericalAverage 2 F (t₀ + r * τ) (r • X))) =
    ((t₀ + r * s : Real) : Complex) *
      ∫ ω : Metric.sphere (0 : Euclidean 2) 1,
        (∫ u in {u : Real | 0 < t₀ + r * u},
          normalizedCircleFrequencyKernel (r / t₀) b X ω u s *
            F ((t₀ + r * u) • (ω : Euclidean 2)))
        ∂unitSurfaceMeasure 2 := by
  rw [normalizedCircle_integral_average_rescaled ht₀ hr F
    (FourierTransform.fourierInv b) X s hleft hright, ← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [] with ω
  rw [← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [] with u
  simp only [← mul_assoc, normalizedCircleFrequencyKernel_mul_radius ht₀ X ω u s hs b]


private theorem normalizedCircle_integrable_polar
    (H : Euclidean 2 → Complex) (hH : Continuous H) (hI : Integrable H) :
    Integrable
      (fun p : Metric.sphere (0 : Euclidean 2) 1 × Ioi (0 : Real) =>
        H (p.2.1 • (p.1 : Euclidean 2)))
      ((unitSurfaceMeasure 2).prod (Measure.volumeIoiPow 1)) := by
  refine ⟨(show Continuous (fun p : Metric.sphere (0 : Euclidean 2) 1 × Ioi (0 : Real) =>
    H (p.2.1 • (p.1 : Euclidean 2))) by fun_prop).aestronglyMeasurable, ?_⟩
  rw [hasFiniteIntegral_iff_enorm] at *
  change (∫⁻ p : Metric.sphere (0 : Euclidean 2) 1 × Ioi (0 : Real),
    ‖H (p.2.1 • (p.1 : Euclidean 2))‖ₑ
      ∂((unitSurfaceMeasure 2).prod (Measure.volumeIoiPow (2 - 1)))) < ⊤
  rw [← lintegral_polar_unitSurfaceMeasure (by norm_num : 0 < 2) (fun y => ‖H y‖ₑ)]
  exact hI.hasFiniteIntegral

/-- Both Fubini hypotheses in the normalized kernel formula hold for
Schwartz inputs and Schwartz one-dimensional kernels. -/
theorem normalizedCircle_kernel_integrable
    (t₀ r : Real) (F : SchwartzMap (Euclidean 2) Complex)
    (K : SchwartzMap Real Complex) (X : Euclidean 2) (s : Real) :
    Integrable
      (fun p : Metric.sphere (0 : Euclidean 2) 1 × Ioi (0 : Real) =>
        K (s - (p.2.1 - t₀) / r) * F (r • X + p.2.1 • (p.1 : Euclidean 2)))
      ((unitSurfaceMeasure 2).prod (Measure.volumeIoiPow 1)) ∧
    Integrable
      (fun p : Metric.sphere (0 : Euclidean 2) 1 × Ioi (0 : Real) =>
        K (s - (‖p.2.1 • (p.1 : Euclidean 2) - r • X‖ - t₀) / r) *
          F (p.2.1 • (p.1 : Euclidean 2)))
      ((unitSurfaceMeasure 2).prod (Measure.volumeIoiPow 1)) := by
  have hbound (v : Real) := K.norm_le_seminorm Real v
  constructor
  · have hI : Integrable (fun z : Euclidean 2 =>
        K (s - (‖z‖ - t₀) / r) * F (r • X + z)) :=
      (F.integrable.comp_add_left (r • X)).bdd_mul
        (by exact (show Continuous (fun z : Euclidean 2 => K (s - (‖z‖ - t₀) / r)) by
          fun_prop).aestronglyMeasurable)
        (Filter.Eventually.of_forall (fun z => hbound _))
    have hp := normalizedCircle_integrable_polar _ (by fun_prop) hI
    apply hp.congr
    filter_upwards [] with p
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos p.2.2,
      mem_sphere_zero_iff_norm.mp p.1.2, mul_one]
  · apply normalizedCircle_integrable_polar
      (fun y => K (s - (‖y - r • X‖ - t₀) / r) * F y) (by fun_prop)
    exact F.integrable.bdd_mul
      (by exact (show Continuous (fun y : Euclidean 2 =>
        K (s - (‖y - r • X‖ - t₀) / r)) by fun_prop).aestronglyMeasurable)
      (Filter.Eventually.of_forall (fun y => hbound _))


/-- Unconditional Schwartz-core version of the normalized conormal-frequency
representation, with all change-of-variables and Fubini obligations proved. -/
theorem normalizedCircle_schwartz_frequency_representation
    {t₀ r : Real} (ht₀ : 0 < t₀) (hr : 0 < r)
    (F : SchwartzMap (Euclidean 2) Complex) (b : SchwartzMap Real Complex)
    (X : Euclidean 2) (s : Real) (hs : t₀ + r * s ≠ 0) :
    (∫ τ in {τ : Real | 0 < t₀ + r * τ},
      ((t₀ + r * τ : Real) : Complex) *
        (FourierTransform.fourierInv (b : Real → Complex) (s - τ) *
          sphericalAverage 2 F (t₀ + r * τ) (r • X))) =
    ((t₀ + r * s : Real) : Complex) *
      ∫ ω : Metric.sphere (0 : Euclidean 2) 1,
        (∫ u in {u : Real | 0 < t₀ + r * u},
          normalizedCircleFrequencyKernel (r / t₀) (b : Real → Complex) X ω u s *
            F ((t₀ + r * u) • (ω : Euclidean 2)))
        ∂unitSurfaceMeasure 2 := by
  obtain ⟨hleft, hright⟩ := normalizedCircle_kernel_integrable t₀ r F
    (FourierTransform.fourierInv b) X s
  exact normalizedCircle_integral_frequencyKernel ht₀ hr F b X s hs
    (by simpa only [SchwartzMap.fourierInv_coe] using hleft)
    (by simpa only [SchwartzMap.fourierInv_coe] using hright)
