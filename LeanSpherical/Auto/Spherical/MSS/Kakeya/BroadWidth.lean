/-- The literal physical space-time finite tensor associated to a finite
frequency/time tensor.  This is spatial inverse Fourier transform only. -/
noncomputable def finiteTensorPhysicalTimeData
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
    (p : Euclidean 2 × Real) : Complex :=
  ∑ i ∈ s, (FourierTransform.fourierInv (q i) :
    SchwartzMap (Euclidean 2) Complex) p.1 * a i p.2

private theorem continuous_finiteTensorPhysicalTimeData
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) :
    Continuous (finiteTensorPhysicalTimeData s q a) := by
  unfold finiteTensorPhysicalTimeData
  exact continuous_finsetSum _ fun i hi =>
    ((FourierTransform.fourierInv (q i) :
      SchwartzMap (Euclidean 2) Complex).continuous.comp continuous_fst).mul
      ((a i).continuous.comp continuous_snd)

private theorem memLp_two_finiteTensorPhysicalTimeData_term
    {ι : Type*} (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) (i : ι) :
    MemLp (fun p : Euclidean 2 × Real =>
      (FourierTransform.fourierInv (q i) :
        SchwartzMap (Euclidean 2) Complex) p.1 * a i p.2) 2
      (volume.prod volume) := by
  apply (memLp_two_iff_integrable_sq_norm
    (((FourierTransform.fourierInv (q i) :
      SchwartzMap (Euclidean 2) Complex).continuous.comp continuous_fst).mul
      ((a i).continuous.comp continuous_snd)).aestronglyMeasurable).mpr
  have hq : Integrable (fun x : Euclidean 2 =>
      ‖(FourierTransform.fourierInv (q i) :
        SchwartzMap (Euclidean 2) Complex) x‖ ^ 2) volume :=
    (memLp_two_iff_integrable_sq_norm
      (FourierTransform.fourierInv (q i) :
        SchwartzMap (Euclidean 2) Complex).continuous.aestronglyMeasurable).mp
      ((FourierTransform.fourierInv (q i) :
        SchwartzMap (Euclidean 2) Complex).memLp 2 volume)
  have ha : Integrable (fun t : Real => ‖a i t‖ ^ 2) volume :=
    (memLp_two_iff_integrable_sq_norm (a i).continuous.aestronglyMeasurable).mp
      ((a i).memLp 2 volume)
  simpa only [Function.comp_apply, Pi.mul_apply, norm_mul, mul_pow] using
    (hq.mul_prod ha)

/-- The literal physical finite tensor has finite joint `L²` energy. -/
theorem integrable_sq_finiteTensorPhysicalTimeData
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) :
    Integrable (fun p : Euclidean 2 × Real =>
      ‖finiteTensorPhysicalTimeData s q a p‖ ^ 2) (volume.prod volume) := by
  apply (memLp_two_iff_integrable_sq_norm
    (continuous_finiteTensorPhysicalTimeData s q a).aestronglyMeasurable).mp
  unfold finiteTensorPhysicalTimeData
  exact memLp_finsetSum s fun i hi =>
    memLp_two_finiteTensorPhysicalTimeData_term q a i

private theorem continuous_scratch_finiteTensorTimeData_product
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) :
    Continuous (fun p : Euclidean 2 × Real =>
      scratch_finiteTensorTimeData s q a p.1 p.2) := by
  unfold scratch_finiteTensorTimeData
  exact continuous_finsetSum _ fun i hi =>
    ((q i).continuous.comp continuous_fst).mul ((a i).continuous.comp continuous_snd)

private theorem memLp_two_scratch_finiteTensorTimeData_product_term
    {ι : Type*} (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) (i : ι) :
    MemLp (fun p : Euclidean 2 × Real => q i p.1 * a i p.2) 2
      (volume.prod volume) := by
  apply (memLp_two_iff_integrable_sq_norm
    (((q i).continuous.comp continuous_fst).mul
      ((a i).continuous.comp continuous_snd)).aestronglyMeasurable).mpr
  have hq : Integrable (fun x : Euclidean 2 => ‖q i x‖ ^ 2) volume :=
    (memLp_two_iff_integrable_sq_norm (q i).continuous.aestronglyMeasurable).mp
      ((q i).memLp 2 volume)
  have ha : Integrable (fun t : Real => ‖a i t‖ ^ 2) volume :=
    (memLp_two_iff_integrable_sq_norm (a i).continuous.aestronglyMeasurable).mp
      ((a i).memLp 2 volume)
  simpa only [Function.comp_apply, Pi.mul_apply, norm_mul, mul_pow] using
    (hq.mul_prod ha)

/-- The finite frequency/time tensor has finite joint `L²` energy without
any supplemental integrability premise. -/
theorem integrable_sq_scratch_finiteTensorTimeData_product
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) :
    Integrable (fun p : Euclidean 2 × Real =>
      ‖scratch_finiteTensorTimeData s q a p.1 p.2‖ ^ 2) (volume.prod volume) := by
  apply (memLp_two_iff_integrable_sq_norm
    (continuous_scratch_finiteTensorTimeData_product s q a).aestronglyMeasurable).mp
  unfold scratch_finiteTensorTimeData
  exact memLp_finsetSum s fun i hi =>
    memLp_two_scratch_finiteTensorTimeData_product_term q a i

private theorem integral_norm_sq_finiteTensorPhysicalTime_slice_eq_frequency
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) (t : Real) :
    (∫ x : Euclidean 2, ‖finiteTensorPhysicalTimeData s q a (x, t)‖ ^ 2) =
      ∫ xi : Euclidean 2, ‖scratch_finiteTensorTimeData s q a xi t‖ ^ 2 := by
  let Q : SchwartzMap (Euclidean 2) Complex :=
    ∑ i ∈ s, a i t • FourierTransform.fourierInv (q i)
  have hphys (x : Euclidean 2) : Q x =
      finiteTensorPhysicalTimeData s q a (x, t) := by
    dsimp [Q, finiteTensorPhysicalTimeData]
    rw [sum_apply]
    apply Finset.sum_congr rfl
    intro i hi
    rw [smul_apply]
    simp only [smul_eq_mul]
    ring
  have hfreq (xi : Euclidean 2) :
      FourierTransform.fourier (Q : Euclidean 2 → Complex) xi =
        scratch_finiteTensorTimeData s q a xi t := by
    rw [← SchwartzMap.fourier_coe]
    dsimp [Q]
    rw [FourierTransform.fourier_sum, sum_apply]
    apply Finset.sum_congr rfl
    intro i hi
    rw [FourierTransform.fourier_smul, smul_apply,
      FourierTransform.fourier_fourierInv_eq]
    simp only [smul_eq_mul]
    ring
  have hplanch :=
    Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq Q
  calc
    (∫ x : Euclidean 2, ‖finiteTensorPhysicalTimeData s q a (x, t)‖ ^ 2) =
        ∫ x : Euclidean 2, ‖Q x‖ ^ 2 := by
          apply integral_congr_ae
          filter_upwards with x
          rw [hphys]
    _ = ∫ xi : Euclidean 2,
        ‖FourierTransform.fourier (Q : Euclidean 2 → Complex) xi‖ ^ 2 :=
      hplanch.symm
    _ = ∫ xi : Euclidean 2,
        ‖scratch_finiteTensorTimeData s q a xi t‖ ^ 2 := by
          apply integral_congr_ae
          filter_upwards with xi
          rw [hfreq]

/-- Product-space Plancherel for a finite separated tensor.  Thus the
frequency/time energy used in the lowpass estimate is literally the physical
space-time `L²` energy of the finite tensor. -/
theorem finiteTensorFrequencyTimeEnergy_eq_integral_norm_sq_physical
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) :
    finiteTensorFrequencyTimeEnergy s q a =
      ∫ p : Euclidean 2 × Real, ‖finiteTensorPhysicalTimeData s q a p‖ ^ 2
        ∂(volume.prod volume) := by
  have hfreq := integrable_sq_scratch_finiteTensorTimeData_product s q a
  have hphys := integrable_sq_finiteTensorPhysicalTimeData s q a
  unfold finiteTensorFrequencyTimeEnergy
  rw [integral_prod_symm _ hfreq, integral_prod_symm _ hphys]
  apply integral_congr_ae
  filter_upwards with t
  exact (integral_norm_sq_finiteTensorPhysicalTime_slice_eq_frequency s q a t).symm

end

end Auto.Spherical.MSS
