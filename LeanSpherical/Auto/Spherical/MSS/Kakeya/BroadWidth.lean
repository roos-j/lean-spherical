def HasFiniteCoreLowpassAngularTraceEnergy
    {ι : Type*} (C : lpCutoffs 2)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
    (E : Real) : Prop :=
  Integrable (fun p : Real × Euclidean 2 =>
    ‖intDyadicLowpassMultiplier C.cutoff 0 p.2 *
      finiteTensorTubeMultiplierAngularDeriv s q a p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume) ∧
    (∫ p : Real × Euclidean 2,
      ‖intDyadicLowpassMultiplier C.cutoff 0 p.2 *
        finiteTensorTubeMultiplierAngularDeriv s q a p.1 p.2‖ ^ 2 ∂
        ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume)) ≤ E

/-- Canonical multiplication turns the exact lowpass angular-trace helper
into the `E₁` frequency bound needed by the lowpass `H¹` estimate.  The
derivative family itself is deliberately supplied: packaging it as a
Schwartz family is a regularity task independent of this energy argument. -/
theorem integral_norm_sq_canonicalLowpassAngularDerivative_le_of_traceEnergy
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
    (dm : Real → SchwartzMap (Euclidean 2) Complex) (E : Real)
    (hfactor : ∀ theta xi, dm theta xi =
      scratch_canonicalBandlimitedTubeMultiplier rho hrho xi *
        (intDyadicLowpassMultiplier C.cutoff 0 xi *
          finiteTensorTubeMultiplierAngularDeriv s q a theta xi))
    (hdmint : Integrable (fun p : Real × Euclidean 2 => ‖dm p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume))
    (htrace : HasFiniteCoreLowpassAngularTraceEnergy C s q a E) :
    (∫ p : Real × Euclidean 2, ‖dm p.1 p.2‖ ^ 2 ∂
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume)) ≤
      canonicalTubeMultiplierUniformBound ^ 2 * E := by
  let μ : Measure (Real × Euclidean 2) :=
    (volume.restrict (Icc (-Real.pi) Real.pi)).prod volume
  let d0 : Real × Euclidean 2 → Complex := fun p =>
    intDyadicLowpassMultiplier C.cutoff 0 p.2 *
      finiteTensorTubeMultiplierAngularDeriv s q a p.1 p.2
  have hd0 : Integrable (fun p : Real × Euclidean 2 => ‖d0 p‖ ^ 2) μ := by
    simpa only [d0, μ] using htrace.1
  have hscaled : Integrable (fun p : Real × Euclidean 2 =>
      canonicalTubeMultiplierUniformBound ^ 2 * ‖d0 p‖ ^ 2) μ :=
    hd0.const_mul _
  have hpoint (p : Real × Euclidean 2) : ‖dm p.1 p.2‖ ^ 2 ≤
      canonicalTubeMultiplierUniformBound ^ 2 * ‖d0 p‖ ^ 2 := by
    rw [hfactor]
    have hcan := norm_scratch_canonicalBandlimitedTubeMultiplier_le_uniformBound
      hrho p.2
    have hnonneg : 0 ≤ canonicalTubeMultiplierUniformBound * ‖d0 p‖ := by
      exact mul_nonneg (by
        dsimp [canonicalTubeMultiplierUniformBound]
        positivity) (norm_nonneg _)
    have hmul : ‖scratch_canonicalBandlimitedTubeMultiplier rho hrho p.2 * d0 p‖ ≤
        canonicalTubeMultiplierUniformBound * ‖d0 p‖ := by
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_right hcan (norm_nonneg _)
    have hsq := (sq_le_sq₀ (norm_nonneg _) hnonneg).mpr hmul
    calc
      ‖scratch_canonicalBandlimitedTubeMultiplier rho hrho p.2 * d0 p‖ ^ 2 ≤
          (canonicalTubeMultiplierUniformBound * ‖d0 p‖) ^ 2 := hsq
      _ = canonicalTubeMultiplierUniformBound ^ 2 * ‖d0 p‖ ^ 2 := by ring
  calc
    (∫ p : Real × Euclidean 2, ‖dm p.1 p.2‖ ^ 2 ∂
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume)) =
        ∫ p : Real × Euclidean 2, ‖dm p.1 p.2‖ ^ 2 ∂μ := by rfl
    _ ≤ ∫ p : Real × Euclidean 2,
        canonicalTubeMultiplierUniformBound ^ 2 * ‖d0 p‖ ^ 2 ∂μ :=
      integral_mono hdmint hscaled hpoint
    _ = canonicalTubeMultiplierUniformBound ^ 2 *
        ∫ p : Real × Euclidean 2, ‖d0 p‖ ^ 2 ∂μ := integral_const_mul _ _
    _ ≤ canonicalTubeMultiplierUniformBound ^ 2 * E :=
      mul_le_mul_of_nonneg_left (by simpa only [d0, μ] using htrace.2) (sq_nonneg _)

/-- The expected compact-time phase-trace helper has a completely explicit
uniform target constant.  It is recorded separately so no unsigned-kernel
or raw signed-field domination is hidden in the lowpass argument. -/
def HasFiniteCoreLowpassAngularTraceEnergyBound
    {ι : Type*} (C : lpCutoffs 2)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) : Prop :=
  HasFiniteCoreLowpassAngularTraceEnergy C s q a
    (400 * Real.pi ^ 3 * finiteTensorFrequencyTimeEnergy s q a)

end

