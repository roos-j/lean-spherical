      ∫ x : Euclidean 2,
        (lightRayKernel rho N 0 x (y, 0) : Complex) * scratch_normInput g x t)
      2 (volume.restrict lightRayTimeInterval))
    (hinput : Integrable (fun p : Real × Euclidean 2 =>
      ‖scratch_normInput g p.2 p.1‖ ^ 2)
      ((volume.restrict lightRayTimeInterval).prod volume))
    (hspOutput : ∀ t : Real, AEStronglyMeasurable (fun y : Euclidean 2 =>
      ∫ x : Euclidean 2,
        (lightRayKernel rho N 0 x (y, 0) : Complex) * scratch_normInput g x t) volume)
    (hspEnergy : ∀ t : Real, Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      lightRayKernel rho N 0 p.2 (p.1, 0) * ‖scratch_normInput g p.2 t‖ ^ 2)
      (volume.prod volume))
    (hspMeas : ∀ t y, AEStronglyMeasurable (fun x : Euclidean 2 =>
      (lightRayKernel rho N 0 x (y, 0))⁻¹ *
        ‖(lightRayKernel rho N 0 x (y, 0) : Complex) * scratch_normInput g x t‖ ^ 2)
      volume)
    (hspSliceEnergy : ∀ t y, Integrable (fun x : Euclidean 2 =>
      lightRayKernel rho N 0 x (y, 0) * ‖scratch_normInput g x t‖ ^ 2) volume) :
    (∫ y : Euclidean 2,
      ‖scratch_zeroDirectionLightRayComplexEnvelope rho N y g‖ ^ 2) ≤
      (volume.restrict lightRayTimeInterval).real univ *
        (∫ u : Euclidean 2, lightRayDecayProfile N u) ^ 2 *
          ∫ t in lightRayTimeInterval,
            ∫ x : Euclidean 2, ‖scratch_normInput g x t‖ ^ 2 := by
  letI : IsFiniteMeasure (volume.restrict lightRayTimeInterval) := by
    unfold lightRayTimeInterval
    infer_instance
  simpa only [scratch_zeroDirectionLightRayComplexEnvelope, scratch_normInput] using
    (scratch_integral_sq_zeroDirectionTubeEnvelope_le
      (volume.restrict lightRayTimeInterval) hrho N hN (scratch_normInput g)
      houtput hprod hprod_swap hslice hinput hspOutput hspEnergy hspMeas hspSliceEnergy)

/-- Clean spelling of the preceding zero-direction estimate in terms of the
original space-time input norm. -/
theorem scratch_integral_sq_zeroDirectionLightRayComplexEnvelope_le_norm
    {rho : Real} (hrho : 0 < rho) (N : Nat) (hN : 2 < N)
    (g : WaveSpaceTime → Complex)
    (houtput : AEStronglyMeasurable (fun y : Euclidean 2 =>
      scratch_zeroDirectionLightRayComplexEnvelope rho N y g) volume)
    (hprod : Integrable (fun p : Euclidean 2 × Real =>
      ‖∫ x : Euclidean 2,
        (lightRayKernel rho N 0 x (p.1, 0) : Complex) *
          scratch_normInput g x p.2‖ ^ 2)
      (volume.prod (volume.restrict lightRayTimeInterval)))
    (hprod_swap : Integrable (fun p : Real × Euclidean 2 =>
      ‖∫ x : Euclidean 2,
        (lightRayKernel rho N 0 x (p.2, 0) : Complex) *
          scratch_normInput g x p.1‖ ^ 2)
      ((volume.restrict lightRayTimeInterval).prod volume))
    (hslice : ∀ y : Euclidean 2, MemLp (fun t =>
      ∫ x : Euclidean 2,
        (lightRayKernel rho N 0 x (y, 0) : Complex) * scratch_normInput g x t)
      2 (volume.restrict lightRayTimeInterval))
    (hinput : Integrable (fun p : Real × Euclidean 2 =>
      ‖scratch_normInput g p.2 p.1‖ ^ 2)
      ((volume.restrict lightRayTimeInterval).prod volume))
    (hspOutput : ∀ t : Real, AEStronglyMeasurable (fun y : Euclidean 2 =>
      ∫ x : Euclidean 2,
        (lightRayKernel rho N 0 x (y, 0) : Complex) * scratch_normInput g x t) volume)
    (hspEnergy : ∀ t : Real, Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      lightRayKernel rho N 0 p.2 (p.1, 0) * ‖scratch_normInput g p.2 t‖ ^ 2)
      (volume.prod volume))
    (hspMeas : ∀ t y, AEStronglyMeasurable (fun x : Euclidean 2 =>
      (lightRayKernel rho N 0 x (y, 0))⁻¹ *
        ‖(lightRayKernel rho N 0 x (y, 0) : Complex) * scratch_normInput g x t‖ ^ 2)
      volume)
    (hspSliceEnergy : ∀ t y, Integrable (fun x : Euclidean 2 =>
      lightRayKernel rho N 0 x (y, 0) * ‖scratch_normInput g x t‖ ^ 2) volume) :
    (∫ y : Euclidean 2,
      ‖scratch_zeroDirectionLightRayComplexEnvelope rho N y g‖ ^ 2) ≤
      (volume.restrict lightRayTimeInterval).real univ *
        (∫ u : Euclidean 2, lightRayDecayProfile N u) ^ 2 *
          ∫ t in lightRayTimeInterval,
            ∫ x : Euclidean 2, ‖g (x, t)‖ ^ 2 := by
  have hbase := scratch_integral_sq_zeroDirectionLightRayComplexEnvelope_le
    hrho N hN g houtput hprod hprod_swap hslice hinput hspOutput hspEnergy hspMeas
      hspSliceEnergy
  simpa only [scratch_normInput_norm] using hbase

/-- The finite-time Cauchy step also gives the integrability of its terminal
`L²` output, not merely the numerical estimate. -/
theorem scratch_integrable_sq_timeAverage
    {α : Type*} [MeasurableSpace α] (mu : Measure α) [IsFiniteMeasure mu]
    (F : Euclidean 2 → α → Complex)
    (houtput : AEStronglyMeasurable (fun y : Euclidean 2 =>
      ∫ t, F y t ∂mu) volume)
    (hprod : Integrable (fun p : Euclidean 2 × α => ‖F p.1 p.2‖ ^ 2)
      (volume.prod mu))
    (hslice : ∀ y : Euclidean 2, MemLp (F y) 2 mu) :
    Integrable (fun y : Euclidean 2 => ‖∫ t, F y t ∂mu‖ ^ 2) volume := by
  have hright : Integrable (fun y : Euclidean 2 =>
      mu.real univ * ∫ t, ‖F y t‖ ^ 2 ∂mu) volume :=
    hprod.integral_prod_left.const_mul _
  refine Integrable.mono hright (houtput.norm.pow 2) ?_
  filter_upwards with y
  rw [Real.norm_of_nonneg (sq_nonneg _),
    Real.norm_of_nonneg (mul_nonneg measureReal_nonneg
      (integral_nonneg fun _ => sq_nonneg _))]
  exact Auto.Spherical.Auxiliary.norm_integral_sq_le_measureReal_mul_integral_norm_sq
    mu (F y) (hslice y)

/-- Both broad-width averages are pointwise nonnegative for the positive
smooth core and positive zero-direction kernel. -/
theorem scratch_smoothLightRayCoreAverage_nonneg
    (rho : Real) (omega y : Euclidean 2) (g : WaveSpaceTime → Complex) :
    0 ≤ scratch_smoothLightRayCoreAverage rho omega y g := by
  unfold scratch_smoothLightRayCoreAverage smoothLightRayCore
  apply integral_nonneg
  intro t
  apply integral_nonneg
  intro x
  exact mul_nonneg
    (mul_nonneg (sq_nonneg _) (spatialCoreBump_nonneg _))
    (norm_nonneg _)

theorem scratch_zeroDirectionLightRayEnvelope_nonneg
    {rho : Real} (hrho : 0 < rho) (N : Nat)
    (y : Euclidean 2) (g : WaveSpaceTime → Complex) :
    0 ≤ scratch_zeroDirectionLightRayEnvelope rho N y g := by
  unfold scratch_zeroDirectionLightRayEnvelope
  apply integral_nonneg
  intro t
  apply integral_nonneg
  intro x
  exact mul_nonneg (lightRayKernel_nonneg hrho N 0 x (y, 0)) (norm_nonneg _)

/-- The zero-direction positive real envelope has an integrable square under
the same three time-Cauchy regularity hypotheses as its complex form. -/
theorem scratch_integrable_sq_zeroDirectionLightRayEnvelope
    {rho : Real} (hrho : 0 < rho) (N : Nat)
    (g : WaveSpaceTime → Complex)
    (houtput : AEStronglyMeasurable (fun y : Euclidean 2 =>
      scratch_zeroDirectionLightRayComplexEnvelope rho N y g) volume)
    (hprod : Integrable (fun p : Euclidean 2 × Real =>
      ‖∫ x : Euclidean 2,
        (lightRayKernel rho N 0 x (p.1, 0) : Complex) *
          scratch_normInput g x p.2‖ ^ 2)
      (volume.prod (volume.restrict lightRayTimeInterval)))
    (hslice : ∀ y : Euclidean 2, MemLp (fun t =>
      ∫ x : Euclidean 2,
        (lightRayKernel rho N 0 x (y, 0) : Complex) * scratch_normInput g x t)
      2 (volume.restrict lightRayTimeInterval)) :
    Integrable (fun y : Euclidean 2 =>
      scratch_zeroDirectionLightRayEnvelope rho N y g ^ 2) volume := by
  letI : IsFiniteMeasure (volume.restrict lightRayTimeInterval) := by
    unfold lightRayTimeInterval
    infer_instance
  have hcomplex : Integrable (fun y : Euclidean 2 =>
      ‖scratch_zeroDirectionLightRayComplexEnvelope rho N y g‖ ^ 2) volume := by
    simpa only [scratch_zeroDirectionLightRayComplexEnvelope, scratch_normInput] using
      (scratch_integrable_sq_timeAverage
        (volume.restrict lightRayTimeInterval)
        (fun y t => ∫ x : Euclidean 2,
          (lightRayKernel rho N 0 x (y, 0) : Complex) * scratch_normInput g x t)
        houtput hprod hslice)
  refine hcomplex.congr ?_
  filter_upwards with y
  rw [scratch_norm_zeroDirectionLightRayComplexEnvelope]
  rw [Real.norm_of_nonneg
    (scratch_zeroDirectionLightRayEnvelope_nonneg hrho N y g)]

/-- Squaring the already-integrated broad positive envelope is a standalone
reduction from the normalized smooth core to its fixed zero-direction form. -/
theorem scratch_integral_sq_smoothLightRayCoreAverage_le
    (rho : Real) (omega : Euclidean 2) (N : Nat)
    (g : WaveSpaceTime → Complex)
    (hpoint : ∀ y : Euclidean 2,
      scratch_smoothLightRayCoreAverage rho omega y g ≤
        (17 : Real) ^ N * scratch_zeroDirectionLightRayEnvelope rho N y g)
    (hcore_nonneg : ∀ y : Euclidean 2,
      0 ≤ scratch_smoothLightRayCoreAverage rho omega y g)
    (henv_nonneg : ∀ y : Euclidean 2,
      0 ≤ scratch_zeroDirectionLightRayEnvelope rho N y g)
    (hcore_sq : Integrable (fun y : Euclidean 2 =>
      scratch_smoothLightRayCoreAverage rho omega y g ^ 2) volume)
    (henv_sq : Integrable (fun y : Euclidean 2 =>
      scratch_zeroDirectionLightRayEnvelope rho N y g ^ 2) volume) :
    (∫ y : Euclidean 2,
      scratch_smoothLightRayCoreAverage rho omega y g ^ 2) ≤
      ((17 : Real) ^ N) ^ 2 * ∫ y : Euclidean 2,
        scratch_zeroDirectionLightRayEnvelope rho N y g ^ 2 := by
  simpa only [← scratch_smoothLightRayCoreAverage_eq_positiveSmoothTubeAverage,
    ← scratch_zeroDirectionLightRayEnvelope_eq_positiveEnvelope] using
    (scratch_integral_sq_positiveSmoothTubeAverage_le
      (spatialCoreBump : Euclidean 2 → Real) rho omega N
      (fun x t => ‖g (x, t)‖) hpoint hcore_nonneg henv_nonneg hcore_sq henv_sq)

/-- The routine slice/Fubini data needed to turn the pointwise broad envelope
into a genuine terminal `L²` estimate.  This is deliberately separate from
the analytic broad-width estimate. -/
structure ScratchSmoothLightRayCoreBroadRegularity
    (rho : Real) (omega : Euclidean 2) (N : Nat)
    (g : WaveSpaceTime → Complex) : Prop where
  coreOutput : AEStronglyMeasurable (fun y : Euclidean 2 =>
    scratch_smoothLightRayCoreAverage rho omega y g) volume
  coreSlice : ∀ y t, Integrable (fun x : Euclidean 2 =>
    smoothLightRayCore rho omega y (x, t) * ‖g (x, t)‖) volume
  envSlice : ∀ y t, Integrable (fun x : Euclidean 2 =>
    lightRayKernel rho N 0 x (y, 0) * ‖g (x, t)‖) volume
  coreTime : ∀ y, Integrable (fun t : Real => ∫ x : Euclidean 2,
    smoothLightRayCore rho omega y (x, t) * ‖g (x, t)‖)
    (volume.restrict lightRayTimeInterval)
  envTime : ∀ y, Integrable (fun t : Real => ∫ x : Euclidean 2,
    lightRayKernel rho N 0 x (y, 0) * ‖g (x, t)‖)
    (volume.restrict lightRayTimeInterval)

/-- Routine regularity for the already-proved fixed zero-direction
positive-kernel closure. -/
structure ScratchZeroDirectionLightRayRegularity
    (rho : Real) (N : Nat) (g : WaveSpaceTime → Complex) : Prop where
  output : AEStronglyMeasurable (fun y : Euclidean 2 =>
    scratch_zeroDirectionLightRayComplexEnvelope rho N y g) volume
  prod : Integrable (fun p : Euclidean 2 × Real =>
    ‖∫ x : Euclidean 2,
      (lightRayKernel rho N 0 x (p.1, 0) : Complex) *
        scratch_normInput g x p.2‖ ^ 2)
    (volume.prod (volume.restrict lightRayTimeInterval))
  prodSwap : Integrable (fun p : Real × Euclidean 2 =>
    ‖∫ x : Euclidean 2,
      (lightRayKernel rho N 0 x (p.2, 0) : Complex) *
        scratch_normInput g x p.1‖ ^ 2)
    ((volume.restrict lightRayTimeInterval).prod volume)
  slice : ∀ y : Euclidean 2, MemLp (fun t =>
    ∫ x : Euclidean 2,
      (lightRayKernel rho N 0 x (y, 0) : Complex) * scratch_normInput g x t)
    2 (volume.restrict lightRayTimeInterval)
  input : Integrable (fun p : Real × Euclidean 2 =>
    ‖scratch_normInput g p.2 p.1‖ ^ 2)
    ((volume.restrict lightRayTimeInterval).prod volume)
  spatialOutput : ∀ t : Real, AEStronglyMeasurable (fun y : Euclidean 2 =>
    ∫ x : Euclidean 2,
      (lightRayKernel rho N 0 x (y, 0) : Complex) * scratch_normInput g x t) volume
  spatialEnergy : ∀ t : Real, Integrable (fun p : Euclidean 2 × Euclidean 2 =>
    lightRayKernel rho N 0 p.2 (p.1, 0) * ‖scratch_normInput g p.2 t‖ ^ 2)
    (volume.prod volume)
  spatialMeas : ∀ t y, AEStronglyMeasurable (fun x : Euclidean 2 =>
    (lightRayKernel rho N 0 x (y, 0))⁻¹ *
      ‖(lightRayKernel rho N 0 x (y, 0) : Complex) * scratch_normInput g x t‖ ^ 2)
    volume
  spatialSliceEnergy : ∀ t y, Integrable (fun x : Euclidean 2 =>
    lightRayKernel rho N 0 x (y, 0) * ‖scratch_normInput g x t‖ ^ 2) volume

/-- Broad normalized smooth tubes have a uniform terminal `L²` endpoint.
The constant is independent of the width once `rho ≥ 1/2`; all narrow-scale
work is therefore isolated from this corollary. -/
theorem scratch_integral_sq_smoothLightRayCoreAverage_broad
    {rho : Real} (hrho : (1 / 2 : Real) ≤ rho)
    (N : Nat) (hN : 2 < N) (omega : Euclidean 2) (homega : ‖omega‖ ≤ 1)
    (g : WaveSpaceTime → Complex)
    (hcore : ScratchSmoothLightRayCoreBroadRegularity rho omega N g)
    (hzero : ScratchZeroDirectionLightRayRegularity rho N g) :
    (∫ y : Euclidean 2,
      scratch_smoothLightRayCoreAverage rho omega y g ^ 2) ≤
      2 * ((17 : Real) ^ N) ^ 2 *
        (∫ u : Euclidean 2, lightRayDecayProfile N u) ^ 2 *
          ∫ t in lightRayTimeInterval,
            ∫ x : Euclidean 2, ‖g (x, t)‖ ^ 2 := by
  have hrho0 : 0 < rho := lt_of_lt_of_le (by norm_num) hrho
  let C : Real := (17 : Real) ^ N
  let A : Real := ∫ u : Euclidean 2, lightRayDecayProfile N u
  have hC : 0 ≤ C := pow_nonneg (by norm_num) _
  have hpoint : ∀ y : Euclidean 2,
      scratch_smoothLightRayCoreAverage rho omega y g ≤
        C * scratch_zeroDirectionLightRayEnvelope rho N y g := by
    intro y
    dsimp only [C]
    exact scratch_smoothLightRayCoreAverage_le_zeroDirectionLightRayEnvelope
      hrho N omega y homega g
      (hcore.coreSlice y) (hcore.envSlice y)
      (hcore.coreTime y) (hcore.envTime y)
  have hcore_nonneg : ∀ y : Euclidean 2,
      0 ≤ scratch_smoothLightRayCoreAverage rho omega y g := by
    intro y
    exact scratch_smoothLightRayCoreAverage_nonneg rho omega y g
  have henv_nonneg : ∀ y : Euclidean 2,
      0 ≤ scratch_zeroDirectionLightRayEnvelope rho N y g := by
    intro y
    exact scratch_zeroDirectionLightRayEnvelope_nonneg hrho0 N y g
  have henv_sq : Integrable (fun y : Euclidean 2 =>
      scratch_zeroDirectionLightRayEnvelope rho N y g ^ 2) volume :=
    scratch_integrable_sq_zeroDirectionLightRayEnvelope hrho0 N g
      hzero.output hzero.prod hzero.slice
  have hcore_sq : Integrable (fun y : Euclidean 2 =>
      scratch_smoothLightRayCoreAverage rho omega y g ^ 2) volume := by
    refine Integrable.mono (henv_sq.const_mul (C ^ 2))
      (hcore.coreOutput.pow 2) ?_
    filter_upwards with y
    rw [Real.norm_of_nonneg (sq_nonneg _),
      Real.norm_of_nonneg (mul_nonneg (sq_nonneg C) (sq_nonneg _))]
    have hright : 0 ≤ C * scratch_zeroDirectionLightRayEnvelope rho N y g :=
      mul_nonneg hC (henv_nonneg y)
    have hsquare := (sq_le_sq₀ (hcore_nonneg y) hright).mpr (hpoint y)
    simpa only [mul_pow] using hsquare
  have hsmooth := scratch_integral_sq_smoothLightRayCoreAverage_le
    rho omega N g hpoint hcore_nonneg henv_nonneg hcore_sq henv_sq
  have hzeroBound := scratch_integral_sq_zeroDirectionLightRayComplexEnvelope_le_norm
    hrho0 N hN g
    hzero.output hzero.prod hzero.prodSwap hzero.slice hzero.input
    hzero.spatialOutput hzero.spatialEnergy hzero.spatialMeas
      hzero.spatialSliceEnergy
  have henv_ident :
      (∫ y : Euclidean 2,
        scratch_zeroDirectionLightRayEnvelope rho N y g ^ 2) =
        ∫ y : Euclidean 2,
          ‖scratch_zeroDirectionLightRayComplexEnvelope rho N y g‖ ^ 2 := by
    apply integral_congr_ae
    filter_upwards with y
    rw [scratch_norm_zeroDirectionLightRayComplexEnvelope]
    rw [Real.norm_of_nonneg (henv_nonneg y)]
  calc
    (∫ y : Euclidean 2,
      scratch_smoothLightRayCoreAverage rho omega y g ^ 2) ≤
        C ^ 2 * ∫ y : Euclidean 2,
          scratch_zeroDirectionLightRayEnvelope rho N y g ^ 2 := by
          simpa only [C] using hsmooth
    _ = C ^ 2 * ∫ y : Euclidean 2,
          ‖scratch_zeroDirectionLightRayComplexEnvelope rho N y g‖ ^ 2 := by
          rw [henv_ident]
    _ ≤ C ^ 2 *
        ((volume.restrict lightRayTimeInterval).real univ * A ^ 2 *
          ∫ t in lightRayTimeInterval,
            ∫ x : Euclidean 2, ‖g (x, t)‖ ^ 2) := by
          apply mul_le_mul_of_nonneg_left
            (by simpa only [A] using hzeroBound)
            (sq_nonneg C)
    _ = 2 * C ^ 2 * A ^ 2 *
          ∫ t in lightRayTimeInterval,
            ∫ x : Euclidean 2, ‖g (x, t)‖ ^ 2 := by
          rw [scratch_lightRayTimeInterval_measureReal_univ]
          ring
    _ = 2 * ((17 : Real) ^ N) ^ 2 *
          (∫ u : Euclidean 2, lightRayDecayProfile N u) ^ 2 *
            ∫ t in lightRayTimeInterval,
              ∫ x : Euclidean 2, ‖g (x, t)‖ ^ 2 := by
          rfl

end

end Auto.Spherical.MSS
end
