theorem continuous_uncurry_fourierInv_of_dominated
    (m : Real → Euclidean 2 → Complex)
    (hcont : ∀ xi : Euclidean 2, Continuous (fun p : Real × Euclidean 2 =>
      (Real.fourierChar (inner Real xi p.2) : Complex) • m p.1 xi))
    (hmeas : ∀ p : Real × Euclidean 2, AEStronglyMeasurable (fun xi =>
      (Real.fourierChar (inner Real xi p.2) : Complex) • m p.1 xi))
    (bound : Euclidean 2 → Real)
    (hbound : ∀ p : Real × Euclidean 2, ∀ xi : Euclidean 2,
      ‖(Real.fourierChar (inner Real xi p.2) : Complex) • m p.1 xi‖ ≤ bound xi)
    (hboundint : Integrable bound) :
