abbrev thresholdedUnitE2 := Euclidean 2

/-- The elementary square identity behind the thresholded fixed-direction
continuity argument. -/
theorem lightRayKernel_sq_eq_scale_mul_double
    {delta : Real} (N : Nat) (omega y x : thresholdedUnitE2) (t : Real) :
    lightRayKernel delta N omega y (x, t) ^ 2 =
      (delta⁻¹) ^ 2 * lightRayKernel delta (2 * N) omega y (x, t) := by
  unfold lightRayKernel
  ring

theorem integrable_sq_lightRayKernel_spatial
    {delta : Real} (hdelta : 0 < delta) (N : Nat) (hN : 1 < N)
    (omega y : thresholdedUnitE2) (t : Real) :
    Integrable (fun x : thresholdedUnitE2 => lightRayKernel delta N omega y (x, t) ^ 2) volume := by
  have hdouble : 2 < 2 * N := by omega
  have hbase := integrable_lightRayKernel_spatial hdelta (2 * N) hdouble omega y t
  rw [show (fun x : thresholdedUnitE2 => lightRayKernel delta N omega y (x, t) ^ 2) =
      fun x : thresholdedUnitE2 => (delta⁻¹) ^ 2 *
        lightRayKernel delta (2 * N) omega y (x, t) by
        funext x
        exact lightRayKernel_sq_eq_scale_mul_double N omega y x t]
  exact hbase.const_mul _

theorem integral_sq_lightRayKernel_spatial_eq
    {delta : Real} (hdelta : 0 < delta) (N : Nat)
    (omega y : thresholdedUnitE2) (t : Real) :
    (∫ x : thresholdedUnitE2, lightRayKernel delta N omega y (x, t) ^ 2) =
      (delta⁻¹) ^ 2 * ∫ u : thresholdedUnitE2, lightRayDecayProfile (2 * N) u := by
  rw [show (fun x : thresholdedUnitE2 => lightRayKernel delta N omega y (x, t) ^ 2) =
      fun x : thresholdedUnitE2 => (delta⁻¹) ^ 2 *
        lightRayKernel delta (2 * N) omega y (x, t) by
        funext x
        exact lightRayKernel_sq_eq_scale_mul_double N omega y x t,
    integral_const_mul,
    integral_lightRayKernel_spatial_eq_decayProfile hdelta (2 * N) omega y t]

/-- A raw light-ray kernel is in (L^2) on the fixed time slab exactly in
the range needed by the endpoint (`N > 1`). -/
theorem integrable_sq_lightRayKernel_spaceTime
    {delta : Real} (hdelta : 0 < delta) (N : Nat) (hN : 1 < N)
    (omega y : thresholdedUnitE2) :
    Integrable (fun z : thresholdedUnitE2 × Real =>
      lightRayKernel delta N omega y (z.1, z.2) ^ 2)
      (volume.prod (volume.restrict lightRayTimeInterval)) := by
  let F : thresholdedUnitE2 × Real → Real := fun z =>
    lightRayKernel delta N omega y (z.1, z.2) ^ 2
  have hFcont : Continuous F := by
    dsimp only [F]
    unfold lightRayKernel
    have hline : Continuous (fun z : thresholdedUnitE2 × Real =>
        z.1 + z.2 • omega - y) := by fun_prop
    have hne : ∀ z : thresholdedUnitE2 × Real,
        1 + delta⁻¹ * ‖z.1 + z.2 • omega - y‖ ≠ 0 := by
      intro z
      positivity
    have hinv : Continuous (fun z : thresholdedUnitE2 × Real =>
        (1 + delta⁻¹ * ‖z.1 + z.2 • omega - y‖)⁻¹) :=
      (continuous_const.add (hline.norm.const_mul delta⁻¹)).inv₀ hne
    exact (continuous_const.mul (hinv.pow N)).pow 2
  apply (integrable_prod_iff' hFcont.aestronglyMeasurable).mpr
  constructor
  · filter_upwards with t
    exact integrable_sq_lightRayKernel_spatial hdelta N hN omega y t
  · let C : Real := (delta⁻¹) ^ 2 * ∫ u : thresholdedUnitE2,
      lightRayDecayProfile (2 * N) u
    have htime : (fun t : Real => ∫ x : thresholdedUnitE2, ‖F (x, t)‖) =
        fun _ : Real => C := by
      funext t
      dsimp only [F, C]
      calc
        (∫ x : thresholdedUnitE2, ‖lightRayKernel delta N omega y (x, t) ^ 2‖) =
            ∫ x : thresholdedUnitE2, lightRayKernel delta N omega y (x, t) ^ 2 := by
              apply integral_congr_ae
              filter_upwards with x
              rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
        _ = (delta⁻¹) ^ 2 * ∫ u : thresholdedUnitE2,
            lightRayDecayProfile (2 * N) u :=
              integral_sq_lightRayKernel_spatial_eq hdelta N omega y t
    rw [htime]
    letI : IsFiniteMeasure (volume.restrict lightRayTimeInterval) := by
      unfold lightRayTimeInterval
      infer_instance
    exact integrable_const _

theorem memLp_two_lightRayKernel_spaceTime
    {delta : Real} (hdelta : 0 < delta) (N : Nat) (hN : 1 < N)
    (omega y : thresholdedUnitE2) :
    MemLp (fun z : WaveSpaceTime =>
      (lightRayKernel delta N omega y z : Complex)) 2 scratchLightRayMeasure := by
  rw [show scratchLightRayMeasure =
      (volume : Measure thresholdedUnitE2).prod (volume.restrict lightRayTimeInterval) by rfl]
  have hcont : Continuous (fun z : thresholdedUnitE2 × Real =>
      (lightRayKernel delta N omega y (z.1, z.2) : Complex)) := by
      unfold lightRayKernel
      have hline : Continuous (fun z : thresholdedUnitE2 × Real =>
          z.1 + z.2 • omega - y) := by fun_prop
      have hne : ∀ z : thresholdedUnitE2 × Real,
          1 + delta⁻¹ * ‖z.1 + z.2 • omega - y‖ ≠ 0 := by
        intro z
        positivity
      exact Complex.continuous_ofReal.comp
        (continuous_const.mul
          (((continuous_const.add (hline.norm.const_mul delta⁻¹)).inv₀ hne).pow N))
  apply (memLp_two_iff_integrable_sq_norm hcont.aestronglyMeasurable).mpr
  refine (integrable_sq_lightRayKernel_spaceTime hdelta N hN omega y).congr ?_
  filter_upwards with z
  rw [Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (lightRayKernel_nonneg hdelta N omega y (z.1, z.2))]

theorem memLp_complex_ofReal_of_memLp
    {X : Type*} [MeasurableSpace X] {mu : Measure X}
    {p : ENNReal} (f : X → Real) (hf : MemLp f p mu) :
    MemLp (fun x => (f x : Complex)) p mu := by
  apply hf.congr_norm
  · exact Complex.ofRealCLM.continuous.comp_aestronglyMeasurable
      hf.aestronglyMeasurable
  · filter_upwards with x
    simp

/-- The displayed nested light-ray integral is the product-space pairing
with the literal restricted slab measure. -/
theorem coe_lightRayAverage_eq_integral_kernel_norm
    {delta : Real} (N : Nat) (omega y : thresholdedUnitE2)
    (f : WaveSpaceTime → Complex)
    (hprod : Integrable (fun z : WaveSpaceTime =>
      (lightRayKernel delta N omega y z * ‖f z‖ : Complex)) scratchLightRayMeasure) :
    (positiveNormLightRayLinear delta N f omega y) =
      ∫ z : WaveSpaceTime,
        (lightRayKernel delta N omega y z * ‖f z‖ : Complex)
        ∂scratchLightRayMeasure := by
  unfold positiveNormLightRayLinear lightRayAverage
  rw [show scratchLightRayMeasure =
      (volume : Measure thresholdedUnitE2).prod (volume.restrict lightRayTimeInterval) by rfl]
  calc
    (↑(∫ t in lightRayTimeInterval, ∫ x : thresholdedUnitE2,
        lightRayKernel delta N omega y (x, t) * ‖f (x, t)‖) : Complex) =
        ∫ t in lightRayTimeInterval, ∫ x : thresholdedUnitE2,
          (lightRayKernel delta N omega y (x, t) * ‖f (x, t)‖ : Complex) := by
          simp only [← Complex.ofReal_mul]
          calc
            (↑(∫ t in lightRayTimeInterval, ∫ x : thresholdedUnitE2,
                lightRayKernel delta N omega y (x, t) * ‖f (x, t)‖) : Complex) =
                ∫ t in lightRayTimeInterval,
                  (↑(∫ x : thresholdedUnitE2,
                    lightRayKernel delta N omega y (x, t) * ‖f (x, t)‖) : Complex) := by
                  exact (integral_ofReal
                    (μ := volume.restrict lightRayTimeInterval)
                    (f := fun t : Real => ∫ x : thresholdedUnitE2,
                      lightRayKernel delta N omega y (x, t) * ‖f (x, t)‖)).symm
            _ = ∫ t in lightRayTimeInterval, ∫ x : thresholdedUnitE2,
                (↑(lightRayKernel delta N omega y (x, t) * ‖f (x, t)‖) : Complex) := by
                  apply integral_congr_ae
                  filter_upwards with t
                  exact (integral_ofReal
                    (μ := volume)
                    (f := fun x : thresholdedUnitE2 =>
                      lightRayKernel delta N omega y (x, t) * ‖f (x, t)‖)).symm
    _ = ∫ x : thresholdedUnitE2, ∫ t in lightRayTimeInterval,
        (lightRayKernel delta N omega y (x, t) * ‖f (x, t)‖ : Complex) := by
          simpa only using (integral_integral_swap hprod).symm
    _ = ∫ z : thresholdedUnitE2 × Real,
        (lightRayKernel delta N omega y z * ‖f z‖ : Complex)
        ∂(volume.prod (volume.restrict lightRayTimeInterval)) := by
          exact (integral_prod _ hprod).symm

/-- Fixed-direction convergence of the literal positive light-ray average.
Unlike the former unthresholded model field, this is only asserted in the
honest range `N > 1`, where the raw kernel belongs to `L²` on the slab. -/
theorem tendsto_positiveNormLightRayLinear_of_geometric_L2
    {delta : Real} (hdelta : 0 < delta) (N : Nat) (hN : 1 < N)
    (F : WaveSpaceTime → Complex)
    (core : Nat → WaveSpaceTime → Complex)
    (hF : MemLp F 2 volume)
    (hcore : ∀ n, MemLp (core n) 2 volume)
    (hgeo : ∀ n, eLpNorm (F - core n) 2 volume ≤
      eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n))
    (omega y : thresholdedUnitE2) :
    Tendsto (fun n => positiveNormLightRayLinear delta N (core n) omega y)
      atTop (nhds (positiveNormLightRayLinear delta N F omega y)) := by
  let K : WaveSpaceTime → Complex := fun z =>
    (lightRayKernel delta N omega y z : Complex)
  let R : Nat → WaveSpaceTime → Complex := fun n z =>
    ((‖F z‖ - ‖core n z‖ : Real) : Complex)
  have hK : MemLp K 2 scratchLightRayMeasure :=
    memLp_two_lightRayKernel_spaceTime hdelta N hN omega y
  have hFslab : MemLp F 2 scratchLightRayMeasure :=
    hF.mono_measure scratchLightRayMeasure_le_volume
  have hcoreslab : ∀ n, MemLp (core n) 2 scratchLightRayMeasure := by
    intro n
    exact (hcore n).mono_measure scratchLightRayMeasure_le_volume
  have hprodF : Integrable (fun z : WaveSpaceTime =>
      (lightRayKernel delta N omega y z : Complex) * (‖F z‖ : Complex))
      scratchLightRayMeasure := by
    change Integrable (K * fun z => (‖F z‖ : Complex)) scratchLightRayMeasure
    exact hK.integrable_mul (memLp_complex_ofReal_of_memLp _ hFslab.norm)
  have hprodcore : ∀ n, Integrable (fun z : WaveSpaceTime =>
      (lightRayKernel delta N omega y z : Complex) * (‖core n z‖ : Complex))
      scratchLightRayMeasure := by
    intro n
    change Integrable (K * fun z => (‖core n z‖ : Complex)) scratchLightRayMeasure
    exact hK.integrable_mul
      (memLp_complex_ofReal_of_memLp _ (hcoreslab n).norm)
  have hRmem : ∀ n, MemLp (R n) 2 scratchLightRayMeasure := by
    intro n
    exact memLp_complex_ofReal_of_memLp _
      (hFslab.norm.sub (hcoreslab n).norm)
  have hRbound : ∀ n, eLpNorm (R n) 2 scratchLightRayMeasure ≤
      eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n) := by
    intro n
    calc
      eLpNorm (R n) 2 scratchLightRayMeasure ≤
          eLpNorm (F - core n) 2 scratchLightRayMeasure := by
            apply eLpNorm_mono_ae
            filter_upwards with z
            dsimp only [R]
            simp only [Complex.norm_real, Real.norm_eq_abs, Pi.sub_apply]
            exact abs_norm_sub_norm_le _ _
      _ ≤ eLpNorm (F - core n) 2 volume :=
        eLpNorm_mono_measure _ scratchLightRayMeasure_le_volume
      _ ≤ eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n) := hgeo n
  have hpow : Tendsto (fun n : Nat =>
      ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) atTop (nhds 0) := by
    have hhalf : ENNReal.ofReal ((2 : Real)⁻¹) < 1 := by norm_num
    convert ENNReal.tendsto_pow_atTop_nhds_zero_of_lt_one hhalf using 1
    funext n
    rw [ENNReal.ofReal_pow (by positivity)]
  have hupper : Tendsto (fun n : Nat =>
      eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) atTop (nhds 0) :=
    by
      simpa using ENNReal.Tendsto.const_mul (a := eLpNorm F 2 volume) hpow
        (Or.inr hF.eLpNorm_ne_top)
  have hRzero : Tendsto (fun n : Nat => eLpNorm (R n) 2 scratchLightRayMeasure)
      atTop (nhds 0) := by
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hupper
      (fun n => bot_le) hRbound
  have hpairUpper : Tendsto (fun n : Nat =>
      eLpNorm K 2 scratchLightRayMeasure *
        eLpNorm (R n) 2 scratchLightRayMeasure) atTop (nhds 0) :=
    by
      simpa using ENNReal.Tendsto.const_mul
        (a := eLpNorm K 2 scratchLightRayMeasure) hRzero
        (Or.inr hK.eLpNorm_ne_top)
  have hpairEnorm : Tendsto (fun n : Nat =>
      ‖∫ z : WaveSpaceTime, K z * R n z ∂scratchLightRayMeasure‖ₑ)
      atTop (nhds 0) := by
    apply tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hpairUpper
    · intro n
      exact bot_le
    · intro n
      exact enorm_integral_mul_le_eLpNorm_two_mul K (R n) hK (hRmem n)
  have hpairNorm : Tendsto (fun n : Nat =>
      ‖∫ z : WaveSpaceTime, K z * R n z ∂scratchLightRayMeasure‖)
      atTop (nhds 0) := by
    have htoReal :=
      (ENNReal.tendsto_toReal_zero_iff
        (fun n : Nat => enorm_ne_top)).2 hpairEnorm
    simpa using htoReal
  have hpair : Tendsto (fun n : Nat =>
      ∫ z : WaveSpaceTime, K z * R n z ∂scratchLightRayMeasure)
      atTop (nhds 0) :=
    tendsto_zero_iff_norm_tendsto_zero.mpr hpairNorm
  have hdiff : ∀ n,
      positiveNormLightRayLinear delta N F omega y -
          positiveNormLightRayLinear delta N (core n) omega y =
        ∫ z : WaveSpaceTime, K z * R n z ∂scratchLightRayMeasure := by
    intro n
    rw [coe_lightRayAverage_eq_integral_kernel_norm N omega y F hprodF,
      coe_lightRayAverage_eq_integral_kernel_norm N omega y (core n) (hprodcore n)]
    rw [← integral_sub hprodF (hprodcore n)]
    apply integral_congr_ae
    filter_upwards with z
    dsimp only [K, R]
    simp only [← Complex.ofReal_mul, ← Complex.ofReal_sub]
    ring
  have hzero : Tendsto (fun n =>
      positiveNormLightRayLinear delta N F omega y -
        positiveNormLightRayLinear delta N (core n) omega y) atTop (nhds 0) := by
    convert hpair using 1
    funext n
    exact hdiff n
  have hreverse : Tendsto (fun n =>
      positiveNormLightRayLinear delta N (core n) omega y -
        positiveNormLightRayLinear delta N F omega y) atTop (nhds 0) := by
    simpa using hzero.neg
  have hfinal : Tendsto (fun n =>
      (positiveNormLightRayLinear delta N (core n) omega y -
        positiveNormLightRayLinear delta N F omega y) +
          positiveNormLightRayLinear delta N F omega y) atTop
        (nhds (0 + positiveNormLightRayLinear delta N F omega y)) :=
    hreverse.add tendsto_const_nhds
  simpa [sub_add_cancel] using hfinal

/-- Threshold-correct version of the unit-direction positive-square density
closure.  The only changed hypothesis is fixed-direction convergence, which
is needed solely after the final theorem has assumed `3 < N`. -/
theorem hasLightRayMaximalEstimate_of_positiveSlabDenseSignedEnvelope_unit_gt
    (Core : (WaveSpaceTime → Complex) → Prop)
    (hdense : HasPositiveSlabL2DenseCore Core)
    (T : Real → Nat → (WaveSpaceTime → Complex) → thresholdedUnitE2 → thresholdedUnitE2 → Complex)
    (P : Real → Nat → (WaveSpaceTime → Complex) → thresholdedUnitE2 → ENNReal)
    (hPmeas : ∀ delta N f, Core f → Measurable (P delta N f))
    (hstrong : ∀ N : Nat, 3 < N → ∃ C : Real, 0 < C ∧
      ∀ delta : Real, 0 < delta → delta < 1 / 2 →
      ∀ f : WaveSpaceTime → Complex, Core f →
        eLpNorm (P delta N f) 2 volume ≤
          ENNReal.ofReal (C * (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
            eLpNorm f 2 volume)
    (hidentify : ∀ delta N (h : WaveSpaceTime → Complex) (omega y : thresholdedUnitE2),
      T delta N
          (scratch_lightRayTimeRestriction (fun z => (‖h z‖ : Complex))) omega y =
        (lightRayAverage delta N omega y h : Complex))
    (hTgeom : ∀ {delta : Real}, 0 < delta → ∀ N, 1 < N → (F : WaveSpaceTime → Complex) →
      (core : Nat → WaveSpaceTime → Complex) →
        MemLp F 2 volume →
        (∀ n, MemLp (core n) 2 volume) →
        (∀ n, eLpNorm (F - core n) 2 volume ≤
          eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) →
        ∀ omega y,
          Tendsto (fun n => T delta N (core n) omega y) atTop
            (nhds (T delta N F omega y)))
    (hdom : ∀ {delta : Real}, 0 < delta → ∀ N, 2 < N →
      ∀ f, Core f → MemLp f 2 volume →
      ∀ (omega : aux_lightRayDirection) y,
        ENNReal.ofReal ‖T delta N f omega.1 y‖ ≤ P delta N f y) :
    HasLightRayMaximalEstimate := by
  intro N hN
  obtain ⟨C, hCpos, hCstrong⟩ := hstrong N hN
  refine ⟨2 * C, by positivity, ?_⟩
  intro delta hdelta hdeltasmall g hg
  let h : WaveSpaceTime → Complex := scratch_lightRayTimeRestriction g
  have hh : MemLp h 2 volume := by
    simpa only [h] using scratch_memLp_lightRayTimeRestriction g hg
  have hslab : h = scratch_lightRayTimeRestriction h := by
    funext z
    dsimp only [h]
    simp only [scratch_lightRayTimeRestriction, Set.indicator_indicator]
    rw [inter_self]
  let F : WaveSpaceTime → Complex :=
    scratch_lightRayTimeRestriction (fun z => (‖h z‖ : Complex))
  have hFmem : MemLp F 2 volume := by
    dsimp only [F]
    exact scratch_memLp_lightRayTimeRestriction _
      (scratch_memLp_complex_of_norm h hh)
  have hFnorm : eLpNorm F 2 volume = eLpNorm h 2 volume := by
    dsimp only [F]
    exact scratch_eLpNorm_positiveSlab_eq h hslab 2
  have hM : lightRayMaximal delta N g = lightRayMaximal delta N h := by
    simpa only [h] using
      scratch_lightRayMaximal_eq_lightRayTimeRestriction hdelta N (by omega) g hg
  let L : Real := (1 + abs (Real.log delta)) ^ (3 / 2 : Real)
  let A : ENNReal := ENNReal.ofReal (C * L)
  by_cases hhnonzero : eLpNorm h 2 volume = 0
  · have hhae : h =ᵐ[volume] (fun _ : WaveSpaceTime => (0 : Complex)) :=
      (eLpNorm_eq_zero_iff hh.aestronglyMeasurable (by norm_num)).mp hhnonzero
    have hMhzero : lightRayMaximal delta N h = 0 := by
      calc
        lightRayMaximal delta N h =
            lightRayMaximal delta N (fun _ : WaveSpaceTime => (0 : Complex)) :=
          scratch_lightRayMaximal_eq_of_ae_eq_of_memLp hdelta N (by omega) hh
            MemLp.zero hhae
        _ = 0 := scratch_lightRayMaximal_zero delta N
    rw [hM, hMhzero]
    simp
  · let R : Real := (eLpNorm F 2 volume).toReal
    have hFnonzero : eLpNorm F 2 volume ≠ 0 := by
      rwa [hFnorm]
    have hRpos : 0 < R := ENNReal.toReal_pos hFnonzero hFmem.eLpNorm_ne_top
    choose core hcore hcoreMem hcoreErr using fun n : Nat =>
      hdense h hh (R * ((2 : Real)⁻¹ ^ n))
        (show 0 < R * ((2 : Real)⁻¹ ^ n) by positivity)
    have hscaled (n : Nat) :
        eLpNorm (F - core n) 2 volume ≤
          eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n) := by
      calc
        eLpNorm (F - core n) 2 volume ≤
            ENNReal.ofReal (R * ((2 : Real)⁻¹ ^ n)) := by
              simpa only [F] using (hcoreErr n).le
        _ = ENNReal.ofReal R * ENNReal.ofReal ((2 : Real)⁻¹ ^ n) :=
          ENNReal.ofReal_mul hRpos.le
        _ = eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n) := by
          rw [ENNReal.ofReal_toReal hFmem.eLpNorm_ne_top]
    have hcoreStrong (n : Nat) :
        eLpNorm (P delta N (core n)) 2 volume ≤
          A * eLpNorm (core n) 2 volume := by
      simpa only [A, L] using hCstrong delta hdelta hdeltasmall
        (core n) (hcore n)
    have hconv : ∀ omega y,
        Tendsto (fun n => T delta N (core n) omega y) atTop
          (nhds (T delta N F omega y)) :=
      hTgeom hdelta N (by omega) F core hFmem hcoreMem hscaled
    have hfatou : ∀ᵐ y : thresholdedUnitE2 ∂volume,
        ENNReal.ofReal (lightRayMaximal delta N h y) ≤
          atTop.liminf (fun n => P delta N (core n) y) := by
      filter_upwards with y
      apply scratch_lightRayMaximal_ofReal_le_liminf_of_signedCore_unitDom
        hdelta N (by omega) h hh F (T delta N) (P delta N) core
      · intro omega y
        simpa only [F] using hidentify delta N h omega y
      · exact hconv
      · intro n omega homega y
        exact hdom hdelta N (by omega) (core n) (hcore n) (hcoreMem n)
          ⟨omega, homega⟩ y
    have hbound : eLpNorm (lightRayMaximal delta N h) 2 volume ≤
        A * (2 * eLpNorm h 2 volume) := by
      calc
        eLpNorm (lightRayMaximal delta N h) 2 volume ≤
            A * (2 * eLpNorm F 2 volume) := by
          apply scratch_lightRayMaximal_bound_of_signedCore_liminf
            hdelta N (by omega) h hh A (2 * eLpNorm F 2 volume) core
              (P delta N)
          · intro n
            exact hPmeas delta N (core n) (hcore n)
          · exact hcoreStrong
          · intro n
            exact scratch_core_eLpNorm_le_two_of_scaled_approximation
              F hFmem core hcoreMem hscaled n
          · exact hfatou
        _ = A * (2 * eLpNorm h 2 volume) := by rw [hFnorm]
    have hnorm : eLpNorm h 2 volume ≤ eLpNorm g 2 volume := by
      simpa only [h] using scratch_eLpNorm_lightRayTimeRestriction_le g
    have hboundG : eLpNorm (lightRayMaximal delta N g) 2 volume ≤
        A * (2 * eLpNorm g 2 volume) := by
      calc
        eLpNorm (lightRayMaximal delta N g) 2 volume =
            eLpNorm (lightRayMaximal delta N h) 2 volume := by rw [hM]
        _ ≤ A * (2 * eLpNorm h 2 volume) := hbound
        _ ≤ A * (2 * eLpNorm g 2 volume) := by
          simpa only [mul_assoc, mul_comm, mul_left_comm] using
            (mul_le_mul_left (mul_le_mul_left hnorm 2) A)
    have hfactor : A * (2 * eLpNorm g 2 volume) =
        ENNReal.ofReal ((2 * C) * L) * eLpNorm g 2 volume := by
      calc
        A * (2 * eLpNorm g 2 volume) =
            (2 * A) * eLpNorm g 2 volume := by ring
        _ = ENNReal.ofReal (2 * (C * L)) * eLpNorm g 2 volume := by
          congr 1
          dsimp only [A]
          rw [ENNReal.ofReal_mul (by norm_num : (0 : Real) ≤ 2)]
          norm_num
        _ = ENNReal.ofReal ((2 * C) * L) * eLpNorm g 2 volume := by
          congr 2
          ring
    calc
      eLpNorm (lightRayMaximal delta N g) 2 volume ≤
          A * (2 * eLpNorm g 2 volume) := hboundG
      _ = ENNReal.ofReal ((2 * C) *
          (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
          eLpNorm g 2 volume := by
        simpa only [L] using hfactor

/-- The old scale wiring with its only problematic field corrected to the
honest kernel threshold. -/
structure CanonicalReflectedScalePositiveUnitWiringGT (c r : Real) where
  S : Real → Nat → (WaveSpaceTime → Complex) → Nat → thresholdedUnitE2 → thresholdedUnitE2 → Complex
  hScaleMeas : ∀ delta N f j, InnerSlabSchwartzTensorCore f →
    Measurable (canonicalReflectedUnitScaleEnvelope S delta N f j)
  hTgeom : ∀ {delta : Real}, 0 < delta → ∀ N, 1 < N → (F : WaveSpaceTime → Complex) →
    (core : Nat → WaveSpaceTime → Complex) →
      MemLp F 2 volume →
      (∀ n, MemLp (core n) 2 volume) →
      (∀ n, eLpNorm (F - core n) 2 volume ≤
        eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) →
      ∀ omega y,
        Tendsto (fun n => positiveNormLightRayLinear delta N (core n) omega y)
          atTop (nhds (positiveNormLightRayLinear delta N F omega y))
  hKmeas : ∀ delta N f,
    NonnegativeSquareInnerSlabSchwartzTensorCore f →
    ∀ j (omega : aux_lightRayDirection) y,
      AEMeasurable (fun z =>
        canonicalReflectedSquareDyadicKernel c r delta N j omega y z *
          canonicalSquareInput f z) scratchLightRayMeasure
  hraw : ∀ {delta : Real}, 0 < delta → ∀ N, 2 < N →
    ∀ f, NonnegativeSquareInnerSlabSchwartzTensorCore f → MemLp f 2 volume →
    ∀ y,
      (⨆ omega : aux_lightRayDirection,
        ENNReal.ofReal ‖positiveNormLightRayLinear delta N f omega.1 y‖) ≤
      ⨆ omega : aux_lightRayDirection,
        scratch_positiveKernelTsum scratchLightRayMeasure
          (fun j (d : aux_lightRayDirection) y z =>
            canonicalReflectedSquareDyadicKernel c r delta N j d y z)
          (canonicalSquareInput f) omega y
  hdir : ∀ delta N f (omega : aux_lightRayDirection) y,
    scratch_positiveKernelTsum scratchLightRayMeasure
      (fun j (d : aux_lightRayDirection) y z =>
        canonicalReflectedSquareDyadicKernel c r delta N j d y z)
      (canonicalSquareInput f) omega y ≤
    scratch_positiveKernelTsum scratchLightRayMeasure
      (fun j (d : aux_lightRayDirection) y z =>
        canonicalReflectedSquareDyadicKernel c r delta N j d y z)
      (canonicalSquareInput f) omega y
  hpiece : ∀ {delta : Real}, 0 < delta → ∀ N j f,
    NonnegativeSquareInnerSlabSchwartzTensorCore f →
    ∀ (omega : aux_lightRayDirection) y,
      (∫⁻ z,
        canonicalReflectedSquareDyadicKernel c r delta N j omega y z *
          canonicalSquareInput f z ∂scratchLightRayMeasure) ≤
        ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
          canonicalReflectedUnitScaleEnvelope S delta N f j y

theorem CanonicalReflectedScalePositiveUnitWiringGT.finiteEnvelope_measurable
    {c r : Real} (w : CanonicalReflectedScalePositiveUnitWiringGT c r)
    (delta : Real) (N : Nat) (f : WaveSpaceTime → Complex) (M : Nat)
    (hf : InnerSlabSchwartzTensorCore f) :
    Measurable (canonicalReflectedUnitFiniteEnvelope c r w.S delta N f M) := by
  unfold canonicalReflectedUnitFiniteEnvelope
  apply Finset.measurable_sum
  intro j hj
  exact measurable_const.mul (w.hScaleMeas delta N f j hf)

theorem CanonicalReflectedScalePositiveUnitWiringGT.limitEnvelope_measurable
    {c r : Real} (w : CanonicalReflectedScalePositiveUnitWiringGT c r)
    (delta : Real) (N : Nat) (f : WaveSpaceTime → Complex)
    (hf : InnerSlabSchwartzTensorCore f) :
    Measurable (fun y => atTop.liminf
      (fun M => canonicalReflectedUnitFiniteEnvelope c r w.S delta N f M y)) := by
  exact Measurable.liminf (fun M =>
    w.finiteEnvelope_measurable delta N f M hf)

/-- The only finite analytic premise needed by the threshold-correct
positive-square closure. -/
def HasCanonicalDyadicUnitFiniteEnvelopeL2EstimateGT
    {c r : Real} (w : CanonicalReflectedScalePositiveUnitWiringGT c r) : Prop :=
  ∀ N : Nat, 3 < N → ∃ C : Real, 0 < C ∧
    ∀ delta : Real, 0 < delta → delta < 1 / 2 →
    ∀ f : WaveSpaceTime → Complex, InnerSlabSchwartzTensorCore f →
    ∀ M : Nat,
      eLpNorm (canonicalReflectedUnitFiniteEnvelope c r w.S delta N f M) 2 volume ≤
        ENNReal.ofReal (C * (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
          eLpNorm f 2 volume

/-- A threshold-correct unit wiring plus the finite signed-envelope estimate
already implies the literal maximal estimate. -/
theorem hasLightRayMaximalEstimate_of_thresholdedUnitFiniteEnvelope
    {c r : Real} (_hc : 0 < c) (_hr : 0 < r)
    (w : CanonicalReflectedScalePositiveUnitWiringGT c r)
    (hfinite : HasCanonicalDyadicUnitFiniteEnvelopeL2EstimateGT w) :
    HasLightRayMaximalEstimate := by
  apply hasLightRayMaximalEstimate_of_positiveSlabDenseSignedEnvelope_unit_gt
    NonnegativeSquareInnerSlabSchwartzTensorCore
    hasPositiveSlabL2DenseCore_nonnegativeSquareInnerSlabSchwartzTensor
    positiveNormLightRayLinear
    (fun delta N f y => atTop.liminf
      (fun M => canonicalReflectedUnitFiniteEnvelope c r w.S delta N f M y))
  · intro delta N f hf
    exact w.limitEnvelope_measurable delta N f
      (nonnegativeSquareInnerSlabSchwartzTensorCore_to_signedCore hf)
  · intro N hN
    obtain ⟨C, hC, hbound⟩ := hfinite N hN
    refine ⟨C, hC, ?_⟩
    intro delta hdelta hdeltaSmall f hf
    have hfsigned : InnerSlabSchwartzTensorCore f :=
      nonnegativeSquareInnerSlabSchwartzTensorCore_to_signedCore hf
    exact scratch_eLpNorm_liminf_le_of_uniform
      (p := (2 : ENNReal)) (by norm_num) (by norm_num)
      (fun M => w.finiteEnvelope_measurable delta N f M hfsigned)
      (fun M => hbound delta hdelta hdeltaSmall f hfsigned M)
  · exact positiveNormLightRayLinear_identify
  · exact w.hTgeom
  · intro delta hdelta N hN f hf hfmem omega y
    calc
      ENNReal.ofReal ‖positiveNormLightRayLinear delta N f omega.1 y‖ ≤
          (⨆ omega : aux_lightRayDirection,
            ENNReal.ofReal ‖positiveNormLightRayLinear delta N f omega.1 y‖) :=
        le_iSup (fun omega : aux_lightRayDirection =>
          ENNReal.ofReal ‖positiveNormLightRayLinear delta N f omega.1 y‖) omega
      _ ≤ ⨆ omega : aux_lightRayDirection,
          scratch_positiveKernelTsum scratchLightRayMeasure
            (fun j (d : aux_lightRayDirection) y z =>
              canonicalReflectedSquareDyadicKernel c r delta N j d y z)
            (canonicalSquareInput f) omega y :=
        w.hraw hdelta N hN f hf hfmem y
      _ ≤ atTop.liminf (fun M => ∑ j ∈ Finset.range M,
          ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
            canonicalReflectedUnitScaleEnvelope w.S delta N f j y) := by
        apply scratch_iSup_directional_le_liminf_finiteEnvelope
          scratchLightRayMeasure
          (fun j (d : aux_lightRayDirection) y z =>
            canonicalReflectedSquareDyadicKernel c r delta N j d y z)
          (canonicalSquareInput f)
          (fun omega y =>
            scratch_positiveKernelTsum scratchLightRayMeasure
              (fun j (d : aux_lightRayDirection) y z =>
                canonicalReflectedSquareDyadicKernel c r delta N j d y z)
              (canonicalSquareInput f) omega y)
          (fun j y =>
            ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
              canonicalReflectedUnitScaleEnvelope w.S delta N f j y)
        · intro j d y
          exact w.hKmeas delta N f hf j d y
        · intro d y
          exact w.hdir delta N f d y
        · intro j d y
          exact w.hpiece hdelta N j f hf d y
      _ = atTop.liminf (fun M =>
          canonicalReflectedUnitFiniteEnvelope c r w.S delta N f M y) := by
        apply congrArg atTop.liminf
        funext M
        rfl

/-- Structural constructor parallel to the earlier unit wiring, but with the
fixed-direction limit constrained to `N > 1`.  The raw/dir/piece fields are
the literal unit-direction canonical decomposition; no all-`E²` envelope is
introduced. -/
noncomputable def canonicalReflectedSquareUnitWiringGT_of_scaleBridge
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (hcore : ∀ u : thresholdedUnitE2, ‖u‖ ≤ r → c ≤ (canonicalPositiveCore u).re)
    (S : Real → Nat → (WaveSpaceTime → Complex) → Nat → thresholdedUnitE2 → thresholdedUnitE2 →
        Complex)
    (hScaleMeas : ∀ delta N f j, InnerSlabSchwartzTensorCore f →
      Measurable (canonicalReflectedUnitScaleEnvelope S delta N f j))
    (hTgeom : ∀ {delta : Real}, 0 < delta → ∀ N, 1 < N → (F : WaveSpaceTime → Complex) →
      (core : Nat → WaveSpaceTime → Complex) →
        MemLp F 2 volume →
        (∀ n, MemLp (core n) 2 volume) →
        (∀ n, eLpNorm (F - core n) 2 volume ≤
          eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) →
        ∀ omega y,
          Tendsto (fun n => positiveNormLightRayLinear delta N (core n) omega y)
            atTop (nhds (positiveNormLightRayLinear delta N F omega y)))
    (hKmeas : ∀ delta N f,
      NonnegativeSquareInnerSlabSchwartzTensorCore f →
      ∀ j (omega : aux_lightRayDirection) y,
        AEMeasurable (fun z =>
          canonicalReflectedSquareDyadicKernel c r delta N j omega y z *
            canonicalSquareInput f z) scratchLightRayMeasure)
    (hbridge : HasCanonicalReflectedSquareScaleBridge r hr S) :
    CanonicalReflectedScalePositiveUnitWiringGT c r where
  S := S
  hScaleMeas := hScaleMeas
  hTgeom := hTgeom
  hKmeas := hKmeas
  hraw := by
    intro delta hdelta N hN f hf hfmem y
    exact iSup_positiveNormLightRayLinear_le_iSup_canonicalReflectedSquareDirectional
      hdelta N hN hc hr hcore f hfmem y
  hdir := by
    intro delta N f omega y
    rfl
  hpiece := by
    intro delta hdelta N j f hf omega y
    rcases hf with ⟨ι, hι, q, a, timeRadius, htimePos, htimeLt, ha, hf⟩
    letI : Fintype ι := hι
    subst f
    obtain ⟨hS, hfull, hinner, houter, hpositive, hpositiveMeas⟩ :=
      hbridge hdelta N j q a htimeLt ha omega y
    have hpiece := lintegral_canonicalReflectedSquareDyadicKernel_mul_input_le
      hc hr hdelta N j q a htimeLt ha omega y
      hfull hinner houter hpositive hpositiveMeas
    calc
      (∫⁻ z,
        canonicalReflectedSquareDyadicKernel c r delta N j omega y z *
          canonicalSquareInput (nonnegativeSquareInnerSlabTensor q a) z
            ∂scratchLightRayMeasure) ≤
          ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
            ENNReal.ofReal ‖reflectedSchwartzSquareTubeBand
              (scratch_canonicalBandlimitedTubeMultiplier
                (delta / canonicalBandlimitedDyadicScale r j)
                (div_pos hdelta (canonicalBandlimitedDyadicScale_pos hr j)))
              (hasCompactSupport_scratch_canonicalBandlimitedTubeMultiplier
                (div_pos hdelta (canonicalBandlimitedDyadicScale_pos hr j)))
              q a omega.1 y‖ := hpiece
      _ = ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
            ENNReal.ofReal ‖S delta N
              (nonnegativeSquareInnerSlabTensor q a) j omega.1 y‖ := by
            rw [hS]
      _ ≤ ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
            canonicalReflectedUnitScaleEnvelope S delta N
              (nonnegativeSquareInnerSlabTensor q a) j y := by
            apply mul_le_mul_right
            exact le_iSup (fun d : aux_lightRayDirection =>
              ENNReal.ofReal ‖S delta N
                (nonnegativeSquareInnerSlabTensor q a) j d.1 y‖) omega

/-- The canonical physical signed scale field has a completely concrete
thresholded convergence component.  The remaining parameters are exactly
the scale measurability and reflected packet bridge needed for the finite
analytic envelope. -/
noncomputable def canonicalTubeSignedScaleUnitWiringGT_of_scaleBridge
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (hcore : ∀ u : thresholdedUnitE2, ‖u‖ ≤ r → c ≤ (canonicalPositiveCore u).re)
    (hScaleMeas : ∀ delta N f j, InnerSlabSchwartzTensorCore f →
      Measurable (canonicalReflectedUnitScaleEnvelope
        (canonicalTubeSignedScale r hr) delta N f j))
    (hKmeas : ∀ delta N f,
      NonnegativeSquareInnerSlabSchwartzTensorCore f →
      ∀ j (omega : aux_lightRayDirection) y,
        AEMeasurable (fun z =>
          canonicalReflectedSquareDyadicKernel c r delta N j omega y z *
            canonicalSquareInput f z) scratchLightRayMeasure)
    (hbridge : HasCanonicalReflectedSquareScaleBridge r hr
      (canonicalTubeSignedScale r hr)) :
    CanonicalReflectedScalePositiveUnitWiringGT c r :=
  canonicalReflectedSquareUnitWiringGT_of_scaleBridge hc hr hcore
    (canonicalTubeSignedScale r hr) hScaleMeas
    (fun hdelta N hN F core hF hcore hgeo omega y =>
      tendsto_positiveNormLightRayLinear_of_geometric_L2
        hdelta N hN F core hF hcore hgeo omega y)
    hKmeas hbridge

/-- Final literal endpoint in the physical `canonicalTubeSignedScale` model.
Thus the sole analytic bound to feed the closure is a finite unit-direction
signed-envelope `L²` estimate for this exact reflected-scale wiring. -/
theorem hasLightRayMaximalEstimate_of_canonicalTubeSignedScaleFiniteEnvelope
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (hcore : ∀ u : thresholdedUnitE2, ‖u‖ ≤ r → c ≤ (canonicalPositiveCore u).re)
    (hScaleMeas : ∀ delta N f j, InnerSlabSchwartzTensorCore f →
      Measurable (canonicalReflectedUnitScaleEnvelope
        (canonicalTubeSignedScale r hr) delta N f j))
    (hKmeas : ∀ delta N f,
      NonnegativeSquareInnerSlabSchwartzTensorCore f →
      ∀ j (omega : aux_lightRayDirection) y,
        AEMeasurable (fun z =>
          canonicalReflectedSquareDyadicKernel c r delta N j omega y z *
            canonicalSquareInput f z) scratchLightRayMeasure)
    (hbridge : HasCanonicalReflectedSquareScaleBridge r hr
      (canonicalTubeSignedScale r hr))
    (hfinite : HasCanonicalDyadicUnitFiniteEnvelopeL2EstimateGT
      (canonicalTubeSignedScaleUnitWiringGT_of_scaleBridge
        hc hr hcore hScaleMeas hKmeas hbridge)) :
    HasLightRayMaximalEstimate :=
  hasLightRayMaximalEstimate_of_thresholdedUnitFiniteEnvelope hc hr
    (canonicalTubeSignedScaleUnitWiringGT_of_scaleBridge
      hc hr hcore hScaleMeas hKmeas hbridge) hfinite

/-- Narrow/broad one-scale formulation for the thresholded literal unit
envelope.  The scale coefficients remain the canonical reflected ones. -/
def HasCanonicalDyadicUnitNarrowBroadFiniteEnvelopeL2EstimateGT
    {c r : Real} (w : CanonicalReflectedScalePositiveUnitWiringGT c r) : Prop :=
  ∀ N : Nat, 3 < N → ∃ A B : Real,
    0 < A ∧ 0 ≤ B ∧
    ∀ delta : Real, 0 < delta → delta < 1 / 2 →
      ∃ k0 : Nat, ∃ cost : Nat → Real,
        (∀ j, j < k0 →
          cost j ≤ A * (1 + |Real.log delta|) ^ (3 / 2 : Real)) ∧
        (∀ j, k0 ≤ j → cost j ≤ B) ∧
        ∀ f : WaveSpaceTime → Complex, InnerSlabSchwartzTensorCore f →
          ∀ M : Nat,
            eLpNorm (canonicalReflectedUnitFiniteEnvelope c r w.S delta N f M)
              2 volume ≤
              ENNReal.ofReal
                (∑ j ∈ Finset.range M,
                  canonicalBandlimitedDyadicCoefficient N c r j * cost j) *
                eLpNorm f 2 volume

/-- Canonical coefficient summability turns the concrete narrow/broad
one-scale premise into the finite unit-envelope premise required by the
positive-square closure. -/
theorem hasCanonicalDyadicUnitFiniteEnvelopeL2EstimateGT_of_narrowBroad
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (w : CanonicalReflectedScalePositiveUnitWiringGT c r)
    (hfinite : HasCanonicalDyadicUnitNarrowBroadFiniteEnvelopeL2EstimateGT w) :
    HasCanonicalDyadicUnitFiniteEnvelopeL2EstimateGT w := by
  intro N hN
  obtain ⟨A, B, hA, hB, hscales⟩ := hfinite N hN
  let q : Real := ((2 : Real)⁻¹) ^ (N - 2)
  let Cgeo : Real := ((2 : Real) ^ N / c) * (2 / r) ^ 2
  let Cfinal : Real := (A + B) * Cgeo / (1 - q)
  have hCfinal : 0 < Cfinal := by
    dsimp [Cfinal, Cgeo, q]
    have hq : ((2 : Real)⁻¹) ^ (N - 2) < 1 := by
      apply pow_lt_one₀ (by positivity) (by norm_num)
      exact Nat.ne_of_gt (Nat.sub_pos_of_lt (by omega : 2 < N))
    positivity
  refine ⟨Cfinal, hCfinal, ?_⟩
  intro delta hdelta hdeltaSmall
  obtain ⟨k0, cost, hnarrow, hbroad, hbound⟩ :=
    hscales delta hdelta hdeltaSmall
  let L : Real := (1 + |Real.log delta|) ^ (3 / 2 : Real)
  have hbase : 1 ≤ 1 + |Real.log delta| := by
    linarith [abs_nonneg (Real.log delta)]
  have hLone : 1 ≤ L := by
    dsimp [L]
    exact Real.one_le_rpow hbase (by norm_num)
  have hL : 0 ≤ L := (by norm_num : (0 : Real) ≤ 1).trans hLone
  intro f hf M
  have hsum :
      (∑ j ∈ Finset.range M,
        canonicalBandlimitedDyadicCoefficient N c r j * cost j) ≤
        Cfinal * L := by
    simpa only [Cfinal, Cgeo, q, L] using
      (scratch_sum_range_canonicalCoefficient_mul_cost_le
        M k0 N c r A B L (by omega) hc hr hA hB hL hLone cost
        (by simpa only [L] using hnarrow) hbroad)
  calc
    eLpNorm (canonicalReflectedUnitFiniteEnvelope c r w.S delta N f M)
        2 volume ≤
        ENNReal.ofReal
          (∑ j ∈ Finset.range M,
            canonicalBandlimitedDyadicCoefficient N c r j * cost j) *
          eLpNorm f 2 volume := hbound f hf M
    _ ≤ ENNReal.ofReal (Cfinal * L) * eLpNorm f 2 volume :=
      mul_le_mul_left (ENNReal.ofReal_le_ofReal hsum) _
    _ = ENNReal.ofReal
        (Cfinal * (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
          eLpNorm f 2 volume := by
      rfl

/-- End-to-end literal maximal theorem with a narrow/broad finite
unit-envelope premise. -/
theorem hasLightRayMaximalEstimate_of_thresholdedUnitNarrowBroadFiniteEnvelope
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (w : CanonicalReflectedScalePositiveUnitWiringGT c r)
    (hfinite : HasCanonicalDyadicUnitNarrowBroadFiniteEnvelopeL2EstimateGT w) :
    HasLightRayMaximalEstimate :=
  hasLightRayMaximalEstimate_of_thresholdedUnitFiniteEnvelope hc hr w
    (hasCanonicalDyadicUnitFiniteEnvelopeL2EstimateGT_of_narrowBroad
      hc hr w hfinite)

/-- Physical canonical signed scale version of the narrow/broad endpoint.
The only unresolved analytic input is exactly its stated finite
unit-direction reflected-envelope bound. -/
theorem hasLightRayMaximalEstimate_of_canonicalTubeSignedScaleNarrowBroad
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (hcore : ∀ u : thresholdedUnitE2, ‖u‖ ≤ r → c ≤ (canonicalPositiveCore u).re)
    (hScaleMeas : ∀ delta N f j, InnerSlabSchwartzTensorCore f →
