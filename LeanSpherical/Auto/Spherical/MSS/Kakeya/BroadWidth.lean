section

section Auto.Spherical.MSS

open Filter MeasureTheory Set FourierTransform
open Auto.Spherical.SurfaceMeasureDecay
open scoped BigOperators ENNReal EuclideanSpace FourierTransform

noncomputable section

abbrev canonicalSignedBroadScaleE2 := Euclidean 2

/-- The exact identification needed to use the physical broad-width argument
for a signed finite-envelope field.  It is deliberately required for every
signed inner-slab tensor, not just for nonnegative square packets: the broad
part of the finite analytic estimate is a signed-envelope estimate. -/
def HasCanonicalTubeSignedScaleBridge
    {c r : Real} (hr : 0 < r)
    (w : CanonicalReflectedScalePositiveUnitWiring c r) : Prop :=
  ∀ {delta : Real} (hdelta : 0 < delta), ∀ N f,
    InnerSlabSchwartzTensorCore f → ∀ j (omega : aux_lightRayDirection) y,
      let rho : Real := delta / canonicalBandlimitedDyadicScale r j
      let hrho : 0 < rho :=
        div_pos hdelta (canonicalBandlimitedDyadicScale_pos hr j)
      w.S delta N f j omega.1 y =
        canonicalTubeSignedAverage rho hrho omega.1 y f

/-- The literal signed physical scale field.  Outside the only regime used by
the closure (`delta > 0`) it is harmlessly set to zero, so this is a total
candidate for the finite-envelope field `S`. -/
noncomputable def canonicalTubeSignedScale
    (r : Real) (hr : 0 < r) :
    Real → Nat → (WaveSpaceTime → Complex) → Nat → canonicalSignedBroadScaleE2 →
        canonicalSignedBroadScaleE2 → Complex :=
  fun delta _N f j omega y =>
    if hdelta : 0 < delta then
      canonicalTubeSignedAverage
        (delta / canonicalBandlimitedDyadicScale r j)
        (div_pos hdelta (canonicalBandlimitedDyadicScale_pos hr j))
        omega y f
    else 0

/-- On positive widths the literal total scale field is exactly the canonical
convolution, with the scale positivity proof made explicit. -/
theorem canonicalTubeSignedScale_apply_of_pos
    {r : Real} (hr : 0 < r) {delta : Real} (hdelta : 0 < delta)
    (N : Nat) (f : WaveSpaceTime → Complex) (j : Nat) (omega y : canonicalSignedBroadScaleE2) :
    canonicalTubeSignedScale r hr delta N f j omega y =
      canonicalTubeSignedAverage
        (delta / canonicalBandlimitedDyadicScale r j)
        (div_pos hdelta (canonicalBandlimitedDyadicScale_pos hr j))
        omega y f := by
  simp only [canonicalTubeSignedScale, dif_pos hdelta]

/-- The literal scale field discharges the signed physical identification in
the broad adapter by reflexivity; no Fourier-evenness assertion is used. -/
theorem canonicalTubeSignedScale_hasBridge
    {c r : Real} (hr : 0 < r)
    (w : CanonicalReflectedScalePositiveUnitWiring c r)
    (hS : w.S = canonicalTubeSignedScale r hr) :
    HasCanonicalTubeSignedScaleBridge hr w := by
  intro delta hdelta N f hf j omega y
  rw [hS]
  exact canonicalTubeSignedScale_apply_of_pos hr hdelta N f j omega.1 y

/-- The routine Fubini/slice facts used by the absolute-kernel broad
domination.  They are kept explicit because they are independent of every
Kakeya maximal estimate. -/
structure CanonicalTubeSignedBroadRegularity
    (rho : Real) (hrho : 0 < rho) (N : Nat) (omega y : canonicalSignedBroadScaleE2)
    (f : WaveSpaceTime → Complex) : Prop where
  outer : Integrable (fun t : Real => ∫ x : canonicalSignedBroadScaleE2,
    FourierTransform.fourierInv
      (scratch_canonicalBandlimitedTubeMultiplier rho
        hrho : canonicalSignedBroadScaleE2 → Complex)
      (x + t • omega - y) * f (x, t))
    (volume.restrict lightRayTimeInterval)
  absOuter : Integrable (fun t : Real => ∫ x : canonicalSignedBroadScaleE2,
    ‖FourierTransform.fourierInv
      (scratch_canonicalBandlimitedTubeMultiplier rho
        hrho : canonicalSignedBroadScaleE2 → Complex)
      (x + t • omega - y) * f (x, t)‖)
    (volume.restrict lightRayTimeInterval)
  coreSlice : ∀ t, Integrable (fun x : canonicalSignedBroadScaleE2 =>
    scratch_smoothTubeCore canonicalAbsoluteCore rho omega y (x, t) *
      ‖f (x, t)‖) volume
  envSlice : ∀ t, Integrable (fun x : canonicalSignedBroadScaleE2 =>
    lightRayKernel rho N 0 x (y, 0) * ‖f (x, t)‖) volume
  coreTime : Integrable (fun t : Real => ∫ x : canonicalSignedBroadScaleE2,
    scratch_smoothTubeCore canonicalAbsoluteCore rho omega y (x, t) *
      ‖f (x, t)‖) (volume.restrict lightRayTimeInterval)
  envTime : Integrable (fun t : Real => ∫ x : canonicalSignedBroadScaleE2,
    lightRayKernel rho N 0 x (y, 0) * ‖f (x, t)‖)
    (volume.restrict lightRayTimeInterval)

/-- A fixed-width zero-direction `L²` bound in exactly the real form needed
by the signed broad-scale adapter.  The existing Young/time-Cauchy theorem
proves this from `ScratchZeroDirectionLightRayRegularity`; it is separated
here only to keep the scale assembly free of measure-conversion details. -/
def HasCanonicalZeroDirectionPositiveEnvelopeL2Bound (D : Nat → Real) : Prop :=
  ∀ N, 3 < N → 0 ≤ D N ∧
    ∀ rho : Real, (1 / 2 : Real) ≤ rho →
      ∀ f : WaveSpaceTime → Complex, InnerSlabSchwartzTensorCore f →
        eLpNorm (fun y =>
          scratch_zeroDirectionPositiveEnvelope rho N y
            (fun x t => ‖f (x, t)‖)) 2 volume ≤
          ENNReal.ofReal (D N) * eLpNorm f 2 volume

/-- The exact square-root constant supplied by the zero-direction Young and
finite-time Cauchy argument. -/
noncomputable def canonicalZeroDirectionL2Constant (N : Nat) : Real :=
  Real.sqrt (2 * (∫ u : canonicalSignedBroadScaleE2, lightRayDecayProfile N u) ^ 2)

theorem canonicalZeroDirectionL2Constant_nonneg (N : Nat) :
    0 ≤ canonicalZeroDirectionL2Constant N :=
  Real.sqrt_nonneg _

theorem canonicalZeroDirectionL2Constant_sq (N : Nat) :
    canonicalZeroDirectionL2Constant N ^ 2 =
      2 * (∫ u : canonicalSignedBroadScaleE2, lightRayDecayProfile N u) ^ 2 := by
  unfold canonicalZeroDirectionL2Constant
  rw [Real.sq_sqrt]
  positivity

/-- Restricting the nonnegative input energy to the literal light-ray time
slab cannot increase it.  This is the only place where the slab restriction
enters the zero-direction norm conversion. -/
theorem integral_sq_lightRayTimeInterval_le_full
    (f : WaveSpaceTime → Complex)
    (hfull : Integrable (fun z : WaveSpaceTime => ‖f z‖ ^ 2) volume) :
    (∫ t in lightRayTimeInterval, ∫ x : canonicalSignedBroadScaleE2, ‖f (x, t)‖ ^ 2) ≤
      ∫ z : WaveSpaceTime, ‖f z‖ ^ 2 := by
  let F : WaveSpaceTime → Real := fun z => ‖f z‖ ^ 2
  have hrestrict : Integrable F scratchLightRayMeasure :=
    hfull.mono_measure scratchLightRayMeasure_le_volume
  have hnonneg : 0 ≤ᵐ[volume] F :=
    Filter.Eventually.of_forall fun z => sq_nonneg _
  have hswap : Integrable
      (Function.uncurry (fun t : Real => fun x : canonicalSignedBroadScaleE2 => F (x, t)))
      ((volume.restrict lightRayTimeInterval).prod volume) := by
    convert hrestrict.swap using 1
    ext z
    rfl
  calc
    (∫ t in lightRayTimeInterval, ∫ x : canonicalSignedBroadScaleE2, ‖f (x, t)‖ ^ 2) =
        ∫ x : canonicalSignedBroadScaleE2, ∫ t in lightRayTimeInterval, F (x, t) := by
          exact integral_integral_swap hswap
    _ = ∫ z : WaveSpaceTime, F z ∂scratchLightRayMeasure := by
          simpa only [scratchLightRayMeasure] using
            (integral_prod F hrestrict).symm
    _ ≤ ∫ z : WaveSpaceTime, F z :=
      integral_mono_measure scratchLightRayMeasure_le_volume hnonneg hfull
    _ = ∫ z : WaveSpaceTime, ‖f z‖ ^ 2 := rfl

/-- The existing zero-direction square estimate converts directly into the
literal `eLpNorm` bound needed by the broad-scale model. -/
theorem eLpNorm_zeroDirectionPositiveEnvelope_le_canonicalConstant
    {rho : Real} (hrho : (1 / 2 : Real) ≤ rho)
    (N : Nat) (hN : 2 < N) (f : WaveSpaceTime → Complex)
    (hfull : Integrable (fun z : WaveSpaceTime => ‖f z‖ ^ 2) volume)
    (hregular : ScratchZeroDirectionLightRayRegularity rho N f) :
    eLpNorm (fun y =>
      scratch_zeroDirectionPositiveEnvelope rho N y
        (fun x t => ‖f (x, t)‖)) 2 volume ≤
      ENNReal.ofReal (canonicalZeroDirectionL2Constant N) *
        eLpNorm f 2 volume := by
  let Z : canonicalSignedBroadScaleE2 → Real := fun y =>
    scratch_zeroDirectionPositiveEnvelope rho N y (fun x t => ‖f (x, t)‖)
  let D : Real := canonicalZeroDirectionL2Constant N
  have hrho0 : 0 < rho := lt_of_lt_of_le (by norm_num) hrho
  have hZnonneg : ∀ y, 0 ≤ Z y := by
    intro y
    dsimp only [Z]
    unfold scratch_zeroDirectionPositiveEnvelope
    apply integral_nonneg
    intro t
    apply integral_nonneg
    intro x
    exact mul_nonneg (lightRayKernel_nonneg hrho0 N 0 x (y, 0)) (norm_nonneg _)
  have hZsq : Integrable (fun y : canonicalSignedBroadScaleE2 => Z y ^ 2) volume := by
    have hbase := scratch_integrable_sq_zeroDirectionLightRayEnvelope
      hrho0 N f hregular.output hregular.prod hregular.slice
    refine hbase.congr ?_
    filter_upwards with y
    change Z y ^ 2 = scratch_zeroDirectionLightRayEnvelope rho N y f ^ 2
    rfl
  have hZident :
      (∫ y : canonicalSignedBroadScaleE2, Z y ^ 2) =
        ∫ y : canonicalSignedBroadScaleE2, ‖scratch_zeroDirectionLightRayComplexEnvelope rho N y f‖
            ^ 2 := by
    apply integral_congr_ae
    filter_upwards with y
    change scratch_zeroDirectionLightRayEnvelope rho N y f ^ 2 =
      ‖scratch_zeroDirectionLightRayComplexEnvelope rho N y f‖ ^ 2
    rw [scratch_norm_zeroDirectionLightRayComplexEnvelope]
    rw [Real.norm_of_nonneg
      (scratch_zeroDirectionLightRayEnvelope_nonneg hrho0 N y f)]
  have hraw := scratch_integral_sq_zeroDirectionLightRayComplexEnvelope_le_norm
    hrho0 N hN f
    hregular.output hregular.prod hregular.prodSwap hregular.slice hregular.input
    hregular.spatialOutput hregular.spatialEnergy hregular.spatialMeas
      hregular.spatialSliceEnergy
  rw [scratch_lightRayTimeInterval_measureReal_univ] at hraw
  have hslab := integral_sq_lightRayTimeInterval_le_full f hfull
  have hrawZ : (∫ y : canonicalSignedBroadScaleE2, Z y ^ 2) ≤
      2 * (∫ u : canonicalSignedBroadScaleE2, lightRayDecayProfile N u) ^ 2 *
        ∫ z : WaveSpaceTime, ‖f z‖ ^ 2 := by
    calc
      (∫ y : canonicalSignedBroadScaleE2, Z y ^ 2) =
          ∫ y : canonicalSignedBroadScaleE2, ‖scratch_zeroDirectionLightRayComplexEnvelope rho N y
              f‖ ^ 2 :=
        hZident
      _ ≤ 2 * (∫ u : canonicalSignedBroadScaleE2, lightRayDecayProfile N u) ^ 2 *
          (∫ t in lightRayTimeInterval, ∫ x : canonicalSignedBroadScaleE2, ‖f (x, t)‖ ^ 2) := hraw
      _ ≤ 2 * (∫ u : canonicalSignedBroadScaleE2, lightRayDecayProfile N u) ^ 2 *
          ∫ z : WaveSpaceTime, ‖f z‖ ^ 2 :=
        mul_le_mul_of_nonneg_left hslab (by positivity)
  have hinputEq : ENNReal.ofReal (∫ z : WaveSpaceTime, ‖f z‖ ^ 2) =
      (eLpNorm f 2 volume) ^ (2 : Real) := by
    rw [ofReal_integral_eq_lintegral_ofReal hfull
      (Filter.Eventually.of_forall fun z => sq_nonneg _)]
    calc
      (∫⁻ z : WaveSpaceTime, ENNReal.ofReal (‖f z‖ ^ 2)) =
          ∫⁻ z : WaveSpaceTime, (ENNReal.ofReal ‖f z‖) ^ (2 : Real) := by
            apply lintegral_congr
            intro z
            rw [ENNReal.ofReal_pow (norm_nonneg _) 2, ENNReal.rpow_two]
      _ = (eLpNorm f 2 volume) ^ (2 : Real) := by
        simpa only [ENNReal.ofReal_ofNat] using
          (Auto.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow
            (μ := volume) (q := (2 : Real)) (by norm_num) f)
  have hD : 0 ≤ D := by
    dsimp only [D]
    exact canonicalZeroDirectionL2Constant_nonneg N
  have hDsq : D ^ 2 = 2 * (∫ u : canonicalSignedBroadScaleE2, lightRayDecayProfile N u) ^ 2 := by
    dsimp only [D]
    exact canonicalZeroDirectionL2Constant_sq N
  have hmoment :
      (∫⁻ y : canonicalSignedBroadScaleE2, ENNReal.ofReal (Z y ^ (2 : Real))) ≤
        (ENNReal.ofReal D * eLpNorm f 2 volume) ^ (2 : Real) := by
    calc
      (∫⁻ y : canonicalSignedBroadScaleE2, ENNReal.ofReal (Z y ^ (2 : Real))) =
          ENNReal.ofReal (∫ y : canonicalSignedBroadScaleE2, Z y ^ 2) := by
            simpa only [Real.rpow_two] using
              (ofReal_integral_eq_lintegral_ofReal hZsq
                (Filter.Eventually.of_forall fun y => sq_nonneg _)).symm
      _ ≤ ENNReal.ofReal
          (2 * (∫ u : canonicalSignedBroadScaleE2, lightRayDecayProfile N u) ^ 2 *
            ∫ z : WaveSpaceTime, ‖f z‖ ^ 2) :=
        ENNReal.ofReal_le_ofReal hrawZ
      _ = (ENNReal.ofReal D * eLpNorm f 2 volume) ^ (2 : Real) := by
        rw [← hDsq]
        rw [ENNReal.ofReal_mul (sq_nonneg D)]
        rw [ENNReal.ofReal_pow hD 2]
        rw [hinputEq]
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]
        exact congrArg (fun x : ENNReal =>
          x * eLpNorm f 2 volume ^ (2 : Real))
          (ENNReal.rpow_natCast (ENNReal.ofReal D) 2).symm
  calc
    eLpNorm Z 2 volume ≤
        ((ENNReal.ofReal D * eLpNorm f 2 volume) ^ (2 : Real)) ^
          ((2 : Real)⁻¹) := by
      simpa only [ENNReal.ofReal_ofNat] using
        (Auto.LpSpaceFacts.eLpNorm_real_nonneg_le_of_lintegral_ofReal_rpow_le
          volume Z (by norm_num) hZnonneg hmoment)
    _ = ENNReal.ofReal D * eLpNorm f 2 volume := by
      rw [← ENNReal.rpow_mul]
      norm_num

/-- The finite tensor core has finite full `L²` energy without any extra
analytic hypothesis. -/
theorem integrable_sq_innerSlabSchwartzTensorCore
    {f : WaveSpaceTime → Complex} (hf : InnerSlabSchwartzTensorCore f) :
    Integrable (fun z : WaveSpaceTime => ‖f z‖ ^ 2) volume := by
  rcases hf with ⟨ι, hι, q, a, radius, hradiusPos, hradiusLt, ha, rfl⟩
  letI : Fintype ι := hι
  change Integrable (fun z : canonicalSignedBroadScaleE2 × Real =>
    ‖scratch_innerSlabCompactFrequencyTensor q a z‖ ^ 2) (volume.prod volume)
  simpa only [scratch_innerSlabCompactFrequencyTensor,
    finiteTensorPhysicalTimeData] using
    (integrable_sq_finiteTensorPhysicalTimeData Finset.univ q a)

/-- Supplying the routine zero-direction regularity for finite inner-slab
Schwartz tensors gives the concrete zero-direction hypothesis used by the
signed broad-scale theorem. -/
theorem hasCanonicalZeroDirectionPositiveEnvelopeL2Bound_of_regular
    (hregular : ∀ N rho f, InnerSlabSchwartzTensorCore f →
      ScratchZeroDirectionLightRayRegularity rho N f) :
    HasCanonicalZeroDirectionPositiveEnvelopeL2Bound
      canonicalZeroDirectionL2Constant := by
  intro N hN
  refine ⟨canonicalZeroDirectionL2Constant_nonneg N, ?_⟩
  intro rho hrho f hf
  exact eLpNorm_zeroDirectionPositiveEnvelope_le_canonicalConstant
    hrho N (by omega) f (integrable_sq_innerSlabSchwartzTensorCore hf)
    (hregular N rho f hf)

/-- The physical absolute-kernel argument supplies the full signed broad
tail of the canonical unit-direction model.  After this theorem, the only
nontrivial scale input left for the final closure is the finite narrow
annular/envelope estimate. -/
theorem hasCanonicalDyadicUnitSignedBroadScaleL2Estimate_of_canonicalTube
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (w : CanonicalReflectedScalePositiveUnitWiring c r)
    (hS : HasCanonicalTubeSignedScaleBridge hr w)
    (hregular : ∀ {delta : Real}, 0 < delta → ∀ N f,
      InnerSlabSchwartzTensorCore f → ∀ j (omega : aux_lightRayDirection) y,
      let rho : Real := delta / canonicalBandlimitedDyadicScale r j
      (hrho : (1 / 2 : Real) ≤ rho) →
      CanonicalTubeSignedBroadRegularity rho
        (lt_of_lt_of_le (by norm_num) hrho) N omega.1 y f)
    (D : Nat → Real)
    (hzero : HasCanonicalZeroDirectionPositiveEnvelopeL2Bound D) :
    HasCanonicalDyadicUnitSignedBroadScaleL2Estimate w := by
  intro N hN
  obtain ⟨A, hA, hdecay⟩ :=
    exists_canonicalAbsoluteCore_le_lightRayDecayProfile N
  obtain ⟨hD, hzeroN⟩ := hzero N hN
  let C : Real := (6 : Real) ^ N * A
  let B : Real := C * D N
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg (pow_nonneg (by norm_num) _) hA
  have hB : 0 ≤ B := mul_nonneg hC hD
  refine ⟨B, hB, ?_⟩
  intro delta hdelta hdeltaSmall
  obtain ⟨k0, hk0, _⟩ :=
    exists_canonicalBandlimitedDyadic_broadWidthStart hdelta hr
  refine ⟨k0, hk0, ?_⟩
  intro f hf j hj
  let rho : Real := delta / canonicalBandlimitedDyadicScale r j
  have hrho : (1 / 2 : Real) ≤ rho := by
    dsimp only [rho]
    exact hk0 j hj
  have hrho0 : 0 < rho := lt_of_lt_of_le (by norm_num) hrho
  let Z : canonicalSignedBroadScaleE2 → Real := fun y =>
    scratch_zeroDirectionPositiveEnvelope rho N y (fun x t => ‖f (x, t)‖)
  have hZ : ∀ y, 0 ≤ Z y := by
    intro y
    dsimp only [Z]
    unfold scratch_zeroDirectionPositiveEnvelope
    apply integral_nonneg
    intro t
    apply integral_nonneg
    intro x
    exact mul_nonneg (lightRayKernel_nonneg hrho0 N 0 x (y, 0)) (norm_nonneg _)
  have hscalePoint : ∀ (omega : aux_lightRayDirection) y,
      ENNReal.ofReal ‖w.S delta N f j omega.1 y‖ ≤
        ENNReal.ofReal (C * Z y) := by
    intro omega y
    have homega : ‖omega.1‖ ≤ 1 :=
      (mem_unitLightRayDirections_iff omega.1).mp omega.2 |>.le
    have hreg := hregular hdelta N f hf j omega y hrho
    have hphysical :=
      norm_canonicalTubeSignedAverage_le_zeroDirectionPositiveEnvelope_of_decay
        N A hA hdecay hrho omega.1 y homega f
        hreg.outer hreg.absOuter hreg.coreSlice hreg.envSlice hreg.coreTime hreg.envTime
    rw [hS hdelta N f hf j omega y]
    exact ENNReal.ofReal_le_ofReal (by simpa only [C, Z] using hphysical)
  have hE : eLpNorm (canonicalReflectedUnitScaleEnvelope w.S delta N f j) 2 volume ≤
      ENNReal.ofReal C * eLpNorm Z 2 volume :=
    eLpNorm_canonicalReflectedUnitScaleEnvelope_le_of_unit_pointwise_real
      w.S delta N f j Z C hC hZ hscalePoint
  have hZbound : eLpNorm Z 2 volume ≤
      ENNReal.ofReal (D N) * eLpNorm f 2 volume := by
    simpa only [Z] using hzeroN rho hrho f hf
  let coeff : Real := canonicalBandlimitedDyadicCoefficient N c r j
  have hcoeff : 0 ≤ coeff := by
    dsimp only [coeff]
    unfold canonicalBandlimitedDyadicCoefficient
    positivity
  have hweightedPoint : ∀ y,
      ENNReal.ofReal coeff * canonicalReflectedUnitScaleEnvelope w.S delta N f j y ≤
        ENNReal.ofReal (coeff * C * Z y) := by
    intro y
    calc
      ENNReal.ofReal coeff * canonicalReflectedUnitScaleEnvelope w.S delta N f j y ≤
          ENNReal.ofReal coeff * ENNReal.ofReal (C * Z y) :=
        mul_le_mul_right
          (canonicalReflectedUnitScaleEnvelope_le_of_unit_pointwise
            w.S delta N f j y (ENNReal.ofReal (C * Z y))
            (fun omega => hscalePoint omega y)) _
      _ = ENNReal.ofReal (coeff * C * Z y) := by
        rw [← ENNReal.ofReal_mul hcoeff]
        congr 1
        exact (mul_assoc coeff C (Z y)).symm
  have hweighted : eLpNorm (fun y =>
      ENNReal.ofReal coeff * canonicalReflectedUnitScaleEnvelope w.S delta N f j y)
      2 volume ≤ ENNReal.ofReal (coeff * C) * eLpNorm Z 2 volume := by
    apply eLpNorm_ennreal_le_ofReal_mul_real volume
      (fun y => ENNReal.ofReal coeff *
        canonicalReflectedUnitScaleEnvelope w.S delta N f j y)
      Z (coeff * C)
    · exact mul_nonneg hcoeff hC
    · exact hZ
    · intro y
      simpa only [mul_assoc] using hweightedPoint y
  calc
    eLpNorm (fun y =>
        ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
          canonicalReflectedUnitScaleEnvelope w.S delta N f j y) 2 volume =
        eLpNorm (fun y =>
          ENNReal.ofReal coeff *
            canonicalReflectedUnitScaleEnvelope w.S delta N f j y) 2 volume := by
          rfl
    _ ≤ ENNReal.ofReal (coeff * C) * eLpNorm Z 2 volume := hweighted
    _ ≤ ENNReal.ofReal (coeff * C) *
        (ENNReal.ofReal (D N) * eLpNorm f 2 volume) :=
      mul_le_mul_right hZbound _
    _ = ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j * B) *
        eLpNorm f 2 volume := by
      dsimp only [coeff, B]
      have hcoeffC : 0 ≤ canonicalBandlimitedDyadicCoefficient N c r j * C :=
        mul_nonneg hcoeff hC
      calc
        ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j * C) *
              (ENNReal.ofReal (D N) * eLpNorm f 2 volume) =
            (ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
              ENNReal.ofReal C * ENNReal.ofReal (D N)) * eLpNorm f 2 volume := by
              rw [ENNReal.ofReal_mul hcoeff]
              ring
        _ = ENNReal.ofReal
              (canonicalBandlimitedDyadicCoefficient N c r j * C) *
                ENNReal.ofReal (D N) * eLpNorm f 2 volume := by
              rw [ENNReal.ofReal_mul hcoeff]
        _ = ENNReal.ofReal
              ((canonicalBandlimitedDyadicCoefficient N c r j * C) * D N) *
                eLpNorm f 2 volume := by
              rw [← ENNReal.ofReal_mul hcoeffC]
        _ = ENNReal.ofReal
              (canonicalBandlimitedDyadicCoefficient N c r j * (C * D N)) *
                eLpNorm f 2 volume := by ring

/-- Fully assembled broad-scale clause with its natural explicit inputs: the
literal signed canonical convolution, routine canonical-kernel Fubini data,
and the already packaged zero-direction regularity. -/
theorem hasCanonicalDyadicUnitSignedBroadScaleL2Estimate_of_canonicalTube_regular
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (w : CanonicalReflectedScalePositiveUnitWiring c r)
    (hS : HasCanonicalTubeSignedScaleBridge hr w)
    (hregular : ∀ {delta : Real}, 0 < delta → ∀ N f,
      InnerSlabSchwartzTensorCore f → ∀ j (omega : aux_lightRayDirection) y,
      let rho : Real := delta / canonicalBandlimitedDyadicScale r j
      (hrho : (1 / 2 : Real) ≤ rho) →
      CanonicalTubeSignedBroadRegularity rho
        (lt_of_lt_of_le (by norm_num) hrho) N omega.1 y f)
    (hzeroRegular : ∀ N rho f, InnerSlabSchwartzTensorCore f →
      ScratchZeroDirectionLightRayRegularity rho N f) :
    HasCanonicalDyadicUnitSignedBroadScaleL2Estimate w :=
  hasCanonicalDyadicUnitSignedBroadScaleL2Estimate_of_canonicalTube
    hc hr w hS hregular canonicalZeroDirectionL2Constant
    (hasCanonicalZeroDirectionPositiveEnvelopeL2Bound_of_regular hzeroRegular)

end

