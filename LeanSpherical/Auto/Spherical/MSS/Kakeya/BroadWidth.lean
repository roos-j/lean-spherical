/-- The normalized smooth core used in the dyadic domination file is exactly
the generic positive tube core used by the broad-width argument. -/
theorem scratch_smoothLightRayCore_eq_smoothTubeCore
    (rho : Real) (omega y : Euclidean 2) (z : WaveSpaceTime) :
    smoothLightRayCore rho omega y z =
      scratch_smoothTubeCore (spatialCoreBump : Euclidean 2 → Real)
        rho omega y z := by
  rfl

/-- At widths at least one half, the actual normalized smooth core has the
same strictly positive, direction-free light-ray envelope as the generic
broad core. -/
theorem scratch_smoothLightRayCore_le_zeroDirectionLightRayKernel
    {rho : Real} (hrho : (1 / 2 : Real) ≤ rho) (N : Nat)
    (omega y x : Euclidean 2) (t : Real)
    (homega : ‖omega‖ ≤ 1) (ht : t ∈ lightRayTimeInterval) :
    smoothLightRayCore rho omega y (x, t) ≤
      (17 : Real) ^ N * lightRayKernel rho N 0 x (y, 0) := by
  rw [scratch_smoothLightRayCore_eq_smoothTubeCore]
  exact scratch_smoothTubeCore_le_zeroDirectionLightRayKernel
    (spatialCoreBump : Euclidean 2 → Real)
    spatialCoreBump_nonneg spatialCoreBump_le_one
    (fun {u} hu => spatialCoreBump_eq_one_of_norm_le_one hu)
    (fun {u} hu => spatialCoreBump_eq_zero_of_two_le_norm hu)
    hrho N omega y x t homega ht

/-- The positive normalized smooth tube average on the fixed time slab. -/
noncomputable def scratch_smoothLightRayCoreAverage
    (rho : Real) (omega y : Euclidean 2)
    (g : WaveSpaceTime → Complex) : Real :=
  ∫ t in lightRayTimeInterval, ∫ x : Euclidean 2,
    smoothLightRayCore rho omega y (x, t) * ‖g (x, t)‖

/-- The positive fixed-direction broad envelope. -/
noncomputable def scratch_zeroDirectionLightRayEnvelope
    (rho : Real) (N : Nat) (y : Euclidean 2)
    (g : WaveSpaceTime → Complex) : Real :=
  ∫ t in lightRayTimeInterval, ∫ x : Euclidean 2,
    lightRayKernel rho N 0 x (y, 0) * ‖g (x, t)‖

/-- The positive smooth average is the specialization of the generic core
average to `spatialCoreBump`. -/
theorem scratch_smoothLightRayCoreAverage_eq_positiveSmoothTubeAverage
    (rho : Real) (omega y : Euclidean 2)
    (g : WaveSpaceTime → Complex) :
    scratch_smoothLightRayCoreAverage rho omega y g =
      scratch_positiveSmoothTubeAverage
        (spatialCoreBump : Euclidean 2 → Real) rho omega y
        (fun x t => ‖g (x, t)‖) := by
  unfold scratch_smoothLightRayCoreAverage scratch_positiveSmoothTubeAverage
  apply integral_congr_ae
  filter_upwards with t
  apply integral_congr_ae
  filter_upwards with x
  rw [scratch_smoothLightRayCore_eq_smoothTubeCore]

/-- The positive fixed-direction envelope is the corresponding generic
zero-direction positive envelope. -/
theorem scratch_zeroDirectionLightRayEnvelope_eq_positiveEnvelope
    (rho : Real) (N : Nat) (y : Euclidean 2)
    (g : WaveSpaceTime → Complex) :
    scratch_zeroDirectionLightRayEnvelope rho N y g =
      scratch_zeroDirectionPositiveEnvelope rho N y (fun x t => ‖g (x, t)‖) := by
  rfl

/-- The actual smooth core inherits the broad positive envelope pointwise
after spatial and time integration. -/
theorem scratch_smoothLightRayCoreAverage_le_zeroDirectionLightRayEnvelope
    {rho : Real} (hrho : (1 / 2 : Real) ≤ rho)
    (N : Nat) (omega y : Euclidean 2) (homega : ‖omega‖ ≤ 1)
    (g : WaveSpaceTime → Complex)
    (hcoreSlice : ∀ t, Integrable (fun x : Euclidean 2 =>
      smoothLightRayCore rho omega y (x, t) * ‖g (x, t)‖) volume)
    (henvSlice : ∀ t, Integrable (fun x : Euclidean 2 =>
      lightRayKernel rho N 0 x (y, 0) * ‖g (x, t)‖) volume)
    (hcoreTime : Integrable (fun t : Real => ∫ x : Euclidean 2,
      smoothLightRayCore rho omega y (x, t) * ‖g (x, t)‖)
      (volume.restrict lightRayTimeInterval))
    (henvTime : Integrable (fun t : Real => ∫ x : Euclidean 2,
      lightRayKernel rho N 0 x (y, 0) * ‖g (x, t)‖)
      (volume.restrict lightRayTimeInterval)) :
    scratch_smoothLightRayCoreAverage rho omega y g ≤
      (17 : Real) ^ N * scratch_zeroDirectionLightRayEnvelope rho N y g := by
  rw [scratch_smoothLightRayCoreAverage_eq_positiveSmoothTubeAverage,
    scratch_zeroDirectionLightRayEnvelope_eq_positiveEnvelope]
  apply scratch_positiveSmoothTubeAverage_le_zeroDirectionPositiveEnvelope
    (spatialCoreBump : Euclidean 2 → Real)
    spatialCoreBump_nonneg spatialCoreBump_le_one
    (fun {u} hu => spatialCoreBump_eq_one_of_norm_le_one hu)
    (fun {u} hu => spatialCoreBump_eq_zero_of_two_le_norm hu)
    hrho N omega y homega
  · intro x t
    exact norm_nonneg _
  · exact hcoreSlice
  · exact henvSlice
  · exact hcoreTime
  · exact henvTime

/-- Complex-valued version of the positive zero-direction envelope, suited
to the existing spatial weighted-Cauchy and time-Cauchy closures. -/
noncomputable def scratch_zeroDirectionLightRayComplexEnvelope
    (rho : Real) (N : Nat) (y : Euclidean 2)
    (g : WaveSpaceTime → Complex) : Complex :=
  ∫ t in lightRayTimeInterval, ∫ x : Euclidean 2,
    (lightRayKernel rho N 0 x (y, 0) : Complex) * (‖g (x, t)‖ : Complex)

/-- Passing between the positive real envelope and its complex form is exact;
no loss from the absolute value is hidden at this step. -/
theorem scratch_zeroDirectionLightRayComplexEnvelope_eq_ofReal
    (rho : Real) (N : Nat) (y : Euclidean 2)
    (g : WaveSpaceTime → Complex) :
    scratch_zeroDirectionLightRayComplexEnvelope rho N y g =
      (scratch_zeroDirectionLightRayEnvelope rho N y g : Complex) := by
  unfold scratch_zeroDirectionLightRayComplexEnvelope
    scratch_zeroDirectionLightRayEnvelope
  let q : Real → Real := fun t => ∫ x : Euclidean 2,
    lightRayKernel rho N 0 x (y, 0) * ‖g (x, t)‖
  have hinner (t : Real) :
      (∫ x : Euclidean 2,
        (lightRayKernel rho N 0 x (y, 0) : Complex) * (‖g (x, t)‖ : Complex)) =
        (q t : Complex) := by
    calc
      (∫ x : Euclidean 2,
        (lightRayKernel rho N 0 x (y, 0) : Complex) * (‖g (x, t)‖ : Complex)) =
          ∫ x : Euclidean 2,
            ((lightRayKernel rho N 0 x (y, 0) * ‖g (x, t)‖ : Real) : Complex) := by
            apply integral_congr_ae
            filter_upwards with x
            rw [← Complex.ofReal_mul]
      _ = (q t : Complex) := by
            change (∫ x : Euclidean 2,
              ((lightRayKernel rho N 0 x (y, 0) * ‖g (x, t)‖ : Real) : Complex)) =
                ((∫ x : Euclidean 2,
                  lightRayKernel rho N 0 x (y, 0) * ‖g (x, t)‖ : Real) : Complex)
            exact (integral_ofReal (𝕜 := Complex) (μ := volume)
              (f := fun x : Euclidean 2 =>
                lightRayKernel rho N 0 x (y, 0) * ‖g (x, t)‖))
  let r : Real := ∫ t in lightRayTimeInterval, q t
  change (∫ t in lightRayTimeInterval, ∫ x : Euclidean 2,
    (lightRayKernel rho N 0 x (y, 0) : Complex) * (‖g (x, t)‖ : Complex)) =
      (r : Complex)
  calc
    (∫ t in lightRayTimeInterval, ∫ x : Euclidean 2,
      (lightRayKernel rho N 0 x (y, 0) : Complex) * (‖g (x, t)‖ : Complex)) =
        ∫ t in lightRayTimeInterval,
          (q t : Complex) := by
          apply integral_congr_ae
          filter_upwards with t
          exact hinner t
    _ = (r : Complex) := by
          change (∫ t in lightRayTimeInterval, (q t : Complex)) =
            ((∫ t in lightRayTimeInterval, q t : Real) : Complex)
          exact (integral_ofReal (𝕜 := Complex)
            (μ := volume.restrict lightRayTimeInterval)
            (f := q))

theorem scratch_norm_zeroDirectionLightRayComplexEnvelope
    (rho : Real) (N : Nat) (y : Euclidean 2)
    (g : WaveSpaceTime → Complex) :
    ‖scratch_zeroDirectionLightRayComplexEnvelope rho N y g‖ =
      ‖scratch_zeroDirectionLightRayEnvelope rho N y g‖ := by
  rw [scratch_zeroDirectionLightRayComplexEnvelope_eq_ofReal, Complex.norm_real]

/-- The positive input supplied to the fixed zero-direction operator. -/
noncomputable def scratch_normInput (g : WaveSpaceTime → Complex) :
    Euclidean 2 → Real → Complex := fun x t => (‖g (x, t)‖ : Complex)

theorem scratch_normInput_norm (g : WaveSpaceTime → Complex)
    (x : Euclidean 2) (t : Real) :
    ‖scratch_normInput g x t‖ = ‖g (x, t)‖ := by
  unfold scratch_normInput
  rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]

/-- The existing positive-kernel spatial Young closure and finite-time
Cauchy closure give a literal `L²` estimate for the zero-direction envelope.
The hypotheses are only the corresponding Fubini/slice regularity facts. -/
theorem scratch_integral_sq_zeroDirectionLightRayComplexEnvelope_le
    {rho : Real} (hrho : 0 < rho) (N : Nat) (hN : 2 < N)
    (g : WaveSpaceTime → Complex)
    (houtput : AEStronglyMeasurable (fun y : Euclidean 2 =>
      scratch_zeroDirectionLightRayComplexEnvelope rho N y g) volume)
