/-- A low-elaboration wrapper for the measurable supremum of a jointly
continuous family over the literal compact light-ray direction subtype. -/
theorem measurable_iSup_ennreal_norm_of_continuous_auxDirection
    {F : aux_lightRayDirection × Euclidean 2 → Complex}
    (hF : Continuous F) :
    Measurable (fun y : Euclidean 2 =>
      ⨆ omega : aux_lightRayDirection, ENNReal.ofReal ‖F (omega, y)‖) := by
  let G : aux_lightRayDirection → Euclidean 2 → ENNReal := fun omega y =>
    ENNReal.ofReal ‖F (omega, y)‖
  have hG : Measurable (⨆ omega : aux_lightRayDirection, G omega) := by
    apply measurable_iSup_of_lowerSemicontinuous
    · intro omega
      have hfixed : Continuous (fun y : Euclidean 2 => F (omega, y)) :=
        hF.comp (continuous_const.prodMk continuous_id)
      change Measurable (ENNReal.ofReal ∘ fun y : Euclidean 2 => ‖F (omega, y)‖)
      exact (ENNReal.continuous_ofReal.comp hfixed.norm).measurable
    · intro y
      have hfixed : Continuous (fun omega : aux_lightRayDirection => F (omega, y)) :=
        hF.comp (continuous_id.prodMk continuous_const)
      change LowerSemicontinuous (ENNReal.ofReal ∘ fun omega : aux_lightRayDirection =>
        ‖F (omega, y)‖)
      exact (ENNReal.continuous_ofReal.comp hfixed.norm).lowerSemicontinuous
  have hEq :
      (fun y : Euclidean 2 =>
        ⨆ omega : aux_lightRayDirection, ENNReal.ofReal ‖F (omega, y)‖) =
        ⨆ omega : aux_lightRayDirection, G omega := by
    funext y
    exact (iSup_apply
      (f := fun omega : aux_lightRayDirection => fun y : Euclidean 2 =>
        ENNReal.ofReal ‖F (omega, y)‖) (a := y)).symm
  rw [hEq]
  exact hG

/-- Restrict a jointly continuous Euclidean direction field to the literal
unit-direction subtype.  Keeping this generic prevents unfolding a concrete
oscillatory field during the final measurability application. -/
theorem comp_auxLightRayDirection_val_prod
    {F : Euclidean 2 × Euclidean 2 → Complex} (hF : Continuous F) :
    Continuous (fun p : aux_lightRayDirection × Euclidean 2 => F (p.1.1, p.2)) := by
  exact hF.comp ((continuous_subtype_val.comp continuous_fst).prodMk continuous_snd)

