abbrev gtNarrowBroadAdapterE2 := Euclidean 2

/-- The literal thresholded wiring with every structural field concrete: the
unit-direction envelope measurability, kernel measurability, and reflected
square Fubini bridge are all supplied by scratch theorems. -/
noncomputable def canonicalTubeSignedScaleConcreteUnitWiringGT
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (hcore : ∀ u : gtNarrowBroadAdapterE2, ‖u‖ ≤ r → c ≤ (canonicalPositiveCore u).re) :
    CanonicalReflectedScalePositiveUnitWiringGT c r :=
  canonicalTubeSignedScaleUnitWiringGT_of_scaleBridge hc hr hcore
    (fun delta N f j hf =>
      measurable_canonicalReflectedUnitScaleEnvelope_canonicalTubeSignedScale
        hr delta N f j hf)
    (fun delta N f hf j omega y =>
      aemeasurable_canonicalReflectedSquareDyadicKernel_mul_input
        delta N f hf j omega y)
    (hasCanonicalReflectedSquareScaleBridge_canonicalTubeSignedScale hr)

/-- The narrow one-scale input in the exact weighted norm form consumed by
the thresholded unit-envelope closure.  It is only required at genuinely
narrow physical widths. -/
def HasCanonicalDyadicUnitNarrowScaleCostGT
    {c r : Real} (w : CanonicalReflectedScalePositiveUnitWiringGT c r) : Prop :=
  ∀ N : Nat, 3 < N → ∃ A : Real, 0 < A ∧
    ∀ delta : Real, 0 < delta → delta < 1 / 2 →
      ∀ j : Nat, delta / canonicalBandlimitedDyadicScale r j < 1 / 2 →
        ∀ f : WaveSpaceTime → Complex, InnerSlabSchwartzTensorCore f →
          eLpNorm (fun y =>
            ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
              canonicalReflectedUnitScaleEnvelope w.S delta N f j y) 2 volume ≤
            ENNReal.ofReal
              (canonicalBandlimitedDyadicCoefficient N c r j *
                (A * (1 + |Real.log delta|) ^ (3 / 2 : Real))) *
              eLpNorm f 2 volume

/-- The broad one-scale contribution in the same exact weighted norm form.
It deliberately has no continuity or density premise: it is the absolute
canonical-kernel estimate for the literal signed scale field. -/
def HasCanonicalDyadicUnitBroadScaleCostGT
    {c r : Real} (w : CanonicalReflectedScalePositiveUnitWiringGT c r) : Prop :=
  ∀ N : Nat, 3 < N → ∃ B : Real, 0 ≤ B ∧
    ∀ delta : Real, 0 < delta → delta < 1 / 2 →
      ∃ k0 : Nat,
        (∀ j : Nat, k0 ≤ j →
          (1 / 2 : Real) ≤ delta / canonicalBandlimitedDyadicScale r j) ∧
        (∀ j : Nat, j < k0 →
          delta / canonicalBandlimitedDyadicScale r j < 1 / 2) ∧
        ∀ f : WaveSpaceTime → Complex, InnerSlabSchwartzTensorCore f →
          ∀ j : Nat, k0 ≤ j →
            eLpNorm (fun y =>
              ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
                canonicalReflectedUnitScaleEnvelope w.S delta N f j y) 2 volume ≤
              ENNReal.ofReal
                (canonicalBandlimitedDyadicCoefficient N c r j * B) *
                eLpNorm f 2 volume

/-- Raw broad-cost formulation for the literal physical signed scale.  It is
separated from the thresholded wiring only to avoid reintroducing the old
all-parameter fixed-direction continuity field. -/
def HasCanonicalTubeSignedScaleBroadCost (c r : Real) (hr : 0 < r) : Prop :=
  ∀ N : Nat, 3 < N → ∃ B : Real, 0 ≤ B ∧
    ∀ delta : Real, 0 < delta → delta < 1 / 2 →
      ∃ k0 : Nat,
        (∀ j : Nat, k0 ≤ j →
          (1 / 2 : Real) ≤ delta / canonicalBandlimitedDyadicScale r j) ∧
        (∀ j : Nat, j < k0 →
          delta / canonicalBandlimitedDyadicScale r j < 1 / 2) ∧
        ∀ f : WaveSpaceTime → Complex, InnerSlabSchwartzTensorCore f →
          ∀ j : Nat, k0 ≤ j →
            eLpNorm (fun y =>
              ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
                canonicalReflectedUnitScaleEnvelope
                  (canonicalTubeSignedScale r hr) delta N f j y) 2 volume ≤
              ENNReal.ofReal
                (canonicalBandlimitedDyadicCoefficient N c r j * B) *
                eLpNorm f 2 volume

/-- The absolute canonical-core broad-width argument in raw physical form.
All regularity and zero-direction inputs are discharged on the finite
inner-slab Schwartz tensor core. -/
theorem hasCanonicalTubeSignedScaleBroadCost
    {c r : Real} (hc : 0 < c) (hr : 0 < r) :
    HasCanonicalTubeSignedScaleBroadCost c r hr := by
  intro N hN
  obtain ⟨A, hA, hdecay⟩ :=
    exists_canonicalAbsoluteCore_le_lightRayDecayProfile N
  obtain ⟨hD, hzeroN⟩ :=
    hasCanonicalZeroDirectionPositiveEnvelopeL2Bound_innerSlabSchwartzTensor N hN
  let C : Real := (6 : Real) ^ N * A
  let B : Real := C * canonicalZeroDirectionL2Constant N
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg (pow_nonneg (by norm_num) _) hA
  have hB : 0 ≤ B :=
    mul_nonneg hC hD
  refine ⟨B, hB, ?_⟩
  intro delta hdelta hdeltaSmall
  obtain ⟨k0, hk0, hk0narrow⟩ :=
    exists_canonicalBandlimitedDyadic_broadWidthStart hdelta hr
  refine ⟨k0, hk0, hk0narrow, ?_⟩
  intro f hf j hj
  let rho : Real := delta / canonicalBandlimitedDyadicScale r j
  have hrho : (1 / 2 : Real) ≤ rho := by
    dsimp only [rho]
    exact hk0 j hj
  have hrho0 : 0 < rho := lt_of_lt_of_le (by norm_num) hrho
  let Z : gtNarrowBroadAdapterE2 → Real := fun y =>
    scratch_zeroDirectionPositiveEnvelope rho N y (fun x t => ‖f (x, t)‖)
  have hZ : ∀ y, 0 ≤ Z y := by
    intro y
    dsimp only [Z]
    unfold scratch_zeroDirectionPositiveEnvelope
    apply integral_nonneg
    intro t
    apply integral_nonneg
    intro x
    exact mul_nonneg (lightRayKernel_nonneg hrho0 N 0 x (y, 0)) (norm_nonneg _)
  have hscalePoint : ∀ (omega : aux_lightRayDirection) y,
      ENNReal.ofReal ‖canonicalTubeSignedScale r hr delta N f j omega.1 y‖ ≤
        ENNReal.ofReal (C * Z y) := by
    intro omega y
    have homega : ‖omega.1‖ ≤ 1 :=
      (mem_unitLightRayDirections_iff omega.1).mp omega.2 |>.le
    have hreg : CanonicalTubeSignedBroadRegularity rho hrho0 N omega.1 y f := by
      rcases hf with ⟨ι, hι, q, a, radius, hradiusPos, hradiusLt, ha, hfEq⟩
      letI : Fintype ι := hι
      subst f
      exact canonicalTubeSignedBroadRegularity_innerSlabSchwartzTensor
        hrho N omega.1 y homega q a
    have hphysical :=
      norm_canonicalTubeSignedAverage_le_zeroDirectionPositiveEnvelope_of_decay
        N A hA hdecay hrho omega.1 y homega f
        hreg.outer hreg.absOuter hreg.coreSlice hreg.envSlice hreg.coreTime hreg.envTime
    rw [canonicalTubeSignedScale_apply_of_pos hr hdelta]
    exact ENNReal.ofReal_le_ofReal (by
      simpa only [C, Z, rho] using hphysical)
  have hE : eLpNorm
      (canonicalReflectedUnitScaleEnvelope (canonicalTubeSignedScale r hr) delta N f j)
      2 volume ≤ ENNReal.ofReal C * eLpNorm Z 2 volume :=
    eLpNorm_canonicalReflectedUnitScaleEnvelope_le_of_unit_pointwise_real
      (canonicalTubeSignedScale r hr) delta N f j Z C hC hZ hscalePoint
  have hZbound : eLpNorm Z 2 volume ≤
      ENNReal.ofReal (canonicalZeroDirectionL2Constant N) * eLpNorm f 2 volume := by
    simpa only [Z] using hzeroN rho hrho f hf
  let coeff : Real := canonicalBandlimitedDyadicCoefficient N c r j
  have hcoeff : 0 ≤ coeff := by
    dsimp only [coeff]
    unfold canonicalBandlimitedDyadicCoefficient
    positivity
  have hweightedPoint : ∀ y,
      ENNReal.ofReal coeff *
          canonicalReflectedUnitScaleEnvelope (canonicalTubeSignedScale r hr) delta N f j y ≤
        ENNReal.ofReal (coeff * C * Z y) := by
    intro y
    calc
      ENNReal.ofReal coeff *
          canonicalReflectedUnitScaleEnvelope (canonicalTubeSignedScale r hr) delta N f j y ≤
          ENNReal.ofReal coeff * ENNReal.ofReal (C * Z y) :=
        mul_le_mul_right
          (canonicalReflectedUnitScaleEnvelope_le_of_unit_pointwise
            (canonicalTubeSignedScale r hr) delta N f j y
            (ENNReal.ofReal (C * Z y)) (fun omega => hscalePoint omega y)) _
      _ = ENNReal.ofReal (coeff * C * Z y) := by
        rw [← ENNReal.ofReal_mul hcoeff]
        congr 1
        exact (mul_assoc coeff C (Z y)).symm
  have hweighted : eLpNorm (fun y =>
      ENNReal.ofReal coeff *
        canonicalReflectedUnitScaleEnvelope (canonicalTubeSignedScale r hr) delta N f j y)
      2 volume ≤ ENNReal.ofReal (coeff * C) * eLpNorm Z 2 volume := by
    apply eLpNorm_ennreal_le_ofReal_mul_real volume
      (fun y => ENNReal.ofReal coeff *
        canonicalReflectedUnitScaleEnvelope (canonicalTubeSignedScale r hr) delta N f j y)
      Z (coeff * C)
    · exact mul_nonneg hcoeff hC
    · exact hZ
    · intro y
      simpa only [mul_assoc] using hweightedPoint y
  calc
    eLpNorm (fun y =>
        ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
          canonicalReflectedUnitScaleEnvelope (canonicalTubeSignedScale r hr) delta N f j y)
        2 volume =
        eLpNorm (fun y => ENNReal.ofReal coeff *
          canonicalReflectedUnitScaleEnvelope (canonicalTubeSignedScale r hr) delta N f j y)
          2 volume := by
          rfl
    _ ≤ ENNReal.ofReal (coeff * C) * eLpNorm Z 2 volume := hweighted
    _ ≤ ENNReal.ofReal (coeff * C) *
        (ENNReal.ofReal (canonicalZeroDirectionL2Constant N) * eLpNorm f 2 volume) :=
      mul_le_mul_right hZbound _
    _ = ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j * B) *
          eLpNorm f 2 volume := by
      dsimp only [coeff, B]
      have hcoeffC : 0 ≤ canonicalBandlimitedDyadicCoefficient N c r j * C :=
        mul_nonneg hcoeff hC
      calc
        ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j * C) *
              (ENNReal.ofReal (canonicalZeroDirectionL2Constant N) *
                eLpNorm f 2 volume) =
            (ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
              ENNReal.ofReal C * ENNReal.ofReal (canonicalZeroDirectionL2Constant N)) *
                eLpNorm f 2 volume := by
              rw [ENNReal.ofReal_mul hcoeff]
              ring
        _ = ENNReal.ofReal
              (canonicalBandlimitedDyadicCoefficient N c r j * C) *
                ENNReal.ofReal (canonicalZeroDirectionL2Constant N) *
                  eLpNorm f 2 volume := by
              rw [ENNReal.ofReal_mul hcoeff]
        _ = ENNReal.ofReal
              ((canonicalBandlimitedDyadicCoefficient N c r j * C) *
                canonicalZeroDirectionL2Constant N) * eLpNorm f 2 volume := by
              rw [← ENNReal.ofReal_mul hcoeffC]
        _ = ENNReal.ofReal
              (canonicalBandlimitedDyadicCoefficient N c r j *
                (C * canonicalZeroDirectionL2Constant N)) *
                  eLpNorm f 2 volume := by ring

/-- The raw broad theorem instantiates the literal thresholded physical
wiring definitionally; its fixed-direction field is never used here. -/
theorem hasCanonicalDyadicUnitBroadScaleCostGT_canonicalTubeSignedScale
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (hcore : ∀ u : gtNarrowBroadAdapterE2, ‖u‖ ≤ r → c ≤ (canonicalPositiveCore u).re)
    (hScaleMeas : ∀ delta N f j, InnerSlabSchwartzTensorCore f →
      Measurable (canonicalReflectedUnitScaleEnvelope
        (canonicalTubeSignedScale r hr) delta N f j))
    (hKmeas : ∀ delta N f,
      NonnegativeSquareInnerSlabSchwartzTensorCore f →
      ∀ j (omega : aux_lightRayDirection) y,
        AEMeasurable (fun z =>
          canonicalReflectedSquareDyadicKernel c r delta N j omega y z *
            canonicalSquareInput f z) scratchLightRayMeasure)
    (hbridge : HasCanonicalReflectedSquareScaleBridge r hr
      (canonicalTubeSignedScale r hr)) :
    HasCanonicalDyadicUnitBroadScaleCostGT
      (canonicalTubeSignedScaleUnitWiringGT_of_scaleBridge
        hc hr hcore hScaleMeas hKmeas hbridge) := by
  change HasCanonicalTubeSignedScaleBroadCost c r hr
  exact hasCanonicalTubeSignedScaleBroadCost hc hr

/-- Fully concrete broad clause for the literal thresholded wiring. -/
theorem hasCanonicalDyadicUnitBroadScaleCostGT_concrete
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (hcore : ∀ u : gtNarrowBroadAdapterE2, ‖u‖ ≤ r → c ≤ (canonicalPositiveCore u).re) :
    HasCanonicalDyadicUnitBroadScaleCostGT
      (canonicalTubeSignedScaleConcreteUnitWiringGT hc hr hcore) := by
  change HasCanonicalTubeSignedScaleBroadCost c r hr
  exact hasCanonicalTubeSignedScaleBroadCost hc hr

/-- Finite Minkowski packaging for a thresholded unit wiring.  The proof is
kept independent of the old all-parameter wiring, so it can be used directly
with the `N > 1` physical closure. -/
theorem eLpNorm_canonicalReflectedUnitFiniteEnvelope_le_of_weightedScaleBounds_gt
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (w : CanonicalReflectedScalePositiveUnitWiringGT c r)
    (delta : Real) (N : Nat) (f : WaveSpaceTime → Complex)
    (hf : InnerSlabSchwartzTensorCore f) (M : Nat) (cost : Nat → Real)
    (hcost : ∀ j, j ∈ Finset.range M → 0 ≤ cost j)
    (hbound : ∀ j, j ∈ Finset.range M →
      eLpNorm (fun y =>
        ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
          canonicalReflectedUnitScaleEnvelope w.S delta N f j y) 2 volume ≤
        ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j * cost j) *
          eLpNorm f 2 volume) :
    eLpNorm (canonicalReflectedUnitFiniteEnvelope c r w.S delta N f M) 2 volume ≤
      ENNReal.ofReal (∑ j ∈ Finset.range M,
        canonicalBandlimitedDyadicCoefficient N c r j * cost j) *
        eLpNorm f 2 volume := by
  have hcoeff : ∀ j : Nat, 0 ≤ canonicalBandlimitedDyadicCoefficient N c r j := by
    intro j
    unfold canonicalBandlimitedDyadicCoefficient
    positivity
  calc
    eLpNorm (canonicalReflectedUnitFiniteEnvelope c r w.S delta N f M) 2 volume =
        eLpNorm (∑ j ∈ Finset.range M, fun y =>
          ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
            canonicalReflectedUnitScaleEnvelope w.S delta N f j y) 2 volume := by
          apply congrArg (fun h => eLpNorm h 2 volume)
          funext y
          simp only [canonicalReflectedUnitFiniteEnvelope, Finset.sum_apply]
    _ ≤ ∑ j ∈ Finset.range M,
        eLpNorm (fun y =>
          ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
            canonicalReflectedUnitScaleEnvelope w.S delta N f j y) 2 volume := by
          apply eLpNorm_sum_le
          · intro j hj
            exact (measurable_const.mul (w.hScaleMeas delta N f j hf)).aestronglyMeasurable
          · norm_num
    _ ≤ ∑ j ∈ Finset.range M,
        ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j * cost j) *
          eLpNorm f 2 volume := by
          apply Finset.sum_le_sum
          intro j hj
          exact hbound j hj
    _ = (∑ j ∈ Finset.range M,
        ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j * cost j)) *
          eLpNorm f 2 volume := by
          rw [Finset.sum_mul]
    _ = ENNReal.ofReal (∑ j ∈ Finset.range M,
        canonicalBandlimitedDyadicCoefficient N c r j * cost j) *
          eLpNorm f 2 volume := by
          congr 1
          symm
          apply ENNReal.ofReal_sum_of_nonneg
          intro j hj
          exact mul_nonneg (hcoeff j) (hcost j hj)

/-- A narrow estimate at all narrow widths plus a broad signed-envelope
estimate gives the exact finite-envelope hypothesis needed by the literal
thresholded closure. -/
theorem hasCanonicalDyadicUnitNarrowBroadFiniteEnvelopeL2EstimateGT_of_scaleCosts
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (w : CanonicalReflectedScalePositiveUnitWiringGT c r)
    (hnarrow : HasCanonicalDyadicUnitNarrowScaleCostGT w)
    (hbroad : HasCanonicalDyadicUnitBroadScaleCostGT w) :
    HasCanonicalDyadicUnitNarrowBroadFiniteEnvelopeL2EstimateGT w := by
  intro N hN
  obtain ⟨A, hA, hnarrowN⟩ := hnarrow N hN
  obtain ⟨B, hB, hbroadN⟩ := hbroad N hN
  refine ⟨A, B, hA, hB, ?_⟩
  intro delta hdelta hdeltaSmall
  obtain ⟨k0, hk0width, hk0narrow, hbroadScale⟩ :=
    hbroadN delta hdelta hdeltaSmall
  let L : Real := (1 + |Real.log delta|) ^ (3 / 2 : Real)
  have hLnonneg : 0 ≤ L := by
    dsimp only [L]
    exact Real.rpow_nonneg (by positivity) _
  let cost : Nat → Real := fun j => if j < k0 then A * L else B
  refine ⟨k0, cost, ?_, ?_, ?_⟩
  · intro j hj
    dsimp only [cost]
    rw [if_pos hj]
  · intro j hj
    dsimp only [cost]
    rw [if_neg (not_lt.mpr hj)]
  · intro f hf M
    apply eLpNorm_canonicalReflectedUnitFiniteEnvelope_le_of_weightedScaleBounds_gt
      hc hr w delta N f hf M cost
    · intro j hj
      dsimp only [cost]
      split_ifs with hsmall
      · exact mul_nonneg hA.le hLnonneg
      · exact hB
    · intro j hj
      dsimp only [cost]
      split_ifs with hsmall
      · have hjwidth : delta / canonicalBandlimitedDyadicScale r j < 1 / 2 := by
          exact hk0narrow j hsmall
        simpa only [L] using hnarrowN delta hdelta hdeltaSmall j hjwidth f hf
      · exact hbroadScale f hf j (not_lt.mp hsmall)

/-- The only analytic input remaining for the literal concrete wiring is the
narrow per-scale signed-envelope estimate.  The broad contribution, all
measurability, and the reflected positive-square bridge are concrete. -/
theorem hasCanonicalDyadicUnitNarrowBroadFiniteEnvelopeL2EstimateGT_concrete_of_narrow
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (hcore : ∀ u : gtNarrowBroadAdapterE2, ‖u‖ ≤ r → c ≤ (canonicalPositiveCore u).re)
    (hnarrow : HasCanonicalDyadicUnitNarrowScaleCostGT
      (canonicalTubeSignedScaleConcreteUnitWiringGT hc hr hcore)) :
    HasCanonicalDyadicUnitNarrowBroadFiniteEnvelopeL2EstimateGT
      (canonicalTubeSignedScaleConcreteUnitWiringGT hc hr hcore) :=
  hasCanonicalDyadicUnitNarrowBroadFiniteEnvelopeL2EstimateGT_of_scaleCosts
    hc hr (canonicalTubeSignedScaleConcreteUnitWiringGT hc hr hcore) hnarrow
    (hasCanonicalDyadicUnitBroadScaleCostGT_concrete hc hr hcore)

/-- Literal light-ray maximal estimate from the sole remaining narrow
per-scale signed-envelope estimate. -/
theorem hasLightRayMaximalEstimate_of_concreteNarrowScaleCost
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (hcore : ∀ u : gtNarrowBroadAdapterE2, ‖u‖ ≤ r → c ≤ (canonicalPositiveCore u).re)
    (hnarrow : HasCanonicalDyadicUnitNarrowScaleCostGT
      (canonicalTubeSignedScaleConcreteUnitWiringGT hc hr hcore)) :
    HasLightRayMaximalEstimate :=
  hasLightRayMaximalEstimate_of_thresholdedUnitNarrowBroadFiniteEnvelope hc hr
    (canonicalTubeSignedScaleConcreteUnitWiringGT hc hr hcore)
    (hasCanonicalDyadicUnitNarrowBroadFiniteEnvelopeL2EstimateGT_concrete_of_narrow
      hc hr hcore hnarrow)

end

