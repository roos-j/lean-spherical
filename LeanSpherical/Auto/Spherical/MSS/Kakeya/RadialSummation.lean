          ((∑ _jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
              (radialBandAngularLevel i), ENNReal.ofReal (4 * B)) *
            (4 * ENNReal.ofReal (∫ xi : Euclidean 2,
              shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles L q i) a xi ∂
                (volume.restrict (scaledDyadicFrequencyAnnulus
                  (kakeyaRadialBandScale i)))))) := by
  rcases exists_kakeyaRadialBandPhysicalField_uniform_narrow_bound
      L s q hqcompact a i hi hrTime hsupport with ⟨B, hB, hraw⟩
  refine ⟨B, hB, ?_⟩
  exact le_shiftedCappedShell_scaleCost_of_raw_bound
    (kakeyaRadialBandScale_pos i) (radialBandAngularLevel i) (fun _ => B)
    (by
      intro jni hjni
      exact hB.le)
    s (finiteTensorRadialBandProfiles L q i) a _ (by
      simpa only using hraw)

/-- The genuinely uniform high-radial-band estimate.  Its cost is selected
before the finite tensor, radial carrier, and radial index, so it can be
summed over a Littlewood--Paley block without a quantifier leak. -/
theorem exists_global_kakeyaRadialBandPhysicalField_uniform_narrow_scaleCost_bound :
    ∃ B : Real, 0 < B ∧
      ∀ {iota : Type*} (L : lpCutoffs 2) (s : Finset iota)
        (q : iota -> SchwartzMap (Euclidean 2) Complex)
        (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
        (a : iota -> SchwartzMap Real Complex) (i : Nat), 3 ≤ i →
        ∀ {rTime : Real}, rTime < 1 →
          (∀ l, Function.support (a l : Real -> Complex) ⊆
            closedBall (3 / 2 : Real) rTime) →
          (∫⁻ y : Euclidean 2, ⨆ theta : Real,
            ENNReal.ofReal
              (‖kakeyaRadialBandPhysicalField L
                (fun theta => scratch_finiteTensorTubeMultiplier s q hqcompact a
                  (circleDirection theta))
                i theta y‖ ^ 2)) ≤
            ((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
              (radialBandAngularLevel i)).card : ENNReal) *
              ((∑ _jni ∈ shiftedCappedShellIndicesGeneric
                  (Finset.univ : Finset (Fin 4)) (radialBandAngularLevel i),
                ENNReal.ofReal (4 * B)) *
                (4 * ENNReal.ofReal (∫ xi : Euclidean 2,
                  shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles L q i) a xi ∂
                    (volume.restrict (scaledDyadicFrequencyAnnulus
                      (kakeyaRadialBandScale i)))))) := by
  rcases exists_uniform_allShiftCapped_shell_physical_hpiece_bound
      radialBandOuterRhoMax_nonneg radialBandOuterRhoMax_small with ⟨B, hB, hpiece⟩
  refine ⟨B, hB, ?_⟩
  intro iota L s q hqcompact a i hi rTime hrTime hsupport
  let lambda : Real := kakeyaRadialBandScale i
  let eps : Real := centeredCriticalWidth lambda
  let K : Nat := kakeyaCappedShellLevel lambda
  let ratio : Real := ((2 : Real) ^ K * eps) / (Real.pi / 2)
  let rTerminal : Real := (4 / 5 : Real) * (Real.pi / 2)
  have hlambda16 : 16 ≤ lambda := by
    simpa only [lambda] using uniform_radialBandScale_ge_sixteen i hi
  have hlambdaPos : 0 < lambda := by linarith
  have hlambdaOne : 1 ≤ lambda := by linarith
  have heps : 0 < eps := by
    dsimp only [eps]
    exact centeredCriticalWidth_pos hlambdaPos
  have hscale : (2 : Real) ^ K * eps ≤ Real.pi / 2 := by
    simpa only [K, eps, lambda, kakeyaAngularRadiusCap] using
      (kakeyaCappedShellLevel_radius_bounds hlambdaOne).1
  have hcentralMem : 4 * eps ∈ Icc (0 : Real) radialBandOuterRhoMax := by
    simpa only [eps, lambda] using uniform_radialBand_central_mem hlambda16
  have hcentralCritical : ∀ xi,
      xi ∈ scaledDyadicFrequencyAnnulus lambda →
      1 ≤ ‖xi‖ * (4 * eps) ^ 2 ∧ ‖xi‖ * (4 * eps) ^ 2 ≤ 32 := by
    intro xi hxi
    simpa only [eps] using uniform_radialBand_central_critical hlambda16 xi hxi
  have hdyadicMem : ∀ k, k < K →
      (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps) ∈
        Ioc (0 : Real) radialBandOuterRhoMax := by
    intro k hk
    simpa only [K, eps, lambda] using uniform_radialBand_dyadic_mem hlambda16 k hk
  have hdyadicOuter : ∀ k, k < K → ∀ xi,
      xi ∈ scaledDyadicFrequencyAnnulus lambda →
      1 ≤ ‖xi‖ * ((4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps)) ^ 2 := by
    intro k hk xi hxi
    simpa only [eps] using uniform_radialBand_dyadic_outer hlambda16 k xi hxi
  have hratio : ratio ∈ Icc (1 / 2 : Real) 1 := by
    change 1 / 2 ≤ ratio ∧ ratio ≤ 1
    simpa only [ratio, K, eps, lambda, kakeyaAngularRadiusCap] using
      kakeyaCappedShellLevel_ratio_bounds hlambdaOne
  have hratioDef : ratio = ((2 : Real) ^ K * eps) / (Real.pi / 2) := rfl
  have hrTerminal : rTerminal = (4 / 5 : Real) * (Real.pi / 2) := rfl
  have hrTerminalMem : rTerminal ∈ Ioc (0 : Real) radialBandOuterRhoMax := by
    simpa only [rTerminal] using uniform_radialBand_terminal_mem
  have hterminalOuter : ∀ xi,
      xi ∈ scaledDyadicFrequencyAnnulus lambda →
      1 ≤ ‖xi‖ * rTerminal ^ 2 := by
    intro xi hxi
    simpa only [rTerminal] using uniform_radialBand_terminal_outer hlambda16 xi hxi
  let C := scaledDyadicFourChartFamily lambda hlambdaPos
  let qBand := finiteTensorRadialBandProfiles L q i
  have hqBandCompact : ∀ l, HasCompactSupport (qBand l : Euclidean 2 -> Complex) := by
    exact finiteTensorRadialBandProfiles_compact L q hqcompact i
  have hqBandActive : ∀ l, SupportedOnActive C (qBand l) := by
    intro l xi hxi
    change kakeyaRadialBandPiece L (q l) i xi ≠ 0 at hxi
    exact kakeyaRadialBandPiece_supportedOn_scaledDyadicFrequencyAnnulus L (q l) i xi hxi
  have hqBandAnn : ∀ l, Function.support (qBand l : Euclidean 2 -> Complex) ⊆
      scaledDyadicFrequencyAnnulus lambda := by
    intro l xi hxi
    change kakeyaRadialBandPiece L (q l) i xi ≠ 0 at hxi
    exact kakeyaRadialBandPiece_supportedOn_scaledDyadicFrequencyAnnulus L (q l) i xi hxi
  have hraw :
      (∫⁻ y : Euclidean 2, ⨆ theta : Real,
        ENNReal.ofReal (‖finiteTensorCircleMultiplierField s qBand hqBandCompact a theta y‖ ^ 2)) ≤
        ((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K).card : ENNReal) *
          ∑ jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K,
            ENNReal.ofReal (4 * B * ∫ xi : Euclidean 2,
              shiftedFiberSourceEnergy s (chartProfiles C jni.1 qBand) a xi ∂
                (volume.restrict (scaledDyadicFrequencyAnnulus lambda))) := by
    apply lintegral_iSup_sq_finiteTensorCircleMultiplierField_le_shiftedCapped_uniform
      C s qBand hqBandCompact hqBandActive a eps K
    · exact fun j xi => scaledChartAngle_lt_six lambda j xi
    · intro jni hjni
      rcases jni with ⟨j, n, k⟩
      have hjni0 : (j, (n, k)) ∈ (Finset.univ : Finset (Fin 4)).product
          ((Finset.range 7).product (Finset.range (K + 2))) := by
        simpa only [shiftedCappedShellIndicesGeneric] using hjni
      rcases Finset.mem_product.mp hjni0 with ⟨hj, hnk⟩
      rcases Finset.mem_product.mp hnk with ⟨hn, hk⟩
      have hpiece' := hpiece C s qBand hqBandCompact a K heps hlambdaPos hscale hqBandAnn
        hcentralMem hcentralCritical hdyadicMem hdyadicOuter hratio hratioDef hrTerminal
        hrTerminalMem hterminalOuter hrTime hsupport j hj n hn k hk
      simpa only [shiftedCappedShellPieceGeneric] using hpiece'
  let F : Real → Euclidean 2 → Complex := fun theta y =>
    finiteTensorCircleMultiplierField s qBand hqBandCompact a theta y
  let G : Real → Euclidean 2 → Complex := fun theta y =>
    kakeyaRadialBandPhysicalField L
      (fun theta => scratch_finiteTensorTubeMultiplier s q hqcompact a
        (circleDirection theta))
      i theta y
  have hFG : F = G := by
    funext theta y
    dsimp only [F, G, qBand]
    exact finiteTensorCircleMultiplierField_radialBand_eq L s q hqcompact a i theta y
  change (∫⁻ y : Euclidean 2, ⨆ theta : Real,
      ENNReal.ofReal (‖F theta y‖ ^ 2)) ≤ _ at hraw
  rw [hFG] at hraw
  exact le_shiftedCappedShell_scaleCost_of_raw_bound
    hlambdaPos K (fun _ => B)
    (by
      intro jni hjni
      exact hB.le)
    s qBand a _ (by
      simpa [C, G, K, lambda, qBand, radialBandAngularLevel] using hraw)

end

end Auto.Spherical.MSS
end
-- END ScratchKakeyaUniformRadialBandNarrow

