section Auto.Spherical.MSS

open Filter MeasureTheory FourierTransform Set
open Auto.Spherical.SurfaceMeasureDecay
open Auto.LittlewoodPaley
open scoped BigOperators Convolution FourierTransform ENNReal EuclideanSpace Pointwise

noncomputable section

/-- The `3/2` radial-count loss in the nonuniform physical reassembly is
bounded by the expected logarithmic factor.  This is the purely elementary
bridge from `kakeyaRadialBandLevel` to the final narrow exponent. -/
theorem exists_kakeyaRadialPhysicalPieceCount_rpow_three_halves_log_bound :
    ∃ A : Real, 0 < A ∧ ∀ rho : Real, 0 < rho → rho ≤ 1 →
      (((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) ^
        ((3 : Real) / 2)) ≤
        ENNReal.ofReal
          (A * (1 + |Real.log rho|) ^ ((3 : Real) / 2)) := by
  rcases exists_kakeyaRadialPhysicalPieces_card_log_bound with ⟨B, hB, hcount⟩
  refine ⟨B ^ ((3 : Real) / 2), Real.rpow_pos_of_pos hB _, ?_⟩
  intro rho hrho hrhoOne
  have hR : 0 ≤ 1 + |Real.log rho| := by positivity
  have hcard : ((kakeyaRadialBandLevel rho + 1 : Nat) : Real) ≤
      B * (1 + |Real.log rho|) := by
    simpa only [Finset.card_range] using hcount rho hrho hrhoOne
  have hcardENN : ((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) ≤
      ENNReal.ofReal (B * (1 + |Real.log rho|)) := by
    rw [← ENNReal.ofReal_natCast]
    exact ENNReal.ofReal_le_ofReal hcard
  have hpow := ENNReal.rpow_le_rpow hcardENN
    (by norm_num : 0 ≤ (3 : Real) / 2)
  have hrecast :
      (ENNReal.ofReal (B * (1 + |Real.log rho|))) ^ ((3 : Real) / 2) =
        ENNReal.ofReal
          (B ^ ((3 : Real) / 2) *
            (1 + |Real.log rho|) ^ ((3 : Real) / 2)) := by
    calc
      (ENNReal.ofReal (B * (1 + |Real.log rho|))) ^ ((3 : Real) / 2) =
          (ENNReal.ofReal B * ENNReal.ofReal (1 + |Real.log rho|)) ^
            ((3 : Real) / 2) := by
              rw [ENNReal.ofReal_mul hB.le]
      _ = ENNReal.ofReal (B ^ ((3 : Real) / 2)) *
          ENNReal.ofReal ((1 + |Real.log rho|) ^ ((3 : Real) / 2)) := by
            rw [ENNReal.mul_rpow_of_nonneg _ _
              (by norm_num : 0 ≤ (3 : Real) / 2)]
            rw [ENNReal.ofReal_rpow_of_nonneg hB.le
              (by norm_num : 0 ≤ (3 : Real) / 2)]
            rw [ENNReal.ofReal_rpow_of_nonneg hR
              (by norm_num : 0 ≤ (3 : Real) / 2)]
      _ = ENNReal.ofReal
          (B ^ ((3 : Real) / 2) *
            (1 + |Real.log rho|) ^ ((3 : Real) / 2)) := by
            exact (ENNReal.ofReal_mul
              (p := B ^ ((3 : Real) / 2))
              (q := (1 + |Real.log rho|) ^ ((3 : Real) / 2))
              (Real.rpow_nonneg hB.le _)).symm
  simpa only [hrecast] using hpow

/-- The finite radial narrow reassembly in its useful source-normalized
form.  All band analysis, chart reassembly, and Littlewood--Paley overlap
are concentrated in the one supplied summed-energy premise; the conclusion
is the literal physical radial maximal `L²` estimate. -/
theorem eLpNorm_kakeyaRadialPhysicalEnvelope_le_of_log_piece_count_and_summed_energy
    (A : Real)
    (hlog : ∀ rho : Real, 0 < rho → rho ≤ 1 →
      (((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) ^
        ((3 : Real) / 2)) ≤
        ENNReal.ofReal
          (A * (1 + |Real.log rho|) ^ ((3 : Real) / 2)))
    {Theta : Type*} (C : lpCutoffs 2)
    (m : Theta → SchwartzMap (Euclidean 2) Complex)
    {rho : Real} (hrho : 0 < rho) (hrhoOne : rho ≤ 1)
    (hsupp : ∀ theta, Set.Subset (Function.support (m theta :
      Euclidean 2 → Complex)) (Metric.closedBall 0 (4 / rho)))
    (B0 : ENNReal) (Bband : Nat → ENNReal) (F : ENNReal)
    (hlowMeas : Measurable (fun x : Euclidean 2 =>
      ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialLowpassPhysicalField C m theta x‖ ^ 2)))
    (hbandMeas : ∀ i ∈ Finset.range (kakeyaRadialBandLevel rho),
      Measurable (fun x : Euclidean 2 =>
        ⨆ theta : Theta, ENNReal.ofReal
          (‖kakeyaRadialBandPhysicalField C m i theta x‖ ^ 2)))
    (hlowBound :
      (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialLowpassPhysicalField C m theta x‖ ^ 2)) ≤ B0)
    (hbandBound : ∀ i ∈ Finset.range (kakeyaRadialBandLevel rho),
      (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialBandPhysicalField C m i theta x‖ ^ 2)) ≤ Bband i)
    (hsummed : B0 + ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho), Bband i ≤
      ((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) ^ 2 * F ^ 2) :
    eLpNorm (kakeyaRadialPhysicalEnvelope m) 2 volume ≤
      ENNReal.ofReal
        (A * (1 + |Real.log rho|) ^ ((3 : Real) / 2)) * F := by
  have hradial := eLpNorm_kakeyaRadialPhysicalEnvelope_le_of_summed_energy
    C m hrho hsupp B0 Bband (F ^ 2) hlowMeas hbandMeas hlowBound hbandBound
    (by simpa only [pow_two] using hsummed)
  let L : ENNReal := ((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal)
  have hrootF : (F ^ 2) ^ ((2 : Real)⁻¹) = F := by
    rw [← ENNReal.rpow_natCast F 2]
    rw [← ENNReal.rpow_mul]
    norm_num
  calc
    eLpNorm (kakeyaRadialPhysicalEnvelope m) 2 volume ≤
        (L ^ 3 * F ^ 2) ^ ((2 : Real)⁻¹) := by
          simpa only [L, pow_two] using hradial
    _ = L ^ ((3 : Real) / 2) * (F ^ 2) ^ ((2 : Real)⁻¹) :=
      rpow_half_cube_mul L (F ^ 2)
    _ = L ^ ((3 : Real) / 2) * F := by rw [hrootF]
    _ ≤ ENNReal.ofReal
          (A * (1 + |Real.log rho|) ^ ((3 : Real) / 2)) * F := by
      exact mul_le_mul_left (hlog rho hrho hrhoOne) F

/-- The same radial reassembly with an arbitrary summed square-energy.
This is the most direct interface for the annular proof: after it proves a
single Littlewood--Paley statement `sum Bᵢ ≤ L² E`, no further information
about the individual radial pieces is used. -/
theorem eLpNorm_kakeyaRadialPhysicalEnvelope_le_of_log_piece_count_and_energy
    (A : Real)
    (hlog : ∀ rho : Real, 0 < rho → rho ≤ 1 →
      (((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) ^
        ((3 : Real) / 2)) ≤
        ENNReal.ofReal
          (A * (1 + |Real.log rho|) ^ ((3 : Real) / 2)))
    {Theta : Type*} (C : lpCutoffs 2)
    (m : Theta → SchwartzMap (Euclidean 2) Complex)
    {rho : Real} (hrho : 0 < rho) (hrhoOne : rho ≤ 1)
    (hsupp : ∀ theta, Set.Subset (Function.support (m theta :
      Euclidean 2 → Complex)) (Metric.closedBall 0 (4 / rho)))
    (B0 : ENNReal) (Bband : Nat → ENNReal) (E : ENNReal)
    (hlowMeas : Measurable (fun x : Euclidean 2 =>
      ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialLowpassPhysicalField C m theta x‖ ^ 2)))
    (hbandMeas : ∀ i ∈ Finset.range (kakeyaRadialBandLevel rho),
      Measurable (fun x : Euclidean 2 =>
        ⨆ theta : Theta, ENNReal.ofReal
          (‖kakeyaRadialBandPhysicalField C m i theta x‖ ^ 2)))
    (hlowBound :
      (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialLowpassPhysicalField C m theta x‖ ^ 2)) ≤ B0)
    (hbandBound : ∀ i ∈ Finset.range (kakeyaRadialBandLevel rho),
      (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialBandPhysicalField C m i theta x‖ ^ 2)) ≤ Bband i)
    (hsummed : B0 + ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho), Bband i ≤
      ((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) ^ 2 * E) :
    eLpNorm (kakeyaRadialPhysicalEnvelope m) 2 volume ≤
      ENNReal.ofReal
        (A * (1 + |Real.log rho|) ^ ((3 : Real) / 2)) * E ^ ((2 : Real)⁻¹) := by
  have hradial := eLpNorm_kakeyaRadialPhysicalEnvelope_le_of_summed_energy
    C m hrho hsupp B0 Bband E hlowMeas hbandMeas hlowBound hbandBound hsummed
  let L : ENNReal := ((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal)
  calc
    eLpNorm (kakeyaRadialPhysicalEnvelope m) 2 volume ≤
        (L ^ 3 * E) ^ ((2 : Real)⁻¹) := by
          simpa only [L] using hradial
    _ = L ^ ((3 : Real) / 2) * E ^ ((2 : Real)⁻¹) :=
      rpow_half_cube_mul L E
    _ ≤ ENNReal.ofReal
          (A * (1 + |Real.log rho|) ^ ((3 : Real) / 2)) * E ^ ((2 : Real)⁻¹) := by
      exact mul_le_mul_left (hlog rho hrho hrhoOne) _

/-- A one-scale form of the narrow radial estimate.  The returned positive
constant is in fact the universal radial-count constant below. -/
theorem eLpNorm_kakeyaRadialPhysicalEnvelope_le_log_three_halves_of_summed_energy
    {Theta : Type*} (C : lpCutoffs 2)
    (m : Theta → SchwartzMap (Euclidean 2) Complex)
    {rho : Real} (hrho : 0 < rho) (hrhoOne : rho ≤ 1)
    (hsupp : ∀ theta, Set.Subset (Function.support (m theta :
      Euclidean 2 → Complex)) (Metric.closedBall 0 (4 / rho)))
    (B0 : ENNReal) (Bband : Nat → ENNReal) (F : ENNReal)
    (hlowMeas : Measurable (fun x : Euclidean 2 =>
      ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialLowpassPhysicalField C m theta x‖ ^ 2)))
    (hbandMeas : ∀ i ∈ Finset.range (kakeyaRadialBandLevel rho),
      Measurable (fun x : Euclidean 2 =>
        ⨆ theta : Theta, ENNReal.ofReal
          (‖kakeyaRadialBandPhysicalField C m i theta x‖ ^ 2)))
    (hlowBound :
      (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialLowpassPhysicalField C m theta x‖ ^ 2)) ≤ B0)
    (hbandBound : ∀ i ∈ Finset.range (kakeyaRadialBandLevel rho),
      (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialBandPhysicalField C m i theta x‖ ^ 2)) ≤ Bband i)
    (hsummed : B0 + ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho), Bband i ≤
      ((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) ^ 2 * F ^ 2) :
    ∃ A : Real, 0 < A ∧
      eLpNorm (kakeyaRadialPhysicalEnvelope m) 2 volume ≤
        ENNReal.ofReal
          (A * (1 + |Real.log rho|) ^ ((3 : Real) / 2)) * F := by
  rcases exists_kakeyaRadialPhysicalPieceCount_rpow_three_halves_log_bound with
    ⟨A, hA, hlog⟩
  exact ⟨A, hA,
    eLpNorm_kakeyaRadialPhysicalEnvelope_le_of_log_piece_count_and_summed_energy
      A hlog C m hrho hrhoOne hsupp B0 Bband F hlowMeas hbandMeas hlowBound
      hbandBound hsummed⟩

end

end Auto.Spherical.MSS
