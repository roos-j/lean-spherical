noncomputable section

private theorem uniform_radialBandScale_ge_sixteen (i : Nat) (hi : 3 <= i) :
    16 <= kakeyaRadialBandScale i := by
  unfold kakeyaRadialBandScale
  have hpow : (2 : Real) ^ 4 <= (2 : Real) ^ (i + 1) :=
    pow_le_pow_right₀ (by norm_num) (by omega)
  norm_num at hpow ⊢
  exact hpow

private theorem uniform_centeredCriticalWidth_le_quarter
    {lambda : Real} (hlambda : 16 <= lambda) :
    centeredCriticalWidth lambda <= 1 / 4 := by
  have hlambdaPos : 0 < lambda := by linarith
  have hepsPos : 0 < centeredCriticalWidth lambda :=
    centeredCriticalWidth_pos hlambdaPos
  have hepsSq : lambda * centeredCriticalWidth lambda ^ 2 = 1 :=
    centeredCriticalWidth_sq hlambdaPos
  nlinarith [sq_nonneg (centeredCriticalWidth lambda - (1 / 4 : Real))]

private theorem uniform_radialBand_central_mem
    {lambda : Real} (hlambda : 16 <= lambda) :
    4 * centeredCriticalWidth lambda ∈ Icc (0 : Real) radialBandOuterRhoMax := by
  have hepsPos : 0 < centeredCriticalWidth lambda :=
    centeredCriticalWidth_pos (by linarith)
  constructor
  · positivity
  · calc
      4 * centeredCriticalWidth lambda <= 4 * (1 / 4 : Real) :=
        mul_le_mul_of_nonneg_left
          (uniform_centeredCriticalWidth_le_quarter hlambda) (by norm_num)
      _ = 1 := by norm_num
      _ <= radialBandOuterRhoMax := one_le_radialBandOuterRhoMax

private theorem uniform_radialBand_central_critical
    {lambda : Real} (hlambda : 16 <= lambda) (xi : Euclidean 2)
    (hxi : xi ∈ scaledDyadicFrequencyAnnulus lambda) :
    1 <= ‖xi‖ * (4 * centeredCriticalWidth lambda) ^ 2 ∧
      ‖xi‖ * (4 * centeredCriticalWidth lambda) ^ 2 <= 32 := by
  have hlambdaPos : 0 < lambda := by linarith
  have hepsSq : lambda * centeredCriticalWidth lambda ^ 2 = 1 :=
    centeredCriticalWidth_sq hlambdaPos
  have hepsSqNonneg : 0 <= centeredCriticalWidth lambda ^ 2 := sq_nonneg _
  have hlo := mul_le_mul_of_nonneg_right hxi.1 hepsSqNonneg
  have hhi := mul_le_mul_of_nonneg_right hxi.2 hepsSqNonneg
  constructor
  · calc
      1 = lambda * centeredCriticalWidth lambda ^ 2 := hepsSq.symm
      _ <= ‖xi‖ * (4 * centeredCriticalWidth lambda) ^ 2 := by nlinarith
  · calc
      ‖xi‖ * (4 * centeredCriticalWidth lambda) ^ 2 <=
          32 * (lambda * centeredCriticalWidth lambda ^ 2) := by nlinarith
      _ = 32 := by rw [hepsSq]; ring

private theorem uniform_radialBand_dyadic_mem
    {lambda : Real} (hlambda : 16 <= lambda) (k : Nat)
    (hk : k < kakeyaCappedShellLevel lambda) :
    (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * centeredCriticalWidth lambda) ∈
      Ioc (0 : Real) radialBandOuterRhoMax := by
  have hlambdaPos : 0 < lambda := by linarith
  have hepsPos : 0 < centeredCriticalWidth lambda :=
    centeredCriticalWidth_pos hlambdaPos
  have hK := (kakeyaCappedShellLevel_radius_bounds (by linarith : 1 <= lambda)).1
  have hpow : (2 : Real) ^ (k + 1) <= (2 : Real) ^ (kakeyaCappedShellLevel lambda) :=
    pow_le_pow_right₀ (by norm_num) (by omega)
  have hscale : (2 : Real) ^ (k + 1) * centeredCriticalWidth lambda <=
      (2 : Real) ^ (kakeyaCappedShellLevel lambda) * centeredCriticalWidth lambda :=
    mul_le_mul_of_nonneg_right hpow hepsPos.le
  constructor
  · positivity
  · unfold kakeyaAngularRadiusCap at hK
    unfold radialBandOuterRhoMax
    nlinarith

private theorem uniform_radialBand_dyadic_outer
    {lambda : Real} (hlambda : 16 <= lambda) (k : Nat)
    (xi : Euclidean 2) (hxi : xi ∈ scaledDyadicFrequencyAnnulus lambda) :
    1 <= ‖xi‖ *
      ((4 / 5 : Real) * ((2 : Real) ^ (k + 1) * centeredCriticalWidth lambda)) ^ 2 := by
  have hlambdaPos : 0 < lambda := by linarith
  have hepsSq : lambda * centeredCriticalWidth lambda ^ 2 = 1 :=
    centeredCriticalWidth_sq hlambdaPos
  let u : Real := (2 : Real) ^ (k + 1)
  have hu : 2 <= u := by
    dsimp only [u]
    have hpow : (2 : Real) ^ 1 <= (2 : Real) ^ (k + 1) :=
      pow_le_pow_right₀ (by norm_num) (by omega)
    norm_num at hpow ⊢
    exact hpow
  have huSq : 4 <= u ^ 2 := by nlinarith [sq_nonneg (u - 2)]
  have hcarrier : 1 <= (lambda / 2) *
      ((4 / 5 : Real) * (u * centeredCriticalWidth lambda)) ^ 2 := by
    have hrewrite : (lambda / 2) *
        ((4 / 5 : Real) * (u * centeredCriticalWidth lambda)) ^ 2 =
        (8 / 25 : Real) * u ^ 2 * (lambda * centeredCriticalWidth lambda ^ 2) := by
      ring
    rw [hrewrite, hepsSq]
    nlinarith
  have hmul := mul_le_mul_of_nonneg_right hxi.1
    (sq_nonneg ((4 / 5 : Real) * (u * centeredCriticalWidth lambda)))
  calc
    1 <= (lambda / 2) *
        ((4 / 5 : Real) * (u * centeredCriticalWidth lambda)) ^ 2 := hcarrier
    _ <= ‖xi‖ * ((4 / 5 : Real) *
        (u * centeredCriticalWidth lambda)) ^ 2 := hmul

private theorem uniform_radialBand_terminal_mem :
    (4 / 5 : Real) * (Real.pi / 2) ∈ Ioc (0 : Real) radialBandOuterRhoMax := by
  unfold radialBandOuterRhoMax
  constructor
  · positivity
  · ring_nf
    exact le_rfl

private theorem uniform_radialBand_terminal_outer
    {lambda : Real} (hlambda : 16 <= lambda) (xi : Euclidean 2)
    (hxi : xi ∈ scaledDyadicFrequencyAnnulus lambda) :
    1 <= ‖xi‖ * ((4 / 5 : Real) * (Real.pi / 2)) ^ 2 := by
  have hhalf : 8 <= lambda / 2 := by linarith
  have hrho : 1 <= (2 * Real.pi / 5) := by
    nlinarith [Real.pi_gt_three]
  have hrhoSq : 1 <= (2 * Real.pi / 5) ^ 2 := by
    nlinarith [sq_nonneg (2 * Real.pi / 5 - 1)]
  have hcarrier : 1 <= (lambda / 2) * ((4 / 5 : Real) * (Real.pi / 2)) ^ 2 := by
    have hrewrite : (4 / 5 : Real) * (Real.pi / 2) = 2 * Real.pi / 5 := by ring
    rw [hrewrite]
    calc
      1 <= 8 * 1 := by norm_num
      _ <= (lambda / 2) * (2 * Real.pi / 5) ^ 2 := by
        exact mul_le_mul hhalf hrhoSq (by norm_num) (by linarith)
  have hmul := mul_le_mul_of_nonneg_right hxi.1
    (sq_nonneg ((4 / 5 : Real) * (Real.pi / 2)))
  calc
    1 <= (lambda / 2) * ((4 / 5 : Real) * (Real.pi / 2)) ^ 2 := hcarrier
    _ <= ‖xi‖ * ((4 / 5 : Real) * (Real.pi / 2)) ^ 2 := hmul

/-- Uniform-cost narrow bound for one literal radial annulus.  Unlike the
earlier existential-cost theorem, `B` is independent of the radial level and
all finite tensor data. -/
theorem exists_kakeyaRadialBandPhysicalField_uniform_narrow_bound
    {iota : Type*} (L : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex) (i : Nat) (hi : 3 <= i)
    {rTime : Real} (hrTime : rTime < 1)
    (hsupport : ∀ l, Function.support (a l : Real -> Complex) ⊆
      closedBall (3 / 2 : Real) rTime) :
    ∃ B : Real, 0 < B ∧
      (∫⁻ y : Euclidean 2, ⨆ theta : Real,
        ENNReal.ofReal
          (‖kakeyaRadialBandPhysicalField L
            (fun theta => scratch_finiteTensorTubeMultiplier s q hqcompact a
              (circleDirection theta))
            i theta y‖ ^ 2)) <=
        ((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
          (radialBandAngularLevel i)).card : ENNReal) *
          ∑ jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
              (radialBandAngularLevel i),
            ENNReal.ofReal (4 * B * ∫ xi : Euclidean 2,
              shiftedFiberSourceEnergy s
                (chartProfiles (scaledDyadicFourChartFamily (kakeyaRadialBandScale i)
                  (kakeyaRadialBandScale_pos i)) jni.1
                  (finiteTensorRadialBandProfiles L q i)) a xi ∂
                (volume.restrict (scaledDyadicFrequencyAnnulus
                  (kakeyaRadialBandScale i)))) := by
  let lambda : Real := kakeyaRadialBandScale i
  let eps : Real := centeredCriticalWidth lambda
  let K : Nat := kakeyaCappedShellLevel lambda
  let ratio : Real := ((2 : Real) ^ K * eps) / (Real.pi / 2)
  let rTerminal : Real := (4 / 5 : Real) * (Real.pi / 2)
  have hlambda16 : 16 <= lambda := by
    simpa only [lambda] using uniform_radialBandScale_ge_sixteen i hi
  have hlambdaPos : 0 < lambda := by linarith
  have hlambdaOne : 1 <= lambda := by linarith
  have heps : 0 < eps := by
    dsimp only [eps]
    exact centeredCriticalWidth_pos hlambdaPos
  have hscale : (2 : Real) ^ K * eps <= Real.pi / 2 := by
    simpa only [K, eps, lambda, kakeyaAngularRadiusCap] using
      (kakeyaCappedShellLevel_radius_bounds hlambdaOne).1
  have hcentralMem : 4 * eps ∈ Icc (0 : Real) radialBandOuterRhoMax := by
    simpa only [eps, lambda] using uniform_radialBand_central_mem hlambda16
  have hcentralCritical : ∀ xi,
      xi ∈ scaledDyadicFrequencyAnnulus lambda ->
      1 <= ‖xi‖ * (4 * eps) ^ 2 ∧ ‖xi‖ * (4 * eps) ^ 2 <= 32 := by
    intro xi hxi
    simpa only [eps] using uniform_radialBand_central_critical hlambda16 xi hxi
  have hdyadicMem : ∀ k, k < K ->
      (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps) ∈
        Ioc (0 : Real) radialBandOuterRhoMax := by
    intro k hk
    simpa only [K, eps, lambda] using uniform_radialBand_dyadic_mem hlambda16 k hk
  have hdyadicOuter : ∀ k, k < K -> ∀ xi,
      xi ∈ scaledDyadicFrequencyAnnulus lambda ->
      1 <= ‖xi‖ * ((4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps)) ^ 2 := by
    intro k hk xi hxi
    simpa only [eps] using uniform_radialBand_dyadic_outer hlambda16 k xi hxi
  have hratio : ratio ∈ Icc (1 / 2 : Real) 1 := by
    change 1 / 2 <= ratio ∧ ratio <= 1
    simpa only [ratio, K, eps, lambda, kakeyaAngularRadiusCap] using
      kakeyaCappedShellLevel_ratio_bounds hlambdaOne
  have hratioDef : ratio = ((2 : Real) ^ K * eps) / (Real.pi / 2) := rfl
  have hrTerminal : rTerminal = (4 / 5 : Real) * (Real.pi / 2) := rfl
  have hrTerminalMem : rTerminal ∈ Ioc (0 : Real) radialBandOuterRhoMax := by
    simpa only [rTerminal] using uniform_radialBand_terminal_mem
  have hterminalOuter : ∀ xi,
      xi ∈ scaledDyadicFrequencyAnnulus lambda ->
      1 <= ‖xi‖ * rTerminal ^ 2 := by
    intro xi hxi
    simpa only [rTerminal] using uniform_radialBand_terminal_outer hlambda16 xi hxi
  let C := scaledDyadicFourChartFamily lambda hlambdaPos
  let qBand := finiteTensorRadialBandProfiles L q i
  have hqBandCompact : ∀ l, HasCompactSupport (qBand l : Euclidean 2 -> Complex) := by
    exact finiteTensorRadialBandProfiles_compact L q hqcompact i
  have hqBandActive : ∀ l, SupportedOnActive C (qBand l) := by
    intro l xi hxi
    change kakeyaRadialBandPiece L (q l) i xi ≠ 0 at hxi
    exact kakeyaRadialBandPiece_supportedOn_scaledDyadicFrequencyAnnulus L (q l) i xi hxi
  have hqBandAnn : ∀ l, Function.support (qBand l : Euclidean 2 -> Complex) ⊆
      scaledDyadicFrequencyAnnulus lambda := by
    intro l xi hxi
    change kakeyaRadialBandPiece L (q l) i xi ≠ 0 at hxi
    exact kakeyaRadialBandPiece_supportedOn_scaledDyadicFrequencyAnnulus L (q l) i xi hxi
  rcases exists_uniform_allShiftCapped_annular_max_bound
      radialBandOuterRhoMax_nonneg radialBandOuterRhoMax_small
      C s qBand hqBandCompact hqBandActive a heps hlambdaPos K hscale hqBandAnn
      hcentralMem hcentralCritical hdyadicMem hdyadicOuter hratio hratioDef hrTerminal
      hrTerminalMem hterminalOuter hrTime hsupport
      (fun j xi => scaledChartAngle_lt_six lambda j xi) with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  let F : Real -> Euclidean 2 -> Complex := fun theta y =>
    finiteTensorCircleMultiplierField s qBand hqBandCompact a theta y
  let G : Real -> Euclidean 2 -> Complex := fun theta y =>
    kakeyaRadialBandPhysicalField L
      (fun theta => scratch_finiteTensorTubeMultiplier s q hqcompact a
        (circleDirection theta))
      i theta y
  have hFG : F = G := by
    funext theta y
    dsimp only [F, G, qBand]
    exact finiteTensorCircleMultiplierField_radialBand_eq L s q hqcompact a i theta y
  change (∫⁻ y : Euclidean 2, ⨆ theta : Real,
      ENNReal.ofReal (‖F theta y‖ ^ 2)) <= _ at hbound
  rw [hFG] at hbound
  simpa [C, G, K, lambda, qBand, radialBandAngularLevel] using hbound

/-- The same annular bound after exact scaled-sector energy contraction.  The
cost is now a single real `B`, independent of the radial level; the remaining
finite cardinal factors are retained explicitly for logarithmic accounting. -/
theorem exists_kakeyaRadialBandPhysicalField_uniform_narrow_scaleCost_bound
    {iota : Type*} (L : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
