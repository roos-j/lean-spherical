/-- The radial narrow estimate for compact post-canonical profiles implies
the exact weighted GT narrow-scale predicate for the literal signed scale. -/
theorem hasCanonicalDyadicUnitNarrowScaleCostGT_of_rawPostProfileRadial
    (C : lpCutoffs 2) (hraw : HasRawPostProfileRadialNarrow C)
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (hcore : ∀ u : narrowFromRadialE2, ‖u‖ ≤ r → c ≤ (canonicalPositiveCore u).re) :
    HasCanonicalDyadicUnitNarrowScaleCostGT
      (canonicalTubeSignedScaleConcreteUnitWiringGT hc hr hcore) := by
  rcases hraw with ⟨A, hA, hraw⟩
  let U : Real := canonicalTubeMultiplierUniformBound
  have hU : 0 ≤ U := by
    dsimp only [U, canonicalTubeMultiplierUniformBound]
    positivity
  let cWidth : Real := 2 / r
  have hcWidth : 0 < cWidth := by
    dsimp only [cWidth]
    positivity
  let W : Real := (1 + |Real.log cWidth|) ^ ((3 : Real) / 2)
  have hW : 0 < W := by
    dsimp only [W]
    apply Real.rpow_pos_of_pos
    positivity
  let Afinal : Real := A * (1 + U) * W
  have hAfinal : 0 < Afinal := by
    dsimp only [Afinal]
    exact mul_pos (mul_pos hA (by linarith)) hW
  intro N hN
  refine ⟨Afinal, hAfinal, ?_⟩
  intro delta hdelta hdeltaSmall j hj f hf
  rcases hf with ⟨ι, hι, q, a, timeRadius, htimePos, htimeLt, ha, rfl⟩
  letI : Fintype ι := hι
  let rho : Real := delta / canonicalBandlimitedDyadicScale r j
  let hrho : 0 < rho :=
    div_pos hdelta (canonicalBandlimitedDyadicScale_pos hr j)
  let Q : ι → SchwartzMap narrowFromRadialE2 Complex := fun i =>
    reflectedTubeProfile (scratch_canonicalBandlimitedTubeMultiplier rho hrho) (q i)
  let hQ : ∀ i, HasCompactSupport (Q i : narrowFromRadialE2 → Complex) := fun i =>
    reflectedTubeProfile_hasCompactSupport_left
      (scratch_canonicalBandlimitedTubeMultiplier rho hrho) (q i)
      (hasCompactSupport_scratch_canonicalBandlimitedTubeMultiplier hrho)
  have hrhoOne : rho ≤ 1 := by
    dsimp only [rho]
    linarith
  have hlogPow :
      (1 + |Real.log rho|) ^ ((3 : Real) / 2) ≤
        W * (1 + |Real.log delta|) ^ ((3 : Real) / 2) := by
    simpa only [rho, W, cWidth] using
      (canonicalWidth_log_threeHalves_le
        hdelta (by linarith) hr j (by simpa only [rho] using hrhoOne))
  have hQsupport : ∀ i,
      Function.support (Q i : narrowFromRadialE2 → Complex) ⊆ closedBall 0 (4 / rho) := by
    intro i
    exact reflectedCanonicalTubeProfile_support_subset_closedBall hrho (q i)
  have hmultsupport : ∀ theta,
      Function.support
        (finiteTensorCircleRadialMultiplier Finset.univ Q hQ a theta : narrowFromRadialE2 → Complex)
            ⊆
          closedBall 0 (4 / rho) := by
    apply support_finiteTensorCircleRadialMultiplier_of_profiles_supportedOn
      Finset.univ Q hQ a (closedBall 0 (4 / rho))
    intro i hi
    exact hQsupport i
  have hradbnd :
      eLpNorm (kakeyaRadialPhysicalEnvelope
        (finiteTensorCircleRadialMultiplier Finset.univ Q hQ a)) 2 volume ≤
        ENNReal.ofReal (A * (1 + |Real.log rho|) ^ ((3 : Real) / 2)) *
          (ENNReal.ofReal (∫ xi : narrowFromRadialE2,
            shiftedFiberSourceEnergy Finset.univ Q a xi)) ^ ((2 : Real)⁻¹) :=
    @hraw ι _ Q hQ a rho timeRadius hrho hrhoOne htimeLt ha hmultsupport
  have henergyRoot :
      (ENNReal.ofReal (∫ xi : narrowFromRadialE2,
        shiftedFiberSourceEnergy Finset.univ Q a xi)) ^ ((2 : Real)⁻¹) ≤
        ENNReal.ofReal U *
          eLpNorm (scratch_innerSlabCompactFrequencyTensor q a) 2 volume := by
    dsimp only [Q, U]
    exact rpow_half_ENNReal_ofReal_integral_shiftedFiberSourceEnergy_reflCan_le_coreNorm
      hrho q a
  have hradial :
      eLpNorm (kakeyaRadialPhysicalEnvelope
        (finiteTensorCircleRadialMultiplier Finset.univ Q hQ a)) 2 volume ≤
        ENNReal.ofReal
          (A * (1 + |Real.log rho|) ^ ((3 : Real) / 2)) *
          (ENNReal.ofReal (∫ xi : narrowFromRadialE2,
            shiftedFiberSourceEnergy Finset.univ Q a xi)) ^ ((2 : Real)⁻¹) := hradbnd
  have hscale :
      eLpNorm (canonicalReflectedUnitScaleEnvelope (canonicalTubeSignedScale r hr)
        delta N (scratch_innerSlabCompactFrequencyTensor q a) j) 2 volume ≤
        eLpNorm (kakeyaRadialPhysicalEnvelope
          (finiteTensorCircleRadialMultiplier Finset.univ Q hQ a)) 2 volume := by
    simpa only [rho, hrho, Q, hQ] using
      eLpNorm_canonicalReflectedUnitScaleEnvelope_innerSlab_le_radial
        hr hdelta N j q a htimeLt ha
  let Lrho : Real := (1 + |Real.log rho|) ^ ((3 : Real) / 2)
  have hLrho : 0 ≤ Lrho := by
    dsimp only [Lrho]
    positivity
  let Ldelta : Real := (1 + |Real.log delta|) ^ ((3 : Real) / 2)
  have hLdelta : 0 ≤ Ldelta := by
    dsimp only [Ldelta]
    positivity
  have hLrhoTransfer : Lrho ≤ W * Ldelta := by
    simpa only [Lrho, Ldelta] using hlogPow
  have hAU : 0 ≤ A * U := mul_nonneg hA.le hU
  have hscalar : A * Lrho * U ≤ Afinal * Ldelta := by
    calc
      A * Lrho * U = (A * U) * Lrho := by ring
      _ ≤ (A * U) * (W * Ldelta) :=
        mul_le_mul_of_nonneg_left hLrhoTransfer hAU
      _ = (A * W * Ldelta) * U := by ring
      _ ≤ (A * W * Ldelta) * (1 + U) := by
        apply mul_le_mul_of_nonneg_left
        · linarith
        · exact mul_nonneg (mul_nonneg hA.le hW.le) hLdelta
      _ = Afinal * Ldelta := by
        dsimp only [Afinal]
        ring
  have henvelope :
      eLpNorm (canonicalReflectedUnitScaleEnvelope (canonicalTubeSignedScale r hr)
        delta N (scratch_innerSlabCompactFrequencyTensor q a) j) 2 volume ≤
        ENNReal.ofReal (Afinal * Ldelta) *
          eLpNorm (scratch_innerSlabCompactFrequencyTensor q a) 2 volume := by
    calc
      eLpNorm (canonicalReflectedUnitScaleEnvelope (canonicalTubeSignedScale r hr)
        delta N (scratch_innerSlabCompactFrequencyTensor q a) j) 2 volume ≤
          eLpNorm (kakeyaRadialPhysicalEnvelope
            (finiteTensorCircleRadialMultiplier Finset.univ Q hQ a)) 2 volume := hscale
      _ ≤ ENNReal.ofReal (A * Lrho) *
          (ENNReal.ofReal (∫ xi : narrowFromRadialE2,
            shiftedFiberSourceEnergy Finset.univ Q a xi)) ^ ((2 : Real)⁻¹) := by
          simpa only [Lrho] using hradial
      _ ≤ ENNReal.ofReal (A * Lrho) *
          (ENNReal.ofReal U *
            eLpNorm (scratch_innerSlabCompactFrequencyTensor q a) 2 volume) :=
          mul_le_mul_right henergyRoot _
      _ = ENNReal.ofReal (A * Lrho * U) *
          eLpNorm (scratch_innerSlabCompactFrequencyTensor q a) 2 volume := by
          have hAL : 0 ≤ A * Lrho := mul_nonneg hA.le hLrho
          calc
            ENNReal.ofReal (A * Lrho) *
                (ENNReal.ofReal U *
                  eLpNorm (scratch_innerSlabCompactFrequencyTensor q a) 2 volume) =
                (ENNReal.ofReal (A * Lrho) * ENNReal.ofReal U) *
                  eLpNorm (scratch_innerSlabCompactFrequencyTensor q a) 2 volume := by ring
            _ = ENNReal.ofReal (A * Lrho * U) *
                  eLpNorm (scratch_innerSlabCompactFrequencyTensor q a) 2 volume := by
                rw [← ENNReal.ofReal_mul hAL]
      _ ≤ ENNReal.ofReal (Afinal * Ldelta) *
          eLpNorm (scratch_innerSlabCompactFrequencyTensor q a) 2 volume := by
          exact mul_le_mul_left (ENNReal.ofReal_le_ofReal hscalar) _
  let coeff : Real := canonicalBandlimitedDyadicCoefficient N c r j
  have hcoeff : 0 ≤ coeff := by
    dsimp only [coeff, canonicalBandlimitedDyadicCoefficient]
    positivity
  have henvMeas : Measurable
      (canonicalReflectedUnitScaleEnvelope (canonicalTubeSignedScale r hr)
        delta N (scratch_innerSlabCompactFrequencyTensor q a) j) := by
    apply measurable_canonicalReflectedUnitScaleEnvelope_canonicalTubeSignedScale
      hr delta N _ j
    exact ⟨ι, inferInstance, q, a, timeRadius, htimePos, htimeLt, ha, rfl⟩
  have hweightedScale :
      eLpNorm (fun y => ENNReal.ofReal coeff *
        canonicalReflectedUnitScaleEnvelope (canonicalTubeSignedScale r hr)
          delta N (scratch_innerSlabCompactFrequencyTensor q a) j y) 2 volume ≤
        ENNReal.ofReal coeff *
          eLpNorm (canonicalReflectedUnitScaleEnvelope (canonicalTubeSignedScale r hr)
            delta N (scratch_innerSlabCompactFrequencyTensor q a) j) 2 volume := by
    apply eLpNorm_le_mul_eLpNorm_of_ae_le_mul'' 2
      (by exact (measurable_const.mul henvMeas).aestronglyMeasurable)
    filter_upwards [] with y
    simpa only [enorm_eq_self] using
      (le_refl (ENNReal.ofReal coeff *
        canonicalReflectedUnitScaleEnvelope (canonicalTubeSignedScale r hr)
          delta N (scratch_innerSlabCompactFrequencyTensor q a) j y))
  calc
    eLpNorm (fun y => ENNReal.ofReal
        (canonicalBandlimitedDyadicCoefficient N c r j) *
          canonicalReflectedUnitScaleEnvelope (canonicalTubeSignedScale r hr)
            delta N (scratch_innerSlabCompactFrequencyTensor q a) j y) 2 volume ≤
        ENNReal.ofReal coeff *
          eLpNorm (canonicalReflectedUnitScaleEnvelope (canonicalTubeSignedScale r hr)
            delta N (scratch_innerSlabCompactFrequencyTensor q a) j) 2 volume := hweightedScale
    _ ≤ ENNReal.ofReal coeff *
        (ENNReal.ofReal (Afinal * Ldelta) *
          eLpNorm (scratch_innerSlabCompactFrequencyTensor q a) 2 volume) :=
        mul_le_mul_right henvelope _
    _ = ENNReal.ofReal (coeff * (Afinal * Ldelta)) *
        eLpNorm (scratch_innerSlabCompactFrequencyTensor q a) 2 volume := by
        calc
          ENNReal.ofReal coeff *
              (ENNReal.ofReal (Afinal * Ldelta) *
                eLpNorm (scratch_innerSlabCompactFrequencyTensor q a) 2 volume) =
              (ENNReal.ofReal coeff * ENNReal.ofReal (Afinal * Ldelta)) *
                eLpNorm (scratch_innerSlabCompactFrequencyTensor q a) 2 volume := by
                ring
          _ = ENNReal.ofReal (coeff * (Afinal * Ldelta)) *
                eLpNorm (scratch_innerSlabCompactFrequencyTensor q a) 2 volume := by
                rw [← ENNReal.ofReal_mul hcoeff]
    _ = ENNReal.ofReal
        (canonicalBandlimitedDyadicCoefficient N c r j *
          (Afinal * (1 + |Real.log delta|) ^ ((3 : Real) / 2))) *
          eLpNorm (scratch_innerSlabCompactFrequencyTensor q a) 2 volume := by
        dsimp only [coeff, Ldelta]

end

