theorem exists_normalizedCircle_finiteTensor_band_maximal
    (A : Real) (_hA : 0 ≤ A) :
    ∃ C : Real, 0 < C ∧ ∀ (ι : Type*) (s : Finset ι)
      (q : ι → SchwartzMap (Euclidean 2) Complex)
      (_hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
