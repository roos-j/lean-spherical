/-- The literal light-ray maximal estimate, assembled from the concrete
canonical narrow/broad decomposition. -/
theorem final_hasLightRayMaximalEstimate : HasLightRayMaximalEstimate :=
  hasLightRayMaximalEstimate_of_uniformConcreteNarrowScaleCost
    uniformConcreteNarrowScaleCost

/-- The completed light-ray maximal estimate supplies the squared-integral
energy input used by the continuum fine-kernel transposition.  The datum is
assumed to be literally restricted to the time slab, so its ambient `L²`
energy is exactly its `continuumLightRayMeasure` energy. -/
theorem lightRayMaximal_sq_integral_le_of_finalHasLightRayMaximalEstimate
    {δ : Real} (hδ : 0 < δ) (hδsmall : δ < 1 / 2)
    (N : Nat) (hN : 3 < N)
    (g : WaveSpaceTime → Complex) (hg : MemLp g 2 volume)
    (hslab : g = (Set.univ ×ˢ lightRayTimeInterval).indicator g) :
    ∃ C : Real, 0 < C ∧
      AEStronglyMeasurable (lightRayMaximal δ N g) volume ∧
      Integrable (fun y : Euclidean 2 => lightRayMaximal δ N g y ^ 2) volume ∧
      (∫ y : Euclidean 2, lightRayMaximal δ N g y ^ 2) ≤
        (C * (1 + |Real.log δ|) ^ (3 / 2 : Real)) ^ 2 *
          ∫ z : WaveSpaceTime, ‖g z‖ ^ 2 ∂continuumLightRayMeasure := by
  have hN' : 1 < N := by omega
  obtain ⟨C, hC, hmax⟩ := final_hasLightRayMaximalEstimate N hN
  let K : Real := C * (1 + |Real.log δ|) ^ (3 / 2 : Real)
  have hK : 0 ≤ K := by
    dsimp [K]
    positivity
  have hmaxBound :
      eLpNorm (lightRayMaximal δ N g) 2 volume ≤
        ENNReal.ofReal K * eLpNorm g 2 volume := by
    simpa only [K] using hmax δ hδ hδsmall g hg
  have hmaxMeas : AEStronglyMeasurable (lightRayMaximal δ N g) volume :=
    (scratch_measurable_lightRayMaximal_of_memLp hδ N hN' g hg).aestronglyMeasurable
  have hmaxTop : eLpNorm (lightRayMaximal δ N g) 2 volume < ∞ :=
    lt_of_le_of_lt hmaxBound
      (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hg.eLpNorm_lt_top)
  have hmaxMem : MemLp (lightRayMaximal δ N g) 2 volume :=
    hmaxTop
  have hmaxTwo : Integrable (fun y : Euclidean 2 => lightRayMaximal δ N g y ^ 2) volume :=
    (memLp_two_iff_integrable_sq hmaxMeas).mp hmaxMem
  let Iout : Real := ∫ y : Euclidean 2, lightRayMaximal δ N g y ^ 2
  let Iin : Real := ∫ z : WaveSpaceTime, ‖g z‖ ^ 2
  have hIout : 0 ≤ Iout := by
    dsimp [Iout]
    exact integral_nonneg fun y => sq_nonneg _
  have hIin : 0 ≤ Iin := by
    dsimp [Iin]
    exact integral_nonneg fun z => pow_nonneg (norm_nonneg _) _
  have hnormOut :
      eLpNorm (lightRayMaximal δ N g) 2 volume =
        ENNReal.ofReal (Iout ^ (2 : Real)⁻¹) := by
    rw [hmaxMem.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    norm_num [Iout, Real.norm_eq_abs]
  have hnormIn : eLpNorm g 2 volume = ENNReal.ofReal (Iin ^ (2 : Real)⁻¹) := by
    rw [hg.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    norm_num [Iin]
  have hrootENN :
      ENNReal.ofReal (Iout ^ (2 : Real)⁻¹) ≤
        ENNReal.ofReal (K * Iin ^ (2 : Real)⁻¹) := by
    calc
      ENNReal.ofReal (Iout ^ (2 : Real)⁻¹) =
          eLpNorm (lightRayMaximal δ N g) 2 volume := hnormOut.symm
      _ ≤ ENNReal.ofReal K * eLpNorm g 2 volume := hmaxBound
      _ = ENNReal.ofReal K * ENNReal.ofReal (Iin ^ (2 : Real)⁻¹) := by
        rw [hnormIn]
      _ = ENNReal.ofReal (K * Iin ^ (2 : Real)⁻¹) :=
        (ENNReal.ofReal_mul hK).symm
  have hrootRight : 0 ≤ K * Iin ^ (2 : Real)⁻¹ :=
    mul_nonneg hK (Real.rpow_nonneg hIin _)
  have hroot : Iout ^ (2 : Real)⁻¹ ≤ K * Iin ^ (2 : Real)⁻¹ :=
    (ENNReal.ofReal_le_ofReal_iff hrootRight).mp hrootENN
  have hsq : (Iout ^ (2 : Real)⁻¹) ^ 2 ≤ (K * Iin ^ (2 : Real)⁻¹) ^ 2 :=
    (sq_le_sq₀ (Real.rpow_nonneg hIout _) hrootRight).mpr hroot
  have hrootSqOut : (Iout ^ (2 : Real)⁻¹) ^ 2 = Iout := by
    rw [show (2 : Real)⁻¹ = 1 / 2 by norm_num, ← Real.sqrt_eq_rpow]
    exact Real.sq_sqrt hIout
  have hrootSqIn : (Iin ^ (2 : Real)⁻¹) ^ 2 = Iin := by
    rw [show (2 : Real)⁻¹ = 1 / 2 by norm_num, ← Real.sqrt_eq_rpow]
    exact Real.sq_sqrt hIin
  have henergyFull : Iout ≤ K ^ 2 * Iin := by
    calc
      Iout = (Iout ^ (2 : Real)⁻¹) ^ 2 := hrootSqOut.symm
      _ ≤ (K * Iin ^ (2 : Real)⁻¹) ^ 2 := hsq
      _ = K ^ 2 * Iin := by rw [mul_pow, hrootSqIn]
  let slab : Set WaveSpaceTime := Set.univ ×ˢ lightRayTimeInterval
  have hslabMeas : MeasurableSet slab := by
    dsimp [slab]
    exact MeasurableSet.univ.prod (by
      unfold lightRayTimeInterval
      exact measurableSet_Icc)
  have hmeasure :
      continuumLightRayMeasure = (volume : Measure WaveSpaceTime).restrict slab := by
    unfold continuumLightRayMeasure
    change (volume : Measure (Euclidean 2)).prod
        ((volume : Measure Real).restrict lightRayTimeInterval) =
      ((volume : Measure (Euclidean 2)).prod (volume : Measure Real)).restrict
        (Set.univ ×ˢ lightRayTimeInterval)
    rw [← Measure.prod_restrict]
    simp
  have hslab' : g = slab.indicator g := by
    simpa only [slab] using hslab
  have hnormIndicator :
      (fun z : WaveSpaceTime => ‖g z‖ ^ 2) =
        slab.indicator (fun z : WaveSpaceTime => ‖g z‖ ^ 2) := by
    funext z
    by_cases hz : z ∈ slab
    · simp [hz]
    · have hz0 : g z = 0 := by
        rw [hslab']
        simp [hz]
      simp [hz, hz0]
  have henergySlab : Iin =
      ∫ z : WaveSpaceTime, ‖g z‖ ^ 2 ∂continuumLightRayMeasure := by
    dsimp [Iin]
    calc
      (∫ z : WaveSpaceTime, ‖g z‖ ^ 2) =
          ∫ z : WaveSpaceTime, slab.indicator (fun z : WaveSpaceTime => ‖g z‖ ^ 2) z := by
        apply integral_congr_ae
        filter_upwards with z
        exact congrFun hnormIndicator z
      _ = ∫ z : WaveSpaceTime in slab, ‖g z‖ ^ 2 :=
        integral_indicator hslabMeas
      _ = ∫ z : WaveSpaceTime, ‖g z‖ ^ 2 ∂continuumLightRayMeasure := by
        rw [hmeasure]
  refine ⟨C, hC, hmaxMeas, hmaxTwo, ?_⟩
  change Iout ≤ K ^ 2 * ∫ z : WaveSpaceTime, ‖g z‖ ^ 2 ∂continuumLightRayMeasure
  rw [← henergySlab]
  exact henergyFull

/-- The completed literal light-ray maximal estimate supplies the raw
Kakeya-energy hypothesis in the continuum fine-kernel pairing argument.  The
only additional restriction on the datum is the literal time-slab support
already present in the light-ray average. -/
theorem continuumFineKernelWeightedPairing_le_of_finalHasLightRayMaximalEstimate
    {δ A : Real} (hδ : 0 < δ) (hδsmall : δ < 1 / 2)
    (N : Nat) (hN : 3 < N) (hA : 0 ≤ A)
    (ω : Euclidean 2) (hω : ω ∈ unitLightRayDirections)
    (kernel : WaveSpaceTime → Euclidean 2 → Complex)
    (input : Euclidean 2 → Complex) (g : WaveSpaceTime → Complex)
    (hg : MemLp g 2 volume)
    (hslab : g = (Set.univ ×ˢ lightRayTimeInterval).indicator g)
    (hkernel : ∀ z y, ‖kernel z y‖ ≤ lightRayKernel δ N ω y z)
    (hmass : ∀ z, Integrable (fun y : Euclidean 2 =>
      lightRayKernel δ N ω y z) volume ∧
      (∫ y : Euclidean 2, lightRayKernel δ N ω y z) ≤ A)
    (hmeas : ∀ z, AEStronglyMeasurable (fun y : Euclidean 2 =>
      (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y * input y‖ ^ 2) volume)
    (henergy : ∀ z, Integrable (fun y : Euclidean 2 =>
      lightRayKernel δ N ω y z * ‖input y‖ ^ 2) volume)
    (htermWeighted : Integrable (fun z : WaveSpaceTime =>
      ‖∫ y : Euclidean 2, kernel z y * input y‖ ^ 2 * ‖g z‖)
      continuumLightRayMeasure)
    (henergyWeighted : Integrable (fun z : WaveSpaceTime =>
      (∫ y : Euclidean 2,
        lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖)
      continuumLightRayMeasure)
    (hprod : Integrable (fun p : WaveSpaceTime × Euclidean 2 =>
      lightRayKernel δ N ω p.2 p.1 * ‖input p.2‖ ^ 2 * ‖g p.1‖)
      (continuumLightRayMeasure.prod volume))
    (hRayInt : ∀ y : Euclidean 2, Integrable (fun z : WaveSpaceTime =>
      lightRayKernel δ N ω y z * ‖g z‖) continuumLightRayMeasure)
    (hbounded : ∀ y : Euclidean 2,
      BddAbove ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
        unitLightRayDirections))
    (hinputMeas : AEStronglyMeasurable input volume)
    (hinputFour : Integrable (fun y : Euclidean 2 => ‖input y‖ ^ 4) volume) :
    ∃ C : Real, 0 < C ∧
      (∫ z : WaveSpaceTime,
        ‖∫ y : Euclidean 2, kernel z y * input y‖ ^ 2 * ‖g z‖
        ∂continuumLightRayMeasure) ≤
        A * (∫ y : Euclidean 2, ‖input y‖ ^ 4) ^ ((2 : Real)⁻¹) *
          ((C * (1 + |Real.log δ|) ^ (3 / 2 : Real)) ^ 2 *
            ∫ z : WaveSpaceTime, ‖g z‖ ^ 2
              ∂continuumLightRayMeasure) ^ ((2 : Real)⁻¹) := by
  obtain ⟨C, hC, hmaxMeas, hmaxTwo, hKakeya⟩ :=
    lightRayMaximal_sq_integral_le_of_finalHasLightRayMaximalEstimate
      hδ hδsmall N hN g hg hslab
  refine ⟨C, hC, ?_⟩
  exact continuumFineKernelWeightedPairing_le_of_lightRayL2Energy
    hδ hA N ω hω kernel input g hkernel hmass hmeas henergy htermWeighted
    henergyWeighted hprod hRayInt hbounded hinputMeas hinputFour hmaxMeas
    hmaxTwo hKakeya

end Auto.Spherical.MSS
