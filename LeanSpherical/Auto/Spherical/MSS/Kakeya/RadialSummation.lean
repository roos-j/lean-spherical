      1 <= ‖xi‖ * rTerminal ^ 2 := by
    intro xi hxi
    simpa only [rTerminal] using radialBand_terminal_outer hlambda16 xi hxi
  rcases exists_kakeyaRadialBandPhysicalField_shiftedCapped_annular_max_bound
      L s q hqcompact a i radialBandOuterRhoMax_nonneg radialBandOuterRhoMax_small
      heps K hscale hcentralMem hcentralCritical hdyadicMem hdyadicOuter hratio
      hratioDef hrTerminal hrTerminalMem hterminalOuter hrTime hsupport with
    ⟨cost, hcost, hbound⟩
  refine ⟨cost, ?_, ?_⟩
  · simpa only [radialBandAngularLevel, K, lambda] using hcost
  · simpa only [radialBandAngularLevel, radialBandAngularEps,
      radialBandTerminalRatio, K, eps, ratio, rTerminal, lambda] using hbound

/-- The narrow radial-band theorem in its scale-cost form: the physical
maximum has already summed the four charts, seven stationary shifts, and
all capped shells, and the remaining RHS is one uncharted source-energy
integral with an explicit finite coefficient sum. -/
theorem exists_kakeyaRadialBandPhysicalField_narrow_scaleCost_bound
    {iota : Type*} (L : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex) (i : Nat) (hi : 3 <= i)
    {rTime : Real} (hrTime : rTime < 1)
    (hsupport : ∀ l, Function.support (a l : Real -> Complex) ⊆
      closedBall (3 / 2 : Real) rTime) :
    ∃ cost : Fin 4 × (Nat × Nat) -> Real,
      (∀ jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
          (radialBandAngularLevel i), 0 < cost jni) ∧
      (∫⁻ y : Euclidean 2, ⨆ theta : Real,
        ENNReal.ofReal
          (‖kakeyaRadialBandPhysicalField L
            (fun theta => scratch_finiteTensorTubeMultiplier s q hqcompact a
              (circleDirection theta))
            i theta y‖ ^ 2)) <=
        ((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
          (radialBandAngularLevel i)).card : ENNReal) *
          ((∑ jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
              (radialBandAngularLevel i), ENNReal.ofReal (4 * cost jni)) *
            (4 * ENNReal.ofReal (∫ xi : Euclidean 2,
              shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles L q i) a xi ∂
                (volume.restrict (scaledDyadicFrequencyAnnulus
                  (kakeyaRadialBandScale i)))))) := by
  exact exists_kakeyaRadialBandPhysicalField_scaleCost_of_max_bound
    L s q hqcompact a i (radialBandAngularLevel i)
    (exists_kakeyaRadialBandPhysicalField_narrow_bound
      L s q hqcompact a i hi hrTime hsupport)

end

