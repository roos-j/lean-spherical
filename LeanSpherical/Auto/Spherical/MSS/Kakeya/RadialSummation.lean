            (ENNReal.ofReal (A0 * Lrho) * ENNReal.ofReal H) *
              E ^ ((2 : Real)⁻¹) := by ring
        _ = ENNReal.ofReal ((A0 * Lrho) * H) * E ^ ((2 : Real)⁻¹) := by
            rw [← ENNReal.ofReal_mul hA0Lrho]
        _ = ENNReal.ofReal ((A0 * H) * Lrho) * E ^ ((2 : Real)⁻¹) := by
