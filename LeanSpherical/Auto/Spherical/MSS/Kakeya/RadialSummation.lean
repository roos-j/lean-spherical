/-- The literal finite circle multiplier field is jointly continuous.  The
proof only uses the global Schwartz majorant of the finite tensor, so it is
available for every compact-frequency finite core. -/
theorem continuous_uncurry_finiteTensorCircleMultiplierField
    {iota : Type*} (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex) :
    Continuous (Function.uncurry
      (finiteTensorCircleMultiplierField s q hqcompact a)) := by
  let m : Real -> Euclidean 2 -> Complex := fun theta xi =>
    scratch_finiteTensorTubeMultiplier s q hqcompact a
      (circleDirection theta) xi
  have hm : Continuous (Function.uncurry m) := by
    change Continuous (fun p : Real × Euclidean 2 =>
      scratch_finiteTensorTubeMultiplier s q hqcompact a
        (circleDirection p.1) p.2)
    exact continuous_uncurry_scratch_finiteTensorTubeMultiplier_circle s q hqcompact a
  change Continuous (Function.uncurry (fun theta y =>
    FourierTransform.fourierInv (m theta) y))
  apply continuous_uncurry_fourierInv_of_dominated m
    (bound := finiteTensorTubeMultiplierBound s q a)
  · intro xi
    have hphase : Continuous (fun p : Real × Euclidean 2 =>
        (Real.fourierChar (inner Real xi p.2) : Complex)) := by fun_prop
    have hmxi : Continuous (fun p : Real × Euclidean 2 => m p.1 xi) :=
      hm.comp (show Continuous (fun p : Real × Euclidean 2 => (p.1, xi)) by
        fun_prop)
    exact hphase.smul hmxi
  · intro p
    have hphase : Continuous (fun xi : Euclidean 2 =>
        (Real.fourierChar (inner Real xi p.2) : Complex)) := by fun_prop
    have hmxi : Continuous (fun xi : Euclidean 2 => m p.1 xi) :=
      hm.comp (show Continuous (fun xi : Euclidean 2 => (p.1, xi)) by
        fun_prop)
    exact (hphase.smul hmxi).aestronglyMeasurable
  · intro p xi
    have hchar (u : Real) : ‖(Real.fourierChar u : Complex)‖ = 1 := by
      rw [Real.fourierChar_apply, Complex.norm_exp]
      simp
    rw [norm_smul, hchar, one_mul]
    exact norm_scratch_finiteTensorTubeMultiplier_circle_le_bound
      s q hqcompact a p.1 xi
  · exact integrable_finiteTensorTubeMultiplierBound s q a

/-- A jointly continuous `2π`-periodic circle family has a measurable global
square maximum.  Keeping this generic avoids unfolding a Fourier multiplier
while elaborating the compact-interval measurability proof. -/
theorem measurable_iSup_sq_of_continuous_periodic
    (F : Real -> Euclidean 2 -> Complex)
    (hF : Continuous (Function.uncurry F))
    (hperiodic : ∀ y, Function.Periodic (fun theta => F theta y)
      (2 * Real.pi)) :
    Measurable (fun y : Euclidean 2 =>
      ⨆ theta : Real, ENNReal.ofReal (‖F theta y‖ ^ 2)) := by
  have hcompact : Measurable (fun y : Euclidean 2 =>
      ⨆ theta : Icc (-Real.pi) Real.pi,
        ENNReal.ofReal (‖F theta.1 y‖ ^ 2)) :=
    measurable_iSup_ennreal_norm_sq_of_continuous
      (d := 2) (F := Function.uncurry F)
      (a := -Real.pi) (b := Real.pi) hF
  have heq : (fun y : Euclidean 2 =>
      ⨆ theta : Real, ENNReal.ofReal (‖F theta y‖ ^ 2)) =
      fun y : Euclidean 2 => ⨆ theta : Icc (-Real.pi) Real.pi,
        ENNReal.ofReal (‖F theta.1 y‖ ^ 2) := by
    funext y
    exact iSup_sq_periodic_parametricField_eq_fundamental F hperiodic y
  rw [heq]
  exact hcompact

/-- The global periodic circle supremum of a finite tensor is measurable.
This is the measurability input for both the low finite bands and the
stationary-shell radial bands. -/
theorem measurable_iSup_sq_finiteTensorCircleMultiplierField
    {iota : Type*} (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex) :
    Measurable (fun y : Euclidean 2 =>
      ⨆ theta : Real, ENNReal.ofReal
        (‖finiteTensorCircleMultiplierField s q hqcompact a theta y‖ ^ 2)) := by
  apply measurable_iSup_sq_of_continuous_periodic
  · exact continuous_uncurry_finiteTensorCircleMultiplierField s q hqcompact a
  · intro y
    exact periodic_finiteTensorCircleMultiplierField s q hqcompact a y

