    finiteTensorPhysicalTimeData s (fun i => circleRaySpatialDouble (q i))
      (fun i => circleRayTimeDouble (a i)) z =
      finiteTensorPhysicalTimeData s q a ((2:Real)•z.1,2*z.2) := by
