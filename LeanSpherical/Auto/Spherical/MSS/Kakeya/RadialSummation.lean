  apply hg.congr_norm (Complex.continuous_ofReal.comp_aestronglyMeasurable hg.aestronglyMeasurable.norm)
  filter_upwards [] with x
  simp only [Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg (norm_nonneg _)]

