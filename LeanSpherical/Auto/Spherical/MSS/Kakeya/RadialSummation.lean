private theorem radialBandScale_ge_sixteen (i : Nat) (hi : 3 <= i) :
    16 <= kakeyaRadialBandScale i := by
  unfold kakeyaRadialBandScale
  have hpow : (2 : Real) ^ 4 <= (2 : Real) ^ (i + 1) :=
    pow_le_pow_right₀ (by norm_num) (by omega)
  norm_num at hpow ⊢
  exact hpow

private theorem centeredCriticalWidth_le_quarter
    {lambda : Real} (hlambda : 16 <= lambda) :
    centeredCriticalWidth lambda <= 1 / 4 := by
  have hlambdaPos : 0 < lambda := by linarith
  have hepsPos : 0 < centeredCriticalWidth lambda :=
    centeredCriticalWidth_pos hlambdaPos
  have hepsSq : lambda * centeredCriticalWidth lambda ^ 2 = 1 :=
    centeredCriticalWidth_sq hlambdaPos
  nlinarith [sq_nonneg (centeredCriticalWidth lambda - (1 / 4 : Real))]

/-- The fixed carrier used by every capped near-stationary outer lobe. -/
noncomputable def radialBandOuterRhoMax : Real := 2 * Real.pi / 5

/-- The critical angular width at the `i`th positive radial carrier. -/
noncomputable def radialBandAngularEps (i : Nat) : Real :=
  centeredCriticalWidth (kakeyaRadialBandScale i)

/-- The capped dyadic angular level at the `i`th positive radial carrier. -/
noncomputable def radialBandAngularLevel (i : Nat) : Nat :=
  kakeyaCappedShellLevel (kakeyaRadialBandScale i)

/-- The literal terminal width/cap ratio at the `i`th radial carrier. -/
noncomputable def radialBandTerminalRatio (i : Nat) : Real :=
  ((2 : Real) ^ (radialBandAngularLevel i) * radialBandAngularEps i) /
    (Real.pi / 2)

theorem radialBandOuterRhoMax_nonneg : 0 <= radialBandOuterRhoMax := by
  unfold radialBandOuterRhoMax
  positivity

theorem radialBandOuterRhoMax_small :
    9 * radialBandOuterRhoMax / 4 < Real.pi := by
  unfold radialBandOuterRhoMax
  nlinarith [Real.pi_pos]

theorem one_le_radialBandOuterRhoMax : 1 <= radialBandOuterRhoMax := by
  unfold radialBandOuterRhoMax
  nlinarith [Real.pi_gt_three]

private theorem radialBand_central_mem
    {lambda : Real} (hlambda : 16 <= lambda) :
    4 * centeredCriticalWidth lambda ∈ Icc (0 : Real) radialBandOuterRhoMax := by
  have hepsPos : 0 < centeredCriticalWidth lambda :=
    centeredCriticalWidth_pos (by linarith)
  constructor
  · positivity
  · calc
      4 * centeredCriticalWidth lambda <= 4 * (1 / 4 : Real) :=
        mul_le_mul_of_nonneg_left (centeredCriticalWidth_le_quarter hlambda) (by norm_num)
      _ = 1 := by norm_num
      _ <= radialBandOuterRhoMax := one_le_radialBandOuterRhoMax

private theorem radialBand_central_critical
    {lambda : Real} (hlambda : 16 <= lambda) (xi : Euclidean 2)
    (hxi : xi ∈ scaledDyadicFrequencyAnnulus lambda) :
    1 <= ‖xi‖ * (4 * centeredCriticalWidth lambda) ^ 2 ∧
      ‖xi‖ * (4 * centeredCriticalWidth lambda) ^ 2 <= 32 := by
  have hlambdaPos : 0 < lambda := by linarith
  have hepsSq : lambda * centeredCriticalWidth lambda ^ 2 = 1 :=
    centeredCriticalWidth_sq hlambdaPos
  have hepsSqNonneg : 0 <= centeredCriticalWidth lambda ^ 2 := sq_nonneg _
  have hlo := mul_le_mul_of_nonneg_right hxi.1 hepsSqNonneg
  have hhi := mul_le_mul_of_nonneg_right hxi.2 hepsSqNonneg
  constructor
  · calc
      1 = lambda * centeredCriticalWidth lambda ^ 2 := hepsSq.symm
      _ <= ‖xi‖ * (4 * centeredCriticalWidth lambda) ^ 2 := by
        nlinarith
  · calc
      ‖xi‖ * (4 * centeredCriticalWidth lambda) ^ 2 <=
          32 * (lambda * centeredCriticalWidth lambda ^ 2) := by
            nlinarith
      _ = 32 := by rw [hepsSq]; ring

