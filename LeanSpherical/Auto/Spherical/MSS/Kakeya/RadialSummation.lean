section

section Auto.Spherical.MSS

open Filter MeasureTheory Metric Set
open Auto.Spherical.SurfaceMeasureDecay
open Auto.LittlewoodPaley
open scoped BigOperators ENNReal EuclideanSpace

noncomputable section

theorem shiftedCappedShellIndicesGeneric_univ_eq_shiftedCappedShellIndices
    (K : Nat) :
    shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K =
      shiftedCappedShellIndices K := by
  rfl

theorem exists_highRadialBand_shell_card_sq_le_bandCount_sq :
    ∃ A : Real, 0 < A ∧ ∀ N i : Nat, i < N →
      (((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
        (radialBandAngularLevel i)).card : ENNReal) ^ 2) ≤
        ENNReal.ofReal (A * ((N + 1 : Nat) : Real) ^ 2) := by
  rcases exists_shiftedCappedShellIndices_card_sq_log_sq_bound with ⟨A, hA, hcard⟩
  let C : Real := 1 + Real.log 2
  have hC : 0 < C := by
    dsimp only [C]
    have : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
    linarith
  refine ⟨A * C ^ 2, mul_pos hA (sq_pos_of_pos hC), ?_⟩
  intro N i hiN
  have hscaleOne : 1 ≤ kakeyaRadialBandScale i := by
    unfold kakeyaRadialBandScale
    exact one_le_pow₀ (by norm_num : (1 : Real) ≤ 2)
  have hlogNonneg : 0 ≤ 1 + Real.log (kakeyaRadialBandScale i) := by
    linarith [Real.log_nonneg hscaleOne]
  have hlog2 : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
  have hcast : (i + 1 : Nat) ≤ N := by omega
  have hcastReal : ((i + 1 : Nat) : Real) ≤ (N : Real) := by
    exact_mod_cast hcast
  have hmul := mul_le_mul_of_nonneg_right hcastReal hlog2
  have hN : 0 ≤ (N : Real) := by positivity
  have hlog : 1 + Real.log (kakeyaRadialBandScale i) ≤
      C * ((N + 1 : Nat) : Real) := by
    rw [show kakeyaRadialBandScale i = (2 : Real) ^ (i + 1) by rfl,
      Real.log_pow]
    push_cast at hmul ⊢
    calc
      1 + ((i : Real) + 1) * Real.log 2 ≤ 1 + (N : Real) * Real.log 2 := by
        linarith
      _ ≤ (1 + Real.log 2) * ((N : Real) + 1) := by
        nlinarith [mul_nonneg hN hlog2]
  have hrightNonneg : 0 ≤ C * ((N + 1 : Nat) : Real) := by
    exact mul_nonneg hC.le (by positivity)
  have hlogsq : (1 + Real.log (kakeyaRadialBandScale i)) ^ 2 ≤
      (C * ((N + 1 : Nat) : Real)) ^ 2 := by
    nlinarith
  have hreal :
      (((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
        (radialBandAngularLevel i)).card : Real) ^ 2) ≤
        (A * C ^ 2) * ((N + 1 : Nat) : Real) ^ 2 := by
    rw [shiftedCappedShellIndicesGeneric_univ_eq_shiftedCappedShellIndices]
    calc
      (((shiftedCappedShellIndices (radialBandAngularLevel i)).card : Real) ^ 2) ≤
          A * (1 + Real.log (kakeyaRadialBandScale i)) ^ 2 := by
            apply hcard
            exact hscaleOne
      _ ≤ A * (C * ((N + 1 : Nat) : Real)) ^ 2 := by
        exact mul_le_mul_of_nonneg_left hlogsq hA.le
      _ = (A * C ^ 2) * ((N + 1 : Nat) : Real) ^ 2 := by ring
  calc
    (((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
      (radialBandAngularLevel i)).card : ENNReal) ^ 2) =
        ENNReal.ofReal
          (((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
            (radialBandAngularLevel i)).card : Real) ^ 2) := by
          simp
    _ ≤ ENNReal.ofReal (A * C ^ 2 * ((N + 1 : Nat) : Real) ^ 2) :=
      ENNReal.ofReal_le_ofReal hreal

noncomputable def highRadialBandSquareMass
    {iota : Type*} (C : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex) (i : Nat) : ENNReal :=
  ∫⁻ y : Euclidean 2, ⨆ theta : Real,
    ENNReal.ofReal
      (‖kakeyaRadialBandPhysicalField C
        (fun theta => scratch_finiteTensorTubeMultiplier s q hqcompact a
          (circleDirection theta))
        i theta y‖ ^ 2)

noncomputable def highRadialBandSourceEnergy
    {iota : Type*} (C : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (i : Nat) : Real :=
  ∫ xi : Euclidean 2,
    shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles C q i) a xi ∂
      (volume.restrict (scaledDyadicFrequencyAnnulus (kakeyaRadialBandScale i)))

theorem highRadialBandSourceEnergy_nonneg
    {iota : Type*} (C : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (i : Nat) :
    0 ≤ highRadialBandSourceEnergy C s q a i := by
  unfold highRadialBandSourceEnergy
  apply integral_nonneg
  intro xi
  exact shiftedFiberSourceEnergy_nonneg s (finiteTensorRadialBandProfiles C q i) a xi

theorem highRadialBandSourceEnergy_le_full
    {iota : Type*} (C : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (i : Nat) :
    highRadialBandSourceEnergy C s q a i ≤
      ∫ xi : Euclidean 2,
        shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles C q i) a xi := by
  unfold highRadialBandSourceEnergy
  apply integral_mono_measure Measure.restrict_le_self
  · exact Filter.Eventually.of_forall fun xi =>
      shiftedFiberSourceEnergy_nonneg s (finiteTensorRadialBandProfiles C q i) a xi
  · exact integrable_shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles C q i) a

theorem sum_highRadialBandSourceEnergy_le_sixteen
    {iota : Type*} (C : lpCutoffs 2) (N : Nat) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) :
    (∑ i ∈ Finset.Ico 3 N, highRadialBandSourceEnergy C s q a i) ≤
      16 * ∫ xi : Euclidean 2, shiftedFiberSourceEnergy s q a xi := by
  calc
    (∑ i ∈ Finset.Ico 3 N, highRadialBandSourceEnergy C s q a i) ≤
        ∑ i ∈ Finset.Ico 3 N,
          ∫ xi : Euclidean 2,
            shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles C q i) a xi := by
      apply Finset.sum_le_sum
      intro i hi
      exact highRadialBandSourceEnergy_le_full C s q a i
    _ ≤ 16 * ∫ xi : Euclidean 2, shiftedFiberSourceEnergy s q a xi := by
      simpa using
        (sum_integral_shiftedFiberSourceEnergy_radialBandProfiles_le_sixteen
          C (Finset.Ico 3 N) s q a Set.univ)

/-- The fully collapsed capped-shell cost assigned to one high radial band. -/
noncomputable def highRadialBandScaleCost
    {iota : Type*} (B : Real) (C : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (i : Nat) : ENNReal :=
  ((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
    (radialBandAngularLevel i)).card : ENNReal) *
    ((∑ _jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
        (radialBandAngularLevel i), ENNReal.ofReal (4 * B)) *
      (4 * ENNReal.ofReal (highRadialBandSourceEnergy C s q a i)))

theorem highRadialBandScaleCost_eq
    {iota : Type*} {B : Real} (hB : 0 ≤ B) (C : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (i : Nat) :
    highRadialBandScaleCost B C s q a i =
      ((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
        (radialBandAngularLevel i)).card : ENNReal) ^ 2 *
        ENNReal.ofReal (16 * B) *
          ENNReal.ofReal (highRadialBandSourceEnergy C s q a i) := by
  unfold highRadialBandScaleCost
  simp only [Finset.sum_const, nsmul_eq_mul]
  have hscalar : ENNReal.ofReal (4 * B) *
      (4 * ENNReal.ofReal (highRadialBandSourceEnergy C s q a i)) =
      ENNReal.ofReal (16 * B) *
        ENNReal.ofReal (highRadialBandSourceEnergy C s q a i) := by
    calc
      ENNReal.ofReal (4 * B) *
          (4 * ENNReal.ofReal (highRadialBandSourceEnergy C s q a i)) =
          (ENNReal.ofReal (4 * B) * ENNReal.ofReal (4 : Real)) *
            ENNReal.ofReal (highRadialBandSourceEnergy C s q a i) := by
            norm_num
            ring
      _ = ENNReal.ofReal ((4 * B) * 4) *
            ENNReal.ofReal (highRadialBandSourceEnergy C s q a i) := by
            rw [← ENNReal.ofReal_mul (by nlinarith)]
      _ = ENNReal.ofReal (16 * B) *
            ENNReal.ofReal (highRadialBandSourceEnergy C s q a i) := by
            congr 2
            ring
  calc
    ((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
      (radialBandAngularLevel i)).card : ENNReal) *
        (((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
          (radialBandAngularLevel i)).card : ENNReal) * ENNReal.ofReal (4 * B) *
          (4 * ENNReal.ofReal (highRadialBandSourceEnergy C s q a i))) =
        ((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
          (radialBandAngularLevel i)).card : ENNReal) ^ 2 *
          (ENNReal.ofReal (4 * B) *
            (4 * ENNReal.ofReal (highRadialBandSourceEnergy C s q a i))) := by
          ring
    _ = ((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
          (radialBandAngularLevel i)).card : ENNReal) ^ 2 *
          (ENNReal.ofReal (16 * B) *
            ENNReal.ofReal (highRadialBandSourceEnergy C s q a i)) := by
          rw [hscalar]
    _ = ((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
          (radialBandAngularLevel i)).card : ENNReal) ^ 2 *
          ENNReal.ofReal (16 * B) *
            ENNReal.ofReal (highRadialBandSourceEnergy C s q a i) := by ring

theorem sum_highRadialBandScaleCost_le_of_card_bound
    {iota : Type*} {A B : Real} (hA : 0 < A) (hB : 0 < B)
    (C : lpCutoffs 2) (N : Nat) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex)
    (hcard : ∀ i ∈ Finset.Ico 3 N,
      (((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
        (radialBandAngularLevel i)).card : ENNReal) ^ 2) ≤
        ENNReal.ofReal (A * ((N + 1 : Nat) : Real) ^ 2)) :
    (∑ i ∈ Finset.Ico 3 N, highRadialBandScaleCost B C s q a i) ≤
      ((N + 1 : Nat) : ENNReal) ^ 2 *
        ENNReal.ofReal (256 * A * B) *
          ENNReal.ofReal (∫ xi : Euclidean 2, shiftedFiberSourceEnergy s q a xi) := by
  let S : Finset Nat := Finset.Ico 3 N
  let D : ENNReal := ENNReal.ofReal (A * ((N + 1 : Nat) : Real) ^ 2)
  let K : ENNReal := ENNReal.ofReal (16 * B)
  let E : Nat → ENNReal := fun i => ENNReal.ofReal (highRadialBandSourceEnergy C s q a i)
  have hper : ∀ i ∈ S, highRadialBandScaleCost B C s q a i ≤ D * K * E i := by
    intro i hi
    rw [highRadialBandScaleCost_eq hB.le]
    dsimp only [D, K, E]
    gcongr
    exact hcard i hi
  have hsumReal := sum_highRadialBandSourceEnergy_le_sixteen C N s q a
  have hsumE : (∑ i ∈ S, E i) ≤
      ENNReal.ofReal (16 * ∫ xi : Euclidean 2,
        shiftedFiberSourceEnergy s q a xi) := by
    dsimp only [S, E]
    rw [← ENNReal.ofReal_sum_of_nonneg]
    · exact ENNReal.ofReal_le_ofReal hsumReal
    · intro i hi
      exact highRadialBandSourceEnergy_nonneg C s q a i
  have hsum : (∑ i ∈ S, highRadialBandScaleCost B C s q a i) ≤
      D * K * (∑ i ∈ S, E i) := by
    calc
      (∑ i ∈ S, highRadialBandScaleCost B C s q a i) ≤
          ∑ i ∈ S, D * K * E i := by
            exact Finset.sum_le_sum (fun i hi => hper i hi)
      _ = D * K * (∑ i ∈ S, E i) := by
            simp only [Finset.mul_sum, mul_assoc]
  calc
    (∑ i ∈ Finset.Ico 3 N, highRadialBandScaleCost B C s q a i) =
        ∑ i ∈ S, highRadialBandScaleCost B C s q a i := by rfl
    _ ≤ D * K * (∑ i ∈ S, E i) := hsum
    _ ≤ D * K * ENNReal.ofReal (16 * ∫ xi : Euclidean 2,
        shiftedFiberSourceEnergy s q a xi) := by
      gcongr
    _ = ((N + 1 : Nat) : ENNReal) ^ 2 *
        ENNReal.ofReal (256 * A * B) *
          ENNReal.ofReal (∫ xi : Euclidean 2, shiftedFiberSourceEnergy s q a xi) := by
      dsimp only [D, K]
      have hN : 0 ≤ ((N + 1 : Nat) : Real) := by positivity
      have hNsq : 0 ≤ ((N + 1 : Nat) : Real) ^ 2 := sq_nonneg _
      have h16B : 0 ≤ 16 * B := by nlinarith [hB.le]
      have hleft : 0 ≤ A * ((N + 1 : Nat) : Real) ^ 2 * (16 * B) := by
        exact mul_nonneg (mul_nonneg hA.le hNsq) h16B
      have h256AB : 0 ≤ 256 * A * B := by positivity
      have hright : 0 ≤ ((N + 1 : Nat) : Real) ^ 2 * (256 * A * B) := by
        exact mul_nonneg hNsq h256AB
      conv_lhs =>
        rw [← ENNReal.ofReal_mul (mul_nonneg hA.le hNsq),
          ← ENNReal.ofReal_mul hleft]
      conv_rhs =>
        rw [← ENNReal.ofReal_natCast,
          ← ENNReal.ofReal_pow hN,
          ← ENNReal.ofReal_mul hNsq,
          ← ENNReal.ofReal_mul hright]
      congr 1
      ring

/-- The high radial Littlewood--Paley block has a single global cost: it is
selected before all tensor/profile data and controls the sum of bands `i ≥ 3`
with exactly the square of the retained radial-piece count. -/
theorem exists_global_highRadialBand_summed_scaleCost_bound :
    ∃ D : Real, 0 < D ∧
      ∀ {iota : Type*} (C : lpCutoffs 2) (N : Nat) (s : Finset iota)
        (q : iota -> SchwartzMap (Euclidean 2) Complex)
        (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
        (a : iota -> SchwartzMap Real Complex)
        {rTime : Real}, rTime < 1 →
          (∀ l, Function.support (a l : Real -> Complex) ⊆
            closedBall (3 / 2 : Real) rTime) →
          (∑ i ∈ Finset.Ico 3 N,
            highRadialBandSquareMass C s q hqcompact a i) ≤
            ((N + 1 : Nat) : ENNReal) ^ 2 *
              ENNReal.ofReal D *
                ENNReal.ofReal (∫ xi : Euclidean 2,
                  shiftedFiberSourceEnergy s q a xi) := by
  rcases exists_highRadialBand_shell_card_sq_le_bandCount_sq with ⟨A, hA, hcard⟩
  rcases exists_global_kakeyaRadialBandPhysicalField_uniform_narrow_scaleCost_bound with
    ⟨B, hB, hband⟩
  refine ⟨256 * A * B, by positivity, ?_⟩
  intro iota C N s q hqcompact a rTime hrTime hsupport
  have hmass : ∀ i ∈ Finset.Ico 3 N,
      highRadialBandSquareMass C s q hqcompact a i ≤
        highRadialBandScaleCost B C s q a i := by
    intro i hi
    have hiThree : 3 ≤ i := (Finset.mem_Ico.mp hi).1
    simpa only [highRadialBandSquareMass, highRadialBandScaleCost,
      highRadialBandSourceEnergy] using
      (hband C s q hqcompact a i hiThree hrTime hsupport)
  calc
    (∑ i ∈ Finset.Ico 3 N,
        highRadialBandSquareMass C s q hqcompact a i) ≤
        ∑ i ∈ Finset.Ico 3 N, highRadialBandScaleCost B C s q a i := by
          exact Finset.sum_le_sum (fun i hi => hmass i hi)
    _ ≤ ((N + 1 : Nat) : ENNReal) ^ 2 *
        ENNReal.ofReal (256 * A * B) *
          ENNReal.ofReal (∫ xi : Euclidean 2,
            shiftedFiberSourceEnergy s q a xi) := by
          apply sum_highRadialBandScaleCost_le_of_card_bound hA hB C N s q a
          intro i hi
          exact hcard N i (Finset.mem_Ico.mp hi).2

end

end Auto.Spherical.MSS
end
-- END ScratchKakeyaGlobalHighRadialBandSummation

-- BEGIN ScratchKakeyaThreeBlockRadialEnergy
section

section Auto.Spherical.MSS

open Filter MeasureTheory Metric Set
open Auto.Spherical.SurfaceMeasureDecay
open Auto.LittlewoodPaley
open scoped BigOperators ENNReal EuclideanSpace

noncomputable section

noncomputable def lowThreeRadialBandSourceConstant : Real :=
  4 + 102400 * Real.pi ^ 4

theorem lowThreeRadialBandSourceConstant_pos : 0 < lowThreeRadialBandSourceConstant := by
  unfold lowThreeRadialBandSourceConstant
  positivity

noncomputable def lowThreeRadialBandCost
    {iota : Type*} (C : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (i : Nat) : ENNReal :=
  ENNReal.ofReal lowThreeRadialBandSourceConstant *
    ENNReal.ofReal (∫ xi : Euclidean 2,
      shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles C q i) a xi)

noncomputable def threeBlockRadialBandCost
    {iota : Type*} (B : Real) (C : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (i : Nat) : ENNReal :=
  if i < 3 then lowThreeRadialBandCost C s q a i else
    highRadialBandScaleCost B C s q a i

/-- The literal fixed-width low-band estimate is exactly the low component
of the three-block energy budget. -/
theorem lowThreeRadialBandSquareMass_le_cost
    {iota : Type*} (C : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex) {i : Nat} (hi : i < 3)
    {rTime : Real} (hrTime : rTime < 1)
    (hsupport : ∀ l, Function.support (a l : Real -> Complex) ⊆
      closedBall (3 / 2 : Real) rTime) :
    highRadialBandSquareMass C s q hqcompact a i ≤
      lowThreeRadialBandCost C s q a i := by
  have h := finiteTensorRadialLowThree_sourceEnergy_band_bounds C s q hqcompact a
    hrTime hsupport i (Finset.mem_range.mpr hi)
  exact h.2.trans_eq (by
    unfold lowThreeRadialBandCost
    change ENNReal.ofReal (lowThreeRadialBandSourceConstant *
      ∫ xi : Euclidean 2,
        shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles C q i) a xi) = _
    rw [ENNReal.ofReal_mul lowThreeRadialBandSourceConstant_pos.le])

/-- Any finite low block has the same source-energy overlap as the full
Littlewood--Paley family, with its fixed low-band coefficient factored out. -/
theorem sum_lowThreeRadialBandCost_le
    {iota : Type*} (C : lpCutoffs 2) (K : Finset Nat) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) :
    (∑ i ∈ K, lowThreeRadialBandCost C s q a i) ≤
      ENNReal.ofReal lowThreeRadialBandSourceConstant *
        ENNReal.ofReal (16 * ∫ xi : Euclidean 2,
          shiftedFiberSourceEnergy s q a xi) := by
  let E : Nat → ENNReal := fun i => ENNReal.ofReal (∫ xi : Euclidean 2,
    shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles C q i) a xi)
  have hsumReal :=
    sum_integral_shiftedFiberSourceEnergy_radialBandProfiles_le_sixteen
      C K s q a Set.univ
  have hsumReal' :
      (∑ i ∈ K, ∫ xi : Euclidean 2,
        shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles C q i) a xi) ≤
        16 * ∫ xi : Euclidean 2, shiftedFiberSourceEnergy s q a xi := by
    simpa using hsumReal
  have hsum : (∑ i ∈ K, E i) ≤ ENNReal.ofReal (16 * ∫ xi : Euclidean 2,
      shiftedFiberSourceEnergy s q a xi) := by
    dsimp only [E]
    rw [← ENNReal.ofReal_sum_of_nonneg]
    · exact ENNReal.ofReal_le_ofReal hsumReal'
    · intro i hi
      apply integral_nonneg
      intro xi
      exact shiftedFiberSourceEnergy_nonneg s (finiteTensorRadialBandProfiles C q i) a xi
  calc
    (∑ i ∈ K, lowThreeRadialBandCost C s q a i) =
        ENNReal.ofReal lowThreeRadialBandSourceConstant * (∑ i ∈ K, E i) := by
          simp only [lowThreeRadialBandCost, E, Finset.mul_sum]
    _ ≤ ENNReal.ofReal lowThreeRadialBandSourceConstant *
        ENNReal.ofReal (16 * ∫ xi : Euclidean 2,
          shiftedFiberSourceEnergy s q a xi) := by
          gcongr

/-- Generic three-block bookkeeping in the exact summed-energy shape used by
the finite radial narrow estimate.  The `N < 3` branch is handled directly,
so no lower bound on the radial level is required. -/
theorem threeBlock_hsummed_of_lowpass_and_highCost
    {iota : Type*} {B D C0 : Real}
    (C : lpCutoffs 2) (N : Nat) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex)
    (B0 F : ENNReal)
    (hB0 : B0 ≤ ENNReal.ofReal C0 *
      ENNReal.ofReal (∫ xi : Euclidean 2, shiftedFiberSourceEnergy s q a xi))
    (hhigh : (∑ i ∈ Finset.Ico 3 N, highRadialBandScaleCost B C s q a i) ≤
      ((N + 1 : Nat) : ENNReal) ^ 2 *
        (ENNReal.ofReal D *
          ENNReal.ofReal (∫ xi : Euclidean 2, shiftedFiberSourceEnergy s q a xi)))
    (hF : ENNReal.ofReal C0 *
        ENNReal.ofReal (∫ xi : Euclidean 2, shiftedFiberSourceEnergy s q a xi) +
        ENNReal.ofReal lowThreeRadialBandSourceConstant *
          ENNReal.ofReal (16 * ∫ xi : Euclidean 2,
            shiftedFiberSourceEnergy s q a xi) +
        ENNReal.ofReal D *
          ENNReal.ofReal (∫ xi : Euclidean 2, shiftedFiberSourceEnergy s q a xi) ≤ F ^ 2) :
    B0 + ∑ i ∈ Finset.range N, threeBlockRadialBandCost B C s q a i ≤
      ((N + 1 : Nat) : ENNReal) ^ 2 * F ^ 2 := by
  let R : ENNReal := ((N + 1 : Nat) : ENNReal) ^ 2
  let E : ENNReal := ENNReal.ofReal (∫ xi : Euclidean 2,
    shiftedFiberSourceEnergy s q a xi)
  let P : ENNReal := ENNReal.ofReal C0 * E
  let L0 : ENNReal := ENNReal.ofReal lowThreeRadialBandSourceConstant *
    ENNReal.ofReal (16 * ∫ xi : Euclidean 2, shiftedFiberSourceEnergy s q a xi)
  let H : ENNReal := ENNReal.ofReal D * E
  have hRone : 1 ≤ R := by
    dsimp only [R]
    apply one_le_pow₀
    exact_mod_cast Nat.succ_le_succ (Nat.zero_le N)
  have hP : P ≤ R * P := by
    calc
      P = 1 * P := (one_mul P).symm
      _ ≤ R * P := by gcongr
  have hL0 : L0 ≤ R * L0 := by
    calc
      L0 = 1 * L0 := (one_mul L0).symm
      _ ≤ R * L0 := by gcongr
  have hlowRange : ∀ K : Finset Nat,
      (∑ i ∈ K, lowThreeRadialBandCost C s q a i) ≤ L0 := by
    intro K
    simpa only [L0] using sum_lowThreeRadialBandCost_le C K s q a
  change B0 + ∑ i ∈ Finset.range N, threeBlockRadialBandCost B C s q a i ≤ R * F ^ 2
  change B0 ≤ P at hB0
  change (∑ i ∈ Finset.Ico 3 N, highRadialBandScaleCost B C s q a i) ≤ R * H at hhigh
  change P + L0 + H ≤ F ^ 2 at hF
  by_cases hN : 3 ≤ N
  · have hdecomp :
        (∑ i ∈ Finset.range N, threeBlockRadialBandCost B C s q a i) =
          (∑ i ∈ Finset.range 3, lowThreeRadialBandCost C s q a i) +
            ∑ i ∈ Finset.Ico 3 N, highRadialBandScaleCost B C s q a i := by
      calc
        (∑ i ∈ Finset.range N, threeBlockRadialBandCost B C s q a i) =
            (∑ i ∈ Finset.range 3, threeBlockRadialBandCost B C s q a i) +
              ∑ i ∈ Finset.Ico 3 N, threeBlockRadialBandCost B C s q a i :=
          (Finset.sum_range_add_sum_Ico (threeBlockRadialBandCost B C s q a) hN).symm
        _ = (∑ i ∈ Finset.range 3, lowThreeRadialBandCost C s q a i) +
              ∑ i ∈ Finset.Ico 3 N, threeBlockRadialBandCost B C s q a i := by
          apply congrArg (fun z => z +
            ∑ i ∈ Finset.Ico 3 N, threeBlockRadialBandCost B C s q a i)
          apply Finset.sum_congr rfl
          intro i hi
          rw [threeBlockRadialBandCost, if_pos (Finset.mem_range.mp hi)]
        _ = (∑ i ∈ Finset.range 3, lowThreeRadialBandCost C s q a i) +
              ∑ i ∈ Finset.Ico 3 N, highRadialBandScaleCost B C s q a i := by
          apply congrArg (fun z =>
            (∑ i ∈ Finset.range 3, lowThreeRadialBandCost C s q a i) + z)
          apply Finset.sum_congr rfl
          intro i hi
          rw [threeBlockRadialBandCost,
            if_neg (not_lt.mpr (Finset.mem_Ico.mp hi).1)]
    rw [hdecomp]
    have hlow := hlowRange (Finset.range 3)
    calc
      B0 + ((∑ i ∈ Finset.range 3, lowThreeRadialBandCost C s q a i) +
          ∑ i ∈ Finset.Ico 3 N, highRadialBandScaleCost B C s q a i) ≤
          P + (L0 + R * H) := by gcongr
      _ ≤ R * P + (R * L0 + R * H) := by gcongr
      _ = R * (P + L0 + H) := by ring
      _ ≤ R * F ^ 2 := by gcongr
  · have hNlt : N < 3 := by omega
    have hdecomp :
        (∑ i ∈ Finset.range N, threeBlockRadialBandCost B C s q a i) =
          ∑ i ∈ Finset.range N, lowThreeRadialBandCost C s q a i := by
      apply Finset.sum_congr rfl
      intro i hi
      rw [threeBlockRadialBandCost, if_pos]
      exact lt_trans (Finset.mem_range.mp hi) hNlt
    rw [hdecomp]
    have hlow := hlowRange (Finset.range N)
    calc
      B0 + ∑ i ∈ Finset.range N, lowThreeRadialBandCost C s q a i ≤ P + L0 := by
        gcongr
      _ ≤ R * P + R * L0 := by gcongr
      _ ≤ R * P + R * L0 + R * H := by
        exact le_add_of_nonneg_right (by positivity)
      _ = R * (P + L0 + H) := by ring
      _ ≤ R * F ^ 2 := by gcongr

/-- Select one high-band cost before all tensor data, and combine it with the
concrete low-three estimates into both the individual `Bband` bounds and the
summed-energy premise required by finite radial reassembly. -/
theorem exists_global_threeBlock_cost_family_and_hsummed :
    ∃ B D : Real, 0 < B ∧ 0 < D ∧
      ∀ {iota : Type*} (C : lpCutoffs 2) (N : Nat) (s : Finset iota)
        (q : iota -> SchwartzMap (Euclidean 2) Complex)
        (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
        (a : iota -> SchwartzMap Real Complex) {rTime : Real}, rTime < 1 →
          (∀ l, Function.support (a l : Real -> Complex) ⊆
            closedBall (3 / 2 : Real) rTime) →
          (∀ i ∈ Finset.range N,
            highRadialBandSquareMass C s q hqcompact a i ≤
              threeBlockRadialBandCost B C s q a i) ∧
          ∀ (C0 : Real) (B0 F : ENNReal),
            B0 ≤ ENNReal.ofReal C0 *
              ENNReal.ofReal (∫ xi : Euclidean 2,
                shiftedFiberSourceEnergy s q a xi) →
            ENNReal.ofReal C0 *
                ENNReal.ofReal (∫ xi : Euclidean 2,
                  shiftedFiberSourceEnergy s q a xi) +
                ENNReal.ofReal lowThreeRadialBandSourceConstant *
                  ENNReal.ofReal (16 * ∫ xi : Euclidean 2,
                    shiftedFiberSourceEnergy s q a xi) +
                ENNReal.ofReal D *
                  ENNReal.ofReal (∫ xi : Euclidean 2,
                    shiftedFiberSourceEnergy s q a xi) ≤ F ^ 2 →
            B0 + ∑ i ∈ Finset.range N, threeBlockRadialBandCost B C s q a i ≤
              ((N + 1 : Nat) : ENNReal) ^ 2 * F ^ 2 := by
  rcases exists_highRadialBand_shell_card_sq_le_bandCount_sq with ⟨A, hA, hcard⟩
  rcases exists_global_kakeyaRadialBandPhysicalField_uniform_narrow_scaleCost_bound with
    ⟨B, hB, hhighBand⟩
  refine ⟨B, 256 * A * B, hB, by positivity, ?_⟩
  intro iota C N s q hqcompact a rTime hrTime hsupport
  constructor
  · intro i hi
    by_cases hiLow : i < 3
    · rw [threeBlockRadialBandCost, if_pos hiLow]
      exact lowThreeRadialBandSquareMass_le_cost C s q hqcompact a hiLow hrTime hsupport
    · have hiHigh : 3 ≤ i := not_lt.mp hiLow
      rw [threeBlockRadialBandCost, if_neg hiLow]
      simpa only [highRadialBandSquareMass, highRadialBandScaleCost,
        highRadialBandSourceEnergy] using
        (hhighBand C s q hqcompact a i hiHigh hrTime hsupport)
  · intro C0 B0 F hB0 hF
    apply threeBlock_hsummed_of_lowpass_and_highCost (B := B)
      (D := 256 * A * B) (C0 := C0) C N s q a B0 F hB0
    · simpa only [mul_assoc] using
        (sum_highRadialBandScaleCost_le_of_card_bound hA hB C N s q a
          (fun i hi => hcard N i (Finset.mem_Ico.mp hi).2))
    · exact hF
end

end Auto.Spherical.MSS
end
