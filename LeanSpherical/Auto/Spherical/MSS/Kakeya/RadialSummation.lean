open scoped ENNReal

/-! A small scalar closure for the three-block radial budget.  Keeping this
separate from the harmonic-analysis files makes the eventual choice of the
square-root energy factor completely explicit. -/

theorem budget_ofReal_mul_rpow_half
    {C0 L D E K : Real}
    (hC0 : 0 ≤ C0) (hL : 0 ≤ L) (hD : 0 ≤ D) (hE : 0 ≤ E)
    (hKone : 1 ≤ K) (hcoeff : C0 + 16 * L + D ≤ K) :
    ENNReal.ofReal C0 * ENNReal.ofReal E +
        ENNReal.ofReal L * ENNReal.ofReal (16 * E) +
        ENNReal.ofReal D * ENNReal.ofReal E ≤
      (ENNReal.ofReal K *
        (ENNReal.ofReal E) ^ ((2 : Real)⁻¹)) ^ 2 := by
  have h16E : 0 ≤ 16 * E := by positivity
  have hC0E : 0 ≤ C0 * E := mul_nonneg hC0 hE
  have hL16E : 0 ≤ L * (16 * E) := mul_nonneg hL h16E
  have hDE : 0 ≤ D * E := mul_nonneg hD hE
  have hsum : 0 ≤ C0 + 16 * L + D := by positivity
  have hlhs :
      ENNReal.ofReal C0 * ENNReal.ofReal E +
          ENNReal.ofReal L * ENNReal.ofReal (16 * E) +
          ENNReal.ofReal D * ENNReal.ofReal E =
        ENNReal.ofReal (C0 + 16 * L + D) * ENNReal.ofReal E := by
    rw [← ENNReal.ofReal_mul hC0, ← ENNReal.ofReal_mul hL,
      ← ENNReal.ofReal_mul hD]
    rw [← ENNReal.ofReal_add hC0E hL16E,
      ← ENNReal.ofReal_add (add_nonneg hC0E hL16E) hDE]
    rw [show C0 * E + L * (16 * E) + D * E =
      (C0 + 16 * L + D) * E by ring]
    exact ENNReal.ofReal_mul hsum
  have hroot :
      ((ENNReal.ofReal E) ^ ((2 : Real)⁻¹)) ^ 2 = ENNReal.ofReal E := by
    rw [← ENNReal.rpow_natCast]
    rw [← ENNReal.rpow_mul]
    norm_num
  have hKone' : 1 ≤ ENNReal.ofReal K := by
    simpa using (ENNReal.ofReal_le_ofReal hKone)
  have hKsq : ENNReal.ofReal K ≤ (ENNReal.ofReal K) ^ 2 := by
    calc
      ENNReal.ofReal K = 1 * ENNReal.ofReal K := (one_mul _).symm
      _ ≤ ENNReal.ofReal K * ENNReal.ofReal K :=
        mul_le_mul_left hKone' _
      _ = (ENNReal.ofReal K) ^ 2 := by ring
  have hFsq :
      (ENNReal.ofReal K * (ENNReal.ofReal E) ^ ((2 : Real)⁻¹)) ^ 2 =
        (ENNReal.ofReal K) ^ 2 * ENNReal.ofReal E := by
    rw [mul_pow, hroot]
  calc
    ENNReal.ofReal C0 * ENNReal.ofReal E +
        ENNReal.ofReal L * ENNReal.ofReal (16 * E) +
        ENNReal.ofReal D * ENNReal.ofReal E =
        ENNReal.ofReal (C0 + 16 * L + D) * ENNReal.ofReal E := hlhs
    _ ≤ ENNReal.ofReal K * ENNReal.ofReal E := by
      exact mul_le_mul_left (ENNReal.ofReal_le_ofReal hcoeff) _
    _ ≤ (ENNReal.ofReal K) ^ 2 * ENNReal.ofReal E :=
      mul_le_mul_left hKsq _
    _ = (ENNReal.ofReal K *
        (ENNReal.ofReal E) ^ ((2 : Real)⁻¹)) ^ 2 := hFsq.symm

/-- A deliberately loose but uniform coefficient: the extra `1` makes its
square dominate the three source-energy coefficients without square roots. -/
theorem exists_budget_factor_of_nonneg
    {C0 L D E : Real}
    (hC0 : 0 ≤ C0) (hL : 0 ≤ L) (hD : 0 ≤ D) (hE : 0 ≤ E) :
    ∃ K : Real, 0 < K ∧
      ENNReal.ofReal C0 * ENNReal.ofReal E +
          ENNReal.ofReal L * ENNReal.ofReal (16 * E) +
          ENNReal.ofReal D * ENNReal.ofReal E ≤
        (ENNReal.ofReal K *
          (ENNReal.ofReal E) ^ ((2 : Real)⁻¹)) ^ 2 := by
  let K : Real := 1 + C0 + 16 * L + D
  have hKone : 1 ≤ K := by
    dsimp only [K]
    linarith
  have hcoeff : C0 + 16 * L + D ≤ K := by
    dsimp only [K]
    linarith
  refine ⟨K, lt_of_lt_of_le (by norm_num) hKone,
    budget_ofReal_mul_rpow_half hC0 hL hD hE hKone hcoeff⟩

/-- The precise scalar premise expected by
`threeBlock_hsummed_of_lowpass_and_highCost`, with its fixed low-three
coefficient. -/
theorem exists_threeBlock_budget_factor
    {C0 D E : Real}
    (hC0 : 0 ≤ C0) (hD : 0 ≤ D) (hE : 0 ≤ E) :
    ∃ K : Real, 0 < K ∧
      ENNReal.ofReal C0 * ENNReal.ofReal E +
          ENNReal.ofReal
              lowThreeRadialBandSourceConstant *
            ENNReal.ofReal (16 * E) +
          ENNReal.ofReal D * ENNReal.ofReal E ≤
        (ENNReal.ofReal K *
          (ENNReal.ofReal E) ^ ((2 : Real)⁻¹)) ^ 2 := by
  exact exists_budget_factor_of_nonneg hC0
    lowThreeRadialBandSourceConstant_pos.le hD hE

