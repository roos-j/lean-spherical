section Auto.Spherical.MSS

open Filter MeasureTheory Metric Set
open Auto.Spherical.SurfaceMeasureDecay
open scoped BigOperators

noncomputable section

/-- A finite frequency fibre time datum retains the common compact temporal
support of its tensor factors. -/
theorem support_scratch_finiteTensorTimeData_subset_innerSlab
    {ι : Type*} (s : Finset ι)
    (q : ι -> SchwartzMap (Euclidean 2) Complex)
    (a : ι -> SchwartzMap Real Complex) (xi : Euclidean 2)
    {r : Real}
    (ha : ∀ i, Function.support (a i : Real -> Complex) ⊆
      closedBall (3 / 2 : Real) r) :
    Function.support (scratch_finiteTensorTimeData s q a xi) ⊆
      closedBall (3 / 2 : Real) r := by
  intro t ht
  by_contra hball
  have hzero : ∀ i ∈ s, a i t = 0 := by
    intro i hi
    by_contra hne
    apply hball
    apply ha i
    simpa only [Function.mem_support] using hne
  have hsum : scratch_finiteTensorTimeData s q a xi t = 0 := by
    unfold scratch_finiteTensorTimeData
    apply Finset.sum_eq_zero
    intro i hi
    rw [hzero i hi, mul_zero]
  exact ht hsum

/-- The compact inner-slab tensor core supplies the weighted profile needed
for the literal phase derivative, at a uniform `25/4` `L²` cost. -/
theorem integrable_norm_sq_timeWeighted_scratch_finiteTensorTimeData_and_integral_le
    {ι : Type*} (s : Finset ι)
    (q : ι -> SchwartzMap (Euclidean 2) Complex)
    (a : ι -> SchwartzMap Real Complex) (xi : Euclidean 2)
    {r : Real} (hr : r < 1)
    (ha : ∀ i, Function.support (a i : Real -> Complex) ⊆
      closedBall (3 / 2 : Real) r)
    (hHsq : Integrable (fun t : Real =>
      ‖scratch_finiteTensorTimeData s q a xi t‖ ^ 2) volume) :
    Integrable (fun t : Real =>
      ‖timeWeighted (scratch_finiteTensorTimeData s q a xi) t‖ ^ 2) volume ∧
      (∫ t : Real,
        ‖timeWeighted (scratch_finiteTensorTimeData s q a xi) t‖ ^ 2) ≤
        (5 / 2 : Real) ^ 2 *
          ∫ t : Real, ‖scratch_finiteTensorTimeData s q a xi t‖ ^ 2 := by
  apply integrable_norm_sq_timeWeighted_and_integral_le
    (scratch_finiteTensorTimeData s q a xi) hr
  · exact support_scratch_finiteTensorTimeData_subset_innerSlab s q a xi ha
  · exact hHsq

end

end Auto.Spherical.MSS
