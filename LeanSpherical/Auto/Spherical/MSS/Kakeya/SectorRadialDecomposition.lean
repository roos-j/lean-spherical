section

section Auto.Spherical.MSS

open Filter MeasureTheory FourierTransform Set
open Auto.Spherical.SurfaceMeasureDecay
open Auto.LittlewoodPaley
open scoped BigOperators Convolution FourierTransform ENNReal EuclideanSpace Pointwise

noncomputable section

/-- The literal physical field obtained by inverse Fourier transform of a
parameterized compact multiplier. -/
noncomputable def kakeyaRadialPhysicalField
    {Theta : Type*} (m : Theta → SchwartzMap (Euclidean 2) Complex)
    (theta : Theta) (x : Euclidean 2) : Complex :=
  FourierTransform.fourierInv (m theta) x

/-- The physical low-frequency residual. -/
noncomputable def kakeyaRadialLowpassPhysicalField
    {Theta : Type*} (C : lpCutoffs 2)
    (m : Theta → SchwartzMap (Euclidean 2) Complex)
    (theta : Theta) (x : Euclidean 2) : Complex :=
  FourierTransform.fourierInv (kakeyaRadialLowpassPiece C (m theta)) x

/-- The physical field of the `i`th homogeneous positive radial band. -/
noncomputable def kakeyaRadialBandPhysicalField
    {Theta : Type*} (C : lpCutoffs 2)
    (m : Theta → SchwartzMap (Euclidean 2) Complex)
    (i : Nat) (theta : Theta) (x : Euclidean 2) : Complex :=
  FourierTransform.fourierInv (kakeyaRadialBandPiece C (m theta) i) x

/-- A single finite index family: the last index stores the lowpass
residual, and all prior indices store the corresponding homogeneous band. -/
noncomputable def kakeyaRadialPhysicalIndexedPiece
    {Theta : Type*} (C : lpCutoffs 2)
    (m : Theta → SchwartzMap (Euclidean 2) Complex)
    (rho : Real) (i : Nat) (theta : Theta) (x : Euclidean 2) : Complex :=
  if i = kakeyaRadialBandLevel rho then
    kakeyaRadialLowpassPhysicalField C m theta x
  else
    kakeyaRadialBandPhysicalField C m i theta x

/-- Exact physical reassembly into the `L + 1` indexed radial family, where
`L = kakeyaRadialBandLevel rho`. -/
theorem kakeyaRadialPhysicalField_reassembly_indexed
    {Theta : Type*} (C : lpCutoffs 2)
    (m : Theta → SchwartzMap (Euclidean 2) Complex)
    {rho : Real} (hrho : 0 < rho)
    (hsupp : ∀ theta, Set.Subset (Function.support (m theta :
      Euclidean 2 → Complex)) (Metric.closedBall 0 (4 / rho)))
    (theta : Theta) (x : Euclidean 2) :
    kakeyaRadialPhysicalField m theta x =
      ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho + 1),
        kakeyaRadialPhysicalIndexedPiece C m rho i theta x := by
  let L := kakeyaRadialBandLevel rho
  have hphysical := kakeyaRadialPhysical_reassembly C (m theta) hrho
    (hsupp theta) x
  change FourierTransform.fourierInv (m theta) x = _
  rw [hphysical]
  have hsum : ∑ i ∈ Finset.range L,
      kakeyaRadialPhysicalIndexedPiece C m rho i theta x =
      ∑ i ∈ Finset.range L,
        FourierTransform.fourierInv (kakeyaRadialBandPiece C (m theta) i) x := by
    apply Finset.sum_congr rfl
    intro i hi
    unfold kakeyaRadialPhysicalIndexedPiece
    rw [if_neg (ne_of_lt (Finset.mem_range.mp hi))]
    rfl
  have hlast : kakeyaRadialPhysicalIndexedPiece C m rho L theta x =
      FourierTransform.fourierInv (kakeyaRadialLowpassPiece C (m theta)) x := by
    unfold kakeyaRadialPhysicalIndexedPiece
    rw [if_pos rfl]
    rfl
  calc
    FourierTransform.fourierInv (kakeyaRadialLowpassPiece C (m theta)) x +
        ∑ i ∈ Finset.range L,
          FourierTransform.fourierInv (kakeyaRadialBandPiece C (m theta) i) x =
        (∑ i ∈ Finset.range L,
          kakeyaRadialPhysicalIndexedPiece C m rho i theta x) +
          kakeyaRadialPhysicalIndexedPiece C m rho L theta x := by
      rw [hsum, hlast]
      exact add_comm _ _
    _ = ∑ i ∈ Finset.range (L + 1),
        kakeyaRadialPhysicalIndexedPiece C m rho i theta x := by
      rw [Finset.sum_range_succ]

/-- Finite Cauchy--Schwarz/Tonelli for the exact radial physical
reassembly.  This theorem deliberately leaves every indexed local maximal
estimate as an explicit hypothesis. -/
theorem lintegral_iSup_sq_kakeyaRadialPhysicalField_le_of_indexed_bounds
    {Theta : Type*} (C : lpCutoffs 2)
    (m : Theta → SchwartzMap (Euclidean 2) Complex)
    {rho : Real} (hrho : 0 < rho)
    (hsupp : ∀ theta, Set.Subset (Function.support (m theta :
      Euclidean 2 → Complex)) (Metric.closedBall 0 (4 / rho)))
    (B : Nat → ENNReal)
    (hpieceMeas : ∀ i ∈ Finset.range (kakeyaRadialBandLevel rho + 1),
      Measurable (fun x : Euclidean 2 =>
        ⨆ theta : Theta, ENNReal.ofReal
          (‖kakeyaRadialPhysicalIndexedPiece C m rho i theta x‖ ^ 2)))
    (hpieceBound : ∀ i ∈ Finset.range (kakeyaRadialBandLevel rho + 1),
      (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialPhysicalIndexedPiece C m rho i theta x‖ ^ 2)) ≤ B i) :
    (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
      (‖kakeyaRadialPhysicalField m theta x‖ ^ 2)) ≤
      ((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) *
        ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho + 1), B i := by
  have h := lintegral_iSup_sq_finite_shell_sum_le_of_bounds
    (Theta := Theta) (X := Euclidean 2) volume
    (Finset.range (kakeyaRadialBandLevel rho + 1))
    (fun theta x => kakeyaRadialPhysicalField m theta x)
    (fun i theta x => kakeyaRadialPhysicalIndexedPiece C m rho i theta x)
    B
    (fun theta x =>
      kakeyaRadialPhysicalField_reassembly_indexed C m hrho hsupp theta x)
    hpieceMeas hpieceBound
  simpa only [Finset.card_range] using h

/-- The energy label for the indexed family: the terminal index is the
lowpass residual and every preceding label is the matching homogeneous-band
energy. -/
noncomputable def kakeyaRadialLowpassBandEnergyBound
    (rho : Real) (B0 : ENNReal) (Bband : Nat → ENNReal) (i : Nat) : ENNReal :=
  if i = kakeyaRadialBandLevel rho then B0 else Bband i

theorem sum_kakeyaRadialLowpassBandEnergyBound
    (rho : Real) (B0 : ENNReal) (Bband : Nat → ENNReal) :
    ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho + 1),
      kakeyaRadialLowpassBandEnergyBound rho B0 Bband i =
        (∑ i ∈ Finset.range (kakeyaRadialBandLevel rho), Bband i) + B0 := by
  rw [Finset.sum_range_succ]
  congr 1
  · apply Finset.sum_congr rfl
    intro i hi
    unfold kakeyaRadialLowpassBandEnergyBound
    rw [if_neg (ne_of_lt (Finset.mem_range.mp hi))]
  · unfold kakeyaRadialLowpassBandEnergyBound
    rw [if_pos rfl]

/-- The concrete lowpass-plus-bands form of finite radial maximal
reassembly.  The only analytic input is a supplied maximal-square bound for
the low residual and for every active homogeneous band. -/
theorem lintegral_iSup_sq_kakeyaRadialPhysicalField_le_lowpass_and_band_bounds
    {Theta : Type*} (C : lpCutoffs 2)
    (m : Theta → SchwartzMap (Euclidean 2) Complex)
    {rho : Real} (hrho : 0 < rho)
    (hsupp : ∀ theta, Set.Subset (Function.support (m theta :
      Euclidean 2 → Complex)) (Metric.closedBall 0 (4 / rho)))
    (B0 : ENNReal) (Bband : Nat → ENNReal)
    (hlowMeas : Measurable (fun x : Euclidean 2 =>
      ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialLowpassPhysicalField C m theta x‖ ^ 2)))
    (hbandMeas : ∀ i ∈ Finset.range (kakeyaRadialBandLevel rho),
      Measurable (fun x : Euclidean 2 =>
        ⨆ theta : Theta, ENNReal.ofReal
          (‖kakeyaRadialBandPhysicalField C m i theta x‖ ^ 2)))
    (hlowBound :
      (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialLowpassPhysicalField C m theta x‖ ^ 2)) ≤ B0)
    (hbandBound : ∀ i ∈ Finset.range (kakeyaRadialBandLevel rho),
      (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialBandPhysicalField C m i theta x‖ ^ 2)) ≤ Bband i) :
    (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
      (‖kakeyaRadialPhysicalField m theta x‖ ^ 2)) ≤
      ((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) *
        (B0 + ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho), Bband i) := by
  let L := kakeyaRadialBandLevel rho
  let B := kakeyaRadialLowpassBandEnergyBound rho B0 Bband
  have hmeas : ∀ i ∈ Finset.range (L + 1),
      Measurable (fun x : Euclidean 2 =>
        ⨆ theta : Theta, ENNReal.ofReal
          (‖kakeyaRadialPhysicalIndexedPiece C m rho i theta x‖ ^ 2)) := by
    intro i hi
    by_cases hlast : i = L
    · subst i
      simpa only [L, kakeyaRadialPhysicalIndexedPiece, if_pos,
        kakeyaRadialLowpassPhysicalField] using hlowMeas
    · have hlt : i < L := by
        have hle := Finset.mem_range.mp hi
        omega
      simpa only [L, kakeyaRadialPhysicalIndexedPiece, if_neg hlast,
        kakeyaRadialBandPhysicalField] using
        hbandMeas i (Finset.mem_range.mpr hlt)
  have hbound : ∀ i ∈ Finset.range (L + 1),
      (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialPhysicalIndexedPiece C m rho i theta x‖ ^ 2)) ≤ B i := by
    intro i hi
    by_cases hlast : i = L
    · subst i
      simpa only [B, L, kakeyaRadialLowpassBandEnergyBound,
        kakeyaRadialPhysicalIndexedPiece, if_pos,
        kakeyaRadialLowpassPhysicalField] using hlowBound
    · have hlt : i < L := by
        have hle := Finset.mem_range.mp hi
        omega
      simpa only [B, L, kakeyaRadialLowpassBandEnergyBound,
        kakeyaRadialPhysicalIndexedPiece, if_neg hlast,
        kakeyaRadialBandPhysicalField] using
        hbandBound i (Finset.mem_range.mpr hlt)
  have h := lintegral_iSup_sq_kakeyaRadialPhysicalField_le_of_indexed_bounds
    C m hrho hsupp B (by simpa only [L] using hmeas)
    (by simpa only [L] using hbound)
  calc
    (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
      (‖kakeyaRadialPhysicalField m theta x‖ ^ 2)) ≤
        ((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) *
          ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho + 1), B i := h
    _ = ((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) *
        (B0 + ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho), Bband i) := by
      rw [show (∑ i ∈ Finset.range (kakeyaRadialBandLevel rho + 1), B i) =
          (∑ i ∈ Finset.range (kakeyaRadialBandLevel rho), Bband i) + B0 by
        simpa only [B] using sum_kakeyaRadialLowpassBandEnergyBound rho B0 Bband]
      rw [add_comm (∑ i ∈ Finset.range (kakeyaRadialBandLevel rho), Bband i) B0]

/-- With one common analytic maximal-square bound for the low residual and
every band, finite reassembly costs the square of the number of physical
pieces. -/
theorem lintegral_iSup_sq_kakeyaRadialPhysicalField_le_uniform
    {Theta : Type*} (C : lpCutoffs 2)
    (m : Theta → SchwartzMap (Euclidean 2) Complex)
    {rho : Real} (hrho : 0 < rho)
    (hsupp : ∀ theta, Set.Subset (Function.support (m theta :
      Euclidean 2 → Complex)) (Metric.closedBall 0 (4 / rho)))
    (B : ENNReal)
    (hlowMeas : Measurable (fun x : Euclidean 2 =>
      ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialLowpassPhysicalField C m theta x‖ ^ 2)))
    (hbandMeas : ∀ i ∈ Finset.range (kakeyaRadialBandLevel rho),
      Measurable (fun x : Euclidean 2 =>
        ⨆ theta : Theta, ENNReal.ofReal
          (‖kakeyaRadialBandPhysicalField C m i theta x‖ ^ 2)))
    (hlowBound :
      (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialLowpassPhysicalField C m theta x‖ ^ 2)) ≤ B)
    (hbandBound : ∀ i ∈ Finset.range (kakeyaRadialBandLevel rho),
      (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialBandPhysicalField C m i theta x‖ ^ 2)) ≤ B) :
    (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
      (‖kakeyaRadialPhysicalField m theta x‖ ^ 2)) ≤
      ((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) ^ 2 * B := by
  have h := lintegral_iSup_sq_kakeyaRadialPhysicalField_le_lowpass_and_band_bounds
    C m hrho hsupp B (fun _ => B) hlowMeas hbandMeas hlowBound
    (by
      intro i hi
      exact hbandBound i hi)
  calc
    (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
      (‖kakeyaRadialPhysicalField m theta x‖ ^ 2)) ≤
        ((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) *
          (B + ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho), B) := h
    _ = ((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) ^ 2 * B := by
      simp [pow_two, mul_assoc]
      ring

/-- The cardinality of the radial lowpass-plus-bands family is logarithmic
in the reciprocal width. -/
theorem exists_kakeyaRadialPhysicalPieces_card_log_bound :
    ∃ A : Real, 0 < A ∧ ∀ rho : Real, 0 < rho → rho ≤ 1 →
      ((Finset.range (kakeyaRadialBandLevel rho + 1)).card : Real) ≤
        A * (1 + |Real.log rho|) := by
  rcases exists_kakeyaRadialBandLevel_log_bound with ⟨A, hApos, hA⟩
  refine ⟨A, hApos, ?_⟩
  intro rho hrho hrhoOne
  simpa only [Finset.card_range, Nat.cast_add, Nat.cast_one] using
    hA rho hrho hrhoOne

/-- Consequently the square loss in the uniform Cauchy/Tonelli estimate is
at worst quadratic logarithmic in the reciprocal width. -/
theorem exists_kakeyaRadialPhysicalPieces_card_sq_log_sq_bound :
    ∃ A : Real, 0 < A ∧ ∀ rho : Real, 0 < rho → rho ≤ 1 →
      (((Finset.range (kakeyaRadialBandLevel rho + 1)).card : Real) ^ 2) ≤
        A * (1 + |Real.log rho|) ^ 2 := by
  rcases exists_kakeyaRadialPhysicalPieces_card_log_bound with ⟨A, hApos, hA⟩
  refine ⟨A ^ 2, sq_pos_of_pos hApos, ?_⟩
  intro rho hrho hrhoOne
  have hcard := hA rho hrho hrhoOne
  have hlog : 0 ≤ 1 + |Real.log rho| := by positivity
  have hcardNonneg : 0 ≤
      ((Finset.range (kakeyaRadialBandLevel rho + 1)).card : Real) := by
    positivity
  nlinarith [sq_nonneg
    (((Finset.range (kakeyaRadialBandLevel rho + 1)).card : Real) -
      A * (1 + |Real.log rho|))]

end

end Auto.Spherical.MSS
end
-- END ScratchKakeyaFiniteRadialPhysicalMaxReassembly

