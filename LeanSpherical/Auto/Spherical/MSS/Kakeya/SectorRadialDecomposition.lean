section Auto.Spherical.MSS

open Filter MeasureTheory FourierTransform Set
open Auto.Spherical.SurfaceMeasureDecay
open Auto.LittlewoodPaley
open SmoothAngularFrequencyChartFamily
open scoped BigOperators Convolution FourierTransform EuclideanSpace Pointwise

noncomputable section

/-- The retained central low-frequency contribution in the finite radial
decomposition.  It is kept separate because a ball-supported multiplier need
not vanish at the origin. -/
noncomputable def kakeyaRadialLowpassPiece
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex
    (intDyadicLowpassMultiplier C.cutoff 0 : Euclidean 2 → Complex) m

/-- The `i`th positive integer homogeneous radial frequency piece. -/
noncomputable def kakeyaRadialBandPiece
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex) (i : Nat) :
    SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex
    (intDyadicBandpassMultiplier C.cutoff ((0 : Int) + i) :
      Euclidean 2 → Complex) m

theorem kakeyaRadialLowpassPiece_apply
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex)
    (xi : Euclidean 2) :
    kakeyaRadialLowpassPiece C m xi =
      intDyadicLowpassMultiplier C.cutoff 0 xi * m xi := by
  unfold kakeyaRadialLowpassPiece
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (intDyadicLowpassMultiplier C.cutoff 0).hasTemperateGrowth]
  simp only [smul_eq_mul]

theorem kakeyaRadialBandPiece_apply
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex) (i : Nat)
    (xi : Euclidean 2) :
    kakeyaRadialBandPiece C m i xi =
      intDyadicBandpassMultiplier C.cutoff ((0 : Int) + i) xi * m xi := by
  unfold kakeyaRadialBandPiece
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (intDyadicBandpassMultiplier C.cutoff ((0 : Int) + i)).hasTemperateGrowth]
  simp only [smul_eq_mul]

/-- The radial carrier frequency associated with the `i`th band.  Its active
annulus is `[lambda / 2, 2 lambda] = [2^i, 2^(i+2)]`. -/
noncomputable def kakeyaRadialBandScale (i : Nat) : Real :=
  (2 : Real) ^ (i + 1)

theorem kakeyaRadialBandScale_pos (i : Nat) :
    0 < kakeyaRadialBandScale i := by
  unfold kakeyaRadialBandScale
  positivity

/-- The finite homogeneous family has exactly the prescribed logarithmic
number of bands; the lowpass residual is an additional single piece. -/
theorem kakeyaRadialBand_count (rho : Real) :
    (Finset.range (kakeyaRadialBandLevel rho)).card =
      kakeyaRadialBandLevel rho := by
  exact Finset.card_range _

theorem kakeyaRadialBandScale_half (i : Nat) :
    kakeyaRadialBandScale i / 2 = (2 : Real) ^ i := by
  unfold kakeyaRadialBandScale
  rw [pow_succ]
  ring

theorem two_mul_kakeyaRadialBandScale (i : Nat) :
    2 * kakeyaRadialBandScale i = (2 : Real) ^ (i + 2) := by
  unfold kakeyaRadialBandScale
  have h : i + 2 = (i + 1) + 1 := by omega
  rw [h, pow_succ]
  ring

/-- A compact multiplier supported in the ball `|xi| <= 4 / rho` has an
exact finite radial Littlewood--Paley decomposition at the explicit
logarithmic level `kakeyaRadialBandLevel rho`. -/
theorem kakeyaRadialMultiplier_reassembly
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex)
    {rho : Real} (hrho : 0 < rho)
    (hsupp : Set.Subset (Function.support (m : Euclidean 2 → Complex))
      (Metric.closedBall 0 (4 / rho)))
    (xi : Euclidean 2) :
    m xi = kakeyaRadialLowpassPiece C m xi +
      ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho),
        kakeyaRadialBandPiece C m i xi := by
  have hsuppLevel : Set.Subset (Function.support (m : Euclidean 2 → Complex))
      (Metric.closedBall 0 ((2 : Real) ^
        ((0 : Int) + kakeyaRadialBandLevel rho))) := by
    intro z hz
    rw [Metric.mem_closedBall, dist_zero_right]
    have hsupport := hsupp hz
    rw [Metric.mem_closedBall, dist_zero_right] at hsupport
    calc
      ‖z‖ ≤ 4 / rho := hsupport
      _ ≤ (2 : Real) ^ (kakeyaRadialBandLevel rho) :=
        four_div_rho_le_two_pow_kakeyaRadialBandLevel hrho
      _ = (2 : Real) ^ ((0 : Int) + kakeyaRadialBandLevel rho) := by norm_num
  simpa only [kakeyaRadialLowpassPiece_apply, kakeyaRadialBandPiece_apply] using
    (scratch_bandlimitedMultiplier_eq_lowpass_add_finiteBands C m 0
      (kakeyaRadialBandLevel rho) hsuppLevel xi)

/-- Schwartz-map form of the finite radial multiplier reassembly. -/
theorem kakeyaRadialMultiplier_reassembly_schwartz
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex)
    {rho : Real} (hrho : 0 < rho)
    (hsupp : Set.Subset (Function.support (m : Euclidean 2 → Complex))
      (Metric.closedBall 0 (4 / rho))) :
    m = kakeyaRadialLowpassPiece C m +
      ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho),
        kakeyaRadialBandPiece C m i := by
  ext xi
  rw [add_apply, sum_apply]
  exact kakeyaRadialMultiplier_reassembly C m hrho hsupp xi

/-- The corresponding physical-space inverse-Fourier reassembly, still as
an equality of Schwartz maps. -/
theorem kakeyaRadialPhysical_reassembly_schwartz
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex)
    {rho : Real} (hrho : 0 < rho)
    (hsupp : Set.Subset (Function.support (m : Euclidean 2 → Complex))
      (Metric.closedBall 0 (4 / rho))) :
    FourierTransform.fourierInv m =
      FourierTransform.fourierInv (kakeyaRadialLowpassPiece C m) +
        ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho),
          FourierTransform.fourierInv (kakeyaRadialBandPiece C m i) := by
  calc
    FourierTransform.fourierInv m =
        FourierTransform.fourierInv
          (kakeyaRadialLowpassPiece C m +
            ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho),
              kakeyaRadialBandPiece C m i) :=
      congrArg FourierTransform.fourierInv
        (kakeyaRadialMultiplier_reassembly_schwartz C m hrho hsupp)
    _ = _ := by
      rw [FourierTransform.fourierInv_add, FourierTransform.fourierInv_sum]

/-- Pointwise physical-space version of the inverse-Fourier reassembly. -/
theorem kakeyaRadialPhysical_reassembly
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex)
    {rho : Real} (hrho : 0 < rho)
    (hsupp : Set.Subset (Function.support (m : Euclidean 2 → Complex))
      (Metric.closedBall 0 (4 / rho)))
    (x : Euclidean 2) :
    FourierTransform.fourierInv m x =
      FourierTransform.fourierInv (kakeyaRadialLowpassPiece C m) x +
        ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho),
          FourierTransform.fourierInv (kakeyaRadialBandPiece C m i) x := by
  have h := congrArg (fun q : SchwartzMap (Euclidean 2) Complex => q x)
    (kakeyaRadialPhysical_reassembly_schwartz C m hrho hsupp)
  simpa only [add_apply, sum_apply] using h

/-- The canonical compact tube multiplier has the generic finite radial
reassembly without any extra support argument. -/
theorem scratch_canonicalBandlimitedTube_kakeyaRadial_reassembly
    (C : lpCutoffs 2) {rho : Real} (hrho : 0 < rho)
    (xi : Euclidean 2) :
    scratch_canonicalBandlimitedTubeMultiplier rho hrho xi =
      kakeyaRadialLowpassPiece C
        (scratch_canonicalBandlimitedTubeMultiplier rho hrho) xi +
      ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho),
        kakeyaRadialBandPiece C
          (scratch_canonicalBandlimitedTubeMultiplier rho hrho) i xi := by
  exact kakeyaRadialMultiplier_reassembly C
    (scratch_canonicalBandlimitedTubeMultiplier rho hrho) hrho
    (support_scratch_canonicalBandlimitedTubeMultiplier_subset hrho) xi

/-- Physical inverse-Fourier form of the canonical multiplier’s finite
radial reassembly. -/
theorem scratch_canonicalBandlimitedTube_kakeyaRadialPhysical_reassembly
    (C : lpCutoffs 2) {rho : Real} (hrho : 0 < rho)
    (x : Euclidean 2) :
    FourierTransform.fourierInv (scratch_canonicalBandlimitedTubeMultiplier rho hrho) x =
      FourierTransform.fourierInv
        (kakeyaRadialLowpassPiece C
          (scratch_canonicalBandlimitedTubeMultiplier rho hrho)) x +
      ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho),
        FourierTransform.fourierInv
          (kakeyaRadialBandPiece C
            (scratch_canonicalBandlimitedTubeMultiplier rho hrho) i) x := by
  exact kakeyaRadialPhysical_reassembly C
    (scratch_canonicalBandlimitedTubeMultiplier rho hrho) hrho
    (support_scratch_canonicalBandlimitedTubeMultiplier_subset hrho) x

/-- The low residual is confined to the fixed central ball of radius two. -/
theorem support_kakeyaRadialLowpassPiece_subset_closedBall_two
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex) :
    Set.Subset (Function.support (kakeyaRadialLowpassPiece C m :
      Euclidean 2 → Complex)) (Metric.closedBall 0 2) := by
  intro xi hxi
  rw [Metric.mem_closedBall, dist_zero_right]
  by_contra hnot
  have htwo : 2 ≤ ‖xi‖ := le_of_not_ge hnot
  have hzero : intDyadicLowpassMultiplier C.cutoff 0 xi = 0 := by
    apply intDyadicLowpass_eq_zero_of_le_norm C
    norm_num
    exact htwo
  exact hxi (by rw [kakeyaRadialLowpassPiece_apply, hzero, zero_mul])

/-- Every positive dyadic radial piece is supported in the annulus carried by
the scaled four-chart family at its own frequency scale. -/
theorem kakeyaRadialBandPiece_supportedOn_scaledDyadicFrequencyAnnulus
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex) (i : Nat) :
    ∀ xi : Euclidean 2, kakeyaRadialBandPiece C m i xi ≠ 0 →
      xi ∈ scaledDyadicFrequencyAnnulus (kakeyaRadialBandScale i) := by
  intro xi hxi
  have hband : intDyadicBandpassMultiplier C.cutoff ((0 : Int) + i) xi ≠ 0 := by
    intro hzero
    exact hxi (by rw [kakeyaRadialBandPiece_apply, hzero, zero_mul])
  have hbounds := intDyadicBandpass_norm_bounds_of_ne_zero C hband
  change kakeyaRadialBandScale i / 2 ≤ ‖xi‖ ∧ ‖xi‖ ≤
    2 * kakeyaRadialBandScale i
  constructor
  · rw [kakeyaRadialBandScale_half]
    have hleft : (2 : Real) ^ i < ‖xi‖ := by
      simpa only [zero_add, zpow_natCast] using hbounds.1
    exact hleft.le
  · rw [two_mul_kakeyaRadialBandScale]
    have hrightInt : ‖xi‖ < (2 : Real) ^ ((i : Int) + 2) := by
      simpa only [zero_add] using hbounds.2
    have hcast : (i : Int) + 2 = ((i + 2 : Nat) : Int) := by omega
    rw [hcast, zpow_natCast] at hrightInt
    have hright : ‖xi‖ < (2 : Real) ^ (i + 2) := hrightInt
    exact hright.le

/-- Direct compatibility datum for the scaled four-chart partition. -/
theorem kakeyaRadialBandPiece_supportedOn_scaledDyadicFourChartFamily
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex) (i : Nat) :
    SupportedOnActive (scaledDyadicFourChartFamily (kakeyaRadialBandScale i)
      (kakeyaRadialBandScale_pos i))
        (kakeyaRadialBandPiece C m i) := by
  exact kakeyaRadialBandPiece_supportedOn_scaledDyadicFrequencyAnnulus C m i

/-- The four scaled angular charts reassemble each radial band exactly. -/
theorem kakeyaRadialBandPiece_reassembly_by_scaledCharts
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex) (i : Nat) :
    kakeyaRadialBandPiece C m i =
      ∑ j ∈ Finset.univ,
        chartProfile (scaledDyadicFourChartFamily (kakeyaRadialBandScale i)
          (kakeyaRadialBandScale_pos i)) j
          (kakeyaRadialBandPiece C m i) := by
  symm
  ext xi
  exact sum_chartProfile_eq (scaledDyadicFourChartFamily (kakeyaRadialBandScale i)
    (kakeyaRadialBandScale_pos i))
      (kakeyaRadialBandPiece C m i)
      (kakeyaRadialBandPiece_supportedOn_scaledDyadicFourChartFamily C m i) xi

end

end Auto.Spherical.MSS
end
