section

section Auto.Spherical.MSS.KakeyaScaledSectorPartition

open Filter MeasureTheory Set
open Auto.Spherical.SurfaceMeasureDecay
open scoped BigOperators EuclideanSpace

noncomputable section

/-- The active annulus at an arbitrary positive radial frequency scale. -/
def scaledDyadicFrequencyAnnulus (lambda : Real) : Set (Euclidean 2) :=
  {xi | lambda / 2 ≤ ‖xi‖ ∧ ‖xi‖ ≤ 2 * lambda}

/-- The dilation that sends the `lambda` annulus back to the unit annulus. -/
noncomputable def frequencyScaleEquiv (lambda : Real) (hlambda : lambda ≠ 0) :
    Euclidean 2 ≃L[Real] Euclidean 2 :=
  ContinuousLinearEquiv.smulLeft
    (Units.mk0 lambda⁻¹ (inv_ne_zero hlambda))

/-- A chart sector transported by the positive radial dilation. -/
noncomputable def scaledChartAnnularMultiplierSchwartz
    (lambda : Real) (hlambda : lambda ≠ 0) (j : Fin 4) :
    SchwartzMap (Euclidean 2) Complex :=
  (SchwartzMap.compCLMOfContinuousLinearEquiv Complex
    (frequencyScaleEquiv lambda hlambda)) (chartAnnularMultiplierSchwartz j)

theorem scaledChartAnnularMultiplierSchwartz_apply
    (lambda : Real) (hlambda : lambda ≠ 0) (j : Fin 4) (xi : Euclidean 2) :
    scaledChartAnnularMultiplierSchwartz lambda hlambda j xi =
      chartAnnularMultiplierSchwartz j (lambda⁻¹ • xi) := by
  simp [scaledChartAnnularMultiplierSchwartz, frequencyScaleEquiv]

theorem norm_inv_smul_eq_div (lambda : Real) (hlambda : 0 < lambda)
    (xi : Euclidean 2) :
    ‖lambda⁻¹ • xi‖ = ‖xi‖ / lambda := by
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hlambda)]
  ring

theorem mem_scaledDyadicFrequencyAnnulus_iff
    {lambda : Real} (hlambda : 0 < lambda) (xi : Euclidean 2) :
    xi ∈ scaledDyadicFrequencyAnnulus lambda ↔
      lambda⁻¹ • xi ∈ unitDyadicFrequencyAnnulus := by
  rw [show xi ∈ scaledDyadicFrequencyAnnulus lambda ↔
      lambda / 2 ≤ ‖xi‖ ∧ ‖xi‖ ≤ 2 * lambda by rfl]
  rw [show lambda⁻¹ • xi ∈ unitDyadicFrequencyAnnulus ↔
      1 / 2 ≤ ‖lambda⁻¹ • xi‖ ∧ ‖lambda⁻¹ • xi‖ ≤ 2 by rfl]
  rw [norm_inv_smul_eq_div lambda hlambda xi]
  constructor
  · rintro ⟨hlo, hhi⟩
    constructor
    · apply (le_div_iff₀ hlambda).2
      nlinarith
    · apply (div_le_iff₀ hlambda).2
      nlinarith
  · rintro ⟨hlo, hhi⟩
    constructor
    · have h := (le_div_iff₀ hlambda).1 hlo
      nlinarith
    · have h := (div_le_iff₀ hlambda).1 hhi
      nlinarith

/-- The globally smooth scaled copy of the corresponding unit chart angle. -/
noncomputable def scaledChartAngle (lambda : Real) (j : Fin 4)
    (xi : Euclidean 2) : Real :=
  globalSectorAngle (chartSectorIndex j) (lambda⁻¹ • xi)

theorem contDiff_scaledChartAngle (lambda : Real) (j : Fin 4) :
    ContDiff Real (⊤ : ℕ∞) (scaledChartAngle lambda j) := by
  unfold scaledChartAngle
  exact (contDiff_globalSectorAngle (chartSectorIndex j)).comp
    (ContinuousLinearMap.contDiff (ContinuousLinearMap.lsmul Real Real lambda⁻¹))

theorem neg_four_lt_scaledChartAngle (lambda : Real) (j : Fin 4)
    (xi : Euclidean 2) :
    -4 < scaledChartAngle lambda j xi := by
  exact neg_four_lt_globalSectorAngle (chartSectorIndex j) (lambda⁻¹ • xi)

theorem scaledChartAngle_lt_six (lambda : Real) (j : Fin 4)
    (xi : Euclidean 2) :
    scaledChartAngle lambda j xi < 6 := by
  exact globalSectorAngle_lt_six (chartSectorIndex j) (lambda⁻¹ • xi)

theorem abs_sub_scaledChartAngle_lt_ten
    {theta : Real} (htheta : |theta| ≤ Real.pi) (lambda : Real) (j : Fin 4)
    (xi : Euclidean 2) :
    |theta - scaledChartAngle lambda j xi| < 10 := by
  exact abs_sub_globalSectorAngle_lt_ten htheta (chartSectorIndex j) (lambda⁻¹ • xi)

theorem chartAnnularMultiplierSchwartz_eq_zero_of_three_le_norm
    (j : Fin 4) {xi : Euclidean 2} (hxi : 3 ≤ ‖xi‖) :
    chartAnnularMultiplierSchwartz j xi = 0 := by
  rw [chartAnnularMultiplierSchwartz_apply]
  unfold chartAnnularMultiplier
  have houter : outerSectorRadialBump xi = 0 := by
    apply outerSectorRadialBump.zero_of_le_dist
    simpa only [outerSectorRadialBump, dist_zero_right] using hxi
  simp [sectorAnnularCutoff, houter]

theorem hasCompactSupport_scaledChartAnnularMultiplierSchwartz
    {lambda : Real} (hlambda : 0 < lambda) (j : Fin 4) :
    HasCompactSupport (scaledChartAnnularMultiplierSchwartz lambda hlambda.ne' j :
      Euclidean 2 → Complex) := by
  apply HasCompactSupport.intro
    (ProperSpace.isCompact_closedBall (0 : Euclidean 2) (3 * lambda))
  intro xi hxi
  have houtside : 3 * lambda < ‖xi‖ := by
    rw [Metric.mem_closedBall, dist_zero_right] at hxi
    exact lt_of_not_ge hxi
  rw [scaledChartAnnularMultiplierSchwartz_apply]
  apply chartAnnularMultiplierSchwartz_eq_zero_of_three_le_norm
  rw [norm_inv_smul_eq_div lambda hlambda xi]
  apply (le_div_iff₀ hlambda).2
  linarith

theorem scaledChartAnnularMultiplierSchwartz_eq_zero_of_norm_le_quarter_mul
    {lambda : Real} (hlambda : 0 < lambda) (j : Fin 4) {xi : Euclidean 2}
    (hxi : ‖xi‖ ≤ lambda / 4) :
    scaledChartAnnularMultiplierSchwartz lambda hlambda.ne' j xi = 0 := by
  rw [scaledChartAnnularMultiplierSchwartz_apply,
    chartAnnularMultiplierSchwartz_apply]
  unfold chartAnnularMultiplier
  have hunit : ‖lambda⁻¹ • xi‖ ≤ 1 / 4 := by
    rw [norm_inv_smul_eq_div lambda hlambda xi]
    apply (div_le_iff₀ hlambda).2
    nlinarith
  simp [sectorAnnularCutoff_eq_zero_of_norm_le_quarter hunit]

theorem scaledChartAnnularMultiplierSchwartz_eq_zero_of_three_mul_le_norm
    {lambda : Real} (hlambda : 0 < lambda) (j : Fin 4) {xi : Euclidean 2}
    (hxi : 3 * lambda ≤ ‖xi‖) :
    scaledChartAnnularMultiplierSchwartz lambda hlambda.ne' j xi = 0 := by
  rw [scaledChartAnnularMultiplierSchwartz_apply]
  apply chartAnnularMultiplierSchwartz_eq_zero_of_three_le_norm
  rw [norm_inv_smul_eq_div lambda hlambda xi]
  apply (le_div_iff₀ hlambda).2
  linarith

theorem smul_inv_smul_eq_self {lambda : Real} (hlambda : 0 < lambda)
    (xi : Euclidean 2) :
    lambda • (lambda⁻¹ • xi) = xi := by
  rw [smul_smul, mul_inv_cancel₀ hlambda.ne', one_smul]

theorem scaledChartAnnularMultiplierSchwartz_polar_on_nonzero
    {lambda : Real} (hlambda : 0 < lambda) (j : Fin 4) (xi : Euclidean 2)
    (hxi : scaledChartAnnularMultiplierSchwartz lambda hlambda.ne' j xi ≠ 0) :
    xi = ‖xi‖ • circleDirection (scaledChartAngle lambda j xi) := by
  have hunit : chartAnnularMultiplierSchwartz j (lambda⁻¹ • xi) ≠ 0 := by
    simpa only [scaledChartAnnularMultiplierSchwartz_apply] using hxi
  have hpolar : lambda⁻¹ • xi = ‖lambda⁻¹ • xi‖ •
      circleDirection (globalSectorAngle (chartSectorIndex j) (lambda⁻¹ • xi)) := by
    rw [chartAnnularMultiplierSchwartz_apply] at hunit
    exact chartAnnularMultiplier_polar_on_nonzero j (lambda⁻¹ • xi) hunit
  have hscale : lambda * ‖lambda⁻¹ • xi‖ = ‖xi‖ := by
    rw [norm_inv_smul_eq_div lambda hlambda xi]
    field_simp [hlambda.ne']
  calc
    xi = lambda • (lambda⁻¹ • xi) := (smul_inv_smul_eq_self hlambda xi).symm
    _ = lambda • (‖lambda⁻¹ • xi‖ •
        circleDirection (globalSectorAngle (chartSectorIndex j) (lambda⁻¹ • xi))) :=
          congrArg (fun z : Euclidean 2 => lambda • z) hpolar
    _ = (lambda * ‖lambda⁻¹ • xi‖) •
        circleDirection (globalSectorAngle (chartSectorIndex j) (lambda⁻¹ • xi)) := by
          rw [smul_smul]
    _ = ‖xi‖ • circleDirection (scaledChartAngle lambda j xi) := by
          rw [hscale]
          rfl

theorem sum_scaledChartAnnularMultiplierSchwartz_eq_one_on_scaledDyadicFrequencyAnnulus
    {lambda : Real} (hlambda : 0 < lambda) {xi : Euclidean 2}
    (hxi : xi ∈ scaledDyadicFrequencyAnnulus lambda) :
    ∑ j : Fin 4, scaledChartAnnularMultiplierSchwartz lambda hlambda.ne' j xi = 1 := by
  have hunit : lambda⁻¹ • xi ∈ unitDyadicFrequencyAnnulus :=
    (mem_scaledDyadicFrequencyAnnulus_iff hlambda xi).1 hxi
  calc
    ∑ j : Fin 4, scaledChartAnnularMultiplierSchwartz lambda hlambda.ne' j xi =
        ∑ j : Fin 4, chartAnnularMultiplierSchwartz j (lambda⁻¹ • xi) := by
          apply Finset.sum_congr rfl
          intro j _
          exact scaledChartAnnularMultiplierSchwartz_apply lambda hlambda.ne' j xi
    _ = 1 := sum_chartAnnularMultiplierSchwartz_eq_one_on_unitDyadicFrequencyAnnulus hunit

/-- The four smooth angular charts transported to the annulus at frequency
scale `lambda`.  The charts retain the same globally smooth angular branches
and exact four-piece overlap bound. -/
noncomputable def scaledDyadicFourChartFamily
    (lambda : Real) (hlambda : 0 < lambda) :
    SmoothAngularFrequencyChartFamily (Fin 4) Finset.univ
      (scaledDyadicFrequencyAnnulus lambda) where
  sector := scaledChartAnnularMultiplierSchwartz lambda hlambda.ne'
  sector_compact := by
    intro j _
    exact hasCompactSupport_scaledChartAnnularMultiplierSchwartz hlambda j
  angle := scaledChartAngle lambda
  angle_smooth := by
    intro j
    exact contDiff_scaledChartAngle lambda j
  angle_lower := by
    intro j _ xi
    exact neg_four_lt_scaledChartAngle lambda j xi
  polar_on_sector := by
    intro j _ xi hxi
    exact scaledChartAnnularMultiplierSchwartz_polar_on_nonzero hlambda j xi hxi
  sum_eq_one_on_active := by
    intro xi hxi
    exact sum_scaledChartAnnularMultiplierSchwartz_eq_one_on_scaledDyadicFrequencyAnnulus
      hlambda hxi
  card_le_four := by norm_num

theorem scaledDyadicFourChartFamily_card :
    (Finset.univ : Finset (Fin 4)).card = 4 := by
  norm_num

theorem scaledDyadicFourChartFamily_sector_apply
    (lambda : Real) (hlambda : 0 < lambda) (j : Fin 4) (xi : Euclidean 2) :
    (scaledDyadicFourChartFamily lambda hlambda).sector j xi =
      chartAnnularMultiplierSchwartz j (lambda⁻¹ • xi) := by
  exact scaledChartAnnularMultiplierSchwartz_apply lambda hlambda.ne' j xi

theorem scaledDyadicFourChartFamily_angle_apply
    (lambda : Real) (hlambda : 0 < lambda) (j : Fin 4) (xi : Euclidean 2) :
    (scaledDyadicFourChartFamily lambda hlambda).angle j xi =
      scaledChartAngle lambda j xi := rfl

theorem scaledDyadicFourChartFamily_polar_on_sector
    (lambda : Real) (hlambda : 0 < lambda) (j : Fin 4) (xi : Euclidean 2)
    (hxi : (scaledDyadicFourChartFamily lambda hlambda).sector j xi ≠ 0) :
    xi = ‖xi‖ • circleDirection ((scaledDyadicFourChartFamily lambda hlambda).angle j xi) := by
  exact scaledChartAnnularMultiplierSchwartz_polar_on_nonzero hlambda j xi hxi

theorem sum_scaledDyadicFourChartFamily_sector_eq_one
    {lambda : Real} (hlambda : 0 < lambda) {xi : Euclidean 2}
    (hxi : xi ∈ scaledDyadicFrequencyAnnulus lambda) :
    ∑ j : Fin 4, (scaledDyadicFourChartFamily lambda hlambda).sector j xi = 1 := by
  exact sum_scaledChartAnnularMultiplierSchwartz_eq_one_on_scaledDyadicFrequencyAnnulus
    hlambda hxi

end

end Auto.Spherical.MSS.KakeyaScaledSectorPartition
