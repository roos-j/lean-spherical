section

section Auto.Spherical.MSS

open Auto.Spherical.SurfaceMeasureDecay

noncomputable section

/-- A crude uniform upper range bound for the globally smooth chart angles.
Together with the existing lower bound, this is enough to select a finite
telescoping angular window for one fundamental circle period. -/
theorem globalSectorAngle_lt_six (j : SectorIndex) (xi : Euclidean 2) :
    globalSectorAngle j xi < 6 := by
  have hpi : Real.pi < 4 := Real.pi_lt_four
  have harg := Real.arctan_lt_pi_div_two
    (sectorTangentProjection j xi /
      sectorAngleDenom (sectorProjection j xi))
  rcases j with ⟨b, k⟩
  cases b <;> fin_cases k <;>
    simp [globalSectorAngle, sectorBaseAngle] at harg ⊢ <;>
    nlinarith

theorem abs_sub_globalSectorAngle_lt_ten
    {theta : Real} (htheta : |theta| ≤ Real.pi)
    (j : SectorIndex) (xi : Euclidean 2) :
    |theta - globalSectorAngle j xi| < 10 := by
  have hlower : -4 < globalSectorAngle j xi := neg_four_lt_globalSectorAngle j xi
  have hupper : globalSectorAngle j xi < 6 := globalSectorAngle_lt_six j xi
  have hpi : Real.pi < 4 := Real.pi_lt_four
  rw [abs_lt]
  constructor <;> nlinarith [le_abs_self theta, neg_le_abs theta]

end

end Auto.Spherical.MSS
end
