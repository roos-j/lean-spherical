section Auto.Spherical.MSS

open Filter MeasureTheory Metric Set

noncomputable section

/-- The time-weight that occurs after differentiating the literal circle
phase. -/
noncomputable def timeWeighted (H : Real -> Complex) : Real -> Complex :=
  fun t => (t : Complex) * H t

private theorem abs_le_five_halves_of_mem_innerSlab
    {r t : Real} (hr : r < 1)
    (ht : t ∈ closedBall (3 / 2 : Real) r) :
    |t| ≤ 5 / 2 := by
  change dist t (3 / 2 : Real) ≤ r at ht
  rw [Real.dist_eq] at ht
  have hdist : |t - 3 / 2| < 1 := lt_of_le_of_lt ht hr
  have hupper : t < 5 / 2 := by
    have := (abs_lt.mp hdist).2
    linarith
  have hlower : -(5 / 2 : Real) < t := by
    have := (abs_lt.mp hdist).1
    linarith
  exact (abs_le).mpr ⟨le_of_lt hlower, le_of_lt hupper⟩

/-- On the density core's strict inner time slab, differentiating the phase
only costs the fixed factor `(5/2)^2` in `L²`. -/
theorem integrable_norm_sq_timeWeighted_and_integral_le
    (H : Real -> Complex) {r : Real} (hr : r < 1)
    (hsupp : Function.support H ⊆ closedBall (3 / 2 : Real) r)
    (hHsq : Integrable (fun t : Real => ‖H t‖ ^ 2) volume) :
    Integrable (fun t : Real => ‖timeWeighted H t‖ ^ 2) volume ∧
      (∫ t : Real, ‖timeWeighted H t‖ ^ 2) ≤
        (5 / 2 : Real) ^ 2 * ∫ t : Real, ‖H t‖ ^ 2 := by
  have hbound : ∀ t : Real,
      ‖timeWeighted H t‖ ^ 2 ≤ (5 / 2 : Real) ^ 2 * ‖H t‖ ^ 2 := by
    intro t
    by_cases hzero : H t = 0
    · simp [timeWeighted, hzero]
    · have hmem : t ∈ Function.support H := by
        exact hzero
      have ht : |t| ≤ 5 / 2 :=
        abs_le_five_halves_of_mem_innerSlab hr (hsupp hmem)
      have htsq : |t| ^ 2 ≤ (5 / 2 : Real) ^ 2 :=
        (sq_le_sq₀ (abs_nonneg t) (by norm_num)).mpr ht
      unfold timeWeighted
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
      calc
        (|t| * ‖H t‖) ^ 2 = |t| ^ 2 * ‖H t‖ ^ 2 := by ring
        _ ≤ (5 / 2 : Real) ^ 2 * ‖H t‖ ^ 2 :=
          mul_le_mul_of_nonneg_right htsq (sq_nonneg _)
  have hmeas : AEStronglyMeasurable (fun t : Real => ‖timeWeighted H t‖ ^ 2) volume := by
    have hbase : AEStronglyMeasurable (fun t : Real =>
        |t| ^ 2 * ‖H t‖ ^ 2) volume :=
      (continuous_abs.pow 2).aestronglyMeasurable.mul hHsq.aestronglyMeasurable
    apply hbase.congr
    filter_upwards with t
    unfold timeWeighted
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
    ring
  have hmajor : Integrable (fun t : Real =>
      (5 / 2 : Real) ^ 2 * ‖H t‖ ^ 2) volume :=
    hHsq.const_mul _
  have hweighted : Integrable (fun t : Real => ‖timeWeighted H t‖ ^ 2) volume :=
    hmajor.mono' hmeas (Filter.Eventually.of_forall fun t => by
      rw [Real.norm_of_nonneg (sq_nonneg _)]
      exact hbound t)
  refine ⟨hweighted, ?_⟩
  calc
    (∫ t : Real, ‖timeWeighted H t‖ ^ 2) ≤
        ∫ t : Real, (5 / 2 : Real) ^ 2 * ‖H t‖ ^ 2 :=
      integral_mono hweighted hmajor hbound
    _ = (5 / 2 : Real) ^ 2 * ∫ t : Real, ‖H t‖ ^ 2 :=
      integral_const_mul _ _

end

end Auto.Spherical.MSS
end
-- END ScratchKakeyaCompactTimeWeight

