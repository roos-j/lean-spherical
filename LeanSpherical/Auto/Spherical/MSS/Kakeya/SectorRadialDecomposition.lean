      (hFmem j hj) (hDmem j hj) (hE0 j hj) (hE1 j hj)
  rw [MeasureTheory.lintegral_finsetSum]
  · apply Finset.sum_le_sum
    intro j hj
    exact (hchart j hj).2
  · intro j hj
    exact (hchart j hj).1

