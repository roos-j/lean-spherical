/-- Public finite-shell Cauchy/Tonelli reassembly.  A literal finite
decomposition costs one factor of the number of shells in the squared
maximal bound, and otherwise preserves each per-shell maximal-square energy
without any positivity assumption on the complex pieces. -/
theorem lintegral_iSup_sq_finite_shell_sum_le
    {Theta X ι : Type*} [MeasurableSpace X]
    (mu : Measure X) (shells : Finset ι)
    (F : Theta → X → Complex) (piece : ι → Theta → X → Complex)
    (hdecomp : ∀ theta x, F theta x = ∑ i ∈ shells, piece i theta x)
    (hpieceMeas : ∀ i ∈ shells, Measurable (fun x : X =>
      ⨆ theta : Theta, ENNReal.ofReal (‖piece i theta x‖ ^ 2))) :
    (∫⁻ x : X, ⨆ theta : Theta,
      ENNReal.ofReal (‖F theta x‖ ^ 2) ∂mu) ≤
      (shells.card : ENNReal) * ∑ i ∈ shells, ∫⁻ x : X,
        ⨆ theta : Theta, ENNReal.ofReal (‖piece i theta x‖ ^ 2) ∂mu := by
  classical
  let Q : ι → X → ENNReal := fun i x =>
    ⨆ theta : Theta, ENNReal.ofReal (‖piece i theta x‖ ^ 2)
  have hQmeas : ∀ i ∈ shells, Measurable (Q i) := by
    intro i hi
    exact hpieceMeas i hi
  have hsumMeas : Measurable (fun x : X => ∑ i ∈ shells, Q i x) := by
    apply Finset.measurable_sum
    intro i hi
    exact hQmeas i hi
  have hpoint : ∀ x : X, (⨆ theta : Theta,
      ENNReal.ofReal (‖F theta x‖ ^ 2)) ≤
      (shells.card : ENNReal) * ∑ i ∈ shells, Q i x := by
    intro x
    apply iSup_le
    intro theta
    have hnorm : ‖F theta x‖ ^ 2 ≤
        (shells.card : Real) * ∑ i ∈ shells, ‖piece i theta x‖ ^ 2 := by
      rw [hdecomp]
      calc
        ‖∑ i ∈ shells, piece i theta x‖ ^ 2 ≤
            (∑ i ∈ shells, ‖piece i theta x‖) ^ 2 := by
          exact pow_le_pow_left₀ (norm_nonneg _) (norm_sum_le _ _) 2
        _ ≤ (shells.card : Real) * ∑ i ∈ shells, ‖piece i theta x‖ ^ 2 := by
          exact sq_sum_le_card_mul_sum_sq
    have hnorm' : ENNReal.ofReal (‖F theta x‖ ^ 2) ≤
        (shells.card : ENNReal) * ∑ i ∈ shells,
          ENNReal.ofReal (‖piece i theta x‖ ^ 2) := by
      calc
        ENNReal.ofReal (‖F theta x‖ ^ 2) ≤
            ENNReal.ofReal ((shells.card : Real) *
              ∑ i ∈ shells, ‖piece i theta x‖ ^ 2) :=
          ENNReal.ofReal_le_ofReal hnorm
        _ = (shells.card : ENNReal) * ∑ i ∈ shells,
            ENNReal.ofReal (‖piece i theta x‖ ^ 2) := by
          rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_natCast,
            ENNReal.ofReal_sum_of_nonneg]
          intro i hi
          exact sq_nonneg _
    have hlocalSum : (∑ i ∈ shells,
        ENNReal.ofReal (‖piece i theta x‖ ^ 2)) ≤ ∑ i ∈ shells, Q i x := by
      apply Finset.sum_le_sum
      intro i hi
      exact le_iSup (fun theta : Theta =>
        ENNReal.ofReal (‖piece i theta x‖ ^ 2)) theta
    calc
      ENNReal.ofReal (‖F theta x‖ ^ 2) ≤
          (shells.card : ENNReal) * ∑ i ∈ shells,
            ENNReal.ofReal (‖piece i theta x‖ ^ 2) := hnorm'
      _ ≤ (shells.card : ENNReal) * ∑ i ∈ shells, Q i x :=
        mul_le_mul' le_rfl hlocalSum
  calc
    (∫⁻ x : X, ⨆ theta : Theta,
      ENNReal.ofReal (‖F theta x‖ ^ 2) ∂mu) ≤
        ∫⁻ x : X, (shells.card : ENNReal) * ∑ i ∈ shells, Q i x ∂mu :=
      lintegral_mono hpoint
    _ = (shells.card : ENNReal) *
        (∫⁻ x : X, ∑ i ∈ shells, Q i x ∂mu) := by
      rw [lintegral_const_mul _ hsumMeas]
    _ = (shells.card : ENNReal) * ∑ i ∈ shells, ∫⁻ x : X, Q i x ∂mu := by
      rw [lintegral_finsetSum shells hQmeas]

/-- The directly usable bounded version of finite-shell reassembly. -/
theorem lintegral_iSup_sq_finite_shell_sum_le_of_bounds
    {Theta X ι : Type*} [MeasurableSpace X]
    (mu : Measure X) (shells : Finset ι)
    (F : Theta → X → Complex) (piece : ι → Theta → X → Complex)
    (B : ι → ENNReal)
    (hdecomp : ∀ theta x, F theta x = ∑ i ∈ shells, piece i theta x)
    (hpieceMeas : ∀ i ∈ shells, Measurable (fun x : X =>
      ⨆ theta : Theta, ENNReal.ofReal (‖piece i theta x‖ ^ 2)))
    (hpieceBound : ∀ i ∈ shells, (∫⁻ x : X,
      ⨆ theta : Theta, ENNReal.ofReal (‖piece i theta x‖ ^ 2) ∂mu) ≤ B i) :
    (∫⁻ x : X, ⨆ theta : Theta,
      ENNReal.ofReal (‖F theta x‖ ^ 2) ∂mu) ≤
      (shells.card : ENNReal) * ∑ i ∈ shells, B i := by
  calc
    (∫⁻ x : X, ⨆ theta : Theta,
      ENNReal.ofReal (‖F theta x‖ ^ 2) ∂mu) ≤
        (shells.card : ENNReal) * ∑ i ∈ shells, ∫⁻ x : X,
          ⨆ theta : Theta, ENNReal.ofReal (‖piece i theta x‖ ^ 2) ∂mu :=
      lintegral_iSup_sq_finite_shell_sum_le mu shells F piece hdecomp hpieceMeas
    _ ≤ (shells.card : ENNReal) * ∑ i ∈ shells, B i := by
      apply mul_le_mul' le_rfl
      apply Finset.sum_le_sum
      intro i hi
      exact hpieceBound i hi

end

end Auto.Spherical.MSS
end
-- END ScratchKakeyaAngularChartReassembly

-- BEGIN ScratchKakeyaSectorPartition
section

section Auto.Spherical.MSS

open Filter MeasureTheory Set
open Auto.Spherical.SurfaceMeasureDecay
open scoped BigOperators EuclideanSpace

noncomputable section

abbrev SectorIndex := Bool × Fin 2

def sectorProjection (j : SectorIndex) (xi : Euclidean 2) : Real :=
  if j.1 then xi j.2 else -xi j.2

def sectorWeight (j : SectorIndex) (xi : Euclidean 2) : Real :=
  Real.smoothTransition (sectorProjection j xi)

def sectorWeightSum (xi : Euclidean 2) : Real :=
  ∑ j : SectorIndex, sectorWeight j xi

def sectorPartition (j : SectorIndex) (xi : Euclidean 2) : Real :=
  sectorWeight j xi / sectorWeightSum xi

theorem sectorProjection_true_zero (xi : Euclidean 2) :
    sectorProjection (true, 0) xi = xi 0 := by
  simp [sectorProjection]

theorem sectorProjection_false_zero (xi : Euclidean 2) :
    sectorProjection (false, 0) xi = -xi 0 := by
  simp [sectorProjection]

theorem sectorProjection_true_one (xi : Euclidean 2) :
    sectorProjection (true, 1) xi = xi 1 := by
  simp [sectorProjection]

theorem sectorProjection_false_one (xi : Euclidean 2) :
    sectorProjection (false, 1) xi = -xi 1 := by
  simp [sectorProjection]

theorem exists_sectorProjection_pos {xi : Euclidean 2} (hxi : xi ≠ 0) :
    ∃ j : SectorIndex, 0 < sectorProjection j xi := by
  have hcoord : xi 0 ≠ 0 ∨ xi 1 ≠ 0 := by
    by_cases hx : xi 0 = 0
    · right
      intro hy
      apply hxi
      apply PiLp.ext
      intro i
      fin_cases i <;> simp [hx, hy]
    · exact Or.inl hx
  rcases hcoord with hx | hy
  · rcases lt_or_gt_of_ne hx with hxneg | hxpos
    · refine ⟨(false, 0), ?_⟩
      rw [sectorProjection_false_zero]
      linarith
    · refine ⟨(true, 0), ?_⟩
      rw [sectorProjection_true_zero]
      exact hxpos
  · rcases lt_or_gt_of_ne hy with hyneg | hypos
    · refine ⟨(false, 1), ?_⟩
      rw [sectorProjection_false_one]
      linarith
    · refine ⟨(true, 1), ?_⟩
      rw [sectorProjection_true_one]
      exact hypos

theorem sectorWeight_nonneg (j : SectorIndex) (xi : Euclidean 2) :
    0 ≤ sectorWeight j xi :=
  Real.smoothTransition.nonneg _

theorem sectorWeight_pos_of_projection_pos {j : SectorIndex} {xi : Euclidean 2}
    (h : 0 < sectorProjection j xi) :
    0 < sectorWeight j xi := by
  exact Real.smoothTransition.pos_of_pos h

theorem sectorWeight_eq_zero_of_projection_nonpos {j : SectorIndex} {xi : Euclidean 2}
    (h : sectorProjection j xi ≤ 0) :
    sectorWeight j xi = 0 :=
  Real.smoothTransition.zero_of_nonpos h

theorem sectorWeightSum_pos_of_ne_zero {xi : Euclidean 2} (hxi : xi ≠ 0) :
    0 < sectorWeightSum xi := by
  rcases exists_sectorProjection_pos hxi with ⟨j, hj⟩
  have hjweight : 0 < sectorWeight j xi :=
    sectorWeight_pos_of_projection_pos hj
  have hle : sectorWeight j xi ≤ sectorWeightSum xi := by
    unfold sectorWeightSum
    exact Finset.single_le_sum (fun k _ => sectorWeight_nonneg k xi)
      (Finset.mem_univ _)
  exact lt_of_lt_of_le hjweight hle

theorem sectorWeightSum_ne_zero_of_ne_zero {xi : Euclidean 2} (hxi : xi ≠ 0) :
    sectorWeightSum xi ≠ 0 :=
  ne_of_gt (sectorWeightSum_pos_of_ne_zero hxi)

theorem sum_sectorPartition_eq_one {xi : Euclidean 2} (hxi : xi ≠ 0) :
    ∑ j : SectorIndex, sectorPartition j xi = 1 := by
  unfold sectorPartition
  rw [← Finset.sum_div]
  exact div_self (sectorWeightSum_ne_zero_of_ne_zero hxi)

theorem sectorPartition_eq_zero_of_projection_nonpos {j : SectorIndex} {xi : Euclidean 2}
    (h : sectorProjection j xi ≤ 0) :
    sectorPartition j xi = 0 := by
  unfold sectorPartition
  rw [sectorWeight_eq_zero_of_projection_nonpos h]
  simp

theorem sectorPartition_ne_zero_imp_projection_pos {j : SectorIndex} {xi : Euclidean 2}
    (h : sectorPartition j xi ≠ 0) :
    0 < sectorProjection j xi := by
  apply lt_of_not_ge
  intro hnonpos
  exact h (sectorPartition_eq_zero_of_projection_nonpos hnonpos)

theorem sectorPartition_support_subset_chart (j : SectorIndex) :
    Function.support (sectorPartition j) ⊆
      {xi : Euclidean 2 | 0 < sectorProjection j xi} := by
  intro xi hxi
  exact sectorPartition_ne_zero_imp_projection_pos hxi

/-- The four fixed local angular charts, centred at the coordinate axes. -/
def sectorBaseAngle (j : SectorIndex) : Real :=
  if j.2 = 0 then
    if j.1 then 0 else Real.pi
  else
    if j.1 then Real.pi / 2 else -Real.pi / 2

/-- The tangent coordinate associated to `sectorBaseAngle`.  Together with
`sectorProjection` it is the oriented orthogonal coordinate pair in the
corresponding half-plane chart. -/
def sectorTangentProjection (j : SectorIndex) (xi : Euclidean 2) : Real :=
  if j.2 = 0 then
    if j.1 then xi 1 else -xi 1
  else
    if j.1 then -xi 0 else xi 0

def sectorAngle (j : SectorIndex) (xi : Euclidean 2) : Real :=
  sectorBaseAngle j + Real.arctan
    (sectorTangentProjection j xi / sectorProjection j xi)

theorem sectorBaseAngle_true_zero : sectorBaseAngle (true, 0) = 0 := by
  simp [sectorBaseAngle]

theorem sectorBaseAngle_false_zero : sectorBaseAngle (false, 0) = Real.pi := by
  simp [sectorBaseAngle]

theorem sectorBaseAngle_true_one : sectorBaseAngle (true, 1) = Real.pi / 2 := by
  simp [sectorBaseAngle]

theorem sectorBaseAngle_false_one : sectorBaseAngle (false, 1) = -Real.pi / 2 := by
  simp [sectorBaseAngle]

theorem sectorTangentProjection_true_zero (xi : Euclidean 2) :
    sectorTangentProjection (true, 0) xi = xi 1 := by
  simp [sectorTangentProjection]

theorem sectorTangentProjection_false_zero (xi : Euclidean 2) :
    sectorTangentProjection (false, 0) xi = -xi 1 := by
  simp [sectorTangentProjection]

theorem sectorTangentProjection_true_one (xi : Euclidean 2) :
    sectorTangentProjection (true, 1) xi = -xi 0 := by
  simp [sectorTangentProjection]

theorem sectorTangentProjection_false_one (xi : Euclidean 2) :
    sectorTangentProjection (false, 1) xi = xi 0 := by
  simp [sectorTangentProjection]

theorem contDiff_sectorProjection (j : SectorIndex) :
    ContDiff Real (⊤ : ℕ∞) (sectorProjection j) := by
  unfold sectorProjection
  split_ifs with hj
  · exact contDiff_piLp_apply (p := (2 : ENNReal))
  · exact (contDiff_piLp_apply (p := (2 : ENNReal))).neg

theorem contDiff_sectorTangentProjection (j : SectorIndex) :
    ContDiff Real (⊤ : ℕ∞) (sectorTangentProjection j) := by
  unfold sectorTangentProjection
  split_ifs <;> first
    | exact contDiff_piLp_apply (p := (2 : ENNReal))
    | exact (contDiff_piLp_apply (p := (2 : ENNReal))).neg

theorem contDiffOn_sectorAngle (j : SectorIndex) :
    ContDiffOn Real (⊤ : ℕ∞) (sectorAngle j)
      {xi : Euclidean 2 | 0 < sectorProjection j xi} := by
  have hquot : ContDiffOn Real (⊤ : ℕ∞)
      (fun xi : Euclidean 2 =>
        sectorTangentProjection j xi / sectorProjection j xi)
      {xi : Euclidean 2 | 0 < sectorProjection j xi} := by
    apply (contDiff_sectorTangentProjection j).contDiffOn.div
      (contDiff_sectorProjection j).contDiffOn
    intro xi hxi
    exact ne_of_gt hxi
  unfold sectorAngle
  change ContDiffOn Real (⊤ : ℕ∞) (fun xi : Euclidean 2 =>
    sectorBaseAngle j + Real.arctan
      (sectorTangentProjection j xi / sectorProjection j xi))
    {xi : Euclidean 2 | 0 < sectorProjection j xi}
  exact (contDiff_const : ContDiff Real (⊤ : ℕ∞)
    (fun _ : Euclidean 2 => sectorBaseAngle j)).contDiffOn.add
      (Real.contDiff_arctan.comp_contDiffOn hquot)

theorem sectorProjection_eq_inner_circleDirection_base
    (j : SectorIndex) (xi : Euclidean 2) :
    sectorProjection j xi =
      inner Real (circleDirection (sectorBaseAngle j)) xi := by
  rcases j with ⟨b, k⟩
  cases b <;> fin_cases k <;>
    simp only [sectorProjection, sectorBaseAngle, circleDirection] <;>
    rw [inner_add_left, real_inner_smul_left, real_inner_smul_left,
      EuclideanSpace.basisFun_inner, EuclideanSpace.basisFun_inner] <;>
    simp
  rw [show -Real.pi / 2 = -(Real.pi / 2) by ring,
    Real.cos_neg, Real.sin_neg, Real.cos_pi_div_two,
    Real.sin_pi_div_two]
  ring

theorem sectorTangentProjection_eq_inner_circleDirectionDeriv_base
    (j : SectorIndex) (xi : Euclidean 2) :
    sectorTangentProjection j xi =
      inner Real (circleDirectionDeriv (sectorBaseAngle j)) xi := by
  rcases j with ⟨b, k⟩
  cases b <;> fin_cases k <;>
    simp only [sectorTangentProjection, sectorBaseAngle, circleDirectionDeriv] <;>
    rw [inner_add_left, real_inner_smul_left, real_inner_smul_left,
      EuclideanSpace.basisFun_inner, EuclideanSpace.basisFun_inner] <;>
    simp
  rw [show -Real.pi / 2 = -(Real.pi / 2) by ring,
    Real.cos_neg, Real.sin_neg, Real.cos_pi_div_two,
    Real.sin_pi_div_two]
  ring

private theorem pos_mul_sqrt_one_add_div_sq_eq_sqrt_sq_add_sq
    {p t : Real} (hp : 0 < p) :
    p * Real.sqrt (1 + (t / p) ^ 2) = Real.sqrt (p ^ 2 + t ^ 2) := by
  apply (sq_eq_sq₀ (mul_nonneg hp.le (Real.sqrt_nonneg _))
    (Real.sqrt_nonneg _)).mp
  rw [mul_pow, Real.sq_sqrt (by positivity),
    Real.sq_sqrt (by positivity)]
  field_simp [hp.ne']

private theorem pos_mul_sqrt_one_add_div_sq_mul_cos_arctan
    {p t : Real} (hp : 0 < p) :
    (p * Real.sqrt (1 + (t / p) ^ 2)) *
        Real.cos (Real.arctan (t / p)) = p := by
  rw [Real.cos_arctan]
  field_simp [Real.sqrt_ne_zero'.mpr (by positivity)]

private theorem pos_mul_sqrt_one_add_div_sq_mul_sin_arctan
    {p t : Real} (hp : 0 < p) :
    (p * Real.sqrt (1 + (t / p) ^ 2)) *
        Real.sin (Real.arctan (t / p)) = t := by
  rw [Real.sin_arctan]
  field_simp [hp.ne', Real.sqrt_ne_zero'.mpr (by positivity)]

theorem norm_sq_eq_sectorProjection_sq_add_sectorTangentProjection_sq
    (j : SectorIndex) (xi : Euclidean 2) :
    ‖xi‖ ^ 2 = sectorProjection j xi ^ 2 +
      sectorTangentProjection j xi ^ 2 := by
  rcases j with ⟨b, k⟩
  cases b <;> fin_cases k <;>
    simp [sectorProjection, sectorTangentProjection] <;>
    rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two] <;>
    ring

private theorem norm_eq_sectorProjection_mul_sqrt
    {j : SectorIndex} {xi : Euclidean 2}
    (hp : 0 < sectorProjection j xi) :
    ‖xi‖ = sectorProjection j xi * Real.sqrt
      (1 + (sectorTangentProjection j xi / sectorProjection j xi) ^ 2) := by
  apply (sq_eq_sq₀ (norm_nonneg _)
    (mul_nonneg hp.le (Real.sqrt_nonneg _))).mp
  rw [norm_sq_eq_sectorProjection_sq_add_sectorTangentProjection_sq]
  rw [mul_pow, Real.sq_sqrt (by positivity)]
  field_simp [hp.ne']

theorem circleDirection_add_decompose (beta u : Real) :
    circleDirection (beta + u) =
      Real.cos u • circleDirection beta +
        Real.sin u • circleDirectionDeriv beta := by
  unfold circleDirection circleDirectionDeriv
  rw [Real.cos_add, Real.sin_add]
  module

private theorem sector_coordinate_reconstruct
    (j : SectorIndex) (xi : Euclidean 2) :
    xi = sectorProjection j xi • circleDirection (sectorBaseAngle j) +
      sectorTangentProjection j xi • circleDirectionDeriv (sectorBaseAngle j) := by
  rcases j with ⟨b, k⟩
  cases b <;> fin_cases k <;>
    apply PiLp.ext <;>
    intro i <;>
    fin_cases i <;>
    simp [sectorProjection, sectorTangentProjection, sectorBaseAngle,
      circleDirection, circleDirectionDeriv]
  all_goals
    rw [show -Real.pi / 2 = -(Real.pi / 2) by ring,
      Real.cos_neg, Real.sin_neg, Real.cos_pi_div_two,
      Real.sin_pi_div_two]
    ring

theorem sectorAngle_polar_of_projection_pos
    {j : SectorIndex} {xi : Euclidean 2}
    (hp : 0 < sectorProjection j xi) :
    xi = ‖xi‖ • circleDirection (sectorAngle j xi) := by
  let p : Real := sectorProjection j xi
  let t : Real := sectorTangentProjection j xi
  let u : Real := Real.arctan (t / p)
  let s : Real := Real.sqrt (1 + (t / p) ^ 2)
  have hnorm : ‖xi‖ = p * s := by
    simpa only [p, s, t] using norm_eq_sectorProjection_mul_sqrt hp
  have hcos : (p * s) * Real.cos u = p := by
    simpa only [p, s, t, u] using
      pos_mul_sqrt_one_add_div_sq_mul_cos_arctan (p := p) (t := t) hp
  have hsin : (p * s) * Real.sin u = t := by
    simpa only [p, s, t, u] using
      pos_mul_sqrt_one_add_div_sq_mul_sin_arctan (p := p) (t := t) hp
  calc
    xi = p • circleDirection (sectorBaseAngle j) +
        t • circleDirectionDeriv (sectorBaseAngle j) := by
      simpa only [p, t] using sector_coordinate_reconstruct j xi
    _ = ((p * s) * Real.cos u) • circleDirection (sectorBaseAngle j) +
        ((p * s) * Real.sin u) • circleDirectionDeriv (sectorBaseAngle j) := by
      rw [hcos, hsin]
    _ = (p * s) • (Real.cos u • circleDirection (sectorBaseAngle j) +
        Real.sin u • circleDirectionDeriv (sectorBaseAngle j)) := by
      rw [smul_add, smul_smul, smul_smul]
    _ = ‖xi‖ • circleDirection (sectorAngle j xi) := by
      rw [← hnorm, ← circleDirection_add_decompose]
      rfl

/-- A globally positive smooth replacement for a chart's normal coordinate.
It agrees with that coordinate once the coordinate is at least `1/16`. -/
def sectorAngleDenom (p : Real) : Real :=
  (1 / 32 : Real) + (p - 1 / 32) *
    Real.smoothTransition ((p - 1 / 32) / (1 / 32))

theorem sectorAngleDenom_pos (p : Real) : 0 < sectorAngleDenom p := by
  by_cases hp : p ≤ 1 / 32
  · have harg : (p - 1 / 32) / (1 / 32) ≤ 0 := by
      apply div_nonpos_of_nonpos_of_nonneg
      · linarith
      · norm_num
    rw [sectorAngleDenom, Real.smoothTransition.zero_of_nonpos harg]
    norm_num
  · have hpc : 0 < p - 1 / 32 := by linarith
    have hnonneg : 0 ≤ Real.smoothTransition ((p - 1 / 32) / (1 / 32)) :=
      Real.smoothTransition.nonneg _
    unfold sectorAngleDenom
    nlinarith

theorem sectorAngleDenom_eq_self_of_one_sixteenth_le {p : Real}
    (hp : 1 / 16 ≤ p) : sectorAngleDenom p = p := by
  have hden : (0 : Real) < 1 / 32 := by norm_num
  have harg : 1 ≤ (p - 1 / 32) / (1 / 32) := by
    rw [le_div_iff₀ hden]
    linarith
  rw [sectorAngleDenom, Real.smoothTransition.one_of_one_le harg]
  ring

theorem contDiff_sectorAngleDenom :
    ContDiff Real (⊤ : ℕ∞) sectorAngleDenom := by
  unfold sectorAngleDenom
  apply contDiff_const.add
  apply (contDiff_id.sub contDiff_const).mul
  exact (Real.smoothTransition.contDiff (n := (⊤ : ℕ∞))).comp
    ((contDiff_id.sub contDiff_const).div_const (1 / 32 : Real))

/-- A globally smooth extension of the local polar angle.  The sector bumps
below are supported where its regularized denominator is the true normal
coordinate, so this extension is a genuine polar angle wherever used. -/
def globalSectorAngle (j : SectorIndex) (xi : Euclidean 2) : Real :=
  sectorBaseAngle j + Real.arctan
    (sectorTangentProjection j xi /
      sectorAngleDenom (sectorProjection j xi))

theorem contDiff_globalSectorAngle (j : SectorIndex) :
    ContDiff Real (⊤ : ℕ∞) (globalSectorAngle j) := by
  have hden : ContDiff Real (⊤ : ℕ∞)
      (fun xi : Euclidean 2 => sectorAngleDenom (sectorProjection j xi)) :=
    contDiff_sectorAngleDenom.comp (contDiff_sectorProjection j)
  have hquot : ContDiff Real (⊤ : ℕ∞)
      (fun xi : Euclidean 2 => sectorTangentProjection j xi /
        sectorAngleDenom (sectorProjection j xi)) :=
    (contDiff_sectorTangentProjection j).div hden
      (fun xi => ne_of_gt (sectorAngleDenom_pos _))
  unfold globalSectorAngle
  exact contDiff_const.add
    ((Real.contDiff_arctan (n := (⊤ : ℕ∞))).comp hquot)

theorem neg_four_lt_globalSectorAngle (j : SectorIndex) (xi : Euclidean 2) :
    -4 < globalSectorAngle j xi := by
  have hpi : Real.pi < 4 := Real.pi_lt_four
  have hpipos : 0 < Real.pi := Real.pi_pos
  have harg := Real.neg_pi_div_two_lt_arctan
    (sectorTangentProjection j xi /
      sectorAngleDenom (sectorProjection j xi))
  rcases j with ⟨b, k⟩
  cases b <;> fin_cases k <;>
    simp [globalSectorAngle, sectorBaseAngle] at harg ⊢ <;>
    nlinarith

/-- A buffered coordinate cutoff: it vanishes before the chart boundary and
is one once the chart's normal coordinate reaches `1/4`. -/
def bufferedSectorBump (j : SectorIndex) (xi : Euclidean 2) : Real :=
  Real.smoothTransition (8 * sectorProjection j xi - 1)

theorem contDiff_bufferedSectorBump (j : SectorIndex) :
    ContDiff Real (⊤ : ℕ∞) (bufferedSectorBump j) := by
  unfold bufferedSectorBump
  exact (Real.smoothTransition.contDiff (n := (⊤ : ℕ∞))).comp
    (contDiff_const.mul (contDiff_sectorProjection j) |>.sub contDiff_const)

theorem bufferedSectorBump_eq_zero_of_projection_le_eighth
    {j : SectorIndex} {xi : Euclidean 2}
    (h : sectorProjection j xi ≤ 1 / 8) :
    bufferedSectorBump j xi = 0 := by
  unfold bufferedSectorBump
  apply Real.smoothTransition.zero_of_nonpos
  linarith

theorem bufferedSectorBump_eq_one_of_quarter_le_projection
    {j : SectorIndex} {xi : Euclidean 2}
    (h : 1 / 4 ≤ sectorProjection j xi) :
    bufferedSectorBump j xi = 1 := by
  unfold bufferedSectorBump
  apply Real.smoothTransition.one_of_one_le
  linarith

theorem bufferedSectorBump_ne_zero_imp_eighth_lt_projection
    {j : SectorIndex} {xi : Euclidean 2}
    (h : bufferedSectorBump j xi ≠ 0) :
    1 / 8 < sectorProjection j xi := by
  apply lt_of_not_ge
  intro hle
  exact h (bufferedSectorBump_eq_zero_of_projection_le_eighth hle)

theorem exists_sectorProjection_quarter_le_of_norm_half_le
    (xi : Euclidean 2) (hnorm : 1 / 2 ≤ ‖xi‖) :
    ∃ j : SectorIndex, 1 / 4 ≤ sectorProjection j xi := by
  by_cases hxpos : (1 / 4 : Real) ≤ xi 0
  · exact ⟨(true, 0), by simpa [sectorProjection] using hxpos⟩
  by_cases hxneg : (1 / 4 : Real) ≤ -xi 0
  · exact ⟨(false, 0), by simpa [sectorProjection] using hxneg⟩
  by_cases hypos : (1 / 4 : Real) ≤ xi 1
  · exact ⟨(true, 1), by simpa [sectorProjection] using hypos⟩
  by_cases hyneg : (1 / 4 : Real) ≤ -xi 1
  · exact ⟨(false, 1), by simpa [sectorProjection] using hyneg⟩
  have hxupper : xi 0 < 1 / 4 := lt_of_not_ge hxpos
  have hxlower : -(1 / 4 : Real) < xi 0 := by
    have : -xi 0 < 1 / 4 := lt_of_not_ge hxneg
    linarith
  have hyupper : xi 1 < 1 / 4 := lt_of_not_ge hypos
  have hylower : -(1 / 4 : Real) < xi 1 := by
    have : -xi 1 < 1 / 4 := lt_of_not_ge hyneg
    linarith
  have hxsq : xi 0 ^ 2 < (1 / 4 : Real) ^ 2 := by nlinarith
  have hysq : xi 1 ^ 2 < (1 / 4 : Real) ^ 2 := by nlinarith
  have hnormsq : (1 / 2 : Real) ^ 2 ≤ ‖xi‖ ^ 2 := by
    nlinarith [norm_nonneg xi]
  rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two] at hnormsq
  nlinarith

/-- The four charts are ordered cyclically only to turn the buffered cover
into an exact partition without a singular normalization denominator. -/
def chartSectorIndex (j : Fin 4) : SectorIndex :=
  Fin.cases (true, 0) (fun j =>
    Fin.cases (false, 0) (fun j =>
      Fin.cases (true, 1) (fun _ => (false, 1)) j) j) j

@[simp] theorem chartSectorIndex_zero : chartSectorIndex 0 = (true, 0) := rfl
@[simp] theorem chartSectorIndex_one : chartSectorIndex 1 = (false, 0) := rfl
@[simp] theorem chartSectorIndex_two : chartSectorIndex 2 = (true, 1) := rfl
@[simp] theorem chartSectorIndex_three : chartSectorIndex 3 = (false, 1) := rfl

def chartBufferedBump (j : Fin 4) (xi : Euclidean 2) : Real :=
  bufferedSectorBump (chartSectorIndex j) xi

def chartOrderedWeight (j : Fin 4) (xi : Euclidean 2) : Real :=
  if j = 0 then chartBufferedBump 0 xi else
  if j = 1 then (1 - chartBufferedBump 0 xi) * chartBufferedBump 1 xi else
  if j = 2 then (1 - chartBufferedBump 0 xi) *
      (1 - chartBufferedBump 1 xi) * chartBufferedBump 2 xi else
    (1 - chartBufferedBump 0 xi) * (1 - chartBufferedBump 1 xi) *
      (1 - chartBufferedBump 2 xi) * chartBufferedBump 3 xi

theorem contDiff_chartBufferedBump (j : Fin 4) :
    ContDiff Real (⊤ : ℕ∞) (chartBufferedBump j) :=
  contDiff_bufferedSectorBump (chartSectorIndex j)

theorem contDiff_chartOrderedWeight (j : Fin 4) :
    ContDiff Real (⊤ : ℕ∞) (chartOrderedWeight j) := by
  fin_cases j <;>
    simp <;>
    first
    | exact contDiff_chartBufferedBump 0
    | exact (contDiff_const.sub (contDiff_chartBufferedBump 0)).mul
        (contDiff_chartBufferedBump 1)
    | exact ((contDiff_const.sub (contDiff_chartBufferedBump 0)).mul
        (contDiff_const.sub (contDiff_chartBufferedBump 1))).mul
          (contDiff_chartBufferedBump 2)
    | exact (((contDiff_const.sub (contDiff_chartBufferedBump 0)).mul
        (contDiff_const.sub (contDiff_chartBufferedBump 1))).mul
          (contDiff_const.sub (contDiff_chartBufferedBump 2))).mul
            (contDiff_chartBufferedBump 3)

theorem chartOrderedWeight_eq_zero_of_chartBufferedBump_eq_zero
    (j : Fin 4) (xi : Euclidean 2)
    (h : chartBufferedBump j xi = 0) : chartOrderedWeight j xi = 0 := by
  fin_cases j <;> simp_all [chartOrderedWeight]

theorem chartOrderedWeight_ne_zero_imp_buffered_ne_zero
    {j : Fin 4} {xi : Euclidean 2}
    (h : chartOrderedWeight j xi ≠ 0) : chartBufferedBump j xi ≠ 0 := by
  intro hz
  exact h (chartOrderedWeight_eq_zero_of_chartBufferedBump_eq_zero j xi hz)

theorem exists_chartBufferedBump_eq_one_of_norm_half_le
    (xi : Euclidean 2) (hnorm : 1 / 2 ≤ ‖xi‖) :
    ∃ j : Fin 4, chartBufferedBump j xi = 1 := by
  rcases exists_sectorProjection_quarter_le_of_norm_half_le xi hnorm with ⟨j, hj⟩
  rcases j with ⟨b, k⟩
  cases b <;> fin_cases k
  · refine ⟨1, ?_⟩
    simp [chartBufferedBump]
    simpa using bufferedSectorBump_eq_one_of_quarter_le_projection hj
  · refine ⟨3, ?_⟩
    simp [chartBufferedBump]
    simpa using bufferedSectorBump_eq_one_of_quarter_le_projection hj
  · refine ⟨0, ?_⟩
    simp [chartBufferedBump]
    simpa using bufferedSectorBump_eq_one_of_quarter_le_projection hj
  · refine ⟨2, ?_⟩
    simp [chartBufferedBump]
    simpa using bufferedSectorBump_eq_one_of_quarter_le_projection hj

theorem sum_chartOrderedWeight_eq_one_sub_product (xi : Euclidean 2) :
    ∑ j : Fin 4, chartOrderedWeight j xi =
      1 - (1 - chartBufferedBump 0 xi) * (1 - chartBufferedBump 1 xi) *
        (1 - chartBufferedBump 2 xi) * (1 - chartBufferedBump 3 xi) := by
  simp [Fin.sum_univ_succ, chartOrderedWeight]
  ring

theorem sum_chartOrderedWeight_eq_one_of_exists_chartBufferedBump_eq_one
    (xi : Euclidean 2)
    (h : ∃ j : Fin 4, chartBufferedBump j xi = 1) :
    ∑ j : Fin 4, chartOrderedWeight j xi = 1 := by
  rcases h with ⟨j, hj⟩
  rw [sum_chartOrderedWeight_eq_one_sub_product]
  fin_cases j <;> simp_all

theorem contDiff_sectorWeight (j : SectorIndex) :
    ContDiff Real (⊤ : ℕ∞) (sectorWeight j) := by
  unfold sectorWeight
  exact (Real.smoothTransition.contDiff (n := (⊤ : ℕ∞))).comp
    (contDiff_sectorProjection j)

theorem contDiff_sectorWeightSum :
    ContDiff Real (⊤ : ℕ∞) sectorWeightSum := by
  change ContDiff Real (⊤ : ℕ∞) (fun xi => ∑ j : SectorIndex, sectorWeight j xi)
  apply ContDiff.sum
  intro j _
  exact contDiff_sectorWeight j

theorem contDiffOn_sectorPartition (j : SectorIndex) :
    ContDiffOn Real (⊤ : ℕ∞) (sectorPartition j) ({0}ᶜ : Set (Euclidean 2)) := by
  unfold sectorPartition
  apply (contDiff_sectorWeight j).contDiffOn.div
    contDiff_sectorWeightSum.contDiffOn
  intro xi hxi
  exact sectorWeightSum_ne_zero_of_ne_zero hxi

/-- A fixed radial annular cutoff.  It is one on the unit dyadic annulus,
vanishes on a neighborhood of the origin, and has compact support.  The
puncture makes the normalized sector weights globally smooth after
multiplication. -/
noncomputable def outerSectorRadialBump : ContDiffBump (0 : Euclidean 2) :=
  ⟨2, 3, by norm_num, by norm_num⟩

noncomputable def innerSectorRadialBump : ContDiffBump (0 : Euclidean 2) :=
  ⟨1 / 4, 1 / 2, by norm_num, by norm_num⟩

noncomputable def sectorAnnularCutoff (xi : Euclidean 2) : Real :=
  outerSectorRadialBump xi * (1 - innerSectorRadialBump xi)

theorem contDiff_sectorAnnularCutoff :
    ContDiff Real (⊤ : ℕ∞) sectorAnnularCutoff := by
  unfold sectorAnnularCutoff
  exact outerSectorRadialBump.contDiff.mul
    (contDiff_const.sub innerSectorRadialBump.contDiff)

theorem hasCompactSupport_sectorAnnularCutoff :
    HasCompactSupport sectorAnnularCutoff := by
  unfold sectorAnnularCutoff
  exact outerSectorRadialBump.hasCompactSupport.mul_right

theorem sectorAnnularCutoff_eq_one {xi : Euclidean 2}
    (hlo : 1 / 2 ≤ ‖xi‖) (hhi : ‖xi‖ ≤ 2) :
    sectorAnnularCutoff xi = 1 := by
  have houter : xi ∈ Metric.closedBall (0 : Euclidean 2) outerSectorRadialBump.rIn := by
    simpa only [outerSectorRadialBump, Metric.mem_closedBall,
      dist_zero_right] using hhi
  have hinner : innerSectorRadialBump.rOut ≤ dist xi (0 : Euclidean 2) := by
    simpa only [innerSectorRadialBump, dist_zero_right] using hlo
  unfold sectorAnnularCutoff
  rw [outerSectorRadialBump.one_of_mem_closedBall houter,
    innerSectorRadialBump.zero_of_le_dist hinner]
  norm_num

theorem sectorAnnularCutoff_eq_zero_of_norm_le_quarter {xi : Euclidean 2}
    (h : ‖xi‖ ≤ 1 / 4) : sectorAnnularCutoff xi = 0 := by
  have hinner : xi ∈ Metric.closedBall (0 : Euclidean 2) innerSectorRadialBump.rIn := by
    simpa only [innerSectorRadialBump, Metric.mem_closedBall,
      dist_zero_right] using h
  unfold sectorAnnularCutoff
  rw [innerSectorRadialBump.one_of_mem_closedBall hinner]
  ring

theorem contDiff_sectorAnnularCutoff_complex :
    ContDiff Real (⊤ : ℕ∞) (fun xi : Euclidean 2 =>
      (sectorAnnularCutoff xi : Complex)) := by
  change ContDiff Real (⊤ : ℕ∞) (Complex.ofRealCLM ∘ sectorAnnularCutoff)
  exact Complex.ofRealCLM.contDiff.comp contDiff_sectorAnnularCutoff

theorem hasCompactSupport_sectorAnnularCutoff_complex :
    HasCompactSupport (fun xi : Euclidean 2 =>
      (sectorAnnularCutoff xi : Complex)) := by
  change HasCompactSupport (Complex.ofRealCLM ∘ sectorAnnularCutoff)
  exact hasCompactSupport_sectorAnnularCutoff.comp_left (by rfl)

theorem contDiffOn_sectorPartition_complex (j : SectorIndex) :
    ContDiffOn Real (⊤ : ℕ∞) (fun xi : Euclidean 2 =>
      (sectorPartition j xi : Complex)) ({0}ᶜ : Set (Euclidean 2)) := by
  change ContDiffOn Real (⊤ : ℕ∞) (Complex.ofRealCLM ∘ sectorPartition j)
    ({0}ᶜ : Set (Euclidean 2))
  exact Complex.ofRealCLM.contDiff.comp_contDiffOn (contDiffOn_sectorPartition j)

/-- The compact, globally smooth sector multiplier.  It agrees with the
normalized four-chart partition on the unit dyadic annulus. -/
noncomputable def sectorAnnularMultiplier (j : SectorIndex)
    (xi : Euclidean 2) : Complex :=
  (sectorAnnularCutoff xi : Complex) * (sectorPartition j xi : Complex)

private theorem sectorAnnularCutoff_complex_eq_zero_on_ball
    {xi : Euclidean 2} (hxi : xi ∈ Metric.ball (0 : Euclidean 2) (1 / 4)) :
    (sectorAnnularCutoff xi : Complex) = 0 := by
  have hnorm : ‖xi‖ ≤ 1 / 4 := by
    rw [Metric.mem_ball, dist_zero_right] at hxi
    exact hxi.le
  simp [sectorAnnularCutoff_eq_zero_of_norm_le_quarter hnorm]

theorem contDiff_sectorAnnularMultiplier (j : SectorIndex) :
    ContDiff Real (⊤ : ℕ∞) (sectorAnnularMultiplier j) := by
  let chi : Euclidean 2 → Complex := fun xi => (sectorAnnularCutoff xi : Complex)
  let m : Euclidean 2 → Complex := fun xi => (sectorPartition j xi : Complex)
  have hchi : ContDiff Real (⊤ : ℕ∞) chi := by
    exact contDiff_sectorAnnularCutoff_complex
  have hm : ContDiffOn Real (⊤ : ℕ∞) m ({0}ᶜ : Set (Euclidean 2)) := by
    exact contDiffOn_sectorPartition_complex j
  have hoff : ContDiffOn Real (⊤ : ℕ∞) (fun xi => chi xi * m xi)
      ({0}ᶜ : Set (Euclidean 2)) :=
    hchi.contDiffOn.mul hm
  have hnear : ContDiffOn Real (⊤ : ℕ∞) (fun xi => chi xi * m xi)
      (Metric.ball (0 : Euclidean 2) (1 / 4)) := by
    apply (contDiff_const : ContDiff Real (⊤ : ℕ∞)
      (fun _ : Euclidean 2 => (0 : Complex))).contDiffOn.congr
    intro xi hxi
    simp only [chi, m]
    rw [sectorAnnularCutoff_complex_eq_zero_on_ball hxi]
    simp
  have hunion : ({0}ᶜ : Set (Euclidean 2)) ∪
      Metric.ball (0 : Euclidean 2) (1 / 4) = Set.univ := by
    apply Set.eq_univ_of_forall
    intro xi
    by_cases hxi : xi = 0
    · subst xi
      apply Or.inr
      rw [Metric.mem_ball, dist_self]
      norm_num
    · exact Or.inl hxi
  have hglobal : ContDiffOn Real (⊤ : ℕ∞) (fun xi => chi xi * m xi)
      Set.univ := by
    rw [← hunion]
    exact hoff.union_of_isOpen hnear isOpen_compl_singleton Metric.isOpen_ball
  change ContDiff Real (⊤ : ℕ∞) (fun xi =>
    (sectorAnnularCutoff xi : Complex) * (sectorPartition j xi : Complex))
  exact contDiffOn_univ.mp hglobal

theorem hasCompactSupport_sectorAnnularMultiplier (j : SectorIndex) :
    HasCompactSupport (sectorAnnularMultiplier j) := by
  unfold sectorAnnularMultiplier
  exact hasCompactSupport_sectorAnnularCutoff_complex.mul_right

theorem sum_sectorAnnularMultiplier_eq_one_on_unitAnnulus
    {xi : Euclidean 2} (hlo : 1 / 2 ≤ ‖xi‖) (hhi : ‖xi‖ ≤ 2) :
    ∑ j : SectorIndex, sectorAnnularMultiplier j xi = 1 := by
  have hxi : xi ≠ 0 := by
    intro hz
    subst xi
    norm_num at hlo
  unfold sectorAnnularMultiplier
  rw [← Finset.mul_sum]
  rw [show (∑ j : SectorIndex, (sectorPartition j xi : Complex)) = 1 by
    norm_cast
    exact sum_sectorPartition_eq_one hxi]
  simp [sectorAnnularCutoff_eq_one hlo hhi]

/-- The compact smooth Complex multiplier attached to one of the four
ordered chart pieces. -/
noncomputable def chartAnnularMultiplier (j : Fin 4)
    (xi : Euclidean 2) : Complex :=
  (sectorAnnularCutoff xi : Complex) * (chartOrderedWeight j xi : Complex)

theorem contDiff_chartOrderedWeight_complex (j : Fin 4) :
    ContDiff Real (⊤ : ℕ∞) (fun xi : Euclidean 2 =>
      (chartOrderedWeight j xi : Complex)) := by
  change ContDiff Real (⊤ : ℕ∞) (Complex.ofRealCLM ∘ chartOrderedWeight j)
  exact Complex.ofRealCLM.contDiff.comp (contDiff_chartOrderedWeight j)

theorem contDiff_chartAnnularMultiplier (j : Fin 4) :
    ContDiff Real (⊤ : ℕ∞) (chartAnnularMultiplier j) := by
  unfold chartAnnularMultiplier
  exact contDiff_sectorAnnularCutoff_complex.mul
    (contDiff_chartOrderedWeight_complex j)

theorem hasCompactSupport_chartAnnularMultiplier (j : Fin 4) :
    HasCompactSupport (chartAnnularMultiplier j) := by
  unfold chartAnnularMultiplier
  exact hasCompactSupport_sectorAnnularCutoff_complex.mul_right

noncomputable def chartAnnularMultiplierSchwartz (j : Fin 4) :
    SchwartzMap (Euclidean 2) Complex :=
  (hasCompactSupport_chartAnnularMultiplier j).toSchwartzMap
    (contDiff_chartAnnularMultiplier j)

theorem chartAnnularMultiplierSchwartz_apply (j : Fin 4) (xi : Euclidean 2) :
    chartAnnularMultiplierSchwartz j xi = chartAnnularMultiplier j xi := rfl

theorem hasCompactSupport_chartAnnularMultiplierSchwartz (j : Fin 4) :
    HasCompactSupport (chartAnnularMultiplierSchwartz j : Euclidean 2 → Complex) := by
  change HasCompactSupport (chartAnnularMultiplier j)
  exact hasCompactSupport_chartAnnularMultiplier j

def unitDyadicFrequencyAnnulus : Set (Euclidean 2) :=
  {xi | 1 / 2 ≤ ‖xi‖ ∧ ‖xi‖ ≤ 2}

theorem sum_chartAnnularMultiplier_eq_one_on_unitDyadicFrequencyAnnulus
    {xi : Euclidean 2} (hxi : xi ∈ unitDyadicFrequencyAnnulus) :
    ∑ j : Fin 4, chartAnnularMultiplier j xi = 1 := by
  rcases hxi with ⟨hlo, hhi⟩
  have hweights : ∑ j : Fin 4, chartOrderedWeight j xi = 1 :=
    sum_chartOrderedWeight_eq_one_of_exists_chartBufferedBump_eq_one xi
      (exists_chartBufferedBump_eq_one_of_norm_half_le xi hlo)
  have hweightsC : ∑ j : Fin 4, (chartOrderedWeight j xi : Complex) = 1 := by
    norm_cast
  have hcut : (sectorAnnularCutoff xi : Complex) = 1 := by
    norm_cast
    exact sectorAnnularCutoff_eq_one hlo hhi
  unfold chartAnnularMultiplier
  rw [← Finset.mul_sum, hcut, one_mul, hweightsC]

theorem sum_chartAnnularMultiplierSchwartz_eq_one_on_unitDyadicFrequencyAnnulus
    {xi : Euclidean 2} (hxi : xi ∈ unitDyadicFrequencyAnnulus) :
    ∑ j : Fin 4, chartAnnularMultiplierSchwartz j xi = 1 := by
  simp_rw [chartAnnularMultiplierSchwartz_apply]
  exact sum_chartAnnularMultiplier_eq_one_on_unitDyadicFrequencyAnnulus hxi

theorem chartOrderedWeight_ne_zero_imp_eighth_lt_projection
    {j : Fin 4} {xi : Euclidean 2}
    (h : chartOrderedWeight j xi ≠ 0) :
    1 / 8 < sectorProjection (chartSectorIndex j) xi :=
  bufferedSectorBump_ne_zero_imp_eighth_lt_projection
    (chartOrderedWeight_ne_zero_imp_buffered_ne_zero h)

theorem chartAnnularMultiplier_ne_zero_imp_eighth_lt_projection
    {j : Fin 4} {xi : Euclidean 2}
    (h : chartAnnularMultiplier j xi ≠ 0) :
    1 / 8 < sectorProjection (chartSectorIndex j) xi := by
  apply chartOrderedWeight_ne_zero_imp_eighth_lt_projection
  intro hweight
  apply h
  unfold chartAnnularMultiplier
  rw [hweight]
  simp

theorem globalSectorAngle_eq_sectorAngle_of_eighth_lt_projection
    {j : SectorIndex} {xi : Euclidean 2}
    (h : 1 / 8 < sectorProjection j xi) :
    globalSectorAngle j xi = sectorAngle j xi := by
  unfold globalSectorAngle sectorAngle
  rw [sectorAngleDenom_eq_self_of_one_sixteenth_le (by linarith)]

theorem chartAnnularMultiplier_polar_on_nonzero
    (j : Fin 4) (xi : Euclidean 2)
    (h : chartAnnularMultiplier j xi ≠ 0) :
    xi = ‖xi‖ • circleDirection (globalSectorAngle (chartSectorIndex j) xi) := by
  have hp : 0 < sectorProjection (chartSectorIndex j) xi := by
    exact lt_trans (by norm_num)
      (chartAnnularMultiplier_ne_zero_imp_eighth_lt_projection h)
  rw [globalSectorAngle_eq_sectorAngle_of_eighth_lt_projection
    (chartAnnularMultiplier_ne_zero_imp_eighth_lt_projection h)]
  exact sectorAngle_polar_of_projection_pos hp

/-- The concrete four-chart family consumed by the finite-tensor angular
Plancherel stage.  It has no global argument branch cut: every chart angle
is smooth on all of frequency space, while the polar identity is proved on
the nonzero multiplier support. -/
noncomputable def unitDyadicFourChartFamily :
    SmoothAngularFrequencyChartFamily (Fin 4) Finset.univ
      unitDyadicFrequencyAnnulus where
  sector := chartAnnularMultiplierSchwartz
  sector_compact := by
    intro j _
    exact hasCompactSupport_chartAnnularMultiplierSchwartz j
  angle := fun j => globalSectorAngle (chartSectorIndex j)
  angle_smooth := by
    intro j
    exact contDiff_globalSectorAngle (chartSectorIndex j)
  angle_lower := by
    intro j _ xi
    exact neg_four_lt_globalSectorAngle (chartSectorIndex j) xi
  polar_on_sector := by
    intro j _ xi h
    rw [chartAnnularMultiplierSchwartz_apply] at h
    exact chartAnnularMultiplier_polar_on_nonzero j xi h
  sum_eq_one_on_active := by
    intro xi hxi
    simpa using
      sum_chartAnnularMultiplierSchwartz_eq_one_on_unitDyadicFrequencyAnnulus hxi
  card_le_four := by
    norm_num

end

end Auto.Spherical.MSS
end
-- END ScratchKakeyaSectorPartition

