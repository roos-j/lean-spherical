    {κ : Type*} (charts : Finset κ)
    {F D : κ → Real → Euclidean 2 → Complex}
    {lo hi : Real} {E0 E1 : κ → Real}
    (hlohi : lo ≤ hi)
    (hFcont : ∀ j ∈ charts, Continuous (Function.uncurry (F j)))
    (hDcont : ∀ j ∈ charts, Continuous (Function.uncurry (D j)))
    (hderiv : ∀ j ∈ charts, ∀ theta y,
      HasDerivAt (fun r => F j r y) (D j theta y) theta)
    (hzero : ∀ j ∈ charts, ∀ y, F j lo y = 0)
    (hFmem : ∀ j ∈ charts, MemLp (fun p : Real × Euclidean 2 =>
      F j p.1 p.2) 2 ((volume.restrict (Icc lo hi)).prod volume))
    (hDmem : ∀ j ∈ charts, MemLp (fun p : Real × Euclidean 2 =>
      D j p.1 p.2) 2 ((volume.restrict (Icc lo hi)).prod volume))
    (hE0 : ∀ j ∈ charts, (∫ p : Real × Euclidean 2,
      ‖F j p.1 p.2‖ ^ 2 ∂ ((volume.restrict (Icc lo hi)).prod volume)) ≤ E0 j)
    (hE1 : ∀ j ∈ charts, (∫ p : Real × Euclidean 2,
      ‖D j p.1 p.2‖ ^ 2 ∂ ((volume.restrict (Icc lo hi)).prod volume)) ≤ E1 j) :
    (∫⁻ y : Euclidean 2, ∑ j ∈ charts,
      ⨆ theta : Icc lo hi, ENNReal.ofReal (‖F j theta.1 y‖ ^ 2)) ≤
      ∑ j ∈ charts, ENNReal.ofReal (2 * Real.sqrt (E0 j * E1 j)) := by
  have hchart : ∀ j ∈ charts,
      Measurable (fun y : Euclidean 2 =>
        ⨆ theta : Icc lo hi, ENNReal.ofReal (‖F j theta.1 y‖ ^ 2)) ∧
