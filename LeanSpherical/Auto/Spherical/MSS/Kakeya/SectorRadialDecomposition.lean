section Auto.Spherical.MSS

open Filter MeasureTheory FourierTransform Set
open Auto.Spherical.SurfaceMeasureDecay
open scoped BigOperators Convolution FourierTransform EuclideanSpace

noncomputable section

/-- At a fixed spatial frequency, a finite separated space-time tensor is a
finite `L¹` time profile. -/
noncomputable def scratch_finiteTensorTimeData
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2) :
    Real → Complex :=
  fun t => ∑ i ∈ s, q i xi * a i t

theorem scratch_integrable_finiteTensorTimeData
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2) :
    Integrable (scratch_finiteTensorTimeData s q a xi) := by
  classical
  unfold scratch_finiteTensorTimeData
  induction s using Finset.induction_on with
  | empty => simp
  | insert b s hb ih =>
      have hnew := ((a b).integrable.const_mul (q b xi)).add ih
      apply hnew.congr
      filter_upwards with t
      rw [Finset.sum_insert hb]
      rfl

/-- The negative Fourier phase dictated by the library convention.  Its
`TT*` product has phase `-(t-s)⟪omega,xi⟫`; the shell norm bounds are
unchanged on reversing this sign. -/
noncomputable def scratch_lightRayTimePhase
    (omega xi : Euclidean 2) (t : Real) : Complex :=
  (Real.fourierChar (-inner Real t (inner Real omega xi)) : Complex)

/-- Conjugating the library's negative Fourier phase produces the signed
`-(t-s)` phase in the time `TT*` kernel. -/
theorem scratch_lightRayTimePhase_ttstar
    (omega xi : Euclidean 2) (t s : Real) :
    scratch_lightRayTimePhase omega xi t *
      starRingEnd Complex (scratch_lightRayTimePhase omega xi s) =
      (Real.fourierChar
        (-inner Real (t - s) (inner Real omega xi)) : Complex) := by
  unfold scratch_lightRayTimePhase
  simp only [Real.fourierChar_apply]
  rw [← Complex.exp_conj]
  simp only [map_mul, Complex.conj_ofReal, Complex.conj_I]
  rw [← Complex.exp_add]
  congr 1
  push_cast
  rw [inner_sub_left]
  have hsub :
      (↑(inner Real t (inner Real omega xi) -
        inner Real s (inner Real omega xi)) : Complex) =
        ↑(inner Real t (inner Real omega xi)) -
          ↑(inner Real s (inner Real omega xi)) := by
    norm_cast
  rw [hsub]
  ring

theorem scratch_integrable_phased_finiteTensorTimeData
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) (omega xi : Euclidean 2) :
    Integrable (fun t =>
      scratch_lightRayTimePhase omega xi t * scratch_finiteTensorTimeData s q a xi t) := by
  have hdata := scratch_integrable_finiteTensorTimeData s q a xi
  have hphase : Continuous (scratch_lightRayTimePhase omega xi) := by
    unfold scratch_lightRayTimePhase
    fun_prop
  refine hdata.congr' ?_ ?_
  · exact hphase.aestronglyMeasurable.mul hdata.aestronglyMeasurable
  · filter_upwards with t
    unfold scratch_lightRayTimePhase
    simp only [norm_mul, Circle.norm_coe, one_mul]

/-- Pointwise form of the time `TT*` integrand.  The right-hand phase is the
negative-sign counterpart of Airy's `+(t-s)` convention. -/
theorem scratch_phased_finiteTensorTimeData_ttstar_integrand
    {ι : Type*} (s0 : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) (omega xi : Euclidean 2) (t s : Real) :
    (scratch_lightRayTimePhase omega xi t * scratch_finiteTensorTimeData s0 q a xi t) *
      starRingEnd Complex
        (scratch_lightRayTimePhase omega xi s * scratch_finiteTensorTimeData s0 q a xi s) =
      (Real.fourierChar
        (-inner Real (t - s) (inner Real omega xi)) : Complex) *
        (scratch_finiteTensorTimeData s0 q a xi t *
          starRingEnd Complex (scratch_finiteTensorTimeData s0 q a xi s)) := by
  calc
    (scratch_lightRayTimePhase omega xi t * scratch_finiteTensorTimeData s0 q a xi t) *
        starRingEnd Complex
          (scratch_lightRayTimePhase omega xi s * scratch_finiteTensorTimeData s0 q a xi s) =
        (scratch_lightRayTimePhase omega xi t *
          starRingEnd Complex (scratch_lightRayTimePhase omega xi s)) *
          (scratch_finiteTensorTimeData s0 q a xi t *
            starRingEnd Complex (scratch_finiteTensorTimeData s0 q a xi s)) := by
          rw [map_mul]
          ring
    _ = _ := by rw [scratch_lightRayTimePhase_ttstar]

private theorem scratch_integrable_phased_tensor_term
    {ι : Type*} (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) (omega xi : Euclidean 2) (i : ι) :
    Integrable (fun t =>
      scratch_lightRayTimePhase omega xi t * (q i xi * a i t)) := by
  have hbase : Integrable (fun t => q i xi * a i t) :=
    (a i).integrable.const_mul (q i xi)
  have hphase : Continuous (scratch_lightRayTimePhase omega xi) := by
    unfold scratch_lightRayTimePhase
    fun_prop
  refine hbase.congr' ?_ ?_
  · exact hphase.aestronglyMeasurable.mul hbase.aestronglyMeasurable
  · filter_upwards with t
    unfold scratch_lightRayTimePhase
    simp only [norm_mul, Circle.norm_coe, one_mul]

/-- Exact fixed-frequency time Fourier identity for a finite Schwartz tensor.
This is the input before the circle-shell `TT*` calculation: the right side
is the multiplier occurring in spatial Plancherel, while the left side is a
single time oscillatory integral with all tensor cross terms still present. -/
theorem scratch_finiteTensor_timeFourier_eq_timeIntegral
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) (omega xi : Euclidean 2) :
    ∑ i ∈ s, q i xi * (FourierTransform.fourier (a i) : SchwartzMap Real Complex)
      (inner Real omega xi) =
      ∫ t : Real,
        scratch_lightRayTimePhase omega xi t * scratch_finiteTensorTimeData s q a xi t := by
  classical
  unfold scratch_finiteTensorTimeData
  have hterms : ∀ i ∈ s, Integrable (fun t : Real =>
      scratch_lightRayTimePhase omega xi t * (q i xi * a i t)) := by
    intro i hi
    exact scratch_integrable_phased_tensor_term q a omega xi i
  have hsum :
      (∫ t : Real,
        scratch_lightRayTimePhase omega xi t *
          (∑ i ∈ s, q i xi * a i t)) =
        ∑ i ∈ s, ∫ t : Real,
          scratch_lightRayTimePhase omega xi t * (q i xi * a i t) := by
    have hpoint : (fun t : Real =>
        scratch_lightRayTimePhase omega xi t *
          (∑ i ∈ s, q i xi * a i t)) =
        fun t : Real => ∑ i ∈ s,
          scratch_lightRayTimePhase omega xi t * (q i xi * a i t) := by
      funext t
      rw [Finset.mul_sum]
    rw [hpoint, integral_finsetSum s hterms]
  rw [hsum]
  apply Finset.sum_congr rfl
  intro i hi
  have hcoe :
      (FourierTransform.fourier (a i) : SchwartzMap Real Complex)
          (inner Real omega xi) =
        FourierTransform.fourier (a i : Real → Complex) (inner Real omega xi) :=
    congrFun (SchwartzMap.fourier_coe (a i)) _
  rw [hcoe]
  rw [Real.fourier_eq, ← integral_const_mul]
  apply integral_congr_ae
  filter_upwards with t
  unfold scratch_lightRayTimePhase
  simp only [Circle.smul_def, smul_eq_mul]
  ring

/-- Abstract product/Fubini identity used after the preceding time transform.
It deliberately takes two independently integrable factors, so the `TT*`
application can instantiate the second with the conjugated time profile. -/
theorem scratch_timeProduct_eq_productIntegral
    (F G : Real → Complex) (hF : Integrable F) (hG : Integrable G) :
    (∫ t : Real, F t) * (∫ s : Real, G s) =
      ∫ z : Real × Real, F z.1 * G z.2 := by
  have hprod : Integrable (fun z : Real × Real => F z.1 * G z.2)
      (volume.prod volume) := hF.mul_prod hG
  rw [Measure.volume_eq_prod]
  rw [integral_prod _ hprod]
  calc
    (∫ t : Real, F t) * (∫ s : Real, G s) =
        ∫ t : Real, F t * (∫ s : Real, G s) := by
          rw [integral_mul_const]
    _ = ∫ t : Real, ∫ s : Real, F t * G s := by
      apply integral_congr_ae
      filter_upwards with t
      rw [integral_const_mul]

/-- Conjugation preserves the `L¹` datum required for the second factor in
the time `TT*` product. -/
theorem scratch_integrable_conj_phased_finiteTensorTimeData
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) (omega xi : Euclidean 2) :
    Integrable (fun t => starRingEnd Complex
      (scratch_lightRayTimePhase omega xi t * scratch_finiteTensorTimeData s q a xi t)) := by
  have hF := scratch_integrable_phased_finiteTensorTimeData s q a omega xi
  have hconj := (Complex.conjCLE : Complex →L[Real] Complex).integrable_comp hF
  apply hconj.congr
  filter_upwards with t
  exact Complex.conjCLE_apply _

/-- Exact time-domain `TT*` factorization at a fixed spatial frequency.
Combining this with `scratch_finiteTensor_timeFourier_eq_timeIntegral` turns
the square of the Fourier multiplier into an honest double time integral;
the phase convention is the negative of Airy's `+ (t-s)` kernel, which has
the same absolute-value shell estimates. -/
theorem scratch_finiteTensor_timeTTStar_eq_productIntegral
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) (omega xi : Euclidean 2) :
    (∫ t : Real,
      scratch_lightRayTimePhase omega xi t * scratch_finiteTensorTimeData s q a xi t) *
        starRingEnd Complex (∫ u : Real,
          scratch_lightRayTimePhase omega xi u * scratch_finiteTensorTimeData s q a xi u) =
      ∫ z : Real × Real,
        (scratch_lightRayTimePhase omega xi z.1 * scratch_finiteTensorTimeData s q a xi z.1) *
          starRingEnd Complex
            (scratch_lightRayTimePhase omega xi z.2 * scratch_finiteTensorTimeData s q a xi z.2) := by
  let F : Real → Complex := fun t =>
    scratch_lightRayTimePhase omega xi t * scratch_finiteTensorTimeData s q a xi t
  have hF : Integrable F := by
    exact scratch_integrable_phased_finiteTensorTimeData s q a omega xi
  have hstarF : Integrable (fun t => starRingEnd Complex (F t)) := by
    exact scratch_integrable_conj_phased_finiteTensorTimeData s q a omega xi
  have hstarIntegral :
      (∫ t : Real, starRingEnd Complex (F t)) =
        starRingEnd Complex (∫ t : Real, F t) := by
    calc
      (∫ t : Real, starRingEnd Complex (F t)) =
          ∫ t : Real, (Complex.conjCLE : Complex →L[Real] Complex) (F t) := by
            apply integral_congr_ae
            filter_upwards with t
            exact (Complex.conjCLE_apply _).symm
      _ = (Complex.conjCLE : Complex →L[Real] Complex) (∫ t : Real, F t) :=
        (Complex.conjCLE : Complex →L[Real] Complex).integral_comp_comm hF
      _ = starRingEnd Complex (∫ t : Real, F t) := Complex.conjCLE_apply _
  change (∫ t : Real, F t) * starRingEnd Complex (∫ u : Real, F u) =
    ∫ z : Real × Real, F z.1 * starRingEnd Complex (F z.2)
  rw [← hstarIntegral]
  exact scratch_timeProduct_eq_productIntegral F (fun t => starRingEnd Complex (F t)) hF hstarF

end

end Auto.Spherical.MSS
end
