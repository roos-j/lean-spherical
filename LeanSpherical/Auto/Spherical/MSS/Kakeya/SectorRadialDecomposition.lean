section Auto.Spherical.MSS

open Filter MeasureTheory FourierTransform Set
open Auto.Spherical.SurfaceMeasureDecay
open scoped BigOperators FourierTransform EuclideanSpace

noncomputable section

/-- A Schwartz multiplier depending on an angular parameter, transformed
back only in the spatial variable. -/
noncomputable def fourierInvParametricField
    (m : Real -> SchwartzMap (Euclidean 2) Complex)
    (theta : Real) (y : Euclidean 2) : Complex :=
  FourierTransform.fourierInv (m theta : Euclidean 2 -> Complex) y

/-- Pointwise-in-angle spatial Plancherel for a Schwartz multiplier family. -/
theorem integral_norm_sq_fourierInvParametricField_eq_frequency
    (m : Real -> SchwartzMap (Euclidean 2) Complex) (theta : Real) :
    (∫ y : Euclidean 2, ‖fourierInvParametricField m theta y‖ ^ (2 : Nat)) =
      ∫ xi : Euclidean 2, ‖m theta xi‖ ^ (2 : Nat) := by
  have h := Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq
    (FourierTransform.fourierInv (m theta))
  have hfourier :
      (FourierTransform.fourier
        ((FourierTransform.fourierInv (m theta) : SchwartzMap (Euclidean 2) Complex) :
          Euclidean 2 -> Complex)) = (m theta : Euclidean 2 -> Complex) := by
    rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  calc
    (∫ y : Euclidean 2, ‖fourierInvParametricField m theta y‖ ^ (2 : Nat)) =
        ∫ y : Euclidean 2,
          ‖(FourierTransform.fourierInv (m theta) : SchwartzMap (Euclidean 2) Complex) y‖ ^
            (2 : Nat) := by
          apply integral_congr_ae
          filter_upwards with y
          change ‖FourierTransform.fourierInv
            (m theta : Euclidean 2 -> Complex) y‖ ^ (2 : Nat) = _
          rw [← SchwartzMap.fourierInv_coe]
    _ = ∫ xi : Euclidean 2,
        ‖FourierTransform.fourier
          ((FourierTransform.fourierInv (m theta) : SchwartzMap (Euclidean 2) Complex) :
            Euclidean 2 -> Complex) xi‖ ^ (2 : Nat) := h.symm
    _ = ∫ xi : Euclidean 2, ‖m theta xi‖ ^ (2 : Nat) := by
      apply integral_congr_ae
      filter_upwards with xi
      rw [hfourier]

/-- Fubini-ready angular-spatial Plancherel for an arbitrary parametric
Schwartz multiplier family.  This is the exact transport needed for a
frequency-dependent smooth shell cutoff once that cutoff has been packaged
as a `SchwartzMap` on each fixed angular slice. -/
theorem integral_interval_spatial_sq_fourierInvParametricField_eq_frequency
    (m : Real -> SchwartzMap (Euclidean 2) Complex)
    {lo hi : Real} (hlohi : lo ≤ hi)
    (hfreq : Integrable (fun p : Real × Euclidean 2 =>
      ‖m p.1 p.2‖ ^ (2 : Nat))
      ((volume.restrict (Ioc lo hi)).prod volume)) :
    (∫ theta in lo..hi, ∫ y : Euclidean 2,
      ‖fourierInvParametricField m theta y‖ ^ (2 : Nat)) =
      ∫ xi : Euclidean 2, ∫ theta in lo..hi,
        ‖m theta xi‖ ^ (2 : Nat) := by
  rw [intervalIntegral.integral_of_le hlohi]
  have hpoint (theta : Real) :
      (∫ y : Euclidean 2,
        ‖fourierInvParametricField m theta y‖ ^ (2 : Nat)) =
        ∫ xi : Euclidean 2, ‖m theta xi‖ ^ (2 : Nat) :=
    integral_norm_sq_fourierInvParametricField_eq_frequency m theta
  simp_rw [hpoint]
  rw [integral_integral_swap hfreq]
  apply integral_congr_ae
  filter_upwards with xi
  rw [intervalIntegral.integral_of_le hlohi]

/-- Simultaneous version for a field and its angular derivative multiplier.
No derivative identity is hidden: it is supplied separately by the concrete
smooth chart construction. -/
theorem integral_interval_spatial_sq_fourierInvParametricField_pair_eq_frequency
    (m0 m1 : Real -> SchwartzMap (Euclidean 2) Complex)
    {lo hi : Real} (hlohi : lo ≤ hi)
    (hfreq0 : Integrable (fun p : Real × Euclidean 2 =>
      ‖m0 p.1 p.2‖ ^ (2 : Nat))
      ((volume.restrict (Ioc lo hi)).prod volume))
    (hfreq1 : Integrable (fun p : Real × Euclidean 2 =>
      ‖m1 p.1 p.2‖ ^ (2 : Nat))
      ((volume.restrict (Ioc lo hi)).prod volume)) :
    (∫ theta in lo..hi, ∫ y : Euclidean 2,
      ‖fourierInvParametricField m0 theta y‖ ^ (2 : Nat)) +
        (∫ theta in lo..hi, ∫ y : Euclidean 2,
          ‖fourierInvParametricField m1 theta y‖ ^ (2 : Nat)) =
      (∫ xi : Euclidean 2, ∫ theta in lo..hi,
        ‖m0 theta xi‖ ^ (2 : Nat)) +
      (∫ xi : Euclidean 2, ∫ theta in lo..hi,
          ‖m1 theta xi‖ ^ (2 : Nat)) := by
  rw [integral_interval_spatial_sq_fourierInvParametricField_eq_frequency
      m0 hlohi hfreq0,
    integral_interval_spatial_sq_fourierInvParametricField_eq_frequency
      m1 hlohi hfreq1]

/-- Product-measure form of the same transport.  The physical integrability
assumption is retained explicitly because it is also exactly what the
endpoint-zero Sobolev lemma consumes. -/
theorem integral_product_Icc_spatial_sq_fourierInvParametricField_eq_frequency
    (m : Real -> SchwartzMap (Euclidean 2) Complex) (lo hi : Real)
    (hphysical : Integrable (fun p : Real × Euclidean 2 =>
      ‖fourierInvParametricField m p.1 p.2‖ ^ (2 : Nat))
      ((volume.restrict (Icc lo hi)).prod volume))
    (hfrequency : Integrable (fun p : Real × Euclidean 2 =>
      ‖m p.1 p.2‖ ^ (2 : Nat))
      ((volume.restrict (Icc lo hi)).prod volume)) :
    (∫ p : Real × Euclidean 2,
      ‖fourierInvParametricField m p.1 p.2‖ ^ (2 : Nat) ∂
      ((volume.restrict (Icc lo hi)).prod volume)) =
      ∫ p : Real × Euclidean 2, ‖m p.1 p.2‖ ^ (2 : Nat) ∂
        ((volume.restrict (Icc lo hi)).prod volume) := by
  rw [integral_prod _ hphysical, integral_prod _ hfrequency]
  apply integral_congr_ae
  filter_upwards with theta
  exact integral_norm_sq_fourierInvParametricField_eq_frequency m theta

/-- Paired product-measure transport for the field and its supplied angular
derivative multiplier. -/
theorem integral_product_Icc_spatial_sq_fourierInvParametricField_pair_eq_frequency
    (m0 m1 : Real -> SchwartzMap (Euclidean 2) Complex) (lo hi : Real)
    (hphysical0 : Integrable (fun p : Real × Euclidean 2 =>
      ‖fourierInvParametricField m0 p.1 p.2‖ ^ (2 : Nat))
      ((volume.restrict (Icc lo hi)).prod volume))
    (hphysical1 : Integrable (fun p : Real × Euclidean 2 =>
      ‖fourierInvParametricField m1 p.1 p.2‖ ^ (2 : Nat))
      ((volume.restrict (Icc lo hi)).prod volume))
    (hfrequency0 : Integrable (fun p : Real × Euclidean 2 =>
      ‖m0 p.1 p.2‖ ^ (2 : Nat))
      ((volume.restrict (Icc lo hi)).prod volume))
    (hfrequency1 : Integrable (fun p : Real × Euclidean 2 =>
      ‖m1 p.1 p.2‖ ^ (2 : Nat))
      ((volume.restrict (Icc lo hi)).prod volume)) :
    (∫ p : Real × Euclidean 2,
      ‖fourierInvParametricField m0 p.1 p.2‖ ^ (2 : Nat) ∂
        ((volume.restrict (Icc lo hi)).prod volume)) +
      (∫ p : Real × Euclidean 2,
        ‖fourierInvParametricField m1 p.1 p.2‖ ^ (2 : Nat) ∂
          ((volume.restrict (Icc lo hi)).prod volume)) =
      (∫ p : Real × Euclidean 2, ‖m0 p.1 p.2‖ ^ (2 : Nat) ∂
        ((volume.restrict (Icc lo hi)).prod volume)) +
      (∫ p : Real × Euclidean 2, ‖m1 p.1 p.2‖ ^ (2 : Nat) ∂
        ((volume.restrict (Icc lo hi)).prod volume)) := by
  rw [integral_product_Icc_spatial_sq_fourierInvParametricField_eq_frequency
      m0 lo hi hphysical0 hfrequency0,
    integral_product_Icc_spatial_sq_fourierInvParametricField_eq_frequency
      m1 lo hi hphysical1 hfrequency1]

end

end Auto.Spherical.MSS
