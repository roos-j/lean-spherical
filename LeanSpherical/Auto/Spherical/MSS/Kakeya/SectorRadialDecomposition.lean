section Auto.Spherical.MSS

open Filter MeasureTheory FourierTransform Set
open Auto.Spherical.SurfaceMeasureDecay
open Auto.Spherical.Auxiliary
open Auto.LittlewoodPaley
open scoped BigOperators Convolution FourierTransform ENNReal EuclideanSpace Pointwise

noncomputable section

/-- The lowpass multiplier family attached to a parameterized spatial
multiplier.  Every slice is automatically supported in the fixed ball of
radius two. -/
noncomputable def kakeyaRadialLowpassParametricMultiplier
    (C : lpCutoffs 2)
    (m : Real → SchwartzMap (Euclidean 2) Complex) (theta : Real) :
    SchwartzMap (Euclidean 2) Complex :=
  kakeyaRadialLowpassPiece C (m theta)

/-- Its literal physical field. -/
noncomputable def kakeyaRadialLowpassParametricField
    (C : lpCutoffs 2)
    (m : Real → SchwartzMap (Euclidean 2) Complex)
    (theta : Real) (x : Euclidean 2) : Complex :=
  FourierTransform.fourierInv
    (kakeyaRadialLowpassParametricMultiplier C m theta :
      Euclidean 2 → Complex) x

theorem kakeyaRadialLowpassParametricField_eq_radialPhysicalField
    (C : lpCutoffs 2)
    (m : Real → SchwartzMap (Euclidean 2) Complex)
    (theta : Real) (x : Euclidean 2) :
    kakeyaRadialLowpassParametricField C m theta x =
      kakeyaRadialLowpassPhysicalField C m theta x := by
  unfold kakeyaRadialLowpassParametricField
    kakeyaRadialLowpassParametricMultiplier
    kakeyaRadialLowpassPhysicalField
  rw [SchwartzMap.fourierInv_coe]

theorem support_kakeyaRadialLowpassParametricMultiplier_subset_closedBall_two
    (C : lpCutoffs 2)
    (m : Real → SchwartzMap (Euclidean 2) Complex) (theta : Real) :
    Set.Subset (Function.support
      (kakeyaRadialLowpassParametricMultiplier C m theta :
        Euclidean 2 → Complex)) (Metric.closedBall 0 2) := by
  exact support_kakeyaRadialLowpassPiece_subset_closedBall_two C (m theta)

/-- Periodicity reduces an all-real angular maximum to the fixed closed
fundamental interval. -/
theorem iSup_sq_periodic_parametricField_le_fundamental
    (F : Real → Euclidean 2 → Complex)
    (hperiodic : ∀ x, Function.Periodic (fun theta => F theta x)
      (2 * Real.pi)) (x : Euclidean 2) :
    (⨆ theta : Real, ENNReal.ofReal (‖F theta x‖ ^ 2)) ≤
      ⨆ theta : {r : Real // r ∈ Icc (-Real.pi) Real.pi},
        ENNReal.ofReal (‖F theta.1 x‖ ^ 2) := by
  apply iSup_le
  intro theta
  rcases Function.Periodic.exists_mem_Ico (hperiodic x)
      Real.two_pi_pos theta (-Real.pi) with ⟨beta, hbeta, hEq⟩
  have hright : -Real.pi + 2 * Real.pi = Real.pi := by ring
  rw [hright] at hbeta
  have hbeta' : beta ∈ Icc (-Real.pi) Real.pi :=
    ⟨hbeta.1, hbeta.2.le⟩
  calc
    ENNReal.ofReal (‖F theta x‖ ^ 2) =
        ENNReal.ofReal (‖F beta x‖ ^ 2) := by rw [hEq]
    _ ≤ ⨆ theta : {r : Real // r ∈ Icc (-Real.pi) Real.pi},
        ENNReal.ofReal (‖F theta.1 x‖ ^ 2) :=
      le_iSup (fun theta : {r : Real // r ∈ Icc (-Real.pi) Real.pi} =>
        ENNReal.ofReal (‖F theta.1 x‖ ^ 2)) ⟨beta, hbeta'⟩

theorem iSup_sq_periodic_parametricField_eq_fundamental
    (F : Real → Euclidean 2 → Complex)
    (hperiodic : ∀ x, Function.Periodic (fun theta => F theta x)
      (2 * Real.pi)) (x : Euclidean 2) :
    (⨆ theta : Real, ENNReal.ofReal (‖F theta x‖ ^ 2)) =
      ⨆ theta : {r : Real // r ∈ Icc (-Real.pi) Real.pi},
        ENNReal.ofReal (‖F theta.1 x‖ ^ 2) := by
  apply le_antisymm
  · exact iSup_sq_periodic_parametricField_le_fundamental F hperiodic x
  · apply iSup_le
    intro theta
    exact le_iSup (fun theta : Real => ENNReal.ofReal (‖F theta x‖ ^ 2)) theta.1

/-- Pointwise spatial Plancherel for the lowpass physical family. -/
theorem integral_norm_sq_kakeyaRadialLowpassParametricField_eq_frequency
    (C : lpCutoffs 2)
    (m : Real → SchwartzMap (Euclidean 2) Complex) (theta : Real) :
    (∫ x : Euclidean 2,
      ‖kakeyaRadialLowpassParametricField C m theta x‖ ^ (2 : Nat)) =
      ∫ xi : Euclidean 2,
        ‖kakeyaRadialLowpassParametricMultiplier C m theta xi‖ ^ (2 : Nat) := by
  calc
    (∫ x : Euclidean 2,
      ‖kakeyaRadialLowpassParametricField C m theta x‖ ^ (2 : Nat)) =
        ∫ x : Euclidean 2,
          ‖fourierInvParametricField
            (kakeyaRadialLowpassParametricMultiplier C m) theta x‖ ^ (2 : Nat) := by
      apply integral_congr_ae
      filter_upwards with x
      congr 1
    _ = ∫ xi : Euclidean 2,
        ‖kakeyaRadialLowpassParametricMultiplier C m theta xi‖ ^ (2 : Nat) :=
      integral_norm_sq_fourierInvParametricField_eq_frequency
        (kakeyaRadialLowpassParametricMultiplier C m) theta

/-- Each fixed lowpass physical slice is square-integrable by Schwartz
calculus. -/
theorem integrable_sq_kakeyaRadialLowpassParametricField
    (C : lpCutoffs 2)
    (m : Real → SchwartzMap (Euclidean 2) Complex) (theta : Real) :
    Integrable (fun x : Euclidean 2 =>
      ‖kakeyaRadialLowpassParametricField C m theta x‖ ^ (2 : Nat)) volume := by
  let q : SchwartzMap (Euclidean 2) Complex :=
    FourierTransform.fourierInv (kakeyaRadialLowpassParametricMultiplier C m theta)
  have hq : Integrable (fun x : Euclidean 2 => ‖q x‖ ^ (2 : Nat)) volume :=
    (memLp_two_iff_integrable_sq_norm q.continuous.aestronglyMeasurable).mp
      (q.memLp 2 volume)
  apply hq.congr
  filter_upwards with x
  dsimp only [q, kakeyaRadialLowpassParametricField]
  rw [SchwartzMap.fourierInv_coe]

/-- A fixed-scale global angular `H¹` estimate for the lowpass field.  Its
right side is expressed wholly through the lowpass multiplier at one angle
and the frequency-side angular-derivative energy.  The spatial support is
always the fixed ball of radius two, so no radial scale or logarithmic loss
appears. -/
theorem measurable_and_lintegral_iSup_sq_kakeyaRadialLowpassParametricField_le_globalH1
    (C : lpCutoffs 2)
    (m dm : Real → SchwartzMap (Euclidean 2) Complex)
    (hperiodic : ∀ x, Function.Periodic
      (fun theta => kakeyaRadialLowpassParametricField C m theta x)
      (2 * Real.pi))
    (hFcont : Continuous (Function.uncurry
      (kakeyaRadialLowpassParametricField C m)))
    (hDcont : Continuous (Function.uncurry
      (fourierInvParametricField dm)))
    (hderiv : ∀ theta x, HasDerivAt
      (fun r => kakeyaRadialLowpassParametricField C m r x)
      (fourierInvParametricField dm theta x) theta)
    (hDphysical : Integrable (fun p : Real × Euclidean 2 =>
      ‖fourierInvParametricField dm p.1 p.2‖ ^ (2 : Nat))
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume))
    (hDfrequency : Integrable (fun p : Real × Euclidean 2 =>
      ‖dm p.1 p.2‖ ^ (2 : Nat))
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume))
    {E0 E1 : Real}
    (hE0 : (∫ xi : Euclidean 2,
      ‖kakeyaRadialLowpassParametricMultiplier C m (-Real.pi) xi‖ ^ (2 : Nat)) ≤ E0)
    (hE1 : (∫ p : Real × Euclidean 2, ‖dm p.1 p.2‖ ^ (2 : Nat) ∂
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume)) ≤ E1) :
    Measurable (fun x : Euclidean 2 =>
      ⨆ theta : Real, ENNReal.ofReal
        (‖kakeyaRadialLowpassParametricField C m theta x‖ ^ 2)) ∧
      (∫⁻ x : Euclidean 2, ⨆ theta : Real, ENNReal.ofReal
        (‖kakeyaRadialLowpassParametricField C m theta x‖ ^ 2)) ≤
        ENNReal.ofReal (2 * E0 + 4 * Real.pi * E1) := by
  have hpi : -Real.pi ≤ Real.pi := by linarith [Real.pi_pos]
  have hleft := integrable_sq_kakeyaRadialLowpassParametricField C m (-Real.pi)
  rcases measurable_and_lintegral_iSup_ennreal_norm_sq_le_radiusSobolev_of_hasDerivAt
      (F := kakeyaRadialLowpassParametricField C m)
      (F' := fourierInvParametricField dm)
      hpi hFcont hDcont hderiv hleft hDphysical with ⟨hmeas, hbound⟩
  have hbase :
      (∫ x : Euclidean 2,
        ‖kakeyaRadialLowpassParametricField C m (-Real.pi) x‖ ^ (2 : Nat)) =
        ∫ xi : Euclidean 2,
          ‖kakeyaRadialLowpassParametricMultiplier C m (-Real.pi) xi‖ ^ (2 : Nat) :=
    integral_norm_sq_kakeyaRadialLowpassParametricField_eq_frequency C m (-Real.pi)
  have hderivInterval :
      (∫ theta in (-Real.pi)..Real.pi, ∫ x : Euclidean 2,
        ‖fourierInvParametricField dm theta x‖ ^ (2 : Nat)) =
        ∫ p : Real × Euclidean 2, ‖dm p.1 p.2‖ ^ (2 : Nat) ∂
          ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume) := by
    calc
      (∫ theta in (-Real.pi)..Real.pi, ∫ x : Euclidean 2,
          ‖fourierInvParametricField dm theta x‖ ^ (2 : Nat)) =
          ∫ p : Real × Euclidean 2,
            ‖fourierInvParametricField dm p.1 p.2‖ ^ (2 : Nat) ∂
              ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume) :=
        intervalIntegral_integral_eq_integral_productShell hpi
          (fun theta x => ‖fourierInvParametricField dm theta x‖ ^ (2 : Nat))
          hDphysical
      _ = ∫ p : Real × Euclidean 2, ‖dm p.1 p.2‖ ^ (2 : Nat) ∂
          ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume) :=
        integral_product_Icc_spatial_sq_fourierInvParametricField_eq_frequency
          dm (-Real.pi) Real.pi hDphysical hDfrequency
  have hfundBound :
      (∫⁻ x : Euclidean 2,
        ⨆ theta : {r : Real // r ∈ Icc (-Real.pi) Real.pi},
          ENNReal.ofReal
            (‖kakeyaRadialLowpassParametricField C m theta.1 x‖ ^ 2)) ≤
        ENNReal.ofReal (2 * E0 + 4 * Real.pi * E1) := by
    refine hbound.trans ?_
    apply ENNReal.ofReal_le_ofReal
    rw [hbase, hderivInterval]
    have hscale : 2 * (Real.pi - -Real.pi) = 4 * Real.pi := by ring
    rw [hscale]
    exact add_le_add
      (mul_le_mul_of_nonneg_left hE0 (by norm_num))
      (mul_le_mul_of_nonneg_left hE1 (by positivity))
  have hEq : (fun x : Euclidean 2 =>
      ⨆ theta : Real, ENNReal.ofReal
        (‖kakeyaRadialLowpassParametricField C m theta x‖ ^ 2)) =
      fun x : Euclidean 2 =>
        ⨆ theta : {r : Real // r ∈ Icc (-Real.pi) Real.pi},
          ENNReal.ofReal
            (‖kakeyaRadialLowpassParametricField C m theta.1 x‖ ^ 2) := by
    funext x
    exact iSup_sq_periodic_parametricField_eq_fundamental
      (kakeyaRadialLowpassParametricField C m) hperiodic x
  constructor
  · rw [hEq]
    exact hmeas
  · rw [hEq]
    exact hfundBound

/-- The preceding global `H¹` estimate in exactly the lowpass-field form
consumed as the `B0` premise of finite radial reassembly. -/
theorem measurable_and_lintegral_iSup_sq_kakeyaRadialLowpassPhysicalField_le_globalH1
    (C : lpCutoffs 2)
    (m dm : Real → SchwartzMap (Euclidean 2) Complex)
    (hperiodic : ∀ x, Function.Periodic
      (fun theta => kakeyaRadialLowpassPhysicalField C m theta x)
      (2 * Real.pi))
    (hFcont : Continuous (Function.uncurry
      (kakeyaRadialLowpassPhysicalField C m)))
    (hDcont : Continuous (Function.uncurry
      (fourierInvParametricField dm)))
    (hderiv : ∀ theta x, HasDerivAt
      (fun r => kakeyaRadialLowpassPhysicalField C m r x)
      (fourierInvParametricField dm theta x) theta)
    (hDphysical : Integrable (fun p : Real × Euclidean 2 =>
      ‖fourierInvParametricField dm p.1 p.2‖ ^ (2 : Nat))
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume))
    (hDfrequency : Integrable (fun p : Real × Euclidean 2 =>
      ‖dm p.1 p.2‖ ^ (2 : Nat))
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume))
    {E0 E1 : Real}
    (hE0 : (∫ xi : Euclidean 2,
      ‖kakeyaRadialLowpassParametricMultiplier C m (-Real.pi) xi‖ ^ (2 : Nat)) ≤ E0)
    (hE1 : (∫ p : Real × Euclidean 2, ‖dm p.1 p.2‖ ^ (2 : Nat) ∂
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume)) ≤ E1) :
    Measurable (fun x : Euclidean 2 =>
      ⨆ theta : Real, ENNReal.ofReal
        (‖kakeyaRadialLowpassPhysicalField C m theta x‖ ^ 2)) ∧
      (∫⁻ x : Euclidean 2, ⨆ theta : Real, ENNReal.ofReal
        (‖kakeyaRadialLowpassPhysicalField C m theta x‖ ^ 2)) ≤
        ENNReal.ofReal (2 * E0 + 4 * Real.pi * E1) := by
  have hfieldEq : kakeyaRadialLowpassParametricField C m =
      kakeyaRadialLowpassPhysicalField C m := by
    funext theta x
    exact kakeyaRadialLowpassParametricField_eq_radialPhysicalField C m theta x
  have hperiodic' : ∀ x, Function.Periodic
      (fun theta => kakeyaRadialLowpassParametricField C m theta x)
      (2 * Real.pi) := by
    intro x
    rw [hfieldEq]
    exact hperiodic x
  have hFcont' : Continuous (Function.uncurry
      (kakeyaRadialLowpassParametricField C m)) := by
    rw [hfieldEq]
    exact hFcont
  have hderiv' : ∀ theta x, HasDerivAt
      (fun r => kakeyaRadialLowpassParametricField C m r x)
      (fourierInvParametricField dm theta x) theta := by
    intro theta x
    rw [hfieldEq]
    exact hderiv theta x
  have h := measurable_and_lintegral_iSup_sq_kakeyaRadialLowpassParametricField_le_globalH1
    C m dm hperiodic' hFcont' hDcont hderiv'
    hDphysical hDfrequency hE0 hE1
  rw [hfieldEq] at h
  exact h

/-- The angular multiplier family of a literal finite compact-time tensor. -/
noncomputable def finiteTensorCircleMultiplierFamily
    {iota : Type*} (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex) (theta : Real) :
    SchwartzMap (Euclidean 2) Complex :=
  scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection theta)

/-- The lowpass physical component of a finite compact-time tensor. -/
noncomputable def finiteTensorLowpassCircleField
    {iota : Type*} (C : lpCutoffs 2) (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex)
    (theta : Real) (x : Euclidean 2) : Complex :=
  kakeyaRadialLowpassPhysicalField C
    (finiteTensorCircleMultiplierFamily s q hqcompact a) theta x

/-- The finite-tensor lowpass multiplier is always confined to the fixed
frequency ball `|xi| ≤ 2`. -/
theorem support_finiteTensorLowpassCircleMultiplier_subset_closedBall_two
    {iota : Type*} (C : lpCutoffs 2) (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex) (theta : Real) :
    Set.Subset (Function.support
      (kakeyaRadialLowpassParametricMultiplier C
        (finiteTensorCircleMultiplierFamily s q hqcompact a) theta :
          Euclidean 2 → Complex)) (Metric.closedBall 0 2) := by
  exact support_kakeyaRadialLowpassParametricMultiplier_subset_closedBall_two
    C (finiteTensorCircleMultiplierFamily s q hqcompact a) theta

/-- The finite-tensor lowpass field remains `2π`-periodic in its circle
angle. -/
theorem periodic_finiteTensorLowpassCircleField
    {iota : Type*} (C : lpCutoffs 2) (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex) (x : Euclidean 2) :
    Function.Periodic
      (fun theta => finiteTensorLowpassCircleField C s q hqcompact a theta x)
      (2 * Real.pi) := by
  intro theta
  have hfamily :
      finiteTensorCircleMultiplierFamily s q hqcompact a
          (theta + 2 * Real.pi) =
        finiteTensorCircleMultiplierFamily s q hqcompact a theta := by
    unfold finiteTensorCircleMultiplierFamily
    rw [circleDirection_periodic]
  change FourierTransform.fourierInv
      (kakeyaRadialLowpassPiece C
        (finiteTensorCircleMultiplierFamily s q hqcompact a
          (theta + 2 * Real.pi))) x =
    FourierTransform.fourierInv
      (kakeyaRadialLowpassPiece C
        (finiteTensorCircleMultiplierFamily s q hqcompact a theta)) x
  rw [hfamily]

/-- Direct finite-tensor specialization of the lowpass companion.  The
derivative multiplier and its frequency energy remain explicit analytic
inputs; the low frequency geometry and all-angle reduction are automatic. -/
theorem measurable_and_lintegral_iSup_sq_finiteTensorLowpassCircleField_le_globalH1
    {iota : Type*} (C : lpCutoffs 2) (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex)
    (dm : Real → SchwartzMap (Euclidean 2) Complex)
    (hFcont : Continuous (Function.uncurry
      (finiteTensorLowpassCircleField C s q hqcompact a)))
    (hDcont : Continuous (Function.uncurry
      (fourierInvParametricField dm)))
    (hderiv : ∀ theta x, HasDerivAt
      (fun r => finiteTensorLowpassCircleField C s q hqcompact a r x)
      (fourierInvParametricField dm theta x) theta)
    (hDphysical : Integrable (fun p : Real × Euclidean 2 =>
      ‖fourierInvParametricField dm p.1 p.2‖ ^ (2 : Nat))
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume))
    (hDfrequency : Integrable (fun p : Real × Euclidean 2 =>
      ‖dm p.1 p.2‖ ^ (2 : Nat))
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume))
    {E0 E1 : Real}
    (hE0 : (∫ xi : Euclidean 2,
      ‖kakeyaRadialLowpassParametricMultiplier C
        (finiteTensorCircleMultiplierFamily s q hqcompact a) (-Real.pi) xi‖ ^
          (2 : Nat)) ≤ E0)
    (hE1 : (∫ p : Real × Euclidean 2, ‖dm p.1 p.2‖ ^ (2 : Nat) ∂
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume)) ≤ E1) :
    Measurable (fun x : Euclidean 2 =>
      ⨆ theta : Real, ENNReal.ofReal
        (‖finiteTensorLowpassCircleField C s q hqcompact a theta x‖ ^ 2)) ∧
      (∫⁻ x : Euclidean 2, ⨆ theta : Real, ENNReal.ofReal
        (‖finiteTensorLowpassCircleField C s q hqcompact a theta x‖ ^ 2)) ≤
        ENNReal.ofReal (2 * E0 + 4 * Real.pi * E1) := by
  have hfieldEq : finiteTensorLowpassCircleField C s q hqcompact a =
      kakeyaRadialLowpassPhysicalField C
        (finiteTensorCircleMultiplierFamily s q hqcompact a) := by
    rfl
  have h := measurable_and_lintegral_iSup_sq_kakeyaRadialLowpassPhysicalField_le_globalH1
    C (finiteTensorCircleMultiplierFamily s q hqcompact a) dm
    (periodic_finiteTensorLowpassCircleField C s q hqcompact a)
    (by rw [← hfieldEq]; exact hFcont)
    hDcont
    (by
      intro theta x
      rw [← hfieldEq]
      exact hderiv theta x)
    hDphysical hDfrequency hE0 hE1
  rw [← hfieldEq] at h
  exact h

end

