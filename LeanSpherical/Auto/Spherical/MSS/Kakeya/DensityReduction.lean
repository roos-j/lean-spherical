section

section Auto.Spherical.MSS

open Filter MeasureTheory FourierTransform Set
open Auto.Spherical.SurfaceMeasureDecay
open Auto.Spherical.Auxiliary
open scoped BigOperators Convolution FourierTransform EuclideanSpace Pointwise

noncomputable section

noncomputable def testConj (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  f.postcompCLM Complex.conjCLE.toContinuousLinearMap

noncomputable def testNeg (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  (SchwartzMap.compCLMOfContinuousLinearEquiv Complex
    (LinearIsometryEquiv.neg Real (E := Euclidean 2)).toContinuousLinearEquiv) f

theorem testConj_apply (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    testConj f x = star (f x) := by
  rfl

theorem testNeg_apply (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    testNeg f x = f (-x) := by
  unfold testNeg
  rw [SchwartzMap.compCLMOfContinuousLinearEquiv_apply]
  rfl

private theorem star_fourierInv_neg_eq_fourierInv_star
    (psi : Euclidean 2 -> Complex) (x : Euclidean 2) :
    starRingEnd Complex (FourierTransform.fourierInv psi (-x)) =
      FourierTransform.fourierInv (fun xi => starRingEnd Complex (psi xi)) x := by
  rw [Real.fourierInv_eq, Real.fourierInv_eq, integral_conj.symm]
  apply integral_congr_ae
  filter_upwards with xi
  have hchar :
      starRingEnd Complex
          ((Real.fourierChar (inner Real xi (-x)) : Circle) : Complex) =
        ((Real.fourierChar (inner Real xi x) : Circle) : Complex) := by
    rw [Real.fourierChar_apply, Real.fourierChar_apply, (Complex.exp_conj _).symm]
    congr 1
    simp only [inner_neg_right, map_mul, Complex.conj_ofReal, Complex.conj_I]
    norm_num
  rw [Circle.smul_def, Circle.smul_def, smul_eq_mul, smul_eq_mul, map_mul, hchar]

theorem testConj_fourierInv_eq_testNeg_fourierInv_testConj
    (psi : SchwartzMap (Euclidean 2) Complex) :
    testConj (FourierTransform.fourierInv psi) =
      testNeg (FourierTransform.fourierInv (testConj psi)) := by
  ext x
  rw [testConj_apply, testNeg_apply]
  have h := star_fourierInv_neg_eq_fourierInv_star
    (psi : Euclidean 2 -> Complex) (-x)
  simp only [neg_neg] at h
  have htest : (fun xi => starRingEnd Complex (psi xi)) =
      (testConj psi : Euclidean 2 -> Complex) := by
    funext xi
    exact (testConj_apply psi xi).symm
  rw [htest] at h
  change starRingEnd Complex ((FourierTransform.fourierInv psi) x) = _
  rw [SchwartzMap.fourierInv_coe]
  simpa only [testConj_apply, SchwartzMap.fourierInv_coe] using h

theorem fourier_testNeg (f : SchwartzMap (Euclidean 2) Complex) :
    FourierTransform.fourier (testNeg f) = testNeg (FourierTransform.fourier f) := by
  ext x
  have hcoe : (testNeg f : Euclidean 2 -> Complex) =
      Function.comp (f : Euclidean 2 -> Complex) (LinearIsometryEquiv.neg Real) := by
    funext y
    rw [testNeg_apply]
    rfl
  change FourierTransform.fourier (testNeg f : Euclidean 2 -> Complex) x = _
  rw [testNeg_apply, hcoe]
  exact Real.fourier_comp_linearIsometry _ _ _

theorem fourier_testConj_fourierInv
    (psi : SchwartzMap (Euclidean 2) Complex) :
    FourierTransform.fourier (testConj (FourierTransform.fourierInv psi)) =
      testNeg (testConj psi) := by
  rw [testConj_fourierInv_eq_testNeg_fourierInv_testConj, fourier_testNeg,
    FourierTransform.fourier_fourierInv_eq]

theorem support_testConj_subset
    (f : SchwartzMap (Euclidean 2) Complex) (S : Set (Euclidean 2))
    (hf : Set.Subset (Function.support (f : Euclidean 2 -> Complex)) S) :
    Set.Subset (Function.support (testConj f : Euclidean 2 -> Complex)) S := by
  intro x hx
  apply hf
  apply Function.mem_support.mpr
  intro hzero
  apply Function.mem_support.mp hx
  rw [testConj_apply, hzero]
  exact map_zero (starRingEnd Complex)

theorem support_testNeg_subset_of_neg_closed
    (f : SchwartzMap (Euclidean 2) Complex) (S : Set (Euclidean 2))
    (hf : Set.Subset (Function.support (f : Euclidean 2 -> Complex)) S)
    (hneg : forall x : Euclidean 2, S (-x) -> S x) :
    Set.Subset (Function.support (testNeg f : Euclidean 2 -> Complex)) S := by
  intro x hx
  apply hneg x
  apply hf
  apply Function.mem_support.mpr
  intro hzero
  apply Function.mem_support.mp hx
  rw [testNeg_apply, hzero]

theorem support_testNeg_testConj_subset_of_neg_closed
    (f : SchwartzMap (Euclidean 2) Complex) (S : Set (Euclidean 2))
    (hf : Set.Subset (Function.support (f : Euclidean 2 -> Complex)) S)
    (hneg : forall x : Euclidean 2, S (-x) -> S x) :
    Set.Subset (Function.support (testNeg (testConj f) : Euclidean 2 -> Complex)) S := by
  apply support_testNeg_subset_of_neg_closed
  apply support_testConj_subset
  exact hf
  exact hneg

noncomputable def testProduct (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex (f : Euclidean 2 -> Complex) (testConj f)

theorem testProduct_apply (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    testProduct f x = f x * star (f x) := by
  unfold testProduct
  rw [SchwartzMap.smulLeftCLM_apply_apply f.hasTemperateGrowth]
  rfl

theorem testProduct_apply_eq_normSq
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    testProduct f x = (Complex.normSq (f x) : Complex) := by
  rw [testProduct_apply]
  change f x * starRingEnd Complex (f x) = (Complex.normSq (f x) : Complex)
  exact Complex.mul_conj _

theorem testProduct_re_nonneg
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    0 <= (testProduct f x).re := by
  rw [testProduct_apply_eq_normSq]
  exact Complex.normSq_nonneg _

theorem fourier_testProduct_eq_convolution (f : SchwartzMap (Euclidean 2) Complex) :
    FourierTransform.fourier (testProduct f) =
      (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
        (FourierTransform.fourier f)) (FourierTransform.fourier (testConj f)) := by
  let C : SchwartzMap (Euclidean 2) Complex :=
    (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
      (FourierTransform.fourier f)) (FourierTransform.fourier (testConj f))
  have hC : FourierTransform.fourierInv C = testProduct f := by
    ext z
    rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq_fourier_neg]
    change (FourierTransform.fourier C : SchwartzMap (Euclidean 2) Complex) (-z) = _
    rw [show C =
      (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
        (FourierTransform.fourier f)) (FourierTransform.fourier (testConj f)) by rfl]
    rw [SchwartzMap.fourier_convolution, SchwartzMap.pairing_apply_apply]
    rw [testProduct_apply]
    have hf :
        (FourierTransform.fourier (FourierTransform.fourier f) :
          SchwartzMap (Euclidean 2) Complex) (-z) = f z := by
      have h0 : FourierTransform.fourierInv (FourierTransform.fourier f) = f :=
        FourierTransform.fourierInv_fourier_eq f
      have h1 := congrArg (fun R : SchwartzMap (Euclidean 2) Complex => R z) h0
      change (FourierTransform.fourier (FourierTransform.fourier f) :
        SchwartzMap (Euclidean 2) Complex) (-z) = f z at h1
      exact h1
    have hfc :
        (FourierTransform.fourier (FourierTransform.fourier (testConj f)) :
          SchwartzMap (Euclidean 2) Complex) (-z) = testConj f z := by
      have h0 : FourierTransform.fourierInv (FourierTransform.fourier (testConj f)) = testConj f :=
        FourierTransform.fourierInv_fourier_eq (testConj f)
      have h1 := congrArg (fun R : SchwartzMap (Euclidean 2) Complex => R z) h0
      change (FourierTransform.fourier (FourierTransform.fourier (testConj f)) :
        SchwartzMap (Euclidean 2) Complex) (-z) = testConj f z at h1
      exact h1
    rw [hf, hfc, testConj_apply]
    rfl
  calc
    FourierTransform.fourier (testProduct f) =
        FourierTransform.fourier (FourierTransform.fourierInv C) := by rw [hC]
    _ = C := FourierTransform.fourier_fourierInv_eq C
    _ = _ := rfl

theorem fourier_testProduct_fourierInv_eq_convolution
    (psi : SchwartzMap (Euclidean 2) Complex) :
    FourierTransform.fourier (testProduct (FourierTransform.fourierInv psi)) =
      (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex) psi)
        (testNeg (testConj psi)) := by
  rw [fourier_testProduct_eq_convolution, FourierTransform.fourier_fourierInv_eq,
    fourier_testConj_fourierInv]

theorem support_fourier_testProduct_subset
    (f : SchwartzMap (Euclidean 2) Complex) (S T : Set (Euclidean 2))
    (hf : Set.Subset (Function.support (FourierTransform.fourier f : Euclidean 2 -> Complex)) S)
    (hfc : Set.Subset (Function.support (FourierTransform.fourier (testConj f) : Euclidean 2 -> Complex)) T) :
    Set.Subset (Function.support (FourierTransform.fourier (testProduct f) : Euclidean 2 -> Complex)) (S + T) := by
  rw [fourier_testProduct_eq_convolution]
  intro z hz
  have hCraw : Set.Mem (Function.support (MeasureTheory.convolution
      (FourierTransform.fourier f : Euclidean 2 -> Complex)
      (FourierTransform.fourier (testConj f) : Euclidean 2 -> Complex)
      (ContinuousLinearMap.mul Complex Complex) volume)) z := by
    apply Function.mem_support.mpr
    have hz0 := Function.mem_support.mp hz
    simpa only [SchwartzMap.convolution_apply] using hz0
  exact (Set.add_subset_add hf hfc)
    (MeasureTheory.support_convolution_subset (ContinuousLinearMap.mul Complex Complex) hCraw)

theorem support_fourier_testProduct_fourierInv_subset_self_add
    (psi : SchwartzMap (Euclidean 2) Complex) (S : Set (Euclidean 2))
    (hpsi : Set.Subset (Function.support (psi : Euclidean 2 -> Complex)) S)
    (hneg : forall x : Euclidean 2, S (-x) -> S x) :
    Set.Subset
      (Function.support (FourierTransform.fourier
        (testProduct (FourierTransform.fourierInv psi)) : Euclidean 2 -> Complex))
      (S + S) := by
  apply support_fourier_testProduct_subset
  · rw [FourierTransform.fourier_fourierInv_eq]
    exact hpsi
  · rw [fourier_testConj_fourierInv]
    exact support_testNeg_testConj_subset_of_neg_closed psi S hpsi hneg

theorem support_subset_ball_of_zero_outside_two
    (psi : SchwartzMap (Euclidean 2) Complex)
    (hzero : forall x : Euclidean 2, 2 <= norm x -> psi x = 0) :
    Set.Subset (Function.support (psi : Euclidean 2 -> Complex)) (Metric.ball 0 2) := by
  intro x hx
  rw [Metric.mem_ball, dist_zero_right]
  by_contra hnot
  have hle : 2 <= norm x := le_of_not_gt hnot
  apply Function.mem_support.mp hx
  exact hzero x hle

theorem ball_two_neg_closed (x : Euclidean 2) :
    Set.Mem (Metric.ball (0 : Euclidean 2) 2) (-x) ->
      Set.Mem (Metric.ball (0 : Euclidean 2) 2) x := by
  intro hx
  change dist (-x) 0 < 2 at hx
  change dist x 0 < 2
  simpa only [dist_zero_right, norm_neg] using hx

theorem ball_two_add_subset_closedBall_four :
    Set.Subset (Metric.ball (0 : Euclidean 2) 2 + Metric.ball (0 : Euclidean 2) 2)
      (Metric.closedBall (0 : Euclidean 2) 4) := by
  intro z hz
  rcases Set.mem_add.mp hz with ⟨x, hx, y, hy, hxy⟩
  rw [Metric.mem_closedBall, dist_zero_right]
  rw [← hxy]
  have hxnorm : norm x < 2 := by
    simpa only [Metric.mem_ball, dist_zero_right] using hx
  have hynorm : norm y < 2 := by
    simpa only [Metric.mem_ball, dist_zero_right] using hy
  exact (calc
    norm (x + y) <= norm x + norm y := norm_add_le _ _
    _ < 2 + 2 := add_lt_add hxnorm hynorm
    _ = 4 := by norm_num).le

noncomputable def bandlimitedPositiveCoreMultiplier
    (psi : SchwartzMap (Euclidean 2) Complex) : SchwartzMap (Euclidean 2) Complex :=
  FourierTransform.fourier (testProduct (FourierTransform.fourierInv psi))

theorem bandlimitedPositiveCoreMultiplier_hasCompactSupport
    (psi : SchwartzMap (Euclidean 2) Complex)
    (hzero : forall x : Euclidean 2, 2 <= norm x -> psi x = 0) :
    HasCompactSupport (bandlimitedPositiveCoreMultiplier psi : Euclidean 2 -> Complex) := by
  apply HasCompactSupport.intro (isCompact_closedBall (0 : Euclidean 2) 4)
  intro x hxoutside
  by_contra hnonzero
  have hsupport : Set.Mem
      (Function.support (bandlimitedPositiveCoreMultiplier psi : Euclidean 2 -> Complex)) x :=
    Function.mem_support.mpr hnonzero
  have hballsum : Set.Mem
      (Metric.ball (0 : Euclidean 2) 2 + Metric.ball (0 : Euclidean 2) 2) x := by
    apply support_fourier_testProduct_fourierInv_subset_self_add psi
      (Metric.ball (0 : Euclidean 2) 2)
    · exact support_subset_ball_of_zero_outside_two psi hzero
    · exact ball_two_neg_closed
    exact hsupport
  exact hxoutside (ball_two_add_subset_closedBall_four hballsum)

noncomputable def canonicalFrequencyBump : SchwartzMap (Euclidean 2) Complex :=
  spatialCoreBump.postcompCLM Complex.ofRealCLM

theorem canonicalFrequencyBump_apply (x : Euclidean 2) :
    canonicalFrequencyBump x = (spatialCoreBump x : Complex) := by
  unfold canonicalFrequencyBump
  rw [SchwartzMap.postcompCLM_apply]
  rfl

theorem canonicalFrequencyBump_zero_of_two_le_norm
    (x : Euclidean 2) (hx : 2 <= norm x) : canonicalFrequencyBump x = 0 := by
  rw [canonicalFrequencyBump_apply, spatialCoreBump_eq_zero_of_two_le_norm hx]
  rfl

