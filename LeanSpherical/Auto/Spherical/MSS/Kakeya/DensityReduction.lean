section Auto.Spherical.MSS

open Filter MeasureTheory Set
open Auto.Spherical.SurfaceMeasureDecay
open scoped ENNReal Topology EuclideanSpace

noncomputable section

/-- The fixed light-ray time slab has Lebesgue mass two. -/
theorem scratch_lightRayTimeInterval_measureReal_univ :
    ((volume : Measure Real).restrict lightRayTimeInterval).real univ = 2 := by
  rw [measureReal_restrict_apply_univ]
  unfold lightRayTimeInterval
  rw [
    Real.volume_real_Icc_of_le (by norm_num : (1 / 2 : Real) ≤ 5 / 2)]
  norm_num

/-- A normalized compact positive tube core, parameterized by its fixed
spatial bump. -/
noncomputable def scratch_smoothTubeCore
    (b : Euclidean 2 → Real) (rho : Real) (omega y : Euclidean 2)
    (z : WaveSpaceTime) : Real :=
  (rho⁻¹) ^ 2 * b (rho⁻¹ • (z.1 + z.2 • omega - y))

/-- A direction-free spatial envelope at broad width.  The factor `8` absorbs
the entire light-ray displacement over the fixed time interval. -/
noncomputable def scratch_broadRadialEnvelope
    (b : Euclidean 2 → Real) (rho : Real) (y x : Euclidean 2) : Real :=
  (rho⁻¹) ^ 2 * b ((8 * rho)⁻¹ • (x - y))

/-- At widths at least `1/2`, a unit-speed tube core made from a nonnegative
bump supported in the radius-two ball is bounded by a direction-free spatial
core of comparable width. -/
theorem scratch_smoothTubeCore_le_broadRadialEnvelope
    (b : Euclidean 2 → Real)
    (hbnonneg : ∀ u, 0 ≤ b u) (hble_one : ∀ u, b u ≤ 1)
    (hbone : ∀ ⦃u⦄, ‖u‖ ≤ 1 → b u = 1)
    (hbzero : ∀ ⦃u⦄, 2 ≤ ‖u‖ → b u = 0)
    {rho : Real} (hrho : (1 / 2 : Real) ≤ rho)
    (omega y x : Euclidean 2) (t : Real)
    (homega : ‖omega‖ ≤ 1) (ht : t ∈ lightRayTimeInterval) :
    scratch_smoothTubeCore b rho omega y (x, t) ≤
      scratch_broadRadialEnvelope b rho y x := by
  have hrho_pos : 0 < rho := lt_of_lt_of_le (by norm_num) hrho
  have hrho_nonneg : 0 ≤ rho := hrho_pos.le
  have htime_nonneg : 0 ≤ t := by
    exact (by norm_num : (0 : Real) ≤ 1 / 2).trans ht.1
  have htime : t ≤ 5 / 2 := ht.2
  let u : Euclidean 2 := x + t • omega - y
  have hdecomp : x - y = u - t • omega := by
    dsimp only [u]
    module
  by_cases hzero : b (rho⁻¹ • u) = 0
  · unfold scratch_smoothTubeCore scratch_broadRadialEnvelope
    rw [show x + t • omega - y = u by rfl, hzero]
    rw [mul_zero]
    exact mul_nonneg (sq_nonneg _) (hbnonneg _)
  · have hu_scaled_lt : ‖rho⁻¹ • u‖ < 2 := by
      by_contra hnot
      have htwo : 2 ≤ ‖rho⁻¹ • u‖ := le_of_not_gt hnot
      exact hzero (hbzero htwo)
    have hinv_nonneg : 0 ≤ rho⁻¹ := inv_nonneg.mpr hrho_nonneg
    have hu_lt : ‖u‖ < 2 * rho := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hinv_nonneg] at hu_scaled_lt
      have hmul : rho⁻¹ * ‖u‖ < 2 := hu_scaled_lt
      have hrho_ne : rho ≠ 0 := ne_of_gt hrho_pos
      calc
        ‖u‖ = rho * (rho⁻¹ * ‖u‖) := by field_simp
        _ < rho * 2 := (mul_lt_mul_of_pos_left hmul hrho_pos)
        _ = 2 * rho := by ring
    have hshift : ‖x - y‖ < 7 * rho := by
      rw [hdecomp]
      calc
        ‖u - t • omega‖ ≤ ‖u‖ + ‖t • omega‖ := norm_sub_le _ _
        _ = ‖u‖ + t * ‖omega‖ := by
          rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg htime_nonneg]
        _ ≤ ‖u‖ + t := by
          exact add_le_add_right (mul_le_of_le_one_right htime_nonneg homega) _
        _ ≤ ‖u‖ + 5 / 2 := by gcongr
        _ < 2 * rho + 5 / 2 := by gcongr
        _ ≤ 2 * rho + 5 * rho := by
          gcongr
          nlinarith
        _ = 7 * rho := by ring
    have houter_arg : ‖(8 * rho)⁻¹ • (x - y)‖ ≤ 1 := by
      have h8rho_pos : 0 < 8 * rho := mul_pos (by norm_num) hrho_pos
      have hinv8_nonneg : 0 ≤ (8 * rho)⁻¹ := inv_nonneg.mpr h8rho_pos.le
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hinv8_nonneg]
      have hxy : ‖x - y‖ ≤ 8 * rho := by nlinarith [hshift.le]
      calc
        (8 * rho)⁻¹ * ‖x - y‖ ≤ (8 * rho)⁻¹ * (8 * rho) :=
          mul_le_mul_of_nonneg_left hxy hinv8_nonneg
        _ = 1 := by field_simp [ne_of_gt h8rho_pos]
    have houter : b ((8 * rho)⁻¹ • (x - y)) = 1 := hbone houter_arg
    unfold scratch_smoothTubeCore scratch_broadRadialEnvelope
    rw [show x + t • omega - y = u by rfl, houter]
    exact mul_le_mul_of_nonneg_left (hble_one _) (sq_nonneg _)

/-- The direction-free broad envelope is itself dominated by a fixed positive
zero-direction light-ray weight.  Positivity of that weight is useful for the
weighted Cauchy step. -/
theorem scratch_broadRadialEnvelope_le_zeroDirectionLightRayKernel
    (b : Euclidean 2 → Real)
    (hble_one : ∀ u, b u ≤ 1)
    (hbzero : ∀ ⦃u⦄, 2 ≤ ‖u‖ → b u = 0)
    {rho : Real} (hrho : (1 / 2 : Real) ≤ rho)
    (N : Nat) (y x : Euclidean 2) :
    scratch_broadRadialEnvelope b rho y x ≤
      (17 : Real) ^ N * lightRayKernel rho N 0 x (y, 0) := by
  have hrho_pos : 0 < rho := lt_of_lt_of_le (by norm_num) hrho
  have hrho_nonneg : 0 ≤ rho := hrho_pos.le
  by_cases hzero : b ((8 * rho)⁻¹ • (x - y)) = 0
  · unfold scratch_broadRadialEnvelope
    rw [hzero, mul_zero]
    exact mul_nonneg (pow_nonneg (by norm_num) _) (lightRayKernel_nonneg hrho_pos N _ _ _)
  · have houter_lt : ‖(8 * rho)⁻¹ • (x - y)‖ < 2 := by
      by_contra hnot
      exact hzero (hbzero (le_of_not_gt hnot))
    have h8rho_pos : 0 < 8 * rho := mul_pos (by norm_num) hrho_pos
    have hinv8_nonneg : 0 ≤ (8 * rho)⁻¹ := inv_nonneg.mpr h8rho_pos.le
    have houter' : (8 * rho)⁻¹ * ‖x - y‖ < 2 := by
      simpa only [norm_smul, Real.norm_eq_abs, abs_of_nonneg hinv8_nonneg] using houter_lt
    have hxy_lt : ‖x - y‖ < 16 * rho := by
      have hdiv : ‖x - y‖ / (8 * rho) < 2 := by
        simpa [div_eq_mul_inv, mul_comm] using houter'
      have hmul := (div_lt_iff₀ h8rho_pos).mp hdiv
      nlinarith
    have hinv_nonneg : 0 ≤ rho⁻¹ := inv_nonneg.mpr hrho_nonneg
    have hrad_lt : ‖rho⁻¹ • (y - x)‖ < 16 := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hinv_nonneg]
      have hsymm : ‖y - x‖ = ‖x - y‖ := by rw [norm_sub_rev]
      rw [hsymm]
      calc
        rho⁻¹ * ‖x - y‖ < rho⁻¹ * (16 * rho) :=
          mul_lt_mul_of_pos_left hxy_lt (inv_pos.mpr hrho_pos)
        _ = 16 := by field_simp [ne_of_gt hrho_pos]
    let r : Real := ‖rho⁻¹ • (y - x)‖
    have hr_nonneg : 0 ≤ r := norm_nonneg _
    have hr_le : r ≤ 16 := by simpa only [r] using hrad_lt.le
    have hden : 1 + r ≤ 17 := by linarith
    have hinv : (1 / (17 : Real)) ≤ 1 / (1 + r) := by
      exact one_div_le_one_div_of_le (by positivity) hden
    have hpow : ((17 : Real)⁻¹) ^ N ≤ (1 / (1 + r)) ^ N := by
      simpa only [one_div] using
        pow_le_pow_left₀ (by positivity) hinv N
    have hone : (1 : Real) ≤ (17 : Real) ^ N * (1 / (1 + r)) ^ N := by
      calc
        (1 : Real) = (17 : Real) ^ N * ((17 : Real)⁻¹) ^ N := by
          rw [← mul_pow]
          simp
        _ ≤ (17 : Real) ^ N * (1 / (1 + r)) ^ N :=
          mul_le_mul_of_nonneg_left hpow (pow_nonneg (by norm_num) _)
    rw [lightRayKernel_eq_scaled_decayProfile hrho_pos N 0 x y 0]
    simp only [smul_zero, add_zero]
    change (rho⁻¹) ^ 2 * b ((8 * rho)⁻¹ • (x - y)) ≤
      (17 : Real) ^ N * ((rho⁻¹) ^ 2 * lightRayDecayProfile N
        (rho⁻¹ • (y - x)))
    have hprofile : (1 : Real) ≤ (17 : Real) ^ N *
        lightRayDecayProfile N (rho⁻¹ • (y - x)) := by
      simpa only [lightRayDecayProfile, r] using hone
    calc
      (rho⁻¹) ^ 2 * b ((8 * rho)⁻¹ • (x - y)) ≤ (rho⁻¹) ^ 2 * 1 :=
        mul_le_mul_of_nonneg_left (hble_one _) (sq_nonneg _)
      _ ≤ (rho⁻¹) ^ 2 * ((17 : Real) ^ N *
          lightRayDecayProfile N (rho⁻¹ • (y - x))) :=
        mul_le_mul_of_nonneg_left hprofile (sq_nonneg _)
      _ = (17 : Real) ^ N * ((rho⁻¹) ^ 2 * lightRayDecayProfile N
          (rho⁻¹ • (y - x))) := by ring

/-- Broad positive tube cores admit one strictly positive, direction-free
light-ray kernel envelope. -/
theorem scratch_smoothTubeCore_le_zeroDirectionLightRayKernel
    (b : Euclidean 2 → Real)
    (hbnonneg : ∀ u, 0 ≤ b u) (hble_one : ∀ u, b u ≤ 1)
    (hbone : ∀ ⦃u⦄, ‖u‖ ≤ 1 → b u = 1)
    (hbzero : ∀ ⦃u⦄, 2 ≤ ‖u‖ → b u = 0)
    {rho : Real} (hrho : (1 / 2 : Real) ≤ rho)
    (N : Nat) (omega y x : Euclidean 2) (t : Real)
    (homega : ‖omega‖ ≤ 1) (ht : t ∈ lightRayTimeInterval) :
    scratch_smoothTubeCore b rho omega y (x, t) ≤
      (17 : Real) ^ N * lightRayKernel rho N 0 x (y, 0) := by
  exact (scratch_smoothTubeCore_le_broadRadialEnvelope b hbnonneg hble_one hbone
    hbzero hrho omega y x t homega ht).trans
      (scratch_broadRadialEnvelope_le_zeroDirectionLightRayKernel b hble_one
        hbzero hrho N y x)

/-- The positive smooth tube average over the fixed time slab. -/
noncomputable def scratch_positiveSmoothTubeAverage
    (b : Euclidean 2 → Real) (rho : Real) (omega y : Euclidean 2)
    (G : Euclidean 2 → Real → Real) : Real :=
  ∫ t in lightRayTimeInterval, ∫ x : Euclidean 2,
    scratch_smoothTubeCore b rho omega y (x, t) * G x t

/-- The direction-free positive envelope corresponding to the preceding
broad-width core. -/
noncomputable def scratch_zeroDirectionPositiveEnvelope
    (rho : Real) (N : Nat) (y : Euclidean 2)
    (G : Euclidean 2 → Real → Real) : Real :=
  ∫ t in lightRayTimeInterval, ∫ x : Euclidean 2,
    lightRayKernel rho N 0 x (y, 0) * G x t

/-- Pointwise broad-width domination survives the spatial and time
integrations.  All hypotheses are ordinary integrability facts for the two
nonnegative integrands. -/
theorem scratch_positiveSmoothTubeAverage_le_zeroDirectionPositiveEnvelope
    (b : Euclidean 2 → Real)
    (hbnonneg : ∀ u, 0 ≤ b u) (hble_one : ∀ u, b u ≤ 1)
    (hbone : ∀ ⦃u⦄, ‖u‖ ≤ 1 → b u = 1)
    (hbzero : ∀ ⦃u⦄, 2 ≤ ‖u‖ → b u = 0)
    {rho : Real} (hrho : (1 / 2 : Real) ≤ rho)
    (N : Nat) (omega y : Euclidean 2) (homega : ‖omega‖ ≤ 1)
    (G : Euclidean 2 → Real → Real) (hG : ∀ x t, 0 ≤ G x t)
    (hcoreSlice : ∀ t, Integrable (fun x : Euclidean 2 =>
      scratch_smoothTubeCore b rho omega y (x, t) * G x t) volume)
    (henvSlice : ∀ t, Integrable (fun x : Euclidean 2 =>
      lightRayKernel rho N 0 x (y, 0) * G x t) volume)
    (hcoreTime : Integrable (fun t : Real => ∫ x : Euclidean 2,
      scratch_smoothTubeCore b rho omega y (x, t) * G x t)
      (volume.restrict lightRayTimeInterval))
    (henvTime : Integrable (fun t : Real => ∫ x : Euclidean 2,
      lightRayKernel rho N 0 x (y, 0) * G x t)
      (volume.restrict lightRayTimeInterval)) :
    scratch_positiveSmoothTubeAverage b rho omega y G ≤
      (17 : Real) ^ N * scratch_zeroDirectionPositiveEnvelope rho N y G := by
  let C : Real := (17 : Real) ^ N
  have hC : 0 ≤ C := pow_nonneg (by norm_num) _
  unfold scratch_positiveSmoothTubeAverage scratch_zeroDirectionPositiveEnvelope
  calc
    (∫ t in lightRayTimeInterval, ∫ x : Euclidean 2,
      scratch_smoothTubeCore b rho omega y (x, t) * G x t) ≤
        ∫ t in lightRayTimeInterval, C *
          (∫ x : Euclidean 2, lightRayKernel rho N 0 x (y, 0) * G x t) := by
      apply integral_mono_ae hcoreTime (henvTime.const_mul C)
      filter_upwards [ae_restrict_mem (by
        unfold lightRayTimeInterval
        exact measurableSet_Icc)] with t ht
      calc
        (∫ x : Euclidean 2,
          scratch_smoothTubeCore b rho omega y (x, t) * G x t) ≤
            ∫ x : Euclidean 2, C *
              (lightRayKernel rho N 0 x (y, 0) * G x t) := by
          apply integral_mono (hcoreSlice t) ((henvSlice t).const_mul C)
          intro x
          calc
            scratch_smoothTubeCore b rho omega y (x, t) * G x t ≤
                ((17 : Real) ^ N * lightRayKernel rho N 0 x (y, 0)) * G x t :=
              mul_le_mul_of_nonneg_right
                (scratch_smoothTubeCore_le_zeroDirectionLightRayKernel b hbnonneg hble_one
                  hbone hbzero hrho N omega y x t homega ht)
                (hG x t)
            _ = C * (lightRayKernel rho N 0 x (y, 0) * G x t) := by
              dsimp only [C]
              ring
        _ = C * (∫ x : Euclidean 2,
          lightRayKernel rho N 0 x (y, 0) * G x t) := by
          rw [integral_const_mul]
    _ = C * (∫ t in lightRayTimeInterval, ∫ x : Euclidean 2,
      lightRayKernel rho N 0 x (y, 0) * G x t) := by
      rw [integral_const_mul]
    _ = (17 : Real) ^ N * scratch_zeroDirectionPositiveEnvelope rho N y G := by
      rfl

/-- Squaring the positive broad-width domination reduces the smooth-core
endpoint to the zero-direction envelope endpoint. -/
theorem scratch_integral_sq_positiveSmoothTubeAverage_le
    (b : Euclidean 2 → Real) (rho : Real) (omega : Euclidean 2)
    (N : Nat) (G : Euclidean 2 → Real → Real)
    (hpoint : ∀ y : Euclidean 2,
      scratch_positiveSmoothTubeAverage b rho omega y G ≤
        (17 : Real) ^ N * scratch_zeroDirectionPositiveEnvelope rho N y G)
    (hcore_nonneg : ∀ y : Euclidean 2,
      0 ≤ scratch_positiveSmoothTubeAverage b rho omega y G)
    (henv_nonneg : ∀ y : Euclidean 2,
      0 ≤ scratch_zeroDirectionPositiveEnvelope rho N y G)
    (hcore_sq : Integrable (fun y : Euclidean 2 =>
      scratch_positiveSmoothTubeAverage b rho omega y G ^ 2) volume)
    (henv_sq : Integrable (fun y : Euclidean 2 =>
      scratch_zeroDirectionPositiveEnvelope rho N y G ^ 2) volume) :
    (∫ y : Euclidean 2,
      scratch_positiveSmoothTubeAverage b rho omega y G ^ 2) ≤
      ((17 : Real) ^ N) ^ 2 * ∫ y : Euclidean 2,
        scratch_zeroDirectionPositiveEnvelope rho N y G ^ 2 := by
  have hC : 0 ≤ (17 : Real) ^ N := pow_nonneg (by norm_num) _
  calc
    (∫ y : Euclidean 2, scratch_positiveSmoothTubeAverage b rho omega y G ^ 2) ≤
        ∫ y : Euclidean 2, ((17 : Real) ^ N) ^ 2 *
          scratch_zeroDirectionPositiveEnvelope rho N y G ^ 2 := by
      apply integral_mono hcore_sq (henv_sq.const_mul (((17 : Real) ^ N) ^ 2))
      intro y
      have hright : 0 ≤ (17 : Real) ^ N *
          scratch_zeroDirectionPositiveEnvelope rho N y G :=
        mul_nonneg hC (henv_nonneg y)
      have hsquare := (sq_le_sq₀ (hcore_nonneg y) hright).mpr (hpoint y)
      simpa only [mul_pow] using hsquare
    _ = ((17 : Real) ^ N) ^ 2 * ∫ y : Euclidean 2,
        scratch_zeroDirectionPositiveEnvelope rho N y G ^ 2 := by
      rw [integral_const_mul]

/-- Cauchy--Schwarz on a finite parameter measure, integrated in the terminal
variable.  This is the time step needed after broad-width domination. -/
theorem scratch_integral_sq_timeAverage_le
    {α : Type*} [MeasurableSpace α] (mu : Measure α) [IsFiniteMeasure mu]
    (F : Euclidean 2 → α → Complex)
    (houtput : AEStronglyMeasurable (fun y : Euclidean 2 =>
      ∫ t, F y t ∂mu) volume)
    (hprod : Integrable (fun p : Euclidean 2 × α => ‖F p.1 p.2‖ ^ 2)
      (volume.prod mu))
    (hslice : ∀ y : Euclidean 2, MemLp (F y) 2 mu) :
    (∫ y : Euclidean 2, ‖∫ t, F y t ∂mu‖ ^ 2) ≤
      mu.real univ * ∫ y : Euclidean 2, ∫ t, ‖F y t‖ ^ 2 ∂mu := by
  have hright : Integrable (fun y : Euclidean 2 =>
      mu.real univ * ∫ t, ‖F y t‖ ^ 2 ∂mu) volume :=
    hprod.integral_prod_left.const_mul _
  have hpoint (y : Euclidean 2) :
      ‖∫ t, F y t ∂mu‖ ^ 2 ≤
        mu.real univ * ∫ t, ‖F y t‖ ^ 2 ∂mu :=
    Auto.Spherical.Auxiliary.norm_integral_sq_le_measureReal_mul_integral_norm_sq
      mu (F y) (hslice y)
  have hleft : Integrable (fun y : Euclidean 2 =>
      ‖∫ t, F y t ∂mu‖ ^ 2) volume := by
    refine Integrable.mono hright (houtput.norm.pow 2) ?_
    filter_upwards with y
    rw [Real.norm_of_nonneg (sq_nonneg _),
      Real.norm_of_nonneg (mul_nonneg measureReal_nonneg
        (integral_nonneg fun _ => sq_nonneg _))]
    exact hpoint y
  calc
    (∫ y : Euclidean 2, ‖∫ t, F y t ∂mu‖ ^ 2) ≤
        ∫ y : Euclidean 2,
          mu.real univ * ∫ t, ‖F y t‖ ^ 2 ∂mu :=
      integral_mono hleft hright hpoint
    _ = mu.real univ * ∫ y : Euclidean 2, ∫ t, ‖F y t‖ ^ 2 ∂mu := by
      rw [integral_const_mul]

/-- Integrating a pointwise weighted Cauchy estimate with a constant column
mass gives the literal spatial `L²` Young closure. -/
theorem scratch_integral_sq_spatialKernel_le
    (K : Euclidean 2 → Euclidean 2 → Real) (f : Euclidean 2 → Complex)
    (A : Real)
    (houtput : AEStronglyMeasurable (fun y : Euclidean 2 =>
      ∫ x, (K y x : Complex) * f x) volume)
    (henergy : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      K p.1 p.2 * ‖f p.2‖ ^ 2) (volume.prod volume))
    (hpoint : ∀ y : Euclidean 2,
      ‖∫ x, (K y x : Complex) * f x‖ ^ 2 ≤
        A * ∫ x, K y x * ‖f x‖ ^ 2)
    (hcol : ∀ x : Euclidean 2,
      Integrable (fun y : Euclidean 2 => K y x) volume ∧
        (∫ y : Euclidean 2, K y x) = A) :
    (∫ y : Euclidean 2, ‖∫ x, (K y x : Complex) * f x‖ ^ 2) ≤
      A ^ 2 * ∫ x, ‖f x‖ ^ 2 := by
  have hright : Integrable (fun y : Euclidean 2 =>
      A * ∫ x, K y x * ‖f x‖ ^ 2) volume :=
    henergy.integral_prod_left.const_mul _
  have hleft : Integrable (fun y : Euclidean 2 =>
      ‖∫ x, (K y x : Complex) * f x‖ ^ 2) volume := by
    refine Integrable.mono hright (houtput.norm.pow 2) ?_
    filter_upwards with y
    rw [Real.norm_of_nonneg (sq_nonneg _)]
    have hnonneg : 0 ≤ A * ∫ x, K y x * ‖f x‖ ^ 2 := by
      exact le_trans (sq_nonneg _) (hpoint y)
    rw [Real.norm_of_nonneg hnonneg]
    exact hpoint y
  have hswap :
      (∫ y : Euclidean 2, ∫ x : Euclidean 2,
        K y x * ‖f x‖ ^ 2) =
        ∫ x : Euclidean 2, ∫ y : Euclidean 2,
          K y x * ‖f x‖ ^ 2 :=
    integral_integral_swap henergy
  have hinner (x : Euclidean 2) :
      (∫ y : Euclidean 2, K y x * ‖f x‖ ^ 2) =
        A * ‖f x‖ ^ 2 := by
    rw [integral_mul_const, (hcol x).2]
  calc
    (∫ y : Euclidean 2, ‖∫ x, (K y x : Complex) * f x‖ ^ 2) ≤
        ∫ y : Euclidean 2, A * ∫ x, K y x * ‖f x‖ ^ 2 :=
      integral_mono hleft hright hpoint
    _ = A * ∫ y : Euclidean 2, ∫ x, K y x * ‖f x‖ ^ 2 := by
      rw [integral_const_mul]
    _ = A * ∫ x : Euclidean 2, ∫ y : Euclidean 2,
        K y x * ‖f x‖ ^ 2 := by rw [hswap]
    _ = A * ∫ x : Euclidean 2, A * ‖f x‖ ^ 2 := by
      apply congrArg (fun r : Real => A * r)
      apply integral_congr_ae
      filter_upwards with x
      exact hinner x
    _ = A * (A * ∫ x : Euclidean 2, ‖f x‖ ^ 2) := by
      rw [integral_const_mul]
    _ = A ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by ring

/-- The exact finite-time/spatial `L²` closure.  Its hypotheses isolate only
the routine Fubini and slice-energy obligations for a positive kernel. -/
theorem scratch_integral_sq_time_spatialKernel_le
    {α : Type*} [MeasurableSpace α] (mu : Measure α) [IsFiniteMeasure mu]
    (K : Euclidean 2 → Euclidean 2 → Real)
    (g : Euclidean 2 → α → Complex) (A : Real)
    (houtput : AEStronglyMeasurable (fun y : Euclidean 2 =>
      ∫ t, (∫ x : Euclidean 2, (K y x : Complex) * g x t ∂volume) ∂mu) volume)
    (hprod : Integrable (fun p : Euclidean 2 × α =>
      ‖∫ x : Euclidean 2, (K p.1 x : Complex) * g x p.2 ∂volume‖ ^ 2) (volume.prod mu))
    (hprod_swap : Integrable (fun p : α × Euclidean 2 =>
      ‖∫ x : Euclidean 2, (K p.2 x : Complex) * g x p.1 ∂volume‖ ^ 2) (mu.prod volume))
    (hslice : ∀ y : Euclidean 2, MemLp
      (fun t => ∫ x : Euclidean 2, (K y x : Complex) * g x t ∂volume) 2 mu)
    (hspatial : ∀ t : α,
      (∫ y : Euclidean 2, ‖∫ x : Euclidean 2,
        (K y x : Complex) * g x t ∂volume‖ ^ 2) ≤
        A ^ 2 * ∫ x : Euclidean 2, ‖g x t‖ ^ 2)
    (hinput : Integrable (fun p : α × Euclidean 2 => ‖g p.2 p.1‖ ^ 2)
      (mu.prod volume)) :
    (∫ y : Euclidean 2,
      ‖∫ t, (∫ x : Euclidean 2, (K y x : Complex) * g x t ∂volume) ∂mu‖ ^ 2) ≤
      mu.real univ * A ^ 2 *
        ∫ t, (∫ x : Euclidean 2, ‖g x t‖ ^ 2 ∂volume) ∂mu := by
  let F : Euclidean 2 → α → Complex := fun y t =>
    ∫ x : Euclidean 2, (K y x : Complex) * g x t ∂volume
  have htime := scratch_integral_sq_timeAverage_le mu F houtput
    (by simpa only [F] using hprod) (by simpa only [F] using hslice)
  have hFint : Integrable (fun t : α => ∫ y : Euclidean 2,
      ‖F y t‖ ^ 2 ∂volume) mu := by
    simpa only [F] using hprod_swap.integral_prod_left
  have hgint : Integrable (fun t : α =>
      A ^ 2 * ∫ x : Euclidean 2, ‖g x t‖ ^ 2 ∂volume) mu := by
    simpa only using hinput.integral_prod_left.const_mul (A ^ 2)
  have houter :
      (∫ t : α, (∫ y : Euclidean 2, ‖F y t‖ ^ 2 ∂volume) ∂mu) ≤
        ∫ t : α, (A ^ 2 * ∫ x : Euclidean 2, ‖g x t‖ ^ 2 ∂volume) ∂mu := by
    apply integral_mono hFint hgint
    intro t
    simpa only [F] using hspatial t
  calc
    (∫ y : Euclidean 2,
      ‖∫ t, (∫ x : Euclidean 2, (K y x : Complex) * g x t ∂volume) ∂mu‖ ^ 2) ≤
        mu.real univ * ∫ y : Euclidean 2, (∫ t, ‖F y t‖ ^ 2 ∂mu) ∂volume := by
      simpa only [F] using htime
    _ = mu.real univ * ∫ t : α,
        (∫ y : Euclidean 2, ‖F y t‖ ^ 2 ∂volume) ∂mu := by
      rw [integral_integral_swap hprod]
    _ ≤ mu.real univ * ∫ t : α,
        (A ^ 2 * ∫ x : Euclidean 2, ‖g x t‖ ^ 2 ∂volume) ∂mu :=
      mul_le_mul_of_nonneg_left houter measureReal_nonneg
    _ = mu.real univ * A ^ 2 *
        ∫ t : α, (∫ x : Euclidean 2, ‖g x t‖ ^ 2 ∂volume) ∂mu := by
      rw [integral_const_mul]
      ring

/-- The zero-direction broad envelope has the expected spatial `L²` bound.
The hypotheses are exactly the measurable/product-energy facts needed to use
the public weighted Cauchy lemma. -/
theorem scratch_integral_sq_zeroDirectionSpatialKernel_le
    {rho : Real} (hrho : 0 < rho) (N : Nat) (hN : 2 < N)
    (f : Euclidean 2 → Complex)
    (houtput : AEStronglyMeasurable (fun y : Euclidean 2 =>
      ∫ x : Euclidean 2,
        (lightRayKernel rho N 0 x (y, 0) : Complex) * f x) volume)
    (henergy : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      lightRayKernel rho N 0 p.2 (p.1, 0) * ‖f p.2‖ ^ 2) (volume.prod volume))
    (hsliceMeas : ∀ y : Euclidean 2, AEStronglyMeasurable (fun x : Euclidean 2 =>
      (lightRayKernel rho N 0 x (y, 0))⁻¹ *
        ‖(lightRayKernel rho N 0 x (y, 0) : Complex) * f x‖ ^ 2) volume)
    (hsliceEnergy : ∀ y : Euclidean 2, Integrable (fun x : Euclidean 2 =>
      lightRayKernel rho N 0 x (y, 0) * ‖f x‖ ^ 2) volume) :
    (∫ y : Euclidean 2,
      ‖∫ x : Euclidean 2,
        (lightRayKernel rho N 0 x (y, 0) : Complex) * f x‖ ^ 2) ≤
      (∫ u : Euclidean 2, lightRayDecayProfile N u) ^ 2 *
        ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  let A : Real := ∫ u : Euclidean 2, lightRayDecayProfile N u
  let K : Euclidean 2 → Euclidean 2 → Real := fun y x =>
    lightRayKernel rho N 0 x (y, 0)
  have hkernel_time_independent (z : WaveSpaceTime) (x : Euclidean 2) :
      lightRayKernel rho N 0 x z = K z.1 x := by
    dsimp only [K]
    unfold lightRayKernel
    simp only [smul_zero, add_zero]
  have hkernel_symm (z : WaveSpaceTime) (x : Euclidean 2) :
      lightRayKernel rho N 0 x z = lightRayKernel rho N 0 z.1 (x, z.2) := by
    unfold lightRayKernel
    simp only [smul_zero, add_zero]
    rw [norm_sub_rev]
  have hmass (z : WaveSpaceTime) :
      Integrable (fun x : Euclidean 2 => lightRayKernel rho N 0 x z) volume ∧
        (∫ x : Euclidean 2, lightRayKernel rho N 0 x z) ≤ A := by
    rw [show (fun x : Euclidean 2 => lightRayKernel rho N 0 x z) =
      fun x : Euclidean 2 => lightRayKernel rho N 0 z.1 (x, z.2) by
        funext x; exact hkernel_symm z x]
    refine ⟨integrable_lightRayKernel_spatial hrho N hN 0 z.1 z.2, ?_⟩
    rw [integral_lightRayKernel_spatial_eq_decayProfile hrho N 0 z.1 z.2]
  have hpoint (y : Euclidean 2) :
      ‖∫ x : Euclidean 2, (K y x : Complex) * f x‖ ^ 2 ≤
        A * ∫ x : Euclidean 2, K y x * ‖f x‖ ^ 2 := by
    have hbase := sq_norm_continuumFineKernelTerm_le_lightRayEnergy hrho N 0
      (fun z x => (K z.1 x : Complex)) f
      (by
        intro z x
        rw [← hkernel_time_independent z x, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg (lightRayKernel_nonneg hrho N 0 x z)]
        )
      hmass
      (by
        intro z
        simpa only [hkernel_time_independent z] using hsliceMeas z.1)
      (by
        intro z
        simpa only [hkernel_time_independent z] using hsliceEnergy z.1)
      (y, 0)
    simpa only [K, A] using hbase
  apply scratch_integral_sq_spatialKernel_le K f A
  · simpa only [K] using houtput
  · simpa only [K] using henergy
  · exact hpoint
  · intro x
    refine ⟨?_, ?_⟩
    · exact integrable_lightRayKernel_spatial hrho N hN 0 x 0
    · rw [integral_lightRayKernel_spatial_eq_decayProfile hrho N 0 x 0]

/-- The literal broad zero-direction tube envelope is `L²`-bounded once its
standard slice/product measurability facts are supplied. -/
theorem scratch_integral_sq_zeroDirectionTubeEnvelope_le
    {α : Type*} [MeasurableSpace α] (mu : Measure α) [IsFiniteMeasure mu]
    {rho : Real} (hrho : 0 < rho) (N : Nat) (hN : 2 < N)
    (g : Euclidean 2 → α → Complex)
    (houtput : AEStronglyMeasurable (fun y : Euclidean 2 =>
      ∫ t, (∫ x : Euclidean 2,
        (lightRayKernel rho N 0 x (y, 0) : Complex) * g x t ∂volume) ∂mu) volume)
    (hprod : Integrable (fun p : Euclidean 2 × α =>
      ‖∫ x : Euclidean 2,
        (lightRayKernel rho N 0 x (p.1, 0) : Complex) * g x p.2 ∂volume‖ ^ 2)
      (volume.prod mu))
    (hprod_swap : Integrable (fun p : α × Euclidean 2 =>
      ‖∫ x : Euclidean 2,
        (lightRayKernel rho N 0 x (p.2, 0) : Complex) * g x p.1 ∂volume‖ ^ 2)
      (mu.prod volume))
    (hslice : ∀ y : Euclidean 2, MemLp (fun t =>
      ∫ x : Euclidean 2,
        (lightRayKernel rho N 0 x (y, 0) : Complex) * g x t ∂volume) 2 mu)
    (hinput : Integrable (fun p : α × Euclidean 2 => ‖g p.2 p.1‖ ^ 2)
      (mu.prod volume))
    (hspOutput : ∀ t : α, AEStronglyMeasurable (fun y : Euclidean 2 =>
      ∫ x : Euclidean 2,
        (lightRayKernel rho N 0 x (y, 0) : Complex) * g x t) volume)
    (hspEnergy : ∀ t : α, Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      lightRayKernel rho N 0 p.2 (p.1, 0) * ‖g p.2 t‖ ^ 2) (volume.prod volume))
    (hspMeas : ∀ t y, AEStronglyMeasurable (fun x : Euclidean 2 =>
      (lightRayKernel rho N 0 x (y, 0))⁻¹ *
        ‖(lightRayKernel rho N 0 x (y, 0) : Complex) * g x t‖ ^ 2) volume)
    (hspSliceEnergy : ∀ t y, Integrable (fun x : Euclidean 2 =>
      lightRayKernel rho N 0 x (y, 0) * ‖g x t‖ ^ 2) volume) :
    (∫ y : Euclidean 2,
      ‖∫ t, (∫ x : Euclidean 2,
        (lightRayKernel rho N 0 x (y, 0) : Complex) * g x t ∂volume) ∂mu‖ ^ 2) ≤
      mu.real univ * (∫ u : Euclidean 2, lightRayDecayProfile N u) ^ 2 *
        ∫ t, (∫ x : Euclidean 2, ‖g x t‖ ^ 2 ∂volume) ∂mu := by
  apply scratch_integral_sq_time_spatialKernel_le mu
    (fun y x => lightRayKernel rho N 0 x (y, 0)) g
    (∫ u : Euclidean 2, lightRayDecayProfile N u)
  · exact houtput
  · exact hprod
  · exact hprod_swap
  · exact hslice
  · intro t
    exact scratch_integral_sq_zeroDirectionSpatialKernel_le hrho N hN (g · t)
      (hspOutput t) (hspEnergy t) (hspMeas t) (hspSliceEnergy t)
  · exact hinput

end

