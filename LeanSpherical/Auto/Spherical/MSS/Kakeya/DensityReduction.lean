theorem canonicalFrequencyBump_integral_ne_zero :
    (∫ x, canonicalFrequencyBump x ∂volume) ≠ 0 := by
  rw [show (fun x : Euclidean 2 => canonicalFrequencyBump x) =
      fun x => (spatialCoreBump x : Complex) by
    funext x
    exact canonicalFrequencyBump_apply x]
  rw [integral_complex_ofReal]
  apply Complex.ofReal_ne_zero.mpr
  have hpos : 0 < ∫ x, spatialCoreBump x ∂volume := by
    unfold spatialCoreBump
    exact (show 0 < ∫ x : Euclidean 2,
      (let b : ContDiffBump (0 : Euclidean 2) := ⟨1, 2, by norm_num, by norm_num⟩
       b x) ∂volume from by
      let b : ContDiffBump (0 : Euclidean 2) := ⟨1, 2, by norm_num, by norm_num⟩
      exact b.integral_pos)
  exact hpos.ne'

theorem canonicalInverseFrequencyBump_zero_ne_zero :
    (FourierTransform.fourierInv canonicalFrequencyBump) (0 : Euclidean 2) ≠ 0 := by
  rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq]
  simpa using canonicalFrequencyBump_integral_ne_zero

theorem canonicalPositiveCore_zero_pos :
    0 < (canonicalPositiveCore (0 : Euclidean 2)).re := by
  rw [canonicalPositiveCore_apply_eq_normSq]
  exact Complex.normSq_pos.mpr canonicalInverseFrequencyBump_zero_ne_zero

/-- The positive bandlimited core is uniformly bounded below on a closed
neighborhood of the origin.  The closed-ball form is arranged for dyadic
physical rescaling. -/
theorem exists_canonicalPositiveCore_lower_closedBall :
    ∃ c r : Real, 0 < c ∧ 0 < r ∧
      ∀ x : Euclidean 2, ‖x‖ ≤ r → c ≤ (canonicalPositiveCore x).re := by
  let c : Real := (canonicalPositiveCore (0 : Euclidean 2)).re / 2
  have hc : 0 < c := by
    dsimp only [c]
    linarith [canonicalPositiveCore_zero_pos]
  have hcont : ContinuousAt (fun x : Euclidean 2 =>
      (canonicalPositiveCore x).re) 0 :=
    (Complex.continuous_re.comp canonicalPositiveCore.continuous).continuousAt
  rcases Metric.continuousAt_iff.mp hcont c hc with ⟨r, hr, hclose⟩
  refine ⟨c, r / 2, hc, half_pos hr, ?_⟩
  intro x hx
  have hxball : x ∈ Metric.ball (0 : Euclidean 2) r := by
    rw [Metric.mem_ball, dist_zero_right]
    calc
      ‖x‖ ≤ r / 2 := hx
      _ < r := half_lt_self hr
  have hvalueDist :
      dist ((canonicalPositiveCore x).re)
        (canonicalPositiveCore (0 : Euclidean 2)).re < c :=
    hclose hxball
  have habs :
      |(canonicalPositiveCore x).re -
          (canonicalPositiveCore (0 : Euclidean 2)).re| < c := by
    simpa only [Real.dist_eq] using hvalueDist
  have hsub :
      (canonicalPositiveCore (0 : Euclidean 2)).re -
          (canonicalPositiveCore x).re < c := by
    calc
      (canonicalPositiveCore (0 : Euclidean 2)).re -
          (canonicalPositiveCore x).re =
          -((canonicalPositiveCore x).re -
            (canonicalPositiveCore (0 : Euclidean 2)).re) := by ring
      _ ≤ |(canonicalPositiveCore x).re -
          (canonicalPositiveCore (0 : Euclidean 2)).re| := neg_le_abs _
      _ < c := habs
  dsimp only [c] at hsub ⊢
  linarith

end
