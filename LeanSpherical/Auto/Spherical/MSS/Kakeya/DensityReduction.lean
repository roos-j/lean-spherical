section Auto.Spherical.MSS

open Filter MeasureTheory Set
open scoped BigOperators ENNReal Topology

noncomputable section

/-- A finite dyadic expansion separates into an untouched narrow block and
a uniformly bounded broad block.  The latter is absorbed by the full
geometric mass, so this plugs directly into any finite narrow-core bound. -/
theorem scratch_sum_range_dyadic_narrow_broad_le
    (M k0 : Nat) (C r B : Real)
    (hC : 0 ≤ C) (hr : 0 ≤ r) (hrlt : r < 1) (hB : 0 ≤ B)
    (L : Nat → Real)
    (hbroad : ∀ k, k0 ≤ k → L k ≤ B) :
    (∑ k ∈ Finset.range M, C * r ^ k * L k) ≤
      (∑ k ∈ (Finset.range M).filter (fun k => k < k0),
        C * r ^ k * L k) + C * B / (1 - r) := by
  classical
  let f : Nat → Real := fun k => C * r ^ k * L k
  let g : Nat → Real := fun k => C * r ^ k * B
  let s : Finset Nat := Finset.range M
  let p : Nat → Prop := fun k => k < k0
  have hfactor (k : Nat) : 0 ≤ C * r ^ k :=
    mul_nonneg hC (pow_nonneg hr _)
  have hfg : ∀ k ∈ s.filter (fun k => ¬ p k), f k ≤ g k := by
    intro k hk
    have hkp : ¬ k < k0 := (Finset.mem_filter.mp hk).2
    have hkle : k0 ≤ k := le_of_not_gt hkp
    dsimp only [f, g]
    exact mul_le_mul_of_nonneg_left (hbroad k hkle) (hfactor k)
  have htail_to_g :
      (∑ k ∈ s.filter (fun k => ¬ p k), f k) ≤
        ∑ k ∈ s.filter (fun k => ¬ p k), g k := by
    exact Finset.sum_le_sum hfg
  have hg_nonneg (k : Nat) : 0 ≤ g k := by
    dsimp only [g]
    exact mul_nonneg (hfactor k) hB
  have htail_filter :
      (∑ k ∈ s.filter (fun k => ¬ p k), g k) ≤
        ∑ k ∈ s, g k := by
    apply Finset.sum_le_sum_of_subset_of_nonneg
    · exact Finset.filter_subset _ _
    · intro k _ _
      exact hg_nonneg k
  have hgeom : Summable (fun k : Nat => r ^ k) :=
    summable_geometric_of_lt_one hr hrlt
  have hgeom_fin : (∑ k ∈ s, r ^ k) ≤ (1 - r)⁻¹ := by
    calc
      (∑ k ∈ s, r ^ k) ≤ ∑' k : Nat, r ^ k :=
        hgeom.sum_le_tsum s (fun k _ => pow_nonneg hr k)
      _ = (1 - r)⁻¹ := tsum_geometric_of_lt_one hr hrlt
  have hsum_g : (∑ k ∈ s, g k) = C * B * (∑ k ∈ s, r ^ k) := by
    calc
      (∑ k ∈ s, g k) = ∑ k ∈ s, (C * B) * r ^ k := by
        apply Finset.sum_congr rfl
        intro k _
        dsimp only [g]
        ring
      _ = C * B * (∑ k ∈ s, r ^ k) := by
        rw [Finset.mul_sum]
  have htail : (∑ k ∈ s.filter (fun k => ¬ p k), f k) ≤
      C * B / (1 - r) := by
    calc
      (∑ k ∈ s.filter (fun k => ¬ p k), f k) ≤
          ∑ k ∈ s.filter (fun k => ¬ p k), g k := htail_to_g
      _ ≤ ∑ k ∈ s, g k := htail_filter
      _ = C * B * (∑ k ∈ s, r ^ k) := hsum_g
      _ ≤ C * B * (1 - r)⁻¹ :=
        mul_le_mul_of_nonneg_left hgeom_fin (mul_nonneg hC hB)
      _ = C * B / (1 - r) := by rw [div_eq_mul_inv]
  change (∑ k ∈ s, f k) ≤
    (∑ k ∈ s.filter (fun k => k < k0), f k) + C * B / (1 - r)
  rw [← Finset.sum_filter_add_sum_filter_not s (fun k => k < k0)]
  have htail' : (∑ k ∈ s.filter (fun k => ¬ k < k0), f k) ≤
      C * B / (1 - r) := by
    simpa only [p] using htail
  exact add_le_add_right htail' _

end

end Auto.Spherical.MSS
end
