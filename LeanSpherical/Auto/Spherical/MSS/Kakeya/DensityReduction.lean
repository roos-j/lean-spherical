section Auto.Spherical.MSS

noncomputable section

theorem eLpNorm_two_prod_mul_eq
    {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]
    (μ : Measure α) (ν : Measure β) [SFinite ν]
    (f : α → Complex) (g : β → Complex)
    (hf : AEStronglyMeasurable f μ) (hg : AEStronglyMeasurable g ν) :
    eLpNorm (fun z : α × β => f z.1 * g z.2) 2 (μ.prod ν) =
      eLpNorm f 2 μ * eLpNorm g 2 ν := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal two_ne_zero ENNReal.ofNat_ne_top,
    eLpNorm_eq_lintegral_rpow_enorm_toReal two_ne_zero ENNReal.ofNat_ne_top,
    eLpNorm_eq_lintegral_rpow_enorm_toReal two_ne_zero ENNReal.ofNat_ne_top]
  simp only [ENNReal.toReal_ofNat, one_div]
  have hpow : (fun z : α × β => ‖f z.1 * g z.2‖ₑ ^ (2 : Real)) =
      (fun z : α × β =>
        (‖f z.1‖ₑ ^ (2 : Real)) * (‖g z.2‖ₑ ^ (2 : Real))) := by
    funext z
    rw [enorm_mul, ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]
  rw [hpow]
  have hlin := lintegral_prod_mul
    (μ := μ) (ν := ν)
    (f := fun x : α => ‖f x‖ₑ ^ (2 : Real))
    (g := fun y : β => ‖g y‖ₑ ^ (2 : Real))
    (ENNReal.continuous_rpow_const.measurable.comp_aemeasurable hf.enorm)
    (ENNReal.continuous_rpow_const.measurable.comp_aemeasurable hg.enorm)
  rw [hlin]
  · rw [ENNReal.mul_rpow_of_nonneg]
    norm_num

/-- A finite separated physical tensor with a compact-frequency spatial
factor.  The definition is deliberately independent of the Kakeya operator,
so it can be used as the approximation core in the signed-envelope lift. -/
noncomputable def compactFrequencyTensor
    {ι : Type*} [Fintype ι]
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → Real → Complex) : WaveSpaceTime → Complex :=
  fun z => ∑ i, (FourierTransform.fourierInv (q i) :
    SchwartzMap (Euclidean 2) Complex) z.1 * a i z.2

/-- The corresponding finite separated tensor before the spatial factors
are replaced by compact-frequency inverse Fourier transforms. -/
noncomputable def smoothSpatialTensor
    {ι : Type*} [Fintype ι]
    (U : ι → Euclidean 2 → Complex)
    (a : ι → Real → Complex) : WaveSpaceTime → Complex :=
  fun z => ∑ i, U i z.1 * a i z.2

/-- Replacing the spatial factors of a finite tensor in `L²` has exactly the
expected product-norm cost.  This is the quantitative composition point
between the compact-product tensor theorem and Plancherel compact-frequency
density. -/
theorem eLpNorm_compactFrequencyTensor_sub_smoothSpatialTensor_le
    {ι : Type*} [Fintype ι]
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (U : ι → Euclidean 2 → Complex)
    (a : ι → Real → Complex)
    (hU : ∀ i, Continuous (U i))
    (ha : ∀ i, Continuous (a i))
    (δ : ι → ENNReal)
    (hq : ∀ i,
      eLpNorm (((FourierTransform.fourierInv (q i) :
        SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex) - U i)
        2 volume ≤ δ i) :
    eLpNorm (compactFrequencyTensor q a - smoothSpatialTensor U a) 2 volume ≤
      ∑ i, δ i * eLpNorm (a i) 2 volume := by
  let d : ι → Euclidean 2 → Complex := fun i =>
    ((FourierTransform.fourierInv (q i) :
      SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex) - U i
  have hd : ∀ i, Continuous (d i) := by
    intro i
    exact (FourierTransform.fourierInv (q i)).continuous.sub (hU i)
  have hrewrite : compactFrequencyTensor q a - smoothSpatialTensor U a =
      fun z => ∑ i, d i z.1 * a i z.2 := by
    funext z
    simp only [compactFrequencyTensor, smoothSpatialTensor, Pi.sub_apply, d]
    rw [← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro i hi
    ring
  rw [hrewrite]
  let b : ι → WaveSpaceTime → Complex := fun i z => d i z.1 * a i z.2
  have hbmeas : ∀ i, AEStronglyMeasurable (b i) volume := by
    intro i
    exact ((hd i).comp continuous_fst).mul
      ((ha i).comp continuous_snd) |>.aestronglyMeasurable
  have hbsum : (∑ i, b i) =
      (fun z : WaveSpaceTime => ∑ i, d i z.1 * a i z.2) := by
    funext z
    simp [b]
  have hsum :
      eLpNorm (fun z : WaveSpaceTime => ∑ i, d i z.1 * a i z.2) 2 volume ≤
        ∑ i, eLpNorm (fun z : WaveSpaceTime => d i z.1 * a i z.2) 2 volume := by
    calc
      eLpNorm (fun z : WaveSpaceTime => ∑ i, d i z.1 * a i z.2) 2 volume =
          eLpNorm (∑ i, b i) 2 volume := by rw [hbsum]
      _ ≤ ∑ i, eLpNorm (b i) 2 volume :=
        eLpNorm_sum_le (μ := volume) (p := (2 : ENNReal))
          (s := Finset.univ) (f := b)
          (fun i _ => hbmeas i) (by norm_num)
      _ = ∑ i, eLpNorm (fun z : WaveSpaceTime => d i z.1 * a i z.2) 2 volume := by
        rfl
  calc
    eLpNorm (fun z : WaveSpaceTime => ∑ i, d i z.1 * a i z.2) 2 volume ≤
        ∑ i, eLpNorm (fun z : WaveSpaceTime => d i z.1 * a i z.2) 2 volume := hsum
    _ = ∑ i, eLpNorm (d i) 2 volume * eLpNorm (a i) 2 volume := by
      apply Finset.sum_congr rfl
      intro i hi
      simpa only [Measure.volume_eq_prod] using
        eLpNorm_two_prod_mul_eq (volume : Measure (Euclidean 2))
          (volume : Measure Real) (d i) (a i)
          (hd i).aestronglyMeasurable (ha i).aestronglyMeasurable
    _ ≤ ∑ i, δ i * eLpNorm (a i) 2 volume := by
      apply Finset.sum_le_sum
      intro i hi
      calc
        eLpNorm (d i) 2 volume * eLpNorm (a i) 2 volume =
            eLpNorm (a i) 2 volume * eLpNorm (d i) 2 volume := mul_comm _ _
        _ ≤ eLpNorm (a i) 2 volume * δ i :=
          mul_le_mul_right (by simpa only [d] using hq i) _
        _ = δ i * eLpNorm (a i) 2 volume := mul_comm _ _

/-- Exact `L²` Plancherel bridge used to replace a compactly supported smooth
physical spatial factor by a compactly frequency-supported Schwartz factor. -/
theorem eLpNorm_two_fourierInv_sub_eq
    (q f : SchwartzMap (Euclidean 2) Complex) :
    eLpNorm (((FourierTransform.fourierInv q : SchwartzMap (Euclidean 2) Complex) :
      Euclidean 2 -> Complex) - (f : Euclidean 2 -> Complex)) 2 volume =
      eLpNorm ((q : Euclidean 2 -> Complex) -
        (FourierTransform.fourier f : Euclidean 2 -> Complex)) 2 volume := by
  have hrewrite :
      FourierTransform.fourierInv q - f =
        FourierTransform.fourierInv (q - FourierTransform.fourier f) := by
    calc
      FourierTransform.fourierInv q - f =
          FourierTransform.fourierInv q -
            FourierTransform.fourierInv (FourierTransform.fourier f) := by
        rw [FourierTransform.fourierInv_fourier_eq]
      _ = FourierTransform.fourierInv (q - FourierTransform.fourier f) := by
        simpa only [sub_eq_add_neg, FourierTransform.fourierInv_neg] using
          (FourierTransform.fourierInv_add q (-FourierTransform.fourier f)).symm
  have hrewriteFun :
      ((FourierTransform.fourierInv q : SchwartzMap (Euclidean 2) Complex) :
        Euclidean 2 -> Complex) - (f : Euclidean 2 -> Complex) =
      ((FourierTransform.fourierInv (q - FourierTransform.fourier f) :
        SchwartzMap (Euclidean 2) Complex) : Euclidean 2 -> Complex) :=
    congrArg (fun h : SchwartzMap (Euclidean 2) Complex =>
      (h : Euclidean 2 -> Complex)) hrewrite
  rw [hrewriteFun]
  calc
    eLpNorm ((FourierTransform.fourierInv (q - FourierTransform.fourier f) :
        SchwartzMap (Euclidean 2) Complex) : Euclidean 2 -> Complex) 2 volume =
        ‖(FourierTransform.fourierInv (q - FourierTransform.fourier f) :
          SchwartzMap (Euclidean 2) Complex).toLp 2 volume‖₊ :=
      (Lp.enorm_toLp _).symm
    _ = ‖FourierTransform.fourierInv
          ((q - FourierTransform.fourier f :
            SchwartzMap (Euclidean 2) Complex).toLp 2 volume)‖₊ := by
      rw [SchwartzMap.toLp_fourierInv_eq]
    _ = ‖(q - FourierTransform.fourier f :
          SchwartzMap (Euclidean 2) Complex).toLp 2 volume‖₊ := by
      norm_cast
      apply NNReal.eq
      simp only [coe_nnnorm]
      rw [← Lp.norm_fourier_eq
        (FourierTransform.fourierInv
          ((q - FourierTransform.fourier f :
            SchwartzMap (Euclidean 2) Complex).toLp 2 volume)),
        FourierTransform.fourier_fourierInv_eq]
    _ = eLpNorm ((q : Euclidean 2 -> Complex) -
        (FourierTransform.fourier f : Euclidean 2 -> Complex)) 2 volume :=
      Lp.enorm_toLp _

/-- Compact-frequency inverse Fourier transforms are `L²`-dense in smooth
compactly supported physical spatial factors. -/
theorem exists_compactFrequencySchwartz_eLpNorm_fourierInv_sub_le_of_smoothCompact
    (f : Euclidean 2 -> Complex) (hfcompact : HasCompactSupport f)
    (hfsmooth : ContDiff Real ∞ f) {epsilon : Real} (hepsilon : 0 < epsilon) :
    ∃ q : SchwartzMap (Euclidean 2) Complex,
      HasCompactSupport (q : Euclidean 2 -> Complex) ∧
      eLpNorm (((FourierTransform.fourierInv q : SchwartzMap (Euclidean 2) Complex) :
        Euclidean 2 -> Complex) - f) 2 volume ≤ ENNReal.ofReal epsilon := by
  let F : SchwartzMap (Euclidean 2) Complex := hfcompact.toSchwartzMap hfsmooth
  obtain ⟨g, hgcompact, hgsmooth, hclose⟩ :=
    (FourierTransform.fourier F).memLp 2 volume |>.exist_eLpNorm_sub_le
      (by norm_num) (by norm_num) hepsilon
  let q : SchwartzMap (Euclidean 2) Complex := hgcompact.toSchwartzMap hgsmooth
  refine ⟨q, ?_, ?_⟩
  · change HasCompactSupport g
    exact hgcompact
  · have hFfun : (F : Euclidean 2 -> Complex) = f := by rfl
    rw [← hFfun]
    rw [eLpNorm_two_fourierInv_sub_eq q F, eLpNorm_sub_comm]
    have hqfun : (q : Euclidean 2 -> Complex) = g := by rfl
    rw [hqfun]
    exact hclose

/-- The real spatial-factor specialization used by the finite tensor core. -/
theorem exists_compactFrequencySchwartz_eLpNorm_fourierInv_sub_le_of_realSmoothCompact
    (f : Euclidean 2 -> Real) (hfcompact : HasCompactSupport f)
    (hfsmooth : ContDiff Real ∞ f) {epsilon : Real} (hepsilon : 0 < epsilon) :
    ∃ q : SchwartzMap (Euclidean 2) Complex,
      HasCompactSupport (q : Euclidean 2 -> Complex) ∧
      eLpNorm (((FourierTransform.fourierInv q : SchwartzMap (Euclidean 2) Complex) :
        Euclidean 2 -> Complex) - fun x => (f x : Complex)) 2 volume ≤
        ENNReal.ofReal epsilon := by
  let F : Euclidean 2 -> Complex := fun x => (f x : Complex)
  have hFcompact : HasCompactSupport F := by
    change HasCompactSupport ((Complex.ofRealCLM : Real -> Complex) ∘ f)
    exact hfcompact.comp_left (g := Complex.ofRealCLM) rfl
  have hFsmooth : ContDiff Real ∞ F := by
    change ContDiff Real ∞ ((Complex.ofRealCLM : Real -> Complex) ∘ f)
    exact Complex.ofRealCLM.contDiff.comp hfsmooth
  obtain ⟨q, hqcompact, hqclose⟩ :=
    exists_compactFrequencySchwartz_eLpNorm_fourierInv_sub_le_of_smoothCompact
      F hFcompact hFsmooth hepsilon
  exact ⟨q, hqcompact, hqclose⟩

/-- Finite compact-frequency tensor replacement, with caller-controlled
per-factor real error budgets.  The RHS is precisely the Fubini product
cost; choosing the budgets after inspecting the finitely many time factors
gives an arbitrary prescribed total `L²` error. -/
theorem exists_compactFrequencyTensor_near_smoothRealSpatialTensor
    {ι : Type*} [Fintype ι]
    (U : ι → Euclidean 2 → Real)
    (a : ι → Real → Complex)
    (hUcompact : ∀ i, HasCompactSupport (U i))
    (hUsmooth : ∀ i, ContDiff Real ∞ (U i))
    (ha : ∀ i, Continuous (a i))
    (epsilon : ι → Real) (hepsilon : ∀ i, 0 < epsilon i) :
    ∃ q : ι → SchwartzMap (Euclidean 2) Complex,
      (∀ i, HasCompactSupport (q i : Euclidean 2 → Complex)) ∧
      eLpNorm
          (compactFrequencyTensor q a -
            smoothSpatialTensor (fun i x => (U i x : Complex)) a) 2 volume ≤
        ∑ i, ENNReal.ofReal (epsilon i) * eLpNorm (a i) 2 volume := by
  choose q hqcompact hqerr using fun i =>
    exists_compactFrequencySchwartz_eLpNorm_fourierInv_sub_le_of_realSmoothCompact
      (U i) (hUcompact i) (hUsmooth i) (hepsilon i)
  refine ⟨q, hqcompact, ?_⟩
  apply eLpNorm_compactFrequencyTensor_sub_smoothSpatialTensor_le q
    (fun i x => (U i x : Complex)) a
    (fun i => (Complex.ofRealCLM.continuous.comp (hUsmooth i).continuous))
    ha (fun i => ENNReal.ofReal (epsilon i))
  intro i
  simpa only using hqerr i

/-- Complex-valued spatial version of the preceding finite replacement.
This is the form directly compatible with a signed tube core. -/
theorem exists_compactFrequencyTensor_near_smoothSpatialTensor
    {ι : Type*} [Fintype ι]
    (U : ι → Euclidean 2 → Complex)
    (a : ι → Real → Complex)
    (hUcompact : ∀ i, HasCompactSupport (U i))
    (hUsmooth : ∀ i, ContDiff Real ∞ (U i))
    (ha : ∀ i, Continuous (a i))
    (epsilon : ι → Real) (hepsilon : ∀ i, 0 < epsilon i) :
    ∃ q : ι → SchwartzMap (Euclidean 2) Complex,
      (∀ i, HasCompactSupport (q i : Euclidean 2 → Complex)) ∧
      eLpNorm
          (compactFrequencyTensor q a - smoothSpatialTensor U a) 2 volume ≤
        ∑ i, ENNReal.ofReal (epsilon i) * eLpNorm (a i) 2 volume := by
  choose q hqcompact hqerr using fun i =>
    exists_compactFrequencySchwartz_eLpNorm_fourierInv_sub_le_of_smoothCompact
      (U i) (hUcompact i) (hUsmooth i) (hepsilon i)
  refine ⟨q, hqcompact, ?_⟩
  apply eLpNorm_compactFrequencyTensor_sub_smoothSpatialTensor_le q U a
    (fun i => (hUsmooth i).continuous) ha
    (fun i => ENNReal.ofReal (epsilon i))
  intro i
  simpa only using hqerr i

/-- Finite families of finite `ENNReal` weights admit strictly positive real
budgets with arbitrarily small weighted total.  This removes the usual
informal finite-error-allocation step from the tensor-density argument. -/
theorem exists_positive_real_budgets
    {ι : Type*} [Fintype ι] (B : ι → ENNReal)
    (hBtop : ∀ i, B i ≠ (⊤ : ENNReal)) {epsilon : Real} (hepsilon : 0 < epsilon) :
    ∃ r : ι → Real, (∀ i, 0 < r i) ∧
      (∑ i, ENNReal.ofReal (r i) * B i) < ENNReal.ofReal epsilon := by
  let S : Real := ∑ i, (B i).toReal
  have hSnonneg : 0 ≤ S := by
    dsimp only [S]
    exact Finset.sum_nonneg fun i hi => ENNReal.toReal_nonneg
  let c : Real := epsilon / (2 * (S + 1))
  have hcpos : 0 < c := by
    dsimp only [c]
    positivity
  refine ⟨fun _ => c, fun _ => hcpos, ?_⟩
  have hsumB : (∑ i, B i) = ENNReal.ofReal S := by
    rw [show (∑ i, B i) = ∑ i, ENNReal.ofReal (B i).toReal by
      apply Finset.sum_congr rfl
      intro i hi
      exact (ENNReal.ofReal_toReal (hBtop i)).symm]
    exact (ENNReal.ofReal_sum_of_nonneg
      (s := Finset.univ) (f := fun i => (B i).toReal)
      (fun i hi => ENNReal.toReal_nonneg)).symm
  calc
    (∑ i, ENNReal.ofReal ((fun _ => c) i) * B i) =
        ENNReal.ofReal c * (∑ i, B i) := by
          rw [Finset.mul_sum]
    _ = ENNReal.ofReal c * ENNReal.ofReal S := by rw [hsumB]
    _ = ENNReal.ofReal (c * S) := by
      rw [ENNReal.ofReal_mul hcpos.le]
    _ < ENNReal.ofReal epsilon := by
      rw [ENNReal.ofReal_lt_ofReal_iff hepsilon]
      dsimp only [c]
      have hdenompos : 0 < 2 * (S + 1) := by positivity
      have hfrac : S / (S + 1) < 1 := by
        rw [div_lt_one (by positivity)]
        linarith
      calc
        epsilon / (2 * (S + 1)) * S =
            (epsilon / 2) * (S / (S + 1)) := by field_simp
        _ < (epsilon / 2) * 1 :=
          (mul_lt_mul_of_pos_left hfrac (by positivity))
        _ < epsilon := by linarith

/-- The budgeted finite-replacement theorem in its customary arbitrary-error
form.  No dependence on the number or sizes of the time factors is hidden:
it is discharged by `exists_positive_real_budgets`. -/
theorem exists_compactFrequencyTensor_eLpNorm_sub_lt_smoothSpatialTensor
    {ι : Type*} [Fintype ι]
    (U : ι → Euclidean 2 → Complex)
    (a : ι → Real → Complex)
    (hUcompact : ∀ i, HasCompactSupport (U i))
    (hUsmooth : ∀ i, ContDiff Real ∞ (U i))
    (ha : ∀ i, Continuous (a i))
    (haMem : ∀ i, MemLp (a i) 2 volume)
    {epsilon : Real} (hepsilon : 0 < epsilon) :
    ∃ q : ι → SchwartzMap (Euclidean 2) Complex,
      (∀ i, HasCompactSupport (q i : Euclidean 2 → Complex)) ∧
      eLpNorm
          (compactFrequencyTensor q a - smoothSpatialTensor U a) 2 volume <
        ENNReal.ofReal epsilon := by
  obtain ⟨r, hrpos, hbudget⟩ :=
    exists_positive_real_budgets
      (fun i => eLpNorm (a i) 2 volume)
      (fun i => (haMem i).eLpNorm_ne_top) hepsilon
  obtain ⟨q, hqcompact, hqclose⟩ :=
    exists_compactFrequencyTensor_near_smoothSpatialTensor U a
      hUcompact hUsmooth ha r hrpos
  exact ⟨q, hqcompact, hqclose.trans_lt hbudget⟩

/-- Every finite compact-frequency/Schwartz-time tensor is an actual `L²`
input.  This discharges the `MemLp` component required by the slab-density
predicate, independently of the signed tube estimate. -/
theorem memLp_compactFrequencyTensor
    {ι : Type*} [Fintype ι]
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) :
    MemLp (compactFrequencyTensor q fun i => (a i : Real → Complex)) 2 volume := by
  let b : ι → WaveSpaceTime → Complex := fun i z =>
    (FourierTransform.fourierInv (q i) :
      SchwartzMap (Euclidean 2) Complex) z.1 * (a i : Real → Complex) z.2
  have hb : ∀ i, MemLp (b i) 2 volume := by
    intro i
    have hqmem : MemLp
        ((FourierTransform.fourierInv (q i) :
          SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex) 2 volume :=
      (FourierTransform.fourierInv (q i)).memLp 2 volume
    have hamem : MemLp (a i : Real → Complex) 2 volume :=
      (a i).memLp 2 volume
    refine ⟨((FourierTransform.fourierInv (q i)).continuous.comp continuous_fst).mul
      ((a i).continuous.comp continuous_snd) |>.aestronglyMeasurable, ?_⟩
    calc
      eLpNorm (b i) 2 volume =
          eLpNorm
            ((FourierTransform.fourierInv (q i) :
              SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex) 2 volume *
            eLpNorm (a i : Real → Complex) 2 volume := by
              dsimp only [b]
              simpa only [Measure.volume_eq_prod] using
                eLpNorm_two_prod_mul_eq (volume : Measure (Euclidean 2))
                  (volume : Measure Real)
                  ((FourierTransform.fourierInv (q i) :
                    SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex)
                  (a i : Real → Complex)
                  (FourierTransform.fourierInv (q i)).continuous.aestronglyMeasurable
                  (a i).continuous.aestronglyMeasurable
      _ < (⊤ : ENNReal) := ENNReal.mul_lt_top hqmem.2 hamem.2
  have hsum : MemLp (∑ i, b i) 2 volume :=
    memLp_finsetSum' Finset.univ (fun i _ => hb i)
  have hbsum : (∑ i, b i) =
      compactFrequencyTensor q fun i => (a i : Real → Complex) := by
    funext z
    simp [b, compactFrequencyTensor]
  rwa [hbsum] at hsum

/-- The abstract slab-density shape used by the signed-envelope closure.  It
is definitionally the same quantifier pattern as
`scratch_HasLightRaySlabL2DenseCore`, but leaves the restriction operator a
parameter so this file stays independent of the other scratch modules. -/
def HasL2DenseCoreAfter
    (R : (WaveSpaceTime -> Complex) -> WaveSpaceTime -> Complex)
    (Core : (WaveSpaceTime -> Complex) -> Prop) : Prop :=
  ∀ g : WaveSpaceTime -> Complex, MemLp g 2 volume →
    ∀ epsilon : Real, 0 < epsilon →
      ∃ f : WaveSpaceTime -> Complex,
        Core f ∧ MemLp f 2 volume ∧
          eLpNorm (R g - f) 2 volume < ENNReal.ofReal epsilon

/-- The final finite-tensor density transfer.  A smooth compact separated
slab core is dense iff its spatial factors may be replaced by the actual
finite compact-frequency tensor core.  The only core-specific inputs are
membership of the resulting tensor and the declaration that it belongs to
the intended `Core`; the quantitative replacement itself is proved above. -/
theorem hasL2DenseCoreAfter_of_smoothSeparatedSlabDensity
    (R : (WaveSpaceTime -> Complex) -> WaveSpaceTime -> Complex)
    (Core : (WaveSpaceTime -> Complex) -> Prop)
    (hRmem : ∀ g, MemLp g 2 volume -> MemLp (R g) 2 volume)
    (hsmooth : ∀ g : WaveSpaceTime -> Complex, MemLp g 2 volume ->
      ∀ epsilon : Real, 0 < epsilon ->
        ∃ (ι : Type) (_ : Fintype ι)
          (U : ι → Euclidean 2 → Complex) (a : ι → Real → Complex),
          (∀ i, HasCompactSupport (U i) ∧ ContDiff Real ∞ (U i)) ∧
          (∀ i, HasCompactSupport (a i) ∧ ContDiff Real ∞ (a i) ∧
            Function.support (a i) ⊆ lightRayTimeInterval) ∧
          MemLp (smoothSpatialTensor U a) 2 volume ∧
          eLpNorm (R g - smoothSpatialTensor U a) 2 volume <
            ENNReal.ofReal epsilon)
    (hcore : ∀ {ι : Type} [Fintype ι]
      (q : ι → SchwartzMap (Euclidean 2) Complex)
      (a : ι → SchwartzMap Real Complex),
      (∀ i, HasCompactSupport (q i : Euclidean 2 → Complex)) ->
      (∀ i, Function.support (a i : Real → Complex) ⊆ lightRayTimeInterval) ->
      Core (compactFrequencyTensor q fun i => (a i : Real → Complex))) :
    HasL2DenseCoreAfter R Core := by
  intro g hg epsilon hepsilon
  have hepshalf : 0 < epsilon / 2 := by positivity
  obtain ⟨ι, hι, U, a, hU, ha, hsmoothMem, hsmoothErr⟩ :=
    hsmooth g hg (epsilon / 2) hepshalf
  letI : Fintype ι := hι
  have haMem : ∀ i, MemLp (a i) 2 volume := by
    intro i
    exact (ha i).2.1.continuous.memLp_of_hasCompactSupport (ha i).1
  obtain ⟨q, hqcompact, hqerr⟩ :=
    exists_compactFrequencyTensor_eLpNorm_sub_lt_smoothSpatialTensor
      U a (fun i => (hU i).1) (fun i => (hU i).2)
      (fun i => (ha i).2.1.continuous) haMem hepshalf
  let atilde : ι → SchwartzMap Real Complex := fun i =>
    (ha i).1.toSchwartzMap (ha i).2.1
  have hatildeEq : ∀ i, (atilde i : Real → Complex) = a i := by
    intro i
    rfl
  let f : WaveSpaceTime -> Complex := compactFrequencyTensor q a
  have hatildeSupport : ∀ i,
      Function.support (atilde i : Real → Complex) ⊆ lightRayTimeInterval := by
    intro i
    rw [hatildeEq i]
    exact (ha i).2.2
  have hftilde : compactFrequencyTensor q (fun i => (atilde i : Real → Complex)) = f := by
    dsimp only [f]
    funext z
    simp only [compactFrequencyTensor]
    apply Finset.sum_congr rfl
    intro i hi
    rw [hatildeEq i]
  have hcoref : Core f := by
    rw [← hftilde]
    exact hcore q atilde hqcompact hatildeSupport
  have hfmem : MemLp f 2 volume := by
    rw [← hftilde]
    exact memLp_compactFrequencyTensor q atilde
  refine ⟨f, hcoref, hfmem, ?_⟩
  have hR : MemLp (R g) 2 volume := hRmem g hg
  have hfirstMem : MemLp (R g - smoothSpatialTensor U a) 2 volume :=
    hR.sub hsmoothMem
  have hsecondMem : MemLp (f - smoothSpatialTensor U a) 2 volume :=
    hfmem.sub hsmoothMem
  calc
    eLpNorm (R g - f) 2 volume =
        eLpNorm ((R g - smoothSpatialTensor U a) -
          (f - smoothSpatialTensor U a)) 2 volume := by
          congr 1
          funext z
          simp only [Pi.sub_apply]
          abel
    _ ≤ eLpNorm (R g - smoothSpatialTensor U a) 2 volume +
          eLpNorm (f - smoothSpatialTensor U a) 2 volume :=
      eLpNorm_sub_le hfirstMem.aestronglyMeasurable hsecondMem.aestronglyMeasurable
        (by norm_num)
    _ < ENNReal.ofReal (epsilon / 2) + ENNReal.ofReal (epsilon / 2) :=
      ENNReal.add_lt_add hsmoothErr (by
        simpa only [f] using hqerr)
    _ = ENNReal.ofReal epsilon := by
      rw [← ENNReal.ofReal_add hepshalf.le hepshalf.le]
      ring

/-- The actual finite compact-frequency core for the compact-time outer
estimate.  A common inner radius is retained rather than weakened to mere
membership of the light-ray slab, since the differentiated outer term needs
that margin uniformly over all temporal factors. -/
def InnerSlabCompactFrequencyTensorCore
    (f : WaveSpaceTime → Complex) : Prop :=
  ∃ (ι : Type) (_ : Fintype ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) (r : Real),
    (∀ i, HasCompactSupport (q i : Euclidean 2 → Complex)) ∧
    0 < r ∧ r < 1 ∧
    (∀ i, Function.support (a i : Real → Complex) ⊆
      Metric.closedBall (3 / 2 : Real) r) ∧
    f = compactFrequencyTensor q (fun i => (a i : Real → Complex))

private theorem scratch_timeClosedBall_subset_lightRayTimeInterval {r : Real}
    (hr : r < 1) :
    Metric.closedBall (3 / 2 : Real) r ⊆ lightRayTimeInterval := by
  intro t ht
  change dist t (3 / 2 : Real) ≤ r at ht
  have hdist : dist t (3 / 2 : Real) < 1 := lt_of_le_of_lt ht hr
  change (1 / 2 : Real) ≤ t ∧ t ≤ 5 / 2
  rw [Real.dist_eq] at hdist
  constructor <;> linarith [abs_lt.mp hdist]

/-- Compact-frequency replacement preserves a common strict inner-slab
margin.  This is the density interface consumed by the signed envelope
closure: the remaining input `hsmooth` is only finite separated smooth
density with the same margin. -/
theorem hasL2DenseInnerSlabCompactFrequencyTensorCoreAfter_of_smoothSeparatedDensity
    (R : (WaveSpaceTime → Complex) → WaveSpaceTime → Complex)
    (hRmem : ∀ g, MemLp g 2 volume → MemLp (R g) 2 volume)
    (hsmooth : ∀ g : WaveSpaceTime → Complex, MemLp g 2 volume →
      ∀ epsilon : Real, 0 < epsilon →
        ∃ (ι : Type) (_ : Fintype ι)
          (U : ι → Euclidean 2 → Complex) (a : ι → Real → Complex) (r : Real),
          0 < r ∧ r < 1 ∧
          (∀ i, HasCompactSupport (U i) ∧ ContDiff Real ∞ (U i)) ∧
          (∀ i, HasCompactSupport (a i) ∧ ContDiff Real ∞ (a i) ∧
            Function.support (a i) ⊆ Metric.closedBall (3 / 2 : Real) r) ∧
          MemLp (smoothSpatialTensor U a) 2 volume ∧
          eLpNorm (R g - smoothSpatialTensor U a) 2 volume <
            ENNReal.ofReal epsilon) :
    HasL2DenseCoreAfter R InnerSlabCompactFrequencyTensorCore := by
  intro g hg epsilon hepsilon
  have hepshalf : 0 < epsilon / 2 := by positivity
  obtain ⟨ι, hι, U, a, r, hrpos, hrlt, hU, ha, hsmoothMem, hsmoothErr⟩ :=
    hsmooth g hg (epsilon / 2) hepshalf
  letI : Fintype ι := hι
  have haMem : ∀ i, MemLp (a i) 2 volume := by
    intro i
    exact (ha i).2.1.continuous.memLp_of_hasCompactSupport (ha i).1
  obtain ⟨q, hqcompact, hqerr⟩ :=
    exists_compactFrequencyTensor_eLpNorm_sub_lt_smoothSpatialTensor
      U a (fun i => (hU i).1) (fun i => (hU i).2)
      (fun i => (ha i).2.1.continuous) haMem hepshalf
  let atilde : ι → SchwartzMap Real Complex := fun i =>
    (ha i).1.toSchwartzMap (ha i).2.1
  have hatildeEq : ∀ i, (atilde i : Real → Complex) = a i := by
    intro i
    rfl
  let f : WaveSpaceTime → Complex := compactFrequencyTensor q a
  have hatildeSupport : ∀ i,
      Function.support (atilde i : Real → Complex) ⊆
        Metric.closedBall (3 / 2 : Real) r := by
    intro i
    rw [hatildeEq i]
    exact (ha i).2.2
  have hftilde : compactFrequencyTensor q (fun i => (atilde i : Real → Complex)) = f := by
    dsimp only [f]
    funext z
    simp only [compactFrequencyTensor]
    apply Finset.sum_congr rfl
    intro i hi
    rw [hatildeEq i]
  have hcoref : InnerSlabCompactFrequencyTensorCore f := by
    refine ⟨ι, inferInstance, q, atilde, r, hqcompact, hrpos, hrlt,
      hatildeSupport, ?_⟩
    exact hftilde.symm
  have hfmem : MemLp f 2 volume := by
    rw [← hftilde]
    exact memLp_compactFrequencyTensor q atilde
  refine ⟨f, hcoref, hfmem, ?_⟩
  have hR : MemLp (R g) 2 volume := hRmem g hg
  have hfirstMem : MemLp (R g - smoothSpatialTensor U a) 2 volume :=
    hR.sub hsmoothMem
  have hsecondMem : MemLp (f - smoothSpatialTensor U a) 2 volume :=
    hfmem.sub hsmoothMem
  calc
    eLpNorm (R g - f) 2 volume =
        eLpNorm ((R g - smoothSpatialTensor U a) -
          (f - smoothSpatialTensor U a)) 2 volume := by
          congr 1
          funext z
          simp only [Pi.sub_apply]
          abel
    _ ≤ eLpNorm (R g - smoothSpatialTensor U a) 2 volume +
          eLpNorm (f - smoothSpatialTensor U a) 2 volume :=
      eLpNorm_sub_le hfirstMem.aestronglyMeasurable hsecondMem.aestronglyMeasurable
        (by norm_num)
    _ < ENNReal.ofReal (epsilon / 2) + ENNReal.ofReal (epsilon / 2) :=
      ENNReal.add_lt_add hsmoothErr (by
        simpa only [f] using hqerr)
    _ = ENNReal.ofReal epsilon := by
      rw [← ENNReal.ofReal_add hepshalf.le hepshalf.le]
      ring

end

