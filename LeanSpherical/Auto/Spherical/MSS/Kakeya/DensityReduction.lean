section Auto.Spherical.MSS

open Filter MeasureTheory Set
open Auto.Spherical.SurfaceMeasureDecay
open scoped ENNReal Topology EuclideanSpace

noncomputable section

/-- A fixed nonnegative smooth spatial bump, equal to one on the unit ball
and supported in the ball of radius two. -/
noncomputable def spatialCoreBump : SchwartzMap (Euclidean 2) Real := by
  let b : ContDiffBump (0 : Euclidean 2) := ⟨1, 2, by norm_num, by norm_num⟩
  have hcompact : HasCompactSupport (b : Euclidean 2 → Real) := by
    apply HasCompactSupport.intro (isCompact_closedBall (0 : Euclidean 2) 2)
    intro x hx
    have hdist : b.rOut ≤ dist x 0 := by
      have hx' : 2 < ‖x‖ := by
        simpa only [Metric.mem_closedBall, dist_zero_right, not_le] using hx
      simpa [b, dist_zero_right] using hx'.le
    exact b.zero_of_le_dist hdist
  exact hcompact.toSchwartzMap b.contDiff

private theorem spatialCoreBump_apply (x : Euclidean 2) :
    spatialCoreBump x =
      (let b : ContDiffBump (0 : Euclidean 2) := ⟨1, 2, by norm_num, by norm_num⟩
       b x) := by
  rfl

theorem spatialCoreBump_nonneg (x : Euclidean 2) :
    0 ≤ spatialCoreBump x := by
  rw [spatialCoreBump_apply]
  exact ContDiffBump.nonneg' _ _

theorem spatialCoreBump_le_one (x : Euclidean 2) :
    spatialCoreBump x ≤ 1 := by
  rw [spatialCoreBump_apply]
  exact ContDiffBump.le_one _

theorem spatialCoreBump_eq_one_of_norm_le_one {x : Euclidean 2}
    (hx : ‖x‖ ≤ 1) : spatialCoreBump x = 1 := by
  rw [spatialCoreBump_apply]
  let b : ContDiffBump (0 : Euclidean 2) := ⟨1, 2, by norm_num, by norm_num⟩
  have hdist : dist x 0 ≤ b.rIn := by
    simpa [b, dist_zero_right] using hx
  exact b.one_of_mem_closedBall hdist

theorem spatialCoreBump_eq_zero_of_two_le_norm {x : Euclidean 2}
    (hx : 2 ≤ ‖x‖) : spatialCoreBump x = 0 := by
  rw [spatialCoreBump_apply]
  let b : ContDiffBump (0 : Euclidean 2) := ⟨1, 2, by norm_num, by norm_num⟩
  have hdist : b.rOut ≤ dist x 0 := by
    simpa [b, dist_zero_right] using hx
  exact b.zero_of_le_dist hdist

/-- One smooth bump at spatial scale `r` dominates the polynomial profile on
the corresponding dyadic annulus. -/
theorem lightRayDecayProfile_le_scaledCore_of_half_le_norm_le
    (N : Nat) {r : Real} (hr : 0 < r) (u : Euclidean 2)
    (hlower : r / 2 ≤ ‖u‖) (hupper : ‖u‖ ≤ r) :
    lightRayDecayProfile N u ≤
      (2 : Real) ^ N * (r⁻¹) ^ N * spatialCoreBump (r⁻¹ • u) := by
  have hscaleNorm : ‖r⁻¹ • u‖ ≤ 1 := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hr)]
    exact (inv_mul_le_iff₀ hr).2 (by simpa [mul_comm] using hupper)
  have hbump : spatialCoreBump (r⁻¹ • u) = 1 :=
    spatialCoreBump_eq_one_of_norm_le_one hscaleNorm
  rw [hbump, mul_one]
  unfold lightRayDecayProfile
  have hden : r / 2 ≤ 1 + ‖u‖ := by linarith
  have hleftpos : 0 < r / 2 := by positivity
  have hrightpos : 0 < 1 + ‖u‖ := by positivity
  have hinv : 1 / (1 + ‖u‖) ≤ 2 * r⁻¹ := by
    have hratio : 1 / (1 + ‖u‖) ≤ 1 / (r / 2) :=
      one_div_le_one_div_of_le hleftpos hden
    calc
      1 / (1 + ‖u‖) ≤ 1 / (r / 2) := hratio
      _ = 2 * r⁻¹ := by field_simp [hr.ne']
  have hpow := pow_le_pow_left₀ (by positivity : 0 ≤ 1 / (1 + ‖u‖)) hinv N
  calc
    (1 / (1 + ‖u‖)) ^ N ≤ (2 * r⁻¹) ^ N := hpow
    _ = (2 : Real) ^ N * (r⁻¹) ^ N := by rw [mul_pow]

/-- The unit-scale core covers the low spatial-frequency ball. -/
theorem lightRayDecayProfile_le_spatialCoreBump_of_norm_le_one
    (N : Nat) (u : Euclidean 2) (hu : ‖u‖ ≤ 1) :
    lightRayDecayProfile N u ≤ spatialCoreBump u := by
  rw [spatialCoreBump_eq_one_of_norm_le_one hu]
  unfold lightRayDecayProfile
  have hbase : 1 / (1 + ‖u‖) ≤ 1 := by
    apply (div_le_one₀ (by positivity)).2
    linarith [norm_nonneg u]
  exact (pow_le_one₀ (by positivity) hbase)

/-- A natural-indexed dyadic annulus covers every point outside the unit ball. -/
private theorem exists_nat_dyadic_cover_of_one_lt_norm
    (u : Euclidean 2) (hu : 1 < ‖u‖) :
    ∃ k : Nat, (2 : Real) ^ k ≤ ‖u‖ ∧ ‖u‖ < (2 : Real) ^ (k + 1) := by
  rcases exists_mem_Ico_zpow (x := ‖u‖) (y := (2 : Real))
      (lt_trans (by norm_num) hu) (by norm_num : (1 : Real) < 2) with
    ⟨z, hzlo, hzhi⟩
  have hz_nonneg : 0 ≤ z := by
    by_contra hz
    have hzlt : z < 0 := lt_of_not_ge hz
    have hzplus : z + 1 ≤ 0 := by omega
    have htop : (2 : Real) ^ (z + 1) ≤ 1 :=
      (zpow_le_one_iff_right₀ (by norm_num : (1 : Real) < 2)).2 hzplus
    linarith
  refine ⟨z.toNat, ?_, ?_⟩
  · have hcast : (z.toNat : Int) = z := Int.toNat_of_nonneg hz_nonneg
    rw [← hcast] at hzlo
    exact_mod_cast hzlo
  · have hcast : ((z.toNat + 1 : Nat) : Int) = z + 1 := by
      rw [Int.natCast_add, Int.natCast_one, Int.toNat_of_nonneg hz_nonneg]
    rw [← hcast] at hzhi
    exact_mod_cast hzhi

/-- The `k`th smooth dyadic spatial core. -/
noncomputable def smoothDyadicSpatialCore (N k : Nat) (u : Euclidean 2) : Real :=
  (2 : Real) ^ N * (((2 : Real) ^ k)⁻¹) ^ N *
    spatialCoreBump (((2 : Real) ^ k)⁻¹ • u)

private theorem smoothDyadicSpatialCore_nonneg (N k : Nat) (u : Euclidean 2) :
    0 ≤ smoothDyadicSpatialCore N k u := by
  unfold smoothDyadicSpatialCore
  apply mul_nonneg
  · apply mul_nonneg
    · positivity
    · exact pow_nonneg (inv_nonneg.mpr (pow_nonneg (by norm_num) _)) _
  · exact spatialCoreBump_nonneg _

private theorem inv_dyadic_pow_eq_geometric (N k : Nat) :
    (((2 : Real) ^ k)⁻¹) ^ N = (((2 : Real)⁻¹) ^ N) ^ k := by
  calc
    (((2 : Real) ^ k)⁻¹) ^ N = (((2 : Real) ^ k) ^ N)⁻¹ := by rw [inv_pow]
    _ = ((2 : Real) ^ (k * N))⁻¹ := by rw [← pow_mul]
    _ = ((2 : Real) ^ (N * k))⁻¹ := by rw [Nat.mul_comm]
    _ = ((2 : Real)⁻¹) ^ (N * k) := by rw [inv_pow]
    _ = (((2 : Real)⁻¹) ^ N) ^ k := by rw [pow_mul]

private theorem smoothDyadicSpatialCore_le_geometric_majorant
    (N k : Nat) (u : Euclidean 2) :
    smoothDyadicSpatialCore N k u ≤
      (2 : Real) ^ N * (((2 : Real)⁻¹) ^ N) ^ k := by
  unfold smoothDyadicSpatialCore
  rw [inv_dyadic_pow_eq_geometric]
  calc
    (2 : Real) ^ N * (((2 : Real)⁻¹) ^ N) ^ k *
        spatialCoreBump (((2 : Real) ^ k)⁻¹ • u) ≤
      (2 : Real) ^ N * (((2 : Real)⁻¹) ^ N) ^ k * 1 := by
        gcongr
        exact spatialCoreBump_le_one _
    _ = (2 : Real) ^ N * (((2 : Real)⁻¹) ^ N) ^ k := by ring

private theorem summable_smoothDyadicSpatialCore
    (N : Nat) (hN : 0 < N) (u : Euclidean 2) :
    Summable (fun k : Nat => smoothDyadicSpatialCore N k u) := by
  let q : Real := ((2 : Real)⁻¹) ^ N
  have hq_nonneg : 0 ≤ q := by
    dsimp [q]
    positivity
  have hq_lt_one : q < 1 := by
    dsimp [q]
    apply pow_lt_one₀ (inv_nonneg.mpr (by norm_num : (0 : Real) ≤ 2))
      ((inv_lt_one₀ (by norm_num : (0 : Real) < 2)).2 (by norm_num))
    omega
  have hq_norm_lt_one : ‖q‖ < 1 := by
    rw [Real.norm_eq_abs, abs_of_nonneg hq_nonneg]
    exact hq_lt_one
  have hgeom : Summable (fun k : Nat => q ^ k) :=
    summable_geometric_of_norm_lt_one hq_norm_lt_one
  refine Summable.of_nonneg_of_le
    (f := fun k : Nat => (2 : Real) ^ N * q ^ k)
    (g := fun k : Nat => smoothDyadicSpatialCore N k u) ?_ ?_ ?_
  · intro k
    exact smoothDyadicSpatialCore_nonneg _ _ _
  · intro k
    simpa only [q] using smoothDyadicSpatialCore_le_geometric_majorant N k u
  · simpa only [mul_assoc, mul_left_comm, mul_comm] using hgeom.mul_left ((2 : Real) ^ N)

/-- The polynomial spatial tail is pointwise dominated by a summable
family of nonnegative smooth dyadic cores. -/
theorem lightRayDecayProfile_le_tsum_smoothDyadicSpatialCore
    (N : Nat) (hN : 0 < N) (u : Euclidean 2) :
    lightRayDecayProfile N u ≤ ∑' k : Nat, smoothDyadicSpatialCore N k u := by
  let hsum := summable_smoothDyadicSpatialCore N hN u
  by_cases hu : ‖u‖ ≤ 1
  · have hlow := lightRayDecayProfile_le_spatialCoreBump_of_norm_le_one N u hu
    have hpow : (1 : Real) ≤ (2 : Real) ^ N := one_le_pow₀ (by norm_num)
    have hb : 0 ≤ spatialCoreBump u := spatialCoreBump_nonneg _
    have hcore : spatialCoreBump u ≤ smoothDyadicSpatialCore N 0 u := by
      unfold smoothDyadicSpatialCore
      simp only [pow_zero, inv_one, one_pow, one_smul, mul_one]
      nlinarith
    refine hlow.trans (hcore.trans ?_)
    exact hsum.le_tsum 0 (fun j _ => smoothDyadicSpatialCore_nonneg _ _ _)
  · have hu' : 1 < ‖u‖ := lt_of_not_ge hu
    rcases exists_nat_dyadic_cover_of_one_lt_norm u hu' with ⟨k, hklo, hkhi⟩
    let r : Real := (2 : Real) ^ (k + 1)
    have hr : 0 < r := by dsimp [r]; positivity
    have hlower : r / 2 ≤ ‖u‖ := by
      dsimp [r]
      rw [pow_succ]
      nlinarith [hklo]
    have hupper : ‖u‖ ≤ r := by
      exact hkhi.le
    have hterm := lightRayDecayProfile_le_scaledCore_of_half_le_norm_le
      N hr u hlower hupper
    have hreindex :
        (2 : Real) ^ N * (r⁻¹) ^ N * spatialCoreBump (r⁻¹ • u) =
          smoothDyadicSpatialCore N (k + 1) u := by
      rfl
    rw [hreindex] at hterm
    refine hterm.trans ?_
    exact hsum.le_tsum (k + 1) (fun j _ => smoothDyadicSpatialCore_nonneg _ _ _)

/-- The literal light-ray kernel with its polynomial tail replaced by the
`k`th smooth dyadic spatial core.  The normalization remains at the original
width here; the later dilation identity will rewrite it as a width
`2^k * δ` tube kernel. -/
noncomputable def smoothDyadicLightRayKernel
    (δ : Real) (N k : Nat) (ω y : Euclidean 2) (z : WaveSpaceTime) : Real :=
  (δ⁻¹) ^ 2 * smoothDyadicSpatialCore N k
    (δ⁻¹ • (z.1 + z.2 • ω - y))

private theorem summable_smoothDyadicLightRayKernel
    {δ : Real} (N : Nat) (hN : 0 < N) (ω y : Euclidean 2) (z : WaveSpaceTime) :
    Summable (fun k : Nat => smoothDyadicLightRayKernel δ N k ω y z) := by
  unfold smoothDyadicLightRayKernel
  exact (summable_smoothDyadicSpatialCore N hN
    (δ⁻¹ • (z.1 + z.2 • ω - y))).mul_left ((δ⁻¹) ^ 2)

/-- The polynomial light-ray kernel is dominated pointwise by its summable
smooth dyadic expansion. -/
theorem lightRayKernel_le_tsum_smoothDyadicLightRayKernel
    {δ : Real} (hδ : 0 < δ) (N : Nat) (hN : 0 < N)
    (ω y : Euclidean 2) (z : WaveSpaceTime) :
    lightRayKernel δ N ω y z ≤
      ∑' k : Nat, smoothDyadicLightRayKernel δ N k ω y z := by
  let u : Euclidean 2 := δ⁻¹ • (z.1 + z.2 • ω - y)
  have hprofile := lightRayDecayProfile_le_tsum_smoothDyadicSpatialCore N hN u
  have hscale : 0 ≤ (δ⁻¹) ^ 2 := pow_nonneg (inv_nonneg.mpr hδ.le) _
  have hsum : Summable (fun k : Nat => smoothDyadicSpatialCore N k u) :=
    summable_smoothDyadicSpatialCore N hN u
  calc
    lightRayKernel δ N ω y z = (δ⁻¹) ^ 2 * lightRayDecayProfile N u := by
      simpa only [u] using lightRayKernel_eq_scaled_decayProfile hδ N ω y z.1 z.2
    _ ≤ (δ⁻¹) ^ 2 * ∑' k : Nat, smoothDyadicSpatialCore N k u :=
      mul_le_mul_of_nonneg_left hprofile hscale
    _ = ∑' k : Nat, smoothDyadicLightRayKernel δ N k ω y z := by
      rw [← tsum_mul_left]
      rfl

/-- The normalized smooth tube kernel at one transverse width. -/
noncomputable def smoothLightRayCore
    (ρ : Real) (ω y : Euclidean 2) (z : WaveSpaceTime) : Real :=
  (ρ⁻¹) ^ 2 * spatialCoreBump (ρ⁻¹ • (z.1 + z.2 • ω - y))

/-- Re-indexing a dyadic core exposes a normalized tube kernel at the larger
width `2^k * δ`; its coefficient is summable once `N > 2`. -/
private theorem smoothDyadicLightRayKernel_eq_weighted_smoothLightRayCore
    (δ : Real) (N k : Nat) (hN : 2 ≤ N)
    (ω y : Euclidean 2) (z : WaveSpaceTime) :
    smoothDyadicLightRayKernel δ N k ω y z =
      (2 : Real) ^ N * (((2 : Real) ^ k)⁻¹) ^ (N - 2) *
        smoothLightRayCore (δ * (2 : Real) ^ k) ω y z := by
  have hpow : N = (N - 2) + 2 := by omega
  unfold smoothDyadicLightRayKernel smoothDyadicSpatialCore smoothLightRayCore
  have hqpow : (((2 : Real) ^ k)⁻¹) ^ N =
      (((2 : Real) ^ k)⁻¹) ^ (N - 2) * (((2 : Real) ^ k)⁻¹) ^ 2 := by
    calc
      (((2 : Real) ^ k)⁻¹) ^ N =
          (((2 : Real) ^ k)⁻¹) ^ ((N - 2) + 2) :=
        congrArg (fun m : Nat => (((2 : Real) ^ k)⁻¹) ^ m) hpow
      _ = (((2 : Real) ^ k)⁻¹) ^ (N - 2) * (((2 : Real) ^ k)⁻¹) ^ 2 :=
        pow_add _ _ _
  rw [hqpow, mul_inv]
  simp only [smul_smul]
  have harg :
      (((2 : Real) ^ k)⁻¹ * δ⁻¹) • (z.1 + z.2 • ω - y) =
        (δ⁻¹ * ((2 : Real) ^ k)⁻¹) • (z.1 + z.2 • ω - y) := by
    rw [mul_comm]
  rw [harg]
  ring

/-- The coefficients left after normalizing the `k`th tube have a geometric
sum for every decay exponent larger than the spatial dimension. -/
private theorem summable_smoothDyadicLightRayCoefficient
    (N : Nat) (hN : 2 < N) :
    Summable (fun k : Nat =>
      (2 : Real) ^ N * (((2 : Real) ^ k)⁻¹) ^ (N - 2)) := by
  let q : Real := ((2 : Real)⁻¹) ^ (N - 2)
  have hgap : 0 < N - 2 := by omega
  have hq_nonneg : 0 ≤ q := by
    dsimp [q]
    positivity
  have hq_lt_one : q < 1 := by
    dsimp [q]
    apply pow_lt_one₀ (inv_nonneg.mpr (by norm_num : (0 : Real) ≤ 2))
      ((inv_lt_one₀ (by norm_num : (0 : Real) < 2)).2 (by norm_num))
    omega
  have hq_norm_lt_one : ‖q‖ < 1 := by
    rw [Real.norm_eq_abs, abs_of_nonneg hq_nonneg]
    exact hq_lt_one
  have hgeom : Summable (fun k : Nat => q ^ k) :=
    summable_geometric_of_norm_lt_one hq_norm_lt_one
  have heq (k : Nat) : (((2 : Real) ^ k)⁻¹) ^ (N - 2) = q ^ k := by
    dsimp [q]
    exact inv_dyadic_pow_eq_geometric (N - 2) k
  simpa only [heq, mul_assoc, mul_left_comm, mul_comm] using
    hgeom.mul_left ((2 : Real) ^ N)

/-- A literal polynomial light-ray kernel is bounded by a summable family of
normalized smooth tube kernels at dyadic larger widths. -/
theorem lightRayKernel_le_tsum_weighted_smoothLightRayCore
    {δ : Real} (hδ : 0 < δ) (N : Nat) (hN : 2 < N)
    (ω y : Euclidean 2) (z : WaveSpaceTime) :
    lightRayKernel δ N ω y z ≤
      ∑' k : Nat,
        ((2 : Real) ^ N * (((2 : Real) ^ k)⁻¹) ^ (N - 2)) *
          smoothLightRayCore (δ * (2 : Real) ^ k) ω y z := by
  calc
    lightRayKernel δ N ω y z ≤
        ∑' k : Nat, smoothDyadicLightRayKernel δ N k ω y z :=
      lightRayKernel_le_tsum_smoothDyadicLightRayKernel hδ N (by omega) ω y z
    _ = ∑' k : Nat,
        ((2 : Real) ^ N * (((2 : Real) ^ k)⁻¹) ^ (N - 2)) *
          smoothLightRayCore (δ * (2 : Real) ^ k) ω y z := by
      apply tsum_congr
      intro k
      exact smoothDyadicLightRayKernel_eq_weighted_smoothLightRayCore
        δ N k (by omega) ω y z

end

