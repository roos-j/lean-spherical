noncomputable def tensorAlgHom (X Y : Type*) [TopologicalSpace X] [TopologicalSpace Y] :
    C(X, Real) ⊗[Real] C(Y, Real) →ₐ[Real] C(X × Y, Real) :=
  Algebra.TensorProduct.lift
    (ContinuousMap.compRightAlgHom Real Real (ContinuousMap.fst : C(X × Y, X)))
    (ContinuousMap.compRightAlgHom Real Real (ContinuousMap.snd : C(X × Y, Y)))
    (fun _ _ => Commute.all _ _)

theorem tensorAlgHom_tmul (X Y : Type*) [TopologicalSpace X] [TopologicalSpace Y]
    (f : C(X, Real)) (g : C(Y, Real)) :
    tensorAlgHom X Y (f ⊗ₜ[Real] g) =
      fun p : X × Y => f p.1 * g p.2 := by
  rw [tensorAlgHom, Algebra.TensorProduct.lift_tmul]
  rfl

theorem tensorAlgHom_range_separatesPoints (X Y : Type*)
    [TopologicalSpace X] [TopologicalSpace Y] [T35Space X] [T35Space Y] :
    (tensorAlgHom X Y).range.SeparatesPoints := by
  rintro ⟨x₁, y₁⟩ ⟨x₂, y₂⟩ hne
  by_cases hx : x₁ = x₂
  · have hy : y₁ ≠ y₂ := fun hy => hne (Prod.ext hx hy)
    obtain ⟨g, hgcont, hgne⟩ :=
      (_root_.separatesPoints_continuous_of_t35Space hy)
    let G : C(Y, Real) := ⟨g, hgcont⟩
    refine ⟨_, ⟨tensorAlgHom X Y ((1 : C(X, Real)) ⊗ₜ[Real] G), ⟨_, rfl⟩, rfl⟩, ?_⟩
    change (tensorAlgHom X Y ((1 : C(X, Real)) ⊗ₜ[Real] G)) (x₁, y₁) ≠
      (tensorAlgHom X Y ((1 : C(X, Real)) ⊗ₜ[Real] G)) (x₂, y₂)
    rw [tensorAlgHom_tmul]
    simpa [G] using hgne
  · obtain ⟨f, hfcont, hfne⟩ :=
      (_root_.separatesPoints_continuous_of_t35Space hx)
    let F : C(X, Real) := ⟨f, hfcont⟩
    refine ⟨_, ⟨tensorAlgHom X Y (F ⊗ₜ[Real] (1 : C(Y, Real))), ⟨_, rfl⟩, rfl⟩, ?_⟩
    change (tensorAlgHom X Y (F ⊗ₜ[Real] (1 : C(Y, Real)))) (x₁, y₁) ≠
      (tensorAlgHom X Y (F ⊗ₜ[Real] (1 : C(Y, Real)))) (x₂, y₂)
    rw [tensorAlgHom_tmul]
    simpa [F] using hfne

theorem exists_tensorAlgHom_near (X Y : Type*)
    [TopologicalSpace X] [TopologicalSpace Y]
    [CompactSpace X] [CompactSpace Y] [T35Space X] [T35Space Y]
    (f : C(X × Y, Real)) {epsilon : Real} (hepsilon : 0 < epsilon) :
    exists z : C(X, Real) ⊗[Real] C(Y, Real),
      ‖tensorAlgHom X Y z - f‖ < epsilon := by
  obtain ⟨g, hg⟩ :=
    ContinuousMap.exists_mem_subalgebra_near_continuousMap_of_separatesPoints
      (tensorAlgHom X Y).range (tensorAlgHom_range_separatesPoints X Y)
      f epsilon hepsilon
  rcases g.property with ⟨z, hz⟩
  refine ⟨z, ?_⟩
  change tensorAlgHom X Y z = (g : C(X × Y, Real)) at hz
  rw [hz]
  exact hg

theorem tensorAlgHom_exists_finite_sum (X Y : Type*) [TopologicalSpace X] [TopologicalSpace Y]
    (z : C(X, Real) ⊗[Real] C(Y, Real)) :
    ∃ (ι : Type) (_ : Fintype ι)
      (u : ι → C(X, Real)) (v : ι → C(Y, Real)),
      tensorAlgHom X Y z = ∑ i : ι, ContinuousMap.prodMul (u i) (v i) := by
  induction z using TensorProduct.induction_on with
  | zero =>
      refine ⟨Empty, inferInstance, Empty.elim, Empty.elim, ?_⟩
      simp
  | tmul x y =>
      refine ⟨Unit, inferInstance, fun _ => x, fun _ => y, ?_⟩
      have h : tensorAlgHom X Y (x ⊗ₜ[Real] y) = ContinuousMap.prodMul x y := by
        apply ContinuousMap.ext
        intro p
        rw [ContinuousMap.prodMul_apply]
        exact congrFun (tensorAlgHom_tmul X Y x y) p
      simpa using h
  | add x y hx hy =>
      rcases hx with ⟨ι, hι, u, v, huv⟩
      rcases hy with ⟨κ, hκ, u', v', hu'v'⟩
      letI : Fintype ι := hι
      letI : Fintype κ := hκ
      refine ⟨Sum ι κ, inferInstance, Sum.elim u u', Sum.elim v v', ?_⟩
      calc
        tensorAlgHom X Y (x + y) = tensorAlgHom X Y x + tensorAlgHom X Y y := by
          exact map_add (tensorAlgHom X Y) x y
        _ = (∑ i : ι, ContinuousMap.prodMul (u i) (v i)) +
            ∑ j : κ, ContinuousMap.prodMul (u' j) (v' j) := by rw [huv, hu'v']
        _ = ∑ k : Sum ι κ,
            ContinuousMap.prodMul (Sum.elim u u' k) (Sum.elim v v' k) := by
          rw [Fintype.sum_sum_type]
          rfl

theorem exists_contDiff_compactSupport_uniform_close
    (E : Type*) [NormedAddCommGroup E] [NormedSpace Real E] [FiniteDimensional Real E]
    (f : E → Real) (hfcont : Continuous f) (hfcompact : HasCompactSupport f)
    {epsilon : Real} (hepsilon : 0 < epsilon) :
    ∃ g : E → Real, ContDiff Real (↑(⊤ : ℕ∞)) g ∧ HasCompactSupport g ∧
      (∀ x, dist (g x) (f x) < epsilon) ∧ Function.support g ⊆ Function.support f := by
  obtain ⟨g, hgdiff, hgclose, hgsupp⟩ :=
    hfcont.exists_contDiff_approx ⊤ (continuous_const) (fun _ => hepsilon)
  exact ⟨g, hgdiff, hfcompact.mono hgsupp, hgclose, hgsupp⟩

/-- A continuous real factor on a closed ball admits a globally smooth compactly
supported approximation; the support remains inside a prescribed larger bump. -/
theorem exists_smooth_compact_factor_near_closedBall
    (E : Type*) [NormedAddCommGroup E] [NormedSpace Real E]
    [FiniteDimensional Real E] [HasContDiffBump E]
    (c : E) {r R epsilon : Real} (hr : 0 < r) (hrR : r < R)
    (u : C(Metric.closedBall c r, Real)) (hepsilon : 0 < epsilon) :
    ∃ U : E → Real, ContDiff Real (↑(⊤ : ℕ∞)) U ∧
      HasCompactSupport U ∧ Function.support U ⊆ Metric.closedBall c R ∧
      (∀ (x : E) (hx : x ∈ Metric.closedBall c r),
        dist (U x) (u ⟨x, hx⟩) < epsilon) := by
  let b : ContDiffBump c := ⟨r, R, hr, hrR⟩
  obtain ⟨uExt, huExt⟩ :=
    ContinuousMap.exists_extension
      (e := (Subtype.val : Metric.closedBall c r → E))
      Metric.isClosed_closedBall.isClosedEmbedding_subtypeVal u
  let h : E → Real := fun x => b x * uExt x
  have hhcont : Continuous h := by
    exact (b.contDiff (n := (⊤ : ℕ∞))).continuous.mul uExt.continuous
  have hhcompact : HasCompactSupport h := by
    exact b.hasCompactSupport.mul_right
  obtain ⟨U, hUdiff, hUcompact, hUclose, hUsupp⟩ :=
    exists_contDiff_compactSupport_uniform_close E h hhcont hhcompact hepsilon
  refine ⟨U, hUdiff, hUcompact, ?_, ?_⟩
  · intro x hx
    have hxH : x ∈ Function.support h := hUsupp hx
    have hxB : x ∈ Function.support (b : E → Real) :=
      (Function.support_mul_subset_left _ _) (by simpa only [h] using hxH)
    rw [Metric.mem_closedBall]
    by_contra hdist
    have hRle : R ≤ dist x c := le_of_not_ge hdist
    have hbzero : b x = 0 := b.zero_of_le_dist hRle
    exact hxB hbzero
  · intro x hx
    have hb : b x = 1 := b.one_of_mem_closedBall hx
    have hu : uExt x = u ⟨x, hx⟩ := by
      have hcomp := congrArg
        (fun q : C(Metric.closedBall c r, Real) => q ⟨x, hx⟩) huExt
      simpa using hcomp
    have heq : h x = u ⟨x, hx⟩ := by simp only [h, hb, one_mul, hu]
    have hclose := hUclose x
    rw [heq] at hclose
    exact hclose

/-- Cut off a continuous factor defined on an outer closed ball, then smooth it
without enlarging its support.  Unlike
`exists_smooth_compact_factor_near_closedBall`, this records the cut-off
function itself; this is the form needed when a Stone--Weierstrass sum has to
remain small on the collar where the target vanishes. -/
theorem exists_smooth_cutoff_extension_uniform_close
    (E : Type*) [NormedAddCommGroup E] [NormedSpace Real E]
    [FiniteDimensional Real E] [HasContDiffBump E]
    (c : E) {r R epsilon : Real} (hr : 0 < r) (hrR : r < R)
    (u : C(Metric.closedBall c R, Real)) (hepsilon : 0 < epsilon) :
    ∃ H U : E → Real,
      Continuous H ∧ HasCompactSupport H ∧
      Function.support H ⊆ Metric.closedBall c R ∧
      (∀ (x : E) (hx : x ∈ Metric.closedBall c R),
        H x = (⟨r, R, hr, hrR⟩ : ContDiffBump c) x * u ⟨x, hx⟩) ∧
      ContDiff Real (↑(⊤ : ℕ∞)) U ∧ HasCompactSupport U ∧
      Function.support U ⊆ Metric.closedBall c R ∧
      (∀ x, dist (U x) (H x) < epsilon) := by
  let b : ContDiffBump c := ⟨r, R, hr, hrR⟩
  obtain ⟨uExt, huExt⟩ :=
    ContinuousMap.exists_extension
      (e := (Subtype.val : Metric.closedBall c R → E))
      Metric.isClosed_closedBall.isClosedEmbedding_subtypeVal u
  let H : E → Real := fun x => b x * uExt x
  have hHcont : Continuous H := by
    exact (b.contDiff (n := (⊤ : ℕ∞))).continuous.mul uExt.continuous
  have hHcompact : HasCompactSupport H := by
    exact b.hasCompactSupport.mul_right
  have hHsupp : Function.support H ⊆ Metric.closedBall c R := by
    intro x hx
    have hxB : x ∈ Function.support (b : E → Real) :=
      (Function.support_mul_subset_left _ _) (by simpa only [H] using hx)
    rw [Metric.mem_closedBall]
    by_contra hdist
    have hRle : R ≤ dist x c := le_of_not_ge hdist
    have hbzero : b x = 0 := b.zero_of_le_dist hRle
    exact hxB hbzero
  obtain ⟨U, hUdiff, hUcompact, hUclose, hUsupp⟩ :=
    exists_contDiff_compactSupport_uniform_close E H hHcont hHcompact hepsilon
  refine ⟨H, U, hHcont, hHcompact, hHsupp, ?_, hUdiff, hUcompact, ?_, hUclose⟩
  · intro x hx
    have hu : uExt x = u ⟨x, hx⟩ := by
      have hcomp := congrArg
        (fun q : C(Metric.closedBall c R, Real) => q ⟨x, hx⟩) huExt
      simpa using hcomp
    change b x * uExt x = _
    simpa only [b] using congrArg (fun q : Real => b x * q) hu
  · intro x hx
    exact hHsupp (hUsupp hx)

private theorem eq_zero_of_support_subset
    {X Y : Type*} [Zero Y] (f : X → Y) {s : Set X}
    (hfs : Function.support f ⊆ s) {x : X} (hx : x ∉ s) : f x = 0 := by
  by_contra hne
  exact hx (hfs hne)

/-- The concrete compact-product corollary of Stone--Weierstrass.  A
continuous function supported in an inner product of balls is uniformly
approximated on the whole ambient product by a finite sum of separated,
compactly supported continuous factors.  The cutoffs are essential: they
make the approximation global without asking a Tietze extension to preserve
the cancellations of the tensor sum outside the compact product. -/
theorem exists_finite_continuous_compact_separated_uniform_close
    (E F : Type*) [NormedAddCommGroup E] [NormedSpace Real E]
    [NormedAddCommGroup F] [NormedSpace Real F]
    [FiniteDimensional Real E] [FiniteDimensional Real F]
    [HasContDiffBump E] [HasContDiffBump F]
    (cE : E) (cF : F) {rE RE rF RF epsilon : Real}
    (hrE : 0 < rE) (hrERE : rE < RE)
    (hrF : 0 < rF) (hrFRF : rF < RF)
    (f : E × F → Real) (hfcont : Continuous f)
    (hfsupp : Function.support f ⊆
      Metric.closedBall cE rE ×ˢ Metric.closedBall cF rF)
    (hepsilon : 0 < epsilon) :
    ∃ (ι : Type) (_ : Fintype ι) (H : ι → E → Real) (K : ι → F → Real),
      (∀ i, Continuous (H i) ∧ HasCompactSupport (H i) ∧
        Function.support (H i) ⊆ Metric.closedBall cE RE) ∧
      (∀ i, Continuous (K i) ∧ HasCompactSupport (K i) ∧
        Function.support (K i) ⊆ Metric.closedBall cF RF) ∧
      ∀ p : E × F, dist (∑ i : ι, H i p.1 * K i p.2) (f p) < epsilon := by
  let X := Metric.closedBall cE RE
  let Y := Metric.closedBall cF RF
  letI : CompactSpace X := isCompact_iff_compactSpace.mp
    (by simpa only [X] using isCompact_closedBall cE RE)
  letI : CompactSpace Y := isCompact_iff_compactSpace.mp
    (by simpa only [Y] using isCompact_closedBall cF RF)
  let fC : C(X × Y, Real) :=
    ⟨fun p => f (p.1, p.2),
      hfcont.comp
        ((continuous_subtype_val.comp continuous_fst).prodMk
          (continuous_subtype_val.comp continuous_snd))⟩
  obtain ⟨z, hz⟩ := exists_tensorAlgHom_near X Y fC hepsilon
  obtain ⟨ι, hι, u, v, huv⟩ := tensorAlgHom_exists_finite_sum X Y z
  letI : Fintype ι := hι
  choose H U hHcont hHcompact hHsupp hHform hUdiff hUcompact hUsupp hUclose using
    fun i : ι => exists_smooth_cutoff_extension_uniform_close E cE hrE hrERE
      (u i) (by positivity : (0 : Real) < 1)
  choose K V hKcont hKcompact hKsupp hKform hVdiff hVcompact hVsupp hVclose using
    fun i : ι => exists_smooth_cutoff_extension_uniform_close F cF hrF hrFRF
      (v i) (by positivity : (0 : Real) < 1)
  refine ⟨ι, inferInstance, H, K, ?_, ?_, ?_⟩
  · intro i
    exact ⟨hHcont i, hHcompact i, hHsupp i⟩
  · intro i
    exact ⟨hKcont i, hKcompact i, hKsupp i⟩
  let bE : ContDiffBump cE := ⟨rE, RE, hrE, hrERE⟩
  let bF : ContDiffBump cF := ⟨rF, RF, hrF, hrFRF⟩
  have hpoint (x : X) (y : Y) :
      dist ((tensorAlgHom X Y z) (x, y)) (fC (x, y)) < epsilon := by
    have hle : ‖(tensorAlgHom X Y z - fC) (x, y)‖ ≤
        ‖tensorAlgHom X Y z - fC‖ :=
      ContinuousMap.norm_coe_le_norm _ _
    have hlt : ‖(tensorAlgHom X Y z - fC) (x, y)‖ < epsilon :=
      lt_of_le_of_lt hle hz
    simpa only [ContinuousMap.sub_apply, dist_eq_norm] using hlt
  have hsum (x : E) (hx : x ∈ X) (y : F) (hy : y ∈ Y) :
      (∑ i : ι, H i x * K i y) =
        (bE x * bF y) * (tensorAlgHom X Y z) (⟨x, hx⟩, ⟨y, hy⟩) := by
    rw [huv]
    simp only [ContinuousMap.sum_apply, ContinuousMap.prodMul_apply]
    calc
      (∑ i : ι, H i x * K i y) =
          ∑ i : ι, (bE x * bF y) *
            (u i ⟨x, hx⟩ * v i ⟨y, hy⟩) := by
        apply Finset.sum_congr rfl
        intro i hi
        rw [hHform i x hx, hKform i y hy]
        change (bE x * u i ⟨x, hx⟩) * (bF y * v i ⟨y, hy⟩) = _
        ring
      _ = (bE x * bF y) *
          ∑ i : ι, u i ⟨x, hx⟩ * v i ⟨y, hy⟩ := by
        rw [Finset.mul_sum]
  have hf_cut (x : E) (y : F) :
      (bE x * bF y) * f (x, y) = f (x, y) := by
    by_cases hzero : f (x, y) = 0
    · simp [hzero]
    · have hm : (x, y) ∈ Function.support f := hzero
      rcases hfsupp hm with ⟨hxr, hyr⟩
      have hbE : bE x = 1 := bE.one_of_mem_closedBall hxr
      have hbF : bF y = 1 := bF.one_of_mem_closedBall hyr
      simp [hbE, hbF]
  intro p
  by_cases hp : p.1 ∈ X ∧ p.2 ∈ Y
  · rcases hp with ⟨hpx, hpy⟩
    have hbe0 : 0 ≤ bE p.1 := bE.nonneg' p.1
    have hbf0 : 0 ≤ bF p.2 := bF.nonneg' p.2
    have hbe1 : bE p.1 ≤ 1 := bE.le_one
    have hbf1 : bF p.2 ≤ 1 := bF.le_one
    have hbnorm : ‖bE p.1 * bF p.2‖ ≤ 1 := by
      rw [norm_mul, Real.norm_eq_abs, abs_of_nonneg hbe0,
        Real.norm_eq_abs, abs_of_nonneg hbf0]
      nlinarith
    rw [hsum p.1 hpx p.2 hpy, ← hf_cut p.1 p.2]
    rw [dist_eq_norm, ← mul_sub, norm_mul]
    calc
      ‖bE p.1 * bF p.2‖ *
          ‖(tensorAlgHom X Y z) (⟨p.1, hpx⟩, ⟨p.2, hpy⟩) -
            fC (⟨p.1, hpx⟩, ⟨p.2, hpy⟩)‖ ≤
          1 * ‖(tensorAlgHom X Y z) (⟨p.1, hpx⟩, ⟨p.2, hpy⟩) -
            fC (⟨p.1, hpx⟩, ⟨p.2, hpy⟩)‖ := by
        gcongr
      _ < epsilon := by
        simpa only [one_mul, dist_eq_norm] using hpoint ⟨p.1, hpx⟩ ⟨p.2, hpy⟩
  · have hsumzero : (∑ i : ι, H i p.1 * K i p.2) = 0 := by
      by_cases hpx : p.1 ∈ X
      · have hpy : p.2 ∉ Y := fun hpy => hp ⟨hpx, hpy⟩
        have hKzero (i : ι) : K i p.2 = 0 :=
          eq_zero_of_support_subset (K i) (hKsupp i) hpy
        simp [hKzero]
      · have hHzero (i : ι) : H i p.1 = 0 :=
          eq_zero_of_support_subset (H i) (hHsupp i) hpx
        simp [hHzero]
    have hfzero : f p = 0 := by
      by_contra hne
      have hm : p ∈ Function.support f := hne
      rcases hfsupp hm with ⟨hxr, hyr⟩
      apply hp
      exact ⟨Metric.closedBall_subset_closedBall hrERE.le hxr,
        Metric.closedBall_subset_closedBall hrFRF.le hyr⟩
    simp [hsumzero, hfzero, hepsilon]

/-- A finite separated continuous sum can be smoothed factor by factor while
retaining a prescribed global uniform error.  The deliberately explicit
`M` hypotheses make the lemma reusable with any compact-factor construction;
for compactly supported continuous factors the required bounds follow from
`Continuous.bounded_above_of_compact_support`. -/
theorem exists_finite_smooth_separated_uniform_close_of_bounded
    (E F ι : Type*) [NormedAddCommGroup E] [NormedSpace Real E]
    [NormedAddCommGroup F] [NormedSpace Real F]
    [FiniteDimensional Real E] [FiniteDimensional Real F] [Fintype ι]
    (H : ι → E → Real) (K : ι → F → Real)
    (hHcont : ∀ i, Continuous (H i)) (hKcont : ∀ i, Continuous (K i))
    (hHcompact : ∀ i, HasCompactSupport (H i))
    (hKcompact : ∀ i, HasCompactSupport (K i))
    (M : Real) (hM : 1 ≤ M) (hcard : (Fintype.card ι : Real) ≤ M)
    (hHbound : ∀ i x, ‖H i x‖ ≤ M) (hKbound : ∀ i y, ‖K i y‖ ≤ M)
    {epsilon : Real} (hepsilon : 0 < epsilon) :
    ∃ (U : ι → E → Real) (V : ι → F → Real),
      (∀ i, ContDiff Real (↑(⊤ : ℕ∞)) (U i) ∧
        HasCompactSupport (U i) ∧ Function.support (U i) ⊆ Function.support (H i)) ∧
      (∀ i, ContDiff Real (↑(⊤ : ℕ∞)) (V i) ∧
        HasCompactSupport (V i) ∧ Function.support (V i) ⊆ Function.support (K i)) ∧
      ∀ p : E × F,
        dist (∑ i : ι, U i p.1 * V i p.2)
          (∑ i : ι, H i p.1 * K i p.2) < epsilon := by
  let d : Real := min 1 (epsilon / (4 * M ^ 2))
  have hMpos : 0 < M := lt_of_lt_of_le zero_lt_one hM
  have hM2pos : 0 < M ^ 2 := sq_pos_of_pos hMpos
  have hdpos : 0 < d := by
    exact lt_min (by norm_num) (div_pos hepsilon (by positivity))
  have hdleone : d ≤ 1 := min_le_left _ _
  have hdlequot : d ≤ epsilon / (4 * M ^ 2) := min_le_right _ _
  choose U hUdiff hUclose hUsupp using fun i : ι =>
    (hHcont i).exists_contDiff_approx (⊤ : ℕ∞) continuous_const (fun _ => hdpos)
  choose V hVdiff hVclose hVsupp using fun i : ι =>
    (hKcont i).exists_contDiff_approx (⊤ : ℕ∞) continuous_const (fun _ => hdpos)
  refine ⟨U, V, ?_, ?_, ?_⟩
  · intro i
    exact ⟨hUdiff i, (hHcompact i).mono (hUsupp i), hUsupp i⟩
  · intro i
    exact ⟨hVdiff i, (hKcompact i).mono (hVsupp i), hVsupp i⟩
  intro p
  have hper (i : ι) :
      ‖U i p.1 * V i p.2 - H i p.1 * K i p.2‖ ≤ 3 * M * d := by
    have hUerr : ‖U i p.1 - H i p.1‖ < d := by
      simpa only [dist_eq_norm] using hUclose i p.1
    have hVerr : ‖V i p.2 - K i p.2‖ < d := by
      simpa only [dist_eq_norm] using hVclose i p.2
    have hVbound : ‖V i p.2‖ ≤ M + d := by
      calc
        ‖V i p.2‖ = ‖K i p.2 + (V i p.2 - K i p.2)‖ := by
          congr 1
          ring
        _ ≤ ‖K i p.2‖ + ‖V i p.2 - K i p.2‖ := norm_add_le _ _
        _ ≤ M + d := add_le_add (hKbound i p.2) hVerr.le
    calc
      ‖U i p.1 * V i p.2 - H i p.1 * K i p.2‖ =
          ‖(U i p.1 - H i p.1) * V i p.2 +
            H i p.1 * (V i p.2 - K i p.2)‖ := by
        congr 1
        ring
      _ ≤ ‖(U i p.1 - H i p.1) * V i p.2‖ +
          ‖H i p.1 * (V i p.2 - K i p.2)‖ := norm_add_le _ _
      _ = ‖U i p.1 - H i p.1‖ * ‖V i p.2‖ +
          ‖H i p.1‖ * ‖V i p.2 - K i p.2‖ := by
        rw [norm_mul, norm_mul]
      _ ≤ d * (M + d) + M * d := by
        gcongr
        exact hHbound i p.1
      _ ≤ 3 * M * d := by
        have hdnonneg : 0 ≤ d := hdpos.le
        nlinarith
  rw [dist_eq_norm, ← Finset.sum_sub_distrib]
  calc
    ‖∑ i : ι, (U i p.1 * V i p.2 - H i p.1 * K i p.2)‖ ≤
        ∑ i : ι, ‖U i p.1 * V i p.2 - H i p.1 * K i p.2‖ :=
      norm_sum_le _ _
    _ ≤ ∑ i : ι, 3 * M * d := Finset.sum_le_sum fun i hi => hper i
    _ = (Fintype.card ι : Real) * (3 * M * d) := by simp
    _ ≤ M * (3 * M * d) := by
      gcongr
    _ = 3 * M ^ 2 * d := by ring
    _ < epsilon := by
      have hmul : d * (4 * M ^ 2) ≤ epsilon :=
        (le_div_iff₀ (by positivity : 0 < 4 * M ^ 2)).mp hdlequot
      nlinarith

/-- The boundedness hypotheses in
`exists_finite_smooth_separated_uniform_close_of_bounded` are automatic for
a finite family of continuous compactly supported factors. -/
theorem exists_finite_smooth_separated_uniform_close
    (E F ι : Type*) [NormedAddCommGroup E] [NormedSpace Real E]
    [NormedAddCommGroup F] [NormedSpace Real F]
    [FiniteDimensional Real E] [FiniteDimensional Real F] [Fintype ι]
    (H : ι → E → Real) (K : ι → F → Real)
    (hHcont : ∀ i, Continuous (H i)) (hKcont : ∀ i, Continuous (K i))
    (hHcompact : ∀ i, HasCompactSupport (H i))
    (hKcompact : ∀ i, HasCompactSupport (K i))
    {epsilon : Real} (hepsilon : 0 < epsilon) :
    ∃ (U : ι → E → Real) (V : ι → F → Real),
      (∀ i, ContDiff Real (↑(⊤ : ℕ∞)) (U i) ∧
        HasCompactSupport (U i) ∧ Function.support (U i) ⊆ Function.support (H i)) ∧
      (∀ i, ContDiff Real (↑(⊤ : ℕ∞)) (V i) ∧
        HasCompactSupport (V i) ∧ Function.support (V i) ⊆ Function.support (K i)) ∧
      ∀ p : E × F,
        dist (∑ i : ι, U i p.1 * V i p.2)
          (∑ i : ι, H i p.1 * K i p.2) < epsilon := by
  choose BH hBH using fun i : ι =>
    (hHcont i).bounded_above_of_compact_support (hHcompact i)
  choose BK hBK using fun i : ι =>
    (hKcont i).bounded_above_of_compact_support (hKcompact i)
  let M : Real := 1 + (Fintype.card ι : Real) +
    (∑ i : ι, |BH i|) + ∑ i : ι, |BK i|
  have hcardnonneg : 0 ≤ (Fintype.card ι : Real) := by positivity
  have hsumBHnonneg : 0 ≤ ∑ i : ι, |BH i| :=
    Finset.sum_nonneg fun i hi => abs_nonneg (BH i)
  have hsumBKnonneg : 0 ≤ ∑ i : ι, |BK i| :=
    Finset.sum_nonneg fun i hi => abs_nonneg (BK i)
  have hM : 1 ≤ M := by
    dsimp only [M]
    nlinarith
  have hcard : (Fintype.card ι : Real) ≤ M := by
    dsimp only [M]
    nlinarith
  have hHbound (i : ι) (x : E) : ‖H i x‖ ≤ M := by
    calc
      ‖H i x‖ ≤ BH i := hBH i x
      _ ≤ |BH i| := le_abs_self _
      _ ≤ ∑ j : ι, |BH j| := by
        exact Finset.single_le_sum (fun j hj => abs_nonneg (BH j)) (Finset.mem_univ i)
      _ ≤ M := by
        dsimp only [M]
        nlinarith
  have hKbound (i : ι) (y : F) : ‖K i y‖ ≤ M := by
    calc
      ‖K i y‖ ≤ BK i := hBK i y
      _ ≤ |BK i| := le_abs_self _
      _ ≤ ∑ j : ι, |BK j| := by
        exact Finset.single_le_sum (fun j hj => abs_nonneg (BK j)) (Finset.mem_univ i)
      _ ≤ M := by
        dsimp only [M]
        nlinarith
  exact exists_finite_smooth_separated_uniform_close_of_bounded E F ι H K
    hHcont hKcont hHcompact hKcompact M hM hcard hHbound hKbound hepsilon

/-- Smooth compact tensor density on a product of finite-dimensional real
spaces.  This is the source-ready tensor bridge: first use the preceding
compact-product Stone--Weierstrass result, then smooth the finitely many
factors with a quantitatively allocated error. -/
theorem exists_finite_smooth_compact_separated_uniform_close
    (E F : Type*) [NormedAddCommGroup E] [NormedSpace Real E]
    [NormedAddCommGroup F] [NormedSpace Real F]
    [FiniteDimensional Real E] [FiniteDimensional Real F]
    [HasContDiffBump E] [HasContDiffBump F]
    (cE : E) (cF : F) {rE RE rF RF epsilon : Real}
    (hrE : 0 < rE) (hrERE : rE < RE)
    (hrF : 0 < rF) (hrFRF : rF < RF)
    (f : E × F → Real) (hfcont : Continuous f)
    (hfsupp : Function.support f ⊆
      Metric.closedBall cE rE ×ˢ Metric.closedBall cF rF)
    (hepsilon : 0 < epsilon) :
    ∃ (ι : Type) (_ : Fintype ι) (U : ι → E → Real) (V : ι → F → Real),
      (∀ i, ContDiff Real (↑(⊤ : ℕ∞)) (U i) ∧
        HasCompactSupport (U i) ∧
        Function.support (U i) ⊆ Metric.closedBall cE RE) ∧
      (∀ i, ContDiff Real (↑(⊤ : ℕ∞)) (V i) ∧
        HasCompactSupport (V i) ∧
        Function.support (V i) ⊆ Metric.closedBall cF RF) ∧
      ∀ p : E × F, dist (∑ i : ι, U i p.1 * V i p.2) (f p) < epsilon := by
  have heps2 : 0 < epsilon / 2 := by linarith
  obtain ⟨ι, hι, H, K, hH, hK, hHK⟩ :=
    exists_finite_continuous_compact_separated_uniform_close E F cE cF
      hrE hrERE hrF hrFRF f hfcont hfsupp heps2
  letI : Fintype ι := hι
  obtain ⟨U, V, hU, hV, hUV⟩ :=
    exists_finite_smooth_separated_uniform_close E F ι H K
      (fun i => (hH i).1) (fun i => (hK i).1)
      (fun i => (hH i).2.1) (fun i => (hK i).2.1) heps2
  refine ⟨ι, inferInstance, U, V, ?_, ?_, ?_⟩
  · intro i
    exact ⟨(hU i).1, (hU i).2.1, (hU i).2.2.trans (hH i).2.2⟩
  · intro i
    exact ⟨(hV i).1, (hV i).2.1, (hV i).2.2.trans (hK i).2.2⟩
  · intro p
    calc
      dist (∑ i : ι, U i p.1 * V i p.2) (f p) ≤
          dist (∑ i : ι, U i p.1 * V i p.2)
            (∑ i : ι, H i p.1 * K i p.2) +
          dist (∑ i : ι, H i p.1 * K i p.2) (f p) :=
        dist_triangle _ _ _
      _ < epsilon := by linarith [hUV p, hHK p]

/-- The elementary uniform-to-`L²` conversion used by the slab tensor
density argument.  It is deliberately stated for an arbitrary finite-measure
support set, so the tensor construction and the measure estimate stay
decoupled. -/
theorem eLpNorm_two_sub_le_of_support_subset_and_uniform
    {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (S : Set X) (hSmeas : MeasurableSet S) (hSfinite : μ S ≠ (⊤ : ENNReal))
    (f g : X → Real)
    (hfsupp : Function.support f ⊆ S)
    (hgsupp : Function.support g ⊆ S)
    {epsilon : Real} (huniform : ∀ x, dist (g x) (f x) ≤ epsilon) :
    eLpNorm (g - f) 2 μ ≤
      (μ S) ^ ((2 : ENNReal).toReal)⁻¹ * ENNReal.ofReal epsilon := by
  have hsubsupp : Function.support (g - f) ⊆ S := by
    intro x hx
    by_contra hxS
    have hfzero : f x = 0 := eq_zero_of_support_subset f hfsupp hxS
    have hgzero : g x = 0 := eq_zero_of_support_subset g hgsupp hxS
    exact hx (by simp [hfzero, hgzero])
  letI : IsFiniteMeasure (μ.restrict S) := isFiniteMeasure_restrict.2 hSfinite
  rw [← eLpNorm_restrict_eq_of_support_subset hsubsupp]
  have hbound : ∀ᵐ x ∂μ.restrict S, ‖(g - f) x‖ ≤ epsilon := by
    filter_upwards [ae_restrict_mem hSmeas] with x hx
    simpa only [Pi.sub_apply, dist_eq_norm] using huniform x
  simpa only [Measure.restrict_apply_univ, Set.univ_inter] using
    (eLpNorm_le_of_ae_bound (μ := μ.restrict S) (p := (2 : ENNReal)) hbound)

/-- Complex-valued version of the compact separated smooth tensor theorem.
It is obtained by applying the real theorem to real and imaginary parts and
combining the two finite systems by `Sum`. -/
theorem exists_finite_smooth_compact_separated_uniform_close_complex
    (E F : Type*) [NormedAddCommGroup E] [NormedSpace Real E]
    [NormedAddCommGroup F] [NormedSpace Real F]
    [FiniteDimensional Real E] [FiniteDimensional Real F]
    [HasContDiffBump E] [HasContDiffBump F]
    (cE : E) (cF : F) {rE RE rF RF epsilon : Real}
    (hrE : 0 < rE) (hrERE : rE < RE)
    (hrF : 0 < rF) (hrFRF : rF < RF)
    (f : E × F -> Complex) (hfcont : Continuous f)
    (hfsupp : Function.support f ⊆
      Metric.closedBall cE rE ×ˢ Metric.closedBall cF rF)
    (hepsilon : 0 < epsilon) :
    ∃ (ι : Type) (_ : Fintype ι) (U : ι → E → Complex) (V : ι → F → Complex),
      (∀ i, ContDiff Real (↑(⊤ : ℕ∞)) (U i) ∧
        HasCompactSupport (U i) ∧
        Function.support (U i) ⊆ Metric.closedBall cE RE) ∧
      (∀ i, ContDiff Real (↑(⊤ : ℕ∞)) (V i) ∧
        HasCompactSupport (V i) ∧
        Function.support (V i) ⊆ Metric.closedBall cF RF) ∧
      ∀ p : E × F, dist (∑ i : ι, U i p.1 * V i p.2) (f p) < epsilon := by
  have hepshalf : 0 < epsilon / 2 := by positivity
  have hresupp : Function.support (fun p => (f p).re) ⊆
      Metric.closedBall cE rE ×ˢ Metric.closedBall cF rF := by
    intro p hp
    apply hfsupp
    rw [Function.mem_support] at hp ⊢
    intro hzero
    apply hp
    simp [hzero]
  have himsupp : Function.support (fun p => (f p).im) ⊆
      Metric.closedBall cE rE ×ˢ Metric.closedBall cF rF := by
    intro p hp
    apply hfsupp
    rw [Function.mem_support] at hp ⊢
    intro hzero
    apply hp
    simp [hzero]
  obtain ⟨ιr, hιr, Ur, Vr, hUr, hVr, hcloseR⟩ :=
    exists_finite_smooth_compact_separated_uniform_close E F cE cF
      hrE hrERE hrF hrFRF (fun p => (f p).re) (Complex.continuous_re.comp hfcont) hresupp hepshalf
  obtain ⟨ιi, hιi, Ui, Vi, hUi, hVi, hcloseI⟩ :=
    exists_finite_smooth_compact_separated_uniform_close E F cE cF
      hrE hrERE hrF hrFRF (fun p => (f p).im) (Complex.continuous_im.comp hfcont) himsupp hepshalf
  letI : Fintype ιr := hιr
  letI : Fintype ιi := hιi
  let U : Sum ιr ιi → E → Complex := Sum.elim
    (fun i x => (Ur i x : Complex)) (fun i x => (Ui i x : Complex))
  let V : Sum ιr ιi → F → Complex := Sum.elim
    (fun i x => (Vr i x : Complex)) (fun i x => Complex.I * (Vi i x : Complex))
  refine ⟨Sum ιr ιi, inferInstance, U, V, ?_, ?_, ?_⟩
  · intro i
    cases i with
    | inl i =>
      refine ⟨?_, ?_, ?_⟩
      · change ContDiff Real (↑(⊤ : ℕ∞)) (fun x => (Ur i x : Complex))
        have hcoe : (fun x => (Ur i x : Complex)) = Complex.ofRealCLM ∘ Ur i := by
          funext x
          simp
        rw [hcoe]
        exact Complex.ofRealCLM.contDiff.comp (hUr i).1
      · change HasCompactSupport (fun x => (Ur i x : Complex))
        apply (hUr i).2.1.mono
        intro x hx
        rw [Function.mem_support] at hx ⊢
        intro hzero
        apply hx
        simp [hzero]
      · change Function.support (fun x => (Ur i x : Complex)) ⊆ Metric.closedBall cE RE
        intro x hx
        apply (hUr i).2.2
        rw [Function.mem_support] at hx ⊢
        intro hzero
        apply hx
        simp [U, hzero]
    | inr i =>
      refine ⟨?_, ?_, ?_⟩
      · change ContDiff Real (↑(⊤ : ℕ∞)) (fun x => (Ui i x : Complex))
        have hcoe : (fun x => (Ui i x : Complex)) = Complex.ofRealCLM ∘ Ui i := by
          funext x
          simp
        rw [hcoe]
        exact Complex.ofRealCLM.contDiff.comp (hUi i).1
      · change HasCompactSupport (fun x => (Ui i x : Complex))
        apply (hUi i).2.1.mono
        intro x hx
        rw [Function.mem_support] at hx ⊢
        intro hzero
        apply hx
        simp [hzero]
      · change Function.support (fun x => (Ui i x : Complex)) ⊆ Metric.closedBall cE RE
        intro x hx
        apply (hUi i).2.2
        rw [Function.mem_support] at hx ⊢
        intro hzero
        apply hx
        simp [U, hzero]
  · intro i
    cases i with
    | inl i =>
      refine ⟨?_, ?_, ?_⟩
      · change ContDiff Real (↑(⊤ : ℕ∞)) (fun x => (Vr i x : Complex))
        have hcoe : (fun x => (Vr i x : Complex)) = Complex.ofRealCLM ∘ Vr i := by
          funext x
          simp
        rw [hcoe]
        exact Complex.ofRealCLM.contDiff.comp (hVr i).1
      · change HasCompactSupport (fun x => (Vr i x : Complex))
        apply (hVr i).2.1.mono
        intro x hx
        rw [Function.mem_support] at hx ⊢
        intro hzero
        apply hx
        simp [hzero]
      · change Function.support (fun x => (Vr i x : Complex)) ⊆ Metric.closedBall cF RF
        intro x hx
        apply (hVr i).2.2
        rw [Function.mem_support] at hx ⊢
        intro hzero
        apply hx
        simp [V, hzero]
    | inr i =>
      refine ⟨?_, ?_, ?_⟩
      · change ContDiff Real (↑(⊤ : ℕ∞)) (fun x => Complex.I * (Vi i x : Complex))
        have hconst : ContDiff Real (↑(⊤ : ℕ∞))
            (fun _ : F => (Complex.I : Complex)) := contDiff_const
        have hbase : ContDiff Real (↑(⊤ : ℕ∞))
            (Complex.ofRealCLM ∘ Vi i) :=
          Complex.ofRealCLM.contDiff.comp (hVi i).1
        have hcont : ContDiff Real (↑(⊤ : ℕ∞))
            ((fun _ : F => (Complex.I : Complex)) * (Complex.ofRealCLM ∘ Vi i)) :=
          hconst.mul hbase
        convert hcont using 1
        funext x
        simp [Pi.mul_apply]
      · change HasCompactSupport (fun x => Complex.I * (Vi i x : Complex))
        apply (hVi i).2.1.mono
        intro x hx
        rw [Function.mem_support] at hx ⊢
        intro hzero
        apply hx
        simp [hzero]
      · change Function.support (fun x => Complex.I * (Vi i x : Complex)) ⊆ Metric.closedBall cF RF
        intro x hx
        apply (hVi i).2.2
        rw [Function.mem_support] at hx ⊢
        intro hzero
        apply hx
        simp [V, hzero]
  · intro p
    let AR : Real := ∑ i : ιr, Ur i p.1 * Vr i p.2
    let AI : Real := ∑ i : ιi, Ui i p.1 * Vi i p.2
    have hsum : ∑ i : Sum ιr ιi, U i p.1 * V i p.2 =
        (AR : Complex) + Complex.I * (AI : Complex) := by
      rw [Fintype.sum_sum_type]
      change (∑ i : ιr, (Ur i p.1 : Complex) * (Vr i p.2 : Complex)) +
          ∑ i : ιi, (Ui i p.1 : Complex) * (Complex.I * (Vi i p.2 : Complex)) =
        (AR : Complex) + Complex.I * (AI : Complex)
      have hsumR : ∑ i : ιr, (Ur i p.1 : Complex) * (Vr i p.2 : Complex) =
          (AR : Complex) := by
        dsimp only [AR]
        norm_cast
      have hsumI : ∑ i : ιi, (Ui i p.1 : Complex) * (Complex.I * (Vi i p.2 : Complex)) =
          Complex.I * (AI : Complex) := by
        calc
          ∑ i : ιi, (Ui i p.1 : Complex) * (Complex.I * (Vi i p.2 : Complex)) =
              Complex.I * ∑ i : ιi, (Ui i p.1 : Complex) * (Vi i p.2 : Complex) := by
                rw [Finset.mul_sum]
                apply Finset.sum_congr rfl
                intro i hi
                ring
          _ = Complex.I * (AI : Complex) := by
                congr 1
                dsimp only [AI]
                norm_cast
      rw [hsumR, hsumI]
    have hR : |AR - (f p).re| < epsilon / 2 := by
      simpa only [AR, Real.dist_eq] using hcloseR p
    have hI : |AI - (f p).im| < epsilon / 2 := by
      simpa only [AI, Real.dist_eq] using hcloseI p
    rw [hsum, dist_eq_norm]
    have hf : ((f p).re : Complex) + Complex.I * ((f p).im : Complex) = f p := by
      apply Complex.ext <;> simp
    rw [← hf]
    have hdiff : (AR : Complex) + Complex.I * (AI : Complex) -
        (((f p).re : Complex) + Complex.I * ((f p).im : Complex)) =
        ((AR - (f p).re : Real) : Complex) +
          Complex.I * ((AI - (f p).im : Real) : Complex) := by
      push_cast
      ring
    rw [hdiff]
    calc
      ‖((AR - (f p).re : Real) : Complex) +
          Complex.I * ((AI - (f p).im : Real) : Complex)‖ ≤
          ‖((AR - (f p).re : Real) : Complex)‖ +
            ‖Complex.I * ((AI - (f p).im : Real) : Complex)‖ := norm_add_le _ _
      _ = |AR - (f p).re| + |AI - (f p).im| := by
        rw [Complex.norm_real, Real.norm_eq_abs, norm_mul, Complex.norm_I,
          Complex.norm_real, Real.norm_eq_abs, one_mul]
      _ < epsilon := by linarith

end Auto.Spherical.MSS
