/-- At width `rho`, the positive real tube kernel is exactly the real part
of the inverse Fourier transform of the compact canonical multiplier. -/
theorem scratch_smoothTubeCore_eq_re_canonicalBandlimitedTubePhysicalCore
    {rho : Real} (hrho : 0 < rho)
    (omega y : Euclidean 2) (z : WaveSpaceTime) :
    scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
        rho omega y z =
      (scratch_canonicalBandlimitedTubePhysicalCore rho hrho
        (z.1 + z.2 • omega - y)).re := by
  unfold scratch_smoothTubeCore
  symm
  exact scratch_canonicalBandlimitedTubePhysicalCore_re_eq hrho _

/-- The positive canonical tube average of a real-valued input is the real
part of the corresponding compact-frequency signed tube field.  The measure
is left generic so this applies both to the literal slab integral and to any
finite-tensor localization. -/
theorem integral_smoothTubeCore_eq_re_integral_canonicalBandlimitedTube
    {rho : Real} (hrho : 0 < rho)
    (omega y : Euclidean 2) {μ : Measure WaveSpaceTime}
    (G : WaveSpaceTime → Real)
    (hG : Integrable (fun z =>
      scratch_canonicalBandlimitedTubePhysicalCore rho hrho
        (z.1 + z.2 • omega - y) * (G z : Complex)) μ) :
    (∫ z, scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
      rho omega y z * G z ∂μ) =
      (∫ z, scratch_canonicalBandlimitedTubePhysicalCore rho hrho
        (z.1 + z.2 • omega - y) * (G z : Complex) ∂μ).re := by
  calc
    (∫ z, scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
      rho omega y z * G z ∂μ) =
        ∫ z, (scratch_canonicalBandlimitedTubePhysicalCore rho hrho
          (z.1 + z.2 • omega - y) * (G z : Complex)).re ∂μ := by
          apply integral_congr_ae
          filter_upwards with z
          rw [Complex.mul_re]
          simp only [Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero]
          rw [← scratch_smoothTubeCore_eq_re_canonicalBandlimitedTubePhysicalCore
            hrho omega y z]
    _ = (∫ z, scratch_canonicalBandlimitedTubePhysicalCore rho hrho
      (z.1 + z.2 • omega - y) * (G z : Complex) ∂μ).re :=
        integral_re hG

/-- Hence the literal positive canonical tube average is bounded by the
norm of its signed compact-frequency tube field.  Crucially this uses only
the real-part identity, not a false assertion that the complex kernel itself
is real-valued. -/
theorem integral_smoothTubeCore_le_norm_integral_canonicalBandlimitedTube
    {rho : Real} (hrho : 0 < rho)
    (omega y : Euclidean 2) {μ : Measure WaveSpaceTime}
    (G : WaveSpaceTime → Real)
    (hG : Integrable (fun z =>
      scratch_canonicalBandlimitedTubePhysicalCore rho hrho
        (z.1 + z.2 • omega - y) * (G z : Complex)) μ) :
    (∫ z, scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
      rho omega y z * G z ∂μ) ≤
      ‖∫ z, scratch_canonicalBandlimitedTubePhysicalCore rho hrho
        (z.1 + z.2 • omega - y) * (G z : Complex) ∂μ‖ := by
  rw [integral_smoothTubeCore_eq_re_integral_canonicalBandlimitedTube
    hrho omega y G hG]
  exact Complex.re_le_norm _

end

