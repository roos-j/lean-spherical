theorem exists_innerSlab_smoothCompact_eLpNorm_sub_lt_with_radius
    (h : WaveSpaceTime → Complex) (hh : MemLp h 2 volume)
    (hzero : ∀ z : WaveSpaceTime, z ∈ outsideTimeSlab → h z = 0)
    {ε : Real} (hε : 0 < ε) :
    ∃ r : Real, 0 < r ∧ r < 1 ∧ ∃ u : WaveSpaceTime → Complex,
      HasCompactSupport u ∧ ContDiff Real ∞ u ∧
      Function.support u ⊆ {z : WaveSpaceTime | z.2 ∈ Metric.closedBall slabCenter r} ∧
      eLpNorm (h - u) 2 volume < ENNReal.ofReal ε := by
  have hquarter : 0 < ε / 4 := by positivity
  obtain ⟨v, hvcompact, hvsmooth, hvapprox⟩ :=
    hh.exist_eLpNorm_sub_le (by norm_num) (by norm_num) hquarter
  have hvMem : MemLp v 2 volume := hvsmooth.continuous.memLp_of_hasCompactSupport hvcompact
  obtain ⟨R, hR⟩ := exists_spatial_closedBall_support v hvcompact
  let B : Set (Euclidean 2) := Metric.closedBall 0 R
  have hB : MeasurableSet B := measurableSet_closedBall
  have hBfinite : volume B ≠ (⊤ : ENNReal) := measure_closedBall_lt_top.ne
  obtain ⟨η, hη, hηhalf, hboundary⟩ :=
    exists_slabBoundary_eLpNorm_small B hB hBfinite v hvMem hquarter
  let u := applyInnerSlabCutoff (1 - η) (1 - η / 2)
    (innerRadius_pos hη hηhalf) (innerRadius_lt_outerRadius hη) v
  have husmooth : ContDiff Real ∞ u :=
    contDiff_applyInnerSlabCutoff (1 - η) (1 - η / 2)
      (innerRadius_pos hη hηhalf) (innerRadius_lt_outerRadius hη) v hvsmooth
  have hucompact : HasCompactSupport u :=
    hasCompactSupport_applyInnerSlabCutoff (1 - η) (1 - η / 2)
      (innerRadius_pos hη hηhalf) (innerRadius_lt_outerRadius hη) v hvcompact
  have husupport : Function.support u ⊆
      {z : WaveSpaceTime | z.2 ∈ Metric.closedBall slabCenter (1 - η / 2)} :=
    support_applyInnerSlabCutoff_subset_timeClosedBall (1 - η) (1 - η / 2)
      (innerRadius_pos hη hηhalf) (innerRadius_lt_outerRadius hη)
      v
  refine ⟨1 - η / 2, outerRadius_pos hηhalf, outerRadius_lt_one hη,
    u, hucompact, husmooth, husupport, ?_⟩
  have hvusub : eLpNorm (v - u) 2 volume ≤
      eLpNorm (outsideTimeSlab.indicator v) 2 volume +
        eLpNorm ((slabBoundary B η).indicator v) 2 volume := by
    simpa only [u] using eLpNorm_sub_applyInnerSlabCutoff_le B hB v hR
      hvMem.aestronglyMeasurable hη hηhalf
  have houtside : eLpNorm (outsideTimeSlab.indicator v) 2 volume ≤
      eLpNorm (h - v) 2 volume :=
    eLpNorm_outsideTimeSlab_indicator_le_sub h v hzero
  have houtsideapprox : eLpNorm (outsideTimeSlab.indicator v) 2 volume ≤
      ENNReal.ofReal (ε / 4) := houtside.trans hvapprox
  have hsum : eLpNorm (h - u) 2 volume ≤
      eLpNorm (h - v) 2 volume + eLpNorm (v - u) 2 volume := by
    have heq : h - u = (h - v) + (v - u) := by
      ext z
      simp only [Pi.sub_apply, Pi.add_apply]
      ring
    rw [heq]
    exact eLpNorm_add_le (hh.aestronglyMeasurable.sub hvMem.aestronglyMeasurable)
      (hvMem.aestronglyMeasurable.sub husmooth.continuous.aestronglyMeasurable) (by norm_num)
  have hquarter_nonneg : 0 ≤ ε / 4 := hquarter.le
  calc
    eLpNorm (h - u) 2 volume ≤ eLpNorm (h - v) 2 volume + eLpNorm (v - u) 2 volume := hsum
    _ ≤ eLpNorm (h - v) 2 volume +
        (eLpNorm (outsideTimeSlab.indicator v) 2 volume +
          eLpNorm ((slabBoundary B η).indicator v) 2 volume) :=
      add_le_add_right hvusub _
    _ ≤ eLpNorm (h - v) 2 volume +
        (eLpNorm (h - v) 2 volume +
          eLpNorm ((slabBoundary B η).indicator v) 2 volume) :=
      add_le_add_right
        (add_le_add_left houtside (eLpNorm ((slabBoundary B η).indicator v) 2 volume))
        (eLpNorm (h - v) 2 volume)
    _ ≤ ENNReal.ofReal (ε / 4) +
        (ENNReal.ofReal (ε / 4) + ENNReal.ofReal (ε / 4)) := by
      exact add_le_add hvapprox (add_le_add hvapprox hboundary)
    _ = ENNReal.ofReal (3 * ε / 4) := by
      rw [← ENNReal.ofReal_add hquarter_nonneg hquarter_nonneg]
      rw [← ENNReal.ofReal_add hquarter_nonneg
        (by linarith : 0 ≤ ε / 4 + ε / 4)]
      congr 1
      ring
    _ < ENNReal.ofReal ε := by
      exact (ENNReal.ofReal_lt_ofReal_iff hε).mpr (by linarith)

