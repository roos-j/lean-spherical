section

section Auto.Spherical.MSS

open Filter MeasureTheory FourierTransform Set
open Auto.Spherical.SurfaceMeasureDecay
open scoped BigOperators Convolution FourierTransform EuclideanSpace Pointwise

noncomputable section

/-- The dimension-two normalized physical core at dyadic width `2^j / r`.
Its Fourier transform remains compactly supported after the corresponding
frequency dilation. -/
noncomputable def canonicalBandlimitedDyadicScale (r : Real) (j : Nat) : Real :=
  (r / 2) * ((2 : Real) ^ j)⁻¹

noncomputable def canonicalBandlimitedDyadicCore
    (r : Real) (j : Nat) (u : Euclidean 2) : Real :=
  (canonicalBandlimitedDyadicScale r j) ^ 2 *
    (canonicalPositiveCore (canonicalBandlimitedDyadicScale r j • u)).re

theorem canonicalBandlimitedDyadicScale_pos {r : Real} (hr : 0 < r) (j : Nat) :
    0 < canonicalBandlimitedDyadicScale r j := by
  unfold canonicalBandlimitedDyadicScale
  positivity

theorem canonicalBandlimitedDyadicCore_nonneg
    (r : Real) (j : Nat) (u : Euclidean 2) :
    0 ≤ canonicalBandlimitedDyadicCore r j u := by
  unfold canonicalBandlimitedDyadicCore
  exact mul_nonneg (sq_nonneg _) (canonicalPositiveCore_re_nonneg _)

theorem canonicalPositiveCore_re_le_uniformBound (x : Euclidean 2) :
    (canonicalPositiveCore x).re ≤
      (SchwartzMap.seminorm Complex 0 0) canonicalPositiveCore := by
  calc
    (canonicalPositiveCore x).re ≤ |(canonicalPositiveCore x).re| := le_abs_self _
    _ ≤ ‖canonicalPositiveCore x‖ := Complex.abs_re_le_norm _
    _ ≤ (SchwartzMap.seminorm Complex 0 0) canonicalPositiveCore :=
      SchwartzMap.norm_le_seminorm Complex canonicalPositiveCore x

theorem canonicalPositiveCore_uniformBound_nonneg :
    0 ≤ (SchwartzMap.seminorm Complex 0 0) canonicalPositiveCore := by
  exact le_trans (norm_nonneg (canonicalPositiveCore (0 : Euclidean 2)))
    (SchwartzMap.norm_le_seminorm Complex canonicalPositiveCore 0)

theorem canonicalBandlimitedDyadicScale_le_half_radius
    {r : Real} (hr : 0 < r) (j : Nat) :
    canonicalBandlimitedDyadicScale r j ≤ r / 2 := by
  unfold canonicalBandlimitedDyadicScale
  have hpow : 1 ≤ (2 : Real) ^ j := one_le_pow₀ (by norm_num)
  have hinv : ((2 : Real) ^ j)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hpow
  have hhalf : 0 ≤ r / 2 := (half_pos hr).le
  calc
    r / 2 * ((2 : Real) ^ j)⁻¹ ≤ r / 2 * 1 :=
      mul_le_mul_of_nonneg_left hinv hhalf
    _ = r / 2 := mul_one _

theorem canonicalBandlimitedDyadicCore_le_uniformBound
    {r : Real} (hr : 0 < r) (j : Nat) (u : Euclidean 2) :
    canonicalBandlimitedDyadicCore r j u ≤
      (r / 2) ^ 2 * (SchwartzMap.seminorm Complex 0 0) canonicalPositiveCore := by
  have hsnonneg : 0 ≤ canonicalBandlimitedDyadicScale r j :=
    (canonicalBandlimitedDyadicScale_pos hr j).le
  have hscale : canonicalBandlimitedDyadicScale r j ≤ r / 2 :=
    canonicalBandlimitedDyadicScale_le_half_radius hr j
  have hsquare : (canonicalBandlimitedDyadicScale r j) ^ 2 ≤ (r / 2) ^ 2 :=
    (sq_le_sq₀ hsnonneg (half_pos hr).le).mpr hscale
  have hbound := canonicalPositiveCore_re_le_uniformBound
    (canonicalBandlimitedDyadicScale r j • u)
  have hfirst :
      (canonicalBandlimitedDyadicScale r j) ^ 2 *
          (canonicalPositiveCore (canonicalBandlimitedDyadicScale r j • u)).re ≤
        (canonicalBandlimitedDyadicScale r j) ^ 2 *
          (SchwartzMap.seminorm Complex 0 0) canonicalPositiveCore :=
    mul_le_mul_of_nonneg_left hbound (sq_nonneg _)
  unfold canonicalBandlimitedDyadicCore
  calc
    (canonicalBandlimitedDyadicScale r j) ^ 2 *
        (canonicalPositiveCore (canonicalBandlimitedDyadicScale r j • u)).re ≤
      (canonicalBandlimitedDyadicScale r j) ^ 2 *
        (SchwartzMap.seminorm Complex 0 0) canonicalPositiveCore := hfirst
    _ ≤ (r / 2) ^ 2 *
        (SchwartzMap.seminorm Complex 0 0) canonicalPositiveCore :=
      mul_le_mul_of_nonneg_right hsquare canonicalPositiveCore_uniformBound_nonneg

theorem norm_smul_canonicalBandlimitedDyadicScale_le
    {r : Real} (hr : 0 < r) (j : Nat) (u : Euclidean 2)
    (hu : ‖u‖ ≤ 2 * (2 : Real) ^ j) :
    ‖canonicalBandlimitedDyadicScale r j • u‖ ≤ r := by
  have hs : 0 < canonicalBandlimitedDyadicScale r j :=
    canonicalBandlimitedDyadicScale_pos hr j
  calc
    ‖canonicalBandlimitedDyadicScale r j • u‖ =
        |canonicalBandlimitedDyadicScale r j| * ‖u‖ := norm_smul _ _
    _ = canonicalBandlimitedDyadicScale r j * ‖u‖ := by
      rw [abs_of_pos hs]
    _ ≤ canonicalBandlimitedDyadicScale r j * (2 * (2 : Real) ^ j) :=
      mul_le_mul_of_nonneg_left hu hs.le
    _ = r := by
      unfold canonicalBandlimitedDyadicScale
      field_simp

theorem canonicalBandlimitedDyadicCore_lower_of_norm_le
    {c r : Real} (hr : 0 < r)
    (hcore : ∀ x : Euclidean 2, ‖x‖ ≤ r → c ≤ (canonicalPositiveCore x).re)
    (j : Nat) (u : Euclidean 2)
    (hu : ‖u‖ ≤ 2 * (2 : Real) ^ j) :
    (canonicalBandlimitedDyadicScale r j) ^ 2 * c ≤
      canonicalBandlimitedDyadicCore r j u := by
  unfold canonicalBandlimitedDyadicCore
  apply mul_le_mul_of_nonneg_left
  · apply hcore
    exact norm_smul_canonicalBandlimitedDyadicScale_le hr j u hu
  · exact sq_nonneg _

/-- Coefficients which turn the normalized two-dimensional cores into a
summable dyadic majorant of polynomial spatial decay. -/
noncomputable def canonicalBandlimitedDyadicCoefficient
    (N : Nat) (c r : Real) (j : Nat) : Real :=
  (((2 : Real) ^ N) / c) * (2 / r) ^ 2 *
    (((2 : Real) ^ j)⁻¹) ^ (N - 2)

theorem canonicalBandlimited_coefficient_scale_sq_mul
    (N : Nat) (hN : 2 ≤ N) {c r : Real} (hc : 0 < c) (hr : 0 < r) (j : Nat) :
    canonicalBandlimitedDyadicCoefficient N c r j *
        (canonicalBandlimitedDyadicScale r j) ^ 2 * c =
      (2 : Real) ^ N * (((2 : Real) ^ j)⁻¹) ^ N := by
  let p : Real := ((2 : Real) ^ j)⁻¹
  have hp : p ^ (N - 2) * p ^ 2 = p ^ N := by
    rw [← pow_add, Nat.sub_add_cancel hN]
  calc
    canonicalBandlimitedDyadicCoefficient N c r j *
          (canonicalBandlimitedDyadicScale r j) ^ 2 * c =
        (2 : Real) ^ N * (p ^ (N - 2) * p ^ 2) := by
      unfold canonicalBandlimitedDyadicCoefficient canonicalBandlimitedDyadicScale
      dsimp only [p]
      field_simp [hc.ne', hr.ne']
    _ = (2 : Real) ^ N * p ^ N := by rw [hp]
    _ = (2 : Real) ^ N * (((2 : Real) ^ j)⁻¹) ^ N := by rfl

theorem canonicalBandlimitedDyadicCore_nonneg_coefficient
    (N : Nat) {c r : Real} (hc : 0 < c) (hr : 0 < r) (j : Nat) (u : Euclidean 2) :
    0 ≤ canonicalBandlimitedDyadicCoefficient N c r j *
      canonicalBandlimitedDyadicCore r j u := by
  apply mul_nonneg
  · unfold canonicalBandlimitedDyadicCoefficient
    positivity
  · exact canonicalBandlimitedDyadicCore_nonneg r j u

theorem summable_canonicalBandlimitedDyadicCoefficient
    (N : Nat) (hN : 2 < N) (c r : Real) :
    Summable (canonicalBandlimitedDyadicCoefficient N c r) := by
  let q : Real := ((2 : Real)⁻¹) ^ (N - 2)
  have hqnonneg : 0 ≤ q := by
    dsimp only [q]
    positivity
  have hqle : q < 1 := by
    dsimp only [q]
    apply pow_lt_one₀ (by positivity) (by norm_num)
    exact Nat.ne_of_gt (Nat.sub_pos_of_lt hN)
  have hgeom : Summable (fun j : Nat => q ^ j) :=
    summable_geometric_of_lt_one hqnonneg hqle
  refine (Summable.mul_left ((((2 : Real) ^ N) / c) * (2 / r) ^ 2) hgeom).congr ?_
  intro j
  unfold canonicalBandlimitedDyadicCoefficient
  dsimp only [q]
  rw [← pow_mul, Nat.mul_comm, inv_pow, inv_pow, ← pow_mul]

theorem summable_canonicalBandlimitedDyadicTerm
    (N : Nat) (hN : 2 < N) {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (u : Euclidean 2) :
    Summable (fun j : Nat =>
      canonicalBandlimitedDyadicCoefficient N c r j *
        canonicalBandlimitedDyadicCore r j u) := by
  let B : Real := (r / 2) ^ 2 *
    (SchwartzMap.seminorm Complex 0 0) canonicalPositiveCore
  have hcoeffsum := summable_canonicalBandlimitedDyadicCoefficient N hN c r
  have hboundsum : Summable (fun j : Nat =>
      canonicalBandlimitedDyadicCoefficient N c r j * B) := by
    refine (Summable.mul_left B hcoeffsum).congr ?_
    intro j
    ring
  refine hboundsum.of_nonneg_of_le ?_ ?_
  · intro j
    exact canonicalBandlimitedDyadicCore_nonneg_coefficient N hc hr j u
  · intro j
    apply mul_le_mul_of_nonneg_left
    · exact canonicalBandlimitedDyadicCore_le_uniformBound hr j u
    · unfold canonicalBandlimitedDyadicCoefficient
      positivity

private theorem exists_nat_dyadic_cover_of_two_le {t : Real} (ht : 2 ≤ t) :
    ∃ n : Nat, (2 : Real) ^ n ≤ t ∧ t < (2 : Real) ^ (n + 1) := by
  have hpow : Filter.Tendsto (fun n : Nat => (2 : Real) ^ n)
      Filter.atTop Filter.atTop :=
    tendsto_pow_atTop_atTop_of_one_lt (by norm_num)
  obtain ⟨m, hm⟩ := Filter.eventually_atTop.1 (hpow.eventually_gt_atTop t)
  have hexists : ∃ n : Nat, t < (2 : Real) ^ (n + 1) := by
    refine ⟨m, ?_⟩
    apply (hm m le_rfl).trans_le
    rw [show m + 1 = Nat.succ m by omega, pow_succ]
    have hnonneg : 0 ≤ (2 : Real) ^ m := pow_nonneg (by norm_num) _
    nlinarith
  let n : Nat := Nat.find hexists
  have hnupper : t < (2 : Real) ^ (n + 1) := Nat.find_spec hexists
  have hnpos : 0 < n := by
    by_contra h
    have hnzero : n = 0 := Nat.eq_zero_of_not_pos h
    have hsmall : t < 2 := by
      simpa [hnzero] using hnupper
    linarith
  have hnlower : (2 : Real) ^ n ≤ t := by
    by_contra h
    have hlt : t < (2 : Real) ^ n := lt_of_not_ge h
    have hpred : n - 1 + 1 = n := Nat.sub_add_cancel (Nat.succ_le_iff.2 hnpos)
    have : t < (2 : Real) ^ ((n - 1) + 1) := by simpa [hpred] using hlt
    exact (not_lt_of_ge (Nat.find_min' hexists this))
      (Nat.sub_lt hnpos (by omega))
  exact ⟨n, hnlower, hnupper⟩

theorem canonicalBandlimited_profile_le_coefficient_core_of_norm_le
    (N : Nat) (hN : 2 ≤ N) {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (hcore : ∀ x : Euclidean 2, ‖x‖ ≤ r → c ≤ (canonicalPositiveCore x).re)
    (j : Nat) (u : Euclidean 2)
    (hu : ‖u‖ ≤ 2 * (2 : Real) ^ j)
    (hprofile : lightRayDecayProfile N u ≤
      (2 : Real) ^ N * (((2 : Real) ^ j)⁻¹) ^ N) :
    lightRayDecayProfile N u ≤
      canonicalBandlimitedDyadicCoefficient N c r j *
        canonicalBandlimitedDyadicCore r j u := by
  have hlow := canonicalBandlimitedDyadicCore_lower_of_norm_le hr hcore j u hu
  have hcoeffnonneg : 0 ≤ canonicalBandlimitedDyadicCoefficient N c r j := by
    unfold canonicalBandlimitedDyadicCoefficient
    positivity
  have hproduct :
      canonicalBandlimitedDyadicCoefficient N c r j *
          ((canonicalBandlimitedDyadicScale r j) ^ 2 * c) ≤
        canonicalBandlimitedDyadicCoefficient N c r j *
          canonicalBandlimitedDyadicCore r j u := by
    exact mul_le_mul_of_nonneg_left hlow hcoeffnonneg
  calc
    lightRayDecayProfile N u ≤
        (2 : Real) ^ N * (((2 : Real) ^ j)⁻¹) ^ N := hprofile
    _ = canonicalBandlimitedDyadicCoefficient N c r j *
          ((canonicalBandlimitedDyadicScale r j) ^ 2 * c) := by
      symm
      rw [← mul_assoc]
      exact canonicalBandlimited_coefficient_scale_sq_mul N hN hc hr j
    _ ≤ canonicalBandlimitedDyadicCoefficient N c r j *
          canonicalBandlimitedDyadicCore r j u := hproduct

/-- The literal polynomial light-ray profile is dominated by a summable family
of positive, normalized, bandlimited Schwartz cores.  This is the physical
tail bridge needed before applying the compact-frequency Kakeya estimate to
each summand. -/
theorem lightRayDecayProfile_le_tsum_canonicalBandlimitedDyadicCore
    (N : Nat) (hN : 2 < N) {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (hcore : ∀ x : Euclidean 2, ‖x‖ ≤ r → c ≤ (canonicalPositiveCore x).re)
    (u : Euclidean 2) :
    lightRayDecayProfile N u ≤
      ∑' j : Nat, canonicalBandlimitedDyadicCoefficient N c r j *
        canonicalBandlimitedDyadicCore r j u := by
  have hsum := summable_canonicalBandlimitedDyadicTerm N hN hc hr u
  have hnonneg : ∀ j : Nat, 0 ≤
      canonicalBandlimitedDyadicCoefficient N c r j *
        canonicalBandlimitedDyadicCore r j u := by
    intro j
    exact canonicalBandlimitedDyadicCore_nonneg_coefficient N hc hr j u
  by_cases hsmall : ‖u‖ < 1
  · have hprofile : lightRayDecayProfile N u ≤ 1 := by
      unfold lightRayDecayProfile
      apply pow_le_one₀ (by positivity)
      apply (div_le_one₀ (by positivity)).mpr
      linarith [norm_nonneg u]
    have hu : ‖u‖ ≤ 2 * (2 : Real) ^ 0 := by
      norm_num
      linarith
    have hdyadic : lightRayDecayProfile N u ≤
        (2 : Real) ^ N * (((2 : Real) ^ 0)⁻¹) ^ N := by
      norm_num
      exact hprofile.trans (one_le_pow₀ (by norm_num))
    have hterm := canonicalBandlimited_profile_le_coefficient_core_of_norm_le
      N (Nat.le_of_lt hN) hc hr hcore 0 u hu hdyadic
    exact hterm.trans (hsum.le_tsum 0 fun j _ => hnonneg j)
  · have hlarge : 1 ≤ ‖u‖ := le_of_not_gt hsmall
    obtain ⟨n, hnlower, hnupper⟩ :=
      exists_nat_dyadic_cover_of_two_le (t := 1 + ‖u‖) (by linarith)
    have hnupper' : 1 + ‖u‖ < (2 : Real) ^ n * 2 := by
      rw [show n + 1 = Nat.succ n by omega, pow_succ] at hnupper
      exact hnupper
    have hu : ‖u‖ ≤ 2 * (2 : Real) ^ n := by
      apply le_of_lt
      calc
        ‖u‖ < 1 + ‖u‖ := by linarith
        _ < (2 : Real) ^ n * 2 := hnupper'
        _ = 2 * (2 : Real) ^ n := by ring
    have hbase : 1 / (1 + ‖u‖) ≤ ((2 : Real) ^ n)⁻¹ := by
      have hbase' : 1 / (1 + ‖u‖) ≤ 1 / ((2 : Real) ^ n) := by
        apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
        simpa using hnlower
      simpa only [one_div] using hbase'
    have hprofile : lightRayDecayProfile N u ≤ (((2 : Real) ^ n)⁻¹) ^ N := by
      unfold lightRayDecayProfile
      exact pow_le_pow_left₀ (by positivity) hbase N
    have hrawnonneg : 0 ≤ (((2 : Real) ^ n)⁻¹) ^ N := by positivity
    have hdyadic : lightRayDecayProfile N u ≤
        (2 : Real) ^ N * (((2 : Real) ^ n)⁻¹) ^ N := by
      calc
        lightRayDecayProfile N u ≤ (((2 : Real) ^ n)⁻¹) ^ N := hprofile
        _ = 1 * (((2 : Real) ^ n)⁻¹) ^ N := by ring
        _ ≤ (2 : Real) ^ N * (((2 : Real) ^ n)⁻¹) ^ N :=
          mul_le_mul_of_nonneg_right (one_le_pow₀ (by norm_num)) hrawnonneg
    have hterm := canonicalBandlimited_profile_le_coefficient_core_of_norm_le
      N (Nat.le_of_lt hN) hc hr hcore n u hu hdyadic
    exact hterm.trans (hsum.le_tsum n fun j _ => hnonneg j)

end
end Auto.Spherical.MSS
