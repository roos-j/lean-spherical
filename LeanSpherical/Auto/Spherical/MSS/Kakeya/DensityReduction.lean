noncomputable section

noncomputable def scratch_conjSchwartz
    (q : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  q.postcompCLM (Complex.conjCLE : Complex →L[Real] Complex)

theorem scratch_conjSchwartz_apply
    (q : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    scratch_conjSchwartz q x = (starRingEnd Complex) (q x) := by
  unfold scratch_conjSchwartz
  rw [SchwartzMap.postcompCLM_apply]
  exact Complex.conjCLE_apply (q x)

/-- The pointwise squared modulus of a complex Schwartz map, retained first
as a complex-valued Schwartz map. -/
noncomputable def scratch_normSqSchwartz
    (q : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex (scratch_conjSchwartz q : Euclidean 2 → Complex) q

theorem scratch_normSqSchwartz_apply
    (q : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    scratch_normSqSchwartz q x = (Complex.normSq (q x) : Complex) := by
  unfold scratch_normSqSchwartz
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (scratch_conjSchwartz q).hasTemperateGrowth]
  rw [scratch_conjSchwartz_apply]
  simpa only [smul_eq_mul] using (Complex.normSq_eq_conj_mul_self (z := q x)).symm

/-- The same core with its manifestly nonnegative real values. -/
noncomputable def scratch_positiveSchwartzCore
    (q : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Real :=
  (scratch_normSqSchwartz q).postcompCLM
    (Complex.reCLM : Complex →L[Real] Real)

theorem scratch_positiveSchwartzCore_apply
    (q : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    scratch_positiveSchwartzCore q x = Complex.normSq (q x) := by
  unfold scratch_positiveSchwartzCore
  rw [SchwartzMap.postcompCLM_apply, scratch_normSqSchwartz_apply]
  simp

theorem scratch_positiveSchwartzCore_nonneg
    (q : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    0 ≤ scratch_positiveSchwartzCore q x := by
  rw [scratch_positiveSchwartzCore_apply]
  exact Complex.normSq_nonneg _

/-- The reflected conjugate of a frequency profile.  Its inverse transform is
the pointwise conjugate of the inverse transform of the original profile. -/
noncomputable def scratch_reflectedConjSchwartz
    (q : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  (SchwartzMap.compCLMOfContinuousLinearEquiv Complex
    ((LinearIsometryEquiv.neg Real : Euclidean 2 ≃ₗᵢ[Real] Euclidean 2) :
      Euclidean 2 ≃L[Real] Euclidean 2)) (scratch_conjSchwartz q)

theorem scratch_reflectedConjSchwartz_apply
    (q : SchwartzMap (Euclidean 2) Complex) (xi : Euclidean 2) :
    scratch_reflectedConjSchwartz q xi = (starRingEnd Complex) (q (-xi)) := by
  unfold scratch_reflectedConjSchwartz
  rw [SchwartzMap.compCLMOfContinuousLinearEquiv_apply]
  change scratch_conjSchwartz q (-xi) = (starRingEnd Complex) (q (-xi))
  rw [scratch_conjSchwartz_apply]

private theorem scratch_star_fourierInv_neg_eq_fourierInv_star
    (q : Euclidean 2 → Complex) (x : Euclidean 2) :
    starRingEnd Complex (FourierTransform.fourierInv q (-x)) =
      FourierTransform.fourierInv (fun xi => starRingEnd Complex (q xi)) x := by
  rw [Real.fourierInv_eq, Real.fourierInv_eq, ← integral_conj]
  apply integral_congr_ae
  filter_upwards with xi
  have hchar :
      starRingEnd Complex
          ((Real.fourierChar (inner Real xi (-x)) : Circle) : Complex) =
        ((Real.fourierChar (inner Real xi x) : Circle) : Complex) := by
    rw [Real.fourierChar_apply, Real.fourierChar_apply, ← Complex.exp_conj]
    congr 1
    simp only [inner_neg_right, map_mul, Complex.conj_ofReal, Complex.conj_I]
    norm_num
  rw [Circle.smul_def, Circle.smul_def, smul_eq_mul, smul_eq_mul, map_mul, hchar]

theorem scratch_conj_fourierInv_eq_fourierInv_reflectedConj
    (q : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    scratch_conjSchwartz (FourierTransform.fourierInv q) x =
      FourierTransform.fourierInv (scratch_reflectedConjSchwartz q) x := by
  rw [scratch_conjSchwartz_apply]
  rw [SchwartzMap.fourierInv_coe]
  have hstar := scratch_star_fourierInv_neg_eq_fourierInv_star
    (q : Euclidean 2 → Complex) (-x)
  have hneg : -( -x) = x := by abel
  rw [hneg] at hstar
  calc
    starRingEnd Complex (FourierTransform.fourierInv (q : Euclidean 2 → Complex) x) =
        FourierTransform.fourierInv
          (fun xi => starRingEnd Complex (q xi)) (-x) := hstar
    _ = FourierTransform.fourierInv
        ((fun xi => starRingEnd Complex (q xi)) ∘
          (LinearIsometryEquiv.neg Real : Euclidean 2 ≃ₗᵢ[Real] Euclidean 2)) x := by
      simpa using (Real.fourierInv_comp_linearIsometry
        ((LinearIsometryEquiv.neg Real : Euclidean 2 ≃ₗᵢ[Real] Euclidean 2))
        (fun xi => starRingEnd Complex (q xi)) x).symm
    _ = FourierTransform.fourierInv (scratch_reflectedConjSchwartz q) x := by
      rw [SchwartzMap.fourierInv_coe]
      apply congrArg (fun f : Euclidean 2 → Complex =>
        FourierTransform.fourierInv f x)
      funext xi
      have hneg_apply : (LinearIsometryEquiv.neg Real) xi = -xi := by
        rfl
      simp only [Function.comp_apply]
      rw [hneg_apply]
      exact (scratch_reflectedConjSchwartz_apply q xi).symm

theorem scratch_conjSchwartz_hasCompactSupport
    (q : SchwartzMap (Euclidean 2) Complex)
    (hq : HasCompactSupport (q : Euclidean 2 → Complex)) :
    HasCompactSupport (scratch_conjSchwartz q : Euclidean 2 → Complex) := by
  change HasCompactSupport
    ((Complex.conjCLE : Complex →L[Real] Complex) ∘ (q : Euclidean 2 → Complex))
  exact hq.comp_left (map_zero _)

theorem scratch_reflectedConjSchwartz_hasCompactSupport
    (q : SchwartzMap (Euclidean 2) Complex)
    (hq : HasCompactSupport (q : Euclidean 2 → Complex)) :
    HasCompactSupport (scratch_reflectedConjSchwartz q : Euclidean 2 → Complex) := by
  change HasCompactSupport
    ((scratch_conjSchwartz q : Euclidean 2 → Complex) ∘
      (LinearIsometryEquiv.neg Real))
  exact (scratch_conjSchwartz_hasCompactSupport q hq).comp_homeomorph
    (LinearIsometryEquiv.neg Real).toHomeomorph

noncomputable def scratch_pointwiseProduct
    (P Q : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex (P : Euclidean 2 → Complex) Q

theorem scratch_pointwiseProduct_apply
    (P Q : SchwartzMap (Euclidean 2) Complex) (z : Euclidean 2) :
    scratch_pointwiseProduct P Q z = P z * Q z := by
  unfold scratch_pointwiseProduct
  rw [SchwartzMap.smulLeftCLM_apply_apply P.hasTemperateGrowth]
  simp only [smul_eq_mul]

theorem scratch_fourier_pointwiseProduct_eq_convolution
    (P Q : SchwartzMap (Euclidean 2) Complex) :
    FourierTransform.fourier (scratch_pointwiseProduct P Q) =
      (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
        (FourierTransform.fourier P)) (FourierTransform.fourier Q) := by
  let C : SchwartzMap (Euclidean 2) Complex :=
    (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
      (FourierTransform.fourier P)) (FourierTransform.fourier Q)
  have hC : FourierTransform.fourierInv C = scratch_pointwiseProduct P Q := by
    ext z
    rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq_fourier_neg]
    change (FourierTransform.fourier C : SchwartzMap (Euclidean 2) Complex) (-z) = _
    rw [show C =
      (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
        (FourierTransform.fourier P)) (FourierTransform.fourier Q) by rfl]
    rw [SchwartzMap.fourier_convolution, SchwartzMap.pairing_apply_apply]
    rw [scratch_pointwiseProduct_apply]
    have hP :
        (FourierTransform.fourier (FourierTransform.fourier P) :
          SchwartzMap (Euclidean 2) Complex) (-z) = P z := by
      have hP0 : FourierTransform.fourierInv (FourierTransform.fourier P) = P :=
        FourierTransform.fourierInv_fourier_eq P
      have hP1 := congrArg (fun R : SchwartzMap (Euclidean 2) Complex => R z) hP0
      change (FourierTransform.fourier (FourierTransform.fourier P) :
        SchwartzMap (Euclidean 2) Complex) (-z) = P z at hP1
      exact hP1
    have hQ :
        (FourierTransform.fourier (FourierTransform.fourier Q) :
          SchwartzMap (Euclidean 2) Complex) (-z) = Q z := by
      have hQ0 : FourierTransform.fourierInv (FourierTransform.fourier Q) = Q :=
        FourierTransform.fourierInv_fourier_eq Q
      have hQ1 := congrArg (fun R : SchwartzMap (Euclidean 2) Complex => R z) hQ0
      change (FourierTransform.fourier (FourierTransform.fourier Q) :
        SchwartzMap (Euclidean 2) Complex) (-z) = Q z at hQ1
      exact hQ1
    simpa [hP, hQ]
  calc
    FourierTransform.fourier (scratch_pointwiseProduct P Q) =
        FourierTransform.fourier (FourierTransform.fourierInv C) := by rw [hC]
    _ = C := FourierTransform.fourier_fourierInv_eq C
    _ = _ := rfl

theorem scratch_fourier_normSq_fourierInv_eq_convolution
    (q : SchwartzMap (Euclidean 2) Complex) :
    FourierTransform.fourier
        (scratch_normSqSchwartz (FourierTransform.fourierInv q)) =
      (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
        (scratch_reflectedConjSchwartz q)) q := by
  have hnorm :
      scratch_normSqSchwartz (FourierTransform.fourierInv q) =
        scratch_pointwiseProduct
          (scratch_conjSchwartz (FourierTransform.fourierInv q))
          (FourierTransform.fourierInv q) := by
    ext x
    rw [scratch_normSqSchwartz_apply, scratch_pointwiseProduct_apply,
      scratch_conjSchwartz_apply]
    simpa only [smul_eq_mul] using
      (Complex.normSq_eq_conj_mul_self
        (z := (FourierTransform.fourierInv q : SchwartzMap (Euclidean 2) Complex) x))
  have hconj :
      scratch_conjSchwartz (FourierTransform.fourierInv q) =
        FourierTransform.fourierInv (scratch_reflectedConjSchwartz q) := by
    ext x
    exact scratch_conj_fourierInv_eq_fourierInv_reflectedConj q x
  rw [hnorm, scratch_fourier_pointwiseProduct_eq_convolution, hconj,
    FourierTransform.fourier_fourierInv_eq, FourierTransform.fourier_fourierInv_eq]

theorem scratch_convolution_reflectedConj_hasCompactSupport
    (q : SchwartzMap (Euclidean 2) Complex)
    (hq : HasCompactSupport (q : Euclidean 2 → Complex)) :
    HasCompactSupport
      ((scratch_reflectedConjSchwartz q : Euclidean 2 → Complex)
        ⋆[ContinuousLinearMap.mul Complex Complex, volume]
        (q : Euclidean 2 → Complex)) := by
  exact (scratch_reflectedConjSchwartz_hasCompactSupport q hq).convolution
    (ContinuousLinearMap.mul Complex Complex) hq

theorem scratch_fourier_normSq_fourierInv_hasCompactSupport
    (q : SchwartzMap (Euclidean 2) Complex)
    (hq : HasCompactSupport (q : Euclidean 2 → Complex)) :
    HasCompactSupport
      (FourierTransform.fourier
        (scratch_normSqSchwartz (FourierTransform.fourierInv q)) :
          Euclidean 2 → Complex) := by
  have hEq := scratch_fourier_normSq_fourierInv_eq_convolution q
  have hRaw :
      (FourierTransform.fourier
        (scratch_normSqSchwartz (FourierTransform.fourierInv q)) :
          Euclidean 2 → Complex) =
        ((scratch_reflectedConjSchwartz q : Euclidean 2 → Complex)
          ⋆[ContinuousLinearMap.mul Complex Complex, volume]
          (q : Euclidean 2 → Complex)) := by
    funext xi
    have hpoint := congrArg (fun R : SchwartzMap (Euclidean 2) Complex => R xi) hEq
    simpa only [SchwartzMap.convolution_apply] using hpoint
  rw [hRaw]
  exact scratch_convolution_reflectedConj_hasCompactSupport q hq

/-- A nonzero Schwartz profile has a squared-modulus core uniformly positive
on some ball about the origin. -/
theorem scratch_exists_positive_ball_for_positiveSchwartzCore
    (P : SchwartzMap (Euclidean 2) Complex) (hPzero : P 0 ≠ 0) :
    ∃ c r : Real, 0 < c ∧ 0 < r ∧
      ∀ x : Euclidean 2, x ∈ Metric.ball 0 r →
        c ≤ scratch_positiveSchwartzCore P x := by
  have hcenter : 0 < scratch_positiveSchwartzCore P 0 := by
    rw [scratch_positiveSchwartzCore_apply]
    exact Complex.normSq_pos.mpr hPzero
  let c : Real := scratch_positiveSchwartzCore P 0 / 2
  have hc : 0 < c := by
    dsimp only [c]
    linarith
  have hcont : ContinuousAt (scratch_positiveSchwartzCore P) 0 :=
    (scratch_positiveSchwartzCore P).continuous.continuousAt
  rcases Metric.continuousAt_iff.mp hcont c hc with ⟨r, hr, hclose⟩
  refine ⟨c, r, hc, hr, ?_⟩
  intro x hx
  have hvalueDist :
      dist (scratch_positiveSchwartzCore P x) (scratch_positiveSchwartzCore P 0) < c :=
    hclose hx
  have habs :
      |scratch_positiveSchwartzCore P x - scratch_positiveSchwartzCore P 0| < c := by
    simpa only [Real.dist_eq] using hvalueDist
  have hsub :
      scratch_positiveSchwartzCore P 0 - scratch_positiveSchwartzCore P x < c := by
    calc
      scratch_positiveSchwartzCore P 0 - scratch_positiveSchwartzCore P x =
          -(scratch_positiveSchwartzCore P x - scratch_positiveSchwartzCore P 0) := by ring
      _ ≤ |scratch_positiveSchwartzCore P x - scratch_positiveSchwartzCore P 0| := neg_le_abs _
      _ < c := habs
  dsimp only [c] at hsub ⊢
  linarith

theorem scratch_fourierInv_center_eq_integral
    (q : SchwartzMap (Euclidean 2) Complex) :
    (FourierTransform.fourierInv q : SchwartzMap (Euclidean 2) Complex) 0 =
      ∫ xi : Euclidean 2, q xi := by
  rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq]
  simp

/-- A concrete compactly supported frequency bump has an inverse transform
which does not vanish at the origin. -/
theorem scratch_exists_compact_frequency_profile_with_nonzero_inverse_center :
    ∃ q : SchwartzMap (Euclidean 2) Complex,
      HasCompactSupport (q : Euclidean 2 → Complex) ∧
      (FourierTransform.fourierInv q : SchwartzMap (Euclidean 2) Complex) 0 ≠ 0 := by
  let b : ContDiffBump (0 : Euclidean 2) := ⟨1, 2, by norm_num, by norm_num⟩
  let q0 : Euclidean 2 → Complex := Complex.ofRealCLM ∘ b
  have hcompact : HasCompactSupport q0 := by
    exact b.hasCompactSupport.comp_left (by rfl)
  have hsmooth : ContDiff Real ∞ q0 := by
    exact Complex.ofRealCLM.contDiff.comp b.contDiff
  let q : SchwartzMap (Euclidean 2) Complex := hcompact.toSchwartzMap hsmooth
  refine ⟨q, ?_, ?_⟩
  · change HasCompactSupport q0
    exact hcompact
  · rw [scratch_fourierInv_center_eq_integral]
    change (∫ xi : Euclidean 2, (b xi : Complex)) ≠ 0
    have hI : (∫ xi : Euclidean 2, (b xi : Complex)) =
        ((∫ xi : Euclidean 2, b xi) : Complex) := by
      simpa using
        (integral_ofReal (𝕜 := Complex) (f := fun xi : Euclidean 2 => b xi)
          (μ := volume))
    rw [hI]
    exact_mod_cast b.integral_pos.ne'

/-- A real nonnegative Schwartz core, positive on a ball, whose complexified
version has compact Fourier support.  It is obtained as the squared modulus
of the inverse transform of a compact smooth frequency bump. -/
theorem scratch_exists_positive_bandlimited_schwartzCore :
    ∃ q : SchwartzMap (Euclidean 2) Complex, ∃ c r : Real,
      HasCompactSupport (q : Euclidean 2 → Complex) ∧
      HasCompactSupport
        (FourierTransform.fourier
          (scratch_normSqSchwartz (FourierTransform.fourierInv q)) :
            Euclidean 2 → Complex) ∧
      0 < c ∧ 0 < r ∧
      (∀ x : Euclidean 2,
        0 ≤ scratch_positiveSchwartzCore (FourierTransform.fourierInv q) x) ∧
      (∀ x : Euclidean 2, x ∈ Metric.ball 0 r →
        c ≤ scratch_positiveSchwartzCore (FourierTransform.fourierInv q) x) := by
  rcases scratch_exists_compact_frequency_profile_with_nonzero_inverse_center with
    ⟨q, hqcompact, hqzero⟩
  rcases scratch_exists_positive_ball_for_positiveSchwartzCore
    (FourierTransform.fourierInv q) hqzero with ⟨c, r, hc, hr, hball⟩
  refine ⟨q, c, r, hqcompact,
    scratch_fourier_normSq_fourierInv_hasCompactSupport q hqcompact,
    hc, hr, ?_, hball⟩
  intro x
  exact scratch_positiveSchwartzCore_nonneg _ x

end

end Auto.Spherical.MSS
end
