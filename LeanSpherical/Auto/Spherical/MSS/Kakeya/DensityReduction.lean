/-- The uniform-to-`L²` conversion from the real tensor development is
scalar-field agnostic; this complex specialization is what joins it to the
signed tube core. -/
theorem eLpNorm_two_sub_le_of_support_subset_and_uniform_complex
    {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (S : Set X) (hSmeas : MeasurableSet S) (hSfinite : μ S ≠ (⊤ : ENNReal))
    (f g : X → Complex)
    (hfsupp : Function.support f ⊆ S)
    (hgsupp : Function.support g ⊆ S)
    {epsilon : Real} (huniform : ∀ x, dist (g x) (f x) ≤ epsilon) :
    eLpNorm (g - f) 2 μ ≤
      (μ S) ^ ((2 : ENNReal).toReal)⁻¹ * ENNReal.ofReal epsilon := by
  have hsubsupp : Function.support (g - f) ⊆ S := by
    intro x hx
    by_contra hxS
    have hfzero : f x = 0 := by
      by_contra hzero
      apply hxS
      apply hfsupp
      rwa [Function.mem_support]
    have hgzero : g x = 0 := by
      by_contra hzero
      apply hxS
      apply hgsupp
      rwa [Function.mem_support]
    exact hx (by simp [hfzero, hgzero])
  letI : IsFiniteMeasure (μ.restrict S) := isFiniteMeasure_restrict.2 hSfinite
  rw [← eLpNorm_restrict_eq_of_support_subset hsubsupp]
  have hbound : ∀ᵐ x ∂μ.restrict S, ‖(g - f) x‖ ≤ epsilon := by
    filter_upwards [ae_restrict_mem hSmeas] with x hx
    simpa only [Pi.sub_apply, dist_eq_norm] using huniform x
  simpa only [Measure.restrict_apply_univ, Set.univ_inter] using
    (eLpNorm_le_of_ae_bound (μ := μ.restrict S) (p := (2 : ENNReal)) hbound)

theorem support_smoothSpatialTensor_subset_prod
    {ι : Type*} [Fintype ι]
    (U : ι → Euclidean 2 → Complex) (a : ι → Real → Complex)
    (A : Set (Euclidean 2)) (B : Set Real)
    (hU : ∀ i, Function.support (U i) ⊆ A)
    (ha : ∀ i, Function.support (a i) ⊆ B) :
    Function.support (smoothSpatialTensor U a) ⊆ A ×ˢ B := by
  intro z hz
  by_cases hzA : z.1 ∈ A
  · by_cases hzB : z.2 ∈ B
    · exact ⟨hzA, hzB⟩
    · have hazero : ∀ i, a i z.2 = 0 := by
        intro i
        by_contra hzero
        exact hzB (ha i (by rwa [Function.mem_support]))
      rw [Function.mem_support] at hz
      apply False.elim
      apply hz
      unfold smoothSpatialTensor
      apply Finset.sum_eq_zero
      intro i hi
      rw [hazero i, mul_zero]
  · have hUzero : ∀ i, U i z.1 = 0 := by
      intro i
      by_contra hzero
      exact hzA (hU i (by rwa [Function.mem_support]))
    rw [Function.mem_support] at hz
    apply False.elim
    apply hz
    unfold smoothSpatialTensor
    apply Finset.sum_eq_zero
    intro i hi
    rw [hUzero i, zero_mul]

theorem continuous_smoothSpatialTensor
    {ι : Type*} [Fintype ι]
    (U : ι → Euclidean 2 → Complex) (a : ι → Real → Complex)
    (hU : ∀ i, Continuous (U i)) (ha : ∀ i, Continuous (a i)) :
    Continuous (smoothSpatialTensor U a) := by
  unfold smoothSpatialTensor
  apply continuous_finset_sum
  intro i hi
  exact ((hU i).comp continuous_fst).mul ((ha i).comp continuous_snd)

/-- Allocate a strictly positive uniform error whose finite-measure `L²`
cost is below a prescribed tolerance. -/
theorem exists_uniform_l2_budget
    (S : Set WaveSpaceTime) (hSfinite : volume S ≠ (⊤ : ENNReal))
    {epsilon : Real} (hepsilon : 0 < epsilon) :
    ∃ alpha : Real, 0 < alpha ∧
      (volume S) ^ ((2 : ENNReal).toReal)⁻¹ * ENNReal.ofReal alpha <
        ENNReal.ofReal epsilon := by
  let D : ENNReal := (volume S) ^ ((2 : ENNReal).toReal)⁻¹
  have hDfinite : D ≠ (⊤ : ENNReal) := by
    apply ENNReal.rpow_ne_top_of_nonneg
    · positivity
    · exact hSfinite
  let d : Real := D.toReal
  let alpha : Real := epsilon / (d + 1)
  have hdnonneg : 0 ≤ d := ENNReal.toReal_nonneg
  have halpha : 0 < alpha := by
    dsimp [alpha]
    positivity
  refine ⟨alpha, halpha, ?_⟩
  have hfrac : d / (d + 1) < 1 := by
    rw [div_lt_one (by positivity)]
    linarith
  calc
    (volume S) ^ ((2 : ENNReal).toReal)⁻¹ * ENNReal.ofReal alpha =
        D * ENNReal.ofReal alpha := by rfl
    _ = ENNReal.ofReal d * ENNReal.ofReal alpha := by
      rw [ENNReal.ofReal_toReal hDfinite]
    _ = ENNReal.ofReal (d * alpha) := by
      rw [ENNReal.ofReal_mul hdnonneg]
    _ < ENNReal.ofReal epsilon := by
      rw [ENNReal.ofReal_lt_ofReal_iff hepsilon]
      dsimp [alpha]
      calc
        d * (epsilon / (d + 1)) = epsilon * (d / (d + 1)) := by
          field_simp
        _ < epsilon * 1 :=
          mul_lt_mul_of_pos_left hfrac hepsilon
        _ = epsilon := by ring

/-- A compactly supported joint smooth function supported in a product of a
spatial ball and a strict temporal ball can be approximated in `L²` by a
finite sum of smooth separated factors while retaining a common strict time
margin. -/
theorem exists_finite_smooth_separated_innerSlab_eLpNorm_sub_lt
    {rE RE r RF : Real}
    (hrE : 0 < rE) (hrERE : rE < RE)
    (hr : 0 < r) (hrRF : r < RF) (hRF : RF < 1)
    (u : WaveSpaceTime → Complex) (hucont : Continuous u)
    (husupport : Function.support u ⊆
      Metric.closedBall (0 : Euclidean 2) rE ×ˢ
        Metric.closedBall (3 / 2 : Real) r)
    {epsilon : Real} (hepsilon : 0 < epsilon) :
    ∃ (ι : Type) (_ : Fintype ι)
      (U : ι → Euclidean 2 → Complex) (a : ι → Real → Complex),
      (∀ i, HasCompactSupport (U i) ∧ ContDiff Real ∞ (U i)) ∧
      (∀ i, HasCompactSupport (a i) ∧ ContDiff Real ∞ (a i) ∧
        Function.support (a i) ⊆ Metric.closedBall (3 / 2 : Real) RF) ∧
      MemLp (smoothSpatialTensor U a) 2 volume ∧
      eLpNorm (u - smoothSpatialTensor U a) 2 volume <
        ENNReal.ofReal epsilon := by
  let S : Set WaveSpaceTime :=
    Metric.closedBall (0 : Euclidean 2) RE ×ˢ
      Metric.closedBall (3 / 2 : Real) RF
  have hScompact : IsCompact S := by
    dsimp only [S]
    apply IsCompact.prod
    · exact isCompact_closedBall _ _
    · exact isCompact_closedBall _ _
  have hSmeas : MeasurableSet S := by
    dsimp only [S]
    exact (Metric.isClosed_closedBall.measurableSet.prod
      Metric.isClosed_closedBall.measurableSet)
  have hSfinite : volume S ≠ (⊤ : ENNReal) := hScompact.measure_ne_top
  obtain ⟨alpha, halphapos, halpha⟩ :=
    exists_uniform_l2_budget S hSfinite hepsilon
  obtain ⟨ι, hι, U, a, hU, ha, huniform⟩ :=
    exists_finite_smooth_compact_separated_uniform_close_complex
      (Euclidean 2) Real (0 : Euclidean 2) (3 / 2 : Real)
      hrE hrERE hr hrRF u hucont husupport halphapos
  letI : Fintype ι := hι
  have hUSupport : ∀ i, Function.support (U i) ⊆
      Metric.closedBall (0 : Euclidean 2) RE := fun i => (hU i).2.2
  have haSupport : ∀ i, Function.support (a i) ⊆
      Metric.closedBall (3 / 2 : Real) RF := fun i => (ha i).2.2
  have hvSupport : Function.support (smoothSpatialTensor U a) ⊆ S := by
    simpa only [S] using support_smoothSpatialTensor_subset_prod U a
      (Metric.closedBall (0 : Euclidean 2) RE)
      (Metric.closedBall (3 / 2 : Real) RF) hUSupport haSupport
  have huSupportS : Function.support u ⊆ S := by
    intro z hz
    have hz' := husupport hz
    exact ⟨Metric.closedBall_subset_closedBall hrERE.le hz'.1,
      Metric.closedBall_subset_closedBall hrRF.le hz'.2⟩
  have huniform' : ∀ z : WaveSpaceTime,
      dist (smoothSpatialTensor U a z) (u z) ≤ alpha := by
    intro z
    exact (huniform z).le
  have hL2le := eLpNorm_two_sub_le_of_support_subset_and_uniform_complex
    volume S hSmeas hSfinite u (smoothSpatialTensor U a)
    huSupportS hvSupport huniform'
  have hcont : Continuous (smoothSpatialTensor U a) :=
    continuous_smoothSpatialTensor U a
      (fun i => (hU i).1.continuous) (fun i => (ha i).1.continuous)
  have hvcompact : HasCompactSupport (smoothSpatialTensor U a) :=
    HasCompactSupport.of_support_subset_isCompact hScompact hvSupport
  refine ⟨ι, inferInstance, U, a, ?_, ?_,
    hcont.memLp_of_hasCompactSupport hvcompact, ?_⟩
  · intro i
    exact ⟨(hU i).2.1, (hU i).1⟩
  · intro i
    exact ⟨(ha i).2.1, (ha i).1, (ha i).2.2⟩
  · simpa only [eLpNorm_sub_comm] using hL2le.trans_lt halpha

/-- The time-restricted `L²` datum is dense in finite smooth separated
tensors whose temporal factors share a strict inner-slab margin. -/
theorem exists_smoothSeparated_innerSlabTensor_near_lightRayTimeRestriction
    (g : WaveSpaceTime → Complex) (hg : MemLp g 2 volume)
    {epsilon : Real} (hepsilon : 0 < epsilon) :
    ∃ (ι : Type) (_ : Fintype ι)
      (U : ι → Euclidean 2 → Complex) (a : ι → Real → Complex) (r : Real),
      0 < r ∧ r < 1 ∧
      (∀ i, HasCompactSupport (U i) ∧ ContDiff Real ∞ (U i)) ∧
      (∀ i, HasCompactSupport (a i) ∧ ContDiff Real ∞ (a i) ∧
        Function.support (a i) ⊆ Metric.closedBall (3 / 2 : Real) r) ∧
      MemLp (smoothSpatialTensor U a) 2 volume ∧
      eLpNorm (scratch_lightRayTimeRestriction g -
        smoothSpatialTensor U a) 2 volume <
          ENNReal.ofReal epsilon := by
  let h : WaveSpaceTime → Complex := scratch_lightRayTimeRestriction g
  have hh : MemLp h 2 volume := by
    dsimp only [h]
    exact scratch_memLp_lightRayTimeRestriction g hg
  have hzero : ∀ z : WaveSpaceTime, z ∈ outsideTimeSlab → h z = 0 := by
    intro z hz
    dsimp only [h]
    simp only [outsideTimeSlab, Set.mem_setOf_eq] at hz
    simp [scratch_lightRayTimeRestriction, hz]
  have hepshalf : 0 < epsilon / 2 := by positivity
  obtain ⟨r0, hr0pos, hr0lt, u, hucompact, hucont, husupport, huerr⟩ :=
    exists_innerSlab_smoothCompact_eLpNorm_sub_lt_with_radius
      h hh hzero hepshalf
  change Function.support u ⊆
    {z : WaveSpaceTime | z.2 ∈ Metric.closedBall (3 / 2 : Real) r0} at husupport
  obtain ⟨B, hB⟩ :=
    (Metric.isBounded_iff_subset_closedBall (0 : WaveSpaceTime)).mp
      hucompact.isCompact.isBounded
  let rE : Real := |B| + 1
  let RE : Real := rE + 1
  have hrEpos : 0 < rE := by
    dsimp only [rE]
    positivity
  have hrERE : rE < RE := by
    dsimp only [RE]
    linarith
  have huSpatial : ∀ z : WaveSpaceTime, z ∈ Function.support u →
      z.1 ∈ Metric.closedBall (0 : Euclidean 2) rE := by
    intro z hz
    have hztsupport : z ∈ tsupport u := subset_closure hz
    have hzB := hB hztsupport
    change dist z (0 : WaveSpaceTime) ≤ B at hzB
    rw [Prod.dist_eq] at hzB
    change dist z.1 (0 : Euclidean 2) ≤ rE
    calc
      dist z.1 (0 : Euclidean 2) ≤
          max (dist z.1 (0 : Euclidean 2)) (dist z.2 (0 : Real)) := le_max_left _ _
      _ ≤ B := hzB
      _ ≤ |B| + 1 := by linarith [le_abs_self B]
      _ = rE := by rfl
  have huProdSupport : Function.support u ⊆
      Metric.closedBall (0 : Euclidean 2) rE ×ˢ
        Metric.closedBall (3 / 2 : Real) r0 := by
    intro z hz
    exact ⟨huSpatial z hz, husupport hz⟩
  let r : Real := (r0 + 1) / 2
  have hr0r : r0 < r := by
    dsimp only [r]
    linarith
  have hrlt : r < 1 := by
    dsimp only [r]
    linarith
  obtain ⟨ι, hι, U, a, hU, ha, hvmem, hverr⟩ :=
    exists_finite_smooth_separated_innerSlab_eLpNorm_sub_lt
      hrEpos hrERE hr0pos hr0r hrlt u hucont.continuous huProdSupport hepshalf
  letI : Fintype ι := hι
  refine ⟨ι, inferInstance, U, a, r, ?_, hrlt, hU, ha, hvmem, ?_⟩
  · dsimp only [r]
    positivity
  · have huMem : MemLp u 2 volume :=
      hucont.continuous.memLp_of_hasCompactSupport hucompact
    have hfirstMem : MemLp (h - u) 2 volume := hh.sub huMem
    have hsecondMem : MemLp (u - smoothSpatialTensor U a) 2 volume :=
      huMem.sub hvmem
    calc
      eLpNorm (scratch_lightRayTimeRestriction g -
          smoothSpatialTensor U a) 2 volume =
          eLpNorm ((h - u) +
            (u - smoothSpatialTensor U a)) 2 volume := by
              congr 1
              funext z
              dsimp only [h]
              simp only [Pi.sub_apply, Pi.add_apply]
              abel
      _ ≤ eLpNorm (h - u) 2 volume +
          eLpNorm (u - smoothSpatialTensor U a) 2 volume :=
        eLpNorm_add_le hfirstMem.aestronglyMeasurable hsecondMem.aestronglyMeasurable
          (by norm_num)
      _ < ENNReal.ofReal (epsilon / 2) + ENNReal.ofReal (epsilon / 2) :=
        ENNReal.add_lt_add huerr hverr
      _ = ENNReal.ofReal epsilon := by
        rw [← ENNReal.ofReal_add hepshalf.le hepshalf.le]
        ring

/-- The locally packaged compact-frequency core and the final signed-closure
core are definitionally the same tensors; this explicit bridge keeps the
density proof independent from the maximal-operator file. -/
theorem innerSlabCompactFrequencyTensorCore_iff
    (f : WaveSpaceTime → Complex) :
    InnerSlabCompactFrequencyTensorCore f ↔
      scratch_InnerSlabCompactFrequencyTensorCore f := by
  constructor
  · rintro ⟨ι, hι, q, a, r, hq, hrpos, hrlt, ha, hf⟩
    letI : Fintype ι := hι
    refine ⟨ι, inferInstance, q, a, r, hq, hrpos, hrlt, ha, ?_⟩
    calc
      f = compactFrequencyTensor q
          (fun i => (a i : Real → Complex)) := hf
      _ = scratch_innerSlabCompactFrequencyTensor q a := by
        funext z
        simp only [compactFrequencyTensor,
          scratch_innerSlabCompactFrequencyTensor]
  · rintro ⟨ι, hι, q, a, r, hq, hrpos, hrlt, ha, hf⟩
    letI : Fintype ι := hι
    refine ⟨ι, inferInstance, q, a, r, hq, hrpos, hrlt, ha, ?_⟩
    calc
      f = scratch_innerSlabCompactFrequencyTensor q a := hf
      _ = compactFrequencyTensor q
          (fun i => (a i : Real → Complex)) := by
        funext z
        simp only [compactFrequencyTensor,
          scratch_innerSlabCompactFrequencyTensor]

/-- Literal slab `L²` density of the finite compact-frequency tensor core,
with the strict common time margin needed by the outer `E₁` estimate. -/
theorem scratch_hasLightRaySlabL2DenseCore_innerSlabCompactFrequencyTensor :
    scratch_HasLightRaySlabL2DenseCore
      scratch_InnerSlabCompactFrequencyTensorCore := by
  have hlocal : HasL2DenseCoreAfter
      scratch_lightRayTimeRestriction
      InnerSlabCompactFrequencyTensorCore :=
    hasL2DenseInnerSlabCompactFrequencyTensorCoreAfter_of_smoothSeparatedDensity
      scratch_lightRayTimeRestriction
      (fun g hg => scratch_memLp_lightRayTimeRestriction g hg)
      (fun g hg epsilon hepsilon =>
        exists_smoothSeparated_innerSlabTensor_near_lightRayTimeRestriction
          g hg hepsilon)
  intro g hg epsilon hepsilon
  obtain ⟨f, hcore, hfmem, hferr⟩ := hlocal g hg epsilon hepsilon
  exact ⟨f, (innerSlabCompactFrequencyTensorCore_iff f).mp hcore, hfmem, hferr⟩

/-- All non-Kakeya bookkeeping for a signed tube envelope.  The four fields
are pointwise/measurability identities; the `L²` strong estimate is kept out
of the structure so it remains the unique analytic theorem required below. -/
structure InnerSlabFiniteTensorSignedEnvelopeModel where
  T : Real → Nat → (WaveSpaceTime → Complex) →
    Euclidean 2 → Euclidean 2 → Complex
  P : Real → Nat → (WaveSpaceTime → Complex) → Euclidean 2 → ENNReal
  hPmeas : ∀ delta N f, scratch_InnerSlabCompactFrequencyTensorCore f →
    Measurable (P delta N f)
  hidentify : ∀ delta N (h : WaveSpaceTime → Complex)
    (omega y : Euclidean 2),
    T delta N
        (scratch_lightRayTimeRestriction (fun z => (‖h z‖ : Complex))) omega y =
      (lightRayAverage delta N omega y h : Complex)
  hTgeom : ∀ delta N (F : WaveSpaceTime → Complex)
    (core : Nat → WaveSpaceTime → Complex),
    MemLp F 2 volume →
    (∀ n, MemLp (core n) 2 volume) →
    (∀ n, eLpNorm (F - core n) 2 volume ≤
      eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) →
    ∀ omega y,
      Tendsto (fun n => T delta N (core n) omega y) atTop
        (nhds (T delta N F omega y))
  hdom : ∀ delta N f omega y,
    ENNReal.ofReal ‖T delta N f omega y‖ ≤ P delta N f y

/-- The one remaining analytic input: the finite compact-frequency,
inner-slab tensor signed-envelope `L²` estimate. -/
def HasInnerSlabFiniteTensorSignedEnvelopeL2Estimate
    (model : InnerSlabFiniteTensorSignedEnvelopeModel) : Prop :=
  ∀ N : Nat, 3 < N → ∃ C : Real, 0 < C ∧
    ∀ delta : Real, 0 < delta → delta < 1 / 2 →
    ∀ f : WaveSpaceTime → Complex,
      scratch_InnerSlabCompactFrequencyTensorCore f →
      eLpNorm (model.P delta N f) 2 volume ≤
        ENNReal.ofReal (C * (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
          eLpNorm f 2 volume

/-- Complete literal maximal lift from the actual finite compact-frequency
inner-slab tensor core.  After constructing `model` from the signed tube
operator, its sole hypothesis is the finite-core signed-envelope `L²`
estimate; density, the `|g|` reduction, and Fatou are all discharged here. -/
theorem hasLightRayMaximalEstimate_of_innerSlabFiniteTensorSignedEnvelope
    (model : InnerSlabFiniteTensorSignedEnvelopeModel)
    (hstrong : HasInnerSlabFiniteTensorSignedEnvelopeL2Estimate model) :
    HasLightRayMaximalEstimate := by
  exact scratch_hasLightRayMaximalEstimate_of_innerSlabCompactFrequencyTensorCore
    scratch_hasLightRaySlabL2DenseCore_innerSlabCompactFrequencyTensor
    model.T model.P model.hPmeas hstrong model.hidentify model.hTgeom model.hdom

end

