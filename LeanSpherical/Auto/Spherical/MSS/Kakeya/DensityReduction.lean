section Auto.Spherical.MSS

open Filter MeasureTheory Set
open Auto.Spherical.SurfaceMeasureDecay
open scoped ENNReal Topology EuclideanSpace

noncomputable section

/-- A broad tube core with polynomial spatial decay has a direction-free
zero-direction envelope.  Unlike the compact-bump version, this applies to
positive bandlimited Schwartz cores. -/
theorem scratch_smoothTubeCore_le_zeroDirectionLightRayKernel_of_decay
    (b : Euclidean 2 → Real) (K : Nat) {A : Real} (hA : 0 ≤ A)
    (hb : ∀ u : Euclidean 2, b u ≤ A * lightRayDecayProfile K u)
    {rho : Real} (hrho : (1 / 2 : Real) ≤ rho)
    (omega y x : Euclidean 2) (t : Real)
    (homega : ‖omega‖ ≤ 1) (ht : t ∈ lightRayTimeInterval) :
    scratch_smoothTubeCore b rho omega y (x, t) ≤
      ((6 : Real) ^ K * A) * lightRayKernel rho K 0 x (y, 0) := by
  have hrho_pos : 0 < rho := lt_of_lt_of_le (by norm_num) hrho
  have hrho_nonneg : 0 ≤ rho := hrho_pos.le
  have hinv_nonneg : 0 ≤ rho⁻¹ := inv_nonneg.mpr hrho_nonneg
  have hinv_le : rho⁻¹ ≤ 2 := by
    have h : 1 / rho ≤ 1 / (1 / (2 : Real)) :=
      one_div_le_one_div_of_le (by norm_num) hrho
    norm_num at h
    simpa only [one_div] using h
  have ht_nonneg : 0 ≤ t := by
    exact (by norm_num : (0 : Real) ≤ 1 / 2).trans ht.1
  have ht_le : t ≤ 5 / 2 := ht.2
  have hshift : ‖rho⁻¹ • (t • omega)‖ ≤ 5 := by
    rw [norm_smul, norm_smul, Real.norm_eq_abs,
      abs_of_nonneg hinv_nonneg, Real.norm_eq_abs, abs_of_nonneg ht_nonneg]
    calc
      rho⁻¹ * (t * ‖omega‖) ≤ 2 * ((5 / 2) * 1) := by
        gcongr
      _ = 5 := by norm_num
  let a : Euclidean 2 := rho⁻¹ • (x - y)
  let v : Euclidean 2 := rho⁻¹ • (t • omega)
  have harg : rho⁻¹ • (x + t • omega - y) = a + v := by
    dsimp only [a, v]
    module
  have hv : ‖v‖ ≤ 5 := by
    simpa only [v] using hshift
  have hden : 1 + ‖a‖ ≤ 6 * (1 + ‖a + v‖) := by
    calc
      1 + ‖a‖ ≤ 1 + (‖a + v‖ + ‖v‖) := by
        gcongr
        calc
          ‖a‖ = ‖(a + v) - v‖ := by
            congr 1
            module
          _ ≤ ‖a + v‖ + ‖v‖ := norm_sub_le _ _
      _ ≤ 1 + (‖a + v‖ + 5) := by gcongr
      _ ≤ 6 * (1 + ‖a + v‖) := by
        nlinarith [norm_nonneg (a + v)]
  have hden_a_pos : 0 < 1 + ‖a‖ := by positivity
  have hden_av_pos : 0 < 1 + ‖a + v‖ := by positivity
  have hinv :
      1 / (1 + ‖a + v‖) ≤ 6 * (1 / (1 + ‖a‖)) := by
    calc
      1 / (1 + ‖a + v‖) ≤ 6 / (1 + ‖a‖) := by
        apply (div_le_div_iff₀ hden_av_pos hden_a_pos).mpr
        simpa only [one_mul, mul_assoc] using hden
      _ = 6 * (1 / (1 + ‖a‖)) := by ring
  have hpow :
      (1 / (1 + ‖a + v‖)) ^ K ≤
        (6 : Real) ^ K * (1 / (1 + ‖a‖)) ^ K := by
    calc
      (1 / (1 + ‖a + v‖)) ^ K ≤
          (6 * (1 / (1 + ‖a‖))) ^ K :=
        pow_le_pow_left₀ (by positivity) hinv K
      _ = (6 : Real) ^ K * (1 / (1 + ‖a‖)) ^ K := by
        rw [mul_pow]
  have hprofile :
      lightRayDecayProfile K (rho⁻¹ • (x + t • omega - y)) ≤
        (6 : Real) ^ K * lightRayDecayProfile K (rho⁻¹ • (x - y)) := by
    unfold lightRayDecayProfile
    rw [harg]
    exact hpow
  have hprofile_symm :
      lightRayDecayProfile K (rho⁻¹ • (x - y)) =
        lightRayDecayProfile K (rho⁻¹ • (y - x)) := by
    unfold lightRayDecayProfile
    have hnorm : ‖rho⁻¹ • (x - y)‖ = ‖rho⁻¹ • (y - x)‖ := by
      rw [show y - x = -(x - y) by module, smul_neg, norm_neg]
    rw [hnorm]
  rw [lightRayKernel_eq_scaled_decayProfile hrho_pos K 0 x y 0]
  simp only [smul_zero, add_zero]
  unfold scratch_smoothTubeCore
  rw [show x + t • omega - y = x + t • omega - y by rfl]
  calc
    (rho⁻¹) ^ 2 * b (rho⁻¹ • (x + t • omega - y)) ≤
        (rho⁻¹) ^ 2 * (A *
          lightRayDecayProfile K (rho⁻¹ • (x + t • omega - y))) := by
      exact mul_le_mul_of_nonneg_left (hb _) (sq_nonneg _)
    _ ≤ (rho⁻¹) ^ 2 * (A *
        ((6 : Real) ^ K * lightRayDecayProfile K (rho⁻¹ • (x - y)))) := by
      exact mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hprofile hA) (sq_nonneg _)
    _ = ((6 : Real) ^ K * A) *
        ((rho⁻¹) ^ 2 * lightRayDecayProfile K (rho⁻¹ • (x - y))) := by
      ring
    _ = ((6 : Real) ^ K * A) *
        ((rho⁻¹) ^ 2 * lightRayDecayProfile K (rho⁻¹ • (y - x))) := by
      rw [hprofile_symm]

/-- The preceding broad-width envelope passes through the positive spatial
and time averages under the same routine integrability hypotheses as the
compact-core proof. -/
theorem scratch_positiveSmoothTubeAverage_le_zeroDirectionPositiveEnvelope_of_decay
    (b : Euclidean 2 → Real) (K : Nat) {A : Real} (hA : 0 ≤ A)
    (hb : ∀ u : Euclidean 2, b u ≤ A * lightRayDecayProfile K u)
    {rho : Real} (hrho : (1 / 2 : Real) ≤ rho)
    (omega y : Euclidean 2) (homega : ‖omega‖ ≤ 1)
    (G : Euclidean 2 → Real → Real) (hG : ∀ x t, 0 ≤ G x t)
    (hcoreSlice : ∀ t, Integrable (fun x : Euclidean 2 =>
      scratch_smoothTubeCore b rho omega y (x, t) * G x t) volume)
    (henvSlice : ∀ t, Integrable (fun x : Euclidean 2 =>
      lightRayKernel rho K 0 x (y, 0) * G x t) volume)
    (hcoreTime : Integrable (fun t : Real => ∫ x : Euclidean 2,
      scratch_smoothTubeCore b rho omega y (x, t) * G x t)
      (volume.restrict lightRayTimeInterval))
    (henvTime : Integrable (fun t : Real => ∫ x : Euclidean 2,
      lightRayKernel rho K 0 x (y, 0) * G x t)
      (volume.restrict lightRayTimeInterval)) :
    scratch_positiveSmoothTubeAverage b rho omega y G ≤
      ((6 : Real) ^ K * A) * scratch_zeroDirectionPositiveEnvelope rho K y G := by
  let C : Real := (6 : Real) ^ K * A
  have hC : 0 ≤ C := mul_nonneg (pow_nonneg (by norm_num) _) hA
  unfold scratch_positiveSmoothTubeAverage scratch_zeroDirectionPositiveEnvelope
  calc
    (∫ t in lightRayTimeInterval, ∫ x : Euclidean 2,
      scratch_smoothTubeCore b rho omega y (x, t) * G x t) ≤
        ∫ t in lightRayTimeInterval, C *
          (∫ x : Euclidean 2, lightRayKernel rho K 0 x (y, 0) * G x t) := by
      apply integral_mono_ae hcoreTime (henvTime.const_mul C)
      filter_upwards [ae_restrict_mem (by
        unfold lightRayTimeInterval
        exact measurableSet_Icc)] with t ht
      calc
        (∫ x : Euclidean 2,
          scratch_smoothTubeCore b rho omega y (x, t) * G x t) ≤
            ∫ x : Euclidean 2, C *
              (lightRayKernel rho K 0 x (y, 0) * G x t) := by
          apply integral_mono (hcoreSlice t) ((henvSlice t).const_mul C)
          intro x
          calc
            scratch_smoothTubeCore b rho omega y (x, t) * G x t ≤
                (((6 : Real) ^ K * A) * lightRayKernel rho K 0 x (y, 0)) * G x t :=
              mul_le_mul_of_nonneg_right
                (scratch_smoothTubeCore_le_zeroDirectionLightRayKernel_of_decay
                  b K hA hb hrho omega y x t homega ht)
                (hG x t)
            _ = C * (lightRayKernel rho K 0 x (y, 0) * G x t) := by
              dsimp only [C]
              ring
        _ = C * (∫ x : Euclidean 2,
          lightRayKernel rho K 0 x (y, 0) * G x t) := by
          rw [integral_const_mul]
    _ = C * (∫ t in lightRayTimeInterval, ∫ x : Euclidean 2,
      lightRayKernel rho K 0 x (y, 0) * G x t) := by
      rw [integral_const_mul]
    _ = ((6 : Real) ^ K * A) *
        scratch_zeroDirectionPositiveEnvelope rho K y G := by
      rfl

/-- Squaring a nonnegative decay-envelope domination is independent of the
particular physical core. -/
theorem scratch_integral_sq_positiveSmoothTubeAverage_le_of_decay
    (b : Euclidean 2 → Real) (rho : Real) (omega : Euclidean 2)
    (K : Nat) (G : Euclidean 2 → Real → Real) {C : Real} (hC : 0 ≤ C)
    (hpoint : ∀ y : Euclidean 2,
      scratch_positiveSmoothTubeAverage b rho omega y G ≤
        C * scratch_zeroDirectionPositiveEnvelope rho K y G)
    (hcore_nonneg : ∀ y : Euclidean 2,
      0 ≤ scratch_positiveSmoothTubeAverage b rho omega y G)
    (henv_nonneg : ∀ y : Euclidean 2,
      0 ≤ scratch_zeroDirectionPositiveEnvelope rho K y G)
    (hcore_sq : Integrable (fun y : Euclidean 2 =>
      scratch_positiveSmoothTubeAverage b rho omega y G ^ 2) volume)
    (henv_sq : Integrable (fun y : Euclidean 2 =>
      scratch_zeroDirectionPositiveEnvelope rho K y G ^ 2) volume) :
    (∫ y : Euclidean 2, scratch_positiveSmoothTubeAverage b rho omega y G ^ 2) ≤
      C ^ 2 * ∫ y : Euclidean 2,
        scratch_zeroDirectionPositiveEnvelope rho K y G ^ 2 := by
  calc
    (∫ y : Euclidean 2, scratch_positiveSmoothTubeAverage b rho omega y G ^ 2) ≤
        ∫ y : Euclidean 2, C ^ 2 *
          scratch_zeroDirectionPositiveEnvelope rho K y G ^ 2 := by
      apply integral_mono hcore_sq (henv_sq.const_mul (C ^ 2))
      intro y
      have hright : 0 ≤ C * scratch_zeroDirectionPositiveEnvelope rho K y G :=
        mul_nonneg hC (henv_nonneg y)
      have hsquare := (sq_le_sq₀ (hcore_nonneg y) hright).mpr (hpoint y)
      simpa only [mul_pow] using hsquare
    _ = C ^ 2 * ∫ y : Euclidean 2,
        scratch_zeroDirectionPositiveEnvelope rho K y G ^ 2 := by
      rw [integral_const_mul]

/-- Every real Schwartz core is bounded above by a finite multiple of every
polynomial light-ray decay profile.  This is the exact certificate consumed
by the noncompact broad-width envelope. -/
theorem scratch_schwartz_le_lightRayDecayProfile
    (b : SchwartzMap (Euclidean 2) Real) (K : Nat) :
    ∃ A : Real, 0 ≤ A ∧
      ∀ u : Euclidean 2, b u ≤ A * lightRayDecayProfile K u := by
  rcases b.decay 0 0 with ⟨C0, hC0pos, hC0⟩
  rcases b.decay K 0 with ⟨CK, hCKpos, hCK⟩
  let A : Real := (2 : Real) ^ K * (C0 + CK)
  have hA : 0 ≤ A := by
    dsimp only [A]
    positivity
  refine ⟨A, hA, ?_⟩
  intro u
  have hC0norm : ‖b u‖ ≤ C0 := by
    simpa only [pow_zero, one_mul, norm_iteratedFDeriv_zero] using hC0 u
  have hCKnorm : ‖u‖ ^ K * ‖b u‖ ≤ CK := by
    simpa only [norm_iteratedFDeriv_zero] using hCK u
  have hC0 : 0 ≤ C0 := hC0pos.le
  have hCK : 0 ≤ CK := hCKpos.le
  have hbu_norm : b u ≤ ‖b u‖ := by
    rw [Real.norm_eq_abs]
    exact le_abs_self _
  have hnorm_u : 0 ≤ ‖u‖ := norm_nonneg _
  have hden_pos : 0 < 1 + ‖u‖ := by positivity
  have hdenpow_pos : 0 < (1 + ‖u‖) ^ K := pow_pos hden_pos _
  have hrewrite :
      A / (1 + ‖u‖) ^ K = A * (1 / (1 + ‖u‖)) ^ K := by
    rw [div_eq_mul_inv, ← inv_pow]
    simp only [one_div]
  rw [show lightRayDecayProfile K u = (1 / (1 + ‖u‖)) ^ K by rfl]
  rw [← hrewrite]
  apply (le_div_iff₀ hdenpow_pos).mpr
  by_cases hsmall : ‖u‖ ≤ 1
  · have hden : 1 + ‖u‖ ≤ 2 := by linarith
    have hpowden : (1 + ‖u‖) ^ K ≤ (2 : Real) ^ K :=
      pow_le_pow_left₀ (by positivity) hden K
    calc
      b u * (1 + ‖u‖) ^ K ≤ ‖b u‖ * (1 + ‖u‖) ^ K := by
        exact mul_le_mul_of_nonneg_right hbu_norm (pow_nonneg (by positivity) _)
      _ ≤ C0 * (1 + ‖u‖) ^ K := by
        exact mul_le_mul_of_nonneg_right hC0norm (pow_nonneg (by positivity) _)
      _ ≤ C0 * (2 : Real) ^ K := by
        exact mul_le_mul_of_nonneg_left hpowden hC0
      _ = (2 : Real) ^ K * C0 := by ring
      _ ≤ (2 : Real) ^ K * (C0 + CK) := by
        exact mul_le_mul_of_nonneg_left (by linarith) (pow_nonneg (by norm_num) _)
      _ = A := by rfl
  · have hlarge : 1 ≤ ‖u‖ := le_of_not_ge hsmall
    have hden : 1 + ‖u‖ ≤ 2 * ‖u‖ := by linarith
    have hpowden : (1 + ‖u‖) ^ K ≤ (2 * ‖u‖) ^ K :=
      pow_le_pow_left₀ (by positivity) hden K
    have hmain : b u * (1 + ‖u‖) ^ K ≤ A := by
      calc
        b u * (1 + ‖u‖) ^ K ≤ ‖b u‖ * (1 + ‖u‖) ^ K := by
          exact mul_le_mul_of_nonneg_right hbu_norm (pow_nonneg (by positivity) _)
        _ ≤ ‖b u‖ * (2 * ‖u‖) ^ K := by
          exact mul_le_mul_of_nonneg_left hpowden (norm_nonneg _)
        _ = (2 : Real) ^ K * (‖u‖ ^ K * ‖b u‖) := by
          rw [mul_pow]
          ring
        _ ≤ (2 : Real) ^ K * CK := by
          exact mul_le_mul_of_nonneg_left hCKnorm (pow_nonneg (by norm_num) _)
        _ ≤ (2 : Real) ^ K * (C0 + CK) := by
          exact mul_le_mul_of_nonneg_left (by linarith) (pow_nonneg (by norm_num) _)
        _ = A := by rfl
    simpa only [mul_comm] using hmain

/-- The positive bandlimited core constructed from a compact frequency bump
has the exact broad-width zero-direction envelope needed by the existing
positive-kernel closure. -/
theorem scratch_exists_broadWidth_envelope_positiveBandlimitedCore
    (q : SchwartzMap (Euclidean 2) Complex)
    (hq : HasCompactSupport (q : Euclidean 2 → Complex))
    (K : Nat) {rho : Real} (hrho : (1 / 2 : Real) ≤ rho)
    (omega y x : Euclidean 2) (t : Real)
    (homega : ‖omega‖ ≤ 1) (ht : t ∈ lightRayTimeInterval) :
    ∃ A : Real, 0 ≤ A ∧
      HasCompactSupport
        (FourierTransform.fourier
          (scratch_normSqSchwartz
            (FourierTransform.fourierInv q)) : Euclidean 2 → Complex) ∧
      scratch_smoothTubeCore
        (scratch_positiveSchwartzCore
          (FourierTransform.fourierInv q)) rho omega y (x, t) ≤
        ((6 : Real) ^ K * A) * lightRayKernel rho K 0 x (y, 0) := by
  rcases scratch_schwartz_le_lightRayDecayProfile
    (scratch_positiveSchwartzCore
      (FourierTransform.fourierInv q)) K with ⟨A, hA, hdecay⟩
  refine ⟨A, hA,
    scratch_fourier_normSq_fourierInv_hasCompactSupport q hq,
    ?_⟩
  exact scratch_smoothTubeCore_le_zeroDirectionLightRayKernel_of_decay
    _ K hA hdecay hrho omega y x t homega ht

/-- Full broad-width quadratic reduction for a positive bandlimited core.
The remaining assumptions are precisely the routine slice/Fubini
integrability conditions already isolated by the compact-core closure. -/
theorem scratch_exists_integral_sq_broadWidth_positiveBandlimitedCore_le
    (q : SchwartzMap (Euclidean 2) Complex)
    (hq : HasCompactSupport (q : Euclidean 2 → Complex))
    (K : Nat) {rho : Real} (hrho : (1 / 2 : Real) ≤ rho)
    (omega : Euclidean 2) (homega : ‖omega‖ ≤ 1)
    (G : Euclidean 2 → Real → Real) (hG : ∀ x t, 0 ≤ G x t)
    (hcoreSlice : ∀ y t, Integrable (fun x : Euclidean 2 =>
      scratch_smoothTubeCore
        (scratch_positiveSchwartzCore
          (FourierTransform.fourierInv q)) rho omega y (x, t) * G x t) volume)
    (henvSlice : ∀ y t, Integrable (fun x : Euclidean 2 =>
      lightRayKernel rho K 0 x (y, 0) * G x t) volume)
    (hcoreTime : ∀ y, Integrable (fun t : Real => ∫ x : Euclidean 2,
      scratch_smoothTubeCore
        (scratch_positiveSchwartzCore
          (FourierTransform.fourierInv q)) rho omega y (x, t) * G x t)
      (volume.restrict lightRayTimeInterval))
    (henvTime : ∀ y, Integrable (fun t : Real => ∫ x : Euclidean 2,
      lightRayKernel rho K 0 x (y, 0) * G x t)
      (volume.restrict lightRayTimeInterval))
    (hcoreSq : Integrable (fun y : Euclidean 2 =>
      scratch_positiveSmoothTubeAverage
        (scratch_positiveSchwartzCore
          (FourierTransform.fourierInv q)) rho omega y G ^ 2) volume)
    (henvSq : Integrable (fun y : Euclidean 2 =>
      scratch_zeroDirectionPositiveEnvelope rho K y G ^ 2) volume) :
    ∃ A : Real, 0 ≤ A ∧
      HasCompactSupport
        (FourierTransform.fourier
          (scratch_normSqSchwartz
            (FourierTransform.fourierInv q)) : Euclidean 2 → Complex) ∧
      (∫ y : Euclidean 2,
        scratch_positiveSmoothTubeAverage
          (scratch_positiveSchwartzCore
            (FourierTransform.fourierInv q)) rho omega y G ^ 2) ≤
        ((6 : Real) ^ K * A) ^ 2 *
          ∫ y : Euclidean 2,
            scratch_zeroDirectionPositiveEnvelope rho K y G ^ 2 := by
  let b : Euclidean 2 → Real :=
    scratch_positiveSchwartzCore
      (FourierTransform.fourierInv q)
  rcases scratch_schwartz_le_lightRayDecayProfile
    (scratch_positiveSchwartzCore
      (FourierTransform.fourierInv q)) K with ⟨A, hA, hdecay⟩
  have hpoint : ∀ y : Euclidean 2,
