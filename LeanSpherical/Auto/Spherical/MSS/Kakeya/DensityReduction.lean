-- BEGIN ScratchInnerSlabDensity
section

open Filter MeasureTheory Set
open Auto.Spherical.SurfaceMeasureDecay
open Auto.Spherical.MSS
open scoped ENNReal ContDiff

section Auto.Spherical.MSS

noncomputable section

noncomputable def slabCenter : Real := 3 / 2

noncomputable def slabBump (r R : Real) (hr : 0 < r) (hrR : r < R) :
    ContDiffBump slabCenter := ⟨r, R, hr, hrR⟩

noncomputable def applyInnerSlabCutoff
    (r R : Real) (hr : 0 < r) (hrR : r < R)
    (f : WaveSpaceTime → Complex) : WaveSpaceTime → Complex :=
  fun z => ((slabBump r R hr hrR z.2 : Real) : Complex) * f z

theorem contDiff_applyInnerSlabCutoff
    (r R : Real) (hr : 0 < r) (hrR : r < R)
    (f : WaveSpaceTime → Complex) (hf : ContDiff Real ∞ f) :
    ContDiff Real ∞ (applyInnerSlabCutoff r R hr hrR f) := by
  unfold applyInnerSlabCutoff
  apply (Complex.ofRealCLM.contDiff.comp
    ((slabBump r R hr hrR).contDiff.comp contDiff_snd)).mul hf

theorem hasCompactSupport_applyInnerSlabCutoff
    (r R : Real) (hr : 0 < r) (hrR : r < R)
    (f : WaveSpaceTime → Complex) (hf : HasCompactSupport f) :
    HasCompactSupport (applyInnerSlabCutoff r R hr hrR f) := by
  unfold applyInnerSlabCutoff
  exact hf.mul_left

theorem support_applyInnerSlabCutoff_subset_timeClosedBall
    (r R : Real) (hr : 0 < r) (hrR : r < R)
    (f : WaveSpaceTime → Complex) :
    Function.support (applyInnerSlabCutoff r R hr hrR f) ⊆
      {z : WaveSpaceTime | z.2 ∈ Metric.closedBall slabCenter R} := by
  intro z hz
  change ((slabBump r R hr hrR z.2 : Real) : Complex) * f z ≠ 0 at hz
  have hb : (slabBump r R hr hrR : Real → Real) z.2 ≠ 0 := by
    intro hzero
    apply hz
    simp [hzero]
  change dist z.2 slabCenter ≤ R
  by_contra hnot
  have hle : R ≤ dist z.2 slabCenter := le_of_lt (lt_of_not_ge hnot)
  exact hb ((slabBump r R hr hrR).zero_of_le_dist hle)

theorem support_applyInnerSlabCutoff_subset_innerSlab
    (r R : Real) (hr : 0 < r) (hrR : r < R) (hR : R < 1)
    (f : WaveSpaceTime → Complex) :
    Function.support (applyInnerSlabCutoff r R hr hrR f) ⊆
      {z : WaveSpaceTime | z.2 ∈ Ioo (1 / 2 : Real) (5 / 2 : Real)} := by
  intro z hz
  change ((slabBump r R hr hrR z.2 : Real) : Complex) * f z ≠ 0 at hz
  have hb : (slabBump r R hr hrR : Real → Real) z.2 ≠ 0 := by
    intro hzero
    apply hz
    simp [hzero]
  have hdist : dist z.2 slabCenter < R := by
    by_contra hnot
    have hle : R ≤ dist z.2 slabCenter := le_of_not_gt hnot
    have hzero := (slabBump r R hr hrR).zero_of_le_dist hle
    exact hb hzero
  have habs : |z.2 - slabCenter| < 1 := by
    rw [Real.dist_eq] at hdist
    exact lt_of_lt_of_le hdist hR.le
  rw [abs_lt] at habs
  constructor <;> dsimp [slabCenter] at habs ⊢ <;> linarith

theorem timeClosedBall_subset_innerSlab {r : Real} (hr : r < 1) :
    {z : WaveSpaceTime | z.2 ∈ Metric.closedBall slabCenter r} ⊆
      {z : WaveSpaceTime | z.2 ∈ Ioo (1 / 2 : Real) (5 / 2 : Real)} := by
  intro z hz
  change dist z.2 slabCenter ≤ r at hz
  have hdist : dist z.2 slabCenter < 1 := lt_of_le_of_lt hz hr
  rw [Real.dist_eq, abs_lt] at hdist
  constructor <;> dsimp [slabCenter] at hdist ⊢ <;> linarith

theorem exists_small_slab_width
    (m : ENNReal) (hm : m ≠ (⊤ : ENNReal)) {δ : Real} (hδ : 0 < δ) :
    ∃ η : Real, 0 < η ∧ η < 1 / 2 ∧
      m * ENNReal.ofReal (2 * η) ≤ ENNReal.ofReal δ := by
  let M : Real := m.toReal
  let η : Real := min (1 / 4) (δ / (4 * (M + 1)))
  have hM : 0 ≤ M := by
    exact ENNReal.toReal_nonneg
  have hMone : 0 < M + 1 := by linarith
  have hηpos : 0 < η := by
    dsimp [η]
    positivity
  have hηhalf : η < 1 / 2 := by
    calc
      η ≤ 1 / 4 := min_le_left _ _
      _ < 1 / 2 := by norm_num
  refine ⟨η, hηpos, hηhalf, ?_⟩
  have hm_eq : m = ENNReal.ofReal M := by
    rw [ENNReal.ofReal_toReal hm]
  rw [hm_eq, ← ENNReal.ofReal_mul (by positivity : 0 ≤ M)]
  apply ENNReal.ofReal_le_ofReal
  have hηbound : η ≤ δ / (4 * (M + 1)) := min_le_right _ _
  have hden : 0 < 4 * (M + 1) := by positivity
  have hmul : (4 * (M + 1)) * η ≤ δ := by
    simpa [mul_comm] using (le_div_iff₀ hden).mp hηbound
  have hcomp : M * (2 * η) ≤ (4 * (M + 1)) * η := by
    nlinarith [mul_nonneg (show 0 ≤ 2 * M + 4 by linarith) hηpos.le]
  exact hcomp.trans hmul

noncomputable def slabBoundaryTime (η : Real) : Set Real :=
  Icc (1 / 2 : Real) (1 / 2 + η) ∪ Icc (5 / 2 - η) (5 / 2 : Real)

noncomputable def slabBoundary (B : Set (Euclidean 2)) (η : Real) :
    Set WaveSpaceTime := B ×ˢ slabBoundaryTime η

noncomputable def outsideTimeSlab : Set WaveSpaceTime :=
  {z : WaveSpaceTime | z.2 ∉ lightRayTimeInterval}

theorem slabBoundaryTime_subset_timeInterval {η : Real} (hη : 0 ≤ η) (hηhalf : η ≤ 1 / 2) :
    slabBoundaryTime η ⊆ lightRayTimeInterval := by
  intro t ht
  unfold slabBoundaryTime at ht
  unfold lightRayTimeInterval
  rcases ht with ht | ht
  · rcases ht with ⟨htlo, hthi⟩
    exact ⟨htlo, by linarith⟩
  · rcases ht with ⟨htlo, hthi⟩
    exact ⟨by linarith, hthi⟩

theorem measurableSet_outsideTimeSlab : MeasurableSet outsideTimeSlab := by
  unfold outsideTimeSlab
  change MeasurableSet (Prod.snd ⁻¹' lightRayTimeIntervalᶜ)
  exact measurableSet_Icc.compl.preimage measurable_snd

theorem measurableSet_slabBoundaryTime (η : Real) :
    MeasurableSet (slabBoundaryTime η) := by
  unfold slabBoundaryTime
  exact measurableSet_Icc.union measurableSet_Icc

theorem volume_slabBoundaryTime_le (η : Real) (hη : 0 ≤ η) :
    volume (slabBoundaryTime η) ≤ ENNReal.ofReal (2 * η) := by
  unfold slabBoundaryTime
  calc
    volume (Icc (1 / 2 : Real) (1 / 2 + η) ∪ Icc (5 / 2 - η) (5 / 2 : Real))
        ≤ volume (Icc (1 / 2 : Real) (1 / 2 + η)) +
            volume (Icc (5 / 2 - η) (5 / 2 : Real)) := measure_union_le _ _
    _ = ENNReal.ofReal (2 * η) := by
      rw [Real.volume_Icc, Real.volume_Icc]
      rw [show (1 / 2 + η) - 1 / 2 = η by ring,
        show 5 / 2 - (5 / 2 - η) = η by ring]
      rw [← ENNReal.ofReal_add hη hη]
      congr 1
      ring

theorem measurableSet_slabBoundary (B : Set (Euclidean 2)) (η : Real)
    (hB : MeasurableSet B) : MeasurableSet (slabBoundary B η) := by
  unfold slabBoundary
  exact hB.prod (measurableSet_slabBoundaryTime η)

theorem volume_slabBoundary_le (B : Set (Euclidean 2)) (η : Real)
    (hB : MeasurableSet B) (hη : 0 ≤ η) :
    volume (slabBoundary B η) ≤ volume B * ENNReal.ofReal (2 * η) := by
  unfold slabBoundary
  calc
    volume (B ×ˢ slabBoundaryTime η) = volume B * volume (slabBoundaryTime η) := by
      rw [Measure.volume_eq_prod]
      simp [Measure.prod_apply, hB, measurableSet_slabBoundaryTime]
    _ ≤ volume B * ENNReal.ofReal (2 * η) := by
      rw [mul_comm (volume B) (volume (slabBoundaryTime η)),
        mul_comm (volume B) (ENNReal.ofReal (2 * η))]
      exact mul_le_mul_left (volume_slabBoundaryTime_le η hη) _

theorem exists_slabBoundary_eLpNorm_small
    (B : Set (Euclidean 2)) (hB : MeasurableSet B)
    (hBfinite : volume B ≠ (⊤ : ENNReal))
    (f : WaveSpaceTime → Complex) (hf : MemLp f 2 volume)
    {ε : Real} (hε : 0 < ε) :
    ∃ η : Real, 0 < η ∧ η < 1 / 2 ∧
      eLpNorm ((slabBoundary B η).indicator f) 2 volume ≤ ENNReal.ofReal ε := by
  obtain ⟨δ, hδpos, hδ⟩ :=
    hf.eLpNorm_indicator_le (by norm_num : 1 ≤ (2 : ENNReal)) (by norm_num) hε
  obtain ⟨η, hηpos, hηhalf, hηvol⟩ :=
    exists_small_slab_width (volume B) hBfinite hδpos
  refine ⟨η, hηpos, hηhalf, ?_⟩
  apply hδ
  · exact measurableSet_slabBoundary B η hB
  · exact (volume_slabBoundary_le B η hB hηpos.le).trans hηvol

theorem exists_spatial_closedBall_support
    (f : WaveSpaceTime → Complex) (hf : HasCompactSupport f) :
    ∃ R : Real,
      Function.support f ⊆ {z : WaveSpaceTime | z.1 ∈ Metric.closedBall 0 R} := by
  obtain ⟨R, hR⟩ := hf.isCompact.isBounded.subset_closedBall (0 : WaveSpaceTime)
  refine ⟨R, ?_⟩
  intro z hz
  have hz' : z ∈ tsupport f := subset_tsupport f hz
  have hzR := hR hz'
  change z.1 ∈ Metric.closedBall 0 R
  rw [Metric.mem_closedBall, dist_zero_right] at hzR ⊢
  exact (norm_fst_le z).trans hzR

theorem innerRadius_pos {η : Real} (hη : 0 < η) (hηhalf : η < 1 / 2) :
    0 < 1 - η := by linarith

theorem innerRadius_lt_outerRadius {η : Real} (hη : 0 < η) :
    1 - η < 1 - η / 2 := by linarith

private theorem outerRadius_lt_one {η : Real} (hη : 0 < η) :
    1 - η / 2 < 1 := by linarith

private theorem outerRadius_pos {η : Real} (hηhalf : η < 1 / 2) :
    0 < 1 - η / 2 := by linarith

theorem slabBump_eq_one_on_innerTimeInterval
    {η : Real} (hη : 0 < η) (hηhalf : η < 1 / 2) {t : Real}
    (ht : t ∈ Icc (1 / 2 + η) (5 / 2 - η)) :
    slabBump (1 - η) (1 - η / 2) (innerRadius_pos hη hηhalf)
      (innerRadius_lt_outerRadius hη) t = 1 := by
  apply (slabBump (1 - η) (1 - η / 2) (innerRadius_pos hη hηhalf)
    (innerRadius_lt_outerRadius hη)).one_of_mem_closedBall
  change dist t slabCenter ≤ 1 - η
  rw [Real.dist_eq, abs_le]
  constructor <;> dsimp [slabCenter] <;> rcases ht with ⟨htlo, hthi⟩ <;> linarith

theorem slabBump_eq_zero_outside_timeInterval
    {η : Real} (hη : 0 < η) (hηhalf : η < 1 / 2) {t : Real}
    (ht : t ∉ lightRayTimeInterval) :
    slabBump (1 - η) (1 - η / 2) (innerRadius_pos hη hηhalf)
      (innerRadius_lt_outerRadius hη) t = 0 := by
  apply (slabBump (1 - η) (1 - η / 2) (innerRadius_pos hη hηhalf)
    (innerRadius_lt_outerRadius hη)).zero_of_le_dist
  change 1 - η / 2 ≤ dist t slabCenter
  unfold lightRayTimeInterval at ht
  by_cases htlo : t < 1 / 2
  · rw [Real.dist_eq, abs_of_nonpos]
    · apply (outerRadius_lt_one hη).le.trans
      dsimp [slabCenter]
      linarith
    · dsimp [slabCenter]
      linarith
  · have htlo' : 1 / 2 ≤ t := le_of_not_gt htlo
    have hthi : 5 / 2 < t := by
      exact lt_of_not_ge fun hle => ht ⟨htlo', hle⟩
    rw [Real.dist_eq, abs_of_nonneg]
    · apply (outerRadius_lt_one hη).le.trans
      dsimp [slabCenter]
      linarith
    · dsimp [slabCenter]
      linarith

theorem mem_slabBoundaryTime_of_mem_timeInterval_bump_ne_one
    {η : Real} (hη : 0 < η) (hηhalf : η < 1 / 2) {t : Real}
    (ht : t ∈ lightRayTimeInterval)
    (hb : slabBump (1 - η) (1 - η / 2) (innerRadius_pos hη hηhalf)
      (innerRadius_lt_outerRadius hη) t ≠ 1) :
    t ∈ slabBoundaryTime η := by
  unfold lightRayTimeInterval at ht
  rcases ht with ⟨htlo, hthi⟩
  have hnotinner : t ∉ Icc (1 / 2 + η) (5 / 2 - η) := by
    intro hinner
    exact hb (slabBump_eq_one_on_innerTimeInterval hη hηhalf hinner)
  unfold slabBoundaryTime
  by_cases htc : t ≤ slabCenter
  · left
    refine ⟨htlo, ?_⟩
    have hright : t ≤ 5 / 2 - η := by
      dsimp [slabCenter] at htc
      linarith
    by_contra hnot
    exact hnotinner ⟨le_of_not_ge hnot, hright⟩
  · right
    refine ⟨?_, hthi⟩
    have hleft : 1 / 2 + η ≤ t := by
      dsimp [slabCenter] at htc
      linarith
    by_contra hnot
    exact hnotinner ⟨hleft, le_of_not_ge hnot⟩

theorem norm_sub_applyInnerSlabCutoff_le_indicators
    (B : Set (Euclidean 2))
    (u : WaveSpaceTime → Complex) (huB : Function.support u ⊆
      {z : WaveSpaceTime | z.1 ∈ B})
    {η : Real} (hη : 0 < η) (hηhalf : η < 1 / 2) (z : WaveSpaceTime) :
    ‖u z - applyInnerSlabCutoff (1 - η) (1 - η / 2)
        (innerRadius_pos hη hηhalf) (innerRadius_lt_outerRadius hη) u z‖ ≤
      ‖outsideTimeSlab.indicator u z + (slabBoundary B η).indicator u z‖ := by
  let b := slabBump (1 - η) (1 - η / 2) (innerRadius_pos hη hηhalf)
    (innerRadius_lt_outerRadius hη)
  change ‖u z - ((b z.2 : Real) : Complex) * u z‖ ≤
    ‖outsideTimeSlab.indicator u z + (slabBoundary B η).indicator u z‖
  by_cases hzout : z ∈ outsideTimeSlab
  · have hzt : z.2 ∉ lightRayTimeInterval := hzout
    have hbzero : b z.2 = 0 := slabBump_eq_zero_outside_timeInterval hη hηhalf hzt
    have hzboundary : z ∉ slabBoundary B η := by
      intro hz
      have htime : z.2 ∈ slabBoundaryTime η := hz.2
      exact hzt (slabBoundaryTime_subset_timeInterval hη.le hηhalf.le htime)
    rw [Set.indicator_of_mem hzout, Set.indicator_of_notMem hzboundary]
    simp [hbzero]
  · have hzt : z.2 ∈ lightRayTimeInterval := by
      simpa only [outsideTimeSlab, Set.mem_setOf_eq, not_not] using hzout
    by_cases hzero : u z = 0
    · simp [hzero]
    · have hzB : z.1 ∈ B := huB (Function.mem_support.mpr hzero)
      by_cases hzboundary : z ∈ slabBoundary B η
      · rw [Set.indicator_of_notMem hzout, Set.indicator_of_mem hzboundary]
        simp only [zero_add]
        have hbnonneg : 0 ≤ b z.2 := b.nonneg' _
        have hble : b z.2 ≤ 1 := b.le_one
        rw [show u z - ((b z.2 : Real) : Complex) * u z =
          (1 - ((b z.2 : Real) : Complex)) * u z by ring,
          norm_mul]
        have hcoef : ‖(1 : Complex) - ((b z.2 : Real) : Complex)‖ ≤ 1 := by
          have hrewrite : (1 : Complex) - ((b z.2 : Real) : Complex) =
              ((1 - b z.2 : Real) : Complex) := by norm_cast
          rw [hrewrite, Complex.norm_real, Real.norm_eq_abs,
            abs_of_nonneg (sub_nonneg.mpr hble)]
          linarith
        calc
          ‖1 - ((b z.2 : Real) : Complex)‖ * ‖u z‖ ≤ 1 * ‖u z‖ :=
            mul_le_mul_of_nonneg_right hcoef (norm_nonneg _)
          _ = ‖u z‖ := one_mul _
      · have hbone : b z.2 = 1 := by
          by_contra hb
          have htime := mem_slabBoundaryTime_of_mem_timeInterval_bump_ne_one hη hηhalf hzt hb
          exact hzboundary ⟨hzB, htime⟩
        rw [Set.indicator_of_notMem hzout, Set.indicator_of_notMem hzboundary]
        simp [hbone]

