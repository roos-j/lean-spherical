noncomputable section

/-- The canonical bandlimited dyadic coefficient is exactly a fixed multiple
of a geometric sequence.  This is the interface needed to feed it into the
finite narrow/broad tail reducer. -/
theorem scratch_canonicalBandlimitedDyadicCoefficient_eq_geometric
    (N : Nat) (c r : Real) (j : Nat) :
    canonicalBandlimitedDyadicCoefficient N c r j =
      (((2 : Real) ^ N / c) * (2 / r) ^ 2) *
        ((((2 : Real)⁻¹) ^ (N - 2)) ^ j) := by
  unfold canonicalBandlimitedDyadicCoefficient
  rw [← pow_mul, Nat.mul_comm, inv_pow, inv_pow, ← pow_mul]

/-- The finite canonical bandlimited dyadic expansion separates into its
unmodified narrow block and a uniformly bounded broad block. -/
theorem scratch_sum_range_canonicalBandlimitedDyadic_narrow_broad_le
    (M k0 N : Nat) (c r B : Real)
    (hN : 2 < N) (hc : 0 < c) (hr : 0 < r) (hB : 0 ≤ B)
    (L : Nat → Real)
    (hbroad : ∀ j, k0 ≤ j → L j ≤ B) :
    (∑ j ∈ Finset.range M,
