      intDyadicLowpassMultiplier C.cutoff 0 xi *
        scratch_canonicalBandlimitedTubeMultiplier rho hrho xi +
      ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho),
        intDyadicBandpassMultiplier C.cutoff ((0 : Int) + i) xi *
          scratch_canonicalBandlimitedTubeMultiplier rho hrho xi := by
  apply scratch_bandlimitedMultiplier_eq_lowpass_add_finiteBands C
    (scratch_canonicalBandlimitedTubeMultiplier rho hrho) 0
    (kakeyaRadialBandLevel rho)
  intro z hz
  rw [Metric.mem_closedBall, dist_zero_right]
  have hsupport := support_scratch_canonicalBandlimitedTubeMultiplier_subset hrho hz
  rw [Metric.mem_closedBall, dist_zero_right] at hsupport
  calc
    ‖z‖ ≤ 4 / rho := hsupport
    _ ≤ (2 : Real) ^ (kakeyaRadialBandLevel rho) :=
      four_div_rho_le_two_pow_kakeyaRadialBandLevel hrho
    _ = (2 : Real) ^ ((0 : Int) +
        kakeyaRadialBandLevel rho) := by norm_num

/-- The canonical positive physical core is exactly the squared-modulus
bandlimited core used by the broad-width artifact. -/
theorem scratch_canonicalPositiveCore_eq_normSqBandlimitedCore :
    canonicalPositiveCore =
      scratch_normSqSchwartz
        (FourierTransform.fourierInv canonicalFrequencyBump) := by
  ext u
  rw [canonicalPositiveCore_apply_eq_normSq,
    scratch_normSqSchwartz_apply]

theorem scratch_canonicalPositiveCore_re_eq_positiveBandlimitedCore
    (u : Euclidean 2) :
    (canonicalPositiveCore u).re =
      scratch_positiveSchwartzCore
        (FourierTransform.fourierInv canonicalFrequencyBump) u := by
  rw [canonicalPositiveCore_apply_eq_normSq,
    scratch_positiveSchwartzCore_apply]
  simp

theorem scratch_canonicalFrequencyBump_hasCompactSupport :
    HasCompactSupport (canonicalFrequencyBump : Euclidean 2 → Complex) := by
  apply HasCompactSupport.of_support_subset_isCompact
    (isCompact_closedBall (0 : Euclidean 2) 2)
  intro x hx
  rw [Metric.mem_closedBall, dist_zero_right]
  by_contra hnot
  have htwo : 2 ≤ ‖x‖ := (lt_of_not_ge hnot).le
  exact (Function.mem_support.mp hx)
    (canonicalFrequencyBump_zero_of_two_le_norm x htwo)

/-- The entire broad tail can use the existing positive-bandlimited
broad-width reduction with the canonical frequency bump.  In particular it
does not require a signed full-band estimate. -/
theorem scratch_exists_broadWidth_envelope_canonicalPositiveCore
    (K : Nat) {rho : Real} (hrho : (1 / 2 : Real) ≤ rho)
    (omega y x : Euclidean 2) (t : Real)
    (homega : ‖omega‖ ≤ 1) (ht : t ∈ lightRayTimeInterval) :
    ∃ A : Real, 0 ≤ A ∧
      HasCompactSupport
        (FourierTransform.fourier canonicalPositiveCore :
          Euclidean 2 → Complex) ∧
      scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
        rho omega y (x, t) ≤
          ((6 : Real) ^ K * A) * lightRayKernel rho K 0 x (y, 0) := by
  obtain ⟨A, hA, hcompact, hpoint⟩ :=
    scratch_exists_broadWidth_envelope_positiveBandlimitedCore
      canonicalFrequencyBump scratch_canonicalFrequencyBump_hasCompactSupport
      K hrho omega y x t homega ht
  refine ⟨A, hA, ?_, ?_⟩
  · rw [scratch_canonicalPositiveCore_eq_normSqBandlimitedCore]
    exact hcompact
  · simpa only [scratch_canonicalPositiveCore_re_eq_positiveBandlimitedCore] using hpoint

/-- On every narrow canonical tube width, the number of required radial
frequency bands has the same logarithmic size as the original width
`delta`.  This combines the compact multiplier support radius `4/rho`, the
canonical scale relation, and the fixed-multiple log transfer. -/
theorem scratch_exists_canonicalNarrowRadialBandCount_log_delta_bound
    {delta r : Real} (hdelta : 0 < delta) (hdeltaOne : delta ≤ 1)
    (hr : 0 < r) (j : Nat)
    (hrhoOne : delta / canonicalBandlimitedDyadicScale r j ≤ 1) :
    ∃ A : Real, 0 < A ∧
      ((kakeyaRadialBandLevel
        (delta / canonicalBandlimitedDyadicScale r j) : Real) + 1) ≤
        A * (1 + |Real.log delta|) := by
  let s : Real := canonicalBandlimitedDyadicScale r j
  have hs : 0 < s := canonicalBandlimitedDyadicScale_pos hr j
  have hscale : s ≤ r / 2 := canonicalBandlimitedDyadicScale_le_half_radius hr j
  have htwos : 2 * s ≤ r := by linarith
  have hratio : 2 / r ≤ 1 / s := by
    exact (div_le_div_iff₀ hr hs).2 (by simpa only [one_mul] using htwos)
  have hbelow : (2 / r) * delta ≤ delta / s := by
    calc
      (2 / r) * delta ≤ (1 / s) * delta :=
        mul_le_mul_of_nonneg_right hratio hdelta.le
      _ = delta / s := by ring
  have hrho : 0 < delta / s := div_pos hdelta hs
  obtain ⟨A0, hA0, hA0bound⟩ :=
    exists_kakeyaRadialBandLevel_log_bound
  let c : Real := 2 / r
  have hc : 0 < c := by dsimp [c]; positivity
  have hlog : 1 + |Real.log (delta / s)| ≤
      (1 + |Real.log c|) * (1 + |Real.log delta|) := by
    exact one_add_abs_log_width_le_of_mul_le
      hc hdelta hdeltaOne hrho hrhoOne (by simpa only [c] using hbelow)
  refine ⟨A0 * (1 + |Real.log c|),
    mul_pos hA0 (by positivity), ?_⟩
  calc
    (kakeyaRadialBandLevel (delta / s) : Real) + 1 ≤
        A0 * (1 + |Real.log (delta / s)|) := hA0bound _ hrho hrhoOne
    _ ≤ A0 * ((1 + |Real.log c|) * (1 + |Real.log delta|)) :=
      mul_le_mul_of_nonneg_left hlog hA0.le
    _ = (A0 * (1 + |Real.log c|)) * (1 + |Real.log delta|) := by ring

/-- The preceding count is also bounded by the final `log^(3/2)` loss.  This
is useful when a finite radial-band estimate is inserted into the endpoint
envelope with the target exponent already fixed. -/
theorem scratch_exists_canonicalNarrowRadialBandCount_log_threeHalves_bound
    {delta r : Real} (hdelta : 0 < delta) (hdeltaOne : delta ≤ 1)
    (hr : 0 < r) (j : Nat)
    (hrhoOne : delta / canonicalBandlimitedDyadicScale r j ≤ 1) :
    ∃ A : Real, 0 < A ∧
      ((kakeyaRadialBandLevel
        (delta / canonicalBandlimitedDyadicScale r j) : Real) + 1) ≤
        A * (1 + |Real.log delta|) ^ (3 / 2 : Real) := by
  obtain ⟨A, hA, hbound⟩ :=
    scratch_exists_canonicalNarrowRadialBandCount_log_delta_bound
      hdelta hdeltaOne hr j hrhoOne
  refine ⟨A, hA, ?_⟩
  have hbase : 1 ≤ 1 + |Real.log delta| := by linarith [abs_nonneg (Real.log delta)]
  have hpow : 1 + |Real.log delta| ≤
      (1 + |Real.log delta|) ^ (3 / 2 : Real) := by
    exact Real.self_le_rpow_of_one_le hbase (by norm_num)
  calc
    (kakeyaRadialBandLevel
        (delta / canonicalBandlimitedDyadicScale r j) : Real) + 1 ≤
        A * (1 + |Real.log delta|) := hbound
    _ ≤ A * (1 + |Real.log delta|) ^ (3 / 2 : Real) :=
      mul_le_mul_of_nonneg_left hpow hA.le

end

