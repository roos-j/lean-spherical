  have hpres : MeasurePreserving e volume volume := by
    change MeasurePreserving
      (WithLp.toLp 2 : WaveSpaceTime -> JointWaveSpaceTime) volume volume
    exact WithLp.volume_preserving_toLp (Euclidean 2) Real
  let h : JointWaveSpaceTime -> Complex := fun v => g (e.symm v)
  have hmem : MemLp h 2 volume := by
    simpa only [h, Function.comp_def] using
      hg.comp_measurePreserving (hpres.symm e)
  obtain ⟨G, hG⟩ :=
    (SchwartzMap.denseRange_toLpCLM (E := JointWaveSpaceTime) (F := Complex)
      (p := (2 : ENNReal)) ENNReal.ofNat_ne_top).exists_dist_lt
      (hmem.toLp h) hepsilon
  have hGmem : MemLp (G : JointWaveSpaceTime -> Complex) 2 volume :=
    G.memLp 2 volume
  have hsubmem : MemLp (h - (G : JointWaveSpaceTime -> Complex)) 2 volume :=
    hmem.sub hGmem
  have hGtoLp : hGmem.toLp (G : JointWaveSpaceTime -> Complex) =
      G.toLp 2 volume := by
    rfl
  have hdist :
      (eLpNorm (h - (G : JointWaveSpaceTime -> Complex)) 2 volume).toReal <
        epsilon := by
    calc
      (eLpNorm (h - (G : JointWaveSpaceTime -> Complex)) 2 volume).toReal =
          ‖hsubmem.toLp (h - (G : JointWaveSpaceTime -> Complex))‖ :=
        (Lp.norm_toLp _ _).symm
      _ = ‖hmem.toLp h - hGmem.toLp (G : JointWaveSpaceTime -> Complex)‖ := by
        rw [MemLp.toLp_sub hmem hGmem]
      _ = dist (hmem.toLp h) (hGmem.toLp (G : JointWaveSpaceTime -> Complex)) :=
        (dist_eq_norm_sub _ _).symm
      _ < epsilon := by
        rw [hGtoLp]
        simpa only [SchwartzMap.toLpCLM_apply] using hG
  have hsubtop : eLpNorm (h - (G : JointWaveSpaceTime -> Complex)) 2 volume ≠ ⊤ :=
    hsubmem.eLpNorm_ne_top
  have hsubbound :
      eLpNorm (h - (G : JointWaveSpaceTime -> Complex)) 2 volume <
        ENNReal.ofReal epsilon := by
    apply (ENNReal.toReal_lt_toReal hsubtop ENNReal.ofReal_ne_top).mp
    simpa only [ENNReal.toReal_ofReal hepsilon.le] using hdist
  refine ⟨G, ?_⟩
  have hraw :
      g - jointSchwartzRaw G =
        Function.comp (h - (G : JointWaveSpaceTime -> Complex)) e := by
    funext z
    change g z - G (WithLp.toLp 2 z) =
      g (e.symm (e z)) - G (e z)
    rw [e.symm_apply_apply]
    rfl
  rw [hraw, eLpNorm_comp_measurePreserving hsubmem.aestronglyMeasurable hpres]
  exact hsubbound

/-- Summable `L²` approximation errors give the a.e. convergence required by
the literal Fatou lift.  This is the standard fast-subsequence conversion,
recorded separately so that a finite-tensor density theorem need only supply
geometrically summable errors. -/
theorem scratch_ae_tendsto_of_tsum_eLpNorm_sub_ne_top
    (g : WaveSpaceTime -> Complex) (hg : MemLp g 2 volume)
    (core : Nat -> WaveSpaceTime -> Complex)
    (hcoreMem : forall n, MemLp (core n) 2 volume)
    (hsum : ∑' n, eLpNorm (g - core n) 2 volume ≠ ⊤) :
    ∀ᵐ z : WaveSpaceTime ∂volume,
      Tendsto (fun n => core n z) atTop (nhds (g z)) := by
  have hmeas (n : Nat) : AEStronglyMeasurable (g - core n) volume :=
    (hg.sub (hcoreMem n)).aestronglyMeasurable
  have hpoint : ∀ᵐ z : WaveSpaceTime ∂volume,
      Summable (fun n => norm ((g - core n) z)) :=
    summable_norm_of_tsum_eLpNorm_ne_top (by norm_num) hmeas hsum
  filter_upwards [hpoint] with z hz
  apply tendsto_iff_norm_sub_tendsto_zero.mpr
  simpa only [Pi.sub_apply, norm_sub_rev] using hz.tendsto_atTop_zero

theorem scratch_geometric_ennreal_error (n : Nat) :
    ENNReal.ofReal ((2 : Real)⁻¹ ^ n) = ((2 : ENNReal)⁻¹) ^ n := by
  rw [ENNReal.ofReal_pow (by positivity)]
  congr 1
  rw [ENNReal.ofReal_inv_of_pos (by norm_num)]
  norm_num

/-- A geometric `L²` error bound is summable, hence can be fed directly to
`scratch_ae_tendsto_of_tsum_eLpNorm_sub_ne_top`. -/
theorem scratch_tsum_eLpNorm_sub_ne_top_of_geometric
    (g : WaveSpaceTime -> Complex)
    (core : Nat -> WaveSpaceTime -> Complex) (A : ENNReal) (hAtop : A ≠ ⊤)
    (hbound : forall n,
      eLpNorm (g - core n) 2 volume <=
        A * ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) :
    ∑' n, eLpNorm (g - core n) 2 volume ≠ ⊤ := by
  apply ne_top_of_le_ne_top ?_ (ENNReal.tsum_le_tsum hbound)
  rw [show (fun n => A * ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) =
      fun n => A * ((2 : ENNReal)⁻¹) ^ n by
        funext n
        rw [scratch_geometric_ennreal_error], ENNReal.tsum_mul_left,
      ENNReal.tsum_geometric]
  exact ENNReal.mul_ne_top hAtop (by norm_num)

theorem scratch_ae_tendsto_of_geometric_eLpNorm_sub
    (g : WaveSpaceTime -> Complex) (hg : MemLp g 2 volume)
    (core : Nat -> WaveSpaceTime -> Complex)
    (hcoreMem : forall n, MemLp (core n) 2 volume)
    (A : ENNReal) (hAtop : A ≠ ⊤)
    (hbound : forall n,
      eLpNorm (g - core n) 2 volume <=
        A * ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) :
    ∀ᵐ z : WaveSpaceTime ∂volume,
      Tendsto (fun n => core n z) atTop (nhds (g z)) := by
  apply scratch_ae_tendsto_of_tsum_eLpNorm_sub_ne_top g hg core hcoreMem
  exact scratch_tsum_eLpNorm_sub_ne_top_of_geometric g core A hAtop hbound

/-- The joint-Schwartz density theorem can be selected with geometric error,
which is the exact input needed for the preceding a.e.-convergence lemma. -/
theorem scratch_exists_fast_jointSchwartzRaw_approximation
    (g : WaveSpaceTime -> Complex) (hg : MemLp g 2 volume) :
    exists psi : Nat -> SchwartzMap JointWaveSpaceTime Complex, forall n,
      eLpNorm (g - jointSchwartzRaw (psi n)) 2 volume <=
        ENNReal.ofReal ((2 : Real)⁻¹ ^ n) := by
  choose psi hpsi using fun n : Nat =>
    scratch_exists_jointSchwartzRaw_eLpNorm_sub_lt g hg
      (show 0 < ((2 : Real)⁻¹ ^ n) by positivity)
  exact ⟨psi, fun n => (hpsi n).le⟩

theorem scratch_ae_tendsto_jointSchwartzRaw_of_fast_approximation
    (g : WaveSpaceTime -> Complex) (hg : MemLp g 2 volume)
    (psi : Nat -> SchwartzMap JointWaveSpaceTime Complex)
    (hpsi : forall n,
      eLpNorm (g - jointSchwartzRaw (psi n)) 2 volume <=
        ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) :
    ∀ᵐ z : WaveSpaceTime ∂volume,
      Tendsto (fun n => jointSchwartzRaw (psi n) z) atTop (nhds (g z)) := by
  refine scratch_ae_tendsto_of_geometric_eLpNorm_sub g hg
    (fun n => jointSchwartzRaw (psi n))
    (fun n => scratch_jointSchwartzRaw_memLp_two (psi n)) 1 (by norm_num) ?_
  intro n
  simpa only [one_mul] using hpsi n

/-- For nonzero `L²` data, joint Schwartz approximation may be normalized at
the scale of the input norm.  This is the useful form for a homogeneous
strong estimate. -/
theorem scratch_exists_fast_jointSchwartzRaw_approximation_scaled
    (g : WaveSpaceTime -> Complex) (hg : MemLp g 2 volume)
    (hgnonzero : eLpNorm g 2 volume ≠ 0) :
    exists psi : Nat -> SchwartzMap JointWaveSpaceTime Complex, forall n,
      eLpNorm (g - jointSchwartzRaw (psi n)) 2 volume <=
        eLpNorm g 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n) := by
  let R : Real := (eLpNorm g 2 volume).toReal
  have hRpos : 0 < R := ENNReal.toReal_pos hgnonzero hg.eLpNorm_ne_top
  choose psi hpsi using fun n : Nat =>
    scratch_exists_jointSchwartzRaw_eLpNorm_sub_lt g hg
      (show 0 < R * ((2 : Real)⁻¹ ^ n) by positivity)
  refine ⟨psi, ?_⟩
  intro n
  calc
    eLpNorm (g - jointSchwartzRaw (psi n)) 2 volume <=
        ENNReal.ofReal (R * ((2 : Real)⁻¹ ^ n)) := (hpsi n).le
    _ = ENNReal.ofReal R * ENNReal.ofReal ((2 : Real)⁻¹ ^ n) :=
      ENNReal.ofReal_mul hRpos.le
    _ = eLpNorm g 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n) := by
      rw [ENNReal.ofReal_toReal hg.eLpNorm_ne_top]

theorem scratch_core_eLpNorm_le_two_of_scaled_approximation
    (g : WaveSpaceTime -> Complex) (hg : MemLp g 2 volume)
    (core : Nat -> WaveSpaceTime -> Complex)
    (hcoreMem : forall n, MemLp (core n) 2 volume)
    (hcore : forall n,
      eLpNorm (g - core n) 2 volume <=
        eLpNorm g 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) (n : Nat) :
    eLpNorm (core n) 2 volume <= 2 * eLpNorm g 2 volume := by
  have hsubMem : MemLp (g - core n) 2 volume :=
    hg.sub (hcoreMem n)
  have hgeom : ENNReal.ofReal ((2 : Real)⁻¹ ^ n) <= 1 := by
    rw [← ENNReal.ofReal_one]
    apply ENNReal.ofReal_le_ofReal
    exact pow_le_one₀ (by positivity) (by norm_num)
  calc
    eLpNorm (core n) 2 volume = eLpNorm (g - (g - core n)) 2 volume := by
      congr 1
      funext z
      simp
    _ <= eLpNorm g 2 volume + eLpNorm (g - core n) 2 volume :=
      eLpNorm_sub_le hg.aestronglyMeasurable hsubMem.aestronglyMeasurable (by norm_num)
    _ <= eLpNorm g 2 volume +
        eLpNorm g 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n) :=
      add_le_add_right (hcore n) _
    _ <= eLpNorm g 2 volume + eLpNorm g 2 volume * 1 :=
      add_le_add_right (mul_le_mul_right hgeom (eLpNorm g 2 volume)) _
    _ = 2 * eLpNorm g 2 volume := by ring

theorem scratch_jointSchwartzRaw_eLpNorm_le_two_of_scaled_approximation
    (g : WaveSpaceTime -> Complex) (hg : MemLp g 2 volume)
    (psi : Nat -> SchwartzMap JointWaveSpaceTime Complex)
    (hpsi : forall n,
      eLpNorm (g - jointSchwartzRaw (psi n)) 2 volume <=
        eLpNorm g 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) (n : Nat) :
    eLpNorm (jointSchwartzRaw (psi n)) 2 volume <=
      2 * eLpNorm g 2 volume := by
  have hcoreMem : MemLp (jointSchwartzRaw (psi n)) 2 volume :=
    scratch_jointSchwartzRaw_memLp_two (psi n)
  have hsubMem : MemLp (g - jointSchwartzRaw (psi n)) 2 volume :=
    hg.sub hcoreMem
  have hgeom : ENNReal.ofReal ((2 : Real)⁻¹ ^ n) <= 1 := by
    rw [← ENNReal.ofReal_one]
    apply ENNReal.ofReal_le_ofReal
    exact pow_le_one₀ (by positivity) (by norm_num)
  calc
    eLpNorm (jointSchwartzRaw (psi n)) 2 volume =
        eLpNorm (g - (g - jointSchwartzRaw (psi n))) 2 volume := by
      congr 1
      funext z
      simp
    _ <= eLpNorm g 2 volume +
        eLpNorm (g - jointSchwartzRaw (psi n)) 2 volume :=
      eLpNorm_sub_le hg.aestronglyMeasurable hsubMem.aestronglyMeasurable (by norm_num)
    _ <= eLpNorm g 2 volume +
        eLpNorm g 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n) :=
      add_le_add_right (hpsi n) _
    _ <= eLpNorm g 2 volume + eLpNorm g 2 volume * 1 :=
      add_le_add_right (mul_le_mul_right hgeom (eLpNorm g 2 volume)) _
    _ = 2 * eLpNorm g 2 volume := by ring

theorem scratch_ae_tendsto_jointSchwartzRaw_of_scaled_approximation
    (g : WaveSpaceTime -> Complex) (hg : MemLp g 2 volume)
    (psi : Nat -> SchwartzMap JointWaveSpaceTime Complex)
    (hpsi : forall n,
      eLpNorm (g - jointSchwartzRaw (psi n)) 2 volume <=
        eLpNorm g 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) :
    ∀ᵐ z : WaveSpaceTime ∂volume,
      Tendsto (fun n => jointSchwartzRaw (psi n) z) atTop (nhds (g z)) := by
  apply scratch_ae_tendsto_of_geometric_eLpNorm_sub g hg
    (fun n => jointSchwartzRaw (psi n))
    (fun n => scratch_jointSchwartzRaw_memLp_two (psi n))
    (eLpNorm g 2 volume) hg.eLpNorm_ne_top
  exact hpsi

/-- A literal pointwise Fatou principle for light-ray maxima.  No measurable
argmax is used: after fixing `y`, compact directional continuity picks one
maximizing direction for `g`, and ordinary Fatou is applied on the full
space-time slab at that one direction. -/
theorem scratch_lightRayMaximal_ofReal_le_liminf_of_ae_tendsto
    {delta : Real} (hdelta : 0 < delta) (N : Nat) (hN : 1 < N)
    (g : WaveSpaceTime -> Complex) (hg : MemLp g 2 volume)
    (core : Nat -> WaveSpaceTime -> Complex)
    (hcoreMem : forall n, MemLp (core n) 2 volume)
    (hcoreInt : forall n (omega y : Euclidean 2),
      Integrable (fun z : WaveSpaceTime =>
        lightRayKernel delta N omega y z * norm (core n z)) scratchLightRayMeasure)
    (hgInt : forall omega y : Euclidean 2,
      Integrable (fun z : WaveSpaceTime =>
        lightRayKernel delta N omega y z * norm (g z)) scratchLightRayMeasure)
    (hconv : ∀ᵐ z : WaveSpaceTime ∂volume,
      Tendsto (fun n => core n z) atTop (nhds (g z)))
    (y : Euclidean 2) :
    ENNReal.ofReal (lightRayMaximal delta N g y) <=
      atTop.liminf (fun n => ENNReal.ofReal
        (lightRayMaximal delta N (core n) y)) := by
  obtain ⟨omega, homega, hmax⟩ :=
    aux_exists_lightRayPointwiseMaximizer_of_continuity delta N g
      (aux_hasContinuousLightRayDirections_of_memLp hdelta N hN g hg) y
  have hconvSlab : ∀ᵐ z : WaveSpaceTime ∂scratchLightRayMeasure,
      Tendsto (fun n => core n z) atTop (nhds (g z)) :=
    (ae_mono scratchLightRayMeasure_le_volume) hconv
  have hlim : ∀ᵐ z : WaveSpaceTime ∂scratchLightRayMeasure,
      atTop.liminf (fun n => ENNReal.ofReal
        (lightRayKernel delta N omega y z * norm (core n z))) =
        ENNReal.ofReal (lightRayKernel delta N omega y z * norm (g z)) := by
    filter_upwards [hconvSlab] with z hz
    have hreal : Tendsto (fun n =>
        lightRayKernel delta N omega y z * norm (core n z)) atTop
        (nhds (lightRayKernel delta N omega y z * norm (g z))) :=
      tendsto_const_nhds.mul hz.norm
    exact (ENNReal.tendsto_ofReal hreal).liminf_eq
  have hlinfatou :
      (∫⁻ z : WaveSpaceTime, ENNReal.ofReal
        (lightRayKernel delta N omega y z * norm (g z))
        ∂scratchLightRayMeasure) <=
      atTop.liminf (fun n => ∫⁻ z : WaveSpaceTime, ENNReal.ofReal
        (lightRayKernel delta N omega y z * norm (core n z))
        ∂scratchLightRayMeasure) := by
    calc
      (∫⁻ z : WaveSpaceTime, ENNReal.ofReal
          (lightRayKernel delta N omega y z * norm (g z))
          ∂scratchLightRayMeasure) =
          ∫⁻ z : WaveSpaceTime, atTop.liminf (fun n => ENNReal.ofReal
            (lightRayKernel delta N omega y z * norm (core n z)))
            ∂scratchLightRayMeasure :=
        lintegral_congr_ae (hlim.mono fun z hz => hz.symm)
      _ <= atTop.liminf (fun n => ∫⁻ z : WaveSpaceTime, ENNReal.ofReal
          (lightRayKernel delta N omega y z * norm (core n z))
          ∂scratchLightRayMeasure) := by
        apply lintegral_liminf_le'
        intro n
        exact (hcoreInt n omega y).aestronglyMeasurable.aemeasurable.ennreal_ofReal
  have hlinG : ENNReal.ofReal (lightRayAverage delta N omega y g) =
      ∫⁻ z : WaveSpaceTime, ENNReal.ofReal
        (lightRayKernel delta N omega y z * norm (g z))
        ∂scratchLightRayMeasure := by
    calc
      ENNReal.ofReal (lightRayAverage delta N omega y g) =
          ENNReal.ofReal (∫ z : WaveSpaceTime,
            lightRayKernel delta N omega y z * norm (g z)
            ∂scratchLightRayMeasure) := by
        rw [scratch_integral_lightRayKernel_mul_norm_eq_lightRayAverage
          delta N omega y g (hgInt omega y)]
      _ = ∫⁻ z : WaveSpaceTime, ENNReal.ofReal
          (lightRayKernel delta N omega y z * norm (g z))
          ∂scratchLightRayMeasure :=
        ofReal_integral_eq_lintegral_ofReal (hgInt omega y) (by
          filter_upwards with z
          exact mul_nonneg (lightRayKernel_nonneg hdelta N omega y z) (norm_nonneg _))
  have hlinCore (n : Nat) :
      ENNReal.ofReal (lightRayAverage delta N omega y (core n)) =
      ∫⁻ z : WaveSpaceTime, ENNReal.ofReal
        (lightRayKernel delta N omega y z * norm (core n z))
        ∂scratchLightRayMeasure := by
    calc
      ENNReal.ofReal (lightRayAverage delta N omega y (core n)) =
          ENNReal.ofReal (∫ z : WaveSpaceTime,
            lightRayKernel delta N omega y z * norm (core n z)
            ∂scratchLightRayMeasure) := by
        rw [scratch_integral_lightRayKernel_mul_norm_eq_lightRayAverage
          delta N omega y (core n) (hcoreInt n omega y)]
      _ = ∫⁻ z : WaveSpaceTime, ENNReal.ofReal
          (lightRayKernel delta N omega y z * norm (core n z))
          ∂scratchLightRayMeasure :=
        ofReal_integral_eq_lintegral_ofReal (hcoreInt n omega y) (by
          filter_upwards with z
          exact mul_nonneg (lightRayKernel_nonneg hdelta N omega y z) (norm_nonneg _))
  have havg_le_max (n : Nat) :
      ENNReal.ofReal (lightRayAverage delta N omega y (core n)) <=
        ENNReal.ofReal (lightRayMaximal delta N (core n) y) := by
    apply ENNReal.ofReal_le_ofReal
    unfold lightRayMaximal
    apply le_csSup
    · exact aux_bddAbove_lightRayAverages_of_continuity delta N (core n)
        (aux_hasContinuousLightRayDirections_of_memLp hdelta N hN
          (core n) (hcoreMem n)) y
    · exact ⟨omega, homega, rfl⟩
  calc
    ENNReal.ofReal (lightRayMaximal delta N g y) =
        ENNReal.ofReal (lightRayAverage delta N omega y g) := by rw [hmax]
    _ = ∫⁻ z : WaveSpaceTime, ENNReal.ofReal
        (lightRayKernel delta N omega y z * norm (g z))
        ∂scratchLightRayMeasure := hlinG
    _ <= atTop.liminf (fun n => ∫⁻ z : WaveSpaceTime, ENNReal.ofReal
        (lightRayKernel delta N omega y z * norm (core n z))
        ∂scratchLightRayMeasure) := hlinfatou
    _ = atTop.liminf (fun n => ENNReal.ofReal
        (lightRayAverage delta N omega y (core n))) := by
      apply congrArg atTop.liminf
      funext n
      exact (hlinCore n).symm
    _ <= atTop.liminf (fun n => ENNReal.ofReal
        (lightRayMaximal delta N (core n) y)) := by
      refine Filter.liminf_le_liminf ?_ (by isBoundedDefault) (by isBoundedDefault)
      filter_upwards with n
      exact havg_le_max n

/-- The preceding Fatou comparison needs no extra analytic assumption for
`L²` inputs: the slab kernel is itself in `L²`, so Cauchy--Schwarz supplies
every displayed Bochner integral. -/
theorem scratch_lightRayMaximal_ofReal_le_liminf_of_ae_tendsto_memLp
    {delta : Real} (hdelta : 0 < delta) (N : Nat) (hN : 1 < N)
    (g : WaveSpaceTime -> Complex) (hg : MemLp g 2 volume)
    (core : Nat -> WaveSpaceTime -> Complex)
    (hcoreMem : forall n, MemLp (core n) 2 volume)
    (hconv : ∀ᵐ z : WaveSpaceTime ∂volume,
      Tendsto (fun n => core n z) atTop (nhds (g z)))
    (y : Euclidean 2) :
    ENNReal.ofReal (lightRayMaximal delta N g y) <=
      atTop.liminf (fun n => ENNReal.ofReal
        (lightRayMaximal delta N (core n) y)) := by
  apply scratch_lightRayMaximal_ofReal_le_liminf_of_ae_tendsto
    hdelta N hN g hg core hcoreMem
  · intro n omega y
    exact scratch_integrable_lightRayKernel_mul_norm_of_memLp hdelta N hN
      omega y (core n) (hcoreMem n)
  · intro omega y
    exact scratch_integrable_lightRayKernel_mul_norm_of_memLp hdelta N hN
      omega y g hg
  · exact hconv

/-- Generic literal-operator closure principle.  `core n` may be any
positive bandlimited/finite-tensor core; the theorem only asks for the three
facts the final Kakeya proof must establish: raw core bounds, a uniform input
norm bound, and the genuine raw pointwise Fatou comparison. -/
theorem scratch_lightRayMaximal_bound_of_liminf_core
    {delta : Real} (hdelta : 0 < delta) (N : Nat) (hN : 1 < N)
    (g : WaveSpaceTime -> Complex) (hg : MemLp g 2 volume)
    (A B : ENNReal) (core : Nat -> WaveSpaceTime -> Complex)
    (hcoreMem : forall n, MemLp (core n) 2 volume)
    (hstrong : forall n,
      eLpNorm (lightRayMaximal delta N (core n)) 2 volume <=
        A * eLpNorm (core n) 2 volume)
    (hcoreNorm : forall n, eLpNorm (core n) 2 volume <= B)
    (hfatou : ∀ᵐ y : Euclidean 2 ∂volume,
      ENNReal.ofReal (lightRayMaximal delta N g y) <=
        atTop.liminf (fun n => ENNReal.ofReal
          (lightRayMaximal delta N (core n) y))) :
    eLpNorm (lightRayMaximal delta N g) 2 volume <= A * B := by
  have hnonneg : forall y : Euclidean 2, 0 <= lightRayMaximal delta N g y :=
    fun y => scratch_lightRayMaximal_nonneg_of_memLp hdelta N hN g hg y
  have hmainEq :
      eLpNorm (fun y : Euclidean 2 =>
        ENNReal.ofReal (lightRayMaximal delta N g y)) 2 volume =
        eLpNorm (lightRayMaximal delta N g) 2 volume :=
    scratch_eLpNorm_ofReal_eq_of_nonneg volume 2
      (lightRayMaximal delta N g) hnonneg
  rw [<- hmainEq]
  apply scratch_eLpNorm_le_of_ae_le_liminf_of_uniform
    (p := (2 : ENNReal)) (by norm_num) (by norm_num) hfatou
  · intro n
    exact (scratch_measurable_lightRayMaximal_of_memLp hdelta N hN
      (core n) (hcoreMem n)).ennreal_ofReal
  · intro n
    have hcoreNonneg : forall y : Euclidean 2,
        0 <= lightRayMaximal delta N (core n) y :=
      fun y => scratch_lightRayMaximal_nonneg_of_memLp hdelta N hN
        (core n) (hcoreMem n) y
    have hcoreEq :
        eLpNorm (fun y : Euclidean 2 =>
          ENNReal.ofReal (lightRayMaximal delta N (core n) y)) 2 volume =
          eLpNorm (lightRayMaximal delta N (core n)) 2 volume :=
      scratch_eLpNorm_ofReal_eq_of_nonneg volume 2
        (lightRayMaximal delta N (core n)) hcoreNonneg
    rw [hcoreEq]
    calc
      eLpNorm (lightRayMaximal delta N (core n)) 2 volume <=
          A * eLpNorm (core n) 2 volume := hstrong n
      _ <= A * B := mul_le_mul_right (hcoreNorm n) A

/-- Strong estimates on any sequentially a.e.-dense core lift to the literal
light-ray maximal operator.  This is the final density interface: a caller
only has to provide core membership, the core estimate, a uniform norm bound,
and a genuine a.e. convergent approximation. -/
theorem scratch_lightRayMaximal_bound_of_ae_tendsto_core
    {delta : Real} (hdelta : 0 < delta) (N : Nat) (hN : 1 < N)
    (g : WaveSpaceTime -> Complex) (hg : MemLp g 2 volume)
    (A B : ENNReal) (core : Nat -> WaveSpaceTime -> Complex)
    (hcoreMem : forall n, MemLp (core n) 2 volume)
    (hstrong : forall n,
      eLpNorm (lightRayMaximal delta N (core n)) 2 volume <=
        A * eLpNorm (core n) 2 volume)
    (hcoreNorm : forall n, eLpNorm (core n) 2 volume <= B)
    (hconv : ∀ᵐ z : WaveSpaceTime ∂volume,
      Tendsto (fun n => core n z) atTop (nhds (g z))) :
    eLpNorm (lightRayMaximal delta N g) 2 volume <= A * B := by
  apply scratch_lightRayMaximal_bound_of_liminf_core hdelta N hN g hg A B
    core hcoreMem hstrong hcoreNorm
  filter_upwards with y
  exact scratch_lightRayMaximal_ofReal_le_liminf_of_ae_tendsto_memLp
    hdelta N hN g hg core hcoreMem hconv y

/-- The raw joint-Schwartz density route, with the only harmless constant
loss needed to keep all approximants uniformly bounded by the input norm. -/
theorem scratch_lightRayMaximal_bound_of_scaled_jointSchwartzCore
    {delta : Real} (hdelta : 0 < delta) (N : Nat) (hN : 1 < N)
    (g : WaveSpaceTime -> Complex) (hg : MemLp g 2 volume)
    (A : ENNReal)
    (hstrong : forall G : SchwartzMap JointWaveSpaceTime Complex,
      eLpNorm (lightRayMaximal delta N (jointSchwartzRaw G)) 2 volume <=
        A * eLpNorm (jointSchwartzRaw G) 2 volume)
    (psi : Nat -> SchwartzMap JointWaveSpaceTime Complex)
    (hpsi : forall n,
      eLpNorm (g - jointSchwartzRaw (psi n)) 2 volume <=
        eLpNorm g 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) :
    eLpNorm (lightRayMaximal delta N g) 2 volume <=
      A * (2 * eLpNorm g 2 volume) := by
  apply scratch_lightRayMaximal_bound_of_ae_tendsto_core hdelta N hN g hg A
    (2 * eLpNorm g 2 volume) (fun n => jointSchwartzRaw (psi n))
  · intro n
    exact scratch_jointSchwartzRaw_memLp_two (psi n)
  · intro n
    simpa only using hstrong (psi n)
  · intro n
    exact scratch_jointSchwartzRaw_eLpNorm_le_two_of_scaled_approximation
      g hg psi hpsi n
  · exact scratch_ae_tendsto_jointSchwartzRaw_of_scaled_approximation
      g hg psi hpsi

theorem scratch_lightRayMaximal_bound_of_jointSchwartzStrong_nonzero
    {delta : Real} (hdelta : 0 < delta) (N : Nat) (hN : 1 < N)
    (g : WaveSpaceTime -> Complex) (hg : MemLp g 2 volume)
    (hgnonzero : eLpNorm g 2 volume ≠ 0)
    (A : ENNReal)
    (hstrong : forall G : SchwartzMap JointWaveSpaceTime Complex,
      eLpNorm (lightRayMaximal delta N (jointSchwartzRaw G)) 2 volume <=
        A * eLpNorm (jointSchwartzRaw G) 2 volume) :
    eLpNorm (lightRayMaximal delta N g) 2 volume <=
      A * (2 * eLpNorm g 2 volume) := by
  obtain ⟨psi, hpsi⟩ :=
    scratch_exists_fast_jointSchwartzRaw_approximation_scaled g hg hgnonzero
  exact scratch_lightRayMaximal_bound_of_scaled_jointSchwartzCore
    hdelta N hN g hg A hstrong psi hpsi

/-- A strong bound on the raw joint-Schwartz core already implies the literal
`HasLightRayMaximalEstimate`.  The proof handles null representatives exactly
via full-slab integrability, and loses only the harmless factor `2` in the
existential constant while passing to a geometrically fast dense sequence. -/
theorem scratch_hasLightRayMaximalEstimate_of_jointSchwartzStrong
    (hstrong : forall N : Nat, 3 < N -> exists C : Real, 0 < C /\
      forall delta : Real, 0 < delta -> delta < 1 / 2 ->
      forall G : SchwartzMap JointWaveSpaceTime Complex,
        eLpNorm (lightRayMaximal delta N (jointSchwartzRaw G)) 2 volume <=
          ENNReal.ofReal (C * (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
            eLpNorm (jointSchwartzRaw G) 2 volume) :
    HasLightRayMaximalEstimate := by
  intro N hN
  obtain ⟨C, hCpos, hCstrong⟩ := hstrong N hN
  refine ⟨2 * C, by positivity, ?_⟩
  intro delta hdelta hdeltasmall g hg
  have hNsmall : 1 < N := by omega
  let L : Real := (1 + abs (Real.log delta)) ^ (3 / 2 : Real)
  let A : ENNReal := ENNReal.ofReal (C * L)
  by_cases hgnonzero : eLpNorm g 2 volume = 0
  · have hgae : g =ᵐ[volume] (fun _ : WaveSpaceTime => (0 : Complex)) :=
      (eLpNorm_eq_zero_iff hg.aestronglyMeasurable (by norm_num)).mp hgnonzero
    have hMzero : lightRayMaximal delta N g = 0 := by
      calc
        lightRayMaximal delta N g =
            lightRayMaximal delta N (fun _ : WaveSpaceTime => (0 : Complex)) :=
          scratch_lightRayMaximal_eq_of_ae_eq_of_memLp hdelta N hNsmall hg
            MemLp.zero hgae
        _ = 0 := scratch_lightRayMaximal_zero delta N
    rw [hMzero]
    simp
  · have hcoreStrong : forall G : SchwartzMap JointWaveSpaceTime Complex,
      eLpNorm (lightRayMaximal delta N (jointSchwartzRaw G)) 2 volume <=
        A * eLpNorm (jointSchwartzRaw G) 2 volume := by
      intro G
      simpa only [A, L] using hCstrong delta hdelta hdeltasmall G
    have hbound := scratch_lightRayMaximal_bound_of_jointSchwartzStrong_nonzero
      hdelta N hNsmall g hg hgnonzero A hcoreStrong
    have hfactor :
        A * (2 * eLpNorm g 2 volume) =
          ENNReal.ofReal ((2 * C) * L) * eLpNorm g 2 volume := by
      calc
        A * (2 * eLpNorm g 2 volume) =
            (2 * A) * eLpNorm g 2 volume := by ring
        _ = ENNReal.ofReal (2 * (C * L)) * eLpNorm g 2 volume := by
          congr 1
          dsimp only [A]
          rw [ENNReal.ofReal_mul (by norm_num : (0 : Real) <= 2)]
          norm_num
        _ = ENNReal.ofReal ((2 * C) * L) * eLpNorm g 2 volume := by
          congr 2
          ring
    calc
      eLpNorm (lightRayMaximal delta N g) 2 volume <=
          A * (2 * eLpNorm g 2 volume) := hbound
      _ = ENNReal.ofReal ((2 * C) *
          (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
          eLpNorm g 2 volume := by
        simpa only [L] using hfactor

/-- The purely approximation-theoretic interface needed for a finite tensor
core.  It contains no maximal operator: it says only that the core is dense
in `L²` after restricting to the time slab actually used by a light ray. -/
def scratch_HasLightRaySlabL2DenseCore
    (Core : (WaveSpaceTime -> Complex) -> Prop) : Prop :=
  forall g : WaveSpaceTime -> Complex, MemLp g 2 volume ->
    forall epsilon : Real, 0 < epsilon ->
      exists f : WaveSpaceTime -> Complex,
        Core f /\ MemLp f 2 volume /\
          eLpNorm (scratch_lightRayTimeRestriction g - f) 2 volume <
            ENNReal.ofReal epsilon

/-- A homogeneous strong estimate on any core satisfying the preceding
slab-density property implies the literal maximal estimate.  This packages
the exact noncircular bridge required of the finite compact-frequency tensor
model. -/
theorem scratch_hasLightRayMaximalEstimate_of_slabDenseCore
    (Core : (WaveSpaceTime -> Complex) -> Prop)
    (hdense : scratch_HasLightRaySlabL2DenseCore Core)
    (hstrong : forall N : Nat, 3 < N -> exists C : Real, 0 < C /\
      forall delta : Real, 0 < delta -> delta < 1 / 2 ->
      forall f : WaveSpaceTime -> Complex, Core f ->
        eLpNorm (lightRayMaximal delta N f) 2 volume <=
          ENNReal.ofReal (C * (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
            eLpNorm f 2 volume) :
    HasLightRayMaximalEstimate := by
  intro N hN
  obtain ⟨C, hCpos, hCstrong⟩ := hstrong N hN
  refine ⟨2 * C, by positivity, ?_⟩
  intro delta hdelta hdeltasmall g hg
  let h : WaveSpaceTime -> Complex := scratch_lightRayTimeRestriction g
  have hh : MemLp h 2 volume := by
    simpa only [h] using scratch_memLp_lightRayTimeRestriction g hg
  have hM : lightRayMaximal delta N g = lightRayMaximal delta N h := by
    simpa only [h] using
      scratch_lightRayMaximal_eq_lightRayTimeRestriction hdelta N (by omega) g hg
  let L : Real := (1 + abs (Real.log delta)) ^ (3 / 2 : Real)
  let A : ENNReal := ENNReal.ofReal (C * L)
  by_cases hhnonzero : eLpNorm h 2 volume = 0
  · have hhae : h =ᵐ[volume] (fun _ : WaveSpaceTime => (0 : Complex)) :=
      (eLpNorm_eq_zero_iff hh.aestronglyMeasurable (by norm_num)).mp hhnonzero
    have hMhzero : lightRayMaximal delta N h = 0 := by
      calc
        lightRayMaximal delta N h =
            lightRayMaximal delta N (fun _ : WaveSpaceTime => (0 : Complex)) :=
          scratch_lightRayMaximal_eq_of_ae_eq_of_memLp hdelta N (by omega) hh
            MemLp.zero hhae
        _ = 0 := scratch_lightRayMaximal_zero delta N
    rw [hM, hMhzero]
    simp
  · let R : Real := (eLpNorm h 2 volume).toReal
    have hRpos : 0 < R := ENNReal.toReal_pos hhnonzero hh.eLpNorm_ne_top
    choose core hcore hcoreMem hcoreErr using fun n : Nat =>
      hdense g hg (R * ((2 : Real)⁻¹ ^ n))
        (show 0 < R * ((2 : Real)⁻¹ ^ n) by positivity)
    have hscaled (n : Nat) :
        eLpNorm (h - core n) 2 volume <=
          eLpNorm h 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n) := by
      calc
        eLpNorm (h - core n) 2 volume <=
            ENNReal.ofReal (R * ((2 : Real)⁻¹ ^ n)) := by
              simpa only [h] using (hcoreErr n).le
        _ = ENNReal.ofReal R * ENNReal.ofReal ((2 : Real)⁻¹ ^ n) :=
          ENNReal.ofReal_mul hRpos.le
        _ = eLpNorm h 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n) := by
          rw [ENNReal.ofReal_toReal hh.eLpNorm_ne_top]
    have hcoreStrong (n : Nat) :
        eLpNorm (lightRayMaximal delta N (core n)) 2 volume <=
          A * eLpNorm (core n) 2 volume := by
      simpa only [A, L] using hCstrong delta hdelta hdeltasmall (core n) (hcore n)
    have hbound : eLpNorm (lightRayMaximal delta N h) 2 volume <=
        A * (2 * eLpNorm h 2 volume) := by
      apply scratch_lightRayMaximal_bound_of_ae_tendsto_core hdelta N (by omega)
        h hh A (2 * eLpNorm h 2 volume) core hcoreMem hcoreStrong
      · intro n
        exact scratch_core_eLpNorm_le_two_of_scaled_approximation
          h hh core hcoreMem hscaled n
      · exact scratch_ae_tendsto_of_geometric_eLpNorm_sub h hh core hcoreMem
          (eLpNorm h 2 volume) hh.eLpNorm_ne_top hscaled
    have hnorm : eLpNorm h 2 volume <= eLpNorm g 2 volume := by
      simpa only [h] using scratch_eLpNorm_lightRayTimeRestriction_le g
    have hboundG : eLpNorm (lightRayMaximal delta N g) 2 volume <=
        A * (2 * eLpNorm g 2 volume) := by
      calc
        eLpNorm (lightRayMaximal delta N g) 2 volume =
            eLpNorm (lightRayMaximal delta N h) 2 volume := by rw [hM]
        _ <= A * (2 * eLpNorm h 2 volume) := hbound
        _ <= A * (2 * eLpNorm g 2 volume) :=
          by
            simpa only [mul_assoc, mul_comm, mul_left_comm] using
              (mul_le_mul_left (mul_le_mul_left hnorm 2) A)
    have hfactor : A * (2 * eLpNorm g 2 volume) =
        ENNReal.ofReal ((2 * C) * L) * eLpNorm g 2 volume := by
      calc
        A * (2 * eLpNorm g 2 volume) =
            (2 * A) * eLpNorm g 2 volume := by ring
        _ = ENNReal.ofReal (2 * (C * L)) * eLpNorm g 2 volume := by
          congr 1
          dsimp only [A]
          rw [ENNReal.ofReal_mul (by norm_num : (0 : Real) <= 2)]
          norm_num
        _ = ENNReal.ofReal ((2 * C) * L) * eLpNorm g 2 volume := by
          congr 2
          ring
    calc
      eLpNorm (lightRayMaximal delta N g) 2 volume <=
          A * (2 * eLpNorm g 2 volume) := hboundG
      _ = ENNReal.ofReal ((2 * C) *
          (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
          eLpNorm g 2 volume := by
        simpa only [L] using hfactor

/-- Final raw-operator lift once a genuine pointwise Fatou comparison has
been supplied.  Its core consists of literal pullbacks of joint Schwartz
profiles, and its conclusion is the original unmodified continuum supremum.

The separate `hfatou` hypothesis is deliberate: it is exactly the one
analytic statement still needed to identify the dense `L²` extension with
the raw positive light-ray integral. -/
theorem scratch_lightRayMaximal_bound_of_liminf_jointSchwartzCore
    {delta : Real} (hdelta : 0 < delta) (N : Nat) (hN : 1 < N)
    (g : WaveSpaceTime -> Complex) (hg : MemLp g 2 volume)
    (A : ENNReal)
    (hstrong : forall G : SchwartzMap JointWaveSpaceTime Complex,
      eLpNorm (lightRayMaximal delta N (jointSchwartzRaw G)) 2 volume <=
        A * eLpNorm (jointSchwartzRaw G) 2 volume)
    (psi : Nat -> SchwartzMap JointWaveSpaceTime Complex)
    (hpsiNorm : forall n,
      eLpNorm (jointSchwartzRaw (psi n)) 2 volume <= eLpNorm g 2 volume)
    (hfatou : ∀ᵐ y : Euclidean 2 ∂volume,
      ENNReal.ofReal (lightRayMaximal delta N g y) <=
        atTop.liminf (fun n => ENNReal.ofReal
          (lightRayMaximal delta N (jointSchwartzRaw (psi n)) y))) :
    eLpNorm (lightRayMaximal delta N g) 2 volume <=
      A * eLpNorm g 2 volume := by
  have hnonneg : forall y : Euclidean 2, 0 <= lightRayMaximal delta N g y :=
    fun y => scratch_lightRayMaximal_nonneg_of_memLp hdelta N hN g hg y
  have hmainEq :
      eLpNorm (fun y : Euclidean 2 =>
        ENNReal.ofReal (lightRayMaximal delta N g y)) 2 volume =
        eLpNorm (lightRayMaximal delta N g) 2 volume :=
    scratch_eLpNorm_ofReal_eq_of_nonneg volume 2
      (lightRayMaximal delta N g) hnonneg
  rw [<- hmainEq]
  apply scratch_eLpNorm_le_of_ae_le_liminf_of_uniform
    (p := (2 : ENNReal)) (by norm_num) (by norm_num) hfatou
  · intro n
    let core : WaveSpaceTime -> Complex := jointSchwartzRaw (psi n)
    have hcore : MemLp core 2 volume :=
      scratch_jointSchwartzRaw_memLp_two (psi n)
    exact (scratch_measurable_lightRayMaximal_of_memLp hdelta N hN core hcore).ennreal_ofReal
  · intro n
    let core : WaveSpaceTime -> Complex := jointSchwartzRaw (psi n)
    have hcore : MemLp core 2 volume :=
      scratch_jointSchwartzRaw_memLp_two (psi n)
    have hcoreNonneg : forall y : Euclidean 2,
        0 <= lightRayMaximal delta N core y :=
      fun y => scratch_lightRayMaximal_nonneg_of_memLp hdelta N hN core hcore y
    have hcoreEq :
        eLpNorm (fun y : Euclidean 2 =>
          ENNReal.ofReal (lightRayMaximal delta N core y)) 2 volume =
          eLpNorm (lightRayMaximal delta N core) 2 volume :=
      scratch_eLpNorm_ofReal_eq_of_nonneg volume 2
        (lightRayMaximal delta N core) hcoreNonneg
    rw [hcoreEq]
    calc
      eLpNorm (lightRayMaximal delta N core) 2 volume <=
          A * eLpNorm core 2 volume := by
        simpa only [core] using hstrong (psi n)
      _ <= A * eLpNorm g 2 volume :=
        mul_le_mul_right (by simpa only [core] using hpsiNorm n) A

/-- Pointwise Fatou bridge for a *signed* linear tube model.  The core
estimate need only control the nonnegative envelope `P core`; it is not
assumed to be the raw positive `lightRayMaximal`.  The caller supplies the
one substantive analytic identification: the signed tube transform of the
target `F` is the literal positive light-ray average, and it converges at
each fixed direction and endpoint along the core sequence. -/
theorem scratch_lightRayMaximal_ofReal_le_liminf_of_signedCore
    {delta : Real} (hdelta : 0 < delta) (N : Nat) (hN : 1 < N)
    (g : WaveSpaceTime -> Complex) (hg : MemLp g 2 volume)
    (F : WaveSpaceTime -> Complex)
    (T : (WaveSpaceTime -> Complex) -> Euclidean 2 -> Euclidean 2 -> Complex)
    (P : (WaveSpaceTime -> Complex) -> Euclidean 2 -> ENNReal)
    (core : Nat -> WaveSpaceTime -> Complex)
    (hidentify : forall omega y,
      T F omega y = (lightRayAverage delta N omega y g : Complex))
    (hconv : forall omega y,
      Tendsto (fun n => T (core n) omega y) atTop (nhds (T F omega y)))
    (hdom : forall n omega y,
      ENNReal.ofReal ‖T (core n) omega y‖ <= P (core n) y)
    (y : Euclidean 2) :
    ENNReal.ofReal (lightRayMaximal delta N g y) <=
      atTop.liminf (fun n => P (core n) y) := by
  obtain ⟨omega, homega, hmax⟩ :=
    aux_exists_lightRayPointwiseMaximizer_of_continuity delta N g
      (aux_hasContinuousLightRayDirections_of_memLp hdelta N hN g hg) y
  have hnormconv : Tendsto (fun n => ENNReal.ofReal
      ‖T (core n) omega y‖) atTop
      (nhds (ENNReal.ofReal ‖T F omega y‖)) := by
    exact ENNReal.tendsto_ofReal ((hconv omega y).norm)
  have htarget : ENNReal.ofReal (lightRayAverage delta N omega y g) =
      ENNReal.ofReal ‖T F omega y‖ := by
    rw [hidentify omega y]
    rw [Complex.norm_real, Real.norm_of_nonneg
      (aux_lightRayAverage_nonneg hdelta N omega y g)]
  calc
    ENNReal.ofReal (lightRayMaximal delta N g y) =
        ENNReal.ofReal (lightRayAverage delta N omega y g) := by rw [hmax]
    _ = ENNReal.ofReal ‖T F omega y‖ := htarget
    _ = atTop.liminf (fun n => ENNReal.ofReal
        ‖T (core n) omega y‖) := hnormconv.liminf_eq.symm
    _ <= atTop.liminf (fun n => P (core n) y) := by
      refine Filter.liminf_le_liminf ?_ (by isBoundedDefault) (by isBoundedDefault)
      filter_upwards with n
      exact hdom n omega y

/-- `L²` closure for a signed tube envelope.  This is intentionally separate
from the raw-positive-core closure above: the strong estimate is on `P`,
while the literal light-ray maximum enters only through the signed Fatou
comparison. -/
theorem scratch_lightRayMaximal_bound_of_signedCore_liminf
    {delta : Real} (hdelta : 0 < delta) (N : Nat) (hN : 1 < N)
    (g : WaveSpaceTime -> Complex) (hg : MemLp g 2 volume)
    (A B : ENNReal) (core : Nat -> WaveSpaceTime -> Complex)
    (P : (WaveSpaceTime -> Complex) -> Euclidean 2 -> ENNReal)
    (hPmeas : forall n, Measurable (P (core n)))
    (hstrong : forall n,
      eLpNorm (P (core n)) 2 volume <= A * eLpNorm (core n) 2 volume)
    (hcoreNorm : forall n, eLpNorm (core n) 2 volume <= B)
    (hfatou : ∀ᵐ y : Euclidean 2 ∂volume,
      ENNReal.ofReal (lightRayMaximal delta N g y) <=
        atTop.liminf (fun n => P (core n) y)) :
    eLpNorm (lightRayMaximal delta N g) 2 volume <= A * B := by
  have hnonneg : forall y : Euclidean 2, 0 <= lightRayMaximal delta N g y :=
    fun y => scratch_lightRayMaximal_nonneg_of_memLp hdelta N hN g hg y
  have hmainEq :
      eLpNorm (fun y : Euclidean 2 =>
        ENNReal.ofReal (lightRayMaximal delta N g y)) 2 volume =
        eLpNorm (lightRayMaximal delta N g) 2 volume :=
    scratch_eLpNorm_ofReal_eq_of_nonneg volume 2
      (lightRayMaximal delta N g) hnonneg
  rw [<- hmainEq]
  apply scratch_eLpNorm_le_of_ae_le_liminf_of_uniform
    (p := (2 : ENNReal)) (by norm_num) (by norm_num) hfatou hPmeas
  intro n
  calc
    eLpNorm (P (core n)) 2 volume <= A * eLpNorm (core n) 2 volume :=
      hstrong n
    _ <= A * B := mul_le_mul_right (hcoreNorm n) A

/-- Passing from a complex-valued function to its nonnegative magnitude,
viewed again as a complex-valued function, preserves `Lᵖ` membership.  This
is the small bookkeeping step needed before a signed tube operator can be
applied to the positive data underlying a literal light-ray average. -/
theorem scratch_memLp_complex_of_norm
    (g : WaveSpaceTime -> Complex) {p : ENNReal}
    (hg : MemLp g p volume) :
    MemLp (fun z => (‖g z‖ : Complex)) p volume := by
  apply hg.congr_norm
  · exact Complex.ofRealCLM.continuous.comp_aestronglyMeasurable
      hg.norm.aestronglyMeasurable
  · filter_upwards with z
    simp

/-- The positive slab datum has the same `Lᵖ` size as a function already
restricted to that slab. -/
theorem scratch_eLpNorm_positiveSlab_eq
    (h : WaveSpaceTime -> Complex)
    (hslab : h = scratch_lightRayTimeRestriction h)
    (p : ENNReal) :
    eLpNorm
        (scratch_lightRayTimeRestriction (fun z => (‖h z‖ : Complex))) p volume =
      eLpNorm h p volume := by
  have hpos : scratch_lightRayTimeRestriction
      (fun z => (‖h z‖ : Complex)) = fun z => (‖h z‖ : Complex) := by
    funext z
    by_cases hz : z.2 ∈ lightRayTimeInterval
    · simp [scratch_lightRayTimeRestriction, hz]
    · have hz0 : h z = 0 := by
        rw [hslab]
        simp [scratch_lightRayTimeRestriction, hz]
      simp [scratch_lightRayTimeRestriction, hz, hz0]
  rw [hpos]
  apply eLpNorm_congr_norm_ae
  filter_upwards with z
  simp

/-- The signed-envelope version of the final slab-density lift.

`T` is a signed linear (or otherwise signed) tube model and `P` is the
nonnegative endpoint envelope controlled by the finite tensor theorem.  The
strong core hypothesis is deliberately about `P`, *not* about the literal
positive `lightRayMaximal`.  The two extra analytic hypotheses are exactly
what connects them:

* `hidentify` says that applying `T` to the positive slab datum
  `1_I ‖h‖` gives the raw positive light-ray average of `h`;
* `hTgeom` is fixed-direction continuity of `T` along the geometric `L²`
  core approximation supplied by density.

Thus no measurable selector of maximizing directions and no unproved
positive-core estimate are hidden in this closure step. -/
theorem scratch_hasLightRayMaximalEstimate_of_slabDenseSignedCore
    (Core : (WaveSpaceTime -> Complex) -> Prop)
    (hdense : scratch_HasLightRaySlabL2DenseCore Core)
    (T : Real -> Nat -> (WaveSpaceTime -> Complex) ->
      Euclidean 2 -> Euclidean 2 -> Complex)
    (P : Real -> Nat -> (WaveSpaceTime -> Complex) -> Euclidean 2 -> ENNReal)
    (hPmeas : forall delta N f, Core f -> Measurable (P delta N f))
    (hstrong : forall N : Nat, 3 < N -> exists C : Real, 0 < C /\
      forall delta : Real, 0 < delta -> delta < 1 / 2 ->
      forall f : WaveSpaceTime -> Complex, Core f ->
        eLpNorm (P delta N f) 2 volume <=
          ENNReal.ofReal (C * (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
            eLpNorm f 2 volume)
    (hidentify : forall delta N (h : WaveSpaceTime -> Complex)
      (omega y : Euclidean 2),
      T delta N
          (scratch_lightRayTimeRestriction (fun z => (‖h z‖ : Complex))) omega y =
        (lightRayAverage delta N omega y h : Complex))
    (hTgeom : forall delta N (F : WaveSpaceTime -> Complex)
      (core : Nat -> WaveSpaceTime -> Complex),
      MemLp F 2 volume ->
      (forall n, MemLp (core n) 2 volume) ->
      (forall n, eLpNorm (F - core n) 2 volume <=
        eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) ->
      forall omega y,
        Tendsto (fun n => T delta N (core n) omega y) atTop
          (nhds (T delta N F omega y)))
    (hdom : forall delta N f omega y,
      ENNReal.ofReal ‖T delta N f omega y‖ <= P delta N f y) :
    HasLightRayMaximalEstimate := by
  intro N hN
  obtain ⟨C, hCpos, hCstrong⟩ := hstrong N hN
  refine ⟨2 * C, by positivity, ?_⟩
  intro delta hdelta hdeltasmall g hg
  let h : WaveSpaceTime -> Complex := scratch_lightRayTimeRestriction g
  have hh : MemLp h 2 volume := by
    simpa only [h] using scratch_memLp_lightRayTimeRestriction g hg
  have hslab : h = scratch_lightRayTimeRestriction h := by
    funext z
    dsimp only [h]
    simp only [scratch_lightRayTimeRestriction, Set.indicator_indicator]
    rw [inter_self]
  let F : WaveSpaceTime -> Complex :=
    scratch_lightRayTimeRestriction (fun z => (‖h z‖ : Complex))
  have hFmem : MemLp F 2 volume := by
    dsimp only [F]
    exact scratch_memLp_lightRayTimeRestriction _
      (scratch_memLp_complex_of_norm h hh)
  have hFnorm : eLpNorm F 2 volume = eLpNorm h 2 volume := by
    dsimp only [F]
    exact scratch_eLpNorm_positiveSlab_eq h hslab 2
  have hM : lightRayMaximal delta N g = lightRayMaximal delta N h := by
    simpa only [h] using
      scratch_lightRayMaximal_eq_lightRayTimeRestriction hdelta N (by omega) g hg
  let L : Real := (1 + abs (Real.log delta)) ^ (3 / 2 : Real)
  let A : ENNReal := ENNReal.ofReal (C * L)
  by_cases hhnonzero : eLpNorm h 2 volume = 0
  · have hhae : h =ᵐ[volume] (fun _ : WaveSpaceTime => (0 : Complex)) :=
      (eLpNorm_eq_zero_iff hh.aestronglyMeasurable (by norm_num)).mp hhnonzero
    have hMhzero : lightRayMaximal delta N h = 0 := by
      calc
        lightRayMaximal delta N h =
            lightRayMaximal delta N (fun _ : WaveSpaceTime => (0 : Complex)) :=
          scratch_lightRayMaximal_eq_of_ae_eq_of_memLp hdelta N (by omega) hh
            MemLp.zero hhae
        _ = 0 := scratch_lightRayMaximal_zero delta N
    rw [hM, hMhzero]
    simp
  · let R : Real := (eLpNorm F 2 volume).toReal
    have hFnonzero : eLpNorm F 2 volume ≠ 0 := by
      rwa [hFnorm]
    have hRpos : 0 < R := ENNReal.toReal_pos hFnonzero hFmem.eLpNorm_ne_top
    choose core hcore hcoreMem hcoreErr using fun n : Nat =>
      hdense (fun z => (‖h z‖ : Complex)) (scratch_memLp_complex_of_norm h hh)
        (R * ((2 : Real)⁻¹ ^ n))
        (show 0 < R * ((2 : Real)⁻¹ ^ n) by positivity)
    have hscaled (n : Nat) :
        eLpNorm (F - core n) 2 volume <=
          eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n) := by
      calc
        eLpNorm (F - core n) 2 volume <=
            ENNReal.ofReal (R * ((2 : Real)⁻¹ ^ n)) := by
              simpa only [F] using (hcoreErr n).le
        _ = ENNReal.ofReal R * ENNReal.ofReal ((2 : Real)⁻¹ ^ n) :=
          ENNReal.ofReal_mul hRpos.le
        _ = eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n) := by
          rw [ENNReal.ofReal_toReal hFmem.eLpNorm_ne_top]
    have hcoreStrong (n : Nat) :
        eLpNorm (P delta N (core n)) 2 volume <=
          A * eLpNorm (core n) 2 volume := by
      simpa only [A, L] using hCstrong delta hdelta hdeltasmall (core n) (hcore n)
    have hconv : forall omega y,
        Tendsto (fun n => T delta N (core n) omega y) atTop
          (nhds (T delta N F omega y)) :=
      hTgeom delta N F core hFmem hcoreMem hscaled
    have hfatou : ∀ᵐ y : Euclidean 2 ∂volume,
        ENNReal.ofReal (lightRayMaximal delta N h y) <=
          atTop.liminf (fun n => P delta N (core n) y) := by
      filter_upwards with y
      apply scratch_lightRayMaximal_ofReal_le_liminf_of_signedCore
        hdelta N (by omega) h hh F (T delta N) (P delta N) core
      · intro omega y
        simpa only [F] using hidentify delta N h omega y
      · exact hconv
      · intro n omega y
        exact hdom delta N (core n) omega y
    have hbound : eLpNorm (lightRayMaximal delta N h) 2 volume <=
        A * (2 * eLpNorm h 2 volume) := by
      calc
        eLpNorm (lightRayMaximal delta N h) 2 volume <=
            A * (2 * eLpNorm F 2 volume) := by
          apply scratch_lightRayMaximal_bound_of_signedCore_liminf
            hdelta N (by omega) h hh A (2 * eLpNorm F 2 volume) core (P delta N)
          · intro n
            exact hPmeas delta N (core n) (hcore n)
          · exact hcoreStrong
          · intro n
            exact scratch_core_eLpNorm_le_two_of_scaled_approximation
              F hFmem core hcoreMem hscaled n
          · exact hfatou
        _ = A * (2 * eLpNorm h 2 volume) := by rw [hFnorm]
    have hnorm : eLpNorm h 2 volume <= eLpNorm g 2 volume := by
      simpa only [h] using scratch_eLpNorm_lightRayTimeRestriction_le g
    have hboundG : eLpNorm (lightRayMaximal delta N g) 2 volume <=
        A * (2 * eLpNorm g 2 volume) := by
      calc
        eLpNorm (lightRayMaximal delta N g) 2 volume =
            eLpNorm (lightRayMaximal delta N h) 2 volume := by rw [hM]
        _ <= A * (2 * eLpNorm h 2 volume) := hbound
        _ <= A * (2 * eLpNorm g 2 volume) := by
          simpa only [mul_assoc, mul_comm, mul_left_comm] using
            (mul_le_mul_left (mul_le_mul_left hnorm 2) A)
    have hfactor : A * (2 * eLpNorm g 2 volume) =
        ENNReal.ofReal ((2 * C) * L) * eLpNorm g 2 volume := by
      calc
        A * (2 * eLpNorm g 2 volume) =
            (2 * A) * eLpNorm g 2 volume := by ring
        _ = ENNReal.ofReal (2 * (C * L)) * eLpNorm g 2 volume := by
          congr 1
          dsimp only [A]
          rw [ENNReal.ofReal_mul (by norm_num : (0 : Real) <= 2)]
          norm_num
        _ = ENNReal.ofReal ((2 * C) * L) * eLpNorm g 2 volume := by
          congr 2
          ring
    calc
      eLpNorm (lightRayMaximal delta N g) 2 volume <=
          A * (2 * eLpNorm g 2 volume) := hboundG
      _ = ENNReal.ofReal ((2 * C) *
          (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
          eLpNorm g 2 volume := by
        simpa only [L] using hfactor

/-- A finite separated space--time tensor whose spatial factors are inverse
Fourier transforms of compactly supported Schwartz frequency profiles. -/
noncomputable def scratch_innerSlabCompactFrequencyTensor
    {ι : Type*} [Fintype ι]
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) : WaveSpaceTime → Complex :=
  fun z => ∑ i, (FourierTransform.fourierInv (q i) :
    SchwartzMap (Euclidean 2) Complex) z.1 * (a i : Real → Complex) z.2

/-- The literal finite tensor core needed by the compact-time outer estimate.
The common `r < 1` is the quantitative inner-slab margin: every temporal
Schwartz factor is supported in `|t - 3/2| ≤ r`, hence strictly inside the
light-ray time slab. -/
def scratch_InnerSlabCompactFrequencyTensorCore
    (f : WaveSpaceTime → Complex) : Prop :=
  ∃ (ι : Type) (_ : Fintype ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) (r : Real),
    (∀ i, HasCompactSupport (q i : Euclidean 2 → Complex)) ∧
    0 < r ∧ r < 1 ∧
    (∀ i, Function.support (a i : Real → Complex) ⊆
      Metric.closedBall (3 / 2 : Real) r) ∧
    f = scratch_innerSlabCompactFrequencyTensor q a

/-- The signed-envelope lift specialized to the actual finite compact-frequency
tensor core.  Thus the sole remaining operator-specific estimate is the
finite-tensor `hstrong` premise below; no positivity assertion for the raw
maximal operator is used. -/
theorem scratch_hasLightRayMaximalEstimate_of_innerSlabCompactFrequencyTensorCore
    (hdense : scratch_HasLightRaySlabL2DenseCore
      scratch_InnerSlabCompactFrequencyTensorCore)
    (T : Real → Nat → (WaveSpaceTime → Complex) →
      Euclidean 2 → Euclidean 2 → Complex)
    (P : Real → Nat → (WaveSpaceTime → Complex) → Euclidean 2 → ENNReal)
    (hPmeas : ∀ delta N f, scratch_InnerSlabCompactFrequencyTensorCore f →
      Measurable (P delta N f))
    (hstrong : ∀ N : Nat, 3 < N → ∃ C : Real, 0 < C ∧
      ∀ delta : Real, 0 < delta → delta < 1 / 2 →
      ∀ f : WaveSpaceTime → Complex,
        scratch_InnerSlabCompactFrequencyTensorCore f →
        eLpNorm (P delta N f) 2 volume ≤
          ENNReal.ofReal (C * (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
            eLpNorm f 2 volume)
    (hidentify : ∀ delta N (h : WaveSpaceTime → Complex)
      (omega y : Euclidean 2),
      T delta N
          (scratch_lightRayTimeRestriction (fun z => (‖h z‖ : Complex))) omega y =
        (lightRayAverage delta N omega y h : Complex))
    (hTgeom : ∀ delta N (F : WaveSpaceTime → Complex)
      (core : Nat → WaveSpaceTime → Complex),
      MemLp F 2 volume →
      (∀ n, MemLp (core n) 2 volume) →
      (∀ n, eLpNorm (F - core n) 2 volume ≤
        eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) →
      ∀ omega y,
        Tendsto (fun n => T delta N (core n) omega y) atTop
          (nhds (T delta N F omega y)))
    (hdom : ∀ delta N f omega y,
      ENNReal.ofReal ‖T delta N f omega y‖ ≤ P delta N f y) :
    HasLightRayMaximalEstimate := by
  exact scratch_hasLightRayMaximalEstimate_of_slabDenseSignedCore
    scratch_InnerSlabCompactFrequencyTensorCore hdense T P hPmeas hstrong
    hidentify hTgeom hdom

end

end Auto.Spherical.MSS
