    _ <= 2 * ((2 * (shellFrequencyEnergy mcp lo hi xi + shellFrequencyEnergy mcm lo hi xi)) +
        (2 * (shellFrequencyEnergy mpp lo hi xi + shellFrequencyEnergy mpm lo hi xi))) := by
      gcongr

end

