noncomputable section

/-- The literal shifted dyadic multiplier, in local stationary coordinates,
is exactly the sum of the signed positive and negative lobe multipliers.
No estimate or phase normalization is hidden in this identity. -/
theorem shiftedCharted_dyadicMultiplier_local_split
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    {eps r : Real} (heps : 0 < eps) (K n k : Nat) (hk : k < K)
    (u : Real) (xi : Euclidean 2)
    (hr : r = (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps)) :
    shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n (k + 1)
      (C.angle j xi + stationaryShift n + r * u) xi =
      (shiftedDyadicPositiveProfile n (r, u) : Complex) *
        scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
          (chartProfiles_compact C j q hqcompact) a
          (circleDirection (C.angle j xi + stationaryShift n + r * u)) xi +
      (shiftedDyadicNegativeProfile n (r, u) : Complex) *
        scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
          (chartProfiles_compact C j q hqcompact) a
          (circleDirection (C.angle j xi + stationaryShift n + r * u)) xi := by
  unfold shiftedChartedCappedTelescopingMultiplier
  rw [shiftedDyadicTelescope_local_split heps K n k hk (C.angle j xi) u hr]
  change ((shiftedDyadicPositiveProfile n (r, u) +
      shiftedDyadicNegativeProfile n (r, u) : Real) : Complex) * _ = _
  push_cast
  ring

/-- After reflection, the negative dyadic lobe is the standard positive
unit-coordinate profile evaluated at the opposite stationary side. -/
theorem shiftedCharted_dyadicMultiplier_reflected_negative
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (n : Nat) (alpha r u : Real) (xi : Euclidean 2) :
    (shiftedDyadicNegativeProfile n (r, -u) : Complex) *
        scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
          (chartProfiles_compact C j q hqcompact) a
          (circleDirection (alpha + stationaryShift n - r * u)) xi =
      (shiftedDyadicReflectedNegativeProfile n (r, u) : Complex) *
        scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
          (chartProfiles_compact C j q hqcompact) a
          (circleDirection (alpha + stationaryShift n - r * u)) xi := by
  rw [shiftedDyadicTelescope_negative_reflect n r u]

/-- Both normalized dyadic profiles have literal support in the standard
positive unit-coordinate interval.  This stronger pointwise form feeds the
affine energy transport. -/
theorem shiftedDyadicPositiveProfile_eq_zero_of_not_mem_Icc
    (n : Nat) (rho u : Real) (hu : u ∉ Icc (1 / 2 : Real) 2) :
    shiftedDyadicPositiveProfile n (rho, u) = 0 := by
  by_cases hleft : u ≤ 1 / 2
  · have hsmall : u ≤ 5 / 8 := by linarith
    unfold shiftedDyadicPositiveProfile shiftedOuterParametricProfile
    rw [normalizedTelescopingPositiveLobe_eq_zero_of_le_five_eighth hsmall]
    ring
  · have hlow : 1 / 2 ≤ u := le_of_lt (lt_of_not_ge hleft)
    have hright : 2 ≤ u := by
      by_contra hnot
      exact hu ⟨hlow, le_of_lt (lt_of_not_ge hnot)⟩
    have hlarge : 15 / 8 ≤ u := by linarith
    unfold shiftedDyadicPositiveProfile shiftedOuterParametricProfile
    rw [normalizedTelescopingPositiveLobe_eq_zero_of_fifteen_eighth_le hlarge]
    ring

theorem shiftedDyadicReflectedNegativeProfile_eq_zero_of_not_mem_Icc
    (n : Nat) (rho u : Real) (hu : u ∉ Icc (1 / 2 : Real) 2) :
    shiftedDyadicReflectedNegativeProfile n (rho, u) = 0 := by
  by_cases hleft : u ≤ 1 / 2
  · have hsmall : u ≤ 5 / 8 := by linarith
    unfold shiftedDyadicReflectedNegativeProfile shiftedReflectedOuterProfile
      shiftedOuterParametricProfile
    rw [normalizedTelescopingReflectedNegativeLobe_eq_zero_of_le_five_eighth hsmall]
    ring
  · have hlow : 1 / 2 ≤ u := le_of_lt (lt_of_not_ge hleft)
    have hright : 2 ≤ u := by
      by_contra hnot
      exact hu ⟨hlow, le_of_lt (lt_of_not_ge hnot)⟩
    have hlarge : 15 / 8 ≤ u := by linarith
    unfold shiftedDyadicReflectedNegativeProfile shiftedReflectedOuterProfile
      shiftedOuterParametricProfile
    rw [normalizedTelescopingReflectedNegativeLobe_eq_zero_of_fifteen_eighth_le hlarge]
    ring

/-- Global angular form of the dyadic split, with the negative half already
written in the reflected coordinate expected by the Schur package. -/
theorem shiftedCharted_dyadicMultiplier_eq_affine_plus_reflected
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    {eps r : Real} (heps : 0 < eps) (K n k : Nat) (hk : k < K)
    (theta : Real) (xi : Euclidean 2)
    (hr : r = (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps)) :
    shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n (k + 1)
      theta xi =
      (shiftedDyadicPositiveProfile n
        (r, (theta - (C.angle j xi + stationaryShift n)) / r) : Complex) *
        scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
          (chartProfiles_compact C j q hqcompact) a (circleDirection theta) xi +
      (shiftedDyadicReflectedNegativeProfile n
        (r, ((C.angle j xi + stationaryShift n) - theta) / r) : Complex) *
        scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
          (chartProfiles_compact C j q hqcompact) a (circleDirection theta) xi := by
  let c : Real := C.angle j xi + stationaryShift n
  let u : Real := (theta - c) / r
  have hr0 : r ≠ 0 := by
    rw [hr]
    positivity
  have htheta : C.angle j xi + stationaryShift n + r * u = theta := by
    dsimp only [u, c]
    field_simp [hr0]
    ring
  have hreflect : shiftedDyadicNegativeProfile n (r, u) =
      shiftedDyadicReflectedNegativeProfile n (r, -u) := by
    simpa using shiftedDyadicTelescope_negative_reflect n r (-u)
  have hnegcoord : (c - theta) / r = -u := by
    dsimp only [u]
    field_simp [hr0]
    ring
  have hsplit := shiftedCharted_dyadicMultiplier_local_split
