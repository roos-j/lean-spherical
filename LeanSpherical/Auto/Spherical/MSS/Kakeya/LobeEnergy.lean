section

section Auto.Spherical.MSS

open Filter MeasureTheory Metric Set FourierTransform
open Auto.Spherical.SurfaceMeasureDecay
open scoped BigOperators FourierTransform EuclideanSpace

noncomputable section

universe u

/-- The literal fixed-frequency angular square energy of one normalized
profile.  `lambda` is intentionally signed: in the shifted stationary
cover it is `stationaryRadialSign n * ‖xi‖`. -/
noncomputable def shiftedFiberLobeEnergy
    (g : Real × Real → Real) (rho lambda : Real) (H : Real → Complex) : Real :=
  rho * ∫ u : Real,
    ‖ttstarAnalysis volume
      (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u‖ ^
      (2 : Nat) ∂(volume.restrict (Icc (1 / 2 : Real) 2))

/-- The literal source-time energy at a fixed spatial frequency. -/
noncomputable def shiftedFiberSourceEnergy
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2) : Real :=
  ∫ t : Real, ‖scratch_finiteTensorTimeData s q a xi t‖ ^ (2 : Nat)

theorem shiftedFiberSourceEnergy_nonneg
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2) :
    0 ≤ shiftedFiberSourceEnergy s q a xi := by
  unfold shiftedFiberSourceEnergy
  exact integral_nonneg fun _ => sq_nonneg _

/-- The Fourier-character analysis amplitude is jointly continuous as soon
as its real carrier profile is.  The phase lobes only carry joint angular
smoothness (because of the removable `sinc` normalization), so this weaker
form is deliberately kept separate from the older `ContDiff` helper. -/
theorem continuous_uncurry_outerCircleParametricAnalysis_of_continuous
    (g : Real × Real → Real) (hg : Continuous g) (rho lambda : Real) :
    Continuous (Function.uncurry
      (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)) := by
  unfold outerCircleParametricRealProfileFourierCharAnalysisAmplitude
  have hg' : Continuous (fun p : Real × Real => (g (rho, p.1) : Complex)) :=
    Complex.continuous_ofReal.comp
      (hg.comp (continuous_const.prodMk continuous_fst))
  have hp : Continuous (fun p : Real × Real =>
      (Real.fourierChar (-p.2 * lambda * Real.cos (rho * p.1)) : Complex)) := by
    have harg : Continuous (fun p : Real × Real =>
        -p.2 * lambda * Real.cos (rho * p.1)) := by fun_prop
    exact continuous_subtype_val.comp (Real.continuous_fourierChar.comp harg)
  exact hg'.mul hp

/-- Fubini-free compact-time E0 for a real lobe whose *product amplitude*
has the generic Schur data.  Unlike the older signed wrapper, this accepts
the literal finite tensor and its time support directly.  It is needed for
the scaled phase profiles, whose natural regularity is `HasJointSndSmooth`
rather than global `ContDiff`. -/
theorem exists_shiftedFiberLobeEnergy_E0_of_schurData
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (g : Real × Real → Real) (hgcont : Continuous g)
    (hg : HasGenericAmplitudeFourierSchurData rhoMax g) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, lambda ≠ 0 →
      ∀ {ι : Type*} (s : Finset ι)
        (q : ι → SchwartzMap (Euclidean 2) Complex)
        (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2)
        {rTime : Real}, rTime < 1 →
        (∀ l, Function.support (a l : Real → Complex) ⊆
          closedBall (3 / 2 : Real) rTime) →
      shiftedFiberLobeEnergy g rho lambda
        (scratch_finiteTensorTimeData s q a xi) ≤
        (B / (|lambda| * rho)) * shiftedFiberSourceEnergy s q a xi := by
  rcases hg with ⟨hA0, hA2, hleft, hright, hstar⟩
  rcases exists_outerCircleProfileFourierCharProductKernel_quadratic_E0_abs_restrict_Icc
      hrhoMax hrhoMax_small
      (outerCircleParametricRealProfileProductAmplitude g)
      hA0 hA2 hleft hright hstar with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda ι s q a xi rTime hrTime hsupport
  let H : Real → Complex := scratch_finiteTensorTimeData s q a xi
  let A := outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda
  have hHcont : Continuous H := continuous_scratch_finiteTensorTimeData s q a xi
  have hHsupport : Function.support H ⊆ Ioc (1 / 2 : Real) (5 / 2 : Real) :=
    (support_scratch_finiteTensorTimeData_subset_innerSlab s q a xi hsupport).trans
      (closedBall_innerSlab_subset_Ioc hrTime)
  have hlocal := hbound rho hrho lambda hlambda
    (1 / 2 : Real) (5 / 2 : Real) H hHcont
  rw [← outerCircleParametricRealProfileFourierCharAnalysis_ttstar_factorization_restrict_Icc
    g rho lambda (1 / 2 : Real) (5 / 2 : Real) hgcont H hHcont] at hlocal
  rw [integral_norm_sq_restrict_Icc_eq_volume_of_support_subset_Ioc
    H (by norm_num) hHsupport] at hlocal
  have hAcont : Continuous (Function.uncurry A) :=
    continuous_uncurry_outerCircleParametricAnalysis_of_continuous g hgcont rho lambda
  have hFrestrict : Integrable (fun u : Real =>
      ‖ttstarAnalysis (volume.restrict (Icc (1 / 2 : Real) (5 / 2 : Real))) A H u‖ ^
        (2 : Nat))
      (volume.restrict (Icc (1 / 2 : Real) 2)) :=
    integrable_norm_sq_ttstarAnalysis_restrict_Icc_of_continuous A hAcont H hHcont
  have hAnalysis (u : Real) :
      ttstarAnalysis (volume.restrict (Icc (1 / 2 : Real) (5 / 2 : Real))) A H u =
        ttstarAnalysis volume A H u :=
    ttstarAnalysis_restrict_Icc_eq_volume_of_support_subset_Ioc
      A H (by norm_num) hHsupport u
  have hF : Integrable (fun u : Real =>
      ‖ttstarAnalysis volume A H u‖ ^ (2 : Nat))
      (volume.restrict (Icc (1 / 2 : Real) 2)) := by
    apply hFrestrict.congr
    filter_upwards with u
    rw [hAnalysis]
  have hreal := norm_real_smul_integral_mul_star_eq
    (volume.restrict (Icc (1 / 2 : Real) 2)) rho (le_of_lt hrho.1)
    (fun u : Real => ttstarAnalysis volume A H u) hF
  change shiftedFiberLobeEnergy g rho lambda H ≤
    (B / (|lambda| * rho)) * shiftedFiberSourceEnergy s q a xi
  unfold shiftedFiberLobeEnergy shiftedFiberSourceEnergy
  rw [← hreal]
  simpa only [A, hAnalysis] using hlocal

/-- The cutoff-coordinate component of `E₁`, obtained from the same
compact-time generic Schur estimate with its literal `rho⁻²` weight. -/
theorem exists_shiftedFiberLobeEnergy_cutoff_E1_of_schurData
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (g : Real × Real → Real) (hgcont : Continuous g)
    (hg : HasGenericAmplitudeFourierSchurData rhoMax g) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, lambda ≠ 0 →
      ∀ {ι : Type*} (s : Finset ι)
        (q : ι → SchwartzMap (Euclidean 2) Complex)
        (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2)
        {rTime : Real}, rTime < 1 →
        (∀ l, Function.support (a l : Real → Complex) ⊆
          closedBall (3 / 2 : Real) rTime) →
      (rho ^ 2)⁻¹ * shiftedFiberLobeEnergy g rho lambda
        (scratch_finiteTensorTimeData s q a xi) ≤
        (rho ^ 2)⁻¹ * (B / (|lambda| * rho)) *
          shiftedFiberSourceEnergy s q a xi := by
  rcases exists_shiftedFiberLobeEnergy_E0_of_schurData
      hrhoMax hrhoMax_small g hgcont hg with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda ι s q a xi rTime hrTime hsupport
  simpa only [mul_assoc] using
    (mul_le_mul_of_nonneg_left
      (hbound rho hrho lambda hlambda s q a xi hrTime hsupport)
      (inv_nonneg.mpr (sq_nonneg rho)))

/-- The phase-factor component of `E₁`.  The carrier `lambda` remains
signed; only its literal squared physical scale is used here. -/
theorem exists_shiftedFiberLobeEnergy_phaseFactor_E1_of_schurData
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (g : Real × Real → Real) (hgcont : Continuous g)
    (hg : HasGenericAmplitudeFourierSchurData rhoMax g) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, lambda ≠ 0 →
      ∀ {ι : Type*} (s : Finset ι)
        (q : ι → SchwartzMap (Euclidean 2) Complex)
        (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2)
        {rTime : Real}, rTime < 1 →
        (∀ l, Function.support (a l : Real → Complex) ⊆
          closedBall (3 / 2 : Real) rTime) →
      (((2 * Real.pi) * lambda * rho) ^ 2) *
          shiftedFiberLobeEnergy g rho lambda
            (scratch_finiteTensorTimeData s q a xi) ≤
        (((2 * Real.pi) * lambda * rho) ^ 2) *
          (B / (|lambda| * rho)) * shiftedFiberSourceEnergy s q a xi := by
  rcases exists_shiftedFiberLobeEnergy_E0_of_schurData
      hrhoMax hrhoMax_small g hgcont hg with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda ι s q a xi rTime hrTime hsupport
  simpa only [mul_assoc] using
    (mul_le_mul_of_nonneg_left
      (hbound rho hrho lambda hlambda s q a xi hrTime hsupport)
      (sq_nonneg ((2 * Real.pi) * lambda * rho)))

/-- The phase-factor E1 conversion directly from Airy's finite joint
smoothness compact-time theorem.  This is the preferred route for the
removable-sinc phase profiles: it asks only for their actual angular jets
and endpoint vanishing, while the physical scale remains the signed-carrier
square `((2*pi)*lambda*rho)^2`. -/
theorem exists_shiftedFiberLobeEnergy_phaseFactor_E1_of_hasJoint
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (g : Real × Real → Real)
    (hg0 : HasJointSndSmooth 0 g) (hg2 : HasJointSndSmooth 2 g)
    (hleft : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds 2] 0) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, lambda ≠ 0 →
      ∀ {ι : Type*} (s : Finset ι)
        (q : ι → SchwartzMap (Euclidean 2) Complex)
        (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2)
        {rTime : Real}, rTime < 1 →
        (∀ l, Function.support (a l : Real → Complex) ⊆
          closedBall (3 / 2 : Real) rTime) →
      (((2 * Real.pi) * lambda * rho) ^ 2) *
          shiftedFiberLobeEnergy g rho lambda
            (scratch_finiteTensorTimeData s q a xi) ≤
        (((2 * Real.pi) * lambda * rho) ^ 2) *
          (B / (|lambda| * rho)) * shiftedFiberSourceEnergy s q a xi := by
  rcases exists_outerCircleParametricRealProfile_quadratic_E0_abs_of_support_subset_Ioc_of_hasJoint
      hrhoMax hrhoMax_small g hg0 hg2 hleft hright with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda ι s q a xi rTime hrTime hsupport
  let H : Real → Complex := scratch_finiteTensorTimeData s q a xi
  let A := outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda
  have hHcont : Continuous H := continuous_scratch_finiteTensorTimeData s q a xi
  have hHsupport : Function.support H ⊆ Ioc (1 / 2 : Real) (5 / 2 : Real) :=
    (support_scratch_finiteTensorTimeData_subset_innerSlab s q a xi hsupport).trans
      (closedBall_innerSlab_subset_Ioc hrTime)
  have hraw := hbound rho hrho lambda hlambda
    (1 / 2 : Real) (5 / 2 : Real) H hHcont (by norm_num) hHsupport
  have hgcont : Continuous g := by
    simpa [HasJointSndSmooth] using hg0
  have hAcont : Continuous (Function.uncurry A) :=
    continuous_uncurry_outerCircleParametricAnalysis_of_continuous g hgcont rho lambda
  have hFrestrict : Integrable (fun u : Real =>
      ‖ttstarAnalysis (volume.restrict (Icc (1 / 2 : Real) (5 / 2 : Real))) A H u‖ ^
        (2 : Nat))
      (volume.restrict (Icc (1 / 2 : Real) 2)) :=
    integrable_norm_sq_ttstarAnalysis_restrict_Icc_of_continuous A hAcont H hHcont
  have hAnalysis (u : Real) :
      ttstarAnalysis (volume.restrict (Icc (1 / 2 : Real) (5 / 2 : Real))) A H u =
        ttstarAnalysis volume A H u :=
    ttstarAnalysis_restrict_Icc_eq_volume_of_support_subset_Ioc
      A H (by norm_num) hHsupport u
  have hF : Integrable (fun u : Real =>
      ‖ttstarAnalysis volume A H u‖ ^ (2 : Nat))
      (volume.restrict (Icc (1 / 2 : Real) 2)) := by
    apply hFrestrict.congr
    filter_upwards with u
    rw [hAnalysis]
  have hreal := norm_real_smul_integral_mul_star_eq
    (volume.restrict (Icc (1 / 2 : Real) 2)) rho (le_of_lt hrho.1)
    (fun u : Real => ttstarAnalysis volume A H u) hF
  change (((2 * Real.pi) * lambda * rho) ^ 2) *
      shiftedFiberLobeEnergy g rho lambda H ≤
    (((2 * Real.pi) * lambda * rho) ^ 2) *
      (B / (|lambda| * rho)) * shiftedFiberSourceEnergy s q a xi
  unfold shiftedFiberLobeEnergy shiftedFiberSourceEnergy
  rw [← hreal]
  simpa only [A, hAnalysis, mul_assoc] using
    (mul_le_mul_of_nonneg_left hraw
      (sq_nonneg ((2 * Real.pi) * lambda * rho)))

/-- The concrete compact-time E0 theorem, put in the lobe-energy notation
used by the shifted stationary fibre transport. -/
theorem exists_shiftedFiberLobeEnergy_E0_of_contDiff
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (g : Real × Real → Real) (hg : ContDiff Real (⊤ : ℕ∞) g)
    (hleft : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds 2] 0) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, lambda ≠ 0 →
      ∀ {ι : Type*} (s : Finset ι)
        (q : ι → SchwartzMap (Euclidean 2) Complex)
        (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2)
        {rTime : Real}, rTime < 1 →
        (∀ l, Function.support (a l : Real → Complex) ⊆
          closedBall (3 / 2 : Real) rTime) →
      shiftedFiberLobeEnergy g rho lambda
        (scratch_finiteTensorTimeData s q a xi) ≤
        (B / (|lambda| * rho)) * shiftedFiberSourceEnergy s q a xi := by
  rcases exists_outerCircleParametricRealProfile_finiteTensorTimeData_realEnergy_E0
      hrhoMax hrhoMax_small g hg hleft hright with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda ι s q a xi rTime hrTime htime
  simpa only [shiftedFiberLobeEnergy, shiftedFiberSourceEnergy] using
    hbound rho hrho lambda hlambda s q a xi hrTime htime

/-- The Cauchy budget for two lobe energies.  It is stated separately from
the reflection identity so an annular integration can apply it after the
positive and reflected-negative fibre estimates have been transported. -/
theorem two_lobe_energy_budget_le
    {Eplus Eminus Bplus Bminus : Real}
    (hplus : Eplus ≤ Bplus) (hminus : Eminus ≤ Bminus) :
    2 * (Eplus + Eminus) ≤ 2 * (Bplus + Bminus) := by
  nlinarith

