/-- A restricted physical angular integral is controlled by the standard
unit-coordinate energy for an arbitrary continuous complex lobe. -/
theorem integral_norm_sq_affine_complex_lobe_restrict_le
    (P : Real -> Complex) (r c L U : Real) (hr : 0 < r)
    (hzero : ∀ u, u ∉ Icc (1 / 2 : Real) 2 -> P u = 0)
    (hPint : Integrable (fun theta : Real => ‖P ((theta - c) / r)‖ ^ (2 : Nat)) ) :
