section

section Auto.Spherical.MSS

open Filter Set

noncomputable section

/-- The normalized positive dyadic lobe after centring a shifted stationary
patch.  The carrier coordinate is the normalized `4/5` carrier used by the
outer Schur package. -/
noncomputable def shiftedDyadicPositiveProfile (n : Nat) : Real × Real → Real :=
  shiftedOuterParametricProfile n normalizedTelescopingPositiveLobe

/-- The signed negative dyadic lobe, retained for exact reconstruction of the
local cutoff before the standard reflection to the positive outer interval. -/
noncomputable def shiftedDyadicNegativeProfile (n : Nat) : Real × Real → Real :=
  shiftedOuterParametricProfile n normalizedTelescopingNegativeLobe

/-- Reflecting the carrier in the preweight is the positive-interval version
of the signed negative lobe. -/
noncomputable def shiftedReflectedOuterProfile
    (n : Nat) (lobe : Real → Real) (p : Real × Real) : Real :=
  shiftedOuterParametricProfile n lobe (-p.1, p.2)

/-- The reflected negative dyadic lobe, now supported in the standard outer
interval used by the Fourier-character Schur estimates. -/
noncomputable def shiftedDyadicReflectedNegativeProfile (n : Nat) : Real × Real → Real :=
  shiftedReflectedOuterProfile n normalizedTelescopingReflectedNegativeLobe

theorem contDiff_shiftedReflectedOuterProfile
    (n : Nat) (lobe : Real → Real) (hlobe : ContDiff Real (⊤ : ℕ∞) lobe) :
    ContDiff Real (⊤ : ℕ∞) (shiftedReflectedOuterProfile n lobe) := by
  unfold shiftedReflectedOuterProfile
  exact (contDiff_shiftedOuterParametricProfile n lobe hlobe).comp
    ((contDiff_neg.comp contDiff_fst).prodMk contDiff_snd)

theorem shiftedReflectedOuterProfile_eventuallyEq_zero_left
    (n : Nat) {lobe : Real → Real}
    (hleft : lobe =ᶠ[nhds (1 / 2 : Real)] 0) (rho : Real) :
    (fun u : Real => shiftedReflectedOuterProfile n lobe (rho, u)) =ᶠ[
      nhds (1 / 2 : Real)] 0 := by
  simpa [shiftedReflectedOuterProfile] using
    (shiftedOuterParametricProfile_eventuallyEq_zero_left n hleft (-rho))

theorem shiftedReflectedOuterProfile_eventuallyEq_zero_right
    (n : Nat) {lobe : Real → Real}
    (hright : lobe =ᶠ[nhds 2] 0) (rho : Real) :
    (fun u : Real => shiftedReflectedOuterProfile n lobe (rho, u)) =ᶠ[nhds 2] 0 := by
  simpa [shiftedReflectedOuterProfile] using
    (shiftedOuterParametricProfile_eventuallyEq_zero_right n hright (-rho))

/-- The normalized cutoff-coordinate derivative of a reflected local lobe.
The physical derivative is this profile divided by the carrier; that exact
factor is the `rho⁻²` factor in the generic cutoff-`E₁` Schur estimate. -/
noncomputable def shiftedReflectedOuterProfileSndDeriv
    (n : Nat) (lobe : Real → Real) : Real × Real → Real :=
  partialDerivSnd (shiftedReflectedOuterProfile n lobe)

theorem contDiff_shiftedReflectedOuterProfileSndDeriv
    (n : Nat) (lobe : Real → Real) (hlobe : ContDiff Real (⊤ : ℕ∞) lobe) :
    ContDiff Real (⊤ : ℕ∞) (shiftedReflectedOuterProfileSndDeriv n lobe) := by
  unfold shiftedReflectedOuterProfileSndDeriv
  exact contDiff_partialDerivSnd _
    (contDiff_shiftedReflectedOuterProfile n lobe hlobe)

theorem deriv_slice_shiftedReflectedOuterProfile_eq_sndDeriv
    (n : Nat) (lobe : Real → Real) (hlobe : ContDiff Real (⊤ : ℕ∞) lobe)
    (rho u : Real) :
    deriv (fun v : Real => shiftedReflectedOuterProfile n lobe (rho, v)) u =
      shiftedReflectedOuterProfileSndDeriv n lobe (rho, u) := by
  unfold shiftedReflectedOuterProfileSndDeriv
  exact deriv_slice_eq_partialDerivSnd _
    ((contDiff_shiftedReflectedOuterProfile n lobe hlobe).differentiable (by simp))
    rho u

theorem shiftedReflectedOuterProfileSndDeriv_eventuallyEq_zero_left
    (n : Nat) {lobe : Real → Real} (hlobe : ContDiff Real (⊤ : ℕ∞) lobe)
    (hleft : lobe =ᶠ[nhds (1 / 2 : Real)] 0) (rho : Real) :
    (fun u : Real => shiftedReflectedOuterProfileSndDeriv n lobe (rho, u)) =ᶠ[
      nhds (1 / 2 : Real)] 0 := by
  have hbase := (shiftedReflectedOuterProfile_eventuallyEq_zero_left n hleft rho).deriv
  filter_upwards [hbase] with u hu
  rw [← deriv_slice_shiftedReflectedOuterProfile_eq_sndDeriv n lobe hlobe]
  simpa using hu

theorem shiftedReflectedOuterProfileSndDeriv_eventuallyEq_zero_right
    (n : Nat) {lobe : Real → Real} (hlobe : ContDiff Real (⊤ : ℕ∞) lobe)
    (hright : lobe =ᶠ[nhds 2] 0) (rho : Real) :
    (fun u : Real => shiftedReflectedOuterProfileSndDeriv n lobe (rho, u)) =ᶠ[
      nhds 2] 0 := by
  have hbase := (shiftedReflectedOuterProfile_eventuallyEq_zero_right n hright rho).deriv
  filter_upwards [hbase] with u hu
  rw [← deriv_slice_shiftedReflectedOuterProfile_eq_sndDeriv n lobe hlobe]
  simpa using hu

/-- The removable phase factor after reflection.  Its finite jointly smooth
angular jet is supplied by `outerCircleScaledDerivative`, which is precisely
the regularity notion used by the generic phase-`E₁` theorem. -/
noncomputable def shiftedReflectedOuterScaledPhaseProfile
    (n : Nat) (lobe : Real → Real) (p : Real × Real) : Real :=
  shiftedReflectedOuterProfile n lobe p * outerCircleScaledDerivative p.1 p.2

theorem hasJointSndSmooth_shiftedReflectedOuterScaledPhaseProfile
    (n : Nat) (lobe : Real → Real) (hlobe : ContDiff Real (⊤ : ℕ∞) lobe)
    (N : Nat) :
    HasJointSndSmooth N (shiftedReflectedOuterScaledPhaseProfile n lobe) := by
  unfold shiftedReflectedOuterScaledPhaseProfile
  exact (hasJointSndSmooth_of_contDiff
    (shiftedReflectedOuterProfile n lobe)
    (contDiff_shiftedReflectedOuterProfile n lobe hlobe) N).mul_real
      (hasJointSndSmooth_outerCircleScaledDerivative N)

theorem shiftedReflectedOuterScaledPhaseProfile_eventuallyEq_zero_left
    (n : Nat) {lobe : Real → Real}
    (hleft : lobe =ᶠ[nhds (1 / 2 : Real)] 0) (rho : Real) :
    (fun u : Real => shiftedReflectedOuterScaledPhaseProfile n lobe (rho, u)) =ᶠ[
      nhds (1 / 2 : Real)] 0 := by
  filter_upwards [shiftedReflectedOuterProfile_eventuallyEq_zero_left n hleft rho] with u hu
  simp [shiftedReflectedOuterScaledPhaseProfile, hu]

theorem shiftedReflectedOuterScaledPhaseProfile_eventuallyEq_zero_right
    (n : Nat) {lobe : Real → Real}
    (hright : lobe =ᶠ[nhds 2] 0) (rho : Real) :
    (fun u : Real => shiftedReflectedOuterScaledPhaseProfile n lobe (rho, u)) =ᶠ[
      nhds 2] 0 := by
  filter_upwards [shiftedReflectedOuterProfile_eventuallyEq_zero_right n hright rho] with u hu
  simp [shiftedReflectedOuterScaledPhaseProfile, hu]

theorem shiftedDyadicNegativeProfile_reflect
    (n : Nat) (rho u : Real) :
    shiftedDyadicNegativeProfile n (rho, -u) =
      shiftedDyadicReflectedNegativeProfile n (rho, u) := by
  unfold shiftedDyadicNegativeProfile shiftedDyadicReflectedNegativeProfile
    shiftedReflectedOuterProfile shiftedOuterParametricProfile
    normalizedTelescopingReflectedNegativeLobe
  have harg : rho * -u = -rho * u := by ring
  rw [harg]

/-- After centring at the `n`th stationary shift, every noncentral dyadic
member is exactly the sum of its normalized signed lobes.  The carrier is
the `4/5` rescaling that places both reflected lobe estimates in the fixed
outer integration interval. -/
theorem shiftedCappedTelescopingCutoff_dyadic_local_eq_lobes
    {eps r : Real} (heps : 0 < eps) (K n k : Nat) (hk : k < K)
    (alpha u : Real)
    (hr : r = (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps)) :
    shiftedCappedTelescopingCutoff eps K n (k + 1) alpha
      (alpha + stationaryShift n + r * u) =
        shiftedDyadicPositiveProfile n (r, u) +
          shiftedDyadicNegativeProfile n (r, u) := by
  rw [shiftedCappedTelescopingCutoff_local_coordinate]
  rw [cappedTelescopingCutoff_eq_dyadic eps (Real.pi / 2) K (k + 1) (by omega)]
  rw [telescopingShellCutoff_succ_eq_normalizedLobes eps k hr (r * u)]
  have hrpos : 0 < r := by
    rw [hr]
    positivity
  have hratio : (r * u) / r = u := by
    field_simp [ne_of_gt hrpos]
  rw [hratio]
  unfold shiftedDyadicPositiveProfile shiftedDyadicNegativeProfile
    shiftedOuterParametricProfile
  ring

theorem contDiff_shiftedDyadicPositiveProfile (n : Nat) :
    ContDiff Real (⊤ : ℕ∞) (shiftedDyadicPositiveProfile n) := by
  simpa [shiftedDyadicPositiveProfile] using
    (contDiff_shiftedOuterParametricProfile n normalizedTelescopingPositiveLobe
      contDiff_normalizedTelescopingPositiveLobe)

theorem contDiff_shiftedDyadicNegativeProfile (n : Nat) :
    ContDiff Real (⊤ : ℕ∞) (shiftedDyadicNegativeProfile n) := by
  simpa [shiftedDyadicNegativeProfile] using
    (contDiff_shiftedOuterParametricProfile n normalizedTelescopingNegativeLobe
      contDiff_normalizedTelescopingNegativeLobe)

theorem contDiff_shiftedDyadicReflectedNegativeProfile (n : Nat) :
    ContDiff Real (⊤ : ℕ∞) (shiftedDyadicReflectedNegativeProfile n) := by
  simpa [shiftedDyadicReflectedNegativeProfile] using
    (contDiff_shiftedReflectedOuterProfile n normalizedTelescopingReflectedNegativeLobe
      contDiff_normalizedTelescopingReflectedNegativeLobe)

theorem shiftedDyadicPositiveProfile_eventuallyEq_zero_left
    (n : Nat) (rho : Real) :
    (fun u : Real => shiftedDyadicPositiveProfile n (rho, u)) =ᶠ[
      nhds (1 / 2 : Real)] 0 := by
  simpa [shiftedDyadicPositiveProfile] using
    (shiftedOuterParametricProfile_eventuallyEq_zero_left n
      normalizedTelescopingPositiveLobe_eventuallyEq_zero_left rho)

theorem shiftedDyadicPositiveProfile_eventuallyEq_zero_right
    (n : Nat) (rho : Real) :
    (fun u : Real => shiftedDyadicPositiveProfile n (rho, u)) =ᶠ[nhds 2] 0 := by
  simpa [shiftedDyadicPositiveProfile] using
    (shiftedOuterParametricProfile_eventuallyEq_zero_right n
      normalizedTelescopingPositiveLobe_eventuallyEq_zero_right rho)

theorem shiftedDyadicReflectedNegativeProfile_eventuallyEq_zero_left
    (n : Nat) (rho : Real) :
    (fun u : Real => shiftedDyadicReflectedNegativeProfile n (rho, u)) =ᶠ[
      nhds (1 / 2 : Real)] 0 := by
  simpa [shiftedDyadicReflectedNegativeProfile] using
    (shiftedReflectedOuterProfile_eventuallyEq_zero_left n
      normalizedTelescopingReflectedNegativeLobe_eventuallyEq_zero_left rho)

theorem shiftedDyadicReflectedNegativeProfile_eventuallyEq_zero_right
    (n : Nat) (rho : Real) :
    (fun u : Real => shiftedDyadicReflectedNegativeProfile n (rho, u)) =ᶠ[nhds 2] 0 := by
  simpa [shiftedDyadicReflectedNegativeProfile] using
    (shiftedReflectedOuterProfile_eventuallyEq_zero_right n
      normalizedTelescopingReflectedNegativeLobe_eventuallyEq_zero_right rho)

/-- This is exactly the hypothesis bundle consumed by
`KakeyaGenericAmplitudeFourierSchur`: a jointly smooth real profile, with
room at both integration endpoints, produces its self-conjugate square
amplitude. -/
theorem parametricProfile_productAmplitude_genericSchurData
    (g : Real × Real → Real) (hg : ContDiff Real (⊤ : ℕ∞) g)
    (hleft : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds 2] 0)
    (rhoMax : Real) :
    HasJointSndSmooth 0 (outerCircleParametricRealProfileProductAmplitude g) ∧
      HasJointSndSmooth 2 (outerCircleParametricRealProfileProductAmplitude g) ∧
      (∀ rho ∈ Ioc (0 : Real) rhoMax,
        (fun u : Real => outerCircleParametricRealProfileProductAmplitude g (rho, u)) =ᶠ[
          nhds (1 / 2 : Real)] 0) ∧
      (∀ rho ∈ Ioc (0 : Real) rhoMax,
        (fun u : Real => outerCircleParametricRealProfileProductAmplitude g (rho, u)) =ᶠ[
          nhds 2] 0) ∧
      (∀ p : Real × Real,
        starRingEnd Complex (outerCircleParametricRealProfileProductAmplitude g p) =
          outerCircleParametricRealProfileProductAmplitude g p) := by
  refine ⟨hasJointSndSmooth_outerCircleParametricRealProfileProductAmplitude g hg 0,
    hasJointSndSmooth_outerCircleParametricRealProfileProductAmplitude g hg 2, ?_, ?_, ?_⟩
  · intro rho _
    exact outerCircleParametricRealProfileProductAmplitude_eventuallyEq_zero_left hleft rho
  · intro rho _
    exact outerCircleParametricRealProfileProductAmplitude_eventuallyEq_zero_right hright rho
  · intro p
    exact star_outerCircleParametricRealProfileProductAmplitude g p

/-- The phase-`E₁` interface only has a finite jointly smooth angular jet
because of the removable circle derivative.  This variant is the exact same
Schur datum under that weaker, sufficient hypothesis. -/
theorem parametricProfile_productAmplitude_genericSchurData_of_hasJoint
    (g : Real × Real → Real)
    (hzero : HasJointSndSmooth 0 g) (htwo : HasJointSndSmooth 2 g)
    (hleft : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds 2] 0)
    (rhoMax : Real) :
    HasJointSndSmooth 0 (outerCircleParametricRealProfileProductAmplitude g) ∧
      HasJointSndSmooth 2 (outerCircleParametricRealProfileProductAmplitude g) ∧
      (∀ rho ∈ Ioc (0 : Real) rhoMax,
        (fun u : Real => outerCircleParametricRealProfileProductAmplitude g (rho, u)) =ᶠ[
          nhds (1 / 2 : Real)] 0) ∧
      (∀ rho ∈ Ioc (0 : Real) rhoMax,
        (fun u : Real => outerCircleParametricRealProfileProductAmplitude g (rho, u)) =ᶠ[
          nhds 2] 0) ∧
      (∀ p : Real × Real,
        starRingEnd Complex (outerCircleParametricRealProfileProductAmplitude g p) =
          outerCircleParametricRealProfileProductAmplitude g p) := by
  refine ⟨hasJointSndSmooth_outerCircleParametricRealProfileProductAmplitude_of_hasJoint hzero,
    hasJointSndSmooth_outerCircleParametricRealProfileProductAmplitude_of_hasJoint htwo,
    ?_, ?_, ?_⟩
  · intro rho _
    exact outerCircleParametricRealProfileProductAmplitude_eventuallyEq_zero_left hleft rho
  · intro rho _
    exact outerCircleParametricRealProfileProductAmplitude_eventuallyEq_zero_right hright rho
  · intro p
    exact star_outerCircleParametricRealProfileProductAmplitude g p

theorem shiftedDyadicPositiveProfile_productAmplitude_genericSchurData
    (n : Nat) (rhoMax : Real) :
    HasJointSndSmooth 0
        (outerCircleParametricRealProfileProductAmplitude (shiftedDyadicPositiveProfile n)) ∧
      HasJointSndSmooth 2
        (outerCircleParametricRealProfileProductAmplitude (shiftedDyadicPositiveProfile n)) ∧
      (∀ rho ∈ Ioc (0 : Real) rhoMax,
        (fun u : Real => outerCircleParametricRealProfileProductAmplitude
          (shiftedDyadicPositiveProfile n) (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0) ∧
      (∀ rho ∈ Ioc (0 : Real) rhoMax,
        (fun u : Real => outerCircleParametricRealProfileProductAmplitude
          (shiftedDyadicPositiveProfile n) (rho, u)) =ᶠ[nhds 2] 0) ∧
      (∀ p : Real × Real,
        starRingEnd Complex (outerCircleParametricRealProfileProductAmplitude
          (shiftedDyadicPositiveProfile n) p) =
          outerCircleParametricRealProfileProductAmplitude (shiftedDyadicPositiveProfile n) p) := by
  exact parametricProfile_productAmplitude_genericSchurData
    (shiftedDyadicPositiveProfile n) (contDiff_shiftedDyadicPositiveProfile n)
    (shiftedDyadicPositiveProfile_eventuallyEq_zero_left n)
    (shiftedDyadicPositiveProfile_eventuallyEq_zero_right n) rhoMax

theorem shiftedDyadicReflectedNegativeProfile_productAmplitude_genericSchurData
    (n : Nat) (rhoMax : Real) :
    HasJointSndSmooth 0
        (outerCircleParametricRealProfileProductAmplitude
          (shiftedDyadicReflectedNegativeProfile n)) ∧
      HasJointSndSmooth 2
        (outerCircleParametricRealProfileProductAmplitude
          (shiftedDyadicReflectedNegativeProfile n)) ∧
      (∀ rho ∈ Ioc (0 : Real) rhoMax,
        (fun u : Real => outerCircleParametricRealProfileProductAmplitude
          (shiftedDyadicReflectedNegativeProfile n) (rho, u)) =ᶠ[
            nhds (1 / 2 : Real)] 0) ∧
      (∀ rho ∈ Ioc (0 : Real) rhoMax,
        (fun u : Real => outerCircleParametricRealProfileProductAmplitude
          (shiftedDyadicReflectedNegativeProfile n) (rho, u)) =ᶠ[nhds 2] 0) ∧
      (∀ p : Real × Real,
        starRingEnd Complex (outerCircleParametricRealProfileProductAmplitude
          (shiftedDyadicReflectedNegativeProfile n) p) =
          outerCircleParametricRealProfileProductAmplitude
            (shiftedDyadicReflectedNegativeProfile n) p) := by
  exact parametricProfile_productAmplitude_genericSchurData
    (shiftedDyadicReflectedNegativeProfile n)
    (contDiff_shiftedDyadicReflectedNegativeProfile n)
    (shiftedDyadicReflectedNegativeProfile_eventuallyEq_zero_left n)
    (shiftedDyadicReflectedNegativeProfile_eventuallyEq_zero_right n) rhoMax

/-- The normalized derivative lobe supplied to the cutoff part of `E₁`.
The outer Schur wrapper inserts the required physical `rho⁻²` factor. -/
noncomputable def shiftedDyadicPositiveCutoffDerivativeProfile
