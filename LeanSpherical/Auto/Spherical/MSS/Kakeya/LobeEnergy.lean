/-- Joint continuity of the literal Fourier-character product kernel.  This
is the compact-time regularity input for the local symmetric-Schur lemma. -/
theorem continuous_outerCircleProfileFourierCharProductKernel
    (A : Real × Real → Complex) (hA : Continuous A) (rho lambda : Real) :
    Continuous (Function.uncurry
      (outerCircleProfileFourierCharProductKernel A rho lambda)) := by
  let f : (Real × Real) → Real → Complex := fun p u =>
    A (rho, u) *
      (Real.fourierChar (-(p.1 - p.2) * lambda * Real.cos (rho * u)) : Complex)
  have hamp : Continuous (fun u : Real => A (rho, u)) :=
    hA.comp (continuous_const.prodMk continuous_id)
  have hf : Continuous (Function.uncurry f) := by
    dsimp [f]
    apply (hamp.comp continuous_snd).mul
    fun_prop
  have hparam : Continuous (fun p : Real × Real =>
      ∫ u in Icc (1 / 2 : Real) 2, f p u) :=
    continuous_parametric_integral_of_continuous (μ := volume) hf isCompact_Icc
  have heq : (fun p : Real × Real => ∫ u in (1 / 2 : Real)..2, f p u) =
      fun p : Real × Real => ∫ u in Icc (1 / 2 : Real) 2, f p u := by
    funext p
    rw [intervalIntegral.integral_of_le (by norm_num : (1 / 2 : Real) ≤ 2),
      ← integral_Icc_eq_integral_Ioc]
  unfold outerCircleProfileFourierCharProductKernel
  change Continuous (fun p : Real × Real => (rho : Complex) *
    ∫ u in (1 / 2 : Real)..2, f p u)
  apply continuous_const.mul
  rw [heq]
  exact hparam

