/-- A local Fourier-character analysis vanishes wherever its real lobe
profile vanishes.  This is the pointwise support bridge that turns the
`Icc(1/2,2)` local E1 identities into genuine global angular fields. -/
theorem ttstarAnalysis_parametricProfile_eq_zero_of_profile_eq_zero
    (g : Real × Real -> Real) (rho lambda u : Real) (H : Real -> Complex)
    (hg : g (rho, u) = 0) :
    ttstarAnalysis volume
      (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u = 0 := by
  unfold ttstarAnalysis outerCircleParametricRealProfileFourierCharAnalysisAmplitude
  simp [hg]

/-- Compact time support lets one use the standard compact-domain
parametric-integral continuity theorem for the whole-line TT* analysis. -/
theorem continuous_ttstarAnalysis_of_compact_time_support
    (A : Real -> Real -> Complex) (hA : Continuous (Function.uncurry A))
    (H : Real -> Complex) (hH : Continuous H)
    {t0 t1 : Real} (htime : t0 ≤ t1)
    (hHsupport : Function.support H ⊆ Ioc t0 t1) :
    Continuous (fun u : Real => ttstarAnalysis volume A H u) := by
  have hG : Continuous (fun p : Real × Real => A p.1 p.2 * H p.2) :=
    hA.mul (hH.comp continuous_snd)
  have hrestrict : Continuous (fun u : Real =>
      ttstarAnalysis (volume.restrict (Icc t0 t1)) A H u) := by
    unfold ttstarAnalysis
    change Continuous (fun u : Real => ∫ t in Icc t0 t1, A u t * H t)
    exact continuous_parametric_integral_of_continuous (μ := volume) hG isCompact_Icc
  apply hrestrict.congr
  intro u
  exact ttstarAnalysis_restrict_Icc_eq_volume_of_support_subset_Ioc
    A H htime hHsupport u

/-- The preceding compact-time continuity lemma specialized to the literal
Fourier-character real-profile amplitude. -/
theorem continuous_ttstarAnalysis_parametricProfile_of_compact_time_support
    (g : Real × Real -> Real) (hg : Continuous g) (rho lambda : Real)
    (H : Real -> Complex) (hH : Continuous H)
    {t0 t1 : Real} (htime : t0 ≤ t1)
    (hHsupport : Function.support H ⊆ Ioc t0 t1) :
    Continuous (fun u : Real => ttstarAnalysis volume
      (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u) := by
  apply continuous_ttstarAnalysis_of_compact_time_support
    (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) ?_ H hH
    htime hHsupport
  unfold outerCircleParametricRealProfileFourierCharAnalysisAmplitude
  have hg' : Continuous (fun p : Real × Real => (g (rho, p.1) : Complex)) :=
