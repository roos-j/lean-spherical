      (mcp theta xi + mcm theta xi)) (volume.restrict (Icc lo hi)) :=
    hcpmeas.add hcmmeas
  have hphasemeas : AEStronglyMeasurable (fun theta : Real =>
      (mpp theta xi + mpm theta xi)) (volume.restrict (Icc lo hi)) :=
    hppmeas.add hpmmeas
