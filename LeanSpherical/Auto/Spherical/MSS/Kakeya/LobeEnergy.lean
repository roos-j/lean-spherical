    r * ∫ u : Real, H u ∂(volume.restrict (Icc (1 / 2 : Real) 2))
  calc
    (∫ theta : Real, F theta ∂(volume.restrict (Icc L U))) ≤
        ∫ theta : Real, F theta := hmono
    _ = r * ∫ u : Real, H u := haffine
    _ = r * ∫ u : Real, H u ∂(volume.restrict (Icc (1 / 2 : Real) 2)) := by
      rw [hrestrict]

/-- The reflected angular side has the same carrier factor and the same
standard positive-coordinate energy. -/
theorem integral_norm_sq_reflected_affine_complex_lobe_restrict_le
    (P : Real -> Complex) (r c L U : Real) (hr : 0 < r)
    (hzero : ∀ u, u ∉ Icc (1 / 2 : Real) 2 -> P u = 0)
    (hPint : Integrable (fun theta : Real => ‖P ((c - theta) / r)‖ ^ (2 : Nat)) ) :
