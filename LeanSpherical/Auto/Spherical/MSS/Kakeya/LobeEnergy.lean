theorem integrable_norm_sq_affine_complex_lobe
    (P : Real -> Complex) (r c : Real) (hr : 0 < r)
    (hPcont : Continuous P)
    (hzero : ∀ u, u ∉ Icc (1 / 2 : Real) 2 -> P u = 0) :
    Integrable (fun theta : Real => ‖P ((theta - c) / r)‖ ^ (2 : Nat)) := by
  let F : Real -> Real := fun theta => ‖P ((theta - c) / r)‖ ^ (2 : Nat)
  have hFcont : Continuous F := by
    dsimp only [F]
    fun_prop
  have hcompact : HasCompactSupport F := by
    apply HasCompactSupport.intro
      (isCompact_Icc : IsCompact (Icc (c + r / 2) (c + 2 * r)))
    intro theta htheta
    have harg : (theta - c) / r ∉ Icc (1 / 2 : Real) 2 := by
      intro hmem
      have hlo : 1 / 2 ≤ (theta - c) / r := hmem.1
      have hhi : (theta - c) / r ≤ 2 := hmem.2
