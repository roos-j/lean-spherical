/-- Pull a constant complex scalar out of a restricted square-norm energy. -/
theorem integral_norm_sq_const_mul
    (z : Complex) (F : Real -> Complex) (mu : Measure Real) :
    (∫ u : Real, ‖z * F u‖ ^ (2 : Nat) ∂mu) =
      ‖z‖ ^ (2 : Nat) * ∫ u : Real, ‖F u‖ ^ (2 : Nat) ∂mu := by
  rw [show (fun u : Real => ‖z * F u‖ ^ (2 : Nat)) =
      fun u => ‖z‖ ^ (2 : Nat) * ‖F u‖ ^ (2 : Nat) by
        funext u
        rw [norm_mul, mul_pow]]
  rw [integral_const_mul]

/-- Four-term Cauchy recombination for one fixed-frequency angular square
energy.  The grouping is deliberately `cutoff + phase`, with each group
split into its positive and reflected lobe.  This is the exact algebraic
shape consumed by the two-lobe E1 Schur budgets. -/
theorem shellFrequencyEnergy_four_terms_le
    (mcp mcm mpp mpm : Real -> Euclidean 2 -> Complex)
    (lo hi : Real) (xi : Euclidean 2)
    (hcpmeas : AEStronglyMeasurable (fun theta : Real => mcp theta xi)
