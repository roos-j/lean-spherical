/-- A source-ready literal E0 lobe estimate.  The finite tensor and the
strict compact-time support are part of the interface, so no Fubini witness
is left for the annular integration step. -/
def HasShiftedFiberE0Bound (rhoMax B : Real) (g : Real × Real → Real) : Prop :=
  0 < B ∧
    ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, lambda ≠ 0 →
    ∀ {ι : Type u} (s : Finset ι)
      (q : ι → SchwartzMap (Euclidean 2) Complex)
      (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2)
      {rTime : Real}, rTime < 1 →
      (∀ l, Function.support (a l : Real → Complex) ⊆
        closedBall (3 / 2 : Real) rTime) →
    shiftedFiberLobeEnergy g rho lambda
      (scratch_finiteTensorTimeData s q a xi) ≤
      (B / (|lambda| * rho)) * shiftedFiberSourceEnergy s q a xi

/-- The cutoff-coordinate part of a source-ready literal E1 lobe estimate. -/
def HasShiftedFiberCutoffE1Bound (rhoMax B : Real) (g : Real × Real → Real) : Prop :=
  0 < B ∧
    ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, lambda ≠ 0 →
    ∀ {ι : Type u} (s : Finset ι)
      (q : ι → SchwartzMap (Euclidean 2) Complex)
      (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2)
      {rTime : Real}, rTime < 1 →
      (∀ l, Function.support (a l : Real → Complex) ⊆
        closedBall (3 / 2 : Real) rTime) →
    (rho ^ 2)⁻¹ * shiftedFiberLobeEnergy g rho lambda
      (scratch_finiteTensorTimeData s q a xi) ≤
      (rho ^ 2)⁻¹ * (B / (|lambda| * rho)) *
        shiftedFiberSourceEnergy s q a xi

/-- The phase-factor part of a source-ready literal E1 lobe estimate. -/
def HasShiftedFiberPhaseE1Bound (rhoMax B : Real) (g : Real × Real → Real) : Prop :=
  0 < B ∧
    ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, lambda ≠ 0 →
    ∀ {ι : Type u} (s : Finset ι)
      (q : ι → SchwartzMap (Euclidean 2) Complex)
      (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2)
      {rTime : Real}, rTime < 1 →
      (∀ l, Function.support (a l : Real → Complex) ⊆
        closedBall (3 / 2 : Real) rTime) →
    (((2 * Real.pi) * lambda * rho) ^ 2) * shiftedFiberLobeEnergy g rho lambda
      (scratch_finiteTensorTimeData s q a xi) ≤
      (((2 * Real.pi) * lambda * rho) ^ 2) *
        (B / (|lambda| * rho)) * shiftedFiberSourceEnergy s q a xi

/-- The six literal real-energy bounds for the positive and reflected
negative lobes of one capped telescope piece.  The carrier argument in
every field is signed, hence this can be instantiated by
`stationaryRadialSign n * ‖xi‖` without an absolute-value rewrite. -/
structure ShiftedFiberTwoLobeEnergyBounds (rhoMax : Real)
    (g0plus g0minus gcutplus gcutminus gphaseplus gphaseminus :
      Real × Real → Real) : Type where
  B0plus : Real
  B0minus : Real
  Bcutplus : Real
  Bcutminus : Real
  Bphaseplus : Real
  Bphaseminus : Real
  e0plus : HasShiftedFiberE0Bound.{u} rhoMax B0plus g0plus
  e0minus : HasShiftedFiberE0Bound.{u} rhoMax B0minus g0minus
  cutoffplus : HasShiftedFiberCutoffE1Bound.{u} rhoMax Bcutplus gcutplus
  cutoffminus : HasShiftedFiberCutoffE1Bound.{u} rhoMax Bcutminus gcutminus
  phaseplus : HasShiftedFiberPhaseE1Bound.{u} rhoMax Bphaseplus gphaseplus
  phaseminus : HasShiftedFiberPhaseE1Bound.{u} rhoMax Bphaseminus gphaseminus

/-- Finite Cauchy recombination for the E0 pair.  The left side is exactly
the two-lobe energy budget to which the pointwise square of a sum is sent. -/
theorem ShiftedFiberTwoLobeEnergyBounds.e0_two_lobe_budget
    {rhoMax : Real}
    {g0plus g0minus gcutplus gcutminus gphaseplus gphaseminus :
      Real × Real → Real}
    (D : ShiftedFiberTwoLobeEnergyBounds.{u} rhoMax
      g0plus g0minus gcutplus gcutminus gphaseplus gphaseminus)
    {rho lambda : Real} (hrho : rho ∈ Ioc (0 : Real) rhoMax)
    (hlambda : lambda ≠ 0)
    {ι : Type u} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2)
    {rTime : Real} (hrTime : rTime < 1)
    (hsupport : ∀ l, Function.support (a l : Real → Complex) ⊆
      closedBall (3 / 2 : Real) rTime) :
    2 * (shiftedFiberLobeEnergy g0plus rho lambda
        (scratch_finiteTensorTimeData s q a xi) +
      shiftedFiberLobeEnergy g0minus rho lambda
        (scratch_finiteTensorTimeData s q a xi)) ≤
      2 * ((D.B0plus / (|lambda| * rho)) * shiftedFiberSourceEnergy s q a xi +
        (D.B0minus / (|lambda| * rho)) * shiftedFiberSourceEnergy s q a xi) := by
  exact two_lobe_energy_budget_le
    (D.e0plus.2 rho hrho lambda hlambda s q a xi hrTime hsupport)
    (D.e0minus.2 rho hrho lambda hlambda s q a xi hrTime hsupport)

/-- Finite Cauchy recombination for the cutoff-coordinate E1 pair. -/
theorem ShiftedFiberTwoLobeEnergyBounds.cutoff_two_lobe_budget
    {rhoMax : Real}
    {g0plus g0minus gcutplus gcutminus gphaseplus gphaseminus :
      Real × Real → Real}
    (D : ShiftedFiberTwoLobeEnergyBounds.{u} rhoMax
      g0plus g0minus gcutplus gcutminus gphaseplus gphaseminus)
    {rho lambda : Real} (hrho : rho ∈ Ioc (0 : Real) rhoMax)
    (hlambda : lambda ≠ 0)
    {ι : Type u} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2)
    {rTime : Real} (hrTime : rTime < 1)
    (hsupport : ∀ l, Function.support (a l : Real → Complex) ⊆
      closedBall (3 / 2 : Real) rTime) :
    2 * ((rho ^ 2)⁻¹ * shiftedFiberLobeEnergy gcutplus rho lambda
        (scratch_finiteTensorTimeData s q a xi) +
      (rho ^ 2)⁻¹ * shiftedFiberLobeEnergy gcutminus rho lambda
        (scratch_finiteTensorTimeData s q a xi)) ≤
      2 * ((rho ^ 2)⁻¹ * (D.Bcutplus / (|lambda| * rho)) *
          shiftedFiberSourceEnergy s q a xi +
        (rho ^ 2)⁻¹ * (D.Bcutminus / (|lambda| * rho)) *
          shiftedFiberSourceEnergy s q a xi) := by
  exact two_lobe_energy_budget_le
    (D.cutoffplus.2 rho hrho lambda hlambda s q a xi hrTime hsupport)
    (D.cutoffminus.2 rho hrho lambda hlambda s q a xi hrTime hsupport)

/-- Finite Cauchy recombination for the phase-factor E1 pair. -/
theorem ShiftedFiberTwoLobeEnergyBounds.phase_two_lobe_budget
    {rhoMax : Real}
    {g0plus g0minus gcutplus gcutminus gphaseplus gphaseminus :
      Real × Real → Real}
    (D : ShiftedFiberTwoLobeEnergyBounds.{u} rhoMax
      g0plus g0minus gcutplus gcutminus gphaseplus gphaseminus)
    {rho lambda : Real} (hrho : rho ∈ Ioc (0 : Real) rhoMax)
    (hlambda : lambda ≠ 0)
    {ι : Type u} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2)
    {rTime : Real} (hrTime : rTime < 1)
    (hsupport : ∀ l, Function.support (a l : Real → Complex) ⊆
      closedBall (3 / 2 : Real) rTime) :
    2 * ((((2 * Real.pi) * lambda * rho) ^ 2) *
        shiftedFiberLobeEnergy gphaseplus rho lambda
          (scratch_finiteTensorTimeData s q a xi) +
      (((2 * Real.pi) * lambda * rho) ^ 2) *
        shiftedFiberLobeEnergy gphaseminus rho lambda
          (scratch_finiteTensorTimeData s q a xi)) ≤
      2 * ((((2 * Real.pi) * lambda * rho) ^ 2) *
          (D.Bphaseplus / (|lambda| * rho)) * shiftedFiberSourceEnergy s q a xi +
        (((2 * Real.pi) * lambda * rho) ^ 2) *
          (D.Bphaseminus / (|lambda| * rho)) * shiftedFiberSourceEnergy s q a xi) := by
  exact two_lobe_energy_budget_le
    (D.phaseplus.2 rho hrho lambda hlambda s q a xi hrTime hsupport)
    (D.phaseminus.2 rho hrho lambda hlambda s q a xi hrTime hsupport)

/-- The full source-ready dyadic telescope lobe package: E0, cutoff E1,
and phase E1 for the positive and reflected negative halves.  It is
intended to be unpacked once per stationary patch and then transported by
the affine lobe map before annular integration. -/
theorem nonempty_shiftedDyadicFiberLobeEnergyBounds
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) (n : Nat) :
    Nonempty (ShiftedFiberTwoLobeEnergyBounds.{u} rhoMax
      (shiftedDyadicPositiveProfile n)
      (shiftedDyadicReflectedNegativeProfile n)
      (shiftedDyadicPositiveCutoffDerivativeProfile n)
      (shiftedDyadicReflectedNegativeCutoffDerivativeProfile n)
      (shiftedDyadicPositiveScaledPhaseProfile n)
      (shiftedDyadicReflectedNegativeScaledPhaseProfile n)) := by
  rcases exists_shiftedDyadicPositiveFiberEnergy_E0
      hrhoMax hrhoMax_small n with ⟨B0plus, hB0plus, h0plus⟩
  rcases exists_shiftedDyadicReflectedNegativeFiberEnergy_E0
      hrhoMax hrhoMax_small n with ⟨B0minus, hB0minus, h0minus⟩
  rcases exists_shiftedDyadicPositiveFiberEnergy_cutoff_E1
      hrhoMax hrhoMax_small n with ⟨Bcutplus, hBcutplus, hcutplus⟩
  rcases exists_shiftedDyadicReflectedNegativeFiberEnergy_cutoff_E1
      hrhoMax hrhoMax_small n with ⟨Bcutminus, hBcutminus, hcutminus⟩
  rcases exists_shiftedDyadicPositiveFiberEnergy_phaseFactor_E1
      hrhoMax hrhoMax_small n with ⟨Bphaseplus, hBphaseplus, hphaseplus⟩
  rcases exists_shiftedDyadicReflectedNegativeFiberEnergy_phaseFactor_E1
      hrhoMax hrhoMax_small n with ⟨Bphaseminus, hBphaseminus, hphaseminus⟩
  exact ⟨{
    B0plus := B0plus
    B0minus := B0minus
    Bcutplus := Bcutplus
    Bcutminus := Bcutminus
    Bphaseplus := Bphaseplus
    Bphaseminus := Bphaseminus
    e0plus := ⟨hB0plus, h0plus⟩
    e0minus := ⟨hB0minus, h0minus⟩
    cutoffplus := ⟨hBcutplus, hcutplus⟩
    cutoffminus := ⟨hBcutminus, hcutminus⟩
    phaseplus := ⟨hBphaseplus, hphaseplus⟩
    phaseminus := ⟨hBphaseminus, hphaseminus⟩
  }⟩

/-- The full source-ready capped terminal telescope lobe package.  The
actual cap ratio is retained as `c ∈ [1/2,1]`; all six constants may depend
on this fixed terminal ratio, but never on the fibre carrier or tensor. -/
theorem nonempty_shiftedCappedTerminalFiberLobeEnergyBounds
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) (n : Nat)
    {c : Real} (hc : c ∈ Icc (1 / 2 : Real) 1) :
    Nonempty (ShiftedFiberTwoLobeEnergyBounds.{u} rhoMax
      (shiftedCappedTerminalPositiveProfile n c)
      (shiftedCappedTerminalReflectedNegativeProfile n c)
      (shiftedCappedTerminalPositiveCutoffDerivativeProfile n c)
      (shiftedCappedTerminalReflectedNegativeCutoffDerivativeProfile n c)
      (shiftedCappedTerminalPositiveScaledPhaseProfile n c)
      (shiftedCappedTerminalReflectedNegativeScaledPhaseProfile n c)) := by
  rcases exists_shiftedCappedTerminalPositiveFiberEnergy_E0
      hrhoMax hrhoMax_small n hc with ⟨B0plus, hB0plus, h0plus⟩
  rcases exists_shiftedCappedTerminalReflectedNegativeFiberEnergy_E0
      hrhoMax hrhoMax_small n hc with ⟨B0minus, hB0minus, h0minus⟩
  rcases exists_shiftedCappedTerminalPositiveFiberEnergy_cutoff_E1
      hrhoMax hrhoMax_small n hc with ⟨Bcutplus, hBcutplus, hcutplus⟩
  rcases exists_shiftedCappedTerminalReflectedNegativeFiberEnergy_cutoff_E1
      hrhoMax hrhoMax_small n hc with ⟨Bcutminus, hBcutminus, hcutminus⟩
  rcases exists_shiftedCappedTerminalPositiveFiberEnergy_phaseFactor_E1
      hrhoMax hrhoMax_small n hc with ⟨Bphaseplus, hBphaseplus, hphaseplus⟩
  rcases exists_shiftedCappedTerminalReflectedNegativeFiberEnergy_phaseFactor_E1
      hrhoMax hrhoMax_small n hc with ⟨Bphaseminus, hBphaseminus, hphaseminus⟩
  exact ⟨{
    B0plus := B0plus
    B0minus := B0minus
    Bcutplus := Bcutplus
    Bcutminus := Bcutminus
    Bphaseplus := Bphaseplus
    Bphaseminus := Bphaseminus
    e0plus := ⟨hB0plus, h0plus⟩
    e0minus := ⟨hB0minus, h0minus⟩
    cutoffplus := ⟨hBcutplus, hcutplus⟩
    cutoffminus := ⟨hBcutminus, hcutminus⟩
