      contDiff_normalizedTelescopingPositiveLobe)

theorem contDiff_shiftedDyadicReflectedNegativeCutoffDerivativeProfile (n : Nat) :
    ContDiff Real (⊤ : ℕ∞)
      (shiftedDyadicReflectedNegativeCutoffDerivativeProfile n) := by
  simpa [shiftedDyadicReflectedNegativeCutoffDerivativeProfile] using
    (contDiff_shiftedReflectedOuterProfileSndDeriv n
      normalizedTelescopingReflectedNegativeLobe
      contDiff_normalizedTelescopingReflectedNegativeLobe)

theorem hasJointSndSmooth_shiftedDyadicPositiveScaledPhaseProfile
    (n N : Nat) :
    HasJointSndSmooth N (shiftedDyadicPositiveScaledPhaseProfile n) := by
  simpa [shiftedDyadicPositiveScaledPhaseProfile] using
    (hasJointSndSmooth_shiftedOuterParametricScaledPhaseProfile n
      normalizedTelescopingPositiveLobe contDiff_normalizedTelescopingPositiveLobe N)

theorem hasJointSndSmooth_shiftedDyadicReflectedNegativeScaledPhaseProfile
    (n N : Nat) :
    HasJointSndSmooth N (shiftedDyadicReflectedNegativeScaledPhaseProfile n) := by
  simpa [shiftedDyadicReflectedNegativeScaledPhaseProfile] using
    (hasJointSndSmooth_shiftedReflectedOuterScaledPhaseProfile n
      normalizedTelescopingReflectedNegativeLobe
      contDiff_normalizedTelescopingReflectedNegativeLobe N)

theorem shiftedDyadicPositiveCutoffDerivativeProfile_eventuallyEq_zero_left
    (n : Nat) (rho : Real) :
    (fun u : Real => shiftedDyadicPositiveCutoffDerivativeProfile n (rho, u)) =ᶠ[
      nhds (1 / 2 : Real)] 0 := by
  simpa [shiftedDyadicPositiveCutoffDerivativeProfile] using
    (shiftedOuterParametricProfileSndDeriv_eventuallyEq_zero_left n
      contDiff_normalizedTelescopingPositiveLobe
      normalizedTelescopingPositiveLobe_eventuallyEq_zero_left rho)

theorem shiftedDyadicPositiveCutoffDerivativeProfile_eventuallyEq_zero_right
    (n : Nat) (rho : Real) :
    (fun u : Real => shiftedDyadicPositiveCutoffDerivativeProfile n (rho, u)) =ᶠ[
