            ‖outerCircleProfileFourierCharProductKernel A rho lambda t s‖ :=
        integral_mono_measure Measure.restrict_le_self
          (Filter.Eventually.of_forall fun s => norm_nonneg _) hrow.1
      _ ≤ R := hrow.2
  have hschur := norm_integral_integral_restrict_Icc_le_of_symmetricSchur
    (a := t0) (b := t1)
    (outerCircleProfileFourierCharProductKernel A rho lambda) hKcont hsymm hrowbound H hHcont
  have hrho_pos : 0 < rho := hrho.1
  have habs_pos : 0 < |lambda| := abs_pos.mpr hlambda
  have hR : R = B / (|lambda| * rho) := by
    dsimp [R]
    field_simp [Real.pi_ne_zero, ne_of_gt habs_pos, ne_of_gt hrho_pos]
  simpa only [μT, hR] using hschur

/-- Exact compact-time `TT*` factorization for the literal parametric real
lobe.  Unlike the earlier whole-line theorem, no abstract Fubini record is
required. -/
theorem outerCircleParametricRealProfileFourierCharAnalysis_ttstar_factorization_restrict_Icc
    (g : Real × Real → Real) (rho lambda t0 t1 : Real)
    (hg : Continuous g) (H : Real → Complex) (hHcont : Continuous H) :
    (rho : Complex) *
      ∫ u : Real,
        ttstarAnalysis (volume.restrict (Icc t0 t1))
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u *
          starRingEnd Complex
            (ttstarAnalysis (volume.restrict (Icc t0 t1))
              (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u)
        ∂(volume.restrict (Icc (1 / 2 : Real) 2)) =
      ∫ t : Real, ∫ s : Real,
        outerCircleProfileFourierCharProductKernel
          (outerCircleParametricRealProfileProductAmplitude g) rho lambda t s * H t *
          starRingEnd Complex (H s)
        ∂(volume.restrict (Icc t0 t1)) ∂(volume.restrict (Icc t0 t1)) := by
  let AU : Real → Real → Complex :=
    outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda
  have hAUcont : Continuous (Function.uncurry AU) := by
    change Continuous (fun p : Real × Real =>
      (g (rho, p.1) : Complex) *
        (Real.fourierChar (-p.2 * lambda * Real.cos (rho * p.1)) : Complex))
    have hg' : Continuous (fun p : Real × Real => g (rho, p.1)) :=
      hg.comp (continuous_const.prodMk continuous_fst)
    apply (Complex.continuous_ofReal.comp hg').mul
    fun_prop
  have hbase := ttstar_factorization_restrict_Icc_of_continuous
    (u0 := (1 / 2 : Real)) (u1 := 2) (t0 := t0) (t1 := t1) AU hAUcont H hHcont
  have hkernel (t s : Real) :
      (rho : Complex) *
        ttstarKernel (volume.restrict (Icc (1 / 2 : Real) 2)) AU t s =
        outerCircleProfileFourierCharProductKernel
          (outerCircleParametricRealProfileProductAmplitude g) rho lambda t s := by
    calc
      (rho : Complex) *
          ttstarKernel (volume.restrict (Icc (1 / 2 : Real) 2)) AU t s =
          (rho : Complex) *
            ttstarKernel (volume.restrict (Ioc (1 / 2 : Real) 2)) AU t s := by
              unfold ttstarKernel
              rw [integral_Icc_eq_integral_Ioc]
      _ = outerCircleProfileFourierCharProductKernel
          (outerCircleParametricRealProfileProductAmplitude g) rho lambda t s := by
            exact outerCircleParametricRealProfileFourierCharAnalysis_ttstarKernel_eq
              g rho lambda t s
  calc
    (rho : Complex) *
        ∫ u : Real,
          ttstarAnalysis (volume.restrict (Icc t0 t1)) AU H u *
            starRingEnd Complex
              (ttstarAnalysis (volume.restrict (Icc t0 t1)) AU H u)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2)) =
        (rho : Complex) *
          ∫ t : Real, ∫ s : Real,
            ttstarKernel (volume.restrict (Icc (1 / 2 : Real) 2)) AU t s * H t *
              starRingEnd Complex (H s)
            ∂(volume.restrict (Icc t0 t1)) ∂(volume.restrict (Icc t0 t1)) := by
          rw [hbase]
    _ = ∫ t : Real, ∫ s : Real,
        ((rho : Complex) *
          ttstarKernel (volume.restrict (Icc (1 / 2 : Real) 2)) AU t s) * H t *
          starRingEnd Complex (H s)
        ∂(volume.restrict (Icc t0 t1)) ∂(volume.restrict (Icc t0 t1)) := by
          rw [← integral_const_mul]
          apply integral_congr_ae
          filter_upwards with t
          rw [← integral_const_mul]
          apply integral_congr_ae
          filter_upwards with s
          ring
    _ = _ := by
      apply integral_congr_ae
      filter_upwards with t
      apply integral_congr_ae
      filter_upwards with s
      rw [hkernel]

/-- Compact-time, signed-frequency `E₀` for a parametric real lobe.  This is
the source-ready TT* fibre statement used by the inner-slab finite tensor;
all time Fubini conditions are now automatic. -/
theorem exists_outerCircleParametricRealProfile_quadratic_E0_abs_restrict_Icc
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (g : Real × Real → Real) (hg : ContDiff Real (⊤ : ℕ∞) g)
    (hleft : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds 2] 0) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, lambda ≠ 0 →
      ∀ t0 t1 : Real, ∀ H : Real → Complex, Continuous H →
      ‖(rho : Complex) *
        ∫ u : Real,
          ttstarAnalysis (volume.restrict (Icc t0 t1))
            (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u *
            starRingEnd Complex
              (ttstarAnalysis (volume.restrict (Icc t0 t1))
                (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2))‖ ≤
        (B / (|lambda| * rho)) *
          ∫ t : Real, ‖H t‖ ^ (2 : Nat) ∂(volume.restrict (Icc t0 t1)) := by
  let A : Real × Real → Complex := outerCircleParametricRealProfileProductAmplitude g
  have hA0 : HasJointSndSmooth 0 A :=
    hasJointSndSmooth_outerCircleParametricRealProfileProductAmplitude g hg 0
  have hA2 : HasJointSndSmooth 2 A :=
    hasJointSndSmooth_outerCircleParametricRealProfileProductAmplitude g hg 2
  have hAleft : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0 := by
    intro rho _
    exact outerCircleParametricRealProfileProductAmplitude_eventuallyEq_zero_left hleft rho
  have hAright : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds 2] 0 := by
    intro rho _
    exact outerCircleParametricRealProfileProductAmplitude_eventuallyEq_zero_right hright rho
  have hAstar : ∀ p, starRingEnd Complex (A p) = A p := by
    intro p
    exact star_outerCircleParametricRealProfileProductAmplitude g p
  rcases exists_outerCircleProfileFourierCharProductKernel_quadratic_E0_abs_restrict_Icc
      hrhoMax hrhoMax_small A hA0 hA2 hAleft hAright hAstar with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda t0 t1 H hHcont
  rw [outerCircleParametricRealProfileFourierCharAnalysis_ttstar_factorization_restrict_Icc
    g rho lambda t0 t1 hg.continuous H hHcont]
  exact hbound rho hrho lambda hlambda t0 t1 H hHcont

/-- Restricting the time integral to a closed interval is exact for an
integrand whose temporal datum is supported strictly inside the associated
open interval.  This keeps the physical Fourier integral on all of `ℝ` while
allowing compact-time `TT*` and Schur. -/
theorem ttstarAnalysis_restrict_Icc_eq_volume_of_support_subset_Ioc
    {t0 t1 : Real} (A : Real → Real → Complex) (H : Real → Complex)
    (htime : t0 ≤ t1) (hHsupport : Function.support H ⊆ Ioc t0 t1) (u : Real) :
    ttstarAnalysis (volume.restrict (Icc t0 t1)) A H u =
      ttstarAnalysis volume A H u := by
  have hsupp : Function.support (fun t : Real => A u t * H t) ⊆ Ioc t0 t1 := by
    intro t ht
    apply hHsupport
    by_contra hzero
    have hHt : H t = 0 := by
      by_contra hne
      exact hzero (Function.mem_support.mpr hne)
    exact ht (by simp [hHt])
  unfold ttstarAnalysis
  change (∫ t in Icc t0 t1, A u t * H t) = ∫ t, A u t * H t
  rw [integral_Icc_eq_integral_Ioc]
  rw [← intervalIntegral.integral_of_le htime]
  exact intervalIntegral.integral_eq_integral_of_support_subset hsupp

/-- The compact-time energy is the ordinary whole-line energy under the same
strict support assumption. -/
theorem integral_norm_sq_restrict_Icc_eq_volume_of_support_subset_Ioc
    {t0 t1 : Real} (H : Real → Complex)
    (htime : t0 ≤ t1) (hHsupport : Function.support H ⊆ Ioc t0 t1) :
    (∫ t : Real, ‖H t‖ ^ (2 : Nat) ∂(volume.restrict (Icc t0 t1))) =
      ∫ t : Real, ‖H t‖ ^ (2 : Nat) := by
  have hsupp : Function.support (fun t : Real => ‖H t‖ ^ (2 : Nat)) ⊆ Ioc t0 t1 := by
    intro t ht
    apply hHsupport
    by_contra hzero
    have hHt : H t = 0 := by
      by_contra hne
      exact hzero (Function.mem_support.mpr hne)
    exact ht (by simp [hHt])
  change (∫ t in Icc t0 t1, ‖H t‖ ^ (2 : Nat)) = ∫ t, ‖H t‖ ^ (2 : Nat)
  rw [integral_Icc_eq_integral_Ioc]
  rw [← intervalIntegral.integral_of_le htime]
  exact intervalIntegral.integral_eq_integral_of_support_subset hsupp

/-- Whole-line analysis form of compact-time signed `E₀`.  This is the exact
version consumed by the finite tensor multiplier after its inner-slab
support is supplied. -/
theorem exists_outerCircleParametricRealProfile_quadratic_E0_abs_of_support_subset_Ioc
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (g : Real × Real → Real) (hg : ContDiff Real (⊤ : ℕ∞) g)
    (hleft : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds 2] 0) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, lambda ≠ 0 →
      ∀ t0 t1 : Real, ∀ H : Real → Complex, Continuous H →
      t0 ≤ t1 → Function.support H ⊆ Ioc t0 t1 →
      ‖(rho : Complex) *
        ∫ u : Real,
          ttstarAnalysis volume
            (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u *
            starRingEnd Complex
              (ttstarAnalysis volume
                (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2))‖ ≤
        (B / (|lambda| * rho)) * ∫ t : Real, ‖H t‖ ^ (2 : Nat) := by
  rcases exists_outerCircleParametricRealProfile_quadratic_E0_abs_restrict_Icc
      hrhoMax hrhoMax_small g hg hleft hright with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda t0 t1 H hHcont htime hHsupport
  have hlocal := hbound rho hrho lambda hlambda t0 t1 H hHcont
  have hAnalysis (u : Real) :
      ttstarAnalysis (volume.restrict (Icc t0 t1))
        (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u =
        ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u :=
    ttstarAnalysis_restrict_Icc_eq_volume_of_support_subset_Ioc
      (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H htime hHsupport u
  rw [integral_norm_sq_restrict_Icc_eq_volume_of_support_subset_Ioc H htime hHsupport] at hlocal
  simpa only [hAnalysis] using hlocal

/-- The strict inner time slab sits inside the open interval used by the
compact-time TT* identity. -/
theorem closedBall_innerSlab_subset_Ioc
    {r : Real} (hr : r < 1) :
    closedBall (3 / 2 : Real) r ⊆ Ioc (1 / 2 : Real) (5 / 2 : Real) := by
  intro t ht
  change dist t (3 / 2 : Real) ≤ r at ht
  rw [Real.dist_eq] at ht
  have hlt : |t - 3 / 2| < 1 := lt_of_le_of_lt ht hr
  rcases abs_lt.mp hlt with ⟨hlow, hhigh⟩
  constructor <;> linarith

/-- Literal finite-tensor time data is a valid compact-time datum for the
signed parametric fibre estimate.  This is the first fully concrete
replacement for the former `H`/Fubini witness at one spatial frequency. -/
theorem exists_outerCircleParametricRealProfile_finiteTensorTimeData_quadratic_E0_abs
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (g : Real × Real → Real) (hg : ContDiff Real (⊤ : ℕ∞) g)
    (hleft : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds 2] 0) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, lambda ≠ 0 →
      ∀ {ι : Type*} (s : Finset ι)
        (q : ι → SchwartzMap (Euclidean 2) Complex)
        (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2)
        {r : Real}, r < 1 →
        (∀ l, Function.support (a l : Real → Complex) ⊆ closedBall (3 / 2 : Real) r) →
      ‖(rho : Complex) *
        ∫ u : Real,
          ttstarAnalysis volume
            (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)
            (scratch_finiteTensorTimeData s q a xi) u *
            starRingEnd Complex
              (ttstarAnalysis volume
                (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)
                (scratch_finiteTensorTimeData s q a xi) u)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2))‖ ≤
        (B / (|lambda| * rho)) *
          ∫ t : Real, ‖scratch_finiteTensorTimeData s q a xi t‖ ^ (2 : Nat) := by
  rcases exists_outerCircleParametricRealProfile_quadratic_E0_abs_of_support_subset_Ioc
      hrhoMax hrhoMax_small g hg hleft hright with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda ι s q a xi r hr ha
  apply hbound rho hrho lambda hlambda (1 / 2 : Real) (5 / 2 : Real)
    (scratch_finiteTensorTimeData s q a xi)
  · exact continuous_scratch_finiteTensorTimeData s q a xi
  · norm_num
  · exact (support_scratch_finiteTensorTimeData_subset_innerSlab s q a xi ha).trans
      (closedBall_innerSlab_subset_Ioc hr)

/-- The cutoff-coordinate part of the angular derivative is the same
compact-time `TT*` estimate with its literal `rho⁻²` prefactor retained. -/
theorem exists_outerCircleParametricRealProfile_cutoff_E1_abs_of_support_subset_Ioc
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (g : Real × Real → Real) (hg : ContDiff Real (⊤ : ℕ∞) g)
    (hleft : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds 2] 0) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, lambda ≠ 0 →
      ∀ t0 t1 : Real, ∀ H : Real → Complex, Continuous H →
      t0 ≤ t1 → Function.support H ⊆ Ioc t0 t1 →
      ‖(((rho ^ 2)⁻¹ : Real) : Complex) *
        ((rho : Complex) *
          ∫ u : Real,
            ttstarAnalysis volume
              (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u *
              starRingEnd Complex
                (ttstarAnalysis volume
                  (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)
                  H u)
            ∂(volume.restrict (Icc (1 / 2 : Real) 2)))‖ ≤
        (rho ^ 2)⁻¹ * (B / (|lambda| * rho)) * ∫ t : Real, ‖H t‖ ^ (2 : Nat) := by
  rcases exists_outerCircleParametricRealProfile_quadratic_E0_abs_of_support_subset_Ioc
      hrhoMax hrhoMax_small g hg hleft hright with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda t0 t1 H hHcont htime hHsupport
  have hbase := hbound rho hrho lambda hlambda t0 t1 H hHcont htime hHsupport
  have hfac : 0 ≤ (rho ^ 2)⁻¹ := inv_nonneg.mpr (sq_nonneg rho)
  calc
    ‖(((rho ^ 2)⁻¹ : Real) : Complex) *
        ((rho : Complex) *
          ∫ u : Real,
            ttstarAnalysis volume
              (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u *
              starRingEnd Complex
                (ttstarAnalysis volume
                  (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)
                  H u)
            ∂(volume.restrict (Icc (1 / 2 : Real) 2)))‖ =
        (rho ^ 2)⁻¹ * ‖(rho : Complex) *
          ∫ u : Real,
            ttstarAnalysis volume
              (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u *
              starRingEnd Complex
                (ttstarAnalysis volume
                  (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)
                  H u)
            ∂(volume.restrict (Icc (1 / 2 : Real) 2))‖ := by
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hfac]
    _ ≤ (rho ^ 2)⁻¹ *
        ((B / (|lambda| * rho)) * ∫ t : Real, ‖H t‖ ^ (2 : Nat)) :=
      mul_le_mul_of_nonneg_left hbase hfac
    _ = _ := by ring

/-- The phase-coordinate part is the same local `TT*` estimate after an
arbitrary nonnegative real square factor; this isolates the exact
`((2*pi)*lambda*rho)^2` factor used by the literal product rule. -/
theorem exists_outerCircleParametricRealProfile_scaled_E1_abs_of_support_subset_Ioc
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (g : Real × Real → Real) (hg : ContDiff Real (⊤ : ℕ∞) g)
    (hleft : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds 2] 0)
    (scale : Real) (hscale : 0 ≤ scale) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, lambda ≠ 0 →
      ∀ t0 t1 : Real, ∀ H : Real → Complex, Continuous H →
      t0 ≤ t1 → Function.support H ⊆ Ioc t0 t1 →
      ‖(scale : Complex) *
        ((rho : Complex) *
          ∫ u : Real,
            ttstarAnalysis volume
              (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u *
              starRingEnd Complex
                (ttstarAnalysis volume
                  (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)
                  H u)
            ∂(volume.restrict (Icc (1 / 2 : Real) 2)))‖ ≤
        scale * (B / (|lambda| * rho)) * ∫ t : Real, ‖H t‖ ^ (2 : Nat) := by
  rcases exists_outerCircleParametricRealProfile_quadratic_E0_abs_of_support_subset_Ioc
      hrhoMax hrhoMax_small g hg hleft hright with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda t0 t1 H hHcont htime hHsupport
  have hbase := hbound rho hrho lambda hlambda t0 t1 H hHcont htime hHsupport
  calc
    ‖(scale : Complex) *
        ((rho : Complex) *
          ∫ u : Real,
            ttstarAnalysis volume
              (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u *
              starRingEnd Complex
                (ttstarAnalysis volume
                  (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)
                  H u)
            ∂(volume.restrict (Icc (1 / 2 : Real) 2)))‖ =
        scale * ‖(rho : Complex) *
          ∫ u : Real,
            ttstarAnalysis volume
              (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u *
              starRingEnd Complex
                (ttstarAnalysis volume
                  (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)
                  H u)
            ∂(volume.restrict (Icc (1 / 2 : Real) 2))‖ := by
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hscale]
    _ ≤ scale *
        ((B / (|lambda| * rho)) * ∫ t : Real, ‖H t‖ ^ (2 : Nat)) :=
      mul_le_mul_of_nonneg_left hbase hscale
    _ = _ := by ring

end

