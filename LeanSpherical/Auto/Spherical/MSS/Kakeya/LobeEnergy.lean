/-- Fibrewise square energy is stable under a complex scalar, with the
literal squared norm coefficient.  This is the algebraic bridge from the
`r⁻¹` and `2π λ r` derivative factors to their Schur energy scales. -/
theorem shellFrequencyEnergy_const_mul
    (z : Complex) (m : Real -> Euclidean 2 -> Complex)
    (lo hi : Real) (xi : Euclidean 2) :
    shellFrequencyEnergy (fun theta xi => z * m theta xi) lo hi xi =
      ‖z‖ ^ (2 : Nat) * shellFrequencyEnergy m lo hi xi := by
  unfold shellFrequencyEnergy
  rw [show (fun theta : Real => ‖z * m theta xi‖ ^ (2 : Nat)) =
      fun theta => ‖z‖ ^ (2 : Nat) * ‖m theta xi‖ ^ (2 : Nat) by
        funext theta
        rw [norm_mul, mul_pow]]
  rw [integral_const_mul]

/-- The cutoff-coordinate scalar has exactly the expected `r⁻²` energy
scale. -/
theorem shellFrequencyEnergy_inv_carrier_mul
    {r : Real}
    (m : Real -> Euclidean 2 -> Complex)
    (lo hi : Real) (xi : Euclidean 2) :
    shellFrequencyEnergy (fun theta xi => ((r⁻¹ : Real) : Complex) * m theta xi) lo hi xi =
      (r ^ 2)⁻¹ * shellFrequencyEnergy m lo hi xi := by
  rw [shellFrequencyEnergy_const_mul]
  rw [Complex.norm_real, Real.norm_eq_abs, abs_inv, inv_pow, sq_abs]

/-- Multiplication by either unit imaginary sign does not change the phase
energy scale. -/
theorem shellFrequencyEnergy_unitImag_phase_mul
    (sign : Complex) (hsign : ‖sign‖ = 1)
    (r lambda : Real) (m : Real -> Euclidean 2 -> Complex)
    (lo hi : Real) (xi : Euclidean 2) :
    shellFrequencyEnergy (fun theta xi =>
      sign * ((((2 * Real.pi) * lambda * r : Real) : Complex) * m theta xi)) lo hi xi =
      ((2 * Real.pi) * lambda * r) ^ 2 * shellFrequencyEnergy m lo hi xi := by
  rw [shellFrequencyEnergy_const_mul]
  rw [shellFrequencyEnergy_const_mul]
  rw [hsign, one_pow, one_mul, Complex.norm_real, Real.norm_eq_abs, sq_abs]

/-- A transparent fibrewise Cauchy recombination.  It deliberately takes
the exact local square-integrability hypotheses rather than hiding a global
smoothness assumption; compact lobe transport supplies these hypotheses. -/
theorem shellFrequencyEnergy_add_le_two_mul_add
    (m0 m1 : Real -> Euclidean 2 -> Complex) (lo hi : Real) (xi : Euclidean 2)
    (h0meas : AEStronglyMeasurable (fun theta : Real => m0 theta xi)
