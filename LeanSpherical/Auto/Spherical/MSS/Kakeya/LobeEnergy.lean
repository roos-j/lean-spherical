  rw [hleft]
  change HasDerivAt (fun r => FourierTransform.fourierInv (m r) y)
    (FourierTransform.fourierInv (dm theta) y) theta
  apply hasDerivAt_fourierInv_of_dominated m dm theta y
    (bound := fun xi => canonicalTubeMultiplierUniformBound *
