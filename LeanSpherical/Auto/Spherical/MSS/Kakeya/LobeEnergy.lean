            H u‖ ^ (2 : Nat) ∂(volume.restrict (Icc (1 / 2 : Real) 2))) <=
        scale * (B / (|lambda| * rho)) * ∫ t : Real, ‖H t‖ ^ (2 : Nat) := by
  rcases exists_outerCircleParametricRealProfile_quadratic_E0_abs_of_support_subset_Ioc_of_hasJoint
      hrhoMax hrhoMax_small g hg0 hg2 hleft hright with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda t0 t1 H hH htime hHsupport
  have hgcont : Continuous g := by
    simpa [HasJointSndSmooth] using hg0
  let A := outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda
  have hA : Continuous (Function.uncurry A) := by
    change Continuous (fun p : Real × Real =>
      (g (rho, p.1) : Complex) *
        (Real.fourierChar (-p.2 * lambda * Real.cos (rho * p.1)) : Complex))
    have hg' : Continuous (fun p : Real × Real => g (rho, p.1)) :=
      hgcont.comp (continuous_const.prodMk continuous_fst)
    apply (Complex.continuous_ofReal.comp hg').mul
    fun_prop
  have hreal := realEnergy_eq_norm_ttstarAnalysis_of_continuous_support
    A hA H hH htime hHsupport (le_of_lt hrho.1)
  have hbase := hbound rho hrho lambda hlambda t0 t1 H hH htime hHsupport
  rw [hreal]
  dsimp only [A]
  calc
    scale * ‖(rho : Complex) *
        ∫ u : Real,
          ttstarAnalysis volume
            (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)
            H u *
            starRingEnd Complex
              (ttstarAnalysis volume
                (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)
                H u)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2))‖ <=
        scale * ((B / (|lambda| * rho)) * ∫ t : Real, ‖H t‖ ^ (2 : Nat)) :=
      mul_le_mul_of_nonneg_left hbase hscale
    _ = scale * (B / (|lambda| * rho)) * ∫ t : Real, ‖H t‖ ^ (2 : Nat) := by ring

end

