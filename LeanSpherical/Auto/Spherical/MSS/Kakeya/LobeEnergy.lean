      simpa only [F] using hFint)
  have hneg : (∫ u : Real, F (c + r * (-u))) =
      ∫ u : Real, F (c + r * u) :=
    (Measure.measurePreserving_neg (volume : Measure Real)).integral_comp
      (Homeomorph.neg Real).measurableEmbedding
      (fun u : Real => F (c + r * u))
  have haffine : (∫ theta : Real, F theta) = r * ∫ u : Real, H u := by
    calc
      (∫ theta : Real, F theta) = r * ∫ u : Real, F (c + r * u) :=
        integral_affine_comp_eq F c r hr
      _ = r * ∫ u : Real, F (c + r * (-u)) := by rw [hneg]
      _ = r * ∫ u : Real, H u := by
        apply congrArg (fun z : Real => r * z)
        apply integral_congr_ae
        filter_upwards with u
        dsimp only [F, H]
        have harg : (c - (c + r * (-u))) / r = u := by
          field_simp [ne_of_gt hr]
          ring
        rw [harg]
        congr 2
        ring
  have hHzero : ∀ u, u ∉ Icc (1 / 2 : Real) 2 -> H u = 0 := by
    intro u hu
    dsimp only [H]
    rw [hzero u hu]
    norm_num
  have hrestrict : (∫ u : Real, H u ∂(volume.restrict (Icc (1 / 2 : Real) 2))) =
      ∫ u : Real, H u :=
    setIntegral_eq_integral_of_forall_compl_eq_zero hHzero
  change (∫ theta : Real, F theta ∂(volume.restrict (Icc L U))) ≤
    r * ∫ u : Real, H u ∂(volume.restrict (Icc (1 / 2 : Real) 2))
  calc
    (∫ theta : Real, F theta ∂(volume.restrict (Icc L U))) ≤
        ∫ theta : Real, F theta := hmono
    _ = r * ∫ u : Real, H u := haffine
    _ = r * ∫ u : Real, H u ∂(volume.restrict (Icc (1 / 2 : Real) 2)) := by
      rw [hrestrict]

/-- The actual two-sided cutoff is controlled by a positive lobe around
`c+r*u` and a reflected lobe around `c-r*u`.  This is the form which
matches the reflected negative fixed-frequency TT* package exactly. -/
theorem integral_norm_sq_affine_plus_reflected_lobes_restrict_le
    (gPlus gMinus : Real -> Real -> Real) (M : Real -> Complex)
    (r c L U : Real) (hr : 0 < r)
    (hPlusCont : Continuous fun p : Real × Real => gPlus p.1 p.2)
    (hMinusCont : Continuous fun p : Real × Real => gMinus p.1 p.2)
    (hMcont : Continuous M)
    (hPlusZero : ∀ u, u ∉ Icc (1 / 2 : Real) 2 -> gPlus r u = 0)
    (hMinusZero : ∀ u, u ∉ Icc (1 / 2 : Real) 2 -> gMinus r u = 0) :
    (∫ theta : Real,
      ‖((gPlus r ((theta - c) / r) : Complex) * M theta) +
        ((gMinus r ((c - theta) / r) : Complex) * M theta)‖ ^ (2 : Nat)
        ∂(volume.restrict (Icc L U))) ≤
      2 * r *
        ((∫ u : Real, ‖((gPlus r u : Complex) * M (c + r * u))‖ ^ (2 : Nat)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2))) +
        (∫ u : Real, ‖((gMinus r u : Complex) * M (c - r * u))‖ ^ (2 : Nat)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2))) ) := by
  let P : Real -> Complex := fun theta =>
    (gPlus r ((theta - c) / r) : Complex) * M theta
  let N : Real -> Complex := fun theta =>
    (gMinus r ((c - theta) / r) : Complex) * M theta
  have hPall : Integrable (fun theta : Real => ‖P theta‖ ^ (2 : Nat)) := by
    dsimp only [P]
    exact integrable_norm_sq_affine_lobe gPlus M r c hr hPlusCont hMcont hPlusZero
  have hNall : Integrable (fun theta : Real => ‖N theta‖ ^ (2 : Nat)) := by
    dsimp only [N]
    exact integrable_norm_sq_reflected_affine_lobe
      gMinus M r c hr hMinusCont hMcont hMinusZero
  have hPcont : Continuous P := by
    dsimp only [P]
    fun_prop
  have hNcont : Continuous N := by
    dsimp only [N]
    fun_prop
  have hadd := integral_norm_sq_add_le_two_mul_add
    (volume.restrict (Icc L U)) P N hPcont.aestronglyMeasurable
      hNcont.aestronglyMeasurable hPall.restrict hNall.restrict
  have hPaff := integral_norm_sq_affine_lobe_restrict_le
    gPlus M r c L U hr hPlusZero hPall
  have hNaff := integral_norm_sq_reflected_affine_lobe_restrict_le
    gMinus M r c L U hr hMinusZero hNall
  change (∫ theta : Real, ‖P theta + N theta‖ ^ (2 : Nat)
    ∂(volume.restrict (Icc L U))) ≤ _
  calc
    (∫ theta : Real, ‖P theta + N theta‖ ^ (2 : Nat)
      ∂(volume.restrict (Icc L U))) ≤
        2 * ((∫ theta : Real, ‖P theta‖ ^ (2 : Nat)
          ∂(volume.restrict (Icc L U))) +
          (∫ theta : Real, ‖N theta‖ ^ (2 : Nat)
            ∂(volume.restrict (Icc L U)))) := hadd
    _ ≤ 2 *
        (r * (∫ u : Real, ‖((gPlus r u : Complex) * M (c + r * u))‖ ^ (2 : Nat)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2))) +
          r * (∫ u : Real, ‖((gMinus r u : Complex) * M (c - r * u))‖ ^ (2 : Nat)
            ∂(volume.restrict (Icc (1 / 2 : Real) 2)))) := by
          gcongr
    _ = _ := by ring

end

end Auto.Spherical.MSS
end
