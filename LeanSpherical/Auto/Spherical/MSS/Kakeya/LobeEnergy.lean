/-- The elementary two-lobe Cauchy estimate in the precise square-norm form
used before the affine change of variables. -/
theorem norm_add_sq_le_two_mul_add_norm_sq (z w : Complex) :
    ‖z + w‖ ^ (2 : Nat) <= 2 * (‖z‖ ^ (2 : Nat) + ‖w‖ ^ (2 : Nat)) := by
  have htri : ‖z + w‖ <= ‖z‖ + ‖w‖ := norm_add_le z w
  have hsq : ‖z + w‖ ^ (2 : Nat) <= (‖z‖ + ‖w‖) ^ (2 : Nat) :=
    (sq_le_sq₀ (norm_nonneg _) (add_nonneg (norm_nonneg _) (norm_nonneg _))).mpr htri
  have htwo : (‖z‖ + ‖w‖) ^ (2 : Nat) <=
      2 * (‖z‖ ^ (2 : Nat) + ‖w‖ ^ (2 : Nat)) := by
    nlinarith [sq_nonneg (‖z‖ - ‖w‖)]
  exact hsq.trans htwo

/-- Integrating the preceding pointwise estimate on an arbitrary measure. -/
theorem integral_norm_sq_add_le_two_mul_add
    {X : Type*} [MeasurableSpace X] (mu : Measure X)
    (z w : X -> Complex)
    (hzmeas : AEStronglyMeasurable z mu)
    (hwmeas : AEStronglyMeasurable w mu)
    (hz : Integrable (fun x => ‖z x‖ ^ (2 : Nat)) mu)
    (hw : Integrable (fun x => ‖w x‖ ^ (2 : Nat)) mu) :
    (∫ x, ‖z x + w x‖ ^ (2 : Nat) ∂mu) <=
      2 * ((∫ x, ‖z x‖ ^ (2 : Nat) ∂mu) +
        (∫ x, ‖w x‖ ^ (2 : Nat) ∂mu)) := by
  have hright : Integrable (fun x =>
      2 * (‖z x‖ ^ (2 : Nat) + ‖w x‖ ^ (2 : Nat))) mu :=
    (hz.add hw).const_mul 2
  have hleftmeas : AEStronglyMeasurable (fun x => ‖z x + w x‖ ^ (2 : Nat)) mu := by
    fun_prop
  have hleft : Integrable (fun x => ‖z x + w x‖ ^ (2 : Nat)) mu :=
    hright.mono' hleftmeas (Filter.Eventually.of_forall fun x => by
      rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
      exact norm_add_sq_le_two_mul_add_norm_sq (z x) (w x))
  calc
    (∫ x, ‖z x + w x‖ ^ (2 : Nat) ∂mu) <=
        ∫ x, 2 * (‖z x‖ ^ (2 : Nat) + ‖w x‖ ^ (2 : Nat)) ∂mu :=
      integral_mono_ae hleft hright (Filter.Eventually.of_forall fun x =>
        norm_add_sq_le_two_mul_add_norm_sq (z x) (w x))
    _ = 2 * ((∫ x, ‖z x‖ ^ (2 : Nat) ∂mu) +
        (∫ x, ‖w x‖ ^ (2 : Nat) ∂mu)) := by
      rw [integral_const_mul, integral_add hz hw]

end

