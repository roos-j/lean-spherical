theorem integrable_norm_sq_affine_lobe
    (g : Real -> Real -> Real) (M : Real -> Complex)
    (r c : Real) (hr : 0 < r)
    (hgcont : Continuous fun p : Real × Real => g p.1 p.2)
    (hMcont : Continuous M)
    (hzero : ∀ u, u ∉ Icc (1 / 2 : Real) 2 -> g r u = 0) :
    Integrable (fun theta : Real =>
      ‖((g r ((theta - c) / r) : Complex) * M theta)‖ ^ (2 : Nat)) := by
  let F : Real -> Real := fun theta =>
    ‖((g r ((theta - c) / r) : Complex) * M theta)‖ ^ (2 : Nat)
  have hFcont : Continuous F := by
    dsimp only [F]
    fun_prop
  have hcompact : HasCompactSupport F := by
    apply HasCompactSupport.intro (isCompact_Icc : IsCompact (Icc (c + r / 2) (c + 2 * r)))
    intro theta htheta
    have harg : (theta - c) / r ∉ Icc (1 / 2 : Real) 2 := by
      intro hmem
      have hlo : 1 / 2 ≤ (theta - c) / r := hmem.1
      have hhi : (theta - c) / r ≤ 2 := hmem.2
      have htheta' : theta ∈ Icc (c + r / 2) (c + 2 * r) := by
        constructor <;> field_simp [ne_of_gt hr] at hlo hhi ⊢ <;> nlinarith
      exact htheta htheta'
    dsimp only [F]
    rw [hzero _ harg]
    norm_num
  exact hFcont.integrable_of_hasCompactSupport hcompact

end

