    have hmxi : Continuous (fun xi : Euclidean 2 => m r xi) := by
      change Continuous (fun xi : Euclidean 2 =>
        canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a
          (circleDirection r) xi)
      exact (canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a
        (circleDirection r)).continuous
    exact (hphase.smul hmxi).aestronglyMeasurable
  · refine (integrable_canonicalLowpassFiniteTensorMultiplier_circle_majorant
      C rho hrho s q a).mono' ?_ ?_
    · have hphase : Continuous (fun xi : Euclidean 2 =>
          (Real.fourierChar (inner Real xi y) : Complex)) := by fun_prop
      have hmxi : Continuous (fun xi : Euclidean 2 => m theta xi) := by
        change Continuous (fun xi : Euclidean 2 =>
          canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a
            (circleDirection theta) xi)
        exact (canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a
