    (hcmmeas : AEStronglyMeasurable (fun theta : Real => mcm theta xi)
      (volume.restrict (Icc lo hi)))
    (hppmeas : AEStronglyMeasurable (fun theta : Real => mpp theta xi)
      (volume.restrict (Icc lo hi)))
    (hpmmeas : AEStronglyMeasurable (fun theta : Real => mpm theta xi)
      (volume.restrict (Icc lo hi)))
    (hcpint : Integrable (fun theta : Real => ‖mcp theta xi‖ ^ (2 : Nat))
      (volume.restrict (Icc lo hi)))
    (hcmint : Integrable (fun theta : Real => ‖mcm theta xi‖ ^ (2 : Nat))
      (volume.restrict (Icc lo hi)))
    (hppint : Integrable (fun theta : Real => ‖mpp theta xi‖ ^ (2 : Nat))
      (volume.restrict (Icc lo hi)))
    (hpmint : Integrable (fun theta : Real => ‖mpm theta xi‖ ^ (2 : Nat))
      (volume.restrict (Icc lo hi))) :
    shellFrequencyEnergy (fun theta xi =>
      (mcp theta xi + mcm theta xi) + (mpp theta xi + mpm theta xi)) lo hi xi <=
      2 * ((2 * (shellFrequencyEnergy mcp lo hi xi + shellFrequencyEnergy mcm lo hi xi)) +
        (2 * (shellFrequencyEnergy mpp lo hi xi + shellFrequencyEnergy mpm lo hi xi))) := by
  have hcut := shellFrequencyEnergy_add_le_two_mul_add mcp mcm lo hi xi
    hcpmeas hcmmeas hcpint hcmint
  have hphase := shellFrequencyEnergy_add_le_two_mul_add mpp mpm lo hi xi
