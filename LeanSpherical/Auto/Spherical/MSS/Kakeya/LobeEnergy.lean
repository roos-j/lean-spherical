decay is introduced here. -/
theorem integrable_norm_sq_affine_lobe_of_continuous_analysis
    (P : Real -> Complex) (r c : Real) (hr : 0 < r)
    (hPcont : Continuous P)
    (hzero : ∀ u, u ∉ Icc (1 / 2 : Real) 2 -> P u = 0) :
    Integrable (fun theta : Real =>
      ‖P ((theta - c) / r)‖ ^ (2 : Nat)) := by
  apply integrable_norm_sq_affine_complex_lobe
    P r c hr hPcont hzero

/-- The reflected affine placement has the same compact-support
integrability property. -/
theorem integrable_norm_sq_reflected_affine_lobe_of_continuous_analysis
    (P : Real -> Complex) (r c : Real) (hr : 0 < r)
    (hPcont : Continuous P)
