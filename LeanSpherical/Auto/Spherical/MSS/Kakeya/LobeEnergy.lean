theorem continuous_uncurry_outerCircleParametricRealProfileFourierCharAnalysisAmplitude
    (g : Real × Real → Real) (hg : ContDiff Real (⊤ : ℕ∞) g)
    (rho lambda : Real) :
    Continuous (Function.uncurry
      (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)) := by
  unfold outerCircleParametricRealProfileFourierCharAnalysisAmplitude
  have hg' : Continuous (fun p : Real × Real => (g (rho, p.1) : Complex)) :=
    Complex.continuous_ofReal.comp
      (hg.continuous.comp (continuous_const.prodMk continuous_fst))
  have hp : Continuous (fun p : Real × Real =>
      (Real.fourierChar (-p.2 * lambda * Real.cos (rho * p.1)) : Complex)) := by
    have harg : Continuous (fun p : Real × Real =>
        -p.2 * lambda * Real.cos (rho * p.1)) := by fun_prop
    exact continuous_subtype_val.comp (Real.continuous_fourierChar.comp harg)
  exact hg'.mul hp

/-- Compact-time signed Schur E₀ converted into the literal nonnegative
angular square energy of a finite tensor at one fixed frequency. -/
theorem exists_outerCircleParametricRealProfile_finiteTensorTimeData_realEnergy_E0
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (g : Real × Real → Real) (hg : ContDiff Real (⊤ : ℕ∞) g)
    (hleft : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds 2] 0) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, lambda ≠ 0 →
      ∀ {ι : Type*} (s : Finset ι)
        (q : ι → SchwartzMap (Euclidean 2) Complex)
        (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2)
        {r : Real}, r < 1 →
        (∀ l, Function.support (a l : Real → Complex) ⊆ closedBall (3 / 2 : Real) r) →
      rho * ∫ u : Real,
        ‖ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)
          (scratch_finiteTensorTimeData s q a xi) u‖ ^ (2 : Nat)
        ∂(volume.restrict (Icc (1 / 2 : Real) 2)) ≤
        (B / (|lambda| * rho)) *
          ∫ t : Real, ‖scratch_finiteTensorTimeData s q a xi t‖ ^ (2 : Nat) := by
  rcases exists_outerCircleParametricRealProfile_finiteTensorTimeData_quadratic_E0_abs
      hrhoMax hrhoMax_small g hg hleft hright with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda ι s q a xi r hr hsupport
  let H : Real → Complex := scratch_finiteTensorTimeData s q a xi
  let A := outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda
  have hHcont : Continuous H := continuous_scratch_finiteTensorTimeData s q a xi
  have hHsupport : Function.support H ⊆ Ioc (1 / 2 : Real) (5 / 2 : Real) :=
    (support_scratch_finiteTensorTimeData_subset_innerSlab s q a xi hsupport).trans
      (closedBall_innerSlab_subset_Ioc hr)
  have hAcont : Continuous (Function.uncurry A) :=
    continuous_uncurry_outerCircleParametricRealProfileFourierCharAnalysisAmplitude
      g hg rho lambda
  have hFrestrict : Integrable (fun u : Real =>
      ‖ttstarAnalysis (volume.restrict (Icc (1 / 2 : Real) (5 / 2 : Real))) A H u‖ ^
        (2 : Nat))
      (volume.restrict (Icc (1 / 2 : Real) 2)) :=
    integrable_norm_sq_ttstarAnalysis_restrict_Icc_of_continuous A hAcont H hHcont
  have hAnalysis (u : Real) :
      ttstarAnalysis (volume.restrict (Icc (1 / 2 : Real) (5 / 2 : Real))) A H u =
        ttstarAnalysis volume A H u :=
    ttstarAnalysis_restrict_Icc_eq_volume_of_support_subset_Ioc A H (by norm_num) hHsupport u
  have hF : Integrable (fun u : Real =>
      ‖ttstarAnalysis volume A H u‖ ^ (2 : Nat))
      (volume.restrict (Icc (1 / 2 : Real) 2)) := by
    apply hFrestrict.congr
    filter_upwards with u
    rw [hAnalysis]
  have hreal := norm_real_smul_integral_mul_star_eq
    (volume.restrict (Icc (1 / 2 : Real) 2)) rho (le_of_lt hrho.1)
    (fun u : Real => ttstarAnalysis volume A H u) hF
  rw [← hreal]
  exact hbound rho hrho lambda hlambda s q a xi hr hsupport

/-- For compactly supported continuous temporal data, the real angular L²
energy of a Fourier-character analysis map is the norm-form TT* diagonal
appearing in the Schur estimates. -/
theorem realEnergy_eq_norm_ttstarAnalysis_of_continuous_support
    (A : Real → Real → Complex) (hA : Continuous (Function.uncurry A))
    {t0 t1 rho : Real} (H : Real → Complex) (hH : Continuous H)
    (htime : t0 ≤ t1) (hHsupport : Function.support H ⊆ Ioc t0 t1)
    (hrho : 0 ≤ rho) :
    rho * ∫ u : Real, ‖ttstarAnalysis volume A H u‖ ^ (2 : Nat)
      ∂(volume.restrict (Icc (1 / 2 : Real) 2)) =
      ‖(rho : Complex) *
        ∫ u : Real,
          ttstarAnalysis volume A H u *
            starRingEnd Complex (ttstarAnalysis volume A H u)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2))‖ := by
  have hFrestrict : Integrable (fun u : Real =>
      ‖ttstarAnalysis (volume.restrict (Icc t0 t1)) A H u‖ ^ (2 : Nat))
      (volume.restrict (Icc (1 / 2 : Real) 2)) :=
    integrable_norm_sq_ttstarAnalysis_restrict_Icc_of_continuous A hA H hH
  have hAnalysis (u : Real) :
      ttstarAnalysis (volume.restrict (Icc t0 t1)) A H u =
        ttstarAnalysis volume A H u :=
    ttstarAnalysis_restrict_Icc_eq_volume_of_support_subset_Ioc A H htime hHsupport u
  have hF : Integrable (fun u : Real =>
      ‖ttstarAnalysis volume A H u‖ ^ (2 : Nat))
      (volume.restrict (Icc (1 / 2 : Real) 2)) := by
    apply hFrestrict.congr
    filter_upwards with u
    rw [hAnalysis]
  exact (norm_real_smul_integral_mul_star_eq
    (volume.restrict (Icc (1 / 2 : Real) 2)) rho hrho
    (fun u : Real => ttstarAnalysis volume A H u) hF).symm

/-- The compact-time cutoff-coordinate E₁ Schur estimate, expressed as a
literal nonnegative angular square energy. -/
theorem exists_outerCircleParametricRealProfile_realEnergy_cutoff_E1
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (g : Real × Real → Real) (hg : ContDiff Real (⊤ : ℕ∞) g)
    (hleft : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds 2] 0) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, lambda ≠ 0 →
      ∀ t0 t1 : Real, ∀ H : Real → Complex, Continuous H →
      t0 ≤ t1 → Function.support H ⊆ Ioc t0 t1 →
      (rho ^ 2)⁻¹ *
        (rho * ∫ u : Real,
          ‖ttstarAnalysis volume
            (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)
            H u‖ ^ (2 : Nat) ∂(volume.restrict (Icc (1 / 2 : Real) 2))) ≤
        (rho ^ 2)⁻¹ * (B / (|lambda| * rho)) *
          ∫ t : Real, ‖H t‖ ^ (2 : Nat) := by
  rcases exists_outerCircleParametricRealProfile_cutoff_E1_abs_of_support_subset_Ioc
      hrhoMax hrhoMax_small g hg hleft hright with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda t0 t1 H hH htime hHsupport
  let A := outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda
  have hA : Continuous (Function.uncurry A) :=
    continuous_uncurry_outerCircleParametricRealProfileFourierCharAnalysisAmplitude
      g hg rho lambda
  have hscale : 0 ≤ (rho ^ 2)⁻¹ := inv_nonneg.mpr (sq_nonneg rho)
  have hconvert := norm_real_scale_mul_real_smul_integral_mul_star_eq
    (volume.restrict (Icc (1 / 2 : Real) 2)) ((rho ^ 2)⁻¹) rho hscale
    (le_of_lt hrho.1)
    (fun u : Real => ttstarAnalysis volume A H u) (by
      have hFrestrict : Integrable (fun u : Real =>
          ‖ttstarAnalysis (volume.restrict (Icc t0 t1)) A H u‖ ^ (2 : Nat))
          (volume.restrict (Icc (1 / 2 : Real) 2)) :=
        integrable_norm_sq_ttstarAnalysis_restrict_Icc_of_continuous A hA H hH
      apply hFrestrict.congr
      filter_upwards with u
      rw [ttstarAnalysis_restrict_Icc_eq_volume_of_support_subset_Ioc
        A H htime hHsupport u])
  rw [← hconvert]
  exact hbound rho hrho lambda hlambda t0 t1 H hH htime hHsupport

/-- The compact-time phase-coordinate E₁ Schur estimate in literal real
angular-energy form, with an arbitrary nonnegative physical square scale. -/
theorem exists_outerCircleParametricRealProfile_realEnergy_scaled_E1
