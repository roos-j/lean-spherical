noncomputable section

/-- A complex TT* diagonal integral is exactly its real nonnegative L²
energy.  This is the conversion needed to consume the norm-form Schur bound
as a literal angular square-energy estimate. -/
theorem norm_integral_mul_star_eq_integral_norm_sq
    {X : Type*} [MeasurableSpace X] (mu : Measure X)
    (F : X → Complex)
    (hF : Integrable (fun x => ‖F x‖ ^ (2 : Nat)) mu) :
    ‖∫ x, F x * starRingEnd Complex (F x) ∂mu‖ =
      ∫ x, ‖F x‖ ^ (2 : Nat) ∂mu := by
  have hpoint : (fun x : X => F x * starRingEnd Complex (F x)) =
      fun x => Complex.ofRealCLM (‖F x‖ ^ (2 : Nat)) := by
    funext x
    change F x * starRingEnd Complex (F x) = (↑(‖F x‖ ^ (2 : Nat)) : Complex)
    push_cast
    exact Complex.mul_conj' (F x)
  rw [hpoint, Complex.ofRealCLM.integral_comp_comm hF]
  change ‖((∫ x, ‖F x‖ ^ (2 : Nat) ∂mu : Real) : Complex)‖ = _
  rw [Complex.norm_real, Real.norm_eq_abs]
  exact abs_of_nonneg (integral_nonneg fun x => sq_nonneg _)

/-- The same conversion with the positive shell Jacobian carried outside the
TT* diagonal integral. -/
theorem norm_real_smul_integral_mul_star_eq
    {X : Type*} [MeasurableSpace X] (mu : Measure X)
    (rho : Real) (hrho : 0 ≤ rho)
    (F : X → Complex)
    (hF : Integrable (fun x => ‖F x‖ ^ (2 : Nat)) mu) :
    ‖(rho : Complex) * (∫ x, F x * starRingEnd Complex (F x) ∂mu)‖ =
      rho * ∫ x, ‖F x‖ ^ (2 : Nat) ∂mu := by
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hrho,
    norm_integral_mul_star_eq_integral_norm_sq mu F hF]

/-- A further nonnegative real scale may be carried through the same TT*
energy conversion. -/
theorem norm_real_scale_mul_real_smul_integral_mul_star_eq
    {X : Type*} [MeasurableSpace X] (mu : Measure X)
    (scale rho : Real) (hscale : 0 ≤ scale) (hrho : 0 ≤ rho)
    (F : X → Complex)
    (hF : Integrable (fun x => ‖F x‖ ^ (2 : Nat)) mu) :
    ‖(scale : Complex) * ((rho : Complex) *
        (∫ x, F x * starRingEnd Complex (F x) ∂mu))‖ =
      scale * (rho * ∫ x, ‖F x‖ ^ (2 : Nat) ∂mu) := by
