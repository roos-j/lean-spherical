/-- The local positive and reflected-negative identities, together with
their exact off-lobe vanishing, reassemble into a global four-term affine
identity.  This deliberately separates the elementary coordinate cases from
the circle-specific raw product rule. -/
theorem affine_four_lobes_global_eq
    (f Pcp Pcm Ppp Ppm : Real -> Complex) (r c : Real) (hr : r ≠ 0)
    (hPcpzero : ∀ u, u ∉ Icc (1 / 2 : Real) 2 -> Pcp u = 0)
    (hPcmzero : ∀ u, u ∉ Icc (1 / 2 : Real) 2 -> Pcm u = 0)
    (hPppzero : ∀ u, u ∉ Icc (1 / 2 : Real) 2 -> Ppp u = 0)
    (hPpmzero : ∀ u, u ∉ Icc (1 / 2 : Real) 2 -> Ppm u = 0)
    (hpos : ∀ u, u ∈ Icc (1 / 2 : Real) 2 ->
      f (c + r * u) = Pcp u + Ppp u)
    (hneg : ∀ u, u ∈ Icc (1 / 2 : Real) 2 ->
      f (c - r * u) = Pcm u + Ppm u)
    (houtside : ∀ u, u ∉ Icc (1 / 2 : Real) 2 ->
      -u ∉ Icc (1 / 2 : Real) 2 -> f (c + r * u) = 0) :
    ∀ theta : Real, f theta =
      (Pcp ((theta - c) / r) + Pcm ((c - theta) / r)) +
        (Ppp ((theta - c) / r) + Ppm ((c - theta) / r)) := by
  intro theta
  let u : Real := (theta - c) / r
  have htheta : c + r * u = theta := by
    dsimp [u]
    field_simp [hr]
    ring
  have hreflect : (c - theta) / r = -u := by
    dsimp [u]
    field_simp [hr]
    ring
  have hpluscoord : (c + r * u - c) / r = u := by
    field_simp [hr]
    ring
  have hminuscoord : (c - (c + r * u)) / r = -u := by
    field_simp [hr]
    ring
  by_cases hu : u ∈ Icc (1 / 2 : Real) 2
  · have hminus : -u ∉ Icc (1 / 2 : Real) 2 := by
      intro hmem
      linarith [hu.1, hmem.1]
    rw [← htheta, hpluscoord, hminuscoord, hpos u hu,
      hPcmzero (-u) hminus, hPpmzero (-u) hminus]
    ring
  · by_cases hnegmem : -u ∈ Icc (1 / 2 : Real) 2
    · have hpluszero : Pcp u = 0 := hPcpzero u hu
      have hphasezero : Ppp u = 0 := hPppzero u hu
      have htheta' : c - r * (-u) = theta := by
        rw [← htheta]
        ring
      have hnegcoord : (c - (c - r * (-u))) / r = -u := by
        field_simp [hr]
        ring
      have hposcoord' : ((c - r * (-u)) - c) / r = u := by
        field_simp [hr]
        ring
      rw [← htheta', hnegcoord, hposcoord',
        hneg (-u) hnegmem, hpluszero, hphasezero]
      ring
    · rw [← htheta, hpluscoord, hminuscoord,
        houtside u hu hnegmem, hPcpzero u hu, hPcmzero (-u) hnegmem,
        hPppzero u hu, hPpmzero (-u) hnegmem]
      ring

/-- A global angular field which is the sum of a positive and reflected
cutoff lobe and a positive and reflected phase lobe has its square energy
controlled by the four standard-coordinate energies.  This is purely the
affine/Cauchy layer; all circle and TT* analysis stays in the four supplied
profiles. -/
theorem shellFrequencyEnergy_affine_four_lobes_restrict_le
    (f Pcp Pcm Ppp Ppm : Real -> Complex)
    (r c lo hi : Real) (xi : Euclidean 2) (hr : 0 < r)
    (hPcpcont : Continuous Pcp) (hPcmcont : Continuous Pcm)
    (hPppcont : Continuous Ppp) (hPpmcont : Continuous Ppm)
    (hPcpzero : ∀ u, u ∉ Icc (1 / 2 : Real) 2 -> Pcp u = 0)
    (hPcmzero : ∀ u, u ∉ Icc (1 / 2 : Real) 2 -> Pcm u = 0)
    (hPppzero : ∀ u, u ∉ Icc (1 / 2 : Real) 2 -> Ppp u = 0)
    (hPpmzero : ∀ u, u ∉ Icc (1 / 2 : Real) 2 -> Ppm u = 0)
    (hraw : ∀ theta : Real, f theta =
      (Pcp ((theta - c) / r) + Pcm ((c - theta) / r)) +
        (Ppp ((theta - c) / r) + Ppm ((c - theta) / r))) :
    shellFrequencyEnergy (fun theta _ => f theta) lo hi xi <=
      2 * (
        2 * (r * (∫ u : Real, ‖Pcp u‖ ^ (2 : Nat)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2))) +
          r * (∫ u : Real, ‖Pcm u‖ ^ (2 : Nat)
            ∂(volume.restrict (Icc (1 / 2 : Real) 2)))) +
        2 * (r * (∫ u : Real, ‖Ppp u‖ ^ (2 : Nat)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2))) +
          r * (∫ u : Real, ‖Ppm u‖ ^ (2 : Nat)
            ∂(volume.restrict (Icc (1 / 2 : Real) 2))))) := by
  let mcp : Real -> Euclidean 2 -> Complex := fun theta _ => Pcp ((theta - c) / r)
  let mcm : Real -> Euclidean 2 -> Complex := fun theta _ => Pcm ((c - theta) / r)
  let mpp : Real -> Euclidean 2 -> Complex := fun theta _ => Ppp ((theta - c) / r)
  let mpm : Real -> Euclidean 2 -> Complex := fun theta _ => Ppm ((c - theta) / r)
  have hcpint : Integrable (fun theta : Real => ‖mcp theta xi‖ ^ (2 : Nat))
      (volume.restrict (Icc lo hi)) := by
    dsimp [mcp]
    exact (integrable_norm_sq_affine_lobe_of_continuous_analysis
      Pcp r c hr hPcpcont hPcpzero).restrict
  have hcmint : Integrable (fun theta : Real => ‖mcm theta xi‖ ^ (2 : Nat))
      (volume.restrict (Icc lo hi)) := by
    dsimp [mcm]
    exact (integrable_norm_sq_reflected_affine_lobe_of_continuous_analysis
      Pcm r c hr hPcmcont hPcmzero).restrict
  have hppint : Integrable (fun theta : Real => ‖mpp theta xi‖ ^ (2 : Nat))
      (volume.restrict (Icc lo hi)) := by
    dsimp [mpp]
    exact (integrable_norm_sq_affine_lobe_of_continuous_analysis
      Ppp r c hr hPppcont hPppzero).restrict
  have hpmint : Integrable (fun theta : Real => ‖mpm theta xi‖ ^ (2 : Nat))
      (volume.restrict (Icc lo hi)) := by
    dsimp [mpm]
    exact (integrable_norm_sq_reflected_affine_lobe_of_continuous_analysis
      Ppm r c hr hPpmcont hPpmzero).restrict
  have hfour := shellFrequencyEnergy_four_terms_le mcp mcm mpp mpm lo hi xi
    (by dsimp [mcp]; fun_prop) (by dsimp [mcm]; fun_prop)
    (by dsimp [mpp]; fun_prop) (by dsimp [mpm]; fun_prop)
    hcpint hcmint hppint hpmint
  have hcp := integral_norm_sq_affine_complex_lobe_restrict_le
    Pcp r c lo hi hr hPcpzero
    (integrable_norm_sq_affine_lobe_of_continuous_analysis Pcp r c hr hPcpcont hPcpzero)
  have hcm := integral_norm_sq_reflected_affine_complex_lobe_restrict_le
    Pcm r c lo hi hr hPcmzero
    (integrable_norm_sq_reflected_affine_lobe_of_continuous_analysis Pcm r c hr hPcmcont hPcmzero)
  have hpp := integral_norm_sq_affine_complex_lobe_restrict_le
    Ppp r c lo hi hr hPppzero
    (integrable_norm_sq_affine_lobe_of_continuous_analysis Ppp r c hr hPppcont hPppzero)
  have hpm := integral_norm_sq_reflected_affine_complex_lobe_restrict_le
    Ppm r c lo hi hr hPpmzero
    (integrable_norm_sq_reflected_affine_lobe_of_continuous_analysis Ppm r c hr hPpmcont hPpmzero)
  rw [show (fun theta : Real => fun _ : Euclidean 2 => f theta) =
      (fun theta : Real => fun x : Euclidean 2 =>
        (mcp theta x + mcm theta x) + (mpp theta x + mpm theta x)) by
        funext theta x
        exact hraw theta]
  calc
    shellFrequencyEnergy (fun theta x =>
        (mcp theta x + mcm theta x) + (mpp theta x + mpm theta x)) lo hi xi <=
      2 * ((2 * (shellFrequencyEnergy mcp lo hi xi + shellFrequencyEnergy mcm lo hi xi)) +
        (2 * (shellFrequencyEnergy mpp lo hi xi + shellFrequencyEnergy mpm lo hi xi))) := hfour
    _ <= 2 * (
        2 * (r * (∫ u : Real, ‖Pcp u‖ ^ (2 : Nat)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2))) +
          r * (∫ u : Real, ‖Pcm u‖ ^ (2 : Nat)
            ∂(volume.restrict (Icc (1 / 2 : Real) 2)))) +
        2 * (r * (∫ u : Real, ‖Ppp u‖ ^ (2 : Nat)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2))) +
          r * (∫ u : Real, ‖Ppm u‖ ^ (2 : Nat)
            ∂(volume.restrict (Icc (1 / 2 : Real) 2))))) := by
      dsimp [mcp, mcm, mpp, mpm, shellFrequencyEnergy] at hfour ⊢
      gcongr

end

end Auto.Spherical.MSS
