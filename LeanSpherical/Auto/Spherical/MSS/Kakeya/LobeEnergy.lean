/-- The literal dyadic shifted multiplier has exactly the two fixed-
coordinate E0 lobe energies at each charted polar frequency.  This closes
the affine/reindexing part of the fixed-frequency TT* transport; the Schur
package can be applied to the right-hand side without further geometry. -/
theorem shellFrequencyEnergy_shiftedCharted_dyadic_le_two_lobes
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    {eps r : Real} (heps : 0 < eps) (K n k : Nat) (hk : k < K)
    (lo hi : Real) (xi : Euclidean 2)
    (hpolar : xi = ‖xi‖ • circleDirection (C.angle j xi))
    (hn : n < 7)
    (hr : r = (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps)) :
    shellFrequencyEnergy
      (shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n (k + 1))
      lo hi xi ≤
      2 *
        (shiftedFiberLobeEnergy (shiftedDyadicPositiveProfile n) r
          (stationaryRadialSign n * ‖xi‖)
          (scratch_finiteTensorTimeData s (chartProfiles C j q) a xi) +
        shiftedFiberLobeEnergy (shiftedDyadicReflectedNegativeProfile n) r
          (stationaryRadialSign n * ‖xi‖)
          (scratch_finiteTensorTimeData s (chartProfiles C j q) a xi)) := by
  let c : Real := C.angle j xi + stationaryShift n
  let M : Real -> Complex := fun theta =>
    scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
      (chartProfiles_compact C j q hqcompact) a (circleDirection theta) xi
  let H : Real -> Complex := scratch_finiteTensorTimeData s (chartProfiles C j q) a xi
  let gPlus : Real -> Real -> Real := fun rho u => shiftedDyadicPositiveProfile n (rho, u)
  let gMinus : Real -> Real -> Real := fun rho u =>
    shiftedDyadicReflectedNegativeProfile n (rho, u)
  have hrpos : 0 < r := by
    rw [hr]
    positivity
  have hMcont : Continuous M := by
    let F : Real × Euclidean 2 -> Complex := fun p =>
      scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
        (chartProfiles_compact C j q hqcompact) a (circleDirection p.1) p.2
    have hF : Continuous F :=
      continuous_uncurry_scratch_finiteTensorTubeMultiplier_circle
        s (chartProfiles C j q) (chartProfiles_compact C j q hqcompact) a
    have hmap : Continuous (fun theta : Real => (theta, xi)) :=
      continuous_id.prodMk continuous_const
    change Continuous (fun theta : Real => F (theta, xi))
    exact (hF.comp hmap).congr (by intro theta; rfl)
  have hraw (theta : Real) :
      shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n (k + 1)
        theta xi =
        (shiftedDyadicPositiveProfile n (r, (theta - c) / r) : Complex) * M theta +
        (shiftedDyadicReflectedNegativeProfile n (r, (c - theta) / r) : Complex) * M theta := by
    simpa only [c, M] using
      (shiftedCharted_dyadicMultiplier_eq_affine_plus_reflected
        C j s q hqcompact a heps K n k hk theta xi hr)
  have hplus (u : Real) :
      (shiftedDyadicPositiveProfile n (r, u) : Complex) * M (c + r * u) =
        ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
            (shiftedDyadicPositiveProfile n) r
            (stationaryRadialSign n * ‖xi‖)) H u := by
    simpa only [c, M, H] using
      (shiftedCharted_lobeMultiplier_eq_parametricAnalysis
        C j s q hqcompact a xi (C.angle j xi) hpolar n hn
        (shiftedDyadicPositiveProfile n) r u)
  have hminus (u : Real) :
      (shiftedDyadicReflectedNegativeProfile n (r, u) : Complex) * M (c - r * u) =
        ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
            (shiftedDyadicReflectedNegativeProfile n) r
            (stationaryRadialSign n * ‖xi‖)) H u := by
    simpa only [c, M, H] using
      (shiftedCharted_reflectedLobeMultiplier_eq_parametricAnalysis
        C j s q hqcompact a xi (C.angle j xi) hpolar n hn
        (shiftedDyadicReflectedNegativeProfile n) r u)
  have hplusInt :
      (∫ u : Real, ‖(shiftedDyadicPositiveProfile n (r, u) : Complex) *
        M (c + r * u)‖ ^ (2 : Nat) ∂(volume.restrict (Icc (1 / 2 : Real) 2))) =
      ∫ u : Real, ‖ttstarAnalysis volume
        (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
          (shiftedDyadicPositiveProfile n) r (stationaryRadialSign n * ‖xi‖)) H u‖ ^
          (2 : Nat) ∂(volume.restrict (Icc (1 / 2 : Real) 2)) := by
    apply integral_congr_ae
    filter_upwards with u
    rw [hplus]
  have hminusInt :
      (∫ u : Real, ‖(shiftedDyadicReflectedNegativeProfile n (r, u) : Complex) *
        M (c - r * u)‖ ^ (2 : Nat) ∂(volume.restrict (Icc (1 / 2 : Real) 2))) =
      ∫ u : Real, ‖ttstarAnalysis volume
        (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
          (shiftedDyadicReflectedNegativeProfile n) r
            (stationaryRadialSign n * ‖xi‖)) H u‖ ^
          (2 : Nat) ∂(volume.restrict (Icc (1 / 2 : Real) 2)) := by
    apply integral_congr_ae
    filter_upwards with u
    rw [hminus]
  have htransport := integral_norm_sq_affine_plus_reflected_lobes_restrict_le
    gPlus gMinus
    M r c lo hi hrpos
    (by simpa only [gPlus] using (contDiff_shiftedDyadicPositiveProfile n).continuous)
    (by simpa only [gMinus] using
      (contDiff_shiftedDyadicReflectedNegativeProfile n).continuous) hMcont
    (by intro u hu
        simpa only [gPlus] using
          (shiftedDyadicPositiveProfile_eq_zero_of_not_mem_Icc n r u hu))
    (by intro u hu
        simpa only [gMinus] using
          (shiftedDyadicReflectedNegativeProfile_eq_zero_of_not_mem_Icc n r u hu))
  unfold shellFrequencyEnergy
  rw [show (fun theta : Real =>
      ‖shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n (k + 1)
        theta xi‖ ^ (2 : Nat)) =
      fun theta => ‖(shiftedDyadicPositiveProfile n (r, (theta - c) / r) : Complex) *
        M theta + (shiftedDyadicReflectedNegativeProfile n (r, (c - theta) / r) : Complex) *
        M theta‖ ^ (2 : Nat) by
        funext theta
        rw [hraw]]
  calc
    (∫ theta : Real,
      ‖(shiftedDyadicPositiveProfile n (r, (theta - c) / r) : Complex) * M theta +
        (shiftedDyadicReflectedNegativeProfile n (r, (c - theta) / r) : Complex) *
          M theta‖ ^ (2 : Nat) ∂(volume.restrict (Icc lo hi))) ≤
        2 * r *
          ((∫ u : Real, ‖(shiftedDyadicPositiveProfile n (r, u) : Complex) *
            M (c + r * u)‖ ^ (2 : Nat) ∂(volume.restrict (Icc (1 / 2 : Real) 2))) +
          (∫ u : Real, ‖(shiftedDyadicReflectedNegativeProfile n (r, u) : Complex) *
            M (c - r * u)‖ ^ (2 : Nat) ∂(volume.restrict (Icc (1 / 2 : Real) 2)))) :=
      (by simpa only [gPlus, gMinus] using htransport)
    _ = 2 *
        (shiftedFiberLobeEnergy (shiftedDyadicPositiveProfile n) r
          (stationaryRadialSign n * ‖xi‖) H +
        shiftedFiberLobeEnergy (shiftedDyadicReflectedNegativeProfile n) r
          (stationaryRadialSign n * ‖xi‖) H) := by
      rw [hplusInt, hminusInt]
      unfold shiftedFiberLobeEnergy
      ring

/-- Profile-agnostic version of the preceding E0 transport.  A literal
two-sided affine decomposition together with its two signed cosine phase
identities is enough to turn physical angular energy into the standard
two-lobe `TT*` energy.  It is used unchanged for the capped terminal shell. -/
theorem shellFrequencyEnergy_le_two_affine_ttstar_lobes
    (m : Real -> Complex) (M H : Real -> Complex)
    (gPlus gMinus : Real × Real -> Real)
    (r c lo hi lambda : Real) (hr : 0 < r)
    (hMcont : Continuous M)
    (hPlusCont : Continuous gPlus) (hMinusCont : Continuous gMinus)
    (hPlusZero : ∀ u, u ∉ Icc (1 / 2 : Real) 2 -> gPlus (r, u) = 0)
    (hMinusZero : ∀ u, u ∉ Icc (1 / 2 : Real) 2 -> gMinus (r, u) = 0)
    (hraw : ∀ theta, m theta =
      (gPlus (r, (theta - c) / r) : Complex) * M theta +
      (gMinus (r, (c - theta) / r) : Complex) * M theta)
    (hplus : ∀ u,
      (gPlus (r, u) : Complex) * M (c + r * u) =
        ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude gPlus r lambda) H u)
    (hminus : ∀ u,
      (gMinus (r, u) : Complex) * M (c - r * u) =
        ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude gMinus r lambda) H u) :
    shellFrequencyEnergy (fun (theta : Real) (_ : Euclidean 2) => m theta) lo hi 0 ≤
      2 * (shiftedFiberLobeEnergy gPlus r lambda H +
        shiftedFiberLobeEnergy gMinus r lambda H) := by
  let gp : Real -> Real -> Real := fun rho u => gPlus (rho, u)
  let gm : Real -> Real -> Real := fun rho u => gMinus (rho, u)
  have htransport := integral_norm_sq_affine_plus_reflected_lobes_restrict_le
    gp gm M r c lo hi hr
    (by simpa only [gp] using hPlusCont)
    (by simpa only [gm] using hMinusCont) hMcont
    (by intro u hu; simpa only [gp] using hPlusZero u hu)
    (by intro u hu; simpa only [gm] using hMinusZero u hu)
  have hplusInt :
      (∫ u : Real, ‖(gPlus (r, u) : Complex) * M (c + r * u)‖ ^ (2 : Nat)
        ∂(volume.restrict (Icc (1 / 2 : Real) 2))) =
      ∫ u : Real, ‖ttstarAnalysis volume
        (outerCircleParametricRealProfileFourierCharAnalysisAmplitude gPlus r lambda) H u‖ ^
          (2 : Nat) ∂(volume.restrict (Icc (1 / 2 : Real) 2)) := by
    apply integral_congr_ae
    filter_upwards with u
    rw [hplus]
  have hminusInt :
      (∫ u : Real, ‖(gMinus (r, u) : Complex) * M (c - r * u)‖ ^ (2 : Nat)
        ∂(volume.restrict (Icc (1 / 2 : Real) 2))) =
      ∫ u : Real, ‖ttstarAnalysis volume
        (outerCircleParametricRealProfileFourierCharAnalysisAmplitude gMinus r lambda) H u‖ ^
          (2 : Nat) ∂(volume.restrict (Icc (1 / 2 : Real) 2)) := by
    apply integral_congr_ae
    filter_upwards with u
    rw [hminus]
  unfold shellFrequencyEnergy
  change (∫ theta : Real, ‖m theta‖ ^ (2 : Nat)
    ∂(volume.restrict (Icc lo hi))) ≤ _
  rw [show (fun theta : Real => ‖m theta‖ ^ (2 : Nat)) =
      fun theta => ‖(gPlus (r, (theta - c) / r) : Complex) * M theta +
        (gMinus (r, (c - theta) / r) : Complex) * M theta‖ ^ (2 : Nat) by
      funext theta
      rw [hraw]]
  calc
    (∫ theta : Real, ‖(gPlus (r, (theta - c) / r) : Complex) * M theta +
      (gMinus (r, (c - theta) / r) : Complex) * M theta‖ ^ (2 : Nat)
      ∂(volume.restrict (Icc lo hi))) ≤
        2 * r *
          ((∫ u : Real, ‖(gPlus (r, u) : Complex) * M (c + r * u)‖ ^ (2 : Nat)
            ∂(volume.restrict (Icc (1 / 2 : Real) 2))) +
          (∫ u : Real, ‖(gMinus (r, u) : Complex) * M (c - r * u)‖ ^ (2 : Nat)
            ∂(volume.restrict (Icc (1 / 2 : Real) 2)))) :=
      (by simpa only [gp, gm] using htransport)
    _ = 2 * (shiftedFiberLobeEnergy gPlus r lambda H +
      shiftedFiberLobeEnergy gMinus r lambda H) := by
      rw [hplusInt, hminusInt]
      unfold shiftedFiberLobeEnergy
      ring

set_option maxHeartbeats 800000 in
/-- Compress the literal dyadic E0 transport with any supplied two-lobe
Schur package.  The stationary radial sign disappears exactly under
absolute value, leaving the physical factor `‖xi‖ * r`. -/
theorem shellFrequencyEnergy_shiftedCharted_dyadic_le_source_of_lobeBounds
    {kappa : Type uK} {iota : Type uI} {charts : Finset kappa} {active : Set (Euclidean 2)}
    {rhoMax : Real}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    {eps r : Real} (heps : 0 < eps) (K n k : Nat) (hk : k < K)
    (lo hi : Real) (xi : Euclidean 2)
    (hpolar : xi = ‖xi‖ • circleDirection (C.angle j xi))
    (hn : n < 7) (hxi : ‖xi‖ ≠ 0)
    (hr : r = (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps))
    (hrmem : r ∈ Ioc (0 : Real) rhoMax)
    (D : ShiftedFiberTwoLobeEnergyBounds.{uI} rhoMax
      (shiftedDyadicPositiveProfile n)
      (shiftedDyadicReflectedNegativeProfile n)
      (shiftedDyadicPositiveCutoffDerivativeProfile n)
      (shiftedDyadicReflectedNegativeCutoffDerivativeProfile n)
      (shiftedDyadicPositiveScaledPhaseProfile n)
      (shiftedDyadicReflectedNegativeScaledPhaseProfile n))
    {rTime : Real} (hrTime : rTime < 1)
    (hsupport : ∀ l, Function.support (a l : Real -> Complex) ⊆
      closedBall (3 / 2 : Real) rTime) :
    shellFrequencyEnergy
      (shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n (k + 1))
      lo hi xi ≤
      ((2 * (D.B0plus + D.B0minus)) / (‖xi‖ * r)) *
        shiftedFiberSourceEnergy s (chartProfiles C j q) a xi := by
  let signedLambda : Real := stationaryRadialSign n * ‖xi‖
  have hsign : stationaryRadialSign n ≠ 0 := by
    interval_cases n <;> norm_num [stationaryRadialSign]
  have hsigned : signedLambda ≠ 0 := mul_ne_zero hsign hxi
  have habs : |signedLambda| = ‖xi‖ := by
    dsimp only [signedLambda]
    interval_cases n <;> simp [stationaryRadialSign, norm_nonneg]
  have hbase := shellFrequencyEnergy_shiftedCharted_dyadic_le_two_lobes
    C j s q hqcompact a heps K n k hk lo hi xi hpolar hn hr
  have hbudget := @ShiftedFiberTwoLobeEnergyBounds.e0_two_lobe_budget
    rhoMax
    (shiftedDyadicPositiveProfile n)
    (shiftedDyadicReflectedNegativeProfile n)
    (shiftedDyadicPositiveCutoffDerivativeProfile n)
    (shiftedDyadicReflectedNegativeCutoffDerivativeProfile n)
    (shiftedDyadicPositiveScaledPhaseProfile n)
    (shiftedDyadicReflectedNegativeScaledPhaseProfile n)
    D r signedLambda hrmem hsigned iota s (chartProfiles C j q) a xi rTime hrTime hsupport
  calc
    shellFrequencyEnergy
        (shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n (k + 1))
        lo hi xi ≤
        2 *
          (shiftedFiberLobeEnergy (shiftedDyadicPositiveProfile n) r signedLambda
            (scratch_finiteTensorTimeData s (chartProfiles C j q) a xi) +
          shiftedFiberLobeEnergy (shiftedDyadicReflectedNegativeProfile n) r signedLambda
            (scratch_finiteTensorTimeData s (chartProfiles C j q) a xi)) := by
      simpa only [signedLambda] using hbase
    _ ≤ 2 *
        ((D.B0plus / (|signedLambda| * r)) *
          shiftedFiberSourceEnergy s (chartProfiles C j q) a xi +
        (D.B0minus / (|signedLambda| * r)) *
          shiftedFiberSourceEnergy s (chartProfiles C j q) a xi) := hbudget
    _ = ((2 * (D.B0plus + D.B0minus)) / (‖xi‖ * r)) *
        shiftedFiberSourceEnergy s (chartProfiles C j q) a xi := by
      rw [habs]
      ring

/-- Literal capped-terminal E0 transport in the same two-lobe form as every
dyadic member.  The bounded terminal ratio is an actual parameter, not an
unproved uniform-family witness. -/
theorem shellFrequencyEnergy_shiftedCharted_terminal_le_two_lobes
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    {eps ratio r : Real} (K n : Nat) (lo hi : Real) (xi : Euclidean 2)
    (hpolar : xi = ‖xi‖ • circleDirection (C.angle j xi))
    (hn : n < 7)
    (hratio : ratio ∈ Icc (1 / 2 : Real) 1)
    (hratioDef : ratio = ((2 : Real) ^ K * eps) / (Real.pi / 2))
    (hr : r = (4 / 5 : Real) * (Real.pi / 2)) :
    shellFrequencyEnergy
      (shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n (K + 1))
      lo hi xi ≤
      2 *
        (shiftedFiberLobeEnergy (shiftedCappedTerminalPositiveProfile n ratio) r
          (stationaryRadialSign n * ‖xi‖)
          (scratch_finiteTensorTimeData s (chartProfiles C j q) a xi) +
        shiftedFiberLobeEnergy (shiftedCappedTerminalReflectedNegativeProfile n ratio) r
          (stationaryRadialSign n * ‖xi‖)
          (scratch_finiteTensorTimeData s (chartProfiles C j q) a xi)) := by
  let c : Real := C.angle j xi + stationaryShift n
  let M : Real -> Complex := fun theta =>
    scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
      (chartProfiles_compact C j q hqcompact) a (circleDirection theta) xi
  let H : Real -> Complex := scratch_finiteTensorTimeData s (chartProfiles C j q) a xi
  have hrpos : 0 < r := by
    rw [hr]
    have : 0 < Real.pi := Real.pi_pos
    positivity
  have hMcont : Continuous M := by
    let F : Real × Euclidean 2 -> Complex := fun p =>
      scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
