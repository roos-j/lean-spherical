/-- Exact whole-line affine change of variables in the positive orientation.
This form deliberately needs no integrability premise: Mathlib's Bochner
integral convention makes the identity valid uniformly. -/
theorem integral_affine_comp_eq
    (F : Real -> Real) (c r : Real) (hr : 0 < r) :
    (∫ theta : Real, F theta) = r * ∫ u : Real, F (c + r * u) := by
  let G : Real -> Real := fun x => F (x + c)
  have htranslate : (∫ x : Real, G x) = ∫ x : Real, F x := by
    dsimp only [G]
    exact (measurePreserving_add_right (volume : Measure Real) c).integral_comp
      (Homeomorph.addRight c).isClosedEmbedding.measurableEmbedding F
  have hscale : (∫ u : Real, G (r * u)) =
      r⁻¹ * ∫ x : Real, G x := by
    simpa only [abs_of_pos (inv_pos.mpr hr), smul_eq_mul] using
      (Measure.integral_comp_mul_left G r)
  calc
    (∫ theta : Real, F theta) = ∫ x : Real, G x := htranslate.symm
    _ = r * (r⁻¹ * ∫ x : Real, G x) := by
      rw [← mul_assoc, mul_inv_cancel₀ (ne_of_gt hr), one_mul]
    _ = r * ∫ u : Real, G (r * u) := by rw [hscale]
    _ = r * ∫ u : Real, F (c + r * u) := by
      rw [show (fun u : Real => G (r * u)) =
        fun u => F (c + r * u) by
          funext u
          dsimp only [G]
          ring]

/-- The compactly supported lobe form used by the angular shell calculation.
The left-hand side may be integrated over any angular interval; it is bounded
by the rescaled unit-coordinate energy whenever the lobe vanishes outside
`[1/2,2]`. -/
theorem integral_norm_sq_affine_lobe_restrict_le
    (g : Real -> Real -> Real) (M : Real -> Complex)
    (r c L U : Real) (hr : 0 < r)
    (hzero : ∀ u, u ∉ Icc (1 / 2 : Real) 2 -> g r u = 0)
    (hFint : Integrable (fun theta : Real =>
      ‖((g r ((theta - c) / r) : Complex) * M theta)‖ ^ (2 : Nat))) :
    (∫ theta : Real,
      ‖((g r ((theta - c) / r) : Complex) * M theta)‖ ^ (2 : Nat)
        ∂(volume.restrict (Icc L U))) ≤
      r * ∫ u : Real,
        ‖((g r u : Complex) * M (c + r * u))‖ ^ (2 : Nat)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2)) := by
  let F : Real -> Real := fun theta =>
    ‖((g r ((theta - c) / r) : Complex) * M theta)‖ ^ (2 : Nat)
  let H : Real -> Real := fun u =>
    ‖((g r u : Complex) * M (c + r * u))‖ ^ (2 : Nat)
  have hFnonneg : 0 ≤ᵐ[volume] F := Filter.Eventually.of_forall fun theta =>
    sq_nonneg _
  have hmono : (∫ theta : Real, F theta ∂(volume.restrict (Icc L U))) ≤
      ∫ theta : Real, F theta :=
    integral_mono_measure Measure.restrict_le_self hFnonneg (by simpa only [F] using hFint)
  have haffine : (∫ theta : Real, F theta) = r * ∫ u : Real, H u := by
    calc
      (∫ theta : Real, F theta) = r * ∫ u : Real, F (c + r * u) :=
        integral_affine_comp_eq F c r hr
      _ = r * ∫ u : Real, H u := by
        rw [show (fun u : Real => F (c + r * u)) = fun u => H u by
          funext u
          dsimp only [F, H]
          have harg : (c + r * u - c) / r = u := by
            field_simp [ne_of_gt hr]
            ring
          rw [harg]]
  have hHzero : ∀ u, u ∉ Icc (1 / 2 : Real) 2 -> H u = 0 := by
    intro u hu
    dsimp only [H]
    rw [hzero u hu]
    norm_num
  have hrestrict : (∫ u : Real, H u ∂(volume.restrict (Icc (1 / 2 : Real) 2))) =
      ∫ u : Real, H u :=
    setIntegral_eq_integral_of_forall_compl_eq_zero hHzero
  change (∫ theta : Real, F theta ∂(volume.restrict (Icc L U))) ≤
    r * ∫ u : Real, H u ∂(volume.restrict (Icc (1 / 2 : Real) 2))
  calc
    (∫ theta : Real, F theta ∂(volume.restrict (Icc L U))) ≤
        ∫ theta : Real, F theta := hmono
    _ = r * ∫ u : Real, H u := haffine
    _ = r * ∫ u : Real, H u ∂(volume.restrict (Icc (1 / 2 : Real) 2)) := by
      rw [hrestrict]

end

