/-- Changing the sign of the Fourier frequency swaps the two time slots. -/
theorem outerCircleProfileFourierCharProductKernel_neg_frequency_eq_swap
    (A : Real × Real -> Complex) (rho lambda t s : Real) :
    outerCircleProfileFourierCharProductKernel A rho (-lambda) t s =
      outerCircleProfileFourierCharProductKernel A rho lambda s t := by
  unfold outerCircleProfileFourierCharProductKernel
  congr 1
  apply intervalIntegral.integral_congr
  intro u hu
  congr 1
  ring

/-- A self-conjugate amplitude makes the Fourier-character kernel norm
symmetric in its two time variables, at either frequency sign. -/
theorem norm_outerCircleProfileFourierCharProductKernel_symm
    (A : Real × Real -> Complex) (hstar : ∀ p, starRingEnd Complex (A p) = A p)
    (rho lambda t s : Real) :
    ‖outerCircleProfileFourierCharProductKernel A rho lambda t s‖ =
      ‖outerCircleProfileFourierCharProductKernel A rho lambda s t‖ := by
  calc
    ‖outerCircleProfileFourierCharProductKernel A rho lambda t s‖ =
        ‖outerCircleProfileProductTimeKernel A rho ((2 * Real.pi) * lambda) t s‖ :=
      norm_outerCircleProfileFourierCharProductKernel_eq_positive A hstar rho lambda t s
    _ = ‖outerCircleProfileProductTimeKernel A rho ((2 * Real.pi) * lambda) s t‖ :=
      norm_outerCircleProfileProductTimeKernel_symm A hstar
        rho ((2 * Real.pi) * lambda) t s
    _ = ‖outerCircleProfileFourierCharProductKernel A rho lambda s t‖ :=
      (norm_outerCircleProfileFourierCharProductKernel_eq_positive A hstar rho lambda s t).symm

/-- The norm is invariant under a frequency-sign reversal. -/
theorem norm_outerCircleProfileFourierCharProductKernel_neg_frequency
    (A : Real × Real -> Complex) (hstar : ∀ p, starRingEnd Complex (A p) = A p)
    (rho lambda t s : Real) :
    ‖outerCircleProfileFourierCharProductKernel A rho (-lambda) t s‖ =
      ‖outerCircleProfileFourierCharProductKernel A rho lambda t s‖ := by
  rw [outerCircleProfileFourierCharProductKernel_neg_frequency_eq_swap]
  exact norm_outerCircleProfileFourierCharProductKernel_symm A hstar rho lambda s t

/-- The whole-line Fourier-character kernel envelope depends only on
`|lambda|`. -/
theorem norm_outerCircleProfileFourierCharProductKernel_eq_abs
    (A : Real × Real -> Complex) (hstar : ∀ p, starRingEnd Complex (A p) = A p)
    (rho lambda t s : Real) :
    ‖outerCircleProfileFourierCharProductKernel A rho lambda t s‖ =
      ‖outerCircleProfileFourierCharProductKernel A rho |lambda| t s‖ := by
  by_cases hlambda : 0 ≤ lambda
  · rw [abs_of_nonneg hlambda]
  · let mu : Real := |lambda|
    have hneg : lambda = -mu := by
      dsimp [mu]
      rw [abs_of_neg (lt_of_not_ge hlambda)]
      ring
    calc
      ‖outerCircleProfileFourierCharProductKernel A rho lambda t s‖ =
          ‖outerCircleProfileFourierCharProductKernel A rho (-mu) t s‖ := by
            rw [hneg]
      _ = ‖outerCircleProfileFourierCharProductKernel A rho mu t s‖ :=
        norm_outerCircleProfileFourierCharProductKernel_neg_frequency A hstar
          rho mu t s
      _ = ‖outerCircleProfileFourierCharProductKernel A rho |lambda| t s‖ := by
        rfl

