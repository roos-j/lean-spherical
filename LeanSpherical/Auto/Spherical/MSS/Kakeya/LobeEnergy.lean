/-- Cutoff-coordinate `E₁` for the positive dyadic lobe. -/
theorem exists_shiftedDyadicPositiveFiberEnergy_cutoff_E1
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) (n : Nat) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, lambda ≠ 0 →
      ∀ {ι : Type*} (s : Finset ι)
        (q : ι → SchwartzMap (Euclidean 2) Complex)
        (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2)
        {rTime : Real}, rTime < 1 →
        (∀ l, Function.support (a l : Real → Complex) ⊆
