        ∂(volume.restrict (Icc (1 / 2 : Real) 2)) := by
  let F : Real -> Real := fun theta => ‖P ((theta - c) / r)‖ ^ (2 : Nat)
  let H : Real -> Real := fun u => ‖P u‖ ^ (2 : Nat)
  have hFnonneg : 0 ≤ᵐ[volume] F := Filter.Eventually.of_forall fun theta => sq_nonneg _
