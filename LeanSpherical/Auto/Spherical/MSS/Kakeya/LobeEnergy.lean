attribute [local instance 2000] NormedAddCommGroup.toAddCommGroup

/-- The uncut finite-tensor circle multiplier is jointly continuous in the
circle parameter and spatial frequency. -/
theorem continuous_uncurry_scratch_finiteTensorTubeMultiplier_circle
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex) :
    Continuous (fun p : Real × Euclidean 2 =>
      scratch_finiteTensorTubeMultiplier s q hqcompact a
        (circleDirection p.1) p.2) := by
  rw [show (fun p : Real × Euclidean 2 =>
      scratch_finiteTensorTubeMultiplier s q hqcompact a
        (circleDirection p.1) p.2) =
      fun p => ∑ i ∈ s, q i p.2 *
        (FourierTransform.fourier (a i) : SchwartzMap Real Complex)
          (inner Real (circleDirection p.1) p.2) by
    funext p
    exact scratch_finiteTensorTubeMultiplier_apply s q hqcompact a
      (circleDirection p.1) p.2]
  have hdir : Continuous (fun p : Real × Euclidean 2 => circleDirection p.1) := by
    unfold circleDirection
    fun_prop
  have hphase : Continuous (fun p : Real × Euclidean 2 =>
      inner Real (circleDirection p.1) p.2) := hdir.inner continuous_snd
  exact continuous_finsetSum _ fun i hi =>
    ((q i).continuous.comp continuous_snd).mul
      ((FourierTransform.fourier (a i) : SchwartzMap Real Complex).continuous.comp hphase)

/-- A global angular-uniform frequency majorant for the uncut finite tensor. -/
noncomputable def finiteTensorTubeMultiplierBound
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
    (xi : Euclidean 2) : Real :=
  ∑ i ∈ s,
    (SchwartzMap.seminorm Complex 0 0)
      (FourierTransform.fourier (a i) : SchwartzMap Real Complex) * ‖q i xi‖

theorem norm_scratch_finiteTensorTubeMultiplier_circle_le_bound
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (theta : Real) (xi : Euclidean 2) :
    ‖scratch_finiteTensorTubeMultiplier s q hqcompact a
      (circleDirection theta) xi‖ ≤
      finiteTensorTubeMultiplierBound s q a xi := by
  classical
  rw [scratch_finiteTensorTubeMultiplier_apply]
  unfold finiteTensorTubeMultiplierBound
  calc
    ‖∑ i ∈ s, q i xi *
        (FourierTransform.fourier (a i) : SchwartzMap Real Complex)
          (inner Real (circleDirection theta) xi)‖ ≤
        ∑ i ∈ s, ‖q i xi *
          (FourierTransform.fourier (a i) : SchwartzMap Real Complex)
            (inner Real (circleDirection theta) xi)‖ := norm_sum_le _ _
    _ ≤ ∑ i ∈ s,
        (SchwartzMap.seminorm Complex 0 0)
          (FourierTransform.fourier (a i) : SchwartzMap Real Complex) * ‖q i xi‖ := by
      apply Finset.sum_le_sum
      intro i hi
      calc
        ‖q i xi * (FourierTransform.fourier (a i) : SchwartzMap Real Complex)
            (inner Real (circleDirection theta) xi)‖ =
            ‖q i xi‖ * ‖(FourierTransform.fourier (a i) : SchwartzMap Real Complex)
              (inner Real (circleDirection theta) xi)‖ := norm_mul _ _
        _ ≤ ‖q i xi‖ *
            (SchwartzMap.seminorm Complex 0 0)
              (FourierTransform.fourier (a i) : SchwartzMap Real Complex) :=
          mul_le_mul_of_nonneg_left
            (SchwartzMap.norm_le_seminorm Complex
              (FourierTransform.fourier (a i) : SchwartzMap Real Complex) _)
            (norm_nonneg _)
        _ = (SchwartzMap.seminorm Complex 0 0)
              (FourierTransform.fourier (a i) : SchwartzMap Real Complex) * ‖q i xi‖ := by
          ring

theorem integrable_finiteTensorTubeMultiplierBound
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) :
    Integrable (finiteTensorTubeMultiplierBound s q a) := by
  classical
  unfold finiteTensorTubeMultiplierBound
  exact integrable_finsetSum s fun i hi =>
    (q i).integrable.norm.const_mul _

theorem continuous_uncurry_canonicalLowpassFiniteTensorMultiplier_circle
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex) :
    Continuous (fun p : Real × Euclidean 2 =>
      canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a
        (circleDirection p.1) p.2) := by
  rw [show (fun p : Real × Euclidean 2 =>
      canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a
        (circleDirection p.1) p.2) =
      fun p => intDyadicLowpassMultiplier C.cutoff 0 p.2 *
        (scratch_canonicalBandlimitedTubeMultiplier rho hrho p.2 *
          scratch_finiteTensorTubeMultiplier s q hqcompact a
            (circleDirection p.1) p.2) by
    funext p
    exact canonicalLowpassFiniteTensorMultiplier_apply C rho hrho s q hqcompact a
      (circleDirection p.1) p.2]
  exact ((intDyadicLowpassMultiplier C.cutoff 0).continuous.comp continuous_snd).mul
    (((scratch_canonicalBandlimitedTubeMultiplier rho hrho).continuous.comp continuous_snd).mul
      (continuous_uncurry_scratch_finiteTensorTubeMultiplier_circle s q hqcompact a))

theorem norm_canonicalLowpassFiniteTensorMultiplier_circle_le_majorant
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (theta : Real) (xi : Euclidean 2) :
    ‖canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a
      (circleDirection theta) xi‖ ≤
      canonicalTubeMultiplierUniformBound * finiteTensorTubeMultiplierBound s q a xi := by
  rw [canonicalLowpassFiniteTensorMultiplier_apply, norm_mul, norm_mul]
  have hcan := norm_scratch_canonicalBandlimitedTubeMultiplier_le_uniformBound hrho xi
  have hlow := norm_intDyadicLowpassMultiplier_zero_le_one C xi
  have hraw := norm_scratch_finiteTensorTubeMultiplier_circle_le_bound
    s q hqcompact a theta xi
  have hU : 0 ≤ canonicalTubeMultiplierUniformBound := by
    dsimp [canonicalTubeMultiplierUniformBound]
    positivity
  have hcanraw :
      ‖scratch_canonicalBandlimitedTubeMultiplier rho hrho xi‖ *
          ‖scratch_finiteTensorTubeMultiplier s q hqcompact a
            (circleDirection theta) xi‖ ≤
        canonicalTubeMultiplierUniformBound * finiteTensorTubeMultiplierBound s q a xi := by
    calc
      ‖scratch_canonicalBandlimitedTubeMultiplier rho hrho xi‖ *
          ‖scratch_finiteTensorTubeMultiplier s q hqcompact a
            (circleDirection theta) xi‖ ≤
          canonicalTubeMultiplierUniformBound *
            ‖scratch_finiteTensorTubeMultiplier s q hqcompact a
              (circleDirection theta) xi‖ :=
        mul_le_mul_of_nonneg_right hcan (norm_nonneg _)
      _ ≤ canonicalTubeMultiplierUniformBound *
            finiteTensorTubeMultiplierBound s q a xi :=
        mul_le_mul_of_nonneg_left hraw hU
  calc
    ‖intDyadicLowpassMultiplier C.cutoff 0 xi‖ *
        (‖scratch_canonicalBandlimitedTubeMultiplier rho hrho xi‖ *
          ‖scratch_finiteTensorTubeMultiplier s q hqcompact a
            (circleDirection theta) xi‖) ≤
        1 * (‖scratch_canonicalBandlimitedTubeMultiplier rho hrho xi‖ *
          ‖scratch_finiteTensorTubeMultiplier s q hqcompact a
            (circleDirection theta) xi‖) :=
      mul_le_mul_of_nonneg_right hlow
        (mul_nonneg (norm_nonneg _) (norm_nonneg _))
    _ ≤ 1 * (canonicalTubeMultiplierUniformBound *
          finiteTensorTubeMultiplierBound s q a xi) :=
      mul_le_mul_of_nonneg_left hcanraw (by norm_num)
    _ = canonicalTubeMultiplierUniformBound *
        finiteTensorTubeMultiplierBound s q a xi := by ring

theorem integrable_canonicalLowpassFiniteTensorMultiplier_circle_majorant
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) :
    Integrable (fun xi : Euclidean 2 =>
      canonicalTubeMultiplierUniformBound * finiteTensorTubeMultiplierBound s q a xi) :=
  (integrable_finiteTensorTubeMultiplierBound s q a).const_mul _

private theorem norm_real_fourierChar_eq_one (u : Real) :
    ‖(Real.fourierChar u : Complex)‖ = 1 := by
  rw [Real.fourierChar_apply, Complex.norm_exp]
  norm_num

/-- Global dominated convergence gives the joint physical continuity of the
canonical finite-core lowpass family. -/
theorem continuous_uncurry_fourierInv_canonicalLowpassFiniteTensorMultiplier_circle
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex) :
    Continuous (fun p : Real × Euclidean 2 =>
      FourierTransform.fourierInv
        (canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a
          (circleDirection p.1) : Euclidean 2 → Complex) p.2) := by
  let m : Real → Euclidean 2 → Complex := fun theta xi =>
    canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a
      (circleDirection theta) xi
  have hm : Continuous (Function.uncurry m) := by
    change Continuous (fun p : Real × Euclidean 2 =>
      canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a
        (circleDirection p.1) p.2)
    exact continuous_uncurry_canonicalLowpassFiniteTensorMultiplier_circle
      C rho hrho s q hqcompact a
  change Continuous (Function.uncurry (fun theta y =>
    FourierTransform.fourierInv (m theta) y))
  apply continuous_uncurry_fourierInv_of_dominated m
    (bound := fun xi => canonicalTubeMultiplierUniformBound *
      finiteTensorTubeMultiplierBound s q a xi)
  · intro xi
    have hphase : Continuous (fun p : Real × Euclidean 2 =>
        (Real.fourierChar (inner Real xi p.2) : Complex)) := by fun_prop
    have hmxi : Continuous (fun p : Real × Euclidean 2 => m p.1 xi) :=
      hm.comp (show Continuous (fun p : Real × Euclidean 2 => (p.1, xi)) by
        fun_prop)
    exact hphase.smul hmxi
  · intro p
    have hphase : Continuous (fun xi : Euclidean 2 =>
        (Real.fourierChar (inner Real xi p.2) : Complex)) := by fun_prop
    have hmxi : Continuous (fun xi : Euclidean 2 => m p.1 xi) :=
      hm.comp (show Continuous (fun xi : Euclidean 2 => (p.1, xi)) by
        fun_prop)
    exact (hphase.smul hmxi).aestronglyMeasurable
  · intro p xi
    rw [norm_smul, norm_real_fourierChar_eq_one, one_mul]
    exact norm_canonicalLowpassFiniteTensorMultiplier_circle_le_majorant
      C rho hrho s q hqcompact a p.1 xi
  · exact integrable_canonicalLowpassFiniteTensorMultiplier_circle_majorant
      C rho hrho s q a

/-- On every frequency fibre, the actual lowpass canonical multiplier has
the displayed Schwartz derivative family. -/
theorem hasDerivAt_canonicalLowpassFiniteTensorMultiplier_circle
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (theta : Real) (xi : Euclidean 2) :
    HasDerivAt
      (fun r => canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a
        (circleDirection r) xi)
      (canonicalLowpassFiniteTensorAngularDerivativeFamily C rho hrho s q hqcompact a
        theta xi) theta := by
  have hraw := hasDerivAt_scratch_finiteTensorTubeMultiplier_apply_circle
    s q hqcompact a theta xi
  have hconst := hraw.const_mul
    (intDyadicLowpassMultiplier C.cutoff 0 xi *
      scratch_canonicalBandlimitedTubeMultiplier rho hrho xi)
  have hfun :
      (fun r => canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a
        (circleDirection r) xi) =
      (fun r => intDyadicLowpassMultiplier C.cutoff 0 xi *
        scratch_canonicalBandlimitedTubeMultiplier rho hrho xi *
        scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection r) xi) := by
    funext r
    rw [canonicalLowpassFiniteTensorMultiplier_apply]
    ring
  rw [hfun]
  have hdm : canonicalLowpassFiniteTensorAngularDerivativeFamily
      C rho hrho s q hqcompact a theta xi =
      intDyadicLowpassMultiplier C.cutoff 0 xi *
        scratch_canonicalBandlimitedTubeMultiplier rho hrho xi *
        finiteTensorTubeMultiplierAngularDeriv s q a theta xi := by
    rw [canonicalLowpassFiniteTensorAngularDerivativeFamily_apply]
    unfold lowpassFiniteTensorAngularDerivativeRaw
    ring
  rw [hdm]
  exact hconst

/-- The actual canonical lowpass derivative family has a jointly continuous
inverse Fourier field, obtained from its global Schwartz majorant. -/
theorem continuous_uncurry_fourierInv_canonicalLowpassFiniteTensorAngularDerivativeFamily
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex) :
    Continuous (Function.uncurry (fourierInvParametricField
      (canonicalLowpassFiniteTensorAngularDerivativeFamily
        C rho hrho s q hqcompact a))) := by
  let dm : Real → Euclidean 2 → Complex := fun theta xi =>
    canonicalLowpassFiniteTensorAngularDerivativeFamily C rho hrho s q hqcompact a theta xi
  have hdm : Continuous (Function.uncurry dm) := by
    change Continuous (fun p : Real × Euclidean 2 =>
      canonicalLowpassFiniteTensorAngularDerivativeFamily C rho hrho s q hqcompact a p.1 p.2)
    exact continuous_uncurry_canonicalLowpassFiniteTensorAngularDerivativeFamily
      C rho hrho s q hqcompact a
  change Continuous (Function.uncurry (fun theta y =>
    FourierTransform.fourierInv (dm theta) y))
  apply continuous_uncurry_fourierInv_of_dominated dm
    (bound := fun xi => canonicalTubeMultiplierUniformBound *
      finiteTensorTubeMultiplierAngularDerivBound s q a xi)
  · intro xi
    have hphase : Continuous (fun p : Real × Euclidean 2 =>
        (Real.fourierChar (inner Real xi p.2) : Complex)) := by fun_prop
    have hdmxi : Continuous (fun p : Real × Euclidean 2 => dm p.1 xi) :=
      hdm.comp (show Continuous (fun p : Real × Euclidean 2 => (p.1, xi)) by
        fun_prop)
    exact hphase.smul hdmxi
  · intro p
    have hphase : Continuous (fun xi : Euclidean 2 =>
        (Real.fourierChar (inner Real xi p.2) : Complex)) := by fun_prop
    have hdmxi : Continuous (fun xi : Euclidean 2 => dm p.1 xi) :=
      hdm.comp (show Continuous (fun xi : Euclidean 2 => (p.1, xi)) by
        fun_prop)
    exact (hphase.smul hdmxi).aestronglyMeasurable
  · intro p xi
    rw [norm_smul, norm_real_fourierChar_eq_one, one_mul]
    exact norm_canonicalLowpassFiniteTensorAngularDerivativeFamily_le_majorant
      C rho hrho s q hqcompact a p.1 xi
  · exact integrable_canonicalLowpassFiniteTensorAngularDerivative_majorant
      C rho hrho s q a

/-- The canonical lowpass field itself is the dominated inverse Fourier
family above, hence is jointly continuous in angle and physical position. -/
theorem continuous_uncurry_kakeyaRadialLowpassParametricField_canonicalFiniteTensor
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex) :
    Continuous (Function.uncurry
      (kakeyaRadialLowpassParametricField C
        (canonicalFiniteTensorCircleMultiplierFamily rho hrho s q hqcompact a))) := by
  change Continuous (fun p : Real × Euclidean 2 =>
    kakeyaRadialLowpassParametricField C
      (canonicalFiniteTensorCircleMultiplierFamily rho hrho s q hqcompact a)
      p.1 p.2)
  rw [show (fun p : Real × Euclidean 2 =>
      kakeyaRadialLowpassParametricField C
        (canonicalFiniteTensorCircleMultiplierFamily rho hrho s q hqcompact a)
        p.1 p.2) =
      fun p => FourierTransform.fourierInv
        (canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a
          (circleDirection p.1) : Euclidean 2 → Complex) p.2 by
    funext p
    unfold kakeyaRadialLowpassParametricField
    rw [kakeyaRadialLowpassParametricMultiplier_canonicalFiniteTensor_eq]]
  exact continuous_uncurry_fourierInv_canonicalLowpassFiniteTensorMultiplier_circle
    C rho hrho s q hqcompact a

/-- Differentiation in the circle angle commutes with the literal inverse
Fourier integral for the concrete canonical lowpass finite tensor. -/
theorem hasDerivAt_kakeyaRadialLowpassParametricField_canonicalFiniteTensor
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (theta : Real) (y : Euclidean 2) :
    HasDerivAt
      (fun r => kakeyaRadialLowpassParametricField C
        (canonicalFiniteTensorCircleMultiplierFamily rho hrho s q hqcompact a) r y)
      (fourierInvParametricField
        (canonicalLowpassFiniteTensorAngularDerivativeFamily
          C rho hrho s q hqcompact a) theta y) theta := by
  let m : Real → Euclidean 2 → Complex := fun theta xi =>
    canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a
      (circleDirection theta) xi
  let dm : Real → Euclidean 2 → Complex := fun theta xi =>
    canonicalLowpassFiniteTensorAngularDerivativeFamily C rho hrho s q hqcompact a theta xi
  have hm : Continuous (Function.uncurry m) := by
    change Continuous (fun p : Real × Euclidean 2 =>
      canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a
        (circleDirection p.1) p.2)
    exact continuous_uncurry_canonicalLowpassFiniteTensorMultiplier_circle
      C rho hrho s q hqcompact a
  have hdm : Continuous (Function.uncurry dm) := by
    change Continuous (fun p : Real × Euclidean 2 =>
      canonicalLowpassFiniteTensorAngularDerivativeFamily C rho hrho s q hqcompact a p.1 p.2)
    exact continuous_uncurry_canonicalLowpassFiniteTensorAngularDerivativeFamily
      C rho hrho s q hqcompact a
  have hleft :
      (fun r => kakeyaRadialLowpassParametricField C
        (canonicalFiniteTensorCircleMultiplierFamily rho hrho s q hqcompact a) r y) =
      (fun r => FourierTransform.fourierInv (m r) y) := by
    funext r
