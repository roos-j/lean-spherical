/-- The literal raw lowpass multiplier has endpoint energy at most the
ordinary compact-time finite-tensor energy. -/
theorem integral_norm_sq_rawPostProfLowpassMultFamily_le_two_mul_frequencyTimeEnergy
    {iota : Type*} (C : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    {rTime : Real} (hrTime : rTime < 1)
    (ha : ∀ l, Function.support (a l : Real -> Complex) ⊆
      closedBall (3 / 2 : Real) rTime)
    (hfreq : Integrable (fun p : Euclidean 2 × Real =>
      ‖scratch_finiteTensorTimeData s q a p.1 p.2‖ ^ 2) (volume.prod volume))
    (theta : Real) :
    (∫ xi : Euclidean 2,
      ‖rawPostProfileLowpassMultiplierFamily C s q hqcompact a theta xi‖ ^ 2) ≤
      2 * finiteTensorFrequencyTimeEnergy s q a := by
  let m : SchwartzMap (Euclidean 2) Complex :=
    rawPostProfileLowpassMultiplierFamily C s q hqcompact a theta
  let m0 : SchwartzMap (Euclidean 2) Complex :=
    scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection theta)
  have hm : Integrable (fun xi : Euclidean 2 => ‖m xi‖ ^ 2) volume :=
    (memLp_two_iff_integrable_sq_norm m.continuous.aestronglyMeasurable).mp
      (m.memLp 2 volume)
  have hm0 : Integrable (fun xi : Euclidean 2 => ‖m0 xi‖ ^ 2) volume :=
    (memLp_two_iff_integrable_sq_norm m0.continuous.aestronglyMeasurable).mp
      (m0.memLp 2 volume)
  have hpoint (xi : Euclidean 2) : ‖m xi‖ ^ 2 ≤ ‖m0 xi‖ ^ 2 := by
    rw [show m xi = intDyadicLowpassMultiplier C.cutoff 0 xi * m0 xi by
      dsimp [m, m0]
      exact rawPostProfileLowpassMultiplierFamily_apply C s q hqcompact a theta xi,
      norm_mul, mul_pow]
    have hcut := norm_intDyadicLowpassMultiplier_zero_le_one C xi
    have hcutsq : ‖intDyadicLowpassMultiplier C.cutoff 0 xi‖ ^ 2 ≤ 1 := by
      simpa using ((sq_le_sq₀ (norm_nonneg _) (by norm_num)).mpr hcut)
    calc
      ‖intDyadicLowpassMultiplier C.cutoff 0 xi‖ ^ 2 * ‖m0 xi‖ ^ 2 ≤
          1 * ‖m0 xi‖ ^ 2 :=
        mul_le_mul_of_nonneg_right hcutsq (sq_nonneg _)
      _ = ‖m0 xi‖ ^ 2 := by ring
  calc
    (∫ xi : Euclidean 2,
      ‖rawPostProfileLowpassMultiplierFamily C s q hqcompact a theta xi‖ ^ 2) =
        ∫ xi : Euclidean 2, ‖m xi‖ ^ 2 := by rfl
    _ ≤ ∫ xi : Euclidean 2, ‖m0 xi‖ ^ 2 := integral_mono hm hm0 hpoint
    _ = ∫ xi : Euclidean 2,
      ‖scratch_finiteTensorTubeMultiplier s q hqcompact a
        (circleDirection theta) xi‖ ^ 2 := by rfl
    _ ≤ 2 * finiteTensorFrequencyTimeEnergy s q a :=
      integral_norm_sq_scratch_finiteTensorTubeMultiplier_le_two_mul_frequencyTimeEnergy
        s q hqcompact a hrTime ha hfreq (circleDirection theta)

/-- Raw post-profile `B₀` closure.  It applies the fixed radial lowpass to
an arbitrary compact finite tensor and never inserts a canonical tube
multiplier. -/
theorem meas_and_lintegral_iSup_sq_kakeyaRadialLowpassPhysField_rawPostProf_le_sourceEn
    {iota : Type*} (C : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    {rTime : Real} (hrTime : rTime < 1)
    (ha : ∀ l, Function.support (a l : Real -> Complex) ⊆
      closedBall (3 / 2 : Real) rTime) :
    Measurable (fun x : Euclidean 2 =>
      ⨆ theta : Real, ENNReal.ofReal
        (‖kakeyaRadialLowpassPhysicalField C
          (finiteTensorCircleMultiplierFamily s q hqcompact a) theta x‖ ^ 2)) ∧
      (∫⁻ x : Euclidean 2, ⨆ theta : Real, ENNReal.ofReal
        (‖kakeyaRadialLowpassPhysicalField C
          (finiteTensorCircleMultiplierFamily s q hqcompact a) theta x‖ ^ 2)) ≤
        ENNReal.ofReal ((4 + 1600 * Real.pi ^ 4) *
          ∫ xi : Euclidean 2, shiftedFiberSourceEnergy s q a xi) := by
  let m : Real -> SchwartzMap (Euclidean 2) Complex :=
    finiteTensorCircleMultiplierFamily s q hqcompact a
  let dm : Real -> SchwartzMap (Euclidean 2) Complex :=
    rawPostProfileLowpassAngularDerivativeFamily C s q hqcompact a
  have hfieldEq : kakeyaRadialLowpassParametricField C m =
      kakeyaRadialLowpassPhysicalField C m := by
    funext theta x
    exact kakeyaRadialLowpassParametricField_eq_radialPhysicalField C m theta x
  have hperiodic : ∀ x, Function.Periodic
      (fun theta => kakeyaRadialLowpassPhysicalField C m theta x)
      (2 * Real.pi) := by
    intro x
    change Function.Periodic
      (fun theta => finiteTensorLowpassCircleField C s q hqcompact a theta x)
      (2 * Real.pi)
    exact periodic_finiteTensorLowpassCircleField C s q hqcompact a x
  have hFcontParam : Continuous (Function.uncurry
      (kakeyaRadialLowpassParametricField C m)) := by
    change Continuous (Function.uncurry (fun theta y =>
      FourierTransform.fourierInv
        (rawPostProfileLowpassMultiplierFamily C s q hqcompact a theta :
          Euclidean 2 -> Complex) y))
    exact continuous_uncurry_fourierInv_rawPostProfileLowpassMultiplierFamily
      C s q hqcompact a
  have hFcont : Continuous (Function.uncurry
      (kakeyaRadialLowpassPhysicalField C m)) := by
    rw [← hfieldEq]
    exact hFcontParam
  have hDcont : Continuous (Function.uncurry (fourierInvParametricField dm)) := by
    change Continuous (Function.uncurry (fourierInvParametricField
      (rawPostProfileLowpassAngularDerivativeFamily C s q hqcompact a)))
    exact continuous_uncurry_fourierInv_rawPostProfileLowpassAngularDerivativeFamily
      C s q hqcompact a
  have hderiv : ∀ theta x, HasDerivAt
      (fun r => kakeyaRadialLowpassPhysicalField C m r x)
      (fourierInvParametricField dm theta x) theta := by
    intro theta x
    rw [← hfieldEq]
    change HasDerivAt
      (fun r => kakeyaRadialLowpassParametricField C
        (finiteTensorCircleMultiplierFamily s q hqcompact a) r x)
      (fourierInvParametricField
        (rawPostProfileLowpassAngularDerivativeFamily C s q hqcompact a) theta x) theta
    exact hasDerivAt_kakeyaRadialLowpassParametricField_rawPostProfile
      C s q hqcompact a theta x
  have htrace : HasFiniteCoreLowpassAngularTraceEnergy C s q a
      (400 * Real.pi ^ 3 * finiteTensorFrequencyTimeEnergy s q a) :=
    hasFiniteCoreLowpassAngularTraceEnergyBound C s q hqcompact a hrTime ha
  have hDfrequency : Integrable (fun p : Real × Euclidean 2 =>
      ‖dm p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume) := by
    simpa only [dm, rawPostProfileLowpassAngularDerivativeFamily_apply] using htrace.1
  have hDphysical : Integrable (fun p : Real × Euclidean 2 =>
      ‖fourierInvParametricField dm p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume) :=
    integrable_sq_fourierInvParametricField_of_continuous_frequency dm
      (-Real.pi) Real.pi hDcont hDfrequency
  have hfreq : Integrable (fun p : Euclidean 2 × Real =>
      ‖scratch_finiteTensorTimeData s q a p.1 p.2‖ ^ 2) (volume.prod volume) :=
    integrable_sq_scratch_finiteTensorTimeData_product s q a
  have hE0 : (∫ xi : Euclidean 2,
      ‖kakeyaRadialLowpassParametricMultiplier C m (-Real.pi) xi‖ ^ 2) ≤
      2 * finiteTensorFrequencyTimeEnergy s q a := by
    change (∫ xi : Euclidean 2,
      ‖rawPostProfileLowpassMultiplierFamily C s q hqcompact a (-Real.pi) xi‖ ^ 2) ≤ _
    exact integral_norm_sq_rawPostProfLowpassMultFamily_le_two_mul_frequencyTimeEnergy
      C s q hqcompact a hrTime ha hfreq (-Real.pi)
  have hE1 : (∫ p : Real × Euclidean 2, ‖dm p.1 p.2‖ ^ 2 ∂
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume)) ≤
      400 * Real.pi ^ 3 * finiteTensorFrequencyTimeEnergy s q a := by
    simpa only [dm, rawPostProfileLowpassAngularDerivativeFamily_apply] using htrace.2
  have hmain :=
    measurable_and_lintegral_iSup_sq_kakeyaRadialLowpassPhysicalField_le_globalH1
      C m dm hperiodic hFcont hDcont hderiv hDphysical hDfrequency hE0 hE1
  have henergy : (∫ xi : Euclidean 2, shiftedFiberSourceEnergy s q a xi) =
      finiteTensorFrequencyTimeEnergy s q a :=
    integral_shiftedFiberSourceEnergy_eq_frequencyTimeEnergy s q a
  have hconst :
      2 * (2 * finiteTensorFrequencyTimeEnergy s q a) +
        4 * Real.pi *
          (400 * Real.pi ^ 3 * finiteTensorFrequencyTimeEnergy s q a) =
        (4 + 1600 * Real.pi ^ 4) *
          ∫ xi : Euclidean 2, shiftedFiberSourceEnergy s q a xi := by
    rw [henergy]
    ring
  simpa only [m, hconst] using hmain

