theorem terminalPositiveFrozenCutoffProfile_eq_actual
    (n : Nat) (c u : Real) :
    terminalPositiveFrozenCutoffProfile n (c, u) =
      shiftedCappedTerminalPositiveCutoffDerivativeProfile n c
