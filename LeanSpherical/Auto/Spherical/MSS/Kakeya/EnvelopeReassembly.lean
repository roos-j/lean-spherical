    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (xi : Euclidean 2) (t : Real) :
    scratch_finiteTensorTimeData s (chartProfiles C j q) a xi t =
      C.sector j xi * scratch_finiteTensorTimeData s q a xi t := by
  unfold scratch_finiteTensorTimeData
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro l hl
  change chartProfile C j (q l) xi * a l t =
    C.sector j xi * (q l xi * a l t)
  rw [chartProfile_apply C]
  ring

/-- The source-time square energy of a charted tensor is exactly the square
of that chart's frequency multiplier times the uncharted source energy. -/
theorem shiftedFiberSourceEnergy_chartProfiles_eq
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (xi : Euclidean 2) :
    shiftedFiberSourceEnergy s (chartProfiles C j q) a xi =
      ‖C.sector j xi‖ ^ (2 : Nat) * shiftedFiberSourceEnergy s q a xi := by
  unfold shiftedFiberSourceEnergy
  have hpoint : (fun t : Real =>
      ‖scratch_finiteTensorTimeData s (chartProfiles C j q) a xi t‖ ^ (2 : Nat)) =
      fun t : Real => ‖C.sector j xi‖ ^ (2 : Nat) •
        ‖scratch_finiteTensorTimeData s q a xi t‖ ^ (2 : Nat) := by
    funext t
    rw [scratch_finiteTensorTimeData_chartProfiles_eq]
    rw [norm_mul, mul_pow]
    simp only [smul_eq_mul]
  rw [hpoint, MeasureTheory.integral_smul]
  simp only [smul_eq_mul]

/-- The transported four-chart family keeps the unit-scale square overlap
constant pointwise at every frequency. -/
theorem sum_norm_sq_scaledDyadicFourChartFamily_sector_le_four
    {lambda : Real} (hlambda : 0 < lambda) (xi : Euclidean 2) :
    ∑ j : Fin 4,
      ‖(scaledDyadicFourChartFamily lambda hlambda).sector j xi‖ ^ (2 : Nat) ≤ 4 := by
  calc
    ∑ j : Fin 4,
        ‖(scaledDyadicFourChartFamily lambda hlambda).sector j xi‖ ^ (2 : Nat) =
        ∑ j : Fin 4,
          ‖chartAnnularMultiplierSchwartz j (lambda⁻¹ • xi)‖ ^ (2 : Nat) := by
            apply Finset.sum_congr rfl
            intro j hj
            rw [scaledDyadicFourChartFamily_sector_apply]
    _ ≤ 4 := sum_norm_sq_chartAnnularMultiplierSchwartz_le_four (lambda⁻¹ • xi)

/-- Exact chartwise source-energy reassembly before applying the four-chart
overlap constant. -/
theorem sum_shiftedFiberSourceEnergy_scaledDyadicFourChartFamily_eq
    {iota : Type*} {lambda : Real} (hlambda : 0 < lambda)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (xi : Euclidean 2) :
    ∑ j : Fin 4,
      shiftedFiberSourceEnergy s
        (chartProfiles (scaledDyadicFourChartFamily lambda hlambda) j q) a xi =
      (∑ j : Fin 4,
        ‖(scaledDyadicFourChartFamily lambda hlambda).sector j xi‖ ^ (2 : Nat)) *
          shiftedFiberSourceEnergy s q a xi := by
  calc
    ∑ j : Fin 4,
        shiftedFiberSourceEnergy s
          (chartProfiles (scaledDyadicFourChartFamily lambda hlambda) j q) a xi =
        ∑ j : Fin 4,
          ‖(scaledDyadicFourChartFamily lambda hlambda).sector j xi‖ ^ (2 : Nat) *
            shiftedFiberSourceEnergy s q a xi := by
              apply Finset.sum_congr rfl
              intro j hj
              exact shiftedFiberSourceEnergy_chartProfiles_eq
                (scaledDyadicFourChartFamily lambda hlambda) j s q a xi
    _ = _ := (Finset.sum_mul _ _ _).symm

/-- Four smooth scaled sectors increase the literal source-time fibre energy
by at most the geometric overlap factor four. -/
theorem sum_shiftedFiberSourceEnergy_scaledDyadicFourChartFamily_le_four
    {iota : Type*} {lambda : Real} (hlambda : 0 < lambda)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (xi : Euclidean 2) :
    ∑ j : Fin 4,
      shiftedFiberSourceEnergy s
        (chartProfiles (scaledDyadicFourChartFamily lambda hlambda) j q) a xi ≤
      4 * shiftedFiberSourceEnergy s q a xi := by
  rw [sum_shiftedFiberSourceEnergy_scaledDyadicFourChartFamily_eq]
  exact mul_le_mul_of_nonneg_right
    (sum_norm_sq_scaledDyadicFourChartFamily_sector_le_four hlambda xi)
    (shiftedFiberSourceEnergy_nonneg s q a xi)

/-- The uncharted literal source energy is integrable in the spatial
frequency variable; this is the Fubini interface used by chart overlap. -/
theorem integrable_shiftedFiberSourceEnergy
    {iota : Type*} (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) :
    Integrable (shiftedFiberSourceEnergy s q a) volume := by
  have hprod : Integrable (fun p : Euclidean 2 × Real =>
      ‖scratch_finiteTensorTimeData s q a p.1 p.2‖ ^ (2 : Nat))
      (volume.prod volume) :=
    integrable_sq_scratch_finiteTensorTimeData_product s q a
  change Integrable (fun xi : Euclidean 2 =>
    ∫ t : Real, ‖scratch_finiteTensorTimeData s q a xi t‖ ^ (2 : Nat)) volume
  exact hprod.integral_prod_left

/-- After restriction to any frequency region (in particular the active
scaled annulus), the full four-chart source budget is at most four times the
unrestricted chart-free source budget. -/
theorem integral_sum_shiftedFiberSourceEnergy_scaledDyadicFourChartFamily_le_four
    {iota : Type*} {lambda : Real} (hlambda : 0 < lambda)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (A : Set (Euclidean 2)) :
    (∫ xi : Euclidean 2, ∑ j : Fin 4,
      shiftedFiberSourceEnergy s
        (chartProfiles (scaledDyadicFourChartFamily lambda hlambda) j q) a xi ∂
          (volume.restrict A)) ≤
      4 * ∫ xi : Euclidean 2, shiftedFiberSourceEnergy s q a xi ∂
        (volume.restrict A) := by
  let C := scaledDyadicFourChartFamily lambda hlambda
  have hbase : Integrable (shiftedFiberSourceEnergy s q a) (volume.restrict A) :=
    (integrable_shiftedFiberSourceEnergy s q a).restrict
  have hchart : ∀ j : Fin 4,
      Integrable (shiftedFiberSourceEnergy s (chartProfiles C j q) a)
        (volume.restrict A) := by
    intro j
    exact (integrable_shiftedFiberSourceEnergy s (chartProfiles C j q) a).restrict
  have hsum : Integrable (fun xi : Euclidean 2 => ∑ j : Fin 4,
      shiftedFiberSourceEnergy s (chartProfiles C j q) a xi) (volume.restrict A) := by
    exact MeasureTheory.integrable_finsetSum Finset.univ (fun j _ => hchart j)
  have hscalar : (fun xi : Euclidean 2 =>
      4 * shiftedFiberSourceEnergy s q a xi) =
      (4 : Real) • shiftedFiberSourceEnergy s q a := by
    rfl
  have hright : Integrable (fun xi : Euclidean 2 =>
      4 * shiftedFiberSourceEnergy s q a xi) (volume.restrict A) := by
    rw [hscalar]
    exact MeasureTheory.Integrable.smul (4 : Real) hbase
  have hmono : (∫ xi : Euclidean 2, ∑ j : Fin 4,
      shiftedFiberSourceEnergy s (chartProfiles C j q) a xi ∂(volume.restrict A)) ≤
      ∫ xi : Euclidean 2, 4 * shiftedFiberSourceEnergy s q a xi ∂(volume.restrict A) :=
    MeasureTheory.integral_mono hsum hright (fun xi =>
      sum_shiftedFiberSourceEnergy_scaledDyadicFourChartFamily_le_four
        hlambda s q a xi)
  calc
    (∫ xi : Euclidean 2, ∑ j : Fin 4,
        shiftedFiberSourceEnergy s
          (chartProfiles (scaledDyadicFourChartFamily lambda hlambda) j q) a xi ∂
            (volume.restrict A)) =
        ∫ xi : Euclidean 2, ∑ j : Fin 4,
          shiftedFiberSourceEnergy s (chartProfiles C j q) a xi ∂(volume.restrict A) := by rfl
    _ ≤ ∫ xi : Euclidean 2, 4 * shiftedFiberSourceEnergy s q a xi ∂
        (volume.restrict A) := hmono
    _ = 4 * ∫ xi : Euclidean 2, shiftedFiberSourceEnergy s q a xi ∂
        (volume.restrict A) := by
      rw [hscalar]
      exact MeasureTheory.integral_smul (4 : Real) (shiftedFiberSourceEnergy s q a)

/-- Each scaled sector is a contraction on the source-time fibre energy;
this is the coefficientwise form used when shell constants are not uniform
across charts. -/
theorem norm_scaledDyadicFourChartFamily_sector_le_one
    {lambda : Real} (hlambda : 0 < lambda) (j : Fin 4) (xi : Euclidean 2) :
    ‖(scaledDyadicFourChartFamily lambda hlambda).sector j xi‖ ≤ 1 := by
  rw [scaledDyadicFourChartFamily_sector_apply]
  exact norm_chartAnnularMultiplierSchwartz_le_one j (lambda⁻¹ • xi)

theorem shiftedFiberSourceEnergy_scaledDyadicFourChartFamily_chart_le
    {iota : Type*} {lambda : Real} (hlambda : 0 < lambda) (j : Fin 4)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (xi : Euclidean 2) :
    shiftedFiberSourceEnergy s
        (chartProfiles (scaledDyadicFourChartFamily lambda hlambda) j q) a xi ≤
      shiftedFiberSourceEnergy s q a xi := by
  rw [shiftedFiberSourceEnergy_chartProfiles_eq]
  have hnorm := norm_scaledDyadicFourChartFamily_sector_le_one hlambda j xi
  have hsq : ‖(scaledDyadicFourChartFamily lambda hlambda).sector j xi‖ ^ (2 : Nat) ≤ 1 := by
    nlinarith [norm_nonneg ((scaledDyadicFourChartFamily lambda hlambda).sector j xi)]
  calc
    ‖(scaledDyadicFourChartFamily lambda hlambda).sector j xi‖ ^ (2 : Nat) *
        shiftedFiberSourceEnergy s q a xi ≤
        1 * shiftedFiberSourceEnergy s q a xi :=
          mul_le_mul_of_nonneg_right hsq (shiftedFiberSourceEnergy_nonneg s q a xi)
    _ = shiftedFiberSourceEnergy s q a xi := one_mul _

theorem integral_shiftedFiberSourceEnergy_scaledDyadicFourChartFamily_chart_le
    {iota : Type*} {lambda : Real} (hlambda : 0 < lambda) (j : Fin 4)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (A : Set (Euclidean 2)) :
    (∫ xi : Euclidean 2,
      shiftedFiberSourceEnergy s
        (chartProfiles (scaledDyadicFourChartFamily lambda hlambda) j q) a xi ∂
          (volume.restrict A)) ≤
      ∫ xi : Euclidean 2, shiftedFiberSourceEnergy s q a xi ∂
        (volume.restrict A) := by
  apply MeasureTheory.integral_mono
  · exact (integrable_shiftedFiberSourceEnergy s
      (chartProfiles (scaledDyadicFourChartFamily lambda hlambda) j q) a).restrict
  · exact (integrable_shiftedFiberSourceEnergy s q a).restrict
  · intro xi
    exact shiftedFiberSourceEnergy_scaledDyadicFourChartFamily_chart_le
      hlambda j s q a xi

theorem ENNReal_ofReal_integral_shiftedFiberSourceEnergy_scDyFourChartFamily_chart_le
    {iota : Type*} {lambda : Real} (hlambda : 0 < lambda) (j : Fin 4)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (A : Set (Euclidean 2)) :
    ENNReal.ofReal (∫ xi : Euclidean 2,
      shiftedFiberSourceEnergy s
        (chartProfiles (scaledDyadicFourChartFamily lambda hlambda) j q) a xi ∂
          (volume.restrict A)) ≤
      ENNReal.ofReal (∫ xi : Euclidean 2,
        shiftedFiberSourceEnergy s q a xi ∂(volume.restrict A)) := by
  exact ENNReal.ofReal_le_ofReal
    (integral_shiftedFiberSourceEnergy_scaledDyadicFourChartFamily_chart_le
      hlambda j s q a A)

/-- A finite weighted chart budget is controlled by the uncharted source
energy.  The displayed factor `4` is deliberately retained as the standard
four-chart overlap loss, even though coefficientwise sector contraction
gives a slightly sharper intermediate inequality. -/
theorem sum_weighted_ENNReal_ofReal_chartSourceEnergy_le_four
    {iota beta : Type*} {lambda : Real} (hlambda : 0 < lambda)
    (J : Finset (Fin 4 × beta)) (w : Fin 4 × beta -> ENNReal)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (A : Set (Euclidean 2)) :
    (∑ jni ∈ J, w jni * ENNReal.ofReal (∫ xi : Euclidean 2,
      shiftedFiberSourceEnergy s
        (chartProfiles (scaledDyadicFourChartFamily lambda hlambda) jni.1 q) a xi ∂
          (volume.restrict A))) ≤
      (∑ jni ∈ J, w jni) *
        (4 * ENNReal.ofReal (∫ xi : Euclidean 2,
          shiftedFiberSourceEnergy s q a xi ∂(volume.restrict A))) := by
  let E : ENNReal := ENNReal.ofReal (∫ xi : Euclidean 2,
    shiftedFiberSourceEnergy s q a xi ∂(volume.restrict A))
  have hterm : ∀ jni ∈ J, w jni * ENNReal.ofReal (∫ xi : Euclidean 2,
      shiftedFiberSourceEnergy s
        (chartProfiles (scaledDyadicFourChartFamily lambda hlambda) jni.1 q) a xi ∂
          (volume.restrict A)) ≤ w jni * E := by
    intro jni hjni
    exact mul_le_mul_of_nonneg_left
      (ENNReal_ofReal_integral_shiftedFiberSourceEnergy_scDyFourChartFamily_chart_le
        hlambda jni.1 s q a A) (by positivity)
  calc
    (∑ jni ∈ J, w jni * ENNReal.ofReal (∫ xi : Euclidean 2,
        shiftedFiberSourceEnergy s
          (chartProfiles (scaledDyadicFourChartFamily lambda hlambda) jni.1 q) a xi ∂
            (volume.restrict A))) ≤
        ∑ jni ∈ J, w jni * E := by
          exact Finset.sum_le_sum fun jni hjni => hterm jni hjni
    _ = (∑ jni ∈ J, w jni) * E := by
      rw [Finset.sum_mul]
    _ ≤ (∑ jni ∈ J, w jni) * (4 * E) := by
      exact mul_le_mul_of_nonneg_left
        (calc
          E = 1 * E := (one_mul E).symm
          _ ≤ 4 * E := mul_le_mul_of_nonneg_right (by norm_num) (by positivity))
        (by positivity)

/-- The exact weighted aggregation shape of the shifted capped annular
atlas.  Choosing `w jni = ofReal (4 * cost jni)` consumes the local hpiece
constants returned by `exists_shiftedCapped_annular_max_bound`. -/
theorem sum_weighted_shiftedCappedShellIndices_ENNReal_ofReal_chartSourceEnergy_le_four
    {iota : Type*} {lambda : Real} (hlambda : 0 < lambda) (K : Nat)
    (cost : Fin 4 × (Nat × Nat) -> Real)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) :
    (∑ jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K,
      ENNReal.ofReal (4 * cost jni) * ENNReal.ofReal (∫ xi : Euclidean 2,
        shiftedFiberSourceEnergy s
          (chartProfiles (scaledDyadicFourChartFamily lambda hlambda) jni.1 q) a xi ∂
            (volume.restrict (scaledDyadicFrequencyAnnulus lambda)))) ≤
      (∑ jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K,
        ENNReal.ofReal (4 * cost jni)) *
        (4 * ENNReal.ofReal (∫ xi : Euclidean 2,
          shiftedFiberSourceEnergy s q a xi ∂
            (volume.restrict (scaledDyadicFrequencyAnnulus lambda))) ) := by
  exact sum_weighted_ENNReal_ofReal_chartSourceEnergy_le_four hlambda
    (shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K)
    (fun jni => ENNReal.ofReal (4 * cost jni)) s q a
    (scaledDyadicFrequencyAnnulus lambda)

/-- Directly matches the un-factored `ofReal (4 * cost * sourceEnergy)`
output of the concrete hpiece theorem. -/
theorem sum_ENNReal_ofReal_shiftedCappedShell_hpieceCosts_le_four
    {iota : Type*} {lambda : Real} (hlambda : 0 < lambda) (K : Nat)
    (cost : Fin 4 × (Nat × Nat) -> Real)
    (hcost : ∀ jni ∈
      shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K,
        0 ≤ cost jni)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) :
    (∑ jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K,
      ENNReal.ofReal (4 * cost jni * ∫ xi : Euclidean 2,
        shiftedFiberSourceEnergy s
          (chartProfiles (scaledDyadicFourChartFamily lambda hlambda) jni.1 q) a xi ∂
            (volume.restrict (scaledDyadicFrequencyAnnulus lambda)))) ≤
      (∑ jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K,
        ENNReal.ofReal (4 * cost jni)) *
        (4 * ENNReal.ofReal (∫ xi : Euclidean 2,
          shiftedFiberSourceEnergy s q a xi ∂
            (volume.restrict (scaledDyadicFrequencyAnnulus lambda))) ) := by
  calc
    (∑ jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K,
        ENNReal.ofReal (4 * cost jni * ∫ xi : Euclidean 2,
          shiftedFiberSourceEnergy s
            (chartProfiles (scaledDyadicFourChartFamily lambda hlambda) jni.1 q) a xi ∂
              (volume.restrict (scaledDyadicFrequencyAnnulus lambda)))) =
        ∑ jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K,
          ENNReal.ofReal (4 * cost jni) * ENNReal.ofReal (∫ xi : Euclidean 2,
            shiftedFiberSourceEnergy s
              (chartProfiles (scaledDyadicFourChartFamily lambda hlambda) jni.1 q) a xi ∂
                (volume.restrict (scaledDyadicFrequencyAnnulus lambda))) := by
          apply Finset.sum_congr rfl
          intro jni hjni
          rw [ENNReal.ofReal_mul]
          nlinarith [hcost jni hjni]
    _ ≤ _ := sum_weighted_shiftedCappedShellIndices_ENNReal_ofReal_chartSourceEnergy_le_four
      hlambda K cost s q a

end

