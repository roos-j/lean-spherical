/-- The fixed three low radial bands have a uniform raw angular trace bound.
The only band-dependent input is the source-time energy of the radialized
profiles; the support radius is at most `16` for all `i < 3`. -/
private theorem integral_norm_sq_finiteTensorRadialBandAngularDeriv_le_low_source
    {iota : Type*} (L : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex) {i : Nat} (hi : i < 3)
    {rTime : Real} (hrTime : rTime < 1)
    (ha : ∀ l, Function.support (a l : Real -> Complex) ⊆
      closedBall (3 / 2 : Real) rTime) :
    Integrable (fun p : Real × Euclidean 2 =>
      ‖finiteTensorTubeMultiplierAngularDeriv s
        (finiteTensorRadialBandProfiles L q i) a p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume) ∧
      (∫ p : Real × Euclidean 2,
        ‖finiteTensorTubeMultiplierAngularDeriv s
          (finiteTensorRadialBandProfiles L q i) a p.1 p.2‖ ^ 2 ∂
          ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume)) ≤
        25600 * Real.pi ^ 3 *
          ∫ xi : Euclidean 2,
            shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles L q i) a xi := by
  let μ : Measure Real := volume.restrict (Icc (-Real.pi) Real.pi)
  let qBand := finiteTensorRadialBandProfiles L q i
  let E : Euclidean 2 -> Real := fun xi =>
    shiftedFiberSourceEnergy s qBand a xi
  let G : Real × Euclidean 2 -> Real := fun p =>
    12800 * Real.pi ^ 2 * E p.2
  have hfreq : Integrable (fun p : Euclidean 2 × Real =>
      ‖scratch_finiteTensorTimeData s qBand a p.1 p.2‖ ^ 2)
      (volume.prod volume) :=
    integrable_sq_scratch_finiteTensorTimeData_product s qBand a
  have hE : Integrable E volume := by
    dsimp [E, shiftedFiberSourceEnergy]
    exact hfreq.integral_prod_left
  letI : IsFiniteMeasure μ := by
    dsimp [μ]
    infer_instance
  have hone : Integrable (fun _ : Real => (1 : Real)) μ := integrable_const _
  have hG : Integrable G (μ.prod volume) := by
    have hbase := hone.mul_prod hE
    exact (hbase.const_mul (12800 * Real.pi ^ 2)).congr
      (Filter.Eventually.of_forall fun p => by simp [G, E])
  have hDcont : Continuous (fun p : Real × Euclidean 2 =>
      finiteTensorTubeMultiplierAngularDeriv s qBand a p.1 p.2) := by
    exact continuous_uncurry_finiteTensorTubeMultiplierAngularDeriv s qBand a
  have hqBandCompact : ∀ l, HasCompactSupport
      (qBand l : Euclidean 2 -> Complex) :=
    finiteTensorRadialBandProfiles_compact L q hqcompact i
  have hpoint (p : Real × Euclidean 2) :
      ‖finiteTensorTubeMultiplierAngularDeriv s qBand a p.1 p.2‖ ^ 2 ≤ G p := by
    rcases p with ⟨theta, xi⟩
    have hE_nonneg : 0 ≤ E xi := by
      dsimp [E]
      exact shiftedFiberSourceEnergy_nonneg s qBand a xi
    by_cases hnear : ‖xi‖ ≤ 16
    · have htrace :=
        norm_sq_finiteTensorTubeMultiplierAngularDeriv_le_compactTimeEnergy
          s qBand hqBandCompact a hrTime ha theta xi
      have hxisq : ‖xi‖ ^ 2 ≤ 256 := by
        nlinarith [norm_nonneg xi]
      dsimp [G]
      calc
        ‖finiteTensorTubeMultiplierAngularDeriv s qBand a theta xi‖ ^ 2 ≤
            (50 * Real.pi ^ 2) * ‖xi‖ ^ 2 * E xi := by
              simpa only [E, shiftedFiberSourceEnergy] using htrace
        _ ≤ (50 * Real.pi ^ 2) * 256 * E xi := by gcongr
        _ = 12800 * Real.pi ^ 2 * E xi := by ring
    · have hfar : 16 < ‖xi‖ := lt_of_not_ge hnear
      have hzero := finiteTensorRadialBandAngularDeriv_eq_zero_of_sixteen_lt_norm
        L s q a hi theta xi hfar
      calc
        ‖finiteTensorTubeMultiplierAngularDeriv s qBand a theta xi‖ ^ 2 = 0 := by
          rw [hzero]
          norm_num
        _ ≤ G (theta, xi) := by
          dsimp [G]
          exact mul_nonneg (by positivity) hE_nonneg
  have hDsq : Integrable (fun p : Real × Euclidean 2 =>
      ‖finiteTensorTubeMultiplierAngularDeriv s qBand a p.1 p.2‖ ^ 2)
      (μ.prod volume) := by
    refine hG.mono' (hDcont.norm.pow 2 |>.aestronglyMeasurable) ?_
    filter_upwards with p
    simpa only [Real.norm_of_nonneg (sq_nonneg _)] using hpoint p
  have henergyEq : (∫ xi : Euclidean 2, E xi) =
      finiteTensorFrequencyTimeEnergy s qBand a := by
    dsimp [E, shiftedFiberSourceEnergy, finiteTensorFrequencyTimeEnergy]
    exact (integral_prod _ hfreq).symm
  have hpi : -Real.pi ≤ Real.pi := by linarith [Real.pi_pos]
  have hGintegral : (∫ p : Real × Euclidean 2, G p ∂(μ.prod volume)) =
      25600 * Real.pi ^ 3 * finiteTensorFrequencyTimeEnergy s qBand a := by
    calc
      (∫ p : Real × Euclidean 2, G p ∂(μ.prod volume)) =
          ∫ theta in -Real.pi..Real.pi, ∫ xi : Euclidean 2, G (theta, xi) := by
            exact (intervalIntegral_integral_eq_integral_productShell
              hpi (fun theta xi => G (theta, xi))
              (by simpa only [μ] using hG)).symm
      _ = ∫ theta in -Real.pi..Real.pi,
          (12800 * Real.pi ^ 2) * ∫ xi : Euclidean 2, E xi := by
            apply intervalIntegral.integral_congr_ae
            filter_upwards with theta
            rw [integral_const_mul]
            simp
      _ = (Real.pi - -Real.pi) *
          ((12800 * Real.pi ^ 2) * ∫ xi : Euclidean 2, E xi) := by
            rw [intervalIntegral.integral_const]
            simp only [smul_eq_mul]
      _ = 25600 * Real.pi ^ 3 * finiteTensorFrequencyTimeEnergy s qBand a := by
            rw [henergyEq]
            ring
  constructor
  · simpa only [qBand, μ] using hDsq
  · calc
      (∫ p : Real × Euclidean 2,
        ‖finiteTensorTubeMultiplierAngularDeriv s
          (finiteTensorRadialBandProfiles L q i) a p.1 p.2‖ ^ 2 ∂
          ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume)) =
          ∫ p : Real × Euclidean 2,
            ‖finiteTensorTubeMultiplierAngularDeriv s qBand a p.1 p.2‖ ^ 2 ∂
              (μ.prod volume) := by rfl
      _ ≤ ∫ p : Real × Euclidean 2, G p ∂(μ.prod volume) :=
        integral_mono hDsq hG hpoint
      _ = 25600 * Real.pi ^ 3 * finiteTensorFrequencyTimeEnergy s qBand a := hGintegral
      _ = 25600 * Real.pi ^ 3 *
          ∫ xi : Euclidean 2,
            shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles L q i) a xi := by
            rw [← henergyEq]

/-- Dominated inverse Fourier continuity for the literal raw derivative of a
compact finite tensor. -/
private theorem lowBand_continuous_uncurry_fourierInv_finiteTensorAngularDeriv
    {iota : Type*} (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) :
    Continuous (Function.uncurry (fun theta y =>
      FourierTransform.fourierInv
        (fun xi => finiteTensorTubeMultiplierAngularDeriv s q a theta xi) y)) := by
  let d : Real -> Euclidean 2 -> Complex := fun theta xi =>
    finiteTensorTubeMultiplierAngularDeriv s q a theta xi
  have hd : Continuous (Function.uncurry d) := by
    change Continuous (fun p : Real × Euclidean 2 =>
      finiteTensorTubeMultiplierAngularDeriv s q a p.1 p.2)
    exact continuous_uncurry_finiteTensorTubeMultiplierAngularDeriv s q a
  change Continuous (Function.uncurry (fun theta y =>
    FourierTransform.fourierInv (d theta) y))
  apply continuous_uncurry_fourierInv_of_dominated d
    (bound := finiteTensorTubeMultiplierAngularDerivBound s q a)
  · intro xi
    have hphase : Continuous (fun p : Real × Euclidean 2 =>
        (Real.fourierChar (inner Real xi p.2) : Complex)) := by fun_prop
    have hdxi : Continuous (fun p : Real × Euclidean 2 => d p.1 xi) :=
      hd.comp (show Continuous (fun p : Real × Euclidean 2 => (p.1, xi)) by fun_prop)
    exact hphase.smul hdxi
  · intro p
    have hphase : Continuous (fun xi : Euclidean 2 =>
        (Real.fourierChar (inner Real xi p.2) : Complex)) := by fun_prop
    have hdxi : Continuous (fun xi : Euclidean 2 => d p.1 xi) :=
      hd.comp (show Continuous (fun xi : Euclidean 2 => (p.1, xi)) by fun_prop)
    exact (hphase.smul hdxi).aestronglyMeasurable
  · intro p xi
    rw [norm_smul, lowBand_norm_fourierChar_eq_one, one_mul]
    exact norm_finiteTensorTubeMultiplierAngularDeriv_le_bound s q a p.1 xi
  · exact integrable_finiteTensorTubeMultiplierAngularDerivBound s q a

private theorem finiteTensorFrequencyTimeEnergy_eq_integral_shiftedFiberSourceEnergy
    {iota : Type*} (s : Finset iota)
