/-- Compact-time signed-frequency Schur estimate for a fixed physical shell,
with one constant uniform over the terminal cap ratio. -/
theorem exists_outerCircFixedWidthParametricFourCharProdKer_quadratic_E0_abs_restrict_Icc
    {rho : Real} (hrho : 0 < rho) (hrho_small : 9 * rho / 4 < Real.pi)
    (A : Real × Real → Complex) (hA : ContDiff Real (⊤ : ℕ∞) A)
    (hleft : ∀ c ∈ Icc (1 / 2 : Real) 1,
      (fun u : Real => A (c, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ c ∈ Icc (1 / 2 : Real) 1,
      (fun u : Real => A (c, u)) =ᶠ[nhds 2] 0)
    (hstar : ∀ p, starRingEnd Complex (A p) = A p) :
    ∃ B : Real, 0 < B ∧
      ∀ c ∈ Icc (1 / 2 : Real) 1, ∀ lambda : Real, lambda ≠ 0 →
      ∀ t0 t1 : Real, ∀ H : Real → Complex, Continuous H →
      ‖∫ t : Real, ∫ s : Real,
        outerCircleFixedWidthParametricFourierCharProductKernel A rho c lambda t s * H t *
