/-- Exact finite chart/shift/shell reassembly with one globally selected
analytic cost.  The right side intentionally retains the finite source-energy
sum, so it can be contracted by the scaled chart-overlap theorem. -/
theorem exists_uniform_allShiftCapped_annular_max_bound
    {rhoMax : Real} (hrhoMax : 0 <= rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active)
    (s : Finset iota)
