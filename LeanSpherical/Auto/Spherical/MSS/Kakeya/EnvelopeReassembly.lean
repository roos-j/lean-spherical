  unfold terminalPositiveFrozenCutoffProfile
  rw [← deriv_slice_eq_partialDerivSnd
    (fun p : Real × Real => terminalPositiveFrozenProfile n p.1 p.2)
    ((contDiff_terminalPositiveFrozenProfile n).differentiable (by simp)) c u]
  simpa [terminalPositiveFrozenProfile,
    shiftedCappedTerminalPositiveProfile,
    shiftedCappedTerminalPositiveCutoffDerivativeProfile] using
    (deriv_slice_shiftedOuterParametricProfile_eq_sndDeriv n
      (safeCappedTerminalPositiveLobe c)
      (contDiff_safeCappedTerminalPositiveLobe c)
      cappedTerminalCarrier u)

theorem terminalPositiveFrozenCutoffAmplitude_star
    (n : Nat) (p : Real × Real) :
