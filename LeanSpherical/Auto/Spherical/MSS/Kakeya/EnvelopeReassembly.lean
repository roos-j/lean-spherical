noncomputable section

/-- A circle `TT*` kernel at a fixed physical shell width, with an additional
compact profile parameter `c`.  In the capped terminal application,
`c ∈ [1/2,1]` is the ratio of the last dyadic width to the fixed cap. -/
noncomputable def outerCircleFixedWidthParametricProductTimeKernel
    (A : Real × Real → Complex) (rho c lambda t s : Real) : Complex :=
  (rho : Complex) * ∫ u in (1 / 2 : Real)..2,
    A (c, u) * Complex.exp
      (((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I))

theorem outerCircleFixedWidthParametricProductTimeKernel_eq_generic
    (A : Real × Real → Complex) (rho c lambda t s : Real) :
    outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s =
      outerCircleProfileProductTimeKernel (fun p : Real × Real => A (c, p.2))
        rho lambda t s := by
  rfl

theorem contDiff_fixedWidth_slice
    {A : Real × Real → Complex} (hA : ContDiff Real (⊤ : ℕ∞) A) (c : Real) :
    ContDiff Real (⊤ : ℕ∞) (fun u : Real => A (c, u)) := by
  exact hA.comp (contDiff_const.prodMk contDiff_id)

theorem hasJointSndSmooth_fixedWidth_slice
    {A : Real × Real → Complex} (hA : ContDiff Real (⊤ : ℕ∞) A) (c : Real)
    (n : Nat) :
    HasJointSndSmooth n (fun p : Real × Real => A (c, p.2)) := by
  apply hasJointSndSmooth_of_contDiff
  exact (contDiff_fixedWidth_slice hA c).comp contDiff_snd

/-- The trivial fixed-width central bound is uniform in every compact ratio
parameter. -/
theorem exists_outerCircleFixedWidthParametricProductTimeKernel_le_central
    (rho : Real) (hrho : 0 ≤ rho)
    (A : Real × Real → Complex) (hA : ContDiff Real (⊤ : ℕ∞) A) :
    ∃ C : Real, 0 < C ∧
      ∀ c ∈ Icc (1 / 2 : Real) 1, ∀ lambda t s : Real,
        ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s‖ ≤
          C * rho := by
  rcases exists_uniform_norm_bound_of_jointContinuous
      (a := (1 / 2 : Real)) (b := 2) (rhoMax := 1) (by norm_num) (by norm_num)
      (fun c u => A (c, u)) hA.continuous with ⟨M, hM, hbound⟩
  refine ⟨(2 - (1 / 2 : Real)) * M, mul_pos (by norm_num) hM, ?_⟩
  intro c hc lambda t s
  have hintegral : ‖∫ u in (1 / 2 : Real)..2,
      A (c, u) * Complex.exp
        (((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I))‖ ≤
      M * |2 - (1 / 2 : Real)| := by
    apply intervalIntegral.norm_integral_le_of_norm_le_const
    intro u hu
    rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one]
    have hu' : u ∈ Icc (1 / 2 : Real) 2 := by
      rw [uIoc_of_le (by norm_num)] at hu
      exact ⟨hu.1.le, hu.2⟩
    exact hbound c ⟨by linarith [hc.1], by linarith [hc.2]⟩ u hu'
  unfold outerCircleFixedWidthParametricProductTimeKernel
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hrho]
  calc
    rho * ‖∫ u in (1 / 2 : Real)..2,
        A (c, u) * Complex.exp
          (((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I))‖ ≤
        rho * (M * |2 - (1 / 2 : Real)|) :=
      mul_le_mul_of_nonneg_left hintegral hrho
    _ = ((2 - (1 / 2 : Real)) * M) * rho := by norm_num; ring

/-- Uniform order-two outer decay at a fixed shell width.  The proof treats
the cap ratio as the passive first coordinate of the quotient-amplitude
recursion, so its constant is uniform for `c ∈ [1/2,1]`. -/
theorem exists_outerCircleFixedWidthParametricProductTimeKernel_outer_order_two
    {rho : Real} (hrho : 0 < rho) (hrho_small : 9 * rho / 4 < Real.pi)
    (A : Real × Real → Complex) (hA : ContDiff Real (⊤ : ℕ∞) A)
    (hleft : ∀ c ∈ Icc (1 / 2 : Real) 1,
      (fun u : Real => A (c, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ c ∈ Icc (1 / 2 : Real) 1,
      (fun u : Real => A (c, u)) =ᶠ[nhds 2] 0) :
    ∃ M : Real, 0 < M ∧
      ∀ c ∈ Icc (1 / 2 : Real) 1, ∀ lambda t s : Real,
        (t - s) * lambda * rho ^ 2 ≠ 0 →
        ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s‖ ≤
          rho * (1 / |(t - s) * lambda * rho ^ 2|) ^ 2 *
            ((2 - (1 / 2 : Real)) * M) := by
  let D : Real × Real → Real := fun p => outerCircleShellDerivativeExtension rho p.2
  have hD : ContDiff Real (⊤ : ℕ∞) D := by
    dsimp [D]
    exact (contDiff_outerCircleShellDerivativeExtension rho).comp contDiff_snd
  have hDne : ∀ p, D p ≠ 0 := by
    intro p
    dsimp [D]
    exact outerCircleShellDerivativeExtension_ne_zero hrho hrho_small
  rcases exists_uniform_norm_bound_of_jointContinuous
      (a := (1 / 2 : Real)) (b := 2) (rhoMax := 1) (by norm_num) (by norm_num)
      (fun c u => jointNonstationaryIBPAmplitude D A 2 (c, u))
      (by simpa using
        (contDiff_jointNonstationaryIBPAmplitude D A hD hDne hA 2).continuous)
      with ⟨M, hM, hbound⟩
  refine ⟨M, hM, ?_⟩
  intro c hc lambda t s hfreq
  have hF : ContDiff Real (⊤ : ℕ∞) (fun u : Real => A (c, u)) :=
    contDiff_fixedWidth_slice hA c
  have hlast : ∀ u ∈ Icc (1 / 2 : Real) 2,
      ‖nonstationaryIBPAmplitude (outerCircleShellDerivativeExtension rho)
        (fun v : Real => A (c, v)) 2 u‖ ≤ M := by
    intro u hu
    have hslice := jointNonstationaryIBPAmplitude_eq_slice D A hD hDne hA 2 c u
    rw [← hslice]
    change ‖jointNonstationaryIBPAmplitude D A 2 (c, u)‖ ≤ M
    exact hbound c ⟨by linarith [hc.1], by linarith [hc.2]⟩ u hu
  exact norm_literalOuterCircleUnitShell_of_contDiff hrho hrho_small hfreq
    hF (hleft c hc) (hright c hc) hM.le hlast

theorem exists_outerCircleFixedWidthParametricProductTimeKernel_outer_quadratic
    {rho : Real} (hrho : 0 < rho) (hrho_small : 9 * rho / 4 < Real.pi)
    (A : Real × Real → Complex) (hA : ContDiff Real (⊤ : ℕ∞) A)
    (hleft : ∀ c ∈ Icc (1 / 2 : Real) 1,
      (fun u : Real => A (c, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ c ∈ Icc (1 / 2 : Real) 1,
      (fun u : Real => A (c, u)) =ᶠ[nhds 2] 0) :
    ∃ C : Real, 0 < C ∧
      ∀ c ∈ Icc (1 / 2 : Real) 1, ∀ lambda : Real, 0 < lambda →
        ∀ t s : Real, lambda * rho ^ 2 * |t - s| ≠ 0 →
        ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s‖ ≤
          C * rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ := by
  rcases exists_outerCircleFixedWidthParametricProductTimeKernel_outer_order_two
      hrho hrho_small A hA hleft hright with ⟨M, hM, hMbound⟩
  refine ⟨(2 - (1 / 2 : Real)) * M, mul_pos (by norm_num) hM, ?_⟩
  intro c hc lambda hlambda t s hscale
  have hts : t - s ≠ 0 := by
    intro hts
    apply hscale
    simp [hts]
  have hnonzero : (t - s) * lambda * rho ^ 2 ≠ 0 :=
    mul_ne_zero (mul_ne_zero hts hlambda.ne') (pow_ne_zero 2 hrho.ne')
  have hbase := hMbound c hc lambda t s hnonzero
  have habs : |(t - s) * lambda * rho ^ 2| =
      lambda * rho ^ 2 * |t - s| := by
    rw [abs_mul, abs_mul, abs_of_pos hlambda,
      abs_of_nonneg (sq_nonneg rho)]
    ring
  rw [habs] at hbase
  have hpow : (1 / (lambda * rho ^ 2 * |t - s|)) ^ 2 =
      ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ := by
    rw [one_div, inv_pow]
  rw [hpow] at hbase
  calc
    ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s‖ ≤
        rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ *
          ((2 - (1 / 2 : Real)) * M) := hbase
    _ = ((2 - (1 / 2 : Real)) * M) * rho *
          ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ := by ring

theorem continuous_outerCircleFixedWidthParametricProductTimeKernel_right
    (A : Real × Real → Complex) (hA : ContDiff Real (⊤ : ℕ∞) A)
    (rho c lambda t : Real) :
    Continuous (fun s => outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s) := by
  let f : Real → Real → Complex := fun s u =>
    A (c, u) * Complex.exp
      (((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I))
  have hamp : Continuous (fun u : Real => A (c, u)) :=
    hA.continuous.comp (continuous_const.prodMk continuous_id)
  have hf : Continuous (Function.uncurry f) := by
    dsimp [f]
    apply (hamp.comp continuous_snd).mul
    fun_prop
  have hparam : Continuous (fun s : Real =>
      ∫ u in Icc (1 / 2 : Real) 2, f s u) :=
    continuous_parametric_integral_of_continuous (μ := volume) hf isCompact_Icc
  have heq : (fun s : Real => ∫ u in (1 / 2 : Real)..2, f s u) =
      fun s : Real => ∫ u in Icc (1 / 2 : Real) 2, f s u := by
    funext s
    rw [intervalIntegral.integral_of_le (by norm_num),
      ← integral_Icc_eq_integral_Ioc]
  unfold outerCircleFixedWidthParametricProductTimeKernel
  change Continuous (fun s : Real => (rho : Complex) *
    ∫ u in (1 / 2 : Real)..2, f s u)
  apply continuous_const.mul
  rw [heq]
  exact hparam

theorem continuous_outerCircleFixedWidthParametricProductTimeKernel_left
    (A : Real × Real → Complex) (hA : ContDiff Real (⊤ : ℕ∞) A)
    (rho c lambda s : Real) :
    Continuous (fun t => outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s) := by
  let f : Real → Real → Complex := fun t u =>
    A (c, u) * Complex.exp
      (((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I))
  have hamp : Continuous (fun u : Real => A (c, u)) :=
    hA.continuous.comp (continuous_const.prodMk continuous_id)
  have hf : Continuous (Function.uncurry f) := by
    dsimp [f]
    apply (hamp.comp continuous_snd).mul
    fun_prop
  have hparam : Continuous (fun t : Real =>
      ∫ u in Icc (1 / 2 : Real) 2, f t u) :=
    continuous_parametric_integral_of_continuous (μ := volume) hf isCompact_Icc
  have heq : (fun t : Real => ∫ u in (1 / 2 : Real)..2, f t u) =
      fun t : Real => ∫ u in Icc (1 / 2 : Real) 2, f t u := by
    funext t
    rw [intervalIntegral.integral_of_le (by norm_num),
      ← integral_Icc_eq_integral_Ioc]
  unfold outerCircleFixedWidthParametricProductTimeKernel
  change Continuous (fun t : Real => (rho : Complex) *
    ∫ u in (1 / 2 : Real)..2, f t u)
  apply continuous_const.mul
  rw [heq]
  exact hparam

theorem outerCircleFixedWidthParametricProductTimeKernel_swap_eq_star
    (A : Real × Real → Complex) (hstar : ∀ p, starRingEnd Complex (A p) = A p)
    (rho c lambda t s : Real) :
    outerCircleFixedWidthParametricProductTimeKernel A rho c lambda s t =
      starRingEnd Complex
        (outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s) := by
  unfold outerCircleFixedWidthParametricProductTimeKernel
  rw [map_mul, Complex.conj_ofReal, ← intervalIntegral.intervalIntegral_conj]
  congr 1
  apply intervalIntegral.integral_congr_ae
  filter_upwards with u
  intro hu
  have hphase :
      (((s - t) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I =
        starRingEnd Complex
          ((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I) := by
    rw [map_mul, Complex.conj_ofReal, Complex.conj_I]
    push_cast
    ring
  rw [hphase, Complex.exp_conj]
  let z : Complex :=
    (((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I
  change A (c, u) * star (Complex.exp z) =
    star (A (c, u) * Complex.exp z)
  rw [star_mul, ← starRingEnd_apply (A (c, u)), hstar (c, u)]
  ring

theorem norm_outerCircleFixedWidthParametricProductTimeKernel_symm
    (A : Real × Real → Complex) (hstar : ∀ p, starRingEnd Complex (A p) = A p)
    (rho c lambda t s : Real) :
    ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s‖ =
      ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda s t‖ := by
  rw [outerCircleFixedWidthParametricProductTimeKernel_swap_eq_star A hstar]
  exact Complex.norm_conj _

/-- All-time Schur rows and columns with a constant uniform over the compact
ratio parameter. -/
theorem exists_outerCircleFixedWidthParametricProductTimeKernel_global_row_column_schur
    {rho : Real} (hrho : 0 < rho) (hrho_small : 9 * rho / 4 < Real.pi)
    (A : Real × Real → Complex) (hA : ContDiff Real (⊤ : ℕ∞) A)
    (hleft : ∀ c ∈ Icc (1 / 2 : Real) 1,
      (fun u : Real => A (c, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ c ∈ Icc (1 / 2 : Real) 1,
      (fun u : Real => A (c, u)) =ᶠ[nhds 2] 0)
    (hstar : ∀ p, starRingEnd Complex (A p) = A p) :
    ∃ B : Real, 0 < B ∧
      ∀ c ∈ Icc (1 / 2 : Real) 1, ∀ lambda : Real, 0 < lambda →
        (∀ t : Real,
          Integrable (fun s : Real =>
            ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s‖) volume ∧
          (∫ s : Real, ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s‖) ≤
            (2 * B) * rho * (Real.pi / (lambda * rho ^ 2))) ∧
        (∀ s : Real,
          Integrable (fun t : Real =>
            ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s‖) volume ∧
          (∫ t : Real, ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s‖) ≤
            (2 * B) * rho * (Real.pi / (lambda * rho ^ 2))) := by
  rcases exists_outerCircleFixedWidthParametricProductTimeKernel_le_central
      rho hrho.le A hA with ⟨C, hC, hcentral⟩
  rcases exists_outerCircleFixedWidthParametricProductTimeKernel_outer_quadratic
      hrho hrho_small A hA hleft hright with ⟨D, hD, houter⟩
  let B : Real := max C D
  have hBcentral : C ≤ B := le_max_left _ _
  have hBouter : D ≤ B := le_max_right _ _
  have hB : 0 < B := lt_of_lt_of_le hC hBcentral
  refine ⟨B, hB, ?_⟩
  intro c hc lambda hlambda
  have hLambda : 0 < lambda * rho ^ 2 :=
    mul_pos hlambda (sq_pos_of_pos hrho)
  have hBrho : 0 ≤ B * rho := mul_nonneg hB.le hrho.le
  have hTwoBrho : 0 ≤ (2 * B) * rho := by
    exact mul_nonneg (mul_nonneg (by norm_num) hB.le) hrho.le
  have hpoint : ∀ t s : Real,
      ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s‖ ≤
        (2 * B) * rho * quadraticTimeEnvelope (lambda * rho ^ 2) t s := by
    intro t s
    apply norm_le_quadraticTimeEnvelope_of_central_outer hBrho hLambda.le
      (outerCircleFixedWidthParametricProductTimeKernel A rho c lambda)
    · calc
        ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s‖ ≤ C * rho :=
          hcentral c hc lambda t s
        _ ≤ B * rho := mul_le_mul_of_nonneg_right hBcentral hrho.le
    · intro hscale
      calc
        ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s‖ ≤
            D * rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ :=
          houter c hc lambda hlambda t s hscale
        _ ≤ B * rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ := by
          apply mul_le_mul_of_nonneg_right
          · exact mul_le_mul_of_nonneg_right hBouter hrho.le
          · exact inv_nonneg.mpr (sq_nonneg _)
  have hright_integrable : ∀ t : Real,
      Integrable (fun s : Real =>
        ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s‖) volume := by
    intro t
    apply Integrable.mono'
    · exact (integrable_quadraticTimeEnvelope_univ (t := t) hLambda).const_mul
        ((2 * B) * rho)
    · exact (continuous_outerCircleFixedWidthParametricProductTimeKernel_right
        A hA rho c lambda t).norm.aestronglyMeasurable
    · filter_upwards with s
      simpa only [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)] using hpoint t s
  have hleft_integrable : ∀ s : Real,
      Integrable (fun t : Real =>
        ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s‖) volume := by
    intro s
    apply (hright_integrable s).congr
    filter_upwards with t
    rw [norm_outerCircleFixedWidthParametricProductTimeKernel_symm A hstar]
  constructor
  · intro t
    refine ⟨hright_integrable t, ?_⟩
    apply integral_norm_le_of_quadraticTimeEnvelope_univ hLambda hTwoBrho
      (outerCircleFixedWidthParametricProductTimeKernel A rho c lambda) (hright_integrable t)
    intro s
    exact hpoint t s
  · intro s
    refine ⟨hleft_integrable s, ?_⟩
    apply integral_norm_le_of_quadraticTimeEnvelope_univ_column hLambda hTwoBrho
      (outerCircleFixedWidthParametricProductTimeKernel A rho c lambda) (hleft_integrable s)
    intro t
    exact hpoint t s

/-- Fixed-frequency quadratic E0 estimate, uniform in the terminal cap
ratio. -/
theorem exists_outerCircleFixedWidthParametricProductTimeKernel_quadratic_E0
    {rho : Real} (hrho : 0 < rho) (hrho_small : 9 * rho / 4 < Real.pi)
    (A : Real × Real → Complex) (hA : ContDiff Real (⊤ : ℕ∞) A)
    (hleft : ∀ c ∈ Icc (1 / 2 : Real) 1,
      (fun u : Real => A (c, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ c ∈ Icc (1 / 2 : Real) 1,
      (fun u : Real => A (c, u)) =ᶠ[nhds 2] 0)
    (hstar : ∀ p, starRingEnd Complex (A p) = A p) :
    ∃ B : Real, 0 < B ∧
      ∀ c ∈ Icc (1 / 2 : Real) 1, ∀ lambda : Real, 0 < lambda →
      ∀ H : Real → Complex,
        Integrable (fun t : Real => ‖H t‖ ^ 2) volume →
        Integrable (fun p : Real × Real =>
          ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda p.1 p.2‖ *
            ‖H p.1‖ * ‖H p.2‖) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda p.1 p.2‖ *
            ‖H p.1‖ ^ 2) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda p.1 p.2‖ *
            ‖H p.2‖ ^ 2) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          outerCircleFixedWidthParametricProductTimeKernel A rho c lambda p.1 p.2 * H p.1 *
            starRingEnd Complex (H p.2)) (volume.prod volume) →
        ‖∫ t : Real, ∫ s : Real,
          outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s * H t *
            starRingEnd Complex (H s)‖ ≤
          ((2 * Real.pi) * B) / (lambda * rho) * ∫ t : Real, ‖H t‖ ^ 2 := by
  rcases exists_outerCircleFixedWidthParametricProductTimeKernel_global_row_column_schur
      hrho hrho_small A hA hleft hright hstar with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro c hc lambda hlambda H hHsq hquad hleftInt hrightInt hcomplex
  rcases hbound c hc lambda hlambda with ⟨hrows, _⟩
  let R : Real := (2 * B) * rho * (Real.pi / (lambda * rho ^ 2))
  have hsymm : ∀ t s : Real,
      ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s‖ =
        ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda s t‖ := by
    intro t s
    exact norm_outerCircleFixedWidthParametricProductTimeKernel_symm A hstar rho c lambda t s
  have hrow : ∀ t : Real,
      Integrable (fun s : Real =>
        ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s‖) volume := by
    intro t
    exact (hrows t).1
  have hrowbound : ∀ t : Real,
      (∫ s : Real, ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s‖) ≤ R := by
    intro t
    exact (hrows t).2
  have hschur := norm_integral_integral_le_of_symmetricSchur
    (outerCircleFixedWidthParametricProductTimeKernel A rho c lambda) R hsymm hrow hrowbound
    H hHsq hquad hleftInt hrightInt hcomplex
  have hR : R = ((2 * Real.pi) * B) / (lambda * rho) := by
    dsimp [R]
    field_simp [Real.pi_ne_zero, ne_of_gt hlambda, ne_of_gt hrho]
  rw [hR] at hschur
  exact hschur

/-- The uniform fixed-width cutoff-derivative E1 wrapper: the two physical
angular derivatives contribute exactly `rho⁻²`. -/
theorem exists_outerCircleFixedWidthParametricProductTimeKernel_cutoff_E1
    {rho : Real} (hrho : 0 < rho) (hrho_small : 9 * rho / 4 < Real.pi)
    (A : Real × Real → Complex) (hA : ContDiff Real (⊤ : ℕ∞) A)
    (hleft : ∀ c ∈ Icc (1 / 2 : Real) 1,
      (fun u : Real => A (c, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ c ∈ Icc (1 / 2 : Real) 1,
      (fun u : Real => A (c, u)) =ᶠ[nhds 2] 0)
    (hstar : ∀ p, starRingEnd Complex (A p) = A p) :
    ∃ B : Real, 0 < B ∧
      ∀ c ∈ Icc (1 / 2 : Real) 1, ∀ lambda : Real, 0 < lambda →
      ∀ H : Real → Complex,
        Integrable (fun t : Real => ‖H t‖ ^ 2) volume →
        Integrable (fun p : Real × Real =>
          ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda p.1 p.2‖ *
            ‖H p.1‖ * ‖H p.2‖) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda p.1 p.2‖ *
            ‖H p.1‖ ^ 2) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          ‖outerCircleFixedWidthParametricProductTimeKernel A rho c lambda p.1 p.2‖ *
            ‖H p.2‖ ^ 2) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          outerCircleFixedWidthParametricProductTimeKernel A rho c lambda p.1 p.2 * H p.1 *
            starRingEnd Complex (H p.2)) (volume.prod volume) →
        ‖(((rho ^ 2)⁻¹ : Real) : Complex) *
          ∫ t : Real, ∫ s : Real,
            outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s * H t *
              starRingEnd Complex (H s)‖ ≤
          (rho ^ 2)⁻¹ * (((2 * Real.pi) * B) / (lambda * rho)) *
            ∫ t : Real, ‖H t‖ ^ 2 := by
  rcases exists_outerCircleFixedWidthParametricProductTimeKernel_quadratic_E0
      hrho hrho_small A hA hleft hright hstar with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro c hc lambda hlambda H hHsq hquad hleftInt hrightInt hcomplex
  have hbase := hbound c hc lambda hlambda H hHsq hquad hleftInt hrightInt hcomplex
  have hfactor_nonneg : 0 ≤ (rho ^ 2)⁻¹ := inv_nonneg.mpr (sq_nonneg rho)
  calc
    ‖(((rho ^ 2)⁻¹ : Real) : Complex) *
        ∫ t : Real, ∫ s : Real,
          outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s * H t *
            starRingEnd Complex (H s)‖ =
        (rho ^ 2)⁻¹ * ‖∫ t : Real, ∫ s : Real,
          outerCircleFixedWidthParametricProductTimeKernel A rho c lambda t s * H t *
            starRingEnd Complex (H s)‖ := by
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg hfactor_nonneg]
    _ ≤ (rho ^ 2)⁻¹ *
          ((((2 * Real.pi) * B) / (lambda * rho)) * ∫ t : Real, ‖H t‖ ^ 2) :=
      mul_le_mul_of_nonneg_left hbase hfactor_nonneg
    _ = (rho ^ 2)⁻¹ * (((2 * Real.pi) * B) / (lambda * rho)) *
          ∫ t : Real, ‖H t‖ ^ 2 := by ring

/-- The uniform fixed-width phase E1 wrapper, retaining the exact physical
factor `((2*pi)*lambda*rho)^2`. -/
theorem exists_outerCircleFixedWidthParametricProductTimeKernel_phaseFactor_E1
    {rho : Real} (hrho : 0 < rho) (hrho_small : 9 * rho / 4 < Real.pi)
    (A : Real × Real → Complex) (hA : ContDiff Real (⊤ : ℕ∞) A)
    (hleft : ∀ c ∈ Icc (1 / 2 : Real) 1,
