most a quadratic radial-count multiple of `E`, the radial maximal `L²`
norm has the expected `3/2` power radial-count loss.  This is the correct
adapter for bounds `Bᵢ ≍ log(λᵢ)^2 Eᵢ` followed by Littlewood--Paley
overlap; it deliberately does not invoke the weaker uniform-band corollary.
-/
theorem eLpNorm_kakeyaRadialPhysicalEnvelope_le_of_summed_energy
    {Theta : Type*} (C : lpCutoffs 2)
    (m : Theta → SchwartzMap (Euclidean 2) Complex)
    {rho : Real} (hrho : 0 < rho)
    (hsupp : ∀ theta, Set.Subset (Function.support (m theta :
      Euclidean 2 → Complex)) (Metric.closedBall 0 (4 / rho)))
    (B0 : ENNReal) (Bband : Nat → ENNReal) (E : ENNReal)
    (hlowMeas : Measurable (fun x : Euclidean 2 =>
      ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialLowpassPhysicalField C m theta x‖ ^ 2)))
    (hbandMeas : ∀ i ∈ Finset.range (kakeyaRadialBandLevel rho),
      Measurable (fun x : Euclidean 2 =>
        ⨆ theta : Theta, ENNReal.ofReal
          (‖kakeyaRadialBandPhysicalField C m i theta x‖ ^ 2)))
    (hlowBound :
      (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialLowpassPhysicalField C m theta x‖ ^ 2)) ≤ B0)
    (hbandBound : ∀ i ∈ Finset.range (kakeyaRadialBandLevel rho),
      (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialBandPhysicalField C m i theta x‖ ^ 2)) ≤ Bband i)
    (hsummed : B0 + ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho), Bband i ≤
      ((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) ^ 2 * E) :
    eLpNorm (kakeyaRadialPhysicalEnvelope m) 2 volume ≤
      ((((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) ^ 3 * E) ^
        ((2 : Real)⁻¹)) := by
  apply eLpNorm_two_rpow_half_le_of_lintegral_le
    (hQm := aestronglyMeasurable_kakeyaRadialPhysicalSquareEnvelope m)
  let L : ENNReal := ((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal)
  calc
    (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
      (‖kakeyaRadialPhysicalField m theta x‖ ^ 2)) ≤
        L * (B0 + ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho), Bband i) := by
      simpa only [L] using
        (lintegral_iSup_sq_kakeyaRadialPhysicalField_le_lowpass_and_band_bounds
          C m hrho hsupp B0 Bband hlowMeas hbandMeas hlowBound hbandBound)
    _ ≤ L * (L ^ 2 * E) := by
      simpa only [mul_comm, mul_left_comm] using mul_le_mul_left hsummed L
    _ = L ^ 3 * E := by ring

/-- Pure `ENNReal` arithmetic underlying the preceding radial norm
conversion: cubic maximal-square energy becomes a `3/2`-power norm loss. -/
theorem rpow_half_cube_mul (L E : ENNReal) :
    (L ^ 3 * E) ^ ((2 : Real)⁻¹) =
      L ^ ((3 : Real) / 2) * E ^ ((2 : Real)⁻¹) := by
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]
  rw [← ENNReal.rpow_natCast L 3]
  rw [← ENNReal.rpow_mul]
  norm_num

end

