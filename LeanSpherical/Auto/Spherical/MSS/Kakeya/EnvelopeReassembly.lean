/-- A finite-range cost can be made independent of the shift whenever the
underlying property is monotone in that cost.  This is deliberately stated
for `range 7`, the literal stationary-cover cardinality. -/
theorem exists_uniform_real_cost_range7
    (P : Nat -> Real -> Prop)
    (hmono : ∀ n {B B' : Real}, P n B -> B <= B' -> P n B')
    (hexists : ∀ n, n < 7 -> ∃ B : Real, 0 < B ∧ P n B) :
    ∃ B : Real, 0 < B ∧ ∀ n, n < 7 -> P n B := by
  rcases hexists 0 (by omega) with ⟨B0, hB0, hP0⟩
  rcases hexists 1 (by omega) with ⟨B1, hB1, hP1⟩
  rcases hexists 2 (by omega) with ⟨B2, hB2, hP2⟩
  rcases hexists 3 (by omega) with ⟨B3, hB3, hP3⟩
  rcases hexists 4 (by omega) with ⟨B4, hB4, hP4⟩
  rcases hexists 5 (by omega) with ⟨B5, hB5, hP5⟩
  rcases hexists 6 (by omega) with ⟨B6, hB6, hP6⟩
  let B := B0 + B1 + B2 + B3 + B4 + B5 + B6
  have hB : 0 < B := by
    dsimp only [B]
    positivity
  refine ⟨B, hB, ?_⟩
  intro n hn
  interval_cases n
  · exact hmono 0 hP0 (by dsimp only [B]; linarith)
  · exact hmono 1 hP1 (by dsimp only [B]; linarith)
  · exact hmono 2 hP2 (by dsimp only [B]; linarith)
  · exact hmono 3 hP3 (by dsimp only [B]; linarith)
  · exact hmono 4 hP4 (by dsimp only [B]; linarith)
  · exact hmono 5 hP5 (by dsimp only [B]; linarith)
  · exact hmono 6 hP6 (by dsimp only [B]; linarith)

/-- The central `i=0` fixed-frequency constant can be selected before all
chart/tensor data: its construction uses only the fixed shift profile and
the compact carrier range. -/
theorem exists_uniform_shiftedCharted_central_i0_E0_E1_source_constant
    {rhoMax : Real} (hrhoMax : 0 <= rhoMax) (n : Nat) (hn : n < 7) :
    ∃ B : Real, 0 < B ∧
      ∀ {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
        (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
        (s : Finset iota)
        (q : iota -> SchwartzMap (Euclidean 2) Complex)
        (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
        (a : iota -> SchwartzMap Real Complex)
        (K : Nat) (lo hi : Real) {eps : Real}, 0 < eps ->
          4 * eps ∈ Icc (0 : Real) rhoMax ->
          ∀ xi : Euclidean 2,
          xi = ‖xi‖ • circleDirection
            (C.angle j xi) ->
          ∀ {rTime : Real}, rTime < 1 ->
            (∀ l, Function.support (a l : Real -> Complex) ⊆
              closedBall (3 / 2 : Real) rTime) ->
            xi ≠ 0 ->
            1 <= ‖xi‖ * (4 * eps) ^ (2 : Nat) ->
            ‖xi‖ * (4 * eps) ^ (2 : Nat) <= 32 ->
            shellFrequencyEnergy
              (shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n 0)
              lo hi xi <=
              (B / (‖xi‖ * (4 * eps))) *
                shiftedFiberSourceEnergy s (chartProfiles C j q) a xi ∧
            shellFrequencyEnergy
              (shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n 0)
              lo hi xi <=
              B * (‖xi‖ * (4 * eps)) *
                shiftedFiberSourceEnergy s (chartProfiles C j q) a xi := by
  rcases exists_uniform_abs_bound_shiftedCentralCutoffDerivative n hrhoMax with
    ⟨Mcut, hMcut, hcut⟩
  rcases exists_uniform_abs_bound_shiftedCentralScaledPhase n hrhoMax with
    ⟨Mphase, hMphase, hphase⟩
  let B : Real := 64 + 4 * Mcut ^ (2 : Nat) +
    800 * (2 * Real.pi) ^ (2 : Nat) * Mphase ^ (2 : Nat)
  have hB : 0 < B := by
    dsimp only [B]
    positivity
  refine ⟨B, hB, ?_⟩
  intro kappa iota charts active C j s q hqcompact a K lo hi eps heps hrmem xi hpolar
    rTime hrTime hsupport hxi hlow hhigh
  have hcutBound : ∀ u ∈ Icc (-(1 / 2 : Real)) (1 / 2 : Real),
      |shiftedCentralParametricCutoffDerivativeProfile n (4 * eps, u)| <= Mcut := by
    intro u hu
    exact hcut (4 * eps) hrmem u hu
  have hphaseBound : ∀ u ∈ Icc (-(1 / 2 : Real)) (1 / 2 : Real),
      |shiftedCentralParametricScaledPhaseProfile n (4 * eps, u)| <= Mphase := by
    intro u hu
    exact hphase (4 * eps) hrmem u hu
  have hpairs := shiftedCharted_central_i0_E0_E1_source_bounds_of_critical_window
    C j s q hqcompact a heps K n lo hi xi hpolar hn
    Mcut Mphase hMcut.le hMphase.le hcutBound hphaseBound
    hrTime hsupport hxi hlow hhigh
  simpa only [B] using hpairs

/-- Uniform-central version of the literal annular fibre witness.  In contrast
to the earlier concrete theorem, its constant is fixed before the chart and
finite tensor are supplied. -/
theorem exists_uniform_concreteAnnularShellFiberEnergyWitness_shifted_central
    {rhoMax : Real} (hrhoMax : 0 <= rhoMax) (n : Nat) (hn : n < 7) :
    ∃ B : Real, 0 < B ∧
      ∀ {kappa iota : Type*} {charts : Finset kappa}
        {active : Set (Euclidean 2)}
        (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
        (_hj : j ∈ charts) (s : Finset iota)
        (q : iota -> SchwartzMap (Euclidean 2) Complex)
        (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
        (a : iota -> SchwartzMap Real Complex)
        (K : Nat) (lo hi : Real),
      ∀ {eps lambda : Real}, 0 < eps -> 0 < lambda ->
        (4 * eps ∈ Icc (0 : Real) rhoMax) ->
        (∀ l, Function.support (q l : Euclidean 2 -> Complex) ⊆
          scaledDyadicFrequencyAnnulus lambda) ->
        (∀ xi, xi ∈ scaledDyadicFrequencyAnnulus lambda ->
          1 <= ‖xi‖ * (4 * eps) ^ 2 ∧ ‖xi‖ * (4 * eps) ^ 2 <= 32) ->
        ∀ {rTime : Real}, rTime < 1 ->
          (∀ l, Function.support (a l : Real -> Complex) ⊆
            closedBall (3 / 2 : Real) rTime) ->
        ∃ W : AnnularShellFiberEnergyWitness C j s q hqcompact a eps K n 0
          lo hi lambda (4 * eps) B
          (shiftedChartedCappedTelescopingSchwartzSlices_concrete
            C j s q hqcompact a eps K n 0 lo hi),
          ∀ xi, W.h xi = shiftedFiberSourceEnergy s (chartProfiles C j q) a xi := by
  rcases exists_uniform_shiftedCharted_central_i0_E0_E1_source_constant
      hrhoMax n hn with ⟨B, hB, hsource⟩
  refine ⟨B, hB, ?_⟩
  intro kappa iota charts active C j hj s q hqcompact a K lo hi eps lambda heps hlambda
    hrmem hqann hcritical rTime hrTime htime
  let S := shiftedChartedCappedTelescopingSchwartzSlices_concrete
    C j s q hqcompact a eps K n 0 lo hi
  have hSmult : (fun theta xi => S.multiplier theta xi) =
      shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n 0 := by
    rfl
  have hSderiv : (fun theta xi => S.multiplierDeriv theta xi) =
      shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n 0 := by
    rfl
  have hsupp := shiftedChartedCappedTelescopingMultiplier_support_on_of_profiles_supportedOn
    C j s q hqcompact a eps K n 0 (scaledDyadicFrequencyAnnulus lambda) hqann
  refine ⟨concreteAnnularShellFiberEnergyWitness C j s q hqcompact a eps K n 0
    lo hi lambda (4 * eps) B S hsupp.1 hsupp.2 ?_ ?_, ?_⟩
  · intro xi hxi
    have hnormlo : lambda / 2 <= ‖xi‖ := hxi.1
    have hxine : xi ≠ 0 := by
      intro hzero
      rw [hzero] at hnormlo
      simp at hnormlo
      linarith
    have hnorm : ‖xi‖ ≠ 0 := norm_ne_zero_iff.mpr hxine
    have hrpos : 0 < 4 * eps := by positivity
    have hsourceNonneg : 0 <= shiftedFiberSourceEnergy s (chartProfiles C j q) a xi :=
      shiftedFiberSourceEnergy_nonneg s (chartProfiles C j q) a xi
    by_cases hsector : C.sector j xi = 0
    · have hzero : ∀ theta,
          shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n 0 theta xi = 0 := by
        intro theta
        exact shiftedChartedCappedTelescopingMultiplier_eq_zero_of_sector_eq_zero
          C j s q hqcompact a eps K n 0 theta xi hsector
      have hleft : shellFrequencyEnergy
          (shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n 0)
          lo hi xi = 0 := by
        unfold shellFrequencyEnergy
        simp_rw [hzero]
        simp
      rw [hSmult, hleft]
      exact mul_nonneg (div_nonneg hB.le
        (mul_nonneg (norm_nonneg _) hrpos.le)) hsourceNonneg
    · have hpairs := hsource C j s q hqcompact a K lo hi heps hrmem xi
          (C.polar_on_sector j hj xi hsector) hrTime htime hxine
          (hcritical xi hxi).1 (hcritical xi hxi).2
      rw [hSmult]
      exact hpairs.1
  · intro xi hxi
    have hnormlo : lambda / 2 <= ‖xi‖ := hxi.1
    have hxine : xi ≠ 0 := by
      intro hzero
      rw [hzero] at hnormlo
      simp at hnormlo
      linarith
    have hrpos : 0 < 4 * eps := by positivity
    have hsourceNonneg : 0 <= shiftedFiberSourceEnergy s (chartProfiles C j q) a xi :=
      shiftedFiberSourceEnergy_nonneg s (chartProfiles C j q) a xi
    by_cases hsector : C.sector j xi = 0
    · have hzero : ∀ theta,
          shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n 0 theta xi =
              0 := by
        intro theta
        exact shiftedChartedCappedTelescopingMultiplierDerivRaw_eq_zero_of_sector_eq_zero
          C j s q hqcompact a eps K n 0 theta xi hsector
      have hleft : shellFrequencyEnergy
          (shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n 0)
          lo hi xi = 0 := by
        unfold shellFrequencyEnergy
        simp_rw [hzero]
        simp
      rw [hSderiv, hleft]
      exact mul_nonneg (mul_nonneg hB.le
        (mul_nonneg (norm_nonneg _) hrpos.le)) hsourceNonneg
    · have hpairs := hsource C j s q hqcompact a K lo hi heps hrmem xi
          (C.polar_on_sector j hj xi hsector) hrTime htime hxine
          (hcritical xi hxi).1 (hcritical xi hxi).2
      rw [hSderiv]
      exact hpairs.2
  · intro xi
    rfl

private theorem uniformCentral_commonLeft_le_pi :
    shiftedCappedShellGlobalCommonLeft <= Real.pi := by
  unfold shiftedCappedShellGlobalCommonLeft
  unfold cappedShellCommonLeft
  nlinarith [Real.pi_gt_three]

/-- Uniform-central physical endpoint estimate.  Its cost depends only on the
fixed cap and stationary shift, never on an annular tensor or shell level. -/
theorem exists_uniform_shifted_central_physical_hpiece_bound
    {rhoMax : Real} (hrhoMax : 0 <= rhoMax) (n : Nat) (hn : n < 7) :
    ∃ B : Real, 0 < B ∧
      ∀ {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
        (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
        (_hj : j ∈ charts) (s : Finset iota)
        (q : iota -> SchwartzMap (Euclidean 2) Complex)
        (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
        (a : iota -> SchwartzMap Real Complex)
        (K : Nat),
      ∀ {eps lambda : Real}, 0 < eps -> 0 < lambda ->
        (4 * eps ∈ Icc (0 : Real) rhoMax) ->
        (∀ l, Function.support (q l : Euclidean 2 -> Complex) ⊆
          scaledDyadicFrequencyAnnulus lambda) ->
        (∀ xi, xi ∈ scaledDyadicFrequencyAnnulus lambda ->
          1 <= ‖xi‖ * (4 * eps) ^ 2 ∧ ‖xi‖ * (4 * eps) ^ 2 <= 32) ->
        ((2 : Real) ^ K * eps <= Real.pi / 2) ->
        ∀ {rTime : Real}, rTime < 1 ->
          (∀ l, Function.support (a l : Real -> Complex) ⊆
            closedBall (3 / 2 : Real) rTime) ->
          Measurable (fun y : Euclidean 2 =>
            ⨆ theta : Icc shiftedCappedShellGlobalCommonLeft Real.pi,
              ENNReal.ofReal
                (‖shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n 0
                  theta.1 y‖ ^ 2)) ∧
            (∫⁻ y : Euclidean 2,
              ⨆ theta : Icc shiftedCappedShellGlobalCommonLeft Real.pi,
                ENNReal.ofReal
                  (‖shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n 0
                    theta.1 y‖ ^ 2)) <=
              ENNReal.ofReal (4 * B * ∫ xi : Euclidean 2,
                shiftedFiberSourceEnergy s (chartProfiles C j q) a xi ∂
                  (volume.restrict (scaledDyadicFrequencyAnnulus lambda))) := by
  rcases exists_uniform_concreteAnnularShellFiberEnergyWitness_shifted_central
      hrhoMax n hn with ⟨B, hB, hW⟩
  refine ⟨B, hB, ?_⟩
  intro kappa iota charts active C j hj s q hqcompact a K eps lambda heps hlambda hrmem
    hqann hcritical hscale rTime hrTime hsupport
  have hi : 0 ∈ Finset.range (K + 2) := by
    simp only [Finset.mem_range]
    omega
  rcases hW C j hj s q hqcompact a K shiftedCappedShellGlobalCommonLeft Real.pi
      heps hlambda hrmem hqann hcritical (rTime := rTime) hrTime hsupport with ⟨W, hWh⟩
  let S := shiftedChartedCappedTelescopingSchwartzSlices_concrete
    C j s q hqcompact a eps K n 0
      shiftedCappedShellGlobalCommonLeft Real.pi
  have hpiece :=
    shiftedChartedCappedTelescopingField_endpointZeroSobolev_of_concrete_annular_witness
      C j s q hqcompact a heps K n 0 hi hn hj hscale
      (hiAngle := Real.pi) (lambda := lambda) (rho := 4 * eps) (B := B)
      uniformCentral_commonLeft_le_pi S W hlambda (by positivity) hB.le
  constructor
  · exact hpiece.1
  · simpa only [hWh] using hpiece.2

end

