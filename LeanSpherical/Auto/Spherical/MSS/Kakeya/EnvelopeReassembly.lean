  rcases exists_outerCircleFixedWidthParametricProductTimeKernel_global_row_column_schur
      hrho hrho_small A hA hleft hright hstar with ⟨B, hB, hrows⟩
  refine ⟨B, hB, ?_⟩
  intro c hc lambda hlambda t0 t1 H hHcont
  let K : Real → Real → Complex :=
    outerCircleFixedWidthParametricFourierCharProductKernel A rho c lambda
  let μT : Measure Real := volume.restrict (Icc t0 t1)
  let mu : Real := (2 * Real.pi) * |lambda|
  have hmu : 0 < mu := by
    dsimp [mu]
    positivity
