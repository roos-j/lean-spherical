    rcases Finset.mem_product.mp hjni0 with ⟨hj, hni⟩
    rcases Finset.mem_product.mp hni with ⟨hn, hi⟩
    have hraw := hpiece C s q hqcompact a K heps hlambda hscale hqann hcentralMem
      hcentralCritical hdyadicMem hdyadicOuter hratio hratioDef hrTerminal hrTerminalMem
