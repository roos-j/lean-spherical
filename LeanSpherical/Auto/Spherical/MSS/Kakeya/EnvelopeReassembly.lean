  intro c hc lambda hlambda W hWsq hquad hleftInt hrightInt hcomplex
  have hbase := hbound c hc lambda hlambda W hWsq hquad hleftInt hrightInt hcomplex
  have hfactor_nonneg : 0 ≤ ((2 * Real.pi) * lambda * rho) ^ 2 := sq_nonneg _
  calc
    ‖((((2 * Real.pi) * lambda * rho) ^ 2 : Real) : Complex) *
