private theorem finiteTensorRadialBandAngularDeriv_eq_zero_of_sixteen_lt_norm
    {iota : Type*} (L : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) {i : Nat} (hi : i < 3)
    (theta : Real) (xi : Euclidean 2) (hxi : 16 < ‖xi‖) :
    finiteTensorTubeMultiplierAngularDeriv s
      (finiteTensorRadialBandProfiles L q i) a theta xi = 0 := by
  classical
  unfold finiteTensorTubeMultiplierAngularDeriv
  apply Finset.sum_eq_zero
  intro l hl
  have hqzero : finiteTensorRadialBandProfiles L q i l xi = 0 := by
    by_contra hne
    have hann := kakeyaRadialBandPiece_supportedOn_scaledDyadicFrequencyAnnulus
      L (q l) i xi (by
        simpa only [finiteTensorRadialBandProfiles] using hne)
    exact (not_le_of_gt hxi)
      (hann.2.trans (lowBand_two_mul_kakeyaRadialBandScale_le_sixteen hi))
