    hA.continuous.comp (continuous_const.prodMk continuous_snd)
  have hKcont : Continuous (Function.uncurry K) := by
    dsimp [K, outerCircleFixedWidthParametricFourierCharProductKernel]
    exact continuous_outerCircleProfileFourierCharProductKernel
      (fun p => A (c, p.2)) hAcont rho lambda
  have hsymm : ∀ t s : Real, ‖K t s‖ = ‖K s t‖ := by
    intro t s
    dsimp [K, outerCircleFixedWidthParametricFourierCharProductKernel]
    exact norm_outerCircleProfileFourierCharProductKernel_symm
      (fun p => A (c, p.2)) (fun p => hstar (c, p.2)) rho lambda t s
  rcases hrows c hc mu hmu with ⟨hrowAll, _⟩
  let R : Real := (2 * B) * rho * (Real.pi / (mu * rho ^ 2))
  have hrow : ∀ t : Real, Integrable (fun s : Real => ‖K t s‖) volume := by
    intro t
    apply (hrowAll t).1.congr
    filter_upwards with s
    exact (outerCircleFixedWidthParametricFourierCharProductKernel_norm_eq_absKernel
      A hstar rho c lambda t s).symm
  have hrowboundAll : ∀ t : Real, (∫ s : Real, ‖K t s‖) ≤ R := by
    intro t
    calc
      (∫ s : Real, ‖K t s‖) =
          ∫ s : Real, ‖outerCircleFixedWidthParametricProductTimeKernel A rho c mu t s‖ := by
            apply integral_congr_ae
            filter_upwards with s
            exact outerCircleFixedWidthParametricFourierCharProductKernel_norm_eq_absKernel
              A hstar rho c lambda t s
      _ ≤ R := (hrowAll t).2
  have hrowbound : ∀ t : Real, (∫ s : Real, ‖K t s‖ ∂μT) ≤ R := by
    intro t
    calc
      (∫ s : Real, ‖K t s‖ ∂μT) ≤ ∫ s : Real, ‖K t s‖ :=
        integral_mono_measure Measure.restrict_le_self
          (Filter.Eventually.of_forall fun s => norm_nonneg _) (hrow t)
      _ ≤ R := hrowboundAll t
  have hschur := norm_integral_integral_restrict_Icc_le_of_symmetricSchur
    (a := t0) (b := t1) K hKcont hsymm hrowbound H hHcont
  have habs : 0 < |lambda| := abs_pos.mpr hlambda
  have hR : R = B / (|lambda| * rho) := by
    dsimp [R, mu]
    field_simp [Real.pi_ne_zero, ne_of_gt habs, ne_of_gt hrho]
  simpa only [K, μT, hR] using hschur

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- A fixed-carrier real lobe family inherits the ratio-uniform fixed-width
Schur constant, provided its square product amplitude agrees with the supplied
two-parameter amplitude at that carrier.  This is the bridge from the
fixed-width terminal package to literal source-time energy. -/
theorem exists_shiftedFiberLobeEnergy_E0_of_fixedWidthFamily
    {rho : Real} (hrho : 0 < rho) (hrho_small : 9 * rho / 4 < Real.pi)
    (g : Real → (Real × Real → Real)) (A : Real × Real → Complex)
    (hg : ∀ c, Continuous (g c))
    (hfactor : ∀ c u,
      outerCircleParametricRealProfileProductAmplitude (g c) (rho, u) = A (c, u))
    (hA : ContDiff Real (⊤ : ℕ∞) A)
    (hleft : ∀ c ∈ Icc (1 / 2 : Real) 1,
      (fun u : Real => A (c, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ c ∈ Icc (1 / 2 : Real) 1,
      (fun u : Real => A (c, u)) =ᶠ[nhds 2] 0)
    (hstar : ∀ p, starRingEnd Complex (A p) = A p) :
    ∃ B : Real, 0 < B ∧
      ∀ c ∈ Icc (1 / 2 : Real) 1, ∀ lambda : Real, lambda ≠ 0 →
      ∀ {ι : Type*} (s : Finset ι)
        (q : ι → SchwartzMap (Euclidean 2) Complex)
        (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2)
        {rTime : Real}, rTime < 1 →
        (∀ l, Function.support (a l : Real → Complex) ⊆
          closedBall (3 / 2 : Real) rTime) →
      shiftedFiberLobeEnergy (g c) rho lambda
        (scratch_finiteTensorTimeData s q a xi) ≤
        (B / (|lambda| * rho)) * shiftedFiberSourceEnergy s q a xi := by
  rcases exists_outerCircFixedWidthParametricFourCharProdKer_quadratic_E0_abs_restrict_Icc
      hrho hrho_small A hA hleft hright hstar with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro c hc lambda hlambda ι s q a xi rTime hrTime hsupport
  let H : Real → Complex := scratch_finiteTensorTimeData s q a xi
  let Aanalysis := outerCircleParametricRealProfileFourierCharAnalysisAmplitude
    (g c) rho lambda
  have hHcont : Continuous H := continuous_scratch_finiteTensorTimeData s q a xi
  have hHsupport : Function.support H ⊆ Ioc (1 / 2 : Real) (5 / 2 : Real) :=
    (support_scratch_finiteTensorTimeData_subset_innerSlab s q a xi hsupport).trans
      (closedBall_innerSlab_subset_Ioc hrTime)
  have hlocal := hbound c hc lambda hlambda
    (1 / 2 : Real) (5 / 2 : Real) H hHcont
  have hkernel (t s' : Real) :
      outerCircleFixedWidthParametricFourierCharProductKernel A rho c lambda t s' =
        outerCircleProfileFourierCharProductKernel
          (outerCircleParametricRealProfileProductAmplitude (g c)) rho lambda t s' := by
    unfold outerCircleFixedWidthParametricFourierCharProductKernel
      outerCircleProfileFourierCharProductKernel
    congr 1
    apply intervalIntegral.integral_congr
    intro u hu
    change A (c, u) * _ =
      outerCircleParametricRealProfileProductAmplitude (g c) (rho, u) * _
    rw [← hfactor c u]
  have hkernelFun :
      (fun t s' : Real =>
        outerCircleFixedWidthParametricFourierCharProductKernel A rho c lambda t s') =
      (fun t s' : Real => outerCircleProfileFourierCharProductKernel
        (outerCircleParametricRealProfileProductAmplitude (g c)) rho lambda t s') := by
    funext t s'
    exact hkernel t s'
  simp_rw [hkernel] at hlocal
  rw [← outerCircParametricRealProfFourCharAnalysis_ttstar_factorization_restrict_Icc
    (g c) rho lambda (1 / 2 : Real) (5 / 2 : Real) (hg c) H hHcont] at hlocal
  rw [integral_norm_sq_restrict_Icc_eq_volume_of_support_subset_Ioc
    H (by norm_num) hHsupport] at hlocal
  have hAcont : Continuous (Function.uncurry Aanalysis) :=
    continuous_uncurry_outerCircleParametricAnalysis_of_continuous (g c) (hg c) rho lambda
  have hFrestrict : Integrable (fun u : Real =>
      ‖ttstarAnalysis (volume.restrict (Icc (1 / 2 : Real) (5 / 2 : Real)))
        Aanalysis H u‖ ^ (2 : Nat))
      (volume.restrict (Icc (1 / 2 : Real) 2)) :=
    integrable_norm_sq_ttstarAnalysis_restrict_Icc_of_continuous Aanalysis hAcont H hHcont
  have hAnalysis (u : Real) :
      ttstarAnalysis (volume.restrict (Icc (1 / 2 : Real) (5 / 2 : Real)))
        Aanalysis H u =
        ttstarAnalysis volume Aanalysis H u :=
    ttstarAnalysis_restrict_Icc_eq_volume_of_support_subset_Ioc
      Aanalysis H (by norm_num) hHsupport u
  have hF : Integrable (fun u : Real =>
      ‖ttstarAnalysis volume Aanalysis H u‖ ^ (2 : Nat))
      (volume.restrict (Icc (1 / 2 : Real) 2)) := by
    apply hFrestrict.congr
    filter_upwards with u
    rw [hAnalysis]
  have hreal := norm_real_smul_integral_mul_star_eq
    (volume.restrict (Icc (1 / 2 : Real) 2)) rho hrho.le
    (fun u : Real => ttstarAnalysis volume Aanalysis H u) hF
  change shiftedFiberLobeEnergy (g c) rho lambda H ≤
    (B / (|lambda| * rho)) * shiftedFiberSourceEnergy s q a xi
  unfold shiftedFiberLobeEnergy shiftedFiberSourceEnergy
  rw [← hreal]
  simpa only [Aanalysis, hAnalysis] using hlocal

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- The same fixed-width bridge for the time-weighted phase datum.  The
compact inner time slab contributes the explicit `25/4` energy cost, while
the Schur constant remains uniform in the terminal ratio. -/
theorem exists_timeWeighted_shiftedFiberLobeEnergy_scaled_E1_of_fixedWidthFamily
    {rho : Real} (hrho : 0 < rho) (hrho_small : 9 * rho / 4 < Real.pi)
    (g : Real → (Real × Real → Real)) (A : Real × Real → Complex)
    (hg : ∀ c, Continuous (g c))
    (hfactor : ∀ c u,
      outerCircleParametricRealProfileProductAmplitude (g c) (rho, u) = A (c, u))
    (hA : ContDiff Real (⊤ : ℕ∞) A)
    (hleft : ∀ c ∈ Icc (1 / 2 : Real) 1,
      (fun u : Real => A (c, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ c ∈ Icc (1 / 2 : Real) 1,
      (fun u : Real => A (c, u)) =ᶠ[nhds 2] 0)
    (hstar : ∀ p, starRingEnd Complex (A p) = A p) :
    ∃ B : Real, 0 < B ∧
      ∀ c ∈ Icc (1 / 2 : Real) 1, ∀ lambda : Real, lambda ≠ 0 →
      ∀ scale : Real, 0 ≤ scale →
      ∀ {ι : Type*} (s : Finset ι)
        (q : ι → SchwartzMap (Euclidean 2) Complex)
        (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2)
        {rTime : Real}, rTime < 1 →
        (∀ l, Function.support (a l : Real → Complex) ⊆
          closedBall (3 / 2 : Real) rTime) →
      scale * shiftedFiberLobeEnergy (g c) rho lambda
        (timeWeighted (scratch_finiteTensorTimeData s q a xi)) ≤
        scale * (B / (|lambda| * rho)) * shiftedFiberSourceEnergy s q a xi := by
  rcases exists_outerCircFixedWidthParametricFourCharProdKer_quadratic_E0_abs_restrict_Icc
      hrho hrho_small A hA hleft hright hstar with ⟨B0, hB0, hbound⟩
  refine ⟨((5 / 2 : Real) ^ (2 : Nat)) * B0, by positivity, ?_⟩
  intro c hc lambda hlambda scale hscale ι s q a xi rTime hrTime hsupport
  let H : Real → Complex := scratch_finiteTensorTimeData s q a xi
  let W : Real → Complex := timeWeighted H
  let Aanalysis := outerCircleParametricRealProfileFourierCharAnalysisAmplitude
    (g c) rho lambda
  have hHcont : Continuous H := continuous_scratch_finiteTensorTimeData s q a xi
  have hHsupport : Function.support H ⊆ Ioc (1 / 2 : Real) (5 / 2 : Real) :=
    (support_scratch_finiteTensorTimeData_subset_innerSlab s q a xi hsupport).trans
      (closedBall_innerSlab_subset_Ioc hrTime)
  have hWcont : Continuous W := by
    dsimp [W]
    unfold timeWeighted
    exact (Complex.continuous_ofReal.comp continuous_id).mul hHcont
  have hWsupport : Function.support W ⊆ Ioc (1 / 2 : Real) (5 / 2 : Real) := by
    intro t ht
    apply hHsupport
    by_contra hdata
    have hz : H t = 0 := by
      exact not_ne_iff.mp (by simpa only [Function.mem_support] using hdata)
    exact ht (by simp [W, timeWeighted, hz])
  have hlocal := hbound c hc lambda hlambda
    (1 / 2 : Real) (5 / 2 : Real) W hWcont
  have hkernel (t s' : Real) :
      outerCircleFixedWidthParametricFourierCharProductKernel A rho c lambda t s' =
        outerCircleProfileFourierCharProductKernel
          (outerCircleParametricRealProfileProductAmplitude (g c)) rho lambda t s' := by
    unfold outerCircleFixedWidthParametricFourierCharProductKernel
      outerCircleProfileFourierCharProductKernel
    congr 1
    apply intervalIntegral.integral_congr
    intro u hu
    change A (c, u) * _ =
      outerCircleParametricRealProfileProductAmplitude (g c) (rho, u) * _
    rw [← hfactor c u]
  simp_rw [hkernel] at hlocal
  rw [← outerCircParametricRealProfFourCharAnalysis_ttstar_factorization_restrict_Icc
    (g c) rho lambda (1 / 2 : Real) (5 / 2 : Real) (hg c) W hWcont] at hlocal
  rw [integral_norm_sq_restrict_Icc_eq_volume_of_support_subset_Ioc
    W (by norm_num) hWsupport] at hlocal
  have hAcont : Continuous (Function.uncurry Aanalysis) :=
    continuous_uncurry_outerCircleParametricAnalysis_of_continuous (g c) (hg c) rho lambda
  have hFrestrict : Integrable (fun u : Real =>
      ‖ttstarAnalysis (volume.restrict (Icc (1 / 2 : Real) (5 / 2 : Real)))
        Aanalysis W u‖ ^ (2 : Nat))
      (volume.restrict (Icc (1 / 2 : Real) 2)) :=
    integrable_norm_sq_ttstarAnalysis_restrict_Icc_of_continuous Aanalysis hAcont W hWcont
  have hAnalysis (u : Real) :
      ttstarAnalysis (volume.restrict (Icc (1 / 2 : Real) (5 / 2 : Real)))
        Aanalysis W u =
        ttstarAnalysis volume Aanalysis W u :=
    ttstarAnalysis_restrict_Icc_eq_volume_of_support_subset_Ioc
      Aanalysis W (by norm_num) hWsupport u
  have hF : Integrable (fun u : Real =>
      ‖ttstarAnalysis volume Aanalysis W u‖ ^ (2 : Nat))
      (volume.restrict (Icc (1 / 2 : Real) 2)) := by
    apply hFrestrict.congr
    filter_upwards with u
    rw [hAnalysis]
  have hreal := norm_real_smul_integral_mul_star_eq
    (volume.restrict (Icc (1 / 2 : Real) 2)) rho hrho.le
    (fun u : Real => ttstarAnalysis volume Aanalysis W u) hF
  have hweighted := integrable_norm_sq_timeWeighted_scratch_finiteTensorTimeData_and_integral_le
    s q a xi hrTime hsupport (integrable_sq_scratch_finiteTensorTimeData s q a xi)
  have hfactor_nonneg : 0 ≤ scale * (B0 / (|lambda| * rho)) := by
    have hden : 0 < |lambda| * rho :=
      mul_pos (abs_pos.mpr hlambda) hrho
    positivity
  have hraw :
      scale * shiftedFiberLobeEnergy (g c) rho lambda W ≤
        scale * (B0 / (|lambda| * rho)) * ∫ t : Real, ‖W t‖ ^ (2 : Nat) := by
    unfold shiftedFiberLobeEnergy
    rw [← hreal]
    simpa only [Aanalysis, hAnalysis, mul_assoc] using
      (mul_le_mul_of_nonneg_left hlocal hscale)
  calc
    scale * shiftedFiberLobeEnergy (g c) rho lambda W ≤
        scale * (B0 / (|lambda| * rho)) * ∫ t : Real, ‖W t‖ ^ (2 : Nat) := hraw
    _ ≤ scale * (B0 / (|lambda| * rho)) *
        ((5 / 2 : Real) ^ (2 : Nat) * ∫ t : Real, ‖H t‖ ^ (2 : Nat)) :=
      mul_le_mul_of_nonneg_left hweighted.2 hfactor_nonneg
    _ = scale * ((((5 / 2 : Real) ^ (2 : Nat)) * B0 / (|lambda| * rho))) *
        shiftedFiberSourceEnergy s q a xi := by
      simp only [H, shiftedFiberSourceEnergy]
      ring

/-- The terminal positive lobe frozen at the physical cap carrier. -/
noncomputable def terminalPositiveFrozenProfile (n : Nat)
    (c : Real) (u : Real) : Real :=
  shiftedCappedTerminalPositiveProfile n c (cappedTerminalCarrier, u)

noncomputable def terminalPositiveFrozenAmplitude (n : Nat) : Real × Real → Complex :=
  fun p => ((terminalPositiveFrozenProfile n p.1 p.2) ^ 2 : Real)

theorem terminalPositiveFrozenProfile_eq
    (n : Nat) (c u : Real) :
    terminalPositiveFrozenProfile n c u =
      shiftedStationaryPreweightProfile n (cappedTerminalCarrier * u) *
        safeCappedTerminalPositiveLobe c u := by
  rfl

theorem contDiff_terminalPositiveFrozenAmplitude (n : Nat) :
    ContDiff Real (⊤ : ℕ∞) (terminalPositiveFrozenAmplitude n) := by
  unfold terminalPositiveFrozenAmplitude terminalPositiveFrozenProfile
    shiftedCappedTerminalPositiveProfile shiftedOuterParametricProfile
  apply Complex.ofRealCLM.contDiff.comp
  apply ContDiff.pow
  exact ((contDiff_shiftedStationaryPreweightProfile n).comp
    (contDiff_const.mul contDiff_snd)).mul
      contDiff_safeCappedTerminalPositiveLobe_joint

theorem terminalPositiveFrozenAmplitude_star (n : Nat) (p : Real × Real) :
    starRingEnd Complex (terminalPositiveFrozenAmplitude n p) =
      terminalPositiveFrozenAmplitude n p := by
  simp [terminalPositiveFrozenAmplitude]

theorem terminalPositiveFrozenAmplitude_eventuallyEq_zero_left
    (n : Nat) {c : Real} (hc : c ∈ Icc (1 / 2 : Real) 1) :
    (fun u : Real => terminalPositiveFrozenAmplitude n (c, u)) =ᶠ[
      nhds (1 / 2 : Real)] 0 := by
  filter_upwards [shiftedCappedTerminalPositiveProfile_eventuallyEq_zero_left
    n hc cappedTerminalCarrier] with u hu
  simp [terminalPositiveFrozenAmplitude, terminalPositiveFrozenProfile, hu]

theorem terminalPositiveFrozenAmplitude_eventuallyEq_zero_right
    (n : Nat) {c : Real} (hc : c ∈ Icc (1 / 2 : Real) 1) :
    (fun u : Real => terminalPositiveFrozenAmplitude n (c, u)) =ᶠ[
      nhds 2] 0 := by
  filter_upwards [shiftedCappedTerminalPositiveProfile_eventuallyEq_zero_right
    n hc cappedTerminalCarrier] with u hu
  simp [terminalPositiveFrozenAmplitude, terminalPositiveFrozenProfile, hu]

/-- Ratio-uniform source-energy estimate for the positive terminal lobe at
the actual capped carrier. -/
theorem exists_shiftedCappedTerminalPositiveFiberEnergy_E0_uniform
    (n : Nat) :
    ∃ B : Real, 0 < B ∧
      ∀ c ∈ Icc (1 / 2 : Real) 1, ∀ lambda : Real, lambda ≠ 0 →
      ∀ {ι : Type*} (s : Finset ι)
        (q : ι → SchwartzMap (Euclidean 2) Complex)
        (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2)
        {rTime : Real}, rTime < 1 →
        (∀ l, Function.support (a l : Real → Complex) ⊆
          closedBall (3 / 2 : Real) rTime) →
      shiftedFiberLobeEnergy (shiftedCappedTerminalPositiveProfile n c)
        cappedTerminalCarrier lambda (scratch_finiteTensorTimeData s q a xi) ≤
        (B / (|lambda| * cappedTerminalCarrier)) *
          shiftedFiberSourceEnergy s q a xi := by
  rcases exists_shiftedFiberLobeEnergy_E0_of_fixedWidthFamily
      cappedTerminalCarrier_pos cappedTerminalCarrier_small
      (fun c => shiftedCappedTerminalPositiveProfile n c)
      (terminalPositiveFrozenAmplitude n)
      (fun c => (contDiff_shiftedCappedTerminalPositiveProfile n c).continuous)
      (fun c u => by rfl)
      (contDiff_terminalPositiveFrozenAmplitude n)
      (fun c hc => terminalPositiveFrozenAmplitude_eventuallyEq_zero_left n hc)
      (fun c hc => terminalPositiveFrozenAmplitude_eventuallyEq_zero_right n hc)
      (terminalPositiveFrozenAmplitude_star n) with ⟨B, hB, hbound⟩
  exact ⟨B, hB, hbound⟩

