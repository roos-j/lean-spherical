noncomputable section

/-- Radializing every spatial tensor profile factors the common homogeneous
dyadic multiplier out of the literal time fibre. -/
theorem scratch_finiteTensorTimeData_radialBandProfiles_eq
    {iota : Type*} (C : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (i : Nat)
    (xi : Euclidean 2) (t : Real) :
    scratch_finiteTensorTimeData s (finiteTensorRadialBandProfiles C q i) a xi t =
      intDyadicBandpassMultiplier C.cutoff ((0 : Int) + i) xi *
        scratch_finiteTensorTimeData s q a xi t := by
  unfold scratch_finiteTensorTimeData
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro l hl
  rw [finiteTensorRadialBandProfiles_apply]
  ring

/-- The radial source-time energy is exactly the squared modulus of its
common dyadic multiplier times the original source-time energy. -/
theorem shiftedFiberSourceEnergy_radialBandProfiles_eq
    {iota : Type*} (C : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (i : Nat)
    (xi : Euclidean 2) :
    shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles C q i) a xi =
      ‖intDyadicBandpassMultiplier C.cutoff ((0 : Int) + i) xi‖ ^ (2 : Nat) *
        shiftedFiberSourceEnergy s q a xi := by
  unfold shiftedFiberSourceEnergy
  have hpoint : (fun t : Real =>
      ‖scratch_finiteTensorTimeData s (finiteTensorRadialBandProfiles C q i) a xi t‖ ^
        (2 : Nat)) =
      fun t : Real =>
        ‖intDyadicBandpassMultiplier C.cutoff ((0 : Int) + i) xi‖ ^ (2 : Nat) •
          ‖scratch_finiteTensorTimeData s q a xi t‖ ^ (2 : Nat) := by
    funext t
    rw [scratch_finiteTensorTimeData_radialBandProfiles_eq]
    rw [norm_mul, mul_pow]
    simp only [smul_eq_mul]
  rw [hpoint, MeasureTheory.integral_smul]
  simp only [smul_eq_mul]

/-- The finite positive-integer radial block has square overlap at most
`16`; this follows directly from the absolute homogeneous overlap bound. -/
theorem finite_sum_norm_sq_intDyadicBandpassMultiplier_nat_le_sixteen
    (C : lpCutoffs 2) (K : Finset Nat) (xi : Euclidean 2) :
    (∑ i ∈ K,
      ‖intDyadicBandpassMultiplier C.cutoff ((0 : Int) + i) xi‖ ^ (2 : Nat)) ≤ 16 := by
  let e : Nat ↪ Int := Nat.castEmbedding
  let K' : Finset Int := K.map e
  have hsum : (∑ i ∈ K,
      ‖intDyadicBandpassMultiplier C.cutoff ((0 : Int) + i) xi‖) ≤ 4 := by
    simpa [K', e] using
      (finite_sum_norm_intDyadicBandpassMultiplier_le_four C K' xi)
  have hnonneg : ∀ i ∈ K,
      0 ≤ ‖intDyadicBandpassMultiplier C.cutoff ((0 : Int) + i) xi‖ := by
    intro i hi
    exact norm_nonneg _
  calc
    (∑ i ∈ K,
      ‖intDyadicBandpassMultiplier C.cutoff ((0 : Int) + i) xi‖ ^ (2 : Nat)) ≤
        (∑ i ∈ K,
          ‖intDyadicBandpassMultiplier C.cutoff ((0 : Int) + i) xi‖) ^ (2 : Nat) :=
      Finset.sum_sq_le_sq_sum_of_nonneg hnonneg
    _ ≤ 4 ^ (2 : Nat) := by gcongr
    _ = 16 := by norm_num

/-- A finite family of radial bands increases the literal source-time fibre
energy by at most the uniform square-overlap constant `16`. -/
theorem sum_shiftedFiberSourceEnergy_radialBandProfiles_le_sixteen
    {iota : Type*} (C : lpCutoffs 2) (K : Finset Nat) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (xi : Euclidean 2) :
    (∑ i ∈ K,
      shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles C q i) a xi) ≤
      16 * shiftedFiberSourceEnergy s q a xi := by
  rw [show (∑ i ∈ K,
      shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles C q i) a xi) =
      (∑ i ∈ K,
        ‖intDyadicBandpassMultiplier C.cutoff ((0 : Int) + i) xi‖ ^ (2 : Nat)) *
          shiftedFiberSourceEnergy s q a xi by
    rw [Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro i hi
    exact shiftedFiberSourceEnergy_radialBandProfiles_eq C s q a i xi]
  exact mul_le_mul_of_nonneg_right
    (finite_sum_norm_sq_intDyadicBandpassMultiplier_nat_le_sixteen C K xi)
    (shiftedFiberSourceEnergy_nonneg s q a xi)

/-- The finite radial square-overlap estimate remains valid after restricting
the spatial frequency integral to an arbitrary region. -/
theorem integral_sum_shiftedFiberSourceEnergy_radialBandProfiles_le_sixteen
    {iota : Type*} (C : lpCutoffs 2) (K : Finset Nat) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (A : Set (Euclidean 2)) :
    (∫ xi : Euclidean 2, ∑ i ∈ K,
      shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles C q i) a xi ∂
        (volume.restrict A)) ≤
      16 * ∫ xi : Euclidean 2, shiftedFiberSourceEnergy s q a xi ∂
        (volume.restrict A) := by
  have hbase : Integrable (shiftedFiberSourceEnergy s q a) (volume.restrict A) :=
    (integrable_shiftedFiberSourceEnergy s q a).restrict
  have hband : ∀ i ∈ K,
      Integrable (shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles C q i) a)
        (volume.restrict A) := by
    intro i hi
    exact (integrable_shiftedFiberSourceEnergy s
      (finiteTensorRadialBandProfiles C q i) a).restrict
  have hsum : Integrable (fun xi : Euclidean 2 => ∑ i ∈ K,
      shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles C q i) a xi)
        (volume.restrict A) :=
    MeasureTheory.integrable_finsetSum K (fun i hi => hband i hi)
  have hscalar : (fun xi : Euclidean 2 =>
      16 * shiftedFiberSourceEnergy s q a xi) =
      (16 : Real) • shiftedFiberSourceEnergy s q a := by
    rfl
  have hright : Integrable (fun xi : Euclidean 2 =>
      16 * shiftedFiberSourceEnergy s q a xi) (volume.restrict A) := by
    rw [hscalar]
    exact MeasureTheory.Integrable.smul (16 : Real) hbase
  have hmono : (∫ xi : Euclidean 2, ∑ i ∈ K,
      shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles C q i) a xi ∂
        (volume.restrict A)) ≤
      ∫ xi : Euclidean 2, 16 * shiftedFiberSourceEnergy s q a xi ∂
        (volume.restrict A) :=
    MeasureTheory.integral_mono hsum hright (fun xi =>
      sum_shiftedFiberSourceEnergy_radialBandProfiles_le_sixteen C K s q a xi)
  calc
    (∫ xi : Euclidean 2, ∑ i ∈ K,
        shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles C q i) a xi ∂
          (volume.restrict A)) ≤
        ∫ xi : Euclidean 2, 16 * shiftedFiberSourceEnergy s q a xi ∂
          (volume.restrict A) := hmono
    _ = 16 * ∫ xi : Euclidean 2, shiftedFiberSourceEnergy s q a xi ∂
        (volume.restrict A) := by
      rw [hscalar]
      exact MeasureTheory.integral_smul (16 : Real) (shiftedFiberSourceEnergy s q a)

/-- Equivalent finite-sum-of-integrals form of the radial source-energy
overlap estimate. -/
theorem sum_integral_shiftedFiberSourceEnergy_radialBandProfiles_le_sixteen
    {iota : Type*} (C : lpCutoffs 2) (K : Finset Nat) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (A : Set (Euclidean 2)) :
    (∑ i ∈ K, ∫ xi : Euclidean 2,
      shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles C q i) a xi ∂
        (volume.restrict A)) ≤
      16 * ∫ xi : Euclidean 2, shiftedFiberSourceEnergy s q a xi ∂
        (volume.restrict A) := by
  have hband : ∀ i ∈ K,
      Integrable (shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles C q i) a)
        (volume.restrict A) := by
    intro i hi
    exact (integrable_shiftedFiberSourceEnergy s
      (finiteTensorRadialBandProfiles C q i) a).restrict
  calc
    (∑ i ∈ K, ∫ xi : Euclidean 2,
        shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles C q i) a xi ∂
          (volume.restrict A)) =
        ∫ xi : Euclidean 2, ∑ i ∈ K,
          shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles C q i) a xi ∂
            (volume.restrict A) := by
      exact (MeasureTheory.integral_finsetSum K (fun i hi => hband i hi)).symm
    _ ≤ 16 * ∫ xi : Euclidean 2, shiftedFiberSourceEnergy s q a xi ∂
        (volume.restrict A) :=
      integral_sum_shiftedFiberSourceEnergy_radialBandProfiles_le_sixteen C K s q a A

/-- The exact unrestricted finite radial Littlewood--Paley source-energy
budget used by the radial envelope summation. -/
theorem sum_integral_shiftedFiberSourceEnergy_radialBandProfiles_range_le_sixteen
    {iota : Type*} (C : lpCutoffs 2) (L : Nat) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) :
    (∑ i ∈ Finset.range L, ∫ xi : Euclidean 2,
      shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles C q i) a xi) ≤
      16 * ∫ xi : Euclidean 2, shiftedFiberSourceEnergy s q a xi := by
  simpa using
    (sum_integral_shiftedFiberSourceEnergy_radialBandProfiles_le_sixteen
      C (Finset.range L) s q a Set.univ)

end

