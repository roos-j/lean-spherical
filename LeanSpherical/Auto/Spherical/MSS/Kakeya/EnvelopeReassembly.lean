/-- A fixed radial band of a compact-time finite tensor is controlled by the
ordinary global angular `H¹` maximal inequality.  This is the low-band
alternative to the capped stationary-shell argument; no annular largeness is
required. -/
theorem measurable_and_lintegral_iSup_sq_finiteTensorRadialBandPhysicalField_le_globalH1
    {iota : Type*} (L : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex) (i : Nat)
    (D : Real -> Euclidean 2 -> Complex)
    (hFcont : Continuous (Function.uncurry (fun theta y =>
      kakeyaRadialBandPhysicalField L
        (finiteTensorCircleRadialMultiplier s q hqcompact a) i theta y)))
    (hDcont : Continuous (Function.uncurry D))
    (hderiv : ∀ theta y, HasDerivAt
      (fun r => kakeyaRadialBandPhysicalField L
        (finiteTensorCircleRadialMultiplier s q hqcompact a) i r y)
      (D theta y) theta)
    (hleft : Integrable (fun y : Euclidean 2 =>
      ‖kakeyaRadialBandPhysicalField L
        (finiteTensorCircleRadialMultiplier s q hqcompact a) i (-Real.pi) y‖ ^ 2) volume)
    (hDprod : Integrable (fun p : Real × Euclidean 2 => ‖D p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume))
    {E0 E1 : Real}
    (hE0 : (∫ y : Euclidean 2,
      ‖kakeyaRadialBandPhysicalField L
        (finiteTensorCircleRadialMultiplier s q hqcompact a) i (-Real.pi) y‖ ^ 2) ≤ E0)
    (hE1 : (∫ theta in (-Real.pi)..Real.pi, ∫ y : Euclidean 2,
      ‖D theta y‖ ^ 2) ≤ E1) :
    Measurable (fun y : Euclidean 2 =>
      ⨆ theta : Real, ENNReal.ofReal
        (‖kakeyaRadialBandPhysicalField L
          (finiteTensorCircleRadialMultiplier s q hqcompact a) i theta y‖ ^ 2)) ∧
      (∫⁻ y : Euclidean 2, ⨆ theta : Real, ENNReal.ofReal
        (‖kakeyaRadialBandPhysicalField L
          (finiteTensorCircleRadialMultiplier s q hqcompact a) i theta y‖ ^ 2)) ≤
        ENNReal.ofReal (2 * E0 + 4 * Real.pi * E1) := by
  let F : Real -> Euclidean 2 -> Complex := fun theta y =>
    kakeyaRadialBandPhysicalField L
      (finiteTensorCircleRadialMultiplier s q hqcompact a) i theta y
  let qBand := finiteTensorRadialBandProfiles L q i
  have hqBandCompact : ∀ l, HasCompactSupport (qBand l : Euclidean 2 -> Complex) := by
    exact finiteTensorRadialBandProfiles_compact L q hqcompact i
  have hFcircle : F = fun theta y =>
      finiteTensorCircleMultiplierField s qBand hqBandCompact a theta y := by
    funext theta y
    dsimp only [F, qBand, finiteTensorCircleRadialMultiplier]
    symm
    exact finiteTensorCircleMultiplierField_radialBand_eq L s q hqcompact a i theta y
  have hperiodic : ∀ y, Function.Periodic (fun theta => F theta y)
      (2 * Real.pi) := by
    intro y
    rw [hFcircle]
    exact periodic_finiteTensorCircleMultiplierField s qBand hqBandCompact a y
  have hlocal := measurable_and_lintegral_iSup_ennreal_norm_sq_le_radiusSobolev_of_hasDerivAt
    (d := 2) (a := -Real.pi) (b := Real.pi) (by linarith [Real.pi_pos])
    (by simpa only [F] using hFcont) hDcont
    (by
      intro theta y
      simpa only [F] using hderiv theta y)
    (by simpa only [F] using hleft) hDprod
  have hEq : (fun y : Euclidean 2 =>
      ⨆ theta : Real, ENNReal.ofReal (‖F theta y‖ ^ 2)) =
      fun y : Euclidean 2 =>
        ⨆ theta : Icc (-Real.pi) Real.pi,
          ENNReal.ofReal (‖F theta.1 y‖ ^ 2) := by
    funext y
    exact iSup_sq_periodic_parametricField_eq_fundamental F hperiodic y
  constructor
  · rw [show (fun y : Euclidean 2 =>
        ⨆ theta : Real, ENNReal.ofReal
          (‖kakeyaRadialBandPhysicalField L
            (finiteTensorCircleRadialMultiplier s q hqcompact a) i theta y‖ ^ 2)) =
        fun y : Euclidean 2 => ⨆ theta : Real, ENNReal.ofReal (‖F theta y‖ ^ 2) by
          rfl, hEq]
    exact hlocal.1
  · rw [show (fun y : Euclidean 2 =>
        ⨆ theta : Real, ENNReal.ofReal
          (‖kakeyaRadialBandPhysicalField L
            (finiteTensorCircleRadialMultiplier s q hqcompact a) i theta y‖ ^ 2)) =
        fun y : Euclidean 2 => ⨆ theta : Real, ENNReal.ofReal (‖F theta y‖ ^ 2) by
          rfl, hEq]
    refine hlocal.2.trans ?_
    apply ENNReal.ofReal_le_ofReal
    have hlength : Real.pi - -Real.pi = 2 * Real.pi := by ring
    rw [hlength]
    have hDnonneg : 0 <= (∫ theta in (-Real.pi)..Real.pi, ∫ y : Euclidean 2,
        ‖D theta y‖ ^ 2) := by
      apply intervalIntegral.integral_nonneg
      · linarith [Real.pi_pos]
      · intro theta htheta
        exact integral_nonneg fun y => sq_nonneg _
    have hE1nonneg : 0 <= E1 := hDnonneg.trans hE1
    have hcoef : 0 <= 4 * Real.pi := by positivity
    exact add_le_add
      (mul_le_mul_of_nonneg_left hE0 (by norm_num))
      (calc
        2 * (2 * Real.pi) * (∫ theta in (-Real.pi)..Real.pi,
            ∫ y : Euclidean 2, ‖D theta y‖ ^ 2) =
            4 * Real.pi * (∫ theta in (-Real.pi)..Real.pi,
              ∫ y : Euclidean 2, ‖D theta y‖ ^ 2) := by ring
        _ <= 4 * Real.pi * E1 := mul_le_mul_of_nonneg_left hE1 hcoef)

/-- The energy label produced by the fixed-width angular `H¹` argument. -/
/- Concrete compact-time closure for one of the three pre-narrow radial
bands. Both endpoint energy and angular trace reduce to the literal
radialized source-time energy. -/
theorem meas_and_lintegral_iSup_sq_finTensorRadialBandPhysField_le_lowThree_sourceEn
    {iota : Type*} (L : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex) {i : Nat} (hi : i < 3)
    {rTime : Real} (hrTime : rTime < 1)
    (ha : ∀ l, Function.support (a l : Real -> Complex) ⊆
      closedBall (3 / 2 : Real) rTime) :
    Measurable (fun y : Euclidean 2 =>
      ⨆ theta : Real, ENNReal.ofReal
        (‖kakeyaRadialBandPhysicalField L
          (finiteTensorCircleRadialMultiplier s q hqcompact a) i theta y‖ ^ 2)) ∧
      (∫⁻ y : Euclidean 2, ⨆ theta : Real, ENNReal.ofReal
        (‖kakeyaRadialBandPhysicalField L
          (finiteTensorCircleRadialMultiplier s q hqcompact a) i theta y‖ ^ 2)) ≤
        ENNReal.ofReal ((4 + 102400 * Real.pi ^ 4) *
          ∫ xi : Euclidean 2,
            shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles L q i) a xi) := by
  let qBand := finiteTensorRadialBandProfiles L q i
  have hqBandCompact : ∀ l, HasCompactSupport
      (qBand l : Euclidean 2 -> Complex) :=
    finiteTensorRadialBandProfiles_compact L q hqcompact i
  let F : Real -> Euclidean 2 -> Complex := fun theta y =>
