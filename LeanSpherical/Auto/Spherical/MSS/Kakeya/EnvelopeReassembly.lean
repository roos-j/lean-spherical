    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (hqactive : ∀ l, SupportedOnActive C (q l))
    (a : iota -> SchwartzMap Real Complex)
    {eps lambda ratio rTerminal : Real}
    (heps : 0 < eps) (hlambda : 0 < lambda) (K : Nat)
    (hscale : (2 : Real) ^ K * eps <= Real.pi / 2)
    (hqann : ∀ l, Function.support (q l : Euclidean 2 -> Complex) ⊆
      scaledDyadicFrequencyAnnulus lambda)
    (hcentralMem : 4 * eps ∈ Icc (0 : Real) rhoMax)
    (hcentralCritical : ∀ xi, xi ∈ scaledDyadicFrequencyAnnulus lambda ->
      1 <= ‖xi‖ * (4 * eps) ^ 2 ∧ ‖xi‖ * (4 * eps) ^ 2 <= 32)
    (hdyadicMem : ∀ k, k < K ->
      (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps) ∈ Ioc (0 : Real) rhoMax)
    (hdyadicOuter : ∀ k, k < K -> ∀ xi,
      xi ∈ scaledDyadicFrequencyAnnulus lambda ->
      1 <= ‖xi‖ * ((4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps)) ^ 2)
    (hratio : ratio ∈ Icc (1 / 2 : Real) 1)
    (hratioDef : ratio = ((2 : Real) ^ K * eps) / (Real.pi / 2))
    (hrTerminal : rTerminal = (4 / 5 : Real) * (Real.pi / 2))
    (hrTerminalMem : rTerminal ∈ Ioc (0 : Real) rhoMax)
    (hterminalOuter : ∀ xi, xi ∈ scaledDyadicFrequencyAnnulus lambda ->
      1 <= ‖xi‖ * rTerminal ^ 2)
    {rTime : Real} (hrTime : rTime < 1)
    (hsupport : ∀ l, Function.support (a l : Real -> Complex) ⊆
      closedBall (3 / 2 : Real) rTime)
    (hangleUpper : ∀ j xi, C.angle j xi < 6) :
    ∃ B : Real, 0 < B ∧
      (∫⁻ y : Euclidean 2, ⨆ theta : Real,
        ENNReal.ofReal (‖finiteTensorCircleMultiplierField s q hqcompact a theta y‖ ^ 2)) <=
        ((shiftedCappedShellIndicesGeneric charts K).card : ENNReal) *
          ∑ jni ∈ shiftedCappedShellIndicesGeneric charts K,
