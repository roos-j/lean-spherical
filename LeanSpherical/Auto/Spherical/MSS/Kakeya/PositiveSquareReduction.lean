  let u : WaveSpaceTime → Complex := smoothSpatialTensor U a
  have hucore : InnerSlabSchwartzTensorCore u := by
    dsimp only [u]
    exact smoothSpatialTensor_mem_innerSlabSchwartzTensorCore U a r
      (fun i => (hU i).1) (fun i => (hU i).2)
      (fun i => (ha i).1) (fun i => (ha i).2.1)
      hrpos hrlt (fun i => (ha i).2.2)
  let f : WaveSpaceTime → Complex := pointwiseNormSquare u
  have hfcore : NonnegativeSquareInnerSlabSchwartzTensorCore f := by
    dsimp only [f]
    exact pointwiseNormSquare_mem_nonnegativeSquareInnerSlabSchwartzTensorCore hucore
  have hfmem : MemLp f 2 volume := by
    dsimp only [f]
    exact memLp_two_pointwiseNormSquare u (by simpa only [u] using hu)
  refine ⟨f, hfcore, hfmem, ?_⟩
  have herr : eLpNorm (u - v) 4 volume < ENNReal.ofReal eta := by
    simpa only [u, eLpNorm_sub_comm] using huerr
  have herrone : eLpNorm (u - v) 4 volume ≤ 1 := by
    calc
      eLpNorm (u - v) 4 volume ≤ ENNReal.ofReal eta := herr.le
      _ ≤ ENNReal.ofReal (1 / 2 : Real) :=
        ENNReal.ofReal_le_ofReal (min_le_right _ _)
      _ ≤ 1 := by norm_num
  have hsq := eLpNorm_pointwiseNormSquare_sub_le_linear_of_error_le_one
