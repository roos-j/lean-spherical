section

section Auto.Spherical.MSS

open Filter MeasureTheory Set FourierTransform
open Auto.Spherical.SurfaceMeasureDecay
open scoped BigOperators Convolution FourierTransform EuclideanSpace

noncomputable section

abbrev reflectedTubeTensorE2 := Euclidean 2

/-- The source-oriented kernel `K (x + tω - y)` forces the reflected
frequency profile `m (-ξ)`. -/
noncomputable def reflectedTubeProfile
    (m q : SchwartzMap reflectedTubeTensorE2 Complex) : SchwartzMap reflectedTubeTensorE2 Complex :=
  SchwartzMap.smulLeftCLM Complex (testNeg m : reflectedTubeTensorE2 -> Complex) q

theorem reflectedTubeProfile_apply
    (m q : SchwartzMap reflectedTubeTensorE2 Complex) (xi : reflectedTubeTensorE2) :
    reflectedTubeProfile m q xi = m (-xi) * q xi := by
  unfold reflectedTubeProfile
  rw [SchwartzMap.smulLeftCLM_apply_apply (testNeg m).hasTemperateGrowth,
    testNeg_apply]
  exact smul_eq_mul _ _

theorem reflectedTubeProfile_hasCompactSupport
    (m q : SchwartzMap reflectedTubeTensorE2 Complex)
    (hq : HasCompactSupport (q : reflectedTubeTensorE2 -> Complex)) :
    HasCompactSupport (reflectedTubeProfile m q : reflectedTubeTensorE2 -> Complex) := by
  apply HasCompactSupport.of_support_subset_isCompact hq.isCompact
  intro xi hxi
  apply subset_tsupport _
  apply Function.mem_support.mpr
  intro hzero
  apply Function.mem_support.mp hxi
  rw [reflectedTubeProfile_apply, hzero, mul_zero]

/-- Compactness may instead come from the reflected kernel multiplier.  This
is the form needed for dense Schwartz input tensors: after a canonical
bandlimited tube multiplier is inserted, no compact-frequency hypothesis on
the input profile itself is needed. -/
theorem reflectedTubeProfile_hasCompactSupport_left
    (m q : SchwartzMap reflectedTubeTensorE2 Complex)
    (hm : HasCompactSupport (m : reflectedTubeTensorE2 -> Complex)) :
    HasCompactSupport (reflectedTubeProfile m q : reflectedTubeTensorE2 -> Complex) := by
  apply HasCompactSupport.of_support_subset_isCompact hm.isCompact.neg
  intro xi hxi
  apply Set.mem_neg.mpr
  apply subset_tsupport _
  apply Function.mem_support.mpr
  intro hzero
  apply Function.mem_support.mp hxi
  rw [reflectedTubeProfile_apply, hzero, zero_mul]

/-- Exact source-kernel/tensor identity.  It uses the separately verified
reflection theorem, so no evenness of the canonical multiplier is assumed. -/
theorem integral_kernel_translated_tensor_eq_smoothTubeBand_reflected
    (m q : SchwartzMap reflectedTubeTensorE2 Complex) (hq : HasCompactSupport (q : reflectedTubeTensorE2 -> Complex))
    (a : SchwartzMap Real Complex) (omega y : reflectedTubeTensorE2) :
    (∫ t : Real, a t * ∫ x : reflectedTubeTensorE2,
      FourierTransform.fourierInv (m : reflectedTubeTensorE2 -> Complex) (x + t • omega - y) *
        FourierTransform.fourierInv (q : reflectedTubeTensorE2 -> Complex) x) =
      scratch_smoothTubeBand (reflectedTubeProfile m q)
        (reflectedTubeProfile_hasCompactSupport m q hq) a omega y := by
  have hprofile : (reflectedTubeProfile m q : reflectedTubeTensorE2 -> Complex) =
      fun xi : reflectedTubeTensorE2 => testNeg m xi * q xi := by
    funext xi
    rw [reflectedTubeProfile_apply, testNeg_apply]
  rw [scratch_smoothTubeBand_eq_translated, hprofile]
  apply integral_congr_ae
  filter_upwards with t
  rw [← integral_fourierInv_kernel_sub_mul_eq_fourierInv_reflected_mul
    m q (y - t • omega)]
  apply congrArg (fun z : Complex => a t * z)
  apply integral_congr_ae
  filter_upwards with x
  simp only [SchwartzMap.fourierInv_coe]
  congr 3
  abel

/-- The same source-kernel identity when compactness is supplied by the
kernel multiplier rather than by the input packet.  This is the density-safe
version: an arbitrary Schwartz input profile becomes compact only after the
canonical bandlimited multiplier is inserted. -/
theorem integral_kernel_translated_tensor_eq_smoothTubeBand_reflected_left
    (m q : SchwartzMap reflectedTubeTensorE2 Complex) (hm : HasCompactSupport (m : reflectedTubeTensorE2 -> Complex))
    (a : SchwartzMap Real Complex) (omega y : reflectedTubeTensorE2) :
    (∫ t : Real, a t * ∫ x : reflectedTubeTensorE2,
      FourierTransform.fourierInv (m : reflectedTubeTensorE2 -> Complex) (x + t • omega - y) *
        FourierTransform.fourierInv (q : reflectedTubeTensorE2 -> Complex) x) =
      scratch_smoothTubeBand (reflectedTubeProfile m q)
        (reflectedTubeProfile_hasCompactSupport_left m q hm) a omega y := by
  have hprofile : (reflectedTubeProfile m q : reflectedTubeTensorE2 -> Complex) =
      fun xi : reflectedTubeTensorE2 => testNeg m xi * q xi := by
    funext xi
    rw [reflectedTubeProfile_apply, testNeg_apply]
  rw [scratch_smoothTubeBand_eq_translated, hprofile]
  apply integral_congr_ae
  filter_upwards with t
  rw [← integral_fourierInv_kernel_sub_mul_eq_fourierInv_reflected_mul
    m q (y - t • omega)]
  apply congrArg (fun z : Complex => a t * z)
  apply integral_congr_ae
  filter_upwards with x
  simp only [SchwartzMap.fourierInv_coe]
  congr 3
  abel

end

end Auto.Spherical.MSS
end
-- END ScratchKakeyaReflectedTubeTensorBridge

-- BEGIN ScratchKakeyaPositiveSquareClosure
section

section Auto.Spherical.MSS

open Filter MeasureTheory Set FourierTransform
open Auto.Spherical.SurfaceMeasureDecay
open scoped BigOperators ENNReal EuclideanSpace FourierTransform

noncomputable section

abbrev positiveSquareClosureE2 := Euclidean 2

/-- The genuinely positive finite core used by the canonical-kernel
majorization.  It is the physical norm square of a finite separated tensor;
the preceding reassembly theorem shows that it still has the compact-frequency
inner-slab shape consumed by the signed FIO estimate. -/
def NonnegativeSquareInnerSlabCompactFrequencyTensorCore
    (f : WaveSpaceTime -> Complex) : Prop :=
  ∃ (ι : Type) (_ : Fintype ι)
    (q : ι -> SchwartzMap positiveSquareClosureE2 Complex)
    (a : ι -> SchwartzMap Real Complex) (r : Real),
    (∀ i, HasCompactSupport (q i : positiveSquareClosureE2 -> Complex)) ∧
    0 < r ∧ r < 1 ∧
    (∀ i, Function.support (a i : Real -> Complex) ⊆
      Metric.closedBall (3 / 2 : Real) r) ∧
    f = nonnegativeSquareInnerSlabTensor q a

/-- The density-friendly positive core: the generating spatial packets are
only Schwartz.  Compact frequency support is introduced later, and only
where it is analytically used, by the reflected canonical multiplier. -/
def NonnegativeSquareInnerSlabSchwartzTensorCore
    (f : WaveSpaceTime -> Complex) : Prop :=
  ∃ (ι : Type) (_ : Fintype ι)
    (q : ι -> SchwartzMap positiveSquareClosureE2 Complex)
    (a : ι -> SchwartzMap Real Complex) (r : Real),
    0 < r ∧ r < 1 ∧
    (∀ i, Function.support (a i : Real -> Complex) ⊆
      Metric.closedBall (3 / 2 : Real) r) ∧
    f = nonnegativeSquareInnerSlabTensor q a

/-- A positive square core is, after retaining all off-diagonal terms, an
ordinary finite compact-frequency inner-slab tensor. -/
theorem nonnegativeSquareInnerSlabCompactFrequencyTensorCore_to_signedCore
    {f : WaveSpaceTime -> Complex}
    (hf : NonnegativeSquareInnerSlabCompactFrequencyTensorCore f) :
    scratch_InnerSlabCompactFrequencyTensorCore f := by
  rcases hf with ⟨ι, hι, q, a, r, hq, hrpos, hrlt, ha, rfl⟩
  letI : Fintype ι := hι
  exact nonnegativeSquareInnerSlabTensor_mem_innerSlabCompactFrequencyTensorCore
    q a r hq hrpos hrlt ha

/-- The physical signed field corresponding to a square core and a source
kernel multiplier.  The reflected profile is retained literally: source
convolution by `K (x + tω - y)` acts on every square cross-profile through
`m (-ξ) * qᵢⱼ(ξ)`. -/
noncomputable def reflectedSquareTubeBand
    {ι : Type*} [Fintype ι]
    (m : SchwartzMap positiveSquareClosureE2 Complex)
    (q : ι -> SchwartzMap positiveSquareClosureE2 Complex)
    (hq : ∀ i, HasCompactSupport (q i : positiveSquareClosureE2 -> Complex))
    (a : ι -> SchwartzMap Real Complex)
    (omega : positiveSquareClosureE2) : positiveSquareClosureE2 -> Complex :=
  scratch_finiteTensorTubeBand Finset.univ
    (fun ij : ι × ι =>
      reflectedTubeProfile m (crossFrequencyMultiplier (q ij.1) (q ij.2)))
    (fun ij : ι × ι =>
      reflectedTubeProfile_hasCompactSupport m
        (crossFrequencyMultiplier (q ij.1) (q ij.2))
        (crossFrequencyMultiplier_hasCompactSupport (q ij.1) (q ij.2)
          (hq ij.1) (hq ij.2)))
    (fun ij : ι × ι => timeCrossProduct (a ij.1) (a ij.2)) omega

/-- The analogous finite tube field for arbitrary Schwartz generators.  The
only compactness supplied to the finite angular/radial machinery is the
compactness of `m`; this is exactly the canonical bandlimited situation. -/
noncomputable def reflectedSchwartzSquareTubeBand
    {ι : Type*} [Fintype ι]
    (m : SchwartzMap positiveSquareClosureE2 Complex)
    (hm : HasCompactSupport (m : positiveSquareClosureE2 -> Complex))
    (q : ι -> SchwartzMap positiveSquareClosureE2 Complex)
    (a : ι -> SchwartzMap Real Complex)
    (omega : positiveSquareClosureE2) : positiveSquareClosureE2 -> Complex :=
  scratch_finiteTensorTubeBand Finset.univ
    (fun ij : ι × ι =>
      reflectedTubeProfile m (crossFrequencyMultiplier (q ij.1) (q ij.2)))
    (fun ij : ι × ι =>
      reflectedTubeProfile_hasCompactSupport_left m
        (crossFrequencyMultiplier (q ij.1) (q ij.2)) hm)
    (fun ij : ι × ι => timeCrossProduct (a ij.1) (a ij.2)) omega

theorem reflectedSquareTubeBand_apply
    {ι : Type*} [Fintype ι]
    (m : SchwartzMap positiveSquareClosureE2 Complex)
    (q : ι -> SchwartzMap positiveSquareClosureE2 Complex)
    (hq : ∀ i, HasCompactSupport (q i : positiveSquareClosureE2 -> Complex))
    (a : ι -> SchwartzMap Real Complex)
    (omega y : positiveSquareClosureE2) :
    reflectedSquareTubeBand m q hq a omega y =
      ∑ ij : ι × ι,
        scratch_smoothTubeBand
          (reflectedTubeProfile m
            (crossFrequencyMultiplier (q ij.1) (q ij.2)))
          (reflectedTubeProfile_hasCompactSupport m
            (crossFrequencyMultiplier (q ij.1) (q ij.2))
            (crossFrequencyMultiplier_hasCompactSupport (q ij.1) (q ij.2)
              (hq ij.1) (hq ij.2)))
          (timeCrossProduct (a ij.1) (a ij.2)) omega y := by
  classical
  simp [reflectedSquareTubeBand, scratch_finiteTensorTubeBand]

theorem reflectedSchwartzSquareTubeBand_apply
    {ι : Type*} [Fintype ι]
    (m : SchwartzMap positiveSquareClosureE2 Complex)
    (hm : HasCompactSupport (m : positiveSquareClosureE2 -> Complex))
    (q : ι -> SchwartzMap positiveSquareClosureE2 Complex)
    (a : ι -> SchwartzMap Real Complex)
    (omega y : positiveSquareClosureE2) :
    reflectedSchwartzSquareTubeBand m hm q a omega y =
      ∑ ij : ι × ι,
        scratch_smoothTubeBand
          (reflectedTubeProfile m
            (crossFrequencyMultiplier (q ij.1) (q ij.2)))
          (reflectedTubeProfile_hasCompactSupport_left m
            (crossFrequencyMultiplier (q ij.1) (q ij.2)) hm)
          (timeCrossProduct (a ij.1) (a ij.2)) omega y := by
  classical
  simp [reflectedSchwartzSquareTubeBand, scratch_finiteTensorTubeBand]

/-- Positive-only slab density: unlike the earlier signed density interface,
this asks only to approximate the actual nonnegative datum `1_I |h|`.  That
restriction is exactly what makes canonical positive-core domination sound. -/
def HasPositiveSlabL2DenseCore
    (Core : (WaveSpaceTime -> Complex) -> Prop) : Prop :=
  ∀ h : WaveSpaceTime -> Complex, MemLp h 2 volume ->
    ∀ epsilon : Real, 0 < epsilon ->
      ∃ f : WaveSpaceTime -> Complex,
        Core f ∧ MemLp f 2 volume ∧
          eLpNorm
            (scratch_lightRayTimeRestriction (fun z => (‖h z‖ : Complex)) - f)
            2 volume < ENNReal.ofReal epsilon

/-- Sound final closure for a signed finite-envelope theorem on positive
square cores.  In contrast with the older signed-core lift, its domination
assumption is used only on the positive core sequence approximating
`1_I |h|`; it never asserts an invalid canonical positive-kernel domination
for arbitrary complex tensors. -/
theorem hasLightRayMaximalEstimate_of_positiveSlabDenseSignedEnvelope
    (Core : (WaveSpaceTime -> Complex) -> Prop)
    (hdense : HasPositiveSlabL2DenseCore Core)
    (T : Real -> Nat -> (WaveSpaceTime -> Complex) ->
      positiveSquareClosureE2 -> positiveSquareClosureE2 -> Complex)
    (P : Real -> Nat -> (WaveSpaceTime -> Complex) -> positiveSquareClosureE2 -> ENNReal)
    (hPmeas : ∀ delta N f, Core f -> Measurable (P delta N f))
    (hstrong : ∀ N : Nat, 3 < N -> ∃ C : Real, 0 < C ∧
      ∀ delta : Real, 0 < delta -> delta < 1 / 2 ->
      ∀ f : WaveSpaceTime -> Complex, Core f ->
        eLpNorm (P delta N f) 2 volume <=
          ENNReal.ofReal (C * (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
            eLpNorm f 2 volume)
    (hidentify : ∀ delta N (h : WaveSpaceTime -> Complex)
      (omega y : positiveSquareClosureE2),
      T delta N
          (scratch_lightRayTimeRestriction (fun z => (‖h z‖ : Complex))) omega y =
        (lightRayAverage delta N omega y h : Complex))
    (hTgeom : ∀ delta N (F : WaveSpaceTime -> Complex)
      (core : Nat -> WaveSpaceTime -> Complex),
      MemLp F 2 volume ->
      (∀ n, MemLp (core n) 2 volume) ->
      (∀ n, eLpNorm (F - core n) 2 volume <=
        eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) ->
      ∀ omega y,
        Tendsto (fun n => T delta N (core n) omega y) atTop
          (nhds (T delta N F omega y)))
    (hdom : ∀ delta N f, Core f -> ∀ omega y,
      ENNReal.ofReal ‖T delta N f omega y‖ <= P delta N f y) :
    HasLightRayMaximalEstimate := by
  intro N hN
  obtain ⟨C, hCpos, hCstrong⟩ := hstrong N hN
  refine ⟨2 * C, by positivity, ?_⟩
  intro delta hdelta hdeltasmall g hg
  let h : WaveSpaceTime -> Complex := scratch_lightRayTimeRestriction g
  have hh : MemLp h 2 volume := by
    simpa only [h] using scratch_memLp_lightRayTimeRestriction g hg
  have hslab : h = scratch_lightRayTimeRestriction h := by
    funext z
    dsimp only [h]
    simp only [scratch_lightRayTimeRestriction, Set.indicator_indicator]
    rw [inter_self]
  let F : WaveSpaceTime -> Complex :=
    scratch_lightRayTimeRestriction (fun z => (‖h z‖ : Complex))
  have hFmem : MemLp F 2 volume := by
    dsimp only [F]
    exact scratch_memLp_lightRayTimeRestriction _
      (scratch_memLp_complex_of_norm h hh)
  have hFnorm : eLpNorm F 2 volume = eLpNorm h 2 volume := by
    dsimp only [F]
    exact scratch_eLpNorm_positiveSlab_eq h hslab 2
  have hM : lightRayMaximal delta N g = lightRayMaximal delta N h := by
    simpa only [h] using
      scratch_lightRayMaximal_eq_lightRayTimeRestriction hdelta N (by omega) g hg
  let L : Real := (1 + abs (Real.log delta)) ^ (3 / 2 : Real)
  let A : ENNReal := ENNReal.ofReal (C * L)
  by_cases hhnonzero : eLpNorm h 2 volume = 0
  · have hhae : h =ᵐ[volume] (fun _ : WaveSpaceTime => (0 : Complex)) :=
      (eLpNorm_eq_zero_iff hh.aestronglyMeasurable (by norm_num)).mp hhnonzero
    have hMhzero : lightRayMaximal delta N h = 0 := by
      calc
        lightRayMaximal delta N h =
            lightRayMaximal delta N (fun _ : WaveSpaceTime => (0 : Complex)) :=
          scratch_lightRayMaximal_eq_of_ae_eq_of_memLp hdelta N (by omega) hh
            MemLp.zero hhae
        _ = 0 := scratch_lightRayMaximal_zero delta N
    rw [hM, hMhzero]
    simp
  · let R : Real := (eLpNorm F 2 volume).toReal
    have hFnonzero : eLpNorm F 2 volume ≠ 0 := by
      rwa [hFnorm]
    have hRpos : 0 < R := ENNReal.toReal_pos hFnonzero hFmem.eLpNorm_ne_top
    choose core hcore hcoreMem hcoreErr using fun n : Nat =>
      hdense h hh (R * ((2 : Real)⁻¹ ^ n))
        (show 0 < R * ((2 : Real)⁻¹ ^ n) by positivity)
    have hscaled (n : Nat) :
        eLpNorm (F - core n) 2 volume <=
          eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n) := by
      calc
        eLpNorm (F - core n) 2 volume <=
            ENNReal.ofReal (R * ((2 : Real)⁻¹ ^ n)) := by
              simpa only [F] using (hcoreErr n).le
        _ = ENNReal.ofReal R * ENNReal.ofReal ((2 : Real)⁻¹ ^ n) :=
          ENNReal.ofReal_mul hRpos.le
        _ = eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n) := by
          rw [ENNReal.ofReal_toReal hFmem.eLpNorm_ne_top]
    have hcoreStrong (n : Nat) :
        eLpNorm (P delta N (core n)) 2 volume <=
          A * eLpNorm (core n) 2 volume := by
      simpa only [A, L] using hCstrong delta hdelta hdeltasmall
        (core n) (hcore n)
    have hconv : ∀ omega y,
        Tendsto (fun n => T delta N (core n) omega y) atTop
          (nhds (T delta N F omega y)) :=
      hTgeom delta N F core hFmem hcoreMem hscaled
    have hfatou : ∀ᵐ y : positiveSquareClosureE2 ∂volume,
        ENNReal.ofReal (lightRayMaximal delta N h y) <=
          atTop.liminf (fun n => P delta N (core n) y) := by
      filter_upwards with y
      apply scratch_lightRayMaximal_ofReal_le_liminf_of_signedCore
        hdelta N (by omega) h hh F (T delta N) (P delta N) core
      · intro omega y
        simpa only [F] using hidentify delta N h omega y
      · exact hconv
      · intro n omega y
        exact hdom delta N (core n) (hcore n) omega y
    have hbound : eLpNorm (lightRayMaximal delta N h) 2 volume <=
        A * (2 * eLpNorm h 2 volume) := by
      calc
        eLpNorm (lightRayMaximal delta N h) 2 volume <=
            A * (2 * eLpNorm F 2 volume) := by
          apply scratch_lightRayMaximal_bound_of_signedCore_liminf
            hdelta N (by omega) h hh A (2 * eLpNorm F 2 volume) core
              (P delta N)
          · intro n
            exact hPmeas delta N (core n) (hcore n)
          · exact hcoreStrong
          · intro n
            exact scratch_core_eLpNorm_le_two_of_scaled_approximation
              F hFmem core hcoreMem hscaled n
          · exact hfatou
        _ = A * (2 * eLpNorm h 2 volume) := by rw [hFnorm]
    have hnorm : eLpNorm h 2 volume <= eLpNorm g 2 volume := by
      simpa only [h] using scratch_eLpNorm_lightRayTimeRestriction_le g
    have hboundG : eLpNorm (lightRayMaximal delta N g) 2 volume <=
        A * (2 * eLpNorm g 2 volume) := by
      calc
        eLpNorm (lightRayMaximal delta N g) 2 volume =
            eLpNorm (lightRayMaximal delta N h) 2 volume := by rw [hM]
        _ <= A * (2 * eLpNorm h 2 volume) := hbound
        _ <= A * (2 * eLpNorm g 2 volume) := by
          simpa only [mul_assoc, mul_comm, mul_left_comm] using
            (mul_le_mul_left (mul_le_mul_left hnorm 2) A)
    have hfactor : A * (2 * eLpNorm g 2 volume) =
        ENNReal.ofReal ((2 * C) * L) * eLpNorm g 2 volume := by
      calc
        A * (2 * eLpNorm g 2 volume) =
            (2 * A) * eLpNorm g 2 volume := by ring
        _ = ENNReal.ofReal (2 * (C * L)) * eLpNorm g 2 volume := by
          congr 1
          dsimp only [A]
          rw [ENNReal.ofReal_mul (by norm_num : (0 : Real) <= 2)]
          norm_num
        _ = ENNReal.ofReal ((2 * C) * L) * eLpNorm g 2 volume := by
          congr 2
          ring
    calc
      eLpNorm (lightRayMaximal delta N g) 2 volume <=
          A * (2 * eLpNorm g 2 volume) := hboundG
      _ = ENNReal.ofReal ((2 * C) *
          (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
          eLpNorm g 2 volume := by
        simpa only [L] using hfactor

/-- Concrete adapter for the actual compact-frequency square core.  The
finite analytic estimate may be proved on the larger signed tensor class
(where the radial/chart machinery naturally lives), but the canonical
positive-kernel domination is invoked only on norm squares. -/
theorem hasLightRayMaximalEstimate_of_nonnegativeSquareInnerSlabCore
    (hdense : HasPositiveSlabL2DenseCore
      NonnegativeSquareInnerSlabCompactFrequencyTensorCore)
    (T : Real -> Nat -> (WaveSpaceTime -> Complex) ->
      positiveSquareClosureE2 -> positiveSquareClosureE2 -> Complex)
    (P : Real -> Nat -> (WaveSpaceTime -> Complex) -> positiveSquareClosureE2 -> ENNReal)
    (hPmeas : ∀ delta N f, scratch_InnerSlabCompactFrequencyTensorCore f ->
      Measurable (P delta N f))
    (hstrong : ∀ N : Nat, 3 < N -> ∃ C : Real, 0 < C ∧
      ∀ delta : Real, 0 < delta -> delta < 1 / 2 ->
      ∀ f : WaveSpaceTime -> Complex,
        scratch_InnerSlabCompactFrequencyTensorCore f ->
        eLpNorm (P delta N f) 2 volume <=
          ENNReal.ofReal (C * (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
            eLpNorm f 2 volume)
    (hidentify : ∀ delta N (h : WaveSpaceTime -> Complex)
      (omega y : positiveSquareClosureE2),
      T delta N
          (scratch_lightRayTimeRestriction (fun z => (‖h z‖ : Complex))) omega y =
        (lightRayAverage delta N omega y h : Complex))
    (hTgeom : ∀ delta N (F : WaveSpaceTime -> Complex)
      (core : Nat -> WaveSpaceTime -> Complex),
      MemLp F 2 volume ->
      (∀ n, MemLp (core n) 2 volume) ->
      (∀ n, eLpNorm (F - core n) 2 volume <=
        eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) ->
      ∀ omega y,
        Tendsto (fun n => T delta N (core n) omega y) atTop
          (nhds (T delta N F omega y)))
    (hdom : ∀ delta N f,
      NonnegativeSquareInnerSlabCompactFrequencyTensorCore f ->
      ∀ omega y, ENNReal.ofReal ‖T delta N f omega y‖ <= P delta N f y) :
    HasLightRayMaximalEstimate := by
  apply hasLightRayMaximalEstimate_of_positiveSlabDenseSignedEnvelope
    NonnegativeSquareInnerSlabCompactFrequencyTensorCore hdense T P
  · intro delta N f hf
    exact hPmeas delta N f
      (nonnegativeSquareInnerSlabCompactFrequencyTensorCore_to_signedCore hf)
  · intro N hN
    obtain ⟨C, hC, hbound⟩ := hstrong N hN
    refine ⟨C, hC, ?_⟩
    intro delta hdelta hdeltaSmall f hf
    exact hbound delta hdelta hdeltaSmall f
      (nonnegativeSquareInnerSlabCompactFrequencyTensorCore_to_signedCore hf)
  · exact hidentify
  · exact hTgeom
  · exact hdom

/-- Squaring an arbitrary member of the signed finite tensor core lands in
the positive-square core, with its original strict time margin retained. -/
theorem pointwiseNormSquare_mem_nonnegativeSquareInnerSlabCore
    {u : WaveSpaceTime -> Complex}
    (hu : scratch_InnerSlabCompactFrequencyTensorCore u) :
    NonnegativeSquareInnerSlabCompactFrequencyTensorCore (pointwiseNormSquare u) := by
  rcases hu with ⟨ι, hι, q, a, r, hq, hrpos, hrlt, ha, hu⟩
  letI : Fintype ι := hι
  refine ⟨ι, inferInstance, q, a, r, hq, hrpos, hrlt, ha, ?_⟩
  funext z
  rw [pointwiseNormSquare_apply, hu]
  rfl

/-- The literal nonnegative datum on the light-ray time slab. -/
noncomputable def positiveSlabDatum
    (h : WaveSpaceTime -> Complex) : WaveSpaceTime -> Complex :=
  scratch_lightRayTimeRestriction (fun z => (‖h z‖ : Complex))

/-- Its nonnegative square root, viewed as a complex-valued function. -/
noncomputable def positiveSlabSquareRoot
    (h : WaveSpaceTime -> Complex) : WaveSpaceTime -> Complex :=
  fun z => (Real.sqrt ‖positiveSlabDatum h z‖ : Complex)

theorem positiveSlabDatum_memLp_two
    (h : WaveSpaceTime -> Complex) (hh : MemLp h 2 volume) :
    MemLp (positiveSlabDatum h) 2 volume := by
  unfold positiveSlabDatum
  exact scratch_memLp_lightRayTimeRestriction _
    (scratch_memLp_complex_of_norm h hh)

theorem positiveSlabSquareRoot_memLp_four
    (h : WaveSpaceTime -> Complex) (hh : MemLp h 2 volume) :
    MemLp (positiveSlabSquareRoot h) 4 volume := by
  unfold positiveSlabSquareRoot
  exact memLp_four_complex_sqrt_norm (positiveSlabDatum h)
    (positiveSlabDatum_memLp_two h hh)

theorem pointwiseNormSquare_positiveSlabSquareRoot
    (h : WaveSpaceTime -> Complex) :
    pointwiseNormSquare (positiveSlabSquareRoot h) = positiveSlabDatum h := by
  funext z
  rw [pointwiseNormSquare_apply]
  by_cases hz : z.2 ∈ lightRayTimeInterval
  · simp [positiveSlabSquareRoot, positiveSlabDatum,
      scratch_lightRayTimeRestriction, hz, Complex.normSq]
  · simp [positiveSlabSquareRoot, positiveSlabDatum,
      scratch_lightRayTimeRestriction, hz, Complex.normSq]

/-- A convenient quantitative form of the `L⁴ → L²` square estimate.  Once
the root approximation has `L⁴` error at most one, its square error is
linear in that error with a constant depending only on the target root. -/
theorem eLpNorm_pointwiseNormSquare_sub_le_linear_of_error_le_one
    {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (u v : X -> Complex) (hu : MemLp u 4 μ) (hv : MemLp v 4 μ)
    (he : eLpNorm (u - v) 4 μ <= 1) :
    eLpNorm (pointwiseNormSquare u - pointwiseNormSquare v) 2 μ <=
      (1 + 2 * eLpNorm v 4 μ) * eLpNorm (u - v) 4 μ := by
  let e : ENNReal := eLpNorm (u - v) 4 μ
  let V : ENNReal := eLpNorm v 4 μ
  have hU : eLpNorm u 4 μ <= e + V := by
    calc
      eLpNorm u 4 μ = eLpNorm ((u - v) + v) 4 μ := by
        congr 1
        funext x
        change u x = (u x - v x) + v x
        abel
      _ <= eLpNorm (u - v) 4 μ + eLpNorm v 4 μ :=
        eLpNorm_add_le (hu.sub hv).aestronglyMeasurable hv.aestronglyMeasurable
          (by norm_num)
      _ = e + V := by rfl
  have hbase := eLpNorm_pointwiseNormSquare_sub_le u v hu hv
  change eLpNorm (pointwiseNormSquare u - pointwiseNormSquare v) 2 μ <=
    (1 + 2 * V) * e
  calc
    eLpNorm (pointwiseNormSquare u - pointwiseNormSquare v) 2 μ <=
        e * eLpNorm u 4 μ + V * e := by
          simpa only [e, V] using hbase
    _ <= e * (e + V) + V * e := by
      apply add_le_add
      · simpa only [mul_comm] using (mul_le_mul_left hU e)
      · exact le_rfl
    _ = e * e + e * V + V * e := by ring
    _ <= e * 1 + e * V + V * e := by
      gcongr
    _ = (1 + 2 * V) * e := by ring
end

end Auto.Spherical.MSS
