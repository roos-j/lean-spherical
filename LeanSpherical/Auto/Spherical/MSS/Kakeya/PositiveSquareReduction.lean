  T : Real → Nat → (WaveSpaceTime → Complex) → positiveSquareCanonicalDyadicE2 → positiveSquareCanonicalDyadicE2 → Complex
  E : Real → Nat → (WaveSpaceTime → Complex) → Nat → positiveSquareCanonicalDyadicE2 → ENNReal
