arbitrary signed `f`. -/
theorem integral_re_mul_ofReal_le_norm_integral
    {X : Type*} [MeasurableSpace X] (mu : Measure X)
    (K : X -> Complex) (F : X -> Real)
    (hK : Integrable (fun x => K x * (F x : Complex)) mu) :
    (∫ x, (K x).re * F x ∂mu) <=
      ‖∫ x, K x * (F x : Complex) ∂mu‖ := by
  have hpoint : (fun x => (K x).re * F x) =
      fun x => (K x * (F x : Complex)).re := by
    funext x
    simp [Complex.mul_re]
  rw [hpoint]
  have hre :
      (∫ x, (K x * (F x : Complex)).re ∂mu) =
        (∫ x, K x * (F x : Complex) ∂mu).re := by
    simpa using (integral_re hK)
  rw [hre]
  exact (le_abs_self _).trans (Complex.abs_re_le_norm _)

/-- The canonical positive tube core is the real part of the inverse Fourier
transform of its compact multiplier.  Hence its linear average on a
nonnegative real input is bounded by the norm of the compact-frequency tube
average.  The integrability assumption is intentionally literal so it can
be discharged by the finite inner-slab tensor model. -/
