section

section Auto.Spherical.MSS

open Filter MeasureTheory Set
open scoped BigOperators ENNReal Topology EuclideanSpace

open Auto.Spherical.SurfaceMeasureDecay

noncomputable section

/-- The Fatou limit of finite canonical dyadic endpoint envelopes.  The
finite terms are where the narrow radial-band argument and broad-tail
argument live; this definition contains no illicit infinite triangle step. -/
noncomputable def canonicalDyadicFiniteEnvelopeLimit
    (E : Real → Nat → (WaveSpaceTime → Complex) → Nat → Euclidean 2 → ENNReal)
    (delta : Real) (N : Nat) (f : WaveSpaceTime → Complex) :
    Euclidean 2 → ENNReal :=
  fun y => atTop.liminf (fun M => E delta N f M y)

/-- Data left after the canonical positive-kernel decomposition has been
reduced to finite endpoint envelopes.  `E delta N f M` is intended to be the
finite sum through the first `M` canonical scales, with each narrow scale
resolved into its central lowpass and finitely many radial bands. -/
structure CanonicalDyadicFiniteEnvelopeSignedModel where
  T : Real → Nat → (WaveSpaceTime → Complex) →
    Euclidean 2 → Euclidean 2 → Complex
  E : Real → Nat → (WaveSpaceTime → Complex) → Nat → Euclidean 2 → ENNReal
  hEmeas : ∀ delta N f M,
    scratch_InnerSlabCompactFrequencyTensorCore f → Measurable (E delta N f M)
  hLimitMeas : ∀ delta N f,
    scratch_InnerSlabCompactFrequencyTensorCore f →
      Measurable (canonicalDyadicFiniteEnvelopeLimit E delta N f)
  hidentify : ∀ delta N (h : WaveSpaceTime → Complex)
    (omega y : Euclidean 2),
    T delta N
        (scratch_lightRayTimeRestriction (fun z => (‖h z‖ : Complex))) omega y =
      (lightRayAverage delta N omega y h : Complex)
  hTgeom : ∀ delta N (F : WaveSpaceTime → Complex)
    (core : Nat → WaveSpaceTime → Complex),
    MemLp F 2 volume →
    (∀ n, MemLp (core n) 2 volume) →
    (∀ n, eLpNorm (F - core n) 2 volume ≤
      eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) →
    ∀ omega y,
      Tendsto (fun n => T delta N (core n) omega y) atTop
        (nhds (T delta N F omega y))
  /-- This is precisely the output of
  `scratch_rawEnvelope_le_liminf_finiteEnvelope` after instantiating the
  canonical kernel majorant. -/
  hcanonicalDom : ∀ delta N f omega y,
    ENNReal.ofReal ‖T delta N f omega y‖ ≤
      canonicalDyadicFiniteEnvelopeLimit E delta N f y

/-- The sole finite analytic premise: every finite canonical partial envelope
obeys the target bound uniformly in the truncation.  It is here, and only
here, that the central lowpass, finite radial bands, narrow estimate, and
broad tail have to be proved. -/
def HasCanonicalDyadicFiniteEnvelopeL2Estimate
    (model : CanonicalDyadicFiniteEnvelopeSignedModel) : Prop :=
  ∀ N : Nat, 3 < N → ∃ C : Real, 0 < C ∧
    ∀ delta : Real, 0 < delta → delta < 1 / 2 →
    ∀ f : WaveSpaceTime → Complex,
      scratch_InnerSlabCompactFrequencyTensorCore f →
      ∀ M : Nat,
        eLpNorm (model.E delta N f M) 2 volume ≤
          ENNReal.ofReal (C * (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
            eLpNorm f 2 volume

/-- Geometric canonical coefficients turn uniform narrow/broad per-scale
costs into one uniform finite-truncation cost.  The broad estimate need only
be width-independent: the final logarithmic factor is at least one and so
absorbs it. -/
theorem scratch_sum_range_canonicalCoefficient_mul_cost_le
    (M k0 N : Nat) (c r A B L : Real)
    (hN : 2 < N) (hc : 0 < c) (hr : 0 < r)
    (hA : 0 < A) (hB : 0 ≤ B) (hL : 0 ≤ L) (hLone : 1 ≤ L)
    (cost : Nat → Real)
    (hnarrow : ∀ j, j < k0 → cost j ≤ A * L)
    (hbroad : ∀ j, k0 ≤ j → cost j ≤ B) :
    (∑ j ∈ Finset.range M,
      canonicalBandlimitedDyadicCoefficient N c r j * cost j) ≤
      ((A + B) * (((2 : Real) ^ N / c) * (2 / r) ^ 2) /
        (1 - ((2 : Real)⁻¹) ^ (N - 2))) * L := by
  let C : Real := ((2 : Real) ^ N / c) * (2 / r) ^ 2
  let q : Real := ((2 : Real)⁻¹) ^ (N - 2)
  have hC : 0 < C := by
    dsimp [C]
    positivity
  have hq : 0 ≤ q := by
    dsimp [q]
    positivity
  have hqlt : q < 1 := by
    dsimp [q]
    apply pow_lt_one₀ (by positivity) (by norm_num)
    exact Nat.ne_of_gt (Nat.sub_pos_of_lt hN)
  have hcost : ∀ j, cost j ≤ (A + B) * L := by
    intro j
    by_cases hj : j < k0
    · calc
        cost j ≤ A * L := hnarrow j hj
        _ ≤ (A + B) * L :=
          mul_le_mul_of_nonneg_right (by linarith) hL
    · have hj' : k0 ≤ j := le_of_not_gt hj
      calc
        cost j ≤ B := hbroad j hj'
        _ = B * 1 := by ring
        _ ≤ B * L := mul_le_mul_of_nonneg_left hLone hB
        _ ≤ (A + B) * L :=
          mul_le_mul_of_nonneg_right (by linarith) hL
  have hcoeff (j : Nat) :
      canonicalBandlimitedDyadicCoefficient N c r j = C * q ^ j := by
    dsimp [C, q]
    exact scratch_canonicalBandlimitedDyadicCoefficient_eq_geometric N c r j
  have hcoeffnonneg (j : Nat) :
      0 ≤ canonicalBandlimitedDyadicCoefficient N c r j := by
    rw [hcoeff]
    exact mul_nonneg hC.le (pow_nonneg hq _)
  have hpoint :
      (∑ j ∈ Finset.range M,
        canonicalBandlimitedDyadicCoefficient N c r j * cost j) ≤
        ∑ j ∈ Finset.range M,
          canonicalBandlimitedDyadicCoefficient N c r j * ((A + B) * L) := by
    apply Finset.sum_le_sum
    intro j _
    exact mul_le_mul_of_nonneg_left (hcost j) (hcoeffnonneg j)
  have hgeom : Summable (fun j : Nat => q ^ j) :=
    summable_geometric_of_lt_one hq hqlt
  have hgeomfin : (∑ j ∈ Finset.range M, q ^ j) ≤ (1 - q)⁻¹ := by
    calc
      (∑ j ∈ Finset.range M, q ^ j) ≤ ∑' j : Nat, q ^ j :=
        hgeom.sum_le_tsum (Finset.range M) (fun j _ => pow_nonneg hq j)
      _ = (1 - q)⁻¹ := tsum_geometric_of_lt_one hq hqlt
  have hrewrite :
      (∑ j ∈ Finset.range M,
        canonicalBandlimitedDyadicCoefficient N c r j * ((A + B) * L)) =
        C * ((A + B) * L) * (∑ j ∈ Finset.range M, q ^ j) := by
    calc
      (∑ j ∈ Finset.range M,
        canonicalBandlimitedDyadicCoefficient N c r j * ((A + B) * L)) =
          ∑ j ∈ Finset.range M, (C * ((A + B) * L)) * q ^ j := by
            apply Finset.sum_congr rfl
            intro j _
            rw [hcoeff]
            ring
      _ = C * ((A + B) * L) * (∑ j ∈ Finset.range M, q ^ j) := by
        rw [Finset.mul_sum]
  have hfactor : 0 ≤ C * ((A + B) * L) := by
    apply mul_nonneg hC.le
    apply mul_nonneg
    · linarith
    · exact hL
  calc
    (∑ j ∈ Finset.range M,
      canonicalBandlimitedDyadicCoefficient N c r j * cost j) ≤
        ∑ j ∈ Finset.range M,
          canonicalBandlimitedDyadicCoefficient N c r j * ((A + B) * L) := hpoint
    _ = C * ((A + B) * L) * (∑ j ∈ Finset.range M, q ^ j) := hrewrite
    _ ≤ C * ((A + B) * L) * (1 - q)⁻¹ :=
      mul_le_mul_of_nonneg_left hgeomfin hfactor
    _ = ((A + B) * (((2 : Real) ^ N / c) * (2 / r) ^ 2) /
        (1 - ((2 : Real)⁻¹) ^ (N - 2))) * L := by
      dsimp [C, q]
      rw [div_eq_mul_inv]
      ring

/-- A narrow/broad formulation of the only finite analytic estimate still
needed.  `cost j` is allowed to contain the central lowpass and the finite
radial-band count at scale `j`; the canonical coefficient arithmetic below
is responsible for turning it into the target global logarithmic loss. -/
def HasCanonicalDyadicNarrowBroadFiniteEnvelopeL2Estimate
    (model : CanonicalDyadicFiniteEnvelopeSignedModel) : Prop :=
  ∀ N : Nat, 3 < N → ∃ c r A B : Real,
    0 < c ∧ 0 < r ∧ 0 < A ∧ 0 ≤ B ∧
    ∀ delta : Real, 0 < delta → delta < 1 / 2 →
      ∃ k0 : Nat, ∃ cost : Nat → Real,
        (∀ j, j < k0 →
          cost j ≤ A * (1 + |Real.log delta|) ^ (3 / 2 : Real)) ∧
        (∀ j, k0 ≤ j → cost j ≤ B) ∧
        ∀ f : WaveSpaceTime → Complex,
          scratch_InnerSlabCompactFrequencyTensorCore f →
          ∀ M : Nat,
            eLpNorm (model.E delta N f M) 2 volume ≤
              ENNReal.ofReal
                (∑ j ∈ Finset.range M,
                  canonicalBandlimitedDyadicCoefficient N c r j * cost j) *
                eLpNorm f 2 volume

/-- The geometric canonical coefficient sum absorbs the finite narrow block
and the broad tail uniformly in its truncation.  Thus a narrow/broad finite
envelope theorem is exactly enough for the finite-envelope premise consumed
by the density endpoint. -/
theorem hasCanonicalDyadicFiniteEnvelopeL2Estimate_of_narrowBroad
    (model : CanonicalDyadicFiniteEnvelopeSignedModel)
    (hfinite : HasCanonicalDyadicNarrowBroadFiniteEnvelopeL2Estimate model) :
    HasCanonicalDyadicFiniteEnvelopeL2Estimate model := by
  intro N hN
  obtain ⟨c, r, A, B, hc, hr, hA, hB, hscales⟩ := hfinite N hN
  let q : Real := ((2 : Real)⁻¹) ^ (N - 2)
  let Cgeo : Real := ((2 : Real) ^ N / c) * (2 / r) ^ 2
  let Cfinal : Real := (A + B) * Cgeo / (1 - q)
  have hq : q < 1 := by
    dsimp [q]
    apply pow_lt_one₀ (by positivity) (by norm_num)
    exact Nat.ne_of_gt (Nat.sub_pos_of_lt (by omega : 2 < N))
  have hCgeo : 0 < Cgeo := by
    dsimp [Cgeo]
    positivity
  have hCfinal : 0 < Cfinal := by
    dsimp [Cfinal]
    positivity
  refine ⟨Cfinal, hCfinal, ?_⟩
  intro delta hdelta hdeltaSmall
  obtain ⟨k0, cost, hnarrow, hbroad, hbound⟩ :=
    hscales delta hdelta hdeltaSmall
  let L : Real := (1 + |Real.log delta|) ^ (3 / 2 : Real)
  have hbase : 1 ≤ 1 + |Real.log delta| := by
    linarith [abs_nonneg (Real.log delta)]
  have hLone : 1 ≤ L := by
    dsimp [L]
    exact Real.one_le_rpow hbase (by norm_num)
  have hL : 0 ≤ L := (by norm_num : (0 : Real) ≤ 1).trans hLone
  intro f hf M
  have hsum :
      (∑ j ∈ Finset.range M,
        canonicalBandlimitedDyadicCoefficient N c r j * cost j) ≤
        Cfinal * L := by
    simpa only [Cfinal, Cgeo, q, L] using
      (scratch_sum_range_canonicalCoefficient_mul_cost_le
        M k0 N c r A B L (by omega) hc hr hA hB hL hLone cost
        (by simpa only [L] using hnarrow)
        hbroad)
  calc
    eLpNorm (model.E delta N f M) 2 volume ≤
        ENNReal.ofReal
          (∑ j ∈ Finset.range M,
            canonicalBandlimitedDyadicCoefficient N c r j * cost j) *
          eLpNorm f 2 volume := hbound f hf M
    _ ≤ ENNReal.ofReal (Cfinal * L) * eLpNorm f 2 volume :=
      mul_le_mul_left (ENNReal.ofReal_le_ofReal hsum) _
    _ = ENNReal.ofReal
        (Cfinal * (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
          eLpNorm f 2 volume := by
      rfl

/-- The finite-envelope Fatou limit is a valid signed-envelope model for the
literal inner-slab tensor density theorem. -/
noncomputable def CanonicalDyadicFiniteEnvelopeSignedModel.toInnerSlabModel
    (model : CanonicalDyadicFiniteEnvelopeSignedModel) :
    InnerSlabFiniteTensorSignedEnvelopeModel where
  T := model.T
  P := canonicalDyadicFiniteEnvelopeLimit model.E
  hPmeas := model.hLimitMeas
  hidentify := model.hidentify
  hTgeom := model.hTgeom
  hdom := model.hcanonicalDom

/-- Uniform finite canonical envelope bounds pass by Fatou to the limit
envelope required by the signed-core density endpoint. -/
theorem hasInnerSlabFiniteTensorSignedEnvelopeL2Estimate_of_canonicalDyadicFinite
    (model : CanonicalDyadicFiniteEnvelopeSignedModel)
    (hfinite : HasCanonicalDyadicFiniteEnvelopeL2Estimate model) :
    HasInnerSlabFiniteTensorSignedEnvelopeL2Estimate model.toInnerSlabModel := by
  intro N hN
  obtain ⟨C, hC, hbound⟩ := hfinite N hN
  refine ⟨C, hC, ?_⟩
  intro delta hdelta hdeltaSmall f hf
  exact scratch_eLpNorm_liminf_le_of_uniform
    (p := (2 : ENNReal)) (by norm_num) (by norm_num)
    (fun M => model.hEmeas delta N f M hf)
    (fun M => hbound delta hdelta hdeltaSmall f hf M)

/-- Final literal conclusion from the finite canonical dyadic envelope
estimate.  This applies the actual inner-slab compact-frequency tensor
density endpoint; no additional completion or positivity argument remains. -/
theorem hasLightRayMaximalEstimate_of_canonicalDyadicFiniteEnvelope
    (model : CanonicalDyadicFiniteEnvelopeSignedModel)
    (hfinite : HasCanonicalDyadicFiniteEnvelopeL2Estimate model) :
    HasLightRayMaximalEstimate := by
  exact hasLightRayMaximalEstimate_of_innerSlabFiniteTensorSignedEnvelope
    model.toInnerSlabModel
    (hasInnerSlabFiniteTensorSignedEnvelopeL2Estimate_of_canonicalDyadicFinite
      model hfinite)

/-- Final source-facing form: after the finite narrow radial-band/central
lowpass estimate and the broad-tail estimate are supplied in the explicit
`HasCanonicalDyadicNarrowBroadFiniteEnvelopeL2Estimate` premise, the literal
`HasLightRayMaximalEstimate` follows. -/
theorem hasLightRayMaximalEstimate_of_canonicalDyadicNarrowBroadFiniteEnvelope
    (model : CanonicalDyadicFiniteEnvelopeSignedModel)
    (hfinite : HasCanonicalDyadicNarrowBroadFiniteEnvelopeL2Estimate model) :
    HasLightRayMaximalEstimate := by
  exact hasLightRayMaximalEstimate_of_canonicalDyadicFiniteEnvelope model
