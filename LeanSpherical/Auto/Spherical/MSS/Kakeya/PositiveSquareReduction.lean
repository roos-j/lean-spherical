    {rho : Real} (hrho : 0 < rho)
    (F : WaveSpaceTime -> Real) (omega y : Euclidean 2)
    (hInt : Integrable (fun z : WaveSpaceTime =>
      scratch_canonicalBandlimitedTubePhysicalCore rho hrho
        (z.1 + z.2 • omega - y) * (F z : Complex))
        (volume.restrict (Set.univ ×ˢ lightRayTimeInterval))) :
    (∫ z : WaveSpaceTime,
      scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re) rho omega y z * F z
        ∂(volume.restrict (Set.univ ×ˢ lightRayTimeInterval))) <=
      ‖∫ z : WaveSpaceTime,
        scratch_canonicalBandlimitedTubePhysicalCore rho hrho
          (z.1 + z.2 • omega - y) * (F z : Complex)
        ∂(volume.restrict (Set.univ ×ˢ lightRayTimeInterval))‖ := by
  have hcore (z : WaveSpaceTime) :
      scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re) rho omega y z =
        (scratch_canonicalBandlimitedTubePhysicalCore rho hrho
          (z.1 + z.2 • omega - y)).re := by
    rw [scratch_canonicalBandlimitedTubePhysicalCore_re_eq hrho]
    unfold scratch_smoothTubeCore
    ring
  have hrewrite : (fun z : WaveSpaceTime =>
      scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re) rho omega y z * F z) =
      fun z =>
        (scratch_canonicalBandlimitedTubePhysicalCore rho hrho
          (z.1 + z.2 • omega - y)).re * F z := by
    funext z
    rw [hcore]
  rw [hrewrite]
  exact integral_re_mul_ofReal_le_norm_integral _ _ _ hInt

end

