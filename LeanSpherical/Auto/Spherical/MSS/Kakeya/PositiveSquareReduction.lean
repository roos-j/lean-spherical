  exact hasLightRayMaximalEstimate_of_canonicalDyadicPositiveSquareFiniteEnvelope model
    (hasCanonicalDyadicPositiveSquareFiniteEnvelopeL2Estimate_of_narrowBroad model hfinite)

end

