/-- Exact spatial Fourier representation of a compact-frequency smooth tube
band.  The time profile appears on the characteristic hyperplane
`tau = <omega, xi>`; no angular orthogonality is used. -/
theorem scratch_smoothTubeBand_eq_fourierInv
    (q : SchwartzMap (Euclidean 2) Complex)
    (hqcompact : HasCompactSupport (q : Euclidean 2 → Complex))
    (a : SchwartzMap Real Complex) (omega y : Euclidean 2) :
    scratch_smoothTubeBand q hqcompact a omega y =
      FourierTransform.fourierInv (fun xi : Euclidean 2 =>
        q xi * FourierTransform.fourier (a : Real → Complex)
          (inner Real omega xi)) y := by
  let K : Euclidean 2 → Real → Complex := fun xi t =>
    a t * ((Real.fourierChar (inner Real xi y) : Complex) *
      ((Real.fourierChar (inner Real ((-t) • omega) xi) : Complex) * q xi))
  have hprod : Integrable (fun z : Euclidean 2 × Real => q z.1 * a z.2)
      (volume.prod volume) := by
    exact q.integrable.mul_prod a.integrable
  have hK : Integrable (Function.uncurry K) (volume.prod volume) := by
    refine hprod.congr' ?_ ?_
    · have hcont : Continuous (Function.uncurry K) := by
        dsimp only [K, Function.uncurry]
        fun_prop
      exact hcont.aestronglyMeasurable
    · filter_upwards with z
      rcases z with ⟨xi, t⟩
      dsimp only [K, Function.uncurry]
      simp only [norm_mul, Circle.norm_coe]
      ring
  have hKswap : Integrable
      (Function.uncurry (fun t : Real => fun xi : Euclidean 2 => K xi t))
      (volume.prod volume) := by
    convert hK.swap using 1
    ext z
    rcases z with ⟨t, xi⟩
    rfl
  have hswap :
      (∫ t : Real, ∫ xi : Euclidean 2, K xi t) =
        ∫ xi : Euclidean 2, ∫ t : Real, K xi t :=
    integral_integral_swap hKswap
  have hleft : scratch_smoothTubeBand q hqcompact a omega y =
      ∫ t : Real, ∫ xi : Euclidean 2, K xi t := by
    unfold scratch_smoothTubeBand
    apply integral_congr_ae
    filter_upwards with t
    rw [Real.fourierInv_eq, ← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with xi
    rw [planeWaveModulatedCompactSchwartz_apply]
    dsimp only [K]
    simp only [Circle.smul_def, smul_eq_mul]
  have hinner (xi : Euclidean 2) :
      (∫ t : Real, K xi t) =
        ((Real.fourierChar (inner Real xi y) : Complex) * q xi) *
          FourierTransform.fourier (a : Real → Complex) (inner Real omega xi) := by
    rw [Real.fourier_eq, ← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with t
    dsimp only [K]
    simp only [Circle.smul_def, smul_eq_mul]
    have hphase : inner Real ((-t) • omega) xi =
        -inner Real t (inner Real omega xi) := by
      rw [inner_smul_left]
      rw [starRingEnd_apply, star_trivial, Real.inner_apply]
      ring
    rw [hphase]
    ring
  calc
    scratch_smoothTubeBand q hqcompact a omega y =
        ∫ t : Real, ∫ xi : Euclidean 2, K xi t := hleft
    _ = ∫ xi : Euclidean 2, ∫ t : Real, K xi t := hswap
    _ = ∫ xi : Euclidean 2,
        ((Real.fourierChar (inner Real xi y) : Complex) * q xi) *
          FourierTransform.fourier (a : Real → Complex)
            (inner Real omega xi) := by
      apply integral_congr_ae
      filter_upwards with xi
      exact hinner xi
    _ = FourierTransform.fourierInv (fun xi : Euclidean 2 =>
        q xi * FourierTransform.fourier (a : Real → Complex)
          (inner Real omega xi)) y := by
      rw [Real.fourierInv_eq]
      apply integral_congr_ae
      filter_upwards with xi
      simp only [Circle.smul_def, smul_eq_mul]
      ring

end

end Auto.Spherical.MSS
end
-- END ScratchSmoothTubeFourierBand

