/-- Pointwise complex norm square, retained as a complex-valued function so
it matches the signed tube input convention. -/
def pointwiseNormSquare
    {X : Type*} (f : X -> Complex) : X -> Complex :=
  f * star f

theorem pointwiseNormSquare_apply
    {X : Type*} (f : X -> Complex) (x : X) :
    pointwiseNormSquare f x = (Complex.normSq (f x) : Complex) := by
  unfold pointwiseNormSquare
  change f x * starRingEnd Complex (f x) = (Complex.normSq (f x) : Complex)
  exact Complex.mul_conj _

theorem pointwiseNormSquare_sub_eq
    {X : Type*} (u v : X -> Complex) :
    pointwiseNormSquare u - pointwiseNormSquare v =
      (u - v) * star u + v * star (u - v) := by
  funext x
  change u x * star (u x) - v x * star (v x) =
    (u x - v x) * star (u x) + v x * star (u x - v x)
  rw [star_sub]
  ring

theorem eLpNorm_mul_le_four_four_two
    {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (f g : X -> Complex)
    (hf : AEStronglyMeasurable f μ) (hg : AEStronglyMeasurable g μ) :
    eLpNorm (f * g) 2 μ ≤ eLpNorm f 4 μ * eLpNorm g 4 μ := by
  letI : ENNReal.HolderTriple (4 : ENNReal) 4 2 :=
    ENNReal.HolderTriple.of_toReal (p := 4) (q := 4) (r := 2)
      ⟨by norm_num, by norm_num, by norm_num⟩
  change eLpNorm (fun x => f x * g x) 2 μ ≤ eLpNorm f 4 μ * eLpNorm g 4 μ
  calc
    eLpNorm (fun x => f x * g x) 2 μ ≤
        (1 : ENNReal) * eLpNorm f 4 μ * eLpNorm g 4 μ := by
      simpa using
        (eLpNorm_le_eLpNorm_mul_eLpNorm_of_nnnorm
          (p := (4 : ENNReal)) (q := (4 : ENNReal)) (r := (2 : ENNReal))
          hf hg (fun x y : Complex => x * y) 1
          (Filter.Eventually.of_forall fun x => by simp))
    _ = eLpNorm f 4 μ * eLpNorm g 4 μ := by simp

/-- The square map is locally Lipschitz from `L⁴` to `L²`, in the form
needed to turn an `L⁴` approximation of a square root into an `L²`
approximation by a nonnegative square core. -/
theorem eLpNorm_pointwiseNormSquare_sub_le
    {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (u v : X -> Complex) (hu : MemLp u 4 μ) (hv : MemLp v 4 μ) :
    eLpNorm (pointwiseNormSquare u - pointwiseNormSquare v) 2 μ ≤
      eLpNorm (u - v) 4 μ * eLpNorm u 4 μ +
        eLpNorm v 4 μ * eLpNorm (u - v) 4 μ := by
  have huv : MemLp (u - v) 4 μ := hu.sub hv
  have hstaru : MemLp (star u) 4 μ := hu.star
  have hstaruv : MemLp (star (u - v)) 4 μ := huv.star
  rw [pointwiseNormSquare_sub_eq]
  calc
    eLpNorm ((u - v) * star u + v * star (u - v)) 2 μ ≤
        eLpNorm ((u - v) * star u) 2 μ +
          eLpNorm (v * star (u - v)) 2 μ :=
      eLpNorm_add_le
        (huv.aestronglyMeasurable.mul hstaru.aestronglyMeasurable)
        (hv.aestronglyMeasurable.mul hstaruv.aestronglyMeasurable)
        (by norm_num)
    _ ≤ eLpNorm (u - v) 4 μ * eLpNorm (star u) 4 μ +
          eLpNorm v 4 μ * eLpNorm (star (u - v)) 4 μ := by
      gcongr
      · exact eLpNorm_mul_le_four_four_two (u - v) (star u)
          huv.aestronglyMeasurable hstaru.aestronglyMeasurable
      · exact eLpNorm_mul_le_four_four_two v (star (u - v))
          hv.aestronglyMeasurable hstaruv.aestronglyMeasurable
    _ = eLpNorm (u - v) 4 μ * eLpNorm u 4 μ +
          eLpNorm v 4 μ * eLpNorm (u - v) 4 μ := by
      rw [eLpNorm_star, eLpNorm_star]

