  unfold canonicalTubeSignedAverage
  calc
    ‖∫ t in lightRayTimeInterval, ∫ x : canonicalAbsoluteBroadE2,
        FourierTransform.fourierInv
          (scratch_canonicalBandlimitedTubeMultiplier rho hrho :
            canonicalAbsoluteBroadE2 -> Complex)
