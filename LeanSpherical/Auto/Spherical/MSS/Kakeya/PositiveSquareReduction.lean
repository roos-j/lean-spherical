section

section Auto.Spherical.MSS

open Filter MeasureTheory FourierTransform Set
open Auto.Spherical.SurfaceMeasureDecay
open Auto.Spherical.Auxiliary
open scoped BigOperators Convolution FourierTransform EuclideanSpace

noncomputable section

/-- The time Fourier factor seen by one spatial frequency on a light ray. -/
noncomputable def scratch_tubeTimePhase
    (a : SchwartzMap Real Complex) (omega : Euclidean 2) :
    Euclidean 2 → Complex :=
  fun xi => (FourierTransform.fourier a : SchwartzMap Real Complex)
    (inner Real omega xi)

theorem scratch_tubeTimePhase_smooth
    (a : SchwartzMap Real Complex) (omega : Euclidean 2) :
    ContDiff Real (⊤ : ℕ∞) (scratch_tubeTimePhase a omega) := by
  unfold scratch_tubeTimePhase
  exact (FourierTransform.fourier a : SchwartzMap Real Complex).smooth (⊤ : ℕ∞) |>.comp
    ((innerSL Real omega).contDiff)

/-- A compact spatial-frequency tensor has a Schwartz multiplier after its
time factor is restricted to the light-ray characteristic. -/
noncomputable def scratch_tubeTensorMultiplier
    (q : SchwartzMap (Euclidean 2) Complex)
    (hqcompact : HasCompactSupport (q : Euclidean 2 → Complex))
    (a : SchwartzMap Real Complex) (omega : Euclidean 2) :
    SchwartzMap (Euclidean 2) Complex :=
  (hqcompact.mul_right).toSchwartzMap
    (q.smooth (⊤ : ℕ∞) |>.mul (scratch_tubeTimePhase_smooth a omega))

theorem scratch_tubeTensorMultiplier_apply
    (q : SchwartzMap (Euclidean 2) Complex)
    (hqcompact : HasCompactSupport (q : Euclidean 2 → Complex))
    (a : SchwartzMap Real Complex) (omega xi : Euclidean 2) :
    scratch_tubeTensorMultiplier q hqcompact a omega xi =
      q xi * (FourierTransform.fourier a : SchwartzMap Real Complex)
        (inner Real omega xi) := by
  unfold scratch_tubeTensorMultiplier
  rfl

/-- The literal compact-frequency smooth tube band is the inverse spatial
Fourier transform of its time-restricted multiplier. -/
theorem scratch_smoothTubeBand_eq_tubeTensorMultiplier_fourierInv
    (q : SchwartzMap (Euclidean 2) Complex)
    (hqcompact : HasCompactSupport (q : Euclidean 2 → Complex))
    (a : SchwartzMap Real Complex) (omega y : Euclidean 2) :
    scratch_smoothTubeBand q hqcompact a omega y =
      FourierTransform.fourierInv
        (scratch_tubeTensorMultiplier q hqcompact a omega : Euclidean 2 → Complex) y := by
  rw [scratch_smoothTubeBand_eq_fourierInv]
  simp_rw [← SchwartzMap.fourier_coe a]
  apply congrArg (fun h : Euclidean 2 → Complex => FourierTransform.fourierInv h y)
  funext xi
  exact (scratch_tubeTensorMultiplier_apply q hqcompact a omega xi).symm

/-- The generic jointly-integrable transport from `ScratchPartialFourier` is
literally the smooth tube band on one separated Schwartz tensor. -/
theorem scratch_spatialFourierTransport_tensor_eq_smoothTubeBand
    (q : SchwartzMap (Euclidean 2) Complex)
    (hqcompact : HasCompactSupport (q : Euclidean 2 → Complex))
    (a : SchwartzMap Real Complex) (omega y : Euclidean 2) :
    scratch_spatialFourierTransport (fun xi t => q xi * a t) omega y =
      scratch_smoothTubeBand q hqcompact a omega y := by
  rw [scratch_smoothTubeBand_eq_translated]
  unfold scratch_spatialFourierTransport
  apply integral_congr_ae
  filter_upwards with t
  rw [Real.fourierInv_eq]
  have hqinv := Real.fourierInv_eq (q : Euclidean 2 → Complex) (y - t • omega)
  rw [hqinv, ← integral_const_mul]
  apply integral_congr_ae
  filter_upwards with xi
  simp only [Circle.smul_def, smul_eq_mul]
  ring

/-- A finite tensor model for a smooth light-ray tube operator.  Writing it
as a finite sum preserves all cross terms for the subsequent time TT* step. -/
noncomputable def scratch_finiteTensorTubeBand
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex) (omega : Euclidean 2) :
    Euclidean 2 → Complex :=
  fun y => ∑ i ∈ s, scratch_smoothTubeBand (q i) (hqcompact i) (a i) omega y

noncomputable def scratch_finiteTensorTubeMultiplier
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex) (omega : Euclidean 2) :
    SchwartzMap (Euclidean 2) Complex :=
  ∑ i ∈ s, scratch_tubeTensorMultiplier (q i) (hqcompact i) (a i) omega

private theorem scratch_finset_sum_schwartz_apply
    {ι : Type*} [DecidableEq ι] (s : Finset ι)
    (F : ι → SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    (∑ i ∈ s, F i) x = ∑ i ∈ s, F i x := by
  induction s using Finset.induction_on with
  | empty => rfl
  | insert b s hb ih =>
      rw [Finset.sum_insert hb, Finset.sum_insert hb]
      change (F b + ∑ i ∈ s, F i) x = F b x + ∑ i ∈ s, F i x
      change F b x + (∑ i ∈ s, F i) x = F b x + ∑ i ∈ s, F i x
      rw [ih]

/-- Exact finite-tensor spatial Fourier representation. -/
theorem scratch_finiteTensorTubeBand_eq_fourierInv
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex) (omega y : Euclidean 2) :
    scratch_finiteTensorTubeBand s q hqcompact a omega y =
      FourierTransform.fourierInv
        (scratch_finiteTensorTubeMultiplier s q hqcompact a omega : Euclidean 2 → Complex) y := by
  classical
  unfold scratch_finiteTensorTubeBand scratch_finiteTensorTubeMultiplier
  rw [← SchwartzMap.fourierInv_coe, FourierTransform.fourierInv_sum]
  rw [scratch_finset_sum_schwartz_apply]
  apply Finset.sum_congr rfl
  intro i hi
  simpa only [SchwartzMap.fourierInv_coe] using
    (scratch_smoothTubeBand_eq_tubeTensorMultiplier_fourierInv
      (q i) (hqcompact i) (a i) omega y)

theorem scratch_finiteTensorTubeMultiplier_apply
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex) (omega xi : Euclidean 2) :
    scratch_finiteTensorTubeMultiplier s q hqcompact a omega xi =
      ∑ i ∈ s, q i xi * (FourierTransform.fourier (a i) : SchwartzMap Real Complex)
        (inner Real omega xi) := by
  classical
  unfold scratch_finiteTensorTubeMultiplier
  rw [scratch_finset_sum_schwartz_apply]
  apply Finset.sum_congr rfl
  intro i hi
  exact scratch_tubeTensorMultiplier_apply (q i) (hqcompact i) (a i) omega xi

/-- Full spatial Plancherel identity for a finite tensor tube operator.
Cross terms remain inside the square on the right: this is exactly the
frequency-side input for the time TT* / angular-shell argument. -/
theorem scratch_integral_norm_sq_finiteTensorTubeBand_eq_frequency
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex) (omega : Euclidean 2) :
    (∫ y : Euclidean 2, ‖scratch_finiteTensorTubeBand s q hqcompact a omega y‖ ^ (2 : Nat)) =
      ∫ xi : Euclidean 2,
        ‖∑ i ∈ s, q i xi * (FourierTransform.fourier (a i) : SchwartzMap Real Complex)
          (inner Real omega xi)‖ ^ (2 : Nat) := by
  let M : SchwartzMap (Euclidean 2) Complex :=
    scratch_finiteTensorTubeMultiplier s q hqcompact a omega
  have h := Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq
    (FourierTransform.fourierInv M)
  have hplanch :
      (∫ y : Euclidean 2,
        ‖FourierTransform.fourierInv (M : Euclidean 2 → Complex) y‖ ^ (2 : Nat)) =
        ∫ xi : Euclidean 2, ‖M xi‖ ^ (2 : Nat) := by
    rw [← SchwartzMap.fourier_coe,
      FourierTransform.fourier_fourierInv_eq] at h
    simpa only [SchwartzMap.fourierInv_coe] using h.symm
  calc
    (∫ y : Euclidean 2, ‖scratch_finiteTensorTubeBand s q hqcompact a omega y‖ ^ (2 : Nat)) =
        ∫ y : Euclidean 2,
          ‖FourierTransform.fourierInv (M : Euclidean 2 → Complex) y‖ ^ (2 : Nat) := by
          apply integral_congr_ae
          filter_upwards with y
          rw [← scratch_finiteTensorTubeBand_eq_fourierInv]
    _ = ∫ xi : Euclidean 2, ‖M xi‖ ^ (2 : Nat) := hplanch
    _ = ∫ xi : Euclidean 2,
        ‖∑ i ∈ s, q i xi * (FourierTransform.fourier (a i) : SchwartzMap Real Complex)
          (inner Real omega xi)‖ ^ (2 : Nat) := by
      apply integral_congr_ae
      filter_upwards with xi
      exact congrArg (fun z : Complex => ‖z‖ ^ (2 : Nat))
        (scratch_finiteTensorTubeMultiplier_apply s q hqcompact a omega xi)

end

end Auto.Spherical.MSS
end
-- END ScratchKakeyaFiniteTensorWrapper

