abbrev schwartzSquareCoreDensityE2 := Euclidean 2

/-- A finite inner-slab tensor with merely Schwartz spatial frequency
profiles.  This is the density-safe core: the canonical tube multiplier,
not the datum, supplies compact frequency support to every later FIO slice. -/
def InnerSlabSchwartzTensorCore
    (f : WaveSpaceTime -> Complex) : Prop :=
  ∃ (ι : Type) (_ : Fintype ι)
    (q : ι -> SchwartzMap schwartzSquareCoreDensityE2 Complex)
    (a : ι -> SchwartzMap Real Complex) (r : Real),
    0 < r ∧ r < 1 ∧
    (∀ i, Function.support (a i : Real -> Complex) ⊆
      Metric.closedBall (3 / 2 : Real) r) ∧
    f = scratch_innerSlabCompactFrequencyTensor q a

/-- Passing to the physical norm square turns the signed Schwartz tensor
core into the positive square core used by the canonical-kernel majorization. -/
theorem pointwiseNormSquare_mem_nonnegativeSquareInnerSlabSchwartzTensorCore
    {u : WaveSpaceTime -> Complex}
    (hu : InnerSlabSchwartzTensorCore u) :
    NonnegativeSquareInnerSlabSchwartzTensorCore (pointwiseNormSquare u) := by
  rcases hu with ⟨ι, hι, q, a, r, hrpos, hrlt, ha, hu⟩
  letI : Fintype ι := hι
  refine ⟨ι, inferInstance, q, a, r, hrpos, hrlt, ha, ?_⟩
  funext z
  rw [pointwiseNormSquare_apply,
    hu]
  rfl

/-- The pointwise norm square maps `L⁴` inputs to `L²` inputs. -/
theorem memLp_two_pointwiseNormSquare
    {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (u : X → Complex) (hu : MemLp u 4 μ) :
    MemLp (pointwiseNormSquare u) 2 μ := by
  refine ⟨?_, ?_⟩
  · unfold pointwiseNormSquare
    exact hu.aestronglyMeasurable.mul hu.star.aestronglyMeasurable
  · unfold pointwiseNormSquare
    calc
      eLpNorm (u * star u) 2 μ ≤ eLpNorm u 4 μ * eLpNorm (star u) 4 μ :=
        eLpNorm_mul_le_four_four_two u (star u)
          hu.aestronglyMeasurable hu.star.aestronglyMeasurable
      _ = eLpNorm u 4 μ * eLpNorm u 4 μ := by rw [eLpNorm_star]
      _ < ⊤ := ENNReal.mul_lt_top
        (lt_top_iff_ne_top.mpr hu.eLpNorm_ne_top)
        (lt_top_iff_ne_top.mpr hu.eLpNorm_ne_top)

/-- A positive square core is also an admissible signed Schwartz tensor after
retaining every off-diagonal physical product.  Unlike the old version, no
compactness assumption on the original spatial profiles occurs here. -/
theorem nonnegativeSquareInnerSlabSchwartzTensorCore_to_signedCore
    {f : WaveSpaceTime → Complex}
    (hf : NonnegativeSquareInnerSlabSchwartzTensorCore f) :
    InnerSlabSchwartzTensorCore f := by
  rcases hf with ⟨ι, hι, q, a, r, hrpos, hrlt, ha, rfl⟩
  letI : Fintype ι := hι
  refine ⟨ι × ι, inferInstance,
    (fun ij : ι × ι => crossFrequencyMultiplier (q ij.1) (q ij.2)),
    (fun ij : ι × ι => timeCrossProduct (a ij.1) (a ij.2)),
    r, hrpos, hrlt, ?_, ?_⟩
  · intro ij
    exact (support_timeCrossProduct_subset_left (a ij.1) (a ij.2)).trans (ha ij.1)
  · rw [nonnegativeSquareInnerSlabTensor_eq_reassembled]
    rfl

/-- A finite smooth physical tensor is literally a Schwartz-frequency tensor
after Fourier transforming each spatial factor and packaging its time factor
as a Schwartz map. -/
theorem smoothSpatialTensor_eq_innerSlabSchwartzTensor
    {ι : Type} [Fintype ι]
    (U : ι -> schwartzSquareCoreDensityE2 -> Complex) (a : ι -> Real -> Complex)
    (hUcompact : ∀ i, HasCompactSupport (U i))
    (hUsmooth : ∀ i, ContDiff Real ∞ (U i))
    (hacompact : ∀ i, HasCompactSupport (a i))
    (hasmooth : ∀ i, ContDiff Real ∞ (a i)) :
    smoothSpatialTensor U a =
      scratch_innerSlabCompactFrequencyTensor
        (fun i => FourierTransform.fourier
          ((hUcompact i).toSchwartzMap (hUsmooth i)))
        (fun i => (hacompact i).toSchwartzMap (hasmooth i)) := by
  funext z
  simp only [smoothSpatialTensor,
    scratch_innerSlabCompactFrequencyTensor]
  apply Finset.sum_congr rfl
  intro i hi
  rw [FourierTransform.fourierInv_fourier_eq]
  rfl

/-- The preceding equality also gives the exact strict-inner-slab core
membership. -/
theorem smoothSpatialTensor_mem_innerSlabSchwartzTensorCore
    {ι : Type} [Fintype ι]
    (U : ι -> schwartzSquareCoreDensityE2 -> Complex) (a : ι -> Real -> Complex) (r : Real)
    (hUcompact : ∀ i, HasCompactSupport (U i))
    (hUsmooth : ∀ i, ContDiff Real ∞ (U i))
    (hacompact : ∀ i, HasCompactSupport (a i))
    (hasmooth : ∀ i, ContDiff Real ∞ (a i))
    (hrpos : 0 < r) (hrlt : r < 1)
    (hasupport : ∀ i, Function.support (a i) ⊆
      Metric.closedBall (3 / 2 : Real) r) :
    InnerSlabSchwartzTensorCore (smoothSpatialTensor U a) := by
  refine ⟨ι, inferInstance,
    (fun i => FourierTransform.fourier
      ((hUcompact i).toSchwartzMap (hUsmooth i))),
    (fun i => (hacompact i).toSchwartzMap (hasmooth i)), r,
    hrpos, hrlt, ?_, ?_⟩
  · intro i
    change Function.support (a i) ⊆ Metric.closedBall (3 / 2 : Real) r
    exact hasupport i
  · exact smoothSpatialTensor_eq_innerSlabSchwartzTensor U a
      hUcompact hUsmooth hacompact hasmooth

/-- Nonnegative inner-slab data are `L²`-dense in squares of finite
Schwartz-frequency tensors.  The spatial factors here need not be compactly
frequency-supported: a later canonical multiplier makes every actual tube
profile compact. -/
theorem hasPositiveSlabL2DenseCore_nonnegativeSquareInnerSlabSchwartzTensor :
    HasPositiveSlabL2DenseCore NonnegativeSquareInnerSlabSchwartzTensorCore := by
  intro h hh epsilon hepsilon
  let v : WaveSpaceTime → Complex := positiveSlabSquareRoot h
  have hv : MemLp v 4 volume := by
    dsimp only [v]
    exact positiveSlabSquareRoot_memLp_four h hh
  have hvzero : ∀ z : WaveSpaceTime,
      z ∈ outsideTimeSlab → v z = 0 := by
    intro z hz
    dsimp only [v, positiveSlabSquareRoot, positiveSlabDatum]
    simp only [outsideTimeSlab, Set.mem_setOf_eq] at hz
    simp [scratch_lightRayTimeRestriction, hz]
  let D : ENNReal := 1 + 2 * eLpNorm v 4 volume
  have hDtop : D ≠ ⊤ := by
    dsimp only [D]
    rw [ENNReal.add_ne_top]
    constructor
    · norm_num
    · exact ENNReal.mul_ne_top (by norm_num) hv.eLpNorm_ne_top
  obtain ⟨b, hbpos, hbudget⟩ :=
    exists_positive_real_budgets
      (fun _ : Unit => D) (fun _ => hDtop) hepsilon
  have hbudget' : ENNReal.ofReal (b ()) * D < ENNReal.ofReal epsilon := by
    simpa using hbudget
  let eta : Real := min (b ()) (1 / 2)
  have hetapos : 0 < eta := by
    dsimp only [eta]
    exact lt_min (hbpos ()) (by norm_num)
  obtain ⟨ι, hι, U, a, r, hrpos, hrlt, hU, ha, hu, huerr⟩ :=
    exists_smoothSeparated_innerSlabTensor_near_slabSupported_four
