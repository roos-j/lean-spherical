section Auto.Spherical.MSS

open Filter MeasureTheory Set FourierTransform
open Auto.Spherical.SurfaceMeasureDecay
open scoped BigOperators ENNReal EuclideanSpace FourierTransform

noncomputable section

abbrev canonicalReflectedSquareUnitE2 := Euclidean 2

/-- A convenient total extension of the raw positive tube average to a
complex-valued input.  On the positive square cores used below its norm is
the intended positive integral; on the density target it is definitionally
the literal light-ray average after the slab restriction. -/
noncomputable def positiveNormLightRayLinear
    (delta : Real) (N : Nat) (f : WaveSpaceTime → Complex)
    (omega y : canonicalReflectedSquareUnitE2) : Complex :=
  (lightRayAverage delta N omega y f : Complex)

/-- The literal direction set for every finite canonical scale envelope.
Using the subtype is important: neither the physical maximal operator nor
the finite signed estimate is meant to range over all of `E²`. -/
noncomputable def canonicalReflectedUnitScaleEnvelope
    (S : Real → Nat → (WaveSpaceTime → Complex) → Nat → canonicalReflectedSquareUnitE2 → canonicalReflectedSquareUnitE2 → Complex)
    (delta : Real) (N : Nat) (f : WaveSpaceTime → Complex) (j : Nat) :
    canonicalReflectedSquareUnitE2 → ENNReal :=
  fun y => ⨆ omega : aux_lightRayDirection,
    ENNReal.ofReal ‖S delta N f j omega.1 y‖

/-- Coefficient-weighted finite partial envelope, with the same literal
unit-direction supremum at every dyadic scale. -/
noncomputable def canonicalReflectedUnitFiniteEnvelope
    (c r : Real)
    (S : Real → Nat → (WaveSpaceTime → Complex) → Nat → canonicalReflectedSquareUnitE2 → canonicalReflectedSquareUnitE2 → Complex)
    (delta : Real) (N : Nat) (f : WaveSpaceTime → Complex) (M : Nat) :
    canonicalReflectedSquareUnitE2 → ENNReal :=
  fun y => ∑ j ∈ Finset.range M,
    ENNReal.ofReal
      (canonicalBandlimitedDyadicCoefficient N c r j) *
      canonicalReflectedUnitScaleEnvelope S delta N f j y

/-- Fatou limit of the literal unit-direction finite envelopes. -/
noncomputable def canonicalReflectedUnitFiniteEnvelopeLimit
    (c r : Real)
    (S : Real → Nat → (WaveSpaceTime → Complex) → Nat → canonicalReflectedSquareUnitE2 → canonicalReflectedSquareUnitE2 → Complex)
    (delta : Real) (N : Nat) (f : WaveSpaceTime → Complex) : canonicalReflectedSquareUnitE2 → ENNReal :=
  fun y => atTop.liminf
    (fun M => canonicalReflectedUnitFiniteEnvelope c r S delta N f M y)

/-- Positive `ENNReal` kernel used for the `j`th canonical term.  Its
direction argument is the literal unit-direction subtype. -/
noncomputable def canonicalReflectedSquareDyadicKernel
    (c r delta : Real) (N j : Nat)
    (omega : aux_lightRayDirection) (y : canonicalReflectedSquareUnitE2) (z : WaveSpaceTime) : ENNReal :=
  ENNReal.ofReal
    (canonicalBandlimitedDyadicCoefficient N c r j *
      scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
        (delta / canonicalBandlimitedDyadicScale r j) omega.1 y z)

/-- The nonnegative input placed beside every positive canonical kernel. -/
noncomputable def canonicalSquareInput
    (f : WaveSpaceTime → Complex) : WaveSpaceTime → ENNReal :=
  fun z => ENNReal.ofReal ‖f z‖

/-- The total positive extension has the exact target identification.  The
only observation is that the restriction is identically one on the very
time interval over which `lightRayAverage` integrates. -/
theorem positiveNormLightRayLinear_identify
    (delta : Real) (N : Nat) (h : WaveSpaceTime → Complex)
    (omega y : canonicalReflectedSquareUnitE2) :
    positiveNormLightRayLinear delta N
        (scratch_lightRayTimeRestriction (fun z => (‖h z‖ : Complex))) omega y =
      (lightRayAverage delta N omega y h : Complex) := by
  unfold positiveNormLightRayLinear lightRayAverage
  congr 1
  apply integral_congr_ae
  filter_upwards [ae_restrict_mem (by
    unfold lightRayTimeInterval
    exact measurableSet_Icc)] with t ht
  apply integral_congr_ae
  filter_upwards with x
  simp [scratch_lightRayTimeRestriction, ht]

/-- Unit-direction version of the signed Fatou bridge.  The maximizer used
by the literal `lightRayMaximal` lies in `unitLightRayDirections`, so a
finite-envelope domination need not (and analytically should not) control
all of `E²`. -/
theorem scratch_lightRayMaximal_ofReal_le_liminf_of_signedCore_unitDom
    {delta : Real} (hdelta : 0 < delta) (N : Nat) (hN : 1 < N)
    (g : WaveSpaceTime → Complex) (hg : MemLp g 2 volume)
    (F : WaveSpaceTime → Complex)
    (T : (WaveSpaceTime → Complex) → canonicalReflectedSquareUnitE2 → canonicalReflectedSquareUnitE2 → Complex)
    (P : (WaveSpaceTime → Complex) → canonicalReflectedSquareUnitE2 → ENNReal)
    (core : Nat → WaveSpaceTime → Complex)
    (hidentify : ∀ omega y,
      T F omega y = (lightRayAverage delta N omega y g : Complex))
    (hconv : ∀ omega y,
      Tendsto (fun n => T (core n) omega y) atTop (nhds (T F omega y)))
    (hdom : ∀ n omega, omega ∈ unitLightRayDirections → ∀ y,
      ENNReal.ofReal ‖T (core n) omega y‖ ≤ P (core n) y)
    (y : canonicalReflectedSquareUnitE2) :
    ENNReal.ofReal (lightRayMaximal delta N g y) ≤
      atTop.liminf (fun n => P (core n) y) := by
  obtain ⟨omega, homega, hmax⟩ :=
    aux_exists_lightRayPointwiseMaximizer_of_continuity delta N g
      (aux_hasContinuousLightRayDirections_of_memLp hdelta N hN g hg) y
  have hnormconv : Tendsto (fun n => ENNReal.ofReal
      ‖T (core n) omega y‖) atTop
      (nhds (ENNReal.ofReal ‖T F omega y‖)) := by
    exact ENNReal.tendsto_ofReal ((hconv omega y).norm)
  have htarget : ENNReal.ofReal (lightRayAverage delta N omega y g) =
      ENNReal.ofReal ‖T F omega y‖ := by
    rw [hidentify omega y]
    rw [Complex.norm_real, Real.norm_of_nonneg
      (aux_lightRayAverage_nonneg hdelta N omega y g)]
  calc
    ENNReal.ofReal (lightRayMaximal delta N g y) =
        ENNReal.ofReal (lightRayAverage delta N omega y g) := by rw [hmax]
    _ = ENNReal.ofReal ‖T F omega y‖ := htarget
    _ = atTop.liminf (fun n => ENNReal.ofReal
        ‖T (core n) omega y‖) := hnormconv.liminf_eq.symm
    _ ≤ atTop.liminf (fun n => P (core n) y) := by
      refine Filter.liminf_le_liminf ?_ (by isBoundedDefault) (by isBoundedDefault)
      filter_upwards with n
      exact hdom n omega homega y

/-- The literal slab measure used by the light-ray average is the product
restriction used by the canonical linear Re bridge. -/
theorem scratchLightRayMeasure_eq_volume_restrict_slab :
    scratchLightRayMeasure =
      (volume : Measure WaveSpaceTime).restrict
        (Set.univ ×ˢ lightRayTimeInterval) := by
  unfold scratchLightRayMeasure
  change (volume : Measure canonicalReflectedSquareUnitE2).prod
      ((volume : Measure Real).restrict lightRayTimeInterval) =
    ((volume : Measure canonicalReflectedSquareUnitE2).prod (volume : Measure Real)).restrict
      (Set.univ ×ˢ lightRayTimeInterval)
  rw [← Measure.prod_restrict]
  simp

/-- The strict inner time ball appearing in the tensor core lies in the
literal light-ray time slab. -/
theorem timeClosedBall_subset_lightRayTimeInterval {r : Real} (hr : r < 1) :
    Metric.closedBall (3 / 2 : Real) r ⊆ lightRayTimeInterval := by
  intro t ht
  change dist t (3 / 2 : Real) ≤ r at ht
  have hdist : dist t (3 / 2 : Real) < 1 := lt_of_le_of_lt ht hr
  change (1 / 2 : Real) ≤ t ∧ t ≤ 5 / 2
  rw [Real.dist_eq] at hdist
  constructor <;> linarith [abs_lt.mp hdist]

/-- A finite inner-slab tensor vanishes pointwise off the literal time
slab.  This is the exact support fact needed to replace its restricted
canonical average by the full Schwartz/Fourier tube field. -/
theorem scratch_innerSlabCompactFrequencyTensor_eq_zero_of_time_not_mem
    {ι : Type*} [Fintype ι]
    (q : ι → SchwartzMap canonicalReflectedSquareUnitE2 Complex) (a : ι → SchwartzMap Real Complex)
    {r : Real} (hr : r < 1)
    (ha : ∀ i, Function.support (a i : Real → Complex) ⊆
      Metric.closedBall (3 / 2 : Real) r)
    (x : canonicalReflectedSquareUnitE2) (t : Real) (ht : t ∉ lightRayTimeInterval) :
    scratch_innerSlabCompactFrequencyTensor q a (x, t) = 0 := by
  have ha_zero : ∀ i, (a i : Real → Complex) t = 0 := by
    intro i
    by_contra hne
    have hsupport : t ∈ Function.support (a i : Real → Complex) :=
      Function.mem_support.mpr hne
    exact ht (timeClosedBall_subset_lightRayTimeInterval hr (ha i hsupport))
  unfold scratch_innerSlabCompactFrequencyTensor
  apply Finset.sum_eq_zero
  intro i hi
  rw [ha_zero i, mul_zero]

/-- The nonnegative norm-square core has the same strict slab support. -/
theorem nonnegativeSquareInnerSlabTensor_eq_zero_of_time_not_mem
    {ι : Type*} [Fintype ι]
    (q : ι → SchwartzMap canonicalReflectedSquareUnitE2 Complex) (a : ι → SchwartzMap Real Complex)
    {r : Real} (hr : r < 1)
    (ha : ∀ i, Function.support (a i : Real → Complex) ⊆
      Metric.closedBall (3 / 2 : Real) r)
    (x : canonicalReflectedSquareUnitE2) (t : Real) (ht : t ∉ lightRayTimeInterval) :
    nonnegativeSquareInnerSlabTensor q a (x, t) = 0 := by
  rw [nonnegativeSquareInnerSlabTensor_eq_ofReal_normSq]
  simp [scratch_innerSlabCompactFrequencyTensor_eq_zero_of_time_not_mem
    q a hr ha x t ht]

/-- The complex-valued square core is literally a nonnegative real number at
every point, so its complex norm is its real part. -/
theorem norm_nonnegativeSquareInnerSlabTensor_eq_re
    {ι : Type*} [Fintype ι]
    (q : ι → SchwartzMap canonicalReflectedSquareUnitE2 Complex) (a : ι → SchwartzMap Real Complex)
    (z : WaveSpaceTime) :
    ‖nonnegativeSquareInnerSlabTensor q a z‖ =
      (nonnegativeSquareInnerSlabTensor q a z).re := by
  rw [nonnegativeSquareInnerSlabTensor_eq_ofReal_normSq]
  simp [Complex.normSq_nonneg]

/-- For a strict-inner-slab square tensor, the literal restricted canonical
linear average is *exactly* its full Schwartz/Fourier tube integral.  The
proof does not silently discard the time restriction: it swaps the product
integral under the restricted measure and then uses the pointwise zero
outside the slab. -/
theorem canonicalTubeSquareAverage_restrict_eq_full
    {ι : Type*} [Fintype ι]
    (m : SchwartzMap canonicalReflectedSquareUnitE2 Complex)
    (q : ι → SchwartzMap canonicalReflectedSquareUnitE2 Complex) (a : ι → SchwartzMap Real Complex)
    {r : Real} (hr : r < 1)
    (ha : ∀ i, Function.support (a i : Real → Complex) ⊆
      Metric.closedBall (3 / 2 : Real) r)
    (omega y : canonicalReflectedSquareUnitE2)
    (hfull : Integrable (fun z : WaveSpaceTime =>
      (FourierTransform.fourierInv m : canonicalReflectedSquareUnitE2 → Complex)
        (z.1 + z.2 • omega - y) * nonnegativeSquareInnerSlabTensor q a z)
      volume) :
    (∫ z : WaveSpaceTime,
      (FourierTransform.fourierInv m : canonicalReflectedSquareUnitE2 → Complex)
        (z.1 + z.2 • omega - y) * nonnegativeSquareInnerSlabTensor q a z
        ∂scratchLightRayMeasure) =
      canonicalTubeSquareAverage m q a omega y := by
  let F : WaveSpaceTime → Complex := fun z =>
    (FourierTransform.fourierInv m : canonicalReflectedSquareUnitE2 → Complex)
      (z.1 + z.2 • omega - y) * nonnegativeSquareInnerSlabTensor q a z
  have hrestrict : Integrable F scratchLightRayMeasure :=
    hfull.mono_measure scratchLightRayMeasure_le_volume
  let H : Real → Complex := fun t => ∫ x : canonicalReflectedSquareUnitE2, F (x, t)
  have hHzero : ∀ t : Real, t ∉ lightRayTimeInterval → H t = 0 := by
    intro t ht
    dsimp only [H]
    rw [← integral_zero canonicalReflectedSquareUnitE2 Complex]
    apply integral_congr_ae
    filter_upwards with x
    dsimp only [F]
    rw [show nonnegativeSquareInnerSlabTensor q a (x, t) = 0 by
      exact nonnegativeSquareInnerSlabTensor_eq_zero_of_time_not_mem
        q a hr ha x t ht]
    ring
  have hindicator : lightRayTimeInterval.indicator H = H := by
    funext t
    by_cases ht : t ∈ lightRayTimeInterval
    · simp [ht]
    · simp [ht, hHzero t ht]
  have htime : (∫ t : Real in lightRayTimeInterval, H t) = ∫ t : Real, H t := by
    calc
      (∫ t : Real in lightRayTimeInterval, H t) =
          ∫ t : Real, lightRayTimeInterval.indicator H t :=
        (integral_indicator (by
          unfold lightRayTimeInterval
          exact measurableSet_Icc)).symm
      _ = ∫ t : Real, H t := by rw [hindicator]
  change (∫ z : WaveSpaceTime, F z ∂scratchLightRayMeasure) = _
  calc
    (∫ z : WaveSpaceTime, F z ∂scratchLightRayMeasure) =
        ∫ x : canonicalReflectedSquareUnitE2, ∫ t : Real in lightRayTimeInterval, F (x, t) := by
      simpa only [scratchLightRayMeasure] using
        (integral_prod F hrestrict)
    _ = ∫ t : Real in lightRayTimeInterval, ∫ x : canonicalReflectedSquareUnitE2, F (x, t) := by
      simpa only using (integral_integral_swap hrestrict)
    _ = ∫ t : Real in lightRayTimeInterval, H t := by rfl
    _ = ∫ t : Real, H t := htime
    _ = canonicalTubeSquareAverage m q a omega y := by
      simp only [H, F, canonicalTubeSquareAverage, SchwartzMap.fourierInv_coe]

/-- The literal slab-restricted canonical convolution of a positive square
core is the reflected signed finite-tensor tube field.  The reflection is
kept explicit through `reflectedSchwartzSquareTubeBand`; no evenness of the
canonical multiplier is used. -/
theorem canonicalTubeSquareAverage_restrict_eq_reflectedSchwartzSquareTubeBand
    {ι : Type} [Fintype ι]
    (m : SchwartzMap canonicalReflectedSquareUnitE2 Complex) (hm : HasCompactSupport (m : canonicalReflectedSquareUnitE2 → Complex))
    (q : ι → SchwartzMap canonicalReflectedSquareUnitE2 Complex) (a : ι → SchwartzMap Real Complex)
    {r : Real} (hr : r < 1)
    (ha : ∀ i, Function.support (a i : Real → Complex) ⊆
      Metric.closedBall (3 / 2 : Real) r)
    (omega y : canonicalReflectedSquareUnitE2)
    (hfull : Integrable (fun z : WaveSpaceTime =>
      (FourierTransform.fourierInv m : canonicalReflectedSquareUnitE2 → Complex)
        (z.1 + z.2 • omega - y) * nonnegativeSquareInnerSlabTensor q a z)
      volume)
    (hinner : ∀ (t : Real) (ij : ι × ι), Integrable (fun x : canonicalReflectedSquareUnitE2 =>
      timeCrossProduct (a ij.1) (a ij.2) t *
        (((FourierTransform.fourierInv m : SchwartzMap canonicalReflectedSquareUnitE2 Complex) : canonicalReflectedSquareUnitE2 → Complex)
          (x + t • omega - y) *
          ((FourierTransform.fourierInv
            (crossFrequencyMultiplier (q ij.1) (q ij.2) : SchwartzMap canonicalReflectedSquareUnitE2 Complex) :
              SchwartzMap canonicalReflectedSquareUnitE2 Complex) : canonicalReflectedSquareUnitE2 → Complex) x)) volume)
    (houter : ∀ ij : ι × ι, Integrable (fun t : Real =>
      ∫ x : canonicalReflectedSquareUnitE2,
        timeCrossProduct (a ij.1) (a ij.2) t *
          (((FourierTransform.fourierInv m : SchwartzMap canonicalReflectedSquareUnitE2 Complex) : canonicalReflectedSquareUnitE2 → Complex)
            (x + t • omega - y) *
            ((FourierTransform.fourierInv
              (crossFrequencyMultiplier (q ij.1) (q ij.2) : SchwartzMap canonicalReflectedSquareUnitE2 Complex) :
                SchwartzMap canonicalReflectedSquareUnitE2 Complex) : canonicalReflectedSquareUnitE2 → Complex) x)) volume) :
    (∫ z : WaveSpaceTime,
      (FourierTransform.fourierInv m : canonicalReflectedSquareUnitE2 → Complex)
        (z.1 + z.2 • omega - y) * nonnegativeSquareInnerSlabTensor q a z
        ∂scratchLightRayMeasure) =
      reflectedSchwartzSquareTubeBand m hm q a omega y := by
  calc
    (∫ z : WaveSpaceTime,
      (FourierTransform.fourierInv m : canonicalReflectedSquareUnitE2 → Complex)
        (z.1 + z.2 • omega - y) * nonnegativeSquareInnerSlabTensor q a z
        ∂scratchLightRayMeasure) =
        canonicalTubeSquareAverage m q a omega y :=
      canonicalTubeSquareAverage_restrict_eq_full m q a hr ha omega y hfull
    _ = reflectedSchwartzSquareTubeBand m hm q a omega y := by
      apply canonicalTubeSquareAverage_eq_reflectedSchwartzSquareTubeBand
      · exact hinner
      · exact houter

/-- One canonical scale of a nonnegative finite square core is controlled by
the norm of its reflected signed tube field.  This is the exact `hpiece`
input before multiplying by the dyadic coefficient. -/
theorem canonicalPositiveSquareScaleAverage_le_norm_reflected
    {ι : Type} [Fintype ι]
    {rho : Real} (hrho : 0 < rho)
    (q : ι → SchwartzMap canonicalReflectedSquareUnitE2 Complex) (a : ι → SchwartzMap Real Complex)
    {r : Real} (hr : r < 1)
    (ha : ∀ i, Function.support (a i : Real → Complex) ⊆
      Metric.closedBall (3 / 2 : Real) r)
    (omega y : canonicalReflectedSquareUnitE2)
    (hfull : Integrable (fun z : WaveSpaceTime =>
      (FourierTransform.fourierInv
        (scratch_canonicalBandlimitedTubeMultiplier rho hrho) : canonicalReflectedSquareUnitE2 → Complex)
        (z.1 + z.2 • omega - y) * nonnegativeSquareInnerSlabTensor q a z)
      volume)
    (hinner : ∀ (t : Real) (ij : ι × ι), Integrable (fun x : canonicalReflectedSquareUnitE2 =>
      timeCrossProduct (a ij.1) (a ij.2) t *
        (((FourierTransform.fourierInv
          (scratch_canonicalBandlimitedTubeMultiplier rho hrho) :
            SchwartzMap canonicalReflectedSquareUnitE2 Complex) : canonicalReflectedSquareUnitE2 → Complex)
          (x + t • omega - y) *
          ((FourierTransform.fourierInv
            (crossFrequencyMultiplier (q ij.1) (q ij.2) : SchwartzMap canonicalReflectedSquareUnitE2 Complex) :
              SchwartzMap canonicalReflectedSquareUnitE2 Complex) : canonicalReflectedSquareUnitE2 → Complex) x)) volume)
    (houter : ∀ ij : ι × ι, Integrable (fun t : Real =>
      ∫ x : canonicalReflectedSquareUnitE2,
        timeCrossProduct (a ij.1) (a ij.2) t *
          (((FourierTransform.fourierInv
            (scratch_canonicalBandlimitedTubeMultiplier rho hrho) :
              SchwartzMap canonicalReflectedSquareUnitE2 Complex) : canonicalReflectedSquareUnitE2 → Complex)
            (x + t • omega - y) *
            ((FourierTransform.fourierInv
              (crossFrequencyMultiplier (q ij.1) (q ij.2) : SchwartzMap canonicalReflectedSquareUnitE2 Complex) :
                SchwartzMap canonicalReflectedSquareUnitE2 Complex) : canonicalReflectedSquareUnitE2 → Complex) x)) volume) :
    (∫ z : WaveSpaceTime,
      scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
        rho omega y z * (nonnegativeSquareInnerSlabTensor q a z).re
        ∂scratchLightRayMeasure) ≤
      ‖reflectedSchwartzSquareTubeBand
        (scratch_canonicalBandlimitedTubeMultiplier rho hrho)
        (hasCompactSupport_scratch_canonicalBandlimitedTubeMultiplier hrho)
        q a omega y‖ := by
  let m := scratch_canonicalBandlimitedTubeMultiplier rho hrho
  let F : WaveSpaceTime → Real := fun z =>
    (nonnegativeSquareInnerSlabTensor q a z).re
  have hFcomplex : ∀ z : WaveSpaceTime,
      (F z : Complex) = nonnegativeSquareInnerSlabTensor q a z := by
    intro z
    dsimp only [F]
    rw [nonnegativeSquareInnerSlabTensor_eq_ofReal_normSq]
    simp
  have hrestrict : Integrable (fun z : WaveSpaceTime =>
      scratch_canonicalBandlimitedTubePhysicalCore rho hrho
        (z.1 + z.2 • omega - y) * (F z : Complex)) scratchLightRayMeasure := by
    have hfull' : Integrable (fun z : WaveSpaceTime =>
      scratch_canonicalBandlimitedTubePhysicalCore rho hrho
        (z.1 + z.2 • omega - y) * (F z : Complex)) volume := by
      simpa only [m, scratch_canonicalBandlimitedTubePhysicalCore,
        SchwartzMap.fourierInv_coe, hFcomplex] using hfull
    exact hfull'.mono_measure scratchLightRayMeasure_le_volume
  have hrestrict' : Integrable (fun z : WaveSpaceTime =>
      scratch_canonicalBandlimitedTubePhysicalCore rho hrho
        (z.1 + z.2 • omega - y) * (F z : Complex))
        (volume.restrict (Set.univ ×ˢ lightRayTimeInterval)) := by
    rw [← scratchLightRayMeasure_eq_volume_restrict_slab]
    exact hrestrict
  have hlinear := canonicalTubePositiveAverage_le_norm_linearAverage
    hrho F omega y hrestrict'
  have hfield :
      (∫ z : WaveSpaceTime,
        scratch_canonicalBandlimitedTubePhysicalCore rho hrho
          (z.1 + z.2 • omega - y) * (F z : Complex)
          ∂scratchLightRayMeasure) =
        reflectedSchwartzSquareTubeBand m
          (hasCompactSupport_scratch_canonicalBandlimitedTubeMultiplier hrho)
          q a omega y := by
    simpa only [m, scratch_canonicalBandlimitedTubePhysicalCore,
      SchwartzMap.fourierInv_coe, hFcomplex] using
      (canonicalTubeSquareAverage_restrict_eq_reflectedSchwartzSquareTubeBand
        m (hasCompactSupport_scratch_canonicalBandlimitedTubeMultiplier hrho)
        q a hr ha omega y hfull hinner houter)
  rw [← scratchLightRayMeasure_eq_volume_restrict_slab] at hlinear
  calc
    (∫ z : WaveSpaceTime,
      scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
        rho omega y z * (nonnegativeSquareInnerSlabTensor q a z).re
        ∂scratchLightRayMeasure) ≤
        ‖∫ z : WaveSpaceTime,
          scratch_canonicalBandlimitedTubePhysicalCore rho hrho
            (z.1 + z.2 • omega - y) * (F z : Complex)
            ∂scratchLightRayMeasure‖ := by
      simpa only [F] using hlinear
    _ = ‖reflectedSchwartzSquareTubeBand m
          (hasCompactSupport_scratch_canonicalBandlimitedTubeMultiplier hrho)
          q a omega y‖ := by rw [hfield]

/-- `ENNReal` form of the per-scale positive-square estimate.  This is the
literal `hpiece` inequality for the canonical kernel family, including the
dyadic coefficient.  Measurability of the displayed nonnegative integrand
is separated because it is exactly the input also required by Tonelli. -/
theorem lintegral_canonicalReflectedSquareDyadicKernel_mul_input_le
    {ι : Type} [Fintype ι]
    {c r delta : Real} (hc : 0 < c) (hr : 0 < r) (hdelta : 0 < delta)
    (N j : Nat)
    (q : ι → SchwartzMap canonicalReflectedSquareUnitE2 Complex) (a : ι → SchwartzMap Real Complex)
    {timeRadius : Real} (htimeRadius : timeRadius < 1)
    (ha : ∀ i, Function.support (a i : Real → Complex) ⊆
      Metric.closedBall (3 / 2 : Real) timeRadius)
    (omega : aux_lightRayDirection) (y : canonicalReflectedSquareUnitE2)
    (hfull : Integrable (fun z : WaveSpaceTime =>
      (FourierTransform.fourierInv
        (scratch_canonicalBandlimitedTubeMultiplier
          (delta / canonicalBandlimitedDyadicScale r j)
          (div_pos hdelta (canonicalBandlimitedDyadicScale_pos hr j))) : canonicalReflectedSquareUnitE2 → Complex)
        (z.1 + z.2 • omega.1 - y) * nonnegativeSquareInnerSlabTensor q a z)
      volume)
    (hinner : ∀ (t : Real) (ij : ι × ι), Integrable (fun x : canonicalReflectedSquareUnitE2 =>
      timeCrossProduct (a ij.1) (a ij.2) t *
        (((FourierTransform.fourierInv
          (scratch_canonicalBandlimitedTubeMultiplier
            (delta / canonicalBandlimitedDyadicScale r j)
            (div_pos hdelta (canonicalBandlimitedDyadicScale_pos hr j))) :
            SchwartzMap canonicalReflectedSquareUnitE2 Complex) : canonicalReflectedSquareUnitE2 → Complex)
          (x + t • omega.1 - y) *
          ((FourierTransform.fourierInv
            (crossFrequencyMultiplier (q ij.1) (q ij.2) : SchwartzMap canonicalReflectedSquareUnitE2 Complex) :
              SchwartzMap canonicalReflectedSquareUnitE2 Complex) : canonicalReflectedSquareUnitE2 → Complex) x)) volume)
    (houter : ∀ ij : ι × ι, Integrable (fun t : Real =>
      ∫ x : canonicalReflectedSquareUnitE2,
        timeCrossProduct (a ij.1) (a ij.2) t *
          (((FourierTransform.fourierInv
            (scratch_canonicalBandlimitedTubeMultiplier
              (delta / canonicalBandlimitedDyadicScale r j)
              (div_pos hdelta (canonicalBandlimitedDyadicScale_pos hr j))) :
              SchwartzMap canonicalReflectedSquareUnitE2 Complex) : canonicalReflectedSquareUnitE2 → Complex)
            (x + t • omega.1 - y) *
            ((FourierTransform.fourierInv
              (crossFrequencyMultiplier (q ij.1) (q ij.2) : SchwartzMap canonicalReflectedSquareUnitE2 Complex) :
                SchwartzMap canonicalReflectedSquareUnitE2 Complex) : canonicalReflectedSquareUnitE2 → Complex) x)) volume)
    (hpositive : Integrable (fun z : WaveSpaceTime =>
      scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
        (delta / canonicalBandlimitedDyadicScale r j) omega.1 y z *
          (nonnegativeSquareInnerSlabTensor q a z).re) scratchLightRayMeasure)
    (hpositiveMeas : Measurable (fun z : WaveSpaceTime => ENNReal.ofReal
      (scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
        (delta / canonicalBandlimitedDyadicScale r j) omega.1 y z *
          (nonnegativeSquareInnerSlabTensor q a z).re))) :
    (∫⁻ z, canonicalReflectedSquareDyadicKernel c r delta N j omega y z *
      canonicalSquareInput (nonnegativeSquareInnerSlabTensor q a) z
        ∂scratchLightRayMeasure) ≤
      ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
        ENNReal.ofReal ‖reflectedSchwartzSquareTubeBand
          (scratch_canonicalBandlimitedTubeMultiplier
            (delta / canonicalBandlimitedDyadicScale r j)
            (div_pos hdelta (canonicalBandlimitedDyadicScale_pos hr j)))
          (hasCompactSupport_scratch_canonicalBandlimitedTubeMultiplier
            (div_pos hdelta (canonicalBandlimitedDyadicScale_pos hr j)))
          q a omega.1 y‖ := by
  let rho : Real := delta / canonicalBandlimitedDyadicScale r j
  have hrho : 0 < rho := div_pos hdelta (canonicalBandlimitedDyadicScale_pos hr j)
  let coeff : Real := canonicalBandlimitedDyadicCoefficient N c r j
  have hcoeff : 0 ≤ coeff := by
    dsimp only [coeff, canonicalBandlimitedDyadicCoefficient]
    positivity
  let F : WaveSpaceTime → Real := fun z =>
    (nonnegativeSquareInnerSlabTensor q a z).re
  have hcore_nonneg (z : WaveSpaceTime) :
      0 ≤ scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
        rho omega.1 y z := by
    unfold scratch_smoothTubeCore
    exact mul_nonneg (sq_nonneg _) (canonicalPositiveCore_re_nonneg _)
  have hprod_nonneg (z : WaveSpaceTime) :
      0 ≤ scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
        rho omega.1 y z * F z :=
    mul_nonneg (hcore_nonneg z)
      (nonnegativeSquareInnerSlabTensor_re_nonneg q a z)
  have hbase := canonicalPositiveSquareScaleAverage_le_norm_reflected
    hrho q a htimeRadius ha omega.1 y hfull hinner houter
  have hbase' :
      (∫⁻ z, ENNReal.ofReal
        (scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
          rho omega.1 y z * F z) ∂scratchLightRayMeasure) ≤
        ENNReal.ofReal ‖reflectedSchwartzSquareTubeBand
          (scratch_canonicalBandlimitedTubeMultiplier rho hrho)
          (hasCompactSupport_scratch_canonicalBandlimitedTubeMultiplier hrho)
          q a omega.1 y‖ := by
    rw [← MeasureTheory.ofReal_integral_eq_lintegral_ofReal hpositive
      (Filter.Eventually.of_forall hprod_nonneg)]
    exact ENNReal.ofReal_le_ofReal (by simpa only [rho, F] using hbase)
  have hrewrite (z : WaveSpaceTime) :
      canonicalReflectedSquareDyadicKernel c r delta N j omega y z *
        canonicalSquareInput (nonnegativeSquareInnerSlabTensor q a) z =
      ENNReal.ofReal coeff * ENNReal.ofReal
        (scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
          rho omega.1 y z * F z) := by
    unfold canonicalReflectedSquareDyadicKernel canonicalSquareInput
    rw [norm_nonnegativeSquareInnerSlabTensor_eq_re q a z,
      ENNReal.ofReal_mul hcoeff]
    rw [mul_assoc, ← ENNReal.ofReal_mul (hcore_nonneg z)]
  calc
    (∫⁻ z, canonicalReflectedSquareDyadicKernel c r delta N j omega y z *
      canonicalSquareInput (nonnegativeSquareInnerSlabTensor q a) z
        ∂scratchLightRayMeasure) =
        ∫⁻ z, ENNReal.ofReal coeff * ENNReal.ofReal
          (scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
            rho omega.1 y z * F z) ∂scratchLightRayMeasure := by
          apply lintegral_congr
          intro z
          exact hrewrite z
    _ = ENNReal.ofReal coeff *
        (∫⁻ z, ENNReal.ofReal
          (scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
            rho omega.1 y z * F z) ∂scratchLightRayMeasure) := by
          rw [MeasureTheory.lintegral_const_mul _ hpositiveMeas]
    _ ≤ ENNReal.ofReal coeff *
        ENNReal.ofReal ‖reflectedSchwartzSquareTubeBand
          (scratch_canonicalBandlimitedTubeMultiplier rho hrho)
          (hasCompactSupport_scratch_canonicalBandlimitedTubeMultiplier hrho)
          q a omega.1 y‖ :=
      mul_le_mul_right hbase' _
    _ = ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
        ENNReal.ofReal ‖reflectedSchwartzSquareTubeBand
          (scratch_canonicalBandlimitedTubeMultiplier
            (delta / canonicalBandlimitedDyadicScale r j)
            (div_pos hdelta (canonicalBandlimitedDyadicScale_pos hr j)))
          (hasCompactSupport_scratch_canonicalBandlimitedTubeMultiplier
            (div_pos hdelta (canonicalBandlimitedDyadicScale_pos hr j)))
          q a omega.1 y‖ := by
      rfl

/-- `ENNReal` pointwise form of the canonical dyadic positive-kernel
majorization.  This is the raw-kernel half of `hraw`; the sum is over the
actual unit-direction field but the pointwise identity is valid for every
direction. -/
theorem ofReal_lightRayKernel_le_tsum_canonicalReflectedSquareDyadicKernel
    {delta c r : Real} (hdelta : 0 < delta) (N : Nat) (hN : 2 < N)
    (hc : 0 < c) (hr : 0 < r)
    (hcore : ∀ u : canonicalReflectedSquareUnitE2, ‖u‖ ≤ r → c ≤ (canonicalPositiveCore u).re)
    (omega : aux_lightRayDirection) (y : canonicalReflectedSquareUnitE2) (z : WaveSpaceTime) :
    ENNReal.ofReal (lightRayKernel delta N omega.1 y z) ≤
      ∑' j : Nat, canonicalReflectedSquareDyadicKernel c r delta N j omega y z := by
  let u : canonicalReflectedSquareUnitE2 := delta⁻¹ • (z.1 + z.2 • omega.1 - y)
  let term : Nat → Real := fun j =>
    canonicalBandlimitedDyadicCoefficient N c r j *
      scratch_smoothTubeCore (fun v => (canonicalPositiveCore v).re)
        (delta / canonicalBandlimitedDyadicScale r j) omega.1 y z
  have hterm_eq (j : Nat) : term j =
      (delta⁻¹) ^ 2 *
        (canonicalBandlimitedDyadicCoefficient N c r j *
          canonicalBandlimitedDyadicCore r j u) := by
    dsimp only [term, u]
    rw [← mul_assoc,
      ← scratch_rescaledCanonicalDyadicCore_eq_smoothTubeCore
        hdelta hr j omega.1 y z]
    ring
  have hterm_nonneg (j : Nat) : 0 ≤ term j := by
    rw [hterm_eq]
    exact mul_nonneg (sq_nonneg _)
      (canonicalBandlimitedDyadicCore_nonneg_coefficient N hc hr j u)
  have hterm_summable : Summable term := by
    rw [show term = fun j => (delta⁻¹) ^ 2 *
        (canonicalBandlimitedDyadicCoefficient N c r j *
          canonicalBandlimitedDyadicCore r j u) by
      funext j
      exact hterm_eq j]
    exact Summable.mul_left _
      (summable_canonicalBandlimitedDyadicTerm N hN hc hr u)
  have htail := lightRayKernel_le_tsum_canonicalBandlimitedTubeCore
    hdelta N hN hc hr hcore omega.1 y z
  calc
    ENNReal.ofReal (lightRayKernel delta N omega.1 y z) ≤
        ENNReal.ofReal (∑' j : Nat, term j) :=
      ENNReal.ofReal_le_ofReal (by simpa only [term] using htail)
    _ = ∑' j : Nat, ENNReal.ofReal (term j) :=
      ENNReal.ofReal_tsum_of_nonneg hterm_nonneg hterm_summable
    _ = ∑' j : Nat,
        canonicalReflectedSquareDyadicKernel c r delta N j omega y z := by
      apply tsum_congr
      intro j
      rfl

/-- Fixed-direction raw domination for a positive square input.  The proof
first integrates the canonical kernel inequality at that one direction and
only later takes the unit-direction supremum, preserving the required
Tonelli/triangle/sup order. -/
theorem positiveNormLightRayLinear_le_canonicalReflectedSquareDirectional
    {delta c r : Real} (hdelta : 0 < delta) (N : Nat) (hN : 2 < N)
    (hc : 0 < c) (hr : 0 < r)
    (hcore : ∀ u : canonicalReflectedSquareUnitE2, ‖u‖ ≤ r → c ≤ (canonicalPositiveCore u).re)
    (f : WaveSpaceTime → Complex) (hf : MemLp f 2 volume)
    (omega : aux_lightRayDirection) (y : canonicalReflectedSquareUnitE2) :
    ENNReal.ofReal ‖positiveNormLightRayLinear delta N f omega.1 y‖ ≤
      scratch_positiveKernelTsum scratchLightRayMeasure
        (fun j (d : aux_lightRayDirection) y z =>
          canonicalReflectedSquareDyadicKernel c r delta N j d y z)
        (canonicalSquareInput f) omega y := by
  have hrawInt : Integrable (fun z : WaveSpaceTime =>
      lightRayKernel delta N omega.1 y z * ‖f z‖) scratchLightRayMeasure :=
    scratch_integrable_lightRayKernel_mul_norm_of_memLp
      hdelta N (by omega) omega.1 y f hf
  have haverage : 0 ≤ lightRayAverage delta N omega.1 y f :=
    aux_lightRayAverage_nonneg hdelta N omega.1 y f
  have hpoint (z : WaveSpaceTime) :
      ENNReal.ofReal (lightRayKernel delta N omega.1 y z * ‖f z‖) ≤
        (∑' j : Nat,
          canonicalReflectedSquareDyadicKernel c r delta N j omega y z) *
          canonicalSquareInput f z := by
    rw [ENNReal.ofReal_mul (lightRayKernel_nonneg hdelta N omega.1 y z)]
    exact mul_le_mul_left
      (ofReal_lightRayKernel_le_tsum_canonicalReflectedSquareDyadicKernel
        hdelta N hN hc hr hcore omega y z) _
  calc
    ENNReal.ofReal ‖positiveNormLightRayLinear delta N f omega.1 y‖ =
        ENNReal.ofReal (lightRayAverage delta N omega.1 y f) := by
      unfold positiveNormLightRayLinear
      rw [Complex.norm_real, Real.norm_of_nonneg haverage]
    _ = ENNReal.ofReal (∫ z : WaveSpaceTime,
        lightRayKernel delta N omega.1 y z * ‖f z‖ ∂scratchLightRayMeasure) := by
      rw [scratch_integral_lightRayKernel_mul_norm_eq_lightRayAverage
        delta N omega.1 y f hrawInt]
    _ = ∫⁻ z, ENNReal.ofReal
        (lightRayKernel delta N omega.1 y z * ‖f z‖) ∂scratchLightRayMeasure :=
      MeasureTheory.ofReal_integral_eq_lintegral_ofReal hrawInt
        (Filter.Eventually.of_forall fun z =>
          mul_nonneg (lightRayKernel_nonneg hdelta N omega.1 y z) (norm_nonneg _))
    _ ≤ ∫⁻ z, (∑' j : Nat,
        canonicalReflectedSquareDyadicKernel c r delta N j omega y z) *
          canonicalSquareInput f z ∂scratchLightRayMeasure :=
      MeasureTheory.lintegral_mono hpoint
    _ = scratch_positiveKernelTsum scratchLightRayMeasure
        (fun j (d : aux_lightRayDirection) y z =>
          canonicalReflectedSquareDyadicKernel c r delta N j d y z)
        (canonicalSquareInput f) omega y := rfl

/-- The raw canonical domination after taking precisely the literal
unit-direction supremum. -/
theorem iSup_positiveNormLightRayLinear_le_iSup_canonicalReflectedSquareDirectional
    {delta c r : Real} (hdelta : 0 < delta) (N : Nat) (hN : 2 < N)
    (hc : 0 < c) (hr : 0 < r)
    (hcore : ∀ u : canonicalReflectedSquareUnitE2, ‖u‖ ≤ r → c ≤ (canonicalPositiveCore u).re)
    (f : WaveSpaceTime → Complex) (hf : MemLp f 2 volume) (y : canonicalReflectedSquareUnitE2) :
    (⨆ omega : aux_lightRayDirection,
      ENNReal.ofReal ‖positiveNormLightRayLinear delta N f omega.1 y‖) ≤
      ⨆ omega : aux_lightRayDirection,
        scratch_positiveKernelTsum scratchLightRayMeasure
          (fun j (d : aux_lightRayDirection) y z =>
            canonicalReflectedSquareDyadicKernel c r delta N j d y z)
          (canonicalSquareInput f) omega y := by
  apply iSup_le
  intro omega
  exact (positiveNormLightRayLinear_le_canonicalReflectedSquareDirectional
    hdelta N hN hc hr hcore f hf omega y).trans
      (le_iSup (fun d : aux_lightRayDirection =>
        scratch_positiveKernelTsum scratchLightRayMeasure
          (fun j (d : aux_lightRayDirection) y z =>
            canonicalReflectedSquareDyadicKernel c r delta N j d y z)
          (canonicalSquareInput f) d y) omega)

/-- Unit-direction version of the structural canonical wiring.  The raw
positive operator, the `ENNReal` canonical kernels, and the finite envelope
are fixed below; only continuity/measurability and the finite signed field
identification are supplied by the analytic construction. -/
structure CanonicalReflectedScalePositiveUnitWiring (c r : Real) where
  S : Real → Nat → (WaveSpaceTime → Complex) → Nat → canonicalReflectedSquareUnitE2 → canonicalReflectedSquareUnitE2 → Complex
  hScaleMeas : ∀ delta N f j, InnerSlabSchwartzTensorCore f →
    Measurable (canonicalReflectedUnitScaleEnvelope S delta N f j)
  hTgeom : ∀ delta N (F : WaveSpaceTime → Complex)
    (core : Nat → WaveSpaceTime → Complex),
      MemLp F 2 volume →
      (∀ n, MemLp (core n) 2 volume) →
      (∀ n, eLpNorm (F - core n) 2 volume ≤
        eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) →
      ∀ omega y,
        Tendsto (fun n => positiveNormLightRayLinear delta N (core n) omega y)
          atTop (nhds (positiveNormLightRayLinear delta N F omega y))
  hKmeas : ∀ delta N f,
    NonnegativeSquareInnerSlabSchwartzTensorCore f →
    ∀ j (omega : aux_lightRayDirection) y,
      AEMeasurable (fun z =>
        canonicalReflectedSquareDyadicKernel c r delta N j omega y z *
          canonicalSquareInput f z) scratchLightRayMeasure
  hraw : ∀ {delta : Real}, 0 < delta → ∀ N, 2 < N →
    ∀ f, NonnegativeSquareInnerSlabSchwartzTensorCore f → MemLp f 2 volume →
    ∀ y,
      (⨆ omega : aux_lightRayDirection,
        ENNReal.ofReal ‖positiveNormLightRayLinear delta N f omega.1 y‖) ≤
      ⨆ omega : aux_lightRayDirection,
        scratch_positiveKernelTsum scratchLightRayMeasure
          (fun j (d : aux_lightRayDirection) y z =>
            canonicalReflectedSquareDyadicKernel c r delta N j d y z)
          (canonicalSquareInput f) omega y
  hdir : ∀ delta N f (omega : aux_lightRayDirection) y,
    scratch_positiveKernelTsum scratchLightRayMeasure
      (fun j (d : aux_lightRayDirection) y z =>
        canonicalReflectedSquareDyadicKernel c r delta N j d y z)
      (canonicalSquareInput f) omega y ≤
    scratch_positiveKernelTsum scratchLightRayMeasure
      (fun j (d : aux_lightRayDirection) y z =>
        canonicalReflectedSquareDyadicKernel c r delta N j d y z)
      (canonicalSquareInput f) omega y
  hpiece : ∀ {delta : Real}, 0 < delta → ∀ N j f,
    NonnegativeSquareInnerSlabSchwartzTensorCore f →
    ∀ (omega : aux_lightRayDirection) y,
      (∫⁻ z,
        canonicalReflectedSquareDyadicKernel c r delta N j omega y z *
          canonicalSquareInput f z ∂scratchLightRayMeasure) ≤
        ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
          canonicalReflectedUnitScaleEnvelope S delta N f j y

/-- Finite-envelope measurability is a structural consequence of the
one-scale unit-direction measurability; it is not an extra selector axiom. -/
theorem CanonicalReflectedScalePositiveUnitWiring.finiteEnvelope_measurable
    {c r : Real} (w : CanonicalReflectedScalePositiveUnitWiring c r)
    (delta : Real) (N : Nat) (f : WaveSpaceTime → Complex) (M : Nat)
    (hf : InnerSlabSchwartzTensorCore f) :
    Measurable (canonicalReflectedUnitFiniteEnvelope c r w.S delta N f M) := by
  unfold canonicalReflectedUnitFiniteEnvelope
  apply Finset.measurable_sum
  intro j hj
  exact measurable_const.mul (w.hScaleMeas delta N f j hf)

/-- The countable Fatou limit of the finite unit-direction envelopes is
measurable as well. -/
theorem CanonicalReflectedScalePositiveUnitWiring.limitEnvelope_measurable
    {c r : Real} (w : CanonicalReflectedScalePositiveUnitWiring c r)
    (delta : Real) (N : Nat) (f : WaveSpaceTime → Complex)
    (hf : InnerSlabSchwartzTensorCore f) :
    Measurable (fun y => atTop.liminf
      (fun M => canonicalReflectedUnitFiniteEnvelope c r w.S delta N f M y)) := by
  exact Measurable.liminf (fun M => w.finiteEnvelope_measurable delta N f M hf)

/-- Unit-direction analogue of the canonical positive-square model.  Its
positive domination is asked only at literal unit directions, precisely the
range used by `lightRayMaximal`. -/
structure CanonicalDyadicFiniteEnvelopePositiveSquareUnitModel where
  T : Real → Nat → (WaveSpaceTime → Complex) → canonicalReflectedSquareUnitE2 → canonicalReflectedSquareUnitE2 → Complex
  E : Real → Nat → (WaveSpaceTime → Complex) → Nat → canonicalReflectedSquareUnitE2 → ENNReal
  hEmeas : ∀ delta N f M, InnerSlabSchwartzTensorCore f →
    Measurable (E delta N f M)
  hLimitMeas : ∀ delta N f, InnerSlabSchwartzTensorCore f →
    Measurable (fun y => atTop.liminf (fun M => E delta N f M y))
  hidentify : ∀ delta N (h : WaveSpaceTime → Complex) (omega y : canonicalReflectedSquareUnitE2),
    T delta N
        (scratch_lightRayTimeRestriction (fun z => (‖h z‖ : Complex))) omega y =
      (lightRayAverage delta N omega y h : Complex)
  hTgeom : ∀ delta N (F : WaveSpaceTime → Complex)
    (core : Nat → WaveSpaceTime → Complex),
      MemLp F 2 volume →
      (∀ n, MemLp (core n) 2 volume) →
      (∀ n, eLpNorm (F - core n) 2 volume ≤
        eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) →
      ∀ omega y,
        Tendsto (fun n => T delta N (core n) omega y) atTop
          (nhds (T delta N F omega y))
  hcanonicalDom : ∀ {delta : Real}, 0 < delta → ∀ N, 2 < N →
    ∀ f, NonnegativeSquareInnerSlabSchwartzTensorCore f → MemLp f 2 volume →
    ∀ (omega : aux_lightRayDirection) y,
      ENNReal.ofReal ‖T delta N f omega.1 y‖ ≤
        atTop.liminf (fun M => E delta N f M y)

/-- The generic positive Tonelli/Fatou package, now with `D` literally equal
to `aux_lightRayDirection`, constructs a unit-direction model from the
canonical reflected-scale wiring. -/
noncomputable def CanonicalReflectedScalePositiveUnitWiring.toUnitModel
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (w : CanonicalReflectedScalePositiveUnitWiring c r) :
    CanonicalDyadicFiniteEnvelopePositiveSquareUnitModel where
  T := positiveNormLightRayLinear
  E := canonicalReflectedUnitFiniteEnvelope c r w.S
  hEmeas := by
    intro delta N f M hf
    exact w.finiteEnvelope_measurable delta N f M hf
  hLimitMeas := by
    intro delta N f hf
    exact w.limitEnvelope_measurable delta N f hf
  hidentify := positiveNormLightRayLinear_identify
  hTgeom := w.hTgeom
  hcanonicalDom := by
    intro delta hdelta N hN f hf hfmem omega y
    calc
      ENNReal.ofReal ‖positiveNormLightRayLinear delta N f omega.1 y‖ ≤
          (⨆ omega : aux_lightRayDirection,
            ENNReal.ofReal ‖positiveNormLightRayLinear delta N f omega.1 y‖) :=
        le_iSup (fun omega : aux_lightRayDirection =>
          ENNReal.ofReal ‖positiveNormLightRayLinear delta N f omega.1 y‖) omega
      _ ≤ ⨆ omega : aux_lightRayDirection,
          scratch_positiveKernelTsum scratchLightRayMeasure
            (fun j (d : aux_lightRayDirection) y z =>
              canonicalReflectedSquareDyadicKernel c r delta N j d y z)
            (canonicalSquareInput f) omega y :=
        w.hraw hdelta N hN f hf hfmem y
      _ ≤ atTop.liminf (fun M => ∑ j ∈ Finset.range M,
          ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
            canonicalReflectedUnitScaleEnvelope w.S delta N f j y) := by
        apply scratch_iSup_directional_le_liminf_finiteEnvelope
          scratchLightRayMeasure
          (fun j (d : aux_lightRayDirection) y z =>
            canonicalReflectedSquareDyadicKernel c r delta N j d y z)
          (canonicalSquareInput f)
          (fun omega y =>
            scratch_positiveKernelTsum scratchLightRayMeasure
              (fun j (d : aux_lightRayDirection) y z =>
                canonicalReflectedSquareDyadicKernel c r delta N j d y z)
              (canonicalSquareInput f) omega y)
          (fun j y =>
            ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
              canonicalReflectedUnitScaleEnvelope w.S delta N f j y)
        · intro j d y
          exact w.hKmeas delta N f hf j d y
        · intro d y
          exact w.hdir delta N f d y
        · intro j d y
          exact w.hpiece hdelta N j f hf d y
      _ = atTop.liminf (fun M =>
          canonicalReflectedUnitFiniteEnvelope c r w.S delta N f M y) := by
        apply congrArg atTop.liminf
        funext M
        rfl

/-- Unit-direction version of the positive-square density closure.  The only
change from the earlier all-direction helper is mathematically essential:
the domination hypothesis is invoked at the compact unit-direction
maximizer, never at an arbitrary vector in `E²`. -/
theorem hasLightRayMaximalEstimate_of_positiveSlabDenseSignedEnvelope_unit
    (Core : (WaveSpaceTime → Complex) → Prop)
    (hdense : HasPositiveSlabL2DenseCore Core)
    (T : Real → Nat → (WaveSpaceTime → Complex) → canonicalReflectedSquareUnitE2 → canonicalReflectedSquareUnitE2 → Complex)
    (P : Real → Nat → (WaveSpaceTime → Complex) → canonicalReflectedSquareUnitE2 → ENNReal)
    (hPmeas : ∀ delta N f, Core f → Measurable (P delta N f))
    (hstrong : ∀ N : Nat, 3 < N → ∃ C : Real, 0 < C ∧
      ∀ delta : Real, 0 < delta → delta < 1 / 2 →
      ∀ f : WaveSpaceTime → Complex, Core f →
        eLpNorm (P delta N f) 2 volume ≤
          ENNReal.ofReal (C * (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
            eLpNorm f 2 volume)
    (hidentify : ∀ delta N (h : WaveSpaceTime → Complex) (omega y : canonicalReflectedSquareUnitE2),
      T delta N
          (scratch_lightRayTimeRestriction (fun z => (‖h z‖ : Complex))) omega y =
        (lightRayAverage delta N omega y h : Complex))
    (hTgeom : ∀ delta N (F : WaveSpaceTime → Complex)
      (core : Nat → WaveSpaceTime → Complex),
        MemLp F 2 volume →
        (∀ n, MemLp (core n) 2 volume) →
        (∀ n, eLpNorm (F - core n) 2 volume ≤
          eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) →
        ∀ omega y,
          Tendsto (fun n => T delta N (core n) omega y) atTop
            (nhds (T delta N F omega y)))
    (hdom : ∀ {delta : Real}, 0 < delta → ∀ N, 2 < N →
      ∀ f, Core f → MemLp f 2 volume →
      ∀ (omega : aux_lightRayDirection) y,
        ENNReal.ofReal ‖T delta N f omega.1 y‖ ≤ P delta N f y) :
    HasLightRayMaximalEstimate := by
  intro N hN
  obtain ⟨C, hCpos, hCstrong⟩ := hstrong N hN
  refine ⟨2 * C, by positivity, ?_⟩
  intro delta hdelta hdeltasmall g hg
  let h : WaveSpaceTime → Complex := scratch_lightRayTimeRestriction g
  have hh : MemLp h 2 volume := by
    simpa only [h] using scratch_memLp_lightRayTimeRestriction g hg
  have hslab : h = scratch_lightRayTimeRestriction h := by
    funext z
    dsimp only [h]
    simp only [scratch_lightRayTimeRestriction, Set.indicator_indicator]
    rw [inter_self]
  let F : WaveSpaceTime → Complex :=
    scratch_lightRayTimeRestriction (fun z => (‖h z‖ : Complex))
  have hFmem : MemLp F 2 volume := by
    dsimp only [F]
    exact scratch_memLp_lightRayTimeRestriction _
      (scratch_memLp_complex_of_norm h hh)
  have hFnorm : eLpNorm F 2 volume = eLpNorm h 2 volume := by
    dsimp only [F]
    exact scratch_eLpNorm_positiveSlab_eq h hslab 2
  have hM : lightRayMaximal delta N g = lightRayMaximal delta N h := by
    simpa only [h] using
      scratch_lightRayMaximal_eq_lightRayTimeRestriction hdelta N (by omega) g hg
  let L : Real := (1 + abs (Real.log delta)) ^ (3 / 2 : Real)
  let A : ENNReal := ENNReal.ofReal (C * L)
  by_cases hhnonzero : eLpNorm h 2 volume = 0
  · have hhae : h =ᵐ[volume] (fun _ : WaveSpaceTime => (0 : Complex)) :=
      (eLpNorm_eq_zero_iff hh.aestronglyMeasurable (by norm_num)).mp hhnonzero
    have hMhzero : lightRayMaximal delta N h = 0 := by
      calc
        lightRayMaximal delta N h =
            lightRayMaximal delta N (fun _ : WaveSpaceTime => (0 : Complex)) :=
          scratch_lightRayMaximal_eq_of_ae_eq_of_memLp hdelta N (by omega) hh
            MemLp.zero hhae
        _ = 0 := scratch_lightRayMaximal_zero delta N
    rw [hM, hMhzero]
    simp
  · let R : Real := (eLpNorm F 2 volume).toReal
    have hFnonzero : eLpNorm F 2 volume ≠ 0 := by
      rwa [hFnorm]
    have hRpos : 0 < R := ENNReal.toReal_pos hFnonzero hFmem.eLpNorm_ne_top
    choose core hcore hcoreMem hcoreErr using fun n : Nat =>
      hdense h hh (R * ((2 : Real)⁻¹ ^ n))
        (show 0 < R * ((2 : Real)⁻¹ ^ n) by positivity)
    have hscaled (n : Nat) :
        eLpNorm (F - core n) 2 volume ≤
          eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n) := by
      calc
        eLpNorm (F - core n) 2 volume ≤
            ENNReal.ofReal (R * ((2 : Real)⁻¹ ^ n)) := by
              simpa only [F] using (hcoreErr n).le
        _ = ENNReal.ofReal R * ENNReal.ofReal ((2 : Real)⁻¹ ^ n) :=
          ENNReal.ofReal_mul hRpos.le
        _ = eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n) := by
          rw [ENNReal.ofReal_toReal hFmem.eLpNorm_ne_top]
    have hcoreStrong (n : Nat) :
        eLpNorm (P delta N (core n)) 2 volume ≤
          A * eLpNorm (core n) 2 volume := by
      simpa only [A, L] using hCstrong delta hdelta hdeltasmall
        (core n) (hcore n)
    have hconv : ∀ omega y,
        Tendsto (fun n => T delta N (core n) omega y) atTop
          (nhds (T delta N F omega y)) :=
      hTgeom delta N F core hFmem hcoreMem hscaled
    have hfatou : ∀ᵐ y : canonicalReflectedSquareUnitE2 ∂volume,
        ENNReal.ofReal (lightRayMaximal delta N h y) ≤
          atTop.liminf (fun n => P delta N (core n) y) := by
      filter_upwards with y
      apply scratch_lightRayMaximal_ofReal_le_liminf_of_signedCore_unitDom
        hdelta N (by omega) h hh F (T delta N) (P delta N) core
      · intro omega y
        simpa only [F] using hidentify delta N h omega y
      · exact hconv
      · intro n omega homega y
        exact hdom hdelta N (by omega) (core n) (hcore n) (hcoreMem n)
          ⟨omega, homega⟩ y
    have hbound : eLpNorm (lightRayMaximal delta N h) 2 volume ≤
        A * (2 * eLpNorm h 2 volume) := by
      calc
        eLpNorm (lightRayMaximal delta N h) 2 volume ≤
            A * (2 * eLpNorm F 2 volume) := by
          apply scratch_lightRayMaximal_bound_of_signedCore_liminf
            hdelta N (by omega) h hh A (2 * eLpNorm F 2 volume) core
              (P delta N)
          · intro n
            exact hPmeas delta N (core n) (hcore n)
          · exact hcoreStrong
          · intro n
            exact scratch_core_eLpNorm_le_two_of_scaled_approximation
              F hFmem core hcoreMem hscaled n
          · exact hfatou
        _ = A * (2 * eLpNorm h 2 volume) := by rw [hFnorm]
    have hnorm : eLpNorm h 2 volume ≤ eLpNorm g 2 volume := by
      simpa only [h] using scratch_eLpNorm_lightRayTimeRestriction_le g
    have hboundG : eLpNorm (lightRayMaximal delta N g) 2 volume ≤
        A * (2 * eLpNorm g 2 volume) := by
      calc
        eLpNorm (lightRayMaximal delta N g) 2 volume =
            eLpNorm (lightRayMaximal delta N h) 2 volume := by rw [hM]
        _ ≤ A * (2 * eLpNorm h 2 volume) := hbound
        _ ≤ A * (2 * eLpNorm g 2 volume) := by
          simpa only [mul_assoc, mul_comm, mul_left_comm] using
            (mul_le_mul_left (mul_le_mul_left hnorm 2) A)
    have hfactor : A * (2 * eLpNorm g 2 volume) =
        ENNReal.ofReal ((2 * C) * L) * eLpNorm g 2 volume := by
      calc
        A * (2 * eLpNorm g 2 volume) =
            (2 * A) * eLpNorm g 2 volume := by ring
        _ = ENNReal.ofReal (2 * (C * L)) * eLpNorm g 2 volume := by
          congr 1
          dsimp only [A]
          rw [ENNReal.ofReal_mul (by norm_num : (0 : Real) ≤ 2)]
          norm_num
        _ = ENNReal.ofReal ((2 * C) * L) * eLpNorm g 2 volume := by
          congr 2
          ring
    calc
      eLpNorm (lightRayMaximal delta N g) 2 volume ≤
          A * (2 * eLpNorm g 2 volume) := hboundG
      _ = ENNReal.ofReal ((2 * C) *
          (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
          eLpNorm g 2 volume := by
        simpa only [L] using hfactor

/-- Finite signed-envelope `L²` premise for the literal unit-direction
model.  The input class remains the signed Schwartz tensor core. -/
def HasCanonicalDyadicUnitFiniteEnvelopeL2Estimate
    (model : CanonicalDyadicFiniteEnvelopePositiveSquareUnitModel) : Prop :=
  ∀ N : Nat, 3 < N → ∃ C : Real, 0 < C ∧
    ∀ delta : Real, 0 < delta → delta < 1 / 2 →
    ∀ f : WaveSpaceTime → Complex, InnerSlabSchwartzTensorCore f →
    ∀ M : Nat,
      eLpNorm (model.E delta N f M) 2 volume ≤
        ENNReal.ofReal (C * (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
          eLpNorm f 2 volume

/-- Fatou transfers the uniform finite signed estimate to the true
unit-direction envelope limit. -/
theorem canonicalDyadicUnitFiniteEnvelopeLimit_hasStrongBound
    (model : CanonicalDyadicFiniteEnvelopePositiveSquareUnitModel)
    (hfinite : HasCanonicalDyadicUnitFiniteEnvelopeL2Estimate model) :
    ∀ N : Nat, 3 < N → ∃ C : Real, 0 < C ∧
      ∀ delta : Real, 0 < delta → delta < 1 / 2 →
      ∀ f : WaveSpaceTime → Complex, InnerSlabSchwartzTensorCore f →
        eLpNorm (fun y => atTop.liminf (fun M => model.E delta N f M y)) 2 volume ≤
          ENNReal.ofReal (C * (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
            eLpNorm f 2 volume := by
  intro N hN
  obtain ⟨C, hC, hbound⟩ := hfinite N hN
  refine ⟨C, hC, ?_⟩
  intro delta hdelta hdeltaSmall f hf
  exact scratch_eLpNorm_liminf_le_of_uniform
    (p := (2 : ENNReal)) (by norm_num) (by norm_num)
    (fun M => model.hEmeas delta N f M hf)
    (fun M => hbound delta hdelta hdeltaSmall f hf M)

/-- Literal maximal endpoint from a unit-direction finite envelope model.
The raw positive domination is used only on the nonnegative square core
produced by the L⁴ square-root density theorem. -/
theorem hasLightRayMaximalEstimate_of_canonicalDyadicUnitFiniteEnvelope
    (model : CanonicalDyadicFiniteEnvelopePositiveSquareUnitModel)
    (hfinite : HasCanonicalDyadicUnitFiniteEnvelopeL2Estimate model) :
    HasLightRayMaximalEstimate := by
  apply hasLightRayMaximalEstimate_of_positiveSlabDenseSignedEnvelope_unit
    NonnegativeSquareInnerSlabSchwartzTensorCore
    hasPositiveSlabL2DenseCore_nonnegativeSquareInnerSlabSchwartzTensor
    model.T
    (fun delta N f y => atTop.liminf (fun M => model.E delta N f M y))
  · intro delta N f hf
    exact model.hLimitMeas delta N f
      (nonnegativeSquareInnerSlabSchwartzTensorCore_to_signedCore hf)
  · intro N hN
    obtain ⟨C, hC, hbound⟩ :=
      canonicalDyadicUnitFiniteEnvelopeLimit_hasStrongBound model hfinite N hN
    refine ⟨C, hC, ?_⟩
    intro delta hdelta hdeltaSmall f hf
    exact hbound delta hdelta hdeltaSmall f
      (nonnegativeSquareInnerSlabSchwartzTensorCore_to_signedCore hf)
  · exact model.hidentify
  · exact model.hTgeom
  · intro delta hdelta N hN f hf hfmem omega y
    exact model.hcanonicalDom hdelta N hN f hf hfmem omega y

/-- Narrow/broad formulation of the remaining finite analytic premise for
the literal unit-direction envelope.  The coefficient arithmetic is the
same as the canonical dyadic closure, while the actual envelope remains
the one defined with `aux_lightRayDirection`. -/
def HasCanonicalDyadicUnitNarrowBroadFiniteEnvelopeL2Estimate
    (model : CanonicalDyadicFiniteEnvelopePositiveSquareUnitModel) : Prop :=
  ∀ N : Nat, 3 < N → ∃ c r A B : Real,
    0 < c ∧ 0 < r ∧ 0 < A ∧ 0 ≤ B ∧
    ∀ delta : Real, 0 < delta → delta < 1 / 2 →
      ∃ k0 : Nat, ∃ cost : Nat → Real,
        (∀ j, j < k0 →
          cost j ≤ A * (1 + |Real.log delta|) ^ (3 / 2 : Real)) ∧
        (∀ j, k0 ≤ j → cost j ≤ B) ∧
        ∀ f : WaveSpaceTime → Complex, InnerSlabSchwartzTensorCore f →
          ∀ M : Nat,
            eLpNorm (model.E delta N f M) 2 volume ≤
              ENNReal.ofReal
                (∑ j ∈ Finset.range M,
                  canonicalBandlimitedDyadicCoefficient N c r j * cost j) *
                eLpNorm f 2 volume

/-- The summable canonical coefficients convert the narrow/broad finite
bound into the uniform unit finite-envelope estimate. -/
theorem hasCanonicalDyadicUnitFiniteEnvelopeL2Estimate_of_narrowBroad
    (model : CanonicalDyadicFiniteEnvelopePositiveSquareUnitModel)
    (hfinite : HasCanonicalDyadicUnitNarrowBroadFiniteEnvelopeL2Estimate model) :
    HasCanonicalDyadicUnitFiniteEnvelopeL2Estimate model := by
  intro N hN
  obtain ⟨c, r, A, B, hc, hr, hA, hB, hscales⟩ := hfinite N hN
  let q : Real := ((2 : Real)⁻¹) ^ (N - 2)
  let Cgeo : Real := ((2 : Real) ^ N / c) * (2 / r) ^ 2
  let Cfinal : Real := (A + B) * Cgeo / (1 - q)
  have hCfinal : 0 < Cfinal := by
    dsimp [Cfinal, Cgeo, q]
    have hq : ((2 : Real)⁻¹) ^ (N - 2) < 1 := by
      apply pow_lt_one₀ (by positivity) (by norm_num)
      exact Nat.ne_of_gt (Nat.sub_pos_of_lt (by omega : 2 < N))
    positivity
  refine ⟨Cfinal, hCfinal, ?_⟩
  intro delta hdelta hdeltaSmall
  obtain ⟨k0, cost, hnarrow, hbroad, hbound⟩ :=
    hscales delta hdelta hdeltaSmall
  let L : Real := (1 + |Real.log delta|) ^ (3 / 2 : Real)
  have hbase : 1 ≤ 1 + |Real.log delta| := by
    linarith [abs_nonneg (Real.log delta)]
  have hLone : 1 ≤ L := by
    dsimp [L]
    exact Real.one_le_rpow hbase (by norm_num)
  have hL : 0 ≤ L := (by norm_num : (0 : Real) ≤ 1).trans hLone
  intro f hf M
  have hsum :
      (∑ j ∈ Finset.range M,
        canonicalBandlimitedDyadicCoefficient N c r j * cost j) ≤
        Cfinal * L := by
    simpa only [Cfinal, Cgeo, q, L] using
      (scratch_sum_range_canonicalCoefficient_mul_cost_le
        M k0 N c r A B L (by omega) hc hr hA hB hL hLone cost
        (by simpa only [L] using hnarrow) hbroad)
  calc
    eLpNorm (model.E delta N f M) 2 volume ≤
        ENNReal.ofReal
          (∑ j ∈ Finset.range M,
            canonicalBandlimitedDyadicCoefficient N c r j * cost j) *
          eLpNorm f 2 volume := hbound f hf M
    _ ≤ ENNReal.ofReal (Cfinal * L) * eLpNorm f 2 volume :=
      mul_le_mul_left (ENNReal.ofReal_le_ofReal hsum) _
    _ = ENNReal.ofReal
        (Cfinal * (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
          eLpNorm f 2 volume := by
      rfl

/-- End-to-end literal target from the unit-direction narrow/broad premise. -/
theorem hasLightRayMaximalEstimate_of_canonicalDyadicUnitNarrowBroadFiniteEnvelope
    (model : CanonicalDyadicFiniteEnvelopePositiveSquareUnitModel)
    (hfinite : HasCanonicalDyadicUnitNarrowBroadFiniteEnvelopeL2Estimate model) :
    HasLightRayMaximalEstimate :=
  hasLightRayMaximalEstimate_of_canonicalDyadicUnitFiniteEnvelope model
    (hasCanonicalDyadicUnitFiniteEnvelopeL2Estimate_of_narrowBroad model hfinite)

/-- All per-packet identities and integrability facts needed to turn a
reflected finite tensor field into the positive canonical `hpiece` bound.
This deliberately contains no maximal estimate: those are the separate
finite signed-envelope analytic input. -/
def HasCanonicalReflectedSquareScaleBridge
    (r : Real) (hr : 0 < r)
    (S : Real → Nat → (WaveSpaceTime → Complex) → Nat → canonicalReflectedSquareUnitE2 → canonicalReflectedSquareUnitE2 → Complex) : Prop :=
  ∀ {delta : Real} (hdelta : 0 < delta) (N j : Nat),
    ∀ {ι : Type} [Fintype ι]
      (q : ι → SchwartzMap canonicalReflectedSquareUnitE2 Complex) (a : ι → SchwartzMap Real Complex)
      {timeRadius : Real}, timeRadius < 1 →
      (∀ i, Function.support (a i : Real → Complex) ⊆
        Metric.closedBall (3 / 2 : Real) timeRadius) →
      ∀ (omega : aux_lightRayDirection) y,
      let rho : Real := delta / canonicalBandlimitedDyadicScale r j
      let hrho : 0 < rho :=
        div_pos hdelta (canonicalBandlimitedDyadicScale_pos hr j)
      S delta N (nonnegativeSquareInnerSlabTensor q a) j omega.1 y =
        reflectedSchwartzSquareTubeBand
          (scratch_canonicalBandlimitedTubeMultiplier rho hrho)
          (hasCompactSupport_scratch_canonicalBandlimitedTubeMultiplier hrho)
          q a omega.1 y ∧
      Integrable (fun z : WaveSpaceTime =>
        (FourierTransform.fourierInv
          (scratch_canonicalBandlimitedTubeMultiplier rho hrho) : canonicalReflectedSquareUnitE2 → Complex)
          (z.1 + z.2 • omega.1 - y) * nonnegativeSquareInnerSlabTensor q a z)
        volume ∧
      (∀ (t : Real) (ij : ι × ι), Integrable (fun x : canonicalReflectedSquareUnitE2 =>
        timeCrossProduct (a ij.1) (a ij.2) t *
          (((FourierTransform.fourierInv
            (scratch_canonicalBandlimitedTubeMultiplier rho hrho) :
              SchwartzMap canonicalReflectedSquareUnitE2 Complex) : canonicalReflectedSquareUnitE2 → Complex)
            (x + t • omega.1 - y) *
            ((FourierTransform.fourierInv
              (crossFrequencyMultiplier (q ij.1) (q ij.2) : SchwartzMap canonicalReflectedSquareUnitE2 Complex) :
                SchwartzMap canonicalReflectedSquareUnitE2 Complex) : canonicalReflectedSquareUnitE2 → Complex) x)) volume) ∧
      (∀ ij : ι × ι, Integrable (fun t : Real =>
        ∫ x : canonicalReflectedSquareUnitE2,
          timeCrossProduct (a ij.1) (a ij.2) t *
            (((FourierTransform.fourierInv
              (scratch_canonicalBandlimitedTubeMultiplier rho hrho) :
                SchwartzMap canonicalReflectedSquareUnitE2 Complex) : canonicalReflectedSquareUnitE2 → Complex)
              (x + t • omega.1 - y) *
              ((FourierTransform.fourierInv
