section Auto.Spherical.MSS

open Filter MeasureTheory Set
open scoped BigOperators ENNReal

noncomputable section

/-- The positive directional integral of the full countable kernel family. -/
noncomputable def scratch_positiveKernelTsum
    {Z D X : Type*} [MeasurableSpace Z] (mu : Measure Z)
    (K : Nat → D → X → Z → ENNReal) (G : Z → ENNReal)
    (d : D) (x : X) : ENNReal :=
  ∫⁻ z, (∑' j : Nat, K j d x z) * G z ∂mu

/-- Its finite positive truncation.  This is deliberately an integral of a
finite sum, rather than a pre-emptive interchange with a directional sup. -/
noncomputable def scratch_positiveKernelFinitePartial
    {Z D X : Type*} [MeasurableSpace Z] (mu : Measure Z)
    (K : Nat → D → X → Z → ENNReal) (G : Z → ENNReal)
    (M : Nat) (d : D) (x : X) : ENNReal :=
  ∫⁻ z, ∑ j ∈ Finset.range M, K j d x z * G z ∂mu

/-- Positive Tonelli followed by the monotone finite-truncation limit.  This
is the safe replacement for an invalid direct exchange of `sup` and `tsum`. -/
theorem scratch_positiveKernelTsum_eq_liminf_finitePartial
    {Z D X : Type*} [MeasurableSpace Z] (mu : Measure Z)
    (K : Nat → D → X → Z → ENNReal) (G : Z → ENNReal)
    (hmeas : ∀ j d x, AEMeasurable (fun z => K j d x z * G z) mu)
    (d : D) (x : X) :
    scratch_positiveKernelTsum mu K G d x =
      atTop.liminf (fun M => scratch_positiveKernelFinitePartial mu K G M d x) := by
  unfold scratch_positiveKernelTsum scratch_positiveKernelFinitePartial
  calc
    (∫⁻ z, (∑' j : Nat, K j d x z) * G z ∂mu) =
        ∫⁻ z, ∑' j : Nat, K j d x z * G z ∂mu := by
      apply lintegral_congr
      intro z
      rw [ENNReal.tsum_mul_right]
    _ = ∑' j : Nat, ∫⁻ z, K j d x z * G z ∂mu :=
      MeasureTheory.lintegral_tsum (fun j => hmeas j d x)
    _ = atTop.liminf (fun M =>
        ∑ j ∈ Finset.range M, ∫⁻ z, K j d x z * G z ∂mu) :=
      ENNReal.tsum_eq_liminf_sum_nat
    _ = atTop.liminf (fun M =>
        ∫⁻ z, ∑ j ∈ Finset.range M, K j d x z * G z ∂mu) := by
      apply congrArg atTop.liminf
      funext M
      rw [MeasureTheory.lintegral_finsetSum' (Finset.range M)
        (fun j _ => hmeas j d x)]

/-- Each finite positive directional truncation is bounded by the finite sum
of its individual endpoint envelopes.  This is the finite triangle step;
only after it is established do we take a directional supremum or a limit. -/
theorem scratch_positiveKernelFinitePartial_le_sum_envelopes
    {Z D X : Type*} [MeasurableSpace Z] (mu : Measure Z)
    (K : Nat → D → X → Z → ENNReal) (G : Z → ENNReal)
    (P : Nat → X → ENNReal)
    (hmeas : ∀ j d x, AEMeasurable (fun z => K j d x z * G z) mu)
    (hdom : ∀ j d x, ∫⁻ z, K j d x z * G z ∂mu ≤ P j x)
    (M : Nat) (d : D) (x : X) :
    scratch_positiveKernelFinitePartial mu K G M d x ≤
      ∑ j ∈ Finset.range M, P j x := by
  unfold scratch_positiveKernelFinitePartial
  rw [MeasureTheory.lintegral_finsetSum' (Finset.range M)
    (fun j _ => hmeas j d x)]
  exact Finset.sum_le_sum (fun j _ => hdom j d x)

/-- A direction supremum is controlled by the Fatou limit of finite envelope
sums.  The hypotheses retain the order of operations required for the
canonical dyadic light-ray expansion: Tonelli at fixed direction, finite
triangle, then `iSup`, then Fatou. -/
theorem scratch_iSup_directional_le_liminf_finiteEnvelope
    {Z D X : Type*} [MeasurableSpace Z] (mu : Measure Z)
    (K : Nat → D → X → Z → ENNReal) (G : Z → ENNReal)
    (directional : D → X → ENNReal) (P : Nat → X → ENNReal)
    (hmeas : ∀ j d x, AEMeasurable (fun z => K j d x z * G z) mu)
    (hdir : ∀ d x,
      directional d x ≤ scratch_positiveKernelTsum mu K G d x)
    (hdom : ∀ j d x, ∫⁻ z, K j d x z * G z ∂mu ≤ P j x)
    (x : X) :
    (⨆ d : D, directional d x) ≤
      atTop.liminf (fun M => ∑ j ∈ Finset.range M, P j x) := by
  apply iSup_le
  intro d
  calc
    directional d x ≤ scratch_positiveKernelTsum mu K G d x := hdir d x
    _ = atTop.liminf (fun M =>
        scratch_positiveKernelFinitePartial mu K G M d x) :=
      scratch_positiveKernelTsum_eq_liminf_finitePartial mu K G hmeas d x
    _ ≤ atTop.liminf (fun M => ∑ j ∈ Finset.range M, P j x) := by
      apply Filter.liminf_le_liminf
      · exact Filter.Eventually.of_forall (fun M =>
          scratch_positiveKernelFinitePartial_le_sum_envelopes
            mu K G P hmeas hdom M d x)
      · exact by isBoundedDefault
      · exact by isBoundedDefault

/-- The raw envelope may be any function dominated by the directional
supremum; this avoids baking a particular supremum representation into the
Tonelli package. -/
theorem scratch_rawEnvelope_le_liminf_finiteEnvelope
    {Z D X : Type*} [MeasurableSpace Z] (mu : Measure Z)
    (K : Nat → D → X → Z → ENNReal) (G : Z → ENNReal)
    (raw : X → ENNReal) (directional : D → X → ENNReal)
    (P : Nat → X → ENNReal)
    (hmeas : ∀ j d x, AEMeasurable (fun z => K j d x z * G z) mu)
    (hraw : ∀ x, raw x ≤ ⨆ d : D, directional d x)
    (hdir : ∀ d x,
      directional d x ≤ scratch_positiveKernelTsum mu K G d x)
    (hdom : ∀ j d x, ∫⁻ z, K j d x z * G z ∂mu ≤ P j x)
    (x : X) :
    raw x ≤ atTop.liminf (fun M => ∑ j ∈ Finset.range M, P j x) :=
  (hraw x).trans
    (scratch_iSup_directional_le_liminf_finiteEnvelope
      mu K G directional P hmeas hdir hdom x)

/-- `L²` Fatou closure for the finite positive envelope sums.  Once a finite
signed-band theorem supplies the uniform right-hand side for these sums,
this returns the literal raw envelope estimate without a `sup`/`tsum`
interchange. -/
theorem scratch_eLpNorm_rawEnvelope_le_of_uniform_finiteEnvelope
    {Z D X : Type*} [MeasurableSpace Z] [MeasurableSpace X]
    (muZ : Measure Z) (muX : Measure X)
    (K : Nat → D → X → Z → ENNReal) (G : Z → ENNReal)
    (raw : X → ENNReal) (directional : D → X → ENNReal)
    (P : Nat → X → ENNReal) (B : ENNReal)
    (hmeasK : ∀ j d x, AEMeasurable (fun z => K j d x z * G z) muZ)
    (hraw : ∀ x, raw x ≤ ⨆ d : D, directional d x)
    (hdir : ∀ d x,
      directional d x ≤ scratch_positiveKernelTsum muZ K G d x)
    (hdom : ∀ j d x, ∫⁻ z, K j d x z * G z ∂muZ ≤ P j x)
    (hmeasP : ∀ M, Measurable (fun x => ∑ j ∈ Finset.range M, P j x))
    (hbound : ∀ M,
      eLpNorm (fun x => ∑ j ∈ Finset.range M, P j x) 2 muX ≤ B) :
    eLpNorm raw 2 muX ≤ B := by
  apply scratch_eLpNorm_le_of_ae_le_liminf_of_uniform
    (p := (2 : ENNReal)) (by norm_num) (by norm_num)
  · filter_upwards with x
    exact scratch_rawEnvelope_le_liminf_finiteEnvelope
      muZ K G raw directional P hmeasK hraw hdir hdom x
  · exact hmeasP
  · exact hbound

end

end Auto.Spherical.MSS
end
-- END ScratchKakeyaPositiveEnvelopeFatou

