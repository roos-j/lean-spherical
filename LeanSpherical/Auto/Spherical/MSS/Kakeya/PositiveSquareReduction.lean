  ∀ N : Nat, 3 < N → ∃ c r A B : Real,
    0 < c ∧ 0 < r ∧ 0 < A ∧ 0 ≤ B ∧
    ∀ delta : Real, 0 < delta → delta < 1 / 2 →
      ∃ k0 : Nat, ∃ cost : Nat → Real,
