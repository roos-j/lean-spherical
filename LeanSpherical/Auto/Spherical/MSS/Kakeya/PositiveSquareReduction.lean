section

section Auto.Spherical.MSS

open Filter MeasureTheory FourierTransform Set
open Auto.Spherical.SurfaceMeasureDecay
open Auto.Spherical.Auxiliary
open scoped BigOperators Convolution FourierTransform EuclideanSpace

noncomputable section

/-- Transport a time-dependent spatial-frequency profile along `omega`.  This
is the literal physical-space expression before any partial Fourier transform
is invoked. -/
noncomputable def scratch_spatialFourierTransport
    (G : Euclidean 2 → Real → Complex)
    (omega y : Euclidean 2) : Complex :=
  ∫ t : Real, FourierTransform.fourierInv (fun xi : Euclidean 2 => G xi t)
    (y - t • omega)

/-- Fubini gives the exact spatial-frequency representation of a transported
time-dependent profile.  The hypothesis is only joint integrability; no FIO
or angular estimate is assumed here. -/
theorem scratch_spatialFourierTransport_eq_fourierInv
    (G : Euclidean 2 → Real → Complex)
    (hG : Integrable (Function.uncurry G) (volume.prod volume))
    (omega y : Euclidean 2) :
    scratch_spatialFourierTransport G omega y =
      FourierTransform.fourierInv (fun xi : Euclidean 2 =>
        ∫ t : Real,
          (Real.fourierChar (inner Real ((-t) • omega) xi) : Complex) * G xi t) y := by
  let K : Euclidean 2 → Real → Complex := fun xi t =>
    (Real.fourierChar (inner Real xi y) : Complex) *
      ((Real.fourierChar (inner Real ((-t) • omega) xi) : Complex) * G xi t)
  have hphaseY : Continuous (fun z : Euclidean 2 × Real =>
      (Real.fourierChar (inner Real z.1 y) : Complex)) := by
    fun_prop
  have hphaseShift : Continuous (fun z : Euclidean 2 × Real =>
      (Real.fourierChar (inner Real ((-z.2) • omega) z.1) : Complex)) := by
    fun_prop
  have hK : Integrable (Function.uncurry K) (volume.prod volume) := by
    refine hG.congr' ?_ ?_
    · convert
        ((hphaseY.aestronglyMeasurable.mul hphaseShift.aestronglyMeasurable).mul
          hG.aestronglyMeasurable) using 1
      ext z
      rcases z with ⟨xi, t⟩
      dsimp only [K, Function.uncurry]
      simp only [Pi.mul_apply]
      change
        (Real.fourierChar (inner Real xi y) : Complex) *
            ((Real.fourierChar (inner Real ((-t) • omega) xi) : Complex) * G xi t) =
          (Real.fourierChar (inner Real xi y) : Complex) *
            (Real.fourierChar (inner Real ((-t) • omega) xi) : Complex) * G xi t
      ring
    · filter_upwards with z
      rcases z with ⟨xi, t⟩
      dsimp only [K, Function.uncurry]
      simp only [norm_mul, Circle.norm_coe, one_mul]
  have hKswap : Integrable
      (Function.uncurry (fun t : Real => fun xi : Euclidean 2 => K xi t))
      (volume.prod volume) := by
    convert hK.swap using 1
    ext z
    rcases z with ⟨t, xi⟩
    rfl
  have hswap :
      (∫ t : Real, ∫ xi : Euclidean 2, K xi t) =
        ∫ xi : Euclidean 2, ∫ t : Real, K xi t :=
    integral_integral_swap hKswap
  have hleft : scratch_spatialFourierTransport G omega y =
      ∫ t : Real, ∫ xi : Euclidean 2, K xi t := by
    unfold scratch_spatialFourierTransport
    apply integral_congr_ae
    filter_upwards with t
    rw [Real.fourierInv_eq]
    apply integral_congr_ae
    filter_upwards with xi
    have hphase : inner Real xi (y - t • omega) =
        inner Real xi y + inner Real ((-t) • omega) xi := by
      calc
        inner Real xi (y - t • omega) = inner Real xi (y + (-t) • omega) := by
          rw [neg_smul]
          rfl
        _ = inner Real xi y + inner Real ((-t) • omega) xi := by
          rw [inner_add_right]
          congr 1
          exact real_inner_comm _ _
    dsimp only [K]
    simp only [Circle.smul_def, smul_eq_mul, hphase, Real.fourierChar_apply,
      Complex.ofReal_add, mul_add]
    rw [add_mul, Complex.exp_add]
    ring
  have hinner (xi : Euclidean 2) :
      (∫ t : Real, K xi t) =
        (Real.fourierChar (inner Real xi y) : Complex) *
          ∫ t : Real,
            (Real.fourierChar (inner Real ((-t) • omega) xi) : Complex) * G xi t := by
    rw [← integral_const_mul]
  calc
    scratch_spatialFourierTransport G omega y =
        ∫ t : Real, ∫ xi : Euclidean 2, K xi t := hleft
    _ = ∫ xi : Euclidean 2, ∫ t : Real, K xi t := hswap
    _ = ∫ xi : Euclidean 2,
        (Real.fourierChar (inner Real xi y) : Complex) *
          ∫ t : Real,
            (Real.fourierChar (inner Real ((-t) • omega) xi) : Complex) * G xi t := by
      apply integral_congr_ae
      filter_upwards with xi
      exact hinner xi
    _ = FourierTransform.fourierInv (fun xi : Euclidean 2 =>
        ∫ t : Real,
          (Real.fourierChar (inner Real ((-t) • omega) xi) : Complex) * G xi t) y := by
      rw [Real.fourierInv_eq]
      apply integral_congr_ae
      filter_upwards with xi
      simp only [Circle.smul_def, smul_eq_mul]

/-- The preceding exact representation becomes a literal Plancherel identity
when its frequency profile is represented by a Schwartz map.  This keeps the
only regularity upgrade visible rather than silently treating an arbitrary
partial Fourier transform as Schwartz. -/
theorem scratch_spatialFourierTransport_integral_norm_sq_eq
    (G : Euclidean 2 → Real → Complex)
    (hG : Integrable (Function.uncurry G) (volume.prod volume))
    (omega : Euclidean 2)
    (B : SchwartzMap (Euclidean 2) Complex)
    (hB : ∀ xi : Euclidean 2, B xi =
      ∫ t : Real,
        (Real.fourierChar (inner Real ((-t) • omega) xi) : Complex) * G xi t) :
    (∫ y : Euclidean 2, ‖scratch_spatialFourierTransport G omega y‖ ^ 2) =
      ∫ xi : Euclidean 2, ‖B xi‖ ^ 2 := by
  have hfreq :
      (fun xi : Euclidean 2 => ∫ t : Real,
        (Real.fourierChar (inner Real ((-t) • omega) xi) : Complex) * G xi t) =
        (B : Euclidean 2 → Complex) := by
    funext xi
    exact (hB xi).symm
  have hpoint (y : Euclidean 2) :
      scratch_spatialFourierTransport G omega y =
        (FourierTransform.fourierInv B : SchwartzMap (Euclidean 2) Complex) y := by
    rw [scratch_spatialFourierTransport_eq_fourierInv G hG omega y, hfreq]
    rw [SchwartzMap.fourierInv_coe]
  calc
    (∫ y : Euclidean 2, ‖scratch_spatialFourierTransport G omega y‖ ^ 2) =
        ∫ y : Euclidean 2,
          ‖(FourierTransform.fourierInv B : SchwartzMap (Euclidean 2) Complex) y‖ ^ 2 := by
      apply integral_congr_ae
      filter_upwards with y
      rw [hpoint y]
    _ = ∫ xi : Euclidean 2,
        ‖FourierTransform.fourier
          ((FourierTransform.fourierInv B : SchwartzMap (Euclidean 2) Complex) :
            Euclidean 2 → Complex) xi‖ ^ 2 := by
      exact (Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq
        (FourierTransform.fourierInv B : SchwartzMap (Euclidean 2) Complex)).symm
    _ = ∫ xi : Euclidean 2, ‖B xi‖ ^ 2 := by
      apply integral_congr_ae
      filter_upwards with xi
      rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]

end

end Auto.Spherical.MSS
end
-- END ScratchPartialFourier

