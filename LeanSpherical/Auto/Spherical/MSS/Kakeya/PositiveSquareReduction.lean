    eLpNorm (pointwiseNormSquare v - pointwiseNormSquare u) 2 volume =
        eLpNorm (pointwiseNormSquare u - pointwiseNormSquare v) 2 volume :=
          by simpa only [eLpNorm_sub_comm]
    _ ≤ D * eLpNorm (u - v) 4 volume := by
      simpa only [D] using hsq
    _ ≤ D * ENNReal.ofReal eta :=
      by simpa only [mul_comm] using mul_le_mul_left herr.le D
    _ ≤ D * ENNReal.ofReal (b ()) := by
      simpa only [mul_comm] using
        mul_le_mul_left (ENNReal.ofReal_le_ofReal (min_le_left _ _)) D
    _ = ENNReal.ofReal (b ()) * D := mul_comm _ _
