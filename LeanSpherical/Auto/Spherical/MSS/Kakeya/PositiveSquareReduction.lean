/-- The canonical `j`th physical width is a fixed rescaling of the usual
dyadic width.  This is the exact normalization needed to import the existing
broad-width start lemma. -/
theorem canonicalBandlimitedDyadic_width_eq
    {delta r : Real} (hr : 0 < r) (j : Nat) :
    delta / canonicalBandlimitedDyadicScale r j =
      (2 * delta / r) * (2 : Real) ^ j := by
  unfold canonicalBandlimitedDyadicScale
  field_simp [hr.ne']

/-- The canonical dyadic family has a literal broad tail: every scale from
`k0` onward has physical width at least `1/2`, while the preceding indices are
the finite narrow block. -/
theorem exists_canonicalBandlimitedDyadic_broadWidthStart
    {delta r : Real} (hdelta : 0 < delta) (hr : 0 < r) :
    exists k0 : Nat,
      (forall j, k0 <= j ->
        (1 / 2 : Real) <= delta / canonicalBandlimitedDyadicScale r j) /\
      (forall j, j < k0 ->
        delta / canonicalBandlimitedDyadicScale r j < 1 / 2) := by
  have hdelta' : 0 < 2 * delta / r := by positivity
  obtain ⟨k0, hk0, hnarrow⟩ :=
    scratch_exists_dyadic_broadWidthStart (delta := 2 * delta / r) hdelta'
  refine ⟨k0, ?_, ?_⟩
  · intro j hj
    rw [canonicalBandlimitedDyadic_width_eq hr j]
    calc
      (1 / 2 : Real) <= (2 * delta / r) * (2 : Real) ^ k0 := hk0
      _ <= (2 * delta / r) * (2 : Real) ^ j := by
        apply mul_le_mul_of_nonneg_left
        · exact pow_le_pow_right₀ (by norm_num) hj
        · positivity
  · intro j hj
    rw [canonicalBandlimitedDyadic_width_eq hr j]
    exact hnarrow j hj

/-- Concrete broad-tail use of the canonical positive core at a literal unit
direction.  This is the kernel-side contribution to the unit model: it is
uniform in `omega : aux_lightRayDirection`, but is intentionally not asserted
as a bound for the signed reflected FIO envelope. -/
theorem exists_canonicalDyadic_broadPositiveEnvelope_unit
    {delta r : Real}
    (j : Nat)
    (hj : (1 / 2 : Real) <= delta / canonicalBandlimitedDyadicScale r j)
    (K : Nat) (omega : aux_lightRayDirection) (y x : Euclidean 2) (t : Real)
    (ht : t ∈ lightRayTimeInterval) :
    exists A : Real, 0 <= A /\
      HasCompactSupport
        (FourierTransform.fourier canonicalPositiveCore : Euclidean 2 -> Complex) /\
      scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
          (delta / canonicalBandlimitedDyadicScale r j) omega.1 y (x, t) <=
        ((6 : Real) ^ K * A) *
          lightRayKernel (delta / canonicalBandlimitedDyadicScale r j) K 0 x (y, 0) := by
  have homega : ‖omega.1‖ <= 1 := by
    exact (mem_unitLightRayDirections_iff omega.1).mp omega.2 |>.le
  exact scratch_exists_broadWidth_envelope_canonicalPositiveCore
    K hj omega.1 y x t homega ht

/-- The precise missing signed broad-width bridge.  Unlike the preceding
positive kernel theorem, this controls the actual reflected FIO scale
envelope on arbitrary signed finite tensors.  It is stated separately so the
positive broad tail is never silently substituted for it. -/
def HasCanonicalDyadicUnitSignedBroadScaleL2Estimate
    {c r : Real} (w : CanonicalReflectedScalePositiveUnitWiring c r) : Prop :=
  forall N : Nat, 3 < N -> exists B : Real, 0 <= B /\
    forall delta : Real, 0 < delta -> delta < 1 / 2 ->
      exists k0 : Nat,
        (forall j, k0 <= j ->
          (1 / 2 : Real) <= delta / canonicalBandlimitedDyadicScale r j) /\
        forall f : WaveSpaceTime -> Complex, InnerSlabSchwartzTensorCore f ->
          forall j, k0 <= j ->
            eLpNorm (fun y =>
              ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
                canonicalReflectedUnitScaleEnvelope w.S delta N f j y) 2 volume <=
              ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j * B) *
                eLpNorm f 2 volume

/-- Finite Minkowski packaging for the literal unit-direction canonical
envelope.  It is deliberately phrased in terms of already coefficient-weighted
one-scale estimates, so a broad-width argument can be supplied independently
of the narrow radial analysis. -/
theorem eLpNorm_canonicalReflectedUnitFiniteEnvelope_le_of_weightedScaleBounds
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (w : CanonicalReflectedScalePositiveUnitWiring c r)
    (delta : Real) (N : Nat) (f : WaveSpaceTime -> Complex)
    (hf : InnerSlabSchwartzTensorCore f) (M : Nat) (cost : Nat -> Real)
    (hcost : forall j, j ∈ Finset.range M -> 0 <= cost j)
    (hbound : forall j, j ∈ Finset.range M ->
      eLpNorm (fun y =>
        ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
          canonicalReflectedUnitScaleEnvelope w.S delta N f j y) 2 volume <=
        ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j * cost j) *
          eLpNorm f 2 volume) :
    eLpNorm (canonicalReflectedUnitFiniteEnvelope c r w.S delta N f M) 2 volume <=
      ENNReal.ofReal (∑ j ∈ Finset.range M,
        canonicalBandlimitedDyadicCoefficient N c r j * cost j) *
        eLpNorm f 2 volume := by
  have hcoeff : forall j : Nat, 0 <= canonicalBandlimitedDyadicCoefficient N c r j := by
    intro j
    unfold canonicalBandlimitedDyadicCoefficient
    positivity
  calc
    eLpNorm (canonicalReflectedUnitFiniteEnvelope c r w.S delta N f M) 2 volume =
        eLpNorm (∑ j ∈ Finset.range M, fun y =>
          ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
            canonicalReflectedUnitScaleEnvelope w.S delta N f j y) 2 volume := by
          apply congrArg (fun h => eLpNorm h 2 volume)
          funext y
          simp only [canonicalReflectedUnitFiniteEnvelope, Finset.sum_apply]
    _ <= ∑ j ∈ Finset.range M,
        eLpNorm (fun y =>
          ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
            canonicalReflectedUnitScaleEnvelope w.S delta N f j y) 2 volume := by
          apply eLpNorm_sum_le
          · intro j hj
            exact (measurable_const.mul (w.hScaleMeas delta N f j hf)).aestronglyMeasurable
          · norm_num
    _ <= ∑ j ∈ Finset.range M,
        ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j * cost j) *
          eLpNorm f 2 volume := by
          apply Finset.sum_le_sum
          intro j hj
          exact hbound j hj
    _ = (∑ j ∈ Finset.range M,
        ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j * cost j)) *
          eLpNorm f 2 volume := by
          rw [Finset.sum_mul]
    _ = ENNReal.ofReal (∑ j ∈ Finset.range M,
        canonicalBandlimitedDyadicCoefficient N c r j * cost j) *
          eLpNorm f 2 volume := by
          congr 1
          symm
          apply ENNReal.ofReal_sum_of_nonneg
          intro j hj
          exact mul_nonneg (hcoeff j) (hcost j hj)

/-- A one-scale narrow/broad input sufficient for the finite-envelope premise.
The broad clause is exactly the remaining signed broad-width estimate: it has
the literal `aux_lightRayDirection` supremum and no supremum over all of
`Euclidean 2`. -/
def HasCanonicalDyadicUnitWeightedScaleNarrowBroadL2Estimate
    (w : CanonicalReflectedScalePositiveUnitWiring c r) : Prop :=
  forall N : Nat, 3 < N -> exists A B : Real,
    0 < A /\ 0 <= B /\
    forall delta : Real, 0 < delta -> delta < 1 / 2 ->
      exists k0 : Nat, exists cost : Nat -> Real,
        (forall j, 0 <= cost j) /\
        (forall j, j < k0 ->
          cost j <= A * (1 + |Real.log delta|) ^ (3 / 2 : Real)) /\
        (forall j, k0 <= j -> cost j <= B) /\
        forall f : WaveSpaceTime -> Complex, InnerSlabSchwartzTensorCore f ->
          forall M j, j ∈ Finset.range M ->
            eLpNorm (fun y =>
              ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
                canonicalReflectedUnitScaleEnvelope w.S delta N f j y) 2 volume <=
              ENNReal.ofReal
                (canonicalBandlimitedDyadicCoefficient N c r j * cost j) *
                  eLpNorm f 2 volume

/-- Per-scale narrow/broad estimates assemble into the exact finite
unit-envelope premise consumed by the positive-square Fatou closure. -/
theorem hasCanonicalDyadicUnitNarrowBroadFiniteEnvelopeL2Estimate_of_weightedScale
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (w : CanonicalReflectedScalePositiveUnitWiring c r)
    (hscale : HasCanonicalDyadicUnitWeightedScaleNarrowBroadL2Estimate w) :
    HasCanonicalDyadicUnitNarrowBroadFiniteEnvelopeL2Estimate (w.toUnitModel hc hr) := by
  intro N hN
  obtain ⟨A, B, hA, hB, hdelta⟩ := hscale N hN
  refine ⟨c, r, A, B, hc, hr, hA, hB, ?_⟩
  intro delta hdeltaPos hdeltaSmall
  obtain ⟨k0, cost, hcost, hnarrow, hbroad, hscaleBound⟩ :=
    hdelta delta hdeltaPos hdeltaSmall
  refine ⟨k0, cost, hnarrow, hbroad, ?_⟩
  intro f hf M
  exact eLpNorm_canonicalReflectedUnitFiniteEnvelope_le_of_weightedScaleBounds
    hc hr w delta N f hf M cost
    (fun j hj => hcost j)
    (fun j hj => hscaleBound f hf M j hj)

/-- Direct terminal wrapper for the literal unit-direction reflected-square
wiring.  The only remaining analytic assumption is the stated one-scale
narrow/broad signed-envelope estimate. -/
theorem hasLightRayMaximalEstimate_of_canonicalReflectedSquareUnitWeightedScale
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (w : CanonicalReflectedScalePositiveUnitWiring c r)
    (hscale : HasCanonicalDyadicUnitWeightedScaleNarrowBroadL2Estimate w) :
    HasLightRayMaximalEstimate :=
  hasLightRayMaximalEstimate_of_canonicalDyadicUnitNarrowBroadFiniteEnvelope
    (w.toUnitModel hc hr)
    (hasCanonicalDyadicUnitNarrowBroadFiniteEnvelopeL2Estimate_of_weightedScale
      hc hr w hscale)

end

