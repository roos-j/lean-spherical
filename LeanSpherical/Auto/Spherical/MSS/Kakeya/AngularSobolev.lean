uses no smoothness in the parameter coordinate. -/
theorem hasNonstationaryPhaseIBPChain_parametric_of_jointSndSmooth
    {D : Real × Real → Real} {F : Real × Real → Complex} {rho a b : Real}
    {N : Nat}
    (hD : HasJointSndSmooth N D) (hF : HasJointSndSmooth N F)
    (hDne : ∀ p, D p ≠ 0)
    (hFleft : (fun u : Real => F (rho, u)) =ᶠ[nhds a] 0)
    (hFright : (fun u : Real => F (rho, u)) =ᶠ[nhds b] 0) :
    HasNonstationaryPhaseIBPChain a b (fun u : Real => D (rho, u))
      (fun k u => parametricNonstationaryIBPAmplitude D F k (rho, u)) N := by
  intro k hk
  have hDprev : HasJointSndSmooth (1 + k) D :=
    hD.of_le (by omega)
  have hFprev : HasJointSndSmooth (1 + k) F :=
    hF.of_le (by omega)
  have hAprev : HasJointSndSmooth 1
      (parametricNonstationaryIBPAmplitude D F k) :=
    hasJointSndSmooth_parametricNonstationaryIBPAmplitude
      (n := 1) (k := k) D F (by simpa [Nat.add_comm] using hDprev)
      (by simpa [Nat.add_comm] using hFprev) hDne
  have hDsmall : HasJointSndSmooth 1 D := hD.of_le (by omega)
  have hDinv : HasJointSndSmooth 1 (fun p => ((D p : Real) : Complex)⁻¹) :=
    (HasJointSndSmooth.ofReal hDsmall).inv
      (fun p => Complex.ofReal_ne_zero.mpr (hDne p))
