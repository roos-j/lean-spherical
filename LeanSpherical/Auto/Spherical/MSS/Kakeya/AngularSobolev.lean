section Auto.Spherical.MSS

open MeasureTheory Set
open Auto.OneDimStationaryPhase
open scoped BigOperators

noncomputable section

/-- The finite angular `L²` energy of a Fourier polynomial. -/
def l2Energy (s : Finset Int) (c : Int → Complex) : Real :=
  ∑ n ∈ s, ‖c n‖ ^ 2

/-- The finite angular `H¹` energy, with the integer Fourier frequency as
the derivative weight. -/
def h1Energy (s : Finset Int) (c : Int → Complex) : Real :=
  ∑ n ∈ s, (Int.natAbs n : Real) ^ 2 * ‖c n‖ ^ 2

/-- The finite critical angular energy.  Under finite Fourier Parseval this
is the squared `H^{1/2}` norm (up to the harmless zeroth-order term). -/
def halfEnergy (s : Finset Int) (c : Int → Complex) : Real :=
  ∑ n ∈ s, (1 + (Int.natAbs n : Real)) * ‖c n‖ ^ 2

/-- Finite Fourier Cauchy--Schwarz at the critical half derivative. -/
theorem halfDerivative_cross_sq_le
    (s : Finset Int) (c : Int → Complex) :
    (∑ n ∈ s, (Int.natAbs n : Real) * ‖c n‖ ^ 2) ^ 2 ≤
      l2Energy s c * h1Energy s c := by
  unfold l2Energy h1Energy
  refine Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul s
    (r := fun n => (Int.natAbs n : Real) * ‖c n‖ ^ 2)
    (f := fun n => ‖c n‖ ^ 2)
    (g := fun n => (Int.natAbs n : Real) ^ 2 * ‖c n‖ ^ 2) ?_ ?_ ?_
  · intro n hn
    exact sq_nonneg _
  · intro n hn
    exact mul_nonneg (sq_nonneg _) (sq_nonneg _)
  · intro n hn
    calc
      ((Int.natAbs n : Real) * ‖c n‖ ^ 2) ^ 2 =
          (Int.natAbs n : Real) ^ 2 * (‖c n‖ ^ 2) ^ 2 := by
            rw [mul_pow]
      _ = ‖c n‖ ^ 2 * ((Int.natAbs n : Real) ^ 2 * ‖c n‖ ^ 2) := by ring
      _ ≤ ‖c n‖ ^ 2 * ((Int.natAbs n : Real) ^ 2 * ‖c n‖ ^ 2) := le_rfl

/-- The finite critical angular energy is controlled by the geometric mean
of the `L²` and first-derivative energies.  This is the exact interpolation
step needed after the two TT* Schur estimates. -/
theorem halfEnergy_le_l2_add_sqrt_mul
    (s : Finset Int) (c : Int → Complex) :
    halfEnergy s c ≤ l2Energy s c + Real.sqrt (l2Energy s c * h1Energy s c) := by
  have hcross := halfDerivative_cross_sq_le s c
  have hzero : 0 ≤ ∑ n ∈ s, (Int.natAbs n : Real) * ‖c n‖ ^ 2 := by
    exact Finset.sum_nonneg fun n hn => mul_nonneg (by positivity) (sq_nonneg _)
  have hl2 : 0 ≤ l2Energy s c := by
    unfold l2Energy
    exact Finset.sum_nonneg fun n hn => sq_nonneg _
  have hh1 : 0 ≤ h1Energy s c := by
    unfold h1Energy
    exact Finset.sum_nonneg fun n hn => mul_nonneg (sq_nonneg _) (sq_nonneg _)
  have hprod : 0 ≤ l2Energy s c * h1Energy s c := by
    exact mul_nonneg hl2 hh1
  have hcross' :
      (∑ n ∈ s, (Int.natAbs n : Real) * ‖c n‖ ^ 2) ≤
        Real.sqrt (l2Energy s c * h1Energy s c) := by
    apply (sq_le_sq₀ hzero (Real.sqrt_nonneg _)).mp
    calc
      (∑ n ∈ s, (Int.natAbs n : Real) * ‖c n‖ ^ 2) ^ 2 ≤
          l2Energy s c * h1Energy s c := hcross
      _ = Real.sqrt (l2Energy s c * h1Energy s c) ^ 2 :=
        (Real.sq_sqrt hprod).symm
  unfold halfEnergy l2Energy
  calc
    (∑ n ∈ s, (1 + (Int.natAbs n : Real)) * ‖c n‖ ^ 2) =
        (∑ n ∈ s, ‖c n‖ ^ 2) +
          ∑ n ∈ s, (Int.natAbs n : Real) * ‖c n‖ ^ 2 := by
      calc
        (∑ n ∈ s, (1 + (Int.natAbs n : Real)) * ‖c n‖ ^ 2) =
            ∑ n ∈ s, (‖c n‖ ^ 2 +
              (Int.natAbs n : Real) * ‖c n‖ ^ 2) := by
              apply Finset.sum_congr rfl
              intro n hn
              ring
        _ = (∑ n ∈ s, ‖c n‖ ^ 2) +
            ∑ n ∈ s, (Int.natAbs n : Real) * ‖c n‖ ^ 2 := by
              rw [Finset.sum_add_distrib]
    _ ≤ (∑ n ∈ s, ‖c n‖ ^ 2) +
          Real.sqrt ((∑ n ∈ s, ‖c n‖ ^ 2) * h1Energy s c) := by
      exact add_le_add_right (by simpa [l2Energy] using hcross') _
    _ = l2Energy s c + Real.sqrt (l2Energy s c * h1Energy s c) := by
      rfl

/-- The literal angular phase after spatial Plancherel in the light-ray
`TT*` calculation.  Unlike the Fourier-in-angle phase, it has no extra
linear `sigma * theta` term. -/
def circleTTStarPhase (xi1 xi2 theta : Real) : Real :=
  xi1 * Real.cos theta + xi2 * Real.sin theta

/-- The central angular shell needs no Airy estimate: its width itself
controls the actual circle-phase kernel. -/
theorem norm_intervalIntegral_circleTTStarPhase_le
    {a b tau xi1 xi2 M : Real} (F : Real → Complex)
    (hF : ∀ theta ∈ uIoc a b, ‖F theta‖ ≤ M) :
    ‖∫ theta in a..b,
      F theta * Complex.exp
        (((tau * circleTTStarPhase xi1 xi2 theta : Real) : Complex) * Complex.I)‖ ≤
      M * |b - a| := by
  apply intervalIntegral.norm_integral_le_of_norm_le_const
  intro theta htheta
  rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one]
  exact hF theta htheta

/-- Product-amplitude central-shell bound in the exact form of a `TT*`
kernel. -/
theorem norm_centralCircleTTStarProductKernel_le
    {theta0 rho tau xi1 xi2 M L : Real} (hRho : 0 ≤ rho)
    (hM : 0 ≤ M)
    (F G : Real → Complex)
    (hF : ∀ theta ∈ uIoc (theta0 - rho / 2) (theta0 + rho / 2), ‖F theta‖ ≤ M)
    (hG : ∀ theta ∈ uIoc (theta0 - rho / 2) (theta0 + rho / 2), ‖G theta‖ ≤ L) :
    ‖∫ theta in (theta0 - rho / 2)..(theta0 + rho / 2),
      (F theta * starRingEnd Complex (G theta)) * Complex.exp
        (((tau * circleTTStarPhase xi1 xi2 theta : Real) : Complex) * Complex.I)‖ ≤
      M * L * rho := by
  have hbase := norm_intervalIntegral_circleTTStarPhase_le
    (a := theta0 - rho / 2) (b := theta0 + rho / 2) (tau := tau)
    (xi1 := xi1) (xi2 := xi2)
    (M := M * L) (fun theta => F theta * starRingEnd Complex (G theta)) (by
      intro theta htheta
      rw [norm_mul, RCLike.norm_conj]
      exact mul_le_mul (hF theta htheta) (hG theta htheta)
        (norm_nonneg _) hM)
  have hlength : |(theta0 + rho / 2) - (theta0 - rho / 2)| = rho := by
    rw [abs_of_nonneg]
    · ring
    · linarith
  calc
    ‖∫ theta in (theta0 - rho / 2)..(theta0 + rho / 2),
        (F theta * starRingEnd Complex (G theta)) * Complex.exp
          (((tau * circleTTStarPhase xi1 xi2 theta : Real) : Complex) * Complex.I)‖ ≤
        (M * L) * |(theta0 + rho / 2) - (theta0 - rho / 2)| := hbase
    _ = M * L * rho := by rw [hlength]

/-- After writing an outer stationary-angle shell as `theta = rho * u`, the
literal circular phase is this dimensionless function (up to its harmless
constant critical value). -/
def outerCircleShellPhase (rho u : Real) : Real :=
  (Real.cos (rho * u) - 1) / rho ^ 2

/-- The literal derivative of `outerCircleShellPhase`. -/
def outerCircleShellPhaseDeriv (rho u : Real) : Real :=
  -Real.sin (rho * u) / rho

/-- A fixed smooth guard which is one on the rescaled shell `[1/2,2]` and
vanishes outside the slightly larger interval `(1/4,9/4)`.  It lets us replace
the local circle derivative by a globally nonvanishing smooth extension
without changing it on the integral. -/
noncomputable def outerCircleUnitShellGuard : ContDiffBump (5 / 4 : Real) :=
  ⟨(7 : Real) / 8, 1, by norm_num, by norm_num⟩

/-- A concrete fixed cutoff supported strictly inside the unit outer shell.
This is the model rescaled dyadic angular cutoff. -/
noncomputable def fixedOuterCircleUnitShellBump : ContDiffBump (5 / 4 : Real) :=
  ⟨(1 : Real) / 4, (3 : Real) / 8, by norm_num, by norm_num⟩

/-- The complex amplitude associated to the fixed real shell bump. -/
noncomputable def fixedOuterCircleUnitShellAmplitude (u : Real) : Complex :=
  (fixedOuterCircleUnitShellBump u : Real)

theorem contDiff_fixedOuterCircleUnitShellAmplitude :
    ContDiff Real (⊤ : ℕ∞) fixedOuterCircleUnitShellAmplitude := by
  change ContDiff Real (⊤ : ℕ∞)
    (Complex.ofRealCLM ∘ fixedOuterCircleUnitShellBump)
  exact Complex.ofRealCLM.contDiff.comp fixedOuterCircleUnitShellBump.contDiff

/-- The fixed rescaled shell cutoff is jointly smooth when regarded as a
family constant in the shell-width parameter. -/
theorem contDiff_fixedOuterCircleUnitShellAmplitude_joint :
    ContDiff Real (⊤ : ℕ∞)
      (fun p : Real × Real => fixedOuterCircleUnitShellAmplitude p.2) := by
  exact contDiff_fixedOuterCircleUnitShellAmplitude.comp contDiff_snd

/-- The fixed bump vanishes in a neighbourhood of the left artificial shell
endpoint, as required by the automatic IBP-chain constructor. -/
theorem fixedOuterCircleUnitShellAmplitude_eventuallyEq_zero_left :
    fixedOuterCircleUnitShellAmplitude =ᶠ[nhds (1 / 2 : Real)] 0 := by
  have hdist : ContinuousAt (fun u : Real => dist u (5 / 4 : Real)) (1 / 2 : Real) := by
    fun_prop
  have hsep : (3 / 8 : Real) < dist (1 / 2 : Real) (5 / 4 : Real) := by
    rw [Real.dist_eq]
    norm_num
  filter_upwards [hdist.tendsto.eventually (eventually_gt_nhds hsep)] with u hu
  unfold fixedOuterCircleUnitShellAmplitude
  rw [fixedOuterCircleUnitShellBump.zero_of_le_dist hu.le]
  rfl

/-- The same fixed bump vanishes near the right artificial shell endpoint. -/
theorem fixedOuterCircleUnitShellAmplitude_eventuallyEq_zero_right :
    fixedOuterCircleUnitShellAmplitude =ᶠ[nhds (2 : Real)] 0 := by
  have hdist : ContinuousAt (fun u : Real => dist u (5 / 4 : Real)) (2 : Real) := by
    fun_prop
  have hsep : (3 / 8 : Real) < dist (2 : Real) (5 / 4 : Real) := by
    rw [Real.dist_eq]
    norm_num
  filter_upwards [hdist.tendsto.eventually (eventually_gt_nhds hsep)] with u hu
  unfold fixedOuterCircleUnitShellAmplitude
  rw [fixedOuterCircleUnitShellBump.zero_of_le_dist hu.le]
  rfl

/-- A global smooth nonzero extension of the circle-shell derivative.  The
constant negative value off the guard is deliberately chosen with the same
sign as the circle derivative on the positive outer shell. -/
noncomputable def outerCircleShellDerivativeExtension (rho u : Real) : Real :=
  outerCircleUnitShellGuard u * outerCircleShellPhaseDeriv rho u -
    (1 - outerCircleUnitShellGuard u)

/-- The removable-singularity version of the rescaled circle derivative.  It
is continuous jointly in `(rho,u)` all the way through `rho = 0`. -/
noncomputable def outerCircleScaledDerivative (rho u : Real) : Real :=
  -u * Real.sinc (rho * u)

/-- A jointly continuous version of the guarded derivative extension.  For
positive `rho` it agrees pointwise with the extension used in the IBP chain. -/
noncomputable def outerCircleUniformDerivativeExtension (rho u : Real) : Real :=
  outerCircleUnitShellGuard u * outerCircleScaledDerivative rho u -
    (1 - outerCircleUnitShellGuard u)

theorem continuous_outerCircleScaledDerivative_joint :
    Continuous (fun p : Real × Real => outerCircleScaledDerivative p.1 p.2) := by
  unfold outerCircleScaledDerivative
  fun_prop

theorem continuous_outerCircleUniformDerivativeExtension_joint :
    Continuous (fun p : Real × Real => outerCircleUniformDerivativeExtension p.1 p.2) := by
  unfold outerCircleUniformDerivativeExtension
  exact ((outerCircleUnitShellGuard.continuous.comp continuous_snd).mul
      continuous_outerCircleScaledDerivative_joint).sub
    (continuous_const.sub (outerCircleUnitShellGuard.continuous.comp continuous_snd))

/-- Away from `rho*u = 0`, the sinc representative is exactly the literal
circle derivative. -/
theorem outerCircleScaledDerivative_eq_literal
    {rho u : Real} (hrho : rho ≠ 0) (hu : u ≠ 0) :
    outerCircleScaledDerivative rho u = outerCircleShellPhaseDeriv rho u := by
  unfold outerCircleScaledDerivative outerCircleShellPhaseDeriv
  rw [Real.sinc_of_ne_zero (mul_ne_zero hrho hu)]
  field_simp [hrho, hu]

/-- For every nonzero width the sinc family is literally the usual quotient
as a function of `u`, including at `u = 0`. -/
theorem outerCircleScaledDerivative_eq_literal_fun
    {rho : Real} (hrho : rho ≠ 0) :
    outerCircleScaledDerivative rho = outerCircleShellPhaseDeriv rho := by
  funext u
  by_cases hu : u = 0
  · subst u
    simp [outerCircleScaledDerivative, outerCircleShellPhaseDeriv]
  · exact outerCircleScaledDerivative_eq_literal hrho hu

/-- The removable-singularity representative has the expected first
`u`-derivative for *all* widths, including `rho = 0`. -/
theorem hasDerivAt_outerCircleScaledDerivative
    (rho u : Real) :
    HasDerivAt (outerCircleScaledDerivative rho) (-Real.cos (rho * u)) u := by
  by_cases hrho : rho = 0
  · subst rho
    have hbase : outerCircleScaledDerivative 0 = fun v : Real => -v := by
      funext v
      simp [outerCircleScaledDerivative]
    rw [hbase]
    simpa using (hasDerivAt_neg' u)
  · rw [outerCircleScaledDerivative_eq_literal_fun hrho]
    unfold outerCircleShellPhaseDeriv
    have hsin : HasDerivAt (fun v : Real => Real.sin (rho * v))
        (Real.cos (rho * u) * rho) u := by
      have harg : HasDerivAt (fun v : Real => rho * v) rho u := by
        simpa [mul_comm] using (hasDerivAt_const_mul (x := u) rho)
      simpa [Function.comp_def, mul_comm] using
        (Real.hasDerivAt_sin (rho * u)).comp u harg
    have h := hsin.neg.div_const rho
    have hderiv : -(Real.cos (rho * u) * rho) / rho = -Real.cos (rho * u) := by
      field_simp [hrho]
    rw [hderiv] at h
    exact h

/-- Its second `u`-derivative is again a jointly continuous elementary
trigonometric expression. -/
theorem hasDerivAt_deriv_outerCircleScaledDerivative
    (rho u : Real) :
    HasDerivAt (fun v : Real => deriv (outerCircleScaledDerivative rho) v)
      (rho * Real.sin (rho * u)) u := by
  have hfun : (fun v : Real => deriv (outerCircleScaledDerivative rho) v) =
      fun v : Real => -Real.cos (rho * v) := by
    funext v
    exact (hasDerivAt_outerCircleScaledDerivative rho v).deriv
  rw [hfun]
  have harg : HasDerivAt (fun v : Real => rho * v) rho u := by
    simpa [mul_comm] using (hasDerivAt_const_mul (x := u) rho)
  have hcos := (Real.hasDerivAt_cos (rho * u)).comp u harg
  simpa [Function.comp_def, mul_assoc, mul_comm, mul_left_comm] using hcos.const_mul (-1)

/-- A full angular derivative jet for the removable-singularity circle
derivative.  Only its zeroth member uses `sinc`; every positive derivative is
an elementary trigonometric expression with a nonnegative power of `rho`. -/
noncomputable def outerCircleScaledDerivativeJet : Nat → Real × Real → Real
  | 0 => fun p => outerCircleScaledDerivative p.1 p.2
  | Nat.succ n => fun p => p.1 ^ n *
      iteratedDeriv (n + 1) (fun x : Real => -Real.sin x) (p.1 * p.2)

/-- Each member of the circle derivative jet is jointly continuous all the
way through the degenerate width `rho = 0`. -/
theorem continuous_outerCircleScaledDerivativeJet
    (n : Nat) : Continuous (outerCircleScaledDerivativeJet n) := by
  cases n with
  | zero => exact continuous_outerCircleScaledDerivative_joint
  | succ n =>
      have hbase : ContDiff Real (⊤ : ℕ∞) (fun x : Real => -Real.sin x) :=
        Real.contDiff_sin.neg
      have hiter : Continuous (iteratedDeriv (n + 1) (fun x : Real =>
          -Real.sin x)) :=
        hbase.continuous_iteratedDeriv (n + 1) (by
          change (((n + 1 : Nat) : ℕ∞) : WithTop ℕ∞) ≤
            ((⊤ : ℕ∞) : WithTop ℕ∞)
          exact WithTop.coe_le_coe.mpr le_top)
      unfold outerCircleScaledDerivativeJet
      exact (continuous_fst.pow n).mul
        (hiter.comp (continuous_fst.mul continuous_snd))

/-- Consecutive members of the displayed jet are the actual derivatives in
the angular coordinate. -/
theorem hasDerivAt_outerCircleScaledDerivativeJet
    (n : Nat) (rho u : Real) :
    HasDerivAt (fun v : Real => outerCircleScaledDerivativeJet n (rho, v))
      (outerCircleScaledDerivativeJet (n + 1) (rho, u)) u := by
  cases n with
  | zero =>
      simpa [outerCircleScaledDerivativeJet, iteratedDeriv_succ] using
        hasDerivAt_outerCircleScaledDerivative rho u
  | succ n =>
      let g : Real → Real := fun x => -Real.sin x
      have hg : ContDiff Real (⊤ : ℕ∞) g := Real.contDiff_sin.neg
      have hdiff : Differentiable Real (iteratedDeriv (n + 1) g) :=
        hg.differentiable_iteratedDeriv (n + 1) (by
          change (((n + 1 : Nat) : ℕ∞) : WithTop ℕ∞) <
            ((⊤ : ℕ∞) : WithTop ℕ∞)
          exact WithTop.coe_lt_coe.mpr (ENat.coe_lt_top (n + 1)))
      have hbase : HasDerivAt (iteratedDeriv (n + 1) g)
          (iteratedDeriv (n + 2) g (rho * u)) (rho * u) := by
        simpa only [iteratedDeriv_succ] using (hdiff (rho * u)).hasDerivAt
      have harg : HasDerivAt (fun v : Real => rho * v) rho u := by
        simpa [mul_comm] using (hasDerivAt_const_mul (x := u) rho)
      have h := (hbase.comp u harg).const_mul (rho ^ n)
      unfold outerCircleScaledDerivativeJet
      dsimp [g] at h ⊢
      have hcoef : rho ^ n *
          (iteratedDeriv (n + 2) (fun x : Real => -Real.sin x) (rho * u) * rho) =
          rho ^ (n + 1) *
            iteratedDeriv (n + 1 + 1) (fun x : Real => -Real.sin x) (rho * u) := by
        rw [show n + 1 + 1 = n + 2 by omega, pow_succ]
        ring
      rw [hcoef] at h
      exact h

/-- The jointly continuous extension agrees with the original globally smooth
extension whenever `rho` is nonzero. -/
theorem outerCircleUniformDerivativeExtension_eq
    {rho : Real} (hrho : rho ≠ 0) :
    outerCircleUniformDerivativeExtension rho = outerCircleShellDerivativeExtension rho := by
  funext u
  by_cases hguard : outerCircleUnitShellGuard u = 0
  · simp [outerCircleUniformDerivativeExtension, outerCircleShellDerivativeExtension, hguard]
  · have hdist : dist u (5 / 4 : Real) < 1 := by
      apply lt_of_not_ge
      intro hdist
      exact hguard (outerCircleUnitShellGuard.zero_of_le_dist hdist)
    have hu_range : u ∈ Ioo (1 / 4 : Real) (9 / 4 : Real) := by
      rw [Real.dist_eq, abs_lt] at hdist
      constructor <;> linarith
    have hu : u ≠ 0 := by linarith [hu_range.1]
    unfold outerCircleUniformDerivativeExtension outerCircleShellDerivativeExtension
    rw [outerCircleScaledDerivative_eq_literal hrho hu]

/-- The first derivative in the shell coordinate of the jointly continuous
extension. -/
noncomputable def outerCircleUniformDerivativeExtensionDu (rho u : Real) : Real :=
  deriv outerCircleUnitShellGuard u * outerCircleScaledDerivative rho u +
    outerCircleUnitShellGuard u * (-Real.cos (rho * u)) +
      deriv outerCircleUnitShellGuard u

theorem hasDerivAt_outerCircleUniformDerivativeExtension
    (rho u : Real) :
    HasDerivAt (outerCircleUniformDerivativeExtension rho)
      (outerCircleUniformDerivativeExtensionDu rho u) u := by
  have hguardCont : ContDiff Real (1 : ℕ∞) outerCircleUnitShellGuard :=
    outerCircleUnitShellGuard.contDiff (n := (1 : ℕ∞))
  have hguard : HasDerivAt outerCircleUnitShellGuard
      (deriv outerCircleUnitShellGuard u) u :=
    (hguardCont.differentiable_one u).hasDerivAt
  have hscaled := hasDerivAt_outerCircleScaledDerivative rho u
  have hleft := hguard.mul hscaled
  have hright := (hasDerivAt_const u (1 : Real)).sub hguard
  have h := hleft.sub hright
  change HasDerivAt
    (fun v : Real => outerCircleUnitShellGuard v * outerCircleScaledDerivative rho v -
      (1 - outerCircleUnitShellGuard v)) _ u at h
  change HasDerivAt
    (fun v : Real => outerCircleUnitShellGuard v * outerCircleScaledDerivative rho v -
      (1 - outerCircleUnitShellGuard v)) _ u
  simpa [outerCircleUniformDerivativeExtensionDu] using h

theorem continuous_outerCircleUniformDerivativeExtensionDu_joint :
    Continuous (fun p : Real × Real => outerCircleUniformDerivativeExtensionDu p.1 p.2) := by
  have hguard : Continuous (fun p : Real × Real =>
      deriv outerCircleUnitShellGuard p.2) :=
    ((contDiff_infty_iff_deriv.mp outerCircleUnitShellGuard.contDiff).2.continuous).comp
      continuous_snd
  have hcos : Continuous (fun p : Real × Real => -Real.cos (p.1 * p.2)) := by
    fun_prop
  unfold outerCircleUniformDerivativeExtensionDu
  exact ((hguard.mul continuous_outerCircleScaledDerivative_joint).add
    ((outerCircleUnitShellGuard.continuous.comp continuous_snd).mul hcos)).add hguard

/-- The derivative in the second coordinate of a jointly defined family.  We
write it through `fderiv` because that formulation is stable under joint
`ContDiff` and hence under arbitrary fixed finite iteration. -/
noncomputable def partialDerivSnd
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    (H : Real × Real → E) (p : Real × Real) : E :=
  fderiv Real H p (0, 1)

/-- Joint smoothness is preserved by taking the derivative in the second
coordinate. -/
theorem contDiff_partialDerivSnd
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    (H : Real × Real → E)
    (hH : ContDiff Real (⊤ : ℕ∞) H) :
    ContDiff Real (⊤ : ℕ∞) (partialDerivSnd H) := by
  unfold partialDerivSnd
  let j : Real × Real → (Real × Real) × (Real × Real) :=
    fun p => (p, (0, 1))
  have hj : ContDiff Real (⊤ : ℕ∞) j := by
    dsimp [j]
    fun_prop
  have hderiv : ContDiff Real (⊤ : ℕ∞)
      (fun q : (Real × Real) × (Real × Real) =>
        (fderiv Real H q.1 : (Real × Real) →L[Real] E) q.2) :=
    hH.contDiff_fderiv_apply (m := (⊤ : ℕ∞)) (by simp)
  exact hderiv.comp hj

/-- Evaluation of `partialDerivSnd` is the ordinary derivative of the
corresponding one-parameter slice. -/
theorem deriv_slice_eq_partialDerivSnd
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    (H : Real × Real → E) (hH : Differentiable Real H)
    (rho u : Real) :
    deriv (fun v : Real => H (rho, v)) u =
      partialDerivSnd H (rho, u) := by
  let j : Real → Real × Real := fun v => (rho, v)
  have hj : HasDerivAt j (0, 1) u := by
    dsimp [j]
    exact (hasDerivAt_const u rho).prodMk (hasDerivAt_id u)
  have hHAt : HasFDerivAt H (fderiv Real H (rho, u)) (rho, u) :=
    (hH (rho, u)).hasFDerivAt
  have hcomp := hHAt.comp u hj.hasFDerivAt
  have hcomp' : HasDerivAt (fun v : Real => H (rho, v))
      (partialDerivSnd H (rho, u)) u := by
    unfold partialDerivSnd
    convert hcomp.hasDerivAt using 1 <;>
      simp [Function.comp_def, ContinuousLinearMap.comp_apply]
  exact hcomp'.deriv

/-- The stronger `HasDerivAt` form of the slice identification. -/
theorem hasDerivAt_slice_partialDerivSnd
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    (H : Real × Real → E) (hH : Differentiable Real H)
    (rho u : Real) :
    HasDerivAt (fun v : Real => H (rho, v))
      (partialDerivSnd H (rho, u)) u := by
  let j : Real → Real × Real := fun v => (rho, v)
  have hj : HasDerivAt j (0, 1) u := by
    dsimp [j]
    exact (hasDerivAt_const u rho).prodMk (hasDerivAt_id u)
  have hHAt : HasFDerivAt H (fderiv Real H (rho, u)) (rho, u) :=
    (hH (rho, u)).hasFDerivAt
  have hcomp := hHAt.comp u hj.hasFDerivAt
  unfold partialDerivSnd
  convert hcomp.hasDerivAt using 1 <;>
    simp [Function.comp_def, ContinuousLinearMap.comp_apply]

/-- A family is `HasJointSndSmooth n` when its first `n` derivatives in the
second (angular) coordinate can be chosen jointly continuous in both
parameters.  No derivative in the shell-width parameter is requested. -/
def HasJointSndSmooth
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E] :
    Nat → (Real × Real → E) → Prop
  | 0, H => Continuous H
  | Nat.succ n, H =>
      HasJointSndSmooth n H ∧ ∃ H' : Real × Real → E,
        HasJointSndSmooth n H' ∧
          ∀ rho u : Real, HasDerivAt (fun v : Real => H (rho, v))
            (H' (rho, u)) u

/-- A full jointly continuous angular jet supplies every finite
`HasJointSndSmooth` datum. -/
theorem hasJointSndSmooth_of_fullJet
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    (J : Nat → Real × Real → E)
    (hcont : ∀ n, Continuous (J n))
    (hderiv : ∀ (n : Nat) (rho u : Real), HasDerivAt (fun v : Real => J n (rho, v))
      (J (n + 1) (rho, u)) u) :
    ∀ m n : Nat, HasJointSndSmooth n (J m) := by
  intro m n
  induction n generalizing m with
  | zero => exact hcont m
  | succ n ih =>
      refine ⟨ih m, J (m + 1), ih (m + 1), ?_⟩
      intro rho u
      simpa [Nat.succ_eq_add_one] using hderiv m rho u

/-- Joint `C^∞` is more than enough to supply a full angular-smoothness
jet. -/
theorem hasJointSndSmooth_of_contDiff
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    (H : Real × Real → E) (hH : ContDiff Real (⊤ : ℕ∞) H) :
    ∀ n : Nat, HasJointSndSmooth n H := by
  intro n
  induction n generalizing H with
  | zero => exact hH.continuous
  | succ n ih =>
      refine ⟨ih H hH, partialDerivSnd H,
        ih (partialDerivSnd H) (contDiff_partialDerivSnd H hH), ?_⟩
      intro rho u
      exact hasDerivAt_slice_partialDerivSnd H
        (hH.differentiable (by simp)) rho u

/-- Constant families have arbitrarily many jointly continuous angular
derivatives. -/
theorem HasJointSndSmooth.const
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    (n : Nat) (c : E) : HasJointSndSmooth n (fun _ : Real × Real => c) :=
  hasJointSndSmooth_of_contDiff (fun _ : Real × Real => c) contDiff_const n

/-- Angular-smoothness jets are closed under negation. -/
theorem HasJointSndSmooth.neg
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    {n : Nat} {H : Real × Real → E}
    (hH : HasJointSndSmooth n H) :
    HasJointSndSmooth n (fun p => -H p) := by
  induction n generalizing H with
  | zero => exact Continuous.neg hH
  | succ n ih =>
      rcases hH with ⟨hH, H', hH', hderiv⟩
      refine ⟨ih hH, fun p => -H' p, ih hH', ?_⟩
      intro rho u
      change HasDerivAt (-(fun v : Real => H (rho, v))) _ u
      exact (hderiv rho u).neg

/-- Angular-smoothness jets are closed under addition. -/
theorem HasJointSndSmooth.add
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    {n : Nat} {H K : Real × Real → E}
    (hH : HasJointSndSmooth n H) (hK : HasJointSndSmooth n K) :
    HasJointSndSmooth n (fun p => H p + K p) := by
  induction n generalizing H K with
  | zero => exact Continuous.add hH hK
  | succ n ih =>
      rcases hH with ⟨hH, H', hH', hHderiv⟩
      rcases hK with ⟨hK, K', hK', hKderiv⟩
      refine ⟨ih hH hK, fun p => H' p + K' p, ih hH' hK', ?_⟩
      intro rho u
      change HasDerivAt ((fun v : Real => H (rho, v)) +
        (fun v : Real => K (rho, v))) _ u
      exact (hHderiv rho u).add (hKderiv rho u)

/-- Real angular-smoothness jets may be transported through the real-to-complex
linear map. -/
theorem HasJointSndSmooth.ofReal
    {n : Nat} {H : Real × Real → Real}
    (hH : HasJointSndSmooth n H) :
    HasJointSndSmooth n (fun p => (H p : Complex)) := by
  induction n generalizing H with
  | zero => exact Complex.continuous_ofReal.comp hH
  | succ n ih =>
      rcases hH with ⟨hH, H', hH', hderiv⟩
      refine ⟨ih hH, fun p => (H' p : Complex), ih hH', ?_⟩
      intro rho u
      simpa using (hderiv rho u).ofReal_comp

/-- Angular-smoothness jets are closed under complex multiplication. -/
theorem HasJointSndSmooth.mul
    {n : Nat} {H K : Real × Real → Complex}
    (hH : HasJointSndSmooth n H) (hK : HasJointSndSmooth n K) :
    HasJointSndSmooth n (fun p => H p * K p) := by
  induction n generalizing H K with
  | zero => exact Continuous.mul hH hK
  | succ n ih =>
      rcases hH with ⟨hH, H', hH', hHderiv⟩
      rcases hK with ⟨hK, K', hK', hKderiv⟩
      refine ⟨ih hH hK, fun p => H' p * K p + H p * K' p,
        (ih hH' hK).add (ih hH hK'), ?_⟩
      intro rho u
      change HasDerivAt ((fun v : Real => H (rho, v)) *
        (fun v : Real => K (rho, v))) _ u
      exact (hHderiv rho u).mul (hKderiv rho u)

/-- Angular-smoothness jets are closed under real multiplication. -/
theorem HasJointSndSmooth.mul_real
    {n : Nat} {H K : Real × Real → Real}
    (hH : HasJointSndSmooth n H) (hK : HasJointSndSmooth n K) :
    HasJointSndSmooth n (fun p => H p * K p) := by
  induction n generalizing H K with
  | zero => exact Continuous.mul hH hK
  | succ n ih =>
      rcases hH with ⟨hH, H', hH', hHderiv⟩
      rcases hK with ⟨hK, K', hK', hKderiv⟩
      refine ⟨ih hH hK, fun p => H' p * K p + H p * K' p,
        (ih hH' hK).add (ih hH hK'), ?_⟩
      intro rho u
      change HasDerivAt ((fun v : Real => H (rho, v)) *
        (fun v : Real => K (rho, v))) _ u
      exact (hHderiv rho u).mul (hKderiv rho u)

/-- Angular-smoothness jets are closed under reciprocal on a nonvanishing
complex family. -/
theorem HasJointSndSmooth.inv
    {n : Nat} {H : Real × Real → Complex}
    (hH : HasJointSndSmooth n H) (hne : ∀ p, H p ≠ 0) :
    HasJointSndSmooth n (fun p => (H p)⁻¹) := by
  induction n generalizing H with
  | zero => exact Continuous.inv₀ hH hne
  | succ n ih =>
      rcases hH with ⟨hH, H', hH', hHderiv⟩
      have hHinv : HasJointSndSmooth n (fun p => (H p)⁻¹) := ih hH hne
      have hHsq : HasJointSndSmooth n (fun p => H p ^ 2) := by
        simpa [pow_two] using HasJointSndSmooth.mul hH hH
      have hHsqne : ∀ p, H p ^ 2 ≠ 0 := fun p => pow_ne_zero 2 (hne p)
      have hHsqinv : HasJointSndSmooth n (fun p => (H p ^ 2)⁻¹) :=
        ih hHsq hHsqne
      let K' : Real × Real → Complex := fun p => -H' p / H p ^ 2
      have hK' : HasJointSndSmooth n K' := by
        simpa [K', div_eq_mul_inv] using
          (HasJointSndSmooth.mul hH' hHsqinv).neg
      refine ⟨hHinv, K', hK', ?_⟩
      intro rho u
      change HasDerivAt ((fun v : Real => H (rho, v))⁻¹) _ u
      simpa [K'] using (hHderiv rho u).inv (hne (rho, u))

/-- The removable circle derivative has jointly continuous angular jets of
every prescribed finite order. -/
theorem hasJointSndSmooth_outerCircleScaledDerivative
    (n : Nat) :
    HasJointSndSmooth n
      (fun p : Real × Real => outerCircleScaledDerivative p.1 p.2) := by
  simpa [outerCircleScaledDerivativeJet] using
    (hasJointSndSmooth_of_fullJet outerCircleScaledDerivativeJet
      continuous_outerCircleScaledDerivativeJet
      hasDerivAt_outerCircleScaledDerivativeJet 0 n)

/-- The guarded circle derivative extension inherits arbitrary finite joint
angular regularity.  This is the exact replacement for a nonexistent global
`ContDiff` API for `Real.sinc`. -/
theorem hasJointSndSmooth_outerCircleUniformDerivativeExtension
    (n : Nat) :
    HasJointSndSmooth n
      (fun p : Real × Real => outerCircleUniformDerivativeExtension p.1 p.2) := by
  let G : Real × Real → Real := fun p => outerCircleUnitShellGuard p.2
  let S : Real × Real → Real := fun p => outerCircleScaledDerivative p.1 p.2
  have hGcont : ContDiff Real (⊤ : ℕ∞) G := by
    dsimp [G]
    exact (outerCircleUnitShellGuard.contDiff (n := (⊤ : ℕ∞))).comp contDiff_snd
  have hG : HasJointSndSmooth n G := hasJointSndSmooth_of_contDiff G hGcont n
  have hS : HasJointSndSmooth n S :=
    hasJointSndSmooth_outerCircleScaledDerivative n
  have hsum : HasJointSndSmooth n (fun p => (G p * S p + (-1 : Real)) + G p) :=
    (hG.mul_real hS).add (HasJointSndSmooth.const n (-1 : Real)) |>.add hG
  change HasJointSndSmooth n (fun p : Real × Real =>
    outerCircleUnitShellGuard p.2 * outerCircleScaledDerivative p.1 p.2 -
      (1 - outerCircleUnitShellGuard p.2))
  convert hsum using 1
  funext p
  dsimp [G, S]
  ring

/-- Finite angular smoothness may be forgotten down to any lower order. -/
theorem HasJointSndSmooth.of_le
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    {m n : Nat} {H : Real × Real → E}
    (hH : HasJointSndSmooth m H) (hnm : n ≤ m) :
    HasJointSndSmooth n H := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hnm
  induction k generalizing n with
  | zero => simpa using hH
  | succ k ih =>
      exact ih (by simpa [Nat.add_succ] using hH.1) (Nat.le_add_right n k)

/-- Reparametrizing the shell-width coordinate by a continuous map preserves
all angular-smoothness jets, since the angular coordinate is untouched. -/
theorem HasJointSndSmooth.comp_first
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    {n : Nat} {H : Real × Real → E}
    (hH : HasJointSndSmooth n H) (q : Real → Real) (hq : Continuous q) :
    HasJointSndSmooth n (fun p => H (q p.1, p.2)) := by
  induction n generalizing H with
  | zero =>
      exact hH.comp ((hq.comp continuous_fst).prodMk continuous_snd)
  | succ n ih =>
      rcases hH with ⟨hH, H', hH', hderiv⟩
      refine ⟨ih hH, fun p => H' (q p.1, p.2), ih hH', ?_⟩
      intro rho u
      change HasDerivAt (fun v : Real => H (q rho, v)) _ u
      exact hderiv (q rho) u

/-- The nonlinear IBP recursion, retained as a two-parameter family while
only differentiating in the angular (second) coordinate. -/
noncomputable def parametricNonstationaryIBPAmplitude
    (D : Real × Real → Real) (F : Real × Real → Complex) :
    Nat → Real × Real → Complex
  | 0 => F
  | Nat.succ k => fun p => deriv (fun v : Real =>
      parametricNonstationaryIBPAmplitude D F k (p.1, v) *
        ((D (p.1, v) : Real) : Complex)⁻¹) p.2

/-- The parametric recursion is pointwise identical to the existing
one-dimensional nonlinear IBP amplitude on each shell-width slice. -/
theorem parametricNonstationaryIBPAmplitude_eq_slice
    (D : Real × Real → Real) (F : Real × Real → Complex)
    (k : Nat) (rho u : Real) :
    parametricNonstationaryIBPAmplitude D F k (rho, u) =
      nonstationaryIBPAmplitude (fun v => D (rho, v))
        (fun v => F (rho, v)) k u := by
  induction k generalizing rho u with
  | zero => rfl
  | succ k ih =>
      change deriv (fun v : Real =>
        parametricNonstationaryIBPAmplitude D F k (rho, v) *
          ((D (rho, v) : Real) : Complex)⁻¹) u = _
      simp only [nonstationaryIBPAmplitude]
      congr 1
      funext v
      rw [ih rho v]

/-- Repeated nonlinear IBP consumes exactly one jointly controlled angular
derivative at each stage.  This is the finite-order continuity induction used
for uniform shell constants; it deliberately makes no smoothness demand in
the shell-width coordinate. -/
theorem hasJointSndSmooth_parametricNonstationaryIBPAmplitude
    {n k : Nat} (D : Real × Real → Real) (F : Real × Real → Complex)
    (hD : HasJointSndSmooth (n + k) D)
    (hF : HasJointSndSmooth (n + k) F)
    (hDne : ∀ p, D p ≠ 0) :
    HasJointSndSmooth n (parametricNonstationaryIBPAmplitude D F k) := by
  induction k generalizing n with
  | zero => simpa [parametricNonstationaryIBPAmplitude] using hF
  | succ k ih =>
      have hDprev : HasJointSndSmooth ((n + 1) + k) D := by
        convert hD using 1
        omega
      have hFprev : HasJointSndSmooth ((n + 1) + k) F := by
        convert hF using 1
        omega
      have hprev : HasJointSndSmooth (n + 1)
          (parametricNonstationaryIBPAmplitude D F k) :=
        ih hDprev hFprev
      have hDsmall : HasJointSndSmooth (n + 1) D :=
        hD.of_le (by omega)
      have hDinv : HasJointSndSmooth (n + 1)
          (fun p => ((D p : Real) : Complex)⁻¹) :=
        (HasJointSndSmooth.ofReal hDsmall).inv
          (fun p => Complex.ofReal_ne_zero.mpr (hDne p))
      have hquot : HasJointSndSmooth (n + 1) (fun p =>
          parametricNonstationaryIBPAmplitude D F k p *
            ((D p : Real) : Complex)⁻¹) :=
        hprev.mul hDinv
      rcases hquot with ⟨_, Q', hQ', hQderiv⟩
      have hQeq : parametricNonstationaryIBPAmplitude D F (k + 1) = Q' := by
        funext p
        change deriv (fun v : Real =>
          parametricNonstationaryIBPAmplitude D F k (p.1, v) *
            ((D (p.1, v) : Real) : Complex)⁻¹) p.2 = Q' p
        exact (hQderiv p.1 p.2).deriv
      rw [hQeq]
      exact hQ'

/-- The joint version of the nonlinear quotient-amplitude recursion.  Its
slice at a fixed first coordinate will be the ordinary
`nonstationaryIBPAmplitude` used by the verified IBP chain. -/
noncomputable def jointNonstationaryIBPAmplitude
    (D : Real × Real → Real) (F : Real × Real → Complex) :
    Nat → Real × Real → Complex
  | 0 => F
  | Nat.succ k => fun p =>
      partialDerivSnd (fun q =>
        jointNonstationaryIBPAmplitude D F k q * ((D q : Complex)⁻¹)) p

/-- Arbitrary fixed quotient-amplitude order preserves joint smoothness when
the denominator family is jointly smooth and globally nonzero. -/
theorem contDiff_jointNonstationaryIBPAmplitude
    (D : Real × Real → Real) (F : Real × Real → Complex)
    (hD : ContDiff Real (⊤ : ℕ∞) D) (hDne : ∀ p, D p ≠ 0)
    (hF : ContDiff Real (⊤ : ℕ∞) F) (k : Nat) :
    ContDiff Real (⊤ : ℕ∞) (jointNonstationaryIBPAmplitude D F k) := by
  have hDC : ContDiff Real (⊤ : ℕ∞) (fun p => (D p : Complex)) := by
    change ContDiff Real (⊤ : ℕ∞) (Complex.ofRealCLM ∘ D)
    exact Complex.ofRealCLM.contDiff.comp hD
  induction k with
  | zero => simpa [jointNonstationaryIBPAmplitude] using hF
  | succ k ih =>
      apply contDiff_partialDerivSnd
      exact ih.mul (hDC.inv (fun p => Complex.ofReal_ne_zero.mpr (hDne p)))

/-- The joint recursion restricts exactly to the existing one-dimensional
quotient-amplitude recursion on every fixed parameter slice. -/
theorem jointNonstationaryIBPAmplitude_eq_slice
    (D : Real × Real → Real) (F : Real × Real → Complex)
    (hD : ContDiff Real (⊤ : ℕ∞) D) (hDne : ∀ p, D p ≠ 0)
    (hF : ContDiff Real (⊤ : ℕ∞) F)
    (k : Nat) (rho u : Real) :
    jointNonstationaryIBPAmplitude D F k (rho, u) =
      nonstationaryIBPAmplitude (fun v => D (rho, v))
        (fun v => F (rho, v)) k u := by
  induction k generalizing rho u with
  | zero => rfl
  | succ k ih =>
      let A : Real × Real → Complex := jointNonstationaryIBPAmplitude D F k
      let H : Real × Real → Complex := fun q => A q * ((D q : Complex)⁻¹)
      have hA : ContDiff Real (⊤ : ℕ∞) A := by
        exact contDiff_jointNonstationaryIBPAmplitude D F hD hDne hF k
      have hDC : ContDiff Real (⊤ : ℕ∞) (fun q => (D q : Complex)) := by
        change ContDiff Real (⊤ : ℕ∞) (Complex.ofRealCLM ∘ D)
        exact Complex.ofRealCLM.contDiff.comp hD
      have hH : ContDiff Real (⊤ : ℕ∞) H := by
        exact hA.mul (hDC.inv (fun q => Complex.ofReal_ne_zero.mpr (hDne q)))
      have hslice : (fun v : Real => H (rho, v)) =
          fun v => nonstationaryIBPAmplitude (fun w => D (rho, w))
            (fun w => F (rho, w)) k v * ((D (rho, v) : Real) : Complex)⁻¹ := by
        funext v
        dsimp [H, A]
        rw [ih rho v]
      change partialDerivSnd H (rho, u) = _
      rw [(deriv_slice_eq_partialDerivSnd H
        (hH.differentiable (by simp)) rho u).symm]
      rw [hslice]
      rfl

/-- The guarded extension agrees with the literal circle derivative throughout
the unit outer shell. -/
theorem outerCircleShellDerivativeExtension_eq_on_unitAnnulus
    {rho u : Real} (hu : u ∈ Icc (1 / 2 : Real) 2) :
    outerCircleShellDerivativeExtension rho u = outerCircleShellPhaseDeriv rho u := by
  have hmem : u ∈ Metric.closedBall (5 / 4 : Real) ((7 : Real) / 8) := by
    rw [Metric.mem_closedBall, Real.dist_eq, abs_le]
    constructor <;> linarith [hu.1, hu.2]
  have hguard : outerCircleUnitShellGuard u = 1 :=
    outerCircleUnitShellGuard.one_of_mem_closedBall hmem
  simp [outerCircleShellDerivativeExtension, hguard]

/-- The guarded extension is globally smooth. -/
theorem contDiff_outerCircleShellDerivativeExtension (rho : Real) :
    ContDiff Real (⊤ : ℕ∞) (outerCircleShellDerivativeExtension rho) := by
  unfold outerCircleShellDerivativeExtension outerCircleShellPhaseDeriv
  exact (outerCircleUnitShellGuard.contDiff.mul (by fun_prop)).sub
    (contDiff_const.sub outerCircleUnitShellGuard.contDiff)

/-- The global extension never vanishes when the guard support stays in the
positive sine arc.  This is exactly the hypothesis required by the existing
automatic `HasNonstationaryPhaseIBPChain` constructor. -/
theorem outerCircleShellDerivativeExtension_ne_zero
    {rho u : Real} (hrho : 0 < rho) (hrho_small : 9 * rho / 4 < Real.pi) :
    outerCircleShellDerivativeExtension rho u ≠ 0 := by
  by_cases hguard_zero : outerCircleUnitShellGuard u = 0
  · simp [outerCircleShellDerivativeExtension, hguard_zero]
  · have hdist : dist u (5 / 4 : Real) < 1 := by
      apply lt_of_not_ge
      intro hdist
      exact hguard_zero (outerCircleUnitShellGuard.zero_of_le_dist hdist)
    have hu_range : u ∈ Ioo (1 / 4 : Real) (9 / 4 : Real) := by
      rw [Real.dist_eq, abs_lt] at hdist
      constructor <;> linarith
    have hu_pos : 0 < u := by linarith [hu_range.1]
    have harg_pos : 0 < rho * u := mul_pos hrho hu_pos
    have harg_lt : rho * u < Real.pi := by
      calc
        rho * u ≤ rho * (9 / 4) :=
          mul_le_mul_of_nonneg_left hu_range.2.le hrho.le
        _ = 9 * rho / 4 := by ring
        _ < Real.pi := hrho_small
    have hderiv_neg : outerCircleShellPhaseDeriv rho u < 0 := by
      unfold outerCircleShellPhaseDeriv
      exact div_neg_of_neg_of_pos
        (neg_lt_zero.mpr (Real.sin_pos_of_pos_of_lt_pi harg_pos harg_lt)) hrho
    have hguard_pos : 0 < outerCircleUnitShellGuard u :=
      lt_of_le_of_ne outerCircleUnitShellGuard.nonneg (Ne.symm hguard_zero)
    have hfirst : outerCircleUnitShellGuard u * outerCircleShellPhaseDeriv rho u < 0 :=
      mul_neg_of_pos_of_neg hguard_pos hderiv_neg
    have hsecond : 0 ≤ 1 - outerCircleUnitShellGuard u :=
      sub_nonneg.mpr outerCircleUnitShellGuard.le_one
    unfold outerCircleShellDerivativeExtension
    exact ne_of_lt (lt_of_le_of_lt (sub_le_self _ hsecond) hfirst)

/-- The removable-singularity guarded derivative has the same global
nonvanishing property uniformly down to width zero. -/
theorem outerCircleUniformDerivativeExtension_ne_zero
    {rho u : Real} (hrho : 0 ≤ rho) (hrho_small : 9 * rho / 4 < Real.pi) :
    outerCircleUniformDerivativeExtension rho u ≠ 0 := by
  by_cases hguard_zero : outerCircleUnitShellGuard u = 0
  · simp [outerCircleUniformDerivativeExtension, hguard_zero]
  · have hdist : dist u (5 / 4 : Real) < 1 := by
      apply lt_of_not_ge
      intro hdist
      exact hguard_zero (outerCircleUnitShellGuard.zero_of_le_dist hdist)
    have hu_range : u ∈ Ioo (1 / 4 : Real) (9 / 4 : Real) := by
      rw [Real.dist_eq, abs_lt] at hdist
      constructor <;> linarith
    have hu_pos : 0 < u := by linarith [hu_range.1]
    have hscaled_neg : outerCircleScaledDerivative rho u < 0 := by
      by_cases hrho_zero : rho = 0
      · subst rho
        simp [outerCircleScaledDerivative]
        linarith
      · have hrho_pos : 0 < rho := lt_of_le_of_ne hrho (Ne.symm hrho_zero)
        have harg_pos : 0 < rho * u := mul_pos hrho_pos hu_pos
        have harg_lt : rho * u < Real.pi := by
          calc
            rho * u ≤ rho * (9 / 4) :=
              mul_le_mul_of_nonneg_left hu_range.2.le hrho_pos.le
            _ = 9 * rho / 4 := by ring
            _ < Real.pi := hrho_small
        rw [outerCircleScaledDerivative_eq_literal hrho_zero (ne_of_gt hu_pos)]
        unfold outerCircleShellPhaseDeriv
        exact div_neg_of_neg_of_pos
          (neg_lt_zero.mpr (Real.sin_pos_of_pos_of_lt_pi harg_pos harg_lt)) hrho_pos
    have hguard_pos : 0 < outerCircleUnitShellGuard u :=
      lt_of_le_of_ne outerCircleUnitShellGuard.nonneg (Ne.symm hguard_zero)
    have hfirst : outerCircleUnitShellGuard u * outerCircleScaledDerivative rho u < 0 :=
      mul_neg_of_pos_of_neg hguard_pos hscaled_neg
    have hsecond : 0 ≤ 1 - outerCircleUnitShellGuard u :=
      sub_nonneg.mpr outerCircleUnitShellGuard.le_one
    unfold outerCircleUniformDerivativeExtension
    exact ne_of_lt (lt_of_le_of_lt (sub_le_self _ hsecond) hfirst)

/-- A continuous width clamp: it is the identity on the compact shell range,
but prevents the global quotient extension from reaching later sine zeros. -/
def outerCircleWidthClamp (rhoMax rho : Real) : Real := max 0 (min rho rhoMax)

theorem continuous_outerCircleWidthClamp (rhoMax : Real) :
    Continuous (outerCircleWidthClamp rhoMax) := by
  unfold outerCircleWidthClamp
  exact continuous_const.max (continuous_id.min continuous_const)

theorem outerCircleWidthClamp_nonneg (rhoMax rho : Real) :
    0 ≤ outerCircleWidthClamp rhoMax rho := by
  unfold outerCircleWidthClamp
  exact le_max_left _ _

theorem outerCircleWidthClamp_le
    {rhoMax rho : Real} (hrhoMax : 0 ≤ rhoMax) :
    outerCircleWidthClamp rhoMax rho ≤ rhoMax := by
  unfold outerCircleWidthClamp
  exact max_le hrhoMax (min_le_right _ _)

theorem outerCircleWidthClamp_eq
    {rhoMax rho : Real} (hrho : 0 ≤ rho) (hrho_le : rho ≤ rhoMax) :
    outerCircleWidthClamp rhoMax rho = rho := by
  simp [outerCircleWidthClamp, min_eq_left hrho_le, max_eq_right hrho]

/-- A globally safe version of the removable circle derivative extension.  It
agrees with the true extension on the dyadic width range, while its width
parameter is clamped outside that range solely to make global inversion legal. -/
noncomputable def safeOuterCircleUniformDerivativeExtension
    (rhoMax : Real) (p : Real × Real) : Real :=
  outerCircleUniformDerivativeExtension (outerCircleWidthClamp rhoMax p.1) p.2

theorem hasJointSndSmooth_safeOuterCircleUniformDerivativeExtension
    (rhoMax : Real) (n : Nat) :
    HasJointSndSmooth n (safeOuterCircleUniformDerivativeExtension rhoMax) := by
  change HasJointSndSmooth n (fun p : Real × Real =>
    outerCircleUniformDerivativeExtension (outerCircleWidthClamp rhoMax p.1) p.2)
  exact (hasJointSndSmooth_outerCircleUniformDerivativeExtension n).comp_first
    (outerCircleWidthClamp rhoMax) (continuous_outerCircleWidthClamp rhoMax)

theorem safeOuterCircleUniformDerivativeExtension_ne_zero
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (p : Real × Real) :
    safeOuterCircleUniformDerivativeExtension rhoMax p ≠ 0 := by
  unfold safeOuterCircleUniformDerivativeExtension
  apply outerCircleUniformDerivativeExtension_ne_zero
  · exact outerCircleWidthClamp_nonneg rhoMax p.1
  · have hclamp_le : outerCircleWidthClamp rhoMax p.1 ≤ rhoMax :=
      outerCircleWidthClamp_le hrhoMax
    calc
      9 * outerCircleWidthClamp rhoMax p.1 / 4 =
          (9 / 4 : Real) * outerCircleWidthClamp rhoMax p.1 := by ring
      _ ≤ (9 / 4 : Real) * rhoMax :=
        mul_le_mul_of_nonneg_left hclamp_le (by norm_num)
      _ = 9 * rhoMax / 4 := by ring
      _ < Real.pi := hrhoMax_small

theorem safeOuterCircleUniformDerivativeExtension_eq
    {rhoMax rho : Real} (hrho : 0 ≤ rho) (hrho_le : rho ≤ rhoMax) :
    (fun u : Real => safeOuterCircleUniformDerivativeExtension rhoMax (rho, u)) =
      outerCircleUniformDerivativeExtension rho := by
  funext u
  simp [safeOuterCircleUniformDerivativeExtension,
    outerCircleWidthClamp_eq hrho hrho_le]

/-- The rescaled circle phase has the displayed derivative away from the
degenerate radius `rho = 0`. -/
theorem hasDerivAt_outerCircleShellPhase
    {rho u : Real} (hrho : rho ≠ 0) :
    HasDerivAt (outerCircleShellPhase rho) (outerCircleShellPhaseDeriv rho u) u := by
  have harg : HasDerivAt (fun v : Real => rho * v) rho u := by
    simpa [mul_comm] using (hasDerivAt_const_mul (x := u) rho)
  have hcos : HasDerivAt (fun v : Real => Real.cos (rho * v))
      (-Real.sin (rho * u) * rho) u := by
    simpa [Function.comp_def, mul_comm] using
      (Real.hasDerivAt_cos (rho * u)).comp u harg
  have hphase := (hcos.sub_const 1).div_const (rho ^ 2)
  have hderiv : (-Real.sin (rho * u)) * rho / rho ^ 2 =
      -Real.sin (rho * u) / rho := by
    field_simp [hrho]
  rw [hderiv] at hphase
  change HasDerivAt (fun x : Real => (Real.cos (rho * x) - 1) / rho ^ 2)
    (-Real.sin (rho * u) / rho) u
  exact hphase

/-- The rescaled circle phase is continuous for every fixed shell width. -/
theorem continuous_outerCircleShellPhase (rho : Real) :
    Continuous (outerCircleShellPhase rho) := by
  unfold outerCircleShellPhase
  fun_prop

/-- Its literal derivative is continuous as well. -/
theorem continuous_outerCircleShellPhaseDeriv (rho : Real) :
    Continuous (outerCircleShellPhaseDeriv rho) := by
  unfold outerCircleShellPhaseDeriv
  fun_prop

/-- On the fixed unit annulus in the rescaled variable, the circular shell
phase is genuinely nonstationary provided `2 * rho < pi`.  This is the
order-one fact replacing the apparent Airy degeneracy after the `TT*`
reorganization. -/
theorem outerCircleShellPhaseDeriv_ne_on_unitAnnulus
    {rho u : Real} (hrho : 0 < rho) (hrho_small : 2 * rho < Real.pi)
    (hu : u ∈ Icc (1 / 2 : Real) 2) :
    outerCircleShellPhaseDeriv rho u ≠ 0 := by
  have hu_pos : 0 < u := by linarith [hu.1]
  have harg_pos : 0 < rho * u := mul_pos hrho hu_pos
  have harg_lt : rho * u < Real.pi := by
    calc
      rho * u ≤ rho * 2 := mul_le_mul_of_nonneg_left hu.2 hrho.le
      _ = 2 * rho := by ring
      _ < Real.pi := hrho_small
  unfold outerCircleShellPhaseDeriv
  exact div_ne_zero (neg_ne_zero.mpr
    (Real.sin_pos_of_pos_of_lt_pi harg_pos harg_lt).ne') (ne_of_gt hrho)

/-- On the rescaled outer shell, the removable-singularity extension remains
nonzero even at `rho = 0`.  This is the denominator fact needed for a uniform
family of quotient amplitudes. -/
theorem outerCircleUniformDerivativeExtension_ne_zero_on_unitAnnulus
    {rho u : Real} (hrho : 0 ≤ rho) (hrho_small : 2 * rho < Real.pi)
    (hu : u ∈ Icc (1 / 2 : Real) 2) :
    outerCircleUniformDerivativeExtension rho u ≠ 0 := by
  have hmem : u ∈ Metric.closedBall (5 / 4 : Real) ((7 : Real) / 8) := by
    rw [Metric.mem_closedBall, Real.dist_eq, abs_le]
    constructor <;> linarith [hu.1, hu.2]
  have hguard : outerCircleUnitShellGuard u = 1 :=
    outerCircleUnitShellGuard.one_of_mem_closedBall hmem
  rw [show outerCircleUniformDerivativeExtension rho u =
    outerCircleScaledDerivative rho u by
      simp [outerCircleUniformDerivativeExtension, hguard]]
  by_cases hrho_zero : rho = 0
  · subst rho
    simp [outerCircleScaledDerivative]
    linarith [hu.1]
  · have hrho_pos : 0 < rho := lt_of_le_of_ne hrho (Ne.symm hrho_zero)
    have hu_ne : u ≠ 0 := by linarith [hu.1]
    rw [outerCircleScaledDerivative_eq_literal hrho_zero hu_ne]
    exact outerCircleShellPhaseDeriv_ne_on_unitAnnulus hrho_pos hrho_small hu

/-- The signed-frequency form of the rescaled nonstationary shell estimate.
After putting an angular shell of width `rho` in unit coordinates, the outer
Jacobian is the leading factor `rho`; in the circle application the frequency
is `tau * lambda * rho^2`. -/
theorem norm_rescaledNonstationaryShell_of_chain_abs
    {a b freq rho M : Real} {phase phaseDeriv : Real → Real}
    {F : Nat → Real → Complex} {N : Nat}
    (hrho : 0 ≤ rho) (hab : a ≤ b) (hfreq : freq ≠ 0)
    (hphase : ∀ u ∈ uIcc a b, HasDerivAt phase (phaseDeriv u) u)
    (hphaseDeriv_ne : ∀ u ∈ uIcc a b, phaseDeriv u ≠ 0)
    (hphase_cont : Continuous phase) (hphaseDeriv_cont : Continuous phaseDeriv)
    (hchain : HasNonstationaryPhaseIBPChain a b phaseDeriv F N)
    (hM : 0 ≤ M) (hbound : ∀ u ∈ Icc a b, ‖F N u‖ ≤ M) :
    ‖(rho : Complex) * ∫ u in a..b,
      F 0 u * nonstationaryPhaseExp freq phase u‖ ≤
      rho * (1 / |freq|) ^ N * ((b - a) * M) := by
  have hbase := nonstationaryPhase_of_chain hab hfreq hphase hphaseDeriv_ne
    hphase_cont hphaseDeriv_cont hchain hM hbound
  calc
    ‖(rho : Complex) * ∫ u in a..b,
        F 0 u * nonstationaryPhaseExp freq phase u‖ =
        rho * ‖∫ u in a..b, F 0 u * nonstationaryPhaseExp freq phase u‖ := by
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hrho]
    _ ≤ rho * ((1 / |freq|) ^ N * ((b - a) * M)) :=
      mul_le_mul_of_nonneg_left hbase hrho
    _ = rho * (1 / |freq|) ^ N * ((b - a) * M) := by ring

/-- A rescaled nonstationary shell has exactly the expected power decay in
the dimensionless parameter `R`.  This is only a wrapper around the verified
nonlinear integration-by-parts chain: after putting an angular shell of width
`rho` in unit coordinates, the outer Jacobian is the leading factor `rho`
and the phase frequency is `R = lambda * rho^2`. -/
theorem norm_rescaledNonstationaryShell_of_chain
    {a b R rho M : Real} {phase phaseDeriv : Real → Real}
    {F : Nat → Real → Complex} {N : Nat}
    (hrho : 0 ≤ rho) (hab : a ≤ b) (hR : 0 < R)
    (hphase : ∀ u ∈ uIcc a b, HasDerivAt phase (phaseDeriv u) u)
    (hphaseDeriv_ne : ∀ u ∈ uIcc a b, phaseDeriv u ≠ 0)
    (hphase_cont : Continuous phase) (hphaseDeriv_cont : Continuous phaseDeriv)
    (hchain : HasNonstationaryPhaseIBPChain a b phaseDeriv F N)
    (hM : 0 ≤ M) (hbound : ∀ u ∈ Icc a b, ‖F N u‖ ≤ M) :
    ‖(rho : Complex) * ∫ u in a..b,
      F 0 u * nonstationaryPhaseExp R phase u‖ ≤
      rho * (R⁻¹) ^ N * ((b - a) * M) := by
  have hbase := nonstationaryPhase_of_chain hab hR.ne' hphase hphaseDeriv_ne
    hphase_cont hphaseDeriv_cont hchain hM hbound
  calc
    ‖(rho : Complex) * ∫ u in a..b,
        F 0 u * nonstationaryPhaseExp R phase u‖ =
        rho * ‖∫ u in a..b, F 0 u * nonstationaryPhaseExp R phase u‖ := by
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hrho]
    _ ≤ rho * ((1 / |R|) ^ N * ((b - a) * M)) :=
      mul_le_mul_of_nonneg_left hbase hrho
    _ = rho * (R⁻¹) ^ N * ((b - a) * M) := by
      rw [abs_of_pos hR, inv_eq_one_div]
      ring

/-- Source-ready outer-circle shell estimate.  It is the generic nonlinear
IBP theorem applied to the *literal* rescaled circle phase on the fixed shell
`u in [1/2, 2]`; the dyadic application sets `R = |t - t'| * lambda * rho^2`.
The supplied chain is the honest local quotient-derivative datum, avoiding a
false claim that the circle derivative is globally nonzero. -/
theorem norm_outerCircleUnitShell_of_chain
    {R rho M : Real} {F : Nat → Real → Complex} {N : Nat}
    (hrho : 0 < rho) (hrho_small : 2 * rho < Real.pi) (hR : 0 < R)
    (hchain : HasNonstationaryPhaseIBPChain (1 / 2 : Real) 2
      (outerCircleShellPhaseDeriv rho) F N)
    (hM : 0 ≤ M)
    (hbound : ∀ u ∈ Icc (1 / 2 : Real) 2, ‖F N u‖ ≤ M) :
    ‖(rho : Complex) * ∫ u in (1 / 2 : Real)..2,
      F 0 u * nonstationaryPhaseExp R (outerCircleShellPhase rho) u‖ ≤
      rho * (R⁻¹) ^ N * ((2 - (1 / 2 : Real)) * M) := by
  apply norm_rescaledNonstationaryShell_of_chain hrho.le (by norm_num) hR
  · intro u hu
    exact hasDerivAt_outerCircleShellPhase hrho.ne'
  · intro u hu
    rw [uIcc_of_le (by norm_num)] at hu
    exact outerCircleShellPhaseDeriv_ne_on_unitAnnulus hrho hrho_small hu
  · exact continuous_outerCircleShellPhase rho
  · exact continuous_outerCircleShellPhaseDeriv rho
  · exact hchain
  · exact hM
  · exact hbound

/-- Removing the critical-value constant identifies the normalized shell
oscillation with the literal circle oscillation.  This is the exact equality
used when `lambda` is the length of the spatial Fourier variable and `tau`
is the `TT*` time gap. -/
theorem norm_intervalIntegral_literalCircleShell_eq_normalized
    {a b tau lambda rho : Real} (hrho : rho ≠ 0) (F : Real → Complex) :
    ‖∫ u in a..b,
      F u * Complex.exp
        (((tau * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I)‖ =
      ‖∫ u in a..b,
        F u * nonstationaryPhaseExp (tau * lambda * rho ^ 2)
          (outerCircleShellPhase rho) u‖ := by
  let C : Complex := Complex.exp (((tau * lambda : Real) : Complex) * Complex.I)
  have hpoint (u : Real) :
      Complex.exp (((tau * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I) =
        C * nonstationaryPhaseExp (tau * lambda * rho ^ 2)
          (outerCircleShellPhase rho) u := by
    dsimp [C, nonstationaryPhaseExp, outerCircleShellPhase]
    rw [← Complex.exp_add]
    congr 1
    push_cast
    field_simp [hrho]
    ring
  have hint :
      (∫ u in a..b,
        F u * Complex.exp
          (((tau * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I)) =
        C * ∫ u in a..b,
          F u * nonstationaryPhaseExp (tau * lambda * rho ^ 2)
            (outerCircleShellPhase rho) u := by
    rw [← intervalIntegral.integral_const_mul]
    apply intervalIntegral.integral_congr
    intro u hu
    change F u * Complex.exp
        (((tau * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I) =
      C * (F u * nonstationaryPhaseExp (tau * lambda * rho ^ 2)
        (outerCircleShellPhase rho) u)
    rw [hpoint]
    ring
  rw [hint, norm_mul]
  dsimp [C]
  rw [Complex.norm_exp_ofReal_mul_I, one_mul]

/-- The literal angular circle kernel on one outer shell has rapid decay in
the exact dimensionless quantity `|tau| * |lambda| * rho^2`.  No cubic/Airy
estimate is used: after `TT*`, the fixed-unit-shell circle derivative is
nonzero and the existing nonlinear-IBP chain applies. -/
theorem norm_literalOuterCircleUnitShell_of_chain
    {tau lambda rho M : Real} {F : Nat → Real → Complex} {N : Nat}
    (hrho : 0 < rho) (hrho_small : 2 * rho < Real.pi)
    (hfreq : tau * lambda * rho ^ 2 ≠ 0)
    (hchain : HasNonstationaryPhaseIBPChain (1 / 2 : Real) 2
      (outerCircleShellPhaseDeriv rho) F N)
    (hM : 0 ≤ M)
    (hbound : ∀ u ∈ Icc (1 / 2 : Real) 2, ‖F N u‖ ≤ M) :
    ‖(rho : Complex) * ∫ u in (1 / 2 : Real)..2,
      F 0 u * Complex.exp
        (((tau * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I)‖ ≤
      rho * (1 / |tau * lambda * rho ^ 2|) ^ N *
        ((2 - (1 / 2 : Real)) * M) := by
  have hnorm := norm_intervalIntegral_literalCircleShell_eq_normalized
    (a := (1 / 2 : Real)) (b := 2) (tau := tau) (lambda := lambda)
    (rho := rho) hrho.ne' (F 0)
  calc
    ‖(rho : Complex) * ∫ u in (1 / 2 : Real)..2,
        F 0 u * Complex.exp
          (((tau * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I)‖ =
        rho * ‖∫ u in (1 / 2 : Real)..2,
          F 0 u * Complex.exp
            (((tau * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I)‖ := by
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hrho.le]
    _ = rho * ‖∫ u in (1 / 2 : Real)..2,
        F 0 u * nonstationaryPhaseExp (tau * lambda * rho ^ 2)
          (outerCircleShellPhase rho) u‖ := by rw [hnorm]
    _ = ‖(rho : Complex) * ∫ u in (1 / 2 : Real)..2,
        F 0 u * nonstationaryPhaseExp (tau * lambda * rho ^ 2)
          (outerCircleShellPhase rho) u‖ := by
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hrho.le]
    _ ≤ rho * (1 / |tau * lambda * rho ^ 2|) ^ N *
        ((2 - (1 / 2 : Real)) * M) := by
      apply norm_rescaledNonstationaryShell_of_chain_abs hrho.le (by norm_num) hfreq
      · intro u hu
        exact hasDerivAt_outerCircleShellPhase hrho.ne'
      · intro u hu
        rw [uIcc_of_le (by norm_num)] at hu
        exact outerCircleShellPhaseDeriv_ne_on_unitAnnulus hrho hrho_small hu
      · exact continuous_outerCircleShellPhase rho
      · exact continuous_outerCircleShellPhaseDeriv rho
      · exact hchain
      · exact hM
      · exact hbound

/-- Smooth data can also feed the signed-frequency shell estimate directly.
This is the form used for a signed `TT*` time gap. -/
theorem norm_rescaledNonstationaryShell_of_contDiff_abs
    {a b freq rho M : Real} {phase phaseDeriv : Real → Real}
    {F : Real → Complex} {N : Nat}
    (hrho : 0 ≤ rho) (hab : a ≤ b) (hfreq : freq ≠ 0)
    (hphase : ∀ u ∈ uIcc a b, HasDerivAt phase (phaseDeriv u) u)
    (hphaseDeriv : ContDiff Real (⊤ : ℕ∞) phaseDeriv)
    (hphaseDeriv_ne : ∀ u, phaseDeriv u ≠ 0)
    (hphase_cont : Continuous phase)
    (hF : ContDiff Real (⊤ : ℕ∞) F)
    (hFleft : F =ᶠ[nhds a] 0) (hFright : F =ᶠ[nhds b] 0)
    (hM : 0 ≤ M)
    (hbound : ∀ u ∈ Icc a b,
      ‖nonstationaryIBPAmplitude phaseDeriv F N u‖ ≤ M) :
    ‖(rho : Complex) * ∫ u in a..b,
      F u * nonstationaryPhaseExp freq phase u‖ ≤
      rho * (1 / |freq|) ^ N * ((b - a) * M) := by
  simpa [nonstationaryIBPAmplitude, Function.comp_def] using
    norm_rescaledNonstationaryShell_of_chain_abs
      (F := nonstationaryIBPAmplitude phaseDeriv F)
      hrho hab hfreq hphase
      (fun u hu => hphaseDeriv_ne u) hphase_cont hphaseDeriv.continuous
      (hasNonstationaryPhaseIBPChain_nonstationaryIBPAmplitude_of_contDiff
        phaseDeriv F hphaseDeriv hphaseDeriv_ne hF hFleft hFright N)
      hM hbound

/-- The preceding shell estimate can be fed directly by the library's
smooth-amplitude chain constructor.  The global nonvanishing derivative is
normally supplied by a smooth extension which agrees with the rescaled circle
phase derivative on the shell support.  Thus the only shell-specific analytic
input left here is the uniform bound on the final quotient amplitude. -/
theorem norm_rescaledNonstationaryShell_of_contDiff
    {a b R rho M : Real} {phase phaseDeriv : Real → Real}
    {F : Real → Complex} {N : Nat}
    (hrho : 0 ≤ rho) (hab : a ≤ b) (hR : 0 < R)
    (hphase : ∀ u ∈ uIcc a b, HasDerivAt phase (phaseDeriv u) u)
    (hphaseDeriv : ContDiff Real (⊤ : ℕ∞) phaseDeriv)
    (hphaseDeriv_ne : ∀ u, phaseDeriv u ≠ 0)
    (hphase_cont : Continuous phase)
    (hF : ContDiff Real (⊤ : ℕ∞) F)
    (hFleft : F =ᶠ[nhds a] 0) (hFright : F =ᶠ[nhds b] 0)
    (hM : 0 ≤ M)
    (hbound : ∀ u ∈ Icc a b,
      ‖nonstationaryIBPAmplitude phaseDeriv F N u‖ ≤ M) :
    ‖(rho : Complex) * ∫ u in a..b,
      F u * nonstationaryPhaseExp R phase u‖ ≤
      rho * (R⁻¹) ^ N * ((b - a) * M) := by
  simpa [nonstationaryIBPAmplitude] using
    norm_rescaledNonstationaryShell_of_chain
      (F := nonstationaryIBPAmplitude phaseDeriv F)
      hrho hab hR hphase
      (fun u hu => hphaseDeriv_ne u) hphase_cont hphaseDeriv.continuous
      (hasNonstationaryPhaseIBPChain_nonstationaryIBPAmplitude_of_contDiff
        phaseDeriv F hphaseDeriv hphaseDeriv_ne hF hFleft hFright N)
      hM hbound

/-- The automatic-chain version for the literal outer circle shell.  A fixed
smooth rescaled cutoff `F` now produces the nonlinear chain from existing
library code; the remaining quantitative datum is only a uniform bound on
the resulting quotient amplitude. -/
theorem norm_outerCircleUnitShell_of_contDiff
    {R rho M : Real} {F : Real → Complex} {N : Nat}
    (hrho : 0 < rho) (hrho_small : 9 * rho / 4 < Real.pi) (hR : 0 < R)
    (hF : ContDiff Real (⊤ : ℕ∞) F)
    (hFleft : F =ᶠ[nhds (1 / 2 : Real)] 0)
    (hFright : F =ᶠ[nhds 2] 0)
    (hM : 0 ≤ M)
    (hbound : ∀ u ∈ Icc (1 / 2 : Real) 2,
      ‖nonstationaryIBPAmplitude (outerCircleShellDerivativeExtension rho) F N u‖ ≤ M) :
    ‖(rho : Complex) * ∫ u in (1 / 2 : Real)..2,
      F u * nonstationaryPhaseExp R (outerCircleShellPhase rho) u‖ ≤
      rho * (R⁻¹) ^ N * ((2 - (1 / 2 : Real)) * M) := by
  apply norm_rescaledNonstationaryShell_of_contDiff
    (phaseDeriv := outerCircleShellDerivativeExtension rho)
    hrho.le (by norm_num) hR
  · intro u hu
    rw [uIcc_of_le (by norm_num)] at hu
    rw [outerCircleShellDerivativeExtension_eq_on_unitAnnulus hu]
    exact hasDerivAt_outerCircleShellPhase hrho.ne'
  · exact contDiff_outerCircleShellDerivativeExtension rho
  · exact fun u => outerCircleShellDerivativeExtension_ne_zero hrho hrho_small
  · exact continuous_outerCircleShellPhase rho
  · exact hF
  · exact hFleft
  · exact hFright
  · exact hM
  · exact hbound

/-- The fully automatic-chain form of the literal outer-circle estimate.
For a fixed smooth unit-shell cutoff, it gives exactly the signed `TT*`
decay without assuming a hand-written integration-by-parts chain. -/
theorem norm_literalOuterCircleUnitShell_of_contDiff
    {tau lambda rho M : Real} {F : Real → Complex} {N : Nat}
    (hrho : 0 < rho) (hrho_small : 9 * rho / 4 < Real.pi)
    (hfreq : tau * lambda * rho ^ 2 ≠ 0)
    (hF : ContDiff Real (⊤ : ℕ∞) F)
    (hFleft : F =ᶠ[nhds (1 / 2 : Real)] 0)
    (hFright : F =ᶠ[nhds 2] 0)
    (hM : 0 ≤ M)
    (hbound : ∀ u ∈ Icc (1 / 2 : Real) 2,
      ‖nonstationaryIBPAmplitude (outerCircleShellDerivativeExtension rho) F N u‖ ≤ M) :
    ‖(rho : Complex) * ∫ u in (1 / 2 : Real)..2,
      F u * Complex.exp
        (((tau * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I)‖ ≤
      rho * (1 / |tau * lambda * rho ^ 2|) ^ N *
        ((2 - (1 / 2 : Real)) * M) := by
  have hnorm := norm_intervalIntegral_literalCircleShell_eq_normalized
    (a := (1 / 2 : Real)) (b := 2) (tau := tau) (lambda := lambda)
    (rho := rho) hrho.ne' F
  calc
    ‖(rho : Complex) * ∫ u in (1 / 2 : Real)..2,
        F u * Complex.exp
          (((tau * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I)‖ =
        rho * ‖∫ u in (1 / 2 : Real)..2,
          F u * Complex.exp
            (((tau * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I)‖ := by
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hrho.le]
    _ = rho * ‖∫ u in (1 / 2 : Real)..2,
        F u * nonstationaryPhaseExp (tau * lambda * rho ^ 2)
          (outerCircleShellPhase rho) u‖ := by rw [hnorm]
    _ = ‖(rho : Complex) * ∫ u in (1 / 2 : Real)..2,
        F u * nonstationaryPhaseExp (tau * lambda * rho ^ 2)
          (outerCircleShellPhase rho) u‖ := by
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hrho.le]
    _ ≤ rho * (1 / |tau * lambda * rho ^ 2|) ^ N *
        ((2 - (1 / 2 : Real)) * M) := by
      apply norm_rescaledNonstationaryShell_of_contDiff_abs
        (phaseDeriv := outerCircleShellDerivativeExtension rho)
        hrho.le (by norm_num) hfreq
      · intro u hu
        rw [uIcc_of_le (by norm_num)] at hu
        rw [outerCircleShellDerivativeExtension_eq_on_unitAnnulus hu]
        exact hasDerivAt_outerCircleShellPhase hrho.ne'
      · exact contDiff_outerCircleShellDerivativeExtension rho
      · exact fun u => outerCircleShellDerivativeExtension_ne_zero hrho hrho_small
      · exact continuous_outerCircleShellPhase rho
      · exact hF
      · exact hFleft
      · exact hFright
      · exact hM
      · exact hbound

/-- Compactness turns a jointly continuous rescaled amplitude family into a
single uniform bound on every shell parameter and every unit-shell point. -/
theorem exists_uniform_norm_bound_of_jointContinuous
    {rhoMax a b : Real} (_hrhoMax : 0 ≤ rhoMax) (_hab : a ≤ b)
    (G : Real → Real → Complex)
    (hG : Continuous (fun p : Real × Real => G p.1 p.2)) :
    ∃ M : Real, 0 < M ∧ ∀ rho ∈ Icc 0 rhoMax, ∀ u ∈ Icc a b,
      ‖G rho u‖ ≤ M := by
  have hcompact : IsCompact
      ((fun p : Real × Real => G p.1 p.2) '' (Icc 0 rhoMax ×ˢ Icc a b)) :=
    (isCompact_Icc.prod isCompact_Icc).image_of_continuousOn hG.continuousOn
  rcases hcompact.isBounded.exists_pos_norm_le with ⟨M, hM, hbound⟩
  refine ⟨M, hM, ?_⟩
  intro rho hrho u hu
  apply hbound
  exact ⟨(rho, u), ⟨hrho, hu⟩, rfl⟩

/-- A jointly smooth, globally nonzero denominator family gives one uniform
bound for the final nonlinear quotient amplitude at every prescribed finite
IBP order.  This is the reusable arbitrary-`N` compactness step; it does not
lose a power of the dyadic shell width. -/
theorem exists_uniform_nonstationaryIBPAmplitude_bound_of_jointContDiff
    {rhoMax a b : Real} (hrhoMax : 0 ≤ rhoMax) (hab : a ≤ b)
    (D : Real × Real → Real) (F : Real × Real → Complex)
    (hD : ContDiff Real (⊤ : ℕ∞) D) (hDne : ∀ p, D p ≠ 0)
    (hF : ContDiff Real (⊤ : ℕ∞) F) (N : Nat) :
    ∃ M : Real, 0 < M ∧
      ∀ rho ∈ Icc 0 rhoMax, ∀ u ∈ Icc a b,
        ‖nonstationaryIBPAmplitude (fun v => D (rho, v))
          (fun v => F (rho, v)) N u‖ ≤ M := by
  rcases exists_uniform_norm_bound_of_jointContinuous hrhoMax hab
      (fun rho u => jointNonstationaryIBPAmplitude D F N (rho, u))
      (by simpa using
        (contDiff_jointNonstationaryIBPAmplitude D F hD hDne hF N).continuous)
    with ⟨M, hM, hbound⟩
  refine ⟨M, hM, ?_⟩
  intro rho hrho u hu
  rw [← jointNonstationaryIBPAmplitude_eq_slice D F hD hDne hF N rho u]
  exact hbound rho hrho u hu

/-- The actual fixed outer-shell cutoff has a uniformly bounded final
nonlinear quotient amplitude at every prescribed finite order.  The proof
uses only angular jets, so the removable `sinc` singularity creates no
shell-width loss. -/
theorem exists_uniform_outerCircleFinalAmplitude_bound_fixedBump
    {rhoMax : Real} {N : Nat}
    (hrhoMax : 0 ≤ rhoMax) (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) :
    ∃ M : Real, 0 < M ∧
      ∀ rho ∈ Ioc 0 rhoMax, ∀ u ∈ Icc (1 / 2 : Real) 2,
        ‖nonstationaryIBPAmplitude (outerCircleShellDerivativeExtension rho)
          fixedOuterCircleUnitShellAmplitude N u‖ ≤ M := by
  let D : Real × Real → Real := safeOuterCircleUniformDerivativeExtension rhoMax
  let F : Real × Real → Complex := fun p => fixedOuterCircleUnitShellAmplitude p.2
  have hD : HasJointSndSmooth N D := by
    dsimp [D]
    exact hasJointSndSmooth_safeOuterCircleUniformDerivativeExtension rhoMax N
  have hF : HasJointSndSmooth N F := by
    dsimp [F]
    exact hasJointSndSmooth_of_contDiff
      (fun p : Real × Real => fixedOuterCircleUnitShellAmplitude p.2)
      contDiff_fixedOuterCircleUnitShellAmplitude_joint N
  have hDne : ∀ p, D p ≠ 0 := by
    intro p
    dsimp [D]
    exact safeOuterCircleUniformDerivativeExtension_ne_zero hrhoMax hrhoMax_small p
  have hA : HasJointSndSmooth 0
      (parametricNonstationaryIBPAmplitude D F N) :=
    hasJointSndSmooth_parametricNonstationaryIBPAmplitude
      (n := 0) (k := N) D F (by simpa using hD) (by simpa using hF) hDne
  have hAcont : Continuous (parametricNonstationaryIBPAmplitude D F N) := by
    simpa [HasJointSndSmooth] using hA
  rcases exists_uniform_norm_bound_of_jointContinuous
      (a := (1 / 2 : Real)) (b := 2) hrhoMax (by norm_num)
      (fun rho u => parametricNonstationaryIBPAmplitude D F N (rho, u))
      (by simpa using hAcont) with ⟨M, hM, hbound⟩
  refine ⟨M, hM, ?_⟩
  intro rho hrho u hu
  have hDslice : (fun v : Real => D (rho, v)) =
      outerCircleShellDerivativeExtension rho := by
    dsimp [D]
    exact (safeOuterCircleUniformDerivativeExtension_eq hrho.1.le hrho.2).trans
      (outerCircleUniformDerivativeExtension_eq hrho.1.ne')
  have heq : nonstationaryIBPAmplitude (outerCircleShellDerivativeExtension rho)
      fixedOuterCircleUnitShellAmplitude N u =
      parametricNonstationaryIBPAmplitude D F N (rho, u) := by
    calc
      nonstationaryIBPAmplitude (outerCircleShellDerivativeExtension rho)
          fixedOuterCircleUnitShellAmplitude N u =
          nonstationaryIBPAmplitude (fun v => D (rho, v))
            (fun v => F (rho, v)) N u := by
              dsimp [F]
              rw [hDslice]
      _ = parametricNonstationaryIBPAmplitude D F N (rho, u) :=
        (parametricNonstationaryIBPAmplitude_eq_slice D F N rho u).symm
  rw [heq]
  exact hbound rho ⟨hrho.1.le, hrho.2⟩ u hu

/-- The literal fixed outer-circle shell has uniform rapid decay at every
fixed IBP order.  This is the completed shell estimate needed before the
dyadic `TT*` summation: its constant is independent of the shell width. -/
theorem exists_uniform_literalOuterCircleUnitShell_fixedBump
    {rhoMax : Real} {N : Nat}
    (hrhoMax : 0 ≤ rhoMax) (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) :
    ∃ M : Real, 0 < M ∧
      ∀ rho ∈ Ioc 0 rhoMax, ∀ tau lambda : Real,
        tau * lambda * rho ^ 2 ≠ 0 →
        ‖(rho : Complex) * ∫ u in (1 / 2 : Real)..2,
          fixedOuterCircleUnitShellAmplitude u * Complex.exp
            (((tau * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I)‖ ≤
          rho * (1 / |tau * lambda * rho ^ 2|) ^ N *
            ((2 - (1 / 2 : Real)) * M) := by
  rcases exists_uniform_outerCircleFinalAmplitude_bound_fixedBump
      (N := N) hrhoMax hrhoMax_small with ⟨M, hM, hbound⟩
  refine ⟨M, hM, ?_⟩
  intro rho hrho tau lambda hfreq
  have hrho_small : 9 * rho / 4 < Real.pi := by
    calc
      9 * rho / 4 = (9 / 4 : Real) * rho := by ring
      _ ≤ (9 / 4 : Real) * rhoMax :=
        mul_le_mul_of_nonneg_left hrho.2 (by norm_num)
      _ = 9 * rhoMax / 4 := by ring
      _ < Real.pi := hrhoMax_small
  exact norm_literalOuterCircleUnitShell_of_contDiff hrho.1 hrho_small hfreq
    contDiff_fixedOuterCircleUnitShellAmplitude
    fixedOuterCircleUnitShellAmplitude_eventuallyEq_zero_left
    fixedOuterCircleUnitShellAmplitude_eventuallyEq_zero_right
    hM.le (hbound rho hrho)

/-- Circle-specialized transfer of the arbitrary-order joint-smooth family
lemma.  A smooth nonzero extension in the shell-width parameter which agrees
with the literal guarded circle derivative for positive widths supplies the
previously missing uniform final-amplitude bound. -/
theorem exists_uniform_outerCircleFinalAmplitude_bound_of_jointContDiffExtension
    {rhoMax : Real} {F : Real → Complex} {N : Nat}
    (hrhoMax : 0 ≤ rhoMax)
    (D : Real × Real → Real)
    (hD : ContDiff Real (⊤ : ℕ∞) D) (hDne : ∀ p, D p ≠ 0)
    (hDslice : ∀ rho ∈ Ioc 0 rhoMax,
      (fun u : Real => D (rho, u)) = outerCircleShellDerivativeExtension rho)
    (hF : ContDiff Real (⊤ : ℕ∞) F) :
    ∃ M : Real, 0 < M ∧
      ∀ rho ∈ Ioc 0 rhoMax, ∀ u ∈ Icc (1 / 2 : Real) 2,
        ‖nonstationaryIBPAmplitude (outerCircleShellDerivativeExtension rho)
          F N u‖ ≤ M := by
  have hFjoint : ContDiff Real (⊤ : ℕ∞) (fun p : Real × Real => F p.2) :=
    hF.comp contDiff_snd
  rcases exists_uniform_nonstationaryIBPAmplitude_bound_of_jointContDiff
      (a := (1 / 2 : Real)) (b := 2) hrhoMax (by norm_num)
      D (fun p : Real × Real => F p.2)
      hD hDne hFjoint N with ⟨M, hM, hbound⟩
  refine ⟨M, hM, ?_⟩
  intro rho hrho u hu
  rw [← hDslice rho hrho]
  simpa using hbound rho ⟨hrho.1.le, hrho.2⟩ u hu

/-- Conditional only on the explicit joint-smooth circle derivative extension,
the fixed rescaled bump has a uniform literal shell estimate at every fixed
IBP order.  Thus the cutoff family itself contributes no hidden `rho` loss. -/
theorem exists_uniform_literalOuterCircleUnitShell_fixedBump_of_jointContDiffExtension
    {rhoMax : Real} {N : Nat}
    (hrhoMax : 0 ≤ rhoMax) (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (D : Real × Real → Real)
    (hD : ContDiff Real (⊤ : ℕ∞) D) (hDne : ∀ p, D p ≠ 0)
    (hDslice : ∀ rho ∈ Ioc 0 rhoMax,
      (fun u : Real => D (rho, u)) = outerCircleShellDerivativeExtension rho) :
    ∃ M : Real, 0 < M ∧
      ∀ rho ∈ Ioc 0 rhoMax, ∀ tau lambda : Real,
        tau * lambda * rho ^ 2 ≠ 0 →
        ‖(rho : Complex) * ∫ u in (1 / 2 : Real)..2,
          fixedOuterCircleUnitShellAmplitude u * Complex.exp
            (((tau * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I)‖ ≤
          rho * (1 / |tau * lambda * rho ^ 2|) ^ N *
            ((2 - (1 / 2 : Real)) * M) := by
  rcases exists_uniform_outerCircleFinalAmplitude_bound_of_jointContDiffExtension
      (N := N) hrhoMax D hD hDne hDslice
      contDiff_fixedOuterCircleUnitShellAmplitude with ⟨M, hM, hbound⟩
  refine ⟨M, hM, ?_⟩
  intro rho hrho tau lambda hfreq
  have hrho_small : 9 * rho / 4 < Real.pi := by
    calc
      9 * rho / 4 = (9 / 4 : Real) * rho := by ring
      _ ≤ (9 / 4 : Real) * rhoMax :=
        mul_le_mul_of_nonneg_left hrho.2 (by norm_num)
      _ = 9 * rhoMax / 4 := by ring
      _ < Real.pi := hrhoMax_small
  exact norm_literalOuterCircleUnitShell_of_contDiff hrho.1 hrho_small hfreq
    contDiff_fixedOuterCircleUnitShellAmplitude
    fixedOuterCircleUnitShellAmplitude_eventuallyEq_zero_left
    fixedOuterCircleUnitShellAmplitude_eventuallyEq_zero_right
    hM.le (hbound rho hrho)

/-- This is the exact remaining uniform-amplitude hypothesis for the outer
circle shell: joint continuity of the final nonlinear quotient amplitude as
the rescaled width `rho` tends to zero. -/
