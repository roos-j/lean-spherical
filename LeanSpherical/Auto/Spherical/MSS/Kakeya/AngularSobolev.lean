        hrho.1.le (by norm_num) hfreq hphase
        (fun u hu => hDne (rho, u))
        (continuous_outerCircleShellPhase rho) hphaseDeriv_cont hchain hM.le hlast

/-- The bounded normalized factor occurring when an angular derivative hits
the circle phase.  It is `-sin (rho*u)/rho`, expressed through the removable
`sinc` representative so that its angular jets remain uniform as
`rho → 0`. -/
noncomputable def outerCirclePhaseDerivativeProductAmplitude
    (p : Real × Real) : Complex :=
  fixedOuterCircleUnitShellAmplitude p.2 ^ 2 *
    ((outerCircleScaledDerivative p.1 p.2 : Real) : Complex) ^ 2

theorem hasJointSndSmooth_outerCirclePhaseDerivativeProductAmplitude
    (n : Nat) :
    HasJointSndSmooth n outerCirclePhaseDerivativeProductAmplitude := by
  let chi : Real × Real → Complex := fun p => fixedOuterCircleUnitShellAmplitude p.2
  let d : Real × Real → Complex := fun p =>
    ((outerCircleScaledDerivative p.1 p.2 : Real) : Complex)
  have hchi : HasJointSndSmooth n chi := by
    dsimp [chi]
    exact hasJointSndSmooth_of_contDiff
      (fun p : Real × Real => fixedOuterCircleUnitShellAmplitude p.2)
      contDiff_fixedOuterCircleUnitShellAmplitude_joint n
  have hd : HasJointSndSmooth n d := by
    dsimp [d]
    exact (hasJointSndSmooth_outerCircleScaledDerivative n).ofReal
  convert (hchi.mul hchi).mul (hd.mul hd) using 1
  funext p
