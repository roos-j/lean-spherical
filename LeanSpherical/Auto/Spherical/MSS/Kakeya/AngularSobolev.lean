  rcases exists_uniform_outerCircleFinalAmplitude_bound_of_jointSndSmoothFamily
      (N := N) hrhoMax hrhoMax_small hF with ⟨M, hM, hbound⟩
  refine ⟨M, hM, ?_⟩
  intro rho hrho tau lambda hfreq
  let D : Real × Real → Real := safeOuterCircleUniformDerivativeExtension rhoMax
  let A : Nat → Real → Complex := fun k u =>
    parametricNonstationaryIBPAmplitude D F k (rho, u)
