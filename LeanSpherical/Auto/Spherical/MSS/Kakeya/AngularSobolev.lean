theorem signedSmoothTubeShell_iSupL2_le_endpointZeroGN_of_memLp_energy
    (μ : Measure WaveSpaceTime)
    (K dK : Real → Euclidean 2 → WaveSpaceTime → Complex)
    (g : WaveSpaceTime → Complex)
    {a b E E0 E1 q : Real} (hab : a ≤ b)
    (hTcont : Continuous (Function.uncurry
      (signedSmoothTubeOperator μ K g)))
    (hDcont : Continuous (Function.uncurry
      (signedSmoothTubeAngularDerivative μ dK g)))
