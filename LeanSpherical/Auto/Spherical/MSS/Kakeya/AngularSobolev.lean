/-- Once differentiation under inverse spatial Fourier transform is available,
the literal physical angular derivative is exactly the inverse transform of
the differentiated characteristic multiplier.  This is an equality of the
two derivative formulas, obtained by uniqueness rather than a second Fubini
calculation. -/
theorem finiteTensorTubeBandAngularDeriv_eq_fourierInv_of_hasDerivAt
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex) (theta : Real) (y : Euclidean 2)
    (hfreq : HasDerivAt
      (fun r => FourierTransform.fourierInv
        (scratch_finiteTensorTubeMultiplier s q hqcompact a
          (circleDirection r) : Euclidean 2 → Complex) y)
      (FourierTransform.fourierInv
        (finiteTensorTubeMultiplierAngularDeriv s q a theta : Euclidean 2 → Complex) y)
      theta) :
    finiteTensorTubeBandAngularDeriv s q a y theta =
      FourierTransform.fourierInv
        (finiteTensorTubeMultiplierAngularDeriv s q a theta : Euclidean 2 → Complex) y := by
  have hphysical := hasDerivAt_scratch_finiteTensorTubeBand_circle
    s q hqcompact a y theta
  have hfun :
      (fun r => scratch_finiteTensorTubeBand s q hqcompact a
        (circleDirection r) y) =
      (fun r => FourierTransform.fourierInv
        (scratch_finiteTensorTubeMultiplier s q hqcompact a
          (circleDirection r) : Euclidean 2 → Complex) y) := by
    funext r
    exact scratch_finiteTensorTubeBand_eq_fourierInv s q hqcompact a
      (circleDirection r) y
  rw [hfun] at hphysical
  exact hphysical.unique hfreq

/-- The unconditional finite-tensor Fourier/physical angular derivative
identification.  The inverse-Fourier differentiation is supplied by the
Schwartz-dominated transport theorem; the conclusion is then just the
uniqueness bridge above. -/
theorem finiteTensorTubeBandAngularDeriv_eq_fourierInv
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex) (theta : Real) (y : Euclidean 2) :
    finiteTensorTubeBandAngularDeriv s q a y theta =
      FourierTransform.fourierInv
        (finiteTensorTubeMultiplierAngularDeriv s q a theta : Euclidean 2 → Complex) y := by
  apply finiteTensorTubeBandAngularDeriv_eq_fourierInv_of_hasDerivAt
    s q hqcompact a theta y
  exact hasDerivAt_fourierInv_scratch_finiteTensorTubeMultiplier_circle
    s q hqcompact a theta y

end

