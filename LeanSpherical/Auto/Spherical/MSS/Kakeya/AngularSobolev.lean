    (hDmem : MemLp (fun p : Real × Euclidean 2 =>
      signedSmoothTubeAngularDerivative μ dK g p.1 p.2) 2
      ((volume.restrict (Icc a b)).prod volume))
    (hE0energy : (∫ p : Real × Euclidean 2,
      ‖signedSmoothTubeOperator μ K g p.1 p.2‖ ^ 2 ∂
