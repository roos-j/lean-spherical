/-- A literal signed smooth tube operator with angular parameter `theta`.
The source variable is space--time and no positivity is imposed on either the
kernel or the input. -/
def signedSmoothTubeOperator
    (μ : Measure WaveSpaceTime)
    (K : Real → Euclidean 2 → WaveSpaceTime → Complex)
    (g : WaveSpaceTime → Complex) (theta : Real) (y : Euclidean 2) : Complex :=
  ∫ z, K theta y z * g z ∂μ

/-- The candidate angular derivative of a signed smooth tube operator.  The
derivative relation is an explicit hypothesis below, so differentiation under
the integral is never silently assumed. -/
def signedSmoothTubeAngularDerivative
    (μ : Measure WaveSpaceTime)
    (dK : Real → Euclidean 2 → WaveSpaceTime → Complex)
    (g : WaveSpaceTime → Complex) (theta : Real) (y : Euclidean 2) : Complex :=
  ∫ z, dK theta y z * g z ∂μ

/-- A shell cutoff which is literally zero at the left endpoint makes the
associated signed tube operator zero there.  This is the exact endpoint fact
provided by the rescaled compact bump used for the angular shells. -/
theorem signedSmoothTubeOperator_eq_zero_of_kernel_eq_zero
    (μ : Measure WaveSpaceTime)
    (K : Real → Euclidean 2 → WaveSpaceTime → Complex)
    (g : WaveSpaceTime → Complex) {a : Real}
    (hK : ∀ y z, K a y z = 0) :
    ∀ y, signedSmoothTubeOperator μ K g a y = 0 := by
  intro y
  simp [signedSmoothTubeOperator, hK]

/-- Continuous shellwise `L²` product-Sobolev estimate for the literal signed
smooth tube operator.  These are exactly the analytic hypotheses needed by a
scaled angular `H¹` argument: joint continuity of the operator and its
angular derivative, an honest pointwise derivative identity, integrability of
the left slice and of the product, plus quantitative bounds for those two
terms.  No global quadratic model is used. -/
theorem signedSmoothTubeShell_iSupL2_le_scaledProduct
    (μ : Measure WaveSpaceTime)
    (K dK : Real → Euclidean 2 → WaveSpaceTime → Complex)
    (g : WaveSpaceTime → Complex)
    {a b E0 E1 : Real} (hab : a ≤ b)
    (hT : Continuous (Function.uncurry
      (signedSmoothTubeOperator μ K g)))
    (hD : Continuous (Function.uncurry
      (signedSmoothTubeAngularDerivative μ dK g)))
    (hderiv : ∀ theta y,
      HasDerivAt
        (fun s => signedSmoothTubeOperator μ K g s y)
        (signedSmoothTubeAngularDerivative μ dK g theta y) theta)
    (hleft : Integrable (fun y : Euclidean 2 =>
      ‖signedSmoothTubeOperator μ K g a y‖ ^ 2) volume)
    (hproduct_integrable : Integrable (fun p : Real × Euclidean 2 =>
      ‖signedSmoothTubeOperator μ K g p.1 p.2‖ *
        ‖signedSmoothTubeAngularDerivative μ dK g p.1 p.2‖)
      ((volume.restrict (Icc a b)).prod volume))
    (hbase : (∫ y : Euclidean 2,
      ‖signedSmoothTubeOperator μ K g a y‖ ^ 2) ≤ (b - a)⁻¹ * E0)
    (hproduct : (∫ theta in a..b, ∫ y : Euclidean 2,
      ‖signedSmoothTubeOperator μ K g theta y‖ *
        ‖signedSmoothTubeAngularDerivative μ dK g theta y‖) ≤
        Real.sqrt (E0 * E1)) :
    Measurable (fun y : Euclidean 2 =>
      ⨆ theta : Icc a b, ENNReal.ofReal
        (‖signedSmoothTubeOperator μ K g theta.1 y‖ ^ 2)) ∧
      (∫⁻ y : Euclidean 2, ⨆ theta : Icc a b, ENNReal.ofReal
        (‖signedSmoothTubeOperator μ K g theta.1 y‖ ^ 2)) ≤
        ENNReal.ofReal ((b - a)⁻¹ * E0 + 2 * Real.sqrt (E0 * E1)) := by
  rcases measurable_and_lintegral_iSup_ennreal_norm_sq_le_radiusSobolev_product_of_hasDerivAt
      (d := 2) hab hT hD hderiv hleft hproduct_integrable with ⟨hmeas, hbound⟩
  refine ⟨hmeas, hbound.trans ?_⟩
  apply ENNReal.ofReal_le_ofReal
  exact add_le_add hbase (mul_le_mul_of_nonneg_left hproduct (by norm_num))

/-- The endpoint-zero version is the one used by a genuine smooth angular
shell cutoff.  It has no mean-value or `rho⁻¹` loss: the product form of the
one-dimensional Sobolev estimate gives exactly the critical geometric mean of
the shell `L²` and angular-derivative `L²` energies. -/
theorem signedSmoothTubeShell_iSupL2_le_endpointZeroGN
    (μ : Measure WaveSpaceTime)
    (K dK : Real → Euclidean 2 → WaveSpaceTime → Complex)
    (g : WaveSpaceTime → Complex)
    {a b E0 E1 : Real} (hab : a ≤ b)
    (hT : Continuous (Function.uncurry
      (signedSmoothTubeOperator μ K g)))
    (hD : Continuous (Function.uncurry
      (signedSmoothTubeAngularDerivative μ dK g)))
    (hderiv : ∀ theta y,
      HasDerivAt
        (fun s => signedSmoothTubeOperator μ K g s y)
        (signedSmoothTubeAngularDerivative μ dK g theta y) theta)
    (hzero : ∀ y, signedSmoothTubeOperator μ K g a y = 0)
    (hproduct_integrable : Integrable (fun p : Real × Euclidean 2 =>
      ‖signedSmoothTubeOperator μ K g p.1 p.2‖ *
        ‖signedSmoothTubeAngularDerivative μ dK g p.1 p.2‖)
      ((volume.restrict (Icc a b)).prod volume))
    (hproduct : (∫ theta in a..b, ∫ y : Euclidean 2,
      ‖signedSmoothTubeOperator μ K g theta y‖ *
        ‖signedSmoothTubeAngularDerivative μ dK g theta y‖) ≤
        Real.sqrt (E0 * E1)) :
    Measurable (fun y : Euclidean 2 =>
      ⨆ theta : Icc a b, ENNReal.ofReal
        (‖signedSmoothTubeOperator μ K g theta.1 y‖ ^ 2)) ∧
      (∫⁻ y : Euclidean 2, ⨆ theta : Icc a b, ENNReal.ofReal
        (‖signedSmoothTubeOperator μ K g theta.1 y‖ ^ 2)) ≤
        ENNReal.ofReal (2 * Real.sqrt (E0 * E1)) := by
  have hbasefun : (fun y : Euclidean 2 =>
      ‖signedSmoothTubeOperator μ K g a y‖ ^ 2) = 0 := by
    funext y
    simp [hzero y]
  have hleft : Integrable (fun y : Euclidean 2 =>
      ‖signedSmoothTubeOperator μ K g a y‖ ^ 2) volume := by
    rw [hbasefun]
    exact integrable_zero (Euclidean 2) ℝ volume
  rcases measurable_and_lintegral_iSup_ennreal_norm_sq_le_radiusSobolev_product_of_hasDerivAt
      (d := 2) hab hT hD hderiv hleft hproduct_integrable with ⟨hmeas, hbound⟩
  rw [hbasefun] at hbound
  refine ⟨hmeas, hbound.trans ?_⟩
  simpa using ENNReal.ofReal_le_ofReal
    (mul_le_mul_of_nonneg_left hproduct (by norm_num : (0 : Real) ≤ 2))

/-- The scale algebra behind the endpoint-zero angular Sobolev bound.  If the
shell and differentiated-shell energies are reciprocal at scale `q`, their
geometric mean has no `q` loss. -/
theorem sqrt_mul_le_energy_of_reciprocal_scaled_bounds
    {E E0 E1 q : Real} (hE : 0 ≤ E) (hq : 0 < q)
    (hE0 : E0 ≤ q⁻¹ * E) (hE1 : E1 ≤ q * E)
    (hE1_nonneg : 0 ≤ E1) :
    Real.sqrt (E0 * E1) ≤ E := by
  have hq_nonneg : 0 ≤ q := hq.le
  have hbound0_nonneg : 0 ≤ q⁻¹ * E :=
    mul_nonneg (inv_nonneg.mpr hq_nonneg) hE
  have hprod : E0 * E1 ≤ (q⁻¹ * E) * (q * E) :=
    mul_le_mul hE0 hE1 hE1_nonneg hbound0_nonneg
  have hcancel : (q⁻¹ * E) * (q * E) = E ^ 2 := by
    field_simp [hq.ne']
  rw [hcancel] at hprod
  exact (Real.sqrt_le_left hE).mpr hprod

/-- The continuous Cauchy bridge needed after two `TT*` shell-energy bounds.
It is stated over an arbitrary measure space so that the shell measure can be
the product of the angular interval and physical output space. -/
theorem integral_norm_mul_norm_le_sqrt_mul_integral_norm_sq
    {α : Type*} [MeasurableSpace α] (μ : Measure α)
    (F D : α → Complex) (hF : MemLp F 2 μ) (hD : MemLp D 2 μ) :
    (∫ x, ‖F x‖ * ‖D x‖ ∂μ) ≤
      Real.sqrt (∫ x, ‖F x‖ ^ 2 ∂μ) *
        Real.sqrt (∫ x, ‖D x‖ ^ 2 ∂μ) := by
  have hholder := integral_mul_norm_le_Lp_mul_Lq
    (μ := μ) (f := F) (g := D) (p := 2) (q := 2)
    (by norm_num [Real.holderConjugate_iff]) (by simpa using hF)
    (by simpa using hD)
  simpa [Real.sqrt_eq_rpow] using hholder

/-- The product integrability required by the angular endpoint theorem is
automatic from two `L²` memberships on the product shell measure. -/
theorem integrable_norm_mul_norm_of_memLp_two
    {α : Type*} [MeasurableSpace α] (μ : Measure α)
    (F D : α → Complex) (hF : MemLp F 2 μ) (hD : MemLp D 2 μ) :
    Integrable (fun x => ‖F x‖ * ‖D x‖) μ := by
  change Integrable ((fun x => ‖F x‖) * fun x => ‖D x‖) μ
  exact hF.norm.integrable_mul hD.norm

/-- Explicit energy-form Cauchy--Schwarz.  This is the exact bridge from
two continuous `TT*` `L²` estimates to the product hypothesis in the
endpoint-zero angular Sobolev estimate. -/
theorem integral_norm_mul_norm_le_sqrt_mul_of_energy_bounds
    {α : Type*} [MeasurableSpace α] (μ : Measure α)
    (F D : α → Complex) (hF : MemLp F 2 μ) (hD : MemLp D 2 μ)
    {E0 E1 : Real}
    (hE0 : (∫ x, ‖F x‖ ^ 2 ∂μ) ≤ E0)
    (hE1 : (∫ x, ‖D x‖ ^ 2 ∂μ) ≤ E1) :
    (∫ x, ‖F x‖ * ‖D x‖ ∂μ) ≤ Real.sqrt (E0 * E1) := by
  have hA_nonneg : 0 ≤ ∫ x, ‖F x‖ ^ 2 ∂μ :=
    integral_nonneg fun _ => sq_nonneg _
  have hB_nonneg : 0 ≤ ∫ x, ‖D x‖ ^ 2 ∂μ :=
    integral_nonneg fun _ => sq_nonneg _
  have hE0_nonneg : 0 ≤ E0 := hA_nonneg.trans hE0
  have hE1_nonneg : 0 ≤ E1 := hB_nonneg.trans hE1
  calc
    (∫ x, ‖F x‖ * ‖D x‖ ∂μ) ≤
        Real.sqrt (∫ x, ‖F x‖ ^ 2 ∂μ) *
          Real.sqrt (∫ x, ‖D x‖ ^ 2 ∂μ) :=
      integral_norm_mul_norm_le_sqrt_mul_integral_norm_sq μ F D hF hD
    _ ≤ Real.sqrt E0 * Real.sqrt E1 :=
      mul_le_mul (Real.sqrt_le_sqrt hE0) (Real.sqrt_le_sqrt hE1)
        (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
    _ = Real.sqrt (E0 * E1) := (Real.sqrt_mul hE0_nonneg E1).symm

/-- Fubini identification of the iterated angular/physical integral with the
product-shell measure used by continuous `TT*`. -/
theorem intervalIntegral_integral_eq_integral_productShell
    {a b : Real} (hab : a ≤ b)
    (H : Real → Euclidean 2 → Real)
    (hH : Integrable (fun p : Real × Euclidean 2 => H p.1 p.2)
      ((volume.restrict (Icc a b)).prod volume)) :
    (∫ theta in a..b, ∫ y : Euclidean 2, H theta y) =
      ∫ p : Real × Euclidean 2, H p.1 p.2 ∂
        ((volume.restrict (Icc a b)).prod volume) := by
  calc
    (∫ theta in a..b, ∫ y : Euclidean 2, H theta y) =
        ∫ theta : Real, (∫ y : Euclidean 2, H theta y) ∂
          (volume.restrict (Icc a b)) := by
      rw [intervalIntegral.integral_of_le hab]
      change (∫ theta in Ioc a b, (∫ y : Euclidean 2, H theta y)) = _
      rw [← integral_Icc_eq_integral_Ioc]
    _ = ∫ p : Real × Euclidean 2, H p.1 p.2 ∂
          ((volume.restrict (Icc a b)).prod volume) :=
      (integral_prod _ hH).symm

/-- Concrete product-shell formulation of the Cauchy step.  Thus a pair of
continuous `TT*` energy bounds for `F` and its angular derivative immediately
