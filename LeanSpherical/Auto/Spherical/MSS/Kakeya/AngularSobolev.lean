theorem exists_uniform_literalOuterCircleUnitShell_bound_of_jointSndSmoothFamily
    {rhoMax : Real} {F : Real × Real → Complex} {N : Nat}
    (hrhoMax : 0 ≤ rhoMax) (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (hF : HasJointSndSmooth N F)
    (hFleft : ∀ rho ∈ Ioc 0 rhoMax,
      (fun u : Real => F (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hFright : ∀ rho ∈ Ioc 0 rhoMax,
      (fun u : Real => F (rho, u)) =ᶠ[nhds 2] 0) :
    ∃ M : Real, 0 < M ∧
      ∀ rho ∈ Ioc 0 rhoMax, ∀ tau lambda : Real,
        tau * lambda * rho ^ 2 ≠ 0 →
        ‖(rho : Complex) * ∫ u in (1 / 2 : Real)..2,
          F (rho, u) * Complex.exp
            (((tau * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I)‖ ≤
          rho * (1 / |tau * lambda * rho ^ 2|) ^ N *
            ((2 - (1 / 2 : Real)) * M) := by
  rcases exists_uniform_outerCircleFinalAmplitude_bound_of_jointSndSmoothFamily
      (N := N) hrhoMax hrhoMax_small hF with ⟨M, hM, hbound⟩
  refine ⟨M, hM, ?_⟩
  intro rho hrho tau lambda hfreq
  let D : Real × Real → Real := safeOuterCircleUniformDerivativeExtension rhoMax
  let A : Nat → Real → Complex := fun k u =>
    parametricNonstationaryIBPAmplitude D F k (rho, u)
  have hD : HasJointSndSmooth N D := by
    dsimp [D]
    exact hasJointSndSmooth_safeOuterCircleUniformDerivativeExtension rhoMax N
  have hDne : ∀ p, D p ≠ 0 := by
    intro p
    dsimp [D]
    exact safeOuterCircleUniformDerivativeExtension_ne_zero hrhoMax hrhoMax_small p
  have hDslice : (fun u : Real => D (rho, u)) =
      outerCircleShellDerivativeExtension rho := by
    dsimp [D]
    exact (safeOuterCircleUniformDerivativeExtension_eq hrho.1.le hrho.2).trans
      (outerCircleUniformDerivativeExtension_eq hrho.1.ne')
  have hchain : HasNonstationaryPhaseIBPChain (1 / 2 : Real) 2
      (fun u : Real => D (rho, u)) A N := by
    dsimp [A]
    exact hasNonstationaryPhaseIBPChain_parametric_of_jointSndSmooth
      hD hF hDne (hFleft rho hrho) (hFright rho hrho)
  have hphase : ∀ u ∈ uIcc (1 / 2 : Real) 2,
      HasDerivAt (outerCircleShellPhase rho) (D (rho, u)) u := by
    intro u hu
    have hu' : u ∈ Icc (1 / 2 : Real) 2 := by
      rw [uIcc_of_le (by norm_num)] at hu
      exact ⟨hu.1, hu.2⟩
