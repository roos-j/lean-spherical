    exact hasDerivAt_outerCircleShellPhase hrho.1.ne'
  have hDcont : Continuous D := by
    simpa [HasJointSndSmooth] using (hD.of_le (Nat.zero_le _))
  have hphaseDeriv_cont : Continuous (fun u : Real => D (rho, u)) :=
    hDcont.comp (continuous_const.prodMk continuous_id)
  have hlast : ∀ u ∈ Icc (1 / 2 : Real) 2, ‖A N u‖ ≤ M := by
    intro u hu
    dsimp [A]
    rw [parametricNonstationaryIBPAmplitude_eq_slice, hDslice]
    exact hbound rho hrho u hu
  have hnorm := norm_intervalIntegral_literalCircleShell_eq_normalized
    (a := (1 / 2 : Real)) (b := 2) (tau := tau) (lambda := lambda)
    (rho := rho) hrho.1.ne' (fun u => F (rho, u))
  calc
    ‖(rho : Complex) * ∫ u in (1 / 2 : Real)..2,
        F (rho, u) * Complex.exp
          (((tau * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I)‖ =
        rho * ‖∫ u in (1 / 2 : Real)..2,
          F (rho, u) * Complex.exp
            (((tau * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I)‖ := by
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hrho.1.le]
    _ = rho * ‖∫ u in (1 / 2 : Real)..2,
