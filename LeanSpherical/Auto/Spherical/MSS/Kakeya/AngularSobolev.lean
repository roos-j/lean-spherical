      parametricNonstationaryIBPAmplitude D F k p *
        ((D p : Real) : Complex)⁻¹) := hAprev.mul hDinv
  rcases hquot with ⟨_, Q', hQ', hQderiv⟩
  have hQeq : parametricNonstationaryIBPAmplitude D F (k + 1) = Q' := by
    funext p
    change deriv (fun v : Real =>
      parametricNonstationaryIBPAmplitude D F k (p.1, v) *
        ((D (p.1, v) : Real) : Complex)⁻¹) p.2 = Q' p
    exact (hQderiv p.1 p.2).deriv
  constructor
  · intro u hu
    change HasDerivAt (fun v : Real =>
      parametricNonstationaryIBPAmplitude D F k (rho, v) *
        ((D (rho, v) : Real) : Complex)⁻¹)
      (parametricNonstationaryIBPAmplitude D F (k + 1) (rho, u)) u
    rw [hQeq]
    exact hQderiv rho u
  constructor
  · change Continuous (fun u : Real =>
      parametricNonstationaryIBPAmplitude D F (k + 1) (rho, u))
    rw [hQeq]
    exact hQ'.comp (continuous_const.prodMk continuous_id)
  constructor
