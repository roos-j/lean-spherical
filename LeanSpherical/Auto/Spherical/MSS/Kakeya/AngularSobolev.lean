      (∫⁻ y : Euclidean 2, ⨆ theta : Icc a b, ENNReal.ofReal
        (‖signedSmoothTubeOperator μ K g theta.1 y‖ ^ 2)) ≤
        ENNReal.ofReal (2 * E) := by
  rcases signedSmoothTubeShell_iSupL2_le_endpointZeroGN
      μ K dK g hab hT hD hderiv hzero hproduct_integrable hproduct with
      ⟨hmeas, hbound⟩
  refine ⟨hmeas, hbound.trans ?_⟩
  apply ENNReal.ofReal_le_ofReal
  exact mul_le_mul_of_nonneg_left
    (sqrt_mul_le_energy_of_reciprocal_scaled_bounds hE hq hE0 hE1 hE1_nonneg)
