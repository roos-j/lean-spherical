by the endpoint-zero shell theorem. -/
theorem angularShell_product_bound_of_memLp_energy
    {a b : Real} (hab : a ≤ b)
    (F D : Real → Euclidean 2 → Complex)
    (hF : MemLp (fun p : Real × Euclidean 2 => F p.1 p.2) 2
      ((volume.restrict (Icc a b)).prod volume))
    (hD : MemLp (fun p : Real × Euclidean 2 => D p.1 p.2) 2
      ((volume.restrict (Icc a b)).prod volume))
    {E0 E1 : Real}
    (hE0 : (∫ p : Real × Euclidean 2, ‖F p.1 p.2‖ ^ 2 ∂
      ((volume.restrict (Icc a b)).prod volume)) ≤ E0)
    (hE1 : (∫ p : Real × Euclidean 2, ‖D p.1 p.2‖ ^ 2 ∂
      ((volume.restrict (Icc a b)).prod volume)) ≤ E1) :
    Integrable (fun p : Real × Euclidean 2 =>
      ‖F p.1 p.2‖ * ‖D p.1 p.2‖)
      ((volume.restrict (Icc a b)).prod volume) ∧
      (∫ theta in a..b, ∫ y : Euclidean 2,
        ‖F theta y‖ * ‖D theta y‖) ≤ Real.sqrt (E0 * E1) := by
  have hprod : Integrable (fun p : Real × Euclidean 2 =>
      ‖F p.1 p.2‖ * ‖D p.1 p.2‖)
      ((volume.restrict (Icc a b)).prod volume) :=
    integrable_norm_mul_norm_of_memLp_two
