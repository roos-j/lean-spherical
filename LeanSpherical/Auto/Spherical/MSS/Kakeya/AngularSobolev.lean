private theorem finset_sum_function_apply
    {ι X A : Type*} [AddCommMonoid A]
    (s : Finset ι) (F : ι → X → A) (x : X) :
    (∑ i ∈ s, F i) x = ∑ i ∈ s, F i x := by
  classical
  induction s using Finset.induction_on with
  | empty => rfl
  | insert b s hb ih =>
      rw [Finset.sum_insert hb, Finset.sum_insert hb]
      change F b x + (∑ i ∈ s, F i) x = F b x + ∑ i ∈ s, F i x
      rw [ih]

/-- A parameter-differentiation lemma for inverse spatial Fourier integrals.
The hypotheses are deliberately stated after multiplication by the Fourier
character, so it can be reused with any compact tensor symbol without an
unjustified Fourier/Fubini interchange. -/
private theorem angularTransportPrivate_hasDerivAt_fourierInv_of_dominated
    (m dm : Real → Euclidean 2 → Complex) (theta : Real)
    (hy : Euclidean 2)
    (hmeas : ∀ᶠ r in nhds theta, AEStronglyMeasurable
      (fun xi => (Real.fourierChar (inner Real xi hy) : Complex) • m r xi))
    (hint : Integrable
      (fun xi => (Real.fourierChar (inner Real xi hy) : Complex) • m theta xi))
    (hdmeas : AEStronglyMeasurable
      (fun xi => (Real.fourierChar (inner Real xi hy) : Complex) • dm theta xi))
    (bound : Euclidean 2 → Real)
    (hbound : ∀ᵐ xi : Euclidean 2, ∀ r ∈ (Set.univ : Set Real),
      ‖(Real.fourierChar (inner Real xi hy) : Complex) • dm r xi‖ ≤ bound xi)
    (hboundint : Integrable bound)
    (hdiff : ∀ᵐ xi : Euclidean 2, ∀ r ∈ (Set.univ : Set Real),
      HasDerivAt (fun r =>
        (Real.fourierChar (inner Real xi hy) : Complex) • m r xi)
        ((Real.fourierChar (inner Real xi hy) : Complex) • dm r xi) r) :
    HasDerivAt (fun r => FourierTransform.fourierInv (m r) hy)
      (FourierTransform.fourierInv (dm theta) hy) theta := by
  simp only [Real.fourierInv_eq]
  exact (hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := volume) (s := Set.univ) (x₀ := theta) (bound := bound)
    (F := fun r xi =>
      (Real.fourierChar (inner Real xi hy) : Complex) • m r xi)
    (F' := fun r xi =>
      (Real.fourierChar (inner Real xi hy) : Complex) • dm r xi)
    Filter.univ_mem hmeas hint hdmeas hbound hboundint hdiff).2

/-- The spatial point sampled by a tube moving along the literal circle. -/
noncomputable def tubeCircleShift
    (y : Euclidean 2) (theta t : Real) : Euclidean 2 :=
  y - t • circleDirection theta

/-- Its angular velocity. -/
noncomputable def tubeCircleVelocity (theta t : Real) : Euclidean 2 :=
  -t • circleDirectionDeriv theta

theorem hasDerivAt_tubeCircleShift
    (y : Euclidean 2) (theta t : Real) :
    HasDerivAt (fun r => tubeCircleShift y r t)
      (tubeCircleVelocity theta t) theta := by
  unfold tubeCircleShift tubeCircleVelocity
  have hdir : HasDerivAt (fun r => t • circleDirection r)
      (t • circleDirectionDeriv theta) theta :=
    (hasDerivAt_circleDirection theta).const_smul t
  have hfun : (fun r => y - t • circleDirection r) =
      ((fun _ : Real => y) - fun r => t • circleDirection r) := by
    funext r
    simp
  rw [hfun]
  rw [neg_smul]
  simpa only [zero_sub] using (hasDerivAt_const theta y).sub hdir

/-- The pointwise differentiated time integrand for one compact-frequency
Schwartz tensor. -/
noncomputable def tubeCircleSpatialDeriv
    (q : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) ((Euclidean 2) →L[Real] Complex) :=
  SchwartzMap.fderivCLM Real (Euclidean 2) Complex
    (FourierTransform.fourierInv q)

noncomputable def tubeCircleIntegrandDeriv
    (q : SchwartzMap (Euclidean 2) Complex)
    (a : SchwartzMap Real Complex)
    (y : Euclidean 2) (theta t : Real) : Complex :=
  a t * tubeCircleSpatialDeriv q (tubeCircleShift y theta t)
    (tubeCircleVelocity theta t)

theorem hasDerivAt_tubeCircleIntegrand
    (q : SchwartzMap (Euclidean 2) Complex)
    (a : SchwartzMap Real Complex)
    (y : Euclidean 2) (theta t : Real) :
    HasDerivAt
      (fun r => a t * (FourierTransform.fourierInv q)
        (tubeCircleShift y r t))
      (tubeCircleIntegrandDeriv q a y theta t) theta := by
  unfold tubeCircleIntegrandDeriv tubeCircleSpatialDeriv
  have hshift := hasDerivAt_tubeCircleShift y theta t
  have hq := (FourierTransform.fourierInv q).hasFDerivAt
    (tubeCircleShift y theta t)
  have hcomp := hq.comp theta hshift.hasFDerivAt
  have hscalar := hcomp.hasDerivAt
  simpa only [Function.comp_apply, ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.toSpanSingleton_apply, one_smul,
    SchwartzMap.fderivCLM_apply] using hscalar.const_mul (a t)

/-- The literal angular derivative of a single compact-frequency smooth tube
band along the circle. -/
noncomputable def tubeCircleBandAngularDeriv
    (q : SchwartzMap (Euclidean 2) Complex)
    (a : SchwartzMap Real Complex)
    (y : Euclidean 2) (theta : Real) : Complex :=
  ∫ t : Real, tubeCircleIntegrandDeriv q a y theta t

private theorem continuous_tubeCircleShift_time
    (y : Euclidean 2) (theta : Real) :
    Continuous (fun t => tubeCircleShift y theta t) := by
  unfold tubeCircleShift
  fun_prop

private theorem continuous_tubeCircleVelocity_time
    (theta : Real) :
    Continuous (fun t => tubeCircleVelocity theta t) := by
  unfold tubeCircleVelocity
  fun_prop

private theorem continuous_tubeCircleIntegrand_time
    (q : SchwartzMap (Euclidean 2) Complex)
    (a : SchwartzMap Real Complex)
    (y : Euclidean 2) (theta : Real) :
    Continuous (fun t => a t * (FourierTransform.fourierInv q)
      (tubeCircleShift y theta t)) := by
  exact a.continuous.mul
    ((FourierTransform.fourierInv q).continuous.comp
      (continuous_tubeCircleShift_time y theta))

private theorem continuous_tubeCircleIntegrandDeriv_time
    (q : SchwartzMap (Euclidean 2) Complex)
    (a : SchwartzMap Real Complex)
    (y : Euclidean 2) (theta : Real) :
    Continuous (fun t => tubeCircleIntegrandDeriv q a y theta t) := by
  unfold tubeCircleIntegrandDeriv
  exact a.continuous.mul
    (((tubeCircleSpatialDeriv q).continuous.comp
      (continuous_tubeCircleShift_time y theta)).clm_apply
      (continuous_tubeCircleVelocity_time theta))

private theorem integrable_tubeCircleIntegrand
    (q : SchwartzMap (Euclidean 2) Complex)
    (a : SchwartzMap Real Complex)
    (y : Euclidean 2) (theta : Real) :
    Integrable (fun t => a t * (FourierTransform.fourierInv q)
      (tubeCircleShift y theta t)) := by
  let C : Real := (SchwartzMap.seminorm Complex 0 0) (FourierTransform.fourierInv q)
  have ha : Integrable (fun t : Real => ‖a t‖) := a.integrable.norm
  have hC : Integrable (fun t : Real => C * ‖a t‖) := ha.const_mul C
  refine hC.mono' (continuous_tubeCircleIntegrand_time q a y theta).aestronglyMeasurable ?_
  filter_upwards with t
  calc
    ‖a t * (FourierTransform.fourierInv q) (tubeCircleShift y theta t)‖ =
        ‖a t‖ * ‖(FourierTransform.fourierInv q) (tubeCircleShift y theta t)‖ := norm_mul _ _
    _ ≤ ‖a t‖ * C := mul_le_mul_of_nonneg_left
      (SchwartzMap.norm_le_seminorm Complex (FourierTransform.fourierInv q) _) (norm_nonneg _)
    _ = C * ‖a t‖ := mul_comm _ _

private theorem integrable_tubeCircleIntegrandDeriv
    (q : SchwartzMap (Euclidean 2) Complex)
    (a : SchwartzMap Real Complex)
    (y : Euclidean 2) (theta : Real) :
    Integrable (fun t => tubeCircleIntegrandDeriv q a y theta t) := by
  let C : Real := (SchwartzMap.seminorm Complex 0 0) (tubeCircleSpatialDeriv q)
  have ha : Integrable (fun t : Real => ‖t‖ * ‖a t‖) := by
    simpa using a.integrable_pow_mul_iteratedFDeriv volume 1 0
  have hC : Integrable (fun t : Real => C * (‖t‖ * ‖a t‖)) := ha.const_mul C
  refine hC.mono'
    (continuous_tubeCircleIntegrandDeriv_time q a y theta).aestronglyMeasurable ?_
  filter_upwards with t
  unfold tubeCircleIntegrandDeriv
  calc
    ‖a t * tubeCircleSpatialDeriv q (tubeCircleShift y theta t)
        (tubeCircleVelocity theta t)‖ =
        ‖a t‖ * ‖tubeCircleSpatialDeriv q (tubeCircleShift y theta t)
          (tubeCircleVelocity theta t)‖ := norm_mul _ _
    _ ≤ ‖a t‖ *
        (‖tubeCircleSpatialDeriv q (tubeCircleShift y theta t)‖ *
          ‖tubeCircleVelocity theta t‖) := mul_le_mul_of_nonneg_left
      (ContinuousLinearMap.le_opNorm _ _) (norm_nonneg _)
    _ ≤ ‖a t‖ * (C * ‖tubeCircleVelocity theta t‖) := by
      gcongr
      exact SchwartzMap.norm_le_seminorm Complex (tubeCircleSpatialDeriv q) _
    _ = C * (‖t‖ * ‖a t‖) := by
      unfold tubeCircleVelocity
      rw [norm_smul, norm_neg, norm_circleDirectionDeriv, mul_one]
      ring

/-- Differentiation under the time integral for one literal compact-frequency
smooth tube band.  Both the integrability and the dominating function are
obtained solely from Schwartz decay. -/
theorem hasDerivAt_scratch_smoothTubeBand_circle
    (q : SchwartzMap (Euclidean 2) Complex)
    (hqcompact : HasCompactSupport (q : Euclidean 2 → Complex))
    (a : SchwartzMap Real Complex)
    (y : Euclidean 2) (theta : Real) :
    HasDerivAt
      (fun r => scratch_smoothTubeBand q hqcompact a (circleDirection r) y)
      (tubeCircleBandAngularDeriv q a y theta) theta := by
  simp only [scratch_smoothTubeBand_eq_translated]
  unfold tubeCircleBandAngularDeriv
  have hFint : Integrable (fun t : Real => a t *
      (FourierTransform.fourierInv (q : Euclidean 2 → Complex))
        (tubeCircleShift y theta t)) := by
    simpa only [SchwartzMap.fourierInv_coe] using
      integrable_tubeCircleIntegrand q a y theta
  apply (hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := volume) (s := Set.univ) (x₀ := theta)
    (bound := fun t : Real =>
      (SchwartzMap.seminorm Complex 0 0) (tubeCircleSpatialDeriv q) * (‖t‖ * ‖a t‖))
    (F := fun r t => a t * (FourierTransform.fourierInv
      (q : Euclidean 2 → Complex))
      (tubeCircleShift y r t))
    (F' := fun r t => tubeCircleIntegrandDeriv q a y r t)
    Filter.univ_mem ?_ hFint ?_ ?_ ?_ ?_).2
  · filter_upwards with r
    simpa only [SchwartzMap.fourierInv_coe] using
      (continuous_tubeCircleIntegrand_time q a y r).aestronglyMeasurable
  · exact (continuous_tubeCircleIntegrandDeriv_time q a y theta).aestronglyMeasurable
  · filter_upwards with t
    intro r hr
    unfold tubeCircleIntegrandDeriv
    calc
      ‖a t * tubeCircleSpatialDeriv q (tubeCircleShift y r t)
          (tubeCircleVelocity r t)‖ =
          ‖a t‖ * ‖tubeCircleSpatialDeriv q (tubeCircleShift y r t)
            (tubeCircleVelocity r t)‖ := norm_mul _ _
      _ ≤ ‖a t‖ *
          (‖tubeCircleSpatialDeriv q (tubeCircleShift y r t)‖ *
            ‖tubeCircleVelocity r t‖) := mul_le_mul_of_nonneg_left
        (ContinuousLinearMap.le_opNorm _ _) (norm_nonneg _)
      _ ≤ ‖a t‖ *
          ((SchwartzMap.seminorm Complex 0 0) (tubeCircleSpatialDeriv q) *
            ‖tubeCircleVelocity r t‖) := by
        gcongr
        exact SchwartzMap.norm_le_seminorm Complex (tubeCircleSpatialDeriv q) _
      _ = (SchwartzMap.seminorm Complex 0 0) (tubeCircleSpatialDeriv q) *
          (‖t‖ * ‖a t‖) := by
        unfold tubeCircleVelocity
        rw [norm_smul, norm_neg, norm_circleDirectionDeriv, mul_one]
        ring
  · simpa using
      (a.integrable_pow_mul_iteratedFDeriv volume 1 0).const_mul
        ((SchwartzMap.seminorm Complex 0 0) (tubeCircleSpatialDeriv q))
  · filter_upwards with t
    intro r hr
    simpa only [SchwartzMap.fourierInv_coe] using
      hasDerivAt_tubeCircleIntegrand q a y r t

/-- The literal angular derivative of a finite compact-frequency tensor tube
family. -/
noncomputable def finiteTensorTubeBandAngularDeriv
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
    (y : Euclidean 2) (theta : Real) : Complex :=
  ∑ i ∈ s, tubeCircleBandAngularDeriv (q i) (a i) y theta

/-- The finite tensor family has the literal termwise angular derivative;
there is no interchange of an infinite sum here. -/
theorem hasDerivAt_scratch_finiteTensorTubeBand_circle
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (y : Euclidean 2) (theta : Real) :
    HasDerivAt
      (fun r => scratch_finiteTensorTubeBand s q hqcompact a
        (circleDirection r) y)
      (finiteTensorTubeBandAngularDeriv s q a y theta) theta := by
  unfold scratch_finiteTensorTubeBand finiteTensorTubeBandAngularDeriv
  have h : HasDerivAt
      (∑ i ∈ s, fun r => scratch_smoothTubeBand (q i) (hqcompact i) (a i)
        (circleDirection r) y)
      (∑ i ∈ s, tubeCircleBandAngularDeriv (q i) (a i) y theta) theta :=
    HasDerivAt.sum (u := s) fun i hi =>
      hasDerivAt_scratch_smoothTubeBand_circle (q i) (hqcompact i) (a i) y theta
  convert h using 1
  ext r
  simp

/-- The literal frequency-side angular derivative of the restricted time
Fourier factor. -/
noncomputable def tubeTimePhaseAngularDeriv
    (a : SchwartzMap Real Complex)
    (xi : Euclidean 2) (theta : Real) : Complex :=
  fderiv Real (FourierTransform.fourier a : Real → Complex)
      (inner Real (circleDirection theta) xi)
      (inner Real (circleDirectionDeriv theta) xi)

theorem hasDerivAt_tubeTimePhase_circle
    (a : SchwartzMap Real Complex)
    (xi : Euclidean 2) (theta : Real) :
    HasDerivAt
      (fun r => (FourierTransform.fourier a : SchwartzMap Real Complex)
        (inner Real (circleDirection r) xi))
      (tubeTimePhaseAngularDeriv a xi theta) theta := by
  unfold tubeTimePhaseAngularDeriv
  have hphase := hasDerivAt_circlePhase xi theta
  have hfourier := (FourierTransform.fourier a : SchwartzMap Real Complex).hasFDerivAt
    (inner Real (circleDirection theta) xi)
  have hcomp := hfourier.comp theta hphase.hasFDerivAt
  have hfun :
      (fun r => (FourierTransform.fourier a : SchwartzMap Real Complex)
        (inner Real (circleDirection r) xi)) =
      ((FourierTransform.fourier a : Real → Complex) ∘
        fun r => inner Real (circleDirection r) xi) := by
    rfl
  rw [hfun]
  simpa only [ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.toSpanSingleton_apply, one_smul] using hcomp.hasDerivAt

/-- The corresponding finite tensor frequency multiplier derivative. -/
noncomputable def finiteTensorTubeMultiplierAngularDeriv
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
    (theta : Real) (xi : Euclidean 2) : Complex :=
  ∑ i ∈ s, q i xi * tubeTimePhaseAngularDeriv (a i) xi theta

theorem hasDerivAt_scratch_finiteTensorTubeMultiplier_apply_circle
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (theta : Real) (xi : Euclidean 2) :
    HasDerivAt
      (fun r => scratch_finiteTensorTubeMultiplier s q hqcompact a
        (circleDirection r) xi)
      (finiteTensorTubeMultiplierAngularDeriv s q a theta xi) theta := by
  classical
  have h : HasDerivAt
      (∑ i ∈ s, fun r => q i xi *
        (FourierTransform.fourier (a i) : SchwartzMap Real Complex)
          (inner Real (circleDirection r) xi))
      (∑ i ∈ s, q i xi * tubeTimePhaseAngularDeriv (a i) xi theta) theta :=
    HasDerivAt.sum (u := s) fun i hi =>
      (hasDerivAt_tubeTimePhase_circle (a i) xi theta).const_mul (q i xi)
  unfold finiteTensorTubeMultiplierAngularDeriv
  convert h using 1
  ext r
  rw [finset_sum_function_apply]
  exact scratch_finiteTensorTubeMultiplier_apply s q hqcompact a (circleDirection r) xi

private theorem continuous_finiteTensorTubeMultiplier_apply
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (theta : Real) :
    Continuous (fun xi => scratch_finiteTensorTubeMultiplier s q hqcompact a
      (circleDirection theta) xi) := by
  classical
  rw [show (fun xi => scratch_finiteTensorTubeMultiplier s q hqcompact a
      (circleDirection theta) xi) =
      (fun xi => ∑ i ∈ s, q i xi *
        (FourierTransform.fourier (a i) : SchwartzMap Real Complex)
          (inner Real (circleDirection theta) xi)) by
    funext xi
    exact scratch_finiteTensorTubeMultiplier_apply s q hqcompact a
      (circleDirection theta) xi]
  fun_prop

private theorem continuous_tubeTimePhaseAngularDeriv_xi
    (a : SchwartzMap Real Complex) (theta : Real) :
    Continuous (fun xi : Euclidean 2 => tubeTimePhaseAngularDeriv a xi theta) := by
  unfold tubeTimePhaseAngularDeriv
  have hderiv (x : Real) :
      fderiv Real (FourierTransform.fourier a : Real → Complex) x =
        (SchwartzMap.fderivCLM Real Real Complex
          (FourierTransform.fourier a : SchwartzMap Real Complex)) x := by
    symm
    exact SchwartzMap.fderivCLM_apply Real
      (FourierTransform.fourier a : SchwartzMap Real Complex) x
  simp_rw [hderiv]
  exact
    (((SchwartzMap.fderivCLM Real Real Complex
      (FourierTransform.fourier a : SchwartzMap Real Complex)).continuous.comp
        (by fun_prop)).clm_apply (by fun_prop))

private theorem continuous_finiteTensorTubeMultiplierAngularDeriv_apply
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
    (theta : Real) :
    Continuous (fun xi => finiteTensorTubeMultiplierAngularDeriv s q a theta xi) := by
  classical
  unfold finiteTensorTubeMultiplierAngularDeriv
  exact continuous_finsetSum _ fun i hi =>
    (q i).continuous.mul (continuous_tubeTimePhaseAngularDeriv_xi (a i) theta)

private theorem integrable_tubeTimeMultiplier_apply
    (q : SchwartzMap (Euclidean 2) Complex)
    (a : SchwartzMap Real Complex) (theta : Real) :
    Integrable (fun xi : Euclidean 2 => q xi *
      (FourierTransform.fourier a : SchwartzMap Real Complex)
        (inner Real (circleDirection theta) xi)) := by
  let C : Real := (SchwartzMap.seminorm Complex 0 0)
    (FourierTransform.fourier a : SchwartzMap Real Complex)
  have hq : Integrable (fun xi : Euclidean 2 => ‖q xi‖) := q.integrable.norm
  have hC : Integrable (fun xi : Euclidean 2 => C * ‖q xi‖) := hq.const_mul C
  refine hC.mono'
    ((q.continuous.mul
      ((FourierTransform.fourier a : SchwartzMap Real Complex).continuous.comp
        (by fun_prop))).aestronglyMeasurable) ?_
  filter_upwards with xi
  calc
    ‖q xi * (FourierTransform.fourier a : SchwartzMap Real Complex)
        (inner Real (circleDirection theta) xi)‖ =
        ‖q xi‖ * ‖(FourierTransform.fourier a : SchwartzMap Real Complex)
          (inner Real (circleDirection theta) xi)‖ := norm_mul _ _
    _ ≤ ‖q xi‖ * C := mul_le_mul_of_nonneg_left
      (SchwartzMap.norm_le_seminorm Complex
        (FourierTransform.fourier a : SchwartzMap Real Complex) _) (norm_nonneg _)
    _ = C * ‖q xi‖ := mul_comm _ _

private theorem integrable_finiteTensorTubeMultiplier_apply
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex) (theta : Real) :
    Integrable (fun xi => scratch_finiteTensorTubeMultiplier s q hqcompact a
      (circleDirection theta) xi) := by
  classical
  have hsum : Integrable (fun xi : Euclidean 2 => ∑ i ∈ s,
      q i xi * (FourierTransform.fourier (a i) : SchwartzMap Real Complex)
        (inner Real (circleDirection theta) xi)) := by
    exact integrable_finsetSum s fun i hi =>
      integrable_tubeTimeMultiplier_apply (q i) (a i) theta
  apply hsum.congr
  filter_upwards with xi
  exact (scratch_finiteTensorTubeMultiplier_apply s q hqcompact a
    (circleDirection theta) xi).symm

private theorem norm_tubeTimePhaseAngularDeriv_le
    (a : SchwartzMap Real Complex) (theta : Real) (xi : Euclidean 2) :
    ‖tubeTimePhaseAngularDeriv a xi theta‖ ≤
      (SchwartzMap.seminorm Complex 0 0)
        (SchwartzMap.fderivCLM Real Real Complex
          (FourierTransform.fourier a : SchwartzMap Real Complex)) * ‖xi‖ := by
  let D : SchwartzMap Real (Real →L[Real] Complex) :=
    SchwartzMap.fderivCLM Real Real Complex
      (FourierTransform.fourier a : SchwartzMap Real Complex)
  have hderiv (x : Real) :
      fderiv Real (FourierTransform.fourier a : Real → Complex) x = D x := by
    symm
    exact SchwartzMap.fderivCLM_apply Real
      (FourierTransform.fourier a : SchwartzMap Real Complex) x
  have hv : ‖inner Real (circleDirectionDeriv theta) xi‖ ≤ ‖xi‖ := by
    rw [Real.norm_eq_abs]
    calc
      |inner Real (circleDirectionDeriv theta) xi| ≤
          ‖circleDirectionDeriv theta‖ * ‖xi‖ :=
        abs_real_inner_le_norm _ _
      _ = ‖xi‖ := by rw [norm_circleDirectionDeriv, one_mul]
  unfold tubeTimePhaseAngularDeriv
  rw [hderiv]
  calc
    ‖D (inner Real (circleDirection theta) xi)
        (inner Real (circleDirectionDeriv theta) xi)‖ ≤
        ‖D (inner Real (circleDirection theta) xi)‖ *
          ‖inner Real (circleDirectionDeriv theta) xi‖ :=
      ContinuousLinearMap.le_opNorm _ _
    _ ≤ ‖D (inner Real (circleDirection theta) xi)‖ * ‖xi‖ :=
      mul_le_mul_of_nonneg_left hv (norm_nonneg _)
    _ ≤ (SchwartzMap.seminorm Complex 0 0) D * ‖xi‖ :=
      mul_le_mul_of_nonneg_right
        (SchwartzMap.norm_le_seminorm Complex D _) (norm_nonneg _)

private theorem integrable_tubeTimePhaseAngularDeriv_multiplier
    (q : SchwartzMap (Euclidean 2) Complex)
    (a : SchwartzMap Real Complex) (theta : Real) :
    Integrable (fun xi : Euclidean 2 => q xi *
      tubeTimePhaseAngularDeriv a xi theta) := by
  let C : Real := (SchwartzMap.seminorm Complex 0 0)
    (SchwartzMap.fderivCLM Real Real Complex
      (FourierTransform.fourier a : SchwartzMap Real Complex))
  have hq : Integrable (fun xi : Euclidean 2 => ‖xi‖ * ‖q xi‖) := by
    simpa using q.integrable_pow_mul_iteratedFDeriv volume 1 0
  have hC : Integrable (fun xi : Euclidean 2 => C * (‖xi‖ * ‖q xi‖)) :=
    hq.const_mul C
  refine hC.mono'
    ((q.continuous.mul (continuous_tubeTimePhaseAngularDeriv_xi a theta)).aestronglyMeasurable) ?_
  filter_upwards with xi
  calc
    ‖q xi * tubeTimePhaseAngularDeriv a xi theta‖ =
        ‖q xi‖ * ‖tubeTimePhaseAngularDeriv a xi theta‖ := norm_mul _ _
    _ ≤ ‖q xi‖ * (C * ‖xi‖) := mul_le_mul_of_nonneg_left
      (norm_tubeTimePhaseAngularDeriv_le a theta xi) (norm_nonneg _)
    _ = C * (‖xi‖ * ‖q xi‖) := by ring

private theorem integrable_finiteTensorTubeMultiplierAngularDeriv_apply
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) (theta : Real) :
    Integrable (fun xi => finiteTensorTubeMultiplierAngularDeriv s q a theta xi) := by
  classical
  unfold finiteTensorTubeMultiplierAngularDeriv
  exact integrable_finsetSum s fun i hi =>
    integrable_tubeTimePhaseAngularDeriv_multiplier (q i) (a i) theta

noncomputable def finiteTensorTubeMultiplierAngularDerivBound
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
    (xi : Euclidean 2) : Real :=
  ∑ i ∈ s,
    (SchwartzMap.seminorm Complex 0 0)
      (SchwartzMap.fderivCLM Real Real Complex
        (FourierTransform.fourier (a i) : SchwartzMap Real Complex)) *
      (‖xi‖ * ‖q i xi‖)

private theorem angularTransportPrivate_norm_finiteTensorTubeMultiplierAngularDeriv_le_bound
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
    (theta : Real) (xi : Euclidean 2) :
    ‖finiteTensorTubeMultiplierAngularDeriv s q a theta xi‖ ≤
      finiteTensorTubeMultiplierAngularDerivBound s q a xi := by
  classical
  unfold finiteTensorTubeMultiplierAngularDeriv
    finiteTensorTubeMultiplierAngularDerivBound
  calc
    ‖∑ i ∈ s, q i xi * tubeTimePhaseAngularDeriv (a i) xi theta‖ ≤
        ∑ i ∈ s, ‖q i xi * tubeTimePhaseAngularDeriv (a i) xi theta‖ :=
      norm_sum_le _ _
    _ ≤ ∑ i ∈ s,
        (SchwartzMap.seminorm Complex 0 0)
          (SchwartzMap.fderivCLM Real Real Complex
            (FourierTransform.fourier (a i) : SchwartzMap Real Complex)) *
          (‖xi‖ * ‖q i xi‖) := by
      apply Finset.sum_le_sum
      intro i hi
      calc
        ‖q i xi * tubeTimePhaseAngularDeriv (a i) xi theta‖ =
            ‖q i xi‖ * ‖tubeTimePhaseAngularDeriv (a i) xi theta‖ := norm_mul _ _
        _ ≤ ‖q i xi‖ *
            ((SchwartzMap.seminorm Complex 0 0)
              (SchwartzMap.fderivCLM Real Real Complex
                (FourierTransform.fourier (a i) : SchwartzMap Real Complex)) * ‖xi‖) :=
          mul_le_mul_of_nonneg_left
            (norm_tubeTimePhaseAngularDeriv_le (a i) theta xi) (norm_nonneg _)
        _ = (SchwartzMap.seminorm Complex 0 0)
              (SchwartzMap.fderivCLM Real Real Complex
                (FourierTransform.fourier (a i) : SchwartzMap Real Complex)) *
              (‖xi‖ * ‖q i xi‖) := by ring

private theorem angularTransportPrivate_integrable_finiteTensorTubeMultiplierAngularDerivBound
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) :
    Integrable (finiteTensorTubeMultiplierAngularDerivBound s q a) := by
  classical
  unfold finiteTensorTubeMultiplierAngularDerivBound
  exact integrable_finsetSum s fun i hi =>
    (by
      have hq : Integrable (fun xi : Euclidean 2 => ‖xi‖ * ‖q i xi‖) := by
        simpa using (q i).integrable_pow_mul_iteratedFDeriv volume 1 0
      exact hq.const_mul ((SchwartzMap.seminorm Complex 0 0)
        (SchwartzMap.fderivCLM Real Real Complex
          (FourierTransform.fourier (a i) : SchwartzMap Real Complex))))

private theorem norm_fourierChar_eq_one (u : Real) :
    ‖(Real.fourierChar u : Complex)‖ = 1 := by
  rw [Real.fourierChar_apply, Complex.norm_exp]
  norm_num

/-- Parameter differentiation commutes with the literal inverse spatial
Fourier integral for a finite compact-frequency tensor.  The proof uses the
Schwartz-derived integrable bound above, rather than treating Fourier
inversion as a formal operation. -/
theorem hasDerivAt_fourierInv_scratch_finiteTensorTubeMultiplier_circle
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (theta : Real) (y : Euclidean 2) :
    HasDerivAt
      (fun r => FourierTransform.fourierInv
        (scratch_finiteTensorTubeMultiplier s q hqcompact a
          (circleDirection r) : Euclidean 2 → Complex) y)
      (FourierTransform.fourierInv
        (finiteTensorTubeMultiplierAngularDeriv s q a theta :
          Euclidean 2 → Complex) y) theta := by
  let m : Real → Euclidean 2 → Complex := fun r xi =>
    scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection r) xi
  let dm : Real → Euclidean 2 → Complex := fun r xi =>
    finiteTensorTubeMultiplierAngularDeriv s q a r xi
  have hphase : Continuous (fun xi : Euclidean 2 =>
      (Real.fourierChar (inner Real xi y) : Complex)) := by
    fun_prop
  apply angularTransportPrivate_hasDerivAt_fourierInv_of_dominated
    (m := m) (dm := dm) (theta := theta) (hy := y)
    (bound := finiteTensorTubeMultiplierAngularDerivBound s q a)
  · filter_upwards with r
    have hmc : Continuous (fun xi : Euclidean 2 => m r xi) := by
      simpa only [m] using
        continuous_finiteTensorTubeMultiplier_apply s q hqcompact a r
    exact (hphase.smul hmc).aestronglyMeasurable
  · have hm : Integrable (m theta) := by
      simpa only [m] using
        integrable_finiteTensorTubeMultiplier_apply s q hqcompact a theta
    have hmc : Continuous (fun xi : Euclidean 2 => m theta xi) := by
      simpa only [m] using
        continuous_finiteTensorTubeMultiplier_apply s q hqcompact a theta
    refine hm.norm.mono' (hphase.smul hmc).aestronglyMeasurable ?_
    · filter_upwards with xi
      rw [norm_smul, norm_fourierChar_eq_one, one_mul]
  · have hdmc : Continuous (fun xi : Euclidean 2 => dm theta xi) := by
      simpa only [dm] using
        continuous_finiteTensorTubeMultiplierAngularDeriv_apply s q a theta
    exact (hphase.smul hdmc).aestronglyMeasurable
  · filter_upwards with xi
    intro r hr
    change ‖(Real.fourierChar (inner Real xi y) : Complex) •
      finiteTensorTubeMultiplierAngularDeriv s q a r xi‖ ≤
        finiteTensorTubeMultiplierAngularDerivBound s q a xi
    rw [norm_smul, norm_fourierChar_eq_one, one_mul]
    exact angularTransportPrivate_norm_finiteTensorTubeMultiplierAngularDeriv_le_bound s q a r xi
  · exact angularTransportPrivate_integrable_finiteTensorTubeMultiplierAngularDerivBound s q a
  · filter_upwards with xi
    intro r hr
    change HasDerivAt (fun r =>
      (Real.fourierChar (inner Real xi y) : Complex) •
        scratch_finiteTensorTubeMultiplier s q hqcompact a
          (circleDirection r) xi)
      ((Real.fourierChar (inner Real xi y) : Complex) •
        finiteTensorTubeMultiplierAngularDeriv s q a r xi) r
    exact HasDerivAt.const_smul
      (Real.fourierChar (inner Real xi y) : Complex)
      (hasDerivAt_scratch_finiteTensorTubeMultiplier_apply_circle
        s q hqcompact a r xi)
end
end Auto.Spherical.MSS
end
