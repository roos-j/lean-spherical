/-- A finite family with jointly continuous angular jets supplies the literal
phase-adapted IBP chain on each fixed parameter slice.  This deliberately
uses no smoothness in the parameter coordinate. -/
theorem hasNonstationaryPhaseIBPChain_parametric_of_jointSndSmooth
    {D : Real × Real → Real} {F : Real × Real → Complex} {rho a b : Real}
    {N : Nat}
    (hD : HasJointSndSmooth N D) (hF : HasJointSndSmooth N F)
    (hDne : ∀ p, D p ≠ 0)
    (hFleft : (fun u : Real => F (rho, u)) =ᶠ[nhds a] 0)
    (hFright : (fun u : Real => F (rho, u)) =ᶠ[nhds b] 0) :
    HasNonstationaryPhaseIBPChain a b (fun u : Real => D (rho, u))
      (fun k u => parametricNonstationaryIBPAmplitude D F k (rho, u)) N := by
  intro k hk
  have hDprev : HasJointSndSmooth (1 + k) D :=
    hD.of_le (by omega)
  have hFprev : HasJointSndSmooth (1 + k) F :=
    hF.of_le (by omega)
  have hAprev : HasJointSndSmooth 1
      (parametricNonstationaryIBPAmplitude D F k) :=
    hasJointSndSmooth_parametricNonstationaryIBPAmplitude
      (n := 1) (k := k) D F (by simpa [Nat.add_comm] using hDprev)
      (by simpa [Nat.add_comm] using hFprev) hDne
  have hDsmall : HasJointSndSmooth 1 D := hD.of_le (by omega)
  have hDinv : HasJointSndSmooth 1 (fun p => ((D p : Real) : Complex)⁻¹) :=
    (HasJointSndSmooth.ofReal hDsmall).inv
      (fun p => Complex.ofReal_ne_zero.mpr (hDne p))
  have hquot : HasJointSndSmooth 1 (fun p =>
      parametricNonstationaryIBPAmplitude D F k p *
        ((D p : Real) : Complex)⁻¹) := hAprev.mul hDinv
  rcases hquot with ⟨_, Q', hQ', hQderiv⟩
  have hQeq : parametricNonstationaryIBPAmplitude D F (k + 1) = Q' := by
    funext p
    change deriv (fun v : Real =>
      parametricNonstationaryIBPAmplitude D F k (p.1, v) *
        ((D (p.1, v) : Real) : Complex)⁻¹) p.2 = Q' p
    exact (hQderiv p.1 p.2).deriv
  constructor
  · intro u hu
    change HasDerivAt (fun v : Real =>
      parametricNonstationaryIBPAmplitude D F k (rho, v) *
        ((D (rho, v) : Real) : Complex)⁻¹)
      (parametricNonstationaryIBPAmplitude D F (k + 1) (rho, u)) u
    rw [hQeq]
    exact hQderiv rho u
  constructor
  · change Continuous (fun u : Real =>
      parametricNonstationaryIBPAmplitude D F (k + 1) (rho, u))
    rw [hQeq]
    exact hQ'.comp (continuous_const.prodMk continuous_id)
  constructor
  · have hzero := nonstationaryIBPAmplitude_eventuallyEq_zero
      (fun u : Real => D (rho, u)) (fun u : Real => F (rho, u)) hFleft k
    have hvalue := Filter.EventuallyEq.iteratedDeriv_eq 0 hzero
    have heq := parametricNonstationaryIBPAmplitude_eq_slice D F k rho a
    change parametricNonstationaryIBPAmplitude D F k (rho, a) = 0
    rw [heq]
    simpa [iteratedDeriv] using hvalue
  · have hzero := nonstationaryIBPAmplitude_eventuallyEq_zero
      (fun u : Real => D (rho, u)) (fun u : Real => F (rho, u)) hFright k
    have hvalue := Filter.EventuallyEq.iteratedDeriv_eq 0 hzero
    have heq := parametricNonstationaryIBPAmplitude_eq_slice D F k rho b
    change parametricNonstationaryIBPAmplitude D F k (rho, b) = 0
    rw [heq]
    simpa [iteratedDeriv] using hvalue

/-- Uniform final quotient-amplitude bounds only require finite jointly
continuous angular jets.  In particular, parameter-dependent shell
amplitudes are allowed: no artificial global `ContDiff` assertion in the
shell-width variable is used. -/
theorem exists_uniform_outerCircleFinalAmplitude_bound_of_jointSndSmoothFamily
    {rhoMax : Real} {F : Real × Real → Complex} {N : Nat}
    (hrhoMax : 0 ≤ rhoMax) (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (hF : HasJointSndSmooth N F) :
    ∃ M : Real, 0 < M ∧
      ∀ rho ∈ Ioc 0 rhoMax, ∀ u ∈ Icc (1 / 2 : Real) 2,
        ‖nonstationaryIBPAmplitude (outerCircleShellDerivativeExtension rho)
          (fun v => F (rho, v)) N u‖ ≤ M := by
  let D : Real × Real → Real := safeOuterCircleUniformDerivativeExtension rhoMax
  have hD : HasJointSndSmooth N D := by
    dsimp [D]
    exact hasJointSndSmooth_safeOuterCircleUniformDerivativeExtension rhoMax N
  have hDne : ∀ p, D p ≠ 0 := by
    intro p
    dsimp [D]
    exact safeOuterCircleUniformDerivativeExtension_ne_zero hrhoMax hrhoMax_small p
  have hA : HasJointSndSmooth 0
      (parametricNonstationaryIBPAmplitude D F N) :=
    hasJointSndSmooth_parametricNonstationaryIBPAmplitude
      (n := 0) (k := N) D F (by simpa using hD) (by simpa using hF) hDne
  have hAcont : Continuous (parametricNonstationaryIBPAmplitude D F N) := by
    simpa [HasJointSndSmooth] using hA
  rcases exists_uniform_norm_bound_of_jointContinuous
      (a := (1 / 2 : Real)) (b := 2) hrhoMax (by norm_num)
      (fun rho u => parametricNonstationaryIBPAmplitude D F N (rho, u))
      (by simpa using hAcont) with ⟨M, hM, hbound⟩
  refine ⟨M, hM, ?_⟩
  intro rho hrho u hu
  have hDslice : (fun v : Real => D (rho, v)) =
      outerCircleShellDerivativeExtension rho := by
    dsimp [D]
    exact (safeOuterCircleUniformDerivativeExtension_eq hrho.1.le hrho.2).trans
      (outerCircleUniformDerivativeExtension_eq hrho.1.ne')
  have heq : nonstationaryIBPAmplitude (outerCircleShellDerivativeExtension rho)
      (fun v => F (rho, v)) N u =
      parametricNonstationaryIBPAmplitude D F N (rho, u) := by
    calc
      nonstationaryIBPAmplitude (outerCircleShellDerivativeExtension rho)
          (fun v => F (rho, v)) N u =
          nonstationaryIBPAmplitude (fun v => D (rho, v))
            (fun v => F (rho, v)) N u := by rw [hDslice]
      _ = parametricNonstationaryIBPAmplitude D F N (rho, u) :=
        (parametricNonstationaryIBPAmplitude_eq_slice D F N rho u).symm
  rw [heq]
  exact hbound rho ⟨hrho.1.le, hrho.2⟩ u hu

/-- The arbitrary-order outer-circle IBP estimate extends verbatim to a
parameter-dependent amplitude family whose angular jets are jointly
continuous.  The endpoint hypothesis is deliberately slice-wise, which is
