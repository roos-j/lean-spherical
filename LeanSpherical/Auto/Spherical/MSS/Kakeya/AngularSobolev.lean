      (fun u : Real => D (rho, u)) (fun u : Real => F (rho, u)) hFleft k
    have hvalue := Filter.EventuallyEq.iteratedDeriv_eq 0 hzero
    have heq := parametricNonstationaryIBPAmplitude_eq_slice D F k rho a
    change parametricNonstationaryIBPAmplitude D F k (rho, a) = 0
    rw [heq]
    simpa [iteratedDeriv] using hvalue
  · have hzero := nonstationaryIBPAmplitude_eventuallyEq_zero
      (fun u : Real => D (rho, u)) (fun u : Real => F (rho, u)) hFright k
    have hvalue := Filter.EventuallyEq.iteratedDeriv_eq 0 hzero
    have heq := parametricNonstationaryIBPAmplitude_eq_slice D F k rho b
    change parametricNonstationaryIBPAmplitude D F k (rho, b) = 0
    rw [heq]
    simpa [iteratedDeriv] using hvalue

/-- Uniform final quotient-amplitude bounds only require finite jointly
continuous angular jets.  In particular, parameter-dependent shell
amplitudes are allowed: no artificial global `ContDiff` assertion in the
shell-width variable is used. -/
theorem exists_uniform_outerCircleFinalAmplitude_bound_of_jointSndSmoothFamily
    {rhoMax : Real} {F : Real × Real → Complex} {N : Nat}
    (hrhoMax : 0 ≤ rhoMax) (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (hF : HasJointSndSmooth N F) :
    ∃ M : Real, 0 < M ∧
      ∀ rho ∈ Ioc 0 rhoMax, ∀ u ∈ Icc (1 / 2 : Real) 2,
        ‖nonstationaryIBPAmplitude (outerCircleShellDerivativeExtension rho)
          (fun v => F (rho, v)) N u‖ ≤ M := by
