    (alpha : Euclidean 2 → Real) (rho theta : Real) (y : Euclidean 2) : Complex :=
  FourierTransform.fourierInv
    (fun xi => outerFiniteTensorPseudodifferentialMultiplier
      s q hqcompact a alpha rho theta xi) y

/-- The physical field obtained from the literal Fourier-side angular
derivative multiplier. -/
noncomputable def outerFiniteTensorPseudodifferentialShellFieldDeriv
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (alpha : Euclidean 2 → Real) (rho theta : Real) (y : Euclidean 2) : Complex :=
  FourierTransform.fourierInv
    (fun xi => outerFiniteTensorPseudodifferentialMultiplierDeriv
      s q hqcompact a alpha rho theta xi) y

/-- Differentiation under inverse spatial Fourier transform for one literal
outer pseudodifferential shell.  The supplied hypotheses are the exact
measurability, integrability, and uniform derivative-majorant obligations;
the multiplier derivative above discharges the only calculus premise. -/
theorem hasDerivAt_outerFiniteTensorPseudodifferentialShellField_of_dominated
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (alpha : Euclidean 2 → Real) {rho : Real} (hrho : rho ≠ 0)
    (theta : Real) (y : Euclidean 2)
    (hmeas : ∀ᶠ r in nhds theta, AEStronglyMeasurable (fun xi =>
      (Real.fourierChar (inner Real xi y) : Complex) •
        outerFiniteTensorPseudodifferentialMultiplier s q hqcompact a alpha rho r xi))
    (hint : Integrable (fun xi =>
      (Real.fourierChar (inner Real xi y) : Complex) •
        outerFiniteTensorPseudodifferentialMultiplier s q hqcompact a alpha rho theta xi))
    (hdmeas : AEStronglyMeasurable (fun xi =>
      (Real.fourierChar (inner Real xi y) : Complex) •
        outerFiniteTensorPseudodifferentialMultiplierDeriv s q hqcompact a alpha rho theta xi))
    (bound : Euclidean 2 → Real)
    (hbound : ∀ᵐ xi : Euclidean 2, ∀ r ∈ (Set.univ : Set Real),
      ‖(Real.fourierChar (inner Real xi y) : Complex) •
        outerFiniteTensorPseudodifferentialMultiplierDeriv
          s q hqcompact a alpha rho r xi‖ ≤ bound xi)
    (hboundint : Integrable bound) :
    HasDerivAt
      (fun r => outerFiniteTensorPseudodifferentialShellField
        s q hqcompact a alpha rho r y)
      (outerFiniteTensorPseudodifferentialShellFieldDeriv
        s q hqcompact a alpha rho theta y) theta := by
  apply hasDerivAt_fourierInv_of_dominated
    (m := fun r xi => outerFiniteTensorPseudodifferentialMultiplier
      s q hqcompact a alpha rho r xi)
    (dm := fun r xi => outerFiniteTensorPseudodifferentialMultiplierDeriv
      s q hqcompact a alpha rho r xi)
    theta y hmeas hint hdmeas bound hbound hboundint
  filter_upwards with xi
  intro r hr
  simpa only [smul_eq_mul] using
    (hasDerivAt_outerFiniteTensorPseudodifferentialMultiplier
      s q hqcompact a alpha hrho r xi).const_mul
        (Real.fourierChar (inner Real xi y) : Complex)

/-- The fixed outer bump is already zero on the whole left half-line needed
for a common physical angular endpoint.  This is stronger than its usual
vanishing merely at the rescaled shell endpoint. -/
private theorem fixedOuterCircleUnitShellAmplitude_eq_zero_of_nonpos
    {u : Real} (hu : u ≤ 0) :
    fixedOuterCircleUnitShellAmplitude u = 0 := by
  unfold fixedOuterCircleUnitShellAmplitude
  rw [fixedOuterCircleUnitShellBump.zero_of_le_dist]
  · rfl
  · change (3 / 8 : Real) ≤ dist u (5 / 4 : Real)
    rw [Real.dist_eq, abs_of_nonpos]
    · nlinarith
    · linarith

/-- A wide common left endpoint works for every frequency-dependent angular
centre bounded below by `-4`.  The only division fact needed is positivity
of the shell width. -/
private theorem outer_shell_quotient_nonpos_at_neg_five
    {center rho : Real} (hcenter : -4 < center) (hrho : 0 < rho) :
    ((-5 : Real) - center) / rho ≤ 0 := by
  apply le_of_lt
  apply div_neg_of_neg_of_pos
  · linarith
  · exact hrho

/-- The literal Fourier multiplier is zero at the common physical endpoint
`theta = -5`, even though its angular centre varies with frequency. -/
theorem outerFiniteTensorPseudodifferentialMultiplier_eq_zero_at_negFive
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (alpha : Euclidean 2 → Real) {rho : Real} (hrho : 0 < rho)
    (halpha : ∀ xi, -4 < alpha xi) (xi : Euclidean 2) :
    outerFiniteTensorPseudodifferentialMultiplier
      s q hqcompact a alpha rho (-5) xi = 0 := by
  unfold outerFiniteTensorPseudodifferentialMultiplier
  unfold outerCircleLocalizedAngular
  rw [fixedOuterCircleUnitShellAmplitude_eq_zero_of_nonpos]
  · simp
  · exact outer_shell_quotient_nonpos_at_neg_five (halpha xi) hrho

/-- The associated physical pseudodifferential shell field has the same
common endpoint zero.  This is the exact endpoint hypothesis for the
continuous angular product-Sobolev inequality. -/
theorem outerFiniteTensorPseudodifferentialShellField_eq_zero_at_negFive
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (alpha : Euclidean 2 → Real) {rho : Real} (hrho : 0 < rho)
    (halpha : ∀ xi, -4 < alpha xi) (y : Euclidean 2) :
    outerFiniteTensorPseudodifferentialShellField
      s q hqcompact a alpha rho (-5) y = 0 := by
  unfold outerFiniteTensorPseudodifferentialShellField
  have hzero : (fun xi => outerFiniteTensorPseudodifferentialMultiplier
      s q hqcompact a alpha rho (-5) xi) = 0 := by
    funext xi
    exact outerFiniteTensorPseudodifferentialMultiplier_eq_zero_at_negFive
      s q hqcompact a alpha hrho halpha xi
  rw [hzero]
  simp [FourierTransform.fourierInv, VectorFourier.fourierIntegral]

/-- `Complex.arg` gives the concrete measurable polar selector a sufficiently
strong lower bound for the common wide endpoint. -/
theorem neg_four_lt_measurablePolarAngle (xi : Euclidean 2) :
    -4 < measurablePolarAngle xi := by
  have hpi : Real.pi < 4 := Real.pi_lt_four
  have halpha : -Real.pi < measurablePolarAngle xi :=
    neg_pi_lt_measurablePolarAngle xi
  nlinarith

/-- The concrete measurable polar choice therefore satisfies the common
left-endpoint-zero conclusion without any continuity across its branch cut. -/
theorem outerFinTensorPseudodifferentialShellField_measPolarAngle_eq_zero_at_negFive
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    {rho : Real} (hrho : 0 < rho) (y : Euclidean 2) :
    outerFiniteTensorPseudodifferentialShellField
      s q hqcompact a measurablePolarAngle rho (-5) y = 0 := by
  apply outerFiniteTensorPseudodifferentialShellField_eq_zero_at_negFive
    s q hqcompact a measurablePolarAngle hrho
  exact neg_four_lt_measurablePolarAngle

/-- The physical endpoint-GN component for one smooth outer pseudodifferential
shell.  The input fields are the literal inverse Fourier transforms of the
frequency-dependent multiplier and its true angular derivative; the analytic
continuity, `L²`, and Plancherel/TT* energy obligations remain explicit. -/
theorem outerFiniteTensorPseudodifferentialShell_endpointZeroSobolev
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (alpha : Euclidean 2 → Real) {rho E0 E1 : Real}
    (hrho : 0 < rho) (halpha : ∀ xi, -4 < alpha xi)
    (hFcont : Continuous (Function.uncurry
      (outerFiniteTensorPseudodifferentialShellField s q hqcompact a alpha rho)))
    (hDcont : Continuous (Function.uncurry
      (outerFiniteTensorPseudodifferentialShellFieldDeriv s q hqcompact a alpha rho)))
    (hderiv : ∀ theta y, HasDerivAt
      (fun r => outerFiniteTensorPseudodifferentialShellField
        s q hqcompact a alpha rho r y)
      (outerFiniteTensorPseudodifferentialShellFieldDeriv
        s q hqcompact a alpha rho theta y) theta)
    (hFmem : MemLp (fun p : Real × Euclidean 2 =>
      outerFiniteTensorPseudodifferentialShellField
        s q hqcompact a alpha rho p.1 p.2) 2
      ((volume.restrict (Icc (-5 : Real) 12)).prod volume))
    (hDmem : MemLp (fun p : Real × Euclidean 2 =>
      outerFiniteTensorPseudodifferentialShellFieldDeriv
        s q hqcompact a alpha rho p.1 p.2) 2
      ((volume.restrict (Icc (-5 : Real) 12)).prod volume))
    (hE0 : (∫ p : Real × Euclidean 2,
      ‖outerFiniteTensorPseudodifferentialShellField
        s q hqcompact a alpha rho p.1 p.2‖ ^ 2 ∂
      ((volume.restrict (Icc (-5 : Real) 12)).prod volume)) ≤ E0)
    (hE1 : (∫ p : Real × Euclidean 2,
      ‖outerFiniteTensorPseudodifferentialShellFieldDeriv
        s q hqcompact a alpha rho p.1 p.2‖ ^ 2 ∂
      ((volume.restrict (Icc (-5 : Real) 12)).prod volume)) ≤ E1) :
    Measurable (fun y : Euclidean 2 =>
      ⨆ theta : Icc (-5 : Real) 12,
        ENNReal.ofReal (‖outerFiniteTensorPseudodifferentialShellField
          s q hqcompact a alpha rho theta.1 y‖ ^ 2)) ∧
      (∫⁻ y : Euclidean 2,
        ⨆ theta : Icc (-5 : Real) 12,
          ENNReal.ofReal (‖outerFiniteTensorPseudodifferentialShellField
            s q hqcompact a alpha rho theta.1 y‖ ^ 2)) ≤
        ENNReal.ofReal (2 * Real.sqrt (E0 * E1)) := by
  apply endpointZeroAngularSobolev_of_memLp_energy (by norm_num)
    hFcont hDcont hderiv
  · intro y
    exact outerFiniteTensorPseudodifferentialShellField_eq_zero_at_negFive
      s q hqcompact a alpha hrho halpha y
  · exact hFmem
  · exact hDmem
  · exact hE0
  · exact hE1

end

