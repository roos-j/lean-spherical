        (signedSmoothTubeAngularDerivative μ dK g theta y) theta)
    (hzero : ∀ y, signedSmoothTubeOperator μ K g a y = 0)
    (hproduct_integrable : Integrable (fun p : Real × Euclidean 2 =>
      ‖signedSmoothTubeOperator μ K g p.1 p.2‖ *
        ‖signedSmoothTubeAngularDerivative μ dK g p.1 p.2‖)
      ((volume.restrict (Icc a b)).prod volume))
