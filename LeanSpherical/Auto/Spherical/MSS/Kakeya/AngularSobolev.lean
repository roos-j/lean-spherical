/- Use the additive structure induced by the normed group in the real-scalar
product rule, matching the calculus APIs used below. -/
attribute [local instance 2000] NormedAddCommGroup.toAddCommGroup

/-- Endpoint-zero continuous angular Sobolev bound in the exact energy form
needed by one physical pseudodifferential shell.  The two energy estimates
are intentionally inputs: Plancherel and the central/outer TT* packages
discharge them for the concrete shell fields. -/
theorem endpointZeroAngularSobolev_of_memLp_energy
    {F D : Real → Euclidean 2 → Complex} {lo hi E0 E1 : Real}
    (hlohi : lo ≤ hi)
    (hFcont : Continuous (Function.uncurry F))
    (hDcont : Continuous (Function.uncurry D))
    (hderiv : ∀ theta y, HasDerivAt (fun r => F r y) (D theta y) theta)
    (hzero : ∀ y, F lo y = 0)
    (hFmem : MemLp (fun p : Real × Euclidean 2 => F p.1 p.2) 2
      ((volume.restrict (Icc lo hi)).prod volume))
    (hDmem : MemLp (fun p : Real × Euclidean 2 => D p.1 p.2) 2
      ((volume.restrict (Icc lo hi)).prod volume))
    (hE0 : (∫ p : Real × Euclidean 2, ‖F p.1 p.2‖ ^ 2 ∂
      ((volume.restrict (Icc lo hi)).prod volume)) ≤ E0)
    (hE1 : (∫ p : Real × Euclidean 2, ‖D p.1 p.2‖ ^ 2 ∂
      ((volume.restrict (Icc lo hi)).prod volume)) ≤ E1) :
    Measurable (fun y : Euclidean 2 =>
      ⨆ theta : Icc lo hi, ENNReal.ofReal (‖F theta.1 y‖ ^ 2)) ∧
      (∫⁻ y : Euclidean 2,
        ⨆ theta : Icc lo hi, ENNReal.ofReal (‖F theta.1 y‖ ^ 2)) ≤
        ENNReal.ofReal (2 * Real.sqrt (E0 * E1)) := by
  rcases angularShell_product_bound_of_memLp_energy hlohi F D
      hFmem hDmem hE0 hE1 with ⟨hprod, hcross⟩
  have hleft : Integrable (fun y : Euclidean 2 => ‖F lo y‖ ^ 2) volume := by
    have hzero' : (fun y : Euclidean 2 => ‖F lo y‖ ^ 2) = 0 := by
      funext y
      simp [hzero y]
    rw [hzero']
    exact integrable_zero _ _ volume
  rcases measurable_and_lintegral_iSup_ennreal_norm_sq_le_radiusSobolev_product_of_hasDerivAt
      hlohi hFcont hDcont hderiv hleft hprod with ⟨hmeas, hbound⟩
  refine ⟨hmeas, ?_⟩
  have hbase : (∫ y : Euclidean 2, ‖F lo y‖ ^ 2) = 0 := by
    apply integral_eq_zero_of_ae
    filter_upwards [] with y
    simp [hzero y]
  rw [hbase, zero_add] at hbound
  calc
    (∫⁻ y : Euclidean 2,
      ⨆ theta : Icc lo hi, ENNReal.ofReal (‖F theta.1 y‖ ^ 2)) ≤
        ENNReal.ofReal (2 * ∫ theta in lo..hi,
          ∫ y : Euclidean 2, ‖F theta y‖ * ‖D theta y‖) := hbound
    _ ≤ ENNReal.ofReal (2 * Real.sqrt (E0 * E1)) := by
      apply ENNReal.ofReal_le_ofReal
      exact mul_le_mul_of_nonneg_left hcross (by norm_num)

/-- Reciprocal shell scaling turns the endpoint-zero energy estimate into a
scale-free maximal bound.  In the outer-circle application `q = lambda*rho`.
The only multiplicative loss left is the finite number of shell pieces. -/
theorem endpointZeroAngularSobolev_of_reciprocal_energy
    {F D : Real → Euclidean 2 → Complex} {lo hi E E0 E1 q : Real}
    (hlohi : lo ≤ hi)
    (hFcont : Continuous (Function.uncurry F))
    (hDcont : Continuous (Function.uncurry D))
    (hderiv : ∀ theta y, HasDerivAt (fun r => F r y) (D theta y) theta)
    (hzero : ∀ y, F lo y = 0)
    (hFmem : MemLp (fun p : Real × Euclidean 2 => F p.1 p.2) 2
      ((volume.restrict (Icc lo hi)).prod volume))
    (hDmem : MemLp (fun p : Real × Euclidean 2 => D p.1 p.2) 2
      ((volume.restrict (Icc lo hi)).prod volume))
    (hE0 : (∫ p : Real × Euclidean 2, ‖F p.1 p.2‖ ^ 2 ∂
      ((volume.restrict (Icc lo hi)).prod volume)) ≤ E0)
    (hE1 : (∫ p : Real × Euclidean 2, ‖D p.1 p.2‖ ^ 2 ∂
      ((volume.restrict (Icc lo hi)).prod volume)) ≤ E1)
    (hE : 0 ≤ E) (hq : 0 < q)
    (hE0scale : E0 ≤ q⁻¹ * E) (hE1scale : E1 ≤ q * E) :
    Measurable (fun y : Euclidean 2 =>
      ⨆ theta : Icc lo hi, ENNReal.ofReal (‖F theta.1 y‖ ^ 2)) ∧
      (∫⁻ y : Euclidean 2,
        ⨆ theta : Icc lo hi, ENNReal.ofReal (‖F theta.1 y‖ ^ 2)) ≤
        ENNReal.ofReal (2 * E) := by
  rcases endpointZeroAngularSobolev_of_memLp_energy hlohi hFcont hDcont
      hderiv hzero hFmem hDmem hE0 hE1 with ⟨hmeas, hmax⟩
  refine ⟨hmeas, hmax.trans ?_⟩
  apply ENNReal.ofReal_le_ofReal
  apply mul_le_mul_of_nonneg_left
  · apply sqrt_mul_le_energy_of_reciprocal_scaled_bounds hE hq hE0scale hE1scale
    exact (integral_nonneg fun _ => sq_nonneg _).trans hE1
  · norm_num

/-- The literal outer-shell frequency multiplier.  The centre may vary with
frequency; this is a pseudodifferential multiplier in the spatial variable,
not a sharp physical-angle restriction. -/
noncomputable def outerFiniteTensorPseudodifferentialMultiplier
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (alpha : Euclidean 2 → Real) (rho theta : Real) (xi : Euclidean 2) : Complex :=
  outerCircleLocalizedAngular
    (fun r => scratch_finiteTensorTubeMultiplier s q hqcompact a
      (circleDirection r) xi)
    (alpha xi) rho theta

/-- Its exact angular derivative on the Fourier side.  The first term is
the characteristic multiplier derivative and the second is the rescaled
cutoff derivative; these are precisely the phase and cutoff E1 energies
already bounded by the outer TT* package. -/
noncomputable def outerFiniteTensorPseudodifferentialMultiplierDeriv
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (alpha : Euclidean 2 → Real) (rho theta : Real) (xi : Euclidean 2) : Complex :=
  fixedOuterCircleUnitShellAmplitude ((theta - alpha xi) / rho) *
      finiteTensorTubeMultiplierAngularDeriv s q a theta xi +
    ((fixedOuterCircleUnitShellRealDerivative ((theta - alpha xi) / rho) * rho⁻¹ : Real) : Complex)
        *
      scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection theta) xi

/-- The multiplier derivative is literal: no physical-space partition and no
frequency-independent centre are smuggled into the product rule. -/
theorem hasDerivAt_outerFiniteTensorPseudodifferentialMultiplier
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (alpha : Euclidean 2 → Real) {rho : Real} (hrho : rho ≠ 0)
    (theta : Real) (xi : Euclidean 2) :
    HasDerivAt
      (fun r => outerFiniteTensorPseudodifferentialMultiplier
        s q hqcompact a alpha rho r xi)
      (outerFiniteTensorPseudodifferentialMultiplierDeriv
        s q hqcompact a alpha rho theta xi) theta := by
  let u : Real := (theta - alpha xi) / rho
  have htheta : theta = alpha xi + rho * u := by
    dsimp only [u]
    field_simp [hrho]
    ring
  have hmult := hasDerivAt_scratch_finiteTensorTubeMultiplier_apply_circle
    s q hqcompact a theta xi
  have h := hasDerivAt_outerCircleLocalizedAngular
    (F := fun r => scratch_finiteTensorTubeMultiplier s q hqcompact a
      (circleDirection r) xi)
    hrho htheta hmult
  simpa only [outerFiniteTensorPseudodifferentialMultiplier,
    outerFiniteTensorPseudodifferentialMultiplierDeriv, u] using h

