        (parametricNonstationaryIBPAmplitude_eq_slice D F N rho u).symm
  rw [heq]
  exact hbound rho ⟨hrho.1.le, hrho.2⟩ u hu

/-- The literal fixed outer-circle shell has uniform rapid decay at every
