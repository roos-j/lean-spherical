    rw [pow_two]
    rw [norm_add_sq_eq_norm_sq_add_norm_sq_real horth]
    simp only [norm_smul, b.norm_eq_one, mul_one]
    calc
      ‖Real.cos s‖ * ‖Real.cos s‖ + ‖Real.sin s‖ * ‖Real.sin s‖ =
          |Real.cos s| ^ 2 + |Real.sin s| ^ 2 := by
            simp only [Real.norm_eq_abs, pow_two]
      _ = Real.cos s ^ 2 + Real.sin s ^ 2 := by rw [sq_abs, sq_abs]
      _ = 1 := Real.cos_sq_add_sin_sq s
  change ‖Real.cos s • b 0 + Real.sin s • b 1‖ = 1
  apply (sq_eq_sq₀ (norm_nonneg _) (by norm_num : (0 : Real) ≤ 1)).mp
  simpa using hsq

