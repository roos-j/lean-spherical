/-- A real lobe profile jointly depending on the shell carrier and normalized
coordinate produces this literal Fourier-character analysis amplitude. -/
noncomputable def outerCircleParametricRealProfileFourierCharAnalysisAmplitude
    (g : Real × Real -> Real) (rho lambda u t : Real) : Complex :=
  (g (rho, u) : Complex) *
    (Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex)

/-- The associated self-conjugate joint product amplitude. -/
noncomputable def outerCircleParametricRealProfileProductAmplitude
    (g : Real × Real -> Real) (p : Real × Real) : Complex :=
  ((g p) ^ 2 : Real)

theorem star_outerCircleParametricRealProfileProductAmplitude
    (g : Real × Real -> Real) (p : Real × Real) :
    starRingEnd Complex (outerCircleParametricRealProfileProductAmplitude g p) =
      outerCircleParametricRealProfileProductAmplitude g p := by
  simp [outerCircleParametricRealProfileProductAmplitude]

/-- The parametric analysis map is the local real lobe times the literal
finite-tensor time Fourier integral at the centred circle point. -/
theorem ttstarAnalysis_outerCircleParametricRealProfileFourierChar_eq_localizedFiniteTensor
    {ι : Type*} (s0 : Finset ι)
    (q : ι -> SchwartzMap (Euclidean 2) Complex)
    (a : ι -> SchwartzMap Real Complex)
