theorem exists_outerShellFiniteTensor_localized_E0
    {ι : Type*} (s0 : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ alpha lambda : Real, 0 < lambda →
        let H : Real → Complex := outerShellFiniteTensorTimeData s0 q a alpha lambda
        ∀ hHsq : Integrable (fun t : Real => ‖H t‖ ^ 2) volume,
