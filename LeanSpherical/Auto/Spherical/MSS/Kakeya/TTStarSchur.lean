open scoped FourierTransform EuclideanSpace

noncomputable section

/-- Local differentiation under inverse Fourier transform for a jointly
continuous parametric multiplier and its jointly continuous derivative with
one common compact frequency support.  Unlike the earlier global dominated
wrapper, the majorant is built locally from compactness of
`Icc (theta - 1) (theta + 1) × K`; hence smooth compact shell multipliers
need no separately postulated global derivative bound. -/
theorem hasDerivAt_fourierInv_of_jointContinuous_commonCompactSupport
    (m dm : Real → Euclidean 2 → Complex) (theta : Real) (y : Euclidean 2)
    (K : Set (Euclidean 2))
    (hm : Continuous (Function.uncurry m))
    (hdm : Continuous (Function.uncurry dm))
    (hK : IsCompact K)
    (hmSupport : ∀ t xi, xi ∉ K → m t xi = 0)
    (hdmSupport : ∀ t xi, xi ∉ K → dm t xi = 0)
    (hderiv : ∀ t xi, HasDerivAt (fun r => m r xi) (dm t xi) t) :
    HasDerivAt (fun r => FourierTransform.fourierInv (m r) y)
      (FourierTransform.fourierInv (dm theta) y) theta := by
  let J : Set Real := Icc (theta - 1) (theta + 1)
  have hJ : IsCompact J := isCompact_Icc
  obtain ⟨M, hM⟩ := (hJ.prod hK).exists_bound_of_continuousOn hdm.continuousOn
  let bound : Euclidean 2 → Real := K.indicator (fun _ => M)
  have hboundInt : Integrable bound := by
    apply (integrable_indicator_iff hK.measurableSet).2
    apply integrableOn_const
    exact ne_of_lt hK.measure_lt_top
    norm_num
  have hphase : Continuous (fun xi : Euclidean 2 =>
      (Real.fourierChar (inner Real xi y) : Complex)) := by fun_prop
  have hmcont (t : Real) : Continuous (m t) :=
    hm.comp (continuous_const.prodMk continuous_id)
  have hdmcont (t : Real) : Continuous (dm t) :=
    hdm.comp (continuous_const.prodMk continuous_id)
  have hmeas : ∀ᶠ t in nhds theta, AEStronglyMeasurable (fun xi =>
      (Real.fourierChar (inner Real xi y) : Complex) • m t xi) := by
    filter_upwards with t
    exact (hphase.smul (hmcont t)).aestronglyMeasurable
  have hint : Integrable (fun xi =>
      (Real.fourierChar (inner Real xi y) : Complex) • m theta xi) := by
    apply (hphase.smul (hmcont theta)).integrable_of_hasCompactSupport
    apply HasCompactSupport.intro hK
    intro xi hxi
    change (Real.fourierChar (inner Real xi y) : Complex) • m theta xi = 0
    rw [hmSupport theta xi hxi]
    simp
  have hdmeas : AEStronglyMeasurable (fun xi =>
      (Real.fourierChar (inner Real xi y) : Complex) • dm theta xi) :=
    (hphase.smul (hdmcont theta)).aestronglyMeasurable
  have hJnhds : J ∈ nhds theta := by
    exact Icc_mem_nhds (by linarith) (by linarith)
  have hcharNorm (u : Real) : ‖(Real.fourierChar u : Complex)‖ = 1 := by
