section

section Auto.Spherical.MSS

open Filter MeasureTheory FourierTransform Set
open Auto.Spherical.SurfaceMeasureDecay
open SmoothAngularFrequencyChartFamily
open scoped BigOperators FourierTransform EuclideanSpace

noncomputable section

/-- The precise annular Fubini interface needed by the physical endpoint.
`e0` and `e1` are the fixed-frequency angular energies after the signed
TT* calculation; `h` is the time energy of the finite tensor at frequency
`xi`.  The two representation equalities are deliberately literal: they are
the only remaining multiplier/Fubini bridge between a concrete shell field
and the fibre estimates. -/
structure AnnularShellFiberEnergyWitness
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (eps : Real) (K n i : Nat) (lo hi lambda rho B : Real)
    (S : ShiftedCappedShellSchwartzSlices C j s q hqcompact a eps K n i lo hi) where
  e0 : Euclidean 2 → Real
  e1 : Euclidean 2 → Real
  h : Euclidean 2 → Real
  e0_integrable : Integrable e0 (volume.restrict (scaledDyadicFrequencyAnnulus lambda))
  e1_integrable : Integrable e1 (volume.restrict (scaledDyadicFrequencyAnnulus lambda))
  h_integrable : Integrable h (volume.restrict (scaledDyadicFrequencyAnnulus lambda))
  h_nonneg : ∀ xi, 0 ≤ h xi
  multiplier_energy_eq :
    (∫ p : Real × Euclidean 2, ‖S.multiplier p.1 p.2‖ ^ (2 : Nat) ∂
      ((volume.restrict (Icc lo hi)).prod volume)) =
      ∫ xi : Euclidean 2, e0 xi ∂(volume.restrict (scaledDyadicFrequencyAnnulus lambda))
  multiplierDeriv_energy_eq :
    (∫ p : Real × Euclidean 2, ‖S.multiplierDeriv p.1 p.2‖ ^ (2 : Nat) ∂
      ((volume.restrict (Icc lo hi)).prod volume)) =
      ∫ xi : Euclidean 2, e1 xi ∂(volume.restrict (scaledDyadicFrequencyAnnulus lambda))
  e0_pointwise : ∀ᵐ xi ∂(volume.restrict (scaledDyadicFrequencyAnnulus lambda)),
    e0 xi ≤ (B / (‖xi‖ * rho)) * h xi
  e1_pointwise : ∀ᵐ xi ∂(volume.restrict (scaledDyadicFrequencyAnnulus lambda)),
    e1 xi ≤ (B * (‖xi‖ * rho)) * h xi

/-- The signed TT* fibre estimates compress uniformly on a scaled annulus.
This is the frequency-side input in exactly the `qscale = lambda * rho`
form consumed by the endpoint-zero Sobolev closure. -/
theorem shiftedCappedShell_frequency_bounds_of_annular_fiber_witness
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (eps : Real) (K n i : Nat) (lo hi lambda rho B : Real)
    (S : ShiftedCappedShellSchwartzSlices C j s q hqcompact a eps K n i lo hi)
    (W : AnnularShellFiberEnergyWitness C j s q hqcompact a eps K n i lo hi lambda rho B S)
    (hlambda : 0 < lambda) (hrho : 0 < rho) (hB : 0 ≤ B) :
    ((∫ p : Real × Euclidean 2, ‖S.multiplier p.1 p.2‖ ^ (2 : Nat) ∂
      ((volume.restrict (Icc lo hi)).prod volume)) ≤
        (lambda * rho)⁻¹ *
          (2 * B * ∫ xi : Euclidean 2, W.h xi ∂
            (volume.restrict (scaledDyadicFrequencyAnnulus lambda)))) ∧
    ((∫ p : Real × Euclidean 2, ‖S.multiplierDeriv p.1 p.2‖ ^ (2 : Nat) ∂
      ((volume.restrict (Icc lo hi)).prod volume)) ≤
        (lambda * rho) *
          (2 * B * ∫ xi : Euclidean 2, W.h xi ∂
            (volume.restrict (scaledDyadicFrequencyAnnulus lambda)))) := by
  have hqscale : 0 < lambda * rho := mul_pos hlambda hrho
  have h0 := integral_le_common_reciprocal_scale_of_annular
    hlambda hrho hB W.e0 W.h W.e0_integrable W.h_integrable
    W.e0_pointwise (Filter.Eventually.of_forall W.h_nonneg)
  have h1 := integral_le_common_direct_scale_of_annular
    hlambda hrho hB W.e1 W.h W.e1_integrable W.h_integrable
    W.e1_pointwise (Filter.Eventually.of_forall W.h_nonneg)
  constructor
  · rw [W.multiplier_energy_eq]
    calc
      (∫ xi : Euclidean 2, W.e0 xi ∂(volume.restrict (scaledDyadicFrequencyAnnulus lambda))) ≤
          ((2 * B) / (lambda * rho)) *
            ∫ xi : Euclidean 2, W.h xi ∂
              (volume.restrict (scaledDyadicFrequencyAnnulus lambda)) := h0
      _ = (lambda * rho)⁻¹ *
          (2 * B * ∫ xi : Euclidean 2, W.h xi ∂
            (volume.restrict (scaledDyadicFrequencyAnnulus lambda))) := by
          field_simp [ne_of_gt hqscale]
  · rw [W.multiplierDeriv_energy_eq]
    calc
      (∫ xi : Euclidean 2, W.e1 xi ∂(volume.restrict (scaledDyadicFrequencyAnnulus lambda))) ≤
          ((2 * B) * (lambda * rho)) *
            ∫ xi : Euclidean 2, W.h xi ∂
              (volume.restrict (scaledDyadicFrequencyAnnulus lambda)) := h1
      _ = (lambda * rho) *
          (2 * B * ∫ xi : Euclidean 2, W.h xi ∂
            (volume.restrict (scaledDyadicFrequencyAnnulus lambda))) := by ring

/-- One literal chart/shift/capped-shell field obeys the endpoint-zero
maximal estimate as soon as its signed fixed-frequency TT* energies satisfy
the annular witness interface.  Thus the analytic work left below this
theorem is only to construct the slice multipliers and prove the two stated
Fubini identities; the shell and annular scale bookkeeping is closed here. -/
theorem shiftedChartedCappedTelescopingField_endpointZeroSobolev_of_annular_fiber_witness
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    {eps : Real} (heps : 0 < eps) (K n i : Nat)
    (hi : i ∈ Finset.range (K + 2)) (hn : n < 7) (hj : j ∈ charts)
    (hscale : (2 : Real) ^ K * eps ≤ Real.pi / 2)
    {hiAngle lambda rho B : Real}
    (hlohi : shiftedCappedShellGlobalCommonLeft ≤ hiAngle)
    (S : ShiftedCappedShellSchwartzSlices C j s q hqcompact a eps K n i
      shiftedCappedShellGlobalCommonLeft hiAngle)
    (W : AnnularShellFiberEnergyWitness C j s q hqcompact a eps K n i
      shiftedCappedShellGlobalCommonLeft hiAngle lambda rho B S)
    (hFcont : Continuous (Function.uncurry
      (shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i)))
    (hDcont : Continuous (Function.uncurry
      (shiftedChartedCappedTelescopingFieldDeriv C j s q hqcompact a eps K n i)))
    (hderiv : ∀ theta y, HasDerivAt
      (fun r => shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i r y)
      (shiftedChartedCappedTelescopingFieldDeriv C j s q hqcompact a eps K n i theta y) theta)
    (hFmem : MemLp (fun p : Real × Euclidean 2 =>
      shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i p.1 p.2) 2
      ((volume.restrict (Icc shiftedCappedShellGlobalCommonLeft hiAngle)).prod volume))
    (hDmem : MemLp (fun p : Real × Euclidean 2 =>
      shiftedChartedCappedTelescopingFieldDeriv C j s q hqcompact a eps K n i p.1 p.2) 2
      ((volume.restrict (Icc shiftedCappedShellGlobalCommonLeft hiAngle)).prod volume))
    (hlambda : 0 < lambda) (hrho : 0 < rho) (hB : 0 ≤ B) :
    Measurable (fun y : Euclidean 2 =>
      ⨆ theta : Icc shiftedCappedShellGlobalCommonLeft hiAngle, ENNReal.ofReal
        (‖shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i theta.1 y‖ ^ 2)) ∧
      (∫⁻ y : Euclidean 2,
        ⨆ theta : Icc shiftedCappedShellGlobalCommonLeft hiAngle, ENNReal.ofReal
          (‖shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i theta.1 y‖ ^ 2)) ≤
        ENNReal.ofReal (4 * B * ∫ xi : Euclidean 2, W.h xi ∂
          (volume.restrict (scaledDyadicFrequencyAnnulus lambda))) := by
  let Q : Real := ∫ xi : Euclidean 2, W.h xi ∂
    (volume.restrict (scaledDyadicFrequencyAnnulus lambda))
  let E : Real := 2 * B * Q
  have hqscale : 0 < lambda * rho := mul_pos hlambda hrho
  have hQ : 0 ≤ Q := by
    exact integral_nonneg (fun xi => W.h_nonneg xi)
  have hE : 0 ≤ E := by
    dsimp [E]
    exact mul_nonneg (mul_nonneg (by norm_num) hB) hQ
  have hfrequency := shiftedCappedShell_frequency_bounds_of_annular_fiber_witness
    C j s q hqcompact a eps K n i
    shiftedCappedShellGlobalCommonLeft hiAngle lambda rho B S W hlambda hrho hB
  have hfrequency0 :
      (∫ p : Real × Euclidean 2, ‖S.multiplier p.1 p.2‖ ^ (2 : Nat) ∂
        ((volume.restrict (Icc shiftedCappedShellGlobalCommonLeft hiAngle)).prod volume)) ≤
        (lambda * rho)⁻¹ * E := by
    simpa [E, Q] using hfrequency.1
  have hfrequency1 :
      (∫ p : Real × Euclidean 2, ‖S.multiplierDeriv p.1 p.2‖ ^ (2 : Nat) ∂
        ((volume.restrict (Icc shiftedCappedShellGlobalCommonLeft hiAngle)).prod volume)) ≤
        (lambda * rho) * E := by
    simpa [E, Q] using hfrequency.2
  have hendpoint :=
    shiftedChartedCappedTelescopingField_endpointZeroSobolev_of_frequency_bounds
      C j s q hqcompact a heps K n i hi hn hj hscale
      (hiAngle := hiAngle) (E := E) (E0 := (lambda * rho)⁻¹ * E)
      (E1 := (lambda * rho) * E) (qscale := lambda * rho) hlohi
      S hFcont hDcont hderiv hFmem hDmem hfrequency0 hfrequency1
      hE hqscale le_rfl le_rfl
  have hfour : (2 : Real) * E = 4 * B * Q := by
    dsimp [E]
    ring
  simpa [Q, hfour] using hendpoint

end

end Auto.Spherical.MSS
end
