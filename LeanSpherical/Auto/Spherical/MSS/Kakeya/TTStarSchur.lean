open scoped BigOperators

noncomputable section

/-- The normalized time `TT*` kernel associated to an arbitrary fixed-shell
product-amplitude family.  The amplitude may depend smoothly on the shell
width; this is needed for the phase-derivative term. -/
noncomputable def outerCircleProfileProductTimeKernel
    (A : Real × Real → Complex) (rho lambda t s : Real) : Complex :=
  (rho : Complex) * ∫ u in (1 / 2 : Real)..2,
    A (rho, u) * Complex.exp
      (((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I))

/-- A real-valued profile gives the usual `chi * conj chi` product amplitude.
This specialized form is convenient for the two one-sided lobes of the
telescoping partition. -/
noncomputable def outerCircleRealProfileProductAmplitude
    (f : Real → Real) (p : Real × Real) : Complex :=
  ((f p.2) ^ 2 : Real)

theorem star_outerCircleRealProfileProductAmplitude
    (f : Real → Real) (p : Real × Real) :
    starRingEnd Complex (outerCircleRealProfileProductAmplitude f p) =
      outerCircleRealProfileProductAmplitude f p := by
  simp [outerCircleRealProfileProductAmplitude]

theorem hasJointSndSmooth_outerCircleRealProfileProductAmplitude
    (f : Real → Real) (hf : ContDiff Real (⊤ : ℕ∞) f) (n : Nat) :
    HasJointSndSmooth n (outerCircleRealProfileProductAmplitude f) := by
  apply hasJointSndSmooth_of_contDiff
  unfold outerCircleRealProfileProductAmplitude
  exact Complex.ofRealCLM.contDiff.comp ((hf.comp contDiff_snd).pow 2)

theorem outerCircleRealProfileProductAmplitude_eventuallyEq_zero_left
    {f : Real → Real} (hleft : f =ᶠ[nhds (1 / 2 : Real)] 0) :
    (fun u : Real => outerCircleRealProfileProductAmplitude f (0, u)) =ᶠ[
      nhds (1 / 2 : Real)] 0 := by
  filter_upwards [hleft] with u hu
  simp [outerCircleRealProfileProductAmplitude, hu]

theorem outerCircleRealProfileProductAmplitude_eventuallyEq_zero_right
    {f : Real → Real} (hright : f =ᶠ[nhds 2] 0) :
    (fun u : Real => outerCircleRealProfileProductAmplitude f (0, u)) =ᶠ[nhds 2] 0 := by
  filter_upwards [hright] with u hu
  simp [outerCircleRealProfileProductAmplitude, hu]

theorem outerCircleRealProfileProductAmplitude_eventuallyEq_zero_left_slice
    {f : Real → Real} {rho : Real} (hleft : f =ᶠ[nhds (1 / 2 : Real)] 0) :
    (fun u : Real => outerCircleRealProfileProductAmplitude f (rho, u)) =ᶠ[
      nhds (1 / 2 : Real)] 0 := by
  filter_upwards [hleft] with u hu
  simp [outerCircleRealProfileProductAmplitude, hu]

theorem outerCircleRealProfileProductAmplitude_eventuallyEq_zero_right_slice
    {f : Real → Real} {rho : Real} (hright : f =ᶠ[nhds 2] 0) :
    (fun u : Real => outerCircleRealProfileProductAmplitude f (rho, u)) =ᶠ[nhds 2] 0 := by
  filter_upwards [hright] with u hu
  simp [outerCircleRealProfileProductAmplitude, hu]

/-- Compactness gives the scale-uniform trivial central estimate for any
jointly continuous product-amplitude family. -/
theorem exists_outerCircleProfileProductTimeKernel_le_central
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (A : Real × Real → Complex) (hA : HasJointSndSmooth 0 A) :
    ∃ C : Real, 0 < C ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda t s : Real,
        ‖outerCircleProfileProductTimeKernel A rho lambda t s‖ ≤ C * rho := by
  have hcont : Continuous A := by
    simpa [HasJointSndSmooth] using hA
  rcases exists_uniform_norm_bound_of_jointContinuous
      (a := (1 / 2 : Real)) (b := 2) hrhoMax (by norm_num)
      (fun rho u => A (rho, u)) hcont with ⟨M, hM, hbound⟩
  refine ⟨(2 - (1 / 2 : Real)) * M, mul_pos (by norm_num) hM, ?_⟩
  intro rho hrho lambda t s
  have hintegral : ‖∫ u in (1 / 2 : Real)..2,
      A (rho, u) * Complex.exp
        (((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I))‖ ≤
      M * |2 - (1 / 2 : Real)| := by
    apply intervalIntegral.norm_integral_le_of_norm_le_const
    intro u hu
    rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one]
    have hu' : u ∈ Icc (1 / 2 : Real) 2 := by
      rw [uIoc_of_le (by norm_num)] at hu
      exact ⟨hu.1.le, hu.2⟩
    exact hbound rho ⟨hrho.1.le, hrho.2⟩ u hu'
  unfold outerCircleProfileProductTimeKernel
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hrho.1.le]
  calc
    rho * ‖∫ u in (1 / 2 : Real)..2,
        A (rho, u) * Complex.exp
          (((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I))‖ ≤
        rho * (M * |2 - (1 / 2 : Real)|) :=
      mul_le_mul_of_nonneg_left hintegral hrho.1.le
    _ = ((2 - (1 / 2 : Real)) * M) * rho := by norm_num; ring

/-- Order-two nonstationary integration by parts for an arbitrary jointly
smooth product-amplitude family. -/
theorem exists_outerCircleProfileProductTimeKernel_outer_order_two
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (A : Real × Real → Complex) (hA : HasJointSndSmooth 2 A)
    (hleft : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds 2] 0) :
    ∃ M : Real, 0 < M ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda t s : Real,
        (t - s) * lambda * rho ^ 2 ≠ 0 →
        ‖outerCircleProfileProductTimeKernel A rho lambda t s‖ ≤
          rho * (1 / |(t - s) * lambda * rho ^ 2|) ^ 2 *
            ((2 - (1 / 2 : Real)) * M) := by
  rcases exists_uniform_literalOuterCircleUnitShell_bound_of_jointSndSmoothFamily
      (N := 2) hrhoMax hrhoMax_small hA hleft hright with ⟨M, hM, hbound⟩
  refine ⟨M, hM, ?_⟩
  intro rho hrho lambda t s hnonzero
  exact hbound rho hrho (t - s) lambda hnonzero

theorem exists_outerCircleProfileProductTimeKernel_outer_quadratic
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (A : Real × Real → Complex) (hA : HasJointSndSmooth 2 A)
    (hleft : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds 2] 0) :
    ∃ C : Real, 0 < C ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, 0 < lambda →
        ∀ t s : Real, lambda * rho ^ 2 * |t - s| ≠ 0 →
        ‖outerCircleProfileProductTimeKernel A rho lambda t s‖ ≤
          C * rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ := by
  rcases exists_outerCircleProfileProductTimeKernel_outer_order_two
      hrhoMax hrhoMax_small A hA hleft hright with ⟨M, hM, hMbound⟩
  refine ⟨(2 - (1 / 2 : Real)) * M, mul_pos (by norm_num) hM, ?_⟩
  intro rho hrho lambda hlambda t s hscale
  have hts : t - s ≠ 0 := by
    intro hts
    apply hscale
    simp [hts]
  have hnonzero : (t - s) * lambda * rho ^ 2 ≠ 0 :=
    mul_ne_zero (mul_ne_zero hts hlambda.ne')
      (pow_ne_zero 2 (ne_of_gt hrho.1))
  have hbase := hMbound rho hrho lambda t s hnonzero
  have habs : |(t - s) * lambda * rho ^ 2| =
      lambda * rho ^ 2 * |t - s| := by
    rw [abs_mul, abs_mul, abs_of_pos hlambda,
      abs_of_nonneg (sq_nonneg rho)]
    ring
  rw [habs] at hbase
  have hpow : (1 / (lambda * rho ^ 2 * |t - s|)) ^ 2 =
      ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ := by
    rw [one_div, inv_pow]
  rw [hpow] at hbase
  calc
    ‖outerCircleProfileProductTimeKernel A rho lambda t s‖ ≤
        rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ *
          ((2 - (1 / 2 : Real)) * M) := hbase
    _ = ((2 - (1 / 2 : Real)) * M) * rho *
          ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ := by ring

theorem continuous_outerCircleProfileProductTimeKernel_right
    (A : Real × Real → Complex) (hA : HasJointSndSmooth 0 A)
    (rho lambda t : Real) :
    Continuous (fun s => outerCircleProfileProductTimeKernel A rho lambda t s) := by
  let f : Real → Real → Complex := fun s u =>
    A (rho, u) * Complex.exp
      (((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I))
  have hAcont : Continuous A := by
    simpa [HasJointSndSmooth] using hA
  have hamp : Continuous (fun u : Real => A (rho, u)) :=
    hAcont.comp (continuous_const.prodMk continuous_id)
  have hf : Continuous (Function.uncurry f) := by
    dsimp [f]
    apply (hamp.comp continuous_snd).mul
    fun_prop
  have hparam : Continuous (fun s : Real =>
      ∫ u in Icc (1 / 2 : Real) 2, f s u) :=
    continuous_parametric_integral_of_continuous (μ := volume) hf isCompact_Icc
  have heq : (fun s : Real => ∫ u in (1 / 2 : Real)..2, f s u) =
      fun s : Real => ∫ u in Icc (1 / 2 : Real) 2, f s u := by
    funext s
    rw [intervalIntegral.integral_of_le (by norm_num),
      ← integral_Icc_eq_integral_Ioc]
  unfold outerCircleProfileProductTimeKernel
  change Continuous (fun s : Real => (rho : Complex) *
    ∫ u in (1 / 2 : Real)..2, f s u)
  apply continuous_const.mul
  rw [heq]
  exact hparam

theorem continuous_outerCircleProfileProductTimeKernel_left
    (A : Real × Real → Complex) (hA : HasJointSndSmooth 0 A)
    (rho lambda s : Real) :
    Continuous (fun t => outerCircleProfileProductTimeKernel A rho lambda t s) := by
  let f : Real → Real → Complex := fun t u =>
    A (rho, u) * Complex.exp
      (((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I))
  have hAcont : Continuous A := by
    simpa [HasJointSndSmooth] using hA
  have hamp : Continuous (fun u : Real => A (rho, u)) :=
    hAcont.comp (continuous_const.prodMk continuous_id)
  have hf : Continuous (Function.uncurry f) := by
    dsimp [f]
    apply (hamp.comp continuous_snd).mul
    fun_prop
  have hparam : Continuous (fun t : Real =>
      ∫ u in Icc (1 / 2 : Real) 2, f t u) :=
    continuous_parametric_integral_of_continuous (μ := volume) hf isCompact_Icc
  have heq : (fun t : Real => ∫ u in (1 / 2 : Real)..2, f t u) =
      fun t : Real => ∫ u in Icc (1 / 2 : Real) 2, f t u := by
    funext t
    rw [intervalIntegral.integral_of_le (by norm_num),
      ← integral_Icc_eq_integral_Ioc]
  unfold outerCircleProfileProductTimeKernel
  change Continuous (fun t : Real => (rho : Complex) *
    ∫ u in (1 / 2 : Real)..2, f t u)
  apply continuous_const.mul
  rw [heq]
  exact hparam

/-- A self-conjugate product amplitude gives the Hermitian symmetry of the
time `TT*` kernel. -/
theorem outerCircleProfileProductTimeKernel_swap_eq_star
    (A : Real × Real → Complex) (hstar : ∀ p, starRingEnd Complex (A p) = A p)
    (rho lambda t s : Real) :
    outerCircleProfileProductTimeKernel A rho lambda s t =
      starRingEnd Complex (outerCircleProfileProductTimeKernel A rho lambda t s) := by
  unfold outerCircleProfileProductTimeKernel
  rw [map_mul, Complex.conj_ofReal, ← intervalIntegral.intervalIntegral_conj]
  congr 1
  apply intervalIntegral.integral_congr_ae
  filter_upwards with u
  intro hu
  have hphase :
      (((s - t) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I =
        starRingEnd Complex
          ((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I) := by
    rw [map_mul, Complex.conj_ofReal, Complex.conj_I]
    push_cast
    ring
  rw [hphase, Complex.exp_conj]
  let z : Complex :=
    (((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I
  change A (rho, u) * star (Complex.exp z) =
    star (A (rho, u) * Complex.exp z)
  rw [star_mul, ← starRingEnd_apply (A (rho, u)), hstar (rho, u)]
  ring

theorem norm_outerCircleProfileProductTimeKernel_symm
    (A : Real × Real → Complex) (hstar : ∀ p, starRingEnd Complex (A p) = A p)
    (rho lambda t s : Real) :
    ‖outerCircleProfileProductTimeKernel A rho lambda t s‖ =
      ‖outerCircleProfileProductTimeKernel A rho lambda s t‖ := by
  rw [outerCircleProfileProductTimeKernel_swap_eq_star A hstar]
  exact Complex.norm_conj _

/-- Global row and column Schur bounds for a fixed smooth product-amplitude
family.  This is the reusable E0 input for the lobe, cutoff-derivative, and
phase-derivative energies. -/
theorem exists_outerCircleProfileProductTimeKernel_global_row_column_schur
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (A : Real × Real → Complex) (hA0 : HasJointSndSmooth 0 A)
    (hA2 : HasJointSndSmooth 2 A)
    (hleft : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds 2] 0)
    (hstar : ∀ p, starRingEnd Complex (A p) = A p) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, 0 < lambda →
        (∀ t : Real,
          Integrable (fun s : Real =>
            ‖outerCircleProfileProductTimeKernel A rho lambda t s‖) volume ∧
          (∫ s : Real, ‖outerCircleProfileProductTimeKernel A rho lambda t s‖) ≤
            (2 * B) * rho * (Real.pi / (lambda * rho ^ 2))) ∧
        (∀ s : Real,
          Integrable (fun t : Real =>
            ‖outerCircleProfileProductTimeKernel A rho lambda t s‖) volume ∧
          (∫ t : Real, ‖outerCircleProfileProductTimeKernel A rho lambda t s‖) ≤
            (2 * B) * rho * (Real.pi / (lambda * rho ^ 2))) := by
  rcases exists_outerCircleProfileProductTimeKernel_le_central
      hrhoMax A hA0 with ⟨C, hC, hcentral⟩
  rcases exists_outerCircleProfileProductTimeKernel_outer_quadratic
      hrhoMax hrhoMax_small A hA2 hleft hright with ⟨D, hD, houter⟩
  let B : Real := max C D
  have hBcentral : C ≤ B := le_max_left _ _
  have hBouter : D ≤ B := le_max_right _ _
  have hB : 0 < B := lt_of_lt_of_le hC hBcentral
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda
  have hrho_pos : 0 < rho := hrho.1
  have hLambda : 0 < lambda * rho ^ 2 :=
    mul_pos hlambda (sq_pos_of_pos hrho_pos)
  have hBrho : 0 ≤ B * rho := mul_nonneg hB.le hrho_pos.le
  have hTwoBrho : 0 ≤ (2 * B) * rho := by
    exact mul_nonneg (mul_nonneg (by norm_num) hB.le) hrho_pos.le
  have hpoint : ∀ t s : Real,
      ‖outerCircleProfileProductTimeKernel A rho lambda t s‖ ≤
        (2 * B) * rho * quadraticTimeEnvelope (lambda * rho ^ 2) t s := by
    intro t s
    apply norm_le_quadraticTimeEnvelope_of_central_outer hBrho hLambda.le
      (outerCircleProfileProductTimeKernel A rho lambda)
    · calc
        ‖outerCircleProfileProductTimeKernel A rho lambda t s‖ ≤ C * rho :=
          hcentral rho hrho lambda t s
        _ ≤ B * rho := mul_le_mul_of_nonneg_right hBcentral hrho_pos.le
    · intro hscale
      calc
        ‖outerCircleProfileProductTimeKernel A rho lambda t s‖ ≤
            D * rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ :=
          houter rho hrho lambda hlambda t s hscale
        _ ≤ B * rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ := by
          apply mul_le_mul_of_nonneg_right
          · exact mul_le_mul_of_nonneg_right hBouter hrho_pos.le
          · exact inv_nonneg.mpr (sq_nonneg _)
  have hright_integrable : ∀ t : Real,
      Integrable (fun s : Real =>
        ‖outerCircleProfileProductTimeKernel A rho lambda t s‖) volume := by
    intro t
    apply Integrable.mono'
    · exact (integrable_quadraticTimeEnvelope_univ (t := t) hLambda).const_mul
        ((2 * B) * rho)
    · exact (continuous_outerCircleProfileProductTimeKernel_right A hA0 rho lambda t).norm.aestronglyMeasurable
    · filter_upwards with s
      simpa only [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)] using hpoint t s
  have hleft_integrable : ∀ s : Real,
      Integrable (fun t : Real =>
        ‖outerCircleProfileProductTimeKernel A rho lambda t s‖) volume := by
    intro s
    apply (hright_integrable s).congr
    filter_upwards with t
    rw [norm_outerCircleProfileProductTimeKernel_symm A hstar]
  constructor
  · intro t
    refine ⟨hright_integrable t, ?_⟩
    apply integral_norm_le_of_quadraticTimeEnvelope_univ hLambda hTwoBrho
      (outerCircleProfileProductTimeKernel A rho lambda) (hright_integrable t)
    intro s
    exact hpoint t s
  · intro s
    refine ⟨hleft_integrable s, ?_⟩
    apply integral_norm_le_of_quadraticTimeEnvelope_univ_column hLambda hTwoBrho
      (outerCircleProfileProductTimeKernel A rho lambda) (hleft_integrable s)
    intro t
    exact hpoint t s

/-- Fixed-frequency quadratic E0 bound for the arbitrary smooth product
amplitude.  The Fubini hypotheses are left explicit just as in the concrete
finite-tensor wrapper. -/
theorem exists_outerCircleProfileProductTimeKernel_quadratic_E0
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (A : Real × Real → Complex) (hA0 : HasJointSndSmooth 0 A)
    (hA2 : HasJointSndSmooth 2 A)
    (hleft : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds 2] 0)
    (hstar : ∀ p, starRingEnd Complex (A p) = A p) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, 0 < lambda →
      ∀ H : Real → Complex,
        Integrable (fun t : Real => ‖H t‖ ^ 2) volume →
        Integrable (fun p : Real × Real =>
          ‖outerCircleProfileProductTimeKernel A rho lambda p.1 p.2‖ *
            ‖H p.1‖ * ‖H p.2‖) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          ‖outerCircleProfileProductTimeKernel A rho lambda p.1 p.2‖ *
            ‖H p.1‖ ^ 2) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          ‖outerCircleProfileProductTimeKernel A rho lambda p.1 p.2‖ *
            ‖H p.2‖ ^ 2) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          outerCircleProfileProductTimeKernel A rho lambda p.1 p.2 * H p.1 *
            starRingEnd Complex (H p.2)) (volume.prod volume) →
        ‖∫ t : Real, ∫ s : Real,
          outerCircleProfileProductTimeKernel A rho lambda t s * H t *
            starRingEnd Complex (H s)‖ ≤
          (B / (lambda * rho)) * ∫ t : Real, ‖H t‖ ^ 2 := by
  rcases exists_outerCircleProfileProductTimeKernel_global_row_column_schur
      hrhoMax hrhoMax_small A hA0 hA2 hleft hright hstar with ⟨B, hB, hbound⟩
  refine ⟨(2 * Real.pi) * B,
    mul_pos (mul_pos (by norm_num) Real.pi_pos) hB, ?_⟩
  intro rho hrho lambda hlambda H hHsq hquad hleftInt hrightInt hcomplex
  have hrho_pos : 0 < rho := hrho.1
  rcases hbound rho hrho lambda hlambda with ⟨hrows, _⟩
  let R : Real := (2 * B) * rho *
    (Real.pi / (lambda * rho ^ 2))
  have hsymm : ∀ t s : Real,
      ‖outerCircleProfileProductTimeKernel A rho lambda t s‖ =
        ‖outerCircleProfileProductTimeKernel A rho lambda s t‖ := by
    intro t s
    exact norm_outerCircleProfileProductTimeKernel_symm A hstar rho lambda t s
  have hrow : ∀ t : Real,
      Integrable (fun s : Real =>
        ‖outerCircleProfileProductTimeKernel A rho lambda t s‖) volume := by
    intro t
    exact (hrows t).1
  have hrowbound : ∀ t : Real,
      (∫ s : Real, ‖outerCircleProfileProductTimeKernel A rho lambda t s‖) ≤ R := by
    intro t
    exact (hrows t).2
  have hschur := norm_integral_integral_le_of_symmetricSchur
    (outerCircleProfileProductTimeKernel A rho lambda) R hsymm hrow hrowbound
    H hHsq hquad hleftInt hrightInt hcomplex
  have hR : R = ((2 * Real.pi) * B) / (lambda * rho) := by
    dsimp [R]
    field_simp [Real.pi_ne_zero, ne_of_gt hlambda, ne_of_gt hrho_pos]
  rw [hR] at hschur
  exact hschur

/-- The cutoff-derivative contribution is the generic quadratic E0 estimate
with the two physical `rho⁻¹` factors made explicit. -/
theorem exists_outerCircleProfileProductTimeKernel_cutoff_E1
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (A : Real × Real → Complex) (hA0 : HasJointSndSmooth 0 A)
    (hA2 : HasJointSndSmooth 2 A)
    (hleft : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds 2] 0)
    (hstar : ∀ p, starRingEnd Complex (A p) = A p) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, 0 < lambda →
      ∀ H : Real → Complex,
        Integrable (fun t : Real => ‖H t‖ ^ 2) volume →
        Integrable (fun p : Real × Real =>
          ‖outerCircleProfileProductTimeKernel A rho lambda p.1 p.2‖ *
            ‖H p.1‖ * ‖H p.2‖) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          ‖outerCircleProfileProductTimeKernel A rho lambda p.1 p.2‖ *
            ‖H p.1‖ ^ 2) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          ‖outerCircleProfileProductTimeKernel A rho lambda p.1 p.2‖ *
            ‖H p.2‖ ^ 2) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          outerCircleProfileProductTimeKernel A rho lambda p.1 p.2 * H p.1 *
            starRingEnd Complex (H p.2)) (volume.prod volume) →
        ‖(((rho ^ 2)⁻¹ : Real) : Complex) *
          ∫ t : Real, ∫ s : Real,
            outerCircleProfileProductTimeKernel A rho lambda t s * H t *
              starRingEnd Complex (H s)‖ ≤
          ((rho ^ 2)⁻¹) * (B / (lambda * rho)) *
