section

section Auto.Spherical.MSS

open Filter MeasureTheory Set
open scoped BigOperators

noncomputable section

/-- All Fubini data for one finite-core time profile and one real parametric
angular amplitude.  Keeping these five hypotheses explicit makes the
fixed-frequency Schur theorem valid before the final compact-core/density
transport has been installed. -/
structure ParametricRealProfileTTStarFubini
    (g : Real × Real -> Real) (rho lambda : Real) (H : Real -> Complex) : Prop where
  hHsq : Integrable (fun t : Real => ‖H t‖ ^ 2) volume
  hpoint : ∀ u : Real, Integrable (fun t : Real =>
    outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u t * H t) volume
  hpointStar : ∀ u : Real, Integrable (fun s : Real =>
    starRingEnd Complex
      (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u s * H s)) volume
  htriple : Integrable (Function.uncurry fun u (p : Real × Real) =>
    (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u p.1 * H p.1) *
      starRingEnd Complex
        (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u p.2 * H p.2))
    ((volume.restrict (Ioc (1 / 2 : Real) 2)).prod (volume.prod volume))
  hkernel : ∀ t s : Real, Integrable (fun u : Real =>
    outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u t *
      starRingEnd Complex
        (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u s))
    (volume.restrict (Ioc (1 / 2 : Real) 2))
  hrhs : Integrable (Function.uncurry fun t s =>
    ttstarKernel (volume.restrict (Ioc (1 / 2 : Real) 2))
      (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) t s * H t *
        starRingEnd Complex (H s)) (volume.prod volume)
  hquad : Integrable (fun p : Real × Real =>
    ‖outerCircleProfileFourierCharProductKernel
      (outerCircleParametricRealProfileProductAmplitude g) rho lambda p.1 p.2‖ *
        ‖H p.1‖ * ‖H p.2‖) (volume.prod volume)
  hleftSq : Integrable (fun p : Real × Real =>
    ‖outerCircleProfileFourierCharProductKernel
      (outerCircleParametricRealProfileProductAmplitude g) rho lambda p.1 p.2‖ *
        ‖H p.1‖ ^ 2) (volume.prod volume)
  hrightSq : Integrable (fun p : Real × Real =>
    ‖outerCircleProfileFourierCharProductKernel
      (outerCircleParametricRealProfileProductAmplitude g) rho lambda p.1 p.2‖ *
        ‖H p.2‖ ^ 2) (volume.prod volume)
  hcomplex : Integrable (fun p : Real × Real =>
    outerCircleProfileFourierCharProductKernel
      (outerCircleParametricRealProfileProductAmplitude g) rho lambda p.1 p.2 * H p.1 *
        starRingEnd Complex (H p.2)) (volume.prod volume)

theorem ParametricRealProfileTTStarFubini.factorization
    {g : Real × Real -> Real} {rho lambda : Real} {H : Real -> Complex}
    (h : ParametricRealProfileTTStarFubini g rho lambda H) :
    (rho : Complex) *
      ∫ u : Real,
        ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u *
          starRingEnd Complex
            (ttstarAnalysis volume
              (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u)
        ∂(volume.restrict (Ioc (1 / 2 : Real) 2)) =
      ∫ t : Real, ∫ s : Real,
        outerCircleProfileFourierCharProductKernel
          (outerCircleParametricRealProfileProductAmplitude g) rho lambda t s * H t *
          starRingEnd Complex (H s) := by
  exact outerCircleParametricRealProfileFourierCharAnalysis_ttstar_factorization
    g rho lambda H h.hpoint h.hpointStar h.htriple h.hkernel h.hrhs

/-- Uniform fixed-frequency `E₀` for one shifted patch and one arbitrary
smooth normalized lobe.  The result is formulated in the exact local
`TT*` energy that later Plancherel transports to the physical shell field. -/
theorem exists_shiftedOuterParametricProfile_quadratic_E0
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (n : Nat) (lobe : Real -> Real) (hlobe : ContDiff Real (⊤ : ℕ∞) lobe)
    (hleft : lobe =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : lobe =ᶠ[nhds 2] 0) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, 0 < lambda →
      ∀ H : Real -> Complex,
        ParametricRealProfileTTStarFubini
          (shiftedOuterParametricProfile n lobe) rho lambda H →
        ‖(rho : Complex) *
          ∫ u : Real,
            ttstarAnalysis volume
              (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
                (shiftedOuterParametricProfile n lobe) rho lambda) H u *
              starRingEnd Complex
                (ttstarAnalysis volume
                  (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
                    (shiftedOuterParametricProfile n lobe) rho lambda) H u)
            ∂(volume.restrict (Ioc (1 / 2 : Real) 2))‖ ≤
          (B / (lambda * rho)) * ∫ t : Real, ‖H t‖ ^ 2 := by
  let g : Real × Real -> Real := shiftedOuterParametricProfile n lobe
  have hg : ContDiff Real (⊤ : ℕ∞) g :=
    contDiff_shiftedOuterParametricProfile n lobe hlobe
  rcases exists_outerCircleProfileFourierCharProductKernel_quadratic_E0
      hrhoMax hrhoMax_small
      (outerCircleParametricRealProfileProductAmplitude g)
      (hasJointSndSmooth_outerCircleParametricRealProfileProductAmplitude g hg 0)
      (hasJointSndSmooth_outerCircleParametricRealProfileProductAmplitude g hg 2)
      (fun rho hrho =>
        outerCircleParametricRealProfileProductAmplitude_eventuallyEq_zero_left
          (shiftedOuterParametricProfile_eventuallyEq_zero_left n hleft) rho)
      (fun rho hrho =>
        outerCircleParametricRealProfileProductAmplitude_eventuallyEq_zero_right
          (shiftedOuterParametricProfile_eventuallyEq_zero_right n hright) rho)
      (star_outerCircleParametricRealProfileProductAmplitude g) with ⟨B, hB, hschur⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda H hFubini
  rw [hFubini.factorization]
  simpa [g] using hschur rho hrho lambda hlambda H hFubini.hHsq hFubini.hquad
    hFubini.hleftSq hFubini.hrightSq hFubini.hcomplex

/-- The cutoff-coordinate contribution to `E₁`, retaining its literal
`rho⁻²` factor. -/
theorem exists_shiftedOuterParametricProfile_cutoff_E1
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (n : Nat) (lobe : Real -> Real) (hlobe : ContDiff Real (⊤ : ℕ∞) lobe)
    (hleft : lobe =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : lobe =ᶠ[nhds 2] 0) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, 0 < lambda →
      ∀ H : Real -> Complex,
        ParametricRealProfileTTStarFubini
          (shiftedOuterParametricProfileSndDeriv n lobe) rho lambda H →
        ‖(((rho ^ 2)⁻¹ : Real) : Complex) *
          ((rho : Complex) *
            ∫ u : Real,
              ttstarAnalysis volume
                (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
                  (shiftedOuterParametricProfileSndDeriv n lobe) rho lambda) H u *
                starRingEnd Complex
                  (ttstarAnalysis volume
                    (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
                      (shiftedOuterParametricProfileSndDeriv n lobe) rho lambda) H u)
              ∂(volume.restrict (Ioc (1 / 2 : Real) 2)))‖ ≤
          ((rho ^ 2)⁻¹) * (B / (lambda * rho)) * ∫ t : Real, ‖H t‖ ^ 2 := by
  let g : Real × Real -> Real := shiftedOuterParametricProfileSndDeriv n lobe
  have hg : ContDiff Real (⊤ : ℕ∞) g :=
    contDiff_shiftedOuterParametricProfileSndDeriv n lobe hlobe
  rcases exists_outerCircleProfileFourierCharProductKernel_cutoff_E1
      hrhoMax hrhoMax_small
      (outerCircleParametricRealProfileProductAmplitude g)
      (hasJointSndSmooth_outerCircleParametricRealProfileProductAmplitude g hg 0)
      (hasJointSndSmooth_outerCircleParametricRealProfileProductAmplitude g hg 2)
      (fun rho hrho =>
        outerCircleParametricRealProfileProductAmplitude_eventuallyEq_zero_left
          (shiftedOuterParametricProfileSndDeriv_eventuallyEq_zero_left n hlobe hleft) rho)
      (fun rho hrho =>
        outerCircleParametricRealProfileProductAmplitude_eventuallyEq_zero_right
          (shiftedOuterParametricProfileSndDeriv_eventuallyEq_zero_right n hlobe hright) rho)
      (star_outerCircleParametricRealProfileProductAmplitude g) with ⟨B, hB, hschur⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda H hFubini
  rw [hFubini.factorization]
  simpa [g] using hschur rho hrho lambda hlambda H hFubini.hHsq hFubini.hquad
    hFubini.hleftSq hFubini.hrightSq hFubini.hcomplex

/-- The exact removable phase-factor contribution to `E₁`.  The weighted time
profile `W` is left explicit; compact time support later gives `W=tH` the
same `L²` size as `H`. -/
theorem exists_shiftedOuterParametricProfile_phaseFactor_E1
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (n : Nat) (lobe : Real -> Real) (hlobe : ContDiff Real (⊤ : ℕ∞) lobe)
    (hleft : lobe =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : lobe =ᶠ[nhds 2] 0) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, 0 < lambda →
      ∀ W : Real -> Complex,
        ParametricRealProfileTTStarFubini
          (shiftedOuterParametricScaledPhaseProfile n lobe) rho lambda W →
        ‖((((2 * Real.pi) * lambda * rho) ^ 2 : Real) : Complex) *
          ((rho : Complex) *
            ∫ u : Real,
              ttstarAnalysis volume
                (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
                  (shiftedOuterParametricScaledPhaseProfile n lobe) rho lambda) W u *
                starRingEnd Complex
                  (ttstarAnalysis volume
                    (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
                      (shiftedOuterParametricScaledPhaseProfile n lobe) rho lambda) W u)
              ∂(volume.restrict (Ioc (1 / 2 : Real) 2)))‖ ≤
          (((2 * Real.pi) * lambda * rho) ^ 2) * (B / (lambda * rho)) *
            ∫ t : Real, ‖W t‖ ^ 2 := by
  let g : Real × Real -> Real := shiftedOuterParametricScaledPhaseProfile n lobe
  have hg0 : HasJointSndSmooth 0 g :=
    hasJointSndSmooth_shiftedOuterParametricScaledPhaseProfile n lobe hlobe 0
  have hg2 : HasJointSndSmooth 2 g :=
    hasJointSndSmooth_shiftedOuterParametricScaledPhaseProfile n lobe hlobe 2
  rcases exists_outerCircleProfileFourierCharProductKernel_phaseFactor_E1
      hrhoMax hrhoMax_small
      (outerCircleParametricRealProfileProductAmplitude g)
      (hasJointSndSmooth_outerCircleParametricRealProfileProductAmplitude_of_hasJoint hg0)
      (hasJointSndSmooth_outerCircleParametricRealProfileProductAmplitude_of_hasJoint hg2)
      (fun rho hrho =>
        outerCircleParametricRealProfileProductAmplitude_eventuallyEq_zero_left
          (shiftedOuterParametricScaledPhaseProfile_eventuallyEq_zero_left n hleft) rho)
      (fun rho hrho =>
        outerCircleParametricRealProfileProductAmplitude_eventuallyEq_zero_right
          (shiftedOuterParametricScaledPhaseProfile_eventuallyEq_zero_right n hright) rho)
      (star_outerCircleParametricRealProfileProductAmplitude g) with ⟨B, hB, hschur⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda W hFubini
  rw [hFubini.factorization]
  simpa [g] using hschur rho hrho lambda hlambda W hFubini.hHsq hFubini.hquad
    hFubini.hleftSq hFubini.hrightSq hFubini.hcomplex

end

