          Integrable (fun p : Real × Real =>
            outerCircleFourierCharProductKernel rho lambda p.1 p.2 * H p.1 *
              starRingEnd Complex (H p.2)) (volume.prod volume) →
          ‖∫ t : Real, ∫ s : Real,
            outerCircleFourierCharProductKernel rho lambda t s * H t *
              starRingEnd Complex (H s)‖ ≤
            (B / (lambda * rho)) * ∫ t : Real, ‖H t‖ ^ 2 := by
  rcases exists_outerCircleFourierCharProductKernel_quadratic_E0
      hrhoMax hrhoMax_small with ⟨B, hB, hmain⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho alpha lambda hlambda H hHsq hquad hleft hright hcomplex
  exact hmain rho hrho lambda hlambda H hHsq hquad hleft hright hcomplex

/-- Actual fixed-frequency outer-shell `E₀`: the left side is the literal
cutoff angular energy written as a complex positive quadratic form.  The
preceding factorization theorem discharges its displayed equality from the
