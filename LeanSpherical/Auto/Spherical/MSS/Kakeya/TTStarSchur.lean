section Auto.Spherical.MSS

open MeasureTheory Set
open scoped BigOperators

open Auto.OneDimStationaryPhase

noncomputable section

/-- The literal outer-circle `TT*` time kernel after the angular shell change
of variables `theta = rho*u`.  The time difference is the only `t,s`
dependence, and the phase is the actual circular phase. -/
def outerCircleTTStarTimeKernel (rho lambda t s : Real) : Complex :=
  (rho : Complex) * ∫ u in (1 / 2 : Real)..2,
    fixedOuterCircleUnitShellAmplitude u * Complex.exp
      (((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I))

theorem norm_fixedOuterCircleUnitShellAmplitude_le_one (u : Real) :
    ‖fixedOuterCircleUnitShellAmplitude u‖ ≤ 1 := by
  unfold fixedOuterCircleUnitShellAmplitude
  rw [Complex.norm_real,
    Real.norm_of_nonneg (ContDiffBump.nonneg' fixedOuterCircleUnitShellBump u)]
  exact fixedOuterCircleUnitShellBump.le_one

/-- The central part of the literal outer circle kernel costs only its shell
width.  No stationary-phase assertion is used here. -/
theorem norm_outerCircleTTStarTimeKernel_le_central
    {rho lambda t s : Real} (hrho : 0 ≤ rho) :
    ‖outerCircleTTStarTimeKernel rho lambda t s‖ ≤ rho * (3 / 2 : Real) := by
  have hintegral : ‖∫ u in (1 / 2 : Real)..2,
      fixedOuterCircleUnitShellAmplitude u * Complex.exp
        (((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I))‖ ≤
        (1 : Real) * |2 - (1 / 2 : Real)| := by
    apply intervalIntegral.norm_integral_le_of_norm_le_const
    intro u hu
    rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one]
    exact norm_fixedOuterCircleUnitShellAmplitude_le_one u
  unfold outerCircleTTStarTimeKernel
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hrho]
  calc
    rho * ‖∫ u in (1 / 2 : Real)..2,
        fixedOuterCircleUnitShellAmplitude u * Complex.exp
          (((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I))‖ ≤
        rho * ((1 : Real) * |2 - (1 / 2 : Real)|) :=
      mul_le_mul_of_nonneg_left hintegral hrho
    _ = rho * (3 / 2 : Real) := by norm_num

/-- The literal outer circle time kernel is continuous in its second time
variable.  Compactness of the fixed angular shell, rather than any decay
estimate, supplies the needed parameter-integral continuity. -/
theorem continuous_outerCircleTTStarTimeKernel_right
    (rho lambda t : Real) :
    Continuous (fun s => outerCircleTTStarTimeKernel rho lambda t s) := by
  let f : Real → Real → Complex := fun s u =>
    fixedOuterCircleUnitShellAmplitude u * Complex.exp
      (((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I))
  have hf : Continuous (Function.uncurry f) := by
    dsimp [f]
    exact
      (contDiff_fixedOuterCircleUnitShellAmplitude.continuous.comp continuous_snd).mul
        (by fun_prop)
  have hparam : Continuous (fun s : Real =>
      ∫ u in Icc (1 / 2 : Real) 2, f s u) :=
    continuous_parametric_integral_of_continuous (μ := volume) hf isCompact_Icc
  have heq : (fun s : Real => ∫ u in (1 / 2 : Real)..2, f s u) =
      fun s : Real => ∫ u in Icc (1 / 2 : Real) 2, f s u := by
    funext s
    rw [intervalIntegral.integral_of_le (by norm_num),
      ← integral_Icc_eq_integral_Ioc]
  unfold outerCircleTTStarTimeKernel
  change Continuous (fun s : Real => (rho : Complex) *
    ∫ u in (1 / 2 : Real)..2, f s u)
  apply continuous_const.mul
  rw [heq]
  exact hparam

theorem continuous_outerCircleTTStarTimeKernel_left
    (rho lambda s : Real) :
    Continuous (fun t => outerCircleTTStarTimeKernel rho lambda t s) := by
  let f : Real → Real → Complex := fun t u =>
    fixedOuterCircleUnitShellAmplitude u * Complex.exp
      (((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I))
  have hf : Continuous (Function.uncurry f) := by
    dsimp [f]
    exact
      (contDiff_fixedOuterCircleUnitShellAmplitude.continuous.comp continuous_snd).mul
        (by fun_prop)
  have hparam : Continuous (fun t : Real =>
      ∫ u in Icc (1 / 2 : Real) 2, f t u) :=
    continuous_parametric_integral_of_continuous (μ := volume) hf isCompact_Icc
  have heq : (fun t : Real => ∫ u in (1 / 2 : Real)..2, f t u) =
      fun t : Real => ∫ u in Icc (1 / 2 : Real) 2, f t u := by
    funext t
    rw [intervalIntegral.integral_of_le (by norm_num),
      ← integral_Icc_eq_integral_Ioc]
  unfold outerCircleTTStarTimeKernel
  change Continuous (fun t : Real => (rho : Complex) *
    ∫ u in (1 / 2 : Real)..2, f t u)
  apply continuous_const.mul
  rw [heq]
  exact hparam

/-- The completed fixed-bump circle IBP package supplies order-two outer
decay for the literal time kernel, uniformly in the shell width. -/
theorem exists_outerCircleTTStarTimeKernel_outer_order_two
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) :
    ∃ M : Real, 0 < M ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, ∀ t s : Real,
        (t - s) * lambda * rho ^ 2 ≠ 0 →
        ‖outerCircleTTStarTimeKernel rho lambda t s‖ ≤
          rho * (1 / |(t - s) * lambda * rho ^ 2|) ^ 2 *
            ((2 - (1 / 2 : Real)) * M) := by
  rcases exists_uniform_literalOuterCircleUnitShell_fixedBump
      (N := 2) hrhoMax hrhoMax_small with ⟨M, hM, hbound⟩
  refine ⟨M, hM, ?_⟩
  intro rho hrho lambda t s hnonzero
  exact hbound rho hrho (t - s) lambda hnonzero

/-- For positive frequency and shell width, the preceding outer IBP estimate
has exactly the quadratic time-difference form used by continuous Schur. -/
theorem exists_outerCircleTTStarTimeKernel_outer_quadratic
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) :
    ∃ A : Real, 0 < A ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, 0 < lambda →
        ∀ t s : Real, lambda * rho ^ 2 * |t - s| ≠ 0 →
        ‖outerCircleTTStarTimeKernel rho lambda t s‖ ≤
          A * rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ := by
  rcases exists_outerCircleTTStarTimeKernel_outer_order_two
      hrhoMax hrhoMax_small with ⟨M, hM, hMbound⟩
  refine ⟨(2 - (1 / 2 : Real)) * M, mul_pos (by norm_num) hM, ?_⟩
  intro rho hrho lambda hlambda t s hscale
  have hts : t - s ≠ 0 := by
    intro hts
    apply hscale
    simp [hts]
  have hnonzero : (t - s) * lambda * rho ^ 2 ≠ 0 :=
    mul_ne_zero (mul_ne_zero hts hlambda.ne')
      (pow_ne_zero 2 (ne_of_gt hrho.1))
  have hbase := hMbound rho hrho lambda t s hnonzero
  have habs : |(t - s) * lambda * rho ^ 2| =
      lambda * rho ^ 2 * |t - s| := by
    rw [abs_mul, abs_mul, abs_of_pos hlambda,
      abs_of_nonneg (sq_nonneg rho)]
    ring
  rw [habs] at hbase
  have hpow : (1 / (lambda * rho ^ 2 * |t - s|)) ^ 2 =
      ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ := by
    rw [one_div, inv_pow]
  rw [hpow] at hbase
  calc
    ‖outerCircleTTStarTimeKernel rho lambda t s‖ ≤
        rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ *
          ((2 - (1 / 2 : Real)) * M) := hbase
    _ = ((2 - (1 / 2 : Real)) * M) * rho *
          ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ := by ring

/-- The actual outer circle kernel has uniform continuous Schur row and
column envelopes.  The only displayed analytic data not supplied by circle
IBP are interval integrability of the literal kernel slices; smooth compact
amplitude/Fubini proves those in the eventual source transfer. -/
theorem exists_outerCircleTTStarTimeKernel_row_column_schur
    {rhoMax a b : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) (hab : a ≤ b) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, 0 < lambda →
        (∀ t : Real, IntervalIntegrable
          (fun s => ‖outerCircleTTStarTimeKernel rho lambda t s‖) volume a b) →
        (∀ s : Real, IntervalIntegrable
          (fun t => ‖outerCircleTTStarTimeKernel rho lambda t s‖) volume a b) →
        (∀ t : Real,
          (∫ s in a..b, ‖outerCircleTTStarTimeKernel rho lambda t s‖) ≤
            (2 * B) * rho * (Real.pi / (lambda * rho ^ 2))) ∧
        (∀ s : Real,
          (∫ t in a..b, ‖outerCircleTTStarTimeKernel rho lambda t s‖) ≤
            (2 * B) * rho * (Real.pi / (lambda * rho ^ 2))) := by
  rcases exists_outerCircleTTStarTimeKernel_outer_quadratic
      hrhoMax hrhoMax_small with ⟨A, hA, houter⟩
  let B : Real := max (3 / 2 : Real) A
  have hBcentral : (3 / 2 : Real) ≤ B := le_max_left _ _
  have hBouter : A ≤ B := le_max_right _ _
  have hB : 0 < B := lt_of_lt_of_le hA hBouter
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda hrow_integrable hcol_integrable
  have hrho_pos : 0 < rho := hrho.1
  have hLambda : 0 < lambda * rho ^ 2 :=
    mul_pos hlambda (sq_pos_of_pos hrho_pos)
  have hBrho : 0 ≤ B * rho := mul_nonneg hB.le hrho_pos.le
  constructor
  · intro t
    apply intervalIntegral_norm_le_of_central_outer
      hab hLambda hBrho (outerCircleTTStarTimeKernel rho lambda)
      (hrow_integrable t)
    · intro s hs
      calc
        ‖outerCircleTTStarTimeKernel rho lambda t s‖ ≤ rho * (3 / 2 : Real) :=
          norm_outerCircleTTStarTimeKernel_le_central hrho_pos.le
        _ = (3 / 2 : Real) * rho := by ring
        _ ≤ B * rho := mul_le_mul_of_nonneg_right hBcentral hrho_pos.le
    · intro s hs hscale
      calc
        ‖outerCircleTTStarTimeKernel rho lambda t s‖ ≤
            A * rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ :=
          houter rho hrho lambda hlambda t s hscale
        _ ≤ B * rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ := by
          apply mul_le_mul_of_nonneg_right
          · exact mul_le_mul_of_nonneg_right hBouter hrho_pos.le
          · exact inv_nonneg.mpr (sq_nonneg _)
  · intro s
    apply intervalIntegral_norm_le_of_central_outer_column
      hab hLambda hBrho (outerCircleTTStarTimeKernel rho lambda)
      (hcol_integrable s)
    · intro t ht
      calc
        ‖outerCircleTTStarTimeKernel rho lambda t s‖ ≤ rho * (3 / 2 : Real) :=
          norm_outerCircleTTStarTimeKernel_le_central hrho_pos.le
        _ = (3 / 2 : Real) * rho := by ring
        _ ≤ B * rho := mul_le_mul_of_nonneg_right hBcentral hrho_pos.le
    · intro t ht hscale
      calc
        ‖outerCircleTTStarTimeKernel rho lambda t s‖ ≤
            A * rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ :=
          houter rho hrho lambda hlambda t s hscale
        _ ≤ B * rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ := by
          apply mul_le_mul_of_nonneg_right
          · exact mul_le_mul_of_nonneg_right hBouter hrho_pos.le
          · exact inv_nonneg.mpr (sq_nonneg _)

/-- Every literal time slice of the fixed-bump circle kernel is interval
integrable.  This discharges the only auxiliary measurability hypothesis in
the continuous row-envelope lemma. -/
theorem intervalIntegrable_outerCircleTTStarTimeKernel_right
    (rho lambda t a b : Real) :
    IntervalIntegrable
      (fun s => ‖outerCircleTTStarTimeKernel rho lambda t s‖) volume a b :=
  (continuous_outerCircleTTStarTimeKernel_right rho lambda t).norm.intervalIntegrable
    (μ := volume) a b

/-- The analogous integrability statement with the first time variable free. -/
theorem intervalIntegrable_outerCircleTTStarTimeKernel_left
    (rho lambda s a b : Real) :
    IntervalIntegrable
      (fun t => ‖outerCircleTTStarTimeKernel rho lambda t s‖) volume a b :=
  (continuous_outerCircleTTStarTimeKernel_left rho lambda s).norm.intervalIntegrable
    (μ := volume) a b

/-- A completely literal fixed-bump circle shell has uniform row and column
Schur envelopes.  The bound is of size `(lambda * rho)⁻¹`, since the kernel
has central size `rho` and its decay turns on at the time scale
`(lambda * rho^2)⁻¹`. -/
theorem exists_outerCircleTTStarTimeKernel_row_column_schur_unconditional
    {rhoMax a b : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) (hab : a ≤ b) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, 0 < lambda →
        (∀ t : Real,
          (∫ s in a..b, ‖outerCircleTTStarTimeKernel rho lambda t s‖) ≤
            (2 * B) * rho * (Real.pi / (lambda * rho ^ 2))) ∧
        (∀ s : Real,
          (∫ t in a..b, ‖outerCircleTTStarTimeKernel rho lambda t s‖) ≤
            (2 * B) * rho * (Real.pi / (lambda * rho ^ 2))) := by
  rcases exists_outerCircleTTStarTimeKernel_row_column_schur
      hrhoMax hrhoMax_small hab with ⟨B, hB, hschur⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda
  exact hschur rho hrho lambda hlambda
    (fun t => intervalIntegrable_outerCircleTTStarTimeKernel_right rho lambda t a b)
    (fun s => intervalIntegrable_outerCircleTTStarTimeKernel_left rho lambda s a b)

/-- The actual `TT*` angular weight for the fixed shell cutoff.  The cutoff
is real valued, so this is literally `chi * conj chi`, written as a square. -/
noncomputable def outerCircleTTStarProductAmplitude (u : Real) : Complex :=
  fixedOuterCircleUnitShellAmplitude u ^ 2

theorem outerCircleTTStarProductAmplitude_eq_cutoff_mul_conj (u : Real) :
    outerCircleTTStarProductAmplitude u =
      fixedOuterCircleUnitShellAmplitude u *
        starRingEnd Complex (fixedOuterCircleUnitShellAmplitude u) := by
  unfold outerCircleTTStarProductAmplitude fixedOuterCircleUnitShellAmplitude
  simp [pow_two]

theorem norm_outerCircleTTStarProductAmplitude_le_one (u : Real) :
    ‖outerCircleTTStarProductAmplitude u‖ ≤ 1 := by
  rw [outerCircleTTStarProductAmplitude, norm_pow]
  have h := norm_fixedOuterCircleUnitShellAmplitude_le_one u
  have hnonneg : 0 ≤ ‖fixedOuterCircleUnitShellAmplitude u‖ := norm_nonneg _
  nlinarith [sq_nonneg (1 - ‖fixedOuterCircleUnitShellAmplitude u‖)]

theorem contDiff_outerCircleTTStarProductAmplitude :
    ContDiff Real (⊤ : ℕ∞) outerCircleTTStarProductAmplitude := by
  unfold outerCircleTTStarProductAmplitude
  exact contDiff_fixedOuterCircleUnitShellAmplitude.pow 2

theorem outerCircleTTStarProductAmplitude_eventuallyEq_zero_left :
    outerCircleTTStarProductAmplitude =ᶠ[nhds (1 / 2 : Real)] 0 := by
  filter_upwards [fixedOuterCircleUnitShellAmplitude_eventuallyEq_zero_left] with u hu
  simp [outerCircleTTStarProductAmplitude, hu]

theorem outerCircleTTStarProductAmplitude_eventuallyEq_zero_right :
    outerCircleTTStarProductAmplitude =ᶠ[nhds (2 : Real)] 0 := by
  filter_upwards [fixedOuterCircleUnitShellAmplitude_eventuallyEq_zero_right] with u hu
  simp [outerCircleTTStarProductAmplitude, hu]

/-- The nonlinear IBP quotient amplitudes of the true `chi * conj chi`
weight are uniformly bounded on all small outer shells, at every fixed order.
This is the same compact joint-angular-smoothness argument as for the basic
bump, now applied to its square. -/
theorem exists_uniform_outerCircleTTStarProductFinalAmplitude_bound
    {rhoMax : Real} {N : Nat}
    (hrhoMax : 0 ≤ rhoMax) (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) :
    ∃ M : Real, 0 < M ∧
      ∀ rho ∈ Ioc 0 rhoMax, ∀ u ∈ Icc (1 / 2 : Real) 2,
        ‖nonstationaryIBPAmplitude (outerCircleShellDerivativeExtension rho)
          outerCircleTTStarProductAmplitude N u‖ ≤ M := by
  let D : Real × Real → Real := safeOuterCircleUniformDerivativeExtension rhoMax
  let F : Real × Real → Complex := fun p => outerCircleTTStarProductAmplitude p.2
  have hD : HasJointSndSmooth N D := by
    dsimp [D]
    exact hasJointSndSmooth_safeOuterCircleUniformDerivativeExtension rhoMax N
  have hFbase : HasJointSndSmooth N
      (fun p : Real × Real => fixedOuterCircleUnitShellAmplitude p.2) := by
    exact hasJointSndSmooth_of_contDiff
      (fun p : Real × Real => fixedOuterCircleUnitShellAmplitude p.2)
      contDiff_fixedOuterCircleUnitShellAmplitude_joint N
  have hF : HasJointSndSmooth N F := by
    dsimp [F, outerCircleTTStarProductAmplitude]
    simpa [pow_two] using hFbase.mul hFbase
  have hDne : ∀ p, D p ≠ 0 := by
    intro p
    dsimp [D]
    exact safeOuterCircleUniformDerivativeExtension_ne_zero hrhoMax hrhoMax_small p
  have hA : HasJointSndSmooth 0
      (parametricNonstationaryIBPAmplitude D F N) :=
    hasJointSndSmooth_parametricNonstationaryIBPAmplitude
      (n := 0) (k := N) D F (by simpa using hD) (by simpa using hF) hDne
  have hAcont : Continuous (parametricNonstationaryIBPAmplitude D F N) := by
    simpa [HasJointSndSmooth] using hA
  rcases exists_uniform_norm_bound_of_jointContinuous
      (a := (1 / 2 : Real)) (b := 2) hrhoMax (by norm_num)
      (fun rho u => parametricNonstationaryIBPAmplitude D F N (rho, u))
      (by simpa using hAcont) with ⟨M, hM, hbound⟩
  refine ⟨M, hM, ?_⟩
  intro rho hrho u hu
  have hDslice : (fun v : Real => D (rho, v)) =
      outerCircleShellDerivativeExtension rho := by
    dsimp [D]
    exact (safeOuterCircleUniformDerivativeExtension_eq hrho.1.le hrho.2).trans
      (outerCircleUniformDerivativeExtension_eq hrho.1.ne')
  have heq : nonstationaryIBPAmplitude (outerCircleShellDerivativeExtension rho)
      outerCircleTTStarProductAmplitude N u =
      parametricNonstationaryIBPAmplitude D F N (rho, u) := by
    calc
      nonstationaryIBPAmplitude (outerCircleShellDerivativeExtension rho)
          outerCircleTTStarProductAmplitude N u =
          nonstationaryIBPAmplitude (fun v => D (rho, v))
            (fun v => F (rho, v)) N u := by
              dsimp [F]
              rw [hDslice]
      _ = parametricNonstationaryIBPAmplitude D F N (rho, u) :=
        (parametricNonstationaryIBPAmplitude_eq_slice D F N rho u).symm
  rw [heq]
  exact hbound rho ⟨hrho.1.le, hrho.2⟩ u hu

/-- Uniform nonlinear IBP for the genuine squared cutoff, in the original
circle phase. -/
theorem exists_uniform_literalOuterCircleUnitShell_productAmplitude
    {rhoMax : Real} {N : Nat}
    (hrhoMax : 0 ≤ rhoMax) (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) :
    ∃ M : Real, 0 < M ∧
      ∀ rho ∈ Ioc 0 rhoMax, ∀ tau lambda : Real,
        tau * lambda * rho ^ 2 ≠ 0 →
        ‖(rho : Complex) * ∫ u in (1 / 2 : Real)..2,
          outerCircleTTStarProductAmplitude u * Complex.exp
            (((tau * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I)‖ ≤
          rho * (1 / |tau * lambda * rho ^ 2|) ^ N *
            ((2 - (1 / 2 : Real)) * M) := by
  rcases exists_uniform_outerCircleTTStarProductFinalAmplitude_bound
      (N := N) hrhoMax hrhoMax_small with ⟨M, hM, hbound⟩
  refine ⟨M, hM, ?_⟩
  intro rho hrho tau lambda hfreq
  have hrho_small : 9 * rho / 4 < Real.pi := by
    calc
      9 * rho / 4 = (9 / 4 : Real) * rho := by ring
      _ ≤ (9 / 4 : Real) * rhoMax :=
        mul_le_mul_of_nonneg_left hrho.2 (by norm_num)
      _ = 9 * rhoMax / 4 := by ring
      _ < Real.pi := hrhoMax_small
  exact norm_literalOuterCircleUnitShell_of_contDiff hrho.1 hrho_small hfreq
    contDiff_outerCircleTTStarProductAmplitude
    outerCircleTTStarProductAmplitude_eventuallyEq_zero_left
    outerCircleTTStarProductAmplitude_eventuallyEq_zero_right
    hM.le (hbound rho hrho)

/-- The genuine fixed-shell time `TT*` kernel.  Its angular density is
exactly the product of the analysis cutoff with its conjugate. -/
def outerCircleTTStarProductTimeKernel (rho lambda t s : Real) : Complex :=
  (rho : Complex) * ∫ u in (1 / 2 : Real)..2,
    outerCircleTTStarProductAmplitude u * Complex.exp
      (((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I))

theorem norm_outerCircleTTStarProductTimeKernel_le_central
    {rho lambda t s : Real} (hrho : 0 ≤ rho) :
    ‖outerCircleTTStarProductTimeKernel rho lambda t s‖ ≤ rho * (3 / 2 : Real) := by
  have hintegral : ‖∫ u in (1 / 2 : Real)..2,
      outerCircleTTStarProductAmplitude u * Complex.exp
        (((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I))‖ ≤
        (1 : Real) * |2 - (1 / 2 : Real)| := by
    apply intervalIntegral.norm_integral_le_of_norm_le_const
    intro u hu
    rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one]
    exact norm_outerCircleTTStarProductAmplitude_le_one u
  unfold outerCircleTTStarProductTimeKernel
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hrho]
  calc
    rho * ‖∫ u in (1 / 2 : Real)..2,
        outerCircleTTStarProductAmplitude u * Complex.exp
          (((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I))‖ ≤
        rho * ((1 : Real) * |2 - (1 / 2 : Real)|) :=
      mul_le_mul_of_nonneg_left hintegral hrho
    _ = rho * (3 / 2 : Real) := by norm_num

theorem exists_outerCircleTTStarProductTimeKernel_outer_order_two
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) :
    ∃ M : Real, 0 < M ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, ∀ t s : Real,
        (t - s) * lambda * rho ^ 2 ≠ 0 →
        ‖outerCircleTTStarProductTimeKernel rho lambda t s‖ ≤
          rho * (1 / |(t - s) * lambda * rho ^ 2|) ^ 2 *
            ((2 - (1 / 2 : Real)) * M) := by
  rcases exists_uniform_literalOuterCircleUnitShell_productAmplitude
      (N := 2) hrhoMax hrhoMax_small with ⟨M, hM, hbound⟩
  refine ⟨M, hM, ?_⟩
  intro rho hrho lambda t s hnonzero
  exact hbound rho hrho (t - s) lambda hnonzero

theorem exists_outerCircleTTStarProductTimeKernel_outer_quadratic
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) :
    ∃ A : Real, 0 < A ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, 0 < lambda →
        ∀ t s : Real, lambda * rho ^ 2 * |t - s| ≠ 0 →
        ‖outerCircleTTStarProductTimeKernel rho lambda t s‖ ≤
          A * rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ := by
  rcases exists_outerCircleTTStarProductTimeKernel_outer_order_two
      hrhoMax hrhoMax_small with ⟨M, hM, hMbound⟩
  refine ⟨(2 - (1 / 2 : Real)) * M, mul_pos (by norm_num) hM, ?_⟩
  intro rho hrho lambda hlambda t s hscale
  have hts : t - s ≠ 0 := by
    intro hts
    apply hscale
    simp [hts]
  have hnonzero : (t - s) * lambda * rho ^ 2 ≠ 0 :=
    mul_ne_zero (mul_ne_zero hts hlambda.ne')
      (pow_ne_zero 2 (ne_of_gt hrho.1))
  have hbase := hMbound rho hrho lambda t s hnonzero
  have habs : |(t - s) * lambda * rho ^ 2| =
      lambda * rho ^ 2 * |t - s| := by
    rw [abs_mul, abs_mul, abs_of_pos hlambda,
      abs_of_nonneg (sq_nonneg rho)]
    ring
  rw [habs] at hbase
  have hpow : (1 / (lambda * rho ^ 2 * |t - s|)) ^ 2 =
      ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ := by
    rw [one_div, inv_pow]
  rw [hpow] at hbase
  calc
    ‖outerCircleTTStarProductTimeKernel rho lambda t s‖ ≤
        rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ *
          ((2 - (1 / 2 : Real)) * M) := hbase
    _ = ((2 - (1 / 2 : Real)) * M) * rho *
          ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ := by ring

theorem continuous_outerCircleTTStarProductTimeKernel_right
    (rho lambda t : Real) :
    Continuous (fun s => outerCircleTTStarProductTimeKernel rho lambda t s) := by
  let f : Real → Real → Complex := fun s u =>
    outerCircleTTStarProductAmplitude u * Complex.exp
      (((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I))
  have hf : Continuous (Function.uncurry f) := by
    dsimp [f]
    exact
      (contDiff_outerCircleTTStarProductAmplitude.continuous.comp continuous_snd).mul
        (by fun_prop)
  have hparam : Continuous (fun s : Real =>
      ∫ u in Icc (1 / 2 : Real) 2, f s u) :=
    continuous_parametric_integral_of_continuous (μ := volume) hf isCompact_Icc
  have heq : (fun s : Real => ∫ u in (1 / 2 : Real)..2, f s u) =
      fun s : Real => ∫ u in Icc (1 / 2 : Real) 2, f s u := by
    funext s
    rw [intervalIntegral.integral_of_le (by norm_num),
      ← integral_Icc_eq_integral_Ioc]
  unfold outerCircleTTStarProductTimeKernel
  change Continuous (fun s : Real => (rho : Complex) *
    ∫ u in (1 / 2 : Real)..2, f s u)
  apply continuous_const.mul
  rw [heq]
  exact hparam

theorem continuous_outerCircleTTStarProductTimeKernel_left
    (rho lambda s : Real) :
    Continuous (fun t => outerCircleTTStarProductTimeKernel rho lambda t s) := by
  let f : Real → Real → Complex := fun t u =>
    outerCircleTTStarProductAmplitude u * Complex.exp
      (((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I))
  have hf : Continuous (Function.uncurry f) := by
    dsimp [f]
    exact
      (contDiff_outerCircleTTStarProductAmplitude.continuous.comp continuous_snd).mul
        (by fun_prop)
  have hparam : Continuous (fun t : Real =>
      ∫ u in Icc (1 / 2 : Real) 2, f t u) :=
    continuous_parametric_integral_of_continuous (μ := volume) hf isCompact_Icc
  have heq : (fun t : Real => ∫ u in (1 / 2 : Real)..2, f t u) =
      fun t : Real => ∫ u in Icc (1 / 2 : Real) 2, f t u := by
    funext t
    rw [intervalIntegral.integral_of_le (by norm_num),
      ← integral_Icc_eq_integral_Ioc]
  unfold outerCircleTTStarProductTimeKernel
  change Continuous (fun t : Real => (rho : Complex) *
    ∫ u in (1 / 2 : Real)..2, f t u)
  apply continuous_const.mul
  rw [heq]
  exact hparam

theorem intervalIntegrable_outerCircleTTStarProductTimeKernel_right
    (rho lambda t a b : Real) :
    IntervalIntegrable
      (fun s => ‖outerCircleTTStarProductTimeKernel rho lambda t s‖) volume a b :=
  (continuous_outerCircleTTStarProductTimeKernel_right rho lambda t).norm.intervalIntegrable
    (μ := volume) a b

theorem intervalIntegrable_outerCircleTTStarProductTimeKernel_left
    (rho lambda s a b : Real) :
    IntervalIntegrable
      (fun t => ‖outerCircleTTStarProductTimeKernel rho lambda t s‖) volume a b :=
  (continuous_outerCircleTTStarProductTimeKernel_left rho lambda s).norm.intervalIntegrable
    (μ := volume) a b

/-- Continuous Schur rows and columns for the genuine `chi * conj chi`
circle shell kernel.  This is the precise scalar kernel estimate required by
the fixed-frequency `TT*` step. -/
theorem exists_outerCircleTTStarProductTimeKernel_row_column_schur
    {rhoMax a b : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) (hab : a ≤ b) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, 0 < lambda →
        (∀ t : Real,
          (∫ s in a..b, ‖outerCircleTTStarProductTimeKernel rho lambda t s‖) ≤
            (2 * B) * rho * (Real.pi / (lambda * rho ^ 2))) ∧
        (∀ s : Real,
          (∫ t in a..b, ‖outerCircleTTStarProductTimeKernel rho lambda t s‖) ≤
            (2 * B) * rho * (Real.pi / (lambda * rho ^ 2))) := by
  rcases exists_outerCircleTTStarProductTimeKernel_outer_quadratic
      hrhoMax hrhoMax_small with ⟨A, hA, houter⟩
  let B : Real := max (3 / 2 : Real) A
  have hBcentral : (3 / 2 : Real) ≤ B := le_max_left _ _
  have hBouter : A ≤ B := le_max_right _ _
  have hB : 0 < B := lt_of_lt_of_le hA hBouter
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda
  have hrho_pos : 0 < rho := hrho.1
  have hLambda : 0 < lambda * rho ^ 2 :=
    mul_pos hlambda (sq_pos_of_pos hrho_pos)
  have hBrho : 0 ≤ B * rho := mul_nonneg hB.le hrho_pos.le
  constructor
  · intro t
    apply intervalIntegral_norm_le_of_central_outer
      hab hLambda hBrho (outerCircleTTStarProductTimeKernel rho lambda)
      (intervalIntegrable_outerCircleTTStarProductTimeKernel_right rho lambda t a b)
    · intro s hs
      calc
        ‖outerCircleTTStarProductTimeKernel rho lambda t s‖ ≤
            rho * (3 / 2 : Real) :=
          norm_outerCircleTTStarProductTimeKernel_le_central hrho_pos.le
        _ = (3 / 2 : Real) * rho := by ring
        _ ≤ B * rho := mul_le_mul_of_nonneg_right hBcentral hrho_pos.le
    · intro s hs hscale
      calc
        ‖outerCircleTTStarProductTimeKernel rho lambda t s‖ ≤
            A * rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ :=
          houter rho hrho lambda hlambda t s hscale
        _ ≤ B * rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ := by
          apply mul_le_mul_of_nonneg_right
          · exact mul_le_mul_of_nonneg_right hBouter hrho_pos.le
          · exact inv_nonneg.mpr (sq_nonneg _)

  · intro s
    apply intervalIntegral_norm_le_of_central_outer_column
      hab hLambda hBrho (outerCircleTTStarProductTimeKernel rho lambda)
      (intervalIntegrable_outerCircleTTStarProductTimeKernel_left rho lambda s a b)
    · intro t ht
      calc
        ‖outerCircleTTStarProductTimeKernel rho lambda t s‖ ≤
            rho * (3 / 2 : Real) :=
          norm_outerCircleTTStarProductTimeKernel_le_central hrho_pos.le
        _ = (3 / 2 : Real) * rho := by ring
        _ ≤ B * rho := mul_le_mul_of_nonneg_right hBcentral hrho_pos.le
    · intro t ht hscale
      calc
        ‖outerCircleTTStarProductTimeKernel rho lambda t s‖ ≤
            A * rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ :=
          houter rho hrho lambda hlambda t s hscale
        _ ≤ B * rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ := by
          apply mul_le_mul_of_nonneg_right
          · exact mul_le_mul_of_nonneg_right hBouter hrho_pos.le
          · exact inv_nonneg.mpr (sq_nonneg _)

theorem star_outerCircleTTStarProductAmplitude (u : Real) :
    starRingEnd Complex (outerCircleTTStarProductAmplitude u) =
      outerCircleTTStarProductAmplitude u := by
  unfold outerCircleTTStarProductAmplitude fixedOuterCircleUnitShellAmplitude
  simp

/-- The exact complex `TT*` kernel is Hermitian.  Consequently its norm
majorant is a symmetric nonnegative real kernel. -/
theorem outerCircleTTStarProductTimeKernel_swap_eq_star
    (rho lambda t s : Real) :
    outerCircleTTStarProductTimeKernel rho lambda s t =
      starRingEnd Complex (outerCircleTTStarProductTimeKernel rho lambda t s) := by
  unfold outerCircleTTStarProductTimeKernel
  rw [map_mul, Complex.conj_ofReal, ← intervalIntegral.intervalIntegral_conj]
  congr 1
  apply intervalIntegral.integral_congr_ae
  filter_upwards with u
  intro hu
  have hphase :
      (((s - t) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I =
        starRingEnd Complex
          ((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I) := by
    rw [map_mul, Complex.conj_ofReal, Complex.conj_I]
    push_cast
    ring
