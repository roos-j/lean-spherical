    {a b A rho Lambda t : Real} (hab : a ≤ b)
    (hLambda : 0 < Lambda) (hArho : 0 ≤ A * rho)
    (L : Real → Real → Complex)
    (hL_integrable : IntervalIntegrable (fun s => ‖L t s‖) volume a b)
    (hbound : ∀ s ∈ Icc a b,
      ‖L t s‖ ≤ A * rho * quadraticTimeEnvelope Lambda t s) :
    (∫ s in a..b, ‖L t s‖) ≤ A * rho * (Real.pi / Lambda) := by
  have henv_cont : Continuous (fun s : Real =>
      quadraticTimeEnvelope Lambda t s) := by
    unfold quadraticTimeEnvelope
    apply Continuous.inv₀
    · fun_prop
    · intro s
      positivity
  have henv_full_cont : Continuous (fun s : Real =>
      A * rho * quadraticTimeEnvelope Lambda t s) :=
    (continuous_const : Continuous (fun _ : Real => A * rho)).mul henv_cont
  have henv_integrable : IntervalIntegrable (fun s : Real =>
      A * rho * quadraticTimeEnvelope Lambda t s) volume a b :=
    henv_full_cont.intervalIntegrable (μ := volume) a b
