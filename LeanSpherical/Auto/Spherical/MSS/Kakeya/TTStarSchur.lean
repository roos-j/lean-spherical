/-- A continuous inverse-Fourier field is jointly square-integrable on a
compact angular interval as soon as its Schwartz multiplier family has
joint square-integrable frequency energy.  The proof uses slice-wise
Plancherel and `integrable_prod_iff`; it does not assume the desired
physical integrability as an input. -/
theorem integrable_sq_fourierInvParametricField_of_continuous_frequency
    (m : Real -> SchwartzMap (Euclidean 2) Complex) (lo hi : Real)
    (hcont : Continuous (Function.uncurry (fourierInvParametricField m)))
    (hfreq : Integrable (fun p : Real × Euclidean 2 =>
      ‖m p.1 p.2‖ ^ (2 : Nat))
      ((volume.restrict (Icc lo hi)).prod volume)) :
    Integrable (fun p : Real × Euclidean 2 =>
      ‖fourierInvParametricField m p.1 p.2‖ ^ (2 : Nat))
      ((volume.restrict (Icc lo hi)).prod volume) := by
  let μθ : Measure Real := volume.restrict (Icc lo hi)
  let g : Real × Euclidean 2 -> Real := fun p =>
    ‖fourierInvParametricField m p.1 p.2‖ ^ (2 : Nat)
  let f : Real × Euclidean 2 -> Real := fun p => ‖m p.1 p.2‖ ^ (2 : Nat)
  have hgmeas : AEStronglyMeasurable g (μθ.prod volume) := by
    dsimp [g]
    exact (hcont.norm.pow _).aestronglyMeasurable
  have hslice (theta : Real) : Integrable (fun y : Euclidean 2 =>
      g (theta, y)) volume := by
    let M : SchwartzMap (Euclidean 2) Complex := FourierTransform.fourierInv (m theta)
    have hM : MemLp (M : Euclidean 2 -> Complex) 2 volume := M.memLp 2 volume
    have hMint : Integrable (fun y : Euclidean 2 => ‖M y‖ ^ (2 : Nat)) volume :=
      (memLp_two_iff_integrable_sq_norm M.continuous.aestronglyMeasurable).mp hM
    simpa only [g, M, fourierInvParametricField, SchwartzMap.fourierInv_coe] using hMint
  have hfreqNorm : Integrable (fun theta : Real =>
      ∫ xi : Euclidean 2, ‖f (theta, xi)‖) μθ := by
    simpa only [f, μθ] using hfreq.integral_norm_prod_left
  have hpoint (theta : Real) :
      (∫ y : Euclidean 2, ‖g (theta, y)‖) =
        ∫ xi : Euclidean 2, ‖f (theta, xi)‖ := by
    have hplanch := integral_norm_sq_fourierInvParametricField_eq_frequency m theta
    have hg (y : Euclidean 2) : ‖g (theta, y)‖ =
        ‖fourierInvParametricField m theta y‖ ^ (2 : Nat) := by
      dsimp [g]
      exact Real.norm_of_nonneg (sq_nonneg _)
    have hf (xi : Euclidean 2) : ‖f (theta, xi)‖ = ‖m theta xi‖ ^ (2 : Nat) := by
      dsimp [f]
      exact Real.norm_of_nonneg (sq_nonneg _)
    calc
      (∫ y : Euclidean 2, ‖g (theta, y)‖) =
          ∫ y : Euclidean 2, ‖fourierInvParametricField m theta y‖ ^ (2 : Nat) := by
            apply integral_congr_ae
            filter_upwards with y
            exact hg y
      _ = ∫ xi : Euclidean 2, ‖m theta xi‖ ^ (2 : Nat) := hplanch
      _ = ∫ xi : Euclidean 2, ‖f (theta, xi)‖ := by
            apply integral_congr_ae
            filter_upwards with xi
            exact (hf xi).symm
  have hnorm : Integrable (fun theta : Real =>
      ∫ y : Euclidean 2, ‖g (theta, y)‖) μθ := by
    convert hfreqNorm using 1
    funext theta
    exact hpoint theta
  apply (integrable_prod_iff hgmeas).mpr
  constructor
  · exact Filter.Eventually.of_forall hslice
  · exact hnorm

/-- Local version of
`integrable_sq_fourierInvParametricField_of_continuous_frequency`.  The
physical inverse-Fourier field only needs to be continuous on the compact
angular interval being integrated; imposing global continuity in the angular
parameter is artificial for a cutoff shell. -/
theorem integrable_sq_fourierInvParametricField_of_continuousOn_frequency
    (m : Real -> SchwartzMap (Euclidean 2) Complex) (lo hi : Real)
    (hcont : ContinuousOn (Function.uncurry (fourierInvParametricField m))
      ((Icc lo hi) ×ˢ (Set.univ : Set (Euclidean 2))))
    (hfreq : Integrable (fun p : Real × Euclidean 2 =>
      ‖m p.1 p.2‖ ^ (2 : Nat))
      ((volume.restrict (Icc lo hi)).prod volume)) :
    Integrable (fun p : Real × Euclidean 2 =>
      ‖fourierInvParametricField m p.1 p.2‖ ^ (2 : Nat))
      ((volume.restrict (Icc lo hi)).prod volume) := by
  let μθ : Measure Real := volume.restrict (Icc lo hi)
  let g : Real × Euclidean 2 -> Real := fun p =>
    ‖fourierInvParametricField m p.1 p.2‖ ^ (2 : Nat)
  let f : Real × Euclidean 2 -> Real := fun p => ‖m p.1 p.2‖ ^ (2 : Nat)
  have hset : MeasurableSet ((Icc lo hi) ×ˢ (Set.univ : Set (Euclidean 2))) :=
    measurableSet_Icc.prod MeasurableSet.univ
  have hgmeas' : AEStronglyMeasurable g
      ((volume.prod volume).restrict ((Icc lo hi) ×ˢ (Set.univ : Set (Euclidean 2)))) := by
    dsimp [g]
    exact (hcont.norm.pow _).aestronglyMeasurable hset
  have hgmeas : AEStronglyMeasurable g (μθ.prod volume) := by
    simpa only [μθ, Measure.restrict_prod_eq_prod_univ] using hgmeas'
  have hslice (theta : Real) : Integrable (fun y : Euclidean 2 =>
      g (theta, y)) volume := by
    let M : SchwartzMap (Euclidean 2) Complex := FourierTransform.fourierInv (m theta)
    have hM : MemLp (M : Euclidean 2 -> Complex) 2 volume := M.memLp 2 volume
    have hMint : Integrable (fun y : Euclidean 2 => ‖M y‖ ^ (2 : Nat)) volume :=
      (memLp_two_iff_integrable_sq_norm M.continuous.aestronglyMeasurable).mp hM
    simpa only [g, M, fourierInvParametricField, SchwartzMap.fourierInv_coe] using hMint
  have hfreqNorm : Integrable (fun theta : Real =>
      ∫ xi : Euclidean 2, ‖f (theta, xi)‖) μθ := by
    simpa only [f, μθ] using hfreq.integral_norm_prod_left
  have hpoint (theta : Real) :
      (∫ y : Euclidean 2, ‖g (theta, y)‖) =
        ∫ xi : Euclidean 2, ‖f (theta, xi)‖ := by
    have hplanch := integral_norm_sq_fourierInvParametricField_eq_frequency m theta
    have hg (y : Euclidean 2) : ‖g (theta, y)‖ =
        ‖fourierInvParametricField m theta y‖ ^ (2 : Nat) := by
      dsimp [g]
      exact Real.norm_of_nonneg (sq_nonneg _)
    have hf (xi : Euclidean 2) : ‖f (theta, xi)‖ = ‖m theta xi‖ ^ (2 : Nat) := by
      dsimp [f]
      exact Real.norm_of_nonneg (sq_nonneg _)
    calc
      (∫ y : Euclidean 2, ‖g (theta, y)‖) =
          ∫ y : Euclidean 2, ‖fourierInvParametricField m theta y‖ ^ (2 : Nat) := by
            apply integral_congr_ae
            filter_upwards with y
            exact hg y
      _ = ∫ xi : Euclidean 2, ‖m theta xi‖ ^ (2 : Nat) := hplanch
      _ = ∫ xi : Euclidean 2, ‖f (theta, xi)‖ := by
            apply integral_congr_ae
            filter_upwards with xi
            exact (hf xi).symm
  have hnorm : Integrable (fun theta : Real =>
      ∫ y : Euclidean 2, ‖g (theta, y)‖) μθ := by
    convert hfreqNorm using 1
    funext theta
    exact hpoint theta
  apply (integrable_prod_iff hgmeas).mpr
  constructor
  · exact Filter.Eventually.of_forall hslice
  · exact hnorm

/-- Joint square-integrability in frequency follows from joint continuity
and a single compact spatial-frequency support, after restricting the angular
parameter to a compact interval.  This is tailored to charted finite-tensor
multipliers: angular cutoffs do not enlarge the common spatial support. -/
theorem integrable_sq_compactInterval_of_continuous_commonSupport
    (m : Real -> Euclidean 2 -> Complex) (lo hi : Real) (K : Set (Euclidean 2))
    (hcont : Continuous (Function.uncurry m)) (hK : IsCompact K)
    (hsupport : ∀ theta xi, xi ∉ K -> m theta xi = 0) :
    Integrable (fun p : Real × Euclidean 2 => ‖m p.1 p.2‖ ^ (2 : Nat))
      ((volume.restrict (Icc lo hi)).prod volume) := by
  let f : Real × Euclidean 2 -> Real := fun p => ‖m p.1 p.2‖ ^ (2 : Nat)
  have hFcont : Continuous f := by
    dsimp [f]
    exact hcont.norm.pow _
  have hsuppF : Function.support f ⊆ (Set.univ : Set Real) ×ˢ K := by
    intro p hp
    rcases p with ⟨theta, xi⟩
    refine ⟨Set.mem_univ _, ?_⟩
    by_contra hxi
    apply Function.mem_support.mp hp
    dsimp [f]
    rw [hsupport theta xi hxi]
    norm_num
  have hcompact : IsCompact ((Icc lo hi) ×ˢ K) := isCompact_Icc.prod hK
  have hcompactInt : IntegrableOn f ((Icc lo hi) ×ˢ K) (volume.prod volume) :=
    hFcont.continuousOn.integrableOn_compact hcompact
  have hset : MeasurableSet ((Icc lo hi) ×ˢ (Set.univ : Set (Euclidean 2))) :=
    measurableSet_Icc.prod MeasurableSet.univ
  have hinterSubset :
      ((Icc lo hi) ×ˢ (Set.univ : Set (Euclidean 2))) ∩ Function.support f ⊆
        (Icc lo hi) ×ˢ K := by
    intro p hp
    exact ⟨hp.1.1, (hsuppF hp.2).2⟩
  have hinter : IntegrableOn f
      (((Icc lo hi) ×ˢ (Set.univ : Set (Euclidean 2))) ∩ Function.support f)
      (volume.prod volume) := hcompactInt.mono_set hinterSubset
  have hrestricted : IntegrableOn f
      ((Icc lo hi) ×ˢ (Set.univ : Set (Euclidean 2))) (volume.prod volume) :=
    IntegrableOn.of_inter_support hset hinter
  simpa only [f, Measure.restrict_prod_eq_prod_univ, IntegrableOn] using hrestricted

end

