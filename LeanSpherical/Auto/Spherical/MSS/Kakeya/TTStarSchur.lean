    g rho lambda u t s

/-- Exact all-time `TT*` factorization for a joint carrier/coordinate lobe
profile.  This is the direct analytic interface for a shifted smooth
partition preweight. -/
theorem outerCircleParametricRealProfileFourierCharAnalysis_ttstar_factorization
    (g : Real × Real -> Real) (rho lambda : Real) (H : Real -> Complex)
    (hpoint : ∀ u : Real, Integrable (fun t : Real =>
      outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u t * H t) volume)
    (hpointStar : ∀ u : Real, Integrable (fun s : Real =>
      starRingEnd Complex
        (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u s * H s)) volume)
    (htriple : Integrable (Function.uncurry fun u (p : Real × Real) =>
      (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u p.1 * H p.1) *
        starRingEnd Complex
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u p.2 * H p.2))
      ((volume.restrict (Ioc (1 / 2 : Real) 2)).prod (volume.prod volume)))
    (hkernel : ∀ t s : Real, Integrable (fun u : Real =>
      outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u t *
        starRingEnd Complex
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u s))
      (volume.restrict (Ioc (1 / 2 : Real) 2)))
    (hrhs : Integrable (Function.uncurry fun t s =>
      ttstarKernel (volume.restrict (Ioc (1 / 2 : Real) 2))
        (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) t s * H t *
          starRingEnd Complex (H s)) (volume.prod volume)) :
    (rho : Complex) *
      ∫ u : Real,
        ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u *
          starRingEnd Complex
            (ttstarAnalysis volume
              (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u)
        ∂(volume.restrict (Ioc (1 / 2 : Real) 2)) =
      ∫ t : Real, ∫ s : Real,
        outerCircleProfileFourierCharProductKernel
          (outerCircleParametricRealProfileProductAmplitude g) rho lambda t s * H t *
          starRingEnd Complex (H s) := by
  have hbase := ttstar_factorization
    (volume.restrict (Ioc (1 / 2 : Real) 2)) volume
    (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H
    hpoint hpointStar htriple hkernel hrhs
  calc
    (rho : Complex) *
        ∫ u : Real,
          ttstarAnalysis volume
            (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u *
            starRingEnd Complex
              (ttstarAnalysis volume
                (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u)
          ∂(volume.restrict (Ioc (1 / 2 : Real) 2)) =
        (rho : Complex) *
          ∫ t : Real, ∫ s : Real,
            ttstarKernel (volume.restrict (Ioc (1 / 2 : Real) 2))
              (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) t s * H t *
                starRingEnd Complex (H s) := by rw [hbase]
    _ = ∫ t : Real, ∫ s : Real,
        ((rho : Complex) *
          ttstarKernel (volume.restrict (Ioc (1 / 2 : Real) 2))
            (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) t s) * H t *
              starRingEnd Complex (H s) := by
        rw [← integral_const_mul]
        apply integral_congr_ae
        filter_upwards with t
        rw [← integral_const_mul]
        apply integral_congr_ae
        filter_upwards with s
        ring
    _ = ∫ t : Real, ∫ s : Real,
        outerCircleProfileFourierCharProductKernel
          (outerCircleParametricRealProfileProductAmplitude g) rho lambda t s * H t *
          starRingEnd Complex (H s) := by
        apply integral_congr_ae
        filter_upwards with t
        apply integral_congr_ae
        filter_upwards with s
        rw [outerCircleParametricRealProfileFourierCharAnalysis_ttstarKernel_eq]

/-- Finite Schwartz-tensor form of the parametric lobe `TT*` identity. -/
theorem outerShellFiniteTensor_parametricRealProfile_localized_ttstar_factorization
    {ι : Type*} (s0 : Finset ι)
    (q : ι -> SchwartzMap (Euclidean 2) Complex)
    (a : ι -> SchwartzMap Real Complex)
    (g : Real × Real -> Real) (alpha rho lambda : Real)
    (hpoint : ∀ u : Real, Integrable (fun t : Real =>
      outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u t *
        outerShellFiniteTensorTimeData s0 q a alpha lambda t) volume)
    (hpointStar : ∀ u : Real, Integrable (fun s : Real =>
      starRingEnd Complex
        (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u s *
          outerShellFiniteTensorTimeData s0 q a alpha lambda s)) volume)
    (htriple : Integrable (Function.uncurry fun u (p : Real × Real) =>
      (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u p.1 *
        outerShellFiniteTensorTimeData s0 q a alpha lambda p.1) *
        starRingEnd Complex
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u p.2 *
            outerShellFiniteTensorTimeData s0 q a alpha lambda p.2))
      ((volume.restrict (Ioc (1 / 2 : Real) 2)).prod (volume.prod volume)))
    (hkernel : ∀ t s : Real, Integrable (fun u : Real =>
      outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u t *
        starRingEnd Complex
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u s))
      (volume.restrict (Ioc (1 / 2 : Real) 2)))
    (hrhs : Integrable (Function.uncurry fun t s =>
      ttstarKernel (volume.restrict (Ioc (1 / 2 : Real) 2))
        (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) t s *
          outerShellFiniteTensorTimeData s0 q a alpha lambda t *
            starRingEnd Complex
              (outerShellFiniteTensorTimeData s0 q a alpha lambda s))
      (volume.prod volume)) :
    (rho : Complex) *
      ∫ u : Real,
        ((g (rho, u) : Complex) *
          outerShellFiniteTensorAnalysis s0 q a alpha rho lambda u) *
          starRingEnd Complex
            ((g (rho, u) : Complex) *
              outerShellFiniteTensorAnalysis s0 q a alpha rho lambda u)
        ∂(volume.restrict (Ioc (1 / 2 : Real) 2)) =
      ∫ t : Real, ∫ s : Real,
        outerCircleProfileFourierCharProductKernel
          (outerCircleParametricRealProfileProductAmplitude g) rho lambda t s *
          outerShellFiniteTensorTimeData s0 q a alpha lambda t *
            starRingEnd Complex
              (outerShellFiniteTensorTimeData s0 q a alpha lambda s) := by
  have hbase := outerCircleParametricRealProfileFourierCharAnalysis_ttstar_factorization
    g rho lambda (outerShellFiniteTensorTimeData s0 q a alpha lambda)
    hpoint hpointStar htriple hkernel hrhs
  calc
    (rho : Complex) *
        ∫ u : Real,
          ((g (rho, u) : Complex) *
            outerShellFiniteTensorAnalysis s0 q a alpha rho lambda u) *
            starRingEnd Complex
              ((g (rho, u) : Complex) *
                outerShellFiniteTensorAnalysis s0 q a alpha rho lambda u)
          ∂(volume.restrict (Ioc (1 / 2 : Real) 2)) =
        (rho : Complex) *
          ∫ u : Real,
            ttstarAnalysis volume
              (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)
              (outerShellFiniteTensorTimeData s0 q a alpha lambda) u *
              starRingEnd Complex
                (ttstarAnalysis volume
                  (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)
                  (outerShellFiniteTensorTimeData s0 q a alpha lambda) u)
            ∂(volume.restrict (Ioc (1 / 2 : Real) 2)) := by
          congr 1
          apply integral_congr_ae
          filter_upwards with u
          rw [ttstarAnalysis_outerCircleParametricRealProfileFourierChar_eq_localizedFiniteTensor]
    _ = _ := hbase

end

end Auto.Spherical.MSS
