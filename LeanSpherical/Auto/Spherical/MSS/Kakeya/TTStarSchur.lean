section Auto.Spherical.MSS

open Filter MeasureTheory FourierTransform Set
open Auto.Spherical.SurfaceMeasureDecay
open SmoothAngularFrequencyChartFamily
open scoped BigOperators FourierTransform EuclideanSpace

noncomputable section

/-- The canonical compact-Schwartz realization of each raw shifted multiplier
slice.  Its coercion is definitionally the literal multiplier. -/
noncomputable def shiftedChartedCappedTelescopingMultiplierSlice
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex)
    (eps : Real) (K n i : Nat) (theta : Real) :
    SchwartzMap (Euclidean 2) Complex :=
  (hasCompactSupport_shiftedChartedCappedTelescopingMultiplier_slice
    C j s q hqcompact a eps K n i theta).toSchwartzMap
      (contDiff_shiftedChartedCappedTelescopingMultiplier_slice
        C j s q hqcompact a eps K n i theta)

theorem shiftedChartedCappedTelescopingMultiplierSlice_apply
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex)
    (eps : Real) (K n i : Nat) (theta : Real) (xi : Euclidean 2) :
    shiftedChartedCappedTelescopingMultiplierSlice C j s q hqcompact a eps K n i theta xi =
      shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n i theta xi := rfl

/-- The canonical compact-Schwartz realization of each raw angular derivative
multiplier slice. -/
noncomputable def shiftedChartedCappedTelescopingMultiplierDerivSlice
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex)
    (eps : Real) (K n i : Nat) (theta : Real) :
    SchwartzMap (Euclidean 2) Complex :=
  (hasCompactSupport_shiftedChartedCappedTelescopingMultiplierDerivRaw_slice
    C j s q hqcompact a eps K n i theta).toSchwartzMap
      (contDiff_shiftedChartedCappedTelescopingMultiplierDerivRaw_slice
        C j s q hqcompact a eps K n i theta)

theorem shiftedChartedCappedTelescopingMultiplierDerivSlice_apply
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex)
    (eps : Real) (K n i : Nat) (theta : Real) (xi : Euclidean 2) :
    shiftedChartedCappedTelescopingMultiplierDerivSlice C j s q hqcompact a eps K n i theta xi =
      shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n i theta xi := rfl

/-- The literal shifted field and its literal derivative admit a fully
concrete `ShiftedCappedShellSchwartzSlices` record once the two inverse-Fourier
families are continuous on the compact angular interval.  All four
integrability fields are derived, not postulated. -/
noncomputable def shiftedChartedCappedTelescopingSchwartzSlices
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex)
    (eps : Real) (K n i : Nat) (lo hi : Real)
    (hFcont : ContinuousOn (Function.uncurry
      (fourierInvParametricField
        (shiftedChartedCappedTelescopingMultiplierSlice C j s q hqcompact a eps K n i)))
      ((Icc lo hi) ×ˢ (Set.univ : Set (Euclidean 2))))
    (hDcont : ContinuousOn (Function.uncurry
      (fourierInvParametricField
        (shiftedChartedCappedTelescopingMultiplierDerivSlice C j s q hqcompact a eps K n i)))
      ((Icc lo hi) ×ˢ (Set.univ : Set (Euclidean 2)))) :
    ShiftedCappedShellSchwartzSlices C j s q hqcompact a eps K n i lo hi where
  multiplier := shiftedChartedCappedTelescopingMultiplierSlice C j s q hqcompact a eps K n i
  multiplierDeriv := shiftedChartedCappedTelescopingMultiplierDerivSlice
    C j s q hqcompact a eps K n i
  field_eq := by
    intro theta y
    unfold shiftedChartedCappedTelescopingField fourierInvParametricField
    apply congrArg (fun f : Euclidean 2 → Complex => FourierTransform.fourierInv f y)
    funext xi
    exact (shiftedChartedCappedTelescopingMultiplierSlice_apply
      C j s q hqcompact a eps K n i theta xi).symm
  fieldDeriv_eq := by
    intro theta y
    unfold shiftedChartedCappedTelescopingFieldDeriv
      angularCutoffFiniteTensorShellFieldDeriv fourierInvParametricField
    apply congrArg (fun f : Euclidean 2 → Complex => FourierTransform.fourierInv f y)
    funext xi
    exact (shiftedChartedCappedTelescopingMultiplierDerivSlice_apply
      C j s q hqcompact a eps K n i theta xi).symm
  physical_integrable :=
    integrable_sq_fourierInvParametricField_of_continuousOn_frequency
      (shiftedChartedCappedTelescopingMultiplierSlice C j s q hqcompact a eps K n i)
      lo hi hFcont (by
        simpa only [shiftedChartedCappedTelescopingMultiplierSlice_apply] using
          (integrable_sq_shiftedChartedCappedTelescopingMultiplier_frequency
            C j s q hqcompact a eps K n i lo hi))
  physicalDeriv_integrable :=
    integrable_sq_fourierInvParametricField_of_continuousOn_frequency
      (shiftedChartedCappedTelescopingMultiplierDerivSlice C j s q hqcompact a eps K n i)
      lo hi hDcont (by
        simpa only [shiftedChartedCappedTelescopingMultiplierDerivSlice_apply] using
          (integrable_sq_shiftedChartedCappedTelescopingMultiplierDerivRaw_frequency
            C j s q hqcompact a eps K n i lo hi))
  frequency_integrable := by
    simpa only [shiftedChartedCappedTelescopingMultiplierSlice_apply] using
      (integrable_sq_shiftedChartedCappedTelescopingMultiplier_frequency
        C j s q hqcompact a eps K n i lo hi)
  frequencyDeriv_integrable := by
    simpa only [shiftedChartedCappedTelescopingMultiplierDerivSlice_apply] using
      (integrable_sq_shiftedChartedCappedTelescopingMultiplierDerivRaw_frequency
        C j s q hqcompact a eps K n i lo hi)

/-- Fully concrete slice-Schwartz transport for one shifted chart/shell.
The local inverse-Fourier continuity hypotheses are obtained from the raw
joint continuity and the common compact frequency support, so no Fubini or
integrability witness remains in this record. -/
noncomputable def shiftedChartedCappedTelescopingSchwartzSlices_concrete
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex)
    (eps : Real) (K n i : Nat) (lo hi : Real) :
    ShiftedCappedShellSchwartzSlices C j s q hqcompact a eps K n i lo hi := by
  let m := shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n i
  let dm := shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n i
  let support := shiftedChartedFrequencySupport C j s q
  have hmcont : Continuous (Function.uncurry m) :=
    continuous_uncurry_shiftedChartedCappedTelescopingMultiplier
      C j s q hqcompact a eps K n i
  have hdmcont : Continuous (Function.uncurry dm) :=
    continuous_uncurry_shiftedChartedCappedTelescopingMultiplierDerivRaw
      C j s q hqcompact a eps K n i
  have hsupportcompact : IsCompact support :=
    isCompact_shiftedChartedFrequencySupport C j s q hqcompact
  have hmsupport : ∀ theta xi, xi ∉ support -> m theta xi = 0 :=
    shiftedChartedCappedTelescopingMultiplier_eq_zero_of_not_mem_support
      C j s q hqcompact a eps K n i
  have hdmsupport : ∀ theta xi, xi ∉ support -> dm theta xi = 0 :=
    shiftedChartedCappedTelescopingMultiplierDerivRaw_eq_zero_of_not_mem_support
      C j s q hqcompact a eps K n i
  have hFraw : ContinuousOn (Function.uncurry (fun theta y =>
      FourierTransform.fourierInv (m theta : Euclidean 2 → Complex) y))
      ((Icc lo hi) ×ˢ (Set.univ : Set (Euclidean 2))) :=
    continuousOn_uncurry_fourierInv_of_continuous_commonSupport
      m lo hi support hmcont hsupportcompact hmsupport
  have hDraw : ContinuousOn (Function.uncurry (fun theta y =>
      FourierTransform.fourierInv (dm theta : Euclidean 2 → Complex) y))
      ((Icc lo hi) ×ˢ (Set.univ : Set (Euclidean 2))) :=
    continuousOn_uncurry_fourierInv_of_continuous_commonSupport
      dm lo hi support hdmcont hsupportcompact hdmsupport
  apply shiftedChartedCappedTelescopingSchwartzSlices C j s q hqcompact a eps K n i lo hi
  · convert hFraw using 1
    ext p
    unfold Function.uncurry fourierInvParametricField
    apply congrArg (fun f : Euclidean 2 → Complex => FourierTransform.fourierInv f p.2)
    funext xi
    exact shiftedChartedCappedTelescopingMultiplierSlice_apply
      C j s q hqcompact a eps K n i p.1 xi
  · convert hDraw using 1
    ext p
    unfold Function.uncurry fourierInvParametricField
    apply congrArg (fun f : Euclidean 2 → Complex => FourierTransform.fourierInv f p.2)
    funext xi
    exact shiftedChartedCappedTelescopingMultiplierDerivSlice_apply
      C j s q hqcompact a eps K n i p.1 xi

end

end Auto.Spherical.MSS
end
