/-- Exact factorization of the parametric analysis amplitude at one angular
coordinate. -/
theorem outerCircleParametricRealProfileFourierCharAnalysisAmplitude_ttstar_integrand
    (g : Real × Real -> Real) (rho lambda u t s : Real) :
    outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u t *
        starRingEnd Complex
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u s) =
      outerCircleParametricRealProfileProductAmplitude g (rho, u) *
        (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex) := by
  unfold outerCircleParametricRealProfileFourierCharAnalysisAmplitude
    outerCircleParametricRealProfileProductAmplitude
  change
    ((g (rho, u) : Complex) *
      (Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex)) *
        starRingEnd Complex
          ((g (rho, u) : Complex) *
            (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex)) =
      ((g (rho, u)) ^ 2 : Real) *
        (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex)
  have hstar :
      starRingEnd Complex
          ((g (rho, u) : Complex) *
            (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex)) =
        starRingEnd Complex (g (rho, u) : Complex) *
          starRingEnd Complex
            (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex) := by
    exact (starRingEnd Complex).map_mul _ _
  rw [hstar]
  have hphase :
      (Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex) *
          starRingEnd Complex
            (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex) =
        (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex) := by
    simp only [Real.fourierChar_apply]
    rw [← Complex.exp_conj]
    simp only [map_mul, Complex.conj_ofReal, Complex.conj_I]
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  calc
    ((g (rho, u) : Complex) *
        (Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex)) *
        (starRingEnd Complex (g (rho, u) : Complex) *
          starRingEnd Complex
            (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex)) =
        ((g (rho, u) : Complex) * starRingEnd Complex (g (rho, u) : Complex)) *
          ((Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex) *
            starRingEnd Complex
              (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex)) := by
          ring
    _ = ((g (rho, u)) ^ 2 : Real) *
          ((Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex) *
            starRingEnd Complex
              (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex)) := by
          simp only [Complex.conj_ofReal]
          push_cast
          ring
    _ = _ := by rw [hphase]

/-- The angular kernel of the parametric real-lobe analysis map is exactly
the generic joint-amplitude Fourier-character kernel. -/
theorem outerCircleParametricRealProfileFourierCharAnalysis_ttstarKernel_eq
    (g : Real × Real -> Real) (rho lambda t s : Real) :
    (rho : Complex) *
