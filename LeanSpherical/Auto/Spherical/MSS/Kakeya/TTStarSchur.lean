      hHcont.comp (continuous_fst.comp continuous_snd)
    have hHs : Continuous (fun p : Real × (Real × Real) => H p.2.2) :=
      hHcont.comp (continuous_snd.comp continuous_snd)
    change Continuous (fun p : Real × (Real × Real) =>
      (A p.1 p.2.1 * H p.2.1) * star (A p.1 p.2.2 * H p.2.2))
    exact (hAt.mul hHt).mul (hAs.mul hHs).star
  have hkernel : ∀ t s : Real, Integrable (fun u : Real =>
      A u t * starRingEnd Complex (A u s)) μu := by
    intro t s
    apply integrable_restrict_Icc_of_continuous
    change Continuous (fun u : Real => A u t * star (A u s))
    have hAt : Continuous (fun u : Real => A u t) :=
      hAcont.comp (continuous_id.prodMk continuous_const)
    have hAs : Continuous (fun u : Real => A u s) :=
      hAcont.comp (continuous_id.prodMk continuous_const)
    exact hAt.mul hAs.star
  have hkernelCont : Continuous (fun p : Real × Real =>
      ttstarKernel μu A p.1 p.2) := by
    let G : (Real × Real) → Real → Complex := fun p u =>
      A u p.1 * starRingEnd Complex (A u p.2)
    have hG : Continuous (Function.uncurry G) := by
      have hGt : Continuous (fun q : (Real × Real) × Real => A q.2 q.1.1) :=
        hAcont.comp (continuous_snd.prodMk (continuous_fst.comp continuous_fst))
      have hGs : Continuous (fun q : (Real × Real) × Real => A q.2 q.1.2) :=
        hAcont.comp (continuous_snd.prodMk (continuous_snd.comp continuous_fst))
      change Continuous (fun q : (Real × Real) × Real =>
        A q.2 q.1.1 * star (A q.2 q.1.2))
      exact hGt.mul hGs.star
    have hparam : Continuous (fun p : Real × Real =>
        ∫ u in Icc u0 u1, G p u) :=
      continuous_parametric_integral_of_continuous (μ := volume) hG isCompact_Icc
    change Continuous (fun p : Real × Real =>
      ∫ u in Icc u0 u1, A u p.1 * star (A u p.2))
    exact hparam
  have hrhs : Integrable (Function.uncurry fun t s =>
      ttstarKernel μu A t s * H t * starRingEnd Complex (H s)) (μt.prod μt) := by
    apply integrable_restrict_Icc_prod_of_continuous
    change Continuous (fun p : Real × Real =>
      ttstarKernel μu A p.1 p.2 * H p.1 * star (H p.2))
    exact (hkernelCont.mul (hHcont.comp continuous_fst)).mul
      ((hHcont.comp continuous_snd).star)
  exact ttstar_factorization μu μt A H hpoint hpointStar htriple hkernel hrhs

/-- Compact time restriction turns the ordinary symmetric Schur calculation
into a completely Fubini-free interface: every quadratic product needed by
the Bochner proof is supplied from joint continuity on `Icc a b`. -/
theorem norm_integral_integral_restrict_Icc_le_of_symmetricSchur
    {a b R : Real} (L : Real → Real → Complex)
    (hLcont : Continuous (Function.uncurry L))
    (hLsymm : ∀ t s : Real, ‖L t s‖ = ‖L s t‖)
    (hrowbound : ∀ t : Real,
      (∫ s : Real, ‖L t s‖ ∂(volume.restrict (Icc a b))) ≤ R)
    (H : Real → Complex) (hHcont : Continuous H) :
    ‖∫ t : Real, ∫ s : Real, L t s * H t * starRingEnd Complex (H s)
      ∂(volume.restrict (Icc a b)) ∂(volume.restrict (Icc a b))‖ ≤
      R * ∫ t : Real, ‖H t‖ ^ (2 : Nat) ∂(volume.restrict (Icc a b)) := by
  let μ : Measure Real := volume.restrict (Icc a b)
  have hrow : ∀ t : Real, Integrable (fun s : Real => ‖L t s‖) μ := by
    intro t
    apply integrable_restrict_Icc_of_continuous
    exact hLcont.comp (continuous_const.prodMk continuous_id) |>.norm
  have hHsq : Integrable (fun t : Real => ‖H t‖ ^ (2 : Nat)) μ := by
    apply integrable_restrict_Icc_of_continuous
    exact hHcont.norm.pow 2
  have hLnorm : Continuous (fun p : Real × Real => ‖L p.1 p.2‖) := hLcont.norm
  have hHfstNorm : Continuous (fun p : Real × Real => ‖H p.1‖) :=
    hHcont.norm.comp continuous_fst
  have hHsndNorm : Continuous (fun p : Real × Real => ‖H p.2‖) :=
    hHcont.norm.comp continuous_snd
  have hquad : Integrable (fun p : Real × Real =>
      ‖L p.1 p.2‖ * ‖H p.1‖ * ‖H p.2‖) (μ.prod μ) := by
    apply integrable_restrict_Icc_prod_of_continuous
    exact (hLnorm.mul hHfstNorm).mul hHsndNorm
  have hleft : Integrable (fun p : Real × Real =>
      ‖L p.1 p.2‖ * ‖H p.1‖ ^ (2 : Nat)) (μ.prod μ) := by
    apply integrable_restrict_Icc_prod_of_continuous
    exact hLnorm.mul (hHfstNorm.pow 2)
  have hright : Integrable (fun p : Real × Real =>
      ‖L p.1 p.2‖ * ‖H p.2‖ ^ (2 : Nat)) (μ.prod μ) := by
    apply integrable_restrict_Icc_prod_of_continuous
    exact hLnorm.mul (hHsndNorm.pow 2)
  have hcomplex : Integrable (fun p : Real × Real =>
      L p.1 p.2 * H p.1 * starRingEnd Complex (H p.2)) (μ.prod μ) := by
    apply integrable_restrict_Icc_prod_of_continuous
    exact (hLcont.mul (hHcont.comp continuous_fst)).mul
      ((hHcont.comp continuous_snd).star)
  have hschur := aux_kernelQuadratic_le_of_symmetricSchur μ
    (fun t s : Real => ‖L t s‖) R
    (fun t s => norm_nonneg _) hLsymm hrow hrowbound
    (fun t : Real => ‖H t‖) hHsq hquad hleft hright
  calc
    ‖∫ t : Real, ∫ s : Real, L t s * H t * starRingEnd Complex (H s)
        ∂μ ∂μ‖ =
        ‖∫ p : Real × Real,
          L p.1 p.2 * H p.1 * starRingEnd Complex (H p.2) ∂(μ.prod μ)‖ := by
          rw [integral_integral hcomplex]
    _ ≤ ∫ p : Real × Real,
        ‖L p.1 p.2 * H p.1 * starRingEnd Complex (H p.2)‖ ∂(μ.prod μ) :=
      norm_integral_le_integral_norm _
    _ = ∫ p : Real × Real,
        ‖L p.1 p.2‖ * ‖H p.1‖ * ‖H p.2‖ ∂(μ.prod μ) := by
          apply integral_congr_ae
          filter_upwards with p
          rw [norm_mul, norm_mul, starRingEnd_apply, norm_star]
    _ = ∫ t : Real, ∫ s : Real,
        ‖L t s‖ * ‖H t‖ * ‖H s‖ ∂μ ∂μ := by
          rw [integral_prod _ hquad]
    _ ≤ R * ∫ t : Real, ‖H t‖ ^ (2 : Nat) ∂μ := hschur

end

