    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (omega xi : Euclidean 2) :
    scratch_finiteTensorTubeMultiplier s q hqcompact a omega xi =
      (FourierTransform.fourier (finiteTensorTimeSchwartz s q a xi) :
        SchwartzMap Real Complex) (inner Real omega xi) := by
  rw [scratch_finiteTensorTubeMultiplier_apply]
  unfold finiteTensorTimeSchwartz
  rw [FourierTransform.fourier_sum, SchwartzMap.sum_apply]
  apply Finset.sum_congr rfl
  intro i hi
  rw [FourierTransform.fourier_smul, SchwartzMap.smul_apply]
  simp only [smul_eq_mul]

private theorem hasDerivAt_finiteTensorTubeMultiplier_circle_via_timeSchwartz
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (theta : Real) (xi : Euclidean 2) :
    HasDerivAt
      (fun r => scratch_finiteTensorTubeMultiplier s q hqcompact a
        (circleDirection r) xi)
      ((inner Real (circleDirectionDeriv theta) xi) •
        FourierTransform.fourier
          (fun t : Real => (-2 * (Real.pi : Complex) * Complex.I * (t : Complex)) •
            finiteTensorTimeSchwartz s q a xi t)
          (inner Real (circleDirection theta) xi)) theta := by
  let A : SchwartzMap Real Complex := finiteTensorTimeSchwartz s q a xi
  have hA : Integrable (A : Real → Complex) volume := A.integrable
  have hAt : Integrable (fun t : Real => t • (A : Real → Complex) t) volume := by
    have hmajor : Integrable (fun t : Real => |t| * ‖A t‖) volume := by
      simpa using A.integrable_pow_mul_iteratedFDeriv volume 1 0
    refine hmajor.mono'
      ((continuous_id.smul A.continuous).aestronglyMeasurable) ?_
    filter_upwards with t
    rw [norm_smul, Real.norm_eq_abs]
  have hfourier := Real.hasDerivAt_fourier hA hAt
    (inner Real (circleDirection theta) xi)
  have hcomp := hfourier.hasFDerivAt.comp theta
    (hasDerivAt_circlePhase xi theta).hasFDerivAt
  have hraw : HasDerivAt
      (fun r => FourierTransform.fourier (A : Real → Complex)
        (inner Real (circleDirection r) xi))
      ((inner Real (circleDirectionDeriv theta) xi) •
        FourierTransform.fourier
          (fun t : Real => (-2 * (Real.pi : Complex) * Complex.I * (t : Complex)) •
            A t)
          (inner Real (circleDirection theta) xi)) theta := by
    change HasDerivAt
      ((FourierTransform.fourier (A : Real → Complex)) ∘
        fun r => inner Real (circleDirection r) xi) _ theta
    simpa only [Function.comp_apply, ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.toSpanSingleton_apply, one_smul] using hcomp.hasDerivAt
  have hraw' : HasDerivAt
      (fun r => (FourierTransform.fourier A : SchwartzMap Real Complex)
        (inner Real (circleDirection r) xi))
      ((inner Real (circleDirectionDeriv theta) xi) •
        FourierTransform.fourier
          (fun t : Real => (-2 * (Real.pi : Complex) * Complex.I * (t : Complex)) •
            A t)
          (inner Real (circleDirection theta) xi)) theta := by
    rw [SchwartzMap.fourier_coe]
    exact hraw
  simpa only [A, scratch_finiteTensorTubeMultiplier_eq_fourier_timeSchwartz]
    using hraw'

/-- The finite-tensor angular multiplier derivative is exactly the Fourier
transform of the compact-time datum weighted by the differentiated phase. -/
theorem finiteTensorTubeMultiplierAngularDeriv_eq_weighted_timeFourier
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (theta : Real) (xi : Euclidean 2) :
    finiteTensorTubeMultiplierAngularDeriv s q a theta xi =
      ((inner Real (circleDirectionDeriv theta) xi) •
        FourierTransform.fourier
          (fun t : Real => (-2 * (Real.pi : Complex) * Complex.I * (t : Complex)) •
            finiteTensorTimeSchwartz s q a xi t)
          (inner Real (circleDirection theta) xi)) := by
  exact (hasDerivAt_scratch_finiteTensorTubeMultiplier_apply_circle
    s q hqcompact a theta xi).unique
    (hasDerivAt_finiteTensorTubeMultiplier_circle_via_timeSchwartz
      s q hqcompact a theta xi)

private theorem norm_neg_two_pi_I :
    ‖(-2 * (Real.pi : Complex) * Complex.I)‖ = 2 * Real.pi := by
  rw [norm_mul, norm_mul, norm_neg, Complex.norm_real, Complex.norm_I,
    Real.norm_eq_abs, abs_of_nonneg (by positivity : 0 ≤ Real.pi)]
  norm_num

/-- Pointwise compact-time trace control for the literal angular derivative.
All tensor cross terms remain inside the time energy on the right. -/
theorem norm_sq_finiteTensorTubeMultiplierAngularDeriv_le_compactTimeEnergy
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    {r : Real} (hr : r < 1)
    (ha : ∀ i, Function.support (a i : Real → Complex) ⊆
      closedBall (3 / 2 : Real) r)
    (theta : Real) (xi : Euclidean 2) :
    ‖finiteTensorTubeMultiplierAngularDeriv s q a theta xi‖ ^ 2 ≤
      (50 * Real.pi ^ 2) * ‖xi‖ ^ 2 *
        ∫ t : Real, ‖scratch_finiteTensorTimeData s q a xi t‖ ^ 2 := by
  let H : Real → Complex := scratch_finiteTensorTimeData s q a xi
  let c : Complex := -2 * (Real.pi : Complex) * Complex.I
  let W : Real → Complex := fun t =>
    scratch_lightRayTimePhase (circleDirection theta) xi t *
      (c * timeWeighted H t)
  have hHsq : Integrable (fun t : Real => ‖H t‖ ^ 2) volume := by
    dsimp [H]
    exact integrable_sq_scratch_finiteTensorTimeData s q a xi
  have htw :=
    integrable_norm_sq_timeWeighted_scratch_finiteTensorTimeData_and_integral_le
      s q a xi hr ha hHsq
  have htwcont : Continuous (timeWeighted H) := by
    unfold timeWeighted
    exact (Complex.continuous_ofReal.comp continuous_id).mul
      (by simpa only [H] using continuous_scratch_finiteTensorTimeData s q a xi)
  have hWcont : Continuous W := by
    dsimp [W]
    have hphase : Continuous (scratch_lightRayTimePhase
        (circleDirection theta) xi) := by
      unfold scratch_lightRayTimePhase
      fun_prop
    exact hphase.mul (continuous_const.mul htwcont)
  have hWsupport : Function.support W ⊆ finiteCoreTimeSlab := by
    intro t ht
    apply support_scratch_finiteTensorTimeData_subset_finiteCoreTimeSlab
      s q a xi hr ha
    by_contra hdata
    have hzero : H t = 0 := by
      by_contra hne
      exact hdata (Function.mem_support.mpr hne)
    exact ht (by simp [W, timeWeighted, hzero])
  have hc : ‖c‖ = 2 * Real.pi := by
    dsimp [c]
    exact norm_neg_two_pi_I
  have hWpoint (t : Real) : ‖W t‖ ^ 2 =
      (2 * Real.pi) ^ 2 * ‖timeWeighted H t‖ ^ 2 := by
    dsimp [W]
    rw [norm_mul, norm_mul, hc]
    unfold scratch_lightRayTimePhase
    simp only [Circle.norm_coe, one_mul]
    ring
  have hWint :
      (∫ t : Real, ‖W t‖ ^ 2) =
        (2 * Real.pi) ^ 2 * ∫ t : Real, ‖timeWeighted H t‖ ^ 2 := by
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with t
    exact hWpoint t
  have hWsq : Integrable (fun t : Real => ‖W t‖ ^ 2) volume := by
    apply (htw.1.const_mul _).congr
    filter_upwards with t
    exact (hWpoint t).symm
  have htrace :=
    norm_sq_integral_le_two_mul_integral_norm_sq_of_support_finiteCoreTimeSlab
      W hWcont.aestronglyMeasurable hWsq hWsupport
  have hfourier :
      FourierTransform.fourier
        (fun t : Real => (-2 * (Real.pi : Complex) * Complex.I * (t : Complex)) •
          finiteTensorTimeSchwartz s q a xi t)
        (inner Real (circleDirection theta) xi) =
        ∫ t : Real, W t := by
    rw [Real.fourier_eq]
    apply integral_congr_ae
    filter_upwards with t
    dsimp [W, c, H]
    rw [finiteTensorTimeSchwartz_apply]
    unfold scratch_lightRayTimePhase timeWeighted
    simp only [Circle.smul_def, smul_eq_mul, starRingEnd_apply, star_trivial,
      Real.inner_apply]
    ring
  have hident : finiteTensorTubeMultiplierAngularDeriv s q a theta xi =
      (inner Real (circleDirectionDeriv theta) xi) • ∫ t : Real, W t := by
    rw [finiteTensorTubeMultiplierAngularDeriv_eq_weighted_timeFourier
      s q hqcompact a theta xi, hfourier]
  have hv : ‖inner Real (circleDirectionDeriv theta) xi‖ ≤ ‖xi‖ := by
    rw [Real.norm_eq_abs]
    calc
      |inner Real (circleDirectionDeriv theta) xi| ≤
          ‖circleDirectionDeriv theta‖ * ‖xi‖ :=
        abs_real_inner_le_norm _ _
      _ = ‖xi‖ := by rw [norm_circleDirectionDeriv, one_mul]
  have hnorm : ‖finiteTensorTubeMultiplierAngularDeriv s q a theta xi‖ ≤
      ‖xi‖ * ‖∫ t : Real, W t‖ := by
    rw [hident, norm_smul]
    exact mul_le_mul_of_nonneg_right hv (norm_nonneg _)
  have hrightnonneg : 0 ≤ ‖xi‖ * ‖∫ t : Real, W t‖ :=
    mul_nonneg (norm_nonneg _) (norm_nonneg _)
  have hsq := (sq_le_sq₀ (norm_nonneg _) hrightnonneg).mpr hnorm
  calc
    ‖finiteTensorTubeMultiplierAngularDeriv s q a theta xi‖ ^ 2 ≤
        (‖xi‖ * ‖∫ t : Real, W t‖) ^ 2 := hsq
    _ = ‖xi‖ ^ 2 * ‖∫ t : Real, W t‖ ^ 2 := by ring
    _ ≤ ‖xi‖ ^ 2 * (2 * ∫ t : Real, ‖W t‖ ^ 2) := by
      gcongr
    _ = ‖xi‖ ^ 2 * (2 * ((2 * Real.pi) ^ 2 *
        ∫ t : Real, ‖timeWeighted H t‖ ^ 2)) := by rw [hWint]
    _ ≤ ‖xi‖ ^ 2 * (2 * ((2 * Real.pi) ^ 2 *
        ((5 / 2 : Real) ^ 2 * ∫ t : Real, ‖H t‖ ^ 2))) := by
      gcongr
      exact htw.2
    _ = (50 * Real.pi ^ 2) * ‖xi‖ ^ 2 *
        ∫ t : Real, ‖scratch_finiteTensorTimeData s q a xi t‖ ^ 2 := by
      dsimp [H]
      ring

theorem continuous_uncurry_tubeTimePhaseAngularDeriv
    (a : SchwartzMap Real Complex) :
    Continuous (fun p : Real × Euclidean 2 =>
      tubeTimePhaseAngularDeriv a p.2 p.1) := by
  let D : SchwartzMap Real (Real →L[Real] Complex) :=
    SchwartzMap.fderivCLM Real Real Complex
      (FourierTransform.fourier a : SchwartzMap Real Complex)
  have hderiv (x : Real) :
      fderiv Real (FourierTransform.fourier a : Real → Complex) x = D x := by
    symm
    exact SchwartzMap.fderivCLM_apply Real
      (FourierTransform.fourier a : SchwartzMap Real Complex) x
  have hdir : Continuous (fun p : Real × Euclidean 2 => circleDirection p.1) := by
    unfold circleDirection
    fun_prop
  have hdir' : Continuous (fun p : Real × Euclidean 2 =>
      circleDirectionDeriv p.1) := by
    unfold circleDirectionDeriv
    fun_prop
  have hs : Continuous (fun p : Real × Euclidean 2 =>
      inner Real (circleDirection p.1) p.2) := hdir.inner continuous_snd
  have hv : Continuous (fun p : Real × Euclidean 2 =>
      inner Real (circleDirectionDeriv p.1) p.2) := hdir'.inner continuous_snd
  unfold tubeTimePhaseAngularDeriv
  simp_rw [hderiv]
  exact ((D.continuous.comp hs).clm_apply hv)

theorem continuous_uncurry_finiteTensorTubeMultiplierAngularDeriv
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) :
    Continuous (fun p : Real × Euclidean 2 =>
      finiteTensorTubeMultiplierAngularDeriv s q a p.1 p.2) := by
  unfold finiteTensorTubeMultiplierAngularDeriv
  exact continuous_finsetSum _ fun i hi =>
    ((q i).continuous.comp continuous_snd).mul
      (continuous_uncurry_tubeTimePhaseAngularDeriv (a i))

/-- The raw low-frequency angular derivative multiplier before the fixed
canonical spatial factor is attached. -/
noncomputable def lowpassFiniteTensorAngularDerivativeRaw
    {ι : Type*} (C : lpCutoffs 2) (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
    (theta : Real) (xi : Euclidean 2) : Complex :=
  intDyadicLowpassMultiplier C.cutoff 0 xi *
    finiteTensorTubeMultiplierAngularDeriv s q a theta xi

/-- Joint continuity required by the generic compact-interval physical
integrability wrapper. -/
theorem continuous_uncurry_lowpassFiniteTensorAngularDerivativeRaw
    {ι : Type*} (C : lpCutoffs 2) (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) :
    Continuous (fun p : Real × Euclidean 2 =>
      lowpassFiniteTensorAngularDerivativeRaw C s q a p.1 p.2) := by
  unfold lowpassFiniteTensorAngularDerivativeRaw
  exact ((intDyadicLowpassMultiplier C.cutoff 0).continuous.comp continuous_snd).mul
    (continuous_uncurry_finiteTensorTubeMultiplierAngularDeriv s q a)

/-- The raw lowpass derivative has the common fixed spatial-frequency
support `closedBall 0 2`, uniformly in the angular parameter. -/
theorem lowpassFiniteTensorAngularDerivativeRaw_eq_zero_of_two_le_norm
    {ι : Type*} (C : lpCutoffs 2) (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
    (theta : Real) (xi : Euclidean 2) (hxi : 2 ≤ ‖xi‖) :
    lowpassFiniteTensorAngularDerivativeRaw C s q a theta xi = 0 := by
  unfold lowpassFiniteTensorAngularDerivativeRaw
  have hscale : (2 : Real) ^ ((0 : Int) + 1) ≤ ‖xi‖ := by
    norm_num
    exact hxi
  rw [intDyadicLowpass_eq_zero_of_le_norm C hscale, zero_mul]

/-- The angular multiplier family after multiplication by the fixed canonical
tube multiplier.  The canonical factor is independent of angle, so its
angular derivative is just the corresponding factor times the raw derivative. -/
noncomputable def canonicalFiniteTensorCircleMultiplierFamily
    {ι : Type*} (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex) (theta : Real) :
    SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex
    (scratch_canonicalBandlimitedTubeMultiplier rho hrho :
      Euclidean 2 → Complex)
    (scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection theta))

theorem kakeyaRadialLowpassParametricMultiplier_canonicalFiniteTensor_eq
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex) (theta : Real) :
    kakeyaRadialLowpassParametricMultiplier C
      (canonicalFiniteTensorCircleMultiplierFamily rho hrho s q hqcompact a) theta =
      canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a
        (circleDirection theta) := by
  ext xi
  rw [kakeyaRadialLowpassParametricMultiplier,
    kakeyaRadialLowpassPiece_apply,
    canonicalLowpassFiniteTensorMultiplier_apply]
  unfold canonicalFiniteTensorCircleMultiplierFamily
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (scratch_canonicalBandlimitedTubeMultiplier rho hrho).hasTemperateGrowth]
  simp only [smul_eq_mul]

/-- A canonical Schwartz realization of each raw finite-tensor angular
derivative slice.  The construction is pointwise in the angle but its
application is definitionally the literal derivative multiplier. -/
noncomputable def finiteTensorTubeMultiplierAngularDerivSlice
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex) (theta : Real) :
    SchwartzMap (Euclidean 2) Complex :=
  (hasCompactSupport_finiteTensorTubeMultiplierAngularDeriv_slice
    s q hqcompact a theta).toSchwartzMap
      (contDiff_finiteTensorTubeMultiplierAngularDeriv_slice s q a theta)

theorem finiteTensorTubeMultiplierAngularDerivSlice_apply
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex) (theta : Real) (xi : Euclidean 2) :
    finiteTensorTubeMultiplierAngularDerivSlice s q hqcompact a theta xi =
      finiteTensorTubeMultiplierAngularDeriv s q a theta xi := rfl

/-- The actual Schwartz family used as the canonical lowpass derivative
multiplier in the `B₀` companion. -/
noncomputable def canonicalLowpassFiniteTensorAngularDerivativeFamily
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex) (theta : Real) :
    SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex
    (scratch_canonicalBandlimitedTubeMultiplier rho hrho :
      Euclidean 2 → Complex)
    (kakeyaRadialLowpassPiece C
      (finiteTensorTubeMultiplierAngularDerivSlice s q hqcompact a theta))

theorem canonicalLowpassFiniteTensorAngularDerivativeFamily_apply
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex) (theta : Real) (xi : Euclidean 2) :
    canonicalLowpassFiniteTensorAngularDerivativeFamily C rho hrho s q hqcompact a theta xi =
      scratch_canonicalBandlimitedTubeMultiplier rho hrho xi *
        lowpassFiniteTensorAngularDerivativeRaw C s q a theta xi := by
  unfold canonicalLowpassFiniteTensorAngularDerivativeFamily
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (scratch_canonicalBandlimitedTubeMultiplier rho hrho).hasTemperateGrowth,
    kakeyaRadialLowpassPiece_apply,
    finiteTensorTubeMultiplierAngularDerivSlice_apply]
  simp only [lowpassFiniteTensorAngularDerivativeRaw, smul_eq_mul]

theorem continuous_uncurry_canonicalLowpassFiniteTensorAngularDerivativeFamily
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex) :
    Continuous (Function.uncurry (fun theta xi =>
      canonicalLowpassFiniteTensorAngularDerivativeFamily C rho hrho s q hqcompact a theta xi)) := by
  let dm := canonicalLowpassFiniteTensorAngularDerivativeFamily C rho hrho s q hqcompact a
  have hbase : Continuous (fun p : Real × Euclidean 2 =>
      scratch_canonicalBandlimitedTubeMultiplier rho hrho p.2 *
        lowpassFiniteTensorAngularDerivativeRaw C s q a p.1 p.2) :=
    ((scratch_canonicalBandlimitedTubeMultiplier rho hrho).continuous.comp continuous_snd).mul
      (continuous_uncurry_lowpassFiniteTensorAngularDerivativeRaw C s q a)
  convert hbase using 1
  ext p
  exact canonicalLowpassFiniteTensorAngularDerivativeFamily_apply
    C rho hrho s q hqcompact a p.1 p.2

theorem canonicalLowpassFiniteTensorAngularDerivativeFamily_eq_zero_of_not_mem_closedBall_two
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (theta : Real) (xi : Euclidean 2) (hxi : xi ∉ closedBall 0 2) :
    canonicalLowpassFiniteTensorAngularDerivativeFamily C rho hrho s q hqcompact a theta xi = 0 := by
  have hnorm : 2 ≤ ‖xi‖ := by
    rw [Metric.mem_closedBall, dist_zero_right] at hxi
    exact le_of_lt (lt_of_not_ge hxi)
  rw [canonicalLowpassFiniteTensorAngularDerivativeFamily_apply,
    lowpassFiniteTensorAngularDerivativeRaw_eq_zero_of_two_le_norm C s q a theta xi hnorm,
    mul_zero]

theorem integrable_sq_canonicalLowpassFiniteTensorAngularDerivativeFamily
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex) :
    Integrable (fun p : Real × Euclidean 2 =>
      ‖canonicalLowpassFiniteTensorAngularDerivativeFamily C rho hrho s q hqcompact a p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume) := by
  apply integrable_sq_compactInterval_of_continuous_commonSupport
    (fun theta xi =>
      canonicalLowpassFiniteTensorAngularDerivativeFamily C rho hrho s q hqcompact a theta xi)
    (-Real.pi) Real.pi (closedBall 0 2)
  · exact continuous_uncurry_canonicalLowpassFiniteTensorAngularDerivativeFamily
      C rho hrho s q hqcompact a
  · exact isCompact_closedBall _ _
  · intro theta xi hxi
    exact canonicalLowpassFiniteTensorAngularDerivativeFamily_eq_zero_of_not_mem_closedBall_two
      C rho hrho s q hqcompact a theta xi hxi

/-- A global angular-uniform frequency majorant for the literal finite-tensor
derivative.  This exposes the domination fact used to obtain physical joint
continuity by dominated inverse Fourier integration. -/
theorem norm_finiteTensorTubeMultiplierAngularDeriv_le_bound
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
    (theta : Real) (xi : Euclidean 2) :
    ‖finiteTensorTubeMultiplierAngularDeriv s q a theta xi‖ ≤
      finiteTensorTubeMultiplierAngularDerivBound s q a xi := by
  classical
  unfold finiteTensorTubeMultiplierAngularDeriv
    finiteTensorTubeMultiplierAngularDerivBound
  calc
    ‖∑ i ∈ s, q i xi * tubeTimePhaseAngularDeriv (a i) xi theta‖ ≤
        ∑ i ∈ s, ‖q i xi * tubeTimePhaseAngularDeriv (a i) xi theta‖ :=
      norm_sum_le _ _
    _ ≤ ∑ i ∈ s,
        (SchwartzMap.seminorm Complex 0 0)
          (SchwartzMap.fderivCLM Real Real Complex
            (FourierTransform.fourier (a i) : SchwartzMap Real Complex)) *
          (‖xi‖ * ‖q i xi‖) := by
      apply Finset.sum_le_sum
      intro i hi
      calc
        ‖q i xi * tubeTimePhaseAngularDeriv (a i) xi theta‖ =
            ‖q i xi‖ * ‖tubeTimePhaseAngularDeriv (a i) xi theta‖ := norm_mul _ _
        _ ≤ ‖q i xi‖ *
            ((SchwartzMap.seminorm Complex 0 0)
              (SchwartzMap.fderivCLM Real Real Complex
                (FourierTransform.fourier (a i) : SchwartzMap Real Complex)) * ‖xi‖) :=
          mul_le_mul_of_nonneg_left
            (by
              let D : SchwartzMap Real (Real →L[Real] Complex) :=
                SchwartzMap.fderivCLM Real Real Complex
                  (FourierTransform.fourier (a i) : SchwartzMap Real Complex)
              have hderiv (x : Real) :
                  fderiv Real (FourierTransform.fourier (a i) : Real → Complex) x = D x := by
                symm
                exact SchwartzMap.fderivCLM_apply Real
                  (FourierTransform.fourier (a i) : SchwartzMap Real Complex) x
              have hv : ‖inner Real (circleDirectionDeriv theta) xi‖ ≤ ‖xi‖ := by
                rw [Real.norm_eq_abs]
                calc
                  |inner Real (circleDirectionDeriv theta) xi| ≤
                      ‖circleDirectionDeriv theta‖ * ‖xi‖ :=
                    abs_real_inner_le_norm _ _
                  _ = ‖xi‖ := by rw [norm_circleDirectionDeriv, one_mul]
              unfold tubeTimePhaseAngularDeriv
              rw [hderiv]
              calc
                ‖D (inner Real (circleDirection theta) xi)
                    (inner Real (circleDirectionDeriv theta) xi)‖ ≤
                    ‖D (inner Real (circleDirection theta) xi)‖ *
                      ‖inner Real (circleDirectionDeriv theta) xi‖ :=
                  ContinuousLinearMap.le_opNorm _ _
                _ ≤ ‖D (inner Real (circleDirection theta) xi)‖ * ‖xi‖ :=
                  mul_le_mul_of_nonneg_left hv (norm_nonneg _)
                _ ≤ (SchwartzMap.seminorm Complex 0 0) D * ‖xi‖ :=
                  mul_le_mul_of_nonneg_right
                    (SchwartzMap.norm_le_seminorm Complex D _) (norm_nonneg _))
            (norm_nonneg _)
        _ = (SchwartzMap.seminorm Complex 0 0)
              (SchwartzMap.fderivCLM Real Real Complex
                (FourierTransform.fourier (a i) : SchwartzMap Real Complex)) *
              (‖xi‖ * ‖q i xi‖) := by ring

theorem integrable_finiteTensorTubeMultiplierAngularDerivBound
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) :
    Integrable (finiteTensorTubeMultiplierAngularDerivBound s q a) := by
  classical
  unfold finiteTensorTubeMultiplierAngularDerivBound
  exact integrable_finsetSum s fun i hi => by
    have hq : Integrable (fun xi : Euclidean 2 => ‖xi‖ * ‖q i xi‖) := by
      simpa using (q i).integrable_pow_mul_iteratedFDeriv volume 1 0
    exact hq.const_mul ((SchwartzMap.seminorm Complex 0 0)
      (SchwartzMap.fderivCLM Real Real Complex
        (FourierTransform.fourier (a i) : SchwartzMap Real Complex)))

theorem norm_canonicalLowpassFiniteTensorAngularDerivativeFamily_le_majorant
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (theta : Real) (xi : Euclidean 2) :
    ‖canonicalLowpassFiniteTensorAngularDerivativeFamily C rho hrho s q hqcompact a theta xi‖ ≤
      canonicalTubeMultiplierUniformBound *
        finiteTensorTubeMultiplierAngularDerivBound s q a xi := by
  rw [canonicalLowpassFiniteTensorAngularDerivativeFamily_apply, norm_mul]
  unfold lowpassFiniteTensorAngularDerivativeRaw
  rw [norm_mul]
  have hcan := norm_scratch_canonicalBandlimitedTubeMultiplier_le_uniformBound hrho xi
  have hlow := norm_intDyadicLowpassMultiplier_zero_le_one C xi
  have hU : 0 ≤ canonicalTubeMultiplierUniformBound := by
    dsimp [canonicalTubeMultiplierUniformBound]
    positivity
  have hlowderiv :
      ‖intDyadicLowpassMultiplier C.cutoff 0 xi‖ *
          ‖finiteTensorTubeMultiplierAngularDeriv s q a theta xi‖ ≤
        1 * ‖finiteTensorTubeMultiplierAngularDeriv s q a theta xi‖ :=
    mul_le_mul_of_nonneg_right hlow (norm_nonneg _)
  calc
    ‖scratch_canonicalBandlimitedTubeMultiplier rho hrho xi‖ *
        (‖intDyadicLowpassMultiplier C.cutoff 0 xi‖ *
          ‖finiteTensorTubeMultiplierAngularDeriv s q a theta xi‖) ≤
        canonicalTubeMultiplierUniformBound *
          (‖intDyadicLowpassMultiplier C.cutoff 0 xi‖ *
            ‖finiteTensorTubeMultiplierAngularDeriv s q a theta xi‖) :=
      mul_le_mul_of_nonneg_right hcan
        (mul_nonneg (norm_nonneg _) (norm_nonneg _))
    _ ≤ canonicalTubeMultiplierUniformBound *
          (1 * ‖finiteTensorTubeMultiplierAngularDeriv s q a theta xi‖) :=
      mul_le_mul_of_nonneg_left hlowderiv hU
    _ ≤ canonicalTubeMultiplierUniformBound *
          (1 * finiteTensorTubeMultiplierAngularDerivBound s q a xi) := by
      apply mul_le_mul_of_nonneg_left
      · exact mul_le_mul_of_nonneg_left
          (norm_finiteTensorTubeMultiplierAngularDeriv_le_bound s q a theta xi)
          (by norm_num)
      · exact hU
    _ = canonicalTubeMultiplierUniformBound *
        finiteTensorTubeMultiplierAngularDerivBound s q a xi := by ring

theorem integrable_canonicalLowpassFiniteTensorAngularDerivative_majorant
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) :
    Integrable (fun xi : Euclidean 2 =>
      canonicalTubeMultiplierUniformBound *
        finiteTensorTubeMultiplierAngularDerivBound s q a xi) :=
  (integrable_finiteTensorTubeMultiplierAngularDerivBound s q a).const_mul _

/-- Source-style lowpass maximal-square closure.  All energy hypotheses are
now discharged by the finite compact-time tensor; the remaining assumptions
are only the standard physical regularity package for the displayed concrete
Schwartz derivative family `dm`. -/
theorem measurable_and_lintegral_iSup_sq_canonicalFiniteTensorLowpassField_le
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    {r : Real} (hr : r < 1)
    (ha : ∀ i, Function.support (a i : Real → Complex) ⊆
      closedBall (3 / 2 : Real) r)
    (htrace : HasFiniteCoreLowpassAngularTraceEnergy C s q a
      (400 * Real.pi ^ 3 * finiteTensorFrequencyTimeEnergy s q a))
    (dm : Real → SchwartzMap (Euclidean 2) Complex)
    (hFcont : Continuous (Function.uncurry
      (kakeyaRadialLowpassParametricField C
        (canonicalFiniteTensorCircleMultiplierFamily rho hrho s q hqcompact a))))
    (hDcont : Continuous (Function.uncurry (fourierInvParametricField dm)))
    (hderiv : ∀ theta x, HasDerivAt
      (fun u => kakeyaRadialLowpassParametricField C
        (canonicalFiniteTensorCircleMultiplierFamily rho hrho s q hqcompact a) u x)
      (fourierInvParametricField dm theta x) theta)
    (hDfrequency : Integrable (fun p : Real × Euclidean 2 => ‖dm p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume))
    (hfactor : ∀ theta xi, dm theta xi =
      scratch_canonicalBandlimitedTubeMultiplier rho hrho xi *
        lowpassFiniteTensorAngularDerivativeRaw C s q a theta xi) :
    Measurable (fun x : Euclidean 2 =>
      ⨆ theta : Real, ENNReal.ofReal
        (‖kakeyaRadialLowpassParametricField C
          (canonicalFiniteTensorCircleMultiplierFamily rho hrho s q hqcompact a)
          theta x‖ ^ 2)) ∧
      (∫⁻ x : Euclidean 2, ⨆ theta : Real, ENNReal.ofReal
        (‖kakeyaRadialLowpassParametricField C
          (canonicalFiniteTensorCircleMultiplierFamily rho hrho s q hqcompact a)
          theta x‖ ^ 2)) ≤
        ENNReal.ofReal
          ((4 + 1600 * Real.pi ^ 4) * canonicalTubeMultiplierUniformBound ^ 2 *
            ∫ p : Euclidean 2 × Real, ‖finiteTensorPhysicalTimeData s q a p‖ ^ 2
              ∂(volume.prod volume)) := by
  let M : Real → SchwartzMap (Euclidean 2) Complex :=
    canonicalFiniteTensorCircleMultiplierFamily rho hrho s q hqcompact a
  have hfreq : Integrable (fun p : Euclidean 2 × Real =>
      ‖scratch_finiteTensorTimeData s q a p.1 p.2‖ ^ 2) (volume.prod volume) :=
    integrable_sq_scratch_finiteTensorTimeData_product s q a
  have hperiodic : ∀ x : Euclidean 2, Function.Periodic
      (fun theta => kakeyaRadialLowpassParametricField C M theta x)
      (2 * Real.pi) := by
    intro x theta
    have hM : M (theta + 2 * Real.pi) = M theta := by
      dsimp [M, canonicalFiniteTensorCircleMultiplierFamily]
      rw [circleDirection_periodic]
    unfold kakeyaRadialLowpassParametricField
    change FourierTransform.fourierInv
      (kakeyaRadialLowpassParametricMultiplier C M
        (theta + 2 * Real.pi) : Euclidean 2 → Complex) x =
      FourierTransform.fourierInv
        (kakeyaRadialLowpassParametricMultiplier C M theta :
          Euclidean 2 → Complex) x
    unfold kakeyaRadialLowpassParametricMultiplier
    rw [hM]
  have hE0 : (∫ xi : Euclidean 2,
      ‖kakeyaRadialLowpassParametricMultiplier C M (-Real.pi) xi‖ ^ (2 : Nat)) ≤
      canonicalTubeMultiplierUniformBound ^ 2 *
        (2 * finiteTensorFrequencyTimeEnergy s q a) := by
    rw [show kakeyaRadialLowpassParametricMultiplier C M (-Real.pi) =
      canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a
        (circleDirection (-Real.pi)) by
      dsimp [M]
      exact kakeyaRadialLowpassParametricMultiplier_canonicalFiniteTensor_eq
        C rho hrho s q hqcompact a (-Real.pi)]
    exact integral_norm_sq_canonicalLowpassFiniteTensorMultiplier_le
      C rho hrho s q hqcompact a hr ha hfreq (circleDirection (-Real.pi))
  have hE1 : (∫ p : Real × Euclidean 2, ‖dm p.1 p.2‖ ^ (2 : Nat) ∂
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume)) ≤
      canonicalTubeMultiplierUniformBound ^ 2 *
        (400 * Real.pi ^ 3 * finiteTensorFrequencyTimeEnergy s q a) := by
    apply integral_norm_sq_canonicalLowpassAngularDerivative_le_of_traceEnergy
      C rho hrho s q a dm
        (400 * Real.pi ^ 3 * finiteTensorFrequencyTimeEnergy s q a)
    · intro theta xi
      rw [hfactor]
      rfl
    · exact hDfrequency
    · exact htrace
  have hmain :=
    measurable_and_lintegral_iSup_sq_kakeyaRadialLowpassParametricField_le_globalH1
      C M dm hperiodic (by simpa only [M] using hFcont) hDcont
      (by
        intro theta x
        simpa only [M] using hderiv theta x)
      (integrable_sq_fourierInvParametricField_of_continuous_frequency dm
        (-Real.pi) Real.pi hDcont hDfrequency)
      hDfrequency hE0 hE1
  have henergy : finiteTensorFrequencyTimeEnergy s q a =
      ∫ p : Euclidean 2 × Real, ‖finiteTensorPhysicalTimeData s q a p‖ ^ 2
        ∂(volume.prod volume) :=
    finiteTensorFrequencyTimeEnergy_eq_integral_norm_sq_physical s q a
  have hconst :
      2 * (canonicalTubeMultiplierUniformBound ^ 2 *
        (2 * finiteTensorFrequencyTimeEnergy s q a)) +
        4 * Real.pi * (canonicalTubeMultiplierUniformBound ^ 2 *
          (400 * Real.pi ^ 3 * finiteTensorFrequencyTimeEnergy s q a)) =
      (4 + 1600 * Real.pi ^ 4) * canonicalTubeMultiplierUniformBound ^ 2 *
        ∫ p : Euclidean 2 × Real, ‖finiteTensorPhysicalTimeData s q a p‖ ^ 2
          ∂(volume.prod volume) := by
    rw [henergy]
    ring
  simpa only [M, hconst] using hmain

/-- The complete `E₁` trace-energy closure for compact-time finite tensors.
The fixed lowpass restricts `‖xi‖` to at most two, and the fixed angular
interval has length `2π`, yielding the explicit factor `400 π³`. -/
theorem hasFiniteCoreLowpassAngularTraceEnergyBound
    {ι : Type*} (C : lpCutoffs 2)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    {r : Real} (hr : r < 1)
    (ha : ∀ i, Function.support (a i : Real → Complex) ⊆
      closedBall (3 / 2 : Real) r) :
    HasFiniteCoreLowpassAngularTraceEnergyBound C s q a := by
  let μ : Measure Real := volume.restrict (Icc (-Real.pi) Real.pi)
  let E : Euclidean 2 → Real := fun xi =>
    ∫ t : Real, ‖scratch_finiteTensorTimeData s q a xi t‖ ^ 2
  let G : Real × Euclidean 2 → Real := fun p =>
    200 * Real.pi ^ 2 * E p.2
  let D : Real × Euclidean 2 → Complex := fun p =>
    intDyadicLowpassMultiplier C.cutoff 0 p.2 *
      finiteTensorTubeMultiplierAngularDeriv s q a p.1 p.2
  have hfreq : Integrable (fun p : Euclidean 2 × Real =>
      ‖scratch_finiteTensorTimeData s q a p.1 p.2‖ ^ 2) (volume.prod volume) :=
    integrable_sq_scratch_finiteTensorTimeData_product s q a
  have hE : Integrable E volume := by
    dsimp [E]
    exact hfreq.integral_prod_left
  letI : IsFiniteMeasure μ := by
    dsimp [μ]
    infer_instance
  have hone : Integrable (fun _ : Real => (1 : Real)) μ := integrable_const _
  have hG : Integrable G (μ.prod volume) := by
    have hbase := hone.mul_prod hE
    exact (hbase.const_mul (200 * Real.pi ^ 2)).congr
      (Filter.Eventually.of_forall fun p => by simp [G, E])
  have hDcont : Continuous D := by
    dsimp [D]
    exact ((intDyadicLowpassMultiplier C.cutoff 0).continuous.comp continuous_snd).mul
      (continuous_uncurry_finiteTensorTubeMultiplierAngularDeriv s q a)
  have hpoint (p : Real × Euclidean 2) :
      ‖D p‖ ^ 2 ≤ G p := by
    rcases p with ⟨theta, xi⟩
    have hE_nonneg : 0 ≤ E xi := by
      dsimp [E]
      exact integral_nonneg fun _ => sq_nonneg _
    by_cases hzero : intDyadicLowpassMultiplier C.cutoff 0 xi = 0
    · calc
        ‖D (theta, xi)‖ ^ 2 = 0 := by simp [D, hzero]
        _ ≤ G (theta, xi) := by
          dsimp [G]
          exact mul_nonneg (by positivity) hE_nonneg
    have hxi : ‖xi‖ ≤ 2 := by
      by_contra hnot
      have htwo : 2 ≤ ‖xi‖ := le_of_not_ge hnot
      have hz : intDyadicLowpassMultiplier C.cutoff 0 xi = 0 := by
        apply intDyadicLowpass_eq_zero_of_le_norm C
        norm_num
        exact htwo
      exact hzero hz
    have hcut : ‖intDyadicLowpassMultiplier C.cutoff 0 xi‖ ≤ 1 :=
      norm_intDyadicLowpassMultiplier_zero_le_one C xi
    have hcutsq : ‖intDyadicLowpassMultiplier C.cutoff 0 xi‖ ^ 2 ≤ 1 :=
      by simpa using
        ((sq_le_sq₀ (norm_nonneg _) (by norm_num)).mpr hcut)
    have hderiv :=
      norm_sq_finiteTensorTubeMultiplierAngularDeriv_le_compactTimeEnergy
        s q hqcompact a hr ha theta xi
    have hxisq : ‖xi‖ ^ 2 ≤ 4 := by
      nlinarith [norm_nonneg xi]
    dsimp [D, G]
    calc
      ‖intDyadicLowpassMultiplier C.cutoff 0 xi *
          finiteTensorTubeMultiplierAngularDeriv s q a theta xi‖ ^ 2 =
          ‖intDyadicLowpassMultiplier C.cutoff 0 xi‖ ^ 2 *
            ‖finiteTensorTubeMultiplierAngularDeriv s q a theta xi‖ ^ 2 := by
              rw [norm_mul]
              ring
      _ ≤ 1 * ‖finiteTensorTubeMultiplierAngularDeriv s q a theta xi‖ ^ 2 := by
        gcongr
      _ = ‖finiteTensorTubeMultiplierAngularDeriv s q a theta xi‖ ^ 2 := by ring
      _ ≤ (50 * Real.pi ^ 2) * ‖xi‖ ^ 2 * E xi := by
        simpa only [E] using hderiv
      _ ≤ (50 * Real.pi ^ 2) * 4 * E xi := by
        gcongr
      _ = 200 * Real.pi ^ 2 * E xi := by ring
  have hDsq : Integrable (fun p : Real × Euclidean 2 => ‖D p‖ ^ 2)
      (μ.prod volume) := by
    refine hG.mono' (hDcont.norm.pow 2 |>.aestronglyMeasurable) ?_
    filter_upwards with p
    simpa only [Real.norm_of_nonneg (sq_nonneg _)] using hpoint p
  have henergyEq : (∫ xi : Euclidean 2, E xi) =
      finiteTensorFrequencyTimeEnergy s q a := by
    dsimp [E, finiteTensorFrequencyTimeEnergy]
    exact (integral_prod _ hfreq).symm
  have hpi : -Real.pi ≤ Real.pi := by linarith [Real.pi_pos]
  have hGintegral : (∫ p : Real × Euclidean 2, G p ∂(μ.prod volume)) =
      400 * Real.pi ^ 3 * finiteTensorFrequencyTimeEnergy s q a := by
    calc
      (∫ p : Real × Euclidean 2, G p ∂(μ.prod volume)) =
          ∫ theta in -Real.pi..Real.pi, ∫ xi : Euclidean 2, G (theta, xi) := by
            exact (intervalIntegral_integral_eq_integral_productShell hpi
                (fun theta xi => G (theta, xi)) (by simpa only [μ] using hG)).symm
      _ = ∫ theta in -Real.pi..Real.pi,
          (200 * Real.pi ^ 2) * ∫ xi : Euclidean 2, E xi := by
            apply intervalIntegral.integral_congr_ae
            filter_upwards with theta
            rw [integral_const_mul]
            simp
      _ = (Real.pi - -Real.pi) *
          ((200 * Real.pi ^ 2) * ∫ xi : Euclidean 2, E xi) := by
            rw [intervalIntegral.integral_const]
            simp only [smul_eq_mul]
      _ = 400 * Real.pi ^ 3 * finiteTensorFrequencyTimeEnergy s q a := by
            rw [henergyEq]
            ring
  constructor
  · simpa only [D, μ] using hDsq
  · calc
      (∫ p : Real × Euclidean 2,
        ‖intDyadicLowpassMultiplier C.cutoff 0 p.2 *
          finiteTensorTubeMultiplierAngularDeriv s q a p.1 p.2‖ ^ 2 ∂
          ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume)) =
          ∫ p : Real × Euclidean 2, ‖D p‖ ^ 2 ∂(μ.prod volume) := by rfl
      _ ≤ ∫ p : Real × Euclidean 2, G p ∂(μ.prod volume) :=
        integral_mono hDsq hG hpoint
      _ = 400 * Real.pi ^ 3 * finiteTensorFrequencyTimeEnergy s q a := hGintegral

/-- Reflection of the canonical kernel is fully compatible with the lowpass
energy closure: it is absorbed into the compact spatial tensor profiles, so
no evenness of the canonical multiplier is used. -/
theorem hasFiniteCoreLowpassAngularTraceEnergyBound_reflectedTubeProfile
    {ι : Type*} (C : lpCutoffs 2)
    (m : SchwartzMap (Euclidean 2) Complex)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    {r : Real} (hr : r < 1)
    (ha : ∀ i, Function.support (a i : Real → Complex) ⊆
      closedBall (3 / 2 : Real) r) :
    HasFiniteCoreLowpassAngularTraceEnergyBound C s
      (fun i => reflectedTubeProfile m (q i)) a := by
  apply hasFiniteCoreLowpassAngularTraceEnergyBound C s
    (fun i => reflectedTubeProfile m (q i))
    (fun i => reflectedTubeProfile_hasCompactSupport m (q i) (hqcompact i))
    a hr ha

/-- The preceding reflected-profile closure specialized to the canonical tube
multiplier used in the finite radial decomposition. -/
theorem hasFiniteCoreLowpassAngularTraceEnergyBound_reflectedCanonicalTube
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    {r : Real} (hr : r < 1)
    (ha : ∀ i, Function.support (a i : Real → Complex) ⊆
      closedBall (3 / 2 : Real) r) :
    HasFiniteCoreLowpassAngularTraceEnergyBound C s
      (fun i => reflectedTubeProfile
        (scratch_canonicalBandlimitedTubeMultiplier rho hrho) (q i)) a := by
  exact hasFiniteCoreLowpassAngularTraceEnergyBound_reflectedTubeProfile
    C (scratch_canonicalBandlimitedTubeMultiplier rho hrho) s q hqcompact a hr ha

end

