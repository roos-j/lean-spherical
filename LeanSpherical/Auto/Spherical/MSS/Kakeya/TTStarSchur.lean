/-- A parameterized inverse spatial Fourier integral is continuous on a
parameter set when its raw multiplier is jointly continuous and supported in
one compact frequency set there.  This is the local compact-support version:
no global angular majorant is required. -/
theorem continuousOn_uncurry_fourierInv_of_continuous_commonSupport
    (m : Real -> Euclidean 2 -> Complex) (lo hi : Real)
    (K : Set (Euclidean 2))
    (hcont : Continuous (Function.uncurry m)) (hK : IsCompact K)
    (hsupport : forall theta xi, xi ∉ K -> m theta xi = 0) :
    ContinuousOn (Function.uncurry (fun theta y =>
      FourierTransform.fourierInv (m theta : Euclidean 2 -> Complex) y))
      ((Icc lo hi) ×ˢ (Set.univ : Set (Euclidean 2))) := by
  let f : (Real × Euclidean 2) -> Euclidean 2 -> Complex := fun p xi =>
    Real.fourierChar (inner Real xi p.2) • m p.1 xi
  have hfcont : Continuous (Function.uncurry f) := by
    dsimp [f]
    exact (Real.continuous_fourierChar.comp
      (continuous_snd.inner continuous_fst.snd)).smul
      (hcont.comp (continuous_fst.fst.prodMk continuous_snd))
  have hfs : forall p : Real × Euclidean 2, forall xi : Euclidean 2,
      p ∈ ((Icc lo hi) ×ˢ (Set.univ : Set (Euclidean 2))) ->
      xi ∉ K -> f p xi = 0 := by
    intro p xi hp hxi
    dsimp [f]
    rw [hsupport p.1 xi hxi]
    simp
  have hIntegral : ContinuousOn (fun p : Real × Euclidean 2 =>
      ∫ xi : Euclidean 2, f p xi)
      ((Icc lo hi) ×ˢ (Set.univ : Set (Euclidean 2))) :=
    continuousOn_integral_of_compact_support hK hfcont.continuousOn hfs
  have heq :
      Function.uncurry (fun theta y =>
        FourierTransform.fourierInv (m theta : Euclidean 2 -> Complex) y) =
        (fun p : Real × Euclidean 2 =>
          ∫ xi : Euclidean 2,
            Real.fourierChar (inner Real xi p.2) • m p.1 xi) := by
    funext p
    exact Real.fourierInv_eq (m p.1 : Euclidean 2 -> Complex) p.2
  rw [heq]
  exact hIntegral

end

end Auto.Spherical.MSS
end
