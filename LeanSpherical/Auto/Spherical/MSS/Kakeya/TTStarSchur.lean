noncomputable section

/-- A concrete slice-Schwartz realization of one literal chart/shift/capped
shell field and its supplied angular derivative.  The four integrability
fields are the only Fubini obligations at the spatial Plancherel stage. -/
structure ShiftedCappedShellSchwartzSlices
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (eps : Real) (K n i : Nat) (lo hi : Real) where
  multiplier : Real -> SchwartzMap (Euclidean 2) Complex
  multiplierDeriv : Real -> SchwartzMap (Euclidean 2) Complex
  field_eq : ∀ theta y,
    shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i theta y =
      fourierInvParametricField multiplier theta y
  fieldDeriv_eq : ∀ theta y,
    shiftedChartedCappedTelescopingFieldDeriv C j s q hqcompact a eps K n i theta y =
      fourierInvParametricField multiplierDeriv theta y
  physical_integrable : Integrable (fun p : Real × Euclidean 2 =>
    ‖fourierInvParametricField multiplier p.1 p.2‖ ^ (2 : Nat))
    ((volume.restrict (Icc lo hi)).prod volume)
  physicalDeriv_integrable : Integrable (fun p : Real × Euclidean 2 =>
    ‖fourierInvParametricField multiplierDeriv p.1 p.2‖ ^ (2 : Nat))
    ((volume.restrict (Icc lo hi)).prod volume)
  frequency_integrable : Integrable (fun p : Real × Euclidean 2 =>
    ‖multiplier p.1 p.2‖ ^ (2 : Nat))
    ((volume.restrict (Icc lo hi)).prod volume)
  frequencyDeriv_integrable : Integrable (fun p : Real × Euclidean 2 =>
    ‖multiplierDeriv p.1 p.2‖ ^ (2 : Nat))
    ((volume.restrict (Icc lo hi)).prod volume)

/-- Exact product-measure spatial Plancherel for a literal shifted shell
slice realization. -/
theorem shiftedCappedShell_energy_eq_frequency
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (eps : Real) (K n i : Nat) (lo hi : Real)
    (S : ShiftedCappedShellSchwartzSlices C j s q hqcompact a eps K n i lo hi) :
    (∫ p : Real × Euclidean 2,
      ‖shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i p.1 p.2‖ ^
        (2 : Nat) ∂ ((volume.restrict (Icc lo hi)).prod volume)) =
      ∫ p : Real × Euclidean 2, ‖S.multiplier p.1 p.2‖ ^ (2 : Nat) ∂
        ((volume.restrict (Icc lo hi)).prod volume) := by
  calc
    (∫ p : Real × Euclidean 2,
      ‖shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i p.1 p.2‖ ^
        (2 : Nat) ∂ ((volume.restrict (Icc lo hi)).prod volume)) =
        ∫ p : Real × Euclidean 2,
          ‖fourierInvParametricField S.multiplier p.1 p.2‖ ^ (2 : Nat) ∂
          ((volume.restrict (Icc lo hi)).prod volume) := by
            apply integral_congr_ae
            filter_upwards with p
            rw [S.field_eq]
    _ = ∫ p : Real × Euclidean 2, ‖S.multiplier p.1 p.2‖ ^ (2 : Nat) ∂
          ((volume.restrict (Icc lo hi)).prod volume) :=
      integral_product_Icc_spatial_sq_fourierInvParametricField_eq_frequency
        S.multiplier lo hi S.physical_integrable S.frequency_integrable

/-- The identical transport for the literal angular-derivative shell field. -/
theorem shiftedCappedShell_deriv_energy_eq_frequency
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (eps : Real) (K n i : Nat) (lo hi : Real)
    (S : ShiftedCappedShellSchwartzSlices C j s q hqcompact a eps K n i lo hi) :
    (∫ p : Real × Euclidean 2,
      ‖shiftedChartedCappedTelescopingFieldDeriv C j s q hqcompact a eps K n i p.1 p.2‖ ^
        (2 : Nat) ∂ ((volume.restrict (Icc lo hi)).prod volume)) =
      ∫ p : Real × Euclidean 2, ‖S.multiplierDeriv p.1 p.2‖ ^ (2 : Nat) ∂
        ((volume.restrict (Icc lo hi)).prod volume) := by
  calc
    (∫ p : Real × Euclidean 2,
      ‖shiftedChartedCappedTelescopingFieldDeriv C j s q hqcompact a eps K n i p.1 p.2‖ ^
        (2 : Nat) ∂ ((volume.restrict (Icc lo hi)).prod volume)) =
        ∫ p : Real × Euclidean 2,
          ‖fourierInvParametricField S.multiplierDeriv p.1 p.2‖ ^ (2 : Nat) ∂
          ((volume.restrict (Icc lo hi)).prod volume) := by
            apply integral_congr_ae
            filter_upwards with p
            rw [S.fieldDeriv_eq]
    _ = ∫ p : Real × Euclidean 2, ‖S.multiplierDeriv p.1 p.2‖ ^ (2 : Nat) ∂
          ((volume.restrict (Icc lo hi)).prod volume) :=
      integral_product_Icc_spatial_sq_fourierInvParametricField_eq_frequency
        S.multiplierDeriv lo hi S.physicalDeriv_integrable S.frequencyDeriv_integrable

/-- Frequency-side E₀/E₁ bounds become literal physical shell-energy bounds
through a slice-Schwartz realization. -/
theorem shiftedCappedShell_energy_le_of_frequency_bounds
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (eps : Real) (K n i : Nat) (lo hi E0 E1 : Real)
    (S : ShiftedCappedShellSchwartzSlices C j s q hqcompact a eps K n i lo hi)
    (hfrequency0 : (∫ p : Real × Euclidean 2,
      ‖S.multiplier p.1 p.2‖ ^ (2 : Nat) ∂
        ((volume.restrict (Icc lo hi)).prod volume)) ≤ E0)
    (hfrequency1 : (∫ p : Real × Euclidean 2,
      ‖S.multiplierDeriv p.1 p.2‖ ^ (2 : Nat) ∂
        ((volume.restrict (Icc lo hi)).prod volume)) ≤ E1) :
    (∫ p : Real × Euclidean 2,
      ‖shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i p.1 p.2‖ ^
        (2 : Nat) ∂ ((volume.restrict (Icc lo hi)).prod volume)) ≤ E0 ∧
      (∫ p : Real × Euclidean 2,
        ‖shiftedChartedCappedTelescopingFieldDeriv C j s q hqcompact a eps K n i p.1 p.2‖ ^
          (2 : Nat) ∂ ((volume.restrict (Icc lo hi)).prod volume)) ≤ E1 := by
  constructor
  · rw [shiftedCappedShell_energy_eq_frequency C j s q hqcompact a eps K n i lo hi S]
    exact hfrequency0
  · rw [shiftedCappedShell_deriv_energy_eq_frequency C j s q hqcompact a eps K n i lo hi S]
    exact hfrequency1

/-- Complete local endpoint closure with spatial Plancherel made explicit:
frequency-side E₀/E₁ bounds for slice-Schwartz multipliers feed directly
into the literal shifted chart/shift/shell maximal bound. -/
theorem shiftedChartedCappedTelescopingField_endpointZeroSobolev_of_frequency_bounds
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    {eps : Real} (heps : 0 < eps) (K n i : Nat)
    (hi : i ∈ Finset.range (K + 2)) (hn : n < 7) (hj : j ∈ charts)
    (hscale : (2 : Real) ^ K * eps ≤ Real.pi / 2)
    {hiAngle E E0 E1 qscale : Real}
    (hlohi : shiftedCappedShellGlobalCommonLeft ≤ hiAngle)
    (S : ShiftedCappedShellSchwartzSlices C j s q hqcompact a eps K n i
      shiftedCappedShellGlobalCommonLeft hiAngle)
    (hFcont : Continuous (Function.uncurry
      (shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i)))
    (hDcont : Continuous (Function.uncurry
      (shiftedChartedCappedTelescopingFieldDeriv C j s q hqcompact a eps K n i)))
    (hderiv : ∀ theta y, HasDerivAt
      (fun r => shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i r y)
      (shiftedChartedCappedTelescopingFieldDeriv C j s q hqcompact a eps K n i theta y) theta)
    (hFmem : MemLp (fun p : Real × Euclidean 2 =>
      shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i p.1 p.2) 2
      ((volume.restrict (Icc shiftedCappedShellGlobalCommonLeft hiAngle)).prod volume))
    (hDmem : MemLp (fun p : Real × Euclidean 2 =>
      shiftedChartedCappedTelescopingFieldDeriv C j s q hqcompact a eps K n i p.1 p.2) 2
      ((volume.restrict (Icc shiftedCappedShellGlobalCommonLeft hiAngle)).prod volume))
    (hfrequency0 : (∫ p : Real × Euclidean 2,
      ‖S.multiplier p.1 p.2‖ ^ (2 : Nat) ∂
        ((volume.restrict (Icc shiftedCappedShellGlobalCommonLeft hiAngle)).prod volume)) ≤ E0)
    (hfrequency1 : (∫ p : Real × Euclidean 2,
      ‖S.multiplierDeriv p.1 p.2‖ ^ (2 : Nat) ∂
        ((volume.restrict (Icc shiftedCappedShellGlobalCommonLeft hiAngle)).prod volume)) ≤ E1)
    (hE : 0 ≤ E) (hqscale : 0 < qscale)
    (hE0scale : E0 ≤ qscale⁻¹ * E) (hE1scale : E1 ≤ qscale * E) :
    Measurable (fun y : Euclidean 2 =>
      ⨆ theta : Icc shiftedCappedShellGlobalCommonLeft hiAngle, ENNReal.ofReal
        (‖shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i theta.1 y‖ ^ 2)) ∧
      (∫⁻ y : Euclidean 2,
        ⨆ theta : Icc shiftedCappedShellGlobalCommonLeft hiAngle, ENNReal.ofReal
          (‖shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i theta.1 y‖ ^ 2)) ≤
        ENNReal.ofReal (2 * E) := by
  rcases shiftedCappedShell_energy_le_of_frequency_bounds
      C j s q hqcompact a eps K n i shiftedCappedShellGlobalCommonLeft hiAngle E0 E1
      S hfrequency0 hfrequency1 with ⟨hE0, hE1⟩
  exact shiftedChartedCappedTelescopingField_endpointZeroSobolev
    C j s q hqcompact a heps K n i hi hn hj hscale
    (hiAngle := hiAngle) (E := E) (E0 := E0) (E1 := E1) (qscale := qscale) hlohi
    hFcont hDcont hderiv hFmem hDmem hE0 hE1 hE hqscale hE0scale hE1scale

end

