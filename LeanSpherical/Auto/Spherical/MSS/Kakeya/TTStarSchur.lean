/-- The integrable time-difference envelope naturally produced by a central
bound plus two integrations by parts on an outer circle shell. -/
def quadraticTimeEnvelope (Lambda t s : Real) : Real :=
  (1 + (Lambda * (t - s)) ^ 2)⁻¹

theorem quadraticTimeEnvelope_symm (Lambda t s : Real) :
    quadraticTimeEnvelope Lambda t s = quadraticTimeEnvelope Lambda s t := by
  unfold quadraticTimeEnvelope
  congr 2
  ring

/-- The elementary central/outer splice: a uniform central bound together
with second-order nonstationary decay away from the diagonal is dominated by
the integrable quadratic envelope. -/
theorem le_two_mul_inv_one_add_sq_of_central_outer
    {C x r : Real} (hC : 0 ≤ C) (hx : 0 ≤ x)
    (hcentral : r ≤ C)
    (houter : x ≠ 0 → r ≤ C * (x ^ 2)⁻¹) :
    r ≤ (2 * C) * (1 + x ^ 2)⁻¹ := by
  have hden_pos : 0 < 1 + x ^ 2 := by positivity
  by_cases hx_one : x ≤ 1
  · have hx_sq : x ^ 2 ≤ 1 := by
      simpa using
        (sq_le_sq₀ hx (by norm_num : (0 : Real) ≤ 1)).mpr hx_one
    have hC_sq : C * x ^ 2 ≤ C := by
      calc
        C * x ^ 2 ≤ C * 1 := mul_le_mul_of_nonneg_left hx_sq hC
        _ = C := by ring
    calc
      r ≤ C := hcentral
      _ ≤ (2 * C) * (1 + x ^ 2)⁻¹ := by
        rw [show (2 * C) * (1 + x ^ 2)⁻¹ = (2 * C) / (1 + x ^ 2) by
          rw [div_eq_mul_inv]]
        apply (le_div_iff₀ hden_pos).mpr
        nlinarith
  · have hx_one' : 1 ≤ x := le_of_not_ge hx_one
    have hx_pos : 0 < x := lt_of_lt_of_le (by norm_num) hx_one'
    have hx_sq_pos : 0 < x ^ 2 := sq_pos_of_pos hx_pos
    have houter' : r ≤ C * (x ^ 2)⁻¹ := houter (ne_of_gt hx_pos)
    have hden_le : 1 + x ^ 2 ≤ 2 * x ^ 2 := by
      have hx_sq : 1 ≤ x ^ 2 := by
        simpa using
          (sq_le_sq₀ (by norm_num : (0 : Real) ≤ 1) hx).mpr hx_one'
      nlinarith
    have hinv : (x ^ 2)⁻¹ ≤ 2 * (1 + x ^ 2)⁻¹ := by
      rw [show (x ^ 2)⁻¹ = 1 / (x ^ 2) by rw [one_div],
        show 2 * (1 + x ^ 2)⁻¹ = 2 / (1 + x ^ 2) by rw [div_eq_mul_inv]]
      exact (div_le_div_iff₀ hx_sq_pos hden_pos).mpr (by simpa using hden_le)
    calc
      r ≤ C * (x ^ 2)⁻¹ := houter'
      _ ≤ C * (2 * (1 + x ^ 2)⁻¹) :=
        mul_le_mul_of_nonneg_left hinv hC
      _ = (2 * C) * (1 + x ^ 2)⁻¹ := by ring

/-- A literal time-kernel version of the central/outer splice.  The outer
hypothesis is exactly the order-two circle IBP decay with
`x = Λ * |t - s|`. -/
theorem norm_le_quadraticTimeEnvelope_of_central_outer
    {A rho Lambda t s : Real} (hArho : 0 ≤ A * rho) (hLambda : 0 ≤ Lambda)
    (L : Real → Real → Complex)
    (hcentral : ‖L t s‖ ≤ A * rho)
    (houter : Lambda * |t - s| ≠ 0 →
      ‖L t s‖ ≤ A * rho * ((Lambda * |t - s|) ^ 2)⁻¹) :
    ‖L t s‖ ≤ (2 * A) * rho * quadraticTimeEnvelope Lambda t s := by
  have hx : 0 ≤ Lambda * |t - s| :=
    mul_nonneg hLambda (abs_nonneg _)
  have hsplice := le_two_mul_inv_one_add_sq_of_central_outer
    hArho hx hcentral houter
  calc
    ‖L t s‖ ≤ (2 * (A * rho)) *
        (1 + (Lambda * |t - s|) ^ 2)⁻¹ := hsplice
    _ = (2 * A) * rho * quadraticTimeEnvelope Lambda t s := by
      unfold quadraticTimeEnvelope
      have habs_sq : (Lambda * |t - s|) ^ 2 =
          (Lambda * (t - s)) ^ 2 := by
        calc
          (Lambda * |t - s|) ^ 2 = Lambda ^ 2 * |t - s| ^ 2 := by
            rw [mul_pow]
          _ = Lambda ^ 2 * (t - s) ^ 2 := by rw [sq_abs]
          _ = (Lambda * (t - s)) ^ 2 := by rw [mul_pow]
      rw [habs_sq]
      ring

/-- Its mass on any oriented finite interval is at most `π / Λ`.  This is the
row/column estimate that converts a second-order circle-shell envelope into
a continuous Schur bound. -/
theorem intervalIntegral_quadraticTimeEnvelope_le_pi_div
    {a b Lambda t : Real} (hLambda : 0 < Lambda) :
    (∫ s in a..b, quadraticTimeEnvelope Lambda t s) ≤ Real.pi / Lambda := by
  have hchange : Lambda * (∫ s in a..b, quadraticTimeEnvelope Lambda t s) =
      ∫ u in (Lambda * t - Lambda * b)..(Lambda * t - Lambda * a),
        (1 + u ^ 2)⁻¹ := by
    convert intervalIntegral.mul_integral_comp_sub_mul
      (f := fun u : Real => (1 + u ^ 2)⁻¹)
      (a := a) (b := b) (c := Lambda) (d := Lambda * t) using 1;
      simp only [quadraticTimeEnvelope]
    all_goals ring_nf
  have hbound :
      (∫ u in (Lambda * t - Lambda * b)..(Lambda * t - Lambda * a),
        (1 + u ^ 2)⁻¹) ≤ Real.pi := by
    rw [integral_inv_one_add_sq]
    linarith [Real.arctan_lt_pi_div_two (Lambda * t - Lambda * a),
      Real.neg_pi_div_two_lt_arctan (Lambda * t - Lambda * b)]
  apply (le_div_iff₀ hLambda).mpr
  calc
    (∫ s in a..b, quadraticTimeEnvelope Lambda t s) * Lambda =
        Lambda * (∫ s in a..b, quadraticTimeEnvelope Lambda t s) := by ring
    _ = ∫ u in (Lambda * t - Lambda * b)..(Lambda * t - Lambda * a),
        (1 + u ^ 2)⁻¹ := hchange
    _ ≤ Real.pi := hbound

