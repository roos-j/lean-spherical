/-- Global all-time Schur rows/columns in the library Fourier normalization.
The conclusion retains the exact `2*pi` parameter, so no normalization is
hidden when this is inserted into the fixed-frequency TT* energy. -/
theorem exists_outerCircleFourierCharProductKernel_global_row_column_schur
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, 0 < lambda →
        (∀ t : Real,
          Integrable (fun s : Real => ‖outerCircleFourierCharProductKernel rho lambda t s‖)
            volume ∧
          (∫ s : Real, ‖outerCircleFourierCharProductKernel rho lambda t s‖) ≤
            (2 * B) * rho * (Real.pi / (((2 * Real.pi) * lambda) * rho ^ 2))) ∧
        (∀ s : Real,
          Integrable (fun t : Real => ‖outerCircleFourierCharProductKernel rho lambda t s‖)
            volume ∧
          (∫ t : Real, ‖outerCircleFourierCharProductKernel rho lambda t s‖) ≤
            (2 * B) * rho * (Real.pi / (((2 * Real.pi) * lambda) * rho ^ 2))) := by
  rcases exists_outerCircleTTStarProductTimeKernel_global_row_column_schur
      hrhoMax hrhoMax_small with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda
  have htwopi_lambda : 0 < (2 * Real.pi) * lambda :=
    mul_pos (mul_pos (by norm_num) Real.pi_pos) hlambda
  rcases hbound rho hrho ((2 * Real.pi) * lambda) htwopi_lambda with
    ⟨hright, hleft⟩
  constructor
  · intro t
    rcases hright t with ⟨hint, hmass⟩
    refine ⟨?_, ?_⟩
    · apply hint.congr
      filter_upwards with s
      rw [← norm_outerCircleFourierCharProductKernel_eq_positive]
    · calc
        (∫ s : Real, ‖outerCircleFourierCharProductKernel rho lambda t s‖) =
            ∫ s : Real, ‖outerCircleTTStarProductTimeKernel rho
              ((2 * Real.pi) * lambda) t s‖ := by
              apply integral_congr_ae
              filter_upwards with s
              rw [norm_outerCircleFourierCharProductKernel_eq_positive]
        _ ≤ (2 * B) * rho *
            (Real.pi / (((2 * Real.pi) * lambda) * rho ^ 2)) := hmass
  · intro s
    rcases hleft s with ⟨hint, hmass⟩
    refine ⟨?_, ?_⟩
    · apply hint.congr
      filter_upwards with t
      rw [← norm_outerCircleFourierCharProductKernel_eq_positive]
    · calc
        (∫ t : Real, ‖outerCircleFourierCharProductKernel rho lambda t s‖) =
            ∫ t : Real, ‖outerCircleTTStarProductTimeKernel rho
              ((2 * Real.pi) * lambda) t s‖ := by
              apply integral_congr_ae
              filter_upwards with t
              rw [norm_outerCircleFourierCharProductKernel_eq_positive]
        _ ≤ (2 * B) * rho *
            (Real.pi / (((2 * Real.pi) * lambda) * rho ^ 2)) := hmass

/-- Fixed-frequency `E₀` Schur bound for the exact Fourier-character outer
circle product kernel.  All product-integrability inputs are exposed rather
than inferred: the finite Schwartz-tensor application supplies them through
its concrete Fubini calculation. -/
theorem exists_outerCircleFourierCharProductKernel_quadratic_E0
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, 0 < lambda →
      ∀ H : Real → Complex,
        Integrable (fun t : Real => ‖H t‖ ^ 2) volume →
        Integrable (fun p : Real × Real =>
          ‖outerCircleFourierCharProductKernel rho lambda p.1 p.2‖ *
            ‖H p.1‖ * ‖H p.2‖) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          ‖outerCircleFourierCharProductKernel rho lambda p.1 p.2‖ *
            ‖H p.1‖ ^ 2) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          ‖outerCircleFourierCharProductKernel rho lambda p.1 p.2‖ *
            ‖H p.2‖ ^ 2) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          outerCircleFourierCharProductKernel rho lambda p.1 p.2 * H p.1 *
            starRingEnd Complex (H p.2)) (volume.prod volume) →
        ‖∫ t : Real, ∫ s : Real,
          outerCircleFourierCharProductKernel rho lambda t s * H t *
            starRingEnd Complex (H s)‖ ≤
          (B / (lambda * rho)) * ∫ t : Real, ‖H t‖ ^ 2 := by
  rcases exists_outerCircleFourierCharProductKernel_global_row_column_schur
      hrhoMax hrhoMax_small with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda H hHsq hquad hleft hright hcomplex
  have hrho_pos : 0 < rho := hrho.1
  rcases hbound rho hrho lambda hlambda with ⟨hrows, _⟩
  let R : Real := (2 * B) * rho *
    (Real.pi / (((2 * Real.pi) * lambda) * rho ^ 2))
  have hsymm : ∀ t s : Real,
      ‖outerCircleFourierCharProductKernel rho lambda t s‖ =
        ‖outerCircleFourierCharProductKernel rho lambda s t‖ := by
    intro t s
    calc
      ‖outerCircleFourierCharProductKernel rho lambda t s‖ =
          ‖outerCircleTTStarProductTimeKernel rho ((2 * Real.pi) * lambda) t s‖ :=
        norm_outerCircleFourierCharProductKernel_eq_positive rho lambda t s
      _ = ‖outerCircleTTStarProductTimeKernel rho ((2 * Real.pi) * lambda) s t‖ :=
        norm_outerCircleTTStarProductTimeKernel_symm rho ((2 * Real.pi) * lambda) t s
      _ = ‖outerCircleFourierCharProductKernel rho lambda s t‖ :=
        (norm_outerCircleFourierCharProductKernel_eq_positive rho lambda s t).symm
  have hrow : ∀ t : Real,
      Integrable (fun s : Real => ‖outerCircleFourierCharProductKernel rho lambda t s‖)
        volume := by
    intro t
    exact (hrows t).1
  have hrowbound : ∀ t : Real,
      (∫ s : Real, ‖outerCircleFourierCharProductKernel rho lambda t s‖) ≤ R := by
    intro t
    exact (hrows t).2
  have hschur := norm_integral_integral_le_of_symmetricSchur
    (outerCircleFourierCharProductKernel rho lambda) R hsymm hrow hrowbound
    H hHsq hquad hleft hright hcomplex
  have hR : R = B / (lambda * rho) := by
    dsimp [R]
    field_simp [Real.pi_ne_zero, ne_of_gt hlambda, ne_of_gt hrho_pos]
  rw [hR] at hschur
  exact hschur

/-- The preceding `E₀` estimate instantiated at the actual finite
Schwartz-tensor time datum.  This is the clean fixed-frequency API intended
for the subsequent integration in `xi`; its four displayed Fubini premises
are the only remaining analytic bookkeeping, not hidden assumptions. -/
theorem exists_outerShellFiniteTensor_quadratic_E0
    {ι : Type*} (s0 : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
