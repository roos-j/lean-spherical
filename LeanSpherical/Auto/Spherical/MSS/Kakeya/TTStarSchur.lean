section Auto.Spherical.MSS

open Filter MeasureTheory Set
open Auto.Spherical.SurfaceMeasureDecay

noncomputable section

/-- The closed scaled annulus is measurable.  Keeping this local avoids making
the elementary set-theoretic fact another dependency of the sector package. -/
theorem measurableSet_scaledDyadicFrequencyAnnulus (lambda : Real) :
    MeasurableSet (scaledDyadicFrequencyAnnulus lambda) := by
  change MeasurableSet {xi : Euclidean 2 |
    lambda / 2 ≤ ‖xi‖ ∧ ‖xi‖ ≤ 2 * lambda}
  exact (measurableSet_le measurable_const continuous_norm.measurable).inter
    (measurableSet_le continuous_norm.measurable measurable_const)

/-- On the active annulus `[lambda/2,2lambda]`, the reciprocal Schur scale
is uniformly comparable to the common shell scale. -/
theorem reciprocal_annular_scale_le
    {lambda rho B x : Real} (hlambda : 0 < lambda) (hrho : 0 < rho)
    (hB : 0 ≤ B) (hlower : lambda / 2 ≤ x) :
    B / (x * rho) ≤ (2 * B) / (lambda * rho) := by
  have hx : 0 < x := by nlinarith
  have htwox : lambda ≤ 2 * x := by linarith
  have hmul : B * lambda ≤ B * (2 * x) :=
    mul_le_mul_of_nonneg_left htwox hB
  calc
    B / (x * rho) = (B / x) / rho := by
      field_simp [ne_of_gt hx, ne_of_gt hrho]
    _ ≤ ((2 * B) / lambda) / rho := by
      apply div_le_div_of_nonneg_right _ hrho.le
      apply (div_le_div_iff₀ hx hlambda).2
      nlinarith [hmul]
    _ = (2 * B) / (lambda * rho) := by
      field_simp [ne_of_gt hlambda, ne_of_gt hrho]

/-- The direct phase scale has the companion annular comparison. -/
theorem direct_annular_scale_le
    {lambda rho B x : Real} (hlambda : 0 < lambda) (hrho : 0 < rho)
    (hB : 0 ≤ B) (hupper : x ≤ 2 * lambda) :
    B * (x * rho) ≤ (2 * B) * (lambda * rho) := by
  calc
    B * (x * rho) = (B * rho) * x := by ring
    _ ≤ (B * rho) * (2 * lambda) :=
      mul_le_mul_of_nonneg_left hupper (mul_nonneg hB hrho.le)
    _ = (2 * B) * (lambda * rho) := by ring

/-- Integrating a pointwise annular reciprocal-scale fibre estimate gives a
single common E₀ scale. -/
theorem integral_le_common_reciprocal_scale_of_annular
    {lambda rho B : Real} (hlambda : 0 < lambda) (hrho : 0 < rho)
    (hB : 0 ≤ B)
    (e h : Euclidean 2 -> Real)
    (he : Integrable e (volume.restrict (scaledDyadicFrequencyAnnulus lambda)))
    (hh : Integrable h (volume.restrict (scaledDyadicFrequencyAnnulus lambda)))
    (hpoint : ∀ᵐ xi ∂(volume.restrict (scaledDyadicFrequencyAnnulus lambda)),
      e xi ≤ (B / (‖xi‖ * rho)) * h xi)
    (hnonneg : ∀ᵐ xi ∂(volume.restrict (scaledDyadicFrequencyAnnulus lambda)),
      0 ≤ h xi) :
    (∫ xi : Euclidean 2, e xi ∂(volume.restrict (scaledDyadicFrequencyAnnulus lambda))) ≤
      ((2 * B) / (lambda * rho)) *
        ∫ xi : Euclidean 2, h xi ∂(volume.restrict (scaledDyadicFrequencyAnnulus lambda)) := by
  let mu : Measure (Euclidean 2) := volume.restrict (scaledDyadicFrequencyAnnulus lambda)
  have hmajor : Integrable (fun xi : Euclidean 2 =>
      ((2 * B) / (lambda * rho)) * h xi) mu :=
    hh.const_mul _
  have hbound : ∀ᵐ xi ∂mu,
      e xi ≤ ((2 * B) / (lambda * rho)) * h xi := by
    filter_upwards [hpoint, hnonneg,
      ae_restrict_mem (measurableSet_scaledDyadicFrequencyAnnulus lambda)] with xi hpointxi hnonnegxi hxi
    have hscale := reciprocal_annular_scale_le hlambda hrho hB hxi.1
    exact hpointxi.trans
      (mul_le_mul_of_nonneg_right hscale hnonnegxi)
  calc
    (∫ xi : Euclidean 2, e xi ∂mu) ≤
        ∫ xi : Euclidean 2, ((2 * B) / (lambda * rho)) * h xi ∂mu :=
      integral_mono_ae he hmajor hbound
    _ = ((2 * B) / (lambda * rho)) * ∫ xi : Euclidean 2, h xi ∂mu :=
      integral_const_mul _ _

/-- The same integration step for the direct phase scale. -/
theorem integral_le_common_direct_scale_of_annular
    {lambda rho B : Real} (hlambda : 0 < lambda) (hrho : 0 < rho)
    (hB : 0 ≤ B)
    (e h : Euclidean 2 -> Real)
    (he : Integrable e (volume.restrict (scaledDyadicFrequencyAnnulus lambda)))
    (hh : Integrable h (volume.restrict (scaledDyadicFrequencyAnnulus lambda)))
    (hpoint : ∀ᵐ xi ∂(volume.restrict (scaledDyadicFrequencyAnnulus lambda)),
      e xi ≤ (B * (‖xi‖ * rho)) * h xi)
    (hnonneg : ∀ᵐ xi ∂(volume.restrict (scaledDyadicFrequencyAnnulus lambda)),
      0 ≤ h xi) :
    (∫ xi : Euclidean 2, e xi ∂(volume.restrict (scaledDyadicFrequencyAnnulus lambda))) ≤
      ((2 * B) * (lambda * rho)) *
        ∫ xi : Euclidean 2, h xi ∂(volume.restrict (scaledDyadicFrequencyAnnulus lambda)) := by
  let mu : Measure (Euclidean 2) := volume.restrict (scaledDyadicFrequencyAnnulus lambda)
  have hmajor : Integrable (fun xi : Euclidean 2 =>
      ((2 * B) * (lambda * rho)) * h xi) mu :=
    hh.const_mul _
  have hbound : ∀ᵐ xi ∂mu,
      e xi ≤ ((2 * B) * (lambda * rho)) * h xi := by
    filter_upwards [hpoint, hnonneg,
      ae_restrict_mem (measurableSet_scaledDyadicFrequencyAnnulus lambda)] with xi hpointxi hnonnegxi hxi
    have hscale := direct_annular_scale_le hlambda hrho hB hxi.2
    exact hpointxi.trans
      (mul_le_mul_of_nonneg_right hscale hnonnegxi)
  calc
    (∫ xi : Euclidean 2, e xi ∂mu) ≤
        ∫ xi : Euclidean 2, ((2 * B) * (lambda * rho)) * h xi ∂mu :=
      integral_mono_ae he hmajor hbound
    _ = ((2 * B) * (lambda * rho)) * ∫ xi : Euclidean 2, h xi ∂mu :=
      integral_const_mul _ _

end

end Auto.Spherical.MSS
end
