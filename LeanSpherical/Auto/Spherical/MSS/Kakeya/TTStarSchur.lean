/-- Whole-line Fourier-character Schur rows and columns for any joint smooth
self-conjugate product amplitude. -/
theorem exists_outerCircleProfileFourierCharProductKernel_global_row_column_schur
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (A : Real × Real -> Complex) (hA0 : HasJointSndSmooth 0 A)
    (hA2 : HasJointSndSmooth 2 A)
    (hleft : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds 2] 0)
    (hstar : ∀ p, starRingEnd Complex (A p) = A p) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, 0 < lambda →
        (∀ t : Real,
          Integrable (fun s : Real =>
            ‖outerCircleProfileFourierCharProductKernel A rho lambda t s‖) volume ∧
          (∫ s : Real,
            ‖outerCircleProfileFourierCharProductKernel A rho lambda t s‖) ≤
            (2 * B) * rho * (Real.pi / (((2 * Real.pi) * lambda) * rho ^ 2))) ∧
        (∀ s : Real,
          Integrable (fun t : Real =>
            ‖outerCircleProfileFourierCharProductKernel A rho lambda t s‖) volume ∧
          (∫ t : Real,
            ‖outerCircleProfileFourierCharProductKernel A rho lambda t s‖) ≤
            (2 * B) * rho * (Real.pi / (((2 * Real.pi) * lambda) * rho ^ 2))) := by
  rcases exists_outerCircleProfileProductTimeKernel_global_row_column_schur
      hrhoMax hrhoMax_small A hA0 hA2 hleft hright hstar with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda
  have htwopi : 0 < (2 * Real.pi) * lambda := by positivity
  rcases hbound rho hrho ((2 * Real.pi) * lambda) htwopi with ⟨hrows, hcols⟩
  constructor
  · intro t
    rcases hrows t with ⟨hint, hmass⟩
    refine ⟨?_, ?_⟩
    · apply hint.congr
      filter_upwards with s
      rw [← norm_outerCircleProfileFourierCharProductKernel_eq_positive A hstar]
    · calc
        (∫ s : Real,
          ‖outerCircleProfileFourierCharProductKernel A rho lambda t s‖) =
            ∫ s : Real,
              ‖outerCircleProfileProductTimeKernel A rho ((2 * Real.pi) * lambda) t s‖ := by
              apply integral_congr_ae
              filter_upwards with s
              rw [norm_outerCircleProfileFourierCharProductKernel_eq_positive A hstar]
        _ ≤ (2 * B) * rho *
            (Real.pi / (((2 * Real.pi) * lambda) * rho ^ 2)) := hmass
  · intro s
    rcases hcols s with ⟨hint, hmass⟩
    refine ⟨?_, ?_⟩
    · apply hint.congr
      filter_upwards with t
      rw [← norm_outerCircleProfileFourierCharProductKernel_eq_positive A hstar]
    · calc
        (∫ t : Real,
          ‖outerCircleProfileFourierCharProductKernel A rho lambda t s‖) =
            ∫ t : Real,
              ‖outerCircleProfileProductTimeKernel A rho ((2 * Real.pi) * lambda) t s‖ := by
              apply integral_congr_ae
              filter_upwards with t
              rw [norm_outerCircleProfileFourierCharProductKernel_eq_positive A hstar]
        _ ≤ (2 * B) * rho *
            (Real.pi / (((2 * Real.pi) * lambda) * rho ^ 2)) := hmass

/-- Fixed-frequency complex Schur estimate in Fourier-character
normalization for a joint product amplitude. -/
theorem exists_outerCircleProfileFourierCharProductKernel_quadratic_E0
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (A : Real × Real -> Complex) (hA0 : HasJointSndSmooth 0 A)
    (hA2 : HasJointSndSmooth 2 A)
    (hleft : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds 2] 0)
    (hstar : ∀ p, starRingEnd Complex (A p) = A p) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, 0 < lambda →
      ∀ H : Real -> Complex,
        Integrable (fun t : Real => ‖H t‖ ^ 2) volume →
        Integrable (fun p : Real × Real =>
          ‖outerCircleProfileFourierCharProductKernel A rho lambda p.1 p.2‖ *
            ‖H p.1‖ * ‖H p.2‖) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          ‖outerCircleProfileFourierCharProductKernel A rho lambda p.1 p.2‖ *
            ‖H p.1‖ ^ 2) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          ‖outerCircleProfileFourierCharProductKernel A rho lambda p.1 p.2‖ *
            ‖H p.2‖ ^ 2) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          outerCircleProfileFourierCharProductKernel A rho lambda p.1 p.2 * H p.1 *
            starRingEnd Complex (H p.2)) (volume.prod volume) →
        ‖∫ t : Real, ∫ s : Real,
          outerCircleProfileFourierCharProductKernel A rho lambda t s * H t *
            starRingEnd Complex (H s)‖ ≤
          (B / (lambda * rho)) * ∫ t : Real, ‖H t‖ ^ 2 := by
  rcases exists_outerCircleProfileFourierCharProductKernel_global_row_column_schur
      hrhoMax hrhoMax_small A hA0 hA2 hleft hright hstar with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda H hHsq hquad hleftInt hrightInt hcomplex
  have hrho_pos : 0 < rho := hrho.1
  rcases hbound rho hrho lambda hlambda with ⟨hrows, _⟩
  let R : Real := (2 * B) * rho *
    (Real.pi / (((2 * Real.pi) * lambda) * rho ^ 2))
  have hsymm : ∀ t s : Real,
      ‖outerCircleProfileFourierCharProductKernel A rho lambda t s‖ =
        ‖outerCircleProfileFourierCharProductKernel A rho lambda s t‖ := by
    intro t s
    calc
      ‖outerCircleProfileFourierCharProductKernel A rho lambda t s‖ =
          ‖outerCircleProfileProductTimeKernel A rho ((2 * Real.pi) * lambda) t s‖ :=
        norm_outerCircleProfileFourierCharProductKernel_eq_positive A hstar rho lambda t s
      _ = ‖outerCircleProfileProductTimeKernel A rho ((2 * Real.pi) * lambda) s t‖ :=
        norm_outerCircleProfileProductTimeKernel_symm A hstar
          rho ((2 * Real.pi) * lambda) t s
      _ = ‖outerCircleProfileFourierCharProductKernel A rho lambda s t‖ :=
        (norm_outerCircleProfileFourierCharProductKernel_eq_positive A hstar rho lambda s t).symm
  have hrow : ∀ t : Real,
      Integrable (fun s : Real =>
        ‖outerCircleProfileFourierCharProductKernel A rho lambda t s‖) volume := by
    intro t
    exact (hrows t).1
  have hrowbound : ∀ t : Real,
      (∫ s : Real,
        ‖outerCircleProfileFourierCharProductKernel A rho lambda t s‖) ≤ R := by
    intro t
    exact (hrows t).2
  have hschur := norm_integral_integral_le_of_symmetricSchur
    (outerCircleProfileFourierCharProductKernel A rho lambda) R hsymm hrow hrowbound
    H hHsq hquad hleftInt hrightInt hcomplex
  have hR : R = B / (lambda * rho) := by
    dsimp [R]
    field_simp [Real.pi_ne_zero, ne_of_gt hlambda, ne_of_gt hrho_pos]
  rw [hR] at hschur
  exact hschur

/-- Cutoff-derivative scale wrapper for the generic Fourier-character
quadratic estimate. -/
theorem exists_outerCircleProfileFourierCharProductKernel_cutoff_E1
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (A : Real × Real -> Complex) (hA0 : HasJointSndSmooth 0 A)
    (hA2 : HasJointSndSmooth 2 A)
    (hleft : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds 2] 0)
    (hstar : ∀ p, starRingEnd Complex (A p) = A p) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, 0 < lambda →
      ∀ H : Real -> Complex,
        Integrable (fun t : Real => ‖H t‖ ^ 2) volume →
        Integrable (fun p : Real × Real =>
          ‖outerCircleProfileFourierCharProductKernel A rho lambda p.1 p.2‖ *
            ‖H p.1‖ * ‖H p.2‖) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          ‖outerCircleProfileFourierCharProductKernel A rho lambda p.1 p.2‖ *
            ‖H p.1‖ ^ 2) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          ‖outerCircleProfileFourierCharProductKernel A rho lambda p.1 p.2‖ *
            ‖H p.2‖ ^ 2) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          outerCircleProfileFourierCharProductKernel A rho lambda p.1 p.2 * H p.1 *
            starRingEnd Complex (H p.2)) (volume.prod volume) →
        ‖(((rho ^ 2)⁻¹ : Real) : Complex) *
          ∫ t : Real, ∫ s : Real,
            outerCircleProfileFourierCharProductKernel A rho lambda t s * H t *
              starRingEnd Complex (H s)‖ ≤
          ((rho ^ 2)⁻¹) * (B / (lambda * rho)) * ∫ t : Real, ‖H t‖ ^ 2 := by
  rcases exists_outerCircleProfileFourierCharProductKernel_quadratic_E0
      hrhoMax hrhoMax_small A hA0 hA2 hleft hright hstar with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda H hHsq hquad hleftInt hrightInt hcomplex
  have hbase := hbound rho hrho lambda hlambda H hHsq hquad hleftInt hrightInt hcomplex
  have hfactor_nonneg : 0 ≤ (rho ^ 2)⁻¹ := inv_nonneg.mpr (sq_nonneg rho)
  calc
    ‖(((rho ^ 2)⁻¹ : Real) : Complex) *
        ∫ t : Real, ∫ s : Real,
          outerCircleProfileFourierCharProductKernel A rho lambda t s * H t *
            starRingEnd Complex (H s)‖ =
        (rho ^ 2)⁻¹ * ‖∫ t : Real, ∫ s : Real,
          outerCircleProfileFourierCharProductKernel A rho lambda t s * H t *
            starRingEnd Complex (H s)‖ := by
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hfactor_nonneg]
    _ ≤ (rho ^ 2)⁻¹ *
          ((B / (lambda * rho)) * ∫ t : Real, ‖H t‖ ^ 2) :=
      mul_le_mul_of_nonneg_left hbase hfactor_nonneg
    _ = ((rho ^ 2)⁻¹) * (B / (lambda * rho)) *
          ∫ t : Real, ‖H t‖ ^ 2 := by ring

/-- Phase-derivative scale wrapper for the generic Fourier-character
quadratic estimate. -/
theorem exists_outerCircleProfileFourierCharProductKernel_phaseFactor_E1
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (A : Real × Real -> Complex) (hA0 : HasJointSndSmooth 0 A)
    (hA2 : HasJointSndSmooth 2 A)
    (hleft : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
