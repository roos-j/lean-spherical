  intro rho hrho lambda hlambda W hWsq hquad hleftInt hrightInt hcomplex
  have hbase := hbound rho hrho lambda hlambda W hWsq hquad hleftInt hrightInt hcomplex
  have hfactor_nonneg : 0 ≤ ((2 * Real.pi) * lambda * rho) ^ 2 := sq_nonneg _
