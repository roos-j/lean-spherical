noncomputable section

/-- The shifted cutoff as one fixed profile in the physical difference
variable `theta-alpha`. -/
noncomputable def shiftedCappedTelescopingCutoffProfile
    (eps : Real) (K n i : Nat) (v : Real) : Real :=
  shiftedStationaryPreweightProfile n (v - stationaryShift n) *
    cappedTelescopingCutoff eps (Real.pi / 2) K i (v - stationaryShift n)

theorem shiftedCappedTelescopingCutoff_eq_profile
    (eps : Real) (K n i : Nat) (alpha theta : Real) :
    shiftedCappedTelescopingCutoff eps K n i alpha theta =
      shiftedCappedTelescopingCutoffProfile eps K n i (theta - alpha) := by
  unfold shiftedCappedTelescopingCutoffProfile shiftedCappedTelescopingCutoff
  rw [shiftedStationaryPreweight_eq_profile]
  congr 1 <;> ring

theorem contDiff_cappedTelescopingCutoff
    (eps R : Real) (K i : Nat) :
    ContDiff Real (⊤ : ℕ∞) (cappedTelescopingCutoff eps R K i) := by
  by_cases hi : i = K + 1
  · subst i
    rw [show cappedTelescopingCutoff eps R K (K + 1) =
        cappedTerminalShellCutoff eps R K by
      funext u
      exact cappedTelescopingCutoff_eq_terminal eps R K u]
    exact contDiff_cappedTerminalShellCutoff eps R K
  · rw [show cappedTelescopingCutoff eps R K i = telescopingShellCutoff eps i by
      funext u
      unfold cappedTelescopingCutoff
      rw [if_neg hi]]
    exact contDiff_telescopingShellCutoff eps i

theorem contDiff_shiftedCappedTelescopingCutoffProfile
    (eps : Real) (K n i : Nat) :
    ContDiff Real (⊤ : ℕ∞) (shiftedCappedTelescopingCutoffProfile eps K n i) := by
  unfold shiftedCappedTelescopingCutoffProfile
  have hshift : ContDiff Real (⊤ : ℕ∞)
      (fun v : Real => v - stationaryShift n) :=
    contDiff_id.sub contDiff_const
  exact ((contDiff_shiftedStationaryPreweightProfile n).comp hshift).mul
    ((contDiff_cappedTelescopingCutoff eps (Real.pi / 2) K i).comp hshift)

theorem hasDerivAt_shiftedCappedTelescopingCutoffProfile
    (eps : Real) (K n i : Nat) (u : Real) :
    HasDerivAt (shiftedCappedTelescopingCutoffProfile eps K n i)
      (deriv (shiftedCappedTelescopingCutoffProfile eps K n i) u) u := by
  exact ((contDiff_shiftedCappedTelescopingCutoffProfile eps K n i).differentiable
    (by simp) u).hasDerivAt

/-- The angular derivative field for one literal chart/shift/shell member. -/
noncomputable def shiftedChartedCappedTelescopingFieldDeriv
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (eps : Real) (K n i : Nat) (theta : Real) (y : Euclidean 2) : Complex :=
  angularCutoffFiniteTensorShellFieldDeriv s (chartProfiles C j q)
    (chartProfiles_compact C j q hqcompact) a
    (shiftedCappedTelescopingCutoffProfile eps K n i)
    (deriv (shiftedCappedTelescopingCutoffProfile eps K n i))
    (C.angle j) theta y

theorem shiftedChartedCappedTelescopingField_eq_angularCutoff
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (eps : Real) (K n i : Nat) (theta : Real) (y : Euclidean 2) :
    shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i theta y =
      angularCutoffFiniteTensorShellField s (chartProfiles C j q)
        (chartProfiles_compact C j q hqcompact) a
        (shiftedCappedTelescopingCutoffProfile eps K n i)
        (C.angle j) theta y := by
  unfold shiftedChartedCappedTelescopingField angularCutoffFiniteTensorShellField
  apply congrArg (fun f : Euclidean 2 -> Complex => FourierTransform.fourierInv f y)
  funext xi
  unfold shiftedChartedCappedTelescopingMultiplier
    angularCutoffFiniteTensorMultiplier
  rw [shiftedCappedTelescopingCutoff_eq_profile]
  change (shiftedCappedTelescopingCutoffProfile eps K n i
      (theta - C.angle j xi) : Complex) * _ = _
  rfl

/-- The common global endpoint is a genuine zero for the profile form of
every chart/shift/shell cutoff. -/
theorem shiftedCappedTelescopingCutoffProfile_eq_zero_at_globalCommonLeft
    {kappa : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    {eps : Real} (heps : 0 < eps) (K n i : Nat)
    (hi : i ∈ Finset.range (K + 2)) (hn : n < 7)
    (hj : j ∈ charts) (hscale : (2 : Real) ^ K * eps ≤ Real.pi / 2)
    (xi : Euclidean 2) :
    shiftedCappedTelescopingCutoffProfile eps K n i
      (shiftedCappedShellGlobalCommonLeft - C.angle j xi) = 0 := by
  rw [← shiftedCappedTelescopingCutoff_eq_profile]
  exact shiftedCappedTelescopingCutoff_eq_zero_at_globalCommonLeft heps K n i hi
    (C.angle j xi) hn (C.angle_lower j hj xi) hscale

/-- Endpoint-zero GN closure for one literal shifted chart/shell field.  The
spatial continuity, dominated differentiation, and Plancherel energies are
explicit inputs; the conclusion is exactly the `B jni` format consumed by
the finite shifted capped reassembly. -/
theorem shiftedChartedCappedTelescopingField_endpointZeroSobolev
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    {eps : Real} (heps : 0 < eps) (K n i : Nat)
    (hi : i ∈ Finset.range (K + 2)) (hn : n < 7) (hj : j ∈ charts)
    (hscale : (2 : Real) ^ K * eps ≤ Real.pi / 2)
    {hiAngle E E0 E1 qscale : Real}
    (hlohi : shiftedCappedShellGlobalCommonLeft ≤ hiAngle)
    (hFcont : Continuous (Function.uncurry
      (shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i)))
    (hDcont : Continuous (Function.uncurry
      (shiftedChartedCappedTelescopingFieldDeriv C j s q hqcompact a eps K n i)))
    (hderiv : ∀ theta y, HasDerivAt
      (fun r => shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i r y)
      (shiftedChartedCappedTelescopingFieldDeriv C j s q hqcompact a eps K n i theta y) theta)
    (hFmem : MemLp (fun p : Real × Euclidean 2 =>
      shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i p.1 p.2) 2
      ((volume.restrict (Icc shiftedCappedShellGlobalCommonLeft hiAngle)).prod volume))
    (hDmem : MemLp (fun p : Real × Euclidean 2 =>
      shiftedChartedCappedTelescopingFieldDeriv C j s q hqcompact a eps K n i p.1 p.2) 2
      ((volume.restrict (Icc shiftedCappedShellGlobalCommonLeft hiAngle)).prod volume))
    (hE0 : (∫ p : Real × Euclidean 2,
      ‖shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i p.1 p.2‖ ^ 2 ∂
      ((volume.restrict (Icc shiftedCappedShellGlobalCommonLeft hiAngle)).prod volume)) ≤ E0)
    (hE1 : (∫ p : Real × Euclidean 2,
      ‖shiftedChartedCappedTelescopingFieldDeriv C j s q hqcompact a eps K n i p.1 p.2‖ ^ 2 ∂
      ((volume.restrict (Icc shiftedCappedShellGlobalCommonLeft hiAngle)).prod volume)) ≤ E1)
    (hE : 0 ≤ E) (hqscale : 0 < qscale)
    (hE0scale : E0 ≤ qscale⁻¹ * E) (hE1scale : E1 ≤ qscale * E) :
    Measurable (fun y : Euclidean 2 =>
      ⨆ theta : Icc shiftedCappedShellGlobalCommonLeft hiAngle, ENNReal.ofReal
        (‖shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i theta.1 y‖ ^ 2)) ∧
      (∫⁻ y : Euclidean 2,
        ⨆ theta : Icc shiftedCappedShellGlobalCommonLeft hiAngle, ENNReal.ofReal
          (‖shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i theta.1 y‖ ^ 2)) ≤
        ENNReal.ofReal (2 * E) := by
  have hzero : ∀ y : Euclidean 2,
      shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i
        shiftedCappedShellGlobalCommonLeft y = 0 := by
    intro y
    rw [shiftedChartedCappedTelescopingField_eq_angularCutoff]
    apply angularCutoffFiniteTensorShellField_eq_zero_of_cutoff_zero
    intro xi
    exact shiftedCappedTelescopingCutoffProfile_eq_zero_at_globalCommonLeft
      C j heps K n i hi hn hj hscale xi
  exact endpointZeroAngularSobolev_of_reciprocal_energy hlohi hFcont hDcont hderiv
    hzero hFmem hDmem hE0 hE1 hE hqscale hE0scale hE1scale

end

