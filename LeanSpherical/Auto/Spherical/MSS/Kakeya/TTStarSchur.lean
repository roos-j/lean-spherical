section Auto.Spherical.MSS

open Filter MeasureTheory Set

noncomputable section

/-- After centring a shifted stationary patch and rescaling by its carrier,
the ordered-cover preweight is a joint smooth factor `q_n(r*u)`. -/
noncomputable def shiftedOuterParametricProfile
    (n : Nat) (lobe : Real -> Real) (p : Real × Real) : Real :=
  shiftedStationaryPreweightProfile n (p.1 * p.2) * lobe p.2

theorem contDiff_shiftedOuterParametricProfile
    (n : Nat) (lobe : Real -> Real) (hlobe : ContDiff Real (⊤ : ℕ∞) lobe) :
    ContDiff Real (⊤ : ℕ∞) (shiftedOuterParametricProfile n lobe) := by
  unfold shiftedOuterParametricProfile
  exact ((contDiff_shiftedStationaryPreweightProfile n).comp
    (contDiff_fst.mul contDiff_snd)).mul (hlobe.comp contDiff_snd)

theorem shiftedOuterParametricProfile_eventuallyEq_zero_left
    (n : Nat) {lobe : Real -> Real}
    (hleft : lobe =ᶠ[nhds (1 / 2 : Real)] 0) (rho : Real) :
    (fun u : Real => shiftedOuterParametricProfile n lobe (rho, u)) =ᶠ[
      nhds (1 / 2 : Real)] 0 := by
  filter_upwards [hleft] with u hu
  simp [shiftedOuterParametricProfile, hu]

theorem shiftedOuterParametricProfile_eventuallyEq_zero_right
    (n : Nat) {lobe : Real -> Real}
    (hright : lobe =ᶠ[nhds 2] 0) (rho : Real) :
    (fun u : Real => shiftedOuterParametricProfile n lobe (rho, u)) =ᶠ[nhds 2] 0 := by
  filter_upwards [hright] with u hu
  simp [shiftedOuterParametricProfile, hu]

/-- Joint smoothness of the real-square product amplitude consumed by the
parametric Fourier-character Schur package. -/
theorem contDiff_outerCircleParametricRealProfileProductAmplitude
    (g : Real × Real -> Real) (hg : ContDiff Real (⊤ : ℕ∞) g) :
    ContDiff Real (⊤ : ℕ∞) (outerCircleParametricRealProfileProductAmplitude g) := by
  unfold outerCircleParametricRealProfileProductAmplitude
  exact Complex.ofRealCLM.contDiff.comp (hg.pow 2)

theorem hasJointSndSmooth_outerCircleParametricRealProfileProductAmplitude
    (g : Real × Real -> Real) (hg : ContDiff Real (⊤ : ℕ∞) g) (N : Nat) :
    HasJointSndSmooth N (outerCircleParametricRealProfileProductAmplitude g) := by
  apply hasJointSndSmooth_of_contDiff
  exact contDiff_outerCircleParametricRealProfileProductAmplitude g hg

/-- The same square-product construction only needs finite joint angular
smoothness; this is essential for the removable `sinc` phase factor. -/
theorem hasJointSndSmooth_outerCircleParametricRealProfileProductAmplitude_of_hasJoint
    {g : Real × Real -> Real} {N : Nat} (hg : HasJointSndSmooth N g) :
    HasJointSndSmooth N (outerCircleParametricRealProfileProductAmplitude g) := by
  let gc : Real × Real -> Complex := fun p => (g p : Complex)
  have hgc : HasJointSndSmooth N gc := hg.ofReal
  have hsq : HasJointSndSmooth N (fun p => gc p * gc p) := hgc.mul hgc
  convert hsq using 1
  funext p
  simp [gc, outerCircleParametricRealProfileProductAmplitude, pow_two]

theorem outerCircleParametricRealProfileProductAmplitude_eventuallyEq_zero_left
    {g : Real × Real -> Real}
    (hleft : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0) (rho : Real) :
    (fun u : Real => outerCircleParametricRealProfileProductAmplitude g (rho, u)) =ᶠ[
      nhds (1 / 2 : Real)] 0 := by
  filter_upwards [hleft rho] with u hu
  simp [outerCircleParametricRealProfileProductAmplitude, hu]

theorem outerCircleParametricRealProfileProductAmplitude_eventuallyEq_zero_right
    {g : Real × Real -> Real}
    (hright : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds 2] 0) (rho : Real) :
    (fun u : Real => outerCircleParametricRealProfileProductAmplitude g (rho, u)) =ᶠ[
      nhds 2] 0 := by
  filter_upwards [hright rho] with u hu
  simp [outerCircleParametricRealProfileProductAmplitude, hu]

/-- The literal derivative in the normalized local coordinate, written via a
joint `fderiv` so that all carrier dependence stays smooth. -/
noncomputable def shiftedOuterParametricProfileSndDeriv
    (n : Nat) (lobe : Real -> Real) : Real × Real -> Real :=
  partialDerivSnd (shiftedOuterParametricProfile n lobe)

theorem contDiff_shiftedOuterParametricProfileSndDeriv
    (n : Nat) (lobe : Real -> Real) (hlobe : ContDiff Real (⊤ : ℕ∞) lobe) :
    ContDiff Real (⊤ : ℕ∞) (shiftedOuterParametricProfileSndDeriv n lobe) := by
  unfold shiftedOuterParametricProfileSndDeriv
  exact contDiff_partialDerivSnd _
    (contDiff_shiftedOuterParametricProfile n lobe hlobe)

theorem deriv_slice_shiftedOuterParametricProfile_eq_sndDeriv
    (n : Nat) (lobe : Real -> Real) (hlobe : ContDiff Real (⊤ : ℕ∞) lobe)
    (rho u : Real) :
    deriv (fun v : Real => shiftedOuterParametricProfile n lobe (rho, v)) u =
      shiftedOuterParametricProfileSndDeriv n lobe (rho, u) := by
  unfold shiftedOuterParametricProfileSndDeriv
  exact deriv_slice_eq_partialDerivSnd _
    ((contDiff_shiftedOuterParametricProfile n lobe hlobe).differentiable (by simp))
    rho u

theorem shiftedOuterParametricProfileSndDeriv_eventuallyEq_zero_left
    (n : Nat) {lobe : Real -> Real} (hlobe : ContDiff Real (⊤ : ℕ∞) lobe)
    (hleft : lobe =ᶠ[nhds (1 / 2 : Real)] 0) (rho : Real) :
    (fun u : Real => shiftedOuterParametricProfileSndDeriv n lobe (rho, u)) =ᶠ[
      nhds (1 / 2 : Real)] 0 := by
  have hbase := (shiftedOuterParametricProfile_eventuallyEq_zero_left n hleft rho).deriv
  filter_upwards [hbase] with u hu
  rw [← deriv_slice_shiftedOuterParametricProfile_eq_sndDeriv n lobe hlobe]
  simpa using hu

theorem shiftedOuterParametricProfileSndDeriv_eventuallyEq_zero_right
    (n : Nat) {lobe : Real -> Real} (hlobe : ContDiff Real (⊤ : ℕ∞) lobe)
    (hright : lobe =ᶠ[nhds 2] 0) (rho : Real) :
    (fun u : Real => shiftedOuterParametricProfileSndDeriv n lobe (rho, u)) =ᶠ[
      nhds 2] 0 := by
  have hbase := (shiftedOuterParametricProfile_eventuallyEq_zero_right n hright rho).deriv
  filter_upwards [hbase] with u hu
  rw [← deriv_slice_shiftedOuterParametricProfile_eq_sndDeriv n lobe hlobe]
  simpa using hu

/-- The phase part of the angular derivative introduces the smooth normalized
factor `u`; the physical scale is handled separately by `lambda*rho`. -/
noncomputable def shiftedOuterParametricPhaseProfile
    (n : Nat) (lobe : Real -> Real) (p : Real × Real) : Real :=
  p.2 * shiftedOuterParametricProfile n lobe p

theorem contDiff_shiftedOuterParametricPhaseProfile
    (n : Nat) (lobe : Real -> Real) (hlobe : ContDiff Real (⊤ : ℕ∞) lobe) :
    ContDiff Real (⊤ : ℕ∞) (shiftedOuterParametricPhaseProfile n lobe) := by
  unfold shiftedOuterParametricPhaseProfile
  exact contDiff_snd.mul (contDiff_shiftedOuterParametricProfile n lobe hlobe)

theorem shiftedOuterParametricPhaseProfile_eventuallyEq_zero_left
    (n : Nat) {lobe : Real -> Real}
    (hleft : lobe =ᶠ[nhds (1 / 2 : Real)] 0) (rho : Real) :
    (fun u : Real => shiftedOuterParametricPhaseProfile n lobe (rho, u)) =ᶠ[
      nhds (1 / 2 : Real)] 0 := by
  filter_upwards [shiftedOuterParametricProfile_eventuallyEq_zero_left n hleft rho] with u hu
  simp [shiftedOuterParametricPhaseProfile, hu]

theorem shiftedOuterParametricPhaseProfile_eventuallyEq_zero_right
    (n : Nat) {lobe : Real -> Real}
    (hright : lobe =ᶠ[nhds 2] 0) (rho : Real) :
    (fun u : Real => shiftedOuterParametricPhaseProfile n lobe (rho, u)) =ᶠ[
      nhds 2] 0 := by
  filter_upwards [shiftedOuterParametricProfile_eventuallyEq_zero_right n hright rho] with u hu
  simp [shiftedOuterParametricPhaseProfile, hu]

/-- Exact normalized phase profile.  Since
`outerCircleScaledDerivative r u = -sin(r*u)/r`, the physical angular phase
derivative is the displayed profile times the separate scale `lambda*r`. -/
noncomputable def shiftedOuterParametricScaledPhaseProfile
    (n : Nat) (lobe : Real -> Real) (p : Real × Real) : Real :=
  shiftedOuterParametricProfile n lobe p * outerCircleScaledDerivative p.1 p.2

theorem hasJointSndSmooth_shiftedOuterParametricScaledPhaseProfile
    (n : Nat) (lobe : Real -> Real) (hlobe : ContDiff Real (⊤ : ℕ∞) lobe)
    (N : Nat) :
    HasJointSndSmooth N (shiftedOuterParametricScaledPhaseProfile n lobe) := by
  unfold shiftedOuterParametricScaledPhaseProfile
  exact (hasJointSndSmooth_of_contDiff
    (shiftedOuterParametricProfile n lobe)
    (contDiff_shiftedOuterParametricProfile n lobe hlobe) N).mul_real
      (hasJointSndSmooth_outerCircleScaledDerivative N)

theorem shiftedOuterParametricScaledPhaseProfile_eventuallyEq_zero_left
    (n : Nat) {lobe : Real -> Real}
    (hleft : lobe =ᶠ[nhds (1 / 2 : Real)] 0) (rho : Real) :
    (fun u : Real => shiftedOuterParametricScaledPhaseProfile n lobe (rho, u)) =ᶠ[
      nhds (1 / 2 : Real)] 0 := by
  filter_upwards [shiftedOuterParametricProfile_eventuallyEq_zero_left n hleft rho] with u hu
  simp [shiftedOuterParametricScaledPhaseProfile, hu]

theorem shiftedOuterParametricScaledPhaseProfile_eventuallyEq_zero_right
    (n : Nat) {lobe : Real -> Real}
    (hright : lobe =ᶠ[nhds 2] 0) (rho : Real) :
    (fun u : Real => shiftedOuterParametricScaledPhaseProfile n lobe (rho, u)) =ᶠ[
      nhds 2] 0 := by
  filter_upwards [shiftedOuterParametricProfile_eventuallyEq_zero_right n hright rho] with u hu
  simp [shiftedOuterParametricScaledPhaseProfile, hu]

end

end Auto.Spherical.MSS
end
