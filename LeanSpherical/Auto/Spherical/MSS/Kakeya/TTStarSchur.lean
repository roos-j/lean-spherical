/-- The quadratic time-difference envelope has its exact whole-line mass.
This is the all-time version of the finite-interval `pi / Lambda` bound and
is the common interface for Schwartz temporal tensor data. -/
theorem integral_quadraticTimeEnvelope_univ_eq_pi_div
    {Lambda t : Real} (hLambda : 0 < Lambda) :
    (∫ s : Real, quadraticTimeEnvelope Lambda t s) = Real.pi / Lambda := by
  let f : Real → Real := fun u => (1 + u ^ 2)⁻¹
  have hfcont : Continuous f := by
    dsimp [f]
    apply Continuous.inv₀
    · fun_prop
    · intro u
      positivity
  have hrewrite : (fun s : Real => quadraticTimeEnvelope Lambda t s) =
      fun s => f (Lambda * (s - t)) := by
    funext s
    unfold quadraticTimeEnvelope
    dsimp [f]
    congr 2
    ring
  rw [hrewrite]
  have htranslation :
      (∫ s : Real, f (Lambda * (s - t))) =
        ∫ x : Real, f (Lambda * x) := by
    let g : Real → Real := fun x => f (Lambda * x)
    have hgcont : Continuous g :=
      hfcont.comp (continuous_const.mul continuous_id)
    have hmap : Measure.map (fun x : Real => x + (-t)) volume = volume :=
      map_add_right_eq_self volume (-t)
    have hphi : AEMeasurable (fun x : Real => x + (-t)) volume :=
      (continuous_id.add continuous_const).aemeasurable
    calc
      (∫ s : Real, f (Lambda * (s - t))) =
          ∫ s : Real, g (s + (-t)) := by
            apply integral_congr_ae
            filter_upwards with s
            simp only [g, sub_eq_add_neg]
      _ = ∫ x : Real, g x := by
        calc
          (∫ s : Real, g (s + (-t))) =
              ∫ x : Real, g x ∂Measure.map (fun x : Real => x + (-t)) volume :=
            (integral_map hphi hgcont.aestronglyMeasurable).symm
          _ = ∫ x : Real, g x := by rw [hmap]
      _ = ∫ x : Real, f (Lambda * x) := rfl
  rw [htranslation, Measure.integral_comp_mul_left]
  have hbase : (∫ x : Real, f x) = Real.pi := by
    simpa only [f] using integral_univ_inv_one_add_sq
  rw [hbase, smul_eq_mul, abs_of_pos (inv_pos.mpr hLambda)]
  rw [div_eq_mul_inv]
  ring

/-- The same whole-line quadratic envelope is integrable.  This deliberately
keeps the translation and dilation steps separate so subsequent Schur bounds
can use it as an ordinary Bochner-integrable majorant. -/
theorem integrable_quadraticTimeEnvelope_univ
    {Lambda t : Real} (hLambda : 0 < Lambda) :
    Integrable (fun s : Real => quadraticTimeEnvelope Lambda t s) volume := by
  let f : Real → Real := fun u => (1 + u ^ 2)⁻¹
  have hf : Integrable f volume := by
    simpa only [f] using integrable_inv_one_add_sq
  have hscale : Integrable (fun x : Real => f (Lambda * x)) volume :=
    hf.comp_mul_left' hLambda.ne'
  have htranslate : Integrable (fun s : Real => f (Lambda * (s - t))) volume := by
    simpa only [sub_eq_add_neg] using hscale.comp_sub_right t
  refine htranslate.congr ?_
  filter_upwards with s
  unfold quadraticTimeEnvelope
  dsimp only [f]
  congr 2
  ring

/-- Whole-line row Schur estimate for a complex time kernel dominated by the
quadratic central/outer envelope.  The ordinary integrability hypothesis is
kept explicit, which is exactly what the later Fubini/TT* layer supplies. -/
theorem integral_norm_le_of_quadraticTimeEnvelope_univ
    {A rho Lambda t : Real} (hLambda : 0 < Lambda) (hArho : 0 ≤ A * rho)
    (L : Real → Real → Complex)
    (hL_integrable : Integrable (fun s : Real => ‖L t s‖) volume)
    (hbound : ∀ s : Real,
      ‖L t s‖ ≤ A * rho * quadraticTimeEnvelope Lambda t s) :
    (∫ s : Real, ‖L t s‖) ≤ A * rho * (Real.pi / Lambda) := by
  have henv_integrable : Integrable (fun s : Real =>
      A * rho * quadraticTimeEnvelope Lambda t s) volume :=
    (integrable_quadraticTimeEnvelope_univ hLambda).const_mul (A * rho)
  calc
    (∫ s : Real, ‖L t s‖) ≤
        ∫ s : Real, A * rho * quadraticTimeEnvelope Lambda t s :=
      integral_mono hL_integrable henv_integrable hbound
    _ = A * rho * (∫ s : Real, quadraticTimeEnvelope Lambda t s) := by
      rw [integral_const_mul]
    _ = A * rho * (Real.pi / Lambda) := by
      rw [integral_quadraticTimeEnvelope_univ_eq_pi_div hLambda]

/-- The matching whole-line column estimate, by transposition and the exact
symmetry of the time-difference envelope. -/
theorem integral_norm_le_of_quadraticTimeEnvelope_univ_column
    {A rho Lambda s : Real} (hLambda : 0 < Lambda) (hArho : 0 ≤ A * rho)
    (L : Real → Real → Complex)
    (hL_integrable : Integrable (fun t : Real => ‖L t s‖) volume)
    (hbound : ∀ t : Real,
      ‖L t s‖ ≤ A * rho * quadraticTimeEnvelope Lambda t s) :
    (∫ t : Real, ‖L t s‖) ≤ A * rho * (Real.pi / Lambda) := by
  apply integral_norm_le_of_quadraticTimeEnvelope_univ hLambda hArho
    (fun t u => L u t)
  · simpa using hL_integrable
  · intro u
    rw [quadraticTimeEnvelope_symm]
    exact hbound u

/-- Whole-line row mass obtained directly from a central `A*rho` bound and
order-two off-diagonal decay at scale `Lambda`. -/
theorem integral_norm_le_of_central_outer_univ
    {A rho Lambda t : Real} (hLambda : 0 < Lambda) (hArho : 0 ≤ A * rho)
    (L : Real → Real → Complex)
    (hL_integrable : Integrable (fun s : Real => ‖L t s‖) volume)
    (hcentral : ∀ s : Real, ‖L t s‖ ≤ A * rho)
    (houter : ∀ s : Real, Lambda * |t - s| ≠ 0 →
      ‖L t s‖ ≤ A * rho * ((Lambda * |t - s|) ^ 2)⁻¹) :
    (∫ s : Real, ‖L t s‖) ≤ (2 * A) * rho * (Real.pi / Lambda) := by
  have hTwoArho : 0 ≤ (2 * A) * rho := by
    calc
      0 ≤ 2 * (A * rho) := mul_nonneg (by norm_num) hArho
      _ = (2 * A) * rho := by ring
  apply integral_norm_le_of_quadraticTimeEnvelope_univ hLambda hTwoArho L
    hL_integrable
  intro s
  exact norm_le_quadraticTimeEnvelope_of_central_outer hArho hLambda.le L
    (hcentral s) (houter s)

/-- Matching whole-line column mass for the central/outer kernel package. -/
theorem integral_norm_le_of_central_outer_univ_column
    {A rho Lambda s : Real} (hLambda : 0 < Lambda) (hArho : 0 ≤ A * rho)
    (L : Real → Real → Complex)
    (hL_integrable : Integrable (fun t : Real => ‖L t s‖) volume)
