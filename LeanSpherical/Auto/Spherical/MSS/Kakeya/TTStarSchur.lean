    (hLsymm : ∀ t s : Real, ‖L t s‖ = ‖L s t‖)
    (hrow : ∀ t : Real, Integrable (fun s : Real => ‖L t s‖) volume)
    (hrowbound : ∀ t : Real, (∫ s : Real, ‖L t s‖) ≤ R)
    (H : Real → Complex)
    (hHsq : Integrable (fun t : Real => ‖H t‖ ^ 2) volume)
    (hquad : Integrable (fun p : Real × Real =>
      ‖L p.1 p.2‖ * ‖H p.1‖ * ‖H p.2‖) (volume.prod volume))
    (hleft : Integrable (fun p : Real × Real =>
      ‖L p.1 p.2‖ * ‖H p.1‖ ^ 2) (volume.prod volume))
    (hright : Integrable (fun p : Real × Real =>
      ‖L p.1 p.2‖ * ‖H p.2‖ ^ 2) (volume.prod volume))
    (hcomplex : Integrable (fun p : Real × Real =>
      L p.1 p.2 * H p.1 * starRingEnd Complex (H p.2)) (volume.prod volume)) :
    ‖∫ t : Real, ∫ s : Real,
      L t s * H t * starRingEnd Complex (H s)‖ ≤
        R * ∫ t : Real, ‖H t‖ ^ 2 := by
  have hschur := aux_kernelQuadratic_le_of_symmetricSchur volume
    (fun t s : Real => ‖L t s‖) R
    (by intro t s; exact norm_nonneg _)
    hLsymm hrow hrowbound
    (fun t : Real => ‖H t‖) hHsq hquad hleft hright
  calc
    ‖∫ t : Real, ∫ s : Real,
        L t s * H t * starRingEnd Complex (H s)‖ =
        ‖∫ p : Real × Real,
          L p.1 p.2 * H p.1 * starRingEnd Complex (H p.2)‖ := by
      rw [integral_integral hcomplex, Measure.volume_eq_prod]
    _ ≤ ∫ p : Real × Real,
        ‖L p.1 p.2 * H p.1 * starRingEnd Complex (H p.2)‖ :=
      norm_integral_le_integral_norm _
    _ = ∫ p : Real × Real,
        ‖L p.1 p.2‖ * ‖H p.1‖ * ‖H p.2‖ := by
      apply integral_congr_ae
      filter_upwards with p
      rw [norm_mul, norm_mul, starRingEnd_apply, norm_star]
    _ = ∫ t : Real, ∫ s : Real,
        ‖L t s‖ * ‖H t‖ * ‖H s‖ := by
      rw [Measure.volume_eq_prod]
      exact integral_prod _ hquad
    _ ≤ R * ∫ t : Real, ‖H t‖ ^ 2 := hschur

end

