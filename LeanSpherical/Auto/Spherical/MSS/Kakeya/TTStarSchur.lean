      outerCircleProfileFourierCharProductKernel
        (outerCircleParametricRealProfileProductAmplitude g) rho lambda t s := by
  unfold ttstarKernel outerCircleProfileFourierCharProductKernel
  rw [intervalIntegral.integral_of_le (by norm_num : (1 / 2 : Real) ≤ 2)]
  congr 1
  apply integral_congr_ae
  filter_upwards with u
