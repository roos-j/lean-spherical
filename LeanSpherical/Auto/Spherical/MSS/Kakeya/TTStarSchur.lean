          Integrable (fun p : Real × Real =>
            outerCircleFourierCharProductKernel rho lambda p.1 p.2 * H p.1 *
              starRingEnd Complex (H p.2)) (volume.prod volume) →
          ((rho : Complex) *
            ∫ u : Real,
