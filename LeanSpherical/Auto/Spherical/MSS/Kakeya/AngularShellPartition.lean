noncomputable section

/-- The finite index set in the literal four-chart, seven-shift, capped-shell
decomposition.  Keeping it as one product is convenient for the final finite
Cauchy/Tonelli estimate. -/
noncomputable def shiftedCappedShellIndices (K : Nat) : Finset (Fin 4 × (Nat × Nat)) :=
  Finset.univ.product ((Finset.range 7).product (Finset.range (K + 2)))

/-- One literal physical summand in the shifted capped decomposition. -/
noncomputable def shiftedCappedShellPiece
    {iota : Type*}
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex)
    (eps : Real) (K : Nat)
    (jni : Fin 4 × (Nat × Nat))
    (theta : {r : Real // r ∈ Ico (-Real.pi) Real.pi})
    (y : Euclidean 2) : Complex :=
  shiftedChartedCappedTelescopingField unitDyadicFourChartFamily jni.1
    s q hqcompact a eps K jni.2.1 jni.2.2 theta.1 y

/-- The exact finite shifted reassembly, followed by the periodic reduction
to one fundamental circle interval.  This is the direct bridge from local
shell estimates to the literal finite-tensor circle maximum. -/
theorem lintegral_iSup_sq_finiteTensorCircleMultiplierField_le_shiftedCapped
    {iota : Type*}
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
    (hqactive : ∀ l, SupportedOnActive unitDyadicFourChartFamily (q l))
    (a : iota → SchwartzMap Real Complex)
    (eps : Real) (K : Nat)
    (hintegrable : ∀ theta j n i,
      Integrable (fun xi =>
        shiftedChartedCappedTelescopingMultiplier unitDyadicFourChartFamily j
          s q hqcompact a eps K n i theta xi))
    (B : Fin 4 × (Nat × Nat) → ENNReal)
    (hpieceMeas : ∀ jni ∈ shiftedCappedShellIndices K,
      Measurable (fun y : Euclidean 2 =>
        ⨆ theta : {r : Real // r ∈ Ico (-Real.pi) Real.pi},
          ENNReal.ofReal
            (‖shiftedCappedShellPiece s q hqcompact a eps K jni theta y‖ ^ 2)))
    (hpieceBound : ∀ jni ∈ shiftedCappedShellIndices K,
      (∫⁻ y : Euclidean 2,
        ⨆ theta : {r : Real // r ∈ Ico (-Real.pi) Real.pi},
          ENNReal.ofReal
            (‖shiftedCappedShellPiece s q hqcompact a eps K jni theta y‖ ^ 2)) ≤ B jni) :
    (∫⁻ y : Euclidean 2, ⨆ theta : Real,
      ENNReal.ofReal
        (‖finiteTensorCircleMultiplierField s q hqcompact a theta y‖ ^ 2)) ≤
      ((shiftedCappedShellIndices K).card : ENNReal) *
        ∑ jni ∈ shiftedCappedShellIndices K, B jni := by
  let shells := shiftedCappedShellIndices K
  let piece := shiftedCappedShellPiece s q hqcompact a eps K
  have hdecomp : ∀ theta y,
      finiteTensorCircleMultiplierField s q hqcompact a theta.1 y =
        ∑ jni ∈ shells, piece jni theta y := by
    intro theta y
    have hfield := sum_unitDyadicFourChart_shiftedCappedTelescopingField_eq
      s q hqcompact hqactive a eps K theta.1 y
      (fun j n i => hintegrable theta.1 j n i)
      (centeredFundamental_mem_closed theta.2)
    change finiteTensorCircleMultiplierField s q hqcompact a theta.1 y = _
    calc
      finiteTensorCircleMultiplierField s q hqcompact a theta.1 y =
          ∑ j : Fin 4, ∑ n ∈ Finset.range 7, ∑ i ∈ Finset.range (K + 2),
            shiftedChartedCappedTelescopingField unitDyadicFourChartFamily j
              s q hqcompact a eps K n i theta.1 y := hfield.symm
      _ = ∑ jni ∈ shells, piece jni theta y := by
        simp only [shells, shiftedCappedShellIndices, piece,
          shiftedCappedShellPiece]
        calc
          ∑ j : Fin 4, ∑ n ∈ Finset.range 7, ∑ i ∈ Finset.range (K + 2),
              shiftedChartedCappedTelescopingField unitDyadicFourChartFamily j
                s q hqcompact a eps K n i theta.1 y =
              ∑ j : Fin 4, ∑ ni ∈ (Finset.range 7).product (Finset.range (K + 2)),
                shiftedChartedCappedTelescopingField unitDyadicFourChartFamily j
                  s q hqcompact a eps K ni.1 ni.2 theta.1 y := by
                apply Finset.sum_congr rfl
                intro j hj
                exact (Finset.sum_product (Finset.range 7)
                  (Finset.range (K + 2))
                  (fun ni : Nat × Nat =>
                    shiftedChartedCappedTelescopingField unitDyadicFourChartFamily j
                      s q hqcompact a eps K ni.1 ni.2 theta.1 y)).symm
          _ = ∑ jni ∈ Finset.univ.product
              ((Finset.range 7).product (Finset.range (K + 2))),
              shiftedChartedCappedTelescopingField unitDyadicFourChartFamily jni.1
                s q hqcompact a eps K jni.2.1 jni.2.2 theta.1 y := by
                exact (Finset.sum_product Finset.univ
                  ((Finset.range 7).product (Finset.range (K + 2)))
                  (fun jni : Fin 4 × (Nat × Nat) =>
                    shiftedChartedCappedTelescopingField unitDyadicFourChartFamily jni.1
                      s q hqcompact a eps K jni.2.1 jni.2.2 theta.1 y)).symm
  have hmeas : ∀ jni ∈ shells, Measurable (fun y : Euclidean 2 =>
      ⨆ theta : {r : Real // r ∈ Ico (-Real.pi) Real.pi},
        ENNReal.ofReal (‖piece jni theta y‖ ^ 2)) := by
    intro jni hjni
    exact hpieceMeas jni hjni
  have hbound : ∀ jni ∈ shells, (∫⁻ y : Euclidean 2,
      ⨆ theta : {r : Real // r ∈ Ico (-Real.pi) Real.pi},
        ENNReal.ofReal (‖piece jni theta y‖ ^ 2)) ≤ B jni := by
    intro jni hjni
    exact hpieceBound jni hjni
  have hfund :
      (∫⁻ y : Euclidean 2,
        ⨆ theta : {r : Real // r ∈ Ico (-Real.pi) Real.pi},
          ENNReal.ofReal
            (‖finiteTensorCircleMultiplierField s q hqcompact a theta.1 y‖ ^ 2)) ≤
        (shells.card : ENNReal) * ∑ jni ∈ shells, B jni := by
    refine lintegral_iSup_sq_finite_shell_sum_le_of_bounds
      (Theta := {r : Real // r ∈ Ico (-Real.pi) Real.pi})
      (X := Euclidean 2) volume shells
      (fun theta y => finiteTensorCircleMultiplierField s q hqcompact a theta.1 y)
      piece B hdecomp hmeas hbound
  calc
    (∫⁻ y : Euclidean 2, ⨆ theta : Real,
      ENNReal.ofReal (‖finiteTensorCircleMultiplierField s q hqcompact a theta y‖ ^ 2)) ≤
        ∫⁻ y : Euclidean 2,
          ⨆ theta : {r : Real // r ∈ Ico (-Real.pi) Real.pi},
            ENNReal.ofReal
              (‖finiteTensorCircleMultiplierField s q hqcompact a theta.1 y‖ ^ 2) := by
        apply lintegral_mono
        intro y
        exact iSup_sq_finiteTensorCircleMultiplierField_le_centeredFundamental
          s q hqcompact a y
    _ ≤ ((shiftedCappedShellIndices K).card : ENNReal) *
        ∑ jni ∈ shiftedCappedShellIndices K, B jni := by
        simpa only [shells, piece] using hfund

/-- A uniform local shell estimate is paid twice by finite Cauchy/Tonelli:
once for the pointwise finite sum and once for the list of local energies. -/
theorem lintegral_iSup_sq_finiteTensorCircleMultField_le_shiftedCapped_unif_shiftedMax
    {iota : Type*}
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
    (hqactive : ∀ l, SupportedOnActive unitDyadicFourChartFamily (q l))
    (a : iota → SchwartzMap Real Complex)
    (eps : Real) (K : Nat)
    (hintegrable : ∀ theta j n i,
      Integrable (fun xi =>
        shiftedChartedCappedTelescopingMultiplier unitDyadicFourChartFamily j
          s q hqcompact a eps K n i theta xi))
    (B : ENNReal)
    (hpieceMeas : ∀ jni ∈ shiftedCappedShellIndices K,
      Measurable (fun y : Euclidean 2 =>
        ⨆ theta : {r : Real // r ∈ Ico (-Real.pi) Real.pi},
          ENNReal.ofReal
            (‖shiftedCappedShellPiece s q hqcompact a eps K jni theta y‖ ^ 2)))
    (hpieceBound : ∀ jni ∈ shiftedCappedShellIndices K,
      (∫⁻ y : Euclidean 2,
        ⨆ theta : {r : Real // r ∈ Ico (-Real.pi) Real.pi},
          ENNReal.ofReal
            (‖shiftedCappedShellPiece s q hqcompact a eps K jni theta y‖ ^ 2)) ≤ B) :
    (∫⁻ y : Euclidean 2, ⨆ theta : Real,
      ENNReal.ofReal
        (‖finiteTensorCircleMultiplierField s q hqcompact a theta y‖ ^ 2)) ≤
      ((shiftedCappedShellIndices K).card : ENNReal) ^ 2 * B := by
  have h := lintegral_iSup_sq_finiteTensorCircleMultiplierField_le_shiftedCapped
    s q hqcompact hqactive a eps K hintegrable (fun _ => B) hpieceMeas
    (by
      intro jni hjni
      exact hpieceBound jni hjni)
  calc
    (∫⁻ y : Euclidean 2, ⨆ theta : Real,
      ENNReal.ofReal
        (‖finiteTensorCircleMultiplierField s q hqcompact a theta y‖ ^ 2)) ≤
        ((shiftedCappedShellIndices K).card : ENNReal) *
          ∑ _ ∈ shiftedCappedShellIndices K, B := h
    _ = ((shiftedCappedShellIndices K).card : ENNReal) ^ 2 * B := by
      simp [pow_two, mul_assoc]

/-- The literal four-chart/seven-shift capped family has logarithmic size in
the frequency parameter. -/
theorem exists_shiftedCappedShellIndices_card_log_bound :
    ∃ A : Real, 0 < A ∧ ∀ lambda : Real, 1 ≤ lambda →
      ((shiftedCappedShellIndices (kakeyaCappedShellLevel lambda)).card : Real) ≤
        A * (1 + Real.log lambda) := by
  rcases exists_cappedShellFamily_card_log_bound with ⟨A, hApos, hA⟩
  refine ⟨28 * A, mul_pos (by norm_num) hApos, ?_⟩
  intro lambda hlambda
  have h := hA lambda hlambda
  simp only [Finset.card_range] at h
  push_cast at h
  simp only [shiftedCappedShellIndices] at ⊢
  norm_num
  nlinarith [mul_le_mul_of_nonneg_left h (show (0 : Real) ≤ 28 by norm_num)]

/-- Squaring the finite Cauchy/Tonelli loss still costs only a quadratic
logarithm.  This is the exact real arithmetic form used before converting a
fourth-root/square-function estimate to the final (L^2) bound. -/
theorem exists_shiftedCappedShellIndices_card_sq_log_sq_bound :
    ∃ A : Real, 0 < A ∧ ∀ lambda : Real, 1 ≤ lambda →
      (((shiftedCappedShellIndices (kakeyaCappedShellLevel lambda)).card : Real) ^ 2) ≤
        A * (1 + Real.log lambda) ^ 2 := by
