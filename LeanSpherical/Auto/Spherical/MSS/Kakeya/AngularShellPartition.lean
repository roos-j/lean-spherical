/-- The critical central angular width for a frequency of size `lambda`. -/
noncomputable def centeredCriticalWidth (lambda : Real) : Real :=
  (Real.sqrt lambda)⁻¹

/-- The `k`th dyadic outer angular radius, measured from the centered
stationary direction. -/
noncomputable def centeredOuterRadius (lambda : Real) (k : Nat) : Real :=
  (2 : Real) ^ k * centeredCriticalWidth lambda

theorem centeredCriticalWidth_pos {lambda : Real} (hlambda : 0 < lambda) :
    0 < centeredCriticalWidth lambda := by
  unfold centeredCriticalWidth
  exact inv_pos.mpr (Real.sqrt_pos.2 hlambda)

theorem centeredCriticalWidth_sq {lambda : Real} (hlambda : 0 < lambda) :
    lambda * centeredCriticalWidth lambda ^ 2 = 1 := by
  let s : Real := Real.sqrt lambda
  have hs : s ^ 2 = lambda := by
    dsimp only [s]
    exact Real.sq_sqrt hlambda.le
  have hsne : s ≠ 0 := by
    dsimp only [s]
    exact Real.sqrt_ne_zero'.mpr hlambda
  change lambda * s⁻¹ ^ 2 = 1
  calc
    lambda * s⁻¹ ^ 2 = s ^ 2 * s⁻¹ ^ 2 := by rw [hs]
    _ = (s * s⁻¹) ^ 2 := by rw [mul_pow]
    _ = 1 := by rw [mul_inv_cancel₀ hsne, one_pow]

theorem centeredOuterRadius_pos {lambda : Real} (hlambda : 0 < lambda) (k : Nat) :
    0 < centeredOuterRadius lambda k := by
  unfold centeredOuterRadius
  exact mul_pos (pow_pos (by norm_num) _) (centeredCriticalWidth_pos hlambda)

theorem centeredOuterRadius_succ {lambda : Real} (k : Nat) :
    centeredOuterRadius lambda (k + 1) = 2 * centeredOuterRadius lambda k := by
  unfold centeredOuterRadius
  rw [show k + 1 = Nat.succ k by omega, pow_succ]
  ring

/-- At the `k`th outer scale, the quadratic circle parameter is exactly
`2^(2k)`.  This is the scale input for the local Airy/TT* shell estimate. -/
theorem lambda_mul_centeredOuterRadius_sq {lambda : Real}
    (hlambda : 0 < lambda) (k : Nat) :
    lambda * centeredOuterRadius lambda k ^ 2 = (2 : Real) ^ (2 * k) := by
  unfold centeredOuterRadius
  calc
    lambda * ((2 : Real) ^ k * centeredCriticalWidth lambda) ^ 2 =
        ((2 : Real) ^ k) ^ 2 *
          (lambda * centeredCriticalWidth lambda ^ 2) := by ring
    _ = ((2 : Real) ^ k) ^ 2 := by rw [centeredCriticalWidth_sq hlambda, mul_one]
    _ = (2 : Real) ^ (2 * k) := by
      rw [← pow_mul, Nat.mul_comm]

/-- The central half-open shell.  The half-open convention gives an exact
partition at shared endpoints. -/
def centeredCentralShell (eps : Real) : Set Real := Ico (-eps) eps

/-- Positive outer dyadic shell `k`: `[2^k eps, 2^(k+1) eps)`. -/
def centeredPositiveOuterShell (eps : Real) (k : Nat) : Set Real :=
  Ico ((2 : Real) ^ k * eps) ((2 : Real) ^ (k + 1) * eps)

/-- Negative outer dyadic shell `k`: `[-2^(k+1) eps, -2^k eps)`. -/
def centeredNegativeOuterShell (eps : Real) (k : Nat) : Set Real :=
  Ico (-((2 : Real) ^ (k + 1) * eps)) (-((2 : Real) ^ k * eps))

def centeredShellWindow (eps : Real) (J : Nat) : Set Real :=
  Ico (-((2 : Real) ^ J * eps)) ((2 : Real) ^ J * eps)

theorem mem_centeredShellWindow_iff {eps beta : Real} {J : Nat} :
    beta ∈ centeredShellWindow eps J ↔
      -((2 : Real) ^ J * eps) ≤ beta ∧ beta < (2 : Real) ^ J * eps := by
  rfl

private theorem positive_shell_cover
    {eps beta : Real} (J : Nat)
    (hbeta : beta ∈ Ico ((2 : Real) ^ 0 * eps) ((2 : Real) ^ J * eps)) :
    ∃ k ∈ Finset.range J, beta ∈ centeredPositiveOuterShell eps k := by
  have hcover := Ico_subset_biUnion_Ico J
    (fun k : Nat => (2 : Real) ^ k * eps) hbeta
  rcases Set.mem_iUnion.mp hcover with ⟨k, hk⟩
  rcases Set.mem_iUnion.mp hk with ⟨hkJ, hmem⟩
  exact ⟨k, hkJ, hmem⟩

private theorem negative_shell_cover
    {eps beta : Real} (J : Nat)
    (hbeta : -beta ∈ Ioc ((2 : Real) ^ 0 * eps) ((2 : Real) ^ J * eps)) :
    ∃ k ∈ Finset.range J, beta ∈ centeredNegativeOuterShell eps k := by
  have hcover := Ioc_subset_biUnion_Ioc J
    (fun k : Nat => (2 : Real) ^ k * eps) hbeta
  rcases Set.mem_iUnion.mp hcover with ⟨k, hk⟩
  rcases Set.mem_iUnion.mp hk with ⟨hkJ, hkbeta⟩
  refine ⟨k, hkJ, ?_⟩
  unfold centeredNegativeOuterShell
  rw [mem_Ico]
  rw [mem_Ioc] at hkbeta
  constructor <;> linarith

/-- A finite central-plus-dyadic shell cover of the real coordinate window.
No logarithm is hidden: callers choose `J` so the window contains their
fundamental circle coordinate interval. -/
theorem centeredFiniteShell_cover
    {eps beta : Real} (J : Nat) (hbeta : beta ∈ centeredShellWindow eps J) :
    beta ∈ centeredCentralShell eps ∨
      (∃ k ∈ Finset.range J, beta ∈ centeredPositiveOuterShell eps k) ∨
      (∃ k ∈ Finset.range J, beta ∈ centeredNegativeOuterShell eps k) := by
  by_cases hcenter : beta ∈ centeredCentralShell eps
  · exact Or.inl hcenter
  by_cases hpos : eps ≤ beta
  · right
    left
    apply positive_shell_cover J
    rw [mem_Ico]
    constructor
    · simpa using hpos
    · exact hbeta.2
  · right
    right
    have hlt : beta < eps := lt_of_not_ge hpos
    have hneg : beta < -eps := by
      by_contra h
      have hlow : -eps ≤ beta := le_of_not_gt h
      exact hcenter ⟨hlow, hlt⟩
    apply negative_shell_cover J
    rw [mem_Ioc]
    constructor
    · linarith
    · linarith [hbeta.1]

private theorem eps_le_two_pow_mul {eps : Real} (heps : 0 ≤ eps) (k : Nat) :
    eps ≤ (2 : Real) ^ k * eps := by
  have hpow : (1 : Real) ≤ (2 : Real) ^ k := one_le_pow₀ (by norm_num)
  simpa only [one_mul] using mul_le_mul_of_nonneg_right hpow heps

/-- Two positive dyadic outer shells have no common coordinate point. -/
theorem centeredPositiveOuterShell_unique
    {eps beta : Real} (heps : 0 < eps) {k l : Nat}
    (hk : beta ∈ centeredPositiveOuterShell eps k)
    (hl : beta ∈ centeredPositiveOuterShell eps l) : k = l := by
  unfold centeredPositiveOuterShell at hk hl
  rw [mem_Ico] at hk hl
  rcases lt_trichotomy k l with hkl | hEq | hlk
  · exfalso
    have hpow : (2 : Real) ^ (k + 1) ≤ (2 : Real) ^ l :=
      pow_le_pow_right₀ (by norm_num) (Nat.succ_le_iff.2 hkl)
    have hscale : (2 : Real) ^ (k + 1) * eps ≤ (2 : Real) ^ l * eps :=
      mul_le_mul_of_nonneg_right hpow heps.le
    exact (not_lt_of_ge (hscale.trans hl.1)) hk.2
  · exact hEq
  · exfalso
    have hpow : (2 : Real) ^ (l + 1) ≤ (2 : Real) ^ k :=
      pow_le_pow_right₀ (by norm_num) (Nat.succ_le_iff.2 hlk)
    have hscale : (2 : Real) ^ (l + 1) * eps ≤ (2 : Real) ^ k * eps :=
      mul_le_mul_of_nonneg_right hpow heps.le
    exact (not_lt_of_ge (hscale.trans hk.1)) hl.2

/-- Two negative dyadic outer shells have no common coordinate point. -/
theorem centeredNegativeOuterShell_unique
    {eps beta : Real} (heps : 0 < eps) {k l : Nat}
    (hk : beta ∈ centeredNegativeOuterShell eps k)
    (hl : beta ∈ centeredNegativeOuterShell eps l) : k = l := by
  unfold centeredNegativeOuterShell at hk hl
  rw [mem_Ico] at hk hl
  rcases lt_trichotomy k l with hkl | hEq | hlk
  · exfalso
    have hpow : (2 : Real) ^ (k + 1) ≤ (2 : Real) ^ l :=
      pow_le_pow_right₀ (by norm_num) (Nat.succ_le_iff.2 hkl)
    have hscale : (2 : Real) ^ (k + 1) * eps ≤ (2 : Real) ^ l * eps :=
      mul_le_mul_of_nonneg_right hpow heps.le
    have hnegscale : -((2 : Real) ^ l * eps) ≤
        -((2 : Real) ^ (k + 1) * eps) := neg_le_neg hscale
    exact (not_lt_of_ge (hnegscale.trans hk.1)) hl.2
  · exact hEq
  · exfalso
    have hpow : (2 : Real) ^ (l + 1) ≤ (2 : Real) ^ k :=
      pow_le_pow_right₀ (by norm_num) (Nat.succ_le_iff.2 hlk)
    have hscale : (2 : Real) ^ (l + 1) * eps ≤ (2 : Real) ^ k * eps :=
      mul_le_mul_of_nonneg_right hpow heps.le
    have hnegscale : -((2 : Real) ^ k * eps) ≤
        -((2 : Real) ^ (l + 1) * eps) := neg_le_neg hscale
    exact (not_lt_of_ge (hnegscale.trans hl.1)) hk.2

theorem centeredCentralShell_disjoint_positiveOuter
    {eps beta : Real} (heps : 0 < eps) (k : Nat)
    (hcenter : beta ∈ centeredCentralShell eps)
    (houter : beta ∈ centeredPositiveOuterShell eps k) : False := by
  unfold centeredCentralShell at hcenter
  unfold centeredPositiveOuterShell at houter
  rw [mem_Ico] at hcenter houter
  have hscale : eps ≤ (2 : Real) ^ k * eps := eps_le_two_pow_mul heps.le k
  exact (not_lt_of_ge (hscale.trans houter.1)) hcenter.2

theorem centeredCentralShell_disjoint_negativeOuter
    {eps beta : Real} (heps : 0 < eps) (k : Nat)
    (hcenter : beta ∈ centeredCentralShell eps)
    (houter : beta ∈ centeredNegativeOuterShell eps k) : False := by
  unfold centeredCentralShell at hcenter
  unfold centeredNegativeOuterShell at houter
  rw [mem_Ico] at hcenter houter
  have hscale : eps ≤ (2 : Real) ^ k * eps := eps_le_two_pow_mul heps.le k
  have hnegscale : -((2 : Real) ^ k * eps) ≤ -eps := neg_le_neg hscale
  exact (not_lt_of_ge (hnegscale.trans hcenter.1)) houter.2

theorem centeredPositiveOuterShell_disjoint_negativeOuter
    {eps beta : Real} (heps : 0 < eps) (k l : Nat)
    (hpos : beta ∈ centeredPositiveOuterShell eps k)
    (hneg : beta ∈ centeredNegativeOuterShell eps l) : False := by
  unfold centeredPositiveOuterShell at hpos
  unfold centeredNegativeOuterShell at hneg
  rw [mem_Ico] at hpos hneg
  have hposscale : eps ≤ (2 : Real) ^ k * eps := eps_le_two_pow_mul heps.le k
  have hnegscale : eps ≤ (2 : Real) ^ l * eps := eps_le_two_pow_mul heps.le l
  have hnegative : -((2 : Real) ^ l * eps) ≤ -eps := neg_le_neg hnegscale
  have hstrict : beta < -eps := lt_of_lt_of_le hneg.2 hnegative
  exact (not_lt_of_ge (hposscale.trans hpos.1))
    (hstrict.trans (neg_lt_self heps))

/-- A finite tag space for the central shell and the two signed outer shell
families. -/
inductive CenteredShellTag
  | central
  | positive (k : Nat)
  | negative (k : Nat)
  deriving DecidableEq

def centeredShellTagSet (eps : Real) : CenteredShellTag → Set Real
  | .central => centeredCentralShell eps
  | .positive k => centeredPositiveOuterShell eps k
  | .negative k => centeredNegativeOuterShell eps k

noncomputable def centeredFiniteShellTags (J : Nat) : Finset CenteredShellTag :=
  ({.central} : Finset CenteredShellTag) ∪
    ((Finset.range J).image CenteredShellTag.positive ∪
      (Finset.range J).image CenteredShellTag.negative)

noncomputable def centeredActiveShellTags (eps : Real) (J : Nat) (beta : Real) :
    Finset CenteredShellTag := by
  classical
  exact (centeredFiniteShellTags J).filter (fun i => beta ∈ centeredShellTagSet eps i)

/-- The geometric shells are disjoint, hence their active overlap is one. -/
theorem centeredShellTag_eq_of_common_mem
    {eps beta : Real} (heps : 0 < eps) {i j : CenteredShellTag}
    (hi : beta ∈ centeredShellTagSet eps i)
    (hj : beta ∈ centeredShellTagSet eps j) : i = j := by
  cases i <;> cases j
  · rfl
  · exfalso
    exact centeredCentralShell_disjoint_positiveOuter heps _ hi hj
  · exfalso
    exact centeredCentralShell_disjoint_negativeOuter heps _ hi hj
  · exfalso
    exact centeredCentralShell_disjoint_positiveOuter heps _ hj hi
  · congr
    exact centeredPositiveOuterShell_unique heps hi hj
  · exfalso
    exact centeredPositiveOuterShell_disjoint_negativeOuter heps _ _ hi hj
  · exfalso
    exact centeredCentralShell_disjoint_negativeOuter heps _ hj hi
  · exfalso
    exact centeredPositiveOuterShell_disjoint_negativeOuter heps _ _ hj hi
  · congr
    exact centeredNegativeOuterShell_unique heps hi hj

theorem card_centeredActiveShellTags_le_one
    {eps beta : Real} (heps : 0 < eps) (J : Nat) :
    (centeredActiveShellTags eps J beta).card ≤ 1 := by
  classical
  refine Finset.card_le_one.mpr ?_
  intro i hi j hj
  have hi' : beta ∈ centeredShellTagSet eps i :=
    (Finset.mem_filter.mp hi).2
  have hj' : beta ∈ centeredShellTagSet eps j :=
    (Finset.mem_filter.mp hj).2
  exact centeredShellTag_eq_of_common_mem heps hi' hj'

theorem centeredActiveShellTags_nonempty_of_window
    {eps beta : Real} (J : Nat) (hbeta : beta ∈ centeredShellWindow eps J) :
    (centeredActiveShellTags eps J beta).Nonempty := by
  classical
  rcases centeredFiniteShell_cover J hbeta with hcenter | hpos | hneg
  · refine ⟨CenteredShellTag.central, Finset.mem_filter.mpr ⟨?_, hcenter⟩⟩
    simp [centeredFiniteShellTags]
  · rcases hpos with ⟨k, hk, hmem⟩
    refine ⟨CenteredShellTag.positive k, Finset.mem_filter.mpr ⟨?_, hmem⟩⟩
    simpa [centeredFiniteShellTags] using hk
  · rcases hneg with ⟨k, hk, hmem⟩
    refine ⟨CenteredShellTag.negative k, Finset.mem_filter.mpr ⟨?_, hmem⟩⟩
    simpa [centeredFiniteShellTags] using hk

/-- One exact local piece: the sharp (half-open) shell restriction of an
arbitrary centered-coordinate field. -/
noncomputable def centeredShellRestrict
    (S : Set Real) (F : Real → Complex) (beta : Real) : Complex := by
  classical
  exact if beta ∈ S then F beta else 0

theorem centeredShellRestrict_eq_self_of_mem
    {S : Set Real} {F : Real → Complex} {beta : Real} (hbeta : beta ∈ S) :
    centeredShellRestrict S F beta = F beta := by
  simp [centeredShellRestrict, hbeta]

theorem centeredShellRestrict_eq_zero_of_not_mem
    {S : Set Real} {F : Real → Complex} {beta : Real} (hbeta : beta ∉ S) :
    centeredShellRestrict S F beta = 0 := by
  simp [centeredShellRestrict, hbeta]

noncomputable def centeredTagRestrict (eps : Real) (F : Real → Complex)
    (i : CenteredShellTag) (beta : Real) : Complex :=
  centeredShellRestrict (centeredShellTagSet eps i) F beta

/-- Exact finite reconstruction on the centered coordinate window.  The
active shell set is nonempty by coverage and a singleton by the overlap-one
geometry, so the displayed sum is literally one selected shell piece. -/
theorem centeredFiniteShell_exact_reconstruction
    {eps beta : Real} (heps : 0 < eps) (J : Nat) (F : Real → Complex)
    (hbeta : beta ∈ centeredShellWindow eps J) :
    ∑ i ∈ centeredActiveShellTags eps J beta, centeredTagRestrict eps F i beta = F beta := by
  classical
  rcases centeredActiveShellTags_nonempty_of_window J hbeta with ⟨i, hi⟩
  have hcard : (centeredActiveShellTags eps J beta).card ≤ 1 :=
    card_centeredActiveShellTags_le_one heps J
  have hunique : ∀ x ∈ centeredActiveShellTags eps J beta, x = i := by
    intro x hx
    exact Finset.card_le_one.mp hcard x hx i hi
  have hsingle : centeredActiveShellTags eps J beta = {i} :=
    Finset.eq_singleton_iff_unique_mem.mpr ⟨hi, hunique⟩
  rw [hsingle, Finset.sum_singleton]
  unfold centeredTagRestrict
  apply centeredShellRestrict_eq_self_of_mem
  exact (Finset.mem_filter.mp hi).2

/-- The shellwise maximal square envelope of one tagged sharp restriction. -/
noncomputable def centeredTagEnvelope {X : Type*}
    (eps : Real) (F : Real → X → Complex) (i : CenteredShellTag) (x : X) : ENNReal :=
  ⨆ beta : Real,
    ENNReal.ofReal (‖centeredTagRestrict eps (fun theta => F theta x) i beta‖ ^ 2)

/-- Finite-overlap-one reassembly at the level of spatial `L²` energies.
The conclusion is arranged to accept the local maximal-shell energy bounds
produced by the Airy/TT* package. -/
theorem lintegral_iSup_centeredFiniteShell_le
    {X : Type*} [MeasurableSpace X] (mu : Measure X)
    {eps : Real} (J : Nat) (F : Real → X → Complex)
    (hmeas : ∀ i ∈ centeredFiniteShellTags J,
      Measurable (centeredTagEnvelope eps F i)) :
    (∫⁻ x : X, ⨆ beta : {b : Real // b ∈ centeredShellWindow eps J},
      ENNReal.ofReal (‖F beta.1 x‖ ^ 2) ∂mu) ≤
      ∑ i ∈ centeredFiniteShellTags J, ∫⁻ x : X, centeredTagEnvelope eps F i x ∂mu := by
  classical
  have hpoint : ∀ x : X, (⨆ beta : {b : Real // b ∈ centeredShellWindow eps J},
      ENNReal.ofReal (‖F beta.1 x‖ ^ 2)) ≤
      ∑ i ∈ centeredFiniteShellTags J, centeredTagEnvelope eps F i x := by
    intro x
    apply iSup_le
    intro beta
    rcases centeredActiveShellTags_nonempty_of_window J beta.2 with ⟨i, hi⟩
    have hitag : i ∈ centeredFiniteShellTags J := (Finset.mem_filter.mp hi).1
    have himem : beta.1 ∈ centeredShellTagSet eps i := (Finset.mem_filter.mp hi).2
    have hEq : centeredTagRestrict eps (fun theta => F theta x) i beta.1 = F beta.1 x := by
      unfold centeredTagRestrict
      exact centeredShellRestrict_eq_self_of_mem himem
    calc
      ENNReal.ofReal (‖F beta.1 x‖ ^ 2) =
          ENNReal.ofReal (‖centeredTagRestrict eps (fun theta => F theta x) i beta.1‖ ^ 2) := by
            rw [hEq]
      _ ≤ centeredTagEnvelope eps F i x :=
        le_iSup (fun theta : Real =>
          ENNReal.ofReal (‖centeredTagRestrict eps (fun eta => F eta x) i theta‖ ^ 2)) beta.1
      _ ≤ ∑ j ∈ centeredFiniteShellTags J, centeredTagEnvelope eps F j x := by
        exact Finset.single_le_sum
          (s := centeredFiniteShellTags J)
          (f := fun j => centeredTagEnvelope eps F j x)
          (fun j hj => bot_le) hitag
  calc
    (∫⁻ x : X, ⨆ beta : {b : Real // b ∈ centeredShellWindow eps J},
        ENNReal.ofReal (‖F beta.1 x‖ ^ 2) ∂mu) ≤
      ∫⁻ x : X, ∑ i ∈ centeredFiniteShellTags J, centeredTagEnvelope eps F i x ∂mu :=
        lintegral_mono hpoint
    _ = ∑ i ∈ centeredFiniteShellTags J,
        ∫⁻ x : X, centeredTagEnvelope eps F i x ∂mu := by
      rw [lintegral_finsetSum (centeredFiniteShellTags J) hmeas]

/-- The same reassembly bound after replacing each sharp-shell envelope by
any measurable local majorant.  This is the direct handoff interface for
Airy's central and outer shell estimates. -/
theorem lintegral_iSup_centeredFiniteShell_le_of_local_majorants
    {X : Type*} [MeasurableSpace X] (mu : Measure X)
    {eps : Real} (J : Nat) (F : Real → X → Complex)
    (Q : CenteredShellTag → X → ENNReal)
    (hQmeas : ∀ i ∈ centeredFiniteShellTags J, Measurable (Q i))
    (hlocal : ∀ i ∈ centeredFiniteShellTags J, ∀ x : X,
      centeredTagEnvelope eps F i x ≤ Q i x) :
    (∫⁻ x : X, ⨆ beta : {b : Real // b ∈ centeredShellWindow eps J},
      ENNReal.ofReal (‖F beta.1 x‖ ^ 2) ∂mu) ≤
      ∑ i ∈ centeredFiniteShellTags J, ∫⁻ x : X, Q i x ∂mu := by
  classical
  have hpoint : ∀ x : X, (⨆ beta : {b : Real // b ∈ centeredShellWindow eps J},
      ENNReal.ofReal (‖F beta.1 x‖ ^ 2)) ≤
      ∑ i ∈ centeredFiniteShellTags J, Q i x := by
    intro x
    apply iSup_le
    intro beta
    rcases centeredActiveShellTags_nonempty_of_window J beta.2 with ⟨i, hi⟩
    have hitag : i ∈ centeredFiniteShellTags J := (Finset.mem_filter.mp hi).1
    have himem : beta.1 ∈ centeredShellTagSet eps i := (Finset.mem_filter.mp hi).2
    have hEq : centeredTagRestrict eps (fun theta => F theta x) i beta.1 = F beta.1 x := by
      unfold centeredTagRestrict
      exact centeredShellRestrict_eq_self_of_mem himem
    calc
      ENNReal.ofReal (‖F beta.1 x‖ ^ 2) =
          ENNReal.ofReal (‖centeredTagRestrict eps (fun theta => F theta x) i beta.1‖ ^ 2) := by
            rw [hEq]
      _ ≤ centeredTagEnvelope eps F i x :=
        le_iSup (fun theta : Real =>
          ENNReal.ofReal (‖centeredTagRestrict eps (fun eta => F eta x) i theta‖ ^ 2)) beta.1
      _ ≤ Q i x := hlocal i hitag x
      _ ≤ ∑ j ∈ centeredFiniteShellTags J, Q j x := by
        exact Finset.single_le_sum
          (s := centeredFiniteShellTags J)
          (f := fun j => Q j x)
          (fun j hj => bot_le) hitag
  calc
    (∫⁻ x : X, ⨆ beta : {b : Real // b ∈ centeredShellWindow eps J},
        ENNReal.ofReal (‖F beta.1 x‖ ^ 2) ∂mu) ≤
      ∫⁻ x : X, ∑ i ∈ centeredFiniteShellTags J, Q i x ∂mu :=
        lintegral_mono hpoint
    _ = ∑ i ∈ centeredFiniteShellTags J, ∫⁻ x : X, Q i x ∂mu := by
      rw [lintegral_finsetSum (centeredFiniteShellTags J) hQmeas]

/-- Exact selected-piece reassembly: at every coordinate in the finite
window, one of the central/outer shell restrictions is literally the original
field.  This is the interface needed to insert smooth shell replacements
whose local estimates dominate the corresponding restrictions. -/
theorem exists_centeredFiniteShell_restriction_eq
    {eps beta : Real} (J : Nat) (F : Real → Complex)
    (hbeta : beta ∈ centeredShellWindow eps J) :
    centeredShellRestrict (centeredCentralShell eps) F beta = F beta ∨
      (∃ k ∈ Finset.range J,
        centeredShellRestrict (centeredPositiveOuterShell eps k) F beta = F beta) ∨
      (∃ k ∈ Finset.range J,
        centeredShellRestrict (centeredNegativeOuterShell eps k) F beta = F beta) := by
  rcases centeredFiniteShell_cover J hbeta with hcenter | hpos | hneg
  · exact Or.inl (centeredShellRestrict_eq_self_of_mem hcenter)
  · right
    left
    rcases hpos with ⟨k, hk, hmem⟩
    exact ⟨k, hk, centeredShellRestrict_eq_self_of_mem hmem⟩
  · right
    right
    rcases hneg with ⟨k, hk, hmem⟩
    exact ⟨k, hk, centeredShellRestrict_eq_self_of_mem hmem⟩

/-- The pointwise square-function reassembly inequality.  It uses only the
finite geometric cover, so it remains valid if the sharp restrictions are
replaced by smooth local shell pieces that dominate them pointwise. -/
theorem norm_sq_le_centeredFiniteShell_sum
    {eps beta : Real} (J : Nat) (F : Real → Complex)
    (hbeta : beta ∈ centeredShellWindow eps J) :
    ‖F beta‖ ^ 2 ≤
      ‖centeredShellRestrict (centeredCentralShell eps) F beta‖ ^ 2 +
        ∑ k ∈ Finset.range J,
          (‖centeredShellRestrict (centeredPositiveOuterShell eps k) F beta‖ ^ 2 +
            ‖centeredShellRestrict (centeredNegativeOuterShell eps k) F beta‖ ^ 2) := by
  rcases exists_centeredFiniteShell_restriction_eq J F hbeta with hcenter | hpos | hneg
  · rw [← hcenter]
    exact le_add_of_nonneg_right (Finset.sum_nonneg fun _ _ => by positivity)
  · rcases hpos with ⟨k, hk, hkEq⟩
    have hterm : ‖F beta‖ ^ 2 ≤
        ‖centeredShellRestrict (centeredPositiveOuterShell eps k) F beta‖ ^ 2 := by
      rw [hkEq]
    calc
      ‖F beta‖ ^ 2 ≤
          ‖centeredShellRestrict (centeredPositiveOuterShell eps k) F beta‖ ^ 2 := hterm
      _ ≤ ‖centeredShellRestrict (centeredPositiveOuterShell eps k) F beta‖ ^ 2 +
          ‖centeredShellRestrict (centeredNegativeOuterShell eps k) F beta‖ ^ 2 := by
          exact le_add_of_nonneg_right (by positivity)
      _ ≤ ∑ k ∈ Finset.range J,
          (‖centeredShellRestrict (centeredPositiveOuterShell eps k) F beta‖ ^ 2 +
            ‖centeredShellRestrict (centeredNegativeOuterShell eps k) F beta‖ ^ 2) := by
          exact Finset.single_le_sum
            (s := Finset.range J)
            (f := fun i =>
              ‖centeredShellRestrict (centeredPositiveOuterShell eps i) F beta‖ ^ 2 +
                ‖centeredShellRestrict (centeredNegativeOuterShell eps i) F beta‖ ^ 2)
            (fun i hi => by positivity) hk
      _ ≤ ‖centeredShellRestrict (centeredCentralShell eps) F beta‖ ^ 2 +
          ∑ k ∈ Finset.range J,
            (‖centeredShellRestrict (centeredPositiveOuterShell eps k) F beta‖ ^ 2 +
              ‖centeredShellRestrict (centeredNegativeOuterShell eps k) F beta‖ ^ 2) := by
          exact le_add_of_nonneg_left (by positivity)
  · rcases hneg with ⟨k, hk, hkEq⟩
    have hterm : ‖F beta‖ ^ 2 ≤
        ‖centeredShellRestrict (centeredNegativeOuterShell eps k) F beta‖ ^ 2 := by
      rw [hkEq]
    calc
      ‖F beta‖ ^ 2 ≤
          ‖centeredShellRestrict (centeredNegativeOuterShell eps k) F beta‖ ^ 2 := hterm
      _ ≤ ‖centeredShellRestrict (centeredPositiveOuterShell eps k) F beta‖ ^ 2 +
          ‖centeredShellRestrict (centeredNegativeOuterShell eps k) F beta‖ ^ 2 := by
          exact le_add_of_nonneg_left (by positivity)
      _ ≤ ∑ k ∈ Finset.range J,
          (‖centeredShellRestrict (centeredPositiveOuterShell eps k) F beta‖ ^ 2 +
            ‖centeredShellRestrict (centeredNegativeOuterShell eps k) F beta‖ ^ 2) := by
          exact Finset.single_le_sum
            (s := Finset.range J)
            (f := fun i =>
              ‖centeredShellRestrict (centeredPositiveOuterShell eps i) F beta‖ ^ 2 +
                ‖centeredShellRestrict (centeredNegativeOuterShell eps i) F beta‖ ^ 2)
            (fun i hi => by positivity) hk
      _ ≤ ‖centeredShellRestrict (centeredCentralShell eps) F beta‖ ^ 2 +
          ∑ k ∈ Finset.range J,
            (‖centeredShellRestrict (centeredPositiveOuterShell eps k) F beta‖ ^ 2 +
              ‖centeredShellRestrict (centeredNegativeOuterShell eps k) F beta‖ ^ 2) := by
          exact le_add_of_nonneg_left (by positivity)

end
end Auto.Spherical.MSS
end
-- END ScratchKakeyaAngularShellPartition

-- BEGIN ScratchKakeyaSmoothShellPartition
section

section Auto.Spherical.MSS

open Filter Finset Set
open Auto.Spherical.SurfaceMeasureDecay
open scoped BigOperators

noncomputable section

/-- The ordered product construction converts finitely many smooth cutoff
functions into an exact partition wherever one cutoff is one.  It preserves
the support of each cutoff and avoids any division by a variable denominator.
-/
def orderedShellPartitionPiece
    (b : Nat -> Real -> Real) (i : Nat) (u : Real) : Real :=
  b i u * ∏ j ∈ Finset.range i, (1 - b j u)

private theorem sum_orderedShellPartitionPiece_aux
    (b : Nat -> Real -> Real) (u : Real) :
    ∀ m : Nat,
      ∑ i ∈ Finset.range m, orderedShellPartitionPiece b i u =
        1 - ∏ j ∈ Finset.range m, (1 - b j u) := by
  intro m
  induction m with
  | zero => simp [orderedShellPartitionPiece]
  | succ m ih =>
      rw [Finset.sum_range_succ, ih, Finset.prod_range_succ]
      dsimp only [orderedShellPartitionPiece]
      ring

theorem sum_orderedShellPartitionPiece_eq_one
    {m : Nat} (b : Nat -> Real -> Real) (u : Real)
    (hone : ∃ i ∈ Finset.range m, b i u = 1) :
    ∑ i ∈ Finset.range m, orderedShellPartitionPiece b i u = 1 := by
  rw [sum_orderedShellPartitionPiece_aux]
  rcases hone with ⟨i, hi, hbi⟩
  have hzero : ∏ j ∈ Finset.range m, (1 - b j u) = 0 := by
    apply Finset.prod_eq_zero hi
    simp [hbi]
  rw [hzero]
  norm_num

theorem orderedShellPartitionPiece_eq_zero_of_cutoff_eq_zero
    (_m : Nat) (b : Nat -> Real -> Real) (i : Nat) (u : Real)
    (hzero : b i u = 0) :
    orderedShellPartitionPiece b i u = 0 := by
  simp [orderedShellPartitionPiece, hzero]

/-- The central cutoff, equal to one on `|u| ≤ rho` and supported in
`|u| < 3 rho / 2`. -/
noncomputable def smoothCentralShellBump : ContDiffBump (0 : Real) :=
  ⟨(1 : Real) / 4, (3 : Real) / 8, by norm_num, by norm_num⟩

noncomputable def smoothCentralShellCutoff (rho u : Real) : Real :=
  smoothCentralShellBump (u / (4 * rho))

/-- A positive outer cutoff, equal to one on `[rho, 3 rho / 2]` and
supported in `(7 rho / 8, 13 rho / 8)`. -/
noncomputable def smoothPositiveOuterShellCutoff (rho u : Real) : Real :=
  (fixedOuterCircleUnitShellBump : Real -> Real) (u / rho)

noncomputable def smoothNegativeOuterShellCutoff (rho u : Real) : Real :=
  smoothPositiveOuterShellCutoff rho (-u)

theorem contDiff_smoothCentralShellCutoff (rho : Real) :
    ContDiff Real (⊤ : ℕ∞) (smoothCentralShellCutoff rho) := by
  unfold smoothCentralShellCutoff
  exact smoothCentralShellBump.contDiff.comp (contDiff_id.div_const (4 * rho))

theorem contDiff_smoothPositiveOuterShellCutoff (rho : Real) :
    ContDiff Real (⊤ : ℕ∞) (smoothPositiveOuterShellCutoff rho) := by
  unfold smoothPositiveOuterShellCutoff
  exact fixedOuterCircleUnitShellBump.contDiff.comp (contDiff_id.div_const rho)

theorem contDiff_smoothNegativeOuterShellCutoff (rho : Real) :
    ContDiff Real (⊤ : ℕ∞) (smoothNegativeOuterShellCutoff rho) := by
  unfold smoothNegativeOuterShellCutoff
  exact (contDiff_smoothPositiveOuterShellCutoff rho).comp contDiff_neg

theorem smoothCentralShellCutoff_eq_zero_of_le_neg_two
    {rho u : Real} (hrho : 0 < rho) (hu : u ≤ -2 * rho) :
    smoothCentralShellCutoff rho u = 0 := by
  unfold smoothCentralShellCutoff
  rw [smoothCentralShellBump.zero_of_le_dist]
  change (3 / 8 : Real) ≤ dist (u / (4 * rho)) 0
  rw [Real.dist_eq, sub_zero]
  have hden : 0 < (4 : Real) * rho := mul_pos (by norm_num) hrho
  have hquot : u / (4 * rho) ≤ -(1 / 2 : Real) := by
    rw [div_le_iff₀ hden]
    nlinarith
  rw [abs_of_nonpos (hquot.trans (by norm_num))]
  nlinarith

theorem smoothPositiveOuterShellCutoff_eq_zero_of_nonpos
    {rho u : Real} (hrho : 0 < rho) (hu : u ≤ 0) :
    smoothPositiveOuterShellCutoff rho u = 0 := by
  unfold smoothPositiveOuterShellCutoff
  rw [fixedOuterCircleUnitShellBump.zero_of_le_dist]
  change (3 / 8 : Real) ≤ dist (u / rho) (5 / 4 : Real)
  rw [Real.dist_eq, abs_of_nonpos]
  · have hquot : u / rho ≤ 0 :=
      div_nonpos_of_nonpos_of_nonneg hu hrho.le
    nlinarith
  · rw [sub_nonpos]
    exact (div_nonpos_of_nonpos_of_nonneg hu hrho.le).trans (by norm_num)

theorem smoothNegativeOuterShellCutoff_eq_zero_of_le_neg_two
    {rho u : Real} (hrho : 0 < rho) (hu : u ≤ -2 * rho) :
    smoothNegativeOuterShellCutoff rho u = 0 := by
  unfold smoothNegativeOuterShellCutoff
  unfold smoothPositiveOuterShellCutoff
  rw [fixedOuterCircleUnitShellBump.zero_of_le_dist]
  change (3 / 8 : Real) ≤ dist ((-u) / rho) (5 / 4 : Real)
  rw [Real.dist_eq]
  have hquot : (2 : Real) ≤ (-u) / rho := by
    rw [le_div_iff₀ hrho]
    linarith
  rw [abs_of_nonneg (by linarith)]
  linarith

theorem smoothCentralShellCutoff_eq_one
    {rho u : Real} (hrho : 0 < rho) (hu : |u| <= rho) :
    smoothCentralShellCutoff rho u = 1 := by
  unfold smoothCentralShellCutoff
  apply smoothCentralShellBump.one_of_mem_closedBall
  rw [Metric.mem_closedBall, Real.dist_eq]
  simp only [sub_zero]
  change |u / (4 * rho)| <= 1 / 4
  rw [abs_div, abs_of_nonneg (by positivity : 0 <= (4 : Real) * rho)]
  have hden : 0 < (4 : Real) * rho := mul_pos (by norm_num) hrho
  rw [div_le_iff₀ hden]
  nlinarith

theorem smoothPositiveOuterShellCutoff_eq_one
    {rho u : Real} (hrho : 0 < rho)
    (hu_lo : rho <= u) (hu_hi : u <= (3 / 2) * rho) :
    smoothPositiveOuterShellCutoff rho u = 1 := by
  unfold smoothPositiveOuterShellCutoff
  apply fixedOuterCircleUnitShellBump.one_of_mem_closedBall
  rw [Metric.mem_closedBall, Real.dist_eq]
  change |u / rho - (5 / 4 : Real)| <= 1 / 4
  have hulo : (1 : Real) <= u / rho := by
    rw [le_div_iff₀ hrho]
    simpa using hu_lo
  have huhi : u / rho <= (3 / 2 : Real) := by
    rw [div_le_iff₀ hrho]
    simpa using hu_hi
  rw [abs_le]
  constructor
  · nlinarith
  · nlinarith

theorem smoothNegativeOuterShellCutoff_eq_one
    {rho u : Real} (hrho : 0 < rho)
    (hu_lo : -(3 / 2) * rho <= u) (hu_hi : u <= -rho) :
    smoothNegativeOuterShellCutoff rho u = 1 := by
  unfold smoothNegativeOuterShellCutoff
  apply smoothPositiveOuterShellCutoff_eq_one hrho
  · linarith
  · linarith

/-- A finite-enumeration-friendly version of the central and doubled outer
smooth shell family.  Entries beyond the intended finite range are harmless;
the associated exact partition is always summed only through `1 + 4 * J`. -/
noncomputable def smoothShellCoverCutoff (eps : Real) (i : Nat) (u : Real) : Real :=
  if i = 0 then smoothCentralShellCutoff eps u else
    let k := (i - 1) / 4
    match (i - 1) % 4 with
    | 0 => smoothPositiveOuterShellCutoff ((2 : Real) ^ k * eps) u
    | 1 => smoothPositiveOuterShellCutoff ((3 / 2 : Real) * ((2 : Real) ^ k * eps)) u
    | 2 => smoothNegativeOuterShellCutoff ((2 : Real) ^ k * eps) u
    | _ => smoothNegativeOuterShellCutoff ((3 / 2 : Real) * ((2 : Real) ^ k * eps)) u

@[simp] theorem smoothShellCoverCutoff_zero (eps u : Real) :
    smoothShellCoverCutoff eps 0 u = smoothCentralShellCutoff eps u := by
  simp [smoothShellCoverCutoff]

@[simp] theorem smoothShellCoverCutoff_pos_first (eps u : Real) (k : Nat) :
    smoothShellCoverCutoff eps (1 + 4 * k) u =
      smoothPositiveOuterShellCutoff ((2 : Real) ^ k * eps) u := by
  simp [smoothShellCoverCutoff]

@[simp] theorem smoothShellCoverCutoff_pos_second (eps u : Real) (k : Nat) :
    smoothShellCoverCutoff eps (1 + 4 * k + 1) u =
      smoothPositiveOuterShellCutoff ((3 / 2 : Real) * ((2 : Real) ^ k * eps)) u := by
  have hdiv : ((1 + 4 * k) / 4 : Nat) = k := by omega
  have hmod : ((1 + 4 * k) % 4 : Nat) = 1 := by omega
  simp [smoothShellCoverCutoff, hdiv, hmod]

@[simp] theorem smoothShellCoverCutoff_neg_first (eps u : Real) (k : Nat) :
    smoothShellCoverCutoff eps (1 + 4 * k + 2) u =
      smoothNegativeOuterShellCutoff ((2 : Real) ^ k * eps) u := by
  have hdiv : ((1 + 4 * k + 1) / 4 : Nat) = k := by omega
  have hmod : ((1 + 4 * k + 1) % 4 : Nat) = 2 := by omega
  simp [smoothShellCoverCutoff, hdiv, hmod]

@[simp] theorem smoothShellCoverCutoff_neg_second (eps u : Real) (k : Nat) :
    smoothShellCoverCutoff eps (1 + 4 * k + 3) u =
      smoothNegativeOuterShellCutoff ((3 / 2 : Real) * ((2 : Real) ^ k * eps)) u := by
  have hdiv : ((1 + 4 * k + 2) / 4 : Nat) = k := by omega
  have hmod : ((1 + 4 * k + 2) % 4 : Nat) = 3 := by omega
  simp [smoothShellCoverCutoff, hdiv, hmod]

theorem contDiff_smoothShellCoverCutoff (eps : Real) (i : Nat) :
    ContDiff Real (⊤ : ℕ∞) (smoothShellCoverCutoff eps i) := by
  unfold smoothShellCoverCutoff
  split
  · exact contDiff_smoothCentralShellCutoff eps
  · dsimp
    split <;>
      first
      | exact contDiff_smoothPositiveOuterShellCutoff _
      | exact contDiff_smoothNegativeOuterShellCutoff _

theorem contDiff_orderedShellPartitionPiece
    (b : Nat → Real → Real)
    (hb : ∀ i, ContDiff Real (⊤ : ℕ∞) (b i)) (i : Nat) :
    ContDiff Real (⊤ : ℕ∞) (orderedShellPartitionPiece b i) := by
  unfold orderedShellPartitionPiece
  apply (hb i).mul
  apply contDiff_prod
  intro j _
  exact contDiff_const.sub (hb j)

theorem contDiff_orderedSmoothShellPartitionPiece (eps : Real) (i : Nat) :
    ContDiff Real (⊤ : ℕ∞)
      (orderedShellPartitionPiece (smoothShellCoverCutoff eps) i) := by
  apply contDiff_orderedShellPartitionPiece
  exact contDiff_smoothShellCoverCutoff eps

theorem hasDerivAt_orderedSmoothShellPartitionPiece
    (eps : Real) (i : Nat) (u : Real) :
    HasDerivAt (orderedShellPartitionPiece (smoothShellCoverCutoff eps) i)
      (deriv (orderedShellPartitionPiece (smoothShellCoverCutoff eps) i) u) u := by
  exact ((contDiff_orderedSmoothShellPartitionPiece eps i).differentiable (by simp) u).hasDerivAt

/-- A common left endpoint for the finite smooth shell family.  The deliberately
coarse factor `3` dominates both copies of every dyadic outer bump. -/
theorem smoothShellCoverCutoff_eq_zero_of_le_commonLeft
    {eps u : Real} (heps : 0 < eps) (J : Nat) {i : Nat}
    (hi : i < 1 + 4 * J)
    (hu : u ≤ -3 * ((2 : Real) ^ J * eps)) :
    smoothShellCoverCutoff eps i u = 0 := by
  have hpowone : (1 : Real) ≤ (2 : Real) ^ J := by
    exact one_le_pow₀ (by norm_num)
  have hbigpos : 0 < (2 : Real) ^ J * eps :=
    mul_pos (pow_pos (by norm_num) _) heps
  have hepsle : eps ≤ (2 : Real) ^ J * eps := by
    nlinarith
  unfold smoothShellCoverCutoff
  split
  · apply smoothCentralShellCutoff_eq_zero_of_le_neg_two heps
    nlinarith
  · let k : Nat := (i - 1) / 4
    have hk : k ≤ J := by
      dsimp [k]
      omega
    have hpow : (2 : Real) ^ k ≤ (2 : Real) ^ J :=
      pow_le_pow_right₀ (by norm_num) hk
    have hscale : (2 : Real) ^ k * eps ≤ (2 : Real) ^ J * eps :=
      mul_le_mul_of_nonneg_right hpow heps.le
    have hrho : 0 < (2 : Real) ^ k * eps :=
      mul_pos (pow_pos (by norm_num) _) heps
    dsimp only
    split
    · apply smoothPositiveOuterShellCutoff_eq_zero_of_nonpos hrho
      simpa [k] using (show u ≤ 0 by nlinarith)
    · apply smoothPositiveOuterShellCutoff_eq_zero_of_nonpos (mul_pos (by norm_num) hrho)
      simpa [k] using (show u ≤ 0 by nlinarith)
    · apply smoothNegativeOuterShellCutoff_eq_zero_of_le_neg_two hrho
      simpa [k] using (show u ≤ -2 * ((2 : Real) ^ k * eps) by nlinarith)
    · apply smoothNegativeOuterShellCutoff_eq_zero_of_le_neg_two
        (mul_pos (by norm_num) hrho)
      simpa [k, mul_assoc] using
        (show u ≤ -2 * ((3 / 2 : Real) * ((2 : Real) ^ k * eps)) by nlinarith)

noncomputable def smoothShellCommonLeft (eps : Real) (J : Nat) : Real :=
  -4 - 3 * ((2 : Real) ^ J * eps)

theorem smoothShellCoverCutoff_commonLeft_zero
    {eps : Real} (heps : 0 < eps) (J : Nat) {i : Nat}
    (hi : i < 1 + 4 * J) (alpha : Euclidean 2 → Real)
    (halpha : ∀ xi, -4 < alpha xi) (xi : Euclidean 2) :
    smoothShellCoverCutoff eps i (smoothShellCommonLeft eps J - alpha xi) = 0 := by
  apply smoothShellCoverCutoff_eq_zero_of_le_commonLeft heps J hi
  unfold smoothShellCommonLeft
  linarith [halpha xi]

theorem orderedSmoothShellPartitionPiece_commonLeft_zero
    {eps : Real} (heps : 0 < eps) (J : Nat) {i : Nat}
    (hi : i < 1 + 4 * J) (alpha : Euclidean 2 → Real)
    (halpha : ∀ xi, -4 < alpha xi) (xi : Euclidean 2) :
    orderedShellPartitionPiece (smoothShellCoverCutoff eps) i
      (smoothShellCommonLeft eps J - alpha xi) = 0 := by
  unfold orderedShellPartitionPiece
  rw [smoothShellCoverCutoff_commonLeft_zero heps J hi alpha halpha xi]
  simp

theorem mem_centeredShellWindow_of_abs_lt
    {eps beta : Real} (J : Nat)
    (hbeta : |beta| < (2 : Real) ^ J * eps) :
    beta ∈ centeredShellWindow eps J := by
  rw [mem_centeredShellWindow_iff]
  rw [abs_lt] at hbeta
  constructor <;> linarith

/-- The central cutoff together with two copies of each dyadic outer scale
gives a genuine smooth bump cover of the sharp finite shell window.  The
second copy at scale `3 rho / 2` fills the gap that a single factor-two family
of the available outer bump would leave. -/
theorem exists_smoothShellCutoff_eq_one_of_mem_centeredShellWindow
    {eps beta : Real} (heps : 0 < eps) (J : Nat)
    (hbeta : beta ∈ centeredShellWindow eps J) :
    smoothCentralShellCutoff eps beta = 1 \/
      (∃ k ∈ Finset.range J,
        smoothPositiveOuterShellCutoff ((2 : Real) ^ k * eps) beta = 1 \/
          smoothPositiveOuterShellCutoff ((3 / 2 : Real) * ((2 : Real) ^ k * eps)) beta = 1) \/
      (∃ k ∈ Finset.range J,
        smoothNegativeOuterShellCutoff ((2 : Real) ^ k * eps) beta = 1 \/
          smoothNegativeOuterShellCutoff ((3 / 2 : Real) * ((2 : Real) ^ k * eps)) beta = 1) := by
  rcases centeredFiniteShell_cover J hbeta with hcenter | hpos | hneg
  · left
    apply smoothCentralShellCutoff_eq_one heps
    rw [centeredCentralShell] at hcenter
    rw [Set.mem_Ico] at hcenter
    rw [abs_le]
    constructor <;> linarith
  · right
    left
    rcases hpos with ⟨k, hk, hmem⟩
    refine ⟨k, hk, ?_⟩
    rw [centeredPositiveOuterShell, Set.mem_Ico] at hmem
    let rho : Real := (2 : Real) ^ k * eps
    have hrho : 0 < rho := mul_pos (pow_pos (by norm_num) _) heps
    by_cases hsmall : beta <= (3 / 2 : Real) * rho
    · left
      exact smoothPositiveOuterShellCutoff_eq_one hrho (by simpa [rho] using hmem.1)
        (by simpa [rho] using hsmall)
    · right
      apply smoothPositiveOuterShellCutoff_eq_one
        (mul_pos (by norm_num) hrho)
      · have : (3 / 2 : Real) * rho <= beta := le_of_not_ge hsmall
        simpa [rho] using this
      · have htop : beta < (2 : Real) ^ (k + 1) * eps := hmem.2
        have htwice : (2 : Real) ^ (k + 1) * eps = 2 * rho := by
          dsimp [rho]
          rw [pow_succ]
          ring
        rw [htwice] at htop
        have : beta <= (3 / 2 : Real) * ((3 / 2 : Real) * rho) := by
          linarith
        simpa [rho, mul_assoc] using this
  · right
    right
    rcases hneg with ⟨k, hk, hmem⟩
    refine ⟨k, hk, ?_⟩
    rw [centeredNegativeOuterShell, Set.mem_Ico] at hmem
    let rho : Real := (2 : Real) ^ k * eps
    have hrho : 0 < rho := mul_pos (pow_pos (by norm_num) _) heps
    have hminusmem : -beta ∈ Ioc rho (2 * rho) := by
      rw [Set.mem_Ioc]
      have hbot : -((2 : Real) ^ (k + 1) * eps) <= beta := hmem.1
      have htop : beta < -((2 : Real) ^ k * eps) := hmem.2
      have htwice : (2 : Real) ^ (k + 1) * eps = 2 * rho := by
        dsimp [rho]
        rw [pow_succ]
        ring
      constructor
      · dsimp [rho]
        linarith
      · have hupper : -beta <= 2 * rho := by
          rw [← htwice]
          linarith
        exact hupper
    by_cases hsmall : -beta <= (3 / 2 : Real) * rho
    · left
      apply smoothNegativeOuterShellCutoff_eq_one hrho
      · linarith [hsmall]
      · linarith [hminusmem.1]
    · right
      apply smoothNegativeOuterShellCutoff_eq_one
        (mul_pos (by norm_num) hrho)
      · have hupper : -beta <= 2 * rho := hminusmem.2
        have hbound : -((3 / 2 : Real) * ((3 / 2 : Real) * rho)) <= beta := by
          linarith
        simpa [rho, mul_assoc] using hbound
      · have hbound : beta <= -((3 / 2 : Real) * rho) := by
          linarith [le_of_not_ge hsmall]
        simpa [rho] using hbound

/-- Enumerated form of the smooth-shell cover, ready for the ordered-product
partition construction. -/
theorem exists_smoothShellCoverCutoff_eq_one_of_mem_centeredShellWindow
    {eps beta : Real} (heps : 0 < eps) (J : Nat)
    (hbeta : beta ∈ centeredShellWindow eps J) :
    ∃ i ∈ Finset.range (1 + 4 * J), smoothShellCoverCutoff eps i beta = 1 := by
  rcases exists_smoothShellCutoff_eq_one_of_mem_centeredShellWindow heps J hbeta with
    hcenter | hpos | hneg
  · refine ⟨0, Finset.mem_range.mpr (by omega), ?_⟩
    simpa using hcenter
  · rcases hpos with ⟨k, hk, hfirst | hsecond⟩
    · refine ⟨1 + 4 * k, Finset.mem_range.mpr (by
        rw [Finset.mem_range] at hk
        omega), ?_⟩
      simpa using hfirst
    · refine ⟨1 + 4 * k + 1, Finset.mem_range.mpr (by
        rw [Finset.mem_range] at hk
        omega), ?_⟩
      simpa using hsecond
  · rcases hneg with ⟨k, hk, hfirst | hsecond⟩
    · refine ⟨1 + 4 * k + 2, Finset.mem_range.mpr (by
        rw [Finset.mem_range] at hk
        omega), ?_⟩
      simpa using hfirst
    · refine ⟨1 + 4 * k + 3, Finset.mem_range.mpr (by
        rw [Finset.mem_range] at hk
        omega), ?_⟩
      simpa using hsecond

/-- The enumerated smooth cutoffs admit an exact finite partition of unity on
the sharp finite shell window. -/
theorem sum_orderedSmoothShellPartitionPiece_eq_one_of_mem_centeredShellWindow
    {eps beta : Real} (heps : 0 < eps) (J : Nat)
    (hbeta : beta ∈ centeredShellWindow eps J) :
    ∑ i ∈ Finset.range (1 + 4 * J),
      orderedShellPartitionPiece (smoothShellCoverCutoff eps) i beta = 1 := by
  apply sum_orderedShellPartitionPiece_eq_one
  exact exists_smoothShellCoverCutoff_eq_one_of_mem_centeredShellWindow heps J hbeta

end

end Auto.Spherical.MSS
end
-- END ScratchKakeyaSmoothShellPartition

