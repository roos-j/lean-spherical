section

section Auto.Spherical.MSS

open Filter MeasureTheory FourierTransform Set
open Auto.Spherical.SurfaceMeasureDecay
open SmoothAngularFrequencyChartFamily
open scoped BigOperators Convolution FourierTransform EuclideanSpace

noncomputable section

/- Keep the real-scalar product rule aligned with the complex normed additive
structure, as in the literal cutoff packages. -/
attribute [local instance 2000] NormedAddCommGroup.toAddCommGroup

/-- A charted, literal angular shell multiplier.  The cutoff is evaluated at
the actual physical angular parameter `theta`, while its centre is permitted
to depend smoothly on spatial frequency through the chart angle. -/
noncomputable def chartedAngularShellMultiplier
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (cutoff : Real -> Real) (theta : Real) (xi : Euclidean 2) : Complex :=
  angularCutoffFiniteTensorMultiplier s (chartProfiles C j q)
    (chartProfiles_compact C j q hqcompact) a cutoff (C.angle j) theta xi

/-- The corresponding literal derivative multiplier. -/
noncomputable def chartedAngularShellMultiplierDeriv
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (cutoff cutoffDeriv : Real -> Real) (theta : Real) (xi : Euclidean 2) : Complex :=
  angularCutoffFiniteTensorMultiplierDeriv s (chartProfiles C j q)
    (chartProfiles_compact C j q hqcompact) a cutoff cutoffDeriv (C.angle j) theta xi

/-- The physical inverse-Fourier field for one charted shell. -/
noncomputable def chartedAngularShellField
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (cutoff : Real -> Real) (theta : Real) (y : Euclidean 2) : Complex :=
  angularCutoffFiniteTensorShellField s (chartProfiles C j q)
    (chartProfiles_compact C j q hqcompact) a cutoff (C.angle j) theta y

noncomputable def chartedAngularShellFieldDeriv
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (cutoff cutoffDeriv : Real -> Real) (theta : Real) (y : Euclidean 2) : Complex :=
  angularCutoffFiniteTensorShellFieldDeriv s (chartProfiles C j q)
    (chartProfiles_compact C j q hqcompact) a cutoff cutoffDeriv (C.angle j) theta y

/-- One shell is literally the cutoff times its charted finite-tensor
multiplier.  Keeping this rewrite separate makes finite partition algebra
independent of the inverse-Fourier analytic layer. -/
theorem chartedAngularShellMultiplier_eq_cutoff_smul
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (cutoff : Real -> Real) (theta : Real) (xi : Euclidean 2) :
    chartedAngularShellMultiplier C j s q hqcompact a cutoff theta xi =
      cutoff (theta - C.angle j xi) •
        scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
          (chartProfiles_compact C j q hqcompact) a (circleDirection theta) xi := by
  rfl

/-- When the sector multiplier vanishes, its entire chart multiplier vanishes.
This is the only zero branch needed to use a shell partition that is specified
only on active chart support. -/
theorem chartMultiplier_eq_zero_of_sector_eq_zero
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (theta : Real) (xi : Euclidean 2)
    (hsector : C.sector j xi = 0) :
    scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
      (chartProfiles_compact C j q hqcompact) a (circleDirection theta) xi = 0 := by
  rw [scratch_finiteTensorTubeMultiplier_apply]
  apply Finset.sum_eq_zero
  intro i hi
  change chartProfile C j (q i) xi *
      (FourierTransform.fourier (a i) : SchwartzMap Real Complex)
        (inner Real (circleDirection theta) xi) = 0
  rw [chartProfile_apply C]
  simp [hsector]

/-- A finite smooth cutoff family reconstructs one chart multiplier whenever
it is a partition of one on the nonzero chart sector. -/
theorem sum_chartedAngularShellMultiplier_eq_chartMultiplier
    {kappa iota sigma : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (shells : Finset sigma) (cutoff : sigma -> Real -> Real)
    (theta : Real) (xi : Euclidean 2)
    (hsum : C.sector j xi ≠ 0 ->
      (∑ k ∈ shells, cutoff k (theta - C.angle j xi)) = 1) :
    (∑ k ∈ shells, chartedAngularShellMultiplier C j s q hqcompact a
      (cutoff k) theta xi) =
      scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
        (chartProfiles_compact C j q hqcompact) a (circleDirection theta) xi := by
  classical
  by_cases hsector : C.sector j xi = 0
  · have hzero := chartMultiplier_eq_zero_of_sector_eq_zero C j s q hqcompact a theta xi hsector
    rw [show (∑ k ∈ shells, chartedAngularShellMultiplier C j s q hqcompact a
        (cutoff k) theta xi) =
        ∑ k ∈ shells, cutoff k (theta - C.angle j xi) •
          scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
            (chartProfiles_compact C j q hqcompact) a (circleDirection theta) xi by
      apply Finset.sum_congr rfl
      intro k hk
      rfl]
    rw [hzero]
    simp
  · rw [show (∑ k ∈ shells, chartedAngularShellMultiplier C j s q hqcompact a
        (cutoff k) theta xi) =
        ∑ k ∈ shells, cutoff k (theta - C.angle j xi) •
          scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
            (chartProfiles_compact C j q hqcompact) a (circleDirection theta) xi by
      apply Finset.sum_congr rfl
      intro k hk
      rfl]
    rw [← Finset.sum_smul, hsum hsector]
    simp

/-- Chart synthesis followed by a finite smooth shell synthesis is exact at
the literal finite-tensor multiplier level.  The shell identity is required
only where the corresponding chart sector is nonzero. -/
theorem sum_chartedAngularShellMultiplier_eq
    {kappa iota sigma : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (hqactive : forall i, SupportedOnActive C (q i))
    (a : iota -> SchwartzMap Real Complex)
    (shells : Finset sigma) (cutoff : sigma -> Real -> Real)
    (theta : Real) (xi : Euclidean 2)
    (hsum : forall j, j ∈ charts -> C.sector j xi ≠ 0 ->
      (∑ k ∈ shells, cutoff k (theta - C.angle j xi)) = 1) :
    (∑ j ∈ charts, ∑ k ∈ shells,
      chartedAngularShellMultiplier C j s q hqcompact a (cutoff k) theta xi) =
      scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection theta) xi := by
  rw [show (∑ j ∈ charts, ∑ k ∈ shells,
      chartedAngularShellMultiplier C j s q hqcompact a (cutoff k) theta xi) =
      ∑ j ∈ charts, scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
        (chartProfiles_compact C j q hqcompact) a (circleDirection theta) xi by
      apply Finset.sum_congr rfl
      intro j hj
      exact sum_chartedAngularShellMultiplier_eq_chartMultiplier C j s q hqcompact a
        shells cutoff theta xi (hsum j hj)]
  exact sum_charted_finiteTensorTubeMultiplier_eq C s q hqcompact hqactive a
    (circleDirection theta) xi

/-- The exact chart--shell multiplier decomposition transports to literal
physical inverse-Fourier fields under the sole honest analytic hypothesis:
integrability of each finite charted-shell multiplier.  No artificial
orthogonality or frequency-independent physical cutoff is used here. -/
theorem sum_chartedAngularShellField_eq
    {kappa iota sigma : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (hqactive : forall i, SupportedOnActive C (q i))
    (a : iota -> SchwartzMap Real Complex)
    (shells : Finset sigma) (cutoff : sigma -> Real -> Real)
    (theta : Real) (y : Euclidean 2)
    (hintegrable : forall j, j ∈ charts -> forall k, k ∈ shells ->
      Integrable (fun xi => chartedAngularShellMultiplier C j s q hqcompact a
        (cutoff k) theta xi))
    (hsum : forall j, j ∈ charts -> forall xi, C.sector j xi ≠ 0 ->
      (∑ k ∈ shells, cutoff k (theta - C.angle j xi)) = 1) :
    (∑ j ∈ charts, ∑ k ∈ shells,
      chartedAngularShellField C j s q hqcompact a (cutoff k) theta y) =
      FourierTransform.fourierInv (fun xi =>
        scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection theta) xi) y := by
  classical
  let m : kappa × sigma -> Euclidean 2 -> Complex := fun jk xi =>
    chartedAngularShellMultiplier C jk.1 s q hqcompact a (cutoff jk.2) theta xi
  have hm : forall jk, jk ∈ charts ×ˢ shells -> Integrable (m jk) := by
    intro jk hjk
    rcases jk with ⟨j, k⟩
    have hjk' : (j, k) ∈ charts ×ˢ shells := by
      exact hjk
    exact hintegrable j (Finset.mem_product.mp hjk').1 k
      (Finset.mem_product.mp hjk').2
  have hfourier :=
    Auto.MikhlinHormander.fourierInv_finset_sum_of_integrable
      (charts ×ˢ shells) m hm y
  have hmult : (fun xi => ∑ jk ∈ charts ×ˢ shells, m jk xi) =
      fun xi => scratch_finiteTensorTubeMultiplier s q hqcompact a
        (circleDirection theta) xi := by
    funext xi
    have hprod := Finset.sum_product charts shells (fun jk : kappa × sigma =>
      m jk xi)
    rw [show (∑ jk ∈ charts ×ˢ shells, m jk xi) =
        ∑ j ∈ charts, ∑ k ∈ shells,
          chartedAngularShellMultiplier C j s q hqcompact a (cutoff k) theta xi by
      simpa only [m] using hprod]
    exact sum_chartedAngularShellMultiplier_eq C s q hqcompact hqactive a
      shells cutoff theta xi (fun j hj => hsum j hj xi)
  calc
    (∑ j ∈ charts, ∑ k ∈ shells,
      chartedAngularShellField C j s q hqcompact a (cutoff k) theta y) =
        ∑ jk ∈ charts ×ˢ shells, FourierTransform.fourierInv (m jk) y := by
          have hprod := Finset.sum_product charts shells (fun jk : kappa × sigma =>
            FourierTransform.fourierInv (m jk) y)
          simpa only [chartedAngularShellField,
            angularCutoffFiniteTensorShellField, chartedAngularShellMultiplier, m] using hprod.symm
    _ = FourierTransform.fourierInv (fun xi => ∑ jk ∈ charts ×ˢ shells,
        m jk xi) y := hfourier.symm
    _ = FourierTransform.fourierInv (fun xi =>
        scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection theta) xi) y := by
          rw [hmult]

/-- The telescoping central/annular family is an exact shell partition on a
chart whenever the shifted physical angle lies in its sharp centered window.
Every noncentral member is a single fixed rescaled annular profile, so this
specialization has no ordered-product derivative loss. -/
theorem sum_chartedTelescopingShellMultiplier_eq
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (hqactive : forall i, SupportedOnActive C (q i))
    (a : iota -> SchwartzMap Real Complex)
    {eps : Real} (heps : 0 < eps) (J : Nat)
    (theta : Real) (xi : Euclidean 2)
    (hwindow : forall j, j ∈ charts -> C.sector j xi ≠ 0 ->
      theta - C.angle j xi ∈ centeredShellWindow eps J) :
    (∑ j ∈ charts, ∑ k ∈ Finset.range (J + 1),
      chartedAngularShellMultiplier C j s q hqcompact a
        (telescopingShellCutoff eps k) theta xi) =
      scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection theta) xi := by
  apply sum_chartedAngularShellMultiplier_eq C s q hqcompact hqactive a
    (Finset.range (J + 1)) (telescopingShellCutoff eps) theta xi
  intro j hj hsector
  exact sum_telescopingShellCutoff_eq_one_of_mem_centeredShellWindow heps J
    (hwindow j hj hsector)

/-- The finite telescoping shell partition also reconstructs the literal
inverse-Fourier tube field.  Integrability is retained as an explicit input,
which is precisely what the compact smooth finite-tensor core supplies. -/
theorem sum_chartedTelescopingShellField_eq
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (hqactive : forall i, SupportedOnActive C (q i))
    (a : iota -> SchwartzMap Real Complex)
    {eps : Real} (heps : 0 < eps) (J : Nat)
    (theta : Real) (y : Euclidean 2)
    (hintegrable : forall j, j ∈ charts -> forall k, k ∈ Finset.range (J + 1) ->
      Integrable (fun xi => chartedAngularShellMultiplier C j s q hqcompact a
        (telescopingShellCutoff eps k) theta xi))
    (hwindow : forall j, j ∈ charts -> forall xi, C.sector j xi ≠ 0 ->
      theta - C.angle j xi ∈ centeredShellWindow eps J) :
    (∑ j ∈ charts, ∑ k ∈ Finset.range (J + 1),
      chartedAngularShellField C j s q hqcompact a
        (telescopingShellCutoff eps k) theta y) =
      FourierTransform.fourierInv (fun xi =>
        scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection theta) xi) y := by
  apply sum_chartedAngularShellField_eq C s q hqcompact hqactive a
    (Finset.range (J + 1)) (telescopingShellCutoff eps) theta y hintegrable
  intro j hj xi hsector
  exact sum_telescopingShellCutoff_eq_one_of_mem_centeredShellWindow heps J
    (hwindow j hj xi hsector)

/-- All telescoping charted fields through level `J` vanish at one common
left endpoint.  This is the exact physical endpoint condition used by the
continuous angular product-Sobolev estimate. -/
theorem chartedTelescopingShellField_eq_zero_commonLeft
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (hj : j ∈ charts)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    {eps : Real} (heps : 0 < eps) (J k : Nat)
    (hk : k ∈ Finset.range (J + 1)) (y : Euclidean 2) :
    chartedAngularShellField C j s q hqcompact a (telescopingShellCutoff eps k)
      (smoothShellCommonLeft eps J) y = 0 := by
  have hkJ : k ≤ J := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
  unfold chartedAngularShellField
  apply angularCutoffFiniteTensorShellField_eq_zero_of_cutoff_zero
    s (chartProfiles C j q) (chartProfiles_compact C j q hqcompact) a
    (telescopingShellCutoff eps k) (C.angle j) (smoothShellCommonLeft eps J)
  intro xi
  exact telescopingShellCutoff_commonLeft_zero heps J k
    hkJ (C.angle j) (C.angle_lower j hj) xi

/-- Endpoint-zero angular GN for one literal charted telescoping shell.  The
remaining continuity, derivative, and E0/E1 inputs are stated exactly so
that the central and rescaled-outer TT* packages can discharge them without
assuming a global quadratic phase estimate. -/
theorem chartedTelescopingShell_endpointZeroSobolev
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (hj : j ∈ charts)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    {eps : Real} (heps : 0 < eps) (J k : Nat)
    (hk : k ∈ Finset.range (J + 1)) {hi E0 E1 : Real}
    (hlohi : smoothShellCommonLeft eps J ≤ hi)
    (hFcont : Continuous (Function.uncurry
      (chartedAngularShellField C j s q hqcompact a (telescopingShellCutoff eps k))))
    (hDcont : Continuous (Function.uncurry
      (chartedAngularShellFieldDeriv C j s q hqcompact a
        (telescopingShellCutoff eps k)
        (deriv (telescopingShellCutoff eps k)))))
    (hderiv : forall theta y, HasDerivAt
      (fun r => chartedAngularShellField C j s q hqcompact a
        (telescopingShellCutoff eps k) r y)
      (chartedAngularShellFieldDeriv C j s q hqcompact a
        (telescopingShellCutoff eps k)
        (deriv (telescopingShellCutoff eps k)) theta y) theta)
    (hFmem : MemLp (fun p : Real × Euclidean 2 =>
      chartedAngularShellField C j s q hqcompact a
        (telescopingShellCutoff eps k) p.1 p.2) 2
      ((volume.restrict (Icc (smoothShellCommonLeft eps J) hi)).prod volume))
    (hDmem : MemLp (fun p : Real × Euclidean 2 =>
      chartedAngularShellFieldDeriv C j s q hqcompact a
        (telescopingShellCutoff eps k)
        (deriv (telescopingShellCutoff eps k)) p.1 p.2) 2
      ((volume.restrict (Icc (smoothShellCommonLeft eps J) hi)).prod volume))
    (hE0 : (∫ p : Real × Euclidean 2,
      ‖chartedAngularShellField C j s q hqcompact a
        (telescopingShellCutoff eps k) p.1 p.2‖ ^ 2 ∂
      ((volume.restrict (Icc (smoothShellCommonLeft eps J) hi)).prod volume)) ≤ E0)
    (hE1 : (∫ p : Real × Euclidean 2,
      ‖chartedAngularShellFieldDeriv C j s q hqcompact a
        (telescopingShellCutoff eps k)
        (deriv (telescopingShellCutoff eps k)) p.1 p.2‖ ^ 2 ∂
      ((volume.restrict (Icc (smoothShellCommonLeft eps J) hi)).prod volume)) ≤ E1) :
    Measurable (fun y : Euclidean 2 =>
      ⨆ theta : Icc (smoothShellCommonLeft eps J) hi, ENNReal.ofReal
        (‖chartedAngularShellField C j s q hqcompact a
          (telescopingShellCutoff eps k) theta.1 y‖ ^ 2)) ∧
      (∫⁻ y : Euclidean 2,
        ⨆ theta : Icc (smoothShellCommonLeft eps J) hi, ENNReal.ofReal
          (‖chartedAngularShellField C j s q hqcompact a
            (telescopingShellCutoff eps k) theta.1 y‖ ^ 2)) ≤
        ENNReal.ofReal (2 * Real.sqrt (E0 * E1)) := by
  have hkJ : k ≤ J := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
  exact angularCutoffFiniteTensorShell_endpointZeroSobolev
    s (chartProfiles C j q) (chartProfiles_compact C j q hqcompact) a
    (telescopingShellCutoff eps k) (deriv (telescopingShellCutoff eps k))
    (C.angle j) hlohi
    (hasDerivAt_telescopingShellCutoff eps k) hFcont hDcont hderiv
    (fun xi => telescopingShellCutoff_commonLeft_zero heps J k
      hkJ (C.angle j) (C.angle_lower j hj) xi)
    hFmem hDmem hE0 hE1

end

end Auto.Spherical.MSS
end
