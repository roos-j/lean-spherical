theorem centeredFundamental_mem_closed
    {theta : Real} (htheta : theta ∈ Ico (-Real.pi) Real.pi) :
    theta ∈ Icc (-Real.pi) Real.pi :=
  ⟨htheta.1, htheta.2.le⟩

end

