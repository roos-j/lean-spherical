section

section Auto.Spherical.MSS

open Filter Finset Set
open Auto.Spherical.SurfaceMeasureDecay
open scoped BigOperators

noncomputable section

/-- The nested smooth central cutoff at dyadic radius `2^k eps`. -/
noncomputable def telescopingCentralCutoff (eps : Real) (k : Nat) (u : Real) : Real :=
  smoothCentralShellCutoff ((2 : Real) ^ k * eps) u

/-- The exact finite shell partition obtained by telescoping nested smooth
central cutoffs.  Unlike an ordered-product partition, every outer piece is a
single fixed rescaled annular profile. -/
noncomputable def telescopingShellCutoff (eps : Real) : Nat → Real → Real
  | 0 => telescopingCentralCutoff eps 0
  | k + 1 => fun u => telescopingCentralCutoff eps (k + 1) u -
    telescopingCentralCutoff eps k u

@[simp] theorem telescopingCentralCutoff_zero (eps u : Real) :
    telescopingCentralCutoff eps 0 u = smoothCentralShellCutoff eps u := by
  simp [telescopingCentralCutoff]

@[simp] theorem telescopingShellCutoff_zero (eps u : Real) :
    telescopingShellCutoff eps 0 u = telescopingCentralCutoff eps 0 u := by
  rfl

@[simp] theorem telescopingShellCutoff_succ (eps : Real) (k : Nat) (u : Real) :
    telescopingShellCutoff eps (k + 1) u =
      telescopingCentralCutoff eps (k + 1) u - telescopingCentralCutoff eps k u := by
  rfl

theorem sum_telescopingShellCutoff (eps : Real) (J : Nat) (u : Real) :
    ∑ k ∈ Finset.range (J + 1), telescopingShellCutoff eps k u =
      telescopingCentralCutoff eps J u := by
  induction J with
  | zero => simp
  | succ J ih =>
      rw [Finset.sum_range_succ, ih]
      simp only [telescopingShellCutoff_succ]
      ring

theorem telescopingCentralCutoff_eq_one_of_mem_centeredShellWindow
    {eps u : Real} (heps : 0 < eps) (J : Nat)
    (hu : u ∈ centeredShellWindow eps J) :
    telescopingCentralCutoff eps J u = 1 := by
  unfold telescopingCentralCutoff
  apply smoothCentralShellCutoff_eq_one
  · exact mul_pos (pow_pos (by norm_num) _) heps
  · rw [mem_centeredShellWindow_iff] at hu
    rw [abs_le]
    constructor <;> linarith

/-- Exact smooth finite partition of one on the sharp angular coordinate
window. -/
theorem sum_telescopingShellCutoff_eq_one_of_mem_centeredShellWindow
    {eps u : Real} (heps : 0 < eps) (J : Nat)
    (hu : u ∈ centeredShellWindow eps J) :
    ∑ k ∈ Finset.range (J + 1), telescopingShellCutoff eps k u = 1 := by
  rw [sum_telescopingShellCutoff]
  exact telescopingCentralCutoff_eq_one_of_mem_centeredShellWindow heps J hu

theorem contDiff_telescopingCentralCutoff (eps : Real) (k : Nat) :
    ContDiff Real (⊤ : ℕ∞) (telescopingCentralCutoff eps k) := by
  unfold telescopingCentralCutoff
  exact contDiff_smoothCentralShellCutoff _

theorem contDiff_telescopingShellCutoff (eps : Real) (k : Nat) :
    ContDiff Real (⊤ : ℕ∞) (telescopingShellCutoff eps k) := by
  cases k with
  | zero => exact contDiff_telescopingCentralCutoff eps 0
  | succ k =>
      exact (contDiff_telescopingCentralCutoff eps (k + 1)).sub
        (contDiff_telescopingCentralCutoff eps k)

theorem hasDerivAt_telescopingShellCutoff (eps : Real) (k : Nat) (u : Real) :
    HasDerivAt (telescopingShellCutoff eps k)
      (deriv (telescopingShellCutoff eps k) u) u := by
  exact ((contDiff_telescopingShellCutoff eps k).differentiable (by simp) u).hasDerivAt

/-- The single fixed normalized profile of every noncentral telescoping shell.
It has two symmetric annular lobes and is identically zero near the origin. -/
noncomputable def telescopingOuterUnitProfile (v : Real) : Real :=
  smoothCentralShellBump (v / 4) - smoothCentralShellBump (v / 2)

theorem telescopingShellCutoff_succ_eq_rescaledOuterUnitProfile
    (eps : Real) (k : Nat) {rho : Real}
    (hrho : rho = (2 : Real) ^ (k + 1) * eps) (u : Real) :
    telescopingShellCutoff eps (k + 1) u = telescopingOuterUnitProfile (u / rho) := by
  subst rho
  rw [telescopingShellCutoff_succ]
  unfold telescopingCentralCutoff telescopingOuterUnitProfile smoothCentralShellCutoff
  have htwice : (2 : Real) ^ (k + 1) * eps = 2 * ((2 : Real) ^ k * eps) := by
    rw [pow_succ]
    ring
  have hlarge :
      u / (4 * ((2 : Real) ^ (k + 1) * eps)) =
        (u / ((2 : Real) ^ (k + 1) * eps)) / 4 := by
    rw [div_div]
    congr 1
    ring
  have hsmall :
      u / (4 * ((2 : Real) ^ k * eps)) =
        (u / ((2 : Real) ^ (k + 1) * eps)) / 2 := by
    rw [htwice, div_div]
    congr 1
    ring
  rw [hlarge, hsmall]

theorem contDiff_telescopingOuterUnitProfile :
    ContDiff Real (⊤ : ℕ∞) telescopingOuterUnitProfile := by
  unfold telescopingOuterUnitProfile
  exact (smoothCentralShellBump.contDiff.comp (contDiff_id.div_const 4)).sub
    (smoothCentralShellBump.contDiff.comp (contDiff_id.div_const 2))

/-- The normalized outer profile vanishes on the central interval. -/
theorem telescopingOuterUnitProfile_eq_zero_of_abs_le_half {v : Real}
    (hv : |v| ≤ 1 / 2) : telescopingOuterUnitProfile v = 0 := by
  unfold telescopingOuterUnitProfile
  have hfour : |v / 4| ≤ (1 / 4 : Real) := by
    rw [abs_div]
    norm_num
    nlinarith
  have htwo : |v / 2| ≤ (1 / 4 : Real) := by
    rw [abs_div]
    norm_num
    nlinarith
  rw [show smoothCentralShellBump (v / 4) = 1 by
    apply smoothCentralShellBump.one_of_mem_closedBall
    rw [Metric.mem_closedBall, Real.dist_eq]
    simpa [smoothCentralShellBump] using hfour]
  rw [show smoothCentralShellBump (v / 2) = 1 by
    apply smoothCentralShellBump.one_of_mem_closedBall
    rw [Metric.mem_closedBall, Real.dist_eq]
    simpa [smoothCentralShellBump] using htwo]
  ring

/-- The common left endpoint from the earlier shell module also annihilates
every telescoping piece through level `J`. -/
theorem telescopingCentralCutoff_commonLeft_zero
    {eps : Real} (heps : 0 < eps) (J k : Nat) (hk : k ≤ J)
    (alpha : Euclidean 2 → Real) (halpha : ∀ xi, -4 < alpha xi)
    (xi : Euclidean 2) :
    telescopingCentralCutoff eps k (smoothShellCommonLeft eps J - alpha xi) = 0 := by
  unfold telescopingCentralCutoff
  apply smoothCentralShellCutoff_eq_zero_of_le_neg_two
  · exact mul_pos (pow_pos (by norm_num) _) heps
  · have hpow : (2 : Real) ^ k ≤ (2 : Real) ^ J :=
      pow_le_pow_right₀ (by norm_num) hk
    have hscale : (2 : Real) ^ k * eps ≤ (2 : Real) ^ J * eps :=
      mul_le_mul_of_nonneg_right hpow heps.le
    have hSpos : 0 < (2 : Real) ^ J * eps :=
      mul_pos (pow_pos (by norm_num) _) heps
    unfold smoothShellCommonLeft
    have hu_lt : -4 - 3 * ((2 : Real) ^ J * eps) - alpha xi <
        -3 * ((2 : Real) ^ J * eps) := by
      linarith [halpha xi]
    have htarget : -3 * ((2 : Real) ^ J * eps) ≤ -2 * ((2 : Real) ^ k * eps) := by
      nlinarith
    exact hu_lt.le.trans htarget

theorem telescopingShellCutoff_commonLeft_zero
    {eps : Real} (heps : 0 < eps) (J k : Nat) (hk : k ≤ J)
    (alpha : Euclidean 2 → Real) (halpha : ∀ xi, -4 < alpha xi)
    (xi : Euclidean 2) :
    telescopingShellCutoff eps k (smoothShellCommonLeft eps J - alpha xi) = 0 := by
  cases k with
  | zero =>
      simpa using telescopingCentralCutoff_commonLeft_zero heps J 0 (Nat.zero_le _) alpha halpha xi
  | succ k =>
      rw [telescopingShellCutoff_succ]
      rw [telescopingCentralCutoff_commonLeft_zero heps J (k + 1) (by omega) alpha halpha xi]
      rw [telescopingCentralCutoff_commonLeft_zero heps J k (by omega) alpha halpha xi]
      ring

end

end Auto.Spherical.MSS
end
-- END ScratchKakeyaTelescopingShellPartition

