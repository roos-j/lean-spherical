section

section Auto.Spherical.MSS


noncomputable section

/-- The last dyadic level whose angular radius is no larger than the fixed
cap `R`.  The hypotheses below keep the logarithm in its natural nonnegative
range. -/
noncomputable def cappedShellLevel (eps R : Real) : Nat :=
  Nat.floor (Real.logb 2 (R / eps))

/-- The final dyadic radius lies below the cap. -/
theorem dyadicRadius_le_cap
    {eps R : Real} (heps : 0 < eps) (hcap : eps ≤ R) :
    (2 : Real) ^ (cappedShellLevel eps R) * eps ≤ R := by
  let x : Real := R / eps
  let K : Nat := cappedShellLevel eps R
  have hxPos : 0 < x := by
    dsimp only [x]
    exact div_pos (lt_of_lt_of_le heps hcap) heps
  have hxOne : 1 ≤ x := by
    dsimp only [x]
    exact (le_div_iff₀ heps).mpr (by simpa using hcap)
  have hlogNonneg : 0 ≤ Real.logb 2 x :=
    Real.logb_nonneg one_lt_two hxOne
  have hfloor : (K : Real) ≤ Real.logb 2 x := by
    dsimp only [K, cappedShellLevel]
    exact Nat.floor_le hlogNonneg
  have hpow : (2 : Real) ^ (K : Real) ≤ x := by
    calc
      (2 : Real) ^ (K : Real) ≤ (2 : Real) ^ (Real.logb 2 x) :=
        (Real.logb_le_iff_le_rpow one_lt_two
          (Real.rpow_pos_of_pos (by norm_num) _)).mp (by
            rw [Real.logb_rpow (by norm_num) (by norm_num)]
            exact hfloor)
      _ = x := Real.rpow_logb (by norm_num) (by norm_num) hxPos
  have hpowNat : (2 : Real) ^ K ≤ x := by
    simpa only [Real.rpow_natCast] using hpow
  change (2 : Real) ^ K * eps ≤ R
  exact (le_div_iff₀ heps).mp (by simpa only [x] using hpowNat)

/-- The cap is strictly below twice the final dyadic radius. -/
theorem cap_lt_two_mul_dyadicRadius
    {eps R : Real} (heps : 0 < eps) (hcap : eps ≤ R) :
    R < 2 * ((2 : Real) ^ (cappedShellLevel eps R) * eps) := by
  let x : Real := R / eps
  let K : Nat := cappedShellLevel eps R
  have hxPos : 0 < x := by
    dsimp only [x]
    exact div_pos (lt_of_lt_of_le heps hcap) heps
  have hxOne : 1 ≤ x := by
    dsimp only [x]
    exact (le_div_iff₀ heps).mpr (by simpa using hcap)
  have hfloorLt : Real.logb 2 x < (K : Real) + 1 := by
    dsimp only [K, cappedShellLevel]
    exact Nat.lt_floor_add_one _
  have hpow : x < (2 : Real) ^ ((K : Real) + 1) :=
    (Real.logb_lt_iff_lt_rpow one_lt_two hxPos).mp hfloorLt
  have hpowNat : x < 2 * ((2 : Real) ^ K) := by
    calc
      x < (2 : Real) ^ ((K : Real) + 1) := hpow
      _ = 2 * ((2 : Real) ^ K) := by
        rw [Real.rpow_add (by norm_num)]
        simp only [Real.rpow_one, Real.rpow_natCast]
        ring
  have hmul := mul_lt_mul_of_pos_right hpowNat heps
  have hxeq : x * eps = R := by
    dsimp only [x]
    field_simp [ne_of_gt heps]
  calc
    R = x * eps := hxeq.symm
    _ < (2 * ((2 : Real) ^ K)) * eps := hmul
    _ = 2 * ((2 : Real) ^ K * eps) := by ring

/-- Consequently the last dyadic radius/cap ratio belongs to the compact
interval used by the terminal-profile family. -/
theorem half_le_dyadicRadius_div_cap_le_one
    {eps R : Real} (heps : 0 < eps) (hcap : eps ≤ R) :
    1 / 2 ≤ ((2 : Real) ^ (cappedShellLevel eps R) * eps) / R ∧
      ((2 : Real) ^ (cappedShellLevel eps R) * eps) / R ≤ 1 := by
  have hR : 0 < R := lt_of_lt_of_le heps hcap
  constructor
  · apply (le_div_iff₀ hR).mpr
    have h := cap_lt_two_mul_dyadicRadius heps hcap
    nlinarith
  · apply (div_le_iff₀ hR).mpr
    simpa using dyadicRadius_le_cap heps hcap

/-- The fixed cap used to keep every near-stationary circle shell inside the
uniform nonlinear-IBP chart. -/
noncomputable def kakeyaAngularRadiusCap : Real := Real.pi / 2

/-- The capped terminal level at frequency `lambda`. -/
noncomputable def kakeyaCappedShellLevel (lambda : Real) : Nat :=
  cappedShellLevel (centeredCriticalWidth lambda) kakeyaAngularRadiusCap

theorem centeredCriticalWidth_le_kakeyaAngularRadiusCap
    {lambda : Real} (hlambda : 1 ≤ lambda) :
    centeredCriticalWidth lambda ≤ kakeyaAngularRadiusCap := by
  have hsqrtOne : 1 ≤ Real.sqrt lambda := Real.one_le_sqrt.mpr hlambda
  have hwidth : centeredCriticalWidth lambda ≤ 1 := by
    unfold centeredCriticalWidth
    exact inv_le_one_of_one_le₀ hsqrtOne
  have hcap : 1 ≤ kakeyaAngularRadiusCap := by
    unfold kakeyaAngularRadiusCap
    nlinarith [Real.pi_gt_three]
  exact hwidth.trans hcap

theorem kakeyaCappedShellLevel_ratio_bounds
    {lambda : Real} (hlambda : 1 ≤ lambda) :
    1 / 2 ≤
        ((2 : Real) ^ (kakeyaCappedShellLevel lambda) *
          centeredCriticalWidth lambda) / kakeyaAngularRadiusCap ∧
      ((2 : Real) ^ (kakeyaCappedShellLevel lambda) *
          centeredCriticalWidth lambda) / kakeyaAngularRadiusCap ≤ 1 := by
  exact half_le_dyadicRadius_div_cap_le_one
    (centeredCriticalWidth_pos (by linarith))
    (centeredCriticalWidth_le_kakeyaAngularRadiusCap hlambda)

theorem kakeyaCappedShellLevel_radius_bounds
    {lambda : Real} (hlambda : 1 ≤ lambda) :
    (2 : Real) ^ (kakeyaCappedShellLevel lambda) *
        centeredCriticalWidth lambda ≤ kakeyaAngularRadiusCap ∧
      kakeyaAngularRadiusCap < 2 *
        ((2 : Real) ^ (kakeyaCappedShellLevel lambda) *
          centeredCriticalWidth lambda) := by
  constructor
  · exact dyadicRadius_le_cap
      (centeredCriticalWidth_pos (by linarith))
      (centeredCriticalWidth_le_kakeyaAngularRadiusCap hlambda)
  · exact cap_lt_two_mul_dyadicRadius
      (centeredCriticalWidth_pos (by linarith))
      (centeredCriticalWidth_le_kakeyaAngularRadiusCap hlambda)

/-- The capped number of near-stationary shells still grows only
logarithmically in the frequency. -/
theorem exists_kakeyaCappedShellLevel_log_bound :
    ∃ A : Real, 0 < A ∧ ∀ lambda : Real, 1 ≤ lambda →
      ((kakeyaCappedShellLevel lambda : Nat) : Real) + 1 ≤
        A * (1 + Real.log lambda) := by
  let R : Real := kakeyaAngularRadiusCap
  let B : Real := 2 + Real.log R / Real.log 2
  let D : Real := (2 * Real.log 2)⁻¹
  let A : Real := B + D
  have hlogTwoPos : 0 < Real.log 2 := Real.log_pos one_lt_two
  have hROne : 1 ≤ R := by
    dsimp only [R, kakeyaAngularRadiusCap]
    nlinarith [Real.pi_gt_three]
  have hRPos : 0 < R := lt_of_lt_of_le zero_lt_one hROne
  have hBpos : 0 < B := by
    dsimp only [B]
    have hquot : 0 ≤ Real.log R / Real.log 2 :=
      div_nonneg (Real.log_nonneg hROne) hlogTwoPos.le
    linarith
  have hDpos : 0 < D := by
    dsimp only [D]
    positivity
  refine ⟨A, by dsimp only [A]; linarith, ?_⟩
  intro lambda hlambda
  have hlambdaPos : 0 < lambda := lt_of_lt_of_le zero_lt_one hlambda
  have hsqrtPos : 0 < Real.sqrt lambda := Real.sqrt_pos.2 hlambdaPos
  have hwidth : centeredCriticalWidth lambda = (Real.sqrt lambda)⁻¹ := rfl
  have harg : R / centeredCriticalWidth lambda = R * Real.sqrt lambda := by
    rw [hwidth]
    field_simp [ne_of_gt hsqrtPos]
  let u : Real := R * Real.sqrt lambda
  let K : Nat := kakeyaCappedShellLevel lambda
  have huPos : 0 < u := by
    dsimp only [u]
    positivity
  have hfloorLt : (K : Real) < Real.logb 2 u + 1 := by
    have hK : K = Nat.floor (Real.logb 2 (R / centeredCriticalWidth lambda)) := by
      rfl
    have huOne : 1 ≤ u := by
      dsimp only [u]
      exact one_le_mul_of_one_le_of_one_le hROne (Real.one_le_sqrt.mpr hlambda)
    have hlogNonneg : 0 ≤ Real.logb 2 (R / centeredCriticalWidth lambda) := by
      rw [harg]
      exact Real.logb_nonneg one_lt_two (by simpa only [u] using huOne)
    have hfloorLe' := Nat.floor_le hlogNonneg
    have hfloorLt' :
        (Nat.floor (Real.logb 2 (R / centeredCriticalWidth lambda)) : Real) <
          Real.logb 2 (R / centeredCriticalWidth lambda) + 1 :=
      lt_of_le_of_lt hfloorLe' (lt_add_one _)
    rw [hK]
    simpa only [u, harg] using hfloorLt'
  have hlogExpand : Real.logb 2 u = Real.log R / Real.log 2 +
      Real.log lambda / (2 * Real.log 2) := by
    dsimp only [u]
    rw [← Real.log_div_log, Real.log_mul hRPos.ne' (ne_of_gt hsqrtPos),
      Real.log_sqrt hlambdaPos.le]
    ring
  have hlogNonneg : 0 ≤ Real.log lambda := Real.log_nonneg hlambda
  have hmain : (K : Real) + 1 ≤ B + Real.log lambda * D :=
    (calc
      (K : Real) + 1 < Real.logb 2 u + 2 := by linarith
      _ = B + Real.log lambda * D := by
        dsimp only [B, D]
        rw [hlogExpand]
        ring).le
  change (K : Real) + 1 ≤ A * (1 + Real.log lambda)
  calc
    (K : Real) + 1 ≤ B + Real.log lambda * D := hmain
    _ ≤ (B + D) * (1 + Real.log lambda) := by
      nlinarith [mul_nonneg hBpos.le hlogNonneg, mul_nonneg hDpos.le hlogNonneg]
    _ = A * (1 + Real.log lambda) := by rfl

/-- The literal finite capped family has the same logarithmic cardinality. -/
theorem exists_cappedShellFamily_card_log_bound :
    ∃ A : Real, 0 < A ∧ ∀ lambda : Real, 1 ≤ lambda →
      ((Finset.range (kakeyaCappedShellLevel lambda + 2)).card : Real) ≤
        A * (1 + Real.log lambda) := by
  rcases exists_kakeyaCappedShellLevel_log_bound with ⟨A, hApos, hA⟩
  refine ⟨A + 1, by linarith, ?_⟩
  intro lambda hlambda
  have hlog : 0 ≤ Real.log lambda := Real.log_nonneg hlambda
  have hK := hA lambda hlambda
  rw [Finset.card_range]
  norm_num at hK ⊢
  nlinarith

end

end Auto.Spherical.MSS
end
