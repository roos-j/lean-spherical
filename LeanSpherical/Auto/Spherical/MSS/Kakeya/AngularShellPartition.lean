section

section Auto.Spherical.MSS

open Filter Finset Set
open Auto.Spherical.SurfaceMeasureDecay
open scoped BigOperators

noncomputable section

/-- Seven consecutive stationary centres suffice for the fixed real-angle
fundamental interval and the concrete chart-angle range `(-4, 6)`. -/
def stationaryShift : Nat -> Real
  | 0 => -3 * Real.pi
  | 1 => -2 * Real.pi
  | 2 => -Real.pi
  | 3 => 0
  | 4 => Real.pi
  | 5 => 2 * Real.pi
  | 6 => 3 * Real.pi
  | _ => 0

/-- The radial sign associated to `stationaryShift`: moving the circle
parameter through an odd multiple of `pi` reverses the frequency vector. -/
def stationaryRadialSign : Nat -> Real
  | 0 => -1
  | 1 => 1
  | 2 => -1
  | 3 => 1
  | 4 => -1
  | 5 => 1
  | 6 => -1
  | _ => 1

theorem circleDirection_add_pi (alpha : Real) :
    circleDirection (alpha + Real.pi) = -circleDirection alpha := by
  unfold circleDirection
  ext i
  fin_cases i <;> simp [Real.cos_add_pi, Real.sin_add_pi]

theorem circleDirection_sub_pi (alpha : Real) :
    circleDirection (alpha - Real.pi) = -circleDirection alpha := by
  unfold circleDirection
  ext i
  fin_cases i <;> simp [Real.cos_sub_pi, Real.sin_sub_pi]

theorem circleDirection_sub_two_pi (alpha : Real) :
    circleDirection (alpha - 2 * Real.pi) = circleDirection alpha := by
  unfold circleDirection
  ext i
  fin_cases i <;> simp [Real.cos_sub_two_pi, Real.sin_sub_two_pi]

theorem circleDirection_shifted (n : Nat) (hn : n < 7) (alpha : Real) :
    circleDirection (alpha + stationaryShift n) =
      stationaryRadialSign n • circleDirection alpha := by
  interval_cases n
  · rw [show alpha + stationaryShift 0 = (alpha - Real.pi) - 2 * Real.pi by
      simp [stationaryShift]
      ring, circleDirection_sub_two_pi, circleDirection_sub_pi]
    simp [stationaryRadialSign]
  · rw [show alpha + stationaryShift 1 = alpha - 2 * Real.pi by
      simp [stationaryShift]
      ring, circleDirection_sub_two_pi]
    simp [stationaryRadialSign]
  · rw [show alpha + stationaryShift 2 = alpha - Real.pi by
      simp [stationaryShift]
      ring, circleDirection_sub_pi]
    simp [stationaryRadialSign]
  · simp [stationaryShift, stationaryRadialSign]
  · rw [show alpha + stationaryShift 4 = alpha + Real.pi by
      simp [stationaryShift], circleDirection_add_pi]
    simp [stationaryRadialSign]
  · rw [show alpha + stationaryShift 5 = alpha + 2 * Real.pi by
      simp [stationaryShift], circleDirection_periodic]
    simp [stationaryRadialSign]
  · rw [show alpha + stationaryShift 6 = (alpha + Real.pi) + 2 * Real.pi by
      simp [stationaryShift]
      ring, circleDirection_periodic, circleDirection_add_pi]
    simp [stationaryRadialSign]

theorem neg_three_pi_le_stationaryShift (n : Nat) (hn : n < 7) :
    -3 * Real.pi ≤ stationaryShift n := by
  interval_cases n <;> simp [stationaryShift] <;> nlinarith [Real.pi_pos]

/-- The literal polar identity after moving to any of the seven stationary
centres.  The signed radial coefficient is retained explicitly for the
subsequent TT* phase analysis. -/
theorem polar_at_shifted_stationary_center
    {xi : Euclidean 2} {alpha : Real} (hpolar :
      xi = ‖xi‖ • circleDirection alpha)
    (n : Nat) (hn : n < 7) :
    xi = (stationaryRadialSign n * ‖xi‖) •
      circleDirection (alpha + stationaryShift n) := by
  rw [circleDirection_shifted n hn]
  rw [smul_smul]
  have hsign : stationaryRadialSign n * stationaryRadialSign n = 1 := by
    interval_cases n <;> norm_num [stationaryRadialSign]
  have hcoeff : stationaryRadialSign n * ‖xi‖ * stationaryRadialSign n = ‖xi‖ := by
    calc
      stationaryRadialSign n * ‖xi‖ * stationaryRadialSign n =
          (stationaryRadialSign n * stationaryRadialSign n) * ‖xi‖ := by ring
      _ = ‖xi‖ := by rw [hsign, one_mul]
  rw [hcoeff]
  exact hpolar

/-- The literal phase in every shifted chart is the same rescaled cosine
phase, with only the already-recorded signed radial frequency changed. -/
theorem inner_circleDirection_shifted_stationary_phase
    {xi : Euclidean 2} {alpha : Real} (hpolar :
      xi = ‖xi‖ • circleDirection alpha)
    (n : Nat) (hn : n < 7) (rho u : Real) :
    inner Real (circleDirection (alpha + stationaryShift n + rho * u)) xi =
      (stationaryRadialSign n * ‖xi‖) * Real.cos (rho * u) := by
  calc
    inner Real (circleDirection (alpha + stationaryShift n + rho * u)) xi =
        inner Real (circleDirection (alpha + stationaryShift n + rho * u))
          ((stationaryRadialSign n * ‖xi‖) •
            circleDirection (alpha + stationaryShift n)) := by
          exact congrArg
            (fun z : Euclidean 2 =>
              inner Real (circleDirection (alpha + stationaryShift n + rho * u)) z)
            (polar_at_shifted_stationary_center hpolar n hn)
    _ = _ := inner_circleDirection_add_smul_circleDirection
      (alpha + stationaryShift n) (rho * u) (stationaryRadialSign n * ‖xi‖)

theorem shifted_stationary_time_phase
    {xi : Euclidean 2} {alpha : Real} (hpolar :
      xi = ‖xi‖ • circleDirection alpha)
    (n : Nat) (hn : n < 7) (rho u t s : Real) :
    (t - s) * inner Real
      (circleDirection (alpha + stationaryShift n + rho * u)) xi =
      (t - s) * (stationaryRadialSign n * ‖xi‖) * Real.cos (rho * u) := by
  rw [inner_circleDirection_shifted_stationary_phase hpolar n hn rho u]
  ring

/-- The fixed cap around a shifted stationary centre. -/
noncomputable def shiftedStationaryCap
    (R alpha : Real) (n : Nat) (theta : Real) : Real :=
  smoothCentralShellCutoff R (theta - (alpha + stationaryShift n))

/-- Seven consecutive `pi`-spaced centres cover the chosen fundamental angle
interval for every concrete smooth chart angle. -/
theorem exists_shiftedStationaryCenter_within_cap
    {theta alpha : Real} (htheta : theta ∈ Icc (-Real.pi) Real.pi)
    (halphaLower : -4 < alpha) (halphaUpper : alpha < 6) :
    ∃ n ∈ Finset.range 7,
      |theta - (alpha + stationaryShift n)| ≤ Real.pi / 2 := by
  let u : Real := theta - alpha
  have hlow : -(7 / 2 : Real) * Real.pi ≤ u := by
    dsimp only [u]
    nlinarith [Real.pi_gt_three, htheta.1, halphaUpper]
  have hhigh : u ≤ (7 / 2 : Real) * Real.pi := by
    dsimp only [u]
    nlinarith [Real.pi_gt_three, htheta.2, halphaLower]
  by_cases h0 : u ≤ -(5 / 2 : Real) * Real.pi
  · refine ⟨0, by simp, ?_⟩
    rw [show theta - (alpha + stationaryShift 0) = u + 3 * Real.pi by
      dsimp only [u]
      simp [stationaryShift]
      ring, abs_le]
    constructor <;> nlinarith
  have h0' : -(5 / 2 : Real) * Real.pi < u := lt_of_not_ge h0
  by_cases h1 : u ≤ -(3 / 2 : Real) * Real.pi
  · refine ⟨1, by simp, ?_⟩
    rw [show theta - (alpha + stationaryShift 1) = u + 2 * Real.pi by
      dsimp only [u]
      simp [stationaryShift]
      ring, abs_le]
    constructor <;> nlinarith
  have h1' : -(3 / 2 : Real) * Real.pi < u := lt_of_not_ge h1
  by_cases h2 : u ≤ -(1 / 2 : Real) * Real.pi
  · refine ⟨2, by simp, ?_⟩
    rw [show theta - (alpha + stationaryShift 2) = u + Real.pi by
      dsimp only [u]
      simp [stationaryShift]
      ring, abs_le]
    constructor <;> nlinarith
  have h2' : -(1 / 2 : Real) * Real.pi < u := lt_of_not_ge h2
  by_cases h3 : u ≤ (1 / 2 : Real) * Real.pi
  · refine ⟨3, by simp, ?_⟩
    rw [show theta - (alpha + stationaryShift 3) = u by
      dsimp only [u]
      simp [stationaryShift], abs_le]
    constructor <;> nlinarith
  have h3' : (1 / 2 : Real) * Real.pi < u := lt_of_not_ge h3
  by_cases h4 : u ≤ (3 / 2 : Real) * Real.pi
  · refine ⟨4, by simp, ?_⟩
    rw [show theta - (alpha + stationaryShift 4) = u - Real.pi by
      dsimp only [u]
      simp [stationaryShift]
      ring, abs_le]
    constructor <;> nlinarith
  have h4' : (3 / 2 : Real) * Real.pi < u := lt_of_not_ge h4
  by_cases h5 : u ≤ (5 / 2 : Real) * Real.pi
  · refine ⟨5, by simp, ?_⟩
    rw [show theta - (alpha + stationaryShift 5) = u - 2 * Real.pi by
      dsimp only [u]
      simp [stationaryShift]
      ring, abs_le]
    constructor <;> nlinarith
  have h5' : (5 / 2 : Real) * Real.pi < u := lt_of_not_ge h5
  refine ⟨6, by simp, ?_⟩
  rw [show theta - (alpha + stationaryShift 6) = u - 3 * Real.pi by
    dsimp only [u]
    simp [stationaryShift]
    ring, abs_le]
  constructor <;> nlinarith

/-- At least one shifted cap is exactly one on every literal fundamental
angle. -/
theorem exists_shiftedStationaryCap_eq_one
    {theta alpha : Real} (htheta : theta ∈ Icc (-Real.pi) Real.pi)
    (halphaLower : -4 < alpha) (halphaUpper : alpha < 6) :
    ∃ n ∈ Finset.range 7,
      shiftedStationaryCap (Real.pi / 2) alpha n theta = 1 := by
  rcases exists_shiftedStationaryCenter_within_cap htheta halphaLower halphaUpper with
    ⟨n, hn, hdist⟩
  refine ⟨n, hn, ?_⟩
  unfold shiftedStationaryCap
  apply smoothCentralShellCutoff_eq_one
  · nlinarith [Real.pi_gt_three]
  · simpa [abs_sub_comm] using hdist

/-- A finite exact smooth partition of unity subordinate to the seven
shifted stationary caps.  Its fixed finite products do not introduce any
scale-dependent derivative loss. -/
noncomputable def shiftedStationaryPartitionPiece
    (alpha : Real) (n : Nat) (theta : Real) : Real :=
  orderedShellPartitionPiece (shiftedStationaryCap (Real.pi / 2) alpha) n theta

/-- The preweight in the ordered finite cover.  Factoring it out lets the
capped telescope sum to the cap itself, rather than accidentally multiplying
an already capped partition piece by a second cap. -/
noncomputable def shiftedStationaryPreweight
    (alpha : Real) (n : Nat) (theta : Real) : Real :=
  ∏ m ∈ Finset.range n, (1 - shiftedStationaryCap (Real.pi / 2) alpha m theta)

theorem shiftedStationaryPartitionPiece_eq_cap_mul_preweight
    (alpha : Real) (n : Nat) (theta : Real) :
    shiftedStationaryPartitionPiece alpha n theta =
      shiftedStationaryCap (Real.pi / 2) alpha n theta *
        shiftedStationaryPreweight alpha n theta := by
  rfl

/-- The preweight expressed in the local centred coordinate.  It is a fixed
smooth profile for each of the seven shifts, independent of the frequency
chart centre `alpha`. -/
noncomputable def shiftedStationaryPreweightProfile
    (n : Nat) (v : Real) : Real :=
  ∏ m ∈ Finset.range n,
    (1 - smoothCentralShellCutoff (Real.pi / 2)
      (v + stationaryShift n - stationaryShift m))

theorem shiftedStationaryPreweight_eq_profile
    (alpha theta : Real) (n : Nat) :
    shiftedStationaryPreweight alpha n theta =
      shiftedStationaryPreweightProfile n
        (theta - (alpha + stationaryShift n)) := by
  unfold shiftedStationaryPreweight shiftedStationaryPreweightProfile
  apply Finset.prod_congr rfl
  intro m hm
  have harg : theta - (alpha + stationaryShift m) =
      (theta - (alpha + stationaryShift n)) + stationaryShift n - stationaryShift m := by
    ring
  rw [show shiftedStationaryCap (Real.pi / 2) alpha m theta =
      smoothCentralShellCutoff (Real.pi / 2)
        (theta - (alpha + stationaryShift m)) by rfl, harg]

theorem contDiff_shiftedStationaryPreweightProfile (n : Nat) :
    ContDiff Real (⊤ : ℕ∞) (shiftedStationaryPreweightProfile n) := by
  unfold shiftedStationaryPreweightProfile
  apply contDiff_prod
  intro m hm
  apply contDiff_const.sub
  have hAffine : ContDiff Real (⊤ : ℕ∞)
      (fun v : Real => v + stationaryShift n - stationaryShift m) :=
    ((contDiff_id : ContDiff Real (⊤ : ℕ∞) (fun v : Real => v)).add
      (contDiff_const : ContDiff Real (⊤ : ℕ∞)
        (fun _ : Real => stationaryShift n))).sub
      (contDiff_const : ContDiff Real (⊤ : ℕ∞)
        (fun _ : Real => stationaryShift m))
  exact (contDiff_smoothCentralShellCutoff _).comp hAffine

theorem hasDerivAt_shiftedStationaryPreweightProfile (n : Nat) (v : Real) :
    HasDerivAt (shiftedStationaryPreweightProfile n)
      (deriv (shiftedStationaryPreweightProfile n) v) v := by
  exact ((contDiff_shiftedStationaryPreweightProfile n).differentiable (by simp) v).hasDerivAt

theorem sum_shiftedStationaryPartitionPiece_eq_one
    {theta alpha : Real} (htheta : theta ∈ Icc (-Real.pi) Real.pi)
    (halphaLower : -4 < alpha) (halphaUpper : alpha < 6) :
    ∑ n ∈ Finset.range 7, shiftedStationaryPartitionPiece alpha n theta = 1 := by
  unfold shiftedStationaryPartitionPiece
  apply sum_orderedShellPartitionPiece_eq_one
  exact exists_shiftedStationaryCap_eq_one htheta halphaLower halphaUpper

/-- The `i`th capped-telescope member inside the `n`th shifted stationary
patch.  The preweight is deliberately outside the telescope. -/
noncomputable def shiftedCappedTelescopingCutoff
    (eps : Real) (K n i : Nat) (alpha theta : Real) : Real :=
  shiftedStationaryPreweight alpha n theta *
    cappedTelescopingCutoff eps (Real.pi / 2) K i
      (theta - (alpha + stationaryShift n))

theorem sum_shiftedCappedTelescopingCutoff_eq_partitionPiece
    (eps : Real) (K n : Nat) (alpha theta : Real) :
    ∑ i ∈ Finset.range (K + 2),
      shiftedCappedTelescopingCutoff eps K n i alpha theta =
        shiftedStationaryPartitionPiece alpha n theta := by
  unfold shiftedCappedTelescopingCutoff
  rw [← Finset.mul_sum]
  rw [sum_cappedTelescopingCutoff]
  rw [shiftedStationaryPartitionPiece_eq_cap_mul_preweight]
  unfold shiftedStationaryCap
  ring

/-- The exact fixed-profile local-coordinate form of every shifted capped
shell.  All `alpha` dependence disappears after centring. -/
theorem shiftedCappedTelescopingCutoff_local_coordinate
    (eps : Real) (K n i : Nat) (alpha v : Real) :
    shiftedCappedTelescopingCutoff eps K n i alpha
      (alpha + stationaryShift n + v) =
      shiftedStationaryPreweightProfile n v *
        cappedTelescopingCutoff eps (Real.pi / 2) K i v := by
  unfold shiftedCappedTelescopingCutoff
  rw [shiftedStationaryPreweight_eq_profile]
  have harg : alpha + stationaryShift n + v - (alpha + stationaryShift n) = v := by
    ring
  rw [harg]

/-- Exact finite capped-telescope partition on the fundamental angle interval.
This is the algebraic bridge from the global circle cover to the local
near-stationary shell estimates. -/
theorem sum_shiftedCappedTelescopingCutoff_eq_one
    {theta alpha eps : Real} (K : Nat)
    (htheta : theta ∈ Icc (-Real.pi) Real.pi)
    (halphaLower : -4 < alpha) (halphaUpper : alpha < 6) :
    ∑ n ∈ Finset.range 7, ∑ i ∈ Finset.range (K + 2),
      shiftedCappedTelescopingCutoff eps K n i alpha theta = 1 := by
  calc
    (∑ n ∈ Finset.range 7, ∑ i ∈ Finset.range (K + 2),
        shiftedCappedTelescopingCutoff eps K n i alpha theta) =
        ∑ n ∈ Finset.range 7, shiftedStationaryPartitionPiece alpha n theta := by
          apply Finset.sum_congr rfl
          intro n hn
          exact sum_shiftedCappedTelescopingCutoff_eq_partitionPiece eps K n alpha theta
    _ = 1 := sum_shiftedStationaryPartitionPiece_eq_one htheta halphaLower halphaUpper

/-- In the local coordinate of a shifted stationary centre, every capped
telescope member has the same left zero endpoint. -/
theorem shiftedCappedTelescopingCutoff_eq_zero_at_local_commonLeft
    {eps : Real} (heps : 0 < eps) (K n i : Nat) (hi : i ∈ Finset.range (K + 2))
    (alpha : Real)
    (hscale : (2 : Real) ^ K * eps ≤ Real.pi / 2) :
    shiftedCappedTelescopingCutoff eps K n i alpha
      (alpha + stationaryShift n + cappedShellCommonLeft (Real.pi / 2)) = 0 := by
  unfold shiftedCappedTelescopingCutoff
  rw [show (alpha + stationaryShift n + cappedShellCommonLeft (Real.pi / 2)) -
      (alpha + stationaryShift n) = cappedShellCommonLeft (Real.pi / 2) by ring]
  have hzero : cappedTelescopingCutoff eps (Real.pi / 2) K i
      (cappedShellCommonLeft (Real.pi / 2)) = 0 := by
    simpa using cappedTelescopingCutoff_eq_zero_at_cappedCommonLeft heps
      (by nlinarith [Real.pi_gt_three]) K i hi hscale
      (fun _ : Euclidean 2 => (0 : Real)) (by intro; norm_num) 0
  rw [hzero]
  ring

/-- A genuinely global left endpoint for all seven shifted chart fields.
It is the local cap endpoint shifted past the leftmost stationary centre. -/
noncomputable def shiftedCappedShellGlobalCommonLeft : Real :=
  cappedShellCommonLeft (Real.pi / 2) - 3 * Real.pi

theorem shiftedCappedTelescopingCutoff_eq_zero_at_globalCommonLeft
    {eps : Real} (heps : 0 < eps) (K n i : Nat) (hi : i ∈ Finset.range (K + 2))
    (alpha : Real) (hn : n < 7) (halpha : -4 < alpha)
    (hscale : (2 : Real) ^ K * eps ≤ Real.pi / 2) :
    shiftedCappedTelescopingCutoff eps K n i alpha
      shiftedCappedShellGlobalCommonLeft = 0 := by
  unfold shiftedCappedTelescopingCutoff
  let center : Euclidean 2 -> Real :=
    fun _ => alpha + stationaryShift n + 3 * Real.pi
  have hcenter : ∀ xi, -4 < center xi := by
    intro xi
    dsimp only [center]
    have hshift := neg_three_pi_le_stationaryShift n hn
    nlinarith
  have hzero : cappedTelescopingCutoff eps (Real.pi / 2) K i
      (cappedShellCommonLeft (Real.pi / 2) - center 0) = 0 := by
    exact cappedTelescopingCutoff_eq_zero_at_cappedCommonLeft heps
      (by nlinarith [Real.pi_gt_three]) K i hi hscale center hcenter 0
  rw [show shiftedCappedShellGlobalCommonLeft - (alpha + stationaryShift n) =
      cappedShellCommonLeft (Real.pi / 2) - center 0 by
    unfold shiftedCappedShellGlobalCommonLeft
    dsimp only [center]
    ring, hzero]
  ring

end

