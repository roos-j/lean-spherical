noncomputable section

theorem periodic_finiteTensorCircleMultiplierField
    {iota : Type*} (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex) (y : Euclidean 2) :
    Function.Periodic
  (fun theta => finiteTensorCircleMultiplierField s q hqcompact a theta y)
      (2 * Real.pi) := by
  intro theta
  change FourierTransform.fourierInv (fun xi =>
      scratch_finiteTensorTubeMultiplier s q hqcompact a
        (circleDirection (theta + 2 * Real.pi)) xi) y =
    FourierTransform.fourierInv (fun xi =>
      scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection theta) xi) y
  rw [circleDirection_periodic]

/-- The literal circle supremum of a finite tensor is controlled by its
centred fundamental interval.  This is the form consumed by the seven-shift
stationary cover. -/
theorem iSup_sq_finiteTensorCircleMultiplierField_le_centeredFundamental
    {iota : Type*} (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex) (y : Euclidean 2) :
    (⨆ theta : Real, ENNReal.ofReal
      (‖finiteTensorCircleMultiplierField s q hqcompact a theta y‖ ^ 2)) ≤
      ⨆ theta : {r : Real // r ∈ Ico (-Real.pi) Real.pi}, ENNReal.ofReal
