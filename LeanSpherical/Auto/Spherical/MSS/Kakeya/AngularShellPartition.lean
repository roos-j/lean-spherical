section Auto.Spherical.MSS

open Filter Finset Set
open scoped BigOperators

noncomputable section

/-- The bounded-ratio terminal annular piece that caps a dyadic telescoping
partition at a fixed angular radius `R`. -/
noncomputable def cappedTerminalShellCutoff
    (eps R : Real) (K : Nat) (u : Real) : Real :=
  smoothCentralShellCutoff R u - telescopingCentralCutoff eps K u

theorem sum_telescoping_with_cappedTerminal
    (eps R : Real) (K : Nat) (u : Real) :
    (∑ k ∈ Finset.range (K + 1), telescopingShellCutoff eps k u) +
      cappedTerminalShellCutoff eps R K u = smoothCentralShellCutoff R u := by
  rw [sum_telescopingShellCutoff]
  unfold cappedTerminalShellCutoff
  ring

theorem sum_telescoping_with_cappedTerminal_eq_one_of_abs_le
    {eps R u : Real} (hR : 0 < R) (K : Nat) (hu : |u| ≤ R) :
    (∑ k ∈ Finset.range (K + 1), telescopingShellCutoff eps k u) +
      cappedTerminalShellCutoff eps R K u = 1 := by
  rw [sum_telescoping_with_cappedTerminal]
  exact smoothCentralShellCutoff_eq_one hR hu

theorem contDiff_cappedTerminalShellCutoff (eps R : Real) (K : Nat) :
    ContDiff Real (⊤ : ℕ∞) (cappedTerminalShellCutoff eps R K) := by
  unfold cappedTerminalShellCutoff
  exact (contDiff_smoothCentralShellCutoff R).sub
    (contDiff_telescopingCentralCutoff eps K)

theorem hasDerivAt_cappedTerminalShellCutoff (eps R : Real) (K : Nat) (u : Real) :
    HasDerivAt (cappedTerminalShellCutoff eps R K)
      (deriv (cappedTerminalShellCutoff eps R K) u) u := by
  exact ((contDiff_cappedTerminalShellCutoff eps R K).differentiable (by simp) u).hasDerivAt

/-- The fixed compact one-parameter family behind a capped terminal shell.
The parameter `c` is the ratio of the last dyadic radius to the cap. -/
noncomputable def cappedTerminalUnitProfile (c v : Real) : Real :=
  smoothCentralShellBump (v / 5) - smoothCentralShellBump (v / (5 * c))

theorem contDiff_cappedTerminalUnitProfile (c : Real) :
    ContDiff Real (⊤ : ℕ∞) (cappedTerminalUnitProfile c) := by
  unfold cappedTerminalUnitProfile
  exact (smoothCentralShellBump.contDiff.comp (contDiff_id.div_const 5)).sub
    (smoothCentralShellBump.contDiff.comp (contDiff_id.div_const (5 * c)))

/-- The terminal difference is a rescaled member of the compact ratio family.
`c ∈ [1/2,1]` later supplies uniform amplitude bounds. -/
theorem cappedTerminalShellCutoff_eq_rescaledUnitProfile
    {eps R : Real} (hR : R ≠ 0) (K : Nat) (u : Real) :
    cappedTerminalShellCutoff eps R K u =
      cappedTerminalUnitProfile (((2 : Real) ^ K * eps) / R)
        (u / ((4 / 5 : Real) * R)) := by
  unfold cappedTerminalShellCutoff telescopingCentralCutoff
  unfold cappedTerminalUnitProfile smoothCentralShellCutoff
  have hfour : (4 / 5 : Real) * R * 5 = 4 * R := by ring
  have hdyadic :
      (4 / 5 : Real) * R * (5 * (((2 : Real) ^ K * eps) / R)) =
        4 * ((2 : Real) ^ K * eps) := by
    field_simp [hR]
  rw [show u / (4 * R) = (u / ((4 / 5 : Real) * R)) / 5 by
    rw [div_div]
    congr 1
    rw [hfour]]
  rw [show u / (4 * ((2 : Real) ^ K * eps)) =
      (u / ((4 / 5 : Real) * R)) /
        (5 * (((2 : Real) ^ K * eps) / R)) by
    rw [div_div]
    congr 1
    rw [hdyadic]]

/-- Uniform inner vanishing of the cap family under the natural ratio lower
bound. -/
theorem cappedTerminalUnitProfile_eq_zero_of_abs_le_five_eighth
    {c v : Real} (hc : 1 / 2 ≤ c) (hv : |v| ≤ 5 / 8) :
    cappedTerminalUnitProfile c v = 0 := by
  unfold cappedTerminalUnitProfile
  have hfirst : |v / 5| ≤ (1 / 4 : Real) := by
    rw [abs_div]
    norm_num
    nlinarith
  have hsecond : |v / (5 * c)| ≤ (1 / 4 : Real) := by
    have hden : 0 < 5 * c := by nlinarith
    rw [abs_div, abs_of_nonneg hden.le]
    rw [div_le_iff₀ hden]
    nlinarith [abs_nonneg v]
  rw [show smoothCentralShellBump (v / 5) = 1 by
    apply smoothCentralShellBump.one_of_mem_closedBall
    rw [Metric.mem_closedBall, Real.dist_eq]
    simpa [smoothCentralShellBump] using hfirst]
  rw [show smoothCentralShellBump (v / (5 * c)) = 1 by
    apply smoothCentralShellBump.one_of_mem_closedBall
    rw [Metric.mem_closedBall, Real.dist_eq]
    simpa [smoothCentralShellBump] using hsecond]
  ring

end

end Auto.Spherical.MSS
end
-- END ScratchKakeyaCappedTelescopingPartition

