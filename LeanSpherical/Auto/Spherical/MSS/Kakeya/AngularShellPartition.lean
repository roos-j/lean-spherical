section

section Auto.Spherical.MSS

open Auto.Spherical.SurfaceMeasureDecay
open scoped EuclideanSpace

noncomputable section

/-- In coordinates centered at the frequency direction, the literal circle
phase is exactly a cosine.  This identifies the phase occurring in the
fixed-frequency angular `TT*` calculation with the rescaled shell phase. -/
theorem inner_circleDirection_add_smul_circleDirection
    (alpha beta lambda : Real) :
    inner Real (circleDirection (alpha + beta))
      (lambda • circleDirection alpha) = lambda * Real.cos beta := by
  let b := EuclideanSpace.basisFun (Fin 2) Real
  change inner Real
      (Real.cos (alpha + beta) • b 0 + Real.sin (alpha + beta) • b 1)
      (lambda • (Real.cos alpha • b 0 + Real.sin alpha • b 1)) =
        lambda * Real.cos beta
  simp only [inner_add_left, inner_add_right, real_inner_smul_left,
    real_inner_smul_right, b.inner_eq_one,
    b.inner_eq_zero (by decide : (0 : Fin 2) ≠ 1),
    b.inner_eq_zero (by decide : (1 : Fin 2) ≠ 0),
    mul_zero, mul_one]
  rw [Real.cos_add, Real.sin_add]
  ring_nf
  calc
    lambda * Real.cos alpha ^ 2 * Real.cos beta +
        lambda * Real.cos beta * Real.sin alpha ^ 2 =
        lambda * Real.cos beta * (Real.cos alpha ^ 2 + Real.sin alpha ^ 2) := by
          ring
    _ = lambda * Real.cos beta := by
      rw [Real.cos_sq_add_sin_sq]
      ring

/-- The phase equality used after the shell change of variables
`theta = alpha + rho*u`. -/
theorem circle_phase_centered_shell
    (alpha rho u lambda t s : Real) :
    (t - s) * inner Real (circleDirection (alpha + rho * u))
      (lambda • circleDirection alpha) =
        (t - s) * lambda * Real.cos (rho * u) := by
  rw [inner_circleDirection_add_smul_circleDirection]
  ring

end

end Auto.Spherical.MSS
end
