noncomputable section

/-- One literal chart, stationary-shift, and capped-telescope multiplier.
The shifted cutoff is evaluated against the chart's globally smooth angle;
the underlying finite-tensor multiplier itself remains at the original
physical circle direction `theta`. -/
noncomputable def shiftedChartedCappedTelescopingMultiplier
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (eps : Real) (K n i : Nat) (theta : Real) (xi : Euclidean 2) : Complex :=
  SMul.smul (shiftedCappedTelescopingCutoff eps K n i (C.angle j xi) theta)
    (scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
      (chartProfiles_compact C j q hqcompact) a (circleDirection theta) xi)

/-- The corresponding literal physical inverse-spatial-Fourier field. -/
noncomputable def shiftedChartedCappedTelescopingField
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (eps : Real) (K n i : Nat) (theta : Real) (y : Euclidean 2) : Complex :=
  FourierTransform.fourierInv (fun xi =>
    shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n i theta xi) y

/-- The polar identity retained by a chart after moving to one of the seven
stationary centres.  The signed radial coefficient is explicit so later
phase estimates can distinguish antipodal centres honestly. -/
theorem chart_polar_at_shifted_stationary_center
    {kappa : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (xi : Euclidean 2) (hpolar :
      xi = SMul.smul (norm xi) (circleDirection (C.angle j xi)))
    (n : Nat) (hn : n < 7) :
    xi = SMul.smul (stationaryRadialSign n * norm xi)
      (circleDirection (C.angle j xi + stationaryShift n)) := by
  exact polar_at_shifted_stationary_center hpolar n hn

/-- Summing the seven shifts and all capped-telescope pieces gives one
literal chart multiplier.  The two angle bounds are explicit here because
the abstract chart interface records only the lower one. -/
theorem sum_shiftedChartedCappedTelescopingMultiplier_eq_chart
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (eps : Real) (K : Nat) (theta : Real) (xi : Euclidean 2)
    (htheta : Icc (-Real.pi) Real.pi theta)
    (hangleLower : forall xi, -4 < C.angle j xi)
    (hangleUpper : forall xi, C.angle j xi < 6) :
    Finset.sum (Finset.range 7) (fun n =>
      Finset.sum (Finset.range (K + 2)) (fun i =>
        shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n i theta xi)) =
      scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
        (chartProfiles_compact C j q hqcompact) a (circleDirection theta) xi := by
  let M : Complex := scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
    (chartProfiles_compact C j q hqcompact) a (circleDirection theta) xi
  have hpartition :
      Finset.sum (Finset.range 7) (fun n =>
        Finset.sum (Finset.range (K + 2)) (fun i =>
          shiftedCappedTelescopingCutoff eps K n i (C.angle j xi) theta)) = 1 :=
    sum_shiftedCappedTelescopingCutoff_eq_one K htheta
      (hangleLower xi) (hangleUpper xi)
  change Finset.sum (Finset.range 7) (fun n =>
    Finset.sum (Finset.range (K + 2)) (fun i =>
      SMul.smul (shiftedCappedTelescopingCutoff eps K n i (C.angle j xi) theta) M)) = M
  calc
    Finset.sum (Finset.range 7) (fun n =>
        Finset.sum (Finset.range (K + 2)) (fun i =>
          SMul.smul (shiftedCappedTelescopingCutoff eps K n i (C.angle j xi) theta) M)) =
        Finset.sum (Finset.range 7) (fun n =>
          SMul.smul
            (Finset.sum (Finset.range (K + 2)) (fun i =>
              shiftedCappedTelescopingCutoff eps K n i (C.angle j xi) theta)) M) := by
          apply Finset.sum_congr rfl
          intro n hn
          exact (Finset.sum_smul
            (s := Finset.range (K + 2))
            (f := fun i =>
              shiftedCappedTelescopingCutoff eps K n i (C.angle j xi) theta)
            (x := M)).symm
    _ = SMul.smul
        (Finset.sum (Finset.range 7) (fun n =>
          Finset.sum (Finset.range (K + 2)) (fun i =>
            shiftedCappedTelescopingCutoff eps K n i (C.angle j xi) theta))) M := by
          exact (Finset.sum_smul
            (s := Finset.range 7)
            (f := fun n =>
              Finset.sum (Finset.range (K + 2)) (fun i =>
                shiftedCappedTelescopingCutoff eps K n i (C.angle j xi) theta))
            (x := M)).symm
    _ = M := by
      rw [hpartition]
      exact one_smul Real M

/-- Finite chart synthesis after the seven-shift capped telescope.  No
frequency-dependent physical tag is introduced: the whole finite sum is
still the original finite-tensor circle multiplier. -/
theorem sum_shiftedChartedCappedTelescopingMultiplier_eq
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (hqactive : forall l, SupportedOnActive C (q l))
    (a : iota -> SchwartzMap Real Complex)
    (eps : Real) (K : Nat) (theta : Real) (xi : Euclidean 2)
    (htheta : Icc (-Real.pi) Real.pi theta)
    (hangleUpper : forall j xi, C.angle j xi < 6) :
    Finset.sum charts (fun j =>
      Finset.sum (Finset.range 7) (fun n =>
        Finset.sum (Finset.range (K + 2)) (fun i =>
          shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n i theta xi))) =
      scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection theta) xi := by
  calc
    Finset.sum charts (fun j =>
        Finset.sum (Finset.range 7) (fun n =>
          Finset.sum (Finset.range (K + 2)) (fun i =>
            shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n i theta xi))) =
        Finset.sum charts (fun j =>
          scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
            (chartProfiles_compact C j q hqcompact) a (circleDirection theta) xi) := by
          apply Finset.sum_congr rfl
          intro j hj
          exact sum_shiftedChartedCappedTelescopingMultiplier_eq_chart C j s q hqcompact a
            eps K theta xi htheta
            (fun z => C.angle_lower j hj z)
            (fun z => hangleUpper j z)
    _ = scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection theta) xi :=
      sum_charted_finiteTensorTubeMultiplier_eq C s q hqcompact hqactive a
        (circleDirection theta) xi

/-- The concrete four-chart polar identity at a shifted stationary centre. -/
theorem unitDyadicFourChart_polar_at_shifted_stationary_center
    (j : Fin 4) (xi : Euclidean 2)
    (hsector : unitDyadicFourChartFamily.sector j xi = 0 -> False)
    (n : Nat) (hn : n < 7) :
    xi = SMul.smul (stationaryRadialSign n * norm xi)
      (circleDirection (unitDyadicFourChartFamily.angle j xi + stationaryShift n)) := by
  apply chart_polar_at_shifted_stationary_center unitDyadicFourChartFamily j xi
  · exact unitDyadicFourChartFamily.polar_on_sector j (by simp) xi hsector
  exact hn

/-- The requested concrete four-chart, seven-shift, capped-telescope
multiplier reassembly on one literal fundamental circle interval. -/
theorem sum_unitDyadicFourChart_shiftedCappedTelescopingMultiplier_eq
    {iota : Type*}
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (hqactive : forall l, SupportedOnActive unitDyadicFourChartFamily (q l))
    (a : iota -> SchwartzMap Real Complex)
    (eps : Real) (K : Nat) (theta : Real) (xi : Euclidean 2)
    (htheta : Icc (-Real.pi) Real.pi theta) :
    Finset.sum Finset.univ (fun j =>
      Finset.sum (Finset.range 7) (fun n =>
        Finset.sum (Finset.range (K + 2)) (fun i =>
          shiftedChartedCappedTelescopingMultiplier unitDyadicFourChartFamily j
            s q hqcompact a eps K n i theta xi))) =
      scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection theta) xi := by
  apply sum_shiftedChartedCappedTelescopingMultiplier_eq unitDyadicFourChartFamily
    s q hqcompact hqactive a eps K theta xi htheta
  intro j z
  change globalSectorAngle (chartSectorIndex j) z < 6
  exact globalSectorAngle_lt_six (chartSectorIndex j) z

/-- The finite shifted chart decomposition transports to literal inverse
spatial Fourier fields once each finite multiplier is integrable. -/
theorem sum_shiftedChartedCappedTelescopingField_eq
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (hqactive : forall l, SupportedOnActive C (q l))
    (a : iota -> SchwartzMap Real Complex)
    (eps : Real) (K : Nat) (theta : Real) (y : Euclidean 2)
    (hintegrable : forall j n i, Integrable (fun xi =>
      shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n i theta xi))
    (htheta : Icc (-Real.pi) Real.pi theta)
    (hangleUpper : forall j xi, C.angle j xi < 6) :
    Finset.sum charts (fun j =>
      Finset.sum (Finset.range 7) (fun n =>
        Finset.sum (Finset.range (K + 2)) (fun i =>
          shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i theta y))) =
      FourierTransform.fourierInv (fun xi =>
        scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection theta) xi) y := by
  let pairs : Finset (Prod kappa Nat) := SProd.sprod charts (Finset.range 7)
  let pieces : Finset (Prod (Prod kappa Nat) Nat) :=
    SProd.sprod pairs (Finset.range (K + 2))
  let m : Prod (Prod kappa Nat) Nat -> Euclidean 2 -> Complex := fun jni xi =>
    shiftedChartedCappedTelescopingMultiplier C jni.1.1 s q hqcompact a eps K
      jni.1.2 jni.2 theta xi
  have hm : forall jni, Integrable (m jni) := by
    intro jni
    exact hintegrable jni.1.1 jni.1.2 jni.2
  have hfourier :=
    Auto.MikhlinHormander.fourierInv_finset_sum_of_integrable pieces m
      (fun jni hni => hm jni) y
  have hmult : (fun xi => Finset.sum pieces (fun jni => m jni xi)) =
      fun xi => scratch_finiteTensorTubeMultiplier s q hqcompact a
        (circleDirection theta) xi := by
    funext xi
    calc
      Finset.sum pieces (fun jni => m jni xi) =
          Finset.sum pairs (fun jn =>
            Finset.sum (Finset.range (K + 2)) (fun i => m (jn, i) xi)) := by
            simpa only [pieces] using
              (Finset.sum_product pairs (Finset.range (K + 2))
                (fun jni : Prod (Prod kappa Nat) Nat => m jni xi))
      _ = Finset.sum charts (fun j =>
          Finset.sum (Finset.range 7) (fun n =>
            Finset.sum (Finset.range (K + 2)) (fun i =>
              shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n i theta xi))) :=
                  by
            simpa only [pairs, m] using
              (Finset.sum_product charts (Finset.range 7)
                (fun jn : Prod kappa Nat =>
                  Finset.sum (Finset.range (K + 2)) (fun i =>
                    shiftedChartedCappedTelescopingMultiplier C jn.1 s q hqcompact a eps K
                      jn.2 i theta xi)))
      _ = scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection theta) xi :=
        sum_shiftedChartedCappedTelescopingMultiplier_eq C s q hqcompact hqactive a
          eps K theta xi htheta hangleUpper
  calc
    Finset.sum charts (fun j =>
        Finset.sum (Finset.range 7) (fun n =>
          Finset.sum (Finset.range (K + 2)) (fun i =>
            shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i theta y))) =
        Finset.sum pairs (fun jn =>
          Finset.sum (Finset.range (K + 2)) (fun i =>
            FourierTransform.fourierInv (m (jn, i)) y)) := by
          simpa only [pairs, m, shiftedChartedCappedTelescopingField] using
            (Finset.sum_product charts (Finset.range 7)
              (fun jn : Prod kappa Nat =>
                Finset.sum (Finset.range (K + 2)) (fun i =>
                  FourierTransform.fourierInv (m (jn, i)) y))).symm
    _ = Finset.sum pieces (fun jni => FourierTransform.fourierInv (m jni) y) := by
          simpa only [pieces] using
            (Finset.sum_product pairs (Finset.range (K + 2))
              (fun jni : Prod (Prod kappa Nat) Nat =>
                FourierTransform.fourierInv (m jni) y)).symm
    _ = FourierTransform.fourierInv (fun xi => Finset.sum pieces (fun jni => m jni xi)) y :=
      hfourier.symm
    _ = FourierTransform.fourierInv (fun xi =>
        scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection theta) xi) y := by
          rw [hmult]

/-- The physical inverse-Fourier reassembly for the concrete four smooth
charts and seven shifted stationary patches. -/
theorem sum_unitDyadicFourChart_shiftedCappedTelescopingField_eq
    {iota : Type*}
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (hqactive : forall l, SupportedOnActive unitDyadicFourChartFamily (q l))
    (a : iota -> SchwartzMap Real Complex)
    (eps : Real) (K : Nat) (theta : Real) (y : Euclidean 2)
    (hintegrable : forall j n i, Integrable (fun xi =>
      shiftedChartedCappedTelescopingMultiplier unitDyadicFourChartFamily j
        s q hqcompact a eps K n i theta xi))
    (htheta : Icc (-Real.pi) Real.pi theta) :
    Finset.sum Finset.univ (fun j =>
      Finset.sum (Finset.range 7) (fun n =>
        Finset.sum (Finset.range (K + 2)) (fun i =>
          shiftedChartedCappedTelescopingField unitDyadicFourChartFamily j
            s q hqcompact a eps K n i theta y))) =
      FourierTransform.fourierInv (fun xi =>
        scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection theta) xi) y := by
  apply sum_shiftedChartedCappedTelescopingField_eq unitDyadicFourChartFamily
    s q hqcompact hqactive a eps K theta y hintegrable htheta
  intro j xi
  change globalSectorAngle (chartSectorIndex j) xi < 6
  exact globalSectorAngle_lt_six (chartSectorIndex j) xi

end

