section

section Auto.Spherical.MSS

open Filter MeasureTheory FourierTransform Set
open Auto.Spherical.SurfaceMeasureDecay
open SmoothAngularFrequencyChartFamily
open scoped BigOperators Convolution FourierTransform EuclideanSpace

noncomputable section

/-- A finite indexed capped telescope: the `K+1` dyadic pieces are followed
by exactly one terminal capped annulus. -/
noncomputable def cappedTelescopingCutoff
    (eps R : Real) (K i : Nat) (u : Real) : Real :=
  if i = K + 1 then cappedTerminalShellCutoff eps R K u
  else telescopingShellCutoff eps i u

theorem cappedTelescopingCutoff_eq_terminal
    (eps R : Real) (K : Nat) (u : Real) :
    cappedTelescopingCutoff eps R K (K + 1) u =
      cappedTerminalShellCutoff eps R K u := by
  simp [cappedTelescopingCutoff]

theorem cappedTelescopingCutoff_eq_dyadic
    (eps R : Real) (K i : Nat) (hi : i < K + 1) (u : Real) :
    cappedTelescopingCutoff eps R K i u = telescopingShellCutoff eps i u := by
  unfold cappedTelescopingCutoff
  rw [if_neg (Nat.ne_of_lt hi)]

theorem hasDerivAt_cappedTelescopingCutoff
    (eps R : Real) (K i : Nat) (u : Real) :
    HasDerivAt (cappedTelescopingCutoff eps R K i)
      (deriv (cappedTelescopingCutoff eps R K i) u) u := by
  by_cases hi : i = K + 1
  · subst i
    rw [show cappedTelescopingCutoff eps R K (K + 1) =
        cappedTerminalShellCutoff eps R K by
      funext v
      exact cappedTelescopingCutoff_eq_terminal eps R K v]
    exact hasDerivAt_cappedTerminalShellCutoff eps R K u
  · rw [show cappedTelescopingCutoff eps R K i =
      telescopingShellCutoff eps i by
      funext v
      unfold cappedTelescopingCutoff
      rw [if_neg hi]]
    exact hasDerivAt_telescopingShellCutoff eps i u

/-- Exact finite capped-telescope identity. -/
theorem sum_cappedTelescopingCutoff
    (eps R : Real) (K : Nat) (u : Real) :
    ∑ i ∈ Finset.range (K + 2), cappedTelescopingCutoff eps R K i u =
      smoothCentralShellCutoff R u := by
  have hsplit :
      (∑ i ∈ Finset.range (K + 1), cappedTelescopingCutoff eps R K i u) =
        ∑ i ∈ Finset.range (K + 1), telescopingShellCutoff eps i u := by
    apply Finset.sum_congr rfl
    intro i hi
    exact cappedTelescopingCutoff_eq_dyadic eps R K i
      (Finset.mem_range.mp hi) u
  rw [show K + 2 = (K + 1) + 1 by omega, Finset.sum_range_succ]
  rw [hsplit, cappedTelescopingCutoff_eq_terminal]
  exact sum_telescoping_with_cappedTerminal eps R K u

theorem sum_cappedTelescopingCutoff_eq_one_of_abs_le
    {eps R u : Real} (hR : 0 < R) (K : Nat) (hu : |u| ≤ R) :
    ∑ i ∈ Finset.range (K + 2), cappedTelescopingCutoff eps R K i u = 1 := by
  rw [sum_cappedTelescopingCutoff]
  exact smoothCentralShellCutoff_eq_one hR hu

/-- Exact multiplier-level reassembly for a capped telescope.  The chart
geometry is encapsulated solely in the honest shifted-angle window input. -/
theorem sum_chartedCappedTelescopingShellMultiplier_eq
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (hqactive : forall i, SupportedOnActive C (q i))
    (a : iota -> SchwartzMap Real Complex)
    {eps R : Real} (hR : 0 < R) (K : Nat)
    (theta : Real) (xi : Euclidean 2)
    (hwindow : forall j, j ∈ charts -> C.sector j xi ≠ 0 ->
      |theta - C.angle j xi| ≤ R) :
    (∑ j ∈ charts, ∑ i ∈ Finset.range (K + 2),
      chartedAngularShellMultiplier C j s q hqcompact a
        (cappedTelescopingCutoff eps R K i) theta xi) =
      scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection theta) xi := by
  apply sum_chartedAngularShellMultiplier_eq C s q hqcompact hqactive a
    (Finset.range (K + 2)) (cappedTelescopingCutoff eps R K) theta xi
  intro j hj hsector
  exact sum_cappedTelescopingCutoff_eq_one_of_abs_le hR K
    (hwindow j hj hsector)

/-- The same capped partition after literal inverse spatial Fourier.  Its
integrability hypothesis is exactly the finite compact-tensor condition that
must be supplied before applying the physical endpoint step. -/
theorem sum_chartedCappedTelescopingShellField_eq
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (hqactive : forall i, SupportedOnActive C (q i))
    (a : iota -> SchwartzMap Real Complex)
    {eps R : Real} (hR : 0 < R) (K : Nat)
    (theta : Real) (y : Euclidean 2)
    (hintegrable : forall j, j ∈ charts -> forall i, i ∈ Finset.range (K + 2) ->
      Integrable (fun xi => chartedAngularShellMultiplier C j s q hqcompact a
        (cappedTelescopingCutoff eps R K i) theta xi))
    (hwindow : forall j, j ∈ charts -> forall xi, C.sector j xi ≠ 0 ->
      |theta - C.angle j xi| ≤ R) :
    (∑ j ∈ charts, ∑ i ∈ Finset.range (K + 2),
      chartedAngularShellField C j s q hqcompact a
        (cappedTelescopingCutoff eps R K i) theta y) =
      FourierTransform.fourierInv (fun xi =>
        scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection theta) xi) y := by
  apply sum_chartedAngularShellField_eq C s q hqcompact hqactive a
    (Finset.range (K + 2)) (cappedTelescopingCutoff eps R K) theta y hintegrable
  intro j hj xi hsector
  exact sum_cappedTelescopingCutoff_eq_one_of_abs_le hR K
    (hwindow j hj xi hsector)

/-- A common left endpoint for every dyadic and capped terminal piece.  It
depends only on the fixed cap, not on the particular shell level. -/
noncomputable def cappedShellCommonLeft (R : Real) : Real := -4 - 3 * R

theorem telescopingCentralCutoff_eq_zero_at_cappedCommonLeft
    {eps R : Real} (heps : 0 < eps) (hR : 0 < R) (K k : Nat) (hk : k ≤ K)
    (hscale : (2 : Real) ^ K * eps ≤ R)
    (alpha : Euclidean 2 -> Real) (halpha : forall xi, -4 < alpha xi)
    (xi : Euclidean 2) :
    telescopingCentralCutoff eps k (cappedShellCommonLeft R - alpha xi) = 0 := by
  unfold telescopingCentralCutoff
  apply smoothCentralShellCutoff_eq_zero_of_le_neg_two
  · exact mul_pos (pow_pos (by norm_num) _) heps
  · have hpow : (2 : Real) ^ k ≤ (2 : Real) ^ K :=
      pow_le_pow_right₀ (by norm_num) hk
    have hsmall : (2 : Real) ^ k * eps ≤ R := by
      exact (mul_le_mul_of_nonneg_right hpow heps.le).trans hscale
    unfold cappedShellCommonLeft
    linarith [halpha xi]

theorem telescopingShellCutoff_eq_zero_at_cappedCommonLeft
    {eps R : Real} (heps : 0 < eps) (hR : 0 < R) (K k : Nat) (hk : k ≤ K)
    (hscale : (2 : Real) ^ K * eps ≤ R)
    (alpha : Euclidean 2 -> Real) (halpha : forall xi, -4 < alpha xi)
    (xi : Euclidean 2) :
    telescopingShellCutoff eps k (cappedShellCommonLeft R - alpha xi) = 0 := by
  cases k with
  | zero =>
      simpa using telescopingCentralCutoff_eq_zero_at_cappedCommonLeft
        heps hR K 0 (Nat.zero_le _) hscale alpha halpha xi
  | succ k =>
      rw [telescopingShellCutoff_succ]
      rw [telescopingCentralCutoff_eq_zero_at_cappedCommonLeft
        heps hR K (k + 1) (by omega) hscale alpha halpha xi]
      rw [telescopingCentralCutoff_eq_zero_at_cappedCommonLeft
        heps hR K k (by omega) hscale alpha halpha xi]
      ring

theorem cappedTerminalShellCutoff_eq_zero_at_cappedCommonLeft
    {eps R : Real} (heps : 0 < eps) (hR : 0 < R) (K : Nat)
    (hscale : (2 : Real) ^ K * eps ≤ R)
    (alpha : Euclidean 2 -> Real) (halpha : forall xi, -4 < alpha xi)
    (xi : Euclidean 2) :
    cappedTerminalShellCutoff eps R K (cappedShellCommonLeft R - alpha xi) = 0 := by
  unfold cappedTerminalShellCutoff
  rw [show smoothCentralShellCutoff R (cappedShellCommonLeft R - alpha xi) = 0 by
    apply smoothCentralShellCutoff_eq_zero_of_le_neg_two hR
    unfold cappedShellCommonLeft
    linarith [halpha xi]]
  rw [telescopingCentralCutoff_eq_zero_at_cappedCommonLeft
    heps hR K K le_rfl hscale alpha halpha xi]
  ring

/-- Every member of the finite capped family has the common physical endpoint
zero needed by the endpoint-zero angular Sobolev theorem. -/
theorem cappedTelescopingCutoff_eq_zero_at_cappedCommonLeft
    {eps R : Real} (heps : 0 < eps) (hR : 0 < R) (K i : Nat)
    (hi : i ∈ Finset.range (K + 2))
    (hscale : (2 : Real) ^ K * eps ≤ R)
    (alpha : Euclidean 2 -> Real) (halpha : forall xi, -4 < alpha xi)
    (xi : Euclidean 2) :
    cappedTelescopingCutoff eps R K i (cappedShellCommonLeft R - alpha xi) = 0 := by
  by_cases hterminal : i = K + 1
  · subst i
    rw [cappedTelescopingCutoff_eq_terminal]
    exact cappedTerminalShellCutoff_eq_zero_at_cappedCommonLeft
      heps hR K hscale alpha halpha xi
  · have hlt : i < K + 2 := Finset.mem_range.mp hi
    have hiK : i ≤ K := by omega
    rw [cappedTelescopingCutoff_eq_dyadic eps R K i (by omega)]
    exact telescopingShellCutoff_eq_zero_at_cappedCommonLeft
      heps hR K i hiK hscale alpha halpha xi

end

end Auto.Spherical.MSS
end
