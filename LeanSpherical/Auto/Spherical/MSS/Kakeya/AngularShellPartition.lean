section Auto.Spherical.MSS

open Filter MeasureTheory FourierTransform Set
open Auto.Spherical.SurfaceMeasureDecay
open SmoothAngularFrequencyChartFamily
open scoped BigOperators Convolution FourierTransform EuclideanSpace

noncomputable section

/-- The literal inverse-Fourier finite-tensor tube multiplier field before
chart/shell localization. -/
noncomputable def finiteTensorCircleMultiplierField
    {iota : Type*} (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (theta : Real) (y : Euclidean 2) : Complex :=
  FourierTransform.fourierInv (fun xi =>
    scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection theta) xi) y

/-- The direct finite physical-shell Cauchy reassembly conclusion for a
capped telescope.  It is intentionally parameterized by arbitrary angular
index type `Theta`, so the final application may take a literal compact
interval subtype without any invalid frequency-dependent physical tags. -/
theorem lintegral_iSup_sq_cappedChartedShell_reassembly
    {kappa iota Theta : Type*} {charts : Finset kappa}
    {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (hqactive : forall i, SupportedOnActive C (q i))
    (a : iota -> SchwartzMap Real Complex)
    {eps R : Real} (hR : 0 < R) (K : Nat)
    (thetaVal : Theta -> Real)
    (hintegrable : forall theta, forall j, j ∈ charts ->
      forall i, i ∈ Finset.range (K + 2) ->
        Integrable (fun xi => chartedAngularShellMultiplier C j s q hqcompact a
          (cappedTelescopingCutoff eps R K i) (thetaVal theta) xi))
    (hwindow : forall theta, forall j, j ∈ charts -> forall xi,
      C.sector j xi ≠ 0 -> |thetaVal theta - C.angle j xi| ≤ R)
    (B : kappa × Nat -> ENNReal)
    (hpieceMeas : forall ji, ji ∈ charts ×ˢ Finset.range (K + 2) ->
      Measurable (fun y : Euclidean 2 =>
        ⨆ theta : Theta, ENNReal.ofReal
          (‖chartedAngularShellField C ji.1 s q hqcompact a
            (cappedTelescopingCutoff eps R K ji.2) (thetaVal theta) y‖ ^ 2)))
    (hpieceBound : forall ji, ji ∈ charts ×ˢ Finset.range (K + 2) ->
      (∫⁻ y : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
        (‖chartedAngularShellField C ji.1 s q hqcompact a
          (cappedTelescopingCutoff eps R K ji.2) (thetaVal theta) y‖ ^ 2)) ≤ B ji) :
    (∫⁻ y : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
      (‖finiteTensorCircleMultiplierField s q hqcompact a (thetaVal theta) y‖ ^ 2)) ≤
      ((charts ×ˢ Finset.range (K + 2)).card : ENNReal) *
        ∑ ji ∈ charts ×ˢ Finset.range (K + 2), B ji := by
  let shells : Finset (kappa × Nat) := charts ×ˢ Finset.range (K + 2)
  let piece : kappa × Nat -> Theta -> Euclidean 2 -> Complex := fun ji theta y =>
    chartedAngularShellField C ji.1 s q hqcompact a
      (cappedTelescopingCutoff eps R K ji.2) (thetaVal theta) y
  have hdecomp : forall theta y,
      finiteTensorCircleMultiplierField s q hqcompact a (thetaVal theta) y =
        ∑ ji ∈ shells, piece ji theta y := by
    intro theta y
    have hfield := sum_chartedCappedTelescopingShellField_eq C s q hqcompact hqactive a
      hR K (thetaVal theta) y
      (fun j hj i hi => hintegrable theta j hj i hi)
      (fun j hj xi hsector => hwindow theta j hj xi hsector)
    unfold finiteTensorCircleMultiplierField
    calc
      FourierTransform.fourierInv (fun xi =>
        scratch_finiteTensorTubeMultiplier s q hqcompact a
          (circleDirection (thetaVal theta)) xi) y =
        ∑ j ∈ charts, ∑ i ∈ Finset.range (K + 2),
          chartedAngularShellField C j s q hqcompact a
            (cappedTelescopingCutoff eps R K i) (thetaVal theta) y := hfield.symm
      _ = ∑ ji ∈ shells, piece ji theta y := by
        have hprod := Finset.sum_product charts (Finset.range (K + 2))
          (fun ji : kappa × Nat => piece ji theta y)
        exact hprod.symm
  apply lintegral_iSup_sq_finite_shell_sum_le_of_bounds volume shells
    (finiteTensorCircleMultiplierField s q hqcompact a ∘ thetaVal) piece B hdecomp
  · intro ji hji
    exact hpieceMeas ji hji
  · intro ji hji
    exact hpieceBound ji hji

end

end Auto.Spherical.MSS
end
