  apply iSup_le
  intro theta
  rcases Function.Periodic.exists_mem_Ico
      (periodic_finiteTensorCircleMultiplierField s q hqcompact a y)
      Real.two_pi_pos theta (-Real.pi) with ⟨beta, hbeta, hEq⟩
  have hbeta' : beta ∈ Ico (-Real.pi) Real.pi := by
    rw [show -Real.pi + 2 * Real.pi = Real.pi by ring] at hbeta
    exact hbeta
  calc
    ENNReal.ofReal (‖finiteTensorCircleMultiplierField s q hqcompact a theta y‖ ^ 2) =
        ENNReal.ofReal (‖finiteTensorCircleMultiplierField s q hqcompact a beta y‖ ^ 2) := by
          rw [hEq]
    _ ≤ ⨆ beta : {r : Real // r ∈ Ico (-Real.pi) Real.pi}, ENNReal.ofReal
        (‖finiteTensorCircleMultiplierField s q hqcompact a beta.1 y‖ ^ 2) :=
      le_iSup (fun beta : {r : Real // r ∈ Ico (-Real.pi) Real.pi} => ENNReal.ofReal
