    C j s q hqcompact a eps K n (K + 1) lo hi
  have hSmult : (fun theta xi => S.multiplier theta xi) =
      shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n (K + 1) := by
    rfl
  have hSderiv : (fun theta xi => S.multiplierDeriv theta xi) =
      shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n (K + 1) := by
    rfl
  have hsupp := shiftedChartedCappedTelescopingMultiplier_support_on_of_profiles_supportedOn
    C j s q hqcompact a eps K n (K + 1) (scaledDyadicFrequencyAnnulus lambda) hqann
  refine ⟨concreteAnnularShellFiberEnergyWitness C j s q hqcompact a eps K n (K + 1)
    lo hi lambda r B S hsupp.1 hsupp.2 ?_ ?_, ?_⟩
  · intro xi hxi
    have hnormlo : lambda / 2 ≤ ‖xi‖ := hxi.1
    have hxine : xi ≠ 0 := by
      intro hzero
      rw [hzero] at hnormlo
      simp at hnormlo
      linarith
    have hnorm : ‖xi‖ ≠ 0 := norm_ne_zero_iff.mpr hxine
    have hbase := shellFrequencyEnergy_shiftedCharted_terminal_le_source_of_sectorCases
      C j hj s q hqcompact a K n lo hi xi hn hnorm hratio hratioDef hr hrmem D hrTime htime
    have hsourceNonneg : 0 ≤ shiftedFiberSourceEnergy s (chartProfiles C j q) a xi :=
      shiftedFiberSourceEnergy_nonneg s (chartProfiles C j q) a xi
    have hden : 0 < ‖xi‖ * r :=
      mul_pos (norm_pos_iff.mpr hxine) hrmem.1
    have hcoef : B0 / (‖xi‖ * r) ≤ B / (‖xi‖ * r) := by
      apply (div_le_div_iff_of_pos_right hden).mpr
      dsimp only [B]
      linarith
    rw [hSmult]
    exact hbase.trans (mul_le_mul_of_nonneg_right hcoef hsourceNonneg)
  · intro xi hxi
    have hnormlo : lambda / 2 ≤ ‖xi‖ := hxi.1
    have hxine : xi ≠ 0 := by
      intro hzero
      rw [hzero] at hnormlo
      simp at hnormlo
      linarith
    have hnorm : ‖xi‖ ≠ 0 := norm_ne_zero_iff.mpr hxine
    have hbase := hE1 C j hj s q hqcompact a K hratioDef hr lo hi xi hn hnorm
