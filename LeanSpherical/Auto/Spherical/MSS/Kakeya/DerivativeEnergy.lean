set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- A fully literal dyadic outer E1 estimate.  The phase term uses the actual
time-weighted datum created by differentiation of the Fourier character;
the strict inner time slab has already been absorbed into the finite constant
`B`.  No phase-energy witness is an input to this result. -/
theorem exists_shellFrequencyEnergy_shiftedCharted_dyadic_deriv_le_source
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) (n : Nat) :
    ∃ B : Real, 0 < B ∧
      ∀ {kappa : Type uK} {iota : Type uI}
        {charts : Finset kappa} {active : Set (Euclidean 2)}
        (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
        (s : Finset iota)
        (q : iota → SchwartzMap (Euclidean 2) Complex)
        (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
        (a : iota → SchwartzMap Real Complex)
        {eps r : Real} (_heps : 0 < eps) (K k : Nat) (_hk : k < K)
        (lo hi : Real) (xi : Euclidean 2)
        (_hpolar : xi = ‖xi‖ • circleDirection (C.angle j xi))
        (_hn : n < 7) (_hxi : ‖xi‖ ≠ 0)
        (_hr : r = (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps))
        (_hrmem : r ∈ Ioc (0 : Real) rhoMax)
        (_houter : 1 ≤ ‖xi‖ * r ^ 2)
        {rTime : Real} (_hrTime : rTime < 1)
        (_hsupport : ∀ l, Function.support (a l : Real → Complex) ⊆
          closedBall (3 / 2 : Real) rTime),
      shellFrequencyEnergy
        (shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n (k + 1))
        lo hi xi ≤ B * (‖xi‖ * r) *
          shiftedFiberSourceEnergy s (chartProfiles C j q) a xi := by
  rcases nonempty_shiftedDyadicFiberLobeEnergyBounds.{uI}
      hrhoMax hrhoMax_small n with ⟨D⟩
  rcases exists_timeWeighted_shiftedFiberLobeEnergy_scaled_E1_of_hasJoint
      hrhoMax hrhoMax_small
      (shiftedDyadicPositiveScaledPhaseProfile n)
      (hasJointSndSmooth_shiftedDyadicPositiveScaledPhaseProfile n 0)
      (hasJointSndSmooth_shiftedDyadicPositiveScaledPhaseProfile n 2)
      (shiftedDyadicPositiveScaledPhaseProfile_eventuallyEq_zero_left n)
      (shiftedDyadicPositiveScaledPhaseProfile_eventuallyEq_zero_right n) with
      ⟨Bphaseplus, hBphaseplus, hphaseplus⟩
  rcases exists_timeWeighted_shiftedFiberLobeEnergy_scaled_E1_of_hasJoint
      hrhoMax hrhoMax_small
      (shiftedDyadicReflectedNegativeScaledPhaseProfile n)
      (hasJointSndSmooth_shiftedDyadicReflectedNegativeScaledPhaseProfile n 0)
      (hasJointSndSmooth_shiftedDyadicReflectedNegativeScaledPhaseProfile n 2)
      (shiftedDyadicReflectedNegativeScaledPhaseProfile_eventuallyEq_zero_left n)
      (shiftedDyadicReflectedNegativeScaledPhaseProfile_eventuallyEq_zero_right n) with
      ⟨Bphaseminus, hBphaseminus, hphaseminus⟩
  refine ⟨4 * (D.Bcutplus + D.Bcutminus) +
      4 * (2 * Real.pi) ^ 2 * (Bphaseplus + Bphaseminus), ?_, ?_⟩
  · have hcut : 0 < D.Bcutplus + D.Bcutminus :=
      add_pos D.cutoffplus.1 D.cutoffminus.1
    nlinarith [sq_nonneg (2 * Real.pi), add_pos hBphaseplus hBphaseminus]
  · intro kappa iota charts active C j s q hqcompact a eps r heps K k hk lo hi xi
      hpolar hn hxi hr hrmem houter rTime hrTime hsupport
    let signedLambda : Real := stationaryRadialSign n * ‖xi‖
    have hsign : stationaryRadialSign n ≠ 0 := by
      interval_cases n <;> norm_num [stationaryRadialSign]
    have hsigned : signedLambda ≠ 0 := mul_ne_zero hsign hxi
    have habs : |signedLambda| = ‖xi‖ := by
      dsimp [signedLambda]
      interval_cases n <;> simp [stationaryRadialSign]
    have hphaseplus' := hphaseplus r hrmem signedLambda hsigned
      (((2 * Real.pi) * signedLambda * r) ^ 2) (sq_nonneg _)
      s (chartProfiles C j q) a xi hrTime hsupport
    have hphaseminus' := hphaseminus r hrmem signedLambda hsigned
      (((2 * Real.pi) * signedLambda * r) ^ 2) (sq_nonneg _)
      s (chartProfiles C j q) a xi hrTime hsupport
    have hphaseWeighted :
        2 * ((((2 * Real.pi) * signedLambda * r) ^ 2) *
            shiftedFiberLobeEnergy (shiftedDyadicPositiveScaledPhaseProfile n) r signedLambda
              (timeWeighted (scratch_finiteTensorTimeData s (chartProfiles C j q) a xi)) +
          (((2 * Real.pi) * signedLambda * r) ^ 2) *
            shiftedFiberLobeEnergy (shiftedDyadicReflectedNegativeScaledPhaseProfile n) r
                signedLambda
              (timeWeighted (scratch_finiteTensorTimeData s (chartProfiles C j q) a xi))) ≤
        2 * ((((2 * Real.pi) * signedLambda * r) ^ 2) *
            (Bphaseplus / (|signedLambda| * r)) *
              shiftedFiberSourceEnergy s (chartProfiles C j q) a xi +
          (((2 * Real.pi) * signedLambda * r) ^ 2) *
            (Bphaseminus / (|signedLambda| * r)) *
              shiftedFiberSourceEnergy s (chartProfiles C j q) a xi) := by
      exact mul_le_mul_of_nonneg_left (add_le_add hphaseplus' hphaseminus') (by norm_num)
    have hphaseWeighted' := hphaseWeighted
    rw [habs] at hphaseWeighted'
    have htransport :=
      shellFreqEnergy_shiftedCharted_dy_deriv_le_source_of_cutoff_and_wtdPhaseBounds
        C j s q hqcompact a heps K n k hk lo hi xi hpolar hn hxi hr hrmem houter
        D hrTime hsupport Bphaseplus Bphaseminus
        (by simpa only [signedLambda] using hphaseWeighted')
    exact htransport

end

