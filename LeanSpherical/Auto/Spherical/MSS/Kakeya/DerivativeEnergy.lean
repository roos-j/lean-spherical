theorem shiftedCharted_central_i0_E0_E1_source_bounds_of_critical_window
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex)
    {eps : Real} (heps : 0 < eps) (K n : Nat) (lo hi : Real) (xi : Euclidean 2)
    (hpolar : xi = ‖xi‖ • circleDirection (C.angle j xi)) (hn : n < 7)
    (Mcut Mphase : Real) (hMcut : 0 ≤ Mcut) (hMphase : 0 ≤ Mphase)
    (hcutBound : ∀ u ∈ Icc (-(1 / 2 : Real)) (1 / 2 : Real),
      |shiftedCentralParametricCutoffDerivativeProfile n (4 * eps, u)| ≤ Mcut)
    (hphaseBound : ∀ u ∈ Icc (-(1 / 2 : Real)) (1 / 2 : Real),
      |shiftedCentralParametricScaledPhaseProfile n (4 * eps, u)| ≤ Mphase)
    {rTime : Real} (hrTime : rTime < 1)
    (hsupport : ∀ l, Function.support (a l : Real → Complex) ⊆
      closedBall (3 / 2 : Real) rTime)
    (hxi : xi ≠ 0)
    (hlow : 1 ≤ ‖xi‖ * (4 * eps) ^ (2 : Nat))
    (hhigh : ‖xi‖ * (4 * eps) ^ (2 : Nat) ≤ 32) :
    shellFrequencyEnergy
      (shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n 0)
      lo hi xi ≤
      ((64 + 4 * Mcut ^ (2 : Nat) +
        800 * (2 * Real.pi) ^ (2 : Nat) * Mphase ^ (2 : Nat)) /
          (‖xi‖ * (4 * eps))) *
        shiftedFiberSourceEnergy s (chartProfiles C j q) a xi ∧
    shellFrequencyEnergy
      (shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n 0)
      lo hi xi ≤
      (64 + 4 * Mcut ^ (2 : Nat) +
        800 * (2 * Real.pi) ^ (2 : Nat) * Mphase ^ (2 : Nat)) *
        (‖xi‖ * (4 * eps)) * shiftedFiberSourceEnergy s (chartProfiles C j q) a xi := by
  let B1 : Real := 4 * Mcut ^ (2 : Nat) +
    800 * (2 * Real.pi) ^ (2 : Nat) * Mphase ^ (2 : Nat)
  let H : Real := shiftedFiberSourceEnergy s (chartProfiles C j q) a xi
  have hr : 0 < 4 * eps := by positivity
  have hnorm : 0 < ‖xi‖ := norm_pos_iff.mpr hxi
  have hden : 0 < ‖xi‖ * (4 * eps) := mul_pos hnorm hr
  have hH : 0 ≤ H := by
    dsimp only [H]
    exact shiftedFiberSourceEnergy_nonneg s (chartProfiles C j q) a xi
  have hB1 : 0 ≤ B1 := by
    dsimp only [B1]
    positivity
  have hE0 := shellFrequencyEnergy_shiftedCharted_central_le_source_of_critical_upper
    C j s q hqcompact a heps K n lo hi xi hpolar hn hrTime hsupport hxi hhigh
    (A := 32)
  have hE1 := shellFrequencyEnergy_shiftedCharted_central_deriv_le_source_of_critical_window
    C j s q hqcompact a heps K n lo hi xi hpolar hn
    Mcut Mphase hMcut hMphase hcutBound hphaseBound hrTime hsupport hxi hlow hhigh
  norm_num at hE0
  constructor
  · have hcoef : (64 : Real) / (‖xi‖ * (4 * eps)) ≤
        (64 + B1) / (‖xi‖ * (4 * eps)) := by
      apply (div_le_div_iff_of_pos_right hden).mpr
      linarith
    calc
      shellFrequencyEnergy
          (shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n 0)
          lo hi xi ≤ (64 / (‖xi‖ * (4 * eps))) * H := by
        simpa only [H] using hE0
      _ ≤ ((64 + B1) / (‖xi‖ * (4 * eps))) * H :=
        mul_le_mul_of_nonneg_right hcoef hH
      _ = ((64 + 4 * Mcut ^ (2 : Nat) +
        800 * (2 * Real.pi) ^ (2 : Nat) * Mphase ^ (2 : Nat)) /
          (‖xi‖ * (4 * eps))) *
          shiftedFiberSourceEnergy s (chartProfiles C j q) a xi := by
        dsimp only [B1, H]
        ring
  · calc
      shellFrequencyEnergy
          (shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n 0)
          lo hi xi ≤ B1 * (‖xi‖ * (4 * eps)) * H := by
        simpa only [B1, H] using hE1
      _ = (B1 * (‖xi‖ * (4 * eps))) * H := by ring
      _ ≤ ((64 + B1) * (‖xi‖ * (4 * eps))) * H := by
        apply mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_right (by linarith : B1 ≤ 64 + B1) hden.le) hH
      _ = (64 + B1) * (‖xi‖ * (4 * eps)) * H := by ring
      _ = (64 + 4 * Mcut ^ (2 : Nat) +
        800 * (2 * Real.pi) ^ (2 : Nat) * Mphase ^ (2 : Nat)) *
          (‖xi‖ * (4 * eps)) * shiftedFiberSourceEnergy s (chartProfiles C j q) a xi := by
        dsimp only [B1, H]
        ring

