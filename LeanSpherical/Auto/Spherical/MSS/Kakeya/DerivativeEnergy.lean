/-- Away from both normalized outer lobes, the literal dyadic raw angular
derivative vanishes.  This is the only off-coordinate fact needed to turn
the two local E1 normal forms into a global affine identity. -/
theorem shiftedChartedCappedTelescopingMultiplierDerivRaw_dyadic_eq_zero_off_lobes
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    {eps r : Real} (heps : 0 < eps) (K n k : Nat) (hk : k < K)
    (hr : r = (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps))
    (xi : Euclidean 2) (u : Real)
    (hu : u ∉ Icc (1 / 2 : Real) 2)
    (hnu : -u ∉ Icc (1 / 2 : Real) 2) :
    shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n (k + 1)
      (C.angle j xi + stationaryShift n + r * u) xi = 0 := by
  have hpos : shiftedDyadicPositiveProfile n (r, u) = 0 :=
    shiftedDyadicPositiveProfile_eq_zero_of_not_mem_Icc n r u hu
  have hposderiv : deriv (fun v : Real => shiftedDyadicPositiveProfile n (r, v)) u = 0 := by
    apply deriv_slice_eq_zero_of_not_mem_Icc (shiftedDyadicPositiveProfile n) r u
    · intro v hv
      exact shiftedDyadicPositiveProfile_eq_zero_of_not_mem_Icc n r v hv
    · exact hu
  have hneg : shiftedDyadicNegativeProfile n (r, u) = 0 := by
    calc
      shiftedDyadicNegativeProfile n (r, u) =
          shiftedDyadicReflectedNegativeProfile n (r, -u) := by
            simpa using (shiftedDyadicNegativeProfile_reflect n r (-u))
      _ = 0 := shiftedDyadicReflectedNegativeProfile_eq_zero_of_not_mem_Icc n r (-u) hnu
  have hnegderiv : deriv (fun v : Real => shiftedDyadicNegativeProfile n (r, v)) u = 0 :=
    deriv_shiftedDyadicNegativeProfile_eq_zero_of_neg_not_mem_Icc n r u hnu
  rw [shiftedChartedCappedTelescopingMultiplierDerivRaw_dyadic_global_lobe_split
    C j s q hqcompact a heps K n k hk hr u xi]
  rw [hpos, hposderiv, hneg, hnegderiv]
  simp

/-- Literal global four-analysis form of the dyadic angular derivative.
The two local signed phase identities are now a genuine equality on the
whole real angle line, not merely on a shell coordinate interval. -/
theorem shiftedChartedCappedTelescopingMultiplierDerivRaw_dyadic_eq_four_analysis
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    {eps r : Real} (heps : 0 < eps) (K n k : Nat) (hk : k < K)
    (hr : r = (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps))
    (xi : Euclidean 2)
    (hpolar : xi = ‖xi‖ • circleDirection (C.angle j xi))
    (hn : n < 7) :
    ∀ theta : Real,
      shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n (k + 1)
        theta xi =
        (shiftedDyadicE1CutoffPlus C j s q a n r xi
            ((theta - (C.angle j xi + stationaryShift n)) / r) +
          shiftedDyadicE1CutoffMinus C j s q a n r xi
            ((C.angle j xi + stationaryShift n - theta) / r)) +
        (shiftedDyadicE1PhasePlus C j s q a n r xi
            ((theta - (C.angle j xi + stationaryShift n)) / r) +
          shiftedDyadicE1PhaseMinus C j s q a n r xi
            ((C.angle j xi + stationaryShift n - theta) / r)) := by
  have hrne : r ≠ 0 := by
    rw [hr]
    positivity
  apply affine_four_lobes_global_eq
    (fun theta => shiftedChartedCappedTelescopingMultiplierDerivRaw
      C j s q hqcompact a eps K n (k + 1) theta xi)
    (shiftedDyadicE1CutoffPlus C j s q a n r xi)
    (shiftedDyadicE1CutoffMinus C j s q a n r xi)
    (shiftedDyadicE1PhasePlus C j s q a n r xi)
    (shiftedDyadicE1PhaseMinus C j s q a n r xi)
    r (C.angle j xi + stationaryShift n) hrne
  · exact shiftedDyadicE1CutoffPlus_eq_zero_of_not_mem_Icc C j s q a n r xi
  · exact shiftedDyadicE1CutoffMinus_eq_zero_of_not_mem_Icc C j s q a n r xi
  · exact shiftedDyadicE1PhasePlus_eq_zero_of_not_mem_Icc C j s q a n r xi
  · exact shiftedDyadicE1PhaseMinus_eq_zero_of_not_mem_Icc C j s q a n r xi
  · intro u hu
    simpa [shiftedDyadicE1CutoffPlus, shiftedDyadicE1PhasePlus] using
      (shiftedChartedCappedTelescopingMultiplierDerivRaw_dyadic_positive_E1
        C j s q hqcompact a heps K n k hk hr xi hpolar hn u hu)
  · intro u hu
    simpa [shiftedDyadicE1CutoffMinus, shiftedDyadicE1PhaseMinus] using
      (shiftedChartedCappedTelescopingMultiplierDerivRaw_dyadic_reflected_E1
        C j s q hqcompact a heps K n k hk hr xi hpolar hn u hu)
  · intro u hu hnu
    exact shiftedChartedCappedTelescopingMultiplierDerivRaw_dyadic_eq_zero_off_lobes
      C j s q hqcompact a heps K n k hk hr xi u hu hnu

/-- The literal dyadic raw derivative has the four affine TT* lobe energies
needed for E1.  This is already a fully concrete fixed-frequency bound; the
next purely algebraic step converts its four displayed integrals to the
two-lobe Schur budgets. -/
theorem shellFrequencyEnergy_shiftedCharted_dyadic_deriv_le_four_analysis
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    {eps r : Real} (heps : 0 < eps) (K n k : Nat) (hk : k < K)
    (lo hi : Real) (xi : Euclidean 2)
    (hpolar : xi = ‖xi‖ • circleDirection (C.angle j xi))
    (hn : n < 7)
    (hr : r = (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps))
    {rTime : Real} (hrTime : rTime < 1)
    (hsupport : ∀ l, Function.support (a l : Real -> Complex) ⊆
      closedBall (3 / 2 : Real) rTime) :
    shellFrequencyEnergy
      (shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n (k + 1))
      lo hi xi <=
      2 * (
        2 * (r * (∫ u : Real, ‖shiftedDyadicE1CutoffPlus C j s q a n r xi u‖ ^ (2 : Nat)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2))) +
          r * (∫ u : Real, ‖shiftedDyadicE1CutoffMinus C j s q a n r xi u‖ ^ (2 : Nat)
            ∂(volume.restrict (Icc (1 / 2 : Real) 2)))) +
        2 * (r * (∫ u : Real, ‖shiftedDyadicE1PhasePlus C j s q a n r xi u‖ ^ (2 : Nat)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2))) +
          r * (∫ u : Real, ‖shiftedDyadicE1PhaseMinus C j s q a n r xi u‖ ^ (2 : Nat)
            ∂(volume.restrict (Icc (1 / 2 : Real) 2))))) := by
  let H : Real -> Complex := scratch_finiteTensorTimeData s (chartProfiles C j q) a xi
  have hHcont : Continuous H := by
    dsimp [H]
    exact continuous_scratch_finiteTensorTimeData s (chartProfiles C j q) a xi
  have hHsupport : Function.support H ⊆ Ioc (1 / 2 : Real) (5 / 2 : Real) := by
    dsimp [H]
    exact (support_scratch_finiteTensorTimeData_subset_innerSlab
      s (chartProfiles C j q) a xi hsupport).trans
      (closedBall_innerSlab_subset_Ioc hrTime)
  let W : Real -> Complex := timeWeighted H
  have hWcont : Continuous W := by
    dsimp [W]
    unfold timeWeighted
    exact (Complex.continuous_ofReal.comp continuous_id).mul hHcont
  have hWsupport : Function.support W ⊆ Ioc (1 / 2 : Real) (5 / 2 : Real) := by
    intro t ht
    apply hHsupport
    by_contra hzero
    have hHt : H t = 0 := by
      by_contra hne
      exact hzero (Function.mem_support.mpr hne)
    exact ht (by simp [W, timeWeighted, hHt])
  have hcpcont : Continuous (shiftedDyadicE1CutoffPlus C j s q a n r xi) := by
    unfold shiftedDyadicE1CutoffPlus
    apply continuous_const.mul
    exact continuous_ttstarAnalysis_parametricProfile_of_compact_time_support
      (shiftedDyadicPositiveCutoffDerivativeProfile n)
      (contDiff_shiftedDyadicPositiveCutoffDerivativeProfile n).continuous
      r (stationaryRadialSign n * ‖xi‖) H hHcont (by norm_num) hHsupport
  have hcmcont : Continuous (shiftedDyadicE1CutoffMinus C j s q a n r xi) := by
    unfold shiftedDyadicE1CutoffMinus
    apply continuous_const.mul
    exact continuous_ttstarAnalysis_parametricProfile_of_compact_time_support
      (shiftedDyadicReflectedNegativeCutoffDerivativeProfile n)
      (contDiff_shiftedDyadicReflectedNegativeCutoffDerivativeProfile n).continuous
      r (stationaryRadialSign n * ‖xi‖) H hHcont (by norm_num) hHsupport
  have hppgcont : Continuous (shiftedDyadicPositiveScaledPhaseProfile n) := by
    simpa [HasJointSndSmooth] using
      (hasJointSndSmooth_shiftedDyadicPositiveScaledPhaseProfile n 0)
  have hpmgcont : Continuous (shiftedDyadicReflectedNegativeScaledPhaseProfile n) := by
    simpa [HasJointSndSmooth] using
      (hasJointSndSmooth_shiftedDyadicReflectedNegativeScaledPhaseProfile n 0)
  have hppcont : Continuous (shiftedDyadicE1PhasePlus C j s q a n r xi) := by
    unfold shiftedDyadicE1PhasePlus
    change Continuous (fun u : Real =>
      (-Complex.I) * (((2 * Real.pi) * (stationaryRadialSign n * ‖xi‖) * r : Real) : Complex) *
        ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
            (shiftedDyadicPositiveScaledPhaseProfile n) r
            (stationaryRadialSign n * ‖xi‖)) W u)
    let F : Real -> Complex := fun u => ttstarAnalysis volume
      (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
        (shiftedDyadicPositiveScaledPhaseProfile n) r
        (stationaryRadialSign n * ‖xi‖)) W u
    have hFcont : Continuous F := by
      dsimp [F]
      exact continuous_ttstarAnalysis_parametricProfile_of_compact_time_support
        (shiftedDyadicPositiveScaledPhaseProfile n) hppgcont
        r (stationaryRadialSign n * ‖xi‖) W hWcont (by norm_num) hWsupport
    have hscale : Continuous (fun u : Real =>
        (((2 * Real.pi) * (stationaryRadialSign n * ‖xi‖) * r : Real) : Complex) * F u) :=
      continuous_const.mul hFcont
    have hsign : Continuous (fun u : Real => (-Complex.I) *
        ((((2 * Real.pi) * (stationaryRadialSign n * ‖xi‖) * r : Real) : Complex) * F u)) :=
      continuous_const.mul hscale
    convert hsign using 1
    ext u
    dsimp [F]
