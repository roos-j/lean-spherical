section

section Auto.Spherical.MSS

open scoped BigOperators

/-- The cutoff-coordinate loss is absorbed at every genuinely outer scale:
when `1 ≤ ell*r²`, `r⁻²/(ell*r)` is at most the target direct scale
`ell*r`. -/
theorem inv_sq_div_outer_scale_le_direct
    {ell r : Real} (hell : 0 < ell) (hr : 0 < r)
    (houter : 1 ≤ ell * r ^ 2) :
    (r ^ 2)⁻¹ / (ell * r) ≤ ell * r := by
  have hr2 : 0 < r ^ 2 := sq_pos_of_pos hr
  have hden : 0 < ell * r := mul_pos hell hr
  have hsquare : 1 ≤ (ell * r ^ 2) ^ 2 := by
    nlinarith [sq_nonneg (ell * r ^ 2 - 1)]
  field_simp [ne_of_gt hell, ne_of_gt hr]
  nlinarith

/-- The exact positive algebra needed after the two-lobe cutoff/phase
Schur budgets.  The four outer Cauchy factors have been retained explicitly
so callers can rewrite their literal E1 calculation without concealing a
shell-scale assumption. -/
theorem outer_E1_two_budget_le_direct_scale
    {ell r Bcut Bphase H : Real}
    (hell : 0 < ell) (hr : 0 < r)
    (houter : 1 ≤ ell * r ^ 2)
    (hcut : 0 ≤ Bcut) (hH : 0 ≤ H) :
    2 *
        (2 * (r ^ 2)⁻¹ * ((Bcut / (ell * r)) * H) +
          2 * (((2 * Real.pi) * ell * r) ^ 2) *
            ((Bphase / (ell * r)) * H)) ≤
      (4 * Bcut + 4 * (2 * Real.pi) ^ 2 * Bphase) * (ell * r) * H := by
  have hbase := inv_sq_div_outer_scale_le_direct hell hr houter
  have hcutbase :
      (r ^ 2)⁻¹ * ((Bcut / (ell * r)) * H) ≤
        Bcut * (ell * r) * H := by
    calc
      (r ^ 2)⁻¹ * ((Bcut / (ell * r)) * H) =
          Bcut * (((r ^ 2)⁻¹ / (ell * r)) * H) := by ring
      _ ≤ Bcut * ((ell * r) * H) := by gcongr
      _ = Bcut * (ell * r) * H := by ring
  have hphasebase :
      (((2 * Real.pi) * ell * r) ^ 2) * ((Bphase / (ell * r)) * H) =
        (2 * Real.pi) ^ 2 * Bphase * (ell * r) * H := by
    field_simp [ne_of_gt hell, ne_of_gt hr]
  nlinarith [hcutbase, hphasebase]

end Auto.Spherical.MSS
end
-- END ScratchKakeyaOuterE1ScaleAlgebra

