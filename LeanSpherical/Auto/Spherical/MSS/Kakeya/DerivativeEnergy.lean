        ‖(Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex)‖ =
          (1 : Real) := by
      rw [Real.fourierChar_apply]
      exact Complex.norm_exp_ofReal_mul_I _
    unfold fixedCentralCircleUnitShellAmplitude
    have hsq : (fixedCentralCircleUnitShellBump u : Real) *
        (fixedCentralCircleUnitShellBump u : Real) ≤ 1 := by
      nlinarith
    have hnorm : ‖((fixedCentralCircleUnitShellBump u : Real) : Complex)‖ =
        (fixedCentralCircleUnitShellBump u : Real) := by
      rw [Complex.norm_real, Real.norm_of_nonneg hnonneg]
    calc
      ‖((fixedCentralCircleUnitShellBump u : Real) : Complex)‖ *
          ‖((fixedCentralCircleUnitShellBump u : Real) : Complex)‖ *
          ‖(Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex)‖ =
          (fixedCentralCircleUnitShellBump u : Real) *
            (fixedCentralCircleUnitShellBump u : Real) := by
              simp only [Complex.norm_real, Real.norm_of_nonneg hnonneg, hphaseNorm]
