/-- Direct dyadic physical hpiece estimate.  The fibre witness is selected
with its literal source-energy identity, so the output no longer contains an
abstract witness field. -/
theorem exists_shifted_dyadic_physical_hpiece_bound
    {rhoMax : Real} (hrhoMax : 0 <= rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) (n : Nat) :
    ∃ B : Real, 0 < B ∧
      ∀ {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
        (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
