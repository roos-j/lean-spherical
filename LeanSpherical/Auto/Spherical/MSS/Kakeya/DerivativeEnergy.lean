/-- Pure real algebra for the literal four-term angular derivative.  It
turns separate cutoff and time-weighted-phase pair budgets into the direct
outer scale `ell*r`; callers supply the actual TT* lobe estimates. -/
theorem outer_E1_from_two_pair_budgets
    {E cut phase r lambda ell H Bcutplus Bcutminus Bphaseplus Bphaseminus : Real}
    (hell : 0 < ell) (hr : 0 < r) (houter : 1 ≤ ell * r ^ 2)
    (hBcut : 0 ≤ Bcutplus + Bcutminus) (hH : 0 ≤ H)
    (habs : |lambda| = ell)
    (hbase : E ≤ 2 * (cut + phase))
    (hcut : cut ≤
      2 * ((r ^ 2)⁻¹ * (Bcutplus / (|lambda| * r)) * H +
        (r ^ 2)⁻¹ * (Bcutminus / (|lambda| * r)) * H))
    (hphase : phase ≤
      2 * ((((2 * Real.pi) * lambda * r) ^ 2) *
        (Bphaseplus / (|lambda| * r)) * H +
        (((2 * Real.pi) * lambda * r) ^ 2) *
        (Bphaseminus / (|lambda| * r)) * H)) :
    E ≤ (4 * (Bcutplus + Bcutminus) +
      4 * (2 * Real.pi) ^ 2 * (Bphaseplus + Bphaseminus)) *
        (ell * r) * H := by
  have hlamsq : lambda ^ 2 = ell ^ 2 := by
    calc
      lambda ^ 2 = |lambda| ^ 2 := (sq_abs lambda).symm
      _ = ell ^ 2 := by rw [habs]
  have hpair := add_le_add hcut hphase
  calc
    E ≤ 2 * (cut + phase) := hbase
    _ ≤ 2 *
        (2 * ((r ^ 2)⁻¹ * (Bcutplus / (|lambda| * r)) * H +
          (r ^ 2)⁻¹ * (Bcutminus / (|lambda| * r)) * H) +
        2 * ((((2 * Real.pi) * lambda * r) ^ 2) *
          (Bphaseplus / (|lambda| * r)) * H +
          (((2 * Real.pi) * lambda * r) ^ 2) *
          (Bphaseminus / (|lambda| * r)) * H)) :=
      mul_le_mul_of_nonneg_left hpair (by norm_num)
    _ = 2 * (2 * (r ^ 2)⁻¹ * (((Bcutplus + Bcutminus) / (ell * r)) * H) +
        2 * (((2 * Real.pi) * ell * r) ^ 2) *
          (((Bphaseplus + Bphaseminus) / (ell * r)) * H)) := by
      rw [habs]
      ring_nf
      rw [hlamsq]
      ring
    _ ≤ (4 * (Bcutplus + Bcutminus) +
        4 * (2 * Real.pi) ^ 2 * (Bphaseplus + Bphaseminus)) *
          (ell * r) * H :=
      outer_E1_two_budget_le_direct_scale hell hr houter hBcut hH

end Auto.Spherical.MSS
