/-- The unreflected dyadic negative lobe is locally zero whenever its
reflected coordinate lies outside the standard positive lobe interval. -/
theorem deriv_shiftedDyadicNegativeProfile_eq_zero_of_neg_not_mem_Icc
    (n : Nat) (rho u : Real) (hu : -u ∉ Icc (1 / 2 : Real) 2) :
    deriv (fun v : Real => shiftedDyadicNegativeProfile n (rho, v)) u = 0 := by
  by_cases hleft : -u < 1 / 2
  · have hu' : -(1 / 2 : Real) < u := by linarith
    have hlocal : (fun v : Real => shiftedDyadicNegativeProfile n (rho, v)) =ᶠ[nhds u]
        0 := by
      filter_upwards [Ioi_mem_nhds hu'] with v hv
      change -(1 / 2 : Real) < v at hv
      have hnot : -v ∉ Icc (1 / 2 : Real) 2 := by
        intro hmem
        linarith [hmem.1]
      calc
        shiftedDyadicNegativeProfile n (rho, v) =
            shiftedDyadicReflectedNegativeProfile n (rho, -v) := by
              simpa using (shiftedDyadicNegativeProfile_reflect n rho (-v))
        _ = 0 := shiftedDyadicReflectedNegativeProfile_eq_zero_of_not_mem_Icc
          n rho (-v) hnot
    simpa using hlocal.deriv.self_of_nhds
  · have hright : 2 < -u := by
      by_contra hnot
      apply hu
      exact ⟨le_of_not_gt hleft, le_of_not_gt hnot⟩
    have hu' : u < -2 := by linarith
    have hlocal : (fun v : Real => shiftedDyadicNegativeProfile n (rho, v)) =ᶠ[nhds u]
        0 := by
      filter_upwards [Iio_mem_nhds hu'] with v hv
      change v < -2 at hv
      have hnot : -v ∉ Icc (1 / 2 : Real) 2 := by
        intro hmem
        linarith [hmem.2]
      calc
        shiftedDyadicNegativeProfile n (rho, v) =
            shiftedDyadicReflectedNegativeProfile n (rho, -v) := by
              simpa using (shiftedDyadicNegativeProfile_reflect n rho (-v))
        _ = 0 := shiftedDyadicReflectedNegativeProfile_eq_zero_of_not_mem_Icc
          n rho (-v) hnot
    simpa using hlocal.deriv.self_of_nhds

/-- The same support transport for the capped terminal negative lobe. -/
theorem deriv_shiftedCappedTerminalNegativeProfile_eq_zero_of_neg_not_mem_Icc
    (n : Nat) (ratio rho u : Real) (hratio : ratio ∈ Icc (1 / 2 : Real) 1)
    (hu : -u ∉ Icc (1 / 2 : Real) 2) :
    deriv (fun v : Real => shiftedCappedTerminalNegativeProfile n ratio (rho, v)) u = 0 := by
  by_cases hleft : -u < 1 / 2
  · have hu' : -(1 / 2 : Real) < u := by linarith
    have hlocal : (fun v : Real => shiftedCappedTerminalNegativeProfile n ratio (rho, v)) =ᶠ[nhds u]
        0 := by
      filter_upwards [Ioi_mem_nhds hu'] with v hv
      change -(1 / 2 : Real) < v at hv
      have hnot : -v ∉ Icc (1 / 2 : Real) 2 := by
        intro hmem
        linarith [hmem.1]
      calc
        shiftedCappedTerminalNegativeProfile n ratio (rho, v) =
            shiftedCappedTerminalReflectedNegativeProfile n ratio (rho, -v) := by
              simpa using (shiftedCappedTerminalNegativeProfile_reflect n ratio rho (-v))
        _ = 0 := shiftedCappedTerminalReflectedNegativeProfile_eq_zero_of_not_mem_Icc
          n ratio rho (-v) hratio hnot
    simpa using hlocal.deriv.self_of_nhds
  · have hright : 2 < -u := by
      by_contra hnot
      apply hu
      exact ⟨le_of_not_gt hleft, le_of_not_gt hnot⟩
    have hu' : u < -2 := by linarith
    have hlocal : (fun v : Real => shiftedCappedTerminalNegativeProfile n ratio (rho, v)) =ᶠ[nhds u]
        0 := by
      filter_upwards [Iio_mem_nhds hu'] with v hv
      change v < -2 at hv
      have hnot : -v ∉ Icc (1 / 2 : Real) 2 := by
        intro hmem
        linarith [hmem.2]
      calc
        shiftedCappedTerminalNegativeProfile n ratio (rho, v) =
            shiftedCappedTerminalReflectedNegativeProfile n ratio (rho, -v) := by
              simpa using (shiftedCappedTerminalNegativeProfile_reflect n ratio rho (-v))
        _ = 0 := shiftedCappedTerminalReflectedNegativeProfile_eq_zero_of_not_mem_Icc
          n ratio rho (-v) hratio hnot
    simpa using hlocal.deriv.self_of_nhds

end

