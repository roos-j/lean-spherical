set_option maxHeartbeats 1200000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- Simultaneous `i = 0` E0/E1 endpoint in precisely the form consumed by
`ConcreteAnnularWitness`.  It uses a single explicit constant and only the
