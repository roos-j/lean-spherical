/-- A fixed central cutoff, supported strictly inside the rescaled central
interval.  It is local to this scratch development to keep the central
factorization independently importable. -/
noncomputable def fixedCentralCircleUnitShellBump : ContDiffBump (0 : Real) :=
  ⟨(1 : Real) / 4, (3 : Real) / 8, by norm_num, by norm_num⟩

noncomputable def fixedCentralCircleUnitShellAmplitude (u : Real) : Complex :=
  (fixedCentralCircleUnitShellBump u : Real)

/-- The central-shell Fourier-character analysis amplitude.  The angular
coordinate is measured relative to the stationary direction. -/
noncomputable def centralCircleFourierCharAnalysisAmplitude
    (rho lambda u t : Real) : Complex :=
  fixedCentralCircleUnitShellAmplitude u *
    (Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex)

/-- The central shell product kernel after the angular change of variables.
The factor `rho` is the Jacobian `d theta = rho du`. -/
noncomputable def centralCircleFourierCharProductKernel
    (rho lambda t s : Real) : Complex :=
  (rho : Complex) * ∫ u in (-(1 / 2 : Real))..(1 / 2 : Real),
    (fixedCentralCircleUnitShellAmplitude u *
      starRingEnd Complex (fixedCentralCircleUnitShellAmplitude u)) *
      (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex)

theorem centralCircleFourierCharAnalysisAmplitude_ttstar_integrand
    (rho lambda u t s : Real) :
    centralCircleFourierCharAnalysisAmplitude rho lambda u t *
        starRingEnd Complex (centralCircleFourierCharAnalysisAmplitude rho lambda u s) =
      (fixedCentralCircleUnitShellAmplitude u *
        starRingEnd Complex (fixedCentralCircleUnitShellAmplitude u)) *
        (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex) := by
  unfold centralCircleFourierCharAnalysisAmplitude
  change
    (fixedCentralCircleUnitShellAmplitude u *
      (Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex)) *
        star (fixedCentralCircleUnitShellAmplitude u *
          (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex)) = _
  rw [star_mul]
  have hphase :
      (Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex) *
          starRingEnd Complex
            (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex) =
        (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex) := by
    simp only [Real.fourierChar_apply]
    rw [← Complex.exp_conj]
    simp only [map_mul, Complex.conj_ofReal, Complex.conj_I]
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  calc
    (fixedCentralCircleUnitShellAmplitude u *
        (Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex)) *
        (starRingEnd Complex
          (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex) *
            starRingEnd Complex (fixedCentralCircleUnitShellAmplitude u)) =
        (fixedCentralCircleUnitShellAmplitude u *
          starRingEnd Complex (fixedCentralCircleUnitShellAmplitude u)) *
          ((Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex) *
            starRingEnd Complex
              (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex)) := by
      ring
    _ = _ := by rw [hphase]

private theorem central_interval_integral_star (f : Real → Complex) :
    star (∫ u in (-(1 / 2 : Real))..(1 / 2 : Real), f u) =
      ∫ u in (-(1 / 2 : Real))..(1 / 2 : Real), star (f u) := by
  rw [intervalIntegral.integral_of_le (by norm_num : (-(1 / 2 : Real)) ≤ 1 / 2)]
  rw [intervalIntegral.integral_of_le (by norm_num : (-(1 / 2 : Real)) ≤ 1 / 2)]
  change starRingEnd Complex (∫ u in Ioc (-(1 / 2 : Real)) (1 / 2 : Real), f u) =
    ∫ u in Ioc (-(1 / 2 : Real)) (1 / 2 : Real), starRingEnd Complex (f u)
  exact integral_conj.symm

private theorem centralCircleFourierCharProduct_integrand_swap
    (rho lambda t s u : Real) :
    (fixedCentralCircleUnitShellAmplitude u *
      starRingEnd Complex (fixedCentralCircleUnitShellAmplitude u)) *
      (Real.fourierChar (-(s - t) * lambda * Real.cos (rho * u)) : Complex) =
      star ((fixedCentralCircleUnitShellAmplitude u *
        starRingEnd Complex (fixedCentralCircleUnitShellAmplitude u)) *
        (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex)) := by
  rw [← centralCircleFourierCharAnalysisAmplitude_ttstar_integrand rho lambda u s t]
  rw [← centralCircleFourierCharAnalysisAmplitude_ttstar_integrand rho lambda u t s]
  change
    centralCircleFourierCharAnalysisAmplitude rho lambda u s *
      star (centralCircleFourierCharAnalysisAmplitude rho lambda u t) =
    star (centralCircleFourierCharAnalysisAmplitude rho lambda u t *
      star (centralCircleFourierCharAnalysisAmplitude rho lambda u s))
  rw [star_mul, star_star]

/-- Hermitian symmetry of the central product kernel. -/
theorem centralCircleFourierCharProductKernel_swap_eq_star
    (rho lambda t s : Real) :
    centralCircleFourierCharProductKernel rho lambda s t =
      starRingEnd Complex (centralCircleFourierCharProductKernel rho lambda t s) := by
  unfold centralCircleFourierCharProductKernel
  change
    (rho : Complex) *
      (∫ u in (-(1 / 2 : Real))..(1 / 2 : Real),
        (fixedCentralCircleUnitShellAmplitude u *
          starRingEnd Complex (fixedCentralCircleUnitShellAmplitude u)) *
          (Real.fourierChar (-(s - t) * lambda * Real.cos (rho * u)) : Complex)) =
    star ((rho : Complex) *
      (∫ u in (-(1 / 2 : Real))..(1 / 2 : Real),
        (fixedCentralCircleUnitShellAmplitude u *
          starRingEnd Complex (fixedCentralCircleUnitShellAmplitude u)) *
          (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex)))
  have hrho : star (rho : Complex) = (rho : Complex) := Complex.conj_ofReal rho
  calc
    (rho : Complex) *
        (∫ u in (-(1 / 2 : Real))..(1 / 2 : Real),
          (fixedCentralCircleUnitShellAmplitude u *
            starRingEnd Complex (fixedCentralCircleUnitShellAmplitude u)) *
            (Real.fourierChar (-(s - t) * lambda * Real.cos (rho * u)) : Complex)) =
        (rho : Complex) *
          (∫ u in (-(1 / 2 : Real))..(1 / 2 : Real), star
            ((fixedCentralCircleUnitShellAmplitude u *
              starRingEnd Complex (fixedCentralCircleUnitShellAmplitude u)) *
              (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex))) := by
          congr 1
          apply intervalIntegral.integral_congr
          intro u hu
          exact centralCircleFourierCharProduct_integrand_swap rho lambda t s u
    _ = star ((rho : Complex) *
      (∫ u in (-(1 / 2 : Real))..(1 / 2 : Real),
        (fixedCentralCircleUnitShellAmplitude u *
          starRingEnd Complex (fixedCentralCircleUnitShellAmplitude u)) *
          (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex))) := by
          rw [star_mul, hrho, central_interval_integral_star]
          ring

theorem norm_centralCircleFourierCharProductKernel_symm
    (rho lambda t s : Real) :
    ‖centralCircleFourierCharProductKernel rho lambda t s‖ =
      ‖centralCircleFourierCharProductKernel rho lambda s t‖ := by
  rw [centralCircleFourierCharProductKernel_swap_eq_star]
  exact norm_star _

/-- The central product kernel has the elementary width bound.  This is the
central analogue of the outer-shell oscillatory estimate: no integration by
parts is needed because the critical window has width `rho`. -/
theorem norm_centralCircleFourierCharProductKernel_le
    {rho : Real} (hrho : 0 ≤ rho) (lambda t s : Real) :
    ‖centralCircleFourierCharProductKernel rho lambda t s‖ ≤ rho := by
  unfold centralCircleFourierCharProductKernel
  rw [norm_mul]
  have hrhoC : ‖(rho : Complex)‖ = rho := by
    simp [Real.norm_eq_abs, abs_of_nonneg hrho]
  rw [hrhoC]
  have hbound : ∀ u ∈ uIoc (-(1 / 2 : Real)) (1 / 2 : Real),
      ‖(fixedCentralCircleUnitShellAmplitude u *
        starRingEnd Complex (fixedCentralCircleUnitShellAmplitude u)) *
        (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex)‖ ≤
        (1 : Real) := by
    intro u hu
    rw [norm_mul, norm_mul]
    change
      ‖fixedCentralCircleUnitShellAmplitude u‖ *
          ‖star (fixedCentralCircleUnitShellAmplitude u)‖ *
          ‖(Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex)‖ ≤
        (1 : Real)
