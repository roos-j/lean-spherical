    (shiftedTerminalE1CutoffPlus C j s q a n ratio r xi)
    (shiftedTerminalE1CutoffMinus C j s q a n ratio r xi)
    (shiftedTerminalE1PhasePlus C j s q a n ratio r xi)
    (shiftedTerminalE1PhaseMinus C j s q a n ratio r xi)
