    have hnonneg : 0 ≤ smoothCentralShellCutoff (Real.pi / 2)
        (v + stationaryShift n - stationaryShift m) := by
      unfold smoothCentralShellCutoff
      exact smoothCentralShellBump.nonneg
    have hle : smoothCentralShellCutoff (Real.pi / 2)
        (v + stationaryShift n - stationaryShift m) ≤ 1 := by
      unfold smoothCentralShellCutoff
      exact smoothCentralShellBump.le_one
    constructor <;> linarith
  constructor
  · apply Finset.prod_nonneg
    intro m hm
    exact (hfactor m hm).1
  · apply Finset.prod_le_one₀
    · intro m hm
      exact (hfactor m hm).1
    · intro m hm
      exact (hfactor m hm).2

theorem shiftedCentralParametricProfile_nonneg_le_one
    (n : Nat) (rho u : Real) :
    0 ≤ shiftedCentralParametricProfile n (rho, u) ∧
      shiftedCentralParametricProfile n (rho, u) ≤ 1 := by
  unfold shiftedCentralParametricProfile
  have hpre := shiftedStationaryPreweightProfile_nonneg_le_one n (rho * u)
  have hbnonneg : 0 ≤ (fixedCentralCircleUnitShellBump u : Real) :=
    fixedCentralCircleUnitShellBump.nonneg
  have hble : (fixedCentralCircleUnitShellBump u : Real) ≤ 1 :=
    fixedCentralCircleUnitShellBump.le_one
  constructor
  · exact mul_nonneg hpre.1 hbnonneg
  · exact mul_le_one₀ hpre.2 hbnonneg hble

theorem abs_shiftedCentralParametricProfile_le_one
    (n : Nat) (rho u : Real) :
    |shiftedCentralParametricProfile n (rho, u)| ≤ 1 := by
  rw [abs_of_nonneg (shiftedCentralParametricProfile_nonneg_le_one n rho u).1]
  exact (shiftedCentralParametricProfile_nonneg_le_one n rho u).2

/-- The normalized cutoff-coordinate derivative of the central profile. -/
noncomputable def shiftedCentralParametricCutoffDerivativeProfile
    (n : Nat) : Real × Real → Real :=
  partialDerivSnd (shiftedCentralParametricProfile n)

theorem contDiff_shiftedCentralParametricCutoffDerivativeProfile (n : Nat) :
    ContDiff Real (⊤ : ℕ∞) (shiftedCentralParametricCutoffDerivativeProfile n) := by
  unfold shiftedCentralParametricCutoffDerivativeProfile
  exact contDiff_partialDerivSnd _ (contDiff_shiftedCentralParametricProfile n)

theorem deriv_slice_shiftedCentralParametricProfile_eq_cutoffDerivative
    (n : Nat) (rho u : Real) :
    deriv (fun v : Real => shiftedCentralParametricProfile n (rho, v)) u =
      shiftedCentralParametricCutoffDerivativeProfile n (rho, u) := by
  unfold shiftedCentralParametricCutoffDerivativeProfile
  exact deriv_slice_eq_partialDerivSnd _
    ((contDiff_shiftedCentralParametricProfile n).differentiable (by simp)) rho u

/-- Differentiating the normalized central profile preserves its compact
central-coordinate support. -/
theorem shiftedCentralParametricCutoffDerivativeProfile_eq_zero_of_not_mem_Icc
    (n : Nat) (rho u : Real) (hu : u ∉ Icc (-(1 / 2 : Real)) (1 / 2 : Real)) :
    shiftedCentralParametricCutoffDerivativeProfile n (rho, u) = 0 := by
  rw [← deriv_slice_shiftedCentralParametricProfile_eq_cutoffDerivative]
  by_cases hleft : u < -(1 / 2 : Real)
  · have hlocal : (fun v : Real => shiftedCentralParametricProfile n (rho, v)) =ᶠ[nhds u] 0 := by
      filter_upwards [Iio_mem_nhds hleft] with v hv
      exact shiftedCentralParametricProfile_eq_zero_of_not_mem_Icc n rho v (by
        intro hmem
        exact (not_le_of_gt hv) hmem.1)
    simpa using hlocal.deriv.self_of_nhds
  · have hright : (1 / 2 : Real) < u := by
      by_contra hnot
      apply hu
      constructor
      · exact le_of_not_gt hleft
      · exact le_of_not_gt hnot
    have hlocal : (fun v : Real => shiftedCentralParametricProfile n (rho, v)) =ᶠ[nhds u] 0 := by
      filter_upwards [Ioi_mem_nhds hright] with v hv
      exact shiftedCentralParametricProfile_eq_zero_of_not_mem_Icc n rho v (by
        intro hmem
        exact (not_le_of_gt hv) hmem.2)
    simpa using hlocal.deriv.self_of_nhds

/-- The normalized removable-sinc phase profile for the central member. -/
noncomputable def shiftedCentralParametricScaledPhaseProfile
    (n : Nat) : Real × Real → Real :=
  fun p => shiftedCentralParametricProfile n p * outerCircleScaledDerivative p.1 p.2

theorem continuous_shiftedCentralParametricScaledPhaseProfile (n : Nat) :
    Continuous (shiftedCentralParametricScaledPhaseProfile n) := by
  unfold shiftedCentralParametricScaledPhaseProfile
  exact (contDiff_shiftedCentralParametricProfile n).continuous.mul
    continuous_outerCircleScaledDerivative_joint

/-- The scaled phase component has the same exact central support. -/
theorem shiftedCentralParametricScaledPhaseProfile_eq_zero_of_not_mem_Icc
    (n : Nat) (rho u : Real) (hu : u ∉ Icc (-(1 / 2 : Real)) (1 / 2 : Real)) :
    shiftedCentralParametricScaledPhaseProfile n (rho, u) = 0 := by
  unfold shiftedCentralParametricScaledPhaseProfile
  rw [shiftedCentralParametricProfile_eq_zero_of_not_mem_Icc n rho u hu]
  ring

/-- Compactness provides a uniform literal bound for the central cutoff
derivative over every prescribed bounded carrier range. -/
theorem exists_uniform_abs_bound_shiftedCentralCutoffDerivative
    (n : Nat) {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax) :
    ∃ M : Real, 0 < M ∧
      ∀ rho ∈ Icc (0 : Real) rhoMax, ∀ u ∈ Icc (-(1 / 2 : Real)) (1 / 2 : Real),
        |shiftedCentralParametricCutoffDerivativeProfile n (rho, u)| ≤ M := by
  rcases exists_uniform_norm_bound_of_jointContinuous
      (a := (-(1 / 2 : Real))) (b := (1 / 2 : Real)) hrhoMax (by norm_num)
      (fun rho u => (shiftedCentralParametricCutoffDerivativeProfile n (rho, u) : Complex))
      (Complex.continuous_ofReal.comp
        (contDiff_shiftedCentralParametricCutoffDerivativeProfile n).continuous)
      with ⟨M, hM, hbound⟩
  refine ⟨M, hM, ?_⟩
  intro rho hrho u hu
  simpa only [Complex.norm_real, Real.norm_eq_abs] using hbound rho hrho u hu

/-- The phase profile has the same uniform compact-coordinate bound. -/
theorem exists_uniform_abs_bound_shiftedCentralScaledPhase
    (n : Nat) {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax) :
    ∃ M : Real, 0 < M ∧
      ∀ rho ∈ Icc (0 : Real) rhoMax, ∀ u ∈ Icc (-(1 / 2 : Real)) (1 / 2 : Real),
        |shiftedCentralParametricScaledPhaseProfile n (rho, u)| ≤ M := by
  rcases exists_uniform_norm_bound_of_jointContinuous
      (a := (-(1 / 2 : Real))) (b := (1 / 2 : Real)) hrhoMax (by norm_num)
      (fun rho u => (shiftedCentralParametricScaledPhaseProfile n (rho, u) : Complex))
      (Complex.continuous_ofReal.comp
        (continuous_shiftedCentralParametricScaledPhaseProfile n))
      with ⟨M, hM, hbound⟩
  refine ⟨M, hM, ?_⟩
  intro rho hrho u hu
  simpa only [Complex.norm_real, Real.norm_eq_abs] using hbound rho hrho u hu

/-- The literal shifted capped central member becomes the displayed
parametric profile under `v = 4*eps*u`. -/
theorem shiftedCappedTelescopingCutoffProfile_central_rescaled_eq
    {eps : Real} (heps : eps ≠ 0) (K n : Nat) (u : Real) :
    shiftedCappedTelescopingCutoffProfile eps K n 0
      (stationaryShift n + (4 * eps) * u) =
      shiftedCentralParametricProfile n (4 * eps, u) := by
  unfold shiftedCappedTelescopingCutoffProfile shiftedCentralParametricProfile
  rw [show stationaryShift n + (4 * eps) * u - stationaryShift n = 4 * eps * u by ring]
  rw [cappedTelescopingCutoff_eq_dyadic eps (Real.pi / 2) K 0 (by omega)]
  simp only [telescopingShellCutoff_zero, telescopingCentralCutoff_zero]
  rw [smoothCentralShellCutoff_rescaled_eq_fixedCentralBump heps]

/-- The same rescaling identity directly in the original charted cutoff
notation. -/
theorem shiftedCappedTelescopingCutoff_central_rescaled_eq
    {eps : Real} (heps : eps ≠ 0) (K n : Nat) (alpha u : Real) :
    shiftedCappedTelescopingCutoff eps K n 0 alpha
      (alpha + stationaryShift n + (4 * eps) * u) =
      shiftedCentralParametricProfile n (4 * eps, u) := by
  rw [shiftedCappedTelescopingCutoff_eq_profile]
  have harg : alpha + stationaryShift n + (4 * eps) * u - alpha =
      stationaryShift n + (4 * eps) * u := by ring
  rw [harg]
  exact shiftedCappedTelescopingCutoffProfile_central_rescaled_eq heps K n u

/-- The literal positive-side multiplier has the central parametric
analysis form.  This is valid on the whole central coordinate interval,
not only at the outer-shell endpoints. -/
theorem shiftedCharted_centralMultiplier_eq_parametricAnalysis
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex)
    {eps : Real} (heps : eps ≠ 0) (K n : Nat) (xi : Euclidean 2)
    (hpolar : xi = ‖xi‖ • circleDirection (C.angle j xi))
    (hn : n < 7) (u : Real) :
    shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n 0
      (C.angle j xi + stationaryShift n + (4 * eps) * u) xi =
      ttstarAnalysis volume
        (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
          (shiftedCentralParametricProfile n) (4 * eps)
          (stationaryRadialSign n * ‖xi‖))
        (scratch_finiteTensorTimeData s (chartProfiles C j q) a xi) u := by
  unfold shiftedChartedCappedTelescopingMultiplier
  rw [shiftedCappedTelescopingCutoff_central_rescaled_eq heps]
  exact shiftedCharted_lobeMultiplier_eq_parametricAnalysis
    C j s q hqcompact a xi (C.angle j xi) hpolar n hn
      (shiftedCentralParametricProfile n) (4 * eps) u

/-- The compact central coordinate measure. -/
abbrev centralParametricAngleMeasure : Measure Real :=
  volume.restrict (Icc (-(1 / 2 : Real)) (1 / 2 : Real))

/-- The literal product-time kernel for an arbitrary real central profile.
It differs from the outer profile kernel only in its stationary coordinate
interval. -/
noncomputable def centralParametricProductTimeKernel
    (g : Real × Real → Real) (rho lambda t s : Real) : Complex :=
  (rho : Complex) * ∫ u in (-(1 / 2 : Real))..(1 / 2 : Real),
    outerCircleParametricRealProfileProductAmplitude g (rho, u) *
      (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex)

theorem centralParametricAnalysis_ttstarKernel_eq
    (g : Real × Real → Real) (rho lambda t s : Real) :
    (rho : Complex) *
      ttstarKernel centralParametricAngleMeasure
        (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) t s =
      centralParametricProductTimeKernel g rho lambda t s := by
  unfold centralParametricAngleMeasure centralParametricProductTimeKernel ttstarKernel
  rw [integral_Icc_eq_integral_Ioc]
  rw [intervalIntegral.integral_of_le (by norm_num : (-(1 / 2 : Real)) ≤ 1 / 2)]
  congr 1
  apply integral_congr_ae
  filter_upwards with u
  exact outerCircleParametricRealProfileFourierCharAnalysisAmplitude_ttstar_integrand
    g rho lambda u t s

private theorem centralParametric_intervalIntegral_star (f : Real → Complex) :
    star (∫ u in (-(1 / 2 : Real))..(1 / 2 : Real), f u) =
      ∫ u in (-(1 / 2 : Real))..(1 / 2 : Real), star (f u) := by
  rw [intervalIntegral.integral_of_le (by norm_num : (-(1 / 2 : Real)) ≤ 1 / 2)]
  rw [intervalIntegral.integral_of_le (by norm_num : (-(1 / 2 : Real)) ≤ 1 / 2)]
  exact integral_conj.symm

private theorem centralParametricProduct_integrand_swap
    (g : Real × Real → Real) (rho lambda t s u : Real) :
    outerCircleParametricRealProfileProductAmplitude g (rho, u) *
        (Real.fourierChar (-(s - t) * lambda * Real.cos (rho * u)) : Complex) =
      star (outerCircleParametricRealProfileProductAmplitude g (rho, u) *
        (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex)) := by
  rw [← outerCircleParametricRealProfileFourierCharAnalysisAmplitude_ttstar_integrand
    g rho lambda u s t]
  rw [← outerCircleParametricRealProfileFourierCharAnalysisAmplitude_ttstar_integrand
    g rho lambda u t s]
  change
    outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u s *
      star (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u t) =
      star (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u t *
        star (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u s))
  rw [star_mul, star_star]

theorem centralParametricProductTimeKernel_swap_eq_star
    (g : Real × Real → Real) (rho lambda t s : Real) :
    centralParametricProductTimeKernel g rho lambda s t =
      starRingEnd Complex (centralParametricProductTimeKernel g rho lambda t s) := by
  unfold centralParametricProductTimeKernel
  have hrho : star (rho : Complex) = (rho : Complex) := Complex.conj_ofReal rho
  calc
    (rho : Complex) * ∫ u in (-(1 / 2 : Real))..(1 / 2 : Real),
        outerCircleParametricRealProfileProductAmplitude g (rho, u) *
          (Real.fourierChar (-(s - t) * lambda * Real.cos (rho * u)) : Complex) =
      (rho : Complex) * ∫ u in (-(1 / 2 : Real))..(1 / 2 : Real), star
        (outerCircleParametricRealProfileProductAmplitude g (rho, u) *
          (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex)) := by
        congr 1
        apply intervalIntegral.integral_congr
        intro u hu
        exact centralParametricProduct_integrand_swap g rho lambda t s u
    _ = star ((rho : Complex) * ∫ u in (-(1 / 2 : Real))..(1 / 2 : Real),
        outerCircleParametricRealProfileProductAmplitude g (rho, u) *
          (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex)) := by
        rw [star_mul, hrho, centralParametric_intervalIntegral_star]
        ring

theorem norm_centralParametricProductTimeKernel_symm
    (g : Real × Real → Real) (rho lambda t s : Real) :
    ‖centralParametricProductTimeKernel g rho lambda t s‖ =
      ‖centralParametricProductTimeKernel g rho lambda s t‖ := by
  rw [centralParametricProductTimeKernel_swap_eq_star]
  exact norm_star _

/-- Joint continuity of the central product kernel, the compact-time
regularity input for the local symmetric Schur estimate. -/
theorem continuous_centralParametricProductTimeKernel
    (g : Real × Real → Real) (hg : Continuous g) (rho lambda : Real) :
    Continuous (Function.uncurry
      (centralParametricProductTimeKernel g rho lambda)) := by
  let f : (Real × Real) → Real → Complex := fun p u =>
    outerCircleParametricRealProfileProductAmplitude g (rho, u) *
      (Real.fourierChar (-(p.1 - p.2) * lambda * Real.cos (rho * u)) : Complex)
  have hamp : Continuous (fun u : Real =>
      outerCircleParametricRealProfileProductAmplitude g (rho, u)) := by
    unfold outerCircleParametricRealProfileProductAmplitude
    exact Complex.continuous_ofReal.comp
      ((hg.comp (continuous_const.prodMk continuous_id)).pow 2)
  have hf : Continuous (Function.uncurry f) := by
    dsimp [f]
    apply (hamp.comp continuous_snd).mul
    fun_prop
  have hparam : Continuous (fun p : Real × Real =>
      ∫ u in Icc (-(1 / 2 : Real)) (1 / 2 : Real), f p u) :=
    continuous_parametric_integral_of_continuous (μ := volume) hf isCompact_Icc
  have heq : (fun p : Real × Real =>
      ∫ u in (-(1 / 2 : Real))..(1 / 2 : Real), f p u) =
      fun p : Real × Real =>
        ∫ u in Icc (-(1 / 2 : Real)) (1 / 2 : Real), f p u := by
    funext p
    rw [intervalIntegral.integral_of_le (by norm_num : (-(1 / 2 : Real)) ≤ 1 / 2),
      ← integral_Icc_eq_integral_Ioc]
  unfold centralParametricProductTimeKernel
  change Continuous (fun p : Real × Real => (rho : Complex) *
    ∫ u in (-(1 / 2 : Real))..(1 / 2 : Real), f p u)
  apply continuous_const.mul
  rw [heq]
  exact hparam

/-- A central profile bounded by `M` has a trivial compact angular kernel
bound.  Stationarity causes no loss here because the time interval will be
bounded before Schur is applied. -/
theorem norm_centralParametricProductTimeKernel_le
    {g : Real × Real → Real} {rho M : Real} (hrho : 0 ≤ rho) (hM : 0 ≤ M)
    (hbound : ∀ u ∈ Icc (-(1 / 2 : Real)) (1 / 2 : Real),
      |g (rho, u)| ≤ M)
    (lambda t s : Real) :
    ‖centralParametricProductTimeKernel g rho lambda t s‖ ≤ rho * M ^ 2 := by
  unfold centralParametricProductTimeKernel
  rw [norm_mul]
  have hrhoC : ‖(rho : Complex)‖ = rho := by
    simp [Real.norm_eq_abs, abs_of_nonneg hrho]
  rw [hrhoC]
  have hint : ‖∫ u in (-(1 / 2 : Real))..(1 / 2 : Real),
      outerCircleParametricRealProfileProductAmplitude g (rho, u) *
        (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex)‖ ≤ M ^ 2 := by
    have hpoint : ∀ u ∈ uIoc (-(1 / 2 : Real)) (1 / 2 : Real),
        ‖outerCircleParametricRealProfileProductAmplitude g (rho, u) *
          (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex)‖ ≤
          M ^ 2 := by
      intro u hu
      rw [norm_mul]
      have hphase : ‖(Real.fourierChar
          (-(t - s) * lambda * Real.cos (rho * u)) : Complex)‖ = 1 := by
        rw [Real.fourierChar_apply]
        exact Complex.norm_exp_ofReal_mul_I _
      rw [hphase, mul_one]
      have hu' : u ∈ Icc (-(1 / 2 : Real)) (1 / 2 : Real) := by
        rw [uIoc_of_le (by norm_num)] at hu
        exact ⟨hu.1.le, hu.2⟩
      have hgu := hbound u hu'
      unfold outerCircleParametricRealProfileProductAmplitude
      rw [Complex.norm_real, Real.norm_eq_abs, abs_pow]
      nlinarith [abs_nonneg (g (rho, u))]
    have hraw := intervalIntegral.norm_integral_le_of_norm_le_const hpoint
    norm_num at hraw ⊢
    exact hraw
  calc
    rho * ‖∫ u in (-(1 / 2 : Real))..(1 / 2 : Real),
        outerCircleParametricRealProfileProductAmplitude g (rho, u) *
          (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex)‖ ≤
        rho * M ^ 2 := mul_le_mul_of_nonneg_left hint hrho

theorem continuous_uncurry_centralParametricAnalysisAmplitude
    (g : Real × Real → Real) (hg : Continuous g) (rho lambda : Real) :
    Continuous (Function.uncurry
      (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)) := by
  unfold outerCircleParametricRealProfileFourierCharAnalysisAmplitude
  have hg' : Continuous (fun p : Real × Real => (g (rho, p.1) : Complex)) :=
    Complex.continuous_ofReal.comp
      (hg.comp (continuous_const.prodMk continuous_fst))
  have hp : Continuous (fun p : Real × Real =>
      (Real.fourierChar (-p.2 * lambda * Real.cos (rho * p.1)) : Complex)) := by
    have harg : Continuous (fun p : Real × Real =>
        -p.2 * lambda * Real.cos (rho * p.1)) := by fun_prop
    exact continuous_subtype_val.comp (Real.continuous_fourierChar.comp harg)
  exact hg'.mul hp

/-- Exact compact-time TT* factorization for a central profile. -/
theorem centralParametricAnalysis_ttstar_factorization_restrict_Icc
    (g : Real × Real → Real) (rho lambda t0 t1 : Real)
    (hg : Continuous g) (H : Real → Complex) (hH : Continuous H) :
    (rho : Complex) *
      ∫ u : Real,
        ttstarAnalysis (volume.restrict (Icc t0 t1))
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u *
          starRingEnd Complex
            (ttstarAnalysis (volume.restrict (Icc t0 t1))
              (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u)
        ∂centralParametricAngleMeasure =
      ∫ t : Real, ∫ s : Real,
        centralParametricProductTimeKernel g rho lambda t s * H t *
          starRingEnd Complex (H s)
        ∂(volume.restrict (Icc t0 t1)) ∂(volume.restrict (Icc t0 t1)) := by
  let A := outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda
  have hA : Continuous (Function.uncurry A) :=
    continuous_uncurry_centralParametricAnalysisAmplitude g hg rho lambda
  have hbase := ttstar_factorization_restrict_Icc_of_continuous
    (u0 := (-(1 / 2 : Real))) (u1 := (1 / 2 : Real)) (t0 := t0) (t1 := t1)
    A hA H hH
  calc
    (rho : Complex) * ∫ u : Real,
        ttstarAnalysis (volume.restrict (Icc t0 t1)) A H u *
          starRingEnd Complex
            (ttstarAnalysis (volume.restrict (Icc t0 t1)) A H u)
        ∂centralParametricAngleMeasure =
      (rho : Complex) * ∫ t : Real, ∫ s : Real,
        ttstarKernel centralParametricAngleMeasure A t s * H t *
          starRingEnd Complex (H s)
        ∂(volume.restrict (Icc t0 t1)) ∂(volume.restrict (Icc t0 t1)) := by
          simpa only [centralParametricAngleMeasure] using congrArg (fun z => (rho : Complex) * z)
              hbase
    _ = ∫ t : Real, ∫ s : Real,
        ((rho : Complex) * ttstarKernel centralParametricAngleMeasure A t s) * H t *
          starRingEnd Complex (H s)
        ∂(volume.restrict (Icc t0 t1)) ∂(volume.restrict (Icc t0 t1)) := by
          rw [← integral_const_mul]
          apply integral_congr_ae
          filter_upwards with t
          rw [← integral_const_mul]
          apply integral_congr_ae
          filter_upwards with s
          ring
    _ = ∫ t : Real, ∫ s : Real,
        centralParametricProductTimeKernel g rho lambda t s * H t *
          starRingEnd Complex (H s)
        ∂(volume.restrict (Icc t0 t1)) ∂(volume.restrict (Icc t0 t1)) := by
          apply integral_congr_ae
          filter_upwards with t
          apply integral_congr_ae
          filter_upwards with s
          exact congrArg (fun z : Complex => z * H t * starRingEnd Complex (H s))
            (centralParametricAnalysis_ttstarKernel_eq g rho lambda t s)

/-- The nonnegative fixed-frequency central angular energy. -/
noncomputable def centralParametricFiberEnergy
    (g : Real × Real → Real) (rho lambda : Real) (H : Real → Complex) : Real :=
  rho * ∫ u : Real,
    ‖ttstarAnalysis volume
      (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u‖ ^
        (2 : Nat) ∂centralParametricAngleMeasure

/-- A compact-time central Schur estimate.  The constants only see the
bounded profile and the fixed inner time slab; no nonstationary integration
by parts is used at the stationary centre. -/
theorem centralParametricFiberEnergy_le_of_bound
    {g : Real × Real → Real} {rho M lambda : Real}
    (hrho : 0 < rho) (hM : 0 ≤ M)
    (hg : Continuous g)
    (hbound : ∀ u ∈ Icc (-(1 / 2 : Real)) (1 / 2 : Real),
      |g (rho, u)| ≤ M)
    (H : Real → Complex) (hH : Continuous H)
    (hHsupport : Function.support H ⊆ Ioc (1 / 2 : Real) (5 / 2 : Real)) :
    centralParametricFiberEnergy g rho lambda H ≤
      (2 * rho * M ^ 2) * ∫ t : Real, ‖H t‖ ^ (2 : Nat) := by
  let A := outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda
  let μT : Measure Real := volume.restrict (Icc (1 / 2 : Real) (5 / 2 : Real))
  have hA : Continuous (Function.uncurry A) :=
    continuous_uncurry_centralParametricAnalysisAmplitude g hg rho lambda
  have hFrestrict : Integrable (fun u : Real =>
      ‖ttstarAnalysis μT A H u‖ ^ (2 : Nat)) centralParametricAngleMeasure := by
    exact integrable_norm_sq_ttstarAnalysis_restrict_Icc_of_continuous A hA H hH
  have hAnalysis (u : Real) :
      ttstarAnalysis μT A H u = ttstarAnalysis volume A H u :=
    ttstarAnalysis_restrict_Icc_eq_volume_of_support_subset_Ioc A H (by norm_num) hHsupport u
  have hF : Integrable (fun u : Real =>
      ‖ttstarAnalysis volume A H u‖ ^ (2 : Nat)) centralParametricAngleMeasure := by
    apply hFrestrict.congr
    filter_upwards with u
    rw [hAnalysis]
  have hreal := norm_real_smul_integral_mul_star_eq
    centralParametricAngleMeasure rho hrho.le
    (fun u : Real => ttstarAnalysis volume A H u) hF
  have hfactor :
      (rho : Complex) * ∫ u : Real,
        ttstarAnalysis volume A H u * starRingEnd Complex (ttstarAnalysis volume A H u)
        ∂centralParametricAngleMeasure =
      ∫ t : Real, ∫ s : Real,
        centralParametricProductTimeKernel g rho lambda t s * H t *
          starRingEnd Complex (H s) ∂μT ∂μT := by
    calc
      (rho : Complex) * ∫ u : Real,
          ttstarAnalysis volume A H u * starRingEnd Complex (ttstarAnalysis volume A H u)
          ∂centralParametricAngleMeasure =
        (rho : Complex) * ∫ u : Real,
          ttstarAnalysis μT A H u * starRingEnd Complex (ttstarAnalysis μT A H u)
          ∂centralParametricAngleMeasure := by
            congr 1
            apply integral_congr_ae
            filter_upwards with u
            rw [hAnalysis]
      _ = _ := by
        simpa only [A, μT] using
          centralParametricAnalysis_ttstar_factorization_restrict_Icc
            g rho lambda (1 / 2 : Real) (5 / 2 : Real) hg H hH
  have hKcont : Continuous (Function.uncurry
      (centralParametricProductTimeKernel g rho lambda)) :=
    continuous_centralParametricProductTimeKernel g hg rho lambda
  have hrowbound : ∀ t : Real,
      (∫ s : Real, ‖centralParametricProductTimeKernel g rho lambda t s‖ ∂μT) ≤
        2 * rho * M ^ 2 := by
    intro t
    have hrow : Integrable (fun s : Real =>
        ‖centralParametricProductTimeKernel g rho lambda t s‖) μT := by
      apply integrable_restrict_Icc_of_continuous
      exact (hKcont.comp (continuous_const.prodMk continuous_id)).norm
    have hconst : Integrable (fun _ : Real => rho * M ^ 2) μT :=
      integrable_const _
    calc
      (∫ s : Real, ‖centralParametricProductTimeKernel g rho lambda t s‖ ∂μT) ≤
        ∫ _ : Real, rho * M ^ 2 ∂μT :=
          integral_mono hrow hconst (fun s =>
            norm_centralParametricProductTimeKernel_le hrho.le hM hbound lambda t s)
      _ = 2 * rho * M ^ 2 := by
        norm_num [μT]
        ring
  have hschur := norm_integral_integral_restrict_Icc_le_of_symmetricSchur
    (a := (1 / 2 : Real)) (b := (5 / 2 : Real))
    (centralParametricProductTimeKernel g rho lambda)
    hKcont (norm_centralParametricProductTimeKernel_symm g rho lambda)
    hrowbound H hH
  unfold centralParametricFiberEnergy
  calc
    rho * ∫ u : Real, ‖ttstarAnalysis volume A H u‖ ^ (2 : Nat)
        ∂centralParametricAngleMeasure =
      ‖(rho : Complex) * ∫ u : Real,
        ttstarAnalysis volume A H u * starRingEnd Complex (ttstarAnalysis volume A H u)
        ∂centralParametricAngleMeasure‖ := hreal.symm
    _ = ‖∫ t : Real, ∫ s : Real,
        centralParametricProductTimeKernel g rho lambda t s * H t *
          starRingEnd Complex (H s) ∂μT ∂μT‖ := congrArg norm hfactor
    _ ≤ (2 * rho * M ^ 2) *
        ∫ t : Real, ‖H t‖ ^ (2 : Nat) ∂μT := hschur
    _ = (2 * rho * M ^ 2) * ∫ t : Real, ‖H t‖ ^ (2 : Nat) := by
      rw [integral_norm_sq_restrict_Icc_eq_volume_of_support_subset_Ioc
        H (by norm_num) hHsupport]

/-- The affine central profile is integrable on the physical angular line.
The proof is deliberately independent of the size of the target interval:
the unit central coordinate is supported in `[-1/2,1/2]`. -/
theorem integrable_norm_sq_affine_central
    (g : Real × Real → Real) (M : Real → Complex)
    (r c : Real) (hr : 0 < r)
    (hgcont : Continuous g) (hMcont : Continuous M)
    (hzero : ∀ u, u ∉ Icc (-(1 / 2 : Real)) (1 / 2 : Real) → g (r, u) = 0) :
    Integrable (fun theta : Real =>
      ‖((g (r, (theta - c) / r) : Real) : Complex) * M theta‖ ^ (2 : Nat)) := by
  let F : Real → Real := fun theta =>
    ‖((g (r, (theta - c) / r) : Real) : Complex) * M theta‖ ^ (2 : Nat)
  have hFcont : Continuous F := by
    dsimp only [F]
    fun_prop
  have hcompact : HasCompactSupport F := by
    apply HasCompactSupport.intro
      (isCompact_Icc : IsCompact (Icc (c - r / 2) (c + r / 2)))
    intro theta htheta
    have harg : (theta - c) / r ∉ Icc (-(1 / 2 : Real)) (1 / 2 : Real) := by
      intro hmem
      have hlo : -(1 / 2 : Real) ≤ (theta - c) / r := hmem.1
      have hhi : (theta - c) / r ≤ 1 / 2 := hmem.2
      have htheta' : theta ∈ Icc (c - r / 2) (c + r / 2) := by
        constructor <;> field_simp [ne_of_gt hr] at hlo hhi ⊢ <;> nlinarith
      exact htheta htheta'
    dsimp only [F]
    rw [hzero _ harg]
    norm_num
  exact hFcont.integrable_of_hasCompactSupport hcompact

/-- One-sided affine transport from any physical angular interval to the
central unit coordinate. -/
theorem integral_norm_sq_affine_central_restrict_le
    (g : Real × Real → Real) (M : Real → Complex)
    (r c L U : Real) (hr : 0 < r)
    (hzero : ∀ u, u ∉ Icc (-(1 / 2 : Real)) (1 / 2 : Real) → g (r, u) = 0)
    (hFint : Integrable (fun theta : Real =>
      ‖((g (r, (theta - c) / r) : Real) : Complex) * M theta‖ ^ (2 : Nat))) :
    (∫ theta : Real,
      ‖((g (r, (theta - c) / r) : Real) : Complex) * M theta‖ ^ (2 : Nat)
        ∂(volume.restrict (Icc L U))) ≤
      r * ∫ u : Real,
        ‖((g (r, u) : Real) : Complex) * M (c + r * u)‖ ^ (2 : Nat)
          ∂centralParametricAngleMeasure := by
  let F : Real → Real := fun theta =>
    ‖((g (r, (theta - c) / r) : Real) : Complex) * M theta‖ ^ (2 : Nat)
  let H : Real → Real := fun u =>
    ‖((g (r, u) : Real) : Complex) * M (c + r * u)‖ ^ (2 : Nat)
  have hFnonneg : 0 ≤ᵐ[volume] F := Filter.Eventually.of_forall fun _ => sq_nonneg _
  have hmono : (∫ theta : Real, F theta ∂(volume.restrict (Icc L U))) ≤
      ∫ theta : Real, F theta :=
    integral_mono_measure Measure.restrict_le_self hFnonneg (by
      simpa only [F] using hFint)
  have haffine : (∫ theta : Real, F theta) = r * ∫ u : Real, H u := by
    calc
      (∫ theta : Real, F theta) = r * ∫ u : Real, F (c + r * u) :=
        integral_affine_comp_eq F c r hr
      _ = r * ∫ u : Real, H u := by
        rw [show (fun u : Real => F (c + r * u)) = fun u => H u by
          funext u
          dsimp only [F, H]
          have harg : (c + r * u - c) / r = u := by
            field_simp [ne_of_gt hr]
            ring
          rw [harg]]
  have hHzero : ∀ u, u ∉ Icc (-(1 / 2 : Real)) (1 / 2 : Real) → H u = 0 := by
    intro u hu
    dsimp only [H]
    rw [hzero u hu]
    norm_num
  have hrestrict : (∫ u : Real, H u ∂centralParametricAngleMeasure) =
      ∫ u : Real, H u := by
    exact setIntegral_eq_integral_of_forall_compl_eq_zero hHzero
  change (∫ theta : Real, F theta ∂(volume.restrict (Icc L U))) ≤
    r * ∫ u : Real, H u ∂centralParametricAngleMeasure
  calc
    (∫ theta : Real, F theta ∂(volume.restrict (Icc L U))) ≤
        ∫ theta : Real, F theta := hmono
    _ = r * ∫ u : Real, H u := haffine
    _ = r * ∫ u : Real, H u ∂centralParametricAngleMeasure := by rw [hrestrict]

/-- Generic one-piece central transport.  It is the central analogue of the
two-lobe affine transport, retaining the literal source multiplier and the
actual parametric `TT*` analysis. -/
theorem shellFrequencyEnergy_affine_central_le_parametric
    (m : Real → Complex) (M H : Real → Complex)
    (g : Real × Real → Real) (r c lo hi lambda : Real) (xi : Euclidean 2)
    (hr : 0 < r) (hMcont : Continuous M) (hgcont : Continuous g)
    (hzero : ∀ u, u ∉ Icc (-(1 / 2 : Real)) (1 / 2 : Real) → g (r, u) = 0)
    (hraw : ∀ theta, m theta =
      (g (r, (theta - c) / r) : Complex) * M theta)
    (hanalysis : ∀ u,
      (g (r, u) : Complex) * M (c + r * u) =
        ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g r lambda) H u) :
    shellFrequencyEnergy (fun theta _ => m theta) lo hi xi ≤
      centralParametricFiberEnergy g r lambda H := by
  have hFint := integrable_norm_sq_affine_central g M r c hr hgcont hMcont hzero
  have htransport := integral_norm_sq_affine_central_restrict_le
    g M r c lo hi hr hzero hFint
  unfold shellFrequencyEnergy
  rw [show (fun theta : Real => ‖m theta‖ ^ (2 : Nat)) =
      fun theta => ‖(g (r, (theta - c) / r) : Complex) * M theta‖ ^ (2 : Nat) by
        funext theta
        rw [hraw]]
  calc
    (∫ theta : Real,
      ‖(g (r, (theta - c) / r) : Complex) * M theta‖ ^ (2 : Nat)
        ∂(volume.restrict (Icc lo hi))) ≤
      r * ∫ u : Real,
        ‖(g (r, u) : Complex) * M (c + r * u)‖ ^ (2 : Nat)
          ∂centralParametricAngleMeasure := htransport
    _ = centralParametricFiberEnergy g r lambda H := by
      unfold centralParametricFiberEnergy
      congr 1
      apply integral_congr_ae
      filter_upwards with u
      rw [hanalysis]

/-- The actual central profile has unit size on its compact coordinate
interval, so the elementary central Schur estimate costs exactly `2*r` times
the literal finite-tensor source energy. -/
theorem centralParametricFiberEnergy_shiftedCentral_le_source
    {iota : Type*} (n : Nat)
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (a : iota → SchwartzMap Real Complex) (xi : Euclidean 2)
    (r lambda rTime : Real) (hr : 0 < r) (hrTime : rTime < 1)
    (hsupport : ∀ l, Function.support (a l : Real → Complex) ⊆
      closedBall (3 / 2 : Real) rTime) :
    centralParametricFiberEnergy (shiftedCentralParametricProfile n) r lambda
      (scratch_finiteTensorTimeData s q a xi) ≤
      (2 * r) * shiftedFiberSourceEnergy s q a xi := by
  let H : Real → Complex := scratch_finiteTensorTimeData s q a xi
  have hHcont : Continuous H := continuous_scratch_finiteTensorTimeData s q a xi
  have hHsupport : Function.support H ⊆ Ioc (1 / 2 : Real) (5 / 2 : Real) :=
    (support_scratch_finiteTensorTimeData_subset_innerSlab s q a xi hsupport).trans
      (closedBall_innerSlab_subset_Ioc hrTime)
  have hbound := centralParametricFiberEnergy_le_of_bound
    (g := shiftedCentralParametricProfile n) (M := 1) (lambda := lambda) hr
    (by norm_num) (contDiff_shiftedCentralParametricProfile n).continuous
    (fun u hu => by
      simpa only [abs_of_nonneg (shiftedCentralParametricProfile_nonneg_le_one n r u).1]
        using (shiftedCentralParametricProfile_nonneg_le_one n r u).2)
    H hHcont hHsupport
  change centralParametricFiberEnergy (shiftedCentralParametricProfile n) r lambda H ≤
    (2 * r) * shiftedFiberSourceEnergy s q a xi
  simpa only [H, shiftedFiberSourceEnergy, one_pow, mul_one] using hbound

/-- A bounded central profile transports directly to the literal source
energy.  This is the common cutoff-coordinate E1 estimate before its
outside `r⁻²` scalar is inserted. -/
theorem centralParametricFiberEnergy_le_source_of_uniform_bound
    {iota : Type*} (g : Real × Real → Real) (M : Real)
    (hg : Continuous g) (hM : 0 ≤ M)
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (a : iota → SchwartzMap Real Complex) (xi : Euclidean 2)
    (r lambda rTime : Real) (hr : 0 < r) (hrTime : rTime < 1)
    (hbound : ∀ u ∈ Icc (-(1 / 2 : Real)) (1 / 2 : Real), |g (r, u)| ≤ M)
    (hsupport : ∀ l, Function.support (a l : Real → Complex) ⊆
      closedBall (3 / 2 : Real) rTime) :
    centralParametricFiberEnergy g r lambda
      (scratch_finiteTensorTimeData s q a xi) ≤
      (2 * r * M ^ (2 : Nat)) * shiftedFiberSourceEnergy s q a xi := by
  let H : Real → Complex := scratch_finiteTensorTimeData s q a xi
  have hHcont : Continuous H := continuous_scratch_finiteTensorTimeData s q a xi
  have hHsupport : Function.support H ⊆ Ioc (1 / 2 : Real) (5 / 2 : Real) :=
    (support_scratch_finiteTensorTimeData_subset_innerSlab s q a xi hsupport).trans
      (closedBall_innerSlab_subset_Ioc hrTime)
  have henergy := centralParametricFiberEnergy_le_of_bound (lambda := lambda)
    hr hM hg hbound H hHcont hHsupport
  change centralParametricFiberEnergy g r lambda H ≤
    (2 * r * M ^ (2 : Nat)) * shiftedFiberSourceEnergy s q a xi
  simpa only [H, shiftedFiberSourceEnergy] using henergy

/-- The time-weighted phase datum remains on the same compact slab and costs
the literal factor `(5/2)²` in its source energy. -/
theorem centralParametricFiberEnergy_timeWeighted_le_source_of_uniform_bound
    {iota : Type*} (g : Real × Real → Real) (M : Real)
    (hg : Continuous g) (hM : 0 ≤ M)
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (a : iota → SchwartzMap Real Complex) (xi : Euclidean 2)
    (r lambda rTime : Real) (hr : 0 < r) (hrTime : rTime < 1)
    (hbound : ∀ u ∈ Icc (-(1 / 2 : Real)) (1 / 2 : Real), |g (r, u)| ≤ M)
    (hsupport : ∀ l, Function.support (a l : Real → Complex) ⊆
      closedBall (3 / 2 : Real) rTime) :
    centralParametricFiberEnergy g r lambda
      (timeWeighted (scratch_finiteTensorTimeData s q a xi)) ≤
      (2 * r * M ^ (2 : Nat)) * (5 / 2 : Real) ^ (2 : Nat) *
        shiftedFiberSourceEnergy s q a xi := by
  let H : Real → Complex := scratch_finiteTensorTimeData s q a xi
  have hHcont : Continuous H := continuous_scratch_finiteTensorTimeData s q a xi
  have hHsupport : Function.support H ⊆ Ioc (1 / 2 : Real) (5 / 2 : Real) :=
    (support_scratch_finiteTensorTimeData_subset_innerSlab s q a xi hsupport).trans
      (closedBall_innerSlab_subset_Ioc hrTime)
  have hweightCont : Continuous (timeWeighted H) := by
    unfold timeWeighted
    exact (Complex.continuous_ofReal.comp continuous_id).mul hHcont
  have hweightSupport : Function.support (timeWeighted H) ⊆ Ioc (1 / 2 : Real) (5 / 2 : Real) := by
    intro t ht
    apply hHsupport
    by_contra hdata
    have hz : H t = 0 := by
      exact not_ne_iff.mp (by simpa only [Function.mem_support] using hdata)
    exact ht (by simp [timeWeighted, hz])
  have henergy := centralParametricFiberEnergy_le_of_bound (lambda := lambda)
    hr hM hg hbound
    (timeWeighted H) hweightCont hweightSupport
  have hweighted := integrable_norm_sq_timeWeighted_scratch_finiteTensorTimeData_and_integral_le
    s q a xi hrTime hsupport (integrable_sq_scratch_finiteTensorTimeData s q a xi)
  have hC : 0 ≤ 2 * r * M ^ (2 : Nat) := by positivity
  calc
    centralParametricFiberEnergy g r lambda (timeWeighted H) ≤
      (2 * r * M ^ (2 : Nat)) * ∫ t : Real, ‖timeWeighted H t‖ ^ (2 : Nat) := henergy
    _ ≤ (2 * r * M ^ (2 : Nat)) *
        ((5 / 2 : Real) ^ (2 : Nat) * ∫ t : Real, ‖H t‖ ^ (2 : Nat)) :=
      mul_le_mul_of_nonneg_left hweighted.2 hC
    _ = (2 * r * M ^ (2 : Nat)) * (5 / 2 : Real) ^ (2 : Nat) *
        shiftedFiberSourceEnergy s q a xi := by
      simp only [H, shiftedFiberSourceEnergy]
      ring

/-- Scale conversion for the central E0 estimate.  The upper critical-scale
relation is exactly what turns the trivial `r` bound into reciprocal
frequency scale. -/
theorem central_E0_scale_from_critical_upper
    {nu r A E : Real} (hnu : 0 < nu) (hr : 0 < r) (hE : 0 ≤ E)
    (hcritical : nu * r ^ (2 : Nat) ≤ A) :
    (2 * r) * E ≤ (2 * A / (nu * r)) * E := by
  have hden : 0 < nu * r := mul_pos hnu hr
  have hcoef : 2 * r ≤ 2 * A / (nu * r) := by
    apply (le_div_iff₀ hden).mpr
    nlinarith [hcritical]
  exact mul_le_mul_of_nonneg_right hcoef hE

/-- Central critical-window algebra for the explicit two-term E1 budget.
The lower condition absorbs the cutoff `r⁻¹`; the upper condition controls
the phase factor.  The displayed constants are deliberately literal. -/
theorem central_E1_budget_le_direct_scale
    {ell r Mcut Mphase H : Real}
    (hell : 0 < ell) (hr : 0 < r) (hH : 0 ≤ H)
    (hlow : 1 ≤ ell * r ^ (2 : Nat))
    (hhigh : ell * r ^ (2 : Nat) ≤ 32) :
    2 * (
      (r ^ (2 : Nat))⁻¹ * ((2 * r * Mcut ^ (2 : Nat)) * H) +
      ((2 * Real.pi) * ell * r) ^ (2 : Nat) *
        ((2 * r * Mphase ^ (2 : Nat)) * (5 / 2 : Real) ^ (2 : Nat) * H)) ≤
      (4 * Mcut ^ (2 : Nat) +
        800 * (2 * Real.pi) ^ (2 : Nat) * Mphase ^ (2 : Nat)) * (ell * r) * H := by
  have hbase : (r ^ (2 : Nat))⁻¹ * r ≤ ell * r := by
    have hr2 : r ^ (2 : Nat) = r * r := by ring
    rw [hr2]
    calc
      (r * r)⁻¹ * r = r⁻¹ := by field_simp [ne_of_gt hr]
      _ ≤ ell * r := by
        apply (inv_le_iff_one_le_mul₀ hr).mpr
        nlinarith [hlow]
  have hcut :
      2 * ((r ^ (2 : Nat))⁻¹ * ((2 * r * Mcut ^ (2 : Nat)) * H)) ≤
        4 * Mcut ^ (2 : Nat) * (ell * r) * H := by
    calc
      2 * ((r ^ (2 : Nat))⁻¹ * ((2 * r * Mcut ^ (2 : Nat)) * H)) =
          4 * Mcut ^ (2 : Nat) * (((r ^ (2 : Nat))⁻¹ * r) * H) := by ring
      _ ≤ 4 * Mcut ^ (2 : Nat) * ((ell * r) * H) := by gcongr
      _ = 4 * Mcut ^ (2 : Nat) * (ell * r) * H := by ring
  have hphase :
      2 * (((2 * Real.pi) * ell * r) ^ (2 : Nat) *
        ((2 * r * Mphase ^ (2 : Nat)) * (5 / 2 : Real) ^ (2 : Nat) * H)) ≤
        800 * (2 * Real.pi) ^ (2 : Nat) * Mphase ^ (2 : Nat) * (ell * r) * H := by
    calc
      2 * (((2 * Real.pi) * ell * r) ^ (2 : Nat) *
        ((2 * r * Mphase ^ (2 : Nat)) * (5 / 2 : Real) ^ (2 : Nat) * H)) =
        25 * (2 * Real.pi) ^ (2 : Nat) * Mphase ^ (2 : Nat) *
          (ell * r ^ (2 : Nat)) * ((ell * r) * H) := by ring
      _ ≤ 25 * (2 * Real.pi) ^ (2 : Nat) * Mphase ^ (2 : Nat) *
          32 * ((ell * r) * H) := by gcongr
      _ = 800 * (2 * Real.pi) ^ (2 : Nat) * Mphase ^ (2 : Nat) *
          (ell * r) * H := by ring
  calc
    2 * (
      (r ^ (2 : Nat))⁻¹ * ((2 * r * Mcut ^ (2 : Nat)) * H) +
      ((2 * Real.pi) * ell * r) ^ (2 : Nat) *
        ((2 * r * Mphase ^ (2 : Nat)) * (5 / 2 : Real) ^ (2 : Nat) * H)) =
      2 * ((r ^ (2 : Nat))⁻¹ * ((2 * r * Mcut ^ (2 : Nat)) * H)) +
        2 * (((2 * Real.pi) * ell * r) ^ (2 : Nat) *
          ((2 * r * Mphase ^ (2 : Nat)) * (5 / 2 : Real) ^ (2 : Nat) * H)) := by ring
    _ ≤ 4 * Mcut ^ (2 : Nat) * (ell * r) * H +
        800 * (2 * Real.pi) ^ (2 : Nat) * Mphase ^ (2 : Nat) * (ell * r) * H :=
      add_le_add hcut hphase
    _ = (4 * Mcut ^ (2 : Nat) +
        800 * (2 * Real.pi) ^ (2 : Nat) * Mphase ^ (2 : Nat)) * (ell * r) * H := by ring

/-- Fibrewise Cauchy recombination for the two literal central E1 terms.
It keeps the cutoff carrier and phase scalar visible so the ensuing critical
scale algebra is transparent. -/
theorem shellFrequencyEnergy_central_twoTerm_E1_le
    (m mCut mPhase : Real → Complex) (r lambda lo hi : Real) (xi : Euclidean 2)
    (phaseSign : Complex) (hphaseSign : ‖phaseSign‖ = 1)
    (hraw : ∀ theta : Real, m theta =
      ((r⁻¹ : Real) : Complex) * mCut theta +
        phaseSign * ((((2 * Real.pi) * lambda * r : Real) : Complex) * mPhase theta))
    (hCutCont : Continuous mCut) (hPhaseCont : Continuous mPhase) :
    shellFrequencyEnergy (fun theta _ => m theta) lo hi xi ≤
      2 * ((r ^ (2 : Nat))⁻¹ *
        shellFrequencyEnergy (fun theta _ => mCut theta) lo hi xi +
        ((2 * Real.pi) * lambda * r) ^ (2 : Nat) *
          shellFrequencyEnergy (fun theta _ => mPhase theta) lo hi xi) := by
  let m0 : Real → Euclidean 2 → Complex := fun theta _ =>
    ((r⁻¹ : Real) : Complex) * mCut theta
  let m1 : Real → Euclidean 2 → Complex := fun theta _ =>
    phaseSign * ((((2 * Real.pi) * lambda * r : Real) : Complex) * mPhase theta)
  have h0cont : Continuous (fun theta : Real => m0 theta xi) := by
    dsimp only [m0]
    exact continuous_const.mul hCutCont
  have h1cont : Continuous (fun theta : Real => m1 theta xi) := by
    dsimp only [m1]
    exact continuous_const.mul (continuous_const.mul hPhaseCont)
  have hsum := shellFrequencyEnergy_add_le_two_mul_add m0 m1 lo hi xi
    h0cont.aestronglyMeasurable.restrict h1cont.aestronglyMeasurable.restrict
    (h0cont.norm.pow 2).integrableOn_Icc
    (h1cont.norm.pow 2).integrableOn_Icc
  have hrewrite : shellFrequencyEnergy (fun theta _ => m theta) lo hi xi =
      shellFrequencyEnergy (fun theta y => m0 theta y + m1 theta y) lo hi xi := by
    unfold shellFrequencyEnergy
    apply integral_congr_ae
    filter_upwards with theta
    dsimp only [m0, m1]
    rw [hraw]
  rw [← hrewrite] at hsum
  rw [shellFrequencyEnergy_inv_carrier_mul,
    shellFrequencyEnergy_unitImag_phase_mul phaseSign hphaseSign] at hsum
  exact hsum

/-- The physical product-rule version of the same Cauchy recombination,
before the phase bridge contributes its scalar. -/
theorem shellFrequencyEnergy_central_rawTwoTerm_le
    (m mCut mPhase : Real → Complex) (r lo hi : Real) (xi : Euclidean 2)
    (hraw : ∀ theta : Real, m theta =
      ((r⁻¹ : Real) : Complex) * mCut theta + mPhase theta)
    (hCutCont : Continuous mCut) (hPhaseCont : Continuous mPhase) :
    shellFrequencyEnergy (fun theta _ => m theta) lo hi xi ≤
      2 * ((r ^ (2 : Nat))⁻¹ *
        shellFrequencyEnergy (fun theta _ => mCut theta) lo hi xi +
        shellFrequencyEnergy (fun theta _ => mPhase theta) lo hi xi) := by
  let m0 : Real → Euclidean 2 → Complex := fun theta _ =>
    ((r⁻¹ : Real) : Complex) * mCut theta
  let m1 : Real → Euclidean 2 → Complex := fun theta _ => mPhase theta
  have h0cont : Continuous (fun theta : Real => m0 theta xi) := by
    dsimp only [m0]
    exact continuous_const.mul hCutCont
  have h1cont : Continuous (fun theta : Real => m1 theta xi) := by
    dsimp only [m1]
    exact hPhaseCont
  have hsum := shellFrequencyEnergy_add_le_two_mul_add m0 m1 lo hi xi
    h0cont.aestronglyMeasurable.restrict h1cont.aestronglyMeasurable.restrict
    (h0cont.norm.pow 2).integrableOn_Icc
    (h1cont.norm.pow 2).integrableOn_Icc
  have hrewrite : shellFrequencyEnergy (fun theta _ => m theta) lo hi xi =
      shellFrequencyEnergy (fun theta y => m0 theta y + m1 theta y) lo hi xi := by
    unfold shellFrequencyEnergy
    apply integral_congr_ae
    filter_upwards with theta
    dsimp only [m0, m1]
    rw [hraw]
  rw [← hrewrite] at hsum
  rw [shellFrequencyEnergy_inv_carrier_mul] at hsum
  exact hsum

