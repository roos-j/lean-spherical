    hcpcont hcmcont hppcont hpmcont
    (shiftedTerminalE1CutoffPlus_eq_zero_of_not_mem_Icc C j s q a n ratio r hratio xi)
    (shiftedTerminalE1CutoffMinus_eq_zero_of_not_mem_Icc C j s q a n ratio r hratio xi)
    (shiftedTerminalE1PhasePlus_eq_zero_of_not_mem_Icc C j s q a n ratio r hratio xi)
    (shiftedTerminalE1PhaseMinus_eq_zero_of_not_mem_Icc C j s q a n ratio r hratio xi)
    (shiftedChartedCappedTelescopingMultiplierDerivRaw_terminal_eq_four_analysis
      C j s q hqcompact a K n hratio hratioDef hr xi hpolar hn)

