energies required for E1. -/
theorem shellFrequencyEnergy_shiftedCharted_terminal_deriv_le_four_analysis
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex)
    {eps ratio r : Real} (K n : Nat) (hratio : ratio ∈ Icc (1 / 2 : Real) 1)
    (hratioDef : ratio = ((2 : Real) ^ K * eps) / (Real.pi / 2))
    (hr : r = (4 / 5 : Real) * (Real.pi / 2))
    (lo hi : Real) (xi : Euclidean 2)
    (hpolar : xi = ‖xi‖ • circleDirection (C.angle j xi))
    (hn : n < 7)
    {rTime : Real} (hrTime : rTime < 1)
    (hsupport : ∀ l, Function.support (a l : Real → Complex) ⊆
      closedBall (3 / 2 : Real) rTime) :
    shellFrequencyEnergy
      (shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n (K + 1))
      lo hi xi ≤
      2 * (
        2 * (r * (∫ u : Real, ‖shiftedTerminalE1CutoffPlus C j s q a n ratio r xi u‖ ^ (2 : Nat)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2))) +
          r * (∫ u : Real, ‖shiftedTerminalE1CutoffMinus C j s q a n ratio r xi u‖ ^ (2 : Nat)
            ∂(volume.restrict (Icc (1 / 2 : Real) 2)))) +
        2 * (r * (∫ u : Real, ‖shiftedTerminalE1PhasePlus C j s q a n ratio r xi u‖ ^ (2 : Nat)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2))) +
          r * (∫ u : Real, ‖shiftedTerminalE1PhaseMinus C j s q a n ratio r xi u‖ ^ (2 : Nat)
            ∂(volume.restrict (Icc (1 / 2 : Real) 2))))) := by
  let H : Real → Complex := scratch_finiteTensorTimeData s (chartProfiles C j q) a xi
  have hHcont : Continuous H := by
    dsimp [H]
    exact continuous_scratch_finiteTensorTimeData s (chartProfiles C j q) a xi
  have hHsupport : Function.support H ⊆ Ioc (1 / 2 : Real) (5 / 2 : Real) := by
    dsimp [H]
    exact (support_scratch_finiteTensorTimeData_subset_innerSlab
      s (chartProfiles C j q) a xi hsupport).trans
      (closedBall_innerSlab_subset_Ioc hrTime)
  let W : Real → Complex := timeWeighted H
  have hWcont : Continuous W := by
    dsimp [W]
    unfold timeWeighted
    exact (Complex.continuous_ofReal.comp continuous_id).mul hHcont
  have hWsupport : Function.support W ⊆ Ioc (1 / 2 : Real) (5 / 2 : Real) := by
    intro t ht
    apply hHsupport
    by_contra hzero
    have hHt : H t = 0 := by
      by_contra hne
      exact hzero (Function.mem_support.mpr hne)
    exact ht (by simp [W, timeWeighted, hHt])
  have hcpcont : Continuous (shiftedTerminalE1CutoffPlus C j s q a n ratio r xi) := by
    unfold shiftedTerminalE1CutoffPlus
    apply continuous_const.mul
    exact continuous_ttstarAnalysis_parametricProfile_of_compact_time_support
      (shiftedCappedTerminalPositiveCutoffDerivativeProfile n ratio)
      (contDiff_shiftedCappedTerminalPositiveCutoffDerivativeProfile n ratio).continuous
      r (stationaryRadialSign n * ‖xi‖) H hHcont (by norm_num) hHsupport
  have hcmcont : Continuous (shiftedTerminalE1CutoffMinus C j s q a n ratio r xi) := by
    unfold shiftedTerminalE1CutoffMinus
    apply continuous_const.mul
    exact continuous_ttstarAnalysis_parametricProfile_of_compact_time_support
      (shiftedCappedTerminalReflectedNegativeCutoffDerivativeProfile n ratio)
      (contDiff_shiftedCappedTerminalReflectedNegativeCutoffDerivativeProfile n ratio).continuous
      r (stationaryRadialSign n * ‖xi‖) H hHcont (by norm_num) hHsupport
  have hppgcont : Continuous (shiftedCappedTerminalPositiveScaledPhaseProfile n ratio) := by
    simpa [HasJointSndSmooth] using
      (hasJointSndSmooth_shiftedCappedTerminalPositiveScaledPhaseProfile n ratio 0)
  have hpmgcont : Continuous (shiftedCappedTerminalReflectedNegativeScaledPhaseProfile n ratio) :=
      by
    simpa [HasJointSndSmooth] using
      (hasJointSndSmooth_shiftedCappedTerminalReflectedNegativeScaledPhaseProfile n ratio 0)
  have hppcont : Continuous (shiftedTerminalE1PhasePlus C j s q a n ratio r xi) := by
    unfold shiftedTerminalE1PhasePlus
    change Continuous (fun u : Real =>
      (-Complex.I) * (((2 * Real.pi) * (stationaryRadialSign n * ‖xi‖) * r : Real) : Complex) *
        ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
            (shiftedCappedTerminalPositiveScaledPhaseProfile n ratio) r
            (stationaryRadialSign n * ‖xi‖)) W u)
    let F : Real → Complex := fun u => ttstarAnalysis volume
      (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
        (shiftedCappedTerminalPositiveScaledPhaseProfile n ratio) r
        (stationaryRadialSign n * ‖xi‖)) W u
    have hFcont : Continuous F := by
      dsimp [F]
      exact continuous_ttstarAnalysis_parametricProfile_of_compact_time_support
        (shiftedCappedTerminalPositiveScaledPhaseProfile n ratio) hppgcont
        r (stationaryRadialSign n * ‖xi‖) W hWcont (by norm_num) hWsupport
    have hscale : Continuous (fun u : Real =>
        (((2 * Real.pi) * (stationaryRadialSign n * ‖xi‖) * r : Real) : Complex) * F u) :=
      continuous_const.mul hFcont
    have hsign : Continuous (fun u : Real => (-Complex.I) *
        ((((2 * Real.pi) * (stationaryRadialSign n * ‖xi‖) * r : Real) : Complex) * F u)) :=
      continuous_const.mul hscale
    convert hsign using 1
    ext u
    dsimp [F]
    ring
  have hpmcont : Continuous (shiftedTerminalE1PhaseMinus C j s q a n ratio r xi) := by
    unfold shiftedTerminalE1PhaseMinus
    change Continuous (fun u : Real =>
      Complex.I * (((2 * Real.pi) * (stationaryRadialSign n * ‖xi‖) * r : Real) : Complex) *
        ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
            (shiftedCappedTerminalReflectedNegativeScaledPhaseProfile n ratio) r
            (stationaryRadialSign n * ‖xi‖)) W u)
    let F : Real → Complex := fun u => ttstarAnalysis volume
      (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
        (shiftedCappedTerminalReflectedNegativeScaledPhaseProfile n ratio) r
        (stationaryRadialSign n * ‖xi‖)) W u
    have hFcont : Continuous F := by
      dsimp [F]
      exact continuous_ttstarAnalysis_parametricProfile_of_compact_time_support
        (shiftedCappedTerminalReflectedNegativeScaledPhaseProfile n ratio) hpmgcont
        r (stationaryRadialSign n * ‖xi‖) W hWcont (by norm_num) hWsupport
    have hscale : Continuous (fun u : Real =>
        (((2 * Real.pi) * (stationaryRadialSign n * ‖xi‖) * r : Real) : Complex) * F u) :=
      continuous_const.mul hFcont
    have hsign : Continuous (fun u : Real => Complex.I *
        ((((2 * Real.pi) * (stationaryRadialSign n * ‖xi‖) * r : Real) : Complex) * F u)) :=
      continuous_const.mul hscale
    convert hsign using 1
