  have hlocal' :
      (fun v : Real => cutoff (stationaryShift n + r * v)) =ᶠ[nhds u]
        fun v : Real => g (r, v) := by
    simpa [cutoff] using hlocal
  have hvalue : cutoff (stationaryShift n + r * u) = g (r, u) := by
    exact hlocal'.self_of_nhds
  have hderivLocal : deriv (fun v : Real => cutoff (stationaryShift n + r * v)) u =
      deriv (fun v : Real => g (r, v)) u := by
    exact hlocal'.deriv.self_of_nhds
  have harg : HasDerivAt (fun v : Real => stationaryShift n + r * v) r u := by
    convert ((hasDerivAt_const u (stationaryShift n)).add
      ((hasDerivAt_id u).const_mul r)) using 1 <;> first | rfl | ring
  have hchain : HasDerivAt (fun v : Real => cutoff (stationaryShift n + r * v))
      (deriv cutoff (stationaryShift n + r * u) * r) u := by
    exact (hasDerivAt_shiftedCappedTelescopingCutoffProfile eps K n i
      (stationaryShift n + r * u)).comp u harg
  have hscale : deriv cutoff (stationaryShift n + r * u) =
      r⁻¹ * deriv (fun v : Real => g (r, v)) u := by
    have hEq : deriv cutoff (stationaryShift n + r * u) * r =
        deriv (fun v : Real => g (r, v)) u := by
      rw [← hderivLocal]
      exact hchain.deriv.symm
    field_simp [hr]
    linarith
  unfold shiftedChartedCappedTelescopingMultiplierDerivRaw
    angularCutoffFiniteTensorMultiplierDeriv
  have htheta : C.angle j xi + stationaryShift n + r * u - C.angle j xi =
      stationaryShift n + r * u := by ring
  rw [htheta]
  change ((deriv cutoff (stationaryShift n + r * u) : Real) : Complex) * _ +
      (cutoff (stationaryShift n + r * u) : Complex) * _ = _
  rw [hvalue, hscale]
  push_cast
  ring

/-- The same local product rule on the reflected (`- r*u`) stationary side.
The cutoff differentiation contributes `(-r)⁻¹`; this sign is retained so it
can be absorbed harmlessly only at the subsequent energy step. -/
theorem shiftedChartedCappedTelescopingMultiplierDerivRaw_reflected_local_of_profile
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (eps : Real) (K n i : Nat) (g : Real × Real -> Real)
    {r : Real} (hr : r ≠ 0) (u : Real) (xi : Euclidean 2)
    (hlocal :
      (fun v : Real => shiftedCappedTelescopingCutoffProfile eps K n i
        (stationaryShift n - r * v)) =ᶠ[nhds u]
      fun v : Real => g (r, v)) :
    shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n i
      (C.angle j xi + stationaryShift n - r * u) xi =
      (((-r)⁻¹ : Real) : Complex) *
          ((deriv (fun v : Real => g (r, v)) u : Real) : Complex) *
        scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
          (chartProfiles_compact C j q hqcompact) a
          (circleDirection (C.angle j xi + stationaryShift n - r * u)) xi +
      (g (r, u) : Complex) *
        finiteTensorTubeMultiplierAngularDeriv s (chartProfiles C j q) a
          (C.angle j xi + stationaryShift n - r * u) xi := by
  let gref : Real × Real -> Real := fun p => g (-p.1, p.2)
  have hlocal' :
      (fun v : Real => shiftedCappedTelescopingCutoffProfile eps K n i
        (stationaryShift n + (-r) * v)) =ᶠ[nhds u]
      fun v : Real => gref (-r, v) := by
    simpa [gref, sub_eq_add_neg] using hlocal
  have hraw := shiftedChartedCappedTelescopingMultiplierDerivRaw_local_of_profile
    C j s q hqcompact a eps K n i gref (r := -r) (neg_ne_zero.mpr hr) u xi hlocal'
  simpa [gref, sub_eq_add_neg] using hraw

/-- Differentiate a global two-lobe cutoff reconstruction before doing any
reflection.  This is deliberately algebraic: the two cutoff-coordinate
derivative lobes and the two angular-phase lobes are all kept as separate
summands. -/
theorem shiftedChartedCappedTelescopingMultiplierDerivRaw_local_of_profile_sum
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (eps : Real) (K n i : Nat)
    (gPlus gMinus : Real × Real -> Real)
    {r : Real} (hr : r ≠ 0) (u : Real) (xi : Euclidean 2)
    (hsplit : ∀ v : Real,
      shiftedCappedTelescopingCutoffProfile eps K n i
        (stationaryShift n + r * v) =
        gPlus (r, v) + gMinus (r, v))
    (hPlus : DifferentiableAt Real (fun v : Real => gPlus (r, v)) u)
    (hMinus : DifferentiableAt Real (fun v : Real => gMinus (r, v)) u) :
    shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n i
      (C.angle j xi + stationaryShift n + r * u) xi =
      ((r⁻¹ : Real) : Complex) *
          ((deriv (fun v : Real => gPlus (r, v)) u : Real) : Complex) *
        scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
          (chartProfiles_compact C j q hqcompact) a
          (circleDirection (C.angle j xi + stationaryShift n + r * u)) xi +
      ((r⁻¹ : Real) : Complex) *
          ((deriv (fun v : Real => gMinus (r, v)) u : Real) : Complex) *
        scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
          (chartProfiles_compact C j q hqcompact) a
          (circleDirection (C.angle j xi + stationaryShift n + r * u)) xi +
      (gPlus (r, u) : Complex) *
        finiteTensorTubeMultiplierAngularDeriv s (chartProfiles C j q) a
          (C.angle j xi + stationaryShift n + r * u) xi +
      (gMinus (r, u) : Complex) *
        finiteTensorTubeMultiplierAngularDeriv s (chartProfiles C j q) a
          (C.angle j xi + stationaryShift n + r * u) xi := by
  let g : Real × Real -> Real := fun p => gPlus p + gMinus p
  have hlocal :
      (fun v : Real => shiftedCappedTelescopingCutoffProfile eps K n i
        (stationaryShift n + r * v)) =ᶠ[nhds u]
      fun v : Real => g (r, v) := by
    filter_upwards with v
    simpa [g] using hsplit v
  have hraw := shiftedChartedCappedTelescopingMultiplierDerivRaw_local_of_profile
    C j s q hqcompact a eps K n i g hr u xi hlocal
  rw [show (fun v : Real => g (r, v)) =
      (fun v : Real => gPlus (r, v) + gMinus (r, v)) by
        funext v; rfl] at hraw
  have hderiv :
      deriv (fun v : Real => gPlus (r, v) + gMinus (r, v)) u =
        deriv (fun v : Real => gPlus (r, v)) u +
          deriv (fun v : Real => gMinus (r, v)) u := by
    have hsumfun : (fun v : Real => gPlus (r, v) + gMinus (r, v)) =
        (fun v : Real => gPlus (r, v)) + (fun v : Real => gMinus (r, v)) := by
      rfl
    rw [hsumfun]
    exact deriv_add hPlus hMinus
  rw [hderiv] at hraw
  simp only [g, Complex.ofReal_add] at hraw
  rw [hraw]
  ring

/-- Global dyadic raw-derivative split, before the negative lobe is reflected.
The equality is pointwise in the normalized local coordinate, so later energy
arguments can restrict to either outer lobe without an eventual-equality
conversion. -/
theorem shiftedChartedCappedTelescopingMultiplierDerivRaw_dyadic_global_lobe_split
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    {eps r : Real} (heps : 0 < eps) (K n k : Nat) (hk : k < K)
    (hr : r = (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps))
    (u : Real) (xi : Euclidean 2) :
    shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n (k + 1)
      (C.angle j xi + stationaryShift n + r * u) xi =
      ((r⁻¹ : Real) : Complex) *
          ((deriv (fun v : Real => shiftedDyadicPositiveProfile n (r, v)) u : Real) : Complex) *
        scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
          (chartProfiles_compact C j q hqcompact) a
          (circleDirection (C.angle j xi + stationaryShift n + r * u)) xi +
      ((r⁻¹ : Real) : Complex) *
          ((deriv (fun v : Real => shiftedDyadicNegativeProfile n (r, v)) u : Real) : Complex) *
        scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
          (chartProfiles_compact C j q hqcompact) a
          (circleDirection (C.angle j xi + stationaryShift n + r * u)) xi +
      (shiftedDyadicPositiveProfile n (r, u) : Complex) *
        finiteTensorTubeMultiplierAngularDeriv s (chartProfiles C j q) a
          (C.angle j xi + stationaryShift n + r * u) xi +
      (shiftedDyadicNegativeProfile n (r, u) : Complex) *
        finiteTensorTubeMultiplierAngularDeriv s (chartProfiles C j q) a
          (C.angle j xi + stationaryShift n + r * u) xi := by
  have hrne : r ≠ 0 := by
    rw [hr]
    positivity
  have hsplit : ∀ v : Real,
      shiftedCappedTelescopingCutoffProfile eps K n (k + 1)
        (stationaryShift n + r * v) =
        shiftedDyadicPositiveProfile n (r, v) + shiftedDyadicNegativeProfile n (r, v) := by
    intro v
    calc
      shiftedCappedTelescopingCutoffProfile eps K n (k + 1)
          (stationaryShift n + r * v) =
        shiftedCappedTelescopingCutoff eps K n (k + 1) 0
          (stationaryShift n + r * v) := by
            simpa using (shiftedCappedTelescopingCutoff_eq_profile eps K n (k + 1) 0
              (stationaryShift n + r * v)).symm
      _ = shiftedDyadicPositiveProfile n (r, v) + shiftedDyadicNegativeProfile n (r, v) := by
        simpa using
          (shiftedCappedTelescopingCutoff_dyadic_local_eq_lobes heps K n k hk 0 v hr)
  have hPlus : DifferentiableAt Real
      (fun v : Real => shiftedDyadicPositiveProfile n (r, v)) u := by
    exact ((contDiff_shiftedDyadicPositiveProfile n).comp
      (contDiff_const.prodMk contDiff_id)).differentiable (by simp) u
  have hMinus : DifferentiableAt Real
      (fun v : Real => shiftedDyadicNegativeProfile n (r, v)) u := by
    exact ((contDiff_shiftedDyadicNegativeProfile n).comp
      (contDiff_const.prodMk contDiff_id)).differentiable (by simp) u
  exact shiftedChartedCappedTelescopingMultiplierDerivRaw_local_of_profile_sum
    C j s q hqcompact a eps K n (k + 1)
    (shiftedDyadicPositiveProfile n) (shiftedDyadicNegativeProfile n)
    hrne u xi hsplit hPlus hMinus

/-- Global terminal-cap raw-derivative split.  The terminal ratio is retained
in every lobe, while the physical carrier remains the fixed capped radius. -/
theorem shiftedChartedCappedTelescopingMultiplierDerivRaw_terminal_global_lobe_split
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    {eps c r : Real} (K n : Nat) (hc : c ∈ Icc (1 / 2 : Real) 1)
    (hcdef : c = ((2 : Real) ^ K * eps) / (Real.pi / 2))
    (hr : r = (4 / 5 : Real) * (Real.pi / 2))
    (u : Real) (xi : Euclidean 2) :
    shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n (K + 1)
      (C.angle j xi + stationaryShift n + r * u) xi =
      ((r⁻¹ : Real) : Complex) *
          ((deriv (fun v : Real => shiftedCappedTerminalPositiveProfile n c (r, v)) u : Real) :
              Complex) *
        scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
          (chartProfiles_compact C j q hqcompact) a
          (circleDirection (C.angle j xi + stationaryShift n + r * u)) xi +
      ((r⁻¹ : Real) : Complex) *
          ((deriv (fun v : Real => shiftedCappedTerminalNegativeProfile n c (r, v)) u : Real) :
              Complex) *
        scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
          (chartProfiles_compact C j q hqcompact) a
          (circleDirection (C.angle j xi + stationaryShift n + r * u)) xi +
      (shiftedCappedTerminalPositiveProfile n c (r, u) : Complex) *
        finiteTensorTubeMultiplierAngularDeriv s (chartProfiles C j q) a
          (C.angle j xi + stationaryShift n + r * u) xi +
      (shiftedCappedTerminalNegativeProfile n c (r, u) : Complex) *
        finiteTensorTubeMultiplierAngularDeriv s (chartProfiles C j q) a
          (C.angle j xi + stationaryShift n + r * u) xi := by
  have hrne : r ≠ 0 := by
    rw [hr]
    positivity
  have hsplit : ∀ v : Real,
      shiftedCappedTelescopingCutoffProfile eps K n (K + 1)
        (stationaryShift n + r * v) =
        shiftedCappedTerminalPositiveProfile n c (r, v) +
          shiftedCappedTerminalNegativeProfile n c (r, v) := by
    intro v
    calc
      shiftedCappedTelescopingCutoffProfile eps K n (K + 1)
          (stationaryShift n + r * v) =
        shiftedCappedTelescopingCutoff eps K n (K + 1) 0
          (stationaryShift n + r * v) := by
            simpa using (shiftedCappedTelescopingCutoff_eq_profile eps K n (K + 1) 0
              (stationaryShift n + r * v)).symm
      _ = shiftedCappedTerminalPositiveProfile n c (r, v) +
          shiftedCappedTerminalNegativeProfile n c (r, v) := by
        simpa using
          (shiftedCappedTelescopingCutoff_terminal_local_eq_lobes K n 0 v hc hcdef hr)
  have hPlus : DifferentiableAt Real
      (fun v : Real => shiftedCappedTerminalPositiveProfile n c (r, v)) u := by
    exact ((contDiff_shiftedCappedTerminalPositiveProfile n c).comp
      (contDiff_const.prodMk contDiff_id)).differentiable (by simp) u
  have hMinus : DifferentiableAt Real
      (fun v : Real => shiftedCappedTerminalNegativeProfile n c (r, v)) u := by
    exact ((contDiff_shiftedCappedTerminalNegativeProfile n c).comp
      (contDiff_const.prodMk contDiff_id)).differentiable (by simp) u
  exact shiftedChartedCappedTelescopingMultiplierDerivRaw_local_of_profile_sum
    C j s q hqcompact a eps K n (K + 1)
    (shiftedCappedTerminalPositiveProfile n c)
    (shiftedCappedTerminalNegativeProfile n c)
    hrne u xi hsplit hPlus hMinus

/-- On the standard positive outer interval, the unreflected negative dyadic
lobe vanishes locally.  This is the small support fact that selects the
positive half of the literal cutoff split. -/
theorem shiftedDyadicNegativeProfile_eq_zero_of_neg_five_eighth_le
    (n : Nat) (rho : Real) {v : Real} (hv : -(5 / 8 : Real) ≤ v) :
    shiftedDyadicNegativeProfile n (rho, v) = 0 := by
  unfold shiftedDyadicNegativeProfile shiftedOuterParametricProfile
  rw [normalizedTelescopingNegativeLobe_eq_zero_of_neg_five_eighth_le hv]
  ring

/-- The positive dyadic lobe disappears after reflecting a positive local
coordinate to the negative side. -/
theorem shiftedDyadicPositiveProfile_reflect_eq_zero_of_neg_five_eighth_le
    (n : Nat) (rho : Real) {v : Real} (hv : -(5 / 8 : Real) ≤ v) :
    shiftedDyadicPositiveProfile n (rho, -v) = 0 := by
  unfold shiftedDyadicPositiveProfile shiftedOuterParametricProfile
  rw [normalizedTelescopingPositiveLobe_eq_zero_of_le_five_eighth]
  · ring
  · linarith

/-- The terminal negative lobe has the same local support separation as the
dyadic one, uniformly in the admissible terminal ratio. -/
theorem shiftedCappedTerminalNegativeProfile_eq_zero_of_neg_five_eighth_le
    (n : Nat) (c rho : Real) (hc : c ∈ Icc (1 / 2 : Real) 1)
    {v : Real} (hv : -(5 / 8 : Real) ≤ v) :
    shiftedCappedTerminalNegativeProfile n c (rho, v) = 0 := by
  unfold shiftedCappedTerminalNegativeProfile shiftedOuterParametricProfile
  change shiftedStationaryPreweightProfile n (rho * v) *
      safeCappedTerminalNegativeLobe c v = 0
  rw [show safeCappedTerminalNegativeLobe c v =
      safeCappedTerminalReflectedNegativeLobe c (-v) by
        simp [safeCappedTerminalReflectedNegativeLobe]]
  rw [safeCappedTerminalReflectedNegativeLobe_eq_zero_of_le_five_eighth hc]
  · ring
  · linarith

/-- Reflection selects the terminal negative lobe by locally killing the
positive terminal lobe. -/
theorem shiftedCappedTerminalPositiveProfile_reflect_eq_zero_of_neg_five_eighth_le
    (n : Nat) (c rho : Real) (hc : c ∈ Icc (1 / 2 : Real) 1)
    {v : Real} (hv : -(5 / 8 : Real) ≤ v) :
    shiftedCappedTerminalPositiveProfile n c (rho, -v) = 0 := by
  unfold shiftedCappedTerminalPositiveProfile shiftedOuterParametricProfile
  rw [safeCappedTerminalPositiveLobe_eq_zero_of_le_five_eighth hc]
  · ring
  · linarith

/-- Near every point of the standard outer interval the dyadic cutoff is
literally its positive lobe in positive stationary coordinates. -/
theorem shiftedCappedTelescopingCutoffProfile_dyadic_positive_eventuallyEq
    {eps r : Real} (heps : 0 < eps) (K n k : Nat) (hk : k < K)
    (hr : r = (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps))
    {u : Real} (hu : u ∈ Icc (1 / 2 : Real) 2) :
    (fun v : Real => shiftedCappedTelescopingCutoffProfile eps K n (k + 1)
      (stationaryShift n + r * v)) =ᶠ[nhds u]
      fun v : Real => shiftedDyadicPositiveProfile n (r, v) := by
  have hnear : Ioi (-(5 / 8 : Real)) ∈ nhds u :=
    Ioi_mem_nhds (by linarith [hu.1])
  filter_upwards [hnear] with v hv
  calc
    shiftedCappedTelescopingCutoffProfile eps K n (k + 1)
        (stationaryShift n + r * v) =
      shiftedCappedTelescopingCutoff eps K n (k + 1) 0
        (stationaryShift n + r * v) := by
          simpa using (shiftedCappedTelescopingCutoff_eq_profile eps K n (k + 1) 0
            (stationaryShift n + r * v)).symm
    _ = shiftedDyadicPositiveProfile n (r, v) + shiftedDyadicNegativeProfile n (r, v) := by
      simpa using
        (shiftedCappedTelescopingCutoff_dyadic_local_eq_lobes heps K n k hk 0 v hr)
    _ = shiftedDyadicPositiveProfile n (r, v) := by
      rw [shiftedDyadicNegativeProfile_eq_zero_of_neg_five_eighth_le n r (le_of_lt hv)]
      ring

/-- After reflection, the negative dyadic cutoff is the prepared positive-
carrier lobe on the same standard outer interval. -/
theorem shiftedCappedTelescopingCutoffProfile_dyadic_reflectedNegative_eventuallyEq
    {eps r : Real} (heps : 0 < eps) (K n k : Nat) (hk : k < K)
    (hr : r = (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps))
    {u : Real} (hu : u ∈ Icc (1 / 2 : Real) 2) :
    (fun v : Real => shiftedCappedTelescopingCutoffProfile eps K n (k + 1)
      (stationaryShift n - r * v)) =ᶠ[nhds u]
      fun v : Real => shiftedDyadicReflectedNegativeProfile n (r, v) := by
  have hnear : Ioi (-(5 / 8 : Real)) ∈ nhds u :=
    Ioi_mem_nhds (by linarith [hu.1])
  filter_upwards [hnear] with v hv
  calc
    shiftedCappedTelescopingCutoffProfile eps K n (k + 1)
        (stationaryShift n - r * v) =
      shiftedCappedTelescopingCutoff eps K n (k + 1) 0
        (stationaryShift n - r * v) := by
          simpa using (shiftedCappedTelescopingCutoff_eq_profile eps K n (k + 1) 0
            (stationaryShift n - r * v)).symm
    _ = shiftedDyadicPositiveProfile n (r, -v) + shiftedDyadicNegativeProfile n (r, -v) := by
      have hsplit := shiftedCappedTelescopingCutoff_dyadic_local_eq_lobes
        heps K n k hk 0 (-v) hr
      convert hsplit using 1; ring
    _ = shiftedDyadicNegativeProfile n (r, -v) := by
      rw [shiftedDyadicPositiveProfile_reflect_eq_zero_of_neg_five_eighth_le n r
        (le_of_lt hv)]
      ring
    _ = shiftedDyadicReflectedNegativeProfile n (r, v) :=
      shiftedDyadicNegativeProfile_reflect n r v

/-- The terminal positive lobe gives the same pointwise local germ. -/
theorem shiftedCappedTelescopingCutoffProfile_terminal_positive_eventuallyEq
    {eps c r : Real} (K n : Nat) (hc : c ∈ Icc (1 / 2 : Real) 1)
    (hcdef : c = ((2 : Real) ^ K * eps) / (Real.pi / 2))
    (hr : r = (4 / 5 : Real) * (Real.pi / 2))
    {u : Real} (hu : u ∈ Icc (1 / 2 : Real) 2) :
    (fun v : Real => shiftedCappedTelescopingCutoffProfile eps K n (K + 1)
      (stationaryShift n + r * v)) =ᶠ[nhds u]
      fun v : Real => shiftedCappedTerminalPositiveProfile n c (r, v) := by
  have hnear : Ioi (-(5 / 8 : Real)) ∈ nhds u :=
    Ioi_mem_nhds (by linarith [hu.1])
  filter_upwards [hnear] with v hv
  calc
    shiftedCappedTelescopingCutoffProfile eps K n (K + 1)
        (stationaryShift n + r * v) =
      shiftedCappedTelescopingCutoff eps K n (K + 1) 0
        (stationaryShift n + r * v) := by
          simpa using (shiftedCappedTelescopingCutoff_eq_profile eps K n (K + 1) 0
            (stationaryShift n + r * v)).symm
    _ = shiftedCappedTerminalPositiveProfile n c (r, v) +
        shiftedCappedTerminalNegativeProfile n c (r, v) := by
      simpa using
        (shiftedCappedTelescopingCutoff_terminal_local_eq_lobes K n 0 v hc hcdef hr)
    _ = shiftedCappedTerminalPositiveProfile n c (r, v) := by
      rw [shiftedCappedTerminalNegativeProfile_eq_zero_of_neg_five_eighth_le n c r hc
        (le_of_lt hv)]
      ring

/-- Reflection selects the prepared terminal negative lobe in standard
positive outer coordinates. -/
theorem shiftedCappedTelescopingCutoffProfile_terminal_reflectedNegative_eventuallyEq
    {eps c r : Real} (K n : Nat) (hc : c ∈ Icc (1 / 2 : Real) 1)
    (hcdef : c = ((2 : Real) ^ K * eps) / (Real.pi / 2))
    (hr : r = (4 / 5 : Real) * (Real.pi / 2))
    {u : Real} (hu : u ∈ Icc (1 / 2 : Real) 2) :
    (fun v : Real => shiftedCappedTelescopingCutoffProfile eps K n (K + 1)
      (stationaryShift n - r * v)) =ᶠ[nhds u]
      fun v : Real => shiftedCappedTerminalReflectedNegativeProfile n c (r, v) := by
  have hnear : Ioi (-(5 / 8 : Real)) ∈ nhds u :=
    Ioi_mem_nhds (by linarith [hu.1])
  filter_upwards [hnear] with v hv
  calc
    shiftedCappedTelescopingCutoffProfile eps K n (K + 1)
        (stationaryShift n - r * v) =
      shiftedCappedTelescopingCutoff eps K n (K + 1) 0
        (stationaryShift n - r * v) := by
          simpa using (shiftedCappedTelescopingCutoff_eq_profile eps K n (K + 1) 0
            (stationaryShift n - r * v)).symm
    _ = shiftedCappedTerminalPositiveProfile n c (r, -v) +
        shiftedCappedTerminalNegativeProfile n c (r, -v) := by
      have hsplit := shiftedCappedTelescopingCutoff_terminal_local_eq_lobes
        K n 0 (-v) hc hcdef hr
      convert hsplit using 1; ring
    _ = shiftedCappedTerminalNegativeProfile n c (r, -v) := by
      rw [shiftedCappedTerminalPositiveProfile_reflect_eq_zero_of_neg_five_eighth_le n c r hc
        (le_of_lt hv)]
      ring
    _ = shiftedCappedTerminalReflectedNegativeProfile n c (r, v) :=
      shiftedCappedTerminalNegativeProfile_reflect n c r v

/-- Fully normalized reflected dyadic `E₁` identity on the standard outer
interval.  Its cutoff term has the literal `(-r)⁻¹` scale and its phase term
has the literal harmless `+I` Fourier sign. -/
