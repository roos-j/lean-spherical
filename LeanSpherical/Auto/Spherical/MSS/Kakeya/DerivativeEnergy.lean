/-- A pointwise support statement for a local profile differentiates to the
same pointwise support statement for its second-coordinate derivative. -/
theorem deriv_slice_eq_zero_of_not_mem_Icc
    (g : Real × Real -> Real) (rho u : Real)
    (hsupport : ∀ v : Real, v ∉ Icc (1 / 2 : Real) 2 -> g (rho, v) = 0)
    (hu : u ∉ Icc (1 / 2 : Real) 2) :
    deriv (fun v : Real => g (rho, v)) u = 0 := by
  by_cases hleft : u < 1 / 2
  · have hlocal : (fun v : Real => g (rho, v)) =ᶠ[nhds u] 0 := by
      filter_upwards [Iio_mem_nhds hleft] with v hv
      change v < 1 / 2 at hv
      exact hsupport v (by
        intro hmem
        exact (not_le_of_gt hv) hmem.1)
    simpa using hlocal.deriv.self_of_nhds
  · have hright : 2 < u := by
      by_contra hnot
      apply hu
      constructor
      · exact le_of_not_gt hleft
      · exact le_of_not_gt hnot
    have hlocal : (fun v : Real => g (rho, v)) =ᶠ[nhds u] 0 := by
      filter_upwards [Ioi_mem_nhds hright] with v hv
      change 2 < v at hv
      exact hsupport v (by
        intro hmem
        exact (not_le_of_gt hv) hmem.2)
    simpa using hlocal.deriv.self_of_nhds

