    (s : Finset iota) (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (n : Nat) (r : Real)
    (xi : Euclidean 2) (u : Real) (hu : u ∉ Icc (1 / 2 : Real) 2) :
