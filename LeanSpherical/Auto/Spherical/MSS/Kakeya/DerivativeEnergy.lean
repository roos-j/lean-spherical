      (shiftedCappedTerminalPositiveCutoffDerivativeProfile n ratio)
      (shiftedCappedTerminalReflectedNegativeCutoffDerivativeProfile n ratio)
      (shiftedCappedTerminalPositiveScaledPhaseProfile n ratio)
