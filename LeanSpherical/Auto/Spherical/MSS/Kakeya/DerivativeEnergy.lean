theorem shellFrequencyEnergy_shiftedCharted_central_le_parametric
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex)
    {eps : Real} (heps : 0 < eps) (K n : Nat) (lo hi : Real) (xi : Euclidean 2)
    (hpolar : xi = ‖xi‖ • circleDirection (C.angle j xi)) (hn : n < 7) :
    shellFrequencyEnergy
      (shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n 0)
      lo hi xi ≤
      centralParametricFiberEnergy (shiftedCentralParametricProfile n) (4 * eps)
        (stationaryRadialSign n * ‖xi‖)
        (scratch_finiteTensorTimeData s (chartProfiles C j q) a xi) := by
  let c : Real := C.angle j xi + stationaryShift n
  let M : Real → Complex := fun theta =>
    scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
      (chartProfiles_compact C j q hqcompact) a (circleDirection theta) xi
  let H : Real → Complex := scratch_finiteTensorTimeData s (chartProfiles C j q) a xi
  have hr : 0 < 4 * eps := by positivity
  have hMcont : Continuous M := by
    let F : Real × Euclidean 2 → Complex := fun p =>
      scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
        (chartProfiles_compact C j q hqcompact) a (circleDirection p.1) p.2
    have hF : Continuous F :=
      continuous_uncurry_scratch_finiteTensorTubeMultiplier_circle
        s (chartProfiles C j q) (chartProfiles_compact C j q hqcompact) a
    have hmap : Continuous (fun theta : Real => (theta, xi)) :=
      continuous_id.prodMk continuous_const
    change Continuous (fun theta : Real => F (theta, xi))
    exact (hF.comp hmap).congr (by intro theta; rfl)
  have hraw (theta : Real) :
      shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n 0 theta xi =
        (shiftedCentralParametricProfile n
          (4 * eps, (theta - c) / (4 * eps)) : Complex) * M theta := by
    unfold shiftedChartedCappedTelescopingMultiplier
    rw [shiftedCappedTelescopingCutoff_eq_profile]
    have htheta : theta - C.angle j xi =
        stationaryShift n + (4 * eps) * ((theta - c) / (4 * eps)) := by
      dsimp only [c]
      field_simp [ne_of_gt heps]
      ring
    rw [htheta, shiftedCappedTelescopingCutoffProfile_central_rescaled_eq
      (ne_of_gt heps) K n]
    rfl
  have hanalysis (u : Real) :
      (shiftedCentralParametricProfile n (4 * eps, u) : Complex) *
          M (c + (4 * eps) * u) =
        ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
            (shiftedCentralParametricProfile n) (4 * eps)
            (stationaryRadialSign n * ‖xi‖)) H u := by
    have hlocal :
        shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n 0
          (C.angle j xi + stationaryShift n + (4 * eps) * u) xi =
          (shiftedCentralParametricProfile n (4 * eps, u) : Complex) *
            M (c + (4 * eps) * u) := by
      unfold shiftedChartedCappedTelescopingMultiplier
      rw [shiftedCappedTelescopingCutoff_eq_profile]
      rw [show C.angle j xi + stationaryShift n + (4 * eps) * u - C.angle j xi =
          stationaryShift n + (4 * eps) * u by ring]
      rw [shiftedCappedTelescopingCutoffProfile_central_rescaled_eq
        (ne_of_gt heps) K n]
      congr 1
    calc
      (shiftedCentralParametricProfile n (4 * eps, u) : Complex) *
          M (c + (4 * eps) * u) =
        shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n 0
          (C.angle j xi + stationaryShift n + (4 * eps) * u) xi := hlocal.symm
      _ = ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
            (shiftedCentralParametricProfile n) (4 * eps)
            (stationaryRadialSign n * ‖xi‖)) H u := by
          simpa only [H] using
            (shiftedCharted_centralMultiplier_eq_parametricAnalysis
              C j s q hqcompact a (ne_of_gt heps) K n xi hpolar hn u)
  exact shellFrequencyEnergy_affine_central_le_parametric
    (shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n 0 · xi)
    M H (shiftedCentralParametricProfile n) (4 * eps) c lo hi
    (stationaryRadialSign n * ‖xi‖) xi hr hMcont
    (contDiff_shiftedCentralParametricProfile n).continuous
    (shiftedCentralParametricProfile_eq_zero_of_not_mem_Icc n (4 * eps))
    hraw hanalysis

/-- Any literal central-coordinate profile can be transported through the
same charted phase bridge.  This is used separately for the cutoff and
scaled-phase E1 profiles. -/
theorem shellFrequencyEnergy_shiftedCharted_central_profile_component_le_parametric
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex)
    (g : Real × Real → Real) {eps : Real} (heps : 0 < eps)
    (n : Nat) (lo hi : Real) (xi : Euclidean 2)
    (hpolar : xi = ‖xi‖ • circleDirection (C.angle j xi)) (hn : n < 7)
    (hgcont : Continuous g)
    (hzero : ∀ u, u ∉ Icc (-(1 / 2 : Real)) (1 / 2 : Real) →
      g (4 * eps, u) = 0) :
    shellFrequencyEnergy (fun theta _ =>
      (g (4 * eps,
        (theta - (C.angle j xi + stationaryShift n)) / (4 * eps)) : Complex) *
        scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
          (chartProfiles_compact C j q hqcompact) a (circleDirection theta) xi)
      lo hi xi ≤
      centralParametricFiberEnergy g (4 * eps) (stationaryRadialSign n * ‖xi‖)
        (scratch_finiteTensorTimeData s (chartProfiles C j q) a xi) := by
  let c : Real := C.angle j xi + stationaryShift n
  let M : Real → Complex := fun theta =>
    scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
      (chartProfiles_compact C j q hqcompact) a (circleDirection theta) xi
  let H : Real → Complex := scratch_finiteTensorTimeData s (chartProfiles C j q) a xi
  have hr : 0 < 4 * eps := by positivity
  have hMcont : Continuous M := by
    let F : Real × Euclidean 2 → Complex := fun p =>
      scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
        (chartProfiles_compact C j q hqcompact) a (circleDirection p.1) p.2
    have hF : Continuous F :=
      continuous_uncurry_scratch_finiteTensorTubeMultiplier_circle
        s (chartProfiles C j q) (chartProfiles_compact C j q hqcompact) a
    have hmap : Continuous (fun theta : Real => (theta, xi)) :=
      continuous_id.prodMk continuous_const
    change Continuous (fun theta : Real => F (theta, xi))
    exact (hF.comp hmap).congr (by intro theta; rfl)
  have hanalysis (u : Real) :
      (g (4 * eps, u) : Complex) * M (c + (4 * eps) * u) =
        ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g (4 * eps)
            (stationaryRadialSign n * ‖xi‖)) H u := by
    simpa only [c, M, H] using
      (shiftedCharted_lobeMultiplier_eq_parametricAnalysis
        C j s q hqcompact a xi (C.angle j xi) hpolar n hn g (4 * eps) u)
  have htransport := shellFrequencyEnergy_affine_central_le_parametric
    (fun theta => (g (4 * eps, (theta - c) / (4 * eps)) : Complex) * M theta)
    M H g (4 * eps) c lo hi (stationaryRadialSign n * ‖xi‖) xi hr hMcont hgcont hzero
    (by intro theta; rfl) hanalysis
  simpa only [c, M] using htransport

/-- Direct `i = 0` derivative wrapper: the raw angular derivative is exactly
the central cutoff-coordinate term plus the time-weighted phase term. -/
theorem shiftedCharted_centralMultiplierDerivRaw_eq_twoParametricAnalyses
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex)
    {eps : Real} (heps : 0 < eps) (K n : Nat) (xi : Euclidean 2)
    (hpolar : xi = ‖xi‖ • circleDirection (C.angle j xi)) (hn : n < 7) (u : Real) :
    shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n 0
      (C.angle j xi + stationaryShift n + (4 * eps) * u) xi =
      (((4 * eps)⁻¹ : Real) : Complex) *
        ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
            (shiftedCentralParametricCutoffDerivativeProfile n) (4 * eps)
            (stationaryRadialSign n * ‖xi‖))
          (scratch_finiteTensorTimeData s (chartProfiles C j q) a xi) u +
      (-Complex.I) *
        (((2 * Real.pi) * (stationaryRadialSign n * ‖xi‖) * (4 * eps) : Real) : Complex) *
        ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
            (shiftedCentralParametricScaledPhaseProfile n) (4 * eps)
            (stationaryRadialSign n * ‖xi‖))
          (timeWeighted (scratch_finiteTensorTimeData s (chartProfiles C j q) a xi)) u := by
  apply shiftedChartedCappedTelescopingMultiplierDerivRaw_positive_E1_of_profile
    C j s q hqcompact a eps K n 0
    (shiftedCentralParametricProfile n)
    (shiftedCentralParametricCutoffDerivativeProfile n)
    (shiftedCentralParametricScaledPhaseProfile n)
    (r := 4 * eps) (ne_of_gt (by positivity : 0 < 4 * eps)) xi hpolar hn u
  · filter_upwards with v
    exact shiftedCappedTelescopingCutoffProfile_central_rescaled_eq
      (ne_of_gt heps) K n v
  · exact deriv_slice_shiftedCentralParametricProfile_eq_cutoffDerivative n (4 * eps) u
  · rfl

/-- Global affine form of the central product rule.  Keeping the phase term
as the literal angular derivative is useful for the physical-energy change
of-variables; the preceding theorem subsequently identifies it with the
scaled-phase analysis. -/
theorem shiftedCharted_centralMultiplierDerivRaw_eq_affine_twoTerms
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex)
    {eps : Real} (heps : 0 < eps) (K n : Nat) (xi : Euclidean 2)
    (_hpolar : xi = ‖xi‖ • circleDirection (C.angle j xi)) (_hn : n < 7)
    (theta : Real) :
    shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n 0
      theta xi =
      (((4 * eps)⁻¹ : Real) : Complex) *
        ((shiftedCentralParametricCutoffDerivativeProfile n
          (4 * eps, (theta - (C.angle j xi + stationaryShift n)) / (4 * eps)) : Real) : Complex) *
        scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
          (chartProfiles_compact C j q hqcompact) a (circleDirection theta) xi +
      (shiftedCentralParametricProfile n
        (4 * eps, (theta - (C.angle j xi + stationaryShift n)) / (4 * eps)) : Complex) *
        finiteTensorTubeMultiplierAngularDeriv s (chartProfiles C j q) a theta xi := by
  let c : Real := C.angle j xi + stationaryShift n
  let u : Real := (theta - c) / (4 * eps)
  have hr : 0 < 4 * eps := by positivity
  have htheta : theta = C.angle j xi + stationaryShift n + (4 * eps) * u := by
    dsimp only [u, c]
    field_simp [ne_of_gt hr]
    ring
  calc
    shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n 0
        theta xi =
      shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n 0
        (C.angle j xi + stationaryShift n + (4 * eps) * u) xi := by rw [← htheta]
    _ = (((4 * eps)⁻¹ : Real) : Complex) *
        ((deriv (fun v : Real => shiftedCentralParametricProfile n (4 * eps, v)) u : Real) :
            Complex) *
        scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
          (chartProfiles_compact C j q hqcompact) a
          (circleDirection (C.angle j xi + stationaryShift n + (4 * eps) * u)) xi +
        (shiftedCentralParametricProfile n (4 * eps, u) : Complex) *
          finiteTensorTubeMultiplierAngularDeriv s (chartProfiles C j q) a
            (C.angle j xi + stationaryShift n + (4 * eps) * u) xi := by
      apply shiftedChartedCappedTelescopingMultiplierDerivRaw_local_of_profile
        C j s q hqcompact a eps K n 0 (shiftedCentralParametricProfile n)
        (r := 4 * eps) (ne_of_gt hr) u xi
      filter_upwards with v
      exact shiftedCappedTelescopingCutoffProfile_central_rescaled_eq
        (ne_of_gt heps) K n v
    _ = (((4 * eps)⁻¹ : Real) : Complex) *
        ((shiftedCentralParametricCutoffDerivativeProfile n (4 * eps, u) : Real) : Complex) *
        scratch_finiteTensorTubeMultiplier s (chartProfiles C j q)
          (chartProfiles_compact C j q hqcompact) a
          (circleDirection (C.angle j xi + stationaryShift n + (4 * eps) * u)) xi +
        (shiftedCentralParametricProfile n (4 * eps, u) : Complex) *
          finiteTensorTubeMultiplierAngularDeriv s (chartProfiles C j q) a
            (C.angle j xi + stationaryShift n + (4 * eps) * u) xi := by
      rw [deriv_slice_shiftedCentralParametricProfile_eq_cutoffDerivative]
    _ = _ := by
      dsimp only [u, c]
      rw [htheta]
      field_simp [ne_of_gt hr]
      ring

/-- The literal physical phase component transports to the scaled-phase
central energy, with exactly the squared Fourier-derivative scalar. -/
theorem shellFrequencyEnergy_shiftedCharted_central_phase_component_le_parametric
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex)
    {eps : Real} (heps : 0 < eps) (n : Nat) (lo hi : Real) (xi : Euclidean 2)
    (hpolar : xi = ‖xi‖ • circleDirection (C.angle j xi)) (hn : n < 7) :
    shellFrequencyEnergy (fun theta _ =>
      (shiftedCentralParametricProfile n
        (4 * eps, (theta - (C.angle j xi + stationaryShift n)) / (4 * eps)) : Complex) *
      finiteTensorTubeMultiplierAngularDeriv s (chartProfiles C j q) a theta xi)
      lo hi xi ≤
      ((2 * Real.pi) * (stationaryRadialSign n * ‖xi‖) * (4 * eps)) ^ (2 : Nat) *
        centralParametricFiberEnergy (shiftedCentralParametricScaledPhaseProfile n)
          (4 * eps) (stationaryRadialSign n * ‖xi‖)
          (timeWeighted (scratch_finiteTensorTimeData s (chartProfiles C j q) a xi)) := by
  let c : Real := C.angle j xi + stationaryShift n
  let M : Real → Complex := fun theta =>
    finiteTensorTubeMultiplierAngularDeriv s (chartProfiles C j q) a theta xi
  let H : Real → Complex := scratch_finiteTensorTimeData s (chartProfiles C j q) a xi
  let A := ttstarAnalysis volume
    (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
      (shiftedCentralParametricScaledPhaseProfile n) (4 * eps)
      (stationaryRadialSign n * ‖xi‖)) (timeWeighted H)
  let sigma : Real := (2 * Real.pi) * (stationaryRadialSign n * ‖xi‖) * (4 * eps)
  have hr : 0 < 4 * eps := by positivity
  have hMcont : Continuous M := by
    let F : Real × Euclidean 2 → Complex := fun p =>
      finiteTensorTubeMultiplierAngularDeriv s (chartProfiles C j q) a p.1 p.2
    have hF : Continuous F :=
      continuous_uncurry_finiteTensorTubeMultiplierAngularDeriv s (chartProfiles C j q) a
    have hmap : Continuous (fun theta : Real => (theta, xi)) :=
      continuous_id.prodMk continuous_const
    change Continuous (fun theta : Real => F (theta, xi))
    exact (hF.comp hmap).congr (by intro theta; rfl)
  have hzero : ∀ u, u ∉ Icc (-(1 / 2 : Real)) (1 / 2 : Real) →
      shiftedCentralParametricProfile n (4 * eps, u) = 0 :=
    shiftedCentralParametricProfile_eq_zero_of_not_mem_Icc n (4 * eps)
  have hFint := integrable_norm_sq_affine_central
    (shiftedCentralParametricProfile n) M (4 * eps) c hr
    (contDiff_shiftedCentralParametricProfile n).continuous hMcont hzero
  have htransport := integral_norm_sq_affine_central_restrict_le
    (shiftedCentralParametricProfile n) M (4 * eps) c lo hi hr hzero hFint
  have hphase (u : Real) :
      (shiftedCentralParametricProfile n (4 * eps, u) : Complex) *
        M (c + (4 * eps) * u) = (-Complex.I) * (sigma : Complex) * A u := by
    dsimp only [M, c, sigma, A, H]
    rw [← show (fun p : Real × Real =>
      shiftedCentralParametricProfile n p * outerCircleScaledDerivative p.1 p.2) =
        shiftedCentralParametricScaledPhaseProfile n by rfl]
    exact shiftedCharted_lobeAngularDeriv_eq_scaledPhaseAnalysis_positive
      C j s q hqcompact a xi (C.angle j xi) hpolar n hn
      (shiftedCentralParametricProfile n) (ne_of_gt hr) u
  have hnorm (u : Real) :
      ‖(shiftedCentralParametricProfile n (4 * eps, u) : Complex) *
        M (c + (4 * eps) * u)‖ ^ (2 : Nat) =
        sigma ^ (2 : Nat) * ‖A u‖ ^ (2 : Nat) := by
    rw [hphase, norm_mul, norm_mul, norm_neg, Complex.norm_I, one_mul,
      Complex.norm_real, Real.norm_eq_abs, mul_pow, sq_abs]
  unfold shellFrequencyEnergy
  change (∫ theta : Real,
      ‖(shiftedCentralParametricProfile n
        (4 * eps, (theta - c) / (4 * eps)) : Complex) * M theta‖ ^ (2 : Nat)
        ∂(volume.restrict (Icc lo hi))) ≤ _
  calc
    (∫ theta : Real,
      ‖(shiftedCentralParametricProfile n
        (4 * eps, (theta - c) / (4 * eps)) : Complex) * M theta‖ ^ (2 : Nat)
        ∂(volume.restrict (Icc lo hi))) ≤
      (4 * eps) * ∫ u : Real,
        ‖(shiftedCentralParametricProfile n (4 * eps, u) : Complex) *
          M (c + (4 * eps) * u)‖ ^ (2 : Nat)
          ∂centralParametricAngleMeasure := htransport
    _ = sigma ^ (2 : Nat) *
        centralParametricFiberEnergy (shiftedCentralParametricScaledPhaseProfile n)
          (4 * eps) (stationaryRadialSign n * ‖xi‖) (timeWeighted H) := by
      unfold centralParametricFiberEnergy
      rw [show (fun u : Real =>
        ‖(shiftedCentralParametricProfile n (4 * eps, u) : Complex) *
          M (c + (4 * eps) * u)‖ ^ (2 : Nat)) =
        fun u : Real => sigma ^ (2 : Nat) * ‖A u‖ ^ (2 : Nat) by
          funext u
          exact hnorm u]
      rw [integral_const_mul]
      dsimp only [A]
      ring

