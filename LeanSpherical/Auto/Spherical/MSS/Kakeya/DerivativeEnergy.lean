      hrhoMax hrhoMax_small
      (shiftedCappedTerminalReflectedNegativeScaledPhaseProfile n ratio)
      (hasJointSndSmooth_shiftedCappedTerminalReflectedNegativeScaledPhaseProfile n ratio 0)
      (hasJointSndSmooth_shiftedCappedTerminalReflectedNegativeScaledPhaseProfile n ratio 2)
