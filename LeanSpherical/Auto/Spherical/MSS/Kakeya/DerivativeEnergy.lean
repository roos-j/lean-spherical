/-- The bounded-ratio terminal cap has the same completely concrete annular
fibre witness.  In particular the cap is not left as an abstract final-shell
premise. -/
theorem exists_concreteAnnularShellFiberEnergyWitness_shifted_terminal
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) (n : Nat)
