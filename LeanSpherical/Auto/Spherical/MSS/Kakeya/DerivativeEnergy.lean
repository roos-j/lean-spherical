    have hnonneg : 0 ≤ (fixedCentralCircleUnitShellBump u : Real) :=
      fixedCentralCircleUnitShellBump.nonneg
    have hle : (fixedCentralCircleUnitShellBump u : Real) ≤ 1 :=
      fixedCentralCircleUnitShellBump.le_one
