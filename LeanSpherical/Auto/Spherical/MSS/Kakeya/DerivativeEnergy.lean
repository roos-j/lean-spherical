    ∃ B : Real, 0 < B ∧
      ∀ {kappa : Type uK} {iota : Type uI}
        {charts : Finset kappa} {active : Set (Euclidean 2)}
        (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
        (_hj : j ∈ charts) (s : Finset iota)
        (q : iota → SchwartzMap (Euclidean 2) Complex)
        (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
        (a : iota → SchwartzMap Real Complex)
        {eps r lambda : Real} (_hlambda : 0 < lambda)
        (K : Nat) (lo hi : Real)
        (_hqann : ∀ l, Function.support (q l : Euclidean 2 → Complex) ⊆
          scaledDyadicFrequencyAnnulus lambda)
        (_hn : n < 7)
        (_hratioDef : ratio = ((2 : Real) ^ K * eps) / (Real.pi / 2))
        (_hr : r = (4 / 5 : Real) * (Real.pi / 2))
        (_hrmem : r ∈ Ioc (0 : Real) rhoMax)
        (_houter : ∀ xi, xi ∈ scaledDyadicFrequencyAnnulus lambda →
          1 ≤ ‖xi‖ * r ^ 2)
        {rTime : Real} (_hrTime : rTime < 1)
        (_hsupport : ∀ l, Function.support (a l : Real → Complex) ⊆
          closedBall (3 / 2 : Real) rTime),
      ∃ W : AnnularShellFiberEnergyWitness C j s q hqcompact a eps K n (K + 1)
        lo hi lambda r B
        (shiftedChartedCappedTelescopingSchwartzSlices_concrete
          C j s q hqcompact a eps K n (K + 1) lo hi),
        ∀ xi, W.h xi = shiftedFiberSourceEnergy s (chartProfiles C j q) a xi := by
  rcases nonempty_shiftedCappedTerminalFiberLobeEnergyBounds.{uI}
      hrhoMax hrhoMax_small n hratio with ⟨D⟩
  rcases exists_shellFrequencyEnergy_shiftedCharted_terminal_deriv_le_source_of_sectorCases
      hrhoMax hrhoMax_small n hratio with ⟨B1, hB1, hE1⟩
  let B0 : Real := 2 * (D.B0plus + D.B0minus)
  let B : Real := B0 + B1 + 1
  have hB0 : 0 ≤ B0 := by
    dsimp only [B0]
    exact mul_nonneg (by norm_num)
      (add_nonneg D.e0plus.1.le D.e0minus.1.le)
  have hB : 0 < B := by
    dsimp only [B]
    linarith
  refine ⟨B, hB, ?_⟩
  intro kappa iota charts active C j hj s q hqcompact a eps r lambda hlambda K lo hi
    hqann hn hratioDef hr hrmem houter rTime hrTime htime
