    simp only [show (fun k => ‖intDyadicBandpassMultiplier C.cutoff k ξ‖ ^ (2 : Nat)) =
        fun k => ‖q k‖ ^ (2 : Nat) by rfl]
    simp [hqzero]
  have hξpos : 0 < ‖ξ‖ := norm_pos_iff.mpr hξ0
  obtain ⟨n, hnlo, hnhi⟩ :=
    exists_mem_Ico_zpow (x := ‖ξ‖) (y := (2 : Real)) hξpos (by norm_num)
  have hScard : S.card ≤ 2 := by
    have hSrange : S ⊆ Finset.Icc (n - 1) n := by
      intro k hk
      have hkS : k ∈ S := hk
      have hq : q k ≠ 0 := (Finset.mem_filter.mp hkS).2
      have hsupp := intDyadicBandpass_norm_bounds_of_ne_zero C
        (by simpa only [q] using hq)
      have hleftpow : (2 : Real) ^ k < (2 : Real) ^ (n + 1) :=
        lt_of_lt_of_le hsupp.1 hnhi.le
      have hrightpow : (2 : Real) ^ n < (2 : Real) ^ (k + 2) :=
        lt_of_le_of_lt hnlo hsupp.2
      have hleft : k < n + 1 := by
        rw [zpow_lt_zpow_iff_right₀ (by norm_num : (1 : Real) < 2)] at hleftpow
        exact hleftpow
      have hright : n < k + 2 := by
        rw [zpow_lt_zpow_iff_right₀ (by norm_num : (1 : Real) < 2)] at hrightpow
        exact hrightpow
      exact Finset.mem_Icc.mpr (by omega)
    calc
      S.card ≤ (Finset.Icc (n - 1) n).card := Finset.card_le_card hSrange
      _ = 2 := by
        rw [Int.card_Icc]
        have hcard : n + 1 - (n - 1) = 2 := by omega
        rw [hcard]
        rfl
  have hterm : ∀ k ∈ S, ‖q k‖ ^ (2 : Nat) ≤ (4 : Real) := by
    intro k hk
    have hqnorm : ‖q k‖ ≤ 2 := by
      dsimp [q]
      exact norm_intDyadicBandpassMultiplier_le_two C k ξ
    nlinarith [norm_nonneg (q k)]
  calc
    ∑ k ∈ K, ‖intDyadicBandpassMultiplier C.cutoff k ξ‖ ^ (2 : Nat) =
        ∑ k ∈ K, ‖q k‖ ^ (2 : Nat) := by rfl
    _ = ∑ k ∈ S, ‖q k‖ ^ (2 : Nat) := hsum
    _ ≤ S.card • (4 : Real) := Finset.sum_le_card_nsmul S _ 4 hterm
    _ ≤ 2 • (4 : Real) := by gcongr
    _ = 8 := by norm_num

/-- The finite homogeneous `L²` Littlewood--Paley square-function estimate.
Its constant is independent of the finite set of integer dyadic indices. -/
theorem integerLittlewoodPaleyL2 {d : Nat} (C : lpCutoffs d)
    (K : Finset Int) (f : SchwartzMap (Euclidean d) Complex) :
    (∑ k ∈ K, ∫ x : Euclidean d,
      ‖𝓕⁻ (fun ξ : Euclidean d =>
        intDyadicBandpassMultiplier C.cutoff k ξ *
          𝓕 (f : Euclidean d → Complex) ξ) x‖ ^ (2 : Nat)) ≤
      8 * ∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat) := by
  exact sum_integral_norm_sq_fourierInv_schwartz_multipliers_le K
    (intDyadicBandpassMultiplier C.cutoff) f
    (intDyadicBandpass_square_overlap C K)

/-- The shifted, fat Littlewood--Paley multiplier used when a physical radius
is restricted to a dyadic block. -/
def shiftedFatMultiplier {d : Nat} (χ : SchwartzMap (Euclidean d) Complex)
    (j : Nat) (k : Int) : SchwartzMap (Euclidean d) Complex :=
  intDyadicLowpassMultiplier χ ((j : Int) + 3 - k) -
    intDyadicLowpassMultiplier χ ((j : Int) - 2 - k)

/-- Literal formula for a shifted fat multiplier. -/
theorem shiftedFatMultiplier_apply {d : Nat}
    (χ : SchwartzMap (Euclidean d) Complex) (j : Nat) (k : Int) (ξ : Euclidean d) :
    shiftedFatMultiplier χ j k ξ =
      χ (((2 : Real) ^ ((j : Int) + 3 - k))⁻¹ • ξ) -
      χ (((2 : Real) ^ ((j : Int) - 2 - k))⁻¹ • ξ) := by
  simp [shiftedFatMultiplier, intDyadicLowpassMultiplier_apply]

/-- The absolute fat annular cutoff at the `j`th dyadic frequency scale.
It is the `k = 0` member of the shifted-fat family and is identically one on
the support of the ordinary `j`th band-pass multiplier. -/
def fatDyadicBandpassMultiplier {d : Nat} (C : lpCutoffs d)
    (j : Nat) : SchwartzMap (Euclidean d) Complex :=
  shiftedFatMultiplier C.cutoff j 0

/-- The fat annular cutoff is literally the zero-shift member of the
existing shifted-fat family. -/
theorem fatDyadicBandpassMultiplier_eq_shiftedFatMultiplier {d : Nat}
    (C : lpCutoffs d) (j : Nat) :
    fatDyadicBandpassMultiplier C j = shiftedFatMultiplier C.cutoff j 0 := rfl

/-- Inserting the fat annular cutoff leaves the ordinary dyadic band-pass
multiplier unchanged.  This is the absolute-frequency specialization of the
relative cutoff identity at radius one. -/
theorem dyadicBandpassMultiplier_mul_fatDyadicBandpassMultiplier {d : Nat}
    (C : lpCutoffs d) (j : Nat) (ξ : Euclidean d) :
    dyadicBandpassMultiplier C.cutoff j ξ * fatDyadicBandpassMultiplier C j ξ =
      dyadicBandpassMultiplier C.cutoff j ξ := by
  have hunit : (1 : Real) ∈ Set.Icc ((2 : Real) ^ (0 : Int))
      ((2 : Real) ^ ((0 : Int) + 1)) := by
    norm_num
  have h := relative_dyadic_bandpass_mul_fat_cutoff
    (phi := C.cutoff) C.cutoff_one C.cutoff_zero (j := j) (k := (0 : Int))
    (r := (1 : Real)) hunit ξ (1 : Complex) (fun _ : Euclidean d => (1 : Complex))
  simpa [fatDyadicBandpassMultiplier, shiftedFatMultiplier, intDyadicLowpassMultiplier_apply,
    dyadicBandpassMultiplier_apply] using h.symm

/-- The shifted fat dyadic family has uniform finite square overlap. -/
theorem shiftedFatMultiplier_square_overlap {d : Nat} (C : lpCutoffs d)
    (j : Nat) (K : Finset Int) (ξ : Euclidean d) :
    ∑ k ∈ K, ‖shiftedFatMultiplier C.cutoff j k ξ‖ ^ (2 : Nat) ≤ 24 := by
  simpa only [shiftedFatMultiplier_apply] using
    (finite_relative_dyadic_fat_cutoff_square_sum_le C.cutoff_one C.cutoff_zero
      C.norm_le_one j K ξ)

/-- The uniformly bounded finite `L²` Littlewood--Paley square function for
the shifted fat dyadic families that occur after radius-block localization. -/
theorem shiftedLittlewoodPaleyL2 {d : Nat} (C : lpCutoffs d)
    (j : Nat) (K : Finset Int) (f : SchwartzMap (Euclidean d) Complex) :
    (∑ k ∈ K, ∫ x : Euclidean d,
      ‖𝓕⁻ (fun ξ : Euclidean d =>
        shiftedFatMultiplier C.cutoff j k ξ * 𝓕 (f : Euclidean d → Complex) ξ) x‖ ^
          (2 : Nat)) ≤
      24 * ∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat) := by
  exact sum_integral_norm_sq_fourierInv_schwartz_multipliers_le K
    (shiftedFatMultiplier C.cutoff j) f
    (shiftedFatMultiplier_square_overlap C j K)

/-! ### Finite fourth-moment square functions

The full Littlewood--Paley theorem needs a vector-valued singular-integral
argument.  Before that endpoint is available, the elementary finite
fourth-moment estimate below is still useful: it separates the finite
square-function algebra from the analytic bounds for its individual pieces.
-/

/-- The squared finite square function of a complex-valued family. -/
def finiteSquareEnergy {I X : Type*} (s : Finset I)
    (g : I → X → Complex) (x : X) : Real :=
  ∑ i ∈ s, ‖g i x‖ ^ (2 : Nat)

/-- Finite Cauchy--Schwarz at the fourth moment. -/
theorem finiteSquareEnergy_sq_le_card_mul_sum_norm_four
    {I X : Type*} (s : Finset I) (g : I → X → Complex) (x : X) :
    finiteSquareEnergy s g x ^ (2 : Nat) ≤
      (s.card : Real) * ∑ i ∈ s, ‖g i x‖ ^ (4 : Nat) := by
  calc
    finiteSquareEnergy s g x ^ (2 : Nat) =
        (∑ i ∈ s, ‖g i x‖ ^ (2 : Nat)) ^ (2 : Nat) := rfl
    _ ≤ (s.card : Real) * ∑ i ∈ s, (‖g i x‖ ^ (2 : Nat)) ^ (2 : Nat) :=
      sq_sum_le_card_mul_sum_sq
    _ = (s.card : Real) * ∑ i ∈ s, ‖g i x‖ ^ (4 : Nat) := by
      apply congrArg (fun z : Real => (s.card : Real) * z)
      apply Finset.sum_congr rfl
      intro i hi
      ring

/-- Integration of the finite fourth-moment square-function inequality. -/
theorem integral_finiteSquareEnergy_sq_le_card_mul_sum_norm_four
    {I X : Type*} [MeasurableSpace X] (μ : Measure X)
    (s : Finset I) (g : I → X → Complex)
    (hint : ∀ i ∈ s, Integrable (fun x => ‖g i x‖ ^ (4 : Nat)) μ) :
    (∫ x, finiteSquareEnergy s g x ^ (2 : Nat) ∂μ) ≤
      (s.card : Real) * ∑ i ∈ s, ∫ x, ‖g i x‖ ^ (4 : Nat) ∂μ := by
  have hsum : Integrable (fun x => ∑ i ∈ s, ‖g i x‖ ^ (4 : Nat)) μ :=
    integrable_finsetSum s hint
  have hright : Integrable (fun x =>
      (s.card : Real) * ∑ i ∈ s, ‖g i x‖ ^ (4 : Nat)) μ :=
    hsum.const_mul _
  calc
    (∫ x, finiteSquareEnergy s g x ^ (2 : Nat) ∂μ) ≤
        ∫ x, (s.card : Real) * ∑ i ∈ s, ‖g i x‖ ^ (4 : Nat) ∂μ := by
          apply integral_mono_of_nonneg
          · exact Filter.Eventually.of_forall fun x => sq_nonneg _
          · exact hright
          · exact Filter.Eventually.of_forall fun x =>
              finiteSquareEnergy_sq_le_card_mul_sum_norm_four s g x
    _ = (s.card : Real) * ∑ i ∈ s, ∫ x, ‖g i x‖ ^ (4 : Nat) ∂μ := by
      rw [integral_const_mul, MeasureTheory.integral_finsetSum s hint]

/-- The finite dyadic square energy associated with a Littlewood--Paley
cutoff. -/
def finiteDyadicSquareEnergy {d : Nat} (C : lpCutoffs d) (s : Finset Nat)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) : Real :=
  finiteSquareEnergy s (fun j => dyadicProjection C.cutoff j f) x

/-- The algebraic fourth-moment estimate for a finite dyadic square
function. -/
theorem finiteDyadicSquareEnergy_sq_le_card_mul_sum_norm_four
    {d : Nat} (C : lpCutoffs d) (s : Finset Nat)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    finiteDyadicSquareEnergy C s f x ^ (2 : Nat) ≤
      (s.card : Real) * ∑ j ∈ s, ‖dyadicProjection C.cutoff j f x‖ ^ (4 : Nat) :=
  finiteSquareEnergy_sq_le_card_mul_sum_norm_four s
    (fun j => dyadicProjection C.cutoff j f) x

/-- A finite fourth-moment Littlewood--Paley estimate follows from uniform
fourth-moment estimates for the individual projections.  Its finite-cardinality
loss is explicit, so no vector-valued multiplier theorem is hidden here. -/
theorem finiteLittlewoodPaleyL4_of_term_bounds
    {d : Nat} (C : lpCutoffs d) (s : Finset Nat)
    (f : SchwartzMap (Euclidean d) Complex) {B : Real}
    (hint : ∀ j ∈ s, Integrable
      (fun x => ‖dyadicProjection C.cutoff j f x‖ ^ (4 : Nat)) volume)
    (hterm : ∀ j ∈ s,
      (∫ x : Euclidean d, ‖dyadicProjection C.cutoff j f x‖ ^ (4 : Nat)) ≤
        B * ∫ x : Euclidean d, ‖f x‖ ^ (4 : Nat)) :
    (∫ x : Euclidean d, finiteDyadicSquareEnergy C s f x ^ (2 : Nat)) ≤
      ((s.card : Real) ^ (2 : Nat) * B) *
        ∫ x : Euclidean d, ‖f x‖ ^ (4 : Nat) := by
  have hcard : 0 ≤ (s.card : Real) := Nat.cast_nonneg _
  have hsum :
      (∑ j ∈ s, ∫ x : Euclidean d,
        ‖dyadicProjection C.cutoff j f x‖ ^ (4 : Nat)) ≤
        ∑ _j ∈ s, B * ∫ x : Euclidean d, ‖f x‖ ^ (4 : Nat) := by
    apply Finset.sum_le_sum
    intro j hj
    exact hterm j hj
  calc
    (∫ x : Euclidean d, finiteDyadicSquareEnergy C s f x ^ (2 : Nat)) ≤
        (s.card : Real) * ∑ j ∈ s, ∫ x : Euclidean d,
          ‖dyadicProjection C.cutoff j f x‖ ^ (4 : Nat) := by
            simpa only [finiteDyadicSquareEnergy] using
              integral_finiteSquareEnergy_sq_le_card_mul_sum_norm_four volume s
                (fun j => dyadicProjection C.cutoff j f) hint
    _ ≤ (s.card : Real) * ∑ _j ∈ s,
        B * ∫ x : Euclidean d, ‖f x‖ ^ (4 : Nat) := by
          exact mul_le_mul_of_nonneg_left hsum hcard
    _ = ((s.card : Real) ^ (2 : Nat) * B) *
        ∫ x : Euclidean d, ‖f x‖ ^ (4 : Nat) := by
      rw [Finset.sum_const, nsmul_eq_mul]
      ring

/-- The physical Schwartz-kernel constant controlling one dyadic
Littlewood--Paley band-pass projection. -/
def dyadicProjectionKernelConstant {d : Nat}
    (χ : SchwartzMap (Euclidean d) Complex) : Real :=
  2 * ((SchwartzMap.seminorm Complex 0 0
      (𝓕⁻ χ : SchwartzMap (Euclidean d) Complex) +
    SchwartzMap.seminorm Complex (d + 2) 0
      (𝓕⁻ χ : SchwartzMap (Euclidean d) Complex)) *
    (volume (Metric.ball (0 : Euclidean d) 1)).toReal *
    (2 : Real) ^ (2 * d))

/-- The physical dyadic band-pass kernel constant is nonnegative. -/
theorem dyadicProjectionKernelConstant_nonneg {d : Nat}
    (χ : SchwartzMap (Euclidean d) Complex) :
    0 ≤ dyadicProjectionKernelConstant χ := by
  dsimp [dyadicProjectionKernelConstant]
  positivity

/-- Every dyadic band-pass projection is uniformly pointwise controlled by
the dyadic Hardy--Littlewood maximal function.  This is a literal
physical-space estimate, not a vector-valued multiplier assertion. -/
theorem exists_dyadicProjection_majorant {d : Nat}
    (χ : SchwartzMap (Euclidean d) Complex) :
    ∃ K : Real, 0 < K ∧ ∀ (j : Nat)
      (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d),
        ‖dyadicProjection χ j f x‖ ≤
          K * dyadicBallMaximal d (f : Euclidean d → Complex) x := by
  let A : Real := dyadicProjectionKernelConstant χ
  let K : Real := 2 * A + 1
  have hA : 0 ≤ A := by
    dsimp [A]
    exact dyadicProjectionKernelConstant_nonneg χ
  have hK : 0 < K := by
    dsimp [K]
    linarith
  refine ⟨K, hK, ?_⟩
  intro j f x
  have hconv (m : Nat) :
      ‖((fun y : Euclidean d => ((2 : Real) ^ m) ^ d •
          (𝓕⁻ χ : SchwartzMap (Euclidean d) Complex)
            (((2 : Real) ^ m) • y))
        ⋆[ContinuousLinearMap.mul Complex Complex, volume]
          (f : Euclidean d → Complex)) x‖ ≤
        A * dyadicBallMaximal d (f : Euclidean d → Complex) x := by
    have h := norm_scaled_schwartz_convolution_le_dyadic_average_sup
      (𝓕⁻ χ : SchwartzMap (Euclidean d) Complex) f
      (r := ((2 : Real) ^ m)⁻¹) (inv_pos.mpr (by positivity)) x
    convert h using 1
    · simp only [inv_inv]
    · dsimp [A, dyadicProjectionKernelConstant, dyadicBallMaximal,
        dyadicBallMaximalRaw]
      ring
  have hphysical :
      dyadicProjection χ j f x =
        ((fun y : Euclidean d => ((2 : Real) ^ (j + 1)) ^ d •
          (𝓕⁻ χ : SchwartzMap (Euclidean d) Complex)
            (((2 : Real) ^ (j + 1)) • y))
          ⋆[ContinuousLinearMap.mul Complex Complex, volume]
            (f : Euclidean d → Complex)) x -
          ((fun y : Euclidean d => ((2 : Real) ^ j) ^ d •
            (𝓕⁻ χ : SchwartzMap (Euclidean d) Complex)
              (((2 : Real) ^ j) • y))
            ⋆[ContinuousLinearMap.mul Complex Complex, volume]
              (f : Euclidean d → Complex)) x := by
    unfold dyadicProjection
    simp_rw [dyadicBandpassMultiplier_apply]
    exact fourierInv_sub_scaled_schwartz_multiplier_eq_sub_convolution χ f
      (R := (2 : Real) ^ j) (S := (2 : Real) ^ (j + 1))
      (by positivity) (by positivity) x
  have hH : 0 ≤ dyadicBallMaximal d (f : Euclidean d → Complex) x :=
    ENNReal.toReal_nonneg
  calc
    ‖dyadicProjection χ j f x‖ =
        ‖((fun y : Euclidean d => ((2 : Real) ^ (j + 1)) ^ d •
          (𝓕⁻ χ : SchwartzMap (Euclidean d) Complex)
            (((2 : Real) ^ (j + 1)) • y))
          ⋆[ContinuousLinearMap.mul Complex Complex, volume]
            (f : Euclidean d → Complex)) x -
          ((fun y : Euclidean d => ((2 : Real) ^ j) ^ d •
            (𝓕⁻ χ : SchwartzMap (Euclidean d) Complex)
              (((2 : Real) ^ j) • y))
            ⋆[ContinuousLinearMap.mul Complex Complex, volume]
              (f : Euclidean d → Complex)) x‖ := congrArg norm hphysical
    _ ≤ ‖((fun y : Euclidean d => ((2 : Real) ^ (j + 1)) ^ d •
          (𝓕⁻ χ : SchwartzMap (Euclidean d) Complex)
            (((2 : Real) ^ (j + 1)) • y))
          ⋆[ContinuousLinearMap.mul Complex Complex, volume]
            (f : Euclidean d → Complex)) x‖ +
          ‖((fun y : Euclidean d => ((2 : Real) ^ j) ^ d •
            (𝓕⁻ χ : SchwartzMap (Euclidean d) Complex)
              (((2 : Real) ^ j) • y))
            ⋆[ContinuousLinearMap.mul Complex Complex, volume]
              (f : Euclidean d → Complex)) x‖ := norm_sub_le _ _
    _ ≤ A * dyadicBallMaximal d (f : Euclidean d → Complex) x +
          A * dyadicBallMaximal d (f : Euclidean d → Complex) x :=
      add_le_add (hconv (j + 1)) (hconv j)
    _ = (2 * A) * dyadicBallMaximal d (f : Euclidean d → Complex) x := by
      ring
    _ ≤ K * dyadicBallMaximal d (f : Euclidean d → Complex) x := by
      apply mul_le_mul_of_nonneg_right
      · dsimp [K]
        linarith
      · exact hH

/-- A common pointwise majorant for a finite family controls the fourth
moment of its square energy. -/
theorem finiteSquareEnergy_sq_le_card_sq_mul_of_majorant
    {I X : Type*} (s : Finset I) (g : I → X → Complex)
    (M : X → Real) (x : X) (hM : 0 ≤ M x)
    (hmajor : ∀ i ∈ s, ‖g i x‖ ≤ M x) :
    finiteSquareEnergy s g x ^ (2 : Nat) ≤
      (s.card : Real) ^ (2 : Nat) * M x ^ (4 : Nat) := by
  have henergy_nonneg : 0 ≤ finiteSquareEnergy s g x := by
    dsimp [finiteSquareEnergy]
    exact Finset.sum_nonneg fun i hi => sq_nonneg _
  have hupper_nonneg : 0 ≤ (s.card : Real) * M x ^ (2 : Nat) := by
    exact mul_nonneg (Nat.cast_nonneg _) (sq_nonneg _)
  have hterm (i : I) (hi : i ∈ s) :
      ‖g i x‖ ^ (2 : Nat) ≤ M x ^ (2 : Nat) :=
    (sq_le_sq₀ (norm_nonneg _) hM).mpr (hmajor i hi)
  have henergy :
      finiteSquareEnergy s g x ≤ (s.card : Real) * M x ^ (2 : Nat) := by
    calc
      finiteSquareEnergy s g x = ∑ i ∈ s, ‖g i x‖ ^ (2 : Nat) := rfl
      _ ≤ ∑ _i ∈ s, M x ^ (2 : Nat) := by
        apply Finset.sum_le_sum
        intro i hi
        exact hterm i hi
      _ = (s.card : Real) * M x ^ (2 : Nat) := by
        rw [Finset.sum_const, nsmul_eq_mul]
  calc
    finiteSquareEnergy s g x ^ (2 : Nat) ≤
        ((s.card : Real) * M x ^ (2 : Nat)) ^ (2 : Nat) :=
      (sq_le_sq₀ henergy_nonneg hupper_nonneg).mpr henergy
    _ = (s.card : Real) ^ (2 : Nat) * M x ^ (4 : Nat) := by
      ring

/-- A genuine finite fourth-moment Littlewood--Paley estimate in every
positive dimension.  The constant grows quadratically in the finite index
set, as expected from the elementary maximal-function proof; the uniform
all-scale vector-valued estimate remains the separate Littlewood--Paley
problem. -/
theorem finiteLittlewoodPaleyL4
    {d : Nat} (hd : 0 < d) (C : lpCutoffs d) (s : Finset Nat) :
    ∃ A : Real, 0 < A ∧ ∀ f : SchwartzMap (Euclidean d) Complex,
      (∫ x : Euclidean d, finiteDyadicSquareEnergy C s f x ^ (2 : Nat)) ≤
        A * ∫ x : Euclidean d, ‖f x‖ ^ (4 : Nat) := by
  obtain ⟨K, hK, hmajor⟩ := exists_dyadicProjection_majorant C.cutoff
  obtain ⟨B, hB, hball⟩ :=
    dyadic_hardy_littlewood_maximal_strong_type_schwartz hd
      (by norm_num : (1 : Real) < 4)
  let D : Real := (s.card : Real) ^ (2 : Nat) * K ^ (4 : Nat)
  let A : Real := D * B + 1
  have hD : 0 ≤ D := by
    dsimp [D]
    positivity
  have hA : 0 < A := by
    dsimp [A]
    have : 0 ≤ D * B := mul_nonneg hD hB.le
    linarith
  refine ⟨A, hA, ?_⟩
  intro f
  have hballf := hball f
  have hHpow : Integrable (fun x : Euclidean d =>
      (dyadicBallMaximal d (f : Euclidean d → Complex) x) ^ (4 : Nat)) volume := by
    have h := hballf.1.integrable_norm_rpow
      (by norm_num : ENNReal.ofReal (4 : Real) ≠ 0) ENNReal.ofReal_ne_top
    convert h using 1
    funext x
    have hHnonneg : 0 ≤ dyadicBallMaximal d
        (f : Euclidean d → Complex) x := ENNReal.toReal_nonneg
    have hfour : (ENNReal.ofReal (4 : Real)).toReal = (4 : Real) := by
      norm_num
    rw [Real.norm_eq_abs, abs_of_nonneg hHnonneg, hfour]
    exact (Real.rpow_natCast _ 4).symm
  have hright : Integrable (fun x : Euclidean d =>
      D * (dyadicBallMaximal d (f : Euclidean d → Complex) x) ^ (4 : Nat)) volume :=
    hHpow.const_mul D
  have hinput_nonneg : 0 ≤ ∫ x : Euclidean d, ‖f x‖ ^ (4 : Nat) := by
    exact integral_nonneg fun x => pow_nonneg (norm_nonneg _) _
  have hball_nat :
      (∫ x : Euclidean d,
        (dyadicBallMaximal d (f : Euclidean d → Complex) x) ^ (4 : Nat)) ≤
          B * ∫ x : Euclidean d, ‖f x‖ ^ (4 : Nat) := by
    have hH_eq : (fun x : Euclidean d =>
        (dyadicBallMaximal d (f : Euclidean d → Complex) x) ^ (4 : Nat)) =
        fun x => (dyadicBallMaximal d (f : Euclidean d → Complex) x) ^ (4 : Real) := by
      funext x
      exact (Real.rpow_natCast _ 4).symm
    have hf_eq : (fun x : Euclidean d => ‖f x‖ ^ (4 : Nat)) =
        fun x => ‖f x‖ ^ (4 : Real) := by
      funext x
      exact (Real.rpow_natCast _ 4).symm
    rw [hH_eq, hf_eq]
    exact hballf.2
  calc
    (∫ x : Euclidean d, finiteDyadicSquareEnergy C s f x ^ (2 : Nat)) ≤
        ∫ x : Euclidean d,
          D * (dyadicBallMaximal d (f : Euclidean d → Complex) x) ^ (4 : Nat) := by
          apply integral_mono_of_nonneg
          · exact Filter.Eventually.of_forall fun x => sq_nonneg _
          · exact hright
          · exact Filter.Eventually.of_forall fun x => by
              have hH : 0 ≤
                  K * dyadicBallMaximal d (f : Euclidean d → Complex) x :=
                mul_nonneg hK.le ENNReal.toReal_nonneg
              have hpoint :=
                finiteSquareEnergy_sq_le_card_sq_mul_of_majorant s
                  (fun j => dyadicProjection C.cutoff j f)
                  (fun y => K * dyadicBallMaximal d
                    (f : Euclidean d → Complex) y) x hH
                  (fun j hj => hmajor j f x)
              calc
                finiteDyadicSquareEnergy C s f x ^ (2 : Nat) =
                    finiteSquareEnergy s (fun j => dyadicProjection C.cutoff j f) x ^
                      (2 : Nat) := rfl
                _ ≤ (s.card : Real) ^ (2 : Nat) *
                    (K * dyadicBallMaximal d
                      (f : Euclidean d → Complex) x) ^ (4 : Nat) := hpoint
                _ = D * dyadicBallMaximal d
                    (f : Euclidean d → Complex) x ^ (4 : Nat) := by
                      dsimp [D]
                      ring
    _ = D * ∫ x : Euclidean d,
        (dyadicBallMaximal d (f : Euclidean d → Complex) x) ^ (4 : Nat) := by
      rw [integral_const_mul]
    _ ≤ D * (B * ∫ x : Euclidean d, ‖f x‖ ^ (4 : Nat)) := by
      exact mul_le_mul_of_nonneg_left hball_nat hD
    _ = (D * B) * ∫ x : Euclidean d, ‖f x‖ ^ (4 : Nat) := by
      ring
    _ ≤ A * ∫ x : Euclidean d, ‖f x‖ ^ (4 : Nat) := by
      apply mul_le_mul_of_nonneg_right
      · dsimp [A]
        linarith
      · exact hinput_nonneg

/-! ### Uniform vector-valued target

The following definitions state the remaining uniform finite-family
Littlewood--Paley problem in a form that is independent of a limiting
argument over all integer scales.  A standard proof averages uniformly
bounded signed multiplier sums (equivalently, applies a Hilbert-valued
Calderón--Zygmund/Mikhlin theorem).  The scalar maximal-majorant results
available above do not provide that signed estimate, so these are targets
rather than consequences of the finite cardinality-dependent theorem.
-/

/-- The homogeneous integer-scale dyadic projection. -/
def integerDyadicProjection {d : Nat} (χ : SchwartzMap (Euclidean d) Complex)
    (k : Int) (f : SchwartzMap (Euclidean d) Complex) : Euclidean d → Complex :=
  fun x => 𝓕⁻ (fun ξ : Euclidean d =>
    intDyadicBandpassMultiplier χ k ξ *
      𝓕 (f : Euclidean d → Complex) ξ) x

/-- The squared finite homogeneous dyadic square function. -/
def finiteIntegerDyadicSquareEnergy {d : Nat} (C : lpCutoffs d)
    (K : Finset Int) (f : SchwartzMap (Euclidean d) Complex)
    (x : Euclidean d) : Real :=
  finiteSquareEnergy K (fun k => integerDyadicProjection C.cutoff k f) x

/-- The uniform finite-family L4 Littlewood--Paley assertion.  Crucially,
the constant is required to be independent of the finite set of scales. -/
def uniformFiniteIntegerLittlewoodPaleyL4 {d : Nat} (C : lpCutoffs d) : Prop :=
  ∃ A : Real, 0 < A ∧ ∀ (K : Finset Int)
    (f : SchwartzMap (Euclidean d) Complex),
      (∫ x : Euclidean d,
        finiteIntegerDyadicSquareEnergy C K f x ^ (2 : Nat)) ≤
        A * ∫ x : Euclidean d, ‖f x‖ ^ (4 : Nat)

/-- The dimension-generic finite-family form of the Littlewood--Paley
square-function theorem.  The usual countable homogeneous theorem follows
from this uniform statement after a separate monotone-convergence passage. -/
def littlewoodPaley {d : Nat} (C : lpCutoffs d) : Prop :=
  ∀ p : Real, 1 < p → ∃ A : Real, 0 < A ∧
    ∀ (K : Finset Int) (f : SchwartzMap (Euclidean d) Complex),
      (∫ x : Euclidean d,
        (finiteIntegerDyadicSquareEnergy C K f x) ^ (p / 2)) ≤
        A * ∫ x : Euclidean d, ‖f x‖ ^ p

/-! ### Finite Rademacher reduction

The finite sign average below is the elementary part of the usual
Rademacher/Khintchine reduction.  It is deliberately formulated using the
finite powerset, so it requires no probabilistic infrastructure.  Once a
uniform `L⁴` estimate for every signed dyadic multiplier is available, the
fourth-moment lower bound is the exact bridge to the uniform square-function
target above.
-/

/-- The `±1` sign attached to an index by a finite sign choice. -/
def rademacherSign {I : Type*} [DecidableEq I] (u : Finset I) (i : I) : Complex :=
  if i ∈ u then 1 else -1

/-- The finite Rademacher signed sum of a complex family. -/
def rademacherSignedSum {I : Type*} [DecidableEq I]
    (s u : Finset I) (z : I → Complex) : Complex :=
  ∑ i ∈ s, rademacherSign u i * z i

private theorem rademacherSignedSum_insert_absent {I : Type*} [DecidableEq I]
    {s u : Finset I} {a : I} (ha : a ∉ s) (hu : u ⊆ s)
    (z : I → Complex) :
    rademacherSignedSum (insert a s) u z =
      -z a + rademacherSignedSum s u z := by
  have hau : a ∉ u := fun hau => ha (hu hau)
  unfold rademacherSignedSum
  rw [Finset.sum_insert ha]
  simp only [rademacherSign, hau, if_false, neg_one_mul]

private theorem rademacherSignedSum_insert_present {I : Type*} [DecidableEq I]
    {s u : Finset I} {a : I} (ha : a ∉ s) (z : I → Complex) :
    rademacherSignedSum (insert a s) (insert a u) z =
      z a + rademacherSignedSum s u z := by
  unfold rademacherSignedSum
  rw [Finset.sum_insert ha]
  simp only [rademacherSign, Finset.mem_insert, true_or, if_true, one_mul]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  have hia : i ≠ a := by
    intro h
    apply ha
    simpa [h] using hi
  simp [hia]

/-- The exact second moment of the finite Rademacher signed sum. -/
theorem rademacherSecondMoment {I : Type*} [DecidableEq I]
    (s : Finset I) (z : I → Complex) :
    ∑ u ∈ s.powerset,
      ‖rademacherSignedSum s u z‖ ^ (2 : Nat) =
      (s.powerset.card : Real) * ∑ i ∈ s, ‖z i‖ ^ (2 : Nat) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [rademacherSignedSum]
  | @insert a s ha ih =>
      rw [Finset.sum_powerset_insert ha]
      let X : Finset I → Complex := fun u => rademacherSignedSum s u z
      have hminus (u : Finset I) (hu : u ∈ s.powerset) :
          rademacherSignedSum (insert a s) u z = -z a + X u := by
        exact rademacherSignedSum_insert_absent ha (Finset.mem_powerset.mp hu) z
      have hplus (u : Finset I) (hu : u ∈ s.powerset) :
          rademacherSignedSum (insert a s) (insert a u) z = z a + X u := by
        exact rademacherSignedSum_insert_present ha z
      have hpara (u : Finset I) :
          ‖-z a + X u‖ ^ (2 : Nat) + ‖z a + X u‖ ^ (2 : Nat) =
            2 * (‖z a‖ ^ (2 : Nat) + ‖X u‖ ^ (2 : Nat)) := by
        have h := parallelogram_law_with_norm_mul Complex (z a) (X u)
        rw [show -z a + X u = -(z a - X u) by ring, norm_neg]
        simpa only [pow_two, add_comm, add_left_comm, add_assoc] using h
      have hminusSum :
          (∑ u ∈ s.powerset,
            ‖rademacherSignedSum (insert a s) u z‖ ^ (2 : Nat)) =
            ∑ u ∈ s.powerset, ‖-z a + X u‖ ^ (2 : Nat) := by
        apply Finset.sum_congr rfl
        intro u hu
        rw [hminus u hu]
      have hplusSum :
          (∑ u ∈ s.powerset,
            ‖rademacherSignedSum (insert a s) (insert a u) z‖ ^ (2 : Nat)) =
            ∑ u ∈ s.powerset, ‖z a + X u‖ ^ (2 : Nat) := by
        apply Finset.sum_congr rfl
        intro u hu
        rw [hplus u hu]
      rw [hminusSum, hplusSum, ← Finset.sum_add_distrib]
      have hsumpara :
          (∑ u ∈ s.powerset,
            (‖-z a + X u‖ ^ (2 : Nat) + ‖z a + X u‖ ^ (2 : Nat))) =
              ∑ u ∈ s.powerset, 2 * (‖z a‖ ^ (2 : Nat) + ‖X u‖ ^ (2 : Nat)) := by
        apply Finset.sum_congr rfl
        intro u hu
        exact hpara u
      rw [hsumpara]
      have hXsum :
          (∑ u ∈ s.powerset, ‖X u‖ ^ (2 : Nat)) =
            (s.powerset.card : Real) * ∑ i ∈ s, ‖z i‖ ^ (2 : Nat) := by
        simpa only [X] using ih
      rw [← Finset.mul_sum, Finset.sum_add_distrib, hXsum]
      rw [Finset.sum_const, Finset.card_powerset, Finset.sum_insert ha]
      simp only [nsmul_eq_mul]
      simp only [Finset.card_powerset, Finset.card_insert_of_notMem ha,
        Nat.cast_pow, Nat.cast_mul, Nat.cast_ofNat, pow_succ]
      ring

/-- Finite Rademacher averaging dominates the fourth power of the square
function.  This is the probabilistic-free finite form of the lower
Khintchine inequality used in the `L⁴` Littlewood--Paley argument. -/
theorem rademacherFourthMomentLower {I : Type*} [DecidableEq I]
    (s : Finset I) (z : I → Complex) :
    (s.powerset.card : Real) *
        (∑ i ∈ s, ‖z i‖ ^ (2 : Nat)) ^ (2 : Nat) ≤
      ∑ u ∈ s.powerset,
        ‖rademacherSignedSum s u z‖ ^ (4 : Nat) := by
  let A : Finset I → Real := fun u =>
    ‖rademacherSignedSum s u z‖ ^ (2 : Nat)
  have hsecond :
      (∑ u ∈ s.powerset, A u) =
        (s.powerset.card : Real) * ∑ i ∈ s, ‖z i‖ ^ (2 : Nat) := by
    simpa only [A] using rademacherSecondMoment s z
  have hcs := sq_sum_le_card_mul_sum_sq (s := s.powerset) (f := A)
  rw [hsecond] at hcs
  have hcard : 0 < (s.powerset.card : Real) := by
    positivity
  have hfourth :
      (∑ u ∈ s.powerset, A u ^ (2 : Nat)) =
        ∑ u ∈ s.powerset,
          ‖rademacherSignedSum s u z‖ ^ (4 : Nat) := by
    apply Finset.sum_congr rfl
    intro u hu
    dsimp only [A]
    ring
  have hfactor :
      (s.powerset.card : Real) *
          ((s.powerset.card : Real) *
            (∑ i ∈ s, ‖z i‖ ^ (2 : Nat)) ^ (2 : Nat)) ≤
        (s.powerset.card : Real) *
          ∑ u ∈ s.powerset,
            ‖rademacherSignedSum s u z‖ ^ (4 : Nat) := by
    calc
      (s.powerset.card : Real) *
          ((s.powerset.card : Real) *
            (∑ i ∈ s, ‖z i‖ ^ (2 : Nat)) ^ (2 : Nat)) =
          ((s.powerset.card : Real) *
            ∑ i ∈ s, ‖z i‖ ^ (2 : Nat)) ^ (2 : Nat) := by ring
      _ ≤ (s.powerset.card : Real) *
          ∑ u ∈ s.powerset, A u ^ (2 : Nat) := hcs
      _ = (s.powerset.card : Real) *
          ∑ u ∈ s.powerset,
            ‖rademacherSignedSum s u z‖ ^ (4 : Nat) := by rw [hfourth]
  exact le_of_mul_le_mul_left hfactor hcard

/-- Integrating the finite Rademacher fourth-moment inequality.  The only
analytic hypothesis is integrability of the finitely many signed fourth
moments on the right. -/
theorem integral_rademacherFourthMomentLower
    {I X : Type*} [DecidableEq I] [MeasurableSpace X]
    (μ : Measure X) (s : Finset I) (g : I → X → Complex)
    (hsign : ∀ u ∈ s.powerset,
      Integrable (fun x => ‖rademacherSignedSum s u (fun i => g i x)‖ ^ (4 : Nat)) μ) :
    (s.powerset.card : Real) *
        (∫ x, finiteSquareEnergy s g x ^ (2 : Nat) ∂μ) ≤
      ∑ u ∈ s.powerset,
        ∫ x, ‖rademacherSignedSum s u (fun i => g i x)‖ ^ (4 : Nat) ∂μ := by
  have hrightInt : Integrable (fun x =>
      ∑ u ∈ s.powerset,
        ‖rademacherSignedSum s u (fun i => g i x)‖ ^ (4 : Nat)) μ :=
    integrable_finsetSum s.powerset hsign
  have hpoint (x : X) :
      (s.powerset.card : Real) * finiteSquareEnergy s g x ^ (2 : Nat) ≤
        ∑ u ∈ s.powerset,
          ‖rademacherSignedSum s u (fun i => g i x)‖ ^ (4 : Nat) := by
    simpa only [finiteSquareEnergy] using
      rademacherFourthMomentLower s (fun i => g i x)
  calc
    (s.powerset.card : Real) *
        (∫ x, finiteSquareEnergy s g x ^ (2 : Nat) ∂μ) =
        ∫ x, (s.powerset.card : Real) * finiteSquareEnergy s g x ^ (2 : Nat) ∂μ := by
          rw [integral_const_mul]
    _ ≤ ∫ x, ∑ u ∈ s.powerset,
        ‖rademacherSignedSum s u (fun i => g i x)‖ ^ (4 : Nat) ∂μ := by
          apply integral_mono_of_nonneg
          · exact Filter.Eventually.of_forall fun x =>
              mul_nonneg (Nat.cast_nonneg _) (sq_nonneg _)
          · exact hrightInt
          · exact Filter.Eventually.of_forall hpoint
    _ = ∑ u ∈ s.powerset,
        ∫ x, ‖rademacherSignedSum s u (fun i => g i x)‖ ^ (4 : Nat) ∂μ := by
          rw [integral_finsetSum s.powerset hsign]

/-- The finite signed sum of homogeneous dyadic Littlewood--Paley
projections. -/
def finiteRademacherIntegerDyadicSum {d : Nat} (C : lpCutoffs d)
    (K u : Finset Int) (f : SchwartzMap (Euclidean d) Complex) :
    Euclidean d → Complex := fun x =>
  rademacherSignedSum K u (fun k => integerDyadicProjection C.cutoff k f x)

/-- A uniform signed `L⁴` bound for finite homogeneous dyadic sums.  This is
the exact scalar multiplier input that the generic Calderón--Zygmund/Mikhlin
development must provide. -/
def HasUniformFiniteRademacherIntegerDyadicL4 {d : Nat} (C : lpCutoffs d) : Prop :=
  ∃ B : Real, 0 < B ∧ ∀ (K u : Finset Int)
    (f : SchwartzMap (Euclidean d) Complex), u ∈ K.powerset →
      Integrable (fun x => ‖finiteRademacherIntegerDyadicSum C K u f x‖ ^ (4 : Nat)) volume ∧
        (∫ x, ‖finiteRademacherIntegerDyadicSum C K u f x‖ ^ (4 : Nat)) ≤
          B * ∫ x, ‖f x‖ ^ (4 : Nat)

/-- The finite Rademacher argument converts a uniform signed multiplier
`L⁴` estimate into the uniform finite homogeneous Littlewood--Paley `L⁴`
estimate. -/
theorem uniformFiniteIntegerLittlewoodPaleyL4_of_signed {d : Nat}
    (C : lpCutoffs d) (hsigned : HasUniformFiniteRademacherIntegerDyadicL4 C) :
    uniformFiniteIntegerLittlewoodPaleyL4 C := by
  rcases hsigned with ⟨B, hB, hsigned⟩
  refine ⟨B, hB, ?_⟩
  intro K f
  have hsign : ∀ u ∈ K.powerset,
      Integrable (fun x =>
        ‖rademacherSignedSum K u
          (fun k => integerDyadicProjection C.cutoff k f x)‖ ^ (4 : Nat)) volume := by
    intro u hu
    simpa only [finiteRademacherIntegerDyadicSum] using (hsigned K u f hu).1
  have hmoment := integral_rademacherFourthMomentLower volume K
    (fun k x => integerDyadicProjection C.cutoff k f x) hsign
  have hinputNonneg : 0 ≤ ∫ x : Euclidean d, ‖f x‖ ^ (4 : Nat) := by
    exact integral_nonneg fun x => pow_nonneg (norm_nonneg _) _
  have hsumBound :
      (∑ u ∈ K.powerset,
        ∫ x : Euclidean d,
          ‖rademacherSignedSum K u
            (fun k => integerDyadicProjection C.cutoff k f x)‖ ^ (4 : Nat)) ≤
        (K.powerset.card : Real) *
          (B * ∫ x : Euclidean d, ‖f x‖ ^ (4 : Nat)) := by
    calc
      (∑ u ∈ K.powerset,
        ∫ x : Euclidean d,
          ‖rademacherSignedSum K u
            (fun k => integerDyadicProjection C.cutoff k f x)‖ ^ (4 : Nat)) ≤
          ∑ u ∈ K.powerset,
            (B * ∫ x : Euclidean d, ‖f x‖ ^ (4 : Nat)) := by
              apply Finset.sum_le_sum
              intro u hu
              simpa only [finiteRademacherIntegerDyadicSum] using (hsigned K u f hu).2
      _ = (K.powerset.card : Real) *
          (B * ∫ x : Euclidean d, ‖f x‖ ^ (4 : Nat)) := by
            rw [Finset.sum_const]
            simp only [nsmul_eq_mul]
  have hcard : 0 < (K.powerset.card : Real) := by positivity
  apply le_of_mul_le_mul_left _ hcard
  calc
    (K.powerset.card : Real) *
        (∫ x : Euclidean d, finiteIntegerDyadicSquareEnergy C K f x ^ (2 : Nat)) =
        (K.powerset.card : Real) *
          (∫ x : Euclidean d,
            finiteSquareEnergy K
              (fun k => integerDyadicProjection C.cutoff k f) x ^ (2 : Nat)) := by rfl
    _ ≤ ∑ u ∈ K.powerset,
        ∫ x : Euclidean d,
          ‖rademacherSignedSum K u
            (fun k => integerDyadicProjection C.cutoff k f x)‖ ^ (4 : Nat) := hmoment
    _ ≤ (K.powerset.card : Real) *
        (B * ∫ x : Euclidean d, ‖f x‖ ^ (4 : Nat)) := hsumBound

private theorem rademacher_quartic_pair_upper (a x : Complex) :
    ‖-a + x‖ ^ (4 : Nat) + ‖a + x‖ ^ (4 : Nat) ≤
      2 * (‖x‖ ^ (4 : Nat) + 6 * ‖x‖ ^ (2 : Nat) * ‖a‖ ^ (2 : Nat) +
        ‖a‖ ^ (4 : Nat)) := by
  have hsq : (a * starRingEnd Complex x).re ^ (2 : Nat) ≤
      Complex.normSq a * Complex.normSq x := by
    calc
      (a * starRingEnd Complex x).re ^ (2 : Nat) ≤
          Complex.normSq (a * starRingEnd Complex x) := by
            simpa [pow_two] using Complex.re_sq_le_normSq (a * starRingEnd Complex x)
      _ = Complex.normSq a * Complex.normSq x := by
            rw [Complex.normSq_mul, Complex.normSq_conj]
  have hfour (z : Complex) : ‖z‖ ^ (4 : Nat) = (‖z‖ ^ (2 : Nat)) ^ (2 : Nat) := by
    ring
  rw [hfour, hfour, hfour, hfour]
  rw [show -a + x = x - a by ring, Complex.sq_norm, Complex.sq_norm,
    Complex.normSq_sub, Complex.normSq_add]
  have hre : (x * starRingEnd Complex a).re =
      (a * starRingEnd Complex x).re := by
    simp [Complex.mul_re]
    ring
  rw [hre]
  rw [Complex.sq_norm, Complex.sq_norm]
  nlinarith [Complex.normSq_nonneg a, Complex.normSq_nonneg x]

private theorem signed_sum_insert_absent {I : Type*} [DecidableEq I]
    {s u : Finset I} {a : I} (ha : a ∉ s) (hu : u ⊆ s)
    (z : I → Complex) :
    rademacherSignedSum (insert a s) u z =
      -z a + rademacherSignedSum s u z := by
  have hau : a ∉ u := fun hau => ha (hu hau)
  unfold rademacherSignedSum
  rw [Finset.sum_insert ha]
  simp only [rademacherSign, hau, if_false, neg_one_mul]

private theorem signed_sum_insert_present {I : Type*} [DecidableEq I]
    {s u : Finset I} {a : I} (ha : a ∉ s) (z : I → Complex) :
    rademacherSignedSum (insert a s) (insert a u) z =
      z a + rademacherSignedSum s u z := by
  unfold rademacherSignedSum
  rw [Finset.sum_insert ha]
  simp only [rademacherSign, Finset.mem_insert, true_or, if_true, one_mul]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  have hia : i ≠ a := by
    intro h
    apply ha
    simpa [h] using hi
  simp [hia]

private theorem rademacher_fourth_moment_upper {I : Type*} [DecidableEq I]
    (s : Finset I) (z : I → Complex) :
    ∑ u ∈ s.powerset, ‖rademacherSignedSum s u z‖ ^ (4 : Nat) ≤
      3 * (s.powerset.card : Real) *
        (∑ i ∈ s, ‖z i‖ ^ (2 : Nat)) ^ (2 : Nat) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [rademacherSignedSum]
  | @insert a s ha ih =>
      rw [Finset.sum_powerset_insert ha]
      let X : Finset I → Complex := fun u => rademacherSignedSum s u z
      let S : Real := ∑ i ∈ s, ‖z i‖ ^ (2 : Nat)
      let A : Real := ‖z a‖ ^ (2 : Nat)
      have hminus (u : Finset I) (hu : u ∈ s.powerset) :
          rademacherSignedSum (insert a s) u z = -z a + X u := by
        exact signed_sum_insert_absent ha (Finset.mem_powerset.mp hu) z
      have hplus (u : Finset I) (hu : u ∈ s.powerset) :
          rademacherSignedSum (insert a s) (insert a u) z = z a + X u := by
        exact signed_sum_insert_present ha z
      have hpair (u : Finset I) (hu : u ∈ s.powerset) :
          ‖rademacherSignedSum (insert a s) u z‖ ^ (4 : Nat) +
              ‖rademacherSignedSum (insert a s) (insert a u) z‖ ^ (4 : Nat) ≤
            2 * (‖X u‖ ^ (4 : Nat) + 6 * ‖X u‖ ^ (2 : Nat) * A + A ^ (2 : Nat)) := by
        rw [hminus u hu, hplus u hu]
        calc
          ‖-z a + X u‖ ^ (4 : Nat) + ‖z a + X u‖ ^ (4 : Nat) ≤
              2 * (‖X u‖ ^ (4 : Nat) + 6 * ‖X u‖ ^ (2 : Nat) * ‖z a‖ ^ (2 : Nat) +
                ‖z a‖ ^ (4 : Nat)) := rademacher_quartic_pair_upper (z a) (X u)
          _ = 2 * (‖X u‖ ^ (4 : Nat) + 6 * ‖X u‖ ^ (2 : Nat) * A + A ^ (2 : Nat)) := by
            dsimp [A]
            ring
      have hpairsum :
          (∑ u ∈ s.powerset,
            (‖rademacherSignedSum (insert a s) u z‖ ^ (4 : Nat) +
              ‖rademacherSignedSum (insert a s) (insert a u) z‖ ^ (4 : Nat))) ≤
            ∑ u ∈ s.powerset,
              2 * (‖X u‖ ^ (4 : Nat) + 6 * ‖X u‖ ^ (2 : Nat) * A + A ^ (2 : Nat)) := by
        apply Finset.sum_le_sum
        intro u hu
        exact hpair u hu
      have hXfour :
          (∑ u ∈ s.powerset, ‖X u‖ ^ (4 : Nat)) ≤
            3 * (s.powerset.card : Real) * S ^ (2 : Nat) := by
        simpa only [X, S] using ih
      have hXsecond :
          (∑ u ∈ s.powerset, ‖X u‖ ^ (2 : Nat)) =
            (s.powerset.card : Real) * S := by
        simpa only [X, S] using rademacherSecondMoment s z
      have hcard : 0 ≤ (s.powerset.card : Real) := Nat.cast_nonneg _
      have hS : 0 ≤ S := by
        dsimp [S]
        exact Finset.sum_nonneg fun i hi => sq_nonneg _
      have hA : 0 ≤ A := by
        dsimp [A]
        exact sq_nonneg _
      have hsum :
          (∑ u ∈ s.powerset,
              2 * (‖X u‖ ^ (4 : Nat) + 6 * ‖X u‖ ^ (2 : Nat) * A + A ^ (2 : Nat))) ≤
            6 * (s.powerset.card : Real) * S ^ (2 : Nat) +
              12 * (s.powerset.card : Real) * S * A +
                2 * (s.powerset.card : Real) * A ^ (2 : Nat) := by
        rw [← Finset.mul_sum]
        have hsplit :
            (∑ u ∈ s.powerset,
              (‖X u‖ ^ (4 : Nat) + 6 * ‖X u‖ ^ (2 : Nat) * A + A ^ (2 : Nat))) =
              (∑ u ∈ s.powerset, ‖X u‖ ^ (4 : Nat)) +
                6 * A * (∑ u ∈ s.powerset, ‖X u‖ ^ (2 : Nat)) +
                  (s.powerset.card : Real) * A ^ (2 : Nat) := by
          rw [Finset.sum_add_distrib, Finset.sum_add_distrib]
          have hmiddle :
              (∑ u ∈ s.powerset, 6 * ‖X u‖ ^ (2 : Nat) * A) =
                6 * A * (∑ u ∈ s.powerset, ‖X u‖ ^ (2 : Nat)) := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro u hu
            ring
          rw [hmiddle, Finset.sum_const, nsmul_eq_mul]
        rw [hsplit, hXsecond]
        nlinarith [hXfour]
      have hcard_insert : ((insert a s).powerset.card : Real) =
          2 * (s.powerset.card : Real) := by
        simp only [Finset.card_powerset, Finset.card_insert_of_notMem ha,
          pow_succ, Nat.cast_mul, Nat.cast_ofNat]
        ring
      have hinsert_sum :
          (∑ i ∈ insert a s, ‖z i‖ ^ (2 : Nat)) = A + S := by
        simp only [Finset.sum_insert ha, A, S]
      have htarget :
          6 * (s.powerset.card : Real) * S ^ (2 : Nat) +
              12 * (s.powerset.card : Real) * S * A +
                2 * (s.powerset.card : Real) * A ^ (2 : Nat) ≤
            3 * ((insert a s).powerset.card : Real) *
              (∑ i ∈ insert a s, ‖z i‖ ^ (2 : Nat)) ^ (2 : Nat) := by
        rw [hcard_insert, hinsert_sum]
        nlinarith
      rw [← Finset.sum_add_distrib]
      exact hpairsum.trans (hsum.trans htarget)

/-- The finite Paley--Zygmund lower moment estimate for complex Rademacher
signs.  The numerical constant is deliberately crude but independent of the
cardinality of `s`. -/
private theorem rademacher_lower_moment {I : Type*} [DecidableEq I]
    (s : Finset I) (z : I → Complex) {p : Real} (hp : 0 ≤ p) :
    (s.powerset.card : Real) / 12 *
        ((∑ i ∈ s, ‖z i‖ ^ (2 : Nat)) / 2) ^ (p / 2) ≤
      ∑ u ∈ s.powerset, ‖rademacherSignedSum s u z‖ ^ p := by
  classical
  let X : Finset I → Real := fun u => ‖rademacherSignedSum s u z‖ ^ (2 : Nat)
  let S : Real := ∑ i ∈ s, ‖z i‖ ^ (2 : Nat)
  let n : Real := s.powerset.card
  let good : Finset (Finset I) := s.powerset.filter (fun u => S / 2 ≤ X u)
  let bad : Finset (Finset I) := s.powerset.filter (fun u => ¬ S / 2 ≤ X u)
  have hXnonneg (u : Finset I) : 0 ≤ X u := by
    dsimp [X]
    exact sq_nonneg _
  have hS : 0 ≤ S := by
    dsimp [S]
    exact Finset.sum_nonneg fun i hi => sq_nonneg _
  have hn : 0 < n := by
    dsimp [n]
    positivity
  have hgoodsub : good ⊆ s.powerset := by
    dsimp [good]
    exact Finset.filter_subset _ _
  have hbadsub : bad ⊆ s.powerset := by
    dsimp [bad]
    exact Finset.filter_subset _ _
  have hbadbound : (∑ u ∈ bad, X u) ≤ n * (S / 2) := by
    calc
      (∑ u ∈ bad, X u) ≤ ∑ u ∈ bad, S / 2 := by
        apply Finset.sum_le_sum
        intro u hu
        have hbad : ¬ S / 2 ≤ X u := by
          exact (Finset.mem_filter.mp hu).2
        exact le_of_lt (lt_of_not_ge hbad)
      _ = (bad.card : Real) * (S / 2) := by
        rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ n * (S / 2) := by
        apply mul_le_mul_of_nonneg_right
        · dsimp [n]
          exact_mod_cast Finset.card_le_card hbadsub
        · positivity
  have htotal : (∑ u ∈ s.powerset, X u) = n * S := by
    simpa only [X, n, S] using rademacherSecondMoment s z
  have hsplit :
      (∑ u ∈ good, X u) + (∑ u ∈ bad, X u) =
        ∑ u ∈ s.powerset, X u := by
    dsimp [good, bad]
    rw [Finset.sum_filter_add_sum_filter_not]
  have hgoodsum : n * S / 2 ≤ ∑ u ∈ good, X u := by
    nlinarith [hbadbound, hsplit, htotal]
  have hfour :
      (∑ u ∈ s.powerset, X u ^ (2 : Nat)) ≤ 3 * n * S ^ (2 : Nat) := by
    dsimp [X, n, S]
    calc
      (∑ u ∈ s.powerset,
          (‖rademacherSignedSum s u z‖ ^ (2 : Nat)) ^ (2 : Nat)) =
          ∑ u ∈ s.powerset, ‖rademacherSignedSum s u z‖ ^ (4 : Nat) := by
            apply Finset.sum_congr rfl
            intro u hu
            ring
      _ ≤ 3 * (s.powerset.card : Real) *
          (∑ i ∈ s, ‖z i‖ ^ (2 : Nat)) ^ (2 : Nat) :=
            rademacher_fourth_moment_upper s z
  have hgoodfour :
      (∑ u ∈ good, X u ^ (2 : Nat)) ≤ 3 * n * S ^ (2 : Nat) := by
    calc
      (∑ u ∈ good, X u ^ (2 : Nat)) ≤
          ∑ u ∈ s.powerset, X u ^ (2 : Nat) := by
            apply Finset.sum_le_sum_of_subset_of_nonneg hgoodsub
            intro u hu hnot
            positivity
      _ ≤ 3 * n * S ^ (2 : Nat) := hfour
  have hgoodcard : n / 12 ≤ (good.card : Real) := by
    by_cases hSzero : S = 0
    · have hgoodeq : good = s.powerset := by
        apply Finset.Subset.antisymm hgoodsub
        intro u hu
        dsimp only [good]
        apply Finset.mem_filter.mpr
        refine ⟨hu, ?_⟩
        simpa [hSzero] using hXnonneg u
      rw [hgoodeq]
      dsimp [n]
      have hnnonneg : (0 : Real) ≤ (s.powerset.card : Real) := Nat.cast_nonneg _
      nlinarith
    · have hSpos : 0 < S := lt_of_le_of_ne hS (Ne.symm hSzero)
      have hGnonneg : 0 ≤ ∑ u ∈ good, X u :=
        Finset.sum_nonneg fun u hu => hXnonneg u
      have hleftnonneg : 0 ≤ n * S / 2 := by positivity
      have hsquare : (n * S / 2) ^ (2 : Nat) ≤
          (∑ u ∈ good, X u) ^ (2 : Nat) :=
        (sq_le_sq₀ hleftnonneg hGnonneg).mpr hgoodsum
      have hcs := sq_sum_le_card_mul_sum_sq (s := good) (f := X)
      have hcs' : (∑ u ∈ good, X u) ^ (2 : Nat) ≤
          (good.card : Real) * (3 * n * S ^ (2 : Nat)) := by
        calc
          (∑ u ∈ good, X u) ^ (2 : Nat) ≤
              (good.card : Real) * ∑ u ∈ good, X u ^ (2 : Nat) := hcs
          _ ≤ (good.card : Real) * (3 * n * S ^ (2 : Nat)) := by
              exact mul_le_mul_of_nonneg_left hgoodfour (Nat.cast_nonneg _)
      have hfactor :
          (n * S ^ (2 : Nat)) * (n / 4) ≤
            (n * S ^ (2 : Nat)) * (3 * (good.card : Real)) := by
        calc
          (n * S ^ (2 : Nat)) * (n / 4) = (n * S / 2) ^ (2 : Nat) := by ring
          _ ≤ (∑ u ∈ good, X u) ^ (2 : Nat) := hsquare
          _ ≤ (good.card : Real) * (3 * n * S ^ (2 : Nat)) := hcs'
          _ = (n * S ^ (2 : Nat)) * (3 * (good.card : Real)) := by ring
      have hfactorpos : 0 < n * S ^ (2 : Nat) :=
        mul_pos hn (sq_pos_of_pos hSpos)
      have hlinear : n / 4 ≤ 3 * (good.card : Real) :=
        le_of_mul_le_mul_left hfactor hfactorpos
      nlinarith
  have hpoint (u : Finset I) (hu : u ∈ good) :
      (S / 2) ^ (p / 2) ≤ ‖rademacherSignedSum s u z‖ ^ p := by
    have hthreshold : S / 2 ≤ X u := (Finset.mem_filter.mp hu).2
    have hq : 0 ≤ p / 2 := by positivity
    have hpow := Real.rpow_le_rpow (by positivity : 0 ≤ S / 2) hthreshold hq
    calc
      (S / 2) ^ (p / 2) ≤ (X u) ^ (p / 2) := hpow
      _ = (‖rademacherSignedSum s u z‖ ^ (2 : Nat)) ^ (p / 2) := by rfl
      _ = ‖rademacherSignedSum s u z‖ ^ p := by
        rw [← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _)]
        congr 1
        ring
  have hgoodmoment :
      (good.card : Real) * (S / 2) ^ (p / 2) ≤
        ∑ u ∈ good, ‖rademacherSignedSum s u z‖ ^ p := by
    calc
      (good.card : Real) * (S / 2) ^ (p / 2) =
          ∑ u ∈ good, (S / 2) ^ (p / 2) := by
            rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ ∑ u ∈ good, ‖rademacherSignedSum s u z‖ ^ p := by
        apply Finset.sum_le_sum
        intro u hu
        exact hpoint u hu
  have hfullmoment :
      (∑ u ∈ good, ‖rademacherSignedSum s u z‖ ^ p) ≤
        ∑ u ∈ s.powerset, ‖rademacherSignedSum s u z‖ ^ p := by
    apply Finset.sum_le_sum_of_subset_of_nonneg hgoodsub
    intro u hu hnot
    exact Real.rpow_nonneg (norm_nonneg _) _
  calc
    n / 12 * (S / 2) ^ (p / 2) ≤
        (good.card : Real) * (S / 2) ^ (p / 2) :=
          mul_le_mul_of_nonneg_right hgoodcard (Real.rpow_nonneg (by positivity) _)
    _ ≤ ∑ u ∈ good, ‖rademacherSignedSum s u z‖ ^ p := hgoodmoment
    _ ≤ ∑ u ∈ s.powerset, ‖rademacherSignedSum s u z‖ ^ p := hfullmoment

private theorem integral_rademacher_lower_moment
    {I X : Type*} [DecidableEq I] [MeasurableSpace X]
    (μ : Measure X) (s : Finset I) (g : I → X → Complex)
    {p : Real} (hp : 0 ≤ p)
    (hsign : ∀ u ∈ s.powerset,
      Integrable (fun x => ‖rademacherSignedSum s u (fun i => g i x)‖ ^ p) μ) :
    (s.powerset.card : Real) / 12 *
        (∫ x, (finiteSquareEnergy s g x / 2) ^ (p / 2) ∂μ) ≤
      ∑ u ∈ s.powerset,
        ∫ x, ‖rademacherSignedSum s u (fun i => g i x)‖ ^ p ∂μ := by
  have henergy_nonneg (x : X) : 0 ≤ finiteSquareEnergy s g x := by
    dsimp [finiteSquareEnergy]
    exact Finset.sum_nonneg fun i hi => sq_nonneg _
  have hright : Integrable (fun x =>
      ∑ u ∈ s.powerset,
        ‖rademacherSignedSum s u (fun i => g i x)‖ ^ p) μ :=
    integrable_finsetSum s.powerset hsign
  have hpoint (x : X) :
      (s.powerset.card : Real) / 12 *
          (finiteSquareEnergy s g x / 2) ^ (p / 2) ≤
        ∑ u ∈ s.powerset,
          ‖rademacherSignedSum s u (fun i => g i x)‖ ^ p := by
    simpa only [finiteSquareEnergy] using
      rademacher_lower_moment s (fun i => g i x) hp
  calc
    (s.powerset.card : Real) / 12 *
        (∫ x, (finiteSquareEnergy s g x / 2) ^ (p / 2) ∂μ) =
          ∫ x, (s.powerset.card : Real) / 12 *
            (finiteSquareEnergy s g x / 2) ^ (p / 2) ∂μ := by
              rw [integral_const_mul]
    _ ≤ ∫ x, ∑ u ∈ s.powerset,
        ‖rademacherSignedSum s u (fun i => g i x)‖ ^ p ∂μ := by
          apply integral_mono_of_nonneg
          · exact Filter.Eventually.of_forall fun x =>
              mul_nonneg (by positivity)
                (Real.rpow_nonneg (div_nonneg (henergy_nonneg x) (by norm_num)) _)
          · exact hright
          · exact Filter.Eventually.of_forall hpoint
    _ = ∑ u ∈ s.powerset,
        ∫ x, ‖rademacherSignedSum s u (fun i => g i x)‖ ^ p ∂μ := by
          rw [integral_finsetSum s.powerset hsign]

/-- Uniform finite signed `Lᵖ` estimates for homogeneous dyadic projections.
The constant is independent of both the finite scale set and the signs. -/
def HasUniformFiniteRademacherIntegerDyadicLp {d : Nat} (C : lpCutoffs d)
    (p : Real) : Prop :=
  ∃ B : Real, 0 < B ∧ ∀ (K u : Finset Int)
    (f : SchwartzMap (Euclidean d) Complex), u ∈ K.powerset →
      Integrable (fun x => ‖finiteRademacherIntegerDyadicSum C K u f x‖ ^ p) volume ∧
        (∫ x, ‖finiteRademacherIntegerDyadicSum C K u f x‖ ^ p) ≤
          B * ∫ x, ‖f x‖ ^ p

/-- The scalar signed-multiplier datum needed for all finite `Lᵖ`
Littlewood--Paley square-function estimates. -/
def HasUniformFiniteRademacherIntegerDyadicLpAll {d : Nat} (C : lpCutoffs d) : Prop :=
  ∀ p : Real, 1 < p → HasUniformFiniteRademacherIntegerDyadicLp C p

/-- Uniform scalar signed `Lᵖ` estimates imply the dimension-generic finite
Littlewood--Paley theorem for every `1 < p < ∞`. -/
theorem littlewoodPaley_of_uniform_signed {d : Nat}
    (C : lpCutoffs d) (hsigned : HasUniformFiniteRademacherIntegerDyadicLpAll C) :
    littlewoodPaley C := by
  intro p hp
  rcases hsigned p hp with ⟨B, hB, hsigned⟩
  let q : Real := p / 2
  let A : Real := 12 * (2 : Real) ^ q * B
  have htwoq : 0 < (2 : Real) ^ q := Real.rpow_pos_of_pos (by norm_num) _
  have hA : 0 < A := by
    dsimp [A]
    positivity
  refine ⟨A, hA, ?_⟩
  intro K f
  have hq : 0 ≤ p := by linarith
  have hsign : ∀ u ∈ K.powerset,
      Integrable (fun x =>
        ‖rademacherSignedSum K u
          (fun k => integerDyadicProjection C.cutoff k f x)‖ ^ p) volume := by
    intro u hu
    simpa only [finiteRademacherIntegerDyadicSum] using (hsigned K u f hu).1
  have hmoment := integral_rademacher_lower_moment volume K
    (fun k x => integerDyadicProjection C.cutoff k f x) hq hsign
  have hsumBound :
      (∑ u ∈ K.powerset,
        ∫ x : Euclidean d,
          ‖rademacherSignedSum K u
            (fun k => integerDyadicProjection C.cutoff k f x)‖ ^ p) ≤
        (K.powerset.card : Real) *
          (B * ∫ x : Euclidean d, ‖f x‖ ^ p) := by
    calc
      (∑ u ∈ K.powerset,
        ∫ x : Euclidean d,
          ‖rademacherSignedSum K u
            (fun k => integerDyadicProjection C.cutoff k f x)‖ ^ p) ≤
          ∑ u ∈ K.powerset,
            (B * ∫ x : Euclidean d, ‖f x‖ ^ p) := by
              apply Finset.sum_le_sum
              intro u hu
              simpa only [finiteRademacherIntegerDyadicSum] using (hsigned K u f hu).2
      _ = (K.powerset.card : Real) *
          (B * ∫ x : Euclidean d, ‖f x‖ ^ p) := by
            rw [Finset.sum_const, nsmul_eq_mul]
  have hcard : 0 < (K.powerset.card : Real) := by positivity
  have hhalf :
      (∫ x : Euclidean d,
        (finiteIntegerDyadicSquareEnergy C K f x / 2) ^ q) / 12 ≤
        B * ∫ x : Euclidean d, ‖f x‖ ^ p := by
    have hfactor :
        (K.powerset.card : Real) *
            ((∫ x : Euclidean d,
              (finiteIntegerDyadicSquareEnergy C K f x / 2) ^ q) / 12) ≤
          (K.powerset.card : Real) *
            (B * ∫ x : Euclidean d, ‖f x‖ ^ p) := by
      calc
        (K.powerset.card : Real) *
            ((∫ x : Euclidean d,
              (finiteIntegerDyadicSquareEnergy C K f x / 2) ^ q) / 12) =
            (K.powerset.card : Real) / 12 *
              (∫ x : Euclidean d,
                (finiteIntegerDyadicSquareEnergy C K f x / 2) ^ q) := by ring
        _ ≤ ∑ u ∈ K.powerset,
            ∫ x : Euclidean d,
              ‖rademacherSignedSum K u
                (fun k => integerDyadicProjection C.cutoff k f x)‖ ^ p := by
              simpa only [finiteIntegerDyadicSquareEnergy] using hmoment
        _ ≤ (K.powerset.card : Real) *
            (B * ∫ x : Euclidean d, ‖f x‖ ^ p) := hsumBound
    exact le_of_mul_le_mul_left hfactor hcard
  have henergy_nonneg (x : Euclidean d) :
      0 ≤ finiteIntegerDyadicSquareEnergy C K f x := by
    dsimp [finiteIntegerDyadicSquareEnergy, finiteSquareEnergy]
    exact Finset.sum_nonneg fun k hk => sq_nonneg _
  have hscale (x : Euclidean d) :
      finiteIntegerDyadicSquareEnergy C K f x ^ q =
        (2 : Real) ^ q *
          (finiteIntegerDyadicSquareEnergy C K f x / 2) ^ q := by
    rw [Real.div_rpow (henergy_nonneg x) (by norm_num)]
    field_simp
  have hscaled := mul_le_mul_of_nonneg_left hhalf
    (show 0 ≤ 12 * (2 : Real) ^ q by positivity)
  calc
    (∫ x : Euclidean d,
      finiteIntegerDyadicSquareEnergy C K f x ^ (p / 2)) =
        (∫ x : Euclidean d,
          (2 : Real) ^ q *
            (finiteIntegerDyadicSquareEnergy C K f x / 2) ^ q) := by
              apply integral_congr_ae
              filter_upwards with x
              rw [hscale]
    _ = (2 : Real) ^ q *
        (∫ x : Euclidean d,
          (finiteIntegerDyadicSquareEnergy C K f x / 2) ^ q) := by
            rw [integral_const_mul]
    _ = (12 * (2 : Real) ^ q) *
        ((∫ x : Euclidean d,
          (finiteIntegerDyadicSquareEnergy C K f x / 2) ^ q) / 12) := by ring
    _ ≤ (12 * (2 : Real) ^ q) *
        (B * ∫ x : Euclidean d, ‖f x‖ ^ p) := hscaled
    _ = A * ∫ x : Euclidean d, ‖f x‖ ^ p := by
      dsimp [A]
      ring


end

