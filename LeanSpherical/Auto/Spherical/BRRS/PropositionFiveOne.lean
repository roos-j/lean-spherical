  rw [Finset.sum_congr rfl (fun t _ => hdist t)]
  simp only [Finset.sum_add_distrib]
  calc
    _ ≤ ((∑ m ∈ Finset.range j, ∑ t ∈ T,
            ∫⁻ r in Icc (brrsDyadicRadialBlockRadius j m : Real)
              (2 * (brrsDyadicRadialBlockRadius j m : Real)), W r *
