      ENNReal.ofReal C * (delta : ENNReal) ^
        (-(theta * alpha + (1 - eta) * gamma)) := by
  have hdelta_real : 0 < (delta : Real) := by exact_mod_cast hdelta
  have hdelta_zero : (delta : ENNReal) ≠ 0 :=
    ne_of_gt (by exact_mod_cast hdelta)
  have hratio_pos : 0 < ((delta : Real) ^ eta) / (delta : Real) :=
    div_pos (Real.rpow_pos_of_pos hdelta_real _) hdelta_real
  have hRenn : (R.1 : ENNReal) = (delta : ENNReal) ^ theta := by
    calc
      (R.1 : ENNReal) = ENNReal.ofReal (R.1 : Real) := by simp
      _ = ENNReal.ofReal ((delta : Real) ^ theta) := by rw [hR]
      _ = (delta : ENNReal) ^ theta := by
        rw [(ENNReal.ofReal_rpow_of_pos (x := (delta : Real)) (p := theta)
          hdelta_real).symm]
        simp
  have hratio : ENNReal.ofReal (((delta : Real) ^ eta) / (delta : Real)) =
      (delta : ENNReal) ^ eta / (delta : ENNReal) := by
    rw [ENNReal.ofReal_div_of_pos hdelta_real,
      (ENNReal.ofReal_rpow_of_pos (x := (delta : Real)) (p := eta)
        hdelta_real).symm]
    simp
  have hratio_pow :
      ((delta : ENNReal) ^ eta / (delta : ENNReal)) ^ gamma =
        (delta : ENNReal) ^ ((eta - 1) * gamma) := by
    calc
      ((delta : ENNReal) ^ eta / (delta : ENNReal)) ^ gamma =
