/-- The extended-real form of the literal BRRS exponent.  The paper's
real-valued quantity is its `toReal`, after the elementary finiteness bounds
proved below. -/
def brrsLegendreAssouadExponent (E : Set ℝ) (α : ℝ) : EReal :=
  Filter.limsup (fun δ : NNReal ↦
    entropyLogQuotient (brrsLegendreAssouadProfile E α δ) δ)
    (𝓝[>] 0)

/-- The original literal definition is the real representative of the named
finite-scale BRRS entropy exponent. -/
theorem brrsLegendreAssouadFunction_eq_exponent_toReal (E : Set ℝ) (α : ℝ) :
    brrsLegendreAssouadFunction E α =
      (brrsLegendreAssouadExponent E α).toReal := rfl

/-- The equality-scale Assouad-spectrum covering condition in BRRS (1.8).

For each scale `δ`, only intervals of the exact length `δ^θ` are tested.
This is intentionally distinct from the repository's pre-existing upper
Assouad spectrum, which permits every interval of length at least `δ^θ`. -/
def HasBRRSAssouadSpectrumExponent (E : Set ℝ) (θ γ : ℝ) : Prop :=
  ∃ C : ℝ, 0 < C ∧ ∀ δ : ℝ≥0, 0 < δ → δ < 1 → ∀ a : ℝ,
    brrsEntropyNumber (E ∩ brrsInterval a ((δ : ℝ) ^ θ)) δ ≤
      ENNReal.ofReal (C * ((((δ : ℝ) ^ θ) / (δ : ℝ)) ^ γ))

/-- The equality-scale Assouad spectrum used in BRRS. -/
noncomputable def brrsAssouadSpectrum (E : Set ℝ) (θ : ℝ) : ℝ :=
  sInf {γ : ℝ | 0 < γ ∧ HasBRRSAssouadSpectrumExponent E θ γ}

/-- The function `ν_E(θ)=-(1-θ) dim_{A,θ} E` appearing in BRRS (1.8).

At `θ = 1` the continuous extension has value zero, which is the only value
needed by the transform on `[0,1]`. -/
def brrsAssouadPotential (E : Set ℝ) (θ : ℝ) : ℝ :=
  if θ = 1 then 0 else -(1 - θ) * brrsAssouadSpectrum E θ

/-- The Legendre transform `ν_E^*` from BRRS (1.7)--(1.8). -/
noncomputable def brrsAssouadLegendreTransform (E : Set ℝ) (α : ℝ) : ℝ :=
  sSup ((fun θ : ℝ => θ * α - brrsAssouadPotential E θ) '' Icc (0 : ℝ) 1)

/-- The class of functions in the realization assertion of BRRS Theorem 1.2(ii).

Lean represents a map `[0,∞) → [0,∞)` by a real-valued function together
with its nonnegativity on `Ici 0`. -/
def IsBRRSLegendreAssouadProfile (τ : ℝ → ℝ) : Prop :=
  (∀ α : ℝ, 0 ≤ α → 0 ≤ τ α) ∧
    MonotoneOn τ (Ici (0 : ℝ)) ∧ ConvexOn ℝ (Ici (0 : ℝ)) τ ∧
      ∀ α : ℝ, 1 ≤ α → τ α = α

/-- The equality assertion in BRRS Theorem 1.2(i), recorded with its literal
Euclidean definitions.  The nonempty qualification is necessary for this
`ENNReal.log` encoding of the entropy number; it excludes its degenerate
empty-set convention. -/
def BRRSTheoremOnePointTwoPartOneStatement : Prop :=
  ∀ E : Set ℝ, E.Nonempty → Bornology.IsBounded E →
    ∀ α : ℝ, brrsLegendreAssouadFunction E α =
      brrsAssouadLegendreTransform E α

/-- The realization assertion in BRRS Theorem 1.2(ii), recorded with its
literal Euclidean definitions.  Nonemptiness is necessary here because this
formalization represents the covering number of the empty set by zero, while
the paper's nondegenerate dimensional convention is used in the conclusion. -/
def BRRSTheoremOnePointTwoPartTwoStatement : Prop :=
  ∀ τ : ℝ → ℝ,
    IsBRRSLegendreAssouadProfile τ ↔
      ∃ E : Set ℝ, E.Nonempty ∧ Bornology.IsBounded E ∧
        ∀ α : ℝ, 0 ≤ α → brrsLegendreAssouadFunction E α = τ α

/-- The complete statement of BRRS Theorem 1.2. -/
def BRRSTheoremOnePointTwoStatement : Prop :=
  BRRSTheoremOnePointTwoPartOneStatement ∧
    BRRSTheoremOnePointTwoPartTwoStatement

/-! ### Rutar spectrum-realization interface -/

/-- The structural conditions in Rutar's Corollary B, written in the
potential convention used by BRRS. Thus the spectrum is increasing and its
weighted negative potential is increasing on the open unit interval. -/
def IsRutarAssouadSpectrum (gamma : Real → Real) : Prop :=
  (∀ theta : Real, theta ∈ Ioo (0 : Real) 1 →
    0 ≤ gamma theta ∧ gamma theta ≤ 1) ∧
    MonotoneOn gamma (Ioo (0 : Real) 1) ∧
      MonotoneOn (fun theta : Real => -(1 - theta) * gamma theta)
        (Ioo (0 : Real) 1)

/-- A bounded nonempty set realizing a spectrum in the exact interval
convention of the BRRS development.  Rutar's Corollary B prescribes the
spectrum only on the open parameter interval, so the endpoint `theta = 0`
is deliberately not bundled into this interface.  Its compatibility with
the closed BRRS transform is derived separately from continuity below. -/
def HasBRRSSpectrumRealization (gamma : Real → Real) : Prop :=
  ∃ E : Set Real, E.Nonempty ∧ Bornology.IsBounded E ∧
    ∀ theta : Real, 0 < theta → theta < 1 →
      brrsAssouadSpectrum E theta = gamma theta

/-- The endpoint-compatible realization statement needed to import Rutar's
variable-ratio Moran construction into BRRS. This is deliberately a
statement object, not an axiom: its proof requires the missing Moran-set
covering construction and the interval/ball normalization comparison. -/
def BRRSRutarCorollaryBStatement : Prop :=
  ∀ gamma : Real → Real, IsRutarAssouadSpectrum gamma →
    HasBRRSSpectrumRealization gamma

end
end BRRSDefinitions

/-! ### Additive entropy primitives for the BRRS spectrum -/

section BRRSAdditiveEntropy

open Filter Set
open scoped ENNReal NNReal Topology

/-- BRRS covering numbers are monotone under restriction of the underlying
set. -/
theorem brrsEntropyNumber_mono {E F : Set Real} (hEF : E ⊆ F) (delta : NNReal) :
    brrsEntropyNumber E delta ≤ brrsEntropyNumber F delta := by
  unfold brrsEntropyNumber
  exact_mod_cast Metric.externalCoveringNumber_mono_set hEF

/-- Enlarging the covering radius can only decrease the BRRS covering number. -/
theorem brrsEntropyNumber_anti {E : Set Real} {delta eta : NNReal}
    (hdelta : delta ≤ eta) :
    brrsEntropyNumber E eta ≤ brrsEntropyNumber E delta := by
  unfold brrsEntropyNumber
  exact_mod_cast Metric.externalCoveringNumber_anti (by gcongr)

@[simp]
theorem brrsEntropyNumber_empty (delta : NNReal) :
    brrsEntropyNumber (∅ : Set Real) delta = 0 := by
  simp [brrsEntropyNumber]

/-- Enlarging the time set can only enlarge the literal finite-scale BRRS
Legendre--Assouad profile. -/
theorem brrsLegendreAssouadProfile_mono {E F : Set Real} (hEF : E ⊆ F)
    (alpha : Real) (delta : NNReal) :
    brrsLegendreAssouadProfile E alpha delta ≤
    brrsLegendreAssouadProfile F alpha delta := by
  unfold brrsLegendreAssouadProfile
  apply iSup_mono
  intro a
  apply iSup_mono
  intro R
  gcongr
  exact brrsEntropyNumber_mono (inter_subset_inter hEF Subset.rfl) delta

/-- Increasing the interval penalty can only increase the literal BRRS
finite-scale entropy profile. -/
theorem brrsLegendreAssouadProfile_mono_alpha (E : Set Real)
    {alpha beta : Real} (halpha_beta : alpha ≤ beta) (delta : NNReal) :
    brrsLegendreAssouadProfile E alpha delta ≤
      brrsLegendreAssouadProfile E beta delta := by
  unfold brrsLegendreAssouadProfile
  apply iSup_mono
  intro a
  apply iSup_mono
  intro R
  simpa only [mul_comm] using
    (mul_le_mul_right
      (ENNReal.rpow_le_rpow_of_exponent_ge
        (by exact_mod_cast R.2.2) (by linarith : -beta ≤ -alpha))
      (brrsEntropyNumber (E ∩ brrsInterval a (R.1 : Real)) delta))

/-- A nonempty set has at least one BRRS covering cell at every scale. -/
theorem one_le_brrsEntropyNumber_of_nonempty {E : Set Real}
    (hE : E.Nonempty) (delta : NNReal) :
    1 ≤ brrsEntropyNumber E delta := by
  unfold brrsEntropyNumber
  exact_mod_cast
    (Order.one_le_iff_ne_zero.mpr
      (ne_of_gt (Metric.externalCoveringNumber_pos_iff.mpr hE) :
        Metric.externalCoveringNumber (delta / 2) E ≠ 0))

/-- Each exact-scale local entropy term is bounded by the source's supremal
covering number. -/
theorem brrsEntropyNumber_le_brrsAssouadScaleCoveringNumber
    (E : Set Real) (delta : NNReal) (theta a : Real) :
    brrsEntropyNumber (E ∩ brrsInterval a ((delta : Real) ^ theta)) delta ≤
      brrsAssouadScaleCoveringNumber E delta theta := by
  unfold brrsAssouadScaleCoveringNumber
  exact le_iSup (fun a : Real =>
    brrsEntropyNumber (E ∩ brrsInterval a ((delta : Real) ^ theta)) delta) a

/-- A nonempty set has at least one exact-scale local covering cell, uniformly
over the source parameters. -/
theorem one_le_brrsAssouadScaleCoveringNumber_of_nonempty
    {E : Set Real} (hE : E.Nonempty) (delta : NNReal) (theta : Real) :
    1 ≤ brrsAssouadScaleCoveringNumber E delta theta := by
  rcases hE with ⟨x, hx⟩
  have hlocal : (E ∩ brrsInterval x ((delta : Real) ^ theta)).Nonempty := by
    refine ⟨x, hx, ?_⟩
    simp only [brrsInterval, mem_Icc]
    constructor
    · exact le_rfl
    · exact le_add_of_nonneg_right (Real.rpow_nonneg delta.2 _)
  exact (one_le_brrsEntropyNumber_of_nonempty hlocal delta).trans
    (brrsEntropyNumber_le_brrsAssouadScaleCoveringNumber E delta theta x)

/-- The source's weighted finite-scale entropy is nonnegative for nonempty
sets at the scales where its logarithmic denominator is positive. -/
theorem brrsAssouadWeightedEntropy_nonneg_of_nonempty
    {E : Set Real} (hE : E.Nonempty) {delta : NNReal} (hdelta_zero : 0 < delta)
    (hdelta_one : delta < 1) (theta : Real) :
    0 ≤ brrsAssouadWeightedEntropy E delta theta := by
  unfold brrsAssouadWeightedEntropy entropyLogQuotient
  have hone : (1 : ENNReal) ≤ brrsAssouadScaleCoveringNumber E delta theta :=
    one_le_brrsAssouadScaleCoveringNumber_of_nonempty hE delta theta
  have hlog : (0 : EReal) ≤
      ENNReal.log (brrsAssouadScaleCoveringNumber E delta theta) := by
    calc
      (0 : EReal) = ENNReal.log 1 := ENNReal.log_one.symm
      _ ≤ ENNReal.log (brrsAssouadScaleCoveringNumber E delta theta) :=
        ENNReal.log_le_log hone
  have hdelta_real_zero : 0 < (delta : Real) := by exact_mod_cast hdelta_zero
  have hdelta_real_one : (delta : Real) < 1 := by exact_mod_cast hdelta_one
  have hloginv : 0 < Real.log ((delta : Real)⁻¹) := by
    apply Real.log_pos
    exact (one_lt_inv₀ hdelta_real_zero).mpr hdelta_real_one
  have hden : 0 ≤ (Real.log ((delta : Real)⁻¹) : EReal) := by
    exact_mod_cast hloginv.le
  exact EReal.div_nonneg hlog hden

/-- The elementary power conversion at an exact Assouad-spectrum testing
scale.  It is the algebra that turns the covering factor
`(δ^θ / δ)^γ` into the weighted entropy exponent `(1 - θ)γ`. -/
theorem brrsAssouadScale_power_identity {theta gamma C : Real}
    (htheta_zero : 0 ≤ theta) (htheta_one : theta ≤ 1) (hC : 0 ≤ C)
    {delta : NNReal} (hdelta_zero : 0 < delta) (hdelta_one : delta < 1) :
    ENNReal.ofReal (C * ((((delta : Real) ^ theta) / (delta : Real)) ^ gamma)) =
      ENNReal.ofReal C * (delta : ENNReal) ^ (-((1 - theta) * gamma)) := by
  have hdelta_real_zero : 0 < (delta : Real) := by exact_mod_cast hdelta_zero
  have hdelta_real_one : (delta : Real) ≤ 1 := by
    exact_mod_cast hdelta_one.le
  have hscale_real : (delta : Real) ≤ (delta : Real) ^ theta := by
    calc
      (delta : Real) = (delta : Real) ^ (1 : Real) := by rw [Real.rpow_one]
      _ ≤ (delta : Real) ^ theta :=
        Real.rpow_le_rpow_of_exponent_ge hdelta_real_zero hdelta_real_one htheta_one
  have hR_one_real : (delta : Real) ^ theta ≤ 1 :=
    Real.rpow_le_one hdelta_real_zero.le hdelta_real_one htheta_zero
  have hscale : delta ≤ delta ^ theta := by
    apply NNReal.coe_le_coe.mp
    simpa only [NNReal.coe_rpow] using hscale_real
  have hR_one : delta ^ theta ≤ 1 := by
    apply NNReal.coe_le_coe.mp
    simpa only [NNReal.coe_rpow, NNReal.coe_one] using hR_one_real
  let R : Icc delta 1 := ⟨delta ^ theta, hscale, hR_one⟩
  have hR : (R.1 : Real) = (delta : Real) ^ theta := by
    simp only [R, NNReal.coe_rpow]
  have hpower := brrs_weighted_entropy_power_identity (delta := delta)
    hdelta_zero (R := R) (theta := theta) (eta := theta) (gamma := gamma)
      (alpha := 0) (C := C) hR hC
  calc
    ENNReal.ofReal (C * ((((delta : Real) ^ theta) / (delta : Real)) ^ gamma)) =
        (R.1 : ENNReal) ^ (-(0 : Real)) *
          ENNReal.ofReal (C * ((((delta : Real) ^ theta) / (delta : Real)) ^ gamma)) := by
      simp
    _ = ENNReal.ofReal C * (delta : ENNReal) ^
        (-(theta * (0 : Real) + (1 - theta) * gamma)) := hpower
    _ = ENNReal.ofReal C * (delta : ENNReal) ^ (-((1 - theta) * gamma)) := by
      congr 2
      ring

/-- A uniform equality-scale cover controls the source's single-scale
supremum.  This is the direct finite-scale implication used in the upper
half of `limsup φ = γ`; no upper-spectrum comparison is used. -/
theorem brrsAssouadScaleCoveringNumber_le_of_cover
    (E : Set Real) {theta gamma C : Real} (htheta_zero : 0 ≤ theta)
    (htheta_one : theta ≤ 1) (hC : 0 ≤ C)
    (hcover : ∀ delta : NNReal, 0 < delta → delta < 1 → ∀ a : Real,
      brrsEntropyNumber (E ∩ brrsInterval a ((delta : Real) ^ theta)) delta ≤
        ENNReal.ofReal (C * ((((delta : Real) ^ theta) / (delta : Real)) ^ gamma)))
    {delta : NNReal} (hdelta_zero : 0 < delta) (hdelta_one : delta < 1) :
    brrsAssouadScaleCoveringNumber E delta theta ≤
      ENNReal.ofReal C *
        (delta : ENNReal) ^ (-((1 - theta) * gamma)) := by
  unfold brrsAssouadScaleCoveringNumber
  apply iSup_le
  intro a
  calc
    brrsEntropyNumber (E ∩ brrsInterval a ((delta : Real) ^ theta)) delta ≤
        ENNReal.ofReal (C * ((((delta : Real) ^ theta) / (delta : Real)) ^ gamma)) :=
      hcover delta hdelta_zero hdelta_one a
    _ = ENNReal.ofReal C * (delta : ENNReal) ^ (-((1 - theta) * gamma)) :=
      brrsAssouadScale_power_identity htheta_zero htheta_one hC hdelta_zero hdelta_one

/-- Every admissible exponent in the definition of `γ_E(θ)` gives the
corresponding upper bound for the weighted finite-scale entropy limsup. -/
theorem brrsAssouadWeightedEntropy_limsup_le_of_hasBRRSAssouadSpectrumExponent
    (E : Set Real) {theta gamma : Real} (htheta_zero : 0 ≤ theta)
    (htheta_one : theta ≤ 1)
    (hgamma : HasBRRSAssouadSpectrumExponent E theta gamma) :
    Filter.limsup (fun delta : NNReal =>
      brrsAssouadWeightedEntropy E delta theta) (𝓝[>] (0 : NNReal)) ≤
      (((1 - theta) * gamma : Real) : EReal) := by
  rcases hgamma with ⟨C, hC, hcover⟩
  unfold brrsAssouadWeightedEntropy
  apply limsup_entropyLogQuotient_le_of_power_bound
    (N := fun delta => brrsAssouadScaleCoveringNumber E delta theta)
    (A := ENNReal.ofReal C) (s := (1 - theta) * gamma)
  · exact ENNReal.ofReal_ne_top
  · have hsmall : ∀ᶠ delta : NNReal in 𝓝[>] (0 : NNReal),
        delta ∈ Ioo 0 1 :=
      nhdsGT_basis 0 |>.mem_of_mem zero_lt_one
    filter_upwards [hsmall] with delta hdelta
    exact brrsAssouadScaleCoveringNumber_le_of_cover E htheta_zero htheta_one
      hC.le hcover hdelta.1 hdelta.2

/-- A nonempty set contributes the pure scale penalty to the BRRS profile:
take the testing interval to have the same length as the covering scale. -/
theorem inv_rpow_le_brrsLegendreAssouadProfile_of_nonempty
    {E : Set Real} (hE : E.Nonempty) (alpha : Real) {delta : NNReal}
    (hdelta : delta ≤ 1) :
    (delta : ENNReal) ^ (-alpha) ≤
      brrsLegendreAssouadProfile E alpha delta := by
  rcases hE with ⟨x, hx⟩
  let R : Icc delta 1 := ⟨delta, le_rfl, hdelta⟩
  have hx_local : x ∈ E ∩ brrsInterval x (R.1 : Real) := by
    constructor
    · exact hx
    · simp only [brrsInterval, mem_Icc]
      constructor
      · exact le_rfl
      · dsimp [R]
        exact le_add_of_nonneg_right delta.2
  have hone : (1 : ENNReal) ≤
      brrsEntropyNumber (E ∩ brrsInterval x (R.1 : Real)) delta :=
    one_le_brrsEntropyNumber_of_nonempty ⟨x, hx_local⟩ delta
  calc
    (delta : ENNReal) ^ (-alpha) = (R.1 : ENNReal) ^ (-alpha) * 1 := by
      simp [R]
    _ ≤ (R.1 : ENNReal) ^ (-alpha) *
        brrsEntropyNumber (E ∩ brrsInterval x (R.1 : Real)) delta := by
      gcongr
    _ ≤ brrsLegendreAssouadProfile E alpha delta := by
      unfold brrsLegendreAssouadProfile
      exact le_iSup_of_le x (le_iSup_of_le R (le_refl _))

/-- Eventual quotient bounds can be passed directly to the named literal
BRRS exponent. -/
theorem brrsLegendreAssouadExponent_le_of_eventually_entropyLogQuotient_le
    {E : Set Real} {alpha : Real} {s : EReal}
    (h : ∀ᶠ delta : NNReal in 𝓝[>] (0 : NNReal),
      entropyLogQuotient (brrsLegendreAssouadProfile E alpha delta) delta ≤ s) :
    brrsLegendreAssouadExponent E alpha ≤ s := by
  exact Filter.limsup_le_of_le (h := h)

/-- Arbitrarily small lower bounds for the literal BRRS entropy quotient
pass to its extended-real exponent. -/
theorem le_brrsLegendreAssouadExponent_of_frequently_le_entropyLogQuotient
    {E : Set Real} {alpha : Real} {s : EReal}
    (h : ∃ᶠ delta : NNReal in 𝓝[>] (0 : NNReal),
      s ≤ entropyLogQuotient (brrsLegendreAssouadProfile E alpha delta) delta) :
    s ≤ brrsLegendreAssouadExponent E alpha := by
  exact Filter.le_limsup_of_frequently_le h

/-- The literal BRRS exponent dominates its penalty parameter for a nonempty
time set. -/
theorem le_brrsLegendreAssouadExponent_of_nonempty {E : Set Real}
    (hE : E.Nonempty) (alpha : Real) :
    (alpha : EReal) ≤ brrsLegendreAssouadExponent E alpha := by
  apply le_brrsLegendreAssouadExponent_of_frequently_le_entropyLogQuotient
  have hsmall : ∀ᶠ delta : NNReal in 𝓝[>] (0 : NNReal),
      delta ∈ Ioo 0 1 :=
    nhdsGT_basis 0 |>.mem_of_mem zero_lt_one
  exact (hsmall.mono fun delta hdelta =>
    calc
      (alpha : EReal) =
          entropyLogQuotient ((delta : ENNReal) ^ (-alpha)) delta :=
        (entropyLogQuotient_inv_rpow hdelta.1 hdelta.2).symm
      _ ≤ entropyLogQuotient (brrsLegendreAssouadProfile E alpha delta) delta :=
        entropyLogQuotient_mono hdelta.1 hdelta.2
          (inv_rpow_le_brrsLegendreAssouadProfile_of_nonempty hE alpha hdelta.2.le)).frequently

/-- The literal BRRS exponent is nondecreasing in its penalty parameter. -/
theorem brrsLegendreAssouadExponent_mono (E : Set Real)
    {alpha beta : Real} (halpha_beta : alpha ≤ beta) :
    brrsLegendreAssouadExponent E alpha ≤
      brrsLegendreAssouadExponent E beta := by
  change Filter.limsup
      (fun delta : NNReal => entropyLogQuotient
        (brrsLegendreAssouadProfile E alpha delta) delta)
      (𝓝[>] (0 : NNReal)) ≤
    Filter.limsup
      (fun delta : NNReal => entropyLogQuotient
        (brrsLegendreAssouadProfile E beta delta) delta)
      (𝓝[>] (0 : NNReal))
  rw [← Filter.blimsup_true, ← Filter.blimsup_true]
  apply Filter.mono_blimsup'
  have hsmall : ∀ᶠ delta : NNReal in 𝓝[>] (0 : NNReal), delta ∈ Ioo 0 1 :=
    nhdsGT_basis 0 |>.mem_of_mem zero_lt_one
  filter_upwards [hsmall] with delta hdelta _
  exact entropyLogQuotient_mono hdelta.1 hdelta.2
    (brrsLegendreAssouadProfile_mono_alpha E halpha_beta delta)

/-- A nonempty time set prevents the literal BRRS exponent from taking the
lower extended-real value. -/
theorem brrsLegendreAssouadExponent_ne_bot_of_nonempty {E : Set Real}
    (hE : E.Nonempty) (alpha : Real) :
    brrsLegendreAssouadExponent E alpha ≠ ⊥ := by
  intro hbot
  have hlow := le_brrsLegendreAssouadExponent_of_nonempty hE alpha
  rw [hbot] at hlow
  exact (not_le_of_gt (EReal.bot_lt_coe alpha)) hlow

/-- Additive BRRS intervals are monotone in their length. -/
theorem brrsInterval_mono {a R S : Real} (hRS : R ≤ S) :
    brrsInterval a R ⊆ brrsInterval a S := by
  intro x hx
  simp only [brrsInterval, mem_Icc] at hx ⊢
  constructor
  · exact hx.1
  · linarith

/-- Restricting the time set or enlarging the time interval can only increase
the local BRRS covering number. -/
theorem brrsEntropyNumber_inter_interval_mono {E F : Set Real} (hEF : E ⊆ F)
    {a R S : Real} (hRS : R ≤ S) (delta : NNReal) :
    brrsEntropyNumber (E ∩ brrsInterval a R) delta ≤
    brrsEntropyNumber (F ∩ brrsInterval a S) delta := by
  apply brrsEntropyNumber_mono
  exact inter_subset_inter hEF (brrsInterval_mono hRS)

/-- A cover at a smaller power parameter controls a weighted profile term at
every larger power parameter.  The resulting exponent is the expected affine
quantity `θ * α + (1 - η) * γ`. -/
theorem exists_brrs_weighted_entropy_term_le_of_parameter_le
    (E : Set Real) {delta : NNReal} (hdelta : 0 < delta)
    (hdelta_one : delta < 1) {R : Icc delta 1}
    {theta eta gamma alpha B : Real}
    (hR : (R.1 : Real) = (delta : Real) ^ theta)
    (heta_theta : eta ≤ theta)
    (hcover : HasBRRSAssouadSpectrumExponent E eta gamma)
    (hB : theta * alpha + (1 - eta) * gamma ≤ B) {a : Real} :
    ∃ C : Real, 0 < C ∧
      (R.1 : ENNReal) ^ (-alpha) *
        brrsEntropyNumber (E ∩ brrsInterval a (R.1 : Real)) delta ≤
          ENNReal.ofReal C * (delta : ENNReal) ^ (-B) := by
  rcases hcover with ⟨C, hC, hcover⟩
  refine ⟨C, hC, ?_⟩
  have hdelta_real : 0 < (delta : Real) := by exact_mod_cast hdelta
  have hdelta_one_real : (delta : Real) ≤ 1 := by exact_mod_cast hdelta_one.le
  have hlength : (delta : Real) ^ theta ≤ (delta : Real) ^ eta :=
    Real.rpow_le_rpow_of_exponent_ge hdelta_real hdelta_one_real heta_theta
  have hRlength : (R.1 : Real) ≤ (delta : Real) ^ eta := hR.trans_le hlength
  have hentropy : brrsEntropyNumber
      (E ∩ brrsInterval a (R.1 : Real)) delta ≤
      ENNReal.ofReal
        (C * ((((delta : Real) ^ eta) / (delta : Real)) ^ gamma)) := by
    calc
      brrsEntropyNumber (E ∩ brrsInterval a (R.1 : Real)) delta ≤
          brrsEntropyNumber
            (E ∩ brrsInterval a ((delta : Real) ^ eta)) delta := by
        exact brrsEntropyNumber_inter_interval_mono
          (E := E) (F := E) (a := a) (R := (R.1 : Real))
          (S := (delta : Real) ^ eta) (by rfl) hRlength delta
      _ ≤ ENNReal.ofReal
          (C * ((((delta : Real) ^ eta) / (delta : Real)) ^ gamma)) :=
        hcover delta hdelta hdelta_one a
  have hpower : (delta : ENNReal) ^
      (-(theta * alpha + (1 - eta) * gamma)) ≤
        (delta : ENNReal) ^ (-B) := by
    apply ENNReal.rpow_le_rpow_of_exponent_ge
    · exact_mod_cast hdelta_one.le
    · linarith
  calc
    (R.1 : ENNReal) ^ (-alpha) *
        brrsEntropyNumber (E ∩ brrsInterval a (R.1 : Real)) delta ≤
        (R.1 : ENNReal) ^ (-alpha) *
          ENNReal.ofReal
            (C * ((((delta : Real) ^ eta) / (delta : Real)) ^ gamma)) := by
      gcongr
    _ = ENNReal.ofReal C * (delta : ENNReal) ^
        (-(theta * alpha + (1 - eta) * gamma)) :=
      brrs_weighted_entropy_power_identity hdelta hR hC.le
    _ ≤ ENNReal.ofReal C * (delta : ENNReal) ^ (-B) := by gcongr

/-- The fixed-constant form of
`exists_brrs_weighted_entropy_term_le_of_parameter_le`.  It is arranged for
the compactness argument, where one selected spectrum cover must control all
nearby profile terms with the same multiplicative constant. -/
theorem brrs_weighted_entropy_term_le_of_parameter_le
    (E : Set Real) {delta : NNReal} (hdelta : 0 < delta)
    (hdelta_one : delta < 1) {R : Icc delta 1}
    {theta eta gamma alpha B C : Real}
    (hR : (R.1 : Real) = (delta : Real) ^ theta)
    (heta_theta : eta ≤ theta) (hC : 0 ≤ C)
    (hcover : ∀ d : NNReal, 0 < d → d < 1 → ∀ a : Real,
      brrsEntropyNumber (E ∩ brrsInterval a ((d : Real) ^ eta)) d ≤
        ENNReal.ofReal
          (C * ((((d : Real) ^ eta) / (d : Real)) ^ gamma)) )
    (hB : theta * alpha + (1 - eta) * gamma ≤ B) {a : Real} :
    (R.1 : ENNReal) ^ (-alpha) *
      brrsEntropyNumber (E ∩ brrsInterval a (R.1 : Real)) delta ≤
        ENNReal.ofReal C * (delta : ENNReal) ^ (-B) := by
  have hdelta_real : 0 < (delta : Real) := by exact_mod_cast hdelta
  have hdelta_one_real : (delta : Real) ≤ 1 := by exact_mod_cast hdelta_one.le
  have hlength : (delta : Real) ^ theta ≤ (delta : Real) ^ eta :=
    Real.rpow_le_rpow_of_exponent_ge hdelta_real hdelta_one_real heta_theta
  have hRlength : (R.1 : Real) ≤ (delta : Real) ^ eta := hR.trans_le hlength
  have hentropy : brrsEntropyNumber
      (E ∩ brrsInterval a (R.1 : Real)) delta ≤
      ENNReal.ofReal
        (C * ((((delta : Real) ^ eta) / (delta : Real)) ^ gamma)) := by
    calc
      brrsEntropyNumber (E ∩ brrsInterval a (R.1 : Real)) delta ≤
          brrsEntropyNumber
            (E ∩ brrsInterval a ((delta : Real) ^ eta)) delta := by
        exact brrsEntropyNumber_inter_interval_mono
          (E := E) (F := E) (a := a) (R := (R.1 : Real))
          (S := (delta : Real) ^ eta) (by rfl) hRlength delta
      _ ≤ ENNReal.ofReal
          (C * ((((delta : Real) ^ eta) / (delta : Real)) ^ gamma)) :=
        hcover delta hdelta hdelta_one a
  have hpower : (delta : ENNReal) ^
      (-(theta * alpha + (1 - eta) * gamma)) ≤
        (delta : ENNReal) ^ (-B) := by
    apply ENNReal.rpow_le_rpow_of_exponent_ge
    · exact_mod_cast hdelta_one.le
    · linarith
  calc
    (R.1 : ENNReal) ^ (-alpha) *
        brrsEntropyNumber (E ∩ brrsInterval a (R.1 : Real)) delta ≤
        (R.1 : ENNReal) ^ (-alpha) *
          ENNReal.ofReal
            (C * ((((delta : Real) ^ eta) / (delta : Real)) ^ gamma)) := by
      gcongr
    _ = ENNReal.ofReal C * (delta : ENNReal) ^
        (-(theta * alpha + (1 - eta) * gamma)) :=
      brrs_weighted_entropy_power_identity hdelta hR hC
    _ ≤ ENNReal.ofReal C * (delta : ENNReal) ^ (-B) := by gcongr

/-- A compact family of local exact-scale covers yields one eventual,
finite-constant bound for the whole literal BRRS profile.  This is the
finite-subcover step in the entropy-to-spectrum direction. -/
theorem eventually_brrsLegendreAssouadProfile_le_of_compact_parameter_bounds
    (E : Set Real) {alpha B : Real}
    (U : BRRSParameter → Set BRRSParameter)
    (eta gamma C : BRRSParameter → Real)
    (hU : ∀ x : BRRSParameter, U x ∈ 𝓝 x)
    (hC : ∀ x : BRRSParameter, 0 < C x)
    (hcover : ∀ x : BRRSParameter, ∀ d : NNReal, 0 < d → d < 1 →
      ∀ a : Real,
        brrsEntropyNumber (E ∩ brrsInterval a ((d : Real) ^ eta x)) d ≤
          ENNReal.ofReal
            (C x * ((((d : Real) ^ eta x) / (d : Real)) ^ gamma x)))
    (hlocal : ∀ x theta : BRRSParameter, theta ∈ U x →
      eta x ≤ theta.1 ∧
        theta.1 * alpha + (1 - eta x) * gamma x ≤ B) :
    ∃ M : Real, 0 < M ∧ ∀ᶠ delta : NNReal in 𝓝[>] (0 : NNReal),
      brrsLegendreAssouadProfile E alpha delta ≤
        ENNReal.ofReal M * (delta : ENNReal) ^ (-B) := by
  classical
  obtain ⟨s, hs, hsubcover, heventual⟩ :=
    Auto.ConvexDuality.IsCompact.exists_finset_nhds_subcover_eventually
      (X := BRRSParameter) (Y := NNReal) (K := Set.univ)
      isCompact_univ U (by intro x _; exact hU x)
      (fun x delta => ∀ a : Real,
        brrsEntropyNumber
            (E ∩ brrsInterval a ((delta : Real) ^ eta x)) delta ≤
          ENNReal.ofReal
            (C x * ((((delta : Real) ^ eta x) / (delta : Real)) ^ gamma x)))
      (by
        intro x _
        have hsmall : ∀ᶠ delta : NNReal in 𝓝[>] (0 : NNReal),
            delta ∈ Ioo 0 1 :=
          nhdsGT_basis 0 |>.mem_of_mem zero_lt_one
        filter_upwards [hsmall] with delta hdelta
        intro a
        exact hcover x delta hdelta.1 hdelta.2 a)
  obtain ⟨M, hM, hCM⟩ :=
    Auto.ConvexDuality.exists_pos_uniform_majorant_finset s C
  refine ⟨M, hM, ?_⟩
  have hsmall : ∀ᶠ delta : NNReal in 𝓝[>] (0 : NNReal),
      delta ∈ Ioo 0 1 :=
    nhdsGT_basis 0 |>.mem_of_mem zero_lt_one
  filter_upwards [heventual, hsmall] with delta hdelta hdelta_small
  unfold brrsLegendreAssouadProfile
  apply iSup_le
  intro a
  apply iSup_le
  intro R
  obtain ⟨theta, htheta, hR⟩ :=
    exists_brrs_scale_parameter hdelta_small.1 hdelta_small.2 R
  let theta' : BRRSParameter := ⟨theta, htheta⟩
  have htheta_cover : theta' ∈ ⋃ x ∈ s, U x :=
    hsubcover (Set.mem_univ theta')
  rcases Set.mem_iUnion.mp htheta_cover with ⟨x, htheta_cover⟩
  rcases Set.mem_iUnion.mp htheta_cover with ⟨hx, hthetaU⟩
  have hlocal' := hlocal x theta' hthetaU
  have hterm := brrs_weighted_entropy_term_le_of_parameter_le E
    hdelta_small.1 hdelta_small.2 hR hlocal'.1 (hC x).le
    (hcover x) hlocal'.2 (a := a)
  calc
    (R.1 : ENNReal) ^ (-alpha) *
        brrsEntropyNumber (E ∩ brrsInterval a (R.1 : Real)) delta ≤
        ENNReal.ofReal (C x) * (delta : ENNReal) ^ (-B) := hterm
    _ ≤ ENNReal.ofReal M * (delta : ENNReal) ^ (-B) :=
      by
        gcongr
        exact hCM x hx

/-- An eventual finite-constant power bound for the literal profile gives
the corresponding upper bound for its entropy exponent. -/
theorem brrsLegendreAssouadExponent_le_of_profile_power_bound
    {E : Set Real} {alpha B M : Real} (hMtop : ENNReal.ofReal M ≠ ∞)
    (hbound : ∀ᶠ delta : NNReal in 𝓝[>] (0 : NNReal),
      brrsLegendreAssouadProfile E alpha delta ≤
        ENNReal.ofReal M * (delta : ENNReal) ^ (-B)) :
    brrsLegendreAssouadExponent E alpha ≤ (B : EReal) := by
  exact limsup_entropyLogQuotient_le_of_power_bound
    (N := fun delta => brrsLegendreAssouadProfile E alpha delta)
    hMtop hbound

/-- The real representative of the literal BRRS exponent inherits an
eventual finite-constant power bound when the time set is nonempty. -/
theorem brrsLegendreAssouadFunction_le_of_profile_power_bound
    {E : Set Real} (hE : E.Nonempty) {alpha B M : Real}
    (hMtop : ENNReal.ofReal M ≠ ∞)
    (hbound : ∀ᶠ delta : NNReal in 𝓝[>] (0 : NNReal),
      brrsLegendreAssouadProfile E alpha delta ≤
        ENNReal.ofReal M * (delta : ENNReal) ^ (-B)) :
    brrsLegendreAssouadFunction E alpha ≤ B := by
  rw [brrsLegendreAssouadFunction_eq_exponent_toReal]
  change (brrsLegendreAssouadExponent E alpha).toReal ≤ (B : EReal).toReal
  apply EReal.toReal_le_toReal
  · exact brrsLegendreAssouadExponent_le_of_profile_power_bound hMtop hbound
  · exact brrsLegendreAssouadExponent_ne_bot_of_nonempty hE alpha
  · exact EReal.coe_ne_top B

/-- Negative BRRS profile penalties are inactive: the unit testing interval
dominates every shorter interval, while the scale weight is at most one. -/
theorem brrsLegendreAssouadProfile_eq_zero_of_nonpos
    (E : Set Real) {alpha : Real} (halpha : alpha ≤ 0) {delta : NNReal}
    (hdelta : delta ≤ 1) :
    brrsLegendreAssouadProfile E alpha delta =
      brrsLegendreAssouadProfile E 0 delta := by
  apply le_antisymm
  · unfold brrsLegendreAssouadProfile
    apply iSup_le
    intro a
    apply iSup_le
    intro R
    have hweight : (R.1 : ENNReal) ^ (-alpha) ≤ 1 :=
      ENNReal.rpow_le_one (by exact_mod_cast R.2.2) (by linarith)
    calc
      (R.1 : ENNReal) ^ (-alpha) *
          brrsEntropyNumber (E ∩ brrsInterval a (R.1 : Real)) delta ≤
          1 * brrsEntropyNumber (E ∩ brrsInterval a (R.1 : Real)) delta :=
        by simpa [mul_comm] using
          mul_le_mul_right hweight
            (brrsEntropyNumber (E ∩ brrsInterval a (R.1 : Real)) delta)
      _ = (R.1 : ENNReal) ^ (-(0 : Real)) *
          brrsEntropyNumber (E ∩ brrsInterval a (R.1 : Real)) delta := by simp
      _ ≤ ⨆ a : Real, ⨆ R : Icc delta 1,
          (R.1 : ENNReal) ^ (-(0 : Real)) *
            brrsEntropyNumber (E ∩ brrsInterval a (R.1 : Real)) delta :=
        le_iSup_of_le a (le_iSup_of_le R (le_refl _))
  · unfold brrsLegendreAssouadProfile
    apply iSup_le
    intro a
    apply iSup_le
    intro R
    let Rone : Icc delta 1 := ⟨1, hdelta, le_rfl⟩
    calc
      (R.1 : ENNReal) ^ (-(0 : Real)) *
          brrsEntropyNumber (E ∩ brrsInterval a (R.1 : Real)) delta =
          brrsEntropyNumber (E ∩ brrsInterval a (R.1 : Real)) delta := by simp
      _ ≤ brrsEntropyNumber (E ∩ brrsInterval a (1 : Real)) delta :=
        brrsEntropyNumber_inter_interval_mono (subset_rfl) R.2.2 delta
      _ = (Rone.1 : ENNReal) ^ (-alpha) *
          brrsEntropyNumber (E ∩ brrsInterval a (Rone.1 : Real)) delta := by
        dsimp only [Rone]
        simp
      _ ≤ ⨆ a : Real, ⨆ R : Icc delta 1,
          (R.1 : ENNReal) ^ (-alpha) *
            brrsEntropyNumber (E ∩ brrsInterval a (R.1 : Real)) delta :=
        le_iSup_of_le a (le_iSup_of_le Rone (le_refl _))

/-- Consequently, the extended-real literal BRRS exponent is flat on the
nonpositive penalty half-line. -/
theorem brrsLegendreAssouadExponent_eq_zero_of_nonpos
    (E : Set Real) {alpha : Real} (halpha : alpha ≤ 0) :
    brrsLegendreAssouadExponent E alpha =
      brrsLegendreAssouadExponent E 0 := by
  unfold brrsLegendreAssouadExponent
  apply Filter.limsup_congr
  have hsmall : ∀ᶠ delta : NNReal in 𝓝[>] (0 : NNReal), delta ∈ Ioo 0 1 :=
    nhdsGT_basis 0 |>.mem_of_mem zero_lt_one
  filter_upwards [hsmall] with delta hdelta
  rw [brrsLegendreAssouadProfile_eq_zero_of_nonpos E halpha hdelta.2.le]

/-- The real-valued literal BRRS function is likewise flat for nonpositive
penalties. -/
theorem brrsLegendreAssouadFunction_eq_zero_of_nonpos
    (E : Set Real) {alpha : Real} (halpha : alpha ≤ 0) :
    brrsLegendreAssouadFunction E alpha =
      brrsLegendreAssouadFunction E 0 := by
  rw [brrsLegendreAssouadFunction_eq_exponent_toReal,
    brrsLegendreAssouadFunction_eq_exponent_toReal,
    brrsLegendreAssouadExponent_eq_zero_of_nonpos E halpha]

/-- BRRS entropy is subadditive over a union of two localized sets. -/
theorem brrsEntropyNumber_union_le (delta : NNReal) (A B : Set Real) :
    brrsEntropyNumber (A ∪ B) delta ≤
      brrsEntropyNumber A delta + brrsEntropyNumber B delta := by
  change (Metric.externalCoveringNumber (delta / 2) (A ∪ B) : ENNReal) ≤
    (Metric.externalCoveringNumber (delta / 2) A : ENNReal) +
      (Metric.externalCoveringNumber (delta / 2) B : ENNReal)
  rw [← ENat.toENNReal_add]
  exact ENat.toENNReal_mono (externalCoveringNumber_union_le _ _ _)

/-- The entropy of a finite union is bounded by the sum of the entropies of
its pieces. -/
theorem brrsEntropyNumber_biUnion_le
    {ι : Type*} (delta : NNReal) (s : Finset ι) (A : ι → Set Real) :
    brrsEntropyNumber (⋃ i ∈ s, A i) delta ≤
      ∑ i ∈ s, brrsEntropyNumber (A i) delta := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert i s hi hs =>
      rw [Finset.set_biUnion_insert]
      rw [Finset.sum_insert hi]
      exact (brrsEntropyNumber_union_le delta (A i) (⋃ j ∈ s, A j)).trans
        (add_le_add_right hs (brrsEntropyNumber (A i) delta))

/-- An interval cover can be used to split the BRRS entropy into exact-length
additive interval pieces. -/
theorem brrsEntropyNumber_le_sum_of_intervalCover
    {E : Set Real} {delta : NNReal} {L : Real} {centers : Finset Real}
    (hcover : Auto.FractalDimensions.IsIntervalCover E L centers) :
    brrsEntropyNumber E delta ≤ ∑ c ∈ centers,
      brrsEntropyNumber (E ∩ brrsInterval (c - L / 2) L) delta := by
  let U : Set Real := ⋃ c ∈ centers, E ∩ brrsInterval (c - L / 2) L
  have hEU : E ⊆ U := by
    intro x hx
    have hxcover := hcover hx
    rcases Set.mem_iUnion.mp hxcover with ⟨c, hxcover⟩
    rcases Set.mem_iUnion.mp hxcover with ⟨hc, hxcover⟩
    refine Set.mem_iUnion.mpr ⟨c, Set.mem_iUnion.mpr ⟨hc, ?_⟩⟩
    refine ⟨hx, ?_⟩
    change x ∈ Icc (c - L / 2) ((c - L / 2) + L)
    simp only [mem_Icc] at hxcover ⊢
    constructor
    · exact hxcover.1
    · linarith [hxcover.2]
  calc
    brrsEntropyNumber E delta ≤ brrsEntropyNumber U delta :=
      brrsEntropyNumber_mono hEU delta
    _ ≤ ∑ c ∈ centers, brrsEntropyNumber (E ∩ brrsInterval (c - L / 2) L) delta := by
      dsimp [U]
      exact brrsEntropyNumber_biUnion_le delta centers
        (fun c => E ∩ brrsInterval (c - L / 2) L)

/-- An interval of BRRS length `δ` is covered by one closed ball of radius
`δ / 2`, centred at its midpoint. -/
theorem brrsEntropyNumber_inter_interval_self_le_one (E : Set Real) (a : Real)
    (delta : NNReal) :
    brrsEntropyNumber (E ∩ brrsInterval a (delta : Real)) delta ≤ 1 := by
  unfold brrsEntropyNumber
  let c : Real := a + (delta : Real) / 2
  have hcover : Metric.IsCover (delta / 2 : NNReal)
      (E ∩ brrsInterval a (delta : Real)) ({c} : Set Real) := by
    intro x hx
    refine ⟨c, by simp, ?_⟩
    change edist x c ≤ ↑(delta / 2 : NNReal)
    rw [edist_dist]
    rw [ENNReal.ofReal_le_coe]
    rw [Real.dist_eq]
    dsimp [c]
    simp only [brrsInterval, mem_inter_iff, mem_Icc] at hx
    rw [abs_le]
    constructor <;> linarith [hx.2.1, hx.2.2, delta.2]
  exact_mod_cast
    (hcover.externalCoveringNumber_le_encard.trans_eq (by simp))

/-- A finite interval cover in the existing one-dimensional geometry gives
the identical external-covering-number bound used by BRRS. -/
theorem brrsEntropyNumber_le_of_intervalCover {E : Set Real} {delta : NNReal}
    {centers : Finset Real}
    (hcenters : Auto.FractalDimensions.IsIntervalCover E (delta : Real) centers) :
    brrsEntropyNumber E delta ≤ (centers.card : ENNReal) := by
  unfold brrsEntropyNumber
  have hcover : Metric.IsCover (delta / 2 : NNReal) E (↑centers : Set Real) := by
    intro x hx
    rcases Set.mem_iUnion.mp (hcenters hx) with ⟨c, hc⟩
    rcases Set.mem_iUnion.mp hc with ⟨hc_centers, hxc⟩
    refine ⟨c, hc_centers, ?_⟩
    change edist x c ≤ ↑(delta / 2 : NNReal)
    rw [edist_dist, ENNReal.ofReal_le_coe, Real.dist_eq]
    have hdist : |x - c| ≤ (delta : Real) / 2 := by
      rw [abs_le]
      constructor <;> linarith [hxc.1, hxc.2]
    simpa using hdist
  exact_mod_cast
    (hcover.externalCoveringNumber_le_encard.trans_eq (by simp))

/-- The elementary one-dimensional grid gives the BRRS covering bound with
exponent one whenever the tested interval is at least one covering scale. -/
theorem brrsEntropyNumber_inter_interval_le_four_mul_ratio (E : Set Real)
    {a R : Real} {delta : NNReal} (hdelta : 0 < (delta : Real))
    (hscale : (delta : Real) ≤ R) :
    brrsEntropyNumber (E ∩ brrsInterval a R) delta ≤
      ENNReal.ofReal (4 * (R / (delta : Real))) := by
  have hR : 0 ≤ R := hdelta.le.trans hscale
  have hab : a ≤ a + R := by linarith
  obtain ⟨centers, hcenters, hcard⟩ :=
    Auto.FractalDimensions.exists_intervalCover_of_subset_Icc
      (F := E ∩ brrsInterval a R) hdelta hab
      (inter_subset_right : E ∩ brrsInterval a R ⊆ Icc a (a + R))
  have hratio : 1 ≤ R / (delta : Real) := by
    rw [le_div_iff₀ hdelta]
    simpa only [one_mul] using hscale
  have hceil : (Nat.ceil (R / (delta : Real)) : Real) ≤
      R / (delta : Real) + 1 :=
    (Nat.ceil_lt_add_one (div_nonneg hR hdelta.le)).le
  have hcard' : (centers.card : Real) ≤ 4 * (R / (delta : Real)) := by
    calc
      (centers.card : Real) ≤
          Nat.ceil ((a + R - a) / (delta : Real)) + 2 := hcard
      _ = Nat.ceil (R / (delta : Real)) + 2 := by ring
      _ ≤ (R / (delta : Real) + 1) + 2 := by linarith
      _ ≤ 4 * (R / (delta : Real)) := by nlinarith
  calc
    brrsEntropyNumber (E ∩ brrsInterval a R) delta ≤ (centers.card : ENNReal) :=
      brrsEntropyNumber_le_of_intervalCover hcenters
    _ = ENNReal.ofReal (centers.card : Real) := by simp
    _ ≤ ENNReal.ofReal (4 * (R / (delta : Real))) :=
      ENNReal.ofReal_le_ofReal hcard'

/-- Uniformly over every BRRS testing interval of length at most one, the
one-dimensional grid has at most `4 / δ` cells. -/
theorem brrsEntropyNumber_inter_interval_le_four_mul_inv (E : Set Real)
    {a R : Real} {delta : NNReal} (hdelta : 0 < (delta : Real))
    (hscale : (delta : Real) ≤ R) (hR : R ≤ 1) :
    brrsEntropyNumber (E ∩ brrsInterval a R) delta ≤
      4 * (delta : ENNReal)⁻¹ := by
  calc
    brrsEntropyNumber (E ∩ brrsInterval a R) delta ≤
        ENNReal.ofReal (4 * (R / (delta : Real))) :=
      brrsEntropyNumber_inter_interval_le_four_mul_ratio E hdelta hscale
    _ ≤ ENNReal.ofReal (4 * ((delta : Real)⁻¹)) := by
      apply ENNReal.ofReal_le_ofReal
      apply mul_le_mul_of_nonneg_left
      · calc
          R / (delta : Real) = R * ((delta : Real)⁻¹) := by rw [div_eq_mul_inv]
          _ ≤ 1 * ((delta : Real)⁻¹) :=
            mul_le_mul_of_nonneg_right hR (inv_nonneg.mpr hdelta.le)
          _ = (delta : Real)⁻¹ := by ring
      · norm_num
    _ = 4 * (delta : ENNReal)⁻¹ := by
      rw [ENNReal.ofReal_mul (by norm_num : (0 : Real) ≤ 4),
        ENNReal.ofReal_inv_of_pos hdelta]
      simp

/-- The scale-sensitive grid estimate, rewritten entirely in `ENNReal`
notation for use with the weighted BRRS profile. -/
theorem brrsEntropyNumber_inter_interval_le_four_mul_ratio_ennreal
    (E : Set Real) {a : Real} {R delta : NNReal}
    (hdelta : 0 < (delta : Real)) (hscale : (delta : Real) ≤ (R : Real)) :
    brrsEntropyNumber (E ∩ brrsInterval a (R : Real)) delta ≤
      4 * (R : ENNReal) * (delta : ENNReal)⁻¹ := by
  calc
    brrsEntropyNumber (E ∩ brrsInterval a (R : Real)) delta ≤
        ENNReal.ofReal (4 * ((R : Real) / (delta : Real))) :=
      brrsEntropyNumber_inter_interval_le_four_mul_ratio E hdelta hscale
    _ = 4 * (R : ENNReal) * (delta : ENNReal)⁻¹ := by
      rw [ENNReal.ofReal_mul (by norm_num : (0 : Real) ≤ 4),
        ENNReal.ofReal_div_of_pos hdelta]
      simp [div_eq_mul_inv, mul_assoc]

/-- At nonnegative penalty, the literal BRRS profile has the elementary
ambient one-dimensional power bound.  This is enough to make its limsup a
finite real number; the sharper exponent used in Theorem 1.2 requires the
Assouad-spectrum argument. -/
theorem brrsLegendreAssouadProfile_le_four_mul_inv_rpow_add_one
    (E : Set Real) {alpha : Real} (halpha : 0 ≤ alpha)
    {delta : NNReal} (hdelta : 0 < delta) (_hdelta_one : delta ≤ 1) :
    brrsLegendreAssouadProfile E alpha delta ≤
      4 * (delta : ENNReal) ^ (-(alpha + 1)) := by
  unfold brrsLegendreAssouadProfile
  apply iSup_le
  intro a
  apply iSup_le
  intro R
  have hdelta_real : 0 < (delta : Real) := by exact_mod_cast hdelta
  have hdeltaR : (delta : ENNReal) ≤ (R.1 : ENNReal) := by
    exact_mod_cast R.2.1
  have hweight : (R.1 : ENNReal) ^ (-alpha) ≤
      (delta : ENNReal) ^ (-alpha) := by
    calc
      (R.1 : ENNReal) ^ (-alpha) = ((R.1 : ENNReal)⁻¹) ^ alpha := by
        rw [ENNReal.rpow_neg, ← ENNReal.inv_rpow]
      _ ≤ ((delta : ENNReal)⁻¹) ^ alpha :=
        ENNReal.rpow_le_rpow (ENNReal.inv_le_inv' hdeltaR) halpha
      _ = (delta : ENNReal) ^ (-alpha) := by
        rw [ENNReal.rpow_neg, ← ENNReal.inv_rpow]
  have hentropy :
      brrsEntropyNumber (E ∩ brrsInterval a (R.1 : Real)) delta ≤
        4 * (delta : ENNReal)⁻¹ :=
    brrsEntropyNumber_inter_interval_le_four_mul_inv E hdelta_real
      (by exact_mod_cast R.2.1) (by exact_mod_cast R.2.2)
  have hdelta_zero : (delta : ENNReal) ≠ 0 :=
    ne_of_gt (by exact_mod_cast hdelta)
  calc
    (R.1 : ENNReal) ^ (-alpha) *
        brrsEntropyNumber (E ∩ brrsInterval a (R.1 : Real)) delta ≤
        (delta : ENNReal) ^ (-alpha) * (4 * (delta : ENNReal)⁻¹) :=
      mul_le_mul hweight hentropy bot_le (by positivity)
    _ = 4 * (delta : ENNReal) ^ (-(alpha + 1)) := by
      calc
        (delta : ENNReal) ^ (-alpha) * (4 * (delta : ENNReal)⁻¹) =
            4 * ((delta : ENNReal) ^ (-alpha) * (delta : ENNReal)⁻¹) := by ring
        _ = 4 * ((delta : ENNReal) ^ (-alpha) * (delta : ENNReal) ^ (-1 : Real)) := by
          rw [ENNReal.rpow_neg_one]
        _ = 4 * (delta : ENNReal) ^ ((-alpha) + (-1 : Real)) := by
          rw [← ENNReal.rpow_add (-alpha) (-1 : Real) hdelta_zero ENNReal.coe_ne_top]
        _ = 4 * (delta : ENNReal) ^ (-(alpha + 1)) := by ring

/-- Once the penalty is at least the ambient dimension one, the scale factor
in the interval-cover estimate is absorbed by the profile weight. -/
theorem brrsLegendreAssouadProfile_le_four_mul_inv_rpow_of_one_le
    (E : Set Real) {alpha : Real} (halpha : 1 ≤ alpha)
    {delta : NNReal} (hdelta : 0 < delta) :
    brrsLegendreAssouadProfile E alpha delta ≤
      4 * (delta : ENNReal) ^ (-alpha) := by
  unfold brrsLegendreAssouadProfile
  apply iSup_le
  intro a
  apply iSup_le
  intro R
  have hdelta_real : 0 < (delta : Real) := by exact_mod_cast hdelta
  have hdeltaR : (delta : ENNReal) ≤ (R.1 : ENNReal) := by
    exact_mod_cast R.2.1
  have hR_zero : (R.1 : ENNReal) ≠ 0 :=
    ne_of_gt (lt_of_lt_of_le (by exact_mod_cast hdelta) hdeltaR)
  have hdelta_zero : (delta : ENNReal) ≠ 0 :=
    ne_of_gt (by exact_mod_cast hdelta)
  have hfactor : (R.1 : ENNReal) ^ (1 - alpha) ≤
      (delta : ENNReal) ^ (1 - alpha) := by
    calc
      (R.1 : ENNReal) ^ (1 - alpha) = ((R.1 : ENNReal)⁻¹) ^ (alpha - 1) := by
        rw [show 1 - alpha = -(alpha - 1) by ring,
          ENNReal.rpow_neg, ← ENNReal.inv_rpow]
      _ ≤ ((delta : ENNReal)⁻¹) ^ (alpha - 1) :=
        ENNReal.rpow_le_rpow (ENNReal.inv_le_inv' hdeltaR)
          (sub_nonneg.mpr halpha)
      _ = (delta : ENNReal) ^ (1 - alpha) := by
        rw [show 1 - alpha = -(alpha - 1) by ring,
          ENNReal.rpow_neg, ← ENNReal.inv_rpow]
  have hentropy :
      brrsEntropyNumber (E ∩ brrsInterval a (R.1 : Real)) delta ≤
        4 * (R.1 : ENNReal) * (delta : ENNReal)⁻¹ :=
    brrsEntropyNumber_inter_interval_le_four_mul_ratio_ennreal E hdelta_real
      (by exact_mod_cast R.2.1)
  have hRcombine : (R.1 : ENNReal) ^ (-alpha) * (R.1 : ENNReal) =
      (R.1 : ENNReal) ^ (1 - alpha) := by
    calc
      (R.1 : ENNReal) ^ (-alpha) * (R.1 : ENNReal) =
          (R.1 : ENNReal) ^ (-alpha) * (R.1 : ENNReal) ^ (1 : Real) := by
        rw [ENNReal.rpow_one]
      _ = (R.1 : ENNReal) ^ ((-alpha) + (1 : Real)) := by
        rw [← ENNReal.rpow_add (-alpha) (1 : Real) hR_zero ENNReal.coe_ne_top]
      _ = (R.1 : ENNReal) ^ (1 - alpha) := by
        congr 1
        ring
  have hdelta_combine : (delta : ENNReal) ^ (1 - alpha) *
      (delta : ENNReal)⁻¹ = (delta : ENNReal) ^ (-alpha) := by
    calc
      (delta : ENNReal) ^ (1 - alpha) * (delta : ENNReal)⁻¹ =
          (delta : ENNReal) ^ (1 - alpha) * (delta : ENNReal) ^ (-1 : Real) := by
        rw [ENNReal.rpow_neg_one]
      _ = (delta : ENNReal) ^ ((1 - alpha) + (-1 : Real)) := by
        rw [← ENNReal.rpow_add (1 - alpha) (-1 : Real) hdelta_zero ENNReal.coe_ne_top]
      _ = (delta : ENNReal) ^ (-alpha) := by
        congr 1
        ring
  calc
    (R.1 : ENNReal) ^ (-alpha) *
        brrsEntropyNumber (E ∩ brrsInterval a (R.1 : Real)) delta ≤
        (R.1 : ENNReal) ^ (-alpha) *
          (4 * (R.1 : ENNReal) * (delta : ENNReal)⁻¹) :=
      mul_le_mul_of_nonneg_left hentropy (by positivity)
    _ = 4 * ((R.1 : ENNReal) ^ (-alpha) * (R.1 : ENNReal) *
        (delta : ENNReal)⁻¹) := by ring
    _ = 4 * ((R.1 : ENNReal) ^ (1 - alpha) * (delta : ENNReal)⁻¹) := by
      rw [hRcombine]
    _ ≤ 4 * ((delta : ENNReal) ^ (1 - alpha) * (delta : ENNReal)⁻¹) := by
      gcongr
    _ = 4 * (delta : ENNReal) ^ (-alpha) := by rw [hdelta_combine]

/-- The literal BRRS exponent is finite above for every nonnegative penalty.
This deliberately elementary estimate is independent of boundedness of `E`,
because every term is localized to a testing interval of length at most one. -/
theorem brrsLegendreAssouadExponent_le_add_one_of_nonneg (E : Set Real)
    {alpha : Real} (halpha : 0 ≤ alpha) :
    brrsLegendreAssouadExponent E alpha ≤ (alpha + 1 : EReal) := by
  refine limsup_entropyLogQuotient_le_of_power_bound
    (N := fun delta => brrsLegendreAssouadProfile E alpha delta)
    (A := 4) (s := alpha + 1) (by norm_num) ?_
  have hsmall : ∀ᶠ delta : NNReal in 𝓝[>] (0 : NNReal),
      delta ∈ Ioo 0 1 :=
    nhdsGT_basis 0 |>.mem_of_mem zero_lt_one
  filter_upwards [hsmall] with delta hdelta
  simpa using
    brrsLegendreAssouadProfile_le_four_mul_inv_rpow_add_one E halpha
      hdelta.1 hdelta.2.le

/-- On nonnegative penalties the literal BRRS exponent is not the top
extended-real value. -/
theorem brrsLegendreAssouadExponent_ne_top_of_nonneg (E : Set Real)
    {alpha : Real} (halpha : 0 ≤ alpha) :
    brrsLegendreAssouadExponent E alpha ≠ ⊤ :=
  ne_top_of_le_ne_top (EReal.coe_ne_top (alpha + 1))
    (brrsLegendreAssouadExponent_le_add_one_of_nonneg E halpha)

/-- For a nonempty time set, the literal real-valued BRRS function dominates
its penalty parameter. -/
theorem le_brrsLegendreAssouadFunction_of_nonempty {E : Set Real}
    (hE : E.Nonempty) {alpha : Real} (halpha : 0 ≤ alpha) :
    alpha ≤ brrsLegendreAssouadFunction E alpha := by
  rw [brrsLegendreAssouadFunction_eq_exponent_toReal]
  change (alpha : EReal).toReal ≤
    (brrsLegendreAssouadExponent E alpha).toReal
  apply EReal.toReal_le_toReal
  · exact le_brrsLegendreAssouadExponent_of_nonempty hE alpha
  · exact EReal.coe_ne_bot alpha
  · exact brrsLegendreAssouadExponent_ne_top_of_nonneg E halpha

/-- The literal real-valued BRRS function is nonnegative on its natural
parameter domain for every nonempty time set. -/
theorem brrsLegendreAssouadFunction_nonneg_of_nonempty {E : Set Real}
    (hE : E.Nonempty) {alpha : Real} (halpha : 0 ≤ alpha) :
    0 ≤ brrsLegendreAssouadFunction E alpha :=
  halpha.trans (le_brrsLegendreAssouadFunction_of_nonempty hE halpha)

/-- The literal real-valued BRRS function is increasing on `[0,∞)` for every
nonempty time set. -/
theorem brrsLegendreAssouadFunction_mono_of_nonempty {E : Set Real}
    (hE : E.Nonempty) {alpha beta : Real} (halpha : 0 ≤ alpha)
    (halpha_beta : alpha ≤ beta) :
    brrsLegendreAssouadFunction E alpha ≤
      brrsLegendreAssouadFunction E beta := by
  rw [brrsLegendreAssouadFunction_eq_exponent_toReal,
    brrsLegendreAssouadFunction_eq_exponent_toReal]
  apply EReal.toReal_le_toReal
  · exact brrsLegendreAssouadExponent_mono E halpha_beta
  · exact brrsLegendreAssouadExponent_ne_bot_of_nonempty hE alpha
  · exact brrsLegendreAssouadExponent_ne_top_of_nonneg E
      (halpha.trans halpha_beta)

/-- At penalties at least the ambient dimension, the interval grid estimate
gives the sharp upper bound for the literal BRRS exponent. -/
theorem brrsLegendreAssouadExponent_le_of_one_le (E : Set Real)
    {alpha : Real} (halpha : 1 ≤ alpha) :
    brrsLegendreAssouadExponent E alpha ≤ (alpha : EReal) := by
  refine limsup_entropyLogQuotient_le_of_power_bound
    (N := fun delta => brrsLegendreAssouadProfile E alpha delta)
    (A := 4) (s := alpha) (by norm_num) ?_
  have hsmall : ∀ᶠ delta : NNReal in 𝓝[>] (0 : NNReal),
      delta ∈ Ioo 0 1 :=
    nhdsGT_basis 0 |>.mem_of_mem zero_lt_one
  filter_upwards [hsmall] with delta hdelta
  simpa using
    brrsLegendreAssouadProfile_le_four_mul_inv_rpow_of_one_le E halpha hdelta.1

/-- A nonempty time set has the exact forced affine tail in the BRRS
Legendre--Assouad exponent. -/
theorem brrsLegendreAssouadExponent_eq_of_nonempty_of_one_le {E : Set Real}
    (hE : E.Nonempty) {alpha : Real} (halpha : 1 ≤ alpha) :
    brrsLegendreAssouadExponent E alpha = (alpha : EReal) :=
  le_antisymm (brrsLegendreAssouadExponent_le_of_one_le E halpha)
    (le_brrsLegendreAssouadExponent_of_nonempty hE alpha)

/-- The real-valued literal BRRS Legendre--Assouad function has the exact
identity tail for every nonempty time set. -/
theorem brrsLegendreAssouadFunction_eq_of_nonempty_of_one_le {E : Set Real}
    (hE : E.Nonempty) {alpha : Real} (halpha : 1 ≤ alpha) :
    brrsLegendreAssouadFunction E alpha = alpha := by
  rw [brrsLegendreAssouadFunction_eq_exponent_toReal,
    brrsLegendreAssouadExponent_eq_of_nonempty_of_one_le hE halpha]
  simp

/-- On the BRRS parameter range at most one, a covering exponent remains
admissible after it is enlarged. -/
theorem HasBRRSAssouadSpectrumExponent.of_le
    {E : Set Real} {theta gamma gamma' : Real} (htheta : theta ≤ 1)
    (hgamma : gamma ≤ gamma')
    (hE : HasBRRSAssouadSpectrumExponent E theta gamma) :
    HasBRRSAssouadSpectrumExponent E theta gamma' := by
  rcases hE with ⟨C, hC, hcover⟩
  refine ⟨C, hC, ?_⟩
  intro delta hdelta hdelta_one a
  have hdelta_real : 0 < (delta : Real) := by exact_mod_cast hdelta
  have hdelta_one_real : (delta : Real) ≤ 1 := by exact_mod_cast hdelta_one.le
  have hscale : (delta : Real) ≤ (delta : Real) ^ theta := by
    calc
      (delta : Real) = (delta : Real) ^ (1 : Real) := by rw [Real.rpow_one]
      _ ≤ (delta : Real) ^ theta :=
        Real.rpow_le_rpow_of_exponent_ge hdelta_real hdelta_one_real htheta
  have hratio : 1 ≤ ((delta : Real) ^ theta) / (delta : Real) := by
    rw [le_div_iff₀ hdelta_real]
    simpa only [one_mul] using hscale
  calc
    brrsEntropyNumber (E ∩ brrsInterval a ((delta : Real) ^ theta)) delta ≤
        ENNReal.ofReal
          (C * ((((delta : Real) ^ theta) / (delta : Real)) ^ gamma)) :=
      hcover delta hdelta hdelta_one a
    _ ≤ ENNReal.ofReal
          (C * ((((delta : Real) ^ theta) / (delta : Real)) ^ gamma')) := by
      apply ENNReal.ofReal_le_ofReal
      apply mul_le_mul_of_nonneg_left
      · exact Real.rpow_le_rpow_of_exponent_le hratio hgamma
      · exact hC.le

/-- The elementary power identity behind exact-scale parameter transfer. -/
private theorem brrs_rpow_parameter_identity {d theta theta' s : Real}
    (hd : 0 < d) (htheta' : theta' < 1) :
    ((d ^ theta') / d) ^ (s * ((1 - theta) / (1 - theta'))) =
      ((d ^ theta) / d) ^ s := by
  calc
    ((d ^ theta') / d) ^ (s * ((1 - theta) / (1 - theta'))) =
        (d ^ (theta' - 1)) ^ (s * ((1 - theta) / (1 - theta'))) := by
          rw [Real.rpow_sub hd theta' 1, Real.rpow_one]
    _ = d ^ ((theta' - 1) * (s * ((1 - theta) / (1 - theta')))) := by
          rw [Real.rpow_mul hd.le]
    _ = d ^ ((theta - 1) * s) := by
          congr 1
          field_simp [ne_of_gt (sub_pos.mpr htheta')]
          ring
    _ = (d ^ (theta - 1)) ^ s := by rw [Real.rpow_mul hd.le]
    _ = ((d ^ theta) / d) ^ s := by rw [Real.rpow_sub hd theta 1, Real.rpow_one]

/-- The corresponding power identity when a larger exact testing interval is
subdivided into intervals at a smaller exact scale. -/
private theorem brrs_rpow_subdivision_identity {d theta theta' s : Real}
    (hd : 0 < d) (htheta' : theta' < 1) :
    (d ^ theta' / d ^ theta) * (d ^ theta / d) ^ s =
      (d ^ theta' / d) ^
        (((1 - theta) * s + (theta - theta')) / (1 - theta')) := by
  calc
    (d ^ theta' / d ^ theta) * (d ^ theta / d) ^ s =
        d ^ (theta' - theta) * (d ^ (theta - 1)) ^ s := by
          rw [Real.rpow_sub hd theta' theta, Real.rpow_sub hd theta 1, Real.rpow_one]
    _ = d ^ (theta' - theta) * d ^ ((theta - 1) * s) := by
          rw [Real.rpow_mul hd.le]
    _ = d ^ ((theta' - theta) + (theta - 1) * s) := by
          rw [Real.rpow_add hd]
    _ = d ^ ((theta' - 1) *
        (((1 - theta) * s + (theta - theta')) / (1 - theta'))) := by
          congr 1
          field_simp [ne_of_gt (sub_pos.mpr htheta')]
          ring
    _ = (d ^ (theta' - 1)) ^
        (((1 - theta) * s + (theta - theta')) / (1 - theta')) := by
          rw [Real.rpow_mul hd.le]
    _ = (d ^ theta' / d) ^
        (((1 - theta) * s + (theta - theta')) / (1 - theta')) := by
          rw [Real.rpow_sub hd theta' 1, Real.rpow_one]

/-- An equality-scale BRRS covering estimate at `theta` transfers to every
larger parameter below one.  Unlike the repository's older upper-spectrum
predicate, this uses only containment of the two exact testing intervals. -/
theorem HasBRRSAssouadSpectrumExponent.lift_parameter
    {E : Set Real} {theta theta' s : Real}
    (htheta : theta ≤ theta') (htheta' : theta' < 1)
    (hE : HasBRRSAssouadSpectrumExponent E theta s) :
    HasBRRSAssouadSpectrumExponent E theta'
      (s * ((1 - theta) / (1 - theta'))) := by
  rcases hE with ⟨C, hC, hcover⟩
  refine ⟨C, hC, ?_⟩
  intro delta hdelta hdelta_one a
  have hdelta_real : 0 < (delta : Real) := by exact_mod_cast hdelta
  have hdelta_one_real : (delta : Real) ≤ 1 := by exact_mod_cast hdelta_one.le
  have hlength : (delta : Real) ^ theta' ≤ (delta : Real) ^ theta :=
    Real.rpow_le_rpow_of_exponent_ge hdelta_real hdelta_one_real htheta
  calc
    brrsEntropyNumber (E ∩ brrsInterval a ((delta : Real) ^ theta')) delta ≤
        brrsEntropyNumber (E ∩ brrsInterval a ((delta : Real) ^ theta)) delta :=
      brrsEntropyNumber_inter_interval_mono (subset_rfl) hlength delta
    _ ≤ ENNReal.ofReal (C * ((((delta : Real) ^ theta) / (delta : Real)) ^ s)) :=
      hcover delta hdelta hdelta_one a
    _ = ENNReal.ofReal
        (C * ((((delta : Real) ^ theta') / (delta : Real)) ^
          (s * ((1 - theta) / (1 - theta')))) ) := by
      rw [brrs_rpow_parameter_identity hdelta_real htheta']

/-- Subdividing an exact testing interval gives the complementary
parameter-transfer estimate.  The harmless factor `4` is the one-dimensional
grid constant. -/
theorem HasBRRSAssouadSpectrumExponent.subdivide_parameter
    {E : Set Real} {theta theta' s : Real}
    (htheta : theta' ≤ theta) (htheta_lt : theta < 1)
    (hE : HasBRRSAssouadSpectrumExponent E theta s) :
    HasBRRSAssouadSpectrumExponent E theta'
      (((1 - theta) * s + (theta - theta')) / (1 - theta')) := by
  rcases hE with ⟨C, hC, hcover⟩
  refine ⟨4 * C, mul_pos (by norm_num) hC, ?_⟩
  intro delta hdelta hdelta_one a
  let d : Real := (delta : Real)
  let R : Real := d ^ theta'
  let L : Real := d ^ theta
  have hd : 0 < d := by
    dsimp [d]
    exact_mod_cast hdelta
  have hd_one : d ≤ 1 := by
    dsimp [d]
    exact_mod_cast hdelta_one.le
  have hRpos : 0 < R := by
    dsimp [R]
    exact Real.rpow_pos_of_pos hd _
  have hLpos : 0 < L := by
    dsimp [L]
    exact Real.rpow_pos_of_pos hd _
  have hLR : L ≤ R := by
    dsimp [L, R]
    exact Real.rpow_le_rpow_of_exponent_ge hd hd_one htheta
  have hab : a ≤ a + R := by linarith
  obtain ⟨centers, hcenters, hcard⟩ :=
    Auto.FractalDimensions.exists_intervalCover_of_subset_Icc
      (F := E ∩ brrsInterval a R) hLpos hab
      (inter_subset_right : E ∩ brrsInterval a R ⊆ Icc a (a + R))
  have hratio : 1 ≤ R / L := by
    rw [le_div_iff₀ hLpos]
    simpa only [one_mul] using hLR
  have hceil : (Nat.ceil (R / L) : Real) ≤ R / L + 1 :=
    (Nat.ceil_lt_add_one (div_nonneg hRpos.le hLpos.le)).le
  have hcard' : (centers.card : Real) ≤ 4 * (R / L) := by
    calc
      (centers.card : Real) ≤ Nat.ceil ((a + R - a) / L) + 2 := hcard
      _ = Nat.ceil (R / L) + 2 := by ring
      _ ≤ (R / L + 1) + 2 := by linarith
      _ ≤ 4 * (R / L) := by nlinarith
  let Q : ENNReal := ENNReal.ofReal (C * ((L / d) ^ s))
  have hpiece : ∀ c ∈ centers,
      brrsEntropyNumber ((E ∩ brrsInterval a R) ∩
        brrsInterval (c - L / 2) L) delta ≤ Q := by
    intro c hc
    calc
      brrsEntropyNumber ((E ∩ brrsInterval a R) ∩
          brrsInterval (c - L / 2) L) delta ≤
          brrsEntropyNumber (E ∩ brrsInterval (c - L / 2) L) delta :=
        brrsEntropyNumber_mono (by
          intro x hx
          exact ⟨hx.1.1, hx.2⟩) delta
      _ ≤ Q := by
        dsimp [Q, L, d]
        simpa using hcover delta hdelta hdelta_one (c - L / 2)
  have hsum : brrsEntropyNumber (E ∩ brrsInterval a R) delta ≤
      (centers.card : ENNReal) * Q := by
    calc
      brrsEntropyNumber (E ∩ brrsInterval a R) delta ≤
          ∑ c ∈ centers, brrsEntropyNumber ((E ∩ brrsInterval a R) ∩
            brrsInterval (c - L / 2) L) delta :=
        brrsEntropyNumber_le_sum_of_intervalCover hcenters
      _ ≤ ∑ c ∈ centers, Q := by
        exact Finset.sum_le_sum fun c hc => hpiece c hc
      _ = (centers.card : ENNReal) * Q := by simp
  have hcard_ennreal : (centers.card : ENNReal) ≤ ENNReal.ofReal (4 * (R / L)) := by
    calc
      (centers.card : ENNReal) = ENNReal.ofReal (centers.card : Real) := by simp
      _ ≤ ENNReal.ofReal (4 * (R / L)) := ENNReal.ofReal_le_ofReal hcard'
  have hratio_nonneg : 0 ≤ R / L := div_nonneg hRpos.le hLpos.le
  have hconstant : 0 ≤ 4 * (R / L) := mul_nonneg (by norm_num) hratio_nonneg
  have hpower : (R / L) * (L / d) ^ s =
      (R / d) ^ (((1 - theta) * s + (theta - theta')) / (1 - theta')) := by
    dsimp [R, L]
    exact brrs_rpow_subdivision_identity hd (lt_of_le_of_lt htheta htheta_lt)
  calc
    brrsEntropyNumber (E ∩ brrsInterval a (d ^ theta')) delta =
        brrsEntropyNumber (E ∩ brrsInterval a R) delta := by rfl
    _ ≤ (centers.card : ENNReal) * Q := hsum
    _ ≤ ENNReal.ofReal (4 * (R / L)) * Q :=
      by simpa only [mul_comm] using mul_le_mul_right hcard_ennreal Q
    _ = ENNReal.ofReal ((4 * C) * (R / L) * (L / d) ^ s) := by
      dsimp [Q]
      rw [← ENNReal.ofReal_mul hconstant]
      congr 1
      ring
    _ = ENNReal.ofReal ((4 * C) *
        ((R / d) ^ (((1 - theta) * s + (theta - theta')) / (1 - theta'))) ) := by
      congr 1
      calc
        (4 * C) * (R / L) * (L / d) ^ s =
            (4 * C) * ((R / L) * (L / d) ^ s) := by ring
        _ = (4 * C) *
            ((R / d) ^ (((1 - theta) * s + (theta - theta')) / (1 - theta'))) := by
          rw [hpower]
    _ = ENNReal.ofReal ((4 * C) *
        (((d ^ theta') / d) ^
          (((1 - theta) * s + (theta - theta')) / (1 - theta'))) ) := by
      rfl

/-- The one-dimensional grid makes exponent one admissible at every BRRS
spectrum parameter at most one. -/
theorem hasBRRSAssouadSpectrumExponent_of_le_one (E : Set Real) {theta : Real}
    (htheta : theta ≤ 1) : HasBRRSAssouadSpectrumExponent E theta 1 := by
  refine ⟨4, by norm_num, ?_⟩
  intro delta hdelta hdelta_one a
  have hdelta' : 0 < (delta : Real) := by exact_mod_cast hdelta
  have hdelta_one' : (delta : Real) ≤ 1 := by exact_mod_cast hdelta_one.le
  have hscale : (delta : Real) ≤ (delta : Real) ^ theta := by
    calc
      (delta : Real) = (delta : Real) ^ (1 : Real) := by rw [Real.rpow_one]
      _ ≤ (delta : Real) ^ theta :=
        Real.rpow_le_rpow_of_exponent_ge hdelta' hdelta_one' htheta
  simpa [Real.rpow_one] using
    brrsEntropyNumber_inter_interval_le_four_mul_ratio E hdelta' hscale

/-- The set of positive exponents used to define the literal BRRS spectrum
is nonempty on the natural parameter range. -/
theorem brrsAssouadAdmissibleExponents_nonempty (E : Set Real) {theta : Real}
    (htheta : theta ≤ 1) :
    ({gamma : Real | 0 < gamma ∧
      HasBRRSAssouadSpectrumExponent E theta gamma} : Set Real).Nonempty :=
  ⟨1, zero_lt_one, hasBRRSAssouadSpectrumExponent_of_le_one E htheta⟩

/-- Every strictly larger real number is an actual BRRS spectrum exponent.
This is the `sInf` approximation step needed to turn the spectrum into
uniform covering estimates. -/
theorem hasBRRSAssouadSpectrumExponent_of_brrsAssouadSpectrum_lt
    (E : Set Real) {theta gamma : Real} (htheta : theta ≤ 1)
    (hgamma : brrsAssouadSpectrum E theta < gamma) :
    HasBRRSAssouadSpectrumExponent E theta gamma := by
  unfold brrsAssouadSpectrum at hgamma
  obtain ⟨gamma', hgamma', hgamma'_lt⟩ := exists_lt_of_csInf_lt
    (brrsAssouadAdmissibleExponents_nonempty E htheta) hgamma
  exact HasBRRSAssouadSpectrumExponent.of_le htheta hgamma'_lt.le hgamma'.2

/-- The upper half of the fixed-parameter source identity: the weighted
finite-scale entropy limsup is at most `(1 - θ) γ_E(θ)`. -/
theorem brrsAssouadWeightedEntropy_limsup_le_brrsAssouadSpectrum
    (E : Set Real) {theta : Real} (htheta_zero : 0 ≤ theta)
    (htheta_lt_one : theta < 1) :
    Filter.limsup (fun delta : NNReal =>
      brrsAssouadWeightedEntropy E delta theta) (𝓝[>] (0 : NNReal)) ≤
      (((1 - theta) * brrsAssouadSpectrum E theta : Real) : EReal) := by
  refine (EReal.le_of_forall_lt_iff_le
    (x := (((1 - theta) * brrsAssouadSpectrum E theta : Real) : EReal))
    (y := Filter.limsup (fun delta : NNReal =>
      brrsAssouadWeightedEntropy E delta theta) (𝓝[>] (0 : NNReal)))).mp ?_
  intro z hz
  have hz_real : (1 - theta) * brrsAssouadSpectrum E theta < z :=
    EReal.coe_lt_coe_iff.mp hz
  have hfactor : 0 < 1 - theta := sub_pos.mpr htheta_lt_one
  let gap : Real := z - (1 - theta) * brrsAssouadSpectrum E theta
  have hgap : 0 < gap := by
    dsimp [gap]
    exact sub_pos.mpr hz_real
  let gamma : Real := brrsAssouadSpectrum E theta + gap / (2 * (1 - theta))
  have hden : 0 < 2 * (1 - theta) := mul_pos (by norm_num) hfactor
  have hgamma_lt : brrsAssouadSpectrum E theta < gamma := by
    have hquotient : 0 < gap / (2 * (1 - theta)) := div_pos hgap hden
    dsimp [gamma]
    linarith
  have htarget : (1 - theta) * gamma ≤ z := by
    dsimp [gamma, gap]
    field_simp [ne_of_gt hfactor]
    linarith
  have hhas : HasBRRSAssouadSpectrumExponent E theta gamma :=
    hasBRRSAssouadSpectrumExponent_of_brrsAssouadSpectrum_lt E
      htheta_lt_one.le hgamma_lt
  calc
    Filter.limsup (fun delta : NNReal =>
        brrsAssouadWeightedEntropy E delta theta) (𝓝[>] (0 : NNReal)) ≤
        (((1 - theta) * gamma : Real) : EReal) :=
      brrsAssouadWeightedEntropy_limsup_le_of_hasBRRSAssouadSpectrumExponent
        E htheta_zero htheta_lt_one.le hhas
    _ ≤ (z : EReal) := by exact_mod_cast htarget

/-- On its natural parameter range the equality-scale BRRS spectrum lies in
the one-dimensional interval `[0,1]`. -/
theorem brrsAssouadSpectrum_nonneg (E : Set Real) {theta : Real}
    (htheta : theta ≤ 1) : 0 ≤ brrsAssouadSpectrum E theta := by
  unfold brrsAssouadSpectrum
  apply le_csInf
  · exact ⟨1, ⟨zero_lt_one, hasBRRSAssouadSpectrumExponent_of_le_one E htheta⟩⟩
  · intro gamma hgamma
    exact hgamma.1.le

theorem brrsAssouadSpectrum_le_one (E : Set Real) {theta : Real}
    (htheta : theta ≤ 1) : brrsAssouadSpectrum E theta ≤ 1 := by
  unfold brrsAssouadSpectrum
  apply csInf_le
  · refine ⟨0, ?_⟩
    intro gamma hgamma
    exact hgamma.1.le
  · exact ⟨zero_lt_one, hasBRRSAssouadSpectrumExponent_of_le_one E htheta⟩

/-- An exponent strictly below the exact-scale BRRS spectrum has lower
covering witnesses at arbitrarily small scales.  The proof rules out a
large-scale-only failure by the one-dimensional grid estimate; this is the
finite-scale input for the lower Legendre-transform comparison. -/
theorem exists_brrsEntropyNumber_lower_witness_at_small_scale
    (E : Set Real) {theta gamma : Real}
    (htheta_zero : 0 ≤ theta) (htheta_one : theta ≤ 1)
    (hgamma : 0 < gamma)
    (hgamma_lt : gamma < brrsAssouadSpectrum E theta)
    (epsilon : NNReal) (hepsilon : 0 < epsilon) (hepsilon_one : epsilon ≤ 1) :
    ∃ delta : NNReal, 0 < delta ∧ delta < epsilon ∧ delta < 1 ∧ ∃ a : Real,
      ENNReal.ofReal
          ((((delta : Real) ^ theta) / (delta : Real)) ^ gamma) <
        brrsEntropyNumber
          (E ∩ brrsInterval a ((delta : Real) ^ theta)) delta := by
  have hnot : ¬ HasBRRSAssouadSpectrumExponent E theta gamma := by
    intro hhas
    have hle : brrsAssouadSpectrum E theta ≤ gamma := by
      unfold brrsAssouadSpectrum
      apply csInf_le
      · refine ⟨0, ?_⟩
        intro q hq
        exact hq.1.le
      · exact ⟨hgamma, hhas⟩
    exact (not_le_of_gt hgamma_lt) hle
  let C : Real := 4 * ((epsilon : Real)⁻¹)
  have hepsilon_real : 0 < (epsilon : Real) := by exact_mod_cast hepsilon
  have hC : 0 < C := by
    dsimp [C]
    positivity
  have hC_one : 1 ≤ C := by
    dsimp [C]
    calc
      1 ≤ 4 / (epsilon : Real) := by
        apply (le_div_iff₀ hepsilon_real).mpr
        nlinarith [show (epsilon : Real) ≤ 1 by exact_mod_cast hepsilon_one]
      _ = 4 * ((epsilon : Real)⁻¹) := by rw [div_eq_mul_inv]
  simp only [HasBRRSAssouadSpectrumExponent] at hnot
  push Not at hnot
  obtain ⟨delta, hdelta, hdelta_one, a, hlarge⟩ := hnot C hC
  have hdelta_small : delta < epsilon := by
    by_contra hnot_small
    have hepsilon_delta : epsilon ≤ delta := le_of_not_gt hnot_small
    have hdelta_real : 0 < (delta : Real) := by exact_mod_cast hdelta
    have hdelta_one_real : (delta : Real) ≤ 1 := by exact_mod_cast hdelta_one.le
    have hscale : (delta : Real) ≤ (delta : Real) ^ theta := by
      calc
        (delta : Real) = (delta : Real) ^ (1 : Real) := by rw [Real.rpow_one]
        _ ≤ (delta : Real) ^ theta :=
          Real.rpow_le_rpow_of_exponent_ge hdelta_real hdelta_one_real htheta_one
    have hR_one : (delta : Real) ^ theta ≤ 1 :=
      Real.rpow_le_one hdelta_real.le hdelta_one_real htheta_zero
    have hgrid : brrsEntropyNumber
        (E ∩ brrsInterval a ((delta : Real) ^ theta)) delta ≤
        4 * (delta : ENNReal)⁻¹ :=
      brrsEntropyNumber_inter_interval_le_four_mul_inv E hdelta_real hscale hR_one
    have hinv : (delta : ENNReal)⁻¹ ≤ (epsilon : ENNReal)⁻¹ :=
      ENNReal.inv_le_inv' (by exact_mod_cast hepsilon_delta)
    have hgrid_epsilon : brrsEntropyNumber
        (E ∩ brrsInterval a ((delta : Real) ^ theta)) delta ≤
        ENNReal.ofReal C := by
      calc
        brrsEntropyNumber
            (E ∩ brrsInterval a ((delta : Real) ^ theta)) delta ≤
            4 * (delta : ENNReal)⁻¹ := hgrid
        _ ≤ 4 * (epsilon : ENNReal)⁻¹ := by gcongr
        _ = ENNReal.ofReal C := by
          dsimp [C]
          rw [ENNReal.ofReal_mul (by norm_num : (0 : Real) ≤ 4),
            ENNReal.ofReal_inv_of_pos hepsilon_real]
          simp
    have hratio : 1 ≤ ((delta : Real) ^ theta) / (delta : Real) := by
      rw [le_div_iff₀ hdelta_real]
      simpa only [one_mul] using hscale
    have hpow : 1 ≤ (((delta : Real) ^ theta) / (delta : Real)) ^ gamma :=
      Real.one_le_rpow hratio hgamma.le
    have hCpow : C ≤ C *
        ((((delta : Real) ^ theta) / (delta : Real)) ^ gamma) :=
      le_mul_of_one_le_right hC.le hpow
    have hupper : brrsEntropyNumber
        (E ∩ brrsInterval a ((delta : Real) ^ theta)) delta ≤
        ENNReal.ofReal
          (C * ((((delta : Real) ^ theta) / (delta : Real)) ^ gamma)) :=
      hgrid_epsilon.trans (ENNReal.ofReal_le_ofReal hCpow)
    exact (not_lt_of_ge hupper) hlarge
  refine ⟨delta, hdelta, hdelta_small, hdelta_one, a, ?_⟩
  have hratio : 1 ≤ ((delta : Real) ^ theta) / (delta : Real) := by
    have hdelta_real : 0 < (delta : Real) := by exact_mod_cast hdelta
    have hdelta_one_real : (delta : Real) ≤ 1 := by exact_mod_cast hdelta_one.le
    have hscale : (delta : Real) ≤ (delta : Real) ^ theta := by
      calc
        (delta : Real) = (delta : Real) ^ (1 : Real) := by rw [Real.rpow_one]
        _ ≤ (delta : Real) ^ theta :=
          Real.rpow_le_rpow_of_exponent_ge hdelta_real hdelta_one_real htheta_one
    rw [le_div_iff₀ hdelta_real]
    simpa only [one_mul] using hscale
  have hpow_nonneg : 0 ≤
      (((delta : Real) ^ theta) / (delta : Real)) ^ gamma :=
    Real.rpow_nonneg (by positivity) _
  have hsmall_le : ENNReal.ofReal
      ((((delta : Real) ^ theta) / (delta : Real)) ^ gamma) ≤
      ENNReal.ofReal
        (C * ((((delta : Real) ^ theta) / (delta : Real)) ^ gamma)) := by
    apply ENNReal.ofReal_le_ofReal
    simpa using mul_le_mul_of_nonneg_right hC_one hpow_nonneg
  exact hsmall_le.trans_lt hlarge

/-- A lower local-entropy witness at an exact testing scale gives the
corresponding lower bound for the source's supremal covering number. -/
theorem inv_rpow_le_brrsAssouadScaleCoveringNumber_of_lower
    (E : Set Real) {theta gamma : Real}
    (htheta_zero : 0 ≤ theta) (htheta_one : theta ≤ 1)
    {delta : NNReal} (hdelta_zero : 0 < delta) (hdelta_one : delta < 1)
    {a : Real}
    (hlower : ENNReal.ofReal
        ((((delta : Real) ^ theta) / (delta : Real)) ^ gamma) ≤
      brrsEntropyNumber
        (E ∩ brrsInterval a ((delta : Real) ^ theta)) delta) :
    (delta : ENNReal) ^ (-((1 - theta) * gamma)) ≤
      brrsAssouadScaleCoveringNumber E delta theta := by
  have hpower := brrsAssouadScale_power_identity
    (theta := theta) (gamma := gamma) (C := 1)
    htheta_zero htheta_one (by norm_num) hdelta_zero hdelta_one
  calc
    (delta : ENNReal) ^ (-((1 - theta) * gamma)) =
        ENNReal.ofReal (1 : Real) *
          (delta : ENNReal) ^ (-((1 - theta) * gamma)) := by simp
    _ = ENNReal.ofReal
        ((1 : Real) * ((((delta : Real) ^ theta) / (delta : Real)) ^ gamma)) := by
      rw [hpower]
    _ = ENNReal.ofReal
        ((((delta : Real) ^ theta) / (delta : Real)) ^ gamma) := by simp
    _ ≤ brrsEntropyNumber
        (E ∩ brrsInterval a ((delta : Real) ^ theta)) delta := hlower
    _ ≤ brrsAssouadScaleCoveringNumber E delta theta :=
      brrsEntropyNumber_le_brrsAssouadScaleCoveringNumber E delta theta a

/-- Every strictly subcritical equality-scale spectrum exponent gives source
lower witnesses arbitrarily close to scale zero. -/
theorem frequently_inv_rpow_le_brrsAssouadScaleCoveringNumber_of_lt_brrsAssouadSpectrum
    (E : Set Real) {theta gamma : Real}
    (htheta_zero : 0 ≤ theta) (htheta_one : theta ≤ 1)
    (hgamma : 0 < gamma)
    (hgamma_lt : gamma < brrsAssouadSpectrum E theta) :
    ∃ᶠ delta : NNReal in 𝓝[>] (0 : NNReal),
      delta ∈ Ioo 0 1 ∧
        (delta : ENNReal) ^ (-((1 - theta) * gamma)) ≤
          brrsAssouadScaleCoveringNumber E delta theta := by
  refine (nhdsGT_basis (0 : NNReal)).frequently_iff.mpr ?_
  intro epsilon hepsilon
  let epsilon' : NNReal := min epsilon (1 / 2)
  have hepsilon'_pos : 0 < epsilon' := by
    dsimp [epsilon']
    exact lt_min hepsilon (by norm_num)
  have hepsilon'_one : epsilon' ≤ 1 := by
    calc
      epsilon' ≤ 1 / 2 := min_le_right _ _
      _ ≤ 1 := by norm_num
  obtain ⟨delta, hdelta, hdelta_epsilon', hdelta_one, a, hlower⟩ :=
    exists_brrsEntropyNumber_lower_witness_at_small_scale E htheta_zero htheta_one
      hgamma hgamma_lt epsilon' hepsilon'_pos hepsilon'_one
  refine ⟨delta, ?_, ?_⟩
  · exact ⟨hdelta, hdelta_epsilon'.trans_le (min_le_left _ _)⟩
  · exact ⟨⟨hdelta, hdelta_one⟩,
      inv_rpow_le_brrsAssouadScaleCoveringNumber_of_lower E htheta_zero htheta_one
        hdelta hdelta_one (a := a) hlower.le⟩

/-- For a nonempty set, the weighted source entropy limsup is nonnegative. -/
theorem brrsAssouadWeightedEntropy_limsup_nonneg_of_nonempty
    {E : Set Real} (hE : E.Nonempty) (theta : Real) :
    0 ≤ Filter.limsup (fun delta : NNReal =>
      brrsAssouadWeightedEntropy E delta theta) (𝓝[>] (0 : NNReal)) := by
  apply Filter.le_limsup_of_frequently_le'
  have hsmall : ∀ᶠ delta : NNReal in 𝓝[>] (0 : NNReal),
      delta ∈ Ioo 0 1 :=
    nhdsGT_basis 0 |>.mem_of_mem zero_lt_one
  exact (hsmall.mono fun delta hdelta =>
    brrsAssouadWeightedEntropy_nonneg_of_nonempty hE hdelta.1 hdelta.2 theta).frequently

/-- The lower half of the fixed-parameter source identity: every affine
subcritical witness forces `(1 - θ) γ_E(θ)` below the weighted entropy
limsup. -/
theorem brrsAssouadSpectrum_weighted_le_brrsAssouadWeightedEntropy_limsup
    {E : Set Real} (hE : E.Nonempty) {theta : Real}
    (htheta_zero : 0 ≤ theta) (htheta_lt_one : theta < 1) :
    (((1 - theta) * brrsAssouadSpectrum E theta : Real) : EReal) ≤
      Filter.limsup (fun delta : NNReal =>
        brrsAssouadWeightedEntropy E delta theta) (𝓝[>] (0 : NNReal)) := by
  let L : EReal := Filter.limsup (fun delta : NNReal =>
    brrsAssouadWeightedEntropy E delta theta) (𝓝[>] (0 : NNReal))
  have hL_nonneg : 0 ≤ L := by
    exact brrsAssouadWeightedEntropy_limsup_nonneg_of_nonempty hE theta
  refine (EReal.ge_of_forall_gt_iff_ge
    (x := L)
    (y := (((1 - theta) * brrsAssouadSpectrum E theta : Real) : EReal))).mp ?_
  intro z hz
  have hz_real : z < (1 - theta) * brrsAssouadSpectrum E theta :=
    EReal.coe_lt_coe_iff.mp hz
  by_cases hz_nonpos : z ≤ 0
  · have hz_nonpos_e : (z : EReal) ≤ 0 := by exact_mod_cast hz_nonpos
    exact hz_nonpos_e.trans hL_nonneg
  · have hz_pos : 0 < z := lt_of_not_ge hz_nonpos
    have hfactor : 0 < 1 - theta := sub_pos.mpr htheta_lt_one
    let gamma : Real := z / (1 - theta)
    have hgamma_pos : 0 < gamma := by
      dsimp [gamma]
      exact div_pos hz_pos hfactor
    have hgamma_lt : gamma < brrsAssouadSpectrum E theta := by
      apply (div_lt_iff₀ hfactor).mpr
      simpa [mul_comm] using hz_real
    have hzgamma : z = (1 - theta) * gamma := by
      dsimp [gamma]
      field_simp [ne_of_gt hfactor]
    have hfrequent :=
      frequently_inv_rpow_le_brrsAssouadScaleCoveringNumber_of_lt_brrsAssouadSpectrum
        E htheta_zero htheta_lt_one.le hgamma_pos hgamma_lt
    change (z : EReal) ≤ L
    apply Filter.le_limsup_of_frequently_le'
    exact hfrequent.mono fun delta hdelta => by
      calc
        (z : EReal) = entropyLogQuotient ((delta : ENNReal) ^ (-z)) delta :=
          (entropyLogQuotient_inv_rpow hdelta.1.1 hdelta.1.2).symm
        _ ≤ entropyLogQuotient
            (brrsAssouadScaleCoveringNumber E delta theta) delta :=
          entropyLogQuotient_mono hdelta.1.1 hdelta.1.2 (by
            rw [hzgamma]
            exact hdelta.2)

/-- The fixed-parameter entropy/spectrum identity before division by
`1 - θ`.  This is precisely the source assertion `limsup φ(δ,θ)=γ_E(θ)` in
its weighted form, which remains meaningful at the endpoint. -/
theorem brrsAssouadWeightedEntropy_limsup_eq_brrsAssouadSpectrum
    {E : Set Real} (hE : E.Nonempty) {theta : Real}
    (htheta_zero : 0 ≤ theta) (htheta_lt_one : theta < 1) :
    Filter.limsup (fun delta : NNReal =>
      brrsAssouadWeightedEntropy E delta theta) (𝓝[>] (0 : NNReal)) =
      (((1 - theta) * brrsAssouadSpectrum E theta : Real) : EReal) := by
  exact le_antisymm
    (brrsAssouadWeightedEntropy_limsup_le_brrsAssouadSpectrum E
      htheta_zero htheta_lt_one)
    (brrsAssouadSpectrum_weighted_le_brrsAssouadWeightedEntropy_limsup
      hE htheta_zero htheta_lt_one)

/-- **BRRS, Section 2 starting identity.**  For a nonempty time set and a
fixed parameter `0 ≤ θ < 1`, the literal source quantity
`φ(δ, θ)` has limsup equal to the equality-scale Assouad spectrum
`γ_E(θ)`. -/
theorem brrsAssouadPhi_limsup_eq_brrsAssouadSpectrum
    {E : Set Real} (hE : E.Nonempty) {theta : Real}
    (htheta_zero : 0 ≤ theta) (htheta_lt_one : theta < 1) :
    Filter.limsup (fun delta : NNReal =>
      brrsAssouadPhi E delta theta) (𝓝[>] (0 : NNReal)) =
      (brrsAssouadSpectrum E theta : EReal) := by
  have hfactor : 0 < 1 - theta := sub_pos.mpr htheta_lt_one
  have hfactor_e_nonneg : 0 ≤ ((1 - theta : Real) : EReal) := by
    exact_mod_cast hfactor.le
  have hinv_nonneg : 0 ≤ ((1 - theta : Real) : EReal)⁻¹ :=
    EReal.inv_nonneg_of_nonneg hfactor_e_nonneg
  have hinv_ne_top : ((1 - theta : Real) : EReal)⁻¹ ≠ ⊤ :=
    (EReal.inv_lt_top _).ne
  change Filter.limsup (fun delta : NNReal =>
    ((1 - theta : Real) : EReal)⁻¹ *
      brrsAssouadWeightedEntropy E delta theta) (𝓝[>] (0 : NNReal)) =
      (brrsAssouadSpectrum E theta : EReal)
  rw [EReal.limsup_const_mul_of_nonneg_of_ne_top hinv_nonneg hinv_ne_top,
    brrsAssouadWeightedEntropy_limsup_eq_brrsAssouadSpectrum
      hE htheta_zero htheta_lt_one]
  rw [← EReal.coe_inv, ← EReal.coe_mul]
  congr 1
  field_simp [ne_of_gt hfactor]

/-- **BRRS, Section 2 limsup sequence.**  The finite-scale envelope in
(2.1) admits a strictly decreasing sequence of positive scales converging to
zero along which its values converge to its actual filter limsup.  This is
the decreasing `δ_n` selection immediately before (2.3). -/
theorem exists_strictAnti_brrsSectionTwo_limsup_sequence
    (E : Set Real) (alpha : Real) :
    ∃ delta : Nat → NNReal, StrictAnti delta ∧ (∀ n, 0 < delta n) ∧
      Tendsto delta atTop (𝓝 (0 : NNReal)) ∧
      Tendsto (fun n => brrsSectionTwoFiniteScaleEnvelope E alpha (delta n))
        atTop (𝓝 (Filter.limsup (brrsSectionTwoFiniteScaleEnvelope E alpha)
          (𝓝[>] (0 : NNReal)))) := by
  let F : NNReal → EReal := brrsSectionTwoFiniteScaleEnvelope E alpha
  let l : Filter NNReal := 𝓝[>] (0 : NNReal)
  obtain ⟨x, hFx, hx⟩ := exists_seq_tendsto_limsup (f := l) (u := F)
  have hx_pos : ∀ᶠ k in atTop, 0 < x k := by
    filter_upwards [hx.eventually self_mem_nhdsWithin] with k hk
    exact hk
  obtain ⟨initialIndex, hinitial⟩ := hx_pos.exists
  let initial : {k : Nat // 0 < x k} := ⟨initialIndex, hinitial⟩
  have hdescend : ∀ p : {k : Nat // 0 < x k},
      ∃ q : {k : Nat // 0 < x k}, p.1 < q.1 ∧ x q.1 < x p.1 := by
    intro p
    have hsmall : Ioo (0 : NNReal) (x p.1) ∈ 𝓝[>] (0 : NNReal) :=
      Ioo_mem_nhdsGT p.2
    have htail : ∀ᶠ k in atTop, x k ∈ Ioo (0 : NNReal) (x p.1) :=
      hx.eventually hsmall
    obtain ⟨q, hq⟩ := ((eventually_gt_atTop p.1).and htail).exists
    exact ⟨⟨q, hq.2.1⟩, hq.1, hq.2.2⟩
  choose descend hdescendIndex hdescendValue using hdescend
  let s : Nat → {k : Nat // 0 < x k} :=
    Nat.rec initial (fun _ p => descend p)
  let phi : Nat → Nat := fun n => (s n).1
  let delta : Nat → NNReal := fun n => x (phi n)
  have hs_succ (n : Nat) : s (n + 1) = descend (s n) := by
    simp [s]
  have hphi_strict : StrictMono phi := by
    apply strictMono_nat_of_lt_succ
    intro n
    change (s n).1 < (s (n + 1)).1
    rw [hs_succ]
    exact hdescendIndex (s n)
  have hdelta_strictAnti : StrictAnti delta := by
    apply strictAnti_nat_of_succ_lt
    intro n
    change x (phi (n + 1)) < x (phi n)
    change x (s (n + 1)).1 < x (s n).1
    rw [hs_succ]
    exact hdescendValue (s n)
  have hdelta_pos : ∀ n, 0 < delta n := by
    intro n
    exact (s n).2
  have hdelta_tendstoWithin : Tendsto delta atTop (𝓝[>] (0 : NNReal)) := by
    simpa only [delta, phi, Function.comp_def, l] using
      hx.comp hphi_strict.tendsto_atTop
  have hdelta_tendsto : Tendsto delta atTop (𝓝 (0 : NNReal)) :=
    hdelta_tendstoWithin.mono_right nhdsWithin_le_nhds
  refine ⟨delta, hdelta_strictAnti, hdelta_pos, hdelta_tendsto, ?_⟩
  simpa only [F, delta, phi, Function.comp_def, l] using
    hFx.comp hphi_strict.tendsto_atTop

/-- A lower entropy witness at the exact spectrum testing scale contributes
the corresponding affine lower bound to the finite-scale BRRS profile. -/
theorem inv_rpow_le_brrsLegendreAssouadProfile_of_brrsEntropyNumber_lower
    (E : Set Real) {theta gamma alpha : Real}
    (htheta_zero : 0 ≤ theta) (htheta_one : theta ≤ 1)
    {delta : NNReal} (hdelta : 0 < delta) (hdelta_one : delta < 1)
    {a : Real}
    (hlower : ENNReal.ofReal
        ((((delta : Real) ^ theta) / (delta : Real)) ^ gamma) ≤
      brrsEntropyNumber
        (E ∩ brrsInterval a ((delta : Real) ^ theta)) delta) :
    (delta : ENNReal) ^ (-(theta * alpha + (1 - theta) * gamma)) ≤
      brrsLegendreAssouadProfile E alpha delta := by
  have hdelta_real : 0 < (delta : Real) := by exact_mod_cast hdelta
  have hdelta_one_real : (delta : Real) ≤ 1 := by exact_mod_cast hdelta_one.le
  have hscale_real : (delta : Real) ≤ (delta : Real) ^ theta := by
    calc
      (delta : Real) = (delta : Real) ^ (1 : Real) := by rw [Real.rpow_one]
      _ ≤ (delta : Real) ^ theta :=
        Real.rpow_le_rpow_of_exponent_ge hdelta_real hdelta_one_real htheta_one
  have hR_one_real : (delta : Real) ^ theta ≤ 1 :=
    Real.rpow_le_one hdelta_real.le hdelta_one_real htheta_zero
  have hscale : delta ≤ delta ^ theta := by
    apply NNReal.coe_le_coe.mp
    simpa only [NNReal.coe_rpow] using hscale_real
  have hR_one : delta ^ theta ≤ 1 := by
    apply NNReal.coe_le_coe.mp
    simpa only [NNReal.coe_rpow, NNReal.coe_one] using hR_one_real
  let R : Icc delta 1 := ⟨delta ^ theta, hscale, hR_one⟩
  let q : Real := ((delta : Real) ^ theta) / (delta : Real)
  have hq : 0 < q := by
    dsimp [q]
    exact div_pos (Real.rpow_pos_of_pos hdelta_real _) hdelta_real
  have hratio : ENNReal.ofReal q =
      (delta : ENNReal) ^ theta / (delta : ENNReal) := by
    dsimp [q]
    calc
      ENNReal.ofReal (((delta : Real) ^ theta / (delta : Real))) =
          ENNReal.ofReal ((delta : Real) ^ theta) /
            ENNReal.ofReal (delta : Real) :=
        ENNReal.ofReal_div_of_pos hdelta_real
      _ = (delta : ENNReal) ^ theta / (delta : ENNReal) := by
        rw [(ENNReal.ofReal_rpow_of_pos (x := (delta : Real)) (p := theta)
          hdelta_real).symm]
        simp
  have hlocal' :
      ((delta : ENNReal) ^ theta / (delta : ENNReal)) ^ gamma ≤
        brrsEntropyNumber
          (E ∩ brrsInterval a ((delta : Real) ^ theta)) delta := by
    calc
      ((delta : ENNReal) ^ theta / (delta : ENNReal)) ^ gamma =
          (ENNReal.ofReal q) ^ gamma :=
        congrArg (fun z : ENNReal => z ^ gamma) hratio.symm
      _ = ENNReal.ofReal (q ^ gamma) :=
        ENNReal.ofReal_rpow_of_pos hq
      _ ≤ brrsEntropyNumber
          (E ∩ brrsInterval a ((delta : Real) ^ theta)) delta := by
        simpa only [q] using hlower
  have hlocal :
      ((delta : ENNReal) ^ theta / (delta : ENNReal)) ^ gamma ≤
        brrsEntropyNumber (E ∩ brrsInterval a (R.1 : Real)) delta := by
    simpa [R, NNReal.coe_rpow] using hlocal'
  have hdelta_zero : (delta : ENNReal) ≠ 0 :=
    ne_of_gt (by exact_mod_cast hdelta)
  calc
    (delta : ENNReal) ^ (-(theta * alpha + (1 - theta) * gamma)) =
        (R.1 : ENNReal) ^ (-alpha) *
          ((delta : ENNReal) ^ theta / (delta : ENNReal)) ^ gamma := by
      dsimp [R]
      rw [ENNReal.coe_rpow_of_ne_zero hdelta.ne']
      calc
        (delta : ENNReal) ^ (-(theta * alpha + (1 - theta) * gamma)) =
            (delta : ENNReal) ^
              (theta * (-alpha) + (theta - 1) * gamma) := by
          congr 1
          ring
        _ = (delta : ENNReal) ^ (theta * (-alpha)) *
            (delta : ENNReal) ^ ((theta - 1) * gamma) := by
          rw [ENNReal.rpow_add _ _ hdelta_zero ENNReal.coe_ne_top]
        _ = ((delta : ENNReal) ^ theta) ^ (-alpha) *
            ((delta : ENNReal) ^ (theta - 1)) ^ gamma := by
          rw [(ENNReal.rpow_mul _ theta (-alpha)).symm,
            (ENNReal.rpow_mul _ (theta - 1) gamma).symm]
        _ = ((delta : ENNReal) ^ theta) ^ (-alpha) *
            ((delta : ENNReal) ^ theta / (delta : ENNReal)) ^ gamma := by
          congr 1
          rw [ENNReal.rpow_sub theta 1 hdelta_zero ENNReal.coe_ne_top,
            ENNReal.rpow_one]
    _ ≤ (R.1 : ENNReal) ^ (-alpha) *
        brrsEntropyNumber (E ∩ brrsInterval a (R.1 : Real)) delta := by
      gcongr
    _ ≤ brrsLegendreAssouadProfile E alpha delta := by
      unfold brrsLegendreAssouadProfile
      exact le_iSup_of_le a (le_iSup_of_le R (le_refl _))

/-- Strictly subcritical exact-spectrum exponents give profile lower bounds
at arbitrarily small scales. -/
theorem frequently_inv_rpow_le_brrsLegendreAssouadProfile_of_lt_brrsAssouadSpectrum
    (E : Set Real) {theta gamma alpha : Real}
    (htheta_zero : 0 ≤ theta) (htheta_one : theta ≤ 1)
    (hgamma : 0 < gamma)
    (hgamma_lt : gamma < brrsAssouadSpectrum E theta) :
    ∃ᶠ delta : NNReal in 𝓝[>] (0 : NNReal),
      delta ∈ Ioo 0 1 ∧
        (delta : ENNReal) ^ (-(theta * alpha + (1 - theta) * gamma)) ≤
          brrsLegendreAssouadProfile E alpha delta := by
  refine (nhdsGT_basis (0 : NNReal)).frequently_iff.mpr ?_
  intro epsilon hepsilon
  let epsilon' : NNReal := min epsilon (1 / 2)
  have hepsilon'_pos : 0 < epsilon' := by
    dsimp [epsilon']
    exact lt_min hepsilon (by norm_num)
  have hepsilon'_one : epsilon' ≤ 1 := by
    calc
      epsilon' ≤ 1 / 2 := min_le_right _ _
      _ ≤ 1 := by norm_num
  obtain ⟨delta, hdelta, hdelta_epsilon', hdelta_one, a, hlower⟩ :=
    exists_brrsEntropyNumber_lower_witness_at_small_scale E htheta_zero htheta_one
      hgamma hgamma_lt epsilon' hepsilon'_pos hepsilon'_one
  refine ⟨delta, ?_, ?_⟩
  · exact ⟨hdelta, hdelta_epsilon'.trans_le (min_le_left _ _)⟩
  · exact ⟨⟨hdelta, hdelta_one⟩,
      inv_rpow_le_brrsLegendreAssouadProfile_of_brrsEntropyNumber_lower E
        htheta_zero htheta_one hdelta hdelta_one (a := a) hlower.le⟩

/-- The literal BRRS exponent dominates every affine lower bound coming from
a strictly subcritical equality-scale spectrum exponent. -/
theorem le_brrsLegendreAssouadExponent_of_lt_brrsAssouadSpectrum
    (E : Set Real) {theta gamma alpha : Real}
    (htheta_zero : 0 ≤ theta) (htheta_one : theta ≤ 1)
    (hgamma : 0 < gamma)
    (hgamma_lt : gamma < brrsAssouadSpectrum E theta) :
    ((theta * alpha + (1 - theta) * gamma : Real) : EReal) ≤
      brrsLegendreAssouadExponent E alpha := by
  apply le_brrsLegendreAssouadExponent_of_frequently_le_entropyLogQuotient
  exact
    (frequently_inv_rpow_le_brrsLegendreAssouadProfile_of_lt_brrsAssouadSpectrum
      E htheta_zero htheta_one hgamma hgamma_lt).mono fun delta hdelta => by
      calc
        ((theta * alpha + (1 - theta) * gamma : Real) : EReal) =
            entropyLogQuotient
              ((delta : ENNReal) ^
                (-(theta * alpha + (1 - theta) * gamma))) delta :=
          (entropyLogQuotient_inv_rpow hdelta.1.1 hdelta.1.2).symm
        _ ≤ entropyLogQuotient
            (brrsLegendreAssouadProfile E alpha delta) delta :=
          entropyLogQuotient_mono hdelta.1.1 hdelta.1.2 hdelta.2

/-- On nonnegative penalty parameters, a strictly subcritical exact-spectrum
exponent also gives a lower bound for the real-valued BRRS function. -/
theorem le_brrsLegendreAssouadFunction_of_lt_brrsAssouadSpectrum
    (E : Set Real) {theta gamma alpha : Real}
    (htheta_zero : 0 ≤ theta) (htheta_one : theta ≤ 1)
    (hgamma : 0 < gamma)
    (hgamma_lt : gamma < brrsAssouadSpectrum E theta)
    (halpha : 0 ≤ alpha) :
    theta * alpha + (1 - theta) * gamma ≤
      brrsLegendreAssouadFunction E alpha := by
  rw [brrsLegendreAssouadFunction_eq_exponent_toReal]
  change ((theta * alpha + (1 - theta) * gamma : Real) : EReal).toReal ≤
    (brrsLegendreAssouadExponent E alpha).toReal
  refine EReal.toReal_le_toReal ?_ ?_ ?_
  · exact le_brrsLegendreAssouadExponent_of_lt_brrsAssouadSpectrum E
      htheta_zero htheta_one hgamma hgamma_lt
  · exact EReal.coe_ne_bot _
  · exact brrsLegendreAssouadExponent_ne_top_of_nonneg E halpha

/-- When the equality-scale spectrum is positive, its affine contribution is
the limit of the strictly subcritical lower bounds. -/
theorem le_brrsLegendreAssouadFunction_of_brrsAssouadSpectrum_pos
    (E : Set Real) {theta alpha : Real}
    (htheta_zero : 0 ≤ theta) (htheta_one : theta ≤ 1)
    (hspectrum : 0 < brrsAssouadSpectrum E theta)
    (halpha : 0 ≤ alpha) :
    theta * alpha + (1 - theta) * brrsAssouadSpectrum E theta ≤
      brrsLegendreAssouadFunction E alpha := by
  apply le_of_forall_pos_le_add
  intro epsilon hepsilon
  let eta : Real := min epsilon (brrsAssouadSpectrum E theta / 2)
  have heta_pos : 0 < eta := by
    dsimp [eta]
    exact lt_min hepsilon (half_pos hspectrum)
  have heta_le : eta ≤ brrsAssouadSpectrum E theta / 2 := min_le_right _ _
  let gamma : Real := brrsAssouadSpectrum E theta - eta
  have hgamma : 0 < gamma := by
    dsimp [gamma]
    exact sub_pos.mpr (lt_of_le_of_lt heta_le (half_lt_self hspectrum))
  have hgamma_lt : gamma < brrsAssouadSpectrum E theta := by
    dsimp [gamma]
    exact sub_lt_self _ heta_pos
  have hsubcritical : theta * alpha + (1 - theta) * gamma ≤
      brrsLegendreAssouadFunction E alpha :=
    le_brrsLegendreAssouadFunction_of_lt_brrsAssouadSpectrum E
      htheta_zero htheta_one hgamma hgamma_lt halpha
  have hfactor_one : 1 - theta ≤ 1 := by linarith
  have heta_epsilon : eta ≤ epsilon := min_le_left _ _
  have herror : (1 - theta) * eta ≤ epsilon := by
    calc
      (1 - theta) * eta ≤ 1 * eta :=
        mul_le_mul_of_nonneg_right hfactor_one heta_pos.le
      _ ≤ 1 * epsilon := by gcongr
      _ = epsilon := by ring
  calc
    theta * alpha + (1 - theta) * brrsAssouadSpectrum E theta =
        (theta * alpha + (1 - theta) * gamma) + (1 - theta) * eta := by
      dsimp [gamma]
      ring
    _ ≤ brrsLegendreAssouadFunction E alpha + epsilon := by gcongr

/-- Every individual affine term in the BRRS spectrum transform is a lower
bound for the literal BRRS Legendre--Assouad function at nonnegative penalty.
The zero-spectrum case uses the elementary endpoint-scale lower bound. -/
theorem brrsAssouadSpectrum_affine_le_brrsLegendreAssouadFunction_of_nonempty
    {E : Set Real} (hE : E.Nonempty) {theta alpha : Real}
    (htheta_zero : 0 ≤ theta) (htheta_one : theta ≤ 1)
    (halpha : 0 ≤ alpha) :
    theta * alpha + (1 - theta) * brrsAssouadSpectrum E theta ≤
      brrsLegendreAssouadFunction E alpha := by
  by_cases hspectrum_zero : brrsAssouadSpectrum E theta = 0
  · rw [hspectrum_zero]
    have htheta_alpha : theta * alpha ≤ alpha := by
      calc
        theta * alpha ≤ 1 * alpha :=
          mul_le_mul_of_nonneg_right htheta_one halpha
        _ = alpha := by ring
    simpa using htheta_alpha.trans
      (le_brrsLegendreAssouadFunction_of_nonempty hE halpha)
  · apply le_brrsLegendreAssouadFunction_of_brrsAssouadSpectrum_pos E
      htheta_zero htheta_one ?_ halpha
    exact lt_of_le_of_ne (brrsAssouadSpectrum_nonneg E htheta_one)
      (Ne.symm hspectrum_zero)

/-- The exact-scale BRRS spectrum satisfies the same one-sided parameter
interpolation inequality as the usual Assouad spectrum. -/
theorem brrsAssouadSpectrum_parameter_lift_le
    (E : Set Real) {theta theta' : Real}
    (htheta : theta ≤ theta') (htheta' : theta' < 1) :
    brrsAssouadSpectrum E theta' ≤
      brrsAssouadSpectrum E theta * ((1 - theta) / (1 - theta')) := by
  have htheta_one : theta ≤ 1 := htheta.trans htheta'.le
  have hden : 0 < 1 - theta' := sub_pos.mpr htheta'
  have hratio : 0 < (1 - theta) / (1 - theta') := by
    apply div_pos
    · linarith
    · exact hden
  let S : Set Real := {gamma : Real | 0 < gamma ∧
    HasBRRSAssouadSpectrumExponent E theta gamma}
  let T : Set Real := {gamma : Real | 0 < gamma ∧
    HasBRRSAssouadSpectrumExponent E theta' gamma}
  have hSbelow : BddBelow S := by
    refine ⟨0, ?_⟩
    intro gamma hgamma
    exact hgamma.1.le
  have hSne : S.Nonempty := brrsAssouadAdmissibleExponents_nonempty E htheta_one
  have hTbelow : BddBelow T := by
    refine ⟨0, ?_⟩
    intro gamma hgamma
    exact hgamma.1.le
  change sInf T ≤ sInf S * ((1 - theta) / (1 - theta'))
  by_contra hnot
  have hlt : sInf S * ((1 - theta) / (1 - theta')) < sInf T := lt_of_not_ge hnot
  have htarget : sInf S < sInf T / ((1 - theta) / (1 - theta')) := by
    apply (lt_div_iff₀ hratio).2
    simpa only [div_eq_mul_inv, mul_assoc, mul_comm, mul_left_comm] using hlt
  obtain ⟨s, hs, hslt⟩ := exists_lt_of_csInf_lt hSne htarget
  have hlift : HasBRRSAssouadSpectrumExponent E theta'
      (s * ((1 - theta) / (1 - theta'))) :=
    HasBRRSAssouadSpectrumExponent.lift_parameter htheta htheta' hs.2
  have hmem : s * ((1 - theta) / (1 - theta')) ∈ T := by
    refine ⟨mul_pos hs.1 hratio, hlift⟩
  have hle : sInf T ≤ s * ((1 - theta) / (1 - theta')) := csInf_le hTbelow hmem
  have hstrict : s * ((1 - theta) / (1 - theta')) < sInf T := by
    exact (lt_div_iff₀ hratio).mp hslt
  exact (not_lt_of_ge hle) hstrict

/-- The numerical exact-scale spectrum satisfies the complementary estimate
obtained by subdividing a larger testing interval into smaller exact ones. -/
theorem brrsAssouadSpectrum_subdivide_parameter_le
    (E : Set Real) {theta theta' : Real}
    (htheta : theta' ≤ theta) (htheta_lt : theta < 1) :
    brrsAssouadSpectrum E theta' ≤
      (((1 - theta) * brrsAssouadSpectrum E theta + (theta - theta')) /
        (1 - theta')) := by
  have htheta'_lt : theta' < 1 := lt_of_le_of_lt htheta htheta_lt
  have htheta_one : theta ≤ 1 := htheta_lt.le
  have hden : 0 < 1 - theta := sub_pos.mpr htheta_lt
  have hden' : 0 < 1 - theta' := sub_pos.mpr htheta'_lt
  let S : Set Real := {gamma : Real | 0 < gamma ∧
    HasBRRSAssouadSpectrumExponent E theta gamma}
  let T : Set Real := {gamma : Real | 0 < gamma ∧
    HasBRRSAssouadSpectrumExponent E theta' gamma}
  have hSne : S.Nonempty := brrsAssouadAdmissibleExponents_nonempty E htheta_one
  have hTbelow : BddBelow T := by
    refine ⟨0, ?_⟩
    intro gamma hgamma
    exact hgamma.1.le
  change sInf T ≤ ((1 - theta) * sInf S + (theta - theta')) / (1 - theta')
  by_contra hnot
  have hlt : ((1 - theta) * sInf S + (theta - theta')) / (1 - theta') <
      sInf T := lt_of_not_ge hnot
  have hlt' : (1 - theta) * sInf S + (theta - theta') <
      sInf T * (1 - theta') := (div_lt_iff₀ hden').mp hlt
  have htarget : sInf S <
      ((1 - theta') * sInf T - (theta - theta')) / (1 - theta) := by
    apply (lt_div_iff₀ hden).2
    calc
      sInf S * (1 - theta) = (1 - theta) * sInf S := by ring
      _ < sInf T * (1 - theta') - (theta - theta') := by linarith
      _ = (1 - theta') * sInf T - (theta - theta') := by ring
  obtain ⟨s, hs, hslt⟩ := exists_lt_of_csInf_lt hSne htarget
  have hsubdivide : HasBRRSAssouadSpectrumExponent E theta'
      (((1 - theta) * s + (theta - theta')) / (1 - theta')) :=
    HasBRRSAssouadSpectrumExponent.subdivide_parameter htheta htheta_lt hs.2
  have hnum : 0 < (1 - theta) * s + (theta - theta') :=
    add_pos_of_pos_of_nonneg (mul_pos hden hs.1) (sub_nonneg.mpr htheta)
  have hmem : ((1 - theta) * s + (theta - theta')) / (1 - theta') ∈ T := by
    exact ⟨div_pos hnum hden', hsubdivide⟩
  have hle : sInf T ≤ ((1 - theta) * s + (theta - theta')) /
      (1 - theta') := csInf_le hTbelow hmem
  have hslt' : s * (1 - theta) <
      (1 - theta') * sInf T - (theta - theta') :=
    (lt_div_iff₀ hden).mp hslt
  have hstrict : ((1 - theta) * s + (theta - theta')) / (1 - theta') <
      sInf T := by
    apply (div_lt_iff₀ hden').2
    calc
      (1 - theta) * s + (theta - theta') =
          s * (1 - theta) + (theta - theta') := by ring
      _ < ((1 - theta') * sInf T - (theta - theta')) + (theta - theta') := by
        linarith
      _ = sInf T * (1 - theta') := by ring
  exact (not_lt_of_ge hle) hstrict

/-- Equivalently, the weighted exact-scale spectrum is antitone below its
endpoint. -/
theorem brrsWeightedAssouadSpectrum_parameter_antitone
    (E : Set Real) {theta theta' : Real}
    (htheta : theta ≤ theta') (htheta' : theta' < 1) :
    (1 - theta') * brrsAssouadSpectrum E theta' ≤
      (1 - theta) * brrsAssouadSpectrum E theta := by
  have hden : 0 < 1 - theta' := sub_pos.mpr htheta'
  have hlift := brrsAssouadSpectrum_parameter_lift_le E htheta htheta'
  have hmul := mul_le_mul_of_nonneg_left hlift hden.le
  calc
    (1 - theta') * brrsAssouadSpectrum E theta' ≤
        (1 - theta') *
          (brrsAssouadSpectrum E theta * ((1 - theta) / (1 - theta'))) := hmul
    _ = (1 - theta) * brrsAssouadSpectrum E theta := by
      field_simp [hden.ne']

/-- The reverse one-sided bound for the weighted exact-scale spectrum. -/
theorem brrsWeightedAssouadSpectrum_subdivide_parameter_le
    (E : Set Real) {theta theta' : Real}
    (htheta : theta' ≤ theta) (htheta_lt : theta < 1) :
    (1 - theta') * brrsAssouadSpectrum E theta' ≤
      (1 - theta) * brrsAssouadSpectrum E theta + (theta - theta') := by
  have hden : 0 < 1 - theta' := sub_pos.mpr (lt_of_le_of_lt htheta htheta_lt)
  have hsubdivide := brrsAssouadSpectrum_subdivide_parameter_le E htheta htheta_lt
  have hmul := mul_le_mul_of_nonneg_left hsubdivide hden.le
  calc
    (1 - theta') * brrsAssouadSpectrum E theta' ≤
        (1 - theta') *
          (((1 - theta) * brrsAssouadSpectrum E theta + (theta - theta')) /
            (1 - theta')) := hmul
    _ = (1 - theta) * brrsAssouadSpectrum E theta + (theta - theta') := by
      field_simp [hden.ne']

/-- The weighted exact-scale spectrum is one-Lipschitz from the left:
for `theta' ≤ theta < 1`, its two values differ by at most `theta - theta'`. -/
theorem brrsWeightedAssouadSpectrum_parameter_bounds
    (E : Set Real) {theta theta' : Real}
    (htheta : theta' ≤ theta) (htheta_lt : theta < 1) :
    (1 - theta) * brrsAssouadSpectrum E theta ≤
      (1 - theta') * brrsAssouadSpectrum E theta' ∧
    (1 - theta') * brrsAssouadSpectrum E theta' ≤
      (1 - theta) * brrsAssouadSpectrum E theta + (theta - theta') :=
  ⟨brrsWeightedAssouadSpectrum_parameter_antitone E htheta htheta_lt,
    brrsWeightedAssouadSpectrum_subdivide_parameter_le E htheta htheta_lt⟩

/-- On the entire interval below one, the weighted exact-scale spectrum is
one-Lipschitz. -/
theorem brrsWeightedAssouadSpectrum_lipschitzOn (E : Set Real) :
    LipschitzOnWith 1
      (fun theta : Real => (1 - theta) * brrsAssouadSpectrum E theta) (Iio 1) := by
  refine LipschitzOnWith.of_dist_le_mul fun x hx y hy => ?_
  have hforward : ∀ {u v : Real}, u ≤ v → v < 1 →
      dist ((1 - u) * brrsAssouadSpectrum E u)
        ((1 - v) * brrsAssouadSpectrum E v) ≤ dist u v := by
    intro u v huv hv
    have hbounds := brrsWeightedAssouadSpectrum_parameter_bounds E huv hv
    rw [Real.dist_eq, Real.dist_eq]
    rw [abs_of_nonneg (sub_nonneg.mpr hbounds.1),
      abs_of_nonpos (sub_nonpos.mpr huv)]
    linarith [hbounds.2]
  rcases le_total x y with hxy | hyx
  · simpa only [NNReal.coe_one, one_mul] using hforward hxy hy
  · simpa only [NNReal.coe_one, one_mul, dist_comm] using hforward hyx hx

/-- In particular, the weighted exact-scale spectrum is continuous below its
endpoint. -/
theorem brrsWeightedAssouadSpectrum_continuousOn (E : Set Real) :
    ContinuousOn (fun theta : Real => (1 - theta) * brrsAssouadSpectrum E theta) (Iio 1) :=
  (brrsWeightedAssouadSpectrum_lipschitzOn E).continuousOn

/-- The endpoint value of the weighted exact-scale spectrum obeys the same
one-Lipschitz estimate.  This is the closed-interval form needed when the
spectral Legendre transform is treated as a maximum rather than merely a
supremum. -/
theorem brrsWeightedAssouadSpectrum_lipschitzOn_Iic (E : Set Real) :
    LipschitzOnWith 1
      (fun theta : Real => (1 - theta) * brrsAssouadSpectrum E theta)
      (Iic (1 : Real)) := by
  refine LipschitzOnWith.of_dist_le_mul fun x hx y hy => ?_
  have hforward : ∀ {u v : Real}, u ≤ v → v ≤ 1 →
      dist ((1 - u) * brrsAssouadSpectrum E u)
        ((1 - v) * brrsAssouadSpectrum E v) ≤ dist u v := by
    intro u v huv hv
    rcases lt_or_eq_of_le hv with hvlt | rfl
    · have hbounds := brrsWeightedAssouadSpectrum_parameter_bounds E huv hvlt
      rw [Real.dist_eq, Real.dist_eq]
      rw [abs_of_nonneg (sub_nonneg.mpr hbounds.1),
        abs_of_nonpos (sub_nonpos.mpr huv)]
      linarith [hbounds.2]
    · have hu_nonneg : 0 ≤ (1 - u) * brrsAssouadSpectrum E u :=
        mul_nonneg (sub_nonneg.mpr huv)
          (brrsAssouadSpectrum_nonneg E huv)
      have hu_le : (1 - u) * brrsAssouadSpectrum E u ≤ 1 - u := by
        calc
          (1 - u) * brrsAssouadSpectrum E u ≤ (1 - u) * 1 :=
            mul_le_mul_of_nonneg_left
              (brrsAssouadSpectrum_le_one E huv) (sub_nonneg.mpr huv)
          _ = 1 - u := by ring
      rw [Real.dist_eq, Real.dist_eq]
      simp only [sub_self, zero_mul, sub_zero]
      rw [abs_of_nonneg hu_nonneg, abs_of_nonpos (sub_nonpos.mpr huv)]
      linarith [hu_le]
  rcases le_total x y with hxy | hyx
  · simpa only [NNReal.coe_one, one_mul] using hforward hxy hy
  · simpa only [NNReal.coe_one, one_mul, dist_comm] using hforward hyx hx

/-- The weighted exact-scale spectrum is continuous on the closed parameter
interval. -/
theorem brrsWeightedAssouadSpectrum_continuousOn_Iic (E : Set Real) :
    ContinuousOn (fun theta : Real => (1 - theta) * brrsAssouadSpectrum E theta)
      (Iic (1 : Real)) :=
  (brrsWeightedAssouadSpectrum_lipschitzOn_Iic E).continuousOn

/-- **BRRS, Section 2 compact-maximization step.**  The continuous spectrum
expression which occurs on the right side of (2.1) attains its maximum on
the literal compact parameter interval.  This is the source choice made in
(2.2), stated with the weighted spectrum (the form also needed in (2.4)). -/
theorem exists_brrsAssouadSpectrum_affine_maximizer (E : Set Real)
    (alpha : Real) :
    ∃ theta ∈ Icc (0 : Real) 1, ∀ eta ∈ Icc (0 : Real) 1,
      eta * alpha + (1 - eta) * brrsAssouadSpectrum E eta ≤
        theta * alpha + (1 - theta) * brrsAssouadSpectrum E theta := by
  let F : Real → Real := fun theta =>
    theta * alpha + (1 - theta) * brrsAssouadSpectrum E theta
  have hweighted : ContinuousOn
      (fun theta : Real => (1 - theta) * brrsAssouadSpectrum E theta)
      (Icc (0 : Real) 1) :=
    (brrsWeightedAssouadSpectrum_continuousOn_Iic E).mono
      (fun theta htheta => htheta.2)
  have hlinear : ContinuousOn (fun theta : Real => theta * alpha)
      (Icc (0 : Real) 1) :=
    continuousOn_id.mul continuousOn_const
  have hFcont : ContinuousOn F (Icc (0 : Real) 1) := by
    exact hlinear.add hweighted
  obtain ⟨theta, htheta, hmax⟩ :=
    isCompact_Icc.exists_isMaxOn (by exact ⟨0, by norm_num⟩) hFcont
  refine ⟨theta, htheta, ?_⟩
  intro eta heta
  have hmax' : ∀ u ∈ Icc (0 : Real) 1, F u ≤ F theta := by
    simpa only [IsMaxOn, IsMaxFilter, Filter.eventually_principal] using hmax
  exact hmax' eta heta

/-- **BRRS (2.2), the lower half of (2.1).**  Choose a maximizing parameter
`θ_α` for the spectral affine expression.  Substituting this one fixed
parameter into the literal finite-scale envelope gives the lower inequality
in (2.1).  At `θ_α < 1` this is the source identity
`(1 - θ_α) φ(δ, θ_α) =` weighted entropy; at the endpoint it follows from
nonnegativity of the weighted entropy. -/
theorem exists_brrsSectionTwo_lower_half_maximizer
    {E : Set Real} (hE : E.Nonempty) (alpha : Real) :
    ∃ theta ∈ Icc (0 : Real) 1,
      (∀ eta ∈ Icc (0 : Real) 1,
        eta * alpha + (1 - eta) * brrsAssouadSpectrum E eta ≤
          theta * alpha + (1 - theta) * brrsAssouadSpectrum E theta) ∧
      (((theta * alpha + (1 - theta) * brrsAssouadSpectrum E theta : Real) :
        EReal) ≤
        Filter.limsup (brrsSectionTwoFiniteScaleEnvelope E alpha)
          (𝓝[>] (0 : NNReal))) := by
  obtain ⟨theta, htheta, hmax⟩ :=
    exists_brrsAssouadSpectrum_affine_maximizer E alpha
  refine ⟨theta, htheta, hmax, ?_⟩
  by_cases htheta_lt_one : theta < 1
  · let c : EReal := ((theta * alpha : Real) : EReal)
    let W : NNReal → EReal := fun delta =>
      brrsAssouadWeightedEntropy E delta theta
    let l : Filter NNReal := 𝓝[>] (0 : NNReal)
    have hfactor_nonneg : 0 ≤ ((1 - theta : Real) : EReal) := by
      exact_mod_cast (sub_nonneg.mpr htheta.2)
    have hfactor_ne_top : ((1 - theta : Real) : EReal) ≠ ⊤ :=
      EReal.coe_ne_top _
    have hphi : Filter.limsup (fun delta : NNReal =>
        brrsAssouadPhi E delta theta) l =
        (brrsAssouadSpectrum E theta : EReal) := by
      simpa only [l] using
        (brrsAssouadPhi_limsup_eq_brrsAssouadSpectrum hE htheta.1
          htheta_lt_one)
    have hweighted : Filter.limsup W l =
        (((1 - theta) * brrsAssouadSpectrum E theta : Real) : EReal) := by
      calc
        Filter.limsup W l = Filter.limsup (fun delta : NNReal =>
            ((1 - theta : Real) : EReal) * brrsAssouadPhi E delta theta) l := by
              apply Filter.limsup_congr
              exact Filter.Eventually.of_forall fun delta => by
                dsimp [W]
                exact (one_sub_mul_brrsAssouadPhi_eq_weightedEntropy E delta
                  htheta_lt_one).symm
        _ = ((1 - theta : Real) : EReal) *
            Filter.limsup (fun delta : NNReal => brrsAssouadPhi E delta theta) l := by
              rw [EReal.limsup_const_mul_of_nonneg_of_ne_top hfactor_nonneg
                hfactor_ne_top]
        _ = (((1 - theta) * brrsAssouadSpectrum E theta : Real) : EReal) := by
              rw [hphi, ← EReal.coe_mul]
    have hadd : c + Filter.limsup W l ≤
        Filter.limsup (fun delta : NNReal => c + W delta) l := by
      calc
        c + Filter.limsup W l =
            Filter.limsup W l + Filter.liminf (fun _ : NNReal => c) l := by
              rw [Filter.liminf_const]
              ac_rfl
        _ ≤ Filter.limsup (W + fun _ : NNReal => c) l :=
          EReal.le_limsup_add
        _ = Filter.limsup (fun delta : NNReal => c + W delta) l := by
          apply Filter.limsup_congr
          exact Filter.Eventually.of_forall fun delta => by
            simpa using (add_comm (W delta) c)
    have hpoint : ∀ delta : NNReal, c + W delta ≤
        brrsSectionTwoFiniteScaleEnvelope E alpha delta := by
      intro delta
      simpa [c, W, brrsSectionTwoFiniteScaleEnvelope] using
        (le_iSup (fun eta : BRRSParameter =>
          ((eta.1 * alpha : Real) : EReal) +
            brrsAssouadWeightedEntropy E delta eta.1) ⟨theta, htheta⟩)
    have htransfer : Filter.limsup (fun delta : NNReal => c + W delta) l ≤
        Filter.limsup (brrsSectionTwoFiniteScaleEnvelope E alpha) l :=
      Filter.limsup_le_limsup (Filter.Eventually.of_forall hpoint)
    calc
      ((theta * alpha + (1 - theta) * brrsAssouadSpectrum E theta : Real) :
          EReal) = c + Filter.limsup W l := by
            rw [hweighted, ← EReal.coe_add]
      _ ≤ Filter.limsup (fun delta : NNReal => c + W delta) l := hadd
      _ ≤ Filter.limsup (brrsSectionTwoFiniteScaleEnvelope E alpha) l := htransfer
      _ = Filter.limsup (brrsSectionTwoFiniteScaleEnvelope E alpha)
          (𝓝[>] (0 : NNReal)) := by rfl
  · have htheta_eq : theta = 1 :=
      le_antisymm htheta.2 (le_of_not_gt htheta_lt_one)
    subst theta
    simp only [one_mul, sub_self, zero_mul, add_zero]
    apply Filter.le_limsup_of_frequently_le'
    have hsmall : ∀ᶠ delta : NNReal in 𝓝[>] (0 : NNReal),
        delta ∈ Ioo 0 1 :=
      nhdsGT_basis 0 |>.mem_of_mem zero_lt_one
    exact (hsmall.mono fun delta hdelta => by
      calc
        (alpha : EReal) = ((1 * alpha : Real) : EReal) := by norm_num
        _ = ((1 * alpha : Real) : EReal) + 0 := (add_zero _).symm
        _ ≤ ((1 * alpha : Real) : EReal) +
            brrsAssouadWeightedEntropy E delta 1 :=
              add_le_add_right
                (brrsAssouadWeightedEntropy_nonneg_of_nonempty hE hdelta.1 hdelta.2 1) _
        _ ≤ brrsSectionTwoFiniteScaleEnvelope E alpha delta := by
              simpa [brrsSectionTwoFiniteScaleEnvelope] using
                (le_iSup (fun eta : BRRSParameter =>
                  ((eta.1 * alpha : Real) : EReal) +
                    brrsAssouadWeightedEntropy E delta eta.1)
                  ⟨1, by norm_num⟩)).frequently

/-- The elementary one-dimensional grid gives a uniform finite bound for the
weighted entropy occurring in the Section 2 envelope once the source scale is
below `1 / 4`.  This is the finiteness input needed before selecting an
approximate maximizer in (2.3). -/
theorem brrsAssouadWeightedEntropy_le_two_of_small_scale
    (E : Set Real) {delta : NNReal} (hdelta_zero : 0 < delta)
    (hdelta_quarter : delta < (1 : NNReal) / 4)
    {theta : Real} (htheta : theta ∈ Icc (0 : Real) 1) :
    brrsAssouadWeightedEntropy E delta theta ≤ (2 : EReal) := by
  have hdelta_one : delta < 1 := hdelta_quarter.trans (by norm_num)
  have hcover : ∀ d : NNReal, 0 < d → d < 1 → ∀ a : Real,
      brrsEntropyNumber (E ∩ brrsInterval a ((d : Real) ^ theta)) d ≤
        ENNReal.ofReal (4 * ((((d : Real) ^ theta) / (d : Real)) ^ (1 : Real))) := by
    intro d hd_zero hd_one a
    have hd_real_zero : 0 < (d : Real) := by exact_mod_cast hd_zero
    have hd_real_one : (d : Real) ≤ 1 := by exact_mod_cast hd_one.le
    have hd_scale : (d : Real) ≤ (d : Real) ^ theta := by
      calc
        (d : Real) = (d : Real) ^ (1 : Real) := by rw [Real.rpow_one]
        _ ≤ (d : Real) ^ theta :=
          Real.rpow_le_rpow_of_exponent_ge hd_real_zero hd_real_one htheta.2
    simpa [Real.rpow_one] using
      (brrsEntropyNumber_inter_interval_le_four_mul_ratio E hd_real_zero hd_scale)
  have hscale : brrsAssouadScaleCoveringNumber E delta theta ≤
      ENNReal.ofReal 4 * (delta : ENNReal) ^ (-((1 - theta) * (1 : Real))) :=
    brrsAssouadScaleCoveringNumber_le_of_cover (theta := theta) (gamma := (1 : Real))
      (C := 4) E htheta.1 htheta.2 (by norm_num) hcover hdelta_zero hdelta_one
  have hpower : (delta : ENNReal) ^ (-((1 - theta) * (1 : Real))) ≤
      (delta : ENNReal) ^ (-1 : Real) := by
    apply ENNReal.rpow_le_rpow_of_exponent_ge
    · exact_mod_cast hdelta_one.le
    · linarith [htheta.1]
  have hfour : (4 : ENNReal) ≤ (delta : ENNReal)⁻¹ := by
    apply ENNReal.le_inv_iff_mul_le.mpr
    have hdelta_real : (delta : Real) < 1 / 4 := by
      exact_mod_cast hdelta_quarter
    have hreal : 4 * (delta : Real) ≤ 1 := by nlinarith
    exact_mod_cast hreal
  unfold brrsAssouadWeightedEntropy
  apply entropyLogQuotient_le_of_le_inv_rpow hdelta_zero hdelta_one
  calc
    brrsAssouadScaleCoveringNumber E delta theta ≤
        ENNReal.ofReal 4 * (delta : ENNReal) ^ (-((1 - theta) * (1 : Real))) := hscale
    _ = (4 : ENNReal) * (delta : ENNReal) ^ (-((1 - theta) * (1 : Real))) := by
      norm_num
    _ ≤ (4 : ENNReal) * (delta : ENNReal) ^ (-1 : Real) :=
      by simpa [mul_comm] using mul_le_mul_left hpower (4 : ENNReal)
    _ = (4 : ENNReal) * (delta : ENNReal)⁻¹ := by
      rw [ENNReal.rpow_neg_one]
    _ ≤ (delta : ENNReal)⁻¹ * (delta : ENNReal)⁻¹ := by
      exact mul_le_mul_left hfour ((delta : ENNReal)⁻¹)
    _ = ((delta : ENNReal)⁻¹) ^ (2 : Real) := by
      rw [ENNReal.rpow_two]
      ring

/-- The literal finite-scale envelope from BRRS (2.1) is a finite real
quantity at every sufficiently small positive scale. -/
theorem brrsSectionTwoFiniteScaleEnvelope_le_of_small_scale
    (E : Set Real) (alpha : Real) {delta : NNReal} (hdelta_zero : 0 < delta)
    (hdelta_quarter : delta < (1 : NNReal) / 4) :
    brrsSectionTwoFiniteScaleEnvelope E alpha delta ≤
      ((max 0 alpha + 2 : Real) : EReal) := by
  unfold brrsSectionTwoFiniteScaleEnvelope
  apply iSup_le
  intro theta
  have hscalar : theta.1 * alpha ≤ max 0 alpha := by
    by_cases halpha : 0 ≤ alpha
    · calc
        theta.1 * alpha ≤ 1 * alpha :=
          mul_le_mul_of_nonneg_right theta.2.2 halpha
        _ = alpha := by ring
        _ ≤ max 0 alpha := le_max_right _ _
    · calc
        theta.1 * alpha ≤ 0 :=
          mul_nonpos_of_nonneg_of_nonpos theta.2.1 (le_of_not_ge halpha)
        _ ≤ max 0 alpha := le_max_left _ _
  calc
    ((theta.1 * alpha : Real) : EReal) +
        brrsAssouadWeightedEntropy E delta theta.1 ≤
        ((max 0 alpha : Real) : EReal) + (2 : EReal) :=
      add_le_add (by exact_mod_cast hscalar)
        (brrsAssouadWeightedEntropy_le_two_of_small_scale E hdelta_zero
          hdelta_quarter theta.2)
    _ = ((max 0 alpha + 2 : Real) : EReal) := by
      change ((max 0 alpha : Real) : EReal) + ((2 : Real) : EReal) =
        ((max 0 alpha + 2 : Real) : EReal)
      rw [← EReal.coe_add]

/-- **BRRS, Section 2 (2.3).**  At each sufficiently small source scale, the
literal finite-scale envelope has a parameter in `[0,1]` which is within any
prescribed positive `ε` of its supremum. -/
theorem exists_brrsSectionTwo_approximate_maximizer
    {E : Set Real} (hE : E.Nonempty) (alpha : Real) {epsilon : Real}
    (hepsilon : 0 < epsilon) {delta : NNReal} (hdelta_zero : 0 < delta)
    (hdelta_quarter : delta < (1 : NNReal) / 4) :
    ∃ theta ∈ Icc (0 : Real) 1,
      brrsSectionTwoFiniteScaleEnvelope E alpha delta ≤
        ((theta * alpha : Real) : EReal) +
          brrsAssouadWeightedEntropy E delta theta + (epsilon : EReal) := by
  let S : EReal := brrsSectionTwoFiniteScaleEnvelope E alpha delta
  have hS_top : S ≠ ⊤ := by
    apply ne_top_of_le_ne_top (EReal.coe_ne_top (max 0 alpha + 2 : Real))
    simpa only [S] using
      (brrsSectionTwoFiniteScaleEnvelope_le_of_small_scale E alpha hdelta_zero
        hdelta_quarter)
  have hdelta_one : delta < 1 := hdelta_quarter.trans (by norm_num)
  have hS_nonneg : (0 : EReal) ≤ S := by
    change (0 : EReal) ≤ ⨆ theta : BRRSParameter,
      ((theta.1 * alpha : Real) : EReal) + brrsAssouadWeightedEntropy E delta theta.1
    calc
      (0 : EReal) ≤ ((0 * alpha : Real) : EReal) +
          brrsAssouadWeightedEntropy E delta 0 := by
        simpa using (brrsAssouadWeightedEntropy_nonneg_of_nonempty hE hdelta_zero
          hdelta_one 0)
      _ ≤ ⨆ theta : BRRSParameter,
          ((theta.1 * alpha : Real) : EReal) +
            brrsAssouadWeightedEntropy E delta theta.1 := by
        exact le_iSup (fun theta : BRRSParameter =>
          ((theta.1 * alpha : Real) : EReal) +
            brrsAssouadWeightedEntropy E delta theta.1) ⟨0, by norm_num⟩
  have hS_bot : S ≠ ⊥ :=
    ne_of_gt (lt_of_lt_of_le (EReal.bot_lt_coe 0) hS_nonneg)
  have hbelow : ((S.toReal - epsilon : Real) : EReal) < S := by
    rw [← EReal.coe_toReal hS_top hS_bot]
    exact_mod_cast sub_lt_self S.toReal hepsilon
  change ((S.toReal - epsilon : Real) : EReal) <
    ⨆ theta : BRRSParameter,
      ((theta.1 * alpha : Real) : EReal) +
        brrsAssouadWeightedEntropy E delta theta.1 at hbelow
  obtain ⟨theta, htheta⟩ := lt_iSup_iff.mp hbelow
  refine ⟨theta.1, theta.2, ?_⟩
  have hsub : S - (epsilon : EReal) <
      ((theta.1 * alpha : Real) : EReal) + brrsAssouadWeightedEntropy E delta theta.1 := by
    simpa only [EReal.coe_sub, EReal.coe_toReal hS_top hS_bot] using htheta
  have hlt : S < ((theta.1 * alpha : Real) : EReal) +
      brrsAssouadWeightedEntropy E delta theta.1 + (epsilon : EReal) :=
    (EReal.sub_lt_iff (Or.inl (EReal.coe_ne_bot epsilon))
      (Or.inl (EReal.coe_ne_top epsilon))).mp hsub
  simpa only [S] using hlt.le

/-- **BRRS, Section 2 (2.3) along the limsup sequence.**  The sequence
preceding (2.3) can be shifted to a tail of small scales and equipped with
literal `ε`-maximizing parameters.  The shift does not change either of the
two source limits. -/
theorem exists_strictAnti_brrsSectionTwo_limsup_sequence_with_approximate_maximizers
    {E : Set Real} (hE : E.Nonempty) (alpha : Real) {epsilon : Real}
    (hepsilon : 0 < epsilon) :
    ∃ delta : Nat → NNReal, ∃ theta : Nat → Real,
      StrictAnti delta ∧ (∀ n, 0 < delta n) ∧ (∀ n, delta n < (1 : NNReal) / 4) ∧
      Tendsto delta atTop (𝓝 (0 : NNReal)) ∧
      Tendsto (fun n => brrsSectionTwoFiniteScaleEnvelope E alpha (delta n)) atTop
        (𝓝 (Filter.limsup (brrsSectionTwoFiniteScaleEnvelope E alpha)
          (𝓝[>] (0 : NNReal)))) ∧
      (∀ n, theta n ∈ Icc (0 : Real) 1 ∧
        brrsSectionTwoFiniteScaleEnvelope E alpha (delta n) ≤
          ((theta n * alpha : Real) : EReal) +
            brrsAssouadWeightedEntropy E (delta n) (theta n) + (epsilon : EReal)) := by
  obtain ⟨delta, hdelta_strict, hdelta_pos, hdelta_tendsto, hvalue_tendsto⟩ :=
    exists_strictAnti_brrsSectionTwo_limsup_sequence E alpha
  have hsmall_eventually : ∀ᶠ n : Nat in atTop, delta n < (1 : NNReal) / 4 := by
    have hsmall_neighborhood : Iio ((1 : NNReal) / 4) ∈ 𝓝 (0 : NNReal) :=
      Iio_mem_nhds (by norm_num)
    exact hdelta_tendsto.eventually hsmall_neighborhood
  obtain ⟨N, hN⟩ := eventually_atTop.1 hsmall_eventually
  let delta' : Nat → NNReal := fun n => delta (n + N)
  have hdelta'_strict : StrictAnti delta' := by
    intro m n hmn
    exact hdelta_strict (Nat.add_lt_add_right hmn N)
  have hdelta'_pos : ∀ n, 0 < delta' n := by
    intro n
    exact hdelta_pos (n + N)
  have hdelta'_small : ∀ n, delta' n < (1 : NNReal) / 4 := by
    intro n
    exact hN (n + N) (by omega)
  have hdelta'_tendsto : Tendsto delta' atTop (𝓝 (0 : NNReal)) := by
    simpa only [delta'] using
      (Filter.tendsto_add_atTop_iff_nat N).mpr hdelta_tendsto
  have hvalue'_tendsto :
      Tendsto (fun n => brrsSectionTwoFiniteScaleEnvelope E alpha (delta' n)) atTop
        (𝓝 (Filter.limsup (brrsSectionTwoFiniteScaleEnvelope E alpha)
          (𝓝[>] (0 : NNReal)))) := by
    simpa only [delta'] using
      (Filter.tendsto_add_atTop_iff_nat N).mpr hvalue_tendsto
  have hchoose : ∀ n : Nat, ∃ theta ∈ Icc (0 : Real) 1,
      brrsSectionTwoFiniteScaleEnvelope E alpha (delta' n) ≤
        ((theta * alpha : Real) : EReal) +
          brrsAssouadWeightedEntropy E (delta' n) theta + (epsilon : EReal) := by
    intro n
    exact exists_brrsSectionTwo_approximate_maximizer hE alpha hepsilon
      (hdelta'_pos n) (hdelta'_small n)
  choose theta htheta_range htheta_bound using hchoose
  exact ⟨delta', theta, hdelta'_strict, hdelta'_pos, hdelta'_small,
    hdelta'_tendsto, hvalue'_tendsto, fun n => ⟨htheta_range n, htheta_bound n⟩⟩

/-- **BRRS, Section 2 compactness extraction.**  Passing to a subsequence of
the parameters selected in (2.3) gives a limiting parameter in the literal
compact interval.  All scale, envelope-limit, and `ε`-maximizer assertions
are retained after reindexing, exactly as required for the next comparison
step in the proof of (2.1). -/
theorem exists_strictAnti_brrsSectionTwo_limsup_sequence_with_convergent_approximate_maximizers
    {E : Set Real} (hE : E.Nonempty) (alpha : Real) {epsilon : Real}
    (hepsilon : 0 < epsilon) :
    ∃ delta : Nat → NNReal, ∃ theta : Nat → Real, ∃ thetaStar : Real,
      StrictAnti delta ∧ (∀ n, 0 < delta n) ∧ (∀ n, delta n < (1 : NNReal) / 4) ∧
      Tendsto delta atTop (𝓝 (0 : NNReal)) ∧
      Tendsto (fun n => brrsSectionTwoFiniteScaleEnvelope E alpha (delta n)) atTop
        (𝓝 (Filter.limsup (brrsSectionTwoFiniteScaleEnvelope E alpha)
          (𝓝[>] (0 : NNReal)))) ∧
      thetaStar ∈ Icc (0 : Real) 1 ∧ Tendsto theta atTop (𝓝 thetaStar) ∧
      (∀ n, theta n ∈ Icc (0 : Real) 1 ∧
        brrsSectionTwoFiniteScaleEnvelope E alpha (delta n) ≤
          ((theta n * alpha : Real) : EReal) +
            brrsAssouadWeightedEntropy E (delta n) (theta n) + (epsilon : EReal)) := by
  obtain ⟨delta, theta, hdelta_strict, hdelta_pos, hdelta_small, hdelta_tendsto,
    hvalue_tendsto, htheta⟩ :=
    exists_strictAnti_brrsSectionTwo_limsup_sequence_with_approximate_maximizers
      hE alpha hepsilon
  obtain ⟨thetaStar, hthetaStar, phi, hphi_strict, hphi_tendsto⟩ :=
    isCompact_Icc.tendsto_subseq fun n => (htheta n).1
  let delta' : Nat → NNReal := delta ∘ phi
  let theta' : Nat → Real := theta ∘ phi
  refine ⟨delta', theta', thetaStar, ?_, ?_, ?_, ?_, ?_, hthetaStar, ?_, ?_⟩
  · intro m n hmn
    change delta (phi n) < delta (phi m)
    exact hdelta_strict (hphi_strict hmn)
  · intro n
    exact hdelta_pos (phi n)
  · intro n
    exact hdelta_small (phi n)
  · simpa only [delta', Function.comp_apply] using
      hdelta_tendsto.comp hphi_strict.tendsto_atTop
  · change Tendsto
      ((fun n => brrsSectionTwoFiniteScaleEnvelope E alpha (delta n)) ∘ phi) atTop
        (𝓝 (Filter.limsup (brrsSectionTwoFiniteScaleEnvelope E alpha)
          (𝓝[>] (0 : NNReal))))
    exact hvalue_tendsto.comp hphi_strict.tendsto_atTop
  · simpa only [theta', Function.comp_apply] using hphi_tendsto
  · intro n
    simpa only [delta', theta', Function.comp_apply] using htheta (phi n)

/-- **BRRS, Section 2 (2.4).**  Once the compactness extraction in (2.3)
has produced `θ_*`, the weighted spectrum can be approximated from strictly
smaller parameters.  The printed assertion `θ_*^- ∈ [0, θ_*)` is meaningful
only when `θ_* > 0`; at the genuine boundary `θ_* = 0` the faithful
replacement is the endpoint choice `θ_*^- = θ_*`. -/
theorem exists_brrsSectionTwo_left_weighted_approximation
    (E : Set Real) {thetaStar epsilon : Real}
    (hthetaStar : thetaStar ∈ Icc (0 : Real) 1) (hepsilon : 0 < epsilon) :
    ∃ thetaStarMinus ∈ Icc (0 : Real) thetaStar,
      (thetaStarMinus < thetaStar ∨
        (thetaStar = 0 ∧ thetaStarMinus = thetaStar)) ∧
      (1 - thetaStarMinus) * brrsAssouadSpectrum E thetaStarMinus ≤
        (1 - thetaStar) * brrsAssouadSpectrum E thetaStar + epsilon := by
  by_cases htheta_zero : thetaStar = 0
  · subst thetaStar
    refine ⟨0, by norm_num, Or.inr ⟨rfl, rfl⟩, ?_⟩
    nlinarith [hepsilon.le]
  · have htheta_pos : 0 < thetaStar :=
      lt_of_le_of_ne hthetaStar.1 (Ne.symm htheta_zero)
    let r : Real := min (thetaStar / 2) (epsilon / 2)
    let thetaStarMinus : Real := thetaStar - r
    have hr_pos : 0 < r := by
      dsimp only [r]
      exact lt_min (by linarith) (by linarith)
    have hr_le_half : r ≤ thetaStar / 2 := by
      dsimp only [r]
      exact min_le_left _ _
    have hr_lt_epsilon : r < epsilon := by
      calc
        r ≤ epsilon / 2 := by
          dsimp only [r]
          exact min_le_right _ _
        _ < epsilon := by linarith
    have hminus_nonneg : 0 ≤ thetaStarMinus := by
      dsimp only [thetaStarMinus]
      linarith
    have hminus_lt : thetaStarMinus < thetaStar := by
      dsimp only [thetaStarMinus]
      linarith
    have hminus_mem : thetaStarMinus ∈ Iic (1 : Real) :=
      hminus_lt.le.trans hthetaStar.2
    have hstar_mem : thetaStar ∈ Iic (1 : Real) := hthetaStar.2
    let w : Real → Real := fun theta =>
      (1 - theta) * brrsAssouadSpectrum E theta
    have hdist := (brrsWeightedAssouadSpectrum_lipschitzOn_Iic E).dist_le_mul
      thetaStarMinus hminus_mem thetaStar hstar_mem
    change dist (w thetaStarMinus) (w thetaStar) ≤
      1 * dist thetaStarMinus thetaStar at hdist
    have hdist_parameter : dist thetaStarMinus thetaStar = r := by
      rw [Real.dist_eq]
      dsimp only [thetaStarMinus]
      rw [show thetaStar - r - thetaStar = -r by ring,
        abs_neg, abs_of_nonneg hr_pos.le]
    have hdist_value : dist (w thetaStarMinus) (w thetaStar) ≤ r := by
      calc
        dist (w thetaStarMinus) (w thetaStar) ≤
            1 * dist thetaStarMinus thetaStar := hdist
        _ = r := by rw [hdist_parameter]; norm_num
    have hvalue : w thetaStarMinus ≤ w thetaStar + epsilon := by
      calc
        w thetaStarMinus = w thetaStar + (w thetaStarMinus - w thetaStar) := by
          ring
        _ ≤ w thetaStar + |w thetaStarMinus - w thetaStar| := by
          gcongr
          exact le_abs_self _
        _ = w thetaStar + dist (w thetaStarMinus) (w thetaStar) := by
          rw [Real.dist_eq]
        _ ≤ w thetaStar + r := by
          simpa [add_comm] using add_le_add_left hdist_value (w thetaStar)
        _ ≤ w thetaStar + epsilon := by linarith
    refine ⟨thetaStarMinus, ⟨hminus_nonneg, hminus_lt.le⟩,
      Or.inl hminus_lt, ?_⟩
    simpa only [w] using hvalue

/-- **BRRS, Section 2 (2.5), parameter tail.**  A convergent sequence of
parameters eventually lies above the left comparison parameter from (2.4),
and its nonnegative-`α` contribution is within `ε` of the limiting one.
The second branch of the comparison certificate is precisely the genuine
boundary case `θ_* = θ_*^- = 0`; there the lower inequality instead follows
from the interval membership of every selected parameter. -/
theorem eventually_brrsSectionTwo_parameter_tail_estimates
    {theta : Nat → Real} {thetaStar thetaStarMinus alpha epsilon : Real}
    (htheta_range : ∀ n, theta n ∈ Icc (0 : Real) 1)
    (htheta_tendsto : Tendsto theta atTop (𝓝 thetaStar))
    (hminus_certificate : thetaStarMinus < thetaStar ∨
      (thetaStar = 0 ∧ thetaStarMinus = thetaStar))
    (halpha : 0 ≤ alpha) (hepsilon : 0 < epsilon) :
    ∀ᶠ n : Nat in atTop,
      thetaStarMinus ≤ theta n ∧ theta n * alpha ≤ thetaStar * alpha + epsilon := by
  have hlower : ∀ᶠ n : Nat in atTop, thetaStarMinus ≤ theta n := by
    rcases hminus_certificate with hminus_lt | hminus_zero
    · filter_upwards [htheta_tendsto.eventually (eventually_gt_nhds hminus_lt)]
        with n hn
      exact hn.le
    · rcases hminus_zero with ⟨hthetaStar_zero, hminus_eq⟩
      have hminus_zero : thetaStarMinus = 0 := hminus_eq.trans hthetaStar_zero
      filter_upwards with n
      simpa only [hminus_zero] using (htheta_range n).1
  have halpha_one_pos : 0 < alpha + 1 := by linarith
  let eta : Real := epsilon / (alpha + 1)
  have heta_pos : 0 < eta := by
    dsimp only [eta]
    exact div_pos hepsilon halpha_one_pos
  have hupper : ∀ᶠ n : Nat in atTop, theta n < thetaStar + eta := by
    exact htheta_tendsto.eventually
      (eventually_lt_nhds (show thetaStar < thetaStar + eta by linarith))
  filter_upwards [hlower, hupper] with n hn_lower hn_upper
  refine ⟨hn_lower, ?_⟩
  have hmul : theta n * alpha ≤ (thetaStar + eta) * alpha :=
    mul_le_mul_of_nonneg_right hn_upper.le halpha
  have heta_alpha : eta * alpha ≤ epsilon := by
    calc
      eta * alpha ≤ eta * (alpha + 1) :=
        mul_le_mul_of_nonneg_left (by linarith) heta_pos.le
      _ = epsilon := by
        dsimp only [eta]
        field_simp [ne_of_gt halpha_one_pos]
  calc
    theta n * alpha ≤ (thetaStar + eta) * alpha := hmul
    _ = thetaStar * alpha + eta * alpha := by ring
    _ ≤ thetaStar * alpha + epsilon := by gcongr

/-- **BRRS, Section 2 (2.5).**  Starting with the convergent subsequence of
the literal (2.3) maximizers and the left approximation (2.4), one obtains a
single eventual tail on which both estimates printed in (2.5) hold.  The
full scale and maximizer data are retained for the following covering step. -/
theorem exists_brrsSectionTwo_convergent_approximate_maximizers_with_tail_estimates
    {E : Set Real} (hE : E.Nonempty) (alpha : Real) (halpha : 0 ≤ alpha)
    {epsilon : Real} (hepsilon : 0 < epsilon) :
    ∃ delta : Nat → NNReal, ∃ theta : Nat → Real, ∃ thetaStar thetaStarMinus : Real,
      StrictAnti delta ∧ (∀ n, 0 < delta n) ∧
      (∀ n, delta n < (1 : NNReal) / 4) ∧
      Tendsto delta atTop (𝓝 (0 : NNReal)) ∧
      Tendsto (fun n => brrsSectionTwoFiniteScaleEnvelope E alpha (delta n)) atTop
        (𝓝 (Filter.limsup (brrsSectionTwoFiniteScaleEnvelope E alpha)
          (𝓝[>] (0 : NNReal)))) ∧
      thetaStar ∈ Icc (0 : Real) 1 ∧ Tendsto theta atTop (𝓝 thetaStar) ∧
      (∀ n, theta n ∈ Icc (0 : Real) 1 ∧
        brrsSectionTwoFiniteScaleEnvelope E alpha (delta n) ≤
          ((theta n * alpha : Real) : EReal) +
            brrsAssouadWeightedEntropy E (delta n) (theta n) + (epsilon : EReal)) ∧
      thetaStarMinus ∈ Icc (0 : Real) thetaStar ∧
      (thetaStarMinus < thetaStar ∨
        (thetaStar = 0 ∧ thetaStarMinus = thetaStar)) ∧
      (1 - thetaStarMinus) * brrsAssouadSpectrum E thetaStarMinus ≤
        (1 - thetaStar) * brrsAssouadSpectrum E thetaStar + epsilon ∧
      (∀ᶠ n : Nat in atTop,
        thetaStarMinus ≤ theta n ∧ theta n * alpha ≤ thetaStar * alpha + epsilon) := by
  obtain ⟨delta, theta, thetaStar, hdelta_strict, hdelta_pos, hdelta_small,
    hdelta_tendsto, henvelope_tendsto, hthetaStar, htheta_tendsto, hmaximizer⟩ :=
    exists_strictAnti_brrsSectionTwo_limsup_sequence_with_convergent_approximate_maximizers
      hE alpha hepsilon
  obtain ⟨thetaStarMinus, hthetaStarMinus, hminus_certificate, hweighted⟩ :=
    exists_brrsSectionTwo_left_weighted_approximation E hthetaStar hepsilon
  have htail : ∀ᶠ n : Nat in atTop,
      thetaStarMinus ≤ theta n ∧ theta n * alpha ≤ thetaStar * alpha + epsilon :=
    eventually_brrsSectionTwo_parameter_tail_estimates
      (fun n => (hmaximizer n).1) htheta_tendsto hminus_certificate halpha hepsilon
  exact ⟨delta, theta, thetaStar, thetaStarMinus, hdelta_strict, hdelta_pos,
    hdelta_small, hdelta_tendsto, henvelope_tendsto, hthetaStar, htheta_tendsto,
    hmaximizer, hthetaStarMinus, hminus_certificate, hweighted, htail⟩

/-- For a covering scale below one, enlarging the power parameter shortens
the literal BRRS testing interval.  Thus the exact-scale covering supremum
is antitone in that parameter.  This is the first inequality in BRRS (2.6),
with the paper's closed intervals and closed-ball covering convention. -/
theorem brrsAssouadScaleCoveringNumber_antitone_parameter
    (E : Set Real) {delta : NNReal} (hdelta_zero : 0 < delta)
    (hdelta_one : delta < 1) {theta eta : Real} (heta_theta : eta ≤ theta) :
    brrsAssouadScaleCoveringNumber E delta theta ≤
      brrsAssouadScaleCoveringNumber E delta eta := by
  have hdelta_real_zero : 0 < (delta : Real) := by
    exact_mod_cast hdelta_zero
  have hdelta_real_one : (delta : Real) ≤ 1 := by
    exact_mod_cast hdelta_one.le
  have hlength : (delta : Real) ^ theta ≤ (delta : Real) ^ eta :=
    Real.rpow_le_rpow_of_exponent_ge hdelta_real_zero hdelta_real_one heta_theta
  unfold brrsAssouadScaleCoveringNumber
  apply iSup_mono
  intro a
  apply brrsEntropyNumber_mono
  intro x hx
  exact ⟨hx.1, brrsInterval_mono hlength hx.2⟩

/-- **BRRS, Section 2 (2.6), covering step.**  A parameter tail lying above
`thetaStarMinus` is controlled by one equality-scale Assouad-spectrum cover
at `thetaStarMinus`.  The exponent is the literal source exponent
`(1 - thetaStarMinus) * gamma_E(thetaStarMinus) + epsilon`; the strictly
subendpoint hypothesis is exactly what permits the spectrum approximation.
-/
theorem exists_brrsSectionTwo_covering_tail_of_parameter_tail
    {E : Set Real} {delta : Nat → NNReal} {theta : Nat → Real}
    {thetaStarMinus epsilon : Real}
    (hdelta_zero : ∀ n, 0 < delta n) (hdelta_one : ∀ n, delta n < 1)
    (hthetaStarMinus_nonneg : 0 ≤ thetaStarMinus)
    (hthetaStarMinus_lt_one : thetaStarMinus < 1) (hepsilon : 0 < epsilon)
    (htail : ∀ᶠ n : Nat in atTop, thetaStarMinus ≤ theta n) :
    ∃ C : Real, 0 < C ∧ ∀ᶠ n : Nat in atTop,
      brrsAssouadScaleCoveringNumber E (delta n) (theta n) ≤
        brrsAssouadScaleCoveringNumber E (delta n) thetaStarMinus ∧
      brrsAssouadScaleCoveringNumber E (delta n) thetaStarMinus ≤
        ENNReal.ofReal C * (delta n : ENNReal) ^
          (-((1 - thetaStarMinus) *
            brrsAssouadSpectrum E thetaStarMinus + epsilon)) := by
  have hden : 0 < 1 - thetaStarMinus := sub_pos.mpr hthetaStarMinus_lt_one
  let gamma : Real := brrsAssouadSpectrum E thetaStarMinus +
    epsilon / (1 - thetaStarMinus)
  have hgamma_lt : brrsAssouadSpectrum E thetaStarMinus < gamma := by
    dsimp only [gamma]
    exact lt_add_of_pos_right _ (div_pos hepsilon hden)
  obtain ⟨C, hC, hcover⟩ :=
    hasBRRSAssouadSpectrumExponent_of_brrsAssouadSpectrum_lt E
      hthetaStarMinus_lt_one.le hgamma_lt
  have hgamma_weighted : (1 - thetaStarMinus) * gamma =
      (1 - thetaStarMinus) * brrsAssouadSpectrum E thetaStarMinus + epsilon := by
    dsimp only [gamma]
    calc
      (1 - thetaStarMinus) *
          (brrsAssouadSpectrum E thetaStarMinus +
            epsilon / (1 - thetaStarMinus)) =
          (1 - thetaStarMinus) * brrsAssouadSpectrum E thetaStarMinus +
            (epsilon / (1 - thetaStarMinus)) * (1 - thetaStarMinus) := by ring
      _ = (1 - thetaStarMinus) * brrsAssouadSpectrum E thetaStarMinus + epsilon := by
        rw [div_mul_cancel₀ epsilon (ne_of_gt hden)]
  refine ⟨C, hC, ?_⟩
  filter_upwards [htail] with n hn
  refine ⟨brrsAssouadScaleCoveringNumber_antitone_parameter E
      (hdelta_zero n) (hdelta_one n) hn, ?_⟩
  calc
    brrsAssouadScaleCoveringNumber E (delta n) thetaStarMinus ≤
        ENNReal.ofReal C * (delta n : ENNReal) ^
          (-((1 - thetaStarMinus) * gamma)) :=
      brrsAssouadScaleCoveringNumber_le_of_cover E hthetaStarMinus_nonneg
        hthetaStarMinus_lt_one.le hC.le hcover (hdelta_zero n) (hdelta_one n)
    _ = ENNReal.ofReal C * (delta n : ENNReal) ^
          (-((1 - thetaStarMinus) *
            brrsAssouadSpectrum E thetaStarMinus + epsilon)) := by
      rw [hgamma_weighted]

/-- **BRRS, Section 2 (2.6).**  The compactly selected (2.3) maximizers,
the left comparison (2.4), and the eventual parameter estimates (2.5) yield
one positive constant and the two literal equality-scale covering bounds
used in the next logarithmic estimate.  At the genuine `thetaStar = 0`
boundary, the retained endpoint branch still gives
`thetaStarMinus = 0 < 1`, so no invalid strict-left assertion is used. -/
theorem exists_brrsSectionTwo_convergent_approximate_maximizers_with_covering_tail_estimates
    {E : Set Real} (hE : E.Nonempty) (alpha : Real) (halpha : 0 ≤ alpha)
    {epsilon : Real} (hepsilon : 0 < epsilon) :
    ∃ delta : Nat → NNReal, ∃ theta : Nat → Real,
      ∃ thetaStar thetaStarMinus C : Real,
      StrictAnti delta ∧ (∀ n, 0 < delta n) ∧
      (∀ n, delta n < (1 : NNReal) / 4) ∧
      Tendsto delta atTop (𝓝 (0 : NNReal)) ∧
      Tendsto (fun n => brrsSectionTwoFiniteScaleEnvelope E alpha (delta n)) atTop
        (𝓝 (Filter.limsup (brrsSectionTwoFiniteScaleEnvelope E alpha)
          (𝓝[>] (0 : NNReal)))) ∧
      thetaStar ∈ Icc (0 : Real) 1 ∧ Tendsto theta atTop (𝓝 thetaStar) ∧
      (∀ n, theta n ∈ Icc (0 : Real) 1 ∧
        brrsSectionTwoFiniteScaleEnvelope E alpha (delta n) ≤
          ((theta n * alpha : Real) : EReal) +
            brrsAssouadWeightedEntropy E (delta n) (theta n) + (epsilon : EReal)) ∧
      thetaStarMinus ∈ Icc (0 : Real) thetaStar ∧
      (thetaStarMinus < thetaStar ∨
        (thetaStar = 0 ∧ thetaStarMinus = thetaStar)) ∧
      (1 - thetaStarMinus) * brrsAssouadSpectrum E thetaStarMinus ≤
        (1 - thetaStar) * brrsAssouadSpectrum E thetaStar + epsilon ∧
      (∀ᶠ n : Nat in atTop,
        thetaStarMinus ≤ theta n ∧ theta n * alpha ≤ thetaStar * alpha + epsilon) ∧
      0 < C ∧ ∀ᶠ n : Nat in atTop,
        brrsAssouadScaleCoveringNumber E (delta n) (theta n) ≤
          brrsAssouadScaleCoveringNumber E (delta n) thetaStarMinus ∧
        brrsAssouadScaleCoveringNumber E (delta n) thetaStarMinus ≤
          ENNReal.ofReal C * (delta n : ENNReal) ^
            (-((1 - thetaStarMinus) *
              brrsAssouadSpectrum E thetaStarMinus + epsilon)) := by
  obtain ⟨delta, theta, thetaStar, thetaStarMinus, hdelta_strict, hdelta_pos,
    hdelta_small, hdelta_tendsto, henvelope_tendsto, hthetaStar, htheta_tendsto,
    hmaximizer, hthetaStarMinus, hminus_certificate, hweighted, htail⟩ :=
    exists_brrsSectionTwo_convergent_approximate_maximizers_with_tail_estimates
      hE alpha halpha hepsilon
  have hdelta_one : ∀ n, delta n < 1 := fun n =>
    (hdelta_small n).trans (by norm_num)
  have hthetaStarMinus_lt_one : thetaStarMinus < 1 := by
    rcases hminus_certificate with hminus_lt | hboundary
    · exact hminus_lt.trans_le hthetaStar.2
    · rcases hboundary with ⟨hthetaStar_zero, hminus_eq⟩
      rw [hminus_eq, hthetaStar_zero]
      norm_num
  obtain ⟨C, hC, hcover_tail⟩ :=
    exists_brrsSectionTwo_covering_tail_of_parameter_tail hdelta_pos hdelta_one
      hthetaStarMinus.1 hthetaStarMinus_lt_one hepsilon
      (htail.mono fun _ hn => hn.1)
  exact ⟨delta, theta, thetaStar, thetaStarMinus, C, hdelta_strict, hdelta_pos,
    hdelta_small, hdelta_tendsto, henvelope_tendsto, hthetaStar, htheta_tendsto,
    hmaximizer, hthetaStarMinus, hminus_certificate, hweighted, htail, hC,
    hcover_tail⟩

/-- The weighted exact-scale spectrum has the prescribed endpoint limit.
This is the continuity input at `theta = 1` used by the BRRS compactness
argument. -/
theorem tendsto_brrsWeightedAssouadSpectrum_at_one
    (E : Set Real) :
    Filter.Tendsto (fun theta : Real => (1 - theta) * brrsAssouadSpectrum E theta)
      (nhdsWithin 1 (Iio 1)) (𝓝 0) := by
  apply squeeze_zero'
  · filter_upwards [self_mem_nhdsWithin] with theta htheta
    exact mul_nonneg (sub_nonneg.mpr htheta.le)
      (brrsAssouadSpectrum_nonneg E htheta.le)
  · filter_upwards [self_mem_nhdsWithin] with theta htheta
    have hfac : 0 ≤ 1 - theta := sub_nonneg.mpr htheta.le
    calc
      (1 - theta) * brrsAssouadSpectrum E theta ≤ (1 - theta) * 1 :=
        mul_le_mul_of_nonneg_left (brrsAssouadSpectrum_le_one E htheta.le) hfac
      _ = 1 - theta := by ring
  · have hcont : Continuous (fun theta : Real => 1 - theta) :=
      continuous_const.sub continuous_id
    change Filter.Tendsto ((1 : Real) - ·) (nhdsWithin 1 (Iio 1)) (𝓝 0)
    have hfilter : nhdsWithin (1 : Real) (Iio 1) ≤ nhds 1 := inf_le_left
    simpa using (hcont.tendsto 1).mono_left hfilter

/-- At the equality-scale endpoint `θ = 1`, every positive exponent is
admissible: the test interval itself has BRRS length `δ`. -/
theorem hasBRRSAssouadSpectrumExponent_one (E : Set Real) {gamma : Real}
    (_hgamma : 0 < gamma) : HasBRRSAssouadSpectrumExponent E 1 gamma := by
  refine ⟨1, zero_lt_one, ?_⟩
  intro delta hdelta hdelta_one a
  have hcover := brrsEntropyNumber_inter_interval_self_le_one E a delta
  have hdelta_ne : (delta : Real) ≠ 0 := ne_of_gt (by exact_mod_cast hdelta)
  simpa [Real.rpow_one, div_self hdelta_ne] using hcover

/-- The equality-scale Assouad spectrum has its natural endpoint value zero.
The potential consequently agrees with its continuous-extension convention at
`θ = 1`. -/
theorem brrsAssouadSpectrum_one (E : Set Real) : brrsAssouadSpectrum E 1 = 0 := by
  let S : Set Real := {gamma : Real | 0 < gamma ∧
    HasBRRSAssouadSpectrumExponent E 1 gamma}
  have hbelow : BddBelow S := by
    refine ⟨0, ?_⟩
    intro gamma hgamma
    exact hgamma.1.le
  change sInf S = 0
  apply le_antisymm
  · refine le_of_forall_pos_le_add fun epsilon hepsilon => ?_
    calc
      sInf S ≤ epsilon := csInf_le hbelow
        ⟨hepsilon, hasBRRSAssouadSpectrumExponent_one E hepsilon⟩
      _ = 0 + epsilon := by ring
  · apply le_csInf
    · exact ⟨1, ⟨zero_lt_one, hasBRRSAssouadSpectrumExponent_one E zero_lt_one⟩⟩
    · intro gamma hgamma
      exact hgamma.1.le

/-- A singleton has one BRRS entropy cell at every positive covering scale. -/
@[simp]
theorem brrsEntropyNumber_singleton (x : Real) (delta : NNReal) :
    brrsEntropyNumber ({x} : Set Real) delta = 1 := by
  simp [brrsEntropyNumber]

/-- Every positive exponent is an equality-scale BRRS spectrum exponent for
a singleton.  This is the degenerate branch of the Rutar realization
construction, and is kept separate from the variable-ratio Moran branch. -/
theorem hasBRRSAssouadSpectrumExponent_singleton (x : Real)
    {theta gamma : Real} (htheta : theta ≤ 1) (hgamma : 0 < gamma) :
    HasBRRSAssouadSpectrumExponent ({x} : Set Real) theta gamma := by
  refine ⟨1, zero_lt_one, ?_⟩
  intro delta hdelta hdelta_one a
  have hdelta_real : 0 < (delta : Real) := by
    exact_mod_cast hdelta
  have hdelta_one_real : (delta : Real) ≤ 1 := by
    exact_mod_cast hdelta_one.le
  have hscale : (delta : Real) ≤ (delta : Real) ^ theta := by
    calc
      (delta : Real) = (delta : Real) ^ (1 : Real) := by rw [Real.rpow_one]
      _ ≤ (delta : Real) ^ theta :=
        Real.rpow_le_rpow_of_exponent_ge hdelta_real hdelta_one_real htheta
  have hratio : 1 ≤ ((delta : Real) ^ theta) / (delta : Real) := by
    rw [le_div_iff₀ hdelta_real]
    simpa only [one_mul] using hscale
  have hpower : 1 ≤ (((delta : Real) ^ theta) / (delta : Real)) ^ gamma :=
    Real.one_le_rpow hratio hgamma.le
  calc
    brrsEntropyNumber
        (({x} : Set Real) ∩ brrsInterval a ((delta : Real) ^ theta)) delta ≤
        brrsEntropyNumber ({x} : Set Real) delta :=
      brrsEntropyNumber_mono inter_subset_left delta
    _ = 1 := brrsEntropyNumber_singleton x delta
    _ ≤ ENNReal.ofReal
        (1 * ((((delta : Real) ^ theta) / (delta : Real)) ^ gamma)) := by
      simpa only [ENNReal.ofReal_one, one_mul] using
        ENNReal.ofReal_le_ofReal hpower

/-- The exact-scale BRRS spectrum of a singleton vanishes on the full
parameter range used in the theorem. -/
theorem brrsAssouadSpectrum_singleton (x : Real) {theta : Real}
    (htheta : theta ≤ 1) :
    brrsAssouadSpectrum ({x} : Set Real) theta = 0 := by
  let S : Set Real := {gamma : Real | 0 < gamma ∧
    HasBRRSAssouadSpectrumExponent ({x} : Set Real) theta gamma}
  have hbelow : BddBelow S := by
    refine ⟨0, ?_⟩
    intro gamma hgamma
    exact hgamma.1.le
  change sInf S = 0
  apply le_antisymm
  · refine le_of_forall_pos_le_add fun epsilon hepsilon => ?_
    calc
      sInf S ≤ epsilon := csInf_le hbelow
        ⟨hepsilon,
          hasBRRSAssouadSpectrumExponent_singleton x htheta hepsilon⟩
      _ = 0 + epsilon := by ring
  · apply le_csInf
    · exact ⟨1, ⟨zero_lt_one,
        hasBRRSAssouadSpectrumExponent_singleton x htheta zero_lt_one⟩⟩
    · intro gamma hgamma
      exact hgamma.1.le

/-- The zero spectrum is realized by a singleton, the zero branch in
Rutar's Corollary B. -/
theorem hasBRRSSpectrumRealization_zero :
    HasBRRSSpectrumRealization (fun _ : Real => 0) := by
  refine ⟨({0} : Set Real), ?_, Bornology.isBounded_singleton, ?_⟩
  · simp
  · intro theta _ htheta_one
    simpa using brrsAssouadSpectrum_singleton 0 htheta_one.le

@[simp]
theorem brrsAssouadPotential_one (E : Set Real) : brrsAssouadPotential E 1 = 0 := by
  simp [brrsAssouadPotential]

/-- The BRRS Assouad potential is nonpositive on its spectrum interval. -/
theorem brrsAssouadPotential_nonpos (E : Set Real) {theta : Real}
    (htheta : theta ≤ 1) : brrsAssouadPotential E theta ≤ 0 := by
  by_cases htheta_one : theta = 1
  · subst theta
    simp
  rw [brrsAssouadPotential, if_neg htheta_one]
  rw [neg_mul]
  apply neg_nonpos.mpr
  exact mul_nonneg (sub_nonneg.mpr htheta)
    (brrsAssouadSpectrum_nonneg E htheta)

/-- The one-dimensional spectrum bound gives a lower affine barrier for the
BRRS Assouad potential. -/
theorem brrsAssouadPotential_lower (E : Set Real) {theta : Real}
    (htheta_zero : 0 ≤ theta) (htheta_one : theta ≤ 1) :
    -(1 - theta) ≤ brrsAssouadPotential E theta := by
  by_cases htheta_eq : theta = 1
  · subst theta
    simp
  rw [brrsAssouadPotential, if_neg htheta_eq]
  have hfactor : 0 ≤ 1 - theta := sub_nonneg.mpr htheta_one
  have hspectrum : brrsAssouadSpectrum E theta ≤ 1 :=
    brrsAssouadSpectrum_le_one E htheta_one
  have hmul : (1 - theta) * brrsAssouadSpectrum E theta ≤ (1 - theta) * 1 :=
    mul_le_mul_of_nonneg_left hspectrum hfactor
  calc
    -(1 - theta) = -((1 - theta) * 1) := by ring
    _ ≤ -((1 - theta) * brrsAssouadSpectrum E theta) := neg_le_neg hmul
    _ = -(1 - theta) * brrsAssouadSpectrum E theta := by ring

end BRRSAdditiveEntropy

/-! ### Restricted real Legendre transforms -/

section BRRSConvexDuality

open Filter Set
open scoped Topology
open Auto.ConvexDuality

noncomputable section

/-- BRRS compatibility notation for the reusable restricted real conjugate. -/
abbrev brrsRestrictedLegendreTransform :=
  restrictedConjugate

/-- The BRRS transform is the restricted transform of the Assouad potential
over the compact slope interval `[0,1]`. -/
theorem brrsAssouadLegendreTransform_eq_restricted (E : Set Real) (alpha : Real) :
    brrsAssouadLegendreTransform E alpha =
      brrsRestrictedLegendreTransform (brrsAssouadPotential E) (Icc 0 1) alpha := rfl

/-- The exact-scale continuity theorem upgrades the spectral transform from
an order-theoretic supremum to a maximum on the compact slope interval. -/
theorem exists_brrsAssouadLegendreTransform_maximizer (E : Set Real)
    (alpha : Real) :
    ∃ theta ∈ Icc (0 : Real) 1,
      brrsAssouadLegendreTransform E alpha =
        theta * alpha + (1 - theta) * brrsAssouadSpectrum E theta := by
  let g : Real → Real :=
    fun theta => theta * alpha + (1 - theta) * brrsAssouadSpectrum E theta
  obtain ⟨theta, htheta, hmax⟩ :=
    exists_brrsAssouadSpectrum_affine_maximizer E alpha
  have hmax' : ∀ u ∈ Icc (0 : Real) 1, g u ≤ g theta := by
    simpa only [g] using hmax
  have hgreatest : IsGreatest (g '' Icc (0 : Real) 1) (g theta) := by
    refine ⟨⟨theta, htheta, rfl⟩, ?_⟩
    rintro _ ⟨u, hu, rfl⟩
    exact hmax' u hu
  have hpoint : ∀ theta ∈ Icc (0 : Real) 1,
      theta * alpha - brrsAssouadPotential E theta = g theta := by
    intro theta htheta
    by_cases htheta_one : theta = 1
    · subst theta
      simp [g, brrsAssouadPotential]
    · rw [brrsAssouadPotential, if_neg htheta_one]
      dsimp [g]
      ring
  have htransform : brrsAssouadLegendreTransform E alpha =
      sSup (g '' Icc (0 : Real) 1) := by
    unfold brrsAssouadLegendreTransform
    apply congrArg sSup
    ext x
    constructor
    · rintro ⟨theta, htheta, rfl⟩
      exact ⟨theta, htheta, (hpoint theta htheta).symm⟩
    · rintro ⟨theta, htheta, rfl⟩
      exact ⟨theta, htheta, hpoint theta htheta⟩
  refine ⟨theta, htheta, ?_⟩
  calc
    brrsAssouadLegendreTransform E alpha = sSup (g '' Icc (0 : Real) 1) :=
      htransform
    _ = g theta := hgreatest.csSup_eq
    _ = theta * alpha + (1 - theta) * brrsAssouadSpectrum E theta := rfl

/-- The exact-scale spectrum transform is bounded above by the literal BRRS
Legendre--Assouad function on its natural nonnegative penalty range.  This is
the lower-bound half of the entropy/spectrum comparison in Theorem 1.2(i). -/
theorem brrsAssouadLegendreTransform_le_brrsLegendreAssouadFunction_of_nonempty
    {E : Set Real} (hE : E.Nonempty) {alpha : Real} (halpha : 0 ≤ alpha) :
    brrsAssouadLegendreTransform E alpha ≤
      brrsLegendreAssouadFunction E alpha := by
  obtain ⟨theta, htheta, hmax⟩ :=
    exists_brrsAssouadLegendreTransform_maximizer E alpha
  rw [hmax]
  exact brrsAssouadSpectrum_affine_le_brrsLegendreAssouadFunction_of_nonempty
    hE htheta.1 htheta.2 halpha

/-- Compatibility wrapper for the reusable restricted-conjugate lower bound. -/
theorem le_brrsRestrictedLegendreTransform
    {nu : Real → Real} {slopes : Set Real} {alpha theta : Real}
    (hbounded : BddAbove ((fun u : Real => u * alpha - nu u) '' slopes))
    (htheta : theta ∈ slopes) :
    theta * alpha - nu theta ≤ brrsRestrictedLegendreTransform nu slopes alpha :=
  le_restrictedConjugate hbounded htheta

/-- Compatibility wrapper for the reusable restricted-conjugate upper bound. -/
theorem brrsRestrictedLegendreTransform_le
    {nu : Real → Real} {slopes : Set Real} {alpha bound : Real}
    (hne : slopes.Nonempty)
    (hbound : ∀ theta ∈ slopes, theta * alpha - nu theta ≤ bound) :
    brrsRestrictedLegendreTransform nu slopes alpha ≤ bound :=
  restrictedConjugate_le hne hbound

/-- Compatibility wrapper for monotonicity of a restricted conjugate. -/
theorem brrsRestrictedLegendreTransform_mono
    {nu : Real → Real} {slopes : Set Real} {alpha beta : Real}
    (hne : slopes.Nonempty) (hslopes : slopes ⊆ Ici (0 : Real))
    (hab : alpha ≤ beta)
    (hbounded : BddAbove ((fun u : Real => u * beta - nu u) '' slopes)) :
    brrsRestrictedLegendreTransform nu slopes alpha ≤
      brrsRestrictedLegendreTransform nu slopes beta :=
  restrictedConjugate_mono hne hslopes hab hbounded

/-- Compatibility wrapper for convexity of a restricted conjugate. -/
theorem brrsRestrictedLegendreTransform_convex
    {nu : Real → Real} {slopes : Set Real}
    (hne : slopes.Nonempty)
    (hbounded : ∀ alpha : Real,
      BddAbove ((fun theta : Real => theta * alpha - nu theta) '' slopes)) :
    ConvexOn Real univ (brrsRestrictedLegendreTransform nu slopes) :=
  restrictedConjugate_convex hne hbounded

/-! ### Convex-dual data for the BRRS realization direction -/

/-- A BRRS-profile candidate lies above the identity on its whole domain.
Convexity compares the secant from `alpha` to `1` with the identity secant
from `1` to `2`. -/
theorem le_of_isBRRSLegendreAssouadProfile {tau : Real → Real}
    (htau : IsBRRSLegendreAssouadProfile tau) {alpha : Real}
    (halpha : 0 ≤ alpha) : alpha ≤ tau alpha := by
  rcases lt_or_ge alpha 1 with hlt | hge
  · have hsec := htau.2.2.1.secant_mono_aux1
      (x := alpha) (y := 1) (z := 2) halpha (by norm_num)
      hlt (by norm_num : (1 : Real) < 2)
    rw [htau.2.2.2 1 (by norm_num), htau.2.2.2 2 (by norm_num)] at hsec
    linarith
  · rw [htau.2.2.2 alpha hge]

/-- The conjugate used in the reverse direction of BRRS Theorem 1.2(ii).
It is the conjugate of `tau` with the primal variable restricted to
`[0,∞)`. -/
def brrsProfileConjugate (tau : Real → Real) (theta : Real) : Real :=
  brrsRestrictedLegendreTransform tau (Ici (0 : Real)) theta

/-- The spectrum candidate obtained from a BRRS-profile candidate by convex
duality.  It is only used for `0 < theta < 1`. -/
def brrsProfileSpectrumCandidate (tau : Real → Real) (theta : Real) : Real :=
  -brrsProfileConjugate tau theta / (1 - theta)

/-- The restricted biconjugate used to recover a BRRS-profile candidate from
its slope-space conjugate. -/
def brrsProfileBiconjugate (tau : Real → Real) (alpha : Real) : Real :=
  brrsRestrictedLegendreTransform (brrsProfileConjugate tau) (Icc (0 : Real) 1) alpha

/-- On slopes at most one, the profile conjugate is bounded above by zero. -/
theorem brrsProfileConjugate_bddAbove {tau : Real → Real}
    (htau : IsBRRSLegendreAssouadProfile tau) {theta : Real}
    (htheta : theta ≤ 1) :
    BddAbove ((fun alpha : Real => alpha * theta - tau alpha) '' Ici (0 : Real)) := by
  refine ⟨0, ?_⟩
  rintro _ ⟨alpha, halpha, rfl⟩
  have hdiag := le_of_isBRRSLegendreAssouadProfile htau halpha
  have hmul : alpha * theta ≤ alpha := by
    calc
      alpha * theta ≤ alpha * 1 :=
        mul_le_mul_of_nonneg_left htheta halpha
      _ = alpha := by ring
  linarith

/-- The conjugate is nonpositive on its natural slope interval. -/
theorem brrsProfileConjugate_le_zero {tau : Real → Real}
    (htau : IsBRRSLegendreAssouadProfile tau) {theta : Real}
    (htheta : theta ≤ 1) :
    brrsProfileConjugate tau theta ≤ 0 := by
  unfold brrsProfileConjugate
  apply brrsRestrictedLegendreTransform_le
  · exact ⟨0, by simp⟩
  · intro alpha halpha
    have hdiag := le_of_isBRRSLegendreAssouadProfile htau halpha
    have hmul : alpha * theta ≤ alpha := by
      calc
        alpha * theta ≤ alpha * 1 :=
          mul_le_mul_of_nonneg_left htheta halpha
        _ = alpha := by ring
    linarith

/-- Evaluating the conjugate at the primal point one gives its elementary
lower affine barrier. -/
theorem le_brrsProfileConjugate {tau : Real → Real}
    (htau : IsBRRSLegendreAssouadProfile tau) {theta : Real}
    (htheta : theta ≤ 1) :
    theta - 1 ≤ brrsProfileConjugate tau theta := by
  unfold brrsProfileConjugate
  have h := le_brrsRestrictedLegendreTransform
    (brrsProfileConjugate_bddAbove htau htheta) (by simp : (1 : Real) ∈ Ici 0)
  simpa [htau.2.2.2 1 (by norm_num)] using h

/-- The conjugate vanishes at slope one. -/
theorem brrsProfileConjugate_one {tau : Real → Real}
    (htau : IsBRRSLegendreAssouadProfile tau) :
    brrsProfileConjugate tau 1 = 0 := by
  apply le_antisymm
  · exact brrsProfileConjugate_le_zero htau le_rfl
  · simpa using le_brrsProfileConjugate htau le_rfl

/-- The profile conjugate has the exact elementary barriers needed to turn
it into an Assouad-spectrum candidate. -/
theorem brrsProfileConjugate_bounds {tau : Real → Real}
    (htau : IsBRRSLegendreAssouadProfile tau) {theta : Real}
    (htheta : theta ≤ 1) :
    theta - 1 ≤ brrsProfileConjugate tau theta ∧
      brrsProfileConjugate tau theta ≤ 0 :=
  ⟨le_brrsProfileConjugate htau htheta,
    brrsProfileConjugate_le_zero htau htheta⟩

/-- Below the terminal slope, the forced identity tail of a BRRS profile
does not contribute new affine tests to its conjugate.  Thus the unbounded
primal half-line can be replaced by the compact unit interval. -/
theorem brrsProfileConjugate_eq_restricted_unitInterval {tau : Real → Real}
    (htau : IsBRRSLegendreAssouadProfile tau) {theta : Real}
    (htheta : theta ≤ 1) :
    brrsProfileConjugate tau theta =
      brrsRestrictedLegendreTransform tau (Icc (0 : Real) 1) theta := by
  unfold brrsProfileConjugate
  apply restrictedConjugate_Ici_eq_Icc_of_eq_id_on_Ici_one
  · exact htau.2.2.2
  · exact htheta
  · rcases brrsProfileConjugate_bddAbove htau htheta with ⟨B, hB⟩
    refine ⟨B, ?_⟩
    rintro _ ⟨alpha, halpha, rfl⟩
    exact hB ⟨alpha, halpha.1, rfl⟩

/-- The profile conjugate is one-Lipschitz throughout the slope range where
it is finite.  This provides the right-continuity at the zero endpoint that
is not part of Rutar's open-interval realization statement. -/
theorem brrsProfileConjugate_lipschitzOn {tau : Real → Real}
    (htau : IsBRRSLegendreAssouadProfile tau) :
    LipschitzOnWith 1 (brrsProfileConjugate tau) (Iic (1 : Real)) := by
  let g : Real → Real :=
    brrsRestrictedLegendreTransform tau (Icc (0 : Real) 1)
  have hbounded : ∀ theta ∈ Iic (1 : Real), BddAbove
      ((fun alpha : Real => alpha * theta - tau alpha) '' Icc (0 : Real) 1) := by
    intro theta htheta
    rcases brrsProfileConjugate_bddAbove htau htheta with ⟨B, hB⟩
    refine ⟨B, ?_⟩
    rintro _ ⟨alpha, halpha, rfl⟩
    exact hB ⟨alpha, halpha.1, rfl⟩
  have hg : LipschitzOnWith 1 g (Iic (1 : Real)) :=
    restrictedConjugate_lipschitzOn_of_subset_Icc_zero_one
      (by exact ⟨0, by norm_num⟩) (by intro x hx; exact hx) hbounded
  intro theta htheta eta heta
  rw [brrsProfileConjugate_eq_restricted_unitInterval htau htheta,
    brrsProfileConjugate_eq_restricted_unitInterval htau heta]
  exact hg htheta heta

/-- An open-interval realization of the convex-dual spectrum candidate
automatically has the right zero endpoint.  The point is that both weighted
spectra have a right limit there: for the realized set this is the exact-scale
continuity theorem, while for the candidate it follows from the unit-interval
restriction of the profile conjugate. -/
theorem brrsAssouadSpectrum_zero_eq_brrsProfileSpectrumCandidate_of_open
    {E : Set Real} {tau : Real → Real}
    (htau : IsBRRSLegendreAssouadProfile tau)
    (hspectrum : ∀ theta : Real, 0 < theta → theta < 1 →
      brrsAssouadSpectrum E theta = brrsProfileSpectrumCandidate tau theta) :
    brrsAssouadSpectrum E 0 = brrsProfileSpectrumCandidate tau 0 := by
  let f : Real → Real :=
    fun theta => (1 - theta) * brrsAssouadSpectrum E theta
  let g : Real → Real := fun theta => -brrsProfileConjugate tau theta
  have hfcont : ContinuousAt f 0 := by
    apply (brrsWeightedAssouadSpectrum_continuousOn E).continuousAt
    exact Iio_mem_nhds (by norm_num)
  have hgcont : ContinuousAt g 0 := by
    have hconj : ContinuousAt (brrsProfileConjugate tau) 0 :=
      (brrsProfileConjugate_lipschitzOn htau).continuousOn.continuousAt
        (Iic_mem_nhds (by norm_num))
    exact hconj.neg
  have hf : Filter.Tendsto f (𝓝[>] (0 : Real)) (𝓝 (f 0)) := by
    have hfilter : nhdsWithin (0 : Real) (Ioi 0) ≤ nhds 0 := inf_le_left
    simpa using (hfcont.tendsto.mono_left hfilter)
  have hg : Filter.Tendsto g (𝓝[>] (0 : Real)) (𝓝 (g 0)) := by
    have hfilter : nhdsWithin (0 : Real) (Ioi 0) ≤ nhds 0 := inf_le_left
    simpa using (hgcont.tendsto.mono_left hfilter)
  have hsmall : ∀ᶠ theta : Real in 𝓝[>] (0 : Real), theta ∈ Ioo 0 1 :=
    nhdsGT_basis 0 |>.mem_of_mem (by norm_num)
  have heq : f =ᶠ[𝓝[>] (0 : Real)] g := by
    filter_upwards [hsmall] with theta htheta
    dsimp [f, g]
    rw [hspectrum theta htheta.1 htheta.2, brrsProfileSpectrumCandidate]
    field_simp [ne_of_gt (sub_pos.mpr htheta.2)]
  have hlimit : f 0 = g 0 :=
    tendsto_nhds_unique_of_eventuallyEq hf hg heq
  simpa [f, g, brrsProfileSpectrumCandidate] using hlimit

/-- The restricted profile conjugate is increasing in its slope.  This is
the second structural hypothesis in the Assouad-spectrum realization theorem
used by BRRS. -/
theorem brrsProfileConjugate_mono {tau : Real → Real}
    (htau : IsBRRSLegendreAssouadProfile tau) {theta eta : Real}
    (htheta_eta : theta ≤ eta) (heta : eta ≤ 1) :
    brrsProfileConjugate tau theta ≤ brrsProfileConjugate tau eta := by
  unfold brrsProfileConjugate
  apply brrsRestrictedLegendreTransform_le
  · exact ⟨0, by simp⟩
  · intro alpha halpha
    calc
      alpha * theta - tau alpha ≤ alpha * eta - tau alpha := by
        gcongr
      _ ≤ brrsRestrictedLegendreTransform tau (Ici (0 : Real)) eta :=
        le_brrsRestrictedLegendreTransform
          (brrsProfileConjugate_bddAbove htau heta) halpha

/-- Every primal affine test lies below the profile conjugate. -/
theorem affine_le_brrsProfileConjugate {tau : Real → Real}
    (htau : IsBRRSLegendreAssouadProfile tau) {alpha theta : Real}
    (halpha : 0 ≤ alpha) (htheta : theta ≤ 1) :
    alpha * theta - tau alpha ≤ brrsProfileConjugate tau theta := by
  unfold brrsProfileConjugate
  exact le_brrsRestrictedLegendreTransform
    (brrsProfileConjugate_bddAbove htau htheta) halpha

/-- The slope-restricted transform defining the BRRS profile biconjugate is
finite above at every nonnegative primal parameter. -/
theorem brrsProfileBiconjugate_bddAbove {tau : Real → Real}
    (htau : IsBRRSLegendreAssouadProfile tau) {alpha : Real}
    (halpha : 0 ≤ alpha) :
    BddAbove ((fun theta : Real => theta * alpha - brrsProfileConjugate tau theta) ''
      Icc (0 : Real) 1) := by
  refine ⟨alpha + 1, ?_⟩
  rintro _ ⟨theta, htheta, rfl⟩
  have hnu := le_brrsProfileConjugate htau htheta.2
  have hmul : theta * alpha ≤ alpha := by
    calc
      theta * alpha ≤ 1 * alpha :=
        mul_le_mul_of_nonneg_right htheta.2 halpha
      _ = alpha := by ring
  have htheta_nonneg : 0 ≤ theta := htheta.1
  linarith

/-- The restricted biconjugate never exceeds the original BRRS-profile
candidate on its nonnegative domain. -/
theorem brrsProfileBiconjugate_le {tau : Real → Real}
    (htau : IsBRRSLegendreAssouadProfile tau) {alpha : Real}
    (halpha : 0 ≤ alpha) :
    brrsProfileBiconjugate tau alpha ≤ tau alpha := by
  unfold brrsProfileBiconjugate
  apply brrsRestrictedLegendreTransform_le
  · exact ⟨0, by simp⟩
  · intro theta htheta
    have h := affine_le_brrsProfileConjugate htau halpha htheta.2
    linarith

/-- Restricted Fenchel--Moreau duality for a BRRS-profile candidate.  The
forced identity tail makes every supporting slope lie in `[0,1]`, so the
restricted biconjugate recovers the original function on `[0,∞)`. -/
theorem brrsProfileBiconjugate_eq {tau : Real → Real}
    (htau : IsBRRSLegendreAssouadProfile tau) {alpha : Real}
    (halpha : 0 ≤ alpha) :
    brrsProfileBiconjugate tau alpha = tau alpha := by
  exact halfline_restrictedBiconjugate_eq_of_convexOn_monotone_eq_id
    htau.2.1 htau.2.2.1 htau.2.2.2 halpha

/-- The convex-duality portion of the BRRS realization argument.  Once a
bounded set realizes the spectrum candidate and the entropy/spectrum identity
is available, its literal Legendre--Assouad function is the prescribed
profile. -/
theorem brrsLegendreAssouadFunction_eq_of_spectrum_realization
    {E : Set Real} {tau : Real → Real}
    (htau : IsBRRSLegendreAssouadProfile tau)
    (hsharp : ∀ alpha : Real,
      brrsLegendreAssouadFunction E alpha = brrsAssouadLegendreTransform E alpha)
    (hspectrum : ∀ theta : Real, 0 < theta → theta < 1 →
      brrsAssouadSpectrum E theta = brrsProfileSpectrumCandidate tau theta)
    {alpha : Real} (halpha : 0 ≤ alpha) :
    brrsLegendreAssouadFunction E alpha = tau alpha := by
  have hpotential : ∀ theta ∈ Icc (0 : Real) 1,
      brrsAssouadPotential E theta = brrsProfileConjugate tau theta := by
    intro theta htheta
    rcases eq_or_lt_of_le htheta.1 with rfl | htheta_pos
    · have hzero :=
        brrsAssouadSpectrum_zero_eq_brrsProfileSpectrumCandidate_of_open
          htau hspectrum
      simp only [brrsAssouadPotential, zero_ne_one, if_false, sub_zero]
      rw [hzero, brrsProfileSpectrumCandidate]
      ring
    · rcases eq_or_ne theta 1 with rfl | htheta_ne
      · simp [brrsAssouadPotential, brrsProfileConjugate_one htau]
      · have htheta_lt : theta < 1 := lt_of_le_of_ne htheta.2 htheta_ne
        have hden : 1 - theta ≠ 0 := ne_of_gt (sub_pos.mpr htheta_lt)
        rw [brrsAssouadPotential, if_neg htheta_ne,
          hspectrum theta htheta_pos htheta_lt, brrsProfileSpectrumCandidate]
        field_simp [hden]
  calc
    brrsLegendreAssouadFunction E alpha = brrsAssouadLegendreTransform E alpha :=
      hsharp alpha
    _ = brrsProfileBiconjugate tau alpha := by
      unfold brrsAssouadLegendreTransform brrsProfileBiconjugate
        brrsRestrictedLegendreTransform
      apply congrArg sSup
      ext x
      constructor
      · rintro ⟨theta, htheta, rfl⟩
        exact ⟨theta, htheta, by
          exact congrArg (fun u : Real => theta * alpha - u)
            (hpotential theta htheta).symm⟩
      · rintro ⟨theta, htheta, rfl⟩
        exact ⟨theta, htheta, by
          exact congrArg (fun u : Real => theta * alpha - u)
            (hpotential theta htheta)⟩
    _ = tau alpha := brrsProfileBiconjugate_eq htau halpha

/-- Above the forced identity threshold, the restricted biconjugate is
already exactly the identity. -/
theorem brrsProfileBiconjugate_eq_id_of_one_le {tau : Real → Real}
    (htau : IsBRRSLegendreAssouadProfile tau) {alpha : Real}
    (halpha : 1 ≤ alpha) : brrsProfileBiconjugate tau alpha = alpha := by
  apply le_antisymm
  · calc
      brrsProfileBiconjugate tau alpha ≤ tau alpha :=
        brrsProfileBiconjugate_le htau (zero_le_one.trans halpha)
      _ = alpha := htau.2.2.2 alpha halpha
  · unfold brrsProfileBiconjugate
    have h := le_brrsRestrictedLegendreTransform
      (show BddAbove ((fun theta : Real => theta * alpha -
        brrsProfileConjugate tau theta) '' Icc (0 : Real) 1) by
        refine ⟨alpha, ?_⟩
        rintro _ ⟨theta, htheta, rfl⟩
        have hnu := le_brrsProfileConjugate htau htheta.2
        have hmul : theta * (alpha - 1) ≤ alpha - 1 := by
          calc
            theta * (alpha - 1) ≤ 1 * (alpha - 1) :=
              mul_le_mul_of_nonneg_right htheta.2 (sub_nonneg.mpr halpha)
            _ = alpha - 1 := by ring
        linarith)
      (by simp : (1 : Real) ∈ Icc 0 1)
    simpa [brrsProfileConjugate_one htau] using h

/-- The profile conjugate is convex on the only slope interval relevant to
the BRRS spectrum. -/
theorem brrsProfileConjugate_convexOn {tau : Real → Real}
    (htau : IsBRRSLegendreAssouadProfile tau) :
    ConvexOn Real (Icc (0 : Real) 1) (brrsProfileConjugate tau) := by
  constructor
  · exact convex_Icc _ _
  · intro x hx y hy a b ha hb hab
    change brrsProfileConjugate tau (a * x + b * y) ≤
      a * brrsProfileConjugate tau x + b * brrsProfileConjugate tau y
    unfold brrsProfileConjugate
    apply brrsRestrictedLegendreTransform_le
    · exact ⟨0, by simp⟩
    · intro theta htheta
      have hx' : theta * x - tau theta ≤
          brrsRestrictedLegendreTransform tau (Ici (0 : Real)) x :=
        le_brrsRestrictedLegendreTransform
          (brrsProfileConjugate_bddAbove htau hx.2) htheta
      have hy' : theta * y - tau theta ≤
          brrsRestrictedLegendreTransform tau (Ici (0 : Real)) y :=
        le_brrsRestrictedLegendreTransform
          (brrsProfileConjugate_bddAbove htau hy.2) htheta
      have hsum := add_le_add
        (mul_le_mul_of_nonneg_left hx' ha)
        (mul_le_mul_of_nonneg_left hy' hb)
      simpa only [smul_eq_mul] using
        (show theta * (a * x + b * y) - tau theta ≤
          a * brrsRestrictedLegendreTransform tau (Ici (0 : Real)) x +
            b * brrsRestrictedLegendreTransform tau (Ici (0 : Real)) y by
          calc
            theta * (a * x + b * y) - tau theta =
                a * (theta * x - tau theta) + b * (theta * y - tau theta) := by
                  calc
                    theta * (a * x + b * y) - tau theta =
                        a * (theta * x) + b * (theta * y) - tau theta := by ring
                    _ = a * (theta * x - tau theta) +
                        b * (theta * y - tau theta) := by
                          calc
                            a * (theta * x) + b * (theta * y) - tau theta =
                                a * (theta * x) + b * (theta * y) -
                                  (1 : Real) * tau theta := by ring
                            _ = a * (theta * x) + b * (theta * y) -
                                (a + b) * tau theta := by rw [hab]
                            _ = a * (theta * x - tau theta) +
                                b * (theta * y - tau theta) := by ring
            _ ≤ a * brrsRestrictedLegendreTransform tau (Ici (0 : Real)) x +
                b * brrsRestrictedLegendreTransform tau (Ici (0 : Real)) y := hsum)

/-- The convex-dual spectrum candidate is nonnegative on `(0,1)`. -/
theorem brrsProfileSpectrumCandidate_nonneg {tau : Real → Real}
    (htau : IsBRRSLegendreAssouadProfile tau) {theta : Real}
    (htheta : theta < 1) :
    0 ≤ brrsProfileSpectrumCandidate tau theta := by
  unfold brrsProfileSpectrumCandidate
  have hnu := brrsProfileConjugate_le_zero htau htheta.le
  exact div_nonneg (neg_nonneg.mpr hnu) (sub_pos.mpr htheta).le

/-- The convex-dual spectrum candidate is at most the ambient line dimension
one on `(0,1)`. -/
theorem brrsProfileSpectrumCandidate_le_one {tau : Real → Real}
    (htau : IsBRRSLegendreAssouadProfile tau) {theta : Real}
    (htheta : theta < 1) :
    brrsProfileSpectrumCandidate tau theta ≤ 1 := by
  unfold brrsProfileSpectrumCandidate
  have hnu := le_brrsProfileConjugate htau htheta.le
  apply (div_le_iff₀ (sub_pos.mpr htheta)).mpr
  linarith

/-- Convexity of the conjugate makes the associated spectrum candidate
increasing.  This is the exact structural condition in Rutar's realization
theorem for Assouad spectra. -/
theorem brrsProfileSpectrumCandidate_mono {tau : Real → Real}
    (htau : IsBRRSLegendreAssouadProfile tau) {theta eta : Real}
    (htheta : 0 ≤ theta) (htheta_eta : theta ≤ eta) (heta : eta < 1) :
    brrsProfileSpectrumCandidate tau theta ≤
      brrsProfileSpectrumCandidate tau eta := by
  rcases eq_or_lt_of_le htheta_eta with rfl | hlt
  · rfl
  have htheta_one : theta < 1 := hlt.trans heta
  have hsec := (brrsProfileConjugate_convexOn htau).secant_mono_aux1
    (x := theta) (y := eta) (z := 1)
    ⟨htheta, htheta_one.le⟩ (by norm_num) hlt heta
  rw [brrsProfileConjugate_one htau] at hsec
  unfold brrsProfileSpectrumCandidate
  apply (div_le_div_iff₀ (sub_pos.mpr htheta_one) (sub_pos.mpr heta)).mpr
  nlinarith [hsec]

/-- The affine family defining the BRRS transform is bounded above on the
compact slope interval.  This supplies the finiteness hypothesis needed for
order-theoretic `sSup` arguments. -/
theorem brrsAssouadLegendreTransform_bddAbove (E : Set Real) (alpha : Real) :
    BddAbove ((fun theta : Real => theta * alpha - brrsAssouadPotential E theta) ''
      Icc (0 : Real) 1) := by
  refine ⟨max 0 alpha + 1, ?_⟩
  rintro _ ⟨theta, htheta, rfl⟩
  have htheta_alpha : theta * alpha ≤ max 0 alpha := by
    by_cases halpha : 0 ≤ alpha
    · calc
        theta * alpha ≤ 1 * alpha :=
          mul_le_mul_of_nonneg_right htheta.2 halpha
        _ = alpha := by ring
        _ ≤ max 0 alpha := le_max_right _ _
    · have halpha' : alpha ≤ 0 := le_of_not_ge halpha
      calc
        theta * alpha ≤ 0 := mul_nonpos_of_nonneg_of_nonpos htheta.1 halpha'
        _ ≤ max 0 alpha := le_max_left _ _
  have hpotential := brrsAssouadPotential_lower E htheta.1 htheta.2
  have hneg_potential : -brrsAssouadPotential E theta ≤ 1 - theta := by
    linarith
  calc
    theta * alpha - brrsAssouadPotential E theta =
        theta * alpha + (-brrsAssouadPotential E theta) := by ring
    _ ≤ max 0 alpha + (1 - theta) := add_le_add htheta_alpha hneg_potential
    _ ≤ max 0 alpha + 1 := by linarith [htheta.1]

/-- Every individual spectral affine expression is bounded by the exact-scale
BRRS transform. -/
theorem brrsAssouadSpectrum_affine_le_brrsAssouadLegendreTransform
    (E : Set Real) (alpha : Real) {theta : Real}
    (htheta : theta ∈ Icc (0 : Real) 1) :
    theta * alpha + (1 - theta) * brrsAssouadSpectrum E theta ≤
      brrsAssouadLegendreTransform E alpha := by
  rw [brrsAssouadLegendreTransform_eq_restricted]
  have h := le_brrsRestrictedLegendreTransform
    (brrsAssouadLegendreTransform_bddAbove E alpha) htheta
  by_cases htheta_one : theta = 1
  · subst theta
    simpa [brrsAssouadPotential] using h
  · rw [brrsAssouadPotential, if_neg htheta_one] at h
    convert h using 1; ring

/-- Strictly above the spectral BRRS transform, every parameter has a local
exact-scale spectrum cover whose weighted profile exponent stays below the
chosen bound.  The anchors are moved a little to the left; this includes the
endpoint `θ = 1` and treats `θ = 0` with its one-sided neighbourhood. -/
theorem exists_brrs_compact_parameter_bounds_of_lt_brrsAssouadLegendreTransform
    (E : Set Real) {alpha B : Real}
    (hB : brrsAssouadLegendreTransform E alpha < B) :
    ∃ (U : BRRSParameter → Set BRRSParameter)
      (eta gamma C : BRRSParameter → Real),
      (∀ x : BRRSParameter, U x ∈ 𝓝 x) ∧
      (∀ x : BRRSParameter, 0 < C x) ∧
      (∀ x : BRRSParameter, ∀ d : NNReal, 0 < d → d < 1 → ∀ a : Real,
        brrsEntropyNumber (E ∩ brrsInterval a ((d : Real) ^ eta x)) d ≤
          ENNReal.ofReal
            (C x * ((((d : Real) ^ eta x) / (d : Real)) ^ gamma x))) ∧
      ∀ x theta : BRRSParameter, theta ∈ U x →
        eta x ≤ theta.1 ∧
          theta.1 * alpha + (1 - eta x) * gamma x ≤ B := by
  classical
  let w : Real → Real := fun theta =>
    (1 - theta) * brrsAssouadSpectrum E theta
  let F : BRRSParameter → Real := fun x => x.1 * alpha + w x.1
  let m : BRRSParameter → Real := fun x => B - F x
  have hFle : ∀ x : BRRSParameter, F x ≤ brrsAssouadLegendreTransform E alpha := by
    intro x
    dsimp only [F, w]
    exact brrsAssouadSpectrum_affine_le_brrsAssouadLegendreTransform E alpha x.2
  have hmpos : ∀ x : BRRSParameter, 0 < m x := by
    intro x
    dsimp only [m]
    linarith [hFle x, hB]
  let r : BRRSParameter → Real := fun x => min (x.1 / 2) (m x / 2)
  let eta : BRRSParameter → Real := fun x => x.1 - r x
  have hr_nonneg : ∀ x : BRRSParameter, 0 ≤ r x := by
    intro x
    dsimp only [r]
    exact le_min (by linarith [x.2.1]) (by linarith [hmpos x])
  have hr_le_half : ∀ x : BRRSParameter, r x ≤ x.1 / 2 := by
    intro x
    dsimp only [r]
    exact min_le_left _ _
  have hr_le_mhalf : ∀ x : BRRSParameter, r x ≤ m x / 2 := by
    intro x
    dsimp only [r]
    exact min_le_right _ _
  have heta_nonneg : ∀ x : BRRSParameter, 0 ≤ eta x := by
    intro x
    dsimp only [eta]
    apply sub_nonneg.mpr
    calc
      r x ≤ x.1 / 2 := hr_le_half x
      _ ≤ x.1 := by linarith [x.2.1]
  have heta_le : ∀ x : BRRSParameter, eta x ≤ x.1 := by
    intro x
    dsimp only [eta]
    linarith [hr_nonneg x]
  have hr_pos : ∀ x : BRRSParameter, 0 < x.1 → 0 < r x := by
    intro x hx
    dsimp only [r]
    exact lt_min (by linarith) (by linarith [hmpos x])
  have heta_lt : ∀ x : BRRSParameter, 0 < x.1 → eta x < x.1 := by
    intro x hx
    dsimp only [eta]
    exact sub_lt_self _ (hr_pos x hx)
  have heta_eq_zero : ∀ x : BRRSParameter, x.1 = 0 → eta x = 0 := by
    intro x hx
    dsimp only [eta, r]
    rw [hx]
    have hm : 0 ≤ m x / 2 := by linarith [hmpos x]
    simp [min_eq_left hm]
  have heta_lt_one : ∀ x : BRRSParameter, eta x < 1 := by
    intro x
    by_cases hx : x.1 = 0
    · rw [heta_eq_zero x hx]
      norm_num
    · have hxpos : 0 < x.1 := lt_of_le_of_ne x.2.1 (Ne.symm hx)
      exact (heta_lt x hxpos).trans_le x.2.2
  have heta_le_one : ∀ x : BRRSParameter, eta x ≤ 1 := fun x =>
    (heta_lt_one x).le
  have hdist_eta : ∀ x : BRRSParameter, dist (eta x) x.1 = r x := by
    intro x
    rw [Real.dist_eq]
    dsimp only [eta]
    rw [show (x.1 - r x) - x.1 = -r x by ring,
      abs_neg, abs_of_nonneg (hr_nonneg x)]
  have hw_le : ∀ x : BRRSParameter, w (eta x) ≤ w x.1 + r x := by
    intro x
    have hdist := (brrsWeightedAssouadSpectrum_lipschitzOn_Iic E).dist_le_mul
      (eta x) (heta_le_one x) x.1 x.2.2
    change dist (w (eta x)) (w x.1) ≤ 1 * dist (eta x) x.1 at hdist
    have hdist' : dist (w (eta x)) (w x.1) ≤ r x := by
      calc
        dist (w (eta x)) (w x.1) ≤ 1 * dist (eta x) x.1 := hdist
        _ = r x := by rw [hdist_eta x]; norm_num
    calc
      w (eta x) = w x.1 + (w (eta x) - w x.1) := by ring
      _ ≤ w x.1 + |w (eta x) - w x.1| := by
        gcongr
        exact le_abs_self _
      _ = w x.1 + dist (w (eta x)) (w x.1) := by rw [Real.dist_eq]
      _ ≤ w x.1 + r x := by
        simpa [add_comm] using add_le_add_right hdist' (w x.1)
  have hanchor : ∀ x : BRRSParameter, x.1 * alpha + w (eta x) < B := by
    intro x
    calc
      x.1 * alpha + w (eta x) ≤ x.1 * alpha + (w x.1 + r x) :=
        by simpa [add_comm] using add_le_add_right (hw_le x) (x.1 * alpha)
      _ = F x + r x := by
        dsimp only [F]
        ring
      _ ≤ F x + m x / 2 := by
        simpa [add_comm] using add_le_add_left (hr_le_mhalf x) (F x)
      _ < B := by
        dsimp only [m]
        linarith [hmpos x]
  let D : BRRSParameter → Real := fun x => B - x.1 * alpha - w (eta x)
  have hDpos : ∀ x : BRRSParameter, 0 < D x := by
    intro x
    dsimp only [D]
    linarith [hanchor x]
  let gamma : BRRSParameter → Real := fun x =>
    brrsAssouadSpectrum E (eta x) + D x / (2 * (1 - eta x))
  have hgamma_gt : ∀ x : BRRSParameter,
      brrsAssouadSpectrum E (eta x) < gamma x := by
    intro x
    dsimp only [gamma]
    apply lt_add_of_pos_right
    exact div_pos (hDpos x) (mul_pos (by norm_num) (sub_pos.mpr (heta_lt_one x)))
  have hhas : ∀ x : BRRSParameter,
      HasBRRSAssouadSpectrumExponent E (eta x) (gamma x) := by
    intro x
    exact hasBRRSAssouadSpectrumExponent_of_brrsAssouadSpectrum_lt E
      (heta_le_one x) (hgamma_gt x)
  choose C hC hcover using hhas
  have hgamma_weighted : ∀ x : BRRSParameter,
      (1 - eta x) * gamma x = w (eta x) + D x / 2 := by
    intro x
    dsimp only [gamma, w]
    field_simp [ne_of_gt (sub_pos.mpr (heta_lt_one x))]
  have haffine : ∀ x : BRRSParameter,
      x.1 * alpha + (1 - eta x) * gamma x < B := by
    intro x
    calc
      x.1 * alpha + (1 - eta x) * gamma x =
          x.1 * alpha + w (eta x) + D x / 2 := by
            rw [hgamma_weighted x]
            ring
      _ = B - D x / 2 := by
        dsimp only [D]
        ring
      _ < B := by linarith [hDpos x]
  let V : BRRSParameter → Set BRRSParameter := fun x =>
    {theta | theta.1 * alpha + (1 - eta x) * gamma x < B}
  let W : BRRSParameter → Set BRRSParameter := fun x =>
    {theta | eta x < theta.1}
  let U : BRRSParameter → Set BRRSParameter := fun x =>
    if x.1 = 0 then V x else W x ∩ V x
  have hVopen : ∀ x : BRRSParameter, IsOpen (V x) := by
    intro x
    dsimp only [V]
    exact isOpen_Iio.preimage
      ((continuous_subtype_val.mul continuous_const).add continuous_const)
  have hWopen : ∀ x : BRRSParameter, IsOpen (W x) := by
    intro x
    dsimp only [W]
    exact isOpen_Ioi.preimage continuous_subtype_val
  have hU : ∀ x : BRRSParameter, U x ∈ 𝓝 x := by
    intro x
    by_cases hx : x.1 = 0
    · change (if x.1 = 0 then V x else W x ∩ V x) ∈ 𝓝 x
      rw [if_pos hx]
      apply (hVopen x).mem_nhds
      exact haffine x
    · change (if x.1 = 0 then V x else W x ∩ V x) ∈ 𝓝 x
      rw [if_neg hx]
      apply ((hWopen x).inter (hVopen x)).mem_nhds
      constructor
      · exact heta_lt x (lt_of_le_of_ne x.2.1 (Ne.symm hx))
      · exact haffine x
  have hlocal : ∀ x theta : BRRSParameter, theta ∈ U x →
      eta x ≤ theta.1 ∧
        theta.1 * alpha + (1 - eta x) * gamma x ≤ B := by
    intro x theta htheta
    by_cases hx : x.1 = 0
    · change theta ∈ (if x.1 = 0 then V x else W x ∩ V x) at htheta
      rw [if_pos hx] at htheta
      constructor
      · rw [heta_eq_zero x hx]
        exact theta.2.1
      · exact htheta.le
    · change theta ∈ (if x.1 = 0 then V x else W x ∩ V x) at htheta
      rw [if_neg hx] at htheta
      exact ⟨htheta.1.le, htheta.2.le⟩
  exact ⟨U, eta, gamma, C, hU, hC, hcover, hlocal⟩

/-- The compact exact-scale spectrum calculation supplies the upper-bound
half of BRRS Theorem 1.2(i), before the elementary negative-parameter
reduction. -/
theorem brrsLegendreAssouadFunction_le_brrsAssouadLegendreTransform_of_nonempty
    {E : Set Real} (hE : E.Nonempty) (alpha : Real) :
    brrsLegendreAssouadFunction E alpha ≤
      brrsAssouadLegendreTransform E alpha := by
  apply le_of_forall_pos_le_add
  intro epsilon hepsilon
  obtain ⟨U, eta, gamma, C, hU, hC, hcover, hlocal⟩ :=
    exists_brrs_compact_parameter_bounds_of_lt_brrsAssouadLegendreTransform E
      (B := brrsAssouadLegendreTransform E alpha + epsilon) (by linarith)
  obtain ⟨M, hM, hprofile⟩ :=
    eventually_brrsLegendreAssouadProfile_le_of_compact_parameter_bounds E
      U eta gamma C hU hC hcover hlocal
  exact brrsLegendreAssouadFunction_le_of_profile_power_bound hE
    ENNReal.ofReal_ne_top hprofile

/-- BRRS Theorem 1.2(i) on its natural nonnegative Legendre-parameter
range.  The remaining nonpositive range is reduced to the endpoint below. -/
theorem brrsLegendreAssouadFunction_eq_brrsAssouadLegendreTransform_of_nonempty_of_nonneg
    {E : Set Real} (hE : E.Nonempty) {alpha : Real} (halpha : 0 ≤ alpha) :
    brrsLegendreAssouadFunction E alpha =
      brrsAssouadLegendreTransform E alpha := by
  exact le_antisymm
    (brrsLegendreAssouadFunction_le_brrsAssouadLegendreTransform_of_nonempty hE alpha)
    (brrsAssouadLegendreTransform_le_brrsLegendreAssouadFunction_of_nonempty
      hE halpha)

/-- The spectral BRRS transform is flat on the nonpositive parameter
half-line, with value supplied by its slope-zero test. -/
theorem brrsAssouadLegendreTransform_eq_brrsAssouadSpectrum_zero_of_nonpos
    (E : Set Real) {alpha : Real} (halpha : alpha ≤ 0) :
    brrsAssouadLegendreTransform E alpha = brrsAssouadSpectrum E 0 := by
  apply le_antisymm
  · obtain ⟨theta, htheta, hmax⟩ :=
      exists_brrsAssouadLegendreTransform_maximizer E alpha
    rw [hmax]
    by_cases htheta_one : theta = 1
    · subst theta
      have hzero : 0 ≤ brrsAssouadSpectrum E 0 :=
        brrsAssouadSpectrum_nonneg E (by norm_num)
      simpa using halpha.trans hzero
    · have htheta_lt : theta < 1 := lt_of_le_of_ne htheta.2 htheta_one
      have hweighted := brrsWeightedAssouadSpectrum_parameter_antitone E
        (theta := (0 : Real)) (theta' := theta) htheta.1 htheta_lt
      have halpha_term : theta * alpha ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos htheta.1 halpha
      calc
        theta * alpha + (1 - theta) * brrsAssouadSpectrum E theta ≤
            0 + (1 - 0) * brrsAssouadSpectrum E 0 :=
          add_le_add halpha_term hweighted
        _ = brrsAssouadSpectrum E 0 := by ring
  · have hzero := brrsAssouadSpectrum_affine_le_brrsAssouadLegendreTransform
      E alpha (theta := (0 : Real)) (by norm_num)
    simpa using hzero

/-- The full exact-scale entropy/spectrum identity in BRRS Theorem 1.2(i),
for every real Legendre parameter. -/
theorem brrsLegendreAssouadFunction_eq_brrsAssouadLegendreTransform_of_nonempty
    {E : Set Real} (hE : E.Nonempty) (alpha : Real) :
    brrsLegendreAssouadFunction E alpha =
      brrsAssouadLegendreTransform E alpha := by
  by_cases halpha : 0 ≤ alpha
  · exact brrsLegendreAssouadFunction_eq_brrsAssouadLegendreTransform_of_nonempty_of_nonneg
      hE halpha
  · have halpha_nonpos : alpha ≤ 0 := le_of_not_ge halpha
    calc
      brrsLegendreAssouadFunction E alpha = brrsLegendreAssouadFunction E 0 :=
        brrsLegendreAssouadFunction_eq_zero_of_nonpos E halpha_nonpos
      _ = brrsAssouadLegendreTransform E 0 :=
        brrsLegendreAssouadFunction_eq_brrsAssouadLegendreTransform_of_nonempty_of_nonneg
          hE le_rfl
      _ = brrsAssouadSpectrum E 0 :=
        brrsAssouadLegendreTransform_eq_brrsAssouadSpectrum_zero_of_nonpos E le_rfl
      _ = brrsAssouadLegendreTransform E alpha :=
        (brrsAssouadLegendreTransform_eq_brrsAssouadSpectrum_zero_of_nonpos E
          halpha_nonpos).symm

/-- BRRS Theorem 1.2(i), in the literal Euclidean entropy convention used by
this file.  Boundedness is part of the paper statement, though the exact
local comparison proved above does not need it. -/
theorem brrsTheoremOnePointTwoPartOne :
    BRRSTheoremOnePointTwoPartOneStatement := by
  intro E hE _ alpha
  exact brrsLegendreAssouadFunction_eq_brrsAssouadLegendreTransform_of_nonempty
    hE alpha

/-- The literal BRRS Legendre transform is convex. -/
theorem brrsAssouadLegendreTransform_convex (E : Set Real) :
    ConvexOn Real univ (brrsAssouadLegendreTransform E) := by
  change ConvexOn Real univ
    (brrsRestrictedLegendreTransform (brrsAssouadPotential E) (Icc 0 1))
  apply brrsRestrictedLegendreTransform_convex
  · exact ⟨0, by simp⟩
  · intro alpha
    exact brrsAssouadLegendreTransform_bddAbove E alpha

/-- The literal BRRS Legendre transform is increasing. -/
theorem brrsAssouadLegendreTransform_mono (E : Set Real) :
    Monotone (brrsAssouadLegendreTransform E) := by
  intro alpha beta hab
  rw [brrsAssouadLegendreTransform_eq_restricted,
    brrsAssouadLegendreTransform_eq_restricted]
  apply brrsRestrictedLegendreTransform_mono
  · exact ⟨0, by simp⟩
  · intro theta htheta
    exact htheta.1
  · exact hab
  · exact brrsAssouadLegendreTransform_bddAbove E beta

/-- The endpoint slope `θ = 1` gives the elementary lower bound for the
BRRS transform. -/
theorem le_brrsAssouadLegendreTransform (E : Set Real) (alpha : Real) :
    alpha ≤ brrsAssouadLegendreTransform E alpha := by
  rw [brrsAssouadLegendreTransform_eq_restricted]
  have h := le_brrsRestrictedLegendreTransform
    (brrsAssouadLegendreTransform_bddAbove E alpha) (by simp : (1 : Real) ∈ Icc 0 1)
  simpa using h

/-- In particular, the BRRS transform is nonnegative on `[0,∞)`. -/
theorem brrsAssouadLegendreTransform_nonneg (E : Set Real) {alpha : Real}
    (halpha : 0 ≤ alpha) : 0 ≤ brrsAssouadLegendreTransform E alpha :=
  halpha.trans (le_brrsAssouadLegendreTransform E alpha)

/-- The one-dimensional spectrum bound forces the BRRS transform to agree
with the identity above the endpoint `α = 1`. -/
theorem brrsAssouadLegendreTransform_eq_id_of_one_le (E : Set Real)
    {alpha : Real} (halpha : 1 ≤ alpha) :
    brrsAssouadLegendreTransform E alpha = alpha := by
  apply le_antisymm
  · rw [brrsAssouadLegendreTransform_eq_restricted]
    apply brrsRestrictedLegendreTransform_le
    · exact ⟨0, by simp⟩
    · intro theta htheta
      have hpotential := brrsAssouadPotential_lower E htheta.1 htheta.2
      have hfactor : 0 ≤ 1 - theta := sub_nonneg.mpr htheta.2
      have hmul : (1 - theta) * 1 ≤ (1 - theta) * alpha :=
        mul_le_mul_of_nonneg_left halpha hfactor
      calc
        theta * alpha - brrsAssouadPotential E theta ≤
            theta * alpha + (1 - theta) := by linarith
        _ = theta * alpha + (1 - theta) * 1 := by ring
        _ ≤ theta * alpha + (1 - theta) * alpha := by gcongr
        _ = alpha := by ring
  · exact le_brrsAssouadLegendreTransform E alpha

/-- The literal entropy definition and the exact-scale spectral transform
agree on their forced affine tail.  This is an unconditional portion of BRRS
Theorem 1.2(i), obtained without the remaining finite-scale comparison
argument. -/
theorem brrsLegendreAssouadFunction_eq_brrsAssouadLegendreTransform_of_nonempty_of_one_le
    {E : Set Real} (hE : E.Nonempty) {alpha : Real} (halpha : 1 ≤ alpha) :
    brrsLegendreAssouadFunction E alpha = brrsAssouadLegendreTransform E alpha := by
  rw [brrsLegendreAssouadFunction_eq_of_nonempty_of_one_le hE halpha,
    brrsAssouadLegendreTransform_eq_id_of_one_le E halpha]

/-! ### The quasi-Assouad affine tail -/

/-- Clamp an arbitrary testing interval of length at most one to an interval
of the same length inside `[1,2]`.  On a radius set contained in `[1,2]`, the
clamped interval contains precisely the portion relevant to the entropy
estimate. -/
private theorem brrs_inter_interval_subset_clamp
    {E : Set Real} (hE : E ⊆ Icc (1 : Real) 2) {a R : Real} :
    E ∩ brrsInterval a R ⊆
      E ∩ Icc (max 1 (min a (2 - R))) (max 1 (min a (2 - R)) + R) := by
  intro x hx
  have hxE := hE hx.1
  simp only [brrsInterval, mem_inter_iff, mem_Icc] at hx ⊢
  refine ⟨hx.1, ?_, ?_⟩
  · apply max_le
    · exact hxE.1
    · exact (min_le_left _ _).trans hx.2.1
  · have hxsub : x - R ≤ min a (2 - R) := by
      apply le_min
      · linarith [hx.2.2]
      · linarith [hxE.2]
    have hmin : min a (2 - R) ≤ max 1 (min a (2 - R)) := le_max_right _ _
    linarith

/-- An upper Assouad-spectrum covering estimate controls the literal
equality-scale BRRS spectrum estimate.  The upper convention tests more
intervals, and the only bookkeeping needed here is the interval clamping
inside the normalized radius range `[1,2]`. -/
theorem HasUpperAssouadSpectrumExponent.toHasBRRSAssouadSpectrumExponent
    {E : Set Real} {theta gamma : Real} (hE : E ⊆ Icc (1 : Real) 2)
    (htheta_zero : 0 ≤ theta)
    (hupper : Auto.FractalDimensions.HasUpperAssouadSpectrumExponent E theta gamma) :
    HasBRRSAssouadSpectrumExponent E theta gamma := by
  rcases hupper with ⟨C, hC, hupper⟩
  refine ⟨C, hC, ?_⟩
  intro delta hdelta hdelta_one a
  have hdelta_real : 0 < (delta : Real) := by exact_mod_cast hdelta
  have hdelta_one_real : (delta : Real) ≤ 1 := by exact_mod_cast hdelta_one.le
  let R : Real := (delta : Real) ^ theta
  have hRpos : 0 < R := by
    dsimp [R]
    exact Real.rpow_pos_of_pos hdelta_real theta
  have hRone : R ≤ 1 := by
    dsimp [R]
    exact Real.rpow_le_one hdelta_real.le hdelta_one_real htheta_zero
  let c : Real := max 1 (min a (2 - R))
  have hc_lower : 1 ≤ c := by
    dsimp [c]
    exact le_max_left _ _
  have hc_upper : c ≤ 2 - R := by
    dsimp [c]
    apply max_le
    · linarith
    · exact min_le_right _ _
  have hc_order : c ≤ c + R := by linarith
  have hc_right : c + R ≤ 2 := by linarith
  obtain ⟨centers, hcenters, hcard⟩ :=
    hupper (delta : Real) c (c + R) hdelta_real (by exact_mod_cast hdelta_one)
      hc_lower hc_order hc_right (by simp [R])
  have hsubset : E ∩ brrsInterval a R ⊆ E ∩ Icc c (c + R) := by
    dsimp only [c]
    exact brrs_inter_interval_subset_clamp hE
  calc
    brrsEntropyNumber (E ∩ brrsInterval a ((delta : Real) ^ theta)) delta =
        brrsEntropyNumber (E ∩ brrsInterval a R) delta := by rfl
    _ ≤ brrsEntropyNumber (E ∩ Icc c (c + R)) delta :=
      brrsEntropyNumber_mono hsubset delta
    _ ≤ (centers.card : ENNReal) := brrsEntropyNumber_le_of_intervalCover hcenters
    _ = ENNReal.ofReal (centers.card : Real) := by simp
    _ ≤ ENNReal.ofReal (C * ((R / (delta : Real)) ^ gamma)) :=
      ENNReal.ofReal_le_ofReal (by
        simpa only [sub_self, add_sub_cancel_left] using hcard)
    _ = ENNReal.ofReal (C * ((((delta : Real) ^ theta) / (delta : Real)) ^ gamma)) := by
      rfl

/-- The equality-scale BRRS spectrum is bounded by the upper Assouad
spectrum.  This is the quantitative bridge from the older quasi-Assouad
development to the literal BRRS entropy convention. -/
theorem brrsAssouadSpectrum_le_upperAssouadSpectrum
    {E : Set Real} (hE : E ⊆ Icc (1 : Real) 2) {theta : Real}
    (htheta_zero : 0 ≤ theta) (htheta_one : theta ≤ 1) :
    brrsAssouadSpectrum E theta ≤ Auto.FractalDimensions.upperAssouadSpectrum E theta := by
  apply le_of_forall_pos_le_add
  intro epsilon hepsilon
  let gamma : Real := Auto.FractalDimensions.upperAssouadSpectrum E theta + epsilon
  have hgamma_pos : 0 < gamma := by
    dsimp [gamma]
    have hnonneg : 0 ≤ Auto.FractalDimensions.upperAssouadSpectrum E theta :=
      Auto.FractalDimensions.upperAssouadSpectrum_nonneg E htheta_one
    linarith
  have hupper : Auto.FractalDimensions.HasUpperAssouadSpectrumExponent E theta gamma :=
    Auto.FractalDimensions.hasUpperAssouadSpectrumExponent_of_upperAssouadSpectrum_lt
      htheta_zero htheta_one (by dsimp [gamma]; linarith)
  unfold brrsAssouadSpectrum
  apply csInf_le
  · refine ⟨0, ?_⟩
    intro q hq
    exact hq.1.le
  · exact ⟨hgamma_pos,
      HasUpperAssouadSpectrumExponent.toHasBRRSAssouadSpectrumExponent
        hE htheta_zero hupper⟩

/-- The quasi-Assouad dimension bounds every literal BRRS spectrum parameter
strictly below the endpoint. -/
theorem brrsAssouadSpectrum_le_quasiAssouadDimension
    {E : Set Real} (hE : E ⊆ Icc (1 : Real) 2) {theta : Real}
    (htheta_zero : 0 ≤ theta) (htheta_lt_one : theta < 1) :
    brrsAssouadSpectrum E theta ≤ Auto.FractalDimensions.quasiAssouadDimension E := by
  calc
    brrsAssouadSpectrum E theta ≤ Auto.FractalDimensions.upperAssouadSpectrum E theta :=
      brrsAssouadSpectrum_le_upperAssouadSpectrum hE htheta_zero htheta_lt_one.le
    _ ≤ Auto.FractalDimensions.quasiAssouadDimension E := by
      unfold Auto.FractalDimensions.quasiAssouadDimension
      apply le_csSup
      · refine ⟨1, ?_⟩
        rintro _ ⟨u, hu, rfl⟩
        exact Auto.FractalDimensions.upperAssouadSpectrum_le_one E hu.2.le
      · exact ⟨theta, ⟨htheta_zero, htheta_lt_one⟩, rfl⟩

/-- Above the quasi-Assouad threshold, the BRRS spectral transform is exactly
the identity.  This is the affine-tail input used in the high-`p`
interpolation argument. -/
theorem brrsAssouadLegendreTransform_eq_id_of_quasiAssouadDimension_le
    {E : Set Real} (hE : E ⊆ Icc (1 : Real) 2) {alpha : Real}
    (halpha : Auto.FractalDimensions.quasiAssouadDimension E ≤ alpha) :
    brrsAssouadLegendreTransform E alpha = alpha := by
  apply le_antisymm
  · rw [brrsAssouadLegendreTransform_eq_restricted]
    apply brrsRestrictedLegendreTransform_le
    · exact ⟨0, by simp⟩
    · intro theta htheta
      by_cases htheta_one : theta = 1
      · subst theta
        simp [brrsAssouadPotential]
      · have htheta_lt : theta < 1 := lt_of_le_of_ne htheta.2 htheta_one
        have hspectrum : brrsAssouadSpectrum E theta ≤ alpha :=
          (brrsAssouadSpectrum_le_quasiAssouadDimension hE htheta.1 htheta_lt).trans halpha
        have hfactor : 0 ≤ 1 - theta := sub_nonneg.mpr htheta.2
        rw [brrsAssouadPotential, if_neg htheta_one]
        calc
          theta * alpha - (-(1 - theta) * brrsAssouadSpectrum E theta) =
              theta * alpha + (1 - theta) * brrsAssouadSpectrum E theta := by ring
          _ ≤ theta * alpha + (1 - theta) * alpha := by gcongr
          _ = alpha := by ring
  · exact le_brrsAssouadLegendreTransform E alpha

/-- The literal entropy exponent has the same quasi-Assouad identity tail. -/
theorem brrsLegendreAssouadFunction_eq_id_of_nonempty_of_quasiAssouadDimension_le
    {E : Set Real} (hE : E.Nonempty) (hsubset : E ⊆ Icc (1 : Real) 2)
    {alpha : Real} (halpha : Auto.FractalDimensions.quasiAssouadDimension E ≤ alpha) :
    brrsLegendreAssouadFunction E alpha = alpha := by
  rw [brrsLegendreAssouadFunction_eq_brrsAssouadLegendreTransform_of_nonempty hE]
  exact brrsAssouadLegendreTransform_eq_id_of_quasiAssouadDimension_le hsubset halpha

/-- Independently of the quasi-Assouad value, every nonnegative penalty at
most one has BRRS Legendre--Assouad value at most one.  This is the robust
endpoint fallback for interpolation. -/
theorem brrsAssouadLegendreTransform_le_one_of_nonneg_of_le_one
    (E : Set Real) {alpha : Real} (_halpha_nonneg : 0 ≤ alpha)
    (halpha_one : alpha ≤ 1) :
    brrsAssouadLegendreTransform E alpha ≤ 1 := by
  rw [brrsAssouadLegendreTransform_eq_restricted]
  apply brrsRestrictedLegendreTransform_le
  · exact ⟨0, by simp⟩
  · intro theta htheta
    by_cases htheta_one : theta = 1
    · subst theta
      simp [brrsAssouadPotential, halpha_one]
    · have hspectrum : brrsAssouadSpectrum E theta ≤ 1 :=
        brrsAssouadSpectrum_le_one E htheta.2
      have htheta_nonneg : 0 ≤ theta := htheta.1
      have hfactor : 0 ≤ 1 - theta := sub_nonneg.mpr htheta.2
      rw [brrsAssouadPotential, if_neg htheta_one]
      calc
        theta * alpha - (-(1 - theta) * brrsAssouadSpectrum E theta) =
            theta * alpha + (1 - theta) * brrsAssouadSpectrum E theta := by ring
        _ ≤ theta * 1 + (1 - theta) * 1 := by gcongr
        _ = 1 := by ring

/-- The universal `ν_E^♯(α) ≤ 1` fallback in the literal entropy convention. -/
theorem brrsLegendreAssouadFunction_le_one_of_nonempty_of_nonneg_of_le_one
    {E : Set Real} (hE : E.Nonempty) {alpha : Real} (halpha_nonneg : 0 ≤ alpha)
    (halpha_one : alpha ≤ 1) : brrsLegendreAssouadFunction E alpha ≤ 1 := by
  rw [brrsLegendreAssouadFunction_eq_brrsAssouadLegendreTransform_of_nonempty hE]
  exact brrsAssouadLegendreTransform_le_one_of_nonneg_of_le_one E halpha_nonneg halpha_one

/-- The analytic-free direction of BRRS Theorem 1.2(ii): once a function is
identified with a BRRS Legendre transform on nonnegative parameters, the
required increasing, convex, and eventual-identity structure follows from
the transform itself.  The entropy/spectrum equality of Theorem 1.2(i) is
kept as the explicit hypothesis here. -/
theorem isBRRSLegendreAssouadProfile_of_transform_representation
    {E : Set Real} {tau : Real → Real}
    (hsharp : ∀ alpha : Real,
      brrsLegendreAssouadFunction E alpha = brrsAssouadLegendreTransform E alpha)
    (hrepresentation : ∀ alpha : Real, 0 ≤ alpha →
      brrsLegendreAssouadFunction E alpha = tau alpha) :
    IsBRRSLegendreAssouadProfile tau := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro alpha halpha
    rw [← hrepresentation alpha halpha, hsharp]
    exact brrsAssouadLegendreTransform_nonneg E halpha
  · intro alpha halpha beta hbeta hab
    rw [← hrepresentation alpha halpha, ← hrepresentation beta hbeta,
      hsharp, hsharp]
    exact brrsAssouadLegendreTransform_mono E hab
  · constructor
    · exact convex_Ici (0 : Real)
    · intro x hx y hy a b ha hb hab
      change tau (a * x + b * y) ≤ a * tau x + b * tau y
      have hxy : 0 ≤ a * x + b * y :=
        add_nonneg (mul_nonneg ha hx) (mul_nonneg hb hy)
      rw [← hrepresentation (a * x + b * y) hxy,
        ← hrepresentation x hx, ← hrepresentation y hy,
        hsharp, hsharp, hsharp]
      exact (brrsAssouadLegendreTransform_convex E).2
        (by simp) (by simp) ha hb hab
  · intro alpha halpha
    rw [← hrepresentation alpha (zero_le_one.trans halpha), hsharp]
    exact brrsAssouadLegendreTransform_eq_id_of_one_le E halpha

/-- The ``only if'' direction of BRRS Theorem 1.2(ii) is now unconditional:
any literal BRRS realization has the required increasing, convex, and
identity-tail profile.  This uses the completed exact entropy/spectrum
identity from Part (i), rather than treating it as a hypothesis. -/
theorem brrsTheoremOnePointTwoPartTwo_only_if
    {tau : Real → Real}
    (hrealization : ∃ E : Set Real, E.Nonempty ∧ Bornology.IsBounded E ∧
      ∀ alpha : Real, 0 ≤ alpha →
        brrsLegendreAssouadFunction E alpha = tau alpha) :
    IsBRRSLegendreAssouadProfile tau := by
  rcases hrealization with ⟨E, hE, _hbounded, hrepresentation⟩
  exact isBRRSLegendreAssouadProfile_of_transform_representation
    (brrsLegendreAssouadFunction_eq_brrsAssouadLegendreTransform_of_nonempty hE)
    hrepresentation

/-- The two monotonicity requirements in Rutar's admissibility condition
give the basic two-sided weighted scale inequality. -/
theorem IsRutarAssouadSpectrum.weighted_parameter_bounds
    {gamma : Real → Real} (hgamma : IsRutarAssouadSpectrum gamma)
    {theta eta : Real} (htheta : theta ∈ Ioo (0 : Real) 1)
    (heta : eta ∈ Ioo (0 : Real) 1) (htheta_eta : theta ≤ eta) :
    (1 - eta) * gamma eta ≤ (1 - theta) * gamma theta ∧
      (1 - theta) * gamma theta ≤
        (1 - eta) * gamma eta + (eta - theta) := by
  have hmono := hgamma.2.1 htheta heta htheta_eta
  have hpotential := hgamma.2.2 htheta heta htheta_eta
  have htheta_le_one := (hgamma.1 theta htheta).2
  have hfactor : 0 ≤ 1 - eta := sub_nonneg.mpr heta.2.le
  have hgap : 0 ≤ eta - theta := sub_nonneg.mpr htheta_eta
  constructor
  · calc
      (1 - eta) * gamma eta = - (-(1 - eta) * gamma eta) := by ring
      _ ≤ - (-(1 - theta) * gamma theta) := neg_le_neg hpotential
      _ = (1 - theta) * gamma theta := by ring
  · have hfirst : (1 - eta) * gamma theta ≤ (1 - eta) * gamma eta :=
      mul_le_mul_of_nonneg_left hmono hfactor
    have hsecond : (eta - theta) * gamma theta ≤ eta - theta := by
      simpa using mul_le_mul_of_nonneg_left htheta_le_one hgap
    calc
      (1 - theta) * gamma theta =
          (1 - eta) * gamma theta + (eta - theta) * gamma theta := by ring
      _ ≤ (1 - eta) * gamma eta + (eta - theta) :=
        add_le_add hfirst hsecond

/-- The monotone case of Rutar's full Assouad-spectrum admissibility
inequality.  The right-hand side is the scale-composition constraint in
Rutar's Theorem 1.1; for an increasing spectrum it follows directly from
monotonicity.  Recording it separately exposes the precise input needed by
the variable-ratio Moran construction. -/
theorem IsRutarAssouadSpectrum.assouadSpectrumConstraints
    {gamma : Real → Real} (hgamma : IsRutarAssouadSpectrum gamma)
    {lambda theta : Real} (hlambda : lambda ∈ Ioo (0 : Real) 1)
    (htheta : theta ∈ Ioo (0 : Real) 1) (hlambda_theta : lambda < theta) :
    0 ≤ (1 - lambda) * gamma lambda - (1 - theta) * gamma theta ∧
      (1 - lambda) * gamma lambda - (1 - theta) * gamma theta ≤
        (theta - lambda) * gamma (lambda / theta) := by
  have hpotential := hgamma.2.2 hlambda htheta hlambda_theta.le
  have hweight :
      (1 - theta) * gamma theta ≤ (1 - lambda) * gamma lambda := by
    calc
      (1 - theta) * gamma theta = - (-(1 - theta) * gamma theta) := by ring
      _ ≤ - (-(1 - lambda) * gamma lambda) := neg_le_neg hpotential
      _ = (1 - lambda) * gamma lambda := by ring
  have hratio : lambda / theta ∈ Ioo (0 : Real) 1 := by
    constructor
    · exact div_pos hlambda.1 htheta.1
    · exact (div_lt_one₀ htheta.1).2 hlambda_theta
  have hratio_lower : lambda ≤ lambda / theta := by
    apply (le_div_iff₀ htheta.1).2
    exact mul_le_of_le_one_right hlambda.1.le htheta.2.le
  constructor
  · exact sub_nonneg.mpr hweight
  · have hlambda_theta_gamma : gamma lambda ≤ gamma theta :=
      hgamma.2.1 hlambda htheta hlambda_theta.le
    have hreplace_theta :
        (1 - lambda) * gamma lambda - (1 - theta) * gamma theta ≤
          (theta - lambda) * gamma theta := by
      have hmul : (1 - lambda) * gamma lambda ≤
          (1 - lambda) * gamma theta :=
        mul_le_mul_of_nonneg_left hlambda_theta_gamma
          (sub_nonneg.mpr hlambda.2.le)
      calc
        (1 - lambda) * gamma lambda - (1 - theta) * gamma theta ≤
            (1 - lambda) * gamma theta - (1 - theta) * gamma theta :=
              sub_le_sub_right hmul _
        _ = (theta - lambda) * gamma theta := by ring
    rcases le_total theta (lambda / theta) with htheta_ratio | hratio_theta
    · calc
        (1 - lambda) * gamma lambda - (1 - theta) * gamma theta ≤
            (theta - lambda) * gamma theta := hreplace_theta
        _ ≤ (theta - lambda) * gamma (lambda / theta) :=
          mul_le_mul_of_nonneg_left (hgamma.2.1 htheta hratio htheta_ratio)
            (sub_nonneg.mpr hlambda_theta.le)
    · have hlambda_ratio_gamma : gamma lambda ≤ gamma (lambda / theta) :=
        hgamma.2.1 hlambda hratio hratio_lower
      have hmul : (1 - lambda) * gamma lambda ≤
          (1 - lambda) * gamma (lambda / theta) :=
        mul_le_mul_of_nonneg_left hlambda_ratio_gamma
          (sub_nonneg.mpr hlambda.2.le)
      calc
        (1 - lambda) * gamma lambda - (1 - theta) * gamma theta ≤
            (1 - lambda) * gamma (lambda / theta) -
              (1 - theta) * gamma theta :=
              sub_le_sub_right hmul _
        _ ≤ (1 - lambda) * gamma (lambda / theta) -
              (1 - theta) * gamma (lambda / theta) := by
            apply sub_le_sub_left
            exact mul_le_mul_of_nonneg_left
              (hgamma.2.1 hratio htheta hratio_theta)
              (sub_nonneg.mpr htheta.2.le)
        _ = (theta - lambda) * gamma (lambda / theta) := by ring

/-- The full interval-scale compatibility condition in Rutar's spectrum
classification.  Unlike `IsRutarAssouadSpectrum`, this formulation does not
assume monotonicity; it is the exact input for the variable-ratio Moran
realization theorem. -/
def IsRutarAdmissible (gamma : Real → Real) : Prop :=
  (∀ theta : Real, theta ∈ Ioo (0 : Real) 1 →
    0 ≤ gamma theta ∧ gamma theta ≤ 1) ∧
    ∀ {lambda theta : Real}, lambda ∈ Ioo (0 : Real) 1 →
      theta ∈ Ioo (0 : Real) 1 → lambda < theta →
        0 ≤ (1 - lambda) * gamma lambda - (1 - theta) * gamma theta ∧
          (1 - lambda) * gamma lambda - (1 - theta) * gamma theta ≤
            (theta - lambda) * gamma (lambda / theta)

/-- Rutar's logarithmic-coordinate potential.  The change of variables
`theta = exp (-y)` turns the scale-composition constraint into the increment
estimate used in the variable-ratio Moran construction. -/
def rutarXi (gamma : Real → Real) (y : Real) : Real :=
  (1 - Real.exp (-y)) * gamma (Real.exp (-y))

/-- The exact logarithmic increment form of Rutar's admissibility condition
(equation (13) in the realization construction). -/
theorem IsRutarAdmissible.rutarXi_increment_bounds
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma)
    {y₁ y₂ : Real} (hy₁ : 0 < y₁) (hy₁₂ : y₁ < y₂) :
    0 ≤ rutarXi gamma y₂ - rutarXi gamma y₁ ∧
      rutarXi gamma y₂ - rutarXi gamma y₁ ≤
        Real.exp (-y₁) * rutarXi gamma (y₂ - y₁) := by
  have hy₂ : 0 < y₂ := hy₁.trans hy₁₂
  have hlambda : Real.exp (-y₂) ∈ Ioo (0 : Real) 1 :=
    ⟨Real.exp_pos _, Real.exp_lt_one_iff.mpr (by linarith)⟩
  have htheta : Real.exp (-y₁) ∈ Ioo (0 : Real) 1 :=
    ⟨Real.exp_pos _, Real.exp_lt_one_iff.mpr (by linarith)⟩
  have hlambda_theta : Real.exp (-y₂) < Real.exp (-y₁) :=
    Real.exp_lt_exp.mpr (by linarith)
  have hconstraint := hgamma.2 hlambda htheta hlambda_theta
  have hratio : Real.exp (-y₂) / Real.exp (-y₁) =
      Real.exp (-(y₂ - y₁)) := by
    rw [← Real.exp_sub]
    congr 1
    ring
  have hprod : Real.exp (-y₁) * Real.exp (-(y₂ - y₁)) =
      Real.exp (-y₂) := by
    rw [← Real.exp_add]
    congr 1
    ring
  constructor
  · simpa [rutarXi] using hconstraint.1
  · calc
      rutarXi gamma y₂ - rutarXi gamma y₁ ≤
          (Real.exp (-y₁) - Real.exp (-y₂)) *
            gamma (Real.exp (-y₂) / Real.exp (-y₁)) := by
              simpa [rutarXi] using hconstraint.2
      _ = Real.exp (-y₁) * rutarXi gamma (y₂ - y₁) := by
        rw [hratio, rutarXi, ← hprod]
        ring

/-- The one-sided version of Rutar's class `\mathcal G(λ, α)`, sufficient for
the positive logarithmic scales used in the Moran construction. -/
def IsRutarGOn (g : Real → Real) (lower upper : Real) : Prop :=
  ∀ ⦃y t : Real⦄, 0 < y → 0 < t →
    lower - (lower - g y) * Real.exp (-t) ≤ g (y + t) ∧
      g (y + t) ≤ upper - (upper - g y) * Real.exp (-t)

/-- The logarithmic potential is nonnegative and has the elementary sharp
upper bound supplied by the ambient one-dimensional constraint. -/
theorem IsRutarAdmissible.rutarXi_nonneg_le_one_sub_exp
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma)
    {y : Real} (hy : 0 < y) :
    0 ≤ rutarXi gamma y ∧ rutarXi gamma y ≤ 1 - Real.exp (-y) := by
  have htheta : Real.exp (-y) ∈ Ioo (0 : Real) 1 :=
    ⟨Real.exp_pos _, Real.exp_lt_one_iff.mpr (by linarith)⟩
  have hgamma_range := hgamma.1 _ htheta
  have hfactor : 0 ≤ 1 - Real.exp (-y) :=
    sub_nonneg.mpr htheta.2.le
  constructor
  · exact mul_nonneg hfactor hgamma_range.1
  · unfold rutarXi
    calc
      (1 - Real.exp (-y)) * gamma (Real.exp (-y)) ≤
          (1 - Real.exp (-y)) * 1 :=
        mul_le_mul_of_nonneg_left hgamma_range.2 hfactor
      _ = 1 - Real.exp (-y) := by ring

/-- Rutar admissibility supplies the differential inequalities defining the
logarithmic Moran-profile class.  This is the analytic input to the ratio
rounding lemma in the realization proof. -/
theorem IsRutarAdmissible.rutarXi_isRutarGOn
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma) :
    IsRutarGOn (rutarXi gamma) 0 1 := by
  intro y t hy ht
  have hxi_y := hgamma.rutarXi_nonneg_le_one_sub_exp hy
  have hxi_t := hgamma.rutarXi_nonneg_le_one_sub_exp ht
  have hinc_forward := hgamma.rutarXi_increment_bounds hy (by linarith : y < y + t)
  have hinc_shift := hgamma.rutarXi_increment_bounds ht (by linarith : t < t + y)
  have hinc_shift' : rutarXi gamma (t + y) - rutarXi gamma t ≤
      Real.exp (-t) * rutarXi gamma y := by
    convert hinc_shift.2 using 1; ring
  have hexp_le_one : Real.exp (-t) ≤ 1 :=
    Real.exp_le_one_iff.mpr (by linarith)
  constructor
  · calc
      0 - (0 - rutarXi gamma y) * Real.exp (-t) =
          rutarXi gamma y * Real.exp (-t) := by ring
      _ ≤ rutarXi gamma y :=
        mul_le_of_le_one_right hxi_y.1 hexp_le_one
      _ ≤ rutarXi gamma (y + t) := by linarith [hinc_forward.1]
  · calc
      rutarXi gamma (y + t) = rutarXi gamma (t + y) := by congr 1; ring
      _ ≤ rutarXi gamma t + Real.exp (-t) * rutarXi gamma y := by
        linarith [hinc_shift']
      _ ≤ (1 - Real.exp (-t)) + Real.exp (-t) * rutarXi gamma y := by
        simpa [add_comm] using
          add_le_add_right hxi_t.2 (Real.exp (-t) * rutarXi gamma y)
      _ = 1 - (1 - rutarXi gamma y) * Real.exp (-t) := by ring

/-- The interval-scale compatibility condition also makes the logarithmic
Rutar potential one-Lipschitz on positive scales.  Thus no separate
regularity assumption on the admissible spectrum is needed for the
continuous ratio-rounding construction. -/
theorem IsRutarAdmissible.rutarXi_lipschitzOn
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma) :
    LipschitzOnWith 1 (rutarXi gamma) (Ioi (0 : Real)) := by
  refine LipschitzOnWith.of_dist_le_mul fun x hx y hy => ?_
  have hforward : ∀ {u v : Real}, u ≤ v → u ∈ Ioi (0 : Real) →
      v ∈ Ioi (0 : Real) →
      dist (rutarXi gamma u) (rutarXi gamma v) ≤ dist u v := by
    intro u v huv hu hv
    rcases lt_or_eq_of_le huv with huvlt | rfl
    · let t : Real := v - u
      have ht : 0 < t := by dsimp [t]; linarith
      have hinc := hgamma.rutarXi_increment_bounds hu huvlt
      have hinc_nonneg : 0 ≤ rutarXi gamma v - rutarXi gamma u := by
        convert hinc.1 using 1
      have hinc_le : rutarXi gamma v - rutarXi gamma u ≤
          Real.exp (-u) * rutarXi gamma t := by
        convert hinc.2 using 1
      have hxi := hgamma.rutarXi_nonneg_le_one_sub_exp ht
      have hu0 : 0 < u := hu
      have hexp : Real.exp (-u) ≤ 1 :=
        Real.exp_le_one_iff.mpr (by linarith)
      have hprod : Real.exp (-u) * rutarXi gamma t ≤ rutarXi gamma t := by
        calc
          Real.exp (-u) * rutarXi gamma t =
              rutarXi gamma t * Real.exp (-u) := by ring
          _ ≤ rutarXi gamma t :=
            mul_le_of_le_one_right hxi.1 hexp
      have hlinear : 1 - Real.exp (-t) ≤ t := by
        have h := Real.add_one_le_exp (-t)
        linarith
      have hdiff : rutarXi gamma v - rutarXi gamma u ≤ t :=
        hinc_le.trans (hprod.trans (hxi.2.trans hlinear))
      rw [Real.dist_eq, Real.dist_eq]
      rw [abs_of_nonpos (by linarith [hinc_nonneg]),
        abs_of_nonpos (sub_nonpos.mpr huv)]
      dsimp [t] at hdiff
      linarith
    · simp
  rcases le_total x y with hxy | hyx
  · simpa only [NNReal.coe_one, one_mul] using hforward hxy hx hy
  · simpa only [NNReal.coe_one, one_mul, dist_comm] using hforward hyx hy hx

/-- In particular, every admissible Rutar potential is continuous on the
positive logarithmic half-line. -/
theorem IsRutarAdmissible.rutarXi_continuousOn
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma) :
    ContinuousOn (rutarXi gamma) (Ioi (0 : Real)) :=
  hgamma.rutarXi_lipschitzOn.continuousOn

/-- The increasing/decreasing-potential hypotheses in Rutar's Corollary B
imply the full scale-composition admissibility condition. -/
theorem IsRutarAssouadSpectrum.toIsRutarAdmissible
    {gamma : Real → Real} (hgamma : IsRutarAssouadSpectrum gamma) :
    IsRutarAdmissible gamma := by
  refine ⟨hgamma.1, ?_⟩
  intro lambda theta hlambda htheta hlambda_theta
  exact hgamma.assouadSpectrumConstraints hlambda htheta hlambda_theta

/-- The hypotheses occurring in BRRS Theorem 1.2(ii) therefore yield the
logarithmic profile class used in Rutar's Moran realization. -/
theorem IsRutarAssouadSpectrum.rutarXi_isRutarGOn
    {gamma : Real → Real} (hgamma : IsRutarAssouadSpectrum gamma) :
    IsRutarGOn (rutarXi gamma) 0 1 :=
  hgamma.toIsRutarAdmissible.rutarXi_isRutarGOn

/-- A finite `len`-separated subset of an interval of length `2 * len` has
at most three elements.  Keeping this elementary packing fact here avoids a
dependency on the RS maximal-function development and is the local-cylinder
count in the Moran realization. -/
theorem card_le_three_of_separated_in_interval {S : Finset Real} {s len : Real}
    (hlen : 0 < len) (hsub : ∀ x ∈ S, x ∈ Icc s (s + 2 * len))
    (hsep : ∀ x ∈ S, ∀ y ∈ S, x ≠ y → len ≤ |x - y|) : S.card ≤ 3 := by
  classical
  have hcard : S.card ≤ (Finset.Icc (0 : Int) 2).card := by
    refine Finset.card_le_card_of_injOn (fun x => ⌊(x - s) / len⌋) ?_ ?_
    · intro x hx
      obtain ⟨h1, h2⟩ := hsub x hx
      have hq0 : (0 : Real) ≤ (x - s) / len := by
        apply div_nonneg (by linarith) hlen.le
      have hq2 : (x - s) / len ≤ 2 := by
        rw [div_le_iff₀ hlen]
        linarith
      refine Finset.mem_Icc.mpr ⟨?_, ?_⟩
      · exact Int.le_floor.mpr (by simpa using hq0)
      · have hfl := Int.floor_le_floor hq2
        simpa using hfl
    · intro x hx y hy hxy
      by_contra hne
      have hfx : ((⌊(x - s) / len⌋ : Int) : Real) ≤ (x - s) / len :=
        Int.floor_le _
      have hfy : ((⌊(y - s) / len⌋ : Int) : Real) ≤ (y - s) / len :=
        Int.floor_le _
      have hfx' : (x - s) / len < ((⌊(x - s) / len⌋ : Int) : Real) + 1 :=
        Int.lt_floor_add_one _
      have hfy' : (y - s) / len < ((⌊(y - s) / len⌋ : Int) : Real) + 1 :=
        Int.lt_floor_add_one _
      have hxy' : ⌊(x - s) / len⌋ = ⌊(y - s) / len⌋ := hxy
      rw [hxy'] at hfx hfx'
      have hdiff : |(x - s) / len - (y - s) / len| < 1 := by
        rw [abs_lt]
        constructor <;> linarith
      have hlenne : len ≠ 0 := hlen.ne'
      have hxydiv : (x - s) / len - (y - s) / len = (x - y) / len := by
        field_simp
        ring
      rw [hxydiv, abs_div, abs_of_pos hlen, div_lt_one hlen] at hdiff
      exact absurd (hsep x hx y hy hne) (not_le.mpr hdiff)
  simpa using hcard

/-! ### Explicit Rutar blocks -/

/-- The Rutar logarithmic potential vanishes at the endpoint of its positive
scale coordinate. -/
theorem rutarXi_zero (gamma : Real → Real) : rutarXi gamma 0 = 0 := by
  simp [rutarXi]

/-- A genuinely positive spectrum value gives a genuinely positive Rutar
potential at its logarithmic coordinate.  This is the seed used to make the
logarithmic mass of an infinite block concatenation unbounded. -/
theorem rutarXi_pos_of_gamma_pos {gamma : Real → Real} {theta : Real}
    (htheta : theta ∈ Ioo (0 : Real) 1) (hgamma : 0 < gamma theta) :
    0 < rutarXi gamma (-Real.log theta) := by
  unfold rutarXi
  have hexp : Real.exp (-(-Real.log theta)) = theta := by
    rw [neg_neg, Real.exp_log htheta.1]
  rw [hexp]
  exact mul_pos (sub_pos.mpr htheta.2) hgamma

/-- The preceding positivity statement also provides a positive logarithmic
block length at which the Rutar potential is nonzero. -/
theorem exists_rutarXi_pos_of_gamma_pos {gamma : Real → Real} {theta : Real}
    (htheta : theta ∈ Ioo (0 : Real) 1) (hgamma : 0 < gamma theta) :
    ∃ y : Real, 0 < y ∧ 0 < rutarXi gamma y := by
  refine ⟨-Real.log theta, ?_, rutarXi_pos_of_gamma_pos htheta hgamma⟩
  exact neg_pos.mpr (Real.log_neg htheta.1 htheta.2)

/-- The offsets joining the active `xi` blocks in Rutar's construction.
At block `n` the active piece has length `n + 1`; the intervening bridge has
the same length and is a pure exponential. -/
noncomputable def rutarBlockOffset (gamma : Real → Real) : Nat → Real
  | 0 => 0
  | n + 1 =>
      Real.exp (-((n + 1 : Nat) : Real)) *
          rutarXi gamma ((n + 1 : Nat) : Real) +
        (Real.exp (-((n + 1 : Nat) : Real))) ^ 2 * rutarBlockOffset gamma n

/-- The active segment in the `n`th Rutar block. -/
noncomputable def rutarForwardBlock (gamma : Real → Real) (n : Nat) (y : Real) : Real :=
  rutarXi gamma y + Real.exp (-y) * rutarBlockOffset gamma n

/-- The bridge amplitude is the terminal value of its preceding active
segment. -/
noncomputable def rutarBridgeAmplitude (gamma : Real → Real) (n : Nat) : Real :=
  rutarForwardBlock gamma n ((n + 1 : Nat) : Real)

/-- The purely exponential bridge following an active Rutar block. -/
noncomputable def rutarBridgeBlock (gamma : Real → Real) (n : Nat) (y : Real) : Real :=
  Real.exp (-y) * rutarBridgeAmplitude gamma n

/-- The active segment and its bridge meet continuously. -/
theorem rutarForwardBlock_end_eq_rutarBridgeBlock_start
    (gamma : Real → Real) (n : Nat) :
    rutarForwardBlock gamma n ((n + 1 : Nat) : Real) =
      rutarBridgeBlock gamma n 0 := by
  simp [rutarBridgeBlock, rutarBridgeAmplitude]

/-- The recurrence defining the offsets is exactly the second endpoint
matching condition in the concatenation. -/
theorem rutarBlockOffset_succ_eq_rutarBridgeBlock_end
    (gamma : Real → Real) (n : Nat) :
    rutarBlockOffset gamma (n + 1) =
      rutarBridgeBlock gamma n ((n + 1 : Nat) : Real) := by
  simp only [rutarBlockOffset, rutarBridgeBlock, rutarBridgeAmplitude,
    rutarForwardBlock]
  ring

/-- Consecutive bridge and active pieces meet continuously. -/
theorem rutarBridgeBlock_end_eq_rutarForwardBlock_next_start
    (gamma : Real → Real) (n : Nat) :
    rutarBridgeBlock gamma n ((n + 1 : Nat) : Real) =
      rutarForwardBlock gamma (n + 1) 0 := by
  rw [← rutarBlockOffset_succ_eq_rutarBridgeBlock_end]
  simp [rutarForwardBlock, rutarXi_zero]

/-- The joining offsets remain nonnegative for every admissible spectrum. -/
theorem rutarBlockOffset_nonneg {gamma : Real → Real}
    (hgamma : IsRutarAdmissible gamma) (n : Nat) :
    0 ≤ rutarBlockOffset gamma n := by
  induction n with
  | zero => simp [rutarBlockOffset]
  | succ n ih =>
      have hn : 0 < ((n + 1 : Nat) : Real) := by positivity
      have hxi := hgamma.rutarXi_nonneg_le_one_sub_exp hn
      simp only [rutarBlockOffset]
      exact add_nonneg
        (mul_nonneg (Real.exp_nonneg _) hxi.1)
        (mul_nonneg (sq_nonneg _) ih)

/-- The joining offsets stay below the ambient one-dimensional bound. -/
theorem rutarBlockOffset_le_one {gamma : Real → Real}
    (hgamma : IsRutarAdmissible gamma) (n : Nat) :
    rutarBlockOffset gamma n ≤ 1 := by
  induction n with
  | zero => simp [rutarBlockOffset]
  | succ n ih =>
      let N : Real := ((n + 1 : Nat) : Real)
      have hN : 0 < N := by dsimp [N]; positivity
      have hxi := hgamma.rutarXi_nonneg_le_one_sub_exp hN
      have ha : 0 ≤ Real.exp (-N) := Real.exp_nonneg _
      have ha_one : Real.exp (-N) ≤ 1 :=
        Real.exp_le_one_iff.mpr (by
          dsimp [N]
          exact neg_nonpos.mpr (by positivity))
      have hsq : (Real.exp (-N)) ^ 2 ≤ Real.exp (-N) := by
        nlinarith [sq_nonneg (Real.exp (-N) - 1)]
      change Real.exp (-N) * rutarXi gamma N +
          (Real.exp (-N)) ^ 2 * rutarBlockOffset gamma n ≤ 1
      calc
        Real.exp (-N) * rutarXi gamma N +
            (Real.exp (-N)) ^ 2 * rutarBlockOffset gamma n ≤
            Real.exp (-N) * (1 - Real.exp (-N)) +
              (Real.exp (-N)) ^ 2 * 1 := by
                apply add_le_add
                · exact mul_le_mul_of_nonneg_left hxi.2 ha
                · exact mul_le_mul_of_nonneg_left ih (sq_nonneg _)
        _ = Real.exp (-N) := by ring
        _ ≤ 1 := ha_one

/-- Every active Rutar block stays in the ambient interval `[0,1]`. -/
theorem rutarForwardBlock_nonneg_le_one {gamma : Real → Real}
    (hgamma : IsRutarAdmissible gamma) (n : Nat) {y : Real} (hy : 0 < y) :
    0 ≤ rutarForwardBlock gamma n y ∧ rutarForwardBlock gamma n y ≤ 1 := by
  have hxi := hgamma.rutarXi_nonneg_le_one_sub_exp hy
  have hz0 := rutarBlockOffset_nonneg hgamma n
  have hz1 := rutarBlockOffset_le_one hgamma n
  have he : 0 ≤ Real.exp (-y) := Real.exp_nonneg _
  constructor
  · exact add_nonneg hxi.1 (mul_nonneg he hz0)
  · calc
      rutarForwardBlock gamma n y =
          rutarXi gamma y + Real.exp (-y) * rutarBlockOffset gamma n := rfl
      _ ≤ (1 - Real.exp (-y)) + Real.exp (-y) * 1 := by
        apply add_le_add
        · exact hxi.2
        · exact mul_le_mul_of_nonneg_left hz1 he
      _ = 1 := by ring

/-- On an active Rutar block, the exponential offset cancels in the
rescaled increment. -/
theorem rutarForwardBlock_rescaled_increment
    (gamma : Real → Real) (n : Nat) (y t : Real) :
    rutarForwardBlock gamma n (y + t) -
        Real.exp (-t) * rutarForwardBlock gamma n y =
      rutarXi gamma (y + t) - Real.exp (-t) * rutarXi gamma y := by
  have hexp : Real.exp (-(y + t)) = Real.exp (-t) * Real.exp (-y) := by
    rw [← Real.exp_add]
    congr 1
    ring
  unfold rutarForwardBlock
  rw [hexp]
  ring

/-- Equation (13), with its two variables interchanged, is the upper
rescaled-increment estimate required on every active block. -/
theorem IsRutarAdmissible.rutarXi_rescaled_increment_le
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma)
    {y t : Real} (hy : 0 < y) (ht : 0 < t) :
    rutarXi gamma (y + t) - Real.exp (-t) * rutarXi gamma y ≤
      rutarXi gamma t := by
  have hinc := hgamma.rutarXi_increment_bounds ht (by linarith : t < t + y)
  have hinc' : rutarXi gamma (y + t) - rutarXi gamma t ≤
      Real.exp (-t) * rutarXi gamma y := by
    convert hinc.2 using 1 <;> ring
  linarith

/-- The Rutar potential satisfies the two semigroup bounds also when one of
the local coordinates is zero.  This closed-endpoint form is what permits
the active and bridge pieces to be glued without losing the spectrum
inequality at a join. -/
theorem IsRutarAdmissible.rutarXi_rescaled_increment_bounds_closed
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma)
    {y t : Real} (hy : 0 ≤ y) (ht : 0 ≤ t) :
    rutarXi gamma y * Real.exp (-t) ≤ rutarXi gamma (y + t) ∧
      rutarXi gamma (y + t) ≤
        1 - (1 - rutarXi gamma y) * Real.exp (-t) := by
  by_cases hyzero : y = 0
  · subst y
    rcases eq_or_lt_of_le ht with rfl | ht
    · simp [rutarXi_zero]
    · have hxi := hgamma.rutarXi_nonneg_le_one_sub_exp ht
      constructor
      · simpa [rutarXi_zero] using hxi.1
      · simpa [rutarXi_zero] using hxi.2
  by_cases htzero : t = 0
  · subst t
    simp
  have hypos : 0 < y := lt_of_le_of_ne hy (Ne.symm hyzero)
  have htpos : 0 < t := lt_of_le_of_ne ht (Ne.symm htzero)
  have hxi_y := hgamma.rutarXi_nonneg_le_one_sub_exp hypos
  have hxi_t := hgamma.rutarXi_nonneg_le_one_sub_exp htpos
  have hinc := hgamma.rutarXi_increment_bounds hypos (by linarith : y < y + t)
  have hexp : Real.exp (-t) ≤ 1 :=
    Real.exp_le_one_iff.mpr (by linarith)
  have hmul : rutarXi gamma y * Real.exp (-t) ≤ rutarXi gamma y :=
    mul_le_of_le_one_right hxi_y.1 hexp
  constructor
  · calc
      rutarXi gamma y * Real.exp (-t) ≤ rutarXi gamma y := hmul
      _ ≤ rutarXi gamma (y + t) := by linarith [hinc.1]
  · have hup := hgamma.rutarXi_rescaled_increment_le hypos htpos
    calc
      rutarXi gamma (y + t) =
          (rutarXi gamma (y + t) - Real.exp (-t) * rutarXi gamma y) +
            Real.exp (-t) * rutarXi gamma y := by ring
      _ ≤ rutarXi gamma t + Real.exp (-t) * rutarXi gamma y :=
        by simpa [add_comm] using
          add_le_add_left hup (Real.exp (-t) * rutarXi gamma y)
      _ ≤ (1 - Real.exp (-t)) + Real.exp (-t) * rutarXi gamma y :=
        by simpa [add_comm] using
          add_le_add_left hxi_t.2 (Real.exp (-t) * rutarXi gamma y)
      _ = 1 - (1 - rutarXi gamma y) * Real.exp (-t) := by ring

/-- Hence each active piece of the Rutar concatenation obeys the prescribed
one-step spectrum upper bound. -/
theorem rutarForwardBlock_rescaled_increment_le
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma)
    (n : Nat) {y t : Real} (hy : 0 < y) (ht : 0 < t) :
    rutarForwardBlock gamma n (y + t) -
        Real.exp (-t) * rutarForwardBlock gamma n y ≤
      rutarXi gamma t := by
  rw [rutarForwardBlock_rescaled_increment]
  exact hgamma.rutarXi_rescaled_increment_le hy ht

/-- At the beginning of every active block the rescaled increment is exactly
the Rutar potential.  These are the scale subsequences yielding the lower
bound for the prescribed spectrum. -/
theorem rutarForwardBlock_rescaled_increment_zero
    (gamma : Real → Real) (n : Nat) (t : Real) :
    rutarForwardBlock gamma n t -
        Real.exp (-t) * rutarForwardBlock gamma n 0 = rutarXi gamma t := by
  simpa [rutarXi_zero] using
    (rutarForwardBlock_rescaled_increment gamma n 0 t)

/-! ### Finite Rutar segments and gluing data -/

/-- A finite piece of a Rutar profile which satisfies the semigroup bounds
all the way to both endpoints.  This endpoint-aware formulation is tailored
to concatenating the active `xi` pieces and their exponential bridges. -/
def IsRutarSegment (f : Real → Real) (L : Real) : Prop :=
  0 ≤ L ∧
    (∀ y : Real, y ∈ Icc (0 : Real) L → 0 ≤ f y ∧ f y ≤ 1) ∧
      ∀ y t : Real, y ∈ Icc (0 : Real) L → 0 ≤ t → y + t ≤ L →
        f y * Real.exp (-t) ≤ f (y + t) ∧
          f (y + t) ≤ 1 - (1 - f y) * Real.exp (-t)

theorem IsRutarSegment.value_bounds {f : Real → Real} {L y : Real}
    (hf : IsRutarSegment f L) (hy : y ∈ Icc (0 : Real) L) :
    0 ≤ f y ∧ f y ≤ 1 := hf.2.1 y hy

theorem IsRutarSegment.rescaled_increment_bounds {f : Real → Real} {L y t : Real}
    (hf : IsRutarSegment f L) (hy : y ∈ Icc (0 : Real) L)
    (ht : 0 ≤ t) (hyt : y + t ≤ L) :
    f y * Real.exp (-t) ≤ f (y + t) ∧
      f (y + t) ≤ 1 - (1 - f y) * Real.exp (-t) :=
  hf.2.2 y t hy ht hyt

/-- The sharp fixed-window chord upper bound associated to Rutar's target
spectrum.  This is deliberately separate from `IsRutarSegment`: the latter
records only the ambient `[0,1]` semigroup bounds, whereas this predicate
retains the target-dependent error `rutarXi gamma t`. -/
def IsRutarXiChordSegment (gamma : Real → Real) (f : Real → Real)
    (L : Real) : Prop :=
  ∀ y t : Real, y ∈ Icc (0 : Real) L → 0 ≤ t → y + t ≤ L →
    f (y + t) - Real.exp (-t) * f y ≤ rutarXi gamma t

/-- The Rutar error potential is nonnegative on the closed positive
half-line. -/
theorem IsRutarAdmissible.rutarXi_nonneg
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma)
    {t : Real} (ht : 0 ≤ t) :
    0 ≤ rutarXi gamma t := by
  rcases eq_or_lt_of_le ht with rfl | ht
  · simp [rutarXi_zero]
  · exact (hgamma.rutarXi_nonneg_le_one_sub_exp ht).1

/-- The error potential is monotone on its natural closed domain. -/
theorem IsRutarAdmissible.rutarXi_monotoneOn_nonneg
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma) :
    MonotoneOn (rutarXi gamma) (Ici (0 : Real)) := by
  intro s hs t ht hst
  rcases eq_or_lt_of_le hst with rfl | hst
  · exact le_rfl
  by_cases hs_zero : s = 0
  · subst s
    simpa [rutarXi_zero] using hgamma.rutarXi_nonneg ht
  have hs_pos : 0 < s := lt_of_le_of_ne hs (Ne.symm hs_zero)
  have hinc := hgamma.rutarXi_increment_bounds hs_pos hst
  linarith [hinc.1]

/-- Damping an earlier Rutar error by a nonnegative interval length can only
decrease it below the error at the combined length. -/
theorem IsRutarAdmissible.exp_mul_rutarXi_le_rutarXi_add
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma)
    {s t : Real} (hs : 0 ≤ s) (ht : 0 ≤ t) :
    Real.exp (-t) * rutarXi gamma s ≤ rutarXi gamma (s + t) := by
  have hxi : 0 ≤ rutarXi gamma s := hgamma.rutarXi_nonneg hs
  have hexp : Real.exp (-t) ≤ 1 :=
    Real.exp_le_one_iff.mpr (by linarith)
  have hmono := hgamma.rutarXi_monotoneOn_nonneg
    (show s ∈ Ici (0 : Real) from hs)
    (show s + t ∈ Ici (0 : Real) from add_nonneg hs ht)
    (by linarith : s ≤ s + t)
  calc
    Real.exp (-t) * rutarXi gamma s ≤ 1 * rutarXi gamma s :=
      mul_le_mul_of_nonneg_right hexp hxi
    _ = rutarXi gamma s := by ring
    _ ≤ rutarXi gamma (s + t) := hmono

/-- An active Rutar block satisfies the sharp chord upper bound, including
the closed endpoints needed for gluing. -/
theorem rutarForwardBlock_isRutarXiChordSegment
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma) (n : Nat) :
    IsRutarXiChordSegment gamma (rutarForwardBlock gamma n)
      ((n + 1 : Nat) : Real) := by
  intro y t hy ht _hyt
  rcases eq_or_lt_of_le ht with rfl | ht
  · simp [rutarXi_zero]
  by_cases hy_zero : y = 0
  · subst y
    simpa only [zero_add] using
      (le_of_eq (rutarForwardBlock_rescaled_increment_zero gamma n t))
  exact rutarForwardBlock_rescaled_increment_le hgamma n
    (lt_of_le_of_ne hy.1 (Ne.symm hy_zero)) ht

/-- A pure exponential bridge has zero rescaled increment and therefore
satisfies every nonnegative Rutar chord upper bound. -/
theorem rutarBridgeBlock_isRutarXiChordSegment
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma) (n : Nat) :
    IsRutarXiChordSegment gamma (rutarBridgeBlock gamma n)
      ((n + 1 : Nat) : Real) := by
  intro y t _hy ht _hyt
  have hbridge : rutarBridgeBlock gamma n (y + t) =
      Real.exp (-t) * rutarBridgeBlock gamma n y := by
    have hexp : Real.exp (-(y + t)) = Real.exp (-t) * Real.exp (-y) := by
      rw [← Real.exp_add]
      congr 1
      ring
    unfold rutarBridgeBlock
    rw [hexp]
    ring
  rw [hbridge]
  ring_nf
  exact hgamma.rutarXi_nonneg ht

/-- Concatenate two endpoint-compatible finite Rutar segments.  The value at
the shared endpoint is taken from the left segment; endpoint compatibility
makes this convention immaterial. -/
def rutarSegmentAppend (f g : Real → Real) (L : Real) (x : Real) : Real :=
  if x ≤ L then f x else g (x - L)

/-- The Rutar semigroup inequalities are stable under finite concatenation.
This elementary gluing lemma is the reusable replacement for reasoning about
derivatives at the joins of the active and bridge pieces. -/
theorem IsRutarSegment.append {f g : Real → Real} {L M : Real}
    (hf : IsRutarSegment f L) (hg : IsRutarSegment g M)
    (hjoin : f L = g 0) :
    IsRutarSegment (rutarSegmentAppend f g L) (L + M) := by
  refine ⟨add_nonneg hf.1 hg.1, ?_, ?_⟩
  · intro x hx
    by_cases hxL : x ≤ L
    · simpa [rutarSegmentAppend, hxL] using hf.value_bounds ⟨hx.1, hxL⟩
    · have hxL' : L < x := lt_of_not_ge hxL
      have hxg : x - L ∈ Icc (0 : Real) M := by
        constructor <;> linarith [hx.2]
      simpa [rutarSegmentAppend, hxL] using hg.value_bounds hxg
  · intro y t hy ht hyt
    by_cases hyL : y ≤ L
    · by_cases hytL : y + t ≤ L
      · have hlocal := hf.rescaled_increment_bounds ⟨hy.1, hyL⟩ ht hytL
        simpa [rutarSegmentAppend, hyL, hytL] using hlocal
      · have hytL' : L < y + t := lt_of_not_ge hytL
        let a : Real := L - y
        let b : Real := y + t - L
        have ha : 0 ≤ a := by dsimp [a]; linarith
        have hb : 0 ≤ b := by dsimp [b]; linarith
        have hya : y + a = L := by dsimp [a]; ring
        have hbt : b = t - a := by dsimp [a, b]; ring
        have hab : a + b = t := by dsimp [a, b]; ring
        have hfa := hf.rescaled_increment_bounds ⟨hy.1, hyL⟩ ha (by
          rw [hya])
        have hfa' : f y * Real.exp (-a) ≤ f L ∧
            f L ≤ 1 - (1 - f y) * Real.exp (-a) := by
          simpa [hya] using hfa
        have hbmem : b ∈ Icc (0 : Real) M := by
          constructor
          · exact hb
          · dsimp [b]
            linarith [hyt]
        have hgb := hg.rescaled_increment_bounds
          (show (0 : Real) ∈ Icc (0 : Real) M from ⟨le_rfl, hg.1⟩)
          hb (by simpa using hbmem.2)
        have hgb' : g 0 * Real.exp (-b) ≤ g b ∧
            g b ≤ 1 - (1 - g 0) * Real.exp (-b) := by
          simpa using hgb
        have hexp : Real.exp (-t) = Real.exp (-a) * Real.exp (-b) := by
          rw [← Real.exp_add]
          congr 1
          rw [← hab]
          ring
        have hleft : f y * Real.exp (-t) ≤ g b := by
          calc
            f y * Real.exp (-t) =
                (f y * Real.exp (-a)) * Real.exp (-b) := by rw [hexp]; ring
            _ ≤ f L * Real.exp (-b) := by
              exact mul_le_mul_of_nonneg_right hfa'.1 (Real.exp_nonneg _)
            _ = g 0 * Real.exp (-b) := by rw [hjoin]
            _ ≤ g b := hgb'.1
        have hupper : g b ≤ 1 - (1 - f y) * Real.exp (-t) := by
          have hcomp : (1 - f y) * Real.exp (-a) * Real.exp (-b) ≤
              (1 - f L) * Real.exp (-b) := by
            have hsub : (1 - f y) * Real.exp (-a) ≤ 1 - f L := by
              linarith [hfa'.2]
            exact mul_le_mul_of_nonneg_right hsub (Real.exp_nonneg _)
          calc
            g b ≤ 1 - (1 - g 0) * Real.exp (-b) := hgb'.2
            _ = 1 - (1 - f L) * Real.exp (-b) := by rw [← hjoin]
            _ ≤ 1 - (1 - f y) * Real.exp (-a) * Real.exp (-b) := by
              linarith
            _ = 1 - (1 - f y) * Real.exp (-t) := by rw [hexp]; ring
        constructor
        · simpa [rutarSegmentAppend, hyL, hytL, b] using hleft
        · simpa [rutarSegmentAppend, hyL, hytL, b] using hupper
    · have hyL' : L < y := lt_of_not_ge hyL
      have hygt : L < y + t := lt_of_lt_of_le hyL' (by linarith)
      have hlocal : y - L ∈ Icc (0 : Real) M := by
        constructor <;> linarith [hy.2]
      have hlocalsum : y - L + t ≤ M := by linarith [hyt]
      have hseg := hg.rescaled_increment_bounds hlocal ht hlocalsum
      convert hseg using 1 <;> simp [rutarSegmentAppend, hyL, not_le.mpr hygt] <;> ring

/-- Sharp Rutar chord control survives an append whose right-hand segment is
purely exponential.  This is the active-to-bridge case; it is valid because
the earlier error is exponentially damped before the bridge is crossed. -/
theorem IsRutarXiChordSegment.append_right_exponential
    {gamma f g : Real → Real} {L M : Real}
    (hgamma : IsRutarAdmissible gamma)
    (hf : IsRutarXiChordSegment gamma f L)
    (_hL : 0 ≤ L) (hM : 0 ≤ M)
    (hgexp : ∀ y t : Real, y ∈ Icc (0 : Real) M → 0 ≤ t → y + t ≤ M →
      g (y + t) = Real.exp (-t) * g y)
    (hjoin : f L = g 0) :
    IsRutarXiChordSegment gamma (rutarSegmentAppend f g L) (L + M) := by
  intro y t hy ht hyt
  by_cases hyL : y ≤ L
  · by_cases hytL : y + t ≤ L
    · simpa [rutarSegmentAppend, hyL, hytL] using
        hf y t ⟨hy.1, hyL⟩ ht hytL
    · have hytL' : L < y + t := lt_of_not_ge hytL
      let a : Real := L - y
      let b : Real := y + t - L
      have ha : 0 ≤ a := by dsimp [a]; linarith
      have hb : 0 ≤ b := by dsimp [b]; linarith
      have hya : y + a = L := by dsimp [a]; ring
      have hab : a + b = t := by dsimp [a, b]; ring
      have hfb : f L - Real.exp (-a) * f y ≤ rutarXi gamma a := by
        have h := hf y a ⟨hy.1, hyL⟩ ha (by rw [hya])
        simpa [hya] using h
      have hbmem : b ∈ Icc (0 : Real) M := by
        constructor
        · exact hb
        · dsimp [b]
          linarith [hyt]
      have hgb : g b = Real.exp (-b) * g 0 := by
        simpa using hgexp 0 b ⟨le_rfl, hM⟩ hb (by simpa using hbmem.2)
      have hexp : Real.exp (-t) = Real.exp (-a) * Real.exp (-b) := by
        rw [← Real.exp_add]
        congr 1
        rw [← hab]
        ring
      have hcross : g b - Real.exp (-t) * f y ≤ rutarXi gamma t := by
        calc
          g b - Real.exp (-t) * f y =
              Real.exp (-b) * (f L - Real.exp (-a) * f y) := by
            rw [hgb, ← hjoin, hexp]
            ring
          _ ≤ Real.exp (-b) * rutarXi gamma a :=
            mul_le_mul_of_nonneg_left hfb (Real.exp_nonneg _)
          _ ≤ rutarXi gamma (a + b) :=
            hgamma.exp_mul_rutarXi_le_rutarXi_add ha hb
          _ = rutarXi gamma t := by rw [hab]
      simpa [rutarSegmentAppend, hyL, hytL, b] using hcross
  · have hyL' : L < y := lt_of_not_ge hyL
    have hygt : L < y + t := lt_of_lt_of_le hyL' (by linarith)
    have hlocal : y - L ∈ Icc (0 : Real) M := by
      constructor <;> linarith [hy.2]
    have hlocalsum : y - L + t ≤ M := by linarith [hyt]
    have hzero : g (y - L + t) = Real.exp (-t) * g (y - L) :=
      hgexp (y - L) t hlocal ht hlocalsum
    have harg : y + t - L = y - L + t := by ring
    have hright : g (y + t - L) - Real.exp (-t) * g (y - L) ≤
        rutarXi gamma t := by
      rw [harg, hzero]
      ring_nf
      exact hgamma.rutarXi_nonneg ht
    simpa [rutarSegmentAppend, hyL, not_le.mpr hygt] using hright

/-- Sharp Rutar chord control also survives an append whose left-hand segment
is purely exponential.  This is the bridge-to-active case; the bridge
contributes no chord error before the active part starts. -/
theorem IsRutarXiChordSegment.append_left_exponential
    {gamma f g : Real → Real} {L M : Real}
    (hgamma : IsRutarAdmissible gamma)
    (hg : IsRutarXiChordSegment gamma g M)
    (_hL : 0 ≤ L) (hM : 0 ≤ M)
    (hfexp : ∀ y t : Real, y ∈ Icc (0 : Real) L → 0 ≤ t → y + t ≤ L →
      f (y + t) = Real.exp (-t) * f y)
    (hjoin : f L = g 0) :
    IsRutarXiChordSegment gamma (rutarSegmentAppend f g L) (L + M) := by
  intro y t hy ht hyt
  by_cases hyL : y ≤ L
  · by_cases hytL : y + t ≤ L
    · have hzero : f (y + t) = Real.exp (-t) * f y :=
        hfexp y t ⟨hy.1, hyL⟩ ht hytL
      have hsmall : f (y + t) - Real.exp (-t) * f y ≤ rutarXi gamma t := by
        rw [hzero]
        ring_nf
        exact hgamma.rutarXi_nonneg ht
      simpa [rutarSegmentAppend, hyL, hytL] using hsmall
    · have hytL' : L < y + t := lt_of_not_ge hytL
      let a : Real := L - y
      let b : Real := y + t - L
      have ha : 0 ≤ a := by dsimp [a]; linarith
      have hb : 0 ≤ b := by dsimp [b]; linarith
      have hya : y + a = L := by dsimp [a]; ring
      have hab : a + b = t := by dsimp [a, b]; ring
      have hfb : f L = Real.exp (-a) * f y := by
        have h := hfexp y a ⟨hy.1, hyL⟩ ha (by rw [hya])
        simpa [hya] using h
      have hbmem : b ∈ Icc (0 : Real) M := by
        constructor
        · exact hb
        · dsimp [b]
          linarith [hyt]
      have hgb : g b - Real.exp (-b) * g 0 ≤ rutarXi gamma b := by
        simpa using hg 0 b ⟨le_rfl, hM⟩ hb (by simpa using hbmem.2)
      have hcross : g b - Real.exp (-t) * f y ≤ rutarXi gamma t := by
        calc
          g b - Real.exp (-t) * f y = g b - Real.exp (-b) * g 0 := by
            rw [← hjoin, hfb]
            have hexp : Real.exp (-t) = Real.exp (-a) * Real.exp (-b) := by
              rw [← Real.exp_add]
              congr 1
              rw [← hab]
              ring
            rw [hexp]
            ring
          _ ≤ rutarXi gamma b := hgb
          _ ≤ rutarXi gamma (a + b) :=
            hgamma.rutarXi_monotoneOn_nonneg hb (add_nonneg ha hb)
              (by linarith : b ≤ a + b)
          _ = rutarXi gamma t := by rw [hab]
      simpa [rutarSegmentAppend, hyL, hytL, b] using hcross
  · have hyL' : L < y := lt_of_not_ge hyL
    have hygt : L < y + t := lt_of_lt_of_le hyL' (by linarith)
    have hlocal : y - L ∈ Icc (0 : Real) M := by
      constructor <;> linarith [hy.2]
    have hlocalsum : y - L + t ≤ M := by linarith [hyt]
    have hright := hg (y - L) t hlocal ht hlocalsum
    have harg : y + t - L = y - L + t := by ring
    rw [← harg] at hright
    simpa [rutarSegmentAppend, hyL, not_le.mpr hygt] using hright

/-- Each active `xi` piece is a finite Rutar segment. -/
theorem rutarForwardBlock_isRutarSegment
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma) (n : Nat) :
    IsRutarSegment (rutarForwardBlock gamma n) ((n + 1 : Nat) : Real) := by
  let L : Real := ((n + 1 : Nat) : Real)
  have hL : 0 < L := by dsimp [L]; positivity
  refine ⟨hL.le, ?_, ?_⟩
  · intro y hy
    by_cases hyzero : y = 0
    · subst y
      constructor
      · simpa [rutarForwardBlock, rutarXi_zero] using
          rutarBlockOffset_nonneg hgamma n
      · simpa [rutarForwardBlock, rutarXi_zero] using
          rutarBlockOffset_le_one hgamma n
    · exact rutarForwardBlock_nonneg_le_one hgamma n
        (lt_of_le_of_ne hy.1 (Ne.symm hyzero))
  · intro y t hy ht _hyt
    have hxi := hgamma.rutarXi_rescaled_increment_bounds_closed hy.1 ht
    have hres := rutarForwardBlock_rescaled_increment gamma n y t
    constructor <;> linarith

/-- An exponential bridge of a bounded amplitude is a finite Rutar segment. -/
theorem rutarBridgeBlock_isRutarSegment
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma) (n : Nat) :
    IsRutarSegment (rutarBridgeBlock gamma n) ((n + 1 : Nat) : Real) := by
  let L : Real := ((n + 1 : Nat) : Real)
  let A : Real := rutarBridgeAmplitude gamma n
  have hL : 0 < L := by dsimp [L]; positivity
  have hA : 0 ≤ A ∧ A ≤ 1 := by
    dsimp [A, rutarBridgeAmplitude]
    exact rutarForwardBlock_nonneg_le_one hgamma n hL
  refine ⟨hL.le, ?_, ?_⟩
  · intro y hy
    have he : 0 ≤ Real.exp (-y) := Real.exp_nonneg _
    have heone : Real.exp (-y) ≤ 1 :=
      Real.exp_le_one_iff.mpr (by linarith [hy.1])
    change 0 ≤ Real.exp (-y) * A ∧ Real.exp (-y) * A ≤ 1
    constructor
    · exact mul_nonneg he hA.1
    · calc
        Real.exp (-y) * A ≤ 1 * A :=
          mul_le_mul_of_nonneg_right heone hA.1
        _ = A := by ring
        _ ≤ 1 := hA.2
  · intro y t hy ht _hyt
    have hexp : Real.exp (-(y + t)) = Real.exp (-t) * Real.exp (-y) := by
      rw [← Real.exp_add]
      congr 1
      ring
    have hbridge : rutarBridgeBlock gamma n (y + t) =
        Real.exp (-t) * rutarBridgeBlock gamma n y := by
      change Real.exp (-(y + t)) * A =
        Real.exp (-t) * (Real.exp (-y) * A)
      rw [hexp]
      ring
    have heone : Real.exp (-t) ≤ 1 :=
      Real.exp_le_one_iff.mpr (by linarith)
    constructor
    · rw [hbridge]
      simp [mul_comm]
    · rw [hbridge]
      nlinarith

/-! ### The global Rutar concatenation -/

/-- The length of the `k`th piece in the alternating active/bridge Rutar
concatenation.  Pieces `2n` and `2n+1` both have length `n + 1`. -/
def rutarPieceLength (k : Nat) : Real := ((k / 2 + 1 : Nat) : Real)

/-- Left endpoint of the `k`th Rutar piece. -/
def rutarPieceStart : Nat → Real
  | 0 => 0
  | k + 1 => rutarPieceStart k + rutarPieceLength k

/-- The active and bridge pieces, interleaved into one sequence. -/
noncomputable def rutarPiece (gamma : Real → Real) (k : Nat) : Real → Real :=
  if k % 2 = 0 then
    rutarForwardBlock gamma (k / 2)
  else
    rutarBridgeBlock gamma (k / 2)

@[simp]
theorem rutarPieceStart_zero : rutarPieceStart 0 = 0 := rfl

@[simp]
theorem rutarPieceStart_succ (k : Nat) :
    rutarPieceStart (k + 1) = rutarPieceStart k + rutarPieceLength k := rfl

theorem rutarPieceLength_pos (k : Nat) : 0 < rutarPieceLength k := by
  unfold rutarPieceLength
  positivity

theorem rutarPieceLength_nonneg (k : Nat) : 0 ≤ rutarPieceLength k :=
  (rutarPieceLength_pos k).le

/-- Every alternating active/bridge piece has length at least one. -/
theorem one_le_rutarPieceLength (k : Nat) : 1 ≤ rutarPieceLength k := by
  unfold rutarPieceLength
  norm_num

theorem rutarPieceStart_nonneg (k : Nat) : 0 ≤ rutarPieceStart k := by
  induction k with
  | zero => simp [rutarPieceStart]
  | succ k ih =>
      rw [rutarPieceStart_succ]
      exact add_nonneg ih (rutarPieceLength_nonneg k)

theorem rutarPieceStart_lt_succ (k : Nat) :
    rutarPieceStart k < rutarPieceStart (k + 1) := by
  rw [rutarPieceStart_succ]
  exact lt_add_of_pos_right _ (rutarPieceLength_pos k)

theorem rutarPieceStart_mono : Monotone rutarPieceStart := by
  intro m n hmn
  induction hmn with
  | refl => exact le_rfl
  | @step n hmn ih =>
      exact ih.trans (rutarPieceStart_lt_succ n).le

/-- The start of the `n`th piece is at least `n`; the concatenation therefore
extends through arbitrarily large logarithmic scales. -/
theorem natCast_le_rutarPieceStart (n : Nat) :
    (n : Real) ≤ rutarPieceStart n := by
  induction n with
  | zero => simp [rutarPieceStart]
  | succ n ih =>
      calc
        ((n + 1 : Nat) : Real) = (n : Real) + 1 := by norm_num
        _ ≤ rutarPieceStart n + rutarPieceLength n :=
          add_le_add ih (one_le_rutarPieceLength n)
        _ = rutarPieceStart (n + 1) := (rutarPieceStart_succ n).symm

/-- The piece start sequence is cofinal in the positive logarithmic axis. -/
theorem tendsto_rutarPieceStart_atTop :
    Tendsto rutarPieceStart atTop atTop := by
  exact tendsto_atTop_mono (fun n => natCast_le_rutarPieceStart n)
    tendsto_natCast_atTop_atTop

/-- The `k`th concatenation piece satisfies the finite Rutar inequalities. -/
theorem rutarPiece_isRutarSegment {gamma : Real → Real}
    (hgamma : IsRutarAdmissible gamma) (k : Nat) :
    IsRutarSegment (rutarPiece gamma k) (rutarPieceLength k) := by
  unfold rutarPiece
  split
  · simpa [rutarPieceLength] using rutarForwardBlock_isRutarSegment hgamma (k / 2)
  · simpa [rutarPieceLength] using rutarBridgeBlock_isRutarSegment hgamma (k / 2)

/-- Consecutive active and bridge pieces have the same endpoint value. -/
theorem rutarPiece_endpoint (gamma : Real → Real) (k : Nat) :
    rutarPiece gamma k (rutarPieceLength k) = rutarPiece gamma (k + 1) 0 := by
  by_cases hk : k % 2 = 0
  · have hk' : (k + 1) % 2 ≠ 0 := by omega
    have hdiv : (k + 1) / 2 = k / 2 := by omega
    rw [rutarPiece, if_pos hk, rutarPiece, if_neg hk', hdiv]
    simpa [rutarPieceLength] using
      rutarForwardBlock_end_eq_rutarBridgeBlock_start gamma (k / 2)
  · have hk' : (k + 1) % 2 = 0 := by omega
    have hdiv : (k + 1) / 2 = k / 2 + 1 := by omega
    rw [rutarPiece, if_neg hk, rutarPiece, if_pos hk', hdiv]
    simpa [rutarPieceLength] using
      rutarBridgeBlock_end_eq_rutarForwardBlock_next_start gamma (k / 2)

/-- A bridge is exactly exponential, independently of the ambient Rutar
semigroup bounds.  This pointwise form is used when a fixed window crosses
the unique late join between two consecutive alternating pieces. -/
theorem rutarBridgeBlock_exponential (gamma : Real → Real) (n : Nat)
    (y t : Real) :
    rutarBridgeBlock gamma n (y + t) =
      Real.exp (-t) * rutarBridgeBlock gamma n y := by
  have hexp : Real.exp (-(y + t)) = Real.exp (-t) * Real.exp (-y) := by
    rw [← Real.exp_add]
    congr 1
    ring
  unfold rutarBridgeBlock
  rw [hexp]
  ring

/-- Every individual alternating piece obeys the sharp Rutar chord bound. -/
theorem rutarPiece_isRutarXiChordSegment {gamma : Real → Real}
    (hgamma : IsRutarAdmissible gamma) (k : Nat) :
    IsRutarXiChordSegment gamma (rutarPiece gamma k) (rutarPieceLength k) := by
  unfold rutarPiece
  split
  · simpa [rutarPieceLength] using
      rutarForwardBlock_isRutarXiChordSegment hgamma (k / 2)
  · simpa [rutarPieceLength] using
      rutarBridgeBlock_isRutarXiChordSegment hgamma (k / 2)

/-- Odd alternating pieces are pure exponential bridges. -/
theorem rutarPiece_exponential_of_mod_ne_zero {gamma : Real → Real}
    {k : Nat} (hk : k % 2 ≠ 0) (y t : Real) :
    rutarPiece gamma k (y + t) =
      Real.exp (-t) * rutarPiece gamma k y := by
  rw [rutarPiece, if_neg hk]
  exact rutarBridgeBlock_exponential gamma (k / 2) y t

/-- Two consecutive alternating Rutar pieces retain the sharp chord bound.
This is the key finite-window fact: one side of every join is a bridge, so
the error either vanishes or is exponentially damped. -/
theorem rutarAdjacentPieces_isRutarXiChordSegment {gamma : Real → Real}
    (hgamma : IsRutarAdmissible gamma) (k : Nat) :
    IsRutarXiChordSegment gamma
      (rutarSegmentAppend (rutarPiece gamma k) (rutarPiece gamma (k + 1))
        (rutarPieceLength k))
      (rutarPieceLength k + rutarPieceLength (k + 1)) := by
  by_cases hk : k % 2 = 0
  · refine IsRutarXiChordSegment.append_right_exponential hgamma
      (rutarPiece_isRutarXiChordSegment hgamma k)
      (rutarPieceLength_nonneg k) (rutarPieceLength_nonneg (k + 1)) ?_
      (rutarPiece_endpoint gamma k)
    intro y t _hy _ht _hyt
    exact rutarPiece_exponential_of_mod_ne_zero (gamma := gamma)
      (k := k + 1) (by omega) y t
  · refine IsRutarXiChordSegment.append_left_exponential hgamma
      (rutarPiece_isRutarXiChordSegment hgamma (k + 1))
      (rutarPieceLength_nonneg k) (rutarPieceLength_nonneg (k + 1)) ?_
      (rutarPiece_endpoint gamma k)
    intro y t _hy _ht _hyt
    exact rutarPiece_exponential_of_mod_ne_zero (gamma := gamma) hk y t

/-- The finite prefix consisting of the first `n` Rutar pieces. -/
noncomputable def rutarPrefix (gamma : Real → Real) : Nat → Real → Real
  | 0 => fun _ => 0
  | n + 1 => rutarSegmentAppend (rutarPrefix gamma n)
      (rutarPiece gamma n) (rutarPieceStart n)

/-- The endpoint of a finite prefix is the initial value of its next piece. -/
theorem rutarPrefix_endpoint (gamma : Real → Real) (n : Nat) :
    rutarPrefix gamma n (rutarPieceStart n) = rutarPiece gamma n 0 := by
  induction n with
  | zero =>
      simp [rutarPrefix, rutarPiece, rutarForwardBlock, rutarXi_zero,
        rutarBlockOffset]
  | succ n ih =>
      rw [rutarPrefix, rutarPieceStart_succ]
      have hlt : rutarPieceStart n <
          rutarPieceStart n + rutarPieceLength n :=
        lt_add_of_pos_right _ (rutarPieceLength_pos n)
      rw [rutarSegmentAppend, if_neg (not_le.mpr hlt)]
      have hend := rutarPiece_endpoint gamma n
      convert hend using 1; ring

/-- Every finite prefix is a Rutar segment on its total length. -/
theorem rutarPrefix_isRutarSegment {gamma : Real → Real}
    (hgamma : IsRutarAdmissible gamma) (n : Nat) :
    IsRutarSegment (rutarPrefix gamma n) (rutarPieceStart n) := by
  induction n with
  | zero =>
      refine ⟨le_rfl, ?_, ?_⟩
      · intro y hy
        simp [rutarPrefix]
      · intro y t hy ht hyt
        constructor
        · simp [rutarPrefix]
        · have he : Real.exp (-t) ≤ 1 :=
            Real.exp_le_one_iff.mpr (by linarith)
          simp [rutarPrefix]
          linarith
  | succ n ih =>
      rw [rutarPieceStart_succ]
      exact ih.append (rutarPiece_isRutarSegment hgamma n)
        (rutarPrefix_endpoint gamma n)

/-- Extending a finite prefix does not change any earlier point. -/
theorem rutarPrefix_succ_eq_on (gamma : Real → Real) (n : Nat) {x : Real}
    (hx : x ≤ rutarPieceStart n) :
    rutarPrefix gamma (n + 1) x = rutarPrefix gamma n x := by
  simp [rutarPrefix, rutarSegmentAppend, hx]

/-- Any later prefix agrees with an earlier prefix on the earlier interval. -/
theorem rutarPrefix_eq_of_le (gamma : Real → Real) {m n : Nat}
    (hmn : m ≤ n) {x : Real} (hx : x ≤ rutarPieceStart m) :
    rutarPrefix gamma n x = rutarPrefix gamma m x := by
  induction n, hmn using Nat.le_induction with
  | base => rfl
  | @succ n hmn ih =>
      calc
        rutarPrefix gamma (n + 1) x = rutarPrefix gamma n x :=
          rutarPrefix_succ_eq_on gamma n
            (hx.trans (rutarPieceStart_mono hmn))
        _ = rutarPrefix gamma m x := ih

/-- Every real parameter lies before the end of some finite Rutar prefix. -/
theorem exists_rutarPieceStart_gt (x : Real) :
    ∃ n : Nat, x < rutarPieceStart (n + 1) := by
  rcases exists_nat_gt x with ⟨n, hn⟩
  refine ⟨n, ?_⟩
  calc
    x < (n : Real) := hn
    _ < ((n + 1 : Nat) : Real) := by norm_num
    _ ≤ rutarPieceStart (n + 1) := natCast_le_rutarPieceStart (n + 1)

/-- Index of the unique half-open Rutar piece containing a parameter. -/
noncomputable def rutarPieceIndex (x : Real) : Nat :=
  Nat.find (exists_rutarPieceStart_gt x)

theorem rutarPieceIndex_lt_end (x : Real) :
    x < rutarPieceStart (rutarPieceIndex x + 1) := by
  exact Nat.find_spec (exists_rutarPieceStart_gt x)

/-- For a positive parameter, the selected Rutar piece starts no later than
that parameter. -/
theorem rutarPieceStart_le_of_pos {x : Real} (hx : 0 < x) :
    rutarPieceStart (rutarPieceIndex x) ≤ x := by
  unfold rutarPieceIndex
  by_cases hzero : Nat.find (exists_rutarPieceStart_gt x) = 0
  · rw [hzero, rutarPieceStart_zero]
    exact hx.le
  · obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero hzero
    rw [hn]
    apply le_of_not_gt
    intro hlt
    have hmin : Nat.find (exists_rutarPieceStart_gt x) ≤ n :=
      Nat.find_min' (exists_rutarPieceStart_gt x) hlt
    rw [hn] at hmin
    omega

/-- Piece indices are monotone in the logarithmic parameter. -/
theorem rutarPieceIndex_mono {x y : Real} (hxy : x ≤ y) :
    rutarPieceIndex x ≤ rutarPieceIndex y := by
  by_contra hnot
  have hyx : rutarPieceIndex y < rutarPieceIndex x := lt_of_not_ge hnot
  have hxend : x < rutarPieceStart (rutarPieceIndex y + 1) :=
    lt_of_le_of_lt hxy (rutarPieceIndex_lt_end y)
  have hmin : rutarPieceIndex x ≤ rutarPieceIndex y :=
    Nat.find_min' (exists_rutarPieceStart_gt x) hxend
  exact (not_le_of_gt hyx) hmin

/-- The infinite Rutar profile, defined as the coherent value of a sufficiently
long finite concatenation.  Values at nonpositive coordinates are set to zero;
only its positive half-line is used in the rounding argument. -/
noncomputable def rutarConcatenation (gamma : Real → Real) (x : Real) : Real :=
  if _hx : 0 < x then
    rutarPrefix gamma (rutarPieceIndex x + 1) x
  else 0

theorem rutarConcatenation_eq_prefix {gamma : Real → Real} {x : Real}
    (hx : 0 < x) :
    rutarConcatenation gamma x =
      rutarPrefix gamma (rutarPieceIndex x + 1) x := by
  simp [rutarConcatenation, hx]

/-- The global concatenation remains in the ambient interval. -/
theorem rutarConcatenation_nonneg_le_one {gamma : Real → Real}
    (hgamma : IsRutarAdmissible gamma) {x : Real} (hx : 0 < x) :
    0 ≤ rutarConcatenation gamma x ∧ rutarConcatenation gamma x ≤ 1 := by
  have hseg := rutarPrefix_isRutarSegment hgamma (rutarPieceIndex x + 1)
  have hxmem : x ∈ Icc (0 : Real) (rutarPieceStart (rutarPieceIndex x + 1)) :=
    ⟨hx.le, (rutarPieceIndex_lt_end x).le⟩
  rw [rutarConcatenation_eq_prefix hx]
  exact hseg.value_bounds hxmem

/-- The alternating active/bridge concatenation satisfies the global Rutar
semigroup inequalities. -/
theorem rutarConcatenation_isRutarGOn {gamma : Real → Real}
    (hgamma : IsRutarAdmissible gamma) :
    IsRutarGOn (rutarConcatenation gamma) 0 1 := by
  intro y t hy ht
  let k : Nat := rutarPieceIndex (y + t)
  let N : Nat := k + 1
  have hytpos : 0 < y + t := by linarith
  have hidx : rutarPieceIndex y ≤ k := by
    dsimp [k]
    exact rutarPieceIndex_mono (by linarith)
  have hyshort : y ≤ rutarPieceStart (rutarPieceIndex y + 1) :=
    (rutarPieceIndex_lt_end y).le
  have hyN : y ≤ rutarPieceStart N := by
    dsimp [N]
    exact hyshort.trans (rutarPieceStart_mono (Nat.add_le_add_right hidx 1))
  have hytN : y + t ≤ rutarPieceStart N := by
    dsimp [N, k]
    exact (rutarPieceIndex_lt_end (y + t)).le
  have hgy : rutarConcatenation gamma y = rutarPrefix gamma N y := by
    rw [rutarConcatenation_eq_prefix hy]
    symm
    exact rutarPrefix_eq_of_le gamma (Nat.add_le_add_right hidx 1) hyshort
  have hgyt : rutarConcatenation gamma (y + t) = rutarPrefix gamma N (y + t) := by
    rw [rutarConcatenation_eq_prefix hytpos]
  have hseg := (rutarPrefix_isRutarSegment hgamma N).rescaled_increment_bounds
    ⟨hy.le, hyN⟩ ht.le hytN
  rw [hgy, hgyt]
  simpa [sub_eq_add_neg, zero_sub] using hseg

/-- A bounded Rutar profile is one-Lipschitz on its positive half-line.  This
is a useful consequence of the semigroup inequalities: no separate
regularity hypothesis is required for the exact-hit construction. -/
theorem IsRutarGOn.lipschitzOnWith_one_of_bounds
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (hbound : ∀ x : Real, x ∈ Ioi (0 : Real) → 0 ≤ g x ∧ g x ≤ 1) :
    LipschitzOnWith 1 g (Ioi (0 : Real)) := by
  refine LipschitzOnWith.of_dist_le_mul fun x hx y hy => ?_
  have hforward : ∀ {u v : Real}, u ≤ v → u ∈ Ioi (0 : Real) →
      v ∈ Ioi (0 : Real) → dist (g u) (g v) ≤ dist u v := by
    intro u v huv hu hv
    rcases lt_or_eq_of_le huv with huvlt | rfl
    · let t : Real := v - u
      have ht : 0 < t := by dsimp [t]; linarith
      have hstep := hg hu ht
      have hlower : g u * Real.exp (-t) ≤ g v := by
        convert hstep.1 using 1 <;> dsimp [t] <;> ring
      have hupper : g v ≤ 1 - (1 - g u) * Real.exp (-t) := by
        convert hstep.2 using 1; dsimp [t]; ring
      have hub := hbound u hu
      have hlin : 1 - Real.exp (-t) ≤ t := by
        have h := Real.add_one_le_exp (-t)
        linarith
      have hright : g v - g u ≤ t := by
        nlinarith [hupper, hub.1, hub.2]
      have hleft : g u - g v ≤ t := by
        nlinarith [hlower, hub.1, hub.2]
      rw [Real.dist_eq, Real.dist_eq,
        abs_of_nonpos (sub_nonpos.mpr huv)]
      apply (abs_le).2
      constructor <;> linarith
    · simp
  rcases le_total x y with hxy | hyx
  · simpa only [NNReal.coe_one, one_mul] using hforward hxy hx hy
  · simpa only [NNReal.coe_one, one_mul, dist_comm] using hforward hyx hy hx

/-- The global Rutar concatenation is continuous at every positive
logarithmic coordinate. -/
theorem rutarConcatenation_continuousOn {gamma : Real → Real}
    (hgamma : IsRutarAdmissible gamma) :
    ContinuousOn (rutarConcatenation gamma) (Ioi (0 : Real)) := by
  exact (rutarConcatenation_isRutarGOn hgamma).lipschitzOnWith_one_of_bounds
    (fun x hx => rutarConcatenation_nonneg_le_one hgamma hx) |>.continuousOn

/-- On the interior of any finite concatenation piece, the global profile is
the corresponding translated piece.  This is the common localization lemma
from which the active- and bridge-block formulas follow. -/
theorem rutarConcatenation_on_piece {gamma : Real → Real} (k : Nat)
    {y : Real} (hy : 0 < y) (hylen : y < rutarPieceLength k) :
    rutarConcatenation gamma (rutarPieceStart k + y) = rutarPiece gamma k y := by
  let x : Real := rutarPieceStart k + y
  have hxpos : 0 < x := by
    dsimp [x]
    exact add_pos_of_nonneg_of_pos (rutarPieceStart_nonneg _) hy
  have hindex : rutarPieceIndex x = k := by
    apply Nat.le_antisymm
    · apply Nat.find_min'
      rw [rutarPieceStart_succ]
      dsimp [x]
      linarith
    · apply le_of_not_gt
      intro hlt
      have hend : rutarPieceStart (rutarPieceIndex x + 1) ≤
          rutarPieceStart k :=
        rutarPieceStart_mono (by omega)
      have hxstart : rutarPieceStart k ≤ x := by
        dsimp [x]
        exact le_add_of_nonneg_right hy.le
      have hcontr : x < rutarPieceStart k :=
        lt_of_lt_of_le (rutarPieceIndex_lt_end x) hend
      exact (not_lt_of_ge hxstart) hcontr
  rw [rutarConcatenation_eq_prefix hxpos, hindex, rutarPrefix]
  have hnot : ¬ x ≤ rutarPieceStart k := by
    dsimp [x]
    linarith
  rw [rutarSegmentAppend, if_neg hnot]
  change rutarPiece gamma k (x - rutarPieceStart k) = _
  rw [show x - rutarPieceStart k = y by dsimp [x]; ring]

/-- Once a parameter has reached the start of the `K`th piece, its selected
piece index is at least `K`. -/
theorem le_rutarPieceIndex_of_rutarPieceStart_le {K : Nat} {y : Real}
    (hy : rutarPieceStart K ≤ y) :
    K ≤ rutarPieceIndex y := by
  apply le_of_not_gt
  intro hlt
  have hend : rutarPieceStart (rutarPieceIndex y + 1) ≤ rutarPieceStart K :=
    rutarPieceStart_mono (by omega)
  have hbefore := rutarPieceIndex_lt_end y
  exact (not_lt_of_ge hy) (hbefore.trans_le hend)

/-- The piece selector takes the expected value at every piece boundary. -/
theorem rutarPieceIndex_rutarPieceStart (k : Nat) :
    rutarPieceIndex (rutarPieceStart k) = k := by
  apply Nat.le_antisymm
  · apply Nat.find_min'
    exact rutarPieceStart_lt_succ k
  · exact le_rutarPieceIndex_of_rutarPieceStart_le le_rfl

/-- Every noninitial piece boundary lies on the positive logarithmic axis. -/
theorem rutarPieceStart_pos {k : Nat} (hk : 0 < k) :
    0 < rutarPieceStart k := by
  obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hk)
  rw [hm, rutarPieceStart_succ]
  exact add_pos_of_nonneg_of_pos (rutarPieceStart_nonneg m)
    (rutarPieceLength_pos m)

/-- At a positive piece boundary, the global concatenation has exactly the
initial value of the next piece. -/
theorem rutarConcatenation_at_piece_start {gamma : Real → Real}
    {k : Nat} (hk : 0 < k) :
    rutarConcatenation gamma (rutarPieceStart k) = rutarPiece gamma k 0 := by
  rw [rutarConcatenation_eq_prefix (rutarPieceStart_pos hk),
    rutarPieceIndex_rutarPieceStart, rutarPrefix]
  rw [rutarSegmentAppend, if_pos le_rfl]
  exact rutarPrefix_endpoint gamma k

/-- On a window meeting at most two consecutive pieces, the global
concatenation is the corresponding finite two-piece append.  The closed
left join is handled by endpoint compatibility, while the right endpoint is
excluded so that the window has a unique local description. -/
theorem rutarConcatenation_on_adjacentPieces {gamma : Real → Real} (k : Nat)
    {a : Real} (hx : 0 < rutarPieceStart k + a) (ha : 0 ≤ a)
    (haend : a < rutarPieceLength k + rutarPieceLength (k + 1)) :
    rutarConcatenation gamma (rutarPieceStart k + a) =
      rutarSegmentAppend (rutarPiece gamma k) (rutarPiece gamma (k + 1))
        (rutarPieceLength k) a := by
  by_cases haL : a ≤ rutarPieceLength k
  · rcases lt_or_eq_of_le haL with haLt | rfl
    · by_cases hazero : a = 0
      · subst a
        have hk : 0 < k := by
          by_contra hk
          have hkzero : k = 0 := Nat.eq_zero_of_not_pos hk
          subst k
          simp [rutarPieceStart] at hx
        calc
          rutarConcatenation gamma (rutarPieceStart k + 0) =
              rutarConcatenation gamma (rutarPieceStart k) := by ring
          _ = rutarPiece gamma k 0 :=
            rutarConcatenation_at_piece_start hk
          _ = rutarSegmentAppend (rutarPiece gamma k)
              (rutarPiece gamma (k + 1)) (rutarPieceLength k) 0 := by
            rw [rutarSegmentAppend, if_pos (rutarPieceLength_nonneg k)]
      · have hapos : 0 < a := lt_of_le_of_ne ha (Ne.symm hazero)
        calc
          rutarConcatenation gamma (rutarPieceStart k + a) =
              rutarPiece gamma k a := rutarConcatenation_on_piece k hapos haLt
          _ = rutarSegmentAppend (rutarPiece gamma k)
              (rutarPiece gamma (k + 1)) (rutarPieceLength k) a := by
            rw [rutarSegmentAppend, if_pos haL]
    · calc
        rutarConcatenation gamma
            (rutarPieceStart k + rutarPieceLength k) =
            rutarConcatenation gamma (rutarPieceStart (k + 1)) := by
              rw [rutarPieceStart_succ]
        _ = rutarPiece gamma (k + 1) 0 :=
          rutarConcatenation_at_piece_start (by omega)
        _ = rutarPiece gamma k (rutarPieceLength k) :=
          (rutarPiece_endpoint gamma k).symm
        _ = rutarSegmentAppend (rutarPiece gamma k) (rutarPiece gamma (k + 1))
            (rutarPieceLength k) (rutarPieceLength k) := by
              rw [rutarSegmentAppend, if_pos le_rfl]
  · let b : Real := a - rutarPieceLength k
    have hbpos : 0 < b := by
      dsimp [b]
      exact sub_pos.mpr (lt_of_not_ge haL)
    have hbLt : b < rutarPieceLength (k + 1) := by
      dsimp [b]
      linarith
    have hshift : rutarPieceStart k + a = rutarPieceStart (k + 1) + b := by
      rw [rutarPieceStart_succ]
      dsimp [b]
      ring
    calc
      rutarConcatenation gamma (rutarPieceStart k + a) =
          rutarConcatenation gamma (rutarPieceStart (k + 1) + b) := by rw [hshift]
      _ = rutarPiece gamma (k + 1) b :=
        rutarConcatenation_on_piece (k + 1) hbpos hbLt
      _ = rutarSegmentAppend (rutarPiece gamma k) (rutarPiece gamma (k + 1))
          (rutarPieceLength k) a := by
            simp [rutarSegmentAppend, haL, b]

/-- The odd pieces in the global construction are precisely the translated
bridge blocks. -/
theorem rutarConcatenation_on_bridge {gamma : Real → Real} (n : Nat)
    {y : Real} (hy : 0 < y) (hylen : y < ((n + 1 : Nat) : Real)) :
    rutarConcatenation gamma (rutarPieceStart (2 * n + 1) + y) =
      rutarBridgeBlock gamma n y := by
  have hdiv : (2 * n + 1) / 2 = n := by omega
  have hlength : y < rutarPieceLength (2 * n + 1) := by
    rw [rutarPieceLength, hdiv]
    exact hylen
  rw [rutarConcatenation_on_piece (2 * n + 1) hy hlength]
  have hmod : ¬ (2 * n + 1) % 2 = 0 := by omega
  rw [rutarPiece, if_neg hmod, hdiv]

/-- A nonnegative window shorter than the following piece can cross at most
one Rutar-piece boundary. -/
theorem rutarPieceIndex_add_le_succ {y t : Real} (_ht : 0 ≤ t)
    (htlen : t < rutarPieceLength (rutarPieceIndex y + 1)) :
    rutarPieceIndex (y + t) ≤ rutarPieceIndex y + 1 := by
  apply Nat.find_min'
  rw [rutarPieceStart_succ]
  calc
    y + t < rutarPieceStart (rutarPieceIndex y + 1) + t :=
      by simpa [add_comm] using add_lt_add_right (rutarPieceIndex_lt_end y) t
    _ < rutarPieceStart (rutarPieceIndex y + 1) +
        rutarPieceLength (rutarPieceIndex y + 1) :=
      by
        simpa [add_comm] using
          add_lt_add_left htlen (rutarPieceStart (rutarPieceIndex y + 1))

/-- For every fixed nonnegative window, sufficiently late logarithmic
parameters meet at most the current and the next Rutar piece. -/
theorem eventually_rutarPieceIndex_add_le_succ (t : Real) (ht : 0 ≤ t) :
    ∀ᶠ y : Real in atTop,
      rutarPieceIndex (y + t) ≤ rutarPieceIndex y + 1 := by
  rcases exists_nat_gt t with ⟨b, hb⟩
  have hlarge : ∀ᶠ y : Real in atTop, rutarPieceStart (2 * b) ≤ y :=
    Filter.eventually_ge_atTop _
  filter_upwards [hlarge] with y hy
  apply rutarPieceIndex_add_le_succ ht
  have hk : 2 * b ≤ rutarPieceIndex y :=
    le_rutarPieceIndex_of_rutarPieceStart_le hy
  have hdiv : b ≤ (rutarPieceIndex y + 1) / 2 := by omega
  have hnat : b ≤ (rutarPieceIndex y + 1) / 2 + 1 :=
    hdiv.trans (Nat.le_succ _)
  calc
    t < (b : Real) := hb
    _ ≤ (((rutarPieceIndex y + 1) / 2 + 1 : Nat) : Real) := by
      exact_mod_cast hnat
    _ = rutarPieceLength (rutarPieceIndex y + 1) := by
      rfl

/-- The preceding late-window estimate, together with monotonicity, gives a
two-sided index bracket for a fixed nonnegative window. -/
theorem eventually_rutarPieceIndex_window (t : Real) (ht : 0 ≤ t) :
    ∀ᶠ y : Real in atTop,
      rutarPieceIndex y ≤ rutarPieceIndex (y + t) ∧
        rutarPieceIndex (y + t) ≤ rutarPieceIndex y + 1 := by
  filter_upwards [eventually_rutarPieceIndex_add_le_succ t ht] with y hy
  exact ⟨rutarPieceIndex_mono (le_add_of_nonneg_right ht), hy⟩

/-- A positive window whose endpoint lies no later than the next alternating
piece has the sharp Rutar chord upper bound.  This is deliberately a
two-piece result, rather than an invalid closure assertion for arbitrary
finite concatenations. -/
theorem rutarConcatenation_chord_le_of_pieceIndex_add_le_succ
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma)
    {y t : Real} (hy : 0 < y) (ht : 0 ≤ t)
    (hindex : rutarPieceIndex (y + t) ≤ rutarPieceIndex y + 1) :
    rutarConcatenation gamma (y + t) -
        Real.exp (-t) * rutarConcatenation gamma y ≤ rutarXi gamma t := by
  let k : Nat := rutarPieceIndex y
  let a : Real := y - rutarPieceStart k
  have hstart : rutarPieceStart k ≤ y := by
    dsimp [k]
    exact rutarPieceStart_le_of_pos hy
  have ha : 0 ≤ a := by
    dsimp [a]
    linarith
  have hyend : y < rutarPieceStart (k + 1) := by
    dsimp [k]
    exact rutarPieceIndex_lt_end y
  have haLt : a < rutarPieceLength k := by
    rw [rutarPieceStart_succ] at hyend
    dsimp [a]
    linarith
  have haend : a < rutarPieceLength k + rutarPieceLength (k + 1) :=
    lt_of_lt_of_le haLt
      (le_add_of_nonneg_right (rutarPieceLength_nonneg (k + 1)))
  have hstart_two : rutarPieceStart (k + 2) =
      rutarPieceStart k + rutarPieceLength k + rutarPieceLength (k + 1) := by
    rw [show k + 2 = (k + 1) + 1 by omega, rutarPieceStart_succ,
      rutarPieceStart_succ]
  have hqstep : rutarPieceIndex (y + t) + 1 ≤ k + 2 := by
    dsimp [k]
    omega
  have hytend : y + t < rutarPieceStart (rutarPieceIndex (y + t) + 1) :=
    rutarPieceIndex_lt_end (y + t)
  have hyt_before : y + t < rutarPieceStart (k + 2) :=
    hytend.trans_le (rutarPieceStart_mono hqstep)
  have hatend : a + t < rutarPieceLength k + rutarPieceLength (k + 1) := by
    rw [hstart_two] at hyt_before
    dsimp [a]
    linarith
  have hytpos : 0 < y + t := by linarith
  have hycoord : rutarPieceStart k + a = y := by
    dsimp [a]
    ring
  have hytcoord : rutarPieceStart k + (a + t) = y + t := by
    dsimp [a]
    ring
  have hlocal_y := rutarConcatenation_on_adjacentPieces (gamma := gamma) k
    (a := a) (by rw [hycoord]; exact hy) ha haend
  have hlocal_yt := rutarConcatenation_on_adjacentPieces (gamma := gamma) k
    (a := a + t) (by rw [hytcoord]; exact hytpos) (add_nonneg ha ht) hatend
  have hvalue_y : rutarConcatenation gamma y =
      rutarSegmentAppend (rutarPiece gamma k) (rutarPiece gamma (k + 1))
        (rutarPieceLength k) a := by
    rw [← hycoord]
    exact hlocal_y
  have hvalue_yt : rutarConcatenation gamma (y + t) =
      rutarSegmentAppend (rutarPiece gamma k) (rutarPiece gamma (k + 1))
        (rutarPieceLength k) (a + t) := by
    rw [← hytcoord]
    exact hlocal_yt
  have hadj := rutarAdjacentPieces_isRutarXiChordSegment hgamma k
    a t ⟨ha, haend.le⟩ ht hatend.le
  rw [hvalue_y, hvalue_yt]
  exact hadj

/-- For every fixed nonnegative logarithmic window, sufficiently late points
of the Rutar concatenation satisfy the prescribed sharp chord estimate. -/
theorem eventually_rutarConcatenation_chord_le {gamma : Real → Real}
    (hgamma : IsRutarAdmissible gamma) (t : Real) (ht : 0 ≤ t) :
    ∀ᶠ y : Real in atTop,
      rutarConcatenation gamma (y + t) -
          Real.exp (-t) * rutarConcatenation gamma y ≤ rutarXi gamma t := by
  have hypos : ∀ᶠ y : Real in atTop, 0 < y := Filter.eventually_gt_atTop 0
  filter_upwards [hypos, eventually_rutarPieceIndex_window t ht] with y hy hwindow
  exact rutarConcatenation_chord_le_of_pieceIndex_add_le_succ hgamma hy ht
    hwindow.2

/-- Reparameterized at a BRRS spectrum parameter, the eventual chord bound
has exactly the form used in Rutar's construction: the logarithmic window is
`-log θ` and the error is `(1-θ) γ(θ)`. -/
theorem eventually_rutarConcatenation_chord_le_at_theta {gamma : Real → Real}
    (hgamma : IsRutarAdmissible gamma) {theta : Real}
    (htheta : theta ∈ Ioo (0 : Real) 1) :
    ∀ᶠ y : Real in atTop,
      rutarConcatenation gamma (y - Real.log theta) -
          theta * rutarConcatenation gamma y ≤ (1 - theta) * gamma theta := by
  have ht : 0 ≤ -Real.log theta := neg_nonneg.mpr
    (Real.log_nonpos htheta.1.le htheta.2.le)
  filter_upwards [eventually_rutarConcatenation_chord_le hgamma
      (-Real.log theta) ht] with y hy
  simpa [rutarXi, sub_eq_add_neg, Real.exp_log htheta.1] using hy

/-- At the start of each active block, the global profile is the recursively
defined block offset.  The zero-th block is included separately because its
left endpoint is the origin. -/
theorem rutarConcatenation_at_active_start {gamma : Real → Real} (n : Nat) :
    rutarConcatenation gamma (rutarPieceStart (2 * n)) =
      rutarBlockOffset gamma n := by
  cases n with
  | zero =>
      simp [rutarConcatenation, rutarPieceStart, rutarBlockOffset]
  | succ n =>
      have hk : 0 < 2 * (n + 1) := by omega
      rw [rutarConcatenation_at_piece_start (gamma := gamma) hk]
      have hmod : (2 * (n + 1)) % 2 = 0 := by omega
      have hdiv : (2 * (n + 1)) / 2 = n + 1 := by omega
      rw [rutarPiece, if_pos hmod, hdiv]
      simp [rutarForwardBlock, rutarXi_zero]

/-- On the interior of the `n`th active piece, the global concatenation has
the intended translated active-block formula. -/
theorem rutarConcatenation_on_active {gamma : Real → Real} (n : Nat)
    {y : Real} (hy : 0 < y) (hylen : y < ((n + 1 : Nat) : Real)) :
    rutarConcatenation gamma (rutarPieceStart (2 * n) + y) =
      rutarForwardBlock gamma n y := by
  let x : Real := rutarPieceStart (2 * n) + y
  have hxpos : 0 < x := by
    dsimp [x]
    exact add_pos_of_nonneg_of_pos (rutarPieceStart_nonneg _) hy
  have hindex : rutarPieceIndex x = 2 * n := by
    apply Nat.le_antisymm
    · apply Nat.find_min'
      rw [rutarPieceStart_succ]
      have hlength : y < rutarPieceLength (2 * n) := by
        simpa [rutarPieceLength] using hylen
      dsimp [x]
      linarith
    · apply le_of_not_gt
      intro hlt
      have hend : rutarPieceStart (rutarPieceIndex x + 1) ≤
          rutarPieceStart (2 * n) :=
        rutarPieceStart_mono (by omega)
      have hxstart : rutarPieceStart (2 * n) ≤ x := by
        dsimp [x]
        exact le_add_of_nonneg_right hy.le
      have hcontr : x < rutarPieceStart (2 * n) :=
        lt_of_lt_of_le (rutarPieceIndex_lt_end x) hend
      exact (not_lt_of_ge hxstart) hcontr
  rw [rutarConcatenation_eq_prefix hxpos, hindex, rutarPrefix]
  have hnot : ¬ x ≤ rutarPieceStart (2 * n) := by
    dsimp [x]
    linarith
  rw [rutarSegmentAppend, if_neg hnot]
  have hmod : (2 * n) % 2 = 0 := by omega
  have hdiv : (2 * n) / 2 = n := by omega
  change rutarPiece gamma (2 * n) (x - rutarPieceStart (2 * n)) = _
  rw [show x - rutarPieceStart (2 * n) = y by dsimp [x]; ring]
  rw [rutarPiece, if_pos hmod, hdiv]

/-- On every interior active window, the rescaled increment of the global
concatenation is exactly Rutar's potential.  This is the direct lower-witness
identity for the prescribed spectrum. -/
theorem rutarConcatenation_active_chord {gamma : Real → Real} (n : Nat)
    {tau : Real} (htau : 0 < tau) (htau_len : tau < ((n + 1 : Nat) : Real)) :
    rutarConcatenation gamma (rutarPieceStart (2 * n) + tau) -
        Real.exp (-tau) * rutarConcatenation gamma (rutarPieceStart (2 * n)) =
      rutarXi gamma tau := by
  rw [rutarConcatenation_on_active n htau htau_len,
    rutarConcatenation_at_active_start]
  unfold rutarForwardBlock
  ring

/-- Every sufficiently long active block repeats any fixed positive Rutar
potential value as a lower bound for the global profile. -/
theorem rutarConcatenation_active_ge_rutarXi {gamma : Real → Real}
    (hgamma : IsRutarAdmissible gamma) (n : Nat) {tau : Real}
    (htau : 0 < tau) (htau_len : tau < ((n + 1 : Nat) : Real)) :
    rutarXi gamma tau ≤
      rutarConcatenation gamma (rutarPieceStart (2 * n) + tau) := by
  rw [rutarConcatenation_on_active n htau htau_len]
  unfold rutarForwardBlock
  exact le_add_of_nonneg_right
    (mul_nonneg (Real.exp_nonneg _) (rutarBlockOffset_nonneg hgamma n))


/-! ### Logarithmic mass coordinates for Rutar rounding -/

/-- The integer-valued scale selector in Rutar's rounding lemma is obtained
from this logarithmic mass coordinate.  At a point `x`, a binary Moran level
with index close to `rutarLogMass g x` has physical length close to
`exp (-exp x)`. -/
noncomputable def rutarLogMass (g : Real → Real) (x : Real) : Real :=
  Real.exp x * g x / Real.log 2

/-- The lower differential inequality in `IsRutarGOn` says exactly that the
logarithmic mass coordinate is monotone. -/
theorem IsRutarGOn.rutarLogMass_monoOn
    {g : Real → Real} (hg : IsRutarGOn g 0 1) :
    MonotoneOn (rutarLogMass g) (Ioi (0 : Real)) := by
  intro x hx y hy hxy
  by_cases hEq : x = y
  · simp [hEq]
  have hlt : x < y := lt_of_le_of_ne hxy hEq
  let t : Real := y - x
  have ht : 0 < t := sub_pos.mpr hlt
  have hlower := (hg hx ht).1
  have hlower' : g x * Real.exp (-t) ≤ g (x + t) := by
    convert hlower using 1; ring
  have hexp : Real.exp y = Real.exp x * Real.exp t := by
    rw [← Real.exp_add]
    congr 1
    dsimp [t]
    ring
  have hcancel : Real.exp t * Real.exp (-t) = 1 := by
    rw [← Real.exp_add]
    simp
  have hraw : Real.exp x * g x ≤ Real.exp y * g y := by
    have hpositive : 0 < Real.exp x * Real.exp t :=
      mul_pos (Real.exp_pos _) (Real.exp_pos _)
    calc
      Real.exp x * g x =
          (Real.exp x * Real.exp t) * (g x * Real.exp (-t)) := by
            calc
              Real.exp x * g x =
                  Real.exp x * (g x * (Real.exp t * Real.exp (-t))) := by
                    rw [hcancel]
                    ring
              _ = (Real.exp x * Real.exp t) * (g x * Real.exp (-t)) := by
                    ring
      _ ≤ (Real.exp x * Real.exp t) * g (x + t) :=
        mul_le_mul_of_nonneg_left hlower' hpositive.le
      _ = Real.exp y * g y := by
        rw [show x + t = y by dsimp [t]; ring, hexp]
  unfold rutarLogMass
  exact (div_le_div_iff_of_pos_right (Real.log_pos (by norm_num))).2 hraw

/-- The upper differential inequality controls the increase of the
logarithmic mass by the increase of the physical logarithmic scale.  This is
the estimate which forces the rounded contraction ratios to be at most
one-half. -/
theorem IsRutarGOn.rutarLogMass_increment_le
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    {x y : Real} (hx : 0 < x) (hxy : x < y) :
    rutarLogMass g y - rutarLogMass g x ≤
      (Real.exp y - Real.exp x) / Real.log 2 := by
  let t : Real := y - x
  have ht : 0 < t := sub_pos.mpr hxy
  have hupper := (hg hx ht).2
  have hxt : x + t = y := by
    dsimp [t]
    ring
  have hexp : Real.exp y = Real.exp x * Real.exp t := by
    rw [← Real.exp_add]
    congr 1
    exact hxt.symm
  have hcancel : Real.exp t * Real.exp (-t) = 1 := by
    rw [← Real.exp_add]
    simp
  have hupper' : g y ≤ 1 - (1 - g x) * Real.exp (-t) := by
    simpa only [hxt] using hupper
  have hEcancel : Real.exp y * Real.exp (-t) = Real.exp x := by
    rw [hexp]
    calc
      Real.exp x * Real.exp t * Real.exp (-t) =
          Real.exp x * (Real.exp t * Real.exp (-t)) := by ring
      _ = Real.exp x * 1 := by rw [hcancel]
      _ = Real.exp x := by ring
  have hraw : Real.exp y * g y - Real.exp x * g x ≤
      Real.exp y - Real.exp x := by
    have hpositive : 0 < Real.exp y := Real.exp_pos _
    calc
      Real.exp y * g y - Real.exp x * g x ≤
          Real.exp y * (1 - (1 - g x) * Real.exp (-t)) -
            Real.exp x * g x :=
        sub_le_sub_right (mul_le_mul_of_nonneg_left hupper' hpositive.le) _
      _ = Real.exp y - Real.exp x := by
        calc
          Real.exp y * (1 - (1 - g x) * Real.exp (-t)) -
              Real.exp x * g x =
              Real.exp y - (Real.exp y * Real.exp (-t)) +
                (Real.exp y * Real.exp (-t)) * g x - Real.exp x * g x := by
                  ring
          _ = Real.exp y - Real.exp x := by rw [hEcancel]; ring
  unfold rutarLogMass
  rw [div_sub_div_same]
  exact (div_le_div_iff_of_pos_right (Real.log_pos (by norm_num))).2 hraw

/-- Continuity passes from a Rutar profile to its logarithmic mass coordinate.
This is the topological input for choosing exact integer hitting times. -/
theorem rutarLogMass_continuousOn {g : Real → Real}
    (hg : ContinuousOn g (Ioi (0 : Real))) :
    ContinuousOn (rutarLogMass g) (Ioi (0 : Real)) := by
  unfold rutarLogMass
  exact (Real.continuous_exp.continuousOn.mul hg).div_const _

/-- A positive value repeated along a sequence of logarithmic locations
tending to infinity forces the logarithmic mass to be unbounded.  This is the
sole non-rapidness input required by the exact-hit ratio rounding lemma. -/
theorem rutarLogMass_unbounded_of_repeated_positive
    {g : Real → Real} {start : Nat → Real} {tau p : Real}
    (hp : 0 < p) (hstart : Tendsto start atTop atTop)
    (hvalue : ∀ n : Nat, p ≤ g (start n + tau)) :
    ∀ x M : Real, 0 < x →
      ∃ y : Real, x < y ∧ M ≤ rutarLogMass g y := by
  intro x M _hx
  have hlogtwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hparameter : Tendsto (fun n : Nat => start n + tau) atTop atTop :=
    hstart.atTop_add tendsto_const_nhds
  have hexp : Tendsto (fun n : Nat => Real.exp (start n + tau)) atTop atTop :=
    Real.tendsto_exp_atTop.comp hparameter
  have hcoef : 0 < p / Real.log 2 := div_pos hp hlogtwo
  have hmass : Tendsto
      (fun n : Nat => Real.exp (start n + tau) * (p / Real.log 2)) atTop atTop :=
    hexp.atTop_mul_const hcoef
  have heventually : ∀ᶠ n : Nat in atTop,
      ∃ y : Real, x < y ∧ M ≤ rutarLogMass g y := by
    filter_upwards [tendsto_atTop.1 hparameter (x + 1),
      tendsto_atTop.1 hmass M] with n hnparam hnmass
    refine ⟨start n + tau, by linarith, ?_⟩
    have hmul : Real.exp (start n + tau) * p ≤
        Real.exp (start n + tau) * g (start n + tau) :=
      mul_le_mul_of_nonneg_left (hvalue n) (Real.exp_nonneg _)
    calc
      M ≤ Real.exp (start n + tau) * (p / Real.log 2) := hnmass
      _ = (Real.exp (start n + tau) * p) / Real.log 2 := by ring
      _ ≤ (Real.exp (start n + tau) * g (start n + tau)) / Real.log 2 :=
        (div_le_div_iff_of_pos_right hlogtwo).2 hmul
      _ = rutarLogMass g (start n + tau) := rfl
  rcases heventually.exists with ⟨n, y, hy⟩
  exact ⟨y, hy⟩

/-- The same non-rapidness criterion only needs the positive repeated value
on sufficiently late blocks.  This is the form used for a fixed positive
`tau`, since the active block lengths increase to infinity. -/
theorem rutarLogMass_unbounded_of_eventually_repeated_positive
    {g : Real → Real} {start : Nat → Real} {tau p : Real}
    (hp : 0 < p) (hstart : Tendsto start atTop atTop)
    (hvalue : ∀ᶠ n : Nat in atTop, p ≤ g (start n + tau)) :
    ∀ x M : Real, 0 < x →
      ∃ y : Real, x < y ∧ M ≤ rutarLogMass g y := by
  intro x M _hx
  have hlogtwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hparameter : Tendsto (fun n : Nat => start n + tau) atTop atTop :=
    hstart.atTop_add tendsto_const_nhds
  have hexp : Tendsto (fun n : Nat => Real.exp (start n + tau)) atTop atTop :=
    Real.tendsto_exp_atTop.comp hparameter
  have hcoef : 0 < p / Real.log 2 := div_pos hp hlogtwo
  have hmass : Tendsto
      (fun n : Nat => Real.exp (start n + tau) * (p / Real.log 2)) atTop atTop :=
    hexp.atTop_mul_const hcoef
  have heventually : ∀ᶠ n : Nat in atTop,
      ∃ y : Real, x < y ∧ M ≤ rutarLogMass g y := by
    filter_upwards [hvalue, tendsto_atTop.1 hparameter (x + 1),
      tendsto_atTop.1 hmass M] with n hvalue_n hnparam hnmass
    refine ⟨start n + tau, by linarith, ?_⟩
    have hmul : Real.exp (start n + tau) * p ≤
        Real.exp (start n + tau) * g (start n + tau) :=
      mul_le_mul_of_nonneg_left hvalue_n (Real.exp_nonneg _)
    calc
      M ≤ Real.exp (start n + tau) * (p / Real.log 2) := hnmass
      _ = (Real.exp (start n + tau) * p) / Real.log 2 := by ring
      _ ≤ (Real.exp (start n + tau) * g (start n + tau)) / Real.log 2 :=
        (div_le_div_iff_of_pos_right hlogtwo).2 hmul
      _ = rutarLogMass g (start n + tau) := rfl
  rcases heventually.exists with ⟨n, y, hy⟩
  exact ⟨y, hy⟩

/-- A genuinely positive admissible spectrum makes the logarithmic mass of
Rutar's infinite active/bridge concatenation unbounded.  Indeed, one positive
value of `rutarXi` reappears in every sufficiently long active block, while
the starting positions of those blocks are cofinal.  This supplies precisely
the non-rapidness hypothesis used by the exact-hit binary-Moran rounding
construction below. -/
theorem rutarConcatenation_logMass_unbounded_of_exists_pos
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma)
    (hpositive : ∃ theta : Real, theta ∈ Ioo (0 : Real) 1 ∧ 0 < gamma theta) :
    ∀ x M : Real, 0 < x →
      ∃ y : Real, x < y ∧ M ≤ rutarLogMass (rutarConcatenation gamma) y := by
  rcases hpositive with ⟨theta, htheta, hgamma_theta⟩
  rcases exists_rutarXi_pos_of_gamma_pos htheta hgamma_theta with
    ⟨tau, htau, hp⟩
  apply rutarLogMass_unbounded_of_eventually_repeated_positive hp
  · have htwice : Tendsto (fun n : Nat => 2 * n) atTop atTop :=
      tendsto_atTop.2 (by
        intro b
        exact Filter.eventually_atTop.2 ⟨b, fun n hn => by omega⟩)
    exact tendsto_rutarPieceStart_atTop.comp htwice
  · have hlong : ∀ᶠ n : Nat in atTop, tau < (n : Real) :=
      tendsto_natCast_atTop_atTop.eventually_gt_atTop tau
    filter_upwards [hlong] with n hn
    exact rutarConcatenation_active_ge_rutarXi hgamma n htau
      (lt_of_lt_of_le hn (by norm_num))

/-- If the logarithmic mass is unbounded above, every next unit of mass is
attained at a strictly later positive parameter.  This is the exact
intermediate-value step used to turn a continuous Rutar profile into a
sequence of binary generations. -/
theorem exists_rutarLogMass_successor
    {g : Real → Real} (hcont : ContinuousOn g (Ioi (0 : Real)))
    (hunbounded : ∀ x M : Real, 0 < x → ∃ y : Real, x < y ∧ M ≤ rutarLogMass g y)
    {x : Real} (hx : 0 < x) :
    ∃ y : Real, x < y ∧ rutarLogMass g y = rutarLogMass g x + 1 := by
  rcases hunbounded x (rutarLogMass g x + 1) hx with ⟨z, hxz, hz⟩
  have hcont' : ContinuousOn (rutarLogMass g) (Icc x z) :=
    rutarLogMass_continuousOn hcont |>.mono (by
      intro w hw
      exact lt_of_lt_of_le hx hw.1)
  have htarget : rutarLogMass g x + 1 ∈
      Icc (rutarLogMass g x) (rutarLogMass g z) :=
    ⟨by linarith, hz⟩
  rcases intermediate_value_Icc hxz.le hcont' htarget with ⟨y, hy, hvalue⟩
  refine ⟨y, ?_, hvalue⟩
  rcases hy with ⟨hxy, _hyz⟩
  apply lt_of_le_of_ne hxy
  intro hEq
  subst y
  linarith

/-- One selected successor in the exact-integer-hitting construction.  The
fallback branch is never used along the positive orbit below; it makes the
choice a total function, so that it may be iterated without dependent choice. -/
noncomputable def rutarLogMassStep {g : Real → Real}
    (hcont : ContinuousOn g (Ioi (0 : Real)))
    (hunbounded : ∀ x M : Real, 0 < x →
      ∃ y : Real, x < y ∧ M ≤ rutarLogMass g y)
    (x : Real) : Real :=
  if hx : 0 < x then
    Classical.choose (exists_rutarLogMass_successor hcont hunbounded hx)
  else x + 1

/-- At a positive point, the selected step is strictly later. -/
theorem lt_rutarLogMassStep {g : Real → Real}
    (hcont : ContinuousOn g (Ioi (0 : Real)))
    (hunbounded : ∀ x M : Real, 0 < x →
      ∃ y : Real, x < y ∧ M ≤ rutarLogMass g y)
    {x : Real} (hx : 0 < x) :
    x < rutarLogMassStep hcont hunbounded x := by
  rw [rutarLogMassStep, dif_pos hx]
  exact (Classical.choose_spec
    (exists_rutarLogMass_successor hcont hunbounded hx)).1

/-- At a positive point, one selected step increases the logarithmic mass by
exactly one. -/
theorem rutarLogMassStep_mass {g : Real → Real}
    (hcont : ContinuousOn g (Ioi (0 : Real)))
    (hunbounded : ∀ x M : Real, 0 < x →
      ∃ y : Real, x < y ∧ M ≤ rutarLogMass g y)
    {x : Real} (hx : 0 < x) :
    rutarLogMass g (rutarLogMassStep hcont hunbounded x) =
      rutarLogMass g x + 1 := by
  rw [rutarLogMassStep, dif_pos hx]
  exact (Classical.choose_spec
    (exists_rutarLogMass_successor hcont hunbounded hx)).2

/-- The infinite sequence of consecutive exact logarithmic-mass hits produced
by repeatedly applying the intermediate-value successor lemma. -/
noncomputable def rutarLogMassHitNodes {g : Real → Real}
    (hcont : ContinuousOn g (Ioi (0 : Real)))
    (hunbounded : ∀ x M : Real, 0 < x →
      ∃ y : Real, x < y ∧ M ≤ rutarLogMass g y)
    (x0 : Real) : Nat → Real
  | 0 => x0
  | n + 1 => rutarLogMassStep hcont hunbounded
      (rutarLogMassHitNodes hcont hunbounded x0 n)

/-- Every node in the selected hitting orbit remains positive. -/
theorem rutarLogMassHitNodes_pos {g : Real → Real}
    (hcont : ContinuousOn g (Ioi (0 : Real)))
    (hunbounded : ∀ x M : Real, 0 < x →
      ∃ y : Real, x < y ∧ M ≤ rutarLogMass g y)
    {x0 : Real} (hx0 : 0 < x0) (n : Nat) :
    0 < rutarLogMassHitNodes hcont hunbounded x0 n := by
  induction n with
  | zero => simpa [rutarLogMassHitNodes] using hx0
  | succ n ih =>
      exact ih.trans (lt_rutarLogMassStep hcont hunbounded ih)

/-- Consecutive selected nodes are strictly ordered. -/
theorem rutarLogMassHitNodes_strict {g : Real → Real}
    (hcont : ContinuousOn g (Ioi (0 : Real)))
    (hunbounded : ∀ x M : Real, 0 < x →
      ∃ y : Real, x < y ∧ M ≤ rutarLogMass g y)
    {x0 : Real} (hx0 : 0 < x0) (n : Nat) :
    rutarLogMassHitNodes hcont hunbounded x0 n <
      rutarLogMassHitNodes hcont hunbounded x0 (n + 1) := by
  rw [rutarLogMassHitNodes]
  exact lt_rutarLogMassStep hcont hunbounded
    (rutarLogMassHitNodes_pos hcont hunbounded hx0 n)

/-- The mass of the `n`th selected node is the initial mass plus exactly `n`.
This gives the integer generation targets required by the rounding map. -/
theorem rutarLogMassHitNodes_mass {g : Real → Real}
    (hcont : ContinuousOn g (Ioi (0 : Real)))
    (hunbounded : ∀ x M : Real, 0 < x →
      ∃ y : Real, x < y ∧ M ≤ rutarLogMass g y)
    {x0 : Real} (hx0 : 0 < x0) (n : Nat) :
    rutarLogMass g (rutarLogMassHitNodes hcont hunbounded x0 n) =
      rutarLogMass g x0 + (n : Real) := by
  induction n with
  | zero => simp [rutarLogMassHitNodes]
  | succ n ih =>
      rw [rutarLogMassHitNodes]
      calc
        rutarLogMass g
            (rutarLogMassStep hcont hunbounded
              (rutarLogMassHitNodes hcont hunbounded x0 n)) =
            rutarLogMass g (rutarLogMassHitNodes hcont hunbounded x0 n) + 1 :=
          rutarLogMassStep_mass hcont hunbounded
            (rutarLogMassHitNodes_pos hcont hunbounded hx0 n)
        _ = rutarLogMass g x0 + (n : Real) + 1 := by rw [ih]
        _ = rutarLogMass g x0 + ((n + 1 : Nat) : Real) := by
          norm_num
          ring

/-- Unbounded continuous logarithmic mass has an exact integer hit above every
positive starting parameter. -/
theorem exists_rutarLogMass_nat_hit
    {g : Real → Real} (hcont : ContinuousOn g (Ioi (0 : Real)))
    (hunbounded : ∀ x M : Real, 0 < x →
      ∃ y : Real, x < y ∧ M ≤ rutarLogMass g y)
    {a : Real} (ha : 0 < a) :
    ∃ offset : Nat, ∃ x : Real, a < x ∧
      rutarLogMass g x = (offset : Real) := by
  rcases exists_nat_gt (rutarLogMass g a) with ⟨offset, htarget⟩
  rcases hunbounded a (offset : Real) ha with ⟨z, haz, hz⟩
  have hcont' : ContinuousOn (rutarLogMass g) (Icc a z) :=
    rutarLogMass_continuousOn hcont |>.mono (by
      intro w hw
      exact lt_of_lt_of_le ha hw.1)
  have hvalue : (offset : Real) ∈
      Icc (rutarLogMass g a) (rutarLogMass g z) :=
    ⟨htarget.le, hz⟩
  rcases intermediate_value_Icc haz.le hcont' hvalue with ⟨x, hx, hmass⟩
  refine ⟨offset, x, ?_, hmass⟩
  apply lt_of_le_of_ne hx.1
  intro heq
  subst x
  linarith

/-- Starting at an exact integer hit and iterating the successor construction
produces all consecutive integer targets needed by the binary rounding map. -/
theorem exists_rutarExactIntegerHitNodes
    {g : Real → Real} (hcont : ContinuousOn g (Ioi (0 : Real)))
    (hunbounded : ∀ x M : Real, 0 < x →
      ∃ y : Real, x < y ∧ M ≤ rutarLogMass g y) :
    ∃ offset : Nat, ∃ node : Nat → Real,
      (∀ j : Nat, 0 < node j) ∧
        (∀ j : Nat,
          rutarLogMass g (node j) = ((offset + j : Nat) : Real)) := by
  rcases exists_rutarLogMass_nat_hit hcont hunbounded
    (show (0 : Real) < 1 by norm_num) with ⟨offset, x0, hx0, hmass⟩
  have hx0pos : 0 < x0 := by linarith
  let node : Nat → Real := rutarLogMassHitNodes hcont hunbounded x0
  refine ⟨offset, node, ?_, ?_⟩
  · intro j
    exact rutarLogMassHitNodes_pos hcont hunbounded hx0pos j
  · intro j
    have hnode := rutarLogMassHitNodes_mass hcont hunbounded hx0pos j
    change rutarLogMass g (rutarLogMassHitNodes hcont hunbounded x0 j) = _
    rw [hnode, hmass]
    norm_num [Nat.cast_add]

/-- Consecutive exact integer hits of the logarithmic mass give the universal
one-level rounding error between the hits.  This is the numerical conclusion
of Rutar's ratio-rounding lemma before it is translated into cylinder scales. -/
theorem rutarLogMass_floor_error_of_exact_hits
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    {x : Real} {n : Nat} (hn : 0 < n)
    (hbracket : node (n - 1) < x ∧ x ≤ node n) :
    |((offset + n : Nat) : Real) - rutarLogMass g x| ≤ 1 := by
  have hmono := hg.rutarLogMass_monoOn
  have hlower : rutarLogMass g (node (n - 1)) ≤ rutarLogMass g x := by
    apply hmono
    · exact hnode_pos (n - 1)
    · exact lt_trans (hnode_pos (n - 1)) hbracket.1
    · exact hbracket.1.le
  have hupper : rutarLogMass g x ≤ rutarLogMass g (node n) := by
    apply hmono
    · exact lt_trans (hnode_pos (n - 1)) hbracket.1
    · exact hnode_pos n
    · exact hbracket.2
  have hprevnat : offset + (n - 1) + 1 = offset + n := by
    omega
  have hprev : ((offset + (n - 1) : Nat) : Real) =
      ((offset + n : Nat) : Real) - 1 := by
    calc
      ((offset + (n - 1) : Nat) : Real) =
          ((offset + (n - 1) + 1 : Nat) : Real) - 1 := by norm_num
      _ = ((offset + n : Nat) : Real) - 1 := by rw [hprevnat]
  rw [hhit (n - 1)] at hlower
  rw [hhit n] at hupper
  rw [hprev] at hlower
  rw [abs_le]
  constructor <;> linarith

/-- In Rutar's original coordinates, the unit floor error in logarithmic mass
is exactly an error of `log 2 * exp (-x)` in the scale exponent.  This is the
quantitative estimate used to pass from integer Moran generations back to the
continuous profile. -/
theorem rutarRatioRounding_error_of_exact_hits
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    {x : Real} {n : Nat} (hn : 0 < n)
    (hbracket : node (n - 1) < x ∧ x ≤ node n) :
    |((offset + n : Nat) : Real) * Real.log 2 / Real.exp x - g x| ≤
      Real.log 2 / Real.exp x := by
  have hfloor := rutarLogMass_floor_error_of_exact_hits hg offset node
    hnode_pos hhit hn hbracket
  have hlogtwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hexp : 0 < Real.exp x := Real.exp_pos _
  have hfactor : ((offset + n : Nat) : Real) * Real.log 2 / Real.exp x - g x =
      (Real.log 2 / Real.exp x) *
        (((offset + n : Nat) : Real) - rutarLogMass g x) := by
    unfold rutarLogMass
    field_simp [ne_of_gt hlogtwo, ne_of_gt hexp]
  have hcoef : 0 ≤ Real.log 2 / Real.exp x :=
    div_nonneg hlogtwo.le hexp.le
  calc
    |((offset + n : Nat) : Real) * Real.log 2 / Real.exp x - g x| =
        (Real.log 2 / Real.exp x) *
          |((offset + n : Nat) : Real) - rutarLogMass g x| := by
            rw [hfactor, abs_mul, abs_of_nonneg hcoef]
    _ ≤ (Real.log 2 / Real.exp x) * 1 :=
      mul_le_mul_of_nonneg_left hfloor hcoef
    _ = Real.log 2 / Real.exp x := by ring

/-- Exact successive integer hits of the logarithmic mass are strictly ordered
in the logarithmic parameter. -/
theorem rutarNode_strict_of_exact_hits
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    (j : Nat) : node j < node (j + 1) := by
  by_contra hnot
  have hle : node (j + 1) ≤ node j := le_of_not_gt hnot
  have hmass : rutarLogMass g (node (j + 1)) ≤ rutarLogMass g (node j) := by
    apply hg.rutarLogMass_monoOn
    · exact hnode_pos (j + 1)
    · exact hnode_pos j
    · exact hle
  rw [hhit (j + 1), hhit j] at hmass
  norm_num [Nat.cast_add] at hmass

/-- The physical logarithmic scales attached to consecutive exact mass hits
are separated by `log 2`.  Consequently their exponentiated differences are
valid binary Moran contraction gaps. -/
theorem rutarPhysicalGap_of_exact_hits
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    (j : Nat) :
    Real.log 2 ≤ Real.exp (node (j + 1)) - Real.exp (node j) := by
  have hstrict := rutarNode_strict_of_exact_hits hg offset node hnode_pos hhit j
  have hinc := hg.rutarLogMass_increment_le (hnode_pos j) hstrict
  rw [hhit (j + 1), hhit j] at hinc
  have hinc' : (1 : Real) ≤
      (Real.exp (node (j + 1)) - Real.exp (node j)) / Real.log 2 := by
    norm_num [Nat.cast_add] at hinc ⊢
    exact hinc
  have hlogtwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  simpa using (le_div_iff₀ hlogtwo).mp hinc'

/-- The physical logarithmic lengths of the selected cylinders grow at least
linearly.  In particular, exact hits cannot accumulate at a finite logarithmic
parameter. -/
theorem rutarPhysicalLength_lower_bound_of_exact_hits
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    (n : Nat) :
    Real.exp (node 0) + (n : Real) * Real.log 2 ≤ Real.exp (node n) := by
  induction n with
  | zero => norm_num
  | succ n ih =>
      have hgap := rutarPhysicalGap_of_exact_hits hg offset node hnode_pos hhit n
      calc
        Real.exp (node 0) + ((n + 1 : Nat) : Real) * Real.log 2 =
            (Real.exp (node 0) + (n : Real) * Real.log 2) + Real.log 2 := by
              norm_num
              ring
        _ ≤ Real.exp (node n) + Real.log 2 := by linarith
        _ ≤ Real.exp (node (n + 1)) := by linarith

/-- Exact-hit nodes are cofinal in the logarithmic parameter.  This is the
ingredient that lets the one-step floor estimate control every sufficiently
small physical scale, rather than only the selected generations. -/
theorem rutarNode_unbounded_of_exact_hits
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    (a : Real) :
    ∃ n : Nat, a ≤ node n := by
  have hlogtwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  rcases exists_nat_gt
      ((Real.exp a - Real.exp (node 0)) / Real.log 2) with ⟨n, hn⟩
  refine ⟨n, ?_⟩
  have hlinear := rutarPhysicalLength_lower_bound_of_exact_hits
    hg offset node hnode_pos hhit n
  have hn' : Real.exp a - Real.exp (node 0) <
      (n : Real) * Real.log 2 :=
    (div_lt_iff₀ hlogtwo).mp hn
  have hexp : Real.exp a < Real.exp (node n) := by
    linarith
  exact (Real.exp_le_exp).mp hexp.le

/-- Every parameter strictly beyond the first selected node lies in a unique
successive-node bracket (uniqueness is not needed here). -/
theorem exists_rutarNode_bracket_of_exact_hits
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    {x : Real} (hx : node 0 < x) :
    ∃ n : Nat, 0 < n ∧ node (n - 1) < x ∧ x ≤ node n := by
  classical
  have hexists : ∃ n : Nat, x ≤ node n :=
    rutarNode_unbounded_of_exact_hits hg offset node hnode_pos hhit x
  let n : Nat := Nat.find hexists
  have hn : x ≤ node n := Nat.find_spec hexists
  have hn0 : n ≠ 0 := by
    intro hnzero
    have hzero : x ≤ node 0 := by simpa [hnzero] using hn
    exact (not_le_of_gt hx) hzero
  have hnpos : 0 < n := Nat.pos_of_ne_zero hn0
  refine ⟨n, hnpos, ?_, hn⟩
  apply lt_of_not_ge
  intro hprev
  have hminimal : n ≤ n - 1 := Nat.find_min' hexists hprev
  exact (not_le_of_gt (Nat.sub_lt hnpos (by norm_num))) hminimal

/-- The ratio-rounding error applies at every logarithmic parameter after the
first selected node.  Its explicit upper bound is `log 2 / exp x`, which
vanishes as the physical scale tends to zero. -/
theorem exists_rutarRatioRounding_error_of_exact_hits
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    {x : Real} (hx : node 0 < x) :
    ∃ n : Nat, 0 < n ∧ node (n - 1) < x ∧ x ≤ node n ∧
      |((offset + n : Nat) : Real) * Real.log 2 / Real.exp x - g x| ≤
        Real.log 2 / Real.exp x := by
  rcases exists_rutarNode_bracket_of_exact_hits hg offset node hnode_pos hhit hx
    with ⟨n, hn, hleft, hright⟩
  refine ⟨n, hn, hleft, hright, ?_⟩
  exact rutarRatioRounding_error_of_exact_hits hg offset node hnode_pos hhit hn
    ⟨hleft, hright⟩

/-- The universal error bound in the ratio-rounding lemma tends to zero in
the logarithmic parameter. -/
theorem rutarRatioRounding_error_bound_tendsto_zero :
    Tendsto (fun x : Real => Real.log 2 / Real.exp x) atTop (𝓝 0) := by
  have hprod : Tendsto (fun x : Real => Real.log 2 * Real.exp (-x)) atTop
      (𝓝 (Real.log 2 * 0)) :=
    (tendsto_const_nhds :
      Tendsto (fun _ : Real => Real.log 2) atTop (𝓝 (Real.log 2))).mul
      Real.tendsto_exp_neg_atTop_nhds_zero
  simpa [div_eq_mul_inv, Real.exp_neg] using hprod

/-- The first exact-hit node at or beyond a given logarithmic parameter.  The
physical-gap estimate makes the selected nodes cofinal, so this is a total
choice function. -/
noncomputable def rutarExactHitIndex
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    (x : Real) : Nat :=
  Nat.find (rutarNode_unbounded_of_exact_hits hg offset node hnode_pos hhit x)

/-- The selected index is indeed at or beyond the requested parameter. -/
theorem le_node_rutarExactHitIndex
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    (x : Real) :
    x ≤ node (rutarExactHitIndex hg offset node hnode_pos hhit x) := by
  unfold rutarExactHitIndex
  exact Nat.find_spec
    (rutarNode_unbounded_of_exact_hits hg offset node hnode_pos hhit x)

/-- The first-hit index is minimal among all selected nodes beyond `x`. -/
theorem rutarExactHitIndex_minimal
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    {x : Real} {m : Nat} (hm : x ≤ node m) :
    rutarExactHitIndex hg offset node hnode_pos hhit x ≤ m := by
  unfold rutarExactHitIndex
  exact Nat.find_min' _ hm

/-- Beyond the initial knot, the canonical exact-hit index provides the
successive-node bracket used in the floor-error estimate. -/
theorem rutarExactHitIndex_bracket
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    {x : Real} (hx : node 0 < x) :
    0 < rutarExactHitIndex hg offset node hnode_pos hhit x ∧
      node (rutarExactHitIndex hg offset node hnode_pos hhit x - 1) < x ∧
        x ≤ node (rutarExactHitIndex hg offset node hnode_pos hhit x) := by
  let n := rutarExactHitIndex hg offset node hnode_pos hhit x
  have hn : x ≤ node n := le_node_rutarExactHitIndex hg offset node hnode_pos hhit x
  have hn0 : n ≠ 0 := by
    intro hnzero
    have hzero : x ≤ node 0 := by simpa [n, hnzero] using hn
    exact (not_le_of_gt hx) hzero
  have hnpos : 0 < n := Nat.pos_of_ne_zero hn0
  refine ⟨by simpa [n] using hnpos, ?_, by simpa [n] using hn⟩
  apply lt_of_not_ge
  intro hprev
  have hminimal : n ≤ n - 1 := by
    dsimp [n]
    exact rutarExactHitIndex_minimal hg offset node hnode_pos hhit hprev
  exact (not_le_of_gt (Nat.sub_lt hnpos (by norm_num))) hminimal

/-- The first exact-hit selector is monotone in the requested logarithmic
parameter. -/
theorem rutarExactHitIndex_mono
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    {x y : Real} (hxy : x ≤ y) :
    rutarExactHitIndex hg offset node hnode_pos hhit x ≤
      rutarExactHitIndex hg offset node hnode_pos hhit y := by
  apply rutarExactHitIndex_minimal hg offset node hnode_pos hhit
  exact hxy.trans (le_node_rutarExactHitIndex hg offset node hnode_pos hhit y)

/-- The canonical first exact-hit approximation to the continuous Rutar
profile.  It is the floor-error estimate expressed without an explicit
choice of a bracketing index. -/
theorem rutarExactHitIndex_ratio_error
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    {x : Real} (hx : node 0 < x) :
    |((offset + rutarExactHitIndex hg offset node hnode_pos hhit x : Nat) : Real) *
        Real.log 2 / Real.exp x - g x| ≤ Real.log 2 / Real.exp x := by
  rcases rutarExactHitIndex_bracket hg offset node hnode_pos hhit hx with
    ⟨hn, hleft, hright⟩
  exact rutarRatioRounding_error_of_exact_hits hg offset node hnode_pos hhit hn
    ⟨hleft, hright⟩

/-- The difference of two first exact-hit indices is the discrete version of
the rescaled Rutar chord.  The offset cancels exactly after the physical
logarithmic normalization. -/
theorem rutarExactHitIndex_discrete_chord_eq
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    {x tau : Real} (htau : 0 ≤ tau) :
    (((rutarExactHitIndex hg offset node hnode_pos hhit (x + tau) -
        rutarExactHitIndex hg offset node hnode_pos hhit x : Nat) : Real) * Real.log 2 /
      Real.exp (x + tau)) =
      ((offset + rutarExactHitIndex hg offset node hnode_pos hhit (x + tau) : Nat) : Real) *
          Real.log 2 / Real.exp (x + tau) -
        Real.exp (-tau) *
          (((offset + rutarExactHitIndex hg offset node hnode_pos hhit x : Nat) : Real) *
            Real.log 2 / Real.exp x) := by
  let p : Nat := rutarExactHitIndex hg offset node hnode_pos hhit x
  let q : Nat := rutarExactHitIndex hg offset node hnode_pos hhit (x + tau)
  have hpq : p ≤ q := by
    dsimp [p, q]
    exact rutarExactHitIndex_mono hg offset node hnode_pos hhit
      (le_add_of_nonneg_right htau)
  change (((q - p : Nat) : Real) * Real.log 2 / Real.exp (x + tau)) =
      ((offset + q : Nat) : Real) * Real.log 2 / Real.exp (x + tau) -
        Real.exp (-tau) * (((offset + p : Nat) : Real) * Real.log 2 / Real.exp x)
  rw [Nat.cast_sub hpq]
  have hexp : Real.exp (x + tau) = Real.exp x * Real.exp tau := by
    rw [Real.exp_add]
  have hcast : (q : Real) - (p : Real) =
      ((offset + q : Nat) : Real) - ((offset + p : Nat) : Real) := by
    norm_num [Nat.cast_add]
  rw [hexp, Real.exp_neg]
  field_simp [ne_of_gt (Real.exp_pos x), ne_of_gt (Real.exp_pos tau)]
  linarith

/-- Exact-hit rounding changes a rescaled Rutar chord by at most two binary
mass units in physical logarithmic normalization.  This is the quantitative
form of the approximation used in Rutar's spectrum formula. -/
theorem rutarExactHitIndex_discrete_chord_error
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    {x tau : Real} (hx : node 0 < x) (htau : 0 ≤ tau) :
    |(((rutarExactHitIndex hg offset node hnode_pos hhit (x + tau) -
        rutarExactHitIndex hg offset node hnode_pos hhit x : Nat) : Real) * Real.log 2 /
      Real.exp (x + tau)) -
        (g (x + tau) - Real.exp (-tau) * g x)| ≤
      2 * Real.log 2 / Real.exp (x + tau) := by
  have hxtau : node 0 < x + tau :=
    lt_of_lt_of_le hx (le_add_of_nonneg_right htau)
  have herr_x := rutarExactHitIndex_ratio_error hg offset node hnode_pos hhit hx
  have herr_xtau :=
    rutarExactHitIndex_ratio_error hg offset node hnode_pos hhit hxtau
  have hscale : Real.exp (-tau) * (Real.log 2 / Real.exp x) =
      Real.log 2 / Real.exp (x + tau) := by
    rw [Real.exp_add, Real.exp_neg]
    field_simp [ne_of_gt (Real.exp_pos x), ne_of_gt (Real.exp_pos tau)]
  let sx : Real :=
    ((offset + rutarExactHitIndex hg offset node hnode_pos hhit x : Nat) : Real) *
      Real.log 2 / Real.exp x
  let sxtau : Real :=
    ((offset + rutarExactHitIndex hg offset node hnode_pos hhit (x + tau) : Nat) : Real) *
      Real.log 2 / Real.exp (x + tau)
  have hmul : |Real.exp (-tau) * (sx - g x)| ≤
      Real.exp (-tau) * (Real.log 2 / Real.exp x) := by
    rw [abs_mul, abs_of_pos (Real.exp_pos _)]
    exact mul_le_mul_of_nonneg_left (by simpa [sx] using herr_x)
      (Real.exp_nonneg _)
  have htri : |(sxtau - g (x + tau)) -
      Real.exp (-tau) * (sx - g x)| ≤
      2 * Real.log 2 / Real.exp (x + tau) := by
    calc
      |(sxtau - g (x + tau)) - Real.exp (-tau) * (sx - g x)| ≤
          |sxtau - g (x + tau)| + |Real.exp (-tau) * (sx - g x)| :=
        calc
          |(sxtau - g (x + tau)) - Real.exp (-tau) * (sx - g x)| =
              |(sxtau - g (x + tau)) +
                (-(Real.exp (-tau) * (sx - g x)))| := by ring
          _ ≤ |sxtau - g (x + tau)| + |-(Real.exp (-tau) * (sx - g x))| :=
            abs_add_le _ _
          _ = |sxtau - g (x + tau)| + |Real.exp (-tau) * (sx - g x)| := by
            rw [abs_neg]
      _ ≤ Real.log 2 / Real.exp (x + tau) +
          Real.exp (-tau) * (Real.log 2 / Real.exp x) :=
        add_le_add (by simpa [sxtau] using herr_xtau) hmul
      _ = 2 * Real.log 2 / Real.exp (x + tau) := by rw [hscale]; ring
  rw [rutarExactHitIndex_discrete_chord_eq hg offset node hnode_pos hhit htau]
  convert htri using 1; simp only [sx, sxtau]; ring

/-- A continuous rescaled chord gives a lower bound for the logarithm of the
number of binary generations selected between its two exact-hit brackets.
Only two binary mass units are lost to rounding. -/
theorem rutarExactHit_logCard_lower_of_chord
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    {x tau : Real} (hx : node 0 < x) (htau : 0 ≤ tau) :
    Real.exp (x + tau) *
        (g (x + tau) - Real.exp (-tau) * g x) - 2 * Real.log 2 ≤
      ((rutarExactHitIndex hg offset node hnode_pos hhit (x + tau) -
        rutarExactHitIndex hg offset node hnode_pos hhit x : Nat) : Real) * Real.log 2 := by
  have herr := rutarExactHitIndex_discrete_chord_error
    hg offset node hnode_pos hhit hx htau
  have hlinear : g (x + tau) - Real.exp (-tau) * g x -
      2 * Real.log 2 / Real.exp (x + tau) ≤
      ((rutarExactHitIndex hg offset node hnode_pos hhit (x + tau) -
        rutarExactHitIndex hg offset node hnode_pos hhit x : Nat) : Real) * Real.log 2 /
          Real.exp (x + tau) := by
    have hleft := (abs_le.mp herr).1
    linarith
  have hexppos : 0 < Real.exp (x + tau) := Real.exp_pos _
  have hmul := mul_le_mul_of_nonneg_left hlinear hexppos.le
  calc
    Real.exp (x + tau) *
        (g (x + tau) - Real.exp (-tau) * g x) - 2 * Real.log 2 =
        Real.exp (x + tau) *
          (g (x + tau) - Real.exp (-tau) * g x -
             2 * Real.log 2 / Real.exp (x + tau)) := by
          field_simp [hexppos.ne']
    _ ≤ Real.exp (x + tau) *
        (((rutarExactHitIndex hg offset node hnode_pos hhit (x + tau) -
          rutarExactHitIndex hg offset node hnode_pos hhit x : Nat) : Real) *
          Real.log 2 / Real.exp (x + tau)) := hmul
    _ = ((rutarExactHitIndex hg offset node hnode_pos hhit (x + tau) -
          rutarExactHitIndex hg offset node hnode_pos hhit x : Nat) : Real) *
          Real.log 2 := by
          field_simp [hexppos.ne']

/-- Passing from the first hit at the small scale to the preceding generation
costs exactly one binary factor.  This is the lower-cardinality form that
matches the strict packing witness at the prescribed BRRS resolution. -/
theorem rutarExactHit_logCard_lower_of_chord_drop_one
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    {x tau : Real} (hx : node 0 < x) (htau : 0 ≤ tau)
    (hstrict : rutarExactHitIndex hg offset node hnode_pos hhit x <
      rutarExactHitIndex hg offset node hnode_pos hhit (x + tau)) :
    Real.exp (x + tau) *
        (g (x + tau) - Real.exp (-tau) * g x) - 3 * Real.log 2 ≤
      ((rutarExactHitIndex hg offset node hnode_pos hhit (x + tau) - 1 -
        rutarExactHitIndex hg offset node hnode_pos hhit x : Nat) : Real) *
          Real.log 2 := by
  let p : Nat := rutarExactHitIndex hg offset node hnode_pos hhit x
  let q : Nat := rutarExactHitIndex hg offset node hnode_pos hhit (x + tau)
  have hpq : p < q := by simpa [p, q] using hstrict
  have hlog := rutarExactHit_logCard_lower_of_chord
    hg offset node hnode_pos hhit hx htau
  have hsub : q - p = (q - 1 - p) + 1 := by omega
  have hcast : ((q - p : Nat) : Real) * Real.log 2 =
      ((q - 1 - p : Nat) : Real) * Real.log 2 + Real.log 2 := by
    rw [hsub]
    push_cast
    ring
  change Real.exp (x + tau) *
      (g (x + tau) - Real.exp (-tau) * g x) - 3 * Real.log 2 ≤
    ((q - 1 - p : Nat) : Real) * Real.log 2
  change Real.exp (x + tau) *
      (g (x + tau) - Real.exp (-tau) * g x) - 2 * Real.log 2 ≤
    ((q - p : Nat) : Real) * Real.log 2 at hlog
  rw [hcast] at hlog
  linarith

/-- The matching upper version of the exact-hit rounding estimate.  A
continuous chord upper bound controls the logarithm of the number of selected
binary generations, again with only two endpoint mass units lost. -/
theorem rutarExactHit_logCard_upper_of_chord
    {g gamma : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    {x tau : Real} (hx : node 0 < x) (htau : 0 ≤ tau)
    (hchord : g (x + tau) - Real.exp (-tau) * g x ≤ rutarXi gamma tau) :
    ((rutarExactHitIndex hg offset node hnode_pos hhit (x + tau) -
        rutarExactHitIndex hg offset node hnode_pos hhit x : Nat) : Real) *
        Real.log 2 ≤
      Real.exp (x + tau) * rutarXi gamma tau + 2 * Real.log 2 := by
  have herr := rutarExactHitIndex_discrete_chord_error
    hg offset node hnode_pos hhit hx htau
  have hlinear :
      ((rutarExactHitIndex hg offset node hnode_pos hhit (x + tau) -
          rutarExactHitIndex hg offset node hnode_pos hhit x : Nat) : Real) *
          Real.log 2 / Real.exp (x + tau) ≤
        rutarXi gamma tau + 2 * Real.log 2 / Real.exp (x + tau) := by
    have hright := (abs_le.mp herr).2
    linarith
  have hexppos : 0 < Real.exp (x + tau) := Real.exp_pos _
  have hmul := mul_le_mul_of_nonneg_left hlinear hexppos.le
  calc
    ((rutarExactHitIndex hg offset node hnode_pos hhit (x + tau) -
        rutarExactHitIndex hg offset node hnode_pos hhit x : Nat) : Real) *
        Real.log 2 =
        Real.exp (x + tau) *
          (((rutarExactHitIndex hg offset node hnode_pos hhit (x + tau) -
            rutarExactHitIndex hg offset node hnode_pos hhit x : Nat) : Real) *
            Real.log 2 / Real.exp (x + tau)) := by
          field_simp [hexppos.ne']
    _ ≤ Real.exp (x + tau) *
        (rutarXi gamma tau + 2 * Real.log 2 / Real.exp (x + tau)) := hmul
    _ = Real.exp (x + tau) * rutarXi gamma tau + 2 * Real.log 2 := by
      field_simp [hexppos.ne']

/-- Exponentiating the exact-hit logarithmic-cardinality estimate gives the
physical scale-ratio power which appears in the Moran cover.  This purely
analytic lemma is independent of any first-scale bracketing. -/
theorem two_pow_le_four_mul_physical_ratio_rpow_of_rutarLogCard_upper
    (m : Nat) {x tau Gamma : Real}
    (hlog : (m : Real) * Real.log 2 ≤
      Real.exp (x + tau) * rutarXi (fun _ : Real => Gamma) tau +
        2 * Real.log 2) :
    ((2 ^ m : Nat) : Real) ≤ 4 *
      ((Real.exp (-Real.exp x) / Real.exp (-Real.exp (x + tau))) ^ Gamma) := by
  have hpow : ((2 ^ m : Nat) : Real) = Real.exp ((m : Real) * Real.log 2) := by
    calc
      ((2 ^ m : Nat) : Real) = (2 : Real) ^ m := by norm_num
      _ = (Real.exp (Real.log 2)) ^ m := by
        rw [Real.exp_log (by norm_num : (0 : Real) < 2)]
      _ = Real.exp ((m : Nat) * Real.log 2) :=
        (Real.exp_nat_mul (Real.log 2) m).symm
      _ = Real.exp ((m : Real) * Real.log 2) := by norm_num
  have hratio :
      Real.exp (-Real.exp x) / Real.exp (-Real.exp (x + tau)) =
        Real.exp ((1 - Real.exp (-tau)) * Real.exp (x + tau)) := by
    rw [← Real.exp_sub]
    congr 1
    have hx : Real.exp x = Real.exp (x + tau) * Real.exp (-tau) := by
      rw [← Real.exp_add]
      congr 1
      ring
    rw [hx]
    ring
  have hfour : Real.exp (2 * Real.log 2) = 4 := by
    rw [show 2 * Real.log 2 = (2 : Nat) * Real.log 2 by norm_num,
      Real.exp_nat_mul, Real.exp_log (by norm_num : (0 : Real) < 2)]
    norm_num
  calc
    ((2 ^ m : Nat) : Real) = Real.exp ((m : Real) * Real.log 2) := hpow
    _ ≤ Real.exp (Real.exp (x + tau) * rutarXi (fun _ : Real => Gamma) tau +
        2 * Real.log 2) := Real.exp_le_exp.mpr hlog
    _ = 4 *
        ((Real.exp (-Real.exp x) / Real.exp (-Real.exp (x + tau))) ^ Gamma) := by
      rw [hratio, Real.rpow_def_of_pos (Real.exp_pos _), rutarXi,
        Real.exp_add, hfour]
      rw [Real.log_exp]
      have hA : Real.exp (x + tau) * ((1 - Real.exp (-tau)) * Gamma) =
          ((1 - Real.exp (-tau)) * Real.exp (x + tau)) * Gamma := by
        ring
      rw [hA]
      ring

/-- An eventual continuous Rutar chord upper bound passes through the exact
integer-hit rounding, with the explicit two-mass-unit error from the two
endpoint roundings. -/
theorem eventually_rutarExactHitIndex_discrete_chord_le_of_eventually_chord
    {g gamma : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    (tau : Real) (htau : 0 ≤ tau)
    (hchord : ∀ᶠ x : Real in atTop,
      g (x + tau) - Real.exp (-tau) * g x ≤ rutarXi gamma tau) :
    ∀ᶠ x : Real in atTop,
      ((rutarExactHitIndex hg offset node hnode_pos hhit (x + tau) -
          rutarExactHitIndex hg offset node hnode_pos hhit x : Nat) : Real) *
          Real.log 2 / Real.exp (x + tau) ≤
        rutarXi gamma tau + 2 * Real.log 2 / Real.exp (x + tau) := by
  have hstart : ∀ᶠ x : Real in atTop, node 0 < x :=
    Filter.eventually_gt_atTop _
  filter_upwards [hchord, hstart] with x hchord hx
  have herr := rutarExactHitIndex_discrete_chord_error hg offset node hnode_pos
    hhit hx htau
  have hleft :
      ((rutarExactHitIndex hg offset node hnode_pos hhit (x + tau) -
          rutarExactHitIndex hg offset node hnode_pos hhit x : Nat) : Real) *
          Real.log 2 / Real.exp (x + tau) -
        (g (x + tau) - Real.exp (-tau) * g x) ≤
        2 * Real.log 2 / Real.exp (x + tau) :=
    (le_abs_self _).trans herr
  linarith

/-- At an active Rutar block, the strict lower packing witness has the
prescribed logarithmic cardinality, up to the three unavoidable endpoint
binary mass units (two for rounding and one for strict separation). -/
theorem rutarConcatenation_exactHit_lower_logCard_at_theta
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass (rutarConcatenation gamma) (node j) =
        ((offset + j : Nat) : Real))
    {theta : Real} (htheta : theta ∈ Ioo (0 : Real) 1)
    (n : Nat) (hstart : node 0 < rutarPieceStart (2 * n))
    (hlen : -Real.log theta < ((n + 1 : Nat) : Real))
    (hstrict : rutarExactHitIndex (rutarConcatenation_isRutarGOn hgamma)
        offset node hnode_pos hhit (rutarPieceStart (2 * n)) <
      rutarExactHitIndex (rutarConcatenation_isRutarGOn hgamma)
        offset node hnode_pos hhit (rutarPieceStart (2 * n) - Real.log theta)) :
    Real.exp (rutarPieceStart (2 * n) - Real.log theta) *
        ((1 - theta) * gamma theta) - 3 * Real.log 2 ≤
      ((rutarExactHitIndex (rutarConcatenation_isRutarGOn hgamma)
          offset node hnode_pos hhit
          (rutarPieceStart (2 * n) - Real.log theta) - 1 -
        rutarExactHitIndex (rutarConcatenation_isRutarGOn hgamma)
          offset node hnode_pos hhit (rutarPieceStart (2 * n)) : Nat) : Real) *
          Real.log 2 := by
  have htau : 0 < -Real.log theta :=
    neg_pos.mpr (Real.log_neg htheta.1 htheta.2)
  have hxi : rutarXi gamma (-Real.log theta) =
      (1 - theta) * gamma theta := by
    unfold rutarXi
    have hneg : -(-Real.log theta) = Real.log theta := by ring
    rw [hneg, Real.exp_log htheta.1]
  have hlog := rutarExactHit_logCard_lower_of_chord_drop_one
    (rutarConcatenation_isRutarGOn hgamma) offset node hnode_pos hhit
    hstart htau.le hstrict
  rw [rutarConcatenation_active_chord n htau hlen, hxi] at hlog
  simpa [sub_eq_add_neg] using hlog

/-- The preceding discrete-chord estimate applied to an active Rutar block.
The continuous chord is exactly `rutarXi`, so the integer generation count
approximates that prescribed potential with an explicit vanishing error. -/
theorem rutarConcatenation_exactHitIndex_discrete_chord_error
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass (rutarConcatenation gamma) (node j) =
        ((offset + j : Nat) : Real))
    (n : Nat) {tau : Real}
    (hstart : node 0 < rutarPieceStart (2 * n))
    (htau : 0 < tau) (htau_len : tau < ((n + 1 : Nat) : Real)) :
    |((rutarExactHitIndex (rutarConcatenation_isRutarGOn hgamma)
          offset node hnode_pos hhit
          (rutarPieceStart (2 * n) + tau) -
        rutarExactHitIndex (rutarConcatenation_isRutarGOn hgamma)
          offset node hnode_pos hhit (rutarPieceStart (2 * n)) : Nat) : Real) *
        Real.log 2 / Real.exp (rutarPieceStart (2 * n) + tau) -
        rutarXi gamma tau| ≤
      2 * Real.log 2 / Real.exp (rutarPieceStart (2 * n) + tau) := by
  have h := rutarExactHitIndex_discrete_chord_error
    (rutarConcatenation_isRutarGOn hgamma) offset node hnode_pos hhit
    hstart htau.le
  rw [rutarConcatenation_active_chord n htau htau_len] at h
  exact h

/-- The starts of the active Rutar pieces are cofinal on the positive
logarithmic axis. -/
theorem tendsto_rutarActiveStart_atTop :
    Tendsto (fun n : Nat => rutarPieceStart (2 * n)) atTop atTop := by
  have htwice : Tendsto (fun n : Nat => 2 * n) atTop atTop :=
    tendsto_atTop.2 (by
      intro b
      exact Filter.eventually_atTop.2 ⟨b, fun n hn => by omega⟩)
  exact tendsto_rutarPieceStart_atTop.comp htwice

/-- At every sufficiently late active block, the canonical two-endpoint
rounding has the sharp active-chord error bound. -/
theorem eventually_rutarConcatenation_exactHitIndex_discrete_chord_error
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass (rutarConcatenation gamma) (node j) =
        ((offset + j : Nat) : Real))
    {tau : Real} (htau : 0 < tau) :
    ∀ᶠ n : Nat in atTop,
      |((rutarExactHitIndex (rutarConcatenation_isRutarGOn hgamma)
            offset node hnode_pos hhit
            (rutarPieceStart (2 * n) + tau) -
          rutarExactHitIndex (rutarConcatenation_isRutarGOn hgamma)
            offset node hnode_pos hhit (rutarPieceStart (2 * n)) : Nat) : Real) *
          Real.log 2 / Real.exp (rutarPieceStart (2 * n) + tau) -
          rutarXi gamma tau| ≤
        2 * Real.log 2 / Real.exp (rutarPieceStart (2 * n) + tau) := by
  have hstart : ∀ᶠ n : Nat in atTop,
      node 0 < rutarPieceStart (2 * n) :=
    tendsto_rutarActiveStart_atTop.eventually_gt_atTop (node 0)
  have hlong : ∀ᶠ n : Nat in atTop, tau < (n : Real) :=
    tendsto_natCast_atTop_atTop.eventually_gt_atTop tau
  filter_upwards [hstart, hlong] with n hnstart hnlong
  apply rutarConcatenation_exactHitIndex_discrete_chord_error hgamma
    offset node hnode_pos hhit n hnstart htau
  exact lt_of_lt_of_le hnlong (by norm_num)

/-- Along the cofinal active blocks, the normalized difference of the two
rounded integer generations converges to the prescribed Rutar potential.
This is the exact asymptotic node-pair/rounding match needed before converting
the finite generation counts into lower Assouad-spectrum witnesses. -/
theorem tendsto_rutarConcatenation_exactHitIndex_discrete_chord
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass (rutarConcatenation gamma) (node j) =
        ((offset + j : Nat) : Real))
    {tau : Real} (htau : 0 < tau) :
    Tendsto
      (fun n : Nat =>
        ((rutarExactHitIndex (rutarConcatenation_isRutarGOn hgamma)
              offset node hnode_pos hhit
              (rutarPieceStart (2 * n) + tau) -
            rutarExactHitIndex (rutarConcatenation_isRutarGOn hgamma)
              offset node hnode_pos hhit (rutarPieceStart (2 * n)) : Nat) : Real) *
            Real.log 2 / Real.exp (rutarPieceStart (2 * n) + tau) -
          rutarXi gamma tau)
      atTop (𝓝 0) := by
  let f : Nat → Real := fun n =>
    ((rutarExactHitIndex (rutarConcatenation_isRutarGOn hgamma)
          offset node hnode_pos hhit
          (rutarPieceStart (2 * n) + tau) -
        rutarExactHitIndex (rutarConcatenation_isRutarGOn hgamma)
          offset node hnode_pos hhit (rutarPieceStart (2 * n)) : Nat) : Real) *
        Real.log 2 / Real.exp (rutarPieceStart (2 * n) + tau) -
      rutarXi gamma tau
  have herr : ∀ᶠ n : Nat in atTop,
      |f n| ≤ 2 * Real.log 2 / Real.exp (rutarPieceStart (2 * n) + tau) := by
    simpa [f] using
      (eventually_rutarConcatenation_exactHitIndex_discrete_chord_error
        hgamma offset node hnode_pos hhit htau)
  have hparameter : Tendsto
      (fun n : Nat => rutarPieceStart (2 * n) + tau) atTop atTop :=
    tendsto_rutarActiveStart_atTop.atTop_add tendsto_const_nhds
  have hbase : Tendsto
      (fun n : Nat => Real.log 2 /
        Real.exp (rutarPieceStart (2 * n) + tau)) atTop (𝓝 0) :=
    rutarRatioRounding_error_bound_tendsto_zero.comp hparameter
  have hbound : Tendsto
      (fun n : Nat => 2 * Real.log 2 /
        Real.exp (rutarPieceStart (2 * n) + tau)) atTop (𝓝 0) := by
    have htwo : Tendsto (fun _ : Nat => (2 : Real)) atTop (𝓝 2) :=
      tendsto_const_nhds
    simpa [mul_div_assoc] using htwo.mul hbase
  have habs : Tendsto (fun n : Nat => |f n|) atTop (𝓝 0) := by
    apply squeeze_zero'
    · exact Filter.Eventually.of_forall fun n => abs_nonneg (f n)
    · exact herr
    · exact hbound
  have hnorm : Tendsto (fun n : Nat => ‖f n‖) atTop (𝓝 0) := by
    simpa only [Real.norm_eq_abs] using habs
  simpa [f] using (tendsto_zero_iff_norm_tendsto_zero.mpr hnorm)

/-! ### Variable-ratio binary Moran scales -/

/-- The contraction data for the homogeneous binary Moran sets used in
Rutar's realization theorem.  At stage `n` each parent interval is replaced
by its left and right children, both with relative length `ratio n`. -/
structure BinaryMoranData where
  ratio : Nat → Real
  ratio_pos : ∀ n : Nat, 0 < ratio n
  ratio_le_half : ∀ n : Nat, ratio n ≤ 1 / 2

namespace BinaryMoranData

/-- The common length of the level-`n` Moran cylinders. -/
def scale (D : BinaryMoranData) : Nat → Real
  | 0 => 1
  | n + 1 => D.scale n * D.ratio n

@[simp]
theorem scale_zero (D : BinaryMoranData) : D.scale 0 = 1 := rfl

@[simp]
theorem scale_succ (D : BinaryMoranData) (n : Nat) :
    D.scale (n + 1) = D.scale n * D.ratio n := rfl

/-- Turn a sequence of physical logarithmic cylinder lengths into binary
Moran contractions.  A gap of at least `log 2` is exactly the condition that
the associated contraction be at most one half.  This is the discrete
rounding map in Rutar's construction. -/
noncomputable def ofLogGaps (ell : Nat → Real)
    (hgap : ∀ n : Nat, Real.log 2 ≤ ell (n + 1) - ell n) : BinaryMoranData where
  ratio n := Real.exp (-(ell (n + 1) - ell n))
  ratio_pos n := Real.exp_pos _
  ratio_le_half n := by
    calc
      Real.exp (-(ell (n + 1) - ell n)) ≤ Real.exp (-Real.log 2) :=
        (Real.exp_le_exp).mpr (neg_le_neg (hgap n))
      _ = 1 / 2 := by
        rw [Real.exp_neg, Real.exp_log (by norm_num : 0 < (2 : Real))]
        norm_num

/-- The scale of the Moran data obtained by rounding logarithmic gaps
telescopes exactly. -/
theorem scale_ofLogGaps (ell : Nat → Real)
    (hgap : ∀ n : Nat, Real.log 2 ≤ ell (n + 1) - ell n)
    (n : Nat) :
    (ofLogGaps ell hgap).scale n = Real.exp (ell 0 - ell n) := by
  induction n with
  | zero => simp [scale]
  | succ n ih =>
      rw [scale_succ, ih]
      change Real.exp (ell 0 - ell n) *
        Real.exp (-(ell (n + 1) - ell n)) =
          Real.exp (ell 0 - ell (n + 1))
      rw [← Real.exp_add]
      congr 1
      ring

/-- Every cylinder scale is strictly positive. -/
theorem scale_pos (D : BinaryMoranData) (n : Nat) : 0 < D.scale n := by
  induction n with
  | zero => simp [scale]
  | succ n hn =>
      simpa [scale] using mul_pos hn (D.ratio_pos n)

theorem scale_nonneg (D : BinaryMoranData) (n : Nat) : 0 ≤ D.scale n :=
  (D.scale_pos n).le

theorem ratio_lt_one (D : BinaryMoranData) (n : Nat) : D.ratio n < 1 :=
  lt_of_le_of_lt (D.ratio_le_half n) (by norm_num)

/-- Cylinder lengths strictly decrease from one generation to the next. -/
theorem scale_succ_lt (D : BinaryMoranData) (n : Nat) :
    D.scale (n + 1) < D.scale n := by
  calc
    D.scale (n + 1) = D.scale n * D.ratio n := rfl
    _ < D.scale n * 1 :=
      mul_lt_mul_of_pos_left (D.ratio_lt_one n) (D.scale_pos n)
    _ = D.scale n := by ring

/-- The relative length accumulated over `m` stages beginning at generation
`i`.  This indexed version is the scale of every depth-`m` subtree below a
level-`i` cylinder. -/
def scaleFrom (D : BinaryMoranData) (i : Nat) : Nat → Real
  | 0 => 1
  | m + 1 => D.scaleFrom i m * D.ratio (i + m)

@[simp]
theorem scaleFrom_zero (D : BinaryMoranData) (i : Nat) :
    D.scaleFrom i 0 = 1 := rfl

@[simp]
theorem scaleFrom_succ (D : BinaryMoranData) (i m : Nat) :
    D.scaleFrom i (m + 1) = D.scaleFrom i m * D.ratio (i + m) := rfl

theorem scaleFrom_pos (D : BinaryMoranData) (i m : Nat) :
    0 < D.scaleFrom i m := by
  induction m with
  | zero => simp [scaleFrom]
  | succ m hm =>
      simpa [scaleFrom] using mul_pos hm (D.ratio_pos (i + m))

theorem scaleFrom_nonneg (D : BinaryMoranData) (i m : Nat) :
    0 ≤ D.scaleFrom i m := (D.scaleFrom_pos i m).le

/-- Global scales factor exactly into an ancestor length and a relative
subtree length. -/
theorem scale_add (D : BinaryMoranData) (i m : Nat) :
    D.scale (i + m) = D.scale i * D.scaleFrom i m := by
  induction m with
  | zero => simp
  | succ m hm =>
      calc
        D.scale (i + (m + 1)) = D.scale (i + m) * D.ratio (i + m) := by
          simpa [Nat.add_assoc] using D.scale_succ (i + m)
        _ = (D.scale i * D.scaleFrom i m) * D.ratio (i + m) := by rw [hm]
        _ = D.scale i * (D.scaleFrom i m * D.ratio (i + m)) := by ring
        _ = D.scale i * D.scaleFrom i (m + 1) := by rw [D.scaleFrom_succ]

/-- The indexed scale with initial index zero is the global cylinder scale. -/
theorem scale_eq_scaleFrom_zero (D : BinaryMoranData) (m : Nat) :
    D.scale m = D.scaleFrom 0 m := by
  simpa using D.scale_add 0 m

/-- Every relative Moran scale is at most one. -/
theorem scaleFrom_le_one (D : BinaryMoranData) (i m : Nat) :
    D.scaleFrom i m ≤ 1 := by
  induction m with
  | zero => simp [scaleFrom]
  | succ m hm =>
      calc
        D.scaleFrom i (m + 1) = D.scaleFrom i m * D.ratio (i + m) := rfl
        _ ≤ 1 * D.ratio (i + m) :=
          mul_le_mul_of_nonneg_right hm (D.ratio_pos (i + m)).le
        _ ≤ 1 := by nlinarith [D.ratio_le_half (i + m)]

/-- Every positive-depth relative Moran scale is strictly below one. -/
theorem scaleFrom_lt_one (D : BinaryMoranData) (i m : Nat)
    (hm : 0 < m) : D.scaleFrom i m < 1 := by
  obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hm)
  calc
    D.scaleFrom i (n + 1) = D.scaleFrom i n * D.ratio (i + n) := rfl
    _ ≤ 1 * D.ratio (i + n) :=
      mul_le_mul_of_nonneg_right (D.scaleFrom_le_one i n)
        (D.ratio_pos (i + n)).le
    _ < 1 * 1 :=
      mul_lt_mul_of_pos_left (D.ratio_lt_one (i + n)) (by norm_num)
    _ = 1 := by ring

/-- The logarithm of a positive-depth relative scale has the expected sign. -/
theorem neg_log_scaleFrom_pos (D : BinaryMoranData) (i m : Nat)
    (hm : 0 < m) : 0 < -Real.log (D.scaleFrom i m) := by
  exact neg_pos.mpr (Real.log_neg (D.scaleFrom_pos i m)
    (D.scaleFrom_lt_one i m hm))

/-- Logarithmic branching density between two generations. -/
noncomputable def blockLogDensity (D : BinaryMoranData) (p q : Nat) : Real :=
  ((q - p : Nat) : Real) * Real.log 2 /
    (-Real.log (D.scaleFrom p (q - p)))

/-- A uniform upper bound for the logarithmic branching density of every
positive-depth Moran block. -/
def HasUniformBlockLogDensityBound (D : BinaryMoranData) (gamma : Real) : Prop :=
  ∀ {p q : Nat}, p < q → D.blockLogDensity p q ≤ gamma

/-- A positive lower bound for all one-step contractions.  This is the scale
regularity hypothesis which permits arbitrary physical radii to be bracketed
by Moran generations with a uniform loss. -/
def HasUniformRatioLowerBound (D : BinaryMoranData) (kappa : Real) : Prop :=
  0 < kappa ∧ ∀ n : Nat, kappa ≤ D.ratio n

theorem blockLogDensity_mul_logScale (D : BinaryMoranData)
    {p q : Nat} (hpq : p < q) :
    D.blockLogDensity p q *
      (-Real.log (D.scaleFrom p (q - p))) =
        ((q - p : Nat) : Real) * Real.log 2 := by
  unfold blockLogDensity
  exact div_mul_cancel₀ _ (ne_of_gt (D.neg_log_scaleFrom_pos p (q - p)
    (Nat.sub_pos_of_lt hpq)))

theorem log_descendant_card (p q : Nat) :
    Real.log ((2 ^ (q - p) : Nat) : Real) =
      ((q - p : Nat) : Real) * Real.log 2 := by
  rw [Nat.cast_pow, Real.log_pow]
  norm_num

theorem log_descendant_card_eq_blockLogDensity (D : BinaryMoranData)
    {p q : Nat} (hpq : p < q) :
    Real.log ((2 ^ (q - p) : Nat) : Real) =
      D.blockLogDensity p q *
        (-Real.log (D.scaleFrom p (q - p))) := by
  rw [log_descendant_card]
  exact (D.blockLogDensity_mul_logScale hpq).symm

/-- The exact finite-scale cardinality is a power of the reciprocal relative
cylinder length with exponent `blockLogDensity`. -/
theorem descendant_card_eq_rpow_neg_blockLogDensity
    (D : BinaryMoranData) {p q : Nat} (hpq : p < q) :
    ((2 ^ (q - p) : Nat) : Real) =
      (D.scaleFrom p (q - p)) ^ (-D.blockLogDensity p q) := by
  rw [Real.rpow_def_of_pos (D.scaleFrom_pos p (q - p))]
  rw [← Real.exp_log (by positivity : 0 < ((2 ^ (q - p) : Nat) : Real))]
  congr 1
  calc
    Real.log ((2 ^ (q - p) : Nat) : Real) =
        D.blockLogDensity p q *
          (-Real.log (D.scaleFrom p (q - p))) :=
      D.log_descendant_card_eq_blockLogDensity hpq
    _ = Real.log (D.scaleFrom p (q - p)) * (-D.blockLogDensity p q) := by
      ring

/-- Relative scale equals the quotient of the two global cylinder scales. -/
theorem scale_div_eq_scaleFrom_sub (D : BinaryMoranData) {p q : Nat}
    (hpq : p ≤ q) : D.scale q / D.scale p = D.scaleFrom p (q - p) := by
  have hq : q = p + (q - p) := (Nat.add_sub_of_le hpq).symm
  rw [hq, D.scale_add]
  simpa using
    (mul_div_cancel_left₀ (D.scaleFrom p (q - p)) (D.scale_pos p).ne')

/-- Relative scales for data produced from logarithmic gaps telescope between
arbitrary generations, not only from the root. -/
theorem scaleFrom_ofLogGaps (ell : Nat → Real)
    (hgap : ∀ n : Nat, Real.log 2 ≤ ell (n + 1) - ell n)
    {p q : Nat} (hpq : p ≤ q) :
    (ofLogGaps ell hgap).scaleFrom p (q - p) = Real.exp (ell p - ell q) := by
  calc
    (ofLogGaps ell hgap).scaleFrom p (q - p) =
        (ofLogGaps ell hgap).scale q / (ofLogGaps ell hgap).scale p :=
      ((ofLogGaps ell hgap).scale_div_eq_scaleFrom_sub hpq).symm
    _ = Real.exp (ell 0 - ell q) / Real.exp (ell 0 - ell p) := by
      rw [scale_ofLogGaps ell hgap q, scale_ofLogGaps ell hgap p]
    _ = Real.exp ((ell 0 - ell q) - (ell 0 - ell p)) :=
      (Real.exp_sub _ _).symm
    _ = Real.exp (ell p - ell q) := by congr 1; ring

/-- The logarithmic size of an arbitrary rounded Moran block is exactly the
difference of its prescribed physical-logarithmic endpoints. -/
theorem neg_log_scaleFrom_ofLogGaps (ell : Nat → Real)
    (hgap : ∀ n : Nat, Real.log 2 ≤ ell (n + 1) - ell n)
    {p q : Nat} (hpq : p ≤ q) :
    -Real.log ((ofLogGaps ell hgap).scaleFrom p (q - p)) = ell q - ell p := by
  rw [scaleFrom_ofLogGaps ell hgap hpq, Real.log_exp]
  ring

/-- Consequently, the exact logarithmic branching density of a rounded block
is the quotient of its generation count by the prescribed physical-logarithmic
gap. -/
theorem blockLogDensity_ofLogGaps (ell : Nat → Real)
    (hgap : ∀ n : Nat, Real.log 2 ≤ ell (n + 1) - ell n)
    {p q : Nat} (hpq : p < q) :
    (ofLogGaps ell hgap).blockLogDensity p q =
      ((q - p : Nat) : Real) * Real.log 2 / (ell q - ell p) := by
  unfold blockLogDensity
  rw [neg_log_scaleFrom_ofLogGaps ell hgap hpq.le]

/-- A positive-depth binary block has strictly positive logarithmic
branching density. -/
theorem blockLogDensity_pos (D : BinaryMoranData) {p q : Nat}
    (hpq : p < q) : 0 < D.blockLogDensity p q := by
  unfold blockLogDensity
  apply div_pos
  · exact mul_pos (Nat.cast_pos.mpr (Nat.sub_pos_of_lt hpq))
      (Real.log_pos (by norm_num))
  · exact D.neg_log_scaleFrom_pos p (q - p) (Nat.sub_pos_of_lt hpq)

/-- A logarithmic density upper bound is equivalently a power upper bound
for the exact finite descendant cardinality, expressed using global Moran
scales. -/
theorem descendant_card_le_rpow_scale_ratio_of_blockLogDensity_le
    (D : BinaryMoranData) {p q : Nat} (hpq : p ≤ q) {gamma : Real}
    (hdensity : D.blockLogDensity p q ≤ gamma) :
    ((2 ^ (q - p) : Nat) : Real) ≤ (D.scale p / D.scale q) ^ gamma := by
  by_cases hpq_eq : p = q
  · subst q
    simp [div_self (D.scale_pos p).ne']
  have hpq_lt : p < q := lt_of_le_of_ne hpq hpq_eq
  let s := D.scaleFrom p (q - p)
  have hspos : 0 < s := D.scaleFrom_pos p (q - p)
  have hsle : s ≤ 1 := D.scaleFrom_le_one p (q - p)
  have hsinv : 1 ≤ s⁻¹ := (one_le_inv₀ hspos).mpr hsle
  have hpow : s⁻¹ ^ D.blockLogDensity p q ≤ s⁻¹ ^ gamma :=
    Real.rpow_le_rpow_of_exponent_le hsinv hdensity
  have hcard : ((2 ^ (q - p) : Nat) : Real) =
      s⁻¹ ^ D.blockLogDensity p q := by
    calc
      ((2 ^ (q - p) : Nat) : Real) =
          D.scaleFrom p (q - p) ^ (-D.blockLogDensity p q) :=
        D.descendant_card_eq_rpow_neg_blockLogDensity hpq_lt
      _ = s ^ (-D.blockLogDensity p q) := by rfl
      _ = (s ^ D.blockLogDensity p q)⁻¹ := by rw [Real.rpow_neg hspos.le]
      _ = s⁻¹ ^ D.blockLogDensity p q := by rw [Real.inv_rpow hspos.le]
  have hratio : D.scale p / D.scale q = s⁻¹ := by
    have hquot : D.scale q / D.scale p = D.scaleFrom p (q - p) :=
      D.scale_div_eq_scaleFrom_sub hpq
    calc
      D.scale p / D.scale q = (D.scale q / D.scale p)⁻¹ := by
        field_simp [(D.scale_pos p).ne', (D.scale_pos q).ne']
      _ = s⁻¹ := by rw [hquot]
  calc
    ((2 ^ (q - p) : Nat) : Real) = s⁻¹ ^ D.blockLogDensity p q := hcard
    _ ≤ s⁻¹ ^ gamma := hpow
    _ = (D.scale p / D.scale q) ^ gamma := by rw [hratio]

/-- Factoring the first contraction from a relative cylinder scale. -/
theorem scaleFrom_first (D : BinaryMoranData) (i m : Nat) :
    D.scaleFrom i (m + 1) = D.ratio i * D.scaleFrom (i + 1) m := by
  induction m with
  | zero => simp [scaleFrom]
  | succ m hm =>
      rw [D.scaleFrom_succ, hm, D.scaleFrom_succ]
      ring

/-- Relative scales split at every intermediate generation. -/
theorem scaleFrom_add (D : BinaryMoranData) (i m n : Nat) :
    D.scaleFrom i (m + n) =
      D.scaleFrom i m * D.scaleFrom (i + m) n := by
  induction n with
  | zero => simp [scaleFrom]
  | succ n hn =>
      calc
        D.scaleFrom i (m + (n + 1)) =
            D.scaleFrom i (m + n) * D.ratio (i + (m + n)) := by
              simpa [Nat.add_assoc] using D.scaleFrom_succ i (m + n)
        _ = (D.scaleFrom i m * D.scaleFrom (i + m) n) *
            D.ratio ((i + m) + n) := by
              rw [hn]
              have hindex : i + (m + n) = (i + m) + n := by omega
              rw [hindex]
        _ = D.scaleFrom i m * D.scaleFrom (i + m) (n + 1) := by
              rw [D.scaleFrom_succ]
              ring

/-- Local subtree scales inherit the uniform half-contraction. -/
theorem scaleFrom_le_half_pow (D : BinaryMoranData) (i m : Nat) :
    D.scaleFrom i m ≤ ((1 / 2 : Real) ^ m) := by
  induction m with
  | zero => norm_num [scaleFrom]
  | succ m hm =>
      calc
        D.scaleFrom i (m + 1) = D.scaleFrom i m * D.ratio (i + m) := rfl
        _ ≤ D.scaleFrom i m * (1 / 2) :=
          mul_le_mul_of_nonneg_left (D.ratio_le_half (i + m))
            (D.scaleFrom_nonneg i m)
        _ ≤ ((1 / 2 : Real) ^ m) * (1 / 2) :=
          mul_le_mul_of_nonneg_right hm (by norm_num)
        _ = (1 / 2 : Real) ^ (m + 1) := by rw [pow_succ]

/-- The left endpoints of the depth-`m` binary Moran subcylinders inside an
interval with left endpoint `u` and length `L`.  The indexed formulation
keeps the tail ratios visible, which is essential for the local cylinder
counts in Rutar's variable-ratio argument. -/
noncomputable def starts (D : BinaryMoranData) :
    Nat → Nat → Real → Real → Finset Real
  | _, 0, u, _ => {u}
  | i, m + 1, u, L =>
      (D.starts (i + 1) m u (D.ratio i * L)) ∪
        (D.starts (i + 1) m (u + (1 - D.ratio i) * L) (D.ratio i * L))

@[simp]
theorem starts_zero (D : BinaryMoranData) (i : Nat) (u L : Real) :
    D.starts i 0 u L = {u} := rfl

@[simp]
theorem starts_succ (D : BinaryMoranData) (i m : Nat) (u L : Real) :
    D.starts i (m + 1) u L =
      (D.starts (i + 1) m u (D.ratio i * L)) ∪
        (D.starts (i + 1) m (u + (1 - D.ratio i) * L) (D.ratio i * L)) := rfl

/-- The left endpoint of the parent interval persists through every binary
Moran refinement. -/
theorem base_mem_starts (D : BinaryMoranData) (i m : Nat) (u L : Real) :
    u ∈ D.starts i m u L := by
  induction m generalizing i u L with
  | zero => simp [starts]
  | succ m hm =>
      rw [D.starts_succ]
      exact Finset.mem_union_left _ (hm (i + 1) u (D.ratio i * L))

/-- Every finite Moran endpoint stays in its parent interval, with the
remaining right-hand gap recorded at the exact descendant-cylinder scale. -/
theorem starts_mem_bounds (D : BinaryMoranData) (i m : Nat) (u L : Real)
    (hL : 0 ≤ L) {x : Real} (hx : x ∈ D.starts i m u L) :
    u ≤ x ∧ x ≤ u + L - D.scaleFrom i m * L := by
  induction m generalizing i u L with
  | zero =>
      have hx' : x = u := by simpa [starts] using hx
      subst x
      constructor
      · exact le_rfl
      · simp [scaleFrom]
  | succ m hm =>
      rw [D.starts_succ] at hx
      rcases Finset.mem_union.mp hx with hx | hx
      · have hchildL : 0 ≤ D.ratio i * L :=
          mul_nonneg (D.ratio_pos i).le hL
        rcases hm (i + 1) u (D.ratio i * L) hchildL hx with
          ⟨hlower, hupper⟩
        have hratioL : D.ratio i * L ≤ L := by
          calc
            D.ratio i * L ≤ 1 * L :=
              mul_le_mul_of_nonneg_right
                (le_trans (D.ratio_le_half i) (by norm_num)) hL
            _ = L := by ring
        have hscale :
            D.scaleFrom (i + 1) m * (D.ratio i * L) =
              D.scaleFrom i (m + 1) * L := by
          rw [D.scaleFrom_first]
          ring
        refine ⟨hlower, ?_⟩
        calc
          x ≤ u + D.ratio i * L -
              D.scaleFrom (i + 1) m * (D.ratio i * L) := hupper
          _ ≤ u + L - D.scaleFrom (i + 1) m * (D.ratio i * L) :=
            by
              apply sub_le_sub_right
              simpa [add_comm] using add_le_add_left hratioL u
          _ = u + L - D.scaleFrom i (m + 1) * L := by rw [hscale]
      · have hchildL : 0 ≤ D.ratio i * L :=
          mul_nonneg (D.ratio_pos i).le hL
        let u' : Real := u + (1 - D.ratio i) * L
        rcases hm (i + 1) u' (D.ratio i * L) hchildL hx with
          ⟨hlower, hupper⟩
        have hshift : 0 ≤ (1 - D.ratio i) * L := by
          apply mul_nonneg
          · exact sub_nonneg.mpr
              (le_trans (D.ratio_le_half i) (by norm_num))
          · exact hL
        have hscale :
            D.scaleFrom (i + 1) m * (D.ratio i * L) =
              D.scaleFrom i (m + 1) * L := by
          rw [D.scaleFrom_first]
          ring
        refine ⟨?_, ?_⟩
        · exact (le_add_of_nonneg_right hshift).trans (by simpa [u'] using hlower)
        · calc
            x ≤ u' + D.ratio i * L -
                D.scaleFrom (i + 1) m * (D.ratio i * L) := hupper
            _ = u + L - D.scaleFrom (i + 1) m * (D.ratio i * L) := by
              dsimp [u']
              ring
            _ = u + L - D.scaleFrom i (m + 1) * L := by rw [hscale]

/-- The child-cylinder scale rewrite used throughout the finite Moran
geometry. -/
theorem scaleFrom_child_mul (D : BinaryMoranData) (i m : Nat) (L : Real) :
    D.scaleFrom (i + 1) m * (D.ratio i * L) =
      D.scaleFrom i (m + 1) * L := by
  rw [D.scaleFrom_first]
  ring

/-- Distinct level-`m` left endpoints are separated by one full descendant
cylinder length. -/
theorem starts_separated (D : BinaryMoranData) (i m : Nat) (u L : Real)
    (hL : 0 ≤ L) {x y : Real} (hx : x ∈ D.starts i m u L)
    (hy : y ∈ D.starts i m u L) (hxy : x ≠ y) :
    D.scaleFrom i m * L ≤ |x - y| := by
  induction m generalizing i u L with
  | zero =>
      have hx' : x = u := by simpa [starts] using hx
      have hy' : y = u := by simpa [starts] using hy
      exact absurd (hx'.trans hy'.symm) hxy
  | succ m hm =>
      have hchildL : 0 ≤ D.ratio i * L :=
        mul_nonneg (D.ratio_pos i).le hL
      have hpos : 0 ≤ D.scaleFrom i (m + 1) * L :=
        mul_nonneg (D.scaleFrom_pos i (m + 1)).le hL
      have hscale := D.scaleFrom_child_mul i m L
      rw [D.starts_succ, Finset.mem_union] at hx hy
      rcases hx with hx | hx
      · rcases hy with hy | hy
        · have h := hm (i + 1) u (D.ratio i * L) hchildL hx hy
          rwa [hscale] at h
        · obtain ⟨_, hxupper⟩ :=
            D.starts_mem_bounds (i + 1) m u (D.ratio i * L) hchildL hx
          obtain ⟨hylower, _⟩ := D.starts_mem_bounds (i + 1) m
            (u + (1 - D.ratio i) * L) (D.ratio i * L) hchildL hy
          rw [hscale] at hxupper
          have hgapweight : 0 ≤ (1 - 2 * D.ratio i) * L := by
            apply mul_nonneg
            · linarith [D.ratio_le_half i]
            · exact hL
          have hgap : D.scaleFrom i (m + 1) * L ≤ y - x := by
            nlinarith [hxupper, hylower, hgapweight]
          rw [abs_sub_comm, abs_of_nonneg (by linarith : 0 ≤ y - x)]
          exact hgap
      · rcases hy with hy | hy
        · obtain ⟨hxlower, _⟩ := D.starts_mem_bounds (i + 1) m
            (u + (1 - D.ratio i) * L) (D.ratio i * L) hchildL hx
          obtain ⟨_, hyupper⟩ :=
            D.starts_mem_bounds (i + 1) m u (D.ratio i * L) hchildL hy
          rw [hscale] at hyupper
          have hgapweight : 0 ≤ (1 - 2 * D.ratio i) * L := by
            apply mul_nonneg
            · linarith [D.ratio_le_half i]
            · exact hL
          have hgap : D.scaleFrom i (m + 1) * L ≤ x - y := by
            nlinarith [hxlower, hyupper, hgapweight]
          rw [abs_of_nonneg (by linarith : 0 ≤ x - y)]
          exact hgap
        · have h := hm (i + 1) (u + (1 - D.ratio i) * L)
            (D.ratio i * L) hchildL hx hy
          rwa [hscale] at h

/-- The binary Moran construction has exactly `2^m` distinct level-`m`
left endpoints whenever the root interval has positive length. -/
theorem starts_card (D : BinaryMoranData) (i m : Nat) (u L : Real)
    (hL : 0 < L) : (D.starts i m u L).card = 2 ^ m := by
  induction m generalizing i u L with
  | zero => simp [starts]
  | succ m hm =>
      have hchildL : 0 < D.ratio i * L := mul_pos (D.ratio_pos i) hL
      have hdisj : Disjoint (D.starts (i + 1) m u (D.ratio i * L))
          (D.starts (i + 1) m (u + (1 - D.ratio i) * L)
            (D.ratio i * L)) := by
        rw [Finset.disjoint_left]
        intro x hx hx'
        obtain ⟨_, hxupper⟩ := D.starts_mem_bounds (i + 1) m u
          (D.ratio i * L) hchildL.le hx
        obtain ⟨hxlower, _⟩ := D.starts_mem_bounds (i + 1) m
          (u + (1 - D.ratio i) * L) (D.ratio i * L) hchildL.le hx'
        have hpos : 0 < D.scaleFrom (i + 1) m * (D.ratio i * L) :=
          mul_pos (D.scaleFrom_pos (i + 1) m) hchildL
        have hgapweight : 0 ≤ (1 - 2 * D.ratio i) * L := by
          apply mul_nonneg
          · linarith [D.ratio_le_half i]
          · exact hL.le
        nlinarith [hxupper, hxlower, hpos, hgapweight]
      rw [D.starts_succ, Finset.card_union_of_disjoint hdisj,
        hm (i + 1) u (D.ratio i * L) hchildL,
        hm (i + 1) (u + (1 - D.ratio i) * L) (D.ratio i * L) hchildL]
      ring

/-- A left endpoint remains a left endpoint at the next global generation. -/
theorem starts_subset_succ (D : BinaryMoranData) (i m : Nat) (u L : Real) :
    ∀ x ∈ D.starts i m u L, x ∈ D.starts i (m + 1) u L := by
  induction m generalizing i u L with
  | zero =>
      intro x hx
      have hx' : x = u := by simpa [starts] using hx
      subst x
      rw [D.starts_succ]
      exact Finset.mem_union_left _ (D.base_mem_starts (i + 1) 0 u
        (D.ratio i * L))
  | succ m hm =>
      intro x hx
      rw [D.starts_succ, Finset.mem_union] at hx ⊢
      rcases hx with hx | hx
      · exact Or.inl (hm (i + 1) u (D.ratio i * L) x hx)
      · exact Or.inr (hm (i + 1) (u + (1 - D.ratio i) * L)
          (D.ratio i * L) x hx)

/-- Endpoint persistence iterated over arbitrarily many later levels. -/
theorem starts_subset_of_le (D : BinaryMoranData) {m m' : Nat}
    (hmm : m ≤ m') (i : Nat) (u L : Real) :
    ∀ x ∈ D.starts i m u L, x ∈ D.starts i m' u L := by
  induction m' with
  | zero =>
      have : m = 0 := by omega
      subst this
      exact fun x hx => hx
  | succ m' hm =>
      rcases Nat.lt_or_ge m (m' + 1) with hlt | hge
      · have hle : m ≤ m' := by omega
        intro x hx
        exact D.starts_subset_succ i m' u L x (hm hle x hx)
      · have : m = m' + 1 := by omega
        subst this
        exact fun x hx => hx

/-- Splitting a generation into its level-`a` ancestors and depth-`b`
subtrees.  This is the ancestry identity used for local cylinder counts. -/
theorem starts_add (D : BinaryMoranData) (i a b : Nat) (u L : Real) :
    D.starts i (a + b) u L =
      (D.starts i a u L).biUnion fun c =>
        D.starts (i + a) b c (D.scaleFrom i a * L) := by
  induction a generalizing i u L with
  | zero => simp [starts, scaleFrom]
  | succ a ih =>
      have hab : (a + 1) + b = (a + b) + 1 := by omega
      have hindex : (i + 1) + a = i + (a + 1) := by omega
      have hscale := D.scaleFrom_child_mul i a L
      rw [hab, D.starts_succ,
        ih (i + 1) u (D.ratio i * L),
        ih (i + 1) (u + (1 - D.ratio i) * L) (D.ratio i * L),
        D.starts_succ, Finset.union_biUnion]
      simp only [hindex, hscale]

/-- The finite union of level-`m` closed cylinders. -/
def generation (D : BinaryMoranData) (i m : Nat) (u L : Real) : Set Real :=
  ⋃ c ∈ D.starts i m u L, Icc c (c + D.scaleFrom i m * L)

/-- Every refined generation lies inside the preceding generation. -/
theorem generation_succ_subset (D : BinaryMoranData) (i m : Nat) (u L : Real)
    (hL : 0 ≤ L) :
    D.generation i (m + 1) u L ⊆ D.generation i m u L := by
  intro x hx
  rw [generation] at hx ⊢
  obtain ⟨c, hc, hxc⟩ := Set.mem_iUnion₂.mp hx
  rw [D.starts_add i m 1 u L] at hc
  obtain ⟨p, hp, hcp⟩ := Finset.mem_biUnion.mp hc
  have hparentL : 0 ≤ D.scaleFrom i m * L :=
    mul_nonneg (D.scaleFrom_nonneg i m) hL
  obtain ⟨hc_lower, hc_upper⟩ := D.starts_mem_bounds (i + m) 1 p
    (D.scaleFrom i m * L) hparentL hcp
  have hscale : D.scaleFrom (i + m) 1 * (D.scaleFrom i m * L) =
      D.scaleFrom i (m + 1) * L := by
    rw [D.scaleFrom_add i m 1]
    ring
  rw [hscale] at hc_upper
  refine Set.mem_iUnion₂.mpr ⟨p, hp, ?_⟩
  constructor
  · exact hc_lower.trans hxc.1
  · linarith [hc_upper, hxc.2]

/-- Generations are antitone in the refinement level. -/
theorem generation_antitone (D : BinaryMoranData) (i : Nat) (u L : Real)
    (hL : 0 ≤ L) : ∀ {m m' : Nat}, m ≤ m' →
      D.generation i m' u L ⊆ D.generation i m u L := by
  intro m m' hmm
  induction m' with
  | zero =>
      have : m = 0 := by omega
      subst this
      exact Subset.rfl
  | succ m' hm =>
      rcases Nat.lt_or_ge m (m' + 1) with hlt | hge
      · have hle : m ≤ m' := by omega
        exact (D.generation_succ_subset i m' u L hL).trans (hm hle)
      · have : m = m' + 1 := by omega
        subst this
        exact Subset.rfl

/-- The homogeneous variable-ratio binary Moran set based on the interval
`[u,u+L]`. -/
def limitSet (D : BinaryMoranData) (u L : Real) : Set Real :=
  ⋂ m : Nat, D.generation 0 m u L

/-- Each finite left endpoint lies in its own closed generation cylinder. -/
theorem starts_mem_generation (D : BinaryMoranData) (i m : Nat) (u L : Real)
    (hL : 0 ≤ L) {x : Real} (hx : x ∈ D.starts i m u L) :
    x ∈ D.generation i m u L := by
  rw [generation]
  refine Set.mem_iUnion₂.mpr ⟨x, hx, ?_⟩
  exact ⟨le_rfl, le_add_of_nonneg_right
    (mul_nonneg (D.scaleFrom_nonneg i m) hL)⟩

/-- All finite left endpoints persist in the variable-ratio Moran limit set.
These are the concrete points used for lower entropy/packing witnesses. -/
theorem starts_subset_limitSet (D : BinaryMoranData) (m : Nat) (u L : Real)
    (hL : 0 ≤ L) : ∀ x ∈ D.starts 0 m u L, x ∈ D.limitSet u L := by
  intro x hx
  rw [limitSet, Set.mem_iInter]
  intro m'
  rcases Nat.lt_or_ge m' m with hlt | hge
  · exact D.generation_antitone 0 u L hL hlt.le
      (D.starts_mem_generation 0 m u L hL hx)
  · exact D.starts_mem_generation 0 m' u L hL
      (D.starts_subset_of_le hge 0 u L x hx)

/-- The root endpoint belongs to every finite generation whenever the root
length is nonnegative. -/
theorem base_mem_generation (D : BinaryMoranData) (i m : Nat) (u L : Real)
    (hL : 0 ≤ L) : u ∈ D.generation i m u L := by
  rw [generation]
  refine Set.mem_iUnion.2 ⟨u, Set.mem_iUnion.2 ⟨D.base_mem_starts i m u L, ?_⟩⟩
  exact ⟨le_rfl, le_add_of_nonneg_right
    (mul_nonneg (D.scaleFrom_nonneg i m) hL)⟩

/-- Every nonnegative-root-length Moran set is nonempty. -/
theorem limitSet_nonempty (D : BinaryMoranData) (u L : Real) (hL : 0 ≤ L) :
    (D.limitSet u L).Nonempty := by
  refine ⟨u, ?_⟩
  rw [limitSet]
  exact Set.mem_iInter.2 fun m => D.base_mem_generation 0 m u L hL

/-- The limit set is contained in its original root interval. -/
theorem limitSet_subset_rootCylinder (D : BinaryMoranData) (u L : Real) :
    D.limitSet u L ⊆ Icc u (u + L) := by
  intro x hx
  have hroot : x ∈ D.generation 0 0 u L := by
    exact Set.mem_iInter.1 hx 0
  simpa [generation, starts, scaleFrom] using hroot

/-- Every binary Moran limit set is bounded. -/
theorem limitSet_bounded (D : BinaryMoranData) (u L : Real) :
    Bornology.IsBounded (D.limitSet u L) :=
  (Metric.isBounded_Icc u (u + L)).subset (D.limitSet_subset_rootCylinder u L)

/-- The level-`m` cylinders form an exact finite interval cover of the Moran
limit set.  The centres are chosen at the midpoint of each cylinder. -/
theorem limitSet_intervalCover_generation (D : BinaryMoranData) (m : Nat)
    (u L : Real) :
    Auto.FractalDimensions.IsIntervalCover (D.limitSet u L)
      (D.scaleFrom 0 m * L)
      ((D.starts 0 m u L).image fun c => c + D.scaleFrom 0 m * L / 2) := by
  intro x hx
  have hxgen : x ∈ D.generation 0 m u L := Set.mem_iInter.mp hx m
  rw [generation] at hxgen
  rcases Set.mem_iUnion₂.mp hxgen with ⟨c, hc, hxc⟩
  refine Set.mem_iUnion.mpr ⟨c + D.scaleFrom 0 m * L / 2, ?_⟩
  refine Set.mem_iUnion.mpr ⟨?_, ?_⟩
  · exact Finset.mem_image.mpr ⟨c, hc, rfl⟩
  · convert hxc using 1; ring

/-- The level-`m` cylinders which meet a given BRRS testing interval. -/
noncomputable def activeStarts (D : BinaryMoranData) (m : Nat)
    (u L a R : Real) : Finset Real := by
  classical
  exact (D.starts 0 m u L).filter fun c =>
    (Icc c (c + D.scaleFrom 0 m * L) ∩ brrsInterval a R).Nonempty

theorem mem_activeStarts (D : BinaryMoranData) (m : Nat)
    (u L a R c : Real) : c ∈ D.activeStarts m u L a R ↔
    c ∈ D.starts 0 m u L ∧
      (Icc c (c + D.scaleFrom 0 m * L) ∩ brrsInterval a R).Nonempty := by
  classical
  simp only [activeStarts, Finset.mem_filter]

/-- At a generation whose cylinder length exceeds the testing length, at most
three cylinders can meet one BRRS testing interval. -/
theorem activeStarts_card_le_three (D : BinaryMoranData) (m : Nat)
    {u L a R : Real} (hL : 0 < L)
    (hR : R < D.scaleFrom 0 m * L) :
    (D.activeStarts m u L a R).card ≤ 3 := by
  let len : Real := D.scaleFrom 0 m * L
  have hlen : 0 < len := mul_pos (D.scaleFrom_pos 0 m) hL
  apply card_le_three_of_separated_in_interval (s := a - len) (len := len) hlen
  · intro c hc
    rcases (D.mem_activeStarts m u L a R c).1 hc with ⟨hcstarts, hmeet⟩
    rcases hmeet with ⟨x, hxcyl, hxI⟩
    change x ∈ Icc a (a + R) at hxI
    constructor
    · change a - (D.scaleFrom 0 m * L) ≤ c
      linarith [hxcyl.2, hxI.1]
    · change c ≤ a - (D.scaleFrom 0 m * L) + 2 * (D.scaleFrom 0 m * L)
      linarith [hxcyl.1, hxI.2, hR]
  · intro x hx y hy hxy
    have hx' := (D.mem_activeStarts m u L a R x).1 hx
    have hy' := (D.mem_activeStarts m u L a R y).1 hy
    change len ≤ |x - y|
    exact D.starts_separated 0 m u L hL.le hx'.1 hy'.1 hxy

/-- All depth-`q-p` descendants of the level-`p` cylinders which are active
inside a testing interval. -/
noncomputable def localDescendantStarts (D : BinaryMoranData) (p q : Nat)
    (u L a R : Real) : Finset Real :=
  (D.activeStarts p u L a R).biUnion fun c =>
    D.starts p (q - p) c (D.scaleFrom 0 p * L)

/-- The active descendants have the expected finite cardinality bound. -/
theorem localDescendantStarts_card_le (D : BinaryMoranData) (p q : Nat)
    {u L a R : Real} (hL : 0 < L)
    (hR : R < D.scaleFrom 0 p * L) :
    (D.localDescendantStarts p q u L a R).card ≤ 3 * 2 ^ (q - p) := by
  let active : Finset Real := D.activeStarts p u L a R
  have hchild : 0 < D.scaleFrom 0 p * L :=
    mul_pos (D.scaleFrom_pos 0 p) hL
  calc
    (D.localDescendantStarts p q u L a R).card ≤
        ∑ c ∈ active, (D.starts p (q - p) c (D.scaleFrom 0 p * L)).card := by
      exact Finset.card_biUnion_le
    _ = ∑ _c ∈ active, 2 ^ (q - p) := by
      apply Finset.sum_congr rfl
      intro c hc
      exact D.starts_card p (q - p) c (D.scaleFrom 0 p * L) hchild
    _ = active.card * 2 ^ (q - p) := by simp
    _ ≤ 3 * 2 ^ (q - p) :=
      Nat.mul_le_mul_right _ (D.activeStarts_card_le_three p hL hR)

/-- The cylinder length of a descendant, expressed using the root scale. -/
theorem scaleFrom_descendant_length (D : BinaryMoranData) {p q : Nat}
    (L : Real) (hpq : p ≤ q) :
    D.scaleFrom p (q - p) * (D.scaleFrom 0 p * L) =
      D.scaleFrom 0 q * L := by
  have hpq' : p + (q - p) = q := Nat.add_sub_of_le hpq
  calc
    D.scaleFrom p (q - p) * (D.scaleFrom 0 p * L) =
        (D.scaleFrom 0 p * D.scaleFrom p (q - p)) * L := by ring
    _ = D.scaleFrom 0 (p + (q - p)) * L := by
      rw [D.scaleFrom_add]
      simp
    _ = D.scaleFrom 0 q * L := by rw [hpq']

/-- The relative descendant scale is exactly the quotient of its physical
child and parent cylinder lengths. -/
theorem scaleFrom_eq_child_length_div_parent_length
    (D : BinaryMoranData) {p q : Nat} (L : Real) (hpq : p ≤ q)
    (hL : L ≠ 0) :
    D.scaleFrom p (q - p) =
      (D.scaleFrom 0 q * L) / (D.scaleFrom 0 p * L) := by
  rw [← D.scaleFrom_descendant_length L hpq]
  exact (mul_div_cancel_right₀ _
    (mul_ne_zero (D.scaleFrom_pos 0 p).ne' hL)).symm

/-- The exact number of descendants is the reciprocal of the physical scale
ratio raised to the logarithmic block density. -/
theorem descendant_card_eq_local_scale_ratio_rpow
    (D : BinaryMoranData) {p q : Nat} (L : Real) (hpq : p < q)
    (hL : L ≠ 0) :
    ((2 ^ (q - p) : Nat) : Real) =
      ((D.scaleFrom 0 q * L) / (D.scaleFrom 0 p * L)) ^
        (-D.blockLogDensity p q) := by
  rw [← D.scaleFrom_eq_child_length_div_parent_length L hpq.le hL]
  exact D.descendant_card_eq_rpow_neg_blockLogDensity hpq

/-- The active level-`q` descendant cylinders cover the portion of the Moran
limit set in a testing interval.  This is the exact local cover underlying
Rutar's entropy calculation. -/
theorem limitSet_inter_brrsInterval_intervalCover_localDescendants
    (D : BinaryMoranData) {p q : Nat} (u L a R : Real) (hL : 0 ≤ L)
    (hpq : p ≤ q) :
    Auto.FractalDimensions.IsIntervalCover
      (D.limitSet u L ∩ brrsInterval a R)
      (D.scaleFrom 0 q * L)
      ((D.localDescendantStarts p q u L a R).image
        fun c => c + D.scaleFrom 0 q * L / 2) := by
  intro x hx
  rcases hx with ⟨hxlimit, hxinterval⟩
  have hxq : x ∈ D.generation 0 q u L := Set.mem_iInter.mp hxlimit q
  rw [generation] at hxq
  rcases Set.mem_iUnion₂.mp hxq with ⟨z, hz, hxz⟩
  have hqsplit : q = p + (q - p) := (Nat.add_sub_of_le hpq).symm
  rw [hqsplit, D.starts_add] at hz
  rcases Finset.mem_biUnion.mp hz with ⟨c, hc, hzc⟩
  have hzc' : z ∈ D.starts p (q - p) c (D.scaleFrom 0 p * L) := by
    simpa using hzc
  have hlength := D.scaleFrom_descendant_length L hpq
  have hchild_bounds := D.starts_mem_bounds p (q - p) c
    (D.scaleFrom 0 p * L)
    (mul_nonneg (D.scaleFrom_nonneg 0 p) hL) hzc'
  have hxz' : x ∈ Icc z
      (z + D.scaleFrom p (q - p) * (D.scaleFrom 0 p * L)) := by
    rw [hlength]
    exact hxz
  have hxparent : x ∈ Icc c (c + D.scaleFrom 0 p * L) := by
    constructor
    · exact hchild_bounds.1.trans hxz'.1
    · linarith [hchild_bounds.2, hxz'.2]
  have hcactive : c ∈ D.activeStarts p u L a R :=
    (D.mem_activeStarts p u L a R c).2 ⟨hc, ⟨x, hxparent, hxinterval⟩⟩
  refine Set.mem_iUnion.mpr ⟨z + D.scaleFrom 0 q * L / 2, ?_⟩
  refine Set.mem_iUnion.mpr ⟨?_, ?_⟩
  · apply Finset.mem_image.mpr
    refine ⟨z, ?_, rfl⟩
    exact Finset.mem_biUnion.mpr ⟨c, hcactive, hzc'⟩
  · convert hxz using 1; ring

/-- Local BRRS entropy is bounded by the number of active descendants. -/
theorem brrsEntropyNumber_inter_brrsInterval_le_localDescendantStarts_card
    (D : BinaryMoranData) {p q : Nat} (u L a R : Real)
    (hL : 0 < L) (hpq : p ≤ q) :
    brrsEntropyNumber (D.limitSet u L ∩ brrsInterval a R)
      ⟨D.scaleFrom 0 q * L, (mul_pos (D.scaleFrom_pos 0 q) hL).le⟩ ≤
        ((D.localDescendantStarts p q u L a R).card : ENNReal) := by
  let delta : NNReal :=
    ⟨D.scaleFrom 0 q * L, (mul_pos (D.scaleFrom_pos 0 q) hL).le⟩
  have hcover : Auto.FractalDimensions.IsIntervalCover
      (D.limitSet u L ∩ brrsInterval a R) (delta : Real)
      ((D.localDescendantStarts p q u L a R).image
        fun c => c + D.scaleFrom 0 q * L / 2) := by
    change Auto.FractalDimensions.IsIntervalCover
      (D.limitSet u L ∩ brrsInterval a R) (D.scaleFrom 0 q * L)
      ((D.localDescendantStarts p q u L a R).image
        fun c => c + D.scaleFrom 0 q * L / 2)
    exact D.limitSet_inter_brrsInterval_intervalCover_localDescendants u L a R hL.le hpq
  calc
    brrsEntropyNumber (D.limitSet u L ∩ brrsInterval a R) delta ≤
        (((D.localDescendantStarts p q u L a R).image
          fun c => c + D.scaleFrom 0 q * L / 2).card : ENNReal) :=
      brrsEntropyNumber_le_of_intervalCover hcover
    _ ≤ ((D.localDescendantStarts p q u L a R).card : ENNReal) := by
      exact_mod_cast Finset.card_image_le

/-- Combining the three-active-cylinders bound with the descendant cover gives
the finite local Moran entropy estimate. -/
theorem brrsEntropyNumber_inter_brrsInterval_le_of_moran_scales
    (D : BinaryMoranData) {p q : Nat} (u L a R : Real)
    (hL : 0 < L) (hpq : p ≤ q)
    (hR : R < D.scaleFrom 0 p * L) :
    brrsEntropyNumber (D.limitSet u L ∩ brrsInterval a R)
      ⟨D.scaleFrom 0 q * L, (mul_pos (D.scaleFrom_pos 0 q) hL).le⟩ ≤
        ((3 * 2 ^ (q - p) : Nat) : ENNReal) := by
  calc
    brrsEntropyNumber (D.limitSet u L ∩ brrsInterval a R)
        ⟨D.scaleFrom 0 q * L, (mul_pos (D.scaleFrom_pos 0 q) hL).le⟩ ≤
        ((D.localDescendantStarts p q u L a R).card : ENNReal) :=
      D.brrsEntropyNumber_inter_brrsInterval_le_localDescendantStarts_card
        u L a R hL hpq
    _ ≤ ((3 * 2 ^ (q - p) : Nat) : ENNReal) := by
      exact_mod_cast D.localDescendantStarts_card_le p q hL hR

/-- Descendant left endpoints of a fixed parent cylinder remain in the Moran
limit set and inside that parent cylinder. -/
theorem subtreeStarts_subset_limitSet_inter_parentInterval
    (D : BinaryMoranData) {p q : Nat} {u L c : Real}
    (hL : 0 ≤ L) (hpq : p ≤ q)
    (hc : c ∈ D.starts 0 p u L) :
    (↑(D.starts p (q - p) c (D.scaleFrom 0 p * L)) : Set Real) ⊆
      D.limitSet u L ∩ brrsInterval c (D.scaleFrom 0 p * L) := by
  intro z hz
  have hqsplit : q = p + (q - p) := (Nat.add_sub_of_le hpq).symm
  have hzlevel : z ∈ D.starts 0 (p + (q - p)) u L := by
    rw [D.starts_add]
    exact Finset.mem_biUnion.mpr ⟨c, hc, by simpa using hz⟩
  have hzglobal : z ∈ D.starts 0 q u L := by
    rw [hqsplit]
    exact hzlevel
  constructor
  · exact D.starts_subset_limitSet q u L hL z hzglobal
  · change z ∈ Icc c (c + D.scaleFrom 0 p * L)
    have hparent_nonneg : 0 ≤ D.scaleFrom 0 p * L :=
      mul_nonneg (D.scaleFrom_nonneg 0 p) hL
    have hbounds := D.starts_mem_bounds p (q - p) c
      (D.scaleFrom 0 p * L) hparent_nonneg hz
    constructor
    · exact hbounds.1
    · have hchild_nonneg : 0 ≤ D.scaleFrom p (q - p) *
          (D.scaleFrom 0 p * L) :=
        mul_nonneg (D.scaleFrom_nonneg p (q - p)) hparent_nonneg
      linarith [hbounds.2]

/-- Uniform half-contraction gives the elementary dyadic majorant used to
choose the first cylinder below any prescribed scale. -/
theorem scale_le_half_pow (D : BinaryMoranData) (n : Nat) :
    D.scale n ≤ ((1 / 2 : Real) ^ n) := by
  induction n with
  | zero => norm_num [scale]
  | succ n hn =>
      calc
        D.scale (n + 1) = D.scale n * D.ratio n := rfl
        _ ≤ D.scale n * (1 / 2) :=
          mul_le_mul_of_nonneg_left (D.ratio_le_half n) (D.scale_nonneg n)
        _ ≤ ((1 / 2 : Real) ^ n) * (1 / 2) :=
          mul_le_mul_of_nonneg_right hn (by norm_num)
        _ = (1 / 2 : Real) ^ (n + 1) := by
          rw [pow_succ]

/-- The cylinder scales tend to zero.  This is the scale-existence input for
the `firstScale` index in the later entropy estimates. -/
theorem scale_tendsto_zero (D : BinaryMoranData) :
    Filter.Tendsto D.scale Filter.atTop (nhds 0) := by
  apply squeeze_zero (fun n => D.scale_nonneg n)
    (fun n => D.scale_le_half_pow n)
  exact tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)

/-- Some cylinder level has length at most any prescribed positive scale. -/
theorem exists_scale_le (D : BinaryMoranData) {delta : Real}
    (hdelta : 0 < delta) : ∃ n : Nat, D.scale n ≤ delta := by
  have htail := D.scale_tendsto_zero.eventually (Iio_mem_nhds hdelta)
  rcases eventually_atTop.1 htail with ⟨n, hn⟩
  exact ⟨n, (hn n le_rfl).le⟩

/-- The first Moran generation whose scale is below `delta`. -/
noncomputable def firstScale (D : BinaryMoranData) (delta : Real)
    (hdelta : 0 < delta) : Nat :=
  Nat.find (D.exists_scale_le hdelta)

theorem scale_firstScale_le (D : BinaryMoranData) (delta : Real)
    (hdelta : 0 < delta) : D.scale (D.firstScale delta hdelta) ≤ delta :=
  Nat.find_spec (D.exists_scale_le hdelta)

/-- Before the first selected scale, all cylinder lengths are strictly larger
than the target scale. -/
theorem lt_scale_of_lt_firstScale (D : BinaryMoranData) (delta : Real)
    (hdelta : 0 < delta) {n : Nat} (hn : n < D.firstScale delta hdelta) :
    delta < D.scale n := by
  exact lt_of_not_ge (Nat.find_min (D.exists_scale_le hdelta) hn)

/-- When `delta < 1`, the first selected scale is a genuine positive
generation rather than the root cylinder. -/
theorem firstScale_pos (D : BinaryMoranData) {delta : Real}
    (hdelta : 0 < delta) (hdelta_one : delta < 1) :
    0 < D.firstScale delta hdelta := by
  apply Nat.pos_of_ne_zero
  intro hzero
  have hroot := D.scale_firstScale_le delta hdelta
  rw [hzero, D.scale_zero] at hroot
  exact (not_le_of_gt hdelta_one) hroot

/-- If every contraction is at least `kappa`, the first cylinder below an
arbitrary scale still has length strictly larger than `kappa * delta`. -/
theorem kappa_mul_lt_scale_firstScale (D : BinaryMoranData)
    {kappa delta : Real} (hkappa : 0 < kappa)
    (hratio : ∀ n : Nat, kappa ≤ D.ratio n)
    (hdelta : 0 < delta) (hdelta_one : delta < 1) :
    kappa * delta < D.scale (D.firstScale delta hdelta) := by
  let q := D.firstScale delta hdelta
  have hqpos : 0 < q := D.firstScale_pos hdelta hdelta_one
  obtain ⟨q', hq'⟩ :=
    Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hqpos)
  have hqpred : q' < q := by omega
  have hlt : delta < D.scale q' :=
    D.lt_scale_of_lt_firstScale delta hdelta hqpred
  have hmul : kappa * delta < kappa * D.scale q' :=
    mul_lt_mul_of_pos_left hlt hkappa
  have hratio' : kappa * D.scale q' ≤ D.scale q' * D.ratio q' := by
    simpa [mul_comm] using
      mul_le_mul_of_nonneg_right (hratio q') (D.scale_nonneg q')
  change kappa * delta < D.scale q
  rw [hq', D.scale_succ]
  exact hmul.trans_le hratio'

/-- The first-scale index is antitone in the physical scale. -/
theorem firstScale_mono (D : BinaryMoranData) {delta R : Real}
    (hdelta : 0 < delta) (hR : 0 < R) (hdeltaR : delta ≤ R) :
    D.firstScale R hR ≤ D.firstScale delta hdelta := by
  unfold firstScale
  apply Nat.find_min'
  exact (Nat.find_spec (D.exists_scale_le hdelta)).trans hdeltaR

/-- The finite number of descendants across bracketing generations is
controlled by a physical-scale power whenever the contractions have a common
positive lower bound and the logarithmic block densities are uniformly
bounded.  The factor `kappa ^ (-2 * gamma)` is precisely the loss incurred
by choosing the first Moran levels below the two physical scales. -/
theorem descendant_card_le_power_of_bracketing_scales
    (D : BinaryMoranData) {kappa delta R gamma : Real}
    (hkappa : 0 < kappa) (hratio : ∀ n : Nat, kappa ≤ D.ratio n)
    (hdelta : 0 < delta) (hdelta_one : delta < 1)
    (hR : 0 < R) (hdeltaR : delta ≤ R)
    {p q : Nat} (hp : p + 1 = D.firstScale R hR)
    (hq : q = D.firstScale delta hdelta)
    (hdensity : ∀ {i j : Nat}, i < j → D.blockLogDensity i j ≤ gamma) :
    ((2 ^ (q - p) : Nat) : Real) ≤
      (kappa ^ 2) ^ (-gamma) * (R / delta) ^ gamma := by
  have hfirst : D.firstScale R hR ≤ D.firstScale delta hdelta :=
    D.firstScale_mono hdelta hR hdeltaR
  have hpq : p < q := by
    calc
      p < p + 1 := Nat.lt_succ_self p
      _ = D.firstScale R hR := hp
      _ ≤ D.firstScale delta hdelta := hfirst
      _ = q := hq.symm
  have hsq_lower : kappa * delta < D.scale q := by
    calc
      kappa * delta < D.scale (D.firstScale delta hdelta) :=
        D.kappa_mul_lt_scale_firstScale hkappa hratio hdelta hdelta_one
      _ = D.scale q := by rw [hq]
  have hsp_upper : D.scale p * kappa ≤ R := by
    calc
      D.scale p * kappa ≤ D.scale p * D.ratio p :=
        mul_le_mul_of_nonneg_left (hratio p) (D.scale_nonneg p)
      _ = D.scale (p + 1) := (D.scale_succ p).symm
      _ = D.scale (D.firstScale R hR) := by rw [hp]
      _ ≤ R := D.scale_firstScale_le R hR
  have hbase : D.scale p / D.scale q ≤ (R / delta) / kappa ^ 2 := by
    have hden : 0 < delta * kappa ^ 2 :=
      mul_pos hdelta (sq_pos_of_pos hkappa)
    have hprod1 : D.scale p * kappa * (kappa * delta) ≤
        D.scale p * kappa * D.scale q :=
      mul_le_mul_of_nonneg_left hsq_lower.le
        (mul_nonneg (D.scale_nonneg p) hkappa.le)
    have hprod2 : D.scale p * kappa * D.scale q ≤ R * D.scale q :=
      mul_le_mul_of_nonneg_right hsp_upper (D.scale_nonneg q)
    have hprod : D.scale p * (delta * kappa ^ 2) ≤ R * D.scale q := by
      calc
        D.scale p * (delta * kappa ^ 2) =
            D.scale p * kappa * (kappa * delta) := by ring
        _ ≤ D.scale p * kappa * D.scale q := hprod1
        _ ≤ R * D.scale q := hprod2
    have hbound : D.scale p ≤
        (R * D.scale q) / (delta * kappa ^ 2) :=
      (le_div_iff₀ hden).2 hprod
    calc
      D.scale p / D.scale q ≤
          ((R * D.scale q) / (delta * kappa ^ 2)) / D.scale q :=
        div_le_div_of_nonneg_right hbound (D.scale_nonneg q)
      _ = (R / delta) / kappa ^ 2 := by
        field_simp [(D.scale_pos q).ne']
  have hkappa_one : kappa ≤ 1 :=
    (hratio 0).trans ((D.ratio_le_half 0).trans (by norm_num))
  have hkappa_sq_le_one : kappa ^ 2 ≤ 1 := by
    nlinarith [hkappa.le]
  have hratio_one : 1 ≤ R / delta := (one_le_div₀ hdelta).2 hdeltaR
  have hbase_one : 1 ≤ (R / delta) / kappa ^ 2 :=
    (one_le_div₀ (sq_pos_of_pos hkappa)).2
      (hkappa_sq_le_one.trans hratio_one)
  calc
    ((2 ^ (q - p) : Nat) : Real) =
        (D.scaleFrom p (q - p)) ^ (-D.blockLogDensity p q) :=
      D.descendant_card_eq_rpow_neg_blockLogDensity hpq
    _ = (D.scale p / D.scale q) ^ D.blockLogDensity p q := by
      rw [← D.scale_div_eq_scaleFrom_sub hpq.le]
      rw [Real.rpow_neg (div_nonneg (D.scale_nonneg q) (D.scale_nonneg p))]
      rw [← Real.inv_rpow (div_nonneg (D.scale_nonneg q) (D.scale_nonneg p))]
      congr 1
      field_simp
    _ ≤ ((R / delta) / kappa ^ 2) ^ D.blockLogDensity p q :=
      Real.rpow_le_rpow (div_nonneg (D.scale_nonneg p) (D.scale_nonneg q)) hbase
        (D.blockLogDensity_pos hpq).le
    _ ≤ ((R / delta) / kappa ^ 2) ^ gamma :=
      Real.rpow_le_rpow_of_exponent_le hbase_one (hdensity hpq)
    _ = (kappa ^ 2) ^ (-gamma) * (R / delta) ^ gamma := by
      rw [div_eq_mul_inv, Real.mul_rpow (div_nonneg hR.le hdelta.le)
        (inv_nonneg.mpr (sq_nonneg kappa))]
      rw [Real.inv_rpow (sq_nonneg kappa) gamma,
        ← Real.rpow_neg (sq_nonneg kappa) gamma]
      ring

/-- At arbitrary positive scales, the first-scale indices turn the local
cylinder estimate into a literal BRRS interval-cover bound.  The hypothesis
`hp` chooses the parent generation immediately before the first cylinder
below `R`; it is available whenever `R < 1`. -/
theorem brrsEntropyNumber_inter_brrsInterval_le_of_bracketing_scales
    (D : BinaryMoranData) {delta R : Real} (u a : Real)
    (hdelta : 0 < delta) (hR : 0 < R) (hdeltaR : delta ≤ R)
    {p q : Nat} (hp : p + 1 = D.firstScale R hR)
    (hq : q = D.firstScale delta hdelta) :
    brrsEntropyNumber (D.limitSet u 1 ∩ brrsInterval a R)
      ⟨delta, hdelta.le⟩ ≤ ((3 * 2 ^ (q - p) : Nat) : ENNReal) := by
  have hp_lt : p < D.firstScale R hR := by omega
  have hRlt_scale : R < D.scale p :=
    D.lt_scale_of_lt_firstScale R hR hp_lt
  have hRlt : R < D.scaleFrom 0 p * 1 := by
    rw [← D.scale_eq_scaleFrom_zero p]
    simpa using hRlt_scale
  have hpq : p ≤ q := by
    have hfirst : D.firstScale R hR ≤ D.firstScale delta hdelta :=
      D.firstScale_mono hdelta hR hdeltaR
    omega
  have hqscale : D.scaleFrom 0 q * 1 ≤ delta := by
    rw [← D.scale_eq_scaleFrom_zero q, hq]
    simpa using D.scale_firstScale_le delta hdelta
  let centers : Finset Real :=
    (D.localDescendantStarts p q u 1 a R).image
      fun c => c + D.scaleFrom 0 q * 1 / 2
  have hcover_small : Auto.FractalDimensions.IsIntervalCover
      (D.limitSet u 1 ∩ brrsInterval a R) (D.scaleFrom 0 q * 1) centers := by
    exact D.limitSet_inter_brrsInterval_intervalCover_localDescendants
      u 1 a R (by norm_num) hpq
  have hcover : Auto.FractalDimensions.IsIntervalCover
      (D.limitSet u 1 ∩ brrsInterval a R) delta centers :=
    hcover_small.mono_scale hqscale
  calc
    brrsEntropyNumber (D.limitSet u 1 ∩ brrsInterval a R) ⟨delta, hdelta.le⟩ ≤
        (centers.card : ENNReal) := brrsEntropyNumber_le_of_intervalCover hcover
    _ ≤ ((D.localDescendantStarts p q u 1 a R).card : ENNReal) := by
      exact_mod_cast Finset.card_image_le
    _ ≤ ((3 * 2 ^ (q - p) : Nat) : ENNReal) := by
      exact_mod_cast D.localDescendantStarts_card_le p q (by norm_num) hRlt

/-- Uniform control of the finite logarithmic branching density yields an
actual BRRS equality-scale Assouad-spectrum exponent under a direct
first-scale bracketing estimate. -/
theorem hasBRRSAssouadSpectrumExponent_of_uniform_blockLogDensity
    (D : BinaryMoranData) {u kappa theta gamma : Real}
    (hratio : D.HasUniformRatioLowerBound kappa)
    (htheta : theta ∈ Ioo (0 : Real) 1)
    (hdensity : D.HasUniformBlockLogDensityBound gamma) :
    HasBRRSAssouadSpectrumExponent (D.limitSet u 1) theta gamma := by
  rcases hratio with ⟨hkappa, hratio⟩
  refine ⟨3 * (kappa ^ 2) ^ (-gamma),
    mul_pos (by norm_num) (Real.rpow_pos_of_pos (sq_pos_of_pos hkappa) _), ?_⟩
  intro delta hdelta hdelta_one a
  let d : Real := (delta : Real)
  let R : Real := d ^ theta
  have hd : 0 < d := by
    dsimp [d]
    exact_mod_cast hdelta
  have hd_one : d < 1 := by
    dsimp [d]
    exact_mod_cast hdelta_one
  have hd_le_one : d ≤ 1 := hd_one.le
  have hR : 0 < R := by
    dsimp [R]
    exact Real.rpow_pos_of_pos hd _
  have hR_one : R < 1 := by
    dsimp [R]
    exact Real.rpow_lt_one hd.le hd_one htheta.1
  have hdeltaR : d ≤ R := by
    dsimp [R]
    calc
      d = d ^ (1 : Real) := by rw [Real.rpow_one]
      _ ≤ d ^ theta :=
        Real.rpow_le_rpow_of_exponent_ge hd hd_le_one htheta.2.le
  obtain ⟨p, hp'⟩ := Nat.exists_eq_succ_of_ne_zero
    (Nat.ne_of_gt (D.firstScale_pos hR hR_one))
  have hp : p + 1 = D.firstScale R hR := hp'.symm
  let q : Nat := D.firstScale d hd
  have hq : q = D.firstScale d hd := rfl
  have hentropy := D.brrsEntropyNumber_inter_brrsInterval_le_of_bracketing_scales
    (delta := d) (R := R) u a hd hR hdeltaR hp hq
  have hcard := D.descendant_card_le_power_of_bracketing_scales
    hkappa hratio hd hd_one hR hdeltaR hp hq
      (fun {i j} hij => hdensity hij)
  have hcardENN : ((3 * 2 ^ (q - p) : Nat) : ENNReal) ≤
      ENNReal.ofReal (3 * (kappa ^ 2) ^ (-gamma) * (R / d) ^ gamma) := by
    rw [← ENNReal.ofReal_natCast]
    apply ENNReal.ofReal_le_ofReal
    calc
      ((3 * 2 ^ (q - p) : Nat) : Real) =
          3 * ((2 ^ (q - p) : Nat) : Real) := by norm_num
      _ ≤ 3 * ((kappa ^ 2) ^ (-gamma) * (R / d) ^ gamma) :=
        mul_le_mul_of_nonneg_left hcard (by norm_num)
      _ = 3 * (kappa ^ 2) ^ (-gamma) * (R / d) ^ gamma := by ring
  change brrsEntropyNumber (D.limitSet u 1 ∩ brrsInterval a R) delta ≤
    ENNReal.ofReal
      ((3 * (kappa ^ 2) ^ (-gamma)) * (R / d) ^ gamma)
  have hdelta_eq : (⟨d, hd.le⟩ : NNReal) = delta := by
    apply NNReal.eq
    rfl
  rw [← hdelta_eq]
  calc
    brrsEntropyNumber (D.limitSet u 1 ∩ brrsInterval a R) ⟨d, hd.le⟩ ≤
        ((3 * 2 ^ (q - p) : Nat) : ENNReal) := hentropy
    _ ≤ ENNReal.ofReal (3 * (kappa ^ 2) ^ (-gamma) * (R / d) ^ gamma) :=
      hcardENN
    _ = ENNReal.ofReal
        ((3 * (kappa ^ 2) ^ (-gamma)) * (R / d) ^ gamma) := by ring

/-- Uniform logarithmic branching-density control already gives the literal
BRRS equality-scale spectrum bound, with no lower bound on the individual
Moran contractions.  At arbitrary physical scales the first and last Moran
generations can overshoot their target scales, but they account for only two
binary generations.  Removing them leaves a block whose scale ratio is at
most the requested physical ratio, and the two discarded generations give
the universal constant `12 = 3 * 2^2`. -/
theorem hasBRRSAssouadSpectrumExponent_of_uniform_blockLogDensity_no_lower_ratio
    (D : BinaryMoranData) {u theta gamma : Real}
    (htheta : theta ∈ Ioo (0 : Real) 1)
    (hdensity : D.HasUniformBlockLogDensityBound gamma) :
    HasBRRSAssouadSpectrumExponent (D.limitSet u 1) theta gamma := by
  have hgamma_pos : 0 < gamma := by
    have hblock : 0 < D.blockLogDensity 0 1 :=
      D.blockLogDensity_pos (by omega)
    exact hblock.trans_le (hdensity (p := 0) (q := 1) (by omega))
  have hgamma : 0 ≤ gamma := hgamma_pos.le
  refine ⟨12, by norm_num, ?_⟩
  intro delta hdelta hdelta_one a
  let d : Real := (delta : Real)
  let R : Real := d ^ theta
  have hd : 0 < d := by
    dsimp [d]
    exact_mod_cast hdelta
  have hd_one : d < 1 := by
    dsimp [d]
    exact_mod_cast hdelta_one
  have hd_le_one : d ≤ 1 := hd_one.le
  have hR : 0 < R := by
    dsimp [R]
    exact Real.rpow_pos_of_pos hd _
  have hR_one : R < 1 := by
    dsimp [R]
    exact Real.rpow_lt_one hd.le hd_one htheta.1
  have hdeltaR : d ≤ R := by
    dsimp [R]
    calc
      d = d ^ (1 : Real) := by rw [Real.rpow_one]
      _ ≤ d ^ theta :=
        Real.rpow_le_rpow_of_exponent_ge hd hd_le_one htheta.2.le
  obtain ⟨p, hp'⟩ := Nat.exists_eq_succ_of_ne_zero
    (Nat.ne_of_gt (D.firstScale_pos hR hR_one))
  have hp : p + 1 = D.firstScale R hR := hp'.symm
  let q : Nat := D.firstScale d hd
  have hq : q = D.firstScale d hd := rfl
  have hfirst : D.firstScale R hR ≤ D.firstScale d hd :=
    D.firstScale_mono hd hR hdeltaR
  have hpq : p < q := by
    calc
      p < p + 1 := Nat.lt_succ_self p
      _ = D.firstScale R hR := hp
      _ ≤ D.firstScale d hd := hfirst
      _ = q := hq.symm
  have hentropy := D.brrsEntropyNumber_inter_brrsInterval_le_of_bracketing_scales
    (delta := d) (R := R) u a hd hR hdeltaR hp hq
  have hratio_one : 1 ≤ R / d := by
    apply (le_div_iff₀ hd).2
    simpa using hdeltaR
  have hratio_pow_one : 1 ≤ (R / d) ^ gamma :=
    Real.one_le_rpow hratio_one hgamma
  have hcardReal : ((3 * 2 ^ (q - p) : Nat) : Real) ≤
      12 * (R / d) ^ gamma := by
    by_cases hsmall : q - p ≤ 2
    · have hpow : 2 ^ (q - p) ≤ (4 : Nat) := by
        calc
          2 ^ (q - p) ≤ 2 ^ 2 :=
            Nat.pow_le_pow_right (by omega) hsmall
          _ = 4 := by norm_num
      calc
        ((3 * 2 ^ (q - p) : Nat) : Real) =
            3 * ((2 ^ (q - p) : Nat) : Real) := by norm_num
        _ ≤ 3 * 4 :=
          mul_le_mul_of_nonneg_left (by exact_mod_cast hpow) (by norm_num)
        _ = 12 * 1 := by norm_num
        _ ≤ 12 * (R / d) ^ gamma :=
          mul_le_mul_of_nonneg_left hratio_pow_one (by norm_num)
    · have hlarge : 3 ≤ q - p := by omega
      have hinterior : p + 1 < q - 1 := by omega
      have hscale_left : D.scale (p + 1) ≤ R := by
        rw [hp]
        exact D.scale_firstScale_le R hR
      have hscale_right : d < D.scale (q - 1) := by
        apply D.lt_scale_of_lt_firstScale d hd
        rw [← hq]
        omega
      have hscale_ratio : D.scale (p + 1) / D.scale (q - 1) ≤ R / d := by
        calc
          D.scale (p + 1) / D.scale (q - 1) ≤ R / D.scale (q - 1) :=
            div_le_div_of_nonneg_right hscale_left (D.scale_nonneg (q - 1))
          _ ≤ R / d :=
            div_le_div_of_nonneg_left hR.le hd hscale_right.le
      have hinterior_card :=
        D.descendant_card_le_rpow_scale_ratio_of_blockLogDensity_le
          hinterior.le (hdensity hinterior)
      have hinterior_card' :
          ((2 ^ ((q - 1) - (p + 1)) : Nat) : Real) ≤
            (R / d) ^ gamma := by
        calc
          ((2 ^ ((q - 1) - (p + 1)) : Nat) : Real) ≤
              (D.scale (p + 1) / D.scale (q - 1)) ^ gamma :=
            hinterior_card
          _ ≤ (R / d) ^ gamma :=
            Real.rpow_le_rpow
              (div_nonneg (D.scale_nonneg (p + 1)) (D.scale_nonneg (q - 1)))
              hscale_ratio hgamma
      have hfactor : ((2 ^ (q - p) : Nat) : Real) =
          4 * ((2 ^ ((q - 1) - (p + 1)) : Nat) : Real) := by
        have hindex : q - p = 2 + ((q - 1) - (p + 1)) := by omega
        rw [hindex, pow_add]
        norm_num
      calc
        ((3 * 2 ^ (q - p) : Nat) : Real) =
            3 * ((2 ^ (q - p) : Nat) : Real) := by norm_num
        _ = 3 * (4 * ((2 ^ ((q - 1) - (p + 1)) : Nat) : Real)) := by
          rw [hfactor]
        _ = 12 * ((2 ^ ((q - 1) - (p + 1)) : Nat) : Real) := by ring
        _ ≤ 12 * (R / d) ^ gamma :=
          mul_le_mul_of_nonneg_left hinterior_card' (by norm_num)
  have hcardENN : ((3 * 2 ^ (q - p) : Nat) : ENNReal) ≤
      ENNReal.ofReal (12 * (R / d) ^ gamma) := by
    rw [← ENNReal.ofReal_natCast]
    exact ENNReal.ofReal_le_ofReal hcardReal
  change brrsEntropyNumber (D.limitSet u 1 ∩ brrsInterval a R) delta ≤
    ENNReal.ofReal (12 * (R / d) ^ gamma)
  have hdelta_eq : (⟨d, hd.le⟩ : NNReal) = delta := by
    apply NNReal.eq
    rfl
  rw [← hdelta_eq]
  calc
    brrsEntropyNumber (D.limitSet u 1 ∩ brrsInterval a R) ⟨d, hd.le⟩ ≤
        ((3 * 2 ^ (q - p) : Nat) : ENNReal) := hentropy
    _ ≤ ENNReal.ofReal (12 * (R / d) ^ gamma) := hcardENN

/-- The level-`m` Moran cylinders give an explicit global BRRS entropy cover
at their exact common length.  This is the upper half of the elementary
finite-scale entropy sandwich for a variable-ratio Moran set. -/
theorem limitSet_brrsEntropy_le_generation_card (D : BinaryMoranData)
    (m : Nat) (u L : Real) (hL : 0 < L) :
    brrsEntropyNumber (D.limitSet u L)
      ⟨D.scaleFrom 0 m * L, (mul_pos (D.scaleFrom_pos 0 m) hL).le⟩ ≤
        ((2 ^ m : Nat) : ENNReal) := by
  let delta : NNReal :=
    ⟨D.scaleFrom 0 m * L, (mul_pos (D.scaleFrom_pos 0 m) hL).le⟩
  have hcover : Auto.FractalDimensions.IsIntervalCover (D.limitSet u L)
      (delta : Real)
      ((D.starts 0 m u L).image fun c => c + D.scaleFrom 0 m * L / 2) := by
    change Auto.FractalDimensions.IsIntervalCover (D.limitSet u L)
      (D.scaleFrom 0 m * L)
      ((D.starts 0 m u L).image fun c => c + D.scaleFrom 0 m * L / 2)
    exact D.limitSet_intervalCover_generation m u L
  calc
    brrsEntropyNumber (D.limitSet u L) delta ≤
        ((((D.starts 0 m u L).image fun c => c + D.scaleFrom 0 m * L / 2).card :
          Nat) : ENNReal) := brrsEntropyNumber_le_of_intervalCover hcover
    _ ≤ ((D.starts 0 m u L).card : ENNReal) := by
      exact_mod_cast Finset.card_image_le
    _ = ((2 ^ m : Nat) : ENNReal) := by
      rw [D.starts_card 0 m u L hL]

end BinaryMoranData

/-- The binary Moran data associated to logarithmic Rutar hitting nodes.  The
root interval is subsequently rescaled by the first physical knot, so no
artificial initial generations are needed. -/
noncomputable def rutarMoranDataFromLogNodes (node : Nat → Real)
    (hgap : ∀ j : Nat,
      Real.log 2 ≤ Real.exp (node (j + 1)) - Real.exp (node j)) :
    BinaryMoranData :=
  BinaryMoranData.ofLogGaps (fun j => Real.exp (node j)) hgap

/-- After rescaling the root by its first physical knot, the rounded Moran
scales are exactly `exp (-exp (node n))`. -/
theorem rutarMoranDataFromLogNodes_root_mul_scale
    (node : Nat → Real)
    (hgap : ∀ j : Nat,
      Real.log 2 ≤ Real.exp (node (j + 1)) - Real.exp (node j))
    (n : Nat) :
    Real.exp (-Real.exp (node 0)) *
        (rutarMoranDataFromLogNodes node hgap).scale n =
      Real.exp (-Real.exp (node n)) := by
  unfold rutarMoranDataFromLogNodes
  rw [BinaryMoranData.scale_ofLogGaps]
  rw [← Real.exp_add]
  congr 1
  ring

/-- Exact integer hits of a Rutar logarithmic mass therefore produce a valid
binary Moran data sequence whose physical cylinder scales agree with the
prescribed `exp (-exp x)` scales at every hit. -/
noncomputable def rutarMoranDataOfExactHits
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real)) :
    BinaryMoranData :=
  rutarMoranDataFromLogNodes node
    (rutarPhysicalGap_of_exact_hits hg offset node hnode_pos hhit)

/-- The contractions selected by the exact-hit rounding are the exponential
of the consecutive physical-logarithmic gaps.  This records the actual ratio
sequence, rather than merely its binary admissibility. -/
theorem rutarMoranDataOfExactHits_ratio
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    (j : Nat) :
    (rutarMoranDataOfExactHits hg offset node hnode_pos hhit).ratio j =
      Real.exp (-(Real.exp (node (j + 1)) - Real.exp (node j))) := by
  rfl

/-- At an exact integer hit, the discretized mass density agrees exactly
with the original Rutar profile.  The only rounding error occurs between
successive selected nodes. -/
theorem rutarExactHit_profile_value
    {g : Real → Real} (offset : Nat) (node : Nat → Real)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    (j : Nat) :
    ((offset + j : Nat) : Real) * Real.log 2 / Real.exp (node j) =
      g (node j) := by
  have hmass := hhit j
  unfold rutarLogMass at hmass
  rw [← hmass]
  field_simp [ne_of_gt (Real.exp_pos (node j)),
    ne_of_gt (Real.log_pos (by norm_num : (1 : Real) < 2))]

/-- Differences of exact integer mass hits record exactly the number of
binary generations between them. -/
theorem rutarLogMass_difference_of_exact_hits
    {g : Real → Real} (offset : Nat) (node : Nat → Real)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    {p q : Nat} (hpq : p ≤ q) :
    rutarLogMass g (node q) - rutarLogMass g (node p) =
      ((q - p : Nat) : Real) := by
  have hindex : offset + q = offset + p + (q - p) := by omega
  rw [hhit q, hhit p, hindex]
  norm_num [Nat.cast_add]

/-- The exact logarithmic branching density of a rounded block is the
physical-logarithmic slope of the selected Rutar mass coordinate.  This is
the direct interface between the rounding construction and Moran entropy
estimates. -/
theorem rutarMoranDataOfExactHits_blockLogDensity_eq_massSlope
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    {p q : Nat} (hpq : p < q) :
    (rutarMoranDataOfExactHits hg offset node hnode_pos hhit).blockLogDensity p q =
      (rutarLogMass g (node q) - rutarLogMass g (node p)) * Real.log 2 /
        (Real.exp (node q) - Real.exp (node p)) := by
  rw [show rutarMoranDataOfExactHits hg offset node hnode_pos hhit =
      rutarMoranDataFromLogNodes node
        (rutarPhysicalGap_of_exact_hits hg offset node hnode_pos hhit) by rfl]
  change (BinaryMoranData.ofLogGaps (fun j => Real.exp (node j))
      (rutarPhysicalGap_of_exact_hits hg offset node hnode_pos hhit)).blockLogDensity p q = _
  rw [BinaryMoranData.blockLogDensity_ofLogGaps _ _ hpq]
  rw [rutarLogMass_difference_of_exact_hits offset node hhit hpq.le]

/-- A Rutar rescaled-increment estimate transfers exactly through the
integer-hit rounding to a block-density estimate.  The parameter on the
right is the physical logarithmic-scale ratio of the two selected nodes.
This is the local upper-bound interface needed before first-scale
bracketing; no lower bound on individual Moran contractions is used. -/
theorem rutarMoranDataOfExactHits_blockLogDensity_le_of_rescaled_increment
    {g gamma : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    (hrescaled : ∀ {y t : Real}, 0 < y → 0 < t →
      g (y + t) - Real.exp (-t) * g y ≤ rutarXi gamma t)
    {p q : Nat} (hpq : p < q) :
    (rutarMoranDataOfExactHits hg offset node hnode_pos hhit).blockLogDensity p q ≤
      gamma (Real.exp (node p - node q)) := by
  have hnode_strict : StrictMono node :=
    strictMono_nat_of_lt_succ
      (rutarNode_strict_of_exact_hits hg offset node hnode_pos hhit)
  let t : Real := node q - node p
  have ht : 0 < t := by
    dsimp [t]
    exact sub_pos.mpr (hnode_strict hpq)
  have hnodeq : node p + t = node q := by
    dsimp [t]
    ring
  have hexp_p : Real.exp (node p) = Real.exp (node q) * Real.exp (-t) := by
    rw [← Real.exp_add]
    congr 1
    rw [← hnodeq]
    ring
  have hden' : 0 < 1 - Real.exp (-t) := by
    exact sub_pos.mpr (Real.exp_lt_one_iff.mpr (by linarith))
  have hmass :
      (rutarLogMass g (node q) - rutarLogMass g (node p)) * Real.log 2 =
        Real.exp (node q) * g (node q) - Real.exp (node p) * g (node p) := by
    unfold rutarLogMass
    field_simp [ne_of_gt (Real.log_pos (by norm_num : (1 : Real) < 2))]
  have hquotient :
      (rutarLogMass g (node q) - rutarLogMass g (node p)) * Real.log 2 /
          (Real.exp (node q) - Real.exp (node p)) =
        (g (node p + t) - Real.exp (-t) * g (node p)) /
          (1 - Real.exp (-t)) := by
    rw [hmass, hnodeq, hexp_p]
    field_simp [ne_of_gt (Real.exp_pos (node q)), ne_of_gt hden']
  rw [rutarMoranDataOfExactHits_blockLogDensity_eq_massSlope
    hg offset node hnode_pos hhit hpq, hquotient]
  have hupper := hrescaled (y := node p) (t := t) (hnode_pos p) ht
  have hupper' :
      g (node p + t) - Real.exp (-t) * g (node p) ≤
        (1 - Real.exp (-t)) * gamma (Real.exp (-t)) := by
    change g (node p + t) - Real.exp (-t) * g (node p) ≤
      (1 - Real.exp (-t)) * gamma (Real.exp (-t)) at hupper
    exact hupper
  have htheta : Real.exp (node p - node q) = Real.exp (-t) := by
    congr 1
    dsimp [t]
    ring
  rw [htheta]
  apply (div_le_iff₀ hden').2
  simpa [mul_comm] using hupper'

/-- An exact Rutar chord at two integer-mass hits transfers to an exact
binary-Moran block-density identity.  This is the finite-scale lower-witness
counterpart to `rutarMoranDataOfExactHits_blockLogDensity_le_of_rescaled_increment`:
the only remaining step in a spectrum realization is to produce such chords
at the relevant asymptotic scale pairs. -/
theorem rutarMoranDataOfExactHits_blockLogDensity_eq_of_rescaled_chord
    {g gamma : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    {p q : Nat} (hpq : p < q)
    (hchord :
      g (node q) - Real.exp (node p - node q) * g (node p) =
        rutarXi gamma (node q - node p)) :
    (rutarMoranDataOfExactHits hg offset node hnode_pos hhit).blockLogDensity p q =
      gamma (Real.exp (node p - node q)) := by
  have hnode_strict : StrictMono node :=
    strictMono_nat_of_lt_succ
      (rutarNode_strict_of_exact_hits hg offset node hnode_pos hhit)
  let t : Real := node q - node p
  have ht : 0 < t := by
    dsimp [t]
    exact sub_pos.mpr (hnode_strict hpq)
  have hnodeq : node p + t = node q := by
    dsimp [t]
    ring
  have hexp_p : Real.exp (node p) = Real.exp (node q) * Real.exp (-t) := by
    rw [← Real.exp_add]
    congr 1
    rw [← hnodeq]
    ring
  have hden' : 0 < 1 - Real.exp (-t) := by
    exact sub_pos.mpr (Real.exp_lt_one_iff.mpr (by linarith))
  have hmass :
      (rutarLogMass g (node q) - rutarLogMass g (node p)) * Real.log 2 =
        Real.exp (node q) * g (node q) - Real.exp (node p) * g (node p) := by
    unfold rutarLogMass
    field_simp [ne_of_gt (Real.log_pos (by norm_num : (1 : Real) < 2))]
  have hquotient :
      (rutarLogMass g (node q) - rutarLogMass g (node p)) * Real.log 2 /
          (Real.exp (node q) - Real.exp (node p)) =
        (g (node p + t) - Real.exp (-t) * g (node p)) /
          (1 - Real.exp (-t)) := by
    rw [hmass, hnodeq, hexp_p]
    field_simp [ne_of_gt (Real.exp_pos (node q)), ne_of_gt hden']
  have hchord' :
      g (node p + t) - Real.exp (-t) * g (node p) =
        (1 - Real.exp (-t)) * gamma (Real.exp (-t)) := by
    calc
      g (node p + t) - Real.exp (-t) * g (node p) =
          g (node q) - Real.exp (node p - node q) * g (node p) := by
            have hdiff : node p - node q = -t := by
              dsimp [t]
              ring
            rw [hnodeq, hdiff]
      _ = rutarXi gamma (node q - node p) := hchord
      _ = (1 - Real.exp (-t)) * gamma (Real.exp (-t)) := by
            unfold rutarXi
            rw [show -(node q - node p) = -t by dsimp [t]]
  have htheta : Real.exp (node p - node q) = Real.exp (-t) := by
    congr 1
    dsimp [t]
    ring
  rw [rutarMoranDataOfExactHits_blockLogDensity_eq_massSlope
    hg offset node hnode_pos hhit hpq, hquotient, hchord', htheta]
  field_simp [ne_of_gt hden']

/-- The exact-scale identity for the Moran data rounded from integer mass
hits. -/
theorem rutarMoranDataOfExactHits_root_mul_scale
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    (n : Nat) :
    Real.exp (-Real.exp (node 0)) *
        (rutarMoranDataOfExactHits hg offset node hnode_pos hhit).scale n =
      Real.exp (-Real.exp (node n)) := by
  unfold rutarMoranDataOfExactHits
  exact rutarMoranDataFromLogNodes_root_mul_scale node
    (rutarPhysicalGap_of_exact_hits hg offset node hnode_pos hhit) n

/-- With the natural root normalization, the absolute length of the `n`th
rounded Moran cylinder is exactly the physical logarithmic scale attached to
the `n`th exact mass hit. -/
theorem rutarMoranDataOfExactHits_scale_mul_root
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    (n : Nat) :
    (rutarMoranDataOfExactHits hg offset node hnode_pos hhit).scale n *
        Real.exp (-Real.exp (node 0)) =
      Real.exp (-Real.exp (node n)) := by
  rw [mul_comm]
  exact rutarMoranDataOfExactHits_root_mul_scale hg offset node hnode_pos hhit n

/-- A hit at or after a logarithmic parameter has cylinder scale no larger
than the physical scale attached to that parameter. -/
theorem rutarMoranDataOfExactHits_scale_mul_root_le_of_le_node
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    {x : Real} {n : Nat} (hxn : x ≤ node n) :
    (rutarMoranDataOfExactHits hg offset node hnode_pos hhit).scale n *
        Real.exp (-Real.exp (node 0)) ≤ Real.exp (-Real.exp x) := by
  rw [rutarMoranDataOfExactHits_scale_mul_root hg offset node hnode_pos hhit]
  apply Real.exp_le_exp.mpr
  exact neg_le_neg (Real.exp_le_exp.mpr hxn)

/-- A hit strictly before a logarithmic parameter has cylinder scale strictly
larger than the physical scale attached to that parameter. -/
theorem rutarMoranDataOfExactHits_lt_scale_mul_root_of_node_lt
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    {x : Real} {n : Nat} (hnx : node n < x) :
    Real.exp (-Real.exp x) <
      (rutarMoranDataOfExactHits hg offset node hnode_pos hhit).scale n *
        Real.exp (-Real.exp (node 0)) := by
  rw [rutarMoranDataOfExactHits_scale_mul_root hg offset node hnode_pos hhit]
  apply Real.exp_lt_exp.mpr
  exact neg_lt_neg (Real.exp_lt_exp.mpr hnx)

/-- The complete discrete ratio-rounding step: a continuous unbounded Rutar
profile gives consecutive integer mass hits, binary Moran contractions, and
the exact physical scale identity at every selected generation.  No geometric
spectrum claim is assumed here; this is precisely the input later used by the
Moran entropy calculation. -/
theorem exists_rutarMoranData_of_continuous_unbounded
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (hcont : ContinuousOn g (Ioi (0 : Real)))
    (hunbounded : ∀ x M : Real, 0 < x →
      ∃ y : Real, x < y ∧ M ≤ rutarLogMass g y) :
    ∃ offset : Nat, ∃ node : Nat → Real, ∃ D : BinaryMoranData,
      (∀ j : Nat, 0 < node j) ∧
        (∀ j : Nat,
          rutarLogMass g (node j) = ((offset + j : Nat) : Real)) ∧
        (∀ n : Nat,
          Real.exp (-Real.exp (node 0)) * D.scale n =
            Real.exp (-Real.exp (node n))) := by
  rcases exists_rutarExactIntegerHitNodes hcont hunbounded with
    ⟨offset, node, hnode_pos, hhit⟩
  let D := rutarMoranDataOfExactHits hg offset node hnode_pos hhit
  refine ⟨offset, node, D, hnode_pos, hhit, ?_⟩
  intro n
  exact rutarMoranDataOfExactHits_root_mul_scale hg offset node hnode_pos hhit n

/-- A finite set with pairwise separation at least `delta` contributes its
full cardinality to the BRRS entropy of every ambient set containing it, at
the natural half scale.  This is the packing-to-entropy bridge used by the
Moran lower bounds. -/
theorem finset_card_le_brrsEntropyNumber_half_scale_of_separated
    {E : Set Real} {delta : Real} {T : Finset Real}
    (hdelta : 0 < delta) (hTsub : (↑T : Set Real) ⊆ E)
    (hTsep : ∀ x ∈ T, ∀ y ∈ T, x ≠ y → delta ≤ |x - y|) :
    (T.card : ENNReal) ≤ brrsEntropyNumber E ⟨delta / 2, by positivity⟩ := by
  let rho : NNReal := ⟨delta / 2, by positivity⟩
  change (T.card : ENNReal) ≤ brrsEntropyNumber E rho
  have hrho : (rho : ENNReal) = ENNReal.ofReal (delta / 2) := by
    calc
      (rho : ENNReal) = ENNReal.ofReal (rho : Real) := ENNReal.coe_nnreal_eq rho
      _ = ENNReal.ofReal (delta / 2) := by congr 1
  have hsep : Metric.IsSeparated (rho : ENNReal) (↑T : Set Real) := by
    intro x hx y hy hxy
    rw [edist_dist, hrho]
    rw [ENNReal.ofReal_lt_ofReal_iff_of_nonneg (by positivity)]
    rw [Real.dist_eq]
    exact lt_of_lt_of_le (by linarith)
      (hTsep x (by simpa using hx) y (by simpa using hy) hxy)
  have htwo : 2 * (rho / 2) = rho := by
    apply NNReal.eq
    simp only [NNReal.coe_mul, NNReal.coe_ofNat, NNReal.coe_div]
    ring
  have hpack : (↑T : Set Real).encard ≤ Metric.packingNumber (2 * (rho / 2)) E := by
    rw [htwo]
    exact hsep.encard_le_packingNumber hTsub
  have hcover : Metric.packingNumber (2 * (rho / 2)) E ≤
      Metric.externalCoveringNumber (rho / 2) E :=
    Metric.packingNumber_two_mul_le_externalCoveringNumber (rho / 2) E
  calc
    (T.card : ENNReal) = ((↑T : Set Real).encard : ENNReal) := by simp
    _ ≤ (Metric.packingNumber (2 * (rho / 2)) E : ENNReal) := by
      exact_mod_cast hpack
    _ ≤ (Metric.externalCoveringNumber (rho / 2) E : ENNReal) := by
      exact_mod_cast hcover
    _ = brrsEntropyNumber E rho := rfl

/-- A strictly `delta`-separated finite subset already forces its full
cardinality at BRRS resolution `delta`.  This endpoint-sensitive packing
version is needed when a first-scale Moran cylinder is only known to be
strictly longer than the prescribed resolution. -/
theorem finset_card_le_brrsEntropyNumber_of_strict_separated
    {E : Set Real} {delta : Real} {T : Finset Real}
    (hdelta : 0 < delta) (hTsub : (↑T : Set Real) ⊆ E)
    (hTsep : ∀ x ∈ T, ∀ y ∈ T, x ≠ y → delta < |x - y|) :
    (T.card : ENNReal) ≤ brrsEntropyNumber E ⟨delta, hdelta.le⟩ := by
  let rho : NNReal := ⟨delta, hdelta.le⟩
  change (T.card : ENNReal) ≤ brrsEntropyNumber E rho
  have hrho : (rho : ENNReal) = ENNReal.ofReal delta := by
    calc
      (rho : ENNReal) = ENNReal.ofReal (rho : Real) := ENNReal.coe_nnreal_eq rho
      _ = ENNReal.ofReal delta := by congr 1
  have hsep : Metric.IsSeparated (rho : ENNReal) (↑T : Set Real) := by
    intro x hx y hy hxy
    rw [edist_dist, hrho]
    rw [ENNReal.ofReal_lt_ofReal_iff_of_nonneg hdelta.le]
    rw [Real.dist_eq]
    exact hTsep x (by simpa using hx) y (by simpa using hy) hxy
  have htwo : 2 * (rho / 2) = rho := by
    apply NNReal.eq
    simp only [NNReal.coe_mul, NNReal.coe_ofNat, NNReal.coe_div]
    ring
  have hpack : (↑T : Set Real).encard ≤ Metric.packingNumber (2 * (rho / 2)) E := by
    rw [htwo]
    exact hsep.encard_le_packingNumber hTsub
  have hcover : Metric.packingNumber (2 * (rho / 2)) E ≤
      Metric.externalCoveringNumber (rho / 2) E :=
    Metric.packingNumber_two_mul_le_externalCoveringNumber (rho / 2) E
  calc
    (T.card : ENNReal) = ((↑T : Set Real).encard : ENNReal) := by simp
    _ ≤ (Metric.packingNumber (2 * (rho / 2)) E : ENNReal) := by
      exact_mod_cast hpack
    _ ≤ (Metric.externalCoveringNumber (rho / 2) E : ENNReal) :=
      by exact_mod_cast hcover
    _ = brrsEntropyNumber E rho := rfl

/-- Every generation supplies `2^m` explicitly separated points of the limit
set.  At half the descendant-cylinder length this gives the matching lower
BRRS entropy estimate. -/
theorem BinaryMoranData.generation_card_le_brrsEntropyNumber
    (D : BinaryMoranData) (m : Nat) (u L : Real) (hL : 0 < L) :
    ((2 ^ m : Nat) : ENNReal) ≤ brrsEntropyNumber (D.limitSet u L)
      ⟨(D.scaleFrom 0 m * L) / 2,
        (div_pos (mul_pos (D.scaleFrom_pos 0 m) hL) (by norm_num)).le⟩ := by
  rw [← D.starts_card 0 m u L hL]
  apply finset_card_le_brrsEntropyNumber_half_scale_of_separated
  · exact mul_pos (D.scaleFrom_pos 0 m) hL
  · intro x hx
    exact D.starts_subset_limitSet m u L hL.le x hx
  · intro x hx y hy hxy
    exact D.starts_separated 0 m u L hL.le hx hy hxy

/-- A fixed parent cylinder witnesses the complementary lower local entropy
bound: all of its level-`q` descendants are separated points in the relevant
BRRS testing interval. -/
theorem BinaryMoranData.subtree_card_le_brrsEntropyNumber_parentInterval
    (D : BinaryMoranData) {p q : Nat} {u L c : Real}
    (hL : 0 < L) (hpq : p ≤ q)
    (hc : c ∈ D.starts 0 p u L) :
    ((2 ^ (q - p) : Nat) : ENNReal) ≤
      brrsEntropyNumber
        (D.limitSet u L ∩ brrsInterval c (D.scaleFrom 0 p * L))
        ⟨(D.scaleFrom p (q - p) * (D.scaleFrom 0 p * L)) / 2,
          (div_pos
            (mul_pos (D.scaleFrom_pos p (q - p))
              (mul_pos (D.scaleFrom_pos 0 p) hL)) (by norm_num)).le⟩ := by
  have hparent : 0 < D.scaleFrom 0 p * L :=
    mul_pos (D.scaleFrom_pos 0 p) hL
  rw [← D.starts_card p (q - p) c (D.scaleFrom 0 p * L) hparent]
  apply finset_card_le_brrsEntropyNumber_half_scale_of_separated
  · exact mul_pos (D.scaleFrom_pos p (q - p)) hparent
  · exact D.subtreeStarts_subset_limitSet_inter_parentInterval hL.le hpq hc
  · intro x hx y hy hxy
    exact D.starts_separated p (q - p) c (D.scaleFrom 0 p * L)
      hparent.le hx hy hxy

/-- The same lower witness expressed at the global level-`q` cylinder scale.
This is the form used when comparing a Moran construction with the exact
power-scale convention in the Assouad spectrum. -/
theorem BinaryMoranData.subtree_card_le_brrsEntropyNumber_parentInterval_rootScale
    (D : BinaryMoranData) {p q : Nat} (u L : Real) (hL : 0 < L)
    (hpq : p ≤ q) {c : Real} (hc : c ∈ D.starts 0 p u L) :
    ((2 ^ (q - p) : Nat) : ENNReal) ≤
      brrsEntropyNumber
        (D.limitSet u L ∩ brrsInterval c (D.scaleFrom 0 p * L))
        ⟨(D.scaleFrom 0 q * L) / 2,
          (div_pos (mul_pos (D.scaleFrom_pos 0 q) hL) (by norm_num)).le⟩ := by
  have hparent : 0 < D.scaleFrom 0 p * L :=
    mul_pos (D.scaleFrom_pos 0 p) hL
  rw [← D.starts_card p (q - p) c (D.scaleFrom 0 p * L) hparent]
  apply finset_card_le_brrsEntropyNumber_half_scale_of_separated
  · exact mul_pos (D.scaleFrom_pos 0 q) hL
  · exact D.subtreeStarts_subset_limitSet_inter_parentInterval hL.le hpq hc
  · intro x hx y hy hxy
    have hsep := D.starts_separated p (q - p) c
      (D.scaleFrom 0 p * L) hparent.le hx hy hxy
    rw [D.scaleFrom_descendant_length L hpq] at hsep
    exact hsep

/-- If the level-`q` cylinder length is strictly larger than a prescribed
BRRS resolution, the descendants of a level-`p` cylinder give a lower local
entropy bound at that prescribed resolution.  This removes the artificial
factor of two in the basic packing lemma and is the form used with the
first exact-hit node *after* a logarithmic scale. -/
theorem BinaryMoranData.subtree_card_le_brrsEntropyNumber_of_lt_rootScale
    (D : BinaryMoranData) {p q : Nat} (u L c R delta : Real)
    (hL : 0 < L) (hpq : p ≤ q) (hc : c ∈ D.starts 0 p u L)
    (hparent : D.scaleFrom 0 p * L ≤ R)
    (hdelta : 0 < delta) (hscale : delta < D.scaleFrom 0 q * L) :
    ((2 ^ (q - p) : Nat) : ENNReal) ≤
      brrsEntropyNumber
        (D.limitSet u L ∩ brrsInterval c R) ⟨delta, hdelta.le⟩ := by
  have hparent_pos : 0 < D.scaleFrom 0 p * L :=
    mul_pos (D.scaleFrom_pos 0 p) hL
  rw [← D.starts_card p (q - p) c (D.scaleFrom 0 p * L) hparent_pos]
  apply finset_card_le_brrsEntropyNumber_of_strict_separated hdelta
  · intro x hx
    have hx' := (D.subtreeStarts_subset_limitSet_inter_parentInterval hL.le hpq hc) hx
    constructor
    · exact hx'.1
    · exact brrsInterval_mono hparent hx'.2
  · intro x hx y hy hxy
    have hsep := D.starts_separated p (q - p) c
      (D.scaleFrom 0 p * L) hparent_pos.le hx hy hxy
    rw [D.scaleFrom_descendant_length L hpq] at hsep
    exact lt_of_lt_of_le hscale hsep

/-- At two logarithmic parameters, the exact-hit Moran set has a canonical
lower BRRS entropy witness.  The parent is the first selected cylinder no
larger than the large scale, and the children are taken one generation before
the first selected cylinder no larger than the small scale. -/
theorem rutarExactHit_lower_entropy_witness
    {g : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    {x tau : Real} (hx : node 0 < x) (htau : 0 ≤ tau)
    (hstrict : rutarExactHitIndex hg offset node hnode_pos hhit x <
      rutarExactHitIndex hg offset node hnode_pos hhit (x + tau)) :
    let D := rutarMoranDataOfExactHits hg offset node hnode_pos hhit
    let L := Real.exp (-Real.exp (node 0))
    let p := rutarExactHitIndex hg offset node hnode_pos hhit x
    let q := rutarExactHitIndex hg offset node hnode_pos hhit (x + tau)
    let R := Real.exp (-Real.exp x)
    let delta := Real.exp (-Real.exp (x + tau))
    ((2 ^ ((q - 1) - p) : Nat) : ENNReal) ≤
      brrsEntropyNumber (D.limitSet 0 L ∩ brrsInterval 0 R) ⟨delta, (Real.exp_pos _).le⟩ := by
  dsimp
  let D := rutarMoranDataOfExactHits hg offset node hnode_pos hhit
  let L : Real := Real.exp (-Real.exp (node 0))
  let p : Nat := rutarExactHitIndex hg offset node hnode_pos hhit x
  let q : Nat := rutarExactHitIndex hg offset node hnode_pos hhit (x + tau)
  let R : Real := Real.exp (-Real.exp x)
  let delta : Real := Real.exp (-Real.exp (x + tau))
  have hxtau : node 0 < x + tau :=
    lt_of_lt_of_le hx (le_add_of_nonneg_right htau)
  have hqbracket := rutarExactHitIndex_bracket hg offset node hnode_pos hhit hxtau
  have hqpos : 0 < q := by simpa [q] using hqbracket.1
  have hqleft : node (q - 1) < x + tau := by
    simpa [q] using hqbracket.2.1
  have hpq : p ≤ q - 1 := by
    dsimp [p, q]
    omega
  have hparent : D.scaleFrom 0 p * L ≤ R := by
    rw [← D.scale_eq_scaleFrom_zero p]
    dsimp [D, L, R]
    exact rutarMoranDataOfExactHits_scale_mul_root_le_of_le_node
      hg offset node hnode_pos hhit
      (le_node_rutarExactHitIndex hg offset node hnode_pos hhit x)
  have hscale : delta < D.scaleFrom 0 (q - 1) * L := by
    rw [← D.scale_eq_scaleFrom_zero (q - 1)]
    dsimp [D, L, delta]
    exact rutarMoranDataOfExactHits_lt_scale_mul_root_of_node_lt
      hg offset node hnode_pos hhit hqleft
  exact D.subtree_card_le_brrsEntropyNumber_of_lt_rootScale 0 L 0 R delta
    (Real.exp_pos _) hpq (D.base_mem_starts 0 p 0 L) hparent
    (Real.exp_pos _) hscale

/-- The two physical scales separated by the logarithmic window
`-log theta` obey exactly the BRRS power-scale relation. -/
theorem rutarPhysicalScale_rpow_at_theta {theta x : Real}
    (htheta : 0 < theta) :
    (Real.exp (-Real.exp (x - Real.log theta))) ^ theta =
      Real.exp (-Real.exp x) := by
  rw [Real.rpow_def_of_pos (Real.exp_pos _), Real.log_exp]
  congr 1
  rw [Real.exp_sub, Real.exp_log htheta]
  field_simp [htheta.ne']

/-- The corresponding quotient of large and small physical scales has the
expected positive exponential form. -/
theorem rutarPhysicalScale_div_at_theta {theta x : Real}
    (htheta : 0 < theta) :
    Real.exp (-Real.exp x) / Real.exp (-Real.exp (x - Real.log theta)) =
      Real.exp ((1 - theta) * Real.exp (x - Real.log theta)) := by
  have hscale : theta * Real.exp (x - Real.log theta) = Real.exp x := by
    rw [Real.exp_sub, Real.exp_log htheta]
    field_simp [htheta.ne']
  rw [← Real.exp_sub]
  congr 1
  rw [← hscale]
  ring

/-- At the two canonical exact-hit scales associated to a fixed BRRS
parameter, a Rutar chord upper estimate gives the required local Moran
entropy upper bound.  The factor `24` is `3` active parents, the one extra
parent generation, and the two endpoint rounding units. -/
theorem rutarExactHit_upper_entropy_bound_at_theta
    {g : Real → Real} {Gamma theta : Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    {x a : Real} (hx : node 0 < x) (htheta : theta ∈ Ioo (0 : Real) 1)
    (hchord : g (x - Real.log theta) - theta * g x ≤
      (1 - theta) * Gamma) :
    let D := rutarMoranDataOfExactHits hg offset node hnode_pos hhit
    let L := Real.exp (-Real.exp (node 0))
    let delta := Real.exp (-Real.exp (x - Real.log theta))
    brrsEntropyNumber
        (D.limitSet 0 L ∩ brrsInterval a (delta ^ theta))
        ⟨delta, (Real.exp_pos _).le⟩ ≤
      ENNReal.ofReal (24 * (((delta ^ theta) / delta) ^ Gamma)) := by
  dsimp
  let D := rutarMoranDataOfExactHits hg offset node hnode_pos hhit
  let L : Real := Real.exp (-Real.exp (node 0))
  let tau : Real := -Real.log theta
  let delta : Real := Real.exp (-Real.exp (x + tau))
  let R : Real := Real.exp (-Real.exp x)
  let p : Nat := rutarExactHitIndex hg offset node hnode_pos hhit x
  let q : Nat := rutarExactHitIndex hg offset node hnode_pos hhit (x + tau)
  have hL : 0 < L := by
    dsimp [L]
    exact Real.exp_pos _
  have htau : 0 ≤ tau := by
    dsimp [tau]
    exact neg_nonneg.mpr (Real.log_nonpos htheta.1.le htheta.2.le)
  have hchord' :
      g (x + tau) - Real.exp (-tau) * g x ≤
        rutarXi (fun _ : Real => Gamma) tau := by
    simpa [tau, rutarXi, sub_eq_add_neg, Real.exp_log htheta.1] using hchord
  have hlog := rutarExactHit_logCard_upper_of_chord
    (gamma := fun _ : Real => Gamma) hg offset node hnode_pos hhit hx htau hchord'
  have hlog' : ((q - p : Nat) : Real) * Real.log 2 ≤
      Real.exp (x + tau) * rutarXi (fun _ : Real => Gamma) tau +
        2 * Real.log 2 := by
    simpa [p, q] using hlog
  have htwo := two_pow_le_four_mul_physical_ratio_rpow_of_rutarLogCard_upper
    (q - p) (x := x) (tau := tau) (Gamma := Gamma) hlog'
  have htwo' : ((2 ^ (q - p) : Nat) : Real) ≤
      4 * ((R / delta) ^ Gamma) := by
    simpa [R, delta] using htwo
  have hpbracket := rutarExactHitIndex_bracket hg offset node hnode_pos hhit hx
  have hppos : 0 < p := by simpa [p] using hpbracket.1
  have hprev : node (p - 1) < x := by simpa [p] using hpbracket.2.1
  have hpqhit : p ≤ q := by
    dsimp [p, q]
    exact rutarExactHitIndex_mono hg offset node hnode_pos hhit
      (le_add_of_nonneg_right htau)
  have hpq : p - 1 ≤ q := by omega
  have hRlt : R < D.scaleFrom 0 (p - 1) * L := by
    rw [← D.scale_eq_scaleFrom_zero (p - 1)]
    dsimp [D, L, R]
    exact rutarMoranDataOfExactHits_lt_scale_mul_root_of_node_lt
      hg offset node hnode_pos hhit hprev
  have hqnode : x + tau ≤ node q := by
    dsimp [q]
    exact le_node_rutarExactHitIndex hg offset node hnode_pos hhit (x + tau)
  have hqscale : D.scaleFrom 0 q * L ≤ delta := by
    rw [← D.scale_eq_scaleFrom_zero q]
    dsimp [D, L, delta]
    exact rutarMoranDataOfExactHits_scale_mul_root_le_of_le_node
      hg offset node hnode_pos hhit hqnode
  let dq : NNReal := ⟨D.scaleFrom 0 q * L,
    (mul_pos (D.scaleFrom_pos 0 q) hL).le⟩
  let d : NNReal := ⟨delta, (Real.exp_pos _).le⟩
  have hdq : dq ≤ d := by
    apply NNReal.coe_le_coe.2
    exact hqscale
  have hcover := D.brrsEntropyNumber_inter_brrsInterval_le_of_moran_scales
    (p := p - 1) (q := q) 0 L a R hL hpq hRlt
  have hcover' : brrsEntropyNumber (D.limitSet 0 L ∩ brrsInterval a R) dq ≤
      ((3 * 2 ^ (q - (p - 1)) : Nat) : ENNReal) := by
    change brrsEntropyNumber (D.limitSet 0 L ∩ brrsInterval a R)
      ⟨D.scaleFrom 0 q * L, (mul_pos (D.scaleFrom_pos 0 q) hL).le⟩ ≤ _
    exact hcover
  have hfactor : ((2 ^ (q - (p - 1)) : Nat) : Real) =
      2 * ((2 ^ (q - p) : Nat) : Real) := by
    have hindex : q - (p - 1) = 1 + (q - p) := by omega
    rw [hindex, pow_add]
    norm_num
  have hcardReal : ((3 * 2 ^ (q - (p - 1)) : Nat) : Real) ≤
      24 * ((R / delta) ^ Gamma) := by
    calc
      ((3 * 2 ^ (q - (p - 1)) : Nat) : Real) =
          3 * ((2 ^ (q - (p - 1)) : Nat) : Real) := by norm_num
      _ = 3 * (2 * ((2 ^ (q - p) : Nat) : Real)) := by rw [hfactor]
      _ = 6 * ((2 ^ (q - p) : Nat) : Real) := by ring
      _ ≤ 6 * (4 * ((R / delta) ^ Gamma)) :=
        mul_le_mul_of_nonneg_left htwo' (by norm_num)
      _ = 24 * ((R / delta) ^ Gamma) := by ring
  have hcardENN : ((3 * 2 ^ (q - (p - 1)) : Nat) : ENNReal) ≤
      ENNReal.ofReal (24 * ((R / delta) ^ Gamma)) := by
    rw [← ENNReal.ofReal_natCast]
    exact ENNReal.ofReal_le_ofReal hcardReal
  have hRpow : delta ^ theta = R := by
    dsimp [delta, R, tau]
    exact rutarPhysicalScale_rpow_at_theta htheta.1
  change brrsEntropyNumber
      (D.limitSet 0 L ∩ brrsInterval a (delta ^ theta)) d ≤
    ENNReal.ofReal (24 * (((delta ^ theta) / delta) ^ Gamma))
  rw [hRpow]
  calc
    brrsEntropyNumber (D.limitSet 0 L ∩ brrsInterval a R) d ≤
        brrsEntropyNumber (D.limitSet 0 L ∩ brrsInterval a R) dq :=
      brrsEntropyNumber_anti hdq
    _ ≤ ((3 * 2 ^ (q - (p - 1)) : Nat) : ENNReal) := hcover'
    _ ≤ ENNReal.ofReal (24 * ((R / delta) ^ Gamma)) := hcardENN

/-- The exact-hit Moran construction has the prescribed fixed-parameter BRRS
upper spectrum bound as soon as the Rutar chord bound holds eventually.  The
proof treats small physical scales using
`rutarExactHit_upper_entropy_bound_at_theta`; the remaining finite-scale head
is absorbed into one explicit constant by the one-dimensional grid estimate. -/
theorem hasBRRSAssouadSpectrumExponent_rutarExactHits_of_eventually_chord_at_theta
    {g gamma : Real → Real} (hg : IsRutarGOn g 0 1)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass g (node j) = ((offset + j : Nat) : Real))
    {theta Gamma : Real} (htheta : theta ∈ Ioo (0 : Real) 1)
    (hgamma_nonneg : 0 ≤ gamma theta) (hGamma : gamma theta < Gamma)
    (hchord : ∀ᶠ y : Real in atTop,
      g (y - Real.log theta) - theta * g y ≤ (1 - theta) * gamma theta) :
    HasBRRSAssouadSpectrumExponent
      ((rutarMoranDataOfExactHits hg offset node hnode_pos hhit).limitSet 0
        (Real.exp (-Real.exp (node 0)))) theta Gamma := by
  rcases (eventually_atTop.1 hchord) with ⟨X, hX⟩
  let B : Real := max X (node 0 + 1)
  let delta0 : Real := Real.exp (-Real.exp (B - Real.log theta))
  let C : Real := max 24 (4 / delta0)
  let D := rutarMoranDataOfExactHits hg offset node hnode_pos hhit
  let L : Real := Real.exp (-Real.exp (node 0))
  have hdelta0 : 0 < delta0 := by
    dsimp [delta0]
    exact Real.exp_pos _
  have hC24 : 24 ≤ C := le_max_left _ _
  have hC : 0 < C := lt_of_lt_of_le (by norm_num) hC24
  have hGamma0 : 0 ≤ Gamma := hgamma_nonneg.trans hGamma.le
  refine ⟨C, hC, ?_⟩
  intro delta hdelta hdelta_one a
  let d : Real := (delta : Real)
  let R : Real := d ^ theta
  have hd : 0 < d := by
    dsimp [d]
    exact_mod_cast hdelta
  have hd_one : d < 1 := by
    dsimp [d]
    exact_mod_cast hdelta_one
  have hRpos : 0 < R := by
    dsimp [R]
    exact Real.rpow_pos_of_pos hd _
  have hRone : R < 1 := by
    dsimp [R]
    exact Real.rpow_lt_one hd.le hd_one htheta.1
  have hdeltaR : d ≤ R := by
    dsimp [R]
    calc
      d = d ^ (1 : Real) := by rw [Real.rpow_one]
      _ ≤ d ^ theta :=
        Real.rpow_le_rpow_of_exponent_ge hd hd_one.le htheta.2.le
  have hratio_one : 1 ≤ R / d := (one_le_div₀ hd).2 hdeltaR
  have hdelta_eq : (⟨d, hd.le⟩ : NNReal) = delta := by
    apply NNReal.eq
    rfl
  rw [← hdelta_eq]
  change brrsEntropyNumber (D.limitSet 0 L ∩ brrsInterval a R) ⟨d, hd.le⟩ ≤
    ENNReal.ofReal (C * ((R / d) ^ Gamma))
  by_cases hsmall : d < delta0
  · let z : Real := Real.log (-Real.log d)
    let x : Real := z + Real.log theta
    have hlogneg : Real.log d < 0 := Real.log_neg hd hd_one
    have hneglog : 0 < -Real.log d := neg_pos.mpr hlogneg
    have hzexp : Real.exp z = -Real.log d := by
      dsimp [z]
      exact Real.exp_log hneglog
    have hxcoord : x - Real.log theta = z := by
      dsimp [x]
      ring
    have hdphysical : d = Real.exp (-Real.exp (x - Real.log theta)) := by
      rw [hxcoord]
      calc
        d = Real.exp (Real.log d) := (Real.exp_log hd).symm
        _ = Real.exp (-(-Real.log d)) := by congr 1; ring
        _ = Real.exp (-Real.exp z) := by rw [hzexp]
    have hsmall' : Real.exp (-Real.exp (x - Real.log theta)) <
        Real.exp (-Real.exp (B - Real.log theta)) := by
      simpa [delta0, hdphysical] using hsmall
    have hinner : -Real.exp (x - Real.log theta) <
        -Real.exp (B - Real.log theta) :=
      (Real.exp_lt_exp).mp hsmall'
    have hexpinner : Real.exp (B - Real.log theta) <
        Real.exp (x - Real.log theta) := by
      linarith
    have hcoord : B - Real.log theta < x - Real.log theta :=
      (Real.exp_lt_exp).mp hexpinner
    have hBx : B < x := by linarith
    have hXx : X ≤ x :=
      (le_max_left X (node 0 + 1)).trans hBx.le
    have hnodex : node 0 < x := by
      calc
        node 0 < node 0 + 1 := by linarith
        _ ≤ B := le_max_right _ _
        _ < x := hBx
    have hsmallEntropy := rutarExactHit_upper_entropy_bound_at_theta
      (Gamma := gamma theta) (a := a) hg offset node hnode_pos hhit hnodex htheta
        (hX x hXx)
    have hsmallEntropy' :
        brrsEntropyNumber (D.limitSet 0 L ∩ brrsInterval a R) ⟨d, hd.le⟩ ≤
          ENNReal.ofReal (24 * ((R / d) ^ gamma theta)) := by
      have hdeltaNN :
          (⟨d, hd.le⟩ : NNReal) =
            ⟨Real.exp (-Real.exp (x - Real.log theta)),
              (Real.exp_pos _).le⟩ := by
        apply NNReal.eq
        exact hdphysical
      have hRphysical : R =
          Real.exp (-Real.exp (x - Real.log theta)) ^ theta := by
        dsimp [R]
        rw [hdphysical]
      rw [hdeltaNN, hRphysical, hdphysical]
      simpa only [D, L] using hsmallEntropy
    have hpow : (R / d) ^ gamma theta ≤ (R / d) ^ Gamma :=
      Real.rpow_le_rpow_of_exponent_le hratio_one hGamma.le
    have hsmallReal : 24 * ((R / d) ^ gamma theta) ≤
        C * ((R / d) ^ Gamma) := by
      calc
        24 * ((R / d) ^ gamma theta) ≤ 24 * ((R / d) ^ Gamma) :=
          mul_le_mul_of_nonneg_left hpow (by norm_num)
        _ ≤ C * ((R / d) ^ Gamma) :=
          mul_le_mul_of_nonneg_right hC24
            (Real.rpow_nonneg (div_nonneg hRpos.le hd.le) _)
    exact hsmallEntropy'.trans (ENNReal.ofReal_le_ofReal hsmallReal)
  · have hlarge : delta0 ≤ d := le_of_not_gt hsmall
    have hRdelta0 : R * delta0 ≤ d := by
      calc
        R * delta0 ≤ 1 * delta0 :=
          mul_le_mul_of_nonneg_right hRone.le hdelta0.le
        _ = delta0 := by ring
        _ ≤ d := hlarge
    have hratio_upper : R / d ≤ 1 / delta0 := by
      apply (div_le_iff₀ hd).2
      calc
        R ≤ d / delta0 := (le_div_iff₀ hdelta0).2 hRdelta0
        _ = (1 / delta0) * d := by ring
    have hpowone : 1 ≤ (R / d) ^ Gamma :=
      Real.one_le_rpow hratio_one hGamma0
    have hheadReal : 4 * (R / d) ≤ C * ((R / d) ^ Gamma) := by
      calc
        4 * (R / d) ≤ 4 * (1 / delta0) :=
          mul_le_mul_of_nonneg_left hratio_upper (by norm_num)
        _ = 4 / delta0 := by ring
        _ ≤ C := le_max_right _ _
        _ = C * 1 := by ring
        _ ≤ C * ((R / d) ^ Gamma) :=
          mul_le_mul_of_nonneg_left hpowone hC.le
    have hgrid := brrsEntropyNumber_inter_interval_le_four_mul_ratio
      (D.limitSet 0 L) (a := a) (R := R) (delta := ⟨d, hd.le⟩) hd hdeltaR
    exact hgrid.trans (ENNReal.ofReal_le_ofReal hheadReal)

/-- Specialization of the preceding generic exact-hit upper theorem to the
global Rutar concatenation. -/
theorem hasBRRSAssouadSpectrumExponent_rutarConcatenationExactHits_at_theta
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass (rutarConcatenation gamma) (node j) =
        ((offset + j : Nat) : Real))
    {theta Gamma : Real} (htheta : theta ∈ Ioo (0 : Real) 1)
    (hGamma : gamma theta < Gamma) :
    HasBRRSAssouadSpectrumExponent
      ((rutarMoranDataOfExactHits (rutarConcatenation_isRutarGOn hgamma)
        offset node hnode_pos hhit).limitSet 0
        (Real.exp (-Real.exp (node 0)))) theta Gamma := by
  apply hasBRRSAssouadSpectrumExponent_rutarExactHits_of_eventually_chord_at_theta
    (gamma := gamma) (rutarConcatenation_isRutarGOn hgamma)
    offset node hnode_pos hhit htheta
  · exact (hgamma.1 theta htheta).1
  · exact hGamma
  · exact eventually_rutarConcatenation_chord_le_at_theta hgamma htheta

/-- A strict logarithmic cardinality surplus exponentiates to the strict
power-scale surplus needed to contradict a proposed BRRS covering exponent.
The two physical scales are separated by the exact Rutar window `-log theta`.
-/
theorem rutarPhysicalScale_power_lt_two_pow_of_log_lt
    {C beta theta x : Real} {m : Nat}
    (hC : 0 < C) (htheta : 0 < theta)
    (hlog : Real.log C + beta * ((1 - theta) * Real.exp (x - Real.log theta)) <
      (m : Real) * Real.log 2) :
    ENNReal.ofReal
        (C * ((Real.exp (-Real.exp x) /
          Real.exp (-Real.exp (x - Real.log theta))) ^ beta)) <
      ((2 ^ m : Nat) : ENNReal) := by
  have htarget :
      C * ((Real.exp (-Real.exp x) /
          Real.exp (-Real.exp (x - Real.log theta))) ^ beta) =
        Real.exp (Real.log C + beta *
          ((1 - theta) * Real.exp (x - Real.log theta))) := by
    rw [rutarPhysicalScale_div_at_theta htheta]
    calc
      C * (Real.exp ((1 - theta) * Real.exp (x - Real.log theta))) ^ beta =
          C * Real.exp (((1 - theta) * Real.exp (x - Real.log theta)) * beta) := by
            rw [Real.rpow_def_of_pos (Real.exp_pos _), Real.log_exp]
      _ = Real.exp (Real.log C) *
          Real.exp (((1 - theta) * Real.exp (x - Real.log theta)) * beta) := by
            rw [Real.exp_log hC]
      _ = Real.exp (Real.log C +
          ((1 - theta) * Real.exp (x - Real.log theta)) * beta) :=
            (Real.exp_add _ _).symm
      _ = Real.exp (Real.log C + beta *
          ((1 - theta) * Real.exp (x - Real.log theta))) := by
            congr 1
            ring
  have hpow : ((2 ^ m : Nat) : Real) =
      Real.exp ((m : Real) * Real.log 2) := by
    calc
      ((2 ^ m : Nat) : Real) = (2 : Real) ^ m := by norm_num
      _ = (Real.exp (Real.log 2)) ^ m := by
        rw [Real.exp_log (by norm_num : (0 : Real) < 2)]
      _ = Real.exp ((m : Nat) * Real.log 2) :=
        (Real.exp_nat_mul (Real.log 2) m).symm
      _ = Real.exp ((m : Real) * Real.log 2) := by norm_num
  rw [htarget, (ENNReal.ofReal_natCast (2 ^ m)).symm]
  exact (ENNReal.ofReal_lt_ofReal_iff
    (by positivity : 0 < ((2 ^ m : Nat) : Real))).mpr
    (by rw [hpow]; exact Real.exp_lt_exp.mpr hlog)

/-- A family of strict finite-scale entropy witnesses rules out a proposed
BRRS spectrum exponent.  Keeping this elementary quantifier bridge separate
lets the Rutar lower construction focus entirely on producing its Moran
packing witnesses. -/
theorem not_hasBRRSAssouadSpectrumExponent_of_witnesses
    {E : Set Real} {theta beta : Real}
    (hwitness : ∀ C : Real, 0 < C → ∃ delta : NNReal, 0 < delta ∧ delta < 1 ∧
      ∃ a : Real,
        ENNReal.ofReal
          (C * ((((delta : Real) ^ theta) / (delta : Real)) ^ beta)) <
          brrsEntropyNumber (E ∩ brrsInterval a ((delta : Real) ^ theta)) delta) :
    ¬ HasBRRSAssouadSpectrumExponent E theta beta := by
  intro hbeta
  rcases hbeta with ⟨C, hC, hcover⟩
  rcases hwitness C hC with ⟨delta, hdelta, hdelta_one, a, hwitness⟩
  exact (not_lt_of_ge (hcover delta hdelta hdelta_one a)) hwitness

/-- A positive exponent strictly below the prescribed Rutar value fails the
literal equality-scale BRRS covering condition for the integer-hit Moran
construction.  The proof chooses a sufficiently late active block: its exact
chord produces a strict finite packing witness, while the physical scales at
the two endpoints satisfy `delta ^ theta = R` on the nose. -/
theorem rutarExactHit_not_hasBRRSAssouadSpectrumExponent_at_theta
    {gamma : Real → Real} (hgamma : IsRutarAdmissible gamma)
    (offset : Nat) (node : Nat → Real)
    (hnode_pos : ∀ j : Nat, 0 < node j)
    (hhit : ∀ j : Nat,
      rutarLogMass (rutarConcatenation gamma) (node j) =
        ((offset + j : Nat) : Real))
    {theta beta : Real} (htheta : theta ∈ Ioo (0 : Real) 1)
    (hbeta_pos : 0 < beta) (hbeta_lt : beta < gamma theta) :
    ¬ HasBRRSAssouadSpectrumExponent
      ((rutarMoranDataOfExactHits (rutarConcatenation_isRutarGOn hgamma)
        offset node hnode_pos hhit).limitSet 0
          (Real.exp (-Real.exp (node 0)))) theta beta := by
  let D := rutarMoranDataOfExactHits (rutarConcatenation_isRutarGOn hgamma)
    offset node hnode_pos hhit
  let L : Real := Real.exp (-Real.exp (node 0))
  change ¬ HasBRRSAssouadSpectrumExponent (D.limitSet 0 L) theta beta
  apply not_hasBRRSAssouadSpectrumExponent_of_witnesses
  intro C hC
  let A : Nat → Real := fun n => rutarPieceStart (2 * n)
  let B : Nat → Real := fun n =>
    (1 - theta) * Real.exp (A n - Real.log theta)
  have hA : Tendsto A atTop atTop := by
    simpa [A] using tendsto_rutarActiveStart_atTop
  have hAsh : Tendsto (fun n : Nat => A n + (-Real.log theta)) atTop atTop :=
    hA.atTop_add tendsto_const_nhds
  have hB : Tendsto B atTop atTop := by
    have hExp := Real.tendsto_exp_atTop.comp hAsh
    simpa [B, sub_eq_add_neg] using
      hExp.const_mul_atTop (sub_pos.mpr htheta.2)
  have hgap : 0 < gamma theta - beta := sub_pos.mpr hbeta_lt
  have hgamma_pos : 0 < gamma theta := hbeta_pos.trans hbeta_lt
  let T : Real := max ((Real.log C + 3 * Real.log 2) /
      (gamma theta - beta)) ((2 * Real.log 2) / gamma theta)
  have hBlarge : ∀ᶠ n : Nat in atTop, T < B n :=
    hB.eventually_gt_atTop T
  have hstart : ∀ᶠ n : Nat in atTop, node 0 < A n :=
    hA.eventually_gt_atTop (node 0)
  have hlength : ∀ᶠ n : Nat in atTop, -Real.log theta < (n : Real) :=
    tendsto_natCast_atTop_atTop.eventually_gt_atTop (-Real.log theta)
  have hgood : ∀ᶠ n : Nat in atTop,
      T < B n ∧ node 0 < A n ∧ -Real.log theta < (n : Real) := by
    filter_upwards [hBlarge, hstart, hlength] with n hnB hnstart hnlength
    exact ⟨hnB, hnstart, hnlength⟩
  rcases hgood.exists with ⟨n, hnB, hnstart, hnlength⟩
  have hmain_threshold :
      (Real.log C + 3 * Real.log 2) / (gamma theta - beta) < B n := by
    exact lt_of_le_of_lt (le_max_left _ _) hnB
  have hstrict_threshold :
      (2 * Real.log 2) / gamma theta < B n := by
    exact lt_of_le_of_lt (le_max_right _ _) hnB
  have hgapB : Real.log C + 3 * Real.log 2 <
      B n * (gamma theta - beta) :=
    (div_lt_iff₀ hgap).mp hmain_threshold
  have hcardB : 2 * Real.log 2 < B n * gamma theta :=
    (div_lt_iff₀ hgamma_pos).mp hstrict_threshold
  have hgrowth : Real.log C + beta * B n <
      B n * gamma theta - 3 * Real.log 2 := by
    nlinarith [hgapB]
  have htau : 0 < -Real.log theta :=
    neg_pos.mpr (Real.log_neg htheta.1 htheta.2)
  have hlen : -Real.log theta < ((n + 1 : Nat) : Real) :=
    lt_of_lt_of_le hnlength (by norm_num)
  have hxi : rutarXi gamma (-Real.log theta) =
      (1 - theta) * gamma theta := by
    unfold rutarXi
    have hneg : -(-Real.log theta) = Real.log theta := by ring
    rw [hneg, Real.exp_log htheta.1]
  let p : Nat := rutarExactHitIndex (rutarConcatenation_isRutarGOn hgamma)
    offset node hnode_pos hhit (A n)
  let q : Nat := rutarExactHitIndex (rutarConcatenation_isRutarGOn hgamma)
    offset node hnode_pos hhit (A n - Real.log theta)
  have hbase_raw := rutarExactHit_logCard_lower_of_chord
    (rutarConcatenation_isRutarGOn hgamma) offset node hnode_pos hhit
    (x := A n) (tau := -Real.log theta) hnstart htau.le
  rw [rutarConcatenation_active_chord n htau hlen, hxi] at hbase_raw
  have hbase : B n * gamma theta - 2 * Real.log 2 ≤
      ((q - p : Nat) : Real) * Real.log 2 := by
    convert hbase_raw using 1 <;> dsimp [A, B, p, q] <;> ring
  have hqmp : 0 < ((q - p : Nat) : Real) * Real.log 2 := by
    exact (sub_pos.mpr hcardB).trans_le hbase
  have hqsubcast : 0 < ((q - p : Nat) : Real) :=
    pos_of_mul_pos_left hqmp (Real.log_pos (by norm_num)).le
  have hqsub : 0 < q - p := Nat.cast_pos.mp hqsubcast
  have hpq : p < q := Nat.sub_pos_iff_lt.mp hqsub
  have hstrict : rutarExactHitIndex (rutarConcatenation_isRutarGOn hgamma)
      offset node hnode_pos hhit (A n) <
      rutarExactHitIndex (rutarConcatenation_isRutarGOn hgamma)
        offset node hnode_pos hhit (A n - Real.log theta) := by
    simpa [p, q] using hpq
  have hlower_raw := rutarConcatenation_exactHit_lower_logCard_at_theta
    hgamma offset node hnode_pos hhit htheta n hnstart hlen hstrict
  have hlower : B n * gamma theta - 3 * Real.log 2 ≤
      ((q - 1 - p : Nat) : Real) * Real.log 2 := by
    convert hlower_raw using 1; dsimp [A, B, p, q]; ring
  have hlog : Real.log C + beta * B n <
      ((q - 1 - p : Nat) : Real) * Real.log 2 :=
    hgrowth.trans_le hlower
  let delta : NNReal := ⟨Real.exp (-Real.exp (A n - Real.log theta)),
    (Real.exp_pos _).le⟩
  let R : Real := Real.exp (-Real.exp (A n))
  have hdelta_pos : 0 < delta := by
    change 0 < Real.exp (-Real.exp (A n - Real.log theta))
    exact Real.exp_pos _
  have hdelta_one : delta < 1 := by
    apply NNReal.coe_lt_coe.2
    change Real.exp (-Real.exp (A n - Real.log theta)) < 1
    exact Real.exp_lt_one_iff.mpr (neg_lt_zero.mpr (Real.exp_pos _))
  have hRpow : (delta : Real) ^ theta = R := by
    dsimp [delta, R]
    exact rutarPhysicalScale_rpow_at_theta htheta.1
  have hdelta_coe : (delta : Real) =
      Real.exp (-Real.exp (A n - Real.log theta)) := rfl
  have htarget : ENNReal.ofReal
      (C * ((((delta : Real) ^ theta) / (delta : Real)) ^ beta)) <
      ((2 ^ (q - 1 - p) : Nat) : ENNReal) := by
    rw [hRpow, hdelta_coe]
    exact rutarPhysicalScale_power_lt_two_pow_of_log_lt
      (x := A n) (m := q - 1 - p) hC htheta.1 (by simpa [A, B] using hlog)
  have hwitness_raw := rutarExactHit_lower_entropy_witness
    (rutarConcatenation_isRutarGOn hgamma) offset node hnode_pos hhit
    (x := A n) (tau := -Real.log theta) hnstart htau.le hstrict
  have hwitness : ((2 ^ (q - 1 - p) : Nat) : ENNReal) ≤
      brrsEntropyNumber (D.limitSet 0 L ∩ brrsInterval 0 R) delta := by
    simpa [D, L, delta, R, p, q, sub_eq_add_neg] using hwitness_raw
  refine ⟨delta, hdelta_pos, hdelta_one, 0, ?_⟩
  calc
    ENNReal.ofReal
        (C * ((((delta : Real) ^ theta) / (delta : Real)) ^ beta)) <
        ((2 ^ (q - 1 - p) : Nat) : ENNReal) := htarget
    _ ≤ brrsEntropyNumber
        (D.limitSet 0 L ∩ brrsInterval 0 ((delta : Real) ^ theta)) delta := by
      rw [hRpow]
      exact hwitness

/-- A non-admissible exponent lies below the literal equality-scale BRRS
spectrum. -/
theorem le_brrsAssouadSpectrum_of_not_has
    (E : Set Real) {theta beta : Real} (htheta : theta ≤ 1)
    (hnot : ¬ HasBRRSAssouadSpectrumExponent E theta beta) :
    beta ≤ brrsAssouadSpectrum E theta := by
  by_contra hlt
  exact hnot (hasBRRSAssouadSpectrumExponent_of_brrsAssouadSpectrum_lt E htheta
    (lt_of_not_ge hlt))

/-- Equivalently, Rutar-admissible spectra satisfy both exact-scale
reparameterization inequalities on every ordered pair of open parameters. -/
theorem IsRutarAssouadSpectrum.two_sided_scale_bounds
    {gamma : Real → Real} (hgamma : IsRutarAssouadSpectrum gamma)
    {theta eta : Real} (htheta : theta ∈ Ioo (0 : Real) 1)
    (heta : eta ∈ Ioo (0 : Real) 1) (htheta_eta : theta ≤ eta) :
    gamma eta ≤ gamma theta * ((1 - theta) / (1 - eta)) ∧
      gamma theta ≤
        ((1 - eta) * gamma eta + (eta - theta)) / (1 - theta) := by
  have hbounds := hgamma.weighted_parameter_bounds htheta heta htheta_eta
  constructor
  · rw [← mul_div_assoc]
    apply (le_div_iff₀ (sub_pos.mpr heta.2)).2
    simpa [mul_comm] using hbounds.1
  · apply (le_div_iff₀ (sub_pos.mpr htheta.2)).2
    simpa [mul_comm] using hbounds.2

/-- The weighted Rutar spectrum is one-Lipschitz on the open parameter
interval.  This is the continuity input available before any Moran
realization is constructed. -/
theorem IsRutarAssouadSpectrum.weighted_lipschitzOn
    {gamma : Real → Real} (hgamma : IsRutarAssouadSpectrum gamma) :
    LipschitzOnWith 1 (fun theta : Real => (1 - theta) * gamma theta)
      (Ioo (0 : Real) 1) := by
  refine LipschitzOnWith.of_dist_le_mul fun x hx y hy => ?_
  have hforward : ∀ {u v : Real}, u ≤ v → u ∈ Ioo (0 : Real) 1 →
      v ∈ Ioo (0 : Real) 1 →
      dist ((1 - u) * gamma u) ((1 - v) * gamma v) ≤ dist u v := by
    intro u v huv hu hv
    have hbounds := hgamma.weighted_parameter_bounds hu hv huv
    rw [Real.dist_eq, Real.dist_eq]
    rw [abs_of_nonneg (sub_nonneg.mpr hbounds.1),
      abs_of_nonpos (sub_nonpos.mpr huv)]
    linarith [hbounds.2]
  rcases le_total x y with hxy | hyx
  · simpa only [NNReal.coe_one, one_mul] using hforward hxy hx hy
  · simpa only [NNReal.coe_one, one_mul, dist_comm] using hforward hyx hy hx

/-- In particular, the weighted Rutar spectrum is continuous wherever the
open-interval realization theorem applies. -/
theorem IsRutarAssouadSpectrum.weighted_continuousOn
    {gamma : Real → Real} (hgamma : IsRutarAssouadSpectrum gamma) :
    ContinuousOn (fun theta : Real => (1 - theta) * gamma theta)
      (Ioo (0 : Real) 1) :=
  hgamma.weighted_lipschitzOn.continuousOn

/-- The spectrum obtained by restricted convex duality from a BRRS profile
satisfies exactly the monotonicity and range conditions of Rutar's
realization theorem. -/
theorem brrsProfileSpectrumCandidate_isRutarAssouadSpectrum
    {tau : Real → Real} (htau : IsBRRSLegendreAssouadProfile tau) :
    IsRutarAssouadSpectrum (brrsProfileSpectrumCandidate tau) := by
  refine ⟨?_, ?_, ?_⟩
  · intro theta htheta
    exact ⟨brrsProfileSpectrumCandidate_nonneg htau htheta.2,
      brrsProfileSpectrumCandidate_le_one htau htheta.2⟩
  · intro theta htheta eta heta htheta_eta
    exact brrsProfileSpectrumCandidate_mono htau htheta.1.le htheta_eta heta.2
  · intro theta htheta eta heta htheta_eta
    calc
      -(1 - theta) * brrsProfileSpectrumCandidate tau theta =
          brrsProfileConjugate tau theta := by
            unfold brrsProfileSpectrumCandidate
            field_simp [ne_of_gt (sub_pos.mpr htheta.2)]
      _ ≤ brrsProfileConjugate tau eta :=
        brrsProfileConjugate_mono htau htheta_eta heta.2.le
      _ = -(1 - eta) * brrsProfileSpectrumCandidate tau eta := by
        unfold brrsProfileSpectrumCandidate
        field_simp [ne_of_gt (sub_pos.mpr heta.2)]

/-- Rutar's open-interval spectrum realization, together with the
entropy--spectrum equality in BRRS Theorem 1.2(i), proves the realization
direction in Theorem 1.2(ii).  The needed zero endpoint is supplied by
`brrsAssouadSpectrum_zero_eq_brrsProfileSpectrumCandidate_of_open`, not by
Rutar's Corollary B itself.  The two geometric inputs remain explicit so this
theorem does not conceal the outstanding Moran-construction development. -/
theorem brrsTheoremOnePointTwoPartTwoStatement_of_rutar
    (hpartOne : BRRSTheoremOnePointTwoPartOneStatement)
    (hRutar : BRRSRutarCorollaryBStatement) :
    BRRSTheoremOnePointTwoPartTwoStatement := by
  intro tau
  constructor
  · intro htau
    rcases hRutar (brrsProfileSpectrumCandidate tau)
      (brrsProfileSpectrumCandidate_isRutarAssouadSpectrum htau) with
      ⟨E, hE, hbounded, hspectrum⟩
    refine ⟨E, hE, hbounded, ?_⟩
    intro alpha halpha
    exact brrsLegendreAssouadFunction_eq_of_spectrum_realization htau
      (fun a => hpartOne E hE hbounded a) hspectrum halpha
  · rintro ⟨E, hE, hbounded, hrepresentation⟩
    exact isBRRSLegendreAssouadProfile_of_transform_representation
      (fun alpha => hpartOne E hE hbounded alpha) hrepresentation

/-- The formal reduction of the complete BRRS Theorem 1.2 to its two genuine
missing geometric inputs: the entropy--spectrum equality and Rutar's
variable-ratio Moran realization theorem. -/
theorem brrsTheoremOnePointTwoStatement_of_rutar
    (hpartOne : BRRSTheoremOnePointTwoPartOneStatement)
    (hRutar : BRRSRutarCorollaryBStatement) :
    BRRSTheoremOnePointTwoStatement :=
  ⟨hpartOne, brrsTheoremOnePointTwoPartTwoStatement_of_rutar hpartOne hRutar⟩

/-- A reusable equality criterion for the literal BRRS spectrum.  Upper
estimates for every exponent strictly above `gamma`, together with lower
obstructions for every positive exponent strictly below it, determine the
`sInf` definition exactly.  The zero case is included: its lower inequality
comes from the general nonnegativity of the spectrum. -/
theorem brrsAssouadSpectrum_eq_of_upper_lower
    (E : Set Real) {theta gamma : Real} (htheta : theta ≤ 1)
    (hgamma_nonneg : 0 ≤ gamma)
    (hupper : ∀ Gamma : Real, gamma < Gamma →
      HasBRRSAssouadSpectrumExponent E theta Gamma)
    (hlower : ∀ beta : Real, 0 < beta → beta < gamma →
      ¬ HasBRRSAssouadSpectrumExponent E theta beta) :
    brrsAssouadSpectrum E theta = gamma := by
  apply le_antisymm
  · apply le_of_forall_pos_le_add
    intro epsilon hepsilon
    unfold brrsAssouadSpectrum
    apply csInf_le
    · refine ⟨0, ?_⟩
      intro exponent hexponent
      exact hexponent.1.le
    · refine ⟨add_pos_of_nonneg_of_pos hgamma_nonneg hepsilon, ?_⟩
      exact hupper (gamma + epsilon) (by linarith)
  · apply le_of_forall_pos_le_add
    intro epsilon hepsilon
    by_cases hepsilon_gamma : epsilon < gamma
    · have hbeta_pos : 0 < gamma - epsilon := sub_pos.mpr hepsilon_gamma
      have hbeta_lt : gamma - epsilon < gamma := sub_lt_self _ hepsilon
      have hbeta : gamma - epsilon ≤ brrsAssouadSpectrum E theta :=
        le_brrsAssouadSpectrum_of_not_has E htheta
          (hlower (gamma - epsilon) hbeta_pos hbeta_lt)
      linarith
    · have hgamma_epsilon : gamma ≤ epsilon := le_of_not_gt hepsilon_gamma
      have hspectrum_nonneg : 0 ≤ brrsAssouadSpectrum E theta :=
        brrsAssouadSpectrum_nonneg E htheta
      linarith

/-- Rutar's Corollary B for the literal equality-scale BRRS spectrum.  The
nonzero branch is the exact-hit binary Moran construction: eventual chord
upper bounds yield all supercritical covering estimates, while arbitrarily
late active blocks yield the subcritical packing obstructions.  If the
prescribed spectrum vanishes identically, the singleton construction is the
required degenerate realization. -/
theorem hasBRRSSpectrumRealization_of_rutar
    (gamma : Real → Real) (hgamma : IsRutarAssouadSpectrum gamma) :
    HasBRRSSpectrumRealization gamma := by
  by_cases hpositive : ∃ theta : Real,
      theta ∈ Ioo (0 : Real) 1 ∧ 0 < gamma theta
  · let hadmissible : IsRutarAdmissible gamma := hgamma.toIsRutarAdmissible
    have hcontinuous : ContinuousOn (rutarConcatenation gamma) (Ioi (0 : Real)) :=
      rutarConcatenation_continuousOn hadmissible
    have hunbounded : ∀ x M : Real, 0 < x →
        ∃ y : Real, x < y ∧ M ≤ rutarLogMass (rutarConcatenation gamma) y :=
      rutarConcatenation_logMass_unbounded_of_exists_pos hadmissible hpositive
    rcases exists_rutarExactIntegerHitNodes hcontinuous hunbounded with
      ⟨offset, node, hnode_pos, hhit⟩
    let hG : IsRutarGOn (rutarConcatenation gamma) 0 1 :=
      rutarConcatenation_isRutarGOn hadmissible
    let D : BinaryMoranData :=
      rutarMoranDataOfExactHits hG offset node hnode_pos hhit
    let L : Real := Real.exp (-Real.exp (node 0))
    refine ⟨D.limitSet 0 L, ?_, ?_, ?_⟩
    · exact D.limitSet_nonempty 0 L (Real.exp_pos _).le
    · exact D.limitSet_bounded 0 L
    · intro theta htheta_zero htheta_one
      have htheta : theta ∈ Ioo (0 : Real) 1 := ⟨htheta_zero, htheta_one⟩
      apply brrsAssouadSpectrum_eq_of_upper_lower (D.limitSet 0 L) htheta_one.le
      · exact (hgamma.1 theta htheta).1
      · intro Gamma hGamma
        simpa [D, L, hG] using
          (hasBRRSAssouadSpectrumExponent_rutarConcatenationExactHits_at_theta
            hadmissible offset node hnode_pos hhit htheta hGamma)
      · intro beta hbeta_pos hbeta_lt
        simpa [D, L, hG] using
          (rutarExactHit_not_hasBRRSAssouadSpectrumExponent_at_theta
            hadmissible offset node hnode_pos hhit htheta hbeta_pos hbeta_lt)
  · have hzero : ∀ theta : Real, theta ∈ Ioo (0 : Real) 1 → gamma theta = 0 := by
      intro theta htheta
      have hnonneg : 0 ≤ gamma theta := (hgamma.1 theta htheta).1
      have hnonpos : gamma theta ≤ 0 := by
        apply le_of_not_gt
        intro htheta_pos
        exact hpositive ⟨theta, htheta, htheta_pos⟩
      exact le_antisymm hnonpos hnonneg
    rcases hasBRRSSpectrumRealization_zero with ⟨E, hE, hbounded, hrealizes⟩
    refine ⟨E, hE, hbounded, ?_⟩
    intro theta htheta_zero htheta_one
    rw [hrealizes theta htheta_zero htheta_one,
      hzero theta ⟨htheta_zero, htheta_one⟩]

/-- The Rutar spectrum-realization statement needed in the proof of BRRS
Theorem 1.2(ii), now discharged by the exact-hit Moran construction. -/
theorem brrsRutarCorollaryB : BRRSRutarCorollaryBStatement := by
  intro gamma hgamma
  exact hasBRRSSpectrumRealization_of_rutar gamma hgamma

/-- BRRS Theorem 1.2(ii), with both directions unconditional. -/
theorem brrsTheoremOnePointTwoPartTwo :
    BRRSTheoremOnePointTwoPartTwoStatement :=
  brrsTheoremOnePointTwoPartTwoStatement_of_rutar
    brrsTheoremOnePointTwoPartOne brrsRutarCorollaryB

/-- BRRS Theorem 1.2, including the literal entropy/duality identity and the
complete characterization of realizable Legendre--Assouad profiles. -/
theorem brrsTheoremOnePointTwo : BRRSTheoremOnePointTwoStatement :=
  ⟨brrsTheoremOnePointTwoPartOne, brrsTheoremOnePointTwoPartTwo⟩

end

