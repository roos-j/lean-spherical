/-- The compact cone bound for an actual planar endpoint--endpoint
coefficient at two high physical radii. -/
theorem exists_norm_intervalInteg_brrsPlanTwoRadStatCoeff_endpoint_highRad_uniform_le
    (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart)
    (hpartR : partR = .outgoing ∨ partR = .incoming)
    (hpartS : partS = .outgoing ∨ partS = .incoming) :
    ∃ C : Real, 0 < C ∧ ∀ r s freq : Real, 16 ≤ r → 16 ≤ s →
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho *
          oscillatoryExp freq rho‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16) * Real.sqrt (s / 16))) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_uniform_iteratedDeriv_brrsPlanarTwoRadStatCoeff_endpoint_highRad_decay
      0 Phi partR partS hpartR hpartS
  refine ⟨C, hC, ?_⟩
  intro r s freq hr hs
  have hqpos : 0 < Real.sqrt (r / 16) := by
    apply Real.sqrt_pos.2
    linarith
  have hspos : 0 < Real.sqrt (s / 16) := by
    apply Real.sqrt_pos.2
    linarith
  calc
    ‖∫ rho in (1 / 32 : Real)..1,
      brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho *
        oscillatoryExp freq rho‖ ≤
        (C / (Real.sqrt (r / 16) * Real.sqrt (s / 16))) *
          |1 - (1 / 32 : Real)| := by
      apply intervalIntegral.norm_integral_le_of_norm_le_const
      intro rho hrho
      have hrho' : rho ∈ Icc (1 / 32 : Real) 1 := by
        rw [uIoc_of_le (by norm_num : (1 / 32 : Real) ≤ 1)] at hrho
        exact ⟨hrho.1.le, hrho.2⟩
      rw [norm_mul, norm_oscillatoryExp, mul_one]
      exact hbound 0 le_rfl r s rho hr hs hrho'
    _ = (1 - (1 / 32 : Real)) *
        (C / (Real.sqrt (r / 16) * Real.sqrt (s / 16))) := by
      rw [abs_of_nonneg (by norm_num : (0 : Real) ≤ 1 - 1 / 32)]
      ring

end

