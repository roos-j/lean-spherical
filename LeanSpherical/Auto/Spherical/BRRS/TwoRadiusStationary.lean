    exact measurable_brrsRadialLpSourceProfile 1
      (f : BRRSSpace d → Complex) f.continuous.measurable w
  have hF : Measurable F := measurable_brrsI0ThreeCubicProfile q hg M
  have hFp : Measurable (fun x : Real => F x ^ p) :=
    ENNReal.continuous_rpow_const.measurable.comp hF
  have hliteral := hI0 p hp j E T hT f hf v w hv hw
  have hintegral :
      (∫⁻ x : Real, (W * K ^ p) * (c * F x ^ p)) =
        (W * K ^ p * c) * ∫⁻ x : Real, F x ^ p := by
    calc
      (∫⁻ x : Real, (W * K ^ p) * (c * F x ^ p)) =
