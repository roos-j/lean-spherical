            apply lintegral_congr
            intro x
            ring
      _ = (W * K ^ p * c) * ∫⁻ x : Real, F x ^ p := by
            exact lintegral_const_mul (W * K ^ p * c) hFp
  have hprofile' : (∫⁻ x : Real, F x ^ p) ≤ B := by
    simpa only [q, g, M, F] using hprofile
  calc
    (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j),
