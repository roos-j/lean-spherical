noncomputable section

/-- At two high planar radii, the five named components containing a middle
wave are bounded by their five exact compact-frequency phase profiles.  The
two endpoint--middle pieces use the swapped geometry, the two middle--endpoint
pieces retain rapid decay in the first radius, and the middle--middle piece is
kept with its independent rapid decay in both radii. -/
theorem exists_norm_brrsPlanTwoRadMiddleCompIntegSum_highRad_fivePhase_rapidProfile_le
    (N M : Nat) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (s / 16)) ^ (M - 1) *
            Real.sqrt (r / 16))) *
          (brrsStationaryRapidProfile N
              (brrsSurfaceWavePhase .outgoing r +
                brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) +
            brrsStationaryRapidProfile N
              (brrsSurfaceWavePhase .incoming r +
                brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)) +
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (M - 1) *
            Real.sqrt (s / 16))) *
          (brrsStationaryRapidProfile N
              (brrsSurfaceWavePhase .middle r +
                brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) +
            brrsStationaryRapidProfile N
              (brrsSurfaceWavePhase .middle r +
                brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)) +
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (M - 1) *
            (Real.sqrt (s / 16)) ^ (M - 1))) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
  obtain ⟨Cmo, hCmo, hmo⟩ :=
    exists_norm_brrsPlanTwoRadStatCompInteg_middle_endpoint_highRad_rapidProf_le
      N M hM Phi .outgoing (Or.inl rfl)
  obtain ⟨Cmi, hCmi, hmi⟩ :=
    exists_norm_brrsPlanTwoRadStatCompInteg_middle_endpoint_highRad_rapidProf_le
      N M hM Phi .incoming (Or.inr rfl)
  obtain ⟨Cmm, hCmm, hmm⟩ :=
    exists_norm_brrsPlanTwoRadStatCompInteg_middle_middle_highRad_rapidProfile_le
      N M hM Phi
  let C : Real := Cmo + Cmi + Cmm
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  let qr : Real := (Real.sqrt (r / 16)) ^ (M - 1) *
    Real.sqrt (s / 16)
  let qs : Real := (Real.sqrt (s / 16)) ^ (M - 1) *
    Real.sqrt (r / 16)
  let qmm : Real := (Real.sqrt (r / 16)) ^ (M - 1) *
    (Real.sqrt (s / 16)) ^ (M - 1)
  let Ar : Real := (1 - (1 / 32 : Real)) * (C / qr)
  let As : Real := (1 - (1 / 32 : Real)) * (C / qs)
  let Amm : Real := (1 - (1 / 32 : Real)) * (C / qmm)
  have hqr : 0 < qr := by
    dsimp [qr]
    apply mul_pos
    · apply pow_pos
      apply Real.sqrt_pos.2
      linarith
    · apply Real.sqrt_pos.2
      linarith
  have hqs : 0 < qs := by
    dsimp [qs]
    apply mul_pos
    · apply pow_pos
      apply Real.sqrt_pos.2
      linarith
    · apply Real.sqrt_pos.2
      linarith
  have hqmm : 0 < qmm := by
    dsimp [qmm]
    apply mul_pos <;> apply pow_pos <;> apply Real.sqrt_pos.2 <;> linarith
  have hCmo_le : Cmo ≤ C := by
    dsimp [C]
    linarith
  have hCmi_le : Cmi ≤ C := by
    dsimp [C]
    linarith
  have hCmm_le : Cmm ≤ C := by
    dsimp [C]
    linarith
  have hAr_le (D : Real) (hD : D ≤ C) :
      (1 - (1 / 32 : Real)) * (D / qr) ≤ Ar := by
    dsimp [Ar]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hD hqr.le
    · norm_num
  have hAs_le (D : Real) (hD : D ≤ C) :
      (1 - (1 / 32 : Real)) * (D / qs) ≤ As := by
    dsimp [As]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hD hqs.le
    · norm_num
  have hAmm_le (D : Real) (hD : D ≤ C) :
      (1 - (1 / 32 : Real)) * (D / qmm) ≤ Amm := by
    dsimp [Amm]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hD hqmm.le
    · norm_num
  let Pom : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .outgoing r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  let Pim : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .incoming r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  let Pmo : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t)
  let Pmi : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)
  let Pmm : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  let Iom : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .outgoing .middle r s t
  let Iim : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .incoming .middle r s t
  let Imo : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .middle .outgoing r s t
  let Imi : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .middle .incoming r s t
  let Imm : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .middle .middle r s t
  have hphaseom :
      brrsSurfaceWavePhase .middle s + brrsSurfaceWavePhase .outgoing r +
          2 * Real.pi * t =
        brrsSurfaceWavePhase .outgoing r + brrsSurfaceWavePhase .middle s +
          2 * Real.pi * t := by ring
  have hphaseim :
      brrsSurfaceWavePhase .middle s + brrsSurfaceWavePhase .incoming r +
          2 * Real.pi * t =
        brrsSurfaceWavePhase .incoming r + brrsSurfaceWavePhase .middle s +
          2 * Real.pi * t := by ring
  have hPom : 0 ≤ Pom := by
    dsimp [Pom]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPim : 0 ≤ Pim := by
    dsimp [Pim]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPmo : 0 ≤ Pmo := by
    dsimp [Pmo]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPmi : 0 ≤ Pmi := by
    dsimp [Pmi]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPmm : 0 ≤ Pmm := by
    dsimp [Pmm]
    exact brrsStationaryRapidProfile_nonneg N _
  have hIom : ‖Iom‖ ≤ As * Pom := by
    dsimp [Iom, Pom]
    rw [brrsPlanarTwoRadiusStationaryComponentIntegral_swap]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmo / qs) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle s +
              brrsSurfaceWavePhase .outgoing r + 2 * Real.pi * t) := by
        simpa only [qs] using hmo s r t hs hr
      _ = (1 - (1 / 32 : Real)) * (Cmo / qs) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .outgoing r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
        rw [hphaseom]
      _ ≤ As * brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .outgoing r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) :=
        mul_le_mul_of_nonneg_right (hAs_le Cmo hCmo_le) hPom
  have hIim : ‖Iim‖ ≤ As * Pim := by
    dsimp [Iim, Pim]
    rw [brrsPlanarTwoRadiusStationaryComponentIntegral_swap]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmi / qs) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle s +
              brrsSurfaceWavePhase .incoming r + 2 * Real.pi * t) := by
        simpa only [qs] using hmi s r t hs hr
      _ = (1 - (1 / 32 : Real)) * (Cmi / qs) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .incoming r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
        rw [hphaseim]
      _ ≤ As * brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .incoming r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) :=
        mul_le_mul_of_nonneg_right (hAs_le Cmi hCmi_le) hPim
  have hImo : ‖Imo‖ ≤ Ar * Pmo := by
    dsimp [Imo, Pmo]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmo / qr) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) := by
        simpa only [qr] using hmo r s t hr hs
      _ ≤ Ar * brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) :=
        mul_le_mul_of_nonneg_right (hAr_le Cmo hCmo_le) hPmo
  have hImi : ‖Imi‖ ≤ Ar * Pmi := by
    dsimp [Imi, Pmi]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmi / qr) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) := by
        simpa only [qr] using hmi r s t hr hs
      _ ≤ Ar * brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) :=
        mul_le_mul_of_nonneg_right (hAr_le Cmi hCmi_le) hPmi
  have hImm : ‖Imm‖ ≤ Amm * Pmm := by
    dsimp [Imm, Pmm]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmm / qmm) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
        simpa only [qmm] using hmm r s t hr hs
      _ ≤ Amm * brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) :=
        mul_le_mul_of_nonneg_right (hAmm_le Cmm hCmm_le) hPmm
  change ‖(Iom + Iim) + (Imo + Imi + Imm)‖ ≤
    As * (Pom + Pim) + Ar * (Pmo + Pmi) + Amm * Pmm
  calc
    ‖(Iom + Iim) + (Imo + Imi + Imm)‖ ≤
        ‖Iom + Iim‖ + ‖Imo + Imi + Imm‖ := norm_add_le _ _
    _ ≤ (‖Iom‖ + ‖Iim‖) + ((‖Imo‖ + ‖Imi‖) + ‖Imm‖) := by
      apply add_le_add
      · exact norm_add_le _ _
      · calc
          ‖Imo + Imi + Imm‖ ≤ ‖Imo + Imi‖ + ‖Imm‖ := norm_add_le _ _
          _ ≤ (‖Imo‖ + ‖Imi‖) + ‖Imm‖ := by
            exact add_le_add (norm_add_le Imo Imi) le_rfl
    _ ≤ (As * Pom + As * Pim) +
          ((Ar * Pmo + Ar * Pmi) + Amm * Pmm) := by
      apply add_le_add
      · exact add_le_add hIom hIim
      · apply add_le_add
        · exact add_le_add hImo hImi
        · exact hImm
    _ = As * (Pom + Pim) + Ar * (Pmo + Pmi) + Amm * Pmm := by ring

/-- The planar five-term middle remainder is exactly symmetric in its two
radii.  This is the planar counterpart of the all-dimensional symmetry used
to pass from the ordered kernel majorant to the full high--high region. -/
theorem brrsPlanarTwoRadiusMiddleComponentIntegralSum_swap
    (Phi : BRRSAnnularCutoff) (r s t : Real) :
    brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi r s t =
      brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi s r t := by
  unfold brrsPlanarTwoRadiusMiddleComponentIntegralSum
  rw [brrsPlanarTwoRadiusStationaryComponentIntegral_swap Phi .outgoing .middle r s t,
    brrsPlanarTwoRadiusStationaryComponentIntegral_swap Phi .incoming .middle r s t,
    brrsPlanarTwoRadiusStationaryComponentIntegral_swap Phi .middle .outgoing r s t,
    brrsPlanarTwoRadiusStationaryComponentIntegral_swap Phi .middle .incoming r s t,
    brrsPlanarTwoRadiusStationaryComponentIntegral_swap Phi .middle .middle r s t]
  ring

/-- The planar middle-wave contribution satisfies the four endpoint-sign
profile bound in the ordered high--high region.  The middle--middle term has
rapid decay at both radii; one of those factors is used for the phase
transfer and the other is harmlessly bounded by one. -/
theorem exists_norm_brrsPlanTwoRadMiddleCompIntegSum_highRad_fourPhase_prof_le_of_le
    (N : Nat) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s → s ≤ r →
      ‖brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16) * Real.sqrt (s / 16))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
  let M : Nat := 2 + 2 * N
  have hM : 2 ≤ M := by
    dsimp [M]
    omega
  obtain ⟨C₀, hC₀, hfive⟩ :=
    exists_norm_brrsPlanTwoRadMiddleCompIntegSum_highRad_fivePhase_rapidProfile_le
      (2 * N) M hM Phi
  let L : Real := (32 : Real) ^ N *
    ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N)
  let C : Real := 5 * L * C₀
  have hL : 0 < L := by
    dsimp [L]
    positivity
  have hC : 0 < C := by
    dsimp [C]
    positivity
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs hsr
  let R : Real := Real.sqrt (r / 16)
  let S : Real := Real.sqrt (s / 16)
  let B : Real := R * S
  let Dₛ : Real := 1 / S ^ (2 * N)
  let Dᵣ : Real := 1 / R ^ (2 * N)
  let δ : Real := 1 - (1 / 32 : Real)
  let P₁ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s))
  let P₂ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s))
  let P₃ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s))
  let P₄ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))
  let Q₁ : Real := brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - r))
  let Q₂ : Real := brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + r))
  let Q₃ : Real := brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - s))
  let Q₄ : Real := brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + s))
  let Q₅ : Real := brrsStationaryRapidProfile (2 * N) (2 * Real.pi * t)
  have hMsub : M - 1 = 1 + 2 * N := by
    dsimp [M]
    omega
  have hfive' :
      ‖brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi r s t‖ ≤
        δ * (C₀ / (S ^ (M - 1) * R)) * (Q₁ + Q₂) +
          δ * (C₀ / (R ^ (M - 1) * S)) * (Q₃ + Q₄) +
            δ * (C₀ / (R ^ (M - 1) * S ^ (M - 1))) * Q₅ := by
    convert hfive r s t hr hs using 1;
      simp only [R, S, δ, Q₁, Q₂, Q₃, Q₄, Q₅,
        brrsSurfaceWavePhase]; ring
  have hR : 0 < R := by
    dsimp [R]
    apply Real.sqrt_pos.2
    linarith
  have hS : 0 < S := by
    dsimp [S]
    apply Real.sqrt_pos.2
    linarith
  have hB : 0 < B := by
    dsimp [B]
    exact mul_pos hR hS
  have hfactorS :
      δ * (C₀ / (S ^ (M - 1) * R)) =
        (δ * (C₀ / B)) * Dₛ := by
    rw [hMsub]
    dsimp [B, Dₛ, R, S]
    calc
      δ * (C₀ / ((Real.sqrt (s / 16)) ^ (1 + 2 * N) *
          Real.sqrt (r / 16))) =
          δ * (C₀ / (Real.sqrt (r / 16) *
            (Real.sqrt (s / 16)) ^ (1 + 2 * N))) := by ring
      _ = δ * ((C₀ / (Real.sqrt (r / 16) * Real.sqrt (s / 16))) *
            (1 / (Real.sqrt (s / 16)) ^ (2 * N))) := by
          simpa only [pow_one] using
            congrArg (fun z : Real => δ * z)
              (brrs_twoRadius_middle_denominator_factor
                (r := r) (s := s) hr hs 1 N C₀)
      _ = (δ * (C₀ / (Real.sqrt (r / 16) * Real.sqrt (s / 16))) *
            (1 / (Real.sqrt (s / 16)) ^ (2 * N))) := by ring
  have hfactorR :
      δ * (C₀ / (R ^ (M - 1) * S)) =
        (δ * (C₀ / B)) * Dᵣ := by
    rw [hMsub]
    dsimp [B, Dᵣ, R, S]
    calc
      δ * (C₀ / ((Real.sqrt (r / 16)) ^ (1 + 2 * N) *
          Real.sqrt (s / 16))) =
          δ * (C₀ / (Real.sqrt (s / 16) *
            (Real.sqrt (r / 16)) ^ (1 + 2 * N))) := by ring
      _ = δ * ((C₀ / (Real.sqrt (s / 16) * Real.sqrt (r / 16))) *
            (1 / (Real.sqrt (r / 16)) ^ (2 * N))) := by
          simpa only [pow_one] using
            congrArg (fun z : Real => δ * z)
              (brrs_twoRadius_middle_denominator_factor
                (r := s) (s := r) hs hr 1 N C₀)
      _ = (δ * (C₀ / (Real.sqrt (r / 16) * Real.sqrt (s / 16))) *
            (1 / (Real.sqrt (r / 16)) ^ (2 * N))) := by ring
  have hfactorMM :
      δ * (C₀ / (R ^ (M - 1) * S ^ (M - 1))) =
        (δ * (C₀ / B)) * Dᵣ * Dₛ := by
    rw [hMsub]
    dsimp [B, Dᵣ, Dₛ, R, S]
    rw [pow_add, pow_add]
    simp only [pow_one]
    field_simp [hR.ne', hS.ne']
  have hphase :=
    brrs_highRadius_ordered_fiveMiddleProfiles_le_fourEndpointProfiles
      (r := r) (s := s) (t := t) hr hs hsr N
  have hphase' :
      Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄ + Q₅) ≤
        (5 * L) * (P₁ + P₂ + P₃ + P₄) := by
    simpa only [Dₛ, Dᵣ, Q₁, Q₂, Q₃, Q₄, Q₅, L, P₁, P₂, P₃, P₄] using hphase
  have hDₛ_le_one : Dₛ ≤ 1 := by
    simpa only [Dₛ, S] using
      brrs_highRadius_sqrt_inverse_pow_le_one hs N
  have hDᵣ_nonneg : 0 ≤ Dᵣ := by
    dsimp [Dᵣ]
    positivity
  have hQ₅_nonneg : 0 ≤ Q₅ := by
    dsimp [Q₅]
    exact brrsStationaryRapidProfile_nonneg _ _
  have hmm_le : Dᵣ * Dₛ * Q₅ ≤ Dᵣ * Q₅ := by
    calc
      Dᵣ * Dₛ * Q₅ = Dᵣ * (Dₛ * Q₅) := by ring
      _ ≤ Dᵣ * (1 * Q₅) := by
        apply mul_le_mul_of_nonneg_left
        · exact mul_le_mul_of_nonneg_right hDₛ_le_one hQ₅_nonneg
        exact hDᵣ_nonneg
      _ = Dᵣ * Q₅ := by ring
  have hδ : 0 ≤ δ := by
    dsimp [δ]
    norm_num
  have hA : 0 ≤ δ * (C₀ / B) := by
    exact mul_nonneg hδ (div_nonneg hC₀.le hB.le)
  calc
    ‖brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi r s t‖ ≤
        δ * (C₀ / (S ^ (M - 1) * R)) * (Q₁ + Q₂) +
          δ * (C₀ / (R ^ (M - 1) * S)) * (Q₃ + Q₄) +
            δ * (C₀ / (R ^ (M - 1) * S ^ (M - 1))) * Q₅ := hfive'
    _ = (δ * (C₀ / B)) *
          (Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄) + Dᵣ * Dₛ * Q₅) := by
      rw [hfactorS, hfactorR, hfactorMM]
      ring
    _ ≤ (δ * (C₀ / B)) *
          (Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄) + Dᵣ * Q₅) := by
      apply mul_le_mul_of_nonneg_left
      · calc
          Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄) + Dᵣ * Dₛ * Q₅ =
              Dᵣ * Dₛ * Q₅ + (Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄)) := by ring
          _ = (Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄)) + Dᵣ * Dₛ * Q₅ := by ring
          _ ≤ (Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄)) + Dᵣ * Q₅ :=
            add_le_add_right hmm_le _
          _ = Dᵣ * Q₅ + (Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄)) := by ring
          _ = Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄) + Dᵣ * Q₅ := by ring
      · exact hA
    _ = (δ * (C₀ / B)) *
          (Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄ + Q₅)) := by ring
    _ ≤ (δ * (C₀ / B)) * ((5 * L) * (P₁ + P₂ + P₃ + P₄)) := by
      exact mul_le_mul_of_nonneg_left hphase' hA
    _ = (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16) * Real.sqrt (s / 16))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
      dsimp [δ, C, B, R, S, P₁, P₂, P₃, P₄]
      ring

/-- The ordered planar middle-wave estimate extends by exact radial
symmetry to every pair of high radii. -/
theorem exists_norm_brrsPlanarTwoRadMiddleCompIntegralSum_highRad_fourPhase_profile_le
    (N : Nat) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16) * Real.sqrt (s / 16))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
  obtain ⟨C, hC, hordered⟩ :=
    exists_norm_brrsPlanTwoRadMiddleCompIntegSum_highRad_fourPhase_prof_le_of_le
      N Phi
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  by_cases hsr : s ≤ r
  · exact hordered r s t hr hs hsr
  · have hrs : r ≤ s := le_of_not_ge hsr
    rw [brrsPlanarTwoRadiusMiddleComponentIntegralSum_swap Phi r s t]
    have hswapped := hordered s r t hs hr hrs
    have hswapped' :
        ‖brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi s r t‖ ≤
          (1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (s / 16) * Real.sqrt (r / 16))) *
            (brrsStationaryRapidProfile N (2 * Real.pi * (t - s - r)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + s - r)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t - s + r)) +
                  brrsStationaryRapidProfile N (2 * Real.pi * (t + s + r))) := by
      calc
        ‖brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi s r t‖ ≤
            (1 - (1 / 32 : Real)) *
              (C / (Real.sqrt (s / 16) * Real.sqrt (r / 16))) *
              (brrsStationaryRapidProfile N (2 * Real.pi * (t - s - r)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t - s + r)) +
                  brrsStationaryRapidProfile N (2 * Real.pi * (t + s - r)) +
                    brrsStationaryRapidProfile N (2 * Real.pi * (t + s + r))) :=
          hswapped
        _ = (1 - (1 / 32 : Real)) *
              (C / (Real.sqrt (s / 16) * Real.sqrt (r / 16))) *
              (brrsStationaryRapidProfile N (2 * Real.pi * (t - s - r)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + s - r)) +
                  brrsStationaryRapidProfile N (2 * Real.pi * (t - s + r)) +
                    brrsStationaryRapidProfile N (2 * Real.pi * (t + s + r))) := by
          ring
    convert hswapped' using 1; ring

/-- The literal planar all-nine stationary kernel obeys the same high-radius
four-sign majorant as the nonplanar kernel.  Its endpoint and middle pieces
are both exact components of the circle Fourier decomposition. -/
theorem exists_norm_brrsPlanarTwoRadAllStatCompIntegSum_highRad_fourPhase_profile_le
    (N : Nat) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsPlanarTwoRadiusAllStationaryComponentIntegralSum Phi r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16) * Real.sqrt (s / 16))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
  obtain ⟨Cend, hCend, hend⟩ :=
    exists_norm_brrsPlanarTwoRadiusEndpointIntegralSum_highRadius_fourPhase_profile_le
      N Phi
  obtain ⟨Cmid, hCmid, hmid⟩ :=
    exists_norm_brrsPlanarTwoRadMiddleCompIntegralSum_highRad_fourPhase_profile_le
      N Phi
  let C : Real := Cend + Cmid
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  let B : Real := Real.sqrt (r / 16) * Real.sqrt (s / 16)
  let P : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
    brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
      brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
        brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))
  have hsum :
      brrsPlanarTwoRadiusAllStationaryComponentIntegralSum Phi r s t =
        brrsPlanarTwoRadiusEndpointIntegralSum Phi r s t +
          brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi r s t :=
    brrsPlanarTwoRadiusAllStationaryComponentIntegralSum_eq_endpoint_add_middle
      Phi r s t
  rw [hsum]
  calc
    ‖brrsPlanarTwoRadiusEndpointIntegralSum Phi r s t +
        brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi r s t‖ ≤
        ‖brrsPlanarTwoRadiusEndpointIntegralSum Phi r s t‖ +
          ‖brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi r s t‖ := norm_add_le _ _
    _ ≤ (1 - (1 / 32 : Real)) * (Cend / B) * P +
          (1 - (1 / 32 : Real)) * (Cmid / B) * P := by
      dsimp [B, P]
      exact add_le_add (hend r s t hr hs) (hmid r s t hr hs)
    _ = (1 - (1 / 32 : Real)) * (C / B) * P := by
      dsimp [C]
      ring
    _ = (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16) * Real.sqrt (s / 16))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
      rfl

/-- The literal dyadic all-nine circle kernel carries the same four-sign
majorant at high scaled radii. -/
theorem exists_norm_brrsDyPlanarTwoRadAllStatCompIntegSum_highRad_fourPhase_profile_le
    (N : Nat) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r s t : Real,
      16 ≤ ((2 : Real) ^ j) * r → 16 ≤ ((2 : Real) ^ j) * s →
      ‖brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum Phi j r s t‖ ≤
        ‖((2 : Real) ^ j) ^ 2‖ *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt ((((2 : Real) ^ j) * r) / 16) *
              Real.sqrt ((((2 : Real) ^ j) * s) / 16))) *
            (brrsStationaryRapidProfile N
                (2 * Real.pi * (((2 : Real) ^ j * t) -
                  ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
              brrsStationaryRapidProfile N
                (2 * Real.pi * (((2 : Real) ^ j * t) -
                  ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s))) +
                brrsStationaryRapidProfile N
                  (2 * Real.pi * (((2 : Real) ^ j * t) +
                    ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
                  brrsStationaryRapidProfile N
                    (2 * Real.pi * (((2 : Real) ^ j * t) +
                      ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s))))) := by
  obtain ⟨C, hC, hlevel⟩ :=
    exists_norm_brrsPlanarTwoRadAllStatCompIntegSum_highRad_fourPhase_profile_le
      N Phi
  refine ⟨C, hC, ?_⟩
  intro j r s t hr hs
  unfold brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum
  rw [norm_smul]
  exact mul_le_mul_of_nonneg_left
    (hlevel (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
      (((2 : Real) ^ j) * t) hr hs)
    (norm_nonneg _)

/-- The circle case of the literal all-nine kernel has the same normalized
four-sign source profile as BRRS (5.4).  This closes the `d = 2` branch of
the Bessel-kernel reduction without treating the planar middle term as an
error. -/
theorem exists_brrsDyadicHighHigh_allPlanarStationary_radial_fourPhase_block_le
    (N : Nat) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r s t p : Real,
      ∀ f : BRRSSpace 2 → Complex, ∀ w : BRRSSpace 2,
      0 < p → 16 ≤ ((2 : Real) ^ j) * r → 16 ≤ ((2 : Real) ^ j) * s →
      r ^ (((2 : Real) - 1) / p) *
          (‖brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum Phi j r s t‖ *
            (s ^ (2 - 1) * ‖f (s • w)‖)) ≤
        (1 - (1 / 32 : Real)) * C * 16 ^ ((2 : Real) - 1) *
          ((s / r) ^ sobolevExponent 2 p *
            (brrsRadialLpSourceProfile p f w s).toReal) *
          ((brrsDyadicStationaryPhaseProfile N j (t - r - s)).toReal +
            (brrsDyadicStationaryPhaseProfile N j (t - r + s)).toReal +
              (brrsDyadicStationaryPhaseProfile N j (t + r - s)).toReal +
                (brrsDyadicStationaryPhaseProfile N j (t + r + s)).toReal) := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_brrsDyPlanarTwoRadAllStatCompIntegSum_highRad_fourPhase_profile_le
      N Phi
  refine ⟨C, hC, ?_⟩
  intro j r s t p f w hp hr hs
  have hqpos : 0 < (2 : Real) ^ j := by positivity
  have hrpos : 0 < r := by
    apply pos_of_mul_pos_right
      (lt_of_lt_of_le (by norm_num) hr)
    exact hqpos.le
  have hspos : 0 < s := by
    apply pos_of_mul_pos_right
      (lt_of_lt_of_le (by norm_num) hs)
    exact hqpos.le
  have hdenpos : 0 <
      Real.sqrt ((((2 : Real) ^ j) * r) / 16) *
        Real.sqrt ((((2 : Real) ^ j) * s) / 16) := by
    apply mul_pos
    · apply Real.sqrt_pos.mpr
      exact div_pos (mul_pos hqpos hrpos) (by norm_num)
    · apply Real.sqrt_pos.mpr
      exact div_pos (mul_pos hqpos hspos) (by norm_num)
  have hdenne :
      Real.sqrt ((((2 : Real) ^ j) * r) / 16) *
        Real.sqrt ((((2 : Real) ^ j) * s) / 16) ≠ 0 :=
    ne_of_gt hdenpos
  have hradial : 0 ≤ r ^ (((2 : Real) - 1) / p) :=
    Real.rpow_nonneg hrpos.le _
  have hdensity : 0 ≤ s ^ (2 - 1) * ‖f (s • w)‖ :=
    mul_nonneg (pow_nonneg hspos.le _) (norm_nonneg _)
  have hkernel := hprofile j r s t hr hs
  calc
    r ^ (((2 : Real) - 1) / p) *
        (‖brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum Phi j r s t‖ *
          (s ^ (2 - 1) * ‖f (s • w)‖)) =
        (r ^ (((2 : Real) - 1) / p) *
          (s ^ (2 - 1) * ‖f (s • w)‖)) *
          ‖brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum Phi j r s t‖ := by ring
    _ ≤ (r ^ (((2 : Real) - 1) / p) *
          (s ^ (2 - 1) * ‖f (s • w)‖)) *
        (‖((2 : Real) ^ j) ^ 2‖ *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt ((((2 : Real) ^ j) * r) / 16) *
              Real.sqrt ((((2 : Real) ^ j) * s) / 16))) *
            (brrsStationaryRapidProfile N
                (2 * Real.pi * (((2 : Real) ^ j * t) -
                  ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
              brrsStationaryRapidProfile N
                (2 * Real.pi * (((2 : Real) ^ j * t) -
                  ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s))) +
                brrsStationaryRapidProfile N
                  (2 * Real.pi * (((2 : Real) ^ j * t) +
                    ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
                  brrsStationaryRapidProfile N
                    (2 * Real.pi * (((2 : Real) ^ j * t) +
                      ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s)))))) := by
      exact mul_le_mul_of_nonneg_left hkernel (mul_nonneg hradial hdensity)
    _ = (1 - (1 / 32 : Real)) * C *
          (r ^ (((2 : Real) - 1) / p) *
            ((‖((2 : Real) ^ j) ^ 2‖ /
              ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (2 - 1) *
                (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (2 - 1))) *
              (s ^ (2 - 1) * ‖f (s • w)‖)) *
            (brrsStationaryRapidProfile N
                (2 * Real.pi * (((2 : Real) ^ j * t) -
                  ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
              brrsStationaryRapidProfile N
                (2 * Real.pi * (((2 : Real) ^ j * t) -
                  ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s))) +
                brrsStationaryRapidProfile N
                  (2 * Real.pi * (((2 : Real) ^ j * t) +
                    ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
                  brrsStationaryRapidProfile N
                    (2 * Real.pi * (((2 : Real) ^ j * t) +
                      ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s))))) := by
      field_simp [hdenne]
      norm_num
      ring
    _ = (1 - (1 / 32 : Real)) * C * 16 ^ ((2 : Real) - 1) *
          ((s / r) ^ sobolevExponent 2 p *
            (brrsRadialLpSourceProfile p f w s).toReal) *
          ((brrsDyadicStationaryPhaseProfile N j (t - r - s)).toReal +
            (brrsDyadicStationaryPhaseProfile N j (t - r + s)).toReal +
              (brrsDyadicStationaryPhaseProfile N j (t + r - s)).toReal +
                (brrsDyadicStationaryPhaseProfile N j (t + r + s)).toReal) := by
      have hfactor :=
        brrsDyadicHighHigh_prefactor_polar_source_fourPhase_eq
          (d := 2) (j := j) (N := N) (t := t)
          (by norm_num) hp.ne' hrpos hspos f w
      norm_num at hfactor ⊢
      rw [hfactor]
      ring

/-! ### Outer integration of the compact all-nine model

The exact stationary identities above are identities of Bochner integrals.
For the initial output cell, the following lemmas turn the unconditional
all-nine kernel bound into a genuine outer radial majorant.  In particular,
the profile-weighted source integral is integrable on Schwartz data, so the
triangle inequality is not relying on a formal zero value of a non-integrable
integral. -/

/-- A stationary rapid profile is bounded by one, independently of the
number of integrations by parts used to define it. -/
theorem brrsStationaryRapidProfile_le_one (N : Nat) (u : Real) :
    brrsStationaryRapidProfile N u ≤ 1 := by
  by_cases hu : u = 0
  · simp [brrsStationaryRapidProfile, hu]
  · rw [brrsStationaryRapidProfile, if_neg hu]
    exact min_le_left _ _

/-- Away from the carrier zero, the stationary rapid profile is bounded by
the literal integration-by-parts power that defines it. -/
theorem brrsStationaryRapidProfile_le_inversePow {N : Nat} {u : Real}
    (hu : u ≠ 0) :
    brrsStationaryRapidProfile N u ≤ (1 / |u|) ^ N := by
  rw [brrsStationaryRapidProfile, if_neg hu]
  exact min_le_right _ _

/-- On the high-radius side of the cone (`|x| ≥ t / 2`), the three literal
stationary profiles are bounded by one and the stationary half-density alone
gives the sharp wave-size majorant. -/
theorem exists_norm_brrsDyadicHalfWaveKernel_levelZero_highRadius_nearTime_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ t : Real, ∀ x : Euclidean d,
      32 ≤ t → 16 ≤ ‖x‖ → t / 2 ≤ ‖x‖ →
      ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x‖ ≤
        3 * ((1 - (1 / 32 : Real)) * C) /
          (Real.sqrt (t / 32)) ^ (d - 1) := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_brrsDyadicHalfWaveKernel_levelZero_highRadius_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro t x ht hx hnear
  have htpos : 0 < t := by linarith
  have hratio : t / 32 ≤ ‖x‖ / 16 := by linarith
  have hsqrt : Real.sqrt (t / 32) ≤ Real.sqrt (‖x‖ / 16) :=
    Real.sqrt_le_sqrt hratio
  have hden : (Real.sqrt (t / 32)) ^ (d - 1) ≤
      (Real.sqrt (‖x‖ / 16)) ^ (d - 1) :=
    pow_le_pow_left₀ (Real.sqrt_nonneg _) hsqrt _
  have hdenpos : 0 < (Real.sqrt (t / 32)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hdiv : C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1) ≤
      C / (Real.sqrt (t / 32)) ^ (d - 1) :=
    div_le_div_of_nonneg_left hC.le hdenpos hden
  have hsum :
      brrsStationaryRapidProfile N (2 * Real.pi * (t - ‖x‖)) +
        brrsStationaryRapidProfile N (2 * Real.pi * (t + ‖x‖)) +
          brrsStationaryRapidProfile N (2 * Real.pi * t) ≤ 3 := by
    have h₁ := brrsStationaryRapidProfile_le_one N (2 * Real.pi * (t - ‖x‖))
    have h₂ := brrsStationaryRapidProfile_le_one N (2 * Real.pi * (t + ‖x‖))
    have h₃ := brrsStationaryRapidProfile_le_one N (2 * Real.pi * t)
    linarith
  have hkernel := hprofile t x hx
  calc
    ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1)) *
            (brrsStationaryRapidProfile N (2 * Real.pi * (t - ‖x‖)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + ‖x‖)) +
                brrsStationaryRapidProfile N (2 * Real.pi * t)) := hkernel
    _ ≤ (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1)) * 3 := by
      apply mul_le_mul_of_nonneg_left hsum
      positivity
    _ ≤ (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (t / 32)) ^ (d - 1)) * 3 := by
      apply mul_le_mul_of_nonneg_right
      · apply mul_le_mul_of_nonneg_left hdiv
        norm_num
      · norm_num
    _ = 3 * ((1 - (1 / 32 : Real)) * C) /
          (Real.sqrt (t / 32)) ^ (d - 1) := by
      field_simp [hdenpos.ne']

/-- Well inside the high-radius light cone (`|x| < t / 2`), every stationary
carrier is nonzero at scale at least `t`.  Repeated integration by parts then
gives arbitrary rapid time decay even though the spatial radius itself may be
large. -/
theorem exists_norm_brrsDyadicHalfWaveKernel_levelZero_highRadius_insideTime_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ t : Real, ∀ x : Euclidean d,
      32 ≤ t → 16 ≤ ‖x‖ → ‖x‖ < t / 2 →
      ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x‖ ≤
        3 * ((1 - (1 / 32 : Real)) * C) * (1 / t) ^ N := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_brrsDyadicHalfWaveKernel_levelZero_highRadius_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro t x ht hx hinside
  have htpos : 0 < t := by linarith
  have hx0 : 0 ≤ ‖x‖ := norm_nonneg _
  have hsubpos : 0 ≤ t - ‖x‖ := by linarith
  have hphaseout :
      2 * Real.pi * (t - ‖x‖) =
        2 * Real.pi * (t - ‖x‖) := rfl
  have htwole : (2 : Real) ≤ 2 * Real.pi := by
    nlinarith [Real.pi_gt_three]
  have houtbase : t ≤ 2 * Real.pi * (t - ‖x‖) := by
    have hhalf : t ≤ 2 * (t - ‖x‖) := by linarith
    calc
      t ≤ 2 * (t - ‖x‖) := hhalf
      _ ≤ (2 * Real.pi) * (t - ‖x‖) :=
        mul_le_mul_of_nonneg_right htwole hsubpos
      _ = 2 * Real.pi * (t - ‖x‖) := by ring
  have hinbase : t ≤ 2 * Real.pi * (t + ‖x‖) := by
    have hsumpos : 0 ≤ t + ‖x‖ := by linarith
    calc
      t ≤ t + ‖x‖ := by linarith
      _ ≤ (2 * Real.pi) * (t + ‖x‖) :=
        le_mul_of_one_le_left hsumpos (by linarith [htwole])
      _ = 2 * Real.pi * (t + ‖x‖) := by ring
  have hmidbase : t ≤ 2 * Real.pi * t :=
    le_mul_of_one_le_left htpos.le (by linarith [htwole])
  have houtdom : t ≤ |2 * Real.pi * (t - ‖x‖)| := by
    rw [abs_of_nonneg (by positivity)]
    exact houtbase
  have hindom : t ≤ |2 * Real.pi * (t + ‖x‖)| := by
    rw [abs_of_nonneg (by positivity)]
    exact hinbase
  have hmiddom : t ≤ |2 * Real.pi * t| := by
    rw [abs_of_nonneg (by positivity)]
    exact hmidbase
  have houtne : 2 * Real.pi * (t - ‖x‖) ≠ 0 := by
    intro hzero
    rw [hzero] at houtdom
    linarith
  have hinne : 2 * Real.pi * (t + ‖x‖) ≠ 0 := by
    intro hzero
    rw [hzero] at hindom
    linarith
  have hmidne : 2 * Real.pi * t ≠ 0 := by
    intro hzero
    rw [hzero] at hmiddom
    linarith
  have houtpow : brrsStationaryRapidProfile N (2 * Real.pi * (t - ‖x‖)) ≤
      (1 / t) ^ N := by
    calc
      brrsStationaryRapidProfile N (2 * Real.pi * (t - ‖x‖)) ≤
          (1 / |2 * Real.pi * (t - ‖x‖)|) ^ N :=
        brrsStationaryRapidProfile_le_inversePow houtne
      _ ≤ (1 / t) ^ N :=
        pow_le_pow_left₀ (by positivity)
          (one_div_le_one_div_of_le htpos houtdom) _
  have hinpow : brrsStationaryRapidProfile N (2 * Real.pi * (t + ‖x‖)) ≤
      (1 / t) ^ N := by
    calc
      brrsStationaryRapidProfile N (2 * Real.pi * (t + ‖x‖)) ≤
          (1 / |2 * Real.pi * (t + ‖x‖)|) ^ N :=
        brrsStationaryRapidProfile_le_inversePow hinne
      _ ≤ (1 / t) ^ N :=
        pow_le_pow_left₀ (by positivity)
          (one_div_le_one_div_of_le htpos hindom) _
  have hmidpow : brrsStationaryRapidProfile N (2 * Real.pi * t) ≤
      (1 / t) ^ N := by
    calc
      brrsStationaryRapidProfile N (2 * Real.pi * t) ≤
          (1 / |2 * Real.pi * t|) ^ N :=
        brrsStationaryRapidProfile_le_inversePow hmidne
      _ ≤ (1 / t) ^ N :=
        pow_le_pow_left₀ (by positivity)
          (one_div_le_one_div_of_le htpos hmiddom) _
  have hsqrtone : 1 ≤ Real.sqrt (‖x‖ / 16) := by
    rw [← Real.sqrt_one]
    apply Real.sqrt_le_sqrt
    linarith
  have hdenone : 1 ≤ (Real.sqrt (‖x‖ / 16)) ^ (d - 1) :=
    one_le_pow₀ hsqrtone
  have hdenpos : 0 < (Real.sqrt (‖x‖ / 16)) ^ (d - 1) :=
    lt_of_lt_of_le zero_lt_one hdenone
  have hdiv : C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1) ≤ C := by
    apply (div_le_iff₀ hdenpos).mpr
    exact le_mul_of_one_le_right hC.le hdenone
  have hsum :
      brrsStationaryRapidProfile N (2 * Real.pi * (t - ‖x‖)) +
        brrsStationaryRapidProfile N (2 * Real.pi * (t + ‖x‖)) +
          brrsStationaryRapidProfile N (2 * Real.pi * t) ≤
        (1 / t) ^ N + (1 / t) ^ N + (1 / t) ^ N := by
    linarith
  have hkernel := hprofile t x hx
  calc
    ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1)) *
            (brrsStationaryRapidProfile N (2 * Real.pi * (t - ‖x‖)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + ‖x‖)) +
                brrsStationaryRapidProfile N (2 * Real.pi * t)) := hkernel
    _ ≤ (1 - (1 / 32 : Real)) * C *
        ((1 / t) ^ N + (1 / t) ^ N + (1 / t) ^ N) := by
      apply mul_le_mul
      · apply mul_le_mul_of_nonneg_left hdiv
        norm_num
      · exact hsum
      · exact add_nonneg
          (add_nonneg (brrsStationaryRapidProfile_nonneg N _)
            (brrsStationaryRapidProfile_nonneg N _))
          (brrsStationaryRapidProfile_nonneg N _)
      · positivity
    _ = 3 * ((1 - (1 / 32 : Real)) * C) * (1 / t) ^ N := by
      ring

/-- The two high-radius regimes combine into a completely explicit global
envelope: the first term is the cone-scale half-density and the second is a
rapid nonstationary remainder. -/
theorem exists_norm_brrsDyadicHalfWaveKernel_levelZero_highRadius_largeTime_envelope_le
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ t : Real, ∀ x : Euclidean d,
      32 ≤ t → 16 ≤ ‖x‖ →
      ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x‖ ≤
        3 * ((1 - (1 / 32 : Real)) * C) /
          (Real.sqrt (t / 32)) ^ (d - 1) +
        3 * ((1 - (1 / 32 : Real)) * C) * (1 / t) ^ d := by
  obtain ⟨Cnear, hCnear, hnear⟩ :=
    exists_norm_brrsDyadicHalfWaveKernel_levelZero_highRadius_nearTime_le
      (d := d) (N := d) hd Phi
  obtain ⟨Cinside, hCinside, hinside⟩ :=
    exists_norm_brrsDyadicHalfWaveKernel_levelZero_highRadius_insideTime_le
      (d := d) (N := d) hd Phi
  let C : Real := Cnear + Cinside
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro t x ht hx
  have htpos : 0 < t := by linarith
  have hdenpos : 0 < (Real.sqrt (t / 32)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hnearle : Cnear ≤ C := by
    dsimp [C]
    linarith
  have hinsidele : Cinside ≤ C := by
    dsimp [C]
    linarith
  by_cases hsplit : t / 2 ≤ ‖x‖
  · have h := hnear t x ht hx hsplit
    calc
      ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x‖ ≤
          3 * ((1 - (1 / 32 : Real)) * Cnear) /
            (Real.sqrt (t / 32)) ^ (d - 1) := h
      _ ≤ 3 * ((1 - (1 / 32 : Real)) * C) /
            (Real.sqrt (t / 32)) ^ (d - 1) := by
        apply div_le_div_of_nonneg_right
        · apply mul_le_mul_of_nonneg_left
          · exact mul_le_mul_of_nonneg_left hnearle (by norm_num)
          · norm_num
        · exact hdenpos.le
      _ ≤ 3 * ((1 - (1 / 32 : Real)) * C) /
            (Real.sqrt (t / 32)) ^ (d - 1) +
          3 * ((1 - (1 / 32 : Real)) * C) * (1 / t) ^ d :=
        le_add_of_nonneg_right (by positivity)
  · have hlt : ‖x‖ < t / 2 := lt_of_not_ge hsplit
    have h := hinside t x ht hx hlt
    calc
      ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x‖ ≤
          3 * ((1 - (1 / 32 : Real)) * Cinside) * (1 / t) ^ d := h
      _ ≤ 3 * ((1 - (1 / 32 : Real)) * C) * (1 / t) ^ d := by
        apply mul_le_mul_of_nonneg_right
        · apply mul_le_mul_of_nonneg_left
          · exact mul_le_mul_of_nonneg_left hinsidele (by norm_num)
          · norm_num
        · positivity
      _ ≤ 3 * ((1 - (1 / 32 : Real)) * C) /
            (Real.sqrt (t / 32)) ^ (d - 1) +
          3 * ((1 - (1 / 32 : Real)) * C) * (1 / t) ^ d :=
        le_add_of_nonneg_left (by positivity)

/-- Global pointwise envelope for the literal BRRS adjoint test packet at
all sufficiently high dyadic levels.  Its first term is exactly the
stationary cone scale `q^d / sqrt(q)^(d-1)`, while its second term is a
rapidly decaying nonstationary remainder.  Thus it is the direct formal
precursor of the `q^((d+1)/2)` input `L∞` bound in BRRS (3.2). -/
theorem exists_norm_brrsPositiveRadialHalfWaveTestPacket_globalEnvelope_le
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ referenceTime : Real, ∀ x : Euclidean d,
      5 ≤ j → referenceTime ∈ Icc (1 : Real) 2 →
      ‖brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime x‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ *
          (3 * ((1 - (1 / 32 : Real)) * C) /
            (Real.sqrt ((((2 : Real) ^ j) * referenceTime) / 32)) ^ (d - 1) +
          3 * ((1 - (1 / 32 : Real)) * C) *
            (1 / (((2 : Real) ^ j) * referenceTime)) ^ d) := by
  obtain ⟨Chigh, hChigh, hhigh⟩ :=
    exists_norm_brrsDyadicHalfWaveKernel_levelZero_highRadius_largeTime_envelope_le
      (d := d) hd Phi
  obtain ⟨Clow, hClow, hlow⟩ :=
    exists_norm_brrsPositiveRadialHalfWaveTestPacket_lowScaledRadius_le
      (d := d) (N := d) hd Phi
  let C : Real := Chigh + Clow
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro j referenceTime x hj href
  let q : Real := (2 : Real) ^ j
  have hqpos : 0 < q := by
    dsimp only [q]
    positivity
  have hqge : 32 ≤ q := by
    dsimp only [q]
    calc
      (32 : Real) = 2 ^ 5 := by norm_num
      _ ≤ 2 ^ j := pow_le_pow_right₀ (by norm_num) hj
  have htime : 32 ≤ q * referenceTime := by
    calc
      (32 : Real) = 32 * 1 := by ring
      _ ≤ q * referenceTime := mul_le_mul hqge href.1 (by norm_num) hqpos.le
  have hChighle : Chigh ≤ C := by
    dsimp [C]
    linarith
  have hClowle : Clow ≤ C := by
    dsimp [C]
    linarith
  by_cases hsmall : q * ‖x‖ ≤ 16
  · have h := hlow j referenceTime x hj href (by simpa only [q] using hsmall)
    have hrem :
        3 * ((1 - (1 / 32 : Real)) * Clow) *
            (1 / (q * referenceTime)) ^ d ≤
          3 * ((1 - (1 / 32 : Real)) * C) *
            (1 / (q * referenceTime)) ^ d := by
      apply mul_le_mul_of_nonneg_right
      · apply mul_le_mul_of_nonneg_left
        · exact mul_le_mul_of_nonneg_left hClowle (by norm_num)
        · norm_num
      · positivity
    calc
      ‖brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime x‖ ≤
          ‖q ^ d‖ *
            (3 * ((1 - (1 / 32 : Real)) * Clow) *
              (1 / (q * referenceTime)) ^ d) := by
        simpa only [q] using h
      _ ≤ ‖q ^ d‖ *
          (3 * ((1 - (1 / 32 : Real)) * C) *
            (1 / (q * referenceTime)) ^ d) :=
        mul_le_mul_of_nonneg_left hrem (norm_nonneg _)
      _ ≤ ‖q ^ d‖ *
          (3 * ((1 - (1 / 32 : Real)) * C) /
            (Real.sqrt ((q * referenceTime) / 32)) ^ (d - 1) +
          3 * ((1 - (1 / 32 : Real)) * C) *
            (1 / (q * referenceTime)) ^ d) :=
        mul_le_mul_of_nonneg_left (le_add_of_nonneg_left (by positivity))
          (norm_nonneg _)
      _ = ‖((2 : Real) ^ j) ^ d‖ *
          (3 * ((1 - (1 / 32 : Real)) * C) /
            (Real.sqrt ((((2 : Real) ^ j) * referenceTime) / 32)) ^ (d - 1) +
          3 * ((1 - (1 / 32 : Real)) * C) *
            (1 / (((2 : Real) ^ j) * referenceTime)) ^ d) := by
        rfl
  · have hlarge : 16 ≤ q * ‖x‖ := le_of_not_ge hsmall
    have hscaledRadius : 16 ≤ ‖q • (-x)‖ := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hqpos, norm_neg]
      exact hlarge
    have hkernel := hhigh (q * referenceTime) (q • (-x)) htime hscaledRadius
    have hinner :
        3 * ((1 - (1 / 32 : Real)) * Chigh) /
            (Real.sqrt ((q * referenceTime) / 32)) ^ (d - 1) +
          3 * ((1 - (1 / 32 : Real)) * Chigh) *
            (1 / (q * referenceTime)) ^ d ≤
          3 * ((1 - (1 / 32 : Real)) * C) /
            (Real.sqrt ((q * referenceTime) / 32)) ^ (d - 1) +
          3 * ((1 - (1 / 32 : Real)) * C) *
            (1 / (q * referenceTime)) ^ d := by
      gcongr
    rw [brrsPositiveRadialHalfWaveTestPacket_eq_star_neg_halfWaveKernel]
    change ‖star ((brrsDyadicHalfWaveKernel Phi j referenceTime : Euclidean d → Complex)
      (-x))‖ ≤ _
    rw [norm_star, brrsDyadicHalfWaveKernel_eq_levelZero_scaled_general,
      norm_smul]
    calc
      ‖q ^ d‖ *
          ‖(brrsDyadicHalfWaveKernel Phi 0 (q * referenceTime) :
            Euclidean d → Complex) (q • (-x))‖ ≤
          ‖q ^ d‖ *
            (3 * ((1 - (1 / 32 : Real)) * Chigh) /
              (Real.sqrt ((q * referenceTime) / 32)) ^ (d - 1) +
            3 * ((1 - (1 / 32 : Real)) * Chigh) *
              (1 / (q * referenceTime)) ^ d) :=
        mul_le_mul_of_nonneg_left hkernel (norm_nonneg _)
      _ ≤ ‖q ^ d‖ *
          (3 * ((1 - (1 / 32 : Real)) * C) /
            (Real.sqrt ((q * referenceTime) / 32)) ^ (d - 1) +
          3 * ((1 - (1 / 32 : Real)) * C) *
            (1 / (q * referenceTime)) ^ d) :=
        mul_le_mul_of_nonneg_left hinner (norm_nonneg _)
      _ = ‖((2 : Real) ^ j) ^ d‖ *
          (3 * ((1 - (1 / 32 : Real)) * C) /
            (Real.sqrt ((((2 : Real) ^ j) * referenceTime) / 32)) ^ (d - 1) +
          3 * ((1 - (1 / 32 : Real)) * C) *
            (1 / (((2 : Real) ^ j) * referenceTime)) ^ d) := by
        rfl

/-- The global packet envelope has the single stationary half-density scale.
Written using natural powers, `q^d / sqrt (q / 32)^(d-1)` is precisely a
dimension-dependent constant times `q^((d+1)/2)`.  This is the pointwise
`L∞` normalization required for the BRRS input packet. -/
theorem exists_norm_brrsPositiveRadialHalfWaveTestPacket_halfDensityScale_le
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ referenceTime : Real, ∀ x : Euclidean d,
      5 ≤ j → referenceTime ∈ Icc (1 : Real) 2 →
      ‖brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime x‖ ≤
        6 * ((1 - (1 / 32 : Real)) * C) * ‖((2 : Real) ^ j) ^ d‖ /
          (Real.sqrt (((2 : Real) ^ j / 32)) ^ (d - 1)) := by
  obtain ⟨C, hC, henvelope⟩ :=
    exists_norm_brrsPositiveRadialHalfWaveTestPacket_globalEnvelope_le hd Phi
  refine ⟨C, hC, ?_⟩
  intro j referenceTime x hj href
  let q : Real := (2 : Real) ^ j
  let s : Real := q * referenceTime
  let r : Real := Real.sqrt (q / 32)
  have hqpos : 0 < q := by
    dsimp only [q]
    positivity
  have hqge : 32 ≤ q := by
    dsimp only [q]
    calc
      (32 : Real) = 2 ^ 5 := by norm_num
      _ ≤ 2 ^ j := pow_le_pow_right₀ (by norm_num) hj
  have hsgeq : q ≤ s := by
    dsimp [s]
    exact le_mul_of_one_le_right hqpos.le href.1
  have hspos : 0 < s := lt_of_lt_of_le hqpos hsgeq
  have hq32one : 1 ≤ q / 32 := by linarith
  have hrleq : r ≤ q := by
    dsimp [r]
    calc
      Real.sqrt (q / 32) ≤ q / 32 :=
        Real.sqrt_le_self_iff.mpr (Or.inr hq32one)
      _ ≤ q := by linarith
  have hrles : r ≤ s := hrleq.trans hsgeq
  have hrpos : 0 < r := by
    dsimp [r]
    apply Real.sqrt_pos.2
    linarith
  have hsone : 1 ≤ s := by linarith
  have hpowrs : r ^ (d - 1) ≤ s ^ (d - 1) :=
    pow_le_pow_left₀ hrpos.le hrles _
  have hdpos : 1 ≤ d := by omega
  have hd_eq : d = (d - 1) + 1 := by omega
  have hpowss : s ^ (d - 1) ≤ s ^ d := by
    calc
      s ^ (d - 1) = s ^ (d - 1) * 1 := by ring
      _ ≤ s ^ (d - 1) * s :=
        mul_le_mul_of_nonneg_left hsone (pow_nonneg hspos.le _)
      _ = s ^ d := by
        rw [← pow_succ, ← hd_eq]
  have hpowrsd : r ^ (d - 1) ≤ s ^ d := hpowrs.trans hpowss
  have hrpowpos : 0 < r ^ (d - 1) := pow_pos hrpos _
  have hdenTime : r ^ (d - 1) ≤ (Real.sqrt (s / 32)) ^ (d - 1) := by
    apply pow_le_pow_left₀ (Real.sqrt_nonneg _)
    apply Real.sqrt_le_sqrt
    dsimp [s]
    have : q ≤ q * referenceTime := hsgeq
    linarith
  have hdenTimePos : 0 < (Real.sqrt (s / 32)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    dsimp [s]
    linarith
  have hfirst :
      3 * ((1 - (1 / 32 : Real)) * C) /
          (Real.sqrt (s / 32)) ^ (d - 1) ≤
        3 * ((1 - (1 / 32 : Real)) * C) / r ^ (d - 1) := by
    have hinv : 1 / (Real.sqrt (s / 32)) ^ (d - 1) ≤ 1 / r ^ (d - 1) :=
      one_div_le_one_div_of_le hrpowpos hdenTime
    simpa only [div_eq_mul_inv, one_mul] using
      mul_le_mul_of_nonneg_left hinv (by positivity :
        0 ≤ 3 * ((1 - (1 / 32 : Real)) * C))
  have hsecond :
      3 * ((1 - (1 / 32 : Real)) * C) * (1 / s) ^ d ≤
        3 * ((1 - (1 / 32 : Real)) * C) / r ^ (d - 1) := by
    have hinv : 1 / s ^ d ≤ 1 / r ^ (d - 1) :=
      one_div_le_one_div_of_le hrpowpos hpowrsd
    rw [one_div_pow]
    simpa only [div_eq_mul_inv, one_mul] using
      mul_le_mul_of_nonneg_left hinv (by positivity :
        0 ≤ 3 * ((1 - (1 / 32 : Real)) * C))
  have h := henvelope j referenceTime x hj href
  have hinner :
      3 * ((1 - (1 / 32 : Real)) * C) /
          (Real.sqrt (s / 32)) ^ (d - 1) +
        3 * ((1 - (1 / 32 : Real)) * C) * (1 / s) ^ d ≤
        2 * (3 * ((1 - (1 / 32 : Real)) * C) / r ^ (d - 1)) := by
    calc
      3 * ((1 - (1 / 32 : Real)) * C) /
          (Real.sqrt (s / 32)) ^ (d - 1) +
        3 * ((1 - (1 / 32 : Real)) * C) * (1 / s) ^ d ≤
          3 * ((1 - (1 / 32 : Real)) * C) / r ^ (d - 1) +
            3 * ((1 - (1 / 32 : Real)) * C) / r ^ (d - 1) :=
        add_le_add hfirst hsecond
      _ = 2 * (3 * ((1 - (1 / 32 : Real)) * C) / r ^ (d - 1)) := by ring
  calc
    ‖brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime x‖ ≤
        ‖q ^ d‖ *
          (3 * ((1 - (1 / 32 : Real)) * C) /
            (Real.sqrt ((q * referenceTime) / 32)) ^ (d - 1) +
          3 * ((1 - (1 / 32 : Real)) * C) *
            (1 / (q * referenceTime)) ^ d) := by
      simpa only [q] using h
    _ ≤ ‖q ^ d‖ *
          (2 * (3 * ((1 - (1 / 32 : Real)) * C) / r ^ (d - 1))) :=
      mul_le_mul_of_nonneg_left hinner (norm_nonneg _)
    _ = 6 * ((1 - (1 / 32 : Real)) * C) * ‖q ^ d‖ /
          (Real.sqrt (q / 32)) ^ (d - 1) := by
      dsimp [r]
      field_simp [hrpowpos.ne']
      norm_num
    _ = 6 * ((1 - (1 / 32 : Real)) * C) * ‖((2 : Real) ^ j) ^ d‖ /
          (Real.sqrt (((2 : Real) ^ j / 32)) ^ (d - 1)) := by
      rfl

/-- The sum of the nine literal carrier profiles is uniformly bounded.  This
elementary fact supplies the integrable Schwartz majorant needed before the
outer radial triangle inequality is applied. -/
theorem brrsTwoRadiusNinePhaseProfile_le_nine
    (N : Nat) (r s t : Real) :
    brrsTwoRadiusNinePhaseProfile N r s t ≤ 9 := by
  unfold brrsTwoRadiusNinePhaseProfile
  have hoo := brrsStationaryRapidProfile_le_one N
    (brrsSurfaceWavePhase .outgoing r +
      brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t)
  have hoi := brrsStationaryRapidProfile_le_one N
    (brrsSurfaceWavePhase .outgoing r +
      brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)
  have hom := brrsStationaryRapidProfile_le_one N
    (brrsSurfaceWavePhase .outgoing r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  have hio := brrsStationaryRapidProfile_le_one N
    (brrsSurfaceWavePhase .incoming r +
      brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t)
  have hii := brrsStationaryRapidProfile_le_one N
    (brrsSurfaceWavePhase .incoming r +
      brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)
  have him := brrsStationaryRapidProfile_le_one N
    (brrsSurfaceWavePhase .incoming r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  have hmo := brrsStationaryRapidProfile_le_one N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t)
  have hmi := brrsStationaryRapidProfile_le_one N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)
  have hmm := brrsStationaryRapidProfile_le_one N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  linarith

/-- Measurability of the all-nine profile when the source radius varies
along the positive ray. -/
theorem measurable_brrsTwoRadiusNinePhaseProfile_source
    (N : Nat) (r q t : Real) :
    Measurable (fun s : Ioi (0 : Real) =>
      brrsTwoRadiusNinePhaseProfile N r (q * s.1) t) := by
  have hphase (partR partS : BRRSSurfaceWavePart) :
      Measurable (fun s : Ioi (0 : Real) =>
        brrsSurfaceWavePhase partR r +
          brrsSurfaceWavePhase partS (q * s.1) + 2 * Real.pi * t) := by
    cases partR <;> cases partS <;>
      simp only [brrsSurfaceWavePhase, add_zero, measurable_const, zero_add] <;> fun_prop
  unfold brrsTwoRadiusNinePhaseProfile
  repeat' apply Measurable.add
  all_goals
    exact (measurable_brrsStationaryRapidProfile N).comp (hphase _ _)

/-- The nine-profile source majorant is integrable against the radial trace
of a Schwartz datum.  Its proof uses only the uniform bound by nine and the
already established polar integrability of radial Schwartz functions. -/
theorem integrable_brrsTwoRadiusNinePhaseProfile_mul_radialNorm
    {d : Nat} (hd : 0 < d) (N : Nat) (r q t : Real)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d → Complex))
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    Integrable (fun s : Ioi (0 : Real) =>
      brrsTwoRadiusNinePhaseProfile N r (q * s.1) t * ‖f (s.1 • w)‖)
      (Measure.volumeIoiPow (d - 1)) := by
  have hinput : Integrable (fun s : Ioi (0 : Real) => f (s.1 • w))
      (Measure.volumeIoiPow (d - 1)) :=
    integrable_brrs_radial_profile_volumeIoiPow hd f hf w hw
  have hprofile : Measurable (fun s : Ioi (0 : Real) =>
      brrsTwoRadiusNinePhaseProfile N r (q * s.1) t) :=
    measurable_brrsTwoRadiusNinePhaseProfile_source N r q t
  refine (hinput.norm.const_mul (9 : Real)).mono'
    (hprofile.aestronglyMeasurable.mul hinput.norm.aestronglyMeasurable) ?_
  filter_upwards with s
  rw [Real.norm_eq_abs,
    abs_of_nonneg (mul_nonneg
      (brrsTwoRadiusNinePhaseProfile_nonneg N r (q * s.1) t)
      (norm_nonneg _))]
  exact mul_le_mul_of_nonneg_right
    (brrsTwoRadiusNinePhaseProfile_le_nine N r (q * s.1) t)
    (norm_nonneg _)

/-- On a compact output radius, the literal all-nine outer source integral
is controlled by the two translated cubic source integrals and the one
middle-phase cubic tail.  No kernel hypothesis is added here: this is the
direct phase reduction of the actual all-nine profile. -/
theorem brrs_I0_ninePhase_outerIntegral_le_three_cubic
    {d : Nat} (hd : 3 ≤ d) (q r t : Real)
    (hr0 : 0 ≤ q * r) (hr : q * r ≤ 1)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d → Complex))
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    (∫ s : Ioi (0 : Real),
      brrsTwoRadiusNinePhaseProfile 3 (q * r) (q * s.1) (q * t) *
        ‖f (s.1 • w)‖ ∂Measure.volumeIoiPow (d - 1)) ≤
      192 *
        ((∫ s : Ioi (0 : Real),
          brrsCubicJapaneseRealProfile (q * (t - s.1)) *
            ‖f (s.1 • w)‖ ∂Measure.volumeIoiPow (d - 1)) +
          (∫ s : Ioi (0 : Real),
            brrsCubicJapaneseRealProfile (q * (t + s.1)) *
              ‖f (s.1 • w)‖ ∂Measure.volumeIoiPow (d - 1)) +
            brrsCubicJapaneseRealProfile (q * t) *
              ∫ s : Ioi (0 : Real), ‖f (s.1 • w)‖
                ∂Measure.volumeIoiPow (d - 1)) := by
  let P : Ioi (0 : Real) → Real := fun s =>
    brrsTwoRadiusNinePhaseProfile 3 (q * r) (q * s.1) (q * t)
  let Fminus : Ioi (0 : Real) → Real := fun s =>
    brrsCubicJapaneseRealProfile (q * (t - s.1)) * ‖f (s.1 • w)‖
  let Fplus : Ioi (0 : Real) → Real := fun s =>
    brrsCubicJapaneseRealProfile (q * (t + s.1)) * ‖f (s.1 • w)‖
  let Fmiddle : Ioi (0 : Real) → Real := fun s =>
    brrsCubicJapaneseRealProfile (q * t) * ‖f (s.1 • w)‖
  have hphase (s : Ioi (0 : Real)) :
      P s ≤ 192 * (brrsCubicJapaneseRealProfile (q * (t - s.1)) +
        brrsCubicJapaneseRealProfile (q * (t + s.1)) +
          brrsCubicJapaneseRealProfile (q * t)) := by
    dsimp only [P]
    convert brrsTwoRadiusNinePhaseProfile_I0_le_three_cubic
      (q * r) (q * s.1) (q * t) hr0 hr using 1; ring
  have hinput : Integrable (fun s : Ioi (0 : Real) => f (s.1 • w))
      (Measure.volumeIoiPow (d - 1)) :=
    integrable_brrs_radial_profile_volumeIoiPow (by omega) f hf w hw
  have hminus : Integrable Fminus (Measure.volumeIoiPow (d - 1)) := by
    dsimp only [Fminus]
    exact integrable_brrsCubicJapaneseRealProfile_comp_mul_radialNorm
      (by omega) (fun s : Ioi (0 : Real) => q * (t - s.1)) (by fun_prop)
        f hf w hw
  have hplus : Integrable Fplus (Measure.volumeIoiPow (d - 1)) := by
    dsimp only [Fplus]
    exact integrable_brrsCubicJapaneseRealProfile_comp_mul_radialNorm
      (by omega) (fun s : Ioi (0 : Real) => q * (t + s.1)) (by fun_prop)
        f hf w hw
  have hmiddle : Integrable Fmiddle (Measure.volumeIoiPow (d - 1)) := by
    dsimp only [Fmiddle]
    exact hinput.norm.const_mul _
  have hR : Integrable (fun s : Ioi (0 : Real) =>
      192 * ((Fminus s + Fplus s) + Fmiddle s))
      (Measure.volumeIoiPow (d - 1)) :=
    ((hminus.add hplus).add hmiddle).const_mul 192
  have hpoint (s : Ioi (0 : Real)) :
      P s * ‖f (s.1 • w)‖ ≤
        192 * ((Fminus s + Fplus s) + Fmiddle s) := by
    have hnorm : 0 ≤ ‖f (s.1 • w)‖ := norm_nonneg _
    calc
      P s * ‖f (s.1 • w)‖ ≤
          (192 * (brrsCubicJapaneseRealProfile (q * (t - s.1)) +
            brrsCubicJapaneseRealProfile (q * (t + s.1)) +
              brrsCubicJapaneseRealProfile (q * t))) * ‖f (s.1 • w)‖ :=
        mul_le_mul_of_nonneg_right (hphase s) hnorm
      _ = 192 * ((Fminus s + Fplus s) + Fmiddle s) := by
        dsimp only [Fminus, Fplus, Fmiddle]
        ring
  change (∫ s : Ioi (0 : Real), P s * ‖f (s.1 • w)‖
      ∂Measure.volumeIoiPow (d - 1)) ≤ _
  calc
    (∫ s : Ioi (0 : Real), P s * ‖f (s.1 • w)‖
        ∂Measure.volumeIoiPow (d - 1)) ≤
        ∫ s : Ioi (0 : Real), 192 * ((Fminus s + Fplus s) + Fmiddle s)
          ∂Measure.volumeIoiPow (d - 1) :=
      integral_mono_of_nonneg
        (Filter.Eventually.of_forall fun s =>
          mul_nonneg (brrsTwoRadiusNinePhaseProfile_nonneg 3 _ _ _)
            (norm_nonneg _)) hR (Filter.Eventually.of_forall hpoint)
    _ = 192 * ((∫ s : Ioi (0 : Real), Fminus s
          ∂Measure.volumeIoiPow (d - 1)) +
        (∫ s : Ioi (0 : Real), Fplus s
          ∂Measure.volumeIoiPow (d - 1)) +
          brrsCubicJapaneseRealProfile (q * t) *
            ∫ s : Ioi (0 : Real), ‖f (s.1 • w)‖
              ∂Measure.volumeIoiPow (d - 1)) := by
      rw [integral_const_mul]
      congr 1
      calc
        (∫ s : Ioi (0 : Real), (Fminus s + Fplus s) + Fmiddle s
            ∂Measure.volumeIoiPow (d - 1)) =
            (∫ s : Ioi (0 : Real), Fminus s + Fplus s
              ∂Measure.volumeIoiPow (d - 1)) +
              ∫ s : Ioi (0 : Real), Fmiddle s
                ∂Measure.volumeIoiPow (d - 1) := by
          simpa only [Pi.add_apply] using
            (integral_add (hminus.add hplus) hmiddle)
        _ = ((∫ s : Ioi (0 : Real), Fminus s
              ∂Measure.volumeIoiPow (d - 1)) +
            ∫ s : Ioi (0 : Real), Fplus s
              ∂Measure.volumeIoiPow (d - 1)) +
              brrsCubicJapaneseRealProfile (q * t) *
                ∫ s : Ioi (0 : Real), ‖f (s.1 • w)‖
                  ∂Measure.volumeIoiPow (d - 1) := by
          rw [integral_add hminus hplus]
          dsimp only [Fmiddle]
          rw [integral_const_mul]

/-- Every vector in a positive-dimensional Euclidean space lies on a unit
ray, including the origin (where a fixed coordinate direction is chosen).
This lets radial stationary estimates stated on a ray become pointwise
estimates on the whole compact output ball. -/
theorem exists_unit_direction_eq_norm_smul
    {d : Nat} (hd : 0 < d) (x : BRRSSpace d) :
    ∃ v : BRRSSpace d, ‖v‖ = 1 ∧ x = ‖x‖ • v := by
  by_cases hx : x = 0
  · let i : Fin d := ⟨0, hd⟩
    let v : BRRSSpace d := EuclideanSpace.single i (1 : Real)
    refine ⟨v, ?_, ?_⟩
    · dsimp [v]
      simp
    · rw [hx, norm_zero, zero_smul]
  · let v : BRRSSpace d := ‖x‖⁻¹ • x
    have hxpos : 0 < ‖x‖ := norm_pos_iff.mpr hx
    refine ⟨v, ?_, ?_⟩
    · dsimp [v]
      rw [norm_smul, Real.norm_eq_abs,
        abs_of_pos (inv_pos.mpr hxpos),
        inv_mul_cancel₀ hxpos.ne']
    · dsimp [v]
      rw [smul_smul, mul_inv_cancel₀ hxpos.ne', one_smul]

/-- On the compact output cell `I₀`, the exact dyadic half-wave is bounded
by the outer integral of its all-nine stationary phase profile.  The source
integral on the right is genuinely integrable for every radial Schwartz
datum; all nine endpoint and middle components remain present. -/
theorem exists_norm_brrsDyadicHalfWave_I0_ninePhase_outerIntegral_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r t : Real,
      ∀ f : BRRSSchwartz d,
      ∀ _hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ v w : BRRSSpace d, ‖v‖ = 1 → ‖w‖ = 1 →
      0 ≤ r → r ≤ dyadicTimeScale j →
      ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ * ((1 - (1 / 32 : Real)) * C) *
          ∫ s : Ioi (0 : Real),
            brrsTwoRadiusNinePhaseProfile N
              (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s.1)
                (((2 : Real) ^ j) * t) * ‖f (s.1 • w)‖
            ∂Measure.volumeIoiPow (d - 1) := by
  obtain ⟨C, hC, hkernel⟩ :=
    exists_norm_brrsDyTwoRadAllStatComponentIntegralSum_I0_ninePhase_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j r t f hf v w hv hw hr0 hr
  let P : Ioi (0 : Real) → Real := fun s =>
    brrsTwoRadiusNinePhaseProfile N
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s.1)
        (((2 : Real) ^ j) * t)
  let B : Real := ‖((2 : Real) ^ j) ^ d‖ * ((1 - (1 / 32 : Real)) * C)
  have hPint : Integrable (fun s : Ioi (0 : Real) => P s * ‖f (s.1 • w)‖)
      (Measure.volumeIoiPow (d - 1)) := by
    dsimp [P]
    exact integrable_brrsTwoRadiusNinePhaseProfile_mul_radialNorm
      (by omega) N (((2 : Real) ^ j) * r) ((2 : Real) ^ j)
        (((2 : Real) ^ j) * t) f hf w hw
  have hK (s : Ioi (0 : Real)) :
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t‖ ≤
        B * P s := by
    dsimp [B, P]
    simpa only [Real.norm_eq_abs, mul_assoc] using
      hkernel j r s.1 t hr0 hr s.2.le
  have hpoint (s : Ioi (0 : Real)) :
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
          f (s.1 • w)‖ ≤ B * (P s * ‖f (s.1 • w)‖) := by
    rw [norm_mul]
    calc
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t‖ *
          ‖f (s.1 • w)‖ ≤ (B * P s) * ‖f (s.1 • w)‖ :=
        mul_le_mul_of_nonneg_right (hK s) (norm_nonneg _)
      _ = B * (P s * ‖f (s.1 • w)‖) := by ring
  rw [brrsDyadicHalfWave_eq_dyadicAllStationaryComponentIntegralSum
    hd Phi j t f hf v w hv hw r hr0]
  calc
    ‖∫ s : Ioi (0 : Real),
        brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
          f (s.1 • w) ∂Measure.volumeIoiPow (d - 1)‖ ≤
        ∫ s : Ioi (0 : Real),
          ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
            f (s.1 • w)‖ ∂Measure.volumeIoiPow (d - 1) :=
      norm_integral_le_integral_norm _
    _ ≤ ∫ s : Ioi (0 : Real), B * (P s * ‖f (s.1 • w)‖)
          ∂Measure.volumeIoiPow (d - 1) := by
      apply integral_mono_of_nonneg
      · filter_upwards with s
        exact norm_nonneg _
      · exact hPint.const_mul B
      · filter_upwards with s
        exact hpoint s
    _ = B * ∫ s : Ioi (0 : Real), P s * ‖f (s.1 • w)‖
          ∂Measure.volumeIoiPow (d - 1) := by
      rw [integral_const_mul]

/-- Literal compact-source form of the initial-cell all-nine bound.  If the
radial trace vanishes once the scaled source radius exceeds `16`, then the
exact stationary integral for `brrsDyadicHalfWave` is supported on the
compact source region `0 < 2^j s ≤ 16`.  In particular, no uncontrolled
source tail is hidden in this `I₀` estimate. -/
theorem exists_ennreal_norm_brrsDyadicHalfWave_I0_supported_compact_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r t : Real,
      ∀ f : BRRSSchwartz d,
      ∀ _hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ v w : BRRSSpace d, ‖v‖ = 1 → ‖w‖ = 1 →
      0 ≤ r → r ≤ dyadicTimeScale j →
      (∀ s : Ioi (0 : Real),
        16 < ((2 : Real) ^ j) * s.1 → f (s.1 • w) = 0) →
      ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
        ∫⁻ s in {s : Ioi (0 : Real) | ((2 : Real) ^ j) * s.1 ≤ 16},
          ENNReal.ofReal ‖((2 : Real) ^ j) ^ d‖ *
            (ENNReal.ofReal ((1 - (1 / 32 : Real)) * C) *
              (ENNReal.ofReal
                (brrsTwoRadiusNinePhaseProfile N
                  (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s.1)
                    (((2 : Real) ^ j) * t)) *
                ENNReal.ofReal ‖f (s.1 • w)‖))
          ∂Measure.volumeIoiPow (d - 1) := by
  obtain ⟨C, hC, hkernel⟩ :=
    exists_norm_brrsDyTwoRadAllStatCompIntegralSum_lowLow_ninePhase_profile_le
      (d := d) (N := N) Phi
  refine ⟨C, hC, ?_⟩
  intro j r t f hf v w hv hw hr0 hr hsupport
  let q : Real := (2 : Real) ^ j
  let S : Set (Ioi (0 : Real)) := {s | q * s.1 ≤ 16}
  let P : Ioi (0 : Real) → Real := fun s =>
    brrsTwoRadiusNinePhaseProfile N (q * r) (q * s.1) (q * t)
  let Cfac : Real := (1 - (1 / 32 : Real)) * C
  let R : Ioi (0 : Real) → ENNReal := fun s =>
    ENNReal.ofReal ‖q ^ d‖ *
      (ENNReal.ofReal Cfac *
        (ENNReal.ofReal (P s) * ENNReal.ofReal ‖f (s.1 • w)‖))
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hCfac : 0 ≤ Cfac := by
    dsimp only [Cfac]
    positivity
  have hscaled : q * dyadicTimeScale j = 1 := by
    dsimp only [q, dyadicTimeScale]
    exact mul_inv_cancel₀ (pow_ne_zero j (by norm_num))
  have hqr0 : 0 ≤ q * r := mul_nonneg hq.le hr0
  have hqrone : q * r ≤ 1 := by
    calc
      q * r ≤ q * dyadicTimeScale j :=
        mul_le_mul_of_nonneg_left hr hq.le
      _ = 1 := hscaled
  have hqr : q * r ≤ 16 := by linarith
  have hS : MeasurableSet S := by
    dsimp only [S]
    exact (continuous_const.mul continuous_subtype_val).measurable measurableSet_Iic
  have houtside (s : Ioi (0 : Real)) (hs : s ∉ S) :
      f (s.1 • w) = 0 := by
    apply hsupport s
    have hs' : ¬ q * s.1 ≤ 16 := by
      change ¬ q * s.1 ≤ 16 at hs
      exact hs
    exact lt_of_not_ge hs'
  have hpoint (s : Ioi (0 : Real)) :
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
          f (s.1 • w)‖ₑ ≤ S.indicator R s := by
    rw [enorm_mul, ← ofReal_norm, ← ofReal_norm]
    by_cases hs : s ∈ S
    · rw [Set.indicator_of_mem hs]
      have hs0 : 0 ≤ q * s.1 := mul_nonneg hq.le s.2.le
      have hslow : q * s.1 ≤ 16 := by
        change q * s.1 ≤ 16 at hs
        exact hs
      have hkernel' :
          ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t‖ ≤
            ‖q ^ d‖ * (Cfac * P s) := by
        simpa only [q, Cfac, P] using
          hkernel j r s.1 t hqr0 hqr hs0 hslow
      have hmul := mul_le_mul_right (ENNReal.ofReal_le_ofReal hkernel')
        (ENNReal.ofReal ‖f (s.1 • w)‖)
      calc
        ENNReal.ofReal
            ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t‖ *
            ENNReal.ofReal ‖f (s.1 • w)‖ =
            ENNReal.ofReal ‖f (s.1 • w)‖ *
              ENNReal.ofReal
                ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t‖ := by
              ac_rfl
        _ ≤ ENNReal.ofReal ‖f (s.1 • w)‖ *
              ENNReal.ofReal (‖q ^ d‖ * (Cfac * P s)) := hmul
        _ = R s := by
          dsimp only [R]
          rw [ENNReal.ofReal_mul (norm_nonneg _), ENNReal.ofReal_mul hCfac]
          ac_rfl
    · rw [Set.indicator_of_notMem hs]
      simp [houtside s hs]
  have hmain :
      ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
        ∫⁻ s : Ioi (0 : Real),
          ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
            f (s.1 • w)‖₊ ∂Measure.volumeIoiPow (d - 1) := by
    calc
      ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ =
          ‖brrsDyadicHalfWave Phi j t f (r • v)‖₊ := ofReal_norm _
      _ = ‖∫ s : Ioi (0 : Real),
          brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
            f (s.1 • w) ∂Measure.volumeIoiPow (d - 1)‖₊ := by
        rw [brrsDyadicHalfWave_eq_dyadicAllStationaryComponentIntegralSum
          hd Phi j t f hf v w hv hw r hr0]
      _ ≤ ∫⁻ s : Ioi (0 : Real),
          ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
            f (s.1 • w)‖₊ ∂Measure.volumeIoiPow (d - 1) :=
        enorm_integral_le_lintegral_enorm _
  have hfinal :
      ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
        ∫⁻ s in S, R s ∂Measure.volumeIoiPow (d - 1) := by
    calc
      ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
          ∫⁻ s : Ioi (0 : Real),
            ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
              f (s.1 • w)‖₊ ∂Measure.volumeIoiPow (d - 1) := hmain
      _ ≤ ∫⁻ s : Ioi (0 : Real), S.indicator R s
            ∂Measure.volumeIoiPow (d - 1) := lintegral_mono hpoint
      _ = ∫⁻ s in S, R s ∂Measure.volumeIoiPow (d - 1) :=
        lintegral_indicator hS R
  simpa only [q, S, P, Cfac, R] using hfinal

/-- The compact radial polar integral is exactly the Lebesgue integral of the
exponent-one source profile on the corresponding scaled interval.  This is
the measure-theoretic interface between the literal half-wave estimate and
the normalized-cubic convolution bound. -/
theorem brrs_lintegral_I0_compactSource_polar_eq_sourceProfile_one
    {d N : Nat} (hd : 2 ≤ d) {q r t : Real} (hq : 0 < q)
    (f : BRRSSchwartz d) (w : BRRSSpace d) :
    (∫⁻ s in {s : Ioi (0 : Real) | q * s.1 ≤ 16},
      ENNReal.ofReal
          (brrsTwoRadiusNinePhaseProfile N (q * r) (q * s.1) (q * t)) *
        ENNReal.ofReal ‖f (s.1 • w)‖
      ∂Measure.volumeIoiPow (d - 1)) =
      ∫⁻ s in Ioc (0 : Real) (16 * q⁻¹),
        ENNReal.ofReal
            (brrsTwoRadiusNinePhaseProfile N (q * r) (q * s) (q * t)) *
          brrsRadialLpSourceProfile (d := d) 1
            (f : BRRSSpace d → Complex) w s := by
  let S : Set (Ioi (0 : Real)) := {s | q * s.1 ≤ 16}
  let T : Set Real := Ioc (0 : Real) (16 * q⁻¹)
  let P : Real → ENNReal := fun s =>
    ENNReal.ofReal
      (brrsTwoRadiusNinePhaseProfile N (q * r) (q * s) (q * t))
  let F : Real → ENNReal := fun s => P s * ENNReal.ofReal ‖f (s • w)‖
  let Fcut : Real → ENNReal := T.indicator F
  have hS : MeasurableSet S := by
    dsimp only [S]
    exact (continuous_const.mul continuous_subtype_val).measurable measurableSet_Iic
  have hT : MeasurableSet T := measurableSet_Ioc
  have hTsub : T ⊆ Ioi (0 : Real) := by
    intro s hs
    exact hs.1
  have hmem (s : Ioi (0 : Real)) : s ∈ S ↔ s.1 ∈ T := by
    dsimp only [S, T]
    constructor
    · intro hs
      refine ⟨s.2, ?_⟩
      rw [show 16 * q⁻¹ = 16 / q by rw [div_eq_mul_inv]]
      apply (le_div_iff₀ hq).2
      change q * s.1 ≤ 16 at hs
      simpa only [mul_comm] using hs
    · rintro ⟨_, hs⟩
      rw [show 16 * q⁻¹ = 16 / q by rw [div_eq_mul_inv]] at hs
      have hs' : s.1 * q ≤ 16 := (le_div_iff₀ hq).1 hs
      change q * s.1 ≤ 16
      simpa only [mul_comm] using hs'
  have hP : Measurable P := by
    have hphase (partR partS : BRRSSurfaceWavePart) :
        Measurable (fun s : Real =>
          brrsSurfaceWavePhase partR (q * r) +
            brrsSurfaceWavePhase partS (q * s) + 2 * Real.pi * (q * t)) := by
      cases partR <;> cases partS <;>
        simp only [brrsSurfaceWavePhase, add_zero, measurable_const, zero_add] <;> fun_prop
    have hsum : Measurable (fun s : Real =>
        brrsTwoRadiusNinePhaseProfile N (q * r) (q * s) (q * t)) := by
      unfold brrsTwoRadiusNinePhaseProfile
      repeat' apply Measurable.add
      all_goals
        exact (measurable_brrsStationaryRapidProfile N).comp (hphase _ _)
    dsimp only [P]
    exact ENNReal.continuous_ofReal.measurable.comp hsum
  have hnorm : Measurable (fun s : Real => ENNReal.ofReal ‖f (s • w)‖) := by
    exact (f.continuous.measurable.comp
      (continuous_id.smul continuous_const).measurable).norm.ennreal_ofReal
  have hF : Measurable F := hP.mul hnorm
  have hFcut : Measurable Fcut := hF.indicator hT
  calc
    (∫⁻ s in {s : Ioi (0 : Real) | q * s.1 ≤ 16},
      ENNReal.ofReal
          (brrsTwoRadiusNinePhaseProfile N (q * r) (q * s.1) (q * t)) *
        ENNReal.ofReal ‖f (s.1 • w)‖
      ∂Measure.volumeIoiPow (d - 1)) =
        ∫⁻ s : Ioi (0 : Real), S.indicator (fun s => F s.1) s
          ∂Measure.volumeIoiPow (d - 1) := by
          rw [lintegral_indicator hS]
    _ = ∫⁻ s : Ioi (0 : Real), Fcut s.1
          ∂Measure.volumeIoiPow (d - 1) := by
          apply lintegral_congr
          intro s
          by_cases hs : s ∈ S
          · have hsT : s.1 ∈ T := (hmem s).1 hs
            dsimp only [Fcut]
            rw [Set.indicator_of_mem hs, Set.indicator_of_mem hsT]
          · have hsT : s.1 ∉ T := fun h => hs ((hmem s).2 h)
            dsimp only [Fcut]
            rw [Set.indicator_of_notMem hs, Set.indicator_of_notMem hsT]
    _ = ∫⁻ s in Ioi (0 : Real),
          ENNReal.ofReal s ^ (d - 1) * Fcut s :=
        Auto.Spherical.SurfaceMeasureDecay.lintegral_volumeIoiPow
          (d - 1) Fcut hFcut
    _ = ∫⁻ s in Ioi (0 : Real),
          T.indicator (fun s => ENNReal.ofReal s ^ (d - 1) * F s) s := by
          apply setLIntegral_congr_fun measurableSet_Ioi
          intro s _hs
          by_cases hsT : s ∈ T <;> simp [Fcut, hsT]
    _ = ∫⁻ s in T, ENNReal.ofReal s ^ (d - 1) * F s := by
          rw [lintegral_indicator hT]
          change ∫⁻ s : Real, ENNReal.ofReal s ^ (d - 1) * F s ∂
              (volume.restrict (Ioi (0 : Real))).restrict T = _
          rw [Measure.restrict_restrict hT]
          rw [inter_eq_left.mpr hTsub]
    _ = ∫⁻ s in Ioc (0 : Real) (16 * q⁻¹),
          ENNReal.ofReal
              (brrsTwoRadiusNinePhaseProfile N (q * r) (q * s) (q * t)) *
            brrsRadialLpSourceProfile (d := d) 1
              (f : BRRSSpace d → Complex) w s := by
          apply setLIntegral_congr_fun hT
          intro s hs
          dsimp only [F, P]
          rw [brrsRadialLpSourceProfile_one_eq_polarDensity (by omega)
            (f : BRRSSpace d → Complex) w hs.1]
          ac_rfl

/-- Literal compact-source initial-cell estimate in normalized-cubic form.
This composes the exact stationary representation of the BRRS half-wave with
the compact radial polar-density identity and the all-nine cubic convolution
estimate.  All dyadic and polar prefactors are retained explicitly. -/
theorem exists_ennreal_norm_brrsDyadicHalfWave_I0_supported_compact_normalizedCubic_le
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r t : Real,
      ∀ f : BRRSSchwartz d,
      ∀ _hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ v w : BRRSSpace d, ‖v‖ = 1 → ‖w‖ = 1 →
      0 ≤ r → r ≤ dyadicTimeScale j →
      (∀ s : Ioi (0 : Real),
        16 < ((2 : Real) ^ j) * s.1 → f (s.1 • w) = 0) →
      ENNReal.ofReal ((2 : Real) ^ j) *
          ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
        (ENNReal.ofReal ‖((2 : Real) ^ j) ^ d‖ *
          ENNReal.ofReal ((1 - (1 / 32 : Real)) * C)) *
          (192 *
            (brrsOneDimProfileConvolution
                (brrsNormalizedScaledCubicProfile ((2 : Real) ^ j))
                (brrsI0CompactSourceProfile ((2 : Real) ^ j)
                  (brrsRadialLpSourceProfile (d := d) 1
                    (f : BRRSSpace d → Complex) w)) t +
              brrsOneDimProfileConvolution
                (brrsNormalizedScaledCubicProfile ((2 : Real) ^ j))
                (brrsReflectProfile
                  (brrsI0CompactSourceProfile ((2 : Real) ^ j)
                    (brrsRadialLpSourceProfile (d := d) 1
                      (f : BRRSSpace d → Complex) w))) t +
                brrsNormalizedScaledCubicProfile ((2 : Real) ^ j) t *
                  ∫⁻ s : Real,
                    brrsI0CompactSourceProfile ((2 : Real) ^ j)
                      (brrsRadialLpSourceProfile (d := d) 1
                        (f : BRRSSpace d → Complex) w) s)) := by
  obtain ⟨C, hC, hbridge⟩ :=
    exists_ennreal_norm_brrsDyadicHalfWave_I0_supported_compact_le
      (d := d) (N := 3) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j r t f hf v w hv hw hr0 hr hsupport
  let q : Real := (2 : Real) ^ j
  let S : Set (Ioi (0 : Real)) := {s | q * s.1 ≤ 16}
  let Cfac : Real := (1 - (1 / 32 : Real)) * C
  let g : Real → ENNReal := brrsRadialLpSourceProfile (d := d) 1
    (f : BRRSSpace d → Complex) w
  let F : Ioi (0 : Real) → ENNReal := fun s =>
    ENNReal.ofReal
      (brrsTwoRadiusNinePhaseProfile 3 (q * r) (q * s.1) (q * t)) *
        ENNReal.ofReal ‖f (s.1 • w)‖
  let B : ENNReal := ENNReal.ofReal ‖q ^ d‖ * ENNReal.ofReal Cfac
  let Z : ENNReal :=
    brrsOneDimProfileConvolution (brrsNormalizedScaledCubicProfile q)
        (brrsI0CompactSourceProfile q g) t +
      brrsOneDimProfileConvolution (brrsNormalizedScaledCubicProfile q)
        (brrsReflectProfile (brrsI0CompactSourceProfile q g)) t +
        brrsNormalizedScaledCubicProfile q t *
          ∫⁻ s : Real, brrsI0CompactSourceProfile q g s
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hscaled : q * dyadicTimeScale j = 1 := by
    dsimp only [q, dyadicTimeScale]
    exact mul_inv_cancel₀ (pow_ne_zero j (by norm_num))
  have hqr0 : 0 ≤ q * r := mul_nonneg hq.le hr0
  have hqr : q * r ≤ 1 := by
    calc
      q * r ≤ q * dyadicTimeScale j :=
        mul_le_mul_of_nonneg_left hr hq.le
      _ = 1 := hscaled
  have hS : MeasurableSet S := by
    dsimp only [S]
    exact (continuous_const.mul continuous_subtype_val).measurable measurableSet_Iic
  have hphase : Measurable (fun s : Ioi (0 : Real) =>
      ENNReal.ofReal
        (brrsTwoRadiusNinePhaseProfile 3 (q * r) (q * s.1) (q * t))) :=
    (measurable_brrsTwoRadiusNinePhaseProfile_source 3 (q * r) q (q * t)).ennreal_ofReal
  have hnorm : Measurable (fun s : Ioi (0 : Real) =>
      ENNReal.ofReal ‖f (s.1 • w)‖) := by
    fun_prop
  have hF : Measurable F := hphase.mul hnorm
  have hg : Measurable g := by
    dsimp only [g]
    exact measurable_brrsRadialLpSourceProfile 1
      (f : BRRSSpace d → Complex) f.continuous.measurable w
  have hbridge' :
      ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
        ∫⁻ s in S,
          ENNReal.ofReal ‖q ^ d‖ * (ENNReal.ofReal Cfac * F s)
          ∂Measure.volumeIoiPow (d - 1) := by
    simpa only [q, S, Cfac, F] using
      hbridge j r t f hf v w hv hw hr0 hr hsupport
  have hfactor :
      (∫⁻ s in S,
        ENNReal.ofReal ‖q ^ d‖ * (ENNReal.ofReal Cfac * F s)
        ∂Measure.volumeIoiPow (d - 1)) =
        B * ∫⁻ s in S, F s ∂Measure.volumeIoiPow (d - 1) := by
    rw [← lintegral_const_mul B hF]
    apply setLIntegral_congr_fun hS
    intro s _hs
    dsimp only [B]
    ac_rfl
  have hpolar :
      (∫⁻ s in S, F s ∂Measure.volumeIoiPow (d - 1)) =
        ∫⁻ s in Ioc (0 : Real) (16 * q⁻¹),
          ENNReal.ofReal
              (brrsTwoRadiusNinePhaseProfile 3 (q * r) (q * s) (q * t)) *
            g s := by
    simpa only [S, F, g] using
      (brrs_lintegral_I0_compactSource_polar_eq_sourceProfile_one
        (d := d) (N := 3) (by omega) hq f w)
  have hcubic :
      ENNReal.ofReal q *
          (∫⁻ s in Ioc (0 : Real) (16 * q⁻¹),
            ENNReal.ofReal
                (brrsTwoRadiusNinePhaseProfile 3 (q * r) (q * s) (q * t)) *
              g s) ≤ 192 * Z := by
    simpa only [Z] using
      (brrs_I0_ninePhase_compactSource_lintegral_normalizedCubic_le
        hq hqr0 hqr g hg)
  calc
    ENNReal.ofReal ((2 : Real) ^ j) *
        ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ =
        ENNReal.ofReal q *
          ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ := by rfl
    _ ≤ ENNReal.ofReal q *
          (∫⁻ s in S,
            ENNReal.ofReal ‖q ^ d‖ * (ENNReal.ofReal Cfac * F s)
            ∂Measure.volumeIoiPow (d - 1)) :=
      by simpa only [mul_comm] using
        (mul_le_mul_left hbridge' (ENNReal.ofReal q))
    _ = B * (ENNReal.ofReal q *
          ∫⁻ s in S, F s ∂Measure.volumeIoiPow (d - 1)) := by
      rw [hfactor]
      ring
    _ = B * (ENNReal.ofReal q *
          ∫⁻ s in Ioc (0 : Real) (16 * q⁻¹),
            ENNReal.ofReal
                (brrsTwoRadiusNinePhaseProfile 3 (q * r) (q * s) (q * t)) *
              g s) := by rw [hpolar]
    _ ≤ B * (192 * Z) := by
      simpa only [mul_comm] using (mul_le_mul_left hcubic B)
    _ =
        (ENNReal.ofReal ‖((2 : Real) ^ j) ^ d‖ *
          ENNReal.ofReal ((1 - (1 / 32 : Real)) * C)) * (192 *
            (brrsOneDimProfileConvolution
                (brrsNormalizedScaledCubicProfile ((2 : Real) ^ j))
                (brrsI0CompactSourceProfile ((2 : Real) ^ j)
                  (brrsRadialLpSourceProfile (d := d) 1
                    (f : BRRSSpace d → Complex) w)) t +
              brrsOneDimProfileConvolution
                (brrsNormalizedScaledCubicProfile ((2 : Real) ^ j))
                (brrsReflectProfile
                  (brrsI0CompactSourceProfile ((2 : Real) ^ j)
                    (brrsRadialLpSourceProfile (d := d) 1
                      (f : BRRSSpace d → Complex) w))) t +
                brrsNormalizedScaledCubicProfile ((2 : Real) ^ j) t *
                  ∫⁻ s : Real,
                    brrsI0CompactSourceProfile ((2 : Real) ^ j)
                      (brrsRadialLpSourceProfile (d := d) 1
                        (f : BRRSSpace d → Complex) w) s)) := by
      rfl

/-- Pointwise ball form of the compact-cell all-nine majorant.  Unlike the
ray version, this statement applies directly to every physical-space point
whose radius lies in `I₀`; its right-hand side is the genuinely integrable
outer radial source integral from the preceding theorem. -/
theorem exists_norm_brrsDyadicHalfWave_I0_ninePhase_outerIntegral_le_at_point
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ t : Real,
      ∀ f : BRRSSchwartz d,
      ∀ _hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ x w : BRRSSpace d, ‖w‖ = 1 →
      ‖x‖ ≤ dyadicTimeScale j →
      ‖brrsDyadicHalfWave Phi j t f x‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ * ((1 - (1 / 32 : Real)) * C) *
          ∫ s : Ioi (0 : Real),
            brrsTwoRadiusNinePhaseProfile N
              (((2 : Real) ^ j) * ‖x‖) (((2 : Real) ^ j) * s.1)
                (((2 : Real) ^ j) * t) * ‖f (s.1 • w)‖
            ∂Measure.volumeIoiPow (d - 1) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_norm_brrsDyadicHalfWave_I0_ninePhase_outerIntegral_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j t f hf x w hw hx
  obtain ⟨v, hv, hxray⟩ :=
    exists_unit_direction_eq_norm_smul (show 0 < d by omega) x
  calc
    ‖brrsDyadicHalfWave Phi j t f x‖ =
        ‖brrsDyadicHalfWave Phi j t f (‖x‖ • v)‖ :=
      congrArg (fun z : BRRSSpace d => ‖brrsDyadicHalfWave Phi j t f z‖) hxray
    _ ≤ ‖((2 : Real) ^ j) ^ d‖ * ((1 - (1 / 32 : Real)) * C) *
          ∫ s : Ioi (0 : Real),
            brrsTwoRadiusNinePhaseProfile N
              (((2 : Real) ^ j) * ‖x‖) (((2 : Real) ^ j) * s.1)
                (((2 : Real) ^ j) * t) * ‖f (s.1 • w)‖
            ∂Measure.volumeIoiPow (d - 1) :=
      hbound j ‖x‖ t f hf v w hv hw (norm_nonneg _) hx

/-- Literal compact-cell pointwise bridge: the actual BRRS dyadic half-wave
is controlled by the three cubic local-time profiles (negative source,
positive source, and middle tail).  All source terms are the normalized
radial `L¹` profile of the given Schwartz datum. -/
theorem exists_ennreal_norm_brrsDyadicHalfWave_I0_threeCubicProfile_le
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ t : Real,
      ∀ f : BRRSSchwartz d,
      ∀ _hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ x w : BRRSSpace d, ‖w‖ = 1 →
      ‖x‖ ≤ dyadicTimeScale j →
      ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f x‖ ≤
        (ENNReal.ofReal
          (192 * (‖((2 : Real) ^ j) ^ d‖ * ((1 - (1 / 32 : Real)) * C)))) *
          brrsI0ThreeCubicProfile ((2 : Real) ^ j)
            (brrsRadialLpSourceProfile (d := d) 1
              (f : BRRSSpace d → Complex) w)
            (∫⁻ s : Real, brrsRadialLpSourceProfile (d := d) 1
              (f : BRRSSpace d → Complex) w s) t := by
  obtain ⟨C, hC, houter⟩ :=
    exists_norm_brrsDyadicHalfWave_I0_ninePhase_outerIntegral_le_at_point
      (d := d) (N := 3) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j t f hf x w hw hx
  let q : Real := (2 : Real) ^ j
  let g : Real → ENNReal := brrsRadialLpSourceProfile (d := d) 1
    (f : BRRSSpace d → Complex) w
  let M : ENNReal := ∫⁻ s : Real, g s
  let A : Real := ‖q ^ d‖ * ((1 - (1 / 32 : Real)) * C)
  let Jminus : Real := ∫ s : Ioi (0 : Real),
    brrsCubicJapaneseRealProfile (q * (t - s.1)) * ‖f (s.1 • w)‖
      ∂Measure.volumeIoiPow (d - 1)
  let Jplus : Real := ∫ s : Ioi (0 : Real),
    brrsCubicJapaneseRealProfile (q * (t + s.1)) * ‖f (s.1 • w)‖
      ∂Measure.volumeIoiPow (d - 1)
  let Jmiddle : Real := brrsCubicJapaneseRealProfile (q * t) *
    ∫ s : Ioi (0 : Real), ‖f (s.1 • w)‖
      ∂Measure.volumeIoiPow (d - 1)
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hqr0 : 0 ≤ q * ‖x‖ := mul_nonneg hq.le (norm_nonneg _)
  have hqr : q * ‖x‖ ≤ 1 := by
    change ‖x‖ ≤ q⁻¹ at hx
    calc
      q * ‖x‖ ≤ q * q⁻¹ := mul_le_mul_of_nonneg_left hx hq.le
      _ = 1 := mul_inv_cancel₀ hq.ne'
  have hA : 0 ≤ A := by
    dsimp only [A]
    exact mul_nonneg (norm_nonneg _)
      (mul_nonneg (by norm_num) hC.le)
  have houter' : ‖brrsDyadicHalfWave Phi j t f x‖ ≤ A *
      ∫ s : Ioi (0 : Real),
        brrsTwoRadiusNinePhaseProfile 3 (q * ‖x‖) (q * s.1) (q * t) *
          ‖f (s.1 • w)‖ ∂Measure.volumeIoiPow (d - 1) := by
    simpa only [q, A] using houter j t f hf x w hw hx
  have hphase := brrs_I0_ninePhase_outerIntegral_le_three_cubic hd
    q ‖x‖ t hqr0 hqr f hf w hw
  have hreal : ‖brrsDyadicHalfWave Phi j t f x‖ ≤
      (192 * A) * (Jminus + Jplus + Jmiddle) := by
    calc
      ‖brrsDyadicHalfWave Phi j t f x‖ ≤ A *
          ∫ s : Ioi (0 : Real),
            brrsTwoRadiusNinePhaseProfile 3 (q * ‖x‖) (q * s.1) (q * t) *
              ‖f (s.1 • w)‖ ∂Measure.volumeIoiPow (d - 1) := houter'
      _ ≤ A * (192 * (Jminus + Jplus + Jmiddle)) := by
        apply mul_le_mul_of_nonneg_left _ hA
        simpa only [Jminus, Jplus, Jmiddle] using hphase
      _ = (192 * A) * (Jminus + Jplus + Jmiddle) := by ring
  have hJminus : 0 ≤ Jminus := by
    dsimp only [Jminus]
    exact integral_nonneg fun s =>
      mul_nonneg (brrsCubicJapaneseRealProfile_nonneg _) (norm_nonneg _)
  have hJplus : 0 ≤ Jplus := by
    dsimp only [Jplus]
    exact integral_nonneg fun s =>
      mul_nonneg (brrsCubicJapaneseRealProfile_nonneg _) (norm_nonneg _)
  have hJmiddle : 0 ≤ Jmiddle := by
    dsimp only [Jmiddle]
    exact mul_nonneg (brrsCubicJapaneseRealProfile_nonneg _)
      (integral_nonneg fun s => norm_nonneg _)
  have hminus : brrsI0ScaledCubicConvolution q g t = ENNReal.ofReal Jminus := by
    dsimp only [g, Jminus]
    exact brrsI0ScaledCubicConvolution_sourceProfile_one_eq_ofReal_integral
      (by omega) f hf w hw q t
  have hplus : brrsI0ScaledCubicConvolution q (brrsReflectProfile g) t =
      ENNReal.ofReal Jplus := by
    dsimp only [g, Jplus]
    exact brrsI0ScaledCubicConvolution_reflect_sourceProfile_one_eq_ofReal_integral
      (by omega) f hf w hw q t
  have hmass : M = ENNReal.ofReal
      (∫ s : Ioi (0 : Real), ‖f (s.1 • w)‖
        ∂Measure.volumeIoiPow (d - 1)) := by
    dsimp only [M, g]
    exact brrs_lintegral_radialLpSourceProfile_one_eq_ofReal_integral
      (by omega) f hf w hw
  have hmiddle : brrsI0CubicTailProfile q M t = ENNReal.ofReal Jmiddle := by
    dsimp only [brrsI0CubicTailProfile, Jmiddle]
    rw [ENNReal.ofReal_mul (brrsCubicJapaneseRealProfile_nonneg _)]
    unfold brrsCubicJapaneseProfile brrsCubicJapaneseRealProfile
    rw [hmass]
  calc
    ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f x‖ ≤
        ENNReal.ofReal ((192 * A) * (Jminus + Jplus + Jmiddle)) :=
      ENNReal.ofReal_le_ofReal hreal
    _ = ENNReal.ofReal (192 * A) *
        ((ENNReal.ofReal Jminus + ENNReal.ofReal Jplus) +
          ENNReal.ofReal Jmiddle) := by
      rw [ENNReal.ofReal_mul (mul_nonneg (by norm_num) hA),
        ENNReal.ofReal_add (add_nonneg hJminus hJplus) hJmiddle,
        ENNReal.ofReal_add hJminus hJplus]
    _ = ENNReal.ofReal (192 * A) *
        brrsI0ThreeCubicProfile q g M t := by
      rw [← hminus, ← hplus, ← hmiddle]
      rfl
    _ = (ENNReal.ofReal (192 *
          (‖((2 : Real) ^ j) ^ d‖ * ((1 - (1 / 32 : Real)) * C)))) *
          (brrsI0ThreeCubicProfile ((2 : Real) ^ j)
            (brrsRadialLpSourceProfile (d := d) 1
              (f : BRRSSpace d → Complex) w)
            (∫⁻ s : Real, brrsRadialLpSourceProfile (d := d) 1
              (f : BRRSSpace d → Complex) w s) t) := by
      rfl

/-- Actual compact-cell radial `p`-moment estimate for the BRRS dyadic
half-wave.  It combines the literal all-nine phase reduction with the
bounded-overlap `I₀` profile, and is valid for every nonnegative real
power.  The source profile here is the genuinely obtained radial `L¹`
profile; obtaining the sharp BRRS low-`p` rate requires a further weighted
source-profile estimate. -/
theorem exists_brrsDyadicHalfWave_I0_radial_rpow_sum_le_threeCubicProfile
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ p : Real, 0 ≤ p →
      ∀ j : Nat, ∀ E : Set Real, ∀ T : Finset Real,
      IsDyadicDiscretization E j T →
      ∀ f : BRRSSchwartz d,
      ∀ _hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ v w : BRRSSpace d, ‖v‖ = 1 → ‖w‖ = 1 →
      (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j),
        (ENNReal.ofReal r) ^ (d - 1) *
          (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖) ^ p) ≤
        17 * ∫⁻ x : Real,
          ((∫⁻ r in Icc (0 : Real) (dyadicTimeScale j),
              (ENNReal.ofReal r) ^ (d - 1)) *
            (ENNReal.ofReal
              (192 * (‖((2 : Real) ^ j) ^ d‖ *
                ((1 - (1 / 32 : Real)) * C)))) ^ p) *
            ((((8 : ENNReal) ^ p * ENNReal.ofReal ((2 : Real) ^ j)) *
              (brrsI0ThreeCubicProfile ((2 : Real) ^ j)
                (brrsRadialLpSourceProfile (d := d) 1
                  (f : BRRSSpace d → Complex) w)
                (∫⁻ s : Real, brrsRadialLpSourceProfile (d := d) 1
                  (f : BRRSSpace d → Complex) w s) x) ^ p)) := by
  obtain ⟨C, hC, hhalf⟩ :=
    exists_ennreal_norm_brrsDyadicHalfWave_I0_threeCubicProfile_le hd Phi
  refine ⟨C, hC, ?_⟩
  intro p hp j E T hT f hf v w hv hw
  let q : Real := (2 : Real) ^ j
  let g : Real → ENNReal := brrsRadialLpSourceProfile (d := d) 1
    (f : BRRSSpace d → Complex) w
  let M : ENNReal := ∫⁻ s : Real, g s
  let K : ENNReal := ENNReal.ofReal
    (192 * (‖q ^ d‖ * ((1 - (1 / 32 : Real)) * C)))
  let W : ENNReal := ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j),
    (ENNReal.ofReal r) ^ (d - 1)
  let A : ENNReal := W * K ^ p
  let F : Real → ENNReal := brrsI0ThreeCubicProfile q g M
  let c : ENNReal := (8 : ENNReal) ^ p * ENNReal.ofReal q
  let H : Real → Real → ENNReal := fun t r =>
    (ENNReal.ofReal r) ^ (d - 1) *
      (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖) ^ p
  have hg : Measurable g := by
    dsimp only [g]
    exact measurable_brrsRadialLpSourceProfile 1
      (f : BRRSSpace d → Complex) f.continuous.measurable w
  have hweight : Measurable (fun r : Real =>
      (ENNReal.ofReal r) ^ (d - 1)) :=
    ENNReal.continuous_ofReal.measurable.pow_const (d - 1)
  have hhalfpoint (t r : Real) (hr : r ∈ Icc (0 : Real) (dyadicTimeScale j)) :
      ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤ K * F t := by
    have hnorm : ‖r • v‖ = r := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hr.1, hv, mul_one]
    have hradial : ‖r • v‖ ≤ dyadicTimeScale j := by
      rw [hnorm]
      exact hr.2
    have hbound := hhalf j t f hf (r • v) w hw hradial
    simpa only [q, g, M, K, F] using hbound
  have hpointp (t r : Real) (hr : r ∈ Icc (0 : Real) (dyadicTimeScale j)) :
      (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖) ^ p ≤
        K ^ p * F t ^ p := by
    have hpow := ENNReal.rpow_le_rpow (hhalfpoint t r hr) hp
    rw [ENNReal.mul_rpow_of_nonneg _ _ hp] at hpow
    exact hpow
  have hcontrol (t : Real) (_ht : t ∈ T) :
      (∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤ A * F t ^ p := by
    calc
      (∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
          ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j),
            (ENNReal.ofReal r) ^ (d - 1) * (K ^ p * F t ^ p) := by
        apply setLIntegral_mono' measurableSet_Icc
        intro r hr
        dsimp only [H]
        simpa only [mul_comm] using
          (mul_le_mul_left (hpointp t r hr)
            ((ENNReal.ofReal r) ^ (d - 1)))
      _ = W * (K ^ p * F t ^ p) := by
        dsimp only [W]
        calc
          (∫⁻ r in Icc (0 : Real) (dyadicTimeScale j),
              (ENNReal.ofReal r) ^ (d - 1) * (K ^ p * F t ^ p)) =
              ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j),
                (K ^ p * F t ^ p) * (ENNReal.ofReal r) ^ (d - 1) := by
            apply setLIntegral_congr_fun measurableSet_Icc
            intro r hr
            ring
          _ = (K ^ p * F t ^ p) *
              ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j),
                (ENNReal.ofReal r) ^ (d - 1) := by
            exact lintegral_const_mul (K ^ p * F t ^ p) hweight
          _ = W * (K ^ p * F t ^ p) := by
            dsimp only [W]
            ring
      _ = A * F t ^ p := by
        dsimp only [A]
        ring
  change (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
    17 * ∫⁻ x : Real, A * (c * F x ^ p)
  simpa only [q, g, M, A, F, c] using
    (brrs_sum_dyadicI0_lintegral_le_of_threeCubic_rpow_control j T hT H A M p hp
      hg hcontrol)

/-- Assembly interface for the actual compact-cell radial `I₀` moment.
It separates the geometric half-wave reduction from the remaining scalar
source-profile estimate: any stated full-line `p`-moment bound for the
three-cubic profile yields the corresponding sampled radial half-wave bound,
with every dyadic and radial-volume factor displayed explicitly.  This is not
the BRRS low-`p` proposition itself. -/
theorem exists_brrsDyadicHalfWave_I0_radial_rpow_sum_le_of_threeCubicProfile_moment
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ p : Real, 0 ≤ p →
      ∀ j : Nat, ∀ E : Set Real, ∀ T : Finset Real,
      IsDyadicDiscretization E j T →
      ∀ f : BRRSSchwartz d,
      ∀ _hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ v w : BRRSSpace d, ‖v‖ = 1 → ‖w‖ = 1 →
      ∀ B : ENNReal,
      (∫⁻ x : Real,
        (brrsI0ThreeCubicProfile ((2 : Real) ^ j)
          (brrsRadialLpSourceProfile (d := d) 1
            (f : BRRSSpace d → Complex) w)
          (∫⁻ s : Real, brrsRadialLpSourceProfile (d := d) 1
            (f : BRRSSpace d → Complex) w s) x) ^ p) ≤ B →
      (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j),
        (ENNReal.ofReal r) ^ (d - 1) *
          (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖) ^ p) ≤
        17 *
          ((((∫⁻ r in Icc (0 : Real) (dyadicTimeScale j),
              (ENNReal.ofReal r) ^ (d - 1)) *
            (ENNReal.ofReal
              (192 * (‖((2 : Real) ^ j) ^ d‖ *
                ((1 - (1 / 32 : Real)) * C)))) ^ p) *
            ((8 : ENNReal) ^ p * ENNReal.ofReal ((2 : Real) ^ j))) * B) := by
  obtain ⟨C, hC, hI0⟩ :=
    exists_brrsDyadicHalfWave_I0_radial_rpow_sum_le_threeCubicProfile hd Phi
  refine ⟨C, hC, ?_⟩
  intro p hp j E T hT f hf v w hv hw B hprofile
  let q : Real := (2 : Real) ^ j
  let g : Real → ENNReal := brrsRadialLpSourceProfile (d := d) 1
    (f : BRRSSpace d → Complex) w
