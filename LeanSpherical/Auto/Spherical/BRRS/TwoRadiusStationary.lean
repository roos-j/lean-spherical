/-- The compact cutoff removes the lower endpoint boundary term from an
actual planar two-radius stationary coefficient. -/
theorem brrsPlanarTwoRadiusStationaryCoefficient_eventuallyEq_zero_at_lower
    (Phi : BRRSAnnularCutoff) (partR partS : BRRSSurfaceWavePart)
    (r s : Real) :
    Filter.EventuallyEq (nhds (1 / 32 : Real))
      (fun rho : Real =>
        brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho) 0 := by
  filter_upwards [brrsDyadicHalfWaveKernelRadialProfile_eventuallyEq_zero_at_lower_levelZero
    Phi 0] with rho hrho
  unfold brrsPlanarTwoRadiusStationaryCoefficient at *
  unfold brrsDyadicHalfWaveKernelRadialProfile at hrho
  simp only [pow_zero, inv_one, mul_one] at hrho
  by_cases hcut : Phi.symbol (2 * Real.pi * rho) = 0
  · simp [hcut]
  · have hexp : Complex.exp (((2 * Real.pi * (0 : Real) * rho : Real) : Complex) *
        Complex.I) ≠ 0 := Complex.exp_ne_zero _
    exfalso
    apply hcut
    simpa [hexp] using hrho

/-- The compact cutoff removes the upper endpoint boundary term from an
actual planar two-radius stationary coefficient. -/
theorem brrsPlanarTwoRadiusStationaryCoefficient_eventuallyEq_zero_at_upper
    (Phi : BRRSAnnularCutoff) (partR partS : BRRSSurfaceWavePart)
    (r s : Real) :
    Filter.EventuallyEq (nhds (1 : Real))
      (fun rho : Real =>
        brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho) 0 := by
  filter_upwards [brrsDyadicHalfWaveKernelRadialProfile_eventuallyEq_zero_at_upper_levelZero
    Phi 0] with rho hrho
  unfold brrsPlanarTwoRadiusStationaryCoefficient at *
  unfold brrsDyadicHalfWaveKernelRadialProfile at hrho
  simp only [pow_zero, inv_one, mul_one] at hrho
  by_cases hcut : Phi.symbol (2 * Real.pi * rho) = 0
  · simp [hcut]
  · have hexp : Complex.exp (((2 * Real.pi * (0 : Real) * rho : Real) : Complex) *
        Complex.I) ≠ 0 := Complex.exp_ne_zero _
    exfalso
    apply hcut
    simpa [hexp] using hrho

/-- Uniform compact nonstationary-phase decay for an actual planar
endpoint--endpoint component at two high physical radii. -/
theorem exists_norm_intervalIntegral_brrsPlanarTwoRadStatCoeff_endpoint_highRad_le
    (N : Nat) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart)
    (hpartR : partR = .outgoing ∨ partR = .incoming)
    (hpartS : partS = .outgoing ∨ partS = .incoming) :
    ∃ C : Real, 0 < C ∧ ∀ r s : Real, 16 ≤ r → 16 ≤ s →
      ∀ {freq : Real}, freq ≠ 0 →
        ‖∫ rho in (1 / 32 : Real)..1,
          brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho *
            oscillatoryExp freq rho‖ ≤
          (1 / |freq|) ^ N * ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (r / 16) * Real.sqrt (s / 16)))) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_uniform_iteratedDeriv_brrsPlanarTwoRadStatCoeff_endpoint_highRad_decay
      N Phi partR partS hpartR hpartS
  refine ⟨C, hC, ?_⟩
  intro r s hr hs freq hfreq
  have hqpos : 0 < Real.sqrt (r / 16) := by
    apply Real.sqrt_pos.2
    linarith
  have hspos : 0 < Real.sqrt (s / 16) := by
    apply Real.sqrt_pos.2
    linarith
  have hchain := hasOscillatoryIBPChain_iteratedDeriv_of_contDiff
    (fun rho : Real =>
      brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho)
    (contDiff_brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s)
    (brrsPlanarTwoRadiusStationaryCoefficient_eventuallyEq_zero_at_lower
      Phi partR partS r s)
    (brrsPlanarTwoRadiusStationaryCoefficient_eventuallyEq_zero_at_upper
      Phi partR partS r s) N
  simpa only [iteratedDeriv_zero] using
    (norm_intervalIntegral_mul_oscillatoryExp_le_iterated
      (F := fun k => iteratedDeriv k (fun rho : Real =>
        brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho))
      (N := N) (by norm_num : (1 / 32 : Real) ≤ 1) hfreq hchain
      (div_nonneg hC.le (mul_pos hqpos hspos).le)
      (fun rho hrho => hbound N le_rfl r s rho hr hs hrho))

end

