  have hess : eLpNormEssSup
      (brrsFiniteTimeHalfWaveOutput Phi j T (f : BRRSSpace d → Complex))
      (Measure.count.prod (volume : Measure (BRRSSpace d))) ≤
        ENNReal.ofReal
          ((B * ((2 : Real) ^ j) ^ (((d : Real) - 1) / 2)) *
            (eLpNorm (f : BRRSSpace d → Complex) ⊤ volume).toReal) :=
    eLpNormEssSup_le_of_ae_bound (Filter.Eventually.of_forall (fun z => by
      rcases z with ⟨t, x⟩
      change ‖(brrsLpHalfWaveExtension Phi).apply j (t : Real)
        (f : BRRSSpace d → Complex) x‖ ≤ _
      have ht : (t : Real) ∈ Icc (1 : Real) 2 := hT t t.property
      calc
        ‖(brrsLpHalfWaveExtension Phi).apply j (t : Real)
            (f : BRRSSpace d → Complex) x‖ ≤
            (∫ y : BRRSSpace d, ‖brrsDyadicHalfWaveKernel Phi j (t : Real) y‖) *
              (eLpNorm (f : BRRSSpace d → Complex) ⊤ volume).toReal :=
          norm_brrsConvolution_le_of_ae_bound
            (brrsDyadicHalfWaveKernel Phi j (t : Real) : BRRSSpace d → Complex)
            (f : BRRSSpace d → Complex)
            (brrsDyadicHalfWaveKernel Phi j (t : Real)).integrable hfbnd x
        _ ≤ (B * ((2 : Real) ^ j) ^ (((d : Real) - 1) / 2)) *
            (eLpNorm (f : BRRSSpace d → Complex) ⊤ volume).toReal :=
          mul_le_mul_of_nonneg_right (hkernel j hj (t : Real) ht)
            ENNReal.toReal_nonneg))
  calc
    eLpNormEssSup
        (brrsFiniteTimeHalfWaveOutput Phi j T (f : BRRSSpace d → Complex))
        (Measure.count.prod (volume : Measure (BRRSSpace d))) ≤
        ENNReal.ofReal
          ((B * ((2 : Real) ^ j) ^ (((d : Real) - 1) / 2)) *
            (eLpNorm (f : BRRSSpace d → Complex) ⊤ volume).toReal) := hess
    _ = ENNReal.ofReal (B * ((2 : Real) ^ j) ^ (((d : Real) - 1) / 2)) *
          eLpNorm (f : BRRSSpace d → Complex) ⊤ volume := by
      rw [ENNReal.ofReal_mul hrate_nonneg, ENNReal.ofReal_toReal hfTop_ne]

/-- The planar finite-time `L∞` endpoint in the same counting-times-space
product used by the high-exponent interpolation theorem. -/
theorem exists_brrs_planarFiniteTimeHalfWaveOutput_top_bound
    (Phi : BRRSAnnularCutoff) :
    ∃ B : Real, 0 < B ∧ ∀ j : Nat, 1 ≤ j → ∀ T : Finset Real,
      (∀ t ∈ T, t ∈ Icc (1 : Real) 2) →
      ∀ f : SimpleFunc (Euclidean 2) Complex, Integrable f volume →
        eLpNorm (brrsFiniteTimeHalfWaveOutput Phi j T
          (f : Euclidean 2 → Complex)) ⊤
          (Measure.count.prod (volume : Measure (Euclidean 2))) ≤
          ENNReal.ofReal (B * Real.sqrt ((2 : Real) ^ j)) *
            eLpNorm (f : Euclidean 2 → Complex) ⊤ volume := by
  obtain ⟨B, hB, hkernel⟩ := exists_brrs_planarDyadicHalfWaveKernelL1_bound Phi
  refine ⟨B, hB, ?_⟩
  intro j hj T hT f hf
  apply brrsFiniteTimeHalfWaveOutput_top_bound_of_kernelL1 Phi j T
    (mul_nonneg hB.le (Real.sqrt_nonneg _)) ?_ f hf
  intro t ht
  exact hkernel j hj t (hT t ht)

/-! ### Radial-profile interpolation transport

The Riesz--Thorin theorem available in this development is formulated on
`SimpleFunc`.  Radial Schwartz functions are not simple functions, so a
Schwartz-core estimate cannot be inserted into it directly.  The following
profile output supplies the correct linear simple-function domain: a scalar
profile is lifted to a norm-radial Euclidean simple function before applying
the canonical finite-time half-wave realization.

The named transfer hypothesis below records *exactly* the remaining density
and output-continuity issue.  It is not asserted in this file.  Once it is
proved, the transport theorem turns a literal radial Schwartz lower endpoint
and the proved kernel `L^infinity` endpoint into a literal higher-exponent
Schwartz-core bound, with no change of operator hidden in the conclusion.
-/

/-- The canonical finite-time half-wave applied to a scalar radial-profile
simple function.  Its domain has the pushforward radial-profile measure, so
it is a genuine vector space of simple functions to which Riesz--Thorin
applies. -/
noncomputable def brrsFiniteTimeRadialProfileOutput {d : Nat}
    (Phi : BRRSAnnularCutoff) (j : Nat) (T : Finset Real)
    (F : SimpleFunc Real Complex) :
    ({t : Real // t ∈ (T : Set Real)} × BRRSSpace d) → Complex :=
  brrsFiniteTimeHalfWaveOutput Phi j T
    (brrsRadialProfileLift (d := d) F : BRRSSpace d → Complex)

/-- Additivity of the radial-profile finite-time realization on its genuine
integrable simple-function core. -/
theorem brrsFiniteTimeRadialProfileOutput_add {d : Nat}
    (Phi : BRRSAnnularCutoff) (j : Nat) (T : Finset Real)
    (F G : SimpleFunc Real Complex)
    (hF : Integrable (F : Real → Complex) (brrsRadialProfileMeasure d))
    (hG : Integrable (G : Real → Complex) (brrsRadialProfileMeasure d)) :
    brrsFiniteTimeRadialProfileOutput (d := d) Phi j T (F + G) =
      brrsFiniteTimeRadialProfileOutput Phi j T F +
        brrsFiniteTimeRadialProfileOutput Phi j T G := by
  unfold brrsFiniteTimeRadialProfileOutput
  rw [brrsRadialProfileLift_add]
  exact brrsFiniteTimeHalfWaveOutput_add Phi j T
    (brrsRadialProfileLift (d := d) F)
    (brrsRadialProfileLift (d := d) G)
    ((integrable_brrsRadialProfileLift_iff F).mp hF)
    ((integrable_brrsRadialProfileLift_iff G).mp hG)

/-- Complex homogeneity of the radial-profile finite-time realization on the
integrable simple-function core. -/
theorem brrsFiniteTimeRadialProfileOutput_smul {d : Nat}
    (Phi : BRRSAnnularCutoff) (j : Nat) (T : Finset Real)
    (c : Complex) (F : SimpleFunc Real Complex)
    (hF : Integrable (F : Real → Complex) (brrsRadialProfileMeasure d)) :
    brrsFiniteTimeRadialProfileOutput (d := d) Phi j T (c • F) =
      c • brrsFiniteTimeRadialProfileOutput Phi j T F := by
  unfold brrsFiniteTimeRadialProfileOutput
  rw [brrsRadialProfileLift_smul]
  exact brrsFiniteTimeHalfWaveOutput_smul Phi j T c
    (brrsRadialProfileLift (d := d) F)
    ((integrable_brrsRadialProfileLift_iff F).mp hF)

/-- Measurability of the radial-profile finite-time realization. -/
theorem measurable_brrsFiniteTimeRadialProfileOutput {d : Nat}
    (Phi : BRRSAnnularCutoff) (j : Nat) (T : Finset Real)
    (F : SimpleFunc Real Complex)
    (hF : Integrable (F : Real → Complex) (brrsRadialProfileMeasure d)) :
    Measurable (brrsFiniteTimeRadialProfileOutput (d := d) Phi j T F) := by
  unfold brrsFiniteTimeRadialProfileOutput
  exact measurable_brrsFiniteTimeHalfWaveOutput Phi j T
    (brrsRadialProfileLift (d := d) F)
    ((integrable_brrsRadialProfileLift_iff F).mp hF)

/-- A precise radial closure principle for one finite time set and one
exponent.  Its left side is the literal Fourier formula on radial Schwartz
data; its right side is the canonical convolution realization on the radial
simple-profile core.  Establishing this equivalence requires radial density
and finite-time output continuity, neither of which follows from the
ambient non-radial Schwartz density theorem alone. -/
def HasBRRSFiniteTimeRadialProfileSimpleBoundTransfer {d : Nat}
    (Phi : BRRSAnnularCutoff) (j : Nat) (T : Finset Real) (p : Real) : Prop :=
  ∀ C : ENNReal,
    (∀ f : BRRSSchwartz d, IsRadial (f : BRRSSpace d → Complex) →
      discreteLpNorm p T (fun t => brrsDyadicHalfWave Phi j t f) ≤
        C * eLpNorm (f : BRRSSpace d → Complex) (ENNReal.ofReal p) volume) ↔
    (∀ F : SimpleFunc Real Complex,
      Integrable (F : Real → Complex) (brrsRadialProfileMeasure d) →
        eLpNorm (brrsFiniteTimeRadialProfileOutput (d := d) Phi j T F)
          (ENNReal.ofReal p)
          (Measure.count.prod (volume : Measure (BRRSSpace d))) ≤
          C * eLpNorm (F : Real → Complex) (ENNReal.ofReal p)
            (brrsRadialProfileMeasure d))

/-- Riesz--Thorin on the actual scalar radial-profile simple-function domain.
This is the reusable interpolation step before the explicit Schwartz/simple
closure hypothesis is invoked. -/
theorem brrsFiniteTimeRadialProfile_highExponent_discreteLpEstimate_of_lower_and_top
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat) (T : Finset Real)
    {p₀ p : Real} (hp₀ : 1 ≤ p₀) (hp₀p : p₀ < p)
    {A₀ A_top s₀ s_top : Real} (hA₀ : 0 < A₀) (hA_top : 0 < A_top)
    (hlower : ∀ F : SimpleFunc Real Complex,
      Integrable (F : Real → Complex) (brrsRadialProfileMeasure d) →
        eLpNorm (brrsFiniteTimeRadialProfileOutput (d := d) Phi j T F)
          (ENNReal.ofReal p₀)
          (Measure.count.prod (volume : Measure (BRRSSpace d))) ≤
          ENNReal.ofReal (A₀ * (2 : Real) ^ ((j : Real) * s₀)) *
            eLpNorm (F : Real → Complex) (ENNReal.ofReal p₀)
              (brrsRadialProfileMeasure d))
    (htop : ∀ F : SimpleFunc Real Complex,
      Integrable (F : Real → Complex) (brrsRadialProfileMeasure d) →
        eLpNorm (brrsFiniteTimeRadialProfileOutput (d := d) Phi j T F) ⊤
          (Measure.count.prod (volume : Measure (BRRSSpace d))) ≤
          ENNReal.ofReal (A_top * (2 : Real) ^ ((j : Real) * s_top)) *
            eLpNorm (F : Real → Complex) ⊤ (brrsRadialProfileMeasure d)) :
    ∀ F : SimpleFunc Real Complex,
      Integrable (F : Real → Complex) (brrsRadialProfileMeasure d) →
        MemLp (brrsFiniteTimeRadialProfileOutput (d := d) Phi j T F)
          (ENNReal.ofReal p)
          (Measure.count.prod (volume : Measure (BRRSSpace d))) ∧
        eLpNorm (brrsFiniteTimeRadialProfileOutput (d := d) Phi j T F)
          (ENNReal.ofReal p)
          (Measure.count.prod (volume : Measure (BRRSSpace d))) ≤
          ENNReal.ofReal
            ((Real.rpow A₀ (1 - (1 - p₀ / p)) * Real.rpow A_top (1 - p₀ / p)) *
              (2 : Real) ^ ((j : Real) * ((1 - (1 - p₀ / p)) * s₀ +
                (1 - p₀ / p) * s_top))) *
            eLpNorm (F : Real → Complex) (ENNReal.ofReal p)
              (brrsRadialProfileMeasure d) := by
  exact highExponent_discreteLpEstimate_of_lower_and_top
    (μ := brrsRadialProfileMeasure d)
    (ν := Measure.count.prod (volume : Measure (BRRSSpace d)))
    hp₀ hp₀p
    (brrsFiniteTimeRadialProfileOutput (d := d) Phi j T)
    (fun F G hF hG =>
      brrsFiniteTimeRadialProfileOutput_add Phi j T F G hF hG)
    (fun c F hF => brrsFiniteTimeRadialProfileOutput_smul Phi j T c F hF)
    (fun F hF => measurable_brrsFiniteTimeRadialProfileOutput Phi j T F hF)
    hA₀ hA_top j hlower htop

/-- The existing dimension-at-least-three kernel bound, expressed on the
radial-profile simple-function core used by interpolation. -/
theorem exists_brrsFiniteTimeRadialProfileOutput_top_bound_dim_ge_three
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ B : Real, 0 < B ∧ ∀ j : Nat, 1 ≤ j → ∀ T : Finset Real,
      (∀ t ∈ T, t ∈ Icc (1 : Real) 2) →
      ∀ F : SimpleFunc Real Complex,
        Integrable (F : Real → Complex) (brrsRadialProfileMeasure d) →
        eLpNorm (brrsFiniteTimeRadialProfileOutput (d := d) Phi j T F) ⊤
          (Measure.count.prod (volume : Measure (BRRSSpace d))) ≤
          ENNReal.ofReal (B * ((2 : Real) ^ j) ^ (((d : Real) - 1) / 2)) *
            eLpNorm (F : Real → Complex) ⊤ (brrsRadialProfileMeasure d) := by
  obtain ⟨B, hB, htop⟩ :=
    exists_brrsFiniteTimeHalfWaveOutput_top_bound_dim_ge_three hd Phi
  refine ⟨B, hB, ?_⟩
  intro j hj T hT F hF
  have h := htop j hj T hT (brrsRadialProfileLift (d := d) F)
    ((integrable_brrsRadialProfileLift_iff F).mp hF)
  rw [← eLpNorm_brrsRadialProfileLift_eq (p := (⊤ : ENNReal)) F] at h
  simpa only [brrsFiniteTimeRadialProfileOutput] using h

/-- The planar kernel endpoint on the radial-profile simple-function core. -/
theorem exists_brrsPlanarFiniteTimeRadialProfileOutput_top_bound
    (Phi : BRRSAnnularCutoff) :
    ∃ B : Real, 0 < B ∧ ∀ j : Nat, 1 ≤ j → ∀ T : Finset Real,
      (∀ t ∈ T, t ∈ Icc (1 : Real) 2) →
      ∀ F : SimpleFunc Real Complex,
        Integrable (F : Real → Complex) (brrsRadialProfileMeasure 2) →
        eLpNorm (brrsFiniteTimeRadialProfileOutput (d := 2) Phi j T F) ⊤
          (Measure.count.prod (volume : Measure (BRRSSpace 2))) ≤
          ENNReal.ofReal (B * Real.sqrt ((2 : Real) ^ j)) *
            eLpNorm (F : Real → Complex) ⊤ (brrsRadialProfileMeasure 2) := by
  obtain ⟨B, hB, htop⟩ := exists_brrs_planarFiniteTimeHalfWaveOutput_top_bound Phi
  refine ⟨B, hB, ?_⟩
  intro j hj T hT F hF
  have h := htop j hj T hT (brrsRadialProfileLift (d := 2) F)
    ((integrable_brrsRadialProfileLift_iff F).mp hF)
  rw [← eLpNorm_brrsRadialProfileLift_eq (p := (⊤ : ENNReal)) F] at h
  simpa only [brrsFiniteTimeRadialProfileOutput] using h

/-- Conditional high-exponent transport for the *literal* BRRS half-wave on
radial Schwartz data.  The two `HasBRRS...BoundTransfer` hypotheses isolate
the only domain mismatch between the available simple-function Riesz--Thorin
theorem and the literal Schwartz-core endpoints.  Thus this theorem has no
unstated density or extension step. -/
theorem brrsFiniteTimeSchwartzCore_highExponent_of_lower_and_top
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat) (T : Finset Real)
    {p₀ p : Real} (hp₀ : 1 ≤ p₀) (hp₀p : p₀ < p)
    (htransfer₀ : HasBRRSFiniteTimeRadialProfileSimpleBoundTransfer
      (d := d) Phi j T p₀)
    (htransfer : HasBRRSFiniteTimeRadialProfileSimpleBoundTransfer
      (d := d) Phi j T p)
    {A₀ A_top s₀ s_top : Real} (hA₀ : 0 < A₀) (hA_top : 0 < A_top)
    (hlower : ∀ f : BRRSSchwartz d, IsRadial (f : BRRSSpace d → Complex) →
      discreteLpNorm p₀ T (fun t => brrsDyadicHalfWave Phi j t f) ≤
        ENNReal.ofReal (A₀ * (2 : Real) ^ ((j : Real) * s₀)) *
          eLpNorm (f : BRRSSpace d → Complex) (ENNReal.ofReal p₀) volume)
    (htop : ∀ F : SimpleFunc Real Complex,
      Integrable (F : Real → Complex) (brrsRadialProfileMeasure d) →
        eLpNorm (brrsFiniteTimeRadialProfileOutput (d := d) Phi j T F) ⊤
          (Measure.count.prod (volume : Measure (BRRSSpace d))) ≤
          ENNReal.ofReal (A_top * (2 : Real) ^ ((j : Real) * s_top)) *
            eLpNorm (F : Real → Complex) ⊤ (brrsRadialProfileMeasure d)) :
    ∀ f : BRRSSchwartz d, IsRadial (f : BRRSSpace d → Complex) →
      discreteLpNorm p T (fun t => brrsDyadicHalfWave Phi j t f) ≤
        ENNReal.ofReal
          ((Real.rpow A₀ (1 - (1 - p₀ / p)) * Real.rpow A_top (1 - p₀ / p)) *
            (2 : Real) ^ ((j : Real) * ((1 - (1 - p₀ / p)) * s₀ +
              (1 - p₀ / p) * s_top))) *
          eLpNorm (f : BRRSSpace d → Complex) (ENNReal.ofReal p) volume := by
  let C₀ : ENNReal := ENNReal.ofReal (A₀ * (2 : Real) ^ ((j : Real) * s₀))
  let C : ENNReal := ENNReal.ofReal
    ((Real.rpow A₀ (1 - (1 - p₀ / p)) * Real.rpow A_top (1 - p₀ / p)) *
      (2 : Real) ^ ((j : Real) * ((1 - (1 - p₀ / p)) * s₀ +
        (1 - p₀ / p) * s_top)))
  have hlowerProfile : ∀ F : SimpleFunc Real Complex,
      Integrable (F : Real → Complex) (brrsRadialProfileMeasure d) →
        eLpNorm (brrsFiniteTimeRadialProfileOutput (d := d) Phi j T F)
          (ENNReal.ofReal p₀)
          (Measure.count.prod (volume : Measure (BRRSSpace d))) ≤
          C₀ * eLpNorm (F : Real → Complex) (ENNReal.ofReal p₀)
            (brrsRadialProfileMeasure d) := by
    apply (htransfer₀ C₀).mp
    simpa only [C₀] using hlower
  have hhighProfile : ∀ F : SimpleFunc Real Complex,
      Integrable (F : Real → Complex) (brrsRadialProfileMeasure d) →
        eLpNorm (brrsFiniteTimeRadialProfileOutput (d := d) Phi j T F)
          (ENNReal.ofReal p)
          (Measure.count.prod (volume : Measure (BRRSSpace d))) ≤
          C * eLpNorm (F : Real → Complex) (ENNReal.ofReal p)
            (brrsRadialProfileMeasure d) := by
    intro F hF
    exact (brrsFiniteTimeRadialProfile_highExponent_discreteLpEstimate_of_lower_and_top
      Phi j T hp₀ hp₀p hA₀ hA_top hlowerProfile htop F hF).2
  apply (htransfer C).mpr
  simpa only [C] using hhighProfile

/-! ### Compact two-radius stationary regime -/

/-- On the compact physical-radius region, the frequency coefficient of one
stationary surface wave has uniformly bounded derivatives.  This is the
low-radius counterpart of the high-radius half-density estimate. -/
theorem exists_uniform_iteratedDeriv_brrsStationaryWaveRadialCoefficient_lowRadius_bound
    (Phi : BRRSAnnularCutoff) (d N : Nat) (part : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ a rho : Real,
      0 ≤ a → a ≤ 16 → rho ∈ Icc (1 / 32 : Real) 1 →
        ‖iteratedDeriv k (fun u : Real =>
          brrsStationaryWaveRadialCoefficient Phi d part a u) rho‖ ≤ C := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_iteratedDeriv_brrsStationaryWaveRadialFixedFactor_bound Phi d N
  choose B hBpos hBbound using fun k : Nat =>
    exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_lowRadius_bound d k part
  let B' : Real := ∑ k ∈ Finset.range (N + 1), B k
  have hB' : 0 < B' := by
    have hzero : 0 ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    have hle : B 0 ≤ B' := by
      dsimp [B']
      exact Finset.single_le_sum (fun k hk => (hBpos k).le) hzero
    exact lt_of_lt_of_le (hBpos 0) hle
  let C : Real := ∑ l ∈ Finset.range (N + 1),
    brrsStationaryLeibnizConstant l A B'
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact brrsStationaryLeibnizConstant_nonneg l hA.le hB'.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk a rho ha0 ha hrho
  let fixed : Real → Complex := brrsStationaryWaveRadialFixedFactor Phi d
  let physical : Real → Complex := fun u : Real =>
    brrsSurfaceWaveAmplitude d part a u
  have hfixed : ContDiff Real (⊤ : ENat) fixed := by
    dsimp [fixed]
    exact contDiff_brrsStationaryWaveRadialFixedFactor Phi d
  have hphysical : ContDiff Real (⊤ : ENat) physical := by
    dsimp [physical]
    exact contDiff_brrsSurfaceWaveAmplitude d part a
  have hBuniform : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l physical rho‖ ≤ B' := by
    intro l hl
    have hlmem : l ∈ Finset.range (N + 1) :=
      Finset.mem_range.mpr (by omega)
    have hle : B l ≤ B' := by
      dsimp [B']
      exact Finset.single_le_sum (fun m hm => (hBpos m).le) hlmem
    exact (hBbound l a rho ha0 ha).trans hle
  have hprod := norm_iteratedDeriv_mul_le_brrsStationaryLeibnizConstant
    (n := k) hfixed hphysical hA.le hB'.le
    (fun l hl => hAbound l (hl.trans hk) rho hrho) hBuniform
  have hfactorfun : (fun u : Real =>
      brrsStationaryWaveRadialCoefficient Phi d part a u) =
      fun u : Real => fixed u * physical u := by
    funext u
    dsimp [fixed, physical]
    unfold brrsStationaryWaveRadialCoefficient
      brrsStationaryWaveRadialFixedFactor
    ring
  rw [hfactorfun]
  have hCbound : brrsStationaryLeibnizConstant k A B' ≤ C := by
    unfold C
    have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    exact Finset.single_le_sum
      (fun l hl => brrsStationaryLeibnizConstant_nonneg l hA.le hB'.le) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real => fixed u * physical u) rho‖ ≤
        brrsStationaryLeibnizConstant k A B' := hprod
    _ ≤ C := hCbound
    _ ≤ C + 1 := by linarith

/-- Compact-radius nonstationary phase with a constant uniform in the
physical radius.  This is the missing inner-region counterpart to the
high-radius stationary estimate: when the temporal carrier is large, no
stationary point can occur while `0 ≤ a ≤ 16`. -/
theorem exists_norm_intervalIntegral_brrsStationaryWaveRadialCoefficient_lowRadius_le
    (Phi : BRRSAnnularCutoff) (d N : Nat) (part : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ a : Real, 0 ≤ a → a ≤ 16 →
      ∀ {freq : Real}, freq ≠ 0 →
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsStationaryWaveRadialCoefficient Phi d part a rho *
          oscillatoryExp freq rho‖ ≤
        (1 / |freq|) ^ N * ((1 - (1 / 32 : Real)) * C) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_uniform_iteratedDeriv_brrsStationaryWaveRadialCoefficient_lowRadius_bound
      Phi d N part
  refine ⟨C, hC, ?_⟩
  intro a ha0 ha freq hfreq
  have hchain := hasOscillatoryIBPChain_iteratedDeriv_of_contDiff
    (brrsStationaryWaveRadialCoefficient Phi d part a)
    (contDiff_brrsStationaryWaveRadialCoefficient Phi d part a)
    (brrsStationaryWaveRadialCoefficient_eventuallyEq_zero_at_lower Phi d part a)
    (brrsStationaryWaveRadialCoefficient_eventuallyEq_zero_at_upper Phi d part a) N
  simpa only [iteratedDeriv_zero] using
    (norm_intervalIntegral_mul_oscillatoryExp_le_iterated
      (F := fun k => iteratedDeriv k
        (brrsStationaryWaveRadialCoefficient Phi d part a))
      (N := N) (by norm_num : (1 / 32 : Real) ≤ 1) hfreq hchain hC.le
      (fun rho hrho => hbound N le_rfl a rho ha0 ha (by
        simpa only [uIcc_of_le (by norm_num : (1 / 32 : Real) ≤ 1)] using hrho)))

/-- The preceding compact-radius estimate in the literal phase of one BRRS
stationary surface-wave component. -/
theorem exists_norm_intervalIntegral_brrsStationaryWaveComponent_lowRadius_le
    (Phi : BRRSAnnularCutoff) (d N : Nat) (part : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ a t : Real, 0 ≤ a → a ≤ 16 →
      brrsSurfaceWavePhase part a + 2 * Real.pi * t ≠ 0 →
      ‖∫ rho in (1 / 32 : Real)..1,
        ((rho ^ (d - 1) : Real) : Complex) *
          (brrsSurfaceWaveTerm d part a rho *
            brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho)‖ ≤
        (1 / |brrsSurfaceWavePhase part a + 2 * Real.pi * t|) ^ N *
          ((1 - (1 / 32 : Real)) * C) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_norm_intervalIntegral_brrsStationaryWaveRadialCoefficient_lowRadius_le
      Phi d N part
  refine ⟨C, hC, ?_⟩
  intro a t ha0 ha hfreq
  rw [intervalIntegral_brrsStationaryWaveComponent_eq_oscillatoryExp]
  exact hbound a ha0 ha hfreq

/-- The literal level-zero kernel on the compact scaled-radius region is a
sum of three uniformly controlled nonstationary carriers.  No cancellation is
discarded in the identity; the displayed majorant is simply the triangle
inequality after the three component estimates. -/
theorem exists_norm_brrsDyadicHalfWaveKernel_levelZero_lowRadius_threePhase_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ t : Real, ∀ x : Euclidean d,
      ‖x‖ ≤ 16 →
      brrsSurfaceWavePhase .outgoing ‖x‖ + 2 * Real.pi * t ≠ 0 →
      brrsSurfaceWavePhase .incoming ‖x‖ + 2 * Real.pi * t ≠ 0 →
      brrsSurfaceWavePhase .middle ‖x‖ + 2 * Real.pi * t ≠ 0 →
      ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x‖ ≤
        (1 - (1 / 32 : Real)) * C *
          ((1 / |brrsSurfaceWavePhase .outgoing ‖x‖ + 2 * Real.pi * t|) ^ N +
            (1 / |brrsSurfaceWavePhase .incoming ‖x‖ + 2 * Real.pi * t|) ^ N +
              (1 / |brrsSurfaceWavePhase .middle ‖x‖ + 2 * Real.pi * t|) ^ N) := by
  obtain ⟨Cout, hCout, hout⟩ :=
    exists_norm_intervalIntegral_brrsStationaryWaveComponent_lowRadius_le
      Phi d N .outgoing
  obtain ⟨Cin, hCin, hin⟩ :=
    exists_norm_intervalIntegral_brrsStationaryWaveComponent_lowRadius_le
      Phi d N .incoming
  obtain ⟨Cmid, hCmid, hmid⟩ :=
    exists_norm_intervalIntegral_brrsStationaryWaveComponent_lowRadius_le
      Phi d N .middle
  let C : Real := Cout + Cin + Cmid
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro t x hx houtfreq hinfreq hmidfreq
  have hx0 : 0 ≤ ‖x‖ := norm_nonneg _
  let Iout : Complex := brrsStationaryWaveComponentIntegral Phi d .outgoing ‖x‖ t
  let Iin : Complex := brrsStationaryWaveComponentIntegral Phi d .incoming ‖x‖ t
  let Imid : Complex := brrsStationaryWaveComponentIntegral Phi d .middle ‖x‖ t
  have hsplit :
      (brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x =
        Iout + Iin + Imid := by
    simpa only [Iout, Iin, Imid, brrsStationaryWaveComponentIntegral] using
      brrsDyadicHalfWaveKernel_eq_levelZero_sum_stationaryWaveComponents hd Phi t x
  have hCoutle : Cout ≤ C := by
    dsimp [C]
    linarith
  have hCinle : Cin ≤ C := by
    dsimp [C]
    linarith
  have hCmidle : Cmid ≤ C := by
    dsimp [C]
    linarith
  have hIout : ‖Iout‖ ≤
      (1 / |brrsSurfaceWavePhase .outgoing ‖x‖ + 2 * Real.pi * t|) ^ N *
        ((1 - (1 / 32 : Real)) * C) := by
    dsimp [Iout]
    refine (hout ‖x‖ t hx0 hx houtfreq).trans ?_
    apply mul_le_mul_of_nonneg_left
    · apply mul_le_mul_of_nonneg_left hCoutle
      norm_num
    · positivity
  have hIin : ‖Iin‖ ≤
      (1 / |brrsSurfaceWavePhase .incoming ‖x‖ + 2 * Real.pi * t|) ^ N *
        ((1 - (1 / 32 : Real)) * C) := by
    dsimp [Iin]
    refine (hin ‖x‖ t hx0 hx hinfreq).trans ?_
    apply mul_le_mul_of_nonneg_left
    · apply mul_le_mul_of_nonneg_left hCinle
      norm_num
    · positivity
  have hImid : ‖Imid‖ ≤
      (1 / |brrsSurfaceWavePhase .middle ‖x‖ + 2 * Real.pi * t|) ^ N *
        ((1 - (1 / 32 : Real)) * C) := by
    dsimp [Imid]
    refine (hmid ‖x‖ t hx0 hx hmidfreq).trans ?_
    apply mul_le_mul_of_nonneg_left
    · apply mul_le_mul_of_nonneg_left hCmidle
      norm_num
    · positivity
  rw [hsplit]
  calc
    ‖Iout + Iin + Imid‖ ≤ ‖Iout + Iin‖ + ‖Imid‖ := norm_add_le _ _
    _ ≤ (‖Iout‖ + ‖Iin‖) + ‖Imid‖ := by
      gcongr
      exact norm_add_le _ _
    _ ≤
        ((1 / |brrsSurfaceWavePhase .outgoing ‖x‖ + 2 * Real.pi * t|) ^ N *
          ((1 - (1 / 32 : Real)) * C) +
          (1 / |brrsSurfaceWavePhase .incoming ‖x‖ + 2 * Real.pi * t|) ^ N *
            ((1 - (1 / 32 : Real)) * C)) +
          (1 / |brrsSurfaceWavePhase .middle ‖x‖ + 2 * Real.pi * t|) ^ N *
            ((1 - (1 / 32 : Real)) * C) := by
      gcongr
    _ = (1 - (1 / 32 : Real)) * C *
        ((1 / |brrsSurfaceWavePhase .outgoing ‖x‖ + 2 * Real.pi * t|) ^ N +
          (1 / |brrsSurfaceWavePhase .incoming ‖x‖ + 2 * Real.pi * t|) ^ N +
            (1 / |brrsSurfaceWavePhase .middle ‖x‖ + 2 * Real.pi * t|) ^ N) := by
      ring

/-- At compact scaled radius, a sufficiently large positive level-zero time
is uniformly nonstationary for all three surface-wave carriers.  This gives
the rapid time decay needed for the inner spatial portion of the BRRS test
packet. -/
theorem exists_norm_brrsDyadicHalfWaveKernel_levelZero_lowRadius_largeTime_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ t : Real, ∀ x : Euclidean d,
      32 ≤ t → ‖x‖ ≤ 16 →
      ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x‖ ≤
        3 * ((1 - (1 / 32 : Real)) * C) * (1 / t) ^ N := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_brrsDyadicHalfWaveKernel_levelZero_lowRadius_threePhase_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro t x ht hx
  have htpos : 0 < t := by linarith
  have hx0 : 0 ≤ ‖x‖ := norm_nonneg _
  have hsubpos : 0 ≤ t - ‖x‖ := by linarith
  have hphaseout :
      brrsSurfaceWavePhase .outgoing ‖x‖ + 2 * Real.pi * t =
        2 * Real.pi * (t - ‖x‖) := by
    simp only [brrsSurfaceWavePhase]
    ring
  have hphasein :
      brrsSurfaceWavePhase .incoming ‖x‖ + 2 * Real.pi * t =
        2 * Real.pi * (t + ‖x‖) := by
    simp only [brrsSurfaceWavePhase]
    ring
  have hphasemid :
      brrsSurfaceWavePhase .middle ‖x‖ + 2 * Real.pi * t =
        2 * Real.pi * t := by
    simp only [brrsSurfaceWavePhase]
    ring
  have htwole : (2 : Real) ≤ 2 * Real.pi := by
    nlinarith [Real.pi_gt_three]
  have houtbase : t ≤ 2 * Real.pi * (t - ‖x‖) := by
    have hhalf : t ≤ 2 * (t - ‖x‖) := by linarith
    calc
      t ≤ 2 * (t - ‖x‖) := hhalf
      _ ≤ (2 * Real.pi) * (t - ‖x‖) :=
        mul_le_mul_of_nonneg_right htwole hsubpos
      _ = 2 * Real.pi * (t - ‖x‖) := by ring
  have hinbase : t ≤ 2 * Real.pi * (t + ‖x‖) := by
    have hsumpos : 0 ≤ t + ‖x‖ := by linarith
    calc
      t ≤ t + ‖x‖ := by linarith
      _ ≤ (2 * Real.pi) * (t + ‖x‖) := by
        exact le_mul_of_one_le_left hsumpos (by linarith [htwole])
      _ = 2 * Real.pi * (t + ‖x‖) := by ring
  have hmidbase : t ≤ 2 * Real.pi * t := by
    exact le_mul_of_one_le_left htpos.le (by linarith [htwole])
  have houtdom : t ≤
      |brrsSurfaceWavePhase .outgoing ‖x‖ + 2 * Real.pi * t| := by
    rw [hphaseout, abs_of_nonneg (by positivity)]
    exact houtbase
  have hindom : t ≤
      |brrsSurfaceWavePhase .incoming ‖x‖ + 2 * Real.pi * t| := by
    rw [hphasein, abs_of_nonneg (by positivity)]
    exact hinbase
  have hmiddom : t ≤
      |brrsSurfaceWavePhase .middle ‖x‖ + 2 * Real.pi * t| := by
    rw [hphasemid, abs_of_nonneg (by positivity)]
    exact hmidbase
  have houtfreq : brrsSurfaceWavePhase .outgoing ‖x‖ + 2 * Real.pi * t ≠ 0 := by
    intro hzero
    rw [hzero] at houtdom
    linarith
  have hinfreq : brrsSurfaceWavePhase .incoming ‖x‖ + 2 * Real.pi * t ≠ 0 := by
    intro hzero
    rw [hzero] at hindom
    linarith
  have hmidfreq : brrsSurfaceWavePhase .middle ‖x‖ + 2 * Real.pi * t ≠ 0 := by
    intro hzero
    rw [hzero] at hmiddom
    linarith
  have houtpow :
      (1 / |brrsSurfaceWavePhase .outgoing ‖x‖ + 2 * Real.pi * t|) ^ N ≤
        (1 / t) ^ N := by
    exact pow_le_pow_left₀ (by positivity)
      (one_div_le_one_div_of_le htpos houtdom) _
  have hinpow :
      (1 / |brrsSurfaceWavePhase .incoming ‖x‖ + 2 * Real.pi * t|) ^ N ≤
        (1 / t) ^ N := by
    exact pow_le_pow_left₀ (by positivity)
      (one_div_le_one_div_of_le htpos hindom) _
  have hmidpow :
      (1 / |brrsSurfaceWavePhase .middle ‖x‖ + 2 * Real.pi * t|) ^ N ≤
        (1 / t) ^ N := by
    exact pow_le_pow_left₀ (by positivity)
      (one_div_le_one_div_of_le htpos hmiddom) _
  have hkernel := hprofile t x hx houtfreq hinfreq hmidfreq
  calc
    ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x‖ ≤
        (1 - (1 / 32 : Real)) * C *
          ((1 / |brrsSurfaceWavePhase .outgoing ‖x‖ + 2 * Real.pi * t|) ^ N +
            (1 / |brrsSurfaceWavePhase .incoming ‖x‖ + 2 * Real.pi * t|) ^ N +
              (1 / |brrsSurfaceWavePhase .middle ‖x‖ + 2 * Real.pi * t|) ^ N) :=
      hkernel
    _ ≤ (1 - (1 / 32 : Real)) * C *
        ((1 / t) ^ N + (1 / t) ^ N + (1 / t) ^ N) := by
      gcongr
    _ = 3 * ((1 - (1 / 32 : Real)) * C) * (1 / t) ^ N := by
      ring

/-- The compact scaled-radius portion of the literal adjoint test packet has
the exact rapidly decaying large-frequency bound inherited from the preceding
level-zero nonstationary estimate.  This is an actual packet estimate rather
than an abstract Schwartz bound; only its final normalization to the BRRS
Sobolev exponent remains. -/
theorem exists_norm_brrsPositiveRadialHalfWaveTestPacket_lowScaledRadius_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ referenceTime : Real, ∀ x : Euclidean d,
      5 ≤ j → referenceTime ∈ Icc (1 : Real) 2 →
      ((2 : Real) ^ j) * ‖x‖ ≤ 16 →
      ‖brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime x‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ *
          (3 * ((1 - (1 / 32 : Real)) * C) *
            (1 / (((2 : Real) ^ j) * referenceTime)) ^ N) := by
  obtain ⟨C, hC, hlevel⟩ :=
    exists_norm_brrsDyadicHalfWaveKernel_levelZero_lowRadius_largeTime_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j referenceTime x hj href hx
  let q : Real := (2 : Real) ^ j
  have hqpos : 0 < q := by
    dsimp only [q]
    positivity
  have hqge : 32 ≤ q := by
    dsimp only [q]
    calc
      (32 : Real) = 2 ^ 5 := by norm_num
      _ ≤ 2 ^ j := by exact pow_le_pow_right₀ (by norm_num) hj
  have htime : 32 ≤ q * referenceTime := by
    calc
      (32 : Real) = 32 * 1 := by ring
      _ ≤ q * referenceTime := mul_le_mul hqge href.1 (by norm_num) hqpos.le
  have hscaledRadius : ‖q • (-x)‖ ≤ 16 := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hqpos, norm_neg]
    simpa only [q] using hx
  have hkernel := hlevel (q * referenceTime) (q • (-x)) htime hscaledRadius
  rw [brrsPositiveRadialHalfWaveTestPacket_eq_star_neg_halfWaveKernel]
  change ‖star ((brrsDyadicHalfWaveKernel Phi j referenceTime : Euclidean d → Complex)
    (-x))‖ ≤ _
  rw [norm_star, brrsDyadicHalfWaveKernel_eq_levelZero_scaled_general,
    norm_smul]
  simpa only [q] using
    (mul_le_mul_of_nonneg_left hkernel (norm_nonneg _))

/-- All derivatives of the literal two-radius stationary coefficient are
uniformly bounded when both physical radii lie in the compact low-radius
region. -/
theorem exists_uniform_iteratedDeriv_brrsTwoRadiusStationaryCoefficient_lowLow_bound
    (Phi : BRRSAnnularCutoff) (d N : Nat)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ r s rho : Real,
      0 ≤ r → r ≤ 16 → 0 ≤ s → s ≤ 16 →
      rho ∈ Icc (1 / 32 : Real) 1 →
        ‖iteratedDeriv k (fun u : Real =>
          brrsTwoRadiusStationaryCoefficient Phi d partR partS r s u) rho‖ ≤ C := by
  choose A hApos hAbound using fun k : Nat =>
    exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_lowRadius_bound d k partR
  obtain ⟨B, hB, hBbound⟩ :=
    exists_uniform_iteratedDeriv_brrsStationaryWaveRadialCoefficient_lowRadius_bound
      Phi d N partS
  let A' : Real := ∑ k ∈ Finset.range (N + 1), A k
  have hA' : 0 < A' := by
    have hzero : 0 ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    have hle : A 0 ≤ A' := by
      dsimp [A']
      exact Finset.single_le_sum (fun k hk => (hApos k).le) hzero
    exact lt_of_lt_of_le (hApos 0) hle
  let C : Real := ∑ l ∈ Finset.range (N + 1),
    brrsStationaryLeibnizConstant l A' B
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact brrsStationaryLeibnizConstant_nonneg l hA'.le hB.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk r s rho hr0 hr hs0 hs hrho
  let left : Real → Complex := fun u : Real =>
    brrsSurfaceWaveAmplitude d partR r u
  let right : Real → Complex := fun u : Real =>
    brrsStationaryWaveRadialCoefficient Phi d partS s u
  have hleft : ContDiff Real (⊤ : ENat) left := by
    dsimp [left]
    exact contDiff_brrsSurfaceWaveAmplitude d partR r
  have hright : ContDiff Real (⊤ : ENat) right := by
    dsimp [right]
    exact contDiff_brrsStationaryWaveRadialCoefficient Phi d partS s
  have hleftbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l left rho‖ ≤ A' := by
    intro l hl
    have hlmem : l ∈ Finset.range (N + 1) :=
      Finset.mem_range.mpr (by omega)
    have hle : A l ≤ A' := by
      dsimp [A']
      exact Finset.single_le_sum (fun m hm => (hApos m).le) hlmem
    exact (hAbound l r rho hr0 hr).trans hle
  have hrightbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l right rho‖ ≤ B := by
    intro l hl
    exact hBbound l (hl.trans hk) s rho hs0 hs hrho
  have hprod := norm_iteratedDeriv_mul_le_brrsStationaryLeibnizConstant
    (n := k) hleft hright hA'.le hB.le hleftbound hrightbound
  have hfactorfun : (fun u : Real =>
      brrsTwoRadiusStationaryCoefficient Phi d partR partS r s u) =
      fun u : Real => left u * right u := by
    funext u
    dsimp [left, right]
    unfold brrsTwoRadiusStationaryCoefficient
      brrsStationaryWaveRadialCoefficient
    ring
  rw [hfactorfun]
  have hCbound : brrsStationaryLeibnizConstant k A' B ≤ C := by
    unfold C
    have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    exact Finset.single_le_sum
      (fun l hl => brrsStationaryLeibnizConstant_nonneg l hA'.le hB.le) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real => left u * right u) rho‖ ≤
        brrsStationaryLeibnizConstant k A' B := hprod
    _ ≤ C := hCbound
    _ ≤ C + 1 := by linarith

/-- Compact nonstationary phase for a two-radius stationary component.  No
spatial half-density occurs here because both radii are bounded. -/
theorem exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_lowLow_le
    {d N : Nat} (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ r s : Real, 0 ≤ r → r ≤ 16 → 0 ≤ s → s ≤ 16 →
      ∀ {freq : Real}, freq ≠ 0 →
        ‖∫ rho in (1 / 32 : Real)..1,
          brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
            oscillatoryExp freq rho‖ ≤
          (1 / |freq|) ^ N * ((1 - (1 / 32 : Real)) * C) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_uniform_iteratedDeriv_brrsTwoRadiusStationaryCoefficient_lowLow_bound
      Phi d N partR partS
  refine ⟨C, hC, ?_⟩
  intro r s hr0 hr hs0 hs freq hfreq
  have hchain := hasOscillatoryIBPChain_iteratedDeriv_of_contDiff
    (fun rho : Real => brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho)
    (contDiff_brrsTwoRadiusStationaryCoefficient Phi d partR partS r s)
    (brrsTwoRadiusStationaryCoefficient_eventuallyEq_zero_at_lower
      Phi d partR partS r s)
    (brrsTwoRadiusStationaryCoefficient_eventuallyEq_zero_at_upper
      Phi d partR partS r s) N
  simpa only [iteratedDeriv_zero] using
    (norm_intervalIntegral_mul_oscillatoryExp_le_iterated
      (F := fun k => iteratedDeriv k
        (fun rho : Real =>
          brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho))
      (N := N) (by norm_num : (1 / 32 : Real) ≤ 1) hfreq hchain hC.le
      (fun rho hrho => hbound N le_rfl r s rho hr0 hr hs0 hs hrho))

/-- The compact low--low coefficient also has its uniform cone bound, which
is the zero-frequency half of the rapid-profile estimate. -/
theorem exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_lowLow_uniform_le
    {d : Nat} (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ r s freq : Real,
      0 ≤ r → r ≤ 16 → 0 ≤ s → s ≤ 16 →
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
          oscillatoryExp freq rho‖ ≤ (1 - (1 / 32 : Real)) * C := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_uniform_iteratedDeriv_brrsTwoRadiusStationaryCoefficient_lowLow_bound
      Phi d 0 partR partS
  refine ⟨C, hC, ?_⟩
  intro r s freq hr0 hr hs0 hs
  calc
    ‖∫ rho in (1 / 32 : Real)..1,
      brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
        oscillatoryExp freq rho‖ ≤ C * |1 - (1 / 32 : Real)| := by
      apply intervalIntegral.norm_integral_le_of_norm_le_const
      intro rho hrho
      have hrho' : rho ∈ Icc (1 / 32 : Real) 1 := by
        rw [uIoc_of_le (by norm_num : (1 / 32 : Real) ≤ 1)] at hrho
        exact ⟨hrho.1.le, hrho.2⟩
      rw [norm_mul, norm_oscillatoryExp, mul_one]
      exact hbound 0 le_rfl r s rho hr0 hr hs0 hs hrho'
    _ = (1 - (1 / 32 : Real)) * C := by
      rw [abs_of_nonneg (by norm_num : (0 : Real) ≤ 1 - 1 / 32)]
      ring

/-- Combining compact nonstationary phase and the cone bound gives a single
rapid profile for every low--low stationary component. -/
theorem exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_lowLow_profile_le
    {d N : Nat} (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ r s freq : Real,
      0 ≤ r → r ≤ 16 → 0 ≤ s → s ≤ 16 →
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
          oscillatoryExp freq rho‖ ≤
        (1 - (1 / 32 : Real)) * C * brrsStationaryRapidProfile N freq := by
  obtain ⟨C0, hC0, huniform⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_lowLow_uniform_le
      Phi partR partS
  obtain ⟨C1, hC1, hdecay⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_lowLow_le
      (d := d) (N := N) Phi partR partS
  let C : Real := C0 + C1
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro r s freq hr0 hr hs0 hs
  let A : Real := (1 - (1 / 32 : Real)) * C
  have hAnonneg : 0 ≤ A := by
    dsimp [A]
    positivity
  have hC0le : C0 ≤ C := by
    dsimp [C]
    linarith
  have hC1le : C1 ≤ C := by
    dsimp [C]
    linarith
  change ‖∫ rho in (1 / 32 : Real)..1,
      brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
        oscillatoryExp freq rho‖ ≤ A * brrsStationaryRapidProfile N freq
  by_cases hfreq : freq = 0
  · have hcomp : (1 - (1 / 32 : Real)) * C0 ≤ A := by
      dsimp [A]
      exact mul_le_mul_of_nonneg_left hC0le (by norm_num)
    simpa [brrsStationaryRapidProfile, hfreq] using
      (huniform r s 0 hr0 hr hs0 hs).trans hcomp
  · rw [brrsStationaryRapidProfile, if_neg hfreq]
    let z : Real := (1 / |freq|) ^ N
    have huniform' : ‖∫ rho in (1 / 32 : Real)..1,
        brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
          oscillatoryExp freq rho‖ ≤ A := by
      refine (huniform r s freq hr0 hr hs0 hs).trans ?_
      dsimp [A]
      exact mul_le_mul_of_nonneg_left hC0le (by norm_num)
    have hdecay' : ‖∫ rho in (1 / 32 : Real)..1,
        brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
          oscillatoryExp freq rho‖ ≤ z * A := by
      dsimp [z, A]
      refine (hdecay r s hr0 hr hs0 hs hfreq).trans ?_
      exact mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hC1le (by norm_num))
        (pow_nonneg (by positivity) _)
    calc
      ‖∫ rho in (1 / 32 : Real)..1,
          brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
            oscillatoryExp freq rho‖ ≤ min A (z * A) := le_min huniform' hdecay'
      _ = A * min 1 z := by
        calc
          min A (z * A) = min (A * 1) (A * z) := by
            congr 1 <;> ring
          _ = A * min 1 z := (mul_min_of_nonneg 1 z hAnonneg).symm
      _ = A * min 1 ((1 / |freq|) ^ N) := by rfl

/-- The low--low rapid estimate expressed for the literal stationary
component, with its exact phase retained. -/
theorem exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowLow_profile_le
    {d N : Nat} (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real,
      0 ≤ r → r ≤ 16 → 0 ≤ s → s ≤ 16 →
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d partR partS r s t‖ ≤
        (1 - (1 / 32 : Real)) * C *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase partR r +
              brrsSurfaceWavePhase partS s + 2 * Real.pi * t) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_lowLow_profile_le
      (d := d) (N := N) Phi partR partS
  refine ⟨C, hC, ?_⟩
  intro r s t hr0 hr hs0 hs
  rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
  exact hbound r s
    (brrsSurfaceWavePhase partR r +
      brrsSurfaceWavePhase partS s + 2 * Real.pi * t) hr0 hr hs0 hs

/-- The nine literal carrier profiles of the two-radius stationary kernel.
Keeping this finite sum named lets compact-radius and mixed-radius estimates
share the same exact all-nine bookkeeping. -/
noncomputable def brrsTwoRadiusNinePhaseProfile
    (N : Nat) (r s t : Real) : Real :=
  ((brrsStationaryRapidProfile N
      (brrsSurfaceWavePhase .outgoing r +
        brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) +
    brrsStationaryRapidProfile N
      (brrsSurfaceWavePhase .outgoing r +
        brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) +
      brrsStationaryRapidProfile N
        (brrsSurfaceWavePhase .outgoing r +
          brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)) +
    ((brrsStationaryRapidProfile N
        (brrsSurfaceWavePhase .incoming r +
          brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) +
      brrsStationaryRapidProfile N
        (brrsSurfaceWavePhase .incoming r +
          brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) +
        brrsStationaryRapidProfile N
          (brrsSurfaceWavePhase .incoming r +
            brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)) +
      (brrsStationaryRapidProfile N
          (brrsSurfaceWavePhase .middle r +
            brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) +
        brrsStationaryRapidProfile N
          (brrsSurfaceWavePhase .middle r +
            brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) +
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t))))

/-- Every all-nine stationary phase profile is nonnegative. -/
theorem brrsTwoRadiusNinePhaseProfile_nonneg
    (N : Nat) (r s t : Real) :
    0 ≤ brrsTwoRadiusNinePhaseProfile N r s t := by
  unfold brrsTwoRadiusNinePhaseProfile
  repeat' apply add_nonneg
  all_goals exact brrsStationaryRapidProfile_nonneg N _

/-- On the compact output cell, each of the nine literal stationary phases
is a unit-scale translate of one of the three source-time phases
`t - s`, `t + s`, and `t`.  Cubic rapid decay therefore reduces the complete
profile to three scale-normalized Japanese brackets. -/
theorem brrsTwoRadiusNinePhaseProfile_I0_le_three_cubic
    (r s t : Real) (hr0 : 0 ≤ r) (hr : r ≤ 1) :
    brrsTwoRadiusNinePhaseProfile 3 r s t ≤
      192 * (brrsCubicJapaneseRealProfile (t - s) +
        brrsCubicJapaneseRealProfile (t + s) +
          brrsCubicJapaneseRealProfile t) := by
  have hneg : |-r| ≤ 1 := by
    rw [abs_neg, abs_of_nonneg hr0]
    exact hr
  have hpos : |r| ≤ 1 := by
    rw [abs_of_nonneg hr0]
    exact hr
  have hzero : |(0 : Real)| ≤ 1 := by norm_num
  have hoo := brrsStationaryRapidProfile_three_twoPi_smallShift_le
    (t - s) (-r) hneg
  have hoi := brrsStationaryRapidProfile_three_twoPi_smallShift_le
    (t + s) (-r) hneg
  have hom := brrsStationaryRapidProfile_three_twoPi_smallShift_le
    t (-r) hneg
  have hio := brrsStationaryRapidProfile_three_twoPi_smallShift_le
    (t - s) r hpos
  have hii := brrsStationaryRapidProfile_three_twoPi_smallShift_le
    (t + s) r hpos
  have him := brrsStationaryRapidProfile_three_twoPi_smallShift_le
    t r hpos
  have hmo := brrsStationaryRapidProfile_three_twoPi_smallShift_le
    (t - s) 0 hzero
  have hmi := brrsStationaryRapidProfile_three_twoPi_smallShift_le
    (t + s) 0 hzero
  have hmm := brrsStationaryRapidProfile_three_twoPi_smallShift_le
    t 0 hzero
  have hoo' :
      brrsStationaryRapidProfile 3
        (brrsSurfaceWavePhase .outgoing r +
          brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) ≤
        64 * brrsCubicJapaneseRealProfile (t - s) := by
    convert hoo using 1; simp only [brrsSurfaceWavePhase]; ring
  have hoi' :
      brrsStationaryRapidProfile 3
        (brrsSurfaceWavePhase .outgoing r +
          brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) ≤
        64 * brrsCubicJapaneseRealProfile (t + s) := by
    convert hoi using 1; simp only [brrsSurfaceWavePhase]; ring
  have hom' :
      brrsStationaryRapidProfile 3
        (brrsSurfaceWavePhase .outgoing r +
          brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) ≤
        64 * brrsCubicJapaneseRealProfile t := by
    convert hom using 1; simp only [brrsSurfaceWavePhase]; ring
  have hio' :
      brrsStationaryRapidProfile 3
        (brrsSurfaceWavePhase .incoming r +
          brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) ≤
        64 * brrsCubicJapaneseRealProfile (t - s) := by
    convert hio using 1; simp only [brrsSurfaceWavePhase]; ring
  have hii' :
      brrsStationaryRapidProfile 3
        (brrsSurfaceWavePhase .incoming r +
          brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) ≤
        64 * brrsCubicJapaneseRealProfile (t + s) := by
    convert hii using 1; simp only [brrsSurfaceWavePhase]; ring
  have him' :
      brrsStationaryRapidProfile 3
        (brrsSurfaceWavePhase .incoming r +
          brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) ≤
        64 * brrsCubicJapaneseRealProfile t := by
    convert him using 1; simp only [brrsSurfaceWavePhase]; ring
  have hmo' :
      brrsStationaryRapidProfile 3
        (brrsSurfaceWavePhase .middle r +
          brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) ≤
        64 * brrsCubicJapaneseRealProfile (t - s) := by
    convert hmo using 1; simp only [brrsSurfaceWavePhase]; ring
  have hmi' :
      brrsStationaryRapidProfile 3
        (brrsSurfaceWavePhase .middle r +
          brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) ≤
        64 * brrsCubicJapaneseRealProfile (t + s) := by
    convert hmi using 1; simp only [brrsSurfaceWavePhase]; ring
  have hmm' :
      brrsStationaryRapidProfile 3
        (brrsSurfaceWavePhase .middle r +
          brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) ≤
        64 * brrsCubicJapaneseRealProfile t := by
    convert hmm using 1; simp only [brrsSurfaceWavePhase]; ring
  unfold brrsTwoRadiusNinePhaseProfile
  linarith

/-- `ENNReal` form of the compact all-nine phase reduction.  This is the
version that can be multiplied by a nonnegative radial source density and
integrated with Tonelli's theorem. -/
theorem ennreal_brrsTwoRadiusNinePhaseProfile_I0_le_three_cubic
    (r s t : Real) (hr0 : 0 ≤ r) (hr : r ≤ 1) :
    ENNReal.ofReal (brrsTwoRadiusNinePhaseProfile 3 r s t) ≤
      192 * (brrsCubicJapaneseProfile (t - s) +
        brrsCubicJapaneseProfile (t + s) + brrsCubicJapaneseProfile t) := by
  have hbase := brrsTwoRadiusNinePhaseProfile_I0_le_three_cubic r s t hr0 hr
  have hminus : 0 ≤ brrsCubicJapaneseRealProfile (t - s) :=
    brrsCubicJapaneseRealProfile_nonneg _
  have hplus : 0 ≤ brrsCubicJapaneseRealProfile (t + s) :=
    brrsCubicJapaneseRealProfile_nonneg _
  have hmiddle : 0 ≤ brrsCubicJapaneseRealProfile t :=
    brrsCubicJapaneseRealProfile_nonneg _
  calc
    ENNReal.ofReal (brrsTwoRadiusNinePhaseProfile 3 r s t) ≤
        ENNReal.ofReal
          (192 * (brrsCubicJapaneseRealProfile (t - s) +
            brrsCubicJapaneseRealProfile (t + s) +
              brrsCubicJapaneseRealProfile t)) :=
      ENNReal.ofReal_le_ofReal hbase
    _ = 192 * (brrsCubicJapaneseProfile (t - s) +
        brrsCubicJapaneseProfile (t + s) + brrsCubicJapaneseProfile t) := by
      rw [ENNReal.ofReal_mul (by norm_num),
        ENNReal.ofReal_add (add_nonneg hminus hplus) hmiddle,
        ENNReal.ofReal_add hminus hplus]
      norm_num [brrsCubicJapaneseProfile, brrsCubicJapaneseRealProfile]

/-- The compact-source branch of the literal all-nine `I₀` phase majorant
is an estimate by the mass-normalized cubic convolution API.  The source is
restricted exactly to `0 < q s ≤ 16`; no claim about the complementary
source tail or the full half-wave operator is made here. -/
theorem brrs_I0_ninePhase_compactSource_lintegral_normalizedCubic_le
    {q r t : Real} (_hq : 0 < q) (hr0 : 0 ≤ q * r) (hr : q * r ≤ 1)
    (g : Real → ENNReal) (hg : Measurable g) :
    ENNReal.ofReal q *
        (∫⁻ s in Ioc (0 : Real) (16 * q⁻¹),
          ENNReal.ofReal
            (brrsTwoRadiusNinePhaseProfile 3 (q * r) (q * s) (q * t)) * g s) ≤
      192 *
        (brrsOneDimProfileConvolution (brrsNormalizedScaledCubicProfile q)
            (brrsI0CompactSourceProfile q g) t +
          brrsOneDimProfileConvolution (brrsNormalizedScaledCubicProfile q)
            (brrsReflectProfile (brrsI0CompactSourceProfile q g)) t +
            brrsNormalizedScaledCubicProfile q t *
              ∫⁻ s : Real, brrsI0CompactSourceProfile q g s) := by
  classical
  let S : Set Real := Ioc (0 : Real) (16 * q⁻¹)
  let omega : Real → ENNReal := brrsNormalizedScaledCubicProfile q
  let gS : Real → ENNReal := S.indicator g
  let P : Real → ENNReal := fun s =>
    ENNReal.ofReal
      (brrsTwoRadiusNinePhaseProfile 3 (q * r) (q * s) (q * t))
  let Kminus : Real → ENNReal := fun s => omega (t - s) * g s
  let Kplus : Real → ENNReal := fun s => omega (t + s) * g s
  let Kzero : Real → ENNReal := fun s => omega t * g s
  have hS : MeasurableSet S := measurableSet_Ioc
  have hP : Measurable P := by
    have hphase (partR partS : BRRSSurfaceWavePart) :
        Measurable (fun s : Real =>
          brrsSurfaceWavePhase partR (q * r) +
            brrsSurfaceWavePhase partS (q * s) + 2 * Real.pi * (q * t)) := by
      cases partR <;> cases partS <;>
        simp only [brrsSurfaceWavePhase, add_zero, measurable_const, zero_add] <;> fun_prop
    have hsum : Measurable (fun s : Real =>
        brrsTwoRadiusNinePhaseProfile 3 (q * r) (q * s) (q * t)) := by
      unfold brrsTwoRadiusNinePhaseProfile
      repeat' apply Measurable.add
      all_goals
        exact (measurable_brrsStationaryRapidProfile 3).comp (hphase _ _)
    dsimp only [P]
    exact ENNReal.continuous_ofReal.measurable.comp hsum
  have hPg : Measurable (fun s : Real => P s * g s) := hP.mul hg
  have homega : Measurable omega := measurable_brrsNormalizedScaledCubicProfile q
  have hKminus : Measurable Kminus :=
    (homega.comp (measurable_const.sub measurable_id)).mul hg
  have hKplus : Measurable Kplus :=
    (homega.comp (measurable_const.add measurable_id)).mul hg
  have hKzero : Measurable Kzero := measurable_const.mul hg
  have hphase (s : Real) :
      P s ≤ 192 *
        (brrsCubicJapaneseProfile (q * (t - s)) +
          brrsCubicJapaneseProfile (q * (t + s)) +
            brrsCubicJapaneseProfile (q * t)) := by
    dsimp only [P]
    simpa only [mul_sub, mul_add] using
      (ennreal_brrsTwoRadiusNinePhaseProfile_I0_le_three_cubic
        (q * r) (q * s) (q * t) hr0 hr)
  have hpoint (s : Real) :
      ENNReal.ofReal q * (P s * g s) ≤
        192 * (Kminus s + Kplus s + Kzero s) := by
    have hmul := mul_le_mul_left (hphase s) (ENNReal.ofReal q * g s)
    calc
      ENNReal.ofReal q * (P s * g s) =
          P s * (ENNReal.ofReal q * g s) := by ac_rfl
      _ ≤
          (192 *
            (brrsCubicJapaneseProfile (q * (t - s)) +
              brrsCubicJapaneseProfile (q * (t + s)) +
                brrsCubicJapaneseProfile (q * t))) *
            (ENNReal.ofReal q * g s) := hmul
      _ = 192 * (Kminus s + Kplus s + Kzero s) := by
        dsimp only [Kminus, Kplus, Kzero, omega,
          brrsNormalizedScaledCubicProfile]
        ring
  have hlocal :
      ENNReal.ofReal q * (∫⁻ s in S, P s * g s) ≤
        ∫⁻ s in S, 192 * (Kminus s + Kplus s + Kzero s) := by
    calc
      ENNReal.ofReal q * (∫⁻ s in S, P s * g s) =
          ∫⁻ s in S, ENNReal.ofReal q * (P s * g s) := by
        symm
        exact lintegral_const_mul (ENNReal.ofReal q) hPg
      _ ≤ ∫⁻ s in S, 192 * (Kminus s + Kplus s + Kzero s) := by
        apply setLIntegral_mono' hS
        intro s _hs
        exact hpoint s
  have hsplit :
      (∫⁻ s in S, 192 * (Kminus s + Kplus s + Kzero s)) =
        192 *
          ((∫⁻ s in S, Kminus s) +
            (∫⁻ s in S, Kplus s) + omega t * ∫⁻ s in S, g s) := by
    have hsum : Measurable (Kminus + Kplus + Kzero) :=
      (hKminus.add hKplus).add hKzero
    have hconst := @MeasureTheory.lintegral_const_mul Real _
      (volume.restrict S) 192 (Kminus + Kplus + Kzero) hsum
    have hadd := @MeasureTheory.lintegral_add_left Real _
      (volume.restrict S) (Kminus + Kplus) (hKminus.add hKplus) Kzero
    have hadd' := @MeasureTheory.lintegral_add_left Real _
      (volume.restrict S) Kminus hKminus Kplus
    have hzero : (∫⁻ s in S, Kzero s) = omega t * ∫⁻ s in S, g s := by
      dsimp only [Kzero]
      exact @MeasureTheory.lintegral_const_mul Real _ (volume.restrict S)
        (omega t) g hg
    calc
      (∫⁻ s in S, 192 * (Kminus s + Kplus s + Kzero s)) =
          192 * ∫⁻ s in S, Kminus s + Kplus s + Kzero s := by
            simpa [Pi.add_apply] using hconst
      _ = 192 *
          ∫⁻ s in S, (Kminus s + Kplus s) + Kzero s := by
            rfl
      _ = 192 *
          ((∫⁻ s in S, Kminus s + Kplus s) + ∫⁻ s in S, Kzero s) := by
            congr 1
      _ = 192 *
          ((∫⁻ s in S, Kminus s) +
            (∫⁻ s in S, Kplus s) + ∫⁻ s in S, Kzero s) := by
            rw [show (∫⁻ s in S, Kminus s + Kplus s) =
              (∫⁻ s in S, Kminus s) + ∫⁻ s in S, Kplus s by
                simpa [Pi.add_apply] using hadd']
      _ = 192 *
          ((∫⁻ s in S, Kminus s) +
            (∫⁻ s in S, Kplus s) + omega t * ∫⁻ s in S, g s) := by
            rw [hzero]
  have hminus :
      (∫⁻ s in S, Kminus s) =
        brrsOneDimProfileConvolution omega gS t := by
    dsimp only [Kminus]
    symm
    simpa only [gS] using
      (brrsOneDimProfileConvolution_indicator_eq_setLIntegral omega g S hS t)
  have hplus :
      (∫⁻ s in S, Kplus s) =
        brrsOneDimProfileConvolution omega (brrsReflectProfile gS) t := by
    calc
      (∫⁻ s in S, Kplus s) =
          brrsOneDimProfileConvolutionPlus omega gS t := by
        dsimp only [Kplus]
        symm
        simpa only [gS] using
          (brrsOneDimProfileConvolutionPlus_indicator_eq_setLIntegral omega g S hS t)
      _ = brrsOneDimProfileConvolution omega (brrsReflectProfile gS) t :=
        brrsOneDimProfileConvolutionPlus_eq_reflect omega gS t
  have hmass : (∫⁻ s : Real, gS s) = ∫⁻ s in S, g s := by
    dsimp only [gS]
    exact lintegral_indicator hS g
  calc
    ENNReal.ofReal q *
        (∫⁻ s in Ioc (0 : Real) (16 * q⁻¹),
          ENNReal.ofReal
            (brrsTwoRadiusNinePhaseProfile 3 (q * r) (q * s) (q * t)) * g s) =
        ENNReal.ofReal q * (∫⁻ s in S, P s * g s) := by
          rfl
    _ ≤ ∫⁻ s in S, 192 * (Kminus s + Kplus s + Kzero s) := hlocal
    _ = 192 *
        (brrsOneDimProfileConvolution omega gS t +
          brrsOneDimProfileConvolution omega (brrsReflectProfile gS) t +
            omega t * ∫⁻ s : Real, gS s) := by
          rw [hsplit, hminus, hplus, hmass]
    _ = 192 *
        (brrsOneDimProfileConvolution (brrsNormalizedScaledCubicProfile q)
            (brrsI0CompactSourceProfile q g) t +
          brrsOneDimProfileConvolution (brrsNormalizedScaledCubicProfile q)
            (brrsReflectProfile (brrsI0CompactSourceProfile q g)) t +
            brrsNormalizedScaledCubicProfile q t *
              ∫⁻ s : Real, brrsI0CompactSourceProfile q g s) := by
          rfl

/-- A common bound for all nine literal stationary components combines into
the corresponding all-nine bound without discarding the middle terms. -/
theorem norm_brrsTwoRadiusAllStationaryComponentIntegralSum_le_of_component_bounds
    (Phi : BRRSAnnularCutoff) (d N : Nat) (r s t A : Real)
    (hbound : ∀ partR partS : BRRSSurfaceWavePart,
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d partR partS r s t‖ ≤
        A * brrsStationaryRapidProfile N
          (brrsSurfaceWavePhase partR r +
            brrsSurfaceWavePhase partS s + 2 * Real.pi * t)) :
    ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤
      A * brrsTwoRadiusNinePhaseProfile N r s t := by
  let Ioo : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .outgoing r s t
  let Ioi : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .incoming r s t
  let Iom : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .middle r s t
  let Iio : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .outgoing r s t
  let Iii : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .incoming r s t
  let Iim : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .middle r s t
  let Imo : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .middle .outgoing r s t
  let Imi : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .middle .incoming r s t
  let Imm : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .middle .middle r s t
  let Poo : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .outgoing r +
      brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t)
  let Poi : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .outgoing r +
      brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)
  let Pom : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .outgoing r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  let Pio : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .incoming r +
      brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t)
  let Pii : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .incoming r +
      brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)
  let Pim : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .incoming r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  let Pmo : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t)
  let Pmi : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)
  let Pmm : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  have hIoo : ‖Ioo‖ ≤ A * Poo := by
    dsimp [Ioo, Poo]
    exact hbound .outgoing .outgoing
  have hIoi : ‖Ioi‖ ≤ A * Poi := by
    dsimp [Ioi, Poi]
    exact hbound .outgoing .incoming
  have hIom : ‖Iom‖ ≤ A * Pom := by
    dsimp [Iom, Pom]
    exact hbound .outgoing .middle
  have hIio : ‖Iio‖ ≤ A * Pio := by
    dsimp [Iio, Pio]
    exact hbound .incoming .outgoing
  have hIii : ‖Iii‖ ≤ A * Pii := by
    dsimp [Iii, Pii]
    exact hbound .incoming .incoming
  have hIim : ‖Iim‖ ≤ A * Pim := by
    dsimp [Iim, Pim]
    exact hbound .incoming .middle
  have hImo : ‖Imo‖ ≤ A * Pmo := by
    dsimp [Imo, Pmo]
    exact hbound .middle .outgoing
  have hImi : ‖Imi‖ ≤ A * Pmi := by
    dsimp [Imi, Pmi]
    exact hbound .middle .incoming
  have hImm : ‖Imm‖ ≤ A * Pmm := by
    dsimp [Imm, Pmm]
    exact hbound .middle .middle
  change ‖((Ioo + Ioi) + Iom) +
      (((Iio + Iii) + Iim) + ((Imo + Imi) + Imm))‖ ≤
    A * ((Poo + Poi + Pom) + ((Pio + Pii + Pim) + (Pmo + Pmi + Pmm)))
  calc
    ‖((Ioo + Ioi) + Iom) +
        (((Iio + Iii) + Iim) + ((Imo + Imi) + Imm))‖ ≤
        ‖(Ioo + Ioi) + Iom‖ +
          ‖((Iio + Iii) + Iim) + ((Imo + Imi) + Imm)‖ := norm_add_le _ _
    _ ≤ (‖Ioo + Ioi‖ + ‖Iom‖) +
          (‖Iio + Iii‖ + ‖Iim‖ + (‖Imo + Imi‖ + ‖Imm‖)) := by
        apply add_le_add
        · exact norm_add_le _ _
        · calc
            ‖((Iio + Iii) + Iim) + ((Imo + Imi) + Imm)‖ ≤
                ‖(Iio + Iii) + Iim‖ + ‖(Imo + Imi) + Imm‖ := norm_add_le _ _
            _ ≤ (‖Iio + Iii‖ + ‖Iim‖) + (‖Imo + Imi‖ + ‖Imm‖) := by
              gcongr
              · exact norm_add_le _ _
              · exact norm_add_le _ _
    _ ≤ ((‖Ioo‖ + ‖Ioi‖) + ‖Iom‖) +
          ((‖Iio‖ + ‖Iii‖) + ‖Iim‖ + ((‖Imo‖ + ‖Imi‖) + ‖Imm‖)) := by
        gcongr <;> exact norm_add_le _ _
    _ ≤ ((A * Poo + A * Poi) + A * Pom) +
          ((A * Pio + A * Pii) + A * Pim + ((A * Pmo + A * Pmi) + A * Pmm)) := by
        apply add_le_add
        · exact add_le_add (add_le_add hIoo hIoi) hIom
        · exact add_le_add
            (add_le_add (add_le_add hIio hIii) hIim)
            (add_le_add (add_le_add hImo hImi) hImm)
    _ = A * ((Poo + Poi + Pom) + ((Pio + Pii + Pim) + (Pmo + Pmi + Pmm))) := by
        ring

/-- Nine stationary components satisfying one common positive phase majorant
combine with the explicit factor nine.  Unlike the preceding lemma, this
bookkeeping result does not prescribe the phase carrier and can therefore be
used after the middle carriers have been moved onto endpoint phases. -/
theorem norm_brrsTwoRadiusAllStationaryComponentIntegralSum_le_of_component_common_bound
    (Phi : BRRSAnnularCutoff) (d : Nat) (r s t A P : Real)
    (hbound : ∀ partR partS : BRRSSurfaceWavePart,
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d partR partS r s t‖ ≤
        A * P) :
    ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤
      (9 : Real) * A * P := by
  let Ioo : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .outgoing r s t
  let Ioi : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .incoming r s t
  let Iom : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .middle r s t
  let Iio : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .outgoing r s t
  let Iii : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .incoming r s t
  let Iim : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .middle r s t
  let Imo : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .middle .outgoing r s t
  let Imi : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .middle .incoming r s t
  let Imm : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .middle .middle r s t
  have hIoo : ‖Ioo‖ ≤ A * P := by
    dsimp [Ioo]
    exact hbound .outgoing .outgoing
  have hIoi : ‖Ioi‖ ≤ A * P := by
    dsimp [Ioi]
    exact hbound .outgoing .incoming
  have hIom : ‖Iom‖ ≤ A * P := by
    dsimp [Iom]
    exact hbound .outgoing .middle
  have hIio : ‖Iio‖ ≤ A * P := by
    dsimp [Iio]
    exact hbound .incoming .outgoing
  have hIii : ‖Iii‖ ≤ A * P := by
    dsimp [Iii]
    exact hbound .incoming .incoming
  have hIim : ‖Iim‖ ≤ A * P := by
    dsimp [Iim]
    exact hbound .incoming .middle
  have hImo : ‖Imo‖ ≤ A * P := by
    dsimp [Imo]
    exact hbound .middle .outgoing
  have hImi : ‖Imi‖ ≤ A * P := by
    dsimp [Imi]
    exact hbound .middle .incoming
  have hImm : ‖Imm‖ ≤ A * P := by
    dsimp [Imm]
    exact hbound .middle .middle
  change ‖((Ioo + Ioi) + Iom) +
      (((Iio + Iii) + Iim) + ((Imo + Imi) + Imm))‖ ≤
    (9 : Real) * A * P
  calc
    ‖((Ioo + Ioi) + Iom) +
        (((Iio + Iii) + Iim) + ((Imo + Imi) + Imm))‖ ≤
        ‖(Ioo + Ioi) + Iom‖ +
          ‖((Iio + Iii) + Iim) + ((Imo + Imi) + Imm)‖ := norm_add_le _ _
    _ ≤ (‖Ioo‖ + ‖Ioi‖ + ‖Iom‖) +
          (‖Iio‖ + ‖Iii‖ + ‖Iim‖ + (‖Imo‖ + ‖Imi‖ + ‖Imm‖)) := by
      apply add_le_add
      · calc
          ‖(Ioo + Ioi) + Iom‖ ≤ ‖Ioo + Ioi‖ + ‖Iom‖ := norm_add_le _ _
          _ ≤ (‖Ioo‖ + ‖Ioi‖) + ‖Iom‖ := by
            gcongr
            exact norm_add_le _ _
          _ = ‖Ioo‖ + ‖Ioi‖ + ‖Iom‖ := by ring
      · calc
          ‖((Iio + Iii) + Iim) + ((Imo + Imi) + Imm)‖ ≤
              ‖(Iio + Iii) + Iim‖ + ‖(Imo + Imi) + Imm‖ := norm_add_le _ _
          _ ≤ (‖Iio‖ + ‖Iii‖ + ‖Iim‖) + (‖Imo‖ + ‖Imi‖ + ‖Imm‖) := by
            apply add_le_add
            · calc
                ‖(Iio + Iii) + Iim‖ ≤ ‖Iio + Iii‖ + ‖Iim‖ := norm_add_le _ _
                _ ≤ (‖Iio‖ + ‖Iii‖) + ‖Iim‖ := by
                  exact add_le_add (norm_add_le _ _) le_rfl
                _ = ‖Iio‖ + ‖Iii‖ + ‖Iim‖ := by ring
            · calc
                ‖(Imo + Imi) + Imm‖ ≤ ‖Imo + Imi‖ + ‖Imm‖ := norm_add_le _ _
                _ ≤ (‖Imo‖ + ‖Imi‖) + ‖Imm‖ := by
                  exact add_le_add (norm_add_le _ _) le_rfl
                _ = ‖Imo‖ + ‖Imi‖ + ‖Imm‖ := by ring
          _ = ‖Iio‖ + ‖Iii‖ + ‖Iim‖ + (‖Imo‖ + ‖Imi‖ + ‖Imm‖) := by ring
    _ ≤ (A * P + A * P + A * P) +
          (A * P + A * P + A * P + (A * P + A * P + A * P)) := by
      gcongr
    _ = (9 : Real) * A * P := by ring

/-- The literal all-nine two-radius kernel has a rapid phase-profile bound
when both radial variables are in the compact region.  This is the analytic
input missing from the former conditional `I₀` bookkeeping. -/
theorem exists_norm_brrsTwoRadAllStatComponentIntegralSum_lowLow_ninePhase_profile_le
    {d N : Nat} (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real,
      0 ≤ r → r ≤ 16 → 0 ≤ s → s ≤ 16 →
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤
        (1 - (1 / 32 : Real)) * C * brrsTwoRadiusNinePhaseProfile N r s t := by
  obtain ⟨Coo, hCoo, hoo⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowLow_profile_le
      (d := d) (N := N) Phi .outgoing .outgoing
  obtain ⟨Coi, hCoi, hoi⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowLow_profile_le
      (d := d) (N := N) Phi .outgoing .incoming
  obtain ⟨Com, hCom, hom⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowLow_profile_le
      (d := d) (N := N) Phi .outgoing .middle
  obtain ⟨Cio, hCio, hio⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowLow_profile_le
      (d := d) (N := N) Phi .incoming .outgoing
  obtain ⟨Cii, hCii, hii⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowLow_profile_le
      (d := d) (N := N) Phi .incoming .incoming
  obtain ⟨Cim, hCim, him⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowLow_profile_le
      (d := d) (N := N) Phi .incoming .middle
  obtain ⟨Cmo, hCmo, hmo⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowLow_profile_le
      (d := d) (N := N) Phi .middle .outgoing
  obtain ⟨Cmi, hCmi, hmi⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowLow_profile_le
      (d := d) (N := N) Phi .middle .incoming
  obtain ⟨Cmm, hCmm, hmm⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowLow_profile_le
      (d := d) (N := N) Phi .middle .middle
  let C : Real :=
    (Coo + Coi + Com) + ((Cio + Cii + Cim) + (Cmo + Cmi + Cmm))
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro r s t hr0 hr hs0 hs
  apply norm_brrsTwoRadiusAllStationaryComponentIntegralSum_le_of_component_bounds
    Phi d N r s t ((1 - (1 / 32 : Real)) * C)
  intro partR partS
  cases partR <;> cases partS
  · exact (hoo r s t hr0 hr hs0 hs).trans
      (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (by dsimp [C]; linarith) (by norm_num))
        (brrsStationaryRapidProfile_nonneg N _))
  · exact (hoi r s t hr0 hr hs0 hs).trans
      (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (by dsimp [C]; linarith) (by norm_num))
        (brrsStationaryRapidProfile_nonneg N _))
  · exact (hom r s t hr0 hr hs0 hs).trans
      (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (by dsimp [C]; linarith) (by norm_num))
        (brrsStationaryRapidProfile_nonneg N _))
  · exact (hio r s t hr0 hr hs0 hs).trans
      (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (by dsimp [C]; linarith) (by norm_num))
        (brrsStationaryRapidProfile_nonneg N _))
  · exact (hii r s t hr0 hr hs0 hs).trans
      (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (by dsimp [C]; linarith) (by norm_num))
        (brrsStationaryRapidProfile_nonneg N _))
  · exact (him r s t hr0 hr hs0 hs).trans
      (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (by dsimp [C]; linarith) (by norm_num))
        (brrsStationaryRapidProfile_nonneg N _))
  · exact (hmo r s t hr0 hr hs0 hs).trans
      (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (by dsimp [C]; linarith) (by norm_num))
        (brrsStationaryRapidProfile_nonneg N _))
  · exact (hmi r s t hr0 hr hs0 hs).trans
      (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (by dsimp [C]; linarith) (by norm_num))
        (brrsStationaryRapidProfile_nonneg N _))
  · exact (hmm r s t hr0 hr hs0 hs).trans
      (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (by dsimp [C]; linarith) (by norm_num))
        (brrsStationaryRapidProfile_nonneg N _))

/-- On the compact two-radius cell, the literal all-nine stationary kernel is
already controlled by the four endpoint signs.  Each middle carrier is moved
by a bounded radial displacement; the middle--middle term uses this shift
twice, with the corresponding doubled integration-by-parts order. -/
theorem exists_norm_brrsTwoRadAllStatComponentIntegralSum_lowLow_fourPhase_profile_le
    {d N : Nat} (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real,
      0 ≤ r → r ≤ 16 → 0 ≤ s → s ≤ 16 →
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤
        (1 - (1 / 32 : Real)) * C *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
  obtain ⟨Coo, hCoo, hoo⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowLow_profile_le
      (d := d) (N := N) Phi .outgoing .outgoing
  obtain ⟨Coi, hCoi, hoi⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowLow_profile_le
      (d := d) (N := N) Phi .outgoing .incoming
  obtain ⟨Cio, hCio, hio⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowLow_profile_le
      (d := d) (N := N) Phi .incoming .outgoing
  obtain ⟨Cii, hCii, hii⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowLow_profile_le
      (d := d) (N := N) Phi .incoming .incoming
  obtain ⟨Com, hCom, hom⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowLow_profile_le
      (d := d) (N := 2 * N) Phi .outgoing .middle
  obtain ⟨Cim, hCim, him⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowLow_profile_le
      (d := d) (N := 2 * N) Phi .incoming .middle
  obtain ⟨Cmo, hCmo, hmo⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowLow_profile_le
      (d := d) (N := 2 * N) Phi .middle .outgoing
  obtain ⟨Cmi, hCmi, hmi⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowLow_profile_le
      (d := d) (N := 2 * N) Phi .middle .incoming
  obtain ⟨Cmm, hCmm, hmm⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowLow_profile_le
      (d := d) (N := 2 * (2 * N)) Phi .middle .middle
  let Lone : Real := (17 : Real) ^ N *
    ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N)
  let Ltwo : Real := (17 : Real) ^ (2 * N) *
    ((2 : Real) ^ (2 * (2 * N)) * (2 * Real.pi) ^ (2 * N))
  let C₀ : Real := Coo + Coi + Cio + Cii + Com + Cim + Cmo + Cmi + Cmm
  let C : Real := (1 + Lone + Ltwo * Lone) * C₀
  have hLone : 0 < Lone := by
    dsimp [Lone]
    positivity
  have hLtwo : 0 < Ltwo := by
    dsimp [Ltwo]
    positivity
  have hC₀ : 0 < C₀ := by
    dsimp [C₀]
    linarith
  have hC : 0 < C := by
    dsimp [C]
    exact mul_pos (by positivity) hC₀
  have hC₀_le_C : C₀ ≤ C := by
    dsimp [C]
    calc
      C₀ = 1 * C₀ := by ring
      _ ≤ (1 + Lone + Ltwo * Lone) * C₀ :=
        mul_le_mul_of_nonneg_right
          (by nlinarith [mul_nonneg hLtwo.le hLone.le]) hC₀.le
  have hCoo_le_C₀ : Coo ≤ C₀ := by dsimp [C₀]; linarith
  have hCoi_le_C₀ : Coi ≤ C₀ := by dsimp [C₀]; linarith
  have hCio_le_C₀ : Cio ≤ C₀ := by dsimp [C₀]; linarith
  have hCii_le_C₀ : Cii ≤ C₀ := by dsimp [C₀]; linarith
  have hCom_le_C₀ : Com ≤ C₀ := by dsimp [C₀]; linarith
  have hCim_le_C₀ : Cim ≤ C₀ := by dsimp [C₀]; linarith
  have hCmo_le_C₀ : Cmo ≤ C₀ := by dsimp [C₀]; linarith
  have hCmi_le_C₀ : Cmi ≤ C₀ := by dsimp [C₀]; linarith
  have hCmm_le_C₀ : Cmm ≤ C₀ := by dsimp [C₀]; linarith
  have hLone_C₀_le_C : Lone * C₀ ≤ C := by
    dsimp [C]
    exact mul_le_mul_of_nonneg_right
      (by nlinarith [mul_nonneg hLtwo.le hLone.le]) hC₀.le
  have hLtwoLone_C₀_le_C : Ltwo * Lone * C₀ ≤ C := by
    dsimp [C]
    exact mul_le_mul_of_nonneg_right (by nlinarith [hLone.le]) hC₀.le
  have hCoo_le : Coo ≤ C := hCoo_le_C₀.trans hC₀_le_C
  have hCoi_le : Coi ≤ C := hCoi_le_C₀.trans hC₀_le_C
  have hCio_le : Cio ≤ C := hCio_le_C₀.trans hC₀_le_C
  have hCii_le : Cii ≤ C := hCii_le_C₀.trans hC₀_le_C
  have hCom_le : Lone * Com ≤ C :=
    (mul_le_mul_of_nonneg_left hCom_le_C₀ hLone.le).trans hLone_C₀_le_C
  have hCim_le : Lone * Cim ≤ C :=
    (mul_le_mul_of_nonneg_left hCim_le_C₀ hLone.le).trans hLone_C₀_le_C
  have hCmo_le : Lone * Cmo ≤ C :=
    (mul_le_mul_of_nonneg_left hCmo_le_C₀ hLone.le).trans hLone_C₀_le_C
  have hCmi_le : Lone * Cmi ≤ C :=
    (mul_le_mul_of_nonneg_left hCmi_le_C₀ hLone.le).trans hLone_C₀_le_C
  have hCmm_le_C₀' : Ltwo * Lone * Cmm ≤ Ltwo * Lone * C₀ := by
    calc
      Ltwo * Lone * Cmm = Ltwo * (Lone * Cmm) := by ring
      _ ≤ Ltwo * (Lone * C₀) :=
        mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_left hCmm_le_C₀ hLone.le) hLtwo.le
      _ = Ltwo * Lone * C₀ := by ring
  have hCmm_le : Ltwo * Lone * Cmm ≤ C :=
    hCmm_le_C₀'.trans hLtwoLone_C₀_le_C
  refine ⟨(9 : Real) * C, by positivity, ?_⟩
  intro r s t hr0 hr hs0 hs
  let δ : Real := 1 - (1 / 32 : Real)
  let P₁ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s))
  let P₂ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s))
  let P₃ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s))
  let P₄ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))
  let P : Real := P₁ + P₂ + P₃ + P₄
  let A : Real := δ * C
  have hδ : 0 ≤ δ := by
    dsimp [δ]
    norm_num
  have hA : 0 ≤ A := by
    dsimp [A]
    positivity
  have hP₁ : 0 ≤ P₁ := by dsimp [P₁]; exact brrsStationaryRapidProfile_nonneg _ _
  have hP₂ : 0 ≤ P₂ := by dsimp [P₂]; exact brrsStationaryRapidProfile_nonneg _ _
  have hP₃ : 0 ≤ P₃ := by dsimp [P₃]; exact brrsStationaryRapidProfile_nonneg _ _
  have hP₄ : 0 ≤ P₄ := by dsimp [P₄]; exact brrsStationaryRapidProfile_nonneg _ _
  have hP₁_le : P₁ ≤ P := by dsimp [P]; linarith
  have hP₂_le : P₂ ≤ P := by dsimp [P]; linarith
  have hP₃_le : P₃ ≤ P := by dsimp [P]; linarith
  have hP₄_le : P₄ ≤ P := by dsimp [P]; linarith
  have hAbsorb (D E : Real) (hD : D ≤ C) (hE : E ≤ P) (hE0 : 0 ≤ E) :
      δ * D * E ≤ A * P := by
    have hcoef : δ * D ≤ A := by
      dsimp [A]
      exact mul_le_mul_of_nonneg_left hD hδ
    calc
      δ * D * E ≤ A * E := mul_le_mul_of_nonneg_right hcoef hE0
      _ ≤ A * P := mul_le_mul_of_nonneg_left hE hA
  have hphase_om :
      brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - r)) ≤ Lone * P₁ := by
    convert brrsStationaryRapidProfile_smallRadius_shift_to_endpointPhase
      N (t - r) s (by rw [abs_of_nonneg hs0]; exact hs) using 1
  have hphase_im :
      brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + r)) ≤ Lone * P₃ := by
    convert brrsStationaryRapidProfile_smallRadius_shift_to_endpointPhase
      N (t + r) s (by rw [abs_of_nonneg hs0]; exact hs) using 1
  have hphase_mo :
      brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - s)) ≤ Lone * P₁ := by
    convert brrsStationaryRapidProfile_smallRadius_shift_to_endpointPhase
      N (t - s) r (by rw [abs_of_nonneg hr0]; exact hr) using 1;
      dsimp [Lone, P₁]; ring
  have hphase_mi :
      brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + s)) ≤ Lone * P₂ := by
    convert brrsStationaryRapidProfile_smallRadius_shift_to_endpointPhase
      N (t + s) r (by rw [abs_of_nonneg hr0]; exact hr) using 1;
      dsimp [Lone, P₂]; ring
  have hphase_mm_first :
      brrsStationaryRapidProfile (2 * (2 * N)) (2 * Real.pi * t) ≤
        Ltwo * brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - r)) := by
    convert brrsStationaryRapidProfile_smallRadius_shift_to_endpointPhase
      (2 * N) t r (by rw [abs_of_nonneg hr0]; exact hr) using 1
  have hphase_mm :
      brrsStationaryRapidProfile (2 * (2 * N)) (2 * Real.pi * t) ≤
        (Ltwo * Lone) * P₁ := by
    calc
      _ ≤ Ltwo * brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - r)) :=
        hphase_mm_first
      _ ≤ Ltwo * (Lone * P₁) :=
        mul_le_mul_of_nonneg_left hphase_om hLtwo.le
      _ = (Ltwo * Lone) * P₁ := by ring
  have hIoo :
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .outgoing r s t‖ ≤ A * P := by
    calc
      _ ≤ δ * Coo * P₁ := by
        convert hoo r s t hr0 hr hs0 hs using 1;
          dsimp [δ, P₁, brrsSurfaceWavePhase]; ring
      _ ≤ A * P := hAbsorb Coo P₁ hCoo_le hP₁_le hP₁
  have hIoi :
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .incoming r s t‖ ≤ A * P := by
    calc
      _ ≤ δ * Coi * P₂ := by
        convert hoi r s t hr0 hr hs0 hs using 1;
          dsimp [δ, P₂, brrsSurfaceWavePhase]; ring
      _ ≤ A * P := hAbsorb Coi P₂ hCoi_le hP₂_le hP₂
  have hIio :
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .outgoing r s t‖ ≤ A * P := by
    calc
      _ ≤ δ * Cio * P₃ := by
        convert hio r s t hr0 hr hs0 hs using 1;
          dsimp [δ, P₃, brrsSurfaceWavePhase]; ring
      _ ≤ A * P := hAbsorb Cio P₃ hCio_le hP₃_le hP₃
  have hIii :
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .incoming r s t‖ ≤ A * P := by
    calc
      _ ≤ δ * Cii * P₄ := by
        convert hii r s t hr0 hr hs0 hs using 1;
          dsimp [δ, P₄, brrsSurfaceWavePhase]; ring
      _ ≤ A * P := hAbsorb Cii P₄ hCii_le hP₄_le hP₄
  have hIom :
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .middle r s t‖ ≤ A * P := by
    have hcoef : 0 ≤ δ * Com := by positivity
    calc
      _ ≤ δ * Com * brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - r)) := by
        convert hom r s t hr0 hr hs0 hs using 1;
          dsimp [δ, brrsSurfaceWavePhase]; ring
      _ ≤ δ * Com * (Lone * P₁) := mul_le_mul_of_nonneg_left hphase_om hcoef
      _ = δ * (Lone * Com) * P₁ := by ring
      _ ≤ A * P := hAbsorb (Lone * Com) P₁ hCom_le hP₁_le hP₁
  have hIim :
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .middle r s t‖ ≤ A * P := by
    have hcoef : 0 ≤ δ * Cim := by positivity
    calc
      _ ≤ δ * Cim * brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + r)) := by
        convert him r s t hr0 hr hs0 hs using 1;
          dsimp [δ, brrsSurfaceWavePhase]; ring
      _ ≤ δ * Cim * (Lone * P₃) := mul_le_mul_of_nonneg_left hphase_im hcoef
      _ = δ * (Lone * Cim) * P₃ := by ring
      _ ≤ A * P := hAbsorb (Lone * Cim) P₃ hCim_le hP₃_le hP₃
  have hImo :
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d .middle .outgoing r s t‖ ≤ A * P := by
    have hcoef : 0 ≤ δ * Cmo := by positivity
    calc
      _ ≤ δ * Cmo * brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - s)) := by
        convert hmo r s t hr0 hr hs0 hs using 1;
          dsimp [δ, brrsSurfaceWavePhase]; ring
      _ ≤ δ * Cmo * (Lone * P₁) := mul_le_mul_of_nonneg_left hphase_mo hcoef
      _ = δ * (Lone * Cmo) * P₁ := by ring
      _ ≤ A * P := hAbsorb (Lone * Cmo) P₁ hCmo_le hP₁_le hP₁
  have hImi :
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d .middle .incoming r s t‖ ≤ A * P := by
    have hcoef : 0 ≤ δ * Cmi := by positivity
    calc
      _ ≤ δ * Cmi * brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + s)) := by
        convert hmi r s t hr0 hr hs0 hs using 1;
          dsimp [δ, brrsSurfaceWavePhase]; ring
      _ ≤ δ * Cmi * (Lone * P₂) := mul_le_mul_of_nonneg_left hphase_mi hcoef
      _ = δ * (Lone * Cmi) * P₂ := by ring
      _ ≤ A * P := hAbsorb (Lone * Cmi) P₂ hCmi_le hP₂_le hP₂
  have hImm :
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d .middle .middle r s t‖ ≤ A * P := by
    have hcoef : 0 ≤ δ * Cmm := by positivity
    calc
      _ ≤ δ * Cmm * brrsStationaryRapidProfile (2 * (2 * N)) (2 * Real.pi * t) := by
        convert hmm r s t hr0 hr hs0 hs using 1;
          dsimp [δ, brrsSurfaceWavePhase]; ring
      _ ≤ δ * Cmm * ((Ltwo * Lone) * P₁) :=
        mul_le_mul_of_nonneg_left hphase_mm hcoef
      _ = δ * (Ltwo * Lone * Cmm) * P₁ := by ring
      _ ≤ A * P := hAbsorb (Ltwo * Lone * Cmm) P₁ hCmm_le hP₁_le hP₁
  have hall :=
    norm_brrsTwoRadiusAllStationaryComponentIntegralSum_le_of_component_common_bound
      Phi d r s t A P (by
        intro partR partS
        cases partR <;> cases partS
        · exact hIoo
        · exact hIoi
        · exact hIom
        · exact hIio
        · exact hIii
        · exact hIim
        · exact hImo
        · exact hImi
        · exact hImm)
  calc
    ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤ (9 : Real) * A * P := hall
    _ = (1 - (1 / 32 : Real)) * ((9 : Real) * C) * P := by
      dsimp [A, δ]
      ring
    _ = (1 - (1 / 32 : Real)) * ((9 : Real) * C) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
      dsimp [P, P₁, P₂, P₃, P₄]

/-- When the output radius is compact and the source radius is high, the
exact all-nine stationary kernel has the single high-radius half-density
decay and retains every one of its nine phase profiles.  This is the
unconditional mixed-region kernel majorant used by the initial radial cell. -/
theorem exists_norm_brrsTwoRadAllStatComponentIntegralSum_lowHigh_ninePhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real,
      0 ≤ r → r ≤ 16 → 16 ≤ s →
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (s / 16)) ^ (d - 1)) *
            brrsTwoRadiusNinePhaseProfile N r s t := by
  obtain ⟨Coo, hCoo, hoo⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      (d := d) (N := N) hd Phi .outgoing .outgoing
  obtain ⟨Coi, hCoi, hoi⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      (d := d) (N := N) hd Phi .outgoing .incoming
  obtain ⟨Com, hCom, hom⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      (d := d) (N := N) hd Phi .outgoing .middle
  obtain ⟨Cio, hCio, hio⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      (d := d) (N := N) hd Phi .incoming .outgoing
  obtain ⟨Cii, hCii, hii⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      (d := d) (N := N) hd Phi .incoming .incoming
  obtain ⟨CinMid, hCinMid, hinMid⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      (d := d) (N := N) hd Phi .incoming .middle
  obtain ⟨Cmo, hCmo, hmo⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      (d := d) (N := N) hd Phi .middle .outgoing
  obtain ⟨Cmi, hCmi, hmi⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      (d := d) (N := N) hd Phi .middle .incoming
  obtain ⟨Cmm, hCmm, hmm⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      (d := d) (N := N) hd Phi .middle .middle
  let C : Real :=
    (Coo + Coi + Com) + ((Cio + Cii + CinMid) + (Cmo + Cmi + Cmm))
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro r s t hr0 hr hs
  let q : Real := (Real.sqrt (s / 16)) ^ (d - 1)
  let A : Real := (1 - (1 / 32 : Real)) * (C / q)
  have hq : 0 < q := by
    dsimp [q]
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hCoo_le : Coo ≤ C := by dsimp [C]; linarith
  have hCoi_le : Coi ≤ C := by dsimp [C]; linarith
  have hCom_le : Com ≤ C := by dsimp [C]; linarith
  have hCio_le : Cio ≤ C := by dsimp [C]; linarith
  have hCii_le : Cii ≤ C := by dsimp [C]; linarith
  have hCinMid_le : CinMid ≤ C := by dsimp [C]; linarith
  have hCmo_le : Cmo ≤ C := by dsimp [C]; linarith
  have hCmi_le : Cmi ≤ C := by dsimp [C]; linarith
  have hCmm_le : Cmm ≤ C := by dsimp [C]; linarith
  have hAbsorb (D P : Real) (hD : D ≤ C) (hP : 0 ≤ P) :
      (1 - (1 / 32 : Real)) * (D / q) * P ≤ A * P := by
    apply mul_le_mul_of_nonneg_right _ hP
    dsimp [A]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hD hq.le
    · norm_num
  have hall := norm_brrsTwoRadiusAllStationaryComponentIntegralSum_le_of_component_bounds
    Phi d N r s t A
  apply hall
  intro partR partS
  cases partR <;> cases partS
  · exact (hoo r s t hr0 hr hs).trans
      (hAbsorb Coo _ hCoo_le (brrsStationaryRapidProfile_nonneg N _))
  · exact (hoi r s t hr0 hr hs).trans
      (hAbsorb Coi _ hCoi_le (brrsStationaryRapidProfile_nonneg N _))
  · exact (hom r s t hr0 hr hs).trans
      (hAbsorb Com _ hCom_le (brrsStationaryRapidProfile_nonneg N _))
  · exact (hio r s t hr0 hr hs).trans
      (hAbsorb Cio _ hCio_le (brrsStationaryRapidProfile_nonneg N _))
  · exact (hii r s t hr0 hr hs).trans
      (hAbsorb Cii _ hCii_le (brrsStationaryRapidProfile_nonneg N _))
  · exact (hinMid r s t hr0 hr hs).trans
      (hAbsorb CinMid _ hCinMid_le (brrsStationaryRapidProfile_nonneg N _))
  · exact (hmo r s t hr0 hr hs).trans
      (hAbsorb Cmo _ hCmo_le (brrsStationaryRapidProfile_nonneg N _))
  · exact (hmi r s t hr0 hr hs).trans
      (hAbsorb Cmi _ hCmi_le (brrsStationaryRapidProfile_nonneg N _))
  · exact (hmm r s t hr0 hr hs).trans
      (hAbsorb Cmm _ hCmm_le (brrsStationaryRapidProfile_nonneg N _))

/-- The compact all-nine profile estimate transports exactly to the dyadic
two-radius model.  In particular, it is an unconditional analytic estimate
for the compact source and output portion of the dyadic initial block. -/
theorem exists_norm_brrsDyTwoRadAllStatCompIntegralSum_lowLow_ninePhase_profile_le
    {d N : Nat} (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r s t : Real,
      0 ≤ ((2 : Real) ^ j) * r → ((2 : Real) ^ j) * r ≤ 16 →
      0 ≤ ((2 : Real) ^ j) * s → ((2 : Real) ^ j) * s ≤ 16 →
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s t‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) * C *
            brrsTwoRadiusNinePhaseProfile N
              (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
                (((2 : Real) ^ j) * t)) := by
  obtain ⟨C, hC, hlevel⟩ :=
    exists_norm_brrsTwoRadAllStatComponentIntegralSum_lowLow_ninePhase_profile_le
      (d := d) (N := N) Phi
  refine ⟨C, hC, ?_⟩
  intro j r s t hr0 hr hs0 hs
  exact norm_brrsDyadicTwoRadiusAllStationaryComponentIntegralSum_le_scaled_of_levelZero
    Phi d j r s t _
    (hlevel (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
      (((2 : Real) ^ j) * t) hr0 hr hs0 hs)

/-- The mixed compact-output/high-source all-nine profile estimate transports
exactly to the dyadic radial kernel.  Thus the `I₀` output region has a
genuine kernel bound on its entire high-source complement, rather than only
the former conditional overlap bookkeeping. -/
theorem exists_norm_brrsDyTwoRadAllStatCompIntegralSum_lowHigh_ninePhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r s t : Real,
      0 ≤ ((2 : Real) ^ j) * r → ((2 : Real) ^ j) * r ≤ 16 →
      16 ≤ ((2 : Real) ^ j) * s →
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s t‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1)) *
              brrsTwoRadiusNinePhaseProfile N
                (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
                  (((2 : Real) ^ j) * t)) := by
  obtain ⟨C, hC, hlevel⟩ :=
    exists_norm_brrsTwoRadAllStatComponentIntegralSum_lowHigh_ninePhase_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j r s t hr0 hr hs
  exact norm_brrsDyadicTwoRadiusAllStationaryComponentIntegralSum_le_scaled_of_levelZero
    Phi d j r s t _
    (hlevel (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
      (((2 : Real) ^ j) * t) hr0 hr hs)

/-- The actual dyadic `I₀` output region has an unconditional all-source
kernel majorant.  The compact and high source regions are split at the
literal scaled radius `16`; the high-radius half-density is at most one
there, so the result has one uniform nine-phase profile. -/
theorem exists_norm_brrsDyTwoRadAllStatComponentIntegralSum_I0_ninePhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r s t : Real,
      0 ≤ r → r ≤ dyadicTimeScale j → 0 ≤ s →
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s t‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) * C *
            brrsTwoRadiusNinePhaseProfile N
              (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
                (((2 : Real) ^ j) * t)) := by
  obtain ⟨Clo, hClo, hlo⟩ :=
    exists_norm_brrsDyTwoRadAllStatCompIntegralSum_lowLow_ninePhase_profile_le
      (d := d) (N := N) Phi
  obtain ⟨Chi, hChi, hhi⟩ :=
    exists_norm_brrsDyTwoRadAllStatCompIntegralSum_lowHigh_ninePhase_profile_le
      (d := d) (N := N) hd Phi
  let C : Real := Clo + Chi
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro j r s t hr0 hr hs0
  have hqpos : 0 < (2 : Real) ^ j := pow_pos (by norm_num) _
  have hscaledRadius : ((2 : Real) ^ j) * dyadicTimeScale j = 1 := by
    unfold dyadicTimeScale
    exact mul_inv_cancel₀ (pow_ne_zero j (by norm_num))
  have hqr0 : 0 ≤ ((2 : Real) ^ j) * r :=
    mul_nonneg hqpos.le hr0
  have hqrone : ((2 : Real) ^ j) * r ≤ 1 := by
    calc
      ((2 : Real) ^ j) * r ≤ ((2 : Real) ^ j) * dyadicTimeScale j :=
        mul_le_mul_of_nonneg_left hr hqpos.le
      _ = 1 := hscaledRadius
  have hqr : ((2 : Real) ^ j) * r ≤ 16 := by linarith
  have hqs0 : 0 ≤ ((2 : Real) ^ j) * s :=
    mul_nonneg hqpos.le hs0
  have hClo_le : Clo ≤ C := by dsimp [C]; linarith
  have hChi_le : Chi ≤ C := by dsimp [C]; linarith
  rcases le_total (((2 : Real) ^ j) * s) 16 with hslow | hhigh
  · calc
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s t‖ ≤
          ‖((2 : Real) ^ j) ^ d‖ *
            ((1 - (1 / 32 : Real)) * Clo *
              brrsTwoRadiusNinePhaseProfile N
                (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
                  (((2 : Real) ^ j) * t)) := hlo j r s t hqr0 hqr hqs0 hslow
      _ ≤ ‖((2 : Real) ^ j) ^ d‖ *
            ((1 - (1 / 32 : Real)) * C *
              brrsTwoRadiusNinePhaseProfile N
                (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
                  (((2 : Real) ^ j) * t)) := by
            apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
            apply mul_le_mul_of_nonneg_right _
              (brrsTwoRadiusNinePhaseProfile_nonneg N _ _ _)
            exact mul_le_mul_of_nonneg_left hClo_le (by norm_num)
  · have hratio : 1 ≤ (((2 : Real) ^ j) * s) / 16 := by linarith
    have hsqrt : 1 ≤ Real.sqrt ((((2 : Real) ^ j) * s) / 16) :=
      Real.one_le_sqrt.mpr hratio
    have hdenone : 1 ≤ (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1) :=
      one_le_pow₀ hsqrt
    have hdenpos : 0 < (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1) :=
      lt_of_lt_of_le zero_lt_one hdenone
    have hdiv : Chi / (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1) ≤ C := by
      calc
        Chi / (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1) ≤ Chi := by
          apply (div_le_iff₀ hdenpos).mpr
          exact le_mul_of_one_le_right hChi.le hdenone
        _ ≤ C := hChi_le
    calc
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s t‖ ≤
          ‖((2 : Real) ^ j) ^ d‖ *
            ((1 - (1 / 32 : Real)) *
              (Chi / (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1)) *
                brrsTwoRadiusNinePhaseProfile N
                  (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
                    (((2 : Real) ^ j) * t)) := hhi j r s t hqr0 hqr hhigh
      _ ≤ ‖((2 : Real) ^ j) ^ d‖ *
            ((1 - (1 / 32 : Real)) * C *
              brrsTwoRadiusNinePhaseProfile N
                (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
                  (((2 : Real) ^ j) * t)) := by
            apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
            apply mul_le_mul_of_nonneg_right _
              (brrsTwoRadiusNinePhaseProfile_nonneg N _ _ _)
            exact mul_le_mul_of_nonneg_left hdiv (by norm_num)

/-- The positive-ray version of the stationary surface-wave expansion.  It
is obtained by reflecting the ray and then using the negative-ray form. -/
theorem brrs_surfaceFourier_pos_smul_eq_three_terms
    {d : Nat} (hd : 3 ≤ d) {rho s : Real} (hrho : 0 < rho) (hs : 0 ≤ s)
    (v : BRRSSpace d) (hv : ‖v‖ = 1) :
    surfaceFourier d (s • (rho • v)) =
      brrsSurfaceWaveTerm d .outgoing s rho +
        brrsSurfaceWaveTerm d .incoming s rho +
          brrsSurfaceWaveTerm d .middle s rho := by
  have hrewrite : s • (rho • v) = -rho • (-s • v) := by
    module
  rw [hrewrite, brrs_surfaceFourier_neg_smul_eq_three_terms hd hrho]
  have hnorm : ‖-s • v‖ = s := by
    rw [norm_smul, Real.norm_eq_abs, abs_neg, abs_of_nonneg hs, hv, mul_one]
  rw [hnorm]

/-- The compact two-radius Fourier integral which appears after the radial
Fourier reduction at level zero.  The unit vector only chooses a ray; the
following stationary identity makes its radial nature explicit. -/
noncomputable def brrsTwoRadiusSurfaceFourierIntervalIntegral
    (Phi : BRRSAnnularCutoff) (d : Nat) (v : BRRSSpace d)
    (r s t : Real) : Complex :=
  ∫ rho in (1 / 32 : Real)..1,
    ((rho ^ (d - 1) : Real) : Complex) *
      (surfaceFourier d (-rho • (r • v)) *
        (brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho *
          surfaceFourier d (s • (rho • v))))

/-- The full three-by-three stationary product associated to the preceding
two-radius Fourier integral.  This retains all nine pairs of endpoint and
middle waves; discarding the middle terms here would not be an exact
identity. -/
noncomputable def brrsTwoRadiusFullStationaryIntervalIntegral
    (Phi : BRRSAnnularCutoff) (d : Nat) (r s t : Real) : Complex :=
  ∫ rho in (1 / 32 : Real)..1,
    ((rho ^ (d - 1) : Real) : Complex) *
      (brrsSurfaceWaveSum d (r * rho) *
        (brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho *
          brrsSurfaceWaveSum d (s * rho)))

/-- Exact stationary expansion of the compact two-radius Fourier integral
in dimensions at least three. -/
theorem brrsTwoRadiusSurfaceFourierIntervalIntegral_eq_fullStationary
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) (v : BRRSSpace d)
    (hv : ‖v‖ = 1) (r s t : Real) (hr : 0 ≤ r) (hs : 0 ≤ s) :
    brrsTwoRadiusSurfaceFourierIntervalIntegral Phi d v r s t =
      brrsTwoRadiusFullStationaryIntervalIntegral Phi d r s t := by
  unfold brrsTwoRadiusSurfaceFourierIntervalIntegral
    brrsTwoRadiusFullStationaryIntervalIntegral
  apply intervalIntegral.integral_congr
  intro rho hrho
  have hrhoIcc : rho ∈ Icc (1 / 32 : Real) 1 := by
    simpa only [uIcc_of_le (by norm_num : (1 / 32 : Real) ≤ 1)] using hrho
  have hrhopos : 0 < rho := by
    linarith [hrhoIcc.1]
  have houter : surfaceFourier d (-rho • (r • v)) =
      brrsSurfaceWaveSum d (r * rho) := by
    calc
      surfaceFourier d (-rho • (r • v)) =
          brrsSurfaceWaveTerm d .outgoing ‖r • v‖ rho +
            brrsSurfaceWaveTerm d .incoming ‖r • v‖ rho +
              brrsSurfaceWaveTerm d .middle ‖r • v‖ rho :=
        brrs_surfaceFourier_neg_smul_eq_three_terms hd hrhopos (r • v)
      _ = brrsSurfaceWaveTerm d .outgoing r rho +
            brrsSurfaceWaveTerm d .incoming r rho +
              brrsSurfaceWaveTerm d .middle r rho := by
        have hnorm : ‖r • v‖ = r := by
          rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hr, hv, mul_one]
        rw [hnorm]
      _ = brrsSurfaceWaveSum d (r * rho) :=
        (brrsSurfaceWaveSum_eq_three_terms d r rho).symm
  have hinner : surfaceFourier d (s • (rho • v)) =
      brrsSurfaceWaveSum d (s * rho) := by
    calc
      surfaceFourier d (s • (rho • v)) =
          brrsSurfaceWaveTerm d .outgoing s rho +
            brrsSurfaceWaveTerm d .incoming s rho +
              brrsSurfaceWaveTerm d .middle s rho :=
        brrs_surfaceFourier_pos_smul_eq_three_terms hd hrhopos hs v hv
      _ = brrsSurfaceWaveSum d (s * rho) :=
        (brrsSurfaceWaveSum_eq_three_terms d s rho).symm
  dsimp
  rw [houter, hinner]

/-- At level zero, the annular half-wave symbol restricted to a positive
unit ray is exactly the scalar radial kernel profile. -/
theorem brrsDyadicHalfWaveSymbol_levelZero_on_positive_ray_eq_kernelRadialProfile
    {d : Nat} (Phi : BRRSAnnularCutoff) (t rho : Real)
    (v : BRRSSpace d) (hv : ‖v‖ = 1) (hrho : 0 < rho) :
    brrsDyadicHalfWaveSymbol Phi 0 t (rho • v) =
      brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho := by
  have hnorm : ‖rho • v‖ = rho := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hrho, hv, mul_one]
  calc
    brrsDyadicHalfWaveSymbol Phi 0 t (rho • v) =
        brrsDyadicHalfWaveSchwartzSymbol Phi 0 t (rho • v) := rfl
    _ = brrsDyadicHalfWaveKernelRadialProfile Phi 0 t ‖rho • v‖ :=
      brrsDyadicHalfWaveSchwartzSymbol_eq_kernelRadialProfile Phi 0 t (rho • v)
    _ = brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho := by rw [hnorm]

/-- The inner radial-frequency integral in the exact Fubini formula is the
compact level-zero two-radius kernel. -/
theorem brrs_levelZero_twoRadiusInnerIntegral_eq_intervalIntegral
    {d : Nat} (Phi : BRRSAnnularCutoff) (t r : Real)
    (v : BRRSSpace d) (hv : ‖v‖ = 1) (s : Ioi (0 : Real)) :
    (∫ rho : Ioi (0 : Real),
      surfaceFourier d (-rho.1 • (r • v)) *
        (brrsDyadicHalfWaveSymbol Phi 0 t (rho.1 • v) *
          surfaceFourier d (s.1 • (rho.1 • v)))
        ∂Measure.volumeIoiPow (d - 1)) =
      brrsTwoRadiusSurfaceFourierIntervalIntegral Phi d v r s.1 t := by
  calc
    (∫ rho : Ioi (0 : Real),
      surfaceFourier d (-rho.1 • (r • v)) *
        (brrsDyadicHalfWaveSymbol Phi 0 t (rho.1 • v) *
          surfaceFourier d (s.1 • (rho.1 • v)))
        ∂Measure.volumeIoiPow (d - 1)) =
        ∫ rho : Ioi (0 : Real),
          surfaceFourier d (-rho.1 • (r • v)) *
            (brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho.1 *
              surfaceFourier d (s.1 • (rho.1 • v)))
          ∂Measure.volumeIoiPow (d - 1) := by
      apply integral_congr_ae
      filter_upwards with rho
      rw [brrsDyadicHalfWaveSymbol_levelZero_on_positive_ray_eq_kernelRadialProfile
        Phi t rho.1 v hv rho.2]
    _ = ∫ rho in Ioi (0 : Real), ((rho ^ (d - 1) : Real) : Complex) *
        (surfaceFourier d (-rho • (r • v)) *
          (brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho *
            surfaceFourier d (s.1 • (rho • v)))) :=
      Auto.Spherical.Auxiliary.integral_volumeIoiPow_eq_setIntegral
        (d - 1)
        (fun rho : Real =>
          surfaceFourier d (-rho • (r • v)) *
            (brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho *
              surfaceFourier d (s.1 • (rho • v))))
    _ = ∫ rho in (1 / 32 : Real)..1, ((rho ^ (d - 1) : Real) : Complex) *
        (surfaceFourier d (-rho • (r • v)) *
          (brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho *
            surfaceFourier d (s.1 • (rho • v)))) :=
      Auto.Spherical.Auxiliary.setIntegral_Ioi_eq_intervalIntegral_of_eq_zero_outside_general
          (by norm_num) (by norm_num)
          (fun rho : Real =>
            ((rho ^ (d - 1) : Real) : Complex) *
              (surfaceFourier d (-rho • (r • v)) *
                (brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho *
                  surfaceFourier d (s.1 • (rho • v)))))
          (by
            intro rho hrho hrange
            rw [brrsDyadicHalfWaveKernelRadialProfile_zero_of_not_mem_levelZero
              Phi t hrho hrange]
            ring)
    _ = brrsTwoRadiusSurfaceFourierIntervalIntegral Phi d v r s.1 t := rfl

/-- Exact level-zero radial half-wave formula with its inner frequency
integral replaced by the compact two-radius surface-Fourier kernel. -/
theorem brrsDyadicHalfWave_levelZero_eq_twoRadiusSurfaceFourierIntervalIntegral
    {d : Nat} (hd : 0 < d) (Phi : BRRSAnnularCutoff) (t : Real)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d → Complex))
    (v w : BRRSSpace d) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1) (r : Real) :
    brrsDyadicHalfWave Phi 0 t f (r • v) =
      ∫ s : Ioi (0 : Real),
        brrsTwoRadiusSurfaceFourierIntervalIntegral Phi d v r s.1 t *
          f (s.1 • w)
        ∂Measure.volumeIoiPow (d - 1) := by
  rw [brrsDyadicHalfWave_eq_twoRadius_surfaceFourier_kernel
    hd Phi 0 t f hf v w (r • v) hv hw]
  apply integral_congr_ae
  filter_upwards with s
  rw [brrs_levelZero_twoRadiusInnerIntegral_eq_intervalIntegral
    Phi t r v hv s]

/-- Splitting the product of the two exact three-wave surface factors gives
the nine literal stationary component integrals.  This is the exact
two-radius counterpart of the one-radius three-component splitting. -/
theorem brrsTwoRadiusFullStationaryIntervalIntegral_eq_allStationaryComponentSum
    {d : Nat} (_hd : 3 <= d) (Phi : BRRSAnnularCutoff) (r s t : Real) :
    brrsTwoRadiusFullStationaryIntervalIntegral Phi d r s t =
      brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t := by
  let F : BRRSSurfaceWavePart -> BRRSSurfaceWavePart -> Real -> Complex :=
    fun partR partS rho =>
      ((rho ^ (d - 1) : Real) : Complex) *
        (brrsSurfaceWaveTerm d partR r rho *
          (brrsSurfaceWaveTerm d partS s rho *
            brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho))
  have hFcont (partR partS : BRRSSurfaceWavePart) :
      Continuous (F partR partS) := by
    have hdensity : Continuous (fun rho : Real =>
        ((rho ^ (d - 1) : Real) : Complex)) :=
      (show ContDiff Real (⊤ : ENat) (fun rho : Real =>
        ((rho ^ (d - 1) : Real) : Complex)) from
        Complex.ofRealCLM.contDiff.comp (contDiff_id.pow (d - 1))).continuous
    have htermR : Continuous (fun rho : Real =>
        brrsSurfaceWaveTerm d partR r rho) := by
      unfold brrsSurfaceWaveTerm
      exact (contDiff_brrsSurfaceWaveAmplitude d partR r).continuous.mul
        (by fun_prop)
    have htermS : Continuous (fun rho : Real =>
        brrsSurfaceWaveTerm d partS s rho) := by
      unfold brrsSurfaceWaveTerm
      exact (contDiff_brrsSurfaceWaveAmplitude d partS s).continuous.mul
        (by fun_prop)
    have hprofile : Continuous (fun rho : Real =>
        brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho) := by
      unfold brrsDyadicHalfWaveKernelRadialProfile
      simp only [pow_zero, inv_one, mul_one]
      apply Continuous.mul
      · fun_prop
      · exact (Phi.symbol.smooth (⊤ : ENat)).continuous.comp (by fun_prop)
    dsimp only [F]
    exact hdensity.mul (htermR.mul (htermS.mul hprofile))
  have hF (partR partS : BRRSSurfaceWavePart) :
      IntervalIntegrable (F partR partS) volume (1 / 32 : Real) 1 :=
    (hFcont partR partS).intervalIntegrable _ _
  have hrowOut : IntervalIntegrable (fun rho : Real =>
      (F .outgoing .outgoing rho + F .outgoing .incoming rho) +
        F .outgoing .middle rho) volume (1 / 32 : Real) 1 :=
    ((hF .outgoing .outgoing).add (hF .outgoing .incoming)).add
      (hF .outgoing .middle)
  have hrowIn : IntervalIntegrable (fun rho : Real =>
      (F .incoming .outgoing rho + F .incoming .incoming rho) +
        F .incoming .middle rho) volume (1 / 32 : Real) 1 :=
    ((hF .incoming .outgoing).add (hF .incoming .incoming)).add
      (hF .incoming .middle)
  have hrowMid : IntervalIntegrable (fun rho : Real =>
      (F .middle .outgoing rho + F .middle .incoming rho) +
        F .middle .middle rho) volume (1 / 32 : Real) 1 :=
    ((hF .middle .outgoing).add (hF .middle .incoming)).add
      (hF .middle .middle)
  have hrowOut_split :
      (∫ rho in (1 / 32 : Real)..1,
        (F .outgoing .outgoing rho + F .outgoing .incoming rho) +
          F .outgoing .middle rho) =
        (∫ rho in (1 / 32 : Real)..1, F .outgoing .outgoing rho) +
          (∫ rho in (1 / 32 : Real)..1, F .outgoing .incoming rho) +
            ∫ rho in (1 / 32 : Real)..1, F .outgoing .middle rho := by
    rw [intervalIntegral.integral_add
      ((hF .outgoing .outgoing).add (hF .outgoing .incoming))
      (hF .outgoing .middle)]
    rw [intervalIntegral.integral_add
      (hF .outgoing .outgoing) (hF .outgoing .incoming)]
  have hrowIn_split :
      (∫ rho in (1 / 32 : Real)..1,
        (F .incoming .outgoing rho + F .incoming .incoming rho) +
          F .incoming .middle rho) =
        (∫ rho in (1 / 32 : Real)..1, F .incoming .outgoing rho) +
          (∫ rho in (1 / 32 : Real)..1, F .incoming .incoming rho) +
            ∫ rho in (1 / 32 : Real)..1, F .incoming .middle rho := by
    rw [intervalIntegral.integral_add
      ((hF .incoming .outgoing).add (hF .incoming .incoming))
      (hF .incoming .middle)]
    rw [intervalIntegral.integral_add
      (hF .incoming .outgoing) (hF .incoming .incoming)]
  have hrowMid_split :
      (∫ rho in (1 / 32 : Real)..1,
        (F .middle .outgoing rho + F .middle .incoming rho) +
          F .middle .middle rho) =
        (∫ rho in (1 / 32 : Real)..1, F .middle .outgoing rho) +
          (∫ rho in (1 / 32 : Real)..1, F .middle .incoming rho) +
            ∫ rho in (1 / 32 : Real)..1, F .middle .middle rho := by
    rw [intervalIntegral.integral_add
      ((hF .middle .outgoing).add (hF .middle .incoming))
      (hF .middle .middle)]
    rw [intervalIntegral.integral_add
      (hF .middle .outgoing) (hF .middle .incoming)]
  have hpoint :
      (∫ rho in (1 / 32 : Real)..1,
        ((rho ^ (d - 1) : Real) : Complex) *
          (brrsSurfaceWaveSum d (r * rho) *
            (brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho *
              brrsSurfaceWaveSum d (s * rho)))) =
        ∫ rho in (1 / 32 : Real)..1,
          ((F .outgoing .outgoing rho + F .outgoing .incoming rho) +
            F .outgoing .middle rho) +
              (((F .incoming .outgoing rho + F .incoming .incoming rho) +
                F .incoming .middle rho) +
                  ((F .middle .outgoing rho + F .middle .incoming rho) +
                    F .middle .middle rho)) := by
    apply intervalIntegral.integral_congr
    intro rho _
    dsimp only [F]
    rw [brrsSurfaceWaveSum_eq_three_terms d r rho,
      brrsSurfaceWaveSum_eq_three_terms d s rho]
    ring
  have hsplit :
      (∫ rho in (1 / 32 : Real)..1,
        ((rho ^ (d - 1) : Real) : Complex) *
          (brrsSurfaceWaveSum d (r * rho) *
            (brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho *
              brrsSurfaceWaveSum d (s * rho)))) =
        ((∫ rho in (1 / 32 : Real)..1, F .outgoing .outgoing rho) +
          (∫ rho in (1 / 32 : Real)..1, F .outgoing .incoming rho) +
            ∫ rho in (1 / 32 : Real)..1, F .outgoing .middle rho) +
              (((∫ rho in (1 / 32 : Real)..1, F .incoming .outgoing rho) +
                (∫ rho in (1 / 32 : Real)..1, F .incoming .incoming rho) +
                  ∫ rho in (1 / 32 : Real)..1, F .incoming .middle rho) +
                    ((∫ rho in (1 / 32 : Real)..1, F .middle .outgoing rho) +
                      (∫ rho in (1 / 32 : Real)..1, F .middle .incoming rho) +
                        ∫ rho in (1 / 32 : Real)..1, F .middle .middle rho)) := by
    rw [hpoint]
    rw [intervalIntegral.integral_add hrowOut (hrowIn.add hrowMid)]
    rw [intervalIntegral.integral_add hrowIn hrowMid]
    rw [hrowOut_split, hrowIn_split, hrowMid_split]
  unfold brrsTwoRadiusFullStationaryIntervalIntegral
    brrsTwoRadiusAllStationaryComponentIntegralSum
    brrsTwoRadiusStationaryComponentIntegral
  simpa only [F] using hsplit

/-- Compatibility of the corrected repository-normalized radial kernel with
the literal all-nine stationary kernel at level zero.  The left side is the
exact `ds` kernel from the radial Fourier formula; the factor
`s ^ (d - 1)` converts it to the polar source measure used by the stationary
calculation.  Thus every later all-nine stationary estimate is an estimate
for the actual corrected radial kernel, rather than for a separate model.

This does not identify the result with the published Bessel display after
BRRS (5.3), whose missing frequency Jacobian is documented above. -/
theorem brrsRadialBesselKernel_levelZero_eq_allStationary
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff)
    (r s t : Real) (v : BRRSSpace d) (hv : ‖v‖ = 1)
    (hr : 0 ≤ r) (hs : 0 < s) :
    brrsRadialBesselKernel Phi d v 0 r s t =
      ((s ^ (d - 1) : Real) : Complex) *
        brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t := by
  rw [brrsRadialBesselKernel_eq_twoRadius_surfaceFourier Phi 0 t r s v hv]
  have hinner :
      (∫ rho : Ioi (0 : Real),
        surfaceFourier d (-rho.1 • (r • v)) *
          (brrsDyadicHalfWaveSymbol Phi 0 t (rho.1 • v) *
            surfaceFourier d (s • (rho.1 • v)))
          ∂Measure.volumeIoiPow (d - 1)) =
        brrsTwoRadiusSurfaceFourierIntervalIntegral Phi d v r s t := by
    simpa using
      (brrs_levelZero_twoRadiusInnerIntegral_eq_intervalIntegral
        (d := d) Phi t r v hv (⟨s, hs⟩ : Ioi (0 : Real)))
  rw [hinner,
    brrsTwoRadiusSurfaceFourierIntervalIntegral_eq_fullStationary
      hd Phi v hv r s t hr hs.le,
    brrsTwoRadiusFullStationaryIntervalIntegral_eq_allStationaryComponentSum
      hd Phi r s t]

/-- The literal level-zero BRRS half-wave on radial Schwartz data is an
outer radial integral of all nine exact two-radius stationary components.
No middle contribution is discarded in this identity. -/
theorem brrsDyadicHalfWave_levelZero_eq_allStationaryComponentIntegralSum
    {d : Nat} (hd : 3 <= d) (Phi : BRRSAnnularCutoff) (t : Real)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d -> Complex))
    (v w : BRRSSpace d) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1)
    (r : Real) (hr : 0 <= r) :
    brrsDyadicHalfWave Phi 0 t f (r • v) =
      ∫ s : Ioi (0 : Real),
        brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s.1 t *
          f (s.1 • w)
        ∂Measure.volumeIoiPow (d - 1) := by
  rw [brrsDyadicHalfWave_levelZero_eq_twoRadiusSurfaceFourierIntervalIntegral
    (by omega) Phi t f hf v w hv hw r]
  apply integral_congr_ae
  filter_upwards with s
  rw [brrsTwoRadiusSurfaceFourierIntervalIntegral_eq_fullStationary
    hd Phi v hv r s.1 t hr s.2.le]
  rw [brrsTwoRadiusFullStationaryIntervalIntegral_eq_allStationaryComponentSum
    hd Phi r s.1 t]

/-- Exact main/remainder form of the level-zero radial half-wave.  The first
outer integrand is the four travelling endpoint waves and the second is the
five explicitly retained middle-wave components. -/
theorem brrsDyadicHalfWave_levelZero_eq_endpoint_add_middle
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) (t : Real)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d → Complex))
    (v w : BRRSSpace d) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1)
    (r : Real) (hr : 0 ≤ r) :
    brrsDyadicHalfWave Phi 0 t f (r • v) =
      ∫ s : Ioi (0 : Real),
        (brrsTwoRadiusEndpointIntegralSum Phi d r s.1 t +
          brrsTwoRadiusMiddleComponentIntegralSum Phi d r s.1 t) *
            f (s.1 • w)
        ∂Measure.volumeIoiPow (d - 1) := by
  rw [brrsDyadicHalfWave_levelZero_eq_allStationaryComponentIntegralSum
    hd Phi t f hf v w hv hw r hr]
  apply integral_congr_ae
  filter_upwards with s
  rw [brrsTwoRadiusAllStationaryComponentIntegralSum_eq_endpoint_add_middle]

/-- Exact arbitrary-dyadic-scale radial stationary decomposition in dimensions
at least three.  It rescales the actual input before invoking the level-zero
all-nine stationary identity, so the middle-wave remainder is retained
explicitly. -/
theorem brrsDyadicHalfWave_eq_scaled_endpoint_add_middle
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d → Complex))
    (v w : BRRSSpace d) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1)
    (r : Real) (hr : 0 ≤ r) :
    brrsDyadicHalfWave Phi j t f (r • v) =
      ∫ s : Ioi (0 : Real),
        (brrsTwoRadiusEndpointIntegralSum Phi d ((2 : Real) ^ j * r) s.1
            ((2 : Real) ^ j * t) +
          brrsTwoRadiusMiddleComponentIntegralSum Phi d ((2 : Real) ^ j * r)
            s.1 ((2 : Real) ^ j * t)) *
          brrsSchwartzInputDilation ((2 : Real) ^ j)
            (pow_ne_zero j (by norm_num)) f (s.1 • w)
        ∂Measure.volumeIoiPow (d - 1) := by
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  let g : BRRSSchwartz d := brrsSchwartzInputDilation q hq.ne' f
  have hg : IsRadial (g : BRRSSpace d → Complex) :=
    brrsSchwartzInputDilation_isRadial q hq.ne' f hf
  calc
    brrsDyadicHalfWave Phi j t f (r • v) =
        brrsDyadicHalfWave Phi 0 (q * t) g (q • (r • v)) := by
      dsimp only [g, q]
      exact brrsDyadicHalfWave_eq_levelZero_scaledInput Phi j t f (r • v)
    _ = ∫ s : Ioi (0 : Real),
        (brrsTwoRadiusEndpointIntegralSum Phi d (q * r) s.1 (q * t) +
          brrsTwoRadiusMiddleComponentIntegralSum Phi d (q * r) s.1 (q * t)) *
            g (s.1 • w)
          ∂Measure.volumeIoiPow (d - 1) := by
      simpa only [smul_smul] using
        (brrsDyadicHalfWave_levelZero_eq_endpoint_add_middle hd Phi (q * t)
          g hg v w hv hw (q * r) (mul_nonneg hq.le hr))
    _ = ∫ s : Ioi (0 : Real),
        (brrsTwoRadiusEndpointIntegralSum Phi d ((2 : Real) ^ j * r) s.1
            ((2 : Real) ^ j * t) +
          brrsTwoRadiusMiddleComponentIntegralSum Phi d ((2 : Real) ^ j * r)
            s.1 ((2 : Real) ^ j * t)) *
          brrsSchwartzInputDilation ((2 : Real) ^ j)
            (pow_ne_zero j (by norm_num)) f (s.1 • w)
          ∂Measure.volumeIoiPow (d - 1) := by
      rfl

/-- The scaled all-nine stationary model is the actual dyadic radial
half-wave kernel in dimensions at least three.  This closes the outer radial
change-of-variables gap: the factor in the model is exactly the polar
Jacobian, and no stationary component is omitted. -/
theorem brrsDyadicHalfWave_eq_dyadicAllStationaryComponentIntegralSum
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d → Complex))
    (v w : BRRSSpace d) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1)
    (r : Real) (hr : 0 ≤ r) :
    brrsDyadicHalfWave Phi j t f (r • v) =
      ∫ s : Ioi (0 : Real),
        brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
          f (s.1 • w)
        ∂Measure.volumeIoiPow (d - 1) := by
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  let g : BRRSSchwartz d := brrsSchwartzInputDilation q hq.ne' f
  have hg : IsRadial (g : BRRSSpace d → Complex) :=
    brrsSchwartzInputDilation_isRadial q hq.ne' f hf
  let H : Real → Complex := fun u =>
    brrsTwoRadiusAllStationaryComponentIntegralSum Phi d (q * r) u (q * t) *
      g (u • w)
  have hscale := integral_volumeIoiPow_dilate (d - 1) H hq
  have hd_one : 1 ≤ d := by omega
  calc
    brrsDyadicHalfWave Phi j t f (r • v) =
        brrsDyadicHalfWave Phi 0 (q * t) g (q • (r • v)) := by
      dsimp only [g, q]
      exact brrsDyadicHalfWave_eq_levelZero_scaledInput Phi j t f (r • v)
    _ = ∫ u : Ioi (0 : Real), H u.1 ∂Measure.volumeIoiPow (d - 1) := by
      dsimp only [H]
      simpa only [smul_smul] using
        (brrsDyadicHalfWave_levelZero_eq_allStationaryComponentIntegralSum
          hd Phi (q * t) g hg v w hv hw (q * r) (mul_nonneg hq.le hr))
    _ = ∫ s : Ioi (0 : Real), ((q ^ d : Real) : Complex) * H (q * s.1)
          ∂Measure.volumeIoiPow (d - 1) := by
      symm
      simpa only [Nat.sub_add_cancel hd_one] using hscale
    _ = ∫ s : Ioi (0 : Real),
        brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
          f (s.1 • w)
        ∂Measure.volumeIoiPow (d - 1) := by
      apply integral_congr_ae
      filter_upwards with s
      have hray : g ((q * s.1) • w) = f (s.1 • w) :=
        brrsSchwartzInputDilation_scaled_ray_apply q hq.ne' f s.1 w
      change ((q ^ d : Real) : Complex) *
          (brrsTwoRadiusAllStationaryComponentIntegralSum Phi d (q * r)
            (q * s.1) (q * t) * g ((q * s.1) • w)) =
          brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
            f (s.1 • w)
      rw [hray]
      unfold brrsDyadicTwoRadiusAllStationaryComponentIntegralSum
      dsimp only [q]
      have hpow : ((2 : Real) ^ j) ^ d = (2 : Real) ^ (d * j) := by
        rw [← pow_mul, Nat.mul_comm]
      rw [Complex.real_smul, hpow]
      ring

/-- Main/remainder form of the actual dyadic radial half-wave in dimensions at
least three.  The two terms are the literal dyadic four-phase endpoint model
and the literal dyadic five-component middle model. -/
theorem brrsDyadicHalfWave_eq_dyadicEndpoint_add_middle
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d → Complex))
    (v w : BRRSSpace d) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1)
    (r : Real) (hr : 0 ≤ r) :
    brrsDyadicHalfWave Phi j t f (r • v) =
      ∫ s : Ioi (0 : Real),
        (brrsDyadicTwoRadiusEndpointIntegralSum Phi d j r s.1 t +
          brrsDyadicTwoRadiusMiddleComponentIntegralSum Phi d j r s.1 t) *
            f (s.1 • w)
        ∂Measure.volumeIoiPow (d - 1) := by
  rw [brrsDyadicHalfWave_eq_dyadicAllStationaryComponentIntegralSum
    hd Phi j t f hf v w hv hw r hr]
  apply integral_congr_ae
  filter_upwards with s
  rw [brrsDyadicTwoRadiusAllStationaryComponentIntegralSum_eq_endpoint_add_middle]

/-! ### Planar two-radius stationary expansion

The generic three-wave symbols above deliberately start in dimension three:
at `d = 2` the endpoint meridian density has order zero and its literal
quadratic symbol is `planarEndpointQuadraticIntegral`, not the truncating
`smoothEndpointQuadraticIntegral 0`.  The following separate interface is
therefore the exact circle counterpart.  It uses the same three labels and
carrier phases, so the four endpoint signs remain `t ± r ± s`, while all
five terms containing a middle wave are retained exactly.
-/

/-- The actual three circle-wave amplitudes after their linear radial
carriers have been extracted. -/
noncomputable def brrsPlanarSurfaceWaveAmplitude
    (part : BRRSSurfaceWavePart) (a rho : Real) : Complex :=
  (surfaceMass 1 : Complex) *
    match part with
    | .outgoing => planarEndpointQuadraticIntegral ((2 * Real.pi * a) * rho)
    | .incoming => planarEndpointQuadraticIntegral ((-(2 * Real.pi * a)) * rho)
    | .middle => coordinateMiddleMeridianLocalizedIntegral 0
        ((2 * Real.pi * a) * rho)

/-- The circle incoming endpoint amplitude is the conjugate of the outgoing
one, with no asymptotic approximation involved. -/
theorem brrsPlanarSurfaceWaveAmplitude_incoming_eq_conj_outgoing
    (a rho : Real) :
    brrsPlanarSurfaceWaveAmplitude .incoming a rho =
      starRingEnd Complex (brrsPlanarSurfaceWaveAmplitude .outgoing a rho) := by
  have hsign : (-(2 * Real.pi * a)) * rho = -((2 * Real.pi * a) * rho) := by
    ring
  unfold brrsPlanarSurfaceWaveAmplitude
  rw [hsign, planarEndpointQuadraticIntegral_neg_eq_conj]
  simp only [map_mul, Complex.conj_ofReal]

/-- The outgoing circle endpoint wave has the literal Fresnel leading carrier
and the full one-inverse-power normalized stationary remainder. -/
theorem exists_brrsPlanarSurfaceWaveAmplitude_outgoing_leading_asymptotic :
    ∃ C : Real, 0 < C ∧ ∀ a rho : Real, 1 ≤ (2 * Real.pi * a) * rho →
      ‖(Real.sqrt ((2 * Real.pi * a) * rho) : Complex) *
          brrsPlanarSurfaceWaveAmplitude .outgoing a rho -
        (surfaceMass 1 : Complex) *
          brrsEvenQuadraticBaseCarrier planarEndpointProfile‖ ≤
        C / ((2 * Real.pi * a) * rho) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_planarEndpointQuadraticIntegral_leading_asymptotic
  let mass : Real := surfaceMass 1
  have hmass : 0 < mass := by
    dsimp [mass]
    exact surfaceMass_pos (by omega)
  refine ⟨mass * C, mul_pos hmass hC, ?_⟩
  intro a rho hlambda
  let lambda : Real := (2 * Real.pi * a) * rho
  have hmain := hbound lambda (by simpa [lambda] using hlambda)
  have hamp :
      brrsPlanarSurfaceWaveAmplitude .outgoing a rho =
        (mass : Complex) * planarEndpointQuadraticIntegral lambda := by
    unfold brrsPlanarSurfaceWaveAmplitude
    dsimp [lambda, mass]
  rw [hamp]
  have hfactor :
      (Real.sqrt lambda : Complex) *
          ((mass : Complex) * planarEndpointQuadraticIntegral lambda) -
        (mass : Complex) * brrsEvenQuadraticBaseCarrier planarEndpointProfile =
          (mass : Complex) *
            ((Real.sqrt lambda : Complex) * planarEndpointQuadraticIntegral lambda -
              brrsEvenQuadraticBaseCarrier planarEndpointProfile) := by
    ring
  rw [show (2 * Real.pi * a) * rho = lambda by rfl, hfactor, norm_mul,
    Complex.norm_real, Real.norm_eq_abs, abs_of_pos hmass]
  calc
    mass * ‖(Real.sqrt lambda : Complex) * planarEndpointQuadraticIntegral lambda -
        brrsEvenQuadraticBaseCarrier planarEndpointProfile‖ ≤ mass * (C / lambda) :=
      mul_le_mul_of_nonneg_left hmain hmass.le
    _ = (mass * C) / lambda := by ring

/-- The incoming circle endpoint wave has the conjugate carrier and the same
one-inverse-power stationary remainder. -/
theorem exists_brrsPlanarSurfaceWaveAmplitude_incoming_leading_asymptotic :
    ∃ C : Real, 0 < C ∧ ∀ a rho : Real, 1 ≤ (2 * Real.pi * a) * rho →
      ‖(Real.sqrt ((2 * Real.pi * a) * rho) : Complex) *
          brrsPlanarSurfaceWaveAmplitude .incoming a rho -
        starRingEnd Complex
          ((surfaceMass 1 : Complex) *
            brrsEvenQuadraticBaseCarrier planarEndpointProfile)‖ ≤
        C / ((2 * Real.pi * a) * rho) := by
  obtain ⟨C, hC, hout⟩ :=
    exists_brrsPlanarSurfaceWaveAmplitude_outgoing_leading_asymptotic
  refine ⟨C, hC, ?_⟩
  intro a rho hlambda
  let lambda : Real := (2 * Real.pi * a) * rho
  let Aout : Complex := brrsPlanarSurfaceWaveAmplitude .outgoing a rho
  let Ain : Complex := brrsPlanarSurfaceWaveAmplitude .incoming a rho
  let K : Complex := (surfaceMass 1 : Complex) *
    brrsEvenQuadraticBaseCarrier planarEndpointProfile
  have hmain : ‖(Real.sqrt lambda : Complex) * Aout - K‖ ≤ C / lambda := by
    dsimp [lambda, Aout, K]
    exact hout a rho hlambda
  have hAin : Ain = starRingEnd Complex Aout := by
    dsimp [Ain, Aout]
    exact brrsPlanarSurfaceWaveAmplitude_incoming_eq_conj_outgoing a rho
  have hrewrite :
      (Real.sqrt lambda : Complex) * Ain - starRingEnd Complex K =
        starRingEnd Complex ((Real.sqrt lambda : Complex) * Aout - K) := by
    simp only [map_sub, map_mul, Complex.conj_ofReal]
    rw [hAin]
  change ‖(Real.sqrt lambda : Complex) * Ain - starRingEnd Complex K‖ ≤ C / lambda
  rw [hrewrite, RCLike.norm_conj]
  exact hmain

/-- One outgoing, incoming, or middle circle wave on a radial frequency
ray.  The carrier convention is shared with `brrsSurfaceWavePhase`. -/
noncomputable def brrsPlanarSurfaceWaveTerm
    (part : BRRSSurfaceWavePart) (a rho : Real) : Complex :=
  brrsPlanarSurfaceWaveAmplitude part a rho *
    Complex.exp (((brrsSurfaceWavePhase part a * rho : Real) : Complex) * Complex.I)

/-- The literal planar stationary sum is the sum of its outgoing, incoming,
and middle circle waves. -/
theorem brrsPlanarSurfaceWaveSum_eq_three_terms (a rho : Real) :
    brrsPlanarSurfaceWaveSum (a * rho) =
      brrsPlanarSurfaceWaveTerm .outgoing a rho +
        brrsPlanarSurfaceWaveTerm .incoming a rho +
          brrsPlanarSurfaceWaveTerm .middle a rho := by
  unfold brrsPlanarSurfaceWaveSum brrsPlanarSurfaceWaveTerm
    brrsPlanarSurfaceWaveAmplitude brrsSurfaceWavePhase
  have hphaseOut : -(2 * Real.pi * (a * rho)) = (-(2 * Real.pi * a)) * rho := by
    ring
  have hphaseIn : 2 * Real.pi * (a * rho) = (2 * Real.pi * a) * rho := by
    ring
  simp only [Complex.ofReal_neg, Complex.ofReal_mul, Complex.ofReal_ofNat, neg_mul, zero_mul,
      Complex.ofReal_zero, Complex.exp_zero, mul_one]
  rw [hphaseOut, hphaseIn]
  ring

/-- The exact circle surface factor on a positive radial ray, including its
two endpoint signs and its middle remainder. -/
theorem brrs_surfaceFourier_two_neg_smul_eq_three_terms
    {rho : Real} (hrho : 0 < rho) (x : BRRSSpace 2) :
    surfaceFourier 2 (-rho • x) =
      brrsPlanarSurfaceWaveTerm .outgoing ‖x‖ rho +
        brrsPlanarSurfaceWaveTerm .incoming ‖x‖ rho +
          brrsPlanarSurfaceWaveTerm .middle ‖x‖ rho := by
  rw [brrs_surfaceFourier_two_eq_stationaryWaveSum]
  have hnorm : ‖-rho • x‖ = rho * ‖x‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_neg, abs_of_pos hrho]
  rw [hnorm]
  simpa only [mul_comm] using brrsPlanarSurfaceWaveSum_eq_three_terms ‖x‖ rho

/-- Parity-complete stationary-phase replacement for the Bessel asymptotic
in BRRS (3.3), stated directly for `surfaceFourier` with Mathlib's `2 * pi`
normalization.  It covers the circle, every even nonplanar dimension, and
every odd nonplanar dimension.  In each case the identity is exact, both
endpoint carriers have their literal leading coefficients with a full
one-inverse-frequency normalized remainder, and the middle term has arbitrary
rapid decay. -/
theorem exists_brrs_surfaceFourier_threeWave_leading_remainder_all_dimensions
    (N : Nat) :
    (∃ C : Real, 0 < C ∧ ∀ (x : BRRSSpace 2) (rho : Real),
      0 < rho → 1 ≤ (2 * Real.pi * ‖x‖) * rho →
        surfaceFourier 2 (-rho • x) =
          brrsPlanarSurfaceWaveTerm .outgoing ‖x‖ rho +
            brrsPlanarSurfaceWaveTerm .incoming ‖x‖ rho +
              brrsPlanarSurfaceWaveTerm .middle ‖x‖ rho ∧
        ‖(Real.sqrt ((2 * Real.pi * ‖x‖) * rho) : Complex) *
            brrsPlanarSurfaceWaveAmplitude .outgoing ‖x‖ rho -
              (surfaceMass 1 : Complex) *
                brrsEvenQuadraticBaseCarrier planarEndpointProfile‖ ≤
            C / ((2 * Real.pi * ‖x‖) * rho) ∧
        ‖(Real.sqrt ((2 * Real.pi * ‖x‖) * rho) : Complex) *
            brrsPlanarSurfaceWaveAmplitude .incoming ‖x‖ rho -
              starRingEnd Complex
                ((surfaceMass 1 : Complex) *
                  brrsEvenQuadraticBaseCarrier planarEndpointProfile)‖ ≤
            C / ((2 * Real.pi * ‖x‖) * rho) ∧
        ‖brrsPlanarSurfaceWaveAmplitude .middle ‖x‖ rho‖ ≤
          C / ((2 * Real.pi * ‖x‖) * rho) ^ N) ∧
    (∀ n : Nat, ∃ C : Real, 0 < C ∧
      ∀ (x : BRRSSpace (2 * (n + 1) + 2)) (rho : Real),
      0 < rho → 1 ≤ (2 * Real.pi * ‖x‖) * rho →
        surfaceFourier (2 * (n + 1) + 2) (-rho • x) =
          brrsSurfaceWaveTerm (2 * (n + 1) + 2) .outgoing ‖x‖ rho +
            brrsSurfaceWaveTerm (2 * (n + 1) + 2) .incoming ‖x‖ rho +
              brrsSurfaceWaveTerm (2 * (n + 1) + 2) .middle ‖x‖ rho ∧
        ‖(Real.sqrt ((2 * Real.pi * ‖x‖) * rho) : Complex) *
            (((2 * ((2 * Real.pi * ‖x‖) * rho) : Real) : Complex) * Complex.I) ^
              (n + 1) *
            brrsSurfaceWaveAmplitude (2 * (n + 1) + 2) .outgoing ‖x‖ rho -
              (surfaceMass (2 * (n + 1) + 1) : Complex) *
                (brrsEvenQuadraticLeadingCoefficient (n + 1) *
                  brrsEvenQuadraticBaseCarrier
                    (smoothEndpointProfile (2 * (n + 1))))‖ ≤
            C / ((2 * Real.pi * ‖x‖) * rho) ∧
        ‖(Real.sqrt ((2 * Real.pi * ‖x‖) * rho) : Complex) *
            (-(((2 * ((2 * Real.pi * ‖x‖) * rho) : Real) : Complex) * Complex.I)) ^
              (n + 1) *
            brrsSurfaceWaveAmplitude (2 * (n + 1) + 2) .incoming ‖x‖ rho -
              starRingEnd Complex
                ((surfaceMass (2 * (n + 1) + 1) : Complex) *
                  (brrsEvenQuadraticLeadingCoefficient (n + 1) *
                    brrsEvenQuadraticBaseCarrier
                      (smoothEndpointProfile (2 * (n + 1)))))‖ ≤
            C / ((2 * Real.pi * ‖x‖) * rho) ∧
        ‖brrsSurfaceWaveAmplitude (2 * (n + 1) + 2) .middle ‖x‖ rho‖ ≤
          C / ((2 * Real.pi * ‖x‖) * rho) ^ N) ∧
    (∀ n : Nat, ∃ C : Real, 0 < C ∧
      ∀ (x : BRRSSpace (2 * n + 3)) (rho : Real),
      0 < rho → 1 ≤ (2 * Real.pi * ‖x‖) * rho →
        surfaceFourier (2 * n + 3) (-rho • x) =
          brrsSurfaceWaveTerm (2 * n + 3) .outgoing ‖x‖ rho +
            brrsSurfaceWaveTerm (2 * n + 3) .incoming ‖x‖ rho +
              brrsSurfaceWaveTerm (2 * n + 3) .middle ‖x‖ rho ∧
        ‖(((2 * ((2 * Real.pi * ‖x‖) * rho) : Real) : Complex) * Complex.I) ^
              (n + 1) *
            brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing ‖x‖ rho -
              (surfaceMass (2 * n + 2) : Complex) *
                (brrsOddQuadraticLeadingCoefficient n *
                  smoothEndpointProfile (2 * n + 1) 0)‖ ≤
            C / ((2 * Real.pi * ‖x‖) * rho) ∧
        ‖(-(((2 * ((2 * Real.pi * ‖x‖) * rho) : Real) : Complex) * Complex.I)) ^
              (n + 1) *
            brrsSurfaceWaveAmplitude (2 * n + 3) .incoming ‖x‖ rho -
              starRingEnd Complex
                ((surfaceMass (2 * n + 2) : Complex) *
                  (brrsOddQuadraticLeadingCoefficient n *
                    smoothEndpointProfile (2 * n + 1) 0))‖ ≤
            C / ((2 * Real.pi * ‖x‖) * rho) ∧
        ‖brrsSurfaceWaveAmplitude (2 * n + 3) .middle ‖x‖ rho‖ ≤
          C / ((2 * Real.pi * ‖x‖) * rho) ^ N) := by
  constructor
  · obtain ⟨Cout, hCout, hout⟩ :=
      exists_brrsPlanarSurfaceWaveAmplitude_outgoing_leading_asymptotic
    obtain ⟨Cin, hCin, hin⟩ :=
      exists_brrsPlanarSurfaceWaveAmplitude_incoming_leading_asymptotic
    obtain ⟨Cmid, hCmid, hmid⟩ :=
      exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_middle_decay 2 0 N
    let C : Real := Cout + Cin + Cmid
    have hC : 0 < C := by
      dsimp [C]
      positivity
    refine ⟨C, hC, ?_⟩
    intro x rho hrho hlambda
    let lambda : Real := (2 * Real.pi * ‖x‖) * rho
    have hlambda_pos : 0 < lambda :=
      lt_of_lt_of_le zero_lt_one (by simpa [lambda] using hlambda)
    have hlargeabs : 1 ≤ |(2 * Real.pi * ‖x‖) * rho| := by
      simpa [lambda, abs_of_nonneg hlambda_pos.le] using hlambda
    have hmiddle0 :
        ‖brrsPlanarSurfaceWaveAmplitude .middle ‖x‖ rho‖ ≤ Cmid / lambda ^ N := by
      simpa [brrsPlanarSurfaceWaveAmplitude, brrsSurfaceWaveAmplitude, lambda,
        abs_of_nonneg hlambda_pos.le] using hmid ‖x‖ rho hlargeabs
    refine ⟨brrs_surfaceFourier_two_neg_smul_eq_three_terms hrho x, ?_, ?_, ?_⟩
    · have hmain := hout ‖x‖ rho hlambda
      calc
        ‖(Real.sqrt ((2 * Real.pi * ‖x‖) * rho) : Complex) *
            brrsPlanarSurfaceWaveAmplitude .outgoing ‖x‖ rho -
              (surfaceMass 1 : Complex) *
                brrsEvenQuadraticBaseCarrier planarEndpointProfile‖ ≤ Cout / lambda := by
          simpa [lambda] using hmain
        _ ≤ C / lambda := by
          apply div_le_div_of_nonneg_right
          · dsimp [C]
            linarith
          · exact hlambda_pos.le
        _ = C / ((2 * Real.pi * ‖x‖) * rho) := by rfl
    · have hmain := hin ‖x‖ rho hlambda
      calc
        ‖(Real.sqrt ((2 * Real.pi * ‖x‖) * rho) : Complex) *
            brrsPlanarSurfaceWaveAmplitude .incoming ‖x‖ rho -
              starRingEnd Complex
                ((surfaceMass 1 : Complex) *
                  brrsEvenQuadraticBaseCarrier planarEndpointProfile)‖ ≤ Cin / lambda := by
          simpa [lambda] using hmain
        _ ≤ C / lambda := by
          apply div_le_div_of_nonneg_right
          · dsimp [C]
            linarith
          · exact hlambda_pos.le
        _ = C / ((2 * Real.pi * ‖x‖) * rho) := by rfl
    · calc
        ‖brrsPlanarSurfaceWaveAmplitude .middle ‖x‖ rho‖ ≤ Cmid / lambda ^ N := hmiddle0
        _ ≤ C / lambda ^ N := by
          apply div_le_div_of_nonneg_right
          · dsimp [C]
            linarith
          · exact (pow_pos hlambda_pos N).le
        _ = C / ((2 * Real.pi * ‖x‖) * rho) ^ N := by rfl
  constructor
  · intro n
    obtain ⟨Cbase, hCbase, hbase⟩ :=
      exists_brrs_surfaceFourier_threeWave_replacement_bounds (2 * (n + 1) + 2) N
        (by omega)
    obtain ⟨Cout, hCout, hout⟩ :=
      exists_brrsSurfaceWaveAmplitude_outgoing_even_leading_asymptotic (n + 1)
    obtain ⟨Cin, hCin, hin⟩ :=
      exists_brrsSurfaceWaveAmplitude_incoming_even_leading_asymptotic (n + 1)
    let C : Real := Cbase + Cout + Cin
    have hC : 0 < C := by
      dsimp [C]
      positivity
    refine ⟨C, hC, ?_⟩
    intro x rho hrho hlambda
    let lambda : Real := (2 * Real.pi * ‖x‖) * rho
    have hlambda_pos : 0 < lambda :=
      lt_of_lt_of_le zero_lt_one (by simpa [lambda] using hlambda)
    have hlargeabs : 1 ≤ |(2 * Real.pi * ‖x‖) * rho| := by
      simpa [lambda, abs_of_nonneg hlambda_pos.le] using hlambda
    obtain ⟨hexact, -, -, hmiddle⟩ := hbase x rho hrho hlargeabs
    refine ⟨hexact, ?_, ?_, ?_⟩
    · have hmain := hout ‖x‖ rho hlambda
      calc
        ‖(Real.sqrt ((2 * Real.pi * ‖x‖) * rho) : Complex) *
            (((2 * ((2 * Real.pi * ‖x‖) * rho) : Real) : Complex) * Complex.I) ^
              (n + 1) *
            brrsSurfaceWaveAmplitude (2 * (n + 1) + 2) .outgoing ‖x‖ rho -
              (surfaceMass (2 * (n + 1) + 1) : Complex) *
                (brrsEvenQuadraticLeadingCoefficient (n + 1) *
                  brrsEvenQuadraticBaseCarrier
                    (smoothEndpointProfile (2 * (n + 1))))‖ ≤ Cout / lambda := by
          simpa [lambda] using hmain
        _ ≤ C / lambda := by
          apply div_le_div_of_nonneg_right
          · dsimp [C]
            linarith
          · exact hlambda_pos.le
        _ = C / ((2 * Real.pi * ‖x‖) * rho) := by rfl
    · have hmain := hin ‖x‖ rho hlambda
      calc
        ‖(Real.sqrt ((2 * Real.pi * ‖x‖) * rho) : Complex) *
            (-(((2 * ((2 * Real.pi * ‖x‖) * rho) : Real) : Complex) * Complex.I)) ^
              (n + 1) *
            brrsSurfaceWaveAmplitude (2 * (n + 1) + 2) .incoming ‖x‖ rho -
              starRingEnd Complex
                ((surfaceMass (2 * (n + 1) + 1) : Complex) *
                  (brrsEvenQuadraticLeadingCoefficient (n + 1) *
                    brrsEvenQuadraticBaseCarrier
                      (smoothEndpointProfile (2 * (n + 1)))))‖ ≤ Cin / lambda := by
          simpa [lambda] using hmain
        _ ≤ C / lambda := by
          apply div_le_div_of_nonneg_right
          · dsimp [C]
            linarith
          · exact hlambda_pos.le
        _ = C / ((2 * Real.pi * ‖x‖) * rho) := by rfl
    · calc
        ‖brrsSurfaceWaveAmplitude (2 * (n + 1) + 2) .middle ‖x‖ rho‖ ≤
            Cbase / |(2 * Real.pi * ‖x‖) * rho| ^ N := hmiddle
        _ = Cbase / lambda ^ N := by
          rw [show |(2 * Real.pi * ‖x‖) * rho| = lambda by
            simpa [lambda] using abs_of_nonneg hlambda_pos.le]
        _ ≤ C / lambda ^ N := by
          apply div_le_div_of_nonneg_right
          · dsimp [C]
            linarith
          · exact (pow_pos hlambda_pos N).le
        _ = C / ((2 * Real.pi * ‖x‖) * rho) ^ N := by rfl
  · intro n
    exact exists_brrs_surfaceFourier_odd_threeWave_leading_remainder n N

/-- The positive-ray circle identity, obtained by reflecting the ray before
using the negative-ray identity. -/
theorem brrs_surfaceFourier_two_pos_smul_eq_three_terms
    {rho s : Real} (hrho : 0 < rho) (hs : 0 ≤ s)
    (v : BRRSSpace 2) (hv : ‖v‖ = 1) :
    surfaceFourier 2 (s • (rho • v)) =
      brrsPlanarSurfaceWaveTerm .outgoing s rho +
        brrsPlanarSurfaceWaveTerm .incoming s rho +
          brrsPlanarSurfaceWaveTerm .middle s rho := by
  have hrewrite : s • (rho • v) = -rho • (-s • v) := by
    module
  rw [hrewrite, brrs_surfaceFourier_two_neg_smul_eq_three_terms hrho]
  have hnorm : ‖-s • v‖ = s := by
    rw [norm_smul, Real.norm_eq_abs, abs_neg, abs_of_nonneg hs, hv, mul_one]
  rw [hnorm]

/-- The exact full three-by-three circle-wave product associated to the
level-zero two-radius radial kernel. -/
noncomputable def brrsPlanarTwoRadiusFullStationaryIntervalIntegral
    (Phi : BRRSAnnularCutoff) (r s t : Real) : Complex :=
  ∫ rho in (1 / 32 : Real)..1,
    ((rho ^ (2 - 1) : Real) : Complex) *
      (brrsPlanarSurfaceWaveSum (r * rho) *
        (brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho *
          brrsPlanarSurfaceWaveSum (s * rho)))

/-- Exact two-radius stationary expansion for the circle.  In particular,
the product retains all nine pairs of outgoing, incoming, and middle waves;
only the four endpoint--endpoint pairs carry the four signs `t ± r ± s`. -/
theorem brrsTwoRadiusSurfaceFourierIntervalIntegral_two_eq_fullPlanarStationary
    (Phi : BRRSAnnularCutoff) (v : BRRSSpace 2) (hv : ‖v‖ = 1)
    (r s t : Real) (hr : 0 ≤ r) (hs : 0 ≤ s) :
    brrsTwoRadiusSurfaceFourierIntervalIntegral Phi 2 v r s t =
      brrsPlanarTwoRadiusFullStationaryIntervalIntegral Phi r s t := by
  unfold brrsTwoRadiusSurfaceFourierIntervalIntegral
    brrsPlanarTwoRadiusFullStationaryIntervalIntegral
  apply intervalIntegral.integral_congr
  intro rho hrho
  have hrhoIcc : rho ∈ Icc (1 / 32 : Real) 1 := by
    simpa only [uIcc_of_le (by norm_num : (1 / 32 : Real) ≤ 1)] using hrho
  have hrhopos : 0 < rho := by
    linarith [hrhoIcc.1]
  have houter : surfaceFourier 2 (-rho • (r • v)) =
      brrsPlanarSurfaceWaveSum (r * rho) := by
    calc
      surfaceFourier 2 (-rho • (r • v)) =
          brrsPlanarSurfaceWaveTerm .outgoing ‖r • v‖ rho +
            brrsPlanarSurfaceWaveTerm .incoming ‖r • v‖ rho +
              brrsPlanarSurfaceWaveTerm .middle ‖r • v‖ rho :=
        brrs_surfaceFourier_two_neg_smul_eq_three_terms hrhopos (r • v)
      _ = brrsPlanarSurfaceWaveTerm .outgoing r rho +
            brrsPlanarSurfaceWaveTerm .incoming r rho +
              brrsPlanarSurfaceWaveTerm .middle r rho := by
        have hnorm : ‖r • v‖ = r := by
          rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hr, hv, mul_one]
        rw [hnorm]
      _ = brrsPlanarSurfaceWaveSum (r * rho) :=
        (brrsPlanarSurfaceWaveSum_eq_three_terms r rho).symm
  have hinner : surfaceFourier 2 (s • (rho • v)) =
      brrsPlanarSurfaceWaveSum (s * rho) := by
    calc
      surfaceFourier 2 (s • (rho • v)) =
          brrsPlanarSurfaceWaveTerm .outgoing s rho +
            brrsPlanarSurfaceWaveTerm .incoming s rho +
              brrsPlanarSurfaceWaveTerm .middle s rho :=
        brrs_surfaceFourier_two_pos_smul_eq_three_terms hrhopos hs v hv
      _ = brrsPlanarSurfaceWaveSum (s * rho) :=
        (brrsPlanarSurfaceWaveSum_eq_three_terms s rho).symm
  dsimp
  rw [houter, hinner]

/-- The literal radial level-zero half-wave in the plane has the preceding
exact planar two-radius stationary kernel formula. -/
theorem brrsDyadicHalfWave_levelZero_two_eq_fullPlanarStationary
    (Phi : BRRSAnnularCutoff) (t : Real) (f : BRRSSchwartz 2)
    (hf : IsRadial (f : BRRSSpace 2 → Complex))
    (v w : BRRSSpace 2) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1)
    (r : Real) (hr : 0 ≤ r) :
    brrsDyadicHalfWave Phi 0 t f (r • v) =
      ∫ s : Ioi (0 : Real),
        brrsPlanarTwoRadiusFullStationaryIntervalIntegral Phi r s.1 t *
          f (s.1 • w)
        ∂Measure.volumeIoiPow (2 - 1) := by
  rw [brrsDyadicHalfWave_levelZero_eq_twoRadiusSurfaceFourierIntervalIntegral
    (by norm_num : 0 < 2) Phi t f hf v w hv hw r]
  apply integral_congr_ae
  filter_upwards with s
  rw [brrsTwoRadiusSurfaceFourierIntervalIntegral_two_eq_fullPlanarStationary
    Phi v hv r s.1 t hr s.2.le]

/-- Every actual planar stationary amplitude is smooth in the compact radial
frequency variable. -/
theorem contDiff_brrsPlanarSurfaceWaveAmplitude
    (part : BRRSSurfaceWavePart) (a : Real) :
    ContDiff Real (⊤ : ENat)
      (fun rho : Real => brrsPlanarSurfaceWaveAmplitude part a rho) := by
  cases part with
  | outgoing =>
      unfold brrsPlanarSurfaceWaveAmplitude
      exact contDiff_const.mul
        (contDiff_planarEndpointQuadraticIntegral.comp (by fun_prop))
  | incoming =>
      unfold brrsPlanarSurfaceWaveAmplitude
      exact contDiff_const.mul
        (contDiff_planarEndpointQuadraticIntegral.comp (by fun_prop))
  | middle =>
      unfold brrsPlanarSurfaceWaveAmplitude
      exact contDiff_const.mul
        ((contDiff_coordinateMiddleMeridianLocalizedIntegral 0).comp (by fun_prop))

/-- The compact planar coefficient of one named pair of circle waves. -/
noncomputable def brrsPlanarTwoRadiusStationaryComponentIntegral
    (Phi : BRRSAnnularCutoff) (partR partS : BRRSSurfaceWavePart)
    (r s t : Real) : Complex :=
  ∫ rho in (1 / 32 : Real)..1,
    ((rho ^ (2 - 1) : Real) : Complex) *
      (brrsPlanarSurfaceWaveTerm partR r rho *
        (brrsPlanarSurfaceWaveTerm partS s rho *
          brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho))

/-- The exact planar stationary components are symmetric in the two radial
wave factors, just as in higher dimensions. -/
theorem brrsPlanarTwoRadiusStationaryComponentIntegral_swap
    (Phi : BRRSAnnularCutoff) (partR partS : BRRSSurfaceWavePart)
    (r s t : Real) :
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi partR partS r s t =
      brrsPlanarTwoRadiusStationaryComponentIntegral Phi partS partR s r t := by
  unfold brrsPlanarTwoRadiusStationaryComponentIntegral
  apply intervalIntegral.integral_congr
  intro rho _
  ring

/-- The full exact circle kernel written as nine named pairs of outgoing,
incoming, and middle waves. -/
noncomputable def brrsPlanarTwoRadiusAllStationaryComponentIntegralSum
    (Phi : BRRSAnnularCutoff) (r s t : Real) : Complex :=
  ((brrsPlanarTwoRadiusStationaryComponentIntegral Phi .outgoing .outgoing r s t +
      brrsPlanarTwoRadiusStationaryComponentIntegral Phi .outgoing .incoming r s t) +
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .outgoing .middle r s t) +
      (((brrsPlanarTwoRadiusStationaryComponentIntegral Phi .incoming .outgoing r s t +
          brrsPlanarTwoRadiusStationaryComponentIntegral Phi .incoming .incoming r s t) +
        brrsPlanarTwoRadiusStationaryComponentIntegral Phi .incoming .middle r s t) +
          ((brrsPlanarTwoRadiusStationaryComponentIntegral Phi .middle .outgoing r s t +
            brrsPlanarTwoRadiusStationaryComponentIntegral Phi .middle .incoming r s t) +
              brrsPlanarTwoRadiusStationaryComponentIntegral Phi .middle .middle r s t))

/-- The exact planar all-nine stationary kernel is symmetric in its two
radial variables.  This is an identity of the literal nine components, not a
comparison with an auxiliary model. -/
theorem brrsPlanarTwoRadiusAllStationaryComponentIntegralSum_swap
    (Phi : BRRSAnnularCutoff) (r s t : Real) :
    brrsPlanarTwoRadiusAllStationaryComponentIntegralSum Phi r s t =
      brrsPlanarTwoRadiusAllStationaryComponentIntegralSum Phi s r t := by
  unfold brrsPlanarTwoRadiusAllStationaryComponentIntegralSum
  rw [brrsPlanarTwoRadiusStationaryComponentIntegral_swap Phi .outgoing .outgoing r s t,
    brrsPlanarTwoRadiusStationaryComponentIntegral_swap Phi .outgoing .incoming r s t,
    brrsPlanarTwoRadiusStationaryComponentIntegral_swap Phi .outgoing .middle r s t,
    brrsPlanarTwoRadiusStationaryComponentIntegral_swap Phi .incoming .outgoing r s t,
    brrsPlanarTwoRadiusStationaryComponentIntegral_swap Phi .incoming .incoming r s t,
    brrsPlanarTwoRadiusStationaryComponentIntegral_swap Phi .incoming .middle r s t,
    brrsPlanarTwoRadiusStationaryComponentIntegral_swap Phi .middle .outgoing r s t,
    brrsPlanarTwoRadiusStationaryComponentIntegral_swap Phi .middle .incoming r s t,
    brrsPlanarTwoRadiusStationaryComponentIntegral_swap Phi .middle .middle r s t]
  ring

/-- The five exact planar components that contain a middle circle wave. -/
noncomputable def brrsPlanarTwoRadiusMiddleComponentIntegralSum
    (Phi : BRRSAnnularCutoff) (r s t : Real) : Complex :=
  brrsPlanarTwoRadiusStationaryComponentIntegral Phi .outgoing .middle r s t +
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .incoming .middle r s t +
      (brrsPlanarTwoRadiusStationaryComponentIntegral Phi .middle .outgoing r s t +
        brrsPlanarTwoRadiusStationaryComponentIntegral Phi .middle .incoming r s t +
          brrsPlanarTwoRadiusStationaryComponentIntegral Phi .middle .middle r s t)

/-- Exact main/remainder split of the planar nine-component stationary
kernel, with its four endpoint/end-point terms displayed before the named
middle remainder. -/
theorem brrsPlanarTwoRadiusAllStationaryComponentIntegralSum_eq_fourEndpoint_add_middle
    (Phi : BRRSAnnularCutoff) (r s t : Real) :
    brrsPlanarTwoRadiusAllStationaryComponentIntegralSum Phi r s t =
      (brrsPlanarTwoRadiusStationaryComponentIntegral Phi .outgoing .outgoing r s t +
        brrsPlanarTwoRadiusStationaryComponentIntegral Phi .outgoing .incoming r s t +
          brrsPlanarTwoRadiusStationaryComponentIntegral Phi .incoming .outgoing r s t +
            brrsPlanarTwoRadiusStationaryComponentIntegral Phi .incoming .incoming r s t) +
        brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi r s t := by
  unfold brrsPlanarTwoRadiusAllStationaryComponentIntegralSum
    brrsPlanarTwoRadiusMiddleComponentIntegralSum
  ring

/-- Expanding the product of the two actual planar three-wave factors gives
the nine literal planar stationary component integrals.  Thus no middle term
is hidden or discarded before subsequent estimates are applied. -/
theorem brrsPlanarTwoRadiusFullStationaryIntervalIntegral_eq_allStationaryComponentSum
    (Phi : BRRSAnnularCutoff) (r s t : Real) :
    brrsPlanarTwoRadiusFullStationaryIntervalIntegral Phi r s t =
      brrsPlanarTwoRadiusAllStationaryComponentIntegralSum Phi r s t := by
  let F : BRRSSurfaceWavePart → BRRSSurfaceWavePart → Real → Complex :=
    fun partR partS rho =>
      ((rho ^ (2 - 1) : Real) : Complex) *
        (brrsPlanarSurfaceWaveTerm partR r rho *
          (brrsPlanarSurfaceWaveTerm partS s rho *
            brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho))
  have hFcont (partR partS : BRRSSurfaceWavePart) :
      Continuous (F partR partS) := by
    have hdensity : Continuous (fun rho : Real =>
        ((rho ^ (2 - 1) : Real) : Complex)) :=
      (show ContDiff Real (⊤ : ENat) (fun rho : Real =>
        ((rho ^ (2 - 1) : Real) : Complex)) from
        Complex.ofRealCLM.contDiff.comp (contDiff_id.pow (2 - 1))).continuous
    have htermR : Continuous (fun rho : Real =>
        brrsPlanarSurfaceWaveTerm partR r rho) := by
      unfold brrsPlanarSurfaceWaveTerm
      exact (contDiff_brrsPlanarSurfaceWaveAmplitude partR r).continuous.mul
        (by fun_prop)
    have htermS : Continuous (fun rho : Real =>
        brrsPlanarSurfaceWaveTerm partS s rho) := by
      unfold brrsPlanarSurfaceWaveTerm
      exact (contDiff_brrsPlanarSurfaceWaveAmplitude partS s).continuous.mul
        (by fun_prop)
    have hprofile : Continuous (fun rho : Real =>
        brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho) := by
      unfold brrsDyadicHalfWaveKernelRadialProfile
      simp only [pow_zero, inv_one, mul_one]
      apply Continuous.mul
      · fun_prop
      · exact (Phi.symbol.smooth (⊤ : ENat)).continuous.comp (by fun_prop)
    dsimp only [F]
    exact hdensity.mul (htermR.mul (htermS.mul hprofile))
  have hF (partR partS : BRRSSurfaceWavePart) :
      IntervalIntegrable (F partR partS) volume (1 / 32 : Real) 1 :=
    (hFcont partR partS).intervalIntegrable _ _
  have hrowOut : IntervalIntegrable (fun rho : Real =>
      (F .outgoing .outgoing rho + F .outgoing .incoming rho) +
        F .outgoing .middle rho) volume (1 / 32 : Real) 1 :=
    ((hF .outgoing .outgoing).add (hF .outgoing .incoming)).add
      (hF .outgoing .middle)
  have hrowIn : IntervalIntegrable (fun rho : Real =>
      (F .incoming .outgoing rho + F .incoming .incoming rho) +
        F .incoming .middle rho) volume (1 / 32 : Real) 1 :=
    ((hF .incoming .outgoing).add (hF .incoming .incoming)).add
      (hF .incoming .middle)
  have hrowMid : IntervalIntegrable (fun rho : Real =>
      (F .middle .outgoing rho + F .middle .incoming rho) +
        F .middle .middle rho) volume (1 / 32 : Real) 1 :=
    ((hF .middle .outgoing).add (hF .middle .incoming)).add
      (hF .middle .middle)
  have hrowOut_split :
      (∫ rho in (1 / 32 : Real)..1,
        (F .outgoing .outgoing rho + F .outgoing .incoming rho) +
          F .outgoing .middle rho) =
        (∫ rho in (1 / 32 : Real)..1, F .outgoing .outgoing rho) +
          (∫ rho in (1 / 32 : Real)..1, F .outgoing .incoming rho) +
            ∫ rho in (1 / 32 : Real)..1, F .outgoing .middle rho := by
    rw [intervalIntegral.integral_add
      ((hF .outgoing .outgoing).add (hF .outgoing .incoming))
      (hF .outgoing .middle)]
    rw [intervalIntegral.integral_add
      (hF .outgoing .outgoing) (hF .outgoing .incoming)]
  have hrowIn_split :
      (∫ rho in (1 / 32 : Real)..1,
        (F .incoming .outgoing rho + F .incoming .incoming rho) +
          F .incoming .middle rho) =
        (∫ rho in (1 / 32 : Real)..1, F .incoming .outgoing rho) +
          (∫ rho in (1 / 32 : Real)..1, F .incoming .incoming rho) +
            ∫ rho in (1 / 32 : Real)..1, F .incoming .middle rho := by
    rw [intervalIntegral.integral_add
      ((hF .incoming .outgoing).add (hF .incoming .incoming))
      (hF .incoming .middle)]
    rw [intervalIntegral.integral_add
      (hF .incoming .outgoing) (hF .incoming .incoming)]
  have hrowMid_split :
      (∫ rho in (1 / 32 : Real)..1,
        (F .middle .outgoing rho + F .middle .incoming rho) +
          F .middle .middle rho) =
        (∫ rho in (1 / 32 : Real)..1, F .middle .outgoing rho) +
          (∫ rho in (1 / 32 : Real)..1, F .middle .incoming rho) +
            ∫ rho in (1 / 32 : Real)..1, F .middle .middle rho := by
    rw [intervalIntegral.integral_add
      ((hF .middle .outgoing).add (hF .middle .incoming))
      (hF .middle .middle)]
    rw [intervalIntegral.integral_add
      (hF .middle .outgoing) (hF .middle .incoming)]
  have hpoint :
      (∫ rho in (1 / 32 : Real)..1,
        ((rho ^ (2 - 1) : Real) : Complex) *
          (brrsPlanarSurfaceWaveSum (r * rho) *
            (brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho *
              brrsPlanarSurfaceWaveSum (s * rho)))) =
        ∫ rho in (1 / 32 : Real)..1,
          ((F .outgoing .outgoing rho + F .outgoing .incoming rho) +
            F .outgoing .middle rho) +
              (((F .incoming .outgoing rho + F .incoming .incoming rho) +
                F .incoming .middle rho) +
                  ((F .middle .outgoing rho + F .middle .incoming rho) +
                    F .middle .middle rho)) := by
    apply intervalIntegral.integral_congr
    intro rho _
    dsimp only [F]
    rw [brrsPlanarSurfaceWaveSum_eq_three_terms r rho,
      brrsPlanarSurfaceWaveSum_eq_three_terms s rho]
    ring
  have hsplit :
      (∫ rho in (1 / 32 : Real)..1,
        ((rho ^ (2 - 1) : Real) : Complex) *
          (brrsPlanarSurfaceWaveSum (r * rho) *
            (brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho *
              brrsPlanarSurfaceWaveSum (s * rho)))) =
        ((∫ rho in (1 / 32 : Real)..1, F .outgoing .outgoing rho) +
          (∫ rho in (1 / 32 : Real)..1, F .outgoing .incoming rho) +
            ∫ rho in (1 / 32 : Real)..1, F .outgoing .middle rho) +
              (((∫ rho in (1 / 32 : Real)..1, F .incoming .outgoing rho) +
                (∫ rho in (1 / 32 : Real)..1, F .incoming .incoming rho) +
                  ∫ rho in (1 / 32 : Real)..1, F .incoming .middle rho) +
                    ((∫ rho in (1 / 32 : Real)..1, F .middle .outgoing rho) +
                      (∫ rho in (1 / 32 : Real)..1, F .middle .incoming rho) +
                        ∫ rho in (1 / 32 : Real)..1, F .middle .middle rho)) := by
    rw [hpoint]
    rw [intervalIntegral.integral_add hrowOut (hrowIn.add hrowMid)]
    rw [intervalIntegral.integral_add hrowIn hrowMid]
    rw [hrowOut_split, hrowIn_split, hrowMid_split]
  unfold brrsPlanarTwoRadiusFullStationaryIntervalIntegral
    brrsPlanarTwoRadiusAllStationaryComponentIntegralSum
    brrsPlanarTwoRadiusStationaryComponentIntegral
  simpa only [F] using hsplit

/-- Compatibility of the corrected repository-normalized radial kernel with
the literal all-nine circle stationary kernel at level zero.  As in the
nonplanar identity, the displayed `s` factor changes the ordinary `ds`
kernel into the polar source measure used by the stationary calculation. -/
theorem brrsRadialBesselKernel_two_levelZero_eq_allPlanarStationary
    (Phi : BRRSAnnularCutoff) (r s t : Real) (v : BRRSSpace 2) (hv : ‖v‖ = 1)
    (hr : 0 ≤ r) (hs : 0 < s) :
    brrsRadialBesselKernel Phi 2 v 0 r s t =
      ((s ^ (2 - 1) : Real) : Complex) *
        brrsPlanarTwoRadiusAllStationaryComponentIntegralSum Phi r s t := by
  rw [brrsRadialBesselKernel_eq_twoRadius_surfaceFourier Phi 0 t r s v hv]
  have hinner :
      (∫ rho : Ioi (0 : Real),
        surfaceFourier 2 (-rho.1 • (r • v)) *
          (brrsDyadicHalfWaveSymbol Phi 0 t (rho.1 • v) *
            surfaceFourier 2 (s • (rho.1 • v)))
          ∂Measure.volumeIoiPow (2 - 1)) =
        brrsTwoRadiusSurfaceFourierIntervalIntegral Phi 2 v r s t := by
    simpa using
      (brrs_levelZero_twoRadiusInnerIntegral_eq_intervalIntegral
        (d := 2) Phi t r v hv (⟨s, hs⟩ : Ioi (0 : Real)))
  rw [hinner,
    brrsTwoRadiusSurfaceFourierIntervalIntegral_two_eq_fullPlanarStationary
      Phi v hv r s t hr hs.le,
    brrsPlanarTwoRadiusFullStationaryIntervalIntegral_eq_allStationaryComponentSum]

/-- The literal level-zero planar half-wave on radial Schwartz data is an
outer radial integral of all nine exact planar stationary components. -/
theorem brrsDyadicHalfWave_levelZero_two_eq_allPlanarStationaryComponentIntegralSum
    (Phi : BRRSAnnularCutoff) (t : Real) (f : BRRSSchwartz 2)
    (hf : IsRadial (f : BRRSSpace 2 → Complex))
    (v w : BRRSSpace 2) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1)
    (r : Real) (hr : 0 ≤ r) :
    brrsDyadicHalfWave Phi 0 t f (r • v) =
      ∫ s : Ioi (0 : Real),
        brrsPlanarTwoRadiusAllStationaryComponentIntegralSum Phi r s.1 t *
          f (s.1 • w)
        ∂Measure.volumeIoiPow (2 - 1) := by
  rw [brrsDyadicHalfWave_levelZero_two_eq_fullPlanarStationary
    Phi t f hf v w hv hw r hr]
  apply integral_congr_ae
  filter_upwards with s
  rw [brrsPlanarTwoRadiusFullStationaryIntervalIntegral_eq_allStationaryComponentSum
    Phi r s.1 t]

/-! ### Planar endpoint--endpoint high-radius symbols -/

/-- On the level-zero annulus, every derivative of either actual circle
endpoint amplitude has its sharp half-order high-radius decay.  This uses the
separate planar stationary symbol from `OscillatoryIntegralAux`; it does
not specialize the higher-dimensional endpoint construction. -/
theorem exists_norm_iteratedDeriv_brrsPlanarSurfaceWaveAmplitude_endpoint_highRadius_decay
    (k : Nat) (part : BRRSSurfaceWavePart)
    (hpart : part = .outgoing ∨ part = .incoming) :
    ∃ C : Real, 0 < C ∧ ∀ a rho : Real, 16 ≤ a →
      rho ∈ Icc (1 / 32 : Real) 1 →
      ‖iteratedDeriv k (fun u : Real =>
        brrsPlanarSurfaceWaveAmplitude part a u) rho‖ ≤
        C / Real.sqrt (a / 16) := by
  rcases hpart with rfl | rfl
  · obtain ⟨B, hB, hbound⟩ :=
      exists_iteratedDeriv_planarEndpointQuadraticIntegral_abs_decay k
    let C0 : Real := ‖(surfaceMass 1 : Complex)‖ * B + 1
    have hC0 : 0 < C0 := by
      dsimp [C0]
      positivity
    refine ⟨C0 * 128 ^ k, mul_pos hC0 (pow_pos (by norm_num) _), ?_⟩
    intro a rho ha hrho
    obtain ⟨hfreq, hamp, hscale, hsqrt⟩ :=
      brrs_highRadius_frequency_geometry ha hrho
    have hk : ((k : ENat) : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) := by
      exact_mod_cast le_top
    have hden : 0 < quadraticMomentScale (2 * k)
        |(2 * Real.pi * a) * rho| := by
      unfold quadraticMomentScale
      apply pow_pos
      exact Real.sqrt_pos.2 (lt_of_lt_of_le zero_lt_one hfreq)
    have hpow : 0 ≤ |2 * Real.pi * a| ^ k :=
      pow_nonneg (abs_nonneg _) _
    have hconst : ‖(surfaceMass 1 : Complex)‖ * B ≤ C0 := by
      dsimp [C0]
      linarith
    unfold brrsPlanarSurfaceWaveAmplitude
    rw [iteratedDeriv_const_mul_field,
      iteratedDeriv_comp_const_smul
        (contDiff_planarEndpointQuadraticIntegral.of_le hk),
      norm_mul, norm_smul, Real.norm_eq_abs, abs_pow]
    calc
      ‖(surfaceMass 1 : Complex)‖ *
          (|2 * Real.pi * a| ^ k *
            ‖iteratedDeriv k planarEndpointQuadraticIntegral
              ((2 * Real.pi * a) * rho)‖) ≤
          ‖(surfaceMass 1 : Complex)‖ *
            (|2 * Real.pi * a| ^ k *
              (B / quadraticMomentScale (2 * k)
                |(2 * Real.pi * a) * rho|)) := by
            gcongr
            exact hbound _ hfreq
      _ = (‖(surfaceMass 1 : Complex)‖ * B) * |2 * Real.pi * a| ^ k /
            quadraticMomentScale (2 * k) |(2 * Real.pi * a) * rho| := by
            ring
      _ ≤ C0 * |2 * Real.pi * a| ^ k /
            quadraticMomentScale (2 * k) |(2 * Real.pi * a) * rho| := by
            exact div_le_div_of_nonneg_right
              (mul_le_mul_of_nonneg_right hconst hpow) hden.le
      _ ≤ (C0 * 128 ^ k) / Real.sqrt (a / 16) := by
            simpa only [Nat.reduceSub, zero_add, pow_one] using
              (brrs_endpoint_stationary_denominator_le_scale
                (d := 2) (k := k) (s := a / 16)
                (a := 2 * Real.pi * a)
                (lambda := |(2 * Real.pi * a) * rho|)
                (C := C0) (L := 128)
                (by omega) (by linarith) hC0.le (by positivity) hamp
                (lt_of_lt_of_le zero_lt_one hfreq) hsqrt)
  · obtain ⟨B, hB, hbound⟩ :=
      exists_iteratedDeriv_planarEndpointQuadraticIntegral_abs_decay k
    let C0 : Real := ‖(surfaceMass 1 : Complex)‖ * B + 1
    have hC0 : 0 < C0 := by
      dsimp [C0]
      positivity
    refine ⟨C0 * 128 ^ k, mul_pos hC0 (pow_pos (by norm_num) _), ?_⟩
    intro a rho ha hrho
    obtain ⟨hfreq, hamp, hscale, hsqrt⟩ :=
      brrs_highRadius_frequency_geometry ha hrho
    have hsign : |(-(2 * Real.pi * a)) * rho| =
        |(2 * Real.pi * a) * rho| := by
      rw [show (-(2 * Real.pi * a)) * rho =
        -((2 * Real.pi * a) * rho) by ring, abs_neg]
    have hsignAmp : |-(2 * Real.pi * a)| = |2 * Real.pi * a| := by
      rw [abs_neg]
    have hk : ((k : ENat) : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) := by
      exact_mod_cast le_top
    have hden : 0 < quadraticMomentScale (2 * k)
        |(2 * Real.pi * a) * rho| := by
      unfold quadraticMomentScale
      apply pow_pos
      exact Real.sqrt_pos.2 (lt_of_lt_of_le zero_lt_one hfreq)
    have hpow : 0 ≤ |2 * Real.pi * a| ^ k :=
      pow_nonneg (abs_nonneg _) _
    have hconst : ‖(surfaceMass 1 : Complex)‖ * B ≤ C0 := by
      dsimp [C0]
      linarith
    unfold brrsPlanarSurfaceWaveAmplitude
    rw [iteratedDeriv_const_mul_field,
      iteratedDeriv_comp_const_smul
        (contDiff_planarEndpointQuadraticIntegral.of_le hk),
      norm_mul, norm_smul, Real.norm_eq_abs, abs_pow]
    calc
      ‖(surfaceMass 1 : Complex)‖ *
          (|-(2 * Real.pi * a)| ^ k *
            ‖iteratedDeriv k planarEndpointQuadraticIntegral
              ((-(2 * Real.pi * a)) * rho)‖) ≤
          ‖(surfaceMass 1 : Complex)‖ *
            (|-(2 * Real.pi * a)| ^ k *
              (B / quadraticMomentScale (2 * k)
                |(-(2 * Real.pi * a)) * rho|)) := by
            gcongr
            exact hbound _ (by simpa [hsign] using hfreq)
      _ = (‖(surfaceMass 1 : Complex)‖ * B) * |2 * Real.pi * a| ^ k /
            quadraticMomentScale (2 * k) |(2 * Real.pi * a) * rho| := by
            rw [hsignAmp, hsign]
            ring
      _ ≤ C0 * |2 * Real.pi * a| ^ k /
            quadraticMomentScale (2 * k) |(2 * Real.pi * a) * rho| := by
            exact div_le_div_of_nonneg_right
              (mul_le_mul_of_nonneg_right hconst hpow) hden.le
      _ ≤ (C0 * 128 ^ k) / Real.sqrt (a / 16) := by
            simpa only [Nat.reduceSub, zero_add, pow_one] using
              (brrs_endpoint_stationary_denominator_le_scale
                (d := 2) (k := k) (s := a / 16)
                (a := 2 * Real.pi * a)
                (lambda := |(2 * Real.pi * a) * rho|)
                (C := C0) (L := 128)
                (by omega) (by linarith) hC0.le (by positivity) hamp
                (lt_of_lt_of_le zero_lt_one hfreq) hsqrt)

/-- The compact radial coefficient after extracting the carrier from one
actual planar stationary wave. -/
noncomputable def brrsPlanarStationaryWaveRadialCoefficient
    (Phi : BRRSAnnularCutoff) (part : BRRSSurfaceWavePart)
    (a rho : Real) : Complex :=
  brrsStationaryWaveRadialFixedFactor Phi 2 rho *
    brrsPlanarSurfaceWaveAmplitude part a rho

/-- The compact amplitude after extracting both endpoint carriers from a
planar two-radius component. -/
noncomputable def brrsPlanarTwoRadiusStationaryCoefficient
    (Phi : BRRSAnnularCutoff) (partR partS : BRRSSurfaceWavePart)
    (r s rho : Real) : Complex :=
  ((rho ^ (2 - 1) : Real) : Complex) *
    (brrsPlanarSurfaceWaveAmplitude partR r rho *
      (brrsPlanarSurfaceWaveAmplitude partS s rho *
        Phi.symbol (2 * Real.pi * rho)))

/-- One planar two-radius coefficient factors into the outer circle-wave
amplitude and the compact coefficient of the inner circle wave. -/
theorem brrsPlanarTwoRadiusStationaryCoefficient_eq_amplitude_mul_coefficient
    (Phi : BRRSAnnularCutoff) (partR partS : BRRSSurfaceWavePart)
    (r s rho : Real) :
    brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho =
      brrsPlanarSurfaceWaveAmplitude partR r rho *
        brrsPlanarStationaryWaveRadialCoefficient Phi partS s rho := by
  unfold brrsPlanarTwoRadiusStationaryCoefficient
    brrsPlanarStationaryWaveRadialCoefficient
    brrsStationaryWaveRadialFixedFactor
  ring

/-- Exact oscillatory normal form for every named planar two-radius
component.  For endpoint pairs its frequency is one of `2π(t ± r ± s)`. -/
theorem brrsPlanarTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp
    (Phi : BRRSAnnularCutoff) (partR partS : BRRSSurfaceWavePart)
    (r s t : Real) :
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi partR partS r s t =
      ∫ rho in (1 / 32 : Real)..1,
        brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho *
          oscillatoryExp
            (brrsSurfaceWavePhase partR r + brrsSurfaceWavePhase partS s +
              2 * Real.pi * t) rho := by
  unfold brrsPlanarTwoRadiusStationaryComponentIntegral
    brrsPlanarTwoRadiusStationaryCoefficient
  apply intervalIntegral.integral_congr
  intro rho _
  unfold brrsPlanarSurfaceWaveTerm brrsDyadicHalfWaveKernelRadialProfile
    oscillatoryExp
  simp only [pow_zero, inv_one, mul_one]
  let zR : Complex :=
    ((brrsSurfaceWavePhase partR r * rho : Real) : Complex) * Complex.I
  let zS : Complex :=
    ((brrsSurfaceWavePhase partS s * rho : Real) : Complex) * Complex.I
  let zT : Complex := ((2 * Real.pi * t * rho : Real) : Complex) * Complex.I
  let z : Complex :=
    (((brrsSurfaceWavePhase partR r + brrsSurfaceWavePhase partS s +
      2 * Real.pi * t) * rho : Real) : Complex) * Complex.I
  have hz : zR + zS + zT = z := by
    dsimp only [zR, zS, zT, z]
    push_cast
    ring
  change
    ((rho ^ (2 - 1) : Real) : Complex) *
        ((brrsPlanarSurfaceWaveAmplitude partR r rho * Complex.exp zR) *
          ((brrsPlanarSurfaceWaveAmplitude partS s rho * Complex.exp zS) *
            (Complex.exp zT * Phi.symbol (2 * Real.pi * rho)))) =
      ((rho ^ (2 - 1) : Real) : Complex) *
        (brrsPlanarSurfaceWaveAmplitude partR r rho *
          (brrsPlanarSurfaceWaveAmplitude partS s rho *
            Phi.symbol (2 * Real.pi * rho))) *
          Complex.exp z
  calc
    ((rho ^ (2 - 1) : Real) : Complex) *
        ((brrsPlanarSurfaceWaveAmplitude partR r rho * Complex.exp zR) *
          ((brrsPlanarSurfaceWaveAmplitude partS s rho * Complex.exp zS) *
            (Complex.exp zT * Phi.symbol (2 * Real.pi * rho)))) =
      ((rho ^ (2 - 1) : Real) : Complex) *
        (brrsPlanarSurfaceWaveAmplitude partR r rho *
          (brrsPlanarSurfaceWaveAmplitude partS s rho *
            Phi.symbol (2 * Real.pi * rho))) *
          (Complex.exp zR * Complex.exp zS * Complex.exp zT) := by
        ring
    _ = ((rho ^ (2 - 1) : Real) : Complex) *
        (brrsPlanarSurfaceWaveAmplitude partR r rho *
          (brrsPlanarSurfaceWaveAmplitude partS s rho *
            Phi.symbol (2 * Real.pi * rho))) *
          Complex.exp (zR + zS + zT) := by
        rw [← Complex.exp_add, ← Complex.exp_add]
    _ = ((rho ^ (2 - 1) : Real) : Complex) *
        (brrsPlanarSurfaceWaveAmplitude partR r rho *
          (brrsPlanarSurfaceWaveAmplitude partS s rho *
            Phi.symbol (2 * Real.pi * rho))) *
          Complex.exp z := by
        rw [hz]

/-- The one-radius planar coefficient is smooth in the compact frequency
variable. -/
theorem contDiff_brrsPlanarStationaryWaveRadialCoefficient
    (Phi : BRRSAnnularCutoff) (part : BRRSSurfaceWavePart) (a : Real) :
    ContDiff Real (⊤ : ENat)
      (fun rho : Real => brrsPlanarStationaryWaveRadialCoefficient Phi part a rho) := by
  unfold brrsPlanarStationaryWaveRadialCoefficient
  exact (contDiff_brrsStationaryWaveRadialFixedFactor Phi 2).mul
    (contDiff_brrsPlanarSurfaceWaveAmplitude part a)

theorem brrsPlanarStationaryLeibnizConstant_right_div
    (n : Nat) (A B q : Real) (hq : q ≠ 0) :
    brrsStationaryLeibnizConstant n A (B / q) =
      brrsStationaryLeibnizConstant n A B / q := by
  unfold brrsStationaryLeibnizConstant
  rw [Finset.sum_div]
  apply Finset.sum_congr rfl
  intro i hi
  field_simp [hq]

/-- Uniform all-order high-radius bounds for a compact planar endpoint
coefficient. -/
theorem exists_unif_iteratedDeriv_brrsPlanStatWaveRadialCoeff_endpoint_highRad_decay
    (N : Nat) (Phi : BRRSAnnularCutoff) (part : BRRSSurfaceWavePart)
    (hpart : part = .outgoing ∨ part = .incoming) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ a rho : Real, 16 ≤ a →
      rho ∈ Icc (1 / 32 : Real) 1 →
      ‖iteratedDeriv k (fun u : Real =>
        brrsPlanarStationaryWaveRadialCoefficient Phi part a u) rho‖ ≤
        C / Real.sqrt (a / 16) := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_iteratedDeriv_brrsStationaryWaveRadialFixedFactor_bound Phi 2 N
  choose B hBpos hBbound using fun k : Nat =>
    exists_norm_iteratedDeriv_brrsPlanarSurfaceWaveAmplitude_endpoint_highRadius_decay
      k part hpart
  let B' : Real := ∑ k ∈ Finset.range (N + 1), B k
  have hB' : 0 < B' := by
    have hzero : 0 ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    have hle : B 0 ≤ B' := by
      dsimp [B']
      exact Finset.single_le_sum (fun k hk => (hBpos k).le) hzero
    exact lt_of_lt_of_le (hBpos 0) hle
  let C : Real := ∑ l ∈ Finset.range (N + 1),
    brrsStationaryLeibnizConstant l A B'
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact brrsStationaryLeibnizConstant_nonneg l hA.le hB'.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk a rho ha hrho
  let fixed : Real → Complex := brrsStationaryWaveRadialFixedFactor Phi 2
  let physical : Real → Complex := fun u : Real =>
    brrsPlanarSurfaceWaveAmplitude part a u
  have hfixed : ContDiff Real (⊤ : ENat) fixed := by
    dsimp [fixed]
    exact contDiff_brrsStationaryWaveRadialFixedFactor Phi 2
  have hphysical : ContDiff Real (⊤ : ENat) physical := by
    dsimp [physical]
    exact contDiff_brrsPlanarSurfaceWaveAmplitude part a
  have hqpos : 0 < Real.sqrt (a / 16) := by
    apply Real.sqrt_pos.2
    linarith
  have hphysicalbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l physical rho‖ ≤ B' / Real.sqrt (a / 16) := by
    intro l hl
    have hlmem : l ∈ Finset.range (N + 1) :=
      Finset.mem_range.mpr (by omega)
    have hle : B l ≤ B' := by
      dsimp [B']
      exact Finset.single_le_sum (fun m hm => (hBpos m).le) hlmem
    exact (hBbound l a rho ha hrho).trans
      (div_le_div_of_nonneg_right hle hqpos.le)
  have hprod := norm_iteratedDeriv_mul_le_brrsStationaryLeibnizConstant
    (n := k) hfixed hphysical hA.le
    (div_nonneg hB'.le hqpos.le)
    (fun l hl => hAbound l (hl.trans hk) rho hrho)
    hphysicalbound
  have hfactorfun : (fun u : Real =>
      brrsPlanarStationaryWaveRadialCoefficient Phi part a u) =
        fun u : Real => fixed u * physical u := by
    funext u
    dsimp [fixed, physical]
    rfl
  rw [hfactorfun]
  have hCbound : brrsStationaryLeibnizConstant k A B' ≤ C := by
    unfold C
    have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    exact Finset.single_le_sum
      (fun l hl => brrsStationaryLeibnizConstant_nonneg l hA.le hB'.le) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real => fixed u * physical u) rho‖ ≤
        brrsStationaryLeibnizConstant k A
          (B' / Real.sqrt (a / 16)) := hprod
    _ = brrsStationaryLeibnizConstant k A B' /
          Real.sqrt (a / 16) := by
      rw [brrsPlanarStationaryLeibnizConstant_right_div k A B'
        (Real.sqrt (a / 16)) hqpos.ne']
    _ ≤ C / Real.sqrt (a / 16) :=
      div_le_div_of_nonneg_right hCbound hqpos.le
    _ ≤ (C + 1) / Real.sqrt (a / 16) :=
      div_le_div_of_nonneg_right (by linarith) hqpos.le

private theorem brrsPlanarStationaryLeibnizConstant_two_div
    (n : Nat) (A B q r : Real) (hq : q ≠ 0) (hr : r ≠ 0) :
    brrsStationaryLeibnizConstant n (A / q) (B / r) =
      brrsStationaryLeibnizConstant n A B / (q * r) := by
  unfold brrsStationaryLeibnizConstant
  rw [Finset.sum_div]
  apply Finset.sum_congr rfl
  intro i hi
  field_simp [hq, hr]

/-- Uniform all-order high-radius bounds for an actual planar
endpoint--endpoint two-radius coefficient. -/
theorem exists_uniform_iteratedDeriv_brrsPlanarTwoRadStatCoeff_endpoint_highRad_decay
    (N : Nat) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart)
    (hpartR : partR = .outgoing ∨ partR = .incoming)
    (hpartS : partS = .outgoing ∨ partS = .incoming) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ r s rho : Real,
      16 ≤ r → 16 ≤ s → rho ∈ Icc (1 / 32 : Real) 1 →
      ‖iteratedDeriv k (fun u : Real =>
        brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s u) rho‖ ≤
        C / (Real.sqrt (r / 16) * Real.sqrt (s / 16)) := by
  choose A hApos hAbound using fun k : Nat =>
    exists_norm_iteratedDeriv_brrsPlanarSurfaceWaveAmplitude_endpoint_highRadius_decay
      k partR hpartR
  obtain ⟨B, hB, hBbound⟩ :=
    exists_unif_iteratedDeriv_brrsPlanStatWaveRadialCoeff_endpoint_highRad_decay
      N Phi partS hpartS
  let A' : Real := ∑ k ∈ Finset.range (N + 1), A k
  have hA' : 0 < A' := by
    have hzero : 0 ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    have hle : A 0 ≤ A' := by
      dsimp [A']
      exact Finset.single_le_sum (fun k hk => (hApos k).le) hzero
    exact lt_of_lt_of_le (hApos 0) hle
  let C : Real := ∑ l ∈ Finset.range (N + 1),
    brrsStationaryLeibnizConstant l A' B
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact brrsStationaryLeibnizConstant_nonneg l hA'.le hB.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk r s rho hr hs hrho
  let left : Real → Complex := fun u : Real =>
    brrsPlanarSurfaceWaveAmplitude partR r u
  let right : Real → Complex := fun u : Real =>
    brrsPlanarStationaryWaveRadialCoefficient Phi partS s u
  have hleft : ContDiff Real (⊤ : ENat) left := by
    dsimp [left]
    exact contDiff_brrsPlanarSurfaceWaveAmplitude partR r
  have hright : ContDiff Real (⊤ : ENat) right := by
    dsimp [right]
    exact contDiff_brrsPlanarStationaryWaveRadialCoefficient Phi partS s
  have hqpos : 0 < Real.sqrt (r / 16) := by
    apply Real.sqrt_pos.2
    linarith
  have hrpos : 0 < Real.sqrt (s / 16) := by
    apply Real.sqrt_pos.2
    linarith
  have hleftbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l left rho‖ ≤ A' / Real.sqrt (r / 16) := by
    intro l hl
    have hlmem : l ∈ Finset.range (N + 1) :=
      Finset.mem_range.mpr (by omega)
    have hle : A l ≤ A' := by
      dsimp [A']
      exact Finset.single_le_sum (fun m hm => (hApos m).le) hlmem
    exact (hAbound l r rho hr hrho).trans
      (div_le_div_of_nonneg_right hle hqpos.le)
  have hrightbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l right rho‖ ≤ B / Real.sqrt (s / 16) := by
    intro l hl
    exact hBbound l (hl.trans hk) s rho hs hrho
  have hprod := norm_iteratedDeriv_mul_le_brrsStationaryLeibnizConstant
    (n := k) hleft hright
    (div_nonneg hA'.le hqpos.le) (div_nonneg hB.le hrpos.le)
    hleftbound hrightbound
  have hfactorfun : (fun u : Real =>
      brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s u) =
        fun u : Real => left u * right u := by
    funext u
    dsimp [left, right]
    exact brrsPlanarTwoRadiusStationaryCoefficient_eq_amplitude_mul_coefficient
      Phi partR partS r s u
  rw [hfactorfun]
  have hCbound : brrsStationaryLeibnizConstant k A' B ≤ C := by
    unfold C
    have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    exact Finset.single_le_sum
      (fun l hl => brrsStationaryLeibnizConstant_nonneg l hA'.le hB.le) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real => left u * right u) rho‖ ≤
        brrsStationaryLeibnizConstant k
          (A' / Real.sqrt (r / 16)) (B / Real.sqrt (s / 16)) := hprod
    _ = brrsStationaryLeibnizConstant k A' B /
          (Real.sqrt (r / 16) * Real.sqrt (s / 16)) := by
      rw [brrsPlanarStationaryLeibnizConstant_two_div k A' B
        (Real.sqrt (r / 16)) (Real.sqrt (s / 16)) hqpos.ne' hrpos.ne']
    _ ≤ C / (Real.sqrt (r / 16) * Real.sqrt (s / 16)) :=
      div_le_div_of_nonneg_right hCbound (mul_pos hqpos hrpos).le
    _ ≤ (C + 1) / (Real.sqrt (r / 16) * Real.sqrt (s / 16)) :=
      div_le_div_of_nonneg_right (by linarith) (mul_pos hqpos hrpos).le

/-- The planar two-radius coefficient is smooth in its compact frequency
variable. -/
theorem contDiff_brrsPlanarTwoRadiusStationaryCoefficient
    (Phi : BRRSAnnularCutoff) (partR partS : BRRSSurfaceWavePart)
    (r s : Real) :
    ContDiff Real (⊤ : ENat) (fun rho : Real =>
      brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho) := by
  rw [show (fun rho : Real =>
      brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho) =
        fun rho : Real => brrsPlanarSurfaceWaveAmplitude partR r rho *
          brrsPlanarStationaryWaveRadialCoefficient Phi partS s rho by
      funext rho
      exact brrsPlanarTwoRadiusStationaryCoefficient_eq_amplitude_mul_coefficient
        Phi partR partS r s rho]
  exact (contDiff_brrsPlanarSurfaceWaveAmplitude partR r).mul
    (contDiff_brrsPlanarStationaryWaveRadialCoefficient Phi partS s)

/-- Uniform all-order rapid high-radius decay for the planar middle
stationary-wave amplitude.  It is the literal two-dimensional middle symbol,
presented in the planar stationary-wave API. -/
theorem exists_unif_iteratedDeriv_brrsPlanSurfWaveAmplitude_middle_highRad_rapidDecay
    (N M : Nat) (hM : 2 ≤ M) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ a rho : Real, 16 ≤ a →
      rho ∈ Icc (1 / 32 : Real) 1 →
      ‖iteratedDeriv k (fun u : Real =>
        brrsPlanarSurfaceWaveAmplitude .middle a u) rho‖ ≤
        C / (Real.sqrt (a / 16)) ^ (M - 1) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_unif_iteratedDeriv_brrsSurfWaveAmplitude_two_middle_highRad_rapidDecay
      N M hM
  refine ⟨C, hC, ?_⟩
  intro k hk a rho ha hrho
  have hplanar : (fun u : Real =>
      brrsPlanarSurfaceWaveAmplitude .middle a u) =
      fun u : Real => brrsSurfaceWaveAmplitude 2 .middle a u := by
    funext u
    rfl
  rw [hplanar]
  exact hbound k hk a rho ha hrho

/-- The compact planar radial coefficient inherits the all-order rapid
high-radius decay of its middle stationary-wave factor. -/
theorem exists_unif_iteratedDeriv_brrsPlanStatWaveRadialCoeff_mid_highRad_rapidDecay
    (N M : Nat) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ a rho : Real, 16 ≤ a →
      rho ∈ Icc (1 / 32 : Real) 1 →
      ‖iteratedDeriv k (fun u : Real =>
        brrsPlanarStationaryWaveRadialCoefficient Phi .middle a u) rho‖ ≤
        C / (Real.sqrt (a / 16)) ^ (M - 1) := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_iteratedDeriv_brrsStationaryWaveRadialFixedFactor_bound Phi 2 N
  obtain ⟨B, hB, hBbound⟩ :=
    exists_unif_iteratedDeriv_brrsPlanSurfWaveAmplitude_middle_highRad_rapidDecay
      N M hM
  let C : Real := ∑ l ∈ Finset.range (N + 1),
    brrsStationaryLeibnizConstant l A B
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact brrsStationaryLeibnizConstant_nonneg l hA.le hB.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk a rho ha hrho
  let fixed : Real → Complex := brrsStationaryWaveRadialFixedFactor Phi 2
  let physical : Real → Complex := fun u : Real =>
    brrsPlanarSurfaceWaveAmplitude .middle a u
  have hfixed : ContDiff Real (⊤ : ENat) fixed := by
    dsimp [fixed]
    exact contDiff_brrsStationaryWaveRadialFixedFactor Phi 2
  have hphysical : ContDiff Real (⊤ : ENat) physical := by
    dsimp [physical]
    exact contDiff_brrsPlanarSurfaceWaveAmplitude .middle a
  have hqpos : 0 < (Real.sqrt (a / 16)) ^ (M - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hphysicalBound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l physical rho‖ ≤
        B / (Real.sqrt (a / 16)) ^ (M - 1) := by
    intro l hl
    exact hBbound l (hl.trans hk) a rho ha hrho
  have hprod := norm_iteratedDeriv_mul_le_brrsStationaryLeibnizConstant
    (n := k) hfixed hphysical hA.le
    (div_nonneg hB.le hqpos.le)
    (fun l hl => hAbound l (hl.trans hk) rho hrho)
    hphysicalBound
  have hfactorfun : (fun u : Real =>
      brrsPlanarStationaryWaveRadialCoefficient Phi .middle a u) =
      fun u : Real => fixed u * physical u := by
    funext u
    dsimp [fixed, physical]
    rfl
  rw [hfactorfun]
  have hCbound : brrsStationaryLeibnizConstant k A B ≤ C := by
    unfold C
    have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    exact Finset.single_le_sum
      (fun l hl => brrsStationaryLeibnizConstant_nonneg l hA.le hB.le) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real => fixed u * physical u) rho‖ ≤
        brrsStationaryLeibnizConstant k A
          (B / (Real.sqrt (a / 16)) ^ (M - 1)) := hprod
    _ = brrsStationaryLeibnizConstant k A B /
          (Real.sqrt (a / 16)) ^ (M - 1) := by
      rw [brrsPlanarStationaryLeibnizConstant_right_div k A B
        ((Real.sqrt (a / 16)) ^ (M - 1)) hqpos.ne']
    _ ≤ C / (Real.sqrt (a / 16)) ^ (M - 1) :=
      div_le_div_of_nonneg_right hCbound hqpos.le
    _ ≤ (C + 1) / (Real.sqrt (a / 16)) ^ (M - 1) :=
      div_le_div_of_nonneg_right (by linarith) hqpos.le

/-- A planar two-radius coefficient with a middle factor in its first radius
has rapid decay in that radius and the sharp half-order decay of an endpoint
factor in its second radius. -/
theorem exists_unif_iteratedDeriv_brrsPlanTwoRadStatCoeff_mid_endpt_highRad_rapidDecay
    (N M : Nat) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff)
    (partS : BRRSSurfaceWavePart)
    (hpartS : partS = .outgoing ∨ partS = .incoming) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ r s rho : Real,
      16 ≤ r → 16 ≤ s → rho ∈ Icc (1 / 32 : Real) 1 →
      ‖iteratedDeriv k (fun u : Real =>
        brrsPlanarTwoRadiusStationaryCoefficient Phi .middle partS r s u) rho‖ ≤
        C / ((Real.sqrt (r / 16)) ^ (M - 1) *
          Real.sqrt (s / 16)) := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_unif_iteratedDeriv_brrsPlanSurfWaveAmplitude_middle_highRad_rapidDecay
      N M hM
  obtain ⟨B, hB, hBbound⟩ :=
    exists_unif_iteratedDeriv_brrsPlanStatWaveRadialCoeff_endpoint_highRad_decay
      N Phi partS hpartS
  let C : Real := ∑ l ∈ Finset.range (N + 1),
    brrsStationaryLeibnizConstant l A B
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact brrsStationaryLeibnizConstant_nonneg l hA.le hB.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk r s rho hr hs hrho
  let left : Real → Complex := fun u : Real =>
    brrsPlanarSurfaceWaveAmplitude .middle r u
  let right : Real → Complex := fun u : Real =>
    brrsPlanarStationaryWaveRadialCoefficient Phi partS s u
  have hleft : ContDiff Real (⊤ : ENat) left := by
    dsimp [left]
    exact contDiff_brrsPlanarSurfaceWaveAmplitude .middle r
  have hright : ContDiff Real (⊤ : ENat) right := by
    dsimp [right]
    exact contDiff_brrsPlanarStationaryWaveRadialCoefficient Phi partS s
  have hqpos : 0 < (Real.sqrt (r / 16)) ^ (M - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hspos : 0 < Real.sqrt (s / 16) := by
    apply Real.sqrt_pos.2
    linarith
  have hleftbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l left rho‖ ≤
        A / (Real.sqrt (r / 16)) ^ (M - 1) := by
    intro l hl
    exact hAbound l (hl.trans hk) r rho hr hrho
  have hrightbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l right rho‖ ≤ B / Real.sqrt (s / 16) := by
    intro l hl
    exact hBbound l (hl.trans hk) s rho hs hrho
  have hprod := norm_iteratedDeriv_mul_le_brrsStationaryLeibnizConstant
    (n := k) hleft hright
    (div_nonneg hA.le hqpos.le) (div_nonneg hB.le hspos.le)
    hleftbound hrightbound
  have hfactorfun : (fun u : Real =>
      brrsPlanarTwoRadiusStationaryCoefficient Phi .middle partS r s u) =
      fun u : Real => left u * right u := by
    funext u
    dsimp [left, right]
    exact brrsPlanarTwoRadiusStationaryCoefficient_eq_amplitude_mul_coefficient
      Phi .middle partS r s u
  rw [hfactorfun]
  have hCbound : brrsStationaryLeibnizConstant k A B ≤ C := by
    unfold C
    have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    exact Finset.single_le_sum
      (fun l hl => brrsStationaryLeibnizConstant_nonneg l hA.le hB.le) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real => left u * right u) rho‖ ≤
        brrsStationaryLeibnizConstant k
          (A / (Real.sqrt (r / 16)) ^ (M - 1))
          (B / Real.sqrt (s / 16)) := hprod
    _ = brrsStationaryLeibnizConstant k A B /
          ((Real.sqrt (r / 16)) ^ (M - 1) * Real.sqrt (s / 16)) := by
      rw [brrsPlanarStationaryLeibnizConstant_two_div k A B
        ((Real.sqrt (r / 16)) ^ (M - 1))
        (Real.sqrt (s / 16)) hqpos.ne' hspos.ne']
    _ ≤ C / ((Real.sqrt (r / 16)) ^ (M - 1) * Real.sqrt (s / 16)) :=
      div_le_div_of_nonneg_right hCbound (mul_pos hqpos hspos).le
    _ ≤ (C + 1) / ((Real.sqrt (r / 16)) ^ (M - 1) * Real.sqrt (s / 16)) :=
      div_le_div_of_nonneg_right (by linarith) (mul_pos hqpos hspos).le

end

