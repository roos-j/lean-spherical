open scoped BigOperators Convolution ENNReal FourierTransform Topology

noncomputable section

/-- Combining the cone bound with repeated integration by parts yields the
bounded rapid profile for each actual planar endpoint--endpoint component. -/
theorem exists_norm_intervalInteg_brrsPlanTwoRadStatCoeff_endpoint_highRad_profile_le
    (N : Nat) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart)
    (hpartR : partR = .outgoing ∨ partR = .incoming)
    (hpartS : partS = .outgoing ∨ partS = .incoming) :
    ∃ C : Real, 0 < C ∧ ∀ r s freq : Real, 16 ≤ r → 16 ≤ s →
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho *
          oscillatoryExp freq rho‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16) * Real.sqrt (s / 16))) *
          brrsStationaryRapidProfile N freq := by
  obtain ⟨C0, hC0, huniform⟩ :=
    exists_norm_intervalInteg_brrsPlanTwoRadStatCoeff_endpoint_highRad_uniform_le
      Phi partR partS hpartR hpartS
  obtain ⟨C1, hC1, hdecay⟩ :=
    exists_norm_intervalIntegral_brrsPlanarTwoRadStatCoeff_endpoint_highRad_le
      N Phi partR partS hpartR hpartS
  let C : Real := C0 + C1
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro r s freq hr hs
  let q : Real := Real.sqrt (r / 16) * Real.sqrt (s / 16)
  let A : Real := (1 - (1 / 32 : Real)) * (C / q)
  have hqpos : 0 < q := by
    dsimp [q]
    apply mul_pos <;> apply Real.sqrt_pos.2 <;> linarith
  have hAnonneg : 0 ≤ A := by
    dsimp [A]
    positivity
  have hC0le : C0 ≤ C := by
    dsimp [C]
    linarith
  have hC1le : C1 ≤ C := by
    dsimp [C]
    linarith
  change ‖∫ rho in (1 / 32 : Real)..1,
      brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho *
        oscillatoryExp freq rho‖ ≤ A * brrsStationaryRapidProfile N freq
  by_cases hfreq : freq = 0
  · have hcomp : (1 - (1 / 32 : Real)) * (C0 / q) ≤ A := by
      dsimp [A]
      apply mul_le_mul_of_nonneg_left
      · exact div_le_div_of_nonneg_right hC0le hqpos.le
      · norm_num
    simpa [brrsStationaryRapidProfile, hfreq] using
      (huniform r s 0 hr hs).trans hcomp
  · rw [brrsStationaryRapidProfile, if_neg hfreq]
    let z : Real := (1 / |freq|) ^ N
    have huniform' : ‖∫ rho in (1 / 32 : Real)..1,
        brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho *
          oscillatoryExp freq rho‖ ≤ A := by
      refine (huniform r s freq hr hs).trans ?_
      dsimp [A, q]
      apply mul_le_mul_of_nonneg_left
      · exact div_le_div_of_nonneg_right hC0le hqpos.le
      · norm_num
    have hdecay' : ‖∫ rho in (1 / 32 : Real)..1,
        brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho *
          oscillatoryExp freq rho‖ ≤ z * A := by
      refine (hdecay r s hr hs hfreq).trans ?_
      dsimp [z, A, q]
      apply mul_le_mul_of_nonneg_left
      · apply mul_le_mul_of_nonneg_left
        · exact div_le_div_of_nonneg_right hC1le hqpos.le
        · norm_num
      · positivity
    calc
      ‖∫ rho in (1 / 32 : Real)..1,
          brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho *
            oscillatoryExp freq rho‖ ≤ min A (z * A) := le_min huniform' hdecay'
      _ = A * min 1 z := by
        calc
          min A (z * A) = min (A * 1) (A * z) := by
            congr 1 <;> ring
          _ = A * min 1 z := (mul_min_of_nonneg 1 z hAnonneg).symm
      _ = A * min 1 ((1 / |freq|) ^ N) := by rfl

end

