        (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖) ^ p) ≤
        17 * ∫⁻ x : Real, (W * K ^ p) * (c * F x ^ p) := by
          simpa only [q, g, M, W, K, c, F] using hliteral
    _ = 17 * ((W * K ^ p * c) * ∫⁻ x : Real, F x ^ p) := by
          rw [hintegral]
    _ ≤ 17 * ((W * K ^ p * c) * B) := by
          simpa only [mul_comm, mul_left_comm, mul_assoc] using
            (mul_le_mul_left
