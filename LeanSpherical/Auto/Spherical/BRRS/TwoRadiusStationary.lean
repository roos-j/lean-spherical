namespace Auto.Spherical.BRRS

open Set Filter MeasureTheory FourierTransform
open Auto.LittlewoodPaley
open Auto.Spherical.SurfaceMeasureDecay
open Auto.Spherical.OscillatoryIntegralAux Auto.Spherical.AHRS
open scoped BigOperators Convolution ENNReal FourierTransform Topology

noncomputable section

/-- The four endpoint/end-point pieces of the exact planar two-radius
stationary expansion.  Middle pieces are deliberately absent from this named
endpoint contribution and remain in the full nine-component expansion. -/
noncomputable def brrsPlanarTwoRadiusEndpointIntegralSum
    (Phi : BRRSAnnularCutoff) (r s t : Real) : Complex :=
  brrsPlanarTwoRadiusStationaryComponentIntegral Phi .outgoing .outgoing r s t +
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .outgoing .incoming r s t +
      brrsPlanarTwoRadiusStationaryComponentIntegral Phi .incoming .outgoing r s t +
        brrsPlanarTwoRadiusStationaryComponentIntegral Phi .incoming .incoming r s t

/-- The named planar endpoint sum and named planar middle sum give the
literal all-nine stationary contribution. -/
theorem brrsPlanarTwoRadiusAllStationaryComponentIntegralSum_eq_endpoint_add_middle
    (Phi : BRRSAnnularCutoff) (r s t : Real) :
    brrsPlanarTwoRadiusAllStationaryComponentIntegralSum Phi r s t =
      brrsPlanarTwoRadiusEndpointIntegralSum Phi r s t +
        brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi r s t := by
  rw [brrsPlanarTwoRadiusAllStationaryComponentIntegralSum_eq_fourEndpoint_add_middle]
  rfl

/-- The planar endpoint/end-point contribution has exactly the four physical
phase translations `2π(t ± r ± s)`. -/
theorem brrsPlanarTwoRadiusEndpointIntegralSum_eq_four_phase_integrals
    (Phi : BRRSAnnularCutoff) (r s t : Real) :
    brrsPlanarTwoRadiusEndpointIntegralSum Phi r s t =
      (∫ rho in (1 / 32 : Real)..1,
        brrsPlanarTwoRadiusStationaryCoefficient Phi .outgoing .outgoing r s rho *
          oscillatoryExp (2 * Real.pi * (t - r - s)) rho) +
        (∫ rho in (1 / 32 : Real)..1,
          brrsPlanarTwoRadiusStationaryCoefficient Phi .outgoing .incoming r s rho *
            oscillatoryExp (2 * Real.pi * (t - r + s)) rho) +
          (∫ rho in (1 / 32 : Real)..1,
            brrsPlanarTwoRadiusStationaryCoefficient Phi .incoming .outgoing r s rho *
              oscillatoryExp (2 * Real.pi * (t + r - s)) rho) +
            ∫ rho in (1 / 32 : Real)..1,
              brrsPlanarTwoRadiusStationaryCoefficient Phi .incoming .incoming r s rho *
                oscillatoryExp (2 * Real.pi * (t + r + s)) rho := by
  unfold brrsPlanarTwoRadiusEndpointIntegralSum
  rw [brrsPlanarTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp,
    brrsPlanarTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp,
    brrsPlanarTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp,
    brrsPlanarTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
  simp only [brrs_twoRadius_stationary_frequency_eq, brrsSurfaceWaveSign]
  congr 1 <;> ring

/-- Exact planar main/remainder form of the level-zero radial half-wave.
The endpoint contribution contains precisely the four travelling signs, while
all five middle-wave pieces remain in the second named summand. -/
theorem brrsDyadicHalfWave_levelZero_two_eq_endpoint_add_middle
    (Phi : BRRSAnnularCutoff) (t : Real) (f : BRRSSchwartz 2)
    (hf : IsRadial (f : BRRSSpace 2 → Complex))
    (v w : BRRSSpace 2) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1)
    (r : Real) (hr : 0 ≤ r) :
    brrsDyadicHalfWave Phi 0 t f (r • v) =
      ∫ s : Ioi (0 : Real),
        (brrsPlanarTwoRadiusEndpointIntegralSum Phi r s.1 t +
          brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi r s.1 t) *
            f (s.1 • w)
        ∂Measure.volumeIoiPow (2 - 1) := by
  rw [brrsDyadicHalfWave_levelZero_two_eq_allPlanarStationaryComponentIntegralSum
    Phi t f hf v w hv hw r hr]
  apply integral_congr_ae
  filter_upwards with s
  rw [brrsPlanarTwoRadiusAllStationaryComponentIntegralSum_eq_endpoint_add_middle]

/-- Exact arbitrary-dyadic-scale planar radial stationary decomposition.
The input is rescaled before the level-zero circle identity is applied.  Thus
the four endpoint waves and all five middle-wave components remain present in
the displayed outer radial integral. -/
theorem brrsDyadicHalfWave_eq_scaled_planar_endpoint_add_middle
    (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f : BRRSSchwartz 2) (hf : IsRadial (f : BRRSSpace 2 → Complex))
    (v w : BRRSSpace 2) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1)
    (r : Real) (hr : 0 ≤ r) :
    brrsDyadicHalfWave Phi j t f (r • v) =
      ∫ s : Ioi (0 : Real),
        (brrsPlanarTwoRadiusEndpointIntegralSum Phi ((2 : Real) ^ j * r) s.1
            ((2 : Real) ^ j * t) +
          brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi
            ((2 : Real) ^ j * r) s.1 ((2 : Real) ^ j * t)) *
          brrsSchwartzInputDilation ((2 : Real) ^ j)
            (pow_ne_zero j (by norm_num)) f (s.1 • w)
        ∂Measure.volumeIoiPow (2 - 1) := by
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  let g : BRRSSchwartz 2 := brrsSchwartzInputDilation q hq.ne' f
  have hg : IsRadial (g : BRRSSpace 2 → Complex) :=
    brrsSchwartzInputDilation_isRadial q hq.ne' f hf
  calc
    brrsDyadicHalfWave Phi j t f (r • v) =
        brrsDyadicHalfWave Phi 0 (q * t) g (q • (r • v)) := by
      dsimp only [g, q]
      exact brrsDyadicHalfWave_eq_levelZero_scaledInput Phi j t f (r • v)
    _ = ∫ s : Ioi (0 : Real),
        (brrsPlanarTwoRadiusEndpointIntegralSum Phi (q * r) s.1 (q * t) +
          brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi (q * r) s.1
            (q * t)) *
          g (s.1 • w)
        ∂Measure.volumeIoiPow (2 - 1) := by
      simpa only [smul_smul] using
        (brrsDyadicHalfWave_levelZero_two_eq_endpoint_add_middle
          Phi (q * t) g hg v w hv hw (q * r) (mul_nonneg hq.le hr))
    _ = ∫ s : Ioi (0 : Real),
        (brrsPlanarTwoRadiusEndpointIntegralSum Phi ((2 : Real) ^ j * r) s.1
            ((2 : Real) ^ j * t) +
          brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi
            ((2 : Real) ^ j * r) s.1 ((2 : Real) ^ j * t)) *
          brrsSchwartzInputDilation ((2 : Real) ^ j)
            (pow_ne_zero j (by norm_num)) f (s.1 • w)
        ∂Measure.volumeIoiPow (2 - 1) := by
      rfl

/-! ### Exact dyadic transport of the planar stationary model -/

/-- The exact `2^j` transport of one planar two-radius stationary component. -/
noncomputable def brrsDyadicPlanarTwoRadiusStationaryComponentIntegral
    (Phi : BRRSAnnularCutoff) (j : Nat)
    (partR partS : BRRSSurfaceWavePart) (r s t : Real) : Complex :=
  (((2 : Real) ^ j) ^ 2) •
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi partR partS
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)

/-- The exact `2^j` transport of the four planar endpoint--endpoint waves. -/
noncomputable def brrsDyadicPlanarTwoRadiusEndpointIntegralSum
    (Phi : BRRSAnnularCutoff) (j : Nat) (r s t : Real) : Complex :=
  (((2 : Real) ^ j) ^ 2) •
    brrsPlanarTwoRadiusEndpointIntegralSum Phi
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)

/-- The exact `2^j` transport of all five planar stationary components with
at least one middle wave. -/
noncomputable def brrsDyadicPlanarTwoRadiusMiddleComponentIntegralSum
    (Phi : BRRSAnnularCutoff) (j : Nat) (r s t : Real) : Complex :=
  (((2 : Real) ^ j) ^ 2) •
    brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)

/-- The exact `2^j` transport of the complete planar all-nine stationary
sum. -/
noncomputable def brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum
    (Phi : BRRSAnnularCutoff) (j : Nat) (r s t : Real) : Complex :=
  (((2 : Real) ^ j) ^ 2) •
    brrsPlanarTwoRadiusAllStationaryComponentIntegralSum Phi
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)

/-- Unfolding the dyadic planar all-nine model exposes the level-zero model
at the simultaneously dilated radii and time. -/
theorem brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum_eq_levelZero_scaled
    (Phi : BRRSAnnularCutoff) (j : Nat) (r s t : Real) :
    brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum Phi j r s t =
      (((2 : Real) ^ j) ^ 2) •
        brrsPlanarTwoRadiusAllStationaryComponentIntegralSum Phi
          (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) ((2 : Real) ^ j * t) := rfl

/-- The dyadic planar all-nine model splits exactly into its four endpoint
waves and its five retained middle-wave components. -/
theorem brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum_eq_endpoint_add_middle
    (Phi : BRRSAnnularCutoff) (j : Nat) (r s t : Real) :
    brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum Phi j r s t =
      brrsDyadicPlanarTwoRadiusEndpointIntegralSum Phi j r s t +
        brrsDyadicPlanarTwoRadiusMiddleComponentIntegralSum Phi j r s t := by
  unfold brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum
    brrsDyadicPlanarTwoRadiusEndpointIntegralSum
    brrsDyadicPlanarTwoRadiusMiddleComponentIntegralSum
  rw [brrsPlanarTwoRadiusAllStationaryComponentIntegralSum_eq_endpoint_add_middle,
    smul_add]

/-- Exact arbitrary-scale planar radial stationary formula with the complete
dyadic all-nine model.  The radial change of variables is performed using
the polar power measure, so this is an equality for the literal half-wave. -/
theorem brrsDyadicHalfWave_eq_dyadicPlanarAllStationaryComponentIntegralSum
    (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f : BRRSSchwartz 2) (hf : IsRadial (f : BRRSSpace 2 → Complex))
    (v w : BRRSSpace 2) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1)
    (r : Real) (hr : 0 ≤ r) :
    brrsDyadicHalfWave Phi j t f (r • v) =
      ∫ s : Ioi (0 : Real),
        brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum Phi j r s.1 t *
          f (s.1 • w)
        ∂Measure.volumeIoiPow (2 - 1) := by
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  let g : BRRSSchwartz 2 := brrsSchwartzInputDilation q hq.ne' f
  have hg : IsRadial (g : BRRSSpace 2 → Complex) :=
    brrsSchwartzInputDilation_isRadial q hq.ne' f hf
  let H : Real → Complex := fun u =>
    brrsPlanarTwoRadiusAllStationaryComponentIntegralSum Phi (q * r) u (q * t) *
      g (u • w)
  have hscale := integral_volumeIoiPow_dilate (2 - 1) H hq
  have htwo_one : 1 ≤ 2 := by norm_num
  calc
    brrsDyadicHalfWave Phi j t f (r • v) =
        brrsDyadicHalfWave Phi 0 (q * t) g (q • (r • v)) := by
      dsimp only [g, q]
      exact brrsDyadicHalfWave_eq_levelZero_scaledInput Phi j t f (r • v)
    _ = ∫ u : Ioi (0 : Real), H u.1 ∂Measure.volumeIoiPow (2 - 1) := by
      dsimp only [H]
      simpa only [smul_smul] using
        (brrsDyadicHalfWave_levelZero_two_eq_allPlanarStationaryComponentIntegralSum
          Phi (q * t) g hg v w hv hw (q * r) (mul_nonneg hq.le hr))
    _ = ∫ s : Ioi (0 : Real), ((q ^ 2 : Real) : Complex) * H (q * s.1)
          ∂Measure.volumeIoiPow (2 - 1) := by
      symm
      simpa only [Nat.sub_add_cancel htwo_one] using hscale
    _ = ∫ s : Ioi (0 : Real),
        brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum Phi j r s.1 t *
          f (s.1 • w)
        ∂Measure.volumeIoiPow (2 - 1) := by
      apply integral_congr_ae
      filter_upwards with s
      have hray : g ((q * s.1) • w) = f (s.1 • w) :=
        brrsSchwartzInputDilation_scaled_ray_apply q hq.ne' f s.1 w
      change ((q ^ 2 : Real) : Complex) *
          (brrsPlanarTwoRadiusAllStationaryComponentIntegralSum Phi (q * r)
            (q * s.1) (q * t) * g ((q * s.1) • w)) =
          brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum Phi j r s.1 t *
            f (s.1 • w)
      rw [hray]
      unfold brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum
      simp only [Complex.real_smul]
      ring

/-- Main/remainder form of the literal planar dyadic radial half-wave.  It
contains the four endpoint phases together with all five middle-wave terms. -/
theorem brrsDyadicHalfWave_eq_dyadicPlanarEndpoint_add_middle
    (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f : BRRSSchwartz 2) (hf : IsRadial (f : BRRSSpace 2 → Complex))
    (v w : BRRSSpace 2) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1)
    (r : Real) (hr : 0 ≤ r) :
    brrsDyadicHalfWave Phi j t f (r • v) =
      ∫ s : Ioi (0 : Real),
        (brrsDyadicPlanarTwoRadiusEndpointIntegralSum Phi j r s.1 t +
          brrsDyadicPlanarTwoRadiusMiddleComponentIntegralSum Phi j r s.1 t) *
            f (s.1 • w)
        ∂Measure.volumeIoiPow (2 - 1) := by
  rw [brrsDyadicHalfWave_eq_dyadicPlanarAllStationaryComponentIntegralSum
    Phi j t f hf v w hv hw r hr]
  apply integral_congr_ae
  filter_upwards with s
  rw [brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum_eq_endpoint_add_middle]

end

end Auto.Spherical.BRRS

namespace Auto.Spherical.BRRS

open Set Filter MeasureTheory FourierTransform
open Auto.LittlewoodPaley
open Auto.Spherical.SurfaceMeasureDecay
open Auto.Spherical.OscillatoryIntegralAux Auto.Spherical.AHRS
open scoped BigOperators Convolution ENNReal FourierTransform Topology

noncomputable section

/-- At two high planar radii, the four endpoint/end-point pieces are bounded
by the four exact translated stationary profiles.  This theorem concerns only
the actual planar endpoint amplitudes; the middle pieces remain separate in
the exact nine-component decomposition. -/
theorem exists_norm_brrsPlanarTwoRadiusEndpointIntegralSum_highRadius_fourPhase_profile_le
    (N : Nat) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsPlanarTwoRadiusEndpointIntegralSum Phi r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16) * Real.sqrt (s / 16))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
  obtain ⟨Coo, hCoo_pos, hoo⟩ :=
    exists_norm_intervalInteg_brrsPlanTwoRadStatCoeff_endpoint_highRad_profile_le
      N Phi .outgoing .outgoing (Or.inl rfl) (Or.inl rfl)
  obtain ⟨Coi, hCoi_pos, hoi⟩ :=
    exists_norm_intervalInteg_brrsPlanTwoRadStatCoeff_endpoint_highRad_profile_le
      N Phi .outgoing .incoming (Or.inl rfl) (Or.inr rfl)
  obtain ⟨Cio, hCio_pos, hio⟩ :=
    exists_norm_intervalInteg_brrsPlanTwoRadStatCoeff_endpoint_highRad_profile_le
      N Phi .incoming .outgoing (Or.inr rfl) (Or.inl rfl)
  obtain ⟨Cii, hCii_pos, hii⟩ :=
    exists_norm_intervalInteg_brrsPlanTwoRadStatCoeff_endpoint_highRad_profile_le
      N Phi .incoming .incoming (Or.inr rfl) (Or.inr rfl)
  let C : Real := Coo + Coi + Cio + Cii
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  let q : Real := Real.sqrt (r / 16) * Real.sqrt (s / 16)
  let A : Real := (1 - (1 / 32 : Real)) * (C / q)
  let Poo : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s))
  let Poi : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s))
  let Pio : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s))
  let Pii : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))
  let Ioo : Complex := ∫ rho in (1 / 32 : Real)..1,
    brrsPlanarTwoRadiusStationaryCoefficient Phi .outgoing .outgoing r s rho *
      oscillatoryExp (2 * Real.pi * (t - r - s)) rho
  let Ioi : Complex := ∫ rho in (1 / 32 : Real)..1,
    brrsPlanarTwoRadiusStationaryCoefficient Phi .outgoing .incoming r s rho *
      oscillatoryExp (2 * Real.pi * (t - r + s)) rho
  let Iio : Complex := ∫ rho in (1 / 32 : Real)..1,
    brrsPlanarTwoRadiusStationaryCoefficient Phi .incoming .outgoing r s rho *
      oscillatoryExp (2 * Real.pi * (t + r - s)) rho
  let Iii : Complex := ∫ rho in (1 / 32 : Real)..1,
    brrsPlanarTwoRadiusStationaryCoefficient Phi .incoming .incoming r s rho *
      oscillatoryExp (2 * Real.pi * (t + r + s)) rho
  have hq : 0 < q := by
    dsimp [q]
    apply mul_pos <;> apply Real.sqrt_pos.2 <;> linarith
  have hCoo_le : Coo ≤ C := by
    dsimp [C]
    linarith
  have hCoi_le : Coi ≤ C := by
    dsimp [C]
    linarith
  have hCio_le : Cio ≤ C := by
    dsimp [C]
    linarith
  have hCii_le : Cii ≤ C := by
    dsimp [C]
    linarith
  have hAoo : (1 - (1 / 32 : Real)) * (Coo / q) ≤ A := by
    dsimp [A]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hCoo_le hq.le
    · norm_num
  have hAoi : (1 - (1 / 32 : Real)) * (Coi / q) ≤ A := by
    dsimp [A]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hCoi_le hq.le
    · norm_num
  have hAio : (1 - (1 / 32 : Real)) * (Cio / q) ≤ A := by
    dsimp [A]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hCio_le hq.le
    · norm_num
  have hAii : (1 - (1 / 32 : Real)) * (Cii / q) ≤ A := by
    dsimp [A]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hCii_le hq.le
    · norm_num
  have hPoo : 0 ≤ Poo := by
    dsimp [Poo]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPoi : 0 ≤ Poi := by
    dsimp [Poi]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPio : 0 ≤ Pio := by
    dsimp [Pio]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPii : 0 ≤ Pii := by
    dsimp [Pii]
    exact brrsStationaryRapidProfile_nonneg N _
  have hIoo : ‖Ioo‖ ≤ A * Poo := by
    dsimp [Ioo, Poo]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Coo / q) *
          brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) := by
        simpa only [q] using hoo r s (2 * Real.pi * (t - r - s)) hr hs
      _ ≤ A * brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) :=
        mul_le_mul_of_nonneg_right hAoo hPoo
  have hIoi : ‖Ioi‖ ≤ A * Poi := by
    dsimp [Ioi, Poi]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Coi / q) *
          brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) := by
        simpa only [q] using hoi r s (2 * Real.pi * (t - r + s)) hr hs
      _ ≤ A * brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) :=
        mul_le_mul_of_nonneg_right hAoi hPoi
  have hIio : ‖Iio‖ ≤ A * Pio := by
    dsimp [Iio, Pio]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cio / q) *
          brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) := by
        simpa only [q] using hio r s (2 * Real.pi * (t + r - s)) hr hs
      _ ≤ A * brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) :=
        mul_le_mul_of_nonneg_right hAio hPio
  have hIii : ‖Iii‖ ≤ A * Pii := by
    dsimp [Iii, Pii]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cii / q) *
          brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s)) := by
        simpa only [q] using hii r s (2 * Real.pi * (t + r + s)) hr hs
      _ ≤ A * brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s)) :=
        mul_le_mul_of_nonneg_right hAii hPii
  have hsum :
      brrsPlanarTwoRadiusEndpointIntegralSum Phi r s t = Ioo + Ioi + Iio + Iii := by
    dsimp [Ioo, Ioi, Iio, Iii]
    exact brrsPlanarTwoRadiusEndpointIntegralSum_eq_four_phase_integrals Phi r s t
  rw [hsum]
  calc
    ‖Ioo + Ioi + Iio + Iii‖ ≤ ‖Ioo‖ + ‖Ioi‖ + ‖Iio‖ + ‖Iii‖ := by
      calc
        ‖Ioo + Ioi + Iio + Iii‖ ≤ ‖Ioo + Ioi + Iio‖ + ‖Iii‖ := norm_add_le _ _
        _ ≤ (‖Ioo + Ioi‖ + ‖Iio‖) + ‖Iii‖ := by
          gcongr
          exact norm_add_le _ _
        _ ≤ (‖Ioo‖ + ‖Ioi‖ + ‖Iio‖) + ‖Iii‖ := by
          gcongr
          exact norm_add_le _ _
        _ = ‖Ioo‖ + ‖Ioi‖ + ‖Iio‖ + ‖Iii‖ := by ring
    _ ≤ A * Poo + A * Poi + A * Pio + A * Pii := by gcongr
    _ = A * (Poo + Poi + Pio + Pii) := by ring
    _ = (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16) * Real.sqrt (s / 16))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
      rfl

end

