/-- A reusable planar derivative-to-profile transfer for compact stationary
coefficients.  Its abstract positive weight lets the endpoint and middle
high-radius regimes retain their distinct spatial denominators. -/
theorem exists_norm_intervalInteg_brrsPlanarTwoRadStatCoeff_profile_le_of_deriv_decay
    (N : Nat) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart)
    (H : Real → Real → Prop) (q : Real → Real → Real)
    (hq : ∀ r s : Real, H r s → 0 < q r s)
    (hderiv : ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ r s rho : Real,
      H r s → rho ∈ Icc (1 / 32 : Real) 1 →
        ‖iteratedDeriv k (fun u : Real =>
          brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s u) rho‖ ≤
          C / q r s) :
    ∃ C : Real, 0 < C ∧ ∀ r s freq : Real, H r s →
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho *
          oscillatoryExp freq rho‖ ≤
        (1 - (1 / 32 : Real)) * (C / q r s) *
          brrsStationaryRapidProfile N freq := by
  obtain ⟨C, hC, hbound⟩ := hderiv
  refine ⟨C, hC, ?_⟩
  intro r s freq hrs
  have hqpos : 0 < q r s := hq r s hrs
  have hCq_nonneg : 0 ≤ C / q r s :=
    div_nonneg hC.le hqpos.le
  have huniform : ‖∫ rho in (1 / 32 : Real)..1,
      brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho *
        oscillatoryExp freq rho‖ ≤
      (1 - (1 / 32 : Real)) * (C / q r s) := by
    calc
      ‖∫ rho in (1 / 32 : Real)..1,
          brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho *
            oscillatoryExp freq rho‖ ≤
          (C / q r s) * |1 - (1 / 32 : Real)| := by
        apply intervalIntegral.norm_integral_le_of_norm_le_const
        intro rho hrho
        have hrho' : rho ∈ Icc (1 / 32 : Real) 1 := by
          rw [uIoc_of_le (by norm_num : (1 / 32 : Real) ≤ 1)] at hrho
          exact ⟨hrho.1.le, hrho.2⟩
        rw [norm_mul, norm_oscillatoryExp, mul_one]
        exact hbound 0 (Nat.zero_le _) r s rho hrs hrho'
      _ = (1 - (1 / 32 : Real)) * (C / q r s) := by
        rw [abs_of_nonneg (by norm_num : (0 : Real) ≤ 1 - 1 / 32)]
        ring
  let A : Real := (1 - (1 / 32 : Real)) * (C / q r s)
  have hAnonneg : 0 ≤ A := by
    dsimp [A]
    exact mul_nonneg (by norm_num) hCq_nonneg
  have huniform' : ‖∫ rho in (1 / 32 : Real)..1,
      brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho *
        oscillatoryExp freq rho‖ ≤ A := by
    simpa only [A] using huniform
  change ‖∫ rho in (1 / 32 : Real)..1,
      brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho *
        oscillatoryExp freq rho‖ ≤ A * brrsStationaryRapidProfile N freq
  by_cases hfreq : freq = 0
  · simpa [brrsStationaryRapidProfile, hfreq] using huniform'
  · rw [brrsStationaryRapidProfile, if_neg hfreq]
    let z : Real := (1 / |freq|) ^ N
    have hchain := hasOscillatoryIBPChain_iteratedDeriv_of_contDiff
      (fun rho : Real =>
        brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho)
      (contDiff_brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s)
      (brrsPlanarTwoRadiusStationaryCoefficient_eventuallyEq_zero_at_lower
        Phi partR partS r s)
      (brrsPlanarTwoRadiusStationaryCoefficient_eventuallyEq_zero_at_upper
        Phi partR partS r s) N
    have hdecay' : ‖∫ rho in (1 / 32 : Real)..1,
        brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho *
          oscillatoryExp freq rho‖ ≤ z * A := by
      dsimp [z, A]
      simpa only [iteratedDeriv_zero] using
        (norm_intervalIntegral_mul_oscillatoryExp_le_iterated
          (F := fun k => iteratedDeriv k
            (fun rho : Real =>
              brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho))
          (N := N) (by norm_num : (1 / 32 : Real) ≤ 1) hfreq hchain
          hCq_nonneg
          (fun rho hrho => hbound N le_rfl r s rho hrs hrho))
    calc
      ‖∫ rho in (1 / 32 : Real)..1,
          brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s rho *
            oscillatoryExp freq rho‖ ≤ min A (z * A) :=
        le_min huniform' hdecay'
      _ = A * min 1 z := by
        calc
          min A (z * A) = min (A * 1) (A * z) := by
            congr 1 <;> ring
          _ = A * min 1 z := (mul_min_of_nonneg 1 z hAnonneg).symm
      _ = A * min 1 ((1 / |freq|) ^ N) := by rfl

end

