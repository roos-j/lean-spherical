      (brrsSectionFiveFarSourceII_le_dyadic_sourceMass
        (E := E) hE (d := d) (N := L + d + 2) (j := j) (n := 10 + k)
        hd (by omega) hp sigma T hT f hf)
  calc
    (∑' k : Nat,
