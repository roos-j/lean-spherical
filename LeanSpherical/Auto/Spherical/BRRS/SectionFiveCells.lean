        intro r hr
        exact mul_le_mul' le_rfl (hg r hr)
      _ = (∫⁻ r in Ioc (0 : Real) 20,
          brrsSectionFiveFarSourceOutputWeight d 1 r) * C :=
        lintegral_mul_const C hW
  have hphase : ∀ t ∈ T,
      (∫⁻ r in Ioc (0 : Real) 20,
        brrsSectionFiveFarSourceOutputWeight d 1 r *
          (∫⁻ s in Ioc ((2 : Real) ^ n) ((2 : Real) ^ (n + 1)),
