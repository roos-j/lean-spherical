    dsimp [q]
    positivity
  have hqs : 0 < q * s := by
    simpa only [q] using lt_of_lt_of_le (by norm_num : (0 : Real) < 16) hs
  have hspos : 0 < s := by
    apply pos_of_mul_pos_right hqs
