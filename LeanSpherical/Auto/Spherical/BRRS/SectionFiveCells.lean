  rw [← ENNReal.ofReal_rpow_of_pos
    (by positivity : 0 < ((2 : Real) ^ (n + 1)) ^ sobolevExponent d p)]
  rw [← ENNReal.ofReal_rpow_of_pos
    (by positivity : 0 < (2 : Real) ^ (n + 1))]
  simp only [ENNReal.ofReal_pow (by norm_num : (0 : Real) ≤ 2),
