  have hP : 0 ≤ P := by
    dsimp [P]
    exact add_nonneg (add_nonneg (add_nonneg
      (brrsSectionFiveOmega_nonneg N j (t - r - s))
      (brrsSectionFiveOmega_nonneg N j (t - r + s)))
      (brrsSectionFiveOmega_nonneg N j (t + r - s)))
      (brrsSectionFiveOmega_nonneg N j (t + r + s))
