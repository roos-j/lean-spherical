  rw [ENNReal.ofReal_mul' hsourcePow]
  rw [ENNReal.ofReal_mul' hannulusPow]
  rw [ENNReal.ofReal_mul' hrapidPow]
  rw [← ENNReal.ofReal_rpow_of_nonneg
    hrapid hp]
