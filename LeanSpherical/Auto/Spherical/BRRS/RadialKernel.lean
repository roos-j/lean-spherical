/-! ### Interpolation of discrete-output estimates

The output space in the next theorem is intentionally arbitrary.  In the
BRRS application it is the product of a finite time set (with counting
measure) and Euclidean space, whose `L^p` norm is exactly the required
`\ell^p(L^p)` norm.  Thus a lower-exponent discrete estimate and a uniform
fixed-time `L^\infty` estimate can be fed directly into this theorem.

This is only a Riesz--Thorin *transport* theorem: it does not assert either
endpoint estimate for the BRRS half-wave.  The radial kernel estimates needed
to supply the sharp lower endpoint remain a separate analytic task. -/

/-! ### Radial profile simple-function core

The restriction to radial data is implemented through the pushforward of
Lebesgue measure by the norm map.  This supplies a genuine full
simple-function domain for Riesz--Thorin, rather than attempting to apply
interpolation directly to a predicate-defined subspace of Euclidean inputs.
-/

/-- The measure on scalar radial profiles induced by Euclidean volume. -/
noncomputable def brrsRadialProfileMeasure (d : Nat) : Measure Real :=
  Measure.map (fun x : BRRSSpace d => ‖x‖) volume

/-- Lift a scalar simple profile to its norm-radial Euclidean simple
function. -/
noncomputable def brrsRadialProfileLift {d : Nat} (F : SimpleFunc Real Complex) :
    SimpleFunc (BRRSSpace d) Complex :=
  F.comp (fun x : BRRSSpace d => ‖x‖) continuous_norm.measurable

/-- A lifted scalar profile is pointwise norm-radial. -/
theorem brrsRadialProfileLift_isRadial {d : Nat} (F : SimpleFunc Real Complex) :
    IsRadial (brrsRadialProfileLift (d := d) F : BRRSSpace d → Complex) := by
  simpa [brrsRadialProfileLift, Function.comp_def] using
    (Auto.RadialFourierTransform.isNormRadial_normProfile
      (V := BRRSSpace d) (F := (F : Real → Complex)))

/-- Integrability is preserved exactly by the radial-profile lift. -/
theorem integrable_brrsRadialProfileLift_iff {d : Nat} (F : SimpleFunc Real Complex) :
    Integrable (F : Real → Complex) (brrsRadialProfileMeasure d) ↔
      Integrable (brrsRadialProfileLift (d := d) F : BRRSSpace d → Complex) volume := by
  simpa [brrsRadialProfileMeasure, brrsRadialProfileLift] using
    (integrable_map_measure F.aestronglyMeasurable continuous_norm.aemeasurable)

/-- `L^p` membership is preserved exactly by the radial-profile lift. -/
theorem memLp_brrsRadialProfileLift_iff {d : Nat} {p : ENNReal}
    (F : SimpleFunc Real Complex) :
    MemLp (F : Real → Complex) p (brrsRadialProfileMeasure d) ↔
      MemLp (brrsRadialProfileLift (d := d) F : BRRSSpace d → Complex) p volume := by
  simpa [brrsRadialProfileMeasure, brrsRadialProfileLift] using
    (memLp_map_measure_iff F.aestronglyMeasurable continuous_norm.aemeasurable)

/-- Every `eLpNorm` is preserved exactly by the radial-profile lift. -/
theorem eLpNorm_brrsRadialProfileLift_eq {d : Nat} {p : ENNReal}
    (F : SimpleFunc Real Complex) :
    eLpNorm (F : Real → Complex) p (brrsRadialProfileMeasure d) =
      eLpNorm (brrsRadialProfileLift (d := d) F : BRRSSpace d → Complex) p volume := by
  simpa [brrsRadialProfileMeasure, brrsRadialProfileLift] using
    (eLpNorm_map_measure F.aestronglyMeasurable continuous_norm.aemeasurable)

/-- The radial-profile lift respects addition. -/
theorem brrsRadialProfileLift_add {d : Nat} (F G : SimpleFunc Real Complex) :
    brrsRadialProfileLift (d := d) (F + G) =
      brrsRadialProfileLift (d := d) F + brrsRadialProfileLift (d := d) G := by
  ext x
  rfl

/-- The radial-profile lift respects scalar multiplication. -/
theorem brrsRadialProfileLift_smul {d : Nat} (c : Complex) (F : SimpleFunc Real Complex) :
    brrsRadialProfileLift (d := d) (c • F) =
      c • brrsRadialProfileLift (d := d) F := by
  ext x
  rfl

/-- Interpolate a lower-exponent discrete-output estimate with an `L^∞`
endpoint.  If the two endpoint rates are `2^(j * s₀)` and `2^(j * s∞)`, the
output rate is the convex combination
`2^(j * ((1 - θ) * s₀ + θ * s∞))`, where `θ = 1 - p₀ / p`.

The theorem is formulated for simple-function input because this is the
precise domain of the repository's proved Riesz--Thorin theorem.  An eventual
BRRS application must additionally provide the usual density/extension step
from this core to the intended radial `L^p` input class. -/
theorem highExponent_discreteLpEstimate_of_lower_and_top
    {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    {μ : Measure X} {ν : Measure Y} [SigmaFinite ν]
    {p₀ p : Real} (hp₀ : 1 ≤ p₀) (hp₀p : p₀ < p)
    (T : SimpleFunc X Complex → Y → Complex)
    (hT_add : ∀ (f g : SimpleFunc X Complex),
      Integrable f μ → Integrable g μ → T (f + g) = T f + T g)
    (hT_smul : ∀ (c : Complex) (f : SimpleFunc X Complex),
      Integrable f μ → T (c • f) = c • T f)
    (hT_measurable : ∀ (f : SimpleFunc X Complex),
      Integrable f μ → Measurable (T f))
    {A₀ A_top s₀ s_top : Real} (hA₀ : 0 < A₀) (hA_top : 0 < A_top) (j : Nat)
    (hlower : ∀ (f : SimpleFunc X Complex), Integrable f μ →
      eLpNorm (T f) (ENNReal.ofReal p₀) ν ≤
        ENNReal.ofReal (A₀ * (2 : Real) ^ ((j : Real) * s₀)) *
          eLpNorm (f : X → Complex) (ENNReal.ofReal p₀) μ)
    (htop : ∀ (f : SimpleFunc X Complex), Integrable f μ →
      eLpNorm (T f) ⊤ ν ≤
        ENNReal.ofReal (A_top * (2 : Real) ^ ((j : Real) * s_top)) *
          eLpNorm (f : X → Complex) ⊤ μ) :
    ∀ f : SimpleFunc X Complex, Integrable f μ →
      MemLp (T f) (ENNReal.ofReal p) ν ∧
      eLpNorm (T f) (ENNReal.ofReal p) ν ≤
        ENNReal.ofReal
          ((Real.rpow A₀ (1 - (1 - p₀ / p)) * Real.rpow A_top (1 - p₀ / p)) *
            (2 : Real) ^ ((j : Real) * ((1 - (1 - p₀ / p)) * s₀ +
              (1 - p₀ / p) * s_top))) *
          eLpNorm (f : X → Complex) (ENNReal.ofReal p) μ := by
  let θ : Real := 1 - p₀ / p
  have hp₀pos : 0 < p₀ := lt_of_lt_of_le zero_lt_one hp₀
  have hppos : 0 < p := lt_trans hp₀pos hp₀p
  have hθ0 : 0 < θ := by
    rw [show θ = 1 - p₀ / p by rfl]
    have hdiv : p₀ / p < 1 := (div_lt_one hppos).mpr hp₀p
    linarith
  have hθ1 : θ < 1 := by
    rw [show θ = 1 - p₀ / p by rfl]
    have hdiv : 0 < p₀ / p := div_pos hp₀pos hppos
    linarith
  have hkey : (ENNReal.ofReal p)⁻¹ =
      ENNReal.ofReal (1 - θ) * (ENNReal.ofReal p₀)⁻¹ +
        ENNReal.ofReal θ * (⊤ : ENNReal)⁻¹ := by
    rw [ENNReal.inv_top, mul_zero, add_zero]
    rw [← ENNReal.ofReal_inv_of_pos hppos]
    rw [← ENNReal.ofReal_inv_of_pos hp₀pos]
    have hθ : 1 - θ = p₀ / p := by
      rw [show θ = 1 - p₀ / p by rfl]
      ring
    rw [hθ]
    rw [← ENNReal.ofReal_mul (by positivity : 0 ≤ p₀ / p)]
    congr 1
    field_simp
  have hpow₀ : 0 < (2 : Real) ^ ((j : Real) * s₀) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hpow_top : 0 < (2 : Real) ^ ((j : Real) * s_top) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hM₀ : 0 < A₀ * (2 : Real) ^ ((j : Real) * s₀) := mul_pos hA₀ hpow₀
  have hM_top : 0 < A_top * (2 : Real) ^ ((j : Real) * s_top) :=
    mul_pos hA_top hpow_top
  have hres := Auto.SteinInterpolation.riesz_thorin T
    (by
      rw [← ENNReal.ofReal_one]
      exact ENNReal.ofReal_le_ofReal hp₀)
    le_top
    (by
      rw [← ENNReal.ofReal_one]
      exact ENNReal.ofReal_le_ofReal hp₀)
    le_top
    (by constructor <;> assumption)
    hkey hkey hT_add hT_smul hT_measurable hM₀ hM_top hlower htop
  have hrate :
      Real.rpow (A₀ * (2 : Real) ^ ((j : Real) * s₀)) (1 - θ) *
          Real.rpow (A_top * (2 : Real) ^ ((j : Real) * s_top)) θ =
        (Real.rpow A₀ (1 - θ) * Real.rpow A_top θ) *
          (2 : Real) ^ ((j : Real) * ((1 - θ) * s₀ + θ * s_top)) := by
    simp only [Real.rpow_eq_pow]
    have htwo : (0 : Real) < 2 := by norm_num
    have htwo_nonneg : (0 : Real) ≤ 2 := htwo.le
    have hpow₀nonneg : 0 ≤ (2 : Real) ^ ((j : Real) * s₀) :=
      (Real.rpow_pos_of_pos htwo _).le
    have hpow_top_nonneg : 0 ≤ (2 : Real) ^ ((j : Real) * s_top) :=
      (Real.rpow_pos_of_pos htwo _).le
    rw [Real.mul_rpow hA₀.le hpow₀nonneg,
      Real.mul_rpow hA_top.le hpow_top_nonneg]
    rw [← Real.rpow_mul htwo_nonneg, ← Real.rpow_mul htwo_nonneg]
    calc
      A₀ ^ (1 - θ) * 2 ^ ((j : Real) * s₀ * (1 - θ)) *
          (A_top ^ θ * 2 ^ ((j : Real) * s_top * θ)) =
        (A₀ ^ (1 - θ) * A_top ^ θ) *
          (2 ^ ((j : Real) * s₀ * (1 - θ)) *
            2 ^ ((j : Real) * s_top * θ)) := by ring
      _ = (A₀ ^ (1 - θ) * A_top ^ θ) *
          2 ^ ((j : Real) * s₀ * (1 - θ) + (j : Real) * s_top * θ) := by
        rw [Real.rpow_add htwo]
      _ = _ := by
        congr 2
        ring
  intro f hf
  have hresf := hres f hf
  rw [hrate] at hresf
  simpa [θ] using hresf

/-! ### One-dimensional interval geometry for the radial low-`p` block

The main contribution in the proof of BRRS Proposition 5.1 is a finite
interval decomposition in the time variable.  The analytic input gives a
nonnegative one-dimensional profile after the changes of variables
`r' = t + r` and `r' = t - r`; this section records the remaining measure
and counting argument independently of any particular kernel. -/

section BRRSRadialBlockIntervalGeometry

/-- One interval in the scale-`h` decomposition used for the main terms of
BRRS Proposition 5.1. -/
def brrsRadialBlockCell (a h : Real) : Set Real := Icc a (a + h)

/-- The fivefold enlargement of a main-block cell.  If `t` lies in the cell
and `h ≤ r ≤ 2h`, then both `t + r` and `t - r` lie in this enlargement. -/
def brrsRadialBlockCellStar (a h : Real) : Set Real :=
  Icc (a - 2 * h) (a + 3 * h)

/-- The points of a finite time set belonging to one main-block cell.  This
is kept as a finite set so that the subsequent estimates can use the exact
local entropy count. -/
noncomputable def brrsRadialBlockCellPoints
    (T : Finset Real) (a h : Real) : Finset Real := by
  classical
  exact T.filter (fun t => t ∈ brrsRadialBlockCell a h)

/-- The elementary `t+r` geometry behind the main-block change of variables. -/
theorem mem_brrsRadialBlockCellStar_add
    {a h t r : Real} (hh : 0 < h)
    (ht : t ∈ brrsRadialBlockCell a h) (hr : r ∈ Icc h (2 * h)) :
    t + r ∈ brrsRadialBlockCellStar a h := by
  simp only [brrsRadialBlockCell, brrsRadialBlockCellStar, mem_Icc] at ht hr ⊢
  constructor <;> linarith

/-- The elementary `t-r` geometry behind the main-block change of variables. -/
theorem mem_brrsRadialBlockCellStar_sub
    {a h t r : Real} (hh : 0 < h)
    (ht : t ∈ brrsRadialBlockCell a h) (hr : r ∈ Icc h (2 * h)) :
    t - r ∈ brrsRadialBlockCellStar a h := by
  simp only [brrsRadialBlockCell, brrsRadialBlockCellStar, mem_Icc] at ht hr ⊢
  constructor <;> linarith

/-- Translation of the `t+r` profile from the radial block into the enlarged
interval.  No regularity of the nonnegative profile is needed here. -/
theorem brrs_lintegral_mainCell_add_profile_le
    (G : Real → ENNReal) {a h t : Real} (hh : 0 < h)
    (ht : t ∈ brrsRadialBlockCell a h) :
    (∫⁻ r in Icc h (2 * h), G (t + r)) ≤
      ∫⁻ x in brrsRadialBlockCellStar a h, G x := by
  let A : Set Real := Icc h (2 * h)
  let B : Set Real := Icc (t + h) (t + 2 * h)
  have hA : MeasurableSet A := measurableSet_Icc
  have hB : MeasurableSet B := measurableSet_Icc
  have hshift :
      (∫⁻ r in A, G (t + r)) = ∫⁻ x in B, G x := by
    calc
      (∫⁻ r in A, G (t + r)) = ∫⁻ r, A.indicator (fun r => G (t + r)) r := by
        exact (lintegral_indicator hA (fun r => G (t + r))).symm
      _ = ∫⁻ r, (B.indicator G) (t + r) := by
        apply lintegral_congr
        intro r
        simp only [Set.indicator]
        congr 1
        apply propext
        dsimp only [A, B]
        simp only [mem_Icc]
        constructor <;> intro hr
        all_goals constructor <;> linarith
      _ = ∫⁻ r, B.indicator G r :=
        lintegral_add_left_eq_self (B.indicator G) t
      _ = ∫⁻ x in B, G x := lintegral_indicator hB G
  have hsub : B ⊆ brrsRadialBlockCellStar a h := by
    intro x hx
    change a ≤ t ∧ t ≤ a + h at ht
    change t + h ≤ x ∧ x ≤ t + 2 * h at hx
    change a - 2 * h ≤ x ∧ x ≤ a + 3 * h
    constructor <;> linarith
  change (∫⁻ r in A, G (t + r)) ≤ ∫⁻ x in brrsRadialBlockCellStar a h, G x
  rw [hshift]
  exact lintegral_mono_set hsub

/-- Reflection and translation of the `t-r` profile from the radial block
into the same enlarged interval. -/
theorem brrs_lintegral_mainCell_sub_profile_le
    (G : Real → ENNReal) {a h t : Real} (hh : 0 < h)
    (ht : t ∈ brrsRadialBlockCell a h) :
    (∫⁻ r in Icc h (2 * h), G (t - r)) ≤
      ∫⁻ x in brrsRadialBlockCellStar a h, G x := by
  let A : Set Real := Icc h (2 * h)
  let B : Set Real := Icc (t - 2 * h) (t - h)
  have hA : MeasurableSet A := measurableSet_Icc
  have hB : MeasurableSet B := measurableSet_Icc
  have hshift :
      (∫⁻ r in A, G (t - r)) = ∫⁻ x in B, G x := by
    calc
      (∫⁻ r in A, G (t - r)) = ∫⁻ r, A.indicator (fun r => G (t - r)) r := by
        exact (lintegral_indicator hA (fun r => G (t - r))).symm
      _ = ∫⁻ r, (B.indicator G) (t - r) := by
        apply lintegral_congr
        intro r
        simp only [Set.indicator]
        congr 1
        apply propext
        dsimp only [A, B]
        simp only [mem_Icc]
        constructor <;> intro hr
        all_goals constructor <;> linarith
      _ = ∫⁻ r, B.indicator G r :=
        lintegral_sub_left_eq_self (B.indicator G) t
      _ = ∫⁻ x in B, G x := lintegral_indicator hB G
  have hsub : B ⊆ brrsRadialBlockCellStar a h := by
    intro x hx
    change a ≤ t ∧ t ≤ a + h at ht
    change t - 2 * h ≤ x ∧ x ≤ t - h at hx
    change a - 2 * h ≤ x ∧ x ≤ a + 3 * h
    constructor <;> linarith
  change (∫⁻ r in A, G (t - r)) ≤ ∫⁻ x in brrsRadialBlockCellStar a h, G x
  rw [hshift]
  exact lintegral_mono_set hsub

/-- A profile dominated by its `t+r` translate has its main-block mass
controlled by the corresponding star interval. -/
theorem brrs_lintegral_mainCell_add_le_of_le_profile
    (H G : Real → ENNReal) {a h t : Real} (hh : 0 < h)
    (ht : t ∈ brrsRadialBlockCell a h)
    (hHG : ∀ r ∈ Icc h (2 * h), H r ≤ G (t + r)) :
    (∫⁻ r in Icc h (2 * h), H r) ≤
      ∫⁻ x in brrsRadialBlockCellStar a h, G x := by
  calc
    (∫⁻ r in Icc h (2 * h), H r) ≤ ∫⁻ r in Icc h (2 * h), G (t + r) := by
      apply lintegral_mono_ae
      filter_upwards [ae_restrict_mem measurableSet_Icc] with r hr
      exact hHG r hr
    _ ≤ ∫⁻ x in brrsRadialBlockCellStar a h, G x :=
      brrs_lintegral_mainCell_add_profile_le G hh ht

/-- A profile dominated by its `t-r` translate has its main-block mass
controlled by the corresponding star interval. -/
theorem brrs_lintegral_mainCell_sub_le_of_le_profile
    (H G : Real → ENNReal) {a h t : Real} (hh : 0 < h)
    (ht : t ∈ brrsRadialBlockCell a h)
    (hHG : ∀ r ∈ Icc h (2 * h), H r ≤ G (t - r)) :
    (∫⁻ r in Icc h (2 * h), H r) ≤
      ∫⁻ x in brrsRadialBlockCellStar a h, G x := by
  calc
    (∫⁻ r in Icc h (2 * h), H r) ≤ ∫⁻ r in Icc h (2 * h), G (t - r) := by
      apply lintegral_mono_ae
      filter_upwards [ae_restrict_mem measurableSet_Icc] with r hr
      exact hHG r hr
    _ ≤ ∫⁻ x in brrsRadialBlockCellStar a h, G x :=
      brrs_lintegral_mainCell_sub_profile_le G hh ht

/-- Finite interval bookkeeping for a nonnegative profile.  If every cell
has count at most `K` and the enlarged cells have pointwise overlap at most
`M`, then their count-weighted restricted masses are bounded by `K M` times
the global mass. -/
theorem brrs_interval_family_lintegral_le_of_count_and_overlap
    {ι : Type*} (s : Finset ι)
    (J : ι → Set Real) (count : ι → ENNReal)
    (G : Real → ENNReal) (K M : ENNReal)
    (hG : Measurable G)
    (hJ : ∀ i ∈ s, MeasurableSet (J i))
    (hcount : ∀ i ∈ s, count i ≤ K)
    (hoverlap : ∀ x,
      (∑ i ∈ s, (J i).indicator (fun _ => (1 : ENNReal)) x) ≤ M) :
    (∑ i ∈ s, count i * ∫⁻ x in J i, G x) ≤
      K * M * ∫⁻ x, G x := by
  have hmeas : ∀ i ∈ s, Measurable ((J i).indicator G) := by
    intro i hi
    exact hG.indicator (hJ i hi)
  have hmass :
      (∑ i ∈ s, ∫⁻ x in J i, G x) ≤ M * ∫⁻ x, G x := by
    calc
      (∑ i ∈ s, ∫⁻ x in J i, G x) =
          ∑ i ∈ s, ∫⁻ x, (J i).indicator G x := by
        apply Finset.sum_congr rfl
        intro i hi
        exact (lintegral_indicator (hJ i hi) G).symm
      _ = ∫⁻ x, ∑ i ∈ s, (J i).indicator G x := by
        exact (lintegral_finsetSum s hmeas).symm
      _ ≤ ∫⁻ x, M * G x := by
        apply lintegral_mono
        intro x
        change (∑ i ∈ s, (J i).indicator G x) ≤ M * G x
        have hfactor :
            (∑ i ∈ s, (J i).indicator G x) =
              (∑ i ∈ s, (J i).indicator (fun _ => (1 : ENNReal)) x) * G x := by
          rw [Finset.sum_mul]
          apply Finset.sum_congr rfl
          intro i hi
          simp only [Set.indicator]
          split <;> simp_all
        rw [hfactor]
        exact mul_le_mul' (hoverlap x) le_rfl
      _ = M * ∫⁻ x, G x := lintegral_const_mul M hG
  calc
    (∑ i ∈ s, count i * ∫⁻ x in J i, G x) ≤
        ∑ i ∈ s, K * ∫⁻ x in J i, G x := by
      apply Finset.sum_le_sum
      intro i hi
      exact mul_le_mul' (hcount i hi) le_rfl
    _ = K * (∑ i ∈ s, ∫⁻ x in J i, G x) := by
      exact (Finset.mul_sum s (fun i => ∫⁻ x in J i, G x) K).symm
    _ ≤ K * (M * ∫⁻ x, G x) := mul_le_mul' le_rfl hmass
    _ = K * M * ∫⁻ x, G x := by ring

/-- The finite-fibre form of the main-block bookkeeping.  The premise
`hprofile` is the only analytic input: it says that every time point in a
cell is controlled by the profile on that cell's enlargement. -/
theorem brrs_fibered_interval_lintegral_le_of_profile_count_and_overlap
    {ι : Type*} (s : Finset ι)
    (J : ι → Set Real) (points : ι → Finset Real)
    (R : Set Real) (H : Real → Real → ENNReal)
    (G : Real → ENNReal) (K M : ENNReal)
    (hG : Measurable G)
    (hJ : ∀ i ∈ s, MeasurableSet (J i))
    (hcount : ∀ i ∈ s, ((points i).card : ENNReal) ≤ K)
    (hoverlap : ∀ x,
      (∑ i ∈ s, (J i).indicator (fun _ => (1 : ENNReal)) x) ≤ M)
    (hprofile : ∀ i ∈ s, ∀ t ∈ points i,
      (∫⁻ r in R, H t r) ≤ ∫⁻ x in J i, G x) :
    (∑ i ∈ s, ∑ t ∈ points i, ∫⁻ r in R, H t r) ≤
      K * M * ∫⁻ x, G x := by
  have hfiber : ∀ i ∈ s,
      (∑ t ∈ points i, ∫⁻ r in R, H t r) ≤
        ((points i).card : ENNReal) * ∫⁻ x in J i, G x := by
    intro i hi
    rw [← nsmul_eq_mul]
    apply Finset.sum_le_card_nsmul
    intro t ht
    exact hprofile i hi t ht
  calc
    (∑ i ∈ s, ∑ t ∈ points i, ∫⁻ r in R, H t r) ≤
        ∑ i ∈ s, ((points i).card : ENNReal) * ∫⁻ x in J i, G x := by
      apply Finset.sum_le_sum
      intro i hi
      exact hfiber i hi
    _ ≤ K * M * ∫⁻ x, G x :=
      brrs_interval_family_lintegral_le_of_count_and_overlap s J
        (fun i => ((points i).card : ENNReal)) G K M hG hJ hcount hoverlap

/-- The `t+r` main-block estimate after combining cell geometry with finite
local counts and star-overlap. -/
theorem brrs_mainCell_add_fibered_lintegral_le
    {ι : Type*} (s : Finset ι) (anchor : ι → Real)
    (points : ι → Finset Real) (h : Real)
    (H : Real → Real → ENNReal) (G : Real → ENNReal) (K M : ENNReal)
    (hh : 0 < h) (hG : Measurable G)
    (hcell : ∀ i ∈ s, ∀ t ∈ points i,
      t ∈ brrsRadialBlockCell (anchor i) h)
    (hcount : ∀ i ∈ s, ((points i).card : ENNReal) ≤ K)
    (hoverlap : ∀ x,
      (∑ i ∈ s,
        (brrsRadialBlockCellStar (anchor i) h).indicator (fun _ => (1 : ENNReal)) x) ≤ M)
    (hprofile : ∀ i ∈ s, ∀ t ∈ points i, ∀ r ∈ Icc h (2 * h),
      H t r ≤ G (t + r)) :
    (∑ i ∈ s, ∑ t ∈ points i, ∫⁻ r in Icc h (2 * h), H t r) ≤
      K * M * ∫⁻ x, G x := by
  apply brrs_fibered_interval_lintegral_le_of_profile_count_and_overlap s
    (fun i => brrsRadialBlockCellStar (anchor i) h) points (Icc h (2 * h)) H G K M
  · exact hG
  · intro i hi
    exact measurableSet_Icc
  · exact hcount
  · exact hoverlap
  · intro i hi t ht
    exact brrs_lintegral_mainCell_add_le_of_le_profile (H t) G hh
      (hcell i hi t ht) (hprofile i hi t ht)

/-- The `t-r` main-block estimate after combining cell geometry with finite
local counts and star-overlap. -/
theorem brrs_mainCell_sub_fibered_lintegral_le
    {ι : Type*} (s : Finset ι) (anchor : ι → Real)
    (points : ι → Finset Real) (h : Real)
    (H : Real → Real → ENNReal) (G : Real → ENNReal) (K M : ENNReal)
    (hh : 0 < h) (hG : Measurable G)
    (hcell : ∀ i ∈ s, ∀ t ∈ points i,
      t ∈ brrsRadialBlockCell (anchor i) h)
    (hcount : ∀ i ∈ s, ((points i).card : ENNReal) ≤ K)
    (hoverlap : ∀ x,
      (∑ i ∈ s,
        (brrsRadialBlockCellStar (anchor i) h).indicator (fun _ => (1 : ENNReal)) x) ≤ M)
    (hprofile : ∀ i ∈ s, ∀ t ∈ points i, ∀ r ∈ Icc h (2 * h),
      H t r ≤ G (t - r)) :
    (∑ i ∈ s, ∑ t ∈ points i, ∫⁻ r in Icc h (2 * h), H t r) ≤
      K * M * ∫⁻ x, G x := by
  apply brrs_fibered_interval_lintegral_le_of_profile_count_and_overlap s
    (fun i => brrsRadialBlockCellStar (anchor i) h) points (Icc h (2 * h)) H G K M
  · exact hG
  · intro i hi
    exact measurableSet_Icc
  · exact hcount
  · exact hoverlap
  · intro i hi t ht
    exact brrs_lintegral_mainCell_sub_le_of_le_profile (H t) G hh
      (hcell i hi t ht) (hprofile i hi t ht)

/-- The integer lattice cells selected by a finite time set at scale `h`.
The floor choice makes this a finite grid without first choosing a global
endpoint or an auxiliary covering. -/
noncomputable def brrsRadialBlockGrid
    (T : Finset Real) (h : Real) : Finset Int := by
  classical
  exact T.image (fun t => Int.floor (t / h))

/-- The left endpoint of the lattice cell labelled by the integer `k`. -/
def brrsRadialBlockGridAnchor (h : Real) (k : Int) : Real :=
  (k : Real) * h

/-- A point belongs to the closed scale-`h` cell selected by its floor
coordinate.  This is the elementary covering step in the finite grid
decomposition. -/
theorem mem_brrsRadialBlockCell_gridAnchor
    {h t : Real} (hh : 0 < h) :
    t ∈ brrsRadialBlockCell
      (brrsRadialBlockGridAnchor h (Int.floor (t / h))) h := by
  change ((Int.floor (t / h) : Real) * h ≤ t) ∧
    t ≤ (Int.floor (t / h) : Real) * h + h
  constructor
  · exact (le_div_iff₀ hh).mp (Int.floor_le (t / h))
  · have hlt : t < ((Int.floor (t / h) : Real) + 1) * h :=
      (div_lt_iff₀ hh).mp (Int.lt_floor_add_one (t / h))
    calc
      t ≤ ((Int.floor (t / h) : Real) + 1) * h := hlt.le
      _ = (Int.floor (t / h) : Real) * h + h := by ring

/-- The lattice grid covers every member of the original finite time set. -/
theorem exists_mem_brrsRadialBlockGrid_cell
    {T : Finset Real} {h : Real} (hh : 0 < h) {t : Real} (ht : t ∈ T) :
    ∃ k ∈ brrsRadialBlockGrid T h,
      t ∈ brrsRadialBlockCell (brrsRadialBlockGridAnchor h k) h := by
  classical
  refine ⟨Int.floor (t / h), ?_, mem_brrsRadialBlockCell_gridAnchor hh⟩
  simp only [brrsRadialBlockGrid]
  exact Finset.mem_image.mpr ⟨t, ht, rfl⟩

/-- Membership in the finite point packet of a cell supplies the corresponding
cell-membership hypothesis used by the fibre estimate. -/
theorem mem_brrsRadialBlockCell_of_mem_points
    (T : Finset Real) (a h t : Real)
    (ht : t ∈ brrsRadialBlockCellPoints T a h) :
    t ∈ brrsRadialBlockCell a h := by
  classical
  simp only [brrsRadialBlockCellPoints, Finset.mem_filter] at ht
  exact ht.2

/-- The exact weighted local-count estimate supplied by `brrsKappa` for a
lattice cell.  It is just one term of the defining supremum, stated in the
cell notation used by the radial block argument. -/
theorem brrsRadialBlockCellPoints_weighted_card_le_brrsKappa
    (T : Finset Real) (R : NNReal) (alpha : Real) (k : Int) :
    (R : ENNReal) ^ (-alpha) *
        ((brrsRadialBlockCellPoints T
          (brrsRadialBlockGridAnchor (R : Real) k) (R : Real)).card : ENNReal) ≤
      brrsKappa T R alpha := by
  classical
  unfold brrsKappa
  change (R : ENNReal) ^ (-alpha) *
      ((T.filter fun t => t ∈
        Auto.Spherical.BRRS.brrsInterval
          (brrsRadialBlockGridAnchor (R : Real) k) (R : Real)).card : ENNReal) ≤
    ⨆ a : Real, (R : ENNReal) ^ (-alpha) *
      ((T.filter fun t => t ∈
        Auto.Spherical.BRRS.brrsInterval a (R : Real)).card : ENNReal)
  exact le_iSup (fun a : Real => (R : ENNReal) ^ (-alpha) *
    ((T.filter fun t => t ∈
      Auto.Spherical.BRRS.brrsInterval a (R : Real)).card : ENNReal))
    (brrsRadialBlockGridAnchor (R : Real) k)

/-- The unweighted cell count is controlled by the weighted BRRS local
coefficient after restoring the factor `R^alpha`. -/
theorem brrsRadialBlockCellPoints_card_le_rpow_mul_brrsKappa
    (T : Finset Real) (R : NNReal) (alpha : Real) (hR : R ≠ 0) (k : Int) :
    ((brrsRadialBlockCellPoints T
      (brrsRadialBlockGridAnchor (R : Real) k) (R : Real)).card : ENNReal) ≤
      (R : ENNReal) ^ alpha * brrsKappa T R alpha := by
  have hRzero : (R : ENNReal) ≠ 0 := ENNReal.coe_ne_zero.mpr hR
  have hmul : (R : ENNReal) ^ alpha * (R : ENNReal) ^ (-alpha) = 1 := by
    calc
      (R : ENNReal) ^ alpha * (R : ENNReal) ^ (-alpha) =
          (R : ENNReal) ^ (alpha + -alpha) :=
        (ENNReal.rpow_add alpha (-alpha) hRzero ENNReal.coe_ne_top).symm
      _ = 1 := by simp
  calc
    ((brrsRadialBlockCellPoints T
      (brrsRadialBlockGridAnchor (R : Real) k) (R : Real)).card : ENNReal) =
        1 * ((brrsRadialBlockCellPoints T
          (brrsRadialBlockGridAnchor (R : Real) k) (R : Real)).card : ENNReal) := by
      simp
    _ = ((R : ENNReal) ^ alpha * (R : ENNReal) ^ (-alpha)) *
        ((brrsRadialBlockCellPoints T
          (brrsRadialBlockGridAnchor (R : Real) k) (R : Real)).card : ENNReal) := by
      rw [hmul]
    _ = (R : ENNReal) ^ alpha *
        ((R : ENNReal) ^ (-alpha) *
          ((brrsRadialBlockCellPoints T
            (brrsRadialBlockGridAnchor (R : Real) k) (R : Real)).card : ENNReal)) := by
      ac_rfl
    _ ≤ (R : ENNReal) ^ alpha * brrsKappa T R alpha :=
      mul_le_mul' le_rfl
        (brrsRadialBlockCellPoints_weighted_card_le_brrsKappa T R alpha k)

/-- Any finite subfamily of the scale-`h` integer lattice has star overlap at
most seven.  The harmless endpoint slack makes the statement stable for closed
intervals and is enough for the BRRS main-block summation. -/
theorem brrsRadialBlockGridStar_overlap_le_seven
    (s : Finset Int) {h : Real} (hh : 0 < h) (x : Real) :
    (∑ k ∈ s,
      (brrsRadialBlockCellStar (brrsRadialBlockGridAnchor h k) h).indicator
        (fun _ => (1 : ENNReal)) x) ≤ 7 := by
  classical
  let sx : Finset Int := s.filter fun k =>
    x ∈ brrsRadialBlockCellStar (brrsRadialBlockGridAnchor h k) h
  have hsxsub : sx ⊆ Finset.Icc (Int.floor (x / h) - 3)
      (Int.floor (x / h) + 3) := by
    intro k hk
    change k ∈ s.filter (fun k =>
      x ∈ brrsRadialBlockCellStar (brrsRadialBlockGridAnchor h k) h) at hk
    rcases Finset.mem_filter.mp hk with ⟨-, hkstar⟩
    simp only [brrsRadialBlockCellStar, brrsRadialBlockGridAnchor, mem_Icc] at hkstar
    have hleft : ((k - 3 : Int) : Real) ≤ x / h := by
      apply (le_div_iff₀ hh).mpr
      calc
        ((k - 3 : Int) : Real) * h = (k : Real) * h - 3 * h := by
          push_cast
          ring
        _ ≤ (k : Real) * h - 2 * h := by linarith
        _ ≤ x := hkstar.1
    have hfloorleft : k - 3 ≤ Int.floor (x / h) :=
      (Int.le_floor).mpr hleft
    have hdivright : x / h ≤ ((k + 3 : Int) : Real) := by
      apply (div_le_iff₀ hh).mpr
      calc
        x ≤ (k : Real) * h + 3 * h := hkstar.2
        _ = ((k + 3 : Int) : Real) * h := by
          push_cast
          ring
    have hcast : ((k + 3 : Int) : Real) < ((k + 4 : Int) : Real) := by
      push_cast
      linarith
    have hfloorright : Int.floor (x / h) < k + 4 :=
      (Int.floor_lt).mpr (lt_of_le_of_lt hdivright hcast)
    exact Finset.mem_Icc.mpr ⟨by omega, by omega⟩
  have hcard : sx.card ≤ 7 := by
    calc
      sx.card ≤ (Finset.Icc (Int.floor (x / h) - 3)
          (Int.floor (x / h) + 3)).card := Finset.card_le_card hsxsub
      _ = 7 := by
        rw [Int.card_Icc]
        rw [show Int.floor (x / h) + 3 + 1 -
            (Int.floor (x / h) - 3) = (7 : Int) by ring]
        decide
  have hsum :
      (∑ k ∈ s,
        (brrsRadialBlockCellStar (brrsRadialBlockGridAnchor h k) h).indicator
          (fun _ => (1 : ENNReal)) x) = (sx.card : ENNReal) := by
    calc
      (∑ k ∈ s,
        (brrsRadialBlockCellStar (brrsRadialBlockGridAnchor h k) h).indicator
          (fun _ => (1 : ENNReal)) x) =
          ∑ k ∈ s, if x ∈
            brrsRadialBlockCellStar (brrsRadialBlockGridAnchor h k) h then
              (1 : ENNReal) else 0 := by
          apply Finset.sum_congr rfl
          intro k hk
          simp only [Set.indicator]
      _ = (sx.card : ENNReal) := by
        rw [Finset.sum_boole]
  rw [hsum]
  exact_mod_cast hcard

/-- The integer grid provides the literal finite family needed to instantiate
the `t+r` fibre estimate with the BRRS local counting coefficient. -/
theorem brrs_grid_mainCell_add_fibered_lintegral_le
    (T : Finset Real) (R : NNReal) (alpha : Real) (hR : R ≠ 0)
    (H : Real → Real → ENNReal) (G : Real → ENNReal) (hG : Measurable G)
    (hprofile : ∀ k ∈ brrsRadialBlockGrid T (R : Real),
      ∀ t ∈ brrsRadialBlockCellPoints T
        (brrsRadialBlockGridAnchor (R : Real) k) (R : Real),
      ∀ r ∈ Icc (R : Real) (2 * (R : Real)), H t r ≤ G (t + r)) :
    (∑ k ∈ brrsRadialBlockGrid T (R : Real),
      ∑ t ∈ brrsRadialBlockCellPoints T
        (brrsRadialBlockGridAnchor (R : Real) k) (R : Real),
        ∫⁻ r in Icc (R : Real) (2 * (R : Real)), H t r) ≤
      ((R : ENNReal) ^ alpha * brrsKappa T R alpha) * 7 * ∫⁻ x, G x := by
  have hRposNN : 0 < R := (pos_iff_ne_zero).mpr hR
  have hRpos : 0 < (R : Real) := NNReal.coe_pos.mpr hRposNN
  apply brrs_mainCell_add_fibered_lintegral_le
    (s := brrsRadialBlockGrid T (R : Real))
    (anchor := brrsRadialBlockGridAnchor (R : Real))
    (points := fun k => brrsRadialBlockCellPoints T
      (brrsRadialBlockGridAnchor (R : Real) k) (R : Real))
    (h := (R : Real)) (H := H) (G := G)
    (K := (R : ENNReal) ^ alpha * brrsKappa T R alpha) (M := 7)
  · exact hRpos
  · exact hG
  · intro k hk t ht
    exact mem_brrsRadialBlockCell_of_mem_points T
      (brrsRadialBlockGridAnchor (R : Real) k) (R : Real) t ht
  · intro k hk
    exact brrsRadialBlockCellPoints_card_le_rpow_mul_brrsKappa T R alpha hR k
  · intro x
    exact brrsRadialBlockGridStar_overlap_le_seven
      (brrsRadialBlockGrid T (R : Real)) hRpos x
  · exact hprofile

/-- The reflected `t-r` version of the concrete grid estimate. -/
theorem brrs_grid_mainCell_sub_fibered_lintegral_le
    (T : Finset Real) (R : NNReal) (alpha : Real) (hR : R ≠ 0)
    (H : Real → Real → ENNReal) (G : Real → ENNReal) (hG : Measurable G)
    (hprofile : ∀ k ∈ brrsRadialBlockGrid T (R : Real),
      ∀ t ∈ brrsRadialBlockCellPoints T
        (brrsRadialBlockGridAnchor (R : Real) k) (R : Real),
      ∀ r ∈ Icc (R : Real) (2 * (R : Real)), H t r ≤ G (t - r)) :
    (∑ k ∈ brrsRadialBlockGrid T (R : Real),
      ∑ t ∈ brrsRadialBlockCellPoints T
        (brrsRadialBlockGridAnchor (R : Real) k) (R : Real),
        ∫⁻ r in Icc (R : Real) (2 * (R : Real)), H t r) ≤
      ((R : ENNReal) ^ alpha * brrsKappa T R alpha) * 7 * ∫⁻ x, G x := by
  have hRposNN : 0 < R := (pos_iff_ne_zero).mpr hR
  have hRpos : 0 < (R : Real) := NNReal.coe_pos.mpr hRposNN
  apply brrs_mainCell_sub_fibered_lintegral_le
    (s := brrsRadialBlockGrid T (R : Real))
    (anchor := brrsRadialBlockGridAnchor (R : Real))
    (points := fun k => brrsRadialBlockCellPoints T
      (brrsRadialBlockGridAnchor (R : Real) k) (R : Real))
    (h := (R : Real)) (H := H) (G := G)
    (K := (R : ENNReal) ^ alpha * brrsKappa T R alpha) (M := 7)
  · exact hRpos
  · exact hG
  · intro k hk t ht
    exact mem_brrsRadialBlockCell_of_mem_points T
      (brrsRadialBlockGridAnchor (R : Real) k) (R : Real) t ht
  · intro k hk
    exact brrsRadialBlockCellPoints_card_le_rpow_mul_brrsKappa T R alpha hR k
  · intro x
    exact brrsRadialBlockGridStar_overlap_le_seven
      (brrsRadialBlockGrid T (R : Real)) hRpos x
  · exact hprofile

/-- The floor fibre of a lattice cell is contained in its closed cell packet.
This is the link between an exact disjoint reindexing and the convenient
closed intervals used for the local-count estimate. -/
theorem brrsRadialBlockGrid_fibre_subset_cellPoints
    (T : Finset Real) {h : Real} (hh : 0 < h) (k : Int) :
    T.filter (fun t => Int.floor (t / h) = k) ⊆
      brrsRadialBlockCellPoints T (brrsRadialBlockGridAnchor h k) h := by
  classical
  intro t ht
  simp only [Finset.mem_filter] at ht
  simp only [brrsRadialBlockCellPoints, Finset.mem_filter]
  refine ⟨ht.1, ?_⟩
  rw [← ht.2]
  exact mem_brrsRadialBlockCell_gridAnchor hh

/-- Exact finite reindexing by the floor-grid cells. -/
theorem brrsRadialBlockGrid_fibre_sum_eq
    (T : Finset Real) (h : Real) (F : Real → ENNReal) :
    (∑ k ∈ brrsRadialBlockGrid T h,
      ∑ t ∈ T with Int.floor (t / h) = k, F t) = ∑ t ∈ T, F t := by
  classical
  have hmaps : ∀ t ∈ T, Int.floor (t / h) ∈ brrsRadialBlockGrid T h := by
    intro t ht
    simp only [brrsRadialBlockGrid]
    exact Finset.mem_image.mpr ⟨t, ht, rfl⟩
  exact Finset.sum_fiberwise_of_maps_to hmaps F

/-- A nonnegative finite time sum is bounded by the sum over the corresponding
closed lattice-cell packets.  Boundary points may occur in two closed packets,
which only helps this upper estimate. -/
theorem brrs_sum_le_brrsRadialBlockGrid_cellPoints_sum
    (T : Finset Real) {h : Real} (hh : 0 < h) (F : Real → ENNReal) :
    (∑ t ∈ T, F t) ≤
      ∑ k ∈ brrsRadialBlockGrid T h,
        ∑ t ∈ brrsRadialBlockCellPoints T
          (brrsRadialBlockGridAnchor h k) h, F t := by
  classical
  rw [← brrsRadialBlockGrid_fibre_sum_eq T h F]
  apply Finset.sum_le_sum
  intro k hk
  apply Finset.sum_le_sum_of_subset
  exact brrsRadialBlockGrid_fibre_subset_cellPoints T hh k

/-- The concrete grid estimate directly controls the finite `t+r` radial
block sum over the original time packet. -/
theorem brrs_sum_mainCell_add_lintegral_le
    (T : Finset Real) (R : NNReal) (alpha : Real) (hR : R ≠ 0)
    (H : Real → Real → ENNReal) (G : Real → ENNReal) (hG : Measurable G)
    (hprofile : ∀ t ∈ T, ∀ r ∈ Icc (R : Real) (2 * (R : Real)),
      H t r ≤ G (t + r)) :
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)), H t r) ≤
      ((R : ENNReal) ^ alpha * brrsKappa T R alpha) * 7 * ∫⁻ x, G x := by
  classical
  have hRposNN : 0 < R := (pos_iff_ne_zero).mpr hR
  have hRpos : 0 < (R : Real) := NNReal.coe_pos.mpr hRposNN
  calc
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)), H t r) ≤
        ∑ k ∈ brrsRadialBlockGrid T (R : Real),
          ∑ t ∈ brrsRadialBlockCellPoints T
            (brrsRadialBlockGridAnchor (R : Real) k) (R : Real),
            ∫⁻ r in Icc (R : Real) (2 * (R : Real)), H t r :=
      brrs_sum_le_brrsRadialBlockGrid_cellPoints_sum T hRpos
        (fun t => ∫⁻ r in Icc (R : Real) (2 * (R : Real)), H t r)
    _ ≤ ((R : ENNReal) ^ alpha * brrsKappa T R alpha) * 7 * ∫⁻ x, G x := by
      apply brrs_grid_mainCell_add_fibered_lintegral_le T R alpha hR H G hG
      intro k hk t ht r hr
      have htT : t ∈ T := by
        simpa only [brrsRadialBlockCellPoints, Finset.mem_filter] using
          (Finset.mem_filter.mp ht).1
      exact hprofile t htT r hr

/-- The reflected `t-r` radial block has the same concrete grid bound. -/
theorem brrs_sum_mainCell_sub_lintegral_le
    (T : Finset Real) (R : NNReal) (alpha : Real) (hR : R ≠ 0)
    (H : Real → Real → ENNReal) (G : Real → ENNReal) (hG : Measurable G)
    (hprofile : ∀ t ∈ T, ∀ r ∈ Icc (R : Real) (2 * (R : Real)),
      H t r ≤ G (t - r)) :
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)), H t r) ≤
      ((R : ENNReal) ^ alpha * brrsKappa T R alpha) * 7 * ∫⁻ x, G x := by
  classical
  have hRposNN : 0 < R := (pos_iff_ne_zero).mpr hR
  have hRpos : 0 < (R : Real) := NNReal.coe_pos.mpr hRposNN
  calc
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)), H t r) ≤
        ∑ k ∈ brrsRadialBlockGrid T (R : Real),
          ∑ t ∈ brrsRadialBlockCellPoints T
            (brrsRadialBlockGridAnchor (R : Real) k) (R : Real),
            ∫⁻ r in Icc (R : Real) (2 * (R : Real)), H t r :=
      brrs_sum_le_brrsRadialBlockGrid_cellPoints_sum T hRpos
        (fun t => ∫⁻ r in Icc (R : Real) (2 * (R : Real)), H t r)
    _ ≤ ((R : ENNReal) ^ alpha * brrsKappa T R alpha) * 7 * ∫⁻ x, G x := by
      apply brrs_grid_mainCell_sub_fibered_lintegral_le T R alpha hR H G hG
      intro k hk t ht r hr
      have htT : t ∈ T := by
        simpa only [brrsRadialBlockCellPoints, Finset.mem_filter] using
          (Finset.mem_filter.mp ht).1
      exact hprofile t htT r hr

/-- A radial weight bounded by the reciprocal block power can be absorbed
into the `t + r` block estimate.  The factorized conclusion is useful when
one wants to retain the radius power before cancelling it. -/
theorem brrs_sum_mainCell_add_weighted_lintegral_le
    (T : Finset Real) (R : NNReal) (alpha : Real) (hR : R ≠ 0)
    (W F : Real → ENNReal) (hF : Measurable F)
    (hW : ∀ r ∈ Icc (R : Real) (2 * (R : Real)),
      W r ≤ (R : ENNReal) ^ (-alpha)) :
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * F (t + r)) ≤
      ((R : ENNReal) ^ alpha * brrsKappa T R alpha) * 7 *
        ((R : ENNReal) ^ (-alpha) * ∫⁻ x, F x) := by
  rw [← lintegral_const_mul ((R : ENNReal) ^ (-alpha)) hF]
  apply brrs_sum_mainCell_add_lintegral_le T R alpha hR
    (fun t r => W r * F (t + r))
    (fun x => (R : ENNReal) ^ (-alpha) * F x)
    (measurable_const.mul hF)
  intro t ht r hr
  exact mul_le_mul' (hW r hr) le_rfl

/-- The reciprocal radial block weight exactly cancels the scale factor in
the `t + r` block estimate.  This is the scale-free radial cancellation used
by the BRRS one-dimensional block argument. -/
theorem brrs_sum_mainCell_add_weighted_lintegral_le_seven_mul_brrsKappa
    (T : Finset Real) (R : NNReal) (alpha : Real) (hR : R ≠ 0)
    (W F : Real → ENNReal) (hF : Measurable F)
    (hW : ∀ r ∈ Icc (R : Real) (2 * (R : Real)),
      W r ≤ (R : ENNReal) ^ (-alpha)) :
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * F (t + r)) ≤
      7 * brrsKappa T R alpha * ∫⁻ x, F x := by
  calc
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * F (t + r)) ≤
        ((R : ENNReal) ^ alpha * brrsKappa T R alpha) * 7 *
          ((R : ENNReal) ^ (-alpha) * ∫⁻ x, F x) :=
      brrs_sum_mainCell_add_weighted_lintegral_le T R alpha hR W F hF hW
    _ = 7 * brrsKappa T R alpha * ∫⁻ x, F x := by
      have hRzero : (R : ENNReal) ≠ 0 := ENNReal.coe_ne_zero.mpr hR
      have hscale : (R : ENNReal) ^ alpha * (R : ENNReal) ^ (-alpha) = 1 := by
        rw [← ENNReal.rpow_add alpha (-alpha) hRzero ENNReal.coe_ne_top]
        simp
      calc
        ((R : ENNReal) ^ alpha * brrsKappa T R alpha) * 7 *
            ((R : ENNReal) ^ (-alpha) * ∫⁻ x, F x) =
            ((R : ENNReal) ^ alpha * (R : ENNReal) ^ (-alpha)) *
              (brrsKappa T R alpha * 7 * ∫⁻ x, F x) := by ac_rfl
        _ = 7 * brrsKappa T R alpha * ∫⁻ x, F x := by
          rw [hscale, one_mul]
          ac_rfl

/-- The reflected `t - r` version of the factorized weighted block bound. -/
theorem brrs_sum_mainCell_sub_weighted_lintegral_le
    (T : Finset Real) (R : NNReal) (alpha : Real) (hR : R ≠ 0)
    (W F : Real → ENNReal) (hF : Measurable F)
    (hW : ∀ r ∈ Icc (R : Real) (2 * (R : Real)),
      W r ≤ (R : ENNReal) ^ (-alpha)) :
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * F (t - r)) ≤
      ((R : ENNReal) ^ alpha * brrsKappa T R alpha) * 7 *
        ((R : ENNReal) ^ (-alpha) * ∫⁻ x, F x) := by
  rw [← lintegral_const_mul ((R : ENNReal) ^ (-alpha)) hF]
  apply brrs_sum_mainCell_sub_lintegral_le T R alpha hR
    (fun t r => W r * F (t - r))
    (fun x => (R : ENNReal) ^ (-alpha) * F x)
    (measurable_const.mul hF)
  intro t ht r hr
  exact mul_le_mul' (hW r hr) le_rfl

/-- The reciprocal radial block weight exactly cancels the scale factor in
the reflected `t - r` block estimate. -/
theorem brrs_sum_mainCell_sub_weighted_lintegral_le_seven_mul_brrsKappa
    (T : Finset Real) (R : NNReal) (alpha : Real) (hR : R ≠ 0)
    (W F : Real → ENNReal) (hF : Measurable F)
    (hW : ∀ r ∈ Icc (R : Real) (2 * (R : Real)),
      W r ≤ (R : ENNReal) ^ (-alpha)) :
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * F (t - r)) ≤
      7 * brrsKappa T R alpha * ∫⁻ x, F x := by
  calc
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * F (t - r)) ≤
        ((R : ENNReal) ^ alpha * brrsKappa T R alpha) * 7 *
          ((R : ENNReal) ^ (-alpha) * ∫⁻ x, F x) :=
      brrs_sum_mainCell_sub_weighted_lintegral_le T R alpha hR W F hF hW
    _ = 7 * brrsKappa T R alpha * ∫⁻ x, F x := by
      have hRzero : (R : ENNReal) ≠ 0 := ENNReal.coe_ne_zero.mpr hR
      have hscale : (R : ENNReal) ^ alpha * (R : ENNReal) ^ (-alpha) = 1 := by
        rw [← ENNReal.rpow_add alpha (-alpha) hRzero ENNReal.coe_ne_top]
        simp
      calc
        ((R : ENNReal) ^ alpha * brrsKappa T R alpha) * 7 *
            ((R : ENNReal) ^ (-alpha) * ∫⁻ x, F x) =
            ((R : ENNReal) ^ alpha * (R : ENNReal) ^ (-alpha)) *
              (brrsKappa T R alpha * 7 * ∫⁻ x, F x) := by ac_rfl
        _ = 7 * brrsKappa T R alpha * ∫⁻ x, F x := by
          rw [hscale, one_mul]
          ac_rfl

end BRRSRadialBlockIntervalGeometry

/-! ### A direct planar fixed-time kernel estimate for the BRRS cutoff

The MSS fixed-time endpoint is proved for its particular Littlewood--Paley
cutoff.  The following local calculation instead works with the literal
one-dimensional BRRS cutoff.  It begins with the same cone-cancellation
identity, stated here for the BRRS multiplier at frequency level zero.
-/

noncomputable section

private def brrsPlaneRadialPhase (a : Real) : Euclidean 2 → Complex :=
  fun x => Complex.exp (((a * ‖x‖ : Real) : Complex) * Complex.I)

private def brrsPlaneRadialPhaseCoeff (a : Real) (x v : Euclidean 2) : Complex :=
  (((a * ‖x‖⁻¹ * inner Real x v : Real) : Complex) * Complex.I)

private def brrsPlaneRadialLaplacianCoeff (a : Real) (x : Euclidean 2) : Complex :=
  (((a * ‖x‖⁻¹ : Real) : Complex) * Complex.I)

private theorem brrs_plane_radial_phase_laplacian_mul_cancelled
    (chi : Euclidean 2 → Complex) (a b : Real) (x : Euclidean 2)
    (hx : x ≠ 0) (hchi : ContDiffAt Real 2 chi x) (hsq : a ^ 2 = b ^ 2) :
    -Laplacian.laplacian (fun y => brrsPlaneRadialPhase a y * chi y) x -
        ((b ^ 2 : Real) : Complex) * (brrsPlaneRadialPhase a x * chi x) =
      -brrsPlaneRadialPhase a x *
        (Laplacian.laplacian chi x +
          (∑ i, (brrsPlaneRadialPhaseCoeff a x
                (stdOrthonormalBasis Real (Euclidean 2) i) *
                fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) +
            fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) *
              brrsPlaneRadialPhaseCoeff a x
                (stdOrthonormalBasis Real (Euclidean 2) i))) +
          brrsPlaneRadialLaplacianCoeff a x * chi x) := by
  have hphase : ContDiffAt Real 2 (brrsPlaneRadialPhase a) x := by
    unfold brrsPlaneRadialPhase
    have hnorm : ContDiffAt Real 2 (fun y : Euclidean 2 => ‖y‖) x :=
      contDiffAt_norm Real hx
    have hreal : ContDiffAt Real 2 (fun y : Euclidean 2 => a * ‖y‖) x := by
      fun_prop
    have hcomplex : ContDiffAt Real 2
        (fun y : Euclidean 2 => ((a * ‖y‖ : Real) : Complex)) x := by
      exact Complex.ofRealCLM.contDiff.contDiffAt.comp x hreal
    exact (hcomplex.mul contDiffAt_const).cexp
  rw [Auto.Spherical.Auxiliary.laplacian_mul_at
    (brrsPlaneRadialPhase a) chi hphase hchi]
  rw [show Laplacian.laplacian (brrsPlaneRadialPhase a) x =
      brrsPlaneRadialPhase a x * (-((a ^ 2 : Real) : Complex) +
        brrsPlaneRadialLaplacianCoeff a x) by
    change Laplacian.laplacian (fun y : Euclidean 2 =>
      Complex.exp (((a * ‖y‖ : Real) : Complex) * Complex.I)) x =
        Complex.exp (((a * ‖x‖ : Real) : Complex) * Complex.I) *
          (-((a ^ 2 : Real) : Complex) +
            (((a * ‖x‖⁻¹ : Real) : Complex) * Complex.I))
    exact Auto.Spherical.Auxiliary.laplacian_radial_phase_eq a x hx]
  simp_rw [show ∀ i,
      fderiv Real (brrsPlaneRadialPhase a) x
          (stdOrthonormalBasis Real (Euclidean 2) i) =
        brrsPlaneRadialPhase a x *
          brrsPlaneRadialPhaseCoeff a x
            (stdOrthonormalBasis Real (Euclidean 2) i) by
      intro i
      change fderiv Real (fun y : Euclidean 2 =>
        Complex.exp (((a * ‖y‖ : Real) : Complex) * Complex.I)) x
          (stdOrthonormalBasis Real (Euclidean 2) i) =
        Complex.exp (((a * ‖x‖ : Real) : Complex) * Complex.I) *
          (((a * ‖x‖⁻¹ * inner Real x
            (stdOrthonormalBasis Real (Euclidean 2) i) : Real) : Complex) *
              Complex.I)
      exact Auto.Spherical.Auxiliary.fderiv_radial_phase_apply a x
        (stdOrthonormalBasis Real (Euclidean 2) i) hx]
  have hcross : ∀ i,
      brrsPlaneRadialPhase a x * brrsPlaneRadialPhaseCoeff a x
          (stdOrthonormalBasis Real (Euclidean 2) i) *
          fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) +
        fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) *
          (brrsPlaneRadialPhase a x * brrsPlaneRadialPhaseCoeff a x
            (stdOrthonormalBasis Real (Euclidean 2) i)) =
        brrsPlaneRadialPhase a x *
          (brrsPlaneRadialPhaseCoeff a x
            (stdOrthonormalBasis Real (Euclidean 2) i) *
            fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) +
          fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) *
            brrsPlaneRadialPhaseCoeff a x
              (stdOrthonormalBasis Real (Euclidean 2) i)) := by
    intro i
    ring
  simp_rw [hcross]
  rw [← Finset.mul_sum]
  have hsqC : (a : Complex) ^ 2 = (b : Complex) ^ 2 := by
    exact_mod_cast hsq
  push_cast
  rw [hsqC]
  ring

private def brrsPlaneHalfWavePhaseParameter (s : Real) : Real :=
  2 * Real.pi * s

private def brrsPlaneLevelZeroCutoff (Φ : BRRSAnnularCutoff) :
    Euclidean 2 → Complex :=
  brrsDyadicMultiplier Φ 0

private def brrsPlaneLevelZeroCutoffLaplacian (Φ : BRRSAnnularCutoff) :
    Euclidean 2 → Complex :=
  Laplacian.laplacian (brrsPlaneLevelZeroCutoff Φ)

private def brrsPlaneLevelZeroRadialCutoffTerm (Φ : BRRSAnnularCutoff) :
    Euclidean 2 → Complex := fun x =>
  (∑ i, (brrsPlaneRadialPhaseCoeff (brrsPlaneHalfWavePhaseParameter 1) x
      (stdOrthonormalBasis Real (Euclidean 2) i) *
    fderiv Real (brrsPlaneLevelZeroCutoff Φ) x
      (stdOrthonormalBasis Real (Euclidean 2) i) +
    fderiv Real (brrsPlaneLevelZeroCutoff Φ) x
      (stdOrthonormalBasis Real (Euclidean 2) i) *
      brrsPlaneRadialPhaseCoeff (brrsPlaneHalfWavePhaseParameter 1) x
        (stdOrthonormalBasis Real (Euclidean 2) i))) +
    brrsPlaneRadialLaplacianCoeff (brrsPlaneHalfWavePhaseParameter 1) x *
      brrsPlaneLevelZeroCutoff Φ x

private theorem brrs_halfWaveMultiplier_eq_planeRadialPhase (s : Real) :
    halfWaveMultiplier (d := 2) s =
      brrsPlaneRadialPhase (brrsPlaneHalfWavePhaseParameter s) := by
  rfl

private theorem brrs_plane_levelZeroCutoff_contDiffAt (Φ : BRRSAnnularCutoff)
    (x : Euclidean 2) : ContDiffAt Real 2 (brrsPlaneLevelZeroCutoff Φ) x := by
  have htwo : (2 : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by
    change ((2 : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞)
    exact WithTop.coe_le_coe.mpr le_top
  exact ((contDiff_brrsDyadicMultiplier Φ 0).of_le htwo).contDiffAt

private theorem brrs_plane_phase_parameter_sq (s : Real) :
    (brrsPlaneHalfWavePhaseParameter s) ^ 2 = (2 * Real.pi * s) ^ 2 := by
  rfl

private theorem brrs_plane_radialPhaseCoeff_scale (s : Real) (x v : Euclidean 2) :
    brrsPlaneRadialPhaseCoeff (brrsPlaneHalfWavePhaseParameter s) x v =
      s * brrsPlaneRadialPhaseCoeff (brrsPlaneHalfWavePhaseParameter 1) x v := by
  simp only [brrsPlaneRadialPhaseCoeff, brrsPlaneHalfWavePhaseParameter]
  push_cast
  ring

private theorem brrs_plane_radialLaplacianCoeff_scale (s : Real) (x : Euclidean 2) :
    brrsPlaneRadialLaplacianCoeff (brrsPlaneHalfWavePhaseParameter s) x =
      s * brrsPlaneRadialLaplacianCoeff (brrsPlaneHalfWavePhaseParameter 1) x := by
  simp only [brrsPlaneRadialLaplacianCoeff, brrsPlaneHalfWavePhaseParameter]
  push_cast
  ring

private theorem brrs_cancelled_levelZero_phase_formula
    (Φ : BRRSAnnularCutoff) (s : Real) (x : Euclidean 2) (hx : x ≠ 0) :
    Auto.Spherical.MSS.cancelledWaveLaplacian
        (brrsDyadicHalfWaveSchwartzSymbol Φ 0 s) s x =
      -halfWaveMultiplier (d := 2) s x *
        (brrsPlaneLevelZeroCutoffLaplacian Φ x +
          s * brrsPlaneLevelZeroRadialCutoffTerm Φ x) := by
  have hfun : (brrsDyadicHalfWaveSchwartzSymbol Φ 0 s : Euclidean 2 → Complex) =
      fun y => brrsPlaneRadialPhase (brrsPlaneHalfWavePhaseParameter s) y *
        brrsPlaneLevelZeroCutoff Φ y := by
    funext y
    rw [brrsDyadicHalfWaveSchwartzSymbol_apply]
    rfl
  rw [Auto.Spherical.MSS.cancelledWaveLaplacian]
  simp only [sub_apply, neg_apply, smul_apply,
    SchwartzMap.laplacian_apply, smul_eq_mul]
  change -Laplacian.laplacian (brrsDyadicHalfWaveSchwartzSymbol Φ 0 s :
      Euclidean 2 → Complex) x -
      (((2 * Real.pi * s) ^ 2 : Real) : Complex) *
        brrsDyadicHalfWaveSchwartzSymbol Φ 0 s x = _
  rw [hfun]
  rw [brrs_plane_radial_phase_laplacian_mul_cancelled
    (brrsPlaneLevelZeroCutoff Φ) (brrsPlaneHalfWavePhaseParameter s)
    (2 * Real.pi * s) x hx (brrs_plane_levelZeroCutoff_contDiffAt Φ x)
    (brrs_plane_phase_parameter_sq s)]
  rw [← brrs_halfWaveMultiplier_eq_planeRadialPhase]
  simp only [brrsPlaneLevelZeroCutoffLaplacian,
    brrsPlaneLevelZeroRadialCutoffTerm]
  have hsum : (∑ i, (brrsPlaneRadialPhaseCoeff
        (brrsPlaneHalfWavePhaseParameter s) x
        (stdOrthonormalBasis Real (Euclidean 2) i) *
      fderiv Real (brrsPlaneLevelZeroCutoff Φ) x
        (stdOrthonormalBasis Real (Euclidean 2) i) +
      fderiv Real (brrsPlaneLevelZeroCutoff Φ) x
        (stdOrthonormalBasis Real (Euclidean 2) i) *
        brrsPlaneRadialPhaseCoeff (brrsPlaneHalfWavePhaseParameter s) x
          (stdOrthonormalBasis Real (Euclidean 2) i))) =
        s * (∑ i,
          (brrsPlaneRadialPhaseCoeff (brrsPlaneHalfWavePhaseParameter 1) x
            (stdOrthonormalBasis Real (Euclidean 2) i) *
            fderiv Real (brrsPlaneLevelZeroCutoff Φ) x
              (stdOrthonormalBasis Real (Euclidean 2) i) +
          fderiv Real (brrsPlaneLevelZeroCutoff Φ) x
            (stdOrthonormalBasis Real (Euclidean 2) i) *
            brrsPlaneRadialPhaseCoeff (brrsPlaneHalfWavePhaseParameter 1) x
              (stdOrthonormalBasis Real (Euclidean 2) i))) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    rw [brrs_plane_radialPhaseCoeff_scale]
    ring
  have hradial : brrsPlaneRadialLaplacianCoeff
      (brrsPlaneHalfWavePhaseParameter s) x * brrsPlaneLevelZeroCutoff Φ x =
      s * (brrsPlaneRadialLaplacianCoeff
        (brrsPlaneHalfWavePhaseParameter 1) x * brrsPlaneLevelZeroCutoff Φ x) := by
    rw [brrs_plane_radialLaplacianCoeff_scale]
    ring
  rw [hsum, hradial]
  ring

private theorem brrs_halfWaveMultiplier_neg_one_mul_one (x : Euclidean 2) :
    halfWaveMultiplier (d := 2) (-1) x * halfWaveMultiplier (d := 2) 1 x = 1 := by
  rw [← halfWaveMultiplier_add]
  simp [halfWaveMultiplier]

private theorem brrs_halfWaveMultiplier_zero (x : Euclidean 2) :
    halfWaveMultiplier (d := 2) 0 x = 1 := by
  simp [halfWaveMultiplier]

private theorem brrs_cancelled_levelZero_phase_affine
    (Φ : BRRSAnnularCutoff) (s : Real) (x : Euclidean 2) (hx : x ≠ 0) :
    Auto.Spherical.MSS.cancelledWaveLaplacian
        (brrsDyadicHalfWaveSchwartzSymbol Φ 0 s) s x =
      halfWaveMultiplier (d := 2) s x *
        (Auto.Spherical.MSS.cancelledWaveLaplacian
            (brrsDyadicHalfWaveSchwartzSymbol Φ 0 0) 0 x +
          s * (halfWaveMultiplier (d := 2) (-1) x *
              Auto.Spherical.MSS.cancelledWaveLaplacian
                (brrsDyadicHalfWaveSchwartzSymbol Φ 0 1) 1 x -
            Auto.Spherical.MSS.cancelledWaveLaplacian
              (brrsDyadicHalfWaveSchwartzSymbol Φ 0 0) 0 x)) := by
  rw [brrs_cancelled_levelZero_phase_formula Φ s x hx,
    brrs_cancelled_levelZero_phase_formula Φ 0 x hx,
    brrs_cancelled_levelZero_phase_formula Φ 1 x hx]
  rw [brrs_halfWaveMultiplier_zero]
  have hinv : halfWaveMultiplier (d := 2) (-1) x *
      halfWaveMultiplier (d := 2) 1 x = 1 :=
    brrs_halfWaveMultiplier_neg_one_mul_one x
  have hdephase : halfWaveMultiplier (d := 2) (-1) x *
      (halfWaveMultiplier (d := 2) 1 x *
        (brrsPlaneLevelZeroCutoffLaplacian Φ x +
          brrsPlaneLevelZeroRadialCutoffTerm Φ x)) =
      brrsPlaneLevelZeroCutoffLaplacian Φ x +
        brrsPlaneLevelZeroRadialCutoffTerm Φ x := by
    calc
      _ = (halfWaveMultiplier (d := 2) (-1) x *
          halfWaveMultiplier (d := 2) 1 x) *
          (brrsPlaneLevelZeroCutoffLaplacian Φ x +
            brrsPlaneLevelZeroRadialCutoffTerm Φ x) := by ring
      _ = (1 : Complex) *
          (brrsPlaneLevelZeroCutoffLaplacian Φ x +
            brrsPlaneLevelZeroRadialCutoffTerm Φ x) := by rw [hinv]
      _ = _ := by ring
  norm_num
  rw [hdephase]
  ring

private theorem brrs_integral_norm_sq_phase_affine_le
    (r r0 r1 A p : Euclidean 2 → Complex) (s : Real)
    (hs : 1 ≤ s) (hp : ∀ x, ‖p x‖ = 1)
    (hidentity : ∀ᵐ x ∂volume, r x = p x * (r0 x + s * A x))
    (hA : ∀ x, ‖A x‖ ≤ ‖r1 x‖ + ‖r0 x‖)
    (hr : Integrable (fun x => ‖r x‖ ^ 2))
    (hr0 : Integrable (fun x => ‖r0 x‖ ^ 2))
    (hr1 : Integrable (fun x => ‖r1 x‖ ^ 2)) :
    (∫ x : Euclidean 2, ‖r x‖ ^ 2) ≤
      s ^ 2 * (8 * (∫ x : Euclidean 2, ‖r0 x‖ ^ 2) +
        2 * (∫ x : Euclidean 2, ‖r1 x‖ ^ 2)) := by
  have hH : Integrable (fun x : Euclidean 2 =>
      8 * ‖r0 x‖ ^ 2 + 2 * ‖r1 x‖ ^ 2) :=
    (hr0.const_mul 8).add (hr1.const_mul 2)
  have hHs : Integrable (fun x : Euclidean 2 =>
      s ^ 2 * (8 * ‖r0 x‖ ^ 2 + 2 * ‖r1 x‖ ^ 2)) :=
    hH.const_mul (s ^ 2)
  have hpoint : ∀ᵐ x : Euclidean 2 ∂volume,
      ‖r x‖ ^ 2 ≤ s ^ 2 * (8 * ‖r0 x‖ ^ 2 + 2 * ‖r1 x‖ ^ 2) :=
    hidentity.mono fun x hident => by
    rw [hident, norm_mul, hp x, one_mul]
    have hnonneg : 0 ≤ 2 * ‖r0 x‖ + ‖r1 x‖ := by positivity
    have hs0 : 0 ≤ s := by linarith
    have hlin : ‖r0 x + s * A x‖ ≤ s * (2 * ‖r0 x‖ + ‖r1 x‖) := by
      calc
        ‖r0 x + s * A x‖ ≤ ‖r0 x‖ + ‖s * A x‖ := norm_add_le _ _
        _ = ‖r0 x‖ + s * ‖A x‖ := by
          rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (by linarith)]
        _ ≤ ‖r0 x‖ + s * (‖r1 x‖ + ‖r0 x‖) := by
          exact add_le_add_right
            (mul_le_mul_of_nonneg_left (hA x) hs0) _
        _ ≤ s * (2 * ‖r0 x‖ + ‖r1 x‖) := by
          nlinarith [norm_nonneg (r0 x), norm_nonneg (r1 x)]
    have hsq : ‖r0 x + s * A x‖ ^ 2 ≤
        (s * (2 * ‖r0 x‖ + ‖r1 x‖)) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) (mul_nonneg hs0 hnonneg)).mpr hlin
    calc
      ‖r0 x + s * A x‖ ^ 2 ≤
          (s * (2 * ‖r0 x‖ + ‖r1 x‖)) ^ 2 := hsq
      _ ≤ s ^ 2 * (8 * ‖r0 x‖ ^ 2 + 2 * ‖r1 x‖ ^ 2) := by
        nlinarith [sq_nonneg (2 * ‖r0 x‖ - ‖r1 x‖)]
  calc
    (∫ x : Euclidean 2, ‖r x‖ ^ 2) ≤
        ∫ x : Euclidean 2, s ^ 2 * (8 * ‖r0 x‖ ^ 2 + 2 * ‖r1 x‖ ^ 2) :=
      integral_mono_ae hr hHs hpoint
    _ = s ^ 2 * (8 * (∫ x : Euclidean 2, ‖r0 x‖ ^ 2) +
        2 * (∫ x : Euclidean 2, ‖r1 x‖ ^ 2)) := by
      rw [integral_const_mul, integral_add (hr0.const_mul 8) (hr1.const_mul 2),
        integral_const_mul, integral_const_mul]

/-- The BRRS half-wave phase has modulus one in every dimension. -/
private theorem norm_brrs_halfWaveMultiplier_two (s : Real) (x : Euclidean 2) :
    ‖halfWaveMultiplier (d := 2) s x‖ = 1 := by
  change ‖Complex.exp (((2 * Real.pi * s * ‖x‖ : Real) : Complex) * Complex.I)‖ = 1
  exact Complex.norm_exp_ofReal_mul_I _

/-- For an arbitrary literal BRRS annular cutoff in the plane, the
cone-cancelled level-zero frequency symbol has quadratic energy `O(s²)`.
This is the frequency-side input to the fixed-time physical-kernel estimate;
unlike the MSS result, it does not assume that the cutoff comes from a
Littlewood--Paley family. -/
theorem exists_brrs_cancelledLevelZeroHalfWave_energy_bound
    (Φ : BRRSAnnularCutoff) :
    ∃ R : Real, ∀ s : Real, 2 ≤ s →
      (∫ ξ : Euclidean 2,
        ‖Auto.Spherical.MSS.cancelledWaveLaplacian
          (brrsDyadicHalfWaveSchwartzSymbol Φ 0 s) s ξ‖ ^ 2) ≤ R * s ^ 2 := by
  let r0 : Euclidean 2 → Complex :=
    Auto.Spherical.MSS.cancelledWaveLaplacian
      (brrsDyadicHalfWaveSchwartzSymbol Φ 0 0) 0
  let r1 : Euclidean 2 → Complex :=
    Auto.Spherical.MSS.cancelledWaveLaplacian
      (brrsDyadicHalfWaveSchwartzSymbol Φ 0 1) 1
  let R : Real :=
    8 * (∫ x : Euclidean 2, ‖r0 x‖ ^ 2) +
      2 * (∫ x : Euclidean 2, ‖r1 x‖ ^ 2)
  have hRnonneg : 0 ≤ R := by
    dsimp only [R]
    exact add_nonneg
      (mul_nonneg (by norm_num) (integral_nonneg fun x => sq_nonneg (‖r0 x‖)))
      (mul_nonneg (by norm_num) (integral_nonneg fun x => sq_nonneg (‖r1 x‖)))
  refine ⟨R, ?_⟩
  intro s hs
  let r : Euclidean 2 → Complex :=
    Auto.Spherical.MSS.cancelledWaveLaplacian
      (brrsDyadicHalfWaveSchwartzSymbol Φ 0 s) s
  let A : Euclidean 2 → Complex := fun x =>
    halfWaveMultiplier (d := 2) (-1) x * r1 x - r0 x
  have hr : Integrable (fun x => ‖r x‖ ^ 2) := by
    dsimp only [r]
    exact (Auto.Spherical.MSS.cancelledWaveLaplacian
      (brrsDyadicHalfWaveSchwartzSymbol Φ 0 s) s).memLp 2 volume |>.integrable_norm_pow
        (by norm_num)
  have hr0 : Integrable (fun x => ‖r0 x‖ ^ 2) := by
    dsimp only [r0]
    exact (Auto.Spherical.MSS.cancelledWaveLaplacian
      (brrsDyadicHalfWaveSchwartzSymbol Φ 0 0) 0).memLp 2 volume |>.integrable_norm_pow
        (by norm_num)
  have hr1 : Integrable (fun x => ‖r1 x‖ ^ 2) := by
    dsimp only [r1]
    exact (Auto.Spherical.MSS.cancelledWaveLaplacian
      (brrsDyadicHalfWaveSchwartzSymbol Φ 0 1) 1).memLp 2 volume |>.integrable_norm_pow
        (by norm_num)
  have hA : ∀ x, ‖A x‖ ≤ ‖r1 x‖ + ‖r0 x‖ := by
    intro x
    dsimp only [A]
    calc
      ‖halfWaveMultiplier (d := 2) (-1) x * r1 x - r0 x‖ ≤
          ‖halfWaveMultiplier (d := 2) (-1) x * r1 x‖ + ‖r0 x‖ := norm_sub_le _ _
      _ = ‖r1 x‖ + ‖r0 x‖ := by
        rw [norm_mul, norm_brrs_halfWaveMultiplier_two, one_mul]
  have hidentity : ∀ᵐ x : Euclidean 2 ∂volume,
      r x = halfWaveMultiplier (d := 2) s x * (r0 x + s * A x) := by
    have hne : ∀ᵐ x : Euclidean 2 ∂volume, x ≠ 0 := by
      simp [ae_iff, measure_singleton]
    filter_upwards [hne] with x hx
    exact brrs_cancelled_levelZero_phase_affine Φ s x hx
  have hbound := brrs_integral_norm_sq_phase_affine_le r r0 r1 A
    (halfWaveMultiplier (d := 2) s) s (by linarith)
    (norm_brrs_halfWaveMultiplier_two s) hidentity hA hr hr0 hr1
  change (∫ ξ : Euclidean 2,
    ‖Auto.Spherical.MSS.cancelledWaveLaplacian
      (brrsDyadicHalfWaveSchwartzSymbol Φ 0 s) s ξ‖ ^ 2) ≤ R * s ^ 2
  calc
    (∫ ξ : Euclidean 2,
      ‖Auto.Spherical.MSS.cancelledWaveLaplacian
        (brrsDyadicHalfWaveSchwartzSymbol Φ 0 s) s ξ‖ ^ 2) =
        ∫ x : Euclidean 2, ‖r x‖ ^ 2 := by rfl
    _ ≤ s ^ 2 * R := hbound
    _ = R * s ^ 2 := by ring

private theorem integral_norm_sq_brrs_levelZeroHalfWaveSymbol_eq
    (Φ : BRRSAnnularCutoff) (s : Real) :
    (∫ ξ : Euclidean 2,
      ‖brrsDyadicHalfWaveSchwartzSymbol Φ 0 s ξ‖ ^ 2) =
      ∫ ξ : Euclidean 2, ‖brrsDyadicMultiplierSchwartz Φ 0 ξ‖ ^ 2 := by
  apply integral_congr_ae
  filter_upwards with ξ
  rw [brrsDyadicHalfWaveSchwartzSymbol_apply, brrsDyadicHalfWaveSymbol,
    brrsDyadicMultiplierSchwartz_apply, norm_mul,
    norm_brrs_halfWaveMultiplier_two, one_mul]

/-- Every literal planar BRRS cutoff has a fixed level-zero half-wave kernel
whose `L¹` norm grows at most like `sqrt s`.  The cutoff is arbitrary within
`BRRSAnnularCutoff`; no Littlewood--Paley realization is used here. -/
theorem exists_brrs_levelZeroHalfWaveKernelL1_bound
    (Φ : BRRSAnnularCutoff) :
    ∃ B : Real, 0 < B ∧ ∀ s : Real, 2 ≤ s →
      (∫ x : Euclidean 2, ‖brrsDyadicHalfWaveKernel Φ 0 s x‖) ≤
        B * Real.sqrt s := by
  rcases exists_brrs_cancelledLevelZeroHalfWave_energy_bound Φ with ⟨R, hR⟩
  let Q : Real := ∫ ξ : Euclidean 2, ‖brrsDyadicMultiplierSchwartz Φ 0 ξ‖ ^ 2
  let A : Real := |Q| + |R| + 1
  let D : Real := volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi
  let B : Real := 1 + A ^ ((2 : Real)⁻¹) * D ^ ((2 : Real)⁻¹)
  have hA : 0 < A := by
    dsimp only [A]
    positivity
  have hD : 0 ≤ D := by
    dsimp only [D]
    exact mul_nonneg MeasureTheory.measureReal_nonneg Real.pi_pos.le
  have hB : 0 < B := by
    have hterm : 0 ≤ A ^ ((2 : Real)⁻¹) * D ^ ((2 : Real)⁻¹) :=
      mul_nonneg (Real.rpow_nonneg hA.le _) (Real.rpow_nonneg hD _)
    dsimp only [B]
    linarith
  refine ⟨B, hB, ?_⟩
  intro s hs
  have hspos : 0 < s := lt_of_lt_of_le (by norm_num) hs
  have henergy : Integrable (fun x : Euclidean 2 =>
      Auto.Spherical.MSS.coneWeight s x *
        ‖brrsDyadicHalfWaveKernel Φ 0 s x‖ ^ 2) := by
    simpa only [brrsDyadicHalfWaveKernel] using
      Auto.Spherical.MSS.integrable_coneWeightedEnergy_fourierInv
        (brrsDyadicHalfWaveSchwartzSymbol Φ 0 s) s hspos.ne'
  have henergy_bound :
      (∫ x : Euclidean 2, Auto.Spherical.MSS.coneWeight s x *
        ‖brrsDyadicHalfWaveKernel Φ 0 s x‖ ^ 2) ≤ A := by
    calc
      (∫ x : Euclidean 2, Auto.Spherical.MSS.coneWeight s x *
          ‖brrsDyadicHalfWaveKernel Φ 0 s x‖ ^ 2) ≤
          (∫ ξ : Euclidean 2, ‖brrsDyadicHalfWaveSchwartzSymbol Φ 0 s ξ‖ ^ 2) +
            s⁻¹ ^ 2 * ∫ ξ : Euclidean 2,
              ‖Auto.Spherical.MSS.cancelledWaveLaplacian
                (brrsDyadicHalfWaveSchwartzSymbol Φ 0 s) s ξ‖ ^ 2 := by
        simpa only [brrsDyadicHalfWaveKernel] using
          Auto.Spherical.MSS.integral_coneWeightedEnergy_fourierInv_le
            (brrsDyadicHalfWaveSchwartzSymbol Φ 0 s) s hspos
      _ = Q + s⁻¹ ^ 2 * ∫ ξ : Euclidean 2,
          ‖Auto.Spherical.MSS.cancelledWaveLaplacian
            (brrsDyadicHalfWaveSchwartzSymbol Φ 0 s) s ξ‖ ^ 2 := by
        rw [integral_norm_sq_brrs_levelZeroHalfWaveSymbol_eq]
      _ ≤ Q + s⁻¹ ^ 2 * (R * s ^ 2) := by
        gcongr
        exact hR s hs
      _ = Q + R := by field_simp [hspos.ne']
      _ ≤ A := by
        dsimp only [A]
        linarith [le_abs_self Q, le_abs_self R]
  have hl1 := Auto.Spherical.MSS.integral_norm_le_coneWeightedEnergy
    (brrsDyadicHalfWaveKernel Φ 0 s : Euclidean 2 → Complex) s hspos henergy
  have henergy_nonneg : 0 ≤ ∫ x : Euclidean 2,
      Auto.Spherical.MSS.coneWeight s x *
        ‖brrsDyadicHalfWaveKernel Φ 0 s x‖ ^ 2 :=
    integral_nonneg fun x =>
      mul_nonneg (Auto.Spherical.MSS.coneWeight_pos s x).le (sq_nonneg _)
  have hfactor_nonneg : 0 ≤ (D * s) ^ ((2 : Real)⁻¹) :=
    Real.rpow_nonneg (mul_nonneg hD hspos.le) _
  calc
    (∫ x : Euclidean 2, ‖brrsDyadicHalfWaveKernel Φ 0 s x‖) ≤
        A ^ ((2 : Real)⁻¹) * (D * s) ^ ((2 : Real)⁻¹) := by
      calc
        (∫ x : Euclidean 2, ‖brrsDyadicHalfWaveKernel Φ 0 s x‖) ≤
            (∫ x : Euclidean 2, Auto.Spherical.MSS.coneWeight s x *
              ‖brrsDyadicHalfWaveKernel Φ 0 s x‖ ^ 2) ^ ((2 : Real)⁻¹) *
                ((volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s) ^
                  ((2 : Real)⁻¹) := hl1
        _ ≤ A ^ ((2 : Real)⁻¹) *
            ((volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s) ^
              ((2 : Real)⁻¹) :=
          mul_le_mul_of_nonneg_right
            (Real.rpow_le_rpow henergy_nonneg henergy_bound (by positivity))
            (Real.rpow_nonneg
              (mul_nonneg
                (mul_nonneg MeasureTheory.measureReal_nonneg Real.pi_pos.le) hspos.le) _)
        _ = A ^ ((2 : Real)⁻¹) * (D * s) ^ ((2 : Real)⁻¹) := by rfl
    _ = (A ^ ((2 : Real)⁻¹) * D ^ ((2 : Real)⁻¹)) * Real.sqrt s := by
      rw [Real.mul_rpow hD hspos.le]
      have hssqrt : s ^ ((2 : Real)⁻¹) = Real.sqrt s := by
        rw [show (2 : Real)⁻¹ = 1 / 2 by norm_num, ← Real.sqrt_eq_rpow]
      rw [hssqrt]
      ring
    _ ≤ B * Real.sqrt s := by
      apply mul_le_mul_of_nonneg_right
      · dsimp only [B]
        linarith
      · exact Real.sqrt_nonneg _

/-- The preceding arbitrary-cutoff kernel bound gives the corresponding
fixed-time physical `L∞` estimate for the canonical BRRS convolution
realization at level zero. -/
theorem exists_brrs_levelZeroHalfWave_fixedTimeLInfinity_bound
    (Φ : BRRSAnnularCutoff) :
    ∃ B : Real, 0 < B ∧ ∀ s : Real, 2 ≤ s →
      ∀ f : Euclidean 2 → Complex, Continuous f → ∀ C : Real,
        (∀ y, ‖f y‖ ≤ C) → ∀ x : Euclidean 2,
          ‖(brrsLpHalfWaveExtension Φ).apply 0 s f x‖ ≤
            (B * Real.sqrt s) * C := by
  rcases exists_brrs_levelZeroHalfWaveKernelL1_bound Φ with ⟨B, hB, hkernel⟩
  refine ⟨B, hB, ?_⟩
  intro s hs f hf C hbound x
  have hC : 0 ≤ C := le_trans (norm_nonneg (f 0)) (hbound 0)
  calc
    ‖(brrsLpHalfWaveExtension Φ).apply 0 s f x‖ ≤
        (∫ y : Euclidean 2, ‖brrsDyadicHalfWaveKernel Φ 0 s y‖) * C :=
      norm_brrsLpHalfWaveExtension_apply_le_kernelMass_mul_bound Φ 0 s f hf hbound x
    _ ≤ (B * Real.sqrt s) * C :=
      mul_le_mul_of_nonneg_right (hkernel s hs) hC

private theorem brrs_halfWaveMultiplier_eq_levelZero_scaled
    (j : Nat) (t : Real) (ξ : Euclidean 2) :
    halfWaveMultiplier (d := 2) t ξ =
      halfWaveMultiplier (d := 2) ((2 : Real) ^ j * t)
        (((2 : Real) ^ j)⁻¹ • ξ) := by
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hnorm : ‖q⁻¹ • ξ‖ = q⁻¹ * ‖ξ‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hq)]
  unfold halfWaveMultiplier
  rw [hnorm]
  congr 2
  push_cast
  field_simp [hq.ne']
  dsimp only [q]
  push_cast
  ring

private theorem brrsDyadicMultiplier_eq_levelZero_scaled
    (Φ : BRRSAnnularCutoff) (j : Nat) (ξ : Euclidean 2) :
    brrsDyadicMultiplier Φ j ξ =
      brrsDyadicMultiplier Φ 0 (((2 : Real) ^ j)⁻¹ • ξ) := by
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hnorm : ‖q⁻¹ • ξ‖ = q⁻¹ * ‖ξ‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hq)]
  unfold brrsDyadicMultiplier
  rw [hnorm]
  simp only [pow_zero, inv_one, mul_one]
  change Φ.symbol (2 * Real.pi * ((2 : Real) ^ j)⁻¹ * ‖ξ‖) =
    Φ.symbol (2 * Real.pi * (q⁻¹ * ‖ξ‖))
  congr 1
  dsimp only [q]
  ring

private theorem brrsDyadicHalfWaveSymbol_eq_levelZero_scaled
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) (ξ : Euclidean 2) :
    brrsDyadicHalfWaveSymbol Φ j t ξ =
      brrsDyadicHalfWaveSymbol Φ 0 ((2 : Real) ^ j * t)
        (((2 : Real) ^ j)⁻¹ • ξ) := by
  unfold brrsDyadicHalfWaveSymbol
  rw [brrs_halfWaveMultiplier_eq_levelZero_scaled,
    brrsDyadicMultiplier_eq_levelZero_scaled]

/-- Exact dyadic spatial scaling for the literal arbitrary-cutoff planar
BRRS half-wave kernel. -/
theorem brrsDyadicHalfWaveKernel_eq_levelZero_scaled
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) (x : Euclidean 2) :
    brrsDyadicHalfWaveKernel Φ j t x =
      ((2 : Real) ^ j) ^ 2 •
        brrsDyadicHalfWaveKernel Φ 0 ((2 : Real) ^ j * t)
          ((2 : Real) ^ j • x) := by
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  unfold brrsDyadicHalfWaveKernel
  rw [SchwartzMap.fourierInv_coe, SchwartzMap.fourierInv_coe]
  rw [show (brrsDyadicHalfWaveSchwartzSymbol Φ j t : Euclidean 2 → Complex) =
      fun ξ => brrsDyadicHalfWaveSymbol Φ 0 (q * t) (q⁻¹ • ξ) by
        funext ξ
        rw [brrsDyadicHalfWaveSchwartzSymbol_apply]
        simpa only [q] using brrsDyadicHalfWaveSymbol_eq_levelZero_scaled Φ j t ξ]
  rw [show (brrsDyadicHalfWaveSchwartzSymbol Φ 0 (q * t) :
      Euclidean 2 → Complex) = brrsDyadicHalfWaveSymbol Φ 0 (q * t) by
        funext ξ
        exact brrsDyadicHalfWaveSchwartzSymbol_apply Φ 0 (q * t) ξ]
  simpa only [q, finrank_euclideanSpace_fin] using
    (Auto.Spherical.Auxiliary.fourierInv_comp_inv_smul
      (g := brrsDyadicHalfWaveSymbol Φ 0 (q * t)) hq x)

/-- The `L¹` mass of a literal BRRS half-wave kernel is invariant under the
dyadic frequency dilation after rescaling time. -/
theorem integral_norm_brrsDyadicHalfWaveKernel_eq_levelZero_scaled
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) :
    (∫ x : Euclidean 2, ‖brrsDyadicHalfWaveKernel Φ j t x‖) =
      ∫ x : Euclidean 2,
        ‖brrsDyadicHalfWaveKernel Φ 0 ((2 : Real) ^ j * t) x‖ := by
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  rw [show (fun x : Euclidean 2 => ‖brrsDyadicHalfWaveKernel Φ j t x‖) =
      fun x => ‖q ^ 2 • brrsDyadicHalfWaveKernel Φ 0 (q * t) (q • x)‖ by
        funext x
        rw [brrsDyadicHalfWaveKernel_eq_levelZero_scaled]]
  exact integral_norm_dilate_eq 2
    (brrsDyadicHalfWaveKernel Φ 0 (q * t) : Euclidean 2 → Complex) hq

/-- The arbitrary-cutoff planar BRRS half-wave kernels satisfy the sharp
fixed-time `2^(j/2)` `L¹` growth on the paper's unit time interval. -/
theorem exists_brrs_planarDyadicHalfWaveKernelL1_bound
    (Φ : BRRSAnnularCutoff) :
    ∃ B : Real, 0 < B ∧ ∀ j : Nat, 1 ≤ j → ∀ t : Real,
      t ∈ Icc (1 : Real) 2 →
        (∫ x : Euclidean 2, ‖brrsDyadicHalfWaveKernel Φ j t x‖) ≤
          B * Real.sqrt ((2 : Real) ^ j) := by
  rcases exists_brrs_levelZeroHalfWaveKernelL1_bound Φ with ⟨B₀, hB₀, hlevel⟩
  let B : Real := 1 + B₀ * Real.sqrt 2
  have hB : 0 < B := by
    have hterm : 0 ≤ B₀ * Real.sqrt 2 :=
      mul_nonneg hB₀.le (Real.sqrt_nonneg _)
    dsimp only [B]
    linarith
  refine ⟨B, hB, ?_⟩
  intro j hj t ht
  let q : Real := (2 : Real) ^ j
  have hqpos : 0 < q := by
    dsimp only [q]
    positivity
  have hqnonneg : 0 ≤ q := hqpos.le
  have hqge : 2 ≤ q := by
    dsimp only [q]
    calc
      (2 : Real) = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ j := by exact pow_le_pow_right₀ (by norm_num) hj
  have hsge : 2 ≤ q * t := by
    calc
      (2 : Real) ≤ q := hqge
      _ = q * 1 := (mul_one q).symm
      _ ≤ q * t := mul_le_mul_of_nonneg_left ht.1 hqnonneg
  calc
    (∫ x : Euclidean 2, ‖brrsDyadicHalfWaveKernel Φ j t x‖) =
        ∫ x : Euclidean 2, ‖brrsDyadicHalfWaveKernel Φ 0 (q * t) x‖ := by
      simpa only [q] using
        integral_norm_brrsDyadicHalfWaveKernel_eq_levelZero_scaled Φ j t
    _ ≤ B₀ * Real.sqrt (q * t) := hlevel (q * t) hsge
    _ ≤ B₀ * Real.sqrt (q * 2) := by
      apply mul_le_mul_of_nonneg_left
      · apply Real.sqrt_le_sqrt
        exact mul_le_mul_of_nonneg_left ht.2 hqnonneg
      · exact hB₀.le
    _ = (B₀ * Real.sqrt 2) * Real.sqrt q := by
      rw [show q * 2 = 2 * q by ring, Real.sqrt_mul (by norm_num : (0 : Real) ≤ 2)]
      ring
    _ ≤ B * Real.sqrt ((2 : Real) ^ j) := by
      change (B₀ * Real.sqrt 2) * Real.sqrt q ≤ B * Real.sqrt q
      apply mul_le_mul_of_nonneg_right
      · dsimp only [B]
        linarith
      · exact Real.sqrt_nonneg _

/-- The sharp planar fixed-time physical `L∞` endpoint for the literal
arbitrary BRRS annular cutoff.  This is a kernel consequence only; it does
not use the still-separate radial local-smoothing block estimate. -/
theorem exists_brrs_planarDyadicHalfWave_fixedTimeLInfinity_bound
    (Φ : BRRSAnnularCutoff) :
    ∃ B : Real, 0 < B ∧ ∀ j : Nat, 1 ≤ j → ∀ t : Real,
      t ∈ Icc (1 : Real) 2 → ∀ f : Euclidean 2 → Complex, Continuous f →
        ∀ C : Real, (∀ y, ‖f y‖ ≤ C) → ∀ x : Euclidean 2,
          ‖(brrsLpHalfWaveExtension Φ).apply j t f x‖ ≤
            (B * Real.sqrt ((2 : Real) ^ j)) * C := by
  rcases exists_brrs_planarDyadicHalfWaveKernelL1_bound Φ with ⟨B, hB, hkernel⟩
  refine ⟨B, hB, ?_⟩
  intro j hj t ht f hf C hbound x
  have hC : 0 ≤ C := le_trans (norm_nonneg (f 0)) (hbound 0)
  calc
    ‖(brrsLpHalfWaveExtension Φ).apply j t f x‖ ≤
        (∫ y : Euclidean 2, ‖brrsDyadicHalfWaveKernel Φ j t y‖) * C :=
      norm_brrsLpHalfWaveExtension_apply_le_kernelMass_mul_bound Φ j t f hf hbound x
    _ ≤ (B * Real.sqrt ((2 : Real) ^ j)) * C :=
      mul_le_mul_of_nonneg_right (hkernel j hj t ht) hC

/-! ### Dimension-generic kernel scaling

The planar cone-energy argument above proves the required level-zero
estimate only in dimension two.  The following identities isolate the
dimension-independent dilation step: once a level-zero kernel estimate has
been supplied by stationary phase, it transports to every dyadic level with
no loss.  Keeping this bridge separate prevents the Euclidean Jacobian from
being hidden in a dimension-specific calculation. -/

private theorem brrs_halfWaveMultiplier_eq_levelZero_scaled_general
    {d : Nat} (j : Nat) (t : Real) (xi : Euclidean d) :
    halfWaveMultiplier (d := d) t xi =
      halfWaveMultiplier (d := d) ((2 : Real) ^ j * t)
        (((2 : Real) ^ j)⁻¹ • xi) := by
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hnorm : ‖q⁻¹ • xi‖ = q⁻¹ * ‖xi‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hq)]
  unfold halfWaveMultiplier
  rw [hnorm]
  congr 2
  push_cast
  field_simp [hq.ne']
  dsimp only [q]
  push_cast
  ring

private theorem brrsDyadicMultiplier_eq_levelZero_scaled_general
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat) (xi : Euclidean d) :
    brrsDyadicMultiplier Phi j xi =
      brrsDyadicMultiplier Phi 0 (((2 : Real) ^ j)⁻¹ • xi) := by
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hnorm : ‖q⁻¹ • xi‖ = q⁻¹ * ‖xi‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hq)]
  unfold brrsDyadicMultiplier
  rw [hnorm]
  simp only [pow_zero, inv_one, mul_one]
  change Phi.symbol (2 * Real.pi * ((2 : Real) ^ j)⁻¹ * ‖xi‖) =
    Phi.symbol (2 * Real.pi * (q⁻¹ * ‖xi‖))
  congr 1
  dsimp only [q]
  ring

private theorem brrsDyadicHalfWaveSymbol_eq_levelZero_scaled_general
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (xi : Euclidean d) :
    brrsDyadicHalfWaveSymbol Phi j t xi =
      brrsDyadicHalfWaveSymbol Phi 0 ((2 : Real) ^ j * t)
        (((2 : Real) ^ j)⁻¹ • xi) := by
  unfold brrsDyadicHalfWaveSymbol
  rw [brrs_halfWaveMultiplier_eq_levelZero_scaled_general,
    brrsDyadicMultiplier_eq_levelZero_scaled_general]

/-- Exact dyadic physical-space scaling of the literal phase-shifted annular
test packet used in the radial sharpness argument.  In particular, all of
the nontrivial input-norm analysis is reduced to the level-zero packet at
the rescaled reference time. -/
theorem brrsPositiveRadialHalfWaveTestPacket_eq_levelZero_scaled
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat) (referenceTime : Real)
    (x : BRRSSpace d) :
    brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime x =
      ((2 : Real) ^ j) ^ d •
        brrsPositiveRadialHalfWaveTestPacket Phi 0
          ((2 : Real) ^ j * referenceTime) ((2 : Real) ^ j • x) := by
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  unfold brrsPositiveRadialHalfWaveTestPacket
  rw [SchwartzMap.fourierInv_coe, SchwartzMap.fourierInv_coe]
  rw [show (brrsDyadicHalfWaveSchwartzAdjointSymbol Phi j referenceTime :
      Euclidean d → Complex) =
      fun xi => (brrsDyadicHalfWaveSchwartzAdjointSymbol Phi 0
        (q * referenceTime) : Euclidean d → Complex) (q⁻¹ • xi) by
        funext xi
        rw [brrsDyadicHalfWaveSchwartzAdjointSymbol_apply,
          brrsDyadicHalfWaveSchwartzAdjointSymbol_apply]
        have hsymbol := brrsDyadicHalfWaveSymbol_eq_levelZero_scaled_general
          (d := d) Phi j referenceTime xi
        exact congrArg (starRingEnd Complex) (by simpa only [q] using hsymbol)]
  change FourierTransform.fourierInv (fun xi : Euclidean d =>
      (brrsDyadicHalfWaveSchwartzAdjointSymbol Phi 0
        (q * referenceTime) : Euclidean d → Complex) (q⁻¹ • xi)) x =
    q ^ d • FourierTransform.fourierInv
      (brrsDyadicHalfWaveSchwartzAdjointSymbol Phi 0
        (q * referenceTime) : Euclidean d → Complex) (q • x)
  simpa only [finrank_euclideanSpace_fin] using
    (Auto.Spherical.Auxiliary.fourierInv_comp_inv_smul
      (g := (brrsDyadicHalfWaveSchwartzAdjointSymbol Phi 0
        (q * referenceTime) : Euclidean d → Complex)) hq x)

/-- Exact `L²` normalization of the phase-shifted annular packet.  This is
the Plancherel component of the input estimate in BRRS (3.2), expressed at
the rescaled level-zero reference time. -/
theorem integral_norm_sq_brrsPositiveRadialHalfWaveTestPacket_eq_levelZero_scaled
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat) (referenceTime : Real) :
    (∫ x : BRRSSpace d,
      ‖brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime x‖ ^ 2) =
      ((2 : Real) ^ j) ^ d *
        ∫ x : BRRSSpace d,
          ‖brrsPositiveRadialHalfWaveTestPacket Phi 0
            ((2 : Real) ^ j * referenceTime) x‖ ^ 2 := by
  rw [integral_norm_sq_brrsPositiveRadialHalfWaveTestPacket,
    integral_norm_pow_brrsDyadicMultiplier_eq_levelZero_scaled_for_pTwo]
  rw [← integral_norm_sq_brrsPositiveRadialHalfWaveTestPacket Phi 0
    ((2 : Real) ^ j * referenceTime)]

/-- Exact spatial scaling of the BRRS annular half-wave kernel in every
Euclidean dimension. -/
theorem brrsDyadicHalfWaveKernel_eq_levelZero_scaled_general
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (x : Euclidean d) :
    brrsDyadicHalfWaveKernel Phi j t x =
      ((2 : Real) ^ j) ^ d •
        brrsDyadicHalfWaveKernel Phi 0 ((2 : Real) ^ j * t)
          ((2 : Real) ^ j • x) := by
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  unfold brrsDyadicHalfWaveKernel
  rw [SchwartzMap.fourierInv_coe, SchwartzMap.fourierInv_coe]
  rw [show (brrsDyadicHalfWaveSchwartzSymbol Phi j t : Euclidean d → Complex) =
      fun xi => brrsDyadicHalfWaveSymbol Phi 0 (q * t) (q⁻¹ • xi) by
        funext xi
        rw [brrsDyadicHalfWaveSchwartzSymbol_apply]
        simpa only [q] using
          brrsDyadicHalfWaveSymbol_eq_levelZero_scaled_general Phi j t xi]
  rw [show (brrsDyadicHalfWaveSchwartzSymbol Phi 0 (q * t) :
      Euclidean d → Complex) = brrsDyadicHalfWaveSymbol Phi 0 (q * t) by
        funext xi
        exact brrsDyadicHalfWaveSchwartzSymbol_apply Phi 0 (q * t) xi]
  simpa only [q, finrank_euclideanSpace_fin] using
    (Auto.Spherical.Auxiliary.fourierInv_comp_inv_smul
      (g := brrsDyadicHalfWaveSymbol Phi 0 (q * t)) hq x)

/-- The `L¹` mass of a BRRS annular half-wave kernel is invariant under the
dyadic frequency dilation after rescaling time, in every dimension. -/
theorem integral_norm_brrsDyadicHalfWaveKernel_eq_levelZero_scaled_general
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real) :
    (∫ x : Euclidean d, ‖brrsDyadicHalfWaveKernel Phi j t x‖) =
      ∫ x : Euclidean d,
        ‖brrsDyadicHalfWaveKernel Phi 0 ((2 : Real) ^ j * t) x‖ := by
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  rw [show (fun x : Euclidean d => ‖brrsDyadicHalfWaveKernel Phi j t x‖) =
      fun x => ‖q ^ d • brrsDyadicHalfWaveKernel Phi 0 (q * t) (q • x)‖ by
        funext x
        rw [brrsDyadicHalfWaveKernel_eq_levelZero_scaled_general]]
  exact Auto.Spherical.SurfaceMeasureDecay.integral_norm_dilate_eq d
    (brrsDyadicHalfWaveKernel Phi 0 (q * t) : Euclidean d → Complex) hq

/-- A level-zero stationary-phase `L¹` estimate transports at the sharp wave
rate to every positive dyadic frequency level.  This is a purely exact
scaling reduction; it does not assume a particular construction of the
level-zero estimate. -/
theorem exists_brrs_dyadicHalfWaveKernelL1_bound_of_levelZero
    {d : Nat} (hd : 2 ≤ d) (Phi : BRRSAnnularCutoff)
    (hlevel : ∃ B0 : Real, 0 < B0 ∧ ∀ s : Real, 2 ≤ s →
      (∫ x : Euclidean d, ‖brrsDyadicHalfWaveKernel Phi 0 s x‖) ≤
        B0 * s ^ (((d : Real) - 1) / 2)) :
    ∃ B : Real, 0 < B ∧ ∀ j : Nat, 1 ≤ j → ∀ t : Real,
      t ∈ Icc (1 : Real) 2 →
        (∫ x : Euclidean d, ‖brrsDyadicHalfWaveKernel Phi j t x‖) ≤
          B * ((2 : Real) ^ j) ^ (((d : Real) - 1) / 2) := by
  rcases hlevel with ⟨B0, hB0, hlevel⟩
  let alpha : Real := ((d : Real) - 1) / 2
  have halpha : 0 ≤ alpha := by
    dsimp only [alpha]
    have hd' : (2 : Real) ≤ d := by exact_mod_cast hd
    linarith
  let B : Real := 1 + B0 * (2 : Real) ^ alpha
  have hpowtwo : 0 ≤ (2 : Real) ^ alpha :=
    Real.rpow_nonneg (by norm_num) _
  have hB : 0 < B := by
    have hterm : 0 ≤ B0 * (2 : Real) ^ alpha :=
      mul_nonneg hB0.le hpowtwo
    dsimp only [B]
    linarith
  refine ⟨B, hB, ?_⟩
  intro j hj t ht
  let q : Real := (2 : Real) ^ j
  have hqpos : 0 < q := by
    dsimp only [q]
    positivity
  have hqnonneg : 0 ≤ q := hqpos.le
  have hqge : 2 ≤ q := by
    dsimp only [q]
    calc
      (2 : Real) = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ j := by exact pow_le_pow_right₀ (by norm_num) hj
  have hsge : 2 ≤ q * t := by
    calc
      (2 : Real) ≤ q := hqge
      _ = q * 1 := (mul_one q).symm
      _ ≤ q * t := mul_le_mul_of_nonneg_left ht.1 hqnonneg
  have hqtle : q * t ≤ q * 2 :=
    mul_le_mul_of_nonneg_left ht.2 hqnonneg
  have ht_nonneg : 0 ≤ t := le_trans zero_le_one ht.1
  have hqtnonneg : 0 ≤ q * t := mul_nonneg hqnonneg ht_nonneg
  have hpow : (q * t) ^ alpha ≤ (q * 2) ^ alpha :=
    Real.rpow_le_rpow hqtnonneg hqtle halpha
  calc
    (∫ x : Euclidean d, ‖brrsDyadicHalfWaveKernel Phi j t x‖) =
        ∫ x : Euclidean d, ‖brrsDyadicHalfWaveKernel Phi 0 (q * t) x‖ := by
      simpa only [q] using
        integral_norm_brrsDyadicHalfWaveKernel_eq_levelZero_scaled_general
          Phi j t
    _ ≤ B0 * (q * t) ^ alpha := by
      simpa only [alpha] using hlevel (q * t) hsge
    _ ≤ B0 * (q * 2) ^ alpha :=
      mul_le_mul_of_nonneg_left hpow hB0.le
    _ = (B0 * (2 : Real) ^ alpha) * q ^ alpha := by
      rw [show q * 2 = 2 * q by ring,
        Real.mul_rpow (by norm_num : (0 : Real) ≤ 2) hqnonneg]
      ring
    _ ≤ B * ((2 : Real) ^ j) ^ alpha := by
      change (B0 * (2 : Real) ^ alpha) * q ^ alpha ≤ B * q ^ alpha
      apply mul_le_mul_of_nonneg_right
      · dsimp only [B]
        linarith
      · exact Real.rpow_nonneg hqnonneg _

/-! ### Polar radial `L¹` majorants

The stationary-phase analysis supplies pointwise bounds depending only on
the spatial radius.  This small bridge converts any such bound into the exact
one-dimensional weighted mass which remains to be estimated.  It deliberately
uses `lintegral`: this avoids assuming integrability of a proposed majorant
before that scalar estimate has been proved. -/

/-- A pointwise radial `ENNReal` majorant controls the spatial mass through
the polar-coordinate radial integral. -/
theorem lintegral_enorm_le_radial_polar_majorant
    {d : Nat} (hd : 0 < d) (K : Euclidean d → Complex)
    (F : Real → ENNReal) (hF : Measurable F)
    (hmajorant : ∀ x : Euclidean d, ‖K x‖ₑ ≤ F ‖x‖) :
    (∫⁻ x : Euclidean d, ‖K x‖ₑ) ≤
      ENNReal.ofReal (surfaceMass d) *
        ∫⁻ r in Ioi (0 : Real), ENNReal.ofReal r ^ (d - 1) * F r := by
  calc
    (∫⁻ x : Euclidean d, ‖K x‖ₑ) ≤ ∫⁻ x : Euclidean d, F ‖x‖ := by
      apply lintegral_mono
      intro x
      exact hmajorant x
    _ = ENNReal.ofReal (surfaceMass d) *
        ∫⁻ r in Ioi (0 : Real), ENNReal.ofReal r ^ (d - 1) * F r :=
      Auto.Spherical.SurfaceMeasureDecay.lintegral_euclidean_radial hd F hF

/-- The elementary Fourier-integral bound gives a time-uniform pointwise
bound for the level-zero kernel.  This controls the fixed compact spatial
region when the stationary estimate is only used at large radius. -/
theorem norm_brrsDyadicHalfWaveKernel_levelZero_le_multiplierMass
    {d : Nat} (Phi : BRRSAnnularCutoff) (t : Real) (x : Euclidean d) :
    ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x‖ ≤
      ∫ xi : Euclidean d, ‖brrsDyadicMultiplierSchwartz Phi 0 xi‖ := by
  unfold brrsDyadicHalfWaveKernel
  rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq]
  calc
    ‖∫ xi : Euclidean d,
        Real.fourierChar (inner Real xi x) •
          (brrsDyadicHalfWaveSchwartzSymbol Phi 0 t : Euclidean d → Complex) xi‖ ≤
        ∫ xi : Euclidean d,
          ‖Real.fourierChar (inner Real xi x) •
            (brrsDyadicHalfWaveSchwartzSymbol Phi 0 t : Euclidean d → Complex) xi‖ :=
      norm_integral_le_integral_norm _
    _ = ∫ xi : Euclidean d,
        ‖(brrsDyadicHalfWaveSchwartzSymbol Phi 0 t : Euclidean d → Complex) xi‖ := by
      apply integral_congr_ae
      filter_upwards with xi
      simp
    _ = ∫ xi : Euclidean d, ‖brrsDyadicMultiplierSchwartz Phi 0 xi‖ := by
      apply integral_congr_ae
      filter_upwards with xi
      rw [brrsDyadicHalfWaveSchwartzSymbol_apply,
        brrsDyadicHalfWaveSymbol, brrsDyadicMultiplierSchwartz_apply,
        norm_mul, halfWaveMultiplier, Complex.norm_exp_ofReal_mul_I, one_mul]

/-- Specialized polar-mass bridge for a BRRS half-wave kernel.  A later
stationary phase estimate need only provide `F`; this theorem leaves no
multi-dimensional integration in the remaining task. -/
theorem lintegral_enorm_brrsDyadicHalfWaveKernel_le_radial_polar_majorant
    {d : Nat} (hd : 0 < d) (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (F : Real → ENNReal) (hF : Measurable F)
    (hmajorant : ∀ x : Euclidean d,
      ‖(brrsDyadicHalfWaveKernel Phi j t : Euclidean d → Complex) x‖ₑ ≤ F ‖x‖) :
    (∫⁻ x : Euclidean d,
      ‖(brrsDyadicHalfWaveKernel Phi j t : Euclidean d → Complex) x‖ₑ) ≤
      ENNReal.ofReal (surfaceMass d) *
        ∫⁻ r in Ioi (0 : Real), ENNReal.ofReal r ^ (d - 1) * F r := by
  exact lintegral_enorm_le_radial_polar_majorant hd
    (brrsDyadicHalfWaveKernel Phi j t : Euclidean d → Complex) F hF hmajorant

/-- When the scalar polar majorant has finite mass, the preceding `lintegral`
bound converts to the ordinary real-valued `L¹` bound. -/
theorem integral_norm_brrsDyadicHalfWaveKernel_le_toReal_radial_polar_majorant
    {d : Nat} (hd : 0 < d) (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (F : Real → ENNReal) (hF : Measurable F)
    (hmajorant : ∀ x : Euclidean d,
      ‖(brrsDyadicHalfWaveKernel Phi j t : Euclidean d → Complex) x‖ₑ ≤ F ‖x‖)
    (hfinite : ENNReal.ofReal (surfaceMass d) *
      ∫⁻ r in Ioi (0 : Real), ENNReal.ofReal r ^ (d - 1) * F r ≠ ∞) :
    (∫ x : Euclidean d,
      ‖(brrsDyadicHalfWaveKernel Phi j t : Euclidean d → Complex) x‖) ≤
      (ENNReal.ofReal (surfaceMass d) *
        ∫⁻ r in Ioi (0 : Real), ENNReal.ofReal r ^ (d - 1) * F r).toReal := by
  rw [← ENNReal.ofReal_le_iff_le_toReal hfinite,
    ofReal_integral_norm_eq_lintegral_enorm
      (brrsDyadicHalfWaveKernel Phi j t).integrable]
  exact lintegral_enorm_brrsDyadicHalfWaveKernel_le_radial_polar_majorant
    hd Phi j t F hF hmajorant

/-- A finite scalar polar-moment estimate is sufficient for the desired
level-zero half-wave `L¹` estimate.  This isolates the only remaining
one-dimensional integration task after a stationary radial majorant has been
established. -/
theorem exists_brrs_levelZeroHalfWaveKernelL1_bound_of_radial_polar_majorant
    {d : Nat} (hd : 0 < d) (Phi : BRRSAnnularCutoff)
    (F : Real → Real → ENNReal) (hF : ∀ s : Real, Measurable (F s))
    (hmajorant : ∀ s : Real, 2 ≤ s → ∀ x : Euclidean d,
      ‖(brrsDyadicHalfWaveKernel Phi 0 s : Euclidean d → Complex) x‖ₑ ≤ F s ‖x‖)
    (B : Real) (hB : 0 < B)
    (hmoment : ∀ s : Real, 2 ≤ s →
      (ENNReal.ofReal (surfaceMass d) *
        ∫⁻ r in Ioi (0 : Real), ENNReal.ofReal r ^ (d - 1) * F s r) ≠ ∞ ∧
      (ENNReal.ofReal (surfaceMass d) *
        ∫⁻ r in Ioi (0 : Real), ENNReal.ofReal r ^ (d - 1) * F s r).toReal ≤
          B * s ^ (((d : Real) - 1) / 2)) :
    ∃ B0 : Real, 0 < B0 ∧ ∀ s : Real, 2 ≤ s →
      (∫ x : Euclidean d, ‖brrsDyadicHalfWaveKernel Phi 0 s x‖) ≤
        B0 * s ^ (((d : Real) - 1) / 2) := by
  refine ⟨B, hB, ?_⟩
  intro s hs
  rcases hmoment s hs with ⟨hfinite, hscalar⟩
  exact (integral_norm_brrsDyadicHalfWaveKernel_le_toReal_radial_polar_majorant
    hd Phi 0 s (F s) (hF s) (hmajorant s hs) hfinite).trans hscalar

/-- Combining a stationary radial majorant and its scalar moment bound with
exact dyadic scaling gives the all-level wave-rate `L¹` kernel estimate. -/
theorem exists_brrs_dyadicHalfWaveKernelL1_bound_of_radial_polar_majorant
    {d : Nat} (hd : 2 ≤ d) (Phi : BRRSAnnularCutoff)
    (F : Real → Real → ENNReal) (hF : ∀ s : Real, Measurable (F s))
    (hmajorant : ∀ s : Real, 2 ≤ s → ∀ x : Euclidean d,
      ‖(brrsDyadicHalfWaveKernel Phi 0 s : Euclidean d → Complex) x‖ₑ ≤ F s ‖x‖)
    (B : Real) (hB : 0 < B)
    (hmoment : ∀ s : Real, 2 ≤ s →
      (ENNReal.ofReal (surfaceMass d) *
        ∫⁻ r in Ioi (0 : Real), ENNReal.ofReal r ^ (d - 1) * F s r) ≠ ∞ ∧
      (ENNReal.ofReal (surfaceMass d) *
        ∫⁻ r in Ioi (0 : Real), ENNReal.ofReal r ^ (d - 1) * F s r).toReal ≤
          B * s ^ (((d : Real) - 1) / 2)) :
    ∃ B0 : Real, 0 < B0 ∧ ∀ j : Nat, 1 ≤ j → ∀ t : Real,
      t ∈ Icc (1 : Real) 2 →
        (∫ x : Euclidean d, ‖brrsDyadicHalfWaveKernel Phi j t x‖) ≤
          B0 * ((2 : Real) ^ j) ^ (((d : Real) - 1) / 2) := by
  apply exists_brrs_dyadicHalfWaveKernelL1_bound_of_levelZero hd Phi
  exact exists_brrs_levelZeroHalfWaveKernelL1_bound_of_radial_polar_majorant
    (lt_of_lt_of_le (by norm_num) hd) Phi F hF hmajorant B hB hmoment

/-! ### Radial kernel and stationary-wave bridges

The half-wave symbol itself is radial, so the polar Fourier identity applies
directly to its physical kernel.  These formulae expose the exact scalar
oscillatory integral to which the remaining arbitrary-dimensional stationary
phase estimate must be applied. -/

/-- The scalar radial frequency profile of the BRRS annular half-wave
kernel.  It is independent of the ambient dimension. -/
def brrsDyadicHalfWaveKernelRadialProfile
    (Phi : BRRSAnnularCutoff) (j : Nat) (t rho : Real) : Complex :=
  Complex.exp (((2 * Real.pi * t * rho : Real) : Complex) * Complex.I) *
    Phi.symbol (2 * Real.pi * ((2 : Real) ^ j)⁻¹ * rho)

/-- The Schwartz half-wave symbol agrees exactly with its scalar radial
profile. -/
theorem brrsDyadicHalfWaveSchwartzSymbol_eq_kernelRadialProfile
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (xi : Euclidean d) :
    brrsDyadicHalfWaveSchwartzSymbol Phi j t xi =
      brrsDyadicHalfWaveKernelRadialProfile Phi j t ‖xi‖ := by
  rfl

/-- Exact polar representation of the physical BRRS half-wave kernel in
every positive dimension. -/
theorem brrsDyadicHalfWaveKernel_eq_surfaceFourier_integral
    {d : Nat} (hd : 0 < d) (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (x : Euclidean d) :
    (brrsDyadicHalfWaveKernel Phi j t : Euclidean d → Complex) x =
      ∫ rho : Ioi (0 : Real),
        surfaceFourier d (-rho.1 • x) *
          brrsDyadicHalfWaveKernelRadialProfile Phi j t rho.1
            ∂Measure.volumeIoiPow (d - 1) := by
  have hrad : ∀ xi : Euclidean d,
      brrsDyadicHalfWaveSchwartzSymbol Phi j t xi =
        brrsDyadicHalfWaveKernelRadialProfile Phi j t ‖xi‖ := by
    intro xi
    exact brrsDyadicHalfWaveSchwartzSymbol_eq_kernelRadialProfile Phi j t xi
  have hint :=
    Auto.RadialFourierTransform.integrable_polar_fourierChar_mul_of_schwartz_radial
      (brrsDyadicHalfWaveSchwartzSymbol Phi j t)
      (brrsDyadicHalfWaveKernelRadialProfile Phi j t) hrad x
  unfold brrsDyadicHalfWaveKernel
  rw [SchwartzMap.fourierInv_coe]
  change 𝓕⁻ (brrsDyadicHalfWaveSchwartzSymbol Phi j t :
    Euclidean d → Complex) x = _
  rw [show (brrsDyadicHalfWaveSchwartzSymbol Phi j t : Euclidean d → Complex) =
      fun xi => brrsDyadicHalfWaveKernelRadialProfile Phi j t ‖xi‖ by
        funext xi
        exact hrad xi]
  exact fourierInv_radial_eq_surfaceFourier_integral hd
    (brrsDyadicHalfWaveKernelRadialProfile Phi j t) x hint

/-- In dimensions at least three, the physical BRRS half-wave kernel is the
literal three-wave stationary radial integral.  No decay estimate is hidden
in this equality. -/
theorem brrsDyadicHalfWaveKernel_eq_stationaryWaveIntegral
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (x : Euclidean d) :
    (brrsDyadicHalfWaveKernel Phi j t : Euclidean d → Complex) x =
      ∫ rho : Ioi (0 : Real),
        (brrsSurfaceWaveTerm d .outgoing ‖x‖ rho.1 +
          brrsSurfaceWaveTerm d .incoming ‖x‖ rho.1 +
            brrsSurfaceWaveTerm d .middle ‖x‖ rho.1) *
          brrsDyadicHalfWaveKernelRadialProfile Phi j t rho.1
            ∂Measure.volumeIoiPow (d - 1) := by
  rw [brrsDyadicHalfWaveKernel_eq_surfaceFourier_integral (by omega) Phi j t x]
  apply integral_congr_ae
  filter_upwards with rho
  rw [brrs_surfaceFourier_neg_smul_eq_three_terms hd rho.2 x]

/-- The level-zero radial BRRS profile is supported in the fixed compact
interval `[1 / 32, 1]`.  The deliberately slightly larger interval avoids
any auxiliary normalization constants while retaining the literal cutoff. -/
theorem brrsDyadicHalfWaveKernelRadialProfile_zero_of_not_mem_levelZero
    (Phi : BRRSAnnularCutoff) (t : Real) {rho : Real}
    (hrho : rho ∈ Ioi (0 : Real)) (hrange : rho ∉ Icc (1 / 32 : Real) 1) :
    brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho = 0 := by
  have hsymbol : Phi.symbol (2 * Real.pi * rho) = 0 := by
    by_contra hnonzero
    have hsupport : 2 * Real.pi * rho ∈ Ioo (1 / 4 : Real) 4 := by
      apply Phi.tsupport_subset
      exact subset_tsupport _ (Function.mem_support.mpr hnonzero)
    have hrhopos : 0 < rho := hrho
    have hlower_mul : 2 * Real.pi * rho < 8 * rho := by
      have hpos : 0 < (4 - Real.pi) * rho :=
        mul_pos (sub_pos.mpr Real.pi_lt_four) hrhopos
      nlinarith
    have hlower : 1 / 32 < rho := by
      nlinarith [hsupport.1]
    have hupper_mul : 6 * rho < 2 * Real.pi * rho := by
      have hpos : 0 < (Real.pi - 3) * rho :=
        mul_pos (sub_pos.mpr Real.pi_gt_three) hrhopos
      nlinarith
    have hupper : rho < 1 := by
      nlinarith [hsupport.2]
    exact hrange ⟨hlower.le, hupper.le⟩
  unfold brrsDyadicHalfWaveKernelRadialProfile
  simp only [pow_zero, inv_one, mul_one, hsymbol, mul_zero]

/-- At level zero the polar formula for the BRRS kernel is an ordinary
compact interval integral.  This exposes both the radial Jacobian and the
literal annular cutoff before any integration-by-parts estimate. -/
theorem brrsDyadicHalfWaveKernel_eq_levelZero_intervalIntegral
    {d : Nat} (hd : 0 < d) (Phi : BRRSAnnularCutoff) (t : Real)
    (x : Euclidean d) :
    (brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x =
      ∫ rho in (1 / 32 : Real)..1,
        ((rho ^ (d - 1) : Real) : Complex) *
          (surfaceFourier d (-rho • x) *
            brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho) := by
  calc
    (brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x =
        ∫ rho : Ioi (0 : Real),
          surfaceFourier d (-rho.1 • x) *
            brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho.1
              ∂Measure.volumeIoiPow (d - 1) :=
      brrsDyadicHalfWaveKernel_eq_surfaceFourier_integral hd Phi 0 t x
    _ = ∫ rho in Ioi (0 : Real), ((rho ^ (d - 1) : Real) : Complex) *
        (surfaceFourier d (-rho • x) *
          brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho) :=
      Auto.Spherical.Auxiliary.integral_volumeIoiPow_eq_setIntegral
        (d - 1)
        (fun rho : Real => surfaceFourier d (-rho • x) *
          brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho)
    _ = ∫ rho in (1 / 32 : Real)..1,
        ((rho ^ (d - 1) : Real) : Complex) *
          (surfaceFourier d (-rho • x) *
            brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho) :=
      Auto.Spherical.Auxiliary.setIntegral_Ioi_eq_intervalIntegral_of_eq_zero_outside_general
          (by norm_num) (by norm_num)
          (fun rho : Real =>
            ((rho ^ (d - 1) : Real) : Complex) *
              (surfaceFourier d (-rho • x) *
                brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho))
          (by
            intro rho hrho hrange
            rw [brrsDyadicHalfWaveKernelRadialProfile_zero_of_not_mem_levelZero
              Phi t hrho hrange]
            ring)

/-- The compact level-zero radial kernel integral in dimensions at least
three, with the actual outgoing, incoming, and middle stationary waves
substituted into its angular factor. -/
theorem brrsDyadicHalfWaveKernel_eq_levelZero_stationaryWaveIntervalIntegral
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) (t : Real)
    (x : Euclidean d) :
    (brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x =
      ∫ rho in (1 / 32 : Real)..1,
        ((rho ^ (d - 1) : Real) : Complex) *
          ((brrsSurfaceWaveTerm d .outgoing ‖x‖ rho +
            brrsSurfaceWaveTerm d .incoming ‖x‖ rho +
              brrsSurfaceWaveTerm d .middle ‖x‖ rho) *
            brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho) := by
  rw [brrsDyadicHalfWaveKernel_eq_levelZero_intervalIntegral (by omega) Phi t x]
  apply intervalIntegral.integral_congr
  intro rho hrho
  dsimp
  have hrhoIcc : rho ∈ Icc (1 / 32 : Real) 1 := by
    simpa only [uIcc_of_le (by norm_num : (1 / 32 : Real) ≤ 1)] using hrho
  have hrhopos : 0 < rho := by nlinarith [hrhoIcc.1]
  rw [brrs_surfaceFourier_neg_smul_eq_three_terms hd hrhopos x]

/-! ### All-dimensional stationary radial amplitudes

The three terms in the preceding compact formula have exactly the same
one-dimensional stationary symbols as the coordinate-wave calculation used
elsewhere in the project.  We record their estimates here with the BRRS names,
so the fixed-time kernel argument does not have to import the much larger AHRS
upper-bound development.
-/

open Auto.Spherical.OscillatoryIntegralAux Auto.Spherical.AHRS

private theorem brrs_quadraticMomentScale_pos_of_one_le
    (m : Nat) {u : Real} (hu : 1 ≤ u) :
    0 < quadraticMomentScale m u := by
  unfold quadraticMomentScale
  exact pow_pos (Real.sqrt_pos.2 (lt_of_lt_of_le zero_lt_one hu)) _

/-- Every radial derivative of the outgoing BRRS stationary amplitude has
the sharp endpoint stationary denominator. -/
theorem exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_outgoing_decay
    (d k : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ a rho : Real, 1 ≤ |(2 * Real.pi * a) * rho| →
      ‖iteratedDeriv k (fun u : Real =>
        brrsSurfaceWaveAmplitude d .outgoing a u) rho‖ ≤
        C * |2 * Real.pi * a| ^ k /
          quadraticMomentScale (d - 2 + 2 * k) |(2 * Real.pi * a) * rho| := by
  obtain ⟨B, hB, hbound⟩ :=
    exists_iteratedDeriv_smoothEndpointQuadraticIntegral_comp_mul_abs_decay (d - 2) k
  refine ⟨‖(surfaceMass (d - 1) : Complex)‖ * B + 1, by positivity, ?_⟩
  intro a rho hlarge
  have hden : 0 < quadraticMomentScale (d - 2 + 2 * k)
      |(2 * Real.pi * a) * rho| :=
    brrs_quadraticMomentScale_pos_of_one_le _ hlarge
  have hpow : 0 ≤ |2 * Real.pi * a| ^ k :=
    pow_nonneg (abs_nonneg _) _
  have hconst : ‖(surfaceMass (d - 1) : Complex)‖ * B ≤
      ‖(surfaceMass (d - 1) : Complex)‖ * B + 1 := by
    linarith
  unfold brrsSurfaceWaveAmplitude
  rw [iteratedDeriv_const_mul_field, norm_mul]
  calc
    ‖(surfaceMass (d - 1) : Complex)‖ *
        ‖iteratedDeriv k (fun u : Real =>
          smoothEndpointQuadraticIntegral (d - 2) ((2 * Real.pi * a) * u)) rho‖ ≤
        ‖(surfaceMass (d - 1) : Complex)‖ *
          (B * |2 * Real.pi * a| ^ k /
            quadraticMomentScale (d - 2 + 2 * k) |(2 * Real.pi * a) * rho|) :=
      mul_le_mul_of_nonneg_left (hbound (2 * Real.pi * a) rho hlarge) (norm_nonneg _)
    _ = (‖(surfaceMass (d - 1) : Complex)‖ * B) * |2 * Real.pi * a| ^ k /
          quadraticMomentScale (d - 2 + 2 * k) |(2 * Real.pi * a) * rho| := by
      ring
    _ ≤ (‖(surfaceMass (d - 1) : Complex)‖ * B + 1) * |2 * Real.pi * a| ^ k /
          quadraticMomentScale (d - 2 + 2 * k) |(2 * Real.pi * a) * rho| := by
      apply div_le_div_of_nonneg_right
      · exact mul_le_mul_of_nonneg_right hconst hpow
      · exact hden.le

/-- The reflected BRRS endpoint has the same all-order stationary decay. -/
theorem exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_incoming_decay
    (d k : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ a rho : Real, 1 ≤ |(-(2 * Real.pi * a)) * rho| →
      ‖iteratedDeriv k (fun u : Real =>
        brrsSurfaceWaveAmplitude d .incoming a u) rho‖ ≤
        C * |-(2 * Real.pi * a)| ^ k /
          quadraticMomentScale (d - 2 + 2 * k) |(-(2 * Real.pi * a)) * rho| := by
  obtain ⟨B, hB, hbound⟩ :=
    exists_iteratedDeriv_smoothEndpointQuadraticIntegral_comp_mul_abs_decay (d - 2) k
  refine ⟨‖(surfaceMass (d - 1) : Complex)‖ * B + 1, by positivity, ?_⟩
  intro a rho hlarge
  have hden : 0 < quadraticMomentScale (d - 2 + 2 * k)
      |(-(2 * Real.pi * a)) * rho| :=
    brrs_quadraticMomentScale_pos_of_one_le _ hlarge
  have hpow : 0 ≤ |-(2 * Real.pi * a)| ^ k :=
    pow_nonneg (abs_nonneg _) _
  have hconst : ‖(surfaceMass (d - 1) : Complex)‖ * B ≤
      ‖(surfaceMass (d - 1) : Complex)‖ * B + 1 := by
    linarith
  unfold brrsSurfaceWaveAmplitude
  rw [iteratedDeriv_const_mul_field, norm_mul]
  calc
    ‖(surfaceMass (d - 1) : Complex)‖ *
        ‖iteratedDeriv k (fun u : Real =>
          smoothEndpointQuadraticIntegral (d - 2) ((-(2 * Real.pi * a)) * u)) rho‖ ≤
        ‖(surfaceMass (d - 1) : Complex)‖ *
          (B * |-(2 * Real.pi * a)| ^ k /
            quadraticMomentScale (d - 2 + 2 * k) |(-(2 * Real.pi * a)) * rho|) :=
      mul_le_mul_of_nonneg_left (hbound (-(2 * Real.pi * a)) rho hlarge) (norm_nonneg _)
    _ = (‖(surfaceMass (d - 1) : Complex)‖ * B) * |-(2 * Real.pi * a)| ^ k /
          quadraticMomentScale (d - 2 + 2 * k) |(-(2 * Real.pi * a)) * rho| := by
      ring
    _ ≤ (‖(surfaceMass (d - 1) : Complex)‖ * B + 1) * |-(2 * Real.pi * a)| ^ k /
          quadraticMomentScale (d - 2 + 2 * k) |(-(2 * Real.pi * a)) * rho| := by
      apply div_le_div_of_nonneg_right
      · exact mul_le_mul_of_nonneg_right hconst hpow
      · exact hden.le

/-- The middle BRRS stationary amplitude has arbitrary polynomial decay after
every radial derivative. -/
theorem exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_middle_decay
    (d k N : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ a rho : Real, 1 ≤ |(2 * Real.pi * a) * rho| →
      ‖iteratedDeriv k (fun u : Real =>
        brrsSurfaceWaveAmplitude d .middle a u) rho‖ ≤
        C * |2 * Real.pi * a| ^ k /
          |(2 * Real.pi * a) * rho| ^ N := by
  obtain ⟨B, hB, hbound⟩ :=
    exists_iteratedDeriv_coordinateMiddleMeridianLocalizedIntegral_abs_decay (d - 2) k N
  refine ⟨‖(surfaceMass (d - 1) : Complex)‖ * B + 1, by positivity, ?_⟩
  intro a rho hlarge
  have hden : 0 < |(2 * Real.pi * a) * rho| ^ N :=
    pow_pos (lt_of_lt_of_le zero_lt_one hlarge) _
  have hpow : 0 ≤ |2 * Real.pi * a| ^ k :=
    pow_nonneg (abs_nonneg _) _
  have hconst : ‖(surfaceMass (d - 1) : Complex)‖ * B ≤
      ‖(surfaceMass (d - 1) : Complex)‖ * B + 1 := by
    linarith
  unfold brrsSurfaceWaveAmplitude
  have hk : ((k : ENat) : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) := by
    exact_mod_cast le_top
  rw [iteratedDeriv_const_mul_field,
    iteratedDeriv_comp_const_smul
      ((contDiff_coordinateMiddleMeridianLocalizedIntegral (d - 2)).of_le hk),
    norm_mul, norm_smul, Real.norm_eq_abs, abs_pow]
  calc
    ‖(surfaceMass (d - 1) : Complex)‖ *
        (|2 * Real.pi * a| ^ k *
          ‖iteratedDeriv k
            (coordinateMiddleMeridianLocalizedIntegral (d - 2))
            ((2 * Real.pi * a) * rho)‖) ≤
        ‖(surfaceMass (d - 1) : Complex)‖ *
          (|2 * Real.pi * a| ^ k *
            (B / |(2 * Real.pi * a) * rho| ^ N)) := by
      gcongr
      exact hbound _ hlarge
    _ = (‖(surfaceMass (d - 1) : Complex)‖ * B) * |2 * Real.pi * a| ^ k /
          |(2 * Real.pi * a) * rho| ^ N := by
      ring
    _ ≤ (‖(surfaceMass (d - 1) : Complex)‖ * B + 1) * |2 * Real.pi * a| ^ k /
          |(2 * Real.pi * a) * rho| ^ N := by
      apply div_le_div_of_nonneg_right
      · exact mul_le_mul_of_nonneg_right hconst hpow
      · exact hden.le

/-- Exact stationary-phase replacement for the Bessel asymptotic used in
BRRS (3.3).  It concerns the actual Fourier transform of surface measure,
with Mathlib's explicit `2 * pi` Fourier normalization: the two endpoint
waves have the sharp quadratic stationary scale, while the middle wave has
arbitrarily rapid decay.

This deliberately does not introduce a replacement definition for the
ordinary Bessel function.  Together with the displayed exact identity, these
are precisely the three pieces needed in place of the Bessel expansion when
forming the radial Fourier integral in (3.2)--(3.4). -/
theorem exists_brrs_surfaceFourier_threeWave_replacement_bounds
    (d N : Nat) (hd : 3 <= d) :
    ∃ C : Real, 0 < C ∧ ∀ (x : BRRSSpace d) (rho : Real), 0 < rho →
      1 <= |(2 * Real.pi * ‖x‖) * rho| →
        surfaceFourier d (-rho • x) =
          brrsSurfaceWaveTerm d .outgoing ‖x‖ rho +
            brrsSurfaceWaveTerm d .incoming ‖x‖ rho +
              brrsSurfaceWaveTerm d .middle ‖x‖ rho ∧
        ‖brrsSurfaceWaveAmplitude d .outgoing ‖x‖ rho‖ <=
          C / quadraticMomentScale (d - 2) |(2 * Real.pi * ‖x‖) * rho| ∧
        ‖brrsSurfaceWaveAmplitude d .incoming ‖x‖ rho‖ <=
          C / quadraticMomentScale (d - 2) |(2 * Real.pi * ‖x‖) * rho| ∧
        ‖brrsSurfaceWaveAmplitude d .middle ‖x‖ rho‖ <=
          C / |(2 * Real.pi * ‖x‖) * rho| ^ N := by
  obtain ⟨Cout, hCout, hout⟩ :=
    exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_outgoing_decay d 0
  obtain ⟨Cin, hCin, hin⟩ :=
    exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_incoming_decay d 0
  obtain ⟨Cmid, hCmid, hmid⟩ :=
    exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_middle_decay d 0 N
  let C : Real := Cout + Cin + Cmid
  have hC : 0 < C := by
    dsimp [C]
    positivity
  refine ⟨C, hC, ?_⟩
  intro x rho hrho hlarge
  have hscale : 0 < quadraticMomentScale (d - 2)
      |(2 * Real.pi * ‖x‖) * rho| :=
    brrs_quadraticMomentScale_pos_of_one_le _ hlarge
  have hsign : |(-(2 * Real.pi * ‖x‖)) * rho| =
      |(2 * Real.pi * ‖x‖) * rho| := by
    rw [show (-(2 * Real.pi * ‖x‖)) * rho =
      -((2 * Real.pi * ‖x‖) * rho) by ring, abs_neg]
  have hout0 : ‖brrsSurfaceWaveAmplitude d .outgoing ‖x‖ rho‖ <=
      Cout / quadraticMomentScale (d - 2) |(2 * Real.pi * ‖x‖) * rho| := by
    simpa using hout ‖x‖ rho hlarge
  have hin0 : ‖brrsSurfaceWaveAmplitude d .incoming ‖x‖ rho‖ <=
      Cin / quadraticMomentScale (d - 2) |(2 * Real.pi * ‖x‖) * rho| := by
    simpa only [hsign, iteratedDeriv_zero, pow_zero, mul_one,
      Nat.mul_zero, Nat.add_zero] using
      hin ‖x‖ rho (by simpa only [hsign] using hlarge)
  have hmid0 : ‖brrsSurfaceWaveAmplitude d .middle ‖x‖ rho‖ <=
      Cmid / |(2 * Real.pi * ‖x‖) * rho| ^ N := by
    simpa using hmid ‖x‖ rho hlarge
  refine ⟨brrs_surfaceFourier_neg_smul_eq_three_terms hd hrho x, ?_, ?_, ?_⟩
  · calc
      ‖brrsSurfaceWaveAmplitude d .outgoing ‖x‖ rho‖ <=
          Cout / quadraticMomentScale (d - 2) |(2 * Real.pi * ‖x‖) * rho| := hout0
      _ <= C / quadraticMomentScale (d - 2) |(2 * Real.pi * ‖x‖) * rho| := by
        apply div_le_div_of_nonneg_right
        · dsimp [C]
          linarith
        · exact hscale.le
  · calc
      ‖brrsSurfaceWaveAmplitude d .incoming ‖x‖ rho‖ <=
          Cin / quadraticMomentScale (d - 2) |(2 * Real.pi * ‖x‖) * rho| := hin0
      _ <= C / quadraticMomentScale (d - 2) |(2 * Real.pi * ‖x‖) * rho| := by
        apply div_le_div_of_nonneg_right
        · dsimp [C]
          linarith
        · exact hscale.le
  · have hden : 0 < |(2 * Real.pi * ‖x‖) * rho| ^ N :=
      pow_pos (lt_of_lt_of_le zero_lt_one hlarge) _
    calc
      ‖brrsSurfaceWaveAmplitude d .middle ‖x‖ rho‖ <=
          Cmid / |(2 * Real.pi * ‖x‖) * rho| ^ N := hmid0
      _ <= C / |(2 * Real.pi * ‖x‖) * rho| ^ N := by
        apply div_le_div_of_nonneg_right
        · dsimp [C]
          linarith
        · exact hden.le

/-- Multiplying a BRRS stationary surface wave by the level-zero half-wave
profile simply adds their two linear radial frequencies.  This exact identity
is the bridge from the physical kernel to compact nonstationary integration by
parts. -/
theorem brrsSurfaceWaveTerm_mul_levelZeroProfile_eq_oscillatoryExp
    (d : Nat) (part : BRRSSurfaceWavePart) (a : Real)
    (Phi : BRRSAnnularCutoff) (t rho : Real) :
    brrsSurfaceWaveTerm d part a rho *
        brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho =
      (brrsSurfaceWaveAmplitude d part a rho * Phi.symbol (2 * Real.pi * rho)) *
        oscillatoryExp (brrsSurfaceWavePhase part a + 2 * Real.pi * t) rho := by
  unfold brrsSurfaceWaveTerm brrsDyadicHalfWaveKernelRadialProfile oscillatoryExp
  simp only [pow_zero, inv_one, mul_one]
  calc
    (brrsSurfaceWaveAmplitude d part a rho *
        Complex.exp (((brrsSurfaceWavePhase part a * rho : Real) : Complex) * Complex.I)) *
        (Complex.exp (((2 * Real.pi * t * rho : Real) : Complex) * Complex.I) *
          Phi.symbol (2 * Real.pi * rho)) =
      (brrsSurfaceWaveAmplitude d part a rho * Phi.symbol (2 * Real.pi * rho)) *
        (Complex.exp (((brrsSurfaceWavePhase part a * rho : Real) : Complex) * Complex.I) *
          Complex.exp (((2 * Real.pi * t * rho : Real) : Complex) * Complex.I)) := by
        ring
    _ = (brrsSurfaceWaveAmplitude d part a rho * Phi.symbol (2 * Real.pi * rho)) *
        Complex.exp
          ((((brrsSurfaceWavePhase part a * rho : Real) : Complex) * Complex.I) +
            (((2 * Real.pi * t * rho : Real) : Complex) * Complex.I)) := by
        rw [← Complex.exp_add]
    _ = (brrsSurfaceWaveAmplitude d part a rho * Phi.symbol (2 * Real.pi * rho)) *
        Complex.exp
          ((((brrsSurfaceWavePhase part a + 2 * Real.pi * t) * rho : Real) : Complex) *
            Complex.I) := by
        congr 1
        push_cast
        ring

/-! ### Two-radius endpoint phase normal form

The radial kernel in BRRS Proposition 5.1 contains two Bessel factors.  The
existing stationary surface-wave representation replaces each Bessel factor
by an outgoing and an incoming endpoint wave (with a separate middle
remainder).  The definitions below record the exact four endpoint phases
before any asymptotic estimate is invoked.  This is the literal algebraic
bridge to the four-profile majorant in (5.4). -/

/-- Exact nested two-radius polar representation of the literal half-wave on a
radial Schwartz input.  The inner integral is the forward radial Fourier
formula, while the outer integral is the inverse formula after propagation.
This is the precise Fourier-theoretic precursor to the two-radius kernel
calculation; no exchange of the two radial integrals is made here. -/
theorem brrsDyadicHalfWave_eq_nested_twoRadius_surfaceFourier_integral
    {d : Nat} (hd : 0 < d) (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d → Complex))
    (v w : BRRSSpace d) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1) (x : BRRSSpace d) :
    brrsDyadicHalfWave Phi j t f x =
      ∫ rho : Ioi (0 : Real),
        surfaceFourier d (-rho.1 • x) *
          (brrsDyadicHalfWaveSymbol Phi j t (rho.1 • v) *
            ∫ s : Ioi (0 : Real),
              surfaceFourier d (s.1 • (rho.1 • v)) * f (s.1 • w)
                ∂Measure.volumeIoiPow (d - 1))
          ∂Measure.volumeIoiPow (d - 1) := by
  let F : Real → Complex := fun s => f (s • w)
  have hF : ∀ y : BRRSSpace d, f y = F ‖y‖ := by
    intro y
    dsimp [F]
    apply hf y (‖y‖ • w)
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _), hw, mul_one]
  have houter := brrsDyadicHalfWave_eq_surfaceFourier_integral_of_isRadial
    hd Phi j t f hf v hv x
  rw [houter]
  apply integral_congr_ae
  filter_upwards with rho
  have hinner :
      𝓕 (f : BRRSSpace d → Complex) (rho.1 • v) =
        ∫ s : Ioi (0 : Real),
          surfaceFourier d (s.1 • (rho.1 • v)) * F s.1
            ∂Measure.volumeIoiPow (d - 1) := by
    rw [show (f : BRRSSpace d → Complex) = fun y => F ‖y‖ by
      funext y
      exact hF y]
    rw [Auto.RadialFourierTransform.fourier_radial_eq_sphereFourier_integral hd F
      (rho.1 • v)
      (Auto.RadialFourierTransform.integrable_polar_fourierChar_mul_of_schwartz_radial
        f F hF (-(rho.1 • v)))]
    apply integral_congr_ae
    filter_upwards with s
    rw [radialFourier_sphereFourier_eq_surfaceFourier]
    congr 2
    module
  rw [brrsDyadicHalfWaveRadialFourierProfile, hinner]

/-- A Fubini interchange tailored to the product structure of the radial
half-wave calculation.  Keeping the three factors separate makes the lemma
reusable whenever a compact frequency integral is paired with a radial source
integral. -/
theorem brrs_integral_mul_integral_swap_of_integrable
    {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]
    (μ : Measure α) (ν : Measure β) [SFinite μ] [SFinite ν]
    (F : α → Complex) (G : α → β → Complex) (H : β → Complex)
    (hInt : Integrable (fun z => F z.1 * (G z.1 z.2 * H z.2)) (μ.prod ν)) :
    (∫ a, F a * ∫ b, G a b * H b ∂ν ∂μ) =
      ∫ b, (∫ a, F a * G a b ∂μ) * H b ∂ν := by
  have hleft :
      (∫ a, F a * ∫ b, G a b * H b ∂ν ∂μ) =
        ∫ a, ∫ b, F a * (G a b * H b) ∂ν ∂μ := by
    apply integral_congr_ae
    filter_upwards with a
    rw [← integral_const_mul]
  rw [hleft, ← MeasureTheory.integral_prod (fun z =>
    F z.1 * (G z.1 z.2 * H z.2)) hInt]
  rw [MeasureTheory.integral_prod_symm (fun z =>
    F z.1 * (G z.1 z.2 * H z.2)) hInt]
  apply integral_congr_ae
  filter_upwards with b
  rw [← integral_mul_const]
  apply integral_congr_ae
  filter_upwards with a
  ring

/-- A Schwartz radial datum has an integrable one-dimensional profile for the
literal polar power measure.  The proof transports integrability through the
polar homeomorphism and then removes the nonzero unit-sphere factor. -/
theorem integrable_brrs_radial_profile_volumeIoiPow
    {d : Nat} (hd : 0 < d) (f : BRRSSchwartz d)
    (hf : IsRadial (f : BRRSSpace d → Complex))
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    Integrable (fun s : Ioi (0 : Real) => f (s.1 • w))
      (Measure.volumeIoiPow (d - 1)) := by
  let F : Real → Complex := fun s => f (s • w)
  have hrad : ∀ y : BRRSSpace d, f y = F ‖y‖ := by
    intro y
    dsimp only [F]
    apply hf y (‖y‖ • w)
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _), hw, mul_one]
  have hpolar :=
    Auto.RadialFourierTransform.integrable_polar_fourierChar_mul_of_schwartz_radial
      f F hrad (0 : BRRSSpace d)
  have hcomp : Integrable (fun p => F p.2.1)
      ((unitSurfaceMeasure d).prod (Measure.volumeIoiPow (d - 1))) := by
    refine hpolar.congr (Filter.Eventually.of_forall ?_)
    intro p
    simp [F]
  apply Integrable.of_comp_snd hcomp
  intro hzero
  have huniv : (unitSurfaceMeasure d) Set.univ = 0 := by
    rw [hzero]
    rfl
  exact (ne_of_gt (unitSurfaceMeasure_univ_pos hd)) huniv

/-- The compact annular half-wave symbol is radial on its Schwartz
realization. -/
theorem brrsDyadicHalfWaveSchwartzSymbol_isRadial
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real) :
    IsRadial
      ((brrsDyadicHalfWaveSchwartzSymbol Phi j t : BRRSSchwartz d) :
        BRRSSpace d → Complex) := by
  intro xi eta hnorm
  change brrsDyadicHalfWaveSymbol Phi j t xi =
    brrsDyadicHalfWaveSymbol Phi j t eta
  unfold brrsDyadicHalfWaveSymbol
  rw [halfWaveMultiplier_isRadial t xi eta hnorm,
    brrsDyadicMultiplier_isRadial Phi j xi eta hnorm]

/-- The annular half-wave symbol is integrable along every unit radial ray
with the polar radial measure. -/
theorem integrable_brrsDyadicHalfWaveSymbol_on_radial_ray
    {d : Nat} (hd : 0 < d) (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (v : BRRSSpace d) (hv : ‖v‖ = 1) :
    Integrable (fun rho : Ioi (0 : Real) =>
      brrsDyadicHalfWaveSymbol Phi j t (rho.1 • v))
      (Measure.volumeIoiPow (d - 1)) := by
  have hprofile := integrable_brrs_radial_profile_volumeIoiPow hd
    (brrsDyadicHalfWaveSchwartzSymbol Phi j t)
    (brrsDyadicHalfWaveSchwartzSymbol_isRadial Phi j t) v hv
  simpa only [brrsDyadicHalfWaveSchwartzSymbol_apply] using hprofile

/-- The two-radius integrand obtained from a radial Schwartz datum is
integrable.  This supplies the Fubini hypothesis in the exact radial
half-wave formula from the decay of the compact frequency symbol and the
Schwartz decay of the datum. -/
theorem integrable_brrs_twoRadius_surfaceFourier_integrand
    {d : Nat} (hd : 0 < d) (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d → Complex))
    (v w x : BRRSSpace d) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1) :
    Integrable (fun z =>
      (surfaceFourier d (-z.1.1 • x) *
        brrsDyadicHalfWaveSymbol Phi j t (z.1.1 • v)) *
          (surfaceFourier d (z.2.1 • (z.1.1 • v)) * f (z.2.1 • w)))
      ((Measure.volumeIoiPow (d - 1)).prod (Measure.volumeIoiPow (d - 1))) := by
  have hsymbol := integrable_brrsDyadicHalfWaveSymbol_on_radial_ray
    hd Phi j t v hv
  have hinput := integrable_brrs_radial_profile_volumeIoiPow hd f hf w hw
  have hprod := hsymbol.mul_prod hinput
  let M : Real := (unitSurfaceMeasure d).real Set.univ
  have hcontinuous : AEStronglyMeasurable (fun z : Ioi (0 : Real) × Ioi (0 : Real) =>
      surfaceFourier d (-z.1.1 • x) *
        surfaceFourier d (z.2.1 • (z.1.1 • v)))
      ((Measure.volumeIoiPow (d - 1)).prod (Measure.volumeIoiPow (d - 1))) := by
    apply Continuous.aestronglyMeasurable
    exact ((continuous_surfaceFourier d).comp (by fun_prop)).mul
      ((continuous_surfaceFourier d).comp (by fun_prop))
  have hbound :
      ∀ᵐ z ∂((Measure.volumeIoiPow (d - 1)).prod (Measure.volumeIoiPow (d - 1))),
        ‖surfaceFourier d (-z.1.1 • x) *
          surfaceFourier d (z.2.1 • (z.1.1 • v))‖ ≤ M * M := by
    filter_upwards with z
    dsimp only [M]
    rw [norm_mul]
    exact mul_le_mul
      (norm_surfaceFourier_le_surfaceMass d (-z.1.1 • x))
      (norm_surfaceFourier_le_surfaceMass d (z.2.1 • (z.1.1 • v)))
      (norm_nonneg _) measureReal_nonneg
  have hbounded := hprod.mul_bdd hcontinuous hbound
  refine hbounded.congr (Filter.Eventually.of_forall ?_)
  intro z
  ring

/-- Under the displayed joint-integrability hypothesis, the nested radial
Fourier formula is exactly an integral against a two-radius physical kernel.
This is the Fubini bridge between the literal half-wave and the stationary
two-radius coefficients used in the BRRS radial argument. -/
theorem brrsDyadicHalfWave_eq_twoRadius_surfaceFourier_kernel_of_integrable
    {d : Nat} (hd : 0 < d) (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d → Complex))
    (v w x : BRRSSpace d) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1)
    (hInt : Integrable (fun z =>
      (surfaceFourier d (-z.1.1 • x) *
        brrsDyadicHalfWaveSymbol Phi j t (z.1.1 • v)) *
          (surfaceFourier d (z.2.1 • (z.1.1 • v)) * f (z.2.1 • w)))
      ((Measure.volumeIoiPow (d - 1)).prod (Measure.volumeIoiPow (d - 1)))) :
    brrsDyadicHalfWave Phi j t f x =
      ∫ s : Ioi (0 : Real),
        (∫ rho : Ioi (0 : Real),
          surfaceFourier d (-rho.1 • x) *
            (brrsDyadicHalfWaveSymbol Phi j t (rho.1 • v) *
              surfaceFourier d (s.1 • (rho.1 • v)))
            ∂Measure.volumeIoiPow (d - 1)) * f (s.1 • w)
        ∂Measure.volumeIoiPow (d - 1) := by
  rw [brrsDyadicHalfWave_eq_nested_twoRadius_surfaceFourier_integral
    hd Phi j t f hf v w hv hw x]
  have hrearrange :
      (∫ rho : Ioi (0 : Real),
        surfaceFourier d (-rho.1 • x) *
          (brrsDyadicHalfWaveSymbol Phi j t (rho.1 • v) *
            ∫ s : Ioi (0 : Real),
              surfaceFourier d (s.1 • (rho.1 • v)) * f (s.1 • w)
              ∂Measure.volumeIoiPow (d - 1))
          ∂Measure.volumeIoiPow (d - 1)) =
        ∫ rho : Ioi (0 : Real),
          (surfaceFourier d (-rho.1 • x) *
            brrsDyadicHalfWaveSymbol Phi j t (rho.1 • v)) *
            ∫ s : Ioi (0 : Real),
              surfaceFourier d (s.1 • (rho.1 • v)) * f (s.1 • w)
              ∂Measure.volumeIoiPow (d - 1)
          ∂Measure.volumeIoiPow (d - 1) := by
    apply integral_congr_ae
    filter_upwards with rho
    ring
  rw [hrearrange]
  simpa only [mul_assoc] using
    (brrs_integral_mul_integral_swap_of_integrable
      (Measure.volumeIoiPow (d - 1)) (Measure.volumeIoiPow (d - 1))
      (fun rho => surfaceFourier d (-rho.1 • x) *
        brrsDyadicHalfWaveSymbol Phi j t (rho.1 • v))
      (fun rho s => surfaceFourier d (s.1 • (rho.1 • v)))
      (fun s => f (s.1 • w)) hInt)

/-- Exact two-radius surface-Fourier representation of an annular half-wave
on radial Schwartz data.  Unlike the preceding helper, this form has no
additional Fubini hypothesis. -/
theorem brrsDyadicHalfWave_eq_twoRadius_surfaceFourier_kernel
    {d : Nat} (hd : 0 < d) (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d → Complex))
    (v w x : BRRSSpace d) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1) :
    brrsDyadicHalfWave Phi j t f x =
      ∫ s : Ioi (0 : Real),
        (∫ rho : Ioi (0 : Real),
          surfaceFourier d (-rho.1 • x) *
            (brrsDyadicHalfWaveSymbol Phi j t (rho.1 • v) *
              surfaceFourier d (s.1 • (rho.1 • v)))
            ∂Measure.volumeIoiPow (d - 1)) * f (s.1 • w)
        ∂Measure.volumeIoiPow (d - 1) := by
  apply brrsDyadicHalfWave_eq_twoRadius_surfaceFourier_kernel_of_integrable
    hd Phi j t f hf v w x hv hw
  exact integrable_brrs_twoRadius_surfaceFourier_integrand
    hd Phi j t f hf v w x hv hw

/-! ### Repository-normalized radial Bessel kernel (BRRS Section 5)

The generic scalar Bessel factor lives in `Auto.RadialFourierTransform` and
is defined there as the unit-ray restriction of the sphere Fourier transform.
Mathlib has no Bessel-`J` API, so this section never identifies that exact
factor with an unformalized classical special-function formula.  Instead it
records the exact kernel in the repository's `2 pi` Fourier convention and
proves its connection with the radial half-wave.

**Normalization audit.**  With the ordinary Bessel function and the Fourier
convention printed in BRRS, the standard sphere-Fourier-to-Bessel identity,
followed by `lambda = 2 pi rho`, turns the repository kernel below (for
positive radii) into a constant-free scalar integral with
`lambda * J_((d - 2) / 2) (lambda * r) * J_((d - 2) / 2) (lambda * s)`.
The display immediately after BRRS (5.3) prints the same expression with
ordinary `d lambda` but without that `lambda` factor, while explicitly
calling `J` the usual Bessel function and writing `f(x) = f_0(|x|)`.  This
was checked both in arXiv:2501.12805v1 and in the published version, *Bull.
Lond. Math. Soc.* 57 (2025), §5, immediately before its kernel estimate.
The same paper's (3.3) gives the standard large-argument asymptotic for that
ordinary Bessel function, so it does not supply a normalization that can
absorb the factor.  Thus the definition below is *not* claimed to be
literally equal to that printed `K_j` display; it is the proved
repository-normalized polar kernel.  The omission is a confirmed
source-normalization discrepancy (apparently typographical), so a
source-literal Bessel-`J` bridge must remain qualified until it is resolved.
-/

/-- In the surface-measure convention used by this file, the shared radial
Bessel factor is the scalar restriction of `surfaceFourier` to a ray. -/
theorem brrsRadialBesselFactor_eq_surfaceFourier
    (d : Nat) (v : BRRSSpace d) (u : Real) :
    Auto.RadialFourierTransform.brrsRadialBesselFactor d v u =
      surfaceFourier d (u • v) := by
  unfold Auto.RadialFourierTransform.brrsRadialBesselFactor
  rw [radialFourier_sphereFourier_eq_surfaceFourier, surfaceFourier_neg]

/-- The exact repository-normalized scalar radial kernel for the annular
BRRS half-wave, normalized with respect to ordinary Lebesgue `ds` in the
source radius.  Its frequency profile is
`exp (2 pi i t rho) * Phi.symbol (2 pi * 2^-j * rho)`, through
`brrsDyadicHalfWaveKernelRadialProfile`; its displayed `s ^ (d - 1)` is the
outer polar Jacobian.  See the preceding normalization audit: this exact
polar kernel deliberately does not assert equality with the paper's printed
Bessel-`J` formula. -/
noncomputable def brrsRadialBesselKernel
    (Phi : BRRSAnnularCutoff) (d : Nat) (v : BRRSSpace d)
    (j : Nat) (r s t : Real) : Complex :=
  ((s ^ (d - 1) : Real) : Complex) *
    ∫ rho in Ioi (0 : Real), ((rho ^ (d - 1) : Real) : Complex) *
      (Auto.RadialFourierTransform.brrsRadialBesselFactor d v (-(rho * r)) *
        (brrsDyadicHalfWaveKernelRadialProfile Phi j t rho *
          Auto.RadialFourierTransform.brrsRadialBesselFactor d v (rho * s)))

/-- The scalar radial kernel is independent of the unit ray used to write
it.  Thus its effective variables are exactly `(r, s, t)`, as in the
Section 5 kernel (K_j(r,s,t)). -/
theorem brrsRadialBesselKernel_eq_of_unit
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat) (r s t : Real)
    {v w : BRRSSpace d} (hv : ‖v‖ = 1) (hw : ‖w‖ = 1) :
    brrsRadialBesselKernel Phi d v j r s t =
      brrsRadialBesselKernel Phi d w j r s t := by
  unfold brrsRadialBesselKernel
  congr 1
  apply setIntegral_congr_fun measurableSet_Ioi
  intro rho hrho
  dsimp
  rw [Auto.RadialFourierTransform.brrsRadialBesselFactor_eq_of_unit hv hw,
    Auto.RadialFourierTransform.brrsRadialBesselFactor_eq_of_unit hv hw]

/-- On a positive unit ray, the dyadic symbol is exactly its scalar radial
frequency profile at every dyadic scale. -/
theorem brrsDyadicHalfWaveSymbol_on_positive_ray_eq_kernelRadialProfile
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat) (t rho : Real)
    (v : BRRSSpace d) (hv : ‖v‖ = 1) (hrho : 0 < rho) :
    brrsDyadicHalfWaveSymbol Phi j t (rho • v) =
      brrsDyadicHalfWaveKernelRadialProfile Phi j t rho := by
  have hnorm : ‖rho • v‖ = rho := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hrho, hv, mul_one]
  calc
    brrsDyadicHalfWaveSymbol Phi j t (rho • v) =
        brrsDyadicHalfWaveSchwartzSymbol Phi j t (rho • v) := rfl
    _ = brrsDyadicHalfWaveKernelRadialProfile Phi j t ‖rho • v‖ :=
      brrsDyadicHalfWaveSchwartzSymbol_eq_kernelRadialProfile Phi j t (rho • v)
    _ = brrsDyadicHalfWaveKernelRadialProfile Phi j t rho := by rw [hnorm]

/-- Expanding the scalar Bessel factors recovers the exact two-radius
surface-Fourier kernel, including the source polar density. -/
theorem brrsRadialBesselKernel_eq_twoRadius_surfaceFourier
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat) (t r s : Real)
    (v : BRRSSpace d) (hv : ‖v‖ = 1) :
    brrsRadialBesselKernel Phi d v j r s t =
      ((s ^ (d - 1) : Real) : Complex) *
        ∫ rho : Ioi (0 : Real),
          surfaceFourier d (-rho.1 • (r • v)) *
            (brrsDyadicHalfWaveSymbol Phi j t (rho.1 • v) *
              surfaceFourier d (s • (rho.1 • v)))
          ∂Measure.volumeIoiPow (d - 1) := by
  let G : Real → Complex := fun rho =>
    surfaceFourier d (-rho • (r • v)) *
      (brrsDyadicHalfWaveSymbol Phi j t (rho • v) *
        surfaceFourier d (s • (rho • v)))
  have hmeasure :
      (∫ rho : Ioi (0 : Real), G rho.1 ∂Measure.volumeIoiPow (d - 1)) =
        ∫ rho in Ioi (0 : Real), ((rho ^ (d - 1) : Real) : Complex) * G rho :=
    Auto.Spherical.Auxiliary.integral_volumeIoiPow_eq_setIntegral
      (d - 1) G
  calc
    brrsRadialBesselKernel Phi d v j r s t =
        ((s ^ (d - 1) : Real) : Complex) *
          ∫ rho in Ioi (0 : Real), ((rho ^ (d - 1) : Real) : Complex) * G rho := by
      unfold brrsRadialBesselKernel
      congr 1
      apply setIntegral_congr_fun measurableSet_Ioi
      intro rho hrho
      dsimp only [G]
      have houter : (-(rho * r)) • v = -rho • (r • v) := by
        module
      have hinner : (rho * s) • v = s • (rho • v) := by
        module
      rw [brrsRadialBesselFactor_eq_surfaceFourier,
        brrsRadialBesselFactor_eq_surfaceFourier, houter, hinner,
        ← brrsDyadicHalfWaveSymbol_on_positive_ray_eq_kernelRadialProfile
          Phi j t rho v hv hrho]
    _ = ((s ^ (d - 1) : Real) : Complex) *
        ∫ rho : Ioi (0 : Real), G rho.1 ∂Measure.volumeIoiPow (d - 1) :=
      congrArg (fun z : Complex => ((s ^ (d - 1) : Real) : Complex) * z)
        hmeasure.symm
    _ = ((s ^ (d - 1) : Real) : Complex) *
        ∫ rho : Ioi (0 : Real),
          surfaceFourier d (-rho.1 • (r • v)) *
            (brrsDyadicHalfWaveSymbol Phi j t (rho.1 • v) *
              surfaceFourier d (s • (rho.1 • v)))
          ∂Measure.volumeIoiPow (d - 1) := by
      rfl

/-- Exact radial reduction of the literal half-wave to the
repository-normalized scalar Bessel kernel, now integrated against ordinary
Lebesgue `ds` rather than the polar power measure. -/
theorem brrsDyadicHalfWave_eq_radialBesselKernel_integral
    {d : Nat} (hd : 0 < d) (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d → Complex))
    (v w : BRRSSpace d) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1) (r : Real) :
    brrsDyadicHalfWave Phi j t f (r • v) =
      ∫ s in Ioi (0 : Real),
        brrsRadialBesselKernel Phi d v j r s t * f (s • w) := by
  let F : Real → Complex := fun s =>
    (∫ rho : Ioi (0 : Real),
      surfaceFourier d (-rho.1 • (r • v)) *
        (brrsDyadicHalfWaveSymbol Phi j t (rho.1 • v) *
          surfaceFourier d (s • (rho.1 • v)))
      ∂Measure.volumeIoiPow (d - 1)) * f (s • w)
  calc
    brrsDyadicHalfWave Phi j t f (r • v) =
        ∫ s : Ioi (0 : Real), F s.1 ∂Measure.volumeIoiPow (d - 1) := by
      rw [brrsDyadicHalfWave_eq_twoRadius_surfaceFourier_kernel
        hd Phi j t f hf v w (r • v) hv hw]
    _ = ∫ s in Ioi (0 : Real), ((s ^ (d - 1) : Real) : Complex) * F s :=
      Auto.Spherical.Auxiliary.integral_volumeIoiPow_eq_setIntegral
        (d - 1) F
    _ = ∫ s in Ioi (0 : Real),
        brrsRadialBesselKernel Phi d v j r s t * f (s • w) := by
      apply setIntegral_congr_fun measurableSet_Ioi
      intro s hs
      dsimp only [F]
      rw [← mul_assoc,
        ← brrsRadialBesselKernel_eq_twoRadius_surfaceFourier Phi j t r s v hv]

/-- The exact radial kernel formula at an arbitrary physical point.  This is
the coordinate-free form of the preceding polar identity: its first kernel
variable is precisely `‖x‖`, as in the Section 5 notation `K_j(|x|, t, s)`.
It is stated in the repository's Fourier normalization and makes no claim
that the published Bessel display (which omits the required frequency
Jacobian) is literally identical to this kernel. -/
theorem brrsDyadicHalfWave_eq_radialBesselKernel_integral_of_norm
    {d : Nat} (hd : 0 < d) (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d → Complex))
    (v w x : BRRSSpace d) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1) :
    brrsDyadicHalfWave Phi j t f x =
      ∫ s in Ioi (0 : Real),
        brrsRadialBesselKernel Phi d v j ‖x‖ s t * f (s • w) := by
  calc
    brrsDyadicHalfWave Phi j t f x =
        brrsDyadicHalfWave Phi j t f (‖x‖ • v) := by
      apply brrsDyadicHalfWave_isRadial Phi j t f hf
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _), hv, mul_one]
    _ = ∫ s in Ioi (0 : Real),
        brrsRadialBesselKernel Phi d v j ‖x‖ s t * f (s • w) :=
      brrsDyadicHalfWave_eq_radialBesselKernel_integral
        hd Phi j t f hf v w hv hw ‖x‖

/-- The literal translation-invariant source kernel for the annular BRRS
half-wave.  This is the physical kernel occurring in the radial convolution
formula of Section 5. -/
noncomputable def brrsDyadicHalfWaveSourceKernel {d : Nat}
    (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (x y : BRRSSpace d) : Complex :=
  brrsDyadicHalfWaveKernel Phi j t (x - y)

/-- Exact simultaneous dilation of the literal two-point source kernel.
Unlike a radial majorant, this is an identity for the actual kernel and keeps
both physical variables visible for the subsequent two-radius reduction. -/
theorem brrsDyadicHalfWaveSourceKernel_eq_levelZero_scaled_general
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (x y : BRRSSpace d) :
    brrsDyadicHalfWaveSourceKernel Phi j t x y =
      ((2 : Real) ^ j) ^ d •
        brrsDyadicHalfWaveSourceKernel Phi 0 ((2 : Real) ^ j * t)
          ((2 : Real) ^ j • x) ((2 : Real) ^ j • y) := by
  unfold brrsDyadicHalfWaveSourceKernel
  rw [brrsDyadicHalfWaveKernel_eq_levelZero_scaled_general]
  rw [smul_sub]

/-- Exact source-kernel realization of the BRRS half-wave on the Schwartz
core. -/
theorem brrsDyadicHalfWave_eq_sourceKernel {d : Nat}
    (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real) (f : BRRSSchwartz d)
    (x : BRRSSpace d) :
    brrsDyadicHalfWave Phi j t f x =
      ∫ y : BRRSSpace d, brrsDyadicHalfWaveSourceKernel Phi j t x y * f y := by
  rw [brrsDyadicHalfWave_eq_kernel_convolution, convolution_mul_swap]
  rfl

/-- Precomposition of a Schwartz input by an inverse spatial dilation.  The
parameter `q` is kept explicit so that the same object can be used for the
dyadic scaling argument and for other radial rescalings. -/
noncomputable def brrsSchwartzInputDilation {d : Nat}
    (q : Real) (hq : q ≠ 0) (f : BRRSSchwartz d) : BRRSSchwartz d :=
  let A : BRRSSpace d ≃L[Real] BRRSSpace d :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 q⁻¹ (inv_ne_zero hq))
  (SchwartzMap.compCLMOfContinuousLinearEquiv Complex A) f

/-- Literal pointwise formula for `brrsSchwartzInputDilation`. -/
theorem brrsSchwartzInputDilation_apply {d : Nat}
    (q : Real) (hq : q ≠ 0) (f : BRRSSchwartz d) (z : BRRSSpace d) :
    brrsSchwartzInputDilation q hq f z = f (q⁻¹ • z) := by
  simp [brrsSchwartzInputDilation]

/-- Inverse spatial dilation preserves radiality of Schwartz data. -/
theorem brrsSchwartzInputDilation_isRadial {d : Nat}
    (q : Real) (hq : q ≠ 0) (f : BRRSSchwartz d)
    (hf : IsRadial (f : BRRSSpace d → Complex)) :
    IsRadial (brrsSchwartzInputDilation q hq f : BRRSSpace d → Complex) := by
  intro x y hxy
  rw [brrsSchwartzInputDilation_apply, brrsSchwartzInputDilation_apply]
  apply hf
  rw [norm_smul, norm_smul, hxy]

/-- On a dilated radial ray, the rescaled Schwartz input is exactly the
original input at the undilated radius. -/
theorem brrsSchwartzInputDilation_scaled_ray_apply {d : Nat}
    (q : Real) (hq : q ≠ 0) (f : BRRSSchwartz d)
    (s : Real) (w : BRRSSpace d) :
    brrsSchwartzInputDilation q hq f ((q * s) • w) = f (s • w) := by
  rw [brrsSchwartzInputDilation_apply, smul_smul]
  congr 1
  field_simp [hq]

/-- Positive dilation is an exact change of variables for the radial polar
power measure.  The factor is `q^(n+1)`, i.e. the full ambient-dimensional
Jacobian when `n = d - 1`. -/
theorem integral_volumeIoiPow_dilate
    (n : Nat) (F : Real → Complex) {q : Real} (hq : 0 < q) :
    (∫ s : Ioi (0 : Real), ((q ^ (n + 1) : Real) : Complex) * F (q * s.1)
      ∂Measure.volumeIoiPow n) =
      ∫ u : Ioi (0 : Real), F u.1 ∂Measure.volumeIoiPow n := by
  let G : Real → Complex := fun u => ((u ^ n : Real) : Complex) * F u
  have hchange := integral_comp_mul_left_Ioi G 0 hq
  simp only [mul_zero] at hchange
  calc
    (∫ s : Ioi (0 : Real), ((q ^ (n + 1) : Real) : Complex) * F (q * s.1)
      ∂Measure.volumeIoiPow n) =
        ∫ s in Ioi (0 : Real), ((s ^ n : Real) : Complex) *
          (((q ^ (n + 1) : Real) : Complex) * F (q * s)) :=
      Auto.Spherical.Auxiliary.integral_volumeIoiPow_eq_setIntegral
        n (fun s => ((q ^ (n + 1) : Real) : Complex) * F (q * s))
    _ = ∫ s in Ioi (0 : Real), q • G (q * s) := by
      apply setIntegral_congr_fun measurableSet_Ioi
      intro s hs
      dsimp only [G]
      rw [Complex.real_smul, mul_pow]
      push_cast
      ring
    _ = q • ∫ s in Ioi (0 : Real), G (q * s) := by
      rw [MeasureTheory.integral_smul]
    _ = q • (q⁻¹ • ∫ u in Ioi (0 : Real), G u) := by
      rw [hchange]
    _ = ∫ u in Ioi (0 : Real), G u := by
      rw [smul_smul, mul_inv_cancel₀ hq.ne', one_smul]
    _ = ∫ u in Ioi (0 : Real), ((u ^ n : Real) : Complex) * F u := by
      rfl
    _ = ∫ u : Ioi (0 : Real), F u.1 ∂Measure.volumeIoiPow n :=
      (Auto.Spherical.Auxiliary.integral_volumeIoiPow_eq_setIntegral n F).symm

/-- Exact dyadic scaling of the repository-normalized radial Bessel kernel.
The scalar factor is one power of the frequency scale (rather than the full
spatial Jacobian), because the remaining `q ^ (d - 1)` is already contained
in the polar source factor of the level-zero kernel. -/
theorem brrsRadialBesselKernel_eq_levelZero_scaled
    {d : Nat} (hd : 1 ≤ d) (Phi : BRRSAnnularCutoff) (j : Nat)
    (r s t : Real) (v : BRRSSpace d) (hv : ‖v‖ = 1) :
    brrsRadialBesselKernel Phi d v j r s t =
      ((2 : Real) ^ j) •
        brrsRadialBesselKernel Phi d v 0
          (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t) := by
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp [q]
    positivity
  change brrsRadialBesselKernel Phi d v j r s t =
    q • brrsRadialBesselKernel Phi d v 0 (q * r) (q * s) (q * t)
  let G : Real → Complex := fun rho =>
    surfaceFourier d (-rho • (r • v)) *
      (brrsDyadicHalfWaveSymbol Phi j t (rho • v) *
        surfaceFourier d (s • (rho • v)))
  let H : Real → Complex := fun u =>
    surfaceFourier d (-u • ((q * r) • v)) *
      (brrsDyadicHalfWaveSymbol Phi 0 (q * t) (u • v) *
        surfaceFourier d ((q * s) • (u • v)))
  have hsymbol (u : Real) :
      brrsDyadicHalfWaveSymbol Phi j t ((q * u) • v) =
        brrsDyadicHalfWaveSymbol Phi 0 (q * t) (u • v) := by
    rw [brrsDyadicHalfWaveSymbol_eq_levelZero_scaled_general Phi j t]
    dsimp [q]
    rw [smul_smul]
    congr 1
    field_simp [hq.ne']
  have hpoint (u : Real) : G (q * u) = H u := by
    dsimp [G, H]
    have houter : -(q * u) • (r • v) = -u • ((q * r) • v) := by
      module
    have hinner : s • ((q * u) • v) = (q * s) • (u • v) := by
      module
    rw [houter, hinner, hsymbol]
  have hscale :
      (∫ u : Ioi (0 : Real), ((q ^ d : Real) : Complex) * H u.1
        ∂Measure.volumeIoiPow (d - 1)) =
        ∫ rho : Ioi (0 : Real), G rho.1 ∂Measure.volumeIoiPow (d - 1) := by
    calc
      (∫ u : Ioi (0 : Real), ((q ^ d : Real) : Complex) * H u.1
        ∂Measure.volumeIoiPow (d - 1)) =
          ∫ u : Ioi (0 : Real), ((q ^ d : Real) : Complex) * G (q * u.1)
            ∂Measure.volumeIoiPow (d - 1) := by
              apply integral_congr_ae
              filter_upwards with u
              rw [hpoint]
      _ = ∫ rho : Ioi (0 : Real), G rho.1 ∂Measure.volumeIoiPow (d - 1) := by
        simpa only [Nat.sub_add_cancel hd] using
          (integral_volumeIoiPow_dilate (d - 1) G hq)
  have hKj :
      brrsRadialBesselKernel Phi d v j r s t =
        ((s ^ (d - 1) : Real) : Complex) *
          ∫ rho : Ioi (0 : Real), G rho.1 ∂Measure.volumeIoiPow (d - 1) := by
    simpa only [G] using
      (brrsRadialBesselKernel_eq_twoRadius_surfaceFourier Phi j t r s v hv)
  have hK0 :
      brrsRadialBesselKernel Phi d v 0 (q * r) (q * s) (q * t) =
        (((q * s) ^ (d - 1) : Real) : Complex) *
          ∫ u : Ioi (0 : Real), H u.1 ∂Measure.volumeIoiPow (d - 1) := by
    simpa only [H] using
      (brrsRadialBesselKernel_eq_twoRadius_surfaceFourier
        Phi 0 (q * t) (q * r) (q * s) v hv)
  calc
    brrsRadialBesselKernel Phi d v j r s t =
        ((s ^ (d - 1) : Real) : Complex) *
          ∫ rho : Ioi (0 : Real), G rho.1 ∂Measure.volumeIoiPow (d - 1) := hKj
    _ = ((s ^ (d - 1) : Real) : Complex) *
          ∫ u : Ioi (0 : Real), ((q ^ d : Real) : Complex) * H u.1
            ∂Measure.volumeIoiPow (d - 1) := by rw [hscale]
    _ = ((s ^ (d - 1) : Real) : Complex) *
          (((q ^ d : Real) : Complex) *
            ∫ u : Ioi (0 : Real), H u.1 ∂Measure.volumeIoiPow (d - 1)) := by
              rw [MeasureTheory.integral_const_mul]
    _ = q • ((((q * s) ^ (d - 1) : Real) : Complex) *
          ∫ u : Ioi (0 : Real), H u.1 ∂Measure.volumeIoiPow (d - 1)) := by
      rw [Complex.real_smul]
      have hpow : q ^ d = q * q ^ (d - 1) := by
        calc
          q ^ d = q ^ (d - 1 + 1) := by rw [Nat.sub_add_cancel hd]
          _ = q ^ (d - 1) * q := by rw [pow_succ]
          _ = q * q ^ (d - 1) := by ring
      rw [mul_pow, hpow]
      push_cast
      ring
    _ = q • brrsRadialBesselKernel Phi d v 0 (q * r) (q * s) (q * t) := by
      rw [hK0]

/-- Exact source-variable scaling of the literal BRRS half-wave.  This form
uses the actual level-zero source kernel and the genuinely dilated Schwartz
datum, but does not yet replace the latter by a stationary majorant. -/
theorem brrsDyadicHalfWave_eq_scaled_levelZero_sourceKernelIntegral
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f : BRRSSchwartz d) (x : BRRSSpace d) :
    brrsDyadicHalfWave Phi j t f x =
      ∫ z : BRRSSpace d,
        brrsDyadicHalfWaveSourceKernel Phi 0 ((2 : Real) ^ j * t)
          ((2 : Real) ^ j • x) z *
          f (((2 : Real) ^ j)⁻¹ • z) := by
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  change brrsDyadicHalfWave Phi j t f x =
    ∫ z : BRRSSpace d,
      brrsDyadicHalfWaveSourceKernel Phi 0 (q * t) (q • x) z *
        f (q⁻¹ • z)
  rw [brrsDyadicHalfWave_eq_sourceKernel]
  let F : BRRSSpace d → Complex := fun z =>
    brrsDyadicHalfWaveSourceKernel Phi 0 (q * t) (q • x) z * f (q⁻¹ • z)
  have hpoint : (fun y : BRRSSpace d =>
      brrsDyadicHalfWaveSourceKernel Phi j t x y * f y) =
      fun y => q ^ d • F (q • y) := by
    funext y
    rw [brrsDyadicHalfWaveSourceKernel_eq_levelZero_scaled_general]
    dsimp only [F, q]
    rw [smul_smul, inv_mul_cancel₀ hq.ne', one_smul]
    simp only [Complex.real_smul]
    ring
  rw [hpoint, MeasureTheory.integral_smul]
  rw [show (∫ y : BRRSSpace d, F (q • y)) =
      (q ^ d)⁻¹ • ∫ z : BRRSSpace d, F z by
        simpa only [finrank_euclideanSpace_fin] using
          (Measure.integral_comp_smul_of_nonneg volume F q (hR := hq.le))]
  change q ^ d • ((q ^ d)⁻¹ • ∫ z : BRRSSpace d, F z) = _
  rw [smul_smul, mul_inv_cancel₀ (pow_ne_zero d hq.ne'), one_smul]

/-- Exact reduction of a dyadic BRRS half-wave to a level-zero half-wave on
the genuinely rescaled Schwartz datum.  This is an operator identity, not a
stationary-phase majorization. -/
theorem brrsDyadicHalfWave_eq_levelZero_scaledInput
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f : BRRSSchwartz d) (x : BRRSSpace d) :
    brrsDyadicHalfWave Phi j t f x =
      brrsDyadicHalfWave Phi 0 ((2 : Real) ^ j * t)
        (brrsSchwartzInputDilation ((2 : Real) ^ j)
          (pow_ne_zero j (by norm_num)) f)
        ((2 : Real) ^ j • x) := by
  rw [brrsDyadicHalfWave_eq_scaled_levelZero_sourceKernelIntegral]
  rw [brrsDyadicHalfWave_eq_sourceKernel]
  apply integral_congr_ae
  filter_upwards with z
  rw [brrsSchwartzInputDilation_apply]

/-- Exact polar source-kernel representation on a radial Schwartz input.
The angular variable is retained rather than silently replaced by a Bessel
function; consequently this identity is valid in every positive dimension
and makes no unproved two-radius estimate. -/
theorem brrsDyadicHalfWave_eq_radial_polar_sourceKernel
    {d : Nat} (hd : 0 < d) (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d → Complex))
    (w : BRRSSpace d) (hw : ‖w‖ = 1) (x : BRRSSpace d) :
    brrsDyadicHalfWave Phi j t f x =
      ∫ p : Metric.sphere (0 : BRRSSpace d) 1 × Ioi (0 : Real),
        brrsDyadicHalfWaveSourceKernel Phi j t x (p.2.1 • (p.1 : BRRSSpace d)) *
          f (p.2.1 • w)
          ∂((unitSurfaceMeasure d).prod (Measure.volumeIoiPow (d - 1))) := by
  rw [brrsDyadicHalfWave_eq_sourceKernel]
  rw [Auto.RadialFourierTransform.integral_polar_unitSurfaceMeasure hd]
  apply integral_congr_ae
  filter_upwards with p
  have hp : ‖(p.1 : BRRSSpace d)‖ = 1 := by
    simpa only [mem_sphere_zero_iff_norm] using p.1.property
  have hs : 0 < p.2.1 := p.2.property
  have hnorm : ‖p.2.1 • (p.1 : BRRSSpace d)‖ = ‖p.2.1 • w‖ := by
    simp [norm_smul, Real.norm_eq_abs, abs_of_pos hs, hp, hw]
  rw [hf _ _ hnorm]

/-- The sign of the linear radial carrier of a stationary surface wave. -/
def brrsSurfaceWaveSign : BRRSSurfaceWavePart → Real
  | .outgoing => -1
  | .incoming => 1
  | .middle => 0

theorem brrsSurfaceWavePhase_eq_two_pi_mul_sign
    (part : BRRSSurfaceWavePart) (a : Real) :
    brrsSurfaceWavePhase part a =
      2 * Real.pi * (brrsSurfaceWaveSign part * a) := by
  cases part <;> simp [brrsSurfaceWavePhase, brrsSurfaceWaveSign]

/-- The combined frequency of two stationary surface waves and a half-wave
is the four-sign radial frequency `2π(t ± r ± s)` at the endpoint waves. -/
theorem brrs_twoRadius_stationary_frequency_eq
    (partR partS : BRRSSurfaceWavePart) (r s t : Real) :
    brrsSurfaceWavePhase partR r + brrsSurfaceWavePhase partS s + 2 * Real.pi * t =
      2 * Real.pi * (t + brrsSurfaceWaveSign partR * r +
        brrsSurfaceWaveSign partS * s) := by
  rw [brrsSurfaceWavePhase_eq_two_pi_mul_sign,
    brrsSurfaceWavePhase_eq_two_pi_mul_sign]
  ring

/-- The compact frequency coefficient attached to two literal stationary
surface-wave factors. -/
noncomputable def brrsTwoRadiusStationaryCoefficient
    (Phi : BRRSAnnularCutoff) (d : Nat)
    (partR partS : BRRSSurfaceWavePart) (r s rho : Real) : Complex :=
  ((rho ^ (d - 1) : Real) : Complex) *
    (brrsSurfaceWaveAmplitude d partR r rho *
      (brrsSurfaceWaveAmplitude d partS s rho * Phi.symbol (2 * Real.pi * rho)))

/-- One literal two-radius stationary component at level zero.  The four
terms with `partR, partS ∈ {outgoing, incoming}` are the main Bessel-product
terms; components involving `middle` are remainders. -/
noncomputable def brrsTwoRadiusStationaryComponentIntegral
    (Phi : BRRSAnnularCutoff) (d : Nat)
    (partR partS : BRRSSurfaceWavePart) (r s t : Real) : Complex :=
  ∫ rho in (1 / 32 : Real)..1,
    ((rho ^ (d - 1) : Real) : Complex) *
      (brrsSurfaceWaveTerm d partR r rho *
        (brrsSurfaceWaveTerm d partS s rho *
          brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho))

/-- The literal two-radius stationary component is symmetric in its two
radial variables.  This lets a mixed middle/endpoint estimate always place
the rapidly decaying middle factor in the first slot. -/
theorem brrsTwoRadiusStationaryComponentIntegral_swap
    (Phi : BRRSAnnularCutoff) (d : Nat)
    (partR partS : BRRSSurfaceWavePart) (r s t : Real) :
    brrsTwoRadiusStationaryComponentIntegral Phi d partR partS r s t =
      brrsTwoRadiusStationaryComponentIntegral Phi d partS partR s r t := by
  unfold brrsTwoRadiusStationaryComponentIntegral
  apply intervalIntegral.integral_congr
  intro rho _
  ring

/-- Exact oscillatory-integral normal form for a two-radius stationary
component. -/
theorem brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp
    (Phi : BRRSAnnularCutoff) (d : Nat)
    (partR partS : BRRSSurfaceWavePart) (r s t : Real) :
    brrsTwoRadiusStationaryComponentIntegral Phi d partR partS r s t =
      ∫ rho in (1 / 32 : Real)..1,
        brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
          oscillatoryExp
            (brrsSurfaceWavePhase partR r + brrsSurfaceWavePhase partS s +
              2 * Real.pi * t) rho := by
  unfold brrsTwoRadiusStationaryComponentIntegral
    brrsTwoRadiusStationaryCoefficient
  apply intervalIntegral.integral_congr
  intro rho _
  unfold brrsSurfaceWaveTerm brrsDyadicHalfWaveKernelRadialProfile oscillatoryExp
  simp only [pow_zero, inv_one, mul_one]
  let zR : Complex :=
    ((brrsSurfaceWavePhase partR r * rho : Real) : Complex) * Complex.I
  let zS : Complex :=
    ((brrsSurfaceWavePhase partS s * rho : Real) : Complex) * Complex.I
  let zT : Complex := ((2 * Real.pi * t * rho : Real) : Complex) * Complex.I
  let z : Complex :=
    (( (brrsSurfaceWavePhase partR r + brrsSurfaceWavePhase partS s +
      2 * Real.pi * t) * rho : Real) : Complex) * Complex.I
  have hz : zR + zS + zT = z := by
    dsimp only [zR, zS, zT, z]
    push_cast
    ring
  change
    ((rho ^ (d - 1) : Real) : Complex) *
        ((brrsSurfaceWaveAmplitude d partR r rho * Complex.exp zR) *
          ((brrsSurfaceWaveAmplitude d partS s rho * Complex.exp zS) *
            (Complex.exp zT * Phi.symbol (2 * Real.pi * rho)))) =
      ((rho ^ (d - 1) : Real) : Complex) *
        (brrsSurfaceWaveAmplitude d partR r rho *
          (brrsSurfaceWaveAmplitude d partS s rho * Phi.symbol (2 * Real.pi * rho))) *
            Complex.exp z
  calc
    ((rho ^ (d - 1) : Real) : Complex) *
        ((brrsSurfaceWaveAmplitude d partR r rho * Complex.exp zR) *
          ((brrsSurfaceWaveAmplitude d partS s rho * Complex.exp zS) *
            (Complex.exp zT * Phi.symbol (2 * Real.pi * rho)))) =
      ((rho ^ (d - 1) : Real) : Complex) *
        (brrsSurfaceWaveAmplitude d partR r rho *
          (brrsSurfaceWaveAmplitude d partS s rho * Phi.symbol (2 * Real.pi * rho))) *
            (Complex.exp zR * Complex.exp zS * Complex.exp zT) := by
      ring
    _ = ((rho ^ (d - 1) : Real) : Complex) *
        (brrsSurfaceWaveAmplitude d partR r rho *
          (brrsSurfaceWaveAmplitude d partS s rho * Phi.symbol (2 * Real.pi * rho))) *
            Complex.exp (zR + zS + zT) := by
      rw [← Complex.exp_add, ← Complex.exp_add]
    _ = ((rho ^ (d - 1) : Real) : Complex) *
        (brrsSurfaceWaveAmplitude d partR r rho *
          (brrsSurfaceWaveAmplitude d partS s rho * Phi.symbol (2 * Real.pi * rho))) *
            Complex.exp z := by rw [hz]

/-- The sum of the four endpoint/end-point two-radius components.  This is
the main term that produces the four profiles `t-r-s`, `t-r+s`, `t+r-s`, and
`t+r+s` in the BRRS radial-kernel argument. -/
noncomputable def brrsTwoRadiusEndpointIntegralSum
    (Phi : BRRSAnnularCutoff) (d : Nat) (r s t : Real) : Complex :=
  brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .outgoing r s t +
    brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .incoming r s t +
      brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .outgoing r s t +
        brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .incoming r s t

/-- The endpoint/end-point two-radius contribution is exactly a sum of the
four signed translated oscillatory integrals. -/
theorem brrsTwoRadiusEndpointIntegralSum_eq_four_phase_integrals
    (Phi : BRRSAnnularCutoff) (d : Nat) (r s t : Real) :
    brrsTwoRadiusEndpointIntegralSum Phi d r s t =
      (∫ rho in (1 / 32 : Real)..1,
        brrsTwoRadiusStationaryCoefficient Phi d .outgoing .outgoing r s rho *
          oscillatoryExp (2 * Real.pi * (t - r - s)) rho) +
        (∫ rho in (1 / 32 : Real)..1,
          brrsTwoRadiusStationaryCoefficient Phi d .outgoing .incoming r s rho *
            oscillatoryExp (2 * Real.pi * (t - r + s)) rho) +
          (∫ rho in (1 / 32 : Real)..1,
            brrsTwoRadiusStationaryCoefficient Phi d .incoming .outgoing r s rho *
              oscillatoryExp (2 * Real.pi * (t + r - s)) rho) +
            ∫ rho in (1 / 32 : Real)..1,
              brrsTwoRadiusStationaryCoefficient Phi d .incoming .incoming r s rho *
                oscillatoryExp (2 * Real.pi * (t + r + s)) rho := by
  unfold brrsTwoRadiusEndpointIntegralSum
  rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp,
    brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp,
    brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp,
    brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
  simp only [brrs_twoRadius_stationary_frequency_eq, brrsSurfaceWaveSign]
  congr 1 <;> ring

/-- The level-zero scalar cutoff vanishes below its literal lower annular
threshold. -/
private theorem brrs_levelZeroCutoff_eq_zero_of_le_lower
    (Phi : BRRSAnnularCutoff) {rho : Real}
    (hrho : rho ≤ (8 * Real.pi)⁻¹) :
    Phi.symbol (2 * Real.pi * rho) = 0 := by
  by_contra hne
  have hsupport : 2 * Real.pi * rho ∈ Ioo (1 / 4 : Real) 4 := by
    apply Phi.tsupport_subset
    exact subset_tsupport _ (Function.mem_support.mpr hne)
  have hpi : 0 < 8 * Real.pi := by positivity
  have hupper : 2 * Real.pi * rho ≤ 1 / 4 := by
    calc
      2 * Real.pi * rho ≤ 2 * Real.pi * (8 * Real.pi)⁻¹ :=
        mul_le_mul_of_nonneg_left hrho (by positivity)
      _ = 1 / 4 := by
        field_simp [hpi.ne']
        norm_num
  exact (not_lt_of_ge hupper) hsupport.1

/-- The level-zero scalar cutoff vanishes above its literal upper annular
threshold. -/
private theorem brrs_levelZeroCutoff_eq_zero_of_le_upper
    (Phi : BRRSAnnularCutoff) {rho : Real}
    (hrho : (2 / Real.pi) ≤ rho) :
    Phi.symbol (2 * Real.pi * rho) = 0 := by
  by_contra hne
  have hsupport : 2 * Real.pi * rho ∈ Ioo (1 / 4 : Real) 4 := by
    apply Phi.tsupport_subset
    exact subset_tsupport _ (Function.mem_support.mpr hne)
  have hpi : 0 < Real.pi := Real.pi_pos
  have hlower : 4 ≤ 2 * Real.pi * rho := by
    calc
      4 = 2 * Real.pi * (2 / Real.pi) := by
        field_simp [hpi.ne']
        norm_num
      _ ≤ 2 * Real.pi * rho := mul_le_mul_of_nonneg_left hrho (by positivity)
  exact (not_lt_of_ge hlower) hsupport.2

/-- The compact level-zero radial profile vanishes in a neighbourhood of the
left endpoint of the integration interval. -/
theorem brrsDyadicHalfWaveKernelRadialProfile_eventuallyEq_zero_at_lower_levelZero
    (Phi : BRRSAnnularCutoff) (t : Real) :
    brrsDyadicHalfWaveKernelRadialProfile Phi 0 t =ᶠ[nhds (1 / 32 : Real)] 0 := by
  have hpi : 0 < 8 * Real.pi := by positivity
  have hgap : (1 / 32 : Real) < (8 * Real.pi)⁻¹ := by
    have h : (1 / 32 : Real) < 1 / (8 * Real.pi) :=
      (lt_div_iff₀ hpi).mpr (by nlinarith [Real.pi_lt_four])
    simpa using h
  let eps : Real := (8 * Real.pi)⁻¹ - (1 / 32 : Real)
  have heps : 0 < eps := by
    dsimp [eps]
    linarith
  filter_upwards [Metric.ball_mem_nhds (1 / 32 : Real) heps] with rho hrho
  change brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho = 0
  have hrho' : rho - (1 / 32 : Real) < eps := by
    rw [Metric.mem_ball, Real.dist_eq, abs_lt] at hrho
    exact hrho.2
  have hle : rho ≤ (8 * Real.pi)⁻¹ := by
    dsimp [eps] at hrho'
    linarith
  unfold brrsDyadicHalfWaveKernelRadialProfile
  simp only [pow_zero, inv_one, mul_one,
    brrs_levelZeroCutoff_eq_zero_of_le_lower Phi hle, mul_zero]

/-- The compact level-zero radial profile vanishes in a neighbourhood of the
right endpoint of the integration interval. -/
theorem brrsDyadicHalfWaveKernelRadialProfile_eventuallyEq_zero_at_upper_levelZero
    (Phi : BRRSAnnularCutoff) (t : Real) :
    brrsDyadicHalfWaveKernelRadialProfile Phi 0 t =ᶠ[nhds (1 : Real)] 0 := by
  have hpi : 0 < Real.pi := Real.pi_pos
  have hgap : 2 / Real.pi < (1 : Real) := by
    rw [div_lt_iff₀ hpi]
    linarith [Real.pi_gt_three]
  let eps : Real := 1 - 2 / Real.pi
  have heps : 0 < eps := by
    dsimp [eps]
    linarith
  filter_upwards [Metric.ball_mem_nhds (1 : Real) heps] with rho hrho
  change brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho = 0
  have hrho' : -eps < rho - 1 := by
    rw [Metric.mem_ball, Real.dist_eq, abs_lt] at hrho
    exact hrho.1
  have hle : 2 / Real.pi ≤ rho := by
    dsimp [eps] at hrho'
    linarith
  unfold brrsDyadicHalfWaveKernelRadialProfile
  simp only [pow_zero, inv_one, mul_one,
    brrs_levelZeroCutoff_eq_zero_of_le_upper Phi hle, mul_zero]

/-- The compact coefficient left after extracting the combined linear radial
phase from one BRRS stationary wave. -/
def brrsStationaryWaveRadialCoefficient
    (Phi : BRRSAnnularCutoff) (d : Nat) (part : BRRSSurfaceWavePart)
    (a rho : Real) : Complex :=
  ((rho ^ (d - 1) : Real) : Complex) *
    brrsSurfaceWaveAmplitude d part a rho * Phi.symbol (2 * Real.pi * rho)

/-- Each literal BRRS stationary amplitude is globally smooth in its radial
frequency variable. -/
theorem contDiff_brrsSurfaceWaveAmplitude
    (d : Nat) (part : BRRSSurfaceWavePart) (a : Real) :
    ContDiff Real (⊤ : ENat) (fun rho : Real =>
      brrsSurfaceWaveAmplitude d part a rho) := by
  cases part with
  | outgoing =>
      unfold brrsSurfaceWaveAmplitude
      exact contDiff_const.mul
        ((contDiff_smoothEndpointQuadraticIntegral (d - 2)).comp (by fun_prop))
  | incoming =>
      unfold brrsSurfaceWaveAmplitude
      exact contDiff_const.mul
        ((contDiff_smoothEndpointQuadraticIntegral (d - 2)).comp (by fun_prop))
  | middle =>
      unfold brrsSurfaceWaveAmplitude
      exact contDiff_const.mul
        ((contDiff_coordinateMiddleMeridianLocalizedIntegral (d - 2)).comp
          (by fun_prop))

/-- The BRRS stationary coefficient is a compact smooth radial symbol. -/
theorem contDiff_brrsStationaryWaveRadialCoefficient
    (Phi : BRRSAnnularCutoff) (d : Nat) (part : BRRSSurfaceWavePart)
    (a : Real) :
    ContDiff Real (⊤ : ENat)
      (fun rho : Real => brrsStationaryWaveRadialCoefficient Phi d part a rho) := by
  unfold brrsStationaryWaveRadialCoefficient
  have hpow : ContDiff Real (⊤ : ENat) (fun rho : Real =>
      ((rho ^ (d - 1) : Real) : Complex)) :=
    Complex.ofRealCLM.contDiff.comp (contDiff_id.pow (d - 1))
  exact (hpow.mul (contDiff_brrsSurfaceWaveAmplitude d part a)).mul
    ((Phi.symbol.smooth (⊤ : ENat)).comp (by fun_prop))

/-- The scalar coefficient extracted from a BRRS stationary wave has no
boundary terms at the lower endpoint of the compact radial interval. -/
theorem brrsStationaryWaveRadialCoefficient_eventuallyEq_zero_at_lower
    (Phi : BRRSAnnularCutoff) (d : Nat) (part : BRRSSurfaceWavePart)
    (a : Real) :
    brrsStationaryWaveRadialCoefficient Phi d part a =ᶠ[nhds (1 / 32 : Real)] 0 := by
  filter_upwards [brrsDyadicHalfWaveKernelRadialProfile_eventuallyEq_zero_at_lower_levelZero
    Phi 0] with rho hrho
  unfold brrsStationaryWaveRadialCoefficient at *
  unfold brrsDyadicHalfWaveKernelRadialProfile at hrho
  simp only [pow_zero, inv_one, mul_one] at hrho
  by_cases hcut : Phi.symbol (2 * Real.pi * rho) = 0
  · simp [hcut]
  · have hexp : Complex.exp (((2 * Real.pi * (0 : Real) * rho : Real) : Complex) *
        Complex.I) ≠ 0 := Complex.exp_ne_zero _
    exfalso
    apply hcut
    simpa [hexp] using hrho

/-- The scalar coefficient extracted from a BRRS stationary wave has no
boundary terms at the upper endpoint of the compact radial interval. -/
theorem brrsStationaryWaveRadialCoefficient_eventuallyEq_zero_at_upper
    (Phi : BRRSAnnularCutoff) (d : Nat) (part : BRRSSurfaceWavePart)
    (a : Real) :
    brrsStationaryWaveRadialCoefficient Phi d part a =ᶠ[nhds (1 : Real)] 0 := by
  filter_upwards [brrsDyadicHalfWaveKernelRadialProfile_eventuallyEq_zero_at_upper_levelZero
    Phi 0] with rho hrho
  unfold brrsStationaryWaveRadialCoefficient at *
  unfold brrsDyadicHalfWaveKernelRadialProfile at hrho
  simp only [pow_zero, inv_one, mul_one] at hrho
  by_cases hcut : Phi.symbol (2 * Real.pi * rho) = 0
  · simp [hcut]
  · have hexp : Complex.exp (((2 * Real.pi * (0 : Real) * rho : Real) : Complex) *
        Complex.I) ≠ 0 := Complex.exp_ne_zero _
    exfalso
    apply hcut
    simpa [hexp] using hrho

/-- The exact compact scalar integral for one BRRS stationary-wave component.
The oscillatory factor has the physically correct frequency
`phase(part,a) + 2πt`. -/
theorem intervalIntegral_brrsStationaryWaveComponent_eq_oscillatoryExp
    (Phi : BRRSAnnularCutoff) (d : Nat) (part : BRRSSurfaceWavePart)
    (a t : Real) :
    (∫ rho in (1 / 32 : Real)..1,
      ((rho ^ (d - 1) : Real) : Complex) *
        (brrsSurfaceWaveTerm d part a rho *
          brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho)) =
      ∫ rho in (1 / 32 : Real)..1,
        brrsStationaryWaveRadialCoefficient Phi d part a rho *
          oscillatoryExp (brrsSurfaceWavePhase part a + 2 * Real.pi * t) rho := by
  apply intervalIntegral.integral_congr
  intro rho _
  change ((rho ^ (d - 1) : Real) : Complex) *
      (brrsSurfaceWaveTerm d part a rho *
        brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho) =
    brrsStationaryWaveRadialCoefficient Phi d part a rho *
      oscillatoryExp (brrsSurfaceWavePhase part a + 2 * Real.pi * t) rho
  rw [brrsSurfaceWaveTerm_mul_levelZeroProfile_eq_oscillatoryExp]
  unfold brrsStationaryWaveRadialCoefficient
  ring

/-- After extracting the literal stationary carrier, every BRRS wave
component has arbitrary compact nonstationary decay away from its corresponding
cone.  The positive constant is allowed to depend on the physical radius;
the preceding all-order amplitude estimates supply the uniform refinement used
in the cone-shell argument. -/
theorem exists_norm_intervalIntegral_brrsStatWaveRadialCoeff_mul_oscillatoryExp_le
    (Phi : BRRSAnnularCutoff) (d : Nat) (part : BRRSSurfaceWavePart)
    (a : Real) {freq : Real} (hfreq : freq ≠ 0) (N : Nat) :
    ∃ M : Real, 0 < M ∧
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsStationaryWaveRadialCoefficient Phi d part a rho *
          oscillatoryExp freq rho‖ ≤
        (1 / |freq|) ^ N * ((1 - (1 / 32 : Real)) * M) := by
  exact exists_norm_intervalIntegral_mul_oscillatoryExp_le_iterated_of_contDiff
    (brrsStationaryWaveRadialCoefficient Phi d part a)
    (by norm_num) hfreq
    (contDiff_brrsStationaryWaveRadialCoefficient Phi d part a)
    (brrsStationaryWaveRadialCoefficient_eventuallyEq_zero_at_lower Phi d part a)
    (brrsStationaryWaveRadialCoefficient_eventuallyEq_zero_at_upper Phi d part a) N

/-! ### Uniform high-radius stationary symbols

The preceding integration-by-parts theorem is deliberately pointwise in the
physical radius.  To use it in the fixed-time kernel estimate, the stationary
constants must be uniform on the compact frequency annulus.  The following
small calculus layer supplies exactly that fact, without importing the AHRS
maximal-function development.
-/

/-- The finite constant in the one-dimensional Leibniz rule used by the BRRS
stationary coefficient. -/
def brrsStationaryLeibnizConstant (n : Nat) (A B : Real) : Real :=
  ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) * A * B

theorem brrsStationaryLeibnizConstant_nonneg
    (n : Nat) {A B : Real} (hA : 0 ≤ A) (hB : 0 ≤ B) :
    0 ≤ brrsStationaryLeibnizConstant n A B := by
  unfold brrsStationaryLeibnizConstant
  apply Finset.sum_nonneg
  intro i hi
  positivity

/-- A finite-order product rule with all constants explicit.  This is kept
generic so that it can also be used by the radial BRRS kernel normal form. -/
theorem norm_iteratedDeriv_mul_le_brrsStationaryLeibnizConstant
    {n : Nat} {f g : Real → Complex} {x : Real} {A B : Real}
    (hf : ContDiff Real (⊤ : ℕ∞) f)
    (hg : ContDiff Real (⊤ : ℕ∞) g)
    (hA : 0 ≤ A) (_hB : 0 ≤ B)
    (hfa : ∀ k : Nat, k ≤ n → ‖iteratedDeriv k f x‖ ≤ A)
    (hgb : ∀ k : Nat, k ≤ n → ‖iteratedDeriv k g x‖ ≤ B) :
    ‖iteratedDeriv n (fun u : Real => f u * g u) x‖ ≤
      brrsStationaryLeibnizConstant n A B := by
  have hmulfun : (fun u : Real => f u * g u) = f * g := rfl
  have hcast : ((n : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by
    exact_mod_cast (le_top : (n : ℕ∞) ≤ ⊤)
  rw [hmulfun, iteratedDeriv_mul (hf.contDiffAt.of_le hcast)
    (hg.contDiffAt.of_le hcast)]
  calc
    ‖∑ i ∈ Finset.range (n + 1),
        n.choose i * iteratedDeriv i f x * iteratedDeriv (n - i) g x‖ ≤
        ∑ i ∈ Finset.range (n + 1),
          ‖n.choose i * iteratedDeriv i f x * iteratedDeriv (n - i) g x‖ :=
      norm_sum_le _ _
    _ ≤ ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) * A * B := by
      apply Finset.sum_le_sum
      intro i hi
      have hi' : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      have hleft := hfa i hi'
      have hright := hgb (n - i) (Nat.sub_le _ _)
      have hc : (0 : Real) ≤ ((n.choose i : Nat) : Real) := Nat.cast_nonneg _
      rw [norm_mul, norm_mul, norm_natCast]
      simpa [mul_assoc] using
        mul_le_mul_of_nonneg_left (mul_le_mul hleft hright (norm_nonneg _) hA) hc
    _ = brrsStationaryLeibnizConstant n A B := rfl

/-- The stationary endpoint denominator at a large physical radius controls
the precise half-dimensional decay.  The scale `a / 16` is chosen solely to
fit the literal BRRS annulus `[1 / 32, 1]`. -/
theorem brrs_endpoint_stationary_denominator_le_scale
    {d k : Nat} {s a lambda C L : Real}
    (hd : 2 ≤ d) (hs : 1 ≤ s) (hC : 0 ≤ C) (hL : 0 ≤ L)
    (ha : |a| ≤ L * s) (hlambda : 0 < lambda)
    (hsqrt : Real.sqrt s ≤ Real.sqrt lambda) :
    C * |a| ^ k / quadraticMomentScale (d - 2 + 2 * k) lambda ≤
      (C * L ^ k) / (Real.sqrt s) ^ (d - 1) := by
  have hs0 : 0 ≤ s := zero_le_one.trans hs
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hsqrtpos : 0 < Real.sqrt s := Real.sqrt_pos.2 hspos
  have hlambdasqrtpos : 0 < Real.sqrt lambda := Real.sqrt_pos.2 hlambda
  have hpowden : (Real.sqrt s) ^ (d - 1 + 2 * k) ≤
      (Real.sqrt lambda) ^ (d - 1 + 2 * k) :=
    pow_le_pow_left₀ (Real.sqrt_nonneg _) hsqrt _
  have hnum : C * |a| ^ k ≤ C * (L * s) ^ k := by
    apply mul_le_mul_of_nonneg_left
    · exact pow_le_pow_left₀ (abs_nonneg _) ha _
    · exact hC
  have hdenpos : 0 < (Real.sqrt s) ^ (d - 1 + 2 * k) :=
    pow_pos hsqrtpos _
  have hlambdadenpos : 0 < (Real.sqrt lambda) ^ (d - 1 + 2 * k) :=
    pow_pos hlambdasqrtpos _
  have hquot : C * |a| ^ k / (Real.sqrt lambda) ^ (d - 1 + 2 * k) ≤
      C * (L * s) ^ k / (Real.sqrt s) ^ (d - 1 + 2 * k) := by
    calc
      C * |a| ^ k / (Real.sqrt lambda) ^ (d - 1 + 2 * k) ≤
          C * (L * s) ^ k / (Real.sqrt lambda) ^ (d - 1 + 2 * k) :=
        div_le_div_of_nonneg_right hnum hlambdadenpos.le
      _ ≤ C * (L * s) ^ k / (Real.sqrt s) ^ (d - 1 + 2 * k) :=
        div_le_div_of_nonneg_left
          (mul_nonneg hC (pow_nonneg (mul_nonneg hL hs0) _)) hdenpos hpowden
  have hrewrite : quadraticMomentScale (d - 2 + 2 * k) lambda =
      (Real.sqrt lambda) ^ (d - 1 + 2 * k) := by
    unfold quadraticMomentScale
    congr 1
    omega
  rw [hrewrite]
  calc
    C * |a| ^ k / (Real.sqrt lambda) ^ (d - 1 + 2 * k) ≤
        C * (L * s) ^ k / (Real.sqrt s) ^ (d - 1 + 2 * k) := hquot
    _ = (C * L ^ k) / (Real.sqrt s) ^ (d - 1) := by
      rw [mul_pow, show d - 1 + 2 * k = (d - 1) + (2 * k) by omega,
        pow_add, pow_mul, Real.sq_sqrt hs0]
      field_simp [hsqrtpos.ne', hspos.ne']

/-- The rapidly decaying middle wave has the same coarse high-radius scale
as either endpoint wave. -/
theorem brrs_rapid_middle_denominator_le_scale
    {d k : Nat} {s a lambda C L : Real}
    (hd : 2 ≤ d) (hs : 1 ≤ s) (hC : 0 ≤ C) (hL : 0 ≤ L)
    (ha : |a| ≤ L * s) (hlambda : s ≤ lambda) :
    C * |a| ^ k / lambda ^ (d + k) ≤
      (C * L ^ k) / (Real.sqrt s) ^ (d - 1) := by
  have hs0 : 0 ≤ s := zero_le_one.trans hs
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hlambdapos : 0 < lambda := lt_of_lt_of_le hspos hlambda
  have hnum : C * |a| ^ k ≤ C * (L * s) ^ k := by
    apply mul_le_mul_of_nonneg_left
    · exact pow_le_pow_left₀ (abs_nonneg _) ha _
    · exact hC
  have hden : s ^ (d + k) ≤ lambda ^ (d + k) :=
    pow_le_pow_left₀ hs0 hlambda _
  have hsdenpos : 0 < s ^ (d + k) := pow_pos hspos _
  have hlambdadenpos : 0 < lambda ^ (d + k) := pow_pos hlambdapos _
  have hquot : C * |a| ^ k / lambda ^ (d + k) ≤
      C * (L * s) ^ k / s ^ (d + k) := by
    calc
      C * |a| ^ k / lambda ^ (d + k) ≤ C * (L * s) ^ k / lambda ^ (d + k) :=
        div_le_div_of_nonneg_right hnum hlambdadenpos.le
      _ ≤ C * (L * s) ^ k / s ^ (d + k) :=
        div_le_div_of_nonneg_left
          (mul_nonneg hC (pow_nonneg (mul_nonneg hL hs0) _)) hsdenpos hden
  have hsqrts : Real.sqrt s ≤ s := (Real.sqrt_le_self_iff).2 (Or.inr hs)
  have hrootpow : (Real.sqrt s) ^ (d - 1) ≤ s ^ (d - 1) :=
    pow_le_pow_left₀ (Real.sqrt_nonneg _) hsqrts _
  have hsd : s ^ (d - 1) ≤ s ^ d := by
    calc
      s ^ (d - 1) = s ^ (d - 1) * 1 := by ring
      _ ≤ s ^ (d - 1) * s := mul_le_mul_of_nonneg_left hs (pow_nonneg hs0 _)
      _ = s ^ d := by
        rw [← pow_succ]
        congr 1
        omega
  have hrootden : (Real.sqrt s) ^ (d - 1) ≤ s ^ d := hrootpow.trans hsd
  have hrootpos : 0 < (Real.sqrt s) ^ (d - 1) :=
    pow_pos (Real.sqrt_pos.2 hspos) _
  calc
    C * |a| ^ k / lambda ^ (d + k) ≤ C * (L * s) ^ k / s ^ (d + k) := hquot
    _ = (C * L ^ k) / s ^ d := by
      rw [mul_pow, show d + k = k + d by omega, pow_add]
      field_simp [hspos.ne']
    _ ≤ (C * L ^ k) / (Real.sqrt s) ^ (d - 1) := by
      apply div_le_div_of_nonneg_left
      · exact mul_nonneg hC (pow_nonneg hL _)
      · exact hrootpos
      · exact hrootden

/-- Numerical geometry of the literal level-zero annulus at a physical
radius at least `16`. -/
theorem brrs_highRadius_frequency_geometry
    {a rho : Real} (ha : 16 ≤ a) (hrho : rho ∈ Icc (1 / 32 : Real) 1) :
    1 ≤ |(2 * Real.pi * a) * rho| ∧
      |2 * Real.pi * a| ≤ 128 * (a / 16) ∧
      a / 16 ≤ |(2 * Real.pi * a) * rho| ∧
      Real.sqrt (a / 16) ≤ Real.sqrt |(2 * Real.pi * a) * rho| := by
  have ha0 : 0 ≤ a := by linarith
  have hapos : 0 < a := by linarith
  have hrhopos : 0 < rho := by linarith [hrho.1]
  have htwopi_lower : 6 ≤ 2 * Real.pi := by nlinarith [Real.pi_gt_three]
  have htwopi_upper : 2 * Real.pi ≤ 8 := by nlinarith [Real.pi_lt_four]
  have hrawpos : 0 < (2 * Real.pi * a) * rho := by positivity
  have hscale : 1 ≤ a / 16 := by linarith
  have hfreq_ge_scale : a / 16 ≤ (2 * Real.pi * a) * rho := by
    calc
      a / 16 = a * (1 / 16 : Real) := by ring
      _ ≤ a * ((2 * Real.pi) * rho) := by
        apply mul_le_mul_of_nonneg_left _ ha0
        calc
          (1 / 16 : Real) ≤ (2 * Real.pi) * (1 / 32 : Real) := by
            nlinarith [htwopi_lower]
          _ ≤ (2 * Real.pi) * rho :=
            mul_le_mul_of_nonneg_left hrho.1 (by positivity)
      _ = (2 * Real.pi * a) * rho := by ring
  have hamp : |2 * Real.pi * a| ≤ 128 * (a / 16) := by
    rw [abs_of_nonneg (by positivity : 0 ≤ 2 * Real.pi * a)]
    calc
      2 * Real.pi * a ≤ 8 * a := mul_le_mul_of_nonneg_right htwopi_upper ha0
      _ = 128 * (a / 16) := by ring
  have hfreq : 1 ≤ |(2 * Real.pi * a) * rho| := by
    rw [abs_of_pos hrawpos]
    exact hscale.trans hfreq_ge_scale
  have hsqrt : Real.sqrt (a / 16) ≤ Real.sqrt |(2 * Real.pi * a) * rho| := by
    rw [abs_of_pos hrawpos]
    exact Real.sqrt_le_sqrt hfreq_ge_scale
  exact ⟨hfreq, hamp, by simpa [abs_of_pos hrawpos] using hfreq_ge_scale, hsqrt⟩

/-- On the literal level-zero annulus, every derivative of any BRRS surface
wave has the sharp physical high-radius size.  The middle term is included by
using its arbitrary rapid decay with exponent `d + k`. -/
theorem exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_highRadius_decay
    {d k : Nat} (hd : 3 ≤ d) (part : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ a rho : Real, 16 ≤ a →
      rho ∈ Icc (1 / 32 : Real) 1 →
      ‖iteratedDeriv k (fun u : Real =>
        brrsSurfaceWaveAmplitude d part a u) rho‖ ≤
        C / (Real.sqrt (a / 16)) ^ (d - 1) := by
  cases part with
  | outgoing =>
      obtain ⟨C, hC, hbound⟩ :=
        exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_outgoing_decay d k
      refine ⟨C * 128 ^ k, mul_pos hC (pow_pos (by norm_num) _), ?_⟩
      intro a rho ha hrho
      obtain ⟨hfreq, hamp, hscale, hsqrt⟩ :=
        brrs_highRadius_frequency_geometry ha hrho
      have hsone : 1 ≤ a / 16 := by linarith
      calc
        ‖iteratedDeriv k (fun u : Real =>
            brrsSurfaceWaveAmplitude d .outgoing a u) rho‖ ≤
            C * |2 * Real.pi * a| ^ k /
              quadraticMomentScale (d - 2 + 2 * k) |(2 * Real.pi * a) * rho| :=
          hbound a rho hfreq
        _ ≤ (C * 128 ^ k) / (Real.sqrt (a / 16)) ^ (d - 1) :=
          brrs_endpoint_stationary_denominator_le_scale
            (d := d) (k := k) (s := a / 16) (a := 2 * Real.pi * a)
            (lambda := |(2 * Real.pi * a) * rho|) (C := C) (L := 128)
            (by omega) hsone hC.le (by positivity) hamp
            (lt_of_lt_of_le zero_lt_one hfreq) hsqrt
  | incoming =>
      obtain ⟨C, hC, hbound⟩ :=
        exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_incoming_decay d k
      refine ⟨C * 128 ^ k, mul_pos hC (pow_pos (by norm_num) _), ?_⟩
      intro a rho ha hrho
      obtain ⟨hfreq, hamp, hscale, hsqrt⟩ :=
        brrs_highRadius_frequency_geometry ha hrho
      have hsone : 1 ≤ a / 16 := by linarith
      have hsign : |(-(2 * Real.pi * a)) * rho| =
          |(2 * Real.pi * a) * rho| := by
        rw [show (-(2 * Real.pi * a)) * rho =
          -((2 * Real.pi * a) * rho) by ring, abs_neg]
      have hsignAmp : |-(2 * Real.pi * a)| = |2 * Real.pi * a| := by
        rw [abs_neg]
      calc
        ‖iteratedDeriv k (fun u : Real =>
            brrsSurfaceWaveAmplitude d .incoming a u) rho‖ ≤
            C * |-(2 * Real.pi * a)| ^ k /
              quadraticMomentScale (d - 2 + 2 * k) |(-(2 * Real.pi * a)) * rho| :=
          hbound a rho (by simpa [hsign] using hfreq)
        _ = C * |2 * Real.pi * a| ^ k /
              quadraticMomentScale (d - 2 + 2 * k) |(2 * Real.pi * a) * rho| := by
          rw [hsignAmp, hsign]
        _ ≤ (C * 128 ^ k) / (Real.sqrt (a / 16)) ^ (d - 1) :=
          brrs_endpoint_stationary_denominator_le_scale
            (d := d) (k := k) (s := a / 16) (a := 2 * Real.pi * a)
            (lambda := |(2 * Real.pi * a) * rho|) (C := C) (L := 128)
            (by omega) hsone hC.le (by positivity) hamp
            (lt_of_lt_of_le zero_lt_one hfreq) hsqrt
  | middle =>
      obtain ⟨C, hC, hbound⟩ :=
        exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_middle_decay d k (d + k)
      refine ⟨C * 128 ^ k, mul_pos hC (pow_pos (by norm_num) _), ?_⟩
      intro a rho ha hrho
      obtain ⟨hfreq, hamp, hscale, hsqrt⟩ :=
        brrs_highRadius_frequency_geometry ha hrho
      have hsone : 1 ≤ a / 16 := by linarith
      calc
        ‖iteratedDeriv k (fun u : Real =>
            brrsSurfaceWaveAmplitude d .middle a u) rho‖ ≤
            C * |2 * Real.pi * a| ^ k /
              |(2 * Real.pi * a) * rho| ^ (d + k) :=
          hbound a rho hfreq
        _ ≤ (C * 128 ^ k) / (Real.sqrt (a / 16)) ^ (d - 1) :=
          brrs_rapid_middle_denominator_le_scale
            (d := d) (k := k) (s := a / 16) (a := 2 * Real.pi * a)
            (lambda := |(2 * Real.pi * a) * rho|) (C := C) (L := 128)
            (by omega) hsone hC.le (by positivity) hamp hscale

/-- The part of the stationary radial coefficient which is fixed as the
physical radius varies. -/
def brrsStationaryWaveRadialFixedFactor
    (Phi : BRRSAnnularCutoff) (d : Nat) (rho : Real) : Complex :=
  ((rho ^ (d - 1) : Real) : Complex) * Phi.symbol (2 * Real.pi * rho)

theorem contDiff_brrsStationaryWaveRadialFixedFactor
    (Phi : BRRSAnnularCutoff) (d : Nat) :
    ContDiff Real (⊤ : ENat)
      (brrsStationaryWaveRadialFixedFactor Phi d) := by
  unfold brrsStationaryWaveRadialFixedFactor
  have hpow : ContDiff Real (⊤ : ENat) (fun rho : Real =>
      ((rho ^ (d - 1) : Real) : Complex)) :=
    Complex.ofRealCLM.contDiff.comp (contDiff_id.pow (d - 1))
  exact hpow.mul ((Phi.symbol.smooth (⊤ : ENat)).comp (by fun_prop))

/-- Finitely many derivatives of the fixed compact BRRS factor have one
positive bound on the literal level-zero annulus. -/
theorem exists_uniform_iteratedDeriv_brrsStationaryWaveRadialFixedFactor_bound
    (Phi : BRRSAnnularCutoff) (d N : Nat) :
    ∃ A : Real, 0 < A ∧ ∀ k : Nat, k ≤ N → ∀ rho ∈ Icc (1 / 32 : Real) 1,
      ‖iteratedDeriv k (brrsStationaryWaveRadialFixedFactor Phi d) rho‖ ≤ A := by
  choose A hApos hAbound using fun k : Nat =>
    exists_pos_norm_iteratedDeriv_le_on_Icc_of_contDiff
      (brrsStationaryWaveRadialFixedFactor Phi d)
      (contDiff_brrsStationaryWaveRadialFixedFactor Phi d) k
  let A' : Real := ∑ k ∈ Finset.range (N + 1), A k
  have hA' : 0 < A' := by
    have hzero : 0 ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    have hle : A 0 ≤ A' := by
      dsimp [A']
      exact Finset.single_le_sum (fun k hk => (hApos k).le) hzero
    exact lt_of_lt_of_le (hApos 0) hle
  refine ⟨A', hA', ?_⟩
  intro k hk rho hrho
  have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
  have hle : A k ≤ A' := by
    dsimp [A']
    exact Finset.single_le_sum (fun l hl => (hApos l).le) hkmem
  exact (hAbound k rho hrho).trans hle

theorem brrsStationaryLeibnizConstant_right_div
    (n : Nat) (A B q : Real) (hq : q ≠ 0) :
    brrsStationaryLeibnizConstant n A (B / q) =
      brrsStationaryLeibnizConstant n A B / q := by
  unfold brrsStationaryLeibnizConstant
  rw [Finset.sum_div]
  apply Finset.sum_congr rfl
  intro i hi
  field_simp [hq]

/-- Uniform all-order high-radius symbol bounds for the literal compact
coefficient after the stationary carrier has been removed. -/
theorem exists_uniform_iteratedDeriv_brrsStationaryWaveRadialCoefficient_highRadius_decay
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff)
    (part : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ a rho : Real, 16 ≤ a →
      rho ∈ Icc (1 / 32 : Real) 1 →
      ‖iteratedDeriv k (fun u : Real =>
        brrsStationaryWaveRadialCoefficient Phi d part a u) rho‖ ≤
        C / (Real.sqrt (a / 16)) ^ (d - 1) := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_iteratedDeriv_brrsStationaryWaveRadialFixedFactor_bound Phi d N
  choose B hBpos hBbound using fun k : Nat =>
    exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_highRadius_decay
      (d := d) (k := k) hd part
  let B' : Real := ∑ k ∈ Finset.range (N + 1), B k
  have hB' : 0 < B' := by
    have hzero : 0 ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    have hle : B 0 ≤ B' := by
      dsimp [B']
      exact Finset.single_le_sum (fun k hk => (hBpos k).le) hzero
    exact lt_of_lt_of_le (hBpos 0) hle
  let C : Real := ∑ l ∈ Finset.range (N + 1),
    brrsStationaryLeibnizConstant l A B'
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact brrsStationaryLeibnizConstant_nonneg l hA.le hB'.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk a rho ha hrho
  let fixed : Real → Complex := brrsStationaryWaveRadialFixedFactor Phi d
  let physical : Real → Complex := fun u : Real =>
    brrsSurfaceWaveAmplitude d part a u
  have hfixed : ContDiff Real (⊤ : ENat) fixed := by
    dsimp [fixed]
    exact contDiff_brrsStationaryWaveRadialFixedFactor Phi d
  have hphysical : ContDiff Real (⊤ : ENat) physical := by
    dsimp [physical]
    exact contDiff_brrsSurfaceWaveAmplitude d part a
  have hBuniform : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l physical rho‖ ≤
        B' / (Real.sqrt (a / 16)) ^ (d - 1) := by
    intro l hl
    have hlmem : l ∈ Finset.range (N + 1) :=
      Finset.mem_range.mpr (by omega)
    have hle : B l ≤ B' := by
      dsimp [B']
      exact Finset.single_le_sum (fun m hm => (hBpos m).le) hlmem
    have hdenpos : 0 < (Real.sqrt (a / 16)) ^ (d - 1) := by
      apply pow_pos
      apply Real.sqrt_pos.2
      linarith
    exact (hBbound l a rho ha hrho).trans
      (div_le_div_of_nonneg_right hle hdenpos.le)
  have hqpos : 0 < (Real.sqrt (a / 16)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hprod := norm_iteratedDeriv_mul_le_brrsStationaryLeibnizConstant
    (n := k) hfixed hphysical hA.le
    (div_nonneg hB'.le hqpos.le)
    (fun l hl => hAbound l (hl.trans hk) rho hrho)
    hBuniform
  have hfactorfun : (fun u : Real =>
      brrsStationaryWaveRadialCoefficient Phi d part a u) =
      fun u : Real => fixed u * physical u := by
    funext u
    dsimp [fixed, physical]
    unfold brrsStationaryWaveRadialCoefficient
      brrsStationaryWaveRadialFixedFactor
    ring
  rw [hfactorfun]
  have hCbound : brrsStationaryLeibnizConstant k A B' ≤ C := by
    unfold C
    have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    exact Finset.single_le_sum
      (fun l hl => brrsStationaryLeibnizConstant_nonneg l hA.le hB'.le) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real => fixed u * physical u) rho‖ ≤
        brrsStationaryLeibnizConstant k A
          (B' / (Real.sqrt (a / 16)) ^ (d - 1)) := hprod
    _ = brrsStationaryLeibnizConstant k A B' /
          (Real.sqrt (a / 16)) ^ (d - 1) := by
      rw [brrsStationaryLeibnizConstant_right_div k A B'
        ((Real.sqrt (a / 16)) ^ (d - 1)) hqpos.ne']
    _ ≤ C / (Real.sqrt (a / 16)) ^ (d - 1) :=
      div_le_div_of_nonneg_right hCbound hqpos.le
    _ ≤ (C + 1) / (Real.sqrt (a / 16)) ^ (d - 1) := by
      exact div_le_div_of_nonneg_right (by linarith) hqpos.le

/-- The finite Leibniz constant respects two positive denominator factors.
This is the elementary algebra needed when the two surface-wave amplitudes in
the radial BRRS kernel are estimated simultaneously. -/
theorem brrsStationaryLeibnizConstant_two_div
    (n : Nat) (A B q r : Real) (hq : q ≠ 0) (hr : r ≠ 0) :
    brrsStationaryLeibnizConstant n (A / q) (B / r) =
      brrsStationaryLeibnizConstant n A B / (q * r) := by
  unfold brrsStationaryLeibnizConstant
  rw [Finset.sum_div]
  apply Finset.sum_congr rfl
  intro i hi
  field_simp [hq, hr]

/-- Uniform all-order high-radius symbol bounds for a product of two literal
stationary surface waves.  This is the differential estimate underlying the
four signed phases in the BRRS two-radius kernel calculation. -/
theorem exists_uniform_iteratedDeriv_brrsTwoRadiusStationaryCoefficient_highRadius_decay
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ r s rho : Real,
      16 ≤ r → 16 ≤ s → rho ∈ Icc (1 / 32 : Real) 1 →
        ‖iteratedDeriv k (fun u : Real =>
          brrsTwoRadiusStationaryCoefficient Phi d partR partS r s u) rho‖ ≤
          C / ((Real.sqrt (r / 16)) ^ (d - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1)) := by
  choose A hApos hAbound using fun k : Nat =>
    exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_highRadius_decay
      (d := d) (k := k) hd partR
  obtain ⟨B, hB, hBbound⟩ :=
    exists_uniform_iteratedDeriv_brrsStationaryWaveRadialCoefficient_highRadius_decay
      (d := d) (N := N) hd Phi partS
  let A' : Real := ∑ k ∈ Finset.range (N + 1), A k
  have hA' : 0 < A' := by
    have hzero : 0 ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    have hle : A 0 ≤ A' := by
      dsimp [A']
      exact Finset.single_le_sum (fun k hk => (hApos k).le) hzero
    exact lt_of_lt_of_le (hApos 0) hle
  let C : Real := ∑ l ∈ Finset.range (N + 1),
    brrsStationaryLeibnizConstant l A' B
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact brrsStationaryLeibnizConstant_nonneg l hA'.le hB.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk r s rho hr hs hrho
  let left : Real → Complex := fun u : Real =>
    brrsSurfaceWaveAmplitude d partR r u
  let right : Real → Complex := fun u : Real =>
    brrsStationaryWaveRadialCoefficient Phi d partS s u
  have hleft : ContDiff Real (⊤ : ENat) left := by
    dsimp [left]
    exact contDiff_brrsSurfaceWaveAmplitude d partR r
  have hright : ContDiff Real (⊤ : ENat) right := by
    dsimp [right]
    exact contDiff_brrsStationaryWaveRadialCoefficient Phi d partS s
  have hqpos : 0 < (Real.sqrt (r / 16)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hrpos : 0 < (Real.sqrt (s / 16)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hleftbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l left rho‖ ≤
        A' / (Real.sqrt (r / 16)) ^ (d - 1) := by
    intro l hl
    have hlmem : l ∈ Finset.range (N + 1) :=
      Finset.mem_range.mpr (by omega)
    have hle : A l ≤ A' := by
      dsimp [A']
      exact Finset.single_le_sum (fun m hm => (hApos m).le) hlmem
    exact (hAbound l r rho hr hrho).trans
      (div_le_div_of_nonneg_right hle hqpos.le)
  have hrightbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l right rho‖ ≤
        B / (Real.sqrt (s / 16)) ^ (d - 1) := by
    intro l hl
    exact hBbound l (hl.trans hk) s rho hs hrho
  have hprod := norm_iteratedDeriv_mul_le_brrsStationaryLeibnizConstant
    (n := k) hleft hright
    (div_nonneg hA'.le hqpos.le) (div_nonneg hB.le hrpos.le)
    hleftbound hrightbound
  have hfactorfun : (fun u : Real =>
      brrsTwoRadiusStationaryCoefficient Phi d partR partS r s u) =
      fun u : Real => left u * right u := by
    funext u
    dsimp [left, right]
    unfold brrsTwoRadiusStationaryCoefficient
      brrsStationaryWaveRadialCoefficient
    ring
  rw [hfactorfun]
  have hCbound : brrsStationaryLeibnizConstant k A' B ≤ C := by
    unfold C
    have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    exact Finset.single_le_sum
      (fun l hl => brrsStationaryLeibnizConstant_nonneg l hA'.le hB.le) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real => left u * right u) rho‖ ≤
        brrsStationaryLeibnizConstant k
          (A' / (Real.sqrt (r / 16)) ^ (d - 1))
          (B / (Real.sqrt (s / 16)) ^ (d - 1)) := hprod
    _ = brrsStationaryLeibnizConstant k A' B /
          ((Real.sqrt (r / 16)) ^ (d - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1)) := by
      rw [brrsStationaryLeibnizConstant_two_div k A' B
        ((Real.sqrt (r / 16)) ^ (d - 1))
        ((Real.sqrt (s / 16)) ^ (d - 1)) hqpos.ne' hrpos.ne']
    _ ≤ C / ((Real.sqrt (r / 16)) ^ (d - 1) *
          (Real.sqrt (s / 16)) ^ (d - 1)) :=
      div_le_div_of_nonneg_right hCbound (mul_pos hqpos hrpos).le
    _ ≤ (C + 1) / ((Real.sqrt (r / 16)) ^ (d - 1) *
          (Real.sqrt (s / 16)) ^ (d - 1)) :=
      div_le_div_of_nonneg_right (by linarith) (mul_pos hqpos hrpos).le

/-- A two-radius stationary coefficient factors into the outer surface-wave
amplitude and the already compact one-radius coefficient for the inner
surface wave. -/
theorem brrsTwoRadiusStationaryCoefficient_eq_amplitude_mul_coefficient
    (Phi : BRRSAnnularCutoff) (d : Nat)
    (partR partS : BRRSSurfaceWavePart) (r s rho : Real) :
    brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho =
      brrsSurfaceWaveAmplitude d partR r rho *
        brrsStationaryWaveRadialCoefficient Phi d partS s rho := by
  unfold brrsTwoRadiusStationaryCoefficient
    brrsStationaryWaveRadialCoefficient
  ring

/-- The literal product coefficient in the two-radius stationary kernel is
smooth in the compact frequency variable. -/
theorem contDiff_brrsTwoRadiusStationaryCoefficient
    (Phi : BRRSAnnularCutoff) (d : Nat)
    (partR partS : BRRSSurfaceWavePart) (r s : Real) :
    ContDiff Real (⊤ : ENat) (fun rho : Real =>
      brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho) := by
  rw [show (fun rho : Real =>
      brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho) =
        fun rho : Real => brrsSurfaceWaveAmplitude d partR r rho *
          brrsStationaryWaveRadialCoefficient Phi d partS s rho by
      funext rho
      exact brrsTwoRadiusStationaryCoefficient_eq_amplitude_mul_coefficient
        Phi d partR partS r s rho]
  exact (contDiff_brrsSurfaceWaveAmplitude d partR r).mul
    (contDiff_brrsStationaryWaveRadialCoefficient Phi d partS s)

/-- The compact cutoff removes the lower endpoint boundary term from every
two-radius stationary coefficient. -/
theorem brrsTwoRadiusStationaryCoefficient_eventuallyEq_zero_at_lower
    (Phi : BRRSAnnularCutoff) (d : Nat)
    (partR partS : BRRSSurfaceWavePart) (r s : Real) :
    Filter.EventuallyEq (nhds (1 / 32 : Real))
      (fun rho : Real => brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho) 0 := by
  filter_upwards [brrsStationaryWaveRadialCoefficient_eventuallyEq_zero_at_lower
    Phi d partS s] with rho hrho
  have hzero : brrsStationaryWaveRadialCoefficient Phi d partS s rho = 0 := by
    change brrsStationaryWaveRadialCoefficient Phi d partS s rho = (0 : Complex) at hrho
    exact hrho
  rw [brrsTwoRadiusStationaryCoefficient_eq_amplitude_mul_coefficient]
  rw [hzero, mul_zero]
  simp only [Pi.zero_apply]

/-- The compact cutoff likewise removes the upper endpoint boundary term
from every two-radius stationary coefficient. -/
theorem brrsTwoRadiusStationaryCoefficient_eventuallyEq_zero_at_upper
    (Phi : BRRSAnnularCutoff) (d : Nat)
    (partR partS : BRRSSurfaceWavePart) (r s : Real) :
    Filter.EventuallyEq (nhds (1 : Real))
      (fun rho : Real => brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho) 0 := by
  filter_upwards [brrsStationaryWaveRadialCoefficient_eventuallyEq_zero_at_upper
    Phi d partS s] with rho hrho
  have hzero : brrsStationaryWaveRadialCoefficient Phi d partS s rho = 0 := by
    change brrsStationaryWaveRadialCoefficient Phi d partS s rho = (0 : Complex) at hrho
    exact hrho
  rw [brrsTwoRadiusStationaryCoefficient_eq_amplitude_mul_coefficient]
  rw [hzero, mul_zero]
  simp only [Pi.zero_apply]

/-- Uniform compact nonstationary-phase decay for a two-radius stationary
component when both physical radii are large.  The two denominator factors
are the exact product of the two half-dimensional surface-wave decays. -/
theorem exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_highRadius_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ r s : Real, 16 ≤ r → 16 ≤ s →
      ∀ {freq : Real}, freq ≠ 0 →
        ‖∫ rho in (1 / 32 : Real)..1,
          brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
            oscillatoryExp freq rho‖ ≤
          (1 / |freq|) ^ N * ((1 - (1 / 32 : Real)) *
            (C / ((Real.sqrt (r / 16)) ^ (d - 1) *
              (Real.sqrt (s / 16)) ^ (d - 1)))) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_uniform_iteratedDeriv_brrsTwoRadiusStationaryCoefficient_highRadius_decay
      (d := d) (N := N) hd Phi partR partS
  refine ⟨C, hC, ?_⟩
  intro r s hr hs freq hfreq
  have hqpos : 0 < (Real.sqrt (r / 16)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hrpos : 0 < (Real.sqrt (s / 16)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hchain := hasOscillatoryIBPChain_iteratedDeriv_of_contDiff
    (fun rho : Real => brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho)
    (contDiff_brrsTwoRadiusStationaryCoefficient Phi d partR partS r s)
    (brrsTwoRadiusStationaryCoefficient_eventuallyEq_zero_at_lower
      Phi d partR partS r s)
    (brrsTwoRadiusStationaryCoefficient_eventuallyEq_zero_at_upper
      Phi d partR partS r s) N
  simpa only [iteratedDeriv_zero] using
    (norm_intervalIntegral_mul_oscillatoryExp_le_iterated
      (F := fun k => iteratedDeriv k
        (fun rho : Real =>
          brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho))
      (N := N) (by norm_num : (1 / 32 : Real) ≤ 1) hfreq hchain
      (div_nonneg hC.le (mul_pos hqpos hrpos).le)
      (fun rho hrho => hbound N le_rfl r s rho hr hs hrho))

/-- A two-radius stationary component also has its compact uniform bound at
the cone, where integration by parts alone has no decay to exploit. -/
theorem exists_norm_intervalIntegral_brrsTwoRadStatCoefficient_highRad_uniform_le
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ r s freq : Real, 16 ≤ r → 16 ≤ s →
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
          oscillatoryExp freq rho‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (d - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1))) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_uniform_iteratedDeriv_brrsTwoRadiusStationaryCoefficient_highRadius_decay
      (d := d) (N := 0) hd Phi partR partS
  refine ⟨C, hC, ?_⟩
  intro r s freq hr hs
  have hqpos : 0 < (Real.sqrt (r / 16)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hrpos : 0 < (Real.sqrt (s / 16)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  calc
    ‖∫ rho in (1 / 32 : Real)..1,
      brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
        oscillatoryExp freq rho‖ ≤
        (C / ((Real.sqrt (r / 16)) ^ (d - 1) *
          (Real.sqrt (s / 16)) ^ (d - 1))) *
          |1 - (1 / 32 : Real)| := by
      apply intervalIntegral.norm_integral_le_of_norm_le_const
      intro rho hrho
      have hrho' : rho ∈ Icc (1 / 32 : Real) 1 := by
        rw [uIoc_of_le (by norm_num : (1 / 32 : Real) ≤ 1)] at hrho
        exact ⟨hrho.1.le, hrho.2⟩
      rw [norm_mul, norm_oscillatoryExp, mul_one]
      exact hbound 0 le_rfl r s rho hr hs hrho'
    _ = (1 - (1 / 32 : Real)) *
        (C / ((Real.sqrt (r / 16)) ^ (d - 1) *
          (Real.sqrt (s / 16)) ^ (d - 1))) := by
      rw [abs_of_nonneg (by norm_num : (0 : Real) ≤ 1 - 1 / 32)]
      ring

/-- A bounded rapidly decaying one-dimensional profile.  The value at zero is
defined separately so it is the exact profile obtained by combining the
trivial compact-integral estimate with repeated integration by parts. -/
def brrsStationaryRapidProfile (N : Nat) (u : Real) : Real :=
  if u = 0 then 1 else min 1 ((1 / |u|) ^ N)

theorem brrsStationaryRapidProfile_nonneg (N : Nat) (u : Real) :
    0 ≤ brrsStationaryRapidProfile N u := by
  by_cases hu : u = 0
  · simp [brrsStationaryRapidProfile, hu]
  · rw [brrsStationaryRapidProfile, if_neg hu]
    exact le_min (by norm_num) (pow_nonneg (by positivity) _)

/-- Combining the uniform cone bound with repeated integration by parts gives
a bounded rapidly decaying profile for every two-radius stationary phase. -/
theorem exists_norm_intervalIntegral_brrsTwoRadStatCoefficient_highRad_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ r s freq : Real, 16 ≤ r → 16 ≤ s →
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
          oscillatoryExp freq rho‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (d - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1))) *
          brrsStationaryRapidProfile N freq := by
  obtain ⟨C0, hC0, huniform⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadStatCoefficient_highRad_uniform_le
      (d := d) hd Phi partR partS
  obtain ⟨C1, hC1, hdecay⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_highRadius_le
      (d := d) (N := N) hd Phi partR partS
  let C : Real := C0 + C1
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro r s freq hr hs
  let q : Real := (Real.sqrt (r / 16)) ^ (d - 1) *
    (Real.sqrt (s / 16)) ^ (d - 1)
  let A : Real := (1 - (1 / 32 : Real)) * (C / q)
  have hqpos : 0 < q := by
    dsimp [q]
    apply mul_pos
    all_goals
      apply pow_pos
      apply Real.sqrt_pos.2
      linarith
  have hAnonneg : 0 ≤ A := by
    dsimp [A]
    positivity
  have hC0le : C0 ≤ C := by
    dsimp [C]
    linarith
  have hC1le : C1 ≤ C := by
    dsimp [C]
    linarith
  change ‖∫ rho in (1 / 32 : Real)..1,
      brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
        oscillatoryExp freq rho‖ ≤ A * brrsStationaryRapidProfile N freq
  by_cases hfreq : freq = 0
  · have hcomp : (1 - (1 / 32 : Real)) * (C0 / q) ≤ A := by
      dsimp [A]
      apply mul_le_mul_of_nonneg_left
      · exact div_le_div_of_nonneg_right hC0le hqpos.le
      · norm_num
    simpa [brrsStationaryRapidProfile, hfreq] using
      (huniform r s 0 hr hs).trans hcomp
  · rw [brrsStationaryRapidProfile, if_neg hfreq]
    let z : Real := (1 / |freq|) ^ N
    have huniform' : ‖∫ rho in (1 / 32 : Real)..1,
        brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
          oscillatoryExp freq rho‖ ≤ A := by
      refine (huniform r s freq hr hs).trans ?_
      dsimp [A, q]
      apply mul_le_mul_of_nonneg_left
      · exact div_le_div_of_nonneg_right hC0le hqpos.le
      · norm_num
    have hdecay' : ‖∫ rho in (1 / 32 : Real)..1,
        brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
          oscillatoryExp freq rho‖ ≤ z * A := by
      refine (hdecay r s hr hs hfreq).trans ?_
      dsimp [z, A, q]
      apply mul_le_mul_of_nonneg_left
      · apply mul_le_mul_of_nonneg_left
        · exact div_le_div_of_nonneg_right hC1le hqpos.le
        · norm_num
      · positivity
    calc
      ‖∫ rho in (1 / 32 : Real)..1,
          brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
            oscillatoryExp freq rho‖ ≤ min A (z * A) := le_min huniform' hdecay'
      _ = A * min 1 z := by
        calc
          min A (z * A) = min (A * 1) (A * z) := by
            congr 1 <;> ring
          _ = A * min 1 z := (mul_min_of_nonneg 1 z hAnonneg).symm
      _ = A * min 1 ((1 / |freq|) ^ N) := by rfl

/-- Literal compact nonstationary phase at high physical radius.  Unlike the
earlier existential-constant result, this version retains the stationary
`(d-1)/2` spatial decay uniformly through the integration-by-parts order. -/
theorem exists_norm_intervalIntegral_brrsStationaryWaveRadialCoefficient_highRadius_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff)
    (part : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ a : Real, 16 ≤ a → ∀ {freq : Real}, freq ≠ 0 →
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsStationaryWaveRadialCoefficient Phi d part a rho *
          oscillatoryExp freq rho‖ ≤
        (1 / |freq|) ^ N *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (a / 16)) ^ (d - 1))) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_uniform_iteratedDeriv_brrsStationaryWaveRadialCoefficient_highRadius_decay
      (d := d) (N := N) hd Phi part
  refine ⟨C, hC, ?_⟩
  intro a ha freq hfreq
  have hqpos : 0 < (Real.sqrt (a / 16)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hchain := hasOscillatoryIBPChain_iteratedDeriv_of_contDiff
    (brrsStationaryWaveRadialCoefficient Phi d part a)
    (contDiff_brrsStationaryWaveRadialCoefficient Phi d part a)
    (brrsStationaryWaveRadialCoefficient_eventuallyEq_zero_at_lower Phi d part a)
    (brrsStationaryWaveRadialCoefficient_eventuallyEq_zero_at_upper Phi d part a) N
  simpa only [iteratedDeriv_zero] using
    (norm_intervalIntegral_mul_oscillatoryExp_le_iterated
      (F := fun k => iteratedDeriv k
        (brrsStationaryWaveRadialCoefficient Phi d part a))
      (N := N) (by norm_num : (1 / 32 : Real) ≤ 1) hfreq hchain
      (div_nonneg hC.le hqpos.le)
      (fun rho hrho => hbound N le_rfl a rho ha hrho))

/-- The previous high-radius estimate written in the literal physical phase
of one BRRS half-wave component. -/
theorem exists_norm_intervalIntegral_brrsStationaryWaveComponent_highRadius_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff)
    (part : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ a t : Real, 16 ≤ a →
      brrsSurfaceWavePhase part a + 2 * Real.pi * t ≠ 0 →
      ‖∫ rho in (1 / 32 : Real)..1,
        ((rho ^ (d - 1) : Real) : Complex) *
          (brrsSurfaceWaveTerm d part a rho *
            brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho)‖ ≤
        (1 / |brrsSurfaceWavePhase part a + 2 * Real.pi * t|) ^ N *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (a / 16)) ^ (d - 1))) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_norm_intervalIntegral_brrsStationaryWaveRadialCoefficient_highRadius_le
      (d := d) (N := N) hd Phi part
  refine ⟨C, hC, ?_⟩
  intro a t ha hfreq
  rw [intervalIntegral_brrsStationaryWaveComponent_eq_oscillatoryExp]
  exact hbound a ha hfreq

/-- The literal compact radial integral of one stationary surface-wave
component.  Naming it lets radial block estimates talk about an actual kernel
component without re-expanding the oscillatory frequency integral. -/
noncomputable def brrsStationaryWaveComponentIntegral
    (Phi : BRRSAnnularCutoff) (d : Nat) (part : BRRSSurfaceWavePart)
    (a t : Real) : Complex :=
  ∫ rho in (1 / 32 : Real)..1,
    ((rho ^ (d - 1) : Real) : Complex) *
      (brrsSurfaceWaveTerm d part a rho *
        brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho)

/-- The one-dimensional power profile occurring after the outgoing or incoming
stationary phase is written as a measurable `ENNReal` function for use in the
finite radial-block summation. -/
noncomputable def brrsHighRadiusStationaryDecayProfile
    (C : Real) (N : Nat) : Real → ENNReal :=
  fun u => ENNReal.ofReal
    ((1 - (1 / 32 : Real)) * C * (1 / |2 * Real.pi * u|) ^ N)

theorem measurable_brrsHighRadiusStationaryDecayProfile
    (C : Real) (N : Nat) :
    Measurable (brrsHighRadiusStationaryDecayProfile C N) := by
  unfold brrsHighRadiusStationaryDecayProfile
  apply Measurable.ennreal_ofReal
  fun_prop

/-- The middle stationary wave has no radial carrier phase.  On a radial
block it is therefore controlled by a finite shell profile in the `t+r`
variable, whose support is exactly large enough to contain
`t ∈ [1,2]`, `r ∈ [R,2R]`. -/
noncomputable def brrsHighRadiusMiddleShellProfile
    (C : Real) (d : Nat) (R : Real) : Real → ENNReal := by
  classical
  exact (Icc R (2 * R + 2)).indicator (fun _ => ENNReal.ofReal
    ((1 - (1 / 32 : Real)) *
      (C / (Real.sqrt (R / 16)) ^ (d - 1))))

theorem measurable_brrsHighRadiusMiddleShellProfile
    (C : Real) (d : Nat) (R : Real) :
    Measurable (brrsHighRadiusMiddleShellProfile C d R) := by
  classical
  unfold brrsHighRadiusMiddleShellProfile
  exact measurable_const.indicator measurableSet_Icc

/-- The outgoing high-radius stationary component supplies the `t-r` profile
required by the radial main-block summation.  This is a concrete kernel-to-
block bridge: the only loss is the explicit local counting factor and the
sevenfold lattice-star overlap. -/
theorem exists_brrs_outgoingStationaryComponent_highRadius_mainCell_block_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ (T : Finset Real) (R : NNReal) (alpha : Real),
      R ≠ 0 → 16 ≤ (R : Real) → (↑T : Set Real) ⊆ Icc (1 : Real) 2 →
      (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
        ‖brrsStationaryWaveComponentIntegral Phi d .outgoing r t‖ₑ) ≤
        ((R : ENNReal) ^ alpha * brrsKappa T R alpha) * 7 *
          ∫⁻ u, brrsHighRadiusStationaryDecayProfile C N u := by
  obtain ⟨C, hC, hcomponent⟩ :=
    exists_norm_intervalIntegral_brrsStationaryWaveComponent_highRadius_le
      (d := d) (N := N) hd Phi .outgoing
  refine ⟨C, hC, ?_⟩
  intro T R alpha hR hRlarge hT
  apply brrs_sum_mainCell_sub_lintegral_le T R alpha hR
    (fun t r => ‖brrsStationaryWaveComponentIntegral Phi d .outgoing r t‖ₑ)
    (brrsHighRadiusStationaryDecayProfile C N)
    (measurable_brrsHighRadiusStationaryDecayProfile C N)
  intro t ht r hr
  have htIcc : t ∈ Icc (1 : Real) 2 := hT (by simpa using ht)
  have hrlarge : 16 ≤ r := le_trans hRlarge hr.1
  have htr : t - r < 0 := by linarith [htIcc.2, hrlarge]
  have hphase_eq :
      brrsSurfaceWavePhase .outgoing r + 2 * Real.pi * t =
        2 * Real.pi * (t - r) := by
    simp only [brrsSurfaceWavePhase]
    ring
  have hphase : brrsSurfaceWavePhase .outgoing r + 2 * Real.pi * t ≠ 0 := by
    rw [hphase_eq]
    exact mul_ne_zero (ne_of_gt (by positivity)) (ne_of_lt htr)
  have hcomponent_bound :
      ‖brrsStationaryWaveComponentIntegral Phi d .outgoing r t‖ ≤
        (1 / |brrsSurfaceWavePhase .outgoing r + 2 * Real.pi * t|) ^ N *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (r / 16)) ^ (d - 1))) := by
    simpa only [brrsStationaryWaveComponentIntegral] using
      hcomponent r t hrlarge hphase
  have hratio : 1 ≤ r / 16 := by linarith
  have hsqrt : 1 ≤ Real.sqrt (r / 16) := by
    calc
      1 = Real.sqrt 1 := Real.sqrt_one.symm
      _ ≤ Real.sqrt (r / 16) := Real.sqrt_le_sqrt hratio
  have hdenone : 1 ≤ (Real.sqrt (r / 16)) ^ (d - 1) := one_le_pow₀ hsqrt
  have hdenpos : 0 < (Real.sqrt (r / 16)) ^ (d - 1) :=
    lt_of_lt_of_le zero_lt_one hdenone
  have hdiv : C / (Real.sqrt (r / 16)) ^ (d - 1) ≤ C := by
    apply (div_le_iff₀ hdenpos).mpr
    exact le_mul_of_one_le_right hC.le hdenone
  have hpownonneg : 0 ≤ (1 / |2 * Real.pi * (t - r)|) ^ N :=
    pow_nonneg (by positivity) _
  have hreal :
      ‖brrsStationaryWaveComponentIntegral Phi d .outgoing r t‖ ≤
        (1 - (1 / 32 : Real)) * C *
          (1 / |2 * Real.pi * (t - r)|) ^ N := by
    calc
      ‖brrsStationaryWaveComponentIntegral Phi d .outgoing r t‖ ≤
          (1 / |brrsSurfaceWavePhase .outgoing r + 2 * Real.pi * t|) ^ N *
            ((1 - (1 / 32 : Real)) *
              (C / (Real.sqrt (r / 16)) ^ (d - 1))) := hcomponent_bound
      _ = (1 / |2 * Real.pi * (t - r)|) ^ N *
            ((1 - (1 / 32 : Real)) *
              (C / (Real.sqrt (r / 16)) ^ (d - 1))) := by rw [hphase_eq]
      _ ≤ (1 / |2 * Real.pi * (t - r)|) ^ N *
            ((1 - (1 / 32 : Real)) * C) := by
        apply mul_le_mul_of_nonneg_left
        · exact mul_le_mul_of_nonneg_left hdiv (by norm_num)
        · exact hpownonneg
      _ = (1 - (1 / 32 : Real)) * C *
            (1 / |2 * Real.pi * (t - r)|) ^ N := by ring
  simpa only [brrsHighRadiusStationaryDecayProfile, ofReal_norm] using
    ENNReal.ofReal_le_ofReal hreal

/-- The incoming high-radius stationary component supplies the `t+r` profile
required by the radial main-block summation. -/
theorem exists_brrs_incomingStationaryComponent_highRadius_mainCell_block_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ (T : Finset Real) (R : NNReal) (alpha : Real),
      R ≠ 0 → 16 ≤ (R : Real) → (↑T : Set Real) ⊆ Icc (1 : Real) 2 →
      (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
        ‖brrsStationaryWaveComponentIntegral Phi d .incoming r t‖ₑ) ≤
        ((R : ENNReal) ^ alpha * brrsKappa T R alpha) * 7 *
          ∫⁻ u, brrsHighRadiusStationaryDecayProfile C N u := by
  obtain ⟨C, hC, hcomponent⟩ :=
    exists_norm_intervalIntegral_brrsStationaryWaveComponent_highRadius_le
      (d := d) (N := N) hd Phi .incoming
  refine ⟨C, hC, ?_⟩
  intro T R alpha hR hRlarge hT
  apply brrs_sum_mainCell_add_lintegral_le T R alpha hR
    (fun t r => ‖brrsStationaryWaveComponentIntegral Phi d .incoming r t‖ₑ)
    (brrsHighRadiusStationaryDecayProfile C N)
    (measurable_brrsHighRadiusStationaryDecayProfile C N)
  intro t ht r hr
  have htIcc : t ∈ Icc (1 : Real) 2 := hT (by simpa using ht)
  have hrlarge : 16 ≤ r := le_trans hRlarge hr.1
  have hplus : 0 < t + r := by linarith [htIcc.1, hrlarge]
  have hphase_eq :
      brrsSurfaceWavePhase .incoming r + 2 * Real.pi * t =
        2 * Real.pi * (t + r) := by
    simp only [brrsSurfaceWavePhase]
    ring
  have hphase : brrsSurfaceWavePhase .incoming r + 2 * Real.pi * t ≠ 0 := by
    rw [hphase_eq]
    exact mul_ne_zero (ne_of_gt (by positivity)) (ne_of_gt hplus)
  have hcomponent_bound :
      ‖brrsStationaryWaveComponentIntegral Phi d .incoming r t‖ ≤
        (1 / |brrsSurfaceWavePhase .incoming r + 2 * Real.pi * t|) ^ N *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (r / 16)) ^ (d - 1))) := by
    simpa only [brrsStationaryWaveComponentIntegral] using
      hcomponent r t hrlarge hphase
  have hratio : 1 ≤ r / 16 := by linarith
  have hsqrt : 1 ≤ Real.sqrt (r / 16) := by
    calc
      1 = Real.sqrt 1 := Real.sqrt_one.symm
      _ ≤ Real.sqrt (r / 16) := Real.sqrt_le_sqrt hratio
  have hdenone : 1 ≤ (Real.sqrt (r / 16)) ^ (d - 1) := one_le_pow₀ hsqrt
  have hdenpos : 0 < (Real.sqrt (r / 16)) ^ (d - 1) :=
    lt_of_lt_of_le zero_lt_one hdenone
  have hdiv : C / (Real.sqrt (r / 16)) ^ (d - 1) ≤ C := by
    apply (div_le_iff₀ hdenpos).mpr
    exact le_mul_of_one_le_right hC.le hdenone
  have hpownonneg : 0 ≤ (1 / |2 * Real.pi * (t + r)|) ^ N :=
    pow_nonneg (by positivity) _
  have hreal :
      ‖brrsStationaryWaveComponentIntegral Phi d .incoming r t‖ ≤
        (1 - (1 / 32 : Real)) * C *
          (1 / |2 * Real.pi * (t + r)|) ^ N := by
    calc
      ‖brrsStationaryWaveComponentIntegral Phi d .incoming r t‖ ≤
          (1 / |brrsSurfaceWavePhase .incoming r + 2 * Real.pi * t|) ^ N *
            ((1 - (1 / 32 : Real)) *
              (C / (Real.sqrt (r / 16)) ^ (d - 1))) := hcomponent_bound
      _ = (1 / |2 * Real.pi * (t + r)|) ^ N *
            ((1 - (1 / 32 : Real)) *
              (C / (Real.sqrt (r / 16)) ^ (d - 1))) := by rw [hphase_eq]
      _ ≤ (1 / |2 * Real.pi * (t + r)|) ^ N *
            ((1 - (1 / 32 : Real)) * C) := by
        apply mul_le_mul_of_nonneg_left
        · exact mul_le_mul_of_nonneg_left hdiv (by norm_num)
        · exact hpownonneg
      _ = (1 - (1 / 32 : Real)) * C *
            (1 / |2 * Real.pi * (t + r)|) ^ N := by ring
  simpa only [brrsHighRadiusStationaryDecayProfile, ofReal_norm] using
    ENNReal.ofReal_le_ofReal hreal

/-- The middle high-radius stationary component is controlled on each radial
block by a finite `t+r` shell.  Unlike the endpoint waves, its phase contains
no radial carrier; the shell support retains the physical-radius decay while
keeping the right-hand side suitable for the finite block summation. -/
theorem exists_brrs_middleStationaryComponent_highRadius_mainCell_block_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ (T : Finset Real) (R : NNReal) (alpha : Real),
      R ≠ 0 → 16 ≤ (R : Real) → (↑T : Set Real) ⊆ Icc (1 : Real) 2 →
      (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
        ‖brrsStationaryWaveComponentIntegral Phi d .middle r t‖ₑ) ≤
        ((R : ENNReal) ^ alpha * brrsKappa T R alpha) * 7 *
          ∫⁻ u, brrsHighRadiusMiddleShellProfile C d (R : Real) u := by
  classical
  obtain ⟨C, hC, hcomponent⟩ :=
    exists_norm_intervalIntegral_brrsStationaryWaveComponent_highRadius_le
      (d := d) (N := N) hd Phi .middle
  refine ⟨C, hC, ?_⟩
  intro T R alpha hR hRlarge hT
  apply brrs_sum_mainCell_add_lintegral_le T R alpha hR
    (fun t r => ‖brrsStationaryWaveComponentIntegral Phi d .middle r t‖ₑ)
    (brrsHighRadiusMiddleShellProfile C d (R : Real))
    (measurable_brrsHighRadiusMiddleShellProfile C d (R : Real))
  intro t ht r hr
  have htIcc : t ∈ Icc (1 : Real) 2 := hT (by simpa using ht)
  have htpos : 0 < t := lt_of_lt_of_le zero_lt_one htIcc.1
  have hrlarge : 16 ≤ r := le_trans hRlarge hr.1
  have htwopi : 0 < 2 * Real.pi := by positivity
  have hfreqpos : 0 < 2 * Real.pi * t := mul_pos htwopi htpos
  have hfreqone : 1 ≤ |2 * Real.pi * t| := by
    rw [abs_of_pos hfreqpos]
    calc
      (1 : Real) ≤ 2 * Real.pi := by nlinarith [Real.pi_gt_three]
      _ = 2 * Real.pi * 1 := by ring
      _ ≤ 2 * Real.pi * t :=
        mul_le_mul_of_nonneg_left htIcc.1 htwopi.le
  have hphase_eq :
      brrsSurfaceWavePhase .middle r + 2 * Real.pi * t =
        2 * Real.pi * t := by
    simp only [brrsSurfaceWavePhase, zero_add]
  have hphase : brrsSurfaceWavePhase .middle r + 2 * Real.pi * t ≠ 0 := by
    rw [hphase_eq]
    exact ne_of_gt hfreqpos
  have hcomponent_bound :
      ‖brrsStationaryWaveComponentIntegral Phi d .middle r t‖ ≤
        (1 / |brrsSurfaceWavePhase .middle r + 2 * Real.pi * t|) ^ N *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (r / 16)) ^ (d - 1))) := by
    simpa only [brrsStationaryWaveComponentIntegral] using
      hcomponent r t hrlarge hphase
  have hinvle : 1 / |2 * Real.pi * t| ≤ 1 := by
    simpa only [one_div] using inv_le_one_of_one_le₀ hfreqone
  have hpowlte : (1 / |2 * Real.pi * t|) ^ N ≤ 1 :=
    pow_le_one₀ (by positivity) hinvle
  have hdenRpos : 0 < (Real.sqrt ((R : Real) / 16)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hdenrpos : 0 < (Real.sqrt (r / 16)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hroot : Real.sqrt ((R : Real) / 16) ≤ Real.sqrt (r / 16) := by
    apply Real.sqrt_le_sqrt
    linarith [hr.1]
  have hdenmonotone :
      (Real.sqrt ((R : Real) / 16)) ^ (d - 1) ≤
        (Real.sqrt (r / 16)) ^ (d - 1) :=
    pow_le_pow_left₀ (Real.sqrt_nonneg _) hroot _
  have hdiv : C / (Real.sqrt (r / 16)) ^ (d - 1) ≤
      C / (Real.sqrt ((R : Real) / 16)) ^ (d - 1) :=
    div_le_div_of_nonneg_left hC.le hdenRpos hdenmonotone
  have hblocknonneg : 0 ≤ (1 - (1 / 32 : Real)) *
      (C / (Real.sqrt (r / 16)) ^ (d - 1)) := by
    exact mul_nonneg (by norm_num) (div_nonneg hC.le hdenrpos.le)
  have hreal :
      ‖brrsStationaryWaveComponentIntegral Phi d .middle r t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt ((R : Real) / 16)) ^ (d - 1)) := by
    calc
      ‖brrsStationaryWaveComponentIntegral Phi d .middle r t‖ ≤
          (1 / |brrsSurfaceWavePhase .middle r + 2 * Real.pi * t|) ^ N *
            ((1 - (1 / 32 : Real)) *
              (C / (Real.sqrt (r / 16)) ^ (d - 1))) := hcomponent_bound
      _ = (1 / |2 * Real.pi * t|) ^ N *
            ((1 - (1 / 32 : Real)) *
              (C / (Real.sqrt (r / 16)) ^ (d - 1))) := by rw [hphase_eq]
      _ ≤ 1 * ((1 - (1 / 32 : Real)) *
              (C / (Real.sqrt (r / 16)) ^ (d - 1))) :=
        mul_le_mul_of_nonneg_right hpowlte hblocknonneg
      _ = (1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (r / 16)) ^ (d - 1)) := by ring
      _ ≤ (1 - (1 / 32 : Real)) *
            (C / (Real.sqrt ((R : Real) / 16)) ^ (d - 1)) :=
        mul_le_mul_of_nonneg_left hdiv (by norm_num)
  have hmem : t + r ∈ Icc (R : Real) (2 * (R : Real) + 2) := by
    constructor <;> linarith [htIcc.1, htIcc.2, hr.1, hr.2]
  change ‖brrsStationaryWaveComponentIntegral Phi d .middle r t‖ₑ ≤
    (Icc (R : Real) (2 * (R : Real) + 2)).indicator
      (fun _ => ENNReal.ofReal ((1 - (1 / 32 : Real)) *
        (C / (Real.sqrt ((R : Real) / 16)) ^ (d - 1)))) (t + r)
  rw [Set.indicator_of_mem hmem]
  simpa only [ofReal_norm] using ENNReal.ofReal_le_ofReal hreal

/-- For a fixed time, each literal stationary component is continuous in the
physical radial variable.  This supplies the measurability needed when the
three components are recombined under a radial shell integral. -/
private theorem continuous_brrsStationaryWaveComponentIntegral_radial
    (Phi : BRRSAnnularCutoff) (d : Nat) (part : BRRSSurfaceWavePart)
    (t : Real) :
    Continuous (fun a : Real =>
      brrsStationaryWaveComponentIntegral Phi d part a t) := by
  unfold brrsStationaryWaveComponentIntegral
  apply intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
  have hamp : Continuous (fun p : Real × Real =>
      brrsSurfaceWaveAmplitude d part p.1 p.2) := by
    cases part with
    | outgoing =>
        unfold brrsSurfaceWaveAmplitude
        exact continuous_const.mul
          ((contDiff_smoothEndpointQuadraticIntegral (d - 2)).continuous.comp
            (by fun_prop))
    | incoming =>
        unfold brrsSurfaceWaveAmplitude
        exact continuous_const.mul
          ((contDiff_smoothEndpointQuadraticIntegral (d - 2)).continuous.comp
            (by fun_prop))
    | middle =>
        unfold brrsSurfaceWaveAmplitude
        exact continuous_const.mul
          ((contDiff_coordinateMiddleMeridianLocalizedIntegral (d - 2)).continuous.comp
            (by fun_prop))
  have hterm : Continuous (fun p : Real × Real =>
      brrsSurfaceWaveTerm d part p.1 p.2) := by
    unfold brrsSurfaceWaveTerm
    apply hamp.mul
    cases part <;> simp only [brrsSurfaceWavePhase] <;> fun_prop
  have hdensity : Continuous (fun p : Real × Real =>
      ((p.2 ^ (d - 1) : Real) : Complex)) := by
    fun_prop
  have hprofile : Continuous (fun p : Real × Real =>
      brrsDyadicHalfWaveKernelRadialProfile Phi 0 t p.2) := by
    unfold brrsDyadicHalfWaveKernelRadialProfile
    simp only [pow_zero, inv_one, mul_one]
    apply Continuous.mul
    · fun_prop
    · exact (Phi.symbol.smooth (⊤ : ENat)).continuous.comp (by fun_prop)
  exact hdensity.mul (hterm.mul hprofile)

private theorem measurable_enorm_brrsStationaryWaveComponentIntegral_radial
    (Phi : BRRSAnnularCutoff) (d : Nat) (part : BRRSSurfaceWavePart)
    (t : Real) :
    Measurable (fun a : Real =>
      ‖brrsStationaryWaveComponentIntegral Phi d part a t‖ₑ) := by
  simpa only [ofReal_norm] using
    (continuous_brrsStationaryWaveComponentIntegral_radial Phi d part t).norm
      |>.measurable.ennreal_ofReal

private theorem continuous_brrsStationaryWaveComponentIntegrand
    (Phi : BRRSAnnularCutoff) (d : Nat) (part : BRRSSurfaceWavePart)
    (a t : Real) :
    Continuous (fun rho : Real =>
      ((rho ^ (d - 1) : Real) : Complex) *
        (brrsSurfaceWaveTerm d part a rho *
          brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho)) := by
  have hdensity : Continuous (fun rho : Real =>
      ((rho ^ (d - 1) : Real) : Complex)) :=
    (show ContDiff Real (⊤ : ENat) (fun rho : Real =>
      ((rho ^ (d - 1) : Real) : Complex)) from
      Complex.ofRealCLM.contDiff.comp (contDiff_id.pow (d - 1))).continuous
  have hamp : Continuous (fun rho : Real =>
      brrsSurfaceWaveAmplitude d part a rho) :=
    (contDiff_brrsSurfaceWaveAmplitude d part a).continuous
  have hterm : Continuous (fun rho : Real =>
      brrsSurfaceWaveTerm d part a rho) := by
    unfold brrsSurfaceWaveTerm
    exact hamp.mul (by fun_prop)
  have hprofile : Continuous (fun rho : Real =>
      brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho) := by
    unfold brrsDyadicHalfWaveKernelRadialProfile
    simp only [pow_zero, inv_one, mul_one]
    apply Continuous.mul
    · fun_prop
    · exact (Phi.symbol.smooth (⊤ : ENat)).continuous.comp (by fun_prop)
  exact hdensity.mul (hterm.mul hprofile)

/-- The exact three-wave stationary formula with the compact interval
integral split into its three literal component integrals. -/
theorem brrsDyadicHalfWaveKernel_eq_levelZero_sum_stationaryWaveComponents
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) (t : Real)
    (x : Euclidean d) :
    (brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x =
      (∫ rho in (1 / 32 : Real)..1,
        ((rho ^ (d - 1) : Real) : Complex) *
          (brrsSurfaceWaveTerm d .outgoing ‖x‖ rho *
            brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho)) +
        (∫ rho in (1 / 32 : Real)..1,
          ((rho ^ (d - 1) : Real) : Complex) *
            (brrsSurfaceWaveTerm d .incoming ‖x‖ rho *
              brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho)) +
          ∫ rho in (1 / 32 : Real)..1,
            ((rho ^ (d - 1) : Real) : Complex) *
              (brrsSurfaceWaveTerm d .middle ‖x‖ rho *
                brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho) := by
  let Fout : Real → Complex := fun rho =>
    ((rho ^ (d - 1) : Real) : Complex) *
      (brrsSurfaceWaveTerm d .outgoing ‖x‖ rho *
        brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho)
  let Fin : Real → Complex := fun rho =>
    ((rho ^ (d - 1) : Real) : Complex) *
      (brrsSurfaceWaveTerm d .incoming ‖x‖ rho *
        brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho)
  let Fmid : Real → Complex := fun rho =>
    ((rho ^ (d - 1) : Real) : Complex) *
      (brrsSurfaceWaveTerm d .middle ‖x‖ rho *
        brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho)
  have hFout : IntervalIntegrable Fout volume (1 / 32 : Real) 1 := by
    dsimp [Fout]
    exact (continuous_brrsStationaryWaveComponentIntegrand Phi d .outgoing ‖x‖
        t).intervalIntegrable _ _
  have hFin : IntervalIntegrable Fin volume (1 / 32 : Real) 1 := by
    dsimp [Fin]
    exact (continuous_brrsStationaryWaveComponentIntegrand Phi d .incoming ‖x‖
        t).intervalIntegrable _ _
  have hFmid : IntervalIntegrable Fmid volume (1 / 32 : Real) 1 := by
    dsimp [Fmid]
    exact (continuous_brrsStationaryWaveComponentIntegrand Phi d .middle ‖x‖ t).intervalIntegrable _
        _
  rw [brrsDyadicHalfWaveKernel_eq_levelZero_stationaryWaveIntervalIntegral hd Phi t x]
  change (∫ rho in (1 / 32 : Real)..1,
      ((rho ^ (d - 1) : Real) : Complex) *
        ((brrsSurfaceWaveTerm d .outgoing ‖x‖ rho +
          brrsSurfaceWaveTerm d .incoming ‖x‖ rho +
            brrsSurfaceWaveTerm d .middle ‖x‖ rho) *
          brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho)) =
      (∫ rho in (1 / 32 : Real)..1, Fout rho) +
        (∫ rho in (1 / 32 : Real)..1, Fin rho) +
          ∫ rho in (1 / 32 : Real)..1, Fmid rho
  calc
    (∫ rho in (1 / 32 : Real)..1,
      ((rho ^ (d - 1) : Real) : Complex) *
        ((brrsSurfaceWaveTerm d .outgoing ‖x‖ rho +
          brrsSurfaceWaveTerm d .incoming ‖x‖ rho +
            brrsSurfaceWaveTerm d .middle ‖x‖ rho) *
          brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho)) =
        ∫ rho in (1 / 32 : Real)..1, Fout rho + Fin rho + Fmid rho := by
      apply intervalIntegral.integral_congr
      intro rho hrho
      dsimp [Fout, Fin, Fmid]
      ring
    _ = ∫ rho in (1 / 32 : Real)..1, (Fout rho + Fin rho) + Fmid rho := by rfl
    _ = (∫ rho in (1 / 32 : Real)..1, Fout rho + Fin rho) +
          ∫ rho in (1 / 32 : Real)..1, Fmid rho :=
      intervalIntegral.integral_add (hFout.add hFin) hFmid
    _ = (∫ rho in (1 / 32 : Real)..1, Fout rho) +
          (∫ rho in (1 / 32 : Real)..1, Fin rho) +
            ∫ rho in (1 / 32 : Real)..1, Fmid rho := by
      rw [intervalIntegral.integral_add hFout hFin]

/-- Recombining the literal outgoing, incoming, and middle stationary
components gives a single radial main-cell estimate for the actual level-zero
half-wave kernel.  The three one-dimensional profiles remain separate: this
retains their respective `t-r`, `t+r`, and compact middle-shell geometry for
the subsequent polar integration step. -/
theorem exists_brrsDyadicHalfWaveKernel_levelZero_highRadius_mainCell_block_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ Cout Cin Cmid : Real, 0 < Cout ∧ 0 < Cin ∧ 0 < Cmid ∧
      ∀ (T : Finset Real) (R : NNReal) (alpha : Real) (v : Euclidean d),
        R ≠ 0 → 16 ≤ (R : Real) → (↑T : Set Real) ⊆ Icc (1 : Real) 2 →
        ‖v‖ = 1 →
        (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
          ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) (r • v)‖ₑ) ≤
          (((R : ENNReal) ^ alpha * brrsKappa T R alpha) * 7) *
            ((∫⁻ u, brrsHighRadiusStationaryDecayProfile Cout N u) +
              (∫⁻ u, brrsHighRadiusStationaryDecayProfile Cin N u) +
                ∫⁻ u, brrsHighRadiusMiddleShellProfile Cmid d (R : Real) u) := by
  obtain ⟨Cout, hCout, hout⟩ :=
    exists_brrs_outgoingStationaryComponent_highRadius_mainCell_block_le
      (d := d) (N := N) hd Phi
  obtain ⟨Cin, hCin, hin⟩ :=
    exists_brrs_incomingStationaryComponent_highRadius_mainCell_block_le
      (d := d) (N := N) hd Phi
  obtain ⟨Cmid, hCmid, hmid⟩ :=
    exists_brrs_middleStationaryComponent_highRadius_mainCell_block_le
      (d := d) (N := N) hd Phi
  refine ⟨Cout, Cin, Cmid, hCout, hCin, hCmid, ?_⟩
  intro T R alpha v hR hRlarge hT hv
  let U : ENNReal := ∫⁻ u, brrsHighRadiusStationaryDecayProfile Cout N u
  let V : ENNReal := ∫⁻ u, brrsHighRadiusStationaryDecayProfile Cin N u
  let W : ENNReal := ∫⁻ u, brrsHighRadiusMiddleShellProfile Cmid d (R : Real) u
  let Q : ENNReal := ((R : ENNReal) ^ alpha * brrsKappa T R alpha) * 7
  have houtblock :
      (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
        ‖brrsStationaryWaveComponentIntegral Phi d .outgoing r t‖ₑ) ≤ Q * U := by
    simpa only [Q, U] using hout T R alpha hR hRlarge hT
  have hinblock :
      (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
        ‖brrsStationaryWaveComponentIntegral Phi d .incoming r t‖ₑ) ≤ Q * V := by
    simpa only [Q, V] using hin T R alpha hR hRlarge hT
  have hmidblock :
      (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
        ‖brrsStationaryWaveComponentIntegral Phi d .middle r t‖ₑ) ≤ Q * W := by
    simpa only [Q, W] using hmid T R alpha hR hRlarge hT
  have htriangle (t r : Real) (hr : r ∈ Icc (R : Real) (2 * (R : Real))) :
      ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) (r • v)‖ₑ ≤
        ‖brrsStationaryWaveComponentIntegral Phi d .outgoing r t‖ₑ +
          (‖brrsStationaryWaveComponentIntegral Phi d .incoming r t‖ₑ +
            ‖brrsStationaryWaveComponentIntegral Phi d .middle r t‖ₑ) := by
    have hr0 : 0 ≤ r := by linarith [hRlarge, hr.1]
    have hnorm : ‖r • v‖ = r := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hr0, hv, mul_one]
    have hsplit :=
      brrsDyadicHalfWaveKernel_eq_levelZero_sum_stationaryWaveComponents hd Phi t (r • v)
    rw [hnorm] at hsplit
    have hsplit' :
        (brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) (r • v) =
          brrsStationaryWaveComponentIntegral Phi d .outgoing r t +
            brrsStationaryWaveComponentIntegral Phi d .incoming r t +
              brrsStationaryWaveComponentIntegral Phi d .middle r t := by
      simpa only [brrsStationaryWaveComponentIntegral] using hsplit
    rw [hsplit']
    calc
      ‖brrsStationaryWaveComponentIntegral Phi d .outgoing r t +
          brrsStationaryWaveComponentIntegral Phi d .incoming r t +
            brrsStationaryWaveComponentIntegral Phi d .middle r t‖ₑ ≤
          ‖brrsStationaryWaveComponentIntegral Phi d .outgoing r t +
            brrsStationaryWaveComponentIntegral Phi d .incoming r t‖ₑ +
              ‖brrsStationaryWaveComponentIntegral Phi d .middle r t‖ₑ :=
        enorm_add_le _ _
      _ ≤ (‖brrsStationaryWaveComponentIntegral Phi d .outgoing r t‖ₑ +
          ‖brrsStationaryWaveComponentIntegral Phi d .incoming r t‖ₑ) +
            ‖brrsStationaryWaveComponentIntegral Phi d .middle r t‖ₑ := by
        gcongr
        exact enorm_add_le _ _
      _ = ‖brrsStationaryWaveComponentIntegral Phi d .outgoing r t‖ₑ +
          (‖brrsStationaryWaveComponentIntegral Phi d .incoming r t‖ₑ +
            ‖brrsStationaryWaveComponentIntegral Phi d .middle r t‖ₑ) := by
        ac_rfl
  have hlintegral (t : Real) :
      (∫⁻ r in Icc (R : Real) (2 * (R : Real)),
        ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) (r • v)‖ₑ) ≤
        (∫⁻ r in Icc (R : Real) (2 * (R : Real)),
          ‖brrsStationaryWaveComponentIntegral Phi d .outgoing r t‖ₑ) +
          ((∫⁻ r in Icc (R : Real) (2 * (R : Real)),
            ‖brrsStationaryWaveComponentIntegral Phi d .incoming r t‖ₑ) +
            ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
              ‖brrsStationaryWaveComponentIntegral Phi d .middle r t‖ₑ) := by
    calc
      (∫⁻ r in Icc (R : Real) (2 * (R : Real)),
        ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) (r • v)‖ₑ) ≤
          ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
            ‖brrsStationaryWaveComponentIntegral Phi d .outgoing r t‖ₑ +
              (‖brrsStationaryWaveComponentIntegral Phi d .incoming r t‖ₑ +
                ‖brrsStationaryWaveComponentIntegral Phi d .middle r t‖ₑ) := by
          exact setLIntegral_mono' measurableSet_Icc (fun r hr => htriangle t r hr)
      _ = (∫⁻ r in Icc (R : Real) (2 * (R : Real)),
            ‖brrsStationaryWaveComponentIntegral Phi d .outgoing r t‖ₑ) +
            ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
              ‖brrsStationaryWaveComponentIntegral Phi d .incoming r t‖ₑ +
                ‖brrsStationaryWaveComponentIntegral Phi d .middle r t‖ₑ := by
          rw [lintegral_add_left
            (measurable_enorm_brrsStationaryWaveComponentIntegral_radial
              Phi d .outgoing t)]
      _ = (∫⁻ r in Icc (R : Real) (2 * (R : Real)),
            ‖brrsStationaryWaveComponentIntegral Phi d .outgoing r t‖ₑ) +
            ((∫⁻ r in Icc (R : Real) (2 * (R : Real)),
              ‖brrsStationaryWaveComponentIntegral Phi d .incoming r t‖ₑ) +
              ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
                ‖brrsStationaryWaveComponentIntegral Phi d .middle r t‖ₑ) := by
          rw [lintegral_add_left
            (measurable_enorm_brrsStationaryWaveComponentIntegral_radial
              Phi d .incoming t)]
  have hsum :
      (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
        ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) (r • v)‖ₑ) ≤
        (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
          ‖brrsStationaryWaveComponentIntegral Phi d .outgoing r t‖ₑ) +
          ((∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
            ‖brrsStationaryWaveComponentIntegral Phi d .incoming r t‖ₑ) +
            ∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
              ‖brrsStationaryWaveComponentIntegral Phi d .middle r t‖ₑ) := by
    calc
      (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
        ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) (r • v)‖ₑ) ≤
          ∑ t ∈ T,
            ((∫⁻ r in Icc (R : Real) (2 * (R : Real)),
              ‖brrsStationaryWaveComponentIntegral Phi d .outgoing r t‖ₑ) +
              ((∫⁻ r in Icc (R : Real) (2 * (R : Real)),
                ‖brrsStationaryWaveComponentIntegral Phi d .incoming r t‖ₑ) +
                ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
                  ‖brrsStationaryWaveComponentIntegral Phi d .middle r t‖ₑ)) := by
          exact Finset.sum_le_sum fun t _ => hlintegral t
      _ = (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
            ‖brrsStationaryWaveComponentIntegral Phi d .outgoing r t‖ₑ) +
            ((∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
              ‖brrsStationaryWaveComponentIntegral Phi d .incoming r t‖ₑ) +
              ∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
                ‖brrsStationaryWaveComponentIntegral Phi d .middle r t‖ₑ) := by
          simp only [Finset.sum_add_distrib]
  change
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) (r • v)‖ₑ) ≤
      Q * (U + V + W)
  calc
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) (r • v)‖ₑ) ≤
        (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
          ‖brrsStationaryWaveComponentIntegral Phi d .outgoing r t‖ₑ) +
          ((∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
            ‖brrsStationaryWaveComponentIntegral Phi d .incoming r t‖ₑ) +
            ∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
              ‖brrsStationaryWaveComponentIntegral Phi d .middle r t‖ₑ) := hsum
    _ ≤ Q * U + (Q * V + Q * W) :=
      add_le_add houtblock (add_le_add hinblock hmidblock)
    _ = Q * (U + V + W) := by
      rw [mul_add, mul_add]
      ac_rfl

/-- Away from the outgoing cone, the actual level-zero BRRS half-wave kernel
has the all-dimensional cone-shell majorant obtained by summing its three
literal stationary components.  The displayed three profiles are the exact
outgoing, incoming, and middle radial phases. -/
theorem exists_norm_brrsDyadicHalfWaveKernel_levelZero_highRadius_offCone_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ t : Real, ∀ x : Euclidean d, 16 ≤ ‖x‖ →
      brrsSurfaceWavePhase .outgoing ‖x‖ + 2 * Real.pi * t ≠ 0 →
      brrsSurfaceWavePhase .incoming ‖x‖ + 2 * Real.pi * t ≠ 0 →
      brrsSurfaceWavePhase .middle ‖x‖ + 2 * Real.pi * t ≠ 0 →
      ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1)) *
            ((1 / |brrsSurfaceWavePhase .outgoing ‖x‖ + 2 * Real.pi * t|) ^ N +
              (1 / |brrsSurfaceWavePhase .incoming ‖x‖ + 2 * Real.pi * t|) ^ N +
                (1 / |brrsSurfaceWavePhase .middle ‖x‖ + 2 * Real.pi * t|) ^ N) := by
  obtain ⟨Cout, hCout, hout⟩ :=
    exists_norm_intervalIntegral_brrsStationaryWaveComponent_highRadius_le
      (d := d) (N := N) hd Phi .outgoing
  obtain ⟨Cin, hCin, hin⟩ :=
    exists_norm_intervalIntegral_brrsStationaryWaveComponent_highRadius_le
      (d := d) (N := N) hd Phi .incoming
  obtain ⟨Cmid, hCmid, hmid⟩ :=
    exists_norm_intervalIntegral_brrsStationaryWaveComponent_highRadius_le
      (d := d) (N := N) hd Phi .middle
  let C : Real := Cout + Cin + Cmid
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro t x hx houtfreq hinfreq hmidfreq
  let Iout : Complex := ∫ rho in (1 / 32 : Real)..1,
    ((rho ^ (d - 1) : Real) : Complex) *
      (brrsSurfaceWaveTerm d .outgoing ‖x‖ rho *
        brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho)
  let Iin : Complex := ∫ rho in (1 / 32 : Real)..1,
    ((rho ^ (d - 1) : Real) : Complex) *
      (brrsSurfaceWaveTerm d .incoming ‖x‖ rho *
        brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho)
  let Imid : Complex := ∫ rho in (1 / 32 : Real)..1,
    ((rho ^ (d - 1) : Real) : Complex) *
      (brrsSurfaceWaveTerm d .middle ‖x‖ rho *
        brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho)
  have hsplit : (brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x =
      Iout + Iin + Imid := by
    simpa only [Iout, Iin, Imid] using
      brrsDyadicHalfWaveKernel_eq_levelZero_sum_stationaryWaveComponents hd Phi t x
  have hIout := hout ‖x‖ t hx houtfreq
  have hIin := hin ‖x‖ t hx hinfreq
  have hImid := hmid ‖x‖ t hx hmidfreq
  change ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x‖ ≤ _
  rw [hsplit]
  have hqpos : 0 < (Real.sqrt (‖x‖ / 16)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hCoutle : Cout ≤ C := by
    dsimp [C]
    linarith
  have hCinle : Cin ≤ C := by
    dsimp [C]
    linarith
  have hCmidle : Cmid ≤ C := by
    dsimp [C]
    linarith
  have hIout' : ‖Iout‖ ≤
      (1 / |brrsSurfaceWavePhase .outgoing ‖x‖ + 2 * Real.pi * t|) ^ N *
        ((1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1))) := by
    dsimp [Iout]
    refine (hout ‖x‖ t hx houtfreq).trans ?_
    apply mul_le_mul_of_nonneg_left
    · apply mul_le_mul_of_nonneg_left
      · exact div_le_div_of_nonneg_right hCoutle hqpos.le
      · norm_num
    · positivity
  have hIin' : ‖Iin‖ ≤
      (1 / |brrsSurfaceWavePhase .incoming ‖x‖ + 2 * Real.pi * t|) ^ N *
        ((1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1))) := by
    dsimp [Iin]
    refine (hin ‖x‖ t hx hinfreq).trans ?_
    apply mul_le_mul_of_nonneg_left
    · apply mul_le_mul_of_nonneg_left
      · exact div_le_div_of_nonneg_right hCinle hqpos.le
      · norm_num
    · positivity
  have hImid' : ‖Imid‖ ≤
      (1 / |brrsSurfaceWavePhase .middle ‖x‖ + 2 * Real.pi * t|) ^ N *
        ((1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1))) := by
    dsimp [Imid]
    refine (hmid ‖x‖ t hx hmidfreq).trans ?_
    apply mul_le_mul_of_nonneg_left
    · apply mul_le_mul_of_nonneg_left
      · exact div_le_div_of_nonneg_right hCmidle hqpos.le
      · norm_num
    · positivity
  calc
    ‖Iout + Iin + Imid‖ ≤ ‖Iout + Iin‖ + ‖Imid‖ := norm_add_le _ _
    _ ≤ (‖Iout‖ + ‖Iin‖) + ‖Imid‖ := by
      gcongr
      exact norm_add_le _ _
    _ ≤
        ((1 / |brrsSurfaceWavePhase .outgoing ‖x‖ + 2 * Real.pi * t|) ^ N *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1))) +
          (1 / |brrsSurfaceWavePhase .incoming ‖x‖ + 2 * Real.pi * t|) ^ N *
            ((1 - (1 / 32 : Real)) *
              (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1)))) +
            (1 / |brrsSurfaceWavePhase .middle ‖x‖ + 2 * Real.pi * t|) ^ N *
              ((1 - (1 / 32 : Real)) *
                (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1))) := by
      gcongr
    _ = (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1)) *
            ((1 / |brrsSurfaceWavePhase .outgoing ‖x‖ + 2 * Real.pi * t|) ^ N +
              (1 / |brrsSurfaceWavePhase .incoming ‖x‖ + 2 * Real.pi * t|) ^ N +
                (1 / |brrsSurfaceWavePhase .middle ‖x‖ + 2 * Real.pi * t|) ^ N) := by
      ring

/-- The compact radial integral also has a uniform high-radius bound when no
oscillation is available (in particular, on the outgoing cone). -/
theorem exists_norm_intervalIntegral_brrsStatWaveRadialCoefficient_highRad_uniform_le
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff)
    (part : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ a freq : Real, 16 ≤ a →
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsStationaryWaveRadialCoefficient Phi d part a rho *
          oscillatoryExp freq rho‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (a / 16)) ^ (d - 1)) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_uniform_iteratedDeriv_brrsStationaryWaveRadialCoefficient_highRadius_decay
      (d := d) (N := 0) hd Phi part
  refine ⟨C, hC, ?_⟩
  intro a freq ha
  have hqpos : 0 < (Real.sqrt (a / 16)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  calc
    ‖∫ rho in (1 / 32 : Real)..1,
      brrsStationaryWaveRadialCoefficient Phi d part a rho *
        oscillatoryExp freq rho‖ ≤
        (C / (Real.sqrt (a / 16)) ^ (d - 1)) *
          |1 - (1 / 32 : Real)| := by
      apply intervalIntegral.norm_integral_le_of_norm_le_const
      intro rho hrho
      have hrho' : rho ∈ Icc (1 / 32 : Real) 1 := by
        rw [uIoc_of_le (by norm_num : (1 / 32 : Real) ≤ 1)] at hrho
        exact ⟨hrho.1.le, hrho.2⟩
      rw [norm_mul, norm_oscillatoryExp, mul_one]
      exact hbound 0 le_rfl a rho ha hrho'
    _ = (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (a / 16)) ^ (d - 1)) := by
      rw [abs_of_nonneg (by norm_num : (0 : Real) ≤ 1 - 1 / 32)]
      ring

/-- One literal stationary component is bounded by a bounded rapidly
decaying profile of its exact radial phase, including at the cone itself. -/
theorem exists_norm_intervalIntegral_brrsStationaryWaveComponent_highRadius_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff)
    (part : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ a t : Real, 16 ≤ a →
      ‖∫ rho in (1 / 32 : Real)..1,
        ((rho ^ (d - 1) : Real) : Complex) *
          (brrsSurfaceWaveTerm d part a rho *
            brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho)‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (a / 16)) ^ (d - 1)) *
            brrsStationaryRapidProfile N
              (brrsSurfaceWavePhase part a + 2 * Real.pi * t) := by
  obtain ⟨C0, hC0, huniform⟩ :=
    exists_norm_intervalIntegral_brrsStatWaveRadialCoefficient_highRad_uniform_le
      (d := d) hd Phi part
  obtain ⟨C1, hC1, hdecay⟩ :=
    exists_norm_intervalIntegral_brrsStationaryWaveRadialCoefficient_highRadius_le
      (d := d) (N := N) hd Phi part
  let C : Real := C0 + C1
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro a t ha
  let freq : Real := brrsSurfaceWavePhase part a + 2 * Real.pi * t
  let q : Real := (Real.sqrt (a / 16)) ^ (d - 1)
  let A : Real := (1 - (1 / 32 : Real)) * (C / q)
  have hqpos : 0 < q := by
    dsimp [q]
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hAnonneg : 0 ≤ A := by
    dsimp [A]
    positivity
  have hC0le : C0 ≤ C := by
    dsimp [C]
    linarith
  have hC1le : C1 ≤ C := by
    dsimp [C]
    linarith
  rw [intervalIntegral_brrsStationaryWaveComponent_eq_oscillatoryExp]
  change ‖∫ rho in (1 / 32 : Real)..1,
      brrsStationaryWaveRadialCoefficient Phi d part a rho *
        oscillatoryExp freq rho‖ ≤ A * brrsStationaryRapidProfile N freq
  by_cases hfreq : freq = 0
  · have hcomp : (1 - (1 / 32 : Real)) * (C0 / q) ≤ A := by
      dsimp [A]
      apply mul_le_mul_of_nonneg_left
      · exact div_le_div_of_nonneg_right hC0le hqpos.le
      · norm_num
    simpa [brrsStationaryRapidProfile, hfreq] using
      (huniform a 0 ha).trans hcomp
  · rw [brrsStationaryRapidProfile, if_neg hfreq]
    let r : Real := (1 / |freq|) ^ N
    have huniform' : ‖∫ rho in (1 / 32 : Real)..1,
        brrsStationaryWaveRadialCoefficient Phi d part a rho *
          oscillatoryExp freq rho‖ ≤ A := by
      refine (huniform a freq ha).trans ?_
      dsimp [A, q]
      apply mul_le_mul_of_nonneg_left
      · exact div_le_div_of_nonneg_right hC0le hqpos.le
      · norm_num
    have hdecay' : ‖∫ rho in (1 / 32 : Real)..1,
        brrsStationaryWaveRadialCoefficient Phi d part a rho *
          oscillatoryExp freq rho‖ ≤ r * A := by
      refine (hdecay a ha hfreq).trans ?_
      dsimp [r, A, q]
      apply mul_le_mul_of_nonneg_left
      · apply mul_le_mul_of_nonneg_left
        · exact div_le_div_of_nonneg_right hC1le hqpos.le
        · norm_num
      · positivity
    calc
      ‖∫ rho in (1 / 32 : Real)..1,
          brrsStationaryWaveRadialCoefficient Phi d part a rho *
            oscillatoryExp freq rho‖ ≤ min A (r * A) := le_min huniform' hdecay'
      _ = A * min 1 r := by
        calc
          min A (r * A) = min (A * 1) (A * r) := by
            congr 1 <;> ring
          _ = A * min 1 r := (mul_min_of_nonneg 1 r hAnonneg).symm
      _ = A * min 1 ((1 / |freq|) ^ N) := by rfl

/-- The all-dimensional level-zero BRRS kernel is dominated, at high spatial
radius, by a finite sum of bounded rapidly decaying one-dimensional profiles.
The three arguments are exactly the outgoing `2π(t-|x|)`, incoming
`2π(t+|x|)`, and middle `2πt` stationary phases.  This is the direct
kernel-to-radial-block interface used by the BRRS interval geometry. -/
theorem exists_norm_brrsDyadicHalfWaveKernel_levelZero_highRadius_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ t : Real, ∀ x : Euclidean d, 16 ≤ ‖x‖ →
      ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1)) *
            (brrsStationaryRapidProfile N (2 * Real.pi * (t - ‖x‖)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + ‖x‖)) +
                brrsStationaryRapidProfile N (2 * Real.pi * t)) := by
  obtain ⟨Cout, hCout, hout⟩ :=
    exists_norm_intervalIntegral_brrsStationaryWaveComponent_highRadius_profile_le
      (d := d) (N := N) hd Phi .outgoing
  obtain ⟨Cin, hCin, hin⟩ :=
    exists_norm_intervalIntegral_brrsStationaryWaveComponent_highRadius_profile_le
      (d := d) (N := N) hd Phi .incoming
  obtain ⟨Cmid, hCmid, hmid⟩ :=
    exists_norm_intervalIntegral_brrsStationaryWaveComponent_highRadius_profile_le
      (d := d) (N := N) hd Phi .middle
  let C : Real := Cout + Cin + Cmid
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro t x hx
  let Iout : Complex := ∫ rho in (1 / 32 : Real)..1,
    ((rho ^ (d - 1) : Real) : Complex) *
      (brrsSurfaceWaveTerm d .outgoing ‖x‖ rho *
        brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho)
  let Iin : Complex := ∫ rho in (1 / 32 : Real)..1,
    ((rho ^ (d - 1) : Real) : Complex) *
      (brrsSurfaceWaveTerm d .incoming ‖x‖ rho *
        brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho)
  let Imid : Complex := ∫ rho in (1 / 32 : Real)..1,
    ((rho ^ (d - 1) : Real) : Complex) *
      (brrsSurfaceWaveTerm d .middle ‖x‖ rho *
        brrsDyadicHalfWaveKernelRadialProfile Phi 0 t rho)
  have hsplit : (brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x =
      Iout + Iin + Imid := by
    simpa only [Iout, Iin, Imid] using
      brrsDyadicHalfWaveKernel_eq_levelZero_sum_stationaryWaveComponents hd Phi t x
  have hqpos : 0 < (Real.sqrt (‖x‖ / 16)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hCoutle : Cout ≤ C := by
    dsimp [C]
    linarith
  have hCinle : Cin ≤ C := by
    dsimp [C]
    linarith
  have hCmidle : Cmid ≤ C := by
    dsimp [C]
    linarith
  have hphaseout : brrsSurfaceWavePhase .outgoing ‖x‖ + 2 * Real.pi * t =
      2 * Real.pi * (t - ‖x‖) := by
    simp only [brrsSurfaceWavePhase]
    ring
  have hphasein : brrsSurfaceWavePhase .incoming ‖x‖ + 2 * Real.pi * t =
      2 * Real.pi * (t + ‖x‖) := by
    simp only [brrsSurfaceWavePhase]
    ring
  have hphasemid : brrsSurfaceWavePhase .middle ‖x‖ + 2 * Real.pi * t =
      2 * Real.pi * t := by
    simp only [brrsSurfaceWavePhase]
    ring
  have hIout' : ‖Iout‖ ≤
      (1 - (1 / 32 : Real)) *
        (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1)) *
          brrsStationaryRapidProfile N (2 * Real.pi * (t - ‖x‖)) := by
    dsimp [Iout]
    rw [← hphaseout]
    refine (hout ‖x‖ t hx).trans ?_
    apply mul_le_mul_of_nonneg_right
    · apply mul_le_mul_of_nonneg_left
      · exact div_le_div_of_nonneg_right hCoutle hqpos.le
      · norm_num
    · exact brrsStationaryRapidProfile_nonneg N _
  have hIin' : ‖Iin‖ ≤
      (1 - (1 / 32 : Real)) *
        (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1)) *
          brrsStationaryRapidProfile N (2 * Real.pi * (t + ‖x‖)) := by
    dsimp [Iin]
    rw [← hphasein]
    refine (hin ‖x‖ t hx).trans ?_
    apply mul_le_mul_of_nonneg_right
    · apply mul_le_mul_of_nonneg_left
      · exact div_le_div_of_nonneg_right hCinle hqpos.le
      · norm_num
    · exact brrsStationaryRapidProfile_nonneg N _
  have hImid' : ‖Imid‖ ≤
      (1 - (1 / 32 : Real)) *
        (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1)) *
          brrsStationaryRapidProfile N (2 * Real.pi * t) := by
    dsimp [Imid]
    rw [← hphasemid]
    refine (hmid ‖x‖ t hx).trans ?_
    apply mul_le_mul_of_nonneg_right
    · apply mul_le_mul_of_nonneg_left
      · exact div_le_div_of_nonneg_right hCmidle hqpos.le
      · norm_num
    · exact brrsStationaryRapidProfile_nonneg N _
  rw [hsplit]
  calc
    ‖Iout + Iin + Imid‖ ≤ ‖Iout + Iin‖ + ‖Imid‖ := norm_add_le _ _
    _ ≤ (‖Iout‖ + ‖Iin‖) + ‖Imid‖ := by
      gcongr
      exact norm_add_le _ _
    _ ≤
        ((1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1)) *
            brrsStationaryRapidProfile N (2 * Real.pi * (t - ‖x‖)) +
          (1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1)) *
              brrsStationaryRapidProfile N (2 * Real.pi * (t + ‖x‖))) +
            (1 - (1 / 32 : Real)) *
              (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1)) *
                brrsStationaryRapidProfile N (2 * Real.pi * t) := by
      gcongr
    _ = (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1)) *
            (brrsStationaryRapidProfile N (2 * Real.pi * (t - ‖x‖)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + ‖x‖)) +
                brrsStationaryRapidProfile N (2 * Real.pi * t)) := by
      ring

/-- The level-zero stationary profile has an exact all-frequency transport.
The statement intentionally retains the dilation factor and the scaled
radial variable verbatim: this is the form that can be inserted into the
dyadic radial-block argument without silently changing variables. -/
theorem exists_norm_brrsDyadicHalfWaveKernel_highRadius_scaled_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ t : Real, ∀ x : Euclidean d,
      16 ≤ ((2 : Real) ^ j) * ‖x‖ →
      ‖(brrsDyadicHalfWaveKernel Phi j t : Euclidean d → Complex) x‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt ((((2 : Real) ^ j) * ‖x‖) / 16)) ^ (d - 1)) *
              (brrsStationaryRapidProfile N
                  (2 * Real.pi * (((2 : Real) ^ j * t) -
                    ((2 : Real) ^ j * ‖x‖))) +
                brrsStationaryRapidProfile N
                  (2 * Real.pi * (((2 : Real) ^ j * t) +
                    ((2 : Real) ^ j * ‖x‖))) +
                  brrsStationaryRapidProfile N
                    (2 * Real.pi * ((2 : Real) ^ j * t)))) := by
  obtain ⟨C, hC, hlevel⟩ :=
    exists_norm_brrsDyadicHalfWaveKernel_levelZero_highRadius_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j t x hx
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hnorm : ‖q • x‖ = q * ‖x‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hq]
  have hscaled : 16 ≤ ‖q • x‖ := by
    rw [hnorm]
    simpa only [q] using hx
  have hkernel :
      (brrsDyadicHalfWaveKernel Phi j t : Euclidean d → Complex) x =
        q ^ d •
          (brrsDyadicHalfWaveKernel Phi 0 (q * t) : Euclidean d → Complex)
            (q • x) := by
    simpa only [q] using
      (brrsDyadicHalfWaveKernel_eq_levelZero_scaled_general Phi j t x)
  rw [hkernel]
  calc
    ‖q ^ d •
        (brrsDyadicHalfWaveKernel Phi 0 (q * t) : Euclidean d → Complex)
          (q • x)‖ =
        ‖q ^ d‖ *
          ‖(brrsDyadicHalfWaveKernel Phi 0 (q * t) : Euclidean d → Complex)
            (q • x)‖ := norm_smul _ _
    _ ≤ ‖q ^ d‖ *
        ((1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (‖q • x‖ / 16)) ^ (d - 1)) *
            (brrsStationaryRapidProfile N
                (2 * Real.pi * (q * t - ‖q • x‖)) +
              brrsStationaryRapidProfile N
                (2 * Real.pi * (q * t + ‖q • x‖)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (q * t)))) := by
      exact mul_le_mul_of_nonneg_left
        (hlevel (q * t) (q • x) hscaled) (norm_nonneg _)
    _ = ‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt ((((2 : Real) ^ j) * ‖x‖) / 16)) ^ (d - 1)) *
              (brrsStationaryRapidProfile N
                  (2 * Real.pi * (((2 : Real) ^ j * t) -
                    ((2 : Real) ^ j * ‖x‖))) +
                brrsStationaryRapidProfile N
                  (2 * Real.pi * (((2 : Real) ^ j * t) +
                    ((2 : Real) ^ j * ‖x‖))) +
                  brrsStationaryRapidProfile N
                    (2 * Real.pi * ((2 : Real) ^ j * t)))) := by
      rw [hnorm]

/-- The high-radius stationary profile applies directly to the literal BRRS
adjoint test packet.  The reflected-conjugate identification above is crucial
here: this is an estimate for the actual input packet, not merely for its
`TT*` propagation.  The remaining compact scaled-radius region requires the
separate nonstationary integration-by-parts estimate. -/
theorem exists_norm_brrsPositiveRadialHalfWaveTestPacket_highRadius_scaled_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ referenceTime : Real, ∀ x : Euclidean d,
      16 ≤ ((2 : Real) ^ j) * ‖x‖ →
      ‖brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime x‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt ((((2 : Real) ^ j) * ‖x‖) / 16)) ^ (d - 1)) *
              (brrsStationaryRapidProfile N
                  (2 * Real.pi * (((2 : Real) ^ j * referenceTime) -
                    ((2 : Real) ^ j * ‖x‖))) +
                brrsStationaryRapidProfile N
                  (2 * Real.pi * (((2 : Real) ^ j * referenceTime) +
                    ((2 : Real) ^ j * ‖x‖))) +
                  brrsStationaryRapidProfile N
                    (2 * Real.pi * ((2 : Real) ^ j * referenceTime)))) := by
  obtain ⟨C, hC, hkernel⟩ :=
    exists_norm_brrsDyadicHalfWaveKernel_highRadius_scaled_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j referenceTime x hx
  have hneg : 16 ≤ ((2 : Real) ^ j) * ‖-x‖ := by
    simpa only [norm_neg] using hx
  have h := hkernel j referenceTime (-x) hneg
  rw [brrsPositiveRadialHalfWaveTestPacket_eq_star_neg_halfWaveKernel]
  change ‖star ((brrsDyadicHalfWaveKernel Phi j referenceTime : Euclidean d → Complex)
    (-x))‖ ≤ _
  rw [norm_star]
  simpa only [norm_neg] using h

/-- On a high radial block, the stationary-wave spatial factor can be
replaced by its value at the inner radius.  This is the elementary monotonicity
step which makes the literal kernel profile usable with radial block
decompositions. -/
private theorem brrs_highRadius_radial_decay_le_innerRadius
    {d : Nat} {C R r : Real} (hC : 0 ≤ C) (hR : 16 ≤ R) (hRr : R ≤ r) :
    C / (Real.sqrt (r / 16)) ^ (d - 1) ≤
      C / (Real.sqrt (R / 16)) ^ (d - 1) := by
  have hR0 : 0 ≤ R / 16 := by positivity
  have hRpos : 0 < R / 16 := by positivity
  have hRr' : R / 16 ≤ r / 16 := by
    gcongr
  have hsqrt : Real.sqrt (R / 16) ≤ Real.sqrt (r / 16) :=
    Real.sqrt_le_sqrt hRr'
  have hpow : (Real.sqrt (R / 16)) ^ (d - 1) ≤
      (Real.sqrt (r / 16)) ^ (d - 1) :=
    pow_le_pow_left₀ (Real.sqrt_nonneg _) hsqrt _
  have hdenpos : 0 < (Real.sqrt (R / 16)) ^ (d - 1) :=
    pow_pos (Real.sqrt_pos.2 hRpos) _
  exact div_le_div_of_nonneg_left hC hdenpos hpow

/-- A finite radial time block inherits the literal level-zero kernel's three
stationary one-dimensional profiles.  The conclusion is pointwise in the
radial variable `r ∈ [R,2R]`, hence can be integrated against any radial block
weight without further Fourier analysis.  It is deliberately stated for every
finite set of times (and is therefore stronger than the BRRS use with
`T ⊆ [1,2]`). -/
theorem exists_sum_norm_brrsDyadicHalfWaveKernel_levelZero_highRadius_radialBlock_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ (T : Finset Real) (R r : Real) (v : Euclidean d),
      16 ≤ R → r ∈ Icc R (2 * R) → ‖v‖ = 1 →
        (∑ t ∈ T,
          ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) (r • v)‖) ≤
          (1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (R / 16)) ^ (d - 1)) *
              ∑ t ∈ T,
                (brrsStationaryRapidProfile N (2 * Real.pi * (t - r)) +
                  brrsStationaryRapidProfile N (2 * Real.pi * (t + r)) +
                    brrsStationaryRapidProfile N (2 * Real.pi * t)) := by
  obtain ⟨C, hC, hkernel⟩ :=
    exists_norm_brrsDyadicHalfWaveKernel_levelZero_highRadius_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro T R r v hR hr hv
  have hr0 : 0 ≤ r := le_trans (by norm_num : (0 : Real) ≤ 16) (hR.trans hr.1)
  have hnorm : ‖r • v‖ = r := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hr0, hv, mul_one]
  have hradial : 16 ≤ ‖r • v‖ := by
    rw [hnorm]
    exact hR.trans hr.1
  have hdecay : C / (Real.sqrt (r / 16)) ^ (d - 1) ≤
      C / (Real.sqrt (R / 16)) ^ (d - 1) :=
    brrs_highRadius_radial_decay_le_innerRadius hC.le hR hr.1
  have hprofiles_nonneg (t : Real) :
      0 ≤ brrsStationaryRapidProfile N (2 * Real.pi * (t - r)) +
        brrsStationaryRapidProfile N (2 * Real.pi * (t + r)) +
          brrsStationaryRapidProfile N (2 * Real.pi * t) := by
    exact add_nonneg
      (add_nonneg (brrsStationaryRapidProfile_nonneg N _)
        (brrsStationaryRapidProfile_nonneg N _))
      (brrsStationaryRapidProfile_nonneg N _)
  have hterm (t : Real) :
      ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) (r • v)‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (R / 16)) ^ (d - 1)) *
            (brrsStationaryRapidProfile N (2 * Real.pi * (t - r)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r)) +
                brrsStationaryRapidProfile N (2 * Real.pi * t)) := by
    have hpoint := hkernel t (r • v) hradial
    rw [hnorm] at hpoint
    calc
      ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) (r • v)‖ ≤
          (1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
              (brrsStationaryRapidProfile N (2 * Real.pi * (t - r)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r)) +
                  brrsStationaryRapidProfile N (2 * Real.pi * t)) := hpoint
      _ ≤ (1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (R / 16)) ^ (d - 1)) *
              (brrsStationaryRapidProfile N (2 * Real.pi * (t - r)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r)) +
                  brrsStationaryRapidProfile N (2 * Real.pi * t)) := by
        apply mul_le_mul_of_nonneg_right
        · apply mul_le_mul_of_nonneg_left hdecay
          norm_num
        · exact hprofiles_nonneg t
  calc
    (∑ t ∈ T,
        ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) (r • v)‖) ≤
        ∑ t ∈ T,
          (1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (R / 16)) ^ (d - 1)) *
              (brrsStationaryRapidProfile N (2 * Real.pi * (t - r)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r)) +
                  brrsStationaryRapidProfile N (2 * Real.pi * t)) := by
      exact Finset.sum_le_sum fun t ht => hterm t
    _ = (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (R / 16)) ^ (d - 1)) *
            ∑ t ∈ T,
              (brrsStationaryRapidProfile N (2 * Real.pi * (t - r)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r)) +
                  brrsStationaryRapidProfile N (2 * Real.pi * t)) := by
      rw [Finset.mul_sum]


end
