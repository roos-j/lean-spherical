/-! ### Polar `L^p` profiles for radial data

The stationary two-radius formula acts on the scalar restriction of a radial
input to a unit ray.  These lemmas give the exact measure-theoretic bridge
between that one-dimensional profile and the ambient Euclidean `L^p` moment.
They deliberately use `volumeIoiPow` rather than hiding the radial Jacobian
inside a change of notation. -/

/-- The nonnegative scalar restriction of a function to the ray through a
unit vector.  Its `p`-th power is the input profile that occurs in the
one-dimensional stationary estimates. -/
def brrsRadialNormProfile {d : Nat} (f : BRRSSpace d → Complex)
    (w : BRRSSpace d) : Real → ENNReal :=
  fun r => ENNReal.ofReal ‖f (r • w)‖

/-- The `p`-moment version of `brrsRadialNormProfile`. -/
def brrsRadialLpProfile {d : Nat} (p : Real) (f : BRRSSpace d → Complex)
    (w : BRRSSpace d) : Real → ENNReal :=
  fun r => brrsRadialNormProfile f w r ^ p

/-- Measurability of the scalar radial norm profile. -/
theorem measurable_brrsRadialNormProfile {d : Nat}
    (f : BRRSSpace d → Complex) (hf : Measurable f) (w : BRRSSpace d) :
    Measurable (brrsRadialNormProfile f w) := by
  unfold brrsRadialNormProfile
  exact (hf.comp (continuous_id.smul continuous_const).measurable).norm.ennreal_ofReal

/-- Measurability of every real-power radial `L^p` profile. -/
theorem measurable_brrsRadialLpProfile {d : Nat} (p : Real)
    (f : BRRSSpace d → Complex) (hf : Measurable f) (w : BRRSSpace d) :
    Measurable (brrsRadialLpProfile p f w) := by
  unfold brrsRadialLpProfile
  exact ENNReal.continuous_rpow_const.measurable.comp
    (measurable_brrsRadialNormProfile f hf w)

/-- Exact polar-coordinate formula for the `p`-moment of a measurable radial
function.  The profile may be read on any unit ray. -/
theorem brrs_lintegral_radial_norm_rpow_eq_polar
    {d : Nat} (hd : 0 < d) (f : BRRSSpace d → Complex)
    (hf : IsRadial f) (hfm : Measurable f) (p : Real)
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    (∫⁻ x : BRRSSpace d, (ENNReal.ofReal ‖f x‖) ^ p) =
      ENNReal.ofReal (surfaceMass d) *
        ∫⁻ r : Ioi (0 : Real), brrsRadialLpProfile p f w r.1
          ∂Measure.volumeIoiPow (d - 1) := by
  let F : Real → ENNReal := brrsRadialLpProfile p f w
  have hF : Measurable F := measurable_brrsRadialLpProfile p f hfm w
  have hradial : ∀ x : BRRSSpace d,
      (ENNReal.ofReal ‖f x‖) ^ p = F ‖x‖ := by
    intro x
    dsimp only [F, brrsRadialLpProfile, brrsRadialNormProfile]
    rw [hf x (‖x‖ • w)]
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _), hw, mul_one]
  calc
    (∫⁻ x : BRRSSpace d, (ENNReal.ofReal ‖f x‖) ^ p) =
        ∫⁻ x : BRRSSpace d, F ‖x‖ := by
      apply lintegral_congr
      intro x
      exact hradial x
    _ = ENNReal.ofReal (surfaceMass d) *
        ∫⁻ r in Ioi (0 : Real), ENNReal.ofReal r ^ (d - 1) * F r :=
      Auto.Spherical.SurfaceMeasureDecay.lintegral_euclidean_radial hd F hF
    _ = ENNReal.ofReal (surfaceMass d) *
        ∫⁻ r : Ioi (0 : Real), brrsRadialLpProfile p f w r.1
          ∂Measure.volumeIoiPow (d - 1) := by
      rw [Auto.Spherical.SurfaceMeasureDecay.lintegral_volumeIoiPow (d - 1) F hF]

/-- The preceding polar identity in the `eLpNorm` normalization.  It is the
form used to turn a one-dimensional stationary estimate into a radial spatial
`L^p` estimate. -/
theorem brrs_eLpNorm_rpow_radial_eq_polar
    {d : Nat} (hd : 0 < d) (f : BRRSSpace d → Complex)
    (hf : IsRadial f) (hfm : Measurable f) {p : Real} (hp : 0 < p)
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    (eLpNorm f (ENNReal.ofReal p) volume) ^ p =
      ENNReal.ofReal (surfaceMass d) *
        ∫⁻ r : Ioi (0 : Real), brrsRadialLpProfile p f w r.1
          ∂Measure.volumeIoiPow (d - 1) := by
  rw [← Auto.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow hp f
    hfm.aestronglyMeasurable]
  exact brrs_lintegral_radial_norm_rpow_eq_polar hd f hf hfm p w hw

/-- A Schwartz radial datum has the polar `L^p` identity without a separate
measurability hypothesis. -/
theorem brrs_eLpNorm_rpow_radial_schwartz_eq_polar
    {d : Nat} (hd : 0 < d) (f : BRRSSchwartz d)
    (hf : IsRadial (f : BRRSSpace d → Complex)) {p : Real} (hp : 0 < p)
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    (eLpNorm (f : BRRSSpace d → Complex) (ENNReal.ofReal p) volume) ^ p =
      ENNReal.ofReal (surfaceMass d) *
        ∫⁻ r : Ioi (0 : Real),
          brrsRadialLpProfile p (f : BRRSSpace d → Complex) w r.1
          ∂Measure.volumeIoiPow (d - 1) := by
  exact brrs_eLpNorm_rpow_radial_eq_polar hd (f : BRRSSpace d → Complex) hf
    f.continuous.measurable hp w hw

/-- The polar-coordinate identity applies directly to the literal dyadic
half-wave of a radial Schwartz datum.  The only extra point here is
measurability: the Fourier formula agrees pointwise with convolution by the
Schwartz half-wave kernel, which is continuous on the integrable Schwartz
input.  This is the output-side bridge used when a one-dimensional radial
estimate is converted back to the spatial `L^p` moment. -/
theorem brrs_eLpNorm_rpow_brrsDyadicHalfWave_radial_eq_polar
    {d : Nat} (hd : 0 < d) (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d → Complex))
    {p : Real} (hp : 0 < p) (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    (eLpNorm (brrsDyadicHalfWave Phi j t f) (ENNReal.ofReal p) volume) ^ p =
      ENNReal.ofReal (surfaceMass d) *
        ∫⁻ r : Ioi (0 : Real),
          brrsRadialLpProfile p (brrsDyadicHalfWave Phi j t f) w r.1
          ∂Measure.volumeIoiPow (d - 1) := by
  refine brrs_eLpNorm_rpow_radial_eq_polar hd
    (brrsDyadicHalfWave Phi j t f)
    (brrsDyadicHalfWave_isRadial Phi j t f hf) ?_ hp w hw
  let g : BRRSSchwartz d := SchwartzMap.smulLeftCLM Complex
    (brrsDyadicHalfWaveSchwartzSymbol Phi j t : BRRSSpace d → Complex) (𝓕 f)
  let q : BRRSSchwartz d := 𝓕⁻ g
  have hg : (g : BRRSSpace d → Complex) = fun xi : BRRSSpace d =>
      brrsDyadicHalfWaveSchwartzSymbol Phi j t xi *
        𝓕 (f : BRRSSpace d → Complex) xi := by
    funext xi
    simp only [g, SchwartzMap.smulLeftCLM_apply
      (brrsDyadicHalfWaveSchwartzSymbol Phi j t).hasTemperateGrowth, smul_eq_mul]
    rw [SchwartzMap.fourier_coe]
  have hq : (q : BRRSSpace d → Complex) = brrsDyadicHalfWave Phi j t f := by
    funext x
    dsimp [q]
    rw [SchwartzMap.fourierInv_coe, brrsDyadicHalfWave, hg]
    simp only [brrsDyadicHalfWaveSchwartzSymbol_apply,
      brrsDyadicHalfWaveSymbol]
  rw [← hq]
  exact q.continuous.measurable

/-- The one-dimensional source profile whose ordinary Lebesgue `L^p` moment
is exactly the polar radial `L^p` moment.  This is the normalization used
when the two-radius stationary kernel is reduced to the Section 5
convolution estimates: the factor `s^((d - 1) / p)` absorbs the polar
Jacobian into the input rather than into the kernel. -/
noncomputable def brrsRadialLpSourceProfile {d : Nat} (p : Real)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) : Real → ENNReal :=
  fun s => (ENNReal.ofReal s) ^ (((d : Real) - 1) / p) *
    ENNReal.ofReal ‖f (s • w)‖

/-- Measurability of the weighted one-dimensional radial source profile. -/
theorem measurable_brrsRadialLpSourceProfile {d : Nat} (p : Real)
    (f : BRRSSpace d → Complex) (hf : Measurable f) (w : BRRSSpace d) :
    Measurable (brrsRadialLpSourceProfile p f w) := by
  unfold brrsRadialLpSourceProfile
  apply Measurable.mul
  · exact ENNReal.continuous_rpow_const.measurable.comp
      ENNReal.continuous_ofReal.measurable
  · exact (hf.comp (continuous_id.smul continuous_const).measurable).norm.ennreal_ofReal

/-- Taking the `p`-th power of the weighted source profile restores the
literal polar density.  The identity is pointwise on the positive radial
half-line and does not use radiality of the input. -/
theorem brrsRadialLpSourceProfile_rpow_eq_polarDensity
    {d : Nat} (hd : 1 ≤ d) {p : Real} (hp : 0 < p)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) {s : Real} (_hs : 0 < s) :
    (brrsRadialLpSourceProfile p f w s) ^ p =
      ENNReal.ofReal s ^ (d - 1) *
        (ENNReal.ofReal ‖f (s • w)‖) ^ p := by
  have hcast : (d : Real) - 1 = ((d - 1 : Nat) : Real) := by
    norm_num [Nat.cast_sub hd]
  have hpower : (((d : Real) - 1) / p) * p = (d : Real) - 1 := by
    field_simp [hp.ne']
  unfold brrsRadialLpSourceProfile
  rw [ENNReal.mul_rpow_of_nonneg _ _ hp.le, ← ENNReal.rpow_mul, hpower,
    hcast, ← ENNReal.rpow_natCast]

/-- The `p`-moment of the one-dimensional weighted source profile is the
same polar moment appearing in the radial `L^p` formula. -/
theorem brrs_lintegral_radialLpSourceProfile_rpow_eq_polar
    {d : Nat} (hd : 1 ≤ d) {p : Real} (hp : 0 < p)
    (f : BRRSSpace d → Complex) (hfm : Measurable f) (w : BRRSSpace d) :
    (∫⁻ s in Ioi (0 : Real), (brrsRadialLpSourceProfile p f w s) ^ p) =
      ∫⁻ s : Ioi (0 : Real), brrsRadialLpProfile p f w s.1
        ∂Measure.volumeIoiPow (d - 1) := by
  rw [Auto.Spherical.SurfaceMeasureDecay.lintegral_volumeIoiPow (d - 1)
    (brrsRadialLpProfile p f w) (measurable_brrsRadialLpProfile p f hfm w)]
  apply setLIntegral_congr_fun measurableSet_Ioi
  intro s hs
  change (brrsRadialLpSourceProfile p f w s) ^ p =
    ENNReal.ofReal s ^ (d - 1) * brrsRadialLpProfile p f w s
  rw [brrsRadialLpSourceProfile_rpow_eq_polarDensity hd hp f w hs]
  rfl

/-- In dimensions at least two the weighted source profile vanishes on the
nonpositive half-line.  Thus its ordinary one-dimensional `L^p` moment is
literally the positive-ray polar moment, so it can be passed directly to the
Section 5 convolution lemmas (which integrate over all of `ℝ`). -/
theorem brrs_lintegral_radialLpSourceProfile_rpow_eq_polar_full
    {d : Nat} (hd : 2 ≤ d) {p : Real} (hp : 0 < p)
    (f : BRRSSpace d → Complex) (hfm : Measurable f) (w : BRRSSpace d) :
    (∫⁻ s : Real, (brrsRadialLpSourceProfile p f w s) ^ p) =
      ∫⁻ s : Ioi (0 : Real), brrsRadialLpProfile p f w s.1
        ∂Measure.volumeIoiPow (d - 1) := by
  have hdreal : 0 < (d : Real) - 1 := by
    have hd' : (2 : Real) ≤ d := by exact_mod_cast hd
    linarith
  have hsourcePower : 0 < ((d : Real) - 1) / p := div_pos hdreal hp
  have hsupport : ∀ s : Real, s ∉ Ioi (0 : Real) →
      (brrsRadialLpSourceProfile p f w s) ^ p = 0 := by
    intro s hs
    have hs0 : s ≤ 0 := le_of_not_gt hs
    have hzero : ENNReal.ofReal s = 0 := ENNReal.ofReal_eq_zero.mpr hs0
    simp [brrsRadialLpSourceProfile, hzero,
      ENNReal.zero_rpow_of_pos hsourcePower, ENNReal.zero_rpow_of_pos hp]
  calc
    (∫⁻ s : Real, (brrsRadialLpSourceProfile p f w s) ^ p) =
        ∫⁻ s : Real, (brrsRadialLpSourceProfile p f w s) ^ p
          ∂volume.restrict (Ioi (0 : Real)) :=
      Auto.Spherical.PowerWeights.lintegral_eq_lintegral_restrict_of_support
        (Ioi (0 : Real)) measurableSet_Ioi
        (fun s : Real => (brrsRadialLpSourceProfile p f w s) ^ p) hsupport
    _ = ∫⁻ s in Ioi (0 : Real), (brrsRadialLpSourceProfile p f w s) ^ p := rfl
    _ = ∫⁻ s : Ioi (0 : Real), brrsRadialLpProfile p f w s.1
          ∂Measure.volumeIoiPow (d - 1) :=
      brrs_lintegral_radialLpSourceProfile_rpow_eq_polar (by omega) hp f hfm w

/-- Combining the weighted source-profile identity with polar coordinates
expresses a radial Euclidean `L^p` norm as an ordinary one-dimensional
positive-ray moment. -/
theorem brrs_eLpNorm_rpow_radial_eq_sourceProfile
    {d : Nat} (hd : 1 ≤ d) (f : BRRSSpace d → Complex)
    (hf : IsRadial f) (hfm : Measurable f) {p : Real} (hp : 0 < p)
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    (eLpNorm f (ENNReal.ofReal p) volume) ^ p =
      ENNReal.ofReal (surfaceMass d) *
        ∫⁻ s in Ioi (0 : Real), (brrsRadialLpSourceProfile p f w s) ^ p := by
  rw [brrs_eLpNorm_rpow_radial_eq_polar hd f hf hfm hp w hw]
  rw [← brrs_lintegral_radialLpSourceProfile_rpow_eq_polar hd hp f hfm w]

/-- The ambient radial `L^p` norm also equals the full-line source-profile
moment in dimensions at least two. -/
theorem brrs_eLpNorm_rpow_radial_eq_sourceProfile_full
    {d : Nat} (hd : 2 ≤ d) (f : BRRSSpace d → Complex)
    (hf : IsRadial f) (hfm : Measurable f) {p : Real} (hp : 0 < p)
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    (eLpNorm f (ENNReal.ofReal p) volume) ^ p =
      ENNReal.ofReal (surfaceMass d) *
        ∫⁻ s : Real, (brrsRadialLpSourceProfile p f w s) ^ p := by
  have hIoi := brrs_lintegral_radialLpSourceProfile_rpow_eq_polar
    (d := d) (by omega) hp f hfm w
  have hfull := brrs_lintegral_radialLpSourceProfile_rpow_eq_polar_full
    (d := d) hd hp f hfm w
  rw [brrs_eLpNorm_rpow_radial_eq_sourceProfile (by omega) f hf hfm hp w hw]
  exact congrArg (fun z : ENNReal => ENNReal.ofReal (surfaceMass d) * z)
    (hIoi.trans hfull.symm)

/-- Schwartz radial data satisfy the same source-profile normalization without
an additional measurability hypothesis. -/
theorem brrs_eLpNorm_rpow_radial_schwartz_eq_sourceProfile
    {d : Nat} (hd : 1 ≤ d) (f : BRRSSchwartz d)
    (hf : IsRadial (f : BRRSSpace d → Complex)) {p : Real} (hp : 0 < p)
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    (eLpNorm (f : BRRSSpace d → Complex) (ENNReal.ofReal p) volume) ^ p =
      ENNReal.ofReal (surfaceMass d) *
        ∫⁻ s in Ioi (0 : Real),
          (brrsRadialLpSourceProfile p (f : BRRSSpace d → Complex) w s) ^ p := by
  exact brrs_eLpNorm_rpow_radial_eq_sourceProfile hd
    (f : BRRSSpace d → Complex) hf f.continuous.measurable hp w hw

/-! ### Initial-cell localization for scaled cubic profiles

The `I₀` overlap argument needs a local-time profile, rather than merely a
global convolution bound.  The following elementary package supplies that
missing geometric step for the cubic Japanese profile at the dyadic scale.
It is deliberately independent of the half-wave: an analytic stationary
estimate can feed its scalar majorant into this result without reopening the
bounded-overlap bookkeeping.
-/

/-- The cubic profile convolved at physical scale `q⁻¹`.  We do not
normalize the kernel here: the compensating factor `q` occurs in the local
profile below, so its global mass remains scale-free. -/
noncomputable def brrsI0ScaledCubicConvolution
    (q : Real) (g : Real → ENNReal) : Real → ENNReal :=
  fun x => ∫⁻ s : Real, brrsCubicJapaneseProfile (q * (x - s)) * g s

/-- Measurability of the scaled cubic profile convolution. -/
theorem measurable_brrsI0ScaledCubicConvolution
    (q : Real) {g : Real → ENNReal} (hg : Measurable g) :
    Measurable (brrsI0ScaledCubicConvolution q g) := by
  unfold brrsI0ScaledCubicConvolution
  apply Measurable.lintegral_prod_right
  change Measurable (fun z : Real × Real =>
    brrsCubicJapaneseProfile (q * (z.1 - z.2)) * g z.2)
  exact (measurable_brrsCubicJapaneseProfile.comp
    (measurable_const.mul (measurable_fst.sub measurable_snd))).mul
      (hg.comp measurable_snd)

/-- At exponent one, the full-line source profile is the literal polar
density on the positive ray.  This makes the compact radial block compatible
with the cubic convolution API without discarding its radial Jacobian. -/
theorem brrsRadialLpSourceProfile_one_eq_polarDensity
    {d : Nat} (hd : 1 ≤ d) (f : BRRSSpace d → Complex)
    (w : BRRSSpace d) {s : Real} (hs : 0 < s) :
    brrsRadialLpSourceProfile (d := d) 1 f w s =
      ENNReal.ofReal s ^ (d - 1) * ENNReal.ofReal ‖f (s • w)‖ := by
  simpa using
    (brrsRadialLpSourceProfile_rpow_eq_polarDensity hd (p := (1 : Real))
      (by norm_num) f w hs)

/-- In dimensions at least two, the exponent-one source profile is supported
on the positive radius ray. -/
theorem brrsRadialLpSourceProfile_one_eq_zero_of_nonpos
    {d : Nat} (hd : 2 ≤ d) (f : BRRSSpace d → Complex)
    (w : BRRSSpace d) {s : Real} (hs : s ≤ 0) :
    brrsRadialLpSourceProfile (d := d) 1 f w s = 0 := by
  have hdreal : 0 < (d : Real) - 1 := by
    have hd' : (2 : Real) ≤ d := by exact_mod_cast hd
    linarith
  have hpower : 0 < ((d : Real) - 1) / (1 : Real) :=
    div_pos hdreal (by norm_num)
  have hzero : ENNReal.ofReal s = 0 := ENNReal.ofReal_eq_zero.mpr hs
  unfold brrsRadialLpSourceProfile
  rw [hzero, ENNReal.zero_rpow_of_pos hpower, zero_mul]

/-- The cubic convolution of the exponent-one radial source profile is
exactly the polar source integral with the corresponding translated cubic
phase profile.  This is the source-variable conversion required by the
compact `I₀` all-nine estimate. -/
theorem brrsI0ScaledCubicConvolution_sourceProfile_one_eq_polar
    {d : Nat} (hd : 2 ≤ d) (f : BRRSSpace d → Complex)
    (hfm : Measurable f) (w : BRRSSpace d) (q t : Real) :
    brrsI0ScaledCubicConvolution q
        (brrsRadialLpSourceProfile (d := d) 1 f w) t =
      ∫⁻ s : Ioi (0 : Real),
        brrsCubicJapaneseProfile (q * (t - s.1)) *
          ENNReal.ofReal ‖f (s.1 • w)‖
        ∂Measure.volumeIoiPow (d - 1) := by
  let F : Real → ENNReal := fun s =>
    brrsCubicJapaneseProfile (q * (t - s)) *
      ENNReal.ofReal ‖f (s • w)‖
  have hF : Measurable F := by
    dsimp [F]
    exact (measurable_brrsCubicJapaneseProfile.comp
      (measurable_const.mul (measurable_const.sub measurable_id))).mul
        ((hfm.comp (continuous_id.smul continuous_const).measurable).norm.ennreal_ofReal)
  have hsupport : ∀ s : Real, s ∉ Ioi (0 : Real) →
      brrsCubicJapaneseProfile (q * (t - s)) *
        brrsRadialLpSourceProfile (d := d) 1 f w s = 0 := by
    intro s hs
    rw [brrsRadialLpSourceProfile_one_eq_zero_of_nonpos hd f w
      (le_of_not_gt hs)]
    simp
  unfold brrsI0ScaledCubicConvolution
  calc
    (∫⁻ s : Real, brrsCubicJapaneseProfile (q * (t - s)) *
        brrsRadialLpSourceProfile (d := d) 1 f w s) =
        ∫⁻ s : Real, brrsCubicJapaneseProfile (q * (t - s)) *
          brrsRadialLpSourceProfile (d := d) 1 f w s
          ∂volume.restrict (Ioi (0 : Real)) :=
      Auto.Spherical.PowerWeights.lintegral_eq_lintegral_restrict_of_support
        (Ioi (0 : Real)) measurableSet_Ioi _ hsupport
    _ = ∫⁻ s in Ioi (0 : Real), brrsCubicJapaneseProfile (q * (t - s)) *
          brrsRadialLpSourceProfile (d := d) 1 f w s := rfl
    _ = ∫⁻ s in Ioi (0 : Real), ENNReal.ofReal s ^ (d - 1) * F s := by
      apply setLIntegral_congr_fun measurableSet_Ioi
      intro s hs
      change brrsCubicJapaneseProfile (q * (t - s)) *
          brrsRadialLpSourceProfile (d := d) 1 f w s =
        ENNReal.ofReal s ^ (d - 1) *
          (brrsCubicJapaneseProfile (q * (t - s)) *
            ENNReal.ofReal ‖f (s • w)‖)
      rw [brrsRadialLpSourceProfile_one_eq_polarDensity (by omega) f w hs]
      ac_rfl
    _ = ∫⁻ s : Ioi (0 : Real), F s.1
          ∂Measure.volumeIoiPow (d - 1) :=
      (Auto.Spherical.SurfaceMeasureDecay.lintegral_volumeIoiPow (d - 1)
        F hF).symm

/-- Reflecting the source profile changes the translated cubic kernel from
`t - s` to `t + s`; this is the incoming-wave bookkeeping identity in the
same scaled-convolution notation. -/
theorem brrsI0ScaledCubicConvolution_reflect_eq_plus
    (q t : Real) (g : Real → ENNReal) :
    brrsI0ScaledCubicConvolution q (brrsReflectProfile g) t =
      ∫⁻ s : Real, brrsCubicJapaneseProfile (q * (t + s)) * g s := by
  change brrsOneDimProfileConvolution
      (fun u : Real => brrsCubicJapaneseProfile (q * u))
      (brrsReflectProfile g) t =
    brrsOneDimProfileConvolutionPlus
      (fun u : Real => brrsCubicJapaneseProfile (q * u)) g t
  exact (brrsOneDimProfileConvolutionPlus_eq_reflect
    (fun u : Real => brrsCubicJapaneseProfile (q * u)) g t).symm

/-- The reflected exponent-one cubic convolution is the actual polar source
integral for the `t + s` phase. -/
theorem brrsI0ScaledCubicConvolution_reflect_sourceProfile_one_eq_polar
    {d : Nat} (hd : 2 ≤ d) (f : BRRSSpace d → Complex)
    (hfm : Measurable f) (w : BRRSSpace d) (q t : Real) :
    brrsI0ScaledCubicConvolution q
        (brrsReflectProfile (brrsRadialLpSourceProfile (d := d) 1 f w)) t =
      ∫⁻ s : Ioi (0 : Real),
        brrsCubicJapaneseProfile (q * (t + s.1)) *
          ENNReal.ofReal ‖f (s.1 • w)‖
        ∂Measure.volumeIoiPow (d - 1) := by
  let F : Real → ENNReal := fun s =>
    brrsCubicJapaneseProfile (q * (t + s)) *
      ENNReal.ofReal ‖f (s • w)‖
  have hF : Measurable F := by
    dsimp [F]
    exact (measurable_brrsCubicJapaneseProfile.comp
      (measurable_const.mul (measurable_const.add measurable_id))).mul
        ((hfm.comp (continuous_id.smul continuous_const).measurable).norm.ennreal_ofReal)
  have hsupport : ∀ s : Real, s ∉ Ioi (0 : Real) →
      brrsCubicJapaneseProfile (q * (t + s)) *
        brrsRadialLpSourceProfile (d := d) 1 f w s = 0 := by
    intro s hs
    rw [brrsRadialLpSourceProfile_one_eq_zero_of_nonpos hd f w
      (le_of_not_gt hs)]
    simp
  rw [brrsI0ScaledCubicConvolution_reflect_eq_plus]
  calc
    (∫⁻ s : Real, brrsCubicJapaneseProfile (q * (t + s)) *
        brrsRadialLpSourceProfile (d := d) 1 f w s) =
        ∫⁻ s : Real, brrsCubicJapaneseProfile (q * (t + s)) *
          brrsRadialLpSourceProfile (d := d) 1 f w s
          ∂volume.restrict (Ioi (0 : Real)) :=
      Auto.Spherical.PowerWeights.lintegral_eq_lintegral_restrict_of_support
        (Ioi (0 : Real)) measurableSet_Ioi _ hsupport
    _ = ∫⁻ s in Ioi (0 : Real), brrsCubicJapaneseProfile (q * (t + s)) *
          brrsRadialLpSourceProfile (d := d) 1 f w s := rfl
    _ = ∫⁻ s in Ioi (0 : Real), ENNReal.ofReal s ^ (d - 1) * F s := by
      apply setLIntegral_congr_fun measurableSet_Ioi
      intro s hs
      change brrsCubicJapaneseProfile (q * (t + s)) *
          brrsRadialLpSourceProfile (d := d) 1 f w s =
        ENNReal.ofReal s ^ (d - 1) *
          (brrsCubicJapaneseProfile (q * (t + s)) *
            ENNReal.ofReal ‖f (s • w)‖)
      rw [brrsRadialLpSourceProfile_one_eq_polarDensity (by omega) f w hs]
      ac_rfl
    _ = ∫⁻ s : Ioi (0 : Real), F s.1
          ∂Measure.volumeIoiPow (d - 1) :=
      (Auto.Spherical.SurfaceMeasureDecay.lintegral_volumeIoiPow (d - 1)
        F hF).symm

/-- The mass of the exponent-one source profile is precisely the polar
radial `L¹` source mass. -/
theorem brrs_lintegral_radialLpSourceProfile_one_eq_polar
    {d : Nat} (hd : 2 ≤ d) (f : BRRSSpace d → Complex)
    (hfm : Measurable f) (w : BRRSSpace d) :
    (∫⁻ s : Real, brrsRadialLpSourceProfile (d := d) 1 f w s) =
      ∫⁻ s : Ioi (0 : Real), ENNReal.ofReal ‖f (s.1 • w)‖
        ∂Measure.volumeIoiPow (d - 1) := by
  simpa only [ENNReal.rpow_one, brrsRadialLpProfile,
    brrsRadialNormProfile] using
    (brrs_lintegral_radialLpSourceProfile_rpow_eq_polar_full
      (d := d) hd (p := (1 : Real)) (by norm_num) f hfm w)

/-- Moving the cubic Japanese profile by at most one unit costs at most a
factor eight.  This is the quantitative fact that turns a point value at a
sample time into mass on one dyadic time cell. -/
theorem brrsCubicJapaneseProfile_shift_le_eight
    (u delta : Real) (hdelta : |delta| ≤ 1) :
    brrsCubicJapaneseProfile u ≤
      8 * brrsCubicJapaneseProfile (u + delta) := by
  have hdenom : 1 + |u + delta| ≤ 2 * (1 + |u|) := by
    calc
      1 + |u + delta| ≤ 1 + (|u| + |delta|) := by
        gcongr
        exact abs_add_le _ _
      _ ≤ 1 + (|u| + 1) := by gcongr
      _ ≤ 2 * (1 + |u|) := by nlinarith [abs_nonneg u]
  have hinv : (2 * (1 + |u|))⁻¹ ≤ (1 + |u + delta|)⁻¹ := by
    apply (inv_le_inv₀ (by positivity : 0 < 2 * (1 + |u|))
      (by positivity : 0 < 1 + |u + delta|)).mpr
    exact hdenom
  have hpow : ((1 + |u|)⁻¹) ^ 3 ≤
      8 * ((1 + |u + delta|)⁻¹) ^ 3 := by
    calc
      ((1 + |u|)⁻¹) ^ 3 =
          (2 : Real) ^ 3 * ((2 * (1 + |u|))⁻¹) ^ 3 := by
        field_simp
      _ ≤ (2 : Real) ^ 3 * ((1 + |u + delta|)⁻¹) ^ 3 := by
        exact mul_le_mul_of_nonneg_left
          (pow_le_pow_left₀ (by positivity) hinv _) (by positivity)
      _ = 8 * ((1 + |u + delta|)⁻¹) ^ 3 := by norm_num
  unfold brrsCubicJapaneseProfile
  calc
    ENNReal.ofReal ((1 + |u|)⁻¹ ^ 3) ≤
        ENNReal.ofReal (8 * ((1 + |u + delta|)⁻¹) ^ 3) :=
      ENNReal.ofReal_le_ofReal hpow
    _ = 8 * ENNReal.ofReal ((1 + |u + delta|)⁻¹ ^ 3) := by
      rw [ENNReal.ofReal_mul (p := (8 : Real))
        (q := ((1 + |u + delta|)⁻¹) ^ 3) (by norm_num)]
      norm_num

/-- Real-valued notation for the cubic Japanese profile.  The stationary
kernel estimates are real inequalities, whereas the overlap/Young package is
in `ENNReal`; keeping this companion notation makes the bridge explicit. -/
def brrsCubicJapaneseRealProfile (u : Real) : Real :=
  ((1 + |u|)⁻¹) ^ 3

/-- Measurability of the real-valued cubic Japanese profile. -/
theorem measurable_brrsCubicJapaneseRealProfile :
    Measurable brrsCubicJapaneseRealProfile := by
  unfold brrsCubicJapaneseRealProfile
  fun_prop

theorem brrsCubicJapaneseRealProfile_nonneg (u : Real) :
    0 ≤ brrsCubicJapaneseRealProfile u := by
  unfold brrsCubicJapaneseRealProfile
  positivity

/-- The cubic Japanese profile is bounded by one. -/
theorem brrsCubicJapaneseRealProfile_le_one (u : Real) :
    brrsCubicJapaneseRealProfile u ≤ 1 := by
  unfold brrsCubicJapaneseRealProfile
  apply pow_le_one₀ (by positivity)
  apply (inv_le_one₀ (by positivity : 0 < 1 + |u|)).mpr
  linarith [abs_nonneg u]

/-- Multiplication by any measurable cubic Japanese profile preserves the
polar integrability of a radial Schwartz trace. -/
theorem integrable_brrsCubicJapaneseRealProfile_comp_mul_radialNorm
    {d : Nat} (hd : 0 < d) (U : Ioi (0 : Real) → Real)
    (hU : Measurable U) (f : BRRSSchwartz d)
    (hf : IsRadial (f : BRRSSpace d → Complex))
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    Integrable (fun s : Ioi (0 : Real) =>
      brrsCubicJapaneseRealProfile (U s) * ‖f (s.1 • w)‖)
      (Measure.volumeIoiPow (d - 1)) := by
  have hinput : Integrable (fun s : Ioi (0 : Real) => f (s.1 • w))
      (Measure.volumeIoiPow (d - 1)) :=
    integrable_brrs_radial_profile_volumeIoiPow hd f hf w hw
  have hprofile : Measurable (fun s : Ioi (0 : Real) =>
      brrsCubicJapaneseRealProfile (U s)) :=
    measurable_brrsCubicJapaneseRealProfile.comp hU
  refine (hinput.norm.const_mul (1 : Real)).mono'
    (hprofile.aestronglyMeasurable.mul hinput.norm.aestronglyMeasurable) ?_
  filter_upwards with s
  rw [Real.norm_eq_abs,
    abs_of_nonneg (mul_nonneg
      (brrsCubicJapaneseRealProfile_nonneg _) (norm_nonneg _))]
  simpa only [one_mul] using mul_le_mul_of_nonneg_right
    (brrsCubicJapaneseRealProfile_le_one (U s)) (norm_nonneg _)

/-- Converting the negative-source cubic polar integral to `ENNReal` gives
exactly the scaled source-profile convolution. -/
theorem brrsI0ScaledCubicConvolution_sourceProfile_one_eq_ofReal_integral
    {d : Nat} (hd : 2 ≤ d) (f : BRRSSchwartz d)
    (hf : IsRadial (f : BRRSSpace d → Complex)) (w : BRRSSpace d)
    (hw : ‖w‖ = 1) (q t : Real) :
    brrsI0ScaledCubicConvolution q
        (brrsRadialLpSourceProfile (d := d) 1
          (f : BRRSSpace d → Complex) w) t =
      ENNReal.ofReal (∫ s : Ioi (0 : Real),
        brrsCubicJapaneseRealProfile (q * (t - s.1)) *
          ‖f (s.1 • w)‖ ∂Measure.volumeIoiPow (d - 1)) := by
  have hI : Integrable (fun s : Ioi (0 : Real) =>
      brrsCubicJapaneseRealProfile (q * (t - s.1)) * ‖f (s.1 • w)‖)
      (Measure.volumeIoiPow (d - 1)) :=
    integrable_brrsCubicJapaneseRealProfile_comp_mul_radialNorm
      (by omega) (fun s : Ioi (0 : Real) => q * (t - s.1)) (by fun_prop)
        f hf w hw
  rw [brrsI0ScaledCubicConvolution_sourceProfile_one_eq_polar hd
    (f : BRRSSpace d → Complex) f.continuous.measurable w q t,
    ofReal_integral_eq_lintegral_ofReal hI
      (Filter.Eventually.of_forall fun s =>
        mul_nonneg (brrsCubicJapaneseRealProfile_nonneg _) (norm_nonneg _))]
  apply lintegral_congr
  intro s
  rw [ENNReal.ofReal_mul (brrsCubicJapaneseRealProfile_nonneg _)]
  unfold brrsCubicJapaneseProfile brrsCubicJapaneseRealProfile
  rfl

/-- The positive-source cubic polar integral is the reflected scaled source
convolution after conversion to `ENNReal`. -/
theorem brrsI0ScaledCubicConvolution_reflect_sourceProfile_one_eq_ofReal_integral
    {d : Nat} (hd : 2 ≤ d) (f : BRRSSchwartz d)
    (hf : IsRadial (f : BRRSSpace d → Complex)) (w : BRRSSpace d)
    (hw : ‖w‖ = 1) (q t : Real) :
    brrsI0ScaledCubicConvolution q
        (brrsReflectProfile (brrsRadialLpSourceProfile (d := d) 1
          (f : BRRSSpace d → Complex) w)) t =
      ENNReal.ofReal (∫ s : Ioi (0 : Real),
        brrsCubicJapaneseRealProfile (q * (t + s.1)) *
          ‖f (s.1 • w)‖ ∂Measure.volumeIoiPow (d - 1)) := by
  have hI : Integrable (fun s : Ioi (0 : Real) =>
      brrsCubicJapaneseRealProfile (q * (t + s.1)) * ‖f (s.1 • w)‖)
      (Measure.volumeIoiPow (d - 1)) :=
    integrable_brrsCubicJapaneseRealProfile_comp_mul_radialNorm
      (by omega) (fun s : Ioi (0 : Real) => q * (t + s.1)) (by fun_prop)
        f hf w hw
  rw [brrsI0ScaledCubicConvolution_reflect_sourceProfile_one_eq_polar hd
    (f : BRRSSpace d → Complex) f.continuous.measurable w q t,
    ofReal_integral_eq_lintegral_ofReal hI
      (Filter.Eventually.of_forall fun s =>
        mul_nonneg (brrsCubicJapaneseRealProfile_nonneg _) (norm_nonneg _))]
  apply lintegral_congr
  intro s
  rw [ENNReal.ofReal_mul (brrsCubicJapaneseRealProfile_nonneg _)]
  unfold brrsCubicJapaneseProfile brrsCubicJapaneseRealProfile
  rfl

/-- The total exponent-one source mass is the `ENNReal` conversion of the
literal polar radial source integral. -/
theorem brrs_lintegral_radialLpSourceProfile_one_eq_ofReal_integral
    {d : Nat} (hd : 2 ≤ d) (f : BRRSSchwartz d)
    (hf : IsRadial (f : BRRSSpace d → Complex)) (w : BRRSSpace d)
    (hw : ‖w‖ = 1) :
    (∫⁻ s : Real, brrsRadialLpSourceProfile (d := d) 1
      (f : BRRSSpace d → Complex) w s) =
      ENNReal.ofReal (∫ s : Ioi (0 : Real), ‖f (s.1 • w)‖
        ∂Measure.volumeIoiPow (d - 1)) := by
  have hI : Integrable (fun s : Ioi (0 : Real) => f (s.1 • w))
      (Measure.volumeIoiPow (d - 1)) :=
    integrable_brrs_radial_profile_volumeIoiPow (by omega) f hf w hw
  rw [brrs_lintegral_radialLpSourceProfile_one_eq_polar hd
    (f : BRRSSpace d → Complex) f.continuous.measurable w,
    ofReal_integral_eq_lintegral_ofReal hI.norm
      (Filter.Eventually.of_forall fun s => norm_nonneg _)]

theorem brrsCubicJapaneseRealProfile_shift_le_eight
    (u delta : Real) (hdelta : |delta| ≤ 1) :
    brrsCubicJapaneseRealProfile (u + delta) ≤
      8 * brrsCubicJapaneseRealProfile u := by
  have hdenom : 1 + |u| ≤ 2 * (1 + |u + delta|) := by
    calc
      1 + |u| = 1 + |(u + delta) + (-delta)| := by ring_nf
      _ ≤ 1 + (|u + delta| + |-delta|) := by
        gcongr
        exact abs_add_le _ _
      _ = 1 + (|u + delta| + |delta|) := by rw [abs_neg]
      _ ≤ 1 + (|u + delta| + 1) := by gcongr
      _ ≤ 2 * (1 + |u + delta|) := by nlinarith [abs_nonneg (u + delta)]
  have hinv : (2 * (1 + |u + delta|))⁻¹ ≤ (1 + |u|)⁻¹ := by
    apply (inv_le_inv₀ (by positivity : 0 < 2 * (1 + |u + delta|))
      (by positivity : 0 < 1 + |u|)).mpr
    exact hdenom
  unfold brrsCubicJapaneseRealProfile
  calc
    ((1 + |u + delta|)⁻¹) ^ 3 =
        (2 : Real) ^ 3 * ((2 * (1 + |u + delta|))⁻¹) ^ 3 := by
      field_simp
    _ ≤ (2 : Real) ^ 3 * ((1 + |u|)⁻¹) ^ 3 := by
      exact mul_le_mul_of_nonneg_left
        (pow_le_pow_left₀ (by positivity) hinv _) (by positivity)
    _ = 8 * ((1 + |u|)⁻¹) ^ 3 := by norm_num

/-- Cubic stationary decay is stable under a unit-scale displacement of its
phase.  This is the form needed for the output radius `q r ≤ 1` in the
initial radial block. -/
theorem brrsStationaryRapidProfile_three_twoPi_smallShift_le
    (u delta : Real) (hdelta : |delta| ≤ 1) :
    brrsStationaryRapidProfile 3 (2 * Real.pi * (u + delta)) ≤
      64 * brrsCubicJapaneseRealProfile u := by
  have hrapid := brrsStationaryRapidProfile_twoPi_phase_le_rpowJapanese 3
    (u + delta)
  have hshift := brrsCubicJapaneseRealProfile_shift_le_eight u delta hdelta
  unfold brrsCubicJapaneseRealProfile at hshift ⊢
  have hrapid' :
      brrsStationaryRapidProfile 3 (2 * Real.pi * (u + delta)) ≤
        8 * ((1 + |u + delta|) ^ (-3 : Real)) := by
    calc
      brrsStationaryRapidProfile 3 (2 * Real.pi * (u + delta)) ≤
          (2 : Real) ^ (3 : Real) *
            (1 + |u + delta|) ^ (-(3 : Real)) := hrapid
      _ = 8 * ((1 + |u + delta|) ^ (-3 : Real)) := by
        norm_num [Real.rpow_natCast]
  have hphase : (1 + |u + delta|) ^ (-3 : Real) =
      ((1 + |u + delta|)⁻¹) ^ 3 := by
    calc
      (1 + |u + delta|) ^ (-3 : Real) =
          (1 + |u + delta|) ^ (-(3 : Real)) := by norm_num
      _ = ((1 + |u + delta|)⁻¹) ^ (3 : Real) :=
        Real.rpow_neg_eq_inv_rpow _ _
      _ = ((1 + |u + delta|)⁻¹) ^ (3 : Nat) := by
        norm_num [Real.rpow_natCast]
  calc
    brrsStationaryRapidProfile 3 (2 * Real.pi * (u + delta)) ≤
        8 * ((1 + |u + delta|) ^ (-3 : Real)) := hrapid'
    _ = 8 * ((1 + |u + delta|)⁻¹) ^ 3 := by rw [hphase]
    _ ≤ 8 * (8 * ((1 + |u|)⁻¹) ^ 3) :=
      mul_le_mul_of_nonneg_left hshift (by positivity)
    _ = 64 * ((1 + |u|)⁻¹) ^ 3 := by ring

/-- A scaled cubic convolution is locally stable on one mesh interval. -/
theorem brrsI0ScaledCubicConvolution_le_eight_shift
    (q x y : Real) {g : Real → ENNReal} (hg : Measurable g)
    (hxy : |q * (y - x)| ≤ 1) :
    brrsI0ScaledCubicConvolution q g x ≤
      8 * brrsI0ScaledCubicConvolution q g y := by
  have hmeas : Measurable (fun s : Real =>
      brrsCubicJapaneseProfile (q * (y - s)) * g s) :=
    (measurable_brrsCubicJapaneseProfile.comp
      (measurable_const.mul (measurable_const.sub measurable_id))).mul hg
  unfold brrsI0ScaledCubicConvolution
  calc
    (∫⁻ s : Real, brrsCubicJapaneseProfile (q * (x - s)) * g s) ≤
        ∫⁻ s : Real,
          (8 * brrsCubicJapaneseProfile (q * (y - s))) * g s := by
      apply lintegral_mono
      intro s
      have hphase : q * (y - s) = q * (x - s) + q * (y - x) := by ring
      change brrsCubicJapaneseProfile (q * (x - s)) * g s ≤
        (8 * brrsCubicJapaneseProfile (q * (y - s))) * g s
      rw [hphase]
      have hshift := brrsCubicJapaneseProfile_shift_le_eight
        (q * (x - s)) (q * (y - x)) hxy
      simpa only [mul_assoc, mul_left_comm, mul_comm] using
        (mul_le_mul_left hshift (g s))
    _ = 8 * ∫⁻ s : Real,
        brrsCubicJapaneseProfile (q * (y - s)) * g s := by
      rw [show (fun s : Real =>
          (8 * brrsCubicJapaneseProfile (q * (y - s))) * g s) =
          fun s => 8 * (brrsCubicJapaneseProfile (q * (y - s)) * g s) by
            funext s; ring]
      exact lintegral_const_mul 8 hmeas

/-- The source-independent middle stationary phase produces this cubic tail:
its coefficient is the total radial source mass, while its time profile is
still localized at the dyadic scale. -/
noncomputable def brrsI0CubicTailProfile
    (q : Real) (M : ENNReal) : Real → ENNReal :=
  fun x => brrsCubicJapaneseProfile (q * x) * M

/-- Measurability of the middle cubic tail. -/
theorem measurable_brrsI0CubicTailProfile (q : Real) (M : ENNReal) :
    Measurable (brrsI0CubicTailProfile q M) := by
  unfold brrsI0CubicTailProfile
  exact (measurable_brrsCubicJapaneseProfile.comp
    (measurable_const.mul measurable_id)).mul measurable_const

/-- The middle cubic tail has the same unit-scale translation stability as a
source convolution. -/
theorem brrsI0CubicTailProfile_le_eight_shift
    (q x y : Real) (M : ENNReal) (hxy : |q * (y - x)| ≤ 1) :
    brrsI0CubicTailProfile q M x ≤ 8 * brrsI0CubicTailProfile q M y := by
  unfold brrsI0CubicTailProfile
  have hphase : q * y = q * x + q * (y - x) := by ring
  rw [hphase]
  have hshift := brrsCubicJapaneseProfile_shift_le_eight
    (q * x) (q * (y - x)) hxy
  simpa only [mul_assoc, mul_left_comm, mul_comm] using
    (mul_le_mul_left hshift M)

/-- The local time cell contains the forward mesh interval used to average a
scaled cubic convolution. -/
theorem brrsI0_forwardMeshInterval_subset_timeCell
    {q t : Real} (hq : 0 < q) :
    Icc t (t + q⁻¹) ⊆ brrsI0TimeCell q⁻¹ t := by
  intro x hx
  simp only [brrsI0TimeCell, mem_Icc] at hx ⊢
  have hqinv : 0 < q⁻¹ := inv_pos.mpr hq
  constructor <;> linarith

/-- A point value of the scaled cubic convolution is bounded by the integral
of a scale-normalized local profile over its `I₀` time cell.  The right-hand
profile has a scale-free global `L¹` size, because the prefactor `q` exactly
cancels the width `q⁻¹` of the unnormalized convolution kernel. -/
theorem brrsI0ScaledCubicConvolution_le_local_profile
    {q t : Real} (hq : 0 < q) {g : Real → ENNReal} (hg : Measurable g) :
    brrsI0ScaledCubicConvolution q g t ≤
      ∫⁻ x in brrsI0TimeCell q⁻¹ t,
        (8 * ENNReal.ofReal q) * brrsI0ScaledCubicConvolution q g x := by
  let J : Set Real := Icc t (t + q⁻¹)
  let F : Real → ENNReal := brrsI0ScaledCubicConvolution q g
  have hF : Measurable F := measurable_brrsI0ScaledCubicConvolution q hg
  have hJ : MeasurableSet J := measurableSet_Icc
  have hsub : J ⊆ brrsI0TimeCell q⁻¹ t :=
    brrsI0_forwardMeshInterval_subset_timeCell hq
  have hpoint (x : Real) (hx : x ∈ J) :
      F t ≤ 8 * F x := by
    apply brrsI0ScaledCubicConvolution_le_eight_shift q t x hg
    dsimp only [J] at hx
    rw [abs_of_nonneg]
    · have hleft : t ≤ x := hx.1
      have hright : x ≤ t + q⁻¹ := hx.2
      have hqnonneg : 0 ≤ q := hq.le
      have hdiff : 0 ≤ x - t := by linarith
      rw [mul_sub]
      have hqx : q * (x - t) ≤ q * q⁻¹ :=
        mul_le_mul_of_nonneg_left (by linarith) hqnonneg
      rw [mul_inv_cancel₀ hq.ne'] at hqx
      linarith
    · exact mul_nonneg hq.le (by linarith [hx.1])
  have hJbound :
      ∫⁻ x in J, (ENNReal.ofReal q) * F t ≤
        ∫⁻ x in J, (8 * ENNReal.ofReal q) * F x := by
    apply setLIntegral_mono' hJ
    intro x hx
    calc
      (ENNReal.ofReal q) * F t ≤ (ENNReal.ofReal q) * (8 * F x) :=
        by simpa only [mul_comm] using
          (mul_le_mul_left (hpoint x hx) (ENNReal.ofReal q))
      _ = (8 * ENNReal.ofReal q) * F x := by ring
  have hconst :
      (∫⁻ x in J, (ENNReal.ofReal q) * F t) = F t := by
    rw [setLIntegral_const, Real.volume_Icc]
    have hlength : (t + q⁻¹) - t = q⁻¹ := by ring
    rw [hlength]
    have hqmul : ENNReal.ofReal q * ENNReal.ofReal q⁻¹ = 1 := by
      rw [← ENNReal.ofReal_mul hq.le, mul_inv_cancel₀ hq.ne']
      norm_num
    calc
      ENNReal.ofReal q * F t * ENNReal.ofReal q⁻¹ =
          (ENNReal.ofReal q * ENNReal.ofReal q⁻¹) * F t := by ring
      _ = F t := by rw [hqmul, one_mul]
  calc
    F t = ∫⁻ x in J, (ENNReal.ofReal q) * F t := hconst.symm
    _ ≤ ∫⁻ x in J, (8 * ENNReal.ofReal q) * F x := hJbound
    _ ≤ ∫⁻ x in brrsI0TimeCell q⁻¹ t,
        (8 * ENNReal.ofReal q) * F x :=
      lintegral_mono_set hsub

/-- The source-independent middle cubic tail obeys the same local-time
profile estimate as the translated source convolutions. -/
theorem brrsI0CubicTailProfile_le_local_profile
    {q t : Real} (hq : 0 < q) (M : ENNReal) :
    brrsI0CubicTailProfile q M t ≤
      ∫⁻ x in brrsI0TimeCell q⁻¹ t,
        (8 * ENNReal.ofReal q) * brrsI0CubicTailProfile q M x := by
  let J : Set Real := Icc t (t + q⁻¹)
  let F : Real → ENNReal := brrsI0CubicTailProfile q M
  have hF : Measurable F := measurable_brrsI0CubicTailProfile q M
  have hJ : MeasurableSet J := measurableSet_Icc
  have hsub : J ⊆ brrsI0TimeCell q⁻¹ t :=
    brrsI0_forwardMeshInterval_subset_timeCell hq
  have hpoint (x : Real) (hx : x ∈ J) :
      F t ≤ 8 * F x := by
    apply brrsI0CubicTailProfile_le_eight_shift q t x M
    dsimp only [J] at hx
    rw [abs_of_nonneg]
    · have hleft : t ≤ x := hx.1
      have hright : x ≤ t + q⁻¹ := hx.2
      have hqnonneg : 0 ≤ q := hq.le
      have hdiff : 0 ≤ x - t := by linarith
      rw [mul_sub]
      have hqx : q * (x - t) ≤ q * q⁻¹ :=
        mul_le_mul_of_nonneg_left (by linarith) hqnonneg
      rw [mul_inv_cancel₀ hq.ne'] at hqx
      linarith
    · exact mul_nonneg hq.le (by linarith [hx.1])
  have hJbound :
      ∫⁻ x in J, (ENNReal.ofReal q) * F t ≤
        ∫⁻ x in J, (8 * ENNReal.ofReal q) * F x := by
    apply setLIntegral_mono' hJ
    intro x hx
    calc
      (ENNReal.ofReal q) * F t ≤ (ENNReal.ofReal q) * (8 * F x) :=
        by simpa only [mul_comm] using
          (mul_le_mul_left (hpoint x hx) (ENNReal.ofReal q))
      _ = (8 * ENNReal.ofReal q) * F x := by ring
  have hconst :
      (∫⁻ x in J, (ENNReal.ofReal q) * F t) = F t := by
    rw [setLIntegral_const, Real.volume_Icc]
    have hlength : (t + q⁻¹) - t = q⁻¹ := by ring
    rw [hlength]
    have hqmul : ENNReal.ofReal q * ENNReal.ofReal q⁻¹ = 1 := by
      rw [← ENNReal.ofReal_mul hq.le, mul_inv_cancel₀ hq.ne']
      norm_num
    calc
      ENNReal.ofReal q * F t * ENNReal.ofReal q⁻¹ =
          (ENNReal.ofReal q * ENNReal.ofReal q⁻¹) * F t := by ring
      _ = F t := by rw [hqmul, one_mul]
  calc
    F t = ∫⁻ x in J, (ENNReal.ofReal q) * F t := hconst.symm
    _ ≤ ∫⁻ x in J, (8 * ENNReal.ofReal q) * F x := hJbound
    _ ≤ ∫⁻ x in brrsI0TimeCell q⁻¹ t,
        (8 * ENNReal.ofReal q) * F x :=
      lintegral_mono_set hsub

/-- The sum of the two source convolutions and the middle cubic tail is a
single valid `I₀` local profile.  Hence it can be passed verbatim to the
bounded-overlap lemma for a dyadic time discretization. -/
noncomputable def brrsI0ThreeCubicProfile
    (q : Real) (g : Real → ENNReal) (M : ENNReal) : Real → ENNReal :=
  fun x => (brrsI0ScaledCubicConvolution q g x +
    brrsI0ScaledCubicConvolution q (brrsReflectProfile g) x) +
      brrsI0CubicTailProfile q M x

/-- Measurability of the complete three-phase compact-cell profile. -/
theorem measurable_brrsI0ThreeCubicProfile
    (q : Real) {g : Real → ENNReal} (hg : Measurable g) (M : ENNReal) :
    Measurable (brrsI0ThreeCubicProfile q g M) := by
  unfold brrsI0ThreeCubicProfile
  exact ((measurable_brrsI0ScaledCubicConvolution q hg).add
    (measurable_brrsI0ScaledCubicConvolution q
      (measurable_brrsReflectProfile hg))).add
        (measurable_brrsI0CubicTailProfile q M)

/-- On a unit scaled time displacement, each of the three compact-cell
profiles varies by at most the universal cubic factor `8`. -/
theorem brrsI0ThreeCubicProfile_le_eight_shift
    (q x y : Real) {g : Real → ENNReal} (hg : Measurable g) (M : ENNReal)
    (hxy : |q * (y - x)| ≤ 1) :
    brrsI0ThreeCubicProfile q g M x ≤
      8 * brrsI0ThreeCubicProfile q g M y := by
  have hminus := brrsI0ScaledCubicConvolution_le_eight_shift q x y hg hxy
  have hplus := brrsI0ScaledCubicConvolution_le_eight_shift q x y
    (measurable_brrsReflectProfile hg) hxy
  have hmiddle := brrsI0CubicTailProfile_le_eight_shift q x y M hxy
  unfold brrsI0ThreeCubicProfile
  calc
    (brrsI0ScaledCubicConvolution q g x +
        brrsI0ScaledCubicConvolution q (brrsReflectProfile g) x) +
          brrsI0CubicTailProfile q M x ≤
        (8 * brrsI0ScaledCubicConvolution q g y +
          8 * brrsI0ScaledCubicConvolution q (brrsReflectProfile g) y) +
            8 * brrsI0CubicTailProfile q M y := by
      gcongr
    _ = 8 * ((brrsI0ScaledCubicConvolution q g y +
        brrsI0ScaledCubicConvolution q (brrsReflectProfile g) y) +
          brrsI0CubicTailProfile q M y) := by ring

/-- The `p`-th power of the complete compact-cell profile has the same
bounded-overlap local control.  This is deliberately stated for all
nonnegative real powers, so it can be used at the BRRS low-`p` exponents. -/
theorem brrsI0ThreeCubicProfile_rpow_le_local_profile
    {q t p : Real} (hq : 0 < q) (hp : 0 ≤ p)
    {g : Real → ENNReal} (hg : Measurable g) (M : ENNReal) :
    (brrsI0ThreeCubicProfile q g M t) ^ p ≤
      ∫⁻ x in brrsI0TimeCell q⁻¹ t,
        ((8 : ENNReal) ^ p * ENNReal.ofReal q) *
          (brrsI0ThreeCubicProfile q g M x) ^ p := by
  let J : Set Real := Icc t (t + q⁻¹)
  let F : Real → ENNReal := brrsI0ThreeCubicProfile q g M
  let c : ENNReal := (8 : ENNReal) ^ p * ENNReal.ofReal q
  have hF : Measurable F := measurable_brrsI0ThreeCubicProfile q hg M
  have hJ : MeasurableSet J := measurableSet_Icc
  have hsub : J ⊆ brrsI0TimeCell q⁻¹ t :=
    brrsI0_forwardMeshInterval_subset_timeCell hq
  have hpoint (x : Real) (hx : x ∈ J) :
      F t ^ p ≤ (8 : ENNReal) ^ p * F x ^ p := by
    have hshift : F t ≤ 8 * F x := by
      apply brrsI0ThreeCubicProfile_le_eight_shift q t x hg M
      dsimp only [J] at hx
      rw [abs_of_nonneg]
      · have hleft : t ≤ x := hx.1
        have hright : x ≤ t + q⁻¹ := hx.2
        have hqnonneg : 0 ≤ q := hq.le
        have hdiff : 0 ≤ x - t := by linarith
        rw [mul_sub]
        have hqx : q * (x - t) ≤ q * q⁻¹ :=
          mul_le_mul_of_nonneg_left (by linarith) hqnonneg
        rw [mul_inv_cancel₀ hq.ne'] at hqx
        linarith
      · exact mul_nonneg hq.le (by linarith [hx.1])
    have hpow := ENNReal.rpow_le_rpow hshift hp
    rw [ENNReal.mul_rpow_of_nonneg _ _ hp] at hpow
    exact hpow
  have hJbound :
      ∫⁻ x in J, (ENNReal.ofReal q) * F t ^ p ≤
        ∫⁻ x in J, c * F x ^ p := by
    apply setLIntegral_mono' hJ
    intro x hx
    calc
      (ENNReal.ofReal q) * F t ^ p ≤
          (ENNReal.ofReal q) * ((8 : ENNReal) ^ p * F x ^ p) :=
        by simpa only [mul_comm] using
          (mul_le_mul_left (hpoint x hx) (ENNReal.ofReal q))
      _ = c * F x ^ p := by
        dsimp only [c]
        ring
  have hconst :
      (∫⁻ x in J, (ENNReal.ofReal q) * F t ^ p) = F t ^ p := by
    rw [setLIntegral_const, Real.volume_Icc]
    have hlength : (t + q⁻¹) - t = q⁻¹ := by ring
    rw [hlength]
    have hqmul : ENNReal.ofReal q * ENNReal.ofReal q⁻¹ = 1 := by
      rw [← ENNReal.ofReal_mul hq.le, mul_inv_cancel₀ hq.ne']
      norm_num
    calc
      ENNReal.ofReal q * F t ^ p * ENNReal.ofReal q⁻¹ =
          (ENNReal.ofReal q * ENNReal.ofReal q⁻¹) * F t ^ p := by ring
      _ = F t ^ p := by rw [hqmul, one_mul]
  calc
    F t ^ p = ∫⁻ x in J, (ENNReal.ofReal q) * F t ^ p := hconst.symm
    _ ≤ ∫⁻ x in J, c * F x ^ p := hJbound
    _ ≤ ∫⁻ x in brrsI0TimeCell q⁻¹ t, c * F x ^ p :=
      lintegral_mono_set hsub

/-- Local-time control of the complete compact-cell profile. -/
theorem brrsI0ThreeCubicProfile_le_local_profile
    {q t : Real} (hq : 0 < q) {g : Real → ENNReal} (hg : Measurable g)
    (M : ENNReal) :
    brrsI0ThreeCubicProfile q g M t ≤
      ∫⁻ x in brrsI0TimeCell q⁻¹ t,
        (8 * ENNReal.ofReal q) * brrsI0ThreeCubicProfile q g M x := by
  let Fminus : Real → ENNReal := brrsI0ScaledCubicConvolution q g
  let Fplus : Real → ENNReal :=
    brrsI0ScaledCubicConvolution q (brrsReflectProfile g)
  let Fmiddle : Real → ENNReal := brrsI0CubicTailProfile q M
  let c : ENNReal := 8 * ENNReal.ofReal q
  have hFminus : Measurable Fminus := measurable_brrsI0ScaledCubicConvolution q hg
  have hFplus : Measurable Fplus := measurable_brrsI0ScaledCubicConvolution q
    (measurable_brrsReflectProfile hg)
  have hFmiddle : Measurable Fmiddle := measurable_brrsI0CubicTailProfile q M
  have hminus : Fminus t ≤ ∫⁻ x in brrsI0TimeCell q⁻¹ t, c * Fminus x := by
    simpa only [Fminus, c] using
      (brrsI0ScaledCubicConvolution_le_local_profile hq hg (t := t))
  have hplus : Fplus t ≤ ∫⁻ x in brrsI0TimeCell q⁻¹ t, c * Fplus x := by
    simpa only [Fplus, c] using
      (brrsI0ScaledCubicConvolution_le_local_profile hq
        (measurable_brrsReflectProfile hg) (t := t))
  have hmiddle : Fmiddle t ≤ ∫⁻ x in brrsI0TimeCell q⁻¹ t, c * Fmiddle x := by
    simpa only [Fmiddle, c] using
      (brrsI0CubicTailProfile_le_local_profile hq M (t := t))
  have hGminus : Measurable (fun x : Real => c * Fminus x) :=
    measurable_const.mul hFminus
  have hGplus : Measurable (fun x : Real => c * Fplus x) :=
    measurable_const.mul hFplus
  calc
    brrsI0ThreeCubicProfile q g M t = (Fminus t + Fplus t) + Fmiddle t := by
      rfl
    _ ≤ ((∫⁻ x in brrsI0TimeCell q⁻¹ t, c * Fminus x) +
        (∫⁻ x in brrsI0TimeCell q⁻¹ t, c * Fplus x)) +
          (∫⁻ x in brrsI0TimeCell q⁻¹ t, c * Fmiddle x) := by
      gcongr
    _ = ∫⁻ x in brrsI0TimeCell q⁻¹ t,
        ((c * Fminus x + c * Fplus x) + c * Fmiddle x) := by
      symm
      calc
        (∫⁻ x in brrsI0TimeCell q⁻¹ t,
          ((c * Fminus x + c * Fplus x) + c * Fmiddle x)) =
            (∫⁻ x in brrsI0TimeCell q⁻¹ t, c * Fminus x + c * Fplus x) +
              ∫⁻ x in brrsI0TimeCell q⁻¹ t, c * Fmiddle x := by
          simpa only [Pi.add_apply] using
            (lintegral_add_left
              (μ := volume.restrict (brrsI0TimeCell q⁻¹ t))
              (hGminus.add hGplus) (fun x : Real => c * Fmiddle x))
        _ = ((∫⁻ x in brrsI0TimeCell q⁻¹ t, c * Fminus x) +
            ∫⁻ x in brrsI0TimeCell q⁻¹ t, c * Fplus x) +
              ∫⁻ x in brrsI0TimeCell q⁻¹ t, c * Fmiddle x := by
          rw [lintegral_add_left
            (μ := volume.restrict (brrsI0TimeCell q⁻¹ t)) hGminus
            (fun x : Real => c * Fplus x)]
    _ = ∫⁻ x in brrsI0TimeCell q⁻¹ t,
        c * ((Fminus x + Fplus x) + Fmiddle x) := by
      congr with x
      ring
    _ = ∫⁻ x in brrsI0TimeCell q⁻¹ t,
        (8 * ENNReal.ofReal q) * brrsI0ThreeCubicProfile q g M x := by
      rfl

/-- Direct bounded-overlap summation interface for the full compact-cell
three-profile majorant.  It is the three-phase analogue of the single cubic
convolution interface and contains no analytic hypothesis beyond its stated
input control. -/
theorem brrs_sum_dyadicI0_lintegral_le_of_threeCubic_control
    {E : Set Real} (j : Nat) (T : Finset Real)
    (hT : IsDyadicDiscretization E j T)
    (H : Real → Real → ENNReal) (A M : ENNReal)
    {g : Real → ENNReal} (hg : Measurable g)
    (hcontrol : ∀ t ∈ T,
      (∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
        A * brrsI0ThreeCubicProfile ((2 : Real) ^ j) g M t) :
    (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
      17 * ∫⁻ x : Real,
        A * ((8 * ENNReal.ofReal ((2 : Real) ^ j)) *
          brrsI0ThreeCubicProfile ((2 : Real) ^ j) g M x) := by
  let q : Real := (2 : Real) ^ j
  let F : Real → ENNReal := brrsI0ThreeCubicProfile q g M
  let G : Real → ENNReal := fun x =>
    A * ((8 * ENNReal.ofReal q) * F x)
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hF : Measurable F := measurable_brrsI0ThreeCubicProfile q hg M
  have hG : Measurable G := measurable_const.mul
    (measurable_const.mul hF)
  change (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
    17 * ∫⁻ x : Real, G x
  apply brrs_sum_dyadicI0_lintegral_le_of_local_profile j T hT H G hG
  intro t ht
  have hlocal : F t ≤
      ∫⁻ x in brrsDyadicI0TimeCell j t, (8 * ENNReal.ofReal q) * F x := by
    simpa only [F, q, brrsDyadicI0TimeCell, dyadicTimeScale] using
      (brrsI0ThreeCubicProfile_le_local_profile hq hg M (t := t))
  calc
    (∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤ A * F t := by
      simpa only [F, q] using hcontrol t ht
    _ ≤ A * ∫⁻ x in brrsDyadicI0TimeCell j t,
        (8 * ENNReal.ofReal q) * F x := by
      simpa only [mul_comm] using (mul_le_mul_left hlocal A)
    _ = ∫⁻ x in brrsDyadicI0TimeCell j t,
        A * ((8 * ENNReal.ofReal q) * F x) := by
      symm
      exact lintegral_const_mul A (measurable_const.mul hF)

/-- Bounded-overlap summation for a nonnegative real power of the complete
three-phase `I₀` profile.  This is the reusable p-moment version of the
compact-cell interface. -/
theorem brrs_sum_dyadicI0_lintegral_le_of_threeCubic_rpow_control
    {E : Set Real} (j : Nat) (T : Finset Real)
    (hT : IsDyadicDiscretization E j T)
    (H : Real → Real → ENNReal) (A M : ENNReal) (p : Real) (hp : 0 ≤ p)
    {g : Real → ENNReal} (hg : Measurable g)
    (hcontrol : ∀ t ∈ T,
      (∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
        A * (brrsI0ThreeCubicProfile ((2 : Real) ^ j) g M t) ^ p) :
    (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
      17 * ∫⁻ x : Real,
        A * ((((8 : ENNReal) ^ p * ENNReal.ofReal ((2 : Real) ^ j)) *
          (brrsI0ThreeCubicProfile ((2 : Real) ^ j) g M x) ^ p)) := by
  let q : Real := (2 : Real) ^ j
  let F : Real → ENNReal := brrsI0ThreeCubicProfile q g M
  let c : ENNReal := (8 : ENNReal) ^ p * ENNReal.ofReal q
  let G : Real → ENNReal := fun x => A * (c * F x ^ p)
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hF : Measurable F := measurable_brrsI0ThreeCubicProfile q hg M
  have hFp : Measurable (fun x : Real => F x ^ p) :=
    ENNReal.continuous_rpow_const.measurable.comp hF
  have hG : Measurable G := measurable_const.mul (measurable_const.mul hFp)
  change (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
    17 * ∫⁻ x : Real, G x
  apply brrs_sum_dyadicI0_lintegral_le_of_local_profile j T hT H G hG
  intro t ht
  have hlocal : F t ^ p ≤
      ∫⁻ x in brrsDyadicI0TimeCell j t, c * F x ^ p := by
    simpa only [F, c, q, brrsDyadicI0TimeCell, dyadicTimeScale] using
      (brrsI0ThreeCubicProfile_rpow_le_local_profile hq hp hg M (t := t))
  calc
    (∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤ A * F t ^ p := by
      simpa only [F, q] using hcontrol t ht
    _ ≤ A * ∫⁻ x in brrsDyadicI0TimeCell j t, c * F x ^ p := by
      simpa only [mul_comm] using (mul_le_mul_left hlocal A)
    _ = ∫⁻ x in brrsDyadicI0TimeCell j t, A * (c * F x ^ p) := by
      symm
      exact lintegral_const_mul A (measurable_const.mul hFp)

/-- The scaled cubic local profile is measurable, so it can be used directly
as the `G` input to `brrs_sum_dyadicI0_lintegral_le_of_local_profile`. -/
theorem measurable_brrsI0ScaledCubicLocalProfile
    (q : Real) {g : Real → ENNReal} (hg : Measurable g) :
    Measurable (fun x : Real =>
      (8 * ENNReal.ofReal q) * brrsI0ScaledCubicConvolution q g x) := by
  exact measurable_const.mul (measurable_brrsI0ScaledCubicConvolution q hg)

/-- This is the exact interface between an analytic `I₀` majorant and the
already-proved bounded-overlap summation.  Thus, once the physical radial
mass at time `t` is controlled by a scaled cubic convolution, no further
time-set argument is needed: the displayed scale-normalized local profile
can be inserted directly into `brrs_sum_dyadicI0_lintegral_le_of_local_profile`.
-/
theorem brrs_sum_dyadicI0_lintegral_le_of_scaledCubic_control
    {E : Set Real} (j : Nat) (T : Finset Real)
    (hT : IsDyadicDiscretization E j T)
    (H : Real → Real → ENNReal) (A : ENNReal)
    {g : Real → ENNReal} (hg : Measurable g)
    (hcontrol : ∀ t ∈ T,
      (∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
        A * brrsI0ScaledCubicConvolution ((2 : Real) ^ j) g t) :
    (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
      17 * ∫⁻ x : Real,
        A * ((8 * ENNReal.ofReal ((2 : Real) ^ j)) *
          brrsI0ScaledCubicConvolution ((2 : Real) ^ j) g x) := by
  let q : Real := (2 : Real) ^ j
  let F : Real → ENNReal := brrsI0ScaledCubicConvolution q g
  let G : Real → ENNReal := fun x =>
    A * ((8 * ENNReal.ofReal q) * F x)
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hF : Measurable F := measurable_brrsI0ScaledCubicConvolution q hg
  have hG : Measurable G := measurable_const.mul
    (measurable_const.mul hF)
  change (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
    17 * ∫⁻ x : Real, G x
  apply brrs_sum_dyadicI0_lintegral_le_of_local_profile j T hT H G hG
  intro t ht
  have hlocal : F t ≤
      ∫⁻ x in brrsDyadicI0TimeCell j t, (8 * ENNReal.ofReal q) * F x := by
    simpa only [F, q, brrsDyadicI0TimeCell, dyadicTimeScale] using
      (brrsI0ScaledCubicConvolution_le_local_profile hq hg (t := t))
  calc
    (∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤ A * F t := by
      simpa only [F, q] using hcontrol t ht
    _ ≤ A * ∫⁻ x in brrsDyadicI0TimeCell j t,
        (8 * ENNReal.ofReal q) * F x := by
      simpa only [mul_comm] using (mul_le_mul_left hlocal A)
    _ = ∫⁻ x in brrsDyadicI0TimeCell j t,
        A * ((8 * ENNReal.ofReal q) * F x) := by
      symm
      exact lintegral_const_mul A (measurable_const.mul hF)

end

open Set Filter MeasureTheory FourierTransform
open scoped BigOperators Convolution ENNReal FourierTransform Topology

noncomputable section

/-! ### Exact dilation bookkeeping for Section 5 profiles

The `2^j` stationary scale occurs repeatedly in the radial-block estimates.
This elementary full-line change-of-variables lemma records the normalization
once, so that later convolution estimates do not silently lose a factor of
`2^j`.
-/

/-- Dilation on the real phase line transforms Lebesgue mass by the inverse
scale.  This is stated for `ENNReal`-valued profiles, exactly the setting of
the positive Section 5 convolutions. -/
theorem lintegral_comp_mul_real_eq
    (G : Real → ENNReal) {q : Real} (hq : 0 < q) :
    (∫⁻ x : Real, G (q * x)) =
      ENNReal.ofReal q⁻¹ * ∫⁻ y : Real, G y := by
  have hu : IsUnit q := isUnit_iff_ne_zero.mpr hq.ne'
  have hmap :
      (∫⁻ y : Real, G y ∂(Measure.map (fun x : Real => q • x) volume)) =
        ∫⁻ x : Real, G (q • x) :=
    lintegral_map_equiv G (Homeomorph.smul hu.unit).toMeasurableEquiv
  have hscale :
      (∫⁻ x : Real, G (q • x)) =
        ENNReal.ofReal q⁻¹ * ∫⁻ y : Real, G y := by
    rw [← hmap, Measure.map_addHaar_smul volume hq.ne',
      lintegral_smul_measure, Module.finrank_self, smul_eq_mul]
    have hfac : ENNReal.ofReal |(q ^ (1 : Nat))⁻¹| =
        ENNReal.ofReal q⁻¹ := by
      rw [abs_inv, abs_of_pos (pow_pos hq _), pow_one]
    rw [hfac]
  simpa only [smul_eq_mul] using hscale

/-! ### Normalized scaled cubic convolutions

The compact `I₀` estimates use the unnormalized kernel
`u ↦ brrsCubicJapaneseProfile (q * u)`.  Putting the factor `q` in the
kernel gives a unit-scale family with exactly constant mass.  These lemmas
make the normalization and its global positive Young estimate explicit, so
later endpoint estimates can use the literal `I₀` convolution without losing
a dyadic factor.
-/

/-- The mass-normalized cubic phase-line kernel at spatial scale `q`. -/
noncomputable def brrsNormalizedScaledCubicProfile (q : Real) : Real → ENNReal :=
  fun u => ENNReal.ofReal q * brrsCubicJapaneseProfile (q * u)

/-- The normalized scaled cubic profile is measurable. -/
theorem measurable_brrsNormalizedScaledCubicProfile (q : Real) :
    Measurable (brrsNormalizedScaledCubicProfile q) := by
  unfold brrsNormalizedScaledCubicProfile
  exact measurable_const.mul
    (measurable_brrsCubicJapaneseProfile.comp
      (measurable_const.mul measurable_id))

/-- At a positive scale, the normalized scaled cubic profile is positive. -/
theorem brrsNormalizedScaledCubicProfile_pos
    {q : Real} (hq : 0 < q) (u : Real) :
    0 < brrsNormalizedScaledCubicProfile q u := by
  unfold brrsNormalizedScaledCubicProfile
  exact ENNReal.mul_pos (ENNReal.ofReal_pos.mpr hq).ne'
    (brrsCubicJapaneseProfile_pos _).ne'

/-- The normalized scaled cubic profile is pointwise finite. -/
theorem brrsNormalizedScaledCubicProfile_ne_top
    (q u : Real) :
    brrsNormalizedScaledCubicProfile q u ≠ ∞ := by
  unfold brrsNormalizedScaledCubicProfile
  exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top
    (brrsCubicJapaneseProfile_ne_top _)

/-- Normalization cancels the one-dimensional dilation Jacobian exactly. -/
theorem lintegral_brrsNormalizedScaledCubicProfile_eq
    {q : Real} (hq : 0 < q) :
    (∫⁻ u : Real, brrsNormalizedScaledCubicProfile q u) =
      ∫⁻ v : Real, brrsCubicJapaneseProfile v := by
  let G : Real → ENNReal := brrsCubicJapaneseProfile
  have hG : Measurable G := by
    simpa only [G] using measurable_brrsCubicJapaneseProfile
  have hmul : Measurable (fun u : Real => q * u) :=
    measurable_const.mul measurable_id
  change (∫⁻ u : Real, ENNReal.ofReal q * G (q * u)) = ∫⁻ v : Real, G v
  have hmass :
      (∫⁻ u : Real, ENNReal.ofReal q * G (q * u)) =
        ENNReal.ofReal q * ∫⁻ u : Real, G (q * u) := by
    simpa only [Function.comp_apply] using
      (lintegral_const_mul (μ := volume) (ENNReal.ofReal q) (hG.comp hmul))
  rw [hmass, lintegral_comp_mul_real_eq G hq]
  rw [← mul_assoc, ← ENNReal.ofReal_mul hq.le,
    mul_inv_cancel₀ hq.ne', ENNReal.ofReal_one, one_mul]

/-- The normalized cubic convolution is exactly `q` times the literal
unnormalized `I₀` convolution used by the radial kernel bounds. -/
theorem brrsOneDimProfileConvolution_normalizedScaledCubic_eq
    (q : Real) {g : Real → ENNReal} (hg : Measurable g) (x : Real) :
    brrsOneDimProfileConvolution (brrsNormalizedScaledCubicProfile q) g x =
      ENNReal.ofReal q * brrsI0ScaledCubicConvolution q g x := by
  have hkernel : Measurable (fun s : Real =>
      brrsCubicJapaneseProfile (q * (x - s)) * g s) :=
    (measurable_brrsCubicJapaneseProfile.comp
      (measurable_const.mul (measurable_const.sub measurable_id))).mul
        hg
  unfold brrsOneDimProfileConvolution brrsNormalizedScaledCubicProfile
    brrsI0ScaledCubicConvolution
  calc
    (∫⁻ s : Real,
        (ENNReal.ofReal q * brrsCubicJapaneseProfile (q * (x - s))) * g s) =
        ∫⁻ s : Real,
          ENNReal.ofReal q *
            (brrsCubicJapaneseProfile (q * (x - s)) * g s) := by
      apply lintegral_congr
      intro s
      ring
    _ = ENNReal.ofReal q *
        ∫⁻ s : Real, brrsCubicJapaneseProfile (q * (x - s)) * g s :=
      lintegral_const_mul _ hkernel

/-- Global positive Young inequality for the normalized cubic convolution.
Its constant is exactly the scale-free mass of the base cubic profile. -/
theorem lintegral_brrsOneDimProfileConvolution_normalizedScaledCubic_rpow_le
    {q p : Real} (hq : 0 < q) (hp : 1 < p)
    {g : Real → ENNReal} (hg : Measurable g) :
    (∫⁻ x : Real,
      (brrsOneDimProfileConvolution (brrsNormalizedScaledCubicProfile q) g x) ^ p) ≤
        (∫⁻ u : Real, brrsCubicJapaneseProfile u) ^ p *
          ∫⁻ s : Real, (g s) ^ p := by
  have hmass :
      (∫⁻ u : Real, brrsNormalizedScaledCubicProfile q u) =
        ∫⁻ v : Real, brrsCubicJapaneseProfile v :=
    lintegral_brrsNormalizedScaledCubicProfile_eq hq
  calc
    (∫⁻ x : Real,
        (brrsOneDimProfileConvolution (brrsNormalizedScaledCubicProfile q) g x) ^ p) ≤
        (∫⁻ u : Real, brrsNormalizedScaledCubicProfile q u) ^ p *
          ∫⁻ s : Real, (g s) ^ p :=
      lintegral_brrsOneDimProfileConvolution_rpow_le hp
        (measurable_brrsNormalizedScaledCubicProfile q) hg
        (brrsNormalizedScaledCubicProfile_pos hq)
        (brrsNormalizedScaledCubicProfile_ne_top q)
        (by
          rw [hmass]
          exact lintegral_brrsCubicJapaneseProfile_pos)
        (by
          rw [hmass]
          exact lintegral_brrsCubicJapaneseProfile_ne_top)
    _ = (∫⁻ u : Real, brrsCubicJapaneseProfile u) ^ p *
          ∫⁻ s : Real, (g s) ^ p := by rw [hmass]

/-- The same Young estimate stated directly for the literal `I₀` scaled
cubic convolution, after placing its compensating factor `q` outside. -/
theorem lintegral_normalized_brrsI0ScaledCubicConvolution_rpow_le
    {q p : Real} (hq : 0 < q) (hp : 1 < p)
    {g : Real → ENNReal} (hg : Measurable g) :
    (∫⁻ x : Real,
      (ENNReal.ofReal q * brrsI0ScaledCubicConvolution q g x) ^ p) ≤
        (∫⁻ u : Real, brrsCubicJapaneseProfile u) ^ p *
          ∫⁻ s : Real, (g s) ^ p := by
  have hYoung :=
    lintegral_brrsOneDimProfileConvolution_normalizedScaledCubic_rpow_le
      hq hp hg
  simpa only [brrsOneDimProfileConvolution_normalizedScaledCubic_eq q hg] using hYoung

/-- Restricting an input profile by an indicator converts the full-line
convolution exactly into its source-set integral. -/
theorem brrsOneDimProfileConvolution_indicator_eq_setLIntegral
    (omega g : Real → ENNReal) (S : Set Real) (hS : MeasurableSet S) (x : Real) :
    brrsOneDimProfileConvolution omega (S.indicator g) x =
      ∫⁻ s in S, omega (x - s) * g s := by
  classical
  unfold brrsOneDimProfileConvolution
  calc
    (∫⁻ s : Real, omega (x - s) * S.indicator g s) =
        ∫⁻ s : Real, S.indicator (fun s => omega (x - s) * g s) s := by
      apply lintegral_congr
      intro s
      by_cases hs : s ∈ S <;> simp [Set.indicator, hs]
    _ = ∫⁻ s in S, omega (x - s) * g s :=
      lintegral_indicator hS _

/-- The same source-set identity for the plus-sign convolution convention. -/
theorem brrsOneDimProfileConvolutionPlus_indicator_eq_setLIntegral
    (omega g : Real → ENNReal) (S : Set Real) (hS : MeasurableSet S) (x : Real) :
    brrsOneDimProfileConvolutionPlus omega (S.indicator g) x =
      ∫⁻ s in S, omega (x + s) * g s := by
  classical
  unfold brrsOneDimProfileConvolutionPlus
  calc
    (∫⁻ s : Real, omega (x + s) * S.indicator g s) =
        ∫⁻ s : Real, S.indicator (fun s => omega (x + s) * g s) s := by
      apply lintegral_congr
      intro s
      by_cases hs : s ∈ S <;> simp [Set.indicator, hs]
    _ = ∫⁻ s in S, omega (x + s) * g s :=
      lintegral_indicator hS _

/-- The source restriction for the compact branch `0 < q s ≤ 16` of the
dyadic initial cell. -/
noncomputable def brrsI0CompactSourceProfile
    (q : Real) (g : Real → ENNReal) : Real → ENNReal :=
  (Ioc (0 : Real) (16 * q⁻¹)).indicator g

/-- Measurability of the compact initial-cell source restriction. -/
theorem measurable_brrsI0CompactSourceProfile
    (q : Real) {g : Real → ENNReal} (hg : Measurable g) :
    Measurable (brrsI0CompactSourceProfile q g) := by
  unfold brrsI0CompactSourceProfile
  exact hg.indicator measurableSet_Ioc

/-- The unit-mass rescaling of the stationary phase-line profile at dyadic
frequency `2^j`.  The leading factor is deliberately inside `ENNReal`: its
exact cancellation with the Jacobian is what makes the later convolution
constants independent of the frequency level. -/
noncomputable def brrsDyadicStationaryPhaseProfile
    (N j : Nat) (u : Real) : ENNReal :=
  ENNReal.ofReal
    (((2 : Real) ^ j) *
      brrsStationaryRapidProfile N (2 * Real.pi * ((2 : Real) ^ j * u)))

/-- Measurability of the dyadically normalized stationary phase profile. -/
theorem measurable_brrsDyadicStationaryPhaseProfile (N j : Nat) :
    Measurable (brrsDyadicStationaryPhaseProfile N j) := by
  unfold brrsDyadicStationaryPhaseProfile
  apply ENNReal.continuous_ofReal.measurable.comp
  apply measurable_const.mul
  apply (measurable_brrsStationaryRapidProfile N).comp
  fun_prop

/-- The dyadic stationary profile has exactly the same phase-line mass as its
level-zero counterpart.  This is the normalization used by the radial block
convolution estimates. -/
theorem lintegral_brrsDyadicStationaryPhaseProfile_eq
    (N j : Nat) :
    (∫⁻ u : Real, brrsDyadicStationaryPhaseProfile N j u) =
      ∫⁻ v : Real,
        ENNReal.ofReal (brrsStationaryRapidProfile N (2 * Real.pi * v)) := by
  let q : Real := (2 : Real) ^ j
  let G : Real → ENNReal := fun v =>
    ENNReal.ofReal (brrsStationaryRapidProfile N (2 * Real.pi * v))
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hG : Measurable G := by
    dsimp only [G]
    exact ENNReal.continuous_ofReal.measurable.comp
      ((measurable_brrsStationaryRapidProfile N).comp
        (by fun_prop))
  have happly (u : Real) :
      brrsDyadicStationaryPhaseProfile N j u =
        ENNReal.ofReal q * G (q * u) := by
    dsimp only [brrsDyadicStationaryPhaseProfile, q, G]
    rw [ENNReal.ofReal_mul hq.le]
  rw [show brrsDyadicStationaryPhaseProfile N j =
      fun u => ENNReal.ofReal q * G (q * u) from funext happly]
  change (∫⁻ u : Real, ENNReal.ofReal q * G (q * u)) = ∫⁻ v : Real, G v
  have hmul : Measurable (fun u : Real => q * u) :=
    measurable_const.mul measurable_id
  have hmass :
      (∫⁻ u : Real, ENNReal.ofReal q * G (q * u)) =
        ENNReal.ofReal q * ∫⁻ u : Real, G (q * u) := by
    simpa only [Function.comp_apply] using
      (lintegral_const_mul (μ := volume) (ENNReal.ofReal q) (hG.comp hmul))
  rw [hmass, lintegral_comp_mul_real_eq G hq]
  rw [← mul_assoc, ← ENNReal.ofReal_mul hq.le]
  have hqq : q * q⁻¹ = 1 := mul_inv_cancel₀ hq.ne'
  rw [hqq]
  simp

/-- The real stationary decay profile is strictly positive, including at the
origin.  Positivity is useful when it is used as a Young-convolution kernel. -/
theorem brrsStationaryRapidProfile_pos (N : Nat) (u : Real) :
    0 < brrsStationaryRapidProfile N u := by
  by_cases hu : u = 0
  · simp [brrsStationaryRapidProfile, hu]
  · rw [brrsStationaryRapidProfile, if_neg hu]
    exact lt_min (by norm_num)
      (pow_pos (one_div_pos.mpr (abs_pos.mpr hu)) _)

/-- The normalized dyadic stationary phase profile is strictly positive at
every phase value. -/
theorem brrsDyadicStationaryPhaseProfile_pos (N j : Nat) (u : Real) :
    0 < brrsDyadicStationaryPhaseProfile N j u := by
  unfold brrsDyadicStationaryPhaseProfile
  rw [ENNReal.ofReal_pos]
  exact mul_pos (pow_pos (by norm_num) _)
    (brrsStationaryRapidProfile_pos N _)

/-- Pointwise finiteness of the normalized dyadic stationary phase profile. -/
theorem brrsDyadicStationaryPhaseProfile_ne_top (N j : Nat) (u : Real) :
    brrsDyadicStationaryPhaseProfile N j u ≠ ∞ := by
  unfold brrsDyadicStationaryPhaseProfile
  exact ENNReal.ofReal_ne_top

/-- The normalized dyadic stationary profile has positive phase-line mass. -/
theorem lintegral_brrsDyadicStationaryPhaseProfile_pos (N j : Nat) :
    0 < ∫⁻ u : Real, brrsDyadicStationaryPhaseProfile N j u := by
  rw [lintegral_pos_iff_support
    (measurable_brrsDyadicStationaryPhaseProfile N j)]
  have hsupport : Function.support (brrsDyadicStationaryPhaseProfile N j) =
      Set.univ := by
    ext u
    simp only [Function.mem_support, Set.mem_univ, iff_true]
    exact (brrsDyadicStationaryPhaseProfile_pos N j u).ne'
  rw [hsupport]
  simp

/-- Quadratic stationary decay makes the dyadic profile's phase-line mass
finite.  Together with the preceding positivity lemma, this supplies all
mass hypotheses needed by the Section 5 positive Young inequality. -/
theorem lintegral_brrsDyadicStationaryPhaseProfile_ne_top
    (N j : Nat) (hN : 2 ≤ N) :
    (∫⁻ u : Real, brrsDyadicStationaryPhaseProfile N j u) ≠ ∞ := by
  have hbase : (∫⁻ u : Real,
      ENNReal.ofReal (brrsStationaryRapidProfile N u)) ≠ ∞ := by
    exact (lintegral_ofReal_ne_top_iff_integrable
      (measurable_brrsStationaryRapidProfile N).aestronglyMeasurable
      (Filter.Eventually.of_forall fun u =>
        brrsStationaryRapidProfile_nonneg N u)).mpr
        (integrable_brrsStationaryRapidProfile N hN)
  let P : Real → ENNReal := fun u =>
    ENNReal.ofReal (brrsStationaryRapidProfile N u)
  have hphase : (∫⁻ v : Real,
      ENNReal.ofReal (brrsStationaryRapidProfile N (2 * Real.pi * v))) ≠ ∞ := by
    have htransport := lintegral_comp_mul_real_eq P
      (show 0 < 2 * Real.pi by positivity)
    have htransport' :
        (∫⁻ v : Real,
          ENNReal.ofReal (brrsStationaryRapidProfile N (2 * Real.pi * v))) =
          ENNReal.ofReal (2 * Real.pi)⁻¹ *
            ∫⁻ u : Real, ENNReal.ofReal (brrsStationaryRapidProfile N u) := by
      simpa only [P] using htransport
    rw [htransport']
    exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top hbase
  rw [lintegral_brrsDyadicStationaryPhaseProfile_eq]
  exact hphase

end

end Auto.Spherical.BRRS

/-! ### The terminal radius cell in BRRS Section 5

For the last radial packet, the source does not use the local counting
coefficient.  It first restricts the source radius to `[0, 2^10]`, drops the
nonpositive polar weight on `[1,20]`, and then applies one-dimensional Young
to each of the four travelling phase lines.  The declarations below keep all
four signs visible in the positive `ENNReal` formulation.
-/

namespace Auto.Spherical.BRRS

open Set Filter MeasureTheory FourierTransform
open scoped BigOperators Convolution ENNReal FourierTransform Topology

noncomputable section

/-- The literal compact source-radius truncation in the definition of
`I_j` in BRRS (5.6). -/
noncomputable def brrsSectionFiveTerminalSourceProfile
    (f : Real → ENNReal) : Real → ENNReal :=
  (Icc (0 : Real) ((2 : Real) ^ (10 : Nat))).indicator f

/-- The polar output weight occurring in BRRS (5.4), retained on the
terminal radial interval `[1,20]` before it is bounded by one. -/
noncomputable def brrsSectionFiveTerminalWeight (d : Nat) (p r : Real) : ENNReal :=
  (ENNReal.ofReal r) ^ ((d - 1 : Nat) * (1 - p / 2))

/-- The four literal phase-line contributions to the terminal radial cell.
The minus and plus source conventions respectively encode
`t ± r - s` and `t ± r + s`; the source profile enforces `0 ≤ s ≤ 2^10`.
-/
noncomputable def brrsSectionFiveTerminalFourPhaseBlock
    (T : Finset Real) (d : Nat) (p : Real)
    (omega f : Real → ENNReal) : ENNReal :=
  (∑ t ∈ T, ∫⁻ r in Icc (1 : Real) 20,
      brrsSectionFiveTerminalWeight d p r *
        (brrsOneDimProfileConvolution omega
          (brrsSectionFiveTerminalSourceProfile f) (t - r)) ^ p) +
    (∑ t ∈ T, ∫⁻ r in Icc (1 : Real) 20,
      brrsSectionFiveTerminalWeight d p r *
        (brrsOneDimProfileConvolution omega
          (brrsSectionFiveTerminalSourceProfile f) (t + r)) ^ p) +
      (∑ t ∈ T, ∫⁻ r in Icc (1 : Real) 20,
        brrsSectionFiveTerminalWeight d p r *
          (brrsOneDimProfileConvolutionPlus omega
            (brrsSectionFiveTerminalSourceProfile f) (t - r)) ^ p) +
        ∑ t ∈ T, ∫⁻ r in Icc (1 : Real) 20,
          brrsSectionFiveTerminalWeight d p r *
            (brrsOneDimProfileConvolutionPlus omega
              (brrsSectionFiveTerminalSourceProfile f) (t + r)) ^ p

/-- The compact source truncation preserves measurability. -/
theorem measurable_brrsSectionFiveTerminalSourceProfile
    {f : Real → ENNReal} (hf : Measurable f) :
    Measurable (brrsSectionFiveTerminalSourceProfile f) := by
  unfold brrsSectionFiveTerminalSourceProfile
  exact hf.indicator measurableSet_Icc

/-- Restriction to the literal compact source interval can only decrease
every nonnegative `Lᵖ` moment. -/
theorem lintegral_brrsSectionFiveTerminalSourceProfile_rpow_le
    (f : Real → ENNReal) {p : Real} (hp : 0 ≤ p) :
    (∫⁻ s : Real, (brrsSectionFiveTerminalSourceProfile f s) ^ p) ≤
      ∫⁻ s : Real, (f s) ^ p := by
  apply lintegral_mono
  intro s
  apply ENNReal.rpow_le_rpow
  · by_cases hs : s ∈ Icc (0 : Real) ((2 : Real) ^ (10 : Nat))
    · simp [brrsSectionFiveTerminalSourceProfile, hs]
    · simp [brrsSectionFiveTerminalSourceProfile, hs]
  · exact hp

/-- On the terminal output interval, the BRRS polar weight is at most one
when `d ≥ 2` and `p ≥ 2`; this is the first inequality in (5.6). -/
theorem brrsSectionFiveTerminalWeight_le_one
    {d : Nat} {p r : Real} (_hd : 2 ≤ d) (hp : 2 ≤ p)
    (hr : r ∈ Icc (1 : Real) 20) :
    brrsSectionFiveTerminalWeight d p r ≤ 1 := by
  have hrpos : 0 < r := lt_of_lt_of_le (by norm_num) hr.1
  have hdim : 0 ≤ ((d - 1 : Nat) : Real) := Nat.cast_nonneg _
  have hpminus : 0 ≤ p / 2 - 1 := by linarith
  have hexp : 0 ≤ (d - 1 : Nat) * (p / 2 - 1) := by
    exact mul_nonneg hdim hpminus
  have hpow : (ENNReal.ofReal r) ^ (-((d - 1 : Nat) * (p / 2 - 1))) ≤ 1 := by
    by_cases hzero : (d - 1 : Nat) * (p / 2 - 1) = 0
    · simp [hzero]
    · apply ENNReal.rpow_le_one_of_one_le_of_neg
      · exact (ENNReal.one_le_ofReal).mpr hr.1
      · exact neg_neg_of_pos (lt_of_le_of_ne hexp (Ne.symm hzero))
  have heq : ((d - 1 : Nat) : Real) * (1 - p / 2) =
      -(((d - 1 : Nat) : Real) * (p / 2 - 1)) := by ring
  unfold brrsSectionFiveTerminalWeight
  rw [heq]
  exact hpow

end

end Auto.Spherical.BRRS

/-! ### Four-sign phase-transfer preparation

The exact radial kernel has five middle-wave terms in addition to the four
endpoint signs.  Before those terms can be absorbed into the four-sign kernel
of BRRS (5.4), we need a two-sided comparison between the concrete stationary
rapid profile and the usual Japanese bracket.  The lower comparison below is
the part that is not supplied by the integration-by-parts estimates: it lets
rapid spatial decay pay for moving a middle carrier onto an endpoint phase
line.
-/

namespace Auto.Spherical.BRRS

open Set Filter MeasureTheory FourierTransform
open Auto.LittlewoodPaley
open Auto.Spherical.SurfaceMeasureDecay
open Auto.Spherical.OscillatoryIntegralAux Auto.Spherical.AHRS
open scoped BigOperators Convolution ENNReal FourierTransform Topology

noncomputable section

/-- The elementary Japanese-bracket lower bound for the literal stationary
rapid profile.  Together with
`brrsStationaryRapidProfile_le_japaneseBracket`, this gives a two-sided
comparison with constants explicit enough for the middle-wave phase transfer.
-/
theorem brrsJapaneseBracket_le_brrsStationaryRapidProfile
    (N : Nat) (u : Real) :
    ((1 + |u|)⁻¹) ^ N ≤ brrsStationaryRapidProfile N u := by
  by_cases hu : u = 0
  · simp [brrsStationaryRapidProfile, hu]
  rw [brrsStationaryRapidProfile, if_neg hu]
  apply le_min
  · have hden : 1 ≤ 1 + |u| := by linarith [abs_nonneg u]
    have hinv : (1 + |u|)⁻¹ ≤ 1 := by
      simpa only [one_div] using inv_le_one_of_one_le₀ hden
    exact pow_le_one₀ (by positivity) hinv
  · have habs : 0 < |u| := abs_pos.mpr hu
    have hden : |u| ≤ 1 + |u| := by linarith
    have hinv : (1 + |u|)⁻¹ ≤ 1 / |u| := by
      simpa only [one_div] using one_div_le_one_div_of_le habs hden
    exact pow_le_pow_left₀ (by positivity) hinv N

/-- Rapid decay in a middle radius moves a middle carrier onto an endpoint
phase line.  This is the elementary Peetre-type estimate needed to turn the
five middle-wave profiles in the exact two-radius expansion into the four
signs of the BRRS kernel majorant. -/
theorem brrs_middleRapidProfile_transfer_to_endpointPhase
    (N : Nat) (x s : Real) :
    ((1 + |s|)⁻¹) ^ N *
        brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) ≤
      ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N) *
        brrsStationaryRapidProfile N (2 * Real.pi * (x - s)) := by
  let J : Real → Real := fun u => (1 + |u|)⁻¹
  have hJ_nonneg (u : Real) : 0 ≤ J u := by
    dsimp [J]
    positivity
  have hJ_le_one (u : Real) : J u ≤ 1 := by
    dsimp [J]
    have hden : 1 ≤ 1 + |u| := by linarith [abs_nonneg u]
    simpa only [one_div] using inv_le_one_of_one_le₀ hden
  have htriangle : 1 + |x - s| ≤ (1 + |x|) * (1 + |s|) := by
    have hsub : |x - s| ≤ |x| + |s| := by
      simpa [sub_eq_add_neg] using abs_add_le x (-s)
    have hprod : 0 ≤ |x| * |s| := mul_nonneg (abs_nonneg x) (abs_nonneg s)
    nlinarith
  have hinv : J x * J s ≤ J (x - s) := by
    dsimp [J]
    rw [← mul_inv]
    simpa only [one_div] using
      (one_div_le_one_div_of_le (by positivity) htriangle)
  have hpow : J x ^ N * J s ^ N ≤ J (x - s) ^ N := by
    calc
      J x ^ N * J s ^ N = (J x * J s) ^ N := by rw [mul_pow]
      _ ≤ J (x - s) ^ N :=
        pow_le_pow_left₀ (mul_nonneg (hJ_nonneg x) (hJ_nonneg s)) hinv N
  have hmore : J x ^ (2 * N) * J s ^ N ≤ J (x - s) ^ N := by
    have hJpow : J x ^ N ≤ 1 :=
      pow_le_one₀ (hJ_nonneg x) (hJ_le_one x)
    calc
      J x ^ (2 * N) * J s ^ N = J x ^ N * (J x ^ N * J s ^ N) := by
        rw [show 2 * N = N + N by omega, pow_add]
        ring
      _ ≤ 1 * (J x ^ N * J s ^ N) := by
        apply mul_le_mul_of_nonneg_right hJpow
        exact mul_nonneg (pow_nonneg (hJ_nonneg x) _)
          (pow_nonneg (hJ_nonneg s) _)
      _ = J x ^ N * J s ^ N := by ring
      _ ≤ J (x - s) ^ N := hpow
  have hpi : 0 < 2 * Real.pi := by positivity
  have hJ_scaled_upper : J (2 * Real.pi * x) ≤ J x := by
    dsimp [J]
    have hden : 1 + |x| ≤ 1 + |2 * Real.pi * x| := by
      rw [abs_mul, abs_of_pos hpi]
      nlinarith [abs_nonneg x, Real.pi_gt_three]
    simpa only [one_div] using
      (one_div_le_one_div_of_le (by positivity) hden)
  have hrapid_upper :
      brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) ≤
        (2 : Real) ^ (2 * N) * J x ^ (2 * N) := by
    calc
      brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) ≤
          (2 : Real) ^ (2 * N) * J (2 * Real.pi * x) ^ (2 * N) := by
        simpa only [J] using
          (brrsStationaryRapidProfile_le_japaneseBracket (2 * N)
            (2 * Real.pi * x))
      _ ≤ (2 : Real) ^ (2 * N) * J x ^ (2 * N) := by
        apply mul_le_mul_of_nonneg_left
        · exact pow_le_pow_left₀ (hJ_nonneg _) hJ_scaled_upper _
        · positivity
  have hJ_scaled_lower : J (x - s) ≤
      (2 * Real.pi) * J (2 * Real.pi * (x - s)) := by
    dsimp [J]
    rw [abs_mul, abs_of_pos hpi]
    have hdiv : 1 / (1 + |x - s|) ≤
        (2 * Real.pi) / (1 + (2 * Real.pi) * |x - s|) := by
      apply (div_le_div_iff₀ (by positivity) (by positivity)).2
      nlinarith [abs_nonneg (x - s), Real.pi_gt_three]
    simpa only [one_div, one_mul, div_eq_mul_inv] using hdiv
  have hendpoint_lower : J (x - s) ^ N ≤
      (2 * Real.pi) ^ N *
        brrsStationaryRapidProfile N (2 * Real.pi * (x - s)) := by
    calc
      J (x - s) ^ N ≤
          ((2 * Real.pi) * J (2 * Real.pi * (x - s))) ^ N :=
        pow_le_pow_left₀ (hJ_nonneg _) hJ_scaled_lower N
      _ = (2 * Real.pi) ^ N * J (2 * Real.pi * (x - s)) ^ N := by
        rw [mul_pow]
      _ ≤ (2 * Real.pi) ^ N *
          brrsStationaryRapidProfile N (2 * Real.pi * (x - s)) := by
        apply mul_le_mul_of_nonneg_left
        · exact brrsJapaneseBracket_le_brrsStationaryRapidProfile N
            (2 * Real.pi * (x - s))
        · positivity
  calc
    J s ^ N * brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) ≤
        J s ^ N * ((2 : Real) ^ (2 * N) * J x ^ (2 * N)) := by
      apply mul_le_mul_of_nonneg_left hrapid_upper
      exact pow_nonneg (hJ_nonneg s) _
    _ = (2 : Real) ^ (2 * N) * (J x ^ (2 * N) * J s ^ N) := by ring
    _ ≤ (2 : Real) ^ (2 * N) * J (x - s) ^ N := by
      apply mul_le_mul_of_nonneg_left hmore
      positivity
    _ ≤ (2 : Real) ^ (2 * N) *
        ((2 * Real.pi) ^ N *
          brrsStationaryRapidProfile N (2 * Real.pi * (x - s))) := by
      apply mul_le_mul_of_nonneg_left hendpoint_lower
      positivity
    _ = ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N) *
        brrsStationaryRapidProfile N (2 * Real.pi * (x - s)) := by ring

/-- A compact radial displacement can be absorbed into a stationary phase
profile after doubling the number of integrations by parts.  This is the
small-radius companion to the high-radius phase transfer: it is what turns
the `0` carrier of a low-radius stationary wave into either endpoint sign. -/
theorem brrsStationaryRapidProfile_smallRadius_shift_to_endpointPhase
    (N : Nat) (x delta : Real) (hdelta : |delta| ≤ 16) :
    brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) ≤
      ((17 : Real) ^ N *
        ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N)) *
        brrsStationaryRapidProfile N (2 * Real.pi * (x - delta)) := by
  let J : Real := (1 + |delta|)⁻¹
  let L : Real := (2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N
  have hJnonneg : 0 ≤ J := by
    dsimp [J]
    positivity
  have hdenpos : 0 < 1 + |delta| := by positivity
  have hdenle : 1 + |delta| ≤ 17 := by linarith
  have hscale_base : 1 ≤ 17 * J := by
    dsimp [J]
    rw [show 17 * (1 + |delta|)⁻¹ = 17 / (1 + |delta|) by ring]
    exact (le_div_iff₀ hdenpos).mpr (by simpa using hdenle)
  have hscale : 1 ≤ (17 : Real) ^ N * J ^ N := by
    calc
      1 = (1 : Real) ^ N := by simp
      _ ≤ (17 * J) ^ N := by
        exact pow_le_pow_left₀ (by positivity) hscale_base N
      _ = (17 : Real) ^ N * J ^ N := by rw [mul_pow]
  have htransfer := brrs_middleRapidProfile_transfer_to_endpointPhase N x delta
  have hPnonneg : 0 ≤ brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) :=
    brrsStationaryRapidProfile_nonneg _ _
  calc
    brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) =
        1 * brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) := by ring
    _ ≤ ((17 : Real) ^ N * J ^ N) *
        brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) :=
      mul_le_mul_of_nonneg_right hscale hPnonneg
    _ = (17 : Real) ^ N *
        (J ^ N * brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x)) := by
      ring
    _ ≤ (17 : Real) ^ N *
        (L * brrsStationaryRapidProfile N (2 * Real.pi * (x - delta))) := by
      apply mul_le_mul_of_nonneg_left
      · simpa only [J, L] using htransfer
      · positivity
    _ = ((17 : Real) ^ N * L) *
        brrsStationaryRapidProfile N (2 * Real.pi * (x - delta)) := by ring

/-- At a high radial position, the extra `2 N` half-powers produced by a
middle Bessel remainder dominate the Japanese-bracket factor needed to move
its carrier onto an endpoint phase.  The normalization by `16` is the one
used by the stationary component bounds. -/
theorem brrs_highRadius_sqrt_decay_le_japaneseBracket
    {s : Real} (hs : 16 ≤ s) (N : Nat) :
    1 / (Real.sqrt (s / 16)) ^ (2 * N) ≤
      (32 : Real) ^ N * ((1 + |s|)⁻¹) ^ N := by
  have hspos : 0 < s := by linarith
  have hroot : 0 < Real.sqrt (s / 16) := by
    apply Real.sqrt_pos.2
    positivity
  have hsq : (Real.sqrt (s / 16)) ^ 2 = s / 16 :=
    Real.sq_sqrt (by positivity)
  have hbase : 1 / s ≤ 2 * ((1 + |s|)⁻¹) := by
    rw [abs_of_pos hspos]
    rw [show (1 + s)⁻¹ = 1 / (1 + s) by rw [one_div]]
    calc
      1 / s ≤ 2 / (1 + s) := by
        apply (div_le_div_iff₀ hspos (by positivity)).2
        nlinarith
      _ = 2 * (1 / (1 + s)) := by simp only [one_mul, div_eq_mul_inv]
  have hpow : (1 / s) ^ N ≤ (2 * ((1 + |s|)⁻¹)) ^ N :=
    pow_le_pow_left₀ (by positivity) hbase N
  have hleft :
      1 / (Real.sqrt (s / 16)) ^ (2 * N) =
        (16 : Real) ^ N * (1 / s) ^ N := by
    rw [show 2 * N = 2 * N by rfl, pow_mul, hsq, div_pow, one_div_pow]
    field_simp [pow_ne_zero N (ne_of_gt hspos)]
  rw [hleft]
  calc
    (16 : Real) ^ N * (1 / s) ^ N ≤
        (16 : Real) ^ N * (2 * ((1 + |s|)⁻¹)) ^ N := by
      exact mul_le_mul_of_nonneg_left hpow (by positivity)
    _ = (32 : Real) ^ N * ((1 + |s|)⁻¹) ^ N := by
      rw [mul_pow]
      calc
        (16 : Real) ^ N * (2 ^ N * ((1 + |s|)⁻¹) ^ N) =
            ((1 + |s|)⁻¹) ^ N * (2 ^ N * 16 ^ N) := by ring
        _ = ((1 + |s|)⁻¹) ^ N * (32 : Real) ^ N := by
          congr 1
          rw [← mul_pow]
          norm_num
        _ = (32 : Real) ^ N * ((1 + |s|)⁻¹) ^ N := by ring

/-- An extra `2 N` half-powers in a high middle radius moves its carrier by
any nonnegative distance no larger than that radius.  This is the precise
Peetre bridge used both for a middle--endpoint term and, after comparing the
two radii, for the middle--middle term. -/
theorem brrs_highRadius_middle_decay_transfer_to_endpointPhase_of_nonneg_le
    {u a : Real} (hu : 16 ≤ u) (ha0 : 0 ≤ a) (hau : a ≤ u)
    (N : Nat) (x : Real) :
    (1 / (Real.sqrt (u / 16)) ^ (2 * N)) *
        brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) ≤
      ((32 : Real) ^ N * ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N)) *
        brrsStationaryRapidProfile N (2 * Real.pi * (x - a)) := by
  have hu0 : 0 ≤ u := by linarith
  have hbracket : ((1 + |u|)⁻¹) ^ N ≤ ((1 + |a|)⁻¹) ^ N := by
    have hbase : (1 + |u|)⁻¹ ≤ (1 + |a|)⁻¹ := by
      rw [abs_of_nonneg hu0, abs_of_nonneg ha0]
      simpa only [one_div] using
        (one_div_le_one_div_of_le (by positivity : 0 < 1 + a) (by linarith))
    exact pow_le_pow_left₀ (by positivity) hbase N
  have hdecay := brrs_highRadius_sqrt_decay_le_japaneseBracket hu N
  have htransfer := brrs_middleRapidProfile_transfer_to_endpointPhase N x a
  calc
    (1 / (Real.sqrt (u / 16)) ^ (2 * N)) *
        brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) ≤
      ((32 : Real) ^ N * ((1 + |u|)⁻¹) ^ N) *
        brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) := by
      exact mul_le_mul_of_nonneg_right hdecay
        (brrsStationaryRapidProfile_nonneg _ _)
    _ ≤ ((32 : Real) ^ N * ((1 + |a|)⁻¹) ^ N) *
        brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) := by
      apply mul_le_mul_of_nonneg_right
      · exact mul_le_mul_of_nonneg_left hbracket (by positivity)
      · exact brrsStationaryRapidProfile_nonneg _ _
    _ = (32 : Real) ^ N *
        (((1 + |a|)⁻¹) ^ N *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x)) := by ring
    _ ≤ (32 : Real) ^ N *
        (((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N) *
          brrsStationaryRapidProfile N (2 * Real.pi * (x - a))) := by
      exact mul_le_mul_of_nonneg_left htransfer (by positivity)
    _ = ((32 : Real) ^ N * ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N)) *
        brrsStationaryRapidProfile N (2 * Real.pi * (x - a)) := by ring

/-- Factoring a high-radius middle remainder into the endpoint half-density
and the extra `2 N` half-powers.  This keeps the eventual
`(s / r)^((d-1)/2)` normalization visible rather than absorbing it into an
unnamed constant. -/
theorem brrs_twoRadius_middle_denominator_factor
    {r s : Real} (hr : 16 ≤ r) (hs : 16 ≤ s) (k N : Nat) (C : Real) :
    C / ((Real.sqrt (r / 16)) ^ k *
      (Real.sqrt (s / 16)) ^ (k + 2 * N)) =
      (C / ((Real.sqrt (r / 16)) ^ k *
        (Real.sqrt (s / 16)) ^ k)) *
        (1 / (Real.sqrt (s / 16)) ^ (2 * N)) := by
  have hrpos : 0 < Real.sqrt (r / 16) := by
    apply Real.sqrt_pos.2
    linarith
  have hspos : 0 < Real.sqrt (s / 16) := by
    apply Real.sqrt_pos.2
    linarith
  rw [pow_add]
  field_simp [hrpos.ne', hspos.ne']

/-- The extra high-radius middle factor is at most one, so an unused rapid
denominator may safely be discarded after it has supplied a phase transfer. -/
theorem brrs_highRadius_sqrt_inverse_pow_le_one
    {u : Real} (hu : 16 ≤ u) (N : Nat) :
    1 / (Real.sqrt (u / 16)) ^ (2 * N) ≤ 1 := by
  have hroot : 1 ≤ Real.sqrt (u / 16) := by
    apply Real.one_le_sqrt.mpr
    linarith
  have hpow : 1 ≤ (Real.sqrt (u / 16)) ^ (2 * N) :=
    one_le_pow₀ hroot
  simpa only [one_div] using inv_le_one_of_one_le₀ hpow

/-- At ordered high radii, the five profiles arising from at least one
middle Bessel wave are absorbed into the four endpoint phase lines.  The
extra `2 N` half-powers are retained explicitly on the radius carrying the
middle remainder.  This is the scalar phase-transfer step behind the
four-sign radial kernel majorant. -/
theorem brrs_highRadius_ordered_fiveMiddleProfiles_le_fourEndpointProfiles
    {r s t : Real} (hr : 16 ≤ r) (hs : 16 ≤ s) (hsr : s ≤ r) (N : Nat) :
    (1 / (Real.sqrt (s / 16)) ^ (2 * N)) *
        (brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - r)) +
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + r))) +
      (1 / (Real.sqrt (r / 16)) ^ (2 * N)) *
        (brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - s)) +
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + s)) +
            brrsStationaryRapidProfile (2 * N) (2 * Real.pi * t)) ≤
      (5 * ((32 : Real) ^ N * ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N))) *
        (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
          brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
  let L : Real := (32 : Real) ^ N *
    ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N)
  let E₁ : Real := brrsStationaryRapidProfile N
    (2 * Real.pi * (t - r - s))
  let E₂ : Real := brrsStationaryRapidProfile N
    (2 * Real.pi * (t - r + s))
  let E₃ : Real := brrsStationaryRapidProfile N
    (2 * Real.pi * (t + r - s))
  let E₄ : Real := brrsStationaryRapidProfile N
    (2 * Real.pi * (t + r + s))
  let S : Real := E₁ + E₂ + E₃ + E₄
  have hL : 0 ≤ L := by
    dsimp [L]
    positivity
  have hE₁ : 0 ≤ E₁ := by
    dsimp [E₁]
    exact brrsStationaryRapidProfile_nonneg _ _
  have hE₂ : 0 ≤ E₂ := by
    dsimp [E₂]
    exact brrsStationaryRapidProfile_nonneg _ _
  have hE₃ : 0 ≤ E₃ := by
    dsimp [E₃]
    exact brrsStationaryRapidProfile_nonneg _ _
  have hE₄ : 0 ≤ E₄ := by
    dsimp [E₄]
    exact brrsStationaryRapidProfile_nonneg _ _
  have hE₁S : E₁ ≤ S := by
    dsimp [S]
    linarith
  have hE₂S : E₂ ≤ S := by
    dsimp [S]
    linarith
  have hE₃S : E₃ ≤ S := by
    dsimp [S]
    linarith
  have hE₄S : E₄ ≤ S := by
    dsimp [S]
    linarith
  have h₁ :=
    brrs_highRadius_middle_decay_transfer_to_endpointPhase_of_nonneg_le
      (u := s) (a := s) hs (by linarith) le_rfl N (t - r)
  have h₂ :=
    brrs_highRadius_middle_decay_transfer_to_endpointPhase_of_nonneg_le
      (u := s) (a := s) hs (by linarith) le_rfl N (t + r)
  have h₃ :=
    brrs_highRadius_middle_decay_transfer_to_endpointPhase_of_nonneg_le
      (u := r) (a := r) hr (by linarith) le_rfl N (t - s)
  have h₄ :=
    brrs_highRadius_middle_decay_transfer_to_endpointPhase_of_nonneg_le
      (u := r) (a := r) hr (by linarith) le_rfl N (t + s)
  have hrs0 : 0 ≤ r - s := by linarith
  have hrsle : r - s ≤ r := by linarith
  have h₅ :=
    brrs_highRadius_middle_decay_transfer_to_endpointPhase_of_nonneg_le
      (u := r) (a := r - s) hr hrs0 hrsle N t
  have h₁' :
      (1 / (Real.sqrt (s / 16)) ^ (2 * N)) *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - r)) ≤
        L * E₁ := by
    dsimp [L, E₁]
    convert h₁ using 1
  have h₂' :
      (1 / (Real.sqrt (s / 16)) ^ (2 * N)) *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + r)) ≤
        L * E₃ := by
    dsimp [L, E₃]
    convert h₂ using 1
  have h₃' :
      (1 / (Real.sqrt (r / 16)) ^ (2 * N)) *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - s)) ≤
        L * E₁ := by
    dsimp [L, E₁]
    convert h₃ using 1; ring
  have h₄' :
      (1 / (Real.sqrt (r / 16)) ^ (2 * N)) *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + s)) ≤
        L * E₂ := by
    dsimp [L, E₂]
    convert h₄ using 1; ring
  have h₅' :
      (1 / (Real.sqrt (r / 16)) ^ (2 * N)) *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * t) ≤
        L * E₂ := by
    dsimp [L, E₂]
    convert h₅ using 1; ring
  have hLS₁ : L * E₁ ≤ L * S :=
    mul_le_mul_of_nonneg_left hE₁S hL
  have hLS₂ : L * E₂ ≤ L * S :=
    mul_le_mul_of_nonneg_left hE₂S hL
  have hLS₃ : L * E₃ ≤ L * S :=
    mul_le_mul_of_nonneg_left hE₃S hL
  calc
    (1 / (Real.sqrt (s / 16)) ^ (2 * N)) *
          (brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - r)) +
            brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + r))) +
        (1 / (Real.sqrt (r / 16)) ^ (2 * N)) *
          (brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - s)) +
            brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + s)) +
              brrsStationaryRapidProfile (2 * N) (2 * Real.pi * t)) =
        ((1 / (Real.sqrt (s / 16)) ^ (2 * N)) *
            brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - r)) +
          (1 / (Real.sqrt (s / 16)) ^ (2 * N)) *
            brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + r))) +
          ((1 / (Real.sqrt (r / 16)) ^ (2 * N)) *
              brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - s)) +
            (1 / (Real.sqrt (r / 16)) ^ (2 * N)) *
              brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + s)) +
              (1 / (Real.sqrt (r / 16)) ^ (2 * N)) *
                brrsStationaryRapidProfile (2 * N) (2 * Real.pi * t)) := by
      ring
    _ ≤ (L * E₁ + L * E₃) + (L * E₁ + L * E₂ + L * E₂) := by
      gcongr
    _ ≤ (L * S + L * S) + (L * S + L * S + L * S) := by
      gcongr
    _ = (5 * L) * S := by ring
    _ = (5 * ((32 : Real) ^ N *
          ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N))) *
        (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
          brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
      rfl

end

end Auto.Spherical.BRRS

/-! ### Terminal radial-packet scalar estimates

The last output-radius packet in the Section 5 decomposition does not need
local entropy: its finite time sum is controlled directly by translation
invariance on the phase line.  The following lemmas record that argument for
an arbitrary closed radial interval and an arbitrary finite packet.  They are
stated first for a measurable nonnegative profile, then specialized to the
`ENNReal` `p`-power convention used by the radial block estimates.
-/

namespace Auto.Spherical.BRRS

open Set Filter MeasureTheory FourierTransform
open scoped BigOperators Convolution ENNReal FourierTransform Topology

noncomputable section

/-- Restricting an outgoing translated phase-line profile to any radial
interval can only decrease its global mass. -/
theorem brrs_lintegral_Icc_add_profile_le_global
    (G : Real → ENNReal) (t a b : Real) :
    (∫⁻ r in Icc a b, G (t + r)) ≤ ∫⁻ x : Real, G x := by
  calc
    (∫⁻ r in Icc a b, G (t + r)) ≤ ∫⁻ r : Real, G (t + r) := by
      simpa only [Measure.restrict_univ] using
        (lintegral_mono_set
          (f := fun r : Real => G (t + r)) (Set.subset_univ _))
    _ = ∫⁻ x : Real, G x := by
      rw [lintegral_add_left_eq_self]

/-- The reflected incoming translated phase-line profile has the same global
mass bound on every radial interval. -/
theorem brrs_lintegral_Icc_sub_profile_le_global
    (G : Real → ENNReal) (t a b : Real) :
    (∫⁻ r in Icc a b, G (t - r)) ≤ ∫⁻ x : Real, G x := by
  calc
    (∫⁻ r in Icc a b, G (t - r)) ≤ ∫⁻ r : Real, G (t - r) := by
      simpa only [Measure.restrict_univ] using
        (lintegral_mono_set
          (f := fun r : Real => G (t - r)) (Set.subset_univ _))
    _ = ∫⁻ x : Real, G x := by
      rw [lintegral_sub_left_eq_self]

/-- A uniformly bounded radial weight can be pulled out of an outgoing
terminal interval, after which translation invariance controls the profile
by its full phase-line mass. -/
theorem brrs_lintegral_Icc_add_weighted_profile_le
    (G W : Real → ENNReal) (t a b : Real) (C : ENNReal)
    (hG : Measurable G)
    (hW : ∀ r ∈ Icc a b, W r ≤ C) :
    (∫⁻ r in Icc a b, W r * G (t + r)) ≤ C * ∫⁻ x : Real, G x := by
  have htranslate : Measurable (fun r : Real => G (t + r)) :=
    hG.comp (measurable_const.add measurable_id)
  calc
    (∫⁻ r in Icc a b, W r * G (t + r)) ≤
        ∫⁻ r in Icc a b, C * G (t + r) := by
      apply lintegral_mono_ae
      filter_upwards [ae_restrict_mem measurableSet_Icc] with r hr
      exact mul_le_mul' (hW r hr) le_rfl
    _ = C * ∫⁻ r in Icc a b, G (t + r) := by
      rw [lintegral_const_mul C htranslate]
    _ ≤ C * ∫⁻ x : Real, G x :=
      mul_le_mul' le_rfl (brrs_lintegral_Icc_add_profile_le_global G t a b)

/-- The incoming counterpart of
`brrs_lintegral_Icc_add_weighted_profile_le`. -/
theorem brrs_lintegral_Icc_sub_weighted_profile_le
    (G W : Real → ENNReal) (t a b : Real) (C : ENNReal)
    (hG : Measurable G)
    (hW : ∀ r ∈ Icc a b, W r ≤ C) :
    (∫⁻ r in Icc a b, W r * G (t - r)) ≤ C * ∫⁻ x : Real, G x := by
  have htranslate : Measurable (fun r : Real => G (t - r)) :=
    hG.comp (measurable_const.sub measurable_id)
  calc
    (∫⁻ r in Icc a b, W r * G (t - r)) ≤
        ∫⁻ r in Icc a b, C * G (t - r) := by
      apply lintegral_mono_ae
      filter_upwards [ae_restrict_mem measurableSet_Icc] with r hr
      exact mul_le_mul' (hW r hr) le_rfl
    _ = C * ∫⁻ r in Icc a b, G (t - r) := by
      rw [lintegral_const_mul C htranslate]
    _ ≤ C * ∫⁻ x : Real, G x :=
      mul_le_mul' le_rfl (brrs_lintegral_Icc_sub_profile_le_global G t a b)

/-- Summing the outgoing terminal interval estimate over a finite time packet
costs exactly the cardinality of that packet. -/
theorem brrs_sum_Icc_add_weighted_profile_le_card_mul
    (T : Finset Real) (a b : Real) (C : ENNReal)
    (W G : Real → ENNReal) (hG : Measurable G)
    (hW : ∀ r ∈ Icc a b, W r ≤ C) :
    (∑ t ∈ T, ∫⁻ r in Icc a b, W r * G (t + r)) ≤
      (T.card : ENNReal) * C * ∫⁻ x : Real, G x := by
  calc
    (∑ t ∈ T, ∫⁻ r in Icc a b, W r * G (t + r)) ≤
        ∑ t ∈ T, C * ∫⁻ x : Real, G x := by
      apply Finset.sum_le_sum
      intro t ht
      exact brrs_lintegral_Icc_add_weighted_profile_le G W t a b C hG hW
    _ = (T.card : ENNReal) * C * ∫⁻ x : Real, G x := by
      rw [Finset.sum_const, nsmul_eq_mul]
      ac_rfl

/-- Summing the incoming terminal interval estimate over a finite time packet
costs exactly the cardinality of that packet. -/
theorem brrs_sum_Icc_sub_weighted_profile_le_card_mul
    (T : Finset Real) (a b : Real) (C : ENNReal)
    (W G : Real → ENNReal) (hG : Measurable G)
    (hW : ∀ r ∈ Icc a b, W r ≤ C) :
    (∑ t ∈ T, ∫⁻ r in Icc a b, W r * G (t - r)) ≤
      (T.card : ENNReal) * C * ∫⁻ x : Real, G x := by
  calc
    (∑ t ∈ T, ∫⁻ r in Icc a b, W r * G (t - r)) ≤
        ∑ t ∈ T, C * ∫⁻ x : Real, G x := by
      apply Finset.sum_le_sum
      intro t ht
      exact brrs_lintegral_Icc_sub_weighted_profile_le G W t a b C hG hW
    _ = (T.card : ENNReal) * C * ∫⁻ x : Real, G x := by
      rw [Finset.sum_const, nsmul_eq_mul]
      ac_rfl

/-- The outgoing terminal-packet bound in the `ENNReal` `p`-power form used
by the BRRS Section 5 scalar estimates. -/
theorem brrs_sum_terminalInterval_add_weighted_rpow_le_card_mul
    (T : Finset Real) (a b p : Real) (C : ENNReal)
    (W F : Real → ENNReal) (hF : Measurable F)
    (hW : ∀ r ∈ Icc a b, W r ≤ C) :
    (∑ t ∈ T, ∫⁻ r in Icc a b, W r * (F (t + r)) ^ p) ≤
      (T.card : ENNReal) * C * ∫⁻ x : Real, (F x) ^ p := by
  exact brrs_sum_Icc_add_weighted_profile_le_card_mul T a b C W
    (fun x : Real => (F x) ^ p)
    (ENNReal.continuous_rpow_const.measurable.comp hF) hW

/-- The incoming terminal-packet bound in the `ENNReal` `p`-power form used
by the BRRS Section 5 scalar estimates. -/
theorem brrs_sum_terminalInterval_sub_weighted_rpow_le_card_mul
    (T : Finset Real) (a b p : Real) (C : ENNReal)
    (W F : Real → ENNReal) (hF : Measurable F)
    (hW : ∀ r ∈ Icc a b, W r ≤ C) :
    (∑ t ∈ T, ∫⁻ r in Icc a b, W r * (F (t - r)) ^ p) ≤
      (T.card : ENNReal) * C * ∫⁻ x : Real, (F x) ^ p := by
  exact brrs_sum_Icc_sub_weighted_profile_le_card_mul T a b C W
    (fun x : Real => (F x) ^ p)
    (ENNReal.continuous_rpow_const.measurable.comp hF) hW

end

end Auto.Spherical.BRRS

/-! ### All-nine high--high stationary profile

The literal two-radius kernel has nine stationary components, not merely the
four endpoint--endpoint components.  At two high radii the same compact
frequency integration-by-parts estimate applies to each of the nine pieces.
The resulting bound deliberately keeps the five profiles involving a middle
wave: this is the profile estimate compatible with the exact kernel identity.
-/

namespace Auto.Spherical.BRRS

open Set Filter MeasureTheory FourierTransform
open Auto.LittlewoodPaley
open Auto.Spherical.SurfaceMeasureDecay
open Auto.Spherical.OscillatoryIntegralAux Auto.Spherical.AHRS
open scoped BigOperators Convolution ENNReal FourierTransform Topology

noncomputable section

/-- The full exact stationary contribution to the two-radius kernel, with
all nine pairs of outgoing, incoming, and middle waves displayed
individually.  The four endpoint--endpoint terms are the previously named
`brrsTwoRadiusEndpointIntegralSum`; the other five terms are retained because
the equality with the literal kernel is exact. -/
noncomputable def brrsTwoRadiusAllStationaryComponentIntegralSum
    (Phi : BRRSAnnularCutoff) (d : Nat) (r s t : Real) : Complex :=
  ((brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .outgoing r s t +
      brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .incoming r s t) +
    brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .middle r s t) +
      (((brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .outgoing r s t +
          brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .incoming r s t) +
        brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .middle r s t) +
          ((brrsTwoRadiusStationaryComponentIntegral Phi d .middle .outgoing r s t +
            brrsTwoRadiusStationaryComponentIntegral Phi d .middle .incoming r s t) +
              brrsTwoRadiusStationaryComponentIntegral Phi d .middle .middle r s t))

/-- The five literal stationary components involving at least one middle
wave.  Keeping this remainder named makes its rapid spatial decay available
to the radial-block argument without altering the exact nine-term identity. -/
noncomputable def brrsTwoRadiusMiddleComponentIntegralSum
    (Phi : BRRSAnnularCutoff) (d : Nat) (r s t : Real) : Complex :=
  brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .middle r s t +
    brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .middle r s t +
      (brrsTwoRadiusStationaryComponentIntegral Phi d .middle .outgoing r s t +
        brrsTwoRadiusStationaryComponentIntegral Phi d .middle .incoming r s t +
          brrsTwoRadiusStationaryComponentIntegral Phi d .middle .middle r s t)

/-- At two high radii, the five literal components containing a middle wave
are controlled by their five exact phase profiles.  The first two terms place
the middle factor in the second radius and hence retain rapid decay in `s`;
the final three retain it in `r`.  No component is discarded. -/
theorem exists_norm_brrsTwoRadMiddleCompIntegralSum_highRad_fivePhase_rapidProfile_le
    {d N M : Nat} (hd : 3 ≤ d) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsTwoRadiusMiddleComponentIntegralSum Phi d r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (s / 16)) ^ (M - 1) *
            (Real.sqrt (r / 16)) ^ (d - 1))) *
          (brrsStationaryRapidProfile N
              (brrsSurfaceWavePhase .outgoing r +
                brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) +
            brrsStationaryRapidProfile N
              (brrsSurfaceWavePhase .incoming r +
                brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)) +
          (1 - (1 / 32 : Real)) *
            (C / ((Real.sqrt (r / 16)) ^ (M - 1) *
              (Real.sqrt (s / 16)) ^ (d - 1))) *
            (brrsStationaryRapidProfile N
                (brrsSurfaceWavePhase .middle r +
                  brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) +
              brrsStationaryRapidProfile N
                (brrsSurfaceWavePhase .middle r +
                  brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) +
                brrsStationaryRapidProfile N
                  (brrsSurfaceWavePhase .middle r +
                    brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)) := by
  obtain ⟨Cmo, hCmo, hmo⟩ :=
    exists_norm_brrsTwoRadStatComponentIntegral_middle_highRad_rapidProfile_le
      (d := d) (N := N) (M := M) hd hM Phi .outgoing
  obtain ⟨Cmi, hCmi, hmi⟩ :=
    exists_norm_brrsTwoRadStatComponentIntegral_middle_highRad_rapidProfile_le
      (d := d) (N := N) (M := M) hd hM Phi .incoming
  obtain ⟨Cmm, hCmm, hmm⟩ :=
    exists_norm_brrsTwoRadStatComponentIntegral_middle_highRad_rapidProfile_le
      (d := d) (N := N) (M := M) hd hM Phi .middle
  let C : Real := Cmo + Cmi + Cmm
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  let qr : Real := (Real.sqrt (r / 16)) ^ (M - 1) *
    (Real.sqrt (s / 16)) ^ (d - 1)
  let qs : Real := (Real.sqrt (s / 16)) ^ (M - 1) *
    (Real.sqrt (r / 16)) ^ (d - 1)
  let Ar : Real := (1 - (1 / 32 : Real)) * (C / qr)
  let As : Real := (1 - (1 / 32 : Real)) * (C / qs)
  have hqr : 0 < qr := by
    dsimp [qr]
    apply mul_pos
    · apply pow_pos
      apply Real.sqrt_pos.2
      linarith
    · apply pow_pos
      apply Real.sqrt_pos.2
      linarith
  have hqs : 0 < qs := by
    dsimp [qs]
    apply mul_pos
    · apply pow_pos
      apply Real.sqrt_pos.2
      linarith
    · apply pow_pos
      apply Real.sqrt_pos.2
      linarith
  have hCmo_le : Cmo ≤ C := by
    dsimp [C]
    linarith
  have hCmi_le : Cmi ≤ C := by
    dsimp [C]
    linarith
  have hCmm_le : Cmm ≤ C := by
    dsimp [C]
    linarith
  have hAr_le (D : Real) (hD : D ≤ C) :
      (1 - (1 / 32 : Real)) * (D / qr) ≤ Ar := by
    dsimp [Ar]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hD hqr.le
    · norm_num
  have hAs_le (D : Real) (hD : D ≤ C) :
      (1 - (1 / 32 : Real)) * (D / qs) ≤ As := by
    dsimp [As]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hD hqs.le
    · norm_num
  let Pom : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .outgoing r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  let Pim : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .incoming r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  let Pmo : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t)
  let Pmi : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)
  let Pmm : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  let Iom : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .middle r s t
  let Iim : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .middle r s t
  let Imo : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .middle .outgoing r s t
  let Imi : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .middle .incoming r s t
  let Imm : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .middle .middle r s t
  have hphaseom :
      brrsSurfaceWavePhase .middle s + brrsSurfaceWavePhase .outgoing r +
          2 * Real.pi * t =
        brrsSurfaceWavePhase .outgoing r + brrsSurfaceWavePhase .middle s +
          2 * Real.pi * t := by ring
  have hphaseim :
      brrsSurfaceWavePhase .middle s + brrsSurfaceWavePhase .incoming r +
          2 * Real.pi * t =
        brrsSurfaceWavePhase .incoming r + brrsSurfaceWavePhase .middle s +
          2 * Real.pi * t := by ring
  have hPom : 0 ≤ Pom := by
    dsimp [Pom]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPim : 0 ≤ Pim := by
    dsimp [Pim]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPmo : 0 ≤ Pmo := by
    dsimp [Pmo]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPmi : 0 ≤ Pmi := by
    dsimp [Pmi]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPmm : 0 ≤ Pmm := by
    dsimp [Pmm]
    exact brrsStationaryRapidProfile_nonneg N _
  have hIom : ‖Iom‖ ≤ As * Pom := by
    dsimp [Iom, Pom]
    rw [brrsTwoRadiusStationaryComponentIntegral_swap]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmo / qs) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle s +
              brrsSurfaceWavePhase .outgoing r + 2 * Real.pi * t) := by
        simpa only [qs] using hmo s r t hs hr
      _ = (1 - (1 / 32 : Real)) * (Cmo / qs) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .outgoing r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
        rw [hphaseom]
      _ ≤ As * brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .outgoing r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) :=
        mul_le_mul_of_nonneg_right (hAs_le Cmo hCmo_le) hPom
  have hIim : ‖Iim‖ ≤ As * Pim := by
    dsimp [Iim, Pim]
    rw [brrsTwoRadiusStationaryComponentIntegral_swap]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmi / qs) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle s +
              brrsSurfaceWavePhase .incoming r + 2 * Real.pi * t) := by
        simpa only [qs] using hmi s r t hs hr
      _ = (1 - (1 / 32 : Real)) * (Cmi / qs) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .incoming r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
        rw [hphaseim]
      _ ≤ As * brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .incoming r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) :=
        mul_le_mul_of_nonneg_right (hAs_le Cmi hCmi_le) hPim
  have hImo : ‖Imo‖ ≤ Ar * Pmo := by
    dsimp [Imo, Pmo]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmo / qr) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) := by
        simpa only [qr] using hmo r s t hr hs
      _ ≤ Ar * brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) :=
        mul_le_mul_of_nonneg_right (hAr_le Cmo hCmo_le) hPmo
  have hImi : ‖Imi‖ ≤ Ar * Pmi := by
    dsimp [Imi, Pmi]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmi / qr) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) := by
        simpa only [qr] using hmi r s t hr hs
      _ ≤ Ar * brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) :=
        mul_le_mul_of_nonneg_right (hAr_le Cmi hCmi_le) hPmi
  have hImm : ‖Imm‖ ≤ Ar * Pmm := by
    dsimp [Imm, Pmm]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmm / qr) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
        simpa only [qr] using hmm r s t hr hs
      _ ≤ Ar * brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) :=
        mul_le_mul_of_nonneg_right (hAr_le Cmm hCmm_le) hPmm
  change ‖(Iom + Iim) + (Imo + Imi + Imm)‖ ≤
    As * (Pom + Pim) + Ar * (Pmo + Pmi + Pmm)
  calc
    ‖(Iom + Iim) + (Imo + Imi + Imm)‖ ≤
        ‖Iom + Iim‖ + ‖Imo + Imi + Imm‖ := norm_add_le _ _
    _ ≤ (‖Iom‖ + ‖Iim‖) + ((‖Imo‖ + ‖Imi‖) + ‖Imm‖) := by
      apply add_le_add
      · exact norm_add_le _ _
      · calc
          ‖Imo + Imi + Imm‖ ≤ ‖Imo + Imi‖ + ‖Imm‖ := norm_add_le _ _
          _ ≤ (‖Imo‖ + ‖Imi‖) + ‖Imm‖ := by
            exact add_le_add (norm_add_le Imo Imi) le_rfl
    _ ≤ (As * Pom + As * Pim) +
          ((Ar * Pmo + Ar * Pmi) + Ar * Pmm) := by
      apply add_le_add
      · exact add_le_add hIom hIim
      · apply add_le_add
        · exact add_le_add hImo hImi
        · exact hImm
    _ = As * (Pom + Pim) + Ar * (Pmo + Pmi + Pmm) := by ring

/-- The exact nine-component kernel is its endpoint/end-point main term plus
the five named middle-wave components. -/
theorem brrsTwoRadiusAllStationaryComponentIntegralSum_eq_endpoint_add_middle
    (Phi : BRRSAnnularCutoff) (d : Nat) (r s t : Real) :
    brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t =
      brrsTwoRadiusEndpointIntegralSum Phi d r s t +
        brrsTwoRadiusMiddleComponentIntegralSum Phi d r s t := by
  unfold brrsTwoRadiusAllStationaryComponentIntegralSum
    brrsTwoRadiusEndpointIntegralSum brrsTwoRadiusMiddleComponentIntegralSum
  ring

/-! ### Exact dyadic transport of the two-radius stationary model

The level-zero two-radius stationary expansion is the object for which the
surface-wave factors and all nine phases have been constructed literally.
For the dyadic radial-block argument it is useful to retain its exact
parabolic dilation as a separately named object.  The definitions in this
section are introduced first as *scaled stationary models*.  Their equality
with the actual dyadic half-wave is proved below, after the required outer
radial change-of-variables lemma has been established.
-/

/-- The exact `2^j` transport of one level-zero two-radius stationary
component.  It is a scaled model, not an unproved alternate definition of the
dyadic half-wave kernel. -/
noncomputable def brrsDyadicTwoRadiusStationaryComponentIntegral
    (Phi : BRRSAnnularCutoff) (d j : Nat)
    (partR partS : BRRSSurfaceWavePart) (r s t : Real) : Complex :=
  (((2 : Real) ^ j) ^ d) •
    brrsTwoRadiusStationaryComponentIntegral Phi d partR partS
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)

/-- The exact `2^j` transport of the four endpoint--endpoint stationary
components. -/
noncomputable def brrsDyadicTwoRadiusEndpointIntegralSum
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t : Real) : Complex :=
  (((2 : Real) ^ j) ^ d) •
    brrsTwoRadiusEndpointIntegralSum Phi d
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)

/-- The exact `2^j` transport of the five stationary components involving a
middle wave. -/
noncomputable def brrsDyadicTwoRadiusMiddleComponentIntegralSum
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t : Real) : Complex :=
  (((2 : Real) ^ j) ^ d) •
    brrsTwoRadiusMiddleComponentIntegralSum Phi d
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)

/-- The exact `2^j` transport of the literal all-nine level-zero stationary
sum. -/
noncomputable def brrsDyadicTwoRadiusAllStationaryComponentIntegralSum
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t : Real) : Complex :=
  (((2 : Real) ^ j) ^ d) •
    brrsTwoRadiusAllStationaryComponentIntegralSum Phi d
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)

/-- Unfolding the dyadic stationary component leaves exactly the expected
spatial and temporal dilation. -/
theorem brrsDyadicTwoRadiusStationaryComponentIntegral_eq_levelZero_scaled
    (Phi : BRRSAnnularCutoff) (d j : Nat)
    (partR partS : BRRSSurfaceWavePart) (r s t : Real) :
    brrsDyadicTwoRadiusStationaryComponentIntegral Phi d j partR partS r s t =
      (((2 : Real) ^ j) ^ d) •
        brrsTwoRadiusStationaryComponentIntegral Phi d partR partS
          (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t) := rfl

/-- Unfolding the dyadic endpoint sum leaves exactly the corresponding
level-zero endpoint sum at the dilated variables. -/
theorem brrsDyadicTwoRadiusEndpointIntegralSum_eq_levelZero_scaled
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t : Real) :
    brrsDyadicTwoRadiusEndpointIntegralSum Phi d j r s t =
      (((2 : Real) ^ j) ^ d) • brrsTwoRadiusEndpointIntegralSum Phi d
        (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t) := rfl

/-- Unfolding the dyadic middle sum leaves exactly the corresponding
level-zero middle sum at the dilated variables. -/
theorem brrsDyadicTwoRadiusMiddleComponentIntegralSum_eq_levelZero_scaled
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t : Real) :
    brrsDyadicTwoRadiusMiddleComponentIntegralSum Phi d j r s t =
      (((2 : Real) ^ j) ^ d) • brrsTwoRadiusMiddleComponentIntegralSum Phi d
        (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t) := rfl

/-- Unfolding the dyadic all-nine sum leaves exactly the corresponding
level-zero all-nine sum at the dilated variables. -/
theorem brrsDyadicTwoRadiusAllStationaryComponentIntegralSum_eq_levelZero_scaled
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t : Real) :
    brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s t =
      (((2 : Real) ^ j) ^ d) •
        brrsTwoRadiusAllStationaryComponentIntegralSum Phi d
          (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t) := rfl

/-- The rescaled stationary component remains symmetric in its two radial
variables. -/
theorem brrsDyadicTwoRadiusStationaryComponentIntegral_swap
    (Phi : BRRSAnnularCutoff) (d j : Nat)
    (partR partS : BRRSSurfaceWavePart) (r s t : Real) :
    brrsDyadicTwoRadiusStationaryComponentIntegral Phi d j partR partS r s t =
      brrsDyadicTwoRadiusStationaryComponentIntegral Phi d j partS partR s r t := by
  unfold brrsDyadicTwoRadiusStationaryComponentIntegral
  rw [brrsTwoRadiusStationaryComponentIntegral_swap]

/-- The dyadic endpoint model is the sum of its four rescaled endpoint
components. -/
theorem brrsDyadicTwoRadiusEndpointIntegralSum_eq_four_component_sum
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t : Real) :
    brrsDyadicTwoRadiusEndpointIntegralSum Phi d j r s t =
      brrsDyadicTwoRadiusStationaryComponentIntegral Phi d j .outgoing .outgoing r s t +
        brrsDyadicTwoRadiusStationaryComponentIntegral Phi d j .outgoing .incoming r s t +
          brrsDyadicTwoRadiusStationaryComponentIntegral Phi d j .incoming .outgoing r s t +
            brrsDyadicTwoRadiusStationaryComponentIntegral Phi d j .incoming .incoming r s t := by
  unfold brrsDyadicTwoRadiusEndpointIntegralSum
    brrsDyadicTwoRadiusStationaryComponentIntegral
    brrsTwoRadiusEndpointIntegralSum
  simp only [smul_add]

/-- The dyadic all-nine stationary model has the same exact main/remainder
split as its level-zero source. -/
theorem brrsDyadicTwoRadiusAllStationaryComponentIntegralSum_eq_endpoint_add_middle
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t : Real) :
    brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s t =
      brrsDyadicTwoRadiusEndpointIntegralSum Phi d j r s t +
        brrsDyadicTwoRadiusMiddleComponentIntegralSum Phi d j r s t := by
  unfold brrsDyadicTwoRadiusAllStationaryComponentIntegralSum
    brrsDyadicTwoRadiusEndpointIntegralSum
    brrsDyadicTwoRadiusMiddleComponentIntegralSum
  rw [brrsTwoRadiusAllStationaryComponentIntegralSum_eq_endpoint_add_middle,
    smul_add]

/-- Norm transport for one rescaled stationary component. -/
theorem norm_brrsDyadicTwoRadiusStationaryComponentIntegral_eq_levelZero_scaled
    (Phi : BRRSAnnularCutoff) (d j : Nat)
    (partR partS : BRRSSurfaceWavePart) (r s t : Real) :
    ‖brrsDyadicTwoRadiusStationaryComponentIntegral Phi d j partR partS r s t‖ =
      ‖((2 : Real) ^ j) ^ d‖ *
        ‖brrsTwoRadiusStationaryComponentIntegral Phi d partR partS
          (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)‖ := by
  unfold brrsDyadicTwoRadiusStationaryComponentIntegral
  exact norm_smul _ _

/-- Norm transport for the rescaled endpoint model. -/
theorem norm_brrsDyadicTwoRadiusEndpointIntegralSum_eq_levelZero_scaled
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t : Real) :
    ‖brrsDyadicTwoRadiusEndpointIntegralSum Phi d j r s t‖ =
      ‖((2 : Real) ^ j) ^ d‖ *
        ‖brrsTwoRadiusEndpointIntegralSum Phi d
          (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)‖ := by
  unfold brrsDyadicTwoRadiusEndpointIntegralSum
  exact norm_smul _ _

/-- Norm transport for the rescaled middle-wave model. -/
theorem norm_brrsDyadicTwoRadiusMiddleComponentIntegralSum_eq_levelZero_scaled
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t : Real) :
    ‖brrsDyadicTwoRadiusMiddleComponentIntegralSum Phi d j r s t‖ =
      ‖((2 : Real) ^ j) ^ d‖ *
        ‖brrsTwoRadiusMiddleComponentIntegralSum Phi d
          (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)‖ := by
  unfold brrsDyadicTwoRadiusMiddleComponentIntegralSum
  exact norm_smul _ _

/-- Norm transport for the rescaled all-nine stationary model. -/
theorem norm_brrsDyadicTwoRadiusAllStationaryComponentIntegralSum_eq_levelZero_scaled
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t : Real) :
    ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s t‖ =
      ‖((2 : Real) ^ j) ^ d‖ *
        ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d
          (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)‖ := by
  unfold brrsDyadicTwoRadiusAllStationaryComponentIntegralSum
  exact norm_smul _ _

/-- Any pointwise endpoint bound at the dilated level-zero variables
transports through the dyadic stationary model with precisely its scalar
Jacobian factor. -/
theorem norm_brrsDyadicTwoRadiusEndpointIntegralSum_le_scaled_of_levelZero
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t B : Real)
    (hB : ‖brrsTwoRadiusEndpointIntegralSum Phi d
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)‖ ≤ B) :
    ‖brrsDyadicTwoRadiusEndpointIntegralSum Phi d j r s t‖ ≤
      ‖((2 : Real) ^ j) ^ d‖ * B := by
  rw [norm_brrsDyadicTwoRadiusEndpointIntegralSum_eq_levelZero_scaled]
  exact mul_le_mul_of_nonneg_left hB (norm_nonneg _)

/-- Any pointwise middle-wave bound at the dilated level-zero variables
transports through the dyadic stationary model with precisely its scalar
Jacobian factor. -/
theorem norm_brrsDyadicTwoRadiusMiddleComponentIntegralSum_le_scaled_of_levelZero
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t B : Real)
    (hB : ‖brrsTwoRadiusMiddleComponentIntegralSum Phi d
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)‖ ≤ B) :
    ‖brrsDyadicTwoRadiusMiddleComponentIntegralSum Phi d j r s t‖ ≤
      ‖((2 : Real) ^ j) ^ d‖ * B := by
  rw [norm_brrsDyadicTwoRadiusMiddleComponentIntegralSum_eq_levelZero_scaled]
  exact mul_le_mul_of_nonneg_left hB (norm_nonneg _)

/-- The same exact scalar transport is available for the all-nine stationary
model. -/
theorem norm_brrsDyadicTwoRadiusAllStationaryComponentIntegralSum_le_scaled_of_levelZero
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t B : Real)
    (hB : ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)‖ ≤ B) :
    ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s t‖ ≤
      ‖((2 : Real) ^ j) ^ d‖ * B := by
  rw [norm_brrsDyadicTwoRadiusAllStationaryComponentIntegralSum_eq_levelZero_scaled]
  exact mul_le_mul_of_nonneg_left hB (norm_nonneg _)

/-- At two high radial positions, the full exact three-by-three stationary
sum is controlled by the nine corresponding rapidly decaying phase profiles.
In particular, no middle-wave remainder is discarded. -/
theorem exists_norm_brrsTwoRadAllStatComponentIntegralSum_highRad_ninePhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (d - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1))) *
          ((brrsStationaryRapidProfile N
              (brrsSurfaceWavePhase .outgoing r +
                brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) +
            brrsStationaryRapidProfile N
              (brrsSurfaceWavePhase .outgoing r +
                brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) +
              brrsStationaryRapidProfile N
                (brrsSurfaceWavePhase .outgoing r +
                  brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)) +
            ((brrsStationaryRapidProfile N
                (brrsSurfaceWavePhase .incoming r +
                  brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) +
              brrsStationaryRapidProfile N
                (brrsSurfaceWavePhase .incoming r +
                  brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) +
                brrsStationaryRapidProfile N
                  (brrsSurfaceWavePhase .incoming r +
                    brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)) +
              (brrsStationaryRapidProfile N
                  (brrsSurfaceWavePhase .middle r +
                    brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) +
                brrsStationaryRapidProfile N
                  (brrsSurfaceWavePhase .middle r +
                    brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) +
                  brrsStationaryRapidProfile N
                    (brrsSurfaceWavePhase .middle r +
                      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)))) := by
  obtain ⟨Coo, hCoo_pos, hoo⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadStatCoefficient_highRad_profile_le
      (d := d) (N := N) hd Phi .outgoing .outgoing
  obtain ⟨Coi, hCoi_pos, hoi⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadStatCoefficient_highRad_profile_le
      (d := d) (N := N) hd Phi .outgoing .incoming
  obtain ⟨Com, hCom_pos, hom⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadStatCoefficient_highRad_profile_le
      (d := d) (N := N) hd Phi .outgoing .middle
  obtain ⟨Cio, hCio_pos, hio⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadStatCoefficient_highRad_profile_le
      (d := d) (N := N) hd Phi .incoming .outgoing
  obtain ⟨Cii, hCii_pos, hii⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadStatCoefficient_highRad_profile_le
      (d := d) (N := N) hd Phi .incoming .incoming
  obtain ⟨Cim, hCim_pos, him⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadStatCoefficient_highRad_profile_le
      (d := d) (N := N) hd Phi .incoming .middle
  obtain ⟨Cmo, hCmo_pos, hmo⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadStatCoefficient_highRad_profile_le
      (d := d) (N := N) hd Phi .middle .outgoing
  obtain ⟨Cmi, hCmi_pos, hmi⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadStatCoefficient_highRad_profile_le
      (d := d) (N := N) hd Phi .middle .incoming
  obtain ⟨Cmm, hCmm_pos, hmm⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadStatCoefficient_highRad_profile_le
      (d := d) (N := N) hd Phi .middle .middle
  let C : Real :=
    (Coo + Coi + Com) + ((Cio + Cii + Cim) + (Cmo + Cmi + Cmm))
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  let q : Real := (Real.sqrt (r / 16)) ^ (d - 1) *
    (Real.sqrt (s / 16)) ^ (d - 1)
  let A : Real := (1 - (1 / 32 : Real)) * (C / q)
  have hq : 0 < q := by
    dsimp [q]
    apply mul_pos <;> apply pow_pos <;> apply Real.sqrt_pos.2 <;> linarith
  have hCoo_le : Coo ≤ C := by
    dsimp [C]
    linarith
  have hCoi_le : Coi ≤ C := by
    dsimp [C]
    linarith
  have hCom_le : Com ≤ C := by
    dsimp [C]
    linarith
  have hCio_le : Cio ≤ C := by
    dsimp [C]
    linarith
  have hCii_le : Cii ≤ C := by
    dsimp [C]
    linarith
  have hCim_le : Cim ≤ C := by
    dsimp [C]
    linarith
  have hCmo_le : Cmo ≤ C := by
    dsimp [C]
    linarith
  have hCmi_le : Cmi ≤ C := by
    dsimp [C]
    linarith
  have hCmm_le : Cmm ≤ C := by
    dsimp [C]
    linarith
  have hA_le (D : Real) (hD : D ≤ C) :
      (1 - (1 / 32 : Real)) * (D / q) ≤ A := by
    dsimp [A]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hD hq.le
    · norm_num
  let Poo : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .outgoing r +
      brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t)
  let Poi : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .outgoing r +
      brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)
  let Pom : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .outgoing r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  let Pio : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .incoming r +
      brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t)
  let Pii : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .incoming r +
      brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)
  let Pim : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .incoming r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  let Pmo : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t)
  let Pmi : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)
  let Pmm : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  let Ioo : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .outgoing r s t
  let Ioi : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .incoming r s t
  let Iom : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .middle r s t
  let Iio : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .outgoing r s t
  let Iii : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .incoming r s t
  let Iim : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .middle r s t
  let Imo : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .middle .outgoing r s t
  let Imi : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .middle .incoming r s t
  let Imm : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .middle .middle r s t
  have hIoo : ‖Ioo‖ ≤ A * Poo := by
    dsimp [Ioo]
    rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Coo / q) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .outgoing r +
              brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) := by
        simpa only [q] using hoo r s
          (brrsSurfaceWavePhase .outgoing r +
            brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) hr hs
      _ ≤ A * Poo := by
        dsimp [Poo]
        exact mul_le_mul_of_nonneg_right (hA_le Coo hCoo_le)
          (brrsStationaryRapidProfile_nonneg N _)
  have hIoi : ‖Ioi‖ ≤ A * Poi := by
    dsimp [Ioi]
    rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Coi / q) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .outgoing r +
              brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) := by
        simpa only [q] using hoi r s
          (brrsSurfaceWavePhase .outgoing r +
            brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) hr hs
      _ ≤ A * Poi := by
        dsimp [Poi]
        exact mul_le_mul_of_nonneg_right (hA_le Coi hCoi_le)
          (brrsStationaryRapidProfile_nonneg N _)
  have hIom : ‖Iom‖ ≤ A * Pom := by
    dsimp [Iom]
    rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Com / q) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .outgoing r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
        simpa only [q] using hom r s
          (brrsSurfaceWavePhase .outgoing r +
            brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) hr hs
      _ ≤ A * Pom := by
        dsimp [Pom]
        exact mul_le_mul_of_nonneg_right (hA_le Com hCom_le)
          (brrsStationaryRapidProfile_nonneg N _)
  have hIio : ‖Iio‖ ≤ A * Pio := by
    dsimp [Iio]
    rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cio / q) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .incoming r +
              brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) := by
        simpa only [q] using hio r s
          (brrsSurfaceWavePhase .incoming r +
            brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) hr hs
      _ ≤ A * Pio := by
        dsimp [Pio]
        exact mul_le_mul_of_nonneg_right (hA_le Cio hCio_le)
          (brrsStationaryRapidProfile_nonneg N _)
  have hIii : ‖Iii‖ ≤ A * Pii := by
    dsimp [Iii]
    rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cii / q) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .incoming r +
              brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) := by
        simpa only [q] using hii r s
          (brrsSurfaceWavePhase .incoming r +
            brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) hr hs
      _ ≤ A * Pii := by
        dsimp [Pii]
        exact mul_le_mul_of_nonneg_right (hA_le Cii hCii_le)
          (brrsStationaryRapidProfile_nonneg N _)
  have hIim : ‖Iim‖ ≤ A * Pim := by
    dsimp [Iim]
    rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cim / q) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .incoming r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
        simpa only [q] using him r s
          (brrsSurfaceWavePhase .incoming r +
            brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) hr hs
      _ ≤ A * Pim := by
        dsimp [Pim]
        exact mul_le_mul_of_nonneg_right (hA_le Cim hCim_le)
          (brrsStationaryRapidProfile_nonneg N _)
  have hImo : ‖Imo‖ ≤ A * Pmo := by
    dsimp [Imo]
    rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmo / q) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) := by
        simpa only [q] using hmo r s
          (brrsSurfaceWavePhase .middle r +
            brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) hr hs
      _ ≤ A * Pmo := by
        dsimp [Pmo]
        exact mul_le_mul_of_nonneg_right (hA_le Cmo hCmo_le)
          (brrsStationaryRapidProfile_nonneg N _)
  have hImi : ‖Imi‖ ≤ A * Pmi := by
    dsimp [Imi]
    rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmi / q) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) := by
        simpa only [q] using hmi r s
          (brrsSurfaceWavePhase .middle r +
            brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) hr hs
      _ ≤ A * Pmi := by
        dsimp [Pmi]
        exact mul_le_mul_of_nonneg_right (hA_le Cmi hCmi_le)
          (brrsStationaryRapidProfile_nonneg N _)
  have hImm : ‖Imm‖ ≤ A * Pmm := by
    dsimp [Imm]
    rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmm / q) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
        simpa only [q] using hmm r s
          (brrsSurfaceWavePhase .middle r +
            brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) hr hs
      _ ≤ A * Pmm := by
        dsimp [Pmm]
        exact mul_le_mul_of_nonneg_right (hA_le Cmm hCmm_le)
          (brrsStationaryRapidProfile_nonneg N _)
  change ‖((Ioo + Ioi) + Iom) +
      (((Iio + Iii) + Iim) + ((Imo + Imi) + Imm))‖ ≤
    A * ((Poo + Poi + Pom) + ((Pio + Pii + Pim) + (Pmo + Pmi + Pmm)))
  calc
    ‖((Ioo + Ioi) + Iom) +
        (((Iio + Iii) + Iim) + ((Imo + Imi) + Imm))‖ ≤
        ‖(Ioo + Ioi) + Iom‖ +
          ‖((Iio + Iii) + Iim) + ((Imo + Imi) + Imm)‖ := norm_add_le _ _
    _ ≤ (‖Ioo + Ioi‖ + ‖Iom‖) +
          ‖((Iio + Iii) + Iim) + ((Imo + Imi) + Imm)‖ := by
      exact add_le_add_left (norm_add_le _ _) _
    _ ≤ (‖Ioo + Ioi‖ + ‖Iom‖) +
          (‖(Iio + Iii) + Iim‖ + ‖(Imo + Imi) + Imm‖) := by
      exact add_le_add_right (norm_add_le _ _) _
    _ ≤ (‖Ioo + Ioi‖ + ‖Iom‖) +
          ((‖Iio + Iii‖ + ‖Iim‖) + (‖Imo + Imi‖ + ‖Imm‖)) := by
      apply add_le_add_right
      exact add_le_add (norm_add_le _ _) (norm_add_le _ _)
    _ ≤ ((‖Ioo‖ + ‖Ioi‖) + ‖Iom‖) +
          (((‖Iio‖ + ‖Iii‖) + ‖Iim‖) +
            ((‖Imo‖ + ‖Imi‖) + ‖Imm‖)) := by
      apply add_le_add
      · exact add_le_add_left (norm_add_le _ _) _
      · apply add_le_add
        · exact add_le_add_left (norm_add_le _ _) _
        · exact add_le_add_left (norm_add_le _ _) _
    _ ≤ ((A * Poo + A * Poi) + A * Pom) +
          (((A * Pio + A * Pii) + A * Pim) +
            ((A * Pmo + A * Pmi) + A * Pmm)) := by
      apply add_le_add
      · apply add_le_add
        · exact add_le_add hIoo hIoi
        · exact hIom
      · apply add_le_add
        · apply add_le_add
          · exact add_le_add hIio hIii
          · exact hIim
        · apply add_le_add
          · exact add_le_add hImo hImi
          · exact hImm
    _ = A * ((Poo + Poi + Pom) +
          ((Pio + Pii + Pim) + (Pmo + Pmi + Pmm))) := by ring

end

end Auto.Spherical.BRRS

/-! ### High--high two-radius four-phase profile -/

/- At two high radial positions, the endpoint/end-point contribution is
controlled by the four translated stationary profiles.  The common radial
factor is exactly the product of the two stationary-phase denominators. -/
namespace Auto.Spherical.BRRS

open Set Filter MeasureTheory FourierTransform
open Auto.LittlewoodPaley
open Auto.Spherical.SurfaceMeasureDecay
open Auto.Spherical.OscillatoryIntegralAux Auto.Spherical.AHRS
open scoped BigOperators Convolution ENNReal FourierTransform Topology

noncomputable section

/-- The literal five-term middle remainder is symmetric in the two radial
variables.  This exact identity lets the ordered phase-transfer estimate be
used without sacrificing the source/output radial normalization. -/
theorem brrsTwoRadiusMiddleComponentIntegralSum_swap
    (Phi : BRRSAnnularCutoff) (d : Nat) (r s t : Real) :
    brrsTwoRadiusMiddleComponentIntegralSum Phi d r s t =
      brrsTwoRadiusMiddleComponentIntegralSum Phi d s r t := by
  unfold brrsTwoRadiusMiddleComponentIntegralSum
  rw [brrsTwoRadiusStationaryComponentIntegral_swap Phi d .outgoing .middle r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .incoming .middle r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .middle .outgoing r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .middle .incoming r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .middle .middle r s t]
  ring

theorem exists_norm_brrsTwoRadiusEndpointIntegralSum_highRadius_fourPhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsTwoRadiusEndpointIntegralSum Phi d r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (d - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
  obtain ⟨Coo, hCoo_pos, hoo⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadStatCoefficient_highRad_profile_le
      (d := d) (N := N) hd Phi .outgoing .outgoing
  obtain ⟨Coi, hCoi_pos, hoi⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadStatCoefficient_highRad_profile_le
      (d := d) (N := N) hd Phi .outgoing .incoming
  obtain ⟨Cio, hCio_pos, hio⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadStatCoefficient_highRad_profile_le
      (d := d) (N := N) hd Phi .incoming .outgoing
  obtain ⟨Cii, hCii_pos, hii⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadStatCoefficient_highRad_profile_le
      (d := d) (N := N) hd Phi .incoming .incoming
  let C : Real := Coo + Coi + Cio + Cii
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  let q : Real := (Real.sqrt (r / 16)) ^ (d - 1) *
    (Real.sqrt (s / 16)) ^ (d - 1)
  let A : Real := (1 - (1 / 32 : Real)) * (C / q)
  let Poo : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s))
  let Poi : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s))
  let Pio : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s))
  let Pii : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))
  let Ioo : Complex := ∫ rho in (1 / 32 : Real)..1,
    brrsTwoRadiusStationaryCoefficient Phi d .outgoing .outgoing r s rho *
      oscillatoryExp (2 * Real.pi * (t - r - s)) rho
  let Ioi : Complex := ∫ rho in (1 / 32 : Real)..1,
    brrsTwoRadiusStationaryCoefficient Phi d .outgoing .incoming r s rho *
      oscillatoryExp (2 * Real.pi * (t - r + s)) rho
  let Iio : Complex := ∫ rho in (1 / 32 : Real)..1,
    brrsTwoRadiusStationaryCoefficient Phi d .incoming .outgoing r s rho *
      oscillatoryExp (2 * Real.pi * (t + r - s)) rho
  let Iii : Complex := ∫ rho in (1 / 32 : Real)..1,
    brrsTwoRadiusStationaryCoefficient Phi d .incoming .incoming r s rho *
      oscillatoryExp (2 * Real.pi * (t + r + s)) rho
  have hq : 0 < q := by
    dsimp [q]
    apply mul_pos <;> apply pow_pos <;> apply Real.sqrt_pos.2 <;> linarith
  have hCoo_le : Coo ≤ C := by
    dsimp [C]
    linarith
  have hCoi_le : Coi ≤ C := by
    dsimp [C]
    linarith
  have hCio_le : Cio ≤ C := by
    dsimp [C]
    linarith
  have hCii_le : Cii ≤ C := by
    dsimp [C]
    linarith
  have hAoo : (1 - (1 / 32 : Real)) * (Coo / q) ≤ A := by
    dsimp [A]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hCoo_le hq.le
    · norm_num
  have hAoi : (1 - (1 / 32 : Real)) * (Coi / q) ≤ A := by
    dsimp [A]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hCoi_le hq.le
    · norm_num
  have hAio : (1 - (1 / 32 : Real)) * (Cio / q) ≤ A := by
    dsimp [A]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hCio_le hq.le
    · norm_num
  have hAii : (1 - (1 / 32 : Real)) * (Cii / q) ≤ A := by
    dsimp [A]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hCii_le hq.le
    · norm_num
  have hPoo : 0 ≤ Poo := by
    dsimp [Poo]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPoi : 0 ≤ Poi := by
    dsimp [Poi]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPio : 0 ≤ Pio := by
    dsimp [Pio]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPii : 0 ≤ Pii := by
    dsimp [Pii]
    exact brrsStationaryRapidProfile_nonneg N _
  have hIoo : ‖Ioo‖ ≤ A * Poo := by
    dsimp [Ioo, Poo]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Coo / q) *
          brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) := by
        simpa only [q] using hoo r s (2 * Real.pi * (t - r - s)) hr hs
      _ ≤ A * brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) :=
        mul_le_mul_of_nonneg_right hAoo hPoo
  have hIoi : ‖Ioi‖ ≤ A * Poi := by
    dsimp [Ioi, Poi]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Coi / q) *
          brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) := by
        simpa only [q] using hoi r s (2 * Real.pi * (t - r + s)) hr hs
      _ ≤ A * brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) :=
        mul_le_mul_of_nonneg_right hAoi hPoi
  have hIio : ‖Iio‖ ≤ A * Pio := by
    dsimp [Iio, Pio]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cio / q) *
          brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) := by
        simpa only [q] using hio r s (2 * Real.pi * (t + r - s)) hr hs
      _ ≤ A * brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) :=
        mul_le_mul_of_nonneg_right hAio hPio
  have hIii : ‖Iii‖ ≤ A * Pii := by
    dsimp [Iii, Pii]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cii / q) *
          brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s)) := by
        simpa only [q] using hii r s (2 * Real.pi * (t + r + s)) hr hs
      _ ≤ A * brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s)) :=
        mul_le_mul_of_nonneg_right hAii hPii
  have hsum :
      brrsTwoRadiusEndpointIntegralSum Phi d r s t = Ioo + Ioi + Iio + Iii := by
    dsimp [Ioo, Ioi, Iio, Iii]
    exact brrsTwoRadiusEndpointIntegralSum_eq_four_phase_integrals Phi d r s t
  rw [hsum]
  calc
    ‖Ioo + Ioi + Iio + Iii‖ ≤ ‖Ioo‖ + ‖Ioi‖ + ‖Iio‖ + ‖Iii‖ := by
      calc
        ‖Ioo + Ioi + Iio + Iii‖ ≤ ‖Ioo + Ioi + Iio‖ + ‖Iii‖ := norm_add_le _ _
        _ ≤ (‖Ioo + Ioi‖ + ‖Iio‖) + ‖Iii‖ := by
          gcongr
          exact norm_add_le _ _
        _ ≤ (‖Ioo‖ + ‖Ioi‖ + ‖Iio‖) + ‖Iii‖ := by
          gcongr
          exact norm_add_le _ _
        _ = ‖Ioo‖ + ‖Ioi‖ + ‖Iio‖ + ‖Iii‖ := by ring
    _ ≤ A * Poo + A * Poi + A * Pio + A * Pii := by gcongr
    _ = A * (Poo + Poi + Pio + Pii) := by ring
    _ = (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (d - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
      rfl

/-- In the ordered high--high region, all five literal middle-wave
components obey the same four-sign profile bound as the endpoint kernel.
The displayed half-density is deliberately kept visible: after polar source
normalization it is exactly the factor `(s / r)^((d - 1) / 2)` in BRRS
(5.4). -/
theorem exists_norm_brrsTwoRadMiddleCompIntegralSum_highRad_fourPhase_profile_le_of_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s → s ≤ r →
      ‖brrsTwoRadiusMiddleComponentIntegralSum Phi d r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (d - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
  let M : Nat := d + 2 * N
  have hM : 2 ≤ M := by
    dsimp [M]
    omega
  obtain ⟨C₀, hC₀, hfive⟩ :=
    exists_norm_brrsTwoRadMiddleCompIntegralSum_highRad_fivePhase_rapidProfile_le
      (d := d) (N := 2 * N) (M := M) hd hM Phi
  let L : Real := (32 : Real) ^ N *
    ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N)
  let C : Real := 5 * L * C₀
  have hL : 0 < L := by
    dsimp [L]
    positivity
  have hC : 0 < C := by
    dsimp [C]
    positivity
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs hsr
  let R : Real := Real.sqrt (r / 16)
  let S : Real := Real.sqrt (s / 16)
  let B : Real := R ^ (d - 1) * S ^ (d - 1)
  let Dₛ : Real := 1 / S ^ (2 * N)
  let Dᵣ : Real := 1 / R ^ (2 * N)
  let δ : Real := 1 - (1 / 32 : Real)
  let P₁ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s))
  let P₂ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s))
  let P₃ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s))
  let P₄ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))
  let Q₁ : Real := brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - r))
  let Q₂ : Real := brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + r))
  let Q₃ : Real := brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - s))
  let Q₄ : Real := brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + s))
  let Q₅ : Real := brrsStationaryRapidProfile (2 * N) (2 * Real.pi * t)
  have hMsub : M - 1 = (d - 1) + 2 * N := by
    dsimp [M]
    omega
  have hfive' :
      ‖brrsTwoRadiusMiddleComponentIntegralSum Phi d r s t‖ ≤
        δ * (C₀ / (S ^ (M - 1) * R ^ (d - 1))) * (Q₁ + Q₂) +
          δ * (C₀ / (R ^ (M - 1) * S ^ (d - 1))) * (Q₃ + Q₄ + Q₅) := by
    convert hfive r s t hr hs using 1;
      simp only [R, S, δ, Q₁, Q₂, Q₃, Q₄, Q₅,
        brrsSurfaceWavePhase]; ring
  have hfactorS :
      δ * (C₀ / (S ^ (M - 1) * R ^ (d - 1))) =
        (δ * (C₀ / B)) * Dₛ := by
    rw [hMsub]
    dsimp [B, Dₛ, R, S]
    calc
      δ * (C₀ /
          ((Real.sqrt (s / 16)) ^ ((d - 1) + 2 * N) *
            (Real.sqrt (r / 16)) ^ (d - 1))) =
          δ * (C₀ /
            ((Real.sqrt (r / 16)) ^ (d - 1) *
              (Real.sqrt (s / 16)) ^ ((d - 1) + 2 * N))) := by ring
      _ = δ * ((C₀ /
            ((Real.sqrt (r / 16)) ^ (d - 1) *
              (Real.sqrt (s / 16)) ^ (d - 1))) *
            (1 / (Real.sqrt (s / 16)) ^ (2 * N))) := by
          rw [brrs_twoRadius_middle_denominator_factor
            (r := r) (s := s) hr hs (d - 1) N C₀]
      _ = (δ * (C₀ /
            ((Real.sqrt (r / 16)) ^ (d - 1) *
              (Real.sqrt (s / 16)) ^ (d - 1))) *
            (1 / (Real.sqrt (s / 16)) ^ (2 * N))) := by ring
  have hfactorR :
      δ * (C₀ / (R ^ (M - 1) * S ^ (d - 1))) =
        (δ * (C₀ / B)) * Dᵣ := by
    rw [hMsub]
    dsimp [B, Dᵣ, R, S]
    calc
      δ * (C₀ /
          ((Real.sqrt (r / 16)) ^ ((d - 1) + 2 * N) *
            (Real.sqrt (s / 16)) ^ (d - 1))) =
          δ * (C₀ /
            ((Real.sqrt (s / 16)) ^ (d - 1) *
              (Real.sqrt (r / 16)) ^ ((d - 1) + 2 * N))) := by ring
      _ =
          δ * ((C₀ /
            ((Real.sqrt (s / 16)) ^ (d - 1) *
              (Real.sqrt (r / 16)) ^ (d - 1))) *
            (1 / (Real.sqrt (r / 16)) ^ (2 * N))) := by
        rw [brrs_twoRadius_middle_denominator_factor
          (r := s) (s := r) hs hr (d - 1) N C₀]
      _ = (δ * (C₀ /
            ((Real.sqrt (r / 16)) ^ (d - 1) *
              (Real.sqrt (s / 16)) ^ (d - 1))) *
            (1 / (Real.sqrt (r / 16)) ^ (2 * N))) := by ring
  have hphase :=
    brrs_highRadius_ordered_fiveMiddleProfiles_le_fourEndpointProfiles
      (r := r) (s := s) (t := t) hr hs hsr N
  have hphase' :
      Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄ + Q₅) ≤
        (5 * L) * (P₁ + P₂ + P₃ + P₄) := by
    simpa only [Dₛ, Dᵣ, Q₁, Q₂, Q₃, Q₄, Q₅, L, P₁, P₂, P₃, P₄] using hphase
  have hB : 0 < B := by
    dsimp [B, R, S]
    apply mul_pos <;> apply pow_pos <;> apply Real.sqrt_pos.2 <;> linarith
  have hδ : 0 ≤ δ := by
    dsimp [δ]
    norm_num
  have hA : 0 ≤ δ * (C₀ / B) := by
    positivity
  calc
    ‖brrsTwoRadiusMiddleComponentIntegralSum Phi d r s t‖ ≤
        δ * (C₀ / (S ^ (M - 1) * R ^ (d - 1))) * (Q₁ + Q₂) +
          δ * (C₀ / (R ^ (M - 1) * S ^ (d - 1))) * (Q₃ + Q₄ + Q₅) := hfive'
    _ = (δ * (C₀ / B)) * (Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄ + Q₅)) := by
      rw [hfactorS, hfactorR]
      ring
    _ ≤ (δ * (C₀ / B)) * ((5 * L) * (P₁ + P₂ + P₃ + P₄)) := by
      exact mul_le_mul_of_nonneg_left hphase' hA
    _ = (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (d - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
      dsimp [δ, C, B, R, S, P₁, P₂, P₃, P₄]
      ring

/-- The ordered middle-wave estimate is symmetric in the two radii, hence
gives a four-sign bound throughout the high--high region. -/
theorem exists_norm_brrsTwoRadiusMiddleComponentIntegralSum_highRadius_fourPhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsTwoRadiusMiddleComponentIntegralSum Phi d r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (d - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
  obtain ⟨C, hC, hordered⟩ :=
    exists_norm_brrsTwoRadMiddleCompIntegralSum_highRad_fourPhase_profile_le_of_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  by_cases hsr : s ≤ r
  · exact hordered r s t hr hs hsr
  · have hrs : r ≤ s := le_of_not_ge hsr
    rw [brrsTwoRadiusMiddleComponentIntegralSum_swap Phi d r s t]
    have hswapped := hordered s r t hs hr hrs
    have hswapped' :
        ‖brrsTwoRadiusMiddleComponentIntegralSum Phi d s r t‖ ≤
          (1 - (1 / 32 : Real)) *
            (C / ((Real.sqrt (s / 16)) ^ (d - 1) *
              (Real.sqrt (r / 16)) ^ (d - 1))) *
            (brrsStationaryRapidProfile N (2 * Real.pi * (t - s - r)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + s - r)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t - s + r)) +
                  brrsStationaryRapidProfile N (2 * Real.pi * (t + s + r))) := by
      calc
        ‖brrsTwoRadiusMiddleComponentIntegralSum Phi d s r t‖ ≤
            (1 - (1 / 32 : Real)) *
              (C / ((Real.sqrt (s / 16)) ^ (d - 1) *
                (Real.sqrt (r / 16)) ^ (d - 1))) *
              (brrsStationaryRapidProfile N (2 * Real.pi * (t - s - r)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t - s + r)) +
                  brrsStationaryRapidProfile N (2 * Real.pi * (t + s - r)) +
                    brrsStationaryRapidProfile N (2 * Real.pi * (t + s + r))) :=
          hswapped
        _ = (1 - (1 / 32 : Real)) *
              (C / ((Real.sqrt (s / 16)) ^ (d - 1) *
                (Real.sqrt (r / 16)) ^ (d - 1))) *
              (brrsStationaryRapidProfile N (2 * Real.pi * (t - s - r)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + s - r)) +
                  brrsStationaryRapidProfile N (2 * Real.pi * (t - s + r)) +
                    brrsStationaryRapidProfile N (2 * Real.pi * (t + s + r))) := by
          ring
    convert hswapped' using 1; ring

/-- The exact all-nine stationary two-radius kernel has the BRRS four-sign
majorant at two high radii in every dimension `d ≥ 3`.  This combines the
endpoint waves with the genuinely absorbed middle-wave remainder; it does
not replace the literal kernel by an abstract model. -/
theorem exists_norm_brrsTwoRadAllStatComponentIntegralSum_highRad_fourPhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (d - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
  obtain ⟨Cend, hCend, hend⟩ :=
    exists_norm_brrsTwoRadiusEndpointIntegralSum_highRadius_fourPhase_profile_le
      (d := d) (N := N) hd Phi
  obtain ⟨Cmid, hCmid, hmid⟩ :=
    exists_norm_brrsTwoRadiusMiddleComponentIntegralSum_highRadius_fourPhase_profile_le
      (d := d) (N := N) hd Phi
  let C : Real := Cend + Cmid
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  let B : Real := (Real.sqrt (r / 16)) ^ (d - 1) *
    (Real.sqrt (s / 16)) ^ (d - 1)
  let P : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
    brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
      brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
        brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))
  have hsum :
      brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t =
        brrsTwoRadiusEndpointIntegralSum Phi d r s t +
          brrsTwoRadiusMiddleComponentIntegralSum Phi d r s t :=
    brrsTwoRadiusAllStationaryComponentIntegralSum_eq_endpoint_add_middle
      Phi d r s t
  rw [hsum]
  calc
    ‖brrsTwoRadiusEndpointIntegralSum Phi d r s t +
        brrsTwoRadiusMiddleComponentIntegralSum Phi d r s t‖ ≤
        ‖brrsTwoRadiusEndpointIntegralSum Phi d r s t‖ +
          ‖brrsTwoRadiusMiddleComponentIntegralSum Phi d r s t‖ := norm_add_le _ _
    _ ≤ (1 - (1 / 32 : Real)) * (Cend / B) * P +
          (1 - (1 / 32 : Real)) * (Cmid / B) * P := by
      dsimp [B, P]
      exact add_le_add (hend r s t hr hs) (hmid r s t hr hs)
    _ = (1 - (1 / 32 : Real)) * (C / B) * P := by
      dsimp [C]
      ring
    _ = (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (d - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
      rfl

end

end Auto.Spherical.BRRS

/-! ### Dyadic high--high two-radius profile transport -/

namespace Auto.Spherical.BRRS

open Set Filter MeasureTheory FourierTransform
open Auto.LittlewoodPaley
open Auto.Spherical.SurfaceMeasureDecay
open Auto.Spherical.OscillatoryIntegralAux Auto.Spherical.AHRS
open scoped BigOperators Convolution ENNReal FourierTransform Topology

noncomputable section

/-- Every literal stationary carrier scales linearly under the common dyadic
dilation of the two radii and time.  This algebraic identity applies equally
to the endpoint and middle surface-wave parts. -/
theorem brrsDyadicTwoRadius_stationary_phase_eq_scale
    (j : Nat) (partR partS : BRRSSurfaceWavePart) (r s t : Real) :
    brrsSurfaceWavePhase partR (((2 : Real) ^ j) * r) +
        brrsSurfaceWavePhase partS (((2 : Real) ^ j) * s) +
          2 * Real.pi * (((2 : Real) ^ j) * t) =
      ((2 : Real) ^ j) *
        (brrsSurfaceWavePhase partR r + brrsSurfaceWavePhase partS s +
          2 * Real.pi * t) := by
  cases partR <;> cases partS <;> simp [brrsSurfaceWavePhase] <;> ring

/-- The level-zero endpoint four-phase estimate transports exactly to the
dyadic two-radius stationary model.  The high-radius hypotheses and every
profile retain their literal scaled variables, which is the form needed
before the radial change of variables in the block argument. -/
theorem exists_norm_brrsDyadicTwoRadiusEndpointIntegralSum_highRadius_fourPhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r s t : Real,
      16 ≤ ((2 : Real) ^ j) * r → 16 ≤ ((2 : Real) ^ j) * s →
      ‖brrsDyadicTwoRadiusEndpointIntegralSum Phi d j r s t‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) *
            (C / ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
              (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1))) *
            (brrsStationaryRapidProfile N
                (2 * Real.pi * (((2 : Real) ^ j * t) -
                  ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
              brrsStationaryRapidProfile N
                (2 * Real.pi * (((2 : Real) ^ j * t) -
                  ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s))) +
                brrsStationaryRapidProfile N
                  (2 * Real.pi * (((2 : Real) ^ j * t) +
                    ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
                  brrsStationaryRapidProfile N
                    (2 * Real.pi * (((2 : Real) ^ j * t) +
                      ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s))))) := by
  obtain ⟨C, hC, hlevel⟩ :=
    exists_norm_brrsTwoRadiusEndpointIntegralSum_highRadius_fourPhase_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j r s t hr hs
  exact norm_brrsDyadicTwoRadiusEndpointIntegralSum_le_scaled_of_levelZero
    Phi d j r s t _
    (hlevel (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
      (((2 : Real) ^ j) * t) hr hs)

/-- Exact dyadic transport of the all-nine high--high four-sign bound.  The
left side is the literal scaled stationary kernel which occurs in the radial
formula for `brrsDyadicHalfWave`, not merely its endpoint submodel. -/
theorem exists_norm_brrsDyTwoRadAllStatCompIntegralSum_highRad_fourPhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r s t : Real,
      16 ≤ ((2 : Real) ^ j) * r → 16 ≤ ((2 : Real) ^ j) * s →
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s t‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) *
            (C / ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
              (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1))) *
            (brrsStationaryRapidProfile N
                (2 * Real.pi * (((2 : Real) ^ j * t) -
                  ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
              brrsStationaryRapidProfile N
                (2 * Real.pi * (((2 : Real) ^ j * t) -
                  ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s))) +
                brrsStationaryRapidProfile N
                  (2 * Real.pi * (((2 : Real) ^ j * t) +
                    ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
                  brrsStationaryRapidProfile N
                    (2 * Real.pi * (((2 : Real) ^ j * t) +
                      ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s))))) := by
  obtain ⟨C, hC, hlevel⟩ :=
    exists_norm_brrsTwoRadAllStatComponentIntegralSum_highRad_fourPhase_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j r s t hr hs
  exact norm_brrsDyadicTwoRadiusAllStationaryComponentIntegralSum_le_scaled_of_levelZero
    Phi d j r s t _
    (hlevel (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
      (((2 : Real) ^ j) * t) hr hs)

/-! ### High--high polar source normalization

The preceding dyadic kernel bound is written with the literal polar
half-densities.  The Section 5 convolution lemmas, on the other hand, take
an ordinary one-dimensional input.  The following identities make the
conversion exact: the polar input density becomes
`brrsRadialLpSourceProfile`, the remaining radius ratio is precisely the
Sobolev weight `(s / r)^s_p`, and the dyadic factor is absorbed into the
translated phase profile.
-/

/-- The real value of the scaled stationary profile is the literal dyadic
factor times the original stationary profile.  The profile itself is defined
above with its stationary-decay parameter first, so it can also be used by
the phase-line change-of-variables lemma. -/
theorem brrsDyadicStationaryPhaseProfile_toReal
    (N j : Nat) (u : Real) :
    (brrsDyadicStationaryPhaseProfile N j u).toReal =
      ((2 : Real) ^ j) * brrsStationaryRapidProfile N
        (2 * Real.pi * ((2 : Real) ^ j * u)) := by
  unfold brrsDyadicStationaryPhaseProfile
  rw [ENNReal.toReal_ofReal
    (mul_nonneg (by positivity) (brrsStationaryRapidProfile_nonneg N _))]

/-- On the positive radial half-line, taking a real value of the weighted
source profile simply recovers its displayed power of the source radius. -/
theorem brrsRadialLpSourceProfile_toReal
    {d : Nat} (p : Real) (f : BRRSSpace d → Complex) (w : BRRSSpace d)
    {s : Real} (hs : 0 ≤ s) :
    (brrsRadialLpSourceProfile p f w s).toReal =
      s ^ (((d : Real) - 1) / p) * ‖f (s • w)‖ := by
  unfold brrsRadialLpSourceProfile
  rw [ENNReal.toReal_mul, ← ENNReal.toReal_rpow,
    ENNReal.toReal_ofReal hs, ENNReal.toReal_ofReal (norm_nonneg _)]

/-- The Sobolev-weighted scalar source profile.  It is the input which makes
the high--high endpoint majorant a literal one-dimensional convolution: the
remaining Sobolev factor then depends only on the output radius. -/
noncomputable def brrsRadialSobolevSourceProfile {d : Nat} (p : Real)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) : Real → ENNReal :=
  fun s => (ENNReal.ofReal s) ^ sobolevExponent d p *
    brrsRadialLpSourceProfile p f w s

/-- The Sobolev-weighted scalar source profile is measurable whenever the
original radial datum is measurable. -/
theorem measurable_brrsRadialSobolevSourceProfile {d : Nat} (p : Real)
    (f : BRRSSpace d → Complex) (hf : Measurable f) (w : BRRSSpace d) :
    Measurable (brrsRadialSobolevSourceProfile p f w) := by
  unfold brrsRadialSobolevSourceProfile
  exact (ENNReal.continuous_rpow_const.measurable.comp
    ENNReal.continuous_ofReal.measurable).mul
      (measurable_brrsRadialLpSourceProfile p f hf w)

/-- On the compact source-radius range used in the Section 5 split, the
Sobolev weight is uniformly bounded. -/
theorem brrsRadialSobolevSourceProfile_le_const_mul_of_le_1024
    {d : Nat} {p s : Real} (hd : 2 ≤ d) (hp : 2 ≤ p)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) (hs : s ≤ 1024) :
    brrsRadialSobolevSourceProfile p f w s ≤
      (ENNReal.ofReal 1024) ^ sobolevExponent d p *
        brrsRadialLpSourceProfile p f w s := by
  unfold brrsRadialSobolevSourceProfile
  exact mul_le_mul'
    (ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal hs)
      (sobolevExponent_nonneg hd hp)) le_rfl

/-- The compact-source bound is also available after passing to real values;
the finite ENNReal majorant is explicit. -/
theorem brrsRadialSobolevSourceProfile_toReal_le_const_mul_toReal_of_le_1024
    {d : Nat} {p s : Real} (hd : 2 ≤ d) (hp : 2 ≤ p)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) (hs : s ≤ 1024) :
    (brrsRadialSobolevSourceProfile p f w s).toReal ≤
      (((ENNReal.ofReal 1024) ^ sobolevExponent d p) *
        brrsRadialLpSourceProfile p f w s).toReal := by
  have hp_nonneg : 0 ≤ p := le_trans (by norm_num) hp
  have hd_nonneg : 0 ≤ (d : Real) - 1 := by
    have hd_one : (1 : Real) ≤ d := by
      exact_mod_cast (show 1 ≤ d by omega)
    linarith
  have hsource_exp : 0 ≤ ((d : Real) - 1) / p :=
    div_nonneg hd_nonneg hp_nonneg
  have hconst_top : (ENNReal.ofReal 1024) ^ sobolevExponent d p ≠ ∞ :=
    ENNReal.rpow_ne_top_of_nonneg (sobolevExponent_nonneg hd hp)
      ENNReal.ofReal_ne_top
  have hsource_top : brrsRadialLpSourceProfile p f w s ≠ ∞ := by
    unfold brrsRadialLpSourceProfile
    apply ENNReal.mul_ne_top
    · exact ENNReal.rpow_ne_top_of_nonneg hsource_exp ENNReal.ofReal_ne_top
    · exact ENNReal.ofReal_ne_top
  exact ENNReal.toReal_mono (ENNReal.mul_ne_top hconst_top hsource_top)
    (brrsRadialSobolevSourceProfile_le_const_mul_of_le_1024 hd hp f w hs)

/-- Raising the compact-source estimate to the `L^p` power preserves its
explicit Sobolev constant. -/
theorem brrsRadialSobolevSourceProfile_rpow_le_const_mul_rpow_of_le_1024
    {d : Nat} {p s : Real} (hd : 2 ≤ d) (hp : 2 ≤ p)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) (hs : s ≤ 1024) :
    (brrsRadialSobolevSourceProfile p f w s) ^ p ≤
      ((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
        (brrsRadialLpSourceProfile p f w s) ^ p := by
  have hp_nonneg : 0 ≤ p := le_trans (by norm_num) hp
  calc
    (brrsRadialSobolevSourceProfile p f w s) ^ p ≤
        ((ENNReal.ofReal 1024) ^ sobolevExponent d p *
          brrsRadialLpSourceProfile p f w s) ^ p :=
      ENNReal.rpow_le_rpow
        (brrsRadialSobolevSourceProfile_le_const_mul_of_le_1024
          hd hp f w hs) hp_nonneg
    _ = ((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
        (brrsRadialLpSourceProfile p f w s) ^ p := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ hp_nonneg]

/-- On the compact source interval, the Sobolev-weighted `L^p` mass is
bounded by the ordinary radial source mass with the same explicit constant.
This is the direct form consumed by the Section 5 block estimates. -/
theorem brrs_lintegral_radialSobolevSourceProfile_rpow_restrict_le_of_le_1024
    {d : Nat} {p : Real} (hd : 2 ≤ d) (hp : 2 ≤ p)
    (f : BRRSSpace d → Complex) (hfm : Measurable f) (w : BRRSSpace d) :
    (∫⁻ s in Icc (0 : Real) 1024,
      (brrsRadialSobolevSourceProfile p f w s) ^ p) ≤
      ((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
        ∫⁻ s in Icc (0 : Real) 1024,
          (brrsRadialLpSourceProfile p f w s) ^ p := by
  let C : ENNReal := ((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p
  have hsource : Measurable (fun s : Real =>
      (brrsRadialLpSourceProfile p f w s) ^ p) :=
    ENNReal.continuous_rpow_const.measurable.comp
      (measurable_brrsRadialLpSourceProfile p f hfm w)
  calc
    (∫⁻ s in Icc (0 : Real) 1024,
        (brrsRadialSobolevSourceProfile p f w s) ^ p) ≤
        ∫⁻ s in Icc (0 : Real) 1024,
          C * (brrsRadialLpSourceProfile p f w s) ^ p := by
      apply setLIntegral_mono' measurableSet_Icc
      intro s hs
      simpa only [C] using
        brrsRadialSobolevSourceProfile_rpow_le_const_mul_rpow_of_le_1024
          hd hp f w hs.2
    _ = C * ∫⁻ s in Icc (0 : Real) 1024,
        (brrsRadialLpSourceProfile p f w s) ^ p := by
      rw [lintegral_const_mul C hsource]

/-- On the positive half-line, the real value of the Sobolev-weighted source
is the product of the Sobolev radial power and the ordinary `L^p` source
profile. -/
theorem brrsRadialSobolevSourceProfile_toReal
    {d : Nat} (p : Real) (f : BRRSSpace d → Complex) (w : BRRSSpace d)
    {s : Real} (hs : 0 ≤ s) :
    (brrsRadialSobolevSourceProfile p f w s).toReal =
      s ^ sobolevExponent d p *
        (brrsRadialLpSourceProfile p f w s).toReal := by
  unfold brrsRadialSobolevSourceProfile
  rw [ENNReal.toReal_mul, ← ENNReal.toReal_rpow,
    ENNReal.toReal_ofReal hs]

/-- The source/output radius ratio in the high--high majorant factors into
the output Section 5 weight and the Sobolev-weighted scalar input.  Thus the
four endpoint phase terms are literally profile convolutions against one
fixed source function. -/
theorem brrs_radiusRatio_mul_radialLpSourceProfile_toReal_eq
    {d : Nat} {p r s : Real} (hr : 0 < r) (hs : 0 < s)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) :
    (s / r) ^ sobolevExponent d p *
        (brrsRadialLpSourceProfile p f w s).toReal =
      r ^ (-sobolevExponent d p) *
        (brrsRadialSobolevSourceProfile p f w s).toReal := by
  rw [brrsRadialSobolevSourceProfile_toReal p f w hs.le]
  rw [Real.div_rpow hs.le hr.le]
  rw [show s ^ sobolevExponent d p / r ^ sobolevExponent d p =
      s ^ sobolevExponent d p *
        (r ^ sobolevExponent d p)⁻¹ by rw [div_eq_mul_inv]]
  rw [← Real.rpow_neg hr.le]
  ring

/-- The exact half-density/Sobolev-weight identity.  This is the pointwise
source normalization behind the high--high radial reduction. -/
theorem brrs_highHigh_halfDensity_source_weight_eq
    {d : Nat} {p r s : Real} (hp : p ≠ 0) (hr : 0 < r) (hs : 0 < s)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) :
    r ^ (((d : Real) - 1) / p) *
        (r ^ (-(((d : Real) - 1) / 2)) *
          s ^ (((d : Real) - 1) / 2) * ‖f (s • w)‖) =
      (s / r) ^ sobolevExponent d p *
        (brrsRadialLpSourceProfile p f w s).toReal := by
  rw [brrsRadialLpSourceProfile_toReal p f w hs.le]
  let a : Real := (d : Real) - 1
  let b : Real := a * (1 / 2 - 1 / p)
  have hb1 : a / p + -(a / 2) = -b := by
    dsimp [b]
    field_simp [hp]
    ring
  have hb2 : b + a / p = a / 2 := by
    dsimp [b]
    field_simp [hp]
    ring
  change r ^ (a / p) * (r ^ (-(a / 2)) * s ^ (a / 2) * ‖f (s • w)‖) =
    (s / r) ^ b * (s ^ (a / p) * ‖f (s • w)‖)
  calc
    r ^ (a / p) * (r ^ (-(a / 2)) * s ^ (a / 2) * ‖f (s • w)‖) =
        (r ^ (a / p) * r ^ (-(a / 2))) * s ^ (a / 2) * ‖f (s • w)‖ := by ring
    _ = r ^ (a / p + -(a / 2)) * s ^ (a / 2) * ‖f (s • w)‖ := by
      rw [Real.rpow_add hr]
    _ = r ^ (-b) * s ^ (a / 2) * ‖f (s • w)‖ := by rw [hb1]
    _ = (r ^ b)⁻¹ * (s ^ b * s ^ (a / p)) * ‖f (s • w)‖ := by
      rw [Real.rpow_neg hr.le, ← Real.rpow_add hs, hb2]
    _ = (s / r) ^ b * (s ^ (a / p) * ‖f (s • w)‖) := by
      rw [Real.div_rpow hs.le hr.le]
      ring

/-- The exact power conjugation used in the Section 5 radial Bessel-kernel
reduction.  Multiplying the half-density kernel bound by the output radial
`L^p` factor turns it into the (5.4) output weight
`r ^ (-s_p)` times the one-dimensional Sobolev-weighted source profile.
No kernel estimate is used in this identity. -/
theorem brrsRadialBesselKernel_weightConjugation_eq
    {d : Nat} {p r s : Real} (hp : p ≠ 0) (hr : 0 < r) (hs : 0 < s)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) :
    r ^ (((d : Real) - 1) / p) *
        (r ^ (-(((d : Real) - 1) / 2)) *
          s ^ (((d : Real) - 1) / 2) * ‖f (s • w)‖) =
      r ^ (-sobolevExponent d p) *
        (brrsRadialSobolevSourceProfile p f w s).toReal := by
  calc
    r ^ (((d : Real) - 1) / p) *
        (r ^ (-(((d : Real) - 1) / 2)) *
          s ^ (((d : Real) - 1) / 2) * ‖f (s • w)‖) =
        (s / r) ^ sobolevExponent d p *
          (brrsRadialLpSourceProfile p f w s).toReal :=
      brrs_highHigh_halfDensity_source_weight_eq hp hr hs f w
    _ = r ^ (-sobolevExponent d p) *
        (brrsRadialSobolevSourceProfile p f w s).toReal :=
      brrs_radiusRatio_mul_radialLpSourceProfile_toReal_eq hr hs f w

/-- A purely algebraic normalization of the two high-radius half-densities.
It is kept in a form independent of the stationary kernel, so the same
calculation can be reused by every endpoint and middle-wave profile. -/
theorem brrs_highHigh_prefactor_rpow_eq
    {q r s n : Real} (hq : 0 < q) (hr : 0 < r) (hs : 0 < s) :
    q ^ (n + 1) /
        ((q * r / 16) ^ (n / 2) * (q * s / 16) ^ (n / 2)) =
      q * 16 ^ n * (r ^ (-(n / 2)) * s ^ (-(n / 2))) := by
  have h16 : (0 : Real) < 16 := by norm_num
  have hq0 : 0 ≤ q := hq.le
  have hr0 : 0 ≤ r := hr.le
  have hs0 : 0 ≤ s := hs.le
  rw [Real.div_rpow (mul_nonneg hq0 hr0) (by norm_num),
    Real.div_rpow (mul_nonneg hq0 hs0) (by norm_num)]
  rw [Real.mul_rpow hq0 hr0, Real.mul_rpow hq0 hs0]
  have hden :
      (q ^ (n / 2) * r ^ (n / 2) / 16 ^ (n / 2)) *
          (q ^ (n / 2) * s ^ (n / 2) / 16 ^ (n / 2)) =
        (q ^ (n / 2) * q ^ (n / 2)) * (r ^ (n / 2) * s ^ (n / 2)) /
          (16 ^ (n / 2) * 16 ^ (n / 2)) := by
    field_simp [ne_of_gt (Real.rpow_pos_of_pos hq _),
      ne_of_gt (Real.rpow_pos_of_pos hr _),
      ne_of_gt (Real.rpow_pos_of_pos hs _),
      ne_of_gt (Real.rpow_pos_of_pos h16 _)]
  rw [hden]
  rw [show q ^ (n / 2) * q ^ (n / 2) = q ^ n by
    rw [← Real.rpow_add hq]
    congr 1
    ring]
  rw [show 16 ^ (n / 2) * 16 ^ (n / 2) = (16 : Real) ^ n by
    rw [← Real.rpow_add h16]
    congr 1
    ring]
  rw [show q ^ (n + 1) = q ^ n * q by
    rw [Real.rpow_add hq, Real.rpow_one]]
  rw [show r ^ (-(n / 2)) = (r ^ (n / 2))⁻¹ by
    rw [Real.rpow_neg hr.le],
    show s ^ (-(n / 2)) = (s ^ (n / 2))⁻¹ by
      rw [Real.rpow_neg hs.le]]
  field_simp [ne_of_gt (Real.rpow_pos_of_pos hq _),
    ne_of_gt (Real.rpow_pos_of_pos hr _),
    ne_of_gt (Real.rpow_pos_of_pos hs _),
    ne_of_gt (Real.rpow_pos_of_pos h16 _)]

/-- The literal coefficient in the dyadic high--high endpoint estimate has
exactly one remaining dyadic factor after its two radial half-densities are
cancelled. -/
theorem brrsDyadicHighHigh_prefactor_eq
    {d j : Nat} (hd : 1 ≤ d) {r s : Real} (hr : 0 < r) (hs : 0 < s) :
    ‖((2 : Real) ^ j) ^ d‖ /
        ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
          (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1)) =
      ((2 : Real) ^ j) * 16 ^ ((d : Real) - 1) *
        (r ^ (-(((d : Real) - 1) / 2)) * s ^ (-(((d : Real) - 1) / 2))) := by
  let q : Real := (2 : Real) ^ j
  let n : Real := (d : Real) - 1
  have hq : 0 < q := by
    dsimp [q]
    positivity
  have hnum : ‖q ^ d‖ = q ^ (n + 1) := by
    rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg hq.le _),
      ← Real.rpow_natCast]
    dsimp [n]
    congr 1
    ring
  have hsqrtr : (Real.sqrt (q * r / 16)) ^ (d - 1) =
      (q * r / 16) ^ (n / 2) := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_natCast,
      ← Real.rpow_mul (by positivity)]
    dsimp [n]
    norm_num [Nat.cast_sub hd]
    ring
  have hsqrts : (Real.sqrt (q * s / 16)) ^ (d - 1) =
      (q * s / 16) ^ (n / 2) := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_natCast,
      ← Real.rpow_mul (by positivity)]
    dsimp [n]
    norm_num [Nat.cast_sub hd]
    ring
  change ‖q ^ d‖ /
      ((Real.sqrt (q * r / 16)) ^ (d - 1) *
        (Real.sqrt (q * s / 16)) ^ (d - 1)) =
      q * 16 ^ n * (r ^ (-(n / 2)) * s ^ (-(n / 2)))
  rw [hnum, hsqrtr, hsqrts]
  exact brrs_highHigh_prefactor_rpow_eq hq hr hs

/-- Multiplying the literal dyadic high--high coefficient by the polar
source density and the output `L^p` radial factor yields exactly the Section
5 source profile with its Sobolev radius weight. -/
theorem brrsDyadicHighHigh_prefactor_polar_source_eq
    {d j : Nat} (hd : 1 ≤ d) {p r s : Real} (hp : p ≠ 0)
    (hr : 0 < r) (hs : 0 < s) (f : BRRSSpace d → Complex) (w : BRRSSpace d) :
    r ^ (((d : Real) - 1) / p) *
        ((‖((2 : Real) ^ j) ^ d‖ /
          ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
            (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1))) *
          (s ^ (d - 1) * ‖f (s • w)‖)) =
      16 ^ ((d : Real) - 1) *
        ((s / r) ^ sobolevExponent d p *
          (brrsRadialLpSourceProfile p f w s).toReal) * ((2 : Real) ^ j) := by
  let n : Real := (d : Real) - 1
  let q : Real := (2 : Real) ^ j
  have hspow : s ^ (d - 1) = s ^ n := by
    rw [← Real.rpow_natCast]
    dsimp [n]
    norm_num [Nat.cast_sub hd]
  have hscombine : s ^ (-(n / 2)) * s ^ n = s ^ (n / 2) := by
    rw [← Real.rpow_add hs]
    congr 1
    ring
  have hhalf : r ^ (n / p) *
      (r ^ (-(n / 2)) * s ^ (n / 2) * ‖f (s • w)‖) =
      (s / r) ^ sobolevExponent d p *
        (brrsRadialLpSourceProfile p f w s).toReal := by
    dsimp [n]
    exact brrs_highHigh_halfDensity_source_weight_eq hp hr hs f w
  change r ^ (n / p) *
      ((‖q ^ d‖ /
        ((Real.sqrt (q * r / 16)) ^ (d - 1) *
          (Real.sqrt (q * s / 16)) ^ (d - 1))) *
        (s ^ (d - 1) * ‖f (s • w)‖)) =
      16 ^ n * ((s / r) ^ sobolevExponent d p *
        (brrsRadialLpSourceProfile p f w s).toReal) * q
  rw [hspow, brrsDyadicHighHigh_prefactor_eq hd hr hs]
  calc
    r ^ (n / p) *
        ((q * 16 ^ n * (r ^ (-(n / 2)) * s ^ (-(n / 2)))) *
          (s ^ n * ‖f (s • w)‖)) =
        16 ^ n * q *
          (r ^ (n / p) * (r ^ (-(n / 2)) *
            (s ^ (-(n / 2)) * s ^ n) * ‖f (s • w)‖)) := by ring
    _ = 16 ^ n * q *
          (r ^ (n / p) * (r ^ (-(n / 2)) *
            s ^ (n / 2) * ‖f (s • w)‖)) := by rw [hscombine]
    _ = 16 ^ n * q *
          ((s / r) ^ sobolevExponent d p *
            (brrsRadialLpSourceProfile p f w s).toReal) := by rw [hhalf]
    _ = 16 ^ n * ((s / r) ^ sobolevExponent d p *
          (brrsRadialLpSourceProfile p f w s).toReal) * q := by ring

/-- The four literal endpoint phases in the dyadic high--high kernel become
the four translated copies of the single scalar phase profile.  Together
with `brrsDyadicHighHigh_prefactor_polar_source_eq`, this is the pointwise
bridge from the kernel estimate to the four Section 5 convolution inputs;
no outer radial integration is used here. -/
theorem brrsDyadicHighHigh_prefactor_polar_source_fourPhase_eq
    {d j N : Nat} (hd : 1 ≤ d) {p r s t : Real} (hp : p ≠ 0)
    (hr : 0 < r) (hs : 0 < s) (f : BRRSSpace d → Complex) (w : BRRSSpace d) :
    r ^ (((d : Real) - 1) / p) *
        ((‖((2 : Real) ^ j) ^ d‖ /
          ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
            (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1))) *
          (s ^ (d - 1) * ‖f (s • w)‖)) *
        (brrsStationaryRapidProfile N
            (2 * Real.pi * (((2 : Real) ^ j * t) -
