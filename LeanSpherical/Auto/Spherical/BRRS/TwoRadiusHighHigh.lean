  have hphase : Measurable (fun s : Real =>
      brrsDyadicStationaryPhaseProfile N j (t - r - s) +
        brrsDyadicStationaryPhaseProfile N j (t - r + s) +
          brrsDyadicStationaryPhaseProfile N j (t + r - s) +
            brrsDyadicStationaryPhaseProfile N j (t + r + s)) := by
    let hprofile : Measurable (brrsDyadicStationaryPhaseProfile N j) :=
      measurable_brrsDyadicStationaryPhaseProfile N j
    exact (((hprofile.comp (measurable_const.sub measurable_id)).add
      (hprofile.comp (measurable_const.add measurable_id))).add
        (hprofile.comp (measurable_const.sub measurable_id))).add
          (hprofile.comp (measurable_const.add measurable_id))
  calc
    (∫⁻ s in Icc (0 : Real) 1024,
        brrsRadialSobolevSourceProfile p f w s *
          (brrsDyadicStationaryPhaseProfile N j (t - r - s) +
            brrsDyadicStationaryPhaseProfile N j (t - r + s) +
              brrsDyadicStationaryPhaseProfile N j (t + r - s) +
                brrsDyadicStationaryPhaseProfile N j (t + r + s))) ≤
        ∫⁻ s in Icc (0 : Real) 1024,
          (((ENNReal.ofReal 1024) ^ sobolevExponent d p) *
            brrsRadialLpSourceProfile p f w s) *
              (brrsDyadicStationaryPhaseProfile N j (t - r - s) +
                brrsDyadicStationaryPhaseProfile N j (t - r + s) +
                  brrsDyadicStationaryPhaseProfile N j (t + r - s) +
                    brrsDyadicStationaryPhaseProfile N j (t + r + s)) := by
      apply setLIntegral_mono' measurableSet_Icc
      intro s hs
      exact mul_le_mul'
        (brrsRadialSobolevSourceProfile_le_const_mul_of_le_1024
          hd hp f w hs.2) le_rfl
    _ = ((ENNReal.ofReal 1024) ^ sobolevExponent d p) *
        ∫⁻ s in Icc (0 : Real) 1024,
          brrsRadialLpSourceProfile p f w s *
            (brrsDyadicStationaryPhaseProfile N j (t - r - s) +
              brrsDyadicStationaryPhaseProfile N j (t - r + s) +
                brrsDyadicStationaryPhaseProfile N j (t + r - s) +
                  brrsDyadicStationaryPhaseProfile N j (t + r + s)) := by
      simp_rw [mul_assoc]
      let G : Real → ENNReal := fun s =>
        brrsRadialLpSourceProfile p f w s *
          (brrsDyadicStationaryPhaseProfile N j (t - r - s) +
            brrsDyadicStationaryPhaseProfile N j (t - r + s) +
              brrsDyadicStationaryPhaseProfile N j (t + r - s) +
                brrsDyadicStationaryPhaseProfile N j (t + r + s))
      have hG : Measurable G := by
        dsimp only [G]
        exact hsource.mul hphase
      change (∫⁻ s in Icc (0 : Real) 1024,
        ((ENNReal.ofReal 1024) ^ sobolevExponent d p) * G s) =
          ((ENNReal.ofReal 1024) ^ sobolevExponent d p) *
            ∫⁻ s in Icc (0 : Real) 1024, G s
      exact lintegral_const_mul _ hG

/-- The compact Sobolev source mass is controlled directly by the ambient
radial `L^p` seminorm.  This is the source-side normalization needed to turn
the compact high--high majorant into the target rate. -/
theorem brrs_compactSobolevSourceProfile_rpow_mass_le_eLpNorm_rpow
    {d : Nat} {p : Real} (hd : 2 ≤ d) (hp : 2 ≤ p)
    (f : BRRSSpace d → Complex) (hf : IsRadial f) (hfm : Measurable f)
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    ENNReal.ofReal (surfaceMass d) *
        (∫⁻ s in Icc (0 : Real) 1024,
          (brrsRadialSobolevSourceProfile p f w s) ^ p) ≤
      ((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
        (eLpNorm f (ENNReal.ofReal p) volume) ^ p := by
  have hp_pos : 0 < p := lt_of_lt_of_le (by norm_num) hp
  have hcompact :=
    brrs_lintegral_radialSobolevSourceProfile_rpow_restrict_le_of_le_1024
      hd hp f hfm w
  have hambient : ENNReal.ofReal (surfaceMass d) *
      (∫⁻ s in Icc (0 : Real) 1024,
        (brrsRadialLpSourceProfile p f w s) ^ p) ≤
      (eLpNorm f (ENNReal.ofReal p) volume) ^ p := by
    rw [brrs_eLpNorm_rpow_radial_eq_sourceProfile_full hd f hf hfm hp_pos w hw]
    exact mul_le_mul_right
      (setLIntegral_le_lintegral (Icc (0 : Real) 1024)
        (fun s : Real => (brrsRadialLpSourceProfile p f w s) ^ p))
      (ENNReal.ofReal (surfaceMass d))
  calc
    ENNReal.ofReal (surfaceMass d) *
        (∫⁻ s in Icc (0 : Real) 1024,
          (brrsRadialSobolevSourceProfile p f w s) ^ p) ≤
        ENNReal.ofReal (surfaceMass d) *
          (((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
            ∫⁻ s in Icc (0 : Real) 1024,
              (brrsRadialLpSourceProfile p f w s) ^ p) :=
      mul_le_mul_right hcompact (ENNReal.ofReal (surfaceMass d))
    _ = ((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
        (ENNReal.ofReal (surfaceMass d) *
          ∫⁻ s in Icc (0 : Real) 1024,
            (brrsRadialLpSourceProfile p f w s) ^ p) := by
      ring
    _ ≤ ((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
        (eLpNorm f (ENNReal.ofReal p) volume) ^ p :=
      mul_le_mul_right hambient
        (((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p)

/-! ### Compact high--high source and the Section 5 block bridge

The pointwise high--high endpoint estimate has a compact-source version in
which the Sobolev factor is replaced by a fixed constant times the ordinary
radial `L^p` source.  We package that source with its support restriction
here.  This is the literal input of the four-sign Section 5 block functional:
it is not an auxiliary abstract profile.
-/

/-- The compact source appearing in the actual high--high endpoint kernel
majorant.  Outside the source-radius interval `0 ≤ s ≤ 1024` it vanishes;
inside it is exactly the explicit Sobolev constant times the radial `L^p`
source profile. -/
noncomputable def brrsCompactHighHighSourceProfile {d : Nat} (p : Real)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) : Real → ENNReal :=
  (Icc (0 : Real) 1024).indicator
    (fun s => ((ENNReal.ofReal 1024) ^ sobolevExponent d p) *
      brrsRadialLpSourceProfile p f w s)

/-- The literal compact high--high source is measurable on the phase line. -/
theorem measurable_brrsCompactHighHighSourceProfile {d : Nat} (p : Real)
    (f : BRRSSpace d → Complex) (hfm : Measurable f) (w : BRRSSpace d) :
    Measurable (brrsCompactHighHighSourceProfile p f w) := by
  unfold brrsCompactHighHighSourceProfile
  exact (measurable_const.mul
    (measurable_brrsRadialLpSourceProfile p f hfm w)).indicator measurableSet_Icc

/-- On the compact source interval the packaged high--high source is exactly
the source factor in `exists_brrsDyadicHighHigh_endpoint_radial_fourPhase_compactSource_block_le`.
-/
theorem brrsCompactHighHighSourceProfile_eq_of_mem
    {d : Nat} (p : Real) (f : BRRSSpace d → Complex) (w : BRRSSpace d)
    {s : Real} (hs : s ∈ Icc (0 : Real) 1024) :
    brrsCompactHighHighSourceProfile p f w s =
      ((ENNReal.ofReal 1024) ^ sobolevExponent d p) *
        brrsRadialLpSourceProfile p f w s := by
  simp only [brrsCompactHighHighSourceProfile, Set.indicator_of_mem hs]

/-- On its support, the compact high--high source dominates the
Sobolev-weighted source.  This is the pointwise form of the compact-source
replacement and identifies the existing Sobolev mass theorem with the source
used by the endpoint block model. -/
theorem brrsRadialSobolevSourceProfile_le_brrsCompactHighHighSourceProfile_of_mem
    {d : Nat} {p s : Real} (hd : 2 ≤ d) (hp : 2 ≤ p)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d)
    (hs : s ∈ Icc (0 : Real) 1024) :
    brrsRadialSobolevSourceProfile p f w s ≤
      brrsCompactHighHighSourceProfile p f w s := by
  rw [brrsCompactHighHighSourceProfile_eq_of_mem p f w hs]
  exact brrsRadialSobolevSourceProfile_le_const_mul_of_le_1024 hd hp f w hs.2

/-- The `p`-mass of the compact high--high source is its literal restricted
radial source mass, including the displayed Sobolev constant. -/
theorem lintegral_brrsCompactHighHighSourceProfile_rpow_eq
    {d : Nat} {p : Real} (hp : 0 < p)
    (f : BRRSSpace d → Complex) (hfm : Measurable f) (w : BRRSSpace d) :
    (∫⁻ s : Real, (brrsCompactHighHighSourceProfile p f w s) ^ p) =
      ((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
        ∫⁻ s in Icc (0 : Real) 1024,
          (brrsRadialLpSourceProfile p f w s) ^ p := by
  let C : ENNReal := (ENNReal.ofReal 1024) ^ sobolevExponent d p
  let g : Real → ENNReal := brrsRadialLpSourceProfile p f w
  have hgpow : Measurable (fun s : Real => (g s) ^ p) := by
    exact ENNReal.continuous_rpow_const.measurable.comp
      (measurable_brrsRadialLpSourceProfile p f hfm w)
  have hind : Measurable ((Icc (0 : Real) 1024).indicator
      (fun s : Real => (g s) ^ p)) :=
    hgpow.indicator measurableSet_Icc
  calc
    (∫⁻ s : Real, (brrsCompactHighHighSourceProfile p f w s) ^ p) =
        ∫⁻ s : Real, (Icc (0 : Real) 1024).indicator
          (fun s => (C * g s) ^ p) s := by
      apply lintegral_congr
      intro s
      by_cases hs : s ∈ Icc (0 : Real) 1024
      · simp [brrsCompactHighHighSourceProfile, hs, C, g]
      · simp [brrsCompactHighHighSourceProfile, hs, ENNReal.zero_rpow_of_pos hp,
          C, g]
    _ = ∫⁻ s : Real, (Icc (0 : Real) 1024).indicator
          (fun s => C ^ p * (g s) ^ p) s := by
      apply lintegral_congr
      intro s
      simp_rw [ENNReal.mul_rpow_of_nonneg _ _ hp.le]
    _ = C ^ p * ∫⁻ s : Real, (Icc (0 : Real) 1024).indicator
          (fun s => (g s) ^ p) s := by
      rw [← lintegral_const_mul (C ^ p) hind]
      apply lintegral_congr
      intro s
      by_cases hs : s ∈ Icc (0 : Real) 1024
      · simp only [Set.indicator_of_mem hs]
      · simp only [Set.indicator_of_notMem hs, mul_zero]
    _ = ((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
        ∫⁻ s in Icc (0 : Real) 1024,
          (brrsRadialLpSourceProfile p f w s) ^ p := by
      rw [lintegral_indicator measurableSet_Icc]

/-- The compact high--high source has exactly the ambient radial `L^p`
normalization required for the endpoint block estimate.  The surface factor
is retained on the left because it is the polar-coordinate Jacobian. -/
theorem brrs_compactHighHighSourceProfile_rpow_mass_surface_le_eLpNorm_rpow
    {d : Nat} {p : Real} (hd : 2 ≤ d) (hp : 2 ≤ p)
    (f : BRRSSpace d → Complex) (hf : IsRadial f) (hfm : Measurable f)
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    ENNReal.ofReal (surfaceMass d) *
        (∫⁻ s : Real, (brrsCompactHighHighSourceProfile p f w s) ^ p) ≤
      ((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
        (eLpNorm f (ENNReal.ofReal p) volume) ^ p := by
  have hp_pos : 0 < p := lt_of_lt_of_le (by norm_num) hp
  have hrestricted : ENNReal.ofReal (surfaceMass d) *
      (∫⁻ s in Icc (0 : Real) 1024,
        (brrsRadialLpSourceProfile p f w s) ^ p) ≤
      (eLpNorm f (ENNReal.ofReal p) volume) ^ p := by
    rw [brrs_eLpNorm_rpow_radial_eq_sourceProfile_full hd f hf hfm hp_pos w hw]
    exact mul_le_mul_right
      (setLIntegral_le_lintegral (Icc (0 : Real) 1024)
        (fun s : Real => (brrsRadialLpSourceProfile p f w s) ^ p))
      (ENNReal.ofReal (surfaceMass d))
  rw [lintegral_brrsCompactHighHighSourceProfile_rpow_eq hp_pos f hfm w]
  calc
    ENNReal.ofReal (surfaceMass d) *
        (((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
          ∫⁻ s in Icc (0 : Real) 1024,
            (brrsRadialLpSourceProfile p f w s) ^ p) =
        ((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
          (ENNReal.ofReal (surfaceMass d) *
            ∫⁻ s in Icc (0 : Real) 1024,
              (brrsRadialLpSourceProfile p f w s) ^ p) := by
      ring
    _ ≤ ((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
        (eLpNorm f (ENNReal.ofReal p) volume) ^ p :=
      mul_le_mul_right hrestricted
        (((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p)

/-- The actual dyadic endpoint kernel on the compact high--high source
region is controlled by the four Section 5 phase profiles against
`brrsCompactHighHighSourceProfile`.  Thus the source in this statement is
exactly the input of the scalar four-phase block functional below. -/
theorem exists_brrsDyadicHighHigh_endpoint_radial_fourPhase_compactProfile_block_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r s t p : Real,
      ∀ f : BRRSSpace d → Complex, ∀ w : BRRSSpace d,
      2 ≤ p → s ∈ Icc (0 : Real) 1024 →
      16 ≤ ((2 : Real) ^ j) * r → 16 ≤ ((2 : Real) ^ j) * s →
      r ^ (((d : Real) - 1) / p) *
          (‖brrsDyadicTwoRadiusEndpointIntegralSum Phi d j r s t‖ *
            (s ^ (d - 1) * ‖f (s • w)‖)) ≤
        (1 - (1 / 32 : Real)) * C * 16 ^ ((d : Real) - 1) *
          r ^ (-sobolevExponent d p) *
          (brrsCompactHighHighSourceProfile p f w s).toReal *
          ((brrsDyadicStationaryPhaseProfile N j (t - r - s)).toReal +
            (brrsDyadicStationaryPhaseProfile N j (t - r + s)).toReal +
              (brrsDyadicStationaryPhaseProfile N j (t + r - s)).toReal +
                (brrsDyadicStationaryPhaseProfile N j (t + r + s)).toReal) := by
  obtain ⟨C, hC, hblock⟩ :=
    exists_brrsDyadicHighHigh_endpoint_radial_fourPhase_compactSource_block_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j r s t p f w hp hs hr hshigh
  rw [brrsCompactHighHighSourceProfile_eq_of_mem p f w hs]
  exact hblock j r s t p f w hp hs.1 hs.2 hr hshigh

/-- The high--high compact-source four-phase model obeys the sharp
Legendre--Assouad tail estimate after summing all dyadic output-radius
blocks.  The left side is the literal Section 5 block functional, while the
surface factor makes its source mass exactly the ambient radial `L^p` mass.

The only remaining hypothesis on `W` is the expected block envelope with
exponent `p * s_p`; the actual endpoint kernel supplies this weight after
the output radial factor has been extracted. -/
theorem exists_tail_sum_brrsDyadicHighHigh_compactSource_fourPhaseBlock_surfaceMass_le
    {E : Set Real} {d N : Nat} {p q : Real}
    (hd : 3 ≤ d) (hp : 2 ≤ p) (hN : 2 ≤ N)
    (hνq : brrsLegendreAssouadFunction E (p * sobolevExponent d p) < q)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d → Complex))
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    ∃ J : Nat, ∀ j ≥ J, ∀ T : Finset Real, IsDyadicDiscretization E j T →
      ∀ W : Real → ENNReal,
        (∀ m : Nat, m ≤ j → ∀ r ∈
          Icc (brrsDyadicRadialBlockRadius j m : Real)
            (2 * (brrsDyadicRadialBlockRadius j m : Real)),
          W r ≤ (brrsDyadicRadialBlockRadius j m : ENNReal) ^
            (-(p * sobolevExponent d p))) →
        ENNReal.ofReal (surfaceMass d) *
          (∑ m ∈ Finset.range (j + 1),
            brrsDyadicRadialEndpointFourPhaseBlock T j m p W
              (brrsDyadicStationaryPhaseProfile N j)
              (brrsCompactHighHighSourceProfile p
                (f : BRRSSpace d → Complex) w)) ≤
          28 * ((j + 1 : ENNReal) *
            ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) :
              ENNReal)⁻¹) ^ q) *
            ((∫⁻ u : Real, brrsDyadicStationaryPhaseProfile N j u) ^ p *
              (((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
                (eLpNorm (f : BRRSSpace d → Complex) (ENNReal.ofReal p) volume) ^ p)) := by
  have halpha : 0 ≤ p * sobolevExponent d p :=
    mul_sobolevExponent_nonneg (by omega) hp
  obtain ⟨J, hJ⟩ :=
    exists_tail_sum_brrsDyadicRadialEndpointFourPhaseBlock_le_inv_rpow_of_lt
      (E := E) (alpha := p * sobolevExponent d p) (q := q) halpha hνq
  refine ⟨J, ?_⟩
  intro j hj T hT W hW
  have hp_one : 1 < p := lt_of_lt_of_le (by norm_num) hp
  have hscalar := hJ j hj T hT p W
    (brrsDyadicStationaryPhaseProfile N j)
    (brrsCompactHighHighSourceProfile p (f : BRRSSpace d → Complex) w)
    hp_one
    (measurable_brrsDyadicStationaryPhaseProfile N j)
    (measurable_brrsCompactHighHighSourceProfile p
      (f : BRRSSpace d → Complex) f.continuous.measurable w)
    (brrsDyadicStationaryPhaseProfile_pos N j)
    (brrsDyadicStationaryPhaseProfile_ne_top N j)
    (lintegral_brrsDyadicStationaryPhaseProfile_pos N j)
    (lintegral_brrsDyadicStationaryPhaseProfile_ne_top N j hN)
    hW
  have hmass :=
    brrs_compactHighHighSourceProfile_rpow_mass_surface_le_eLpNorm_rpow
      (d := d) (p := p) (by omega) hp
      (f : BRRSSpace d → Complex) hf f.continuous.measurable w hw
  let A : ENNReal := 28 * ((j + 1 : ENNReal) *
    ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) :
      ENNReal)⁻¹) ^ q)
  let M : ENNReal := ∫⁻ u : Real, brrsDyadicStationaryPhaseProfile N j u
  let S : ENNReal := ∫⁻ s : Real,
    (brrsCompactHighHighSourceProfile p (f : BRRSSpace d → Complex) w s) ^ p
  let B : ENNReal := ((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
    (eLpNorm (f : BRRSSpace d → Complex) (ENNReal.ofReal p) volume) ^ p
  have hscalar' :
      (∑ m ∈ Finset.range (j + 1),
        brrsDyadicRadialEndpointFourPhaseBlock T j m p W
          (brrsDyadicStationaryPhaseProfile N j)
          (brrsCompactHighHighSourceProfile p
            (f : BRRSSpace d → Complex) w)) ≤ A * (M ^ p * S) := by
    simpa only [A, M, S] using hscalar
  have hmass' : ENNReal.ofReal (surfaceMass d) * S ≤ B := by
    simpa only [S, B] using hmass
  calc
    ENNReal.ofReal (surfaceMass d) *
        (∑ m ∈ Finset.range (j + 1),
          brrsDyadicRadialEndpointFourPhaseBlock T j m p W
            (brrsDyadicStationaryPhaseProfile N j)
            (brrsCompactHighHighSourceProfile p
              (f : BRRSSpace d → Complex) w)) ≤
        ENNReal.ofReal (surfaceMass d) * (A * (M ^ p * S)) :=
      mul_le_mul_right hscalar' (ENNReal.ofReal (surfaceMass d))
    _ = (ENNReal.ofReal (surfaceMass d) * S) * (A * M ^ p) := by
      ring
    _ ≤ B * (A * M ^ p) := mul_le_mul_left hmass' _
    _ = A * (M ^ p * B) := by
      ring
    _ = 28 * ((j + 1 : ENNReal) *
          ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) :
            ENNReal)⁻¹) ^ q) *
          ((∫⁻ u : Real, brrsDyadicStationaryPhaseProfile N j u) ^ p *
            (((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
              (eLpNorm (f : BRRSSpace d → Complex) (ENNReal.ofReal p) volume) ^ p)) := by
      rfl

/-! ### Literal compact high--high endpoint radial integral

The following positive integral is the endpoint--endpoint part of the actual
two-radius radial kernel, restricted exactly to the high source radii inside
the compact source region.  It is deliberately kept separate from the
four-phase majorant so that the passage from the actual kernel to the scalar
Section 5 blocks is an explicit theorem rather than an implicit convention.
-/

/-- High source radii in the compact-source part of a dyadic level. -/
noncomputable def brrsDyadicHighHighCompactSourceSet (j : Nat) : Set Real :=
  Icc (16 / ((2 : Real) ^ j)) 1024

theorem measurableSet_brrsDyadicHighHighCompactSourceSet (j : Nat) :
    MeasurableSet (brrsDyadicHighHighCompactSourceSet j) := by
  unfold brrsDyadicHighHighCompactSourceSet
  exact measurableSet_Icc

/-- Membership in the compact high--high source set gives all the source
radius hypotheses used by the literal stationary endpoint estimate. -/
theorem brrsDyadicHighHighCompactSourceSet_mem
    (j : Nat) {s : Real} (hs : s ∈ brrsDyadicHighHighCompactSourceSet j) :
    0 ≤ s ∧ s ≤ 1024 ∧ 16 ≤ ((2 : Real) ^ j) * s := by
  unfold brrsDyadicHighHighCompactSourceSet at hs
  have hq : 0 < (2 : Real) ^ j := by positivity
  refine ⟨le_trans (by positivity) hs.1, hs.2, ?_⟩
  calc
    16 = (16 / ((2 : Real) ^ j)) * ((2 : Real) ^ j) := by
      field_simp [hq.ne']
    _ ≤ s * ((2 : Real) ^ j) :=
      mul_le_mul_of_nonneg_right hs.1 hq.le
    _ = ((2 : Real) ^ j) * s := by ring

/-- The actual positive radial source integral of the dyadic endpoint
kernel in the compact high--high region.  The output factor is already the
radial `L^p` factor used in the BRRS reduction. -/
noncomputable def brrsDyadicHighHighCompactEndpointRadialIntegral
    (Phi : BRRSAnnularCutoff) (d j : Nat) (p : Real)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) (t r : Real) : ENNReal :=
  ∫⁻ s in brrsDyadicHighHighCompactSourceSet j,
    ENNReal.ofReal
      (r ^ (((d : Real) - 1) / p) *
        (‖brrsDyadicTwoRadiusEndpointIntegralSum Phi d j r s t‖ *
          (s ^ (d - 1) * ‖f (s • w)‖)))

/-- The four positive phase-line profiles which majorize the preceding
actual endpoint radial integral. -/
noncomputable def brrsDyadicHighHighCompactFourPhaseProfileIntegral
    {d : Nat} (N j : Nat) (p : Real)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) (t r : Real) : ENNReal :=
  ∫⁻ s in brrsDyadicHighHighCompactSourceSet j,
    brrsCompactHighHighSourceProfile p f w s *
      (brrsDyadicStationaryPhaseProfile N j (t - r - s) +
        brrsDyadicStationaryPhaseProfile N j (t - r + s) +
          brrsDyadicStationaryPhaseProfile N j (t + r - s) +
            brrsDyadicStationaryPhaseProfile N j (t + r + s))

/-- The literal compact high--high endpoint radial integral is controlled by
the four positive phase profiles before any `L^p` or dyadic-block summation.
This is the operator-to-scalar step: its left hand side still contains the
actual dyadic two-radius endpoint kernel. -/
theorem exists_brrsDyadicHighHighCompactEndpointRadialIntegral_le_fourPhaseProfile
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r t p : Real,
      ∀ f : BRRSSpace d → Complex, ∀ w : BRRSSpace d,
      Measurable f → 2 ≤ p → 16 ≤ ((2 : Real) ^ j) * r →
      brrsDyadicHighHighCompactEndpointRadialIntegral Phi d j p f w t r ≤
        ENNReal.ofReal ((1 - (1 / 32 : Real)) * C * 16 ^ ((d : Real) - 1)) *
          (ENNReal.ofReal r) ^ (-sobolevExponent d p) *
          brrsDyadicHighHighCompactFourPhaseProfileIntegral N j p f w t r := by
  obtain ⟨C, hC, hpoint⟩ :=
    exists_brrsDyadicHighHigh_endpoint_radial_fourPhase_compactProfile_block_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j r t p f w hfm hp hr
  let A : Real := (1 - (1 / 32 : Real)) * C * 16 ^ ((d : Real) - 1)
  let g : Real → ENNReal := brrsCompactHighHighSourceProfile p f w
  let P : Real → ENNReal := fun s =>
    brrsDyadicStationaryPhaseProfile N j (t - r - s) +
      brrsDyadicStationaryPhaseProfile N j (t - r + s) +
        brrsDyadicStationaryPhaseProfile N j (t + r - s) +
          brrsDyadicStationaryPhaseProfile N j (t + r + s)
  have hq : 0 < (2 : Real) ^ j := by positivity
  have hrpos : 0 < r := by
    apply pos_of_mul_pos_right
      (lt_of_lt_of_le (by norm_num) hr)
    exact hq.le
  have hA : 0 ≤ A := by
    dsimp [A]
    positivity
  have hPmeas : Measurable P := by
    dsimp only [P]
    let hω : Measurable (brrsDyadicStationaryPhaseProfile N j) :=
      measurable_brrsDyadicStationaryPhaseProfile N j
    exact (((hω.comp (measurable_const.sub measurable_id)).add
      (hω.comp (measurable_const.add measurable_id))).add
        (hω.comp (measurable_const.sub measurable_id))).add
          (hω.comp (measurable_const.add measurable_id))
  have hgmeas : Measurable g := by
    dsimp only [g]
    exact measurable_brrsCompactHighHighSourceProfile p f
      hfm w
  have hGPmeas : Measurable (fun s : Real => g s * P s) := hgmeas.mul hPmeas
  have hphase (s : Real) :
      ENNReal.ofReal
        ((brrsDyadicStationaryPhaseProfile N j (t - r - s)).toReal +
          (brrsDyadicStationaryPhaseProfile N j (t - r + s)).toReal +
            (brrsDyadicStationaryPhaseProfile N j (t + r - s)).toReal +
              (brrsDyadicStationaryPhaseProfile N j (t + r + s)).toReal) ≤ P s := by
    calc
      ENNReal.ofReal
          ((brrsDyadicStationaryPhaseProfile N j (t - r - s)).toReal +
            (brrsDyadicStationaryPhaseProfile N j (t - r + s)).toReal +
              (brrsDyadicStationaryPhaseProfile N j (t + r - s)).toReal +
                (brrsDyadicStationaryPhaseProfile N j (t + r + s)).toReal) ≤
          ENNReal.ofReal
            ((brrsDyadicStationaryPhaseProfile N j (t - r - s)).toReal +
              (brrsDyadicStationaryPhaseProfile N j (t - r + s)).toReal +
                (brrsDyadicStationaryPhaseProfile N j (t + r - s)).toReal) +
            ENNReal.ofReal
              (brrsDyadicStationaryPhaseProfile N j (t + r + s)).toReal :=
        ENNReal.ofReal_add_le
      _ ≤
          (ENNReal.ofReal
            ((brrsDyadicStationaryPhaseProfile N j (t - r - s)).toReal +
              (brrsDyadicStationaryPhaseProfile N j (t - r + s)).toReal) +
            ENNReal.ofReal
              (brrsDyadicStationaryPhaseProfile N j (t + r - s)).toReal) +
            ENNReal.ofReal
              (brrsDyadicStationaryPhaseProfile N j (t + r + s)).toReal := by
        gcongr
        exact ENNReal.ofReal_add_le
      _ ≤
          ((ENNReal.ofReal
            (brrsDyadicStationaryPhaseProfile N j (t - r - s)).toReal +
            ENNReal.ofReal
              (brrsDyadicStationaryPhaseProfile N j (t - r + s)).toReal) +
            ENNReal.ofReal
              (brrsDyadicStationaryPhaseProfile N j (t + r - s)).toReal) +
            ENNReal.ofReal
              (brrsDyadicStationaryPhaseProfile N j (t + r + s)).toReal := by
        gcongr
        exact ENNReal.ofReal_add_le
      _ ≤ P s := by
        dsimp only [P]
        gcongr <;> exact ENNReal.ofReal_toReal_le
  have hpointENN (s : Real) (hs : s ∈ brrsDyadicHighHighCompactSourceSet j) :
      ENNReal.ofReal
        (r ^ (((d : Real) - 1) / p) *
          (‖brrsDyadicTwoRadiusEndpointIntegralSum Phi d j r s t‖ *
            (s ^ (d - 1) * ‖f (s • w)‖))) ≤
        ENNReal.ofReal A * (ENNReal.ofReal r) ^ (-sobolevExponent d p) *
          (g s * P s) := by
    rcases brrsDyadicHighHighCompactSourceSet_mem j hs with ⟨hs0, hs1024, hshigh⟩
    have hreal := hpoint j r s t p f w hp ⟨hs0, hs1024⟩ hr hshigh
    have hrpow_nonneg : 0 ≤ r ^ (-sobolevExponent d p) :=
      Real.rpow_nonneg hrpos.le _
    have hphase_nonneg : 0 ≤
        (brrsDyadicStationaryPhaseProfile N j (t - r - s)).toReal +
          (brrsDyadicStationaryPhaseProfile N j (t - r + s)).toReal +
            (brrsDyadicStationaryPhaseProfile N j (t + r - s)).toReal +
              (brrsDyadicStationaryPhaseProfile N j (t + r + s)).toReal := by
      positivity
    have hrewrite :
        ENNReal.ofReal
          (A * r ^ (-sobolevExponent d p) * (g s).toReal *
            ((brrsDyadicStationaryPhaseProfile N j (t - r - s)).toReal +
              (brrsDyadicStationaryPhaseProfile N j (t - r + s)).toReal +
                (brrsDyadicStationaryPhaseProfile N j (t + r - s)).toReal +
                  (brrsDyadicStationaryPhaseProfile N j (t + r + s)).toReal)) =
          ENNReal.ofReal A * (ENNReal.ofReal r) ^ (-sobolevExponent d p) *
            (ENNReal.ofReal (g s).toReal *
              ENNReal.ofReal
                ((brrsDyadicStationaryPhaseProfile N j (t - r - s)).toReal +
                  (brrsDyadicStationaryPhaseProfile N j (t - r + s)).toReal +
                    (brrsDyadicStationaryPhaseProfile N j (t + r - s)).toReal +
                      (brrsDyadicStationaryPhaseProfile N j (t + r + s)).toReal)) := by
      calc
        ENNReal.ofReal
            (A * r ^ (-sobolevExponent d p) * (g s).toReal *
              ((brrsDyadicStationaryPhaseProfile N j (t - r - s)).toReal +
                (brrsDyadicStationaryPhaseProfile N j (t - r + s)).toReal +
                  (brrsDyadicStationaryPhaseProfile N j (t + r - s)).toReal +
                    (brrsDyadicStationaryPhaseProfile N j (t + r + s)).toReal)) =
            ENNReal.ofReal
              (A * r ^ (-sobolevExponent d p) * (g s).toReal) *
              ENNReal.ofReal
                ((brrsDyadicStationaryPhaseProfile N j (t - r - s)).toReal +
                  (brrsDyadicStationaryPhaseProfile N j (t - r + s)).toReal +
                    (brrsDyadicStationaryPhaseProfile N j (t + r - s)).toReal +
                      (brrsDyadicStationaryPhaseProfile N j (t + r + s)).toReal) :=
          ENNReal.ofReal_mul
            (mul_nonneg (mul_nonneg hA hrpow_nonneg) ENNReal.toReal_nonneg)
        _ = (ENNReal.ofReal A *
              ENNReal.ofReal (r ^ (-sobolevExponent d p))) *
              ENNReal.ofReal (g s).toReal *
              ENNReal.ofReal
                ((brrsDyadicStationaryPhaseProfile N j (t - r - s)).toReal +
                  (brrsDyadicStationaryPhaseProfile N j (t - r + s)).toReal +
                    (brrsDyadicStationaryPhaseProfile N j (t + r - s)).toReal +
                      (brrsDyadicStationaryPhaseProfile N j (t + r + s)).toReal) := by
          rw [ENNReal.ofReal_mul (mul_nonneg hA hrpow_nonneg),
            ENNReal.ofReal_mul hA]
        _ = ENNReal.ofReal A * (ENNReal.ofReal r) ^ (-sobolevExponent d p) *
              (ENNReal.ofReal (g s).toReal *
                ENNReal.ofReal
                  ((brrsDyadicStationaryPhaseProfile N j (t - r - s)).toReal +
                    (brrsDyadicStationaryPhaseProfile N j (t - r + s)).toReal +
                      (brrsDyadicStationaryPhaseProfile N j (t + r - s)).toReal +
                        (brrsDyadicStationaryPhaseProfile N j (t + r + s)).toReal)) := by
          rw [ENNReal.ofReal_rpow_of_pos hrpos]
          ring
    calc
      ENNReal.ofReal
          (r ^ (((d : Real) - 1) / p) *
            (‖brrsDyadicTwoRadiusEndpointIntegralSum Phi d j r s t‖ *
              (s ^ (d - 1) * ‖f (s • w)‖))) ≤
          ENNReal.ofReal
            (A * r ^ (-sobolevExponent d p) * (g s).toReal *
              ((brrsDyadicStationaryPhaseProfile N j (t - r - s)).toReal +
                (brrsDyadicStationaryPhaseProfile N j (t - r + s)).toReal +
                  (brrsDyadicStationaryPhaseProfile N j (t + r - s)).toReal +
                    (brrsDyadicStationaryPhaseProfile N j (t + r + s)).toReal)) :=
        ENNReal.ofReal_le_ofReal hreal
      _ = ENNReal.ofReal A * (ENNReal.ofReal r) ^ (-sobolevExponent d p) *
          (ENNReal.ofReal (g s).toReal *
            ENNReal.ofReal
              ((brrsDyadicStationaryPhaseProfile N j (t - r - s)).toReal +
                (brrsDyadicStationaryPhaseProfile N j (t - r + s)).toReal +
                  (brrsDyadicStationaryPhaseProfile N j (t + r - s)).toReal +
                    (brrsDyadicStationaryPhaseProfile N j (t + r + s)).toReal)) := hrewrite
      _ ≤ ENNReal.ofReal A * (ENNReal.ofReal r) ^ (-sobolevExponent d p) *
          (g s * P s) := by
        gcongr
        · exact ENNReal.ofReal_toReal_le
        exact hphase s
  let K : ENNReal := ENNReal.ofReal A *
    (ENNReal.ofReal r) ^ (-sobolevExponent d p)
  change brrsDyadicHighHighCompactEndpointRadialIntegral Phi d j p f w t r ≤
    K * brrsDyadicHighHighCompactFourPhaseProfileIntegral N j p f w t r
  unfold brrsDyadicHighHighCompactEndpointRadialIntegral
    brrsDyadicHighHighCompactFourPhaseProfileIntegral
  calc
    (∫⁻ s in brrsDyadicHighHighCompactSourceSet j,
      ENNReal.ofReal
        (r ^ (((d : Real) - 1) / p) *
          (‖brrsDyadicTwoRadiusEndpointIntegralSum Phi d j r s t‖ *
            (s ^ (d - 1) * ‖f (s • w)‖)))) ≤
        ∫⁻ s in brrsDyadicHighHighCompactSourceSet j, K * (g s * P s) := by
      apply setLIntegral_mono' (measurableSet_brrsDyadicHighHighCompactSourceSet j)
      intro s hs
      exact hpointENN s hs
    _ = K * ∫⁻ s in brrsDyadicHighHighCompactSourceSet j, g s * P s := by
      exact lintegral_const_mul K hGPmeas

/-- Enlarging the compact high--high source interval to the whole phase line
identifies its four literal stationary profiles with the four scalar
convolutions used by `brrsDyadicRadialEndpointFourPhaseBlock`. -/
theorem brrsDyadicHighHighCompactFourPhaseProfileIntegral_le_fourConvolutions
    {d : Nat} (N j : Nat) (p : Real)
    (f : BRRSSpace d → Complex) (hfm : Measurable f)
    (w : BRRSSpace d) (t r : Real) :
    brrsDyadicHighHighCompactFourPhaseProfileIntegral N j p f w t r ≤
      brrsOneDimProfileConvolution
          (brrsDyadicStationaryPhaseProfile N j)
          (brrsCompactHighHighSourceProfile p f w) (t - r) +
        brrsOneDimProfileConvolutionPlus
          (brrsDyadicStationaryPhaseProfile N j)
          (brrsCompactHighHighSourceProfile p f w) (t - r) +
          brrsOneDimProfileConvolution
            (brrsDyadicStationaryPhaseProfile N j)
            (brrsCompactHighHighSourceProfile p f w) (t + r) +
            brrsOneDimProfileConvolutionPlus
              (brrsDyadicStationaryPhaseProfile N j)
              (brrsCompactHighHighSourceProfile p f w) (t + r) := by
  let S : Set Real := brrsDyadicHighHighCompactSourceSet j
  let omega : Real → ENNReal := brrsDyadicStationaryPhaseProfile N j
  let g : Real → ENNReal := brrsCompactHighHighSourceProfile p f w
  have homega : Measurable omega := by
    dsimp only [omega]
    exact measurable_brrsDyadicStationaryPhaseProfile N j
  have hgmeas : Measurable g := by
    dsimp only [g]
    exact measurable_brrsCompactHighHighSourceProfile p f hfm w
  have hminus₁ : Measurable (fun s : Real => g s * omega (t - r - s)) :=
    hgmeas.mul (homega.comp (measurable_const.sub measurable_id))
  have hplus₁ : Measurable (fun s : Real => g s * omega (t - r + s)) :=
    hgmeas.mul (homega.comp (measurable_const.add measurable_id))
  have hminus₂ : Measurable (fun s : Real => g s * omega (t + r - s)) :=
    hgmeas.mul (homega.comp (measurable_const.sub measurable_id))
  have hplus₂ : Measurable (fun s : Real => g s * omega (t + r + s)) :=
    hgmeas.mul (homega.comp (measurable_const.add measurable_id))
  have hminus (x : Real) :
      (∫⁻ s in S, g s * omega (x - s)) ≤
        brrsOneDimProfileConvolution omega g x := by
    calc
      (∫⁻ s in S, g s * omega (x - s)) ≤ ∫⁻ s : Real, g s * omega (x - s) :=
        setLIntegral_le_lintegral S _
      _ = ∫⁻ s : Real, omega (x - s) * g s := by
        apply lintegral_congr
        intro s
        ring
      _ = brrsOneDimProfileConvolution omega g x := rfl
  have hplus (x : Real) :
      (∫⁻ s in S, g s * omega (x + s)) ≤
        brrsOneDimProfileConvolutionPlus omega g x := by
    calc
      (∫⁻ s in S, g s * omega (x + s)) ≤ ∫⁻ s : Real, g s * omega (x + s) :=
        setLIntegral_le_lintegral S _
      _ = ∫⁻ s : Real, omega (x + s) * g s := by
        apply lintegral_congr
        intro s
        ring
      _ = brrsOneDimProfileConvolutionPlus omega g x := rfl
  change
    (∫⁻ s in S,
      g s * (omega (t - r - s) + omega (t - r + s) +
        omega (t + r - s) + omega (t + r + s))) ≤
      brrsOneDimProfileConvolution omega g (t - r) +
        brrsOneDimProfileConvolutionPlus omega g (t - r) +
          brrsOneDimProfileConvolution omega g (t + r) +
            brrsOneDimProfileConvolutionPlus omega g (t + r)
  have hsplit₁₂ :
      (∫⁻ s in S, g s * omega (t - r - s) + g s * omega (t - r + s)) =
        (∫⁻ s in S, g s * omega (t - r - s)) +
          ∫⁻ s in S, g s * omega (t - r + s) := by
    simpa only [Pi.add_apply] using
      (lintegral_add_left (μ := volume.restrict S) hminus₁
        (fun s : Real => g s * omega (t - r + s)))
  have hsplit₃₄ :
      (∫⁻ s in S, g s * omega (t + r - s) + g s * omega (t + r + s)) =
        (∫⁻ s in S, g s * omega (t + r - s)) +
          ∫⁻ s in S, g s * omega (t + r + s) := by
    simpa only [Pi.add_apply] using
      (lintegral_add_left (μ := volume.restrict S) hminus₂
        (fun s : Real => g s * omega (t + r + s)))
  calc
    (∫⁻ s in S,
      g s * (omega (t - r - s) + omega (t - r + s) +
        omega (t + r - s) + omega (t + r + s))) =
        ∫⁻ s in S,
          g s * omega (t - r - s) + g s * omega (t - r + s) +
            g s * omega (t + r - s) + g s * omega (t + r + s) := by
      apply lintegral_congr
      intro s
      ring
    _ = (∫⁻ s in S,
          (g s * omega (t - r - s) + g s * omega (t - r + s)) +
            (g s * omega (t + r - s) + g s * omega (t + r + s))) := by
      apply lintegral_congr
      intro s
      ring
    _ = (∫⁻ s in S,
          g s * omega (t - r - s) + g s * omega (t - r + s)) +
          ∫⁻ s in S,
            g s * omega (t + r - s) + g s * omega (t + r + s) := by
      simpa only [Pi.add_apply] using
        (lintegral_add_left (μ := volume.restrict S) (hminus₁.add hplus₁)
          (fun s : Real => g s * omega (t + r - s) + g s * omega (t + r + s)))
    _ = (∫⁻ s in S, g s * omega (t - r - s)) +
          (∫⁻ s in S, g s * omega (t - r + s)) +
            (∫⁻ s in S, g s * omega (t + r - s)) +
              (∫⁻ s in S, g s * omega (t + r + s)) := by
      rw [hsplit₁₂, hsplit₃₄]
      ring
    _ ≤ brrsOneDimProfileConvolution omega g (t - r) +
          brrsOneDimProfileConvolutionPlus omega g (t - r) +
            brrsOneDimProfileConvolution omega g (t + r) +
              brrsOneDimProfileConvolutionPlus omega g (t + r) := by
      gcongr
      · convert hminus (t - r) using 1
      · convert hplus (t - r) using 1
      · convert hminus (t + r) using 1
      · convert hplus (t + r) using 1

/-- The four-term convexity estimate used when the four endpoint phase
majorants are raised to a power. Keeping the two binary factors explicit
avoids hiding any dependence on `p`. -/
theorem brrs_four_rpow_le_two_rpow_sq_mul_sum
    (a b c d : ENNReal) {p : Real} (hp : 1 ≤ p) :
    (a + b + c + d) ^ p ≤
      ((2 : ENNReal) ^ (p - 1) * (2 : ENNReal) ^ (p - 1)) *
        (a ^ p + b ^ p + c ^ p + d ^ p) := by
  have hab := ENNReal.rpow_add_le_mul_rpow_add_rpow a b hp
  have hcd := ENNReal.rpow_add_le_mul_rpow_add_rpow c d hp
  have habcd := ENNReal.rpow_add_le_mul_rpow_add_rpow (a + b) (c + d) hp
  calc
    (a + b + c + d) ^ p = ((a + b) + (c + d)) ^ p := by ring
    _ ≤ (2 : ENNReal) ^ (p - 1) * ((a + b) ^ p + (c + d) ^ p) := habcd
    _ ≤ (2 : ENNReal) ^ (p - 1) *
          ((2 : ENNReal) ^ (p - 1) * (a ^ p + b ^ p) +
            (2 : ENNReal) ^ (p - 1) * (c ^ p + d ^ p)) :=
      by simpa only [mul_comm] using
        (mul_le_mul_left (add_le_add hab hcd) ((2 : ENNReal) ^ (p - 1)))
    _ = ((2 : ENNReal) ^ (p - 1) * (2 : ENNReal) ^ (p - 1)) *
          (a ^ p + b ^ p + c ^ p + d ^ p) := by ring

/-- The high--high portion of the `m`-th radial output block. It is the
ordinary dyadic block intersected with the radius condition needed by the
literal stationary endpoint estimate. -/
noncomputable def brrsDyadicHighHighCompactOutputSet (j m : Nat) : Set Real :=
  Icc
    (max (brrsDyadicRadialBlockRadius j m : Real) (16 / ((2 : Real) ^ j)))
    (2 * (brrsDyadicRadialBlockRadius j m : Real))

theorem measurableSet_brrsDyadicHighHighCompactOutputSet (j m : Nat) :
    MeasurableSet (brrsDyadicHighHighCompactOutputSet j m) := by
  unfold brrsDyadicHighHighCompactOutputSet
  exact measurableSet_Icc

/-- The high--high compact output region is contained in its ambient dyadic
radial block. -/
theorem brrsDyadicHighHighCompactOutputSet_subset_block (j m : Nat) :
    brrsDyadicHighHighCompactOutputSet j m ⊆
      Icc (brrsDyadicRadialBlockRadius j m : Real)
        (2 * (brrsDyadicRadialBlockRadius j m : Real)) := by
  intro r hr
  unfold brrsDyadicHighHighCompactOutputSet at hr
  exact ⟨le_trans (le_max_left _ _) hr.1, hr.2⟩

/-- Every radius in the preceding region satisfies the scaled high--high
condition used by the actual compact endpoint kernel bound. -/
theorem brrsDyadicHighHighCompactOutputSet_high
    (j m : Nat) {r : Real} (hr : r ∈ brrsDyadicHighHighCompactOutputSet j m) :
    16 ≤ ((2 : Real) ^ j) * r := by
  unfold brrsDyadicHighHighCompactOutputSet at hr
  have hq : 0 < (2 : Real) ^ j := by positivity
  have hlow : 16 / ((2 : Real) ^ j) ≤ r :=
    le_trans (le_max_right _ _) hr.1
  calc
    16 = (16 / ((2 : Real) ^ j)) * ((2 : Real) ^ j) := by
      field_simp [hq.ne']
    _ ≤ r * ((2 : Real) ^ j) :=
      mul_le_mul_of_nonneg_right hlow hq.le
    _ = ((2 : Real) ^ j) * r := by ring

/-- The literal `p`-moment of the compact high--high endpoint source integral
on one dyadic radial output block. It retains the actual two-radius kernel,
while restricting only to output radii where the high--high estimate applies. -/
noncomputable def brrsDyadicHighHighCompactEndpointRadialBlockMoment
    (Phi : BRRSAnnularCutoff) (d j m : Nat) (p : Real)
    (T : Finset Real) (f : BRRSSpace d → Complex) (w : BRRSSpace d) : ENNReal :=
  ∑ t ∈ T, ∫⁻ r in brrsDyadicHighHighCompactOutputSet j m,
    (brrsDyadicHighHighCompactEndpointRadialIntegral Phi d j p f w t r) ^ p

/-- The corresponding scalar four-phase `p`-moment on the same high--high
output region. The weight is exactly the `p`-th power of the radial Sobolev
decay in the literal endpoint estimate. -/
noncomputable def brrsDyadicHighHighCompactFourPhaseMomentBlock
    {d : Nat} (N j m : Nat) (p : Real) (T : Finset Real)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) : ENNReal :=
  ∑ t ∈ T, ∫⁻ r in brrsDyadicHighHighCompactOutputSet j m,
    (ENNReal.ofReal r) ^ (-(p * sobolevExponent d p)) *
      ((brrsOneDimProfileConvolution
          (brrsDyadicStationaryPhaseProfile N j)
          (brrsCompactHighHighSourceProfile p f w) (t - r)) ^ p +
        (brrsOneDimProfileConvolutionPlus
          (brrsDyadicStationaryPhaseProfile N j)
          (brrsCompactHighHighSourceProfile p f w) (t - r)) ^ p +
          (brrsOneDimProfileConvolution
            (brrsDyadicStationaryPhaseProfile N j)
            (brrsCompactHighHighSourceProfile p f w) (t + r)) ^ p +
            (brrsOneDimProfileConvolutionPlus
              (brrsDyadicStationaryPhaseProfile N j)
              (brrsCompactHighHighSourceProfile p f w) (t + r)) ^ p)

/-- The scalar high--high moment block is dominated by the existing full
four-phase dyadic block. This is only an enlargement of the output-radius
integration set, together with explicit distribution over the four phases. -/
theorem brrsDyadicHighHighCompactFourPhaseMomentBlock_le_fourPhaseBlock
    {d : Nat} (N j m : Nat) (p : Real) (T : Finset Real)
    (f : BRRSSpace d → Complex) (hfm : Measurable f) (w : BRRSSpace d) :
    brrsDyadicHighHighCompactFourPhaseMomentBlock N j m p T f w ≤
      brrsDyadicRadialEndpointFourPhaseBlock T j m p
        (fun r : Real => (ENNReal.ofReal r) ^ (-(p * sobolevExponent d p)))
        (brrsDyadicStationaryPhaseProfile N j)
        (brrsCompactHighHighSourceProfile p f w) := by
  let H : Set Real := brrsDyadicHighHighCompactOutputSet j m
  let B : Set Real := Icc (brrsDyadicRadialBlockRadius j m : Real)
    (2 * (brrsDyadicRadialBlockRadius j m : Real))
  let W : Real → ENNReal := fun r : Real =>
    (ENNReal.ofReal r) ^ (-(p * sobolevExponent d p))
  let omega : Real → ENNReal := brrsDyadicStationaryPhaseProfile N j
  let g : Real → ENNReal := brrsCompactHighHighSourceProfile p f w
  have hHB : H ⊆ B := by
    dsimp only [H, B]
    exact brrsDyadicHighHighCompactOutputSet_subset_block j m
  have hW : Measurable W := by
    dsimp only [W]
    exact ENNReal.continuous_rpow_const.measurable.comp
      ENNReal.continuous_ofReal.measurable
  have homega : Measurable omega := by
    dsimp only [omega]
    exact measurable_brrsDyadicStationaryPhaseProfile N j
  have hg : Measurable g := by
    dsimp only [g]
    exact measurable_brrsCompactHighHighSourceProfile p f hfm w
  have hconv : Measurable (brrsOneDimProfileConvolution omega g) :=
    measurable_brrsOneDimProfileConvolution homega hg
  have hconvPlus : Measurable (brrsOneDimProfileConvolutionPlus omega g) :=
    measurable_brrsOneDimProfileConvolutionPlus homega hg
  have hsub : ∀ t : Real, Measurable (fun r : Real =>
      W r * (brrsOneDimProfileConvolution omega g (t - r)) ^ p) := by
    intro t
    exact hW.mul (ENNReal.continuous_rpow_const.measurable.comp
      (hconv.comp (measurable_const.sub measurable_id)))
  have hsubPlus : ∀ t : Real, Measurable (fun r : Real =>
      W r * (brrsOneDimProfileConvolutionPlus omega g (t - r)) ^ p) := by
    intro t
    exact hW.mul (ENNReal.continuous_rpow_const.measurable.comp
      (hconvPlus.comp (measurable_const.sub measurable_id)))
  have hadd : ∀ t : Real, Measurable (fun r : Real =>
      W r * (brrsOneDimProfileConvolution omega g (t + r)) ^ p) := by
    intro t
    exact hW.mul (ENNReal.continuous_rpow_const.measurable.comp
      (hconv.comp (measurable_const.add measurable_id)))
  have haddPlus : ∀ t : Real, Measurable (fun r : Real =>
      W r * (brrsOneDimProfileConvolutionPlus omega g (t + r)) ^ p) := by
    intro t
    exact hW.mul (ENNReal.continuous_rpow_const.measurable.comp
      (hconvPlus.comp (measurable_const.add measurable_id)))
  have hper (t : Real) :
      (∫⁻ r in H,
        W r * ((brrsOneDimProfileConvolution omega g (t - r)) ^ p +
          (brrsOneDimProfileConvolutionPlus omega g (t - r)) ^ p +
            (brrsOneDimProfileConvolution omega g (t + r)) ^ p +
              (brrsOneDimProfileConvolutionPlus omega g (t + r)) ^ p)) ≤
        (∫⁻ r in B, W r * (brrsOneDimProfileConvolution omega g (t - r)) ^ p) +
          (∫⁻ r in B, W r * (brrsOneDimProfileConvolutionPlus omega g (t - r)) ^ p) +
            (∫⁻ r in B, W r * (brrsOneDimProfileConvolution omega g (t + r)) ^ p) +
              (∫⁻ r in B, W r * (brrsOneDimProfileConvolutionPlus omega g (t + r)) ^ p) := by
    let a : Real → ENNReal := fun r =>
      W r * (brrsOneDimProfileConvolution omega g (t - r)) ^ p
    let b : Real → ENNReal := fun r =>
      W r * (brrsOneDimProfileConvolutionPlus omega g (t - r)) ^ p
    let c : Real → ENNReal := fun r =>
      W r * (brrsOneDimProfileConvolution omega g (t + r)) ^ p
    let d' : Real → ENNReal := fun r =>
      W r * (brrsOneDimProfileConvolutionPlus omega g (t + r)) ^ p
    have ha : Measurable a := by simpa only [a] using hsub t
    have hb : Measurable b := by simpa only [b] using hsubPlus t
    have hc : Measurable c := by simpa only [c] using hadd t
    have hd' : Measurable d' := by simpa only [d'] using haddPlus t
    have hsplitH :
        (∫⁻ r in H, a r + b r + c r + d' r) =
          (∫⁻ r in H, a r) + (∫⁻ r in H, b r) +
            (∫⁻ r in H, c r) + (∫⁻ r in H, d' r) := by
      calc
        (∫⁻ r in H, a r + b r + c r + d' r) =
            ∫⁻ r in H, (a r + b r) + (c r + d' r) := by
          apply lintegral_congr
          intro r
          ring
        _ = (∫⁻ r in H, a r + b r) + ∫⁻ r in H, c r + d' r := by
          simpa only [Pi.add_apply] using
            (lintegral_add_left (μ := volume.restrict H) (ha.add hb)
              (fun r : Real => c r + d' r))
        _ = (∫⁻ r in H, a r) + (∫⁻ r in H, b r) +
              (∫⁻ r in H, c r) + (∫⁻ r in H, d' r) := by
          rw [show (∫⁻ r in H, a r + b r) =
              (∫⁻ r in H, a r) + ∫⁻ r in H, b r by
                simpa only [Pi.add_apply] using
                  (lintegral_add_left (μ := volume.restrict H) ha b),
            show (∫⁻ r in H, c r + d' r) =
              (∫⁻ r in H, c r) + ∫⁻ r in H, d' r by
                simpa only [Pi.add_apply] using
                  (lintegral_add_left (μ := volume.restrict H) hc d')]
          ring
    have hsplitB :
        (∫⁻ r in B, a r + b r + c r + d' r) =
          (∫⁻ r in B, a r) + (∫⁻ r in B, b r) +
            (∫⁻ r in B, c r) + (∫⁻ r in B, d' r) := by
      calc
        (∫⁻ r in B, a r + b r + c r + d' r) =
            ∫⁻ r in B, (a r + b r) + (c r + d' r) := by
          apply lintegral_congr
          intro r
          ring
        _ = (∫⁻ r in B, a r + b r) + ∫⁻ r in B, c r + d' r := by
          simpa only [Pi.add_apply] using
            (lintegral_add_left (μ := volume.restrict B) (ha.add hb)
              (fun r : Real => c r + d' r))
        _ = (∫⁻ r in B, a r) + (∫⁻ r in B, b r) +
              (∫⁻ r in B, c r) + (∫⁻ r in B, d' r) := by
          rw [show (∫⁻ r in B, a r + b r) =
              (∫⁻ r in B, a r) + ∫⁻ r in B, b r by
                simpa only [Pi.add_apply] using
                  (lintegral_add_left (μ := volume.restrict B) ha b),
            show (∫⁻ r in B, c r + d' r) =
              (∫⁻ r in B, c r) + ∫⁻ r in B, d' r by
                simpa only [Pi.add_apply] using
                  (lintegral_add_left (μ := volume.restrict B) hc d')]
          ring
    have hdistribH :
        (∫⁻ r in H,
          W r * ((brrsOneDimProfileConvolution omega g (t - r)) ^ p +
            (brrsOneDimProfileConvolutionPlus omega g (t - r)) ^ p +
              (brrsOneDimProfileConvolution omega g (t + r)) ^ p +
                (brrsOneDimProfileConvolutionPlus omega g (t + r)) ^ p)) =
          ∫⁻ r in H, a r + b r + c r + d' r := by
      apply lintegral_congr
      intro r
      dsimp only [a, b, c, d']
      ring
    calc
      (∫⁻ r in H,
        W r * ((brrsOneDimProfileConvolution omega g (t - r)) ^ p +
          (brrsOneDimProfileConvolutionPlus omega g (t - r)) ^ p +
            (brrsOneDimProfileConvolution omega g (t + r)) ^ p +
              (brrsOneDimProfileConvolutionPlus omega g (t + r)) ^ p)) =
          ∫⁻ r in H, a r + b r + c r + d' r := hdistribH
      _ = (∫⁻ r in H, a r) + (∫⁻ r in H, b r) +
            (∫⁻ r in H, c r) + (∫⁻ r in H, d' r) := hsplitH
      _ ≤ (∫⁻ r in B, a r) + (∫⁻ r in B, b r) +
            (∫⁻ r in B, c r) + (∫⁻ r in B, d' r) := by
        gcongr
  unfold brrsDyadicHighHighCompactFourPhaseMomentBlock
    brrsDyadicRadialEndpointFourPhaseBlock
    brrsDyadicRadialBlockAdd brrsDyadicRadialBlockSub
    brrsDyadicRadialBlockAddPlus brrsDyadicRadialBlockSubPlus
  change (∑ t ∈ T, ∫⁻ r in H,
    W r * ((brrsOneDimProfileConvolution omega g (t - r)) ^ p +
      (brrsOneDimProfileConvolutionPlus omega g (t - r)) ^ p +
        (brrsOneDimProfileConvolution omega g (t + r)) ^ p +
          (brrsOneDimProfileConvolutionPlus omega g (t + r)) ^ p)) ≤
    (∑ t ∈ T, ∫⁻ r in B, W r *
      (brrsOneDimProfileConvolution omega g (t + r)) ^ p) +
      (∑ t ∈ T, ∫⁻ r in B, W r *
        (brrsOneDimProfileConvolution omega g (t - r)) ^ p) +
        (∑ t ∈ T, ∫⁻ r in B, W r *
          (brrsOneDimProfileConvolutionPlus omega g (t + r)) ^ p) +
          ∑ t ∈ T, ∫⁻ r in B, W r *
            (brrsOneDimProfileConvolutionPlus omega g (t - r)) ^ p
  calc
    (∑ t ∈ T, ∫⁻ r in H,
      W r * ((brrsOneDimProfileConvolution omega g (t - r)) ^ p +
        (brrsOneDimProfileConvolutionPlus omega g (t - r)) ^ p +
          (brrsOneDimProfileConvolution omega g (t + r)) ^ p +
            (brrsOneDimProfileConvolutionPlus omega g (t + r)) ^ p)) ≤
        ∑ t ∈ T,
          ((∫⁻ r in B, W r * (brrsOneDimProfileConvolution omega g (t - r)) ^ p) +
            (∫⁻ r in B, W r * (brrsOneDimProfileConvolutionPlus omega g (t - r)) ^ p) +
              (∫⁻ r in B, W r * (brrsOneDimProfileConvolution omega g (t + r)) ^ p) +
                (∫⁻ r in B, W r *
                  (brrsOneDimProfileConvolutionPlus omega g (t + r)) ^ p)) := by
      apply Finset.sum_le_sum
      intro t ht
      exact hper t
    _ = (∑ t ∈ T, ∫⁻ r in B, W r *
          (brrsOneDimProfileConvolution omega g (t + r)) ^ p) +
        (∑ t ∈ T, ∫⁻ r in B, W r *
          (brrsOneDimProfileConvolution omega g (t - r)) ^ p) +
          (∑ t ∈ T, ∫⁻ r in B, W r *
            (brrsOneDimProfileConvolutionPlus omega g (t + r)) ^ p) +
            ∑ t ∈ T, ∫⁻ r in B, W r *
              (brrsOneDimProfileConvolutionPlus omega g (t - r)) ^ p := by
      rw [Finset.sum_add_distrib, Finset.sum_add_distrib,
        Finset.sum_add_distrib]
      ring

/-- After taking a `p`-th power, the literal compact high--high endpoint
source integral is bounded by the four scalar convolution moments with the
precise radial Sobolev weight. -/
theorem exists_brrsDyadicHighHighCompactEndpointRadialIntegral_rpow_le_fourPhase
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r t p : Real,
      ∀ f : BRRSSpace d → Complex, ∀ w : BRRSSpace d,
      Measurable f → 2 ≤ p → 16 ≤ ((2 : Real) ^ j) * r →
      (brrsDyadicHighHighCompactEndpointRadialIntegral Phi d j p f w t r) ^ p ≤
        (ENNReal.ofReal ((1 - (1 / 32 : Real)) * C * 16 ^ ((d : Real) - 1))) ^ p *
          ((2 : ENNReal) ^ (p - 1) * (2 : ENNReal) ^ (p - 1)) *
            (ENNReal.ofReal r) ^ (-(p * sobolevExponent d p)) *
              ((brrsOneDimProfileConvolution
                  (brrsDyadicStationaryPhaseProfile N j)
                  (brrsCompactHighHighSourceProfile p f w) (t - r)) ^ p +
                (brrsOneDimProfileConvolutionPlus
                  (brrsDyadicStationaryPhaseProfile N j)
                  (brrsCompactHighHighSourceProfile p f w) (t - r)) ^ p +
                  (brrsOneDimProfileConvolution
                    (brrsDyadicStationaryPhaseProfile N j)
                    (brrsCompactHighHighSourceProfile p f w) (t + r)) ^ p +
                    (brrsOneDimProfileConvolutionPlus
                      (brrsDyadicStationaryPhaseProfile N j)
                      (brrsCompactHighHighSourceProfile p f w) (t + r)) ^ p) := by
  obtain ⟨C, hC, hkernel⟩ :=
    exists_brrsDyadicHighHighCompactEndpointRadialIntegral_le_fourPhaseProfile
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j r t p f w hfm hp hr
  let A : ENNReal :=
    ENNReal.ofReal ((1 - (1 / 32 : Real)) * C * 16 ^ ((d : Real) - 1))
  let B : ENNReal := (ENNReal.ofReal r) ^ (-sobolevExponent d p)
  let Q : ENNReal :=
    brrsOneDimProfileConvolution
        (brrsDyadicStationaryPhaseProfile N j)
        (brrsCompactHighHighSourceProfile p f w) (t - r) +
      brrsOneDimProfileConvolutionPlus
        (brrsDyadicStationaryPhaseProfile N j)
        (brrsCompactHighHighSourceProfile p f w) (t - r) +
        brrsOneDimProfileConvolution
          (brrsDyadicStationaryPhaseProfile N j)
          (brrsCompactHighHighSourceProfile p f w) (t + r) +
          brrsOneDimProfileConvolutionPlus
            (brrsDyadicStationaryPhaseProfile N j)
            (brrsCompactHighHighSourceProfile p f w) (t + r)
  have hbase :
      brrsDyadicHighHighCompactEndpointRadialIntegral Phi d j p f w t r ≤ A * B *
        brrsDyadicHighHighCompactFourPhaseProfileIntegral N j p f w t r := by
    simpa only [A, B] using hkernel j r t p f w hfm hp hr
  have hprofile : brrsDyadicHighHighCompactFourPhaseProfileIntegral N j p f w t r ≤ Q := by
    simpa only [Q] using
      brrsDyadicHighHighCompactFourPhaseProfileIntegral_le_fourConvolutions
        N j p f hfm w t r
  have hpoint :
      brrsDyadicHighHighCompactEndpointRadialIntegral Phi d j p f w t r ≤ A * B * Q :=
    hbase.trans (by gcongr)
  have hp0 : 0 ≤ p := le_trans (by norm_num) hp
  have hpow := ENNReal.rpow_le_rpow hpoint hp0
  have hBpow : B ^ p = (ENNReal.ofReal r) ^ (-(p * sobolevExponent d p)) := by
    dsimp only [B]
    rw [← ENNReal.rpow_mul]
    congr 1
    ring
  calc
    (brrsDyadicHighHighCompactEndpointRadialIntegral Phi d j p f w t r) ^ p ≤
        (A * B * Q) ^ p := hpow
    _ = A ^ p * (ENNReal.ofReal r) ^ (-(p * sobolevExponent d p)) * Q ^ p := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ hp0,
        ENNReal.mul_rpow_of_nonneg _ _ hp0, hBpow]
    _ ≤ A ^ p * (ENNReal.ofReal r) ^ (-(p * sobolevExponent d p)) *
          (((2 : ENNReal) ^ (p - 1) * (2 : ENNReal) ^ (p - 1)) *
            ((brrsOneDimProfileConvolution
                (brrsDyadicStationaryPhaseProfile N j)
                (brrsCompactHighHighSourceProfile p f w) (t - r)) ^ p +
              (brrsOneDimProfileConvolutionPlus
                (brrsDyadicStationaryPhaseProfile N j)
                (brrsCompactHighHighSourceProfile p f w) (t - r)) ^ p +
                (brrsOneDimProfileConvolution
                  (brrsDyadicStationaryPhaseProfile N j)
                  (brrsCompactHighHighSourceProfile p f w) (t + r)) ^ p +
                  (brrsOneDimProfileConvolutionPlus
                    (brrsDyadicStationaryPhaseProfile N j)
                    (brrsCompactHighHighSourceProfile p f w) (t + r)) ^ p)) := by
      gcongr
      simpa only [Q] using
        brrs_four_rpow_le_two_rpow_sq_mul_sum
          (brrsOneDimProfileConvolution
            (brrsDyadicStationaryPhaseProfile N j)
            (brrsCompactHighHighSourceProfile p f w) (t - r))
          (brrsOneDimProfileConvolutionPlus
            (brrsDyadicStationaryPhaseProfile N j)
            (brrsCompactHighHighSourceProfile p f w) (t - r))
          (brrsOneDimProfileConvolution
            (brrsDyadicStationaryPhaseProfile N j)
            (brrsCompactHighHighSourceProfile p f w) (t + r))
          (brrsOneDimProfileConvolutionPlus
            (brrsDyadicStationaryPhaseProfile N j)
            (brrsCompactHighHighSourceProfile p f w) (t + r))
          (le_trans (by norm_num) hp)
    _ = A ^ p * ((2 : ENNReal) ^ (p - 1) * (2 : ENNReal) ^ (p - 1)) *
          (ENNReal.ofReal r) ^ (-(p * sobolevExponent d p)) *
            ((brrsOneDimProfileConvolution
                (brrsDyadicStationaryPhaseProfile N j)
                (brrsCompactHighHighSourceProfile p f w) (t - r)) ^ p +
              (brrsOneDimProfileConvolutionPlus
                (brrsDyadicStationaryPhaseProfile N j)
                (brrsCompactHighHighSourceProfile p f w) (t - r)) ^ p +
                (brrsOneDimProfileConvolution
                  (brrsDyadicStationaryPhaseProfile N j)
                  (brrsCompactHighHighSourceProfile p f w) (t + r)) ^ p +
                  (brrsOneDimProfileConvolutionPlus
                    (brrsDyadicStationaryPhaseProfile N j)
                    (brrsCompactHighHighSourceProfile p f w) (t + r)) ^ p) := by
      ring

/-- The actual compact high--high dyadic output-block `p`-moment is controlled
by the existing four-phase BRRS block. The left hand side still uses the
literal two-radius endpoint kernel, and the output region is exactly the
high--high portion of the named dyadic radial block. -/
theorem exists_brrsDyadicHighHighCompactEndpointRadialBlockMoment_le_fourPhaseBlock
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j m : Nat, ∀ p : Real, ∀ T : Finset Real,
      ∀ f : BRRSSpace d → Complex, ∀ w : BRRSSpace d,
      Measurable f → 2 ≤ p →
      brrsDyadicHighHighCompactEndpointRadialBlockMoment Phi d j m p T f w ≤
        (ENNReal.ofReal ((1 - (1 / 32 : Real)) * C * 16 ^ ((d : Real) - 1))) ^ p *
          ((2 : ENNReal) ^ (p - 1) * (2 : ENNReal) ^ (p - 1)) *
            brrsDyadicRadialEndpointFourPhaseBlock T j m p
              (fun r : Real => (ENNReal.ofReal r) ^ (-(p * sobolevExponent d p)))
              (brrsDyadicStationaryPhaseProfile N j)
              (brrsCompactHighHighSourceProfile p f w) := by
  obtain ⟨C, hC, hpoint⟩ :=
    exists_brrsDyadicHighHighCompactEndpointRadialIntegral_rpow_le_fourPhase
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j m p T f w hfm hp
  let A : ENNReal :=
    ENNReal.ofReal ((1 - (1 / 32 : Real)) * C * 16 ^ ((d : Real) - 1))
  let D : ENNReal := (2 : ENNReal) ^ (p - 1) * (2 : ENNReal) ^ (p - 1)
  let K : ENNReal := A ^ p * D
  let H : Set Real := brrsDyadicHighHighCompactOutputSet j m
  let W : Real → ENNReal := fun r : Real =>
    (ENNReal.ofReal r) ^ (-(p * sobolevExponent d p))
  let omega : Real → ENNReal := brrsDyadicStationaryPhaseProfile N j
  let g : Real → ENNReal := brrsCompactHighHighSourceProfile p f w
  let F : Real → Real → ENNReal := fun t r =>
    W r * ((brrsOneDimProfileConvolution omega g (t - r)) ^ p +
      (brrsOneDimProfileConvolutionPlus omega g (t - r)) ^ p +
        (brrsOneDimProfileConvolution omega g (t + r)) ^ p +
          (brrsOneDimProfileConvolutionPlus omega g (t + r)) ^ p)
  have hW : Measurable W := by
    dsimp only [W]
    exact ENNReal.continuous_rpow_const.measurable.comp
      ENNReal.continuous_ofReal.measurable
  have homega : Measurable omega := by
    dsimp only [omega]
    exact measurable_brrsDyadicStationaryPhaseProfile N j
  have hg : Measurable g := by
    dsimp only [g]
    exact measurable_brrsCompactHighHighSourceProfile p f hfm w
  have hconv : Measurable (brrsOneDimProfileConvolution omega g) :=
    measurable_brrsOneDimProfileConvolution homega hg
  have hconvPlus : Measurable (brrsOneDimProfileConvolutionPlus omega g) :=
    measurable_brrsOneDimProfileConvolutionPlus homega hg
  have hFmeas (t : Real) : Measurable (F t) := by
    dsimp only [F]
    apply hW.mul
    exact (((ENNReal.continuous_rpow_const.measurable.comp
      (hconv.comp (measurable_const.sub measurable_id))).add
        (ENNReal.continuous_rpow_const.measurable.comp
          (hconvPlus.comp (measurable_const.sub measurable_id)))).add
          (ENNReal.continuous_rpow_const.measurable.comp
            (hconv.comp (measurable_const.add measurable_id)))).add
              (ENNReal.continuous_rpow_const.measurable.comp
                (hconvPlus.comp (measurable_const.add measurable_id)))
  have hpoint' (t r : Real) (hr : r ∈ H) :
      (brrsDyadicHighHighCompactEndpointRadialIntegral Phi d j p f w t r) ^ p ≤
        K * F t r := by
    have hhigh : 16 ≤ ((2 : Real) ^ j) * r := by
      dsimp only [H] at hr
      exact brrsDyadicHighHighCompactOutputSet_high j m hr
    calc
      (brrsDyadicHighHighCompactEndpointRadialIntegral Phi d j p f w t r) ^ p ≤
          A ^ p * D * W r *
            ((brrsOneDimProfileConvolution omega g (t - r)) ^ p +
              (brrsOneDimProfileConvolutionPlus omega g (t - r)) ^ p +
                (brrsOneDimProfileConvolution omega g (t + r)) ^ p +
                  (brrsOneDimProfileConvolutionPlus omega g (t + r)) ^ p) := by
        simpa only [A, D, W, omega, g] using hpoint j r t p f w hfm hp hhigh
      _ = K * F t r := by
        dsimp only [K, F]
        ring
  have hmoment :
      brrsDyadicHighHighCompactEndpointRadialBlockMoment Phi d j m p T f w ≤
        K * brrsDyadicHighHighCompactFourPhaseMomentBlock N j m p T f w := by
    unfold brrsDyadicHighHighCompactEndpointRadialBlockMoment
      brrsDyadicHighHighCompactFourPhaseMomentBlock
    change (∑ t ∈ T, ∫⁻ r in H,
      (brrsDyadicHighHighCompactEndpointRadialIntegral Phi d j p f w t r) ^ p) ≤
        K * ∑ t ∈ T, ∫⁻ r in H, F t r
    calc
      (∑ t ∈ T, ∫⁻ r in H,
        (brrsDyadicHighHighCompactEndpointRadialIntegral Phi d j p f w t r) ^ p) ≤
          ∑ t ∈ T, ∫⁻ r in H, K * F t r := by
        apply Finset.sum_le_sum
        intro t ht
        apply setLIntegral_mono'
          (measurableSet_brrsDyadicHighHighCompactOutputSet j m)
        intro r hr
        exact hpoint' t r (by simpa only [H] using hr)
      _ = ∑ t ∈ T, K * ∫⁻ r in H, F t r := by
        apply Finset.sum_congr rfl
        intro t ht
        exact lintegral_const_mul K (hFmeas t)
      _ = K * ∑ t ∈ T, ∫⁻ r in H, F t r := by
        rw [← Finset.mul_sum]
  have hscalar :=
    brrsDyadicHighHighCompactFourPhaseMomentBlock_le_fourPhaseBlock
      N j m p T f hfm w
  calc
    brrsDyadicHighHighCompactEndpointRadialBlockMoment Phi d j m p T f w ≤
        K * brrsDyadicHighHighCompactFourPhaseMomentBlock N j m p T f w := hmoment
    _ ≤ K * brrsDyadicRadialEndpointFourPhaseBlock T j m p W omega g := by
      simpa only [mul_comm] using
        (mul_le_mul_left hscalar K)
    _ = A ^ p * D * brrsDyadicRadialEndpointFourPhaseBlock T j m p
          (fun r : Real => (ENNReal.ofReal r) ^ (-(p * sobolevExponent d p)))
          (brrsDyadicStationaryPhaseProfile N j)
          (brrsCompactHighHighSourceProfile p f w) := by
      rfl

/-- The literal radial Sobolev weight is bounded by its value at the inner
edge of every named dyadic radial block.  This is the exact envelope needed
by the Section 5 four-phase summation theorem. -/
theorem brrsDyadicRadialBlock_weight_le_inner_edge
    {alpha : Real} (halpha : 0 ≤ alpha) (j m : Nat) {r : Real}
    (hr : r ∈ Icc (brrsDyadicRadialBlockRadius j m : Real)
      (2 * (brrsDyadicRadialBlockRadius j m : Real))) :
    (ENNReal.ofReal r) ^ (-alpha) ≤
      (brrsDyadicRadialBlockRadius j m : ENNReal) ^ (-alpha) := by
  have hbase : (brrsDyadicRadialBlockRadius j m : ENNReal) ≤ ENNReal.ofReal r := by
    simpa only [ENNReal.ofReal_coe_nnreal] using ENNReal.ofReal_le_ofReal hr.1
  rw [ENNReal.rpow_neg, ENNReal.rpow_neg]
  exact ENNReal.inv_le_inv.mpr (ENNReal.rpow_le_rpow hbase halpha)

/-- After the exact literal-to-four-phase reduction, the compact high--high
endpoint contribution obeys the BRRS dyadic entropy tail bound.  The left
side remains the actual two-radius kernel `p`-moment; no scalar model is
silently substituted for it. -/
theorem exists_tail_sum_brrsDyadicHighHighCompactEndpointRadialBlockMoment_le
    {E : Set Real} {d N : Nat} {p q : Real}
    (hd : 3 ≤ d) (hp : 2 ≤ p) (hN : 2 ≤ N)
    (hνq : brrsLegendreAssouadFunction E (p * sobolevExponent d p) < q)
    (Phi : BRRSAnnularCutoff) (f : BRRSSchwartz d)
    (hf : IsRadial (f : BRRSSpace d → Complex))
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    ∃ C : Real, 0 < C ∧ ∃ J : Nat, ∀ j ≥ J,
      ∀ T : Finset Real, IsDyadicDiscretization E j T →
        ENNReal.ofReal (surfaceMass d) *
          (∑ m ∈ Finset.range (j + 1),
            brrsDyadicHighHighCompactEndpointRadialBlockMoment Phi d j m p T
              (f : BRRSSpace d → Complex) w) ≤
          ((ENNReal.ofReal ((1 - (1 / 32 : Real)) * C *
              16 ^ ((d : Real) - 1))) ^ p *
            ((2 : ENNReal) ^ (p - 1) * (2 : ENNReal) ^ (p - 1))) *
            (28 * ((j + 1 : ENNReal) *
              ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) :
                ENNReal)⁻¹) ^ q) *
              ((∫⁻ u : Real, brrsDyadicStationaryPhaseProfile N j u) ^ p *
                (((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
                  (eLpNorm (f : BRRSSpace d → Complex)
                    (ENNReal.ofReal p) volume) ^ p))) := by
  obtain ⟨C, hC, hblock⟩ :=
    exists_brrsDyadicHighHighCompactEndpointRadialBlockMoment_le_fourPhaseBlock
      (d := d) (N := N) hd Phi
  obtain ⟨J, htail⟩ :=
    exists_tail_sum_brrsDyadicHighHigh_compactSource_fourPhaseBlock_surfaceMass_le
      (E := E) (d := d) (N := N) (p := p) (q := q) hd hp hN hνq f hf w hw
  refine ⟨C, hC, J, ?_⟩
  intro j hj T hT
  let K : ENNReal :=
    (ENNReal.ofReal ((1 - (1 / 32 : Real)) * C * 16 ^ ((d : Real) - 1))) ^ p *
      ((2 : ENNReal) ^ (p - 1) * (2 : ENNReal) ^ (p - 1))
  let W : Real → ENNReal := fun r : Real =>
    (ENNReal.ofReal r) ^ (-(p * sobolevExponent d p))
  let B : ENNReal :=
    ∑ m ∈ Finset.range (j + 1),
      brrsDyadicRadialEndpointFourPhaseBlock T j m p W
        (brrsDyadicStationaryPhaseProfile N j)
        (brrsCompactHighHighSourceProfile p (f : BRRSSpace d → Complex) w)
  have hW : ∀ m : Nat, m ≤ j → ∀ r ∈
      Icc (brrsDyadicRadialBlockRadius j m : Real)
        (2 * (brrsDyadicRadialBlockRadius j m : Real)),
      W r ≤ (brrsDyadicRadialBlockRadius j m : ENNReal) ^
        (-(p * sobolevExponent d p)) := by
    intro m hm r hr
    exact brrsDyadicRadialBlock_weight_le_inner_edge
      (mul_sobolevExponent_nonneg (by omega) hp) j m hr
  have hscalar := htail j hj T hT W hW
  have hsum :
      (∑ m ∈ Finset.range (j + 1),
        brrsDyadicHighHighCompactEndpointRadialBlockMoment Phi d j m p T
          (f : BRRSSpace d → Complex) w) ≤ K * B := by
    calc
      (∑ m ∈ Finset.range (j + 1),
          brrsDyadicHighHighCompactEndpointRadialBlockMoment Phi d j m p T
            (f : BRRSSpace d → Complex) w) ≤
          ∑ m ∈ Finset.range (j + 1),
            K * brrsDyadicRadialEndpointFourPhaseBlock T j m p W
              (brrsDyadicStationaryPhaseProfile N j)
              (brrsCompactHighHighSourceProfile p
                (f : BRRSSpace d → Complex) w) := by
        apply Finset.sum_le_sum
        intro m hm
        exact hblock j m p T (f : BRRSSpace d → Complex) w
          f.continuous.measurable hp
      _ = K * B := by
        rw [← Finset.mul_sum]
  calc
    ENNReal.ofReal (surfaceMass d) *
        (∑ m ∈ Finset.range (j + 1),
          brrsDyadicHighHighCompactEndpointRadialBlockMoment Phi d j m p T
            (f : BRRSSpace d → Complex) w) ≤
        ENNReal.ofReal (surfaceMass d) * (K * B) :=
      mul_le_mul_right hsum (ENNReal.ofReal (surfaceMass d))
    _ = K * (ENNReal.ofReal (surfaceMass d) * B) := by ring
    _ ≤ K *
        (28 * ((j + 1 : ENNReal) *
          ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) :
            ENNReal)⁻¹) ^ q) *
          ((∫⁻ u : Real, brrsDyadicStationaryPhaseProfile N j u) ^ p *
            (((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
                (eLpNorm (f : BRRSSpace d → Complex)
                  (ENNReal.ofReal p) volume) ^ p))) := by
      exact mul_le_mul_right (by simpa only [B] using hscalar) K
    _ = ((ENNReal.ofReal ((1 - (1 / 32 : Real)) * C *
          16 ^ ((d : Real) - 1))) ^ p *
        ((2 : ENNReal) ^ (p - 1) * (2 : ENNReal) ^ (p - 1))) *
          (28 * ((j + 1 : ENNReal) *
            ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) :
              ENNReal)⁻¹) ^ q) *
            ((∫⁻ u : Real, brrsDyadicStationaryPhaseProfile N j u) ^ p *
              (((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
                (eLpNorm (f : BRRSSpace d → Complex)
                  (ENNReal.ofReal p) volume) ^ p))) := by
      rfl

/-- The fixed phase-line mass of the stationary profile.  The normalization
in `brrsDyadicStationaryPhaseProfile` makes this independent of the dyadic
frequency level.  Naming it here lets the literal high--high endpoint tail
estimate be used with a genuinely frequency-uniform analytic constant. -/
noncomputable def brrsStationaryPhaseLineMass (N : Nat) : ENNReal :=
  ∫⁻ v : Real, ENNReal.ofReal
    (brrsStationaryRapidProfile N (2 * Real.pi * v))

/-- The total mass of every dyadically normalized stationary phase profile
is the fixed phase-line mass. -/
theorem lintegral_brrsDyadicStationaryPhaseProfile_eq_phaseLineMass
    (N j : Nat) :
    (∫⁻ u : Real, brrsDyadicStationaryPhaseProfile N j u) =
      brrsStationaryPhaseLineMass N := by
  rw [lintegral_brrsDyadicStationaryPhaseProfile_eq]
  rfl

/-- Frequency-uniform form of the compact high--high endpoint tail.  This
keeps the actual two-radius kernel moment on the left, but replaces the
dyadic phase-profile mass on the right by the fixed level-zero mass.  It is
therefore the direct normalised input for the final `j`-rate and
epsilon-absorption step in the BRRS upper bound. -/
theorem exists_tail_sum_brrsDyadicHighHighCompactEndpointRadialBlockMoment_le_phaseLineMass
    {E : Set Real} {d N : Nat} {p q : Real}
    (hd : 3 ≤ d) (hp : 2 ≤ p) (hN : 2 ≤ N)
    (hνq : brrsLegendreAssouadFunction E (p * sobolevExponent d p) < q)
    (Phi : BRRSAnnularCutoff) (f : BRRSSchwartz d)
    (hf : IsRadial (f : BRRSSpace d → Complex))
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    ∃ C : Real, 0 < C ∧ ∃ J : Nat, ∀ j ≥ J,
      ∀ T : Finset Real, IsDyadicDiscretization E j T →
        ENNReal.ofReal (surfaceMass d) *
          (∑ m ∈ Finset.range (j + 1),
            brrsDyadicHighHighCompactEndpointRadialBlockMoment Phi d j m p T
              (f : BRRSSpace d → Complex) w) ≤
          ((ENNReal.ofReal ((1 - (1 / 32 : Real)) * C *
              16 ^ ((d : Real) - 1))) ^ p *
            ((2 : ENNReal) ^ (p - 1) * (2 : ENNReal) ^ (p - 1))) *
            (28 * ((j + 1 : ENNReal) *
              ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) :
                ENNReal)⁻¹) ^ q) *
              ((brrsStationaryPhaseLineMass N) ^ p *
                (((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
                  (eLpNorm (f : BRRSSpace d → Complex)
                    (ENNReal.ofReal p) volume) ^ p))) := by
  obtain ⟨C, hC, J, hJ⟩ :=
    exists_tail_sum_brrsDyadicHighHighCompactEndpointRadialBlockMoment_le
      (E := E) (d := d) (N := N) (p := p) (q := q)
      hd hp hN hνq Phi f hf w hw
  refine ⟨C, hC, J, ?_⟩
  intro j hj T hT
  have htail := hJ j hj T hT
  rw [lintegral_brrsDyadicStationaryPhaseProfile_eq_phaseLineMass] at htail
  exact htail

end

end Auto.Spherical.BRRS
