        (r ^ (((d : Real) - 1) / p) *
          (s ^ (d - 1) * ‖f (s • w)‖)) *
          ‖brrsDyadicTwoRadiusEndpointIntegralSum Phi d j r s t‖ := by ring
    _ ≤ (r ^ (((d : Real) - 1) / p) *
