  induction n with
  | zero => norm_num [brrsOddQuadraticLeadingCoefficient]
  | succ n ih =>
      rw [brrsOddQuadraticLeadingCoefficient_succ]
      apply mul_ne_zero
      · apply neg_ne_zero.mpr
        exact Nat.cast_ne_zero.mpr (by omega)
      · exact ih

