  | 0 => -1
  | n + 1 => -((2 * n + 2 : Nat) : Complex) * brrsOddQuadraticLeadingCoefficient n

theorem brrsOddQuadraticLeadingCoefficient_succ (n : Nat) :
    brrsOddQuadraticLeadingCoefficient (n + 1) =
      -((2 * n + 2 : Nat) : Complex) * brrsOddQuadraticLeadingCoefficient n := rfl

/-- No odd stationary leading coefficient vanishes. -/
