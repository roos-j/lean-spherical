/-- The exact first-odd-moment recurrence yields a quantitative leading
stationary coefficient, with the derivative moment as its `O(lambda⁻¹ᐟ²)`
remainder. -/
theorem exists_quadraticMoment_one_leading_asymptotic
    (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) :
    ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
      ‖(((2 * lambda : Real) : Complex) * Complex.I) *
          quadraticMomentIntegral 1 h lambda + h 0‖ ≤ C / Real.sqrt lambda := by
  obtain ⟨C, hC, hCbound⟩ :=
    exists_quadraticMoment_zero_decay (deriv h)
      ((contDiff_infty_iff_deriv.mp hh).2)
  refine ⟨C, hC, ?_⟩
  intro lambda hlambda
  have hlambda_pos : 0 < lambda := lt_of_lt_of_le zero_lt_one hlambda
  have hrec := quadraticMomentIntegral_one_recurrence h hh hvanish
    (ne_of_gt hlambda_pos)
  let q : Complex := ((2 * lambda : Real) : Complex) * Complex.I
  let R : Complex := quadraticMomentIntegral 0 (deriv h) lambda
  have hq : q ≠ 0 := by
    dsimp [q]
    exact mul_ne_zero
      (Complex.ofReal_ne_zero.mpr (mul_ne_zero (by norm_num) (ne_of_gt hlambda_pos)))
      Complex.I_ne_zero
  have hid : q * (-q⁻¹ * (h 0 + R)) + h 0 = -R := by
    calc
      q * (-q⁻¹ * (h 0 + R)) + h 0 = -(q * q⁻¹) * (h 0 + R) + h 0 := by ring
      _ = -(h 0 + R) + h 0 := by simp [hq]
      _ = -R := by ring
  change ‖q * quadraticMomentIntegral 1 h lambda + h 0‖ ≤ _
  rw [hrec]
  rw [hid, norm_neg]
  exact hCbound lambda hlambda

/-- Norm of the quadratic carrier in the endpoint recurrence. -/
private theorem brrs_norm_quadraticCarrier (lambda : Real) (hlambda : 0 ≤ lambda) :
    ‖((2 * lambda : Real) : Complex) * Complex.I‖ = 2 * lambda := by
  have htwo : 0 ≤ 2 * lambda := by nlinarith
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, Complex.norm_I,
    abs_of_nonneg htwo]
  simp

/-- The carrier power has the corresponding real scalar norm. -/
private theorem brrs_norm_quadraticCarrier_pow
    (k : Nat) (lambda : Real) (hlambda : 0 ≤ lambda) :
    ‖(((2 * lambda : Real) : Complex) * Complex.I) ^ k‖ = (2 * lambda) ^ k := by
  rw [norm_pow, brrs_norm_quadraticCarrier lambda hlambda]

/-- The even derivative remainder in the odd leading-term recurrence has one
extra square-root in its stationary scale. -/
private theorem brrs_quadraticMomentScale_even_remainder_leading
    (n : Nat) {lambda : Real} (hlambda : 0 ≤ lambda) :
    quadraticMomentScale (2 * n + 2) lambda =
      lambda ^ (n + 1) * Real.sqrt lambda := by
  unfold quadraticMomentScale
  have hsquare : Real.sqrt lambda ^ 2 = lambda := Real.sq_sqrt hlambda
  calc
    Real.sqrt lambda ^ (2 * n + 2 + 1) =
        Real.sqrt lambda ^ (2 * (n + 1) + 1) := by congr 1
    _ = (Real.sqrt lambda ^ (2 * (n + 1))) * Real.sqrt lambda := by
      rw [show 2 * (n + 1) + 1 = Nat.succ (2 * (n + 1)) by omega, pow_succ]
    _ = (Real.sqrt lambda ^ 2) ^ (n + 1) * Real.sqrt lambda := by
      rw [← pow_mul]
    _ = lambda ^ (n + 1) * Real.sqrt lambda := by rw [hsquare]

/-- Full complex leading asymptotic for every odd quadratic endpoint moment.
The leading coefficient is fixed (and nonzero) across the frequency annulus;
the error gains a square root.  This is stronger than the norm lower bound
and is the form required to prevent cancellation in a radial packet. -/
theorem exists_quadraticMoment_odd_leading_asymptotic
    (n : Nat) (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) :
    ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
      ‖(((2 * lambda : Real) : Complex) * Complex.I) ^ (n + 1) *
          quadraticMomentIntegral (2 * n + 1) h lambda -
            brrsOddQuadraticLeadingCoefficient n * h 0‖ ≤ C / Real.sqrt lambda := by
  induction n with
  | zero =>
      obtain ⟨C, hC, hbound⟩ :=
        exists_quadraticMoment_one_leading_asymptotic h hh hvanish
      refine ⟨C, hC, ?_⟩
      intro lambda hlambda
      have hrewrite :
          (((2 * lambda : Real) : Complex) * Complex.I) ^ (0 + 1) *
              quadraticMomentIntegral (2 * 0 + 1) h lambda -
                brrsOddQuadraticLeadingCoefficient 0 * h 0 =
            (((2 * lambda : Real) : Complex) * Complex.I) *
              quadraticMomentIntegral 1 h lambda + h 0 := by
        simp [brrsOddQuadraticLeadingCoefficient]
      rw [hrewrite]
      exact hbound lambda hlambda
  | succ n ih =>
      obtain ⟨C₀, hC₀, hmain⟩ := ih
      obtain ⟨C₁, hC₁, hrem⟩ :=
        exists_quadraticMoment_decay (2 * n + 2) (deriv h)
          ((contDiff_infty_iff_deriv.mp hh).2) (VanishesNearOne.deriv h hvanish)
      let D : Real := ((2 * n + 2 : Nat) : Real) * C₀ + (2 : Real) ^ (n + 1) * C₁
      have hD : 0 < D := by
        dsimp [D]
        have hcoeff : (0 : Real) < ((2 * n + 2 : Nat) : Real) := by positivity
        positivity
      refine ⟨D, hD, ?_⟩
      intro lambda hlambda
      have hlambda_pos : 0 < lambda := lt_of_lt_of_le zero_lt_one hlambda
      have hsqrt_pos : 0 < Real.sqrt lambda := Real.sqrt_pos.2 hlambda_pos
      let q : Complex := ((2 * lambda : Real) : Complex) * Complex.I
      let A : Complex := quadraticMomentIntegral (2 * n + 1) h lambda
      let R : Complex := quadraticMomentIntegral ((2 * n + 1) + 1) (deriv h) lambda
      let K : Complex := brrsOddQuadraticLeadingCoefficient n
      have hmain' : ‖q ^ (n + 1) * A - K * h 0‖ ≤ C₀ / Real.sqrt lambda := by
        dsimp [q, A, K]
        exact hmain lambda hlambda
      have hindex : (2 * n + 1) + 1 = 2 * n + 2 := by omega
      have hRraw : ‖R‖ ≤ C₁ / quadraticMomentScale (2 * n + 2) lambda := by
        dsimp [R]
        rw [hindex]
        exact hrem lambda hlambda
      have hscale := brrs_quadraticMomentScale_even_remainder_leading n hlambda_pos.le
      have hR : ‖R‖ ≤ C₁ / (lambda ^ (n + 1) * Real.sqrt lambda) := by
        calc
          ‖R‖ ≤ C₁ / quadraticMomentScale (2 * n + 2) lambda := hRraw
          _ = C₁ / (lambda ^ (n + 1) * Real.sqrt lambda) := by rw [hscale]
      have hqpow : ‖q ^ (n + 1)‖ = (2 * lambda) ^ (n + 1) := by
        dsimp [q]
        exact brrs_norm_quadraticCarrier_pow (n + 1) lambda hlambda_pos.le
      have hqR : ‖q ^ (n + 1) * R‖ ≤
          ((2 : Real) ^ (n + 1) * C₁) / Real.sqrt lambda := by
        calc
          ‖q ^ (n + 1) * R‖ = ‖q ^ (n + 1)‖ * ‖R‖ := norm_mul _ _
          _ = (2 * lambda) ^ (n + 1) * ‖R‖ := by rw [hqpow]
          _ ≤ (2 * lambda) ^ (n + 1) *
              (C₁ / (lambda ^ (n + 1) * Real.sqrt lambda)) :=
            mul_le_mul_of_nonneg_left hR (pow_nonneg (by nlinarith) _)
          _ = ((2 : Real) ^ (n + 1) * C₁) / Real.sqrt lambda := by
            rw [mul_pow]
            field_simp [ne_of_gt hlambda_pos, ne_of_gt hsqrt_pos]
      have hq : q ≠ 0 := by
        dsimp [q]
        apply mul_ne_zero
        · exact Complex.ofReal_ne_zero.mpr (mul_ne_zero (by norm_num) (ne_of_gt hlambda_pos))
        · exact Complex.I_ne_zero
      have hrec := quadraticMomentIntegral_succ_two_recurrence (2 * n + 1) h hh hvanish
        (ne_of_gt hlambda_pos)
      have hrec' :
          quadraticMomentIntegral ((2 * n + 1) + 2) h lambda =
            -q⁻¹ * (((2 * n + 2 : Nat) : Complex) * A + R) := by
        dsimp [q, A, R]
        rw [hindex]
        exact hrec
      have hid :
          q ^ (n + 2) * quadraticMomentIntegral ((2 * n + 1) + 2) h lambda -
              brrsOddQuadraticLeadingCoefficient (n + 1) * h 0 =
            -((2 * n + 2 : Nat) : Complex) * (q ^ (n + 1) * A - K * h 0) -
              q ^ (n + 1) * R := by
        rw [brrsOddQuadraticLeadingCoefficient_succ, hrec']
        rw [show n + 2 = (n + 1) + 1 by omega, pow_succ]
        have hcancel : q * q⁻¹ = 1 := mul_inv_cancel₀ hq
        calc
          q ^ (n + 1) * q * (-q⁻¹ * (((2 * n + 2 : Nat) : Complex) * A + R)) -
                (-((2 * n + 2 : Nat) : Complex) * K) * h 0 =
              -(q ^ (n + 1) * (q * q⁻¹) *
                  (((2 * n + 2 : Nat) : Complex) * A + R)) +
                ((2 * n + 2 : Nat) : Complex) * K * h 0 := by
                ring
          _ = -((2 * n + 2 : Nat) : Complex) * (q ^ (n + 1) * A - K * h 0) -
                q ^ (n + 1) * R := by
                rw [hcancel]
                ring
      have hcoeff_norm : ‖-((2 * n + 2 : Nat) : Complex)‖ =
          ((2 * n + 2 : Nat) : Real) := by
        rw [norm_neg, norm_natCast]
      have hfirst : ‖-((2 * n + 2 : Nat) : Complex) *
          (q ^ (n + 1) * A - K * h 0)‖ ≤
          (((2 * n + 2 : Nat) : Real) * C₀) / Real.sqrt lambda := by
        rw [norm_mul, hcoeff_norm]
        calc
          ((2 * n + 2 : Nat) : Real) * ‖q ^ (n + 1) * A - K * h 0‖ ≤
              ((2 * n + 2 : Nat) : Real) * (C₀ / Real.sqrt lambda) :=
            mul_le_mul_of_nonneg_left hmain' (Nat.cast_nonneg _)
          _ = (((2 * n + 2 : Nat) : Real) * C₀) / Real.sqrt lambda := by ring
      have hsum : ‖-((2 * n + 2 : Nat) : Complex) *
          (q ^ (n + 1) * A - K * h 0) - q ^ (n + 1) * R‖ ≤
          D / Real.sqrt lambda := by
        calc
          ‖-((2 * n + 2 : Nat) : Complex) *
              (q ^ (n + 1) * A - K * h 0) - q ^ (n + 1) * R‖ ≤
              ‖-((2 * n + 2 : Nat) : Complex) *
                (q ^ (n + 1) * A - K * h 0)‖ + ‖q ^ (n + 1) * R‖ :=
            norm_sub_le _ _
          _ ≤ (((2 * n + 2 : Nat) : Real) * C₀) / Real.sqrt lambda +
              ((2 : Real) ^ (n + 1) * C₁) / Real.sqrt lambda :=
            add_le_add hfirst hqR
          _ = D / Real.sqrt lambda := by
            dsimp [D]
            ring
      have hsucc_index : 2 * Nat.succ n + 1 = (2 * n + 1) + 2 := by omega
      have hsucc_power : Nat.succ n + 1 = n + 2 := by omega
      rw [hsucc_index, hsucc_power]
      rw [hid]
      exact hsum

/-- The first odd endpoint recurrence has a one-full-power remainder whenever
the derivative moments have their corresponding one-full-power bounds.  This
is the exact stationary recurrence used below for the literal meridional
profiles; it does not invoke a Bessel function by definition. -/
private theorem exists_quadraticMoment_one_leading_asymptotic_sharp_of_zero_deriv_decay
    (h : Real → Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h)
    (hderiv : ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
      ‖quadraticMomentIntegral 0 (deriv h) lambda‖ ≤ C / lambda) :
    ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
      ‖(((2 * lambda : Real) : Complex) * Complex.I) *
          quadraticMomentIntegral 1 h lambda + h 0‖ ≤ C / lambda := by
  obtain ⟨C, hC, hCbound⟩ := hderiv
  refine ⟨C, hC, ?_⟩
  intro lambda hlambda
  have hlambda_pos : 0 < lambda := lt_of_lt_of_le zero_lt_one hlambda
  have hrec := quadraticMomentIntegral_one_recurrence h hh hvanish
    (ne_of_gt hlambda_pos)
  let q : Complex := ((2 * lambda : Real) : Complex) * Complex.I
  let R : Complex := quadraticMomentIntegral 0 (deriv h) lambda
  have hq : q ≠ 0 := by
    dsimp [q]
    exact mul_ne_zero
      (Complex.ofReal_ne_zero.mpr (mul_ne_zero (by norm_num) (ne_of_gt hlambda_pos)))
      Complex.I_ne_zero
  have hid : q * (-q⁻¹ * (h 0 + R)) + h 0 = -R := by
    calc
      q * (-q⁻¹ * (h 0 + R)) + h 0 = -(q * q⁻¹) * (h 0 + R) + h 0 := by ring
      _ = -(h 0 + R) + h 0 := by simp [hq]
      _ = -R := by ring
  change ‖q * quadraticMomentIntegral 1 h lambda + h 0‖ ≤ _
  rw [hrec]
  rw [hid, norm_neg]
  exact hCbound lambda hlambda

/-- A full leading term and a one-full-power remainder for odd quadratic
moments, under the precise derivative-moment estimates supplied by a compact
stationary amplitude. -/
private theorem exists_quadraticMoment_odd_leading_asymptotic_sharp_of_deriv_bounds
    (h : Real → Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h)
    (hzero : ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
      ‖quadraticMomentIntegral 0 (deriv h) lambda‖ ≤ C / lambda)
    (heven : ∀ n : Nat, ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
      ‖quadraticMomentIntegral (2 * n + 2) (deriv h) lambda‖ ≤ C / lambda ^ (n + 2))
    (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
      ‖(((2 * lambda : Real) : Complex) * Complex.I) ^ (n + 1) *
          quadraticMomentIntegral (2 * n + 1) h lambda -
            brrsOddQuadraticLeadingCoefficient n * h 0‖ ≤ C / lambda := by
  induction n with
  | zero =>
      obtain ⟨C, hC, hbound⟩ :=
        exists_quadraticMoment_one_leading_asymptotic_sharp_of_zero_deriv_decay
          h hh hvanish hzero
      refine ⟨C, hC, ?_⟩
      intro lambda hlambda
      have hrewrite :
          (((2 * lambda : Real) : Complex) * Complex.I) ^ (0 + 1) *
              quadraticMomentIntegral (2 * 0 + 1) h lambda -
                brrsOddQuadraticLeadingCoefficient 0 * h 0 =
            (((2 * lambda : Real) : Complex) * Complex.I) *
              quadraticMomentIntegral 1 h lambda + h 0 := by
        simp [brrsOddQuadraticLeadingCoefficient]
      rw [hrewrite]
      exact hbound lambda hlambda
  | succ n ih =>
      obtain ⟨C₀, hC₀, hmain⟩ := ih
      obtain ⟨C₁, hC₁, hrem⟩ := heven n
      let D : Real := ((2 * n + 2 : Nat) : Real) * C₀ + (2 : Real) ^ (n + 1) * C₁
      have hD : 0 < D := by
        dsimp [D]
        have hcoeff : (0 : Real) < ((2 * n + 2 : Nat) : Real) := by positivity
        positivity
      refine ⟨D, hD, ?_⟩
      intro lambda hlambda
      have hlambda_pos : 0 < lambda := lt_of_lt_of_le zero_lt_one hlambda
      let q : Complex := ((2 * lambda : Real) : Complex) * Complex.I
      let A : Complex := quadraticMomentIntegral (2 * n + 1) h lambda
      let R : Complex := quadraticMomentIntegral ((2 * n + 1) + 1) (deriv h) lambda
      let K : Complex := brrsOddQuadraticLeadingCoefficient n
      have hmain' : ‖q ^ (n + 1) * A - K * h 0‖ ≤ C₀ / lambda := by
        dsimp [q, A, K]
        exact hmain lambda hlambda
      have hindex : (2 * n + 1) + 1 = 2 * n + 2 := by omega
      have hR : ‖R‖ ≤ C₁ / lambda ^ (n + 2) := by
        dsimp [R]
        rw [hindex]
        exact hrem lambda hlambda
      have hqpow : ‖q ^ (n + 1)‖ = (2 * lambda) ^ (n + 1) := by
        dsimp [q]
        exact brrs_norm_quadraticCarrier_pow (n + 1) lambda hlambda_pos.le
      have hqpow_nonneg : 0 ≤ (2 * lambda) ^ (n + 1) := by positivity
      have hqR : ‖q ^ (n + 1) * R‖ ≤
          ((2 : Real) ^ (n + 1) * C₁) / lambda := by
        calc
          ‖q ^ (n + 1) * R‖ = ‖q ^ (n + 1)‖ * ‖R‖ := norm_mul _ _
          _ = (2 * lambda) ^ (n + 1) * ‖R‖ := by rw [hqpow]
          _ ≤ (2 * lambda) ^ (n + 1) * (C₁ / lambda ^ (n + 2)) :=
            mul_le_mul_of_nonneg_left hR hqpow_nonneg
          _ = ((2 : Real) ^ (n + 1) * C₁) / lambda := by
            have hpow : lambda ^ (n + 2) = lambda ^ (n + 1) * lambda := by
              rw [show n + 2 = (n + 1) + 1 by omega, pow_succ]
            rw [mul_pow, hpow]
            field_simp [ne_of_gt hlambda_pos]
      have hq : q ≠ 0 := by
        dsimp [q]
        apply mul_ne_zero
        · exact Complex.ofReal_ne_zero.mpr (mul_ne_zero (by norm_num) (ne_of_gt hlambda_pos))
        · exact Complex.I_ne_zero
      have hrec := quadraticMomentIntegral_succ_two_recurrence (2 * n + 1) h hh hvanish
        (ne_of_gt hlambda_pos)
      have hrec' :
          quadraticMomentIntegral ((2 * n + 1) + 2) h lambda =
            -q⁻¹ * (((2 * n + 2 : Nat) : Complex) * A + R) := by
        dsimp [q, A, R]
        rw [hindex]
        exact hrec
      have hid :
          q ^ (n + 2) * quadraticMomentIntegral ((2 * n + 1) + 2) h lambda -
              brrsOddQuadraticLeadingCoefficient (n + 1) * h 0 =
            -((2 * n + 2 : Nat) : Complex) * (q ^ (n + 1) * A - K * h 0) -
              q ^ (n + 1) * R := by
        rw [brrsOddQuadraticLeadingCoefficient_succ, hrec']
        rw [show n + 2 = (n + 1) + 1 by omega, pow_succ]
        have hcancel : q * q⁻¹ = 1 := mul_inv_cancel₀ hq
        calc
          q ^ (n + 1) * q * (-q⁻¹ * (((2 * n + 2 : Nat) : Complex) * A + R)) -
                (-((2 * n + 2 : Nat) : Complex) * K) * h 0 =
              -(q ^ (n + 1) * (q * q⁻¹) *
                  (((2 * n + 2 : Nat) : Complex) * A + R)) +
                ((2 * n + 2 : Nat) : Complex) * K * h 0 := by
                ring
          _ = -((2 * n + 2 : Nat) : Complex) * (q ^ (n + 1) * A - K * h 0) -
                q ^ (n + 1) * R := by
                rw [hcancel]
                ring
      have hcoeff_norm : ‖-((2 * n + 2 : Nat) : Complex)‖ =
          ((2 * n + 2 : Nat) : Real) := by
        rw [norm_neg, norm_natCast]
      have hfirst : ‖-((2 * n + 2 : Nat) : Complex) *
          (q ^ (n + 1) * A - K * h 0)‖ ≤
          (((2 * n + 2 : Nat) : Real) * C₀) / lambda := by
        rw [norm_mul, hcoeff_norm]
        calc
          ((2 * n + 2 : Nat) : Real) * ‖q ^ (n + 1) * A - K * h 0‖ ≤
              ((2 * n + 2 : Nat) : Real) * (C₀ / lambda) :=
            mul_le_mul_of_nonneg_left hmain' (Nat.cast_nonneg _)
          _ = (((2 * n + 2 : Nat) : Real) * C₀) / lambda := by ring
      have hsum : ‖-((2 * n + 2 : Nat) : Complex) *
          (q ^ (n + 1) * A - K * h 0) - q ^ (n + 1) * R‖ ≤
          D / lambda := by
        calc
          ‖-((2 * n + 2 : Nat) : Complex) *
              (q ^ (n + 1) * A - K * h 0) - q ^ (n + 1) * R‖ ≤
              ‖-((2 * n + 2 : Nat) : Complex) *
                (q ^ (n + 1) * A - K * h 0)‖ + ‖q ^ (n + 1) * R‖ :=
            norm_sub_le _ _
          _ ≤ (((2 * n + 2 : Nat) : Real) * C₀) / lambda +
              ((2 : Real) ^ (n + 1) * C₁) / lambda :=
            add_le_add hfirst hqR
          _ = D / lambda := by
            dsimp [D]
            ring
      change ‖q ^ (n + 2) * quadraticMomentIntegral ((2 * n + 1) + 2) h lambda -
          brrsOddQuadraticLeadingCoefficient (n + 1) * h 0‖ ≤ D / lambda
      rw [hid]
      exact hsum

/-- The concrete nonplanar endpoint has a fixed complex leading stationary
coefficient at every odd order.  The displayed normalization removes the
oscillatory stationary scale, so the limiting coefficient is independent of
the frequency within a high annulus. -/
theorem exists_smoothEndpointQuadraticIntegral_odd_leading_asymptotic
    (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
      ‖(((2 * lambda : Real) : Complex) * Complex.I) ^ (n + 1) *
          smoothEndpointQuadraticIntegral (2 * n + 1) lambda -
            brrsOddQuadraticLeadingCoefficient n *
              smoothEndpointProfile (2 * n + 1) 0‖ ≤ C / Real.sqrt lambda := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_quadraticMoment_odd_leading_asymptotic n
      (smoothEndpointProfile (2 * n + 1))
      (contDiff_smoothEndpointProfile (2 * n + 1))
      (smoothEndpointProfile_eventuallyEq_zero_at_one (2 * n + 1))
  refine ⟨C, hC, ?_⟩
  intro lambda hlambda
  rw [smoothEndpointQuadraticIntegral_eq_quadraticMomentIntegral]
  exact hbound lambda hlambda

/-- On an outgoing odd-dimensional BRRS surface wave, demodulation by its
quadratic stationary scale leaves a single fixed nonzero endpoint coefficient.
The error is uniform in the physical radius and radial frequency once their
literal product is in the high-frequency annulus. -/
theorem exists_brrsSurfaceWaveAmplitude_outgoing_odd_leading_asymptotic
    (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ a rho : Real, 1 ≤ (2 * Real.pi * a) * rho →
      ‖(((2 * ((2 * Real.pi * a) * rho) : Real) : Complex) * Complex.I) ^
            (n + 1) *
          brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho -
            (surfaceMass (2 * n + 2) : Complex) *
              (brrsOddQuadraticLeadingCoefficient n *
                smoothEndpointProfile (2 * n + 1) 0)‖ ≤
        C / Real.sqrt ((2 * Real.pi * a) * rho) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_smoothEndpointQuadraticIntegral_odd_leading_asymptotic n
  let mass : Real := surfaceMass (2 * n + 2)
  have hmass : 0 < mass := by
    dsimp [mass]
    exact surfaceMass_pos (by omega)
  refine ⟨mass * C, mul_pos hmass hC, ?_⟩
  intro a rho hlambda
  let lambda : Real := (2 * Real.pi * a) * rho
  have hmain := hbound lambda (by simpa [lambda] using hlambda)
  have hdim_one : (2 * n + 3) - 1 = 2 * n + 2 := by omega
  have hdim_two : (2 * n + 3) - 2 = 2 * n + 1 := by omega
  have hamp :
      brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho =
        (mass : Complex) * smoothEndpointQuadraticIntegral (2 * n + 1) lambda := by
    unfold brrsSurfaceWaveAmplitude
    dsimp [lambda, mass]
    rw [hdim_two]
  rw [hamp]
  have hfactor :
      (((2 * lambda : Real) : Complex) * Complex.I) ^ (n + 1) *
          ((mass : Complex) * smoothEndpointQuadraticIntegral (2 * n + 1) lambda) -
            (mass : Complex) *
              (brrsOddQuadraticLeadingCoefficient n *
                smoothEndpointProfile (2 * n + 1) 0) =
        (mass : Complex) *
          ((((2 * lambda : Real) : Complex) * Complex.I) ^ (n + 1) *
            smoothEndpointQuadraticIntegral (2 * n + 1) lambda -
              brrsOddQuadraticLeadingCoefficient n *
                smoothEndpointProfile (2 * n + 1) 0) := by
      ring
  rw [show (2 * Real.pi * a) * rho = lambda by rfl, hfactor, norm_mul,
    Complex.norm_real, Real.norm_eq_abs, abs_of_pos hmass]
  calc
    mass * ‖(((2 * lambda : Real) : Complex) * Complex.I) ^ (n + 1) *
        smoothEndpointQuadraticIntegral (2 * n + 1) lambda -
          brrsOddQuadraticLeadingCoefficient n *
            smoothEndpointProfile (2 * n + 1) 0‖ ≤
        mass * (C / Real.sqrt lambda) :=
      mul_le_mul_of_nonneg_left hmain hmass.le
    _ = (mass * C) / Real.sqrt lambda := by ring

/-- In every odd spatial dimension, the outgoing endpoint wave has a fixed
complex leading carrier after separating the physical radius from the radial
frequency.  This is the normalization needed to integrate the leading term
against the positive `TT*` annular density: the limiting phase is independent
of the frequency variable, so there is no endpoint cancellation to hide. -/
theorem exists_brrsSurfaceWaveAmplitude_outgoing_odd_normalized_carrier_asymptotic
    (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ a rho : Real,
      1 ≤ (2 * Real.pi * a) * rho →
      ‖(((4 * Real.pi * a : Real) : Complex) * Complex.I) ^ (n + 1) *
          ((rho : Real) : Complex) ^ (n + 1) *
          brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho -
            (surfaceMass (2 * n + 2) : Complex) *
              (brrsOddQuadraticLeadingCoefficient n *
                smoothEndpointProfile (2 * n + 1) 0)‖ ≤
        C / Real.sqrt ((2 * Real.pi * a) * rho) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_brrsSurfaceWaveAmplitude_outgoing_odd_leading_asymptotic n
  refine ⟨C, hC, ?_⟩
  intro a rho hlambda
  have hbase :
      (((4 * Real.pi * a : Real) : Complex) * Complex.I) *
          ((rho : Real) : Complex) =
        ((2 * ((2 * Real.pi * a) * rho) : Real) : Complex) * Complex.I := by
    push_cast
    ring
  have hfactor :
      (((4 * Real.pi * a : Real) : Complex) * Complex.I) ^ (n + 1) *
          ((rho : Real) : Complex) ^ (n + 1) =
        (((2 * ((2 * Real.pi * a) * rho) : Real) : Complex) * Complex.I) ^
          (n + 1) := by
    calc
      (((4 * Real.pi * a : Real) : Complex) * Complex.I) ^ (n + 1) *
          ((rho : Real) : Complex) ^ (n + 1) =
          ((((4 * Real.pi * a : Real) : Complex) * Complex.I) *
            ((rho : Real) : Complex)) ^ (n + 1) :=
        (mul_pow (((4 * Real.pi * a : Real) : Complex) * Complex.I)
          ((rho : Real) : Complex) (n + 1)).symm
      _ = (((2 * ((2 * Real.pi * a) * rho) : Real) : Complex) * Complex.I) ^
          (n + 1) := by rw [hbase]
  rw [hfactor]
  exact hbound a rho hlambda

/-- The fixed complex leading carrier of the odd-dimensional outgoing wave. -/
noncomputable def brrsOddOutgoingLeadingCarrier (n : Nat) : Complex :=
  (surfaceMass (2 * n + 2) : Complex) *
    (brrsOddQuadraticLeadingCoefficient n *
      smoothEndpointProfile (2 * n + 1) 0)

/-- The odd outgoing leading carrier is genuinely nonzero. -/
theorem brrsOddOutgoingLeadingCarrier_ne_zero (n : Nat) :
    brrsOddOutgoingLeadingCarrier n ≠ 0 := by
  unfold brrsOddOutgoingLeadingCarrier
  apply mul_ne_zero
  · exact Complex.ofReal_ne_zero.mpr
      (ne_of_gt (surfaceMass_pos (by omega)))
  · exact mul_ne_zero (brrsOddQuadraticLeadingCoefficient_ne_zero n)
      (brrs_smoothEndpointProfile_zero_ne_zero (2 * n + 1))

/-- The normalized odd outgoing asymptotic written using its named nonzero
leading carrier. -/
theorem exists_brrsSurfaceWaveAmplitude_outgoing_odd_normalized_carrier_asymptotic'
    (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ a rho : Real,
      1 ≤ (2 * Real.pi * a) * rho →
      ‖(((4 * Real.pi * a : Real) : Complex) * Complex.I) ^ (n + 1) *
          ((rho : Real) : Complex) ^ (n + 1) *
          brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho -
            brrsOddOutgoingLeadingCarrier n‖ ≤
        C / Real.sqrt ((2 * Real.pi * a) * rho) := by
  simpa only [brrsOddOutgoingLeadingCarrier] using
    exists_brrsSurfaceWaveAmplitude_outgoing_odd_normalized_carrier_asymptotic n

/-- The positive weighted annular moment that multiplies the fixed odd
outgoing leading carrier for the literal `TT*` cutoff. -/
noncomputable def brrsOddTTStarRadialMoment (Φ : BRRSAnnularCutoff) (n : Nat) : Real :=
  ∫ rho in (1 / 32 : Real)..1,
    rho ^ (n + 1) * ‖Φ.symbol (2 * Real.pi * rho)‖ ^ 2

/-- The weighted positive `TT*` annular moment cannot vanish.  This is the
frequency-side positivity which prevents cancellation of the normalized odd
outgoing leading term. -/
theorem brrsOddTTStarRadialMoment_pos (Φ : BRRSAnnularCutoff) (n : Nat) :
    0 < brrsOddTTStarRadialMoment Φ n := by
  let f : Real → Real := fun rho : Real =>
    rho ^ (n + 1) * ‖Φ.symbol (2 * Real.pi * rho)‖ ^ 2
  have hcont : Continuous f := by
    dsimp [f]
    exact (continuous_id.pow (n + 1)).mul
      ((Φ.symbol.continuous.comp (by fun_prop)).norm.pow 2)
  have hfi : IntervalIntegrable f volume (1 / 32 : Real) 1 :=
    hcont.intervalIntegrable _ _
  have hnonneg_on : ∀ rho : Real, rho ∈ Ioc (1 / 32 : Real) 1 → 0 ≤ f rho := by
    intro rho hrho
    dsimp [f]
    exact mul_nonneg (pow_nonneg (by linarith [hrho.1]) _) (sq_nonneg _)
  have hnonneg_ae : 0 ≤ᵐ[volume.restrict (uIoc (1 / 32 : Real) 1)] f := by
    rw [uIoc_of_le (by norm_num : (1 / 32 : Real) ≤ 1)]
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with rho hrho
    exact hnonneg_on rho hrho
  rcases Φ.nontrivial with ⟨r, hr⟩
  have hrsupport : r ∈ tsupport (Φ.symbol : Real → Complex) :=
    subset_tsupport _ (Function.mem_support.mpr hr)
  have hrange : r ∈ Ioo (1 / 4 : Real) 4 := Φ.tsupport_subset hrsupport
  let rho : Real := r / (2 * Real.pi)
  have hden : 0 < 2 * Real.pi := by positivity
  have hrho : rho ∈ Ioo (1 / 32 : Real) 1 := by
    constructor
    · apply (lt_div_iff₀ hden).mpr
      nlinarith [hrange.1, Real.pi_lt_four]
    · apply (div_lt_iff₀ hden).mpr
      nlinarith [hrange.2, Real.pi_gt_three]
  have harg : 2 * Real.pi * rho = r := by
    dsimp [rho]
    field_simp [Real.pi_ne_zero]
  have hsymbol : Φ.symbol (2 * Real.pi * rho) ≠ 0 := by
    rw [harg]
    exact hr
  have hfrho : f rho ≠ 0 := by
    dsimp [f]
    apply mul_ne_zero
    · exact pow_ne_zero _ (ne_of_gt (lt_trans (by norm_num) hrho.1))
    · exact pow_ne_zero _ (norm_ne_zero_iff.mpr hsymbol)
  unfold brrsOddTTStarRadialMoment
  change 0 < ∫ rho in (1 / 32 : Real)..1, f rho
  apply (intervalIntegral.integral_pos_iff_support_of_nonneg_ae'
    hnonneg_ae hfi).mpr
  refine ⟨by norm_num, ?_⟩
  let S : Set Real := Function.support f ∩ Ioo (1 / 32 : Real) 1
  have hSopen : IsOpen S := hcont.isOpen_support.inter isOpen_Ioo
  have hrhoS : rho ∈ S := ⟨Function.mem_support.mpr hfrho, hrho⟩
  have hSpos : 0 < volume S := hSopen.measure_pos volume ⟨rho, hrhoS⟩
  refine hSpos.trans_le (measure_mono ?_)
  intro x hx
  exact ⟨hx.1, Ioo_subset_Ioc_self hx.2⟩

/-- The complex radial moment of the positive `TT*` cutoff is exactly the
real positive moment above, embedded in `Complex`. -/
theorem intervalIntegral_brrsTTStarAnnularCutoff_weighted_eq_ofReal_moment
    (Φ : BRRSAnnularCutoff) (n : Nat) :
    (∫ rho in (1 / 32 : Real)..1,
      ((rho ^ (n + 1) : Real) : Complex) *
        (brrsTTStarAnnularCutoff Φ).symbol (2 * Real.pi * rho)) =
      (brrsOddTTStarRadialMoment Φ n : Complex) := by
  rw [show (fun rho : Real =>
      ((rho ^ (n + 1) : Real) : Complex) *
        (brrsTTStarAnnularCutoff Φ).symbol (2 * Real.pi * rho)) =
      fun rho : Real =>
        ((rho ^ (n + 1) * ‖Φ.symbol (2 * Real.pi * rho)‖ ^ 2 : Real) : Complex) by
      funext rho
      rw [brrsTTStarAnnularCutoff_symbol_apply, RCLike.mul_conj]
      push_cast
      rfl]
  simpa only [brrsOddTTStarRadialMoment] using
    (intervalIntegral.integral_ofReal
      (f := fun rho : Real => rho ^ (n + 1) * ‖Φ.symbol (2 * Real.pi * rho)‖ ^ 2)
      (μ := volume))

/-- At the outgoing relative cone, the literal stationary component of the
positive `TT*` kernel has no remaining linear carrier.  It is exactly the
radial integral of the outgoing amplitude against the positive cutoff. -/
theorem brrsStationaryWaveComponentIntegral_ttStar_outgoing_cone_eq
    (Φ : BRRSAnnularCutoff) (n : Nat) (a : Real) :
    brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Φ)
      (2 * n + 3) .outgoing a a =
      ∫ rho in (1 / 32 : Real)..1,
        ((rho ^ (2 * n + 2) : Real) : Complex) *
          brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho *
            (brrsTTStarAnnularCutoff Φ).symbol (2 * Real.pi * rho) := by
  unfold brrsStationaryWaveComponentIntegral
  rw [intervalIntegral_brrsStationaryWaveComponent_eq_oscillatoryExp]
  apply intervalIntegral.integral_congr
  intro rho _
  unfold brrsStationaryWaveRadialCoefficient
  have hphase : brrsSurfaceWavePhase .outgoing a + 2 * Real.pi * a = 0 := by
    simp only [brrsSurfaceWavePhase]
    ring
  rw [hphase]
  simp only [oscillatoryExp, zero_mul, Complex.ofReal_zero, zero_mul,
    Complex.exp_zero, mul_one]
  have hindex : (2 * n + 3) - 1 = 2 * n + 2 := by omega
  rw [hindex]

/-- After the outgoing cone demodulation in odd dimension, the outgoing
`TT*` component converges quantitatively to the nonzero endpoint carrier
times its positive radial moment.  This concerns the outgoing component alone;
it deliberately makes no cancellation claim about the other stationary
components of the full kernel. -/
theorem exists_norm_brrsStatWvCompInteg_ttStar_outgoing_cone_normd_leading_asymptotic
    (Φ : BRRSAnnularCutoff) (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ a : Real, 16 ≤ a →
      ‖(((4 * Real.pi * a : Real) : Complex) * Complex.I) ^ (n + 1) *
          brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Φ)
            (2 * n + 3) .outgoing a a -
          brrsOddOutgoingLeadingCarrier n *
            (brrsOddTTStarRadialMoment Φ n : Complex)‖ ≤
        C / Real.sqrt (a / 16) := by
  obtain ⟨D, hD, hamp⟩ :=
    exists_brrsSurfaceWaveAmplitude_outgoing_odd_normalized_carrier_asymptotic' n
  let Ψ : BRRSAnnularCutoff := brrsTTStarAnnularCutoff Φ
  let W : Real → Complex := fun rho : Real => Ψ.symbol (2 * Real.pi * rho)
  have hWcont : Continuous W := by
    dsimp [W]
    exact Ψ.symbol.continuous.comp (by fun_prop)
  obtain ⟨B, hB⟩ :=
    (isCompact_Icc : IsCompact (Icc (1 / 32 : Real) 1)).exists_bound_of_continuousOn
      hWcont.continuousOn
  let C : Real := (1 - (1 / 32 : Real)) * (max B 0 * D) + 1
  have hC : 0 < C := by
    dsimp [C]
    positivity
  refine ⟨C, hC, ?_⟩
  intro a ha
  let A : Complex := ((4 * Real.pi * a : Real) : Complex) * Complex.I
  let L : Complex := brrsOddOutgoingLeadingCarrier n
  let P : Real → Complex := fun rho : Real =>
    ((rho ^ (2 * n + 2) : Real) : Complex) *
      brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho * W rho
  let Q : Real → Complex := fun rho : Real =>
    ((rho ^ (n + 1) : Real) : Complex) * W rho
  have hPcont : Continuous P := by
    dsimp [P]
    exact ((Complex.ofRealCLM.continuous.comp (continuous_id.pow (2 * n + 2))).mul
      (contDiff_brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a).continuous).mul hWcont
  have hQcont : Continuous Q := by
    dsimp [Q]
    exact (Complex.ofRealCLM.continuous.comp (continuous_id.pow (n + 1))).mul hWcont
  have hAPint : IntervalIntegrable (fun rho : Real => A ^ (n + 1) * P rho)
      volume (1 / 32 : Real) 1 :=
    (continuous_const.mul hPcont).intervalIntegrable _ _
  have hLQint : IntervalIntegrable (fun rho : Real => L * Q rho)
      volume (1 / 32 : Real) 1 :=
    (continuous_const.mul hQcont).intervalIntegrable _ _
  have hrewrite :
      A ^ (n + 1) *
          brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Φ)
            (2 * n + 3) .outgoing a a -
          L * (brrsOddTTStarRadialMoment Φ n : Complex) =
        ∫ rho in (1 / 32 : Real)..1,
          ((rho ^ (n + 1) : Real) : Complex) * W rho *
            (A ^ (n + 1) * ((rho : Real) : Complex) ^ (n + 1) *
              brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho - L) := by
    rw [brrsStationaryWaveComponentIntegral_ttStar_outgoing_cone_eq]
    rw [← intervalIntegral_brrsTTStarAnnularCutoff_weighted_eq_ofReal_moment]
    change A ^ (n + 1) * (∫ rho in (1 / 32 : Real)..1, P rho) -
        L * (∫ rho in (1 / 32 : Real)..1, Q rho) = _
    rw [← intervalIntegral.integral_const_mul,
      ← intervalIntegral.integral_const_mul,
      ← intervalIntegral.integral_sub hAPint hLQint]
    apply intervalIntegral.integral_congr
    intro rho _
    have hpower : (2 * n + 2 : Nat) = (n + 1) + (n + 1) := by omega
    dsimp [P, Q]
    push_cast; rw [hpower, pow_add]; ring
  rw [show (((4 * Real.pi * a : Real) : Complex) * Complex.I) = A by rfl,
    show brrsOddOutgoingLeadingCarrier n = L by rfl, hrewrite]
  refine (intervalIntegral.norm_integral_le_of_norm_le_const
    (C := (max B 0) * (D / Real.sqrt (a / 16))) ?_).trans ?_
  · intro rho hrho
    have hrho' : rho ∈ Icc (1 / 32 : Real) 1 := by
      rw [uIoc_of_le (by norm_num : (1 / 32 : Real) ≤ 1)] at hrho
      exact ⟨hrho.1.le, hrho.2⟩
    have ha0 : 0 ≤ a := by linarith
    have hrho0 : 0 ≤ rho := le_trans (by norm_num) hrho'.1
    have hfactor : (1 / 16 : Real) ≤ (2 * Real.pi) * rho := by
      calc
        (1 / 16 : Real) ≤ (2 * Real.pi) * (1 / 32 : Real) := by
          nlinarith [Real.pi_gt_three]
        _ ≤ (2 * Real.pi) * rho := by
          exact mul_le_mul_of_nonneg_left hrho'.1 (by positivity)
    have hlambda : a / 16 ≤ (2 * Real.pi * a) * rho := by
      calc
        a / 16 = a * (1 / 16 : Real) := by ring
        _ ≤ a * ((2 * Real.pi) * rho) := by gcongr
        _ = (2 * Real.pi * a) * rho := by ring
    have hlarge : 1 ≤ (2 * Real.pi * a) * rho := by
      calc
        (1 : Real) ≤ a / 16 := by linarith
        _ ≤ (2 * Real.pi * a) * rho := hlambda
    have hqpos : 0 < Real.sqrt (a / 16) := by
      apply Real.sqrt_pos.2
      linarith
    have hsqrt : Real.sqrt (a / 16) ≤ Real.sqrt ((2 * Real.pi * a) * rho) :=
      Real.sqrt_le_sqrt hlambda
    have herr :
        ‖A ^ (n + 1) * ((rho : Real) : Complex) ^ (n + 1) *
            brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho - L‖ ≤
          D / Real.sqrt (a / 16) := by
      change ‖(((4 * Real.pi * a : Real) : Complex) * Complex.I) ^ (n + 1) *
          ((rho : Real) : Complex) ^ (n + 1) *
            brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho -
            brrsOddOutgoingLeadingCarrier n‖ ≤ _
      exact (hamp a rho hlarge).trans
        (div_le_div_of_nonneg_left hD.le hqpos hsqrt)
    have hrhopow : ‖((rho ^ (n + 1) : Real) : Complex)‖ ≤ 1 := by
      rw [Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (pow_nonneg hrho0 _)]
      exact pow_le_one₀ hrho0 hrho'.2
    have hW : ‖W rho‖ ≤ max B 0 :=
      (hB rho hrho').trans (le_max_left _ _)
    have hE : 0 ≤ D / Real.sqrt (a / 16) := by positivity
    calc
      ‖((rho ^ (n + 1) : Real) : Complex) * W rho *
          (A ^ (n + 1) * ((rho : Real) : Complex) ^ (n + 1) *
            brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho - L)‖ =
          ‖((rho ^ (n + 1) : Real) : Complex)‖ * ‖W rho‖ *
            ‖A ^ (n + 1) * ((rho : Real) : Complex) ^ (n + 1) *
              brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho - L‖ := by
        rw [norm_mul, norm_mul]
      _ ≤ ‖((rho ^ (n + 1) : Real) : Complex)‖ * ‖W rho‖ *
            (D / Real.sqrt (a / 16)) := by
        gcongr
      _ ≤ (max B 0) * (D / Real.sqrt (a / 16)) := by
        calc
          _ ≤ (1 : Real) * (max B 0) * (D / Real.sqrt (a / 16)) := by
            gcongr
          _ = (max B 0) * (D / Real.sqrt (a / 16)) := by ring
  · have hqpos : 0 < Real.sqrt (a / 16) := by
      apply Real.sqrt_pos.2
      linarith
    have hlength : |1 - (1 / 32 : Real)| = 1 - (1 / 32 : Real) := by
      rw [abs_of_nonneg]
      norm_num
    rw [hlength]
    calc
      (max B 0) * (D / Real.sqrt (a / 16)) * (1 - (1 / 32 : Real)) =
          ((1 - (1 / 32 : Real)) * (max B 0 * D)) /
            Real.sqrt (a / 16) := by
        rw [div_eq_mul_inv, div_eq_mul_inv]
        ring
      _ ≤ C / Real.sqrt (a / 16) := by
        apply (div_le_div_iff_of_pos_right hqpos).mpr
        dsimp [C]
        linarith

/-- In every odd dimension the outgoing stationary component of the positive
`TT*` kernel is eventually bounded away from zero on its relative cone, after
the natural stationary demodulation.  The assertion is intentionally only for
this component; bounding the full kernel additionally requires quantified
control of the incoming and middle components. -/
theorem exists_brrsStatWaveCompIntegral_ttStar_outgoing_cone_normd_eventually_lower
    (Φ : BRRSAnnularCutoff) (n : Nat) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧ ∀ a : Real, A ≤ a →
      c ≤ ‖(((4 * Real.pi * a : Real) : Complex) * Complex.I) ^ (n + 1) *
          brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Φ)
            (2 * n + 3) .outgoing a a‖ := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_norm_brrsStatWvCompInteg_ttStar_outgoing_cone_normd_leading_asymptotic
      Φ n
  let Z : Complex := brrsOddOutgoingLeadingCarrier n *
    (brrsOddTTStarRadialMoment Φ n : Complex)
  let K : Real := ‖Z‖
  have hmoment_ne : (brrsOddTTStarRadialMoment Φ n : Complex) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (ne_of_gt (brrsOddTTStarRadialMoment_pos Φ n))
  have hZne : Z ≠ 0 := by
    dsimp [Z]
    exact mul_ne_zero (brrsOddOutgoingLeadingCarrier_ne_zero n) hmoment_ne
  have hK : 0 < K := by
    dsimp [K]
    exact norm_pos_iff.mpr hZne
  let A : Real := max 16 (16 * (2 * C / K) ^ 2)
  let X : Real → Complex := fun a : Real =>
    (((4 * Real.pi * a : Real) : Complex) * Complex.I) ^ (n + 1) *
      brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Φ)
        (2 * n + 3) .outgoing a a
  refine ⟨A, K / 2, le_max_left _ _, by positivity, ?_⟩
  intro a ha
  change K / 2 ≤ ‖X a‖
  have ha16 : 16 ≤ a := le_trans (le_max_left _ _) ha
  have haover : 0 < a / 16 := by linarith
  have hqpos : 0 < Real.sqrt (a / 16) := Real.sqrt_pos.2 haover
  have hsq : (2 * C / K) ^ 2 ≤ a / 16 := by
    have hraw : 16 * (2 * C / K) ^ 2 ≤ a :=
      le_trans (le_max_right _ _) ha
    nlinarith
  have hratio0 : 0 ≤ 2 * C / K := by positivity
  have hroot_sq : (Real.sqrt (a / 16)) ^ 2 = a / 16 :=
    Real.sq_sqrt haover.le
  have hratio : 2 * C / K ≤ Real.sqrt (a / 16) := by
    nlinarith [Real.sqrt_nonneg (a / 16)]
  have htwoC : 2 * C ≤ Real.sqrt (a / 16) * K :=
    (div_le_iff₀ hK).mp hratio
  have hhalf : C / Real.sqrt (a / 16) ≤ K / 2 := by
    apply (div_le_iff₀ hqpos).mpr
    nlinarith
  have herr : ‖X a - Z‖ ≤ C / Real.sqrt (a / 16) := by
    change ‖(((4 * Real.pi * a : Real) : Complex) * Complex.I) ^ (n + 1) *
        brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Φ)
          (2 * n + 3) .outgoing a a -
        brrsOddOutgoingLeadingCarrier n *
          (brrsOddTTStarRadialMoment Φ n : Complex)‖ ≤ _
    exact hbound a ha16
  have hdiff : ‖X a - Z‖ ≤ K / 2 := herr.trans hhalf
  have htri : K ≤ ‖X a‖ + ‖X a - Z‖ := by
    calc
      K = ‖X a - (X a - Z)‖ := by
        dsimp [K]
        congr 1
        ring
      _ ≤ ‖X a‖ + ‖X a - Z‖ := norm_sub_le _ _
  nlinarith

/-- The preceding normalized lower bound gives the literal stationary-scale
lower bound for the outgoing component itself. -/
theorem exists_brrsStationaryWaveComponentIntegral_ttStar_outgoing_cone_eventually_lower
    (Φ : BRRSAnnularCutoff) (n : Nat) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧ ∀ a : Real, A ≤ a →
      c / a ^ (n + 1) ≤
        ‖brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Φ)
          (2 * n + 3) .outgoing a a‖ := by
  obtain ⟨A, c, hA, hc, hbound⟩ :=
    exists_brrsStatWaveCompIntegral_ttStar_outgoing_cone_normd_eventually_lower
      Φ n
  let D : Real := (4 * Real.pi) ^ (n + 1)
  have hD : 0 < D := by
    dsimp [D]
    positivity
  refine ⟨A, c / D, hA, div_pos hc hD, ?_⟩
  intro a ha
  let Y : Complex :=
    brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Φ)
      (2 * n + 3) .outgoing a a
  have ha16 : 16 ≤ a := le_trans hA ha
  have ha0 : 0 ≤ a := by linarith
  have hbase : 0 ≤ 4 * Real.pi * a := by positivity
  have hbaseNorm : ‖(((4 * Real.pi * a : Real) : Complex) * Complex.I)‖ =
      4 * Real.pi * a := by
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg hbase, Complex.norm_I, mul_one]
  have hnorm : c ≤ (4 * Real.pi * a) ^ (n + 1) * ‖Y‖ := by
    have hnorm' := hbound a ha
    change c ≤ ‖(((4 * Real.pi * a : Real) : Complex) * Complex.I) ^ (n + 1) *
      Y‖ at hnorm'
    calc
      c ≤ ‖(((4 * Real.pi * a : Real) : Complex) * Complex.I) ^ (n + 1) * Y‖ :=
        hnorm'
      _ = ‖(((4 * Real.pi * a : Real) : Complex) * Complex.I)‖ ^ (n + 1) * ‖Y‖ := by
        rw [norm_mul, norm_pow]
      _ = (4 * Real.pi * a) ^ (n + 1) * ‖Y‖ := by rw [hbaseNorm]
  have hscale : (4 * Real.pi * a) ^ (n + 1) =
      (4 * Real.pi) ^ (n + 1) * a ^ (n + 1) := by
    rw [show 4 * Real.pi * a = (4 * Real.pi) * a by ring, mul_pow]
  have hscaled : c ≤ D * a ^ (n + 1) * ‖Y‖ := by
    calc
      c ≤ (4 * Real.pi * a) ^ (n + 1) * ‖Y‖ := hnorm
      _ = D * a ^ (n + 1) * ‖Y‖ := by
        dsimp [D]
        rw [hscale]
  change c / D / a ^ (n + 1) ≤ ‖Y‖
  rw [div_div]
  apply (div_le_iff₀ (mul_pos hD (pow_pos (by linarith : 0 < a) _))).mpr
  simpa only [mul_assoc, mul_left_comm, mul_comm] using hscaled

/-- Any non-outgoing stationary component gains a full extra power of the
cone radius at the outgoing cone.  This is the quantitative separation needed
to turn the outgoing-component lower bound into a lower bound for the literal
three-component kernel. -/
theorem exists_brrsStationaryWaveComponentIntegral_nonoutgoing_cone_highRadius_power_le
    (Φ : BRRSAnnularCutoff) (n : Nat) (part : BRRSSurfaceWavePart)
    (hpart : part ≠ .outgoing) :
    ∃ C : Real, 0 < C ∧ ∀ a : Real, 16 ≤ a →
      ‖brrsStationaryWaveComponentIntegral Φ (2 * n + 3) part a a‖ ≤
        C / a ^ (n + 2) := by
  obtain ⟨C, hC, hcomponent⟩ :=
    exists_norm_intervalIntegral_brrsStationaryWaveComponent_highRadius_le
      (d := 2 * n + 3) (N := n + 2) (by omega) Φ part
  let C' : Real := (1 - (1 / 32 : Real)) * C
  have hC' : 0 < C' := by
    dsimp [C']
    positivity
  refine ⟨C', hC', ?_⟩
  intro a ha
  have ha0 : 0 ≤ a := by linarith
  have hapos : 0 < a := by linarith
  have hphase_lower : a ≤ |brrsSurfaceWavePhase part a + 2 * Real.pi * a| := by
    cases part with
    | outgoing => exact False.elim (hpart rfl)
    | incoming =>
      have hcoef : (1 : Real) ≤ 4 * Real.pi := by
        nlinarith [Real.pi_gt_three]
      have hnonneg : 0 ≤ 4 * Real.pi * a := by positivity
      rw [show brrsSurfaceWavePhase .incoming a + 2 * Real.pi * a =
        4 * Real.pi * a by simp [brrsSurfaceWavePhase]; ring,
        abs_of_nonneg hnonneg]
      calc
        a = 1 * a := by ring
        _ ≤ (4 * Real.pi) * a := mul_le_mul_of_nonneg_right hcoef ha0
        _ = 4 * Real.pi * a := by ring
    | middle =>
      have hcoef : (1 : Real) ≤ 2 * Real.pi := by
        nlinarith [Real.pi_gt_three]
      have hnonneg : 0 ≤ 2 * Real.pi * a := by positivity
      rw [show brrsSurfaceWavePhase .middle a + 2 * Real.pi * a =
        2 * Real.pi * a by simp [brrsSurfaceWavePhase],
        abs_of_nonneg hnonneg]
      calc
        a = 1 * a := by ring
        _ ≤ (2 * Real.pi) * a := mul_le_mul_of_nonneg_right hcoef ha0
        _ = 2 * Real.pi * a := by ring
  have habspos : 0 < |brrsSurfaceWavePhase part a + 2 * Real.pi * a| :=
    lt_of_lt_of_le hapos hphase_lower
  have hphase_ne : brrsSurfaceWavePhase part a + 2 * Real.pi * a ≠ 0 := by
    intro hzero
    rw [hzero, abs_zero] at habspos
    linarith
  have hraw :
      ‖brrsStationaryWaveComponentIntegral Φ (2 * n + 3) part a a‖ ≤
        (1 / |brrsSurfaceWavePhase part a + 2 * Real.pi * a|) ^ (n + 2) *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (a / 16)) ^ ((2 * n + 3) - 1))) := by
    simpa only [brrsStationaryWaveComponentIntegral] using
      hcomponent a a ha hphase_ne
  have hratio : 1 ≤ a / 16 := by linarith
  have hsqrt : 1 ≤ Real.sqrt (a / 16) := Real.one_le_sqrt.mpr hratio
  have hdenone : 1 ≤ (Real.sqrt (a / 16)) ^ ((2 * n + 3) - 1) :=
    one_le_pow₀ hsqrt
  have hdenpos : 0 < (Real.sqrt (a / 16)) ^ ((2 * n + 3) - 1) :=
    lt_of_lt_of_le zero_lt_one hdenone
  have hdiv : C / (Real.sqrt (a / 16)) ^ ((2 * n + 3) - 1) ≤ C := by
    apply (div_le_iff₀ hdenpos).mpr
    exact le_mul_of_one_le_right hC.le hdenone
  have hinv : 1 / |brrsSurfaceWavePhase part a + 2 * Real.pi * a| ≤ 1 / a :=
    one_div_le_one_div_of_le hapos hphase_lower
  have hinvpow :
      (1 / |brrsSurfaceWavePhase part a + 2 * Real.pi * a|) ^ (n + 2) ≤
        (1 / a) ^ (n + 2) :=
    pow_le_pow_left₀ (by positivity) hinv _
  have hconst : 0 ≤ (1 - (1 / 32 : Real)) * C := by positivity
  calc
    ‖brrsStationaryWaveComponentIntegral Φ (2 * n + 3) part a a‖ ≤
        (1 / |brrsSurfaceWavePhase part a + 2 * Real.pi * a|) ^ (n + 2) *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (a / 16)) ^ ((2 * n + 3) - 1))) := hraw
    _ ≤ (1 / |brrsSurfaceWavePhase part a + 2 * Real.pi * a|) ^ (n + 2) *
          ((1 - (1 / 32 : Real)) * C) := by
      apply mul_le_mul_of_nonneg_left
      · exact mul_le_mul_of_nonneg_left hdiv (by norm_num)
      · positivity
    _ ≤ (1 / a) ^ (n + 2) * ((1 - (1 / 32 : Real)) * C) :=
      mul_le_mul_of_nonneg_right hinvpow hconst
    _ = C' / a ^ (n + 2) := by
      dsimp [C']
      rw [one_div, inv_pow]
      ring

/-- The literal level-zero positive `TT*` half-wave kernel has nontrivial mass
on every sufficiently large outgoing cone in odd dimension.  The proof uses
the exact three-component stationary decomposition: the outgoing component has
the nonzero endpoint lower term, while incoming and middle components gain one
additional power of the cone radius. -/
theorem exists_brrsDyadicHalfWaveKernel_ttStar_outgoing_cone_eventually_lower
    (Φ : BRRSAnnularCutoff) (n : Nat) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧ ∀ (a : Real) (v : BRRSSpace (2 * n + 3)),
      A ≤ a → ‖v‖ = 1 →
        c / a ^ (n + 1) ≤
          ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Φ) 0 a :
            BRRSSpace (2 * n + 3) → Complex) (a • v)‖ := by
  obtain ⟨Aout, cout, hAout, hcout, hout⟩ :=
    exists_brrsStationaryWaveComponentIntegral_ttStar_outgoing_cone_eventually_lower
      Φ n
  obtain ⟨Cin, hCin, hin⟩ :=
    exists_brrsStationaryWaveComponentIntegral_nonoutgoing_cone_highRadius_power_le
      (brrsTTStarAnnularCutoff Φ) n .incoming (by simp)
  obtain ⟨Cmid, hCmid, hmid⟩ :=
    exists_brrsStationaryWaveComponentIntegral_nonoutgoing_cone_highRadius_power_le
      (brrsTTStarAnnularCutoff Φ) n .middle (by simp)
  let E : Real := Cin + Cmid
  have hE : 0 < E := by
    dsimp [E]
    linarith
  let A : Real := max Aout (max 16 (2 * E / cout))
  refine ⟨A, cout / 2, ?_, by positivity, ?_⟩
  · exact le_trans (le_max_left _ _) (le_max_right _ _)
  intro a v ha hv
  let Ψ : BRRSAnnularCutoff := brrsTTStarAnnularCutoff Φ
  let O : Complex :=
    brrsStationaryWaveComponentIntegral Ψ (2 * n + 3) .outgoing a a
  let I : Complex :=
    brrsStationaryWaveComponentIntegral Ψ (2 * n + 3) .incoming a a
  let M : Complex :=
    brrsStationaryWaveComponentIntegral Ψ (2 * n + 3) .middle a a
  let K : Complex :=
    (brrsDyadicHalfWaveKernel Ψ 0 a : BRRSSpace (2 * n + 3) → Complex) (a • v)
  change cout / 2 / a ^ (n + 1) ≤ ‖K‖
  have hinner : max 16 (2 * E / cout) ≤ a :=
    le_trans (le_max_right _ _) ha
  have haout : Aout ≤ a := le_trans (le_max_left _ _) ha
  have ha16 : 16 ≤ a := le_trans (le_max_left _ _) hinner
  have hratio : 2 * E / cout ≤ a := le_trans (le_max_right _ _) hinner
  have ha0 : 0 ≤ a := by linarith
  have hapos : 0 < a := by linarith
  have hout' : cout / a ^ (n + 1) ≤ ‖O‖ := by
    dsimp [O, Ψ]
    exact hout a haout
  have hin' : ‖I‖ ≤ Cin / a ^ (n + 2) := by
    dsimp [I, Ψ]
    exact hin a ha16
  have hmid' : ‖M‖ ≤ Cmid / a ^ (n + 2) := by
    dsimp [M, Ψ]
    exact hmid a ha16
  have hsum : ‖I‖ + ‖M‖ ≤ E / a ^ (n + 2) := by
    calc
      ‖I‖ + ‖M‖ ≤ Cin / a ^ (n + 2) + Cmid / a ^ (n + 2) :=
        add_le_add hin' hmid'
      _ = E / a ^ (n + 2) := by
        dsimp [E]
        ring
  have htwoE : 2 * E ≤ a * cout :=
    (div_le_iff₀ hcout).mp hratio
  have hEover : E / a ≤ cout / 2 := by
    apply (div_le_iff₀ hapos).mpr
    nlinarith
  have hpowers : a ^ (n + 2) = a * a ^ (n + 1) := by
    rw [show n + 2 = (n + 1) + 1 by omega, pow_succ]
    ring
  have htail : E / a ^ (n + 2) ≤ (cout / 2) / a ^ (n + 1) := by
    calc
      E / a ^ (n + 2) = (E / a) / a ^ (n + 1) := by
        rw [hpowers]
        field_simp [ne_of_gt hapos]
      _ ≤ (cout / 2) / a ^ (n + 1) :=
        div_le_div_of_nonneg_right hEover (pow_nonneg ha0 _)
  have hnorm : ‖a • v‖ = a := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg ha0, hv, mul_one]
  have hsplit :=
    brrsDyadicHalfWaveKernel_eq_levelZero_sum_stationaryWaveComponents
      (d := 2 * n + 3) (by omega) Ψ a (a • v)
  rw [hnorm] at hsplit
  have hK : K = O + I + M := by
    dsimp [K, O, I, M]
    simpa only [brrsStationaryWaveComponentIntegral] using hsplit
  have htri : ‖O‖ ≤ ‖K‖ + (‖I‖ + ‖M‖) := by
    calc
      ‖O‖ = ‖K - (I + M)‖ := by
        congr 1
        rw [hK]
        ring
      _ ≤ ‖K‖ + ‖I + M‖ := norm_sub_le _ _
      _ ≤ ‖K‖ + (‖I‖ + ‖M‖) := by
        gcongr
        exact norm_add_le _ _
  have hhalf : cout / a ^ (n + 1) =
      2 * ((cout / 2) / a ^ (n + 1)) := by ring
  nlinarith [hsum.trans htail]

/-- Exact dyadic transport of the odd-dimensional positive `TT*` cone lower
bound.  At physical scale `j`, the cone point is `relativeTime • v`, while its
level-zero radius is `q * relativeTime` for `q = 2^j`; the Jacobian contributes
the literal factor `q^(2n+3)`. -/
theorem exists_brrsDyadicHalfWaveKernel_ttStar_outgoing_cone_dyadic_eventually_lower
    (Φ : BRRSAnnularCutoff) (n : Nat) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧
      ∀ (j : Nat) (relativeTime : Real) (v : BRRSSpace (2 * n + 3)),
        A ≤ (2 : Real) ^ j * relativeTime → ‖v‖ = 1 →
          ((2 : Real) ^ j) ^ (2 * n + 3) * c /
              ((2 : Real) ^ j * relativeTime) ^ (n + 1) ≤
            ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Φ) j relativeTime :
              BRRSSpace (2 * n + 3) → Complex) (relativeTime • v)‖ := by
  obtain ⟨A, c, hA, hc, hlevel⟩ :=
    exists_brrsDyadicHalfWaveKernel_ttStar_outgoing_cone_eventually_lower Φ n
  refine ⟨A, c, hA, hc, ?_⟩
  intro j relativeTime v hlarge hv
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp [q]
    positivity
  have hlarge' : A ≤ q * relativeTime := by simpa only [q] using hlarge
  have hzero := hlevel (q * relativeTime) v hlarge' hv
  have hmult :
      q ^ (2 * n + 3) * (c / (q * relativeTime) ^ (n + 1)) ≤
        q ^ (2 * n + 3) *
          ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Φ) 0
            (q * relativeTime) : BRRSSpace (2 * n + 3) → Complex)
              ((q * relativeTime) • v)‖ :=
    mul_le_mul_of_nonneg_left hzero (pow_nonneg hq.le _)
  change q ^ (2 * n + 3) * c / (q * relativeTime) ^ (n + 1) ≤
    ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Φ) j relativeTime :
      BRRSSpace (2 * n + 3) → Complex) (relativeTime • v)‖
  rw [brrsDyadicHalfWaveKernel_eq_levelZero_scaled_general]
  change q ^ (2 * n + 3) * c / (q * relativeTime) ^ (n + 1) ≤
    ‖q ^ (2 * n + 3) •
      (brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Φ) 0
        (q * relativeTime) : BRRSSpace (2 * n + 3) → Complex)
          (q • (relativeTime • v))‖
  rw [smul_smul, norm_smul, Real.norm_eq_abs,
    abs_of_nonneg (pow_nonneg hq.le _)]
  calc
    q ^ (2 * n + 3) * c / (q * relativeTime) ^ (n + 1) =
        q ^ (2 * n + 3) * (c / (q * relativeTime) ^ (n + 1)) := by ring
    _ ≤ q ^ (2 * n + 3) *
          ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Φ) 0
            (q * relativeTime) : BRRSSpace (2 * n + 3) → Complex)
              ((q * relativeTime) • v)‖ := hmult

/-- A nonzero endpoint coefficient forces the first odd quadratic stationary
moment to have its sharp eventual lower size. -/
theorem exists_quadraticMoment_one_eventually_lower_of_ne_zero
    (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) (hzero : h 0 ≠ 0) :
    ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ lambda : Real, L ≤ lambda →
      c / lambda ≤ ‖quadraticMomentIntegral 1 h lambda‖ := by
  obtain ⟨C, hC, hCbound⟩ :=
    exists_quadraticMoment_zero_decay (deriv h)
      ((contDiff_infty_iff_deriv.mp hh).2)
  let a : Real := ‖h 0‖
  have ha : 0 < a := norm_pos_iff.mpr hzero
  let B : Real := 4 * C / a
  have hB : 0 ≤ B := by
    dsimp [B]
    positivity
  refine ⟨max 1 (B ^ 2), a / 4, ?_, by positivity, ?_⟩
  · exact le_max_left _ _
  intro lambda hlambda
  have hlambda_one : 1 ≤ lambda := le_trans (le_max_left _ _) hlambda
  have hlambda_pos : 0 < lambda := lt_of_lt_of_le zero_lt_one hlambda_one
  have hsqrt_pos : 0 < Real.sqrt lambda := Real.sqrt_pos.2 hlambda_pos
  have hBsquare : B ^ 2 ≤ lambda := le_trans (le_max_right _ _) hlambda
  have hsqrt_sq : (Real.sqrt lambda) ^ 2 = lambda := Real.sq_sqrt hlambda_pos.le
  have hB_le_sqrt : B ≤ Real.sqrt lambda := by
    nlinarith
  have hfourC : 4 * C ≤ Real.sqrt lambda * a := by
    dsimp [B] at hB_le_sqrt
    exact (div_le_iff₀ ha).mp hB_le_sqrt
  have hrest : ‖quadraticMomentIntegral 0 (deriv h) lambda‖ ≤ a / 4 := by
    calc
      ‖quadraticMomentIntegral 0 (deriv h) lambda‖ ≤ C / Real.sqrt lambda :=
        hCbound lambda hlambda_one
      _ ≤ a / 4 := by
        rw [div_le_iff₀ hsqrt_pos]
        nlinarith
  have hsum : 3 * a / 4 ≤
      ‖h 0 + quadraticMomentIntegral 0 (deriv h) lambda‖ := by
    have htriangle : ‖h 0‖ ≤
        ‖h 0 + quadraticMomentIntegral 0 (deriv h) lambda‖ +
          ‖quadraticMomentIntegral 0 (deriv h) lambda‖ := by
      calc
        ‖h 0‖ = ‖(h 0 + quadraticMomentIntegral 0 (deriv h) lambda) -
            quadraticMomentIntegral 0 (deriv h) lambda‖ := by ring_nf
        _ ≤ ‖h 0 + quadraticMomentIntegral 0 (deriv h) lambda‖ +
            ‖quadraticMomentIntegral 0 (deriv h) lambda‖ := norm_sub_le _ _
    change 3 * a / 4 ≤ _
    linarith
  have hformula := quadraticMomentIntegral_one_recurrence h hh hvanish
    (ne_of_gt hlambda_pos)
  have hqnorm : ‖((2 * lambda : Real) : Complex) * Complex.I‖ = 2 * lambda := by
    have htwo : 0 ≤ 2 * lambda := by nlinarith
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, Complex.norm_I,
      abs_of_nonneg htwo]
    simp
  have hscalar : ‖-((((2 * lambda : Real) : Complex) * Complex.I)⁻¹)‖ =
      1 / (2 * lambda) := by
    rw [norm_neg, norm_inv, hqnorm]
    simp
  rw [hformula, norm_mul, hscalar]
  calc
    a / 4 / lambda ≤ (3 * a / 8) / lambda := by
      apply div_le_div_of_nonneg_right
      · nlinarith
      · exact hlambda_pos.le
    _ = (1 / (2 * lambda)) * (3 * a / 4) := by
      field_simp
      ring
    _ ≤ (1 / (2 * lambda)) *
        ‖h 0 + quadraticMomentIntegral 0 (deriv h) lambda‖ := by
      exact mul_le_mul_of_nonneg_left hsum (by positivity)

/-- The concrete nonplanar endpoint symbol in dimension three therefore has
the sharp eventual `lambda⁻¹` lower size. -/
theorem exists_smoothEndpointQuadraticIntegral_one_eventually_lower :
    ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ lambda : Real, L ≤ lambda →
      c / lambda ≤ ‖smoothEndpointQuadraticIntegral 1 lambda‖ := by
  obtain ⟨L, c, hL, hc, hbound⟩ :=
    exists_quadraticMoment_one_eventually_lower_of_ne_zero
      (smoothEndpointProfile 1) (contDiff_smoothEndpointProfile 1)
      (smoothEndpointProfile_eventuallyEq_zero_at_one 1)
      (brrs_smoothEndpointProfile_zero_ne_zero 1)
  refine ⟨L, c, hL, hc, ?_⟩
  intro lambda hlambda
  rw [smoothEndpointQuadraticIntegral_eq_quadraticMomentIntegral]
  exact hbound lambda hlambda

/-- The same dimension-three endpoint lower bound is valid for both signs of
the stationary parameter.  This is the form used by the outgoing and
incoming half-wave phases. -/
theorem exists_smoothEndpointQuadraticIntegral_one_eventually_lower_abs :
    ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ lambda : Real, L ≤ |lambda| →
      c / |lambda| ≤ ‖smoothEndpointQuadraticIntegral 1 lambda‖ := by
  obtain ⟨L, c, hL, hc, hbound⟩ :=
    exists_smoothEndpointQuadraticIntegral_one_eventually_lower
  refine ⟨L, c, hL, hc, ?_⟩
  intro lambda hlambda
  rcases le_total 0 lambda with hnonneg | hnonpos
  · have hlarge : L ≤ lambda := by
      simpa [abs_of_nonneg hnonneg] using hlambda
    simpa [abs_of_nonneg hnonneg] using hbound lambda hlarge
  · by_cases hzero : lambda = 0
    · subst lambda
      norm_num at hlambda
      linarith
    · have hneg : lambda < 0 := lt_of_le_of_ne hnonpos hzero
      have hlarge : L ≤ -lambda := by
        simpa [abs_of_neg hneg] using hlambda
      have hpositive := hbound (-lambda) hlarge
      calc
        c / |lambda| = c / (-lambda) := by rw [abs_of_neg hneg]
        _ ≤ ‖smoothEndpointQuadraticIntegral 1 (-lambda)‖ := hpositive
        _ = ‖smoothEndpointQuadraticIntegral 1 lambda‖ := by
          simpa only [neg_neg] using
            (norm_smoothEndpointQuadraticIntegral_neg 1 (-lambda)).symm

/-- At the even remainder orders occurring in the odd-moment recurrence, the
quadratic stationary scale is exactly one extra square-root beyond an
integral power of `lambda`. -/
private theorem brrs_quadraticMomentScale_even_remainder
    (n : Nat) {lambda : Real} (hlambda : 0 ≤ lambda) :
    quadraticMomentScale (2 * n + 2) lambda =
      lambda ^ (n + 1) * Real.sqrt lambda := by
  unfold quadraticMomentScale
  have hsquare : Real.sqrt lambda ^ 2 = lambda := Real.sq_sqrt hlambda
  calc
    Real.sqrt lambda ^ (2 * n + 2 + 1) =
        Real.sqrt lambda ^ (2 * (n + 1) + 1) := by congr 1
    _ = (Real.sqrt lambda ^ (2 * (n + 1))) * Real.sqrt lambda := by
      rw [show 2 * (n + 1) + 1 = Nat.succ (2 * (n + 1)) by omega, pow_succ]
    _ = (Real.sqrt lambda ^ 2) ^ (n + 1) * Real.sqrt lambda := by
      rw [← pow_mul]
    _ = lambda ^ (n + 1) * Real.sqrt lambda := by rw [hsquare]

/-- The leading stationary scale of an even endpoint moment. -/
private theorem brrs_quadraticMomentScale_even
    (n : Nat) {lambda : Real} (hlambda : 0 ≤ lambda) :
    quadraticMomentScale (2 * n) lambda =
      lambda ^ n * Real.sqrt lambda := by
  unfold quadraticMomentScale
  have hsquare : Real.sqrt lambda ^ 2 = lambda := Real.sq_sqrt hlambda
  calc
    Real.sqrt lambda ^ (2 * n + 1) =
        (Real.sqrt lambda ^ (2 * n)) * Real.sqrt lambda := by
      rw [show 2 * n + 1 = Nat.succ (2 * n) by omega, pow_succ]
    _ = (Real.sqrt lambda ^ 2) ^ n * Real.sqrt lambda := by
      rw [← pow_mul]
    _ = lambda ^ n * Real.sqrt lambda := by rw [hsquare]

/-- The derivative remainder in an even-order recurrence has integral-power
stationary scale. -/
private theorem brrs_quadraticMomentScale_odd
    (n : Nat) {lambda : Real} (hlambda : 0 ≤ lambda) :
    quadraticMomentScale (2 * n + 1) lambda = lambda ^ (n + 1) := by
  unfold quadraticMomentScale
  have hsquare : Real.sqrt lambda ^ 2 = lambda := Real.sq_sqrt hlambda
  calc
    Real.sqrt lambda ^ (2 * n + 1 + 1) =
        Real.sqrt lambda ^ (2 * (n + 1)) := by congr 1
    _ = (Real.sqrt lambda ^ 2) ^ (n + 1) := by rw [pow_mul]
    _ = lambda ^ (n + 1) := by rw [hsquare]

/-- For the literal odd meridional profile, every even derivative moment
has the one-full-power improvement forced by the stationary factor in its
derivative.  The cutoff-derivative term is a compact nonstationary tail. -/
private theorem exists_quadraticMoment_even_deriv_smoothEndpointProfile_odd_decay
    (n k : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
      ‖quadraticMomentIntegral (2 * k + 2)
          (deriv (smoothEndpointProfile (2 * n + 1))) lambda‖ ≤
        C / lambda ^ (k + 2) := by
  let C0 : Real → Complex := fun v => (endpointCoreCutoff v : Complex)
  let P : Real → Complex := fun v => ((2 * (2 - v ^ 2) ^ n : Real) : Complex)
  let G : Real → Complex := fun v =>
    ((-4 * (n : Real) * (2 - v ^ 2) ^ (n - 1) : Real) : Complex) * C0 v
  let R : Real → Complex := fun v => P v * deriv C0 v
  let Rk : Real → Complex := fun v => ((v ^ (2 * k + 2) : Real) : Complex) * R v
  have hC0 : ContDiff Real (⊤ : ℕ∞) C0 := by
    change ContDiff Real (⊤ : ℕ∞)
      ((Complex.ofRealCLM : Real →L[Real] Complex) ∘ endpointCoreBump)
    exact Complex.ofRealCLM.contDiff.comp endpointCoreBump.contDiff
  have hC0' : ContDiff Real (⊤ : ℕ∞) (deriv C0) :=
    (contDiff_infty_iff_deriv.mp hC0).2
  have hP : ContDiff Real (⊤ : ℕ∞) P := by
    change ContDiff Real (⊤ : ℕ∞)
      ((Complex.ofRealCLM : Real →L[Real] Complex) ∘
        fun v : Real => 2 * (2 - v ^ 2) ^ n)
    apply Complex.ofRealCLM.contDiff.comp
    fun_prop
  have hG : ContDiff Real (⊤ : ℕ∞) G := by
    have hpoly : ContDiff Real (⊤ : ℕ∞)
        ((Complex.ofRealCLM : Real →L[Real] Complex) ∘
          fun v : Real => -4 * (n : Real) * (2 - v ^ 2) ^ (n - 1)) := by
      apply Complex.ofRealCLM.contDiff.comp
      fun_prop
    exact hpoly.mul hC0
  have hR : ContDiff Real (⊤ : ℕ∞) R := hP.mul hC0'
  have hRk : ContDiff Real (⊤ : ℕ∞) Rk := by
    have hmonomial : ContDiff Real (⊤ : ℕ∞)
        (fun v : Real => ((v ^ (2 * k + 2) : Real) : Complex)) := by
      change ContDiff Real (⊤ : ℕ∞)
        ((Complex.ofRealCLM : Real →L[Real] Complex) ∘
          fun v : Real => v ^ (2 * k + 2))
      exact Complex.ofRealCLM.contDiff.comp (contDiff_id.pow _)
    exact hmonomial.mul hR
  have hGvanish : VanishesNearOne G := by
    filter_upwards [brrs_endpointCoreCutoff_eventuallyEq_zero_at_one] with u hu
    have hu' : (endpointCoreCutoff u : Complex) = 0 := by simpa using hu
    dsimp [G, C0]
    rw [hu']
    ring
  have hRzero (u : Real) (hu : |u| < (1 / 8 : Real)) : R u = 0 := by
    dsimp [R]
    rw [show deriv C0 u = 0 by
      simpa [C0] using brrs_deriv_endpointCoreCutoff_eq_zero_of_abs_lt_one_eighth hu]
    ring
  have hRleft : R =ᶠ[nhds (1 / 16 : Real)] 0 := by
    filter_upwards [Metric.ball_mem_nhds (1 / 16 : Real)
      (by norm_num : (0 : Real) < 1 / 32)] with u hu
    rw [Metric.mem_ball, Real.dist_eq] at hu
    have hu' := abs_lt.mp hu
    have hupos : 0 < u := by linarith [hu'.1]
    have habs : |u| < (1 / 8 : Real) := by
      rw [abs_of_pos hupos]
      linarith [hu'.2]
    simpa only [Pi.zero_apply] using hRzero u habs
  have hRright : R =ᶠ[nhds (1 : Real)] 0 := by
    have hC0right : deriv C0 =ᶠ[nhds (1 : Real)] 0 := by
      have hC0zero : C0 =ᶠ[nhds (1 : Real)] 0 := by
        simpa [C0] using brrs_endpointCoreCutoff_eventuallyEq_zero_at_one
      exact hC0zero.deriv.trans (Filter.Eventually.of_forall fun u => by simp)
    filter_upwards [hC0right] with u hu
    simp only [Pi.zero_apply] at hu
    dsimp [R]
    rw [hu]
    ring
  have hRkleft : Rk =ᶠ[nhds (1 / 16 : Real)] 0 := by
    filter_upwards [hRleft] with u hu
    have hu' : R u = 0 := by simpa only [Pi.zero_apply] using hu
    dsimp [Rk]
    rw [hu']
    ring
  have hRkright : Rk =ᶠ[nhds (1 : Real)] 0 := by
    filter_upwards [hRright] with u hu
    have hu' : R u = 0 := by simpa only [Pi.zero_apply] using hu
    dsimp [Rk]
    rw [hu']
    ring
  have hRkrapid := brrs_quadratic_cutoff_tail_hasRapidDecay Rk hRk hRkleft hRkright
  obtain ⟨D, hD, hDtail⟩ := hRkrapid (k + 2) 0
  obtain ⟨E, hE, hEmoment⟩ :=
    exists_quadraticMoment_decay (2 * k + 3) G hG hGvanish
  let C : Real := E + D
  have hC : 0 < C := by
    dsimp [C]
    positivity
  refine ⟨C, hC, ?_⟩
  intro lambda hlambda
  have hlambda_pos : 0 < lambda := lt_of_lt_of_le zero_lt_one hlambda
  let phase : Real → Complex := fun u =>
    Complex.exp (((lambda * u ^ 2 : Real) : Complex) * Complex.I)
  have hphase : Continuous phase := by
    dsimp [phase]
    fun_prop
  have hRktail_identity :
      quadraticMomentIntegral 0 Rk lambda =
        ∫ u in (1 / 16 : Real)..1, Rk u * phase u := by
    have hzero : (∫ u in (0 : Real)..(1 / 16 : Real), Rk u * phase u) = 0 := by
      calc
        (∫ u in (0 : Real)..(1 / 16 : Real), Rk u * phase u) =
            ∫ u in (0 : Real)..(1 / 16 : Real), 0 := by
          apply intervalIntegral.integral_congr
          intro u hu
          have hu' : u ∈ Set.Icc (0 : Real) (1 / 16 : Real) := by
            simpa [Set.uIcc_of_le (by norm_num : (0 : Real) ≤ 1 / 16)] using hu
          have habs : |u| < (1 / 8 : Real) := by
            rw [abs_of_nonneg hu'.1]
            linarith [hu'.2]
          change Rk u * phase u = 0
          dsimp [Rk]
          rw [hRzero u habs]
          ring
        _ = 0 := by simp
    have hcont : Continuous (fun u : Real => Rk u * phase u) := hRk.continuous.mul hphase
    unfold quadraticMomentIntegral
    simp only [pow_zero, Complex.ofReal_one, one_mul]
    rw [← intervalIntegral.integral_add_adjacent_intervals
      (hcont.intervalIntegrable 0 (1 / 16))
      (hcont.intervalIntegrable (1 / 16) 1), hzero, zero_add]
  have hRmoment :
      quadraticMomentIntegral (2 * k + 2) R lambda = quadraticMomentIntegral 0 Rk lambda := by
    unfold quadraticMomentIntegral
    simp only [pow_zero, Complex.ofReal_one, one_mul]
    apply intervalIntegral.integral_congr
    intro u hu
    dsimp [Rk]
  have hRbound : ‖quadraticMomentIntegral (2 * k + 2) R lambda‖ ≤
      D / lambda ^ (k + 2) := by
    rw [hRmoment, hRktail_identity]
    simpa [iteratedDeriv_zero, phase] using hDtail lambda hlambda
  have hGbound : ‖quadraticMomentIntegral (2 * k + 3) G lambda‖ ≤
      E / lambda ^ (k + 2) := by
    calc
      ‖quadraticMomentIntegral (2 * k + 3) G lambda‖ ≤
          E / quadraticMomentScale (2 * k + 3) lambda := hEmoment lambda hlambda
      _ = E / lambda ^ (k + 2) := by
        rw [show 2 * k + 3 = 2 * (k + 1) + 1 by omega,
          brrs_quadraticMomentScale_odd (k + 1) hlambda_pos.le]
  have hsplit :
      quadraticMomentIntegral (2 * k + 2)
          (deriv (smoothEndpointProfile (2 * n + 1))) lambda =
        quadraticMomentIntegral (2 * k + 3) G lambda +
          quadraticMomentIntegral (2 * k + 2) R lambda := by
    have hGint : Continuous (fun u : Real =>
        ((u ^ (2 * k + 3) : Real) : Complex) * G u * phase u) := by
      fun_prop
    have hRint : Continuous (fun u : Real =>
        ((u ^ (2 * k + 2) : Real) : Complex) * R u * phase u) := by
      fun_prop
    unfold quadraticMomentIntegral
    rw [← intervalIntegral.integral_add
      (hGint.intervalIntegrable 0 1) (hRint.intervalIntegrable 0 1)]
    apply intervalIntegral.integral_congr
    intro u hu
    change ((u ^ (2 * k + 2) : Real) : Complex) *
        deriv (smoothEndpointProfile (2 * n + 1)) u * phase u =
      ((u ^ (2 * k + 3) : Real) : Complex) * G u * phase u +
        ((u ^ (2 * k + 2) : Real) : Complex) * R u * phase u
    rw [brrs_deriv_smoothEndpointProfile_odd_eq]
    dsimp [G, R, P, C0]
    rw [show 2 * k + 3 = (2 * k + 2) + 1 by omega, pow_succ]
    push_cast
    ring
  rw [hsplit]
  calc
    ‖quadraticMomentIntegral (2 * k + 3) G lambda +
        quadraticMomentIntegral (2 * k + 2) R lambda‖ ≤
        ‖quadraticMomentIntegral (2 * k + 3) G lambda‖ +
          ‖quadraticMomentIntegral (2 * k + 2) R lambda‖ := norm_add_le _ _
    _ ≤ E / lambda ^ (k + 2) + D / lambda ^ (k + 2) :=
      add_le_add hGbound hRbound
    _ = C / lambda ^ (k + 2) := by
      dsimp [C]
      ring

/-- The literal odd meridional endpoint has its fixed leading stationary
coefficient with a full one-inverse-frequency normalized remainder.  This is
the odd-parity component missing from the all-dimensional replacement for the
Bessel expansion in BRRS (3.3). -/
theorem exists_smoothEndpointQuadraticIntegral_odd_leading_asymptotic_sharp
    (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
      ‖(((2 * lambda : Real) : Complex) * Complex.I) ^ (n + 1) *
          smoothEndpointQuadraticIntegral (2 * n + 1) lambda -
            brrsOddQuadraticLeadingCoefficient n *
              smoothEndpointProfile (2 * n + 1) 0‖ ≤ C / lambda := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_quadraticMoment_odd_leading_asymptotic_sharp_of_deriv_bounds
      (smoothEndpointProfile (2 * n + 1))
      (contDiff_smoothEndpointProfile (2 * n + 1))
      (smoothEndpointProfile_eventuallyEq_zero_at_one (2 * n + 1))
      (exists_quadraticMoment_zero_deriv_smoothEndpointProfile_odd_decay n)
      (fun k =>
        exists_quadraticMoment_even_deriv_smoothEndpointProfile_odd_decay n k)
      n
  refine ⟨C, hC, ?_⟩
  intro lambda hlambda
  rw [smoothEndpointQuadraticIntegral_eq_quadraticMomentIntegral]
  exact hbound lambda hlambda

/-- The outgoing odd-dimensional surface wave has the exact fixed stationary
carrier and a full one-inverse-frequency normalized remainder. -/
theorem exists_brrsSurfaceWaveAmplitude_outgoing_odd_leading_asymptotic_sharp
    (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ a rho : Real, 1 ≤ (2 * Real.pi * a) * rho →
      ‖(((2 * ((2 * Real.pi * a) * rho) : Real) : Complex) * Complex.I) ^
            (n + 1) *
          brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho -
            (surfaceMass (2 * n + 2) : Complex) *
              (brrsOddQuadraticLeadingCoefficient n *
                smoothEndpointProfile (2 * n + 1) 0)‖ ≤
        C / ((2 * Real.pi * a) * rho) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_smoothEndpointQuadraticIntegral_odd_leading_asymptotic_sharp n
  let mass : Real := surfaceMass (2 * n + 2)
  have hmass : 0 < mass := by
    dsimp [mass]
    exact surfaceMass_pos (by omega)
  refine ⟨mass * C, mul_pos hmass hC, ?_⟩
  intro a rho hlambda
  let lambda : Real := (2 * Real.pi * a) * rho
  have hmain := hbound lambda (by simpa [lambda] using hlambda)
  have hdim_one : (2 * n + 3) - 1 = 2 * n + 2 := by omega
  have hdim_two : (2 * n + 3) - 2 = 2 * n + 1 := by omega
  have hamp :
      brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho =
        (mass : Complex) * smoothEndpointQuadraticIntegral (2 * n + 1) lambda := by
    unfold brrsSurfaceWaveAmplitude
    dsimp [lambda, mass]
    rw [hdim_two]
  rw [hamp]
  have hfactor :
      (((2 * lambda : Real) : Complex) * Complex.I) ^ (n + 1) *
          ((mass : Complex) * smoothEndpointQuadraticIntegral (2 * n + 1) lambda) -
            (mass : Complex) *
              (brrsOddQuadraticLeadingCoefficient n *
                smoothEndpointProfile (2 * n + 1) 0) =
        (mass : Complex) *
          ((((2 * lambda : Real) : Complex) * Complex.I) ^ (n + 1) *
            smoothEndpointQuadraticIntegral (2 * n + 1) lambda -
              brrsOddQuadraticLeadingCoefficient n *
                smoothEndpointProfile (2 * n + 1) 0) := by
      ring
  rw [show (2 * Real.pi * a) * rho = lambda by rfl, hfactor, norm_mul,
    Complex.norm_real, Real.norm_eq_abs, abs_of_pos hmass]
  calc
    mass * ‖(((2 * lambda : Real) : Complex) * Complex.I) ^ (n + 1) *
        smoothEndpointQuadraticIntegral (2 * n + 1) lambda -
          brrsOddQuadraticLeadingCoefficient n *
            smoothEndpointProfile (2 * n + 1) 0‖ ≤
        mass * (C / lambda) :=
      mul_le_mul_of_nonneg_left hmain hmass.le
    _ = (mass * C) / lambda := by ring

/-- The incoming odd-dimensional surface wave is the conjugate stationary
branch, with the same full one-inverse-frequency normalized remainder. -/
theorem exists_brrsSurfaceWaveAmplitude_incoming_odd_leading_asymptotic_sharp
    (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ a rho : Real, 1 ≤ (2 * Real.pi * a) * rho →
      ‖(-(((2 * ((2 * Real.pi * a) * rho) : Real) : Complex) * Complex.I)) ^
            (n + 1) *
          brrsSurfaceWaveAmplitude (2 * n + 3) .incoming a rho -
            starRingEnd Complex
              ((surfaceMass (2 * n + 2) : Complex) *
                (brrsOddQuadraticLeadingCoefficient n *
                  smoothEndpointProfile (2 * n + 1) 0))‖ ≤
        C / ((2 * Real.pi * a) * rho) := by
  obtain ⟨C, hC, hout⟩ :=
    exists_brrsSurfaceWaveAmplitude_outgoing_odd_leading_asymptotic_sharp n
  refine ⟨C, hC, ?_⟩
  intro a rho hlambda
  let lambda : Real := (2 * Real.pi * a) * rho
  let q : Complex := ((2 * lambda : Real) : Complex) * Complex.I
  let Aout : Complex := brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho
  let Ain : Complex := brrsSurfaceWaveAmplitude (2 * n + 3) .incoming a rho
  let K : Complex := (surfaceMass (2 * n + 2) : Complex) *
    (brrsOddQuadraticLeadingCoefficient n *
      smoothEndpointProfile (2 * n + 1) 0)
  have hmain : ‖q ^ (n + 1) * Aout - K‖ ≤ C / lambda := by
    dsimp [lambda, q, Aout, K]
    exact hout a rho hlambda
  have hAin : Ain = starRingEnd Complex Aout := by
    dsimp [Ain, Aout]
    exact brrsSurfaceWaveAmplitude_incoming_eq_conj_outgoing (2 * n + 3) a rho
  have hstarq : starRingEnd Complex q = -q := by
    dsimp [q]
    simp only [map_mul, Complex.conj_ofReal, Complex.conj_I]
    ring
  have hrewrite :
      (-q) ^ (n + 1) * Ain - starRingEnd Complex K =
        starRingEnd Complex (q ^ (n + 1) * Aout - K) := by
    simp only [map_sub, map_mul, map_pow]
    rw [hAin, hstarq, neg_pow]
  change ‖(-q) ^ (n + 1) * Ain - starRingEnd Complex K‖ ≤ C / lambda
  rw [hrewrite, RCLike.norm_conj]
  exact hmain

/-- In every odd spatial dimension, the actual surface Fourier factor has an
exact outgoing/incoming/middle decomposition whose two stationary amplitudes
have their explicit leading carriers with a full one-inverse-frequency
remainder, and whose middle amplitude is arbitrarily rapidly decaying.  This
is the odd-dimensional literal replacement for the Bessel expansion used in
BRRS (3.3). -/
theorem exists_brrs_surfaceFourier_odd_threeWave_leading_remainder
    (n N : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ (x : BRRSSpace (2 * n + 3)) (rho : Real),
      0 < rho → 1 ≤ (2 * Real.pi * ‖x‖) * rho →
        surfaceFourier (2 * n + 3) (-rho • x) =
          brrsSurfaceWaveTerm (2 * n + 3) .outgoing ‖x‖ rho +
            brrsSurfaceWaveTerm (2 * n + 3) .incoming ‖x‖ rho +
              brrsSurfaceWaveTerm (2 * n + 3) .middle ‖x‖ rho ∧
        ‖(((2 * ((2 * Real.pi * ‖x‖) * rho) : Real) : Complex) * Complex.I) ^
              (n + 1) *
            brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing ‖x‖ rho -
              (surfaceMass (2 * n + 2) : Complex) *
                (brrsOddQuadraticLeadingCoefficient n *
                  smoothEndpointProfile (2 * n + 1) 0)‖ ≤
            C / ((2 * Real.pi * ‖x‖) * rho) ∧
        ‖(-(((2 * ((2 * Real.pi * ‖x‖) * rho) : Real) : Complex) * Complex.I)) ^
              (n + 1) *
            brrsSurfaceWaveAmplitude (2 * n + 3) .incoming ‖x‖ rho -
              starRingEnd Complex
                ((surfaceMass (2 * n + 2) : Complex) *
                  (brrsOddQuadraticLeadingCoefficient n *
                    smoothEndpointProfile (2 * n + 1) 0))‖ ≤
            C / ((2 * Real.pi * ‖x‖) * rho) ∧
        ‖brrsSurfaceWaveAmplitude (2 * n + 3) .middle ‖x‖ rho‖ ≤
          C / ((2 * Real.pi * ‖x‖) * rho) ^ N := by
  obtain ⟨Cbase, hCbase, hbase⟩ :=
    exists_brrs_surfaceFourier_threeWave_replacement_bounds (2 * n + 3) N (by omega)
  obtain ⟨Cout, hCout, hout⟩ :=
    exists_brrsSurfaceWaveAmplitude_outgoing_odd_leading_asymptotic_sharp n
  obtain ⟨Cin, hCin, hin⟩ :=
    exists_brrsSurfaceWaveAmplitude_incoming_odd_leading_asymptotic_sharp n
  let C : Real := Cbase + Cout + Cin
  have hC : 0 < C := by
    dsimp [C]
    positivity
  refine ⟨C, hC, ?_⟩
  intro x rho hrho hlambda
  let lambda : Real := (2 * Real.pi * ‖x‖) * rho
  have hlambda_pos : 0 < lambda := lt_of_lt_of_le zero_lt_one (by simpa [lambda] using hlambda)
  have hlargeabs : 1 ≤ |(2 * Real.pi * ‖x‖) * rho| := by
    simpa [lambda, abs_of_nonneg hlambda_pos.le] using hlambda
  obtain ⟨hexact, -, -, hmiddle⟩ := hbase x rho hrho hlargeabs
  refine ⟨hexact, ?_, ?_, ?_⟩
  · have hmain := hout ‖x‖ rho hlambda
    calc
      ‖(((2 * ((2 * Real.pi * ‖x‖) * rho) : Real) : Complex) * Complex.I) ^
            (n + 1) *
          brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing ‖x‖ rho -
            (surfaceMass (2 * n + 2) : Complex) *
              (brrsOddQuadraticLeadingCoefficient n *
                smoothEndpointProfile (2 * n + 1) 0)‖ ≤
          Cout / lambda := by
        simpa [lambda] using hmain
      _ ≤ C / lambda := by
        apply div_le_div_of_nonneg_right
        · dsimp [C]
          linarith
        · exact hlambda_pos.le
      _ = C / ((2 * Real.pi * ‖x‖) * rho) := by rfl
  · have hmain := hin ‖x‖ rho hlambda
    calc
      ‖(-(((2 * ((2 * Real.pi * ‖x‖) * rho) : Real) : Complex) * Complex.I)) ^
            (n + 1) *
          brrsSurfaceWaveAmplitude (2 * n + 3) .incoming ‖x‖ rho -
            starRingEnd Complex
              ((surfaceMass (2 * n + 2) : Complex) *
                (brrsOddQuadraticLeadingCoefficient n *
                  smoothEndpointProfile (2 * n + 1) 0))‖ ≤
          Cin / lambda := by
        simpa [lambda] using hmain
      _ ≤ C / lambda := by
        apply div_le_div_of_nonneg_right
        · dsimp [C]
          linarith
        · exact hlambda_pos.le
      _ = C / ((2 * Real.pi * ‖x‖) * rho) := by rfl
  · calc
      ‖brrsSurfaceWaveAmplitude (2 * n + 3) .middle ‖x‖ rho‖ ≤
          Cbase / |(2 * Real.pi * ‖x‖) * rho| ^ N := hmiddle
      _ = Cbase / lambda ^ N := by
        rw [show |(2 * Real.pi * ‖x‖) * rho| = lambda by
          simpa [lambda] using abs_of_nonneg hlambda_pos.le]
      _ ≤ C / lambda ^ N := by
        apply div_le_div_of_nonneg_right
        · dsimp [C]
          linarith
        · exact (pow_pos hlambda_pos N).le
      _ = C / ((2 * Real.pi * ‖x‖) * rho) ^ N := by rfl

/-! ### A normalized finite Fresnel lower bound

The elementary unit-quadratic Fresnel integral is the analytic base case for
the order-zero stationary term.  The estimate below deliberately concerns a
finite truncation only: its proof keeps a positive core on `[0, 3 / 2]` and
controls the remaining finite tail by the proved quadratic-phase integration
by-parts estimate.  Thus it does not invoke, or conceal, an improper-integral
asymptotic. -/

/-- The unit-scale truncated quadratic Fresnel integral.  This normalization
is the one obtained from `∫₀¹ exp (i λ u²) du` after the substitution
`v = sqrt λ * u`. -/
noncomputable def brrsNormalizedQuadraticFresnelIntegral (R : Real) : Complex :=
  intervalIntegral
    (fun u => Complex.exp (((u ^ 2 : Real) : Complex) * Complex.I)) 0 R volume

private theorem brrsNormalizedQuadraticFresnelIntegrand_im (u : Real) :
    (Complex.exp (((u ^ 2 : Real) : Complex) * Complex.I)).im =
      Real.sin (u ^ 2) := by
  rw [Complex.exp_ofReal_mul_I]
  rw [Complex.add_im, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
    Complex.I_re, Complex.I_im]
  ring

private theorem brrsNormalizedQuadraticFresnel_core_polynomial_integral :
    intervalIntegral (fun u => u ^ 2 - u ^ 6 / 6) 0 (3 / 2) volume =
      (1287 / 1792 : Real) := by
  rw [intervalIntegral.integral_sub]
  · rw [integral_pow, intervalIntegral.integral_div, integral_pow]
    norm_num
  · exact (continuous_pow 2).intervalIntegrable _ _
  · exact ((continuous_pow 6).div continuous_const (by norm_num)).intervalIntegrable _ _

private theorem brrsNormalizedQuadraticFresnel_core_lower :
    (1287 / 1792 : Real) ≤
      intervalIntegral (fun u => Real.sin (u ^ 2)) 0 (3 / 2) volume := by
  rw [← brrsNormalizedQuadraticFresnel_core_polynomial_integral]
  apply intervalIntegral.integral_mono
  · norm_num
  · exact ((continuous_pow 2).sub
      ((continuous_pow 6).div continuous_const (by norm_num))).intervalIntegrable _ _
  · exact (Real.continuous_sin.comp (continuous_pow 2)).intervalIntegrable _ _
  intro u
  simpa [show (u ^ 2) ^ 3 = u ^ 6 by ring] using
    (Real.sin_ge_sub_cube (sq_nonneg u))

/-- An explicit lower bound for every sufficiently long normalized quadratic
Fresnel truncation.  The positive core is bounded below using
`sin_ge_sub_cube`; the tail from `3 / 2` to `R` is bounded by
`quadratic_phase_tail_norm_le_inv`. -/
theorem brrsNormalizedQuadraticFresnelIntegral_norm_lower
    (R : Real) (hR : (3 / 2 : Real) ≤ R) :
    (277 / 5376 : Real) ≤ norm (brrsNormalizedQuadraticFresnelIntegral R) := by
  let F : Real -> Complex := fun u =>
    Complex.exp (((u ^ 2 : Real) : Complex) * Complex.I)
  have hFcont : Continuous F := by
    dsimp [F]
    apply Complex.continuous_exp.comp
    exact (Complex.continuous_ofReal.comp (continuous_pow 2)).mul continuous_const
  have hFim : ∀ a b : Real,
      (intervalIntegral F a b volume).im =
        intervalIntegral (fun u => Real.sin (u ^ 2)) a b volume := by
    intro a b
    calc
      (intervalIntegral F a b volume).im =
          intervalIntegral (fun u => (F u).im) a b volume :=
        (intervalIntegral.intervalIntegral_im (hFcont.intervalIntegrable a b)).symm
      _ = intervalIntegral (fun u => Real.sin (u ^ 2)) a b volume := by
        apply intervalIntegral.integral_congr
        intro u _
        exact brrsNormalizedQuadraticFresnelIntegrand_im u
  have hcore : (1287 / 1792 : Real) ≤
      (intervalIntegral F 0 (3 / 2) volume).im := by
    rw [hFim]
    exact brrsNormalizedQuadraticFresnel_core_lower
  have htailnorm : norm (intervalIntegral F (3 / 2) R volume) ≤ (2 / 3 : Real) := by
    have htail := quadratic_phase_tail_norm_le_inv (a := (3 / 2 : Real)) (b := R) (c := 1)
      (by norm_num) hR (by norm_num)
    simpa only [F, one_mul, inv_div] using htail
  have htail : -(2 / 3 : Real) ≤ (intervalIntegral F (3 / 2) R volume).im := by
    apply neg_le_of_abs_le
    exact (Complex.abs_im_le_norm _).trans htailnorm
  have hsplit :
      intervalIntegral F 0 (3 / 2) volume + intervalIntegral F (3 / 2) R volume =
        intervalIntegral F 0 R volume :=
    intervalIntegral.integral_add_adjacent_intervals
      (hFcont.intervalIntegrable 0 (3 / 2))
      (hFcont.intervalIntegrable (3 / 2) R)
  have him : (277 / 5376 : Real) ≤ (intervalIntegral F 0 R volume).im := by
    calc
      (277 / 5376 : Real) = 1287 / 1792 - 2 / 3 := by norm_num
      _ ≤ (intervalIntegral F 0 (3 / 2) volume).im +
          (intervalIntegral F (3 / 2) R volume).im := by linarith
      _ = (intervalIntegral F 0 R volume).im := by
        rw [← hsplit]
        rfl
  change (277 / 5376 : Real) ≤ norm (intervalIntegral F 0 R volume)
  exact him.trans (Complex.im_le_norm _)

/-- Existentially packaged form of the uniform finite-truncation lower bound.
It records the concrete threshold and positive constant separately so that it
can be used as a scale-normalized stationary-phase input. -/
theorem exists_brrsNormalizedQuadraticFresnelIntegral_eventually_norm_lower :
    ∃ B c : Real, (3 / 2 : Real) ≤ B ∧ 0 < c ∧ ∀ R : Real, B ≤ R →
      c ≤ norm (brrsNormalizedQuadraticFresnelIntegral R) := by
  refine ⟨3 / 2, 277 / 5376, by norm_num, by norm_num, ?_⟩
  intro R hR
  exact brrsNormalizedQuadraticFresnelIntegral_norm_lower R hR

/-- The difference of two finite normalized Fresnel truncations is precisely
the intervening nonstationary tail.  Keeping this as an exact identity makes
the subsequent coherent-carrier estimate independent of any improper
integral. -/
theorem brrsNormalizedQuadraticFresnelIntegral_sub_eq_tail
    (R0 R : Real) :
    brrsNormalizedQuadraticFresnelIntegral R -
        brrsNormalizedQuadraticFresnelIntegral R0 =
      intervalIntegral
        (fun u => Complex.exp (((u ^ 2 : Real) : Complex) * Complex.I))
        R0 R volume := by
  let F : Real -> Complex := fun u =>
    Complex.exp (((u ^ 2 : Real) : Complex) * Complex.I)
  have hFcont : Continuous F := by
    dsimp [F]
    apply Complex.continuous_exp.comp
    exact (Complex.continuous_ofReal.comp (continuous_pow 2)).mul continuous_const
  change intervalIntegral F 0 R volume - intervalIntegral F 0 R0 volume =
    intervalIntegral F R0 R volume
  rw [← intervalIntegral.integral_add_adjacent_intervals
    (hFcont.intervalIntegrable 0 R0) (hFcont.intervalIntegrable R0 R)]
  abel

/-- Quantitative Cauchy control of the finite normalized Fresnel truncations.
For a fixed positive cutoff `R0`, all later truncations lie within `R0⁻¹` of
the same complex value. -/
theorem brrsNormalizedQuadraticFresnelIntegral_tail_distance_le
    {R0 R : Real} (hR0 : 0 < R0) (hR : R0 ≤ R) :
    norm (brrsNormalizedQuadraticFresnelIntegral R -
      brrsNormalizedQuadraticFresnelIntegral R0) ≤ R0⁻¹ := by
  rw [brrsNormalizedQuadraticFresnelIntegral_sub_eq_tail]
  have htail := quadratic_phase_tail_norm_le_inv
    (a := R0) (b := R) (c := 1) hR0 hR (by norm_num)
  simpa using htail

/-- The actual improper Fresnel value, defined as the limit of its finite
quadratic truncations.  The next lemmas evaluate this limit by Abel damping;
unlike the finite carrier below, this definition is independent of a chosen
cutoff. -/
noncomputable def brrsQuadraticFresnelLimit : Complex :=
  limUnder atTop brrsNormalizedQuadraticFresnelIntegral

/-- The elementary `R⁻¹` tail estimate makes the finite Fresnel truncations
converge to their improper value. -/
theorem brrsNormalizedQuadraticFresnelIntegral_tendsto_limit :
    Tendsto brrsNormalizedQuadraticFresnelIntegral atTop
      (nhds brrsQuadraticFresnelLimit) := by
  have hcauchy : CauchySeq brrsNormalizedQuadraticFresnelIntegral := by
    refine (Metric.cauchySeq_iff').2 ?_
    intro eps heps
    let N : Real := eps⁻¹ + 1
    have hNone : 0 < N := by
      dsimp [N]
      positivity
    have hquot : N⁻¹ < eps := by
      apply (inv_lt_iff_one_lt_mul₀' hNone).mpr
      dsimp [N]
      calc
        1 < eps * (eps⁻¹ + 1) := by
          rw [mul_add, mul_inv_cancel₀ (ne_of_gt heps)]
          linarith
        _ = (eps⁻¹ + 1) * eps := by ring
    refine ⟨N, ?_⟩
    intro R hR
    simpa only [dist_eq_norm] using
      (lt_of_le_of_lt
        (brrsNormalizedQuadraticFresnelIntegral_tail_distance_le hNone hR) hquot)
  simpa only [brrsQuadraticFresnelLimit] using hcauchy.tendsto_limUnder

/-- A concrete nonzero carrier for the normalized Fresnel truncations.  The
choice `64` makes the nonstationary tail smaller than half the certified
carrier magnitude. -/
noncomputable def brrsNormalizedQuadraticFresnelCarrier : Complex :=
  brrsNormalizedQuadraticFresnelIntegral 64

/-- The fixed Fresnel carrier has a quantitative nonvanishing margin. -/
theorem brrsNormalizedQuadraticFresnelCarrier_norm_lower :
    (1 / 32 : Real) ≤ norm brrsNormalizedQuadraticFresnelCarrier := by
  change (1 / 32 : Real) ≤ norm (brrsNormalizedQuadraticFresnelIntegral 64)
  exact le_trans (by norm_num)
    (brrsNormalizedQuadraticFresnelIntegral_norm_lower 64 (by norm_num))

/-- The fixed carrier is genuinely nonzero. -/
theorem brrsNormalizedQuadraticFresnelCarrier_ne_zero :
    brrsNormalizedQuadraticFresnelCarrier ≠ 0 := by
  intro hzero
  have hbad : (1 / 32 : Real) ≤ 0 := by
    simpa [hzero] using brrsNormalizedQuadraticFresnelCarrier_norm_lower
  norm_num at hbad

/-- Every truncation past `64` stays in a fixed small neighborhood of the
same nonzero complex carrier.  This is a finite, quantitative coherence
statement suitable for a later even-dimensional stationary-phase transfer. -/
theorem brrsNormalizedQuadraticFresnelIntegral_eventually_close_to_carrier
    (R : Real) (hR : (64 : Real) ≤ R) :
    norm (brrsNormalizedQuadraticFresnelIntegral R -
      brrsNormalizedQuadraticFresnelCarrier) ≤ (1 / 64 : Real) := by
  simpa [brrsNormalizedQuadraticFresnelCarrier] using
    (brrsNormalizedQuadraticFresnelIntegral_tail_distance_le
      (R0 := (64 : Real)) (R := R) (by norm_num) hR)

/-- Existential packaging of the coherent finite Fresnel carrier.  In
particular, the carrier has at least twice the radius of the uniform tail
neighborhood. -/
theorem exists_brrsNormalizedQuadraticFresnelIntegral_coherentCarrier :
    ∃ R0 c : Real, 0 < c ∧
      2 * c ≤ norm (brrsNormalizedQuadraticFresnelIntegral R0) ∧
      ∀ R : Real, R0 ≤ R →
        norm (brrsNormalizedQuadraticFresnelIntegral R -
          brrsNormalizedQuadraticFresnelIntegral R0) ≤ c := by
  refine ⟨64, 1 / 64, by norm_num, ?_, ?_⟩
  · calc
      2 * (1 / 64 : Real) = 1 / 32 := by norm_num
      _ ≤ norm (brrsNormalizedQuadraticFresnelIntegral 64) := by
        simpa [brrsNormalizedQuadraticFresnelCarrier] using
          brrsNormalizedQuadraticFresnelCarrier_norm_lower
  · intro R hR
    simpa [brrsNormalizedQuadraticFresnelCarrier] using
      (brrsNormalizedQuadraticFresnelIntegral_eventually_close_to_carrier R hR)

/-! ### Fixed carriers for even quadratic endpoint moments

For the literal Bessel asymptotic needed in BRRS (3.3), the endpoint
normalization must converge to a fixed complex number with one full inverse
power of error.  The cancellation below is the elementary even-amplitude
stationary-phase mechanism: differentiating `sqrt(lambda) I_0(lambda)` and
using the first two integration-by-parts recurrences removes the order-zero
term. -/

/-- The normalized order-zero endpoint moment whose limit is the even
quadratic stationary carrier. -/
noncomputable def brrsEvenQuadraticBaseNormalized
    (h : Real -> Complex) (lambda : Real) : Complex :=
  (Real.sqrt lambda : Complex) * quadraticMomentIntegral 0 h lambda

/-- After the exact recurrence cancellation, the derivative of the normalized
even endpoint moment is a first derivative moment with an integrable
`lambda⁻²` size. -/
theorem brrs_hasDerivAt_evenQuadraticBaseNormalized
    (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) {lambda : Real} (hlambda : 0 < lambda) :
    HasDerivAt (brrsEvenQuadraticBaseNormalized h)
      (-(1 / (2 * Real.sqrt lambda) : Complex) *
        quadraticMomentIntegral 1 (deriv h) lambda) lambda := by
  have hsqrt : HasDerivAt Real.sqrt
      (1 / (2 * Real.sqrt lambda)) lambda := by
    exact Real.hasDerivAt_sqrt (ne_of_gt hlambda)
  have hmoment := hasDerivAt_quadraticMomentIntegral 0 h hh lambda
  have hsqrtC : HasDerivAt (fun t : Real => (Real.sqrt t : Complex))
      (1 / (2 * Real.sqrt lambda) : Complex) lambda := by
    convert hsqrt.ofReal_comp using 1
    push_cast
    rfl
  have hprod := hsqrtC.mul hmoment
  have hrec := quadraticMomentIntegral_succ_two_recurrence 0 h hh hvanish
    (ne_of_gt hlambda)
  have hsqrt_ne : Not (Real.sqrt lambda = 0) := Real.sqrt_ne_zero'.mpr hlambda
  have hlambda_sq : Real.sqrt lambda ^ 2 = lambda := Real.sq_sqrt hlambda.le
  have hderivEq :
      (Real.sqrt lambda : Complex) *
          (Complex.I * quadraticMomentIntegral (0 + 2) h lambda) =
        -(1 / (2 * Real.sqrt lambda) : Complex) *
          quadraticMomentIntegral 0 h lambda +
          (-(1 / (2 * Real.sqrt lambda) : Complex) *
            quadraticMomentIntegral 1 (deriv h) lambda) := by
    rw [hrec]
    push_cast
    field_simp [hsqrt_ne, ne_of_gt hlambda]
    have hcoerced : (Real.sqrt lambda : Complex) ^ 2 = (lambda : Complex) := by
      exact_mod_cast hlambda_sq
    rw [hcoerced]
    ring
  rw [hderivEq] at hprod
  change HasDerivAt
    (fun t => (Real.sqrt t : Complex) * quadraticMomentIntegral 0 h t)
    (-(1 / (2 * Real.sqrt lambda) : Complex) *
      quadraticMomentIntegral 1 (deriv h) lambda) lambda
  have hfun :
      ((fun t : Real => (Real.sqrt t : Complex)) * quadraticMomentIntegral 0 h) =
        (fun t => (Real.sqrt t : Complex) * quadraticMomentIntegral 0 h t) := by
    rfl
  rw [hfun] at hprod
  convert hprod using 1 <;> try rfl
  simp only [neg_mul, ← add_assoc, add_neg_cancel, zero_add]


/-- If the endpoint amplitude has vanishing first derivative at the stationary
point, the normalized order-zero moment has an integrable `lambda^-2`
derivative. This is the quantitative cancellation needed to construct its
fixed stationary carrier. -/
theorem exists_brrsEvenQuadraticBaseNormalized_deriv_decay
    (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) (hderiv_zero : deriv h 0 = 0) :
    ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
      ‖deriv (brrsEvenQuadraticBaseNormalized h) lambda‖ ≤ C / lambda ^ 2 := by
  obtain ⟨C, hC, hleading⟩ :=
    exists_quadraticMoment_odd_leading_asymptotic 0 (deriv h)
      ((contDiff_infty_iff_deriv.mp hh).2) hvanish.deriv
  refine ⟨C, hC, ?_⟩
  intro lambda hlambda
  have hlambda_pos : 0 < lambda := lt_of_lt_of_le zero_lt_one hlambda
  have hsqrt_pos : 0 < Real.sqrt lambda := Real.sqrt_pos.2 hlambda_pos
  let q : Complex := ((2 * lambda : Real) : Complex) * Complex.I
  let Ione : Complex := quadraticMomentIntegral 1 (deriv h) lambda
  have hqIone : ‖q * Ione‖ ≤ C / Real.sqrt lambda := by
    dsimp [q, Ione]
    simpa [brrsOddQuadraticLeadingCoefficient, hderiv_zero] using
      hleading lambda hlambda
  have hqnorm : ‖q‖ = 2 * lambda := by
    dsimp [q]
    exact brrs_norm_quadraticCarrier lambda hlambda_pos.le
  have hscaled : (2 * lambda) * ‖Ione‖ ≤ C / Real.sqrt lambda := by
    calc
      (2 * lambda) * ‖Ione‖ = ‖q * Ione‖ := by
        rw [norm_mul, hqnorm]
      _ ≤ C / Real.sqrt lambda := hqIone
  have hIone : ‖Ione‖ ≤ (C / Real.sqrt lambda) / (2 * lambda) := by
    calc
      ‖Ione‖ = (1 / (2 * lambda)) * ((2 * lambda) * ‖Ione‖) := by
        field_simp [ne_of_gt hlambda_pos]
      _ ≤ (1 / (2 * lambda)) * (C / Real.sqrt lambda) := by
        gcongr
      _ = (C / Real.sqrt lambda) / (2 * lambda) := by ring
  have hcoef : ‖-(1 / (2 * Real.sqrt lambda) : Complex)‖ =
      1 / (2 * Real.sqrt lambda) := by
    rw [norm_neg, norm_div, norm_one, norm_mul, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos hsqrt_pos]
    norm_num
  have hderiv :=
    (brrs_hasDerivAt_evenQuadraticBaseNormalized h hh hvanish hlambda_pos).deriv
  change ‖deriv (brrsEvenQuadraticBaseNormalized h) lambda‖ ≤ C / lambda ^ 2
  rw [hderiv]
  calc
    ‖-(1 / (2 * Real.sqrt lambda) : Complex) * Ione‖ =
        (1 / (2 * Real.sqrt lambda)) * ‖Ione‖ := by
          rw [norm_mul, hcoef]
    _ ≤ (1 / (2 * Real.sqrt lambda)) *
        ((C / Real.sqrt lambda) / (2 * lambda)) := by
          gcongr
    _ = C / (4 * lambda ^ 2) := by
          field_simp [ne_of_gt hlambda_pos, ne_of_gt hsqrt_pos]
          rw [Real.sq_sqrt hlambda_pos.le]
          ring
    _ ≤ C / lambda ^ 2 := by
          have hlambda_sq_pos : 0 < lambda ^ 2 := pow_pos hlambda_pos _
          have hnonneg : 0 ≤ C / lambda ^ 2 :=
            div_nonneg hC.le hlambda_sq_pos.le
          calc
            C / (4 * lambda ^ 2) = (C / lambda ^ 2) / 4 := by
              field_simp [ne_of_gt hlambda_sq_pos]
            _ ≤ C / lambda ^ 2 := by nlinarith

/-- The elementary reciprocal-square antiderivative used to turn an
integrable derivative estimate into a quantitative tail estimate. -/
private theorem brrs_intervalIntegral_inv_sq {a b : Real} (ha : 0 < a)
    (hab : a ≤ b) :
    (∫ t in a..b, Inv.inv (t ^ 2)) = Inv.inv a - Inv.inv b := by
  have hpos : ∀ x ∈ Set.uIcc a b, 0 < x := by
    intro x hx
    have hx' : x ∈ Set.Icc a b := by
      simpa [Set.uIcc_of_le hab] using hx
    exact lt_of_lt_of_le ha hx'.1
  have hcont : ContinuousOn (fun x : Real => Inv.inv (x ^ 2)) (Set.uIcc a b) := by
    refine (continuous_id.pow 2).continuousOn.inv₀ ?_
    intro x hx
    exact pow_ne_zero 2 (ne_of_gt (hpos x hx))
  have hderiv : ∀ x ∈ Set.uIcc a b,
      HasDerivAt (-(fun y : Real => Inv.inv y)) (Inv.inv (x ^ 2)) x := by
    intro x hx
    simpa using (hasDerivAt_inv (ne_of_gt (hpos x hx))).neg
  have h := intervalIntegral.integral_mul_deriv_eq_deriv_mul
    (u := fun _ : Real => (1 : Real)) (u' := fun _ : Real => (0 : Real))
    (v := -(fun y : Real => Inv.inv y)) (v' := fun y : Real => Inv.inv (y ^ 2))
    (fun _ _ => hasDerivAt_const _ (1 : Real)) hderiv
    (Continuous.intervalIntegrable (by fun_prop) a b)
    hcont.intervalIntegrable
  simp only [one_mul, Pi.neg_apply, zero_mul, intervalIntegral.integral_zero, sub_zero] at h
  calc
    (∫ t in a..b, Inv.inv (t ^ 2)) = -Inv.inv b - -Inv.inv a := h
    _ = Inv.inv a - Inv.inv b := by ring

/-- Finite coherence of the normalized even endpoint moment.  The estimate is
the exact `O(a^-1)` tail obtained by integrating its `O(lambda^-2)`
derivative over `[a,b]`. -/
theorem exists_brrsEvenQuadraticBaseNormalized_tail_bound
    (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) (hderiv_zero : deriv h 0 = 0) :
    ∃ C : Real, 0 < C ∧ ∀ {a b : Real}, 1 ≤ a → a ≤ b →
      norm (brrsEvenQuadraticBaseNormalized h b -
        brrsEvenQuadraticBaseNormalized h a) ≤ C / a := by
  obtain ⟨C, hC, hderiv_bound⟩ :=
    exists_brrsEvenQuadraticBaseNormalized_deriv_decay h hh hvanish hderiv_zero
  refine ⟨C, hC, ?_⟩
  intro a b ha hab
  have ha_pos : 0 < a := lt_of_lt_of_le zero_lt_one ha
  have hb_pos : 0 < b := lt_of_lt_of_le ha_pos hab
  have hcont : ContinuousOn (brrsEvenQuadraticBaseNormalized h) (Set.Icc a b) := by
    intro x hx
    exact (brrs_hasDerivAt_evenQuadraticBaseNormalized h hh hvanish
      (lt_of_lt_of_le ha_pos hx.1)).continuousAt.continuousWithinAt
  have hdiff : DifferentiableOn Real (brrsEvenQuadraticBaseNormalized h)
      (Set.Ioo a b) := by
    intro x hx
    exact (brrs_hasDerivAt_evenQuadraticBaseNormalized h hh hvanish
      (lt_trans ha_pos hx.1)).differentiableAt.differentiableWithinAt
  have hpos : ∀ x ∈ Set.uIcc a b, 0 < x := by
    intro x hx
    have hx' : x ∈ Set.Icc a b := by
      simpa [Set.uIcc_of_le hab] using hx
    exact lt_of_lt_of_le ha_pos hx'.1
  have hmajor_cont : ContinuousOn (fun x : Real => C / x ^ 2) (Set.uIcc a b) := by
    refine continuousOn_const.div (continuousOn_id.pow 2) ?_
    intro x hx
    exact pow_ne_zero 2 (ne_of_gt (hpos x hx))
  have hline := norm_sub_le_integral_of_norm_deriv_le_of_le
    (f := brrsEvenQuadraticBaseNormalized h) (B := fun x : Real => C / x ^ 2)
    hab hcont hdiff
    (Filter.Eventually.of_forall (fun x hx =>
      hderiv_bound x (le_trans ha (le_of_lt hx.1))))
    hmajor_cont.intervalIntegrable
  calc
    norm (brrsEvenQuadraticBaseNormalized h b -
        brrsEvenQuadraticBaseNormalized h a) ≤
        ∫ x in a..b, C / x ^ 2 := hline
    _ = C * (Inv.inv a - Inv.inv b) := by
      have hfactor : (fun x : Real => C / x ^ 2) =
          fun x => C * Inv.inv (x ^ 2) := by
        funext x
        rw [div_eq_mul_inv]
      rw [hfactor, intervalIntegral.integral_const_mul,
        brrs_intervalIntegral_inv_sq ha_pos hab]
    _ ≤ C * Inv.inv a := by
      apply mul_le_mul_of_nonneg_left
        (sub_le_self _ (inv_nonneg.mpr hb_pos.le)) hC.le
    _ = C / a := by rw [div_eq_mul_inv]

/-- The fixed stationary carrier of the normalized even quadratic endpoint
moment.  Convergence and its quantitative tail are proved below under the
natural stationary cancellation hypotheses. -/
noncomputable def brrsEvenQuadraticBaseCarrier (h : Real -> Complex) : Complex :=
  limUnder atTop (brrsEvenQuadraticBaseNormalized h)

/-- The finite `O(a^-1)` coherence bound makes the normalized even endpoint
moment Cauchy at infinity, hence convergent to its fixed carrier. -/
theorem brrsEvenQuadraticBaseNormalized_tendsto_carrier
    (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) (hderiv_zero : deriv h 0 = 0) :
    Tendsto (brrsEvenQuadraticBaseNormalized h) atTop
      (nhds (brrsEvenQuadraticBaseCarrier h)) := by
  obtain ⟨C, hC, htail⟩ :=
    exists_brrsEvenQuadraticBaseNormalized_tail_bound h hh hvanish hderiv_zero
  have hcauchy : CauchySeq (brrsEvenQuadraticBaseNormalized h) := by
    refine (Metric.cauchySeq_iff').2 ?_
    intro eps heps
    let N : Real := C / eps + 1
    have hNone : 1 ≤ N := by
      dsimp [N]
      have hnonneg : 0 ≤ C / eps := div_nonneg hC.le (le_of_lt heps)
      linarith
    have hNpos : 0 < N := lt_of_lt_of_le zero_lt_one hNone
    have hquot : C / N < eps := by
      apply (div_lt_iff₀ hNpos).2
      dsimp [N]
      calc
        C = eps * (C / eps) := by field_simp [ne_of_gt heps]
        _ < eps * (C / eps + 1) :=
          mul_lt_mul_of_pos_left (by linarith) heps
    refine ⟨N, ?_⟩
    intro n hn
    simpa only [dist_eq_norm] using
      (lt_of_le_of_lt (htail hNone hn) hquot)
  simpa only [brrsEvenQuadraticBaseCarrier] using hcauchy.tendsto_limUnder

/-- Quantitative convergence of the normalized even endpoint moment to its
fixed carrier. -/
theorem exists_brrsEvenQuadraticBaseNormalized_carrier_decay
    (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) (hderiv_zero : deriv h 0 = 0) :
    ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
      norm (brrsEvenQuadraticBaseNormalized h lambda -
        brrsEvenQuadraticBaseCarrier h) ≤ C / lambda := by
  obtain ⟨C, hC, htail⟩ :=
    exists_brrsEvenQuadraticBaseNormalized_tail_bound h hh hvanish hderiv_zero
  refine ⟨C, hC, ?_⟩
  intro lambda hlambda
  have hlim := brrsEvenQuadraticBaseNormalized_tendsto_carrier
    h hh hvanish hderiv_zero
  have hnorm_tendsto : Tendsto
      (fun b : Real => norm (brrsEvenQuadraticBaseNormalized h b -
        brrsEvenQuadraticBaseNormalized h lambda)) atTop
      (nhds (norm (brrsEvenQuadraticBaseCarrier h -
        brrsEvenQuadraticBaseNormalized h lambda)) ) := by
    exact (hlim.sub (tendsto_const_nhds : Tendsto
      (fun _ : Real => brrsEvenQuadraticBaseNormalized h lambda) atTop
      (nhds (brrsEvenQuadraticBaseNormalized h lambda)))).norm
  have hevent : Filter.Eventually (fun b : Real =>
      norm (brrsEvenQuadraticBaseNormalized h b -
        brrsEvenQuadraticBaseNormalized h lambda) ≤ C / lambda) atTop := by
    filter_upwards [Filter.eventually_ge_atTop lambda] with b hb
    exact htail hlambda hb
  have hbound := le_of_tendsto hnorm_tendsto hevent
  simpa only [norm_sub_rev] using hbound

/-- The concrete endpoint profile is even.  This supplies the stationary
point cancellation used by the even-dimensional endpoint expansion. -/
private theorem brrs_smoothEndpointProfile_neg (m : Nat) (u : Real) :
    smoothEndpointProfile m (-u) = smoothEndpointProfile m u := by
  have hcore : endpointCoreCutoff (-u) = endpointCoreCutoff u := by
    exact ContDiffBump.neg endpointCoreBump u
  have hguard : endpointGuardCutoff (-u) = endpointGuardCutoff u := by
    exact ContDiffBump.neg endpointGuardBump u
  have hcoord : endpointGuardedCoordinate (-u) = -endpointGuardedCoordinate u := by
    unfold endpointGuardedCoordinate
    rw [hguard]
    ring
  have hsquare : (-endpointGuardedCoordinate u) ^ 2 =
      endpointGuardedCoordinate u ^ 2 := by
    ring
  unfold smoothEndpointProfile smoothEndpointProfileReal
  rw [hcoord, hsquare, hcore]

/-- The first derivative of the actual even endpoint profile vanishes at the
stationary point. -/
private theorem brrs_deriv_smoothEndpointProfile_zero (m : Nat) :
    deriv (smoothEndpointProfile m) 0 = 0 := by
  have heven : (fun u : Real => smoothEndpointProfile m (-u)) =
      smoothEndpointProfile m := by
    funext u
    exact brrs_smoothEndpointProfile_neg m u
  have hderiv := congrArg (fun g : (Real -> Complex) => deriv g 0) heven
  rw [deriv_comp_neg, neg_zero] at hderiv
  exact CharZero.eq_neg_self_iff.mp hderiv.symm

/-- The order-zero concrete endpoint moment has a fixed Fresnel carrier and
the full one-inverse-power normalized remainder required for the even branch
of the surface-measure stationary expansion. -/
theorem exists_smoothEndpointQuadraticIntegral_zero_leading_asymptotic :
    ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
      norm ((Real.sqrt lambda : Complex) * smoothEndpointQuadraticIntegral 0 lambda -
        brrsEvenQuadraticBaseCarrier (smoothEndpointProfile 0)) ≤ C / lambda := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_brrsEvenQuadraticBaseNormalized_carrier_decay
      (smoothEndpointProfile 0) (contDiff_smoothEndpointProfile 0)
      (smoothEndpointProfile_eventuallyEq_zero_at_one 0)
      (brrs_deriv_smoothEndpointProfile_zero 0)
  refine ⟨C, hC, ?_⟩
  intro lambda hlambda
  rw [smoothEndpointQuadraticIntegral_eq_quadraticMomentIntegral]
  simpa [brrsEvenQuadraticBaseNormalized] using hbound lambda hlambda

/-- The recurrence coefficient of an even quadratic endpoint moment.  The
base carrier is the order-zero Fresnel carrier; each later coefficient comes
from the literal two-step endpoint recurrence. -/
def brrsEvenQuadraticLeadingCoefficient : Nat → Complex
  | 0 => 1
  | n + 1 => -((2 * n + 1 : Nat) : Complex) *
      brrsEvenQuadraticLeadingCoefficient n

theorem brrsEvenQuadraticLeadingCoefficient_succ (n : Nat) :
    brrsEvenQuadraticLeadingCoefficient (n + 1) =
      -((2 * n + 1 : Nat) : Complex) *
        brrsEvenQuadraticLeadingCoefficient n := rfl

/-- The even recurrence never loses its leading coefficient. -/
theorem brrsEvenQuadraticLeadingCoefficient_ne_zero (n : Nat) :
    brrsEvenQuadraticLeadingCoefficient n ≠ 0 := by
  induction n with
  | zero => norm_num [brrsEvenQuadraticLeadingCoefficient]
  | succ n ih =>
      rw [brrsEvenQuadraticLeadingCoefficient_succ]
      apply mul_ne_zero
      · apply neg_ne_zero.mpr
        exact Nat.cast_ne_zero.mpr (by omega)
      · exact ih

/-- The all-even quadratic endpoint stationary expansion.  After the natural
`sqrt(lambda) * lambda^n` normalization, symmetry at the stationary point
removes the half-order correction and leaves a fixed carrier with an
`O(lambda⁻¹)` remainder. -/
theorem exists_quadraticMoment_even_leading_asymptotic
    (n : Nat) (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) (hderiv_zero : deriv h 0 = 0) :
    ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
      ‖(Real.sqrt lambda : Complex) *
          (((2 * lambda : Real) : Complex) * Complex.I) ^ n *
          quadraticMomentIntegral (2 * n) h lambda -
        brrsEvenQuadraticLeadingCoefficient n *
          brrsEvenQuadraticBaseCarrier h‖ ≤ C / lambda := by
  induction n with
  | zero =>
      obtain ⟨C, hC, hbound⟩ :=
        exists_brrsEvenQuadraticBaseNormalized_carrier_decay h hh hvanish hderiv_zero
      refine ⟨C, hC, ?_⟩
      intro lambda hlambda
      simpa [brrsEvenQuadraticBaseNormalized,
        brrsEvenQuadraticLeadingCoefficient] using hbound lambda hlambda
  | succ n ih =>
      obtain ⟨C₀, hC₀, hmain⟩ := ih
      obtain ⟨C₁, hC₁, hrem⟩ :=
        exists_quadraticMoment_odd_leading_asymptotic n (deriv h)
          ((contDiff_infty_iff_deriv.mp hh).2) hvanish.deriv
      let D : Real := ((2 * n + 1 : Nat) : Real) * C₀ + C₁
      have hD : 0 < D := by
        dsimp [D]
        positivity
      refine ⟨D, hD, ?_⟩
      intro lambda hlambda
      have hlambda_pos : 0 < lambda := lt_of_lt_of_le zero_lt_one hlambda
      have hsqrt_pos : 0 < Real.sqrt lambda := Real.sqrt_pos.2 hlambda_pos
      let q : Complex := ((2 * lambda : Real) : Complex) * Complex.I
      let A : Complex := quadraticMomentIntegral (2 * n) h lambda
      let R : Complex := quadraticMomentIntegral (2 * n + 1) (deriv h) lambda
      let K : Complex := brrsEvenQuadraticLeadingCoefficient n
      let E : Complex := brrsEvenQuadraticBaseCarrier h
      have hmain' : ‖(Real.sqrt lambda : Complex) * q ^ n * A - K * E‖ ≤
          C₀ / lambda := by
        dsimp [q, A, K, E]
        exact hmain lambda hlambda
      have hRlead : ‖q ^ (n + 1) * R‖ ≤ C₁ / Real.sqrt lambda := by
        dsimp [q, R]
        simpa [hderiv_zero] using hrem lambda hlambda
      have hqnorm : ‖q‖ = 2 * lambda := by
        dsimp [q]
        exact brrs_norm_quadraticCarrier lambda hlambda_pos.le
      have hq : q ≠ 0 := by
        dsimp [q]
        apply mul_ne_zero
        · exact Complex.ofReal_ne_zero.mpr
            (mul_ne_zero (by norm_num) (ne_of_gt hlambda_pos))
        · exact Complex.I_ne_zero
      have hqinv : q * q⁻¹ = 1 := mul_inv_cancel₀ hq
      have hRterm : ‖(Real.sqrt lambda : Complex) * q ^ n * R‖ ≤ C₁ / lambda := by
        have hrewrite :
            (Real.sqrt lambda : Complex) * q ^ n * R =
              ((Real.sqrt lambda : Complex) / q) * (q ^ (n + 1) * R) := by
          rw [show n + 1 = Nat.succ n by omega, pow_succ]
          field_simp [hq]
        rw [hrewrite, norm_mul]
        have hcoef : ‖(Real.sqrt lambda : Complex) / q‖ =
            Real.sqrt lambda / (2 * lambda) := by
          rw [norm_div, Complex.norm_real, Real.norm_eq_abs,
            abs_of_pos hsqrt_pos, hqnorm]
        rw [hcoef]
        calc
          (Real.sqrt lambda / (2 * lambda)) * ‖q ^ (n + 1) * R‖ ≤
              (Real.sqrt lambda / (2 * lambda)) *
                (C₁ / Real.sqrt lambda) := by
              gcongr
          _ = C₁ / (2 * lambda) := by
              field_simp [ne_of_gt hlambda_pos, ne_of_gt hsqrt_pos]
          _ ≤ C₁ / lambda := by
              have hden : 0 < lambda := hlambda_pos
              have hnonneg : 0 ≤ C₁ / lambda := div_nonneg hC₁.le hden.le
              calc
                C₁ / (2 * lambda) = (C₁ / lambda) / 2 := by
                  field_simp [ne_of_gt hden]
                _ ≤ C₁ / lambda := by linarith
      have hrec := quadraticMomentIntegral_succ_two_recurrence (2 * n) h hh hvanish
        (ne_of_gt hlambda_pos)
      have hrec' :
          quadraticMomentIntegral (2 * n + 2) h lambda =
            -q⁻¹ * (((2 * n + 1 : Nat) : Complex) * A + R) := by
        dsimp [q, A, R]
        exact hrec
      have hid :
          (Real.sqrt lambda : Complex) * q ^ (n + 1) *
              quadraticMomentIntegral (2 * n + 2) h lambda -
            brrsEvenQuadraticLeadingCoefficient (n + 1) * E =
              -((2 * n + 1 : Nat) : Complex) *
                ((Real.sqrt lambda : Complex) * q ^ n * A - K * E) -
              (Real.sqrt lambda : Complex) * q ^ n * R := by
        rw [brrsEvenQuadraticLeadingCoefficient_succ, hrec']
        rw [show n + 1 = Nat.succ n by omega, pow_succ]
        calc
          (Real.sqrt lambda : Complex) * (q ^ n * q) *
                (-q⁻¹ * (((2 * n + 1 : Nat) : Complex) * A + R)) -
              (-((2 * n + 1 : Nat) : Complex) * K) * E =
              -((Real.sqrt lambda : Complex) * q ^ n * (q * q⁻¹) *
                (((2 * n + 1 : Nat) : Complex) * A + R)) +
              ((2 * n + 1 : Nat) : Complex) * K * E := by
                ring
          _ = -((2 * n + 1 : Nat) : Complex) *
                ((Real.sqrt lambda : Complex) * q ^ n * A - K * E) -
              (Real.sqrt lambda : Complex) * q ^ n * R := by
                rw [hqinv]
                ring
      have hcoeff_norm : ‖-((2 * n + 1 : Nat) : Complex)‖ =
          ((2 * n + 1 : Nat) : Real) := by
        rw [norm_neg, norm_natCast]
      have hfirst : ‖-((2 * n + 1 : Nat) : Complex) *
          ((Real.sqrt lambda : Complex) * q ^ n * A - K * E)‖ ≤
          (((2 * n + 1 : Nat) : Real) * C₀) / lambda := by
        rw [norm_mul, hcoeff_norm]
        calc
          ((2 * n + 1 : Nat) : Real) *
              ‖(Real.sqrt lambda : Complex) * q ^ n * A - K * E‖ ≤
              ((2 * n + 1 : Nat) : Real) * (C₀ / lambda) := by
            gcongr
          _ = (((2 * n + 1 : Nat) : Real) * C₀) / lambda := by ring
      have hsum : ‖-((2 * n + 1 : Nat) : Complex) *
          ((Real.sqrt lambda : Complex) * q ^ n * A - K * E) -
          (Real.sqrt lambda : Complex) * q ^ n * R‖ ≤ D / lambda := by
        calc
          ‖-((2 * n + 1 : Nat) : Complex) *
              ((Real.sqrt lambda : Complex) * q ^ n * A - K * E) -
              (Real.sqrt lambda : Complex) * q ^ n * R‖ ≤
              ‖-((2 * n + 1 : Nat) : Complex) *
                ((Real.sqrt lambda : Complex) * q ^ n * A - K * E)‖ +
              ‖(Real.sqrt lambda : Complex) * q ^ n * R‖ := norm_sub_le _ _
          _ ≤ (((2 * n + 1 : Nat) : Real) * C₀) / lambda + C₁ / lambda :=
              add_le_add hfirst hRterm
          _ = D / lambda := by
              dsimp [D]
              ring
      change ‖(Real.sqrt lambda : Complex) * q ^ (n + 1) *
        quadraticMomentIntegral (2 * n + 2) h lambda -
        brrsEvenQuadraticLeadingCoefficient (n + 1) * E‖ ≤ D / lambda
      rw [hid]
      exact hsum

/-- The literal circle endpoint profile is even, just as the nonplanar
endpoint profiles are. -/
private theorem brrs_planarEndpointProfile_neg (u : Real) :
    planarEndpointProfile (-u) = planarEndpointProfile u := by
  have hcore : endpointCoreCutoff (-u) = endpointCoreCutoff u := by
    exact ContDiffBump.neg endpointCoreBump u
  have hguard : endpointGuardCutoff (-u) = endpointGuardCutoff u := by
    exact ContDiffBump.neg endpointGuardBump u
  have hcoord : endpointGuardedCoordinate (-u) = -endpointGuardedCoordinate u := by
    unfold endpointGuardedCoordinate
    rw [hguard]
    ring
  have hsquare : (-endpointGuardedCoordinate u) ^ 2 =
      endpointGuardedCoordinate u ^ 2 := by
    ring
  unfold planarEndpointProfile planarEndpointProfileReal
  rw [hcoord, hsquare, hcore]

/-- The circle endpoint profile has zero first derivative at its quadratic
stationary point. -/
private theorem brrs_deriv_planarEndpointProfile_zero :
    deriv planarEndpointProfile 0 = 0 := by
  have heven : (fun u : Real => planarEndpointProfile (-u)) =
      planarEndpointProfile := by
    funext u
    exact brrs_planarEndpointProfile_neg u
  have hderiv := congrArg (fun g : (Real -> Complex) => deriv g 0) heven
  rw [deriv_comp_neg, neg_zero] at hderiv
  exact CharZero.eq_neg_self_iff.mp hderiv.symm

/-- The circle endpoint has the same fixed Fresnel carrier and full
one-inverse-power normalized remainder as the zero-order even branch. -/
theorem exists_planarEndpointQuadraticIntegral_leading_asymptotic :
    ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
      ‖(Real.sqrt lambda : Complex) * planarEndpointQuadraticIntegral lambda -
        brrsEvenQuadraticBaseCarrier planarEndpointProfile‖ ≤ C / lambda := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_quadraticMoment_even_leading_asymptotic 0 planarEndpointProfile
      contDiff_planarEndpointProfile
      planarEndpointProfile_eventuallyEq_zero_at_one
      brrs_deriv_planarEndpointProfile_zero
  refine ⟨C, hC, ?_⟩
  intro lambda hlambda
  simpa [planarEndpointQuadraticIntegral, brrsEvenQuadraticLeadingCoefficient] using
    hbound lambda hlambda

/-- The actual smooth endpoint symbol has the even stationary expansion in
every even order. -/
theorem exists_smoothEndpointQuadraticIntegral_even_leading_asymptotic
    (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
      ‖(Real.sqrt lambda : Complex) *
          (((2 * lambda : Real) : Complex) * Complex.I) ^ n *
          smoothEndpointQuadraticIntegral (2 * n) lambda -
        brrsEvenQuadraticLeadingCoefficient n *
          brrsEvenQuadraticBaseCarrier (smoothEndpointProfile (2 * n))‖ ≤
        C / lambda := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_quadraticMoment_even_leading_asymptotic n
      (smoothEndpointProfile (2 * n))
      (contDiff_smoothEndpointProfile (2 * n))
      (smoothEndpointProfile_eventuallyEq_zero_at_one (2 * n))
      (brrs_deriv_smoothEndpointProfile_zero (2 * n))
  refine ⟨C, hC, ?_⟩
  intro lambda hlambda
  rw [smoothEndpointQuadraticIntegral_eq_quadraticMomentIntegral]
  exact hbound lambda hlambda

/-- In every even nonplanar dimension, the outgoing surface-wave amplitude
has a fixed normalized endpoint carrier and a one-inverse-power remainder. -/
theorem exists_brrsSurfaceWaveAmplitude_outgoing_even_leading_asymptotic
    (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ a rho : Real, 1 ≤ (2 * Real.pi * a) * rho →
      ‖(Real.sqrt ((2 * Real.pi * a) * rho) : Complex) *
          (((2 * ((2 * Real.pi * a) * rho) : Real) : Complex) * Complex.I) ^ n *
          brrsSurfaceWaveAmplitude (2 * n + 2) .outgoing a rho -
        (surfaceMass (2 * n + 1) : Complex) *
          (brrsEvenQuadraticLeadingCoefficient n *
            brrsEvenQuadraticBaseCarrier (smoothEndpointProfile (2 * n)))‖ ≤
        C / ((2 * Real.pi * a) * rho) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_smoothEndpointQuadraticIntegral_even_leading_asymptotic n
  let mass : Real := surfaceMass (2 * n + 1)
  have hmass : 0 < mass := by
    dsimp [mass]
    exact surfaceMass_pos (by omega)
  refine ⟨mass * C, mul_pos hmass hC, ?_⟩
  intro a rho hlambda
  let lambda : Real := (2 * Real.pi * a) * rho
  have hmain := hbound lambda (by simpa [lambda] using hlambda)
  have hdim_one : (2 * n + 2) - 1 = 2 * n + 1 := by omega
  have hdim_two : (2 * n + 2) - 2 = 2 * n := by omega
  have hamp :
      brrsSurfaceWaveAmplitude (2 * n + 2) .outgoing a rho =
        (mass : Complex) * smoothEndpointQuadraticIntegral (2 * n) lambda := by
    unfold brrsSurfaceWaveAmplitude
    dsimp [lambda, mass]
    rw [hdim_two]
  rw [hamp]
  have hfactor :
      (Real.sqrt lambda : Complex) *
          (((2 * lambda : Real) : Complex) * Complex.I) ^ n *
          ((mass : Complex) * smoothEndpointQuadraticIntegral (2 * n) lambda) -
        (mass : Complex) *
          (brrsEvenQuadraticLeadingCoefficient n *
            brrsEvenQuadraticBaseCarrier (smoothEndpointProfile (2 * n))) =
          (mass : Complex) *
            ((Real.sqrt lambda : Complex) *
              (((2 * lambda : Real) : Complex) * Complex.I) ^ n *
              smoothEndpointQuadraticIntegral (2 * n) lambda -
            brrsEvenQuadraticLeadingCoefficient n *
              brrsEvenQuadraticBaseCarrier (smoothEndpointProfile (2 * n))) := by
    ring
  rw [show (2 * Real.pi * a) * rho = lambda by rfl, hfactor, norm_mul,
    Complex.norm_real, Real.norm_eq_abs, abs_of_pos hmass]
  calc
    mass * ‖(Real.sqrt lambda : Complex) *
        (((2 * lambda : Real) : Complex) * Complex.I) ^ n *
        smoothEndpointQuadraticIntegral (2 * n) lambda -
        brrsEvenQuadraticLeadingCoefficient n *
          brrsEvenQuadraticBaseCarrier (smoothEndpointProfile (2 * n))‖ ≤
        mass * (C / lambda) :=
      mul_le_mul_of_nonneg_left hmain hmass.le
    _ = (mass * C) / lambda := by ring

/-- The incoming even-dimensional endpoint wave has the conjugate stationary
carrier and the same one-inverse-power normalized remainder. -/
theorem exists_brrsSurfaceWaveAmplitude_incoming_even_leading_asymptotic
    (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ a rho : Real, 1 ≤ (2 * Real.pi * a) * rho →
      ‖(Real.sqrt ((2 * Real.pi * a) * rho) : Complex) *
          (-(((2 * ((2 * Real.pi * a) * rho) : Real) : Complex) * Complex.I)) ^ n *
          brrsSurfaceWaveAmplitude (2 * n + 2) .incoming a rho -
        starRingEnd Complex
          ((surfaceMass (2 * n + 1) : Complex) *
            (brrsEvenQuadraticLeadingCoefficient n *
              brrsEvenQuadraticBaseCarrier (smoothEndpointProfile (2 * n))))‖ ≤
        C / ((2 * Real.pi * a) * rho) := by
  obtain ⟨C, hC, hout⟩ :=
    exists_brrsSurfaceWaveAmplitude_outgoing_even_leading_asymptotic n
  refine ⟨C, hC, ?_⟩
  intro a rho hlambda
  let lambda : Real := (2 * Real.pi * a) * rho
  let q : Complex := ((2 * lambda : Real) : Complex) * Complex.I
  let Aout : Complex := brrsSurfaceWaveAmplitude (2 * n + 2) .outgoing a rho
  let Ain : Complex := brrsSurfaceWaveAmplitude (2 * n + 2) .incoming a rho
  let K : Complex := (surfaceMass (2 * n + 1) : Complex) *
    (brrsEvenQuadraticLeadingCoefficient n *
      brrsEvenQuadraticBaseCarrier (smoothEndpointProfile (2 * n)))
  have hmain : ‖(Real.sqrt lambda : Complex) * q ^ n * Aout - K‖ ≤ C / lambda := by
    dsimp [lambda, q, Aout, K]
    exact hout a rho hlambda
  have hAin : Ain = starRingEnd Complex Aout := by
    dsimp [Ain, Aout]
    exact brrsSurfaceWaveAmplitude_incoming_eq_conj_outgoing (2 * n + 2) a rho
  have hstarq : starRingEnd Complex q = -q := by
    dsimp [q]
    simp only [map_mul, Complex.conj_ofReal, Complex.conj_I]
    ring
  have hrewrite :
      (Real.sqrt lambda : Complex) * (-q) ^ n * Ain - starRingEnd Complex K =
        starRingEnd Complex ((Real.sqrt lambda : Complex) * q ^ n * Aout - K) := by
    simp only [map_sub, map_mul, map_pow, Complex.conj_ofReal]
    rw [hAin, hstarq, neg_pow]
  change ‖(Real.sqrt lambda : Complex) * (-q) ^ n * Ain -
      starRingEnd Complex K‖ ≤ C / lambda
  rw [hrewrite, RCLike.norm_conj]
  exact hmain

/-- Exact rescaling of an order-zero quadratic stationary moment.  This is the
change of variables `v = sqrt(lambda) * u` written without any limiting or
stationary-phase approximation.  In particular, the rescaled amplitude is
kept explicitly, which makes this identity safe to use for a nonconstant
endpoint profile. -/
theorem quadraticMomentIntegral_zero_eq_rescaledFresnel
    (h : Real -> Complex) {lambda : Real} (hlambda : 0 < lambda) :
    quadraticMomentIntegral 0 h lambda =
      SMul.smul (Inv.inv (Real.sqrt lambda))
        (intervalIntegral
          (fun v => h (v / Real.sqrt lambda) *
            Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I))
          0 (Real.sqrt lambda) volume) := by
  let c : Real := Real.sqrt lambda
  let G : Real -> Complex := fun v => h (v / c) *
    Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I)
  have hc : Not (c = 0) := by
    dsimp [c]
    exact Real.sqrt_ne_zero'.mpr hlambda
  have hc_sq : c ^ 2 = lambda := by
    dsimp [c]
    exact Real.sq_sqrt hlambda.le
  have hcomp : (fun u : Real => G (c * u)) =
      (fun u => ((u ^ 0 : Real) : Complex) * h u *
        Complex.exp (((lambda * u ^ 2 : Real) : Complex) * Complex.I)) := by
    funext u
    dsimp [G]
    have hdiv : c * u / c = u := by
      field_simp
    rw [hdiv]
    have hsq : (c * u) ^ 2 = lambda * u ^ 2 := by
      rw [mul_pow, hc_sq]
    rw [hsq]
    norm_num
  calc
    quadraticMomentIntegral 0 h lambda =
        intervalIntegral (fun u => G (c * u)) 0 1 volume := by
      unfold quadraticMomentIntegral
      rw [hcomp]
    _ = SMul.smul (Inv.inv c)
        (intervalIntegral G (c * 0) (c * 1) volume) := by
      exact intervalIntegral.integral_comp_mul_left G hc
    _ = SMul.smul (Inv.inv c)
        (intervalIntegral G 0 c volume) := by
      norm_num
    _ = SMul.smul (Inv.inv (Real.sqrt lambda))
        (intervalIntegral
          (fun v => h (v / Real.sqrt lambda) *
            Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I))
          0 (Real.sqrt lambda) volume) := by
      rfl

/-- Constant amplitudes rescale exactly to the normalized finite Fresnel
integral.  This is the literal bridge between the unit-scale lower bound and
the order-zero quadratic moment; no asymptotic statement is used here. -/
theorem quadraticMomentIntegral_zero_const_one_eq_sqrt_inv_smul_fresnel
    {lambda : Real} (hlambda : 0 < lambda) :
    quadraticMomentIntegral 0 (fun _ : Real => (1 : Complex)) lambda =
      SMul.smul (Inv.inv (Real.sqrt lambda))
        (brrsNormalizedQuadraticFresnelIntegral (Real.sqrt lambda)) := by
  rw [quadraticMomentIntegral_zero_eq_rescaledFresnel
    (fun _ : Real => (1 : Complex)) hlambda]
  simp only [one_mul]
  rfl

/-- Exact constant-plus-error form of the order-zero rescaling.  The error
retains the variation of the amplitude on the `sqrt(lambda)` scale.  It is a
pure identity under continuity, deliberately without an unproved estimate of
that error. -/
theorem quadraticMomentIntegral_zero_eq_fresnel_add_rescaledError
    (h : Real -> Complex) (hh : Continuous h)
    {lambda : Real} (hlambda : 0 < lambda) :
    quadraticMomentIntegral 0 h lambda =
      SMul.smul (Inv.inv (Real.sqrt lambda))
        (h 0 * brrsNormalizedQuadraticFresnelIntegral (Real.sqrt lambda) +
          intervalIntegral
            (fun v => (h (v / Real.sqrt lambda) - h 0) *
              Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I))
            0 (Real.sqrt lambda) volume) := by
  rw [quadraticMomentIntegral_zero_eq_rescaledFresnel h hlambda]
  congr 1
  let c : Real := Real.sqrt lambda
  let F : Real -> Complex := fun v =>
    Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I)
  let G : Real -> Complex := fun v => h (v / c) * F v
  let E : Real -> Complex := fun v => (h (v / c) - h 0) * F v
  have hF : Continuous F := by
    dsimp [F]
    fun_prop
  have hhscale : Continuous (fun v : Real => h (v / c)) := by
    apply hh.comp
    fun_prop
  have hmain_int : IntervalIntegrable (fun v : Real => h 0 * F v) volume 0 c := by
    exact (hF.const_mul (h 0)).intervalIntegrable 0 c
  have hE_int : IntervalIntegrable E volume 0 c := by
    exact ((hhscale.sub continuous_const).mul hF).intervalIntegrable 0 c
  have hsplit : (fun v : Real => G v) =
      (fun v => h 0 * F v + E v) := by
    funext v
    dsimp [G, E]
    ring
  have hGsplit : G = (fun v => h 0 * F v + E v) := by
    funext v
    exact congrFun hsplit v
  change intervalIntegral (fun v => h (v / c) * F v) 0 c volume = _
  change intervalIntegral G 0 c volume = _
  rw [hGsplit, intervalIntegral.integral_add hmain_int hE_int,
    intervalIntegral.integral_const_mul]
  rfl

/-- After multiplying by the natural square-root stationary scale, the
order-zero endpoint moment is exactly its Fresnel core plus the rescaled
amplitude error.  This is private because it is solely the normalization
step for the even-endpoint carrier calculation. -/
private theorem brrsEvenQuadraticBaseNormalized_eq_fresnel_add_rescaledError
    (h : Real -> Complex) (hh : Continuous h)
    {lambda : Real} (hlambda : 0 < lambda) :
    brrsEvenQuadraticBaseNormalized h lambda =
      h 0 * brrsNormalizedQuadraticFresnelIntegral (Real.sqrt lambda) +
        intervalIntegral
          (fun v => (h (v / Real.sqrt lambda) - h 0) *
            Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I))
          0 (Real.sqrt lambda) volume := by
  unfold brrsEvenQuadraticBaseNormalized
  rw [quadraticMomentIntegral_zero_eq_fresnel_add_rescaledError h hh hlambda]
  change (Real.sqrt lambda : Complex) *
      ((Real.sqrt lambda)⁻¹ •
        (h 0 * brrsNormalizedQuadraticFresnelIntegral (Real.sqrt lambda) +
          intervalIntegral
            (fun v => (h (v / Real.sqrt lambda) - h 0) *
              Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I))
            0 (Real.sqrt lambda) volume)) = _
  rw [Complex.real_smul]
  have hsqrt : Real.sqrt lambda ≠ 0 := Real.sqrt_ne_zero'.mpr hlambda
  push_cast
  field_simp [hsqrt]
  congr 1
  apply intervalIntegral.integral_congr
  intro v hv
  ring

/-- A coherent finite Fresnel carrier transfers any sufficiently small
rescaled endpoint error into a quantitative order-zero stationary lower
bound.  This is an entirely finite statement: the only carrier input is the
proved neighborhood estimate for the truncation at `64`. -/
theorem quadraticMomentIntegral_zero_norm_lower_of_rescaledError_le
    (h : Real → Complex) (hh : Continuous h) (hzero : h 0 ≠ 0)
    {lambda : Real} (hlambda : (4096 : Real) ≤ lambda)
    (herror : ‖intervalIntegral
      (fun v => (h (v / Real.sqrt lambda) - h 0) *
        Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I))
      0 (Real.sqrt lambda) volume‖ ≤ ‖h 0‖ / 128) :
    ‖h 0‖ / 128 / Real.sqrt lambda ≤
      ‖quadraticMomentIntegral 0 h lambda‖ := by
  have hlambda_pos : 0 < lambda := by linarith
  let c : Real := Real.sqrt lambda
  let F : Complex := brrsNormalizedQuadraticFresnelIntegral c
  let E : Complex := intervalIntegral
    (fun v => (h (v / c) - h 0) *
      Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I))
    0 c volume
  let a : Real := ‖h 0‖
  have ha : 0 < a := norm_pos_iff.mpr hzero
  have hcpos : 0 < c := by
    dsimp [c]
    exact Real.sqrt_pos.2 hlambda_pos
  have hcsq : c ^ 2 = lambda := by
    dsimp [c]
    exact Real.sq_sqrt hlambda_pos.le
  have hc_large : (64 : Real) ≤ c := by
    have hsq : (64 : Real) ^ 2 ≤ c ^ 2 := by
      calc
        (64 : Real) ^ 2 = 4096 := by norm_num
        _ ≤ lambda := hlambda
        _ = c ^ 2 := hcsq.symm
    nlinarith
  have hFclose : ‖F - brrsNormalizedQuadraticFresnelCarrier‖ ≤ (1 / 64 : Real) := by
    dsimp [F]
    exact brrsNormalizedQuadraticFresnelIntegral_eventually_close_to_carrier c hc_large
  have hE : ‖E‖ ≤ a / 128 := by
    dsimp [E, c, a]
    exact herror
  have hcarrier_scaled : a / 32 ≤ ‖h 0 * brrsNormalizedQuadraticFresnelCarrier‖ := by
    calc
      a / 32 = ‖h 0‖ * (1 / 32 : Real) := by
        dsimp [a]
        ring
      _ ≤ ‖h 0‖ * ‖brrsNormalizedQuadraticFresnelCarrier‖ :=
        mul_le_mul_of_nonneg_left brrsNormalizedQuadraticFresnelCarrier_norm_lower
          (norm_nonneg _)
      _ = ‖h 0 * brrsNormalizedQuadraticFresnelCarrier‖ := (norm_mul _ _).symm
  have hscaled_tail : ‖h 0 * F - h 0 * brrsNormalizedQuadraticFresnelCarrier‖ ≤
      a / 64 := by
    rw [show h 0 * F - h 0 * brrsNormalizedQuadraticFresnelCarrier =
      h 0 * (F - brrsNormalizedQuadraticFresnelCarrier) by ring, norm_mul]
    calc
      ‖h 0‖ * ‖F - brrsNormalizedQuadraticFresnelCarrier‖ ≤
          ‖h 0‖ * (1 / 64 : Real) :=
        mul_le_mul_of_nonneg_left hFclose (norm_nonneg _)
      _ = a / 64 := by
        dsimp [a]
        ring
  have hsecondary : ‖h 0 * F + E - h 0 * brrsNormalizedQuadraticFresnelCarrier‖ ≤
      a / 64 + a / 128 := by
    calc
      ‖h 0 * F + E - h 0 * brrsNormalizedQuadraticFresnelCarrier‖ =
          ‖(h 0 * F - h 0 * brrsNormalizedQuadraticFresnelCarrier) + E‖ := by
        congr 1
        ring
      _ ≤ ‖h 0 * F - h 0 * brrsNormalizedQuadraticFresnelCarrier‖ + ‖E‖ :=
        norm_add_le _ _
      _ ≤ a / 64 + a / 128 := add_le_add hscaled_tail hE
  have htriangle : ‖h 0 * brrsNormalizedQuadraticFresnelCarrier‖ ≤
      ‖h 0 * F + E‖ +
        ‖h 0 * F + E - h 0 * brrsNormalizedQuadraticFresnelCarrier‖ := by
    calc
      ‖h 0 * brrsNormalizedQuadraticFresnelCarrier‖ =
          ‖(h 0 * F + E) -
            (h 0 * F + E - h 0 * brrsNormalizedQuadraticFresnelCarrier)‖ := by
        congr 1
        ring
      _ ≤ ‖h 0 * F + E‖ +
          ‖h 0 * F + E - h 0 * brrsNormalizedQuadraticFresnelCarrier‖ :=
        norm_sub_le _ _
  have hmain : a / 128 ≤ ‖h 0 * F + E‖ := by
    nlinarith [hcarrier_scaled, htriangle, hsecondary]
  have hformula : quadraticMomentIntegral 0 h lambda =
      SMul.smul (Inv.inv c) (h 0 * F + E) := by
    dsimp [c, F, E]
    exact quadraticMomentIntegral_zero_eq_fresnel_add_rescaledError h hh hlambda_pos
  rw [hformula]
  change a / 128 / c ≤ ‖(c⁻¹ : Real) • (h 0 * F + E)‖
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hcpos)]
  calc
    a / 128 / c = c⁻¹ * (a / 128) := by
      field_simp [ne_of_gt hcpos]
    _ ≤ c⁻¹ * ‖h 0 * F + E‖ :=
      mul_le_mul_of_nonneg_left hmain (inv_nonneg.mpr hcpos.le)

/-- The fixed coherent Fresnel carrier already gives a completely explicit
order-zero lower bound for the constant smooth amplitude.  This is an
analytic endpoint statement only; it makes no assertion about the full
spherical kernel. -/
theorem quadraticMomentIntegral_zero_const_one_eventually_lower
    {lambda : Real} (hlambda : (4096 : Real) ≤ lambda) :
    (1 / 128 : Real) / Real.sqrt lambda ≤
      ‖quadraticMomentIntegral 0 (fun _ : Real => (1 : Complex)) lambda‖ := by
  simpa using
    (quadraticMomentIntegral_zero_norm_lower_of_rescaledError_le
      (fun _ : Real => (1 : Complex)) continuous_const (by norm_num) hlambda
      (by simp))

/-- A one-step integration-by-parts identity for a quadratic phase away from
its stationary point.  The hypotheses deliberately retain the actual
derivative and its continuity on the interval, so the lemma can be reused for
cutoffs and for rescaled endpoint amplitudes without appealing to an
unjustified asymptotic expansion. -/
theorem brrs_quadratic_phase_weighted_integration_by_parts
    {a b lambda : Real} (ha : 0 < a) (hab : a ≤ b) (hlambda : lambda ≠ 0)
    (g g' : Real → Complex)
    (hg : ∀ x ∈ Set.uIcc a b, HasDerivAt g (g' x) x)
    (hg'cont : ContinuousOn g' (Set.uIcc a b)) :
    (∫ t in a..b, g t * Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)) =
      g b * (((2 * lambda * b : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * b ^ 2 : Real) : Complex) * Complex.I) -
        g a * (((2 * lambda * a : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * a ^ 2 : Real) : Complex) * Complex.I) -
        (∫ t in a..b,
          g' t * (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)) -
        ∫ t in a..b,
          g t *
            (-(((2 * lambda : Real) : Complex) * Complex.I) /
              ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2)) *
              Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I) := by
  let E : Real → Complex := fun t =>
    Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)
  let Q : Real → Complex := fun t =>
    (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹
  let Q' : Real → Complex := fun t =>
    -(((2 * lambda : Real) : Complex) * Complex.I) /
      ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2)
  have hpos : ∀ x ∈ Set.uIcc a b, 0 < x := by
    intro x hx
    have hx' : x ∈ Set.Icc a b := by
      simpa [Set.uIcc_of_le hab] using hx
    exact lt_of_lt_of_le ha hx'.1
  have hbase_ne : ∀ x ∈ Set.uIcc a b,
      ((2 * lambda * x : Real) : Complex) * Complex.I ≠ 0 := by
    intro x hx
    have hx0 : x ≠ 0 := ne_of_gt (hpos x hx)
    have hlx : (2 * lambda * x : Real) ≠ 0 :=
      mul_ne_zero (mul_ne_zero (by norm_num) hlambda) hx0
    exact mul_ne_zero (Complex.ofReal_ne_zero.mpr hlx) Complex.I_ne_zero
  have hQ : ∀ x ∈ Set.uIcc a b, HasDerivAt Q (Q' x) x := by
    intro x hx
    dsimp [Q, Q']
    have hbase : HasDerivAt
        (fun y : Real => ((2 * lambda * y : Real) : Complex) * Complex.I)
        (((2 * lambda : Real) : Complex) * Complex.I) x := by
      have hreal : HasDerivAt (fun y : Real => 2 * lambda * y) (2 * lambda) x := by
        simpa [mul_assoc] using (hasDerivAt_id x).const_mul (2 * lambda)
      simpa only [Complex.real_smul] using hreal.smul_const Complex.I
    exact hbase.inv (hbase_ne x hx)
  have hE : ∀ x ∈ Set.uIcc a b,
      HasDerivAt E (E x * (((2 * lambda * x : Real) : Complex) * Complex.I)) x := by
    intro x hx
    dsimp [E]
    have hpoly : HasDerivAt
        (fun y : Real => ((lambda * y ^ 2 : Real) : Complex) * Complex.I)
        (((2 * lambda * x : Real) : Complex) * Complex.I) x := by
      have hreal : HasDerivAt (fun y : Real => lambda * y ^ 2) (2 * lambda * x) x := by
        simpa [mul_assoc, mul_left_comm, mul_comm] using
          (hasDerivAt_pow 2 x).const_mul lambda
      simpa only [Complex.real_smul] using hreal.smul_const Complex.I
    simpa [mul_assoc] using hpoly.cexp
  have hQE : ∀ x ∈ Set.uIcc a b,
      HasDerivAt (fun t => Q t * E t) (Q' x * E x + E x) x := by
    intro x hx
    have h := (hQ x hx).mul (hE x hx)
    convert h using 1 <;> try rfl
    have hne := hbase_ne x hx
    have hcancel : Q x *
        (E x * (((2 * lambda * x : Real) : Complex) * Complex.I)) = E x := by
      dsimp [Q]
      have hscalar : ((2 * lambda * x : Real) : Complex) ≠ 0 := by
        apply Complex.ofReal_ne_zero.mpr
        exact mul_ne_zero (mul_ne_zero (by norm_num) hlambda) (ne_of_gt (hpos x hx))
      field_simp [hne, hscalar]
    rw [hcancel]
  have hQcont : ContinuousOn Q (Set.uIcc a b) := by
    dsimp [Q]
    refine ContinuousOn.inv₀ (by fun_prop) ?_
    intro x hx
    exact hbase_ne x hx
  have hQ'cont : ContinuousOn Q' (Set.uIcc a b) := by
    dsimp [Q']
    refine ContinuousOn.div₀ (by fun_prop) (by fun_prop) ?_
    intro x hx
    exact pow_ne_zero 2 (hbase_ne x hx)
  have hEcont : ContinuousOn E (Set.uIcc a b) := by
    dsimp [E]
    fun_prop
  have hgcont : ContinuousOn g (Set.uIcc a b) := by
    intro x hx
    exact (hg x hx).continuousAt.continuousWithinAt
  have hparts := intervalIntegral.integral_mul_deriv_eq_deriv_mul
    (u := g) (u' := g') (v := fun t => Q t * E t)
    (v' := fun t => Q' t * E t + E t)
    hg hQE hg'cont.intervalIntegrable
    (hQ'cont.mul hEcont |>.add hEcont).intervalIntegrable
  have hsplit :
      (∫ t in a..b, g t * (Q' t * E t + E t)) =
        (∫ t in a..b, g t * Q' t * E t) +
          ∫ t in a..b, g t * E t := by
    have hfun : (fun t => g t * (Q' t * E t + E t)) =
        fun t => g t * Q' t * E t + g t * E t := by
      funext t
      ring
    rw [hfun, intervalIntegral.integral_add]
    · exact ((hgcont.mul hQ'cont).mul hEcont).intervalIntegrable
    · exact (hgcont.mul hEcont).intervalIntegrable
  rw [hsplit] at hparts
  change (∫ t in a..b, g t * E t) = _
  calc
    (∫ t in a..b, g t * E t) =
        ((∫ t in a..b, g t * Q' t * E t) +
          ∫ t in a..b, g t * E t) -
          ∫ t in a..b, g t * Q' t * E t := by ring
    _ = (g b * (Q b * E b) - g a * (Q a * E a) -
        ∫ t in a..b, g' t * (Q t * E t)) -
          ∫ t in a..b, g t * Q' t * E t := by rw [hparts]
    _ = g b * (Q b * E b) - g a * (Q a * E a) -
        (∫ t in a..b, g' t * Q t * E t) -
        ∫ t in a..b, g t * Q' t * E t := by
      have hgv : (∫ t in a..b, g' t * (Q t * E t)) =
          ∫ t in a..b, g' t * Q t * E t := by
        apply intervalIntegral.integral_congr
        intro t ht
        ring
      rw [hgv]
    _ = _ := by
      dsimp [Q, Q', E]
      ring

/-- A uniform nonstationary tail estimate for the Abel-damped unit Fresnel
phase.  It is the tail estimate needed to pass from the absolutely
convergent Gaussian integral to the improper oscillatory Fresnel integral.
The bound is deliberately independent of the damping parameter. -/
theorem brrs_dampedQuadraticFresnel_tail_norm_le
    {a b eps : Real} (ha : 0 < a) (hab : a ≤ b) (heps : 0 ≤ eps) :
    ‖∫ t in a..b,
      (Real.exp (-eps * t ^ 2) : Complex) *
        Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ ≤ 3 / a := by
  let g : Real → Complex := fun t => (Real.exp (-eps * t ^ 2) : Complex)
  let g' : Real → Complex := fun t =>
    (-(2 * eps * t) * Real.exp (-eps * t ^ 2) : Real)
  have hpos : ∀ x ∈ Set.uIcc a b, 0 < x := by
    intro x hx
    have hx' : x ∈ Set.Icc a b := by
      simpa [Set.uIcc_of_le hab] using hx
    exact lt_of_lt_of_le ha hx'.1
  have hg : ∀ x ∈ Set.uIcc a b, HasDerivAt g (g' x) x := by
    intro x hx
    have hpoly : HasDerivAt (fun t : Real => -eps * t ^ 2)
        (-(2 * eps * x)) x := by
      simpa [mul_assoc, mul_left_comm, mul_comm] using
        (hasDerivAt_pow 2 x).const_mul (-eps)
    have hexp := hpoly.exp
    dsimp [g, g']
    convert hexp.ofReal_comp using 1; push_cast; ring
  have hg'cont : ContinuousOn g' (Set.uIcc a b) := by
    dsimp [g']
    fun_prop
  have hid := brrs_quadratic_phase_weighted_integration_by_parts
    ha hab (by norm_num : (1 : Real) ≠ 0) g g' hg hg'cont
  have hexp_nonneg (x : Real) : 0 ≤ Real.exp (-eps * x ^ 2) :=
    (Real.exp_pos _).le
  have hexp_le_one (x : Real) : Real.exp (-eps * x ^ 2) ≤ 1 := by
    exact Real.exp_le_one_iff.mpr
      (mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr heps) (sq_nonneg x))
  have hgnorm (x : Real) : ‖g x‖ = Real.exp (-eps * x ^ 2) := by
    dsimp [g]
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hexp_nonneg x)]
  have hQcont : ContinuousOn
      (fun t : Real => (((2 * (1 : Real) * t : Real) : Complex) * Complex.I)⁻¹)
      (Set.uIcc a b) := by
    refine ContinuousOn.inv₀ (by fun_prop) ?_
    intro x hx
    apply mul_ne_zero
    · exact Complex.ofReal_ne_zero.mpr
        (mul_ne_zero (mul_ne_zero (by norm_num) (by norm_num))
          (ne_of_gt (hpos x hx)))
    · exact Complex.I_ne_zero
  have hQ'cont : ContinuousOn (fun t : Real =>
      -(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
        ((((2 * (1 : Real) * t : Real) : Complex) * Complex.I) ^ 2))
      (Set.uIcc a b) := by
    refine ContinuousOn.div₀ (by fun_prop) (by fun_prop) ?_
    intro x hx
    exact pow_ne_zero 2 (mul_ne_zero
      (Complex.ofReal_ne_zero.mpr
        (mul_ne_zero (mul_ne_zero (by norm_num) (by norm_num))
          (ne_of_gt (hpos x hx)))) Complex.I_ne_zero)
  have hEcont : ContinuousOn
      (fun t : Real => Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I))
      (Set.uIcc a b) := by
    fun_prop
  have hendpoint (x : Real) (hx : 0 < x) :
      ‖g x * (((2 * (1 : Real) * x : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((x ^ 2 : Real) : Complex) * Complex.I)‖ ≤ 1 / (2 * x) := by
    rw [norm_mul, norm_mul, hgnorm, norm_inv, norm_mul, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos (by positivity : 0 < 2 * (1 : Real) * x),
      Complex.norm_I, Complex.norm_exp_ofReal_mul_I]
    norm_num
    have harg : -(eps * x ^ 2) = -eps * x ^ 2 := by ring
    rw [harg]
    calc
      Real.exp (-eps * x ^ 2) * (x⁻¹ * (1 / 2)) ≤
          1 * (x⁻¹ * (1 / 2)) :=
        mul_le_mul_of_nonneg_right (hexp_le_one x)
          (mul_nonneg (inv_nonneg.mpr hx.le) (by norm_num))
      _ = x⁻¹ * (1 / 2) := one_mul _
  have hsmall (x : Real) (hx : 0 < x) :
      eps * Real.exp (-eps * x ^ 2) ≤ (x ^ 2)⁻¹ := by
    have hcore : eps * x ^ 2 * Real.exp (-eps * x ^ 2) ≤ 1 := by
      have hraw : eps * x ^ 2 * Real.exp (-(eps * x ^ 2)) ≤ 1 :=
        (Real.mul_exp_neg_le_exp_neg_one (eps * x ^ 2)).trans
          (Real.exp_le_one_iff.mpr (by norm_num))
      have harg : -(eps * x ^ 2) = -eps * x ^ 2 := by ring
      rwa [harg] at hraw
    have hx2 : 0 < x ^ 2 := sq_pos_of_pos hx
    calc
      eps * Real.exp (-eps * x ^ 2) =
          (eps * x ^ 2 * Real.exp (-eps * x ^ 2)) * (x ^ 2)⁻¹ := by
            field_simp [ne_of_gt hx2]
      _ ≤ 1 * (x ^ 2)⁻¹ :=
        mul_le_mul_of_nonneg_right hcore (inv_nonneg.mpr hx2.le)
      _ = (x ^ 2)⁻¹ := one_mul _
  have hderiv_point : ∀ x ∈ Set.Icc a b,
      ‖g' x * (((2 * (1 : Real) * x : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((x ^ 2 : Real) : Complex) * Complex.I)‖ ≤ (x ^ 2)⁻¹ := by
    intro x hx
    have hx' : x ∈ Set.uIcc a b := by
      simpa [Set.uIcc_of_le hab] using hx
    have hxpos := hpos x hx'
    have hnorm :
        ‖g' x * (((2 * (1 : Real) * x : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((x ^ 2 : Real) : Complex) * Complex.I)‖ =
          eps * Real.exp (-eps * x ^ 2) := by
      dsimp [g']
      simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, norm_inv,
        Complex.norm_I, Complex.norm_exp_ofReal_mul_I]
      rw [abs_neg,
        abs_of_nonneg (mul_nonneg (mul_nonneg (by norm_num) heps) hxpos.le),
        abs_of_nonneg (hexp_nonneg x), abs_of_pos hxpos]
      norm_num
      field_simp [ne_of_gt hxpos]
    rw [hnorm]
    exact hsmall x hxpos
  have hrem_point : ∀ x ∈ Set.Icc a b,
      ‖g x *
          (-(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
            ((((2 * (1 : Real) * x : Real) : Complex) * Complex.I) ^ 2)) *
          Complex.exp (((x ^ 2 : Real) : Complex) * Complex.I)‖ ≤ (x ^ 2)⁻¹ := by
    intro x hx
    have hx' : x ∈ Set.uIcc a b := by
      simpa [Set.uIcc_of_le hab] using hx
    have hxpos := hpos x hx'
    have hnorm :
        ‖g x *
            (-(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
              ((((2 * (1 : Real) * x : Real) : Complex) * Complex.I) ^ 2)) *
            Complex.exp (((x ^ 2 : Real) : Complex) * Complex.I)‖ =
          Real.exp (-eps * x ^ 2) * ((2 : Real)⁻¹ * (x ^ 2)⁻¹) := by
      simp only [norm_mul, hgnorm, norm_div, norm_neg, Complex.norm_real,
        Real.norm_eq_abs, Complex.norm_I, norm_pow, Complex.norm_exp_ofReal_mul_I]
      rw [abs_of_pos (by norm_num), abs_of_pos hxpos]
      norm_num
      field_simp [ne_of_gt hxpos]
    rw [hnorm]
    calc
      Real.exp (-eps * x ^ 2) * ((2 : Real)⁻¹ * (x ^ 2)⁻¹) ≤
          1 * (1 * (x ^ 2)⁻¹) := by
        calc
          Real.exp (-eps * x ^ 2) * ((2 : Real)⁻¹ * (x ^ 2)⁻¹) ≤
              1 * ((2 : Real)⁻¹ * (x ^ 2)⁻¹) :=
            mul_le_mul_of_nonneg_right (hexp_le_one x)
              (mul_nonneg (inv_nonneg.mpr (by norm_num))
                (inv_nonneg.mpr (sq_nonneg x)))
          _ ≤ 1 * (1 * (x ^ 2)⁻¹) := by
            gcongr
            exact inv_le_one_of_one_le₀ (by norm_num)
      _ = (x ^ 2)⁻¹ := by norm_num
  have hinvsq_cont : ContinuousOn (fun t : Real => (t ^ 2)⁻¹) (Set.uIcc a b) := by
    refine (continuous_id.pow 2).continuousOn.inv₀ ?_
    intro x hx
    exact pow_ne_zero 2 (ne_of_gt (hpos x hx))
  have hinvsq_int : IntervalIntegrable (fun t : Real => (t ^ 2)⁻¹) volume a b :=
    hinvsq_cont.intervalIntegrable
  have hderiv_int : IntervalIntegrable (fun t : Real =>
      ‖g' t * (((2 * (1 : Real) * t : Real) : Complex) * Complex.I)⁻¹ *
        Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖) volume a b :=
    ((hg'cont.mul hQcont).mul hEcont).norm.intervalIntegrable
  have hrem_int : IntervalIntegrable (fun t : Real =>
      ‖g t *
          (-(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
            ((((2 * (1 : Real) * t : Real) : Complex) * Complex.I) ^ 2)) *
          Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖) volume a b :=
    (((show ContinuousOn g (Set.uIcc a b) from fun x hx =>
      (hg x hx).continuousAt.continuousWithinAt).mul hQ'cont).mul hEcont).norm.intervalIntegrable
  have hderiv_bound :
      ‖∫ t in a..b,
          g' t * (((2 * (1 : Real) * t : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        a⁻¹ - b⁻¹ := by
    calc
      ‖∫ t in a..b,
          g' t * (((2 * (1 : Real) * t : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
          ∫ t in a..b,
            ‖g' t * (((2 * (1 : Real) * t : Real) : Complex) * Complex.I)⁻¹ *
              Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ :=
        intervalIntegral.norm_integral_le_integral_norm hab
      _ ≤ ∫ t in a..b, (t ^ 2)⁻¹ :=
        intervalIntegral.integral_mono_on hab hderiv_int hinvsq_int hderiv_point
      _ = a⁻¹ - b⁻¹ := brrs_intervalIntegral_inv_sq ha hab
  have hrem_bound :
      ‖∫ t in a..b,
          g t *
            (-(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
              ((((2 * (1 : Real) * t : Real) : Complex) * Complex.I) ^ 2)) *
            Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        a⁻¹ - b⁻¹ := by
    calc
      ‖∫ t in a..b,
          g t *
            (-(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
              ((((2 * (1 : Real) * t : Real) : Complex) * Complex.I) ^ 2)) *
            Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
          ∫ t in a..b,
            ‖g t *
              (-(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
                ((((2 * (1 : Real) * t : Real) : Complex) * Complex.I) ^ 2)) *
              Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ :=
        intervalIntegral.norm_integral_le_integral_norm hab
      _ ≤ ∫ t in a..b, (t ^ 2)⁻¹ :=
        intervalIntegral.integral_mono_on hab hrem_int hinvsq_int hrem_point
      _ = a⁻¹ - b⁻¹ := brrs_intervalIntegral_inv_sq ha hab
  have hbpos : 0 < b := lt_of_lt_of_le ha hab
  have hinv_ba : 1 / (2 * b) ≤ 1 / (2 * a) := by
    exact one_div_le_one_div_of_le (by positivity)
      (mul_le_mul_of_nonneg_left hab (by norm_num))
  change ‖∫ t in a..b,
      g t * Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ ≤ 3 / a
  simp only [one_mul] at hid
  rw [hid]
  calc
    ‖g b * (((2 * (1 : Real) * b : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((b ^ 2 : Real) : Complex) * Complex.I) -
        g a * (((2 * (1 : Real) * a : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((a ^ 2 : Real) : Complex) * Complex.I) -
        (∫ t in a..b,
          g' t * (((2 * (1 : Real) * t : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)) -
        ∫ t in a..b,
          g t *
            (-(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
              ((((2 * (1 : Real) * t : Real) : Complex) * Complex.I) ^ 2)) *
            Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        ‖g b * (((2 * (1 : Real) * b : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((b ^ 2 : Real) : Complex) * Complex.I)‖ +
        ‖g a * (((2 * (1 : Real) * a : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((a ^ 2 : Real) : Complex) * Complex.I)‖ +
        ‖∫ t in a..b,
          g' t * (((2 * (1 : Real) * t : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ +
        ‖∫ t in a..b,
          g t *
            (-(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
              ((((2 * (1 : Real) * t : Real) : Complex) * Complex.I) ^ 2)) *
            Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ := by
      calc
        _ ≤ ‖g b * (((2 * (1 : Real) * b : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((b ^ 2 : Real) : Complex) * Complex.I) -
          g a * (((2 * (1 : Real) * a : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((a ^ 2 : Real) : Complex) * Complex.I) -
          (∫ t in a..b,
            g' t * (((2 * (1 : Real) * t : Real) : Complex) * Complex.I)⁻¹ *
              Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I))‖ +
          ‖∫ t in a..b,
            g t *
              (-(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
                ((((2 * (1 : Real) * t : Real) : Complex) * Complex.I) ^ 2)) *
              Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ := norm_sub_le _ _
        _ ≤ (‖g b * (((2 * (1 : Real) * b : Real) : Complex) * Complex.I)⁻¹ *
              Complex.exp (((b ^ 2 : Real) : Complex) * Complex.I)‖ +
            ‖g a * (((2 * (1 : Real) * a : Real) : Complex) * Complex.I)⁻¹ *
              Complex.exp (((a ^ 2 : Real) : Complex) * Complex.I)‖ +
            ‖∫ t in a..b,
              g' t * (((2 * (1 : Real) * t : Real) : Complex) * Complex.I)⁻¹ *
                Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖) +
            ‖∫ t in a..b,
              g t *
                (-(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
                  ((((2 * (1 : Real) * t : Real) : Complex) * Complex.I) ^ 2)) *
                Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ := by
          calc
            _ ≤ (‖g b * (((2 * (1 : Real) * b : Real) : Complex) * Complex.I)⁻¹ *
                  Complex.exp (((b ^ 2 : Real) : Complex) * Complex.I) -
                g a * (((2 * (1 : Real) * a : Real) : Complex) * Complex.I)⁻¹ *
                  Complex.exp (((a ^ 2 : Real) : Complex) * Complex.I)‖ +
                ‖∫ t in a..b,
                  g' t * (((2 * (1 : Real) * t : Real) : Complex) * Complex.I)⁻¹ *
                    Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖) +
                ‖∫ t in a..b,
                  g t *
                    (-(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
                      ((((2 * (1 : Real) * t : Real) : Complex) * Complex.I) ^ 2)) *
                    Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ := by
              exact add_le_add_left
                (norm_sub_le
                  (g b * (((2 * (1 : Real) * b : Real) : Complex) * Complex.I)⁻¹ *
                    Complex.exp (((b ^ 2 : Real) : Complex) * Complex.I) -
                    g a * (((2 * (1 : Real) * a : Real) : Complex) * Complex.I)⁻¹ *
                      Complex.exp (((a ^ 2 : Real) : Complex) * Complex.I))
                  (∫ t in a..b,
                    g' t * (((2 * (1 : Real) * t : Real) : Complex) * Complex.I)⁻¹ *
                      Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I))) _
            _ ≤ _ := by
              exact add_le_add_left (add_le_add_left
                (norm_sub_le
                  (g b * (((2 * (1 : Real) * b : Real) : Complex) * Complex.I)⁻¹ *
                    Complex.exp (((b ^ 2 : Real) : Complex) * Complex.I))
                  (g a * (((2 * (1 : Real) * a : Real) : Complex) * Complex.I)⁻¹ *
                    Complex.exp (((a ^ 2 : Real) : Complex) * Complex.I))) _) _
        _ = _ := by ring
    _ ≤ 1 / (2 * b) + 1 / (2 * a) + (a⁻¹ - b⁻¹) + (a⁻¹ - b⁻¹) := by
      nlinarith [hendpoint b hbpos, hendpoint a ha, hderiv_bound, hrem_bound]
    _ ≤ 3 / a := by
      have hbinv_nonneg : 0 ≤ b⁻¹ := inv_nonneg.mpr hbpos.le
      have hainv_nonneg : 0 ≤ a⁻¹ := inv_nonneg.mpr ha.le
      calc
        1 / (2 * b) + 1 / (2 * a) + (a⁻¹ - b⁻¹) + (a⁻¹ - b⁻¹) ≤
            1 / (2 * a) + 1 / (2 * a) + a⁻¹ + a⁻¹ := by
          nlinarith [hinv_ba]
        _ = 3 / a := by field_simp [ne_of_gt ha]; ring

/-- Algebraic separation of Abel damping from the unit Fresnel phase. -/
private theorem brrs_abelDampedFresnel_integrand_eq (eps x : Real) :
    Complex.exp (-(((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) =
      (Real.exp (-eps * x ^ 2) : Complex) *
        Complex.exp (((x ^ 2 : Real) : Complex) * Complex.I) := by
  have harg : -(((eps : Complex) - Complex.I) * (x : Complex) ^ 2) =
      ((-eps * x ^ 2 : Real) : Complex) +
        ((x ^ 2 : Real) : Complex) * Complex.I := by
    push_cast
    ring
  rw [harg, Complex.exp_add, ← Complex.ofReal_exp]

/-- On every fixed finite interval, Abel damping converges to the undamped
quadratic phase by dominated convergence.  This is kept private because it is
only the local step in the evaluation of the improper Fresnel carrier. -/
private theorem brrs_dampedQuadraticFresnel_finite_tendsto (A : Real) :
    Tendsto (fun eps : Real =>
      ∫ x in (0 : Real)..A,
        Complex.exp (-(((eps : Complex) - Complex.I) * (x : Complex) ^ 2)))
      (nhdsWithin 0 (Set.Ioi 0))
      (nhds (intervalIntegral (fun x : Real =>
        Complex.exp (((x ^ 2 : Real) : Complex) * Complex.I)) 0 A volume)) := by
  refine intervalIntegral.tendsto_integral_filter_of_dominated_convergence
    (μ := volume) (a := (0 : Real)) (b := A)
    (l := nhdsWithin 0 (Set.Ioi 0))
    (F := fun (eps : Real) (x : Real) =>
      Complex.exp (-(((eps : Complex) - Complex.I) * (x : Complex) ^ 2)))
    (f := fun (x : Real) =>
      Complex.exp (((x ^ 2 : Real) : Complex) * Complex.I))
    (bound := fun _ : Real => (1 : Real)) ?_ ?_ ?_ ?_
  · filter_upwards [self_mem_nhdsWithin] with eps heps
    fun_prop
  · filter_upwards [self_mem_nhdsWithin] with eps heps
    filter_upwards with x hx
    have harg : -(((eps : Complex) - Complex.I) * (x : Complex) ^ 2) =
        -((eps : Complex) - Complex.I) * (x : Complex) ^ 2 := by
      ring
    rw [harg]
    rw [norm_cexp_neg_mul_sq]
    simp only [Complex.sub_re, Complex.ofReal_re, Complex.I_re, sub_zero]
    exact Real.exp_le_one_iff.mpr
      (mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr heps.le) (sq_nonneg x))
  · exact (continuous_const : Continuous (fun _ : Real => (1 : Real))).intervalIntegrable 0 A
  · filter_upwards with x hx
    have hcont : ContinuousAt (fun eps : Real =>
        Complex.exp (-(((eps : Complex) - Complex.I) * (x : Complex) ^ 2))) 0 := by
      fun_prop
    have hzero :
        Complex.exp (-((((0 : Real) : Complex) - Complex.I) * (x : Complex) ^ 2)) =
          Complex.exp (((x ^ 2 : Real) : Complex) * Complex.I) := by
      congr 1
      push_cast
      ring
    have hleft : nhdsWithin (0 : Real) (Set.Ioi 0) ≤ nhds 0 :=
      nhdsWithin_le_nhds
    have ht := hcont.tendsto.mono_left hleft
    rw [hzero] at ht
    exact ht

/-- Uniform passage from a finite Abel-damped Fresnel truncation to its
absolutely convergent half-line integral. -/
private theorem brrs_abelDampedFresnel_improper_tail_norm_le
    {eps A : Real} (heps : 0 < eps) (hA : 0 < A) :
    ‖(∫ x in Set.Ioi (0 : Real),
        Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
      ∫ x in (0 : Real)..A,
        Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)‖ ≤
      3 / A := by
  let F : Real → Complex := fun x =>
    Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)
  change ‖(∫ x in Set.Ioi (0 : Real), F x) - ∫ x in (0 : Real)..A, F x‖ ≤ 3 / A
  have hFint : Integrable F := by
    dsimp [F]
    exact integrable_cexp_neg_mul_sq (by
      simp only [Complex.sub_re, Complex.ofReal_re, Complex.I_re, sub_zero]
      exact heps)
  have hFcont : Continuous F := by
    dsimp [F]
    fun_prop
  have hlim : Tendsto (fun R : Real => ∫ x in (0 : Real)..R, F x) atTop
      (nhds (∫ x in Set.Ioi (0 : Real), F x)) :=
    intervalIntegral_tendsto_integral_Ioi 0 hFint.integrableOn tendsto_id
  have hbase := hlim.sub (tendsto_const_nhds : Tendsto
    (fun _ : Real => ∫ x in (0 : Real)..A, F x) atTop
    (nhds (∫ x in (0 : Real)..A, F x)))
  have hdiff : Tendsto (fun R : Real => ∫ x in A..R, F x) atTop
      (nhds ((∫ x in Set.Ioi (0 : Real), F x) - ∫ x in (0 : Real)..A, F x)) := by
    refine hbase.congr' ?_
    filter_upwards with R
    rw [← intervalIntegral.integral_add_adjacent_intervals
      (hFcont.intervalIntegrable 0 A) (hFcont.intervalIntegrable A R)]
    abel
  have hsplit (R : Real) :
      (∫ x in A..R, F x) =
        ∫ x in A..R,
          (Real.exp (-eps * x ^ 2) : Complex) *
            Complex.exp (((x ^ 2 : Real) : Complex) * Complex.I) := by
    apply intervalIntegral.integral_congr
    intro x hx
    dsimp [F]
    convert brrs_abelDampedFresnel_integrand_eq eps x using 1; ring
  have hevent : ∀ᶠ R : Real in atTop,
      ‖∫ x in A..R, F x‖ ≤ 3 / A := by
    filter_upwards [eventually_ge_atTop A] with R hR
    rw [hsplit R]
    exact brrs_dampedQuadraticFresnel_tail_norm_le hA hR heps.le
  exact le_of_tendsto hdiff.norm hevent

/-- The finite undamped Fresnel truncation remains within its elementary
`A⁻¹` nonstationary tail of the improper carrier. -/
private theorem brrsNormalizedQuadraticFresnelIntegral_distance_to_limit_le
    {A : Real} (hA : 0 < A) :
    ‖brrsNormalizedQuadraticFresnelIntegral A - brrsQuadraticFresnelLimit‖ ≤ A⁻¹ := by
  have hbase := brrsNormalizedQuadraticFresnelIntegral_tendsto_limit.sub
    (tendsto_const_nhds : Tendsto
      (fun _ : Real => brrsNormalizedQuadraticFresnelIntegral A) atTop
      (nhds (brrsNormalizedQuadraticFresnelIntegral A)))
  have hevent : ∀ᶠ R : Real in atTop,
      ‖brrsNormalizedQuadraticFresnelIntegral R -
          brrsNormalizedQuadraticFresnelIntegral A‖ ≤ A⁻¹ := by
    filter_upwards [eventually_ge_atTop A] with R hR
    exact brrsNormalizedQuadraticFresnelIntegral_tail_distance_le hA hR
  have hle : ‖brrsQuadraticFresnelLimit -
      brrsNormalizedQuadraticFresnelIntegral A‖ ≤ A⁻¹ :=
    le_of_tendsto hbase.norm hevent
  rw [norm_sub_rev] at hle
  exact hle

/-- Abel damping converges to the improper normalized quadratic Fresnel
carrier.  The proof uses dominated convergence on each finite interval and a
uniform nonstationary tail, so no unproved oscillatory-integral identity is
being assumed. -/
theorem brrs_abelDampedFresnelIntegral_tendsto_limit :
    Tendsto (fun eps : Real =>
      ∫ x in Set.Ioi (0 : Real),
        Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2))
      (nhdsWithin 0 (Set.Ioi 0))
      (nhds brrsQuadraticFresnelLimit) := by
  refine Metric.tendsto_nhds.mpr ?_
  intro eta heta
  let A : Real := 16 / eta
  have hA : 0 < A := by
    dsimp [A]
    positivity
  have hAinv : A⁻¹ = eta / 16 := by
    dsimp [A]
    field_simp [ne_of_gt heta]
  have hthreeA : 3 / A = 3 * eta / 16 := by
    rw [div_eq_mul_inv, hAinv]
    ring
  have htail0 : ‖brrsNormalizedQuadraticFresnelIntegral A -
      brrsQuadraticFresnelLimit‖ ≤ A⁻¹ :=
    brrsNormalizedQuadraticFresnelIntegral_distance_to_limit_le hA
  have hmid : ∀ᶠ eps : Real in nhdsWithin 0 (Set.Ioi 0),
      ‖(∫ x in (0 : Real)..A,
          Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
          brrsNormalizedQuadraticFresnelIntegral A‖ < eta / 2 := by
    have hfinite : Tendsto (fun eps : Real =>
        ∫ x in (0 : Real)..A,
          Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2))
        (nhdsWithin 0 (Set.Ioi 0))
        (nhds (brrsNormalizedQuadraticFresnelIntegral A)) := by
      refine (brrs_dampedQuadraticFresnel_finite_tendsto A).congr' ?_
      filter_upwards with eps
      apply intervalIntegral.integral_congr
      intro x hx
      ring
    simpa only [brrsNormalizedQuadraticFresnelIntegral, dist_eq_norm] using
      (Metric.tendsto_nhds.mp hfinite
        (eta / 2) (by positivity))
  filter_upwards [hmid, self_mem_nhdsWithin] with eps hmid_eps heps
  rw [dist_eq_norm]
  have htail_eps :
      ‖(∫ x in Set.Ioi (0 : Real),
          Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
        ∫ x in (0 : Real)..A,
          Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)‖ ≤ 3 / A :=
    brrs_abelDampedFresnel_improper_tail_norm_le heps hA
  calc
    ‖(∫ x in Set.Ioi (0 : Real),
        Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
        brrsQuadraticFresnelLimit‖ ≤
        ‖(∫ x in Set.Ioi (0 : Real),
          Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
            ∫ x in (0 : Real)..A,
              Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)‖ +
          ‖(∫ x in (0 : Real)..A,
            Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
              brrsNormalizedQuadraticFresnelIntegral A‖ +
          ‖brrsNormalizedQuadraticFresnelIntegral A -
              brrsQuadraticFresnelLimit‖ := by
      calc
        _ = ‖((∫ x in Set.Ioi (0 : Real),
              Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
              ∫ x in (0 : Real)..A,
                Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) +
            (((∫ x in (0 : Real)..A,
                Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
                brrsNormalizedQuadraticFresnelIntegral A) +
              (brrsNormalizedQuadraticFresnelIntegral A -
                brrsQuadraticFresnelLimit))‖ := by
            congr 1
            ring
        _ ≤ _ := by
          calc
            _ ≤ ‖(∫ x in Set.Ioi (0 : Real),
                Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
                ∫ x in (0 : Real)..A,
                  Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)‖ +
                ‖((∫ x in (0 : Real)..A,
                    Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
                    brrsNormalizedQuadraticFresnelIntegral A) +
                  (brrsNormalizedQuadraticFresnelIntegral A -
                    brrsQuadraticFresnelLimit)‖ := norm_add_le _ _
            _ ≤ _ := by
              simpa only [add_assoc] using
                (add_le_add_right
                  (norm_add_le
                    ((∫ x in (0 : Real)..A,
                      Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
                      brrsNormalizedQuadraticFresnelIntegral A)
                    (brrsNormalizedQuadraticFresnelIntegral A -
                      brrsQuadraticFresnelLimit))
                  ‖(∫ x in Set.Ioi (0 : Real),
                    Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
                    ∫ x in (0 : Real)..A,
                      Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)‖)
    _ < 3 / A + eta / 2 + A⁻¹ := by
      calc
        _ ≤ 3 / A +
            ‖(∫ x in (0 : Real)..A,
              Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
                brrsNormalizedQuadraticFresnelIntegral A‖ + A⁻¹ := by
          gcongr
        _ < _ := by
          have hleft : 3 / A +
              ‖(∫ x in (0 : Real)..A,
                Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
                  brrsNormalizedQuadraticFresnelIntegral A‖ <
              3 / A + eta / 2 :=
            add_lt_add_right hmid_eps (3 / A)
          simpa only [add_assoc] using add_lt_add_left hleft A⁻¹
    _ < eta := by
      rw [hthreeA, hAinv]
      nlinarith

/-- The Abel-regularized quadratic carrier is an ordinary complex Gaussian
integral.  This is the exact special-function bridge used to identify the
even stationary-endpoint constant; it does not introduce a separate Bessel
normalization. -/
theorem brrs_abelDampedFresnelIntegral_eq_gaussian
    {eps : Real} (heps : 0 < eps) :
    (∫ x in Set.Ioi (0 : Real),
      Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) =
      ((Real.pi : Complex) / ((eps : Complex) - Complex.I)) ^ (1 / 2 : Complex) / 2 := by
  simpa using
    (integral_gaussian_complex_Ioi (b := (eps : Complex) - Complex.I) (by simpa using heps))

/-- Rewriting the Abel regularization by the complex Gaussian formula gives a
closed-form limiting description of the normalized Fresnel carrier. -/
theorem brrs_gaussianAbelFresnel_tendsto_limit :
    Tendsto (fun eps : Real =>
      ((Real.pi : Complex) / ((eps : Complex) - Complex.I)) ^ (1 / 2 : Complex) / 2)
      (nhdsWithin 0 (Set.Ioi 0))
      (nhds brrsQuadraticFresnelLimit) := by
  refine brrs_abelDampedFresnelIntegral_tendsto_limit.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with eps heps
  exact brrs_abelDampedFresnelIntegral_eq_gaussian heps

/-- Exact boundary value of the normalized quadratic Fresnel carrier, before
choosing a trigonometric presentation of its square-root phase. -/
theorem brrsQuadraticFresnelLimit_eq_gaussianBoundary :
    brrsQuadraticFresnelLimit =
      ((Real.pi : Complex) / (-Complex.I)) ^ (1 / 2 : Complex) / 2 := by
  have hden : Tendsto (fun eps : Real => (eps : Complex) - Complex.I)
      (nhdsWithin 0 (Set.Ioi 0)) (nhds (-Complex.I)) := by
    have hcont : ContinuousAt (fun eps : Real => (eps : Complex) - Complex.I) 0 := by
      fun_prop
    simpa using hcont.tendsto.mono_left
      (nhdsWithin_le_nhds : nhdsWithin (0 : Real) (Set.Ioi 0) ≤ nhds 0)
  have hratio : Tendsto (fun eps : Real =>
      (Real.pi : Complex) / ((eps : Complex) - Complex.I))
      (nhdsWithin 0 (Set.Ioi 0))
      (nhds ((Real.pi : Complex) / (-Complex.I))) := by
    have hcont : ContinuousAt (fun eps : Real =>
        (Real.pi : Complex) / ((eps : Complex) - Complex.I)) 0 := by
      exact continuousAt_const.div
        (Complex.continuous_ofReal.continuousAt.sub continuousAt_const) (by simp)
    simpa using hcont.tendsto.mono_left
      (nhdsWithin_le_nhds : nhdsWithin (0 : Real) (Set.Ioi 0) ≤ nhds 0)
  have hslit : (Real.pi : Complex) / (-Complex.I) ∈ Complex.slitPlane := by
    rw [Complex.mem_slitPlane_iff]
    right
    simp [div_eq_mul_inv, Real.pi_ne_zero]
  have hpow : Tendsto (fun eps : Real =>
      ((Real.pi : Complex) / ((eps : Complex) - Complex.I)) ^ (1 / 2 : Complex))
      (nhdsWithin 0 (Set.Ioi 0))
      (nhds (((Real.pi : Complex) / (-Complex.I)) ^ (1 / 2 : Complex))) :=
    (continuousAt_cpow_const hslit).tendsto.comp hratio
  have hclosed : Tendsto (fun eps : Real =>
      ((Real.pi : Complex) / ((eps : Complex) - Complex.I)) ^ (1 / 2 : Complex) / 2)
      (nhdsWithin 0 (Set.Ioi 0))
      (nhds (((Real.pi : Complex) / (-Complex.I)) ^ (1 / 2 : Complex) / 2)) := by
    simpa only [Pi.div_apply] using hpow.div_const (2 : Complex)
  exact tendsto_nhds_unique brrs_gaussianAbelFresnel_tendsto_limit hclosed

/-- The normalized Fresnel carrier has the standard positive-phase value.
The formula records both real and imaginary leading components and is the
constant needed by the even stationary-endpoint expansion. -/
theorem brrsQuadraticFresnelLimit_eq_explicit :
    brrsQuadraticFresnelLimit =
      ((Real.sqrt (Real.pi / 2) : Complex) * (1 + Complex.I)) / 2 := by
  rw [brrsQuadraticFresnelLimit_eq_gaussianBoundary]
  have hratio : (Real.pi : Complex) / (-Complex.I) = (Real.pi : Complex) * Complex.I := by
    field_simp
    simp
  rw [hratio]
  have hhalf : (1 / 2 : Complex) = (2⁻¹ : Complex) := by rw [one_div]
  rw [hhalf]
  change Complex.sqrt ((Real.pi : Complex) * Complex.I) / 2 = _
  rw [Complex.sqrt_eq_real_add_ite]
  simp only [Complex.norm_mul, Complex.norm_real, Real.norm_eq_abs, Complex.norm_I, mul_one,
      Complex.mul_re, Complex.ofReal_re, Complex.I_re, mul_zero, Complex.ofReal_im, Complex.I_im,
      sub_self, add_zero, abs_nonneg, Real.sqrt_div, Complex.ofReal_div, Complex.mul_im,
      Real.pi_pos.le, ↓reduceIte, sub_zero, one_mul, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true,
      div_left_inj']
  rw [abs_of_pos Real.pi_pos]
  ring

/-- A refined quadratic nonstationary-tail bound.  Besides a derivative bound,
the amplitude is assumed to vanish to first order at the stationary endpoint
in the explicit form `‖g x‖ ≤ N * x`.  The resulting logarithm is exactly the
integral of `x⁻¹`; after the substitution `v = sqrt(lambda) * x` it gives a
vanishing `log(lambda) / sqrt(lambda)` error, rather than a merely bounded
one. -/
theorem brrs_quadratic_phase_weighted_tail_norm_le_of_cone
    {a b lambda N : Real} (ha : 0 < a) (hab : a ≤ b) (hlambda : 0 < lambda)
    (g g' : Real → Complex)
    (hg : ∀ x ∈ Set.uIcc a b, HasDerivAt g (g' x) x)
    (hg'cont : ContinuousOn g' (Set.uIcc a b))
    (hg_cone : ∀ x ∈ Set.Icc a b, ‖g x‖ ≤ N * x)
    (hg'_bound : ∀ x ∈ Set.uIcc a b, ‖g' x‖ ≤ N) :
    ‖∫ t in a..b, g t * Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
      (N / lambda) * (1 + Real.log (b / a)) := by
  have hpos : ∀ x ∈ Set.uIcc a b, 0 < x := by
    intro x hx
    have hx' : x ∈ Set.Icc a b := by
      simpa [Set.uIcc_of_le hab] using hx
    exact lt_of_lt_of_le ha hx'.1
  have hbpos : 0 < b := lt_of_lt_of_le ha hab
  have htwolambda : 0 < 2 * lambda := by positivity
  have htwoa : 0 < 2 * lambda * a := by positivity
  have htwob : 0 < 2 * lambda * b := by positivity
  have hbase_ne : ∀ x ∈ Set.uIcc a b,
      ((2 * lambda * x : Real) : Complex) * Complex.I ≠ 0 := by
    intro x hx
    have hx0 : x ≠ 0 := ne_of_gt (hpos x hx)
    have hlx : (2 * lambda * x : Real) ≠ 0 :=
      mul_ne_zero (mul_ne_zero (by norm_num) hlambda.ne') hx0
    exact mul_ne_zero (Complex.ofReal_ne_zero.mpr hlx) Complex.I_ne_zero
  have hQnorm : ∀ x ∈ Set.uIcc a b,
      ‖(((2 * lambda * x : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * x ^ 2 : Real) : Complex) * Complex.I)‖ =
        (2 * lambda * x)⁻¹ := by
    intro x hx
    rw [norm_mul, norm_inv, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos (mul_pos (mul_pos (by norm_num) hlambda) (hpos x hx)),
      Complex.norm_exp_ofReal_mul_I]
    simp [Complex.norm_I]
  have hQ'norm : ∀ x ∈ Set.uIcc a b,
      ‖(-(((2 * lambda : Real) : Complex) * Complex.I) /
          ((((2 * lambda * x : Real) : Complex) * Complex.I) ^ 2)) *
          Complex.exp (((lambda * x ^ 2 : Real) : Complex) * Complex.I)‖ =
        (2 * lambda)⁻¹ * (x ^ 2)⁻¹ := by
    intro x hx
    rw [norm_mul, norm_div, norm_neg, norm_mul, norm_pow, norm_mul,
      Complex.norm_real, Complex.norm_real, Real.norm_eq_abs, Real.norm_eq_abs,
      abs_of_pos (mul_pos (by norm_num) hlambda),
      abs_of_pos (mul_pos (mul_pos (by norm_num) hlambda) (hpos x hx)),
      Complex.norm_exp_ofReal_mul_I]
    simp [Complex.norm_I]
    field_simp
  have hgcont : ContinuousOn g (Set.uIcc a b) := by
    intro x hx
    exact (hg x hx).continuousAt.continuousWithinAt
  have hQcont : ContinuousOn
      (fun t : Real => (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹)
      (Set.uIcc a b) := by
    refine ContinuousOn.inv₀ (by fun_prop) ?_
    intro x hx
    exact hbase_ne x hx
  have hQ'cont : ContinuousOn (fun t : Real =>
      -(((2 * lambda : Real) : Complex) * Complex.I) /
        ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2))
      (Set.uIcc a b) := by
    refine ContinuousOn.div₀ (by fun_prop) (by fun_prop) ?_
    intro x hx
    exact pow_ne_zero 2 (hbase_ne x hx)
  have hEcont : ContinuousOn
      (fun t : Real => Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I))
      (Set.uIcc a b) := by
    fun_prop
  have hendpoint_a :
      ‖g a * (((2 * lambda * a : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * a ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        N / (2 * lambda) := by
    conv_lhs => rw [mul_assoc]
    rw [norm_mul, hQnorm a Set.left_mem_uIcc]
    calc
      ‖g a‖ * (2 * lambda * a)⁻¹ ≤
          (N * a) * (2 * lambda * a)⁻¹ :=
        mul_le_mul_of_nonneg_right (hg_cone a ⟨le_rfl, hab⟩)
          (inv_nonneg.mpr htwoa.le)
      _ = N / (2 * lambda) := by
        field_simp [ne_of_gt htwolambda, ne_of_gt ha]
  have hendpoint_b :
      ‖g b * (((2 * lambda * b : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * b ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        N / (2 * lambda) := by
    conv_lhs => rw [mul_assoc]
    rw [norm_mul, hQnorm b Set.right_mem_uIcc]
    calc
      ‖g b‖ * (2 * lambda * b)⁻¹ ≤
          (N * b) * (2 * lambda * b)⁻¹ :=
        mul_le_mul_of_nonneg_right (hg_cone b ⟨hab, le_rfl⟩)
          (inv_nonneg.mpr htwob.le)
      _ = N / (2 * lambda) := by
        field_simp [ne_of_gt htwolambda, ne_of_gt hbpos]
  have hg'point : ∀ x ∈ Set.Icc a b,
      ‖g' x * (((2 * lambda * x : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * x ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        (N / (2 * lambda)) * x⁻¹ := by
    intro x hx
    have hx' : x ∈ Set.uIcc a b := by
      simpa [Set.uIcc_of_le hab] using hx
    have hx0 : x ≠ 0 := ne_of_gt (hpos x hx')
    conv_lhs => rw [mul_assoc]
    rw [norm_mul, hQnorm x hx']
    calc
      ‖g' x‖ * (2 * lambda * x)⁻¹ ≤
          N * (2 * lambda * x)⁻¹ :=
        mul_le_mul_of_nonneg_right (hg'_bound x hx')
          (inv_nonneg.mpr (mul_pos (mul_pos (by norm_num) hlambda) (hpos x hx')).le)
      _ = (N / (2 * lambda)) * x⁻¹ := by
        field_simp [ne_of_gt htwolambda, hx0]
  have hg'integrable : IntervalIntegrable
      (fun t : Real => ‖g' t * (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹ *
        Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖)
      volume a b :=
    ((hg'cont.mul hQcont).mul hEcont).norm.intervalIntegrable
  have hinvcont : ContinuousOn (fun t : Real => t⁻¹) (Set.uIcc a b) := by
    refine ContinuousOn.inv₀ continuous_id.continuousOn ?_
    intro x hx
    exact ne_of_gt (hpos x hx)
  have hderiv_major_integrable : IntervalIntegrable
      (fun t : Real => (N / (2 * lambda)) * t⁻¹) volume a b :=
    (continuousOn_const.mul hinvcont).intervalIntegrable
  have hderivbound :
      ‖∫ t in a..b,
        g' t * (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        (N / (2 * lambda)) * Real.log (b / a) := by
    calc
      ‖∫ t in a..b,
        g' t * (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
          ∫ t in a..b,
            ‖g' t * (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹ *
              Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ :=
        intervalIntegral.norm_integral_le_integral_norm hab
      _ ≤ ∫ t in a..b, (N / (2 * lambda)) * t⁻¹ :=
        intervalIntegral.integral_mono_on hab hg'integrable hderiv_major_integrable hg'point
      _ = (N / (2 * lambda)) * Real.log (b / a) := by
        rw [intervalIntegral.integral_const_mul, integral_inv_of_pos ha hbpos]
  have hrempoint : ∀ x ∈ Set.Icc a b,
      ‖g x *
          (-(((2 * lambda : Real) : Complex) * Complex.I) /
            ((((2 * lambda * x : Real) : Complex) * Complex.I) ^ 2)) *
          Complex.exp (((lambda * x ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        (N / (2 * lambda)) * x⁻¹ := by
    intro x hx
    have hx' : x ∈ Set.uIcc a b := by
      simpa [Set.uIcc_of_le hab] using hx
    have hx0 : x ≠ 0 := ne_of_gt (hpos x hx')
    conv_lhs => rw [mul_assoc]
    rw [norm_mul, hQ'norm x hx']
    calc
      ‖g x‖ * ((2 * lambda)⁻¹ * (x ^ 2)⁻¹) ≤
          (N * x) * ((2 * lambda)⁻¹ * (x ^ 2)⁻¹) :=
        mul_le_mul_of_nonneg_right (hg_cone x hx)
          (mul_nonneg (inv_nonneg.mpr htwolambda.le) (inv_nonneg.mpr (sq_nonneg x)))
      _ = (N / (2 * lambda)) * x⁻¹ := by
        field_simp [ne_of_gt htwolambda, hx0]
  have hrem_integrable : IntervalIntegrable (fun t : Real =>
      ‖g t *
        (-(((2 * lambda : Real) : Complex) * Complex.I) /
          ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2)) *
          Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖)
      volume a b :=
    ((hgcont.mul hQ'cont).mul hEcont).norm.intervalIntegrable
  have hrembound :
      ‖∫ t in a..b,
        g t *
          (-(((2 * lambda : Real) : Complex) * Complex.I) /
            ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2)) *
            Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        (N / (2 * lambda)) * Real.log (b / a) := by
    calc
      ‖∫ t in a..b,
        g t *
          (-(((2 * lambda : Real) : Complex) * Complex.I) /
            ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2)) *
            Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
          ∫ t in a..b,
            ‖g t *
              (-(((2 * lambda : Real) : Complex) * Complex.I) /
                ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2)) *
                Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ :=
        intervalIntegral.norm_integral_le_integral_norm hab
      _ ≤ ∫ t in a..b, (N / (2 * lambda)) * t⁻¹ :=
        intervalIntegral.integral_mono_on hab hrem_integrable hderiv_major_integrable hrempoint
      _ = (N / (2 * lambda)) * Real.log (b / a) := by
        rw [intervalIntegral.integral_const_mul, integral_inv_of_pos ha hbpos]
  have hid := brrs_quadratic_phase_weighted_integration_by_parts
    ha hab hlambda.ne' g g' hg hg'cont
  rw [hid]
  calc
    ‖g b * (((2 * lambda * b : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * b ^ 2 : Real) : Complex) * Complex.I) -
        g a * (((2 * lambda * a : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * a ^ 2 : Real) : Complex) * Complex.I) -
        (∫ t in a..b,
          g' t * (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)) -
        ∫ t in a..b,
          g t *
            (-(((2 * lambda : Real) : Complex) * Complex.I) /
              ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2)) *
              Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        ‖g b * (((2 * lambda * b : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * b ^ 2 : Real) : Complex) * Complex.I)‖ +
        ‖g a * (((2 * lambda * a : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * a ^ 2 : Real) : Complex) * Complex.I)‖ +
        ‖∫ t in a..b,
          g' t * (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ +
        ‖∫ t in a..b,
          g t *
            (-(((2 * lambda : Real) : Complex) * Complex.I) /
              ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2)) *
              Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ := by
      calc
        _ ≤ ‖g b * (((2 * lambda * b : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * b ^ 2 : Real) : Complex) * Complex.I) -
          g a * (((2 * lambda * a : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((lambda * a ^ 2 : Real) : Complex) * Complex.I) -
          (∫ t in a..b,
            g' t * (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹ *
              Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I))‖ +
          ‖∫ t in a..b,
            g t *
              (-(((2 * lambda : Real) : Complex) * Complex.I) /
                ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2)) *
                Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ := norm_sub_le _ _
        _ ≤ (‖g b * (((2 * lambda * b : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * b ^ 2 : Real) : Complex) * Complex.I) -
          g a * (((2 * lambda * a : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((lambda * a ^ 2 : Real) : Complex) * Complex.I)‖ +
          ‖∫ t in a..b,
            g' t * (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹ *
              Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖) +
          ‖∫ t in a..b,
            g t *
              (-(((2 * lambda : Real) : Complex) * Complex.I) /
                ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2)) *
                Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ :=
          add_le_add_left (norm_sub_le _ _) _
        _ ≤ ((‖g b * (((2 * lambda * b : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * b ^ 2 : Real) : Complex) * Complex.I)‖ +
          ‖g a * (((2 * lambda * a : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((lambda * a ^ 2 : Real) : Complex) * Complex.I)‖) +
          ‖∫ t in a..b,
            g' t * (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹ *
              Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖) +
          ‖∫ t in a..b,
            g t *
              (-(((2 * lambda : Real) : Complex) * Complex.I) /
                ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2)) *
                Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ := by
          gcongr
          exact norm_sub_le _ _
        _ = _ := by ring
    _ ≤ N / (2 * lambda) + N / (2 * lambda) +
        (N / (2 * lambda)) * Real.log (b / a) +
        (N / (2 * lambda)) * Real.log (b / a) := by
      gcongr
    _ = (N / lambda) * (1 + Real.log (b / a)) := by
      field_simp [ne_of_gt hlambda]
      ring

/-- The derivative-form tail estimate above packages directly from a `C¹`
amplitude which vanishes at the stationary endpoint.  This is the form used
for `u ↦ h u - h 0`: the first-order endpoint condition is derived by the
mean-value theorem, while all nonstationary cancellation is supplied by the
preceding integration-by-parts lemma. -/
theorem brrs_quadratic_phase_weighted_tail_norm_le_of_contDiff_zero
    {a b lambda N : Real} (ha : 0 < a) (hab : a ≤ b) (hlambda : 0 < lambda)
    (g : Real → Complex) (hg_smooth : ContDiff Real 1 g) (hg_zero : g 0 = 0)
    (hderiv_bound : ∀ x ∈ Set.Icc 0 b, ‖deriv g x‖ ≤ N) :
    ‖∫ t in a..b, g t * Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
      (N / lambda) * (1 + Real.log (b / a)) := by
  have hdiff : Differentiable Real g := hg_smooth.differentiable (by norm_num)
  have hderiv_cont : Continuous (deriv g) :=
    hg_smooth.continuous_deriv (by norm_num)
  have hcone_full : ∀ x ∈ Set.Icc (0 : Real) b, ‖g x - g 0‖ ≤ N * (x - 0) := by
    apply norm_image_sub_le_of_norm_deriv_le_segment'
    · intro x hx
      exact (hdiff x).hasDerivAt.hasDerivWithinAt
    · intro x hx
      exact hderiv_bound x ⟨hx.1, hx.2.le⟩
  apply brrs_quadratic_phase_weighted_tail_norm_le_of_cone ha hab hlambda
    g (deriv g)
  · intro x hx
    exact (hdiff x).hasDerivAt
  · exact hderiv_cont.continuousOn
  · intro x hx
    have hcone := hcone_full x ⟨le_trans ha.le hx.1, hx.2⟩
    simpa [hg_zero] using hcone
  · intro x hx
    have hx' : x ∈ Set.Icc a b := by
      simpa [Set.uIcc_of_le hab] using hx
    exact hderiv_bound x ⟨le_trans ha.le hx'.1, hx'.2⟩

/-- The stationary core of an amplitude vanishing at zero is quadratically
small in the interval length.  Together with the weighted nonstationary tail
estimate, this gives a direct finite-scale control of the rescaled endpoint
error. -/
theorem brrs_quadratic_phase_small_interval_norm_le_of_contDiff_zero
    {b lambda N : Real} (hb : 0 ≤ b) (_hN : 0 ≤ N)
    (g : Real → Complex) (hg_smooth : ContDiff Real 1 g) (hg_zero : g 0 = 0)
    (hderiv_bound : ∀ x ∈ Set.Icc 0 b, ‖deriv g x‖ ≤ N) :
    ‖∫ t in (0 : Real)..b,
      g t * Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
      N * b ^ 2 / 2 := by
  have hdiff : Differentiable Real g := hg_smooth.differentiable (by norm_num)
  have hcone : ∀ x ∈ Set.Icc (0 : Real) b, ‖g x‖ ≤ N * x := by
    intro x hx
    have himage : ‖g x - g 0‖ ≤ N * (x - 0) := by
      exact norm_image_sub_le_of_norm_deriv_le_segment'
        (fun y hy => (hdiff y).hasDerivAt.hasDerivWithinAt)
        (fun y hy => hderiv_bound y ⟨hy.1, hy.2.le⟩) x hx
    simpa [hg_zero] using himage
  have hgcont : Continuous g := hg_smooth.continuous
  have hphasecont : Continuous (fun t : Real =>
      Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)) := by
    fun_prop
  have hintegrable : IntervalIntegrable (fun t : Real =>
      ‖g t * Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖)
      volume 0 b :=
    ((hgcont.mul hphasecont).norm).intervalIntegrable _ _
  have hmajor_integrable : IntervalIntegrable (fun t : Real => N * t) volume 0 b :=
    (continuous_const.mul continuous_id).intervalIntegrable _ _
  have hpoint : ∀ x ∈ Set.Icc (0 : Real) b,
      ‖g x * Complex.exp (((lambda * x ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        N * x := by
    intro x hx
    rw [norm_mul, Complex.norm_exp_ofReal_mul_I]
    simpa using hcone x hx
  calc
    ‖∫ t in (0 : Real)..b,
        g t * Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        ∫ t in (0 : Real)..b,
          ‖g t * Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ :=
      intervalIntegral.norm_integral_le_integral_norm hb
    _ ≤ ∫ t in (0 : Real)..b, N * t :=
      intervalIntegral.integral_mono_on hb hintegrable hmajor_integrable hpoint
    _ = N * b ^ 2 / 2 := by
      rw [intervalIntegral.integral_const_mul, integral_id]
      ring

/-- A finite rescaled endpoint-error estimate.  The amplitude vanishes at the
stationary endpoint, so the unit-scale core costs `M / (2c)` and the rest is
controlled by the quadratic nonstationary tail.  This is the quantitative
input needed to feed a compact smooth endpoint amplitude into the fixed
Fresnel carrier; it does not assert any kernel lower bound. -/
theorem brrs_rescaled_quadratic_phase_error_norm_le_of_contDiff_zero
    {c M : Real} (hc : 1 ≤ c)
    (g : Real → Complex) (hg_smooth : ContDiff Real 1 g) (hg_zero : g 0 = 0)
    (hderiv_bound : ∀ x ∈ Set.Icc 0 1, ‖deriv g x‖ ≤ M) :
    ‖∫ v in (0 : Real)..c,
      g (v / c) * Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I)‖ ≤
      (M / c) * (3 / 2 + Real.log c) := by
  have hcpos : 0 < c := lt_of_lt_of_le zero_lt_one hc
  have hM : 0 ≤ M := by
    exact (norm_nonneg (deriv g 0)).trans
      (hderiv_bound 0 ⟨le_rfl, zero_le_one⟩)
  let G : Real → Complex := fun v => g (v / c)
  have hG_smooth : ContDiff Real 1 G := by
    dsimp [G]
    exact hg_smooth.comp (contDiff_id.div_const c)
  have hG_zero : G 0 = 0 := by
    simp [G, hg_zero]
  have hdiff : Differentiable Real g := hg_smooth.differentiable (by norm_num)
  have hderiv_G : ∀ v : Real, deriv G v = (1 / c : Real) • deriv g (v / c) := by
    intro v
    have hscale : HasDerivAt (fun w : Real => w / c) (1 / c : Real) v := by
      simpa using (hasDerivAt_id v).div_const c
    have hchain : HasDerivAt (fun w : Real => g (w / c))
        ((1 / c : Real) • deriv g (v / c)) v := by
      change HasDerivAt (g ∘ fun w : Real => w / c)
        ((1 / c : Real) • deriv g (v / c)) v
      exact HasDerivAt.scomp v ((hdiff (v / c)).hasDerivAt) hscale
    exact hchain.deriv
  have hderiv_G_bound : ∀ v ∈ Set.Icc (0 : Real) c, ‖deriv G v‖ ≤ M / c := by
    intro v hv
    have hvdiv : v / c ∈ Set.Icc (0 : Real) 1 := by
      constructor
      · exact div_nonneg hv.1 hcpos.le
      · exact (div_le_iff₀ hcpos).mpr (by simpa using hv.2)
    rw [hderiv_G v, norm_smul, Real.norm_eq_abs,
      abs_of_pos (one_div_pos.mpr hcpos)]
    calc
      (1 / c) * ‖deriv g (v / c)‖ ≤ (1 / c) * M :=
        mul_le_mul_of_nonneg_left (hderiv_bound _ hvdiv)
          (one_div_nonneg.mpr hcpos.le)
      _ = M / c := by ring
  have hN : 0 ≤ M / c := div_nonneg hM hcpos.le
  have hcore := brrs_quadratic_phase_small_interval_norm_le_of_contDiff_zero
    (b := 1) (lambda := 1) (N := M / c) (by norm_num) hN G hG_smooth hG_zero
    (fun v hv => hderiv_G_bound v ⟨hv.1, le_trans hv.2 hc⟩)
  have htail := brrs_quadratic_phase_weighted_tail_norm_le_of_contDiff_zero
    (a := 1) (b := c) (lambda := 1) zero_lt_one hc (by norm_num)
    G hG_smooth hG_zero hderiv_G_bound
  have hcore' : ‖∫ v in (0 : Real)..1,
      G v * Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I)‖ ≤ M / c / 2 := by
    simpa using hcore
  have htail' : ‖∫ v in (1 : Real)..c,
      G v * Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I)‖ ≤
      (M / c) * (1 + Real.log c) := by
    simpa using htail
  have hGcont : Continuous G := hG_smooth.continuous
  have hsplit :
      (∫ v in (0 : Real)..1,
        G v * Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I)) +
        ∫ v in (1 : Real)..c,
          G v * Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I) =
        ∫ v in (0 : Real)..c,
          G v * Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I) :=
    intervalIntegral.integral_add_adjacent_intervals
      ((hGcont.mul (by fun_prop)).intervalIntegrable 0 1)
      ((hGcont.mul (by fun_prop)).intervalIntegrable 1 c)
  change ‖∫ v in (0 : Real)..c,
      G v * Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I)‖ ≤ _
  rw [← hsplit]
  calc
    ‖(∫ v in (0 : Real)..1,
        G v * Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I)) +
        ∫ v in (1 : Real)..c,
          G v * Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        ‖∫ v in (0 : Real)..1,
          G v * Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I)‖ +
          ‖∫ v in (1 : Real)..c,
            G v * Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I)‖ :=
      norm_add_le _ _
    _ ≤ M / c / 2 + (M / c) * (1 + Real.log c) :=
      add_le_add hcore' htail'
    _ = (M / c) * (3 / 2 + Real.log c) := by ring

/-- A smooth order-zero endpoint has the exact Fresnel leading carrier after
the natural square-root normalization.  The proof combines the finite
rescaled-error estimate with the Abel evaluation of the carrier; it is the
even-dimensional stationary-endpoint input needed before assembling a
two-wave Bessel expansion. -/
theorem brrsEvenQuadraticBaseNormalized_tendsto_fresnel
    (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h) :
    Tendsto (brrsEvenQuadraticBaseNormalized h) atTop
      (nhds (h 0 * brrsQuadraticFresnelLimit)) := by
  let g : Real -> Complex := fun u => h u - h 0
  have hg : ContDiff Real (⊤ : ℕ∞) g := by
    dsimp only [g]
    exact hh.sub contDiff_const
  have hgzero : g 0 = 0 := by
    simp only [g, sub_self]
  have hg_one : ContDiff Real 1 g := hg.of_le (by norm_num)
  obtain ⟨M, hMpos, hMbound⟩ :=
    exists_pos_norm_le_on_unit_of_contDiff (deriv g)
      ((contDiff_infty_iff_deriv.mp hg).2)
  have hbase : Tendsto
      (fun c : Real => ((3 / 2 : Real) + Real.log c) / c) atTop (nhds 0) := by
    have hconst : (fun _ : Real => (3 / 2 : Real)) =o[atTop] id :=
      (Real.isLittleO_const_log_atTop (c := (3 / 2 : Real))).trans
        Real.isLittleO_log_id_atTop
    have hsmall : (fun c : Real => (3 / 2 : Real) + Real.log c) =o[atTop] id :=
      hconst.add Real.isLittleO_log_id_atTop
    simpa only [id] using hsmall.tendsto_div_nhds_zero
  have hbound_tendsto : Tendsto
      (fun c : Real => (M / c) * ((3 / 2 : Real) + Real.log c)) atTop (nhds 0) := by
    have hmul : Tendsto
        (fun c : Real => M * (((3 / 2 : Real) + Real.log c) / c))
          atTop (nhds (M * 0)) :=
      (tendsto_const_nhds : Tendsto (fun _ : Real => M) atTop (nhds M)).mul hbase
    have hmul_zero : Tendsto
        (fun c : Real => M * (((3 / 2 : Real) + Real.log c) / c))
          atTop (nhds 0) := by
      simpa only [mul_zero] using hmul
    convert hmul_zero using 1; ext c; ring
  let E : Real -> Complex := fun lambda =>
    intervalIntegral
      (fun v => (h (v / Real.sqrt lambda) - h 0) *
        Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I))
      0 (Real.sqrt lambda) volume
  have hEbound : ∀ᶠ lambda : Real in atTop,
      ‖E lambda‖ ≤ (M / Real.sqrt lambda) *
        ((3 / 2 : Real) + Real.log (Real.sqrt lambda)) := by
    filter_upwards [eventually_ge_atTop (1 : Real)] with lambda hlambda
    have hsqrt : (1 : Real) ≤ Real.sqrt lambda := Real.one_le_sqrt.mpr hlambda
    dsimp [E]
    simpa only [g] using
      (brrs_rescaled_quadratic_phase_error_norm_le_of_contDiff_zero
        (c := Real.sqrt lambda) (M := M) hsqrt g hg_one hgzero hMbound)
  have hE_tendsto : Tendsto E atTop (nhds 0) := by
    apply squeeze_zero_norm' hEbound
    exact hbound_tendsto.comp Real.tendsto_sqrt_atTop
  have hF_tendsto : Tendsto
      (fun lambda : Real =>
        brrsNormalizedQuadraticFresnelIntegral (Real.sqrt lambda)) atTop
      (nhds brrsQuadraticFresnelLimit) :=
    brrsNormalizedQuadraticFresnelIntegral_tendsto_limit.comp Real.tendsto_sqrt_atTop
  have hcore_tendsto : Tendsto (fun lambda : Real =>
      h 0 * brrsNormalizedQuadraticFresnelIntegral (Real.sqrt lambda)) atTop
      (nhds (h 0 * brrsQuadraticFresnelLimit)) := by
    exact (tendsto_const_nhds : Tendsto (fun _ : Real => h 0) atTop (nhds (h 0))).mul hF_tendsto
  have hsum_tendsto : Tendsto (fun lambda : Real =>
      h 0 * brrsNormalizedQuadraticFresnelIntegral (Real.sqrt lambda) + E lambda) atTop
      (nhds (h 0 * brrsQuadraticFresnelLimit)) := by
    simpa using hcore_tendsto.add hE_tendsto
  refine Tendsto.congr' ?_ hsum_tendsto
  filter_upwards [eventually_gt_atTop (0 : Real)] with lambda hlambda
  dsimp [E]
  exact (brrsEvenQuadraticBaseNormalized_eq_fresnel_add_rescaledError
    h hh.continuous hlambda).symm

/-- The canonical carrier used by the existing even endpoint machinery is
therefore the explicit Fresnel value multiplied by the endpoint amplitude. -/
theorem brrsEvenQuadraticBaseCarrier_eq_fresnel
    (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h) :
    brrsEvenQuadraticBaseCarrier h = h 0 * brrsQuadraticFresnelLimit := by
  unfold brrsEvenQuadraticBaseCarrier
  exact (brrsEvenQuadraticBaseNormalized_tendsto_fresnel h hh).limUnder_eq

/-- The explicit Fresnel carrier is nonzero. -/
theorem brrs_quadraticFresnelLimit_ne_zero : brrsQuadraticFresnelLimit ≠ 0 := by
  rw [brrsQuadraticFresnelLimit_eq_explicit]
  have hsqrt : (0 : Real) < Real.sqrt (Real.pi / 2) :=
    Real.sqrt_pos.mpr (by positivity)
  have h1 : ((Real.sqrt (Real.pi / 2) : Real) : Complex) ≠ 0 := by
    simpa using ne_of_gt hsqrt
  have h2 : (1 + Complex.I) ≠ 0 := by
    intro h
    have himag : (1 + Complex.I).im = 0 := by rw [h]; simp
    simp at himag
  exact div_ne_zero (mul_ne_zero h1 h2) (by norm_num)

/-- The even stationary carrier of the smooth endpoint profile is nonzero.
This is the nonvanishing of the leading coefficient in the two-wave
asymptotic. -/
theorem brrs_evenQuadraticBaseCarrier_smoothEndpointProfile_ne_zero (m : Nat) :
    brrsEvenQuadraticBaseCarrier (smoothEndpointProfile m) ≠ 0 := by
  rw [brrsEvenQuadraticBaseCarrier_eq_fresnel _ (contDiff_smoothEndpointProfile m)]
  exact mul_ne_zero (brrs_smoothEndpointProfile_zero_ne_zero m)
    brrs_quadraticFresnelLimit_ne_zero

/-- The even stationary carrier of the planar endpoint profile is nonzero. -/
theorem brrs_evenQuadraticBaseCarrier_planarEndpointProfile_ne_zero :
    brrsEvenQuadraticBaseCarrier planarEndpointProfile ≠ 0 := by
  rw [brrsEvenQuadraticBaseCarrier_eq_fresnel _ contDiff_planarEndpointProfile]
  exact mul_ne_zero brrs_planarEndpointProfile_zero_ne_zero
    brrs_quadraticFresnelLimit_ne_zero

/-- The fixed finite Fresnel carrier gives the order-zero stationary lower
bound for every genuinely smooth compact endpoint profile with a nonzero
value at the stationary point.  The error is made explicit: subtract the
constant endpoint value, control its derivative on the unit interval, and use
the proved rescaled nonstationary estimate.  Thus this is an unconditional
analytic result, rather than a new stationary-phase hypothesis. -/
theorem exists_quadraticMoment_zero_eventually_lower_of_contDiff
    (h : Real → Complex) (hh : ContDiff Real (⊤ : ℕ∞) h) (hzero : h 0 ≠ 0) :
    ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ lambda : Real, L ≤ lambda →
      c / Real.sqrt lambda ≤ ‖quadraticMomentIntegral 0 h lambda‖ := by
  let g : Real → Complex := fun u => h u - h 0
  have hg : ContDiff Real (⊤ : ℕ∞) g := by
    dsimp only [g]
    exact hh.sub contDiff_const
  have hgzero : g 0 = 0 := by
    simp only [g, sub_self]
  have hg_one : ContDiff Real 1 g := hg.of_le (by norm_num)
  obtain ⟨M, hMpos, hMbound⟩ :=
    exists_pos_norm_le_on_unit_of_contDiff (deriv g)
      ((contDiff_infty_iff_deriv.mp hg).2)
  let a : Real := ‖h 0‖
  have ha : 0 < a := by
    dsimp only [a]
    exact norm_pos_iff.mpr hzero
  have ha128 : 0 < a / 128 := div_pos ha (by norm_num)
  have hbase : Tendsto
      (fun c : Real => ((3 / 2 : Real) + Real.log c) / c) atTop (nhds 0) := by
    have hconst : (fun _ : Real => (3 / 2 : Real)) =o[atTop] id :=
      (Real.isLittleO_const_log_atTop (c := (3 / 2 : Real))).trans
        Real.isLittleO_log_id_atTop
    have hsmall : (fun c : Real => (3 / 2 : Real) + Real.log c) =o[atTop] id :=
      hconst.add Real.isLittleO_log_id_atTop
    simpa only [id] using hsmall.tendsto_div_nhds_zero
  have hlimit : Tendsto
      (fun c : Real => (M / c) * ((3 / 2 : Real) + Real.log c)) atTop (nhds 0) := by
    have hmul : Tendsto
        (fun c : Real => M * (((3 / 2 : Real) + Real.log c) / c))
          atTop (nhds (M * 0)) :=
      (tendsto_const_nhds : Tendsto (fun _ : Real => M) atTop (nhds M)).mul hbase
    have hmul_zero : Tendsto
        (fun c : Real => M * (((3 / 2 : Real) + Real.log c) / c))
          atTop (nhds 0) := by
      simpa only [mul_zero] using hmul
    convert hmul_zero using 1; ext c; ring
  have hevent : Filter.Eventually (fun c : Real =>
      (M / c) * ((3 / 2 : Real) + Real.log c) ≤ a / 128) atTop := by
    filter_upwards [hlimit.eventually (eventually_lt_nhds ha128)]
      with c hc
    exact hc.le
  obtain ⟨C, hC⟩ := eventually_atTop.mp hevent
  let B : Real := max 64 C
  have hB64 : (64 : Real) ≤ B := by
    dsimp only [B]
    exact le_max_left _ _
  have hBC : C ≤ B := by
    dsimp only [B]
    exact le_max_right _ _
  have hBpos : 0 < B := by linarith
  refine ⟨B ^ 2, a / 128, ?_, div_pos ha (by norm_num), ?_⟩
  · nlinarith
  · intro lambda hlambda
    have hlambda_pos : 0 < lambda := by
      have hBsq_pos : 0 < B ^ 2 := pow_pos hBpos _
      exact lt_of_lt_of_le hBsq_pos hlambda
    have hlambda_large : (4096 : Real) ≤ lambda := by
      nlinarith [hB64]
    have hsqrt_B : B ≤ Real.sqrt lambda := by
      have hBnonneg : 0 ≤ B := hBpos.le
      calc
        B = Real.sqrt (B ^ 2) := by
          rw [Real.sqrt_sq_eq_abs, abs_of_nonneg hBnonneg]
        _ ≤ Real.sqrt lambda := Real.sqrt_le_sqrt hlambda
    have hB_one : (1 : Real) ≤ B := by
      linarith [hB64]
    have hsqrt_one : (1 : Real) ≤ Real.sqrt lambda :=
      le_trans hB_one hsqrt_B
    have hbudget : (M / Real.sqrt lambda) *
        ((3 / 2 : Real) + Real.log (Real.sqrt lambda)) ≤ a / 128 :=
      hC _ (le_trans hBC hsqrt_B)
    have hrescaled := brrs_rescaled_quadratic_phase_error_norm_le_of_contDiff_zero
      (c := Real.sqrt lambda) (M := M) hsqrt_one g hg_one hgzero hMbound
    have herror : ‖intervalIntegral
        (fun v => (h (v / Real.sqrt lambda) - h 0) *
          Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I))
        0 (Real.sqrt lambda) volume‖ ≤ a / 128 := by
      simpa only [g] using hrescaled.trans hbudget
    have hmain := quadraticMomentIntegral_zero_norm_lower_of_rescaledError_le
      h hh.continuous hzero hlambda_large herror
    simpa only [a] using hmain

/-- A quantified recurrence step for even quadratic stationary moments.

It isolates the only missing analytic input for the even-dimensional and
planar BRRS lower bound: a sharp lower estimate at the order-zero Fresnel
moment.  Once that base estimate is supplied, the exact recurrence below
propagates it through every even order without any additional stationary
analysis. -/
theorem exists_quadraticMoment_even_eventually_lower_step
    (n : Nat) (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) {L c : Real}
    (hL : 1 ≤ L) (hc : 0 < c)
    (hlower : ∀ lambda : Real, L ≤ lambda →
      c / (lambda ^ n * Real.sqrt lambda) ≤
        ‖quadraticMomentIntegral (2 * n) h lambda‖) :
    ∃ L' c' : Real, 1 ≤ L' ∧ 0 < c' ∧ ∀ lambda : Real, L' ≤ lambda →
      c' / (lambda ^ (n + 1) * Real.sqrt lambda) ≤
        ‖quadraticMomentIntegral (2 * n + 2) h lambda‖ := by
  obtain ⟨C, hC, hCbound⟩ :=
    exists_quadraticMoment_decay (2 * n + 1) (deriv h)
      ((contDiff_infty_iff_deriv.mp hh).2) (VanishesNearOne.deriv h hvanish)
  let B : Real := 2 * C / c
  have hB : 0 ≤ B := by
    dsimp [B]
    positivity
  refine ⟨max L (max 1 (B ^ 2)), c / 4, ?_, by positivity, ?_⟩
  · exact le_trans hL (le_max_left _ _)
  intro lambda hlambda
  have hlambda_L : L ≤ lambda :=
    le_trans (le_max_left _ _) hlambda
  have hlambda_one : 1 ≤ lambda := by
    exact le_trans (le_max_left _ _)
      (le_trans (le_max_right _ _) hlambda)
  have hlambda_pos : 0 < lambda :=
    lt_of_lt_of_le zero_lt_one hlambda_one
  have hsqrt_pos : 0 < Real.sqrt lambda := Real.sqrt_pos.2 hlambda_pos
  have hBsq : B ^ 2 ≤ lambda := by
    exact le_trans (le_max_right _ _)
      (le_trans (le_max_right _ _) hlambda)
  have hsqrt_sq : Real.sqrt lambda ^ 2 = lambda :=
    Real.sq_sqrt hlambda_pos.le
  have hB_le_sqrt : B ≤ Real.sqrt lambda := by
    nlinarith
  have hCmul : 2 * C ≤ Real.sqrt lambda * c := by
    dsimp [B] at hB_le_sqrt
    exact (div_le_iff₀ hc).mp hB_le_sqrt
  have hCsqrt : C / Real.sqrt lambda ≤ c / 2 := by
    rw [div_le_iff₀ hsqrt_pos]
    nlinarith
  have hden_pos : 0 < lambda ^ n * Real.sqrt lambda :=
    mul_pos (pow_pos hlambda_pos _) hsqrt_pos
  let A : Complex := quadraticMomentIntegral (2 * n) h lambda
  let R : Complex := quadraticMomentIntegral (2 * n + 1) (deriv h) lambda
  have hA : c / (lambda ^ n * Real.sqrt lambda) ≤ ‖A‖ := by
    exact hlower lambda hlambda_L
  have hRraw : ‖R‖ ≤ C / quadraticMomentScale (2 * n + 1) lambda := by
    dsimp [R]
    exact hCbound lambda hlambda_one
  have hscale := brrs_quadraticMomentScale_odd n hlambda_pos.le
  have hR : ‖R‖ ≤ (c / 2) / (lambda ^ n * Real.sqrt lambda) := by
    calc
      ‖R‖ ≤ C / quadraticMomentScale (2 * n + 1) lambda := hRraw
      _ = C / lambda ^ (n + 1) := by rw [hscale]
      _ = (C / Real.sqrt lambda) / (lambda ^ n * Real.sqrt lambda) := by
        rw [show n + 1 = n + 1 by rfl, pow_succ]
        field_simp [ne_of_gt hsqrt_pos, ne_of_gt hden_pos, ne_of_gt hlambda_pos,
          hsqrt_sq]
        exact hsqrt_sq
      _ ≤ (c / 2) / (lambda ^ n * Real.sqrt lambda) :=
        div_le_div_of_nonneg_right hCsqrt hden_pos.le
  have hcoeff_one : (1 : Real) ≤ ((2 * n + 1 : Nat) : Real) := by
    have hcoeff_nat : 1 ≤ 2 * n + 1 := by omega
    exact_mod_cast hcoeff_nat
  have hcoeff_nonneg : (0 : Real) ≤ ((2 * n + 1 : Nat) : Real) :=
    Nat.cast_nonneg _
  have hbase_nonneg : 0 ≤ c / (lambda ^ n * Real.sqrt lambda) :=
    (div_pos hc hden_pos).le
  have hcoeff_norm :
      ‖((2 * n + 1 : Nat) : Complex) * A‖ =
        ((2 * n + 1 : Nat) : Real) * ‖A‖ := by
    rw [norm_mul, norm_natCast]
  have hcoeff_lower : c / (lambda ^ n * Real.sqrt lambda) ≤
      ‖((2 * n + 1 : Nat) : Complex) * A‖ := by
    calc
      c / (lambda ^ n * Real.sqrt lambda) ≤
          ((2 * n + 1 : Nat) : Real) *
            (c / (lambda ^ n * Real.sqrt lambda)) := by
        simpa only [one_mul] using
          (mul_le_mul_of_nonneg_right hcoeff_one hbase_nonneg)
      _ ≤ ((2 * n + 1 : Nat) : Real) * ‖A‖ :=
        mul_le_mul_of_nonneg_left hA hcoeff_nonneg
      _ = ‖((2 * n + 1 : Nat) : Complex) * A‖ := hcoeff_norm.symm
  have htriangle : ‖((2 * n + 1 : Nat) : Complex) * A‖ ≤
      ‖((2 * n + 1 : Nat) : Complex) * A + R‖ + ‖R‖ := by
    calc
      ‖((2 * n + 1 : Nat) : Complex) * A‖ =
          ‖(((2 * n + 1 : Nat) : Complex) * A + R) - R‖ := by ring_nf
      _ ≤ ‖((2 * n + 1 : Nat) : Complex) * A + R‖ + ‖R‖ :=
        norm_sub_le _ _
  have hsum : (c / 2) / (lambda ^ n * Real.sqrt lambda) ≤
      ‖((2 * n + 1 : Nat) : Complex) * A + R‖ := by
    have hhalf : (c / 2) / (lambda ^ n * Real.sqrt lambda) =
        (c / (lambda ^ n * Real.sqrt lambda)) / 2 := by ring
    rw [hhalf]
    linarith
  have hrec := quadraticMomentIntegral_succ_two_recurrence (2 * n) h hh hvanish
    (ne_of_gt hlambda_pos)
  have hqnorm : ‖((2 * lambda : Real) : Complex) * Complex.I‖ = 2 * lambda := by
    have htwo : 0 ≤ 2 * lambda := by nlinarith
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, Complex.norm_I,
      abs_of_nonneg htwo]
    simp
  have hscalar : ‖-((((2 * lambda : Real) : Complex) * Complex.I)⁻¹)‖ =
      1 / (2 * lambda) := by
    rw [norm_neg, norm_inv, hqnorm]
    simp
  change c / 4 / (lambda ^ (n + 1) * Real.sqrt lambda) ≤ _
  rw [hrec, norm_mul, hscalar]
  change c / 4 / (lambda ^ (n + 1) * Real.sqrt lambda) ≤
    (1 / (2 * lambda)) *
      ‖((2 * n + 1 : Nat) : Complex) * A + R‖
  calc
    c / 4 / (lambda ^ (n + 1) * Real.sqrt lambda) =
        (1 / (2 * lambda)) *
          ((c / 2) / (lambda ^ n * Real.sqrt lambda)) := by
      rw [pow_succ]
      field_simp [ne_of_gt hlambda_pos, ne_of_gt hsqrt_pos]; norm_num
    _ ≤ (1 / (2 * lambda)) *
        ‖((2 * n + 1 : Nat) : Complex) * A + R‖ :=
      mul_le_mul_of_nonneg_left hsum (by positivity)

/-- Reduction of all even quadratic stationary lower bounds to the single
order-zero Fresnel lower bound for the same endpoint profile.  This is a
proved recurrence theorem, not an assumed stationary estimate. -/
theorem exists_quadraticMoment_even_eventually_lower_of_zero_lower
    (n : Nat) (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h)
    (hzero : ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ lambda : Real, L ≤ lambda →
      c / Real.sqrt lambda ≤ ‖quadraticMomentIntegral 0 h lambda‖) :
    ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ lambda : Real, L ≤ lambda →
      c / (lambda ^ n * Real.sqrt lambda) ≤
        ‖quadraticMomentIntegral (2 * n) h lambda‖ := by
  induction n with
  | zero =>
      obtain ⟨L, c, hL, hc, hbound⟩ := hzero
      refine ⟨L, c, hL, hc, ?_⟩
      intro lambda hlambda
      simpa using hbound lambda hlambda
  | succ n ih =>
      obtain ⟨L, c, hL, hc, hbound⟩ := ih
      obtain ⟨L', c', hL', hc', hstep⟩ :=
        exists_quadraticMoment_even_eventually_lower_step n h hh hvanish hL hc hbound
      refine ⟨L', c', hL', hc', ?_⟩
      intro lambda hlambda
      have hmoment : 2 * (n + 1) = 2 * n + 2 := by omega
      rw [hmoment]
      exact hstep lambda hlambda

/-- For a concrete even BRRS endpoint profile, the sole remaining analytic
input is its order-zero compact Fresnel lower bound.  The conclusion then
follows in every even stationary order by the proved recurrence. -/
theorem exists_smoothEndpointQuadraticIntegral_even_eventually_lower_of_zero_lower
    (n : Nat)
    (hzero : ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ lambda : Real, L ≤ lambda →
      c / Real.sqrt lambda ≤
        ‖quadraticMomentIntegral 0 (smoothEndpointProfile (2 * n)) lambda‖) :
    ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ lambda : Real, L ≤ lambda →
      c / (lambda ^ n * Real.sqrt lambda) ≤
        ‖smoothEndpointQuadraticIntegral (2 * n) lambda‖ := by
  obtain ⟨L, c, hL, hc, hbound⟩ :=
    exists_quadraticMoment_even_eventually_lower_of_zero_lower n
      (smoothEndpointProfile (2 * n))
      (contDiff_smoothEndpointProfile (2 * n))
      (smoothEndpointProfile_eventuallyEq_zero_at_one (2 * n)) hzero
  refine ⟨L, c, hL, hc, ?_⟩
  intro lambda hlambda
  rw [smoothEndpointQuadraticIntegral_eq_quadraticMomentIntegral]
  exact hbound lambda hlambda

/-- One quantified recurrence step for sharp lower bounds at odd quadratic
stationary orders.  A lower bound at order `2 n + 1` propagates to order
`(2 n + 1) + 2`: the exact recurrence makes the old moment the leading
term, while the next even derivative moment is smaller by one square root.

This is deliberately stated for an arbitrary smooth compact endpoint
amplitude, rather than just the BRRS symbol, so it can be iterated without
reproving stationary phase. -/
theorem exists_quadraticMoment_odd_eventually_lower_step
    (n : Nat) (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) {L c : Real}
    (hL : 1 ≤ L) (hc : 0 < c)
    (hlower : ∀ lambda : Real, L ≤ lambda →
      c / lambda ^ (n + 1) ≤ ‖quadraticMomentIntegral (2 * n + 1) h lambda‖) :
    ∃ L' c' : Real, 1 ≤ L' ∧ 0 < c' ∧ ∀ lambda : Real, L' ≤ lambda →
      c' / lambda ^ (n + 2) ≤
        ‖quadraticMomentIntegral ((2 * n + 1) + 2) h lambda‖ := by
  obtain ⟨C, hC, hCbound⟩ :=
    exists_quadraticMoment_decay (2 * n + 2) (deriv h)
      ((contDiff_infty_iff_deriv.mp hh).2) (VanishesNearOne.deriv h hvanish)
  let B : Real := C / c
  have hB : 0 ≤ B := by
    dsimp [B]
    positivity
  refine ⟨max L (max 1 (B ^ 2)), c / 2, ?_, by positivity, ?_⟩
  · exact le_trans hL (le_max_left _ _)
  intro lambda hlambda
  have hlambda_L : L ≤ lambda :=
    le_trans (le_max_left _ _) hlambda
  have hlambda_one : 1 ≤ lambda := by
    exact le_trans (le_max_left _ _)
      (le_trans (le_max_right _ _) hlambda)
  have hlambda_pos : 0 < lambda :=
    lt_of_lt_of_le zero_lt_one hlambda_one
  have hsqrt_pos : 0 < Real.sqrt lambda := Real.sqrt_pos.2 hlambda_pos
  have hBsq : B ^ 2 ≤ lambda := by
    exact le_trans (le_max_right _ _)
      (le_trans (le_max_right _ _) hlambda)
  have hsqrt_sq : Real.sqrt lambda ^ 2 = lambda :=
    Real.sq_sqrt hlambda_pos.le
  have hB_le_sqrt : B ≤ Real.sqrt lambda := by
    nlinarith
  have hCmul : C ≤ Real.sqrt lambda * c := by
    dsimp [B] at hB_le_sqrt
    exact (div_le_iff₀ hc).mp hB_le_sqrt
  have hCsqrt : C / Real.sqrt lambda ≤ c := by
    rw [div_le_iff₀ hsqrt_pos]
    nlinarith
  have hpow_pos : 0 < lambda ^ (n + 1) := pow_pos hlambda_pos _
  have hindex : (2 * n + 1) + 1 = 2 * n + 2 := by omega
  let A : Complex := quadraticMomentIntegral (2 * n + 1) h lambda
  let R : Complex := quadraticMomentIntegral ((2 * n + 1) + 1) (deriv h) lambda
  have hA : c / lambda ^ (n + 1) ≤ ‖A‖ := by
    exact hlower lambda hlambda_L
  have hRraw : ‖R‖ ≤ C / quadraticMomentScale (2 * n + 2) lambda := by
    dsimp [R]
    rw [hindex]
    exact hCbound lambda hlambda_one
  have hscale := brrs_quadraticMomentScale_even_remainder n hlambda_pos.le
  have hR : ‖R‖ ≤ c / lambda ^ (n + 1) := by
    calc
      ‖R‖ ≤ C / quadraticMomentScale (2 * n + 2) lambda := hRraw
      _ = C / (lambda ^ (n + 1) * Real.sqrt lambda) := by rw [hscale]
      _ = (C / Real.sqrt lambda) / lambda ^ (n + 1) := by
        field_simp [ne_of_gt hsqrt_pos, ne_of_gt hpow_pos]
      _ ≤ c / lambda ^ (n + 1) :=
        div_le_div_of_nonneg_right hCsqrt hpow_pos.le
  have hcoeff_two : (2 : Real) ≤ ((2 * n + 1 + 1 : Nat) : Real) := by
    have hcoeff_nat : 2 ≤ 2 * n + 1 + 1 := by omega
    exact_mod_cast hcoeff_nat
  have hcoeff_nonneg : (0 : Real) ≤ ((2 * n + 1 + 1 : Nat) : Real) :=
    Nat.cast_nonneg _
  have hbase_nonneg : 0 ≤ c / lambda ^ (n + 1) :=
    (div_pos hc hpow_pos).le
  have hcoeff_norm :
      ‖((2 * n + 1 + 1 : Nat) : Complex) * A‖ =
        ((2 * n + 1 + 1 : Nat) : Real) * ‖A‖ := by
    rw [norm_mul, norm_natCast]
  have hcoeff_lower : 2 * (c / lambda ^ (n + 1)) ≤
      ‖((2 * n + 1 + 1 : Nat) : Complex) * A‖ := by
    calc
      2 * (c / lambda ^ (n + 1)) ≤
          ((2 * n + 1 + 1 : Nat) : Real) * (c / lambda ^ (n + 1)) :=
        mul_le_mul_of_nonneg_right hcoeff_two hbase_nonneg
      _ ≤ ((2 * n + 1 + 1 : Nat) : Real) * ‖A‖ :=
        mul_le_mul_of_nonneg_left hA hcoeff_nonneg
      _ = ‖((2 * n + 1 + 1 : Nat) : Complex) * A‖ := hcoeff_norm.symm
  have htriangle : ‖((2 * n + 1 + 1 : Nat) : Complex) * A‖ ≤
      ‖((2 * n + 1 + 1 : Nat) : Complex) * A + R‖ + ‖R‖ := by
    calc
      ‖((2 * n + 1 + 1 : Nat) : Complex) * A‖ =
          ‖(((2 * n + 1 + 1 : Nat) : Complex) * A + R) - R‖ := by ring_nf
      _ ≤ ‖((2 * n + 1 + 1 : Nat) : Complex) * A + R‖ + ‖R‖ :=
        norm_sub_le _ _
  have hsum : c / lambda ^ (n + 1) ≤
      ‖((2 * n + 1 + 1 : Nat) : Complex) * A + R‖ := by
    linarith
  have hrec := quadraticMomentIntegral_succ_two_recurrence (2 * n + 1) h hh hvanish
    (ne_of_gt hlambda_pos)
  have hqnorm : ‖((2 * lambda : Real) : Complex) * Complex.I‖ = 2 * lambda := by
    have htwo : 0 ≤ 2 * lambda := by nlinarith
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, Complex.norm_I,
      abs_of_nonneg htwo]
    simp
  have hscalar : ‖-((((2 * lambda : Real) : Complex) * Complex.I)⁻¹)‖ =
      1 / (2 * lambda) := by
    rw [norm_neg, norm_inv, hqnorm]
    simp
  change c / 2 / lambda ^ (n + 2) ≤ _
  rw [hrec, norm_mul, hscalar]
  change c / 2 / lambda ^ (n + 2) ≤
    (1 / (2 * lambda)) *
      ‖((2 * n + 1 + 1 : Nat) : Complex) * A + R‖
  calc
    c / 2 / lambda ^ (n + 2) =
        (1 / (2 * lambda)) * (c / lambda ^ (n + 1)) := by
      rw [show n + 2 = (n + 1) + 1 by omega, pow_succ]
      field_simp [ne_of_gt hlambda_pos]
    _ ≤ (1 / (2 * lambda)) *
        ‖((2 * n + 1 + 1 : Nat) : Complex) * A + R‖ :=
      mul_le_mul_of_nonneg_left hsum (by positivity)

/-- Every odd quadratic stationary moment with a nonzero endpoint
coefficient has its sharp eventual lower size.  This is obtained by
iterating `exists_quadraticMoment_odd_eventually_lower_step` from the exact
first-moment boundary formula. -/
theorem exists_quadraticMoment_odd_eventually_lower_of_ne_zero
    (n : Nat) (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) (hzero : h 0 ≠ 0) :
    ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ lambda : Real, L ≤ lambda →
      c / lambda ^ (n + 1) ≤ ‖quadraticMomentIntegral (2 * n + 1) h lambda‖ := by
  induction n with
  | zero =>
      obtain ⟨L, c, hL, hc, hbound⟩ :=
        exists_quadraticMoment_one_eventually_lower_of_ne_zero h hh hvanish hzero
      refine ⟨L, c, hL, hc, ?_⟩
      intro lambda hlambda
      simpa using hbound lambda hlambda
  | succ n ih =>
      obtain ⟨L, c, hL, hc, hbound⟩ := ih
      obtain ⟨L', c', hL', hc', hbound'⟩ :=
        exists_quadraticMoment_odd_eventually_lower_step n h hh hvanish hL hc hbound
      refine ⟨L', c', hL', hc', ?_⟩
      intro lambda hlambda
      have hstep := hbound' lambda hlambda
      have hexponent : Nat.succ n + 1 = n + 2 := by omega
      have hmoment : 2 * Nat.succ n + 1 = (2 * n + 1) + 2 := by omega
      rw [hexponent, hmoment]
      exact hstep

/-- The concrete nonplanar BRRS endpoint integrals therefore have sharp
eventual lower decay in every odd stationary order (equivalently, every odd
spatial dimension at least three). -/
theorem exists_smoothEndpointQuadraticIntegral_odd_eventually_lower
    (n : Nat) :
    ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ lambda : Real, L ≤ lambda →
      c / lambda ^ (n + 1) ≤
        ‖smoothEndpointQuadraticIntegral (2 * n + 1) lambda‖ := by
  obtain ⟨L, c, hL, hc, hbound⟩ :=
    exists_quadraticMoment_odd_eventually_lower_of_ne_zero n
      (smoothEndpointProfile (2 * n + 1))
      (contDiff_smoothEndpointProfile (2 * n + 1))
      (smoothEndpointProfile_eventuallyEq_zero_at_one (2 * n + 1))
      (brrs_smoothEndpointProfile_zero_ne_zero (2 * n + 1))
  refine ⟨L, c, hL, hc, ?_⟩
  intro lambda hlambda
  rw [smoothEndpointQuadraticIntegral_eq_quadraticMomentIntegral]
  exact hbound lambda hlambda

/-- The odd-order endpoint lower bound is invariant under reversal of the
stationary phase.  This packages the outgoing and incoming signs in one
reusable statement. -/
theorem exists_smoothEndpointQuadraticIntegral_odd_eventually_lower_abs
    (n : Nat) :
    ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ lambda : Real, L ≤ |lambda| →
      c / |lambda| ^ (n + 1) ≤
        ‖smoothEndpointQuadraticIntegral (2 * n + 1) lambda‖ := by
  obtain ⟨L, c, hL, hc, hbound⟩ :=
    exists_smoothEndpointQuadraticIntegral_odd_eventually_lower n
  refine ⟨L, c, hL, hc, ?_⟩
  intro lambda hlambda
  rcases le_total 0 lambda with hnonneg | hnonpos
  · have hlarge : L ≤ lambda := by
      simpa [abs_of_nonneg hnonneg] using hlambda
    simpa [abs_of_nonneg hnonneg] using hbound lambda hlarge
  · by_cases hzero : lambda = 0
    · subst lambda
      norm_num at hlambda
      linarith
    · have hneg : lambda < 0 := lt_of_le_of_ne hnonpos hzero
      have hlarge : L ≤ -lambda := by
        simpa [abs_of_neg hneg] using hlambda
      have hpositive := hbound (-lambda) hlarge
      calc
        c / |lambda| ^ (n + 1) = c / (-lambda) ^ (n + 1) := by
          rw [abs_of_neg hneg]
        _ ≤ ‖smoothEndpointQuadraticIntegral (2 * n + 1) (-lambda)‖ := hpositive
        _ = ‖smoothEndpointQuadraticIntegral (2 * n + 1) lambda‖ := by
          simpa only [neg_neg] using
            (norm_smoothEndpointQuadraticIntegral_neg (2 * n + 1) (-lambda)).symm

/-- In every odd spatial dimension at least three, the outgoing BRRS
stationary endpoint amplitude inherits the sharp lower decay of its quadratic
normal form.  The statement retains the literal `2π a rho` parameter which
is later matched to the packet shell. -/
theorem exists_norm_brrsSurfaceWaveAmplitude_outgoing_odd_eventually_lower
    (n : Nat) :
    ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ a rho : Real,
      L ≤ |(2 * Real.pi * a) * rho| →
      c / |(2 * Real.pi * a) * rho| ^ (n + 1) ≤
        ‖brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho‖ := by
  obtain ⟨L, c, hL, hc, hbound⟩ :=
    exists_smoothEndpointQuadraticIntegral_odd_eventually_lower_abs n
  let mass : Real := surfaceMass (2 * n + 2)
  have hmass : 0 < mass := by
    dsimp [mass]
    apply surfaceMass_pos
    omega
  refine ⟨L, mass * c, hL, mul_pos hmass hc, ?_⟩
  intro a rho hlarge
  have hstationary := hbound ((2 * Real.pi * a) * rho) hlarge
  have hdim_one : (2 * n + 3) - 1 = 2 * n + 2 := by omega
  have hdim_two : (2 * n + 3) - 2 = 2 * n + 1 := by omega
  have hamp : ‖brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho‖ =
      mass * ‖smoothEndpointQuadraticIntegral (2 * n + 1)
        ((2 * Real.pi * a) * rho)‖ := by
    unfold brrsSurfaceWaveAmplitude
    rw [hdim_one, hdim_two, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg hmass.le]
  rw [hamp]
  calc
    mass * c / |(2 * Real.pi * a) * rho| ^ (n + 1) =
        mass * (c / |(2 * Real.pi * a) * rho| ^ (n + 1)) := by ring
    _ ≤ mass * ‖smoothEndpointQuadraticIntegral (2 * n + 1)
        ((2 * Real.pi * a) * rho)‖ :=
      mul_le_mul_of_nonneg_left hstationary hmass.le

/-- The incoming odd-dimensional endpoint has the same lower size; phase
reversal only conjugates the real endpoint integral. -/
theorem exists_norm_brrsSurfaceWaveAmplitude_incoming_odd_eventually_lower
    (n : Nat) :
    ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ a rho : Real,
      L ≤ |(2 * Real.pi * a) * rho| →
      c / |(2 * Real.pi * a) * rho| ^ (n + 1) ≤
        ‖brrsSurfaceWaveAmplitude (2 * n + 3) .incoming a rho‖ := by
  obtain ⟨L, c, hL, hc, hbound⟩ :=
    exists_smoothEndpointQuadraticIntegral_odd_eventually_lower_abs n
  let mass : Real := surfaceMass (2 * n + 2)
  have hmass : 0 < mass := by
    dsimp [mass]
    apply surfaceMass_pos
    omega
  refine ⟨L, mass * c, hL, mul_pos hmass hc, ?_⟩
  intro a rho hlarge
  have hphase : |(-(2 * Real.pi * a)) * rho| = |(2 * Real.pi * a) * rho| := by
    rw [show (-(2 * Real.pi * a)) * rho = -((2 * Real.pi * a) * rho) by ring,
      abs_neg]
  have hstationary := hbound ((-(2 * Real.pi * a)) * rho) (by simpa [hphase] using hlarge)
  have hdim_one : (2 * n + 3) - 1 = 2 * n + 2 := by omega
  have hdim_two : (2 * n + 3) - 2 = 2 * n + 1 := by omega
  have hamp : ‖brrsSurfaceWaveAmplitude (2 * n + 3) .incoming a rho‖ =
      mass * ‖smoothEndpointQuadraticIntegral (2 * n + 1)
        ((-(2 * Real.pi * a)) * rho)‖ := by
    unfold brrsSurfaceWaveAmplitude
    rw [hdim_one, hdim_two, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg hmass.le]
  rw [hamp]
  calc
    mass * c / |(2 * Real.pi * a) * rho| ^ (n + 1) =
        mass * (c / |(-(2 * Real.pi * a)) * rho| ^ (n + 1)) := by
      rw [hphase]
      ring
    _ ≤ mass * ‖smoothEndpointQuadraticIntegral (2 * n + 1)
        ((-(2 * Real.pi * a)) * rho)‖ :=
      mul_le_mul_of_nonneg_left hstationary hmass.le

/-- Multiplication by the literal stationary carrier has unit modulus, so an
endpoint-amplitude lower bound is exactly a lower bound for the corresponding
isolated radial surface-wave term. -/
theorem norm_brrsSurfaceWaveTerm_eq_norm_brrsSurfaceWaveAmplitude
    (d : Nat) (part : BRRSSurfaceWavePart) (a rho : Real) :
    ‖brrsSurfaceWaveTerm d part a rho‖ = ‖brrsSurfaceWaveAmplitude d part a rho‖ := by
  unfold brrsSurfaceWaveTerm
  rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one]

end Auto.Spherical.BRRS
