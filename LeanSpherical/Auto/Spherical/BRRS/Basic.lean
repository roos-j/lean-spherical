    rintro c hc hcs ⟨s, hs⟩
    refine ⟨⋃₀ c, ?_, fun _ => Set.subset_sUnion_of_mem⟩
    refine ⟨?_, ?_, ?_⟩
    · intro x hx
      exact Set.mem_sUnion_of_mem ((hc hs).1 hx) hs
    · rintro x ⟨s, hs, hxs⟩
      exact (hc hs).2.1 hxs
    · rintro x ⟨s, hs, hxs⟩ y ⟨t, ht, hyt⟩ hxy
