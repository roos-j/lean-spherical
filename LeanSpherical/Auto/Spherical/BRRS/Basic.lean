    (hM : Auto.FractalDimensions.HasUpperMinkowskiExponent E beta) :
    ∀ epsilon : Real, 0 < epsilon → ∃ C : Real, 0 < C ∧
      ∀ delta : NNReal, 0 < (delta : Real) → (delta : Real) < 1 →
        brrsEntropyNumber E delta ≤
          ENNReal.ofReal (C * (delta : Real) ^ (-(beta + epsilon))) := by
  intro epsilon hepsilon
  obtain ⟨C, hC, hcover⟩ := hM epsilon hepsilon
  refine ⟨C, hC, ?_⟩
  intro delta hdelta hdelta_one
  obtain ⟨centers, hcenters, hcard⟩ := hcover delta hdelta hdelta_one
  calc
    brrsEntropyNumber E delta ≤ (centers.card : ENNReal) :=
      Auto.Spherical.BRRS.brrsEntropyNumber_le_of_intervalCover hcenters
    _ = ENNReal.ofReal (centers.card : Real) := by simp
    _ ≤ ENNReal.ofReal (C * (delta : Real) ^ (-(beta + epsilon))) :=
      ENNReal.ofReal_le_ofReal hcard

/-- A dyadic BRRS discretization inherits the cardinality bound supplied by
any upper Minkowski exponent.  The half-mesh is forced by the closed-ball
entropy convention, not by a loss in the sampling argument. -/
theorem dyadicDiscretization_card_le_of_hasUpperMinkowskiExponent
    {E : Set Real} {beta : Real}
    (hM : Auto.FractalDimensions.HasUpperMinkowskiExponent E beta) :
    ∀ epsilon : Real, 0 < epsilon → ∃ C : Real, 0 < C ∧
      ∀ j : Nat, 1 ≤ j → ∀ T : Finset Real,
        IsDyadicDiscretization E j T →
          (T.card : Real) ≤ C *
            (dyadicTimeScale j / 2) ^ (-(beta + epsilon)) := by
  intro epsilon hepsilon
  obtain ⟨C, hC, hEntropy⟩ :=
    brrsEntropyNumber_le_of_hasUpperMinkowskiExponent hM epsilon hepsilon
  refine ⟨C, hC, ?_⟩
  intro j _hj T hT
  let delta : NNReal := ⟨dyadicTimeScale j / 2, by
    unfold dyadicTimeScale
    exact (div_pos (inv_pos.mpr
      (pow_pos (by norm_num : (0 : Real) < 2) _))
      (by norm_num : (0 : Real) < 2)).le⟩
  have hdelta_pos : 0 < (delta : Real) := by
    change 0 < ((2 : Real) ^ j)⁻¹ / 2
    exact div_pos (inv_pos.mpr (pow_pos (by norm_num) _)) (by norm_num)
  have hdelta_lt_one : (delta : Real) < 1 := by
    have hpow : 1 ≤ (2 : Real) ^ j := one_le_pow₀ (by norm_num)
    have hinv : ((2 : Real) ^ j)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hpow
    change ((2 : Real) ^ j)⁻¹ / 2 < 1
    nlinarith
  have hcardENN : (T.card : ENNReal) ≤ brrsEntropyNumber E delta := by
    simpa only [delta] using
      dyadicDiscretization_card_le_brrsEntropyNumber_half_scale hT
  have hboundENN : (T.card : ENNReal) ≤
      ENNReal.ofReal (C * (delta : Real) ^ (-(beta + epsilon))) :=
    hcardENN.trans (hEntropy delta hdelta_pos hdelta_lt_one)
  have hnonneg : 0 ≤ C * (delta : Real) ^ (-(beta + epsilon)) :=
    mul_nonneg hC.le (Real.rpow_nonneg hdelta_pos.le _)
  have hreal :=
    (ENNReal.toReal_le_toReal (by simp) ENNReal.ofReal_ne_top).mpr hboundENN
  change (T.card : Real) ≤ C * (delta : Real) ^ (-(beta + epsilon))
  simpa only [ENNReal.toReal_natCast, ENNReal.toReal_ofReal hnonneg] using hreal

/-- The positive half-wave multiplier in Mathlib's Fourier normalization. -/
def halfWaveMultiplier {d : Nat} (t : Real) : BRRSSpace d → Complex :=
  fun xi =>
    Complex.exp (((2 * Real.pi * t * ‖xi‖ : Real) : Complex) * Complex.I)

/-- The half-wave phase is radial in frequency. -/
theorem halfWaveMultiplier_isRadial {d : Nat} (t : Real) :
    IsRadial (halfWaveMultiplier (d := d) t) := by
  intro xi eta hnorm
  unfold halfWaveMultiplier
  rw [hnorm]

/-- Hence the half-wave phase is invariant under all orthogonal frequency
changes of coordinates. -/
theorem halfWaveMultiplier_orthogonallyInvariant {d : Nat} (t : Real) :
    IsOrthogonallyInvariant (halfWaveMultiplier (d := d) t) :=
  (halfWaveMultiplier_isRadial t).orthogonallyInvariant

/-- Away from frequency zero, the half-wave phase is smooth.  The annular
multiplier below supplies the removable-zero extension needed globally. -/
theorem halfWaveMultiplier_contDiffAt_of_ne_zero {d : Nat} (t : Real)
    {xi : BRRSSpace d} (hxi : xi ≠ 0) :
    ContDiffAt Real (⊤ : ℕ∞) (halfWaveMultiplier (d := d) t) xi := by
  unfold halfWaveMultiplier
  have hnorm : ContDiffAt Real (⊤ : ℕ∞)
      (fun eta : BRRSSpace d => ‖eta‖) xi :=
    contDiffAt_norm Real hxi
  have hreal : ContDiffAt Real (⊤ : ℕ∞)
      (fun eta : BRRSSpace d => 2 * Real.pi * t * ‖eta‖) xi := by
    have hconst : ContDiffAt Real (⊤ : ℕ∞)
        (fun _ : BRRSSpace d => 2 * Real.pi * t) xi :=
      contDiffAt_const
    exact hconst.mul hnorm
  have hcomplex : ContDiffAt Real (⊤ : ℕ∞)
      (fun eta : BRRSSpace d =>
        ((2 * Real.pi * t * ‖eta‖ : Real) : Complex) * Complex.I) xi := by
    exact (Complex.ofRealCLM.contDiff.contDiffAt.comp xi hreal).mul contDiffAt_const
  exact hcomplex.cexp

/-- The literal Schwartz half-wave `e^{it sqrt(-Delta)}`. -/
def halfWave {d : Nat} (t : Real) (f : BRRSSchwartz d) : BRRSSpace d → Complex :=
  fun x => 𝓕⁻ (fun xi : BRRSSpace d =>
    halfWaveMultiplier t xi * 𝓕 (f : BRRSSpace d → Complex) xi) x

/-- An auxiliary Littlewood--Paley realization of an annular projection.

When `C.cutoff` is radial, this is obtained by taking the difference of two
adjacent low-pass cutoffs.  The public BRRS statement below instead uses the
literal arbitrary annular bump `BRRSAnnularCutoff`. -/
def dyadicProjection {d : Nat} (C : lpCutoffs d) (j : Nat)
    (f : BRRSSchwartz d) : BRRSSpace d → Complex :=
  Auto.LittlewoodPaley.dyadicProjection C.cutoff j f

/-- The auxiliary Littlewood--Paley frequency-localized half-wave, retained
for comparison with the repository's pre-existing dyadic machinery. -/
def dyadicHalfWave {d : Nat} (C : lpCutoffs d) (j : Nat) (t : Real)
    (f : BRRSSchwartz d) : BRRSSpace d → Complex :=
  fun x => 𝓕⁻ (fun xi : BRRSSpace d =>
    halfWaveMultiplier t xi * dyadicBandpassMultiplier C.cutoff j xi *
      𝓕 (f : BRRSSpace d → Complex) xi) x

/-! ### The existing planar MSS local-smoothing theorem

The BRRS proof uses a substantially sharper fractal-time estimate than the
continuous local-smoothing statement.  Nevertheless, the latter is a real
analytic input to the planar full-time case.  The following identities make
the normalization bridge explicit: no change of Fourier convention, cutoff,
or half-wave sign is hidden when the MSS theorem is invoked below.
-/

/-- The auxiliary positive dyadic half-wave is exactly the positive planar
half-wave used in the MSS development. -/
theorem auxiliaryDyadicHalfWave_eq_mss (C : lpCutoffs 2) (j : Nat) (t : Real)
    (f : BRRSSchwartz 2) :
    dyadicHalfWave C j t f =
      Auto.Spherical.MSS.dyadicHalfWave C.cutoff .plus j t f := by
  funext x
  unfold dyadicHalfWave Auto.Spherical.MSS.dyadicHalfWave
  apply congrArg (fun g : BRRSSpace 2 → Complex => 𝓕⁻ g x)
  funext xi
  have hphase : halfWaveMultiplier t xi =
      Auto.Spherical.MSS.halfWaveMultiplier .plus t xi := by
    unfold halfWaveMultiplier Auto.Spherical.MSS.halfWaveMultiplier
    simp only [Auto.Spherical.MSS.WaveSign.toReal]
    congr 1
    push_cast
    ring
  rw [hphase]

/-- The BRRS auxiliary half-wave as a planar space--time function on the
MSS time slab `[1, 2]`. -/
def auxiliaryDyadicHalfWaveSpaceTime (C : lpCutoffs 2) (j : Nat)
    (f : BRRSSchwartz 2) : Euclidean 2 × Real → Complex :=
  fun z => dyadicHalfWave C j z.2 f z.1

/-- The space--time BRRS auxiliary half-wave agrees pointwise with the MSS
space--time half-wave. -/
theorem auxiliaryDyadicHalfWaveSpaceTime_eq_mss (C : lpCutoffs 2) (j : Nat)
    (f : BRRSSchwartz 2) :
    auxiliaryDyadicHalfWaveSpaceTime C j f =
      Auto.Spherical.MSS.dyadicHalfWaveSpaceTime C.cutoff .plus j f := by
  funext z
  exact congrFun (auxiliaryDyadicHalfWave_eq_mss C j z.2 f) z.1

private theorem brrs_const_mul_fourierInv
    {d : Nat} (a : Complex) (g : BRRSSpace d → Complex) (x : BRRSSpace d) :
    a * 𝓕⁻ g x = 𝓕⁻ (fun xi => a * g xi) x := by
  rw [Real.fourierInv_eq, Real.fourierInv_eq, ← MeasureTheory.integral_const_mul]
  apply integral_congr_ae
  filter_upwards with xi
  change a * (Real.fourierChar (inner Real xi x) • g xi) =
    Real.fourierChar (inner Real xi x) • (a * g xi)
  rw [show a * (Real.fourierChar (inner Real xi x) • g xi) =
      (Real.fourierChar (inner Real xi x) : Complex) * (a * g xi) by
        change a * ((Real.fourierChar (inner Real xi x) : Complex) * g xi) = _
        ring]
  rfl

/-- The literal time-derivative candidate for the auxiliary planar
half-wave.  The compact radial input multiplier is the one already
constructed in the Bourgain module: on the active dyadic annulus it extracts
one factor of `2^j` from the half-wave phase. -/
noncomputable def auxiliaryDyadicHalfWaveTimeDerivative
    (C : lpCutoffs 2) (j : Nat) (t : Real) (f : BRRSSchwartz 2) :
    BRRSSpace 2 → Complex :=
  fun x => (((2 : Real) ^ j : Real) : Complex) *
    dyadicHalfWave C j t
      (Auto.Spherical.MSS.circleEndpointTimeDerivativeInput C .plus j f) x

/-- Fourier-side form of the candidate time derivative.  This is an exact
identity, not a symbolic differentiation convention. -/
theorem auxiliaryDyadicHalfWaveTimeDerivative_eq_fourierInv
    (C : lpCutoffs 2) (j : Nat) (t : Real) (f : BRRSSchwartz 2)
    (x : BRRSSpace 2) :
    auxiliaryDyadicHalfWaveTimeDerivative C j t f x =
      𝓕⁻ (fun xi : BRRSSpace 2 =>
        Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative .plus t xi *
          dyadicBandpassMultiplier C.cutoff j xi *
          𝓕 (f : BRRSSpace 2 → Complex) xi) x := by
  unfold auxiliaryDyadicHalfWaveTimeDerivative dyadicHalfWave
  rw [brrs_const_mul_fourierInv]
  apply congrArg (fun g : BRRSSpace 2 → Complex => 𝓕⁻ g x)
  funext xi
  rw [Auto.Spherical.MSS.circleEndpointTimeDerivativeInput_fourier]
  have hphase : halfWaveMultiplier t xi =
      Auto.Spherical.MSS.halfWaveMultiplier .plus t xi := by
    unfold halfWaveMultiplier Auto.Spherical.MSS.halfWaveMultiplier
    simp only [Auto.Spherical.MSS.WaveSign.toReal]
    congr 1
    push_cast
    ring
  rw [hphase]
  have hmult :=
    Auto.Spherical.MSS.dyadicHalfWaveSymbol_mul_circleEndpointTimeDerivativeInputMultiplier
      C Auto.Spherical.MSS.WaveSign.plus j t xi
  calc
    (((2 : Real) ^ j : Real) : Complex) *
        (Auto.Spherical.MSS.halfWaveMultiplier .plus t xi *
          dyadicBandpassMultiplier C.cutoff j xi *
          (Auto.Spherical.MSS.circleEndpointTimeDerivativeInputMultiplier C .plus j xi *
            𝓕 (f : BRRSSpace 2 → Complex) xi)) =
        ((((2 : Real) ^ j : Real) : Complex) *
          ((Auto.Spherical.MSS.halfWaveMultiplier .plus t xi *
            dyadicBandpassMultiplier C.cutoff j xi) *
            Auto.Spherical.MSS.circleEndpointTimeDerivativeInputMultiplier C .plus j xi)) *
          𝓕 (f : BRRSSpace 2 → Complex) xi := by ring
    _ = (Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative .plus t xi *
          dyadicBandpassMultiplier C.cutoff j xi) *
          𝓕 (f : BRRSSpace 2 → Complex) xi := by
      rw [← Auto.Spherical.MSS.dyadicHalfWaveSymbol]
      rw [hmult]
    _ = _ := by ring

/-- The raw dyadic half-wave is jointly continuous with its literal
time-derivative candidate, and the latter is genuinely its pointwise time
derivative.  Compact dyadic frequency support justifies differentiation under
the inverse Fourier integral. -/
private theorem auxiliaryDyadicHalfWave_continuous_and_hasDerivAt
    (C : lpCutoffs 2) (j : Nat) (f : BRRSSchwartz 2) :
    Continuous (Function.uncurry (fun t x => dyadicHalfWave C j t f x)) ∧
      Continuous (Function.uncurry
        (fun t x => auxiliaryDyadicHalfWaveTimeDerivative C j t f x)) ∧
      ∀ t x, HasDerivAt (fun s => dyadicHalfWave C j s f x)
        (auxiliaryDyadicHalfWaveTimeDerivative C j t f x) t := by
  let g : BRRSSchwartz 2 :=
    Auto.Spherical.MSS.circleEndpointTimeDerivativeInput C .plus j f
  have hFcont : Continuous (Function.uncurry (fun t x => dyadicHalfWave C j t f x)) := by
    have h := Auto.Spherical.MSS.continuous_dyadicHalfWaveSpaceTime C .plus j f
    have hswap := h.comp (continuous_snd.prodMk continuous_fst)
    have hraw : Function.uncurry (fun t x => dyadicHalfWave C j t f x) =
        Auto.Spherical.MSS.dyadicHalfWaveSpaceTime C.cutoff .plus j f ∘
          fun p : Real × BRRSSpace 2 => (p.2, p.1) := by
      funext p
      change dyadicHalfWave C j p.1 f p.2 =
        Auto.Spherical.MSS.dyadicHalfWave C.cutoff .plus j p.1 f p.2
      exact congrFun (auxiliaryDyadicHalfWave_eq_mss C j p.1 f) p.2
    rw [hraw]
    exact hswap
  have hDcont : Continuous (Function.uncurry
      (fun t x => auxiliaryDyadicHalfWaveTimeDerivative C j t f x)) := by
    have h := Auto.Spherical.MSS.continuous_dyadicHalfWaveSpaceTime C .plus j g
    have hswap := h.comp (continuous_snd.prodMk continuous_fst)
    have hraw : (fun p : Real × BRRSSpace 2 =>
        auxiliaryDyadicHalfWaveTimeDerivative C j p.1 f p.2) =
        fun p => (((2 : Real) ^ j : Real) : Complex) *
          Auto.Spherical.MSS.dyadicHalfWave C.cutoff .plus j p.1 g p.2 := by
      funext p
      simp only [auxiliaryDyadicHalfWaveTimeDerivative, g,
        auxiliaryDyadicHalfWave_eq_mss]
    change Continuous (fun p : Real × BRRSSpace 2 =>
      auxiliaryDyadicHalfWaveTimeDerivative C j p.1 f p.2)
    rw [hraw]
    exact continuous_const.mul hswap
  refine ⟨hFcont, hDcont, ?_⟩
  intro s x
  let K : Set (BRRSSpace 2) := Metric.closedBall 0 ((2 : Real) ^ (j + 2))
  have hK : IsCompact K := isCompact_closedBall _ _
  have hKmeas : MeasurableSet K := hK.measurableSet
  let G : Real → BRRSSpace 2 → Complex := fun t xi =>
    (Real.fourierChar (inner Real xi x) : Complex) *
      (Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff .plus j t xi *
        𝓕 (f : BRRSSpace 2 → Complex) xi)
  let G' : Real → BRRSSpace 2 → Complex := fun t xi =>
    (Real.fourierChar (inner Real xi x) : Complex) *
      ((Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative .plus t xi *
        dyadicBandpassMultiplier C.cutoff j xi) *
        𝓕 (f : BRRSSpace 2 → Complex) xi)
  have hGsupport (t : Real) : Function.support (G t) ⊆ K := by
    intro xi hxi
    by_contra hxiK
    have hnorm : (2 : Real) ^ (j + 2) ≤ ‖xi‖ := by
      rw [Metric.mem_closedBall, dist_zero_right] at hxiK
      exact le_of_not_ge hxiK
    have hband : dyadicBandpassMultiplier C.cutoff j xi = 0 :=
      dyadicBandpass_eq_zero_of_le_norm C hnorm
    change G t xi ≠ 0 at hxi
    exact hxi (by simp [G, Auto.Spherical.MSS.dyadicHalfWaveSymbol, hband])
  have hG'support (t : Real) : Function.support (G' t) ⊆ K := by
    intro xi hxi
    by_contra hxiK
    have hnorm : (2 : Real) ^ (j + 2) ≤ ‖xi‖ := by
      rw [Metric.mem_closedBall, dist_zero_right] at hxiK
      exact le_of_not_ge hxiK
    have hband : dyadicBandpassMultiplier C.cutoff j xi = 0 :=
      dyadicBandpass_eq_zero_of_le_norm C hnorm
    change G' t xi ≠ 0 at hxi
    exact hxi (by simp [G', hband])
  have hGintegral (t : Real) :
      (∫ xi : BRRSSpace 2, G t xi) = ∫ xi in K, G t xi := by
    rw [← MeasureTheory.integral_indicator hKmeas]
    rw [Set.indicator_eq_self.mpr (hGsupport t)]
  have hG'integral (t : Real) :
      (∫ xi : BRRSSpace 2, G' t xi) = ∫ xi in K, G' t xi := by
    rw [← MeasureTheory.integral_indicator hKmeas]
    rw [Set.indicator_eq_self.mpr (hG'support t)]
  have hFcurve : (fun t : Real => dyadicHalfWave C j t f x) =
      fun t => ∫ xi in K, G t xi := by
    funext t
    have hraw : dyadicHalfWave C j t f x = ∫ xi : BRRSSpace 2, G t xi := by
      rw [auxiliaryDyadicHalfWave_eq_mss]
      unfold Auto.Spherical.MSS.dyadicHalfWave G
      rw [Real.fourierInv_eq]
      apply integral_congr_ae
      filter_upwards with xi
      change (Real.fourierChar (inner Real xi x) : Complex) *
          (Auto.Spherical.MSS.halfWaveMultiplier .plus t xi *
            dyadicBandpassMultiplier C.cutoff j xi *
            𝓕 (f : BRRSSpace 2 → Complex) xi) = _
      rfl
    rw [hraw, hGintegral]
  have hDcurve : auxiliaryDyadicHalfWaveTimeDerivative C j s f x =
      ∫ xi in K, G' s xi := by
    have hraw : auxiliaryDyadicHalfWaveTimeDerivative C j s f x =
        ∫ xi : BRRSSpace 2, G' s xi := by
      rw [auxiliaryDyadicHalfWaveTimeDerivative_eq_fourierInv]
      unfold G'
      rw [Real.fourierInv_eq]
      apply integral_congr_ae
      filter_upwards with xi
      change (Real.fourierChar (inner Real xi x) : Complex) *
          ((Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative .plus s xi *
            dyadicBandpassMultiplier C.cutoff j xi) *
            𝓕 (f : BRRSSpace 2 → Complex) xi) = _
      rfl
    rw [hraw, hG'integral]
  have hGslice (t : Real) : Continuous (fun xi : BRRSSpace 2 => G t xi) := by
    have hchar : Continuous (fun xi : BRRSSpace 2 =>
        (Real.fourierChar (inner Real xi x) : Complex)) := by fun_prop
    have hhalf : Continuous (fun xi : BRRSSpace 2 =>
        Auto.Spherical.MSS.halfWaveMultiplier .plus t xi) := by
      unfold Auto.Spherical.MSS.halfWaveMultiplier
      apply Complex.continuous_exp.comp
      exact (Complex.continuous_ofReal.comp (by fun_prop)).mul continuous_const
    have hband : Continuous (dyadicBandpassMultiplier C.cutoff j : BRRSSpace 2 → Complex) :=
      (dyadicBandpassMultiplier C.cutoff j).continuous
    have hfourier : Continuous (fun xi : BRRSSpace 2 =>
        𝓕 (f : BRRSSpace 2 → Complex) xi) :=
      (𝓕 f).continuous
    dsimp [G]
    unfold Auto.Spherical.MSS.dyadicHalfWaveSymbol
    exact hchar.mul ((hhalf.mul hband).mul hfourier)
  have hG'slice (t : Real) : Continuous (fun xi : BRRSSpace 2 => G' t xi) := by
    have hchar : Continuous (fun xi : BRRSSpace 2 =>
        (Real.fourierChar (inner Real xi x) : Complex)) := by fun_prop
    have hhalf : Continuous (fun xi : BRRSSpace 2 =>
        Auto.Spherical.MSS.halfWaveMultiplier .plus t xi) := by
      unfold Auto.Spherical.MSS.halfWaveMultiplier
      apply Complex.continuous_exp.comp
      exact (Complex.continuous_ofReal.comp (by fun_prop)).mul continuous_const
    have hcoef : Continuous (fun xi : BRRSSpace 2 =>
        (((Auto.Spherical.MSS.WaveSign.plus.toReal * (2 * Real.pi) * ‖xi‖ : Real) :
          Complex) * Complex.I)) := by
      exact (Complex.continuous_ofReal.comp (by fun_prop)).mul continuous_const
    have hdot : Continuous (fun xi : BRRSSpace 2 =>
        Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative .plus t xi) := by
      unfold Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative
      exact hcoef.mul hhalf
    have hband : Continuous (dyadicBandpassMultiplier C.cutoff j : BRRSSpace 2 → Complex) :=
      (dyadicBandpassMultiplier C.cutoff j).continuous
    have hfourier : Continuous (fun xi : BRRSSpace 2 =>
        𝓕 (f : BRRSSpace 2 → Complex) xi) :=
      (𝓕 f).continuous
    dsimp [G']
    exact hchar.mul ((hdot.mul hband).mul hfourier)
  have hG'curve : Continuous (fun q : Real × BRRSSpace 2 => G' q.1 q.2) := by
    have hchar : Continuous (fun q : Real × BRRSSpace 2 =>
        (Real.fourierChar (inner Real q.2 x) : Complex)) := by fun_prop
    have hhalf : Continuous (fun q : Real × BRRSSpace 2 =>
        Auto.Spherical.MSS.halfWaveMultiplier .plus q.1 q.2) := by
      unfold Auto.Spherical.MSS.halfWaveMultiplier
      apply Complex.continuous_exp.comp
      exact (Complex.continuous_ofReal.comp (by fun_prop)).mul continuous_const
    have hcoef : Continuous (fun q : Real × BRRSSpace 2 =>
        (((Auto.Spherical.MSS.WaveSign.plus.toReal * (2 * Real.pi) * ‖q.2‖ : Real) :
          Complex) * Complex.I)) := by
      exact (Complex.continuous_ofReal.comp (by fun_prop)).mul continuous_const
    have hdot : Continuous (fun q : Real × BRRSSpace 2 =>
        Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative .plus q.1 q.2) := by
      unfold Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative
      exact hcoef.mul hhalf
    have hband : Continuous (fun q : Real × BRRSSpace 2 =>
        dyadicBandpassMultiplier C.cutoff j q.2) :=
      (dyadicBandpassMultiplier C.cutoff j).continuous.comp continuous_snd
    have hfourier : Continuous (fun q : Real × BRRSSpace 2 =>
        𝓕 (f : BRRSSpace 2 → Complex) q.2) :=
      (𝓕 f).continuous.comp continuous_snd
    dsimp [G']
    exact hchar.mul ((hdot.mul hband).mul hfourier)
  have hGderiv (t : Real) (xi : BRRSSpace 2) :
      HasDerivAt (fun u : Real => G u xi) (G' t xi) t := by
    have hhalf := Auto.Spherical.MSS.hasDerivAt_halfWaveMultiplier_time
      Auto.Spherical.MSS.WaveSign.plus t xi
    have hsymbol := hhalf.mul_const (dyadicBandpassMultiplier C.cutoff j xi)
    have hfull := hsymbol.mul_const (𝓕 (f : BRRSSpace 2 → Complex) xi)
    have hchar := hfull.const_mul (Real.fourierChar (inner Real xi x) : Complex)
    simpa [G, G', Auto.Spherical.MSS.dyadicHalfWaveSymbol] using hchar
  have hFmeas : ∀ᶠ t in nhds s,
      AEStronglyMeasurable (fun xi : BRRSSpace 2 => G t xi) (volume.restrict K) := by
    filter_upwards [] with t
    exact (hGslice t).aestronglyMeasurable.restrict
  have hFint : Integrable (fun xi : BRRSSpace 2 => G s xi) (volume.restrict K) := by
    have hcompact : HasCompactSupport (fun xi : BRRSSpace 2 => G s xi) := by
      apply HasCompactSupport.of_support_subset_isCompact hK
      exact hGsupport s
    exact ((hGslice s).integrable_of_hasCompactSupport hcompact).restrict
  have hF'meas : AEStronglyMeasurable (fun xi : BRRSSpace 2 => G' s xi)
      (volume.restrict K) :=
    (hG'slice s).aestronglyMeasurable.restrict
  obtain ⟨A, hA⟩ := (isCompact_Icc.prod hK).exists_bound_of_continuousOn
    hG'curve.continuousOn
  have hbound : ∀ᵐ xi : BRRSSpace 2 ∂(volume.restrict K),
      ∀ t ∈ Icc (s - 1) (s + 1), ‖G' t xi‖ ≤ A := by
    filter_upwards [ae_restrict_mem hKmeas] with xi hxi
    intro t ht
    exact hA (t, xi) ⟨ht, hxi⟩
  have hAint : Integrable (fun _ : BRRSSpace 2 => A) (volume.restrict K) := by
    simpa only [IntegrableOn] using
      (integrableOn_const (μ := volume) (s := K) hK.measure_ne_top :
        IntegrableOn (fun _ : BRRSSpace 2 => A) K volume)
  have hdiff : ∀ᵐ xi : BRRSSpace 2 ∂(volume.restrict K),
      ∀ t ∈ Icc (s - 1) (s + 1),
        HasDerivAt (fun u : Real => G u xi) (G' t xi) t :=
    Filter.Eventually.of_forall fun xi t _ => hGderiv t xi
  have hs : Icc (s - 1) (s + 1) ∈ nhds s :=
    Icc_mem_nhds (sub_lt_self s zero_lt_one) (lt_add_of_pos_right s zero_lt_one)
  have hparam := hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := volume.restrict K) (s := Icc (s - 1) (s + 1)) (x₀ := s)
    (bound := fun _ : BRRSSpace 2 => A)
    (F := fun t (xi : BRRSSpace 2) => G t xi)
    (F' := fun t (xi : BRRSSpace 2) => G' t xi)
    hs hFmeas hFint hF'meas hbound hAint hdiff
  rw [hFcurve, hDcurve]
  exact hparam.2

private theorem auxiliaryDyadicHalfWave_memLp_four_spaceTime_of_gain
    (C : lpCutoffs 2) {rho : Real}
    (hgain : Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 rho)
    (j : Nat) (hj : 1 ≤ j) (f : BRRSSchwartz 2) :
    MemLp (auxiliaryDyadicHalfWaveSpaceTime C j f) (ENNReal.ofReal (4 : Real))
      Auto.Spherical.MSS.localSmoothingMeasure := by
  rcases hgain with ⟨hp, hrho, A, hA, hbound⟩
  have hmain := hbound j hj f Auto.Spherical.MSS.WaveSign.plus
  have hmain' :
      eLpNorm (auxiliaryDyadicHalfWaveSpaceTime C j f) (ENNReal.ofReal (4 : Real))
          Auto.Spherical.MSS.localSmoothingMeasure ≤
        ENNReal.ofReal (A * (2 : Real) ^ ((j : Real) * (1 / 2 - 1 / 4 - rho))) *
          eLpNorm (f : BRRSSpace 2 → Complex) (ENNReal.ofReal (4 : Real)) volume := by
    rw [auxiliaryDyadicHalfWaveSpaceTime_eq_mss]
    exact hmain
  have hfmem : MemLp (f : BRRSSpace 2 → Complex) (ENNReal.ofReal (4 : Real)) volume :=
    f.memLp (ENNReal.ofReal (4 : Real)) volume
  have hright :
      ENNReal.ofReal (A * (2 : Real) ^ ((j : Real) * (1 / 2 - 1 / 4 - rho))) *
        eLpNorm (f : BRRSSpace 2 → Complex) (ENNReal.ofReal (4 : Real)) volume < ∞ :=
    ENNReal.mul_lt_top ENNReal.ofReal_lt_top hfmem.eLpNorm_lt_top
  exact hmain'.trans_lt hright

private theorem auxiliaryDyadicHalfWave_integrable_norm_pow_four_prod_of_gain
    (C : lpCutoffs 2) {rho : Real}
    (hgain : Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 rho)
    (j : Nat) (hj : 1 ≤ j) (f : BRRSSchwartz 2) :
    Integrable (fun p : Real × BRRSSpace 2 => ‖dyadicHalfWave C j p.1 f p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
  let nu : Measure Real := volume.restrict (Icc (1 : Real) 2)
  let U : BRRSSpace 2 × Real → Complex := auxiliaryDyadicHalfWaveSpaceTime C j f
  let G : Real × BRRSSpace 2 → Real := fun p => ‖dyadicHalfWave C j p.1 f p.2‖ ^ 4
  have hUint : Integrable (fun z : BRRSSpace 2 × Real => ‖U z‖ ^ 4)
      (volume.prod nu) := by
    have hmem := auxiliaryDyadicHalfWave_memLp_four_spaceTime_of_gain C hgain j hj f
    have h := hmem.integrable_norm_rpow
      (by norm_num : ENNReal.ofReal (4 : Real) ≠ 0) ENNReal.ofReal_ne_top
    have hfour : (ENNReal.ofReal (4 : Real)).toReal = (4 : Real) := by norm_num
    rw [hfour] at h
    have h' : Integrable (fun z : BRRSSpace 2 × Real =>
        ‖auxiliaryDyadicHalfWaveSpaceTime C j f z‖ ^ 4)
        (volume.prod nu) := by
      refine h.congr ?_
      filter_upwards with z
      exact Real.rpow_natCast _ 4
    simpa only [U] using h'
  have hUmeas : AEStronglyMeasurable (fun z : BRRSSpace 2 × Real => ‖U z‖ ^ 4)
      (volume.prod nu) := hUint.aestronglyMeasurable
  have hUfac := (integrable_prod_iff' hUmeas).1 hUint
  have hGmeas : AEStronglyMeasurable G (nu.prod volume) := by
    have hcont : Continuous G :=
      (auxiliaryDyadicHalfWave_continuous_and_hasDerivAt C j f).1.norm.pow 4
    exact hcont.aestronglyMeasurable
  change Integrable G (nu.prod volume)
  refine (integrable_prod_iff hGmeas).2 ?_
  constructor
  · filter_upwards [hUfac.1] with t ht
    simpa only [G, U, auxiliaryDyadicHalfWaveSpaceTime] using ht
  · simpa only [G, U, auxiliaryDyadicHalfWaveSpaceTime,
      Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (norm_nonneg _) _)] using hUfac.2

/-- The spatially integrated fourth-power version of Bourgain's separated-time
sampling lemma.  Unlike the vector-valued statement, this records the exact
Fubini hypotheses needed to sample a space-time field at individual times.
It is deliberately independent of the wave equation and can therefore be
reused for any BRRS time-dependent output. -/
theorem timeSamplingFour_spacetime_of_MSS_MaximalSeparated
    {d : Nat} {F F' : Real → Euclidean d → Complex}
    (j : Nat) (T : Finset Real)
    (hT : Auto.Spherical.MSS.MaximalSeparated j T)
    (hF_cont : ∀ x, Continuous (fun t => F t x))
    (hF'_cont : ∀ x, Continuous (fun t => F' t x))
    (hderiv : ∀ x t, HasDerivAt (fun s => F s x) (F' t x) t)
    (hFslice : ∀ t ∈ T, Integrable (fun x => ‖F t x‖ ^ 4) volume)
    (hFspace : Integrable (fun p : Real × Euclidean d => ‖F p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume))
    (hF'space : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume)) :
    (∑ t ∈ T, ∫ x : Euclidean d, ‖F t x‖ ^ 4) ≤
      16 * (Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4) +
        8 * (Auto.Spherical.MSS.dyadicTimeScale j) ^ 3 *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4) := by
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  have hFinner : Integrable (fun x : Euclidean d =>
      ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) volume := by
    have hG : Integrable (fun x : Euclidean d =>
        ∫ t : Real, ‖F t x‖ ^ 4 ∂ν) volume := by
      simpa only [ν] using hFspace.integral_prod_right
    have heq : (fun x : Euclidean d =>
        ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) =
        fun x => ∫ t : Real, ‖F t x‖ ^ 4 ∂ν := by
      funext x
      simp only [ν]
      rw [intervalIntegral.integral_of_le (by norm_num), ← integral_Icc_eq_integral_Ioc]
    rw [heq]
    exact hG
  have hF'inner : Integrable (fun x : Euclidean d =>
      ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) volume := by
    have hG : Integrable (fun x : Euclidean d =>
        ∫ t : Real, ‖F' t x‖ ^ 4 ∂ν) volume := by
      simpa only [ν] using hF'space.integral_prod_right
    have heq : (fun x : Euclidean d =>
        ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) =
        fun x => ∫ t : Real, ‖F' t x‖ ^ 4 ∂ν := by
      funext x
      simp only [ν]
      rw [intervalIntegral.integral_of_le (by norm_num), ← integral_Icc_eq_integral_Ioc]
    rw [heq]
    exact hG
  let H : Euclidean d → Real := fun x => ∑ t ∈ T, ‖F t x‖ ^ 4
  have hH : Integrable H volume := by
    dsimp only [H]
    exact integrable_finsetSum T fun t ht => hFslice t ht
  have hright : Integrable (fun x : Euclidean d =>
      16 * (Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
          (∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) +
        8 * (Auto.Spherical.MSS.dyadicTimeScale j) ^ 3 *
          (∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4)) volume := by
    exact (hFinner.const_mul
      (16 * (Auto.Spherical.MSS.dyadicTimeScale j)⁻¹)).add
      (hF'inner.const_mul
        (8 * (Auto.Spherical.MSS.dyadicTimeScale j) ^ 3))
  have hpoint (x : Euclidean d) : H x ≤
      16 * (Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
          (∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) +
        8 * (Auto.Spherical.MSS.dyadicTimeScale j) ^ 3 *
          (∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) := by
    dsimp only [H]
    exact Auto.Spherical.MSS.timeSamplingFour_of_MSS_MaximalSeparated j T hT
      (hF_cont x) (hF'_cont x) (fun t => hderiv x t)
  have hFswap :
      (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) =
        ∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4 := by
    have hFuIoc : Integrable (fun p : Real × Euclidean d => ‖F p.1 p.2‖ ^ 4)
        ((volume.restrict (uIoc (1 : Real) 2)).prod volume) := by
      rw [uIoc_of_le (by norm_num), restrict_Ioc_eq_restrict_Icc]
      exact hFspace
    exact (intervalIntegral_integral_swap
      (f := fun t (x : Euclidean d) => ‖F t x‖ ^ 4) hFuIoc).symm
  have hF'swap :
      (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) =
        ∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4 := by
    have hF'uIoc : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 4)
        ((volume.restrict (uIoc (1 : Real) 2)).prod volume) := by
      rw [uIoc_of_le (by norm_num), restrict_Ioc_eq_restrict_Icc]
      exact hF'space
    exact (intervalIntegral_integral_swap
      (f := fun t (x : Euclidean d) => ‖F' t x‖ ^ 4) hF'uIoc).symm
  calc
    (∑ t ∈ T, ∫ x : Euclidean d, ‖F t x‖ ^ 4) = ∫ x : Euclidean d, H x := by
      symm
      simpa only [H] using (integral_finsetSum T fun t ht => hFslice t ht)
    _ ≤ ∫ x : Euclidean d,
        16 * (Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
            (∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) +
          8 * (Auto.Spherical.MSS.dyadicTimeScale j) ^ 3 *
            (∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) := by
      apply integral_mono_ae hH hright
      exact Filter.Eventually.of_forall hpoint
    _ = 16 * (Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
          (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) +
        8 * (Auto.Spherical.MSS.dyadicTimeScale j) ^ 3 *
          (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) := by
      rw [MeasureTheory.integral_add
        (hFinner.const_mul (16 * (Auto.Spherical.MSS.dyadicTimeScale j)⁻¹))
        (hF'inner.const_mul
          (8 * (Auto.Spherical.MSS.dyadicTimeScale j) ^ 3)),
        MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul]
    _ = 16 * (Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4) +
        8 * (Auto.Spherical.MSS.dyadicTimeScale j) ^ 3 *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4) := by
      rw [hFswap, hF'swap]

private theorem auxiliaryDyadicHalfWave_integrable_norm_pow_four
    (C : lpCutoffs 2) (j : Nat) (t : Real) (f : BRRSSchwartz 2) :
    Integrable (fun x : BRRSSpace 2 => ‖dyadicHalfWave C j t f x‖ ^ 4) volume := by
  let H : SchwartzMap (BRRSSpace 2) Complex :=
    Auto.Spherical.MSS.circleAnnularEndpointHalfWaveOutput C .plus j t f
  have hmem : MemLp (H : BRRSSpace 2 → Complex) (ENNReal.ofReal (4 : Real)) volume :=
    H.memLp (ENNReal.ofReal (4 : Real)) volume
  have h := hmem.integrable_norm_rpow
    (by norm_num : ENNReal.ofReal (4 : Real) ≠ 0) ENNReal.ofReal_ne_top
  have hfour : (ENNReal.ofReal (4 : Real)).toReal = (4 : Real) := by norm_num
  rw [hfour] at h
  have hH : Integrable (fun x : BRRSSpace 2 => ‖H x‖ ^ 4) volume := by
    refine h.congr ?_
    filter_upwards with x
    exact Real.rpow_natCast _ 4
  refine hH.congr ?_
  filter_upwards with x
  rw [Auto.Spherical.MSS.circleAnnularEndpointHalfWaveOutput_apply]
  rw [← auxiliaryDyadicHalfWave_eq_mss]

private theorem auxiliaryDyadicHalfWaveTimeDerivative_integrable_norm_pow_four_prod_of_gain
    (C : lpCutoffs 2) {rho : Real}
    (hgain : Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 rho)
    (j : Nat) (hj : 1 ≤ j) (f : BRRSSchwartz 2) :
    Integrable (fun p : Real × BRRSSpace 2 =>
      ‖auxiliaryDyadicHalfWaveTimeDerivative C j p.1 f p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
  let g : BRRSSchwartz 2 :=
    Auto.Spherical.MSS.circleEndpointTimeDerivativeInput C .plus j f
  let a : Complex := (((2 : Real) ^ j : Real) : Complex)
  have hg := auxiliaryDyadicHalfWave_integrable_norm_pow_four_prod_of_gain
    C hgain j hj g
  have hscaled : Integrable (fun p : Real × BRRSSpace 2 =>
      ‖a‖ ^ 4 * ‖dyadicHalfWave C j p.1 g p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) :=
    hg.const_mul (‖a‖ ^ 4)
  change Integrable (fun p : Real × BRRSSpace 2 =>
      ‖a * dyadicHalfWave C j p.1 g p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume)
  refine hscaled.congr ?_
  filter_upwards with p
  rw [norm_mul, mul_pow]

/-- The fixed-time `L²` endpoint from MSS, transported to the BRRS auxiliary
dyadic half-wave. -/
theorem auxiliaryDyadicHalfWave_l2Endpoint (C : lpCutoffs 2) (j : Nat)
    (t : Real) (f : BRRSSchwartz 2) :
    (∫ x : BRRSSpace 2, ‖dyadicHalfWave C j t f x‖ ^ 2) ≤
      4 * ∫ x : BRRSSpace 2, ‖f x‖ ^ 2 := by
  simpa only [auxiliaryDyadicHalfWave_eq_mss] using
    Auto.Spherical.MSS.l2Endpoint C .plus j t f

/-- Summing the fixed-time MSS endpoint over an arbitrary finite collection
of times.  No separation or interval hypothesis is needed for this elementary
energy estimate; such information enters only when bounding `T.card`. -/
theorem auxiliaryDyadicHalfWave_l2Sum_le_card (C : lpCutoffs 2) (j : Nat)
    (T : Finset Real) (f : BRRSSchwartz 2) :
    (∑ t ∈ T, ∫ x : BRRSSpace 2, ‖dyadicHalfWave C j t f x‖ ^ 2) ≤
      4 * (T.card : Real) * ∫ x : BRRSSpace 2, ‖f x‖ ^ 2 := by
  calc
    (∑ t ∈ T, ∫ x : BRRSSpace 2, ‖dyadicHalfWave C j t f x‖ ^ 2) ≤
        ∑ _t ∈ T, 4 * ∫ x : BRRSSpace 2, ‖f x‖ ^ 2 := by
      apply Finset.sum_le_sum
      intro t _ht
      exact auxiliaryDyadicHalfWave_l2Endpoint C j t f
    _ = 4 * (T.card : Real) * ∫ x : BRRSSpace 2, ‖f x‖ ^ 2 := by
      simp only [Finset.sum_const, nsmul_eq_mul]
      ring

/-- A finite BRRS dyadic discretization has a genuine planar auxiliary
`L²` energy bound at every upper Minkowski covering exponent.  This combines
the fixed-time MSS endpoint with the preceding entropy--cardinality bridge;
it is deliberately stated for the existing Littlewood--Paley cutoff rather
than claiming the arbitrary-cutoff BRRS theorem. -/
theorem auxiliaryDyadicHalfWave_l2Sum_le_of_hasUpperMinkowskiExponent
    (C : lpCutoffs 2) {E : Set Real} {beta : Real}
    (hM : Auto.FractalDimensions.HasUpperMinkowskiExponent E beta) :
    ∀ epsilon : Real, 0 < epsilon → ∃ K : Real, 0 < K ∧
      ∀ j : Nat, 1 ≤ j → ∀ T : Finset Real,
        IsDyadicDiscretization E j T → ∀ f : BRRSSchwartz 2,
          (∑ t ∈ T, ∫ x : BRRSSpace 2,
            ‖dyadicHalfWave C j t f x‖ ^ 2) ≤
              K * (dyadicTimeScale j / 2) ^ (-(beta + epsilon)) *
                ∫ x : BRRSSpace 2, ‖f x‖ ^ 2 := by
  intro epsilon hepsilon
  obtain ⟨A, hA, hcard⟩ :=
    dyadicDiscretization_card_le_of_hasUpperMinkowskiExponent hM epsilon hepsilon
  refine ⟨4 * A, mul_pos (by norm_num) hA, ?_⟩
  intro j hj T hT f
  have hsum := auxiliaryDyadicHalfWave_l2Sum_le_card C j T f
  have hTcard := hcard j hj T hT
  have hinput : 0 ≤ ∫ x : BRRSSpace 2, ‖f x‖ ^ 2 :=
    integral_nonneg fun _ => sq_nonneg _
  calc
    (∑ t ∈ T, ∫ x : BRRSSpace 2, ‖dyadicHalfWave C j t f x‖ ^ 2) ≤
        4 * (T.card : Real) * ∫ x : BRRSSpace 2, ‖f x‖ ^ 2 := hsum
    _ = 4 * ((T.card : Real) * ∫ x : BRRSSpace 2, ‖f x‖ ^ 2) := by ring
    _ ≤ 4 * ((A * (dyadicTimeScale j / 2) ^ (-(beta + epsilon))) *
        ∫ x : BRRSSpace 2, ‖f x‖ ^ 2) := by
      gcongr
    _ = (4 * A) * (dyadicTimeScale j / 2) ^ (-(beta + epsilon)) *
        ∫ x : BRRSSpace 2, ‖f x‖ ^ 2 := by ring

/-- The already-proved planar MSS theorem, stated in the BRRS auxiliary
half-wave notation.  This is a continuous-time estimate on `[1,2]`; it does
not assert the fractal discrete-time estimate of BRRS Theorem 1.1. -/
theorem mssLocalSmoothing_auxiliaryDyadicHalfWave (C : lpCutoffs 2)
    {p eta : Real} (hp : 2 < p) (heta : 0 < eta) :
    2 < p ∧ 0 < eta ∧ ∃ K : Real, 0 < K ∧
      ∀ j : Nat, 1 ≤ j → ∀ f : BRRSSchwartz 2,
        eLpNorm (auxiliaryDyadicHalfWaveSpaceTime C j f) (ENNReal.ofReal p)
            Auto.Spherical.MSS.localSmoothingMeasure ≤
          ENNReal.ofReal (K * (2 : Real) ^
            ((j : Real) * (1 / 2 - 1 / p - Auto.Spherical.MSS.mssGain p + eta))) *
            eLpNorm (f : BRRSSpace 2 → Complex) (ENNReal.ofReal p) volume := by
  rcases Auto.Spherical.MSS.localSmoothing_of_lpCutoffs C hp heta with
    ⟨hp', heta', K, hK, hbound⟩
  refine ⟨hp', heta', K, hK, ?_⟩
  intro j hj f
  simpa only [auxiliaryDyadicHalfWaveSpaceTime_eq_mss] using
    hbound j hj f Auto.Spherical.MSS.WaveSign.plus

/-- The BRRS and MSS notations use the same dyadic temporal mesh. -/
theorem brrsDyadicTimeScale_eq_mss (j : Nat) :
    dyadicTimeScale j = Auto.Spherical.MSS.dyadicTimeScale j := by
  unfold dyadicTimeScale Auto.Spherical.MSS.dyadicTimeScale
  rw [zpow_neg, zpow_natCast]

/-- For the full interval `[1,2]`, a BRRS maximal discretization has the
finite-cover formulation of maximal separation used by MSS.  This is only a
comparison of discretization conventions; it does not turn continuous local
smoothing into the discrete fractal estimate. -/
theorem mssMaximalSeparated_of_brrsDyadicDiscretization (j : Nat)
    (T : Finset Real)
    (hT : IsDyadicDiscretization (Icc (1 : Real) 2) j T) :
    Auto.Spherical.MSS.MaximalSeparated j T := by
  rw [Auto.Spherical.MSS.MaximalSeparated, ← brrsDyadicTimeScale_eq_mss]
  rcases hT with ⟨hsubset, hseparated, hmaximal⟩
  refine ⟨?_, ?_, ?_⟩
  · intro t ht
    exact hsubset ht
  · intro s hs u hu hsu
    exact hseparated (by simpa using hs) (by simpa using hu) hsu
  · intro t ht
    by_contra hcover
    have hfar : ∀ s : Real, s ∈ T → dyadicTimeScale j ≤ |t - s| := by
      intro s hs
      apply le_of_not_gt
      intro hlt
      exact hcover ⟨s, hs, hlt⟩
    by_cases htT : t ∈ T
    · apply hcover
      refine ⟨t, htT, ?_⟩
      have hdelta : 0 < dyadicTimeScale j := by
        unfold dyadicTimeScale
        exact inv_pos.mpr (pow_pos (by norm_num) _)
      simpa using hdelta
    · let U : Set Real := (↑T : Set Real) ∪ {t}
      have hUsubset : U ⊆ Icc (1 : Real) 2 := by
        intro x hx
        simp only [U, mem_union, mem_singleton_iff] at hx
        rcases hx with hxT | rfl
        · exact hsubset hxT
        · exact ht
      have hUseparated : IsSeparatedSet U (dyadicTimeScale j) := by
        intro s hs u hu hsu
        simp only [U, mem_union, mem_singleton_iff] at hs hu
        rcases hs with hsT | rfl
        · rcases hu with huT | rfl
          · exact hseparated hsT huT hsu
          · simpa only [abs_sub_comm] using hfar s hsT
        · rcases hu with huT | rfl
          · exact hfar u huT
          · exact (hsu rfl).elim
      have hTsubU : (↑T : Set Real) ⊆ U := by
        intro x hx
        simp only [U, mem_union]
        exact Or.inl hx
      have hUsubT : U ⊆ (↑T : Set Real) :=
        hmaximal U hUsubset hUseparated hTsubU
      apply htT
      apply hUsubT
      simp [U]

/-- The existing separated-time `L²` sampling argument gives a concrete
baseline for the auxiliary planar BRRS half-wave on the full time interval.
Its reciprocal-mesh loss is explicit, so this lemma is not the fractal
local-smoothing gain of BRRS Theorem 1.1. -/
theorem auxiliaryDyadicHalfWave_separatedSamplingL2
    (C : lpCutoffs 2) (j : Nat) (T : Finset Real)
    (hT : IsDyadicDiscretization (Icc (1 : Real) 2) j T)
    (f : BRRSSchwartz 2) :
    (∑ t ∈ T, ∫ x : BRRSSpace 2, ‖dyadicHalfWave C j t f x‖ ^ 2) ≤
      16 * (dyadicTimeScale j)⁻¹ * ∫ x : BRRSSpace 2, ‖f x‖ ^ 2 := by
  have hMSS : Auto.Spherical.MSS.MaximalSeparated j T :=
    mssMaximalSeparated_of_brrsDyadicDiscretization j T hT
  have h := Auto.Spherical.MSS.aux_dyadicHalfWave_separatedSamplingL2
    C Auto.Spherical.MSS.WaveSign.plus j T hMSS f
  simpa only [auxiliaryDyadicHalfWave_eq_mss,
    ← brrsDyadicTimeScale_eq_mss] using h

/-- A literal fourth-moment separated-time estimate for the planar BRRS
auxiliary half-wave.  The second term is the genuine time-derivative output;
the preceding Fourier identity identifies it with one uniformly bounded
annular multiplier applied to the input, times the dyadic frequency. -/
theorem auxiliaryDyadicHalfWave_separatedSamplingFour
    (C : lpCutoffs 2) {rho : Real}
    (hgain : Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 rho)
    (j : Nat) (hj : 1 ≤ j) (T : Finset Real)
    (hT : IsDyadicDiscretization (Icc (1 : Real) 2) j T)
    (f : BRRSSchwartz 2) :
    (∑ t ∈ T, ∫ x : BRRSSpace 2, ‖dyadicHalfWave C j t f x‖ ^ 4) ≤
      16 * (dyadicTimeScale j)⁻¹ *
          (∫ t in (1 : Real)..2, ∫ x : BRRSSpace 2, ‖dyadicHalfWave C j t f x‖ ^ 4) +
        8 * (dyadicTimeScale j) ^ 3 *
          (∫ t in (1 : Real)..2, ∫ x : BRRSSpace 2,
            ‖auxiliaryDyadicHalfWaveTimeDerivative C j t f x‖ ^ 4) := by
  rcases auxiliaryDyadicHalfWave_continuous_and_hasDerivAt C j f with
    ⟨hcont, hderivcont, hderiv⟩
  have hMSS : Auto.Spherical.MSS.MaximalSeparated j T :=
    mssMaximalSeparated_of_brrsDyadicDiscretization j T hT
  have hsample := timeSamplingFour_spacetime_of_MSS_MaximalSeparated
    (F := fun t x => dyadicHalfWave C j t f x)
    (F' := fun t x => auxiliaryDyadicHalfWaveTimeDerivative C j t f x)
    j T hMSS
    (by
      intro x
      have htx : Continuous ((fun t : Real => (t, x)) : Real → Real × BRRSSpace 2) :=
        continuous_id.prodMk continuous_const
      change Continuous
        ((Function.uncurry (fun t x => dyadicHalfWave C j t f x)) ∘ fun t : Real => (t, x))
      exact hcont.comp htx)
    (by
      intro x
      have htx : Continuous ((fun t : Real => (t, x)) : Real → Real × BRRSSpace 2) :=
        continuous_id.prodMk continuous_const
      change Continuous
        ((Function.uncurry (fun t x => auxiliaryDyadicHalfWaveTimeDerivative C j t f x)) ∘
          fun t : Real => (t, x))
      exact hderivcont.comp htx)
    (by
      intro x t
      exact hderiv t x)
    (by
      intro t _
      exact auxiliaryDyadicHalfWave_integrable_norm_pow_four C j t f)
    (auxiliaryDyadicHalfWave_integrable_norm_pow_four_prod_of_gain C hgain j hj f)
    (auxiliaryDyadicHalfWaveTimeDerivative_integrable_norm_pow_four_prod_of_gain
      C hgain j hj f)
  simpa only [← brrsDyadicTimeScale_eq_mss] using hsample

private theorem auxiliaryDyadicHalfWaveTimeDerivative_intervalIntegral_norm_pow_four
    (C : lpCutoffs 2) (j : Nat) (f : BRRSSchwartz 2) :
    (∫ t in (1 : Real)..2, ∫ x : BRRSSpace 2,
      ‖auxiliaryDyadicHalfWaveTimeDerivative C j t f x‖ ^ 4) =
      ((2 : Real) ^ j) ^ 4 *
        (∫ t in (1 : Real)..2, ∫ x : BRRSSpace 2,
          ‖dyadicHalfWave C j t
            (Auto.Spherical.MSS.circleEndpointTimeDerivativeInput C .plus j f) x‖ ^ 4) := by
  let g : BRRSSchwartz 2 :=
    Auto.Spherical.MSS.circleEndpointTimeDerivativeInput C .plus j f
  let q : Real := (2 : Real) ^ j
  have hq : 0 ≤ q := by
    dsimp [q]
    positivity
  have hpoint (t : Real) :
      (∫ x : BRRSSpace 2, ‖auxiliaryDyadicHalfWaveTimeDerivative C j t f x‖ ^ 4) =
        q ^ 4 * ∫ x : BRRSSpace 2, ‖dyadicHalfWave C j t g x‖ ^ 4 := by
    rw [← MeasureTheory.integral_const_mul]
    apply integral_congr_ae
    filter_upwards with x
    simp only [auxiliaryDyadicHalfWaveTimeDerivative, g, q, norm_mul, mul_pow,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hq]
  calc
    (∫ t in (1 : Real)..2, ∫ x : BRRSSpace 2,
        ‖auxiliaryDyadicHalfWaveTimeDerivative C j t f x‖ ^ 4) =
        ∫ t in (1 : Real)..2, q ^ 4 *
          (∫ x : BRRSSpace 2, ‖dyadicHalfWave C j t g x‖ ^ 4) := by
      apply intervalIntegral.integral_congr
      intro t _
      exact hpoint t
    _ = q ^ 4 * (∫ t in (1 : Real)..2, ∫ x : BRRSSpace 2,
          ‖dyadicHalfWave C j t g x‖ ^ 4) := by
      rw [intervalIntegral.integral_const_mul]
    _ = ((2 : Real) ^ j) ^ 4 *
        (∫ t in (1 : Real)..2, ∫ x : BRRSSpace 2,
          ‖dyadicHalfWave C j t
            (Auto.Spherical.MSS.circleEndpointTimeDerivativeInput C .plus j f) x‖ ^ 4) := by
      rfl

/-- The raw planar half-wave has a separated-time fourth-moment bound with
its exact dyadic factors exposed.  Here `q = 2^j`, so both displayed terms
have the same final scale `q^(2 - 4ρ)`; keeping them factored records exactly
which factor comes from temporal sampling and which from differentiation. -/
theorem exists_auxiliaryDyadicHalfWave_separatedSamplingFour_source_bound
    (C : lpCutoffs 2) {rho : Real}
    (hgain : Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 rho) :
    ∃ A B : Real, 0 < A ∧ 0 < B ∧ ∀ (j : Nat), 1 ≤ j →
      ∀ (T : Finset Real), IsDyadicDiscretization (Icc (1 : Real) 2) j T →
      ∀ f : BRRSSchwartz 2,
      (∑ t ∈ T, ∫ x : BRRSSpace 2, ‖dyadicHalfWave C j t f x‖ ^ 4) ≤
        16 * (dyadicTimeScale j)⁻¹ *
          (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) *
            ∫ x : BRRSSpace 2, ‖f x‖ ^ 4) +
        8 * (dyadicTimeScale j) ^ 3 *
          (((2 : Real) ^ j) ^ 4 *
            (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) *
              (B * ∫ x : BRRSSpace 2, ‖f x‖ ^ 4))) := by
  obtain ⟨A, hA, hWave⟩ :=
    Auto.Spherical.MSS.exists_intervalIntegral_integral_norm_pow_four_dyadicHalfWave_le_gain
      C hgain
  obtain ⟨B, hB, hInput⟩ :=
    Auto.Spherical.MSS.exists_integral_norm_pow_four_circleEndpointTimeDerivativeInput_le C
  refine ⟨A, B, hA, hB, ?_⟩
  intro j hj T hT f
  let q : Real := (2 : Real) ^ j
  let E : Real := ∫ x : BRRSSpace 2, ‖f x‖ ^ 4
  let g : BRRSSchwartz 2 :=
    Auto.Spherical.MSS.circleEndpointTimeDerivativeInput C .plus j f
  have hq : 0 ≤ q := by
    dsimp [q]
    positivity
  have hdelta : 0 < dyadicTimeScale j := by
    unfold dyadicTimeScale
    positivity
  have hFenergy :
      (∫ t in (1 : Real)..2, ∫ x : BRRSSpace 2, ‖dyadicHalfWave C j t f x‖ ^ 4) ≤
        A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) * E := by
    simpa only [q, E, auxiliaryDyadicHalfWave_eq_mss] using
      hWave j hj Auto.Spherical.MSS.WaveSign.plus f
  have hGenergy :
      (∫ t in (1 : Real)..2, ∫ x : BRRSSpace 2, ‖dyadicHalfWave C j t g x‖ ^ 4) ≤
        A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) *
          (∫ x : BRRSSpace 2, ‖g x‖ ^ 4) := by
    simpa only [q, auxiliaryDyadicHalfWave_eq_mss] using
      hWave j hj Auto.Spherical.MSS.WaveSign.plus g
  have hGsource : (∫ x : BRRSSpace 2, ‖g x‖ ^ 4) ≤ B * E := by
    simpa only [g, E] using hInput Auto.Spherical.MSS.WaveSign.plus j f
  have hcoef : 0 ≤ A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) := by
    exact mul_nonneg (pow_nonneg hA.le _) (Real.rpow_nonneg (by norm_num) _)
  have hDenergy :
      (∫ t in (1 : Real)..2, ∫ x : BRRSSpace 2,
        ‖auxiliaryDyadicHalfWaveTimeDerivative C j t f x‖ ^ 4) ≤
        q ^ 4 * (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) * (B * E)) := by
    calc
      (∫ t in (1 : Real)..2, ∫ x : BRRSSpace 2,
          ‖auxiliaryDyadicHalfWaveTimeDerivative C j t f x‖ ^ 4) =
          q ^ 4 * (∫ t in (1 : Real)..2, ∫ x : BRRSSpace 2,
            ‖dyadicHalfWave C j t g x‖ ^ 4) := by
        simpa only [q, g] using
          auxiliaryDyadicHalfWaveTimeDerivative_intervalIntegral_norm_pow_four C j f
      _ ≤ q ^ 4 *
          (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) *
            (∫ x : BRRSSpace 2, ‖g x‖ ^ 4)) :=
        mul_le_mul_of_nonneg_left hGenergy (pow_nonneg hq _)
      _ ≤ q ^ 4 * (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) * (B * E)) :=
        mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_left hGsource hcoef) (pow_nonneg hq _)
  have hsample := auxiliaryDyadicHalfWave_separatedSamplingFour C hgain j hj T hT f
  calc
    (∑ t ∈ T, ∫ x : BRRSSpace 2, ‖dyadicHalfWave C j t f x‖ ^ 4) ≤
        16 * (dyadicTimeScale j)⁻¹ *
            (∫ t in (1 : Real)..2, ∫ x : BRRSSpace 2, ‖dyadicHalfWave C j t f x‖ ^ 4) +
          8 * (dyadicTimeScale j) ^ 3 *
            (∫ t in (1 : Real)..2, ∫ x : BRRSSpace 2,
              ‖auxiliaryDyadicHalfWaveTimeDerivative C j t f x‖ ^ 4) := hsample
    _ ≤ 16 * (dyadicTimeScale j)⁻¹ *
          (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) * E) +
        8 * (dyadicTimeScale j) ^ 3 *
          (q ^ 4 * (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) * (B * E))) := by
      apply add_le_add
      · exact mul_le_mul_of_nonneg_left hFenergy
          (mul_nonneg (by norm_num) (inv_nonneg.mpr hdelta.le))
      · exact mul_le_mul_of_nonneg_left hDenergy
          (mul_nonneg (by norm_num) (pow_nonneg hdelta.le _))
    _ = 16 * (dyadicTimeScale j)⁻¹ *
          (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) * E) +
        8 * (dyadicTimeScale j) ^ 3 *
          (((2 : Real) ^ j) ^ 4 *
            (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) * (B * E))) := by
      rfl

private theorem auxiliaryDyadicHalfWave_separatedSamplingFour_factorization
    (A B rho E : Real) (j : Nat) :
    16 * (dyadicTimeScale j)⁻¹ *
        (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) * E) +
      8 * (dyadicTimeScale j) ^ 3 *
        (((2 : Real) ^ j) ^ 4 *
          (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) * (B * E))) =
      (16 * A ^ 4 + 8 * A ^ 4 * B) *
        (2 : Real) ^ ((j : Real) * (2 - 4 * rho)) * E := by
  let q : Real := (2 : Real) ^ j
  have hqpos : 0 < q := by
    dsimp [q]
    positivity
  have hqne : q ≠ 0 := hqpos.ne'
  have hdelta_inv : (dyadicTimeScale j)⁻¹ = q := by
    dsimp [dyadicTimeScale, q]
    exact inv_inv _
  have hdelta_cube : (dyadicTimeScale j) ^ 3 * q ^ 4 = q := by
    change (q⁻¹) ^ 3 * q ^ 4 = q
    field_simp [hqne]
  have hq_scale : q * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) =
      (2 : Real) ^ ((j : Real) * (2 - 4 * rho)) := by
    rw [show q = (2 : Real) ^ (j : Real) by
      dsimp [q]
      exact (Real.rpow_natCast _ j).symm,
      ← Real.rpow_add (by norm_num : (0 : Real) < 2)]
    congr 1
    ring
  rw [hdelta_inv]
  calc
    16 * q * (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) * E) +
        8 * (dyadicTimeScale j) ^ 3 *
          (q ^ 4 *
            (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) * (B * E))) =
        16 * q * (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) * E) +
          8 * ((dyadicTimeScale j) ^ 3 * q ^ 4) *
            (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) * (B * E)) := by
      ring
    _ = 16 * q * (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) * E) +
          8 * q *
            (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) * (B * E)) := by
      rw [hdelta_cube]
    _ = (16 * A ^ 4 + 8 * A ^ 4 * B) *
          (q * (2 : Real) ^ ((j : Real) * (1 - 4 * rho))) * E := by
      ring
    _ = (16 * A ^ 4 + 8 * A ^ 4 * B) *
          (2 : Real) ^ ((j : Real) * (2 - 4 * rho)) * E := by
      rw [hq_scale]

/-- Clean dyadic-rate form of the planar separated-time fourth-moment bound.
For the raw dyadic half-wave the fourth moment grows like
`2^(j * (2 - 4ρ))`, equivalently the `ell⁴(L⁴)` norm grows like
`2^(j * (1 / 2 - ρ))`. -/
theorem exists_auxiliaryDyadicHalfWave_separatedSamplingFour_rate
    (C : lpCutoffs 2) {rho : Real}
    (hgain : Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 rho) :
    ∃ K : Real, 0 < K ∧ ∀ (j : Nat), 1 ≤ j →
      ∀ (T : Finset Real), IsDyadicDiscretization (Icc (1 : Real) 2) j T →
      ∀ f : BRRSSchwartz 2,
      (∑ t ∈ T, ∫ x : BRRSSpace 2, ‖dyadicHalfWave C j t f x‖ ^ 4) ≤
        K * (2 : Real) ^ ((j : Real) * (2 - 4 * rho)) *
          ∫ x : BRRSSpace 2, ‖f x‖ ^ 4 := by
  obtain ⟨A, B, hA, hB, hsource⟩ :=
    exists_auxiliaryDyadicHalfWave_separatedSamplingFour_source_bound C hgain
  refine ⟨16 * A ^ 4 + 8 * A ^ 4 * B, ?_, ?_⟩
  · positivity
  · intro j hj T hT f
    have h := hsource j hj T hT f
    calc
      (∑ t ∈ T, ∫ x : BRRSSpace 2, ‖dyadicHalfWave C j t f x‖ ^ 4) ≤
          16 * (dyadicTimeScale j)⁻¹ *
            (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) *
              ∫ x : BRRSSpace 2, ‖f x‖ ^ 4) +
          8 * (dyadicTimeScale j) ^ 3 *
            (((2 : Real) ^ j) ^ 4 *
              (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) *
                (B * ∫ x : BRRSSpace 2, ‖f x‖ ^ 4))) := h
      _ = (16 * A ^ 4 + 8 * A ^ 4 * B) *
            (2 : Real) ^ ((j : Real) * (2 - 4 * rho)) *
              ∫ x : BRRSSpace 2, ‖f x‖ ^ 4 :=
        auxiliaryDyadicHalfWave_separatedSamplingFour_factorization A B rho
          (∫ x : BRRSSpace 2, ‖f x‖ ^ 4) j

/-- The literal scaled annular multiplier `φ(2⁻ʲ |η|)` from BRRS.

Mathlib's Fourier variable is `xi = η / (2 π)`, so the source-frequency
argument is `2 π * 2⁻ʲ * ‖xi‖`. -/
def brrsFrequencyScale (j : Nat) : Real :=
  2 * Real.pi * ((2 : Real) ^ j)⁻¹

/-- The literal BRRS frequency scale is positive at every dyadic level. -/
theorem brrsFrequencyScale_pos (j : Nat) : 0 < brrsFrequencyScale j := by
  unfold brrsFrequencyScale
  positivity

def brrsDyadicMultiplier {d : Nat} (Φ : BRRSAnnularCutoff) (j : Nat)
    (xi : BRRSSpace d) : Complex :=
  Φ.symbol (2 * Real.pi * ((2 : Real) ^ j)⁻¹ * ‖xi‖)

/-- The frequency-scale form of the literal BRRS annular multiplier. -/
theorem brrsDyadicMultiplier_apply {d : Nat} (Φ : BRRSAnnularCutoff) (j : Nat)
    (xi : BRRSSpace d) :
    brrsDyadicMultiplier Φ j xi = Φ.symbol (brrsFrequencyScale j * ‖xi‖) :=
  rfl

/-- The literal annular multiplier vanishes whenever its radial argument is
outside the prescribed annular support. -/
theorem brrsDyadicMultiplier_eq_zero_of_not_mem {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (xi : BRRSSpace d)
    (hxi : brrsFrequencyScale j * ‖xi‖ ∉ Ioo (1 / 4 : Real) 4) :
    brrsDyadicMultiplier Φ j xi = 0 := by
  rw [brrsDyadicMultiplier_apply]
  by_contra hnonzero
  apply hxi
  apply Φ.tsupport_subset
  exact subset_tsupport _ (Function.mem_support.mpr hnonzero)

/-- The annular cutoff removes a neighborhood of the frequency origin. -/
theorem brrsDyadicMultiplier_eq_zero_of_norm_lt {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (xi : BRRSSpace d)
    (hxi : ‖xi‖ < (4 * brrsFrequencyScale j)⁻¹) :
    brrsDyadicMultiplier Φ j xi = 0 := by
  apply brrsDyadicMultiplier_eq_zero_of_not_mem
  intro hmem
  have hscale : 0 < brrsFrequencyScale j := brrsFrequencyScale_pos j
  have hscaled : brrsFrequencyScale j * ‖xi‖ < 1 / 4 := by
    calc
      brrsFrequencyScale j * ‖xi‖ <
          brrsFrequencyScale j * (4 * brrsFrequencyScale j)⁻¹ :=
        mul_lt_mul_of_pos_left hxi hscale
      _ = 1 / 4 := by
        field_simp [ne_of_gt hscale]
  exact (not_lt_of_ge hscaled.le) hmem.1

/-- The annular cutoff also vanishes beyond its outer frequency radius. -/
theorem brrsDyadicMultiplier_eq_zero_of_le_norm {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (xi : BRRSSpace d)
    (hxi : 4 * (brrsFrequencyScale j)⁻¹ ≤ ‖xi‖) :
    brrsDyadicMultiplier Φ j xi = 0 := by
  apply brrsDyadicMultiplier_eq_zero_of_not_mem
  intro hmem
  have hscale : 0 < brrsFrequencyScale j := brrsFrequencyScale_pos j
  have hscaled : 4 ≤ brrsFrequencyScale j * ‖xi‖ := by
    calc
      4 = brrsFrequencyScale j * (4 * (brrsFrequencyScale j)⁻¹) := by
        field_simp [ne_of_gt hscale]
      _ ≤ brrsFrequencyScale j * ‖xi‖ :=
        mul_le_mul_of_nonneg_left hxi hscale.le
  exact (not_lt_of_ge hscaled) hmem.2

/-- The literal BRRS annular multiplier is identically zero on a
neighborhood of frequency zero. -/
theorem brrsDyadicMultiplier_eventuallyEq_zero_at_zero {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) :
    brrsDyadicMultiplier (d := d) Φ j =ᶠ[nhds 0] fun _ => 0 := by
  have hscale : 0 < brrsFrequencyScale j := brrsFrequencyScale_pos j
  have hε : 0 < (4 * brrsFrequencyScale j)⁻¹ :=
    inv_pos.mpr (mul_pos (by norm_num) hscale)
  filter_upwards [Metric.ball_mem_nhds (0 : BRRSSpace d) hε] with xi hxi
  have hnorm : ‖xi‖ < (4 * brrsFrequencyScale j)⁻¹ := by
    simpa only [Metric.mem_ball, dist_zero_right] using hxi
  exact brrsDyadicMultiplier_eq_zero_of_norm_lt Φ j xi hnorm

/-- The apparent nonsmoothness of `‖xi‖` at the origin is removable after
the annular cutoff: the literal BRRS multiplier is globally smooth. -/
theorem contDiff_brrsDyadicMultiplier {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) :
    ContDiff Real (⊤ : ℕ∞) (brrsDyadicMultiplier (d := d) Φ j) := by
  rw [contDiff_iff_contDiffAt]
  intro xi
  by_cases hxi : xi = 0
  · subst xi
    exact (contDiffAt_const (c := (0 : Complex))).congr_of_eventuallyEq
      (brrsDyadicMultiplier_eventuallyEq_zero_at_zero Φ j)
  · unfold brrsDyadicMultiplier
    refine (Φ.symbol.smooth (⊤ : ℕ∞)).contDiffAt.comp xi ?_
    have hnorm : ContDiffAt Real (⊤ : ℕ∞)
        (fun eta : BRRSSpace d => ‖eta‖) xi :=
      contDiffAt_norm Real hxi
    have hconst : ContDiffAt Real (⊤ : ℕ∞)
        (fun _ : BRRSSpace d => 2 * Real.pi * ((2 : Real) ^ j)⁻¹) xi :=
      contDiffAt_const
    exact hconst.mul hnorm

/-- The literal annular multiplier is compactly supported in frequency. -/
theorem hasCompactSupport_brrsDyadicMultiplier {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) :
    HasCompactSupport (brrsDyadicMultiplier (d := d) Φ j) := by
  apply HasCompactSupport.intro
    (isCompact_closedBall (0 : BRRSSpace d) (4 * (brrsFrequencyScale j)⁻¹))
  intro xi hxi
  have hnorm : 4 * (brrsFrequencyScale j)⁻¹ ≤ ‖xi‖ := by
    rw [Metric.mem_closedBall, dist_zero_right] at hxi
    exact le_of_not_ge hxi
  exact brrsDyadicMultiplier_eq_zero_of_le_norm Φ j xi hnorm

/-- The literal BRRS annular multiplier packaged as a Schwartz frequency
symbol.  The preceding smoothness and compact-support lemmas make this a
genuine conversion, rather than an additional hypothesis on the cutoff. -/
noncomputable def brrsDyadicMultiplierSchwartz {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) : BRRSSchwartz d :=
  (hasCompactSupport_brrsDyadicMultiplier Φ j).toSchwartzMap
    (contDiff_brrsDyadicMultiplier Φ j)

/-- Evaluation of the packaged literal annular multiplier. -/
theorem brrsDyadicMultiplierSchwartz_apply {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (xi : BRRSSpace d) :
    brrsDyadicMultiplierSchwartz Φ j xi = brrsDyadicMultiplier Φ j xi :=
  rfl

/-- A uniform pointwise bound for the packaged BRRS multiplier, expressed by
the zeroth Schwartz seminorm of the one-dimensional cutoff. -/
theorem norm_brrsDyadicMultiplierSchwartz_le {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (xi : BRRSSpace d) :
    ‖brrsDyadicMultiplierSchwartz Φ j xi‖ ≤
      SchwartzMap.seminorm Complex 0 0 Φ.symbol := by
  rw [brrsDyadicMultiplierSchwartz_apply, brrsDyadicMultiplier_apply]
  exact SchwartzMap.norm_le_seminorm Complex Φ.symbol _

/-- Every literal BRRS annular multiplier is radial in its frequency
variable. -/
theorem brrsDyadicMultiplier_isRadial {d : Nat} (Φ : BRRSAnnularCutoff)
    (j : Nat) : IsRadial (brrsDyadicMultiplier (d := d) Φ j) := by
  intro xi eta hnorm
  unfold brrsDyadicMultiplier
  rw [hnorm]

/-- The annular BRRS multiplier is consequently invariant under orthogonal
frequency changes of coordinates. -/
theorem brrsDyadicMultiplier_orthogonallyInvariant {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) :
    IsOrthogonallyInvariant (brrsDyadicMultiplier (d := d) Φ j) :=
  (brrsDyadicMultiplier_isRadial Φ j).orthogonallyInvariant

/-- The Fourier-defined annular projection `P_j` used in BRRS Theorem 1.1. -/
def brrsDyadicProjection {d : Nat} (Φ : BRRSAnnularCutoff) (j : Nat)
    (f : BRRSSchwartz d) : BRRSSpace d → Complex :=
  fun x => 𝓕⁻ (fun xi : BRRSSpace d =>
    brrsDyadicMultiplier Φ j xi * 𝓕 (f : BRRSSpace d → Complex) xi) x

/-- The literal Fourier realization of `e^{it√{-Δ}} P_j` for the annular
cutoff fixed in BRRS. -/
def brrsDyadicHalfWave {d : Nat} (Φ : BRRSAnnularCutoff) (j : Nat)
    (t : Real) (f : BRRSSchwartz d) : BRRSSpace d → Complex :=
  fun x => 𝓕⁻ (fun xi : BRRSSpace d =>
    halfWaveMultiplier t xi * brrsDyadicMultiplier Φ j xi *
      𝓕 (f : BRRSSpace d → Complex) xi) x

/-- The frequency symbol of the literal BRRS annular half-wave. -/
def brrsDyadicHalfWaveSymbol {d : Nat} (Φ : BRRSAnnularCutoff) (j : Nat)
    (t : Real) : BRRSSpace d → Complex :=
  fun xi => halfWaveMultiplier t xi * brrsDyadicMultiplier Φ j xi

/-- Annular localization removes the nonsmooth frequency origin from the
literal half-wave symbol. -/
theorem brrsDyadicHalfWaveSymbol_eventuallyEq_zero_at_zero {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) :
    brrsDyadicHalfWaveSymbol (d := d) Φ j t =ᶠ[nhds 0] fun _ => 0 := by
  filter_upwards [brrsDyadicMultiplier_eventuallyEq_zero_at_zero Φ j] with xi hxi
  simp [brrsDyadicHalfWaveSymbol, hxi]

/-- The annular half-wave symbol is globally smooth. -/
theorem contDiff_brrsDyadicHalfWaveSymbol {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) :
    ContDiff Real (⊤ : ℕ∞) (brrsDyadicHalfWaveSymbol (d := d) Φ j t) := by
  rw [contDiff_iff_contDiffAt]
  intro xi
  by_cases hxi : xi = 0
  · subst xi
    exact (contDiffAt_const (c := (0 : Complex))).congr_of_eventuallyEq
      (brrsDyadicHalfWaveSymbol_eventuallyEq_zero_at_zero Φ j t)
  · unfold brrsDyadicHalfWaveSymbol
    exact (halfWaveMultiplier_contDiffAt_of_ne_zero t hxi).mul
      (contDiff_brrsDyadicMultiplier Φ j).contDiffAt

/-- The annular half-wave symbol has the same compact frequency support as
its annular factor. -/
theorem hasCompactSupport_brrsDyadicHalfWaveSymbol {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) :
    HasCompactSupport (brrsDyadicHalfWaveSymbol (d := d) Φ j t) := by
  apply HasCompactSupport.intro
    (isCompact_closedBall (0 : BRRSSpace d) (4 * (brrsFrequencyScale j)⁻¹))
  intro xi hxi
  have hnorm : 4 * (brrsFrequencyScale j)⁻¹ ≤ ‖xi‖ := by
    rw [Metric.mem_closedBall, dist_zero_right] at hxi
    exact le_of_not_ge hxi
  rw [brrsDyadicHalfWaveSymbol,
    brrsDyadicMultiplier_eq_zero_of_le_norm Φ j xi hnorm, mul_zero]

/-- The literal annular half-wave symbol packaged as a Schwartz multiplier. -/
noncomputable def brrsDyadicHalfWaveSchwartzSymbol {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) : BRRSSchwartz d :=
  (hasCompactSupport_brrsDyadicHalfWaveSymbol Φ j t).toSchwartzMap
    (contDiff_brrsDyadicHalfWaveSymbol Φ j t)

/-- Evaluation of the packaged literal annular half-wave symbol. -/
theorem brrsDyadicHalfWaveSchwartzSymbol_apply {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) (xi : BRRSSpace d) :
    brrsDyadicHalfWaveSchwartzSymbol Φ j t xi =
      brrsDyadicHalfWaveSymbol Φ j t xi :=
  rfl

/-- On Schwartz inputs, the literal BRRS annular half-wave is convolution by
the inverse Fourier transform of its compact smooth frequency symbol.  This
is the concrete core from which an `L^p` realization must be extended. -/
theorem brrsDyadicHalfWave_eq_convolution {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) (f : BRRSSchwartz d)
    (x : BRRSSpace d) :
    brrsDyadicHalfWave Φ j t f x =
      (((𝓕⁻ (brrsDyadicHalfWaveSchwartzSymbol Φ j t) : BRRSSchwartz d) :
          BRRSSpace d → Complex)
        ⋆[ContinuousLinearMap.mul Complex Complex, volume]
          (f : BRRSSpace d → Complex)) x := by
  unfold brrsDyadicHalfWave
  have hsymbol : (fun xi : BRRSSpace d =>
      halfWaveMultiplier t xi * brrsDyadicMultiplier Φ j xi *
        𝓕 (f : BRRSSpace d → Complex) xi) =
      fun xi : BRRSSpace d =>
        brrsDyadicHalfWaveSchwartzSymbol Φ j t xi *
          𝓕 (f : BRRSSpace d → Complex) xi := by
    funext xi
    rw [brrsDyadicHalfWaveSchwartzSymbol_apply,
      brrsDyadicHalfWaveSymbol]
  rw [hsymbol]
  exact Auto.Spherical.Auxiliary.fourierInv_schwartz_multiplier_eq_convolution
    (brrsDyadicHalfWaveSchwartzSymbol Φ j t) f x

/-- If the frequency-side datum propagated by the literal annular BRRS
half-wave is radial, then its inverse Fourier transform has the exact polar
surface-Fourier representation.  This is the Fourier-analytic starting point
for the radial kernel calculation; it deliberately asserts no stationary-phase
decay. -/
theorem brrsDyadicHalfWave_eq_surfaceFourier_integral_of_radialProfile
    {d : Nat} (hd : 0 < d) (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f : BRRSSchwartz d) (F : Real → Complex)
    (hprofile : ∀ xi : BRRSSpace d,
      brrsDyadicHalfWaveSymbol Φ j t xi *
        𝓕 (f : BRRSSpace d → Complex) xi = F ‖xi‖)
    (x : BRRSSpace d) :
    brrsDyadicHalfWave Φ j t f x =
      ∫ rho : Ioi (0 : Real),
        surfaceFourier d (-rho.1 • x) * F rho.1
          ∂Measure.volumeIoiPow (d - 1) := by
  let g : BRRSSchwartz d := SchwartzMap.smulLeftCLM Complex
    (brrsDyadicHalfWaveSchwartzSymbol Φ j t : BRRSSpace d → Complex) (𝓕 f)
  have hg : (g : BRRSSpace d → Complex) = fun xi : BRRSSpace d => F ‖xi‖ := by
    funext xi
    simp only [g, SchwartzMap.smulLeftCLM_apply
      (brrsDyadicHalfWaveSchwartzSymbol Φ j t).hasTemperateGrowth,
      smul_eq_mul, brrsDyadicHalfWaveSchwartzSymbol_apply,
      SchwartzMap.fourier_coe]
    exact hprofile xi
  have hint :=
    Auto.RadialFourierTransform.integrable_polar_fourierChar_mul_of_schwartz_radial
      g F (by
        intro xi
        rw [hg]) x
  have hpolar :=
    Auto.Spherical.SurfaceMeasureDecay.fourierInv_radial_eq_surfaceFourier_integral hd F x hint
  change 𝓕⁻ (fun xi : BRRSSpace d =>
    brrsDyadicHalfWaveSymbol Φ j t xi * 𝓕 (f : BRRSSchwartz d) xi) x = _
  rw [show (fun xi : BRRSSpace d =>
      brrsDyadicHalfWaveSymbol Φ j t xi * 𝓕 (f : BRRSSchwartz d) xi) =
      fun xi => F ‖xi‖ by
        funext xi
        exact hprofile xi]
  exact hpolar

/-- The radial Fourier-side profile propagated by the literal BRRS half-wave,
evaluated on an arbitrary unit frequency ray.  For a radial input the choice
of the ray is immaterial; retaining it as data avoids introducing a
noncanonical coordinate direction. -/
def brrsDyadicHalfWaveRadialFourierProfile {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) (f : BRRSSchwartz d)
    (v : BRRSSpace d) (rho : Real) : Complex :=
  brrsDyadicHalfWaveSymbol Φ j t (rho • v) *
    𝓕 (f : BRRSSpace d → Complex) (rho • v)

/-- Exact polar representation of the literal annular half-wave on a radial
Schwartz input.  This is the radial-output bridge for the later `TT*` kernel:
the only frequency datum left in the integral is the one-dimensional radial
Fourier profile above, and the angular factor is the actual `surfaceFourier`.
No stationary-phase estimate is used here. -/
theorem brrsDyadicHalfWave_eq_surfaceFourier_integral_of_isRadial
    {d : Nat} (hd : 0 < d) (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d → Complex))
    (v : BRRSSpace d) (hv : ‖v‖ = 1) (x : BRRSSpace d) :
    brrsDyadicHalfWave Φ j t f x =
      ∫ rho : Ioi (0 : Real),
        surfaceFourier d (-rho.1 • x) *
          brrsDyadicHalfWaveRadialFourierProfile Φ j t f v rho.1
          ∂Measure.volumeIoiPow (d - 1) := by
  apply brrsDyadicHalfWave_eq_surfaceFourier_integral_of_radialProfile hd Φ j t f
    (brrsDyadicHalfWaveRadialFourierProfile Φ j t f v)
  intro xi
  have hnorm : ‖xi‖ = ‖‖xi‖ • v‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _), hv, mul_one]
  have hsymbol : brrsDyadicHalfWaveSymbol Φ j t xi =
      brrsDyadicHalfWaveSymbol Φ j t (‖xi‖ • v) := by
    unfold brrsDyadicHalfWaveSymbol
    rw [halfWaveMultiplier_isRadial t xi (‖xi‖ • v) hnorm,
      brrsDyadicMultiplier_isRadial Φ j xi (‖xi‖ • v) hnorm]
  have hfourier : IsRadial (𝓕 (f : BRRSSpace d → Complex)) :=
    ((hf.orthogonallyInvariant).fourier).isRadial
  rw [brrsDyadicHalfWaveRadialFourierProfile, hsymbol,
    hfourier xi (‖xi‖ • v) hnorm]

/-- The physical-space Schwartz kernel of the frequency-localized BRRS
half-wave. -/
noncomputable def brrsDyadicHalfWaveKernel {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) : BRRSSchwartz d :=
  𝓕⁻ (brrsDyadicHalfWaveSchwartzSymbol Φ j t)

/-- The Fourier formula is convolution by the named physical kernel. -/
theorem brrsDyadicHalfWave_eq_kernel_convolution {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) (f : BRRSSchwartz d)
    (x : BRRSSpace d) :
    brrsDyadicHalfWave Φ j t f x =
      (((brrsDyadicHalfWaveKernel Φ j t : BRRSSchwartz d) :
          BRRSSpace d → Complex)
        ⋆[ContinuousLinearMap.mul Complex Complex, volume]
          (f : BRRSSpace d → Complex)) x := by
  simpa only [brrsDyadicHalfWaveKernel] using
    brrsDyadicHalfWave_eq_convolution Φ j t f x

/-! ### Exact annular half-wave `TT*` kernel

The radial local-smoothing argument uses the pair operator
`e^{it\sqrt{-\Delta}}P_j (e^{is\sqrt{-\Delta}}P_j)^*`.  This subsection
records its literal Schwartz-core realization before any kernel estimate is
made.  In particular, the time dependence is exactly the relative phase
`t - s`, and the cutoff is `Φ * conj Φ`; no reality condition on `Φ` is
silently imposed.
-/

/-- The Schwartz multiplier of the formal adjoint of one annular half-wave
piece. -/
noncomputable def brrsDyadicHalfWaveSchwartzAdjointSymbol {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (s : Real) : BRRSSchwartz d :=
  Auto.MikhlinHormander.conjugateSchwartz
    (brrsDyadicHalfWaveSchwartzSymbol Φ j s)

/-- Pointwise form of the formal adjoint multiplier. -/
theorem brrsDyadicHalfWaveSchwartzAdjointSymbol_apply {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (s : Real) (xi : BRRSSpace d) :
    brrsDyadicHalfWaveSchwartzAdjointSymbol Φ j s xi =
      starRingEnd Complex (brrsDyadicHalfWaveSymbol Φ j s xi) := by
  rw [brrsDyadicHalfWaveSchwartzAdjointSymbol,
    Auto.MikhlinHormander.conjugateSchwartz_apply,
    brrsDyadicHalfWaveSchwartzSymbol_apply]

/-- The compact Schwartz multiplier of the pair `T_t T_s^*`. -/
noncomputable def brrsDyadicHalfWaveTTStarSchwartzSymbol {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (s t : Real) : BRRSSchwartz d :=
  Auto.MikhlinHormander.multiplySchwartz
    (brrsDyadicHalfWaveSchwartzSymbol Φ j t)
    (brrsDyadicHalfWaveSchwartzAdjointSymbol Φ j s)

/-- The `TT*` symbol is the product of the forward symbol and the conjugate
of the earlier-time symbol. -/
theorem brrsDyadicHalfWaveTTStarSchwartzSymbol_apply {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (s t : Real) (xi : BRRSSpace d) :
    brrsDyadicHalfWaveTTStarSchwartzSymbol Φ j s t xi =
      brrsDyadicHalfWaveSymbol Φ j t xi *
        starRingEnd Complex (brrsDyadicHalfWaveSymbol Φ j s xi) := by
  rw [brrsDyadicHalfWaveTTStarSchwartzSymbol,
    Auto.MikhlinHormander.multiplySchwartz_apply,
    brrsDyadicHalfWaveSchwartzSymbol_apply,
    brrsDyadicHalfWaveSchwartzAdjointSymbol_apply]

/-- Complex conjugation reverses the half-wave time. -/
theorem star_halfWaveMultiplier {d : Nat} (s : Real) (xi : BRRSSpace d) :
    starRingEnd Complex (halfWaveMultiplier (d := d) s xi) =
      halfWaveMultiplier (-s) xi := by
  unfold halfWaveMultiplier
  rw [← Complex.exp_conj]
  simp only [map_mul, Complex.conj_ofReal, Complex.conj_I]
  push_cast
  congr 1
  ring

/-- The literal `TT*` multiplier has the relative half-wave phase and the
positive cutoff density `Φ * conj Φ`. -/
theorem brrsDyadicHalfWaveTTStarSchwartzSymbol_eq_relativePhase {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (s t : Real) (xi : BRRSSpace d) :
    brrsDyadicHalfWaveTTStarSchwartzSymbol Φ j s t xi =
      halfWaveMultiplier (t - s) xi * brrsDyadicMultiplier Φ j xi *
        starRingEnd Complex (brrsDyadicMultiplier Φ j xi) := by
  rw [brrsDyadicHalfWaveTTStarSchwartzSymbol_apply]
  change
    (halfWaveMultiplier t xi * brrsDyadicMultiplier Φ j xi) *
        starRingEnd Complex
          (halfWaveMultiplier s xi * brrsDyadicMultiplier Φ j xi) = _
  rw [map_mul, star_halfWaveMultiplier]
  have hphase : halfWaveMultiplier t xi * halfWaveMultiplier (-s) xi =
      halfWaveMultiplier (t - s) xi := by
    unfold halfWaveMultiplier
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  calc
    (halfWaveMultiplier t xi * brrsDyadicMultiplier Φ j xi) *
        (halfWaveMultiplier (-s) xi *
          starRingEnd Complex (brrsDyadicMultiplier Φ j xi)) =
        (halfWaveMultiplier t xi * halfWaveMultiplier (-s) xi) *
          brrsDyadicMultiplier Φ j xi *
            starRingEnd Complex (brrsDyadicMultiplier Φ j xi) := by ring
    _ = halfWaveMultiplier (t - s) xi * brrsDyadicMultiplier Φ j xi *
          starRingEnd Complex (brrsDyadicMultiplier Φ j xi) := by rw [hphase]

/-- The one-dimensional radial profile of the exact annular `TT*`
multiplier.  This definition is valid in every dimension; all dimension
dependence enters only through the polar measure and surface Fourier factor. -/
def brrsDyadicHalfWaveTTStarRadialProfile
    (Φ : BRRSAnnularCutoff) (j : Nat) (s t rho : Real) : Complex :=
  Complex.exp (((2 * Real.pi * (t - s) * rho : Real) : Complex) * Complex.I) *
    Φ.symbol (brrsFrequencyScale j * rho) *
      starRingEnd Complex (Φ.symbol (brrsFrequencyScale j * rho))

/-- The pair multiplier is exactly the norm-radial profile above. -/
theorem brrsDyadicHalfWaveTTStarSchwartzSymbol_eq_radialProfile {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (s t : Real) (xi : BRRSSpace d) :
    brrsDyadicHalfWaveTTStarSchwartzSymbol Φ j s t xi =
      brrsDyadicHalfWaveTTStarRadialProfile Φ j s t ‖xi‖ := by
  rw [brrsDyadicHalfWaveTTStarSchwartzSymbol_eq_relativePhase]
  rfl

/-- The forward annular half-wave as a complex-linear map on the Schwartz
core. -/
noncomputable def brrsDyadicHalfWaveSchwartzPiece {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) :
    BRRSSchwartz d →ₗ[Complex] BRRSSchwartz d :=
  (SchwartzMap.fourierMultiplierCLM Complex
    (brrsDyadicHalfWaveSchwartzSymbol Φ j t : BRRSSpace d → Complex)).toLinearMap

/-- The bundled Schwartz operator has exactly the original literal BRRS
half-wave formula on every Schwartz input. -/
theorem brrsDyadicHalfWaveSchwartzPiece_apply_eq_halfWave {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) (f : BRRSSchwartz d)
    (x : BRRSSpace d) :
    brrsDyadicHalfWaveSchwartzPiece Φ j t f x =
      brrsDyadicHalfWave Φ j t f x := by
  let m : BRRSSchwartz d := brrsDyadicHalfWaveSchwartzSymbol Φ j t
  have hm : (m : BRRSSpace d → Complex).HasTemperateGrowth := m.hasTemperateGrowth
  change ((SchwartzMap.fourierMultiplierCLM Complex
    (m : BRRSSpace d → Complex) f : BRRSSchwartz d) : BRRSSpace d → Complex) x = _
  rw [SchwartzMap.fourierMultiplierCLM_apply, SchwartzMap.fourierInv_coe]
  have hsymbol :
      (SchwartzMap.smulLeftCLM Complex (m : BRRSSpace d → Complex)
        (𝓕 f) : BRRSSpace d → Complex) =
      fun xi : BRRSSpace d => brrsDyadicHalfWaveSchwartzSymbol Φ j t xi *
        𝓕 (f : BRRSSpace d → Complex) xi := by
    funext xi
    simp only [SchwartzMap.smulLeftCLM_apply hm, smul_eq_mul]
    rfl
  rw [hsymbol]
  unfold brrsDyadicHalfWave
  apply congrArg (fun g : BRRSSpace d → Complex => 𝓕⁻ g x)
  funext xi
  rw [brrsDyadicHalfWaveSchwartzSymbol_apply,
    brrsDyadicHalfWaveSymbol]

/-- The literal BRRS half-wave is additive on its Schwartz core.  Keeping
this pointwise form available is what permits the smooth compact/buffer/high
source partition to be recombined after estimating its three pieces. -/
theorem brrsDyadicHalfWave_add {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f g : BRRSSchwartz d) (x : BRRSSpace d) :
    brrsDyadicHalfWave Φ j t (f + g) x =
      brrsDyadicHalfWave Φ j t f x + brrsDyadicHalfWave Φ j t g x := by
  calc
    brrsDyadicHalfWave Φ j t (f + g) x =
        brrsDyadicHalfWaveSchwartzPiece Φ j t (f + g) x :=
      (brrsDyadicHalfWaveSchwartzPiece_apply_eq_halfWave Φ j t (f + g) x).symm
    _ = (brrsDyadicHalfWaveSchwartzPiece Φ j t f +
          brrsDyadicHalfWaveSchwartzPiece Φ j t g) x :=
      congrArg (fun h : BRRSSchwartz d => h x)
        ((brrsDyadicHalfWaveSchwartzPiece Φ j t).map_add f g)
    _ = brrsDyadicHalfWave Φ j t f x + brrsDyadicHalfWave Φ j t g x := by
      change brrsDyadicHalfWaveSchwartzPiece Φ j t f x +
          brrsDyadicHalfWaveSchwartzPiece Φ j t g x = _
      rw [brrsDyadicHalfWaveSchwartzPiece_apply_eq_halfWave,
        brrsDyadicHalfWaveSchwartzPiece_apply_eq_halfWave]

/-- Exact recombination of three Schwartz source pieces under the literal
BRRS half-wave.  This is the form used by the smooth compact/buffer/high
source partition: it records the actual linear decomposition before any
norm inequality is applied. -/
theorem brrsDyadicHalfWave_eq_sum_of_eq_add_add {d : Nat}
    (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f fCompact fBuffer fHigh : BRRSSchwartz d) (x : BRRSSpace d)
    (hpartition : f = fCompact + fBuffer + fHigh) :
    brrsDyadicHalfWave Phi j t f x =
      brrsDyadicHalfWave Phi j t fCompact x +
        brrsDyadicHalfWave Phi j t fBuffer x +
          brrsDyadicHalfWave Phi j t fHigh x := by
  rw [hpartition, brrsDyadicHalfWave_add, brrsDyadicHalfWave_add]

/-- The corresponding triangle bound for a smooth compact/buffer/high
partition.  No source or output region is discarded in this recombination. -/
theorem norm_brrsDyadicHalfWave_le_sum_of_eq_add_add {d : Nat}
    (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f fCompact fBuffer fHigh : BRRSSchwartz d) (x : BRRSSpace d)
    (hpartition : f = fCompact + fBuffer + fHigh) :
    ‖brrsDyadicHalfWave Phi j t f x‖ ≤
      ‖brrsDyadicHalfWave Phi j t fCompact x‖ +
        ‖brrsDyadicHalfWave Phi j t fBuffer x‖ +
          ‖brrsDyadicHalfWave Phi j t fHigh x‖ := by
  rw [brrsDyadicHalfWave_eq_sum_of_eq_add_add Phi j t f fCompact fBuffer fHigh x
    hpartition]
  calc
    ‖brrsDyadicHalfWave Phi j t fCompact x +
        brrsDyadicHalfWave Phi j t fBuffer x +
          brrsDyadicHalfWave Phi j t fHigh x‖ ≤
        ‖brrsDyadicHalfWave Phi j t fCompact x +
          brrsDyadicHalfWave Phi j t fBuffer x‖ +
          ‖brrsDyadicHalfWave Phi j t fHigh x‖ := norm_add_le _ _
    _ ≤ ‖brrsDyadicHalfWave Phi j t fCompact x‖ +
          ‖brrsDyadicHalfWave Phi j t fBuffer x‖ +
            ‖brrsDyadicHalfWave Phi j t fHigh x‖ := by
      exact add_le_add_left
        (norm_add_le (brrsDyadicHalfWave Phi j t fCompact x)
          (brrsDyadicHalfWave Phi j t fBuffer x)) _

/-- The exact three-way source recombination is stable under every `p`-th
positive moment with `p ≥ 1`.  This is deliberately stated before integrating
in space or summing in time, so it can assemble independently proved compact,
transition, and high-source estimates without discarding a component. -/
theorem ennreal_norm_brrsDyadicHalfWave_rpow_le_three_of_partition {d : Nat}
    (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f fCompact fBuffer fHigh : BRRSSchwartz d) (x : BRRSSpace d)
    {p : Real} (hp : 1 ≤ p)
    (hpartition : f = fCompact + fBuffer + fHigh) :
    (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f x‖) ^ p ≤
      (2 : ENNReal) ^ (p - 1) *
        ((2 : ENNReal) ^ (p - 1) *
          ((ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t fCompact x‖) ^ p +
            (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t fBuffer x‖) ^ p) +
          (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t fHigh x‖) ^ p) := by
  let a : ENNReal := ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t fCompact x‖
  let b : ENNReal := ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t fBuffer x‖
  let c : ENNReal := ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t fHigh x‖
  have htri := norm_brrsDyadicHalfWave_le_sum_of_eq_add_add
    Phi j t f fCompact fBuffer fHigh x hpartition
  have hsum : ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f x‖ ≤ (a + b) + c := by
    calc
      ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f x‖ ≤
          ENNReal.ofReal
            (‖brrsDyadicHalfWave Phi j t fCompact x‖ +
              ‖brrsDyadicHalfWave Phi j t fBuffer x‖ +
                ‖brrsDyadicHalfWave Phi j t fHigh x‖) :=
        ENNReal.ofReal_le_ofReal htri
      _ = (a + b) + c := by
        dsimp only [a, b, c]
        rw [ENNReal.ofReal_add
          (add_nonneg (norm_nonneg _) (norm_nonneg _)) (norm_nonneg _),
          ENNReal.ofReal_add (norm_nonneg _) (norm_nonneg _)]
  have hp0 : 0 ≤ p := le_trans (by norm_num) hp
  calc
    (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f x‖) ^ p ≤
        ((a + b) + c) ^ p := ENNReal.rpow_le_rpow hsum hp0
    _ ≤ (2 : ENNReal) ^ (p - 1) * ((a + b) ^ p + c ^ p) :=
      ENNReal.rpow_add_le_mul_rpow_add_rpow (a + b) c hp
    _ ≤ (2 : ENNReal) ^ (p - 1) *
          ((2 : ENNReal) ^ (p - 1) * (a ^ p + b ^ p) + c ^ p) := by
      gcongr
      exact ENNReal.rpow_add_le_mul_rpow_add_rpow a b hp
    _ = (2 : ENNReal) ^ (p - 1) *
        ((2 : ENNReal) ^ (p - 1) *
          ((ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t fCompact x‖) ^ p +
            (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t fBuffer x‖) ^ p) +
          (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t fHigh x‖) ^ p) := by
      rfl

/-- Finite-time `Lᵖ` recombination for the literal smooth three-way source
partition.  This is the integrated form of the pointwise convexity estimate:
it keeps the compact, transition, and high-source output moments separate so
that independently proved estimates for the three pieces can be assembled
without replacing the actual half-wave by a scalar model. -/
theorem sum_lintegral_ennreal_norm_brrsDyadicHalfWave_rpow_le_three_of_partition
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat) (T : Finset Real)
    (f fCompact fBuffer fHigh : BRRSSchwartz d) {p : Real} (hp : 1 ≤ p)
    (hpartition : f = fCompact + fBuffer + fHigh) :
    (∑ t ∈ T, ∫⁻ x : BRRSSpace d,
      (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f x‖) ^ p) ≤
      (2 : ENNReal) ^ (p - 1) *
        ((2 : ENNReal) ^ (p - 1) *
          ((∑ t ∈ T, ∫⁻ x : BRRSSpace d,
              (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t fCompact x‖) ^ p) +
            (∑ t ∈ T, ∫⁻ x : BRRSSpace d,
              (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t fBuffer x‖) ^ p)) +
          (∑ t ∈ T, ∫⁻ x : BRRSSpace d,
            (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t fHigh x‖) ^ p)) := by
  let L : ENNReal := (2 : ENNReal) ^ (p - 1)
  let Fc : Real → BRRSSpace d → ENNReal := fun t x =>
    (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t fCompact x‖) ^ p
  let Fb : Real → BRRSSpace d → ENNReal := fun t x =>
    (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t fBuffer x‖) ^ p
  let Fh : Real → BRRSSpace d → ENNReal := fun t x =>
    (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t fHigh x‖) ^ p
  have hFc (t : Real) : Measurable (Fc t) := by
    dsimp only [Fc]
    exact ENNReal.continuous_rpow_const.measurable.comp
      (((brrsDyadicHalfWaveSchwartzPiece Phi j t fCompact).continuous.congr
        (fun x => brrsDyadicHalfWaveSchwartzPiece_apply_eq_halfWave
          Phi j t fCompact x)).norm.measurable.ennreal_ofReal)
  have hFb (t : Real) : Measurable (Fb t) := by
    dsimp only [Fb]
    exact ENNReal.continuous_rpow_const.measurable.comp
      (((brrsDyadicHalfWaveSchwartzPiece Phi j t fBuffer).continuous.congr
        (fun x => brrsDyadicHalfWaveSchwartzPiece_apply_eq_halfWave
          Phi j t fBuffer x)).norm.measurable.ennreal_ofReal)
  have hFh (t : Real) : Measurable (Fh t) := by
    dsimp only [Fh]
    exact ENNReal.continuous_rpow_const.measurable.comp
      (((brrsDyadicHalfWaveSchwartzPiece Phi j t fHigh).continuous.congr
        (fun x => brrsDyadicHalfWaveSchwartzPiece_apply_eq_halfWave
          Phi j t fHigh x)).norm.measurable.ennreal_ofReal)
  have hpoint (t : Real) (x : BRRSSpace d) :
      (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f x‖) ^ p ≤
        L * (L * (Fc t x + Fb t x) + Fh t x) := by
    simpa only [L, Fc, Fb, Fh] using
      (ennreal_norm_brrsDyadicHalfWave_rpow_le_three_of_partition
        Phi j t f fCompact fBuffer fHigh x hp hpartition)
  have hintegral (t : Real) :
      (∫⁻ x : BRRSSpace d, L * (L * (Fc t x + Fb t x) + Fh t x)) =
        L * (L * ((∫⁻ x : BRRSSpace d, Fc t x) +
          ∫⁻ x : BRRSSpace d, Fb t x) + ∫⁻ x : BRRSSpace d, Fh t x) := by
    have houterAdd :
        (∫⁻ x : BRRSSpace d, L * (Fc t x + Fb t x) + Fh t x) =
          (∫⁻ x : BRRSSpace d, L * (Fc t x + Fb t x)) +
            ∫⁻ x : BRRSSpace d, Fh t x := by
      exact lintegral_add_left
        (measurable_const.mul ((hFc t).add (hFb t))) (Fh t)
    have hinnerConst :
        (∫⁻ x : BRRSSpace d, L * (Fc t x + Fb t x)) =
          L * ∫⁻ x : BRRSSpace d, Fc t x + Fb t x := by
      exact lintegral_const_mul L ((hFc t).add (hFb t))
    have hinnerAdd :
        (∫⁻ x : BRRSSpace d, Fc t x + Fb t x) =
          (∫⁻ x : BRRSSpace d, Fc t x) + ∫⁻ x : BRRSSpace d, Fb t x := by
      exact lintegral_add_left (hFc t) (Fb t)
    calc
      (∫⁻ x : BRRSSpace d, L * (L * (Fc t x + Fb t x) + Fh t x)) =
          L * ∫⁻ x : BRRSSpace d, L * (Fc t x + Fb t x) + Fh t x :=
        lintegral_const_mul L
          ((measurable_const.mul ((hFc t).add (hFb t))).add (hFh t))
      _ = L * ((∫⁻ x : BRRSSpace d, L * (Fc t x + Fb t x)) +
          ∫⁻ x : BRRSSpace d, Fh t x) := by
        rw [houterAdd]
      _ = L * (L * ((∫⁻ x : BRRSSpace d, Fc t x) +
          ∫⁻ x : BRRSSpace d, Fb t x) + ∫⁻ x : BRRSSpace d, Fh t x) := by
        rw [hinnerConst, hinnerAdd]
  have hsum :
      (∑ t ∈ T, L *
          (L * ((∫⁻ x : BRRSSpace d, Fc t x) +
            ∫⁻ x : BRRSSpace d, Fb t x) +
            ∫⁻ x : BRRSSpace d, Fh t x)) =
        L * (L *
          ((∑ t ∈ T, ∫⁻ x : BRRSSpace d, Fc t x) +
            (∑ t ∈ T, ∫⁻ x : BRRSSpace d, Fb t x)) +
          (∑ t ∈ T, ∫⁻ x : BRRSSpace d, Fh t x)) := by
    calc
      (∑ t ∈ T, L *
          (L * ((∫⁻ x : BRRSSpace d, Fc t x) +
            ∫⁻ x : BRRSSpace d, Fb t x) +
            ∫⁻ x : BRRSSpace d, Fh t x)) =
          ∑ t ∈ T, ((L * L) * (∫⁻ x : BRRSSpace d, Fc t x) +
            ((L * L) * (∫⁻ x : BRRSSpace d, Fb t x) +
              L * ∫⁻ x : BRRSSpace d, Fh t x)) := by
            apply Finset.sum_congr rfl
            intro t ht
            ring
      _ = (L * L) * (∑ t ∈ T, ∫⁻ x : BRRSSpace d, Fc t x) +
            ((L * L) * (∑ t ∈ T, ∫⁻ x : BRRSSpace d, Fb t x) +
              L * (∑ t ∈ T, ∫⁻ x : BRRSSpace d, Fh t x)) := by
            rw [Finset.sum_add_distrib, Finset.sum_add_distrib,
              ← Finset.mul_sum, ← Finset.mul_sum, ← Finset.mul_sum]
      _ = L * (L *
          ((∑ t ∈ T, ∫⁻ x : BRRSSpace d, Fc t x) +
            (∑ t ∈ T, ∫⁻ x : BRRSSpace d, Fb t x)) +
          (∑ t ∈ T, ∫⁻ x : BRRSSpace d, Fh t x)) := by ring
  calc
    (∑ t ∈ T, ∫⁻ x : BRRSSpace d,
      (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f x‖) ^ p) ≤
        ∑ t ∈ T, ∫⁻ x : BRRSSpace d, L *
          (L * (Fc t x + Fb t x) + Fh t x) := by
          apply Finset.sum_le_sum
          intro t ht
          exact lintegral_mono (hpoint t)
    _ = ∑ t ∈ T, L *
        (L * ((∫⁻ x : BRRSSpace d, Fc t x) +
          ∫⁻ x : BRRSSpace d, Fb t x) + ∫⁻ x : BRRSSpace d, Fh t x) := by
          apply Finset.sum_congr rfl
          intro t ht
          exact hintegral t
    _ = L * (L *
        ((∑ t ∈ T, ∫⁻ x : BRRSSpace d, Fc t x) +
          (∑ t ∈ T, ∫⁻ x : BRRSSpace d, Fb t x)) +
        (∑ t ∈ T, ∫⁻ x : BRRSSpace d, Fh t x)) := hsum
    _ = (2 : ENNReal) ^ (p - 1) *
        ((2 : ENNReal) ^ (p - 1) *
          ((∑ t ∈ T, ∫⁻ x : BRRSSpace d,
              (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t fCompact x‖) ^ p) +
            (∑ t ∈ T, ∫⁻ x : BRRSSpace d,
              (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t fBuffer x‖) ^ p)) +
          (∑ t ∈ T, ∫⁻ x : BRRSSpace d,
            (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t fHigh x‖) ^ p)) := by
          rfl

/-- The formal adjoint annular half-wave on the Schwartz core. -/
noncomputable def brrsDyadicHalfWaveSchwartzAdjointPiece {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (s : Real) :
    BRRSSchwartz d →ₗ[Complex] BRRSSchwartz d :=
  (SchwartzMap.fourierMultiplierCLM Complex
    (brrsDyadicHalfWaveSchwartzAdjointSymbol Φ j s : BRRSSpace d → Complex)).toLinearMap

/-- The `TT*` pair multiplier as a complex-linear Schwartz operator. -/
noncomputable def brrsDyadicHalfWaveTTStarSchwartzPiece {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (s t : Real) :
    BRRSSchwartz d →ₗ[Complex] BRRSSchwartz d :=
  (SchwartzMap.fourierMultiplierCLM Complex
    (brrsDyadicHalfWaveTTStarSchwartzSymbol Φ j s t : BRRSSpace d → Complex)).toLinearMap

/-- The formal pair factorization is literal on Schwartz data:
`T_t T_s^*` is the multiplier with the product symbol. -/
theorem brrsDyadicHalfWaveSchwartzPiece_comp_adjoint_eq_ttstar {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (s t : Real) (f : BRRSSchwartz d) :
    brrsDyadicHalfWaveSchwartzPiece Φ j t
      (brrsDyadicHalfWaveSchwartzAdjointPiece Φ j s f) =
        brrsDyadicHalfWaveTTStarSchwartzPiece Φ j s t f := by
  let mt : BRRSSpace d → Complex := brrsDyadicHalfWaveSchwartzSymbol Φ j t
  let ms : BRRSSpace d → Complex := brrsDyadicHalfWaveSchwartzAdjointSymbol Φ j s
  have hmt : mt.HasTemperateGrowth :=
    (brrsDyadicHalfWaveSchwartzSymbol Φ j t).hasTemperateGrowth
  have hms : ms.HasTemperateGrowth :=
    (brrsDyadicHalfWaveSchwartzAdjointSymbol Φ j s).hasTemperateGrowth
  change SchwartzMap.fourierMultiplierCLM Complex mt
      (SchwartzMap.fourierMultiplierCLM Complex ms f) =
        SchwartzMap.fourierMultiplierCLM Complex
          (brrsDyadicHalfWaveTTStarSchwartzSymbol Φ j s t : BRRSSpace d → Complex) f
  rw [SchwartzMap.fourierMultiplierCLM_fourierMultiplierCLM_apply hmt hms]
  apply congrArg (fun m : BRRSSpace d → Complex =>
    SchwartzMap.fourierMultiplierCLM Complex m f)
  funext xi
  change mt xi * ms xi = _
  rw [show mt xi = brrsDyadicHalfWaveSchwartzSymbol Φ j t xi by rfl,
    show ms xi = brrsDyadicHalfWaveSchwartzAdjointSymbol Φ j s xi by rfl,
    brrsDyadicHalfWaveTTStarSchwartzSymbol_apply,
    brrsDyadicHalfWaveSchwartzSymbol_apply,
    brrsDyadicHalfWaveSchwartzAdjointSymbol_apply]

/-- The physical-space kernel of the exact annular `TT*` pair. -/
noncomputable def brrsDyadicHalfWaveTTStarKernel {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (s t : Real) : BRRSSchwartz d :=
  𝓕⁻ (brrsDyadicHalfWaveTTStarSchwartzSymbol Φ j s t)

/-- The pair operator is convolution by its explicitly named physical
kernel. -/
theorem brrsDyadicHalfWaveTTStarSchwartzPiece_eq_kernel_convolution {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (s t : Real) (f : BRRSSchwartz d)
    (x : BRRSSpace d) :
    brrsDyadicHalfWaveTTStarSchwartzPiece Φ j s t f x =
      (((brrsDyadicHalfWaveTTStarKernel Φ j s t : BRRSSchwartz d) :
          BRRSSpace d → Complex)
        ⋆[ContinuousLinearMap.mul Complex Complex, volume]
          (f : BRRSSpace d → Complex)) x := by
  let m : BRRSSchwartz d := brrsDyadicHalfWaveTTStarSchwartzSymbol Φ j s t
  have hm : (m : BRRSSpace d → Complex).HasTemperateGrowth := m.hasTemperateGrowth
  change ((SchwartzMap.fourierMultiplierCLM Complex
    (m : BRRSSpace d → Complex) f : BRRSSchwartz d) : BRRSSpace d → Complex) x = _
  rw [SchwartzMap.fourierMultiplierCLM_apply, SchwartzMap.fourierInv_coe]
  have hsymbol :
      (SchwartzMap.smulLeftCLM Complex (m : BRRSSpace d → Complex)
        (𝓕 f) : BRRSSpace d → Complex) =
      fun xi : BRRSSpace d => brrsDyadicHalfWaveTTStarSchwartzSymbol Φ j s t xi *
        𝓕 (f : BRRSSpace d → Complex) xi := by
    funext xi
    simp only [SchwartzMap.smulLeftCLM_apply hm, smul_eq_mul]
    rfl
  rw [hsymbol]
  simpa only [brrsDyadicHalfWaveTTStarKernel] using
    (Auto.Spherical.Auxiliary.fourierInv_schwartz_multiplier_eq_convolution
      (brrsDyadicHalfWaveTTStarSchwartzSymbol Φ j s t) f x)

/-- The two-variable physical kernel of the `TT*` pair.  Translation
invariance makes it a function of output minus source. -/
noncomputable def brrsDyadicHalfWaveTTStarSourceKernel {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (s t : Real)
    (x y : BRRSSpace d) : Complex :=
  brrsDyadicHalfWaveTTStarKernel Φ j s t (x - y)

/-- The exact source-kernel representation of `T_t T_s^*` on the Schwartz
core. -/
theorem brrsDyadicHalfWaveTTStarSchwartzPiece_eq_sourceKernel {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (s t : Real) (f : BRRSSchwartz d)
    (x : BRRSSpace d) :
    brrsDyadicHalfWaveTTStarSchwartzPiece Φ j s t f x =
      ∫ y : BRRSSpace d,
        brrsDyadicHalfWaveTTStarSourceKernel Φ j s t x y * f y := by
  rw [brrsDyadicHalfWaveTTStarSchwartzPiece_eq_kernel_convolution,
    convolution_mul_swap]
  rfl

/-- Polar representation of the exact annular `TT*` kernel.  This is the
radial Fourier identity to which the later Bessel/stationary-phase argument
must be applied; it makes no decay or lower-bound assertion. -/
theorem brrsDyadicHalfWaveTTStarKernel_eq_surfaceFourier_integral
    {d : Nat} (hd : 0 < d) (Φ : BRRSAnnularCutoff) (j : Nat) (s t : Real)
    (x : BRRSSpace d) :
    (brrsDyadicHalfWaveTTStarKernel Φ j s t : BRRSSpace d → Complex) x =
      ∫ rho : Ioi (0 : Real),
        surfaceFourier d (-rho.1 • x) *
          brrsDyadicHalfWaveTTStarRadialProfile Φ j s t rho.1
            ∂Measure.volumeIoiPow (d - 1) := by
  have hrad : ∀ xi : BRRSSpace d,
      brrsDyadicHalfWaveTTStarSchwartzSymbol Φ j s t xi =
        brrsDyadicHalfWaveTTStarRadialProfile Φ j s t ‖xi‖ := by
    intro xi
    exact brrsDyadicHalfWaveTTStarSchwartzSymbol_eq_radialProfile Φ j s t xi
  have hint := Auto.RadialFourierTransform.integrable_polar_fourierChar_mul_of_schwartz_radial
    (brrsDyadicHalfWaveTTStarSchwartzSymbol Φ j s t)
    (brrsDyadicHalfWaveTTStarRadialProfile Φ j s t) hrad x
  unfold brrsDyadicHalfWaveTTStarKernel
  rw [SchwartzMap.fourierInv_coe]
  change 𝓕⁻ (brrsDyadicHalfWaveTTStarSchwartzSymbol Φ j s t :
    BRRSSpace d → Complex) x = _
  rw [show (brrsDyadicHalfWaveTTStarSchwartzSymbol Φ j s t :
      BRRSSpace d → Complex) = fun xi =>
        brrsDyadicHalfWaveTTStarRadialProfile Φ j s t ‖xi‖ by
      funext xi
      exact hrad xi]
  exact fourierInv_radial_eq_surfaceFourier_integral hd
    (brrsDyadicHalfWaveTTStarRadialProfile Φ j s t) x hint

/-- The two-variable `TT*` source kernel has the same polar radial formula,
evaluated at the output-source difference. -/
theorem brrsDyadicHalfWaveTTStarSourceKernel_eq_surfaceFourier_integral
    {d : Nat} (hd : 0 < d) (Φ : BRRSAnnularCutoff) (j : Nat) (s t : Real)
    (x y : BRRSSpace d) :
    brrsDyadicHalfWaveTTStarSourceKernel Φ j s t x y =
      ∫ rho : Ioi (0 : Real),
        surfaceFourier d (-rho.1 • (x - y)) *
          brrsDyadicHalfWaveTTStarRadialProfile Φ j s t rho.1
            ∂Measure.volumeIoiPow (d - 1) := by
  exact brrsDyadicHalfWaveTTStarKernel_eq_surfaceFourier_integral
    hd Φ j s t (x - y)

/-! ### Stationary surface-wave normal forms

The auxiliary fractal-dilations development contains a literal meridian
stationary-phase calculation: the Fourier transform of spherical measure is
an outgoing wave, an incoming wave, and a rapidly decaying middle term.  The
following small BRRS-facing interface records that calculation in precisely
the radial form used by the half-wave and `TT*` kernels above.  These are
equalities for the actual `surfaceFourier` factor; no symbol-class surrogate
is introduced here.
-/

open Auto.Spherical.OscillatoryIntegralAux Auto.Spherical.AHRS

/-- The three pieces of the stationary decomposition of a nonplanar sphere
surface Fourier factor. -/
inductive BRRSSurfaceWavePart where
  | outgoing
  | incoming
  | middle
  deriving DecidableEq

/-- The extracted linear radial phase of a stationary surface-wave piece. -/
def brrsSurfaceWavePhase (part : BRRSSurfaceWavePart) (a : Real) : Real :=
  match part with
  | .outgoing => -(2 * Real.pi * a)
  | .incoming => 2 * Real.pi * a
  | .middle => 0

/-- The radial coefficient after its outgoing or incoming carrier has been
extracted.  For the middle term no carrier is extracted, and its rapid decay
is supplied by the proved meridian integration-by-parts estimates in
`OscillatoryIntegralAux`. -/
def brrsSurfaceWaveAmplitude
    (d : Nat) (part : BRRSSurfaceWavePart) (a rho : Real) : Complex :=
  (surfaceMass (d - 1) : Complex) *
    match part with
    | .outgoing => smoothEndpointQuadraticIntegral (d - 2) ((2 * Real.pi * a) * rho)
    | .incoming => smoothEndpointQuadraticIntegral (d - 2) ((-(2 * Real.pi * a)) * rho)
    | .middle => coordinateMiddleMeridianLocalizedIntegral (d - 2)
        ((2 * Real.pi * a) * rho)

/-- The incoming endpoint amplitude is exactly the complex conjugate of the
outgoing one.  This is an identity for the literal meridional integrals,
not an asymptotic assertion. -/
theorem brrsSurfaceWaveAmplitude_incoming_eq_conj_outgoing
    (d : Nat) (a rho : Real) :
    brrsSurfaceWaveAmplitude d .incoming a rho =
      starRingEnd Complex (brrsSurfaceWaveAmplitude d .outgoing a rho) := by
  have hsign : (-(2 * Real.pi * a)) * rho = -((2 * Real.pi * a) * rho) := by
    ring
  unfold brrsSurfaceWaveAmplitude
  rw [hsign, smoothEndpointQuadraticIntegral_neg_eq_conj]
  simp only [map_mul, Complex.conj_ofReal]

/-- One concrete stationary surface-wave term on a radial frequency ray. -/
def brrsSurfaceWaveTerm
    (d : Nat) (part : BRRSSurfaceWavePart) (a rho : Real) : Complex :=
  brrsSurfaceWaveAmplitude d part a rho *
    Complex.exp (((brrsSurfaceWavePhase part a * rho : Real) : Complex) * Complex.I)

/-- The exact three-wave form of the nonplanar spherical Fourier factor at a
nonnegative scalar frequency. -/
def brrsSurfaceWaveSum (d : Nat) (u : Real) : Complex :=
  (surfaceMass (d - 1) : Complex) *
    (Complex.exp (((-(2 * Real.pi * u) : Real) : Complex) * Complex.I) *
        smoothEndpointQuadraticIntegral (d - 2) (2 * Real.pi * u) +
      Complex.exp (((2 * Real.pi * u : Real) : Complex) * Complex.I) *
        smoothEndpointQuadraticIntegral (d - 2) (-(2 * Real.pi * u)) +
      coordinateMiddleMeridianLocalizedIntegral (d - 2) (2 * Real.pi * u))

/-- The stationary wave sum exposes the outgoing, incoming, and middle
pieces with their literal linear radial phases. -/
theorem brrsSurfaceWaveSum_eq_three_terms
    (d : Nat) (a rho : Real) :
    brrsSurfaceWaveSum d (a * rho) =
      brrsSurfaceWaveTerm d .outgoing a rho +
        brrsSurfaceWaveTerm d .incoming a rho +
          brrsSurfaceWaveTerm d .middle a rho := by
  unfold brrsSurfaceWaveSum brrsSurfaceWaveTerm brrsSurfaceWaveAmplitude
    brrsSurfaceWavePhase
  have hphaseOut : -(2 * Real.pi * (a * rho)) = (-(2 * Real.pi * a)) * rho := by
    ring
  have hphaseIn : 2 * Real.pi * (a * rho) = (2 * Real.pi * a) * rho := by
    ring
  simp only [Complex.ofReal_neg, Complex.ofReal_mul, Complex.ofReal_ofNat, neg_mul, zero_mul,
      Complex.ofReal_zero, Complex.exp_zero, mul_one]
  rw [hphaseOut, hphaseIn]
  ring

/-- The all-dimensional stationary-phase calculation, expressed directly in
the ambient dimension required by BRRS. -/
theorem brrs_surfaceFourier_eq_stationaryWaveSum
    {d : Nat} (hd : 3 <= d) (xi : BRRSSpace d) :
    surfaceFourier d xi = brrsSurfaceWaveSum d ‖xi‖ := by
  have hd' : 2 <= d - 1 := by omega
  have hdim : d - 1 + 1 = d := Nat.sub_add_cancel (by omega)
  have hsurface :=
    surfaceFourier_succ_eq_coordinateSmoothWaves (d := d - 1) hd'
  rw [hdim] at hsurface
  simpa only [Nat.sub_sub, Nat.reduceAdd, brrsSurfaceWaveSum] using hsurface xi

/-- The surface factor in the exact polar BRRS kernel has the three-wave
form on every positive radial ray. -/
theorem brrs_surfaceFourier_neg_smul_eq_three_terms
    {d : Nat} (hd : 3 <= d) {rho : Real} (hrho : 0 < rho)
    (x : BRRSSpace d) :
    surfaceFourier d (-rho • x) =
      brrsSurfaceWaveTerm d .outgoing ‖x‖ rho +
        brrsSurfaceWaveTerm d .incoming ‖x‖ rho +
          brrsSurfaceWaveTerm d .middle ‖x‖ rho := by
  rw [brrs_surfaceFourier_eq_stationaryWaveSum hd]
  have hnorm : ‖-rho • x‖ = rho * ‖x‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_neg, abs_of_pos hrho]
  rw [hnorm]
  simpa only [mul_comm] using brrsSurfaceWaveSum_eq_three_terms d ‖x‖ rho

/-- The exact stationary wave sum for the planar circle.  The endpoint
symbol is distinct in dimension two, because the meridian density has
vanishing order zero. -/
def brrsPlanarSurfaceWaveSum (u : Real) : Complex :=
  (surfaceMass 1 : Complex) *
    (Complex.exp (((-(2 * Real.pi * u) : Real) : Complex) * Complex.I) *
        planarEndpointQuadraticIntegral (2 * Real.pi * u) +
      Complex.exp (((2 * Real.pi * u : Real) : Complex) * Complex.I) *
        planarEndpointQuadraticIntegral (-(2 * Real.pi * u)) +
      coordinateMiddleMeridianLocalizedIntegral 0 (2 * Real.pi * u))

/-- The planar companion of the nonplanar stationary surface-wave identity. -/
theorem brrs_surfaceFourier_two_eq_stationaryWaveSum (xi : BRRSSpace 2) :
    surfaceFourier 2 xi = brrsPlanarSurfaceWaveSum ‖xi‖ := by
  simpa only [brrsPlanarSurfaceWaveSum] using
    surfaceFourier_two_eq_coordinatePlanarSmoothWaves xi

/-! ### Dimension-generic finite-`Lᵖ` Young inequality

The half-wave multiplier has a Schwartz physical kernel.  The elementary
Young estimate below is deliberately stated on arbitrary Euclidean dimension
and arbitrary measurable complex functions, so it can serve both the
Schwartz Fourier formula above and an eventual `Lᵖ` realization of that
formula.  The proof is kept here rather than imported from the planar
Roos--Seeger development, whose corresponding result is specialized to
`Euclidean 2` and private to that component. -/

/-- Hölder factorization of a product against a positive weight. -/
theorem brrs_ennreal_weighted_factor_of_holder
    {p r : Real} (hpq : r.HolderConjugate p) (a b : ENNReal) :
    a * b = a ^ r⁻¹ * (a * b ^ p) ^ p⁻¹ := by
  have hp0 : 0 < p := hpq.symm.pos
  have hbinv : (b ^ p) ^ p⁻¹ = b := by
    calc
      (b ^ p) ^ p⁻¹ = b ^ (p * p⁻¹) := (ENNReal.rpow_mul _ _ _).symm
      _ = b := by rw [mul_inv_cancel₀ hp0.ne', ENNReal.rpow_one]
  rw [ENNReal.mul_rpow_of_nonneg _ _ hpq.symm.inv_nonneg]
  rw [hbinv]
  calc
    a * b = a ^ (r⁻¹ + p⁻¹) * b := by rw [hpq.inv_add_inv_eq_one, ENNReal.rpow_one]
    _ = (a ^ r⁻¹ * a ^ p⁻¹) * b := by
      rw [ENNReal.rpow_add_of_nonneg _ _ hpq.inv_nonneg hpq.symm.inv_nonneg]
    _ = a ^ r⁻¹ * (a ^ p⁻¹ * b) := by ring

/-- The pointwise Hölder step in Young's inequality, valid in every
Euclidean dimension. -/
theorem brrs_lintegral_spatial_p_pointwise {d : Nat}
    (p r : Real) (hpq : r.HolderConjugate p) (K q : BRRSSpace d → ENNReal)
    (hK : Measurable K) (hq : Measurable q) (x : BRRSSpace d) :
    (∫⁻ y : BRRSSpace d, K y * q (x - y)) ^ p ≤
      (∫⁻ y : BRRSSpace d, K y) ^ (p - 1) *
        ∫⁻ y : BRRSSpace d, K y * q (x - y) ^ p := by
  have hp0 : 0 < p := hpq.symm.pos
  have hr0 : 0 < r := hpq.pos
  let a : BRRSSpace d → ENNReal := fun y => K y ^ r⁻¹
  let b : BRRSSpace d → ENNReal := fun y =>
    (K y * q (x - y) ^ p) ^ p⁻¹
  have ha : AEMeasurable a volume := (hK.pow measurable_const).aemeasurable
  have hqx : Measurable (fun y : BRRSSpace d => q (x - y)) :=
    hq.comp (measurable_const.sub measurable_id)
  have hb : AEMeasurable b volume :=
    ((hK.mul (hqx.pow measurable_const)).pow measurable_const).aemeasurable
  have hholder := ENNReal.lintegral_mul_le_Lp_mul_Lq volume hpq ha hb
  have hleft : (∫⁻ y : BRRSSpace d, (a * b) y) =
      ∫⁻ y : BRRSSpace d, K y * q (x - y) := by
    apply lintegral_congr
    intro y
    simp only [a, b, Pi.mul_apply]
    exact (brrs_ennreal_weighted_factor_of_holder hpq (K y) (q (x - y))).symm
  have hfirst : (∫⁻ y : BRRSSpace d, a y ^ r) = ∫⁻ y : BRRSSpace d, K y := by
    apply lintegral_congr
    intro y
    simp only [a]
    rw [← ENNReal.rpow_mul, inv_mul_cancel₀ hr0.ne', ENNReal.rpow_one]
  have hsecond : (∫⁻ y : BRRSSpace d, b y ^ p) =
      ∫⁻ y : BRRSSpace d, K y * q (x - y) ^ p := by
    apply lintegral_congr
    intro y
    simp only [b]
    rw [← ENNReal.rpow_mul, inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one]
  have hholder2 :
      (∫⁻ y : BRRSSpace d, K y * q (x - y)) ≤
        (∫⁻ y : BRRSSpace d, K y) ^ r⁻¹ *
          (∫⁻ y : BRRSSpace d, K y * q (x - y) ^ p) ^ p⁻¹ := by
    rw [hleft, hfirst, hsecond] at hholder
    simpa only [one_div] using hholder
  have hrp : r⁻¹ * p = p - 1 := by
    rw [← hpq.symm.one_sub_inv]
    field_simp [hp0.ne']
  have hpow := ENNReal.rpow_le_rpow hholder2 hp0.le
  calc
    (∫⁻ y : BRRSSpace d, K y * q (x - y)) ^ p ≤
        ((∫⁻ y : BRRSSpace d, K y) ^ r⁻¹ *
          (∫⁻ y : BRRSSpace d, K y * q (x - y) ^ p) ^ p⁻¹) ^ p := hpow
    _ = (∫⁻ y : BRRSSpace d, K y) ^ (p - 1) *
        ∫⁻ y : BRRSSpace d, K y * q (x - y) ^ p := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
      rw [← ENNReal.rpow_mul, ← ENNReal.rpow_mul, hrp,
        inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one]

/-- Young's inequality for the `p`-moment of convolution with a positive
kernel on Euclidean space. -/
theorem brrs_lintegral_spatial_p_young {d : Nat}
    (p r : Real) (hpq : r.HolderConjugate p) (K q : BRRSSpace d → ENNReal)
    (hK : Measurable K) (hq : Measurable q) :
    ∫⁻ x : BRRSSpace d, (∫⁻ y : BRRSSpace d, K y * q (x - y)) ^ p ≤
      (∫⁻ y : BRRSSpace d, K y) ^ p * ∫⁻ x : BRRSSpace d, q x ^ p := by
  have hp0 : 0 < p := hpq.symm.pos
  have hpone : 1 ≤ p := hpq.symm.lt.le
  let H : BRRSSpace d × BRRSSpace d → ENNReal := fun z =>
    K z.2 * q (z.1 - z.2) ^ p
  have hH : Measurable H :=
    (hK.comp measurable_snd).mul
      ((hq.comp (measurable_fst.sub measurable_snd)).pow measurable_const)
  have hinner : Measurable (fun x : BRRSSpace d =>
      ∫⁻ y : BRRSSpace d, K y * q (x - y) ^ p) :=
    hH.lintegral_prod_right
  have htranslate (y : BRRSSpace d) :
      (∫⁻ x : BRRSSpace d, q (x - y) ^ p) = ∫⁻ x : BRRSSpace d, q x ^ p :=
    (measurePreserving_sub_right (volume : Measure (BRRSSpace d)) y).lintegral_comp
      (hq.pow measurable_const)
  have hdouble :
      (∫⁻ x : BRRSSpace d, ∫⁻ y : BRRSSpace d, K y * q (x - y) ^ p) =
        (∫⁻ y : BRRSSpace d, K y) * ∫⁻ x : BRRSSpace d, q x ^ p := by
    calc
      (∫⁻ x : BRRSSpace d, ∫⁻ y : BRRSSpace d, K y * q (x - y) ^ p) =
          ∫⁻ y : BRRSSpace d, ∫⁻ x : BRRSSpace d, K y * q (x - y) ^ p :=
        lintegral_lintegral_swap hH.aemeasurable
      _ = ∫⁻ y : BRRSSpace d, K y * (∫⁻ x : BRRSSpace d, q (x - y) ^ p) := by
        apply lintegral_congr
        intro y
        simpa only [Function.comp_apply, Pi.sub_apply, id_eq] using
          (lintegral_const_mul (K y)
            ((hq.comp (measurable_id.sub measurable_const)).pow measurable_const))
      _ = ∫⁻ y : BRRSSpace d, K y * (∫⁻ x : BRRSSpace d, q x ^ p) := by
        apply lintegral_congr
        intro y
        rw [htranslate y]
      _ = (∫⁻ y : BRRSSpace d, K y) * ∫⁻ x : BRRSSpace d, q x ^ p :=
        lintegral_mul_const _ hK
  calc
    (∫⁻ x : BRRSSpace d, (∫⁻ y : BRRSSpace d, K y * q (x - y)) ^ p) ≤
        ∫⁻ x : BRRSSpace d, (∫⁻ y : BRRSSpace d, K y) ^ (p - 1) *
          (∫⁻ y : BRRSSpace d, K y * q (x - y) ^ p) := by
      apply lintegral_mono
      intro x
      exact brrs_lintegral_spatial_p_pointwise p r hpq K q hK hq x
    _ = (∫⁻ y : BRRSSpace d, K y) ^ (p - 1) *
        (∫⁻ x : BRRSSpace d, ∫⁻ y : BRRSSpace d, K y * q (x - y) ^ p) := by
      rw [lintegral_const_mul _ hinner]
    _ = (∫⁻ y : BRRSSpace d, K y) ^ (p - 1) *
        ((∫⁻ y : BRRSSpace d, K y) * ∫⁻ x : BRRSSpace d, q x ^ p) := by rw [hdouble]
    _ = (∫⁻ y : BRRSSpace d, K y) ^ p * ∫⁻ x : BRRSSpace d, q x ^ p := by
      calc
        (∫⁻ y : BRRSSpace d, K y) ^ (p - 1) *
            ((∫⁻ y : BRRSSpace d, K y) * ∫⁻ x : BRRSSpace d, q x ^ p) =
            ((∫⁻ y : BRRSSpace d, K y) ^ (p - 1) *
              (∫⁻ y : BRRSSpace d, K y) ^ (1 : Real)) *
              ∫⁻ x : BRRSSpace d, q x ^ p := by
          rw [ENNReal.rpow_one]; ring
        _ = (∫⁻ y : BRRSSpace d, K y) ^ ((p - 1) + 1) *
              ∫⁻ x : BRRSSpace d, q x ^ p := by
          rw [← ENNReal.rpow_add_of_nonneg _ _ (sub_nonneg.mpr hpone)
            (by norm_num : (0 : Real) ≤ 1)]
        _ = (∫⁻ y : BRRSSpace d, K y) ^ p * ∫⁻ x : BRRSSpace d, q x ^ p := by
          congr 2
          ring

/-- The dimension-generic finite-`Lᵖ` Young inequality for a convolution
with an `L¹` kernel.  No radiality or Fourier-specific hypothesis is used. -/
theorem brrs_eLpNorm_convolution_le {d : Nat}
    (p : Real) (hp : 1 < p) (K f : BRRSSpace d → Complex)
    (hK : Measurable K) (hf : Measurable f) :
    eLpNorm (K ⋆[ContinuousLinearMap.mul Complex Complex, volume] f) (ENNReal.ofReal p) volume ≤
      (∫⁻ y : BRRSSpace d, ‖K y‖ₑ) * eLpNorm f (ENNReal.ofReal p) volume := by
  have hp0 : 0 < p := lt_trans zero_lt_one hp
  have hpq : p.conjExponent.HolderConjugate p :=
    (Real.HolderConjugate.conjExponent hp).symm
  have hpoint (x : BRRSSpace d) :
      ‖(K ⋆[ContinuousLinearMap.mul Complex Complex, volume] f) x‖ₑ ≤
        ∫⁻ y : BRRSSpace d, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
    change ‖∫ y : BRRSSpace d, K y * f (x - y)‖ₑ ≤ _
    calc
      ‖∫ y : BRRSSpace d, K y * f (x - y)‖ₑ ≤ ∫⁻ y : BRRSSpace d, ‖K y * f (x - y)‖ₑ :=
        enorm_integral_le_lintegral_enorm _
      _ = ∫⁻ y : BRRSSpace d, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
        apply lintegral_congr
        intro y
        rw [enorm_mul]
  have hmoment :
      (∫⁻ x : BRRSSpace d,
          ‖(K ⋆[ContinuousLinearMap.mul Complex Complex, volume] f) x‖ₑ ^ p) ≤
        (∫⁻ y : BRRSSpace d, ‖K y‖ₑ) ^ p *
          ∫⁻ x : BRRSSpace d, ‖f x‖ₑ ^ p := by
    calc
      (∫⁻ x : BRRSSpace d,
          ‖(K ⋆[ContinuousLinearMap.mul Complex Complex, volume] f) x‖ₑ ^ p) ≤
          ∫⁻ x : BRRSSpace d,
            (∫⁻ y : BRRSSpace d, ‖K y‖ₑ * ‖f (x - y)‖ₑ) ^ p := by
        apply lintegral_mono
        intro x
        exact ENNReal.rpow_le_rpow (hpoint x) (by positivity)
      _ ≤ (∫⁻ y : BRRSSpace d, ‖K y‖ₑ) ^ p *
          ∫⁻ x : BRRSSpace d, ‖f x‖ₑ ^ p :=
        brrs_lintegral_spatial_p_young p p.conjExponent hpq
          (fun y => ‖K y‖ₑ) (fun x => ‖f x‖ₑ) hK.enorm hf.enorm
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top
    (hK.aestronglyMeasurable.convolution _ hf.aestronglyMeasurable)]
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top hf.aestronglyMeasurable]
  simp only [ENNReal.toReal_ofReal hp0.le, one_div]
  have hstep := ENNReal.rpow_le_rpow hmoment (by positivity : (0 : Real) ≤ p⁻¹)
  calc
    (∫⁻ x : BRRSSpace d,
        ‖(K ⋆[ContinuousLinearMap.mul Complex Complex, volume] f) x‖ₑ ^ p) ^ p⁻¹ ≤
        ((∫⁻ y : BRRSSpace d, ‖K y‖ₑ) ^ p *
          ∫⁻ x : BRRSSpace d, ‖f x‖ₑ ^ p) ^ p⁻¹ := hstep
    _ = (∫⁻ y : BRRSSpace d, ‖K y‖ₑ) *
        (∫⁻ x : BRRSSpace d, ‖f x‖ₑ ^ p) ^ p⁻¹ := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : Real) ≤ p⁻¹)]
      congr 1
      rw [← ENNReal.rpow_mul, mul_inv_cancel₀ hp0.ne', ENNReal.rpow_one]

/-- Tonelli's formula for the positive convolution at the `L¹` endpoint. -/
theorem brrs_lintegral_spatial_one_young {d : Nat}
    (K q : BRRSSpace d → ENNReal) (hK : Measurable K) (hq : Measurable q) :
    (∫⁻ x : BRRSSpace d, ∫⁻ y : BRRSSpace d, K y * q (x - y)) =
      (∫⁻ y : BRRSSpace d, K y) * ∫⁻ x : BRRSSpace d, q x := by
  let H : BRRSSpace d × BRRSSpace d → ENNReal := fun z =>
    K z.2 * q (z.1 - z.2)
  have hH : Measurable H :=
    (hK.comp measurable_snd).mul
      (hq.comp (measurable_fst.sub measurable_snd))
  have htranslate (y : BRRSSpace d) :
      (∫⁻ x : BRRSSpace d, q (x - y)) = ∫⁻ x : BRRSSpace d, q x :=
    (measurePreserving_sub_right (volume : Measure (BRRSSpace d)) y).lintegral_comp hq
  calc
    (∫⁻ x : BRRSSpace d, ∫⁻ y : BRRSSpace d, K y * q (x - y)) =
        ∫⁻ y : BRRSSpace d, ∫⁻ x : BRRSSpace d, K y * q (x - y) :=
      lintegral_lintegral_swap hH.aemeasurable
    _ = ∫⁻ y : BRRSSpace d, K y * (∫⁻ x : BRRSSpace d, q (x - y)) := by
      apply lintegral_congr
      intro y
      simpa only [Function.comp_apply, Pi.sub_apply, id_eq] using
        (lintegral_const_mul (K y) (hq.comp (measurable_id.sub measurable_const)))
    _ = ∫⁻ y : BRRSSpace d, K y * (∫⁻ x : BRRSSpace d, q x) := by
      apply lintegral_congr
      intro y
      rw [htranslate y]
    _ = (∫⁻ y : BRRSSpace d, K y) * ∫⁻ x : BRRSSpace d, q x :=
      lintegral_mul_const _ hK

/-- The `L¹` endpoint of the dimension-generic Young inequality. -/
theorem brrs_eLpNorm_convolution_one_le {d : Nat}
    (K f : BRRSSpace d → Complex) (hK : Measurable K) (hf : Measurable f) :
    eLpNorm (K ⋆[ContinuousLinearMap.mul Complex Complex, volume] f) 1 volume ≤
      (∫⁻ y : BRRSSpace d, ‖K y‖ₑ) * eLpNorm f 1 volume := by
  rw [eLpNorm_one_eq_lintegral_enorm
    (hK.aestronglyMeasurable.convolution _ hf.aestronglyMeasurable)]
  rw [eLpNorm_one_eq_lintegral_enorm hf.aestronglyMeasurable]
  have hpoint (x : BRRSSpace d) :
      ‖(K ⋆[ContinuousLinearMap.mul Complex Complex, volume] f) x‖ₑ ≤
        ∫⁻ y : BRRSSpace d, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
    change ‖∫ y : BRRSSpace d, K y * f (x - y)‖ₑ ≤ _
    calc
      ‖∫ y : BRRSSpace d, K y * f (x - y)‖ₑ ≤ ∫⁻ y : BRRSSpace d, ‖K y * f (x - y)‖ₑ :=
        enorm_integral_le_lintegral_enorm _
      _ = ∫⁻ y : BRRSSpace d, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
        apply lintegral_congr
        intro y
        rw [enorm_mul]
  calc
    (∫⁻ x : BRRSSpace d,
        ‖(K ⋆[ContinuousLinearMap.mul Complex Complex, volume] f) x‖ₑ) ≤
        ∫⁻ x : BRRSSpace d,
          ∫⁻ y : BRRSSpace d, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
      apply lintegral_mono
      intro x
      exact hpoint x
    _ = (∫⁻ y : BRRSSpace d, ‖K y‖ₑ) * ∫⁻ x : BRRSSpace d, ‖f x‖ₑ :=
      brrs_lintegral_spatial_one_young (fun y => ‖K y‖ₑ) (fun x => ‖f x‖ₑ)
        hK.enorm hf.enorm

/-- A Schwartz kernel paired with an `Lᵖ` input has a defined convolution
integral at every spatial point.  The endpoint `p = 1` is included: its
Hölder conjugate is `∞`, and Schwartz kernels lie in every such space. -/
theorem brrs_convolutionExistsAt_of_memLp {d : Nat}
    (K : BRRSSchwartz d) (p : Real) (hp : 1 ≤ p)
    {f : BRRSSpace d → Complex} (hf : MemLp f (ENNReal.ofReal p) volume)
    (x : BRRSSpace d) :
    ConvolutionExistsAt (K : BRRSSpace d → Complex) f x
      (ContinuousLinearMap.mul Complex Complex) volume := by
  have hP : 1 ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]
    exact ENNReal.ofReal_le_ofReal hp
  letI : Fact (1 ≤ ENNReal.ofReal p) := ⟨hP⟩
  letI : (ENNReal.ofReal p).HolderConjugate (ENNReal.ofReal p).conjExponent :=
    ENNReal.HolderConjugate.conjExponent hP
  have hK : MemLp (K : BRRSSpace d → Complex)
      (ENNReal.ofReal p).conjExponent volume :=
    K.memLp _ volume
  have hfshift : MemLp (fun y : BRRSSpace d => f (x - y))
      (ENNReal.ofReal p) volume := by
    simpa only [Function.comp_def] using
      hf.comp_measurePreserving
        ((volume : Measure (BRRSSpace d)).measurePreserving_sub_left x)
  change Integrable (fun y : BRRSSpace d => K y * f (x - y)) volume
  exact hK.integrable_mul hfshift

/-- The preceding pointwise-existence statement in the bundled form used by
the convolution linearity API. -/
theorem brrs_convolutionExists_of_memLp {d : Nat}
    (K : BRRSSchwartz d) (p : Real) (hp : 1 ≤ p)
    {f : BRRSSpace d → Complex} (hf : MemLp f (ENNReal.ofReal p) volume) :
    ConvolutionExists (K : BRRSSpace d → Complex) f
      (ContinuousLinearMap.mul Complex Complex) volume :=
  fun x => brrs_convolutionExistsAt_of_memLp K p hp hf x

/-- Convolution by a Schwartz kernel preserves a.e. strong measurability. -/
theorem brrs_aestronglyMeasurable_schwartz_convolution {d : Nat}
    (K : BRRSSchwartz d) {f : BRRSSpace d → Complex}
    (hf : AEStronglyMeasurable f volume) :
    AEStronglyMeasurable
      ((K : BRRSSpace d → Complex) ⋆[ContinuousLinearMap.mul Complex Complex, volume] f)
      volume := by
  let H : BRRSSpace d × BRRSSpace d → Complex := fun z =>
    K z.2 * f (z.1 - z.2)
  have hH : AEStronglyMeasurable H (volume.prod volume) :=
    K.continuous.aestronglyMeasurable.convolution_integrand
      (ContinuousLinearMap.mul Complex Complex) hf
  change AEStronglyMeasurable (fun x : BRRSSpace d =>
    ∫ y : BRRSSpace d, K y * f (x - y)) volume
  simpa only [H] using hH.integral_prod_right'

/-- Young's inequality with an a.e.-strongly-measurable `Lᵖ` input.  A
strongly measurable representative is used only in the proof; convolution
itself respects a.e. equality. -/
theorem brrs_eLpNorm_schwartz_convolution_le_of_memLp {d : Nat}
    (K : BRRSSchwartz d) (p : Real) (hp : 1 ≤ p)
    {f : BRRSSpace d → Complex} (hf : MemLp f (ENNReal.ofReal p) volume) :
    eLpNorm ((K : BRRSSpace d → Complex)
      ⋆[ContinuousLinearMap.mul Complex Complex, volume] f) (ENNReal.ofReal p) volume ≤
      (∫⁻ y : BRRSSpace d, ‖K y‖ₑ) * eLpNorm f (ENNReal.ofReal p) volume := by
  let f0 : BRRSSpace d → Complex := hf.aestronglyMeasurable.mk f
  have hf0meas : Measurable f0 := hf.aestronglyMeasurable.measurable_mk
  have hfeq : f =ᵐ[volume] f0 := hf.aestronglyMeasurable.ae_eq_mk
  have hconv :
      ((K : BRRSSpace d → Complex)
        ⋆[ContinuousLinearMap.mul Complex Complex, volume] f) =
        ((K : BRRSSpace d → Complex)
          ⋆[ContinuousLinearMap.mul Complex Complex, volume] f0) :=
    convolution_congr (ContinuousLinearMap.mul Complex Complex)
      (Eventually.of_forall fun _ => rfl) hfeq
  calc
    eLpNorm ((K : BRRSSpace d → Complex)
        ⋆[ContinuousLinearMap.mul Complex Complex, volume] f) (ENNReal.ofReal p) volume =
        eLpNorm ((K : BRRSSpace d → Complex)
          ⋆[ContinuousLinearMap.mul Complex Complex, volume] f0) (ENNReal.ofReal p) volume := by
      rw [hconv]
    _ ≤ (∫⁻ y : BRRSSpace d, ‖K y‖ₑ) * eLpNorm f0 (ENNReal.ofReal p) volume := by
      rcases lt_or_eq_of_le hp with hpgt | hpone
      · exact brrs_eLpNorm_convolution_le p hpgt (K : BRRSSpace d → Complex) f0
          K.continuous.measurable hf0meas
      · subst p
        simpa using brrs_eLpNorm_convolution_one_le (K : BRRSSpace d → Complex) f0
          K.continuous.measurable hf0meas
    _ = (∫⁻ y : BRRSSpace d, ‖K y‖ₑ) * eLpNorm f (ENNReal.ofReal p) volume := by
      rw [← eLpNorm_congr_ae hfeq]

/-- The raw convolution by a Schwartz kernel is an honest `Lᵖ` map for
every finite real exponent at least one. -/
theorem brrs_memLp_schwartz_convolution_of_memLp {d : Nat}
    (K : BRRSSchwartz d) (p : Real) (hp : 1 ≤ p)
    {f : BRRSSpace d → Complex} (hf : MemLp f (ENNReal.ofReal p) volume) :
    MemLp ((K : BRRSSpace d → Complex)
      ⋆[ContinuousLinearMap.mul Complex Complex, volume] f) (ENNReal.ofReal p) volume := by
  have hmass : (∫⁻ y : BRRSSpace d, ‖K y‖ₑ) < ∞ := by
    rw [← ofReal_integral_norm_eq_lintegral_enorm K.integrable]
    exact ENNReal.ofReal_lt_top
  exact (brrs_eLpNorm_schwartz_convolution_le_of_memLp K p hp hf).trans_lt
    (ENNReal.mul_lt_top hmass hf.eLpNorm_lt_top)

/-- The half-wave phase is unimodular, so the annular symbol has the same
pointwise bound as the cutoff alone. -/
theorem norm_brrsDyadicHalfWaveSchwartzSymbol_le {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) (xi : BRRSSpace d) :
    ‖brrsDyadicHalfWaveSchwartzSymbol Φ j t xi‖ ≤
      SchwartzMap.seminorm Complex 0 0 Φ.symbol := by
  rw [brrsDyadicHalfWaveSchwartzSymbol_apply, brrsDyadicHalfWaveSymbol,
    norm_mul, halfWaveMultiplier, Complex.norm_exp_ofReal_mul_I, one_mul]
  exact norm_brrsDyadicMultiplierSchwartz_le Φ j xi

/-- Plancherel gives a literal fixed-scale `L²` estimate for the BRRS
annular projection.  The constant is the zeroth Schwartz seminorm of the
one-dimensional cutoff and is uniform in the dyadic level. -/
theorem integral_norm_sq_brrsDyadicProjection_le {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (f : BRRSSchwartz d) :
    (∫ x : BRRSSpace d, ‖brrsDyadicProjection Φ j f x‖ ^ 2) ≤
      (SchwartzMap.seminorm Complex 0 0 Φ.symbol) ^ 2 *
        ∫ x : BRRSSpace d, ‖f x‖ ^ 2 := by
  have hC : 0 ≤ SchwartzMap.seminorm Complex 0 0 Φ.symbol := by
    exact (norm_nonneg (Φ.symbol 0)).trans
      (SchwartzMap.norm_le_seminorm Complex Φ.symbol 0)
  calc
    (∫ x : BRRSSpace d, ‖brrsDyadicProjection Φ j f x‖ ^ 2) ≤
        (SchwartzMap.seminorm Complex 0 0 Φ.symbol) ^ 2 *
          ∫ xi : BRRSSpace d, ‖𝓕 (f : BRRSSpace d → Complex) xi‖ ^ 2 := by
      simpa only [brrsDyadicProjection,
        brrsDyadicMultiplierSchwartz_apply, SchwartzMap.fourier_coe] using
        (Auto.Spherical.Auxiliary.integral_norm_sq_fourierInv_schwartz_multiplier_le
          (brrsDyadicMultiplierSchwartz Φ j) (𝓕 f) hC
          (norm_brrsDyadicMultiplierSchwartz_le Φ j))
    _ = (SchwartzMap.seminorm Complex 0 0 Φ.symbol) ^ 2 *
          ∫ x : BRRSSpace d, ‖f x‖ ^ 2 := by
      rw [Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq]

/-- Plancherel gives the literal fixed-time `L²` bound for the BRRS annular
half-wave.  Unimodularity of the phase makes the same cutoff constant work
for every time and dyadic level. -/
theorem fixedTimeL2_brrsDyadicHalfWave {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) (f : BRRSSchwartz d) :
    (∫ x : BRRSSpace d, ‖brrsDyadicHalfWave Φ j t f x‖ ^ 2) ≤
      (SchwartzMap.seminorm Complex 0 0 Φ.symbol) ^ 2 *
        ∫ x : BRRSSpace d, ‖f x‖ ^ 2 := by
  have hC : 0 ≤ SchwartzMap.seminorm Complex 0 0 Φ.symbol := by
    exact (norm_nonneg (Φ.symbol 0)).trans
      (SchwartzMap.norm_le_seminorm Complex Φ.symbol 0)
  calc
    (∫ x : BRRSSpace d, ‖brrsDyadicHalfWave Φ j t f x‖ ^ 2) ≤
        (SchwartzMap.seminorm Complex 0 0 Φ.symbol) ^ 2 *
          ∫ xi : BRRSSpace d, ‖𝓕 (f : BRRSSpace d → Complex) xi‖ ^ 2 := by
      simpa only [brrsDyadicHalfWave,
        brrsDyadicHalfWaveSchwartzSymbol_apply, brrsDyadicHalfWaveSymbol,
        SchwartzMap.fourier_coe] using
        (Auto.Spherical.Auxiliary.integral_norm_sq_fourierInv_schwartz_multiplier_le
          (brrsDyadicHalfWaveSchwartzSymbol Φ j t) (𝓕 f) hC
          (norm_brrsDyadicHalfWaveSchwartzSymbol_le Φ j t))
    _ = (SchwartzMap.seminorm Complex 0 0 Φ.symbol) ^ 2 *
          ∫ x : BRRSSpace d, ‖f x‖ ^ 2 := by
      rw [Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq]

/-- A radial Schwartz input remains orthogonally invariant after the literal
BRRS annular projection.  This is an exact Fourier-symmetry reduction, not a
replacement for the analytic maximal estimate. -/
theorem brrsDyadicProjection_orthogonallyInvariant {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (f : BRRSSchwartz d)
    (hf : IsRadial (f : BRRSSpace d → Complex)) :
    IsOrthogonallyInvariant (brrsDyadicProjection Φ j f) := by
  unfold brrsDyadicProjection
  apply IsOrthogonallyInvariant.fourierInv
  have hfourier : IsOrthogonallyInvariant (𝓕 (f : BRRSSpace d → Complex)) :=
    (hf.orthogonallyInvariant).fourier
  intro A
  funext xi
  change brrsDyadicMultiplier Φ j (A xi) *
      𝓕 (f : BRRSSpace d → Complex) (A xi) = _
  have hmult : brrsDyadicMultiplier Φ j (A xi) =
      brrsDyadicMultiplier Φ j xi := by
    simpa only [Function.comp_apply] using
      congrFun (brrsDyadicMultiplier_orthogonallyInvariant Φ j A) xi
  have hF : 𝓕 (f : BRRSSpace d → Complex) (A xi) =
      𝓕 (f : BRRSSpace d → Complex) xi := by
    simpa only [Function.comp_apply] using congrFun (hfourier A) xi
  rw [hmult, hF]

/-- The literal BRRS annular projection preserves radiality of Schwartz
inputs.  This uses the converse symmetry bridge above, so it is a statement
in the norm-based radiality language of the BRRS setup. -/
theorem brrsDyadicProjection_isRadial {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (f : BRRSSchwartz d)
    (hf : IsRadial (f : BRRSSpace d → Complex)) :
    IsRadial (brrsDyadicProjection Φ j f) :=
  (brrsDyadicProjection_orthogonallyInvariant Φ j f hf).isRadial

/-- A radial Schwartz input remains orthogonally invariant after the literal
BRRS frequency-localized half-wave.  The proof combines Fourier equivariance
with the radiality of both the propagation phase and the annular cutoff. -/
theorem brrsDyadicHalfWave_orthogonallyInvariant {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) (f : BRRSSchwartz d)
    (hf : IsRadial (f : BRRSSpace d → Complex)) :
    IsOrthogonallyInvariant (brrsDyadicHalfWave Φ j t f) := by
  unfold brrsDyadicHalfWave
  apply IsOrthogonallyInvariant.fourierInv
  have hfourier : IsOrthogonallyInvariant (𝓕 (f : BRRSSpace d → Complex)) :=
    (hf.orthogonallyInvariant).fourier
  intro A
  funext xi
  change halfWaveMultiplier t (A xi) * brrsDyadicMultiplier Φ j (A xi) *
      𝓕 (f : BRRSSpace d → Complex) (A xi) = _
  have hphase : halfWaveMultiplier t (A xi) = halfWaveMultiplier t xi := by
    simpa only [Function.comp_apply] using
      congrFun (halfWaveMultiplier_orthogonallyInvariant t A) xi
  have hmult : brrsDyadicMultiplier Φ j (A xi) =
      brrsDyadicMultiplier Φ j xi := by
    simpa only [Function.comp_apply] using
      congrFun (brrsDyadicMultiplier_orthogonallyInvariant Φ j A) xi
  have hF : 𝓕 (f : BRRSSpace d → Complex) (A xi) =
      𝓕 (f : BRRSSpace d → Complex) xi := by
    simpa only [Function.comp_apply] using congrFun (hfourier A) xi
  rw [hphase, hmult, hF]

/-- The literal BRRS frequency-localized half-wave preserves radiality of
Schwartz inputs. -/
theorem brrsDyadicHalfWave_isRadial {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) (f : BRRSSchwartz d)
    (hf : IsRadial (f : BRRSSpace d → Complex)) :
    IsRadial (brrsDyadicHalfWave Φ j t f) :=
  (brrsDyadicHalfWave_orthogonallyInvariant Φ j t f hf).isRadial

/-- The physical kernel of the literal BRRS half-wave is radial.  This is
the same Fourier-equivariance argument as for a radial Schwartz input, now
applied to the radial annular half-wave symbol itself. -/
theorem brrsDyadicHalfWaveKernel_isRadial {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) :
    IsRadial (brrsDyadicHalfWaveKernel Φ j t : BRRSSpace d → Complex) := by
  apply IsOrthogonallyInvariant.isRadial
  unfold brrsDyadicHalfWaveKernel
  rw [SchwartzMap.fourierInv_coe]
  apply IsOrthogonallyInvariant.fourierInv
  intro A
  funext xi
  change halfWaveMultiplier t (A xi) * brrsDyadicMultiplier Φ j (A xi) =
    halfWaveMultiplier t xi * brrsDyadicMultiplier Φ j xi
  have hphase : halfWaveMultiplier t (A xi) = halfWaveMultiplier t xi := by
    simpa only [Function.comp_apply] using
      congrFun (halfWaveMultiplier_orthogonallyInvariant t A) xi
  have hmult : brrsDyadicMultiplier Φ j (A xi) =
      brrsDyadicMultiplier Φ j xi := by
    simpa only [Function.comp_apply] using
      congrFun (brrsDyadicMultiplier_orthogonallyInvariant Φ j A) xi
  rw [hphase, hmult]

/-- Convolution of two norm-radial complex functions on Euclidean space is
again norm-radial.  The proof uses only invariance of Lebesgue measure under
orthogonal changes of variables, so it applies even before imposing an
integrability hypothesis. -/
theorem brrsConvolution_isRadial {d : Nat}
    (K f : BRRSSpace d → Complex) (hK : IsRadial K) (hf : IsRadial f) :
    IsRadial (K ⋆[ContinuousLinearMap.mul Complex Complex, volume] f) := by
  apply IsOrthogonallyInvariant.isRadial
  intro A
  funext x
  simp only [Function.comp_apply, convolution_def]
  calc
    (∫ y : BRRSSpace d, K y * f (A x - y)) =
        ∫ y : BRRSSpace d, K (A y) * f (A x - A y) := by
      simpa only [Function.comp_apply] using
        (MeasureTheory.integral_comp A
          (fun y : BRRSSpace d => K y * f (A x - y))).symm
    _ = ∫ y : BRRSSpace d, K y * f (x - y) := by
      apply integral_congr_ae
      filter_upwards with y
      have hKA : K (A y) = K y := hK (A y) y (A.norm_map y)
      have hfA : f (A x - A y) = f (x - y) := by
        rw [← A.map_sub]
        exact hf (A (x - y)) (x - y) (A.norm_map (x - y))
      rw [hKA, hfA]

/-- The a.e. version of radiality appropriate for an `L^p` input. -/
def IsAERadial {d : Nat} (f : BRRSSpace d → Complex) : Prop :=
  ∃ g : BRRSSpace d → Complex, IsRadial g ∧ f =ᵐ[volume] g

/-- The outer `ell^p(L^p)` norm over a finite set of BRRS times. -/
def discreteLpNorm {d : Nat} (p : Real) (T : Finset Real)
    (u : Real → BRRSSpace d → Complex) : ENNReal :=
  (∑ t ∈ T, (eLpNorm (u t) (ENNReal.ofReal p) volume) ^ p) ^ (p⁻¹)

/-- The `p`-th power of the finite BRRS discrete norm is exactly the sum of
the spatial `p`-moments.  This is the measure-theoretic conversion used when
the radial interval argument first produces a bound for those moments. -/
theorem discreteLpNorm_rpow_eq_sum_lintegral_ofReal_norm_rpow
    {d : Nat} {p : Real} (hp : 0 < p) (T : Finset Real)
    (u : Real → BRRSSpace d → Complex)
    (hu : ∀ t ∈ T, AEStronglyMeasurable (u t) volume) :
    (discreteLpNorm p T u) ^ p =
      ∑ t ∈ T, ∫⁻ x : BRRSSpace d, (ENNReal.ofReal ‖u t x‖) ^ p := by
  unfold discreteLpNorm
  calc
    ((∑ t ∈ T, (eLpNorm (u t) (ENNReal.ofReal p) volume) ^ p) ^ p⁻¹) ^ p =
        ∑ t ∈ T, (eLpNorm (u t) (ENNReal.ofReal p) volume) ^ p := by
      rw [← ENNReal.rpow_mul]
      field_simp [hp.ne']
      simp
    _ = ∑ t ∈ T, ∫⁻ x : BRRSSpace d, (ENNReal.ofReal ‖u t x‖) ^ p := by
      apply Finset.sum_congr rfl
      intro t ht
      exact (Auto.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow hp (u t)
        (hu t ht)).symm

/-- A bound for the summed spatial `p`-moments converts directly to the
corresponding BRRS `ell^p(L^p)` bound. -/
theorem discreteLpNorm_le_of_sum_lintegral_ofReal_norm_rpow_le
    {d : Nat} {p : Real} (hp : 0 < p) (T : Finset Real)
    (u : Real → BRRSSpace d → Complex) {A : ENNReal}
    (hMoment : ∑ t ∈ T, ∫⁻ x : BRRSSpace d,
      (ENNReal.ofReal ‖u t x‖) ^ p ≤ A ^ p)
    (hu : ∀ t ∈ T, AEStronglyMeasurable (u t) volume) :
    discreteLpNorm p T u ≤ A := by
  apply (ENNReal.rpow_le_rpow_iff hp).mp
  rw [discreteLpNorm_rpow_eq_sum_lintegral_ofReal_norm_rpow hp T u hu]
  exact hMoment

/-- A finite real fourth-moment estimate gives the corresponding literal
`ell⁴(L⁴)` BRRS norm bound.  This is the measure-theoretic conversion used by
the planar separated-time estimate below. -/
theorem discreteLpNorm_four_le_of_sum_integral_norm_pow_four_le
    {d : Nat} (T : Finset Real) (u : Real → BRRSSpace d → Complex) {K : Real}
    (hK : 0 ≤ K)
    (hint : ∀ t ∈ T, Integrable (fun x : BRRSSpace d => ‖u t x‖ ^ 4) volume)
    (hbound : (∑ t ∈ T, ∫ x : BRRSSpace d, ‖u t x‖ ^ 4) ≤ K)
    (hu : ∀ t ∈ T, AEStronglyMeasurable (u t) volume) :
    discreteLpNorm 4 T u ≤ ENNReal.ofReal (K ^ ((4 : Real)⁻¹)) := by
  refine discreteLpNorm_le_of_sum_lintegral_ofReal_norm_rpow_le
    (by norm_num : (0 : Real) < 4) T u ?_ hu
  have hlin (t : Real) (ht : t ∈ T) :
      (∫⁻ x : BRRSSpace d, (ENNReal.ofReal ‖u t x‖) ^ (4 : Real)) =
        ENNReal.ofReal (∫ x : BRRSSpace d, ‖u t x‖ ^ 4) := by
    calc
      (∫⁻ x : BRRSSpace d, (ENNReal.ofReal ‖u t x‖) ^ (4 : Real)) =
          ∫⁻ x : BRRSSpace d, ENNReal.ofReal (‖u t x‖ ^ (4 : Real)) := by
        apply lintegral_congr
        intro x
        exact ENNReal.ofReal_rpow_of_nonneg
          (x := ‖u t x‖) (p := (4 : Real)) (norm_nonneg _) (by norm_num)
      _ = ∫⁻ x : BRRSSpace d, ENNReal.ofReal (‖u t x‖ ^ 4) := by
        apply lintegral_congr
        intro x
        exact congrArg ENNReal.ofReal (Real.rpow_natCast _ 4)
      _ = ENNReal.ofReal (∫ x : BRRSSpace d, ‖u t x‖ ^ 4) :=
        (ofReal_integral_eq_lintegral_ofReal (hint t ht)
          (Filter.Eventually.of_forall fun _ => pow_nonneg (norm_nonneg _) _)).symm
  have hsum :
      (∑ t ∈ T, ∫⁻ x : BRRSSpace d, (ENNReal.ofReal ‖u t x‖) ^ (4 : Real)) =
        ENNReal.ofReal (∑ t ∈ T, ∫ x : BRRSSpace d, ‖u t x‖ ^ 4) := by
    calc
      (∑ t ∈ T, ∫⁻ x : BRRSSpace d, (ENNReal.ofReal ‖u t x‖) ^ (4 : Real)) =
          ∑ t ∈ T, ENNReal.ofReal (∫ x : BRRSSpace d, ‖u t x‖ ^ 4) := by
        apply Finset.sum_congr rfl
        intro t ht
        exact hlin t ht
      _ = ENNReal.ofReal (∑ t ∈ T, ∫ x : BRRSSpace d, ‖u t x‖ ^ 4) := by
        rw [ENNReal.ofReal_sum_of_nonneg]
        intro t ht
        exact integral_nonneg fun _ => pow_nonneg (norm_nonneg _) _
  have hMoment :
      (∑ t ∈ T, ∫⁻ x : BRRSSpace d, (ENNReal.ofReal ‖u t x‖) ^ (4 : Real)) ≤
        ENNReal.ofReal K := by
    rw [hsum]
    exact ENNReal.ofReal_le_ofReal hbound
  have hroot :
      (ENNReal.ofReal (K ^ ((4 : Real)⁻¹))) ^ (4 : Real) = ENNReal.ofReal K := by
    rw [← ENNReal.ofReal_rpow_of_nonneg hK
      (by positivity : 0 ≤ (4 : Real)⁻¹),
      ENNReal.rpow_inv_rpow (by norm_num : (4 : Real) ≠ 0)]
  rw [hroot]
  exact hMoment

/-- The exact `ell⁴(L⁴)` version of the planar separated-time estimate.  It
is stated with the two source-normalized dyadic contributions still factored,
so later entropy arguments can choose how to combine their common final
power of `2^j`. -/
theorem exists_auxiliaryDyadicHalfWave_discreteLpNorm_four_source_bound
    (C : lpCutoffs 2) {rho : Real}
    (hgain : Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 rho) :
    ∃ A B : Real, 0 < A ∧ 0 < B ∧ ∀ (j : Nat), 1 ≤ j →
      ∀ (T : Finset Real), IsDyadicDiscretization (Icc (1 : Real) 2) j T →
      ∀ f : BRRSSchwartz 2,
      discreteLpNorm 4 T (fun t => dyadicHalfWave C j t f) ≤
        ENNReal.ofReal
          ((16 * (dyadicTimeScale j)⁻¹ *
              (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) *
                ∫ x : BRRSSpace 2, ‖f x‖ ^ 4) +
            8 * (dyadicTimeScale j) ^ 3 *
              (((2 : Real) ^ j) ^ 4 *
                (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) *
                  (B * ∫ x : BRRSSpace 2, ‖f x‖ ^ 4)))) ^ ((4 : Real)⁻¹)) := by
  obtain ⟨A, B, hA, hB, hsource⟩ :=
    exists_auxiliaryDyadicHalfWave_separatedSamplingFour_source_bound C hgain
  refine ⟨A, B, hA, hB, ?_⟩
  intro j hj T hT f
  let E : Real := ∫ x : BRRSSpace 2, ‖f x‖ ^ 4
  let δ : Real := dyadicTimeScale j
  let q : Real := (2 : Real) ^ j
  let S : Real := (2 : Real) ^ ((j : Real) * (1 - 4 * rho))
  let K : Real :=
    16 * δ⁻¹ * (A ^ 4 * S * E) +
      8 * δ ^ 3 * (q ^ 4 * (A ^ 4 * S * (B * E)))
  have hE : 0 ≤ E := by
    dsimp [E]
    exact integral_nonneg fun _ => pow_nonneg (norm_nonneg _) _
  have hδ : 0 < δ := by
    dsimp [δ]
    unfold dyadicTimeScale
    positivity
  have hq : 0 ≤ q := by
    dsimp [q]
    positivity
  have hS : 0 ≤ S := by
    dsimp [S]
    exact Real.rpow_nonneg (by norm_num) _
  have hK : 0 ≤ K := by
    dsimp [K]
    apply add_nonneg
    · exact mul_nonneg
        (mul_nonneg (by norm_num) (inv_nonneg.mpr hδ.le))
        (mul_nonneg (mul_nonneg (pow_nonneg hA.le _) hS) hE)
    · exact mul_nonneg
        (mul_nonneg (by norm_num) (pow_nonneg hδ.le _))
        (mul_nonneg (pow_nonneg hq _)
          (mul_nonneg (mul_nonneg (pow_nonneg hA.le _) hS) (mul_nonneg hB.le hE)))
  have hmoment :
      (∑ t ∈ T, ∫ x : BRRSSpace 2, ‖dyadicHalfWave C j t f x‖ ^ 4) ≤ K := by
    change (∑ t ∈ T, ∫ x : BRRSSpace 2, ‖dyadicHalfWave C j t f x‖ ^ 4) ≤
      16 * (dyadicTimeScale j)⁻¹ *
        (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) *
          ∫ x : BRRSSpace 2, ‖f x‖ ^ 4) +
      8 * (dyadicTimeScale j) ^ 3 *
        (((2 : Real) ^ j) ^ 4 *
          (A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * rho)) *
            (B * ∫ x : BRRSSpace 2, ‖f x‖ ^ 4)))
    exact hsource j hj T hT f
  change discreteLpNorm 4 T (fun t => dyadicHalfWave C j t f) ≤
    ENNReal.ofReal (K ^ ((4 : Real)⁻¹))
  exact discreteLpNorm_four_le_of_sum_integral_norm_pow_four_le T
    (fun t => dyadicHalfWave C j t f) hK
    (fun t _ => auxiliaryDyadicHalfWave_integrable_norm_pow_four C j t f) hmoment
    (fun t _ => by
      rw [auxiliaryDyadicHalfWave_eq_mss]
      exact ((Auto.Spherical.MSS.continuous_dyadicHalfWaveSpaceTime C .plus j f).comp
        (continuous_id.prodMk continuous_const)).aestronglyMeasurable)

/-- The clean `ell⁴(L⁴)` rate corresponding to
`exists_auxiliaryDyadicHalfWave_separatedSamplingFour_rate`.  Its fourth
power has the natural raw-half-wave exponent `2 - 4ρ`; the displayed fourth
root is therefore the directly usable `1 / 2 - ρ` dyadic rate. -/
theorem exists_auxiliaryDyadicHalfWave_discreteLpNorm_four_rate
    (C : lpCutoffs 2) {rho : Real}
    (hgain : Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 rho) :
    ∃ K : Real, 0 < K ∧ ∀ (j : Nat), 1 ≤ j →
      ∀ (T : Finset Real), IsDyadicDiscretization (Icc (1 : Real) 2) j T →
      ∀ f : BRRSSchwartz 2,
      discreteLpNorm 4 T (fun t => dyadicHalfWave C j t f) ≤
        ENNReal.ofReal
          ((K * (2 : Real) ^ ((j : Real) * (2 - 4 * rho)) *
            ∫ x : BRRSSpace 2, ‖f x‖ ^ 4) ^ ((4 : Real)⁻¹)) := by
  obtain ⟨K, hK, hmoment⟩ :=
    exists_auxiliaryDyadicHalfWave_separatedSamplingFour_rate C hgain
  refine ⟨K, hK, ?_⟩
  intro j hj T hT f
  let E : Real := ∫ x : BRRSSpace 2, ‖f x‖ ^ 4
  let S : Real := (2 : Real) ^ ((j : Real) * (2 - 4 * rho))
  have hE : 0 ≤ E := by
    dsimp [E]
    exact integral_nonneg fun _ => pow_nonneg (norm_nonneg _) _
  have hS : 0 ≤ S := by
    dsimp [S]
    exact Real.rpow_nonneg (by norm_num) _
  have hbound :
      (∑ t ∈ T, ∫ x : BRRSSpace 2, ‖dyadicHalfWave C j t f x‖ ^ 4) ≤
        K * S * E := by
    change (∑ t ∈ T, ∫ x : BRRSSpace 2, ‖dyadicHalfWave C j t f x‖ ^ 4) ≤
      K * (2 : Real) ^ ((j : Real) * (2 - 4 * rho)) *
        ∫ x : BRRSSpace 2, ‖f x‖ ^ 4
    exact hmoment j hj T hT f
  change discreteLpNorm 4 T (fun t => dyadicHalfWave C j t f) ≤
    ENNReal.ofReal ((K * S * E) ^ ((4 : Real)⁻¹))
  exact discreteLpNorm_four_le_of_sum_integral_norm_pow_four_le T
    (fun t => dyadicHalfWave C j t f)
    (mul_nonneg (mul_nonneg hK.le hS) hE)
    (fun t _ => auxiliaryDyadicHalfWave_integrable_norm_pow_four C j t f) hbound
    (fun t _ => by
      rw [auxiliaryDyadicHalfWave_eq_mss]
      exact ((Auto.Spherical.MSS.continuous_dyadicHalfWaveSpaceTime C .plus j f).comp
        (continuous_id.prodMk continuous_const)).aestronglyMeasurable)

/-- At `p = 2`, squaring the `L²` seminorm recovers the ordinary real
energy integral. -/
theorem eLpNorm_two_rpow_eq_integral_norm_sq {d : Nat}
    (u : BRRSSpace d → Complex) (hmem : MemLp u 2 volume) :
    (eLpNorm u 2 volume) ^ (2 : Real) =
      ENNReal.ofReal (∫ x : BRRSSpace d, ‖u x‖ ^ 2) := by
  rw [hmem.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
  norm_num
  rw [← ENNReal.ofReal_pow]
  · congr 1
    let I : Real := ∫ x : BRRSSpace d, ‖u x‖ ^ 2
    have hI : 0 ≤ I := by
      dsimp [I]
      exact integral_nonneg fun _ => sq_nonneg _
    have hpow := Real.rpow_inv_natCast_pow (x := I) (n := 2) hI (by norm_num)
    change (I ^ (1 / 2)) ^ 2 = I
    norm_num at hpow ⊢
    exact hpow
  · exact Real.rpow_nonneg (integral_nonneg fun _ => sq_nonneg _) _

/-- The literal BRRS discrete norm at `p = 2` is exactly the square root of
the finite sum of spatial energies, provided its time slices are in `L²`. -/
theorem discreteLpNorm_two_eq_l2Energy {d : Nat} (T : Finset Real)
    (u : Real → BRRSSpace d → Complex)
    (hmem : ∀ t ∈ T, MemLp (u t) 2 volume) :
    discreteLpNorm 2 T u =
      (ENNReal.ofReal (∑ t ∈ T, ∫ x : BRRSSpace d, ‖u t x‖ ^ 2)) ^
        ((2 : Real)⁻¹) := by
  classical
  unfold discreteLpNorm
  simp only [ENNReal.ofReal_ofNat]
  have hsum :
      (∑ t ∈ T, (eLpNorm (u t) 2 volume) ^ (2 : Real)) =
        ENNReal.ofReal (∑ t ∈ T, ∫ x : BRRSSpace d, ‖u t x‖ ^ 2) := by
    calc
      (∑ t ∈ T, (eLpNorm (u t) 2 volume) ^ (2 : Real)) =
          ∑ t ∈ T, ENNReal.ofReal (∫ x : BRRSSpace d, ‖u t x‖ ^ 2) := by
        apply Finset.sum_congr rfl
        intro t ht
        exact eLpNorm_two_rpow_eq_integral_norm_sq (u t) (hmem t ht)
      _ = ENNReal.ofReal (∑ t ∈ T, ∫ x : BRRSSpace d, ‖u t x‖ ^ 2) := by
        rw [ENNReal.ofReal_sum_of_nonneg]
        intro t ht
        exact integral_nonneg fun _ => sq_nonneg _
  rw [hsum]

/-- The existing planar auxiliary Littlewood--Paley half-wave has `L²`
time slices, so the literal discrete BRRS norm can be applied to it at the
endpoint. -/
theorem auxiliaryDyadicHalfWave_memLp_two (C : lpCutoffs 2) (j : Nat)
    (t : Real) (f : BRRSSchwartz 2) :
    MemLp (dyadicHalfWave C j t f) 2 volume := by
  rw [auxiliaryDyadicHalfWave_eq_mss]
  refine (memLp_two_iff_integrable_sq_norm ?_).mpr ?_
  · exact ((Auto.Spherical.MSS.continuous_dyadicHalfWaveSpaceTime C .plus j f).comp
      (continuous_id.prodMk continuous_const)).aestronglyMeasurable
  · exact Auto.Spherical.MSS.integrable_norm_sq_dyadicHalfWave C .plus j t f

/-- The finite auxiliary `L²` energy estimates above are therefore a
literal `discreteLpNorm` estimate in squared form. -/
theorem discreteLpNorm_two_auxiliaryDyadicHalfWave_eq_l2Energy
    (C : lpCutoffs 2) (j : Nat) (T : Finset Real) (f : BRRSSchwartz 2) :
    discreteLpNorm 2 T (fun t => dyadicHalfWave C j t f) =
      (ENNReal.ofReal (∑ t ∈ T, ∫ x : BRRSSpace 2,
        ‖dyadicHalfWave C j t f x‖ ^ 2)) ^ ((2 : Real)⁻¹) := by
  apply discreteLpNorm_two_eq_l2Energy
  intro t ht
  exact auxiliaryDyadicHalfWave_memLp_two C j t f

/-- The literal BRRS annular half-wave has an `L²` time slice at every
scale.  This is a genuine Schwartz-multiplier statement: the annular
half-wave symbol is converted above into a Schwartz map before applying the
Fourier inversion facts. -/
theorem brrsDyadicHalfWave_memLp_two {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) (f : BRRSSchwartz d) :
    MemLp (brrsDyadicHalfWave Φ j t f) 2 volume := by
  let g : BRRSSchwartz d := SchwartzMap.smulLeftCLM Complex
    (brrsDyadicHalfWaveSchwartzSymbol Φ j t : BRRSSpace d → Complex) (𝓕 f)
  have hg : (g : BRRSSpace d → Complex) = fun xi : BRRSSpace d =>
      brrsDyadicHalfWaveSchwartzSymbol Φ j t xi * 𝓕 f xi := by
    funext xi
    simp only [g, SchwartzMap.smulLeftCLM_apply
      (brrsDyadicHalfWaveSchwartzSymbol Φ j t).hasTemperateGrowth, smul_eq_mul]
  have hhalf : brrsDyadicHalfWave Φ j t f = 𝓕⁻ (g : BRRSSpace d → Complex) := by
    funext x
    rw [brrsDyadicHalfWave, hg]
    simp only [brrsDyadicHalfWaveSchwartzSymbol_apply,
      brrsDyadicHalfWaveSymbol, SchwartzMap.fourier_coe]
  refine (memLp_two_iff_integrable_sq_norm ?_).mpr ?_
  · rw [hhalf]
    exact
      (Auto.Spherical.BRRS.continuous_fourierInv_schwartz g).aestronglyMeasurable
  · rw [hhalf, hg]
    exact Auto.Spherical.Auxiliary.integrable_norm_sq_fourierInv_schwartz_multiplier
      (brrsDyadicHalfWaveSchwartzSymbol Φ j t) (𝓕 f)

/-- The literal BRRS discrete `L²` norm is the square root of its finite
sum of spatial energies. -/
theorem discreteLpNorm_two_brrsDyadicHalfWave_eq_l2Energy {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (T : Finset Real) (f : BRRSSchwartz d) :
    discreteLpNorm 2 T (fun t => brrsDyadicHalfWave Φ j t f) =
      (ENNReal.ofReal (∑ t ∈ T, ∫ x : BRRSSpace d,
        ‖brrsDyadicHalfWave Φ j t f x‖ ^ 2)) ^ ((2 : Real)⁻¹) := by
  apply discreteLpNorm_two_eq_l2Energy
  intro t ht
  exact brrsDyadicHalfWave_memLp_two Φ j t f

/-- A finite real `L²` energy bound converts directly into the literal
BRRS discrete norm estimate.  Keeping this elementary square-root step
separate makes it reusable for both entropy and sampling estimates. -/
theorem discreteLpNorm_two_le_of_l2Energy_le {d : Nat} (T : Finset Real)
    (u : Real → BRRSSpace d → Complex) (f : BRRSSpace d → Complex)
    (hmemU : ∀ t ∈ T, MemLp (u t) 2 volume) (hmemF : MemLp f 2 volume)
    {A : Real} (hA : 0 ≤ A)
    (henergy : (∑ t ∈ T, ∫ x : BRRSSpace d, ‖u t x‖ ^ 2) ≤
      A ^ 2 * ∫ x : BRRSSpace d, ‖f x‖ ^ 2) :
    discreteLpNorm 2 T u ≤ ENNReal.ofReal A * eLpNorm f 2 volume := by
  rw [discreteLpNorm_two_eq_l2Energy T u hmemU]
  apply (ENNReal.rpow_le_rpow_iff (by norm_num : (0 : Real) < 2)).mp
  calc
    (ENNReal.ofReal (∑ t ∈ T, ∫ x : BRRSSpace d, ‖u t x‖ ^ 2) ^
      ((2 : Real)⁻¹)) ^ (2 : Real) =
        ENNReal.ofReal (∑ t ∈ T, ∫ x : BRRSSpace d, ‖u t x‖ ^ 2) := by
      rw [(ENNReal.rpow_mul _ _ _).symm]
      norm_num
    _ ≤ ENNReal.ofReal (A ^ 2 * ∫ x : BRRSSpace d, ‖f x‖ ^ 2) :=
      ENNReal.ofReal_le_ofReal henergy
    _ = (ENNReal.ofReal A * eLpNorm f 2 volume) ^ (2 : Real) := by
      rw [ENNReal.ofReal_mul (sq_nonneg A)]
      rw [ENNReal.ofReal_pow hA 2]
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : Real) ≤ 2)]
      rw [eLpNorm_two_rpow_eq_integral_norm_sq f hmemF]
      exact congrArg (fun z => z * ENNReal.ofReal
        (∫ x : BRRSSpace d, ‖f x‖ ^ 2))
        (ENNReal.rpow_two (ENNReal.ofReal A)).symm

/-- Summing the literal fixed-time Plancherel endpoint over finitely many
times.  Time-set geometry enters only through the cardinality factor. -/
theorem brrsDyadicHalfWave_l2Sum_le_card {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (T : Finset Real) (f : BRRSSchwartz d) :
    (∑ t ∈ T, ∫ x : BRRSSpace d, ‖brrsDyadicHalfWave Φ j t f x‖ ^ 2) ≤
      (SchwartzMap.seminorm Complex 0 0 Φ.symbol) ^ 2 * (T.card : Real) *
        ∫ x : BRRSSpace d, ‖f x‖ ^ 2 := by
  calc
    (∑ t ∈ T, ∫ x : BRRSSpace d, ‖brrsDyadicHalfWave Φ j t f x‖ ^ 2) ≤
        ∑ _t ∈ T, (SchwartzMap.seminorm Complex 0 0 Φ.symbol) ^ 2 *
          ∫ x : BRRSSpace d, ‖f x‖ ^ 2 := by
      apply Finset.sum_le_sum
      intro t _ht
      exact fixedTimeL2_brrsDyadicHalfWave Φ j t f
    _ = (SchwartzMap.seminorm Complex 0 0 Φ.symbol) ^ 2 * (T.card : Real) *
        ∫ x : BRRSSpace d, ‖f x‖ ^ 2 := by
      simp only [Finset.sum_const, nsmul_eq_mul]
      ring

/-- The fixed-time Sobolev exponent `s_p` in BRRS. -/
def sobolevExponent (d : Nat) (p : Real) : Real :=
  ((d : Real) - 1) * (1 / 2 - 1 / p)

/-- The critical exponent in BRRS Theorem 1.1, once the Legendre--Assouad
function is supplied. -/
def criticalExponent (nu : Set Real → Real → Real) (E : Set Real)
    (d : Nat) (p : Real) : Real :=
  nu E (p * sobolevExponent d p) / p

/-- At the Hilbert endpoint the BRRS Sobolev loss vanishes, so the
critical exponent is exactly one half of the zero-penalty entropy value.
Keeping this elementary identity named avoids repeatedly unfolding the
normalization in the upper and sharpness arguments. -/
theorem criticalExponent_p_two (nu : Set Real → Real → Real) (E : Set Real)
    (d : Nat) :
    criticalExponent nu E d 2 = nu E 0 / 2 := by
  unfold criticalExponent sobolevExponent
  ring

/-- The fixed-time Sobolev exponent in BRRS is nonnegative throughout the
range of Theorem 1.1.  This is the sign input needed when the local entropy
penalty is evaluated at `p * s_p`. -/
theorem sobolevExponent_nonneg {d : Nat} {p : Real}
    (hd : 2 ≤ d) (hp : 2 ≤ p) :
    0 ≤ sobolevExponent d p := by
  unfold sobolevExponent
  have hdreal : (2 : Real) ≤ (d : Real) := by
    exact_mod_cast hd
  have hd' : 0 ≤ (d : Real) - 1 := by
    linarith
  have hp' : 0 ≤ 1 / 2 - 1 / p := by
    rw [sub_nonneg]
    exact one_div_le_one_div_of_le (by norm_num) hp
  exact mul_nonneg hd' hp'

/-- Below the Hilbert exponent, the BRRS fixed-time Sobolev exponent has the
opposite sign.  This is the sign which forces the lower, rather than upper,
endpoint of a dyadic source annulus in the low-`p` part of Section 5. -/
theorem sobolevExponent_nonpos {d : Nat} {p : Real}
    (hd : 2 ≤ d) (hp_pos : 0 < p) (hp : p ≤ 2) :
    sobolevExponent d p ≤ 0 := by
  unfold sobolevExponent
  have hdreal : (2 : Real) ≤ (d : Real) := by
    exact_mod_cast hd
  have hd' : 0 ≤ (d : Real) - 1 := by
    linarith
  have hp' : 1 / 2 - 1 / p ≤ 0 := by
    rw [sub_nonpos]
    exact one_div_le_one_div_of_le hp_pos hp
  exact mul_nonpos_of_nonneg_of_nonpos hd' hp'

/-- The entropy penalty appearing in the BRRS critical exponent is
nonnegative in the theorem range. -/
theorem mul_sobolevExponent_nonneg {d : Nat} {p : Real}
    (hd : 2 ≤ d) (hp : 2 ≤ p) :
    0 ≤ p * sobolevExponent d p :=
  mul_nonneg (le_trans zero_le_two hp) (sobolevExponent_nonneg hd hp)

/-- Clearing the harmless factor `p` in the BRRS Sobolev loss gives the
linear form which determines the high-`p` transition. -/
theorem mul_sobolevExponent_eq {d : Nat} {p : Real} (hp : p ≠ 0) :
    p * sobolevExponent d p = ((d : Real) - 1) * (p / 2 - 1) := by
  unfold sobolevExponent
  field_simp [hp]

/-- Once the entropy penalty has reached one, the Legendre--Assouad value is
exactly that penalty.  Consequently the BRRS critical exponent is the
fixed-time Sobolev exponent.  This is the algebraic endpoint used in the
high-`p` interpolation step. -/
theorem criticalExponent_eq_sobolevExponent_of_one_le_penalty
    {d : Nat} {E : Set Real} {p : Real} (hE : E.Nonempty) (hp : 0 < p)
    (hpenalty : 1 ≤ p * sobolevExponent d p) :
    criticalExponent Auto.Spherical.BRRS.brrsLegendreAssouadFunction E d p =
      sobolevExponent d p := by
  unfold criticalExponent
  rw [Auto.Spherical.BRRS.brrsLegendreAssouadFunction_eq_of_nonempty_of_one_le
    hE hpenalty]
  field_simp [hp.ne']

/-- The affine-tail calculation does not intrinsically depend on the coarse
`α ≥ 1` tail theorem.  Whenever a Legendre--Assouad value is known to equal
its penalty (for example, above the quasi-Assouad threshold), the BRRS
critical exponent is exactly the fixed-time Sobolev exponent. -/
theorem criticalExponent_eq_sobolevExponent_of_value_eq
    {nu : Set Real → Real → Real} {d : Nat} {E : Set Real} {p : Real}
    (hp : p ≠ 0)
    (hvalue : nu E (p * sobolevExponent d p) = p * sobolevExponent d p) :
    criticalExponent nu E d p = sobolevExponent d p := by
  unfold criticalExponent
  rw [hvalue]
  field_simp [hp]

/-- The exact interpolation-rate identity in any affine tail of the
Legendre--Assouad function.  This is the form used with the quasi-Assouad
tail `ν_E^♯(α) = α`, whose threshold can be strictly below one. -/
theorem interpolated_criticalExponent_eq_criticalExponent_of_value_eq
    {nu : Set Real → Real → Real} {d : Nat} {E : Set Real}
    {p₀ p : Real} (hp₀ : p₀ ≠ 0) (hp : p ≠ 0)
    (hvalue₀ : nu E (p₀ * sobolevExponent d p₀) =
      p₀ * sobolevExponent d p₀)
    (hvalue : nu E (p * sobolevExponent d p) =
      p * sobolevExponent d p) :
    (1 - (1 - p₀ / p)) * criticalExponent nu E d p₀ +
      (1 - p₀ / p) * ((d : Real) - 1) / 2 =
        criticalExponent nu E d p := by
  rw [criticalExponent_eq_sobolevExponent_of_value_eq hp₀ hvalue₀,
    criticalExponent_eq_sobolevExponent_of_value_eq hp hvalue]
  unfold sobolevExponent
  field_simp [hp₀, hp]
  ring

/-- In the affine tail of the Legendre--Assouad function, interpolating a
lower `L^{p₀}` estimate with the fixed-time `L^∞` rate gives exactly the BRRS
critical exponent at `p`.  This is the rate identity needed by the high-`p`
Riesz--Thorin step; the analytic issue is separately to supply the two
endpoint estimates for one common finite-time operator. -/
theorem interpolated_criticalExponent_eq_criticalExponent_of_one_le_penalties
    {d : Nat} {E : Set Real} {p₀ p : Real} (hE : E.Nonempty)
    (hp₀ : 0 < p₀) (hp : 0 < p)
    (hpenalty₀ : 1 ≤ p₀ * sobolevExponent d p₀)
    (hpenalty : 1 ≤ p * sobolevExponent d p) :
    (1 - (1 - p₀ / p)) *
        criticalExponent Auto.Spherical.BRRS.brrsLegendreAssouadFunction E d p₀ +
      (1 - p₀ / p) * ((d : Real) - 1) / 2 =
        criticalExponent Auto.Spherical.BRRS.brrsLegendreAssouadFunction E d p := by
  rw [criticalExponent_eq_sobolevExponent_of_one_le_penalty hE hp₀ hpenalty₀,
    criticalExponent_eq_sobolevExponent_of_one_le_penalty hE hp hpenalty]
  unfold sobolevExponent
  field_simp [hp₀.ne', hp.ne']
  ring

/-- Interpolation directly from the Hilbert endpoint retains the explicit
zero-penalty entropy loss.  Thus the `p = 2` estimate alone cannot yield the
sharp high-`p` BRRS exponent unless `ν_E^♯(0) = 0`; one instead interpolates
from a lower exponent already in the affine tail, as in the preceding lemma. -/
theorem interpolated_p_two_criticalExponent_eq_criticalExponent_add_entropy_loss
    {d : Nat} {E : Set Real} {p : Real} (hE : E.Nonempty) (hp : 0 < p)
    (hpenalty : 1 ≤ p * sobolevExponent d p) :
    (1 - (1 - 2 / p)) *
        criticalExponent Auto.Spherical.BRRS.brrsLegendreAssouadFunction E d 2 +
      (1 - 2 / p) * ((d : Real) - 1) / 2 =
        criticalExponent Auto.Spherical.BRRS.brrsLegendreAssouadFunction E d p +
          Auto.Spherical.BRRS.brrsLegendreAssouadFunction E 0 / p := by
  rw [criticalExponent_p_two,
    criticalExponent_eq_sobolevExponent_of_one_le_penalty hE hp hpenalty]
  unfold sobolevExponent
  field_simp [hp.ne']
  ring

/-- An a.e. bounded linear `L^p` realization of the Fourier-defined operator
`e^{it√{-Δ}} P_j`.

Mathlib represents `L^p` elements by functions modulo a.e. equality, while
the Fourier integral below starts on Schwartz functions.  This interface
records a chosen representative of the standard `L^p` extension, rather than
silently treating the Schwartz formula as defined pointwise on every `L^p`
function.  The main BRRS target existentially chooses this interface, rather
than silently treating the Schwartz formula as defined pointwise on every
`L^p` function. -/
structure BRRSLpHalfWaveExtension (d : Nat) (Φ : BRRSAnnularCutoff) where
  apply : Nat → Real → (BRRSSpace d → Complex) → BRRSSpace d → Complex
  congr_ae : ∀ (j : Nat) (t : Real) {f g : BRRSSpace d → Complex},
    f =ᵐ[volume] g → apply j t f =ᵐ[volume] apply j t g
  extends_schwartz : ∀ (j : Nat) (t : Real) (f : BRRSSchwartz d),
    apply j t (f : BRRSSpace d → Complex) =ᵐ[volume] brrsDyadicHalfWave Φ j t f
  maps_memLp : ∀ (j : Nat) (t p : Real), 1 ≤ p →
    ∀ {f : BRRSSpace d → Complex}, MemLp f (ENNReal.ofReal p) volume →
      MemLp (apply j t f) (ENNReal.ofReal p) volume
  map_add_ae : ∀ (j : Nat) (t p : Real), 1 ≤ p →
    ∀ {f g : BRRSSpace d → Complex}, MemLp f (ENNReal.ofReal p) volume →
      MemLp g (ENNReal.ofReal p) volume →
      apply j t (f + g) =ᵐ[volume] (apply j t f + apply j t g)
  map_smul_ae : ∀ (j : Nat) (t p : Real), 1 ≤ p →
    ∀ (c : Complex) {f : BRRSSpace d → Complex},
      MemLp f (ENNReal.ofReal p) volume →
      apply j t (c • f) =ᵐ[volume] (c • apply j t f)
  bounded_on_Lp : ∀ (j : Nat) (t p : Real), 1 ≤ p →
    ∃ K : Real, 0 ≤ K ∧ ∀ f : BRRSSpace d → Complex,
      MemLp f (ENNReal.ofReal p) volume →
        eLpNorm (apply j t f) (ENNReal.ofReal p) volume ≤
          ENNReal.ofReal K * eLpNorm f (ENNReal.ofReal p) volume

/-- The canonical `Lᵖ` realization of the BRRS annular half-wave: convolution
by its inverse-Fourier Schwartz kernel.  All fields are proved directly from
the dimension-generic Young development above, so this is not an abstract
choice of representatives. -/
noncomputable def brrsLpHalfWaveExtension {d : Nat}
    (Φ : BRRSAnnularCutoff) : BRRSLpHalfWaveExtension d Φ where
  apply j t f :=
    (brrsDyadicHalfWaveKernel Φ j t : BRRSSpace d → Complex)
      ⋆[ContinuousLinearMap.mul Complex Complex, volume] f
  congr_ae := by
    intro j t f g hfg
    apply Eventually.of_forall
    intro x
    exact congrFun
      (convolution_congr (ContinuousLinearMap.mul Complex Complex)
        (Eventually.of_forall fun _ => rfl) hfg) x
  extends_schwartz := by
    intro j t f
    apply Eventually.of_forall
    intro x
    exact (brrsDyadicHalfWave_eq_kernel_convolution Φ j t f x).symm
  maps_memLp := by
    intro j t p hp f hf
    exact brrs_memLp_schwartz_convolution_of_memLp
      (brrsDyadicHalfWaveKernel Φ j t) p hp hf
  map_add_ae := by
    intro j t p hp f g hf hg
    apply Eventually.of_forall
    intro x
    exact congrFun
      ((brrs_convolutionExists_of_memLp (brrsDyadicHalfWaveKernel Φ j t) p hp hf).distrib_add
        (brrs_convolutionExists_of_memLp (brrsDyadicHalfWaveKernel Φ j t) p hp hg)) x
  map_smul_ae := by
    intro j t _p _hp c f _hf
    apply Eventually.of_forall
    intro x
    exact congrFun
      (convolution_smul
        (f := (brrsDyadicHalfWaveKernel Φ j t : BRRSSpace d → Complex))
        (g := f) (y := c)) x
  bounded_on_Lp := by
    intro j t p hp
    refine ⟨∫ y : BRRSSpace d, ‖brrsDyadicHalfWaveKernel Φ j t y‖,
      integral_nonneg fun _ => norm_nonneg _, ?_⟩
    intro f hf
    calc
      eLpNorm
          ((brrsDyadicHalfWaveKernel Φ j t : BRRSSpace d → Complex)
            ⋆[ContinuousLinearMap.mul Complex Complex, volume] f) (ENNReal.ofReal p) volume ≤
          (∫⁻ y : BRRSSpace d, ‖brrsDyadicHalfWaveKernel Φ j t y‖ₑ) *
            eLpNorm f (ENNReal.ofReal p) volume :=
        brrs_eLpNorm_schwartz_convolution_le_of_memLp
          (brrsDyadicHalfWaveKernel Φ j t) p hp hf
      _ = ENNReal.ofReal (∫ y : BRRSSpace d, ‖brrsDyadicHalfWaveKernel Φ j t y‖) *
            eLpNorm f (ENNReal.ofReal p) volume := by
        rw [← ofReal_integral_norm_eq_lintegral_enorm
          (brrsDyadicHalfWaveKernel Φ j t).integrable]

/-- The canonical convolution realization of the BRRS half-wave preserves
radiality modulo null sets.  This allows the full `Lᵖ` formulation to retain
the radial input class, rather than only its Schwartz core. -/
theorem brrsLpHalfWaveExtension_apply_isAERadial {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f : BRRSSpace d → Complex) (hf : IsAERadial f) :
    IsAERadial ((brrsLpHalfWaveExtension Φ).apply j t f) := by
  rcases hf with ⟨g, hg, hfg⟩
  refine ⟨(brrsDyadicHalfWaveKernel Φ j t : BRRSSpace d → Complex)
      ⋆[ContinuousLinearMap.mul Complex Complex, volume] g, ?_, ?_⟩
  · exact brrsConvolution_isRadial
      (brrsDyadicHalfWaveKernel Φ j t : BRRSSpace d → Complex) g
      (brrsDyadicHalfWaveKernel_isRadial Φ j t) hg
  · change ((brrsDyadicHalfWaveKernel Φ j t : BRRSSpace d → Complex)
      ⋆[ContinuousLinearMap.mul Complex Complex, volume] f) =ᵐ[volume]
        ((brrsDyadicHalfWaveKernel Φ j t : BRRSSpace d → Complex)
          ⋆[ContinuousLinearMap.mul Complex Complex, volume] g)
    apply Eventually.of_forall
    intro x
    exact congrFun
      (convolution_congr (ContinuousLinearMap.mul Complex Complex)
        (Eventually.of_forall fun _ => rfl) hfg) x

/-- The canonical representative is an honest `L²` function when its input
is represented by an `L²` element. -/
theorem brrsLpHalfWaveExtension_apply_memLp_two {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (F : Lp Complex 2 (volume : Measure (BRRSSpace d))) :
    MemLp ((brrsLpHalfWaveExtension Φ).apply j t F) 2 volume := by
  simpa only [ENNReal.ofReal_ofNat] using
    (brrsLpHalfWaveExtension Φ).maps_memLp j t 2 (by norm_num)
      (by simpa only [ENNReal.ofReal_ofNat] using (Lp.memLp F))

/-- The canonical convolution realization, viewed as a bounded linear map
on `L²`.  Its coarse continuity bound comes from Young's inequality; the
sharp Fourier-side norm is established separately below. -/
noncomputable def brrsLpHalfWaveExtensionL2Map {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) :
    Lp Complex 2 (volume : Measure (BRRSSpace d)) →L[Complex]
      Lp Complex 2 (volume : Measure (BRRSSpace d)) :=
  LinearMap.mkContinuousOfExistsBound
    { toFun := fun F =>
        (brrsLpHalfWaveExtension_apply_memLp_two Φ j t F).toLp
          ((brrsLpHalfWaveExtension Φ).apply j t F)
      map_add' := by
        intro F G
        refine Lp.ext ?_
        have hFG : MemLp ((F + G : Lp Complex 2
            (volume : Measure (BRRSSpace d))) : BRRSSpace d → Complex) 2 volume :=
          Lp.memLp (F + G)
        have hF : MemLp (F : BRRSSpace d → Complex) 2 volume := Lp.memLp F
        have hG : MemLp (G : BRRSSpace d → Complex) 2 volume := Lp.memLp G
        have hFGcoe :
            ((F + G : Lp Complex 2 (volume : Measure (BRRSSpace d))) :
              BRRSSpace d → Complex) =ᵐ[volume]
              (F : BRRSSpace d → Complex) + (G : BRRSSpace d → Complex) :=
          Lp.coeFn_add F G
        calc
          (((brrsLpHalfWaveExtension_apply_memLp_two Φ j t
              (F + G : Lp Complex 2 (volume : Measure (BRRSSpace d)))).toLp
              ((brrsLpHalfWaveExtension Φ).apply j t
                ((F + G : Lp Complex 2 (volume : Measure (BRRSSpace d))) :
                  BRRSSpace d → Complex)) :
              Lp Complex 2 (volume : Measure (BRRSSpace d))) :
              BRRSSpace d → Complex) =ᵐ[volume]
              (brrsLpHalfWaveExtension Φ).apply j t
                ((F + G : Lp Complex 2 (volume : Measure (BRRSSpace d))) :
                  BRRSSpace d → Complex) :=
            MemLp.coeFn_toLp
              (brrsLpHalfWaveExtension_apply_memLp_two Φ j t
                (F + G : Lp Complex 2 (volume : Measure (BRRSSpace d))))
          _ =ᵐ[volume] (brrsLpHalfWaveExtension Φ).apply j t
              ((F : BRRSSpace d → Complex) + (G : BRRSSpace d → Complex)) :=
            (brrsLpHalfWaveExtension Φ).congr_ae j t hFGcoe
          _ =ᵐ[volume] (brrsLpHalfWaveExtension Φ).apply j t F +
              (brrsLpHalfWaveExtension Φ).apply j t G :=
            (brrsLpHalfWaveExtension Φ).map_add_ae j t 2 (by norm_num)
              (by simpa only [ENNReal.ofReal_ofNat] using hF)
              (by simpa only [ENNReal.ofReal_ofNat] using hG)
          _ =ᵐ[volume]
              (((brrsLpHalfWaveExtension_apply_memLp_two Φ j t F).toLp
                ((brrsLpHalfWaveExtension Φ).apply j t F) :
                Lp Complex 2 (volume : Measure (BRRSSpace d))) :
                BRRSSpace d → Complex) +
              (((brrsLpHalfWaveExtension_apply_memLp_two Φ j t G).toLp
                ((brrsLpHalfWaveExtension Φ).apply j t G) :
                Lp Complex 2 (volume : Measure (BRRSSpace d))) :
                BRRSSpace d → Complex) :=
            (MemLp.coeFn_toLp
              (brrsLpHalfWaveExtension_apply_memLp_two Φ j t F)).symm.add
              (MemLp.coeFn_toLp
                (brrsLpHalfWaveExtension_apply_memLp_two Φ j t G)).symm
          _ =ᵐ[volume]
              (((brrsLpHalfWaveExtension_apply_memLp_two Φ j t F).toLp
                ((brrsLpHalfWaveExtension Φ).apply j t F) +
                (brrsLpHalfWaveExtension_apply_memLp_two Φ j t G).toLp
                  ((brrsLpHalfWaveExtension Φ).apply j t G) :
                Lp Complex 2 (volume : Measure (BRRSSpace d))) :
                BRRSSpace d → Complex) :=
            (Lp.coeFn_add _ _).symm
      map_smul' := by
        intro c F
        refine Lp.ext ?_
        have hF : MemLp (F : BRRSSpace d → Complex) 2 volume := Lp.memLp F
        have hFcoe :
            ((c • F : Lp Complex 2 (volume : Measure (BRRSSpace d))) :
              BRRSSpace d → Complex) =ᵐ[volume]
              c • (F : BRRSSpace d → Complex) :=
          Lp.coeFn_smul c F
        calc
          (((brrsLpHalfWaveExtension_apply_memLp_two Φ j t
              (c • F : Lp Complex 2 (volume : Measure (BRRSSpace d)))).toLp
              ((brrsLpHalfWaveExtension Φ).apply j t
                ((c • F : Lp Complex 2 (volume : Measure (BRRSSpace d))) :
                  BRRSSpace d → Complex)) :
              Lp Complex 2 (volume : Measure (BRRSSpace d))) :
              BRRSSpace d → Complex) =ᵐ[volume]
              (brrsLpHalfWaveExtension Φ).apply j t
                ((c • F : Lp Complex 2 (volume : Measure (BRRSSpace d))) :
                  BRRSSpace d → Complex) :=
            MemLp.coeFn_toLp
              (brrsLpHalfWaveExtension_apply_memLp_two Φ j t
                (c • F : Lp Complex 2 (volume : Measure (BRRSSpace d))))
          _ =ᵐ[volume] (brrsLpHalfWaveExtension Φ).apply j t
              (c • (F : BRRSSpace d → Complex)) :=
            (brrsLpHalfWaveExtension Φ).congr_ae j t hFcoe
          _ =ᵐ[volume] c • (brrsLpHalfWaveExtension Φ).apply j t F :=
            (brrsLpHalfWaveExtension Φ).map_smul_ae j t 2 (by norm_num) c
              (by simpa only [ENNReal.ofReal_ofNat] using hF)
          _ =ᵐ[volume] c •
              (((brrsLpHalfWaveExtension_apply_memLp_two Φ j t F).toLp
                ((brrsLpHalfWaveExtension Φ).apply j t F) :
                Lp Complex 2 (volume : Measure (BRRSSpace d))) :
                BRRSSpace d → Complex) :=
            (MemLp.coeFn_toLp
              (brrsLpHalfWaveExtension_apply_memLp_two Φ j t F)).symm.const_smul c
          _ =ᵐ[volume]
              ((c • (brrsLpHalfWaveExtension_apply_memLp_two Φ j t F).toLp
                ((brrsLpHalfWaveExtension Φ).apply j t F) :
                Lp Complex 2 (volume : Measure (BRRSSpace d))) :
                BRRSSpace d → Complex) :=
            (Lp.coeFn_smul c _).symm }
    (by
      obtain ⟨C, hC, hbound⟩ :=
        (brrsLpHalfWaveExtension Φ).bounded_on_Lp j t 2 (by norm_num)
      refine ⟨C, ?_⟩
      intro F
      have hF := brrsLpHalfWaveExtension_apply_memLp_two Φ j t F
      have hbound' :
          eLpNorm ((brrsLpHalfWaveExtension Φ).apply j t F) 2 volume ≤
            ENNReal.ofReal C * eLpNorm (F : BRRSSpace d → Complex) 2 volume := by
        simpa only [ENNReal.ofReal_ofNat] using hbound F
          (by simpa only [ENNReal.ofReal_ofNat] using (Lp.memLp F))
      have htop : ENNReal.ofReal C *
          eLpNorm (F : BRRSSpace d → Complex) 2 volume ≠ ∞ :=
        ENNReal.mul_ne_top ENNReal.ofReal_ne_top (Lp.memLp F).eLpNorm_ne_top
      calc
        ‖hF.toLp ((brrsLpHalfWaveExtension Φ).apply j t F)‖ =
            (eLpNorm ((brrsLpHalfWaveExtension Φ).apply j t F) 2 volume).toReal :=
          Lp.norm_toLp _ hF
        _ ≤ (ENNReal.ofReal C *
            eLpNorm (F : BRRSSpace d → Complex) 2 volume).toReal :=
          ENNReal.toReal_mono htop hbound'
        _ = C * (eLpNorm (F : BRRSSpace d → Complex) 2 volume).toReal := by
          rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal hC]
        _ = C * ‖F‖ := by rw [Lp.norm_def])

/-- Coercing the canonical `L²` map back to functions recovers its selected
convolution representative almost everywhere. -/
theorem coeFn_brrsLpHalfWaveExtensionL2Map {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (F : Lp Complex 2 (volume : Measure (BRRSSpace d))) :
    ((brrsLpHalfWaveExtensionL2Map Φ j t F :
      Lp Complex 2 (volume : Measure (BRRSSpace d))) : BRRSSpace d → Complex) =ᵐ[volume]
      (brrsLpHalfWaveExtension Φ).apply j t F :=
  MemLp.coeFn_toLp (brrsLpHalfWaveExtension_apply_memLp_two Φ j t F)

/-- On the Schwartz core, the canonical `L²` realization is the literal
Fourier-side half-wave.  This packages the fixed-time Plancherel estimate in
the normed `Lp` space needed for the density argument below. -/
private theorem norm_brrsLpHalfWaveExtensionL2Map_on_schwartz_le {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) (f : BRRSSchwartz d) :
    ‖brrsLpHalfWaveExtensionL2Map Φ j t (f.toLp 2 volume)‖ ≤
      SchwartzMap.seminorm Complex 0 0 Φ.symbol * ‖f.toLp 2 volume‖ := by
  let g : BRRSSchwartz d := SchwartzMap.smulLeftCLM Complex
    (brrsDyadicHalfWaveSchwartzSymbol Φ j t : BRRSSpace d → Complex) (𝓕 f)
  let q : BRRSSchwartz d := 𝓕⁻ g
  have hg : (g : BRRSSpace d → Complex) = fun xi : BRRSSpace d =>
      brrsDyadicHalfWaveSchwartzSymbol Φ j t xi * 𝓕 (f : BRRSSpace d → Complex) xi := by
    funext xi
    simp only [g, SchwartzMap.smulLeftCLM_apply
      (brrsDyadicHalfWaveSchwartzSymbol Φ j t).hasTemperateGrowth, smul_eq_mul]
    rw [SchwartzMap.fourier_coe]
  have hq : (q : BRRSSpace d → Complex) = brrsDyadicHalfWave Φ j t f := by
    funext x
    dsimp [q]
    rw [SchwartzMap.fourierInv_coe, brrsDyadicHalfWave, hg]
    simp only [brrsDyadicHalfWaveSchwartzSymbol_apply,
      brrsDyadicHalfWaveSymbol]
  have hmap : brrsLpHalfWaveExtensionL2Map Φ j t (f.toLp 2 volume) =
      q.toLp 2 volume := by
    apply Lp.ext
    calc
      ((brrsLpHalfWaveExtensionL2Map Φ j t (f.toLp 2 volume) :
        Lp Complex 2 (volume : Measure (BRRSSpace d))) : BRRSSpace d → Complex) =ᵐ[volume]
          (brrsLpHalfWaveExtension Φ).apply j t (f.toLp 2 volume) :=
        coeFn_brrsLpHalfWaveExtensionL2Map Φ j t (f.toLp 2 volume)
      _ =ᵐ[volume] (brrsLpHalfWaveExtension Φ).apply j t
          (f : BRRSSpace d → Complex) :=
        (brrsLpHalfWaveExtension Φ).congr_ae j t
          (SchwartzMap.coeFn_toLp f 2 volume)
      _ =ᵐ[volume] brrsDyadicHalfWave Φ j t f :=
        (brrsLpHalfWaveExtension Φ).extends_schwartz j t f
      _ =ᵐ[volume] (q : BRRSSpace d → Complex) :=
        Eventually.of_forall fun x => (congrFun hq x).symm
      _ =ᵐ[volume] ((q.toLp 2 volume : Lp Complex 2
          (volume : Measure (BRRSSpace d))) : BRRSSpace d → Complex) :=
        (SchwartzMap.coeFn_toLp q 2 volume).symm
  rw [hmap]
  have hC : 0 ≤ SchwartzMap.seminorm Complex 0 0 Φ.symbol := by
    exact (norm_nonneg (Φ.symbol 0)).trans
      (SchwartzMap.norm_le_seminorm Complex Φ.symbol 0)
  have hqnorm : ‖q.toLp 2 volume‖ =
      √(∫ x : BRRSSpace d, ‖q x‖ ^ (2 : Nat)) := by
    rw [SchwartzMap.norm_toLp' (p := 2) (μ := volume) (by norm_num) (by norm_num)]
    norm_num [Real.sqrt_eq_rpow]
  have hfnorm : ‖f.toLp 2 volume‖ =
      √(∫ x : BRRSSpace d, ‖f x‖ ^ (2 : Nat)) := by
    rw [SchwartzMap.norm_toLp' (p := 2) (μ := volume) (by norm_num) (by norm_num)]
    norm_num [Real.sqrt_eq_rpow]
  rw [hqnorm, hfnorm]
  have hsq : (∫ x : BRRSSpace d, ‖q x‖ ^ (2 : Nat)) ≤
      (SchwartzMap.seminorm Complex 0 0 Φ.symbol) ^ 2 *
        ∫ x : BRRSSpace d, ‖f x‖ ^ (2 : Nat) := by
    calc
      (∫ x : BRRSSpace d, ‖q x‖ ^ (2 : Nat)) =
          ∫ x : BRRSSpace d, ‖brrsDyadicHalfWave Φ j t f x‖ ^ (2 : Nat) := by
        apply integral_congr_ae
        filter_upwards with x
        rw [hq]
      _ ≤ (SchwartzMap.seminorm Complex 0 0 Φ.symbol) ^ 2 *
          ∫ x : BRRSSpace d, ‖f x‖ ^ (2 : Nat) :=
        fixedTimeL2_brrsDyadicHalfWave Φ j t f
  calc
    √(∫ x : BRRSSpace d, ‖q x‖ ^ (2 : Nat)) ≤
        √((SchwartzMap.seminorm Complex 0 0 Φ.symbol) ^ 2 *
          ∫ x : BRRSSpace d, ‖f x‖ ^ (2 : Nat)) :=
      Real.sqrt_le_sqrt hsq
    _ = SchwartzMap.seminorm Complex 0 0 Φ.symbol *
        √(∫ x : BRRSSpace d, ‖f x‖ ^ (2 : Nat)) := by
      rw [Real.sqrt_mul (sq_nonneg (SchwartzMap.seminorm Complex 0 0 Φ.symbol)),
        Real.sqrt_sq_eq_abs, abs_of_nonneg hC]

/-- The canonical BRRS half-wave realization has its sharp fixed-time `L²`
bound on every `L²` input.  Unlike the preceding construction bound, this
is uniform in the time and dyadic parameters and follows from the literal
Schwartz Plancherel estimate by density. -/
theorem norm_brrsLpHalfWaveExtensionL2Map_le {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (F : Lp Complex 2 (volume : Measure (BRRSSpace d))) :
    ‖brrsLpHalfWaveExtensionL2Map Φ j t F‖ ≤
      SchwartzMap.seminorm Complex 0 0 Φ.symbol * ‖F‖ := by
  refine (SchwartzMap.denseRange_toLpCLM (E := BRRSSpace d) (F := Complex)
    (p := (2 : ENNReal)) ENNReal.ofNat_ne_top).induction_on F ?_ ?_
  · exact isClosed_le (brrsLpHalfWaveExtensionL2Map Φ j t).continuous.norm
      (continuous_const.mul continuous_id.norm)
  · intro f
    simpa only [SchwartzMap.toLpCLM_apply] using
      norm_brrsLpHalfWaveExtensionL2Map_on_schwartz_le Φ j t f

/-- The fixed-time sharp `L²` estimate in the literal square-energy form.
This is the all-input counterpart of `fixedTimeL2_brrsDyadicHalfWave`. -/
theorem integral_norm_sq_brrsLpHalfWaveExtension_apply_le {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real)
    {f : BRRSSpace d → Complex} (hf : MemLp f 2 volume) :
    (∫ x : BRRSSpace d, ‖(brrsLpHalfWaveExtension Φ).apply j t f x‖ ^ 2) ≤
      (SchwartzMap.seminorm Complex 0 0 Φ.symbol) ^ 2 *
        ∫ x : BRRSSpace d, ‖f x‖ ^ 2 := by
  let hW : MemLp ((brrsLpHalfWaveExtension Φ).apply j t f) 2 volume := by
    simpa only [ENNReal.ofReal_ofNat] using
      (brrsLpHalfWaveExtension Φ).maps_memLp j t 2 (by norm_num)
        (by simpa only [ENNReal.ofReal_ofNat] using hf)
  have hC : 0 ≤ SchwartzMap.seminorm Complex 0 0 Φ.symbol := by
    exact (norm_nonneg (Φ.symbol 0)).trans
      (SchwartzMap.norm_le_seminorm Complex Φ.symbol 0)
  have hcompare : hW.toLp ((brrsLpHalfWaveExtension Φ).apply j t f) =
      brrsLpHalfWaveExtensionL2Map Φ j t (hf.toLp f) := by
    apply Lp.ext
    calc
      ((hW.toLp ((brrsLpHalfWaveExtension Φ).apply j t f) :
        Lp Complex 2 (volume : Measure (BRRSSpace d))) : BRRSSpace d → Complex) =ᵐ[volume]
          (brrsLpHalfWaveExtension Φ).apply j t f :=
        MemLp.coeFn_toLp hW
      _ =ᵐ[volume] (brrsLpHalfWaveExtension Φ).apply j t (hf.toLp f) :=
        (brrsLpHalfWaveExtension Φ).congr_ae j t (MemLp.coeFn_toLp hf).symm
      _ =ᵐ[volume] ((brrsLpHalfWaveExtensionL2Map Φ j t (hf.toLp f) :
          Lp Complex 2 (volume : Measure (BRRSSpace d))) : BRRSSpace d → Complex) :=
        (coeFn_brrsLpHalfWaveExtensionL2Map Φ j t (hf.toLp f)).symm
  have hbound : ‖hW.toLp ((brrsLpHalfWaveExtension Φ).apply j t f)‖ ≤
      SchwartzMap.seminorm Complex 0 0 Φ.symbol * ‖hf.toLp f‖ := by
    rw [hcompare]
    exact norm_brrsLpHalfWaveExtensionL2Map_le Φ j t (hf.toLp f)
  rw [Auto.Spherical.PowerWeights.norm_toLp_two_eq_sqrt_integral_norm_sq_general
      volume ((brrsLpHalfWaveExtension Φ).apply j t f) hW,
    Auto.Spherical.PowerWeights.norm_toLp_two_eq_sqrt_integral_norm_sq_general
      volume f hf] at hbound
  have hsquared :
      (√(∫ x : BRRSSpace d, ‖(brrsLpHalfWaveExtension Φ).apply j t f x‖ ^ 2)) ^ 2 ≤
        (SchwartzMap.seminorm Complex 0 0 Φ.symbol *
          √(∫ x : BRRSSpace d, ‖f x‖ ^ 2)) ^ 2 := by
    simpa only [pow_two] using
      mul_self_le_mul_self (Real.sqrt_nonneg _) hbound
  have hout : 0 ≤ ∫ x : BRRSSpace d,
      ‖(brrsLpHalfWaveExtension Φ).apply j t f x‖ ^ 2 :=
    integral_nonneg fun _ => sq_nonneg _
  have hin : 0 ≤ ∫ x : BRRSSpace d, ‖f x‖ ^ 2 :=
    integral_nonneg fun _ => sq_nonneg _
  calc
    (∫ x : BRRSSpace d, ‖(brrsLpHalfWaveExtension Φ).apply j t f x‖ ^ 2) =
        (√(∫ x : BRRSSpace d,
          ‖(brrsLpHalfWaveExtension Φ).apply j t f x‖ ^ 2)) ^ 2 := by
      rw [Real.sq_sqrt hout]
    _ ≤ (SchwartzMap.seminorm Complex 0 0 Φ.symbol *
          √(∫ x : BRRSSpace d, ‖f x‖ ^ 2)) ^ 2 := hsquared
    _ = (SchwartzMap.seminorm Complex 0 0 Φ.symbol) ^ 2 *
        ∫ x : BRRSSpace d, ‖f x‖ ^ 2 := by
      rw [mul_pow, Real.sq_sqrt hin]

/-- The canonical BRRS extension has the literal fixed-time `L∞` endpoint
given by its physical Schwartz kernel.  The displayed constant is deliberately
the actual kernel mass at `(j,t)`: no dyadic growth estimate for that mass is
claimed here.  Establishing its sharp rate is the remaining oscillatory-kernel
part of the BRRS argument. -/
theorem norm_brrsLpHalfWaveExtension_apply_le_kernelMass_mul_bound {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f : BRRSSpace d → Complex) (hf : Continuous f)
    {C : Real} (hbound : ∀ y, ‖f y‖ ≤ C) (x : BRRSSpace d) :
    ‖(brrsLpHalfWaveExtension Φ).apply j t f x‖ ≤
      (∫ y : BRRSSpace d, ‖brrsDyadicHalfWaveKernel Φ j t y‖) * C := by
  change ‖(((brrsDyadicHalfWaveKernel Φ j t : BRRSSchwartz d) :
      BRRSSpace d → Complex)
        ⋆[ContinuousLinearMap.mul Complex Complex, volume] f) x‖ ≤ _
  exact Auto.Spherical.SurfaceMeasureDecay.norm_convolution_mul_le_integral_norm_mul_bound
    ((brrsDyadicHalfWaveKernel Φ j t : BRRSSchwartz d) : BRRSSpace d → Complex) f
    (brrsDyadicHalfWaveKernel Φ j t).integrable hf hbound x

/-- A uniform BRRS estimate with a prescribed exponent `s`, formulated on
the full radial `L^p` domain through a specified realization of the Schwartz
Fourier multiplier. -/
def UniformEstimateAtExponent {d : Nat} (Φ : BRRSAnnularCutoff)
    (W : BRRSLpHalfWaveExtension d Φ) (E : Set Real) (p s : Real) : Prop :=
  ∃ K : Real, 0 < K ∧
    ∀ j : Nat, 1 ≤ j → ∀ T : Finset Real, IsDyadicDiscretization E j T →
      ∀ f : BRRSSpace d → Complex, MemLp f (ENNReal.ofReal p) volume →
        IsAERadial f →
          discreteLpNorm p T (fun t => W.apply j t f) ≤
            ENNReal.ofReal (K * (2 : Real) ^ ((j : Real) * s)) *
              eLpNorm f (ENNReal.ofReal p) volume

/-- The same prescribed-exponent estimate on radial Schwartz inputs.  This
is the literal Fourier-calculus core of the paper's estimate. -/
def SchwartzCoreUniformEstimateAtExponent {d : Nat} (Φ : BRRSAnnularCutoff)
    (E : Set Real) (p s : Real) : Prop :=
  ∃ K : Real, 0 < K ∧
    ∀ j : Nat, 1 ≤ j → ∀ T : Finset Real, IsDyadicDiscretization E j T →
      ∀ f : BRRSSchwartz d, IsRadial (f : BRRSSpace d → Complex) →
        discreteLpNorm p T (fun t => brrsDyadicHalfWave Φ j t f) ≤
          ENNReal.ofReal (K * (2 : Real) ^ ((j : Real) * s)) *
            eLpNorm (f : BRRSSpace d → Complex) (ENNReal.ofReal p) volume

/-- The dense-Schwartz-core form of BRRS Theorem 1.1.

It has the exact exponent and all discretizations from (1.5), but deliberately
quantifies over radial Schwartz functions because `brrsDyadicHalfWave` is the
literal Fourier integral.  The paper's all-radial-`L^p` statement is recorded
separately by `BRRSTheoremOneStatementFor`. -/
def BRRSTheoremOneSchwartzCoreStatementFor (nu : Set Real → Real → Real)
    (d : Nat) (Φ : BRRSAnnularCutoff) (E : Set Real) (p : Real) : Prop :=
  2 ≤ d ∧ E ⊆ Icc (1 : Real) 2 ∧ 2 ≤ p ∧
    ∀ epsilon : Real, 0 < epsilon →
      SchwartzCoreUniformEstimateAtExponent (d := d) Φ E p
        (criticalExponent nu E d p + epsilon)

/-- The all-radial-`L^p` statement of BRRS Theorem 1.1, with the required
bounded linear `L^p` realization of its literal Fourier multiplier made
explicit.  The existential quantifier is the formal counterpart of applying
the canonical multiplier to arbitrary `L^p` functions.  Since `p` is a real
number, `2 ≤ p` represents the paper's finite range `2 ≤ p < ∞`.  This is a
statement package only; it is not a claimed theorem in this file. -/
def BRRSTheoremOneStatementFor (nu : Set Real → Real → Real)
    (d : Nat) (Φ : BRRSAnnularCutoff) (E : Set Real) (p : Real) : Prop :=
  2 ≤ d ∧ E ⊆ Icc (1 : Real) 2 ∧ 2 ≤ p ∧
    ∃ W : BRRSLpHalfWaveExtension d Φ,
      ∀ epsilon : Real, 0 < epsilon →
        UniformEstimateAtExponent Φ W E p
          (criticalExponent nu E d p + epsilon)

/-- Sharpness in the sense asserted after BRRS (1.5): for a nonempty time
set, no exponent strictly smaller than the critical one has a uniform estimate
for the same propagator.  The nonemptiness qualification excludes the
vacuous empty-discretization case. -/
def BRRSTheoremOneSharpnessStatementFor (nu : Set Real → Real → Real)
    {d : Nat} {Φ : BRRSAnnularCutoff} (W : BRRSLpHalfWaveExtension d Φ)
    (E : Set Real) (p : Real) : Prop :=
  E.Nonempty → ∀ s : Real, s < criticalExponent nu E d p →
    ¬ UniformEstimateAtExponent Φ W E p s

/-- The joint upper-bound-and-sharpness package corresponding to the complete
assertion of BRRS Theorem 1.1.  Both clauses use the same specified
annular multiplier and every a.e.-bounded linear `L^p` realization of its
frequency-localized half-wave. -/
def BRRSTheoremOneWithSharpnessStatementFor (nu : Set Real → Real → Real)
    (d : Nat) (Φ : BRRSAnnularCutoff) (E : Set Real) (p : Real) : Prop :=
  2 ≤ d ∧ E ⊆ Icc (1 : Real) 2 ∧ 2 ≤ p ∧
    ∃ W : BRRSLpHalfWaveExtension d Φ,
      (∀ epsilon : Real, 0 < epsilon →
        UniformEstimateAtExponent Φ W E p
          (criticalExponent nu E d p + epsilon)) ∧
        BRRSTheoremOneSharpnessStatementFor nu W E p


/-- The dense Schwartz-core target of BRRS Theorem 1.1 with the literal
additive-Euclidean `ν_E^♯` from BRRS (1.4). -/
def BRRSTheoremOneSchwartzCoreStatement (d : Nat) (Φ : BRRSAnnularCutoff)
    (E : Set Real) (p : Real) : Prop :=
  BRRSTheoremOneSchwartzCoreStatementFor brrsLegendreAssouadFunction d Φ E p

/-- The all-radial-`L^p` target of BRRS Theorem 1.1 with the literal
additive-Euclidean `ν_E^♯` from BRRS (1.4). -/
def BRRSTheoremOneStatement (d : Nat) (Φ : BRRSAnnularCutoff) (E : Set Real)
    (p : Real) : Prop :=
  BRRSTheoremOneStatementFor brrsLegendreAssouadFunction d Φ E p

/-- The sharpness target in BRRS Theorem 1.1 with the literal
additive-Euclidean `ν_E^♯` from BRRS (1.4). -/
def BRRSTheoremOneSharpnessStatement {d : Nat} {Φ : BRRSAnnularCutoff}
    (W : BRRSLpHalfWaveExtension d Φ) (E : Set Real) (p : Real) : Prop :=
  BRRSTheoremOneSharpnessStatementFor brrsLegendreAssouadFunction W E p

/-- The combined upper-bound and sharpness target of BRRS Theorem 1.1 with
the literal additive-Euclidean `ν_E^♯` from BRRS (1.4). -/
def BRRSTheoremOneWithSharpnessStatement (d : Nat) (Φ : BRRSAnnularCutoff)
    (E : Set Real) (p : Real) : Prop :=
  BRRSTheoremOneWithSharpnessStatementFor brrsLegendreAssouadFunction d Φ E p

/-- On a BRRS time set contained in `[1,2]`, the global entropy is one of
the interval tests in the zero-penalty profile (take the interval `[1,2]`). -/
theorem brrsEntropyNumber_le_brrsLegendreAssouadProfile_zero_of_subset_Icc
    {E : Set Real} (hE : E ⊆ Icc (1 : Real) 2) {δ : NNReal} (hδ : δ ≤ 1) :
    brrsEntropyNumber E δ ≤
      Auto.Spherical.BRRS.brrsLegendreAssouadProfile E 0 δ := by
  have hsub : E ⊆ E ∩ Auto.Spherical.BRRS.brrsInterval 1 1 := by
    intro x hx
    refine ⟨hx, ?_⟩
    change 1 ≤ x ∧ x ≤ 1 + 1
    norm_num
    exact hE hx
  calc
    brrsEntropyNumber E δ ≤
        brrsEntropyNumber (E ∩ Auto.Spherical.BRRS.brrsInterval 1 1) δ :=
      Auto.Spherical.BRRS.brrsEntropyNumber_mono hsub δ
    _ = (1 : ENNReal) ^ (-(0 : Real)) *
        brrsEntropyNumber (E ∩ Auto.Spherical.BRRS.brrsInterval 1 1) δ := by
      simp
    _ ≤ Auto.Spherical.BRRS.brrsLegendreAssouadProfile E 0 δ := by
      unfold Auto.Spherical.BRRS.brrsLegendreAssouadProfile
      exact le_iSup_of_le (1 : Real)
        (le_iSup_of_le ⟨1, hδ, le_rfl⟩ (le_refl _))

/-- The entropy scale forced by a BRRS time discretization is exactly the
next standard dyadic scale. -/
theorem brrsDyadicEntropyScale_eq_dyadicMultiplicativeScale_succ (j : Nat) :
    (⟨dyadicTimeScale j / 2, by
      unfold dyadicTimeScale
      exact (div_pos (inv_pos.mpr
        (pow_pos (by norm_num : (0 : Real) < 2) _))
        (by norm_num : (0 : Real) < 2)).le⟩ : NNReal) =
      Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) := by
  apply NNReal.eq
  change ((2 : Real) ^ j)⁻¹ / 2 =
    (((2 : NNReal)⁻¹ ^ (j + 1) : NNReal) : Real)
  norm_cast
  push_cast
  rw [pow_succ, ← inv_pow]
  ring

/-- Strictly above the literal BRRS value `ν_E^♯(0)`, its finite-scale
entropy profile obeys the corresponding power bound at all sufficiently
small scales.  This is the additive-Euclidean counterpart of the analogous
multiplicative entropy-tail extraction. -/
theorem eventually_brrsLegendreAssouadProfile_zero_le_inv_rpow_of_lt
    {E : Set Real} {q : Real}
    (hνq : brrsLegendreAssouadFunction E 0 < q) :
    ∀ᶠ δ : NNReal in 𝓝[>] (0 : NNReal),
      Auto.Spherical.BRRS.brrsLegendreAssouadProfile E 0 δ ≤
        ((δ : ENNReal)⁻¹) ^ q := by
  have htop : Auto.Spherical.BRRS.brrsLegendreAssouadExponent E 0 ≠ ⊤ :=
    Auto.Spherical.BRRS.brrsLegendreAssouadExponent_ne_top_of_nonneg E
      (by norm_num)
  have hexponent :
      Auto.Spherical.BRRS.brrsLegendreAssouadExponent E 0 < (q : EReal) := by
    apply lt_of_not_ge
    intro hq
    have hreal := EReal.toReal_le_toReal hq (EReal.coe_ne_bot q) htop
    rw [← Auto.Spherical.BRRS.brrsLegendreAssouadFunction_eq_exponent_toReal]
      at hreal
    exact (not_le_of_gt hνq) hreal
  have hquotient : ∀ᶠ δ : NNReal in 𝓝[>] (0 : NNReal),
      Auto.Spherical.LegendreAssouad.entropyLogQuotient
        (Auto.Spherical.BRRS.brrsLegendreAssouadProfile E 0 δ) δ <
        (q : EReal) :=
    Filter.eventually_lt_of_limsup_lt hexponent
  have hsmall : ∀ᶠ δ : NNReal in 𝓝[>] (0 : NNReal), δ ∈ Ioo 0 1 :=
    nhdsGT_basis 0 |>.mem_of_mem zero_lt_one
  filter_upwards [hquotient, hsmall] with δ hδ hδsmall
  exact Auto.Spherical.LegendreAssouad.le_inv_rpow_of_entropyLogQuotient_lt
    hδsmall.1 hδsmall.2 hδ

/-- Strictly above the literal BRRS value at any nonnegative penalty, the
finite-scale local entropy profile has the corresponding eventual inverse
power bound.  This is the scale-uniform entropy input used by the
`κ_{j,m}` decomposition in the proof of BRRS Proposition 5.1. -/
theorem eventually_brrsLegendreAssouadProfile_le_inv_rpow_of_lt
    {E : Set Real} {alpha q : Real} (halpha : 0 ≤ alpha)
    (hνq : brrsLegendreAssouadFunction E alpha < q) :
    ∀ᶠ δ : NNReal in 𝓝[>] (0 : NNReal),
      Auto.Spherical.BRRS.brrsLegendreAssouadProfile E alpha δ ≤
        ((δ : ENNReal)⁻¹) ^ q := by
  have htop : Auto.Spherical.BRRS.brrsLegendreAssouadExponent E alpha ≠ ⊤ :=
    Auto.Spherical.BRRS.brrsLegendreAssouadExponent_ne_top_of_nonneg E
      halpha
  have hexponent :
      Auto.Spherical.BRRS.brrsLegendreAssouadExponent E alpha <
        (q : EReal) := by
    apply lt_of_not_ge
    intro hq
    have hreal := EReal.toReal_le_toReal hq (EReal.coe_ne_bot q) htop
    rw [← Auto.Spherical.BRRS.brrsLegendreAssouadFunction_eq_exponent_toReal]
      at hreal
    exact (not_le_of_gt hνq) hreal
  have hquotient : ∀ᶠ δ : NNReal in 𝓝[>] (0 : NNReal),
      Auto.Spherical.LegendreAssouad.entropyLogQuotient
        (Auto.Spherical.BRRS.brrsLegendreAssouadProfile E alpha δ) δ <
        (q : EReal) :=
    Filter.eventually_lt_of_limsup_lt hexponent
  have hsmall : ∀ᶠ δ : NNReal in 𝓝[>] (0 : NNReal), δ ∈ Ioo 0 1 :=
    nhdsGT_basis 0 |>.mem_of_mem zero_lt_one
  filter_upwards [hquotient, hsmall] with δ hδ hδsmall
  exact Auto.Spherical.LegendreAssouad.le_inv_rpow_of_entropyLogQuotient_lt
    hδsmall.1 hδsmall.2 hδ

/-- Each individual interval-scale entropy test is bounded by the literal
BRRS finite-scale profile.  This is exactly the estimate defining the
quantities `κ_{j,m}` in the radial upper-bound argument. -/
theorem brrsWeightedEntropy_inter_interval_le_profile
    (E : Set Real) (alpha : Real) (delta : NNReal) (a : Real)
    (R : Icc delta 1) :
    (R.1 : ENNReal) ^ (-alpha) *
        brrsEntropyNumber (E ∩ Auto.Spherical.BRRS.brrsInterval a R.1) delta ≤
      Auto.Spherical.BRRS.brrsLegendreAssouadProfile E alpha delta := by
  unfold Auto.Spherical.BRRS.brrsLegendreAssouadProfile
  exact le_iSup_of_le a (le_iSup_of_le R (le_refl _))

/-- A dyadic discretization inherits the local weighted entropy control at
every interval scale between its mesh and one.  The half-mesh is the precise
packing-to-covering adjustment forced by the closed-ball convention in
`brrsEntropyNumber`. -/
theorem dyadicDiscretization_weighted_local_card_le_profile
    {E : Set Real} {alpha : Real} {j : Nat} {T : Finset Real}
    (hT : IsDyadicDiscretization E j T) (a : Real)
    (R : NNReal) (hRlo : dyadicTimeScale j ≤ (R : Real)) (hRhi : R ≤ 1)
    (U : Finset Real) (hUT : (↑U : Set Real) ⊆ (↑T : Set Real))
    (hUI : (↑U : Set Real) ⊆
      Auto.Spherical.BRRS.brrsInterval a (R : Real)) :
    (R : ENNReal) ^ (-alpha) * (U.card : ENNReal) ≤
      Auto.Spherical.BRRS.brrsLegendreAssouadProfile E alpha
        ⟨dyadicTimeScale j / 2, by
          unfold dyadicTimeScale
          positivity⟩ := by
  let delta : Real := dyadicTimeScale j
  have hdelta : 0 < delta := by
    dsimp [delta, dyadicTimeScale]
    positivity
  have hUsub : (↑U : Set Real) ⊆
      E ∩ Auto.Spherical.BRRS.brrsInterval a (R : Real) := by
    intro x hx
    exact ⟨hT.subset (hUT hx), hUI hx⟩
  have hUsep : IsSeparated U delta := by
    intro s hs t ht hst
    exact hT.separated (hUT hs) (hUT ht) hst
  have hcard : (U.card : ENNReal) ≤
      brrsEntropyNumber (E ∩ Auto.Spherical.BRRS.brrsInterval a (R : Real))
        ⟨delta / 2, by positivity⟩ :=
    finset_card_le_brrsEntropyNumber_half_scale_of_isSeparated hdelta hUsub hUsep
  have hR : R ∈ Icc ⟨delta / 2, by positivity⟩ 1 := by
    constructor
    · change delta / 2 ≤ (R : Real)
      have hhalf : delta / 2 ≤ delta := by linarith
      exact hhalf.trans (by simpa [delta] using hRlo)
    · exact hRhi
  have hprofile := brrsWeightedEntropy_inter_interval_le_profile E alpha
    ⟨delta / 2, by positivity⟩ a ⟨R, hR⟩
  calc
    (R : ENNReal) ^ (-alpha) * (U.card : ENNReal) ≤
        (R : ENNReal) ^ (-alpha) *
          brrsEntropyNumber (E ∩ Auto.Spherical.BRRS.brrsInterval a (R : Real))
            ⟨delta / 2, by positivity⟩ :=
      mul_le_mul' le_rfl hcard
    _ ≤ Auto.Spherical.BRRS.brrsLegendreAssouadProfile E alpha
          ⟨delta / 2, by positivity⟩ := by
      simpa using hprofile

/-- The finite local counting coefficient used in the radial part of the
proof of BRRS Proposition 5.1.  At the dyadic radius
`R = 2^(m-j)`, this is the literal discrete analogue of the paper's
`κ_{j,m}`: the number of sampled times in a length-`R` interval, penalized
by `R^{-alpha}`.

Keeping the supremum over interval locations in the definition is useful:
the entropy input below controls it uniformly without choosing a grid or
silently losing an endpoint interval. -/
noncomputable def brrsKappa (T : Finset Real) (R : NNReal) (alpha : Real) : ENNReal := by
  classical
  exact ⨆ a : Real, (R : ENNReal) ^ (-alpha) *
    ((T.filter fun t => t ∈
      Auto.Spherical.BRRS.brrsInterval a (R : Real)).card : ENNReal)

/-- Forgetting the localization in the definition of `κ` gives the elementary
global-cardinality bound.  This is useful for absorbing the finitely many
pre-asymptotic dyadic levels after the entropy-tail argument has begun. -/
theorem brrsKappa_le_rpow_neg_mul_card
    (T : Finset Real) (R : NNReal) (alpha : Real) :
    brrsKappa T R alpha ≤
      (R : ENNReal) ^ (-alpha) * (T.card : ENNReal) := by
  classical
  unfold brrsKappa
  refine iSup_le fun a => ?_
  apply mul_le_mul' le_rfl
  exact_mod_cast Finset.card_le_card (Finset.filter_subset _ _)

/-- The dyadic instance of the local counting coefficient used at the
`m`-th spatial-radius scale in the BRRS interval decomposition.  The radius
is literally `2^(m-j)`, written as a positive `NNReal` so it can be passed
without coercion ambiguity to the entropy profile. -/
noncomputable def brrsDyadicKappa (T : Finset Real) (j m : Nat) (alpha : Real) : ENNReal :=
  brrsKappa T
    ⟨dyadicTimeScale j * (2 : Real) ^ m, by
      unfold dyadicTimeScale
      positivity⟩ alpha

/-- The radii in `brrsDyadicKappa` run from the time mesh through the unit
interval exactly when `m ≤ j`. -/
theorem dyadicTimeScale_le_brrsDyadicKappaRadius (j m : Nat) :
    dyadicTimeScale j ≤
      ((⟨dyadicTimeScale j * (2 : Real) ^ m, by
        unfold dyadicTimeScale
        positivity⟩ : NNReal) : Real) := by
  change ((2 : Real) ^ j)⁻¹ ≤ ((2 : Real) ^ j)⁻¹ * (2 : Real) ^ m
  apply le_mul_of_one_le_right
  · exact inv_nonneg.mpr (pow_pos (by norm_num) _).le
  · exact one_le_pow₀ (by norm_num)

theorem brrsDyadicKappaRadius_le_one {j m : Nat} (hmj : m ≤ j) :
    (⟨dyadicTimeScale j * (2 : Real) ^ m, by
      unfold dyadicTimeScale
      positivity⟩ : NNReal) ≤ 1 := by
  apply NNReal.coe_le_coe.mp
  change ((2 : Real) ^ j)⁻¹ * (2 : Real) ^ m ≤ 1
  have hpow : (2 : Real) ^ m ≤ (2 : Real) ^ j :=
    pow_le_pow_right₀ (by norm_num) hmj
  have hbase : 0 ≤ ((2 : Real) ^ j)⁻¹ :=
    inv_nonneg.mpr (pow_pos (by norm_num) _).le
  calc
    ((2 : Real) ^ j)⁻¹ * (2 : Real) ^ m ≤
        ((2 : Real) ^ j)⁻¹ * (2 : Real) ^ j :=
      mul_le_mul_of_nonneg_left hpow hbase
    _ = 1 := inv_mul_cancel₀ (pow_ne_zero _ (by norm_num))

/-- At the terminal radius `m = j`, the BRRS local counting coefficient
contains the whole dyadic packet.  This is the endpoint-cardinality
comparison used in the final-cell part of the Section 5 decomposition:
the radius is exactly one, and every discretized time lies in `[1,2]`.

The comparison is stated for the actual finite packet rather than for an
auxiliary cover, so it can be combined directly with the kernel estimate. -/
theorem dyadicDiscretization_card_le_brrsDyadicKappa_terminal
    {E : Set Real} {j : Nat} {T : Finset Real} (hE : E ⊆ Icc (1 : Real) 2)
    (hT : IsDyadicDiscretization E j T) (alpha : Real) :
    (T.card : ENNReal) ≤ brrsDyadicKappa T j j alpha := by
  classical
  have hradius :
      (⟨dyadicTimeScale j * (2 : Real) ^ j, by
        unfold dyadicTimeScale
        positivity⟩ : NNReal) = 1 := by
    apply NNReal.eq
    change ((2 : Real) ^ j)⁻¹ * (2 : Real) ^ j = 1
    exact inv_mul_cancel₀ (pow_ne_zero _ (by norm_num))
  have hTin : ∀ t ∈ T,
      t ∈ Auto.Spherical.BRRS.brrsInterval (1 : Real) 1 := by
    intro t ht
    have htE : t ∈ E := hT.subset ht
    have htI : t ∈ Icc (1 : Real) 2 := hE htE
    change 1 ≤ t ∧ t ≤ 1 + 1
    refine ⟨htI.1, ?_⟩
    calc
      t ≤ 2 := htI.2
      _ = 1 + 1 := by norm_num
  have hfilter : T.filter (fun t => t ∈
      Auto.Spherical.BRRS.brrsInterval (1 : Real) 1) = T := by
    apply Finset.filter_eq_self.mpr
    intro t ht
    exact hTin t ht
  unfold brrsDyadicKappa
  rw [hradius]
  unfold brrsKappa
  calc
    (T.card : ENNReal) =
        (1 : ENNReal) ^ (-alpha) *
          ((T.filter fun t => t ∈
            Auto.Spherical.BRRS.brrsInterval (1 : Real) 1).card : ENNReal) := by
      rw [hfilter]
      simp
    _ ≤ ⨆ a : Real, (1 : ENNReal) ^ (-alpha) *
        ((T.filter fun t => t ∈
          Auto.Spherical.BRRS.brrsInterval a (1 : Real)).card : ENNReal) :=
      le_iSup (fun a : Real => (1 : ENNReal) ^ (-alpha) *
        ((T.filter fun t => t ∈
          Auto.Spherical.BRRS.brrsInterval a (1 : Real)).card : ENNReal)) 1

/-- The terminal coefficient also dominates the entropy of the time set at
twice the sampling mesh.  Together with the reverse half-mesh packing bound,
this is the exact finite packing/covering-to-`\kappa` comparison needed at
the endpoint of the Section 5 dyadic decomposition. -/
theorem brrsEntropyNumber_two_dyadicMesh_le_brrsDyadicKappa_terminal
    {E : Set Real} {j : Nat} {T : Finset Real} (hE : E ⊆ Icc (1 : Real) 2)
    (hT : IsDyadicDiscretization E j T) (alpha : Real) :
    brrsEntropyNumber E
        (⟨2 * dyadicTimeScale j, by
          unfold dyadicTimeScale
          positivity⟩ : NNReal) ≤
      brrsDyadicKappa T j j alpha := by
  let delta : NNReal := ⟨dyadicTimeScale j, by
    unfold dyadicTimeScale
    positivity⟩
  have hdelta : 0 < delta := by
    change 0 < ((2 : Real) ^ j)⁻¹
    positivity
  have hTdelta : IsMaximalSeparatedSubset E (delta : Real) T := by
    change IsMaximalSeparatedSubset E (dyadicTimeScale j) T
    exact hT
  change brrsEntropyNumber E (2 * delta) ≤ brrsDyadicKappa T j j alpha
  calc
    brrsEntropyNumber E (2 * delta) ≤ (T.card : ENNReal) :=
      IsMaximalSeparatedSubset.brrsEntropyNumber_le_card_at_twice_scale hTdelta hdelta
    _ ≤ brrsDyadicKappa T j j alpha :=
      dyadicDiscretization_card_le_brrsDyadicKappa_terminal hE hT alpha

/-- The exact entropy profile bounds every finite local counting coefficient
of a dyadic discretization.  This is the metric half of the
`κ_{j,m}` estimate in BRRS Proposition 5.1; the remaining analytic half is
the radial kernel estimate. -/
theorem brrsKappa_le_profile_of_isDyadicDiscretization
    {E : Set Real} {alpha : Real} {j : Nat} {T : Finset Real}
    (hT : IsDyadicDiscretization E j T) (R : NNReal)
    (hRlo : dyadicTimeScale j ≤ (R : Real)) (hRhi : R ≤ 1) :
    brrsKappa T R alpha ≤
      Auto.Spherical.BRRS.brrsLegendreAssouadProfile E alpha
        ⟨dyadicTimeScale j / 2, by
          unfold dyadicTimeScale
          positivity⟩ := by
  classical
  unfold brrsKappa
  refine iSup_le fun a => ?_
  let U : Finset Real := T.filter fun t => t ∈
    Auto.Spherical.BRRS.brrsInterval a (R : Real)
  have hUT : (↑U : Set Real) ⊆ (↑T : Set Real) := by
    intro t ht
    change t ∈ U at ht
    simp only [U, Finset.mem_filter] at ht
    exact ht.1
  have hUI : (↑U : Set Real) ⊆
      Auto.Spherical.BRRS.brrsInterval a (R : Real) := by
    intro t ht
    change t ∈ U at ht
    simp only [U, Finset.mem_filter] at ht
    exact ht.2
  simpa only [U] using
    (dyadicDiscretization_weighted_local_card_le_profile (alpha := alpha)
      hT a R hRlo hRhi U hUT hUI)

/-- At every dyadic radius occurring in the BRRS decomposition, the local
counting coefficient is bounded by the matching Legendre--Assouad profile.
This is the ready-to-use `κ_{j,m}` form of the entropy input. -/
theorem brrsDyadicKappa_le_profile_of_isDyadicDiscretization
    {E : Set Real} {alpha : Real} {j m : Nat} {T : Finset Real}
    (hT : IsDyadicDiscretization E j T) (hmj : m ≤ j) :
    brrsDyadicKappa T j m alpha ≤
      Auto.Spherical.BRRS.brrsLegendreAssouadProfile E alpha
        ⟨dyadicTimeScale j / 2, by
          unfold dyadicTimeScale
          positivity⟩ := by
  unfold brrsDyadicKappa
  apply brrsKappa_le_profile_of_isDyadicDiscretization hT
  · exact dyadicTimeScale_le_brrsDyadicKappaRadius j m
  · exact brrsDyadicKappaRadius_le_one hmj


/-- A strict BRRS Legendre--Assouad exponent uniformly controls every local
time-grid count in the tail.  This is the precise entropy statement needed
for the `κ_{j,m}` factors of BRRS Proposition 5.1; the analytic radial-kernel
estimate can consume it without replacing `ν_E^♯` by a coarser dimension. -/
theorem exists_tail_dyadicDiscretization_weighted_local_card_le_inv_rpow_of_lt
    {E : Set Real} {alpha q : Real} (halpha : 0 ≤ alpha)
    (hνq : brrsLegendreAssouadFunction E alpha < q) :
    ∃ J : Nat, ∀ j ≥ J, ∀ T : Finset Real, IsDyadicDiscretization E j T →
      ∀ (a : Real) (R : NNReal), dyadicTimeScale j ≤ (R : Real) → R ≤ 1 →
        ∀ U : Finset Real, (↑U : Set Real) ⊆ (↑T : Set Real) →
           (↑U : Set Real) ⊆
             Auto.Spherical.BRRS.brrsInterval a (R : Real) →
           (R : ENNReal) ^ (-alpha) * (U.card : ENNReal) ≤
            ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) :
              ENNReal)⁻¹) ^ q := by
  have hprofile :=
    eventually_brrsLegendreAssouadProfile_le_inv_rpow_of_lt halpha hνq
  have htail : ∀ᶠ n : Nat in Filter.atTop,
      Auto.Spherical.BRRS.brrsLegendreAssouadProfile E alpha
          (Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale n) ≤
        ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale n : ENNReal)⁻¹) ^ q :=
    Auto.Spherical.LegendreAssouad.tendsto_dyadicMultiplicativeScale_atTop_nhdsWithin_zero
      |>.eventually hprofile
  obtain ⟨J, hJ⟩ := Filter.eventually_atTop.1 htail
  refine ⟨J, ?_⟩
  intro j hj T hT a R hRlo hRhi U hUT hUI
  have hlocal := dyadicDiscretization_weighted_local_card_le_profile (alpha := alpha) hT a R
    hRlo hRhi U hUT hUI
  have hscale :
      (⟨dyadicTimeScale j / 2, by
        unfold dyadicTimeScale
        positivity⟩ : NNReal) =
        Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) :=
    brrsDyadicEntropyScale_eq_dyadicMultiplicativeScale_succ j
  calc
    (R : ENNReal) ^ (-alpha) * (U.card : ENNReal) ≤
        Auto.Spherical.BRRS.brrsLegendreAssouadProfile E alpha
          ⟨dyadicTimeScale j / 2, by
            unfold dyadicTimeScale
            positivity⟩ := hlocal
    _ = Auto.Spherical.BRRS.brrsLegendreAssouadProfile E alpha
          (Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1)) := by
      rw [hscale]
    _ ≤ ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) : ENNReal)⁻¹) ^ q :=
      hJ (j + 1) (hj.trans (Nat.le_succ _))

/-- Strictly above the Legendre--Assouad value, every dyadic-scale
`κ`-coefficient is uniformly controlled by the corresponding entropy power.
This packages the tail estimate in precisely the supremum form consumed by
the interval-decomposition argument in BRRS Proposition 5.1. -/
theorem exists_tail_brrsKappa_le_inv_rpow_of_lt
    {E : Set Real} {alpha q : Real} (halpha : 0 ≤ alpha)
    (hνq : brrsLegendreAssouadFunction E alpha < q) :
    ∃ J : Nat, ∀ j ≥ J, ∀ T : Finset Real, IsDyadicDiscretization E j T →
      ∀ R : NNReal, dyadicTimeScale j ≤ (R : Real) → R ≤ 1 →
        brrsKappa T R alpha ≤
          ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) :
             ENNReal)⁻¹) ^ q := by
  classical
  rcases exists_tail_dyadicDiscretization_weighted_local_card_le_inv_rpow_of_lt
    halpha hνq with ⟨J, hJ⟩
  refine ⟨J, ?_⟩
  intro j hj T hT R hRlo hRhi
  unfold brrsKappa
  refine iSup_le fun a => ?_
  let U : Finset Real := T.filter fun t => t ∈
    Auto.Spherical.BRRS.brrsInterval a (R : Real)
  have hUT : (↑U : Set Real) ⊆ (↑T : Set Real) := by
    intro t ht
    change t ∈ U at ht
    simp only [U, Finset.mem_filter] at ht
    exact ht.1
  have hUI : (↑U : Set Real) ⊆
      Auto.Spherical.BRRS.brrsInterval a (R : Real) := by
    intro t ht
    change t ∈ U at ht
    simp only [U, Finset.mem_filter] at ht
    exact ht.2
  simpa only [U] using hJ j hj T hT a R hRlo hRhi U hUT hUI

/-- The strict entropy tail bound in the literal dyadic `κ_{j,m}` notation.
It is uniform simultaneously over every radial scale `0 ≤ m ≤ j`, which is
the quantifier order required when summing the interval-decomposition pieces.
-/
theorem exists_tail_brrsDyadicKappa_le_inv_rpow_of_lt
    {E : Set Real} {alpha q : Real} (halpha : 0 ≤ alpha)
    (hνq : brrsLegendreAssouadFunction E alpha < q) :
    ∃ J : Nat, ∀ j ≥ J, ∀ T : Finset Real, IsDyadicDiscretization E j T →
      ∀ m : Nat, m ≤ j → brrsDyadicKappa T j m alpha ≤
        ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) :
          ENNReal)⁻¹) ^ q := by
  rcases exists_tail_brrsKappa_le_inv_rpow_of_lt halpha hνq with ⟨J, hJ⟩
  refine ⟨J, ?_⟩
  intro j hj T hT m hmj
  unfold brrsDyadicKappa
  exact hJ j hj T hT _
    (dyadicTimeScale_le_brrsDyadicKappaRadius j m)
    (brrsDyadicKappaRadius_le_one hmj)

/-- A strict literal BRRS entropy exponent controls the cardinality of every
sufficiently fine dyadic time discretization.  The successor in the scale is
the closed-ball half-scale from `brrsEntropyNumber`. -/
theorem exists_tail_dyadicDiscretization_card_le_inv_rpow_of_brrsLegendreAssouad_lt
    {E : Set Real} {q : Real} (hE : E ⊆ Icc (1 : Real) 2)
    (hνq : brrsLegendreAssouadFunction E 0 < q) :
    ∃ J : Nat, ∀ j ≥ J, ∀ T : Finset Real, IsDyadicDiscretization E j T →
      (T.card : ENNReal) ≤
        ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) : ENNReal)⁻¹) ^ q := by
  have hprofile :=
    eventually_brrsLegendreAssouadProfile_zero_le_inv_rpow_of_lt (E := E) hνq
  have hsmall : ∀ᶠ δ : NNReal in 𝓝[>] (0 : NNReal), δ ∈ Ioo 0 1 :=
    nhdsGT_basis 0 |>.mem_of_mem zero_lt_one
  have hentropy : ∀ᶠ δ : NNReal in 𝓝[>] (0 : NNReal),
      brrsEntropyNumber E δ ≤ ((δ : ENNReal)⁻¹) ^ q := by
    filter_upwards [hprofile, hsmall] with δ hδ hδsmall
    exact (brrsEntropyNumber_le_brrsLegendreAssouadProfile_zero_of_subset_Icc
      hE hδsmall.2.le).trans hδ
  have htail : ∀ᶠ n : Nat in Filter.atTop,
      brrsEntropyNumber E
          (Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale n) ≤
        ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale n : ENNReal)⁻¹) ^ q :=
    Auto.Spherical.LegendreAssouad.tendsto_dyadicMultiplicativeScale_atTop_nhdsWithin_zero
      |>.eventually hentropy
  obtain ⟨J, hJ⟩ := Filter.eventually_atTop.1 htail
  refine ⟨J, ?_⟩
  intro j hj T hT
  let δ : NNReal := ⟨dyadicTimeScale j / 2, by
    unfold dyadicTimeScale
    exact (div_pos (inv_pos.mpr
      (pow_pos (by norm_num : (0 : Real) < 2) _))
      (by norm_num : (0 : Real) < 2)).le⟩
  have hδ : δ = Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) := by
    dsimp [δ]
    exact brrsDyadicEntropyScale_eq_dyadicMultiplicativeScale_succ j
  have hcard : (T.card : ENNReal) ≤ brrsEntropyNumber E δ := by
    simpa only [δ] using dyadicDiscretization_card_le_brrsEntropyNumber_half_scale hT
  calc
    (T.card : ENNReal) ≤ brrsEntropyNumber E δ := hcard
    _ = brrsEntropyNumber E
        (Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1)) := by rw [hδ]
    _ ≤ ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) : ENNReal)⁻¹) ^ q :=
      hJ (j + 1) (hj.trans (Nat.le_succ _))

/-- The elementary interval-grid bound gives a uniform cardinality estimate
for every BRRS discretization inside `[1,2]`.  This controls the finitely
many scales preceding an entropy tail. -/
theorem dyadicDiscretization_card_le_eight_mul_two_pow_of_subset_Icc
    {E : Set Real} (hE : E ⊆ Icc (1 : Real) 2) (j : Nat) (T : Finset Real)
    (hT : IsDyadicDiscretization E j T) :
    (T.card : ENNReal) ≤ 8 * (2 : ENNReal) ^ j := by
  let δ : NNReal := Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1)
  have hδpos : 0 < (δ : Real) := by
    exact_mod_cast Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale_pos (j + 1)
  have hδle : (δ : Real) ≤ 1 := by
    exact_mod_cast Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale_le_one (j + 1)
  have hentropy : brrsEntropyNumber E δ ≤ 4 * (δ : ENNReal)⁻¹ := by
    calc
      brrsEntropyNumber E δ ≤
          brrsEntropyNumber (E ∩ Auto.Spherical.BRRS.brrsInterval 1 1) δ := by
        apply Auto.Spherical.BRRS.brrsEntropyNumber_mono
        intro x hx
        refine ⟨hx, ?_⟩
        change 1 ≤ x ∧ x ≤ 1 + 1
        norm_num
        exact hE hx
      _ ≤ 4 * (δ : ENNReal)⁻¹ :=
        Auto.Spherical.BRRS.brrsEntropyNumber_inter_interval_le_four_mul_inv E
          hδpos hδle (le_refl _)
  let δ' : NNReal := ⟨dyadicTimeScale j / 2, by
    unfold dyadicTimeScale
    exact (div_pos (inv_pos.mpr
      (pow_pos (by norm_num : (0 : Real) < 2) _))
      (by norm_num : (0 : Real) < 2)).le⟩
  have hδeq : δ' = δ := by
    dsimp [δ, δ']
    exact brrsDyadicEntropyScale_eq_dyadicMultiplicativeScale_succ j
  have hcard : (T.card : ENNReal) ≤ brrsEntropyNumber E δ' := by
    simpa only [δ'] using dyadicDiscretization_card_le_brrsEntropyNumber_half_scale hT
  calc
    (T.card : ENNReal) ≤ brrsEntropyNumber E δ' := hcard
    _ = brrsEntropyNumber E δ := by rw [hδeq]
    _ ≤ 4 * (δ : ENNReal)⁻¹ := hentropy
    _ = 8 * (2 : ENNReal) ^ j := by
      dsimp [δ, Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale]
      rw [ENNReal.inv_pow, ENNReal.coe_inv (by norm_num : (2 : NNReal) ≠ 0),
        inv_inv, pow_succ]
      norm_num
      ring

/-- The elementary interval-grid cardinality estimate also supplies a
uniform coarse bound for every local BRRS counting coefficient.  It is the
finite-scale fallback complementary to the sharp entropy-tail control. -/
theorem brrsKappa_le_rpow_neg_mul_eight_mul_two_pow_of_subset_Icc
    {E : Set Real} {j : Nat} {T : Finset Real} (hE : E ⊆ Icc (1 : Real) 2)
    (hT : IsDyadicDiscretization E j T) (R : NNReal) (alpha : Real) :
    brrsKappa T R alpha ≤
      (R : ENNReal) ^ (-alpha) * (8 * (2 : ENNReal) ^ j) := by
  calc
    brrsKappa T R alpha ≤ (R : ENNReal) ^ (-alpha) * (T.card : ENNReal) :=
      brrsKappa_le_rpow_neg_mul_card T R alpha
    _ ≤ (R : ENNReal) ^ (-alpha) * (8 * (2 : ENNReal) ^ j) :=
      mul_le_mul' le_rfl
        (dyadicDiscretization_card_le_eight_mul_two_pow_of_subset_Icc hE j T hT)

/-- The inverse of the standard dyadic entropy scale has precisely the
expected real power after taking an `ENNReal` exponent. -/
theorem toReal_inv_rpow_dyadicMultiplicativeScale (n : Nat) (q : Real) :
    (((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale n : ENNReal)⁻¹) ^ q).toReal =
      (2 : Real) ^ ((n : Real) * q) := by
  rw [← ENNReal.toReal_rpow]
  dsimp [Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale]
  rw [ENNReal.inv_pow, ENNReal.coe_inv (by norm_num : (2 : NNReal) ≠ 0), inv_inv]
  rw [ENNReal.toReal_pow]
  norm_num
  rw [Real.rpow_natCast_mul (by norm_num : (0 : Real) ≤ 2)]

/-- Real-valued form of the preceding uniform dyadic cardinality bound. -/
theorem dyadicDiscretization_card_le_eight_mul_two_rpow_of_subset_Icc
    {E : Set Real} (hE : E ⊆ Icc (1 : Real) 2) (j : Nat) (T : Finset Real)
    (hT : IsDyadicDiscretization E j T) :
    (T.card : Real) ≤ 8 * (2 : Real) ^ (j : Real) := by
  have h := dyadicDiscretization_card_le_eight_mul_two_pow_of_subset_Icc hE j T hT
  have htop : 8 * (2 : ENNReal) ^ j ≠ ⊤ :=
    ENNReal.mul_ne_top (by norm_num) (ENNReal.pow_ne_top (by norm_num))
  have hreal := (ENNReal.toReal_le_toReal (by simp) htop).mpr h
  simpa only [ENNReal.toReal_natCast, ENNReal.toReal_mul, ENNReal.toReal_ofNat,
    ENNReal.toReal_pow, ENNReal.toReal_ofNat, Real.rpow_natCast] using hreal

/-- The literal zero-penalty BRRS entropy value controls every dyadic
discretization with the expected power, after one fixed constant absorbs the
finitely many pre-asymptotic scales. -/
theorem exists_dyadicDiscretization_card_le_square_mul_two_rpow_of_brrsLegendreAssouad_lt
    {E : Set Real} {q : Real} (hE : E ⊆ Icc (1 : Real) 2)
    (hνq : brrsLegendreAssouadFunction E 0 < q) (hq : 0 ≤ q) :
    ∃ L : Real, 0 < L ∧ ∀ j : Nat, 1 ≤ j → ∀ T : Finset Real,
      IsDyadicDiscretization E j T →
        (T.card : Real) ≤ L ^ 2 * (2 : Real) ^ ((j : Real) * q) := by
  obtain ⟨J, hJ⟩ :=
    exists_tail_dyadicDiscretization_card_le_inv_rpow_of_brrsLegendreAssouad_lt
      hE hνq
  let L : Real := 1 + 8 * (2 : Real) ^ (J : Real) + (2 : Real) ^ q
  have hLone : 1 ≤ L := by
    dsimp [L]
    have hpowJ : 0 ≤ (2 : Real) ^ (J : Real) := Real.rpow_nonneg (by norm_num) _
    have hpowq : 0 ≤ (2 : Real) ^ q := Real.rpow_nonneg (by norm_num) _
    linarith
  have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one hLone
  have hLsq : L ≤ L ^ 2 := by nlinarith
  have hLq : (2 : Real) ^ q ≤ L ^ 2 := by
    have : (2 : Real) ^ q ≤ L := by
      dsimp [L]
      have hpowJ : 0 ≤ (2 : Real) ^ (J : Real) := Real.rpow_nonneg (by norm_num) _
      linarith
    exact this.trans hLsq
  have hLgrid : 8 * (2 : Real) ^ (J : Real) ≤ L ^ 2 := by
    have : 8 * (2 : Real) ^ (J : Real) ≤ L := by
      dsimp [L]
      have hpowq : 0 ≤ (2 : Real) ^ q := Real.rpow_nonneg (by norm_num) _
      linarith
    exact this.trans hLsq
  refine ⟨L, hLpos, ?_⟩
  intro j _hj T hT
  by_cases hlarge : J ≤ j
  · have htail := hJ j hlarge T hT
    have hscale_pos :
        0 < Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) :=
      Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale_pos (j + 1)
    have htop :
        ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) : ENNReal)⁻¹) ^ q ≠ ⊤ :=
            by
      apply ENNReal.rpow_ne_top_of_ne_zero
      · exact ENNReal.inv_ne_zero.mpr ENNReal.coe_ne_top
      · exact ENNReal.inv_ne_top.mpr
          (ENNReal.coe_ne_zero.mpr (by exact_mod_cast hscale_pos.ne'))
    have htailReal : (T.card : Real) ≤
        (((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) : ENNReal)⁻¹) ^
            q).toReal := by
      have := (ENNReal.toReal_le_toReal (by simp) htop).mpr htail
      simpa only [ENNReal.toReal_natCast] using this
    rw [toReal_inv_rpow_dyadicMultiplicativeScale] at htailReal
    have hsplit : ((j + 1 : Nat) : Real) * q = q + (j : Real) * q := by
      push_cast
      ring
    calc
      (T.card : Real) ≤ (2 : Real) ^ (((j + 1 : Nat) : Real) * q) := htailReal
      _ = (2 : Real) ^ q * (2 : Real) ^ ((j : Real) * q) := by
        rw [hsplit, Real.rpow_add (by norm_num : (0 : Real) < 2)]
      _ ≤ L ^ 2 * (2 : Real) ^ ((j : Real) * q) :=
        mul_le_mul_of_nonneg_right hLq (Real.rpow_nonneg (by norm_num) _)
  · have hjJ : j ≤ J := Nat.le_of_lt (Nat.lt_of_not_ge hlarge)
    have hgrid := dyadicDiscretization_card_le_eight_mul_two_rpow_of_subset_Icc hE j T hT
    have hpow : (2 : Real) ^ (j : Real) ≤ (2 : Real) ^ (J : Real) :=
      Real.rpow_le_rpow_of_exponent_le (by norm_num) (by exact_mod_cast hjJ)
    have hpre : (T.card : Real) ≤ 8 * (2 : Real) ^ (J : Real) := by
      calc
        (T.card : Real) ≤ 8 * (2 : Real) ^ (j : Real) := hgrid
        _ ≤ 8 * (2 : Real) ^ (J : Real) :=
          mul_le_mul_of_nonneg_left hpow (by norm_num)
    have hqj : 0 ≤ (j : Real) * q :=
      mul_nonneg (Nat.cast_nonneg _) hq
    have hfactor : 1 ≤ (2 : Real) ^ ((j : Real) * q) :=
      Real.one_le_rpow (by norm_num) hqj
    calc
      (T.card : Real) ≤ 8 * (2 : Real) ^ (J : Real) := hpre
      _ ≤ L ^ 2 := hLgrid
      _ ≤ L ^ 2 * (2 : Real) ^ ((j : Real) * q) :=
        le_mul_of_one_le_right (sq_nonneg L) hfactor

/-- The literal BRRS Schwartz-core upper bound at the fixed-time endpoint
`p = 2`.  Its exponent is exactly `ν_E^♯(0) / 2`, with the required
arbitrarily small loss.  This uses only Plancherel, finite summation, and the
literal entropy definition; it deliberately makes no claim for `p > 2`. -/
theorem brrsTheoremOneSchwartzCoreStatement_p_two
    (d : Nat) (Φ : BRRSAnnularCutoff) (E : Set Real)
    (hd : 2 ≤ d) (hE : E ⊆ Icc (1 : Real) 2) :
    BRRSTheoremOneSchwartzCoreStatement d Φ E 2 := by
  unfold BRRSTheoremOneSchwartzCoreStatement BRRSTheoremOneSchwartzCoreStatementFor
  refine ⟨hd, hE, by norm_num, ?_⟩
  intro ε hε
  let s : Real := brrsLegendreAssouadFunction E 0 / 2 + ε
  have hs : criticalExponent brrsLegendreAssouadFunction E d 2 + ε = s := by
    dsimp [s, criticalExponent, sobolevExponent]
    ring
  rw [hs]
  by_cases hEnonempty : E.Nonempty
  · have hνnonneg : 0 ≤ brrsLegendreAssouadFunction E 0 :=
      Auto.Spherical.BRRS.brrsLegendreAssouadFunction_nonneg_of_nonempty
        hEnonempty (by norm_num)
    have hνlt : brrsLegendreAssouadFunction E 0 < 2 * s := by
      dsimp [s]
      linarith
    have hq : 0 ≤ 2 * s := by
      dsimp [s]
      linarith
    obtain ⟨L, hLpos, hcard⟩ :=
      exists_dyadicDiscretization_card_le_square_mul_two_rpow_of_brrsLegendreAssouad_lt
        hE hνlt hq
    let M : Real := SchwartzMap.seminorm Complex 0 0 Φ.symbol
    have hM : 0 ≤ M := by
      dsimp [M]
      exact (norm_nonneg (Φ.symbol 0)).trans
        (SchwartzMap.norm_le_seminorm Complex Φ.symbol 0)
    let K : Real := (M + 1) * L
    have hKpos : 0 < K := by
      dsimp [K]
      exact mul_pos (by linarith) hLpos
    refine ⟨K, hKpos, ?_⟩
    intro j hj T hT f _hf
    have hcardj : (T.card : Real) ≤
        L ^ 2 * (2 : Real) ^ ((j : Real) * (2 * s)) :=
      hcard j hj T hT
    have hpow : (2 : Real) ^ ((j : Real) * (2 * s)) =
        ((2 : Real) ^ ((j : Real) * s)) ^ 2 := by
      rw [show (j : Real) * (2 * s) = ((j : Real) * s) * 2 by ring,
        Real.rpow_mul (by norm_num : (0 : Real) ≤ 2)]
      exact Real.rpow_two _
    have hcardj' : (T.card : Real) ≤
        L ^ 2 * ((2 : Real) ^ ((j : Real) * s)) ^ 2 := by
      rw [← hpow]
      exact hcardj
    have hRnonneg : 0 ≤ (2 : Real) ^ ((j : Real) * s) :=
      Real.rpow_nonneg (by norm_num) _
    have hcoef : M ^ 2 * (T.card : Real) ≤
        (K * (2 : Real) ^ ((j : Real) * s)) ^ 2 := by
      have hbase_nonneg : 0 ≤ M * L * (2 : Real) ^ ((j : Real) * s) :=
        mul_nonneg (mul_nonneg hM hLpos.le) hRnonneg
      have hbase_le : M * L * (2 : Real) ^ ((j : Real) * s) ≤
          (M + 1) * L * (2 : Real) ^ ((j : Real) * s) := by
        gcongr
        linarith
      have hsq : (M * L * (2 : Real) ^ ((j : Real) * s)) ^ 2 ≤
          ((M + 1) * L * (2 : Real) ^ ((j : Real) * s)) ^ 2 := by
        simpa only [pow_two] using mul_self_le_mul_self hbase_nonneg hbase_le
      calc
        M ^ 2 * (T.card : Real) ≤
            M ^ 2 * (L ^ 2 * ((2 : Real) ^ ((j : Real) * s)) ^ 2) :=
          mul_le_mul_of_nonneg_left hcardj' (sq_nonneg M)
        _ = (M * L * (2 : Real) ^ ((j : Real) * s)) ^ 2 := by ring
        _ ≤ ((M + 1) * L * (2 : Real) ^ ((j : Real) * s)) ^ 2 := hsq
        _ = (K * (2 : Real) ^ ((j : Real) * s)) ^ 2 := by
          dsimp [K]
    have hinput : 0 ≤ ∫ x : BRRSSpace d, ‖f x‖ ^ 2 :=
      integral_nonneg fun _ => sq_nonneg _
    simp only [ENNReal.ofReal_ofNat]
    change discreteLpNorm 2 T (fun t => brrsDyadicHalfWave Φ j t f) ≤
      ENNReal.ofReal (K * (2 : Real) ^ ((j : Real) * s)) *
        eLpNorm (f : BRRSSpace d → Complex) 2 volume
    apply discreteLpNorm_two_le_of_l2Energy_le
      T (fun t => brrsDyadicHalfWave Φ j t f) (f : BRRSSpace d → Complex)
    · intro t ht
      exact brrsDyadicHalfWave_memLp_two Φ j t f
    · exact f.memLp 2 volume
    · exact mul_nonneg hKpos.le hRnonneg
    · calc
        (∑ t ∈ T, ∫ x : BRRSSpace d, ‖brrsDyadicHalfWave Φ j t f x‖ ^ 2) ≤
            M ^ 2 * (T.card : Real) * ∫ x : BRRSSpace d, ‖f x‖ ^ 2 := by
          simpa only [M] using brrsDyadicHalfWave_l2Sum_le_card Φ j T f
        _ = (M ^ 2 * (T.card : Real)) * ∫ x : BRRSSpace d, ‖f x‖ ^ 2 := by ring
        _ ≤ (K * (2 : Real) ^ ((j : Real) * s)) ^ 2 *
            ∫ x : BRRSSpace d, ‖f x‖ ^ 2 :=
          mul_le_mul_of_nonneg_right hcoef hinput
  · have hEempty : E = ∅ := not_nonempty_iff_eq_empty.mp hEnonempty
    refine ⟨1, by norm_num, ?_⟩
    intro j _hj T hT f _hf
    have hTempty : T = ∅ := by
      apply Finset.not_nonempty_iff_eq_empty.mp
      rintro ⟨t, ht⟩
      have htE : t ∈ E := hT.subset (by simpa using ht)
      rw [hEempty] at htE
      exact (Set.mem_empty_iff_false t).mp htE
    subst T
    simp [discreteLpNorm]

/-- The full-domain `p = 2` upper estimate for the canonical BRRS half-wave
realization.  Keeping this in a separate lemma makes explicit that the
operator used here is the literal convolution realization, rather than an
arbitrary witness supplied by the existential formulation of the theorem. -/
theorem brrsCanonicalUniformEstimateAtExponent_p_two
    (d : Nat) (Φ : BRRSAnnularCutoff) (E : Set Real)
    (_hd : 2 ≤ d) (hE : E ⊆ Icc (1 : Real) 2) :
    ∀ ε : Real, 0 < ε →
      UniformEstimateAtExponent Φ (brrsLpHalfWaveExtension (d := d) Φ) E 2
        (criticalExponent brrsLegendreAssouadFunction E d 2 + ε) := by
  intro ε hε
  let s : Real := brrsLegendreAssouadFunction E 0 / 2 + ε
  have hs : criticalExponent brrsLegendreAssouadFunction E d 2 + ε = s := by
    dsimp [s, criticalExponent, sobolevExponent]
    ring
  rw [hs]
  by_cases hEnonempty : E.Nonempty
  · have hνnonneg : 0 ≤ brrsLegendreAssouadFunction E 0 :=
      Auto.Spherical.BRRS.brrsLegendreAssouadFunction_nonneg_of_nonempty
        hEnonempty (by norm_num)
    have hνlt : brrsLegendreAssouadFunction E 0 < 2 * s := by
      dsimp [s]
      linarith
    have hq : 0 ≤ 2 * s := by
      dsimp [s]
      linarith
    obtain ⟨L, hLpos, hcard⟩ :=
      exists_dyadicDiscretization_card_le_square_mul_two_rpow_of_brrsLegendreAssouad_lt
        hE hνlt hq
    let M : Real := SchwartzMap.seminorm Complex 0 0 Φ.symbol
    have hM : 0 ≤ M := by
      dsimp [M]
      exact (norm_nonneg (Φ.symbol 0)).trans
        (SchwartzMap.norm_le_seminorm Complex Φ.symbol 0)
    let K : Real := (M + 1) * L
    have hKpos : 0 < K := by
      dsimp [K]
      exact mul_pos (by linarith) hLpos
    refine ⟨K, hKpos, ?_⟩
    intro j hj T hT f hf _hradial
    have hcardj : (T.card : Real) ≤
        L ^ 2 * (2 : Real) ^ ((j : Real) * (2 * s)) :=
      hcard j hj T hT
    have hpow : (2 : Real) ^ ((j : Real) * (2 * s)) =
        ((2 : Real) ^ ((j : Real) * s)) ^ 2 := by
      rw [show (j : Real) * (2 * s) = ((j : Real) * s) * 2 by ring,
        Real.rpow_mul (by norm_num : (0 : Real) ≤ 2)]
      exact Real.rpow_two _
    have hcardj' : (T.card : Real) ≤
        L ^ 2 * ((2 : Real) ^ ((j : Real) * s)) ^ 2 := by
      rw [← hpow]
      exact hcardj
    have hRnonneg : 0 ≤ (2 : Real) ^ ((j : Real) * s) :=
      Real.rpow_nonneg (by norm_num) _
    have hcoef : M ^ 2 * (T.card : Real) ≤
        (K * (2 : Real) ^ ((j : Real) * s)) ^ 2 := by
      have hbase_nonneg : 0 ≤ M * L * (2 : Real) ^ ((j : Real) * s) :=
        mul_nonneg (mul_nonneg hM hLpos.le) hRnonneg
      have hbase_le : M * L * (2 : Real) ^ ((j : Real) * s) ≤
          (M + 1) * L * (2 : Real) ^ ((j : Real) * s) := by
        gcongr
        linarith
      have hsq : (M * L * (2 : Real) ^ ((j : Real) * s)) ^ 2 ≤
          ((M + 1) * L * (2 : Real) ^ ((j : Real) * s)) ^ 2 := by
        simpa only [pow_two] using mul_self_le_mul_self hbase_nonneg hbase_le
      calc
        M ^ 2 * (T.card : Real) ≤
            M ^ 2 * (L ^ 2 * ((2 : Real) ^ ((j : Real) * s)) ^ 2) :=
          mul_le_mul_of_nonneg_left hcardj' (sq_nonneg M)
        _ = (M * L * (2 : Real) ^ ((j : Real) * s)) ^ 2 := by ring
        _ ≤ ((M + 1) * L * (2 : Real) ^ ((j : Real) * s)) ^ 2 := hsq
        _ = (K * (2 : Real) ^ ((j : Real) * s)) ^ 2 := by
          dsimp [K]
    have hinput : 0 ≤ ∫ x : BRRSSpace d, ‖f x‖ ^ 2 :=
      integral_nonneg fun _ => sq_nonneg _
    simp only [ENNReal.ofReal_ofNat] at hf ⊢
    change discreteLpNorm 2 T (fun t => (brrsLpHalfWaveExtension Φ).apply j t f) ≤
      ENNReal.ofReal (K * (2 : Real) ^ ((j : Real) * s)) *
        eLpNorm f 2 volume
    apply discreteLpNorm_two_le_of_l2Energy_le
      T (fun t => (brrsLpHalfWaveExtension Φ).apply j t f) f
    · intro t ht
      simpa only [ENNReal.ofReal_ofNat] using
        (brrsLpHalfWaveExtension Φ).maps_memLp j t 2 (by norm_num)
          (by simpa only [ENNReal.ofReal_ofNat] using hf)
    · exact hf
    · exact mul_nonneg hKpos.le hRnonneg
    · calc
        (∑ t ∈ T, ∫ x : BRRSSpace d,
          ‖(brrsLpHalfWaveExtension Φ).apply j t f x‖ ^ 2) ≤
            ∑ _t ∈ T, M ^ 2 * ∫ x : BRRSSpace d, ‖f x‖ ^ 2 := by
          apply Finset.sum_le_sum
          intro t _ht
          simpa only [M] using
            integral_norm_sq_brrsLpHalfWaveExtension_apply_le Φ j t hf
        _ = M ^ 2 * (T.card : Real) * ∫ x : BRRSSpace d, ‖f x‖ ^ 2 := by
          simp only [Finset.sum_const, nsmul_eq_mul]
          ring
        _ = (M ^ 2 * (T.card : Real)) * ∫ x : BRRSSpace d, ‖f x‖ ^ 2 := by ring
        _ ≤ (K * (2 : Real) ^ ((j : Real) * s)) ^ 2 *
            ∫ x : BRRSSpace d, ‖f x‖ ^ 2 :=
          mul_le_mul_of_nonneg_right hcoef hinput
  · have hEempty : E = ∅ := not_nonempty_iff_eq_empty.mp hEnonempty
    refine ⟨1, by norm_num, ?_⟩
    intro j _hj T hT f _hf _hradial
    have hTempty : T = ∅ := by
      apply Finset.not_nonempty_iff_eq_empty.mp
      rintro ⟨t, ht⟩
      have htE : t ∈ E := hT.subset (by simpa using ht)
      rw [hEempty] at htE
      exact (Set.mem_empty_iff_false t).mp htE
    subst T
    simp [discreteLpNorm]

/-- The genuine full-domain `p = 2` case of BRRS Theorem 1.1.  The
canonical convolution realization is controlled on every radial `L²` input;
the entropy/cardinality argument is the same one used for the literal
Schwartz-core theorem immediately above. -/
theorem brrsTheoremOneStatement_p_two
    (d : Nat) (Φ : BRRSAnnularCutoff) (E : Set Real)
    (hd : 2 ≤ d) (hE : E ⊆ Icc (1 : Real) 2) :
    BRRSTheoremOneStatement d Φ E 2 := by
  unfold BRRSTheoremOneStatement BRRSTheoremOneStatementFor
  refine ⟨hd, hE, by norm_num, brrsLpHalfWaveExtension Φ, ?_⟩
  exact brrsCanonicalUniformEstimateAtExponent_p_two d Φ E hd hE

/-- A strict subcritical exponent is realized by the literal BRRS
finite-scale entropy profile at arbitrarily small scales.

This is the metric starting point for the sharpness direction of Theorem
1.1: it converts the limsup definition of `ν_E^♯` into actual scales
on which a lower entropy witness must occur.  No maximal-operator estimate is
used here. -/
theorem frequently_inv_rpow_le_brrsLegendreAssouadProfile_of_lt
    {E : Set Real} (hE : E.Nonempty) {alpha q : Real} (halpha : 0 ≤ alpha)
    (hq : q < brrsLegendreAssouadFunction E alpha) :
    ∃ᶠ delta : NNReal in nhdsWithin (0 : NNReal) (Ioi 0),
      delta ∈ Ioo 0 1 ∧
        ((delta : ENNReal)⁻¹) ^ q ≤
          Auto.Spherical.BRRS.brrsLegendreAssouadProfile E alpha delta := by
  have htop : Auto.Spherical.BRRS.brrsLegendreAssouadExponent E alpha ≠ ⊤ :=
    Auto.Spherical.BRRS.brrsLegendreAssouadExponent_ne_top_of_nonneg E halpha
  have hbot : Auto.Spherical.BRRS.brrsLegendreAssouadExponent E alpha ≠ ⊥ :=
    Auto.Spherical.BRRS.brrsLegendreAssouadExponent_ne_bot_of_nonempty hE alpha
  have hqE : (q : EReal) <
      Auto.Spherical.BRRS.brrsLegendreAssouadExponent E alpha := by
    rw [← EReal.coe_toReal htop hbot]
    simpa only [Auto.Spherical.BRRS.brrsLegendreAssouadFunction_eq_exponent_toReal]
      using (show (q : EReal) <
        (Auto.Spherical.BRRS.brrsLegendreAssouadFunction E alpha : EReal) by
          exact_mod_cast hq)
  have hquot : ∃ᶠ delta : NNReal in nhdsWithin (0 : NNReal) (Ioi 0),
      (q : EReal) < Auto.Spherical.LegendreAssouad.entropyLogQuotient
        (Auto.Spherical.BRRS.brrsLegendreAssouadProfile E alpha delta) delta := by
    exact Filter.frequently_lt_of_lt_limsup (h := hqE)
  have hsmall : ∀ᶠ delta : NNReal in nhdsWithin (0 : NNReal) (Ioi 0), delta ∈ Ioo 0 1 :=
    nhdsGT_basis 0 |>.mem_of_mem zero_lt_one
  exact (hquot.and_eventually hsmall).mono fun delta hdelta => by
    refine ⟨hdelta.2, ?_⟩
    exact le_of_lt (lt_of_not_ge fun hle =>
      (not_le_of_gt hdelta.1)
        (Auto.Spherical.LegendreAssouad.entropyLogQuotient_le_of_le_inv_rpow
          hdelta.2.1 hdelta.2.2 hle))

/-- A lower BRRS entropy witness on a bounded time interval can be replaced
by an actual finite separated family of sample times.  The factor two is the
closed-ball convention in `brrsEntropyNumber`: a separation mesh `delta`
controls entropy at covering scale `2 * delta`. -/
theorem exists_isSeparated_finset_card_ge_brrsEntropyNumber_at_twice_scale
    {F : Set Real} (hF : F ⊆ Icc (1 : Real) 2) {delta : NNReal}
    (hdelta : 0 < delta) :
    ∃ T : Finset Real, (↑T : Set Real) ⊆ F ∧ IsSeparated T (delta : Real) ∧
      brrsEntropyNumber F (2 * delta) ≤ (T.card : ENNReal) := by
  obtain ⟨T, hTF, hTsep, hTcard⟩ :=
    Auto.FractalDimensions.exists_strictlySeparated_finset_card_ge_intervalCoveringNumber
      (E := F) (δ := (delta : Real)) hF (by exact_mod_cast hdelta)
  refine ⟨T, hTF, ?_, ?_⟩
  · intro s hs t ht hst
    exact (hTsep hs ht hst).le
  · obtain ⟨centers, hcenters, hcenters_card⟩ :=
      Auto.FractalDimensions.exists_intervalCover_card_eq_intervalCoveringNumber hF
        (show 0 < ((2 * delta : NNReal) : Real) by positivity)
    have hentropy : brrsEntropyNumber F (2 * delta) ≤ (centers.card : ENNReal) :=
      Auto.Spherical.BRRS.brrsEntropyNumber_le_of_intervalCover hcenters
    calc
      brrsEntropyNumber F (2 * delta) ≤ (centers.card : ENNReal) := hentropy
      _ = ENNReal.ofReal (centers.card : Real) := by simp
      _ = ENNReal.ofReal
          (Auto.FractalDimensions.intervalCoveringNumber F (2 * (delta : Real)) : Real) := by
        rw [hcenters_card]
        norm_cast
      _ ≤ ENNReal.ofReal (T.card : Real) := ENNReal.ofReal_le_ofReal hTcard
      _ = (T.card : ENNReal) := by simp

/-- Every exponent strictly below `ν_E^♯(0)` produces actual local
separated time packets at arbitrarily small scales.

More precisely, the finite family has mesh `delta / 2` and cardinality
strictly larger than `delta⁻¹ ^ q`.  This is the complete metric/entropy
input for the lower-bound construction in BRRS Theorem 1.1; the remaining
sharpness work is analytic, namely constructing a radial input whose
half-wave values see these packets. -/
theorem frequently_exists_local_isSeparated_finset_card_lower_of_lt
    {E : Set Real} (hE : E.Nonempty) (hEIcc : E ⊆ Icc (1 : Real) 2) {q : Real}
    (hq : q < brrsLegendreAssouadFunction E 0) :
    ∃ᶠ delta : NNReal in nhdsWithin (0 : NNReal) (Ioi 0),
      delta ∈ Ioo 0 1 ∧ ∃ a : Real, ∃ R : Icc delta 1, ∃ T : Finset Real,
        (↑T : Set Real) ⊆ E ∩ Auto.Spherical.BRRS.brrsInterval a (R.1 : Real) ∧
          IsSeparated T ((delta : Real) / 2) ∧
            ((delta : ENNReal)⁻¹) ^ q < (T.card : ENNReal) := by
  let nu : Real := brrsLegendreAssouadFunction E 0
  let q' : Real := (q + nu) / 2
  have hqq' : q < q' := by
    dsimp [q', nu]
    linarith
  have hq'nu : q' < brrsLegendreAssouadFunction E 0 := by
    dsimp [q', nu]
    linarith
  have hprofile := frequently_inv_rpow_le_brrsLegendreAssouadProfile_of_lt
    hE (alpha := 0) (q := q') (by norm_num) hq'nu
  exact hprofile.mono fun delta hdelta => by
    have hinv_one : (1 : ENNReal) < (delta : ENNReal)⁻¹ :=
      ENNReal.one_lt_inv.mpr (by exact_mod_cast hdelta.1.2)
    have hinv_top : (delta : ENNReal)⁻¹ ≠ ⊤ :=
      ENNReal.inv_ne_top.mpr
        (ENNReal.coe_ne_zero.mpr (by exact_mod_cast hdelta.1.1.ne'))
    have hpow : ((delta : ENNReal)⁻¹) ^ q < ((delta : ENNReal)⁻¹) ^ q' :=
      ENNReal.rpow_lt_rpow_of_exponent_lt hinv_one hinv_top hqq'
    have hprofile_strict : ((delta : ENNReal)⁻¹) ^ q <
        Auto.Spherical.BRRS.brrsLegendreAssouadProfile E 0 delta :=
      hpow.trans_le hdelta.2
    unfold Auto.Spherical.BRRS.brrsLegendreAssouadProfile at hprofile_strict
    rcases lt_iSup_iff.mp hprofile_strict with ⟨a, ha⟩
    rcases lt_iSup_iff.mp ha with ⟨R, hR⟩
    have hentropy : ((delta : ENNReal)⁻¹) ^ q <
        brrsEntropyNumber (E ∩ Auto.Spherical.BRRS.brrsInterval a (R.1 : Real))
          delta := by
      simpa using hR
    have hFIcc : E ∩ Auto.Spherical.BRRS.brrsInterval a (R.1 : Real) ⊆
        Icc (1 : Real) 2 :=
      inter_subset_left.trans hEIcc
    obtain ⟨T, hTsub, hTsep, hTcard⟩ :=
      exists_isSeparated_finset_card_ge_brrsEntropyNumber_at_twice_scale hFIcc
        (delta := delta / 2) (div_pos hdelta.1.1 (by norm_num))
    have hscale : 2 * (delta / 2) = delta := by
      apply NNReal.eq
      ring
    have hTcard' : brrsEntropyNumber
        (E ∩ Auto.Spherical.BRRS.brrsInterval a (R.1 : Real)) delta ≤
          (T.card : ENNReal) := by
      simpa only [hscale] using hTcard
    refine ⟨hdelta.1, a, R, T, hTsub, ?_, hentropy.trans_le hTcard'⟩
    simpa using hTsep

/-- Every exponent strictly below the weighted Legendre--Assouad profile
produces local separated time packets at arbitrarily small scales.  This is
the weighted form of the preceding zero-penalty lemma: the witness carries
the factor `R ^ (-alpha)` which is exactly the factor needed when the radial
test packet is placed at spatial radius comparable to `R`.

Keeping this metric statement separate from the stationary-phase argument is
useful in both directions of BRRS Theorem 1.1: it records the sharp local
entropy content without choosing a Fourier test function. -/
theorem frequently_exists_local_isSeparated_finset_weighted_card_lower_of_lt
    {E : Set Real} (hE : E.Nonempty) (hEIcc : E ⊆ Icc (1 : Real) 2)
    {alpha q : Real} (halpha : 0 ≤ alpha)
    (hq : q < brrsLegendreAssouadFunction E alpha) :
    ∃ᶠ delta : NNReal in nhdsWithin (0 : NNReal) (Ioi 0),
      delta ∈ Ioo 0 1 ∧ ∃ a : Real, ∃ R : Icc delta 1, ∃ T : Finset Real,
        (↑T : Set Real) ⊆ E ∩
          Auto.Spherical.BRRS.brrsInterval a (R.1 : Real) ∧
          IsSeparated T ((delta : Real) / 2) ∧
            ((delta : ENNReal)⁻¹) ^ q <
              (R.1 : ENNReal) ^ (-alpha) * (T.card : ENNReal) := by
  let nu : Real := brrsLegendreAssouadFunction E alpha
  let q' : Real := (q + nu) / 2
  have hqq' : q < q' := by
    dsimp [q', nu]
    linarith
  have hq'nu : q' < brrsLegendreAssouadFunction E alpha := by
    dsimp [q', nu]
    linarith
  have hprofile := frequently_inv_rpow_le_brrsLegendreAssouadProfile_of_lt
    hE (alpha := alpha) (q := q') halpha hq'nu
  exact hprofile.mono fun delta hdelta => by
    have hinv_one : (1 : ENNReal) < (delta : ENNReal)⁻¹ :=
      ENNReal.one_lt_inv.mpr (by exact_mod_cast hdelta.1.2)
    have hinv_top : (delta : ENNReal)⁻¹ ≠ ⊤ :=
      ENNReal.inv_ne_top.mpr
        (ENNReal.coe_ne_zero.mpr (by exact_mod_cast hdelta.1.1.ne'))
    have hpow : ((delta : ENNReal)⁻¹) ^ q < ((delta : ENNReal)⁻¹) ^ q' :=
      ENNReal.rpow_lt_rpow_of_exponent_lt hinv_one hinv_top hqq'
    have hprofile_strict : ((delta : ENNReal)⁻¹) ^ q <
        Auto.Spherical.BRRS.brrsLegendreAssouadProfile E alpha delta :=
      hpow.trans_le hdelta.2
    unfold Auto.Spherical.BRRS.brrsLegendreAssouadProfile at hprofile_strict
    rcases lt_iSup_iff.mp hprofile_strict with ⟨a, ha⟩
    rcases lt_iSup_iff.mp ha with ⟨R, hR⟩
    have hentropy : ((delta : ENNReal)⁻¹) ^ q <
        (R.1 : ENNReal) ^ (-alpha) *
          brrsEntropyNumber
            (E ∩ Auto.Spherical.BRRS.brrsInterval a (R.1 : Real)) delta := by
      simpa using hR
    have hFIcc : E ∩ Auto.Spherical.BRRS.brrsInterval a (R.1 : Real) ⊆
        Icc (1 : Real) 2 :=
      inter_subset_left.trans hEIcc
    obtain ⟨T, hTsub, hTsep, hTcard⟩ :=
      exists_isSeparated_finset_card_ge_brrsEntropyNumber_at_twice_scale hFIcc
        (delta := delta / 2) (div_pos hdelta.1.1 (by norm_num))
    have hscale : 2 * (delta / 2) = delta := by
      apply NNReal.eq
      ring
    have hTcard' : brrsEntropyNumber
        (E ∩ Auto.Spherical.BRRS.brrsInterval a (R.1 : Real)) delta ≤
          (T.card : ENNReal) := by
      simpa only [hscale] using hTcard
    refine ⟨hdelta.1, a, R, T, hTsub, ?_, ?_⟩
    · simpa using hTsep
    · exact hentropy.trans_le (mul_le_mul' le_rfl hTcard')

/-! ### Radial shells for the sharpness packet

Section 3 of BRRS first retains a large half of a separated time packet and
then assigns a thin radial shell to each retained time.  The following
elementary geometry is kept here, next to the entropy witnesses which supply
the packets.  It is independent of the stationary-phase lower bound needed
to put mass on those shells. -/

/-- The open physical-space shell of radii within `width` of `radius`. -/
def brrsRadialShell (d : Nat) (radius width : Real) : Set (BRRSSpace d) :=
  {x | |‖x‖ - radius| < width}

/-- The shell associated with a time `t` and a remote reference time. -/
def brrsTimeRadialShell (d : Nat) (referenceTime t width : Real) :
    Set (BRRSSpace d) :=
  brrsRadialShell d |t - referenceTime| width

/-- Membership in a BRRS time shell, exposed in the literal radial form used
by cone-tube estimates. -/
theorem mem_brrsTimeRadialShell_iff
    {d : Nat} {referenceTime t width : Real} {x : BRRSSpace d} :
    x ∈ brrsTimeRadialShell d referenceTime t width ↔
      |‖x‖ - (|t - referenceTime|)| < width := Iff.rfl

/-- On the forward time side, shell membership gives exactly the radial
offset condition required by an outgoing cone tube. -/
theorem abs_sub_norm_lt_of_mem_brrsTimeRadialShell_of_sub_nonneg
    {d : Nat} {referenceTime t width : Real} {x : BRRSSpace d}
    (hx : x ∈ brrsTimeRadialShell d referenceTime t width)
    (hforward : 0 ≤ t - referenceTime) :
    |(t - referenceTime) - ‖x‖| < width := by
  rw [mem_brrsTimeRadialShell_iff] at hx
  rw [abs_of_nonneg hforward] at hx
  simpa only [abs_sub_comm] using hx

/-- Shells with sufficiently separated centre radii are disjoint. -/
theorem disjoint_brrsRadialShell_of_two_mul_le_abs_sub
    {d : Nat} {r s width : Real} (hsep : 2 * width ≤ |r - s|) :
    Disjoint (brrsRadialShell d r width) (brrsRadialShell d s width) := by
  rw [Set.disjoint_left]
  intro x hx hs
  change |‖x‖ - r| < width at hx
  change |‖x‖ - s| < width at hs
  have hxr : |r - ‖x‖| < width := by
    simpa only [abs_sub_comm] using hx
  have hbound : |r - s| ≤ |r - ‖x‖| + |‖x‖ - s| := by
    calc
      |r - s| = |(r - ‖x‖) + (‖x‖ - s)| := by
        congr 1
        ring
      _ ≤ |r - ‖x‖| + |‖x‖ - s| := abs_add_le _ _
  have hlt : |r - s| < 2 * width := by linarith
  exact (not_lt_of_ge hsep) hlt

/-- Once all selected times lie on the same side of the reference time, their
absolute time distances retain their original separation.  Consequently their
thin radial shells are pairwise disjoint. -/
theorem pairwiseDisjoint_brrsTimeRadialShell_of_isSeparated
    {d : Nat} {U : Finset Real} {referenceTime delta width : Real}
    (hsep : IsSeparated U delta)
    (hcentres : ∀ t ∈ U, ∀ u ∈ U,
      |(|t - referenceTime|) - (|u - referenceTime|)| = |t - u|)
    (hwidth : 2 * width ≤ delta) :
    (↑U : Set Real).PairwiseDisjoint
      (fun t => brrsTimeRadialShell d referenceTime t width) := by
  intro t ht u hu htu
  apply disjoint_brrsRadialShell_of_two_mul_le_abs_sub
  calc
    2 * width ≤ delta := hwidth
    _ ≤ |t - u| := hsep ht hu htu
    _ = |(|t - referenceTime|) - (|u - referenceTime|)| :=
      (hcentres t ht u hu).symm

/-- The closed radial interval `J_t` used in BRRS Section 3.  The radius is
written with an absolute value so that the construction treats the two
symmetric choices of the remote endpoint uniformly. -/
def brrsSectionThreeRadiusWindow (referenceTime t mesh : Real) : Set Real :=
  Icc (|t - referenceTime| - mesh / 32) (|t - referenceTime| + mesh / 32)

/-- The physical-space region `D_t` obtained by revolving the Section 3
radial interval `J_t`. -/
def brrsSectionThreeSpatialShell (d : Nat) (referenceTime t mesh : Real) :
    Set (BRRSSpace d) :=
  {x | ‖x‖ ∈ brrsSectionThreeRadiusWindow referenceTime t mesh}

/-- Membership in the literal Section 3 shell is membership of the radial
coordinate in its closed `J_t` interval. -/
theorem mem_brrsSectionThreeSpatialShell_iff
    {d : Nat} {referenceTime t mesh : Real} {x : BRRSSpace d} :
    x ∈ brrsSectionThreeSpatialShell d referenceTime t mesh ↔
      |t - referenceTime| - mesh / 32 ≤ ‖x‖ ∧
        ‖x‖ ≤ |t - referenceTime| + mesh / 32 := Iff.rfl

/-- The Section 3 shells are disjoint as soon as their centre radii are
separated by more than the sum of their two half-widths. -/
theorem disjoint_brrsSectionThreeSpatialShell_of_center_separation
    {d : Nat} {referenceTime t u mesh : Real}
    (hsep : mesh / 16 < |(|t - referenceTime|) - (|u - referenceTime|)|) :
    Disjoint (brrsSectionThreeSpatialShell d referenceTime t mesh)
      (brrsSectionThreeSpatialShell d referenceTime u mesh) := by
  rw [Set.disjoint_left]
  intro x ht hu
  rw [mem_brrsSectionThreeSpatialShell_iff] at ht hu
  have htx : |(|t - referenceTime|) - ‖x‖| ≤ mesh / 32 := by
    rw [abs_le]
    constructor <;> linarith [ht.1, ht.2]
  have hxu : |‖x‖ - (|u - referenceTime|)| ≤ mesh / 32 := by
    rw [abs_le]
    constructor <;> linarith [hu.1, hu.2]
  have hbound : |(|t - referenceTime|) - (|u - referenceTime|)| ≤ mesh / 16 := by
    calc
      |(|t - referenceTime|) - (|u - referenceTime|)| =
          |((|t - referenceTime|) - ‖x‖) + (‖x‖ - (|u - referenceTime|))| := by
        congr 1
        ring
      _ ≤ |(|t - referenceTime|) - ‖x‖| + |‖x‖ - (|u - referenceTime|)| :=
        abs_add_le _ _
      _ ≤ mesh / 32 + mesh / 32 := add_le_add htx hxu
      _ = mesh / 16 := by ring
  exact (not_lt_of_ge hbound) hsep

/-- A separated time packet on one side of a remote endpoint produces
pairwise-disjoint literal Section 3 regions `D_t`. -/
theorem pairwiseDisjoint_brrsSectionThreeSpatialShell_of_isSeparated
    {d : Nat} {U : Finset Real} {referenceTime mesh : Real}
    (hmesh : 0 < mesh) (hsep : IsSeparated U mesh)
    (hcentres : ∀ t ∈ U, ∀ u ∈ U,
      |(|t - referenceTime|) - (|u - referenceTime|)| = |t - u|) :
    (↑U : Set Real).PairwiseDisjoint
      (fun t => brrsSectionThreeSpatialShell d referenceTime t mesh) := by
  intro t ht u hu htu
  apply disjoint_brrsSectionThreeSpatialShell_of_center_separation
  calc
    mesh / 16 < mesh := by nlinarith
    _ ≤ |t - u| := hsep ht hu htu
    _ = |(|t - referenceTime|) - (|u - referenceTime|)| :=
      (hcentres t ht u hu).symm

/-- A finite packet in an interval has a half-packet containing at least half
of its points.  The endpoint opposite that half is a remote reference time:
absolute distances from it preserve separation and are at least half the
interval length.  This is the finite geometric selection in BRRS, Section 3. -/
theorem exists_half_brrs_packet_with_remote_reference
    {a R : Real} {T : Finset Real} (hR : 0 ≤ R)
    (hT : (↑T : Set Real) ⊆
      Auto.Spherical.BRRS.brrsInterval a R) :
    ∃ U : Finset Real, ∃ referenceTime : Real,
      U ⊆ T ∧ T.card ≤ 2 * U.card ∧
        (∀ t ∈ U, R / 2 ≤ |t - referenceTime|) ∧
          (∀ t ∈ U, ∀ u ∈ U,
            |(|t - referenceTime|) - (|u - referenceTime|)| = |t - u|) ∧
              (referenceTime = a ∨ referenceTime = a + R) := by
  classical
  let midpoint : Real := a + R / 2
  let L : Finset Real := T.filter (fun t => t < midpoint)
  let U : Finset Real := T.filter (fun t => midpoint ≤ t)
  have hpartition : T = L ∪ U := by
    apply Finset.ext
    intro t
    simp only [L, U, Finset.mem_filter, Finset.mem_union]
    constructor
    · intro ht
      rcases lt_or_ge t midpoint with hlt | hge
      · exact Or.inl ⟨ht, hlt⟩
      · exact Or.inr ⟨ht, hge⟩
    · rintro (⟨ht, _⟩ | ⟨ht, _⟩)
      · exact ht
      · exact ht
  have hdisjoint : Disjoint L U := by
    rw [Finset.disjoint_left]
    intro t htL htU
    have hlt : t < midpoint := (Finset.mem_filter.mp htL).2
    have hge : midpoint ≤ t := (Finset.mem_filter.mp htU).2
    exact (not_le_of_gt hlt) hge
  have hcard : T.card = L.card + U.card := by
    rw [hpartition, Finset.card_union_of_disjoint hdisjoint]
  by_cases hLU : L.card ≤ U.card
  · refine ⟨U, a, Finset.filter_subset _ _, ?_, ?_, ?_, Or.inl rfl⟩
    · rw [hcard]
      omega
    · intro t ht
      have hmid : midpoint ≤ t := (Finset.mem_filter.mp ht).2
      have hnonneg : 0 ≤ t - a := by
        dsimp [midpoint] at hmid
        linarith
      rw [abs_of_nonneg hnonneg]
      dsimp [midpoint] at hmid
      linarith
    · intro t ht u hu
      have htmid : midpoint ≤ t := (Finset.mem_filter.mp ht).2
      have humid : midpoint ≤ u := (Finset.mem_filter.mp hu).2
      have ht : 0 ≤ t - a := by
        dsimp [midpoint] at htmid
        linarith
      have hu : 0 ≤ u - a := by
        dsimp [midpoint] at humid
        linarith
      rw [abs_of_nonneg ht, abs_of_nonneg hu]
      congr 1
      ring
  · have hUL : U.card ≤ L.card := Nat.le_of_lt (Nat.lt_of_not_ge hLU)
    refine ⟨L, a + R, Finset.filter_subset _ _, ?_, ?_, ?_, Or.inr rfl⟩
    · rw [hcard]
      omega
    · intro t ht
      change t ∈ T.filter (fun t => t < midpoint) at ht
      have htT : t ∈ T := (Finset.mem_filter.mp ht).1
      have htI : t ∈ Icc a (a + R) := by
        simpa only [Auto.Spherical.BRRS.brrsInterval] using
          hT (by simpa using htT)
      have hlt : t < midpoint := (Finset.mem_filter.mp ht).2
      have hnonpos : t - (a + R) ≤ 0 := by linarith [htI.2]
      rw [abs_of_nonpos hnonpos]
      dsimp [midpoint] at hlt
      linarith
    · intro t ht u hu
      change t ∈ T.filter (fun t => t < midpoint) at ht
      change u ∈ T.filter (fun u => u < midpoint) at hu
      have htT : t ∈ T := (Finset.mem_filter.mp ht).1
      have huT : u ∈ T := (Finset.mem_filter.mp hu).1
      have htI : t ∈ Icc a (a + R) := by
        simpa only [Auto.Spherical.BRRS.brrsInterval] using
          hT (by simpa using htT)
      have huI : u ∈ Icc a (a + R) := by
        simpa only [Auto.Spherical.BRRS.brrsInterval] using
          hT (by simpa using huT)
      have ht : t - (a + R) ≤ 0 := by linarith [htI.2]
      have hu : u - (a + R) ≤ 0 := by linarith [huI.2]
      rw [abs_of_nonpos ht, abs_of_nonpos hu]
      calc
        |-(t - (a + R)) - -(u - (a + R))| = |u - t| := by
          congr 1
          ring
        _ = |t - u| := abs_sub_comm _ _

/-- The preceding half-packet selection converts any separated time packet
into pairwise disjoint physical radial shells.  The width hypothesis is the
sole numerical condition needed for disjointness. -/
theorem exists_half_brrs_packet_with_pairwiseDisjoint_shells
    {d : Nat} {a R delta width : Real} {T : Finset Real} (hR : 0 ≤ R)
    (hT : (↑T : Set Real) ⊆
      Auto.Spherical.BRRS.brrsInterval a R)
    (hsep : IsSeparated T delta) (hwidth : 2 * width ≤ delta) :
    ∃ U : Finset Real, ∃ referenceTime : Real,
      U ⊆ T ∧ T.card ≤ 2 * U.card ∧
        (∀ t ∈ U, R / 2 ≤ |t - referenceTime|) ∧
          (↑U : Set Real).PairwiseDisjoint
            (fun t => brrsTimeRadialShell d referenceTime t width) := by
  rcases exists_half_brrs_packet_with_remote_reference hR hT with
    ⟨U, referenceTime, hUT, hcard, hremote, hcentres, _⟩
  refine ⟨U, referenceTime, hUT, hcard, hremote, ?_⟩
  exact pairwiseDisjoint_brrsTimeRadialShell_of_isSeparated
    (fun t ht u hu htu => hsep (hUT ht) (hUT hu) htu)
    hcentres hwidth

/-- **BRRS, Section 3 packet geometry.**  A separated finite time packet in
an interval has a half-interval `I'`, the opposite endpoint `t_I`, and a
subpacket of comparable cardinality.  Its exact closed radial regions `D_t`
are pairwise disjoint.  The two alternatives are the source's `t_I`-left
choice and its reflected counterpart. -/
theorem exists_brrsSectionThree_packet_geometry
    {d : Nat} {a R mesh : Real} {T : Finset Real}
    (hR : 0 ≤ R)
    (hT : (↑T : Set Real) ⊆ Auto.Spherical.BRRS.brrsInterval a R)
    (hsep : IsSeparated T mesh) (hmesh : 0 < mesh) :
    ∃ I' : Set Real, ∃ referenceTime : Real, ∃ U : Finset Real,
      ((I' = Icc (a + R / 2) (a + R) ∧ referenceTime = a) ∨
        (I' = Icc a (a + R / 2) ∧ referenceTime = a + R)) ∧
        U ⊆ T ∧ (↑U : Set Real) ⊆ I' ∧ T.card ≤ 2 * U.card ∧
          (∀ t ∈ U, R / 2 ≤ |t - referenceTime|) ∧
            (↑U : Set Real).PairwiseDisjoint
              (fun t => brrsSectionThreeSpatialShell d referenceTime t mesh) := by
  rcases exists_half_brrs_packet_with_remote_reference hR hT with
    ⟨U, referenceTime, hUT, hcard, hremote, hcentres, href⟩
  have hdisjoint : (↑U : Set Real).PairwiseDisjoint
      (fun t => brrsSectionThreeSpatialShell d referenceTime t mesh) :=
    pairwiseDisjoint_brrsSectionThreeSpatialShell_of_isSeparated hmesh
      (fun t ht u hu htu => hsep (hUT ht) (hUT hu) htu) hcentres
  rcases href with href | href
  · subst referenceTime
    refine ⟨Icc (a + R / 2) (a + R), a, U,
      Or.inl ⟨rfl, rfl⟩, hUT, ?_, hcard, hremote, ?_⟩
    · intro t ht
      have htI : t ∈ Icc a (a + R) := by
        simpa only [Auto.Spherical.BRRS.brrsInterval] using
          hT (by simpa using hUT ht)
      have hnonneg : 0 ≤ t - a := by linarith [htI.1]
      have hdistance := hremote t ht
      rw [abs_of_nonneg hnonneg] at hdistance
      exact ⟨by linarith, htI.2⟩
    · simpa using hdisjoint
  · subst referenceTime
    refine ⟨Icc a (a + R / 2), a + R, U,
      Or.inr ⟨rfl, rfl⟩, hUT, ?_, hcard, hremote, ?_⟩
    · intro t ht
      have htI : t ∈ Icc a (a + R) := by
        simpa only [Auto.Spherical.BRRS.brrsInterval] using
          hT (by simpa using hUT ht)
      have hnonpos : t - (a + R) ≤ 0 := by linarith [htI.2]
      have hdistance := hremote t ht
      rw [abs_of_nonpos hnonpos] at hdistance
      exact ⟨htI.1, by linarith⟩
    · simpa using hdisjoint

/-- The entropy lower witnesses for `ν_E^♯(0)` therefore yield, at
arbitrarily fine scales, a half-packet of comparable cardinality whose
BRRS radial shells are pairwise disjoint.  This is precisely the geometric
input used by the radial test function in BRRS, Section 3; the remaining
analytic issue is the stationary-phase lower bound on each displayed shell. -/
theorem frequently_exists_local_half_packet_with_pairwiseDisjoint_shells_of_lt
    {d : Nat} {E : Set Real} (hE : E.Nonempty) (hEIcc : E ⊆ Icc (1 : Real) 2)
    {q : Real} (hq : q < brrsLegendreAssouadFunction E 0) :
    ∃ᶠ delta : NNReal in nhdsWithin (0 : NNReal) (Ioi 0),
      delta ∈ Ioo 0 1 ∧ ∃ a : Real, ∃ R : Icc delta 1, ∃ U : Finset Real,
        ∃ referenceTime : Real,
          (↑U : Set Real) ⊆
              E ∩ Auto.Spherical.BRRS.brrsInterval a (R.1 : Real) ∧
            ((delta : ENNReal)⁻¹) ^ q < (2 : ENNReal) * (U.card : ENNReal) ∧
              (∀ t ∈ U, (R.1 : Real) / 2 ≤ |t - referenceTime|) ∧
                (↑U : Set Real).PairwiseDisjoint
                  (fun t => brrsTimeRadialShell d referenceTime t ((delta : Real) / 16)) := by
  exact (frequently_exists_local_isSeparated_finset_card_lower_of_lt hE hEIcc hq).mono
    fun delta hdelta => by
      rcases hdelta with ⟨hdeltaIoo, a, R, T, hTsub, hTsep, hTcard⟩
      have hRnonneg : 0 ≤ (R.1 : Real) := by
        have hRnonnegNN : (0 : NNReal) ≤ R.1 :=
          (le_of_lt hdeltaIoo.1).trans R.2.1
        exact_mod_cast hRnonnegNN
      have hdeltanonneg : 0 ≤ (delta : Real) := by
        exact_mod_cast (le_of_lt hdeltaIoo.1)
      have hwidth : 2 * ((delta : Real) / 16) ≤ (delta : Real) / 2 := by
        linarith
      obtain ⟨U, referenceTime, hUT, hcard, hremote, hshells⟩ :=
        exists_half_brrs_packet_with_pairwiseDisjoint_shells
          (d := d) hRnonneg (hTsub.trans inter_subset_right) hTsep hwidth
      have hUsub : (↑U : Set Real) ⊆
          E ∩ Auto.Spherical.BRRS.brrsInterval a (R.1 : Real) := by
        intro t ht
        exact hTsub (by simpa using hUT ht)
      have hcardENN : (T.card : ENNReal) ≤
          (2 : ENNReal) * (U.card : ENNReal) := by
        exact_mod_cast hcard
      exact ⟨hdeltaIoo, a, R, U, referenceTime, hUsub,
        hTcard.trans_le hcardENN, hremote, hshells⟩

/-- The weighted entropy witnesses retain their exact local penalty after
the half-packet shell selection.  This is the geometric sharpness input at
the parameter `alpha = p * s_p`: the loss from discarding one half of the
time packet is the explicit factor two and no global covering exponent is
introduced. -/
theorem frequently_exists_local_half_packet_with_pwDisjoint_shells_wtd_card_lower_of_lt
    {d : Nat} {E : Set Real} (hE : E.Nonempty) (hEIcc : E ⊆ Icc (1 : Real) 2)
    {alpha q : Real} (halpha : 0 ≤ alpha)
    (hq : q < brrsLegendreAssouadFunction E alpha) :
    ∃ᶠ delta : NNReal in nhdsWithin (0 : NNReal) (Ioi 0),
      delta ∈ Ioo 0 1 ∧ ∃ a : Real, ∃ R : Icc delta 1, ∃ U : Finset Real,
        ∃ referenceTime : Real,
          (↑U : Set Real) ⊆
              E ∩ Auto.Spherical.BRRS.brrsInterval a (R.1 : Real) ∧
            ((delta : ENNReal)⁻¹) ^ q <
              2 * (R.1 : ENNReal) ^ (-alpha) * (U.card : ENNReal) ∧
              (∀ t ∈ U, (R.1 : Real) / 2 ≤ |t - referenceTime|) ∧
                (↑U : Set Real).PairwiseDisjoint
                  (fun t => brrsTimeRadialShell d referenceTime t ((delta : Real) / 16)) := by
  exact
    (frequently_exists_local_isSeparated_finset_weighted_card_lower_of_lt
      hE hEIcc halpha hq).mono fun delta hdelta => by
      rcases hdelta with ⟨hdeltaIoo, a, R, T, hTsub, hTsep, hTcard⟩
      have hRnonneg : 0 ≤ (R.1 : Real) := by
        have hRnonnegNN : (0 : NNReal) ≤ R.1 :=
          (le_of_lt hdeltaIoo.1).trans R.2.1
        exact_mod_cast hRnonnegNN
      have hdeltanonneg : 0 ≤ (delta : Real) := by
        exact_mod_cast (le_of_lt hdeltaIoo.1)
      have hwidth : 2 * ((delta : Real) / 16) ≤ (delta : Real) / 2 := by
        linarith
      obtain ⟨U, referenceTime, hUT, hcard, hremote, hshells⟩ :=
        exists_half_brrs_packet_with_pairwiseDisjoint_shells
          (d := d) hRnonneg (hTsub.trans inter_subset_right) hTsep hwidth
      have hUsub : (↑U : Set Real) ⊆
          E ∩ Auto.Spherical.BRRS.brrsInterval a (R.1 : Real) := by
        intro t ht
        exact hTsub (by simpa using hUT ht)
      have hcardENN : (T.card : ENNReal) ≤
          (2 : ENNReal) * (U.card : ENNReal) := by
        exact_mod_cast hcard
      have hweighted_card : (R.1 : ENNReal) ^ (-alpha) * (T.card : ENNReal) ≤
          (R.1 : ENNReal) ^ (-alpha) * ((2 : ENNReal) * (U.card : ENNReal)) :=
        mul_le_mul' le_rfl hcardENN
      refine ⟨hdeltaIoo, a, R, U, referenceTime, hUsub, ?_, hremote, hshells⟩
      calc
        ((delta : ENNReal)⁻¹) ^ q <
            (R.1 : ENNReal) ^ (-alpha) * (T.card : ENNReal) := hTcard
        _ ≤ (R.1 : ENNReal) ^ (-alpha) * ((2 : ENNReal) * (U.card : ENNReal)) :=
          hweighted_card
        _ = 2 * (R.1 : ENNReal) ^ (-alpha) * (U.card : ENNReal) := by ring

/-! ### Exact radial Fourier test packet

The next construction is the literal phase-shifted radial input used before
the Bessel/stationary-phase calculation in BRRS, Section 3.  It records only
the exact Fourier identity.  In particular, it makes no lower-bound claim on
the shells constructed above. -/

/-- Half-wave phases form the expected one-parameter multiplicative group. -/
theorem halfWaveMultiplier_add {d : Nat} (s t : Real) (xi : BRRSSpace d) :
    halfWaveMultiplier (d := d) (s + t) xi =
      halfWaveMultiplier s xi * halfWaveMultiplier t xi := by
  unfold halfWaveMultiplier
  rw [show (2 * Real.pi * (s + t) * ‖xi‖ : Real) =
      2 * Real.pi * s * ‖xi‖ + 2 * Real.pi * t * ‖xi‖ by ring,
    Complex.ofReal_add, add_mul, Complex.exp_add]

/-- The radial Schwartz datum whose Fourier transform is the annular symbol
back-propagated from `referenceTime`. -/
noncomputable def brrsRadialHalfWaveTestPacket {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (referenceTime : Real) : BRRSSchwartz d :=
  𝓕⁻ (brrsDyadicHalfWaveSchwartzSymbol Φ j (-referenceTime))

/-- The ordinary BRRS Section 3 test packet is literally the annular
half-wave kernel at the back-propagated time.  This records the exact
identification with the paper's datum `g_I`; unlike the positive adjoint
packet below, its cutoff is not conjugated. -/
theorem brrsRadialHalfWaveTestPacket_eq_halfWaveKernel {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (referenceTime : Real) :
    brrsRadialHalfWaveTestPacket (d := d) Φ j referenceTime =
      brrsDyadicHalfWaveKernel (d := d) Φ j (-referenceTime) := by
  rfl

/-- The Fourier transform of the test packet is exactly its prescribed
back-propagated annular symbol. -/
theorem brrsRadialHalfWaveTestPacket_fourier_apply {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (referenceTime : Real) (xi : BRRSSpace d) :
    𝓕 (brrsRadialHalfWaveTestPacket Φ j referenceTime : BRRSSpace d → Complex) xi =
      brrsDyadicHalfWaveSymbol Φ j (-referenceTime) xi := by
  unfold brrsRadialHalfWaveTestPacket
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq,
    brrsDyadicHalfWaveSchwartzSymbol_apply]

/-- The back-propagated Fourier packet remains radial in physical space. -/
theorem brrsRadialHalfWaveTestPacket_isRadial {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (referenceTime : Real) :
    IsRadial (brrsRadialHalfWaveTestPacket Φ j referenceTime : BRRSSpace d → Complex) := by
  apply IsOrthogonallyInvariant.isRadial
  unfold brrsRadialHalfWaveTestPacket
  rw [SchwartzMap.fourierInv_coe]
  apply IsOrthogonallyInvariant.fourierInv
  intro A
  funext xi
  change brrsDyadicHalfWaveSchwartzSymbol Φ j (-referenceTime) (A xi) =
    brrsDyadicHalfWaveSchwartzSymbol Φ j (-referenceTime) xi
  simp only [brrsDyadicHalfWaveSchwartzSymbol_apply, brrsDyadicHalfWaveSymbol]
  have hphase : halfWaveMultiplier (-referenceTime) (A xi) =
      halfWaveMultiplier (-referenceTime) xi := by
    simpa only [Function.comp_apply] using
      congrFun (halfWaveMultiplier_orthogonallyInvariant (-referenceTime) A) xi
  have hmult : brrsDyadicMultiplier Φ j (A xi) = brrsDyadicMultiplier Φ j xi := by
    simpa only [Function.comp_apply] using
      congrFun (brrsDyadicMultiplier_orthogonallyInvariant Φ j A) xi
  rw [hphase, hmult]

/-- Exact propagated-packet identity.  The output is the inverse Fourier
transform of the radial phase at the relative time `t - referenceTime` times
the square of the fixed annular multiplier.  Establishing a quantitative
lower bound for this integral on the radial shells is the separate
stationary-phase step not asserted here. -/
theorem brrsDyadicHalfWave_radialTestPacket_eq_fourierInv {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (referenceTime t : Real) :
    brrsDyadicHalfWave Φ j t (brrsRadialHalfWaveTestPacket Φ j referenceTime) =
      𝓕⁻ (fun xi : BRRSSpace d =>
        halfWaveMultiplier (t - referenceTime) xi *
          brrsDyadicMultiplier Φ j xi * brrsDyadicMultiplier Φ j xi) := by
  funext x
  unfold brrsDyadicHalfWave
  apply congrArg (fun g : BRRSSpace d → Complex => 𝓕⁻ g x)
  funext xi
  rw [brrsRadialHalfWaveTestPacket_fourier_apply,
    brrsDyadicHalfWaveSymbol]
  have hphase : halfWaveMultiplier t xi * halfWaveMultiplier (-referenceTime) xi =
      halfWaveMultiplier (t - referenceTime) xi := by
    simpa only [sub_eq_add_neg] using
      (halfWaveMultiplier_add t (-referenceTime) xi).symm
  calc
    halfWaveMultiplier t xi * brrsDyadicMultiplier Φ j xi *
        (halfWaveMultiplier (-referenceTime) xi * brrsDyadicMultiplier Φ j xi) =
        (halfWaveMultiplier t xi * halfWaveMultiplier (-referenceTime) xi) *
          brrsDyadicMultiplier Φ j xi * brrsDyadicMultiplier Φ j xi := by ring
    _ = _ := by rw [hphase]

/-- The corrected radial test datum for the sharpness argument.  Its Fourier
transform is the formal adjoint annular half-wave symbol at
`referenceTime`: in particular, its cutoff factor is the conjugate of the
forward cutoff.  This choice is essential when the fixed annular cutoff is
complex-valued, since propagation then produces the positive density
`Φ * conj Φ`, rather than `Φ ^ 2`. -/
noncomputable def brrsPositiveRadialHalfWaveTestPacket {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (referenceTime : Real) : BRRSSchwartz d :=
  𝓕⁻ (brrsDyadicHalfWaveSchwartzAdjointSymbol Φ j referenceTime)

/-- Fourier-side formula for the corrected back-propagated test packet. -/
theorem brrsPositiveRadialHalfWaveTestPacket_fourier_apply {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (referenceTime : Real) (xi : BRRSSpace d) :
    𝓕 (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime : BRRSSpace d → Complex) xi =
      halfWaveMultiplier (-referenceTime) xi *
        starRingEnd Complex (brrsDyadicMultiplier Φ j xi) := by
  unfold brrsPositiveRadialHalfWaveTestPacket
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq,
    brrsDyadicHalfWaveSchwartzAdjointSymbol_apply, brrsDyadicHalfWaveSymbol,
    map_mul, star_halfWaveMultiplier]

/-- The corrected back-propagated packet is radial in physical space. -/
theorem brrsPositiveRadialHalfWaveTestPacket_isRadial {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (referenceTime : Real) :
    IsRadial
      (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime : BRRSSpace d → Complex) := by
  apply IsOrthogonallyInvariant.isRadial
  unfold brrsPositiveRadialHalfWaveTestPacket
  rw [SchwartzMap.fourierInv_coe]
  apply IsOrthogonallyInvariant.fourierInv
  intro A
  funext xi
  change brrsDyadicHalfWaveSchwartzAdjointSymbol Φ j referenceTime (A xi) =
    brrsDyadicHalfWaveSchwartzAdjointSymbol Φ j referenceTime xi
  have hsymbol : brrsDyadicHalfWaveSymbol Φ j referenceTime (A xi) =
      brrsDyadicHalfWaveSymbol Φ j referenceTime xi := by
    unfold brrsDyadicHalfWaveSymbol
    have hphase : halfWaveMultiplier referenceTime (A xi) =
        halfWaveMultiplier referenceTime xi := by
      simpa only [Function.comp_apply] using
        congrFun (halfWaveMultiplier_orthogonallyInvariant referenceTime A) xi
    have hmult : brrsDyadicMultiplier Φ j (A xi) = brrsDyadicMultiplier Φ j xi := by
      simpa only [Function.comp_apply] using
        congrFun (brrsDyadicMultiplier_orthogonallyInvariant Φ j A) xi
    rw [hphase, hmult]
  rw [brrsDyadicHalfWaveSchwartzAdjointSymbol_apply,
    brrsDyadicHalfWaveSchwartzAdjointSymbol_apply]
  exact congrArg (starRingEnd Complex) hsymbol

/-- Conjugating an inverse Fourier transform after reflecting space is the
inverse Fourier transform of the conjugated frequency profile.  This is kept
local to the BRRS packet development because it identifies the literal
adjoint packet with the ordinary half-wave kernel without introducing a
second, conjugated cutoff object. -/
private theorem brrs_star_fourierInv_neg_eq_fourierInv_star
    {d : Nat} (psi : Euclidean d → Complex) (x : Euclidean d) :
    starRingEnd Complex (𝓕⁻ psi (-x)) =
      𝓕⁻ (fun xi => starRingEnd Complex (psi xi)) x := by
  rw [Real.fourierInv_eq, Real.fourierInv_eq, ← integral_conj]
  apply integral_congr_ae
  filter_upwards with xi
  have hchar :
      starRingEnd Complex
          ((Real.fourierChar (inner Real xi (-x)) : Circle) : Complex) =
        ((Real.fourierChar (inner Real xi x) : Circle) : Complex) := by
    rw [Real.fourierChar_apply, Real.fourierChar_apply, ← Complex.exp_conj]
    congr 1
    simp only [inner_neg_right, map_mul, Complex.conj_ofReal,
      Complex.conj_I]
    norm_num
  rw [Circle.smul_def, Circle.smul_def, smul_eq_mul, smul_eq_mul, map_mul,
    hchar]

/-- The BRRS positive adjoint test packet is the reflected conjugate of the
ordinary annular half-wave kernel.  Hence every literal stationary estimate
for that kernel applies to the packet itself, with no reality assumption on
the cutoff. -/
theorem brrsPositiveRadialHalfWaveTestPacket_eq_star_neg_halfWaveKernel
    {d : Nat} (Φ : BRRSAnnularCutoff) (j : Nat) (referenceTime : Real)
    (x : BRRSSpace d) :
    brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime x =
      starRingEnd Complex
        ((brrsDyadicHalfWaveKernel Φ j referenceTime : BRRSSpace d → Complex) (-x)) := by
  unfold brrsPositiveRadialHalfWaveTestPacket brrsDyadicHalfWaveKernel
  rw [SchwartzMap.fourierInv_coe, SchwartzMap.fourierInv_coe]
  symm
  rw [brrs_star_fourierInv_neg_eq_fourierInv_star]
  apply congrArg (fun F : BRRSSpace d → Complex => 𝓕⁻ F x)
  funext xi
  rw [brrsDyadicHalfWaveSchwartzAdjointSymbol_apply,
    brrsDyadicHalfWaveSchwartzSymbol_apply]

/-- The product of a BRRS annular multiplier with its complex conjugate is
its nonnegative squared modulus. -/
theorem brrsDyadicMultiplier_mul_star_eq_norm_sq {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (xi : BRRSSpace d) :
    brrsDyadicMultiplier Φ j xi *
        starRingEnd Complex (brrsDyadicMultiplier Φ j xi) =
      (‖brrsDyadicMultiplier Φ j xi‖ : Complex) ^ 2 := by
  exact RCLike.mul_conj _

/-- Exact propagation identity for the corrected radial test packet.  The
output has relative phase `t - referenceTime` and the positive cutoff
density `|brrsDyadicMultiplier Φ j|²`. -/
theorem brrsDyadicHalfWave_positiveRadialTestPacket_eq_fourierInv {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (referenceTime t : Real) :
    brrsDyadicHalfWave Φ j t (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime) =
      𝓕⁻ (fun xi : BRRSSpace d =>
        halfWaveMultiplier (t - referenceTime) xi *
          brrsDyadicMultiplier Φ j xi *
            starRingEnd Complex (brrsDyadicMultiplier Φ j xi)) := by
  funext x
  unfold brrsDyadicHalfWave
  apply congrArg (fun g : BRRSSpace d → Complex => 𝓕⁻ g x)
  funext xi
  rw [brrsPositiveRadialHalfWaveTestPacket_fourier_apply]
  have hphase : halfWaveMultiplier t xi * halfWaveMultiplier (-referenceTime) xi =
      halfWaveMultiplier (t - referenceTime) xi := by
    simpa only [sub_eq_add_neg] using
      (halfWaveMultiplier_add t (-referenceTime) xi).symm
  calc
    halfWaveMultiplier t xi * brrsDyadicMultiplier Φ j xi *
        (halfWaveMultiplier (-referenceTime) xi *
          starRingEnd Complex (brrsDyadicMultiplier Φ j xi)) =
        (halfWaveMultiplier t xi * halfWaveMultiplier (-referenceTime) xi) *
          brrsDyadicMultiplier Φ j xi *
            starRingEnd Complex (brrsDyadicMultiplier Φ j xi) := by ring
    _ = _ := by rw [hphase]

/-- The propagated positive packet is exactly the physical `T_t T_s^*`
kernel, with `s = referenceTime`.  This identifies the concrete sharpness
packet with the stationary kernel development without making any lower-bound
claim. -/
theorem brrsDyadicHalfWave_positiveRadialTestPacket_eq_ttStarKernel {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (referenceTime t : Real) :
    brrsDyadicHalfWave Φ j t (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime) =
      (brrsDyadicHalfWaveTTStarKernel Φ j referenceTime t :
        BRRSSpace d → Complex) := by
  rw [brrsDyadicHalfWave_positiveRadialTestPacket_eq_fourierInv]
  unfold brrsDyadicHalfWaveTTStarKernel
  rw [SchwartzMap.fourierInv_coe]
  apply congrArg (fun g : BRRSSpace d → Complex => 𝓕⁻ g)
  funext xi
  exact (brrsDyadicHalfWaveTTStarSchwartzSymbol_eq_relativePhase
    Φ j referenceTime t xi).symm

/-- The preceding propagated-packet formula written with the explicitly
nonnegative squared-modulus cutoff density. -/
theorem brrsDyadicHalfWave_positiveRadialTestPacket_eq_fourierInv_norm_sq {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (referenceTime t : Real) :
    brrsDyadicHalfWave Φ j t (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime) =
      𝓕⁻ (fun xi : BRRSSpace d =>
        halfWaveMultiplier (t - referenceTime) xi *
          (‖brrsDyadicMultiplier Φ j xi‖ : Complex) ^ 2) := by
  rw [brrsDyadicHalfWave_positiveRadialTestPacket_eq_fourierInv]
  congr 1
  funext xi
  rw [mul_assoc, brrsDyadicMultiplier_mul_star_eq_norm_sq]

/-! ### Nonvanishing stationary endpoint coefficients

The lower-bound argument in BRRS, Section 3, needs the leading stationary
coefficient at a meridional endpoint to be nonzero.  The following facts
record that exact algebraic input for both the nonplanar and planar endpoint
profiles.  They deliberately do *not* assert the separate, still-substantive
uniform stationary asymptotic for their quadratic oscillatory integrals. -/

/-- The coordinate cutoff used in the meridional stationary chart equals one
at the stationary endpoint. -/
private theorem brrs_endpointCoreCutoff_zero : endpointCoreCutoff 0 = 1 := by
  unfold endpointCoreCutoff
  apply endpointCoreBump.one_of_mem_closedBall
  rw [Metric.mem_closedBall]
  norm_num [endpointCoreBump]

/-- The nonplanar meridional endpoint profile has a nonzero leading
coefficient at its stationary point.  This is only the coefficient input to
a future stationary *lower* asymptotic. -/
theorem brrs_smoothEndpointProfile_zero_ne_zero (m : Nat) :
    Ne ((smoothEndpointProfile m) 0) 0 := by
  unfold smoothEndpointProfile smoothEndpointProfileReal endpointGuardedCoordinate
  rw [show endpointGuardCutoff 0 * 0 = 0 by ring, brrs_endpointCoreCutoff_zero]
  norm_num

/-- The nonzero nonplanar leading coefficient persists on some neighbourhood
of the stationary endpoint.  No quantitative quadratic stationary lower
bound is claimed here. -/
theorem brrs_exists_smoothEndpointProfile_nonzero_neighborhood (m : Nat) :
    Exists (fun eps : Real => And (0 < eps) ((u : Real) -> |u| < eps ->
      Ne ((smoothEndpointProfile m) u) 0)) := by
  have hopen : IsOpen (Function.support (smoothEndpointProfile m)) :=
    (contDiff_smoothEndpointProfile m).continuous.isOpen_support
  have hmem : Function.support (smoothEndpointProfile m) 0 := by
    exact brrs_smoothEndpointProfile_zero_ne_zero m
  let hExists := Metric.isOpen_iff.mp hopen 0 hmem
  let eps := Exists.choose hExists
  have heps : 0 < eps := (Exists.choose_spec hExists).1
  have hsub : Set.Subset (Metric.ball 0 eps) (Function.support (smoothEndpointProfile m)) :=
    (Exists.choose_spec hExists).2
  exact Exists.intro eps (And.intro heps (fun u hu => by
    apply hsub
    rw [Metric.mem_ball, Real.dist_eq]
    simpa using hu))

/-- The planar meridional endpoint profile likewise has a nonzero leading
coefficient at its stationary point.  As above, this is not a stationary
phase lower estimate. -/
theorem brrs_planarEndpointProfile_zero_ne_zero : Ne (planarEndpointProfile 0) 0 := by
  unfold planarEndpointProfile planarEndpointProfileReal endpointGuardedCoordinate
  rw [show endpointGuardCutoff 0 * 0 = 0 by ring, brrs_endpointCoreCutoff_zero]
  norm_num

/-- The planar leading coefficient remains nonzero in a neighbourhood of the
stationary endpoint; the required uniform asymptotic remains a later analytic
step. -/
theorem brrs_exists_planarEndpointProfile_nonzero_neighborhood :
    Exists (fun eps : Real => And (0 < eps) ((u : Real) -> |u| < eps ->
      Ne (planarEndpointProfile u) 0)) := by
  have hopen : IsOpen (Function.support planarEndpointProfile) :=
    contDiff_planarEndpointProfile.continuous.isOpen_support
  have hmem : Function.support planarEndpointProfile 0 := by
    exact brrs_planarEndpointProfile_zero_ne_zero
  let hExists := Metric.isOpen_iff.mp hopen 0 hmem
  let eps := Exists.choose hExists
  have heps : 0 < eps := (Exists.choose_spec hExists).1
  have hsub : Set.Subset (Metric.ball 0 eps) (Function.support planarEndpointProfile) :=
    (Exists.choose_spec hExists).2
  exact Exists.intro eps (And.intro heps (fun u hu => by
    apply hsub
    rw [Metric.mem_ball, Real.dist_eq]
    simpa using hu))

/-! ### The `p = 2` sharpness packet

At the Hilbert-space endpoint no stationary-phase lower bound is needed.
The corrected adjoint packet has exactly the same spatial `L²` energy at
every time, and its input/output moment ratio is invariant under the dyadic
frequency rescaling.  The lemmas in this subsection isolate those facts
before the entropy contradiction below. -/

/-- The BRRS half-wave phase is unimodular in every dimension. -/
theorem norm_halfWaveMultiplier_eq_one {d : Nat} (t : Real) (xi : BRRSSpace d) :
    ‖halfWaveMultiplier (d := d) t xi‖ = 1 := by
  change ‖Complex.exp (((2 * Real.pi * t * ‖xi‖ : Real) : Complex) * Complex.I)‖ = 1
  exact Complex.norm_exp_ofReal_mul_I _

/-- Plancherel normalization for the ordinary BRRS Section 3 packet.  The
back-propagating phase is unimodular, so this is the second annular moment
with no positivity or reality assumption on the cutoff. -/
theorem integral_norm_sq_brrsRadialHalfWaveTestPacket {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (referenceTime : Real) :
    (∫ x : BRRSSpace d,
      ‖brrsRadialHalfWaveTestPacket Φ j referenceTime x‖ ^ 2) =
      ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ j xi‖ ^ 2 := by
  calc
    (∫ x : BRRSSpace d,
        ‖brrsRadialHalfWaveTestPacket Φ j referenceTime x‖ ^ 2) =
        ∫ xi : BRRSSpace d,
          ‖𝓕 (brrsRadialHalfWaveTestPacket Φ j referenceTime :
            BRRSSpace d → Complex) xi‖ ^ 2 := by
      exact
        (Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq
          (brrsRadialHalfWaveTestPacket Φ j referenceTime)).symm
    _ = ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ j xi‖ ^ 2 := by
      apply integral_congr_ae
      filter_upwards with xi
      rw [brrsRadialHalfWaveTestPacket_fourier_apply, brrsDyadicHalfWaveSymbol, norm_mul,
        norm_halfWaveMultiplier_eq_one, one_mul]

/-- The positive adjoint packet has frequency-side energy exactly equal to
the second annular-multiplier moment. -/
theorem integral_norm_sq_brrsPositiveRadialHalfWaveTestPacket {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (referenceTime : Real) :
    (∫ x : BRRSSpace d,
      ‖brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime x‖ ^ 2) =
      ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ j xi‖ ^ 2 := by
  calc
    (∫ x : BRRSSpace d,
        ‖brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime x‖ ^ 2) =
        ∫ xi : BRRSSpace d,
          ‖𝓕 (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime :
            BRRSSpace d → Complex) xi‖ ^ 2 := by
      exact
        (Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq
          (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime)).symm
    _ = ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ j xi‖ ^ 2 := by
      apply integral_congr_ae
      filter_upwards with xi
      rw [brrsPositiveRadialHalfWaveTestPacket_fourier_apply, norm_mul,
        norm_halfWaveMultiplier_eq_one, Complex.norm_conj, one_mul]

/-- Every propagated positive adjoint packet has the same energy, namely the
fourth annular-multiplier moment. -/
theorem integral_norm_sq_brrsDyadicHalfWave_positiveRadialTestPacket {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (referenceTime t : Real) :
    (∫ x : BRRSSpace d,
      ‖brrsDyadicHalfWave Φ j t
        (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime) x‖ ^ 2) =
      ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ j xi‖ ^ 4 := by
  calc
    (∫ x : BRRSSpace d,
        ‖brrsDyadicHalfWave Φ j t
          (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime) x‖ ^ 2) =
        ∫ xi : BRRSSpace d,
          ‖brrsDyadicHalfWaveSchwartzSymbol Φ j t xi *
            𝓕 (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime :
              BRRSSpace d → Complex) xi‖ ^ 2 := by
      simpa only [brrsDyadicHalfWave,
        brrsDyadicHalfWaveSchwartzSymbol_apply, brrsDyadicHalfWaveSymbol,
        SchwartzMap.fourier_coe] using
        (Auto.Spherical.Auxiliary.integral_norm_sq_fourierInv_schwartz_multiplier_eq
          (brrsDyadicHalfWaveSchwartzSymbol Φ j t)
          (𝓕 (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime)))
    _ = ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ j xi‖ ^ 4 := by
      apply integral_congr_ae
      filter_upwards with xi
      rw [brrsDyadicHalfWaveSchwartzSymbol_apply, brrsDyadicHalfWaveSymbol,
        brrsPositiveRadialHalfWaveTestPacket_fourier_apply]
      simp only [norm_mul, norm_halfWaveMultiplier_eq_one, Complex.norm_conj,
        one_mul]
      ring

/-- Frequency-side dilation of the BRRS annular cutoff, stated in the form
needed for the Hilbert-space sharpness packet. -/
theorem brrsDyadicMultiplier_eq_levelZero_scaled_for_pTwo {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (xi : BRRSSpace d) :
    brrsDyadicMultiplier Φ j xi =
      brrsDyadicMultiplier Φ 0 (((2 : Real) ^ j)⁻¹ • xi) := by
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hnorm : ‖q⁻¹ • xi‖ = q⁻¹ * ‖xi‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hq)]
  unfold brrsDyadicMultiplier
  rw [hnorm]
  simp only [pow_zero, inv_one, mul_one]
  change Φ.symbol (2 * Real.pi * ((2 : Real) ^ j)⁻¹ * ‖xi‖) =
    Φ.symbol (2 * Real.pi * (q⁻¹ * ‖xi‖))
  congr 1
  dsimp only [q]
  ring

/-- The annular multiplier moments scale by the Euclidean Jacobian. -/
theorem integral_norm_pow_brrsDyadicMultiplier_eq_levelZero_scaled_for_pTwo
    {d : Nat} (Φ : BRRSAnnularCutoff) (j n : Nat) :
    (∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ j xi‖ ^ n) =
      ((2 : Real) ^ j) ^ d *
        ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ 0 xi‖ ^ n := by
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  calc
    (∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ j xi‖ ^ n) =
        ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ 0 (q⁻¹ • xi)‖ ^ n := by
      apply integral_congr_ae
      filter_upwards with xi
      simpa only [q] using congrArg (fun z : Complex => ‖z‖ ^ n)
        (brrsDyadicMultiplier_eq_levelZero_scaled_for_pTwo Φ j xi)
    _ = q ^ Module.finrank Real (BRRSSpace d) •
        ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ 0 xi‖ ^ n := by
      exact Measure.integral_comp_inv_smul_of_nonneg volume
        (fun xi : BRRSSpace d => ‖brrsDyadicMultiplier Φ 0 xi‖ ^ n) hq.le
    _ = ((2 : Real) ^ j) ^ d *
        ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ 0 xi‖ ^ n := by
      simp only [q, finrank_euclideanSpace_fin, smul_eq_mul]

/-- A nontrivial annular cutoff remains nonzero at some level-zero Fourier
frequency in every positive Euclidean dimension. -/
theorem exists_brrsDyadicMultiplier_levelZero_ne_zero {d : Nat}
    (hd : 0 < d) (Φ : BRRSAnnularCutoff) :
    ∃ xi : BRRSSpace d, brrsDyadicMultiplier Φ 0 xi ≠ 0 := by
  rcases Φ.nontrivial with ⟨r, hr⟩
  have hrsupport : r ∈ tsupport (Φ.symbol : Real → Complex) :=
    subset_tsupport _ (Function.mem_support.mpr hr)
  have hrpos : 0 < r := lt_trans (by norm_num) (Φ.tsupport_subset hrsupport).1
  letI : Nonempty (Fin d) := Fin.pos_iff_nonempty.mp hd
  obtain ⟨xi, hxi⟩ := exists_norm_eq (BRRSSpace d)
    (show 0 ≤ r / (2 * Real.pi) by positivity)
  refine ⟨xi, ?_⟩
  rw [brrsDyadicMultiplier_apply, hxi]
  have harg : brrsFrequencyScale 0 * (r / (2 * Real.pi)) = r := by
    unfold brrsFrequencyScale
    field_simp [Real.pi_ne_zero]
  rw [harg]
  exact hr

/-- The level-zero second annular moment is strictly positive. -/
theorem integral_norm_sq_brrsDyadicMultiplier_levelZero_pos {d : Nat}
    (hd : 0 < d) (Φ : BRRSAnnularCutoff) :
    0 < ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ 0 xi‖ ^ 2 := by
  obtain ⟨xi, hxi⟩ := exists_brrsDyadicMultiplier_levelZero_ne_zero hd Φ
  apply MeasureTheory.integral_pos_of_integrable_nonneg_nonzero
    ((brrsDyadicMultiplierSchwartz Φ 0).continuous.norm.pow 2)
  · change Integrable (fun x : BRRSSpace d =>
      ‖brrsDyadicMultiplier Φ 0 x‖ ^ 2) volume
    simpa only [brrsDyadicMultiplierSchwartz_apply] using
      ((brrsDyadicMultiplierSchwartz Φ 0).memLp 2 volume).integrable_norm_pow
        (by norm_num)
  · intro x
    simp only [Pi.pow_apply]
    exact sq_nonneg _
  · simpa only [Pi.pow_apply, brrsDyadicMultiplierSchwartz_apply] using
      (pow_ne_zero 2 (norm_ne_zero_iff.mpr hxi))

/-- The level-zero fourth annular moment is strictly positive. -/
theorem integral_norm_four_brrsDyadicMultiplier_levelZero_pos {d : Nat}
    (hd : 0 < d) (Φ : BRRSAnnularCutoff) :
    0 < ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ 0 xi‖ ^ 4 := by
  obtain ⟨xi, hxi⟩ := exists_brrsDyadicMultiplier_levelZero_ne_zero hd Φ
  apply MeasureTheory.integral_pos_of_integrable_nonneg_nonzero
    ((brrsDyadicMultiplierSchwartz Φ 0).continuous.norm.pow 4)
  · change Integrable (fun x : BRRSSpace d =>
      ‖brrsDyadicMultiplier Φ 0 x‖ ^ 4) volume
    simpa only [brrsDyadicMultiplierSchwartz_apply] using
      ((brrsDyadicMultiplierSchwartz Φ 0).memLp 4 volume).integrable_norm_pow
        (by norm_num)
  · intro x
    simp only [Pi.pow_apply]
    positivity
  · simpa only [Pi.pow_apply, brrsDyadicMultiplierSchwartz_apply] using
      (pow_ne_zero 4 (norm_ne_zero_iff.mpr hxi))

/-- Every dyadic annular second moment is strictly positive.  This is the
frequency-side positivity used by the positive `TT*` test packet. -/
theorem integral_norm_sq_brrsDyadicMultiplier_pos {d : Nat}
    (hd : 0 < d) (Φ : BRRSAnnularCutoff) (j : Nat) :
    0 < ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ j xi‖ ^ 2 := by
  rw [integral_norm_pow_brrsDyadicMultiplier_eq_levelZero_scaled_for_pTwo Φ j 2]
  exact mul_pos (by positivity) (integral_norm_sq_brrsDyadicMultiplier_levelZero_pos hd Φ)

/-- At the spatial origin, the inverse Fourier transform is the ordinary
integral of its frequency profile.  This elementary identity is kept here so
that the positive `TT*` packet can expose its nonzero central value without
introducing a separate Fourier convention. -/
theorem brrs_fourierInv_zero_eq_integral {d : Nat} (F : BRRSSpace d → Complex) :
    𝓕⁻ F (0 : BRRSSpace d) = ∫ xi : BRRSSpace d, F xi := by
  rw [Real.fourierInv_eq]
  simp

/-- At its reference time, the positive adjoint test packet takes the
strictly positive second annular moment at the spatial origin. -/
theorem brrsDyadicHalfWave_positiveRadialTestPacket_reference_zero_eq_secondMoment
    {d : Nat} (Φ : BRRSAnnularCutoff) (j : Nat) (referenceTime : Real) :
    brrsDyadicHalfWave (d := d) Φ j referenceTime
      (brrsPositiveRadialHalfWaveTestPacket (d := d) Φ j referenceTime) 0 =
        ((∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ j xi‖ ^ 2) : Complex) := by
  rw [brrsDyadicHalfWave_positiveRadialTestPacket_eq_fourierInv_norm_sq]
  have hprofile :
      (fun xi : BRRSSpace d =>
        halfWaveMultiplier (referenceTime - referenceTime) xi *
          (‖brrsDyadicMultiplier Φ j xi‖ : Complex) ^ 2) =
        fun xi : BRRSSpace d =>
          ((‖brrsDyadicMultiplier Φ j xi‖ ^ 2 : Real) : Complex) := by
    funext xi
    simp [halfWaveMultiplier]
  rw [hprofile, brrs_fourierInv_zero_eq_integral]
  simp

/-- The reference-time central value of the positive packet cannot vanish,
because its Fourier density is the nontrivial nonnegative annular density. -/
theorem brrsDyadicHalfWave_positiveRadialTestPacket_reference_zero_ne_zero
    {d : Nat} (hd : 0 < d) (Φ : BRRSAnnularCutoff) (j : Nat)
    (referenceTime : Real) :
    brrsDyadicHalfWave (d := d) Φ j referenceTime
      (brrsPositiveRadialHalfWaveTestPacket (d := d) Φ j referenceTime) 0 ≠ 0 := by
  have hmoment :
      (∫ xi : BRRSSpace d, (‖brrsDyadicMultiplier Φ j xi‖ : Complex) ^ 2) ≠ 0 := by
    let M : Real := ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ j xi‖ ^ 2
    have hcast :
        (∫ xi : BRRSSpace d, (‖brrsDyadicMultiplier Φ j xi‖ : Complex) ^ 2) =
          (M : Complex) := by
      calc
        (∫ xi : BRRSSpace d, (‖brrsDyadicMultiplier Φ j xi‖ : Complex) ^ 2) =
            ∫ xi : BRRSSpace d,
              ((‖brrsDyadicMultiplier Φ j xi‖ ^ 2 : Real) : Complex) := by
          apply integral_congr_ae
          filter_upwards with xi
          norm_cast
        _ = (M : Complex) := by
          dsimp only [M]
          exact integral_ofReal
            (𝕜 := Complex)
            (f := fun xi : BRRSSpace d => ‖brrsDyadicMultiplier Φ j xi‖ ^ 2)
            (μ := volume)
    have hpositive : (M : Complex) ≠ 0 := by
      apply Complex.ofReal_ne_zero.mpr
      dsimp only [M]
      exact ne_of_gt (integral_norm_sq_brrsDyadicMultiplier_pos hd Φ j)
    intro hzero
    apply hpositive
    rw [← hcast]
    exact hzero
  rw [brrsDyadicHalfWave_positiveRadialTestPacket_eq_fourierInv_norm_sq]
  have hprofile :
      (fun xi : BRRSSpace d =>
        halfWaveMultiplier (referenceTime - referenceTime) xi *
          (‖brrsDyadicMultiplier Φ j xi‖ : Complex) ^ 2) =
        fun xi : BRRSSpace d =>
          (‖brrsDyadicMultiplier Φ j xi‖ : Complex) ^ 2 := by
    funext xi
    simp [halfWaveMultiplier]
  rw [hprofile, brrs_fourierInv_zero_eq_integral]
  exact hmoment

/-- The literal dyadic half-wave of a Schwartz datum is continuous.  The
Schwartz realization is used only to certify continuity; the conclusion is
about the original Fourier-defined function. -/
theorem continuous_brrsDyadicHalfWave {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (t : Real) (f : BRRSSchwartz d) :
    Continuous (brrsDyadicHalfWave Φ j t f) := by
  apply (brrsDyadicHalfWaveSchwartzPiece Φ j t f).continuous.congr
  intro x
  exact brrsDyadicHalfWaveSchwartzPiece_apply_eq_halfWave Φ j t f x

/-- The positive `TT*` test packet has a genuine pointwise lower bound on a
nontrivial radial shell at its reference time.  This is the zero-relative-time
anchor for the BRRS shell construction; obtaining analogous shells at every
nonzero relative time requires the separate cone stationary asymptotic. -/
theorem exists_brrsPositiveRadialTestPacket_reference_shell_lower
    {d : Nat} (hd : 0 < d) (Φ : BRRSAnnularCutoff) (j : Nat)
    (referenceTime : Real) :
    ∃ width c : Real, 0 < width ∧ 0 < c ∧
      ∀ x : BRRSSpace d, x ∈
        brrsTimeRadialShell d referenceTime referenceTime width →
          c ≤ ‖brrsDyadicHalfWave (d := d) Φ j referenceTime
            (brrsPositiveRadialHalfWaveTestPacket (d := d) Φ j referenceTime) x‖ := by
  let g : BRRSSpace d → Complex :=
    brrsDyadicHalfWave (d := d) Φ j referenceTime
      (brrsPositiveRadialHalfWaveTestPacket (d := d) Φ j referenceTime)
  have hzero : g 0 ≠ 0 := by
    dsimp [g]
    exact brrsDyadicHalfWave_positiveRadialTestPacket_reference_zero_ne_zero
      hd Φ j referenceTime
  let c : Real := ‖g 0‖ / 2
  have hc : 0 < c := by
    dsimp [c]
    exact half_pos (norm_pos_iff.mpr hzero)
  have hcont : Continuous g := by
    dsimp [g]
    exact continuous_brrsDyadicHalfWave Φ j referenceTime
      (brrsPositiveRadialHalfWaveTestPacket (d := d) Φ j referenceTime)
  have hopen : IsOpen {x : BRRSSpace d | c < ‖g x‖} :=
    isOpen_lt continuous_const hcont.norm
  have hmem : (0 : BRRSSpace d) ∈ {x : BRRSSpace d | c < ‖g x‖} := by
    change c < ‖g 0‖
    dsimp [c]
    exact half_lt_self (norm_pos_iff.mpr hzero)
  obtain ⟨width, hwidth, hball⟩ :=
    Metric.mem_nhds_iff.mp (hopen.mem_nhds hmem)
  refine ⟨width, c, hwidth, hc, ?_⟩
  intro x hx
  change |‖x‖ - abs (referenceTime - referenceTime)| < width at hx
  have hnorm : ‖x‖ < width := by
    simpa only [sub_self, abs_zero, sub_zero, abs_of_nonneg (norm_nonneg x)] using hx
  have hballmem : x ∈ Metric.ball (0 : BRRSSpace d) width := by
    rw [Metric.mem_ball, dist_zero_right]
    exact hnorm
  exact (hball hballmem).le

/-! ### Positive TT* cutoff bridge

For the sharpness packet the Fourier density is the genuine positive density
`Φ · conj Φ`, rather than an auxiliary cutoff.  Packaging that density as an
annular Schwartz cutoff lets the already-established stationary normal form
be applied to the exact `TT*` kernel without silently assuming that `Φ` is
real-valued. -/

/-- The annular cutoff whose scalar symbol is the positive `TT*` density
`Φ · conj Φ`. -/
noncomputable def brrsTTStarAnnularCutoff (Φ : BRRSAnnularCutoff) :
    BRRSAnnularCutoff where
  symbol := SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) Φ.symbol
    (Φ.symbol.postcompCLM (𝕜 := Real) (Complex.conjCLE : Complex →L[Real] Complex))
  tsupport_subset :=
    (tsupport_mul_subset_left :
      tsupport (fun r : Real => Φ.symbol r *
        (Complex.conjCLE : Complex →L[Real] Complex) (Φ.symbol r)) ⊆
        tsupport (Φ.symbol : Real → Complex)).trans Φ.tsupport_subset
  nontrivial := by
    rcases Φ.nontrivial with ⟨r, hr⟩
    refine ⟨r, ?_⟩
    change Φ.symbol r *
      (Complex.conjCLE : Complex →L[Real] Complex) (Φ.symbol r) ≠ 0
    have hconj :
        (Complex.conjCLE : Complex →L[Real] Complex) (Φ.symbol r) =
          starRingEnd Complex (Φ.symbol r) := by
      change (Complex.conjCLE : Complex →L[Real] Complex) (Φ.symbol r) =
        star (Φ.symbol r)
      exact (Complex.conjCLE_apply (Φ.symbol r)).trans
        (congrFun Complex.star_def (Φ.symbol r)).symm
    rw [hconj]
    exact mul_ne_zero hr (star_ne_zero.mpr hr)

/-- Pointwise form of the positive `TT*` annular cutoff. -/
theorem brrsTTStarAnnularCutoff_symbol_apply (Φ : BRRSAnnularCutoff) (r : Real) :
    (brrsTTStarAnnularCutoff Φ).symbol r =
      Φ.symbol r * starRingEnd Complex (Φ.symbol r) := by
  change Φ.symbol r *
    (Complex.conjCLE : Complex →L[Real] Complex) (Φ.symbol r) = _
  have hconj :
      (Complex.conjCLE : Complex →L[Real] Complex) (Φ.symbol r) =
        starRingEnd Complex (Φ.symbol r) := by
    change (Complex.conjCLE : Complex →L[Real] Complex) (Φ.symbol r) =
      star (Φ.symbol r)
    exact (Complex.conjCLE_apply (Φ.symbol r)).trans
      (congrFun Complex.star_def (Φ.symbol r)).symm
  rw [hconj]

/-- The exact `TT*` multiplier is itself a half-wave multiplier at relative
time, with the positive annular cutoff above.  This is the bridge that lets
the stationary cone normal form act on the literal positive packet. -/
theorem brrsDyadicHalfWaveTTStarSchwartzSymbol_eq_halfWaveTTStarCutoff
    {d : Nat} (Φ : BRRSAnnularCutoff) (j : Nat) (s t : Real)
    (xi : BRRSSpace d) :
    brrsDyadicHalfWaveTTStarSchwartzSymbol Φ j s t xi =
      brrsDyadicHalfWaveSchwartzSymbol (brrsTTStarAnnularCutoff Φ) j
        (t - s) xi := by
  rw [brrsDyadicHalfWaveTTStarSchwartzSymbol_eq_relativePhase,
    brrsDyadicHalfWaveSchwartzSymbol_apply,
    brrsDyadicHalfWaveSymbol,
    brrsDyadicMultiplier_apply,
    brrsDyadicMultiplier_apply,
    brrsTTStarAnnularCutoff_symbol_apply]
  ring

/-- The physical `TT*` kernel is literally the half-wave kernel with the
positive cutoff and relative time. -/
theorem brrsDyadicHalfWaveTTStarKernel_eq_halfWaveKernelTTStarCutoff
    {d : Nat} (Φ : BRRSAnnularCutoff) (j : Nat) (s t : Real)
    (x : BRRSSpace d) :
    (brrsDyadicHalfWaveTTStarKernel Φ j s t : BRRSSpace d → Complex) x =
      (brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Φ) j (t - s) :
        BRRSSpace d → Complex) x := by
  unfold brrsDyadicHalfWaveTTStarKernel brrsDyadicHalfWaveKernel
  apply congrArg (fun F : BRRSSchwartz d =>
    ((𝓕⁻ F : BRRSSchwartz d) : BRRSSpace d → Complex) x)
  ext xi
  exact brrsDyadicHalfWaveTTStarSchwartzSymbol_eq_halfWaveTTStarCutoff
    Φ j s t xi

/-- The actual propagated positive radial test packet is the relative-time
half-wave kernel for the positive `TT*` cutoff. -/
theorem brrsDyadicHalfWave_positiveRadialTestPacket_eq_halfWaveKernelTTStarCutoff
    {d : Nat} (Φ : BRRSAnnularCutoff) (j : Nat) (referenceTime t : Real) :
    brrsDyadicHalfWave Φ j t
      (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime) =
        (brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Φ) j
          (t - referenceTime) : BRRSSpace d → Complex) := by
  rw [brrsDyadicHalfWave_positiveRadialTestPacket_eq_ttStarKernel]
  funext x
  exact brrsDyadicHalfWaveTTStarKernel_eq_halfWaveKernelTTStarCutoff
    Φ j referenceTime t x

/-- Every sufficiently small positive scale is comparable, with the exact
closed-separation convention needed above, to a strictly finer dyadic mesh. -/
theorem exists_dyadicTimeScale_lt_half_and_delta_le_four_mul
    {delta : NNReal} (hdelta : delta ∈ Ioo 0 1) :
    ∃ j : Nat, 1 ≤ j ∧ dyadicTimeScale j < (delta : Real) / 2 ∧
      (delta : Real) ≤ 4 * dyadicTimeScale j := by
  have hdelta0 : 0 < (delta : Real) := by exact_mod_cast hdelta.1
  have hdelta1 : (delta : Real) < 1 := by exact_mod_cast hdelta.2
  obtain ⟨n, hlower, hupper⟩ := exists_nat_pow_near_of_lt_one
    (x := (delta : Real) / 2) (y := (2 : Real)⁻¹)
    (by positivity) (by linarith) (by positivity) (by norm_num)
  refine ⟨n + 1, by omega, ?_, ?_⟩
  · have hscale : dyadicTimeScale (n + 1) = ((2 : Real)⁻¹) ^ (n + 1) := by
      unfold dyadicTimeScale
      rw [← inv_pow]
    rw [hscale]
    exact hlower
  · have hscale : dyadicTimeScale (n + 1) = ((2 : Real)⁻¹) ^ (n + 1) := by
      unfold dyadicTimeScale
      rw [← inv_pow]
    rw [hscale]
    calc
      (delta : Real) = 2 * ((delta : Real) / 2) := by ring
      _ ≤ 2 * ((2 : Real)⁻¹) ^ n :=
        mul_le_mul_of_nonneg_left hupper (by norm_num)
      _ = 4 * ((2 : Real)⁻¹) ^ (n + 1) := by
        rw [pow_succ]
        norm_num
        ring

/-- The positive packet is an admissible radial `L²` input for every
realization of the BRRS operator. -/
theorem brrsPositiveRadialHalfWaveTestPacket_memLp_two {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (referenceTime : Real) :
    MemLp (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime :
      BRRSSpace d → Complex) 2 volume := by
  simpa only [ENNReal.ofReal_ofNat] using
    (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime).memLp 2 volume

/-- The explicit positive radial packet is an admissible input at every
Lebesgue exponent.  Thus a future concrete `L^p` lower bound for its literal
Fourier evolution transfers to every admissible BRRS realization. -/
theorem brrsPositiveRadialHalfWaveTestPacket_memLp {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (referenceTime : Real) (p : ENNReal) :
    MemLp (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime :
      BRRSSpace d → Complex) p volume := by
  exact (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime).memLp p volume

/-- Pointwise radiality of the positive packet supplies the a.e. radiality
required by `UniformEstimateAtExponent`. -/
theorem brrsPositiveRadialHalfWaveTestPacket_isAERadial {d : Nat}
    (Φ : BRRSAnnularCutoff) (j : Nat) (referenceTime : Real) :
    IsAERadial (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime :
      BRRSSpace d → Complex) := by
  refine ⟨brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime,
    brrsPositiveRadialHalfWaveTestPacket_isRadial Φ j referenceTime, ?_⟩
  exact Eventually.of_forall fun _ => rfl

/-- Every admissible realization agrees in every `L^p` seminorm with the
literal Fourier evolution on the explicit positive Schwartz packet. -/
theorem eLpNorm_brrsLpHalfWaveExtension_apply_positiveRadialTestPacket_eq
    {d : Nat} {Φ : BRRSAnnularCutoff} (W : BRRSLpHalfWaveExtension d Φ)
    (p : ENNReal) (j : Nat) (referenceTime t : Real) :
    eLpNorm (W.apply j t
      (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime :
        BRRSSpace d → Complex)) p volume =
      eLpNorm (brrsDyadicHalfWave (d := d) Φ j t
        (brrsPositiveRadialHalfWaveTestPacket (d := d) Φ j referenceTime)) p volume := by
  exact eLpNorm_congr_ae
    (W.extends_schwartz j t
      (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime))

/-- A hypothetical BRRS estimate at a positive exponent controls every
weighted collection of literal spatial `p`-masses carried by the positive
adjoint packet.

This is the general-`p` replacement for the exact Hilbert-space energy step:
the missing stationary-phase argument need only supply the displayed lower
bound on the literal evolution, one time at a time.  No cone lower bound is
asserted here. -/
theorem exists_sum_positiveRadialTestPacket_pMass_le_of_uniformEstimateAtExponent
    {d : Nat} {Φ : BRRSAnnularCutoff} (W : BRRSLpHalfWaveExtension d Φ)
    {E : Set Real} {p s : Real} (hp : 0 < p)
    (hUniform : UniformEstimateAtExponent Φ W E p s) :
    ∃ K : Real, 0 < K ∧ ∀ j : Nat, 1 ≤ j → ∀ T : Finset Real,
      IsDyadicDiscretization E j T → ∀ referenceTime : Real,
        ∀ a : Real → ENNReal,
          (∀ t ∈ T, a t ≤ ∫⁻ x : BRRSSpace d,
            (ENNReal.ofReal ‖brrsDyadicHalfWave Φ j t
              (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime) x‖) ^ p) →
          (∑ t ∈ T, a t) ≤
            (ENNReal.ofReal (K * (2 : Real) ^ ((j : Real) * s)) *
              eLpNorm (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime :
                BRRSSpace d → Complex) (ENNReal.ofReal p) volume) ^ p := by
  rcases hUniform with ⟨K, hK, hKbound⟩
  refine ⟨K, hK, ?_⟩
  intro j hj T hT referenceTime a ha
  have hbound :
      discreteLpNorm p T (fun t => W.apply j t
        (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime :
          BRRSSpace d → Complex)) ≤
        ENNReal.ofReal (K * (2 : Real) ^ ((j : Real) * s)) *
          eLpNorm (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime :
            BRRSSpace d → Complex) (ENNReal.ofReal p) volume := by
    exact hKbound j hj T hT
      (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime :
        BRRSSpace d → Complex)
      (brrsPositiveRadialHalfWaveTestPacket_memLp Φ j referenceTime
        (ENNReal.ofReal p))
      (brrsPositiveRadialHalfWaveTestPacket_isAERadial Φ j referenceTime)
  have hmass :
      (∑ t ∈ T, a t) ≤ ∑ t ∈ T, ∫⁻ x : BRRSSpace d,
        (ENNReal.ofReal ‖W.apply j t
          (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime :
            BRRSSpace d → Complex) x‖) ^ p := by
    apply Finset.sum_le_sum
    intro t ht
    calc
      a t ≤ ∫⁻ x : BRRSSpace d,
          (ENNReal.ofReal ‖brrsDyadicHalfWave Φ j t
            (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime) x‖) ^ p :=
        ha t ht
      _ = ∫⁻ x : BRRSSpace d,
          (ENNReal.ofReal ‖W.apply j t
            (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime :
              BRRSSpace d → Complex) x‖) ^ p := by
        symm
        apply lintegral_congr_ae
        filter_upwards [W.extends_schwartz j t
          (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime)] with x hx
        rw [hx]
  calc
    (∑ t ∈ T, a t) ≤ ∑ t ∈ T, ∫⁻ x : BRRSSpace d,
        (ENNReal.ofReal ‖W.apply j t
          (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime :
            BRRSSpace d → Complex) x‖) ^ p := hmass
    _ = (discreteLpNorm p T (fun t => W.apply j t
        (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime :
          BRRSSpace d → Complex))) ^ p := by
      symm
      exact discreteLpNorm_rpow_eq_sum_lintegral_ofReal_norm_rpow hp T _
        (fun t _ => (brrsDyadicHalfWave_memLp_two Φ j t
          (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime)).aestronglyMeasurable.congr
          (W.extends_schwartz j t _).symm)
    _ ≤ (ENNReal.ofReal (K * (2 : Real) ^ ((j : Real) * s)) *
        eLpNorm (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime :
          BRRSSpace d → Complex) (ENNReal.ofReal p) volume) ^ p :=
      ENNReal.rpow_le_rpow hbound hp.le

/-- In particular, a common literal `p`-mass lower bound for every selected
time turns a hypothetical BRRS estimate into a cardinality bound.  This is
the exact interface needed once the cone stationary lower bound is proved. -/
theorem exists_positiveRadialTestPacket_card_mul_pMass_le_of_uniformEstimateAtExponent
    {d : Nat} {Φ : BRRSAnnularCutoff} (W : BRRSLpHalfWaveExtension d Φ)
    {E : Set Real} {p s : Real} (hp : 0 < p)
    (hUniform : UniformEstimateAtExponent Φ W E p s) :
    ∃ K : Real, 0 < K ∧ ∀ j : Nat, 1 ≤ j → ∀ T : Finset Real,
      IsDyadicDiscretization E j T → ∀ referenceTime : Real, ∀ A : ENNReal,
        (∀ t ∈ T, A ≤ ∫⁻ x : BRRSSpace d,
          (ENNReal.ofReal ‖brrsDyadicHalfWave Φ j t
            (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime) x‖) ^ p) →
        (T.card : ENNReal) * A ≤
          (ENNReal.ofReal (K * (2 : Real) ^ ((j : Real) * s)) *
            eLpNorm (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime :
              BRRSSpace d → Complex) (ENNReal.ofReal p) volume) ^ p := by
  rcases exists_sum_positiveRadialTestPacket_pMass_le_of_uniformEstimateAtExponent
    W hp hUniform with ⟨K, hK, hmass⟩
  refine ⟨K, hK, ?_⟩
  intro j hj T hT referenceTime A hA
  have h := hmass j hj T hT referenceTime (fun _ => A) (by
    intro t ht
    exact hA t ht)
  simpa only [Finset.sum_const, nsmul_eq_mul] using h

/-- The preceding general-`p` obstruction can be fed directly with lower
bounds on the BRRS radial shells.  Only a selected subpacket need carry the
lower bounds, since the uniform estimate is applied to any discretization
containing that subpacket.  Pairwise disjointness of the shells is not needed
at this stage: the target discrete norm already sums the spatial `p`-masses
time by time. -/
theorem exists_sum_positiveRadialTestPacket_shell_pMass_le_of_uniformEstimateAtExponent
    {d : Nat} {Φ : BRRSAnnularCutoff} (W : BRRSLpHalfWaveExtension d Φ)
    {E : Set Real} {p s : Real} (hp : 0 < p)
    (hUniform : UniformEstimateAtExponent Φ W E p s) :
    ∃ K : Real, 0 < K ∧ ∀ j : Nat, 1 ≤ j → ∀ T U : Finset Real,
      IsDyadicDiscretization E j T → U ⊆ T → ∀ referenceTime width : Real,
        ∀ a : Real → ENNReal,
          (∀ t ∈ U, a t ≤ ∫⁻ x in brrsTimeRadialShell d referenceTime t width,
            (ENNReal.ofReal ‖brrsDyadicHalfWave Φ j t
              (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime) x‖) ^ p) →
          (∑ t ∈ U, a t) ≤
            (ENNReal.ofReal (K * (2 : Real) ^ ((j : Real) * s)) *
              eLpNorm (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime :
                BRRSSpace d → Complex) (ENNReal.ofReal p) volume) ^ p := by
  classical
  rcases exists_sum_positiveRadialTestPacket_pMass_le_of_uniformEstimateAtExponent
    W hp hUniform with ⟨K, hK, hmass⟩
  refine ⟨K, hK, ?_⟩
  intro j hj T U hT hUT referenceTime width a ha
  have hTfilter : T.filter (fun t => t ∈ U) = U := by
    ext t
    simp only [Finset.mem_filter]
    constructor
    · intro ht
      exact ht.2
    · intro ht
      exact ⟨hUT ht, ht⟩
  have h := hmass j hj T hT referenceTime
    (fun t => if t ∈ U then a t else 0) (by
      intro t ht
      by_cases htu : t ∈ U
      · rw [if_pos htu]
        calc
          a t ≤ ∫⁻ x in brrsTimeRadialShell d referenceTime t width,
              (ENNReal.ofReal ‖brrsDyadicHalfWave Φ j t
                (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime) x‖) ^ p :=
            ha t htu
          _ ≤ ∫⁻ x : BRRSSpace d,
              (ENNReal.ofReal ‖brrsDyadicHalfWave Φ j t
                (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime) x‖) ^ p :=
            setLIntegral_le_lintegral _ _
      · rw [if_neg htu]
        exact bot_le)
  have hsum :
      (∑ t ∈ T, if t ∈ U then a t else 0) = ∑ t ∈ U, a t := by
    calc
      (∑ t ∈ T, if t ∈ U then a t else 0) =
          ∑ t ∈ T.filter (fun t => t ∈ U), a t := by
        rw [Finset.sum_filter]
      _ = ∑ t ∈ U, a t := by rw [hTfilter]
  exact hsum.symm.trans_le h

/-- On the positive Schwartz packet, every admissible `L²` realization has
the same spatial energy as the literal Fourier multiplier. -/
theorem integral_norm_sq_brrsLpHalfWaveExtension_apply_positiveRadialTestPacket
    {d : Nat} {Φ : BRRSAnnularCutoff} (W : BRRSLpHalfWaveExtension d Φ)
    (j : Nat) (referenceTime t : Real) :
    (∫ x : BRRSSpace d, ‖W.apply j t
      (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime :
        BRRSSpace d → Complex) x‖ ^ 2) =
      ∫ x : BRRSSpace d, ‖brrsDyadicHalfWave Φ j t
        (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime) x‖ ^ 2 := by
  apply integral_congr_ae
  filter_upwards [W.extends_schwartz j t
    (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime)] with x hx
  rw [hx]

/-- The total `L²` energy of the positive packet over a finite time set is
exactly its cardinality times the fourth annular moment. -/
theorem sum_integral_norm_sq_brrsLpHalfWaveExtension_positiveRadialTestPacket
    {d : Nat} {Φ : BRRSAnnularCutoff} (W : BRRSLpHalfWaveExtension d Φ)
    (j : Nat) (referenceTime : Real) (T : Finset Real) :
    (∑ t ∈ T, ∫ x : BRRSSpace d, ‖W.apply j t
      (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime :
        BRRSSpace d → Complex) x‖ ^ 2) =
      (T.card : Real) * ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ j xi‖ ^ 4 := by
  calc
    (∑ t ∈ T, ∫ x : BRRSSpace d, ‖W.apply j t
      (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime :
        BRRSSpace d → Complex) x‖ ^ 2) =
        ∑ t ∈ T, ∫ x : BRRSSpace d, ‖brrsDyadicHalfWave Φ j t
          (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime) x‖ ^ 2 := by
      apply Finset.sum_congr rfl
      intro t ht
      exact integral_norm_sq_brrsLpHalfWaveExtension_apply_positiveRadialTestPacket
        W j referenceTime t
    _ = ∑ _t ∈ T, ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ j xi‖ ^ 4 := by
      apply Finset.sum_congr rfl
      intro t ht
      exact integral_norm_sq_brrsDyadicHalfWave_positiveRadialTestPacket
        Φ j referenceTime t
    _ = (T.card : Real) * ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ j xi‖ ^ 4 := by
      simp only [Finset.sum_const, nsmul_eq_mul]

/-- Exact `\ell²(L²)` norm of the positive packet for any admissible BRRS
realization. -/
theorem discreteLpNorm_two_brrsLpHalfWaveExtension_positiveRadialTestPacket
    {d : Nat} {Φ : BRRSAnnularCutoff} (W : BRRSLpHalfWaveExtension d Φ)
    (j : Nat) (referenceTime : Real) (T : Finset Real) :
    discreteLpNorm 2 T (fun t => W.apply j t
      (brrsPositiveRadialHalfWaveTestPacket Φ j referenceTime :
        BRRSSpace d → Complex)) =
      (ENNReal.ofReal ((T.card : Real) *
        ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ j xi‖ ^ 4)) ^
          ((2 : Real)⁻¹) := by
  rw [discreteLpNorm_two_eq_l2Energy]
  · rw [sum_integral_norm_sq_brrsLpHalfWaveExtension_positiveRadialTestPacket]
  · intro t ht
    simpa only [ENNReal.ofReal_ofNat] using
      W.maps_memLp j t 2 (by norm_num)
        (by simpa only [ENNReal.ofReal_ofNat] using
          brrsPositiveRadialHalfWaveTestPacket_memLp_two Φ j referenceTime)

/-- Squaring a literal `\ell²(L²)` estimate gives the corresponding real
energy inequality.  This is the direction needed to turn a hypothetical
uniform estimate into a cardinality bound for the positive packet. -/
theorem l2Energy_le_of_discreteLpNorm_two_le {d : Nat}
    (T : Finset Real) (u : Real → BRRSSpace d → Complex)
    (f : BRRSSpace d → Complex)
    (hu : ∀ t ∈ T, MemLp (u t) 2 volume) (hf : MemLp f 2 volume)
    {C : Real} (hC : 0 ≤ C)
    (hbound : discreteLpNorm 2 T u ≤ ENNReal.ofReal C * eLpNorm f 2 volume) :
    (∑ t ∈ T, ∫ x : BRRSSpace d, ‖u t x‖ ^ 2) ≤
      C ^ (2 : Real) * ∫ x : BRRSSpace d, ‖f x‖ ^ 2 := by
  let S : Real := ∑ t ∈ T, ∫ x : BRRSSpace d, ‖u t x‖ ^ 2
  let I : Real := ∫ x : BRRSSpace d, ‖f x‖ ^ 2
  have hdisc : discreteLpNorm 2 T u =
      (ENNReal.ofReal S) ^ ((2 : Real)⁻¹) := by
    dsimp only [S]
    exact discreteLpNorm_two_eq_l2Energy T u hu
  have hinput : (eLpNorm f 2 volume) ^ (2 : Real) = ENNReal.ofReal I := by
    dsimp only [I]
    exact eLpNorm_two_rpow_eq_integral_norm_sq f hf
  have hpow := ENNReal.rpow_le_rpow hbound (by norm_num : (0 : Real) ≤ 2)
  have hleft : ((ENNReal.ofReal S) ^ ((2 : Real)⁻¹)) ^ (2 : Real) =
      ENNReal.ofReal S := by
    rw [← ENNReal.rpow_mul]
    norm_num
  have hS : 0 ≤ S := by
    dsimp only [S]
    exact Finset.sum_nonneg fun _ _ => integral_nonneg fun _ => sq_nonneg _
  have hI : 0 ≤ I := by
    dsimp only [I]
    exact integral_nonneg fun _ => sq_nonneg _
  apply (ENNReal.ofReal_le_ofReal_iff
    (mul_nonneg (Real.rpow_nonneg hC _) hI)).mp
  calc
    ENNReal.ofReal S = ((ENNReal.ofReal S) ^ ((2 : Real)⁻¹)) ^ (2 : Real) :=
      hleft.symm
    _ = (discreteLpNorm 2 T u) ^ (2 : Real) := by rw [hdisc]
    _ ≤ (ENNReal.ofReal C * eLpNorm f 2 volume) ^ (2 : Real) := hpow
    _ = ENNReal.ofReal (C ^ (2 : Real) * I) := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num),
        ENNReal.ofReal_rpow_of_nonneg hC (by norm_num), hinput,
        ← ENNReal.ofReal_mul (Real.rpow_nonneg hC _)]

/-- A hypothetical uniform `p = 2` BRRS estimate forces an upper bound on
the cardinality of every dyadic packet, with the exact second/fourth annular
moment ratio supplied by the positive adjoint test datum. -/
theorem exists_packet_card_energy_upper_of_uniformEstimateAtExponent_pTwo
    {d : Nat} {Φ : BRRSAnnularCutoff} (W : BRRSLpHalfWaveExtension d Φ)
    {E : Set Real} {s : Real}
    (hUniform : UniformEstimateAtExponent Φ W E 2 s) :
    ∃ K : Real, 0 < K ∧ ∀ j : Nat, 1 ≤ j → ∀ T : Finset Real,
      IsDyadicDiscretization E j T →
        (T.card : Real) * ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ j xi‖ ^ 4 ≤
          (K * (2 : Real) ^ ((j : Real) * s)) ^ (2 : Real) *
            ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ j xi‖ ^ 2 := by
  rcases hUniform with ⟨K, hK, hKbound⟩
  refine ⟨K, hK, ?_⟩
  intro j hj T hT
  let f : BRRSSpace d → Complex :=
    brrsPositiveRadialHalfWaveTestPacket Φ j 0
  have hf : MemLp f 2 volume := by
    dsimp only [f]
    exact brrsPositiveRadialHalfWaveTestPacket_memLp_two Φ j 0
  have hfradial : IsAERadial f := by
    dsimp only [f]
    exact brrsPositiveRadialHalfWaveTestPacket_isAERadial Φ j 0
  have hC : 0 ≤ K * (2 : Real) ^ ((j : Real) * s) :=
    mul_nonneg hK.le (Real.rpow_nonneg (by norm_num) _)
  have hbound : discreteLpNorm 2 T (fun t => W.apply j t f) ≤
      ENNReal.ofReal (K * (2 : Real) ^ ((j : Real) * s)) * eLpNorm f 2 volume := by
    simpa only [ENNReal.ofReal_ofNat] using hKbound j hj T hT f
      (by simpa only [ENNReal.ofReal_ofNat] using hf) hfradial
  calc
    (T.card : Real) * ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ j xi‖ ^ 4 =
        ∑ t ∈ T, ∫ x : BRRSSpace d, ‖W.apply j t f x‖ ^ 2 := by
      dsimp only [f]
      symm
      exact sum_integral_norm_sq_brrsLpHalfWaveExtension_positiveRadialTestPacket
        W j 0 T
    _ ≤ (K * (2 : Real) ^ ((j : Real) * s)) ^ (2 : Real) *
        ∫ x : BRRSSpace d, ‖f x‖ ^ 2 := by
      apply l2Energy_le_of_discreteLpNorm_two_le T (fun t => W.apply j t f) f
        (fun t ht => by
          simpa only [ENNReal.ofReal_ofNat] using
            W.maps_memLp j t 2 (by norm_num)
              (by simpa only [ENNReal.ofReal_ofNat] using hf)) hf hC hbound
    _ = (K * (2 : Real) ^ ((j : Real) * s)) ^ (2 : Real) *
        ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ j xi‖ ^ 2 := by
      rw [integral_norm_sq_brrsPositiveRadialHalfWaveTestPacket]

/-- Strict comparison of dyadic meshes detects the reverse comparison of
their integer levels. -/
theorem lt_of_dyadicTimeScale_lt {j N : Nat}
    (hscale : dyadicTimeScale j < dyadicTimeScale N) : N < j := by
  by_contra hnot
  have hjN : j ≤ N := Nat.le_of_not_gt hnot
  have hpow : (2 : Real) ^ j ≤ (2 : Real) ^ N :=
    pow_le_pow_right₀ (by norm_num) hjN
  have hpowpos : 0 < (2 : Real) ^ j := pow_pos (by norm_num) _
  have hinv : ((2 : Real) ^ N)⁻¹ ≤ ((2 : Real) ^ j)⁻¹ := by
    simpa only [one_div] using one_div_le_one_div_of_le hpowpos hpow
  exact (not_lt_of_ge (by simpa only [dyadicTimeScale] using hinv)) hscale

/-- After cancelling the common dyadic Jacobian, a hypothetical uniform
`p = 2` estimate bounds the cardinality of every dyadic discretization by a
fixed annular-moment ratio. -/
theorem exists_packet_card_upper_of_uniformEstimateAtExponent_pTwo
    {d : Nat} {Φ : BRRSAnnularCutoff} (hd : 0 < d)
    (W : BRRSLpHalfWaveExtension d Φ) {E : Set Real} {s : Real}
    (hUniform : UniformEstimateAtExponent Φ W E 2 s) :
    ∃ K : Real, 0 < K ∧ ∀ j : Nat, 1 ≤ j → ∀ T : Finset Real,
      IsDyadicDiscretization E j T →
        (T.card : Real) ≤
          ((K * (2 : Real) ^ ((j : Real) * s)) ^ (2 : Real) *
            ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ 0 xi‖ ^ 2) /
              (∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ 0 xi‖ ^ 4) := by
  rcases exists_packet_card_energy_upper_of_uniformEstimateAtExponent_pTwo W hUniform
    with ⟨K, hK, hKbound⟩
  have hB : 0 < ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ 0 xi‖ ^ 4 :=
    integral_norm_four_brrsDyadicMultiplier_levelZero_pos hd Φ
  refine ⟨K, hK, ?_⟩
  intro j hj T hT
  have hraw := hKbound j hj T hT
  have hq : 0 < ((2 : Real) ^ j) ^ d := by positivity
  have hA : (∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ j xi‖ ^ 2) =
      ((2 : Real) ^ j) ^ d *
        ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ 0 xi‖ ^ 2 :=
    integral_norm_pow_brrsDyadicMultiplier_eq_levelZero_scaled_for_pTwo Φ j 2
  have hBscale : (∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ j xi‖ ^ 4) =
      ((2 : Real) ^ j) ^ d *
        ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ 0 xi‖ ^ 4 :=
    integral_norm_pow_brrsDyadicMultiplier_eq_levelZero_scaled_for_pTwo Φ j 4
  apply (le_div_iff₀ hB).mpr
  apply le_of_mul_le_mul_left (a0 := hq)
  calc
    ((2 : Real) ^ j) ^ d *
        ((T.card : Real) * ∫ xi : BRRSSpace d,
          ‖brrsDyadicMultiplier Φ 0 xi‖ ^ 4) =
        (T.card : Real) * ∫ xi : BRRSSpace d,
          ‖brrsDyadicMultiplier Φ j xi‖ ^ 4 := by
      rw [hBscale]
      ring
    _ ≤ (K * (2 : Real) ^ ((j : Real) * s)) ^ (2 : Real) *
        ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ j xi‖ ^ 2 := hraw
    _ = ((2 : Real) ^ j) ^ d *
        ((K * (2 : Real) ^ ((j : Real) * s)) ^ (2 : Real) *
          ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ 0 xi‖ ^ 2) := by
      rw [hA]
      ring

/-- A strictly larger dyadic exponent eventually dominates a smaller one,
even after multiplication by arbitrary fixed nonnegative constants. -/
theorem eventually_mul_two_rpow_lt_of_lt
    {a b alpha beta : Real} (_ha : 0 ≤ a) (hb : 0 < b)
    (hab : alpha < beta) :
    ∀ᶠ j : Nat in atTop,
      a * (2 : Real) ^ ((j : Real) * alpha) <
        b * (2 : Real) ^ ((j : Real) * beta) := by
  let r : Real := (2 : Real) ^ (beta - alpha)
  have hr : 1 < r := by
    dsimp only [r]
    calc
      1 = (2 : Real) ^ (0 : Real) := (Real.rpow_zero _).symm
      _ < (2 : Real) ^ (beta - alpha) :=
        Real.rpow_lt_rpow_of_exponent_lt (by norm_num) (sub_pos.mpr hab)
  have hlarge : ∀ᶠ j : Nat in atTop, a / b < r ^ j :=
    (tendsto_pow_atTop_atTop_of_one_lt hr).eventually
      (Filter.eventually_gt_atTop (a / b))
  filter_upwards [hlarge] with j hj
  have hcoef : a < b * r ^ j := by
    have h := (div_lt_iff₀ hb).mp hj
    simpa only [mul_comm] using h
  have hfactor : 0 < (2 : Real) ^ ((j : Real) * alpha) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hmul := mul_lt_mul_of_pos_right hcoef hfactor
  have hrpow : r ^ j * (2 : Real) ^ ((j : Real) * alpha) =
      (2 : Real) ^ ((j : Real) * beta) := by
    rw [← Real.rpow_natCast r j]
    dsimp only [r]
    rw [← Real.rpow_mul (by norm_num : (0 : Real) ≤ 2),
      ← Real.rpow_add (by norm_num : (0 : Real) < 2)]
    congr 1
    ring
  calc
    a * (2 : Real) ^ ((j : Real) * alpha) <
        (b * r ^ j) * (2 : Real) ^ ((j : Real) * alpha) := hmul
    _ = b * (2 : Real) ^ ((j : Real) * beta) := by
      rw [mul_assoc, hrpow]

/-- An eventual dyadic power inequality cannot have a strictly larger
exponent on its left.  This packages the elementary asymptotic comparison
used when a packet lower bound and a uniform estimate have both been reduced
to fixed multiples of dyadic real powers. -/
theorem le_of_forall_ge_mul_two_rpow_le
    {A B alpha beta : Real} {J : Nat} (hA : 0 < A) (hB : 0 ≤ B)
    (hbound : ∀ j : Nat, J ≤ j →
      A * (2 : Real) ^ ((j : Real) * alpha) ≤
        B * (2 : Real) ^ ((j : Real) * beta)) :
    alpha ≤ beta := by
  by_contra hnot
  have hbetaalpha : beta < alpha := lt_of_not_ge hnot
  have hstrict : ∀ᶠ j : Nat in atTop,
      B * (2 : Real) ^ ((j : Real) * beta) <
        A * (2 : Real) ^ ((j : Real) * alpha) :=
    eventually_mul_two_rpow_lt_of_lt hB hA hbetaalpha
  obtain ⟨j, hjstrict, hjlarge⟩ :=
    (hstrict.and (Filter.eventually_ge_atTop J)).exists
  exact (not_lt_of_ge (hbound j hjlarge)) hjstrict

/-- The cardinal upper bound extracted from the positive packet has the
standard single-exponent form required for the entropy comparison. -/
theorem packet_card_upper_eq_const_mul_two_rpow
    {d : Nat} {Φ : BRRSAnnularCutoff} {K s : Real} (hK : 0 < K) (j : Nat) :
    ((K * (2 : Real) ^ ((j : Real) * s)) ^ (2 : Real) *
      ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ 0 xi‖ ^ 2) /
        (∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ 0 xi‖ ^ 4) =
      ((K ^ (2 : Real) *
        ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ 0 xi‖ ^ 2) /
          (∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ 0 xi‖ ^ 4)) *
        (2 : Real) ^ ((j : Real) * (2 * s)) := by
  rw [Real.mul_rpow hK.le (Real.rpow_nonneg (by norm_num) _),
    ← Real.rpow_mul (by norm_num : (0 : Real) ≤ 2)]
  ring

/-- Taking `ENNReal.toReal` of the entropy lower bound is harmless at a
positive finite scale. -/
theorem toReal_inv_rpow_nnreal {delta : NNReal} (_hdelta : 0 < delta)
    (q : Real) :
    (((delta : ENNReal)⁻¹) ^ q).toReal = ((delta : Real)⁻¹) ^ q := by
  rw [← ENNReal.toReal_rpow, ENNReal.toReal_inv, ENNReal.coe_toReal]

/-- A finite entropy witness has the corresponding ordinary-real cardinal
lower bound. -/
theorem inv_rpow_lt_card_toReal_of_lt
    {delta : NNReal} (hdelta : 0 < delta) {q : Real} {U : Finset Real}
    (hcard : ((delta : ENNReal)⁻¹) ^ q < (U.card : ENNReal)) :
    ((delta : Real)⁻¹) ^ q < (U.card : Real) := by
  have hbase_zero : (delta : ENNReal)⁻¹ ≠ 0 :=
    ENNReal.inv_ne_zero.mpr ENNReal.coe_ne_top
  have hbase_top : (delta : ENNReal)⁻¹ ≠ ⊤ :=
    ENNReal.inv_ne_top.mpr
      (ENNReal.coe_ne_zero.mpr (by exact_mod_cast hdelta.ne'))
  have hpow_top : ((delta : ENNReal)⁻¹) ^ q ≠ ⊤ :=
    ENNReal.rpow_ne_top_of_ne_zero hbase_zero hbase_top
  have hreal := (ENNReal.toReal_lt_toReal hpow_top (by simp)).mpr hcard
  simpa only [toReal_inv_rpow_nnreal hdelta q, ENNReal.toReal_natCast] using hreal

/-- The inverse of four dyadic mesh lengths has the expected dyadic
frequency size after taking any real power. -/
theorem inv_four_mul_dyadicTimeScale_rpow (j : Nat) (q : Real) :
    (4 * dyadicTimeScale j)⁻¹ ^ q =
      (4 : Real) ^ (-q) * (2 : Real) ^ ((j : Real) * q) := by
  have hbase : (4 * dyadicTimeScale j)⁻¹ =
      (4 : Real)⁻¹ * (2 : Real) ^ j := by
    unfold dyadicTimeScale
    field_simp [pow_ne_zero j (by norm_num : (2 : Real) ≠ 0)]
  rw [hbase, Real.mul_rpow (inv_nonneg.mpr (by norm_num))
    (pow_nonneg (by norm_num) _)]
  rw [Real.inv_rpow (by norm_num : (0 : Real) ≤ 4),
    ← Real.rpow_neg (by norm_num : (0 : Real) ≤ 4),
    ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0 : Real) ≤ 2)]

/-- Dyadic rounding converts a small-scale entropy lower bound into the
corresponding lower power of the dyadic level. -/
theorem four_rpow_neg_mul_two_rpow_le_inv_rpow_of_le
    {delta : NNReal} {j : Nat} {q : Real}
    (hdelta : 0 < (delta : Real))
    (hdelta_le : (delta : Real) ≤ 4 * dyadicTimeScale j)
    (hq : 0 ≤ q) :
    (4 : Real) ^ (-q) * (2 : Real) ^ ((j : Real) * q) ≤
      ((delta : Real)⁻¹) ^ q := by
  have hmesh_pos : 0 < 4 * dyadicTimeScale j := by
    unfold dyadicTimeScale
    positivity
  have hinv : (4 * dyadicTimeScale j)⁻¹ ≤ (delta : Real)⁻¹ := by
    simpa only [one_div] using one_div_le_one_div_of_le hdelta hdelta_le
  have hpow := Real.rpow_le_rpow (inv_nonneg.mpr hmesh_pos.le) hinv hq
  rw [inv_four_mul_dyadicTimeScale_rpow] at hpow
  exact hpow

/-- Every maximal dyadic discretization of a nonempty time set is itself
nonempty. -/
theorem one_le_card_of_isDyadicDiscretization
    {E : Set Real} {j : Nat} {T : Finset Real}
    (hE : E.Nonempty) (hT : IsDyadicDiscretization E j T) :
    1 ≤ (T.card : Real) := by
  rcases hE with ⟨x, hx⟩
  obtain ⟨t, ht, _⟩ := hT.exists_mem_abs_sub_lt hx
  have hTnonempty : T.Nonempty := ⟨t, ht⟩
  exact_mod_cast Nat.succ_le_iff.mpr hTnonempty.card_pos

/-- At `p = 2`, every exponent below the zero-penalty entropy threshold
fails for the canonical BRRS half-wave realization.  The proof is the
Hilbert-space sharpness argument: positive adjoint packets make every time
slice carry the same fourth multiplier moment, and the local entropy packets
then contradict the resulting dyadic cardinality bound. -/
theorem not_uniformEstimateAtExponent_p_two_of_lt
    {d : Nat} (Φ : BRRSAnnularCutoff) (E : Set Real)
    (hd : 2 ≤ d) (hE : E ⊆ Icc (1 : Real) 2)
    (hEnonempty : E.Nonempty) {s : Real}
    (hs : s < criticalExponent brrsLegendreAssouadFunction E d 2) :
    ¬ UniformEstimateAtExponent Φ (brrsLpHalfWaveExtension (d := d) Φ) E 2 s := by
  have hdpos : 0 < d := by omega
  have hs' : s < brrsLegendreAssouadFunction E 0 / 2 := by
    rw [criticalExponent_p_two] at hs
    exact hs
  intro hUniform
  obtain ⟨K, hK, hcard⟩ :=
    exists_packet_card_upper_of_uniformEstimateAtExponent_pTwo hdpos
      (brrsLpHalfWaveExtension (d := d) Φ) hUniform
  let A : Real := ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ 0 xi‖ ^ 2
  let B : Real := ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Φ 0 xi‖ ^ 4
  let C : Real := (K ^ (2 : Real) * A) / B
  have hA : 0 ≤ A := by
    dsimp only [A]
    exact integral_nonneg fun _ => sq_nonneg _
  have hB : 0 < B := by
    dsimp only [B]
    exact integral_norm_four_brrsDyadicMultiplier_levelZero_pos hdpos Φ
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact div_nonneg (mul_nonneg (Real.rpow_nonneg hK.le _) hA) hB.le
  have hcard' : ∀ j : Nat, 1 ≤ j → ∀ T : Finset Real,
      IsDyadicDiscretization E j T →
        (T.card : Real) ≤ C * (2 : Real) ^ ((j : Real) * (2 * s)) := by
    intro j hj T hT
    have h := hcard j hj T hT
    rw [packet_card_upper_eq_const_mul_two_rpow hK j] at h
    simpa only [C, A, B] using h
  by_cases hsnonneg : 0 ≤ s
  · let q : Real := (2 * s + brrsLegendreAssouadFunction E 0) / 2
    have htwosq : 2 * s < q := by
      dsimp only [q]
      linarith
    have hqnu : q < brrsLegendreAssouadFunction E 0 := by
      dsimp only [q]
      linarith
    have hqnonneg : 0 ≤ q := by
      dsimp only [q]
      linarith
    let b : Real := (4 : Real) ^ (-q)
    have hb : 0 < b := by
      dsimp only [b]
      exact Real.rpow_pos_of_pos (by norm_num) _
    have hdom : ∀ᶠ j : Nat in atTop,
        C * (2 : Real) ^ ((j : Real) * (2 * s)) <
          b * (2 : Real) ^ ((j : Real) * q) :=
      eventually_mul_two_rpow_lt_of_lt hC hb htwosq
    obtain ⟨N, hN⟩ := Filter.eventually_atTop.mp hdom
    let eps : NNReal := ⟨2 * dyadicTimeScale N,
      (mul_pos (by norm_num) (by
        unfold dyadicTimeScale
        positivity)).le⟩
    have heps : 0 < eps := by
      change 0 < (2 * dyadicTimeScale N : Real)
      exact mul_pos (by norm_num) (by
        unfold dyadicTimeScale
        positivity)
    have hsmall : ∀ᶠ delta : NNReal in nhdsWithin (0 : NNReal) (Ioi 0),
        delta ∈ Ioo 0 eps :=
      nhdsGT_basis 0 |>.mem_of_mem heps
    have hfreq := frequently_exists_local_isSeparated_finset_card_lower_of_lt
      hEnonempty hE hqnu
    obtain ⟨delta, hdelta, hdeltaeps⟩ := (hfreq.and_eventually hsmall).exists
    rcases hdelta with ⟨hdeltasmall, a, R, U, hUsub, hUsep, hUcard⟩
    obtain ⟨j, hj, hjmesh, hdeltaj⟩ :=
      exists_dyadicTimeScale_lt_half_and_delta_le_four_mul hdeltasmall
    have hdeltaeps_real : (delta : Real) < 2 * dyadicTimeScale N := by
      have hdeltaeps' : delta < eps := hdeltaeps.2
      change (delta : Real) < 2 * dyadicTimeScale N at hdeltaeps'
      exact hdeltaeps'
    have hscalejN : dyadicTimeScale j < dyadicTimeScale N := by
      calc
        dyadicTimeScale j < (delta : Real) / 2 := hjmesh
        _ < dyadicTimeScale N := by linarith
    have hNj : N ≤ j := Nat.le_of_lt (lt_of_dyadicTimeScale_lt hscalejN)
    have hUsep_j : IsSeparated U (dyadicTimeScale j) := by
      intro u hu v hv huv
      exact hjmesh.le.trans (hUsep hu hv huv)
    have hUE : (↑U : Set Real) ⊆ E := hUsub.trans inter_subset_left
    obtain ⟨T, hT, hUT⟩ :=
      exists_isDyadicDiscretization_card_ge_of_isSeparated hE j hUE hUsep_j
    have hUreal : ((delta : Real)⁻¹) ^ q < (U.card : Real) :=
      inv_rpow_lt_card_toReal_of_lt hdeltasmall.1 hUcard
    have hscaleLower : b * (2 : Real) ^ ((j : Real) * q) ≤
        ((delta : Real)⁻¹) ^ q := by
      dsimp only [b]
      exact four_rpow_neg_mul_two_rpow_le_inv_rpow_of_le hdeltasmall.1 hdeltaj hqnonneg
    have hUTreal : (U.card : Real) ≤ (T.card : Real) := by exact_mod_cast hUT
    have hTlower : b * (2 : Real) ^ ((j : Real) * q) < (T.card : Real) :=
      hscaleLower.trans_lt (hUreal.trans_le hUTreal)
    have hTupper := hcard' j hj T hT
    have hdomj := hN j hNj
    exact (lt_irrefl (T.card : Real))
      (hTupper.trans_lt (hdomj.trans hTlower))
  · have hsneg : s < 0 := lt_of_not_ge hsnonneg
    have htail : ∀ᶠ j : Nat in atTop,
        C * (2 : Real) ^ ((j : Real) * (2 * s)) < 1 := by
      have h := eventually_mul_two_rpow_lt_of_lt hC (by norm_num : (0 : Real) < 1)
        (by linarith : 2 * s < 0)
      simpa only [mul_one, one_mul, mul_zero, Real.rpow_zero] using h
    obtain ⟨j, hjtail, hj⟩ :=
      (htail.and (Filter.eventually_ge_atTop 1)).exists
    obtain ⟨T, hT⟩ := exists_isDyadicDiscretization hE j
    have hTupper := hcard' j hj T hT
    have hTone : 1 ≤ (T.card : Real) :=
      one_le_card_of_isDyadicDiscretization hEnonempty hT
    exact (lt_irrefl (1 : Real)) (hTone.trans_lt (hTupper.trans_lt hjtail))

/-- The sharpness clause of BRRS Theorem 1.1 at the fully formalized
Hilbert-space endpoint. -/
theorem brrsTheoremOneSharpnessStatement_p_two
    {d : Nat} (Φ : BRRSAnnularCutoff) (E : Set Real)
    (hd : 2 ≤ d) (hE : E ⊆ Icc (1 : Real) 2) :
    BRRSTheoremOneSharpnessStatement (brrsLpHalfWaveExtension (d := d) Φ) E 2 := by
  unfold BRRSTheoremOneSharpnessStatement BRRSTheoremOneSharpnessStatementFor
  intro hEnonempty s hs
  exact not_uniformEstimateAtExponent_p_two_of_lt Φ E hd hE hEnonempty hs

/-- The complete BRRS Theorem 1.1 package at the Hilbert endpoint.  Both the
upper estimate and the sharpness clause use the same canonical convolution
realization of the literal annular half-wave. -/
theorem brrsTheoremOneWithSharpnessStatement_p_two
    (d : Nat) (Φ : BRRSAnnularCutoff) (E : Set Real)
    (hd : 2 ≤ d) (hE : E ⊆ Icc (1 : Real) 2) :
    BRRSTheoremOneWithSharpnessStatement d Φ E 2 := by
  unfold BRRSTheoremOneWithSharpnessStatement
    BRRSTheoremOneWithSharpnessStatementFor
  refine ⟨hd, hE, by norm_num, brrsLpHalfWaveExtension Φ, ?_, ?_⟩
  · exact brrsCanonicalUniformEstimateAtExponent_p_two d Φ E hd hE
  · exact brrsTheoremOneSharpnessStatement_p_two Φ E hd hE

end


