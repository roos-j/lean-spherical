    intro x hx y hy hxy
    rw [edist_dist, hrho]
    rw [ENNReal.ofReal_lt_ofReal_iff_of_nonneg (by positivity)]
    rw [Real.dist_eq]
    exact lt_of_lt_of_le (by linarith) (hCdata.2.2 hx hy hxy)
