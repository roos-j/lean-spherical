    {C | (↑U : Set Real) ⊆ C ∧ C ⊆ E ∧ IsSeparatedSet C delta}
  have hUinP : (↑U : Set Real) ∈ P := by
    exact ⟨Subset.rfl, hUsub, hUsep⟩
  have hchain : ∀ c ⊆ P, IsChain (· ⊆ ·) c → c.Nonempty →
