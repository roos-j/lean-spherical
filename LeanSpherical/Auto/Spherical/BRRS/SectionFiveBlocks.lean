      ENNReal.ofReal
        (((4 : Real) ^ (d - 1) * ((1 - (1 / 32 : Real)) * C)) *
          ((Real.sqrt t) ^ (d - 1) * (2 : Real) ^ (d + 2))) *
        ∫⁻ u : Real, brrsCubicJapaneseProfile u := by
  let A : ENNReal := ENNReal.ofReal
    (((4 : Real) ^ (d - 1) * ((1 - (1 / 32 : Real)) * C)) *
      ((Real.sqrt t) ^ (d - 1) * (2 : Real) ^ (d + 2)))
  have hpoint (r : Real) (hr : r ∈ Ici (16 : Real)) :
      ENNReal.ofReal r ^ (d - 1) *
          ENNReal.ofReal
            ((1 - (1 / 32 : Real)) *
              (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
                brrsStationaryRapidProfile (d + 2) (2 * Real.pi * (t + r))) ≤
        A * brrsCubicJapaneseProfile (t + r) := by
    apply brrs_front_polar_density_le_cubicJapanese hd C t r (t + r) hC ht hr
    have ht0 : 0 ≤ t := le_trans zero_le_one ht
    have hr0 : 0 ≤ r := le_trans (by norm_num : (0 : Real) ≤ 16) hr
    rw [abs_of_nonneg (add_nonneg ht0 hr0)]
    linarith
  calc
    (∫⁻ r in Ici (16 : Real),
      ENNReal.ofReal r ^ (d - 1) *
        ENNReal.ofReal
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
              brrsStationaryRapidProfile (d + 2) (2 * Real.pi * (t + r)))) ≤
        ∫⁻ r in Ici (16 : Real), A * brrsCubicJapaneseProfile (t + r) := by
      apply setLIntegral_mono' measurableSet_Ici
      intro r hr
      exact hpoint r hr
    _ ≤ ∫⁻ r in Ioi (0 : Real), A * brrsCubicJapaneseProfile (t + r) := by
      simpa only using
        (lintegral_mono_set (μ := volume)
          (f := fun r : Real => A * brrsCubicJapaneseProfile (t + r))
          (show Ici (16 : Real) ⊆ Ioi (0 : Real) by
            intro r hr
            exact lt_of_lt_of_le (by norm_num : (0 : Real) < 16) hr))
    _ ≤ A * ∫⁻ u : Real, brrsCubicJapaneseProfile u :=
      lintegral_brrsCubicJapaneseProfile_add_le A t
    _ = ENNReal.ofReal
        (((4 : Real) ^ (d - 1) * ((1 - (1 / 32 : Real)) * C)) *
          ((Real.sqrt t) ^ (d - 1) * (2 : Real) ^ (d + 2))) *
        ∫⁻ u : Real, brrsCubicJapaneseProfile u := by rfl

/-- Choosing middle decay order `2d+5` leaves a cubic integrable radial
tail after polar weighting. -/
private theorem brrs_middle_polar_density_le_cubicJapanese
    {d : Nat} (hd : 1 ≤ d) (C r : Real) (hC : 0 ≤ C) (hr : 16 ≤ r) :
    ENNReal.ofReal r ^ (d - 1) *
        ENNReal.ofReal
          (C / (Real.sqrt (r / 16)) ^ ((2 * d + 5) - 1)) ≤
      ENNReal.ofReal ((8 : Real) * C * (16 : Real) ^ (d + 2)) *
        brrsCubicJapaneseProfile r := by
  have hr0 : 0 ≤ r := by linarith
  have hrpos : 0 < r := by linarith
  have hrone : 1 ≤ r := by linarith
  have hden : (Real.sqrt (r / 16)) ^ ((2 * d + 5) - 1) =
      (r / 16) ^ (d + 2) := by
    have hindex : (2 * d + 5) - 1 = 2 * (d + 2) := by omega
    rw [hindex, pow_mul, Real.sq_sqrt (by positivity : 0 ≤ r / 16)]
  have hfactor : r ^ (d - 1) * (C / (r / 16) ^ (d + 2)) =
      C * (16 : Real) ^ (d + 2) / r ^ 3 := by
    have hindex : d + 2 = (d - 1) + 3 := by omega
    rw [div_pow, hindex, pow_add]
    field_simp
  have hbase : 1 / r ≤ 2 / (1 + r) := by
    apply (div_le_div_iff₀ hrpos (by positivity : 0 < 1 + r)).mpr
    nlinarith
  have hpow : (1 / r) ^ 3 ≤ (2 / (1 + r)) ^ 3 := by
    apply pow_le_pow_left₀
    · positivity
    · exact hbase
  let A : Real := C * (16 : Real) ^ (d + 2)
  have hA : 0 ≤ A := by
    dsimp only [A]
    positivity
  have htail : A / r ^ 3 ≤ (8 : Real) * A * ((1 + r)⁻¹) ^ 3 := by
    calc
      A / r ^ 3 = A * (1 / r) ^ 3 := by
        simp only [one_div]
        rw [div_eq_mul_inv, ← inv_pow]
      _ ≤ A * (2 / (1 + r)) ^ 3 :=
        mul_le_mul_of_nonneg_left hpow hA
      _ = (8 : Real) * A * ((1 + r)⁻¹) ^ 3 := by
        rw [div_pow]
        have hne : 1 + r ≠ 0 := ne_of_gt (by positivity)
        field_simp [hne]
        ring
  have hreal : r ^ (d - 1) *
      (C / (Real.sqrt (r / 16)) ^ ((2 * d + 5) - 1)) ≤
      (8 : Real) * C * (16 : Real) ^ (d + 2) * ((1 + r)⁻¹) ^ 3 := by
    rw [hden]
    calc
      r ^ (d - 1) * (C / (r / 16) ^ (d + 2)) =
          C * (16 : Real) ^ (d + 2) / r ^ 3 := hfactor
      _ = A / r ^ 3 := by rfl
      _ ≤ (8 : Real) * A * ((1 + r)⁻¹) ^ 3 := htail
      _ = (8 : Real) * C * (16 : Real) ^ (d + 2) * ((1 + r)⁻¹) ^ 3 := by
        dsimp only [A]
        ring
  rw [← ENNReal.ofReal_pow hr0, ← ENNReal.ofReal_mul (pow_nonneg hr0 _),
    brrsCubicJapaneseProfile,
    ← ENNReal.ofReal_mul (by positivity : 0 ≤
      (8 : Real) * C * (16 : Real) ^ (d + 2))]
  rw [abs_of_nonneg hr0]
  exact ENNReal.ofReal_le_ofReal hreal

/-- The rapidly decaying middle stationary remainder has a finite, uniform
high-radius polar mass. -/
private theorem lintegral_brrs_middlePolarDensity_le_cubicJapanese
    {d : Nat} (hd : 3 ≤ d) (C : Real) (hC : 0 ≤ C) :
    (∫⁻ r in Ici (16 : Real),
      ENNReal.ofReal r ^ (d - 1) *
        ENNReal.ofReal
          (C / (Real.sqrt (r / 16)) ^ ((2 * d + 5) - 1))) ≤
      ENNReal.ofReal ((8 : Real) * C * (16 : Real) ^ (d + 2)) *
        ∫⁻ u : Real, brrsCubicJapaneseProfile u := by
  let B : ENNReal := ENNReal.ofReal ((8 : Real) * C * (16 : Real) ^ (d + 2))
  have hpoint (r : Real) (hr : r ∈ Ici (16 : Real)) :
      ENNReal.ofReal r ^ (d - 1) *
          ENNReal.ofReal
            (C / (Real.sqrt (r / 16)) ^ ((2 * d + 5) - 1)) ≤
        B * brrsCubicJapaneseProfile r := by
    exact brrs_middle_polar_density_le_cubicJapanese
      (le_trans (by norm_num) hd) C r hC hr
  calc
    (∫⁻ r in Ici (16 : Real),
      ENNReal.ofReal r ^ (d - 1) *
        ENNReal.ofReal
          (C / (Real.sqrt (r / 16)) ^ ((2 * d + 5) - 1))) ≤
        ∫⁻ r in Ici (16 : Real), B * brrsCubicJapaneseProfile r := by
      apply setLIntegral_mono' measurableSet_Ici
      intro r hr
      exact hpoint r hr
    _ ≤ ∫⁻ r in Ioi (0 : Real), B * brrsCubicJapaneseProfile (0 + r) := by
      simpa only [zero_add] using
        (lintegral_mono_set (μ := volume)
          (f := fun r : Real => B * brrsCubicJapaneseProfile r)
          (show Ici (16 : Real) ⊆ Ioi (0 : Real) by
            intro r hr
            exact lt_of_lt_of_le (by norm_num : (0 : Real) < 16) hr))
    _ ≤ B * ∫⁻ u : Real, brrsCubicJapaneseProfile u :=
      lintegral_brrsCubicJapaneseProfile_add_le B 0
    _ = ENNReal.ofReal ((8 : Real) * C * (16 : Real) ^ (d + 2)) *
        ∫⁻ u : Real, brrsCubicJapaneseProfile u := by rfl

/-- The compact radial region is also dominated by the cubic Japanese
profile, with a time-independent constant. -/
private theorem brrs_compact_polar_density_le_cubicJapanese
    {d : Nat} (A r : Real) (hA : 0 ≤ A) (hr0 : 0 ≤ r) (hr : r ≤ 16) :
    ENNReal.ofReal r ^ (d - 1) * ENNReal.ofReal A ≤
      ENNReal.ofReal (A * (16 : Real) ^ (d - 1) * (17 : Real) ^ 3) *
        brrsCubicJapaneseProfile r := by
  have hpow : r ^ (d - 1) ≤ (16 : Real) ^ (d - 1) :=
    pow_le_pow_left₀ hr0 hr _
  have hinv : (17 : Real)⁻¹ ≤ (1 + r)⁻¹ := by
    apply (inv_le_inv₀ (by norm_num : (0 : Real) < 17)
      (by positivity : 0 < 1 + r)).mpr
    linarith
  have hpowinv : ((17 : Real)⁻¹) ^ 3 ≤ ((1 + r)⁻¹) ^ 3 := by
    apply pow_le_pow_left₀
    · positivity
    · exact hinv
  have hone : (1 : Real) ≤ (17 : Real) ^ 3 * ((1 + r)⁻¹) ^ 3 := by
    calc
      (1 : Real) = (17 : Real) ^ 3 * ((17 : Real)⁻¹) ^ 3 := by
        rw [← mul_pow, mul_inv_cancel₀ (by norm_num : (17 : Real) ≠ 0), one_pow]
      _ ≤ (17 : Real) ^ 3 * ((1 + r)⁻¹) ^ 3 := by
        exact mul_le_mul_of_nonneg_left hpowinv (by positivity)
  have hreal : r ^ (d - 1) * A ≤
      A * (16 : Real) ^ (d - 1) * (17 : Real) ^ 3 * ((1 + r)⁻¹) ^ 3 := by
    calc
      r ^ (d - 1) * A ≤ (16 : Real) ^ (d - 1) * A :=
        mul_le_mul_of_nonneg_right hpow hA
      _ = (A * (16 : Real) ^ (d - 1)) * 1 := by ring
      _ ≤ (A * (16 : Real) ^ (d - 1)) *
          ((17 : Real) ^ 3 * ((1 + r)⁻¹) ^ 3) :=
        mul_le_mul_of_nonneg_left hone (by positivity)
      _ = A * (16 : Real) ^ (d - 1) * (17 : Real) ^ 3 *
          ((1 + r)⁻¹) ^ 3 := by ring
  rw [← ENNReal.ofReal_pow hr0, ← ENNReal.ofReal_mul (pow_nonneg hr0 _),
    brrsCubicJapaneseProfile,
    ← ENNReal.ofReal_mul (by positivity : 0 ≤
      A * (16 : Real) ^ (d - 1) * (17 : Real) ^ 3)]
  rw [abs_of_nonneg hr0]
  exact ENNReal.ofReal_le_ofReal hreal

/-- Coefficient of the outgoing or incoming cubic profile after polar
weighting. -/
noncomputable def brrsFrontCubicCoefficient (d : Nat) (C t : Real) : ENNReal :=
  ENNReal.ofReal
    (((4 : Real) ^ (d - 1) * ((1 - (1 / 32 : Real)) * C)) *
      ((Real.sqrt t) ^ (d - 1) * (2 : Real) ^ (d + 2)))

/-- Coefficient of the integrable middle stationary remainder. -/
noncomputable def brrsMiddleCubicCoefficient (d : Nat) (C : Real) : ENNReal :=
  ENNReal.ofReal ((8 : Real) * C * (16 : Real) ^ (d + 2))

/-- Coefficient controlling the compact radial region. -/
noncomputable def brrsCompactCubicCoefficient (d : Nat) (A : Real) : ENNReal :=
  ENNReal.ofReal (A * (16 : Real) ^ (d - 1) * (17 : Real) ^ 3)

/-- The full refined radial kernel majorant is controlled, after the polar
Jacobian, by four integrable cubic profiles: compact, outgoing, incoming,
and middle. -/
theorem brrs_refinedGlobalRadialPolarDensity_le_cubicProfiles
    {d : Nat} (hd : 3 ≤ d) (A C t r : Real) (hA : 0 ≤ A) (hC : 0 ≤ C)
    (ht : 1 ≤ t) (hr : 0 < r) :
    ENNReal.ofReal r ^ (d - 1) *
        brrsLevelZeroKernelRefinedGlobalRadialMajorant d (d + 2) (2 * d + 5)
          A C t r ≤
      brrsCompactCubicCoefficient d A * brrsCubicJapaneseProfile r +
        (brrsFrontCubicCoefficient d C t * brrsCubicJapaneseProfile (t - r) +
          brrsFrontCubicCoefficient d C t * brrsCubicJapaneseProfile (t + r) +
            brrsMiddleCubicCoefficient d C * brrsCubicJapaneseProfile r) := by
  by_cases hsmall : r < 16
  · rw [brrsLevelZeroKernelRefinedGlobalRadialMajorant, if_pos hsmall]
    have hcompact := brrs_compact_polar_density_le_cubicJapanese
      (d := d) A r hA hr.le hsmall.le
    exact hcompact.trans (le_add_of_nonneg_right (by positivity))
  · have hlarge : 16 ≤ r := le_of_not_gt hsmall
    rw [brrsLevelZeroKernelRefinedGlobalRadialMajorant, if_neg hsmall]
    let Fout : Real := (1 - (1 / 32 : Real)) *
      (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
        brrsStationaryRapidProfile (d + 2) (2 * Real.pi * (t - r))
    let Fin : Real := (1 - (1 / 32 : Real)) *
      (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
        brrsStationaryRapidProfile (d + 2) (2 * Real.pi * (t + r))
    let Fmid : Real := C / (Real.sqrt (r / 16)) ^ ((2 * d + 5) - 1)
    have hadd : ENNReal.ofReal (Fout + Fin + Fmid) ≤
        ENNReal.ofReal Fout + ENNReal.ofReal Fin + ENNReal.ofReal Fmid := by
      calc
        ENNReal.ofReal (Fout + Fin + Fmid) ≤
            ENNReal.ofReal (Fout + Fin) + ENNReal.ofReal Fmid :=
          ENNReal.ofReal_add_le
        _ ≤ (ENNReal.ofReal Fout + ENNReal.ofReal Fin) + ENNReal.ofReal Fmid :=
          add_le_add (ENNReal.ofReal_add_le (p := Fout) (q := Fin)) le_rfl
    have hout : ENNReal.ofReal r ^ (d - 1) * ENNReal.ofReal Fout ≤
        brrsFrontCubicCoefficient d C t * brrsCubicJapaneseProfile (t - r) := by
      dsimp only [Fout, brrsFrontCubicCoefficient]
      apply brrs_front_polar_density_le_cubicJapanese hd C t r (t - r) hC ht hlarge
      have hdiff : r - t ≤ |r - t| := le_abs_self _
      rw [abs_sub_comm] at hdiff
      linarith
    have hin : ENNReal.ofReal r ^ (d - 1) * ENNReal.ofReal Fin ≤
        brrsFrontCubicCoefficient d C t * brrsCubicJapaneseProfile (t + r) := by
      dsimp only [Fin, brrsFrontCubicCoefficient]
      apply brrs_front_polar_density_le_cubicJapanese hd C t r (t + r) hC ht hlarge
      have ht0 : 0 ≤ t := by linarith
      rw [abs_of_nonneg (by linarith : 0 ≤ t + r)]
      linarith
    have hmid : ENNReal.ofReal r ^ (d - 1) * ENNReal.ofReal Fmid ≤
        brrsMiddleCubicCoefficient d C * brrsCubicJapaneseProfile r := by
      dsimp only [Fmid, brrsMiddleCubicCoefficient]
      exact brrs_middle_polar_density_le_cubicJapanese
        (le_trans (by norm_num) hd) C r hC hlarge
    calc
      ENNReal.ofReal r ^ (d - 1) * ENNReal.ofReal
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
              (brrsStationaryRapidProfile (d + 2) (2 * Real.pi * (t - r)) +
                brrsStationaryRapidProfile (d + 2) (2 * Real.pi * (t + r))) +
            C / (Real.sqrt (r / 16)) ^ ((2 * d + 5) - 1)) =
          ENNReal.ofReal r ^ (d - 1) * ENNReal.ofReal (Fout + Fin + Fmid) := by
        congr 2
        dsimp only [Fout, Fin, Fmid]
        ring
      _ ≤ ENNReal.ofReal r ^ (d - 1) *
          (ENNReal.ofReal Fout + ENNReal.ofReal Fin + ENNReal.ofReal Fmid) :=
        mul_le_mul_of_nonneg_left hadd (by positivity)
      _ = (ENNReal.ofReal r ^ (d - 1) * ENNReal.ofReal Fout) +
          (ENNReal.ofReal r ^ (d - 1) * ENNReal.ofReal Fin) +
            ENNReal.ofReal r ^ (d - 1) * ENNReal.ofReal Fmid := by ring
      _ ≤ brrsFrontCubicCoefficient d C t * brrsCubicJapaneseProfile (t - r) +
          (brrsFrontCubicCoefficient d C t * brrsCubicJapaneseProfile (t + r) +
            brrsMiddleCubicCoefficient d C * brrsCubicJapaneseProfile r) := by
        calc
          (ENNReal.ofReal r ^ (d - 1) * ENNReal.ofReal Fout) +
              (ENNReal.ofReal r ^ (d - 1) * ENNReal.ofReal Fin) +
                ENNReal.ofReal r ^ (d - 1) * ENNReal.ofReal Fmid =
            ((ENNReal.ofReal r ^ (d - 1) * ENNReal.ofReal Fout) +
              (ENNReal.ofReal r ^ (d - 1) * ENNReal.ofReal Fin)) +
                ENNReal.ofReal r ^ (d - 1) * ENNReal.ofReal Fmid := by rfl
          _ ≤ (brrsFrontCubicCoefficient d C t * brrsCubicJapaneseProfile (t - r) +
              brrsFrontCubicCoefficient d C t * brrsCubicJapaneseProfile (t + r)) +
                brrsMiddleCubicCoefficient d C * brrsCubicJapaneseProfile r :=
            add_le_add (add_le_add hout hin) hmid
          _ = brrsFrontCubicCoefficient d C t * brrsCubicJapaneseProfile (t - r) +
              (brrsFrontCubicCoefficient d C t * brrsCubicJapaneseProfile (t + r) +
                brrsMiddleCubicCoefficient d C * brrsCubicJapaneseProfile r) := by ring
      _ ≤ brrsCompactCubicCoefficient d A * brrsCubicJapaneseProfile r +
          (brrsFrontCubicCoefficient d C t * brrsCubicJapaneseProfile (t - r) +
            brrsFrontCubicCoefficient d C t * brrsCubicJapaneseProfile (t + r) +
              brrsMiddleCubicCoefficient d C * brrsCubicJapaneseProfile r) := by
        calc
          brrsFrontCubicCoefficient d C t * brrsCubicJapaneseProfile (t - r) +
              (brrsFrontCubicCoefficient d C t * brrsCubicJapaneseProfile (t + r) +
                brrsMiddleCubicCoefficient d C * brrsCubicJapaneseProfile r) =
            0 + (brrsFrontCubicCoefficient d C t * brrsCubicJapaneseProfile (t - r) +
              (brrsFrontCubicCoefficient d C t * brrsCubicJapaneseProfile (t + r) +
                brrsMiddleCubicCoefficient d C * brrsCubicJapaneseProfile r)) := by simp
          _ ≤ brrsCompactCubicCoefficient d A * brrsCubicJapaneseProfile r +
              (brrsFrontCubicCoefficient d C t * brrsCubicJapaneseProfile (t - r) +
                (brrsFrontCubicCoefficient d C t * brrsCubicJapaneseProfile (t + r) +
                  brrsMiddleCubicCoefficient d C * brrsCubicJapaneseProfile r)) :=
            add_le_add (by positivity) le_rfl
          _ = brrsCompactCubicCoefficient d A * brrsCubicJapaneseProfile r +
              (brrsFrontCubicCoefficient d C t * brrsCubicJapaneseProfile (t - r) +
                brrsFrontCubicCoefficient d C t * brrsCubicJapaneseProfile (t + r) +
                  brrsMiddleCubicCoefficient d C * brrsCubicJapaneseProfile r) := by ring

/-- Scalar polar integration of the refined majorant reduces to one fixed
finite cubic-profile mass. -/
theorem lintegral_refinedGlobalRadialPolarMass_le_cubicProfileMass
    {d : Nat} (hd : 3 ≤ d) (A C t : Real) (hA : 0 ≤ A) (hC : 0 ≤ C)
    (ht : 1 ≤ t) :
    (∫⁻ r in Ioi (0 : Real), ENNReal.ofReal r ^ (d - 1) *
      brrsLevelZeroKernelRefinedGlobalRadialMajorant d (d + 2) (2 * d + 5)
        A C t r) ≤
      (brrsCompactCubicCoefficient d A + brrsFrontCubicCoefficient d C t +
        brrsFrontCubicCoefficient d C t + brrsMiddleCubicCoefficient d C) *
        ∫⁻ u : Real, brrsCubicJapaneseProfile u := by
  let KC : ENNReal := brrsCompactCubicCoefficient d A
  let KF : ENNReal := brrsFrontCubicCoefficient d C t
  let KM : ENNReal := brrsMiddleCubicCoefficient d C
  let L : ENNReal := ∫⁻ u : Real, brrsCubicJapaneseProfile u
  have hsub : Measurable (fun r : Real => brrsCubicJapaneseProfile (t - r)) := by
    exact measurable_brrsCubicJapaneseProfile.comp (measurable_const.sub measurable_id)
  have hadd : Measurable (fun r : Real => brrsCubicJapaneseProfile (t + r)) := by
    exact measurable_brrsCubicJapaneseProfile.comp (measurable_const.add measurable_id)
  have hcompactMeas : Measurable (fun r : Real => KC * brrsCubicJapaneseProfile r) :=
    measurable_const.mul measurable_brrsCubicJapaneseProfile
  have houtMeas : Measurable (fun r : Real => KF * brrsCubicJapaneseProfile (t - r)) :=
    measurable_const.mul hsub
  have hinMeas : Measurable (fun r : Real => KF * brrsCubicJapaneseProfile (t + r)) :=
    measurable_const.mul hadd
  have hmiddleMeas : Measurable (fun r : Real => KM * brrsCubicJapaneseProfile r) :=
    measurable_const.mul measurable_brrsCubicJapaneseProfile
  calc
    (∫⁻ r in Ioi (0 : Real), ENNReal.ofReal r ^ (d - 1) *
      brrsLevelZeroKernelRefinedGlobalRadialMajorant d (d + 2) (2 * d + 5)
        A C t r) ≤
        ∫⁻ r in Ioi (0 : Real),
          KC * brrsCubicJapaneseProfile r +
            (KF * brrsCubicJapaneseProfile (t - r) +
              KF * brrsCubicJapaneseProfile (t + r) +
                KM * brrsCubicJapaneseProfile r) := by
      apply setLIntegral_mono' measurableSet_Ioi
      intro r hr
      simpa only [KC, KF, KM] using
        brrs_refinedGlobalRadialPolarDensity_le_cubicProfiles
          hd A C t r hA hC ht hr
    _ = (∫⁻ r in Ioi (0 : Real), KC * brrsCubicJapaneseProfile r) +
          ∫⁻ r in Ioi (0 : Real),
            KF * brrsCubicJapaneseProfile (t - r) +
              KF * brrsCubicJapaneseProfile (t + r) +
                KM * brrsCubicJapaneseProfile r := by
      rw [lintegral_add_left hcompactMeas]
    _ = (∫⁻ r in Ioi (0 : Real), KC * brrsCubicJapaneseProfile r) +
          ((∫⁻ r in Ioi (0 : Real), KF * brrsCubicJapaneseProfile (t - r)) +
            ∫⁻ r in Ioi (0 : Real),
              KF * brrsCubicJapaneseProfile (t + r) +
                KM * brrsCubicJapaneseProfile r) := by
      have hassoc : (fun r : Real =>
          KF * brrsCubicJapaneseProfile (t - r) +
            KF * brrsCubicJapaneseProfile (t + r) +
              KM * brrsCubicJapaneseProfile r) =
          fun r : Real => KF * brrsCubicJapaneseProfile (t - r) +
            (KF * brrsCubicJapaneseProfile (t + r) +
              KM * brrsCubicJapaneseProfile r) := by
        funext r
        ring
      rw [hassoc, lintegral_add_left houtMeas]
    _ = (∫⁻ r in Ioi (0 : Real), KC * brrsCubicJapaneseProfile r) +
          ((∫⁻ r in Ioi (0 : Real), KF * brrsCubicJapaneseProfile (t - r)) +
            ((∫⁻ r in Ioi (0 : Real), KF * brrsCubicJapaneseProfile (t + r)) +
              ∫⁻ r in Ioi (0 : Real), KM * brrsCubicJapaneseProfile r)) := by
      rw [lintegral_add_left hinMeas]
    _ ≤ KC * L + (KF * L + (KF * L + KM * L)) := by
      apply add_le_add
      · simpa only [L, zero_add] using lintegral_brrsCubicJapaneseProfile_add_le KC 0
      · apply add_le_add
        · exact lintegral_brrsCubicJapaneseProfile_sub_le KF t
        · apply add_le_add
          · exact lintegral_brrsCubicJapaneseProfile_add_le KF t
          · simpa only [L, zero_add] using lintegral_brrsCubicJapaneseProfile_add_le KM 0
    _ = (KC + KF + KF + KM) * L := by ring
    _ = (brrsCompactCubicCoefficient d A + brrsFrontCubicCoefficient d C t +
        brrsFrontCubicCoefficient d C t + brrsMiddleCubicCoefficient d C) *
        ∫⁻ u : Real, brrsCubicJapaneseProfile u := by rfl

/-- The natural square-root half-density is exactly the real power occurring
in the desired wave-scale estimate. -/
theorem brrs_sqrtPow_eq_timeHalfExponent
    {d : Nat} (hd : 1 ≤ d) (t : Real) (ht : 0 ≤ t) :
    (Real.sqrt t) ^ (d - 1) = t ^ (((d : Real) - 1) / 2) := by
  rw [Real.rpow_div_two_eq_sqrt ((d : Real) - 1) ht,
    ← Real.rpow_natCast]
  norm_num [Nat.cast_sub hd]

/-- The time-independent coefficient in the cubic-profile polar mass bound. -/
def brrsCubicCoefficientTimeConstant (d : Nat) (A C : Real) : Real :=
  A * (16 : Real) ^ (d - 1) * (17 : Real) ^ 3 +
    ((4 : Real) ^ (d - 1) * ((1 - (1 / 32 : Real)) * C) *
      (2 : Real) ^ (d + 2)) +
    ((4 : Real) ^ (d - 1) * ((1 - (1 / 32 : Real)) * C) *
      (2 : Real) ^ (d + 2)) +
    (8 : Real) * C * (16 : Real) ^ (d + 2)

/-- The fixed phase-line mass left after the radial cubic-profile reduction. -/
noncomputable def brrsCubicProfileMass : ENNReal :=
  ∫⁻ u : Real, brrsCubicJapaneseProfile u

/-- The four cubic-profile coefficients are bounded by one constant times
the sharp half-wave time power. -/
private theorem brrs_cubicCoefficientSum_le_timeHalfExponent
    {d : Nat} (hd : 3 ≤ d) (A C t : Real) (hA : 0 ≤ A) (hC : 0 ≤ C)
    (ht : 2 ≤ t) :
    brrsCompactCubicCoefficient d A + brrsFrontCubicCoefficient d C t +
        brrsFrontCubicCoefficient d C t + brrsMiddleCubicCoefficient d C ≤
      ENNReal.ofReal
        (brrsCubicCoefficientTimeConstant d A C *
            t ^ (((d : Real) - 1) / 2)) := by
  let alpha : Real := ((d : Real) - 1) / 2
  let T : Real := t ^ alpha
  let aK : Real := A * (16 : Real) ^ (d - 1) * (17 : Real) ^ 3
  let aF : Real := (4 : Real) ^ (d - 1) * ((1 - (1 / 32 : Real)) * C) *
    (2 : Real) ^ (d + 2)
  let aM : Real := (8 : Real) * C * (16 : Real) ^ (d + 2)
  have hd1 : 1 ≤ d := le_trans (by norm_num) hd
  have ht0 : 0 ≤ t := le_trans (by norm_num) ht
  have halpha : 0 ≤ alpha := by
    dsimp only [alpha]
    have hd' : (1 : Real) ≤ d := by exact_mod_cast hd1
    linarith
  have hT0 : 0 ≤ T := Real.rpow_nonneg ht0 _
  have hT : 1 ≤ T := by
    dsimp only [T]
    exact Real.one_le_rpow (le_trans (by norm_num) ht) halpha
  have haK : 0 ≤ aK := by
    dsimp only [aK]
    positivity
  have haF : 0 ≤ aF := by
    dsimp only [aF]
    positivity
  have haM : 0 ≤ aM := by
    dsimp only [aM]
    positivity
  have hKC : brrsCompactCubicCoefficient d A ≤ ENNReal.ofReal (aK * T) := by
    unfold brrsCompactCubicCoefficient
    apply ENNReal.ofReal_le_ofReal
    change aK ≤ aK * T
    calc
      aK = aK * 1 := by ring
      _ ≤ aK * T := mul_le_mul_of_nonneg_left hT haK
  have hKF : brrsFrontCubicCoefficient d C t = ENNReal.ofReal (aF * T) := by
    unfold brrsFrontCubicCoefficient
    rw [brrs_sqrtPow_eq_timeHalfExponent hd1 t ht0]
    dsimp only [aF, T, alpha]
    congr 1
    ring
  have hKM : brrsMiddleCubicCoefficient d C ≤ ENNReal.ofReal (aM * T) := by
    unfold brrsMiddleCubicCoefficient
    apply ENNReal.ofReal_le_ofReal
    change aM ≤ aM * T
    calc
      aM = aM * 1 := by ring
      _ ≤ aM * T := mul_le_mul_of_nonneg_left hT haM
  calc
    brrsCompactCubicCoefficient d A + brrsFrontCubicCoefficient d C t +
        brrsFrontCubicCoefficient d C t + brrsMiddleCubicCoefficient d C ≤
        ENNReal.ofReal (aK * T) + ENNReal.ofReal (aF * T) +
          ENNReal.ofReal (aF * T) + ENNReal.ofReal (aM * T) := by
      exact add_le_add
        (add_le_add
          (add_le_add hKC (le_of_eq hKF))
          (le_of_eq hKF))
        hKM
    _ = ENNReal.ofReal ((aK + aF + aF + aM) * T) := by
      have hKT : 0 ≤ aK * T := mul_nonneg haK hT0
      have hFT : 0 ≤ aF * T := mul_nonneg haF hT0
      have hMT : 0 ≤ aM * T := mul_nonneg haM hT0
      rw [← ENNReal.ofReal_add hKT hFT,
        ← ENNReal.ofReal_add (add_nonneg hKT hFT) hFT,
        ← ENNReal.ofReal_add
          (add_nonneg (add_nonneg hKT hFT) hFT) hMT]
      congr 1
      ring
    _ = ENNReal.ofReal
        (brrsCubicCoefficientTimeConstant d A C *
            t ^ (((d : Real) - 1) / 2)) := by rfl

/-- After polar integration, the refined level-zero radial majorant has the
sharp half-wave time growth, up to a fixed finite cubic-profile mass. -/
private theorem brrs_refinedGlobalRadialPolarMass_le_cubicTimeMass
    {d : Nat} (hd : 3 ≤ d) (A C t : Real) (hA : 0 ≤ A) (hC : 0 ≤ C)
    (ht : 2 ≤ t) :
    ENNReal.ofReal (surfaceMass d) *
        (∫⁻ r in Ioi (0 : Real), ENNReal.ofReal r ^ (d - 1) *
          brrsLevelZeroKernelRefinedGlobalRadialMajorant d (d + 2) (2 * d + 5)
            A C t r) ≤
      (ENNReal.ofReal (surfaceMass d) *
          ENNReal.ofReal (brrsCubicCoefficientTimeConstant d A C) *
            brrsCubicProfileMass) *
        ENNReal.ofReal (t ^ (((d : Real) - 1) / 2)) := by
  have hD : 0 ≤ brrsCubicCoefficientTimeConstant d A C := by
    unfold brrsCubicCoefficientTimeConstant
    positivity
  have hscalar :=
    lintegral_refinedGlobalRadialPolarMass_le_cubicProfileMass
      hd A C t hA hC (le_trans (by norm_num) ht)
  have hcoeff :=
    brrs_cubicCoefficientSum_le_timeHalfExponent hd A C t hA hC ht
  calc
    ENNReal.ofReal (surfaceMass d) *
        (∫⁻ r in Ioi (0 : Real), ENNReal.ofReal r ^ (d - 1) *
          brrsLevelZeroKernelRefinedGlobalRadialMajorant d (d + 2) (2 * d + 5)
            A C t r) ≤
        ENNReal.ofReal (surfaceMass d) *
          ((brrsCompactCubicCoefficient d A + brrsFrontCubicCoefficient d C t +
              brrsFrontCubicCoefficient d C t + brrsMiddleCubicCoefficient d C) *
            brrsCubicProfileMass) := by
      apply mul_le_mul_right
      simpa only [brrsCubicProfileMass] using hscalar
    _ ≤ ENNReal.ofReal (surfaceMass d) *
          (ENNReal.ofReal
            (brrsCubicCoefficientTimeConstant d A C *
              t ^ (((d : Real) - 1) / 2)) * brrsCubicProfileMass) := by
      exact mul_le_mul_right
        (mul_le_mul_left hcoeff brrsCubicProfileMass)
        (ENNReal.ofReal (surfaceMass d))
    _ = (ENNReal.ofReal (surfaceMass d) *
          ENNReal.ofReal (brrsCubicCoefficientTimeConstant d A C) *
            brrsCubicProfileMass) *
        ENNReal.ofReal (t ^ (((d : Real) - 1) / 2)) := by
      rw [ENNReal.ofReal_mul hD]
      ring

/-- In dimensions at least three, the level-zero annular half-wave kernel has
the sharp `s^((d - 1) / 2)` spatial `L¹` growth.  The proof combines the
stationary radial profile with the integrable cubic phase-line profile. -/
theorem exists_brrs_levelZeroHalfWaveKernelL1_bound_dim_ge_three
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ B : Real, 0 < B ∧ ∀ s : Real, 2 ≤ s →
      (∫ x : Euclidean d, ‖brrsDyadicHalfWaveKernel Phi 0 s x‖) ≤
        B * s ^ (((d : Real) - 1) / 2) := by
  let A : Real := ∫ xi : Euclidean d, ‖brrsDyadicMultiplierSchwartz Phi 0 xi‖
  obtain ⟨C, hC, hkernel⟩ :=
    exists_brrsLevelZeroKernelRefinedGlobalRadialMajorant
      (d := d) (N := d + 2) (M := 2 * d + 5) hd (by omega) Phi
  let F : Real → Real → ENNReal := fun s =>
    brrsLevelZeroKernelRefinedGlobalRadialMajorant d (d + 2) (2 * d + 5) A C s
  let D : Real := brrsCubicCoefficientTimeConstant d A C
  let Q : ENNReal := ENNReal.ofReal (surfaceMass d) * ENNReal.ofReal D *
    brrsCubicProfileMass
  let B : Real := Q.toReal + 1
  have hA : 0 ≤ A := by
    dsimp only [A]
    exact integral_nonneg fun _ => norm_nonneg _
  have hD : 0 ≤ D := by
    dsimp only [D]
    unfold brrsCubicCoefficientTimeConstant
    positivity
  have hF : ∀ s : Real, Measurable (F s) := by
    intro s
    exact measurable_brrsLevelZeroKernelRefinedGlobalRadialMajorant
      d (d + 2) (2 * d + 5) A C s
  have hmajorant : ∀ s : Real, 2 ≤ s → ∀ x : Euclidean d,
      ‖(brrsDyadicHalfWaveKernel Phi 0 s : Euclidean d → Complex) x‖ₑ ≤ F s ‖x‖ := by
    intro s _ x
    simpa only [F, A] using hkernel s x
  have hLtop : brrsCubicProfileMass ≠ ∞ := by
    simpa only [brrsCubicProfileMass] using lintegral_brrsCubicJapaneseProfile_ne_top
  have hQtop : Q ≠ ∞ := by
    dsimp only [Q]
    exact ENNReal.mul_ne_top
      (ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top) hLtop
  have hB : 0 < B := by
    dsimp only [B]
    positivity
  exact exists_brrs_levelZeroHalfWaveKernelL1_bound_of_radial_polar_majorant
    (lt_of_lt_of_le (by norm_num) hd) Phi F hF hmajorant B hB (by
      intro s hs
      have hs0 : 0 ≤ s := le_trans (by norm_num) hs
      have hT0 : 0 ≤ s ^ (((d : Real) - 1) / 2) :=
        Real.rpow_nonneg hs0 _
      have hpolar :
          ENNReal.ofReal (surfaceMass d) *
              (∫⁻ r in Ioi (0 : Real), ENNReal.ofReal r ^ (d - 1) * F s r) ≤
            Q * ENNReal.ofReal (s ^ (((d : Real) - 1) / 2)) := by
        simpa only [F, A, D, Q] using
          brrs_refinedGlobalRadialPolarMass_le_cubicTimeMass
            hd A C s hA hC.le hs
      have hrighttop : Q * ENNReal.ofReal (s ^ (((d : Real) - 1) / 2)) ≠ ∞ :=
        ENNReal.mul_ne_top hQtop ENNReal.ofReal_ne_top
      have hlefttop :
          ENNReal.ofReal (surfaceMass d) *
              (∫⁻ r in Ioi (0 : Real), ENNReal.ofReal r ^ (d - 1) * F s r) ≠ ∞ :=
        ne_top_of_le_ne_top hrighttop hpolar
      refine ⟨hlefttop, ?_⟩
      have htoReal := (ENNReal.toReal_le_toReal hlefttop hrighttop).2 hpolar
      have htoReal' :
          (ENNReal.ofReal (surfaceMass d) *
              (∫⁻ r in Ioi (0 : Real), ENNReal.ofReal r ^ (d - 1) * F s r)).toReal ≤
            Q.toReal * s ^ (((d : Real) - 1) / 2) := by
        simpa only [ENNReal.toReal_mul, ENNReal.toReal_ofReal hT0] using htoReal
      calc
        (ENNReal.ofReal (surfaceMass d) *
            (∫⁻ r in Ioi (0 : Real), ENNReal.ofReal r ^ (d - 1) * F s r)).toReal ≤
            Q.toReal * s ^ (((d : Real) - 1) / 2) := htoReal'
        _ ≤ (Q.toReal + 1) * s ^ (((d : Real) - 1) / 2) := by
          apply mul_le_mul_of_nonneg_right
          · linarith
          · exact hT0
        _ = B * s ^ (((d : Real) - 1) / 2) := by rfl)

/-- The level-zero `L¹` bound in dimension at least three transports by exact
dyadic scaling to every positive annular frequency level. -/
theorem exists_brrs_dyadicHalfWaveKernelL1_bound_dim_ge_three
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ B : Real, 0 < B ∧ ∀ j : Nat, 1 ≤ j → ∀ t : Real,
      t ∈ Icc (1 : Real) 2 →
        (∫ x : Euclidean d, ‖brrsDyadicHalfWaveKernel Phi j t x‖) ≤
          B * ((2 : Real) ^ j) ^ (((d : Real) - 1) / 2) := by
  exact exists_brrs_dyadicHalfWaveKernelL1_bound_of_levelZero
    (le_trans (by norm_num) hd) Phi
    (exists_brrs_levelZeroHalfWaveKernelL1_bound_dim_ge_three hd Phi)

/-! ### Section 5: one-dimensional weighted radial-block estimates

The proof of BRRS Proposition 5.1 reduces its main terms to translated
one-dimensional profiles.  The next lemmas make that reduction reusable: the
time-set geometry is entirely captured by `brrsKappa`, while the analytic
profile may be an arbitrary nonnegative measurable convolution kernel.
-/

/-! ### Weighted two-radius profile transfer

The endpoint two-radius kernel carries a factor `(s / r)^σ` after the radial
half-density normalization.  On the high-output region this factor is harmless:
the phase relation controls `s / r` by one Japanese bracket in the phase, and
any fixed amount of stationary decay absorbs that bracket.  We keep this
elementary calculation separate from the radial-block argument, so that the
operator assembly can invoke it without hiding any comparison-of-radii step.
-/

/-- A phase relation controls the input/output radius ratio on the high-output
region.  The hypothesis is deliberately sign-free: every literal phase
`t ± r ± s` supplies `s ≤ t + r + |u|` by the triangle inequality. -/
theorem brrs_radiusRatio_le_two_mul_one_add_abs_of_phase
    (r s t u : Real) (hr : 16 ≤ r) (ht : t ∈ Icc (1 : Real) 2)
    (hphase : s ≤ t + r + |u|) :
    s / r ≤ 2 * (1 + |u|) := by
  have hrpos : 0 < r := by linarith
  have ha : 0 ≤ |u| := abs_nonneg u
  have ht2 : t ≤ 2 := ht.2
  have hcoef : 0 ≤ 2 * r - 1 := by linarith
  have hprod : 0 ≤ (2 * r - 1) * |u| := mul_nonneg hcoef ha
  rw [div_le_iff₀ hrpos]
  calc
    s ≤ t + r + |u| := hphase
    _ ≤ (2 * (1 + |u|)) * r := by
      nlinarith

/-- Each of the four literal two-radius wave phases satisfies the sign-free
radius/phase relation used by the transfer lemma. -/
theorem brrs_sourceRadius_le_time_add_output_add_abs_sub_sub
    (r s t : Real) (hr : 0 ≤ r) :
    s ≤ t + r + |t - r - s| := by
  nlinarith [neg_le_abs (t - r - s)]

theorem brrs_sourceRadius_le_time_add_output_add_abs_sub_add
    (r s t : Real) (ht : 0 ≤ t) :
    s ≤ t + r + |t - r + s| := by
  nlinarith [le_abs_self (t - r + s)]

theorem brrs_sourceRadius_le_time_add_output_add_abs_add_sub
    (r s t : Real) :
    s ≤ t + r + |t + r - s| := by
  nlinarith [neg_le_abs (t + r - s)]

theorem brrs_sourceRadius_le_time_add_output_add_abs_add_add
    (r s t : Real) (hr : 0 ≤ r) (ht : 0 ≤ t) :
    s ≤ t + r + |t + r + s| := by
  nlinarith [le_abs_self (t + r + s)]

/-- The stationary profile at a literal wave phase is bounded by a Japanese
bracket in the unscaled phase variable. -/
theorem brrsStationaryRapidProfile_twoPi_phase_le_rpowJapanese
    (N : Nat) (u : Real) :
    brrsStationaryRapidProfile N (2 * Real.pi * u) ≤
      (2 : Real) ^ (N : Real) * (1 + |u|) ^ (-(N : Real)) := by
  have htwopi : 1 ≤ |2 * Real.pi| := by
    rw [abs_of_pos (by positivity)]
    nlinarith [Real.pi_gt_three]
  have habs : |u| ≤ |2 * Real.pi * u| := by
    calc
      |u| = 1 * |u| := by ring
      _ ≤ |2 * Real.pi| * |u| :=
        mul_le_mul_of_nonneg_right htwopi (abs_nonneg u)
      _ = |2 * Real.pi * u| := (abs_mul _ _).symm
  have hinv : (1 + |2 * Real.pi * u|)⁻¹ ≤ (1 + |u|)⁻¹ := by
    apply (inv_le_inv₀ (by positivity : 0 < 1 + |2 * Real.pi * u|)
      (by positivity : 0 < 1 + |u|)).mpr
    linarith
  calc
    brrsStationaryRapidProfile N (2 * Real.pi * u) ≤
        (2 : Real) ^ N * ((1 + |2 * Real.pi * u|)⁻¹) ^ N :=
      brrsStationaryRapidProfile_le_japaneseBracket N _
    _ ≤ (2 : Real) ^ N * ((1 + |u|)⁻¹) ^ N := by
      apply mul_le_mul_of_nonneg_left
      · exact pow_le_pow_left₀ (by positivity) hinv _
      · positivity
    _ = (2 : Real) ^ (N : Real) * (1 + |u|) ^ (-(N : Real)) := by
      rw [Real.rpow_natCast, Real.rpow_neg (by positivity),
        Real.rpow_natCast, inv_pow]

/-- The high-output phase relation moves an arbitrary nonnegative radius
power into a Japanese bracket.  This is the algebraic comparison behind the
compact/noncompact source-radius split in BRRS Section 5. -/
theorem brrs_radiusRatio_rpow_le_two_rpow_mul_japanese_of_phase
    {sigma r s t u : Real} (hsigma : 0 ≤ sigma) (hs : 0 ≤ s)
    (hr : 16 ≤ r) (ht : t ∈ Icc (1 : Real) 2)
    (hphase : s ≤ t + r + |u|) :
    (s / r) ^ sigma ≤
      (2 : Real) ^ sigma * (1 + |u|) ^ sigma := by
  have hrpos : 0 < r := by linarith
  have hratio : s / r ≤ 2 * (1 + |u|) :=
    brrs_radiusRatio_le_two_mul_one_add_abs_of_phase r s t u hr ht hphase
  have hratio0 : 0 ≤ s / r := div_nonneg hs hrpos.le
  calc
    (s / r) ^ sigma ≤ (2 * (1 + |u|)) ^ sigma :=
      Real.rpow_le_rpow hratio0 hratio hsigma
    _ = (2 : Real) ^ sigma * (1 + |u|) ^ sigma := by
      rw [Real.mul_rpow (by norm_num) (by positivity)]

/-- The compact-source-radius half of the Section 5 split: on `s ≤ S`, the
two-radius weight is a fixed constant on the high-output region. -/
theorem brrs_radiusRatio_rpow_le_sourceBound
    {sigma r s S : Real} (hsigma : 0 ≤ sigma) (hs : 0 ≤ s)
    (hsS : s ≤ S) (hr : 16 ≤ r) :
    (s / r) ^ sigma ≤ (S / 16) ^ sigma := by
  have hrpos : 0 < r := by linarith
  have hratio : s / r ≤ S / 16 := by
    calc
      s / r ≤ s / 16 :=
        div_le_div_of_nonneg_left hs (by norm_num) hr
      _ ≤ S / 16 := div_le_div_of_nonneg_right hsS (by norm_num)
  exact Real.rpow_le_rpow (div_nonneg hs hrpos.le) hratio hsigma

/-- Multiplying the preceding compact-source comparison by a stationary
profile preserves it pointwise. -/
theorem brrs_weightedRapidProfile_le_sourceBound
    (N : Nat) {sigma r s S u : Real} (hsigma : 0 ≤ sigma) (hs : 0 ≤ s)
    (hsS : s ≤ S) (hr : 16 ≤ r) :
    (s / r) ^ sigma * brrsStationaryRapidProfile N (2 * Real.pi * u) ≤
      (S / 16) ^ sigma * brrsStationaryRapidProfile N (2 * Real.pi * u) := by
  exact mul_le_mul_of_nonneg_right
    (brrs_radiusRatio_rpow_le_sourceBound hsigma hs hsS hr)
    (brrsStationaryRapidProfile_nonneg N _)

/-- A rapid stationary profile absorbs the two-radius weight once its decay
exceeds the weight exponent.  The conclusion retains the precise remaining
Japanese power, which is useful when a later argument chooses a decay budget
other than the default cubic one. -/
theorem brrs_weightedRapidProfile_le_rpowJapanese_of_phase
    (N : Nat) {sigma r s t u : Real} (hsigma : 0 ≤ sigma) (hs : 0 ≤ s)
    (hr : 16 ≤ r) (ht : t ∈ Icc (1 : Real) 2)
    (hphase : s ≤ t + r + |u|) :
    (s / r) ^ sigma * brrsStationaryRapidProfile N (2 * Real.pi * u) ≤
      (2 : Real) ^ (sigma + (N : Real)) *
        (1 + |u|) ^ (sigma - (N : Real)) := by
  have hweight := brrs_radiusRatio_rpow_le_two_rpow_mul_japanese_of_phase
    hsigma hs hr ht hphase
  have hprofile := brrsStationaryRapidProfile_twoPi_phase_le_rpowJapanese N u
  calc
    (s / r) ^ sigma * brrsStationaryRapidProfile N (2 * Real.pi * u) ≤
        ((2 : Real) ^ sigma * (1 + |u|) ^ sigma) *
          ((2 : Real) ^ (N : Real) * (1 + |u|) ^ (-(N : Real))) := by
      exact mul_le_mul hweight hprofile
        (brrsStationaryRapidProfile_nonneg N _)
        (mul_nonneg (Real.rpow_nonneg (by norm_num) _)
          (Real.rpow_nonneg (by positivity) _))
    _ = ((2 : Real) ^ sigma * (2 : Real) ^ (N : Real)) *
          ((1 + |u|) ^ sigma * (1 + |u|) ^ (-(N : Real))) := by ring
    _ = (2 : Real) ^ (sigma + (N : Real)) *
          (1 + |u|) ^ (sigma - (N : Real)) := by
      rw [← Real.rpow_add (by norm_num : 0 < (2 : Real)),
        ← Real.rpow_add (by positivity : 0 < 1 + |u|)]
      congr 2

/-- The cubic form of the weighted two-radius transfer.  Three powers of
Japanese-bracket decay remain after the ratio has been absorbed, so this
right-hand side is integrable on the phase line. -/
theorem brrs_weightedRapidProfile_le_cubicJapanese_of_phase
    (N : Nat) {sigma r s t u : Real} (hsigma : 0 ≤ sigma)
    (hdecay : sigma + 3 ≤ (N : Real)) (hs : 0 ≤ s)
    (hr : 16 ≤ r) (ht : t ∈ Icc (1 : Real) 2)
    (hphase : s ≤ t + r + |u|) :
    (s / r) ^ sigma * brrsStationaryRapidProfile N (2 * Real.pi * u) ≤
      (2 : Real) ^ (sigma + (N : Real)) * (1 + |u|) ^ (-3 : Real) := by
  have hbase := brrs_weightedRapidProfile_le_rpowJapanese_of_phase
    N hsigma hs hr ht hphase
  have hbracket : 1 ≤ 1 + |u| := by linarith [abs_nonneg u]
  have hexponent : sigma - (N : Real) ≤ (-3 : Real) := by linarith
  calc
    (s / r) ^ sigma * brrsStationaryRapidProfile N (2 * Real.pi * u) ≤
        (2 : Real) ^ (sigma + (N : Real)) *
          (1 + |u|) ^ (sigma - (N : Real)) := hbase
    _ ≤ (2 : Real) ^ (sigma + (N : Real)) * (1 + |u|) ^ (-3 : Real) := by
      apply mul_le_mul_of_nonneg_left
      · exact Real.rpow_le_rpow_of_exponent_le hbracket hexponent
      · exact Real.rpow_nonneg (by norm_num) _


/-- The nonnegative one-dimensional convolution used in the Section 5 radial
reduction.  Working in `ENNReal` makes positivity and Tonelli's theorem
literal, with no auxiliary almost-everywhere conventions. -/
noncomputable def brrsOneDimProfileConvolution
    (omega f : Real → ENNReal) (x : Real) : ENNReal :=
  ∫⁻ s : Real, omega (x - s) * f s

/-- Reflection of a nonnegative phase-line profile.  The definition is kept
separate because the four wave signs naturally produce both `t-r-s` and
`t-r+s` convolutions. -/
def brrsReflectProfile (f : Real → ENNReal) : Real → ENNReal :=
  fun s => f (-s)

/-- The positive convolution with a `+s` phase variable. -/
noncomputable def brrsOneDimProfileConvolutionPlus
    (omega f : Real → ENNReal) (x : Real) : ENNReal :=
  ∫⁻ s : Real, omega (x + s) * f s

/-- Reflection preserves measurability. -/
theorem measurable_brrsReflectProfile {f : Real → ENNReal}
    (hf : Measurable f) :
    Measurable (brrsReflectProfile f) := by
  unfold brrsReflectProfile
  exact hf.comp measurable_neg

/-- Reflection preserves the full phase-line mass. -/
theorem lintegral_brrsReflectProfile_eq {f : Real → ENNReal} :
    (∫⁻ s : Real, brrsReflectProfile f s) = ∫⁻ s : Real, f s := by
  unfold brrsReflectProfile
  exact lintegral_neg_eq_self f

/-- A plus-sign profile convolution is an ordinary minus-sign convolution
against the reflected input.  This is the exact bookkeeping identity used to
put every endpoint sign into the single Section 5 convolution API. -/
theorem brrsOneDimProfileConvolutionPlus_eq_reflect
    (omega f : Real → ENNReal) (x : Real) :
    brrsOneDimProfileConvolutionPlus omega f x =
      brrsOneDimProfileConvolution omega (brrsReflectProfile f) x := by
  unfold brrsOneDimProfileConvolutionPlus brrsOneDimProfileConvolution
    brrsReflectProfile
  have h := lintegral_neg_eq_self
    (μ := (volume : Measure Real)) (fun s : Real => omega (x + s) * f s)
  simpa [sub_eq_add_neg] using h.symm

/-- Measurability of the positive one-dimensional profile convolution. -/
theorem measurable_brrsOneDimProfileConvolution
    {omega f : Real → ENNReal} (homega : Measurable omega) (hf : Measurable f) :
    Measurable (brrsOneDimProfileConvolution omega f) := by
  unfold brrsOneDimProfileConvolution
  apply Measurable.lintegral_prod_right
  change Measurable (fun z : Real × Real => omega (z.1 - z.2) * f z.2)
  exact (homega.comp (measurable_fst.sub measurable_snd)).mul
    (hf.comp measurable_snd)

/-- Measurability of the plus-sign profile convolution follows from the
reflection identity. -/
theorem measurable_brrsOneDimProfileConvolutionPlus
    {omega f : Real → ENNReal} (homega : Measurable omega) (hf : Measurable f) :
    Measurable (brrsOneDimProfileConvolutionPlus omega f) := by
  rw [show brrsOneDimProfileConvolutionPlus omega f =
      brrsOneDimProfileConvolution omega (brrsReflectProfile f) by
        funext x
        exact brrsOneDimProfileConvolutionPlus_eq_reflect omega f x]
  exact measurable_brrsOneDimProfileConvolution homega
    (measurable_brrsReflectProfile hf)

/-- Tonelli's identity for the positive Section 5 profile convolution.  This
is the exact `L¹` Young identity, so integrability of the profile and input
immediately gives a finite global convolution mass. -/
theorem lintegral_brrsOneDimProfileConvolution_eq_mul
    {omega f : Real → ENNReal} (homega : Measurable omega) (hf : Measurable f) :
    (∫⁻ x : Real, brrsOneDimProfileConvolution omega f x) =
      (∫⁻ u : Real, omega u) * ∫⁻ s : Real, f s := by
  have hmeas : Measurable (Function.uncurry
      (fun x s : Real => omega (x - s) * f s)) := by
    change Measurable (fun z : Real × Real => omega (z.1 - z.2) * f z.2)
    exact (homega.comp (measurable_fst.sub measurable_snd)).mul
      (hf.comp measurable_snd)
  change (∫⁻ x : Real, ∫⁻ s : Real, omega (x - s) * f s) =
    (∫⁻ u : Real, omega u) * ∫⁻ s : Real, f s
  calc
    (∫⁻ x : Real, ∫⁻ s : Real, omega (x - s) * f s) =
        ∫⁻ s : Real, ∫⁻ x : Real, omega (x - s) * f s :=
      lintegral_lintegral_swap hmeas.aemeasurable
    _ = ∫⁻ s : Real, (∫⁻ u : Real, omega u) * f s := by
      apply lintegral_congr
      intro s
      calc
        (∫⁻ x : Real, omega (x - s) * f s) =
            (∫⁻ x : Real, omega (x - s)) * f s :=
          lintegral_mul_const (f s)
            (homega.comp (measurable_id.sub measurable_const))
        _ = (∫⁻ u : Real, omega u) * f s := by
          rw [lintegral_sub_right_eq_self]
    _ = (∫⁻ u : Real, omega u) * ∫⁻ s : Real, f s :=
      lintegral_const_mul _ hf

/-- Tonelli's mass identity also holds for the plus-sign convolution. -/
theorem lintegral_brrsOneDimProfileConvolutionPlus_eq_mul
    {omega f : Real → ENNReal} (homega : Measurable omega) (hf : Measurable f) :
    (∫⁻ x : Real, brrsOneDimProfileConvolutionPlus omega f x) =
      (∫⁻ u : Real, omega u) * ∫⁻ s : Real, f s := by
  rw [show (fun x : Real => brrsOneDimProfileConvolutionPlus omega f x) =
      fun x => brrsOneDimProfileConvolution omega (brrsReflectProfile f) x by
        funext x
        exact brrsOneDimProfileConvolutionPlus_eq_reflect omega f x]
  rw [lintegral_brrsOneDimProfileConvolution_eq_mul homega
    (measurable_brrsReflectProfile hf), lintegral_brrsReflectProfile_eq]

/-- A finite time packet has a finite BRRS local-count coefficient at every
positive radius. -/
theorem brrsKappa_ne_top
    (T : Finset Real) (R : NNReal) (alpha : Real) (hR : R ≠ 0) :
    brrsKappa T R alpha ≠ ∞ := by
  have hpow : (R : ENNReal) ^ (-alpha) ≠ ∞ :=
    ENNReal.rpow_ne_top_of_ne_zero
      (ENNReal.coe_ne_zero.mpr hR) ENNReal.coe_ne_top
  have hcard : (T.card : ENNReal) ≠ ∞ := ENNReal.coe_ne_top
  exact ne_top_of_le_ne_top (ENNReal.mul_ne_top hpow hcard)
    (brrsKappa_le_rpow_neg_mul_card T R alpha)

/-- The abstract Section 5 main-block inequality for a translated positive
profile, written directly at an arbitrary `Lᵖ` power.  It is a finite-time
estimate: no covering or limiting argument is hidden in the statement. -/
theorem brrs_sum_mainCell_add_weighted_profile_rpow_le
    (T : Finset Real) (R : NNReal) (alpha p : Real) (hR : R ≠ 0)
    (W F : Real → ENNReal) (hF : Measurable F)
    (hW : ∀ r ∈ Icc (R : Real) (2 * (R : Real)),
      W r ≤ (R : ENNReal) ^ (-alpha)) :
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * (F (t + r)) ^ p) ≤
      7 * brrsKappa T R alpha * ∫⁻ x : Real, (F x) ^ p := by
  have hFp : Measurable (fun x : Real => (F x) ^ p) :=
    ENNReal.continuous_rpow_const.measurable.comp hF
  exact brrs_sum_mainCell_add_weighted_lintegral_le_seven_mul_brrsKappa
    T R alpha hR W (fun x : Real => (F x) ^ p) hFp hW

/-- The reflected Section 5 main-block inequality for an arbitrary positive
profile at an arbitrary `Lᵖ` power. -/
theorem brrs_sum_mainCell_sub_weighted_profile_rpow_le
    (T : Finset Real) (R : NNReal) (alpha p : Real) (hR : R ≠ 0)
    (W F : Real → ENNReal) (hF : Measurable F)
    (hW : ∀ r ∈ Icc (R : Real) (2 * (R : Real)),
      W r ≤ (R : ENNReal) ^ (-alpha)) :
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * (F (t - r)) ^ p) ≤
      7 * brrsKappa T R alpha * ∫⁻ x : Real, (F x) ^ p := by
  have hFp : Measurable (fun x : Real => (F x) ^ p) :=
    ENNReal.continuous_rpow_const.measurable.comp hF
  exact brrs_sum_mainCell_sub_weighted_lintegral_le_seven_mul_brrsKappa
    T R alpha hR W (fun x : Real => (F x) ^ p) hFp hW

/-- The outgoing finite-time weighted radial-block estimate for a positive
integrable-profile convolution.  The right-hand side is exactly the global
one-dimensional `Lᵖ` profile mass, ready for a subsequent Young estimate. -/
theorem brrs_sum_mainCell_add_weighted_profileConvolution_rpow_le
    (T : Finset Real) (R : NNReal) (alpha p : Real) (hR : R ≠ 0)
    (W omega f : Real → ENNReal)
    (homega : Measurable omega) (hf : Measurable f)
    (hW : ∀ r ∈ Icc (R : Real) (2 * (R : Real)),
      W r ≤ (R : ENNReal) ^ (-alpha)) :
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * (brrsOneDimProfileConvolution omega f (t + r)) ^ p) ≤
      7 * brrsKappa T R alpha *
        ∫⁻ x : Real, (brrsOneDimProfileConvolution omega f x) ^ p := by
  exact brrs_sum_mainCell_add_weighted_profile_rpow_le
    T R alpha p hR W (brrsOneDimProfileConvolution omega f)
    (measurable_brrsOneDimProfileConvolution homega hf) hW

/-- The incoming finite-time weighted radial-block estimate for a positive
integrable-profile convolution. -/
theorem brrs_sum_mainCell_sub_weighted_profileConvolution_rpow_le
    (T : Finset Real) (R : NNReal) (alpha p : Real) (hR : R ≠ 0)
    (W omega f : Real → ENNReal)
    (homega : Measurable omega) (hf : Measurable f)
    (hW : ∀ r ∈ Icc (R : Real) (2 * (R : Real)),
      W r ≤ (R : ENNReal) ^ (-alpha)) :
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * (brrsOneDimProfileConvolution omega f (t - r)) ^ p) ≤
      7 * brrsKappa T R alpha *
        ∫⁻ x : Real, (brrsOneDimProfileConvolution omega f x) ^ p := by
  exact brrs_sum_mainCell_sub_weighted_profile_rpow_le
    T R alpha p hR W (brrsOneDimProfileConvolution omega f)
    (measurable_brrsOneDimProfileConvolution homega hf) hW

/-- The outgoing weighted radial block of an integrable positive convolution
is controlled by the exact product of its profile and input masses.  This is
the fully proved finite-time `L¹` instance of the Section 5 one-dimensional
estimate. -/
theorem brrs_sum_mainCell_add_weighted_profileConvolution_le
    (T : Finset Real) (R : NNReal) (alpha : Real) (hR : R ≠ 0)
    (W omega f : Real → ENNReal)
    (homega : Measurable omega) (hf : Measurable f)
    (hW : ∀ r ∈ Icc (R : Real) (2 * (R : Real)),
      W r ≤ (R : ENNReal) ^ (-alpha)) :
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * brrsOneDimProfileConvolution omega f (t + r)) ≤
      7 * brrsKappa T R alpha *
        ((∫⁻ u : Real, omega u) * ∫⁻ s : Real, f s) := by
  calc
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * brrsOneDimProfileConvolution omega f (t + r)) ≤
        7 * brrsKappa T R alpha *
          ∫⁻ x : Real, (brrsOneDimProfileConvolution omega f x) ^ (1 : Real) := by
      simpa only [ENNReal.rpow_one, mul_assoc, mul_left_comm, mul_comm] using
        (brrs_sum_mainCell_add_weighted_profileConvolution_rpow_le
          T R alpha 1 hR W omega f homega hf hW)
    _ = 7 * brrsKappa T R alpha *
          ((∫⁻ u : Real, omega u) * ∫⁻ s : Real, f s) := by
      simp only [ENNReal.rpow_one]
      rw [lintegral_brrsOneDimProfileConvolution_eq_mul homega hf]

/-- The reflected finite-time `L¹` Section 5 estimate for a positive
integrable profile convolution. -/
theorem brrs_sum_mainCell_sub_weighted_profileConvolution_le
    (T : Finset Real) (R : NNReal) (alpha : Real) (hR : R ≠ 0)
    (W omega f : Real → ENNReal)
    (homega : Measurable omega) (hf : Measurable f)
    (hW : ∀ r ∈ Icc (R : Real) (2 * (R : Real)),
      W r ≤ (R : ENNReal) ^ (-alpha)) :
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * brrsOneDimProfileConvolution omega f (t - r)) ≤
      7 * brrsKappa T R alpha *
        ((∫⁻ u : Real, omega u) * ∫⁻ s : Real, f s) := by
  calc
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * brrsOneDimProfileConvolution omega f (t - r)) ≤
        7 * brrsKappa T R alpha *
          ∫⁻ x : Real, (brrsOneDimProfileConvolution omega f x) ^ (1 : Real) := by
      simpa only [ENNReal.rpow_one] using
        (brrs_sum_mainCell_sub_weighted_profileConvolution_rpow_le
          T R alpha 1 hR W omega f homega hf hW)
    _ = 7 * brrsKappa T R alpha *
          ((∫⁻ u : Real, omega u) * ∫⁻ s : Real, f s) := by
      simp only [ENNReal.rpow_one]
      rw [lintegral_brrsOneDimProfileConvolution_eq_mul homega hf]

/-- Integrable positive profile and input give a genuinely finite outgoing
radial-block mass; this makes explicit the finiteness hidden by the paper's
`\lesssim` notation. -/
theorem brrs_sum_mainCell_add_weighted_profileConvolution_ne_top
    (T : Finset Real) (R : NNReal) (alpha : Real) (hR : R ≠ 0)
    (W omega f : Real → ENNReal)
    (homega : Measurable omega) (hf : Measurable f)
    (homega_top : (∫⁻ u : Real, omega u) ≠ ∞)
    (hf_top : (∫⁻ s : Real, f s) ≠ ∞)
    (hW : ∀ r ∈ Icc (R : Real) (2 * (R : Real)),
      W r ≤ (R : ENNReal) ^ (-alpha)) :
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * brrsOneDimProfileConvolution omega f (t + r)) ≠ ∞ := by
  have hseven : (7 : ENNReal) ≠ ∞ := ENNReal.ofNat_ne_top
  have hright : 7 * brrsKappa T R alpha *
      ((∫⁻ u : Real, omega u) * ∫⁻ s : Real, f s) ≠ ∞ :=
    ENNReal.mul_ne_top
      (ENNReal.mul_ne_top hseven (brrsKappa_ne_top T R alpha hR))
      (ENNReal.mul_ne_top homega_top hf_top)
  exact ne_top_of_le_ne_top hright
    (brrs_sum_mainCell_add_weighted_profileConvolution_le
      T R alpha hR W omega f homega hf hW)

/-- Integrable positive profile and input also give finiteness for the
reflected radial block. -/
theorem brrs_sum_mainCell_sub_weighted_profileConvolution_ne_top
    (T : Finset Real) (R : NNReal) (alpha : Real) (hR : R ≠ 0)
    (W omega f : Real → ENNReal)
    (homega : Measurable omega) (hf : Measurable f)
    (homega_top : (∫⁻ u : Real, omega u) ≠ ∞)
    (hf_top : (∫⁻ s : Real, f s) ≠ ∞)
    (hW : ∀ r ∈ Icc (R : Real) (2 * (R : Real)),
      W r ≤ (R : ENNReal) ^ (-alpha)) :
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * brrsOneDimProfileConvolution omega f (t - r)) ≠ ∞ := by
  have hseven : (7 : ENNReal) ≠ ∞ := ENNReal.ofNat_ne_top
  have hright : 7 * brrsKappa T R alpha *
      ((∫⁻ u : Real, omega u) * ∫⁻ s : Real, f s) ≠ ∞ :=
    ENNReal.mul_ne_top
      (ENNReal.mul_ne_top hseven (brrsKappa_ne_top T R alpha hR))
      (ENNReal.mul_ne_top homega_top hf_top)
  exact ne_top_of_le_ne_top hright
    (brrs_sum_mainCell_sub_weighted_profileConvolution_le
      T R alpha hR W omega f homega hf hW)

/-- Pointwise Cauchy--Schwarz for a positive finite Section 5 profile.  The
strict positivity and finite-valued hypotheses hold for the usual rapidly
decaying model profiles and avoid any hidden `0 · ∞` convention. -/
theorem brrsOneDimProfileConvolution_rpow_two_le
    {omega f : Real → ENNReal} (homega : Measurable omega) (hf : Measurable f)
    (homega_pos : ∀ u : Real, 0 < omega u)
    (homega_top : ∀ u : Real, omega u ≠ ∞) (x : Real) :
    (brrsOneDimProfileConvolution omega f x) ^ (2 : Real) ≤
      (∫⁻ u : Real, omega u) *
        brrsOneDimProfileConvolution omega (fun s : Real => (f s) ^ (2 : Real)) x := by
  let a : Real → ENNReal := fun s => omega (x - s) ^ ((1 : Real) / 2)
  let b : Real → ENNReal := fun s =>
    omega (x - s) ^ ((1 : Real) / 2) * f s
  have hshift : Measurable (fun s : Real => omega (x - s)) :=
    homega.comp (measurable_const.sub measurable_id)
  have ha : AEMeasurable a volume := by
    exact (ENNReal.continuous_rpow_const.measurable.comp hshift).aemeasurable
  have hb : AEMeasurable b volume := by
    exact ((ENNReal.continuous_rpow_const.measurable.comp hshift).mul hf).aemeasurable
  have hpq : (2 : Real).HolderConjugate 2 := by
    rw [Real.holderConjugate_iff]
    norm_num
  have hprod : ∀ s : Real, a s * b s = omega (x - s) * f s := by
    intro s
    dsimp only [a, b]
    rw [show omega (x - s) ^ ((1 : Real) / 2) *
        (omega (x - s) ^ ((1 : Real) / 2) * f s) =
          (omega (x - s) ^ ((1 : Real) / 2) *
            omega (x - s) ^ ((1 : Real) / 2)) * f s by ring,
      ← ENNReal.rpow_add _ _ (ne_of_gt (homega_pos _)) (homega_top _)]
    norm_num
  have hA : (∫⁻ s : Real, (a s) ^ (2 : Real)) = ∫⁻ u : Real, omega u := by
    calc
      (∫⁻ s : Real, (a s) ^ (2 : Real)) = ∫⁻ s : Real, omega (x - s) := by
        apply lintegral_congr
        intro s
        dsimp only [a]
        rw [← ENNReal.rpow_mul]
        norm_num
      _ = ∫⁻ u : Real, omega u := lintegral_sub_left_eq_self omega x
  have hB : (∫⁻ s : Real, (b s) ^ (2 : Real)) =
      brrsOneDimProfileConvolution omega (fun s : Real => (f s) ^ (2 : Real)) x := by
    unfold brrsOneDimProfileConvolution
    apply lintegral_congr
    intro s
    dsimp only [b]
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : Real) ≤ 2),
      ← ENNReal.rpow_mul]
    norm_num
  have hholder := ENNReal.lintegral_mul_le_Lp_mul_Lq volume hpq ha hb
  have hbase : brrsOneDimProfileConvolution omega f x ≤
      (∫⁻ u : Real, omega u) ^ ((1 : Real) / 2) *
        (brrsOneDimProfileConvolution omega
          (fun s : Real => (f s) ^ (2 : Real)) x) ^ ((1 : Real) / 2) := by
    calc
      brrsOneDimProfileConvolution omega f x = ∫⁻ s : Real, a s * b s := by
        unfold brrsOneDimProfileConvolution
        apply lintegral_congr
        intro s
        exact (hprod s).symm
      _ ≤ (∫⁻ s : Real, (a s) ^ (2 : Real)) ^ ((1 : Real) / 2) *
          (∫⁻ s : Real, (b s) ^ (2 : Real)) ^ ((1 : Real) / 2) := hholder
      _ = (∫⁻ u : Real, omega u) ^ ((1 : Real) / 2) *
          (brrsOneDimProfileConvolution omega
            (fun s : Real => (f s) ^ (2 : Real)) x) ^ ((1 : Real) / 2) := by
        rw [hA, hB]
  calc
    (brrsOneDimProfileConvolution omega f x) ^ (2 : Real) ≤
        ((∫⁻ u : Real, omega u) ^ ((1 : Real) / 2) *
          (brrsOneDimProfileConvolution omega
            (fun s : Real => (f s) ^ (2 : Real)) x) ^ ((1 : Real) / 2)) ^ (2 : Real) :=
      ENNReal.rpow_le_rpow hbase (by norm_num)
    _ = (∫⁻ u : Real, omega u) *
        brrsOneDimProfileConvolution omega (fun s : Real => (f s) ^ (2 : Real)) x := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : Real) ≤ 2),
        ← ENNReal.rpow_mul, ← ENNReal.rpow_mul]
      norm_num

/-- The global positive `L²` Young inequality for the Section 5 profile
convolution.  Unlike the usual informal invocation of Young's inequality,
this is derived here from the preceding pointwise Cauchy--Schwarz estimate
and Tonelli's identity. -/
theorem lintegral_brrsOneDimProfileConvolution_rpow_two_le
    {omega f : Real → ENNReal} (homega : Measurable omega) (hf : Measurable f)
    (homega_pos : ∀ u : Real, 0 < omega u)
    (homega_top : ∀ u : Real, omega u ≠ ∞) :
    (∫⁻ x : Real, (brrsOneDimProfileConvolution omega f x) ^ (2 : Real)) ≤
      (∫⁻ u : Real, omega u) ^ (2 : Real) * ∫⁻ s : Real, (f s) ^ (2 : Real) := by
  have hfp : Measurable (fun s : Real => (f s) ^ (2 : Real)) :=
    ENNReal.continuous_rpow_const.measurable.comp hf
  have hconv : Measurable
      (brrsOneDimProfileConvolution omega (fun s : Real => (f s) ^ (2 : Real))) :=
    measurable_brrsOneDimProfileConvolution homega hfp
  calc
    (∫⁻ x : Real, (brrsOneDimProfileConvolution omega f x) ^ (2 : Real)) ≤
        ∫⁻ x : Real, (∫⁻ u : Real, omega u) *
          brrsOneDimProfileConvolution omega (fun s : Real => (f s) ^ (2 : Real)) x := by
      apply lintegral_mono
      intro x
      exact brrsOneDimProfileConvolution_rpow_two_le
        homega hf homega_pos homega_top x
    _ = (∫⁻ u : Real, omega u) *
          ∫⁻ x : Real,
            brrsOneDimProfileConvolution omega (fun s : Real => (f s) ^ (2 : Real)) x :=
      lintegral_const_mul _ hconv
    _ = (∫⁻ u : Real, omega u) *
          ((∫⁻ u : Real, omega u) * ∫⁻ s : Real, (f s) ^ (2 : Real)) := by
      rw [lintegral_brrsOneDimProfileConvolution_eq_mul homega hfp]
    _ = (∫⁻ u : Real, omega u) ^ (2 : Real) * ∫⁻ s : Real, (f s) ^ (2 : Real) := by
      rw [ENNReal.rpow_two]
      ring

/-- The outgoing Section 5 radial block at `p = 2`, with the global Young
step included.  This is a direct proved analogue of (5.4) for a positive
finite profile. -/
theorem brrs_sum_mainCell_add_weighted_profileConvolution_rpow_two_le_global
    (T : Finset Real) (R : NNReal) (alpha : Real) (hR : R ≠ 0)
    (W omega f : Real → ENNReal)
    (homega : Measurable omega) (hf : Measurable f)
    (homega_pos : ∀ u : Real, 0 < omega u)
    (homega_top : ∀ u : Real, omega u ≠ ∞)
    (hW : ∀ r ∈ Icc (R : Real) (2 * (R : Real)),
      W r ≤ (R : ENNReal) ^ (-alpha)) :
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * (brrsOneDimProfileConvolution omega f (t + r)) ^ (2 : Real)) ≤
      7 * brrsKappa T R alpha *
        ((∫⁻ u : Real, omega u) ^ (2 : Real) * ∫⁻ s : Real, (f s) ^ (2 : Real)) := by
  calc
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * (brrsOneDimProfileConvolution omega f (t + r)) ^ (2 : Real)) ≤
        7 * brrsKappa T R alpha *
          ∫⁻ x : Real, (brrsOneDimProfileConvolution omega f x) ^ (2 : Real) :=
      brrs_sum_mainCell_add_weighted_profileConvolution_rpow_le
        T R alpha 2 hR W omega f homega hf hW
    _ ≤ 7 * brrsKappa T R alpha *
          ((∫⁻ u : Real, omega u) ^ (2 : Real) *
            ∫⁻ s : Real, (f s) ^ (2 : Real)) :=
      mul_le_mul_right
        (lintegral_brrsOneDimProfileConvolution_rpow_two_le
          homega hf homega_pos homega_top)
        (7 * brrsKappa T R alpha)

/-- The reflected `p = 2` Section 5 radial-block estimate. -/
theorem brrs_sum_mainCell_sub_weighted_profileConvolution_rpow_two_le_global
    (T : Finset Real) (R : NNReal) (alpha : Real) (hR : R ≠ 0)
    (W omega f : Real → ENNReal)
    (homega : Measurable omega) (hf : Measurable f)
    (homega_pos : ∀ u : Real, 0 < omega u)
    (homega_top : ∀ u : Real, omega u ≠ ∞)
    (hW : ∀ r ∈ Icc (R : Real) (2 * (R : Real)),
      W r ≤ (R : ENNReal) ^ (-alpha)) :
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * (brrsOneDimProfileConvolution omega f (t - r)) ^ (2 : Real)) ≤
      7 * brrsKappa T R alpha *
        ((∫⁻ u : Real, omega u) ^ (2 : Real) * ∫⁻ s : Real, (f s) ^ (2 : Real)) := by
  calc
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * (brrsOneDimProfileConvolution omega f (t - r)) ^ (2 : Real)) ≤
        7 * brrsKappa T R alpha *
          ∫⁻ x : Real, (brrsOneDimProfileConvolution omega f x) ^ (2 : Real) :=
      brrs_sum_mainCell_sub_weighted_profileConvolution_rpow_le
        T R alpha 2 hR W omega f homega hf hW
    _ ≤ 7 * brrsKappa T R alpha *
          ((∫⁻ u : Real, omega u) ^ (2 : Real) *
            ∫⁻ s : Real, (f s) ^ (2 : Real)) :=
      mul_le_mul_right
        (lintegral_brrsOneDimProfileConvolution_rpow_two_le
          homega hf homega_pos homega_top)
        (7 * brrsKappa T R alpha)

/-- Pointwise Hölder control of a positive finite profile convolution at an
arbitrary exponent strictly larger than one. -/
theorem brrs_lintegral_restrict_rpow_le
    {p : Real} (hp : 1 < p) {A : Set Real} (_hA : MeasurableSet A)
    {f : Real → ENNReal} (hf : Measurable f) :
    (∫⁻ s in A, f s) ^ p ≤
      (volume A) ^ (p - 1) * ∫⁻ s in A, (f s) ^ p := by
  let q : Real := p.conjExponent
  have hpq : p.HolderConjugate q := by
    dsimp only [q]
    exact Real.HolderConjugate.conjExponent hp
  have hone : AEMeasurable (fun _ : Real => (1 : ENNReal)) (volume.restrict A) :=
    measurable_const.aemeasurable
  have hf' : AEMeasurable f (volume.restrict A) := hf.aemeasurable
  have hholder := ENNReal.lintegral_mul_le_Lp_mul_Lq
    (volume.restrict A) hpq.symm hone hf'
  have hbase : (∫⁻ s in A, f s) ≤
      (volume A) ^ q⁻¹ * (∫⁻ s in A, (f s) ^ p) ^ p⁻¹ := by
    simpa using hholder
  have hp0 : 0 ≤ p := le_trans zero_le_one hp.le
  have hqexp : q⁻¹ * p = p - 1 := by
    calc
      q⁻¹ * p = p / q := by
        simp only [div_eq_mul_inv]
        ring
      _ = p - 1 := hpq.div_conj_eq_sub_one
  calc
    (∫⁻ s in A, f s) ^ p ≤
        ((volume A) ^ q⁻¹ * (∫⁻ s in A, (f s) ^ p) ^ p⁻¹) ^ p :=
      ENNReal.rpow_le_rpow hbase hp0
    _ = (volume A) ^ (p - 1) * ∫⁻ s in A, (f s) ^ p := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ hp0,
        ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
        hqexp, inv_mul_cancel₀ hpq.left_pos.ne', ENNReal.rpow_one]

/-- The literal Hölder step used on one far source annulus in BRRS (5.5).
If a nonnegative phase kernel is uniformly bounded by `B` on the annulus,
then its weighted source integral has the stated `L^p` control.  This is
kept in restricted-integral form because the next source calculation applies
it separately for each time and output radius. -/
theorem brrsSectionFive_farAnnulus_holder_bound
    {p : Real} (hp : 1 < p) {A : Set Real} (hA : MeasurableSet A)
    {K f : Real → ENNReal} (hf : Measurable f) (B : ENNReal)
    (hB : ∀ s ∈ A, K s ≤ B) :
    (∫⁻ s in A, K s * f s) ^ p ≤
      B ^ p * (volume A) ^ (p - 1) * ∫⁻ s in A, (f s) ^ p := by
  have hp0 : 0 ≤ p := le_trans zero_le_one hp.le
  have hpoint : (∫⁻ s in A, K s * f s) ≤ B * ∫⁻ s in A, f s := by
    calc
      (∫⁻ s in A, K s * f s) ≤ ∫⁻ s in A, B * f s := by
        apply setLIntegral_mono' hA
        intro s hs
        exact mul_le_mul' (hB s hs) le_rfl
      _ = B * ∫⁻ s in A, f s :=
        lintegral_const_mul B hf
  calc
    (∫⁻ s in A, K s * f s) ^ p ≤
        (B * ∫⁻ s in A, f s) ^ p :=
      ENNReal.rpow_le_rpow hpoint hp0
    _ = B ^ p * (∫⁻ s in A, f s) ^ p :=
      ENNReal.mul_rpow_of_nonneg _ _ hp0
    _ ≤ B ^ p * ((volume A) ^ (p - 1) * ∫⁻ s in A, (f s) ^ p) :=
      mul_le_mul_right (brrs_lintegral_restrict_rpow_le hp hA hf) (B ^ p)
    _ = B ^ p * (volume A) ^ (p - 1) * ∫⁻ s in A, (f s) ^ p := by
      ring

/-- Pointwise Hölder control of a positive finite profile convolution at an
arbitrary exponent strictly larger than one. -/
theorem brrsOneDimProfileConvolution_rpow_le
    {omega f : Real → ENNReal} {p : Real} (hp : 1 < p)
    (homega : Measurable omega) (hf : Measurable f)
    (homega_pos : ∀ u : Real, 0 < omega u)
    (homega_top : ∀ u : Real, omega u ≠ ∞) (x : Real) :
    (brrsOneDimProfileConvolution omega f x) ^ p ≤
      (∫⁻ u : Real, omega u) ^ (p - 1) *
        brrsOneDimProfileConvolution omega (fun s : Real => (f s) ^ p) x := by
  have hp_nonneg : 0 ≤ p := le_trans zero_le_one hp.le
  let q : Real := p.conjExponent
  have hpq : p.HolderConjugate q := by
    dsimp only [q]
    exact Real.HolderConjugate.conjExponent hp
  let a : Real → ENNReal := fun s => omega (x - s) ^ q⁻¹
  let b : Real → ENNReal := fun s => omega (x - s) ^ p⁻¹ * f s
  have hshift : Measurable (fun s : Real => omega (x - s)) :=
    homega.comp (measurable_const.sub measurable_id)
  have ha : AEMeasurable a volume := by
    exact (ENNReal.continuous_rpow_const.measurable.comp hshift).aemeasurable
  have hb : AEMeasurable b volume := by
    exact ((ENNReal.continuous_rpow_const.measurable.comp hshift).mul hf).aemeasurable
  have hprod : ∀ s : Real, a s * b s = omega (x - s) * f s := by
    intro s
    dsimp only [a, b]
    rw [show omega (x - s) ^ q⁻¹ * (omega (x - s) ^ p⁻¹ * f s) =
          (omega (x - s) ^ q⁻¹ * omega (x - s) ^ p⁻¹) * f s by ring,
      ← ENNReal.rpow_add _ _ (ne_of_gt (homega_pos _)) (homega_top _)]
    rw [show q⁻¹ + p⁻¹ = 1 by
      rw [add_comm]
      exact hpq.inv_add_inv_eq_one, ENNReal.rpow_one]
  have hA : (∫⁻ s : Real, (a s) ^ q) = ∫⁻ u : Real, omega u := by
    calc
      (∫⁻ s : Real, (a s) ^ q) = ∫⁻ s : Real, omega (x - s) := by
        apply lintegral_congr
        intro s
        dsimp only [a]
        rw [← ENNReal.rpow_mul, inv_mul_cancel₀ hpq.right_pos.ne', ENNReal.rpow_one]
      _ = ∫⁻ u : Real, omega u := lintegral_sub_left_eq_self omega x
  have hB : (∫⁻ s : Real, (b s) ^ p) =
      brrsOneDimProfileConvolution omega (fun s : Real => (f s) ^ p) x := by
    unfold brrsOneDimProfileConvolution
    apply lintegral_congr
    intro s
    dsimp only [b]
    rw [ENNReal.mul_rpow_of_nonneg _ _ hp_nonneg, ← ENNReal.rpow_mul,
      inv_mul_cancel₀ hpq.left_pos.ne', ENNReal.rpow_one]
  have hholder := ENNReal.lintegral_mul_le_Lp_mul_Lq volume hpq.symm ha hb
  have hbase : brrsOneDimProfileConvolution omega f x ≤
      (∫⁻ u : Real, omega u) ^ q⁻¹ *
        (brrsOneDimProfileConvolution omega (fun s : Real => (f s) ^ p) x) ^ p⁻¹ := by
    calc
      brrsOneDimProfileConvolution omega f x = ∫⁻ s : Real, a s * b s := by
        unfold brrsOneDimProfileConvolution
        apply lintegral_congr
        intro s
        exact (hprod s).symm
      _ ≤ (∫⁻ s : Real, (a s) ^ q) ^ (1 / q) *
          (∫⁻ s : Real, (b s) ^ p) ^ (1 / p) := hholder
      _ = (∫⁻ u : Real, omega u) ^ q⁻¹ *
          (brrsOneDimProfileConvolution omega (fun s : Real => (f s) ^ p) x) ^ p⁻¹ := by
        rw [hA, hB]
        simp only [one_div]
  have hqexp : q⁻¹ * p = p - 1 := by
    calc
      q⁻¹ * p = p / q := by
        simp only [div_eq_mul_inv]
        ring
      _ = p - 1 := hpq.div_conj_eq_sub_one
  calc
    (brrsOneDimProfileConvolution omega f x) ^ p ≤
        ((∫⁻ u : Real, omega u) ^ q⁻¹ *
          (brrsOneDimProfileConvolution omega
            (fun s : Real => (f s) ^ p) x) ^ p⁻¹) ^ p :=
      ENNReal.rpow_le_rpow hbase hp_nonneg
    _ = (∫⁻ u : Real, omega u) ^ (p - 1) *
        brrsOneDimProfileConvolution omega (fun s : Real => (f s) ^ p) x := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ hp_nonneg,
        ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
        hqexp, inv_mul_cancel₀ hpq.left_pos.ne', ENNReal.rpow_one]

/-- The global positive `Lᵖ` Young inequality for the Section 5 profile
convolution, derived from the preceding pointwise Hölder estimate and
Tonelli.  The profile mass assumptions are exactly the meaning of a positive
integrable profile in this ENNReal formulation. -/
theorem lintegral_brrsOneDimProfileConvolution_rpow_le
    {omega f : Real → ENNReal} {p : Real} (hp : 1 < p)
    (homega : Measurable omega) (hf : Measurable f)
    (homega_pos : ∀ u : Real, 0 < omega u)
    (homega_top : ∀ u : Real, omega u ≠ ∞)
    (hmass_pos : 0 < ∫⁻ u : Real, omega u)
    (hmass_top : (∫⁻ u : Real, omega u) ≠ ∞) :
    (∫⁻ x : Real, (brrsOneDimProfileConvolution omega f x) ^ p) ≤
      (∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p := by
  have hfp : Measurable (fun s : Real => (f s) ^ p) :=
    ENNReal.continuous_rpow_const.measurable.comp hf
  have hconv : Measurable
      (brrsOneDimProfileConvolution omega (fun s : Real => (f s) ^ p)) :=
    measurable_brrsOneDimProfileConvolution homega hfp
  calc
    (∫⁻ x : Real, (brrsOneDimProfileConvolution omega f x) ^ p) ≤
        ∫⁻ x : Real, (∫⁻ u : Real, omega u) ^ (p - 1) *
          brrsOneDimProfileConvolution omega (fun s : Real => (f s) ^ p) x := by
      apply lintegral_mono
      intro x
      exact brrsOneDimProfileConvolution_rpow_le
        hp homega hf homega_pos homega_top x
    _ = (∫⁻ u : Real, omega u) ^ (p - 1) *
          ∫⁻ x : Real,
            brrsOneDimProfileConvolution omega (fun s : Real => (f s) ^ p) x :=
      lintegral_const_mul _ hconv
    _ = (∫⁻ u : Real, omega u) ^ (p - 1) *
          ((∫⁻ u : Real, omega u) * ∫⁻ s : Real, (f s) ^ p) := by
      rw [lintegral_brrsOneDimProfileConvolution_eq_mul homega hfp]
    _ = (∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p := by
      calc
        (∫⁻ u : Real, omega u) ^ (p - 1) *
            ((∫⁻ u : Real, omega u) * ∫⁻ s : Real, (f s) ^ p) =
            ((∫⁻ u : Real, omega u) ^ (p - 1) * ∫⁻ u : Real, omega u) *
              ∫⁻ s : Real, (f s) ^ p := by ring
        _ = (∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p := by
          calc
            ((∫⁻ u : Real, omega u) ^ (p - 1) * ∫⁻ u : Real, omega u) *
                ∫⁻ s : Real, (f s) ^ p =
                ((∫⁻ u : Real, omega u) ^ (p - 1) *
                    (∫⁻ u : Real, omega u) ^ (1 : Real)) *
                  ∫⁻ s : Real, (f s) ^ p := by
                    rw [ENNReal.rpow_one]
            _ = (∫⁻ u : Real, omega u) ^ ((p - 1) + 1) *
                  ∫⁻ s : Real, (f s) ^ p := by
                    rw [← ENNReal.rpow_add _ _ (ne_of_gt hmass_pos) hmass_top]
            _ = (∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p := by
                    congr 2
                    ring

/-- Reflection also preserves every nonnegative `Lᵖ` moment of a phase-line
profile.  This is the measure-theoretic part of converting the `+s` wave
sign into the standard convolution convention. -/
theorem lintegral_brrsReflectProfile_rpow_eq
    (f : Real → ENNReal) (p : Real) :
    (∫⁻ s : Real, (brrsReflectProfile f s) ^ p) =
      ∫⁻ s : Real, (f s) ^ p := by
  unfold brrsReflectProfile
  exact lintegral_neg_eq_self (fun s : Real => (f s) ^ p)

/-- The global positive `Lᵖ` Young inequality for the `+s` phase convention.
It is obtained exactly by reflecting the input, with no loss in its norm or
the profile mass. -/
theorem lintegral_brrsOneDimProfileConvolutionPlus_rpow_le
    {omega f : Real → ENNReal} {p : Real} (hp : 1 < p)
    (homega : Measurable omega) (hf : Measurable f)
    (homega_pos : ∀ u : Real, 0 < omega u)
    (homega_top : ∀ u : Real, omega u ≠ ∞)
    (hmass_pos : 0 < ∫⁻ u : Real, omega u)
    (hmass_top : (∫⁻ u : Real, omega u) ≠ ∞) :
    (∫⁻ x : Real, (brrsOneDimProfileConvolutionPlus omega f x) ^ p) ≤
      (∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p := by
  have hrewrite :
      (∫⁻ x : Real, (brrsOneDimProfileConvolutionPlus omega f x) ^ p) =
        ∫⁻ x : Real,
          (brrsOneDimProfileConvolution omega (brrsReflectProfile f) x) ^ p := by
    apply lintegral_congr
    intro x
    rw [brrsOneDimProfileConvolutionPlus_eq_reflect]
  calc
    (∫⁻ x : Real, (brrsOneDimProfileConvolutionPlus omega f x) ^ p) =
        ∫⁻ x : Real,
          (brrsOneDimProfileConvolution omega (brrsReflectProfile f) x) ^ p := hrewrite
    _ ≤ (∫⁻ u : Real, omega u) ^ p *
          ∫⁻ s : Real, (brrsReflectProfile f s) ^ p :=
      lintegral_brrsOneDimProfileConvolution_rpow_le hp homega
        (measurable_brrsReflectProfile hf) homega_pos homega_top hmass_pos hmass_top
    _ = (∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p := by
      rw [lintegral_brrsReflectProfile_rpow_eq]

/-! ### Exterior radial weighted Young estimates

The fixed-time exterior estimate for radial half-waves has a different
geometry from the compact Section 5 decomposition: the output radius is
bounded below, while the source radius ranges over the whole positive
half-line.  The exact polar normalization leaves the factor `(s / r)^σ`.
On `r ≥ 16` it can be absorbed into one polynomially weighted phase-line
kernel, uniformly for all four signs.  The following lemmas isolate that
one-dimensional fact; they do not assert an exterior half-wave bound, whose
kernel reduction still has to account for every radial region.
-/

/-- The phase-line kernel after absorbing the exact exterior radial ratio.
The factor is chosen so that every phase `t ± r ± s`, with `r ≥ 16` and
`t ∈ [1,2]`, dominates `(s / r)^σ` on the positive source half-line. -/
noncomputable def brrsExteriorAbsorbedKernel
    (sigma : Real) (omega : Real → ENNReal) : Real → ENNReal :=
  fun u => (ENNReal.ofReal (2 * (1 + |u|))) ^ sigma * omega u

/-- Measurability of the exterior-weighted phase kernel. -/
theorem measurable_brrsExteriorAbsorbedKernel
    (sigma : Real) {omega : Real → ENNReal} (homega : Measurable omega) :
    Measurable (brrsExteriorAbsorbedKernel sigma omega) := by
  unfold brrsExteriorAbsorbedKernel
  apply (ENNReal.continuous_rpow_const.measurable.comp
    (ENNReal.continuous_ofReal.measurable.comp ?_)).mul homega
  exact measurable_const.mul (measurable_const.add continuous_abs.measurable)

/-- The exact exterior radial ratio is pointwise absorbed by the weighted
phase-line kernel.  This is the common algebraic step for all four travelling
phases. -/
theorem brrs_exterior_ratioWeight_mul_le_absorbedKernel
    {sigma r s t u : Real} {omega : Real → ENNReal}
    (hsigma : 0 ≤ sigma) (_hs : 0 ≤ s) (hr : 16 ≤ r)
    (ht : t ∈ Icc (1 : Real) 2)
    (hphase : s ≤ t + r + |u|) :
    (ENNReal.ofReal (s / r)) ^ sigma * omega u ≤
      brrsExteriorAbsorbedKernel sigma omega u := by
  unfold brrsExteriorAbsorbedKernel
  exact mul_le_mul'
    (ENNReal.rpow_le_rpow
      (ENNReal.ofReal_le_ofReal
        (brrs_radiusRatio_le_two_mul_one_add_abs_of_phase r s t u hr ht hphase))
      hsigma)
    le_rfl

/-- The `t-r-s` exterior phase is bounded by an ordinary translated
convolution with the absorbed kernel. -/
theorem brrs_exterior_weighted_sub_sub_le_convolution
    {sigma t r : Real} {omega f : Real → ENNReal}
    (hsigma : 0 ≤ sigma) (hr : 16 ≤ r) (ht : t ∈ Icc (1 : Real) 2) :
    (∫⁻ s in Ioi (0 : Real),
      (ENNReal.ofReal (s / r)) ^ sigma * omega (t - r - s) * f s) ≤
      brrsOneDimProfileConvolution (brrsExteriorAbsorbedKernel sigma omega) f (t - r) := by
  calc
    (∫⁻ s in Ioi (0 : Real),
        (ENNReal.ofReal (s / r)) ^ sigma * omega (t - r - s) * f s) ≤
        ∫⁻ s in Ioi (0 : Real),
          brrsExteriorAbsorbedKernel sigma omega (t - r - s) * f s := by
      apply setLIntegral_mono' measurableSet_Ioi
      intro s hs
      exact mul_le_mul'
        (brrs_exterior_ratioWeight_mul_le_absorbedKernel hsigma hs.le hr ht
          (brrs_sourceRadius_le_time_add_output_add_abs_sub_sub r s t
            (le_trans (by norm_num) hr)))
        le_rfl
    _ ≤ ∫⁻ s : Real,
          brrsExteriorAbsorbedKernel sigma omega ((t - r) - s) * f s :=
      setLIntegral_le_lintegral _ _
    _ = brrsOneDimProfileConvolution (brrsExteriorAbsorbedKernel sigma omega) f
          (t - r) := by
      rfl

/-- The `t-r+s` exterior phase is bounded by the reflected-source
convolution with the absorbed kernel. -/
theorem brrs_exterior_weighted_sub_add_le_convolutionPlus
    {sigma t r : Real} {omega f : Real → ENNReal}
    (hsigma : 0 ≤ sigma) (hr : 16 ≤ r) (ht : t ∈ Icc (1 : Real) 2) :
    (∫⁻ s in Ioi (0 : Real),
      (ENNReal.ofReal (s / r)) ^ sigma * omega (t - r + s) * f s) ≤
      brrsOneDimProfileConvolutionPlus (brrsExteriorAbsorbedKernel sigma omega) f (t - r) := by
  calc
    (∫⁻ s in Ioi (0 : Real),
        (ENNReal.ofReal (s / r)) ^ sigma * omega (t - r + s) * f s) ≤
        ∫⁻ s in Ioi (0 : Real),
          brrsExteriorAbsorbedKernel sigma omega (t - r + s) * f s := by
      apply setLIntegral_mono' measurableSet_Ioi
      intro s hs
      exact mul_le_mul'
        (brrs_exterior_ratioWeight_mul_le_absorbedKernel hsigma hs.le hr ht
          (brrs_sourceRadius_le_time_add_output_add_abs_sub_add r s t
            (le_trans (by norm_num) ht.1)))
        le_rfl
    _ ≤ ∫⁻ s : Real,
          brrsExteriorAbsorbedKernel sigma omega ((t - r) + s) * f s :=
      setLIntegral_le_lintegral _ _
    _ = brrsOneDimProfileConvolutionPlus (brrsExteriorAbsorbedKernel sigma omega) f
          (t - r) := by
      rfl

/-- The `t+r-s` exterior phase is bounded by an ordinary translated
convolution with the absorbed kernel. -/
theorem brrs_exterior_weighted_add_sub_le_convolution
    {sigma t r : Real} {omega f : Real → ENNReal}
    (hsigma : 0 ≤ sigma) (hr : 16 ≤ r) (ht : t ∈ Icc (1 : Real) 2) :
    (∫⁻ s in Ioi (0 : Real),
      (ENNReal.ofReal (s / r)) ^ sigma * omega (t + r - s) * f s) ≤
      brrsOneDimProfileConvolution (brrsExteriorAbsorbedKernel sigma omega) f (t + r) := by
  calc
    (∫⁻ s in Ioi (0 : Real),
        (ENNReal.ofReal (s / r)) ^ sigma * omega (t + r - s) * f s) ≤
        ∫⁻ s in Ioi (0 : Real),
          brrsExteriorAbsorbedKernel sigma omega (t + r - s) * f s := by
      apply setLIntegral_mono' measurableSet_Ioi
      intro s hs
      exact mul_le_mul'
        (brrs_exterior_ratioWeight_mul_le_absorbedKernel hsigma hs.le hr ht
          (brrs_sourceRadius_le_time_add_output_add_abs_add_sub r s t))
        le_rfl
    _ ≤ ∫⁻ s : Real,
          brrsExteriorAbsorbedKernel sigma omega ((t + r) - s) * f s :=
      setLIntegral_le_lintegral _ _
    _ = brrsOneDimProfileConvolution (brrsExteriorAbsorbedKernel sigma omega) f
          (t + r) := by
      rfl

/-- The `t+r+s` exterior phase is bounded by the reflected-source
convolution with the absorbed kernel. -/
theorem brrs_exterior_weighted_add_add_le_convolutionPlus
    {sigma t r : Real} {omega f : Real → ENNReal}
    (hsigma : 0 ≤ sigma) (hr : 16 ≤ r) (ht : t ∈ Icc (1 : Real) 2) :
    (∫⁻ s in Ioi (0 : Real),
      (ENNReal.ofReal (s / r)) ^ sigma * omega (t + r + s) * f s) ≤
      brrsOneDimProfileConvolutionPlus (brrsExteriorAbsorbedKernel sigma omega) f (t + r) := by
  calc
    (∫⁻ s in Ioi (0 : Real),
        (ENNReal.ofReal (s / r)) ^ sigma * omega (t + r + s) * f s) ≤
        ∫⁻ s in Ioi (0 : Real),
          brrsExteriorAbsorbedKernel sigma omega (t + r + s) * f s := by
      apply setLIntegral_mono' measurableSet_Ioi
      intro s hs
      exact mul_le_mul'
        (brrs_exterior_ratioWeight_mul_le_absorbedKernel hsigma hs.le hr ht
          (brrs_sourceRadius_le_time_add_output_add_abs_add_add r s t
            (le_trans (by norm_num) hr) (le_trans (by norm_num) ht.1)))
        le_rfl
    _ ≤ ∫⁻ s : Real,
          brrsExteriorAbsorbedKernel sigma omega ((t + r) + s) * f s :=
      setLIntegral_le_lintegral _ _
    _ = brrsOneDimProfileConvolutionPlus (brrsExteriorAbsorbedKernel sigma omega) f
          (t + r) := by
      rfl

/-- The phasewise aggregate of the four exact travelling-phase `Lᵖ` moments
on the exterior radial region.  It is deliberately a sum of the four
individual moments; passing from a pointwise sum of phases to this block
requires the separate convexity factor.  The source is restricted to the
physical half-line, but no compact source cutoff is imposed. -/
noncomputable def brrsExteriorWeightedFourPhaseBlock
    (sigma p t : Real) (omega f : Real → ENNReal) : ENNReal :=
  (∫⁻ r in Ici (16 : Real),
    (∫⁻ s in Ioi (0 : Real),
      (ENNReal.ofReal (s / r)) ^ sigma * omega (t - r - s) * f s) ^ p) +
  (∫⁻ r in Ici (16 : Real),
    (∫⁻ s in Ioi (0 : Real),
      (ENNReal.ofReal (s / r)) ^ sigma * omega (t - r + s) * f s) ^ p) +
  (∫⁻ r in Ici (16 : Real),
    (∫⁻ s in Ioi (0 : Real),
      (ENNReal.ofReal (s / r)) ^ sigma * omega (t + r - s) * f s) ^ p) +
  ∫⁻ r in Ici (16 : Real),
    (∫⁻ s in Ioi (0 : Real),
      (ENNReal.ofReal (s / r)) ^ sigma * omega (t + r + s) * f s) ^ p

/-- A positive `L¹` phase-line kernel controls all four exact exterior radial
phases by the same one-dimensional Young constant.  This is the reusable
analytic core needed for the fixed-time radial exterior estimate: it covers
both compact and arbitrarily large source radii, but deliberately makes no
claim yet about the half-wave kernel itself. -/
theorem brrsExteriorWeightedFourPhaseBlock_rpow_le
    {sigma p t : Real} {omega f : Real → ENNReal}
    (hsigma : 0 ≤ sigma) (hp : 1 < p) (ht : t ∈ Icc (1 : Real) 2)
    (hOmega : Measurable (brrsExteriorAbsorbedKernel sigma omega))
    (hf : Measurable f)
    (hOmega_pos : ∀ u : Real, 0 < brrsExteriorAbsorbedKernel sigma omega u)
    (hOmega_top : ∀ u : Real, brrsExteriorAbsorbedKernel sigma omega u ≠ ∞)
    (hmass_pos : 0 < ∫⁻ u : Real, brrsExteriorAbsorbedKernel sigma omega u)
    (hmass_top : (∫⁻ u : Real, brrsExteriorAbsorbedKernel sigma omega u) ≠ ∞) :
    brrsExteriorWeightedFourPhaseBlock sigma p t omega f ≤
      4 * ((∫⁻ u : Real, brrsExteriorAbsorbedKernel sigma omega u) ^ p *
        ∫⁻ s : Real, (f s) ^ p) := by
  let Omega : Real → ENNReal := brrsExteriorAbsorbedKernel sigma omega
  let A : ENNReal := (∫⁻ u : Real, Omega u) ^ p * ∫⁻ s : Real, (f s) ^ p
  have hp0 : 0 ≤ p := le_trans zero_le_one hp.le
  have hminusYoung :
      (∫⁻ x : Real, (brrsOneDimProfileConvolution Omega f x) ^ p) ≤ A := by
    dsimp only [A]
    exact lintegral_brrsOneDimProfileConvolution_rpow_le hp
      (by simpa only [Omega] using hOmega) hf
      (by simpa only [Omega] using hOmega_pos)
      (by simpa only [Omega] using hOmega_top)
      (by simpa only [Omega] using hmass_pos)
      (by simpa only [Omega] using hmass_top)
  have hplusYoung :
      (∫⁻ x : Real, (brrsOneDimProfileConvolutionPlus Omega f x) ^ p) ≤ A := by
    dsimp only [A]
    exact lintegral_brrsOneDimProfileConvolutionPlus_rpow_le hp
      (by simpa only [Omega] using hOmega) hf
      (by simpa only [Omega] using hOmega_pos)
      (by simpa only [Omega] using hOmega_top)
      (by simpa only [Omega] using hmass_pos)
      (by simpa only [Omega] using hmass_top)
  have hsubsub :
      (∫⁻ r in Ici (16 : Real),
        (∫⁻ s in Ioi (0 : Real),
          (ENNReal.ofReal (s / r)) ^ sigma * omega (t - r - s) * f s) ^ p) ≤ A := by
    calc
      (∫⁻ r in Ici (16 : Real),
        (∫⁻ s in Ioi (0 : Real),
          (ENNReal.ofReal (s / r)) ^ sigma * omega (t - r - s) * f s) ^ p) ≤
          ∫⁻ r in Ici (16 : Real),
            (brrsOneDimProfileConvolution Omega f (t - r)) ^ p := by
        apply setLIntegral_mono' measurableSet_Ici
        intro r hr
        exact ENNReal.rpow_le_rpow
          (by
            dsimp only [Omega]
            exact brrs_exterior_weighted_sub_sub_le_convolution hsigma hr ht)
          hp0
      _ ≤ ∫⁻ r : Real, (brrsOneDimProfileConvolution Omega f (t - r)) ^ p :=
        setLIntegral_le_lintegral _ _
      _ = ∫⁻ x : Real, (brrsOneDimProfileConvolution Omega f x) ^ p := by
        rw [lintegral_sub_left_eq_self
          (fun x : Real => (brrsOneDimProfileConvolution Omega f x) ^ p) t]
      _ ≤ A := hminusYoung
  have hsubadd :
      (∫⁻ r in Ici (16 : Real),
        (∫⁻ s in Ioi (0 : Real),
          (ENNReal.ofReal (s / r)) ^ sigma * omega (t - r + s) * f s) ^ p) ≤ A := by
    calc
      (∫⁻ r in Ici (16 : Real),
        (∫⁻ s in Ioi (0 : Real),
          (ENNReal.ofReal (s / r)) ^ sigma * omega (t - r + s) * f s) ^ p) ≤
          ∫⁻ r in Ici (16 : Real),
            (brrsOneDimProfileConvolutionPlus Omega f (t - r)) ^ p := by
        apply setLIntegral_mono' measurableSet_Ici
        intro r hr
        exact ENNReal.rpow_le_rpow
          (by
            dsimp only [Omega]
            exact brrs_exterior_weighted_sub_add_le_convolutionPlus hsigma hr ht)
          hp0
      _ ≤ ∫⁻ r : Real, (brrsOneDimProfileConvolutionPlus Omega f (t - r)) ^ p :=
        setLIntegral_le_lintegral _ _
      _ = ∫⁻ x : Real, (brrsOneDimProfileConvolutionPlus Omega f x) ^ p := by
        rw [lintegral_sub_left_eq_self
          (fun x : Real => (brrsOneDimProfileConvolutionPlus Omega f x) ^ p) t]
      _ ≤ A := hplusYoung
  have haddsub :
      (∫⁻ r in Ici (16 : Real),
        (∫⁻ s in Ioi (0 : Real),
          (ENNReal.ofReal (s / r)) ^ sigma * omega (t + r - s) * f s) ^ p) ≤ A := by
    calc
      (∫⁻ r in Ici (16 : Real),
        (∫⁻ s in Ioi (0 : Real),
          (ENNReal.ofReal (s / r)) ^ sigma * omega (t + r - s) * f s) ^ p) ≤
          ∫⁻ r in Ici (16 : Real),
            (brrsOneDimProfileConvolution Omega f (t + r)) ^ p := by
        apply setLIntegral_mono' measurableSet_Ici
        intro r hr
        exact ENNReal.rpow_le_rpow
          (by
            dsimp only [Omega]
            exact brrs_exterior_weighted_add_sub_le_convolution hsigma hr ht)
          hp0
      _ ≤ ∫⁻ r : Real, (brrsOneDimProfileConvolution Omega f (t + r)) ^ p :=
        setLIntegral_le_lintegral _ _
      _ = ∫⁻ x : Real, (brrsOneDimProfileConvolution Omega f x) ^ p := by
        rw [lintegral_add_left_eq_self
          (fun x : Real => (brrsOneDimProfileConvolution Omega f x) ^ p) t]
      _ ≤ A := hminusYoung
  have haddadd :
      (∫⁻ r in Ici (16 : Real),
        (∫⁻ s in Ioi (0 : Real),
          (ENNReal.ofReal (s / r)) ^ sigma * omega (t + r + s) * f s) ^ p) ≤ A := by
    calc
      (∫⁻ r in Ici (16 : Real),
        (∫⁻ s in Ioi (0 : Real),
          (ENNReal.ofReal (s / r)) ^ sigma * omega (t + r + s) * f s) ^ p) ≤
          ∫⁻ r in Ici (16 : Real),
            (brrsOneDimProfileConvolutionPlus Omega f (t + r)) ^ p := by
        apply setLIntegral_mono' measurableSet_Ici
        intro r hr
        exact ENNReal.rpow_le_rpow
          (by
            dsimp only [Omega]
            exact brrs_exterior_weighted_add_add_le_convolutionPlus hsigma hr ht)
          hp0
      _ ≤ ∫⁻ r : Real, (brrsOneDimProfileConvolutionPlus Omega f (t + r)) ^ p :=
        setLIntegral_le_lintegral _ _
      _ = ∫⁻ x : Real, (brrsOneDimProfileConvolutionPlus Omega f x) ^ p := by
        rw [lintegral_add_left_eq_self
          (fun x : Real => (brrsOneDimProfileConvolutionPlus Omega f x) ^ p) t]
      _ ≤ A := hplusYoung
  change _ + _ + _ + _ ≤ _
  calc
    _ ≤ A + A + A + A := add_le_add (add_le_add (add_le_add hsubsub hsubadd) haddsub) haddadd
    _ = 4 * A := by ring
    _ = 4 * ((∫⁻ u : Real, brrsExteriorAbsorbedKernel sigma omega u) ^ p *
        ∫⁻ s : Real, (f s) ^ p) := by rfl

/-- The outgoing weighted radial-block estimate in the precise `Lᵖ` form
used in BRRS (5.4), once the positive integrable profile is supplied. -/
theorem brrs_sum_mainCell_add_weighted_profileConvolution_rpow_le_global
    (T : Finset Real) (R : NNReal) (alpha p : Real) (hR : R ≠ 0) (hp : 1 < p)
    (W omega f : Real → ENNReal)
    (homega : Measurable omega) (hf : Measurable f)
    (homega_pos : ∀ u : Real, 0 < omega u)
    (homega_top : ∀ u : Real, omega u ≠ ∞)
    (hmass_pos : 0 < ∫⁻ u : Real, omega u)
    (hmass_top : (∫⁻ u : Real, omega u) ≠ ∞)
    (hW : ∀ r ∈ Icc (R : Real) (2 * (R : Real)),
      W r ≤ (R : ENNReal) ^ (-alpha)) :
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * (brrsOneDimProfileConvolution omega f (t + r)) ^ p) ≤
      7 * brrsKappa T R alpha *
        ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by
  calc
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * (brrsOneDimProfileConvolution omega f (t + r)) ^ p) ≤
        7 * brrsKappa T R alpha *
          ∫⁻ x : Real, (brrsOneDimProfileConvolution omega f x) ^ p :=
      brrs_sum_mainCell_add_weighted_profileConvolution_rpow_le
        T R alpha p hR W omega f homega hf hW
    _ ≤ 7 * brrsKappa T R alpha *
          ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) :=
      mul_le_mul_right
        (lintegral_brrsOneDimProfileConvolution_rpow_le
          hp homega hf homega_pos homega_top hmass_pos hmass_top)
        (7 * brrsKappa T R alpha)

/-- The reflected weighted radial-block `Lᵖ` estimate corresponding to the
other outer sign in BRRS (5.4). -/
theorem brrs_sum_mainCell_sub_weighted_profileConvolution_rpow_le_global
    (T : Finset Real) (R : NNReal) (alpha p : Real) (hR : R ≠ 0) (hp : 1 < p)
    (W omega f : Real → ENNReal)
    (homega : Measurable omega) (hf : Measurable f)
    (homega_pos : ∀ u : Real, 0 < omega u)
    (homega_top : ∀ u : Real, omega u ≠ ∞)
    (hmass_pos : 0 < ∫⁻ u : Real, omega u)
    (hmass_top : (∫⁻ u : Real, omega u) ≠ ∞)
    (hW : ∀ r ∈ Icc (R : Real) (2 * (R : Real)),
      W r ≤ (R : ENNReal) ^ (-alpha)) :
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * (brrsOneDimProfileConvolution omega f (t - r)) ^ p) ≤
      7 * brrsKappa T R alpha *
        ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by
  calc
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * (brrsOneDimProfileConvolution omega f (t - r)) ^ p) ≤
        7 * brrsKappa T R alpha *
          ∫⁻ x : Real, (brrsOneDimProfileConvolution omega f x) ^ p :=
      brrs_sum_mainCell_sub_weighted_profileConvolution_rpow_le
        T R alpha p hR W omega f homega hf hW
    _ ≤ 7 * brrsKappa T R alpha *
          ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) :=
      mul_le_mul_right
        (lintegral_brrsOneDimProfileConvolution_rpow_le
          hp homega hf homega_pos homega_top hmass_pos hmass_top)
        (7 * brrsKappa T R alpha)

/-- The rapid cubic profile used in the radial-kernel reduction is strictly
positive at every point.  This makes it an immediate concrete input to the
Section 5 Young/block package above. -/
theorem brrsCubicJapaneseProfile_pos (u : Real) :
    0 < brrsCubicJapaneseProfile u := by
  rw [brrsCubicJapaneseProfile, ENNReal.ofReal_pos]
  positivity

/-- The cubic rapid profile is finite pointwise. -/
theorem brrsCubicJapaneseProfile_ne_top (u : Real) :
    brrsCubicJapaneseProfile u ≠ ∞ := by
  simp only [brrsCubicJapaneseProfile]
  exact ENNReal.ofReal_ne_top

/-- The cubic rapid profile has nonzero phase-line mass. -/
theorem lintegral_brrsCubicJapaneseProfile_pos :
    0 < ∫⁻ u : Real, brrsCubicJapaneseProfile u := by
  rw [lintegral_pos_iff_support measurable_brrsCubicJapaneseProfile]
  have hsupport : Function.support brrsCubicJapaneseProfile = Set.univ := by
    ext u
    simp only [Function.mem_support, Set.mem_univ, iff_true]
    exact (brrsCubicJapaneseProfile_pos u).ne'
  rw [hsupport]
  simp

/-- A fully concrete outgoing instance of the Section 5 weighted block
estimate, using the rapidly decaying cubic profile already employed by the
radial kernel construction. -/
theorem brrs_sum_mainCell_add_weighted_cubicProfileConvolution_rpow_le
    (T : Finset Real) (R : NNReal) (alpha p : Real) (hR : R ≠ 0) (hp : 1 < p)
    (W f : Real → ENNReal) (hf : Measurable f)
    (hW : ∀ r ∈ Icc (R : Real) (2 * (R : Real)),
      W r ≤ (R : ENNReal) ^ (-alpha)) :
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * (brrsOneDimProfileConvolution brrsCubicJapaneseProfile f (t + r)) ^ p) ≤
      7 * brrsKappa T R alpha *
        ((∫⁻ u : Real, brrsCubicJapaneseProfile u) ^ p *
          ∫⁻ s : Real, (f s) ^ p) := by
  exact brrs_sum_mainCell_add_weighted_profileConvolution_rpow_le_global
    T R alpha p hR hp W brrsCubicJapaneseProfile f
    measurable_brrsCubicJapaneseProfile hf brrsCubicJapaneseProfile_pos
    brrsCubicJapaneseProfile_ne_top lintegral_brrsCubicJapaneseProfile_pos
    lintegral_brrsCubicJapaneseProfile_ne_top hW

/-- The matching incoming concrete cubic-profile instance. -/
theorem brrs_sum_mainCell_sub_weighted_cubicProfileConvolution_rpow_le
    (T : Finset Real) (R : NNReal) (alpha p : Real) (hR : R ≠ 0) (hp : 1 < p)
    (W f : Real → ENNReal) (hf : Measurable f)
    (hW : ∀ r ∈ Icc (R : Real) (2 * (R : Real)),
      W r ≤ (R : ENNReal) ^ (-alpha)) :
    (∑ t ∈ T, ∫⁻ r in Icc (R : Real) (2 * (R : Real)),
      W r * (brrsOneDimProfileConvolution brrsCubicJapaneseProfile f (t - r)) ^ p) ≤
      7 * brrsKappa T R alpha *
        ((∫⁻ u : Real, brrsCubicJapaneseProfile u) ^ p *
          ∫⁻ s : Real, (f s) ^ p) := by
  exact brrs_sum_mainCell_sub_weighted_profileConvolution_rpow_le_global
    T R alpha p hR hp W brrsCubicJapaneseProfile f
    measurable_brrsCubicJapaneseProfile hf brrsCubicJapaneseProfile_pos
    brrsCubicJapaneseProfile_ne_top lintegral_brrsCubicJapaneseProfile_pos
    lintegral_brrsCubicJapaneseProfile_ne_top hW

/-! ### Dyadic summation of the Section 5 radial blocks

The entropy statement controls `κ_{j,m}` uniformly in `m`.  These definitions
and elementary finite-sum lemmas are the literal bridge from the individual
radial block estimates above to the dyadic decomposition in Proposition 5.1.
-/

/-- The physical radial scale attached to the `m`-th BRRS block at frequency
level `j`.  It ranges from the time mesh to the unit scale when `m ≤ j`. -/
noncomputable def brrsDyadicRadialBlockRadius (j m : Nat) : NNReal :=
  ⟨dyadicTimeScale j * (2 : Real) ^ m, by
    unfold dyadicTimeScale
    positivity⟩

/-- Positivity of every dyadic radial block radius. -/
theorem brrsDyadicRadialBlockRadius_pos (j m : Nat) :
    0 < (brrsDyadicRadialBlockRadius j m : Real) := by
  dsimp only [brrsDyadicRadialBlockRadius]
  exact mul_pos (by
    unfold dyadicTimeScale
    positivity) (pow_pos (by norm_num) _)

/-- Every dyadic radial block radius is nonzero. -/
theorem brrsDyadicRadialBlockRadius_ne_zero (j m : Nat) :
    brrsDyadicRadialBlockRadius j m ≠ 0 := by
  intro hzero
  have hzero' : (brrsDyadicRadialBlockRadius j m : Real) = 0 := by
    exact_mod_cast hzero
  exact (brrsDyadicRadialBlockRadius_pos j m).ne' hzero'

/-- `brrsDyadicKappa` is the ordinary local counting coefficient at the
named dyadic radial scale. -/
theorem brrsDyadicKappa_eq_brrsKappa_dyadicRadialBlockRadius
    (T : Finset Real) (j m : Nat) (alpha : Real) :
    brrsDyadicKappa T j m alpha =
      brrsKappa T (brrsDyadicRadialBlockRadius j m) alpha := by
  rfl

/-- The outgoing contribution of one dyadic radial block to the Section 5
profile estimate. -/
noncomputable def brrsDyadicRadialBlockAdd
    (T : Finset Real) (j m : Nat) (p : Real)
    (W omega f : Real → ENNReal) : ENNReal :=
  ∑ t ∈ T, ∫⁻ r in
    Icc (brrsDyadicRadialBlockRadius j m : Real)
      (2 * (brrsDyadicRadialBlockRadius j m : Real)),
    W r * (brrsOneDimProfileConvolution omega f (t + r)) ^ p

/-- The incoming contribution of one dyadic radial block to the Section 5
profile estimate. -/
noncomputable def brrsDyadicRadialBlockSub
    (T : Finset Real) (j m : Nat) (p : Real)
    (W omega f : Real → ENNReal) : ENNReal :=
  ∑ t ∈ T, ∫⁻ r in
    Icc (brrsDyadicRadialBlockRadius j m : Real)
      (2 * (brrsDyadicRadialBlockRadius j m : Real)),
    W r * (brrsOneDimProfileConvolution omega f (t - r)) ^ p

/-- The individual outgoing dyadic block is controlled by the corresponding
`κ_{j,m}` coefficient. -/
theorem brrsDyadicRadialBlockAdd_le_kappa
    (T : Finset Real) (j m : Nat) (alpha p : Real) (hp : 1 < p)
    (W omega f : Real → ENNReal)
    (homega : Measurable omega) (hf : Measurable f)
    (homega_pos : ∀ u : Real, 0 < omega u)
    (homega_top : ∀ u : Real, omega u ≠ ∞)
    (hmass_pos : 0 < ∫⁻ u : Real, omega u)
    (hmass_top : (∫⁻ u : Real, omega u) ≠ ∞)
    (hW : ∀ r ∈ Icc (brrsDyadicRadialBlockRadius j m : Real)
        (2 * (brrsDyadicRadialBlockRadius j m : Real)),
      W r ≤ (brrsDyadicRadialBlockRadius j m : ENNReal) ^ (-alpha)) :
    brrsDyadicRadialBlockAdd T j m p W omega f ≤
      7 * brrsDyadicKappa T j m alpha *
        ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by
  unfold brrsDyadicRadialBlockAdd
  rw [brrsDyadicKappa_eq_brrsKappa_dyadicRadialBlockRadius]
  exact brrs_sum_mainCell_add_weighted_profileConvolution_rpow_le_global
    T (brrsDyadicRadialBlockRadius j m) alpha p
    (brrsDyadicRadialBlockRadius_ne_zero j m) hp W omega f
    homega hf homega_pos homega_top hmass_pos hmass_top hW

/-- The individual incoming dyadic block is controlled by the corresponding
`κ_{j,m}` coefficient. -/
theorem brrsDyadicRadialBlockSub_le_kappa
    (T : Finset Real) (j m : Nat) (alpha p : Real) (hp : 1 < p)
    (W omega f : Real → ENNReal)
    (homega : Measurable omega) (hf : Measurable f)
    (homega_pos : ∀ u : Real, 0 < omega u)
    (homega_top : ∀ u : Real, omega u ≠ ∞)
    (hmass_pos : 0 < ∫⁻ u : Real, omega u)
    (hmass_top : (∫⁻ u : Real, omega u) ≠ ∞)
    (hW : ∀ r ∈ Icc (brrsDyadicRadialBlockRadius j m : Real)
        (2 * (brrsDyadicRadialBlockRadius j m : Real)),
      W r ≤ (brrsDyadicRadialBlockRadius j m : ENNReal) ^ (-alpha)) :
    brrsDyadicRadialBlockSub T j m p W omega f ≤
      7 * brrsDyadicKappa T j m alpha *
        ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by
  unfold brrsDyadicRadialBlockSub
  rw [brrsDyadicKappa_eq_brrsKappa_dyadicRadialBlockRadius]
  exact brrs_sum_mainCell_sub_weighted_profileConvolution_rpow_le_global
    T (brrsDyadicRadialBlockRadius j m) alpha p
    (brrsDyadicRadialBlockRadius_ne_zero j m) hp W omega f
    homega hf homega_pos homega_top hmass_pos hmass_top hW

/-- The two endpoint phases containing `+s`, sampled with the outer `+r`
sign.  This is kept separate from the standard convolution block so that the
wave-sign bookkeeping remains literal. -/
noncomputable def brrsDyadicRadialBlockAddPlus
    (T : Finset Real) (j m : Nat) (p : Real)
    (W omega f : Real → ENNReal) : ENNReal :=
  ∑ t ∈ T, ∫⁻ r in
    Icc (brrsDyadicRadialBlockRadius j m : Real)
      (2 * (brrsDyadicRadialBlockRadius j m : Real)),
    W r * (brrsOneDimProfileConvolutionPlus omega f (t + r)) ^ p

/-- The two endpoint phases containing `+s`, sampled with the outer `-r`
sign. -/
noncomputable def brrsDyadicRadialBlockSubPlus
    (T : Finset Real) (j m : Nat) (p : Real)
    (W omega f : Real → ENNReal) : ENNReal :=
  ∑ t ∈ T, ∫⁻ r in
    Icc (brrsDyadicRadialBlockRadius j m : Real)
      (2 * (brrsDyadicRadialBlockRadius j m : Real)),
    W r * (brrsOneDimProfileConvolutionPlus omega f (t - r)) ^ p

/-- Reflection turns the outgoing `+s` block into the already proved
ordinary-convolution block, without changing the input `Lᵖ` moment. -/
theorem brrsDyadicRadialBlockAddPlus_le_kappa
    (T : Finset Real) (j m : Nat) (alpha p : Real) (hp : 1 < p)
    (W omega f : Real → ENNReal)
    (homega : Measurable omega) (hf : Measurable f)
    (homega_pos : ∀ u : Real, 0 < omega u)
    (homega_top : ∀ u : Real, omega u ≠ ∞)
    (hmass_pos : 0 < ∫⁻ u : Real, omega u)
    (hmass_top : (∫⁻ u : Real, omega u) ≠ ∞)
    (hW : ∀ r ∈ Icc (brrsDyadicRadialBlockRadius j m : Real)
        (2 * (brrsDyadicRadialBlockRadius j m : Real)),
      W r ≤ (brrsDyadicRadialBlockRadius j m : ENNReal) ^ (-alpha)) :
    brrsDyadicRadialBlockAddPlus T j m p W omega f ≤
      7 * brrsDyadicKappa T j m alpha *
        ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by
  have hrewrite :
      brrsDyadicRadialBlockAddPlus T j m p W omega f =
        brrsDyadicRadialBlockAdd T j m p W omega (brrsReflectProfile f) := by
    unfold brrsDyadicRadialBlockAddPlus brrsDyadicRadialBlockAdd
    apply Finset.sum_congr rfl
    intro t ht
    apply lintegral_congr
    intro r
    rw [brrsOneDimProfileConvolutionPlus_eq_reflect]
  calc
    brrsDyadicRadialBlockAddPlus T j m p W omega f =
        brrsDyadicRadialBlockAdd T j m p W omega (brrsReflectProfile f) := hrewrite
    _ ≤ 7 * brrsDyadicKappa T j m alpha *
          ((∫⁻ u : Real, omega u) ^ p *
            ∫⁻ s : Real, (brrsReflectProfile f s) ^ p) :=
      brrsDyadicRadialBlockAdd_le_kappa T j m alpha p hp W omega
        (brrsReflectProfile f) homega (measurable_brrsReflectProfile hf)
        homega_pos homega_top hmass_pos hmass_top hW
    _ = 7 * brrsDyadicKappa T j m alpha *
          ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by
      rw [lintegral_brrsReflectProfile_rpow_eq]

/-- The reflected incoming `+s` block has the same sharp local-count bound. -/
theorem brrsDyadicRadialBlockSubPlus_le_kappa
    (T : Finset Real) (j m : Nat) (alpha p : Real) (hp : 1 < p)
    (W omega f : Real → ENNReal)
    (homega : Measurable omega) (hf : Measurable f)
    (homega_pos : ∀ u : Real, 0 < omega u)
    (homega_top : ∀ u : Real, omega u ≠ ∞)
    (hmass_pos : 0 < ∫⁻ u : Real, omega u)
    (hmass_top : (∫⁻ u : Real, omega u) ≠ ∞)
    (hW : ∀ r ∈ Icc (brrsDyadicRadialBlockRadius j m : Real)
        (2 * (brrsDyadicRadialBlockRadius j m : Real)),
      W r ≤ (brrsDyadicRadialBlockRadius j m : ENNReal) ^ (-alpha)) :
    brrsDyadicRadialBlockSubPlus T j m p W omega f ≤
      7 * brrsDyadicKappa T j m alpha *
        ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by
  have hrewrite :
      brrsDyadicRadialBlockSubPlus T j m p W omega f =
        brrsDyadicRadialBlockSub T j m p W omega (brrsReflectProfile f) := by
    unfold brrsDyadicRadialBlockSubPlus brrsDyadicRadialBlockSub
    apply Finset.sum_congr rfl
    intro t ht
    apply lintegral_congr
    intro r
    rw [brrsOneDimProfileConvolutionPlus_eq_reflect]
  calc
    brrsDyadicRadialBlockSubPlus T j m p W omega f =
        brrsDyadicRadialBlockSub T j m p W omega (brrsReflectProfile f) := hrewrite
    _ ≤ 7 * brrsDyadicKappa T j m alpha *
          ((∫⁻ u : Real, omega u) ^ p *
            ∫⁻ s : Real, (brrsReflectProfile f s) ^ p) :=
      brrsDyadicRadialBlockSub_le_kappa T j m alpha p hp W omega
        (brrsReflectProfile f) homega (measurable_brrsReflectProfile hf)
        homega_pos homega_top hmass_pos hmass_top hW
    _ = 7 * brrsDyadicKappa T j m alpha *
          ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by
      rw [lintegral_brrsReflectProfile_rpow_eq]

/-- The literal four endpoint sign choices on one dyadic radial block.
The two standard and two reflected convolutions correspond respectively to
`t±r-s` and `t±r+s`. -/
noncomputable def brrsDyadicRadialEndpointFourPhaseBlock
    (T : Finset Real) (j m : Nat) (p : Real)
    (W omega f : Real → ENNReal) : ENNReal :=
  brrsDyadicRadialBlockAdd T j m p W omega f +
    brrsDyadicRadialBlockSub T j m p W omega f +
      brrsDyadicRadialBlockAddPlus T j m p W omega f +
        brrsDyadicRadialBlockSubPlus T j m p W omega f

/-- All four travelling endpoint phases satisfy the same `κ_{j,m}` block
bound.  This is the complete scalar Section 5 contribution of the endpoint
kernel, prior to inserting the actual two-radius majorant. -/
theorem brrsDyadicRadialEndpointFourPhaseBlock_le_kappa
    (T : Finset Real) (j m : Nat) (alpha p : Real) (hp : 1 < p)
    (W omega f : Real → ENNReal)
    (homega : Measurable omega) (hf : Measurable f)
    (homega_pos : ∀ u : Real, 0 < omega u)
    (homega_top : ∀ u : Real, omega u ≠ ∞)
    (hmass_pos : 0 < ∫⁻ u : Real, omega u)
    (hmass_top : (∫⁻ u : Real, omega u) ≠ ∞)
    (hW : ∀ r ∈ Icc (brrsDyadicRadialBlockRadius j m : Real)
        (2 * (brrsDyadicRadialBlockRadius j m : Real)),
      W r ≤ (brrsDyadicRadialBlockRadius j m : ENNReal) ^ (-alpha)) :
    brrsDyadicRadialEndpointFourPhaseBlock T j m p W omega f ≤
      28 * brrsDyadicKappa T j m alpha *
        ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by
  let M : ENNReal := (∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p
  have hadd := brrsDyadicRadialBlockAdd_le_kappa T j m alpha p hp W omega f
    homega hf homega_pos homega_top hmass_pos hmass_top hW
  have hsub := brrsDyadicRadialBlockSub_le_kappa T j m alpha p hp W omega f
    homega hf homega_pos homega_top hmass_pos hmass_top hW
  have haddPlus := brrsDyadicRadialBlockAddPlus_le_kappa T j m alpha p hp W omega f
    homega hf homega_pos homega_top hmass_pos hmass_top hW
  have hsubPlus := brrsDyadicRadialBlockSubPlus_le_kappa T j m alpha p hp W omega f
    homega hf homega_pos homega_top hmass_pos hmass_top hW
  change brrsDyadicRadialBlockAdd T j m p W omega f +
      brrsDyadicRadialBlockSub T j m p W omega f +
        brrsDyadicRadialBlockAddPlus T j m p W omega f +
          brrsDyadicRadialBlockSubPlus T j m p W omega f ≤ _
  calc
    brrsDyadicRadialBlockAdd T j m p W omega f +
        brrsDyadicRadialBlockSub T j m p W omega f +
          brrsDyadicRadialBlockAddPlus T j m p W omega f +
            brrsDyadicRadialBlockSubPlus T j m p W omega f ≤
        (7 * brrsDyadicKappa T j m alpha * M) +
          (7 * brrsDyadicKappa T j m alpha * M) +
            (7 * brrsDyadicKappa T j m alpha * M) +
              (7 * brrsDyadicKappa T j m alpha * M) := by
      gcongr
    _ = 28 * brrsDyadicKappa T j m alpha * M := by ring
    _ = 28 * brrsDyadicKappa T j m alpha *
          ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by rfl

/-- Summing a uniform bound for the `κ_{j,m}` coefficients over all the
dyadic radial scales loses exactly the number `j + 1` of blocks. -/
theorem sum_brrsDyadicKappa_le_of_uniform_bound
    (T : Finset Real) (j : Nat) (alpha : Real) (K : ENNReal)
    (hK : ∀ m : Nat, m ≤ j → brrsDyadicKappa T j m alpha ≤ K) :
    (∑ m ∈ Finset.range (j + 1), brrsDyadicKappa T j m alpha) ≤
      (j + 1 : ENNReal) * K := by
  calc
    (∑ m ∈ Finset.range (j + 1), brrsDyadicKappa T j m alpha) ≤
        ∑ _m ∈ Finset.range (j + 1), K := by
      apply Finset.sum_le_sum
      intro m hm
      exact hK m (Nat.lt_succ_iff.mp (Finset.mem_range.mp hm))
    _ = (j + 1 : ENNReal) * K := by
      simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul,
        Nat.cast_add, Nat.cast_one]

/-- The entropy-tail estimate gives a finite dyadic sum estimate with only
the unavoidable number of radial blocks as loss. -/
theorem exists_tail_sum_brrsDyadicKappa_le_inv_rpow_of_lt
    {E : Set Real} {alpha q : Real} (halpha : 0 ≤ alpha)
    (hνq : brrsLegendreAssouadFunction E alpha < q) :
    ∃ J : Nat, ∀ j ≥ J, ∀ T : Finset Real, IsDyadicDiscretization E j T →
      (∑ m ∈ Finset.range (j + 1), brrsDyadicKappa T j m alpha) ≤
        (j + 1 : ENNReal) *
          ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) :
            ENNReal)⁻¹) ^ q := by
  rcases exists_tail_brrsDyadicKappa_le_inv_rpow_of_lt halpha hνq with ⟨J, hJ⟩
  refine ⟨J, ?_⟩
  intro j hj T hT
  exact sum_brrsDyadicKappa_le_of_uniform_bound T j alpha _
    (fun m hm => hJ j hj T hT m hm)

/-- A generic finite dyadic summation device.  Any family whose `m`-th term
has the Section 5 `κ_{j,m}` bound can be summed without redoing its geometry.
-/
theorem sum_le_seven_mul_sum_brrsDyadicKappa_mul
    (T : Finset Real) (j : Nat) (alpha : Real) (M : ENNReal)
    (A : Nat → ENNReal)
    (hA : ∀ m : Nat, m ≤ j →
      A m ≤ 7 * brrsDyadicKappa T j m alpha * M) :
    (∑ m ∈ Finset.range (j + 1), A m) ≤
      7 * (∑ m ∈ Finset.range (j + 1), brrsDyadicKappa T j m alpha) * M := by
  calc
    (∑ m ∈ Finset.range (j + 1), A m) ≤
        ∑ m ∈ Finset.range (j + 1), 7 * brrsDyadicKappa T j m alpha * M := by
      apply Finset.sum_le_sum
      intro m hm
      exact hA m (Nat.lt_succ_iff.mp (Finset.mem_range.mp hm))
    _ = 7 * (∑ m ∈ Finset.range (j + 1), brrsDyadicKappa T j m alpha) * M := by
      simp_rw [mul_assoc]
      rw [← Finset.mul_sum, ← Finset.sum_mul]

/-- Combining the preceding two finite-sum facts with a uniform entropy
bound is the exact dyadic block-summation step used in Section 5. -/
theorem sum_le_seven_mul_dyadicBlockCount_mul_of_uniform_kappa
    (T : Finset Real) (j : Nat) (alpha : Real) (K M : ENNReal)
    (A : Nat → ENNReal)
    (hA : ∀ m : Nat, m ≤ j →
      A m ≤ 7 * brrsDyadicKappa T j m alpha * M)
    (hK : ∀ m : Nat, m ≤ j → brrsDyadicKappa T j m alpha ≤ K) :
    (∑ m ∈ Finset.range (j + 1), A m) ≤
      7 * ((j + 1 : ENNReal) * K) * M := by
  calc
    (∑ m ∈ Finset.range (j + 1), A m) ≤
        7 * (∑ m ∈ Finset.range (j + 1), brrsDyadicKappa T j m alpha) * M :=
      sum_le_seven_mul_sum_brrsDyadicKappa_mul T j alpha M A hA
    _ ≤ 7 * ((j + 1 : ENNReal) * K) * M := by
      simpa only [mul_comm, mul_left_comm, mul_assoc] using
        (mul_le_mul_right
          (mul_le_mul_left
            (sum_brrsDyadicKappa_le_of_uniform_bound T j alpha K hK) 7) M)

/-- A finite geometric dyadic sum is bounded by its exact ENNReal geometric
series value.  Later analytic estimates can use this to replace a radial
block count by a summable decay factor. -/
theorem sum_rpow_range_le_geometric (rho : ENNReal) (n : Nat) :
    (∑ m ∈ Finset.range n, rho ^ m) ≤ (1 - rho)⁻¹ := by
  calc
    (∑ m ∈ Finset.range n, rho ^ m) ≤ ∑' m : Nat, rho ^ m :=
      ENNReal.sum_le_tsum _
    _ = (1 - rho)⁻¹ := ENNReal.tsum_geometric rho

/-- A reusable finite geometric-series summation rule for a family with
dyadic decay.  No limiting argument is hidden: the last factor is the exact
geometric-series bound in `ENNReal`. -/
theorem sum_le_mul_geometric_of_le_rpow
    (rho C : ENNReal) (n : Nat) (A : Nat → ENNReal)
    (hA : ∀ m : Nat, m < n → A m ≤ C * rho ^ m) :
    (∑ m ∈ Finset.range n, A m) ≤ C * (1 - rho)⁻¹ := by
  calc
    (∑ m ∈ Finset.range n, A m) ≤
        ∑ m ∈ Finset.range n, C * rho ^ m := by
      apply Finset.sum_le_sum
      intro m hm
      exact hA m (Finset.mem_range.mp hm)
    _ = C * (∑ m ∈ Finset.range n, rho ^ m) := by
      rw [← Finset.mul_sum]
    _ ≤ C * (1 - rho)⁻¹ := by
      simpa only [mul_comm, mul_left_comm, mul_assoc] using
        (mul_le_mul_left (sum_rpow_range_le_geometric rho n) C)

/-- The entropy-tail bound can be consumed directly by any finite family of
Section 5 dyadic block contributions. -/
theorem exists_tail_sum_le_seven_mul_dyadicEntropy_mul_of_lt
    {E : Set Real} {alpha q : Real} (halpha : 0 ≤ alpha)
    (hνq : brrsLegendreAssouadFunction E alpha < q) :
    ∃ J : Nat, ∀ j ≥ J, ∀ T : Finset Real, IsDyadicDiscretization E j T →
      ∀ (M : ENNReal) (A : Nat → ENNReal),
        (∀ m : Nat, m ≤ j → A m ≤ 7 * brrsDyadicKappa T j m alpha * M) →
        (∑ m ∈ Finset.range (j + 1), A m) ≤
          7 * ((j + 1 : ENNReal) *
            ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) :
              ENNReal)⁻¹) ^ q) * M := by
  rcases exists_tail_brrsDyadicKappa_le_inv_rpow_of_lt halpha hνq with ⟨J, hJ⟩
  refine ⟨J, ?_⟩
  intro j hj T hT M A hA
  exact sum_le_seven_mul_dyadicBlockCount_mul_of_uniform_kappa T j alpha _ M A hA
    (fun m hm => hJ j hj T hT m hm)

/-- Summing all outgoing Section 5 radial blocks under a uniform local-count
bound. -/
theorem sum_brrsDyadicRadialBlockAdd_le_of_uniform_kappa
    (T : Finset Real) (j : Nat) (alpha p : Real) (K : ENNReal) (hp : 1 < p)
    (W omega f : Real → ENNReal)
    (homega : Measurable omega) (hf : Measurable f)
    (homega_pos : ∀ u : Real, 0 < omega u)
    (homega_top : ∀ u : Real, omega u ≠ ∞)
    (hmass_pos : 0 < ∫⁻ u : Real, omega u)
    (hmass_top : (∫⁻ u : Real, omega u) ≠ ∞)
    (hW : ∀ m : Nat, m ≤ j → ∀ r ∈
        Icc (brrsDyadicRadialBlockRadius j m : Real)
          (2 * (brrsDyadicRadialBlockRadius j m : Real)),
      W r ≤ (brrsDyadicRadialBlockRadius j m : ENNReal) ^ (-alpha))
    (hK : ∀ m : Nat, m ≤ j → brrsDyadicKappa T j m alpha ≤ K) :
    (∑ m ∈ Finset.range (j + 1), brrsDyadicRadialBlockAdd T j m p W omega f) ≤
      7 * ((j + 1 : ENNReal) * K) *
        ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by
  apply sum_le_seven_mul_dyadicBlockCount_mul_of_uniform_kappa
    T j alpha K ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p)
  · intro m hm
    exact brrsDyadicRadialBlockAdd_le_kappa T j m alpha p hp W omega f
      homega hf homega_pos homega_top hmass_pos hmass_top (hW m hm)
  · exact hK

/-- Summing all incoming Section 5 radial blocks under a uniform local-count
bound. -/
theorem sum_brrsDyadicRadialBlockSub_le_of_uniform_kappa
    (T : Finset Real) (j : Nat) (alpha p : Real) (K : ENNReal) (hp : 1 < p)
    (W omega f : Real → ENNReal)
    (homega : Measurable omega) (hf : Measurable f)
    (homega_pos : ∀ u : Real, 0 < omega u)
    (homega_top : ∀ u : Real, omega u ≠ ∞)
    (hmass_pos : 0 < ∫⁻ u : Real, omega u)
    (hmass_top : (∫⁻ u : Real, omega u) ≠ ∞)
    (hW : ∀ m : Nat, m ≤ j → ∀ r ∈
        Icc (brrsDyadicRadialBlockRadius j m : Real)
          (2 * (brrsDyadicRadialBlockRadius j m : Real)),
      W r ≤ (brrsDyadicRadialBlockRadius j m : ENNReal) ^ (-alpha))
    (hK : ∀ m : Nat, m ≤ j → brrsDyadicKappa T j m alpha ≤ K) :
    (∑ m ∈ Finset.range (j + 1), brrsDyadicRadialBlockSub T j m p W omega f) ≤
      7 * ((j + 1 : ENNReal) * K) *
        ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by
  apply sum_le_seven_mul_dyadicBlockCount_mul_of_uniform_kappa
    T j alpha K ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p)
  · intro m hm
    exact brrsDyadicRadialBlockSub_le_kappa T j m alpha p hp W omega f
      homega hf homega_pos homega_top hmass_pos hmass_top (hW m hm)
  · exact hK

/-- The outgoing dyadic radial decomposition satisfies the entropy-tail
version of the Section 5 weighted estimate.  This is the direct composition
of the profile Young bound, the block geometry, and the Legendre--Assouad
local-count tail. -/
theorem exists_tail_sum_brrsDyadicRadialBlockAdd_le_inv_rpow_of_lt
    {E : Set Real} {alpha q : Real} (halpha : 0 ≤ alpha)
    (hνq : brrsLegendreAssouadFunction E alpha < q) :
    ∃ J : Nat, ∀ j ≥ J, ∀ T : Finset Real, IsDyadicDiscretization E j T →
      ∀ (p : Real) (W omega f : Real → ENNReal), 1 < p →
        Measurable omega → Measurable f →
        (∀ u : Real, 0 < omega u) → (∀ u : Real, omega u ≠ ∞) →
        0 < ∫⁻ u : Real, omega u → (∫⁻ u : Real, omega u) ≠ ∞ →
        (∀ m : Nat, m ≤ j → ∀ r ∈
          Icc (brrsDyadicRadialBlockRadius j m : Real)
            (2 * (brrsDyadicRadialBlockRadius j m : Real)),
          W r ≤ (brrsDyadicRadialBlockRadius j m : ENNReal) ^ (-alpha)) →
        (∑ m ∈ Finset.range (j + 1), brrsDyadicRadialBlockAdd T j m p W omega f) ≤
          7 * ((j + 1 : ENNReal) *
            ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) :
              ENNReal)⁻¹) ^ q) *
            ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by
  rcases exists_tail_sum_le_seven_mul_dyadicEntropy_mul_of_lt halpha hνq with
    ⟨J, hJ⟩
  refine ⟨J, ?_⟩
  intro j hj T hT p W omega f hp homega hf homega_pos homega_top hmass_pos hmass_top hW
  apply hJ j hj T hT
    ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p)
    (fun m => brrsDyadicRadialBlockAdd T j m p W omega f)
  intro m hm
  exact brrsDyadicRadialBlockAdd_le_kappa T j m alpha p hp W omega f
    homega hf homega_pos homega_top hmass_pos hmass_top (hW m hm)

/-- The incoming counterpart of the entropy-tail Section 5 dyadic estimate.
-/
theorem exists_tail_sum_brrsDyadicRadialBlockSub_le_inv_rpow_of_lt
    {E : Set Real} {alpha q : Real} (halpha : 0 ≤ alpha)
    (hνq : brrsLegendreAssouadFunction E alpha < q) :
    ∃ J : Nat, ∀ j ≥ J, ∀ T : Finset Real, IsDyadicDiscretization E j T →
      ∀ (p : Real) (W omega f : Real → ENNReal), 1 < p →
        Measurable omega → Measurable f →
        (∀ u : Real, 0 < omega u) → (∀ u : Real, omega u ≠ ∞) →
        0 < ∫⁻ u : Real, omega u → (∫⁻ u : Real, omega u) ≠ ∞ →
        (∀ m : Nat, m ≤ j → ∀ r ∈
          Icc (brrsDyadicRadialBlockRadius j m : Real)
            (2 * (brrsDyadicRadialBlockRadius j m : Real)),
          W r ≤ (brrsDyadicRadialBlockRadius j m : ENNReal) ^ (-alpha)) →
        (∑ m ∈ Finset.range (j + 1), brrsDyadicRadialBlockSub T j m p W omega f) ≤
          7 * ((j + 1 : ENNReal) *
            ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) :
              ENNReal)⁻¹) ^ q) *
            ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by
  rcases exists_tail_sum_le_seven_mul_dyadicEntropy_mul_of_lt halpha hνq with
    ⟨J, hJ⟩
  refine ⟨J, ?_⟩
  intro j hj T hT p W omega f hp homega hf homega_pos homega_top hmass_pos hmass_top hW
  apply hJ j hj T hT
    ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p)
    (fun m => brrsDyadicRadialBlockSub T j m p W omega f)
  intro m hm
  exact brrsDyadicRadialBlockSub_le_kappa T j m alpha p hp W omega f
    homega hf homega_pos homega_top hmass_pos hmass_top (hW m hm)

/-- The complete four-sign endpoint contribution has the same dyadic
local-count bound as either travelling sign separately.  This is the scalar
assembly step which keeps the two reflected `+s` phases in the literal
Section 5 estimate, rather than treating them as an implicit symmetry. -/
theorem sum_brrsDyadicRadialEndpointFourPhaseBlock_le_of_uniform_kappa
    (T : Finset Real) (j : Nat) (alpha p : Real) (K : ENNReal) (hp : 1 < p)
    (W omega f : Real → ENNReal)
    (homega : Measurable omega) (hf : Measurable f)
    (homega_pos : ∀ u : Real, 0 < omega u)
    (homega_top : ∀ u : Real, omega u ≠ ∞)
    (hmass_pos : 0 < ∫⁻ u : Real, omega u)
    (hmass_top : (∫⁻ u : Real, omega u) ≠ ∞)
    (hW : ∀ m : Nat, m ≤ j → ∀ r ∈
        Icc (brrsDyadicRadialBlockRadius j m : Real)
          (2 * (brrsDyadicRadialBlockRadius j m : Real)),
      W r ≤ (brrsDyadicRadialBlockRadius j m : ENNReal) ^ (-alpha))
    (hK : ∀ m : Nat, m ≤ j → brrsDyadicKappa T j m alpha ≤ K) :
    (∑ m ∈ Finset.range (j + 1),
      brrsDyadicRadialEndpointFourPhaseBlock T j m p W omega f) ≤
      28 * ((j + 1 : ENNReal) * K) *
        ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by
  let M : ENNReal :=
    (∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p
  calc
    (∑ m ∈ Finset.range (j + 1),
        brrsDyadicRadialEndpointFourPhaseBlock T j m p W omega f) ≤
        ∑ m ∈ Finset.range (j + 1),
          28 * brrsDyadicKappa T j m alpha * M := by
      apply Finset.sum_le_sum
      intro m hm
      exact brrsDyadicRadialEndpointFourPhaseBlock_le_kappa
        T j m alpha p hp W omega f homega hf homega_pos homega_top
        hmass_pos hmass_top (hW m (Nat.lt_succ_iff.mp (Finset.mem_range.mp hm)))
    _ = 28 * (∑ m ∈ Finset.range (j + 1),
          brrsDyadicKappa T j m alpha) * M := by
      simp_rw [mul_assoc]
      rw [← Finset.mul_sum, ← Finset.sum_mul]
    _ ≤ 28 * ((j + 1 : ENNReal) * K) * M := by
      simpa only [mul_comm, mul_left_comm, mul_assoc] using
        (mul_le_mul_right
          (mul_le_mul_left
            (sum_brrsDyadicKappa_le_of_uniform_bound T j alpha K hK) 28) M)
    _ = 28 * ((j + 1 : ENNReal) * K) *
        ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by
      rfl

/-- The literal four endpoint phases consume a strict
Legendre--Assouad entropy bound simultaneously.  This is the dyadic
Section 5 scalar estimate used before inserting the two-radius stationary
kernel: it includes `t ± r ± s`, with no endpoint sign omitted. -/
theorem exists_tail_sum_brrsDyadicRadialEndpointFourPhaseBlock_le_inv_rpow_of_lt
    {E : Set Real} {alpha q : Real} (halpha : 0 ≤ alpha)
    (hνq : brrsLegendreAssouadFunction E alpha < q) :
    ∃ J : Nat, ∀ j ≥ J, ∀ T : Finset Real, IsDyadicDiscretization E j T →
      ∀ (p : Real) (W omega f : Real → ENNReal), 1 < p →
        Measurable omega → Measurable f →
        (∀ u : Real, 0 < omega u) → (∀ u : Real, omega u ≠ ∞) →
        0 < ∫⁻ u : Real, omega u → (∫⁻ u : Real, omega u) ≠ ∞ →
        (∀ m : Nat, m ≤ j → ∀ r ∈
          Icc (brrsDyadicRadialBlockRadius j m : Real)
            (2 * (brrsDyadicRadialBlockRadius j m : Real)),
          W r ≤ (brrsDyadicRadialBlockRadius j m : ENNReal) ^ (-alpha)) →
        (∑ m ∈ Finset.range (j + 1),
          brrsDyadicRadialEndpointFourPhaseBlock T j m p W omega f) ≤
          28 * ((j + 1 : ENNReal) *
            ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) :
              ENNReal)⁻¹) ^ q) *
            ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by
  rcases exists_tail_brrsDyadicKappa_le_inv_rpow_of_lt halpha hνq with ⟨J, hJ⟩
  refine ⟨J, ?_⟩
  intro j hj T hT p W omega f hp homega hf homega_pos homega_top hmass_pos hmass_top hW
  exact sum_brrsDyadicRadialEndpointFourPhaseBlock_le_of_uniform_kappa
    T j alpha p
    (((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) : ENNReal)⁻¹) ^ q)
    hp W omega f homega hf homega_pos homega_top hmass_pos hmass_top hW
    (fun m hm => hJ j hj T hT m hm)

end

/-! ### Finite-time product-space norm bridge

The Riesz--Thorin transport theorem uses a single output measure space, while
the BRRS output is a finite family of spatial functions.  The next equality
identifies the literal `\ell^p(L^p)` norm with an ordinary product-space norm.
-/

/-- The BRRS finite-time `\ell^p(L^p)` norm is exactly the `L^p` norm on the
product of the finite time subtype (with counting measure) and physical
space.  The explicit `AEMeasurable` hypothesis is precisely the Fubini
hypothesis and is the only analytic input needed for this conversion. -/
theorem discreteLpNorm_eq_eLpNorm_finset_counting_product
    {d : Nat} {p : Real} (hp : 0 < p) (T : Finset Real)
    (u : Real → BRRSSpace d → Complex)
    (hprod : AEMeasurable
      (fun z : ({t : Real // t ∈ (T : Set Real)}) × BRRSSpace d =>
        u (z.1 : Real) z.2)
      (Measure.count.prod volume)) :
    discreteLpNorm p T u =
      eLpNorm (fun z : ({t : Real // t ∈ (T : Set Real)}) × BRRSSpace d =>
        u (z.1 : Real) z.2) (ENNReal.ofReal p) (Measure.count.prod volume) := by
  apply ENNReal.rpow_left_injective hp.ne'
  change (discreteLpNorm p T u) ^ p =
    (eLpNorm (fun z : ({t : Real // t ∈ (T : Set Real)}) × BRRSSpace d =>
      u (z.1 : Real) z.2) (ENNReal.ofReal p) (Measure.count.prod volume)) ^ p
  have hdisc : (discreteLpNorm p T u) ^ p =
      ∑ t ∈ T, ∫⁻ x : BRRSSpace d, (ENNReal.ofReal ‖u t x‖) ^ p := by
    exact discreteLpNorm_rpow_eq_sum_lintegral_ofReal_norm_rpow hp T u
  have hprodPow : AEMeasurable
      (fun z : ({t : Real // t ∈ (T : Set Real)}) × BRRSSpace d =>
        (ENNReal.ofReal ‖u (z.1 : Real) z.2‖) ^ p)
      (Measure.count.prod volume) := by
    have hrewrite :
        (fun z : ({t : Real // t ∈ (T : Set Real)}) × BRRSSpace d =>
          (ENNReal.ofReal ‖u (z.1 : Real) z.2‖) ^ p) =
        fun z : ({t : Real // t ∈ (T : Set Real)}) × BRRSSpace d =>
          ‖u (z.1 : Real) z.2‖ₑ ^ p := by
      funext z
      simp only [ofReal_norm]
    rw [hrewrite]
    change AEMeasurable
      ((fun a : ENNReal => a ^ p) ∘
        fun z : ({t : Real // t ∈ (T : Set Real)}) × BRRSSpace d =>
          ‖u (z.1 : Real) z.2‖ₑ)
      (Measure.count.prod volume)
    exact ENNReal.continuous_rpow_const.measurable.comp_aemeasurable hprod.enorm
  rw [hdisc]
  rw [← Auto.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow hp]
  rw [MeasureTheory.lintegral_prod _ hprodPow]
  rw [MeasureTheory.lintegral_count, tsum_fintype]
  exact (Finset.sum_subtype T (fun t => by
    change t ∈ T ↔ t ∈ T
    rfl) fun t =>
    ∫⁻ x : BRRSSpace d, (ENNReal.ofReal ‖u t x‖) ^ p)

/-- Measurability of a finite family of spatial functions is equivalent to
measurability of the associated function on counting-time times space.  This
is the direct measurability bridge needed to instantiate the product-output
form of Riesz--Thorin. -/
theorem measurable_finset_time_product_of_measurable
    {d : Nat} (T : Finset Real) (u : Real → BRRSSpace d → Complex)
    (hu : ∀ t ∈ T, Measurable (u t)) :
    Measurable (fun z : ({t : Real // t ∈ (T : Set Real)}) × BRRSSpace d =>
      u (z.1 : Real) z.2) := by
  apply measurable_from_prod_countable_right
  intro t
  exact hu (t : Real) (by simp)

/-- A slice-wise measurable finite-time output automatically satisfies the
Fubini hypothesis in `discreteLpNorm_eq_eLpNorm_finset_counting_product`. -/
theorem discreteLpNorm_eq_eLpNorm_finset_counting_product_of_measurable
    {d : Nat} {p : Real} (hp : 0 < p) (T : Finset Real)
    (u : Real → BRRSSpace d → Complex)
    (hu : ∀ t ∈ T, Measurable (u t)) :
    discreteLpNorm p T u =
      eLpNorm (fun z : ({t : Real // t ∈ (T : Set Real)}) × BRRSSpace d =>
        u (z.1 : Real) z.2) (ENNReal.ofReal p) (Measure.count.prod volume) := by
  apply discreteLpNorm_eq_eLpNorm_finset_counting_product hp T u
  exact (measurable_finset_time_product_of_measurable T u hu).aemeasurable

/-! ### Conditional radial Schwartz-core extension

The ordinary `SchwartzMap.denseRange_toLpCLM` theorem is a density statement
in the full `L^p` space.  It does not by itself preserve the radial subspace,
which is the domain of the BRRS core estimate.  We therefore isolate the
precise radial approximation and canonical-output continuity statements that
are needed to promote a Schwartz-core estimate.  No instance of either
condition is asserted here.
-/

/-- Package an ordinary real lower exponent bound as the `Lp` typeclass
assumption used by the topology on `Lp`. -/
theorem brrsFactOneLeOfReal {p : Real} (hp : 1 ≤ p) :
    Fact (1 ≤ ENNReal.ofReal p) :=
  ⟨ENNReal.one_le_ofReal.mpr hp⟩

/-- A radial `L^p` function can be approximated in the actual `Lp` space by
pointwise radial Schwartz functions.  This is deliberately a hypothesis: the
ambient Schwartz density theorem does not establish radial density without a
separate radialization argument. -/
def HasRadialSchwartzLpApproximation {d : Nat} (p : Real)
    [Fact (1 ≤ ENNReal.ofReal p)] : Prop :=
  ∀ (f : BRRSSpace d → Complex) (hf : MemLp f (ENNReal.ofReal p) volume),
    IsAERadial f →
      ∃ u : Nat → BRRSSchwartz d,
        (∀ n : Nat, IsRadial (u n : BRRSSpace d → Complex)) ∧
          Tendsto (fun n => (u n).toLp (ENNReal.ofReal p) volume) atTop
            (𝓝 (hf.toLp f))

/-- The canonical finite-time convolution realization is continuous along a
radial Schwartz approximation, after its literal Schwartz formula is used on
each approximant.  This records exactly the finite-product continuity needed
by the extension step; it is not a substitute for proving that continuity. -/
def HasRadialSchwartzCoreConvergence {d : Nat} (Φ : BRRSAnnularCutoff)
    (W : BRRSLpHalfWaveExtension d Φ) (p : Real)
    [Fact (1 ≤ ENNReal.ofReal p)] : Prop :=
  ∀ (j : Nat) (T : Finset Real) (f : BRRSSpace d → Complex)
    (hf : MemLp f (ENNReal.ofReal p) volume), IsAERadial f →
    ∀ u : Nat → BRRSSchwartz d,
      (∀ n : Nat, IsRadial (u n : BRRSSpace d → Complex)) →
      Tendsto (fun n => (u n).toLp (ENNReal.ofReal p) volume) atTop
        (𝓝 (hf.toLp f)) →
        Tendsto
          (fun n => discreteLpNorm p T
            (fun t => brrsDyadicHalfWave Φ j t (u n))) atTop
          (𝓝 (discreteLpNorm p T (fun t => W.apply j t f)))

/-- A radial Schwartz-core BRRS estimate extends with the *same constant* to
any prescribed `L^p` realization once the explicit radial approximation and
finite-time output-convergence hypotheses above have been supplied.

This is only a conditional transfer principle.  In particular, it does not
claim radial Schwartz density, nor does it claim the required continuity for
the canonical convolution realization. -/
theorem uniformEstimateAtExponent_of_schwartzCore_of_radialSchwartzApproximation
    {d : Nat} (Φ : BRRSAnnularCutoff) (W : BRRSLpHalfWaveExtension d Φ)
    (E : Set Real) (p s : Real)
    [Fact (1 ≤ ENNReal.ofReal p)]
    (hcore : SchwartzCoreUniformEstimateAtExponent (d := d) Φ E p s)
    (happrox : HasRadialSchwartzLpApproximation (d := d) p)
    (houtput : HasRadialSchwartzCoreConvergence Φ W p) :
    UniformEstimateAtExponent Φ W E p s := by
  rcases hcore with ⟨K, hK, hcore⟩
  refine ⟨K, hK, ?_⟩
  intro j hj T hT f hf hfradial
  obtain ⟨u, huradial, hu⟩ := happrox f hf hfradial
  have huNorm : Tendsto
      (fun n => eLpNorm (u n : BRRSSpace d → Complex) (ENNReal.ofReal p) volume)
      atTop (𝓝 (eLpNorm f (ENNReal.ofReal p) volume)) := by
    have h := (continuous_id.enorm.tendsto (hf.toLp f)).comp hu
    change Tendsto (fun n => ‖(u n).toLp (ENNReal.ofReal p) volume‖ₑ) atTop
      (𝓝 ‖hf.toLp f‖ₑ) at h
    simpa only [SchwartzMap.toLp, Lp.enorm_toLp] using h
  have huOutput := houtput j T f hf hfradial u huradial hu
  have huRHS : Tendsto
      (fun n => ENNReal.ofReal (K * (2 : Real) ^ ((j : Real) * s)) *
        eLpNorm (u n : BRRSSpace d → Complex) (ENNReal.ofReal p) volume)
      atTop
      (𝓝 (ENNReal.ofReal (K * (2 : Real) ^ ((j : Real) * s)) *
        eLpNorm f (ENNReal.ofReal p) volume)) :=
    ((ENNReal.continuous_const_mul ENNReal.ofReal_ne_top).tendsto _).comp huNorm
  apply le_of_tendsto_of_tendsto huOutput huRHS
  exact Eventually.of_forall fun n =>
    hcore j hj T hT (u n) (huradial n)

end Auto.Spherical.BRRS


/-! ### Low-radius stationary amplitudes

The stationary decomposition also needs a compact-radius counterpart to the
high-radius estimates above.  Here the physical phase scale is bounded, so the
global derivative bounds for the one-dimensional endpoint and middle profiles
give a uniform estimate without any nonstationary denominator. -/

namespace Auto.Spherical.BRRS

open Set Filter MeasureTheory FourierTransform
open Auto.Spherical.SurfaceMeasureDecay
open Auto.Spherical.OscillatoryIntegralAux Auto.Spherical.AHRS
open scoped BigOperators Convolution ENNReal FourierTransform Topology

noncomputable section

/-- On the low-radius region the linear stationary frequency scale is bounded
by the numerical constant used throughout the level-zero annulus estimates. -/
theorem brrs_lowRadius_phaseScale_le
    {a : Real} (ha0 : 0 <= a) (ha : a <= 16) :
    |2 * Real.pi * a| <= 128 := by
  have htwopi0 : 0 <= 2 * Real.pi := by positivity
  have hphase0 : 0 <= 2 * Real.pi * a :=
    mul_nonneg htwopi0 ha0
  rw [abs_of_nonneg hphase0]
  have htwopi : 2 * Real.pi <= 8 := by
    nlinarith [Real.pi_lt_four]
  calc
    2 * Real.pi * a <= 8 * a :=
      mul_le_mul_of_nonneg_right htwopi ha0
    _ <= 8 * 16 := mul_le_mul_of_nonneg_left ha (by norm_num)
    _ = 128 := by norm_num

/-- Every fixed radial derivative of every BRRS surface-wave amplitude is
uniformly bounded when the physical radius lies in the compact interval
`[0, 16]`.  The estimate is global in the radial frequency variable, hence in
particular applies on the literal annulus `[1/32,1]`. -/
theorem exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_lowRadius_bound
    (d k : Nat) (part : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ a rho : Real, 0 <= a -> a <= 16 ->
      ‖iteratedDeriv k (fun u : Real =>
        brrsSurfaceWaveAmplitude d part a u) rho‖ <= C := by
  cases part with
  | outgoing =>
      obtain ⟨B, hB, hbound⟩ :=
        exists_iteratedDeriv_smoothEndpointQuadraticIntegral_comp_mul_le (d - 2) k
      let C : Real := ‖(surfaceMass (d - 1) : Complex)‖ * B * 128 ^ k + 1
      refine ⟨C, by dsimp [C]; positivity, ?_⟩
      intro a rho ha0 ha
      have hscale : |2 * Real.pi * a| <= 128 :=
        brrs_lowRadius_phaseScale_le ha0 ha
      have hpow : |2 * Real.pi * a| ^ k <= (128 : Real) ^ k :=
        pow_le_pow_left₀ (abs_nonneg _) hscale _
      unfold brrsSurfaceWaveAmplitude
      rw [iteratedDeriv_const_mul_field, norm_mul]
      calc
        ‖(surfaceMass (d - 1) : Complex)‖ *
            ‖iteratedDeriv k (fun u : Real =>
              smoothEndpointQuadraticIntegral (d - 2) ((2 * Real.pi * a) * u)) rho‖ <=
            ‖(surfaceMass (d - 1) : Complex)‖ *
              (B * |2 * Real.pi * a| ^ k) :=
          mul_le_mul_of_nonneg_left (hbound (2 * Real.pi * a) rho) (norm_nonneg _)
        _ = (‖(surfaceMass (d - 1) : Complex)‖ * B) * |2 * Real.pi * a| ^ k := by
          ring
        _ <= (‖(surfaceMass (d - 1) : Complex)‖ * B) * (128 : Real) ^ k := by
          exact mul_le_mul_of_nonneg_left hpow (mul_nonneg (norm_nonneg _) hB.le)
        _ <= C := by
          dsimp [C]
          linarith
  | incoming =>
      obtain ⟨B, hB, hbound⟩ :=
        exists_iteratedDeriv_smoothEndpointQuadraticIntegral_comp_mul_le (d - 2) k
      let C : Real := ‖(surfaceMass (d - 1) : Complex)‖ * B * 128 ^ k + 1
      refine ⟨C, by dsimp [C]; positivity, ?_⟩
      intro a rho ha0 ha
      have hscale : |-(2 * Real.pi * a)| <= 128 := by
        rw [abs_neg]
        exact brrs_lowRadius_phaseScale_le ha0 ha
      have hpow : |-(2 * Real.pi * a)| ^ k <= (128 : Real) ^ k :=
        pow_le_pow_left₀ (abs_nonneg _) hscale _
      unfold brrsSurfaceWaveAmplitude
      rw [iteratedDeriv_const_mul_field, norm_mul]
      calc
        ‖(surfaceMass (d - 1) : Complex)‖ *
            ‖iteratedDeriv k (fun u : Real =>
              smoothEndpointQuadraticIntegral (d - 2) ((-(2 * Real.pi * a)) * u)) rho‖ <=
            ‖(surfaceMass (d - 1) : Complex)‖ *
              (B * |-(2 * Real.pi * a)| ^ k) :=
          mul_le_mul_of_nonneg_left (hbound (-(2 * Real.pi * a)) rho) (norm_nonneg _)
        _ = (‖(surfaceMass (d - 1) : Complex)‖ * B) * |-(2 * Real.pi * a)| ^ k := by
          ring
        _ <= (‖(surfaceMass (d - 1) : Complex)‖ * B) * (128 : Real) ^ k := by
          exact mul_le_mul_of_nonneg_left hpow (mul_nonneg (norm_nonneg _) hB.le)
        _ <= C := by
          dsimp [C]
          linarith
  | middle =>
      obtain ⟨B, hB, hbound⟩ :=
        exists_norm_iteratedDeriv_coordinateMiddleMeridianLocalizedIntegral_le (d - 2) k
      let C : Real := ‖(surfaceMass (d - 1) : Complex)‖ * B * 128 ^ k + 1
      refine ⟨C, by dsimp [C]; positivity, ?_⟩
      intro a rho ha0 ha
      have hscale : |2 * Real.pi * a| <= 128 :=
        brrs_lowRadius_phaseScale_le ha0 ha
      have hpow : |2 * Real.pi * a| ^ k <= (128 : Real) ^ k :=
        pow_le_pow_left₀ (abs_nonneg _) hscale _
      have hk : ((k : ENat) : WithTop ENat) <= ((⊤ : ENat) : WithTop ENat) := by
        exact_mod_cast le_top
      unfold brrsSurfaceWaveAmplitude
      rw [iteratedDeriv_const_mul_field,
        iteratedDeriv_comp_const_smul
          ((contDiff_coordinateMiddleMeridianLocalizedIntegral (d - 2)).of_le hk),
        norm_mul, norm_smul, Real.norm_eq_abs, abs_pow]
      calc
        ‖(surfaceMass (d - 1) : Complex)‖ *
            (|2 * Real.pi * a| ^ k *
              ‖iteratedDeriv k
                (coordinateMiddleMeridianLocalizedIntegral (d - 2))
                ((2 * Real.pi * a) * rho)‖) <=
            ‖(surfaceMass (d - 1) : Complex)‖ *
              (|2 * Real.pi * a| ^ k * B) := by
          gcongr
          exact hbound _
        _ = (‖(surfaceMass (d - 1) : Complex)‖ * B) * |2 * Real.pi * a| ^ k := by
          ring
        _ <= (‖(surfaceMass (d - 1) : Complex)‖ * B) * (128 : Real) ^ k := by
          exact mul_le_mul_of_nonneg_left hpow (mul_nonneg (norm_nonneg _) hB.le)
        _ <= C := by
          dsimp [C]
          linarith

/-- Finitely many radial derivatives of a BRRS surface-wave amplitude admit
one simultaneous bound on the compact low-radius region and the level-zero
frequency annulus.  This is the form used in finite-order integration by
parts. -/
theorem exists_uniform_iteratedDeriv_brrsSurfaceWaveAmplitude_lowRadius_bound
    (d N : Nat) (part : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k <= N -> ∀ a rho : Real,
      0 <= a -> a <= 16 -> rho ∈ Icc (1 / 32 : Real) 1 ->
        ‖iteratedDeriv k (fun u : Real =>
          brrsSurfaceWaveAmplitude d part a u) rho‖ <= C := by
  choose A hApos hAbound using fun k : Nat =>
    exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_lowRadius_bound d k part
  let C : Real := ∑ k ∈ Finset.range (N + 1), A k
  have hC : 0 < C := by
    have hzero : 0 ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    have hle : A 0 <= C := by
      dsimp [C]
      exact Finset.single_le_sum (fun k hk => (hApos k).le) hzero
    exact lt_of_lt_of_le (hApos 0) hle
  refine ⟨C, hC, ?_⟩
  intro k hk a rho ha0 ha hrho
  have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
  have hle : A k <= C := by
    dsimp [C]
    exact Finset.single_le_sum (fun l hl => (hApos l).le) hkmem
  exact (hAbound k a rho ha0 ha).trans hle

/-- When one physical radius is in the compact low-radius region and the
other is high, the two-radius stationary coefficient retains exactly the
high-radius half-density decay.  This is the mixed counterpart of the
high--high differential estimate. -/
theorem exists_uniform_iteratedDeriv_brrsTwoRadiusStationaryCoefficient_lowHigh_decay
    {d N : Nat} (hd : 3 <= d) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k <= N -> ∀ r s rho : Real,
      0 <= r -> r <= 16 -> 16 <= s -> rho ∈ Icc (1 / 32 : Real) 1 ->
        ‖iteratedDeriv k (fun u : Real =>
          brrsTwoRadiusStationaryCoefficient Phi d partR partS r s u) rho‖ <=
          C / (Real.sqrt (s / 16)) ^ (d - 1) := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_iteratedDeriv_brrsSurfaceWaveAmplitude_lowRadius_bound d N partR
  obtain ⟨B, hB, hBbound⟩ :=
    exists_uniform_iteratedDeriv_brrsStationaryWaveRadialCoefficient_highRadius_decay
      (d := d) (N := N) hd Phi partS
  let C : Real := ∑ l ∈ Finset.range (N + 1),
    brrsStationaryLeibnizConstant l A B
  have hCnonneg : 0 <= C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact brrsStationaryLeibnizConstant_nonneg l hA.le hB.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk r s rho hr0 hr hs hrho
  let left : Real → Complex := fun u : Real =>
    brrsSurfaceWaveAmplitude d partR r u
  let right : Real → Complex := fun u : Real =>
    brrsStationaryWaveRadialCoefficient Phi d partS s u
  have hleft : ContDiff Real (⊤ : ENat) left := by
    dsimp [left]
    exact contDiff_brrsSurfaceWaveAmplitude d partR r
  have hright : ContDiff Real (⊤ : ENat) right := by
    dsimp [right]
    exact contDiff_brrsStationaryWaveRadialCoefficient Phi d partS s
  have hqpos : 0 < (Real.sqrt (s / 16)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hleftbound : ∀ l : Nat, l <= k ->
      ‖iteratedDeriv l left rho‖ <= A := by
    intro l hl
    exact hAbound l (hl.trans hk) r rho hr0 hr hrho
  have hrightbound : ∀ l : Nat, l <= k ->
      ‖iteratedDeriv l right rho‖ <=
        B / (Real.sqrt (s / 16)) ^ (d - 1) := by
    intro l hl
    exact hBbound l (hl.trans hk) s rho hs hrho
  have hprod := norm_iteratedDeriv_mul_le_brrsStationaryLeibnizConstant
    (n := k) hleft hright hA.le
    (div_nonneg hB.le hqpos.le) hleftbound hrightbound
  have hfactorfun : (fun u : Real =>
      brrsTwoRadiusStationaryCoefficient Phi d partR partS r s u) =
      fun u : Real => left u * right u := by
    funext u
    dsimp [left, right]
    exact brrsTwoRadiusStationaryCoefficient_eq_amplitude_mul_coefficient
      Phi d partR partS r s u
  rw [hfactorfun]
  have hCbound : brrsStationaryLeibnizConstant k A B <= C := by
    unfold C
    have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    exact Finset.single_le_sum
      (fun l hl => brrsStationaryLeibnizConstant_nonneg l hA.le hB.le) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real => left u * right u) rho‖ <=
        brrsStationaryLeibnizConstant k A
          (B / (Real.sqrt (s / 16)) ^ (d - 1)) := hprod
    _ = brrsStationaryLeibnizConstant k A B /
          (Real.sqrt (s / 16)) ^ (d - 1) := by
      rw [brrsStationaryLeibnizConstant_right_div k A B
        ((Real.sqrt (s / 16)) ^ (d - 1)) hqpos.ne']
    _ <= C / (Real.sqrt (s / 16)) ^ (d - 1) :=
      div_le_div_of_nonneg_right hCbound hqpos.le
    _ <= (C + 1) / (Real.sqrt (s / 16)) ^ (d - 1) :=
      div_le_div_of_nonneg_right (by linarith) hqpos.le

/-- The two-radius stationary coefficient is symmetric in its two labelled
surface-wave factors. -/
theorem brrsTwoRadiusStationaryCoefficient_swap
    (Phi : BRRSAnnularCutoff) (d : Nat)
    (partR partS : BRRSSurfaceWavePart) (r s rho : Real) :
    brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho =
      brrsTwoRadiusStationaryCoefficient Phi d partS partR s r rho := by
  unfold brrsTwoRadiusStationaryCoefficient
  ring

/-- The counterpart of the low--high estimate with the first physical radius
high and the second in the compact low-radius region. -/
theorem exists_uniform_iteratedDeriv_brrsTwoRadiusStationaryCoefficient_highLow_decay
    {d N : Nat} (hd : 3 <= d) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k <= N -> ∀ r s rho : Real,
      16 <= r -> 0 <= s -> s <= 16 -> rho ∈ Icc (1 / 32 : Real) 1 ->
        ‖iteratedDeriv k (fun u : Real =>
          brrsTwoRadiusStationaryCoefficient Phi d partR partS r s u) rho‖ <=
          C / (Real.sqrt (r / 16)) ^ (d - 1) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_uniform_iteratedDeriv_brrsTwoRadiusStationaryCoefficient_lowHigh_decay
      (d := d) (N := N) hd Phi partS partR
  refine ⟨C, hC, ?_⟩
  intro k hk r s rho hr hs0 hs hrho
  have hswap : (fun u : Real =>
      brrsTwoRadiusStationaryCoefficient Phi d partR partS r s u) =
      fun u : Real =>
        brrsTwoRadiusStationaryCoefficient Phi d partS partR s r u := by
    funext u
    exact brrsTwoRadiusStationaryCoefficient_swap Phi d partR partS r s u
  rw [hswap]
  exact hbound k hk s r rho hs0 hs hr hrho

/-- A reusable rapid-profile estimate for a compact frequency integral once
all radial derivatives of its stationary coefficient have a common spatial
weight.  The hypotheses deliberately separate the geometric radius condition
from the integration-by-parts argument, so the lemma applies equally to the
low--high and high--low regimes. -/
theorem exists_norm_intervalIntegral_brrsTwoRadStatCoeff_profile_le_of_deriv_decay
    {d N : Nat} (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart)
    (H : Real → Real → Prop) (q : Real → Real → Real)
    (hq : ∀ r s : Real, H r s → 0 < q r s)
    (hderiv : ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ r s rho : Real,
      H r s → rho ∈ Icc (1 / 32 : Real) 1 →
        ‖iteratedDeriv k (fun u : Real =>
          brrsTwoRadiusStationaryCoefficient Phi d partR partS r s u) rho‖ ≤
          C / q r s) :
    ∃ C : Real, 0 < C ∧ ∀ r s freq : Real, H r s →
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
          oscillatoryExp freq rho‖ ≤
        (1 - (1 / 32 : Real)) * (C / q r s) *
          brrsStationaryRapidProfile N freq := by
  obtain ⟨C, hC, hbound⟩ := hderiv
  refine ⟨C, hC, ?_⟩
  intro r s freq hrs
  have hqpos : 0 < q r s := hq r s hrs
  have hCq_nonneg : 0 ≤ C / q r s :=
    div_nonneg hC.le hqpos.le
  have huniform : ‖∫ rho in (1 / 32 : Real)..1,
      brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
        oscillatoryExp freq rho‖ ≤
      (1 - (1 / 32 : Real)) * (C / q r s) := by
    calc
      ‖∫ rho in (1 / 32 : Real)..1,
          brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
            oscillatoryExp freq rho‖ ≤
          (C / q r s) * |1 - (1 / 32 : Real)| := by
        apply intervalIntegral.norm_integral_le_of_norm_le_const
        intro rho hrho
        have hrho' : rho ∈ Icc (1 / 32 : Real) 1 := by
          rw [uIoc_of_le (by norm_num : (1 / 32 : Real) ≤ 1)] at hrho
          exact ⟨hrho.1.le, hrho.2⟩
        rw [norm_mul, norm_oscillatoryExp, mul_one]
        exact hbound 0 (Nat.zero_le _) r s rho hrs hrho'
      _ = (1 - (1 / 32 : Real)) * (C / q r s) := by
        rw [abs_of_nonneg (by norm_num : (0 : Real) ≤ 1 - 1 / 32)]
        ring
  let A : Real := (1 - (1 / 32 : Real)) * (C / q r s)
  have hAnonneg : 0 ≤ A := by
    dsimp [A]
    exact mul_nonneg (by norm_num) hCq_nonneg
  have huniform' : ‖∫ rho in (1 / 32 : Real)..1,
      brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
        oscillatoryExp freq rho‖ ≤ A := by
    simpa only [A] using huniform
  change ‖∫ rho in (1 / 32 : Real)..1,
      brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
        oscillatoryExp freq rho‖ ≤ A * brrsStationaryRapidProfile N freq
  by_cases hfreq : freq = 0
  · simpa [brrsStationaryRapidProfile, hfreq] using huniform'
  · rw [brrsStationaryRapidProfile, if_neg hfreq]
    let z : Real := (1 / |freq|) ^ N
    have hchain := hasOscillatoryIBPChain_iteratedDeriv_of_contDiff
      (fun rho : Real => brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho)
      (contDiff_brrsTwoRadiusStationaryCoefficient Phi d partR partS r s)
      (brrsTwoRadiusStationaryCoefficient_eventuallyEq_zero_at_lower
        Phi d partR partS r s)
      (brrsTwoRadiusStationaryCoefficient_eventuallyEq_zero_at_upper
        Phi d partR partS r s) N
    have hdecay' : ‖∫ rho in (1 / 32 : Real)..1,
        brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
          oscillatoryExp freq rho‖ ≤ z * A := by
      dsimp [z, A]
      simpa only [iteratedDeriv_zero] using
        (norm_intervalIntegral_mul_oscillatoryExp_le_iterated
          (F := fun k => iteratedDeriv k
            (fun rho : Real =>
              brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho))
          (N := N) (by norm_num : (1 / 32 : Real) ≤ 1) hfreq hchain
          hCq_nonneg
          (fun rho hrho => hbound N le_rfl r s rho hrs hrho))
    calc
      ‖∫ rho in (1 / 32 : Real)..1,
          brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
            oscillatoryExp freq rho‖ ≤ min A (z * A) :=
        le_min huniform' hdecay'
      _ = A * min 1 z := by
        calc
          min A (z * A) = min (A * 1) (A * z) := by
            congr 1 <;> ring
          _ = A * min 1 z := (mul_min_of_nonneg 1 z hAnonneg).symm
      _ = A * min 1 ((1 / |freq|) ^ N) := by rfl

/-- In the low--high radial regime, a two-radius stationary component has
the one high-radius half-density and a rapidly decaying scalar phase profile. -/
theorem exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_lowHigh_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ r s freq : Real,
      0 ≤ r → r ≤ 16 → 16 ≤ s →
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
          oscillatoryExp freq rho‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (s / 16)) ^ (d - 1)) *
          brrsStationaryRapidProfile N freq := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadStatCoeff_profile_le_of_deriv_decay
      (d := d) (N := N) Phi partR partS
      (fun r s => 0 ≤ r ∧ r ≤ 16 ∧ 16 ≤ s)
      (fun _ s => (Real.sqrt (s / 16)) ^ (d - 1))
      (by
        intro r s hrs
        apply pow_pos
        apply Real.sqrt_pos.2
        linarith [hrs.2.2])
      (by
        obtain ⟨D, hD, hbound⟩ :=
          exists_uniform_iteratedDeriv_brrsTwoRadiusStationaryCoefficient_lowHigh_decay
            (d := d) (N := N) hd Phi partR partS
        refine ⟨D, hD, ?_⟩
        intro k hk r s rho hrs hrho
        exact hbound k hk r s rho hrs.1 hrs.2.1 hrs.2.2 hrho)
  refine ⟨C, hC, ?_⟩
  intro r s freq hr0 hr hs
  exact hprofile r s freq ⟨hr0, hr, hs⟩

/-- In the high--low radial regime, a two-radius stationary component has
the one high-radius half-density and a rapidly decaying scalar phase profile. -/
theorem exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_highLow_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ r s freq : Real,
      16 ≤ r → 0 ≤ s → s ≤ 16 →
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
          oscillatoryExp freq rho‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
          brrsStationaryRapidProfile N freq := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadStatCoeff_profile_le_of_deriv_decay
      (d := d) (N := N) Phi partR partS
      (fun r s => 16 ≤ r ∧ 0 ≤ s ∧ s ≤ 16)
      (fun r _ => (Real.sqrt (r / 16)) ^ (d - 1))
      (by
        intro r s hrs
        apply pow_pos
        apply Real.sqrt_pos.2
        linarith [hrs.1])
      (by
        obtain ⟨D, hD, hbound⟩ :=
          exists_uniform_iteratedDeriv_brrsTwoRadiusStationaryCoefficient_highLow_decay
            (d := d) (N := N) hd Phi partR partS
        refine ⟨D, hD, ?_⟩
        intro k hk r s rho hrs hrho
        exact hbound k hk r s rho hrs.1 hrs.2.1 hrs.2.2 hrho)
  refine ⟨C, hC, ?_⟩
  intro r s freq hr hs0 hs
  exact hprofile r s freq ⟨hr, hs0, hs⟩

/-- The low--high profile estimate expressed with the literal stationary
carrier restored. -/
theorem exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real,
      0 ≤ r → r ≤ 16 → 16 ≤ s →
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d partR partS r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (s / 16)) ^ (d - 1)) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase partR r +
              brrsSurfaceWavePhase partS s + 2 * Real.pi * t) := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_lowHigh_profile_le
      (d := d) (N := N) hd Phi partR partS
  refine ⟨C, hC, ?_⟩
  intro r s t hr0 hr hs
  rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
  exact hprofile r s
    (brrsSurfaceWavePhase partR r +
      brrsSurfaceWavePhase partS s + 2 * Real.pi * t) hr0 hr hs

/-- The high--low profile estimate expressed with the literal stationary
carrier restored. -/
theorem exists_norm_brrsTwoRadiusStationaryComponentIntegral_highLow_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real,
      16 ≤ r → 0 ≤ s → s ≤ 16 →
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d partR partS r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase partR r +
              brrsSurfaceWavePhase partS s + 2 * Real.pi * t) := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_highLow_profile_le
      (d := d) (N := N) hd Phi partR partS
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs0 hs
  rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
  exact hprofile r s
    (brrsSurfaceWavePhase partR r +
      brrsSurfaceWavePhase partS s + 2 * Real.pi * t) hr hs0 hs

/-! ### The initial radial block `I_0`

The dyadic main-block package starts at the annulus `[h, 2h]`.  The
initial interval `[0, h]` in the proof of BRRS Proposition 5.1 instead uses
the separation of the sampled times: each time has a fixed `O(h)` local
input interval, and these intervals have bounded overlap.  This section
records only that geometric bookkeeping.  The analytic local-profile and
off-diagonal hypotheses remain explicit below.
-/

/-- A finite `len`-separated subset of an interval of length `n * len` has
at most `n + 1` elements. -/
theorem brrs_card_le_succ_of_separated_in_interval
    {S : Finset Real} {a len : Real} {n : Nat} (hlen : 0 < len)
    (hsub : ∀ x ∈ S, x ∈ Icc a (a + (n : Real) * len))
    (hsep : ∀ x ∈ S, ∀ y ∈ S, x ≠ y → len ≤ |x - y|) :
    S.card ≤ n + 1 := by
  classical
  have hcard : S.card ≤ (Finset.Icc (0 : Int) (n : Int)).card := by
    refine Finset.card_le_card_of_injOn (fun x => ⌊(x - a) / len⌋) ?_ ?_
    · intro x hx
      obtain ⟨hleft, hright⟩ := hsub x hx
      have hq0 : (0 : Real) ≤ (x - a) / len :=
        div_nonneg (by linarith) hlen.le
      have hqn : (x - a) / len ≤ (n : Real) := by
        rw [div_le_iff₀ hlen]
        linarith
      refine Finset.mem_Icc.mpr ⟨Int.le_floor.mpr (by simpa using hq0), ?_⟩
      have hfloor := Int.floor_le_floor hqn
      simpa using hfloor
    · intro x hx y hy hfloor
      by_contra hxy
      have hfx : ((⌊(x - a) / len⌋ : Int) : Real) ≤ (x - a) / len :=
        Int.floor_le _
      have hfy : ((⌊(y - a) / len⌋ : Int) : Real) ≤ (y - a) / len :=
        Int.floor_le _
      have hfx' : (x - a) / len < ((⌊(x - a) / len⌋ : Int) : Real) + 1 :=
        Int.lt_floor_add_one _
      have hfy' : (y - a) / len < ((⌊(y - a) / len⌋ : Int) : Real) + 1 :=
        Int.lt_floor_add_one _
      have hfloor' : ⌊(x - a) / len⌋ = ⌊(y - a) / len⌋ := hfloor
      rw [hfloor'] at hfx hfx'
      have hdiff : |(x - a) / len - (y - a) / len| < 1 := by
        rw [abs_lt]
        constructor <;> linarith
      have hlenne : len ≠ 0 := hlen.ne'
      have hxydiv : (x - a) / len - (y - a) / len = (x - y) / len := by
        field_simp
        ring
      rw [hxydiv, abs_div, abs_of_pos hlen, div_lt_one hlen] at hdiff
      exact absurd (hsep x hx y hy hxy) (not_le.mpr hdiff)
  simpa using hcard

/-- The local time interval used for the initial radial block.  Its radius is
eight mesh lengths, matching the localization in BRRS (5.7). -/
def brrsI0TimeCell (h t : Real) : Set Real :=
  Icc (t - 8 * h) (t + 8 * h)

/-- The dyadic specialization of `brrsI0TimeCell`. -/
def brrsDyadicI0TimeCell (j : Nat) (t : Real) : Set Real :=
  brrsI0TimeCell (dyadicTimeScale j) t

/-- At most seventeen pairwise `h`-separated sample times have local
`I_0`-intervals containing one fixed point. -/
theorem brrsI0TimeCell_overlap_le_seventeen
    (T : Finset Real) {h : Real} (hh : 0 < h)
    (hsep : IsSeparated T h) (x : Real) :
    (∑ t ∈ T,
      (brrsI0TimeCell h t).indicator (fun _ => (1 : ENNReal)) x) ≤ 17 := by
  classical
  let Sx : Finset Real := T.filter (fun t => x ∈ brrsI0TimeCell h t)
  have hsub : ∀ t ∈ Sx, t ∈ Icc (x - 8 * h) ((x - 8 * h) + (16 : Real) * h) := by
    intro t ht
    have ht' : t ∈ T ∧ x ∈ brrsI0TimeCell h t := by
      simpa only [Sx, Finset.mem_filter] using ht
    simp only [brrsI0TimeCell, mem_Icc] at ht' ⊢
    constructor <;> linarith
  have hseparated : ∀ t ∈ Sx, ∀ u ∈ Sx, t ≠ u → h ≤ |t - u| := by
    intro t ht u hu htu
    have ht' : t ∈ T ∧ x ∈ brrsI0TimeCell h t := by
      simpa only [Sx, Finset.mem_filter] using ht
    have hu' : u ∈ T ∧ x ∈ brrsI0TimeCell h u := by
      simpa only [Sx, Finset.mem_filter] using hu
    exact hsep (by simpa using ht'.1) (by simpa using hu'.1) htu
  have hcard : Sx.card ≤ 17 := by
    simpa only [show (16 : Nat) + 1 = 17 by norm_num] using
      (brrs_card_le_succ_of_separated_in_interval (n := 16) hh hsub hseparated)
  have hsum :
      (∑ t ∈ T,
        (brrsI0TimeCell h t).indicator (fun _ => (1 : ENNReal)) x) =
        (Sx.card : ENNReal) := by
    calc
      (∑ t ∈ T,
          (brrsI0TimeCell h t).indicator (fun _ => (1 : ENNReal)) x) =
          ∑ t ∈ T, if x ∈ brrsI0TimeCell h t then (1 : ENNReal) else 0 := by
        apply Finset.sum_congr rfl
        intro t ht
        simp only [Set.indicator]
      _ = (Sx.card : ENNReal) := by
        rw [Finset.sum_boole]
  rw [hsum]
  exact_mod_cast hcard

/-- The dyadic local-time intervals inherit the same bounded overlap from a
BRRS discretization. -/
theorem brrsDyadicI0TimeCell_overlap_le_seventeen
    {E : Set Real} (j : Nat) (T : Finset Real)
    (hT : IsDyadicDiscretization E j T) (x : Real) :
    (∑ t ∈ T,
      (brrsDyadicI0TimeCell j t).indicator (fun _ => (1 : ENNReal)) x) ≤ 17 := by
  simpa only [brrsDyadicI0TimeCell] using
    (brrsI0TimeCell_overlap_le_seventeen T
      (by
        unfold dyadicTimeScale
        positivity)
      hT.separated x)

/-- Conditional summation for the initial radial block.  The premise is the
entire analytic input: for every sampled time, its radial mass on `[0,h]` is
controlled by a nonnegative profile on the corresponding local time cell.
The conclusion uses only finite separation and bounded overlap; in
particular, it does not assert an unproved estimate for any half-wave
kernel. -/
theorem brrs_sum_I0_lintegral_le_of_local_profile
    (T : Finset Real) {h : Real} (hh : 0 < h)
    (hsep : IsSeparated T h) (H : Real → Real → ENNReal)
    (G : Real → ENNReal) (hG : Measurable G)
    (hprofile : ∀ t ∈ T,
      (∫⁻ r in Icc (0 : Real) h, H t r) ≤
        ∫⁻ x in brrsI0TimeCell h t, G x) :
    (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) h, H t r) ≤
      17 * ∫⁻ x, G x := by
  have hbound := brrs_fibered_interval_lintegral_le_of_profile_count_and_overlap
    (s := T) (J := brrsI0TimeCell h) (points := fun t : Real => {t})
    (R := Icc (0 : Real) h) (H := H) (G := G) (K := (1 : ENNReal))
    (M := (17 : ENNReal)) hG
    (by
      intro t ht
      exact measurableSet_Icc)
    (by
      intro t ht
      simp)
    (by
      intro x
      exact brrsI0TimeCell_overlap_le_seventeen T hh hsep x)
    (by
      intro t ht u hu
      have htu : u = t := Finset.mem_singleton.mp hu
      subst u
      exact hprofile t ht)
  simpa using hbound

/-- The preceding conditional initial-block estimate in the exact dyadic
notation used by BRRS. -/
theorem brrs_sum_dyadicI0_lintegral_le_of_local_profile
    {E : Set Real} (j : Nat) (T : Finset Real)
    (hT : IsDyadicDiscretization E j T) (H : Real → Real → ENNReal)
    (G : Real → ENNReal) (hG : Measurable G)
    (hprofile : ∀ t ∈ T,
      (∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
        ∫⁻ x in brrsDyadicI0TimeCell j t, G x) :
    (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
      17 * ∫⁻ x, G x := by
  simpa only [brrsDyadicI0TimeCell] using
    (brrs_sum_I0_lintegral_le_of_local_profile T
      (by
        unfold dyadicTimeScale
        positivity)
      hT.separated H G hG hprofile)

/-- Uniform all-order rapid high-radius decay for the middle stationary
surface-wave amplitude.  The exponent `M` is retained, rather than being
specialized to the ambient-dimensional endpoint scale. -/
theorem exists_uniform_iteratedDeriv_brrsSurfaceWaveAmplitude_middle_highRadius_rapidDecay
    {d N M : Nat} (_hd : 3 ≤ d) (hM : 2 ≤ M) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ a rho : Real, 16 ≤ a →
      rho ∈ Icc (1 / 32 : Real) 1 →
      ‖iteratedDeriv k (fun u : Real =>
        brrsSurfaceWaveAmplitude d .middle a u) rho‖ ≤
        C / (Real.sqrt (a / 16)) ^ (M - 1) := by
  choose B hBpos hBbound using fun k : Nat =>
    exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_middle_decay d k (M + k)
  let C : Real := ∑ k ∈ Finset.range (N + 1), B k * (128 : Real) ^ k
  have hC : 0 < C := by
    have hzero : 0 ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    have hle : B 0 * (128 : Real) ^ (0 : Nat) ≤ C := by
      dsimp [C]
      exact Finset.single_le_sum
        (fun k hk => mul_nonneg (hBpos k).le
          (pow_nonneg (show (0 : Real) ≤ 128 by norm_num) k)) hzero
    have hterm : 0 < B 0 * (128 : Real) ^ (0 : Nat) := by
      simpa using hBpos 0
    exact lt_of_lt_of_le hterm hle
  refine ⟨C, hC, ?_⟩
  intro k hk a rho ha hrho
  obtain ⟨hfreq, hamp, hscale, _⟩ :=
    brrs_highRadius_frequency_geometry ha hrho
  have hs : 1 ≤ a / 16 := by linarith
  have hqpos : 0 < (Real.sqrt (a / 16)) ^ (M - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hrapid := brrs_rapid_middle_denominator_le_scale
    (d := M) (k := k) (s := a / 16) (a := 2 * Real.pi * a)
    (lambda := |(2 * Real.pi * a) * rho|) (C := B k) (L := 128)
    hM hs (hBpos k).le (by positivity) hamp hscale
  have hkmem : k ∈ Finset.range (N + 1) :=
    Finset.mem_range.mpr (by omega)
  have hCbound : B k * (128 : Real) ^ k ≤ C := by
    dsimp [C]
    exact Finset.single_le_sum
      (fun l hl => mul_nonneg (hBpos l).le
        (pow_nonneg (show (0 : Real) ≤ 128 by norm_num) l)) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real =>
        brrsSurfaceWaveAmplitude d .middle a u) rho‖ ≤
        B k * |2 * Real.pi * a| ^ k /
          |(2 * Real.pi * a) * rho| ^ (M + k) :=
      hBbound k a rho hfreq
    _ ≤ (B k * 128 ^ k) / (Real.sqrt (a / 16)) ^ (M - 1) := hrapid
    _ ≤ C / (Real.sqrt (a / 16)) ^ (M - 1) :=
      div_le_div_of_nonneg_right hCbound hqpos.le

/-- The compact radial coefficient inherits the all-order rapid high-radius
decay of its middle stationary-wave factor. -/
theorem exists_uniform_iteratedDeriv_brrsStatWaveRadialCoeff_middle_highRad_rapidDecay
    {d N M : Nat} (hd : 3 ≤ d) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ a rho : Real, 16 ≤ a →
      rho ∈ Icc (1 / 32 : Real) 1 →
      ‖iteratedDeriv k (fun u : Real =>
        brrsStationaryWaveRadialCoefficient Phi d .middle a u) rho‖ ≤
        C / (Real.sqrt (a / 16)) ^ (M - 1) := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_iteratedDeriv_brrsStationaryWaveRadialFixedFactor_bound Phi d N
  obtain ⟨B, hB, hBbound⟩ :=
    exists_uniform_iteratedDeriv_brrsSurfaceWaveAmplitude_middle_highRadius_rapidDecay
      (d := d) (N := N) (M := M) hd hM
  let C : Real := ∑ l ∈ Finset.range (N + 1),
    brrsStationaryLeibnizConstant l A B
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact brrsStationaryLeibnizConstant_nonneg l hA.le hB.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk a rho ha hrho
  let fixed : Real → Complex := brrsStationaryWaveRadialFixedFactor Phi d
  let physical : Real → Complex := fun u : Real =>
    brrsSurfaceWaveAmplitude d .middle a u
  have hfixed : ContDiff Real (⊤ : ENat) fixed := by
    dsimp [fixed]
    exact contDiff_brrsStationaryWaveRadialFixedFactor Phi d
  have hphysical : ContDiff Real (⊤ : ENat) physical := by
    dsimp [physical]
    exact contDiff_brrsSurfaceWaveAmplitude d .middle a
  have hqpos : 0 < (Real.sqrt (a / 16)) ^ (M - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hphysicalBound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l physical rho‖ ≤
        B / (Real.sqrt (a / 16)) ^ (M - 1) := by
    intro l hl
    exact hBbound l (hl.trans hk) a rho ha hrho
  have hprod := norm_iteratedDeriv_mul_le_brrsStationaryLeibnizConstant
    (n := k) hfixed hphysical hA.le
    (div_nonneg hB.le hqpos.le)
    (fun l hl => hAbound l (hl.trans hk) rho hrho)
    hphysicalBound
  have hfactorfun : (fun u : Real =>
      brrsStationaryWaveRadialCoefficient Phi d .middle a u) =
      fun u : Real => fixed u * physical u := by
    funext u
    dsimp [fixed, physical]
    unfold brrsStationaryWaveRadialCoefficient
      brrsStationaryWaveRadialFixedFactor
    ring
  rw [hfactorfun]
  have hCbound : brrsStationaryLeibnizConstant k A B ≤ C := by
    unfold C
    have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    exact Finset.single_le_sum
      (fun l hl => brrsStationaryLeibnizConstant_nonneg l hA.le hB.le) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real => fixed u * physical u) rho‖ ≤
        brrsStationaryLeibnizConstant k A
          (B / (Real.sqrt (a / 16)) ^ (M - 1)) := hprod
    _ = brrsStationaryLeibnizConstant k A B /
          (Real.sqrt (a / 16)) ^ (M - 1) := by
      rw [brrsStationaryLeibnizConstant_right_div k A B
        ((Real.sqrt (a / 16)) ^ (M - 1)) hqpos.ne']
    _ ≤ C / (Real.sqrt (a / 16)) ^ (M - 1) :=
      div_le_div_of_nonneg_right hCbound hqpos.le
    _ ≤ (C + 1) / (Real.sqrt (a / 16)) ^ (M - 1) :=
      div_le_div_of_nonneg_right (by linarith) hqpos.le

/-- A two-radius coefficient with a middle factor in its first radius has
rapid decay in that radius together with the usual endpoint-scale decay in
the second.  In particular this applies when `partS` is outgoing or incoming. -/
theorem exists_uniform_iteratedDeriv_brrsTwoRadStatCoeff_middle_highRad_rapidDecay
    {d N M : Nat} (hd : 3 ≤ d) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff)
    (partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ r s rho : Real,
      16 ≤ r → 16 ≤ s → rho ∈ Icc (1 / 32 : Real) 1 →
      ‖iteratedDeriv k (fun u : Real =>
        brrsTwoRadiusStationaryCoefficient Phi d .middle partS r s u) rho‖ ≤
        C / ((Real.sqrt (r / 16)) ^ (M - 1) *
          (Real.sqrt (s / 16)) ^ (d - 1)) := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_iteratedDeriv_brrsSurfaceWaveAmplitude_middle_highRadius_rapidDecay
      (d := d) (N := N) (M := M) hd hM
  obtain ⟨B, hB, hBbound⟩ :=
    exists_uniform_iteratedDeriv_brrsStationaryWaveRadialCoefficient_highRadius_decay
      (d := d) (N := N) hd Phi partS
  let C : Real := ∑ l ∈ Finset.range (N + 1),
    brrsStationaryLeibnizConstant l A B
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact brrsStationaryLeibnizConstant_nonneg l hA.le hB.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk r s rho hr hs hrho
  let left : Real → Complex := fun u : Real =>
    brrsSurfaceWaveAmplitude d .middle r u
  let right : Real → Complex := fun u : Real =>
    brrsStationaryWaveRadialCoefficient Phi d partS s u
  have hleft : ContDiff Real (⊤ : ENat) left := by
    dsimp [left]
    exact contDiff_brrsSurfaceWaveAmplitude d .middle r
  have hright : ContDiff Real (⊤ : ENat) right := by
    dsimp [right]
    exact contDiff_brrsStationaryWaveRadialCoefficient Phi d partS s
  have hqpos : 0 < (Real.sqrt (r / 16)) ^ (M - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hspos : 0 < (Real.sqrt (s / 16)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hleftbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l left rho‖ ≤
        A / (Real.sqrt (r / 16)) ^ (M - 1) := by
    intro l hl
    exact hAbound l (hl.trans hk) r rho hr hrho
  have hrightbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l right rho‖ ≤
        B / (Real.sqrt (s / 16)) ^ (d - 1) := by
    intro l hl
    exact hBbound l (hl.trans hk) s rho hs hrho
  have hprod := norm_iteratedDeriv_mul_le_brrsStationaryLeibnizConstant
    (n := k) hleft hright
    (div_nonneg hA.le hqpos.le) (div_nonneg hB.le hspos.le)
    hleftbound hrightbound
  have hfactorfun : (fun u : Real =>
      brrsTwoRadiusStationaryCoefficient Phi d .middle partS r s u) =
      fun u : Real => left u * right u := by
    funext u
    dsimp [left, right]
    unfold brrsTwoRadiusStationaryCoefficient
      brrsStationaryWaveRadialCoefficient
    ring
  rw [hfactorfun]
  have hCbound : brrsStationaryLeibnizConstant k A B ≤ C := by
    unfold C
    have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    exact Finset.single_le_sum
      (fun l hl => brrsStationaryLeibnizConstant_nonneg l hA.le hB.le) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real => left u * right u) rho‖ ≤
        brrsStationaryLeibnizConstant k
          (A / (Real.sqrt (r / 16)) ^ (M - 1))
          (B / (Real.sqrt (s / 16)) ^ (d - 1)) := hprod
    _ = brrsStationaryLeibnizConstant k A B /
          ((Real.sqrt (r / 16)) ^ (M - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1)) := by
      rw [brrsStationaryLeibnizConstant_two_div k A B
        ((Real.sqrt (r / 16)) ^ (M - 1))
        ((Real.sqrt (s / 16)) ^ (d - 1)) hqpos.ne' hspos.ne']
    _ ≤ C / ((Real.sqrt (r / 16)) ^ (M - 1) *
          (Real.sqrt (s / 16)) ^ (d - 1)) :=
      div_le_div_of_nonneg_right hCbound (mul_pos hqpos hspos).le
    _ ≤ (C + 1) / ((Real.sqrt (r / 16)) ^ (M - 1) *
          (Real.sqrt (s / 16)) ^ (d - 1)) :=
      div_le_div_of_nonneg_right (by linarith) (mul_pos hqpos hspos).le

/-- When both two-radius stationary factors are middle waves, their two
independent middle remainders give arbitrary high-radius decay in each radial
variable.  Unlike the middle--endpoint estimate, this keeps both rapid
denominators, which is necessary to transfer the zero carrier to one of the
four endpoint phase lines without changing the radial half-density. -/
theorem exists_unif_iteratedDeriv_brrsTwoRadStatCoeff_middle_middle_highRad_rapidDecay
    {d N M : Nat} (hd : 3 ≤ d) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ r s rho : Real,
      16 ≤ r → 16 ≤ s → rho ∈ Icc (1 / 32 : Real) 1 →
      ‖iteratedDeriv k (fun u : Real =>
        brrsTwoRadiusStationaryCoefficient Phi d .middle .middle r s u) rho‖ ≤
        C / ((Real.sqrt (r / 16)) ^ (M - 1) *
          (Real.sqrt (s / 16)) ^ (M - 1)) := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_iteratedDeriv_brrsSurfaceWaveAmplitude_middle_highRadius_rapidDecay
      (d := d) (N := N) (M := M) hd hM
  obtain ⟨B, hB, hBbound⟩ :=
    exists_uniform_iteratedDeriv_brrsStatWaveRadialCoeff_middle_highRad_rapidDecay
      (d := d) (N := N) (M := M) hd hM Phi
  let C : Real := ∑ l ∈ Finset.range (N + 1),
    brrsStationaryLeibnizConstant l A B
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact brrsStationaryLeibnizConstant_nonneg l hA.le hB.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk r s rho hr hs hrho
  let left : Real → Complex := fun u : Real =>
    brrsSurfaceWaveAmplitude d .middle r u
  let right : Real → Complex := fun u : Real =>
    brrsStationaryWaveRadialCoefficient Phi d .middle s u
  have hleft : ContDiff Real (⊤ : ENat) left := by
    dsimp [left]
    exact contDiff_brrsSurfaceWaveAmplitude d .middle r
  have hright : ContDiff Real (⊤ : ENat) right := by
    dsimp [right]
    exact contDiff_brrsStationaryWaveRadialCoefficient Phi d .middle s
  have hrpos : 0 < (Real.sqrt (r / 16)) ^ (M - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hspos : 0 < (Real.sqrt (s / 16)) ^ (M - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hleftbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l left rho‖ ≤
        A / (Real.sqrt (r / 16)) ^ (M - 1) := by
    intro l hl
    exact hAbound l (hl.trans hk) r rho hr hrho
  have hrightbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l right rho‖ ≤
        B / (Real.sqrt (s / 16)) ^ (M - 1) := by
    intro l hl
    exact hBbound l (hl.trans hk) s rho hs hrho
  have hprod := norm_iteratedDeriv_mul_le_brrsStationaryLeibnizConstant
    (n := k) hleft hright
    (div_nonneg hA.le hrpos.le) (div_nonneg hB.le hspos.le)
    hleftbound hrightbound
  have hfactorfun : (fun u : Real =>
      brrsTwoRadiusStationaryCoefficient Phi d .middle .middle r s u) =
      fun u : Real => left u * right u := by
    funext u
    dsimp [left, right]
    unfold brrsTwoRadiusStationaryCoefficient
      brrsStationaryWaveRadialCoefficient
    ring
  rw [hfactorfun]
  have hCbound : brrsStationaryLeibnizConstant k A B ≤ C := by
    unfold C
    have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    exact Finset.single_le_sum
      (fun l hl => brrsStationaryLeibnizConstant_nonneg l hA.le hB.le) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real => left u * right u) rho‖ ≤
        brrsStationaryLeibnizConstant k
          (A / (Real.sqrt (r / 16)) ^ (M - 1))
          (B / (Real.sqrt (s / 16)) ^ (M - 1)) := hprod
    _ = brrsStationaryLeibnizConstant k A B /
          ((Real.sqrt (r / 16)) ^ (M - 1) *
            (Real.sqrt (s / 16)) ^ (M - 1)) := by
      rw [brrsStationaryLeibnizConstant_two_div k A B
        ((Real.sqrt (r / 16)) ^ (M - 1))
        ((Real.sqrt (s / 16)) ^ (M - 1)) hrpos.ne' hspos.ne']
    _ ≤ C / ((Real.sqrt (r / 16)) ^ (M - 1) *
          (Real.sqrt (s / 16)) ^ (M - 1)) :=
      div_le_div_of_nonneg_right hCbound (mul_pos hrpos hspos).le
    _ ≤ (C + 1) / ((Real.sqrt (r / 16)) ^ (M - 1) *
          (Real.sqrt (s / 16)) ^ (M - 1)) :=
      div_le_div_of_nonneg_right (by linarith) (mul_pos hrpos hspos).le

/-- A high--high stationary coefficient with a middle first wave has its
arbitrary middle-radius decay together with a compact rapid frequency
profile.  The second wave is retained as the explicit `partS` parameter. -/
theorem exists_norm_intervalInteg_brrsTwoRadStatCoeff_middle_highRad_rapidProfile_le
    {d N M : Nat} (hd : 3 ≤ d) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff)
    (partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ r s freq : Real, 16 ≤ r → 16 ≤ s →
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsTwoRadiusStationaryCoefficient Phi d .middle partS r s rho *
          oscillatoryExp freq rho‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (M - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1))) *
          brrsStationaryRapidProfile N freq := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadStatCoeff_profile_le_of_deriv_decay
      (d := d) (N := N) Phi .middle partS
      (fun r s => 16 ≤ r ∧ 16 ≤ s)
      (fun r s => (Real.sqrt (r / 16)) ^ (M - 1) *
        (Real.sqrt (s / 16)) ^ (d - 1))
      (by
        intro r s hrs
        apply mul_pos
        · apply pow_pos
          apply Real.sqrt_pos.2
          linarith [hrs.1]
        · apply pow_pos
          apply Real.sqrt_pos.2
          linarith [hrs.2])
      (by
        obtain ⟨C, hC, hderiv⟩ :=
          exists_uniform_iteratedDeriv_brrsTwoRadStatCoeff_middle_highRad_rapidDecay
            (d := d) (N := N) (M := M) hd hM Phi partS
        refine ⟨C, hC, ?_⟩
        intro k hk r s rho hrs hrho
        exact hderiv k hk r s rho hrs.1 hrs.2 hrho)
  refine ⟨C, hC, ?_⟩
  intro r s freq hr hs
  exact hprofile r s freq ⟨hr, hs⟩

/-- The compact-frequency profile of a generic-dimensional middle--middle
coefficient retains the independently rapid decay in both high radii. -/
theorem exists_norm_ivlInteg_brrsTwoRadStatCoeff_middle_middle_highRad_rapidProf_le
    {d N M : Nat} (hd : 3 ≤ d) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s freq : Real, 16 ≤ r → 16 ≤ s →
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsTwoRadiusStationaryCoefficient Phi d .middle .middle r s rho *
          oscillatoryExp freq rho‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (M - 1) *
            (Real.sqrt (s / 16)) ^ (M - 1))) *
          brrsStationaryRapidProfile N freq := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadStatCoeff_profile_le_of_deriv_decay
      (d := d) (N := N) Phi .middle .middle
      (fun r s => 16 ≤ r ∧ 16 ≤ s)
      (fun r s => (Real.sqrt (r / 16)) ^ (M - 1) *
        (Real.sqrt (s / 16)) ^ (M - 1))
      (by
        intro r s hrs
        apply mul_pos <;> apply pow_pos <;> apply Real.sqrt_pos.2 <;>
          linarith)
      (by
        obtain ⟨C, hC, hderiv⟩ :=
          exists_unif_iteratedDeriv_brrsTwoRadStatCoeff_middle_middle_highRad_rapidDecay
            (d := d) (N := N) (M := M) hd hM Phi
        refine ⟨C, hC, ?_⟩
        intro k hk r s rho hrs hrho
        exact hderiv k hk r s rho hrs.1 hrs.2 hrho)
  refine ⟨C, hC, ?_⟩
  intro r s freq hr hs
  exact hprofile r s freq ⟨hr, hs⟩

/-- The preceding compact-frequency profile estimate with the literal
stationary carrier restored.  This treats only the named middle--`partS`
component and does not combine it with any other component. -/
theorem exists_norm_brrsTwoRadStatComponentIntegral_middle_highRad_rapidProfile_le
    {d N M : Nat} (hd : 3 ≤ d) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff)
    (partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d .middle partS r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (M - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1))) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase partS s + 2 * Real.pi * t) := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_intervalInteg_brrsTwoRadStatCoeff_middle_highRad_rapidProfile_le
      (d := d) (N := N) (M := M) hd hM Phi partS
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
  exact hprofile r s
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase partS s + 2 * Real.pi * t) hr hs

/-- Restoring the stationary carrier in the generic-dimensional middle--middle
estimate keeps the two rapid radial denominators visible for the four-sign
kernel reduction. -/
theorem exists_norm_brrsTwoRadStatCompIntegral_middle_middle_highRad_rapidProfile_le
    {d N M : Nat} (hd : 3 ≤ d) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d .middle .middle r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (M - 1) *
            (Real.sqrt (s / 16)) ^ (M - 1))) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_ivlInteg_brrsTwoRadStatCoeff_middle_middle_highRad_rapidProf_le
      (d := d) (N := N) (M := M) hd hM Phi
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
  exact hprofile r s
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) hr hs

/-- Uniform all-order rapid high-radius decay for the literal
two-dimensional middle stationary-wave amplitude.  This keeps the arbitrary
middle exponent rather than replacing it by the half-order endpoint scale. -/
theorem exists_unif_iteratedDeriv_brrsSurfWaveAmplitude_two_middle_highRad_rapidDecay
    (N M : Nat) (hM : 2 ≤ M) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ a rho : Real, 16 ≤ a →
      rho ∈ Icc (1 / 32 : Real) 1 →
      ‖iteratedDeriv k (fun u : Real =>
        brrsSurfaceWaveAmplitude 2 .middle a u) rho‖ ≤
        C / (Real.sqrt (a / 16)) ^ (M - 1) := by
  choose B hBpos hBbound using fun k : Nat =>
    exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_middle_decay 2 k (M + k)
  let C : Real := ∑ k ∈ Finset.range (N + 1), B k * (128 : Real) ^ k
  have hC : 0 < C := by
    have hzero : 0 ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    have hle : B 0 * (128 : Real) ^ (0 : Nat) ≤ C := by
      dsimp [C]
      exact Finset.single_le_sum
        (fun k hk => mul_nonneg (hBpos k).le
          (pow_nonneg (show (0 : Real) ≤ 128 by norm_num) k)) hzero
    have hterm : 0 < B 0 * (128 : Real) ^ (0 : Nat) := by
      simpa using hBpos 0
    exact lt_of_lt_of_le hterm hle
  refine ⟨C, hC, ?_⟩
  intro k hk a rho ha hrho
  obtain ⟨hfreq, hamp, hscale, _⟩ :=
    brrs_highRadius_frequency_geometry ha hrho
  have hs : 1 ≤ a / 16 := by linarith
  have hqpos : 0 < (Real.sqrt (a / 16)) ^ (M - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hrapid := brrs_rapid_middle_denominator_le_scale
    (d := M) (k := k) (s := a / 16) (a := 2 * Real.pi * a)
    (lambda := |(2 * Real.pi * a) * rho|) (C := B k) (L := 128)
    hM hs (hBpos k).le (by positivity) hamp hscale
  have hkmem : k ∈ Finset.range (N + 1) :=
    Finset.mem_range.mpr (by omega)
  have hCbound : B k * (128 : Real) ^ k ≤ C := by
    dsimp [C]
    exact Finset.single_le_sum
      (fun l hl => mul_nonneg (hBpos l).le
        (pow_nonneg (show (0 : Real) ≤ 128 by norm_num) l)) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real =>
        brrsSurfaceWaveAmplitude 2 .middle a u) rho‖ ≤
        B k * |2 * Real.pi * a| ^ k /
          |(2 * Real.pi * a) * rho| ^ (M + k) :=
      hBbound k a rho hfreq
    _ ≤ (B k * 128 ^ k) / (Real.sqrt (a / 16)) ^ (M - 1) := hrapid
    _ ≤ C / (Real.sqrt (a / 16)) ^ (M - 1) :=
      div_le_div_of_nonneg_right hCbound hqpos.le

end


