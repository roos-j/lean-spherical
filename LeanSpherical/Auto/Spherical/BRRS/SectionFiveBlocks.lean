  obtain ⟨C, hC, hmajorant⟩ :=
    exists_brrsLevelZeroKernelRefinedGlobalRadialMajorant
      (d := d) (N := N) (M := M) hd hM Phi
  refine ⟨C, hC, ?_⟩
  intro t
  exact lintegral_enorm_brrsDyadicHalfWaveKernel_le_radial_polar_majorant
    (lt_of_lt_of_le (by norm_num) hd) Phi 0 t
    (brrsLevelZeroKernelRefinedGlobalRadialMajorant d N M
      (∫ xi : Euclidean d, ‖brrsDyadicMultiplierSchwartz Phi 0 xi‖) C t)
    (measurable_brrsLevelZeroKernelRefinedGlobalRadialMajorant d N M
      (∫ xi : Euclidean d, ‖brrsDyadicMultiplierSchwartz Phi 0 xi‖) C t)
    (hmajorant t)

/-- The bounded rapid profile produced by stationary phase is controlled by
the standard integrable Japanese-bracket power.  Keeping this elementary
comparison separate makes later scalar radial estimates independent of the
particular integration-by-parts construction of the profile. -/
theorem brrsStationaryRapidProfile_le_japaneseBracket
    (N : Nat) (u : Real) :
    brrsStationaryRapidProfile N u ≤
      (2 : Real) ^ N * ((1 + |u|)⁻¹) ^ N := by
  by_cases hu : u = 0
  · simp only [brrsStationaryRapidProfile, hu, abs_zero, add_zero,
      inv_one, one_pow, mul_one]
    exact one_le_pow₀ (by norm_num)
  rw [brrsStationaryRapidProfile, if_neg hu]
  by_cases hsmall : |u| ≤ 1
  · calc
      min 1 ((1 / |u|) ^ N) ≤ 1 := min_le_left _ _
      _ = (2 : Real) ^ N * ((2 : Real)⁻¹) ^ N := by
        rw [← mul_pow]
        norm_num
      _ ≤ (2 : Real) ^ N * ((1 + |u|)⁻¹) ^ N := by
        apply mul_le_mul_of_nonneg_left
        · apply pow_le_pow_left₀
          · positivity
          · exact (inv_le_inv₀ (by norm_num : (0 : Real) < 2)
              (by positivity : 0 < 1 + |u|)).mpr (by linarith)
        · positivity
  · have hlarge : 1 ≤ |u| := le_of_not_ge hsmall
    have habspos : 0 < |u| := lt_of_lt_of_le (by norm_num) hlarge
    have hdenpos : 0 < 1 + |u| := by positivity
    have hbase : 1 / |u| ≤ 2 * (1 + |u|)⁻¹ := by
      rw [show (2 : Real) * (1 + |u|)⁻¹ = 2 / (1 + |u|) by field_simp]
      apply (div_le_div_iff₀ habspos hdenpos).mpr
      nlinarith
    calc
      min 1 ((1 / |u|) ^ N) ≤ (1 / |u|) ^ N := min_le_right _ _
      _ ≤ (2 * (1 + |u|)⁻¹) ^ N := by
        apply pow_le_pow_left₀
        · positivity
        · exact hbase
      _ = (2 : Real) ^ N * ((1 + |u|)⁻¹) ^ N := by rw [mul_pow]

/-- The Japanese-bracket majorant for a sufficiently high stationary profile
is integrable on the real line. -/
theorem integrable_brrsJapaneseBracket (N : Nat) (hN : 2 ≤ N) :
    Integrable (fun u : Real => ((1 + |u|)⁻¹) ^ N) := by
  have hN' : (1 : Real) < (N : Real) := by
    exact_mod_cast (show 1 < N by omega)
  have hfin : (Module.finrank Real Real : Real) < (N : Real) := by
    simpa using hN'
  have hint := integrable_one_add_norm (E := Real) (μ := volume)
    (r := (N : Real)) hfin
  convert hint using 1
  ext u
  simp only [Real.norm_eq_abs]
  rw [Real.rpow_neg (by positivity), Real.rpow_natCast, inv_pow]

/-- Every stationary rapid profile with at least quadratic decay is
integrable on the phase line. -/
theorem integrable_brrsStationaryRapidProfile (N : Nat) (hN : 2 ≤ N) :
    Integrable (brrsStationaryRapidProfile N) := by
  refine ((integrable_brrsJapaneseBracket N hN).const_mul ((2 : Real) ^ N)).mono'
    (measurable_brrsStationaryRapidProfile N).aestronglyMeasurable ?_
  filter_upwards with u
  rw [Real.norm_eq_abs, abs_of_nonneg (brrsStationaryRapidProfile_nonneg N u)]
  exact brrsStationaryRapidProfile_le_japaneseBracket N u

/-- The radial half-density carried by a wave front can be pulled through a
translated rapidly decaying profile.  The remaining phase-line weight has a
fixed cubic Japanese-bracket decay; this is the key scalar estimate behind
the sharp `t^((d-1)/2)` kernel mass. -/
theorem brrs_sqrtPow_mul_outgoingRapidProfile_le_translatedJapanese
    {d : Nat} (hd : 1 ≤ d) (t r : Real) (ht : 1 ≤ t) (_hr : 0 ≤ r) :
    (Real.sqrt r) ^ (d - 1) *
        brrsStationaryRapidProfile (d + 2) (2 * Real.pi * (t - r)) ≤
      ((Real.sqrt t) ^ (d - 1) * (2 : Real) ^ (d + 2)) *
        ((1 + |t - r|)⁻¹) ^ 3 := by
  let v : Real := |t - r|
  have hv : 0 ≤ v := by
    dsimp only [v]
    exact abs_nonneg _
  have ht0 : 0 ≤ t := le_trans zero_le_one ht
  have hradial : r ≤ t * (1 + v) ^ 2 := by
    have hfirst : r ≤ t + v := by
      dsimp only [v]
      have hdiff : r - t ≤ |r - t| := le_abs_self _
      rw [abs_sub_comm] at hdiff
      linarith
    have hsecond : t + v ≤ t * (1 + v) ^ 2 := by
      nlinarith [sq_nonneg v]
    exact hfirst.trans hsecond
  have hsqrt : Real.sqrt r ≤ Real.sqrt t * (1 + v) := by
    calc
      Real.sqrt r ≤ Real.sqrt (t * (1 + v) ^ 2) :=
        Real.sqrt_le_sqrt hradial
      _ = Real.sqrt t * Real.sqrt ((1 + v) ^ 2) := by
        rw [Real.sqrt_mul ht0]
      _ = Real.sqrt t * (1 + v) := by
        rw [Real.sqrt_sq_eq_abs, abs_of_nonneg (by linarith)]
  have hweight : (Real.sqrt r) ^ (d - 1) ≤
      (Real.sqrt t) ^ (d - 1) * (1 + v) ^ (d - 1) := by
    have h := pow_le_pow_left₀ (Real.sqrt_nonneg _) hsqrt (d - 1)
    simpa only [mul_pow] using h
  have hphase : v ≤ |2 * Real.pi * (t - r)| := by
    have htwopi : 1 ≤ |2 * Real.pi| := by
      rw [abs_of_pos (by positivity)]
      nlinarith [Real.pi_gt_three]
    calc
      v = 1 * |t - r| := by simp only [v, one_mul]
      _ ≤ |2 * Real.pi| * |t - r| :=
        mul_le_mul_of_nonneg_right htwopi (abs_nonneg _)
      _ = |2 * Real.pi * (t - r)| := by
        exact (abs_mul (2 * Real.pi) (t - r)).symm
  have hinv : (1 + |2 * Real.pi * (t - r)|)⁻¹ ≤ (1 + v)⁻¹ := by
    apply (inv_le_inv₀ (by positivity : 0 < 1 + |2 * Real.pi * (t - r)|)
      (by positivity : 0 < 1 + v)).mpr
    linarith
  have hprofile : brrsStationaryRapidProfile (d + 2)
      (2 * Real.pi * (t - r)) ≤
      (2 : Real) ^ (d + 2) * ((1 + v)⁻¹) ^ (d + 2) := by
    calc
      brrsStationaryRapidProfile (d + 2) (2 * Real.pi * (t - r)) ≤
          (2 : Real) ^ (d + 2) *
            ((1 + |2 * Real.pi * (t - r)|)⁻¹) ^ (d + 2) :=
        brrsStationaryRapidProfile_le_japaneseBracket _ _
      _ ≤ (2 : Real) ^ (d + 2) * ((1 + v)⁻¹) ^ (d + 2) := by
        apply mul_le_mul_of_nonneg_left
        · exact pow_le_pow_left₀ (by positivity) hinv _
        · positivity
  have hcombine : (1 + v) ^ (d - 1) * ((1 + v)⁻¹) ^ (d + 2) =
      ((1 + v)⁻¹) ^ 3 := by
    have hne : 1 + v ≠ 0 := by positivity
    have hindex : d + 2 = (d - 1) + 3 := by omega
    rw [hindex, pow_add]
    calc
      (1 + v) ^ (d - 1) *
          ((1 + v)⁻¹ ^ (d - 1) * (1 + v)⁻¹ ^ 3) =
        ((1 + v) ^ (d - 1) * (1 + v)⁻¹ ^ (d - 1)) *
          (1 + v)⁻¹ ^ 3 := by ring
      _ = ((1 + v) * (1 + v)⁻¹) ^ (d - 1) * (1 + v)⁻¹ ^ 3 := by
        rw [mul_pow]
      _ = ((1 : Real) ^ (d - 1)) * (1 + v)⁻¹ ^ 3 := by
        rw [mul_inv_cancel₀ hne]
      _ = (1 + v)⁻¹ ^ 3 := by simp
  calc
    (Real.sqrt r) ^ (d - 1) *
        brrsStationaryRapidProfile (d + 2) (2 * Real.pi * (t - r)) ≤
      ((Real.sqrt t) ^ (d - 1) * (1 + v) ^ (d - 1)) *
        ((2 : Real) ^ (d + 2) * ((1 + v)⁻¹) ^ (d + 2)) := by
      exact mul_le_mul hweight hprofile (brrsStationaryRapidProfile_nonneg _ _)
        (by positivity)
    _ = ((Real.sqrt t) ^ (d - 1) * (2 : Real) ^ (d + 2)) *
        ((1 + v) ^ (d - 1) * ((1 + v)⁻¹) ^ (d + 2)) := by ring
    _ = ((Real.sqrt t) ^ (d - 1) * (2 : Real) ^ (d + 2)) *
        ((1 + |t - r|)⁻¹) ^ 3 := by
      rw [hcombine]

/-- A sign-free version of the preceding radial weight estimate.  It applies
to any phase variable `u` once the elementary geometric inequality
`r ≤ t + |u|` is available. -/
theorem brrs_sqrtPow_mul_RapidProfile_le_translatedJapanese_of_radial_le
    {d : Nat} (hd : 1 ≤ d) (t r u : Real) (ht : 1 ≤ t)
    (hradial0 : r ≤ t + |u|) :
    (Real.sqrt r) ^ (d - 1) *
        brrsStationaryRapidProfile (d + 2) (2 * Real.pi * u) ≤
      ((Real.sqrt t) ^ (d - 1) * (2 : Real) ^ (d + 2)) *
        ((1 + |u|)⁻¹) ^ 3 := by
  let v : Real := |u|
  have hv : 0 ≤ v := by
    dsimp only [v]
    exact abs_nonneg _
  have ht0 : 0 ≤ t := le_trans zero_le_one ht
  have hradial : r ≤ t * (1 + v) ^ 2 := by
    have hfirst : r ≤ t + v := by
      simpa only [v] using hradial0
    have hsecond : t + v ≤ t * (1 + v) ^ 2 := by
      nlinarith [sq_nonneg v]
    exact hfirst.trans hsecond
  have hsqrt : Real.sqrt r ≤ Real.sqrt t * (1 + v) := by
    calc
      Real.sqrt r ≤ Real.sqrt (t * (1 + v) ^ 2) :=
        Real.sqrt_le_sqrt hradial
      _ = Real.sqrt t * Real.sqrt ((1 + v) ^ 2) := by
        rw [Real.sqrt_mul ht0]
      _ = Real.sqrt t * (1 + v) := by
        rw [Real.sqrt_sq_eq_abs, abs_of_nonneg (by linarith)]
  have hweight : (Real.sqrt r) ^ (d - 1) ≤
      (Real.sqrt t) ^ (d - 1) * (1 + v) ^ (d - 1) := by
    have h := pow_le_pow_left₀ (Real.sqrt_nonneg _) hsqrt (d - 1)
    simpa only [mul_pow] using h
  have hphase : v ≤ |2 * Real.pi * u| := by
    have htwopi : 1 ≤ |2 * Real.pi| := by
      rw [abs_of_pos (by positivity)]
      nlinarith [Real.pi_gt_three]
    calc
      v = 1 * |u| := by simp only [v, one_mul]
      _ ≤ |2 * Real.pi| * |u| :=
        mul_le_mul_of_nonneg_right htwopi (abs_nonneg _)
      _ = |2 * Real.pi * u| := by
        exact (abs_mul (2 * Real.pi) u).symm
  have hinv : (1 + |2 * Real.pi * u|)⁻¹ ≤ (1 + v)⁻¹ := by
    apply (inv_le_inv₀ (by positivity : 0 < 1 + |2 * Real.pi * u|)
      (by positivity : 0 < 1 + v)).mpr
    linarith
  have hprofile : brrsStationaryRapidProfile (d + 2) (2 * Real.pi * u) ≤
      (2 : Real) ^ (d + 2) * ((1 + v)⁻¹) ^ (d + 2) := by
    calc
      brrsStationaryRapidProfile (d + 2) (2 * Real.pi * u) ≤
          (2 : Real) ^ (d + 2) * ((1 + |2 * Real.pi * u|)⁻¹) ^ (d + 2) :=
        brrsStationaryRapidProfile_le_japaneseBracket _ _
      _ ≤ (2 : Real) ^ (d + 2) * ((1 + v)⁻¹) ^ (d + 2) := by
        apply mul_le_mul_of_nonneg_left
        · exact pow_le_pow_left₀ (by positivity) hinv _
        · positivity
  have hcombine : (1 + v) ^ (d - 1) * ((1 + v)⁻¹) ^ (d + 2) =
      ((1 + v)⁻¹) ^ 3 := by
    have hne : 1 + v ≠ 0 := by positivity
    have hindex : d + 2 = (d - 1) + 3 := by omega
    rw [hindex, pow_add]
    calc
      (1 + v) ^ (d - 1) *
          ((1 + v)⁻¹ ^ (d - 1) * (1 + v)⁻¹ ^ 3) =
        ((1 + v) ^ (d - 1) * (1 + v)⁻¹ ^ (d - 1)) *
          (1 + v)⁻¹ ^ 3 := by ring
      _ = ((1 + v) * (1 + v)⁻¹) ^ (d - 1) * (1 + v)⁻¹ ^ 3 := by
        rw [mul_pow]
      _ = ((1 : Real) ^ (d - 1)) * (1 + v)⁻¹ ^ 3 := by
        rw [mul_inv_cancel₀ hne]
      _ = (1 + v)⁻¹ ^ 3 := by simp
  calc
    (Real.sqrt r) ^ (d - 1) *
        brrsStationaryRapidProfile (d + 2) (2 * Real.pi * u) ≤
      ((Real.sqrt t) ^ (d - 1) * (1 + v) ^ (d - 1)) *
        ((2 : Real) ^ (d + 2) * ((1 + v)⁻¹) ^ (d + 2)) := by
      exact mul_le_mul hweight hprofile (brrsStationaryRapidProfile_nonneg _ _)
        (by positivity)
    _ = ((Real.sqrt t) ^ (d - 1) * (2 : Real) ^ (d + 2)) *
        ((1 + v) ^ (d - 1) * ((1 + v)⁻¹) ^ (d + 2)) := by ring
    _ = ((Real.sqrt t) ^ (d - 1) * (2 : Real) ^ (d + 2)) *
        ((1 + |u|)⁻¹) ^ 3 := by
      rw [hcombine]

/-- Exact simplification of the polar density against the wave-front radial
half-density.  This keeps the square-root power visible for the translated
profile estimate. -/
theorem brrs_radial_factor_waveFrontDensity
    (k : Nat) (r C : Real) (hr : 0 < r) :
    r ^ k * (C / (Real.sqrt (r / 16)) ^ k) =
      ((4 : Real) ^ k * C) * (Real.sqrt r) ^ k := by
  have hsqrt : Real.sqrt (r / 16) = Real.sqrt r / 4 := by
    have hsixteen : Real.sqrt (16 : Real) = 4 := by
      apply (Real.sqrt_eq_iff_mul_self_eq (by norm_num) (by norm_num)).2
      norm_num
    rw [Real.sqrt_div hr.le]
    rw [hsixteen]
  have hrpow : r ^ k = (Real.sqrt r) ^ (2 * k) := by
    calc
      r ^ k = ((Real.sqrt r) ^ 2) ^ k :=
        congrArg (fun x : Real => x ^ k) (Real.sq_sqrt hr.le).symm
      _ = (Real.sqrt r) ^ (2 * k) := by rw [pow_mul]
  rw [hsqrt, div_pow, hrpow]
  field_simp
  ring

/-- The fixed integrable phase-line profile left after the radial polynomial
has been absorbed into sufficiently rapid stationary decay. -/
noncomputable def brrsCubicJapaneseProfile (u : Real) : ENNReal :=
  ENNReal.ofReal (((1 + |u|)⁻¹) ^ 3)

theorem measurable_brrsCubicJapaneseProfile :
    Measurable brrsCubicJapaneseProfile := by
  unfold brrsCubicJapaneseProfile
  refine Measurable.ennreal_ofReal
    (f := fun u : Real => ((1 + |u|)⁻¹) ^ 3) ?_
  have habs : Measurable (fun u : Real => |u|) := continuous_abs.measurable
  have hinv : Measurable (fun u : Real => 1 / (1 + |u|)) :=
    measurable_const.div (measurable_const.add habs)
  simpa only [one_div] using hinv.pow_const 3

/-- The cubic Japanese profile has finite mass on the phase line. -/
theorem lintegral_brrsCubicJapaneseProfile_ne_top :
    (∫⁻ u : Real, brrsCubicJapaneseProfile u) ≠ ∞ := by
  have hint := (integrable_brrsJapaneseBracket 3 (by norm_num)).hasFiniteIntegral
  rw [hasFiniteIntegral_iff_enorm] at hint
  have heq : (∫⁻ u : Real, brrsCubicJapaneseProfile u) =
      ∫⁻ u : Real, ‖((1 + |u|)⁻¹) ^ 3‖ₑ := by
    apply lintegral_congr
    intro u
    have hnonneg : 0 ≤ ((1 + |u|)⁻¹) ^ 3 := by positivity
    simp only [brrsCubicJapaneseProfile, ← ofReal_norm, Real.norm_eq_abs,
      abs_of_nonneg hnonneg]
  rw [heq]
  exact hint.ne

/-- Restricting a translated cubic Japanese profile to positive radii costs
nothing: translation invariance returns its fixed phase-line mass. -/
theorem lintegral_brrsCubicJapaneseProfile_sub_le
    (A : ENNReal) (t : Real) :
    (∫⁻ r in Ioi (0 : Real), A * brrsCubicJapaneseProfile (t - r)) ≤
      A * ∫⁻ u : Real, brrsCubicJapaneseProfile u := by
  have hsub : Measurable (fun r : Real => brrsCubicJapaneseProfile (t - r)) := by
    exact measurable_brrsCubicJapaneseProfile.comp (measurable_const.sub measurable_id)
  calc
    (∫⁻ r in Ioi (0 : Real), A * brrsCubicJapaneseProfile (t - r)) ≤
        ∫⁻ r : Real, A * brrsCubicJapaneseProfile (t - r) :=
      by
        simpa only [Measure.restrict_univ] using
          (lintegral_mono_set (μ := volume)
            (f := fun r : Real => A * brrsCubicJapaneseProfile (t - r))
            (Set.subset_univ _))
    _ = A * ∫⁻ r : Real, brrsCubicJapaneseProfile (t - r) :=
      lintegral_const_mul A hsub
    _ = A * ∫⁻ u : Real, brrsCubicJapaneseProfile u := by
      rw [lintegral_sub_left_eq_self]

/-- The incoming translated profile has the same positive-radius bound. -/
theorem lintegral_brrsCubicJapaneseProfile_add_le
    (A : ENNReal) (t : Real) :
    (∫⁻ r in Ioi (0 : Real), A * brrsCubicJapaneseProfile (t + r)) ≤
      A * ∫⁻ u : Real, brrsCubicJapaneseProfile u := by
  have hadd : Measurable (fun r : Real => brrsCubicJapaneseProfile (t + r)) := by
    exact measurable_brrsCubicJapaneseProfile.comp (measurable_const.add measurable_id)
  calc
    (∫⁻ r in Ioi (0 : Real), A * brrsCubicJapaneseProfile (t + r)) ≤
        ∫⁻ r : Real, A * brrsCubicJapaneseProfile (t + r) :=
      by
        simpa only [Measure.restrict_univ] using
          (lintegral_mono_set (μ := volume)
            (f := fun r : Real => A * brrsCubicJapaneseProfile (t + r))
            (Set.subset_univ _))
    _ = A * ∫⁻ r : Real, brrsCubicJapaneseProfile (t + r) :=
      lintegral_const_mul A hadd
    _ = A * ∫⁻ u : Real, brrsCubicJapaneseProfile u := by
      rw [lintegral_add_left_eq_self]

/-- On the high-radius region, the literal polar density of either wave
front is controlled by a time half-density times the fixed cubic phase-line
profile. -/
private theorem brrs_front_polar_density_le_cubicJapanese
    {d : Nat} (hd : 3 ≤ d) (C t r u : Real) (hC : 0 ≤ C) (ht : 1 ≤ t)
    (hr : 16 ≤ r) (hradial : r ≤ t + |u|) :
    ENNReal.ofReal r ^ (d - 1) *
        ENNReal.ofReal
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
              brrsStationaryRapidProfile (d + 2) (2 * Real.pi * u)) ≤
      ENNReal.ofReal
        (((4 : Real) ^ (d - 1) * ((1 - (1 / 32 : Real)) * C)) *
          ((Real.sqrt t) ^ (d - 1) * (2 : Real) ^ (d + 2))) *
        brrsCubicJapaneseProfile u := by
  have hd1 : 1 ≤ d := le_trans (by norm_num) hd
  have hr0 : 0 ≤ r := by linarith
  have hrpos : 0 < r := by linarith
  let D : Real := (1 - (1 / 32 : Real)) * C
  have hD : 0 ≤ D := by
    dsimp only [D]
    positivity
  have hfactor := brrs_radial_factor_waveFrontDensity (d - 1) r D hrpos
  have hcore := brrs_sqrtPow_mul_RapidProfile_le_translatedJapanese_of_radial_le
    hd1 t r u ht hradial
  have hreal : r ^ (d - 1) *
      ((1 - (1 / 32 : Real)) *
        (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
          brrsStationaryRapidProfile (d + 2) (2 * Real.pi * u)) ≤
      (((4 : Real) ^ (d - 1) * D) *
        ((Real.sqrt t) ^ (d - 1) * (2 : Real) ^ (d + 2))) *
          ((1 + |u|)⁻¹) ^ 3 := by
    calc
      r ^ (d - 1) *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
              brrsStationaryRapidProfile (d + 2) (2 * Real.pi * u)) =
          (r ^ (d - 1) * (D / (Real.sqrt (r / 16)) ^ (d - 1))) *
            brrsStationaryRapidProfile (d + 2) (2 * Real.pi * u) := by
        dsimp only [D]
        ring
      _ = (((4 : Real) ^ (d - 1) * D) * (Real.sqrt r) ^ (d - 1)) *
            brrsStationaryRapidProfile (d + 2) (2 * Real.pi * u) := by
        rw [hfactor]
      _ ≤ (((4 : Real) ^ (d - 1) * D) *
          ((Real.sqrt t) ^ (d - 1) * (2 : Real) ^ (d + 2))) *
            ((1 + |u|)⁻¹) ^ 3 := by
        calc
          (((4 : Real) ^ (d - 1) * D) * (Real.sqrt r) ^ (d - 1)) *
              brrsStationaryRapidProfile (d + 2) (2 * Real.pi * u) =
            ((4 : Real) ^ (d - 1) * D) *
              ((Real.sqrt r) ^ (d - 1) *
                brrsStationaryRapidProfile (d + 2) (2 * Real.pi * u)) := by ring
          _ ≤ ((4 : Real) ^ (d - 1) * D) *
              (((Real.sqrt t) ^ (d - 1) * (2 : Real) ^ (d + 2)) *
                ((1 + |u|)⁻¹) ^ 3) := by
            exact mul_le_mul_of_nonneg_left hcore (by positivity)
          _ = (((4 : Real) ^ (d - 1) * D) *
              ((Real.sqrt t) ^ (d - 1) * (2 : Real) ^ (d + 2))) *
                ((1 + |u|)⁻¹) ^ 3 := by ring
  rw [← ENNReal.ofReal_pow hr0, ← ENNReal.ofReal_mul (pow_nonneg hr0 _),
    brrsCubicJapaneseProfile,
    ← ENNReal.ofReal_mul (by positivity : 0 ≤
      ((4 : Real) ^ (d - 1) * ((1 - (1 / 32 : Real)) * C)) *
        ((Real.sqrt t) ^ (d - 1) * (2 : Real) ^ (d + 2)))]
  exact ENNReal.ofReal_le_ofReal (by simpa only [D] using hreal)

/-- The outgoing high-radius front has the sharp scalar polar-mass bound.
The only time dependence is the expected radial half-density. -/
private theorem lintegral_brrs_outgoingFrontPolarDensity_le_cubicJapanese
    {d : Nat} (hd : 3 ≤ d) (C t : Real) (hC : 0 ≤ C) (ht : 1 ≤ t) :
    (∫⁻ r in Ici (16 : Real),
      ENNReal.ofReal r ^ (d - 1) *
        ENNReal.ofReal
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
              brrsStationaryRapidProfile (d + 2) (2 * Real.pi * (t - r)))) ≤
      ENNReal.ofReal
        (((4 : Real) ^ (d - 1) * ((1 - (1 / 32 : Real)) * C)) *
          ((Real.sqrt t) ^ (d - 1) * (2 : Real) ^ (d + 2))) *
        ∫⁻ u : Real, brrsCubicJapaneseProfile u := by
  let A : ENNReal := ENNReal.ofReal
    (((4 : Real) ^ (d - 1) * ((1 - (1 / 32 : Real)) * C)) *
      ((Real.sqrt t) ^ (d - 1) * (2 : Real) ^ (d + 2)))
  have hpoint (r : Real) (hr : r ∈ Ici (16 : Real)) :
      ENNReal.ofReal r ^ (d - 1) *
          ENNReal.ofReal
            ((1 - (1 / 32 : Real)) *
              (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
                brrsStationaryRapidProfile (d + 2) (2 * Real.pi * (t - r))) ≤
        A * brrsCubicJapaneseProfile (t - r) := by
    apply brrs_front_polar_density_le_cubicJapanese hd C t r (t - r) hC ht hr
    have hdiff : r - t ≤ |r - t| := le_abs_self _
    rw [abs_sub_comm] at hdiff
    linarith
  calc
    (∫⁻ r in Ici (16 : Real),
      ENNReal.ofReal r ^ (d - 1) *
        ENNReal.ofReal
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
              brrsStationaryRapidProfile (d + 2) (2 * Real.pi * (t - r)))) ≤
        ∫⁻ r in Ici (16 : Real), A * brrsCubicJapaneseProfile (t - r) := by
      apply setLIntegral_mono' measurableSet_Ici
      intro r hr
      exact hpoint r hr
    _ ≤ ∫⁻ r in Ioi (0 : Real), A * brrsCubicJapaneseProfile (t - r) := by
      simpa only using
        (lintegral_mono_set (μ := volume)
          (f := fun r : Real => A * brrsCubicJapaneseProfile (t - r))
          (show Ici (16 : Real) ⊆ Ioi (0 : Real) by
            intro r hr
            exact lt_of_lt_of_le (by norm_num : (0 : Real) < 16) hr))
    _ ≤ A * ∫⁻ u : Real, brrsCubicJapaneseProfile u :=
      lintegral_brrsCubicJapaneseProfile_sub_le A t
    _ = ENNReal.ofReal
        (((4 : Real) ^ (d - 1) * ((1 - (1 / 32 : Real)) * C)) *
          ((Real.sqrt t) ^ (d - 1) * (2 : Real) ^ (d + 2))) *
        ∫⁻ u : Real, brrsCubicJapaneseProfile u := by rfl

/-- The incoming high-radius front has the same sharp scalar polar-mass
bound. -/
private theorem lintegral_brrs_incomingFrontPolarDensity_le_cubicJapanese
    {d : Nat} (hd : 3 ≤ d) (C t : Real) (hC : 0 ≤ C) (ht : 1 ≤ t) :
    (∫⁻ r in Ici (16 : Real),
      ENNReal.ofReal r ^ (d - 1) *
        ENNReal.ofReal
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
