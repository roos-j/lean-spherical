/-- The all-nine source integral is uniformly controlled by the polar
`L¹` trace of the radial datum.  This deliberately retains the literal
nine-phase profile on the left, while the right hand side is the source
quantity later normalized as `brrsRadialLpSourceProfile 1`. -/
theorem brrsTwoRadiusNinePhase_outerIntegral_le_nine_mul_radialL1
    {d N : Nat} (hd : 0 < d) (r q t : Real)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d → Complex))
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    (∫ s : Ioi (0 : Real),
      brrsTwoRadiusNinePhaseProfile N r (q * s.1) t * ‖f (s.1 • w)‖
        ∂Measure.volumeIoiPow (d - 1)) ≤
      9 * ∫ s : Ioi (0 : Real), ‖f (s.1 • w)‖
        ∂Measure.volumeIoiPow (d - 1) := by
  have hinput : Integrable (fun s : Ioi (0 : Real) => f (s.1 • w))
      (Measure.volumeIoiPow (d - 1)) :=
    integrable_brrs_radial_profile_volumeIoiPow hd f hf w hw
  have hright : Integrable (fun s : Ioi (0 : Real) =>
      (9 : Real) * ‖f (s.1 • w)‖) (Measure.volumeIoiPow (d - 1)) :=
    hinput.norm.const_mul 9
  calc
    (∫ s : Ioi (0 : Real),
      brrsTwoRadiusNinePhaseProfile N r (q * s.1) t * ‖f (s.1 • w)‖
        ∂Measure.volumeIoiPow (d - 1)) ≤
        ∫ s : Ioi (0 : Real), (9 : Real) * ‖f (s.1 • w)‖
          ∂Measure.volumeIoiPow (d - 1) := by
