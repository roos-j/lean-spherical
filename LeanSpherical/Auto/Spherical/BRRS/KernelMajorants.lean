          (brrsTwoRadiusNinePhaseProfile_nonneg N r (q * s.1) t)
          (norm_nonneg _)
      · exact hright
      · filter_upwards with s
        exact mul_le_mul_of_nonneg_right
          (brrsTwoRadiusNinePhaseProfile_le_nine N r (q * s.1) t)
          (norm_nonneg _)
    _ = 9 * ∫ s : Ioi (0 : Real), ‖f (s.1 • w)‖
          ∂Measure.volumeIoiPow (d - 1) := by
      rw [integral_const_mul]

/-- The `p = 1` source-profile mass is literally the real polar radial
