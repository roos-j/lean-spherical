          (‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s t‖ *
            (s ^ (d - 1) * ‖f (s • w)‖)) := by
    rw [← ENNReal.ofReal_pow hspos.le,
      ← ENNReal.ofReal_mul (pow_nonneg hspos.le _),
      ← ENNReal.ofReal_mul (norm_nonneg _)]
  calc
    ENNReal.ofReal ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum
