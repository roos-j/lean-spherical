    exact div_pos (lt_of_lt_of_le (by norm_num) hr) (by norm_num)
  have hpoint : ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
      ‖((2 : Real) ^ j) ^ d‖ *
        ((1 - (1 / 32 : Real)) * (C / D) * J) := by
    dsimp [D, J]
    simpa only [Real.norm_eq_abs] using houter j r t f hf v w hv hw hr
  have hsource : J ≤ 9 * I := by
    dsimp [J, I]
    exact brrsTwoRadiusNinePhase_outerIntegral_le_nine_mul_radialL1
