theorem exists_brrsDyadicI0_lowHigh_sobolevSource_lintegral_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r t p S : Real,
