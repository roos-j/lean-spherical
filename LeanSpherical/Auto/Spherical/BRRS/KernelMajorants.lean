    exists_uniform_iteratedDeriv_brrsSurfaceWaveAmplitude_lowRadius_bound d N partR
  obtain ⟨B, hB, hBbound⟩ :=
    exists_uniform_iteratedDeriv_brrsStatWaveRadialCoeff_middle_highRad_rapidDecay
      (d := d) (N := N) (M := M) hd hM Phi
  let C : Real := ∑ l ∈ Finset.range (N + 1),
    brrsStationaryLeibnizConstant l A B
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact brrsStationaryLeibnizConstant_nonneg l hA.le hB.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk r s rho hr0 hr hs hrho
  let left : Real → Complex := fun u : Real =>
    brrsSurfaceWaveAmplitude d partR r u
  let right : Real → Complex := fun u : Real =>
    brrsStationaryWaveRadialCoefficient Phi d .middle s u
  have hleft : ContDiff Real (⊤ : ENat) left := by
    dsimp [left]
    exact contDiff_brrsSurfaceWaveAmplitude d partR r
  have hright : ContDiff Real (⊤ : ENat) right := by
    dsimp [right]
    exact contDiff_brrsStationaryWaveRadialCoefficient Phi d .middle s
  have hqpos : 0 < (Real.sqrt (s / 16)) ^ (M - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hleftbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l left rho‖ ≤ A := by
    intro l hl
    exact hAbound l (hl.trans hk) r rho hr0 hr hrho
  have hrightbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l right rho‖ ≤
        B / (Real.sqrt (s / 16)) ^ (M - 1) := by
    intro l hl
    exact hBbound l (hl.trans hk) s rho hs hrho
  have hprod := norm_iteratedDeriv_mul_le_brrsStationaryLeibnizConstant
    (n := k) hleft hright hA.le
    (div_nonneg hB.le hqpos.le) hleftbound hrightbound
  have hfactorfun : (fun u : Real =>
      brrsTwoRadiusStationaryCoefficient Phi d partR .middle r s u) =
      fun u : Real => left u * right u := by
    funext u
    dsimp [left, right]
    exact brrsTwoRadiusStationaryCoefficient_eq_amplitude_mul_coefficient
      Phi d partR .middle r s u
  rw [hfactorfun]
  have hCbound : brrsStationaryLeibnizConstant k A B ≤ C := by
    unfold C
    have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    exact Finset.single_le_sum
      (fun l hl => brrsStationaryLeibnizConstant_nonneg l hA.le hB.le) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real => left u * right u) rho‖ ≤
        brrsStationaryLeibnizConstant k A
          (B / (Real.sqrt (s / 16)) ^ (M - 1)) := hprod
    _ = brrsStationaryLeibnizConstant k A B /
          (Real.sqrt (s / 16)) ^ (M - 1) := by
      rw [brrsStationaryLeibnizConstant_right_div k A B
        ((Real.sqrt (s / 16)) ^ (M - 1)) hqpos.ne']
    _ ≤ C / (Real.sqrt (s / 16)) ^ (M - 1) :=
      div_le_div_of_nonneg_right hCbound hqpos.le
    _ ≤ (C + 1) / (Real.sqrt (s / 16)) ^ (M - 1) :=
      div_le_div_of_nonneg_right (by linarith) hqpos.le

/-- Compact-output/high-source profile estimate for a component whose source
wave is middle.  The rapid source-radius factor is retained explicitly,
instead of being hidden in the coarse all-nine profile. -/
theorem exists_norm_brrsTwoRadStatCompIntegral_lowHigh_middleSource_rapidProfile_le
    {d N M : Nat} (hd : 3 ≤ d) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff)
    (partR : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real,
      0 ≤ r → r ≤ 16 → 16 ≤ s →
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d partR .middle r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (s / 16)) ^ (M - 1)) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase partR r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadStatCoeff_profile_le_of_deriv_decay
      (d := d) (N := N) Phi partR .middle
      (fun r s => 0 ≤ r ∧ r ≤ 16 ∧ 16 ≤ s)
      (fun _ s => (Real.sqrt (s / 16)) ^ (M - 1))
      (by
        intro r s hrs
        apply pow_pos
        apply Real.sqrt_pos.2
        linarith [hrs.2.2])
      (by
        obtain ⟨D, hD, hbound⟩ :=
          exists_unif_iteratedDeriv_brrsTwoRadStatCoeff_lowHigh_middleSource_rapidDecay
            (d := d) (N := N) (M := M) hd hM Phi partR
        refine ⟨D, hD, ?_⟩
        intro k hk r s rho hrs hrho
        exact hbound k hk r s rho hrs.1 hrs.2.1 hrs.2.2 hrho)
  refine ⟨C, hC, ?_⟩
  intro r s t hr0 hr hs
  rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
  exact hprofile r s
    (brrsSurfaceWavePhase partR r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) ⟨hr0, hr, hs⟩

/-- The rapid denominator of a compact-output/source-middle component splits
into the ordinary source half-density and the extra factor which transfers
the middle carrier to an endpoint phase. -/
theorem brrs_lowHigh_middleSource_denominator_factor
    {d N : Nat} {s : Real} (hd : 1 ≤ d) (hs : 16 ≤ s) (C : Real) :
    C / (Real.sqrt (s / 16)) ^ (d + 2 * N - 1) =
      (C / (Real.sqrt (s / 16)) ^ (d - 1)) *
        (1 / (Real.sqrt (s / 16)) ^ (2 * N)) := by
  have hroot : 0 < Real.sqrt (s / 16) := by
    apply Real.sqrt_pos.2
    linarith
  have hsplit : d + 2 * N - 1 = (d - 1) + 2 * N := by omega
  rw [hsplit, pow_add]
  field_simp [hroot.ne']

/-- In the compact-output/high-source regime, every literal stationary
component is controlled by the four endpoint phase lines.  The source-middle
components use their retained rapid source-radius decay, while a compact
output-middle carrier is shifted using the bounded-radius profile estimate.
This is the mixed-radius part of the BRRS four-sign radial kernel bound. -/
theorem exists_norm_brrsTwoRadAllStatComponentIntegralSum_lowHigh_fourPhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real,
      0 ≤ r → r ≤ 16 → 16 ≤ s →
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (s / 16)) ^ (d - 1)) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
  obtain ⟨Coo, hCoo, hoo⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      (d := d) (N := N) hd Phi .outgoing .outgoing
  obtain ⟨Coi, hCoi, hoi⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      (d := d) (N := N) hd Phi .outgoing .incoming
  obtain ⟨Cio, hCio, hio⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      (d := d) (N := N) hd Phi .incoming .outgoing
  obtain ⟨Cii, hCii, hii⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      (d := d) (N := N) hd Phi .incoming .incoming
  obtain ⟨Cmo, hCmo, hmo⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      (d := d) (N := 2 * N) hd Phi .middle .outgoing
  obtain ⟨Cmi, hCmi, hmi⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      (d := d) (N := 2 * N) hd Phi .middle .incoming
  let M : Nat := d + 2 * N
  have hM : 2 ≤ M := by
    dsimp [M]
    omega
  obtain ⟨Com, hCom, hom⟩ :=
    exists_norm_brrsTwoRadStatCompIntegral_lowHigh_middleSource_rapidProfile_le
      (d := d) (N := 2 * N) (M := M) hd hM Phi .outgoing
  obtain ⟨Cim, hCim, him⟩ :=
    exists_norm_brrsTwoRadStatCompIntegral_lowHigh_middleSource_rapidProfile_le
      (d := d) (N := 2 * N) (M := M) hd hM Phi .incoming
  obtain ⟨Cmm, hCmm, hmm⟩ :=
    exists_norm_brrsTwoRadStatCompIntegral_lowHigh_middleSource_rapidProfile_le
      (d := d) (N := 2 * N) (M := M) hd hM Phi .middle
  let Lsmall : Real := (17 : Real) ^ N *
    ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N)
  let Lhigh : Real := (32 : Real) ^ N *
    ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N)
  let C₀ : Real := Coo + Coi + Cio + Cii + Cmo + Cmi + Com + Cim + Cmm
  let C : Real := (1 + Lsmall + Lhigh) * C₀
  have hLsmall : 0 < Lsmall := by
    dsimp [Lsmall]
    positivity
  have hLhigh : 0 < Lhigh := by
    dsimp [Lhigh]
    positivity
  have hC₀ : 0 < C₀ := by
    dsimp [C₀]
    linarith
  have hC : 0 < C := by
    dsimp [C]
    exact mul_pos (by linarith) hC₀
  have hC₀_le_C : C₀ ≤ C := by
    dsimp [C]
    calc
      C₀ = 1 * C₀ := by ring
      _ ≤ (1 + Lsmall + Lhigh) * C₀ :=
        mul_le_mul_of_nonneg_right (by linarith) hC₀.le
  have hCoo_le_C₀ : Coo ≤ C₀ := by
    dsimp [C₀]
    linarith
  have hCoi_le_C₀ : Coi ≤ C₀ := by
    dsimp [C₀]
    linarith
  have hCio_le_C₀ : Cio ≤ C₀ := by
    dsimp [C₀]
    linarith
  have hCii_le_C₀ : Cii ≤ C₀ := by
    dsimp [C₀]
    linarith
  have hCmo_le_C₀ : Cmo ≤ C₀ := by
    dsimp [C₀]
    linarith
  have hCmi_le_C₀ : Cmi ≤ C₀ := by
    dsimp [C₀]
    linarith
  have hCom_le_C₀ : Com ≤ C₀ := by
    dsimp [C₀]
    linarith
  have hCim_le_C₀ : Cim ≤ C₀ := by
    dsimp [C₀]
    linarith
  have hCmm_le_C₀ : Cmm ≤ C₀ := by
    dsimp [C₀]
    linarith
  have hsmall_C₀_le_C : Lsmall * C₀ ≤ C := by
    dsimp [C]
    exact mul_le_mul_of_nonneg_right (by linarith) hC₀.le
  have hhigh_C₀_le_C : Lhigh * C₀ ≤ C := by
    dsimp [C]
    exact mul_le_mul_of_nonneg_right (by linarith) hC₀.le
  have hCoo_le : Coo ≤ C := hCoo_le_C₀.trans hC₀_le_C
  have hCoi_le : Coi ≤ C := hCoi_le_C₀.trans hC₀_le_C
  have hCio_le : Cio ≤ C := hCio_le_C₀.trans hC₀_le_C
  have hCii_le : Cii ≤ C := hCii_le_C₀.trans hC₀_le_C
  have hCmo_le : Lsmall * Cmo ≤ C :=
    (mul_le_mul_of_nonneg_left hCmo_le_C₀ hLsmall.le).trans hsmall_C₀_le_C
  have hCmi_le : Lsmall * Cmi ≤ C :=
    (mul_le_mul_of_nonneg_left hCmi_le_C₀ hLsmall.le).trans hsmall_C₀_le_C
  have hCom_le : Lhigh * Com ≤ C :=
    (mul_le_mul_of_nonneg_left hCom_le_C₀ hLhigh.le).trans hhigh_C₀_le_C
  have hCim_le : Lhigh * Cim ≤ C :=
    (mul_le_mul_of_nonneg_left hCim_le_C₀ hLhigh.le).trans hhigh_C₀_le_C
  have hCmm_le : Lhigh * Cmm ≤ C :=
    (mul_le_mul_of_nonneg_left hCmm_le_C₀ hLhigh.le).trans hhigh_C₀_le_C
  refine ⟨(9 : Real) * C, by positivity, ?_⟩
  intro r s t hr0 hr hs
  let R : Real := Real.sqrt (s / 16)
  let q : Real := R ^ (d - 1)
  let δ : Real := 1 - (1 / 32 : Real)
  let P₁ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s))
  let P₂ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s))
  let P₃ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s))
  let P₄ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))
  let P : Real := P₁ + P₂ + P₃ + P₄
  let A : Real := δ * (C / q)
  have hR : 0 < R := by
    dsimp [R]
    apply Real.sqrt_pos.2
    linarith
  have hq : 0 < q := by
    dsimp [q]
    exact pow_pos hR _
  have hδ : 0 ≤ δ := by
    dsimp [δ]
    norm_num
  have hA : 0 ≤ A := by
    dsimp [A]
    positivity
  have hP₁ : 0 ≤ P₁ := by
    dsimp [P₁]
    exact brrsStationaryRapidProfile_nonneg _ _
  have hP₂ : 0 ≤ P₂ := by
    dsimp [P₂]
    exact brrsStationaryRapidProfile_nonneg _ _
  have hP₃ : 0 ≤ P₃ := by
    dsimp [P₃]
    exact brrsStationaryRapidProfile_nonneg _ _
  have hP₄ : 0 ≤ P₄ := by
    dsimp [P₄]
    exact brrsStationaryRapidProfile_nonneg _ _
  have hP₁_le : P₁ ≤ P := by
    dsimp [P]
    linarith
  have hP₂_le : P₂ ≤ P := by
    dsimp [P]
    linarith
  have hP₃_le : P₃ ≤ P := by
    dsimp [P]
    linarith
  have hP₄_le : P₄ ≤ P := by
    dsimp [P]
    linarith
  have hAbsorb (D E : Real) (hD : D ≤ C) (hE : E ≤ P) (hE0 : 0 ≤ E) :
      δ * (D / q) * E ≤ A * P := by
    have hcoef : δ * (D / q) ≤ A := by
      dsimp [A]
      exact mul_le_mul_of_nonneg_left
        (div_le_div_of_nonneg_right hD hq.le) hδ
    calc
      δ * (D / q) * E ≤ A * E :=
        mul_le_mul_of_nonneg_right hcoef hE0
      _ ≤ A * P := mul_le_mul_of_nonneg_left hE hA
  have hphase_mo :
      brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - s)) ≤
        Lsmall * P₁ := by
    convert brrsStationaryRapidProfile_smallRadius_shift_to_endpointPhase
      N (t - s) r (by rw [abs_of_nonneg hr0]; exact hr) using 1;
      dsimp [Lsmall, P₁]; ring
  have hphase_mi :
      brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + s)) ≤
        Lsmall * P₂ := by
    convert brrsStationaryRapidProfile_smallRadius_shift_to_endpointPhase
      N (t + s) r (by rw [abs_of_nonneg hr0]; exact hr) using 1;
      dsimp [Lsmall, P₂]; ring
  have hphase_om :
      (1 / R ^ (2 * N)) *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - r)) ≤
        Lhigh * P₁ := by
    convert brrs_highRadius_middle_decay_transfer_to_endpointPhase_of_nonneg_le
      (u := s) (a := s) hs (by linarith) le_rfl N (t - r) using 1
  have hphase_im :
      (1 / R ^ (2 * N)) *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + r)) ≤
        Lhigh * P₃ := by
    convert brrs_highRadius_middle_decay_transfer_to_endpointPhase_of_nonneg_le
      (u := s) (a := s) hs (by linarith) le_rfl N (t + r) using 1
  have hsr0 : 0 ≤ s - r := by linarith
  have hsrs : s - r ≤ s := by linarith
  have hphase_mm :
      (1 / R ^ (2 * N)) *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * t) ≤
        Lhigh * P₃ := by
    convert brrs_highRadius_middle_decay_transfer_to_endpointPhase_of_nonneg_le
      (u := s) (a := s - r) hs hsr0 hsrs N t using 1;
      dsimp [R, Lhigh, P₃]; ring
  have hMsub : M - 1 = d + 2 * N - 1 := by
    dsimp [M]
  have hfactor (D : Real) :
      δ * (D / R ^ (M - 1)) =
        (δ * (D / q)) * (1 / R ^ (2 * N)) := by
    calc
      δ * (D / R ^ (M - 1)) = δ * (D / R ^ (d + 2 * N - 1)) := by rw [hMsub]
      _ = δ * ((D / R ^ (d - 1)) * (1 / R ^ (2 * N))) := by
        rw [show R = Real.sqrt (s / 16) by rfl]
        rw [brrs_lowHigh_middleSource_denominator_factor (d := d) (N := N)
          (s := s) (by omega) hs D]
      _ = (δ * (D / q)) * (1 / R ^ (2 * N)) := by
        dsimp [q]
        ring
  have hIoo :
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .outgoing r s t‖ ≤
        A * P := by
    calc
      _ ≤ δ * (Coo / q) * P₁ := by
        convert hoo r s t hr0 hr hs using 1;
          dsimp [δ, q, R, P₁, brrsSurfaceWavePhase]; ring
      _ ≤ A * P := hAbsorb Coo P₁ hCoo_le hP₁_le hP₁
  have hIoi :
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .incoming r s t‖ ≤
        A * P := by
    calc
      _ ≤ δ * (Coi / q) * P₂ := by
        convert hoi r s t hr0 hr hs using 1;
          dsimp [δ, q, R, P₂, brrsSurfaceWavePhase]; ring
      _ ≤ A * P := hAbsorb Coi P₂ hCoi_le hP₂_le hP₂
  have hIio :
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .outgoing r s t‖ ≤
        A * P := by
    calc
      _ ≤ δ * (Cio / q) * P₃ := by
        convert hio r s t hr0 hr hs using 1;
          dsimp [δ, q, R, P₃, brrsSurfaceWavePhase]; ring
      _ ≤ A * P := hAbsorb Cio P₃ hCio_le hP₃_le hP₃
  have hIii :
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .incoming r s t‖ ≤
        A * P := by
    calc
      _ ≤ δ * (Cii / q) * P₄ := by
        convert hii r s t hr0 hr hs using 1;
          dsimp [δ, q, R, P₄, brrsSurfaceWavePhase]; ring
      _ ≤ A * P := hAbsorb Cii P₄ hCii_le hP₄_le hP₄
  have hImo :
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d .middle .outgoing r s t‖ ≤
        A * P := by
    have hcoef : 0 ≤ δ * (Cmo / q) := by positivity
    calc
      _ ≤ δ * (Cmo / q) *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - s)) := by
        convert hmo r s t hr0 hr hs using 1;
          dsimp [δ, q, R, brrsSurfaceWavePhase]; ring
      _ ≤ δ * (Cmo / q) * (Lsmall * P₁) :=
        mul_le_mul_of_nonneg_left hphase_mo hcoef
      _ = δ * ((Lsmall * Cmo) / q) * P₁ := by ring
      _ ≤ A * P := hAbsorb (Lsmall * Cmo) P₁ hCmo_le hP₁_le hP₁
  have hImi :
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d .middle .incoming r s t‖ ≤
        A * P := by
    have hcoef : 0 ≤ δ * (Cmi / q) := by positivity
    calc
      _ ≤ δ * (Cmi / q) *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + s)) := by
        convert hmi r s t hr0 hr hs using 1;
          dsimp [δ, q, R, brrsSurfaceWavePhase]; ring
      _ ≤ δ * (Cmi / q) * (Lsmall * P₂) :=
        mul_le_mul_of_nonneg_left hphase_mi hcoef
      _ = δ * ((Lsmall * Cmi) / q) * P₂ := by ring
      _ ≤ A * P := hAbsorb (Lsmall * Cmi) P₂ hCmi_le hP₂_le hP₂
  have hIom :
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .middle r s t‖ ≤
        A * P := by
    have hcoef : 0 ≤ δ * (Com / q) := by positivity
    calc
      _ ≤ δ * (Com / R ^ (M - 1)) *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - r)) := by
        convert hom r s t hr0 hr hs using 1;
          dsimp [δ, R, brrsSurfaceWavePhase]; ring
      _ = (δ * (Com / q)) *
          ((1 / R ^ (2 * N)) *
            brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - r))) := by
        rw [hfactor Com]
        ring
      _ ≤ (δ * (Com / q)) * (Lhigh * P₁) :=
        mul_le_mul_of_nonneg_left hphase_om hcoef
      _ = δ * ((Lhigh * Com) / q) * P₁ := by ring
      _ ≤ A * P := hAbsorb (Lhigh * Com) P₁ hCom_le hP₁_le hP₁
  have hIim :
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .middle r s t‖ ≤
        A * P := by
    have hcoef : 0 ≤ δ * (Cim / q) := by positivity
    calc
      _ ≤ δ * (Cim / R ^ (M - 1)) *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + r)) := by
        convert him r s t hr0 hr hs using 1;
          dsimp [δ, R, brrsSurfaceWavePhase]; ring
      _ = (δ * (Cim / q)) *
          ((1 / R ^ (2 * N)) *
            brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + r))) := by
        rw [hfactor Cim]
        ring
      _ ≤ (δ * (Cim / q)) * (Lhigh * P₃) :=
        mul_le_mul_of_nonneg_left hphase_im hcoef
      _ = δ * ((Lhigh * Cim) / q) * P₃ := by ring
      _ ≤ A * P := hAbsorb (Lhigh * Cim) P₃ hCim_le hP₃_le hP₃
  have hImm :
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d .middle .middle r s t‖ ≤
        A * P := by
    have hcoef : 0 ≤ δ * (Cmm / q) := by positivity
    calc
      _ ≤ δ * (Cmm / R ^ (M - 1)) *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * t) := by
        convert hmm r s t hr0 hr hs using 1;
          dsimp [δ, R, brrsSurfaceWavePhase]; ring
      _ = (δ * (Cmm / q)) *
          ((1 / R ^ (2 * N)) *
            brrsStationaryRapidProfile (2 * N) (2 * Real.pi * t)) := by
        rw [hfactor Cmm]
        ring
      _ ≤ (δ * (Cmm / q)) * (Lhigh * P₃) :=
        mul_le_mul_of_nonneg_left hphase_mm hcoef
      _ = δ * ((Lhigh * Cmm) / q) * P₃ := by ring
      _ ≤ A * P := hAbsorb (Lhigh * Cmm) P₃ hCmm_le hP₃_le hP₃
  have hall :=
    norm_brrsTwoRadiusAllStationaryComponentIntegralSum_le_of_component_common_bound
      Phi d r s t A P (by
        intro partR partS
        cases partR <;> cases partS
        · exact hIoo
        · exact hIoi
        · exact hIom
        · exact hIio
        · exact hIii
        · exact hIim
        · exact hImo
        · exact hImi
        · exact hImm)
  calc
    ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤
        (9 : Real) * A * P := hall
    _ = δ * (((9 : Real) * C) / q) * P := by
      dsimp [A]
      ring
    _ = (1 - (1 / 32 : Real)) *
          (((9 : Real) * C) / (Real.sqrt (s / 16)) ^ (d - 1)) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
      dsimp [δ, q, R, P, P₁, P₂, P₃, P₄]

/-- The high-output/compact-source four-sign bound is the exact radial
reflection of the compact-output/high-source bound. -/
theorem exists_norm_brrsTwoRadAllStatComponentIntegralSum_highLow_fourPhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real,
      16 ≤ r → 0 ≤ s → s ≤ 16 →
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
  obtain ⟨C, hC, hlowHigh⟩ :=
    exists_norm_brrsTwoRadAllStatComponentIntegralSum_lowHigh_fourPhase_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs0 hs
  rw [brrsTwoRadiusAllStationaryComponentIntegralSum_swap Phi d r s t]
  have hswapped := hlowHigh s r t hs0 hs hr
  convert hswapped using 1; ring

/-- Exact dyadic transport of the source-middle rapid estimate.  It is the
form used alongside the dyadic compact output cell and keeps the high source
decay after scaling. -/
theorem exists_norm_brrsDyTwoRadStatCompIntegral_lowHigh_middleSource_rapidProfile_le
    {d N M : Nat} (hd : 3 ≤ d) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff)
    (partR : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r s t : Real,
      0 ≤ ((2 : Real) ^ j) * r → ((2 : Real) ^ j) * r ≤ 16 →
      16 ≤ ((2 : Real) ^ j) * s →
      ‖brrsDyadicTwoRadiusStationaryComponentIntegral Phi d j partR .middle r s t‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (M - 1)) *
            brrsStationaryRapidProfile N
              (brrsSurfaceWavePhase partR (((2 : Real) ^ j) * r) +
                brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * s) +
                  2 * Real.pi * (((2 : Real) ^ j) * t))) := by
  obtain ⟨C, hC, hlevel⟩ :=
    exists_norm_brrsTwoRadStatCompIntegral_lowHigh_middleSource_rapidProfile_le
      (d := d) (N := N) (M := M) hd hM Phi partR
  refine ⟨C, hC, ?_⟩
  intro j r s t hr0 hr hs
  rw [norm_brrsDyadicTwoRadiusStationaryComponentIntegral_eq_levelZero_scaled]
  exact mul_le_mul_of_nonneg_left
    (hlevel (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
      (((2 : Real) ^ j) * t) hr0 hr hs)
    (norm_nonneg _)

/-- Factoring the additional source-middle rapid decay after the ordinary
low--high Sobolev normalization.  The remaining denominator is explicit and
is the source-tail factor that makes the middle contribution integrable. -/
theorem brrs_lowHigh_middleRapid_prefactor_polar_sobolevSource_eq
    {d M : Nat} (hd : 1 ≤ d) (hMd : d ≤ M)
    {p q s : Real} (hp : p ≠ 0) (hq : 0 < q) (hs : 0 < s)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) :
    (q ^ d / (Real.sqrt (q * s / 16)) ^ (M - 1)) *
        (s ^ (d - 1) * ‖f (s • w)‖) =
      ((q ^ (((d : Real) - 1) / 2 + 1) *
          (16 : Real) ^ (((d : Real) - 1) / 2)) *
        (brrsRadialSobolevSourceProfile p f w s).toReal) /
          (Real.sqrt (q * s / 16)) ^ (M - d) := by
  let D : Real := Real.sqrt (q * s / 16)
  have hD : 0 < D := by
    dsimp only [D]
    apply Real.sqrt_pos.2
    positivity
  have hpow : D ^ (M - 1) = D ^ (d - 1) * D ^ (M - d) := by
    rw [← pow_add]
    congr 1
    omega
  have hbase := brrs_lowHigh_prefactor_polar_source_eq
    (d := d) (p := p) (q := q) (s := s) hd hp hq hs f w
  change (q ^ d / D ^ (M - 1)) *
      (s ^ (d - 1) * ‖f (s • w)‖) = _
  rw [hpow]
  calc
    (q ^ d / (D ^ (d - 1) * D ^ (M - d))) *
        (s ^ (d - 1) * ‖f (s • w)‖) =
        ((q ^ d / D ^ (d - 1)) *
          (s ^ (d - 1) * ‖f (s • w)‖)) / D ^ (M - d) := by
      field_simp [ne_of_gt (pow_pos hD _)]
    _ = ((q ^ (((d : Real) - 1) / 2 + 1) *
          (16 : Real) ^ (((d : Real) - 1) / 2)) *
        (brrsRadialSobolevSourceProfile p f w s).toReal) /
          D ^ (M - d) := by rw [hbase]

/-- Actual compact-output/high-source estimate for a source-middle dyadic
component.  Its right side is the Sobolev `L^p` source profile times an
explicit rapid tail denominator, so no uncontrolled source `L¹` mass occurs. -/
theorem exists_brrsDyadicI0_lowHigh_middleSource_rapidSobolevSource_profile_le
    {d N M : Nat} (hd : 3 ≤ d) (hMd : d ≤ M) (hM : 2 ≤ M)
    (Phi : BRRSAnnularCutoff) (partR : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r s t p : Real,
      ∀ f : BRRSSpace d → Complex, ∀ w : BRRSSpace d,
      2 ≤ p → 0 ≤ r → r ≤ dyadicTimeScale j →
      16 ≤ ((2 : Real) ^ j) * s →
      ‖brrsDyadicTwoRadiusStationaryComponentIntegral Phi d j partR .middle r s t‖ *
          (s ^ (d - 1) * ‖f (s • w)‖) ≤
        ((1 - (1 / 32 : Real)) * C) *
          ((((((2 : Real) ^ j) ^ (((d : Real) - 1) / 2 + 1) *
            (16 : Real) ^ (((d : Real) - 1) / 2)) *
              (brrsRadialSobolevSourceProfile p f w s).toReal) /
              (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (M - d)) *
            brrsStationaryRapidProfile N
              (brrsSurfaceWavePhase partR (((2 : Real) ^ j) * r) +
                brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * s) +
                  2 * Real.pi * (((2 : Real) ^ j) * t))) := by
  obtain ⟨C, hC, hrapid⟩ :=
    exists_norm_brrsDyTwoRadStatCompIntegral_lowHigh_middleSource_rapidProfile_le
      (d := d) (N := N) (M := M) hd hM Phi partR
  refine ⟨C, hC, ?_⟩
  intro j r s t p f w hp hr0 hr hhigh
  let q : Real := (2 : Real) ^ j
  let D : Real := (Real.sqrt (q * s / 16)) ^ (M - 1)
  let P : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase partR (q * r) +
      brrsSurfaceWavePhase .middle (q * s) + 2 * Real.pi * (q * t))
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hs : 0 < s := by
    have hqs : 0 < q * s := lt_of_lt_of_le (by norm_num) hhigh
    rcases (mul_pos_iff.mp hqs) with hpos | hneg
    · exact hpos.2
    · linarith [hq, hneg.1]
  have hqr0 : 0 ≤ q * r := mul_nonneg hq.le hr0
  have hqr : q * r ≤ 16 := by
    change r ≤ q⁻¹ at hr
    calc
      q * r ≤ q * q⁻¹ := mul_le_mul_of_nonneg_left hr hq.le
      _ = 1 := mul_inv_cancel₀ hq.ne'
      _ ≤ 16 := by norm_num
  have hD : 0 < D := by
    dsimp only [D]
    apply pow_pos
    apply Real.sqrt_pos.2
    positivity
  have hrapid' :
      ‖brrsDyadicTwoRadiusStationaryComponentIntegral Phi d j partR .middle r s t‖ ≤
        q ^ d * ((1 - (1 / 32 : Real)) * (C / D) * P) := by
    have hraw := hrapid j r s t hqr0 hqr hhigh
    rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg hq.le _)] at hraw
    simpa only [q, D, P, mul_assoc] using hraw
  have hp' : p ≠ 0 := by linarith
  have hfactor := brrs_lowHigh_middleRapid_prefactor_polar_sobolevSource_eq
    (d := d) (M := M) (p := p) (q := q) (s := s)
      (by omega) hMd hp' hq hs f w
  calc
    ‖brrsDyadicTwoRadiusStationaryComponentIntegral Phi d j partR .middle r s t‖ *
        (s ^ (d - 1) * ‖f (s • w)‖) ≤
        (q ^ d * ((1 - (1 / 32 : Real)) * (C / D) * P)) *
          (s ^ (d - 1) * ‖f (s • w)‖) :=
      mul_le_mul_of_nonneg_right hrapid'
        (mul_nonneg (pow_nonneg hs.le _) (norm_nonneg _))
    _ = ((1 - (1 / 32 : Real)) * C) *
          ((q ^ d / D) * (s ^ (d - 1) * ‖f (s • w)‖)) * P := by
      field_simp [ne_of_gt hD]
    _ = ((1 - (1 / 32 : Real)) * C) *
          (((q ^ (((d : Real) - 1) / 2 + 1) *
            (16 : Real) ^ (((d : Real) - 1) / 2)) *
              (brrsRadialSobolevSourceProfile p f w s).toReal /
            (Real.sqrt (q * s / 16)) ^ (M - d)) * P) := by
      dsimp only [D]
      rw [hfactor]
      ring
    _ = ((1 - (1 / 32 : Real)) * C) *
          ((((((2 : Real) ^ j) ^ (((d : Real) - 1) / 2 + 1) *
            (16 : Real) ^ (((d : Real) - 1) / 2)) *
              (brrsRadialSobolevSourceProfile p f w s).toReal) /
              (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (M - d)) *
            brrsStationaryRapidProfile N
              (brrsSurfaceWavePhase partR (((2 : Real) ^ j) * r) +
                brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * s) +
                  2 * Real.pi * (((2 : Real) ^ j) * t))) := by
      rfl

/-- The literal compact-output/high-source source-middle contribution on a
source tail.  In addition to the Sobolev `L^p` source profile, the right side
retains the explicit rapid factor in the source radius.  This is the form
which can be integrated in the source variable without reverting to an
exponent-one source mass. -/
theorem exists_brrsDyadicI0_lowHigh_middleSource_rapidSobolevSource_lintegral_le
    {d N M : Nat} (hd : 3 ≤ d) (hMd : d ≤ M) (hM : 2 ≤ M)
    (Phi : BRRSAnnularCutoff) (partR : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r t p S : Real,
      ∀ f : BRRSSpace d → Complex, ∀ w : BRRSSpace d,
      2 ≤ p → 0 ≤ r → r ≤ dyadicTimeScale j →
      16 ≤ ((2 : Real) ^ j) * S →
      (∫⁻ s in Ici S,
        ENNReal.ofReal ‖brrsDyadicTwoRadiusStationaryComponentIntegral
          Phi d j partR .middle r s t‖ *
          ((ENNReal.ofReal s) ^ (d - 1) * ENNReal.ofReal ‖f (s • w)‖)) ≤
        ∫⁻ s in Ici S,
          ENNReal.ofReal ((1 - (1 / 32 : Real)) * C) *
            ((ENNReal.ofReal
                (((2 : Real) ^ j) ^ (((d : Real) - 1) / 2 + 1) *
                  (16 : Real) ^ (((d : Real) - 1) / 2)) *
                brrsRadialSobolevSourceProfile p f w s /
              ENNReal.ofReal
                ((Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (M - d))) *
              ENNReal.ofReal (brrsStationaryRapidProfile N
                (brrsSurfaceWavePhase partR (((2 : Real) ^ j) * r) +
                  brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * s) +
                    2 * Real.pi * (((2 : Real) ^ j) * t)))) := by
  obtain ⟨C, hC, hpoint⟩ :=
    exists_brrsDyadicI0_lowHigh_middleSource_rapidSobolevSource_profile_le
      (d := d) (N := N) (M := M) hd hMd hM Phi partR
  refine ⟨C, hC, ?_⟩
  intro j r t p S f w hp hr0 hr hS
  let q : Real := (2 : Real) ^ j
  let Cfac : Real := (1 - (1 / 32 : Real)) * C
  let Qfac : Real := q ^ (((d : Real) - 1) / 2 + 1) *
    (16 : Real) ^ (((d : Real) - 1) / 2)
  let Dtail : Real → Real := fun s =>
    (Real.sqrt (q * s / 16)) ^ (M - d)
  let P : Real → Real := fun s => brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase partR (q * r) +
      brrsSurfaceWavePhase .middle (q * s) + 2 * Real.pi * (q * t))
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hCfac : 0 ≤ Cfac := by
    dsimp only [Cfac]
    positivity
  have hQfac : 0 ≤ Qfac := by
    dsimp only [Qfac]
    positivity
  apply setLIntegral_mono' measurableSet_Ici
  intro s hs
  have hhigh : 16 ≤ q * s := by
    calc
      16 ≤ q * S := by simpa only [q] using hS
      _ ≤ q * s := mul_le_mul_of_nonneg_left hs hq.le
  have hspos : 0 < s := by
    have hqspos : 0 < q * s := lt_of_lt_of_le (by norm_num) hhigh
    rcases (mul_pos_iff.mp hqspos) with hpos | hneg
    · exact hpos.2
    · linarith [hq, hneg.1]
  have hDtail : 0 < Dtail s := by
    dsimp only [Dtail]
    apply pow_pos
    apply Real.sqrt_pos.2
    exact div_pos (mul_pos hq hspos) (by norm_num)
  have hP : 0 ≤ P s := by
    dsimp only [P]
    exact brrsStationaryRapidProfile_nonneg N _
  have hreal := hpoint j r s t p f w hp hr0 hr
    (by simpa only [q] using hhigh)
  have hleft :
      ENNReal.ofReal ‖brrsDyadicTwoRadiusStationaryComponentIntegral
          Phi d j partR .middle r s t‖ *
          ((ENNReal.ofReal s) ^ (d - 1) * ENNReal.ofReal ‖f (s • w)‖) =
        ENNReal.ofReal
          (‖brrsDyadicTwoRadiusStationaryComponentIntegral
              Phi d j partR .middle r s t‖ *
            (s ^ (d - 1) * ‖f (s • w)‖)) := by
    rw [← ENNReal.ofReal_pow hspos.le,
      ← ENNReal.ofReal_mul (pow_nonneg hspos.le _),
      ← ENNReal.ofReal_mul (norm_nonneg _)]
  have hQsource : 0 ≤ Qfac *
      (brrsRadialSobolevSourceProfile p f w s).toReal :=
    mul_nonneg hQfac ENNReal.toReal_nonneg
  have hquot : 0 ≤ (Qfac *
      (brrsRadialSobolevSourceProfile p f w s).toReal) / Dtail s :=
    div_nonneg hQsource hDtail.le
  calc
    ENNReal.ofReal ‖brrsDyadicTwoRadiusStationaryComponentIntegral
        Phi d j partR .middle r s t‖ *
        ((ENNReal.ofReal s) ^ (d - 1) * ENNReal.ofReal ‖f (s • w)‖) =
        ENNReal.ofReal
          (‖brrsDyadicTwoRadiusStationaryComponentIntegral
              Phi d j partR .middle r s t‖ *
            (s ^ (d - 1) * ‖f (s • w)‖)) := hleft
    _ ≤ ENNReal.ofReal (Cfac *
          (((Qfac * (brrsRadialSobolevSourceProfile p f w s).toReal) /
            Dtail s) * P s)) := by
      apply ENNReal.ofReal_le_ofReal
      simpa only [q, Cfac, Qfac, Dtail, P] using hreal
    _ = ENNReal.ofReal Cfac *
        (((ENNReal.ofReal Qfac * ENNReal.ofReal
            (brrsRadialSobolevSourceProfile p f w s).toReal) /
          ENNReal.ofReal (Dtail s)) * ENNReal.ofReal (P s)) := by
      rw [ENNReal.ofReal_mul hCfac,
        ENNReal.ofReal_mul hquot,
        ENNReal.ofReal_div_of_pos hDtail,
        ENNReal.ofReal_mul hQfac]
    _ ≤ ENNReal.ofReal Cfac *
        (((ENNReal.ofReal Qfac * brrsRadialSobolevSourceProfile p f w s) /
          ENNReal.ofReal (Dtail s)) * ENNReal.ofReal (P s)) := by
      gcongr
      exact ENNReal.ofReal_toReal_le
    _ = ENNReal.ofReal ((1 - (1 / 32 : Real)) * C) *
        (((ENNReal.ofReal
            (((2 : Real) ^ j) ^ (((d : Real) - 1) / 2 + 1) *
              (16 : Real) ^ (((d : Real) - 1) / 2)) *
            brrsRadialSobolevSourceProfile p f w s) /
          ENNReal.ofReal
            ((Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (M - d))) *
          ENNReal.ofReal (brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase partR (((2 : Real) ^ j) * r) +
              brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * s) +
                2 * Real.pi * (((2 : Real) ^ j) * t)))) := by
      rfl

/-- The rapid source-middle tail profile has an honest `p`-mass bound by the
Sobolev source profile itself.  The high-source condition makes its displayed
denominator at least one, while the stationary rapid profile is at most one.
This is the source-side `L^p` input for the compact-output tail, with no
residual `L¹` quantity. -/
theorem brrs_lintegral_Ici_lowHigh_middleSource_rapidSobolevSource_rpow_le
    {d N M : Nat} (_hMd : d ≤ M) {j : Nat} {r t p S : Real}
    (hp : 0 ≤ p) (hS : 16 ≤ ((2 : Real) ^ j) * S)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d)
    (partR : BRRSSurfaceWavePart) :
    (∫⁻ s in Ici S,
      ((brrsRadialSobolevSourceProfile p f w s /
        ENNReal.ofReal
          ((Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (M - d))) *
        ENNReal.ofReal (brrsStationaryRapidProfile N
          (brrsSurfaceWavePhase partR (((2 : Real) ^ j) * r) +
            brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * s) +
              2 * Real.pi * (((2 : Real) ^ j) * t)))) ^ p) ≤
      ∫⁻ s : Real, (brrsRadialSobolevSourceProfile p f w s) ^ p := by
  let q : Real := (2 : Real) ^ j
  let Dtail : Real → Real := fun s =>
    (Real.sqrt (q * s / 16)) ^ (M - d)
  let P : Real → Real := fun s => brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase partR (q * r) +
      brrsSurfaceWavePhase .middle (q * s) + 2 * Real.pi * (q * t))
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  calc
    (∫⁻ s in Ici S,
        ((brrsRadialSobolevSourceProfile p f w s /
          ENNReal.ofReal
            ((Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (M - d))) *
          ENNReal.ofReal (brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase partR (((2 : Real) ^ j) * r) +
              brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * s) +
                2 * Real.pi * (((2 : Real) ^ j) * t)))) ^ p) ≤
        ∫⁻ s in Ici S, (brrsRadialSobolevSourceProfile p f w s) ^ p := by
      apply setLIntegral_mono' measurableSet_Ici
      intro s hs
      have hhigh : 16 ≤ q * s := by
        calc
          16 ≤ q * S := by simpa only [q] using hS
          _ ≤ q * s := mul_le_mul_of_nonneg_left hs hq.le
      have hsqrt : 1 ≤ Real.sqrt (q * s / 16) := by
        rw [Real.one_le_sqrt]
        linarith
      have hDtail : 1 ≤ Dtail s := by
        dsimp only [Dtail]
        exact one_le_pow₀ hsqrt
      have hDtailENN : 1 ≤ ENNReal.ofReal (Dtail s) := by
        rw [← ENNReal.ofReal_one]
        exact ENNReal.ofReal_le_ofReal hDtail
      have hdiv : brrsRadialSobolevSourceProfile p f w s /
          ENNReal.ofReal (Dtail s) ≤ brrsRadialSobolevSourceProfile p f w s := by
        apply ENNReal.div_le_of_le_mul
        calc
          brrsRadialSobolevSourceProfile p f w s =
              brrsRadialSobolevSourceProfile p f w s * 1 := (mul_one _).symm
          _ ≤ brrsRadialSobolevSourceProfile p f w s *
              ENNReal.ofReal (Dtail s) := by
            gcongr
      have hP : ENNReal.ofReal (P s) ≤ 1 := by
        rw [← ENNReal.ofReal_one]
        apply ENNReal.ofReal_le_ofReal
        dsimp only [P]
        exact brrsStationaryRapidProfile_le_one N _
      have htail : (brrsRadialSobolevSourceProfile p f w s /
          ENNReal.ofReal (Dtail s)) * ENNReal.ofReal (P s) ≤
          brrsRadialSobolevSourceProfile p f w s := by
        calc
          (brrsRadialSobolevSourceProfile p f w s /
              ENNReal.ofReal (Dtail s)) * ENNReal.ofReal (P s) ≤
              brrsRadialSobolevSourceProfile p f w s /
                ENNReal.ofReal (Dtail s) :=
            mul_le_of_le_one_right bot_le hP
          _ ≤ brrsRadialSobolevSourceProfile p f w s := hdiv
      have hpow := ENNReal.rpow_le_rpow htail hp
      simpa only [q, Dtail, P] using hpow
    _ ≤ ∫⁻ s : Real, (brrsRadialSobolevSourceProfile p f w s) ^ p :=
      setLIntegral_le_lintegral (Ici S) _

/-- Every derivative of a literal planar circle-wave amplitude is uniformly
bounded when its physical radius lies in the compact output cell.  Unlike the
higher-dimensional version, the endpoint cases use the genuine planar
quadratic symbol. -/
theorem exists_norm_iteratedDeriv_brrsPlanarSurfaceWaveAmplitude_lowRadius_bound
    (k : Nat) (part : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ a rho : Real, 0 ≤ a → a ≤ 16 →
      ‖iteratedDeriv k (fun u : Real =>
        brrsPlanarSurfaceWaveAmplitude part a u) rho‖ ≤ C := by
  cases part with
  | outgoing =>
      obtain ⟨B, hB, hbound⟩ :=
        exists_iteratedDeriv_planarEndpointQuadraticIntegral_le k
      let C : Real := ‖(surfaceMass 1 : Complex)‖ * B * 128 ^ k + 1
      refine ⟨C, by dsimp [C]; positivity, ?_⟩
      intro a rho ha0 ha
      have hscale : |2 * Real.pi * a| ≤ 128 :=
        brrs_lowRadius_phaseScale_le ha0 ha
      have hpow : |2 * Real.pi * a| ^ k ≤ (128 : Real) ^ k :=
        pow_le_pow_left₀ (abs_nonneg _) hscale _
      have hk : ((k : ENat) : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) := by
        exact_mod_cast le_top
      unfold brrsPlanarSurfaceWaveAmplitude
      rw [iteratedDeriv_const_mul_field,
        iteratedDeriv_comp_const_smul
          (contDiff_planarEndpointQuadraticIntegral.of_le hk),
        norm_mul, norm_smul, Real.norm_eq_abs, abs_pow]
      calc
        ‖(surfaceMass 1 : Complex)‖ *
            (|2 * Real.pi * a| ^ k *
              ‖iteratedDeriv k planarEndpointQuadraticIntegral
                ((2 * Real.pi * a) * rho)‖) ≤
            ‖(surfaceMass 1 : Complex)‖ * (|2 * Real.pi * a| ^ k * B) := by
          gcongr
          exact hbound _
        _ = (‖(surfaceMass 1 : Complex)‖ * B) * |2 * Real.pi * a| ^ k := by
          ring
        _ ≤ (‖(surfaceMass 1 : Complex)‖ * B) * (128 : Real) ^ k := by
          exact mul_le_mul_of_nonneg_left hpow (mul_nonneg (norm_nonneg _) hB.le)
        _ ≤ C := by
          dsimp [C]
          linarith
  | incoming =>
      obtain ⟨B, hB, hbound⟩ :=
        exists_iteratedDeriv_planarEndpointQuadraticIntegral_le k
      let C : Real := ‖(surfaceMass 1 : Complex)‖ * B * 128 ^ k + 1
      refine ⟨C, by dsimp [C]; positivity, ?_⟩
      intro a rho ha0 ha
      have hscale : |-(2 * Real.pi * a)| ≤ 128 := by
        rw [abs_neg]
        exact brrs_lowRadius_phaseScale_le ha0 ha
      have hpow : |-(2 * Real.pi * a)| ^ k ≤ (128 : Real) ^ k :=
        pow_le_pow_left₀ (abs_nonneg _) hscale _
      have hk : ((k : ENat) : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) := by
        exact_mod_cast le_top
      unfold brrsPlanarSurfaceWaveAmplitude
      rw [iteratedDeriv_const_mul_field,
        iteratedDeriv_comp_const_smul
          (contDiff_planarEndpointQuadraticIntegral.of_le hk),
        norm_mul, norm_smul, Real.norm_eq_abs, abs_pow]
      calc
        ‖(surfaceMass 1 : Complex)‖ *
            (|-(2 * Real.pi * a)| ^ k *
              ‖iteratedDeriv k planarEndpointQuadraticIntegral
                ((-(2 * Real.pi * a)) * rho)‖) ≤
            ‖(surfaceMass 1 : Complex)‖ * (|-(2 * Real.pi * a)| ^ k * B) := by
          gcongr
          exact hbound _
        _ = (‖(surfaceMass 1 : Complex)‖ * B) * |-(2 * Real.pi * a)| ^ k := by
          ring
        _ ≤ (‖(surfaceMass 1 : Complex)‖ * B) * (128 : Real) ^ k := by
          exact mul_le_mul_of_nonneg_left hpow (mul_nonneg (norm_nonneg _) hB.le)
        _ ≤ C := by
          dsimp [C]
          linarith
  | middle =>
      obtain ⟨B, hB, hbound⟩ :=
        exists_norm_iteratedDeriv_coordinateMiddleMeridianLocalizedIntegral_le 0 k
      let C : Real := ‖(surfaceMass 1 : Complex)‖ * B * 128 ^ k + 1
      refine ⟨C, by dsimp [C]; positivity, ?_⟩
      intro a rho ha0 ha
      have hscale : |2 * Real.pi * a| ≤ 128 :=
        brrs_lowRadius_phaseScale_le ha0 ha
      have hpow : |2 * Real.pi * a| ^ k ≤ (128 : Real) ^ k :=
        pow_le_pow_left₀ (abs_nonneg _) hscale _
      have hk : ((k : ENat) : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) := by
        exact_mod_cast le_top
      unfold brrsPlanarSurfaceWaveAmplitude
      rw [iteratedDeriv_const_mul_field,
        iteratedDeriv_comp_const_smul
          ((contDiff_coordinateMiddleMeridianLocalizedIntegral 0).of_le hk),
        norm_mul, norm_smul, Real.norm_eq_abs, abs_pow]
      calc
        ‖(surfaceMass 1 : Complex)‖ *
            (|2 * Real.pi * a| ^ k *
              ‖iteratedDeriv k
                (coordinateMiddleMeridianLocalizedIntegral 0)
                ((2 * Real.pi * a) * rho)‖) ≤
            ‖(surfaceMass 1 : Complex)‖ * (|2 * Real.pi * a| ^ k * B) := by
          gcongr
          exact hbound _
        _ = (‖(surfaceMass 1 : Complex)‖ * B) * |2 * Real.pi * a| ^ k := by
          ring
        _ ≤ (‖(surfaceMass 1 : Complex)‖ * B) * (128 : Real) ^ k := by
          exact mul_le_mul_of_nonneg_left hpow (mul_nonneg (norm_nonneg _) hB.le)
        _ ≤ C := by
          dsimp [C]
          linarith

/-- A single compact-cell bound controls every derivative needed in a finite
planar integration-by-parts argument. -/
theorem exists_uniform_iteratedDeriv_brrsPlanarSurfaceWaveAmplitude_lowRadius_bound
    (N : Nat) (part : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ a rho : Real,
      0 ≤ a → a ≤ 16 → rho ∈ Icc (1 / 32 : Real) 1 →
        ‖iteratedDeriv k (fun u : Real =>
          brrsPlanarSurfaceWaveAmplitude part a u) rho‖ ≤ C := by
  choose A hApos hAbound using fun k : Nat =>
    exists_norm_iteratedDeriv_brrsPlanarSurfaceWaveAmplitude_lowRadius_bound k part
  let C : Real := ∑ k ∈ Finset.range (N + 1), A k
  have hC : 0 < C := by
    have hzero : 0 ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    have hle : A 0 ≤ C := by
      dsimp [C]
      exact Finset.single_le_sum (fun k hk => (hApos k).le) hzero
    exact lt_of_lt_of_le (hApos 0) hle
  refine ⟨C, hC, ?_⟩
  intro k hk a rho ha0 ha _hrho
  have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
  have hle : A k ≤ C := by
    dsimp [C]
    exact Finset.single_le_sum (fun l hl => (hApos l).le) hkmem
  exact (hAbound k a rho ha0 ha).trans hle

/-- On the compact planar radial cell, the one-radius coefficient obtained
after extracting a circle-wave carrier has uniform derivative bounds of every
fixed order.  This is the fixed-factor/product estimate needed before the
two-radius compact--compact integration-by-parts argument. -/
theorem exists_uniform_iteratedDeriv_brrsPlanarStatWaveRadialCoefficient_lowRad_bound
    (N : Nat) (Phi : BRRSAnnularCutoff) (part : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ a rho : Real,
      0 ≤ a → a ≤ 16 → rho ∈ Icc (1 / 32 : Real) 1 →
        ‖iteratedDeriv k (fun u : Real =>
          brrsPlanarStationaryWaveRadialCoefficient Phi part a u) rho‖ ≤ C := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_iteratedDeriv_brrsStationaryWaveRadialFixedFactor_bound Phi 2 N
  obtain ⟨B, hB, hBbound⟩ :=
    exists_uniform_iteratedDeriv_brrsPlanarSurfaceWaveAmplitude_lowRadius_bound N part
  let C : Real := ∑ l ∈ Finset.range (N + 1),
    brrsStationaryLeibnizConstant l A B
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact brrsStationaryLeibnizConstant_nonneg l hA.le hB.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk a rho ha0 ha hrho
  let fixed : Real → Complex := brrsStationaryWaveRadialFixedFactor Phi 2
  let physical : Real → Complex := fun u : Real =>
    brrsPlanarSurfaceWaveAmplitude part a u
  have hfixed : ContDiff Real (⊤ : ENat) fixed := by
    dsimp [fixed]
    exact contDiff_brrsStationaryWaveRadialFixedFactor Phi 2
  have hphysical : ContDiff Real (⊤ : ENat) physical := by
    dsimp [physical]
    exact contDiff_brrsPlanarSurfaceWaveAmplitude part a
  have hphysicalbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l physical rho‖ ≤ B := by
    intro l hl
    exact hBbound l (hl.trans hk) a rho ha0 ha hrho
  have hprod := norm_iteratedDeriv_mul_le_brrsStationaryLeibnizConstant
    (n := k) hfixed hphysical hA.le hB.le
    (fun l hl => hAbound l (hl.trans hk) rho hrho) hphysicalbound
  have hfactorfun : (fun u : Real =>
      brrsPlanarStationaryWaveRadialCoefficient Phi part a u) =
      fun u : Real => fixed u * physical u := by
    funext u
    dsimp [fixed, physical]
    rfl
  rw [hfactorfun]
  have hCbound : brrsStationaryLeibnizConstant k A B ≤ C := by
    unfold C
    have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    exact Finset.single_le_sum
      (fun l hl => brrsStationaryLeibnizConstant_nonneg l hA.le hB.le) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real => fixed u * physical u) rho‖ ≤
        brrsStationaryLeibnizConstant k A B := hprod
    _ ≤ C := hCbound
    _ ≤ C + 1 := by linarith

/-- Every derivative of a literal planar two-radius stationary coefficient is
uniformly bounded when both radii lie in the compact cell.  This is the
precise compact--compact amplitude input for the radial kernel estimate. -/
theorem exists_uniform_iteratedDeriv_brrsPlanarTwoRadiusStationaryCoefficient_lowLow_bound
    (N : Nat) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ r s rho : Real,
      0 ≤ r → r ≤ 16 → 0 ≤ s → s ≤ 16 →
      rho ∈ Icc (1 / 32 : Real) 1 →
        ‖iteratedDeriv k (fun u : Real =>
          brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s u) rho‖ ≤ C := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_iteratedDeriv_brrsPlanarSurfaceWaveAmplitude_lowRadius_bound N partR
  obtain ⟨B, hB, hBbound⟩ :=
    exists_uniform_iteratedDeriv_brrsPlanarStatWaveRadialCoefficient_lowRad_bound
      N Phi partS
  let C : Real := ∑ l ∈ Finset.range (N + 1),
    brrsStationaryLeibnizConstant l A B
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact brrsStationaryLeibnizConstant_nonneg l hA.le hB.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk r s rho hr0 hr hs0 hs hrho
  let left : Real → Complex := fun u : Real =>
    brrsPlanarSurfaceWaveAmplitude partR r u
  let right : Real → Complex := fun u : Real =>
    brrsPlanarStationaryWaveRadialCoefficient Phi partS s u
  have hleft : ContDiff Real (⊤ : ENat) left := by
    dsimp [left]
    exact contDiff_brrsPlanarSurfaceWaveAmplitude partR r
  have hright : ContDiff Real (⊤ : ENat) right := by
    dsimp [right]
    exact contDiff_brrsPlanarStationaryWaveRadialCoefficient Phi partS s
  have hleftbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l left rho‖ ≤ A := by
    intro l hl
    exact hAbound l (hl.trans hk) r rho hr0 hr hrho
  have hrightbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l right rho‖ ≤ B := by
    intro l hl
    exact hBbound l (hl.trans hk) s rho hs0 hs hrho
  have hprod := norm_iteratedDeriv_mul_le_brrsStationaryLeibnizConstant
    (n := k) hleft hright hA.le hB.le hleftbound hrightbound
  have hfactorfun : (fun u : Real =>
      brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s u) =
      fun u : Real => left u * right u := by
    funext u
    dsimp [left, right]
    exact brrsPlanarTwoRadiusStationaryCoefficient_eq_amplitude_mul_coefficient
      Phi partR partS r s u
  rw [hfactorfun]
  have hCbound : brrsStationaryLeibnizConstant k A B ≤ C := by
    unfold C
    have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    exact Finset.single_le_sum
      (fun l hl => brrsStationaryLeibnizConstant_nonneg l hA.le hB.le) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real => left u * right u) rho‖ ≤
        brrsStationaryLeibnizConstant k A B := hprod
    _ ≤ C := hCbound
    _ ≤ C + 1 := by linarith

/-- The compact--compact planar stationary component has a bounded rapidly
decaying profile of its exact carrier.  This is the missing circle analogue
of the low--low two-radius integration-by-parts estimate. -/
theorem exists_norm_brrsPlanarTwoRadiusStationaryComponentIntegral_lowLow_profile_le
    (N : Nat) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real,
      0 ≤ r → r ≤ 16 → 0 ≤ s → s ≤ 16 →
      ‖brrsPlanarTwoRadiusStationaryComponentIntegral Phi partR partS r s t‖ ≤
        (1 - (1 / 32 : Real)) * C *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase partR r +
              brrsSurfaceWavePhase partS s + 2 * Real.pi * t) := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_intervalInteg_brrsPlanarTwoRadStatCoeff_profile_le_of_deriv_decay
      N Phi partR partS
      (fun r s => 0 ≤ r ∧ r ≤ 16 ∧ 0 ≤ s ∧ s ≤ 16)
      (fun _ _ => (1 : Real))
      (by
        intro r s hrs
        norm_num)
      (by
        obtain ⟨D, hD, hderiv⟩ :=
          exists_uniform_iteratedDeriv_brrsPlanarTwoRadiusStationaryCoefficient_lowLow_bound
            N Phi partR partS
        refine ⟨D, hD, ?_⟩
        intro k hk r s rho hrs hrho
        simpa only [div_one] using
          hderiv k hk r s rho hrs.1 hrs.2.1 hrs.2.2.1 hrs.2.2.2 hrho)
  refine ⟨C, hC, ?_⟩
  intro r s t hr0 hr hs0 hs
  rw [brrsPlanarTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
  simpa using hprofile r s
    (brrsSurfaceWavePhase partR r +
      brrsSurfaceWavePhase partS s + 2 * Real.pi * t)
    ⟨hr0, hr, hs0, hs⟩

/-- In the planar compact-output/high-source regime, every literal stationary
component retains the one available source half-density.  The source part may
be either endpoint or middle: in the latter case we use its rapid estimate at
the minimal nontrivial order. -/
theorem exists_uniform_iteratedDeriv_brrsPlanarTwoRadiusStationaryCoefficient_lowHigh_decay
    (N : Nat) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ r s rho : Real,
      0 ≤ r → r ≤ 16 → 16 ≤ s → rho ∈ Icc (1 / 32 : Real) 1 →
        ‖iteratedDeriv k (fun u : Real =>
          brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s u) rho‖ ≤
          C / Real.sqrt (s / 16) := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_iteratedDeriv_brrsPlanarSurfaceWaveAmplitude_lowRadius_bound N partR
  have hsource : ∃ B : Real, 0 < B ∧ ∀ k : Nat, k ≤ N → ∀ s rho : Real,
      16 ≤ s → rho ∈ Icc (1 / 32 : Real) 1 →
        ‖iteratedDeriv k (fun u : Real =>
          brrsPlanarStationaryWaveRadialCoefficient Phi partS s u) rho‖ ≤
          B / Real.sqrt (s / 16) := by
    cases partS with
    | outgoing =>
        obtain ⟨B, hB, hBbound⟩ :=
          exists_unif_iteratedDeriv_brrsPlanStatWaveRadialCoeff_endpoint_highRad_decay
            N Phi .outgoing (Or.inl rfl)
        refine ⟨B, hB, ?_⟩
        intro k hk s rho hs hrho
        exact hBbound k hk s rho hs hrho
    | incoming =>
        obtain ⟨B, hB, hBbound⟩ :=
          exists_unif_iteratedDeriv_brrsPlanStatWaveRadialCoeff_endpoint_highRad_decay
            N Phi .incoming (Or.inr rfl)
        refine ⟨B, hB, ?_⟩
        intro k hk s rho hs hrho
        exact hBbound k hk s rho hs hrho
    | middle =>
        obtain ⟨B, hB, hBbound⟩ :=
          exists_unif_iteratedDeriv_brrsPlanStatWaveRadialCoeff_mid_highRad_rapidDecay
            N 2 (by omega) Phi
        refine ⟨B, hB, ?_⟩
        intro k hk s rho hs hrho
        simpa using hBbound k hk s rho hs hrho
  obtain ⟨B, hB, hBbound⟩ := hsource
  let C : Real := ∑ l ∈ Finset.range (N + 1),
    brrsStationaryLeibnizConstant l A B
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact brrsStationaryLeibnizConstant_nonneg l hA.le hB.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk r s rho hr0 hr hs hrho
  let left : Real → Complex := fun u : Real =>
    brrsPlanarSurfaceWaveAmplitude partR r u
  let right : Real → Complex := fun u : Real =>
    brrsPlanarStationaryWaveRadialCoefficient Phi partS s u
  have hleft : ContDiff Real (⊤ : ENat) left := by
    dsimp [left]
    exact contDiff_brrsPlanarSurfaceWaveAmplitude partR r
  have hright : ContDiff Real (⊤ : ENat) right := by
    dsimp [right]
    exact contDiff_brrsPlanarStationaryWaveRadialCoefficient Phi partS s
  have hqpos : 0 < Real.sqrt (s / 16) := by
    apply Real.sqrt_pos.2
    linarith
  have hleftbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l left rho‖ ≤ A := by
    intro l hl
    exact hAbound l (hl.trans hk) r rho hr0 hr hrho
  have hrightbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l right rho‖ ≤ B / Real.sqrt (s / 16) := by
    intro l hl
    exact hBbound l (hl.trans hk) s rho hs hrho
  have hprod := norm_iteratedDeriv_mul_le_brrsStationaryLeibnizConstant
    (n := k) hleft hright hA.le
    (div_nonneg hB.le hqpos.le) hleftbound hrightbound
  have hfactorfun : (fun u : Real =>
      brrsPlanarTwoRadiusStationaryCoefficient Phi partR partS r s u) =
      fun u : Real => left u * right u := by
    funext u
    dsimp [left, right]
    exact brrsPlanarTwoRadiusStationaryCoefficient_eq_amplitude_mul_coefficient
      Phi partR partS r s u
  rw [hfactorfun]
  have hCbound : brrsStationaryLeibnizConstant k A B ≤ C := by
    unfold C
    have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    exact Finset.single_le_sum
      (fun l hl => brrsStationaryLeibnizConstant_nonneg l hA.le hB.le) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real => left u * right u) rho‖ ≤
        brrsStationaryLeibnizConstant k A
          (B / Real.sqrt (s / 16)) := hprod
    _ = brrsStationaryLeibnizConstant k A B /
          Real.sqrt (s / 16) := by
      rw [brrsPlanarStationaryLeibnizConstant_right_div k A B
        (Real.sqrt (s / 16)) hqpos.ne']
    _ ≤ C / Real.sqrt (s / 16) :=
      div_le_div_of_nonneg_right hCbound hqpos.le
    _ ≤ (C + 1) / Real.sqrt (s / 16) :=
      div_le_div_of_nonneg_right (by linarith) hqpos.le

/-- The preceding literal planar coefficient bound transfers to a rapid
profile of its exact stationary carrier. -/
theorem exists_norm_brrsPlanarTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
    (N : Nat) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real,
      0 ≤ r → r ≤ 16 → 16 ≤ s →
      ‖brrsPlanarTwoRadiusStationaryComponentIntegral Phi partR partS r s t‖ ≤
        (1 - (1 / 32 : Real)) * (C / Real.sqrt (s / 16)) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase partR r +
              brrsSurfaceWavePhase partS s + 2 * Real.pi * t) := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_intervalInteg_brrsPlanarTwoRadStatCoeff_profile_le_of_deriv_decay
      N Phi partR partS
      (fun r s => 0 ≤ r ∧ r ≤ 16 ∧ 16 ≤ s)
      (fun _ s => Real.sqrt (s / 16))
      (by
        intro r s hrs
        apply Real.sqrt_pos.2
        linarith [hrs.2.2])
      (by
        obtain ⟨D, hD, hderiv⟩ :=
          exists_uniform_iteratedDeriv_brrsPlanarTwoRadiusStationaryCoefficient_lowHigh_decay
            N Phi partR partS
        refine ⟨D, hD, ?_⟩
        intro k hk r s rho hrs hrho
        exact hderiv k hk r s rho hrs.1 hrs.2.1 hrs.2.2 hrho)
  refine ⟨C, hC, ?_⟩
  intro r s t hr0 hr hs
  rw [brrsPlanarTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
  exact hprofile r s
    (brrsSurfaceWavePhase partR r +
      brrsSurfaceWavePhase partS s + 2 * Real.pi * t)
    ⟨hr0, hr, hs⟩

/-- Finite all-nine bookkeeping for the literal planar stationary model.
It is intentionally separate from the higher-dimensional helper, since the
circle endpoint amplitudes are represented by the planar quadratic symbol. -/
theorem norm_brrsPlanarTwoRadiusAllStationaryComponentIntegralSum_le_of_component_bounds
    (Phi : BRRSAnnularCutoff) (N : Nat) (r s t A : Real)
    (hbound : ∀ partR partS : BRRSSurfaceWavePart,
      ‖brrsPlanarTwoRadiusStationaryComponentIntegral Phi partR partS r s t‖ ≤
        A * brrsStationaryRapidProfile N
          (brrsSurfaceWavePhase partR r +
            brrsSurfaceWavePhase partS s + 2 * Real.pi * t)) :
    ‖brrsPlanarTwoRadiusAllStationaryComponentIntegralSum Phi r s t‖ ≤
      A * brrsTwoRadiusNinePhaseProfile N r s t := by
  let Ioo : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .outgoing .outgoing r s t
  let Ioi : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .outgoing .incoming r s t
  let Iom : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .outgoing .middle r s t
  let Iio : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .incoming .outgoing r s t
  let Iii : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .incoming .incoming r s t
  let Iim : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .incoming .middle r s t
  let Imo : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .middle .outgoing r s t
  let Imi : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .middle .incoming r s t
  let Imm : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .middle .middle r s t
  let Poo : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .outgoing r +
      brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t)
  let Poi : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .outgoing r +
      brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)
  let Pom : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .outgoing r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  let Pio : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .incoming r +
      brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t)
  let Pii : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .incoming r +
      brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)
  let Pim : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .incoming r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  let Pmo : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t)
  let Pmi : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)
  let Pmm : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  have hIoo : ‖Ioo‖ ≤ A * Poo := by
    dsimp [Ioo, Poo]
    exact hbound .outgoing .outgoing
  have hIoi : ‖Ioi‖ ≤ A * Poi := by
    dsimp [Ioi, Poi]
    exact hbound .outgoing .incoming
  have hIom : ‖Iom‖ ≤ A * Pom := by
    dsimp [Iom, Pom]
    exact hbound .outgoing .middle
  have hIio : ‖Iio‖ ≤ A * Pio := by
    dsimp [Iio, Pio]
    exact hbound .incoming .outgoing
  have hIii : ‖Iii‖ ≤ A * Pii := by
    dsimp [Iii, Pii]
    exact hbound .incoming .incoming
  have hIim : ‖Iim‖ ≤ A * Pim := by
    dsimp [Iim, Pim]
    exact hbound .incoming .middle
  have hImo : ‖Imo‖ ≤ A * Pmo := by
    dsimp [Imo, Pmo]
    exact hbound .middle .outgoing
  have hImi : ‖Imi‖ ≤ A * Pmi := by
    dsimp [Imi, Pmi]
    exact hbound .middle .incoming
  have hImm : ‖Imm‖ ≤ A * Pmm := by
    dsimp [Imm, Pmm]
    exact hbound .middle .middle
  change ‖((Ioo + Ioi) + Iom) +
      (((Iio + Iii) + Iim) + ((Imo + Imi) + Imm))‖ ≤
    A * ((Poo + Poi + Pom) + ((Pio + Pii + Pim) + (Pmo + Pmi + Pmm)))
  calc
    ‖((Ioo + Ioi) + Iom) +
        (((Iio + Iii) + Iim) + ((Imo + Imi) + Imm))‖ ≤
        ‖(Ioo + Ioi) + Iom‖ +
          ‖((Iio + Iii) + Iim) + ((Imo + Imi) + Imm)‖ := norm_add_le _ _
    _ ≤ (‖Ioo + Ioi‖ + ‖Iom‖) +
          (‖Iio + Iii‖ + ‖Iim‖ + (‖Imo + Imi‖ + ‖Imm‖)) := by
        apply add_le_add
        · exact norm_add_le _ _
        · calc
            ‖((Iio + Iii) + Iim) + ((Imo + Imi) + Imm)‖ ≤
                ‖(Iio + Iii) + Iim‖ + ‖(Imo + Imi) + Imm‖ := norm_add_le _ _
            _ ≤ (‖Iio + Iii‖ + ‖Iim‖) + (‖Imo + Imi‖ + ‖Imm‖) := by
              gcongr
              · exact norm_add_le _ _
              · exact norm_add_le _ _
    _ ≤ ((‖Ioo‖ + ‖Ioi‖) + ‖Iom‖) +
          ((‖Iio‖ + ‖Iii‖) + ‖Iim‖ + ((‖Imo‖ + ‖Imi‖) + ‖Imm‖)) := by
        gcongr <;> exact norm_add_le _ _
    _ ≤ ((A * Poo + A * Poi) + A * Pom) +
          ((A * Pio + A * Pii) + A * Pim + ((A * Pmo + A * Pmi) + A * Pmm)) := by
        apply add_le_add
        · exact add_le_add (add_le_add hIoo hIoi) hIom
        · exact add_le_add
            (add_le_add (add_le_add hIio hIii) hIim)
            (add_le_add (add_le_add hImo hImi) hImm)
    _ = A * ((Poo + Poi + Pom) + ((Pio + Pii + Pim) + (Pmo + Pmi + Pmm))) := by
        ring

/-- Common-majorant bookkeeping for the planar all-nine stationary kernel.
It is used after moving every planar middle carrier to one of the endpoint
phase lines. -/
theorem norm_brrsPlanarTwoRadAllStatComponentIntegralSum_le_of_component_common_bound
    (Phi : BRRSAnnularCutoff) (r s t A P : Real)
    (hbound : ∀ partR partS : BRRSSurfaceWavePart,
      ‖brrsPlanarTwoRadiusStationaryComponentIntegral Phi partR partS r s t‖ ≤
        A * P) :
    ‖brrsPlanarTwoRadiusAllStationaryComponentIntegralSum Phi r s t‖ ≤
      (9 : Real) * A * P := by
  let Ioo : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .outgoing .outgoing r s t
  let Ioi : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .outgoing .incoming r s t
  let Iom : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .outgoing .middle r s t
  let Iio : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .incoming .outgoing r s t
  let Iii : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .incoming .incoming r s t
  let Iim : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .incoming .middle r s t
  let Imo : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .middle .outgoing r s t
  let Imi : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .middle .incoming r s t
  let Imm : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .middle .middle r s t
  have hIoo : ‖Ioo‖ ≤ A * P := by
    dsimp [Ioo]
    exact hbound .outgoing .outgoing
  have hIoi : ‖Ioi‖ ≤ A * P := by
    dsimp [Ioi]
    exact hbound .outgoing .incoming
  have hIom : ‖Iom‖ ≤ A * P := by
    dsimp [Iom]
    exact hbound .outgoing .middle
  have hIio : ‖Iio‖ ≤ A * P := by
    dsimp [Iio]
    exact hbound .incoming .outgoing
  have hIii : ‖Iii‖ ≤ A * P := by
    dsimp [Iii]
    exact hbound .incoming .incoming
  have hIim : ‖Iim‖ ≤ A * P := by
    dsimp [Iim]
    exact hbound .incoming .middle
  have hImo : ‖Imo‖ ≤ A * P := by
    dsimp [Imo]
    exact hbound .middle .outgoing
  have hImi : ‖Imi‖ ≤ A * P := by
    dsimp [Imi]
    exact hbound .middle .incoming
  have hImm : ‖Imm‖ ≤ A * P := by
    dsimp [Imm]
    exact hbound .middle .middle
  change ‖((Ioo + Ioi) + Iom) +
      (((Iio + Iii) + Iim) + ((Imo + Imi) + Imm))‖ ≤
    (9 : Real) * A * P
  calc
    ‖((Ioo + Ioi) + Iom) +
        (((Iio + Iii) + Iim) + ((Imo + Imi) + Imm))‖ ≤
        ‖(Ioo + Ioi) + Iom‖ +
          ‖((Iio + Iii) + Iim) + ((Imo + Imi) + Imm)‖ := norm_add_le _ _
    _ ≤ (‖Ioo‖ + ‖Ioi‖ + ‖Iom‖) +
          (‖Iio‖ + ‖Iii‖ + ‖Iim‖ + (‖Imo‖ + ‖Imi‖ + ‖Imm‖)) := by
      apply add_le_add
      · calc
          ‖(Ioo + Ioi) + Iom‖ ≤ ‖Ioo + Ioi‖ + ‖Iom‖ := norm_add_le _ _
          _ ≤ (‖Ioo‖ + ‖Ioi‖) + ‖Iom‖ := by
            exact add_le_add (norm_add_le _ _) le_rfl
          _ = ‖Ioo‖ + ‖Ioi‖ + ‖Iom‖ := by ring
      · calc
          ‖((Iio + Iii) + Iim) + ((Imo + Imi) + Imm)‖ ≤
              ‖(Iio + Iii) + Iim‖ + ‖(Imo + Imi) + Imm‖ := norm_add_le _ _
          _ ≤ (‖Iio‖ + ‖Iii‖ + ‖Iim‖) + (‖Imo‖ + ‖Imi‖ + ‖Imm‖) := by
            apply add_le_add
            · calc
                ‖(Iio + Iii) + Iim‖ ≤ ‖Iio + Iii‖ + ‖Iim‖ := norm_add_le _ _
                _ ≤ (‖Iio‖ + ‖Iii‖) + ‖Iim‖ := by
                  exact add_le_add (norm_add_le _ _) le_rfl
                _ = ‖Iio‖ + ‖Iii‖ + ‖Iim‖ := by ring
            · calc
                ‖(Imo + Imi) + Imm‖ ≤ ‖Imo + Imi‖ + ‖Imm‖ := norm_add_le _ _
                _ ≤ (‖Imo‖ + ‖Imi‖) + ‖Imm‖ := by
                  exact add_le_add (norm_add_le _ _) le_rfl
                _ = ‖Imo‖ + ‖Imi‖ + ‖Imm‖ := by ring
          _ = ‖Iio‖ + ‖Iii‖ + ‖Iim‖ + (‖Imo‖ + ‖Imi‖ + ‖Imm‖) := by ring
    _ ≤ (A * P + A * P + A * P) +
          (A * P + A * P + A * P + (A * P + A * P + A * P)) := by
      gcongr
    _ = (9 : Real) * A * P := by ring

/-- The literal planar all-nine kernel on a compact output cell has the
single high-source half-density, with all nine exact phase profiles retained. -/
theorem exists_norm_brrsPlanarTwoRadAllStatCompIntegSum_lowHigh_ninePhase_profile_le
    (N : Nat) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real,
      0 ≤ r → r ≤ 16 → 16 ≤ s →
      ‖brrsPlanarTwoRadiusAllStationaryComponentIntegralSum Phi r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / Real.sqrt (s / 16)) *
            brrsTwoRadiusNinePhaseProfile N r s t := by
  obtain ⟨Coo, hCoo, hoo⟩ :=
    exists_norm_brrsPlanarTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      N Phi .outgoing .outgoing
  obtain ⟨Coi, hCoi, hoi⟩ :=
    exists_norm_brrsPlanarTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      N Phi .outgoing .incoming
  obtain ⟨Com, hCom, hom⟩ :=
    exists_norm_brrsPlanarTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      N Phi .outgoing .middle
  obtain ⟨Cio, hCio, hio⟩ :=
    exists_norm_brrsPlanarTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      N Phi .incoming .outgoing
  obtain ⟨Cii, hCii, hii⟩ :=
    exists_norm_brrsPlanarTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      N Phi .incoming .incoming
  obtain ⟨Cim, hCim, him⟩ :=
    exists_norm_brrsPlanarTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      N Phi .incoming .middle
  obtain ⟨Cmo, hCmo, hmo⟩ :=
    exists_norm_brrsPlanarTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      N Phi .middle .outgoing
  obtain ⟨Cmi, hCmi, hmi⟩ :=
    exists_norm_brrsPlanarTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      N Phi .middle .incoming
  obtain ⟨Cmm, hCmm, hmm⟩ :=
    exists_norm_brrsPlanarTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
      N Phi .middle .middle
  let C : Real :=
    (Coo + Coi + Com) + ((Cio + Cii + Cim) + (Cmo + Cmi + Cmm))
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro r s t hr0 hr hs
  let q : Real := Real.sqrt (s / 16)
  let A : Real := (1 - (1 / 32 : Real)) * (C / q)
  have hq : 0 < q := by
    dsimp [q]
    apply Real.sqrt_pos.2
    linarith
  have hCoo_le : Coo ≤ C := by dsimp [C]; linarith
  have hCoi_le : Coi ≤ C := by dsimp [C]; linarith
  have hCom_le : Com ≤ C := by dsimp [C]; linarith
  have hCio_le : Cio ≤ C := by dsimp [C]; linarith
  have hCii_le : Cii ≤ C := by dsimp [C]; linarith
  have hCim_le : Cim ≤ C := by dsimp [C]; linarith
  have hCmo_le : Cmo ≤ C := by dsimp [C]; linarith
  have hCmi_le : Cmi ≤ C := by dsimp [C]; linarith
  have hCmm_le : Cmm ≤ C := by dsimp [C]; linarith
  have hAbsorb (D P : Real) (hD : D ≤ C) (hP : 0 ≤ P) :
      (1 - (1 / 32 : Real)) * (D / q) * P ≤ A * P := by
    apply mul_le_mul_of_nonneg_right _ hP
    dsimp [A]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hD hq.le
    · norm_num
  have hall := norm_brrsPlanarTwoRadiusAllStationaryComponentIntegralSum_le_of_component_bounds
    Phi N r s t A
  apply hall
  intro partR partS
  cases partR <;> cases partS
  all_goals
    first
    | exact (hoo r s t hr0 hr hs).trans
        (hAbsorb Coo _ hCoo_le (brrsStationaryRapidProfile_nonneg N _))
    | exact (hoi r s t hr0 hr hs).trans
        (hAbsorb Coi _ hCoi_le (brrsStationaryRapidProfile_nonneg N _))
    | exact (hom r s t hr0 hr hs).trans
        (hAbsorb Com _ hCom_le (brrsStationaryRapidProfile_nonneg N _))
    | exact (hio r s t hr0 hr hs).trans
        (hAbsorb Cio _ hCio_le (brrsStationaryRapidProfile_nonneg N _))
    | exact (hii r s t hr0 hr hs).trans
        (hAbsorb Cii _ hCii_le (brrsStationaryRapidProfile_nonneg N _))
    | exact (him r s t hr0 hr hs).trans
        (hAbsorb Cim _ hCim_le (brrsStationaryRapidProfile_nonneg N _))
    | exact (hmo r s t hr0 hr hs).trans
        (hAbsorb Cmo _ hCmo_le (brrsStationaryRapidProfile_nonneg N _))
    | exact (hmi r s t hr0 hr hs).trans
        (hAbsorb Cmi _ hCmi_le (brrsStationaryRapidProfile_nonneg N _))
    | exact (hmm r s t hr0 hr hs).trans
        (hAbsorb Cmm _ hCmm_le (brrsStationaryRapidProfile_nonneg N _))

