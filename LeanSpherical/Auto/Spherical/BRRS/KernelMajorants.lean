  rw [brrsDyadicHalfWave_eq_dyadicAllStationaryComponentIntegralSum
    hd Phi j t f hf v w hv hw r (by
      by_contra hnonneg
      have hneg : r < 0 := lt_of_not_ge hnonneg
      have hscaled_neg : ((2 : Real) ^ j) * r < 0 :=
