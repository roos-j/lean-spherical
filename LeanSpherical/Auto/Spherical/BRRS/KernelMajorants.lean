/-- A literal supported-source bridge for the compact output cell `I₀`.
If a radial Schwartz datum vanishes below the source threshold `S`, then the
actual dyadic half-wave at a compact output radius is controlled by the
low--high all-nine Sobolev tail.  This is obtained directly from the exact
radial stationary-component integral for `brrsDyadicHalfWave`; no model
operator or additional kernel assumption is introduced. -/
theorem exists_ennreal_norm_brrsDyadicHalfWave_I0_supported_lowHigh_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r t p S : Real,
      ∀ f : BRRSSchwartz d,
      ∀ _hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ v w : BRRSSpace d, ‖v‖ = 1 → ‖w‖ = 1 → 2 ≤ p →
      0 ≤ r → r ≤ dyadicTimeScale j →
      16 ≤ ((2 : Real) ^ j) * S →
      (∀ s : Ioi (0 : Real), s.1 < S → f (s.1 • w) = 0) →
      ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
        ∫⁻ s in Ici S,
          ENNReal.ofReal ((1 - (1 / 32 : Real)) * C) *
            ((ENNReal.ofReal
                (((2 : Real) ^ j) ^ (((d : Real) - 1) / 2 + 1) *
                  (16 : Real) ^ (((d : Real) - 1) / 2)) *
                brrsRadialSobolevSourceProfile p
                  (f : BRRSSpace d → Complex) w s) *
              ENNReal.ofReal (brrsTwoRadiusNinePhaseProfile N
                (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
                  (((2 : Real) ^ j) * t))) := by
  obtain ⟨C, hC, hkernel⟩ :=
    exists_brrsDyadicI0_lowHigh_sobolevSource_ninePhase_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j r t p S f hf v w hv hw hp hr0 hr hS hsupport
  let q : Real := (2 : Real) ^ j
  let Cfac : Real := (1 - (1 / 32 : Real)) * C
  let Qfac : Real := q ^ (((d : Real) - 1) / 2 + 1) *
    (16 : Real) ^ (((d : Real) - 1) / 2)
  let P : Real → Real := fun s =>
    brrsTwoRadiusNinePhaseProfile N (q * r) (q * s) (q * t)
  let D : Real → ENNReal := fun s => (ENNReal.ofReal s) ^ (d - 1)
  let R : Real → ENNReal := fun s =>
    ENNReal.ofReal Cfac *
      ((ENNReal.ofReal Qfac *
          brrsRadialSobolevSourceProfile p (f : BRRSSpace d → Complex) w s) *
        ENNReal.ofReal (P s))
  let Q : Real → ENNReal := (Ici S).indicator (fun s => R s / D s)
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hSpos : 0 < S := by
    have hqS : 0 < q * S := lt_of_lt_of_le (by norm_num) hS
    rcases (mul_pos_iff.mp hqS) with hpos | hneg
    · exact hpos.2
    · linarith [hq, hneg.1]
  have hCfac : 0 ≤ Cfac := by
    dsimp only [Cfac]
    positivity
  have hQfac : 0 ≤ Qfac := by
    dsimp only [Qfac]
    positivity
  have hsource : Measurable
      (brrsRadialSobolevSourceProfile p (f : BRRSSpace d → Complex) w) :=
    measurable_brrsRadialSobolevSourceProfile p
      (f : BRRSSpace d → Complex) f.continuous.measurable w
  have hP : Measurable P := by
    have hphase (partR partS : BRRSSurfaceWavePart) :
        Measurable (fun s : Real =>
          brrsSurfaceWavePhase partR (q * r) +
            brrsSurfaceWavePhase partS (q * s) + 2 * Real.pi * (q * t)) := by
      cases partR <;> cases partS <;>
        simp only [brrsSurfaceWavePhase, add_zero, measurable_const, zero_add] <;> fun_prop
    dsimp only [P]
    unfold brrsTwoRadiusNinePhaseProfile
    repeat' apply Measurable.add
    all_goals
      exact (measurable_brrsStationaryRapidProfile N).comp (hphase _ _)
  have hD : Measurable D := by
    dsimp only [D]
    exact ENNReal.continuous_ofReal.measurable.pow_const _
  have hR : Measurable R := by
    dsimp only [R]
    exact (measurable_const.ennreal_ofReal).mul
      ((measurable_const.ennreal_ofReal.mul hsource).mul hP.ennreal_ofReal)
  have hQ : Measurable Q := by
    dsimp only [Q]
    exact (hR.div hD).indicator measurableSet_Ici
  have hbase (s : Ioi (0 : Real)) (hs : S ≤ s.1) :
      ENNReal.ofReal
          ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum
            Phi d j r s.1 t‖ *
          ((ENNReal.ofReal s.1) ^ (d - 1) *
            ENNReal.ofReal ‖f (s.1 • w)‖) ≤ R s.1 := by
    have hhigh : 16 ≤ q * s.1 := by
      calc
        16 ≤ q * S := by simpa only [q] using hS
        _ ≤ q * s.1 := mul_le_mul_of_nonneg_left hs hq.le
    have hspos : 0 < s.1 := s.2
    have hreal := hkernel j r s.1 t p (f : BRRSSpace d → Complex) w
      hp hr0 hr (by simpa only [q] using hhigh)
    have hleft :
        ENNReal.ofReal
            ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum
              Phi d j r s.1 t‖ *
            ((ENNReal.ofReal s.1) ^ (d - 1) *
              ENNReal.ofReal ‖f (s.1 • w)‖) =
          ENNReal.ofReal
            (‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum
                Phi d j r s.1 t‖ *
              (s.1 ^ (d - 1) * ‖f (s.1 • w)‖)) := by
      rw [← ENNReal.ofReal_pow hspos.le,
        ← ENNReal.ofReal_mul (pow_nonneg hspos.le _),
        ← ENNReal.ofReal_mul (norm_nonneg _)]
    calc
      ENNReal.ofReal
          ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum
            Phi d j r s.1 t‖ *
          ((ENNReal.ofReal s.1) ^ (d - 1) *
            ENNReal.ofReal ‖f (s.1 • w)‖) =
          ENNReal.ofReal
            (‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum
                Phi d j r s.1 t‖ *
              (s.1 ^ (d - 1) * ‖f (s.1 • w)‖)) := hleft
      _ ≤ ENNReal.ofReal
          (Cfac * ((Qfac *
            (brrsRadialSobolevSourceProfile p
              (f : BRRSSpace d → Complex) w s.1).toReal) * P s.1)) := by
        apply ENNReal.ofReal_le_ofReal
        simpa only [q, Cfac, Qfac, P] using hreal
      _ = ENNReal.ofReal Cfac *
          ((ENNReal.ofReal Qfac * ENNReal.ofReal
            (brrsRadialSobolevSourceProfile p
              (f : BRRSSpace d → Complex) w s.1).toReal) *
            ENNReal.ofReal (P s.1)) := by
        rw [ENNReal.ofReal_mul hCfac,
          ENNReal.ofReal_mul (mul_nonneg hQfac ENNReal.toReal_nonneg),
          ENNReal.ofReal_mul hQfac]
      _ ≤ ENNReal.ofReal Cfac *
          ((ENNReal.ofReal Qfac *
            brrsRadialSobolevSourceProfile p
              (f : BRRSSpace d → Complex) w s.1) *
            ENNReal.ofReal (P s.1)) := by
        gcongr
        exact ENNReal.ofReal_toReal_le
      _ = R s.1 := by rfl
  have hpoint (s : Ioi (0 : Real)) :
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
          f (s.1 • w)‖ₑ ≤ Q s.1 := by
    rw [enorm_mul, ← ofReal_norm, ← ofReal_norm]
    by_cases hs : S ≤ s.1
    · dsimp only [Q]
      have hsI : s.1 ∈ Ici S := hs
      rw [Set.indicator_of_mem hsI]
      have hDzero : D s.1 ≠ 0 := by
        dsimp only [D]
        exact pow_ne_zero _ (ENNReal.ofReal_pos.mpr s.2).ne'
      have hDtop : D s.1 ≠ ∞ := by
        dsimp only [D]
        exact ENNReal.pow_ne_top ENNReal.ofReal_ne_top
      apply (ENNReal.le_div_iff_mul_le (Or.inl hDzero) (Or.inl hDtop)).2
      calc
        ENNReal.ofReal
            ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum
              Phi d j r s.1 t‖ *
            ENNReal.ofReal ‖f (s.1 • w)‖ * D s.1 =
            ENNReal.ofReal
              ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum
                Phi d j r s.1 t‖ *
              (D s.1 * ENNReal.ofReal ‖f (s.1 • w)‖) := by
              ac_rfl
        _ ≤ R s.1 := by
          simpa only [D] using hbase s hs
    · have hslt : s.1 < S := lt_of_not_ge hs
      dsimp only [Q]
      have hsI : s.1 ∉ Ici S := hs
      simp [hsI, hsupport s hslt]
  have hQintegral :
      (∫⁻ s : Ioi (0 : Real), Q s.1 ∂Measure.volumeIoiPow (d - 1)) =
        ∫⁻ s in Ici S, R s := by
    calc
      (∫⁻ s : Ioi (0 : Real), Q s.1 ∂Measure.volumeIoiPow (d - 1)) =
          ∫⁻ s in Ioi (0 : Real),
            ENNReal.ofReal s ^ (d - 1) * Q s :=
        Auto.Spherical.SurfaceMeasureDecay.lintegral_volumeIoiPow
          (d - 1) Q hQ
      _ = ∫⁻ s in Ioi (0 : Real), (Ici S).indicator R s := by
        apply setLIntegral_congr_fun measurableSet_Ioi
        intro s hs
        by_cases hSs : S ≤ s
        · dsimp only [Q]
          have hSsI : s ∈ Ici S := hSs
          rw [Set.indicator_of_mem hSsI, Set.indicator_of_mem hSsI]
          apply ENNReal.mul_div_cancel
          · exact pow_ne_zero _ (ENNReal.ofReal_pos.mpr hs).ne'
          · exact ENNReal.pow_ne_top ENNReal.ofReal_ne_top
        · dsimp only [Q]
          have hSsI : s ∉ Ici S := hSs
          simp [hSsI]
      _ = ∫⁻ s in Ici S, R s := by
        rw [lintegral_indicator measurableSet_Ici]
        change ∫⁻ s : Real, R s ∂
          (volume.restrict (Ioi (0 : Real))).restrict (Ici S) = _
        rw [Measure.restrict_restrict measurableSet_Ici]
        rw [inter_eq_left.mpr]
        intro s hs
        exact lt_of_lt_of_le hSpos hs
  have hmain :
      ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
        ∫⁻ s : Ioi (0 : Real), Q s.1 ∂Measure.volumeIoiPow (d - 1) := by
    calc
      ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ =
          ‖brrsDyadicHalfWave Phi j t f (r • v)‖ₑ := ofReal_norm _
      _ = ‖∫ s : Ioi (0 : Real),
          brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
