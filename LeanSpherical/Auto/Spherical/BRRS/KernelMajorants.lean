/-- The output half-density cancels exactly in the outer all-nine estimate.
This is the profile-retaining form intended for subsequent radial
integration; in particular it has not replaced the phase profile by a
constant. -/
theorem exists_norm_brrsDyadicHalfWave_outer_weighted_ninePhase_outerIntegral_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r t : Real,
      ∀ f : BRRSSchwartz d,
      ∀ _hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ v w : BRRSSpace d, ‖v‖ = 1 → ‖w‖ = 1 →
      20 ≤ ((2 : Real) ^ j) * r →
