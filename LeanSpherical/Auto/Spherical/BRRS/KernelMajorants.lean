          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1)) *
              ∫ s : Ioi (0 : Real),
                brrsTwoRadiusNinePhaseProfile N
                  (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s.1)
                    (((2 : Real) ^ j) * t) * ‖f (s.1 • w)‖
