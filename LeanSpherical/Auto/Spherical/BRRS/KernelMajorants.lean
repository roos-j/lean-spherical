      mul_le_mul_of_nonneg_left hpoint hDpos.le
    _ = (‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) * C)) * J := by
      field_simp [ne_of_gt hDpos]
    _ ≤ (‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) * C)) * (9 * I) :=
      mul_le_mul_of_nonneg_left hsource hfactor
    _ = ‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) * (9 * C)) * I := by
      ring

