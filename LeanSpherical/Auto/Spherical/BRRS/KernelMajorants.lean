/-- The compact-output/high-source radial normalization specialized to the
circle.  This is the exact polar density identity underlying the planar
source-tail estimates. -/
theorem brrs_planar_lowHigh_prefactor_polar_sobolevSource_eq
    {p q s : Real} (hp : p ≠ 0) (hq : 0 < q) (hs : 0 < s)
    (f : BRRSSpace 2 → Complex) (w : BRRSSpace 2) :
    (q ^ 2 / Real.sqrt (q * s / 16)) * (s * ‖f (s • w)‖) =
      (q ^ (((2 : Real) - 1) / 2 + 1) *
          (16 : Real) ^ (((2 : Real) - 1) / 2)) *
        (brrsRadialSobolevSourceProfile p f w s).toReal := by
  convert brrs_lowHigh_prefactor_polar_source_eq
    (d := 2) (p := p) (q := q) (s := s) (by norm_num) hp hq hs f w using 1 <;>
    norm_num

/-- Literal planar `I₀` compact-output/high-source all-nine bound in the
Sobolev source normalization.  This is a statement about the actual circle
stationary model appearing in the radial half-wave formula, not the
higher-dimensional surrogate. -/
theorem exists_brrsDyadicPlanarI0_lowHigh_sobolevSource_ninePhase_profile_le
    (N : Nat) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r s t p : Real,
      ∀ f : BRRSSpace 2 → Complex, ∀ w : BRRSSpace 2,
      2 ≤ p → 0 ≤ r → r ≤ dyadicTimeScale j →
      16 ≤ ((2 : Real) ^ j) * s →
      ‖brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum Phi j r s t‖ *
          (s * ‖f (s • w)‖) ≤
        ((1 - (1 / 32 : Real)) * C) *
          (((((2 : Real) ^ j) ^ (((2 : Real) - 1) / 2 + 1) *
            (16 : Real) ^ (((2 : Real) - 1) / 2)) *
              (brrsRadialSobolevSourceProfile p f w s).toReal) *
            brrsTwoRadiusNinePhaseProfile N
              (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
                (((2 : Real) ^ j) * t)) := by
  obtain ⟨C, hC, hkernel⟩ :=
    exists_norm_brrsDyPlanarTwoRadAllStatCompIntegSum_lowHigh_ninePhase_profile_le
      N Phi
  refine ⟨C, hC, ?_⟩
  intro j r s t p f w hp hr0 hr hhigh
  let q : Real := (2 : Real) ^ j
  let D : Real := Real.sqrt (q * s / 16)
  let P : Real := brrsTwoRadiusNinePhaseProfile N (q * r) (q * s) (q * t)
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hs : 0 < s := by
    have hqs : 0 < q * s := lt_of_lt_of_le (by norm_num) hhigh
    rcases (mul_pos_iff.mp hqs) with hpos | hneg
    · exact hpos.2
    · linarith [hq, hneg.1]
  have hqr0 : 0 ≤ q * r := mul_nonneg hq.le hr0
  have hqr : q * r ≤ 16 := by
    change r ≤ q⁻¹ at hr
    calc
      q * r ≤ q * q⁻¹ := mul_le_mul_of_nonneg_left hr hq.le
      _ = 1 := mul_inv_cancel₀ hq.ne'
      _ ≤ 16 := by norm_num
  have hD : 0 < D := by
    dsimp only [D]
    apply Real.sqrt_pos.2
    positivity
  have hkernel' :
      ‖brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum Phi j r s t‖ ≤
        q ^ 2 * ((1 - (1 / 32 : Real)) * (C / D) * P) := by
    simpa only [q, D, P, mul_assoc] using hkernel j r s t hqr0 hqr hhigh
  have hp' : p ≠ 0 := by linarith
  have hfactor := brrs_planar_lowHigh_prefactor_polar_sobolevSource_eq
    (p := p) (q := q) (s := s) hp' hq hs f w
  calc
    ‖brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum Phi j r s t‖ *
        (s * ‖f (s • w)‖) ≤
        (q ^ 2 * ((1 - (1 / 32 : Real)) * (C / D) * P)) *
          (s * ‖f (s • w)‖) :=
      mul_le_mul_of_nonneg_right hkernel'
        (mul_nonneg hs.le (norm_nonneg _))
    _ = ((1 - (1 / 32 : Real)) * C) *
          ((q ^ 2 / D) * (s * ‖f (s • w)‖)) * P := by
      field_simp [ne_of_gt hD]
    _ = ((1 - (1 / 32 : Real)) * C) *
          (((q ^ (((2 : Real) - 1) / 2 + 1) *
            (16 : Real) ^ (((2 : Real) - 1) / 2)) *
              (brrsRadialSobolevSourceProfile p f w s).toReal) * P) := by
      dsimp only [D]
      rw [hfactor]
      ring
    _ = ((1 - (1 / 32 : Real)) * C) *
          (((((2 : Real) ^ j) ^ (((2 : Real) - 1) / 2 + 1) *
            (16 : Real) ^ (((2 : Real) - 1) / 2)) *
              (brrsRadialSobolevSourceProfile p f w s).toReal) *
            brrsTwoRadiusNinePhaseProfile N
              (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
                (((2 : Real) ^ j) * t)) := by
      rfl

/-- The preceding literal planar all-nine bound passes to every high-source
tail of the radial integral.  It keeps the Sobolev `L^p` source profile and
the exact nine phase profiles, with no exponent-one source remainder. -/
theorem exists_brrsDyadicPlanarI0_lowHigh_sobolevSource_lintegral_le
    (N : Nat) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r t p S : Real,
