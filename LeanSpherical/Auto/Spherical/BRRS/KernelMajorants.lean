/-- The usual high--high polar normalization remains valid after retaining
one additional power of the *source* half-density.  This algebraic form is
used by the endpoint--middle terms: their surplus source decay is never
discarded before the radial block argument. -/
theorem brrsDyadicHighHigh_prefactor_polar_source_sourceExtraDecay_eq
    {d j : Nat} (hd : 1 ≤ d) {p r s : Real} (hp : p ≠ 0)
    (hr : 0 < r) (hs : 0 < s) (k : Nat)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) (P : Real) :
    r ^ (((d : Real) - 1) / p) *
