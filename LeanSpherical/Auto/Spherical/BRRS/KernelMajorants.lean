/-- A metric ball about a point is contained in the radial shell centred at
that point's radius, with the same width. -/
theorem metricBall_subset_brrsRadialShell
    {d : Nat} (x : BRRSSpace d) (width : Real) :
    Metric.ball x width ⊆ brrsRadialShell d ‖x‖ width := by
  intro y hy
  change |‖y‖ - ‖x‖| < width
  have hy' : dist y x < width := by
    simpa only [Metric.mem_ball] using hy
  calc
    |‖y‖ - ‖x‖| ≤ ‖y - x‖ := abs_norm_sub_norm_le _ _
    _ = dist y x := by rw [dist_eq_norm_sub]
    _ < width := hy'

/-- A point on a BRRS time shell supplies a concrete ball contained in that
shell.  This is the reusable geometric witness for shell volume lower bounds.
