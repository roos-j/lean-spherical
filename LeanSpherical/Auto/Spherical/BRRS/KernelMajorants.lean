    (by simpa only [q] using hhigh)
  have hP : 0 ≤ P s := by
    dsimp only [P]
    exact brrsTwoRadiusNinePhaseProfile_nonneg N _ _ _
  have hleft :
      ENNReal.ofReal ‖brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum
          Phi j r s t‖ *
          (ENNReal.ofReal s * ENNReal.ofReal ‖f (s • w)‖) =
        ENNReal.ofReal
          (‖brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum
              Phi j r s t‖ * (s * ‖f (s • w)‖)) := by
    rw [← ENNReal.ofReal_mul hspos.le,
      ← ENNReal.ofReal_mul (norm_nonneg _)]
  calc
    ENNReal.ofReal ‖brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum
        Phi j r s t‖ *
        (ENNReal.ofReal s * ENNReal.ofReal ‖f (s • w)‖) =
        ENNReal.ofReal
          (‖brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum
              Phi j r s t‖ * (s * ‖f (s • w)‖)) := hleft
    _ ≤ ENNReal.ofReal
          (Cfac * ((Qfac *
            (brrsRadialSobolevSourceProfile p f w s).toReal) * P s)) := by
      apply ENNReal.ofReal_le_ofReal
      simpa only [q, Cfac, Qfac, P] using hreal
    _ = ENNReal.ofReal Cfac *
        ((ENNReal.ofReal Qfac * ENNReal.ofReal
            (brrsRadialSobolevSourceProfile p f w s).toReal) *
          ENNReal.ofReal (P s)) := by
      rw [ENNReal.ofReal_mul hCfac,
        ENNReal.ofReal_mul (mul_nonneg hQfac ENNReal.toReal_nonneg),
        ENNReal.ofReal_mul hQfac]
    _ ≤ ENNReal.ofReal Cfac *
        ((ENNReal.ofReal Qfac * brrsRadialSobolevSourceProfile p f w s) *
          ENNReal.ofReal (P s)) := by
      gcongr
      exact ENNReal.ofReal_toReal_le
    _ = ENNReal.ofReal ((1 - (1 / 32 : Real)) * C) *
        ((ENNReal.ofReal
            (((2 : Real) ^ j) ^ (((2 : Real) - 1) / 2 + 1) *
              (16 : Real) ^ (((2 : Real) - 1) / 2)) *
            brrsRadialSobolevSourceProfile p f w s) *
          ENNReal.ofReal (brrsTwoRadiusNinePhaseProfile N
