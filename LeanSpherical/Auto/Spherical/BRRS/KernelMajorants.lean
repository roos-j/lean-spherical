  obtain ⟨C, hC, hpoint⟩ :=
    exists_brrsDyadicPlanarI0_lowHigh_sobolevSource_ninePhase_profile_le N Phi
  refine ⟨C, hC, ?_⟩
  intro j r t p S f w hp hr0 hr hS
