              ‖brrsDyadicHalfWave Phi 0 a
                (brrsPositiveRadialHalfWaveTestPacket Phi 0 0) y‖) ^ p := by
  obtain ⟨A, c, hA, hc, hconeLower⟩ :=
    exists_brrsDyadicHalfWaveKernel_ttStar_outgoing_cone_eventually_lower
      Phi n
  refine ⟨A, hA, ?_⟩
  intro a v ha hv
  have ha16 : 16 ≤ a := le_trans hA ha
  have ha0 : 0 < a := by linarith
  have hpow : 0 < a ^ (n + 1) := pow_pos ha0 _
  have hhalfWavePoint :
      0 < ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) 0 a :
        BRRSSpace (2 * n + 3) → Complex) (a • v)‖ := by
    exact lt_of_lt_of_le (div_pos hc hpow) (hconeLower a v ha hv)
  have hkernelPoint :
      0 < ‖(brrsDyadicHalfWaveTTStarKernel Phi 0 0 a :
        BRRSSpace (2 * n + 3) → Complex) (a • v)‖ := by
    rw [brrsDyadicHalfWaveTTStarKernel_eq_halfWaveKernelTTStarCutoff]
    simpa only [sub_zero] using hhalfWavePoint
  have hnorm : ‖a • v‖ = a := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg ha0.le, hv, mul_one]
  have hcone : ‖a • v‖ = |a - 0| := by
    simpa only [sub_zero, abs_of_nonneg ha0.le] using hnorm
  obtain ⟨width, hwidth, hmass⟩ :=
    exists_brrsDyadicHalfWaveTTStarKernel_timeShell_lintegral_rpow_pos_of_pointwise_pos
      Phi 0 0 a p (a • v) hcone hkernelPoint hp
  refine ⟨width, hwidth, ?_⟩
  simpa only [brrsDyadicHalfWave_positiveRadialTestPacket_eq_ttStarKernel] using hmass

/-- The odd-dimensional cone-shell lower bound transports to every dyadic
frequency scale with a shell no wider than the natural physical scale
`2⁻ʲ`.  The cone parameter `a` is the scaled time `2ʲ t`; in the BRRS range
`t ∈ [1,2]` it is therefore large exactly when the dyadic level is large. -/
theorem exists_brrsPosRadialTestPacket_ttStar_outgoing_dy_cone_timeShell_lintegral_rpow_pos
    (Phi : BRRSAnnularCutoff) (n : Nat) {p : Real} (hp : 0 < p) :
    ∃ A : Real, 16 ≤ A ∧ ∀ (j : Nat) (a : Real)
      (v : BRRSSpace (2 * n + 3)), A ≤ a → ‖v‖ = 1 →
        ∃ width : Real, 0 < width ∧ width ≤ ((2 : Real) ^ j)⁻¹ ∧
          0 < ∫⁻ y in brrsTimeRadialShell (2 * n + 3) 0
            (a / ((2 : Real) ^ j)) width,
            (ENNReal.ofReal
              ‖brrsDyadicHalfWave Phi j (a / ((2 : Real) ^ j))
                (brrsPositiveRadialHalfWaveTestPacket Phi j 0) y‖) ^ p := by
  obtain ⟨A, c, hA, hc, hconeLower⟩ :=
    exists_brrsDyadicHalfWaveKernel_ttStar_outgoing_cone_eventually_lower
      Phi n
  refine ⟨A, hA, ?_⟩
  intro j a v ha hv
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have ha0 : 0 < a := by linarith [hA]
  have hpow : 0 < a ^ (n + 1) := pow_pos ha0 _
  have hlevelZeroPoint :
      0 < ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) 0 a :
        BRRSSpace (2 * n + 3) → Complex) (a • v)‖ := by
    exact lt_of_lt_of_le (div_pos hc hpow) (hconeLower a v ha hv)
  have htime : q * (a / q) = a := by
    field_simp [ne_of_gt hq]
  have hscaledKernel :
      (brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) j (a / q) :
        BRRSSpace (2 * n + 3) → Complex) ((a / q) • v) =
        q ^ (2 * n + 3) •
          (brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) 0 a :
            BRRSSpace (2 * n + 3) → Complex) (a • v) := by
    calc
      (brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) j (a / q) :
          BRRSSpace (2 * n + 3) → Complex) ((a / q) • v) =
          q ^ (2 * n + 3) •
            (brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) 0
              (q * (a / q)) : BRRSSpace (2 * n + 3) → Complex)
              (q • ((a / q) • v)) := by
        simpa only [q] using
          brrsDyadicHalfWaveKernel_eq_levelZero_scaled_general
            (brrsTTStarAnnularCutoff Phi) j (a / q) ((a / q) • v)
      _ = q ^ (2 * n + 3) •
          (brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) 0 a :
            BRRSSpace (2 * n + 3) → Complex) (a • v) := by
        rw [smul_smul, htime]
  have hqpow : 0 < q ^ (2 * n + 3) := pow_pos hq _
  have hhalfWavePoint :
      0 < ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) j
        (a / q) : BRRSSpace (2 * n + 3) → Complex) ((a / q) • v)‖ := by
    rw [hscaledKernel, norm_smul, Real.norm_eq_abs, abs_of_pos hqpow]
    exact mul_pos hqpow hlevelZeroPoint
  have hkernelPoint :
      0 < ‖(brrsDyadicHalfWaveTTStarKernel Phi j 0 (a / q) :
        BRRSSpace (2 * n + 3) → Complex) ((a / q) • v)‖ := by
    rw [brrsDyadicHalfWaveTTStarKernel_eq_halfWaveKernelTTStarCutoff]
    simpa only [sub_zero] using hhalfWavePoint
  have haq : 0 < a / q := div_pos ha0 hq
  have hnorm : ‖(a / q) • v‖ = a / q := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg haq.le, hv, mul_one]
  have hcone : ‖(a / q) • v‖ = |a / q - 0| := by
    simpa only [sub_zero, abs_of_nonneg haq.le] using hnorm
  have hqinv : 0 < q⁻¹ := inv_pos.mpr hq
  obtain ⟨width, hwidth, hwidthcap, hmass⟩ :=
    exists_brrsDyHfWvTTStarKer_timeShell_lintegral_rpow_pos_of_pointwise_pos_of_width_le
      Phi j 0 (a / q) p q⁻¹ ((a / q) • v) hcone hkernelPoint hp hqinv
  refine ⟨width, hwidth, ?_, ?_⟩
  · simpa only [q] using hwidthcap
  · simpa only [q, brrsDyadicHalfWave_positiveRadialTestPacket_eq_ttStarKernel]
      using hmass

/-! ### Positivity of a slowly varying Fourier carrier -/

/-- A nonnegative integrable profile retains at least half of its mass in
the real part of a Fourier-character integral whenever the carrier phase is
at most `π / 3` on the support of the profile.  The phase condition is only
required where `a` is nonzero. -/
theorem brrs_fourierChar_integral_re_lower_of_nonneg_of_small_phase
    {α : Type*} [MeasurableSpace α] (μ : Measure α)
    (a phase : α → Real) (ha : Integrable a μ)
    (ha_nonneg : ∀ x, 0 ≤ a x) (hphase_meas : Measurable phase)
    (hsmall : ∀ x, a x ≠ 0 → |2 * Real.pi * phase x| ≤ Real.pi / 3) :
    (1 / 2 : Real) * (∫ x, a x ∂μ) ≤
      (∫ x, (Real.fourierChar (phase x) : Complex) * (a x : Complex) ∂μ).re := by
  have hchar_meas : Measurable (fun x : α =>
      (Real.fourierChar (phase x) : Complex)) := by
    change Measurable (fun x : α =>
      Complex.exp (((2 * Real.pi * phase x : Real) : Complex) * Complex.I))
    exact Complex.continuous_exp.measurable.comp
      ((Complex.measurable_ofReal.comp
        (measurable_const.mul hphase_meas)).mul measurable_const)
  have ha_complex : Integrable (fun x : α => (a x : Complex)) μ := ha.ofReal
  have hcomplex : Integrable (fun x : α =>
      (Real.fourierChar (phase x) : Complex) * (a x : Complex)) μ := by
    exact ha_complex.bdd_mul (c := 1) hchar_meas.aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => by simp [Circle.norm_coe])
  have hcos (u : Real) (hu : |u| ≤ Real.pi / 3) :
      (1 / 2 : Real) ≤ Real.cos u := by
    calc
      (1 / 2 : Real) = Real.cos (Real.pi / 3) := Real.cos_pi_div_three.symm
      _ ≤ Real.cos |u| := Real.cos_le_cos_of_nonneg_of_le_pi
        (abs_nonneg u) (by linarith [Real.pi_pos]) hu
      _ = Real.cos u := Real.cos_abs u
  have hre (x : α) :
      ((Real.fourierChar (phase x) : Complex) * (a x : Complex)).re =
        Real.cos (2 * Real.pi * phase x) * a x := by
    rw [Real.fourierChar_apply]
    rw [Complex.mul_re, Complex.exp_ofReal_mul_I_re,
      Complex.exp_ofReal_mul_I_im]
    simp only [Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero]
  have hpoint (x : α) :
      (1 / 2 : Real) * a x ≤
        ((Real.fourierChar (phase x) : Complex) * (a x : Complex)).re := by
    rw [hre]
    by_cases hzero : a x = 0
    · simp [hzero]
    · exact mul_le_mul_of_nonneg_right
        (hcos _ (hsmall x hzero)) (ha_nonneg x)
  calc
    (1 / 2 : Real) * (∫ x, a x ∂μ) =
        ∫ x, (1 / 2 : Real) * a x ∂μ :=
      (integral_const_mul (1 / 2 : Real) a).symm
    _ ≤ ∫ x, ((Real.fourierChar (phase x) : Complex) *
        (a x : Complex)).re ∂μ :=
      integral_mono (ha.const_mul (1 / 2 : Real)) hcomplex.re hpoint
    _ = (∫ x, (Real.fourierChar (phase x) : Complex) *
        (a x : Complex) ∂μ).re :=
      integral_re hcomplex

/-- The small-phase carrier lower bound with the phase hypothesis only where
the measure sees it.  This restriction-measure form is convenient for compact
frequency intervals: no artificial condition is imposed outside the annulus. -/
theorem brrs_fourierChar_integral_re_lower_of_nonneg_of_small_phase_ae
    {α : Type*} [MeasurableSpace α] (μ : Measure α)
    (a phase : α → Real) (ha : Integrable a μ)
    (ha_nonneg : ∀ᵐ x ∂μ, 0 ≤ a x) (hphase_meas : Measurable phase)
    (hsmall : ∀ᵐ x ∂μ, a x ≠ 0 → |2 * Real.pi * phase x| ≤ Real.pi / 3) :
    (1 / 2 : Real) * (∫ x, a x ∂μ) ≤
      (∫ x, (Real.fourierChar (phase x) : Complex) * (a x : Complex) ∂μ).re := by
  have hchar_meas : Measurable (fun x : α =>
      (Real.fourierChar (phase x) : Complex)) := by
    change Measurable (fun x : α =>
      Complex.exp (((2 * Real.pi * phase x : Real) : Complex) * Complex.I))
    exact Complex.continuous_exp.measurable.comp
      ((Complex.measurable_ofReal.comp
        (measurable_const.mul hphase_meas)).mul measurable_const)
  have ha_complex : Integrable (fun x : α => (a x : Complex)) μ := ha.ofReal
  have hcomplex : Integrable (fun x : α =>
      (Real.fourierChar (phase x) : Complex) * (a x : Complex)) μ := by
    exact ha_complex.bdd_mul (c := 1) hchar_meas.aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => by simp [Circle.norm_coe])
  have hcos (u : Real) (hu : |u| ≤ Real.pi / 3) :
      (1 / 2 : Real) ≤ Real.cos u := by
    calc
      (1 / 2 : Real) = Real.cos (Real.pi / 3) := Real.cos_pi_div_three.symm
      _ ≤ Real.cos |u| := Real.cos_le_cos_of_nonneg_of_le_pi
        (abs_nonneg u) (by linarith [Real.pi_pos]) hu
      _ = Real.cos u := Real.cos_abs u
  have hre (x : α) :
      ((Real.fourierChar (phase x) : Complex) * (a x : Complex)).re =
        Real.cos (2 * Real.pi * phase x) * a x := by
    rw [Real.fourierChar_apply]
    rw [Complex.mul_re, Complex.exp_ofReal_mul_I_re,
      Complex.exp_ofReal_mul_I_im]
    simp only [Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero]
  have hpoint : ∀ᵐ x ∂μ,
      (1 / 2 : Real) * a x ≤
        ((Real.fourierChar (phase x) : Complex) * (a x : Complex)).re := by
    filter_upwards [ha_nonneg, hsmall] with x hnonneg hsmallx
    rw [hre]
    by_cases hzero : a x = 0
    · simp [hzero]
    · exact mul_le_mul_of_nonneg_right
        (hcos _ (hsmallx hzero)) hnonneg
  calc
    (1 / 2 : Real) * (∫ x, a x ∂μ) =
        ∫ x, (1 / 2 : Real) * a x ∂μ :=
      (integral_const_mul (1 / 2 : Real) a).symm
    _ ≤ ∫ x, ((Real.fourierChar (phase x) : Complex) *
        (a x : Complex)).re ∂μ :=
      integral_mono_ae (ha.const_mul (1 / 2 : Real)) hcomplex.re hpoint
    _ = (∫ x, (Real.fourierChar (phase x) : Complex) *
        (a x : Complex) ∂μ).re :=
      integral_re hcomplex

/-- A compact interval form of the small-phase carrier lower bound.  It is
stated for the literal interval integral used by the stationary wave
components, and is therefore ready to control the leading carrier on a cone
tube. -/
theorem brrs_intervalIntegral_fourierChar_norm_lower_of_nonneg_of_small_phase
    {a b : Real} (hab : a ≤ b) (w phase : Real → Real)
    (hw : IntervalIntegrable w volume a b)
    (hwnonneg : ∀ rho ∈ Ioc a b, 0 ≤ w rho)
    (_hwpos : 0 < ∫ rho in a..b, w rho)
    (hphase_meas : Measurable phase)
    (hsmall : ∀ rho ∈ Ioc a b, w rho ≠ 0 →
      |2 * Real.pi * phase rho| ≤ Real.pi / 3) :
    (1 / 2 : Real) * (∫ rho in a..b, w rho) ≤
      ‖∫ rho in a..b,
        (Real.fourierChar (phase rho) : Complex) * (w rho : Complex)‖ := by
  let μ : Measure Real := volume.restrict (Ioc a b)
  have hw_int : Integrable w μ := by
    dsimp only [μ]
    exact (intervalIntegrable_iff_integrableOn_Ioc_of_le hab).mp hw
  have hnonneg : ∀ᵐ rho ∂μ, 0 ≤ w rho := by
    dsimp only [μ]
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with rho hrho
    exact hwnonneg rho hrho
  have hsmall_ae : ∀ᵐ rho ∂μ,
      w rho ≠ 0 → |2 * Real.pi * phase rho| ≤ Real.pi / 3 := by
    dsimp only [μ]
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with rho hrho
    exact hsmall rho hrho
  have hcarrier := brrs_fourierChar_integral_re_lower_of_nonneg_of_small_phase_ae
    μ w phase hw_int hnonneg hphase_meas hsmall_ae
  have hnorm :
      (1 / 2 : Real) * (∫ rho, w rho ∂μ) ≤
        ‖∫ rho, (Real.fourierChar (phase rho) : Complex) *
          (w rho : Complex) ∂μ‖ := by
    calc
      (1 / 2 : Real) * (∫ rho, w rho ∂μ) ≤
          (∫ rho, (Real.fourierChar (phase rho) : Complex) *
            (w rho : Complex) ∂μ).re := hcarrier
      _ ≤ ‖∫ rho, (Real.fourierChar (phase rho) : Complex) *
          (w rho : Complex) ∂μ‖ := Complex.re_le_norm _
  simpa only [μ, intervalIntegral.integral_of_le hab] using hnorm

/-- The positive `TT*` annular moment remains quantitatively nonzero under a
small radial carrier shift.  This is the leading-term protection needed for a
uniform cone tube: on `|u| ≤ 1 / 6`, every frequency in the literal annulus
has phase at most `π / 3`. -/
theorem brrsOddTTStarRadialCarrier_norm_lower_of_abs_le_one_sixth
    (Phi : BRRSAnnularCutoff) (n : Nat) (u : Real) (hu : |u| ≤ 1 / 6) :
    (1 / 2 : Real) * brrsOddTTStarRadialMoment Phi n ≤
      ‖∫ rho in (1 / 32 : Real)..1,
        (Real.fourierChar (u * rho) : Complex) *
          ((rho ^ (n + 1) * ‖Phi.symbol (2 * Real.pi * rho)‖ ^ 2 : Real) :
            Complex)‖ := by
  let w : Real → Real := fun rho : Real =>
    rho ^ (n + 1) * ‖Phi.symbol (2 * Real.pi * rho)‖ ^ 2
  have hwcont : Continuous w := by
    dsimp only [w]
    exact (continuous_id.pow (n + 1)).mul
      ((Phi.symbol.continuous.comp (by fun_prop)).norm.pow 2)
  have hw : IntervalIntegrable w volume (1 / 32 : Real) 1 :=
    hwcont.intervalIntegrable _ _
  have hwnonneg : ∀ rho ∈ Ioc (1 / 32 : Real) 1, 0 ≤ w rho := by
    intro rho hrho
    dsimp only [w]
    exact mul_nonneg (pow_nonneg (by linarith [hrho.1]) _) (sq_nonneg _)
  have hwpos : 0 < ∫ rho in (1 / 32 : Real)..1, w rho := by
    simpa only [w, brrsOddTTStarRadialMoment] using
      brrsOddTTStarRadialMoment_pos Phi n
  have hphase_meas : Measurable (fun rho : Real => u * rho) :=
    measurable_const.mul measurable_id
  have hsmall : ∀ rho ∈ Ioc (1 / 32 : Real) 1, w rho ≠ 0 →
      |2 * Real.pi * (u * rho)| ≤ Real.pi / 3 := by
    intro rho hrho _
    have hrho0 : 0 ≤ rho := by linarith [hrho.1]
    have hrhoabs : |rho| ≤ 1 := by
      rw [abs_of_nonneg hrho0]
      exact hrho.2
    have htwopi : 0 ≤ 2 * Real.pi := by positivity
    calc
      |2 * Real.pi * (u * rho)| = (2 * Real.pi) * (|u| * |rho|) := by
        rw [abs_mul, abs_mul, abs_mul,
          abs_of_nonneg (by norm_num : (0 : Real) ≤ 2),
          abs_of_nonneg Real.pi_pos.le]
      _ ≤ (2 * Real.pi) * ((1 / 6 : Real) * 1) := by
        apply mul_le_mul_of_nonneg_left
          (mul_le_mul hu hrhoabs (abs_nonneg _) (by norm_num)) htwopi
      _ = Real.pi / 3 := by ring
  have hcarrier :=
    brrs_intervalIntegral_fourierChar_norm_lower_of_nonneg_of_small_phase
      (a := (1 / 32 : Real)) (b := 1) (by norm_num) w
      (fun rho : Real => u * rho) hw hwnonneg hwpos hphase_meas hsmall
  simpa only [w, brrsOddTTStarRadialMoment] using hcarrier

open Auto.Spherical.OscillatoryIntegralAux Auto.Spherical.AHRS

/-- The normalized odd-dimensional outgoing `TT*` component has the same
leading carrier throughout a bounded cone tube.  The displacement `t - r`
is retained literally in the Fourier character, while the stationary
remainder is uniform in the physical radius `r`. -/
theorem exists_norm_brrsStatWvCompInteg_ttStar_outgoing_coneTube_normd_leading_asymptotic
    (Phi : BRRSAnnularCutoff) (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ r t : Real, 16 ≤ r →
      ‖(((4 * Real.pi * r : Real) : Complex) * Complex.I) ^ (n + 1) *
          brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Phi)
            (2 * n + 3) .outgoing r t -
          brrsOddOutgoingLeadingCarrier n *
            (∫ rho in (1 / 32 : Real)..1,
              (Real.fourierChar ((t - r) * rho) : Complex) *
                ((rho ^ (n + 1) * ‖Phi.symbol (2 * Real.pi * rho)‖ ^ 2 : Real) :
                  Complex))‖ ≤ C / Real.sqrt (r / 16) := by
  obtain ⟨D, hD, hamp⟩ :=
    exists_brrsSurfaceWaveAmplitude_outgoing_odd_normalized_carrier_asymptotic' n
  let Psi : BRRSAnnularCutoff := brrsTTStarAnnularCutoff Phi
  let W : Real → Complex := fun rho : Real => Psi.symbol (2 * Real.pi * rho)
  have hWcont : Continuous W := by
    dsimp [W]
    exact Psi.symbol.continuous.comp (by fun_prop)
  obtain ⟨B, hB⟩ :=
    (isCompact_Icc : IsCompact (Icc (1 / 32 : Real) 1)).exists_bound_of_continuousOn
      hWcont.continuousOn
  let C : Real := (1 - (1 / 32 : Real)) * (max B 0 * D) + 1
  have hC : 0 < C := by
    dsimp [C]
    positivity
  refine ⟨C, hC, ?_⟩
  intro r t hr
  let A : Complex := ((4 * Real.pi * r : Real) : Complex) * Complex.I
  let L : Complex := brrsOddOutgoingLeadingCarrier n
  let omega : Real → Complex := fun rho : Real =>
    oscillatoryExp (2 * Real.pi * (t - r)) rho
  let P : Real → Complex := fun rho : Real =>
    ((rho ^ (2 * n + 2) : Real) : Complex) *
      brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing r rho * W rho
  let Q : Real → Complex := fun rho : Real =>
    ((rho ^ (n + 1) : Real) : Complex) * W rho
  let J : Complex := ∫ rho in (1 / 32 : Real)..1, Q rho * omega rho
  have hPcont : Continuous P := by
    dsimp [P]
    exact ((Complex.ofRealCLM.continuous.comp (continuous_id.pow (2 * n + 2))).mul
      (contDiff_brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing r).continuous).mul hWcont
  have hQcont : Continuous Q := by
    dsimp [Q]
    exact (Complex.ofRealCLM.continuous.comp (continuous_id.pow (n + 1))).mul hWcont
  have homegaCont : Continuous omega := by
    dsimp [omega, oscillatoryExp]
    exact Complex.continuous_exp.comp
      ((Complex.ofRealCLM.continuous.comp
        (continuous_const.mul continuous_id)).mul continuous_const)
  have hAPint : IntervalIntegrable (fun rho : Real =>
      A ^ (n + 1) * (P rho * omega rho)) volume (1 / 32 : Real) 1 :=
    (continuous_const.mul (hPcont.mul homegaCont)).intervalIntegrable _ _
  have hLQint : IntervalIntegrable (fun rho : Real =>
      L * (Q rho * omega rho)) volume (1 / 32 : Real) 1 :=
    (continuous_const.mul (hQcont.mul homegaCont)).intervalIntegrable _ _
  have hphase :
      brrsSurfaceWavePhase .outgoing r + 2 * Real.pi * t =
        2 * Real.pi * (t - r) := by
    simp only [brrsSurfaceWavePhase]
    ring
  have hindex : (2 * n + 3) - 1 = 2 * n + 2 := by omega
  have hcomponent :
      brrsStationaryWaveComponentIntegral Psi (2 * n + 3) .outgoing r t =
        ∫ rho in (1 / 32 : Real)..1, P rho * omega rho := by
    unfold brrsStationaryWaveComponentIntegral
    rw [intervalIntegral_brrsStationaryWaveComponent_eq_oscillatoryExp]
    apply intervalIntegral.integral_congr
    intro rho _
    dsimp [P, omega, W]
    rw [hphase]
    unfold brrsStationaryWaveRadialCoefficient
    rw [hindex]
  have hJcarrier : J =
      ∫ rho in (1 / 32 : Real)..1,
        (Real.fourierChar ((t - r) * rho) : Complex) *
          ((rho ^ (n + 1) * ‖Phi.symbol (2 * Real.pi * rho)‖ ^ 2 : Real) :
            Complex) := by
    unfold J
    apply intervalIntegral.integral_congr
    intro rho _
    have homega :
        oscillatoryExp (2 * Real.pi * (t - r)) rho =
          (Real.fourierChar ((t - r) * rho) : Complex) := by
      rw [Real.fourierChar_apply]
      unfold oscillatoryExp
      congr 1
      push_cast
      ring
    dsimp [Q, omega, W, Psi]
    rw [brrsTTStarAnnularCutoff_symbol_apply, RCLike.mul_conj]
    rw [homega]
    push_cast
    ac_rfl
  have hrewrite :
      A ^ (n + 1) *
          brrsStationaryWaveComponentIntegral Psi (2 * n + 3) .outgoing r t -
          L * J =
        ∫ rho in (1 / 32 : Real)..1,
          Q rho * omega rho *
            (A ^ (n + 1) * ((rho : Real) : Complex) ^ (n + 1) *
              brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing r rho - L) := by
    rw [hcomponent]
    change A ^ (n + 1) * (∫ rho in (1 / 32 : Real)..1, P rho * omega rho) -
        L * (∫ rho in (1 / 32 : Real)..1, Q rho * omega rho) = _
    rw [← intervalIntegral.integral_const_mul,
      ← intervalIntegral.integral_const_mul]
    rw [← intervalIntegral.integral_sub
      (μ := volume) (a := (1 / 32 : Real)) (b := 1)
      (f := fun rho : Real => A ^ (n + 1) * (P rho * omega rho))
      (g := fun rho : Real => L * (Q rho * omega rho)) hAPint hLQint]
    apply intervalIntegral.integral_congr
    intro rho _
    have hpower : (2 * n + 2 : Nat) = (n + 1) + (n + 1) := by omega
    dsimp [P, Q, omega]
    push_cast; rw [hpower, pow_add]; ring
  rw [show (((4 * Real.pi * r : Real) : Complex) * Complex.I) = A by rfl,
    show brrsOddOutgoingLeadingCarrier n = L by rfl,
    ← hJcarrier, hrewrite]
  refine (intervalIntegral.norm_integral_le_of_norm_le_const
    (C := (max B 0) * (D / Real.sqrt (r / 16))) ?_).trans ?_
  · intro rho hrho
    have hrho' : rho ∈ Icc (1 / 32 : Real) 1 := by
      rw [uIoc_of_le (by norm_num : (1 / 32 : Real) ≤ 1)] at hrho
      exact ⟨hrho.1.le, hrho.2⟩
    have hr0 : 0 ≤ r := by linarith
    have hrho0 : 0 ≤ rho := le_trans (by norm_num) hrho'.1
    have hfactor : (1 / 16 : Real) ≤ (2 * Real.pi) * rho := by
      calc
        (1 / 16 : Real) ≤ (2 * Real.pi) * (1 / 32 : Real) := by
          nlinarith [Real.pi_gt_three]
        _ ≤ (2 * Real.pi) * rho := by
          exact mul_le_mul_of_nonneg_left hrho'.1 (by positivity)
    have hlambda : r / 16 ≤ (2 * Real.pi * r) * rho := by
      calc
        r / 16 = r * (1 / 16 : Real) := by ring
        _ ≤ r * ((2 * Real.pi) * rho) := by gcongr
        _ = (2 * Real.pi * r) * rho := by ring
    have hlarge : 1 ≤ (2 * Real.pi * r) * rho := by
      calc
        (1 : Real) ≤ r / 16 := by linarith
        _ ≤ (2 * Real.pi * r) * rho := hlambda
    have hqpos : 0 < Real.sqrt (r / 16) := by
      apply Real.sqrt_pos.2
      linarith
    have hsqrt : Real.sqrt (r / 16) ≤ Real.sqrt ((2 * Real.pi * r) * rho) :=
      Real.sqrt_le_sqrt hlambda
    have herr :
        ‖A ^ (n + 1) * ((rho : Real) : Complex) ^ (n + 1) *
            brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing r rho - L‖ ≤
          D / Real.sqrt (r / 16) := by
      change ‖(((4 * Real.pi * r : Real) : Complex) * Complex.I) ^ (n + 1) *
          ((rho : Real) : Complex) ^ (n + 1) *
            brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing r rho -
          brrsOddOutgoingLeadingCarrier n‖ ≤ _
      exact (hamp r rho hlarge).trans
        (div_le_div_of_nonneg_left hD.le hqpos hsqrt)
    have hrhopow : ‖((rho ^ (n + 1) : Real) : Complex)‖ ≤ 1 := by
      rw [Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (pow_nonneg hrho0 _)]
      exact pow_le_one₀ hrho0 hrho'.2
    have hW : ‖W rho‖ ≤ max B 0 :=
      (hB rho hrho').trans (le_max_left _ _)
    have hE : 0 ≤ D / Real.sqrt (r / 16) := by positivity
    calc
      ‖Q rho * omega rho *
          (A ^ (n + 1) * ((rho : Real) : Complex) ^ (n + 1) *
            brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing r rho - L)‖ =
          ‖((rho ^ (n + 1) : Real) : Complex)‖ * ‖W rho‖ * ‖omega rho‖ *
            ‖A ^ (n + 1) * ((rho : Real) : Complex) ^ (n + 1) *
              brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing r rho - L‖ := by
        dsimp [Q]
        rw [norm_mul, norm_mul, norm_mul]
      _ ≤ ‖((rho ^ (n + 1) : Real) : Complex)‖ * ‖W rho‖ * ‖omega rho‖ *
            (D / Real.sqrt (r / 16)) := by
        gcongr
      _ = ‖((rho ^ (n + 1) : Real) : Complex)‖ * ‖W rho‖ *
            (D / Real.sqrt (r / 16)) := by
        rw [show ‖omega rho‖ = 1 by
          dsimp [omega]
          exact norm_oscillatoryExp _ _]
        ring
      _ ≤ (max B 0) * (D / Real.sqrt (r / 16)) := by
        calc
          _ ≤ (1 : Real) * (max B 0) * (D / Real.sqrt (r / 16)) := by
            gcongr
          _ = (max B 0) * (D / Real.sqrt (r / 16)) := by ring
  · have hqpos : 0 < Real.sqrt (r / 16) := by
      apply Real.sqrt_pos.2
      linarith
    have hlength : |1 - (1 / 32 : Real)| = 1 - (1 / 32 : Real) := by
      rw [abs_of_nonneg]
      norm_num
    rw [hlength]
    calc
      (max B 0) * (D / Real.sqrt (r / 16)) * (1 - (1 / 32 : Real)) =
          ((1 - (1 / 32 : Real)) * (max B 0 * D)) /
            Real.sqrt (r / 16) := by
        rw [div_eq_mul_inv, div_eq_mul_inv]
        ring
      _ ≤ C / Real.sqrt (r / 16) := by
        apply (div_le_div_iff_of_pos_right hqpos).mpr
        dsimp [C]
        linarith

/-- The outgoing stationary component has a uniform normalized lower bound
on the fixed level-zero cone tube `|t - r| ≤ 1 / 6`.  Unlike a bare
continuity argument, the width here is independent of the large cone radius.
The result concerns the outgoing component alone; the full kernel additionally
requires uniform control of the other stationary components on the tube. -/
theorem exists_brrsStatWaveCompInteg_ttStar_outgoing_coneTube_normd_eventually_lower
    (Phi : BRRSAnnularCutoff) (n : Nat) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧ ∀ r t : Real, A ≤ r →
      |t - r| ≤ 1 / 6 →
        c ≤ ‖(((4 * Real.pi * r : Real) : Complex) * Complex.I) ^ (n + 1) *
          brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Phi)
            (2 * n + 3) .outgoing r t‖ := by
  obtain ⟨C, hC, herror⟩ :=
    exists_norm_brrsStatWvCompInteg_ttStar_outgoing_coneTube_normd_leading_asymptotic
      Phi n
  let L : Complex := brrsOddOutgoingLeadingCarrier n
  let M : Real := brrsOddTTStarRadialMoment Phi n
  let K : Real := ‖L‖ * ((1 / 2 : Real) * M)
  have hLne : L ≠ 0 := by
    dsimp [L]
    exact brrsOddOutgoingLeadingCarrier_ne_zero n
  have hM : 0 < M := by
    dsimp [M]
    exact brrsOddTTStarRadialMoment_pos Phi n
  have hK : 0 < K := by
    dsimp [K]
    exact mul_pos (norm_pos_iff.mpr hLne) (mul_pos (by norm_num) hM)
  let A : Real := max 16 (16 * (2 * C / K) ^ 2)
  refine ⟨A, K / 2, le_max_left _ _, div_pos hK (by norm_num), ?_⟩
  intro r t hr htube
  let J : Complex := ∫ rho in (1 / 32 : Real)..1,
    (Real.fourierChar ((t - r) * rho) : Complex) *
      ((rho ^ (n + 1) * ‖Phi.symbol (2 * Real.pi * rho)‖ ^ 2 : Real) : Complex)
  let X : Complex :=
    (((4 * Real.pi * r : Real) : Complex) * Complex.I) ^ (n + 1) *
      brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Phi)
        (2 * n + 3) .outgoing r t
  change K / 2 ≤ ‖X‖
  have hr16 : 16 ≤ r := le_trans (le_max_left _ _) hr
  have hrover : 0 < r / 16 := by linarith
  have hqpos : 0 < Real.sqrt (r / 16) := Real.sqrt_pos.2 hrover
  have hsq : (2 * C / K) ^ 2 ≤ r / 16 := by
    have hraw : 16 * (2 * C / K) ^ 2 ≤ r :=
      le_trans (le_max_right _ _) hr
    nlinarith
  have hratio0 : 0 ≤ 2 * C / K := by positivity
  have hroot_sq : (Real.sqrt (r / 16)) ^ 2 = r / 16 :=
    Real.sq_sqrt hrover.le
  have hratio : 2 * C / K ≤ Real.sqrt (r / 16) := by
    nlinarith [Real.sqrt_nonneg (r / 16)]
  have htwoC : 2 * C ≤ Real.sqrt (r / 16) * K :=
    (div_le_iff₀ hK).mp hratio
  have hhalf : C / Real.sqrt (r / 16) ≤ K / 2 := by
    apply (div_le_iff₀ hqpos).mpr
    nlinarith
  have hcarrier : (1 / 2 : Real) * M ≤ ‖J‖ := by
    dsimp [J, M]
    exact brrsOddTTStarRadialCarrier_norm_lower_of_abs_le_one_sixth Phi n
      (t - r) htube
  have hmain : K ≤ ‖L * J‖ := by
    dsimp [K]
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left hcarrier (norm_nonneg L)
  have herr : ‖X - L * J‖ ≤ C / Real.sqrt (r / 16) := by
    change ‖(((4 * Real.pi * r : Real) : Complex) * Complex.I) ^ (n + 1) *
        brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Phi)
          (2 * n + 3) .outgoing r t -
        brrsOddOutgoingLeadingCarrier n *
          (∫ rho in (1 / 32 : Real)..1,
            (Real.fourierChar ((t - r) * rho) : Complex) *
              ((rho ^ (n + 1) * ‖Phi.symbol (2 * Real.pi * rho)‖ ^ 2 : Real) :
                Complex))‖ ≤ _
    exact herror r t hr16
  have hdiff : ‖X - L * J‖ ≤ K / 2 := herr.trans hhalf
  have htri : K ≤ ‖X‖ + ‖X - L * J‖ := by
    calc
      K ≤ ‖L * J‖ := hmain
      _ = ‖X - (X - L * J)‖ := by
        congr 1
        ring
      _ ≤ ‖X‖ + ‖X - L * J‖ := norm_sub_le _ _
  nlinarith

/-- The fixed-width outgoing cone-tube lower bound at the literal stationary
scale. -/
theorem exists_brrsStationaryWaveComponentIntegral_ttStar_outgoing_coneTube_eventually_lower
    (Phi : BRRSAnnularCutoff) (n : Nat) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧ ∀ r t : Real, A ≤ r →
      |t - r| ≤ 1 / 6 →
        c / r ^ (n + 1) ≤
          ‖brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Phi)
            (2 * n + 3) .outgoing r t‖ := by
  obtain ⟨A, c, hA, hc, hbound⟩ :=
    exists_brrsStatWaveCompInteg_ttStar_outgoing_coneTube_normd_eventually_lower
      Phi n
  let D : Real := (4 * Real.pi) ^ (n + 1)
  have hD : 0 < D := by
    dsimp [D]
    positivity
  refine ⟨A, c / D, hA, div_pos hc hD, ?_⟩
  intro r t hr htube
  let Y : Complex :=
    brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Phi)
      (2 * n + 3) .outgoing r t
  have hr16 : 16 ≤ r := le_trans hA hr
  have hr0 : 0 ≤ r := by linarith
  have hrpos : 0 < r := by linarith
  have hbase : 0 ≤ 4 * Real.pi * r := by positivity
  have hbaseNorm : ‖(((4 * Real.pi * r : Real) : Complex) * Complex.I)‖ =
      4 * Real.pi * r := by
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg hbase, Complex.norm_I, mul_one]
  have hnorm : c ≤ (4 * Real.pi * r) ^ (n + 1) * ‖Y‖ := by
    have hnorm' := hbound r t hr htube
    change c ≤ ‖(((4 * Real.pi * r : Real) : Complex) * Complex.I) ^ (n + 1) *
      Y‖ at hnorm'
    calc
      c ≤ ‖(((4 * Real.pi * r : Real) : Complex) * Complex.I) ^ (n + 1) * Y‖ :=
        hnorm'
      _ = ‖(((4 * Real.pi * r : Real) : Complex) * Complex.I)‖ ^ (n + 1) * ‖Y‖ := by
        rw [norm_mul, norm_pow]
      _ = (4 * Real.pi * r) ^ (n + 1) * ‖Y‖ := by rw [hbaseNorm]
  have hscale : (4 * Real.pi * r) ^ (n + 1) =
      (4 * Real.pi) ^ (n + 1) * r ^ (n + 1) := by
    rw [show 4 * Real.pi * r = (4 * Real.pi) * r by ring, mul_pow]
  have hscaled : c ≤ D * r ^ (n + 1) * ‖Y‖ := by
    calc
      c ≤ (4 * Real.pi * r) ^ (n + 1) * ‖Y‖ := hnorm
      _ = D * r ^ (n + 1) * ‖Y‖ := by
        dsimp [D]
        rw [hscale]
  change c / D / r ^ (n + 1) ≤ ‖Y‖
  rw [div_div]
  apply (div_le_iff₀ (mul_pos hD (pow_pos hrpos _))).mpr
  simpa only [mul_assoc, mul_left_comm, mul_comm] using hscaled

/-- The incoming and middle stationary components gain an extra radial power
uniformly throughout the fixed outgoing cone tube. -/
theorem exists_brrsStationaryWaveComponentIntegral_nonoutgoing_coneTube_highRadius_power_le
    (Phi : BRRSAnnularCutoff) (n : Nat) (part : BRRSSurfaceWavePart)
    (hpart : part ≠ .outgoing) :
    ∃ C : Real, 0 < C ∧ ∀ r t : Real, 16 ≤ r → |t - r| ≤ 1 / 6 →
      ‖brrsStationaryWaveComponentIntegral Phi (2 * n + 3) part r t‖ ≤
        C / r ^ (n + 2) := by
  obtain ⟨C, hC, hcomponent⟩ :=
    exists_norm_intervalIntegral_brrsStationaryWaveComponent_highRadius_le
      (d := 2 * n + 3) (N := n + 2) (by omega) Phi part
  let C' : Real := (1 - (1 / 32 : Real)) * C
  have hC' : 0 < C' := by
    dsimp [C']
    positivity
  refine ⟨C', hC', ?_⟩
  intro r t hr htube
  have hr0 : 0 ≤ r := by linarith
  have hrpos : 0 < r := by linarith
  have htlower : r - 1 / 6 ≤ t := by
    have hleft : -(1 / 6 : Real) ≤ t - r := (abs_le.mp htube).1
    linarith
  have ht0 : 0 ≤ t := by linarith
  have hphase_lower :
      r ≤ |brrsSurfaceWavePhase part r + 2 * Real.pi * t| := by
    cases part with
    | outgoing => exact False.elim (hpart rfl)
    | incoming =>
      have hrsum0 : 0 ≤ r + t := by linarith
      have hcoef : (1 : Real) ≤ 2 * Real.pi := by
        nlinarith [Real.pi_gt_three]
      have hnonneg : 0 ≤ 2 * Real.pi * (r + t) := by positivity
      rw [show brrsSurfaceWavePhase .incoming r + 2 * Real.pi * t =
        2 * Real.pi * (r + t) by simp [brrsSurfaceWavePhase]; ring,
        abs_of_nonneg hnonneg]
      calc
        r ≤ r + t := by linarith
        _ = 1 * (r + t) := by ring
        _ ≤ (2 * Real.pi) * (r + t) :=
          mul_le_mul_of_nonneg_right hcoef hrsum0
    | middle =>
      have hhalf : r / 2 ≤ t := by linarith
      have hcoef : (2 : Real) ≤ 2 * Real.pi := by
        nlinarith [Real.pi_gt_three]
      have hnonneg : 0 ≤ 2 * Real.pi * t := by positivity
      rw [show brrsSurfaceWavePhase .middle r + 2 * Real.pi * t =
        2 * Real.pi * t by simp [brrsSurfaceWavePhase],
        abs_of_nonneg hnonneg]
      calc
        r = 2 * (r / 2) := by ring
        _ ≤ (2 * Real.pi) * (r / 2) :=
          mul_le_mul_of_nonneg_right hcoef (by linarith)
        _ ≤ (2 * Real.pi) * t :=
          mul_le_mul_of_nonneg_left hhalf (by positivity)
  have habspos : 0 < |brrsSurfaceWavePhase part r + 2 * Real.pi * t| :=
    lt_of_lt_of_le hrpos hphase_lower
  have hphase_ne : brrsSurfaceWavePhase part r + 2 * Real.pi * t ≠ 0 := by
    intro hzero
    rw [hzero, abs_zero] at habspos
    linarith
  have hraw :
      ‖brrsStationaryWaveComponentIntegral Phi (2 * n + 3) part r t‖ ≤
        (1 / |brrsSurfaceWavePhase part r + 2 * Real.pi * t|) ^ (n + 2) *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (r / 16)) ^ ((2 * n + 3) - 1))) := by
    simpa only [brrsStationaryWaveComponentIntegral] using
      hcomponent r t hr hphase_ne
  have hratio : 1 ≤ r / 16 := by linarith
  have hsqrt : 1 ≤ Real.sqrt (r / 16) := Real.one_le_sqrt.mpr hratio
  have hdenone : 1 ≤ (Real.sqrt (r / 16)) ^ ((2 * n + 3) - 1) :=
    one_le_pow₀ hsqrt
  have hdenpos : 0 < (Real.sqrt (r / 16)) ^ ((2 * n + 3) - 1) :=
    lt_of_lt_of_le zero_lt_one hdenone
  have hdiv : C / (Real.sqrt (r / 16)) ^ ((2 * n + 3) - 1) ≤ C := by
    apply (div_le_iff₀ hdenpos).mpr
    exact le_mul_of_one_le_right hC.le hdenone
  have hinv : 1 / |brrsSurfaceWavePhase part r + 2 * Real.pi * t| ≤ 1 / r :=
    one_div_le_one_div_of_le hrpos hphase_lower
  have hinvpow :
      (1 / |brrsSurfaceWavePhase part r + 2 * Real.pi * t|) ^ (n + 2) ≤
        (1 / r) ^ (n + 2) :=
    pow_le_pow_left₀ (by positivity) hinv _
  have hconst : 0 ≤ (1 - (1 / 32 : Real)) * C := by positivity
  calc
    ‖brrsStationaryWaveComponentIntegral Phi (2 * n + 3) part r t‖ ≤
        (1 / |brrsSurfaceWavePhase part r + 2 * Real.pi * t|) ^ (n + 2) *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (r / 16)) ^ ((2 * n + 3) - 1))) := hraw
    _ ≤ (1 / |brrsSurfaceWavePhase part r + 2 * Real.pi * t|) ^ (n + 2) *
          ((1 - (1 / 32 : Real)) * C) := by
      apply mul_le_mul_of_nonneg_left
      · exact mul_le_mul_of_nonneg_left hdiv (by norm_num)
      · positivity
    _ ≤ (1 / r) ^ (n + 2) * ((1 - (1 / 32 : Real)) * C) :=
      mul_le_mul_of_nonneg_right hinvpow hconst
    _ = C' / r ^ (n + 2) := by
      dsimp [C']
      rw [one_div, inv_pow]
      ring

/-- The literal level-zero positive `TT*` kernel has a uniform lower bound
throughout a fixed outgoing cone tube in every odd dimension.  The tube width
is the absolute level-zero width `1 / 6`; it does not shrink as the radius
grows. -/
theorem exists_brrsDyadicHalfWaveKernel_ttStar_outgoing_coneTube_eventually_lower
    (Phi : BRRSAnnularCutoff) (n : Nat) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧
      ∀ (r t : Real) (v : BRRSSpace (2 * n + 3)), A ≤ r → ‖v‖ = 1 →
        |t - r| ≤ 1 / 6 →
          c / r ^ (n + 1) ≤
            ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) 0 t :
              BRRSSpace (2 * n + 3) → Complex) (r • v)‖ := by
  obtain ⟨Aout, cout, hAout, hcout, hout⟩ :=
    exists_brrsStationaryWaveComponentIntegral_ttStar_outgoing_coneTube_eventually_lower
      Phi n
  obtain ⟨Cin, hCin, hin⟩ :=
    exists_brrsStationaryWaveComponentIntegral_nonoutgoing_coneTube_highRadius_power_le
      (brrsTTStarAnnularCutoff Phi) n .incoming (by simp)
  obtain ⟨Cmid, hCmid, hmid⟩ :=
    exists_brrsStationaryWaveComponentIntegral_nonoutgoing_coneTube_highRadius_power_le
      (brrsTTStarAnnularCutoff Phi) n .middle (by simp)
  let E : Real := Cin + Cmid
  have hE : 0 < E := by
    dsimp [E]
    linarith
  let A : Real := max Aout (max 16 (2 * E / cout))
  refine ⟨A, cout / 2, ?_, div_pos hcout (by norm_num), ?_⟩
  · exact le_trans (le_max_left _ _) (le_max_right _ _)
  intro r t v hr hv htube
  let Psi : BRRSAnnularCutoff := brrsTTStarAnnularCutoff Phi
  let O : Complex :=
    brrsStationaryWaveComponentIntegral Psi (2 * n + 3) .outgoing r t
  let I : Complex :=
    brrsStationaryWaveComponentIntegral Psi (2 * n + 3) .incoming r t
  let M : Complex :=
    brrsStationaryWaveComponentIntegral Psi (2 * n + 3) .middle r t
  let K : Complex :=
    (brrsDyadicHalfWaveKernel Psi 0 t : BRRSSpace (2 * n + 3) → Complex) (r • v)
  change cout / 2 / r ^ (n + 1) ≤ ‖K‖
  have hinner : max 16 (2 * E / cout) ≤ r :=
    le_trans (le_max_right _ _) hr
  have hrout : Aout ≤ r := le_trans (le_max_left _ _) hr
  have hr16 : 16 ≤ r := le_trans (le_max_left _ _) hinner
  have hratio : 2 * E / cout ≤ r := le_trans (le_max_right _ _) hinner
  have hr0 : 0 ≤ r := by linarith
  have hrpos : 0 < r := by linarith
  have hout' : cout / r ^ (n + 1) ≤ ‖O‖ := by
    dsimp [O, Psi]
    exact hout r t hrout htube
  have hin' : ‖I‖ ≤ Cin / r ^ (n + 2) := by
    dsimp [I, Psi]
    exact hin r t hr16 htube
  have hmid' : ‖M‖ ≤ Cmid / r ^ (n + 2) := by
    dsimp [M, Psi]
    exact hmid r t hr16 htube
  have hsum : ‖I‖ + ‖M‖ ≤ E / r ^ (n + 2) := by
    calc
      ‖I‖ + ‖M‖ ≤ Cin / r ^ (n + 2) + Cmid / r ^ (n + 2) :=
        add_le_add hin' hmid'
      _ = E / r ^ (n + 2) := by
        dsimp [E]
        ring
  have htwoE : 2 * E ≤ r * cout :=
    (div_le_iff₀ hcout).mp hratio
  have hEover : E / r ≤ cout / 2 := by
    apply (div_le_iff₀ hrpos).mpr
    nlinarith
  have hpowers : r ^ (n + 2) = r * r ^ (n + 1) := by
    rw [show n + 2 = (n + 1) + 1 by omega, pow_succ]
    ring
  have htail : E / r ^ (n + 2) ≤ (cout / 2) / r ^ (n + 1) := by
    calc
      E / r ^ (n + 2) = (E / r) / r ^ (n + 1) := by
        rw [hpowers]
        field_simp [ne_of_gt hrpos]
      _ ≤ (cout / 2) / r ^ (n + 1) :=
        div_le_div_of_nonneg_right hEover (pow_nonneg hr0 _)
  have hnorm : ‖r • v‖ = r := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hr0, hv, mul_one]
  have hsplit :=
    brrsDyadicHalfWaveKernel_eq_levelZero_sum_stationaryWaveComponents
      (d := 2 * n + 3) (by omega) Psi t (r • v)
  rw [hnorm] at hsplit
  have hK : K = O + I + M := by
    dsimp [K, O, I, M]
    simpa only [brrsStationaryWaveComponentIntegral] using hsplit
  have htri : ‖O‖ ≤ ‖K‖ + (‖I‖ + ‖M‖) := by
    calc
      ‖O‖ = ‖K - (I + M)‖ := by
        congr 1
        rw [hK]
        ring
      _ ≤ ‖K‖ + ‖I + M‖ := norm_sub_le _ _
      _ ≤ ‖K‖ + (‖I‖ + ‖M‖) := by
        gcongr
        exact norm_add_le _ _
  have hhalf : cout / r ^ (n + 1) =
      2 * ((cout / 2) / r ^ (n + 1)) := by ring
  nlinarith [hsum.trans htail]

/-- Pointwise form of the full cone-tube lower bound.  This avoids choosing a
unit radial direction at every later use. -/
theorem exists_brrsDyadicHalfWaveKernel_ttStar_outgoing_coneTube_eventually_lower_at_point
    (Phi : BRRSAnnularCutoff) (n : Nat) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧
      ∀ (t : Real) (x : BRRSSpace (2 * n + 3)), A ≤ ‖x‖ →
        |t - ‖x‖| ≤ 1 / 6 →
          c / ‖x‖ ^ (n + 1) ≤
            ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) 0 t :
              BRRSSpace (2 * n + 3) → Complex) x‖ := by
  obtain ⟨A, c, hA, hc, hlower⟩ :=
    exists_brrsDyadicHalfWaveKernel_ttStar_outgoing_coneTube_eventually_lower Phi n
  refine ⟨A, c, hA, hc, ?_⟩
  intro t x hx htube
  let r : Real := ‖x‖
  have hrlarge : A ≤ r := by simpa only [r] using hx
  have hApos : 0 < A := by linarith
  have hrpos : 0 < r := by
    exact lt_of_lt_of_le hApos hrlarge
  have hv : ‖r⁻¹ • x‖ = 1 := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hrpos)]
    change r⁻¹ * r = 1
    exact inv_mul_cancel₀ (ne_of_gt hrpos)
  have hradial : r • (r⁻¹ • x) = x := by
    rw [smul_smul, mul_inv_cancel₀ (ne_of_gt hrpos), one_smul]
  have hpoint := hlower r t (r⁻¹ • x) hrlarge hv (by simpa only [r] using htube)
  rw [hradial] at hpoint
  simpa only [r] using hpoint

/-- Dyadic transport of the full pointwise cone-tube lower bound.  At level
`j` the physical tube has width `(1 / 6) 2⁻ʲ`, while the lower bound carries
the exact scaling factor `2ʲᵈ`. -/
theorem exists_brrsDyHalfWaveKer_ttStar_outgoing_dy_coneTube_eventually_lower_at_point
    (Phi : BRRSAnnularCutoff) (n : Nat) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧
      ∀ (j : Nat) (t : Real) (x : BRRSSpace (2 * n + 3)),
        A ≤ (2 : Real) ^ j * ‖x‖ →
        |t - ‖x‖| ≤ (1 / 6 : Real) * ((2 : Real) ^ j)⁻¹ →
          ((2 : Real) ^ j) ^ (2 * n + 3) * c /
              ((2 : Real) ^ j * ‖x‖) ^ (n + 1) ≤
            ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) j t :
              BRRSSpace (2 * n + 3) → Complex) x‖ := by
  obtain ⟨A, c, hA, hc, hlevel⟩ :=
    exists_brrsDyadicHalfWaveKernel_ttStar_outgoing_coneTube_eventually_lower_at_point
      Phi n
  refine ⟨A, c, hA, hc, ?_⟩
  intro j t x hlarge htube
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp [q]
    positivity
  have hnormscaled : ‖q • x‖ = q * ‖x‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hq]
  have hlarge' : A ≤ ‖q • x‖ := by
    rw [hnormscaled]
    simpa only [q] using hlarge
  have htubeq : |t - ‖x‖| ≤ (1 / 6 : Real) * q⁻¹ := by
    simpa only [q] using htube
  have htube' : |q * t - ‖q • x‖| ≤ 1 / 6 := by
    rw [hnormscaled]
    calc
      |q * t - q * ‖x‖| = |q * (t - ‖x‖)| := by
        congr 1
        ring
      _ = |q| * |t - ‖x‖| := abs_mul _ _
      _ = q * |t - ‖x‖| := by rw [abs_of_pos hq]
      _ ≤ q * ((1 / 6 : Real) * q⁻¹) :=
        mul_le_mul_of_nonneg_left htubeq hq.le
      _ = 1 / 6 := by
        calc
          q * ((1 / 6 : Real) * q⁻¹) = (1 / 6 : Real) * (q * q⁻¹) := by ring
          _ = 1 / 6 := by rw [mul_inv_cancel₀ (ne_of_gt hq), mul_one]
  have hlevel' := hlevel (q * t) (q • x) hlarge' htube'
  have hbase : c / (q * ‖x‖) ^ (n + 1) ≤
      ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) 0 (q * t) :
        BRRSSpace (2 * n + 3) → Complex) (q • x)‖ := by
    simpa only [hnormscaled] using hlevel'
  change q ^ (2 * n + 3) * c / (q * ‖x‖) ^ (n + 1) ≤
    ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) j t :
      BRRSSpace (2 * n + 3) → Complex) x‖
  rw [brrsDyadicHalfWaveKernel_eq_levelZero_scaled_general]
  change q ^ (2 * n + 3) * c / (q * ‖x‖) ^ (n + 1) ≤
    ‖q ^ (2 * n + 3) •
      (brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) 0 (q * t) :
        BRRSSpace (2 * n + 3) → Complex) (q • x)‖
  rw [norm_smul, Real.norm_eq_abs,
    abs_of_nonneg (pow_nonneg hq.le _)]
  calc
    q ^ (2 * n + 3) * c / (q * ‖x‖) ^ (n + 1) =
        q ^ (2 * n + 3) * (c / (q * ‖x‖) ^ (n + 1)) := by ring
    _ ≤ q ^ (2 * n + 3) *
        ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) 0 (q * t) :
          BRRSSpace (2 * n + 3) → Complex) (q • x)‖ :=
      mul_le_mul_of_nonneg_left hbase (pow_nonneg hq.le _)

/-- Relative-time form of the dyadic cone-tube lower bound for the actual
`TT*` kernel. -/
theorem exists_brrsDyHalfWaveTTStarKer_outgoing_dy_coneTube_eventually_lower_at_point
    (Phi : BRRSAnnularCutoff) (n : Nat) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧
      ∀ (j : Nat) (s t : Real) (x : BRRSSpace (2 * n + 3)),
        A ≤ (2 : Real) ^ j * ‖x‖ →
        |(t - s) - ‖x‖| ≤ (1 / 6 : Real) * ((2 : Real) ^ j)⁻¹ →
          ((2 : Real) ^ j) ^ (2 * n + 3) * c /
              ((2 : Real) ^ j * ‖x‖) ^ (n + 1) ≤
            ‖(brrsDyadicHalfWaveTTStarKernel Phi j s t :
              BRRSSpace (2 * n + 3) → Complex) x‖ := by
  obtain ⟨A, c, hA, hc, hlower⟩ :=
    exists_brrsDyHalfWaveKer_ttStar_outgoing_dy_coneTube_eventually_lower_at_point
      Phi n
  refine ⟨A, c, hA, hc, ?_⟩
  intro j s t x hlarge htube
  rw [brrsDyadicHalfWaveTTStarKernel_eq_halfWaveKernelTTStarCutoff]
  exact hlower j (t - s) x hlarge htube

/-- The preceding carrier estimate is strictly positive for a profile of
positive mass; consequently the complex Fourier-character integral is
nonzero and its norm has the same explicit lower bound. -/
theorem brrs_fourierChar_integral_pos_re_nonzero_norm_lower_of_nonneg_of_small_phase
    {α : Type*} [MeasurableSpace α] (μ : Measure α)
    (a phase : α → Real) (ha : Integrable a μ)
    (ha_nonneg : ∀ x, 0 ≤ a x) (ha_pos : 0 < ∫ x, a x ∂μ)
    (hphase_meas : Measurable phase)
    (hsmall : ∀ x, a x ≠ 0 → |2 * Real.pi * phase x| ≤ Real.pi / 3) :
    0 < (∫ x, (Real.fourierChar (phase x) : Complex) * (a x : Complex) ∂μ).re ∧
      (∫ x, (Real.fourierChar (phase x) : Complex) * (a x : Complex) ∂μ) ≠ 0 ∧
        (1 / 2 : Real) * (∫ x, a x ∂μ) ≤
          ‖∫ x, (Real.fourierChar (phase x) : Complex) * (a x : Complex) ∂μ‖ := by
  have hlower := brrs_fourierChar_integral_re_lower_of_nonneg_of_small_phase
    μ a phase ha ha_nonneg hphase_meas hsmall
  have hhalf_pos : 0 < (1 / 2 : Real) * (∫ x, a x ∂μ) :=
    mul_pos (by norm_num) ha_pos
  have hre_pos : 0 <
      (∫ x, (Real.fourierChar (phase x) : Complex) * (a x : Complex) ∂μ).re :=
    lt_of_lt_of_le hhalf_pos hlower
  refine ⟨hre_pos, ?_, ?_⟩
  · intro hzero
    simp [hzero] at hre_pos
  · calc
      (1 / 2 : Real) * (∫ x, a x ∂μ) ≤
          (∫ x, (Real.fourierChar (phase x) : Complex) *
            (a x : Complex) ∂μ).re := hlower
      _ ≤ ‖∫ x, (Real.fourierChar (phase x) : Complex) *
            (a x : Complex) ∂μ‖ := Complex.re_le_norm _

end Auto.Spherical.BRRS

/-! ### Outer radial stationary kernel bounds -/

namespace Auto.Spherical.BRRS

open Set Filter MeasureTheory FourierTransform
open Auto.LittlewoodPaley
open Auto.Spherical.SurfaceMeasureDecay
open Auto.Spherical.OscillatoryIntegralAux Auto.Spherical.AHRS
open scoped BigOperators Convolution ENNReal FourierTransform Topology

noncomputable section

/-- The exact all-nine two-radius stationary kernel is symmetric in the two
radial variables.  This transfers the compact-output/high-source estimate to
the high-output/compact-source regime without discarding any wave piece. -/
theorem brrsTwoRadiusAllStationaryComponentIntegralSum_swap
    (Phi : BRRSAnnularCutoff) (d : Nat) (r s t : Real) :
    brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t =
      brrsTwoRadiusAllStationaryComponentIntegralSum Phi d s r t := by
  unfold brrsTwoRadiusAllStationaryComponentIntegralSum
  rw [brrsTwoRadiusStationaryComponentIntegral_swap Phi d .outgoing .outgoing r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .outgoing .incoming r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .outgoing .middle r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .incoming .outgoing r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .incoming .incoming r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .incoming .middle r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .middle .outgoing r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .middle .incoming r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .middle .middle r s t]
  ring

/-- The nine phase profiles have the same symmetry as the stationary kernel. -/
theorem brrsTwoRadiusNinePhaseProfile_swap
    (N : Nat) (r s t : Real) :
    brrsTwoRadiusNinePhaseProfile N r s t =
      brrsTwoRadiusNinePhaseProfile N s r t := by
  unfold brrsTwoRadiusNinePhaseProfile
  simp only [brrsSurfaceWavePhase]
  ring_nf

/-- The mixed high-output/compact-source regime is the reflected version of
the already proved compact-output/high-source stationary estimate. -/
theorem exists_norm_brrsTwoRadAllStatComponentIntegralSum_highLow_ninePhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real,
      16 ≤ r → 0 ≤ s → s ≤ 16 →
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
            brrsTwoRadiusNinePhaseProfile N r s t := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_norm_brrsTwoRadAllStatComponentIntegralSum_lowHigh_ninePhase_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs0 hs
  rw [brrsTwoRadiusAllStationaryComponentIntegralSum_swap Phi d r s t,
    brrsTwoRadiusNinePhaseProfile_swap N r s t]
  exact hbound s r t hs0 hs hr

/-- At every output radius at least `20`, the full exact two-radius stationary
kernel has the high-output half-density bound, uniformly over all nonnegative
source radii.  The proof genuinely combines the compact-source reflection
with the high--high nine-phase estimate. -/
theorem exists_norm_brrsTwoRadAllStatComponentIntegralSum_outer_ninePhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real,
      20 ≤ r → 0 ≤ s →
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
            brrsTwoRadiusNinePhaseProfile N r s t := by
  obtain ⟨Clo, hClo, hlow⟩ :=
    exists_norm_brrsTwoRadAllStatComponentIntegralSum_highLow_ninePhase_profile_le
      (d := d) (N := N) hd Phi
  obtain ⟨Chi, hChi, hhigh⟩ :=
    exists_norm_brrsTwoRadAllStatComponentIntegralSum_highRad_ninePhase_profile_le
      (d := d) (N := N) hd Phi
  let C : Real := Clo + Chi
  have hC : 0 < C := by
    simpa only [C] using add_pos hClo hChi
  have hClo_le : Clo ≤ C := by
    simpa only [C] using le_add_of_nonneg_right hChi.le
  have hChi_le : Chi ≤ C := by
    simpa only [C] using le_add_of_nonneg_left hClo.le
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs0
  have hr16 : 16 ≤ r := by linarith
  let qr : Real := (Real.sqrt (r / 16)) ^ (d - 1)
  have hqr : 0 < qr := by
    dsimp [qr]
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  let P : Real := brrsTwoRadiusNinePhaseProfile N r s t
  rcases le_total s 16 with hs | hs
  · have hlow' := hlow r s t hr16 hs0 hs
    calc
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤
          (1 - (1 / 32 : Real)) * (Clo / qr) * P := by
            simpa only [qr, P] using hlow'
      _ ≤ (1 - (1 / 32 : Real)) * (C / qr) * P := by
            apply mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_left
                (div_le_div_of_nonneg_right hClo_le hqr.le) (by norm_num))
            dsimp [P]
            exact brrsTwoRadiusNinePhaseProfile_nonneg N _ _ _
  · have hratio : 1 ≤ s / 16 := by linarith
    have hqs_one : 1 ≤ (Real.sqrt (s / 16)) ^ (d - 1) := by
      exact one_le_pow₀ (Real.one_le_sqrt.mpr hratio)
    have hqs : 0 < (Real.sqrt (s / 16)) ^ (d - 1) :=
      lt_of_lt_of_le zero_lt_one hqs_one
    have hdiv : Chi / (Real.sqrt (s / 16)) ^ (d - 1) ≤ C := by
      calc
        Chi / (Real.sqrt (s / 16)) ^ (d - 1) ≤ Chi := by
          apply (div_le_iff₀ hqs).mpr
          exact le_mul_of_one_le_right hChi.le hqs_one
        _ ≤ C := hChi_le
    have hquot :
        Chi / (qr * (Real.sqrt (s / 16)) ^ (d - 1)) ≤ C / qr := by
      have heq :
          Chi / (qr * (Real.sqrt (s / 16)) ^ (d - 1)) =
            (Chi / (Real.sqrt (s / 16)) ^ (d - 1)) / qr := by
        field_simp [ne_of_gt hqr, ne_of_gt hqs]
      rw [heq]
      exact div_le_div_of_nonneg_right hdiv hqr.le
    have hhigh' :
        ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤
          (1 - (1 / 32 : Real)) *
            (Chi / (qr * (Real.sqrt (s / 16)) ^ (d - 1))) * P := by
      simpa only [qr, P, brrsTwoRadiusNinePhaseProfile] using
        hhigh r s t hr16 hs
    calc
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤
          (1 - (1 / 32 : Real)) *
            (Chi / (qr * (Real.sqrt (s / 16)) ^ (d - 1))) * P := hhigh'
      _ ≤ (1 - (1 / 32 : Real)) * (C / qr) * P := by
            apply mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_left hquot (by norm_num))
            dsimp [P]
            exact brrsTwoRadiusNinePhaseProfile_nonneg N _ _ _

/-- Fixed-time outer-region bound for the literal level-zero BRRS half-wave
on radial Schwartz data.  All nine stationary pieces remain inside the
integrable radial source majorant, while the output radius has the sharp
high-radius half-density factor. -/
theorem exists_norm_brrsDyadicHalfWave_levelZero_outer_ninePhase_outerIntegral_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r t : Real,
      ∀ f : BRRSSchwartz d,
      ∀ _hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ v w : BRRSSpace d, ‖v‖ = 1 → ‖w‖ = 1 →
      20 ≤ r →
      ‖brrsDyadicHalfWave Phi 0 t f (r • v)‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
          ∫ s : Ioi (0 : Real),
            brrsTwoRadiusNinePhaseProfile N r s.1 t * ‖f (s.1 • w)‖
            ∂Measure.volumeIoiPow (d - 1) := by
  obtain ⟨C, hC, hkernel⟩ :=
    exists_norm_brrsTwoRadAllStatComponentIntegralSum_outer_ninePhase_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro r t f hf v w hv hw hr
  let P : Ioi (0 : Real) → Real := fun s =>
    brrsTwoRadiusNinePhaseProfile N r s.1 t
  let B : Real := (1 - (1 / 32 : Real)) *
    (C / (Real.sqrt (r / 16)) ^ (d - 1))
  have hPint : Integrable (fun s : Ioi (0 : Real) => P s * ‖f (s.1 • w)‖)
      (Measure.volumeIoiPow (d - 1)) := by
    dsimp [P]
    simpa only [one_mul] using
      (integrable_brrsTwoRadiusNinePhaseProfile_mul_radialNorm
        (by omega) N r 1 t f hf w hw)
  have hK (s : Ioi (0 : Real)) :
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s.1 t‖ ≤
        B * P s := by
    dsimp [B, P]
    exact hkernel r s.1 t hr s.2.le
  have hpoint (s : Ioi (0 : Real)) :
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s.1 t *
          f (s.1 • w)‖ ≤ B * (P s * ‖f (s.1 • w)‖) := by
    rw [norm_mul]
    calc
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s.1 t‖ *
          ‖f (s.1 • w)‖ ≤ (B * P s) * ‖f (s.1 • w)‖ :=
        mul_le_mul_of_nonneg_right (hK s) (norm_nonneg _)
      _ = B * (P s * ‖f (s.1 • w)‖) := by ring
  rw [brrsDyadicHalfWave_levelZero_eq_allStationaryComponentIntegralSum
    hd Phi t f hf v w hv hw r (by linarith)]
  calc
    ‖∫ s : Ioi (0 : Real),
        brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s.1 t *
          f (s.1 • w) ∂Measure.volumeIoiPow (d - 1)‖ ≤
        ∫ s : Ioi (0 : Real),
          ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s.1 t *
            f (s.1 • w)‖ ∂Measure.volumeIoiPow (d - 1) :=
      norm_integral_le_integral_norm _
    _ ≤ ∫ s : Ioi (0 : Real), B * (P s * ‖f (s.1 • w)‖)
          ∂Measure.volumeIoiPow (d - 1) := by
      apply integral_mono_of_nonneg
      · filter_upwards with s
        exact norm_nonneg _
      · exact hPint.const_mul B
      · filter_upwards with s
        exact hpoint s
    _ = B * ∫ s : Ioi (0 : Real), P s * ‖f (s.1 • w)‖
          ∂Measure.volumeIoiPow (d - 1) := by
      rw [integral_const_mul]

/-- Pointwise fixed-time outer-region form.  This is the radial estimate in
the literal physical-space condition `20 ≤ ‖x‖`, rather than merely along a
chosen ray. -/
theorem exists_norm_brrsDyadicHalfWave_levelZero_outer_ninePhase_outerIntegral_le_at_point
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ t : Real,
      ∀ f : BRRSSchwartz d,
      ∀ _hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ x w : BRRSSpace d, ‖w‖ = 1 → 20 ≤ ‖x‖ →
      ‖brrsDyadicHalfWave Phi 0 t f x‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1)) *
          ∫ s : Ioi (0 : Real),
            brrsTwoRadiusNinePhaseProfile N ‖x‖ s.1 t * ‖f (s.1 • w)‖
            ∂Measure.volumeIoiPow (d - 1) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_norm_brrsDyadicHalfWave_levelZero_outer_ninePhase_outerIntegral_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro t f hf x w hw hx
  obtain ⟨v, hv, hxray⟩ :=
    exists_unit_direction_eq_norm_smul (show 0 < d by omega) x
  calc
    ‖brrsDyadicHalfWave Phi 0 t f x‖ =
        ‖brrsDyadicHalfWave Phi 0 t f (‖x‖ • v)‖ :=
      congrArg (fun z : BRRSSpace d => ‖brrsDyadicHalfWave Phi 0 t f z‖) hxray
    _ ≤ (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1)) *
          ∫ s : Ioi (0 : Real),
            brrsTwoRadiusNinePhaseProfile N ‖x‖ s.1 t * ‖f (s.1 • w)‖
            ∂Measure.volumeIoiPow (d - 1) :=
      hbound ‖x‖ t f hf v w hv hw hx

/-- Exact dyadic transport of the all-source outer stationary kernel bound.
The high-output hypothesis is stated in the natural scaled radius. -/
theorem exists_norm_brrsDyTwoRadAllStatComponentIntegralSum_outer_ninePhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r s t : Real,
      20 ≤ ((2 : Real) ^ j) * r → 0 ≤ s →
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s t‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1)) *
              brrsTwoRadiusNinePhaseProfile N
                (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
                  (((2 : Real) ^ j) * t)) := by
  obtain ⟨C, hC, hlevel⟩ :=
    exists_norm_brrsTwoRadAllStatComponentIntegralSum_outer_ninePhase_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j r s t hr hs
  have hq : 0 < (2 : Real) ^ j := pow_pos (by norm_num) _
  exact norm_brrsDyadicTwoRadiusAllStationaryComponentIntegralSum_le_scaled_of_levelZero
    Phi d j r s t _
    (hlevel (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
      (((2 : Real) ^ j) * t) hr (mul_nonneg hq.le hs))

/-- Fixed-time outer-region bound at every dyadic scale.  The output
condition is the literal high-radius condition after rescaling, and the
right side is an integrable all-nine radial phase majorant. -/
theorem exists_norm_brrsDyadicHalfWave_outer_ninePhase_outerIntegral_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r t : Real,
      ∀ f : BRRSSchwartz d,
      ∀ _hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ v w : BRRSSpace d, ‖v‖ = 1 → ‖w‖ = 1 →
      20 ≤ ((2 : Real) ^ j) * r →
      ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1)) *
              ∫ s : Ioi (0 : Real),
                brrsTwoRadiusNinePhaseProfile N
                  (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s.1)
                    (((2 : Real) ^ j) * t) * ‖f (s.1 • w)‖
                ∂Measure.volumeIoiPow (d - 1)) := by
  obtain ⟨C, hC, hkernel⟩ :=
    exists_norm_brrsDyTwoRadAllStatComponentIntegralSum_outer_ninePhase_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j r t f hf v w hv hw hr
  let q : Real := (2 : Real) ^ j
  let P : Ioi (0 : Real) → Real := fun s =>
    brrsTwoRadiusNinePhaseProfile N (q * r) (q * s.1) (q * t)
  let B : Real := ‖q ^ d‖ *
    ((1 - (1 / 32 : Real)) *
      (C / (Real.sqrt ((q * r) / 16)) ^ (d - 1)))
  have hPint : Integrable (fun s : Ioi (0 : Real) => P s * ‖f (s.1 • w)‖)
      (Measure.volumeIoiPow (d - 1)) := by
    dsimp [P]
    exact integrable_brrsTwoRadiusNinePhaseProfile_mul_radialNorm
      (by omega) N (q * r) q (q * t) f hf w hw
  have hq : 0 < q := by
    dsimp [q]
    positivity
  have hK (s : Ioi (0 : Real)) :
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t‖ ≤
        B * P s := by
    change
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t‖ ≤
        (‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1))) *
