        ((s / r) ^ sobolevExponent d p *
          (brrsRadialLpSourceProfile p f w s).toReal) *
        ((((2 : Real) ^ j) * P) /
          (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ k) := by
  have hbase := brrsDyadicHighHigh_prefactor_polar_source_eq
    (j := j) hd hp hr hs f w
  calc
    r ^ (((d : Real) - 1) / p) *
          (((‖((2 : Real) ^ j) ^ d‖ /
            ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
              (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1))) /
            (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ k) *
            (s ^ (d - 1) * ‖f (s • w)‖)) * P =
        (r ^ (((d : Real) - 1) / p) *
          ((‖((2 : Real) ^ j) ^ d‖ /
            ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
              (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1))) *
            (s ^ (d - 1) * ‖f (s • w)‖))) *
          (P / (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ k) := by
      simp only [div_eq_mul_inv]
      ring
    _ = (16 ^ ((d : Real) - 1) *
          ((s / r) ^ sobolevExponent d p *
            (brrsRadialLpSourceProfile p f w s).toReal) *
            ((2 : Real) ^ j)) *
          (P / (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ k) := by
      rw [hbase]
    _ = 16 ^ ((d : Real) - 1) *
        ((s / r) ^ sobolevExponent d p *
          (brrsRadialLpSourceProfile p f w s).toReal) *
        ((((2 : Real) ^ j) * P) /
          (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ k) := by
      simp only [div_eq_mul_inv]
      ring

/-- The companion high--high normalization with the additional half-density
power on the *output* radius.  The middle--endpoint and middle--middle terms
therefore retain an explicitly integrable output tail. -/
theorem brrsDyadicHighHigh_prefactor_polar_source_outputExtraDecay_eq
    {d j : Nat} (hd : 1 ≤ d) {p r s : Real} (hp : p ≠ 0)
    (hr : 0 < r) (hs : 0 < s) (k : Nat)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) (P : Real) :
    r ^ (((d : Real) - 1) / p) *
        (((‖((2 : Real) ^ j) ^ d‖ /
          ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
            (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1))) /
          (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ k) *
          (s ^ (d - 1) * ‖f (s • w)‖)) * P =
      16 ^ ((d : Real) - 1) *
        ((s / r) ^ sobolevExponent d p *
          (brrsRadialLpSourceProfile p f w s).toReal) *
        ((((2 : Real) ^ j) * P) /
          (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ k) := by
  have hbase := brrsDyadicHighHigh_prefactor_polar_source_eq
    (j := j) hd hp hr hs f w
  calc
    r ^ (((d : Real) - 1) / p) *
          (((‖((2 : Real) ^ j) ^ d‖ /
            ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
              (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1))) /
            (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ k) *
            (s ^ (d - 1) * ‖f (s • w)‖)) * P =
        (r ^ (((d : Real) - 1) / p) *
          ((‖((2 : Real) ^ j) ^ d‖ /
            ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
              (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1))) *
            (s ^ (d - 1) * ‖f (s • w)‖))) *
          (P / (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ k) := by
      simp only [div_eq_mul_inv]
      ring
    _ = (16 ^ ((d : Real) - 1) *
          ((s / r) ^ sobolevExponent d p *
            (brrsRadialLpSourceProfile p f w s).toReal) *
            ((2 : Real) ^ j)) *
          (P / (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ k) := by
      rw [hbase]
    _ = 16 ^ ((d : Real) - 1) *
        ((s / r) ^ sobolevExponent d p *
          (brrsRadialLpSourceProfile p f w s).toReal) *
        ((((2 : Real) ^ j) * P) /
          (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ k) := by
      simp only [div_eq_mul_inv]
      ring

/-- The two endpoint--middle phases, written as one real dyadic profile.  It
depends on the output radius and time only; the independent source-radius
tail is retained in the coefficient. -/
noncomputable def brrsDyadicMiddleSourcePhaseProfile
    (N j : Nat) (r t : Real) : Real :=
  (brrsDyadicStationaryPhaseProfile N j (t - r)).toReal +
    (brrsDyadicStationaryPhaseProfile N j (t + r)).toReal

/-- The three phases with a middle wave at the output radius.  Their separate
high-order output half-density is the integrable remainder in the outer
radial estimate. -/
noncomputable def brrsDyadicMiddleOutputPhaseProfile
    (N j : Nat) (s t : Real) : Real :=
  (brrsDyadicStationaryPhaseProfile N j (t - s)).toReal +
    (brrsDyadicStationaryPhaseProfile N j (t + s)).toReal +
      (brrsDyadicStationaryPhaseProfile N j t).toReal

/-- The source-middle profile is exactly the dyadic rescaling of its two
literal stationary carriers. -/
theorem brrsDyadicMiddleSourcePhaseProfile_eq
    (N j : Nat) (r s t : Real) :
    brrsDyadicMiddleSourcePhaseProfile N j r t =
      ((2 : Real) ^ j) *
        (brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .outgoing (((2 : Real) ^ j) * r) +
              brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * s) +
                2 * Real.pi * (((2 : Real) ^ j) * t)) +
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .incoming (((2 : Real) ^ j) * r) +
              brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * s) +
                2 * Real.pi * (((2 : Real) ^ j) * t))) := by
  unfold brrsDyadicMiddleSourcePhaseProfile
  rw [brrsDyadicStationaryPhaseProfile_toReal,
    brrsDyadicStationaryPhaseProfile_toReal]
  have hout : 2 * Real.pi * (((2 : Real) ^ j) * (t - r)) =
      brrsSurfaceWavePhase .outgoing (((2 : Real) ^ j) * r) +
        brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * s) +
          2 * Real.pi * (((2 : Real) ^ j) * t) := by
    simp [brrsSurfaceWavePhase]
    ring
  have hin : 2 * Real.pi * (((2 : Real) ^ j) * (t + r)) =
      brrsSurfaceWavePhase .incoming (((2 : Real) ^ j) * r) +
        brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * s) +
          2 * Real.pi * (((2 : Real) ^ j) * t) := by
    simp [brrsSurfaceWavePhase]
    ring
  rw [hout, hin]
  ring

/-- The output-middle profile is exactly the dyadic rescaling of the three
remaining literal stationary carriers. -/
theorem brrsDyadicMiddleOutputPhaseProfile_eq
    (N j : Nat) (r s t : Real) :
    brrsDyadicMiddleOutputPhaseProfile N j s t =
      ((2 : Real) ^ j) *
        (brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * r) +
              brrsSurfaceWavePhase .outgoing (((2 : Real) ^ j) * s) +
                2 * Real.pi * (((2 : Real) ^ j) * t)) +
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * r) +
              brrsSurfaceWavePhase .incoming (((2 : Real) ^ j) * s) +
                2 * Real.pi * (((2 : Real) ^ j) * t)) +
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * r) +
              brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * s) +
                2 * Real.pi * (((2 : Real) ^ j) * t))) := by
  unfold brrsDyadicMiddleOutputPhaseProfile
  rw [brrsDyadicStationaryPhaseProfile_toReal,
    brrsDyadicStationaryPhaseProfile_toReal,
    brrsDyadicStationaryPhaseProfile_toReal]
  have hout : 2 * Real.pi * (((2 : Real) ^ j) * (t - s)) =
      brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * r) +
        brrsSurfaceWavePhase .outgoing (((2 : Real) ^ j) * s) +
          2 * Real.pi * (((2 : Real) ^ j) * t) := by
    simp [brrsSurfaceWavePhase]
    ring
  have hin : 2 * Real.pi * (((2 : Real) ^ j) * (t + s)) =
      brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * r) +
        brrsSurfaceWavePhase .incoming (((2 : Real) ^ j) * s) +
          2 * Real.pi * (((2 : Real) ^ j) * t) := by
    simp [brrsSurfaceWavePhase]
    ring
  have hmid : 2 * Real.pi * (((2 : Real) ^ j) * t) =
      brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * r) +
        brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * s) +
          2 * Real.pi * (((2 : Real) ^ j) * t) := by
    simp [brrsSurfaceWavePhase]
  rw [← hout, ← hin, ← hmid]
  ring

/-- The five middle-wave high--high components satisfy the same radial
Sobolev normalization as the four endpoint components, but with the crucial
extra decay left in place.  The first summand has `d + 5` surplus
half-density powers in the source radius; the second has them in the output
radius.  Consequently the latter is directly integrable in the outer radial
variable, while the former remains a translated phase-profile convolution.

This is the reusable pointwise interface for the fixed-time radial `L^p`
argument (`p > 0`, in particular for the BRRS range `2 ≤ p < ∞`). -/
theorem exists_brrsDyadicHighHigh_middle_radial_fivePhase_sobolevSource_block_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r s t p : Real,
      ∀ f : BRRSSpace d → Complex, ∀ w : BRRSSpace d,
      0 < p → 16 ≤ ((2 : Real) ^ j) * r → 16 ≤ ((2 : Real) ^ j) * s →
      r ^ (((d : Real) - 1) / p) *
          (‖brrsDyadicTwoRadiusMiddleComponentIntegralSum Phi d j r s t‖ *
            (s ^ (d - 1) * ‖f (s • w)‖)) ≤
        (1 - (1 / 32 : Real)) * C * 16 ^ ((d : Real) - 1) *
          r ^ (-sobolevExponent d p) *
          (brrsRadialSobolevSourceProfile p f w s).toReal *
          (brrsDyadicMiddleSourcePhaseProfile N j r t /
              (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d + 5) +
            brrsDyadicMiddleOutputPhaseProfile N j s t /
              (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d + 5)) := by
  obtain ⟨C, hC, hkernel⟩ :=
    exists_norm_brrsDyTwoRadMiddleCompIntegSum_highRad_fivePhase_rapidProfile_le
      (d := d) (N := N) (M := 2 * d + 5) hd (by omega) Phi
  refine ⟨C, hC, ?_⟩
  intro j r s t p f w hp hr hs
  have hq : 0 < (2 : Real) ^ j := by positivity
  have hrpos : 0 < r := by
    apply pos_of_mul_pos_right
      (lt_of_lt_of_le (by norm_num) hr)
    exact hq.le
  have hspos : 0 < s := by
    apply pos_of_mul_pos_right
      (lt_of_lt_of_le (by norm_num) hs)
    exact hq.le
  let Psource : Real :=
    brrsStationaryRapidProfile N
        (brrsSurfaceWavePhase .outgoing (((2 : Real) ^ j) * r) +
          brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * s) +
            2 * Real.pi * (((2 : Real) ^ j) * t)) +
      brrsStationaryRapidProfile N
        (brrsSurfaceWavePhase .incoming (((2 : Real) ^ j) * r) +
          brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * s) +
            2 * Real.pi * (((2 : Real) ^ j) * t))
  let Poutput : Real :=
    brrsStationaryRapidProfile N
        (brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * r) +
          brrsSurfaceWavePhase .outgoing (((2 : Real) ^ j) * s) +
            2 * Real.pi * (((2 : Real) ^ j) * t)) +
      brrsStationaryRapidProfile N
        (brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * r) +
          brrsSurfaceWavePhase .incoming (((2 : Real) ^ j) * s) +
            2 * Real.pi * (((2 : Real) ^ j) * t)) +
      brrsStationaryRapidProfile N
        (brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * r) +
          brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * s) +
            2 * Real.pi * (((2 : Real) ^ j) * t))
  have hkernel' :
      ‖brrsDyadicTwoRadiusMiddleComponentIntegralSum Phi d j r s t‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) *
            (C / ((Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^
              ((2 * d + 5) - 1) *
              (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1))) *
            Psource +
          (1 - (1 / 32 : Real)) *
            (C / ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^
              ((2 * d + 5) - 1) *
              (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1))) *
            Poutput) := by
    simpa only [Psource, Poutput] using hkernel j r s t hr hs
  have hdensity : 0 ≤ s ^ (d - 1) * ‖f (s • w)‖ :=
    mul_nonneg (pow_nonneg hspos.le _) (norm_nonneg _)
  have hradial : 0 ≤ r ^ (((d : Real) - 1) / p) :=
    Real.rpow_nonneg hrpos.le _
  have hindex : (2 * d + 5) - 1 = (d - 1) + (d + 5) := by omega
  have hfactorization :
      (r ^ (((d : Real) - 1) / p) *
          (s ^ (d - 1) * ‖f (s • w)‖)) *
        (‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) *
            (C / ((Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^
              ((2 * d + 5) - 1) *
              (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1))) *
            Psource +
          (1 - (1 / 32 : Real)) *
            (C / ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^
              ((2 * d + 5) - 1) *
              (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1))) *
            Poutput)) =
        (1 - (1 / 32 : Real)) * C *
          ((r ^ (((d : Real) - 1) / p) *
              (((‖((2 : Real) ^ j) ^ d‖ /
                ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
                  (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1))) /
                (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d + 5)) *
                (s ^ (d - 1) * ‖f (s • w)‖)) * Psource) +
            (r ^ (((d : Real) - 1) / p) *
              (((‖((2 : Real) ^ j) ^ d‖ /
                ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
                  (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1))) /
                (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d + 5)) *
                (s ^ (d - 1) * ‖f (s • w)‖)) * Poutput)) := by
    rw [hindex, pow_add, pow_add]
    simp only [div_eq_mul_inv]
    ring
  calc
    r ^ (((d : Real) - 1) / p) *
          (‖brrsDyadicTwoRadiusMiddleComponentIntegralSum Phi d j r s t‖ *
            (s ^ (d - 1) * ‖f (s • w)‖)) =
        (r ^ (((d : Real) - 1) / p) *
          (s ^ (d - 1) * ‖f (s • w)‖)) *
          ‖brrsDyadicTwoRadiusMiddleComponentIntegralSum Phi d j r s t‖ := by
      ring
    _ ≤ (r ^ (((d : Real) - 1) / p) *
          (s ^ (d - 1) * ‖f (s • w)‖)) *
        (‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) *
            (C / ((Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^
              ((2 * d + 5) - 1) *
              (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1))) *
            Psource +
          (1 - (1 / 32 : Real)) *
            (C / ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^
              ((2 * d + 5) - 1) *
              (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1))) *
            Poutput)) :=
      mul_le_mul_of_nonneg_left hkernel' (mul_nonneg hradial hdensity)
    _ = (1 - (1 / 32 : Real)) * C * 16 ^ ((d : Real) - 1) *
          ((s / r) ^ sobolevExponent d p *
            (brrsRadialLpSourceProfile p f w s).toReal) *
          (((((2 : Real) ^ j) * Psource) /
              (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d + 5)) +
            ((((2 : Real) ^ j) * Poutput) /
              (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d + 5))) := by
      rw [hfactorization,
        brrsDyadicHighHigh_prefactor_polar_source_sourceExtraDecay_eq
          (j := j) (by omega) hp.ne' hrpos hspos (d + 5) f w Psource,
        brrsDyadicHighHigh_prefactor_polar_source_outputExtraDecay_eq
          (j := j) (by omega) hp.ne' hrpos hspos (d + 5) f w Poutput]
      ring
    _ = (1 - (1 / 32 : Real)) * C * 16 ^ ((d : Real) - 1) *
          r ^ (-sobolevExponent d p) *
          (brrsRadialSobolevSourceProfile p f w s).toReal *
          (brrsDyadicMiddleSourcePhaseProfile N j r t /
              (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d + 5) +
            brrsDyadicMiddleOutputPhaseProfile N j s t /
              (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d + 5)) := by
      rw [brrs_radiusRatio_mul_radialLpSourceProfile_toReal_eq hrpos hspos f w,
        ← brrsDyadicMiddleSourcePhaseProfile_eq N j r s t,
        ← brrsDyadicMiddleOutputPhaseProfile_eq N j r s t]
      ring

/-! ### Compact-output / high-source Sobolev normalization -/

/-- The single high-source half-density in the compact-output kernel exactly
converts the polar radial density into the Sobolev-weighted `L^p` source
profile.  Unlike the high--high identity, there is only one radial
half-density, so the surviving dyadic factor is `q ^ ((d - 1) / 2 + 1)`.
This is a pointwise algebraic identity and does not discard any of the nine
stationary phases. -/
theorem brrs_lowHigh_prefactor_polar_source_eq
    {d : Nat} (hd : 1 ≤ d) {p q s : Real} (hp : p ≠ 0)
    (hq : 0 < q) (hs : 0 < s)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) :
    (q ^ d / (Real.sqrt (q * s / 16)) ^ (d - 1)) *
        (s ^ (d - 1) * ‖f (s • w)‖) =
      (q ^ (((d : Real) - 1) / 2 + 1) *
          (16 : Real) ^ (((d : Real) - 1) / 2)) *
        (brrsRadialSobolevSourceProfile p f w s).toReal := by
  let n : Real := (d : Real) - 1
  have hnum : q ^ d = q ^ (n + 1) := by
    rw [← Real.rpow_natCast]
    dsimp [n]
    congr 1
    ring
  have hden : (Real.sqrt (q * s / 16)) ^ (d - 1) =
      (q * s / 16) ^ (n / 2) := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_natCast,
      ← Real.rpow_mul (by positivity)]
    dsimp [n]
    norm_num [Nat.cast_sub hd]
    ring
  have hspow : s ^ (d - 1) = s ^ n := by
    rw [← Real.rpow_natCast]
    dsimp [n]
    congr 1
    norm_num [Nat.cast_sub hd]
  have hsource : s ^ (n / 2) * ‖f (s • w)‖ =
      (brrsRadialSobolevSourceProfile p f w s).toReal := by
    calc
      s ^ (n / 2) * ‖f (s • w)‖ =
          (s / 1) ^ sobolevExponent d p *
            (brrsRadialLpSourceProfile p f w s).toReal := by
        simpa only [n, one_div, Real.one_rpow, one_mul] using
          (brrs_highHigh_halfDensity_source_weight_eq
            (d := d) (p := p) (r := 1) (s := s) hp (by norm_num) hs f w)
      _ = s ^ sobolevExponent d p *
            (brrsRadialLpSourceProfile p f w s).toReal := by rw [div_one]
      _ = (brrsRadialSobolevSourceProfile p f w s).toReal :=
        (brrsRadialSobolevSourceProfile_toReal p f w hs.le).symm
  rw [hnum, hden, hspow]
  have hqsplit : q ^ (n + 1) = q ^ (n / 2 + 1) * q ^ (n / 2) := by
    rw [← Real.rpow_add hq]
    congr 1
    ring
  have hssplit : s ^ n = s ^ (n / 2) * s ^ (n / 2) := by
    rw [← Real.rpow_add hs]
    congr 1
    ring
  rw [Real.div_rpow (mul_nonneg hq.le hs.le) (by norm_num),
    Real.mul_rpow hq.le hs.le, hqsplit, hssplit]
  calc
    (q ^ (n / 2 + 1) * q ^ (n / 2) /
        (q ^ (n / 2) * s ^ (n / 2) / 16 ^ (n / 2))) *
          (s ^ (n / 2) * s ^ (n / 2) * ‖f (s • w)‖) =
        (q ^ (n / 2 + 1) * 16 ^ (n / 2)) *
          (s ^ (n / 2) * ‖f (s • w)‖) := by
      field_simp [ne_of_gt (Real.rpow_pos_of_pos hq _),
        ne_of_gt (Real.rpow_pos_of_pos hs _),
        ne_of_gt (Real.rpow_pos_of_pos (by norm_num : (0 : Real) < 16) _)]
    _ = (q ^ (((d : Real) - 1) / 2 + 1) *
          16 ^ (((d : Real) - 1) / 2)) *
        (brrsRadialSobolevSourceProfile p f w s).toReal := by
      rw [hsource]

/-- Literal compact-output/high-source all-nine kernel estimate in the
Sobolev source normalization.  The condition `16 ≤ 2^j s` is the exact
mixed-regime threshold; hence this applies in particular to every stronger
high-source cut such as `1024 ≤ 2^j s`.  The nine phase profiles are retained
verbatim, while the polar density and the source half-density are converted
to one fixed `brrsRadialSobolevSourceProfile`. -/
theorem exists_brrsDyadicI0_lowHigh_sobolevSource_ninePhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r s t p : Real,
      ∀ f : BRRSSpace d → Complex, ∀ w : BRRSSpace d,
      2 ≤ p → 0 ≤ r → r ≤ dyadicTimeScale j →
      16 ≤ ((2 : Real) ^ j) * s →
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s t‖ *
          (s ^ (d - 1) * ‖f (s • w)‖) ≤
        ((1 - (1 / 32 : Real)) * C) *
          (((((2 : Real) ^ j) ^ (((d : Real) - 1) / 2 + 1) *
            (16 : Real) ^ (((d : Real) - 1) / 2)) *
              (brrsRadialSobolevSourceProfile p f w s).toReal) *
            brrsTwoRadiusNinePhaseProfile N
              (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
                (((2 : Real) ^ j) * t)) := by
  obtain ⟨C, hC, hkernel⟩ :=
    exists_norm_brrsDyTwoRadAllStatCompIntegralSum_lowHigh_ninePhase_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j r s t p f w hp hr0 hr hhigh
  let q : Real := (2 : Real) ^ j
  let D : Real := (Real.sqrt (q * s / 16)) ^ (d - 1)
  let P : Real := brrsTwoRadiusNinePhaseProfile N (q * r) (q * s) (q * t)
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hs : 0 < s := by
    have hqs : 0 < q * s := lt_of_lt_of_le (by norm_num) hhigh
    rcases (mul_pos_iff.mp hqs) with hpos | hneg
    · exact hpos.2
    · linarith [hq, hneg.1]
