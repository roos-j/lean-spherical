  let P : Real → Real := fun s =>
    brrsTwoRadiusNinePhaseProfile N (q * r) (q * s) (q * t)
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hCfac : 0 ≤ Cfac := by
    dsimp only [Cfac]
    positivity
  have hQfac : 0 ≤ Qfac := by
    dsimp only [Qfac]
    positivity
  apply setLIntegral_mono' measurableSet_Ici
  intro s hs
  have hhigh : 16 ≤ q * s := by
    calc
      16 ≤ q * S := by simpa only [q] using hS
      _ ≤ q * s := mul_le_mul_of_nonneg_left hs hq.le
  have hspos : 0 < s := by
    have hqspos : 0 < q * s := lt_of_lt_of_le (by norm_num) hhigh
    rcases (mul_pos_iff.mp hqspos) with hpos | hneg
    · exact hpos.2
    · linarith [hq, hneg.1]
