/-- In the compact-output/high-source regime, a middle wave in the source
radius retains arbitrary rapid decay in that source radius.  This refinement
is needed because its literal phase need not contain the source variable. -/
theorem exists_unif_iteratedDeriv_brrsTwoRadStatCoeff_lowHigh_middleSource_rapidDecay
    {d N M : Nat} (hd : 3 ≤ d) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff)
    (partR : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ r s rho : Real,
      0 ≤ r → r ≤ 16 → 16 ≤ s → rho ∈ Icc (1 / 32 : Real) 1 →
      ‖iteratedDeriv k (fun u : Real =>
        brrsTwoRadiusStationaryCoefficient Phi d partR .middle r s u) rho‖ ≤
        C / (Real.sqrt (s / 16)) ^ (M - 1) := by
