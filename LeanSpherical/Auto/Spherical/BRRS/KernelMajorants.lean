        ((1 - (1 / 32 : Real)) * (C / D) * J) := by
    dsimp [D, J]
    simpa only [Real.norm_eq_abs] using houter j r t f hf v w hv hw hr
  change D * ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
    ‖((2 : Real) ^ j) ^ d‖ * ((1 - (1 / 32 : Real)) * C * J)
  calc
    D * ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
        D * (‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) * (C / D) * J)) :=
      mul_le_mul_of_nonneg_left hpoint hDpos.le
    _ = ‖((2 : Real) ^ j) ^ d‖ *
