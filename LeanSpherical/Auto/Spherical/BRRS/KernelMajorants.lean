  refine ⟨C, hC, ?_⟩
  intro j r t f hf v w hv hw hr
  let D : Real :=
    (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1)
  let J : Real := ∫ s : Ioi (0 : Real),
    brrsTwoRadiusNinePhaseProfile N
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s.1)
        (((2 : Real) ^ j) * t) * ‖f (s.1 • w)‖
      ∂Measure.volumeIoiPow (d - 1)
  let I : Real := ∫ s : Ioi (0 : Real), ‖f (s.1 • w)‖
    ∂Measure.volumeIoiPow (d - 1)
  have hDpos : 0 < D := by
    dsimp [D]
    apply pow_pos
