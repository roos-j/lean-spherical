  let Qfac : Real := q ^ (((d : Real) - 1) / 2 + 1) *
    (16 : Real) ^ (((d : Real) - 1) / 2)
  let P : Real → Real := fun s =>
    brrsTwoRadiusNinePhaseProfile N (q * r) (q * s) (q * t)
  have hq : 0 < q := by
