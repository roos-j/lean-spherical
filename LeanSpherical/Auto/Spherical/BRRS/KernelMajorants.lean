      gcongr
      exact ENNReal.ofReal_toReal_le
    _ = ENNReal.ofReal ((1 - (1 / 32 : Real)) * C) *
        ((ENNReal.ofReal
            (((2 : Real) ^ j) ^ (((d : Real) - 1) / 2 + 1) *
              (16 : Real) ^ (((d : Real) - 1) / 2)) *
            brrsRadialSobolevSourceProfile p f w s) *
