            dsimp [F]
            rw [Set.indicator_of_mem hmem]
            simp only [mul_one]
            dsimp [q]
            exact high_surface_kernel_q_rewrite B L n d
      exact hterm.trans ((hF_pointwise_summable ω).le_tsum n fun j _ => hF_nonneg j ω)
  have huniform :
      (∫ ω : sphere (0 : Euclidean d) 1,
        ‖(L ^ d) • K (L • (z - (ω : Euclidean d)))‖
          ∂unitSurfaceMeasure d) ≤ C * L := by
    calc
      (∫ ω : sphere (0 : Euclidean d) 1,
        ‖(L ^ d) • K (L • (z - (ω : Euclidean d)))‖ ∂unitSurfaceMeasure d) ≤
          ∫ ω : sphere (0 : Euclidean d) 1, ∑' n : ℕ, F n ω ∂unitSurfaceMeasure d := by
        apply integral_mono_of_nonneg
        · exact Filter.Eventually.of_forall fun ω => norm_nonneg _
        · exact htsum_integrable
        · exact Filter.Eventually.of_forall hpointwise
      _ = ∑' n : ℕ, ∫ ω : sphere (0 : Euclidean d) 1, F n ω ∂unitSurfaceMeasure d :=
        htsum_integral
      _ ≤ 2 * (B * D * L * (2 : ℝ) ^ (d - 1)) := hsum_integrals_bound
      _ = (2 * (B * D * (2 : ℝ) ^ (d - 1))) * L := by ring
      _ ≤ C * L := by
        apply mul_le_mul_of_nonneg_right
        · dsimp [C]
          exact le_add_of_nonneg_right (by positivity)
        · exact hLpos.le
  refine ⟨huniform, ?_⟩
  intro m hm
  have hS_empty (n : ℕ) (hn : n < m) : S n = ∅ := by
    ext ω
    simp only [Set.mem_empty_iff_false, iff_false]
    intro hω
    have hωnorm : ‖(ω : Euclidean d)‖ = 1 :=
      mem_sphere_zero_iff_norm.mp ω.property
    have hdist : |‖z‖ - 1| < (2 : ℝ) ^ (n + 1) / L := by
      calc
        |‖z‖ - 1| = |‖z‖ - ‖(ω : Euclidean d)‖| := by rw [hωnorm]
        _ ≤ ‖z - (ω : Euclidean d)‖ := abs_norm_sub_norm_le _ _
        _ = dist z (ω : Euclidean d) := by rw [dist_eq_norm_sub]
        _ = dist (ω : Euclidean d) z := dist_comm _ _
        _ < (2 : ℝ) ^ (n + 1) / L := hω
