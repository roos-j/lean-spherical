        · exact hLpos.le
      · exact pow_nonneg hs_nonneg _

/-- The elementary change of variables which puts the physical-space kernel
on the unit spherical shell. -/
private theorem relative_surface_kernel_argument
    {d : Nat} (L r : ℝ) (hr : 0 < r)
    (x y w : Euclidean d) :
    (L * r⁻¹) • (x + r • w - y) =
      - (L • (r⁻¹ • (y - x) - w)) := by
  rw [mul_smul]
  simp only [smul_sub, smul_add, smul_smul, inv_mul_cancel₀ hr.ne', one_smul]
  module

/-- The `j`-th relative-frequency piece of the spherical average is bounded
pointwise by `O(2^j)` times the dyadic ball maximal average.  This is the
physical-space high-frequency endpoint used in the interpolation argument. -/
theorem
    exists_fixed_rad_fourierInv_rel_surf_scaled_schwartz_mult_le_dy_average_sup
    {d : Nat} (hd : 0 < d) (ψ : SchwartzMap (Euclidean d) ℂ) :
    ∃ D : ℝ, 0 < D ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean d) ℂ)
      {r : ℝ}, 0 < r → ∀ x : Euclidean d,
      ‖𝓕⁻ (fun ξ : Euclidean d => surfaceFourier d (-r • ξ) *
        ψ (((2 : ℝ) ^ j)⁻¹ • (r • ξ)) *
        𝓕 (f : Euclidean d → ℂ) ξ) x‖ ≤
        D * (2 : ℝ) ^ j *
          ((⨆ n : ℤ,
            ((volume (Metric.ball x ((2 : ℝ) ^ n)))⁻¹ *
              ∫⁻ y in Metric.ball x ((2 : ℝ) ^ n), ENNReal.ofReal ‖f y‖)).toReal *
            (volume (Metric.ball (0 : Euclidean d) 1)).toReal) := by
  let K : SchwartzMap (Euclidean d) ℂ := 𝓕⁻ ψ
  let negA : Euclidean d ≃L[ℝ] Euclidean d :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 (-1 : ℝ) (by norm_num))
