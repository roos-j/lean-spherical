      exact hD_sq.comp_add_right (r • (ω : Euclidean d))
    · have heq : (fun ω : sphere (0 : Euclidean d) 1 =>
          ∫ x : Euclidean d, ‖‖fderiv ℝ f (x + r • (ω : Euclidean d))‖ ^ 2‖) =
