      (∑' n : ℕ, s ^ n) ≤ ∑' n : ℕ, (1 / 2 : ℝ) ^ n :=
        Summable.tsum_le_tsum
          (fun n => pow_le_pow_left₀ hs_nonneg hs_le_half n) hgeom_s hhalf
      _ = 2 := by
        have h : ‖(1 / 2 : ℝ)‖ < 1 := by norm_num
        rw [(hasSum_geometric_of_norm_lt_one h).tsum_eq]
        norm_num
  let S : ℕ → Set (sphere (0 : Euclidean d) 1) := fun n =>
    (fun ω : sphere (0 : Euclidean d) 1 => (ω : Euclidean d)) ⁻¹'
      Metric.ball z ((2 : ℝ) ^ (n + 1) / L)
  let F : ℕ → sphere (0 : Euclidean d) 1 → ℝ := fun n ω =>
    (B * L ^ d * q ^ n) * (S n).indicator (fun _ => (1 : ℝ)) ω
  have hSmeas (n : ℕ) : MeasurableSet (S n) := by
    dsimp [S]
    exact measurableSet_ball.preimage continuous_subtype_val.measurable
  have hcoeff_nonneg (n : ℕ) : 0 ≤ B * L ^ d * q ^ n := by
    positivity
  have hF_nonneg (n : ℕ) (ω : sphere (0 : Euclidean d) 1) : 0 ≤ F n ω := by
    dsimp [F]
    apply mul_nonneg (hcoeff_nonneg n)
    apply Set.indicator_nonneg
    intro _ _
    norm_num
  have hF_le_major (n : ℕ) (ω : sphere (0 : Euclidean d) 1) :
      F n ω ≤ (B * L ^ d) * q ^ n := by
    dsimp [F]
    by_cases hω : ω ∈ S n
    · simp [hω]
    · simp [hω, hcoeff_nonneg n]
  have hF_pointwise_summable (ω : sphere (0 : Euclidean d) 1) :
      Summable fun n : ℕ => F n ω := by
    refine Summable.of_nonneg_of_le
      (f := fun n : ℕ => (B * L ^ d) * q ^ n)
      (g := fun n : ℕ => F n ω) ?_ ?_ ?_
    · intro n
      exact hF_nonneg n ω
    · intro n
      exact hF_le_major n ω
    · simpa [mul_assoc] using hgeom.mul_left (B * L ^ d)
  have hF_integrable (n : ℕ) : Integrable (F n) (unitSurfaceMeasure d) := by
    dsimp [F]
    exact ((integrable_const (1 : ℝ)).indicator (hSmeas n)).const_mul _
  have hF_integral (n : ℕ) :
      (∫ ω : sphere (0 : Euclidean d) 1, F n ω ∂unitSurfaceMeasure d) =
        (B * L ^ d * q ^ n) * ((unitSurfaceMeasure d) (S n)).toReal := by
    dsimp [F]
    rw [integral_const_mul]
    change (B * L ^ d * q ^ n) *
      (∫ ω : sphere (0 : Euclidean d) 1,
        (S n).indicator (1 : sphere (0 : Euclidean d) 1 → ℝ) ω
