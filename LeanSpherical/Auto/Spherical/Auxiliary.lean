          C * ∫ z : Euclidean d, ‖(𝓕⁻ ψ : SchwartzMap (Euclidean d) ℂ) z‖ := by
      intro y
      rw [SchwartzMap.fourierInv_coe]
      rw [show (h : Euclidean d → ℂ) =
          fun ξ : Euclidean d => ψ (R⁻¹ • ξ) * 𝓕 (f : Euclidean d → ℂ) ξ by
        funext ξ
        rw [hh]
