    (hpiece : ∀ n, eLpNorm (f n) p μ ≤ C * ρ ^ n) (N : ℕ) :
    eLpNorm (fun x => ∑ n ∈ Finset.range N, f n x) p μ ≤ C * (1 - ρ)⁻¹ := by
