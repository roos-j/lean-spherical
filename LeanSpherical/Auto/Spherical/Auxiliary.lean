      _ = ((B * D * L * (2 : ℝ) ^ (d - 1)) * s ^ m) *
          ∑' n : ℕ, s ^ n := by
        rw [tsum_mul_left]
      _ ≤ ((B * D * L * (2 : ℝ) ^ (d - 1)) * s ^ m) * 2 := by
        apply mul_le_mul_of_nonneg_left
        · exact hsum_s_le_two
        · positivity
      _ = 2 * (B * D * L * (2 : ℝ) ^ (d - 1)) * s ^ m := by ring
  calc
    (∫ ω : sphere (0 : Euclidean d) 1,
      ‖(L ^ d) • K (L • (z - (ω : Euclidean d)))‖ ∂unitSurfaceMeasure d) ≤
        ∫ ω : sphere (0 : Euclidean d) 1, ∑' n : ℕ, F n ω ∂unitSurfaceMeasure d := by
      apply integral_mono_of_nonneg
      · exact Filter.Eventually.of_forall fun ω => norm_nonneg _
      · exact htsum_integrable
      · exact Filter.Eventually.of_forall hpointwise
    _ = ∑' n : ℕ, ∫ ω : sphere (0 : Euclidean d) 1, F n ω ∂unitSurfaceMeasure d :=
      htsum_integral
    _ = ∑' n : ℕ, ∫ ω : sphere (0 : Euclidean d) 1, F (n + m) ω ∂unitSurfaceMeasure d :=
      htail_eq
