    (hC : 0 ≤ C) (hmC : ∀ ξ, ‖m ξ‖ ≤ C)
    (f : Lp ℂ 2 (volume : Measure E)) :
    ‖𝓕⁻ (((memLp_top_of_bound hm C (Filter.Eventually.of_forall hmC)).toLp m :
      Lp ℂ ⊤ (volume : Measure E)) • (𝓕 f : Lp ℂ 2 (volume : Measure E)) :
