  let a : ℝ := ((2 : ℝ) ^ j)⁻¹
  have ha : 0 < a := by
    dsimp [a]
    exact inv_pos.mpr (pow_pos (by norm_num) _)
  have hfixed (r : Set.Ioi (0 : ℝ)) :
      ‖𝓕⁻ (fun ξ : Euclidean d => surfaceFourier d (-r.1 • ξ) *
        ψ (a • (r.1 • ξ)) * 𝓕 (f : Euclidean d → ℂ) ξ) x‖ ≤
