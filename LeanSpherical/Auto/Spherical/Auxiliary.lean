    · exact le_iSup (fun r : Icc a b => ENNReal.ofReal (‖F r.1 x‖ ^ 2)) ⟨r₀, hr₀⟩
  rw [hsup, hsup_sq, ENNReal.toReal_ofReal (norm_nonneg _),
