      (fun ω : sphere (0 : Euclidean d) 1 => ∑' n : ℕ, F n ω)
      (unitSurfaceMeasure d) :=
    hmajor_integrable.mono' htsum_measurable
      (Filter.Eventually.of_forall htsum_norm_le_major)
  have htsum_integral :
      (∫ ω : sphere (0 : Euclidean d) 1, ∑' n : ℕ, F n ω ∂unitSurfaceMeasure d) =
        ∑' n : ℕ, ∫ ω : sphere (0 : Euclidean d) 1, F n ω ∂unitSurfaceMeasure d := by
    exact (MeasureTheory.integral_tsum_of_summable_integral_norm
      hF_integrable hF_summable_integral_norm).symm
  have hF_summable_integral : Summable fun n : ℕ =>
      ∫ ω : sphere (0 : Euclidean d) 1, F n ω ∂unitSurfaceMeasure d := by
    refine Summable.of_nonneg_of_le
      (f := fun n : ℕ => B * D * L * (2 : ℝ) ^ (d - 1) * s ^ n)
