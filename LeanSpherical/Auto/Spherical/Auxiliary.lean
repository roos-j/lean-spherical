    SchwartzMap.smulLeftCLM ℂ (m : E → ℂ) g
  have hh : (h : E → ℂ) = fun ξ : E => m ξ * g ξ := by
    funext ξ
    simp only [h, SchwartzMap.smulLeftCLM_apply m.hasTemperateGrowth, smul_eq_mul]
  have hinv : ((𝓕⁻ h : SchwartzMap E ℂ) : E → ℂ) =
