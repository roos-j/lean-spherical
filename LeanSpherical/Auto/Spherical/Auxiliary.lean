    _ = (2 * (B * D * (2 : ℝ) ^ (d - 1))) * L * s ^ m := by ring
    _ ≤ C * L * s ^ m := by
      apply mul_le_mul_of_nonneg_right
      · apply mul_le_mul_of_nonneg_right
        · dsimp [C]
