  have hs_norm_lt_one : ‖s‖ < 1 := by
    rw [Real.norm_eq_abs, abs_of_nonneg hs_nonneg]
    exact hs_le_half.trans_lt (by norm_num)
  have hgeom_s : Summable fun n : ℕ => s ^ n :=
    summable_geometric_of_norm_lt_one hs_norm_lt_one
