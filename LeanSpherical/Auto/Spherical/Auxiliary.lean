    · have htwo : 2 ≤ ‖L • (z - (ω : Euclidean d))‖ := le_of_not_gt hω
      obtain ⟨n, hnlow, hnup⟩ := exists_dyadic_annulus htwo
      have hmem : ω ∈ S n := hS_of_scaled_norm_lt n ω hnup
      have hterm : L ^ d * ‖K (L • (z - (ω : Euclidean d)))‖ ≤ F n ω := by
        calc
          L ^ d * ‖K (L • (z - (ω : Euclidean d)))‖ ≤
