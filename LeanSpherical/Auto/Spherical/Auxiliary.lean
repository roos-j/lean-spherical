      surfaceMass d ^ 2 * ∫ x : Euclidean d, ‖fderiv ℝ f x‖ ^ 2 := by
  have hfderiv_cont : Continuous (fderiv ℝ f) :=
    hf.continuous_fderiv (by norm_num)
