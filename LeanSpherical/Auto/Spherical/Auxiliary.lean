    ‖∫ x, g x ∂μ‖ ^ 2 ≤ (∫ x, ‖g x‖ ∂μ) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) hnorm_nonneg).2 hnorm
    _ ≤ (√(∫ x, ‖g x‖ ^ 2 ∂μ) * √(μ.real univ)) ^ 2 :=
      (sq_le_sq₀ hnorm_nonneg (mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _))).2
