    rw [Real.norm_eq_abs, abs_of_nonneg hq_nonneg]
    exact hq_lt_one
  have hgeom : Summable fun n : ℕ => q ^ n :=
    summable_geometric_of_norm_lt_one hq_norm_lt_one
  have hs_nonneg : 0 ≤ s := by
    dsimp [s]
    positivity
  have hs_le_half : s ≤ 1 / 2 := by
    dsimp [s]
    rw [show d + 3 = 1 + (d + 2) by omega, pow_add]
