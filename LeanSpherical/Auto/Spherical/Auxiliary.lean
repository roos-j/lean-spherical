    rw [integral_indicator_one (hSmeas n)]
    simp only [Measure.real]
  have hradius_nonneg (n : ℕ) : 0 ≤ (2 : ℝ) ^ (n + 1) / L := by
    exact div_nonneg (pow_nonneg (by norm_num) _) hLpos.le
  have hF_integral_bound (n : ℕ) :
      (∫ ω : sphere (0 : Euclidean d) 1, F n ω ∂unitSurfaceMeasure d) ≤
        B * D * L * (2 : ℝ) ^ (d - 1) * s ^ n := by
    rw [hF_integral]
    calc
      (B * L ^ d * q ^ n) * ((unitSurfaceMeasure d) (S n)).toReal ≤
          (B * L ^ d * q ^ n) *
            (D * (((2 : ℝ) ^ (n + 1) / L) ^ (d - 1))) :=
        mul_le_mul_of_nonneg_left (by
          simpa only [S] using hcap z ((2 : ℝ) ^ (n + 1) / L) (hradius_nonneg n))
