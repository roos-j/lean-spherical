        Summable.tsum_le_tsum (fun n => hF_integral_bound n) hF_summable_integral hG_summable
      _ = (B * A * (2 : ℝ) ^ (2 * d)) * ∑' n : ℕ, (1 / 4 : ℝ) ^ n := by
        rw [tsum_mul_left]
      _ = (B * A * (2 : ℝ) ^ (2 * d)) * (4 / 3) := by rw [hquarter_sum]
      _ ≤ (B * A * (2 : ℝ) ^ (2 * d)) * 2 :=
        mul_le_mul_of_nonneg_left (by norm_num) hcoef_nonneg
      _ = 2 * (B * A * (2 : ℝ) ^ (2 * d)) := by ring
  have hkcontinuous : Continuous k := by
    dsimp [k]
    have hinner : Continuous (fun y : Euclidean d => (r⁻¹ : ℝ) • y) :=
      (continuous_const : Continuous fun _ : Euclidean d => (r⁻¹ : ℝ)).smul continuous_id
    exact continuous_const.mul (K.continuous.comp hinner)
  have hproduct_continuous : Continuous (fun y : Euclidean d =>
      ‖k (x - y)‖ * ‖f y‖) :=
    ((hkcontinuous.comp
      ((continuous_const : Continuous fun _ : Euclidean d => x).sub continuous_id)).norm).mul
        f.continuous.norm
  have hproduct_integrable : Integrable (fun y : Euclidean d =>
      ‖k (x - y)‖ * ‖f y‖) volume :=
    htsum_integrable.mono' hproduct_continuous.aestronglyMeasurable
      (Filter.Eventually.of_forall fun y => by
        rw [Real.norm_of_nonneg (mul_nonneg (norm_nonneg _) (norm_nonneg _))]
        exact hpointwise y)
  change ‖(k ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] (f : Euclidean d → ℂ)) x‖ ≤
    2 * (B * A * (2 : ℝ) ^ (2 * d))
  rw [convolution_mul_swap]
  calc
    ‖∫ y : Euclidean d, k (x - y) * f y‖ ≤
        ∫ y : Euclidean d, ‖k (x - y) * f y‖ :=
      norm_integral_le_integral_norm _
    _ = ∫ y : Euclidean d, ‖k (x - y)‖ * ‖f y‖ := by
      apply integral_congr_ae
      filter_upwards with y
      rw [norm_mul]
    _ ≤ ∫ y : Euclidean d, ∑' n : ℕ, F n y :=
      integral_mono hproduct_integrable htsum_integrable hpointwise
    _ = ∑' n : ℕ, ∫ y : Euclidean d, F n y := htsum_integral
    _ ≤ 2 * (B * A * (2 : ℝ) ^ (2 * d)) := hsum_integrals_bound

private theorem scaled_schwartz_convolution_under_dilation
    {d : Nat} (K f : SchwartzMap (Euclidean d) ℂ) {a s : ℝ}
    (ha : 0 < a) (x : Euclidean d) :
    ((fun y : Euclidean d => ((a * s)⁻¹) ^ d • K ((a * s)⁻¹ • y))
        ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] (f : Euclidean d → ℂ)) x =
      ((fun y : Euclidean d => (s⁻¹) ^ d • K (s⁻¹ • y))
        ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] (fun y => f (a • y))) (a⁻¹ • x) := by
  rw [convolution_mul_swap, convolution_mul_swap]
  let h : Euclidean d → ℂ := fun y =>
    (s⁻¹) ^ d • K (s⁻¹ • (a⁻¹ • x - a⁻¹ • y)) * f y
  have hchange :=
    Measure.integral_comp_smul_of_nonneg volume h a (hR := ha.le)
  change (∫ y : Euclidean d, ((a * s)⁻¹) ^ d • K ((a * s)⁻¹ • (x - y)) * f y) =
    ∫ y : Euclidean d, (s⁻¹) ^ d • K (s⁻¹ • (a⁻¹ • x - y)) * f (a • y)
  rw [show (fun y : Euclidean d =>
      (s⁻¹) ^ d • K (s⁻¹ • (a⁻¹ • x - y)) * f (a • y)) =
      fun y => h (a • y) by
        funext y
        dsimp [h]
        simp [smul_sub, ha.ne'], hchange]
  simp only [finrank_euclideanSpace_fin]
  rw [← MeasureTheory.integral_smul]
  apply integral_congr_ae
  filter_upwards with y
  dsimp [h]
  have harg : (a * s)⁻¹ • (x - y) = s⁻¹ • (a⁻¹ • x - a⁻¹ • y) := by
    rw [← smul_sub, mul_inv_rev, smul_smul]
  rw [harg, mul_inv_rev, mul_pow]
  push_cast
  ring

private theorem dyadic_ball_growth_under_dilation
    {d : Nat} (f : SchwartzMap (Euclidean d) ℂ) {A : ℝ} (x : Euclidean d)
    (k : ℤ) (hA : ∀ m : ℤ,
      (∫ y in Metric.ball x ((2 : ℝ) ^ m), ‖f y‖) ≤ A * ((2 : ℝ) ^ m) ^ d) :
    ∀ n : ℕ,
      (∫ y in Metric.ball (((2 : ℝ) ^ k)⁻¹ • x) ((2 : ℝ) ^ n),
        ‖f ((2 : ℝ) ^ k • y)‖) ≤ A * (2 : ℝ) ^ (n * d) := by
  let a : ℝ := (2 : ℝ) ^ k
  have ha : 0 < a := by
    dsimp [a]
    exact zpow_pos (by norm_num) _
  have ha0 : a ≠ 0 := ha.ne'
  have hrad (n : ℕ) : a * (2 : ℝ) ^ n = (2 : ℝ) ^ (k + (n : ℤ)) := by
    dsimp [a]
    simpa using (zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0) k (n : ℤ)).symm
  intro n
  have hball : a • Metric.ball (a⁻¹ • x) ((2 : ℝ) ^ n) =
      Metric.ball x (a * (2 : ℝ) ^ n) := by
    rw [_root_.smul_ball ha0]
    simp [Real.norm_eq_abs, abs_of_pos ha, ha0]
  rw [Measure.setIntegral_comp_smul_of_pos volume (fun y : Euclidean d => ‖f y‖)
    (Metric.ball (a⁻¹ • x) ((2 : ℝ) ^ n)) ha]
  simp only [finrank_euclideanSpace_fin]
  rw [hball]
  have hAn := hA (k + (n : ℤ))
  rw [← hrad n] at hAn
  calc
    (a ^ d)⁻¹ • (∫ y in Metric.ball x (a * (2 : ℝ) ^ n), ‖f y‖) ≤
        (a ^ d)⁻¹ • (A * (a * (2 : ℝ) ^ n) ^ d) :=
      by
        simpa [smul_eq_mul] using
          (mul_le_mul_of_nonneg_left hAn (inv_nonneg.mpr (pow_nonneg ha.le _)))
    _ = A * (2 : ℝ) ^ (n * d) := by
      have hcancel' : a ^ d * (a ^ d)⁻¹ = 1 :=
        mul_inv_cancel₀ (pow_ne_zero d ha0)
      rw [mul_pow, ← inv_pow]
      calc
        a⁻¹ ^ d * (A * (a ^ d * ((2 : ℝ) ^ n) ^ d)) =
            A * (a ^ d * a⁻¹ ^ d) * ((2 : ℝ) ^ n) ^ d := by ring
        _ = A * ((2 : ℝ) ^ n) ^ d := by simp [hcancel']
        _ = A * (2 : ℝ) ^ (n * d) := by rw [pow_mul]

/-- A Schwartz convolution at any positive physical scale is controlled by
centered dyadic-ball growth.  The proof factors the scale into a dyadic
dilation and a factor in `[1, 2]`, then invokes the literal annular estimate
above. -/
theorem norm_scaled_schwartz_convolution_le_dyadic_ball
    {d : Nat} (K f : SchwartzMap (Euclidean d) ℂ)
    {r A : ℝ} (hr : 0 < r) (x : Euclidean d)
    (hA : ∀ m : ℤ,
      (∫ y in Metric.ball x ((2 : ℝ) ^ m), ‖f y‖) ≤
        A * ((2 : ℝ) ^ m) ^ d) :
    ‖((fun y : Euclidean d => (r⁻¹) ^ d • K (r⁻¹ • y))
        ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] (f : Euclidean d → ℂ)) x‖ ≤
      2 * ((SchwartzMap.seminorm ℂ 0 0 K +
        SchwartzMap.seminorm ℂ (d + 2) 0 K) * A * (2 : ℝ) ^ (2 * d)) := by
  obtain ⟨k, hk⟩ := exists_mem_Ico_zpow hr (by norm_num : (1 : ℝ) < 2)
  let a : ℝ := (2 : ℝ) ^ k
  let s : ℝ := r / a
  have ha : 0 < a := by
    dsimp [a]
    exact zpow_pos (by norm_num) _
  have ha0 : a ≠ 0 := ha.ne'
  have has : a * s = r := by
    dsimp [s]
    field_simp [ha0]
  have hnext : (2 : ℝ) ^ (k + 1) = 2 * a := by
    dsimp [a]
    rw [zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_one]
    ring
  have hs : s ∈ Set.Icc (1 : ℝ) 2 := by
    constructor
    · dsimp [s]
      apply (le_div_iff₀ ha).2
      simpa [a] using hk.1
    · dsimp [s]
      apply (div_le_iff₀ ha).2
      calc
        r ≤ (2 : ℝ) ^ (k + 1) := hk.2.le
        _ = 2 * a := hnext
  let D : Euclidean d ≃L[ℝ] Euclidean d :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 a ha0)
  let g : SchwartzMap (Euclidean d) ℂ :=
    (SchwartzMap.compCLMOfContinuousLinearEquiv ℂ D) f
  have hg (y : Euclidean d) : g y = f (a • y) := by
    change f (D y) = f (a • y)
    simp [D]
  have hgfun : (g : Euclidean d → ℂ) = fun y => f (a • y) := by
    funext y
    exact hg y
  have hAg : ∀ n : ℕ,
      (∫ y in Metric.ball (a⁻¹ • x) ((2 : ℝ) ^ n), ‖g y‖) ≤
        A * (2 : ℝ) ^ (n * d) := by
    intro n
    simpa only [hg] using
      dyadic_ball_growth_under_dilation f x k hA n
  have hlocal := norm_relative_scaled_schwartz_convolution_le_dyadic_ball K g hs
    (a⁻¹ • x) hAg
  have hconvolution :
      ((fun y : Euclidean d => (r⁻¹) ^ d • K (r⁻¹ • y))
          ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] (f : Euclidean d → ℂ)) x =
        ((fun y : Euclidean d => (s⁻¹) ^ d • K (s⁻¹ • y))
          ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] (g : Euclidean d → ℂ))
          (a⁻¹ • x) := by
    rw [← has, hgfun]
    exact scaled_schwartz_convolution_under_dilation (a := a) (s := s) K f ha x
  rw [hconvolution]
  exact hlocal

/-- A literal normalized dyadic-ball supremum controls each corresponding
real ball integral.  Finiteness of the supremum is proved from the zeroth
Schwartz seminorm before taking `ENNReal.toReal`. -/
theorem dyadic_ball_integral_le_dyadic_average_sup
    {d : Nat} (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) (m : ℤ) :
    (∫ y in Metric.ball x ((2 : ℝ) ^ m), ‖f y‖) ≤
      (⨆ n : ℤ,
        ((volume (Metric.ball x ((2 : ℝ) ^ n)))⁻¹ *
          ∫⁻ y in Metric.ball x ((2 : ℝ) ^ n), ENNReal.ofReal ‖f y‖)).toReal *
        (volume (Metric.ball x ((2 : ℝ) ^ m))).toReal := by
  let C : ℝ := SchwartzMap.seminorm ℂ 0 0 f
  let S : ENNReal := ⨆ n : ℤ,
    ((volume (Metric.ball x ((2 : ℝ) ^ n)))⁻¹ *
      ∫⁻ y in Metric.ball x ((2 : ℝ) ^ n), ENNReal.ofReal ‖f y‖)
  have hC (y : Euclidean d) : ‖f y‖ ≤ C := by
    dsimp [C]
    exact SchwartzMap.norm_le_seminorm ℂ f y
  have hSle : S ≤ ENNReal.ofReal C := by
    dsimp [S]
    apply iSup_le
    intro n
    let r : ℝ := (2 : ℝ) ^ n
    have hr : 0 < r := by
      dsimp [r]
      exact zpow_pos (by norm_num) _
    have hvolpos : 0 < volume (Metric.ball x r) :=
      Metric.measure_ball_pos volume x hr
    have hvoltop : volume (Metric.ball x r) ≠ (⊤ : ENNReal) :=
      measure_ball_lt_top.ne
    have hlin :
        (∫⁻ y in Metric.ball x r, ENNReal.ofReal ‖f y‖) ≤
          ENNReal.ofReal C * volume (Metric.ball x r) := by
      calc
        (∫⁻ y in Metric.ball x r, ENNReal.ofReal ‖f y‖) ≤
            ∫⁻ _y in Metric.ball x r, ENNReal.ofReal C := by
              apply lintegral_mono
              intro y
              exact ENNReal.ofReal_le_ofReal (hC y)
        _ = ENNReal.ofReal C * volume (Metric.ball x r) := by
          rw [lintegral_const]
          simp
    change (volume (Metric.ball x r))⁻¹ *
      (∫⁻ y in Metric.ball x r, ENNReal.ofReal ‖f y‖) ≤ ENNReal.ofReal C
    calc
      (volume (Metric.ball x r))⁻¹ *
          (∫⁻ y in Metric.ball x r, ENNReal.ofReal ‖f y‖) ≤
          (volume (Metric.ball x r))⁻¹ *
            (ENNReal.ofReal C * volume (Metric.ball x r)) :=
        mul_le_mul_right hlin _
      _ = ENNReal.ofReal C := by
        calc
          (volume (Metric.ball x r))⁻¹ *
              (ENNReal.ofReal C * volume (Metric.ball x r)) =
              ENNReal.ofReal C *
                ((volume (Metric.ball x r))⁻¹ * volume (Metric.ball x r)) := by
                  ac_rfl
          _ = ENNReal.ofReal C := by
            rw [ENNReal.inv_mul_cancel hvolpos.ne' hvoltop]
            simp
  have hSfin : S ≠ ⊤ := ne_top_of_le_ne_top ENNReal.ofReal_ne_top hSle
  let r : ℝ := (2 : ℝ) ^ m
  have hr : 0 < r := by
    dsimp [r]
    exact zpow_pos (by norm_num) _
  have hvolpos : 0 < volume (Metric.ball x r) :=
    Metric.measure_ball_pos volume x hr
  have hvoltop : volume (Metric.ball x r) ≠ (⊤ : ENNReal) :=
    measure_ball_lt_top.ne
  have havg :
      (volume (Metric.ball x r))⁻¹ *
        (∫⁻ y in Metric.ball x r, ENNReal.ofReal ‖f y‖) ≤ S := by
    dsimp [S]
    exact le_iSup (fun n : ℤ =>
      (volume (Metric.ball x ((2 : ℝ) ^ n)))⁻¹ *
        ∫⁻ y in Metric.ball x ((2 : ℝ) ^ n), ENNReal.ofReal ‖f y‖) m
  have hlin :
      (∫⁻ y in Metric.ball x r, ENNReal.ofReal ‖f y‖) ≤
        S * volume (Metric.ball x r) := by
    calc
      (∫⁻ y in Metric.ball x r, ENNReal.ofReal ‖f y‖) =
          ((volume (Metric.ball x r))⁻¹ *
            (∫⁻ y in Metric.ball x r, ENNReal.ofReal ‖f y‖)) *
              volume (Metric.ball x r) := by
            calc
              (∫⁻ y in Metric.ball x r, ENNReal.ofReal ‖f y‖) =
                  1 * (∫⁻ y in Metric.ball x r, ENNReal.ofReal ‖f y‖) := by rw [one_mul]
              _ = ((volume (Metric.ball x r))⁻¹ * volume (Metric.ball x r)) *
                  (∫⁻ y in Metric.ball x r, ENNReal.ofReal ‖f y‖) := by
                    rw [ENNReal.inv_mul_cancel hvolpos.ne' hvoltop]
              _ = ((volume (Metric.ball x r))⁻¹ *
                  (∫⁻ y in Metric.ball x r, ENNReal.ofReal ‖f y‖)) *
                    volume (Metric.ball x r) := by ac_rfl
      _ ≤ S * volume (Metric.ball x r) := by
        calc
          ((volume (Metric.ball x r))⁻¹ *
              (∫⁻ y in Metric.ball x r, ENNReal.ofReal ‖f y‖)) *
                volume (Metric.ball x r) =
              volume (Metric.ball x r) *
                ((volume (Metric.ball x r))⁻¹ *
                  (∫⁻ y in Metric.ball x r, ENNReal.ofReal ‖f y‖)) := by ac_rfl
          _ ≤ volume (Metric.ball x r) * S := mul_le_mul_right havg _
          _ = S * volume (Metric.ball x r) := by ac_rfl
  have hlinfin :
      (∫⁻ y in Metric.ball x r, ENNReal.ofReal ‖f y‖) ≠ ⊤ :=
    (f.integrable.norm.integrableOn.lintegral_lt_top).ne
  have hreal :
      (∫ y in Metric.ball x r, ‖f y‖) =
        (∫⁻ y in Metric.ball x r, ENNReal.ofReal ‖f y‖).toReal := by
    have hnonneg : 0 ≤ ∫ y in Metric.ball x r, ‖f y‖ :=
      integral_nonneg fun y => norm_nonneg (f y)
    rw [← ENNReal.toReal_ofReal hnonneg,
      MeasureTheory.ofReal_integral_eq_lintegral_ofReal
        f.integrable.norm.integrableOn
        (Filter.Eventually.of_forall fun y => norm_nonneg (f y))]
  change (∫ y in Metric.ball x r, ‖f y‖) ≤
    S.toReal * (volume (Metric.ball x r)).toReal
  calc
    (∫ y in Metric.ball x r, ‖f y‖) =
        (∫⁻ y in Metric.ball x r, ENNReal.ofReal ‖f y‖).toReal := hreal
    _ ≤ (S * volume (Metric.ball x r)).toReal :=
      (ENNReal.toReal_le_toReal hlinfin (ENNReal.mul_ne_top hSfin hvoltop)).2 hlin
    _ = S.toReal * (volume (Metric.ball x r)).toReal := ENNReal.toReal_mul

/-- The preceding literal dyadic average bound, with the Euclidean ball
volume written as its exact radius-to-the-`d` scaling law. -/
theorem dyadic_ball_integral_le_dyadic_average_sup_growth
    {d : Nat} (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) (m : ℤ) :
    (∫ y in Metric.ball x ((2 : ℝ) ^ m), ‖f y‖) ≤
      ((⨆ n : ℤ,
        ((volume (Metric.ball x ((2 : ℝ) ^ n)))⁻¹ *
          ∫⁻ y in Metric.ball x ((2 : ℝ) ^ n), ENNReal.ofReal ‖f y‖)).toReal *
        (volume (Metric.ball (0 : Euclidean d) 1)).toReal) *
          ((2 : ℝ) ^ m) ^ d := by
  let r : ℝ := (2 : ℝ) ^ m
  have hr : 0 < r := by
    dsimp [r]
    exact zpow_pos (by norm_num) _
  have hvol : volume (Metric.ball x r) =
      ENNReal.ofReal (r ^ d) * volume (Metric.ball (0 : Euclidean d) 1) := by
    rw [Measure.addHaar_ball_of_pos volume x hr]
    simp only [finrank_euclideanSpace_fin]
  have hbase := dyadic_ball_integral_le_dyadic_average_sup f x m
  change (∫ y in Metric.ball x r, ‖f y‖) ≤
    ((⨆ n : ℤ,
      ((volume (Metric.ball x ((2 : ℝ) ^ n)))⁻¹ *
        ∫⁻ y in Metric.ball x ((2 : ℝ) ^ n), ENNReal.ofReal ‖f y‖)).toReal *
      (volume (Metric.ball (0 : Euclidean d) 1)).toReal) * r ^ d
  calc
    (∫ y in Metric.ball x r, ‖f y‖) ≤
        (⨆ n : ℤ,
          ((volume (Metric.ball x ((2 : ℝ) ^ n)))⁻¹ *
            ∫⁻ y in Metric.ball x ((2 : ℝ) ^ n), ENNReal.ofReal ‖f y‖)).toReal *
          (volume (Metric.ball x r)).toReal := hbase
    _ = ((⨆ n : ℤ,
          ((volume (Metric.ball x ((2 : ℝ) ^ n)))⁻¹ *
            ∫⁻ y in Metric.ball x ((2 : ℝ) ^ n), ENNReal.ofReal ‖f y‖)).toReal *
          (volume (Metric.ball (0 : Euclidean d) 1)).toReal) * r ^ d := by
      rw [hvol, ENNReal.toReal_mul,
        ENNReal.toReal_ofReal (pow_nonneg hr.le _)]
      ring

/-- The literal dyadic-ball supremum also controls a ball of an arbitrary
positive radius.  Passing to the next dyadic radius costs only the factor
`2 ^ d`; this form is convenient for the physical high-frequency annuli. -/
theorem ball_integral_le_dyadic_average_sup_any_radius
    {d : Nat} (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d)
    {R : ℝ} (hR : 0 < R) :
    (∫ y in Metric.ball x R, ‖f y‖) ≤
      ((⨆ n : ℤ,
        ((volume (Metric.ball x ((2 : ℝ) ^ n)))⁻¹ *
          ∫⁻ y in Metric.ball x ((2 : ℝ) ^ n), ENNReal.ofReal ‖f y‖)).toReal *
        (volume (Metric.ball (0 : Euclidean d) 1)).toReal) *
          (2 * R) ^ d := by
  obtain ⟨m, hm⟩ := exists_mem_Ico_zpow hR (by norm_num : (1 : ℝ) < 2)
  have hsubset : Metric.ball x R ⊆ Metric.ball x ((2 : ℝ) ^ (m + 1)) :=
    Metric.ball_subset_ball hm.2.le
  have hmono :
      (∫ y in Metric.ball x R, ‖f y‖) ≤
        ∫ y in Metric.ball x ((2 : ℝ) ^ (m + 1)), ‖f y‖ := by
    apply MeasureTheory.setIntegral_mono_set f.integrable.norm.integrableOn
    · exact Filter.Eventually.of_forall fun y => norm_nonneg _
    · exact Filter.Eventually.of_forall hsubset
  have hrad : (2 : ℝ) ^ (m + 1) ≤ 2 * R := by
    calc
      (2 : ℝ) ^ (m + 1) = (2 : ℝ) ^ m * (2 : ℝ) ^ (1 : ℤ) :=
        zpow_add₀ (by norm_num) m 1
      _ = 2 * (2 : ℝ) ^ m := by norm_num; ring
      _ ≤ 2 * R := mul_le_mul_of_nonneg_left hm.1 (by norm_num)
  have hradpow : ((2 : ℝ) ^ (m + 1)) ^ d ≤ (2 * R) ^ d :=
    pow_le_pow_left₀ (le_of_lt (zpow_pos (by norm_num) _)) hrad d
  have hfactor_nonneg : 0 ≤
      ((⨆ n : ℤ,
        ((volume (Metric.ball x ((2 : ℝ) ^ n)))⁻¹ *
          ∫⁻ y in Metric.ball x ((2 : ℝ) ^ n), ENNReal.ofReal ‖f y‖)).toReal *
        (volume (Metric.ball (0 : Euclidean d) 1)).toReal) := by
    positivity
  calc
    (∫ y in Metric.ball x R, ‖f y‖) ≤
        ∫ y in Metric.ball x ((2 : ℝ) ^ (m + 1)), ‖f y‖ := hmono
    _ ≤ ((⨆ n : ℤ,
          ((volume (Metric.ball x ((2 : ℝ) ^ n)))⁻¹ *
            ∫⁻ y in Metric.ball x ((2 : ℝ) ^ n), ENNReal.ofReal ‖f y‖)).toReal *
          (volume (Metric.ball (0 : Euclidean d) 1)).toReal) *
            ((2 : ℝ) ^ (m + 1)) ^ d :=
      dyadic_ball_integral_le_dyadic_average_sup_growth f x (m + 1)
    _ ≤ _ := mul_le_mul_of_nonneg_left hradpow hfactor_nonneg

private theorem shell_tail_coefficient
    (A r : ℝ) (n d : ℕ) (hr : 0 < r) :
    (A * (r⁻¹) ^ d * (((2 : ℝ)⁻¹) ^ (d + 3)) ^ n) *
        (2 * ((2 : ℝ) ^ (n + 2) * r)) ^ d =
      A * (2 : ℝ) ^ (3 * d) * (1 / 8 : ℝ) ^ n := by
  have hr0 : r ≠ 0 := hr.ne'
  rw [show 2 * ((2 : ℝ) ^ (n + 2) * r) =
      (2 : ℝ) ^ (n + 3) * r by
        rw [show n + 3 = (n + 2) + 1 by omega, pow_succ]
        ring]
  rw [mul_pow]
  rw [show (((2 : ℝ)⁻¹) ^ (d + 3)) ^ n =
      ((2 : ℝ)⁻¹) ^ ((d + 3) * n) by rw [pow_mul]]
  rw [show ((2 : ℝ)⁻¹) ^ ((d + 3) * n) =
      ((2 : ℝ) ^ ((d + 3) * n))⁻¹ by rw [inv_pow]]
  rw [show (1 / 8 : ℝ) = ((2 : ℝ)⁻¹) ^ 3 by norm_num]
  rw [← pow_mul, inv_pow]
  rw [Nat.add_mul, Nat.add_mul]
  rw [Nat.mul_comm d n]
  rw [show (((2 : ℝ)⁻¹) ^ 3) ^ n =
      ((2 : ℝ)⁻¹) ^ (3 * n) by rw [pow_mul]]
  rw [show ((2 : ℝ)⁻¹) ^ (3 * n) =
      ((2 : ℝ) ^ (3 * n))⁻¹ by rw [inv_pow]]
  field_simp
  ring

/-- The spatial annulus summation behind the high-frequency endpoint.  A
nonnegative kernel with the unit-shell estimate supplied by the preceding
surface argument is controlled directly by the literal dyadic-ball maximal
quantity. -/
theorem shell_weighted_integral_le_dyadic_average_sup
    {d : Nat} (f : SchwartzMap (Euclidean d) ℂ) (W : Euclidean d → ℝ)
    {C L r : ℝ} (hC : 0 ≤ C) (hL : 1 ≤ L) (hr : 0 < r)
    (hW_nonneg : ∀ z, 0 ≤ W z)
    (hW_near : ∀ z, W z ≤ C * L)
    (hW_tail : ∀ (z : Euclidean d) (m : ℕ),
      (2 : ℝ) ^ m / L ≤ |‖z‖ - 1| →
        W z ≤ C * L * (((2 : ℝ)⁻¹) ^ (d + 3)) ^ m)
    (x : Euclidean d) :
    (∫ y : Euclidean d, ‖f y‖ *
      ((r⁻¹) ^ d * W (r⁻¹ • (y - x)))) ≤
      2 * (((C * L) *
        ((⨆ n : ℤ,
          ((volume (Metric.ball x ((2 : ℝ) ^ n)))⁻¹ *
            ∫⁻ y in Metric.ball x ((2 : ℝ) ^ n), ENNReal.ofReal ‖f y‖)).toReal *
          (volume (Metric.ball (0 : Euclidean d) 1)).toReal)) *
          (2 : ℝ) ^ (3 * d)) := by
  let q : ℝ := ((2 : ℝ)⁻¹) ^ (d + 3)
  let A : ℝ := C * L
  let M : ℝ :=
    ((⨆ n : ℤ,
      ((volume (Metric.ball x ((2 : ℝ) ^ n)))⁻¹ *
        ∫⁻ y in Metric.ball x ((2 : ℝ) ^ n), ENNReal.ofReal ‖f y‖)).toReal *
      (volume (Metric.ball (0 : Euclidean d) 1)).toReal)
  have hL_nonneg : 0 ≤ L := le_trans zero_le_one hL
  have hA : 0 ≤ A := mul_nonneg hC hL_nonneg
  have hM : 0 ≤ M := by
    dsimp [M]
    positivity
  have hrinv_nonneg : 0 ≤ r⁻¹ := inv_nonneg.mpr hr.le
  have hrpow_nonneg : 0 ≤ (r⁻¹) ^ d := pow_nonneg hrinv_nonneg _
  have hq_nonneg : 0 ≤ q := by
    dsimp [q]
    positivity
  have hq_lt_one : q < 1 := by
    dsimp [q]
    apply pow_lt_one₀ (inv_nonneg.mpr (by norm_num : (0 : ℝ) ≤ 2))
      ((inv_lt_one₀ (by norm_num : (0 : ℝ) < 2)).2 (by norm_num))
    omega
  have hq_norm_lt_one : ‖q‖ < 1 := by
    rw [Real.norm_eq_abs, abs_of_nonneg hq_nonneg]
    exact hq_lt_one
  have hgeom : Summable fun n : ℕ => q ^ n :=
    summable_geometric_of_norm_lt_one hq_norm_lt_one
  let F : ℕ → Euclidean d → ℝ := fun n y =>
    (A * (r⁻¹) ^ d * q ^ n) *
      (Metric.ball x ((2 : ℝ) ^ (n + 2) * r)).indicator (fun z => ‖f z‖) y
  have hF_nonneg (n : ℕ) (y : Euclidean d) : 0 ≤ F n y := by
    dsimp [F]
    apply mul_nonneg
    · exact mul_nonneg (mul_nonneg hA hrpow_nonneg) (pow_nonneg hq_nonneg _)
    · apply Set.indicator_nonneg
      intro z _
      exact norm_nonneg _
  have hF_le_major (n : ℕ) (y : Euclidean d) :
      F n y ≤ (A * (r⁻¹) ^ d * ‖f y‖) * q ^ n := by
    dsimp [F]
    have hind :
        (Metric.ball x ((2 : ℝ) ^ (n + 2) * r)).indicator (fun z => ‖f z‖) y ≤
          ‖f y‖ := by
      by_cases hy : y ∈ Metric.ball x ((2 : ℝ) ^ (n + 2) * r)
      · simp [hy]
      · simp [hy, norm_nonneg]
    calc
      (A * (r⁻¹) ^ d * q ^ n) *
          (Metric.ball x ((2 : ℝ) ^ (n + 2) * r)).indicator (fun z => ‖f z‖) y ≤
          (A * (r⁻¹) ^ d * q ^ n) * ‖f y‖ :=
        mul_le_mul_of_nonneg_left hind
          (mul_nonneg (mul_nonneg hA hrpow_nonneg) (pow_nonneg hq_nonneg _))
      _ = (A * (r⁻¹) ^ d * ‖f y‖) * q ^ n := by ring
  have hF_pointwise_summable (y : Euclidean d) : Summable fun n : ℕ => F n y := by
    refine Summable.of_nonneg_of_le
      (f := fun n : ℕ => (A * (r⁻¹) ^ d * ‖f y‖) * q ^ n)
      (g := fun n : ℕ => F n y) ?_ ?_ ?_
    · intro n
      exact hF_nonneg n y
    · intro n
      exact hF_le_major n y
    · simpa [mul_assoc] using hgeom.mul_left (A * (r⁻¹) ^ d * ‖f y‖)
  have hball_of_scaled_norm_lt (n : ℕ) (y : Euclidean d)
      (hy : ‖r⁻¹ • (y - x)‖ < (2 : ℝ) ^ (n + 2)) :
      y ∈ Metric.ball x ((2 : ℝ) ^ (n + 2) * r) := by
    rw [Metric.mem_ball, dist_eq_norm_sub]
    have hnorm : ‖y - x‖ = r * ‖r⁻¹ • (y - x)‖ := by
      rw [norm_smul_of_nonneg hrinv_nonneg]
      field_simp [hr.ne']
    calc
      ‖y - x‖ = r * ‖r⁻¹ • (y - x)‖ := hnorm
      _ < r * (2 : ℝ) ^ (n + 2) := mul_lt_mul_of_pos_left hy hr
      _ = (2 : ℝ) ^ (n + 2) * r := by ring
  have hpointwise (y : Euclidean d) :
      ‖f y‖ * ((r⁻¹) ^ d * W (r⁻¹ • (y - x))) ≤ ∑' n : ℕ, F n y := by
    have hsum := hF_pointwise_summable y
    by_cases hy : ‖r⁻¹ • (y - x)‖ < 2
    · have hyball : y ∈ Metric.ball x ((2 : ℝ) ^ (0 + 2) * r) := by
        apply hball_of_scaled_norm_lt 0 y
        calc
          ‖r⁻¹ • (y - x)‖ < 2 := hy
          _ < (2 : ℝ) ^ (0 + 2) := by norm_num
      have hterm :
          ‖f y‖ * ((r⁻¹) ^ d * W (r⁻¹ • (y - x))) ≤ F 0 y := by
        have hW := hW_near (r⁻¹ • (y - x))
        calc
          ‖f y‖ * ((r⁻¹) ^ d * W (r⁻¹ • (y - x))) ≤
              ‖f y‖ * ((r⁻¹) ^ d * A) := by
            apply mul_le_mul_of_nonneg_left
            · exact mul_le_mul_of_nonneg_left hW hrpow_nonneg
            · exact norm_nonneg _
          _ = F 0 y := by
            dsimp [F, q]
            rw [Set.indicator_of_mem hyball]
            norm_num
            ring
      exact hterm.trans (hsum.le_tsum 0 fun j _ => hF_nonneg j y)
    · have htwo : 2 ≤ ‖r⁻¹ • (y - x)‖ := le_of_not_gt hy
      obtain ⟨k, hklow, hkupper⟩ := exists_dyadic_annulus htwo
      have hkpos : 0 < k := by
        by_contra hk
        have hkzero : k = 0 := Nat.eq_zero_of_not_pos hk
        have hsmall : ‖r⁻¹ • (y - x)‖ < 2 := by
          simpa [hkzero] using hkupper
        exact (not_lt_of_ge htwo) hsmall
      let n : ℕ := k - 1
      have hnadd : n + 1 = k := by
        dsimp [n]
        omega
      have hnadd' : n + 2 = k + 1 := by omega
      have hlow : (2 : ℝ) ^ (n + 1) ≤ ‖r⁻¹ • (y - x)‖ := by
        simpa [hnadd] using hklow
      have hupp : ‖r⁻¹ • (y - x)‖ < (2 : ℝ) ^ (n + 2) := by
        simpa [hnadd'] using hkupper
      have hnorm_one : 1 ≤ ‖r⁻¹ • (y - x)‖ := by
        calc
          1 ≤ (2 : ℝ) ^ (n + 1) := one_le_pow₀ (by norm_num)
          _ ≤ ‖r⁻¹ • (y - x)‖ := hlow
      have hsub : (2 : ℝ) ^ n ≤ ‖r⁻¹ • (y - x)‖ - 1 := by
        have hpow_one : 1 ≤ (2 : ℝ) ^ n := one_le_pow₀ (by norm_num)
        rw [show (2 : ℝ) ^ (n + 1) = 2 * (2 : ℝ) ^ n by
          rw [pow_succ]
          ring] at hlow
        nlinarith
      have habs : (2 : ℝ) ^ n ≤ |‖r⁻¹ • (y - x)‖ - 1| := by
        rw [abs_of_nonneg (sub_nonneg.mpr hnorm_one)]
        exact hsub
      have hdiv : (2 : ℝ) ^ n / L ≤ |‖r⁻¹ • (y - x)‖ - 1| := by
        calc
          (2 : ℝ) ^ n / L ≤ (2 : ℝ) ^ n := by
            apply (div_le_iff₀ (lt_of_lt_of_le zero_lt_one hL)).2
            calc
              (2 : ℝ) ^ n = (2 : ℝ) ^ n * 1 := by ring
              _ ≤ (2 : ℝ) ^ n * L :=
                mul_le_mul_of_nonneg_left hL (pow_nonneg (by norm_num) _)
          _ ≤ _ := habs
      have hyball : y ∈ Metric.ball x ((2 : ℝ) ^ (n + 2) * r) :=
        hball_of_scaled_norm_lt n y hupp
      have hterm :
          ‖f y‖ * ((r⁻¹) ^ d * W (r⁻¹ • (y - x))) ≤ F n y := by
        have hW := hW_tail (r⁻¹ • (y - x)) n hdiv
        calc
          ‖f y‖ * ((r⁻¹) ^ d * W (r⁻¹ • (y - x))) ≤
              ‖f y‖ * ((r⁻¹) ^ d * (A * q ^ n)) := by
            apply mul_le_mul_of_nonneg_left
            · exact mul_le_mul_of_nonneg_left (by simpa [A, q] using hW) hrpow_nonneg
            · exact norm_nonneg _
          _ = F n y := by
            dsimp [F]
            rw [Set.indicator_of_mem hyball]
            ring
      exact hterm.trans (hsum.le_tsum n fun j _ => hF_nonneg j y)
  have hF_integrable (n : ℕ) : Integrable (F n) volume := by
    dsimp [F]
    exact ((f.integrable.norm.indicator measurableSet_ball).const_mul
      (A * (r⁻¹) ^ d * q ^ n))
  have hF_integral (n : ℕ) :
      (∫ y : Euclidean d, F n y) =
        (A * (r⁻¹) ^ d * q ^ n) *
          (∫ y in Metric.ball x ((2 : ℝ) ^ (n + 2) * r), ‖f y‖) := by
    dsimp [F]
    rw [integral_const_mul, integral_indicator measurableSet_ball]
  have hF_integral_bound (n : ℕ) :
      (∫ y : Euclidean d, F n y) ≤
        (A * M * (2 : ℝ) ^ (3 * d)) * (1 / 8 : ℝ) ^ n := by
    have hradius : 0 < (2 : ℝ) ^ (n + 2) * r :=
      mul_pos (pow_pos (by norm_num) _) hr
    rw [hF_integral]
    calc
      (A * (r⁻¹) ^ d * q ^ n) *
          (∫ y in Metric.ball x ((2 : ℝ) ^ (n + 2) * r), ‖f y‖) ≤
          (A * (r⁻¹) ^ d * q ^ n) *
            (M * (2 * ((2 : ℝ) ^ (n + 2) * r)) ^ d) :=
        mul_le_mul_of_nonneg_left
          (by simpa [M] using
            ball_integral_le_dyadic_average_sup_any_radius f x hradius)
          (mul_nonneg (mul_nonneg hA hrpow_nonneg) (pow_nonneg hq_nonneg _))
      _ = (A * M * (2 : ℝ) ^ (3 * d)) * (1 / 8 : ℝ) ^ n := by
        dsimp [q]
        convert shell_tail_coefficient (A * M) r n d hr using 1; ring
  have hG_summable : Summable fun n : ℕ =>
      (A * M * (2 : ℝ) ^ (3 * d)) * (1 / 8 : ℝ) ^ n := by
    have heighth : ‖(1 / 8 : ℝ)‖ < 1 := by norm_num
    simpa [mul_assoc] using
      (summable_geometric_of_norm_lt_one heighth).mul_left
        (A * M * (2 : ℝ) ^ (3 * d))
  have hF_summable_integral_norm : Summable fun n : ℕ =>
      ∫ y : Euclidean d, ‖F n y‖ := by
    refine Summable.of_nonneg_of_le
      (f := fun n : ℕ => (A * M * (2 : ℝ) ^ (3 * d)) * (1 / 8 : ℝ) ^ n)
      (g := fun n : ℕ => ∫ y : Euclidean d, ‖F n y‖) ?_ ?_ hG_summable
    · intro n
      exact integral_nonneg fun y => norm_nonneg _
    · intro n
      have hnorm : (∫ y : Euclidean d, ‖F n y‖) = ∫ y : Euclidean d, F n y := by
        apply integral_congr_ae
        filter_upwards with y
        rw [Real.norm_of_nonneg (hF_nonneg n y)]
      rw [hnorm]
      exact hF_integral_bound n
  let Q : ℝ := ∑' n : ℕ, q ^ n
  have hQ_nonneg : 0 ≤ Q := by
    dsimp [Q]
    exact tsum_nonneg fun n => pow_nonneg hq_nonneg n
  have hmajor_integrable : Integrable
      (fun y : Euclidean d => (A * (r⁻¹) ^ d * Q) * ‖f y‖) volume :=
    f.integrable.norm.const_mul (A * (r⁻¹) ^ d * Q)
  have htsum_measurable : AEStronglyMeasurable (fun y : Euclidean d =>
      ∑' n : ℕ, F n y) volume :=
    AEStronglyMeasurable.tsum fun n => (hF_integrable n).aestronglyMeasurable
  have htsum_norm_le_major (y : Euclidean d) :
      ‖∑' n : ℕ, F n y‖ ≤ (A * (r⁻¹) ^ d * Q) * ‖f y‖ := by
    have hFsum_nonneg : 0 ≤ ∑' n : ℕ, F n y :=
      tsum_nonneg fun n => hF_nonneg n y
    rw [Real.norm_of_nonneg hFsum_nonneg]
    have hmajor_summable : Summable fun n : ℕ =>
        (A * (r⁻¹) ^ d * ‖f y‖) * q ^ n := by
      simpa [mul_assoc] using hgeom.mul_left (A * (r⁻¹) ^ d * ‖f y‖)
    calc
      ∑' n : ℕ, F n y ≤ ∑' n : ℕ, (A * (r⁻¹) ^ d * ‖f y‖) * q ^ n :=
        Summable.tsum_le_tsum (fun n => hF_le_major n y)
          (hF_pointwise_summable y) hmajor_summable
      _ = (A * (r⁻¹) ^ d * ‖f y‖) * Q := by
        dsimp [Q]
        rw [tsum_mul_left]
      _ = (A * (r⁻¹) ^ d * Q) * ‖f y‖ := by ring
  have htsum_integrable : Integrable (fun y : Euclidean d => ∑' n : ℕ, F n y) volume :=
    hmajor_integrable.mono' htsum_measurable
      (Filter.Eventually.of_forall htsum_norm_le_major)
  have htsum_integral :
      (∫ y : Euclidean d, ∑' n : ℕ, F n y) = ∑' n : ℕ, ∫ y : Euclidean d, F n y := by
    exact (MeasureTheory.integral_tsum_of_summable_integral_norm
      hF_integrable hF_summable_integral_norm).symm
  have hF_summable_integral : Summable fun n : ℕ => ∫ y : Euclidean d, F n y := by
    refine Summable.of_nonneg_of_le
      (f := fun n : ℕ => (A * M * (2 : ℝ) ^ (3 * d)) * (1 / 8 : ℝ) ^ n)
      (g := fun n : ℕ => ∫ y : Euclidean d, F n y) ?_ ?_ hG_summable
    · intro n
      exact integral_nonneg fun y => hF_nonneg n y
    · intro n
      exact hF_integral_bound n
  have hD_nonneg : 0 ≤ A * M * (2 : ℝ) ^ (3 * d) := by positivity
  have heighth : ‖(1 / 8 : ℝ)‖ < 1 := by norm_num
  have hsum_eighth : ∑' n : ℕ, (1 / 8 : ℝ) ^ n = 8 / 7 := by
    rw [(hasSum_geometric_of_norm_lt_one heighth).tsum_eq]
    norm_num
  have hsum_integrals_bound :
      (∑' n : ℕ, ∫ y : Euclidean d, F n y) ≤
        2 * (A * M * (2 : ℝ) ^ (3 * d)) := by
    calc
      (∑' n : ℕ, ∫ y : Euclidean d, F n y) ≤
          ∑' n : ℕ, (A * M * (2 : ℝ) ^ (3 * d)) * (1 / 8 : ℝ) ^ n :=
        Summable.tsum_le_tsum (fun n => hF_integral_bound n)
          hF_summable_integral hG_summable
      _ = (A * M * (2 : ℝ) ^ (3 * d)) * ∑' n : ℕ, (1 / 8 : ℝ) ^ n := by
        rw [tsum_mul_left]
      _ = (A * M * (2 : ℝ) ^ (3 * d)) * (8 / 7) := by rw [hsum_eighth]
      _ ≤ (A * M * (2 : ℝ) ^ (3 * d)) * 2 :=
        mul_le_mul_of_nonneg_left (by norm_num) hD_nonneg
      _ = 2 * (A * M * (2 : ℝ) ^ (3 * d)) := by ring
  have hleft_nonneg (y : Euclidean d) :
      0 ≤ ‖f y‖ * ((r⁻¹) ^ d * W (r⁻¹ • (y - x))) := by
    exact mul_nonneg (norm_nonneg _)
      (mul_nonneg hrpow_nonneg (hW_nonneg _))
  calc
    (∫ y : Euclidean d, ‖f y‖ * ((r⁻¹) ^ d * W (r⁻¹ • (y - x)))) ≤
        ∫ y : Euclidean d, ∑' n : ℕ, F n y :=
      integral_mono_of_nonneg
        (Filter.Eventually.of_forall hleft_nonneg) htsum_integrable
        (Filter.Eventually.of_forall hpointwise)
    _ = ∑' n : ℕ, ∫ y : Euclidean d, F n y := htsum_integral
    _ ≤ 2 * (A * M * (2 : ℝ) ^ (3 * d)) := hsum_integrals_bound
    _ = _ := by
      dsimp [A, M]

/-- Direct physical-space bridge from the literal dyadic normalized-ball
supremum to every positive scale of a Schwartz kernel convolution. -/
theorem norm_scaled_schwartz_convolution_le_dyadic_average_sup
    {d : Nat} (K f : SchwartzMap (Euclidean d) ℂ)
    {r : ℝ} (hr : 0 < r) (x : Euclidean d) :
    ‖((fun y : Euclidean d => (r⁻¹) ^ d • K (r⁻¹ • y))
        ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] (f : Euclidean d → ℂ)) x‖ ≤
      2 * ((SchwartzMap.seminorm ℂ 0 0 K +
        SchwartzMap.seminorm ℂ (d + 2) 0 K) *
        ((⨆ n : ℤ,
          ((volume (Metric.ball x ((2 : ℝ) ^ n)))⁻¹ *
            ∫⁻ y in Metric.ball x ((2 : ℝ) ^ n), ENNReal.ofReal ‖f y‖)).toReal *
          (volume (Metric.ball (0 : Euclidean d) 1)).toReal) *
          (2 : ℝ) ^ (2 * d)) := by
  apply norm_scaled_schwartz_convolution_le_dyadic_ball K f hr x
  intro m
  exact dyadic_ball_integral_le_dyadic_average_sup_growth f x m

/-! The next estimate is the physical-space high-frequency input.  It is a
literal cap-counting argument: a Schwartz kernel at thickness `L⁻¹` is
integrated over the unit sphere, and the codimension-one cap bound leaves a
summable `2⁻³ⁿ` tail. -/

private theorem surface_kernel_dyadic_coefficient
    (B C L : ℝ) (n d : ℕ) (hL : 0 < L) (hd : 0 < d) :
    (B * L ^ d * (((2 : ℝ)⁻¹) ^ (2 * d + 2)) ^ n) *
        (C * (((2 : ℝ) ^ (n + 1) / L) ^ (d - 1))) =
      B * C * L * (2 : ℝ) ^ (d - 1) * (((2 : ℝ)⁻¹) ^ (d + 3)) ^ n := by
  have hLne : L ≠ 0 := hL.ne'
  have htwo : (2 : ℝ) ≠ 0 := by norm_num
  obtain ⟨k, hk⟩ : ∃ k, d = k + 1 := ⟨d - 1, by omega⟩
  subst d
  rw [div_pow]
  rw [← pow_mul]
  rw [show ((2 : ℝ)⁻¹) ^ ((2 * (k + 1) + 2) * n) =
      ((2 : ℝ) ^ ((2 * (k + 1) + 2) * n))⁻¹ by rw [inv_pow]]
  rw [show (((2 : ℝ)⁻¹) ^ (k + 1 + 3)) ^ n =
      ((2 : ℝ)⁻¹) ^ ((k + 1 + 3) * n) by rw [pow_mul]]
  rw [show ((2 : ℝ)⁻¹) ^ ((k + 1 + 3) * n) =
      ((2 : ℝ) ^ ((k + 1 + 3) * n))⁻¹ by rw [inv_pow]]
  norm_num
  rw [pow_add]
  field_simp
  ring_nf

private theorem high_surface_kernel_q_rewrite (B L : ℝ) (n d : ℕ) :
    L ^ d * (B / ((2 : ℝ) ^ n) ^ (2 * d + 2)) =
      B * L ^ d * (((2 : ℝ)⁻¹) ^ (2 * d + 2)) ^ n := by
  rw [show ((2 : ℝ) ^ n) ^ (2 * d + 2) =
      (2 : ℝ) ^ (n * (2 * d + 2)) by rw [pow_mul]]
  rw [show (((2 : ℝ)⁻¹) ^ (2 * d + 2)) ^ n =
      ((2 : ℝ)⁻¹) ^ ((2 * d + 2) * n) by rw [pow_mul]]
  rw [show ((2 : ℝ)⁻¹) ^ ((2 * d + 2) * n) =
      ((2 : ℝ) ^ ((2 * d + 2) * n))⁻¹ by rw [inv_pow]]
  rw [Nat.mul_comm n (2 * d + 2)]
  field_simp

open Metric in
/-- A unit-sphere average of a Schwartz kernel at thickness `L⁻¹` has mass
`O(L)`.  Away from the unit shell, the same direct cap decomposition gives a
dyadic `2⁻⁽ᵈ⁺³⁾ᵐ` gain. -/
theorem exists_surface_smoothed_schwartz_kernel_shell_bound
    {d : ℕ} (hd : 0 < d) (K : SchwartzMap (Euclidean d) ℂ) :
    ∃ C : ℝ, 0 < C ∧ ∀ (L : ℝ), 1 ≤ L → ∀ (z : Euclidean d),
      (∫ ω : sphere (0 : Euclidean d) 1,
        ‖(L ^ d) • K (L • (z - (ω : Euclidean d)))‖ ∂unitSurfaceMeasure d) ≤ C * L ∧
      ∀ m : ℕ, (2 : ℝ) ^ m / L ≤ |‖z‖ - 1| →
        (∫ ω : sphere (0 : Euclidean d) 1,
          ‖(L ^ d) • K (L • (z - (ω : Euclidean d)))‖ ∂unitSurfaceMeasure d) ≤
          C * L * (((2 : ℝ)⁻¹) ^ (d + 3)) ^ m := by
  obtain ⟨D, hD_nonneg, hcap⟩ :=
    exists_unitSurfaceMeasure_cap_real_le_power hd
  let B : ℝ := SchwartzMap.seminorm ℂ 0 0 K +
    SchwartzMap.seminorm ℂ (2 * d + 2) 0 K
  have hsemi_zero : 0 ≤ SchwartzMap.seminorm ℂ 0 0 K := by
    calc
      0 ≤ ‖K (0 : Euclidean d)‖ := norm_nonneg _
      _ ≤ SchwartzMap.seminorm ℂ 0 0 K := SchwartzMap.norm_le_seminorm ℂ K 0
  have hsemi_decay : 0 ≤ SchwartzMap.seminorm ℂ (2 * d + 2) 0 K := by
    calc
      0 ≤ ‖(0 : Euclidean d)‖ ^ (2 * d + 2) * ‖K (0 : Euclidean d)‖ := by positivity
      _ ≤ SchwartzMap.seminorm ℂ (2 * d + 2) 0 K :=
        SchwartzMap.norm_pow_mul_le_seminorm ℂ K (2 * d + 2) 0
  have hB : 0 ≤ B := add_nonneg hsemi_zero hsemi_decay
  have hsemi_zero_le_B : SchwartzMap.seminorm ℂ 0 0 K ≤ B := by
    dsimp [B]
    linarith
  have hsemi_decay_le_B : SchwartzMap.seminorm ℂ (2 * d + 2) 0 K ≤ B := by
    dsimp [B]
    linarith
  let C : ℝ := 2 * (B * D * (2 : ℝ) ^ (d - 1)) + 1
  refine ⟨C, ?_, ?_⟩
  · dsimp [C]
    have : 0 ≤ B * D * (2 : ℝ) ^ (d - 1) := by positivity
    linarith
  intro L hL z
  have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one hL
  have hLpow : 0 ≤ L ^ d := pow_nonneg hLpos.le _
  let q : ℝ := ((2 : ℝ)⁻¹) ^ (2 * d + 2)
  let s : ℝ := ((2 : ℝ)⁻¹) ^ (d + 3)
