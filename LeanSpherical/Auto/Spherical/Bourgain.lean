private theorem aux_integrable_continuous_mul_dyadicBandpass_fourier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) (j : Nat)
    (a : Euclidean 2 → Complex) (ha : Continuous a)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun xi : Euclidean 2 =>
      a xi * _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
        𝓕 (f : Euclidean 2 → Complex) xi) := by
  apply Continuous.integrable_of_hasCompactSupport
  · exact (ha.mul
      (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j).continuous).mul
        (𝓕 f).continuous
  · apply HasCompactSupport.intro
      (isCompact_closedBall (0 : Euclidean 2) ((2 : Real) ^ (j + 2)))
    intro xi hxi
    have hnorm : (2 : Real) ^ (j + 2) ≤ ‖xi‖ := by
      rw [Metric.mem_closedBall, dist_zero_right] at hxi
      exact le_of_not_ge hxi
    have hband := _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_le_norm C hnorm
    simp [hband]

/-- The literal middle dyadic wave and its literal time-derivative wave are
jointly continuous, and the latter is the pointwise derivative of the
former.  Compact frequency support makes differentiation under the inverse
Fourier integral legitimate without any unrecorded limiting argument. -/
theorem aux_continuous_and_hasDerivAt_circleMiddleWaveContribution
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    Continuous (Function.uncurry (fun t x => circleMiddleWaveContribution C j t f x)) ∧
      Continuous (Function.uncurry
        (fun t x => aux_circleMiddleWaveContributionTimeDerivative C j t f x)) ∧
      ∀ t x, HasDerivAt
        (fun s => circleMiddleWaveContribution C j s f x)
        (aux_circleMiddleWaveContributionTimeDerivative C j t f x) t := by
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleMiddleWaveContribution C j t f x
  let D : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleMiddleWaveContributionTimeDerivative C j t f x
  change Continuous (Function.uncurry F) ∧ Continuous (Function.uncurry D) ∧
    ∀ t x, HasDerivAt (fun s => F s x) (D t x) t
  let K : Set (Euclidean 2) := Metric.closedBall 0 ((2 : Real) ^ (j + 2))
  have hK : IsCompact K := isCompact_closedBall _ _
  have hKmeas : MeasurableSet K := hK.measurableSet
  let G : (Real × Euclidean 2) → Euclidean 2 → Complex := fun q xi =>
    (Real.fourierChar (inner Real xi q.2) : Complex) *
      (aux_circleMiddleBandpassMultiplier C j q.1 xi *
        𝓕 (f : Euclidean 2 → Complex) xi)
  let G' : (Real × Euclidean 2) → Euclidean 2 → Complex := fun q xi =>
    (Real.fourierChar (inner Real xi q.2) : Complex) *
      (aux_circleMiddleBandpassMultiplierTimeDerivative C j q.1 xi *
        𝓕 (f : Euclidean 2 → Complex) xi)
  have hGcont : Continuous (Function.uncurry G) := by
    change Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
      (Real.fourierChar (inner Real q.2 q.1.2) : Complex) *
        (aux_circleMiddleBandpassMultiplier C j q.1.1 q.2 *
          𝓕 (f : Euclidean 2 → Complex) q.2))
    have hchar : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (Real.fourierChar (inner Real q.2 q.1.2) : Complex)) := by
      fun_prop
    have hpair : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (q.1.1, q.2)) := by
      fun_prop
    have hmult' :=
      (aux_continuous_uncurry_circleMiddleBandpassMultiplier C j).comp hpair
    have hmult : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        aux_circleMiddleBandpassMultiplier C j q.1.1 q.2) := by
      exact hmult'.congr fun q => rfl
    have hfourier : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        𝓕 (f : Euclidean 2 → Complex) q.2) :=
      (𝓕 f).continuous.comp continuous_snd
    exact hchar.mul (hmult.mul hfourier)
  have hG'cont : Continuous (Function.uncurry G') := by
    change Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
      (Real.fourierChar (inner Real q.2 q.1.2) : Complex) *
        (aux_circleMiddleBandpassMultiplierTimeDerivative C j q.1.1 q.2 *
          𝓕 (f : Euclidean 2 → Complex) q.2))
    have hchar : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (Real.fourierChar (inner Real q.2 q.1.2) : Complex)) := by
      fun_prop
    have hpair : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (q.1.1, q.2)) := by
      fun_prop
    have hmult' :=
      (aux_continuous_uncurry_circleMiddleBandpassMultiplierTimeDerivative C j).comp hpair
    have hmult : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        aux_circleMiddleBandpassMultiplierTimeDerivative C j q.1.1 q.2) := by
      exact hmult'.congr fun q => rfl
    have hfourier : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        𝓕 (f : Euclidean 2 → Complex) q.2) :=
      (𝓕 f).continuous.comp continuous_snd
    exact hchar.mul (hmult.mul hfourier)
  have hGsupport (q : Real × Euclidean 2) : Function.support (G q) ⊆ K := by
    intro xi hxi
    by_contra hxiK
    have hnorm : (2 : Real) ^ (j + 2) ≤ ‖xi‖ := by
      rw [Metric.mem_closedBall, dist_zero_right] at hxiK
      exact le_of_not_ge hxiK
    have hband :
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0 :=
      _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_le_norm C hnorm
    change G q xi ≠ 0 at hxi
    exact hxi (by simp [G, aux_circleMiddleBandpassMultiplier, hband])
  have hG'support (q : Real × Euclidean 2) : Function.support (G' q) ⊆ K := by
    intro xi hxi
    by_contra hxiK
    have hnorm : (2 : Real) ^ (j + 2) ≤ ‖xi‖ := by
      rw [Metric.mem_closedBall, dist_zero_right] at hxiK
      exact le_of_not_ge hxiK
    have hband :
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0 :=
      _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_le_norm C hnorm
    change G' q xi ≠ 0 at hxi
    exact hxi (by simp [G', aux_circleMiddleBandpassMultiplierTimeDerivative, hband])
  have hGintegral (q : Real × Euclidean 2) :
      (∫ xi : Euclidean 2, G q xi) = ∫ xi in K, G q xi := by
    rw [← MeasureTheory.integral_indicator hKmeas]
    rw [Set.indicator_eq_self.mpr (hGsupport q)]
  have hG'integral (q : Real × Euclidean 2) :
      (∫ xi : Euclidean 2, G' q xi) = ∫ xi in K, G' q xi := by
    rw [← MeasureTheory.integral_indicator hKmeas]
    rw [Set.indicator_eq_self.mpr (hG'support q)]
  have hF_eq (q : Real × Euclidean 2) :
      F q.1 q.2 = ∫ xi in K, G q xi := by
    have hraw : F q.1 q.2 = ∫ xi : Euclidean 2, G q xi := by
      dsimp only [F, G]
      rw [aux_circleMiddleWaveContribution_eq_fourierInv_multiplier C j q.1 f q.2]
      rw [Real.fourierInv_eq]
      rfl
    rw [hraw]
    exact hGintegral q
  have hD_eq (q : Real × Euclidean 2) :
      D q.1 q.2 = ∫ xi in K, G' q xi := by
    have hraw : D q.1 q.2 = ∫ xi : Euclidean 2, G' q xi := by
      dsimp only [D, G']
      rw [aux_circleMiddleWaveContributionTimeDerivative_eq_fourierInv_multiplier C j q.1 f q.2]
      rw [Real.fourierInv_eq]
      rfl
    rw [hraw]
    exact hG'integral q
  have hFcont : Continuous (Function.uncurry F) := by
    have hcont := continuous_parametric_integral_of_continuous
      (μ := volume) hGcont hK
    rw [show Function.uncurry F = fun q : Real × Euclidean 2 =>
      ∫ xi in K, G q xi by
        funext q
        exact hF_eq q]
    exact hcont
  have hDcont : Continuous (Function.uncurry D) := by
    have hcont := continuous_parametric_integral_of_continuous
      (μ := volume) hG'cont hK
    rw [show Function.uncurry D = fun q : Real × Euclidean 2 =>
      ∫ xi in K, G' q xi by
        funext q
        exact hD_eq q]
    exact hcont
  refine ⟨hFcont, hDcont, ?_⟩
  intro s x
  have hGderiv (t : Real) (xi : Euclidean 2) :
      HasDerivAt (fun u : Real => G (u, x) xi) (G' (t, x) xi) t := by
    have hmult := aux_hasDerivAt_circleMiddleBandpassMultiplier C j t xi
    have hproduct := hmult.mul_const (𝓕 (f : Euclidean 2 → Complex) xi)
    have hfull := hproduct.const_mul (Real.fourierChar (inner Real xi x) : Complex)
    simpa only [G, G'] using hfull
  have hFcurve : (fun t : Real => F t x) =
      fun t : Real => ∫ xi in K, G (t, x) xi := by
    funext t
    simpa only using hF_eq (t, x)
  have hDcurve : D s x = ∫ xi in K, G' (s, x) xi := by
    simpa only using hD_eq (s, x)
  have hGslice (t : Real) : Continuous (fun xi : Euclidean 2 => G (t, x) xi) := by
    change Continuous ((Function.uncurry G) ∘ fun xi : Euclidean 2 => ((t, x), xi))
    exact hGcont.comp
      ((continuous_const : Continuous fun _ : Euclidean 2 => (t, x)).prodMk continuous_id)
  have hG'slice (t : Real) : Continuous (fun xi : Euclidean 2 => G' (t, x) xi) := by
    change Continuous ((Function.uncurry G') ∘ fun xi : Euclidean 2 => ((t, x), xi))
    exact hG'cont.comp
      ((continuous_const : Continuous fun _ : Euclidean 2 => (t, x)).prodMk continuous_id)
  have hG'curve : Continuous (fun q : Real × Euclidean 2 => G' (q.1, x) q.2) := by
    change Continuous ((Function.uncurry G') ∘
      fun q : Real × Euclidean 2 => ((q.1, x), q.2))
    exact hG'cont.comp (by fun_prop)
  have hFmeas : ∀ᶠ t in nhds s,
      AEStronglyMeasurable (fun xi : Euclidean 2 => G (t, x) xi) (volume.restrict K) := by
    filter_upwards [] with t
    exact (hGslice t).aestronglyMeasurable.restrict
  have hFint : Integrable (fun xi : Euclidean 2 => G (s, x) xi) (volume.restrict K) := by
    have hcompact : HasCompactSupport (fun xi : Euclidean 2 => G (s, x) xi) := by
      apply HasCompactSupport.of_support_subset_isCompact hK
      exact hGsupport (s, x)
    exact ((hGslice s).integrable_of_hasCompactSupport hcompact).restrict
  have hF'meas : AEStronglyMeasurable (fun xi : Euclidean 2 => G' (s, x) xi)
      (volume.restrict K) :=
    (hG'slice s).aestronglyMeasurable.restrict
  obtain ⟨A, hA⟩ := (isCompact_Icc.prod hK).exists_bound_of_continuousOn
    hG'curve.continuousOn
  have hbound : ∀ᵐ xi : Euclidean 2 ∂(volume.restrict K),
      ∀ t ∈ Icc (s - 1) (s + 1), ‖G' (t, x) xi‖ ≤ A := by
    filter_upwards [ae_restrict_mem hKmeas] with xi hxi
    intro t ht
    exact hA (t, xi) ⟨ht, hxi⟩
  have hAint : Integrable (fun _ : Euclidean 2 => A) (volume.restrict K) := by
    simpa only [IntegrableOn] using
      (integrableOn_const (μ := volume) (s := K) hK.measure_ne_top :
        IntegrableOn (fun _ : Euclidean 2 => A) K volume)
  have hdiff : ∀ᵐ xi : Euclidean 2 ∂(volume.restrict K),
      ∀ t ∈ Icc (s - 1) (s + 1),
        HasDerivAt (fun u : Real => G (u, x) xi) (G' (t, x) xi) t :=
    Filter.Eventually.of_forall fun xi t _ => hGderiv t xi
  have hs : Icc (s - 1) (s + 1) ∈ nhds s :=
    Icc_mem_nhds (sub_lt_self s zero_lt_one) (lt_add_of_pos_right s zero_lt_one)
  have hparam := hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := volume.restrict K) (s := Icc (s - 1) (s + 1)) (x₀ := s)
    (bound := fun _ : Euclidean 2 => A)
    (F := fun t (xi : Euclidean 2) => G (t, x) xi)
    (F' := fun t (xi : Euclidean 2) => G' (t, x) xi)
    hs hFmeas hFint hF'meas hbound hAint hdiff
  rw [hFcurve, hDcurve]
  exact hparam.2

/-- Each nonnegative-time middle wave slice has integrable squared norm. -/
theorem aux_integrable_norm_sq_circleMiddleWaveContribution
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (ht : 0 ≤ t)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun x : Euclidean 2 => ‖circleMiddleWaveContribution C j t f x‖ ^ 2)
      volume := by
  obtain ⟨m, hm⟩ := aux_exists_circleMiddleBandpassSchwartzSymbol C j t ht
  have hsq :=
    _root_.Auto.Spherical.Auxiliary.integrable_norm_sq_fourierInv_schwartz_multiplier
      m (𝓕 f)
  have heq : (fun x : Euclidean 2 => circleMiddleWaveContribution C j t f x) =
      fun x : Euclidean 2 => 𝓕⁻ (fun xi : Euclidean 2 =>
        m xi * 𝓕 (f : Euclidean 2 → Complex) xi) x := by
    funext x
    rw [aux_circleMiddleWaveContribution_eq_fourierInv_multiplier C j t f x]
    apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
    funext xi
    rw [hm xi]
  apply hsq.congr
  filter_upwards with x
  rw [congrFun heq x]
  rfl

/-- Each literal middle time-derivative slice has integrable squared norm. -/
theorem aux_integrable_norm_sq_circleMiddleWaveContributionTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun x : Euclidean 2 =>
      ‖aux_circleMiddleWaveContributionTimeDerivative C j t f x‖ ^ 2) volume := by
  let m : SchwartzMap (Euclidean 2) Complex :=
    aux_circleMiddleBandpassMultiplierTimeDerivativeSchwartzSymbol C j t
  have hsq :=
    _root_.Auto.Spherical.Auxiliary.integrable_norm_sq_fourierInv_schwartz_multiplier
      m (𝓕 f)
  have heq : (fun x : Euclidean 2 =>
      aux_circleMiddleWaveContributionTimeDerivative C j t f x) =
      fun x : Euclidean 2 => 𝓕⁻ (fun xi : Euclidean 2 =>
        m xi * 𝓕 (f : Euclidean 2 → Complex) xi) x := by
    funext x
    rw [aux_circleMiddleWaveContributionTimeDerivative_eq_fourierInv_multiplier C j t f x]
    apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
    funext xi
    rw [show m xi = aux_circleMiddleBandpassMultiplierTimeDerivative C j t xi by
      exact aux_circleMiddleBandpassMultiplierTimeDerivativeSchwartzSymbol_apply C j t xi]
  apply hsq.congr
  filter_upwards with x
  rw [congrFun heq x]
  rfl

/-- The literal middle time derivative has integrable squared norm on the
unit time slab.  This is the Fubini hypothesis required by the spatial
time-Sobolev estimate. -/
theorem aux_integrable_norm_sq_circleMiddleWaveContributionTimeDerivative_prod
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun p : Real × Euclidean 2 =>
      ‖aux_circleMiddleWaveContributionTimeDerivative C j p.1 f p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
  let D : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleMiddleWaveContributionTimeDerivative C j t f x
  have hjoint := aux_continuous_and_hasDerivAt_circleMiddleWaveContribution C j f
  have hDcont : Continuous (Function.uncurry D) := by
    simpa only [D] using hjoint.2.1
  obtain ⟨B, hB, hbound⟩ :=
    aux_exists_integral_norm_sq_circleMiddleWaveContributionTimeDerivative_le C
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hE : 0 ≤ E := by
    dsimp only [E]
    exact integral_nonneg fun _ => sq_nonneg _
  have hDint (t : Real) : Integrable (fun x : Euclidean 2 => ‖D t x‖ ^ 2) volume := by
    simpa only [D] using
      aux_integrable_norm_sq_circleMiddleWaveContributionTimeDerivative C j t f
  have hDbound (t : Real) (ht : t ∈ Icc (1 : Real) 2) :
      (∫ x : Euclidean 2, ‖D t x‖ ^ 2) ≤ B ^ 2 * E := by
    simpa only [D, E] using hbound j t ht.1 ht.2 f
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  letI : IsFiniteMeasure ν := by
    dsimp only [ν]
    infer_instance
  change Integrable (fun p : Real × Euclidean 2 => ‖D p.1 p.2‖ ^ 2) (ν.prod volume)
  have hmeas : AEStronglyMeasurable (fun p : Real × Euclidean 2 =>
      ‖D p.1 p.2‖ ^ 2) (ν.prod volume) :=
    (hDcont.norm.pow 2).aestronglyMeasurable
  refine (integrable_prod_iff hmeas).2 ?_
  constructor
  · filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
    exact hDint t
  · have houter_meas : AEStronglyMeasurable (fun t : Real =>
        ∫ x : Euclidean 2, ‖D t x‖ ^ 2) ν :=
      ((hDcont.norm.pow 2).stronglyMeasurable.integral_prod_right').aestronglyMeasurable
    have houter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖D t x‖ ^ 2) ν := by
      apply Integrable.of_bound houter_meas (B ^ 2 * E)
      filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
      rw [Real.norm_of_nonneg (integral_nonneg fun _ => sq_nonneg _)]
      exact hDbound t ht
    simpa only [Real.norm_of_nonneg (sq_nonneg _)] using houter

/-- The spatial time-Sobolev estimate applies to the literal middle wave on
the unit interval.  This records the exact integration point between the
dyadic multiplier bounds and the pre-existing Fubini/Sobolev infrastructure. -/
theorem aux_timeSobolevL2_spacetime_circleMiddleWaveContribution
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex)
    (r : Real) (hr : r ∈ Icc (1 : Real) 2) :
    (∫ x : Euclidean 2, ‖circleMiddleWaveContribution C j r f x‖ ^ 2) ≤
      2 * (∫ x : Euclidean 2, ‖circleMiddleWaveContribution C j 1 f x‖ ^ 2) +
        2 * ((2 : Real) - 1) *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
            ‖aux_circleMiddleWaveContributionTimeDerivative C j t f x‖ ^ 2) := by
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleMiddleWaveContribution C j t f x
  let D : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleMiddleWaveContributionTimeDerivative C j t f x
  have hjoint := aux_continuous_and_hasDerivAt_circleMiddleWaveContribution C j f
  have hFcont : Continuous (Function.uncurry F) := by
    simpa only [F] using hjoint.1
  have hDcont : Continuous (Function.uncurry D) := by
    simpa only [D] using hjoint.2.1
  have hderiv : ∀ t x, HasDerivAt (fun s => F s x) (D t x) t := by
    simpa only [F, D] using hjoint.2.2
  have hFrmeas : AEStronglyMeasurable (F r) volume := by
    have hslice : Continuous (F r) := by
      change Continuous ((Function.uncurry F) ∘ fun x : Euclidean 2 => (r, x))
      exact hFcont.comp
        ((continuous_const : Continuous fun _ : Euclidean 2 => r).prodMk continuous_id)
    exact hslice.aestronglyMeasurable
  have hDtime : ∀ x : Euclidean 2, Continuous (fun t => D t x) := by
    intro x
    change Continuous ((Function.uncurry D) ∘ fun t : Real => (t, x))
    exact hDcont.comp
      (continuous_id.prodMk (continuous_const : Continuous fun _ : Real => x))
  have hFone : Integrable (fun x : Euclidean 2 => ‖F 1 x‖ ^ 2) volume := by
    simpa only [F] using
      aux_integrable_norm_sq_circleMiddleWaveContribution C j 1 (by norm_num) f
  have hDprod : Integrable (fun p : Real × Euclidean 2 => ‖D p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    simpa only [D] using
      aux_integrable_norm_sq_circleMiddleWaveContributionTimeDerivative_prod C j f
  simpa only [F, D] using
    timeSobolevL2_spacetime (F := F) (F' := D) hr hFrmeas hDtime hderiv hFone hDprod

/-- A genuine short-time square maximal estimate for the literal middle
contribution.  Its right-hand side is the fully justified Sobolev energy
from the previous theorem, before any optional numerical simplification. -/
theorem aux_measurable_and_lintegral_iSup_circleMiddleWaveContribution_le_timeSobolev
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    Measurable (fun x : Euclidean 2 =>
      ⨆ t : Icc (1 : Real) 2,
        ENNReal.ofReal (‖circleMiddleWaveContribution C j t.1 f x‖ ^ 2)) ∧
      (∫⁻ x : Euclidean 2,
        ⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal (‖circleMiddleWaveContribution C j t.1 f x‖ ^ 2)) ≤
        ENNReal.ofReal
          (2 * (∫ x : Euclidean 2, ‖circleMiddleWaveContribution C j 1 f x‖ ^ 2) +
            2 * ((2 : Real) - 1) *
              ∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
                ‖aux_circleMiddleWaveContributionTimeDerivative C j t f x‖ ^ 2) := by
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleMiddleWaveContribution C j t f x
  let D : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleMiddleWaveContributionTimeDerivative C j t f x
  have hjoint := aux_continuous_and_hasDerivAt_circleMiddleWaveContribution C j f
  have hFcont : Continuous (Function.uncurry F) := by
    simpa only [F] using hjoint.1
  have hDcont : Continuous (Function.uncurry D) := by
    simpa only [D] using hjoint.2.1
  have hderiv : ∀ t x, HasDerivAt (fun s => F s x) (D t x) t := by
    simpa only [F, D] using hjoint.2.2
  have hFone : Integrable (fun x : Euclidean 2 => ‖F 1 x‖ ^ 2) volume := by
    simpa only [F] using
      aux_integrable_norm_sq_circleMiddleWaveContribution C j 1 (by norm_num) f
  have hDprod : Integrable (fun p : Real × Euclidean 2 => ‖D p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    simpa only [D] using
      aux_integrable_norm_sq_circleMiddleWaveContributionTimeDerivative_prod C j f
  simpa only [F, D] using
    (_root_.Auto.Spherical.Auxiliary.measurable_and_lintegral_iSup_ennreal_norm_sq_le_radiusSobolev_of_hasDerivAt
      (F := F) (F' := D) (a := (1 : Real)) (b := 2) (by norm_num)
      hFcont hDcont hderiv hFone hDprod)

/-- The preceding square-maximal estimate yields an ordinary `L²` estimate
for the short-time supremum of the literal middle wave. -/
theorem aux_memLp_two_and_integral_norm_sq_iSup_circleMiddleWaveContribution_le_timeSobolev
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    MemLp (fun x : Euclidean 2 =>
      (⨆ t : Icc (1 : Real) 2,
        ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal) 2 volume ∧
      (∫ x : Euclidean 2,
        ‖(⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal‖ ^ 2) ≤
        2 * (∫ x : Euclidean 2, ‖circleMiddleWaveContribution C j 1 f x‖ ^ 2) +
          2 * ((2 : Real) - 1) *
            ∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
              ‖aux_circleMiddleWaveContributionTimeDerivative C j t f x‖ ^ 2 := by
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleMiddleWaveContribution C j t f x
  let Q : Euclidean 2 → ENNReal := fun x =>
    ⨆ t : Icc (1 : Real) 2, ENNReal.ofReal (‖F t.1 x‖ ^ 2)
  let K : Real :=
    2 * (∫ x : Euclidean 2, ‖F 1 x‖ ^ 2) +
      2 * ((2 : Real) - 1) *
        ∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
          ‖aux_circleMiddleWaveContributionTimeDerivative C j t f x‖ ^ 2
  obtain ⟨hQmeas, hQbound⟩ :=
    aux_measurable_and_lintegral_iSup_circleMiddleWaveContribution_le_timeSobolev C j f
  have hQmeas' : Measurable Q := by
    simpa only [F, Q] using hQmeas
  have hQbound' : (∫⁻ x : Euclidean 2, Q x) ≤ ENNReal.ofReal K := by
    simpa only [F, Q, K] using hQbound
  have hK : 0 ≤ K := by
    dsimp only [K]
    apply add_nonneg
    · positivity
    · apply mul_nonneg
      · positivity
      · exact intervalIntegral.integral_nonneg (by norm_num) fun t _ =>
          integral_nonneg fun _ => sq_nonneg _
  have hsq :=
    _root_.Auto.Spherical.Auxiliary.memLp_two_toReal_sqrt_of_measurable_lintegral
      Q hQmeas' hK hQbound'
  have hjoint := aux_continuous_and_hasDerivAt_circleMiddleWaveContribution C j f
  have hFcont : Continuous (Function.uncurry F) := by
    simpa only [F] using hjoint.1
  have hordinary :=
    _root_.Auto.Spherical.Auxiliary.memLp_two_iSup_ennreal_norm_of_memLp_sqrt_iSup_ennreal_norm_sq
      (F := F) (a := (1 : Real)) (b := 2) (by norm_num) hFcont hsq.1 hsq.2
  simpa only [F, K] using hordinary

/-- Integrating the fixed-time derivative estimate over the unit interval
gives the quantitative derivative-energy bound used by the middle maximal
term. -/
theorem aux_exists_intervalIntegral_integral_norm_sq_circleMiddleWaveContributionTimeDerivative_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
        ‖aux_circleMiddleWaveContributionTimeDerivative C j t f x‖ ^ 2) ≤
        B ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨B, hB, hfixed⟩ :=
    aux_exists_integral_norm_sq_circleMiddleWaveContributionTimeDerivative_le C
  refine ⟨B, hB, ?_⟩
  intro j f
  let D : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleMiddleWaveContributionTimeDerivative C j t f x
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hprod : Integrable (fun p : Real × Euclidean 2 => ‖D p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    simpa only [D] using
      aux_integrable_norm_sq_circleMiddleWaveContributionTimeDerivative_prod C j f
  have houter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖D t x‖ ^ 2)
      (volume.restrict (Icc (1 : Real) 2)) :=
    hprod.integral_prod_left
  have hinterval : IntervalIntegrable (fun t : Real => ∫ x : Euclidean 2, ‖D t x‖ ^ 2)
      volume 1 2 := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num : (1 : Real) ≤ 2)]
    exact houter
  have hpoint (t : Real) (ht : t ∈ Icc (1 : Real) 2) :
      (∫ x : Euclidean 2, ‖D t x‖ ^ 2) ≤ B ^ 2 * E := by
    simpa only [D, E] using hfixed j t ht.1 ht.2 f
  calc
    (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) =
        ∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2 := rfl
    _ ≤ ∫ _t in (1 : Real)..2, B ^ 2 * E := by
      exact intervalIntegral.integral_mono_on (by norm_num) hinterval intervalIntegrable_const hpoint
    _ = B ^ 2 * E := by norm_num

/- The nonstationary middle piece has a uniform literal short-time `L²`
maximal bound.  This is obtained solely from its proved dyadic fixed-time
bound, the derivative-energy bound, and the time-Sobolev estimate. -/
/-- The literal middle-wave square is integrable on the unit time slab.
The estimate uses the nonstationary fixed-time gain at each time and then
Fubini; it is the input-side energy needed for dyadic time sampling. -/
theorem aux_integrable_norm_sq_circleMiddleWaveContribution_prod
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun p : Real × Euclidean 2 =>
      ‖circleMiddleWaveContribution C j p.1 f p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleMiddleWaveContribution C j t f x
  have hjoint := aux_continuous_and_hasDerivAt_circleMiddleWaveContribution C j f
  have hFcont : Continuous (Function.uncurry F) := by
    simpa only [F] using hjoint.1
  obtain ⟨A, hA, hbound⟩ :=
    aux_exists_integral_norm_sq_circleMiddleWaveContribution_le_dyadicInverse C
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hE : 0 ≤ E := by
    dsimp only [E]
    exact integral_nonneg fun _ => sq_nonneg _
  have hFint (t : Real) (ht : t ∈ Icc (1 : Real) 2) :
      Integrable (fun x : Euclidean 2 => ‖F t x‖ ^ 2) volume := by
    simpa only [F] using
      aux_integrable_norm_sq_circleMiddleWaveContribution C j t
        (zero_le_one.trans ht.1) f
  have hFbound (t : Real) (ht : t ∈ Icc (1 : Real) 2) :
      (∫ x : Euclidean 2, ‖F t x‖ ^ 2) ≤ (A / dyadicScale j) ^ 2 * E := by
    simpa only [F, E] using hbound j t ht.1 ht.2 f
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  letI : IsFiniteMeasure ν := by
    dsimp only [ν]
    infer_instance
  change Integrable (fun p : Real × Euclidean 2 => ‖F p.1 p.2‖ ^ 2) (ν.prod volume)
  have hmeas : AEStronglyMeasurable (fun p : Real × Euclidean 2 =>
      ‖F p.1 p.2‖ ^ 2) (ν.prod volume) :=
    (hFcont.norm.pow 2).aestronglyMeasurable
  refine (integrable_prod_iff hmeas).2 ?_
  constructor
  · filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
    exact hFint t ht
  · have houter_meas : AEStronglyMeasurable (fun t : Real =>
        ∫ x : Euclidean 2, ‖F t x‖ ^ 2) ν :=
      ((hFcont.norm.pow 2).stronglyMeasurable.integral_prod_right').aestronglyMeasurable
    have houter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖F t x‖ ^ 2) ν := by
      apply Integrable.of_bound houter_meas ((A / dyadicScale j) ^ 2 * E)
      filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
      rw [Real.norm_of_nonneg (integral_nonneg fun _ => sq_nonneg _)]
      exact hFbound t ht
    simpa only [Real.norm_of_nonneg (sq_nonneg _)] using houter

/-- Integrating the nonstationary fixed-time middle-wave estimate over the
unit time interval preserves its full inverse dyadic-frequency gain. -/
theorem aux_exists_intervalIntegral_integral_norm_sq_circleMiddleWaveContribution_le_dyadicInverse
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ A : Real, 0 < A ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
        ‖circleMiddleWaveContribution C j t f x‖ ^ 2) ≤
        (A / dyadicScale j) ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨A, hA, hfixed⟩ :=
    aux_exists_integral_norm_sq_circleMiddleWaveContribution_le_dyadicInverse C
  refine ⟨A, hA, ?_⟩
  intro j f
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleMiddleWaveContribution C j t f x
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hprod : Integrable (fun p : Real × Euclidean 2 => ‖F p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    simpa only [F] using
      aux_integrable_norm_sq_circleMiddleWaveContribution_prod C j f
  have houter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖F t x‖ ^ 2)
      (volume.restrict (Icc (1 : Real) 2)) :=
    hprod.integral_prod_left
  have hinterval : IntervalIntegrable (fun t : Real => ∫ x : Euclidean 2, ‖F t x‖ ^ 2)
      volume 1 2 := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num : (1 : Real) ≤ 2)]
    exact houter
  have hpoint (t : Real) (ht : t ∈ Icc (1 : Real) 2) :
      (∫ x : Euclidean 2, ‖F t x‖ ^ 2) ≤ (A / dyadicScale j) ^ 2 * E := by
    simpa only [F, E] using hfixed j t ht.1 ht.2 f
  calc
    (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) ≤
        ∫ _t in (1 : Real)..2, (A / dyadicScale j) ^ 2 * E := by
      exact intervalIntegral.integral_mono_on (by norm_num) hinterval intervalIntegrable_const hpoint
    _ = (A / dyadicScale j) ^ 2 * E := by norm_num

private theorem aux_exists_measurable_lintegral_iSup_circleMiddleWaveContribution_le_dyadicGain
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ M : Real, 0 < M ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      Measurable (fun x : Euclidean 2 =>
        ⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal (‖circleMiddleWaveContribution C j t.1 f x‖ ^ 2)) ∧
        (∫⁻ x : Euclidean 2,
          ⨆ t : Icc (1 : Real) 2,
            ENNReal.ofReal (‖circleMiddleWaveContribution C j t.1 f x‖ ^ 2)) ≤
          ENNReal.ofReal
            (M ^ 2 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j *
              ∫ x : Euclidean 2, ‖f x‖ ^ 2) := by
  obtain ⟨A, hA, hFbound⟩ :=
    aux_exists_intervalIntegral_integral_norm_sq_circleMiddleWaveContribution_le_dyadicInverse C
  obtain ⟨B, hB, hDbound⟩ :=
    aux_exists_intervalIntegral_integral_norm_sq_circleMiddleWaveContributionTimeDerivative_le C
  let M : Real := 4 * (A + B)
  have hM : 0 < M := by
    dsimp only [M]
    positivity
  refine ⟨M, hM, ?_⟩
  intro j f
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleMiddleWaveContribution C j t f x
  let D : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleMiddleWaveContributionTimeDerivative C j t f x
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hE : 0 ≤ E := by
    dsimp only [E]
    exact integral_nonneg fun _ => sq_nonneg _
  have hjoint := aux_continuous_and_hasDerivAt_circleMiddleWaveContribution C j f
  have hFcont : Continuous (Function.uncurry F) := by
    simpa only [F] using hjoint.1
  have hDcont : Continuous (Function.uncurry D) := by
    simpa only [D] using hjoint.2.1
  have hderiv : ∀ t x, HasDerivAt (fun s => F s x) (D t x) t := by
    simpa only [F, D] using hjoint.2.2
  have hFprod : Integrable (fun p : Real × Euclidean 2 => ‖F p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    simpa only [F] using
      aux_integrable_norm_sq_circleMiddleWaveContribution_prod C j f
  have hDprod : Integrable (fun p : Real × Euclidean 2 => ‖D p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    simpa only [D] using
      aux_integrable_norm_sq_circleMiddleWaveContributionTimeDerivative_prod C j f
  obtain ⟨T, hT⟩ := exists_MSS_MaximalSeparated j
  obtain ⟨hmeas, hsampling⟩ :=
    measurable_and_lintegral_iSup_ennreal_norm_sq_le_timeSamplingL2
      (F := F) (F' := D) j T hT hFcont hDcont hderiv hFprod hDprod
  refine ⟨?_, hsampling.trans ?_⟩
  · simpa only [F] using hmeas
  · apply ENNReal.ofReal_le_ofReal
    have hF :
        (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) ≤
          (A / dyadicScale j) ^ 2 * E := by
      simpa only [F, E] using hFbound j f
    have hD :
        (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) ≤
          B ^ 2 * E := by
      simpa only [D, E] using hDbound j f
    let δ : Real := _root_.Auto.Spherical.MSSBase.dyadicTimeScale j
    let R : Real := dyadicScale j
    have hR : 0 < R := by
      dsimp only [R]
      exact dyadicScale_pos j
    have hδ : δ = R⁻¹ := by
      dsimp only [δ, R]
      simp [_root_.Auto.Spherical.MSSBase.dyadicTimeScale, dyadicScale, zpow_neg]
    have hδnonneg : 0 ≤ δ := by
      rw [hδ]
      exact inv_nonneg.mpr hR.le
    have hδinvnonneg : 0 ≤ δ⁻¹ := inv_nonneg.mpr hδnonneg
    have hsamplebound :
        8 * δ⁻¹ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) +
          6 * δ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) ≤
          8 * δ⁻¹ * ((A / R) ^ 2 * E) + 6 * δ * (B ^ 2 * E) := by
      apply add_le_add
      · have h := mul_le_mul_of_nonneg_left
          (by simpa only [R] using hF)
          (mul_nonneg (by norm_num : (0 : Real) ≤ 8) hδinvnonneg)
        simpa only [mul_assoc, mul_left_comm, mul_comm] using h
      · have h := mul_le_mul_of_nonneg_left
          (by simpa only [R] using hD)
          (mul_nonneg (by norm_num : (0 : Real) ≤ 6) hδnonneg)
        simpa only [mul_assoc, mul_left_comm, mul_comm] using h
    have hformula :
        8 * δ⁻¹ * ((A / R) ^ 2 * E) + 6 * δ * (B ^ 2 * E) =
          ((8 * A ^ 2 + 6 * B ^ 2) / R) * E := by
      rw [hδ]
      field_simp [hR.ne']
    have hcoeff : 8 * A ^ 2 + 6 * B ^ 2 ≤ M ^ 2 := by
      dsimp only [M]
      nlinarith [sq_nonneg A, sq_nonneg B, mul_nonneg hA.le hB.le]
    have hfinal : ((8 * A ^ 2 + 6 * B ^ 2) / R) * E ≤
        M ^ 2 * δ * E := by
      rw [hδ]
      calc
        ((8 * A ^ 2 + 6 * B ^ 2) / R) * E ≤ (M ^ 2 / R) * E := by
          exact mul_le_mul_of_nonneg_right
            (div_le_div_of_nonneg_right hcoeff hR.le) hE
        _ = M ^ 2 * R⁻¹ * E := by ring
    calc
      8 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹ *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) +
        6 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) =
          8 * δ⁻¹ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) +
            6 * δ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) := by rfl
      _ ≤ 8 * δ⁻¹ * ((A / R) ^ 2 * E) + 6 * δ * (B ^ 2 * E) := hsamplebound
      _ = ((8 * A ^ 2 + 6 * B ^ 2) / R) * E := hformula
      _ ≤ M ^ 2 * δ * E := hfinal
      _ = M ^ 2 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j *
          ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by rfl

/-- Dyadic-time sampling preserves a half-power of the nonstationary middle
gain: the continuous-time middle maximum has square energy `O(2⁻ʲ)`. -/
theorem aux_exists_memLp_two_and_integral_norm_sq_iSup_circleMiddleWaveContribution_le_dyadicGain
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ M : Real, 0 < M ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      MemLp (fun x : Euclidean 2 =>
        (⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal) 2 volume ∧
        (∫ x : Euclidean 2,
          ‖(⨆ t : Icc (1 : Real) 2,
            ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal‖ ^ 2) ≤
          M ^ 2 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j *
            ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨M, hM, hbound⟩ :=
    aux_exists_measurable_lintegral_iSup_circleMiddleWaveContribution_le_dyadicGain C
  refine ⟨M, hM, ?_⟩
  intro j f
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleMiddleWaveContribution C j t f x
  let Q : Euclidean 2 → ENNReal := fun x =>
    ⨆ t : Icc (1 : Real) 2, ENNReal.ofReal (‖F t.1 x‖ ^ 2)
  let K : Real := M ^ 2 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j *
    ∫ x : Euclidean 2, ‖f x‖ ^ 2
  obtain ⟨hQmeas, hQbound⟩ := hbound j f
  have hQmeas' : Measurable Q := by
    simpa only [F, Q] using hQmeas
  have hQbound' : (∫⁻ x : Euclidean 2, Q x) ≤ ENNReal.ofReal K := by
    simpa only [F, Q, K] using hQbound
  have hK : 0 ≤ K := by
    dsimp only [K]
    exact mul_nonneg (mul_nonneg (sq_nonneg _) (by
      dsimp only [_root_.Auto.Spherical.MSSBase.dyadicTimeScale]
      exact zpow_nonneg (by norm_num) _))
      (integral_nonneg fun _ => sq_nonneg _)
  have hsq :=
    _root_.Auto.Spherical.Auxiliary.memLp_two_toReal_sqrt_of_measurable_lintegral
      Q hQmeas' hK hQbound'
  have hjoint := aux_continuous_and_hasDerivAt_circleMiddleWaveContribution C j f
  have hFcont : Continuous (Function.uncurry F) := by
    simpa only [F] using hjoint.1
  have hordinary :=
    _root_.Auto.Spherical.Auxiliary.memLp_two_iSup_ennreal_norm_of_memLp_sqrt_iSup_ennreal_norm_sq
      (F := F) (a := (1 : Real)) (b := 2) (by norm_num) hFcont hsq.1 hsq.2
  simpa only [F, K] using hordinary

/-- The literal continuous-time maximal function of the nonstationary middle
wave on one dyadic annulus and the unit time slab.  This contains neither
endpoint contribution, so its summability below is independent of the MSS
local-smoothing input. -/
noncomputable def circleMiddleWaveMaximal
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Real :=
  fun x => (⨆ t : Icc (1 : Real) 2,
    ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal

/-- The dyadic middle-wave maximal terms have a literal geometric `L²` rate.
This is just the square-root form of the preceding square-energy estimate;
the ratio is `2⁻¹ᐟ²`. -/
private theorem circleMiddleWaveMaximal_eLpNorm_geometric
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ M : Real, 0 < M ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      MemLp (circleMiddleWaveMaximal C j f) 2 volume ∧
        eLpNorm (circleMiddleWaveMaximal C j f) 2 volume ≤
          (ENNReal.ofReal M * (ENNReal.ofReal (Real.sqrt (1 / 2 : Real))) ^ j) *
            eLpNorm (f : Euclidean 2 → Complex) 2 volume := by
  obtain ⟨M, hM, hbound⟩ :=
    aux_exists_memLp_two_and_integral_norm_sq_iSup_circleMiddleWaveContribution_le_dyadicGain C
  refine ⟨M, hM, ?_⟩
  intro j f
  let G : Euclidean 2 → Real := circleMiddleWaveMaximal C j f
  obtain ⟨hGmem, hGbound⟩ := hbound j f
  have hGmem' : MemLp G 2 volume := by
    change MemLp (fun x : Euclidean 2 =>
      (⨆ t : Icc (1 : Real) 2,
        ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal) 2 volume
    exact hGmem
  have hfmem : MemLp (f : Euclidean 2 → Complex) 2 volume := f.memLp 2 volume
  have hGeq :
      eLpNorm G 2 volume =
        ENNReal.ofReal ((∫ x : Euclidean 2, ‖G x‖ ^ 2) ^ ((2 : Real)⁻¹)) := by
    rw [hGmem'.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    norm_num
  have hfeq :
      eLpNorm (f : Euclidean 2 → Complex) 2 volume =
        ENNReal.ofReal ((∫ x : Euclidean 2, ‖f x‖ ^ 2) ^ ((2 : Real)⁻¹)) := by
    rw [hfmem.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    norm_num
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hE : 0 ≤ E := by
    dsimp only [E]
    exact integral_nonneg fun _ => sq_nonneg _
  have hGint : (∫ x : Euclidean 2, ‖G x‖ ^ 2) ≤
      M ^ 2 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j * E := by
    change (∫ x : Euclidean 2, ‖(⨆ t : Icc (1 : Real) 2,
      ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal‖ ^ 2) ≤
        M ^ 2 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j *
          ∫ x : Euclidean 2, ‖f x‖ ^ 2
    exact hGbound
  have hbudget :
      (M ^ 2 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j * E) ^ ((2 : Real)⁻¹) =
        (M * (Real.sqrt (1 / 2 : Real)) ^ j) * E ^ ((2 : Real)⁻¹) := by
    rw [show _root_.Auto.Spherical.MSSBase.dyadicTimeScale j = (1 / 2 : Real) ^ j by
      rw [dyadicTimeScale_eq_inv_natPow]
      rw [show (1 / 2 : Real) = (2 : Real)⁻¹ by norm_num, inv_pow]
      norm_num [Nat.cast_pow]]
    have hrho : 0 ≤ Real.sqrt (1 / 2 : Real) := Real.sqrt_nonneg _
    have hsquare : (M * (Real.sqrt (1 / 2 : Real)) ^ j) ^ 2 =
        M ^ 2 * (1 / 2 : Real) ^ j := by
      rw [mul_pow, show (Real.sqrt (1 / 2 : Real) ^ j) ^ 2 =
        (1 / 2 : Real) ^ j by
          rw [← pow_mul, Nat.mul_comm, pow_mul, Real.sq_sqrt (by norm_num)]]
    rw [← hsquare]
    rw [show (M * (Real.sqrt (1 / 2 : Real)) ^ j) ^ 2 * E =
      ((M * (Real.sqrt (1 / 2 : Real)) ^ j) ^ 2) * E by ring]
    rw [Real.mul_rpow (sq_nonneg _) hE]
    have hpow : ((M * (Real.sqrt (1 / 2 : Real)) ^ j) ^ 2) ^ ((2 : Real)⁻¹) =
        M * (Real.sqrt (1 / 2 : Real)) ^ j := by
      rw [show (2 : Real)⁻¹ = 1 / 2 by norm_num, ← Real.sqrt_eq_rpow]
      rw [Real.sqrt_sq_eq_abs]
      rw [abs_of_nonneg (mul_nonneg hM.le (pow_nonneg hrho _))]
    rw [hpow]
  have hroot : (∫ x : Euclidean 2, ‖G x‖ ^ 2) ^ ((2 : Real)⁻¹) ≤
      (M * (Real.sqrt (1 / 2 : Real)) ^ j) * E ^ ((2 : Real)⁻¹) := by
    calc
      (∫ x : Euclidean 2, ‖G x‖ ^ 2) ^ ((2 : Real)⁻¹) ≤
          (M ^ 2 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j * E) ^ ((2 : Real)⁻¹) :=
        Real.rpow_le_rpow (integral_nonneg fun _ => sq_nonneg _) hGint (by positivity)
      _ = _ := hbudget
  rw [hGeq, hfeq]
  refine ⟨?_, ?_⟩
  · simpa only [G] using hGmem'
  · calc
      ENNReal.ofReal ((∫ x : Euclidean 2, ‖G x‖ ^ 2) ^ ((2 : Real)⁻¹)) ≤
          ENNReal.ofReal ((M * (Real.sqrt (1 / 2 : Real)) ^ j) * E ^ ((2 : Real)⁻¹)) :=
        ENNReal.ofReal_le_ofReal hroot
      _ = (ENNReal.ofReal M * (ENNReal.ofReal (Real.sqrt (1 / 2 : Real))) ^ j) *
            ENNReal.ofReal (E ^ ((2 : Real)⁻¹)) := by
        rw [ENNReal.ofReal_mul (mul_nonneg hM.le (pow_nonneg (Real.sqrt_nonneg _) _)),
          ENNReal.ofReal_mul hM.le,
          ENNReal.ofReal_pow (Real.sqrt_nonneg _)]

/-- The literal middle-wave maxima are summable over every finite collection
of dyadic annuli in `L²`.  The theorem is a concrete assembly for the
nonstationary term alone and makes no endpoint or local-smoothing assertion. -/
theorem exists_memLp_two_and_eLpNorm_sum_circleMiddleWaveMaximal_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ M : Real, 0 < M ∧ ENNReal.ofReal (Real.sqrt (1 / 2 : Real)) < 1 ∧
      ∀ (N : Nat) (f : SchwartzMap (Euclidean 2) Complex),
        MemLp (fun x : Euclidean 2 =>
          ∑ j ∈ Finset.range N, circleMiddleWaveMaximal C j f x) 2 volume ∧
          eLpNorm (fun x : Euclidean 2 =>
            ∑ j ∈ Finset.range N, circleMiddleWaveMaximal C j f x) 2 volume ≤
            (ENNReal.ofReal M * eLpNorm (f : Euclidean 2 → Complex) 2 volume) *
              (1 - ENNReal.ofReal (Real.sqrt (1 / 2 : Real)))⁻¹ := by
  obtain ⟨M, hM, hpiece⟩ := circleMiddleWaveMaximal_eLpNorm_geometric C
  have hrho_real : Real.sqrt (1 / 2 : Real) < 1 := by
    rw [Real.sqrt_lt' (by norm_num)]
    norm_num
  have hrho : ENNReal.ofReal (Real.sqrt (1 / 2 : Real)) < 1 := by
    rw [ENNReal.ofReal_lt_one]
    exact hrho_real
  refine ⟨M, hM, hrho, ?_⟩
  intro N f
  let T : Nat → Euclidean 2 → Real := fun j => circleMiddleWaveMaximal C j f
  have hTmem (j : Nat) : MemLp (T j) 2 volume := by
    dsimp only [T]
    exact (hpiece j f).1
  have hTmeas (j : Nat) : AEStronglyMeasurable (T j) volume := (hTmem j).1
  have hsum_mem : MemLp (fun x : Euclidean 2 => ∑ j ∈ Finset.range N, T j x)
      2 volume := by
    induction N with
    | zero => simp
    | succ n ih =>
        have hadd := ih.add (hTmem n)
        convert hadd using 1
        funext x
        simp only [Finset.sum_range_succ, Pi.add_apply]
  refine ⟨?_, ?_⟩
  · simpa only [T] using hsum_mem
  · have hsum := Auto.Spherical.Auxiliary.eLpNorm_sum_range_le_geometric
      volume 2 (by norm_num) T hTmeas
        (ENNReal.ofReal M * eLpNorm (f : Euclidean 2 → Complex) 2 volume)
        (ENNReal.ofReal (Real.sqrt (1 / 2 : Real))) ?_ N
    · simpa only [T] using hsum
    · intro j
      have h := hpiece j f
      change eLpNorm (T j) 2 volume ≤
        (ENNReal.ofReal M * eLpNorm (f : Euclidean 2 → Complex) 2 volume) *
          ENNReal.ofReal (Real.sqrt (1 / 2 : Real)) ^ j
      simpa only [T, mul_assoc, mul_left_comm, mul_comm] using h.2

theorem aux_exists_memLp_two_and_integral_norm_sq_iSup_circleMiddleWaveContribution_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ M : Real, 0 < M ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      MemLp (fun x : Euclidean 2 =>
        (⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal) 2 volume ∧
        (∫ x : Euclidean 2,
          ‖(⨆ t : Icc (1 : Real) 2,
            ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal‖ ^ 2) ≤
          M ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨A, hA, hmiddle⟩ :=
    aux_exists_integral_norm_sq_circleMiddleWaveContribution_le_dyadicInverse C
  obtain ⟨B, hB, hderiv⟩ :=
    aux_exists_intervalIntegral_integral_norm_sq_circleMiddleWaveContributionTimeDerivative_le C
  let M : Real := 2 * (A + B)
  have hM : 0 < M := by
    dsimp only [M]
    positivity
  refine ⟨M, hM, ?_⟩
  intro j f
  obtain ⟨hmaxmem, hmaxsob⟩ :=
    aux_memLp_two_and_integral_norm_sq_iSup_circleMiddleWaveContribution_le_timeSobolev C j f
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hE : 0 ≤ E := by
    dsimp only [E]
    exact integral_nonneg fun _ => sq_nonneg _
  have hscale_pos : 0 < dyadicScale j := dyadicScale_pos j
  have hscale_one : 1 ≤ dyadicScale j := by
    calc
      1 = dyadicScale 0 := by simp [dyadicScale]
      _ ≤ dyadicScale j := dyadicScale_mono (Nat.zero_le j)
  have hratio_nonneg : 0 ≤ A / dyadicScale j :=
    div_nonneg hA.le hscale_pos.le
  have hratio_le : A / dyadicScale j ≤ A := by
    rw [div_le_iff₀ hscale_pos]
    exact le_mul_of_one_le_right hA.le hscale_one
  have hratio_sq : (A / dyadicScale j) ^ 2 ≤ A ^ 2 := by
    nlinarith [mul_self_le_mul_self hratio_nonneg hratio_le]
  have hinitial :
      (∫ x : Euclidean 2, ‖circleMiddleWaveContribution C j 1 f x‖ ^ 2) ≤ A ^ 2 * E := by
    calc
      (∫ x : Euclidean 2, ‖circleMiddleWaveContribution C j 1 f x‖ ^ 2) ≤
          (A / dyadicScale j) ^ 2 * E := by
            simpa only [E] using hmiddle j 1 (by norm_num) (by norm_num) f
      _ ≤ A ^ 2 * E := mul_le_mul_of_nonneg_right hratio_sq hE
  have hderivative :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
        ‖aux_circleMiddleWaveContributionTimeDerivative C j t f x‖ ^ 2) ≤ B ^ 2 * E := by
    simpa only [E] using hderiv j f
  have hmaxenergy :
      (∫ x : Euclidean 2,
        ‖(⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal‖ ^ 2) ≤
        (2 * A ^ 2 + 2 * B ^ 2) * E := by
    calc
      (∫ x : Euclidean 2,
        ‖(⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal‖ ^ 2) ≤
          2 * (∫ x : Euclidean 2, ‖circleMiddleWaveContribution C j 1 f x‖ ^ 2) +
            2 * ((2 : Real) - 1) *
              ∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
                ‖aux_circleMiddleWaveContributionTimeDerivative C j t f x‖ ^ 2 := hmaxsob
      _ ≤ 2 * (A ^ 2 * E) + 2 * (B ^ 2 * E) := by
        norm_num
        exact add_le_add
          (mul_le_mul_of_nonneg_left hinitial (by norm_num))
          (mul_le_mul_of_nonneg_left hderivative (by norm_num))
      _ = (2 * A ^ 2 + 2 * B ^ 2) * E := by ring
  have hAB : 0 ≤ A * B := mul_nonneg hA.le hB.le
  have hcoeff : 2 * A ^ 2 + 2 * B ^ 2 ≤ M ^ 2 := by
    dsimp only [M]
    nlinarith [sq_nonneg (A - B)]
  refine ⟨hmaxmem, ?_⟩
  exact hmaxenergy.trans (mul_le_mul_of_nonneg_right hcoeff hE)

private theorem aux_fourierInv_add_of_integrable
    (g h : Euclidean 2 → Complex) (hg : Integrable g) (hh : Integrable h)
    (x : Euclidean 2) :
    𝓕⁻ (g + h) x = 𝓕⁻ g x + 𝓕⁻ h x := by
  have hgchar : Integrable
      (fun xi : Euclidean 2 => Real.fourierChar (inner Real xi x) • g xi) := by
    refine Integrable.mono' hg.norm ?_ ?_
    · exact ((by fun_prop : Continuous (fun xi : Euclidean 2 =>
        Real.fourierChar (inner Real xi x))).aestronglyMeasurable).smul
          hg.aestronglyMeasurable
    · filter_upwards with xi
      simp
  have hhchar : Integrable
      (fun xi : Euclidean 2 => Real.fourierChar (inner Real xi x) • h xi) := by
    refine Integrable.mono' hh.norm ?_ ?_
    · exact ((by fun_prop : Continuous (fun xi : Euclidean 2 =>
        Real.fourierChar (inner Real xi x))).aestronglyMeasurable).smul
          hh.aestronglyMeasurable
    · filter_upwards with xi
      simp
  rw [Real.fourierInv_eq, Real.fourierInv_eq, Real.fourierInv_eq]
  change (∫ v : Euclidean 2,
      Real.fourierChar (inner Real v x) • (g v + h v)) = _
  rw [show (fun v : Euclidean 2 =>
      Real.fourierChar (inner Real v x) • (g v + h v)) =
        (fun v : Euclidean 2 =>
          Real.fourierChar (inner Real v x) • g v +
            Real.fourierChar (inner Real v x) • h v) by
      funext v
      rw [smul_add], MeasureTheory.integral_add hgchar hhchar]

private theorem aux_const_mul_fourierInv
    (a : Complex) (g : Euclidean 2 → Complex) (x : Euclidean 2) :
    a * 𝓕⁻ g x = 𝓕⁻ (fun xi => a * g xi) x := by
  rw [Real.fourierInv_eq, Real.fourierInv_eq, ← MeasureTheory.integral_const_mul]
  apply MeasureTheory.integral_congr_ae
  filter_upwards with xi
  change a * (Real.fourierChar (inner Real xi x) • g xi) =
    Real.fourierChar (inner Real xi x) • (a * g xi)
  rw [show a * (Real.fourierChar (inner Real xi x) • g xi) =
      (Real.fourierChar (inner Real xi x) : Complex) * (a * g xi) by
        change a * ((Real.fourierChar (inner Real xi x) : Complex) * g xi) = _
        ring]
  rfl

private theorem aux_circleEndpointAmplitude_mul_halfWaveMultiplier_minus
    (t : Real) (xi : Euclidean 2) :
    circleEndpointAmplitude _root_.Auto.Spherical.MSSBase.WaveSign.minus
        (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.Spherical.MSSBase.halfWaveMultiplier
        _root_.Auto.Spherical.MSSBase.WaveSign.minus t xi =
      Complex.exp (((-(2 * Real.pi * (t * ‖xi‖)) : Real) : Complex) * Complex.I) *
        Auto.Spherical.FractalDilations.Auxiliary.planarEndpointQuadraticIntegral
          (2 * Real.pi * (t * ‖xi‖)) := by
  simp only [circleEndpointAmplitude,
    _root_.Auto.Spherical.MSSBase.halfWaveMultiplier,
    _root_.Auto.Spherical.MSSBase.WaveSign.toReal]
  rw [mul_comm]
  congr 1
  push_cast
  ring

private theorem aux_circleEndpointAmplitude_mul_halfWaveMultiplier_plus
    (t : Real) (xi : Euclidean 2) :
    circleEndpointAmplitude _root_.Auto.Spherical.MSSBase.WaveSign.plus
        (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.Spherical.MSSBase.halfWaveMultiplier
        _root_.Auto.Spherical.MSSBase.WaveSign.plus t xi =
      Complex.exp (((2 * Real.pi * (t * ‖xi‖) : Real) : Complex) * Complex.I) *
        Auto.Spherical.FractalDilations.Auxiliary.planarEndpointQuadraticIntegral
          (-(2 * Real.pi * (t * ‖xi‖))) := by
  simp only [circleEndpointAmplitude,
    _root_.Auto.Spherical.MSSBase.halfWaveMultiplier,
    _root_.Auto.Spherical.MSSBase.WaveSign.toReal]
  rw [mul_comm]
  congr 1
  push_cast
  ring

/-- Exact three-wave decomposition of a dyadic circular average.  The two
endpoint terms are factored through the MSS dyadic half-waves, while the
middle term remains its literal compact frequency-localized Fourier integral. -/
theorem circleDyadicBandpassThreeWaveDecomposition
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) {t : Real} (ht : 0 ≤ t)
    (x : Euclidean 2) :
    circularAverage t
        (dyadicBandpassProjection
          (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j) f :
          Euclidean 2 → Complex) x =
      circleEndpointWaveContribution C _root_.Auto.Spherical.MSSBase.WaveSign.minus j t f x +
        circleEndpointWaveContribution C _root_.Auto.Spherical.MSSBase.WaveSign.plus j t f x +
          circleMiddleWaveContribution C j t f x := by
  let qminus : Euclidean 2 → Complex := fun xi =>
    ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      circleEndpointAmplitude _root_.Auto.Spherical.MSSBase.WaveSign.minus
        (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.Spherical.MSSBase.halfWaveMultiplier
        _root_.Auto.Spherical.MSSBase.WaveSign.minus t xi *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
      𝓕 (f : Euclidean 2 → Complex) xi
  let qplus : Euclidean 2 → Complex := fun xi =>
    ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      circleEndpointAmplitude _root_.Auto.Spherical.MSSBase.WaveSign.plus
        (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.Spherical.MSSBase.halfWaveMultiplier
        _root_.Auto.Spherical.MSSBase.WaveSign.plus t xi *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
      𝓕 (f : Euclidean 2 → Complex) xi
  let qmiddle : Euclidean 2 → Complex := fun xi =>
    ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianLocalizedIntegral
        0 (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
      𝓕 (f : Euclidean 2 → Complex) xi
  have hqminus : Integrable qminus := by
    apply aux_integrable_continuous_mul_dyadicBandpass_fourier C j
    exact (((continuous_const.mul continuous_const).mul
      (aux_continuous_circleEndpointAmplitude _root_.Auto.Spherical.MSSBase.WaveSign.minus t)).mul
      (aux_continuous_halfWaveMultiplier
        _root_.Auto.Spherical.MSSBase.WaveSign.minus t))
  have hqplus : Integrable qplus := by
    apply aux_integrable_continuous_mul_dyadicBandpass_fourier C j
    exact (((continuous_const.mul continuous_const).mul
      (aux_continuous_circleEndpointAmplitude _root_.Auto.Spherical.MSSBase.WaveSign.plus t)).mul
      (aux_continuous_halfWaveMultiplier
        _root_.Auto.Spherical.MSSBase.WaveSign.plus t))
  have hqmiddle : Integrable qmiddle := by
    apply aux_integrable_continuous_mul_dyadicBandpass_fourier C j
    exact ((continuous_const.mul continuous_const).mul
      (aux_continuous_coordinateMiddleMeridianLocalizedIntegral_zero.comp (by fun_prop)))
  rw [circleBandpassFourierCoordinateWaveNormalForm
    (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j) f ht x]
  rw [aux_const_mul_fourierInv]
  let core : Euclidean 2 → Complex := fun xi =>
    Complex.exp (((-(2 * Real.pi * (t * ‖xi‖)) : Real) : Complex) * Complex.I) *
        Auto.Spherical.FractalDilations.Auxiliary.planarEndpointQuadraticIntegral
          (2 * Real.pi * (t * ‖xi‖)) +
      Complex.exp (((2 * Real.pi * (t * ‖xi‖) : Real) : Complex) * Complex.I) *
        Auto.Spherical.FractalDilations.Auxiliary.planarEndpointQuadraticIntegral
          (-(2 * Real.pi * (t * ‖xi‖))) +
      Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianLocalizedIntegral
        0 (2 * Real.pi * (t * ‖xi‖))
  have hsymbol :
      (fun xi : Euclidean 2 =>
        ((surfaceMass 2)⁻¹ : Complex) *
          (((surfaceMass 1 : Complex) * core xi) *
            (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
              𝓕 (f : Euclidean 2 → Complex) xi))) = qminus + qplus + qmiddle := by
    funext xi
    change _ = qminus xi + qplus xi + qmiddle xi
    dsimp only [qminus, qplus, qmiddle, core]
    rw [← aux_circleEndpointAmplitude_mul_halfWaveMultiplier_minus,
      ← aux_circleEndpointAmplitude_mul_halfWaveMultiplier_plus]
    ring
  change 𝓕⁻ (fun xi : Euclidean 2 =>
    ((surfaceMass 2)⁻¹ : Complex) *
      (((surfaceMass 1 : Complex) * core xi) *
        (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
          𝓕 (f : Euclidean 2 → Complex) xi))) x = _
  calc
    _ = 𝓕⁻ (qminus + qplus + qmiddle) x :=
      congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x) hsymbol
    _ = 𝓕⁻ qminus x + 𝓕⁻ qplus x + 𝓕⁻ qmiddle x := by
      rw [aux_fourierInv_add_of_integrable (qminus + qplus) qmiddle
        (hqminus.add hqplus) hqmiddle,
        aux_fourierInv_add_of_integrable qminus qplus hqminus hqplus]
    _ = _ := by
      rw [circleEndpointWaveContribution_factorization,
        circleEndpointWaveContribution_factorization]
      rfl

/-- A direct short-time `L²` circular-maximal estimate for a smooth dyadic
bandpass.  The theorem is the already formalized radius-Sobolev consequence
of `circleStationaryPhase`; it is recorded here under the Bourgain namespace
because it is the low-level high-frequency input preceding local smoothing. -/
theorem circleBandpassShortIntervalL2
    (phi f psi : SchwartzMap (ℝ^2) Complex)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (hpsi : ∀ xi : ℝ^2,
      psi xi = phi (((2 : Real) ^ (j + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ j)⁻¹ • xi))
    (hpsi_compact : HasCompactSupport (psi : ℝ^2 → Complex))
    {a b : Real} (hab : a ≤ b) (hinterval : Icc a b ⊆ Icc (1 : Real) 2) :
    ∃ C0 C1 : Real, 0 < C0 ∧ 0 < C1 ∧
      MemLp (sphericalIntervalMaximalRaw a b (dyadicBandpassProjection psi f))
        2 volume ∧
      (∫ x : ℝ^2,
        ‖sphericalIntervalMaximalRaw a b (dyadicBandpassProjection psi f) x‖ ^ 2) ≤
        (2 * ((2 * C0) / dyadicScale j ^ ((1 : Real) / 2)) ^ 2 +
          2 * (b - a) ^ 2 *
            (4 * C1 * dyadicScale j ^ ((1 : Real) / 2)) ^ 2) *
          ∫ x : ℝ^2, ‖f x‖ ^ 2 := by
  exact sphericalIntervalMaximalRaw_memLp_two_of_hasCircleSurfaceFourierSharpBounds
    circleStationaryPhase phi f psi hphi_one hphi_zero hphi_norm j hpsi hpsi_compact
    hab hinterval

/-- At the reciprocal frequency time scale, the sharp circle Fourier bounds
give the `2^{-j}` square-moment gain for one localized radius interval.  This
is the proved `L²` annular bridge that precedes the unavailable all-`p`
circle-wave/Mikhlin step in the blueprint. -/
theorem circleBandpassReciprocalIntervalL2
    (phi f psi : SchwartzMap (ℝ^2) Complex)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (hpsi : ∀ xi : ℝ^2,
      psi xi = phi (((2 : Real) ^ (j + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ j)⁻¹ • xi))
    (hpsi_compact : HasCompactSupport (psi : ℝ^2 → Complex))
    {a b : Real} (hab : a ≤ b) (hinterval : Icc a b ⊆ Icc (1 : Real) 2)
    (hlength : b - a ≤ (dyadicScale j)⁻¹) :
    ∃ B : Real, 0 < B ∧
      MemLp (sphericalIntervalMaximalRaw a b (dyadicBandpassProjection psi f))
        2 volume ∧
      (∫ x : ℝ^2,
        ‖sphericalIntervalMaximalRaw a b (dyadicBandpassProjection psi f) x‖ ^ 2) ≤
        (B * (dyadicScale j) ^ (-1 : Real)) *
          ∫ x : ℝ^2, ‖f x‖ ^ 2 := by
  rcases circleBandpassShortIntervalL2 phi f psi hphi_one hphi_zero hphi_norm j
    hpsi hpsi_compact hab hinterval with ⟨C0, C1, hC0, hC1, hmem, hbound⟩
  have hRone : 1 ≤ dyadicScale j := by
    calc
      1 = dyadicScale 0 := by simp [dyadicScale]
      _ ≤ dyadicScale j := dyadicScale_mono (Nat.zero_le j)
  refine ⟨8 * C0 ^ 2 + 32 * C1 ^ 2, by positivity, hmem, hbound.trans ?_⟩
  apply mul_le_mul_of_nonneg_right
    (circle_short_interval_l2_coefficient_le_frequency_decay C0 C1 hC0.le hC1.le
      (dyadicScale_pos j) hRone (sub_nonneg.mpr hab) hlength)
  exact integral_nonneg fun _ => sq_nonneg _

/-- Assemble the sharp circle short-interval estimate over an arbitrary
finite cover of the unit radius block at reciprocal dyadic scale.  This is
the exact finite-cover step behind the observation that `O(2^j)` intervals
of length `2^{-j}` cancel the `2^{-j}` local `L²` factor. -/
theorem circleBandpassUnitIntervalL2_of_finiteCover
    {ι : Type*} (hcircle : HasCircleSurfaceFourierSharpBounds)
    (phi f psi : SchwartzMap (ℝ^2) Complex)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (hpsi : ∀ xi : ℝ^2,
      psi xi = phi (((2 : Real) ^ (j + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ j)⁻¹ • xi))
    (hpsi_compact : HasCompactSupport (psi : ℝ^2 → Complex))
    (s : Finset ι) (hs : s.Nonempty) (a b : ι → Real)
    (hcover : Icc (1 : Real) 2 ⊆ ⋃ i ∈ s, Icc (a i) (b i))
    (hinterval : ∀ i ∈ s, Icc (a i) (b i) ⊆ Icc (1 : Real) 2)
    (hab : ∀ i ∈ s, a i ≤ b i)
    (hlength : ∀ i ∈ s, b i - a i ≤ (dyadicScale j)⁻¹) :
    ∃ B : Real, 0 < B ∧
      MemLp (unnormalizedFractalDyadicBandpassMaximal 2 (Icc (1 : Real) 2) psi f)
        2 volume ∧
      (∫ x : ℝ^2,
        ‖unnormalizedFractalDyadicBandpassMaximal 2 (Icc (1 : Real) 2) psi f x‖ ^ 2) ≤
        (s.card : Real) * (B * (dyadicScale j) ^ (-1 : Real)) *
          ∫ x : ℝ^2, ‖f x‖ ^ 2 := by
  rcases hcircle with ⟨C0, C1, hC0, hC1, hdecay, hderiv⟩
  let B : Real := 8 * C0 ^ 2 + 32 * C1 ^ 2
  have hB : 0 < B := by
    dsimp only [B]
    positivity
  have hRpos : 0 < dyadicScale j := dyadicScale_pos j
  have hRone : 1 ≤ dyadicScale j := by
    calc
      1 = dyadicScale 0 := by simp [dyadicScale]
      _ ≤ dyadicScale j := dyadicScale_mono (Nat.zero_le j)
  have hlocal : ∀ i ∈ s,
      MemLp (sphericalIntervalMaximalRaw (a i) (b i)
        (dyadicBandpassProjection psi f)) 2 volume ∧
      (∫ x : ℝ^2,
        ‖sphericalIntervalMaximalRaw (a i) (b i)
          (dyadicBandpassProjection psi f) x‖ ^ 2) ≤
        (B * (dyadicScale j) ^ (-1 : Real)) * ∫ x : ℝ^2, ‖f x‖ ^ 2 := by
    intro i hi
    rcases sphericalIntervalMaximalRaw_memLp_two_of_circle_sharp
      C0 C1 hC0 hC1 hdecay hderiv phi f psi hphi_one hphi_zero hphi_norm j
      hpsi hpsi_compact (hab i hi) (hinterval i hi) with ⟨hmem, hbound⟩
    refine ⟨hmem, hbound.trans ?_⟩
    apply mul_le_mul_of_nonneg_right
      (circle_short_interval_l2_coefficient_le_frequency_decay C0 C1 hC0.le hC1.le
        hRpos hRone (sub_nonneg.mpr (hab i hi)) (hlength i hi))
    exact integral_nonneg fun _ => sq_nonneg _
  obtain ⟨hmem, hbound⟩ :=
    unnormalizedFractalDyadicBandpass_memLp_two_of_finite_raw_cover
      (d := 2) (by norm_num) (Icc (1 : Real) 2) psi s hs a b hcover
      (by
        intro r hr
        change 0 < r
        exact lt_of_lt_of_le zero_lt_one hr.1) (by
        intro i hi r hr
        change 0 < r
        exact lt_of_lt_of_le zero_lt_one (hinterval i hi hr).1) hab f hlocal
  exact ⟨B, hB, hmem, hbound⟩

/-- The reciprocal-scale dyadic grid on `[1,2]` has bounded total
short-interval `L²` cost.  This packages the preceding finite-cover theorem
with the elementary grid, including the two clipped boundary cells. -/
theorem circleBandpassUnitIntervalL2
    (phi f psi : SchwartzMap (ℝ^2) Complex)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (hpsi : ∀ xi : ℝ^2,
      psi xi = phi (((2 : Real) ^ (j + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ j)⁻¹ • xi))
    (hpsi_compact : HasCompactSupport (psi : ℝ^2 → Complex)) :
    ∃ B : Real, 0 < B ∧
      MemLp (unnormalizedFractalDyadicBandpassMaximal 2 (Icc (1 : Real) 2) psi f)
        2 volume ∧
      (∫ x : ℝ^2,
        ‖unnormalizedFractalDyadicBandpassMaximal 2 (Icc (1 : Real) 2) psi f x‖ ^ 2) ≤
        B * ∫ x : ℝ^2, ‖f x‖ ^ 2 := by
  let s : Finset Int :=
    Auto.FractalDimensions.dyadicIndexRange j
  let a : Int → Real := fun k =>
    max 1 (Auto.FractalDimensions.dyadicLeft j k)
  let b : Int → Real := fun k =>
    min 2 (Auto.FractalDimensions.dyadicRight j k)
  have hdelta_pos : 0 < Auto.FractalDimensions.dyadicScale j :=
    Auto.FractalDimensions.dyadicScale_pos j
  have hscale_eq :
      Auto.FractalDimensions.dyadicScale j =
        (dyadicScale j)⁻¹ := by
    simp [Auto.FractalDimensions.dyadicScale,
      Auto.FractalDimensions.dyadicDenom, dyadicScale,
      Nat.cast_pow]
  have hs : s.Nonempty := by
    refine ⟨0, ?_⟩
    change (0 : Int) ∈ Auto.FractalDimensions.dyadicIndexRange j
    rw [Auto.FractalDimensions.dyadicIndexRange,
      Finset.mem_Icc]
    omega
  have hcover : Icc (1 : Real) 2 ⊆ ⋃ k ∈ s, Icc (a k) (b k) := by
    intro r hr
    rcases Set.mem_iUnion.mp
      (Auto.FractalDimensions.dyadicIndexRange_covers_Icc j hr)
      with ⟨k, hk⟩
    rcases Set.mem_iUnion.mp hk with ⟨hks, hrk⟩
    refine Set.mem_iUnion.mpr ⟨k, Set.mem_iUnion.mpr ⟨hks, ?_⟩⟩
    change max 1 (Auto.FractalDimensions.dyadicLeft j k) ≤ r ∧
      r ≤ min 2 (Auto.FractalDimensions.dyadicRight j k)
    exact ⟨max_le hr.1 hrk.1, le_min hr.2 hrk.2⟩
  have hinterval : ∀ k ∈ s, Icc (a k) (b k) ⊆ Icc (1 : Real) 2 := by
    intro k hk r hr
    exact ⟨(le_max_left _ _).trans hr.1, hr.2.trans (min_le_left _ _)⟩
  have hab : ∀ k ∈ s, a k ≤ b k := by
    intro k hk
    have hkrange : k ∈ Auto.FractalDimensions.dyadicIndexRange j := hk
    rw [Auto.FractalDimensions.dyadicIndexRange,
      Finset.mem_Icc] at hkrange
    have hkplus : 0 ≤ ((k + 1 : Int) : Real) := by
      exact_mod_cast (show 0 ≤ k + 1 by omega)
    have hkupper : (k : Real) ≤
        (Auto.FractalDimensions.dyadicDenom j : Real) := by
      exact_mod_cast hkrange.2
    have hright_one : 1 ≤
        Auto.FractalDimensions.dyadicRight j k := by
      rw [Auto.FractalDimensions.dyadicRight]
      nlinarith [mul_nonneg hkplus hdelta_pos.le]
    have hleft_two : Auto.FractalDimensions.dyadicLeft j k ≤ 2 := by
      have hmul : (k : Real) *
          Auto.FractalDimensions.dyadicScale j ≤
          (Auto.FractalDimensions.dyadicDenom j : Real) *
            Auto.FractalDimensions.dyadicScale j :=
        mul_le_mul_of_nonneg_right hkupper hdelta_pos.le
      rw [Auto.FractalDimensions.dyadicLeft]
      calc
        1 + (k : Real) *
            Auto.FractalDimensions.dyadicScale j ≤
            1 + (Auto.FractalDimensions.dyadicDenom j : Real) *
              Auto.FractalDimensions.dyadicScale j := by linarith
        _ = 2 := by
          rw [mul_comm,
            Auto.FractalDimensions.dyadicScale_mul_denom]
          norm_num
    have hleft_right : Auto.FractalDimensions.dyadicLeft j k ≤
        Auto.FractalDimensions.dyadicRight j k := by
      have hsub :=
        Auto.FractalDimensions.dyadicRight_sub_dyadicLeft j k
      linarith
    change max 1 (Auto.FractalDimensions.dyadicLeft j k) ≤
      min 2 (Auto.FractalDimensions.dyadicRight j k)
    apply max_le
    · exact le_min (by norm_num) hright_one
    · exact le_min hleft_two hleft_right
  have hlength : ∀ k ∈ s, b k - a k ≤ (dyadicScale j)⁻¹ := by
    intro k hk
    change min 2 (Auto.FractalDimensions.dyadicRight j k) -
        max 1 (Auto.FractalDimensions.dyadicLeft j k) ≤
          (dyadicScale j)⁻¹
    calc
      min 2 (Auto.FractalDimensions.dyadicRight j k) -
          max 1 (Auto.FractalDimensions.dyadicLeft j k) ≤
          Auto.FractalDimensions.dyadicRight j k -
            Auto.FractalDimensions.dyadicLeft j k :=
        sub_le_sub (min_le_right _ _) (le_max_right _ _)
      _ = Auto.FractalDimensions.dyadicScale j :=
        Auto.FractalDimensions.dyadicRight_sub_dyadicLeft j k
      _ = _ := hscale_eq
  obtain ⟨B, hB, hmem, hbound⟩ :=
    circleBandpassUnitIntervalL2_of_finiteCover circleStationaryPhase
      phi f psi hphi_one hphi_zero hphi_norm j hpsi hpsi_compact
      s hs a b hcover hinterval hab hlength
  have hRone : 1 ≤ dyadicScale j := by
    calc
      1 = dyadicScale 0 := by simp [dyadicScale]
      _ ≤ dyadicScale j := dyadicScale_mono (Nat.zero_le j)
  have hRinv : (dyadicScale j)⁻¹ ≤ 1 := by
    have h := one_div_le_one_div_of_le zero_lt_one hRone
    simpa [one_div] using h
  have hcard : (s.card : Real) * (dyadicScale j) ^ (-1 : Real) ≤ 3 := by
    rw [Real.rpow_neg_one]
    change ((Auto.FractalDimensions.dyadicIndexRange j).card : Real) *
        (dyadicScale j)⁻¹ ≤ 3
    rw [Auto.FractalDimensions.card_dyadicIndexRange]
    have hdenom : (Auto.FractalDimensions.dyadicDenom j : Real) =
        dyadicScale j := by
      simp [Auto.FractalDimensions.dyadicDenom, dyadicScale,
        Nat.cast_pow]
    rw [Nat.cast_add, Nat.cast_ofNat, hdenom]
    calc
      (dyadicScale j + 2) * (dyadicScale j)⁻¹ =
          1 + 2 * (dyadicScale j)⁻¹ := by
        rw [add_mul, mul_inv_cancel₀ (ne_of_gt (dyadicScale_pos j))]
      _ ≤ 1 + 2 * 1 := by gcongr
      _ = 3 := by norm_num
  refine ⟨3 * B, by positivity, hmem, hbound.trans ?_⟩
  have hI : 0 ≤ ∫ x : ℝ^2, ‖f x‖ ^ 2 :=
    integral_nonneg fun _ => sq_nonneg _
  calc
    (s.card : Real) * (B * (dyadicScale j) ^ (-1 : Real)) *
        ∫ x : ℝ^2, ‖f x‖ ^ 2 =
        ((s.card : Real) * (dyadicScale j) ^ (-1 : Real)) *
          (B * ∫ x : ℝ^2, ‖f x‖ ^ 2) := by ring
    _ ≤ 3 * (B * ∫ x : ℝ^2, ‖f x‖ ^ 2) :=
      mul_le_mul_of_nonneg_right hcard (mul_nonneg hB.le hI)
    _ = (3 * B) * ∫ x : ℝ^2, ‖f x‖ ^ 2 := by ring

/-- The unit-radius dyadic circle estimate in `eLpNorm` form.  This merely
converts the already proved real square-moment estimate, retaining its
scale-uniform constant; it does not assert the geometric decay missing from
the Bourgain argument. -/
theorem aux_circleBandpassUnitIntervalL2_eLpNorm
    (phi f psi : SchwartzMap (ℝ^2) Complex)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (hpsi : ∀ xi : ℝ^2,
      psi xi = phi (((2 : Real) ^ (j + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ j)⁻¹ • xi))
    (hpsi_compact : HasCompactSupport (psi : ℝ^2 → Complex)) :
    ∃ B : Real, 0 < B ∧
      eLpNorm (unnormalizedFractalDyadicBandpassMaximal 2 (Icc (1 : Real) 2) psi f)
          2 volume ≤
        (ENNReal.ofReal B) ^ ((2 : Real)⁻¹) *
          eLpNorm (f : ℝ^2 → Complex) 2 volume := by
  obtain ⟨B, hB, hmem, hbound⟩ :=
    circleBandpassUnitIntervalL2 phi f psi hphi_one hphi_zero hphi_norm j hpsi hpsi_compact
  let U : Euclidean 2 → Real :=
    unnormalizedFractalDyadicBandpassMaximal 2 (Icc (1 : Real) 2) psi f
  have hUnonneg (x : Euclidean 2) : 0 ≤ U x := by
    exact unnormalizedFractalDyadicBandpassMaximal_nonneg (Icc (1 : Real) 2) psi f x
  refine ⟨B, hB, ?_⟩
  have hUmem : MemLp U 2 volume := by
    simpa only [U] using hmem
  have hfmem : MemLp (f : Euclidean 2 → Complex) 2 volume := f.memLp 2 volume
  have hUeq :
      eLpNorm U 2 volume =
        ENNReal.ofReal ((∫ x : Euclidean 2, ‖U x‖ ^ 2) ^ ((2 : Real)⁻¹)) := by
    rw [hUmem.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    norm_num
  have hfeq :
      eLpNorm (f : Euclidean 2 → Complex) 2 volume =
        ENNReal.ofReal ((∫ x : Euclidean 2, ‖f x‖ ^ 2) ^ ((2 : Real)⁻¹)) := by
    rw [hfmem.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    norm_num
  have hIu : 0 ≤ ∫ x : Euclidean 2, ‖U x‖ ^ 2 :=
    integral_nonneg fun _ => sq_nonneg _
  have hIf : 0 ≤ ∫ x : Euclidean 2, ‖f x‖ ^ 2 :=
    integral_nonneg fun _ => sq_nonneg _
  have hroot :
      (∫ x : Euclidean 2, ‖U x‖ ^ 2) ^ ((2 : Real)⁻¹) ≤
        B ^ ((2 : Real)⁻¹) *
          (∫ x : Euclidean 2, ‖f x‖ ^ 2) ^ ((2 : Real)⁻¹) := by
    calc
      (∫ x : Euclidean 2, ‖U x‖ ^ 2) ^ ((2 : Real)⁻¹) ≤
          (B * ∫ x : Euclidean 2, ‖f x‖ ^ 2) ^ ((2 : Real)⁻¹) :=
        Real.rpow_le_rpow hIu hbound (by positivity)
      _ = B ^ ((2 : Real)⁻¹) *
          (∫ x : Euclidean 2, ‖f x‖ ^ 2) ^ ((2 : Real)⁻¹) :=
        Real.mul_rpow hB.le hIf
  rw [hUeq, hfeq]
  calc
    ENNReal.ofReal ((∫ x : Euclidean 2, ‖U x‖ ^ 2) ^ ((2 : Real)⁻¹)) ≤
        ENNReal.ofReal
          (B ^ ((2 : Real)⁻¹) *
            (∫ x : Euclidean 2, ‖f x‖ ^ 2) ^ ((2 : Real)⁻¹)) :=
      ENNReal.ofReal_le_ofReal hroot
    _ = ENNReal.ofReal B ^ ((2 : Real)⁻¹) *
          ENNReal.ofReal ((∫ x : Euclidean 2, ‖f x‖ ^ 2) ^ ((2 : Real)⁻¹)) := by
      rw [ENNReal.ofReal_mul (Real.rpow_nonneg hB.le _),
        ← ENNReal.ofReal_rpow_of_nonneg hB.le (by positivity)]

/-! ### Uniform endpoint-multiplier interface

The stationary endpoint symbols above are Schwartz one at a time. The
remaining Mikhlin input in the circular argument is that their two physical
kernel seminorms are uniform after the dyadic rescaling. We keep that datum
as an explicit hypothesis here, rather than treating pointwise smoothness as
if it supplied a uniform multiplier bound. -/

/-- Parameters of the two endpoint multiplier families on the local time
slab. The time coordinate is carried as a subtype so the associated
compact-annular maximal family has exactly the range `1 ≤ t ≤ 2`. -/
abbrev aux_CircleAnnularEndpointLocalIndex :=
  _root_.Auto.Spherical.MSSBase.WaveSign × Nat × Icc (1 : Real) 2

/-- The unit-frequency Schwartz symbol obtained by transporting the `j`th
annular endpoint factor by `η ↦ 2^j η`.  This is the genuine symbol to which
the scale-uniform Mikhlin theorem applies. -/
noncomputable def aux_circleAnnularEndpointScaledSchwartzSymbol
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real) :
    SchwartzMap (Euclidean 2) Complex :=
  let A : Euclidean 2 ≃L[Real] Euclidean 2 :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 ((2 : Real) ^ j) (pow_ne_zero j (by norm_num)))
  (SchwartzMap.compCLMOfContinuousLinearEquiv Complex A)
    (circleAnnularEndpointSchwartzSymbol C σ j t)

/-- Coercion from the rescaled Schwartz package is the previously defined
unit-frequency endpoint symbol. -/
theorem aux_circleAnnularEndpointScaledSchwartzSymbol_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real)
    (η : Euclidean 2) :
    aux_circleAnnularEndpointScaledSchwartzSymbol C σ j t η =
      circleAnnularEndpointScaledSymbol C σ j t η := by
  change circleAnnularEndpointSchwartzSymbol C σ j t ((2 : Real) ^ j • η) =
    circleAnnularEndpointScaledSymbol C σ j t η
  rw [circleAnnularEndpointSchwartzSymbol_apply]
  rfl

/-- The frequency radius which returns a unit-frequency endpoint symbol to
the physical `j`th annulus. -/
def aux_circleAnnularEndpointDyadicScale (j : Nat) : Ioi (0 : Real) :=
  ⟨((2 : Real) ^ j)⁻¹, by
    change 0 < ((2 : Real) ^ j)⁻¹
    exact inv_pos.mpr (by positivity)⟩

/-- The Schwartz multiplier family obtained from the two stationary circle
endpoints, all dyadic levels, and unit-scale times, written at unit
frequency. -/
noncomputable def aux_circleAnnularEndpointSchwartzFamily
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    aux_CircleAnnularEndpointLocalIndex → SchwartzMap (Euclidean 2) Complex :=
  fun u => aux_circleAnnularEndpointScaledSchwartzSymbol C u.1 u.2.1 u.2.2

/-- The zero-order stationary estimate is uniform after rescaling to the
fixed annulus.  The dyadic half-normalization is absorbed by the
square-root stationary decay, while the fat cutoff excludes the origin. -/
theorem exists_norm_circleAnnularEndpointScaledSymbol_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 ≤ B ∧ ∀ (σ : _root_.Auto.Spherical.MSSBase.WaveSign)
      (j : Nat) (t : Real) (η : Euclidean 2),
      1 ≤ t → ‖circleAnnularEndpointScaledSymbol C σ j t η‖ ≤ B := by
  obtain ⟨A, hA, hdecay⟩ := exists_circleEndpointAmplitude_decay
  let B : Real := 2 * ‖((surfaceMass 2)⁻¹ : Complex)‖ * surfaceMass 1 * A
  have hmass : 0 ≤ surfaceMass 1 := (surfaceMass_pos (by norm_num)).le
  have hB : 0 ≤ B := by
    dsimp [B]
    exact mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) (norm_nonneg _)) hmass) hA.le
  refine ⟨B, hB, ?_⟩
  intro σ j t η ht
  rw [circleAnnularEndpointScaledSymbol_apply]
  by_cases hfat : _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff η = 0
  · simpa [hfat] using hB
  have hrsmall : (2 : Real) ^ (-2 : Int) < ‖η‖ := by
    apply lt_of_not_ge
    intro hη
    exact hfat
      (_root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype_eq_zero_of_norm_le
        C hη)
  have hr : (1 / 4 : Real) ≤ ‖η‖ := by
    norm_num [zpow_neg] at hrsmall ⊢
    exact hrsmall.le
  have ht0 : 0 ≤ t := zero_le_one.trans ht
  have htr : (1 / 4 : Real) ≤ t * ‖η‖ := by
    calc
      (1 / 4 : Real) = 1 * (1 / 4 : Real) := by ring
      _ ≤ t * ‖η‖ := mul_le_mul ht hr (by norm_num) ht0
  have hpi : (3 : Real) ≤ Real.pi := Real.pi_gt_three.le
  have hpit : 3 * (1 / 4 : Real) ≤ Real.pi * (t * ‖η‖) :=
    mul_le_mul hpi htr (by norm_num) (by linarith [Real.pi_gt_three])
  have hfactor : 1 ≤ 2 * Real.pi * t * ‖η‖ := by
    nlinarith
  have hs : 0 ≤ (2 : Real) ^ j := by positivity
  have hlambda : (2 : Real) ^ j ≤ (2 * Real.pi * t * (2 : Real) ^ j) * ‖η‖ := by
    rw [show (2 * Real.pi * t * (2 : Real) ^ j) * ‖η‖ =
        (2 : Real) ^ j * (2 * Real.pi * t * ‖η‖) by ring]
    exact le_mul_of_one_le_right hs hfactor
  have hlambdaone : 1 ≤ (2 * Real.pi * t * (2 : Real) ^ j) * ‖η‖ := by
    have hsone : 1 ≤ (2 : Real) ^ j := one_le_pow₀ (by norm_num)
    exact hsone.trans hlambda
  have hamp := hdecay σ ((2 * Real.pi * t * (2 : Real) ^ j) * ‖η‖) hlambdaone
  have hsqrt : Real.sqrt ((2 : Real) ^ j) ≤
      Real.sqrt ((2 * Real.pi * t * (2 : Real) ^ j) * ‖η‖) :=
    Real.sqrt_le_sqrt hlambda
  have hdenpos : 0 < Real.sqrt ((2 * Real.pi * t * (2 : Real) ^ j) * ‖η‖) :=
    Real.sqrt_pos.2 (lt_of_lt_of_le zero_lt_one hlambdaone)
  have hquot : Real.sqrt ((2 : Real) ^ j) /
      Real.sqrt ((2 * Real.pi * t * (2 : Real) ^ j) * ‖η‖) ≤ 1 := by
    exact (div_le_one₀ hdenpos).mpr hsqrt
  have hradial : ‖circleEndpointDyadicNormalization j *
      circleEndpointAmplitude σ ((2 * Real.pi * t * (2 : Real) ^ j) * ‖η‖)‖ ≤ A := by
    rw [norm_mul, norm_circleEndpointDyadicNormalization]
    calc
      Real.sqrt ((2 : Real) ^ j) *
          ‖circleEndpointAmplitude σ ((2 * Real.pi * t * (2 : Real) ^ j) * ‖η‖)‖ ≤
          Real.sqrt ((2 : Real) ^ j) *
            (A / Real.sqrt ((2 * Real.pi * t * (2 : Real) ^ j) * ‖η‖)) :=
        mul_le_mul_of_nonneg_left hamp (Real.sqrt_nonneg _)
      _ = A * (Real.sqrt ((2 : Real) ^ j) /
            Real.sqrt ((2 * Real.pi * t * (2 : Real) ^ j) * ‖η‖)) := by
        field_simp
      _ ≤ A * 1 := mul_le_mul_of_nonneg_left hquot hA.le
      _ = A := by ring
  have hcut : ‖_root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff η‖ ≤ 2 := by
    unfold _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype
    change ‖(_root_.Auto.LittlewoodPaley.intDyadicLowpassMultiplier C.cutoff 3) η -
        (_root_.Auto.LittlewoodPaley.intDyadicLowpassMultiplier C.cutoff (-2)) η‖ ≤ 2
    rw [_root_.Auto.LittlewoodPaley.intDyadicLowpassMultiplier_apply,
      _root_.Auto.LittlewoodPaley.intDyadicLowpassMultiplier_apply]
    calc
      ‖C.cutoff (((2 : Real) ^ (3 : Int))⁻¹ • η) -
          C.cutoff (((2 : Real) ^ (-2 : Int))⁻¹ • η)‖ ≤
          ‖C.cutoff (((2 : Real) ^ (3 : Int))⁻¹ • η)‖ +
            ‖C.cutoff (((2 : Real) ^ (-2 : Int))⁻¹ • η)‖ := norm_sub_le _ _
      _ ≤ 1 + 1 := add_le_add (C.norm_le_one _) (C.norm_le_one _)
      _ = 2 := by norm_num
  dsimp [B]
  rw [norm_mul, norm_mul, norm_mul, norm_mul, Complex.norm_real,
    Real.norm_of_nonneg hmass]
  rw [norm_mul] at hradial
  calc
    ‖circleEndpointDyadicNormalization j‖ * ‖((surfaceMass 2)⁻¹ : Complex)‖ *
        surfaceMass 1 *
          ‖circleEndpointAmplitude σ ((2 * Real.pi * t * (2 : Real) ^ j) * ‖η‖)‖ *
          ‖_root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff η‖ =
        (‖((surfaceMass 2)⁻¹ : Complex)‖ * surfaceMass 1) *
          (‖circleEndpointDyadicNormalization j‖ *
            ‖circleEndpointAmplitude σ ((2 * Real.pi * t * (2 : Real) ^ j) * ‖η‖)‖) *
          ‖_root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff η‖ := by ring
    _ ≤ (‖((surfaceMass 2)⁻¹ : Complex)‖ * surfaceMass 1) * A * 2 := by
      gcongr
    _ = 2 * ‖((surfaceMass 2)⁻¹ : Complex)‖ * surfaceMass 1 * A := by ring

/-- Every member of the rescaled endpoint family is supported in the same
fixed radius-sixteen ball. -/
theorem circleAnnularEndpointSchwartzFamily_support_subset
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (u : aux_CircleAnnularEndpointLocalIndex) :
    Function.support (aux_circleAnnularEndpointSchwartzFamily C u : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 ((2 : Real) ^ (4 : Int)) := by
  intro η hη
  rw [Function.mem_support] at hη
  rw [Metric.mem_closedBall, dist_zero_right]
  by_contra houtside
  have hlarge : (2 : Real) ^ (4 : Int) ≤ ‖η‖ := le_of_not_ge houtside
  apply hη
  change circleAnnularEndpointScaledSymbol C u.1 u.2.1 u.2.2 η = 0
  rw [circleAnnularEndpointScaledSymbol_apply,
    _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype_eq_zero_of_le_norm C hlarge]
  ring

/-- Every member of the rescaled endpoint family is supported in the same
closed annulus.  The positive inner radius records the cutoff's vanishing near
the origin and is what permits the radial derivative bounds to be used without
any differentiability assertion for the norm at zero. -/
theorem circleAnnularEndpointSchwartzFamily_support_subset_annulus
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (u : aux_CircleAnnularEndpointLocalIndex) :
    Function.support (aux_circleAnnularEndpointSchwartzFamily C u : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 (16 : Real) ∩ {η : Euclidean 2 | (1 / 4 : Real) ≤ ‖η‖} := by
  intro η hη
  constructor
  · have houter := circleAnnularEndpointSchwartzFamily_support_subset C u hη
    rw [Metric.mem_closedBall, dist_zero_right]
    rw [Metric.mem_closedBall, dist_zero_right] at houter
    norm_num at houter ⊢
    exact houter
  · rw [Function.mem_support] at hη
    by_contra hinner
    have hinner' : ‖η‖ ≤ (2 : Real) ^ (-2 : Int) := by
      have hlt : ‖η‖ < 1 / 4 := lt_of_not_ge hinner
      norm_num
      exact hlt.le
    apply hη
    change circleAnnularEndpointScaledSymbol C u.1 u.2.1 u.2.2 η = 0
    rw [circleAnnularEndpointScaledSymbol_apply,
      _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype_eq_zero_of_norm_le C hinner']
    ring

/-- The zero-order stationary estimate and common fixed support yield a
literal uniform Fourier-side `L¹` bound for the endpoint family. -/
theorem exists_integral_norm_circleAnnularEndpointSchwartzFamily_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ A₀ : Real, 0 ≤ A₀ ∧ ∀ u : aux_CircleAnnularEndpointLocalIndex,
      ∫ η : Euclidean 2, ‖aux_circleAnnularEndpointSchwartzFamily C u η‖ ≤ A₀ := by
  obtain ⟨B, hB, hpoint⟩ := exists_norm_circleAnnularEndpointScaledSymbol_le C
  let K : Set (Euclidean 2) := Metric.closedBall 0 ((2 : Real) ^ (4 : Int))
  let A₀ : Real := B * (volume K).toReal
  have hKmeas : MeasurableSet K := measurableSet_closedBall
  have hKfinite : volume K ≠ (⊤ : ENNReal) :=
    ne_of_lt MeasureTheory.measure_closedBall_lt_top
  have hA₀ : 0 ≤ A₀ := by
    dsimp [A₀]
    exact mul_nonneg hB ENNReal.toReal_nonneg
  refine ⟨A₀, hA₀, ?_⟩
  intro u
  apply _root_.Auto.MikhlinHormander.integral_norm_le_of_support_subset_of_norm_le
    (aux_circleAnnularEndpointSchwartzFamily C u : Euclidean 2 → Complex) K hKmeas hKfinite
  · simpa using (aux_circleAnnularEndpointSchwartzFamily C u).integrable.norm
  · intro η
    exact hpoint u.1 u.2.1 u.2.2.1 η u.2.2.2.1
  · exact circleAnnularEndpointSchwartzFamily_support_subset C u

/-- Every fixed-order derivative of the complete unit-scale endpoint symbol
is uniform over sign, dyadic annulus, and the local time slab.  On the common
closed annulus this follows from the radial stationary bound and the
Leibniz estimate for the fixed fat cutoff; outside it, derivative support is
contained in the closure of the symbol support. -/
theorem exists_uniform_norm_iteratedFDeriv_circleAnnularEndpointSchwartzFamily_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) (n : Nat) :
    ∃ B : Real, 0 ≤ B ∧ ∀ (u : aux_CircleAnnularEndpointLocalIndex)
      (η : Euclidean 2),
      ‖iteratedFDeriv Real n
        (aux_circleAnnularEndpointSchwartzFamily C u : Euclidean 2 → Complex) η‖ ≤ B := by
  choose H hHpos hH using fun i : Nat =>
    exists_uniform_norm_iteratedFDeriv_circleEndpointScaledRadialComp_le i
  let qS : SchwartzMap (Euclidean 2) Complex :=
    _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
  let q : Euclidean 2 → Complex := qS
  let c : Complex := ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex)
  let B : Real := ‖c‖ * ∑ i ∈ Finset.range (n + 1),
    (n.choose i : Real) * H i * SchwartzMap.seminorm Complex 0 (n - i) qS
  have hqnonneg (m : Nat) : 0 ≤ SchwartzMap.seminorm Complex 0 m qS := by
    exact le_trans (norm_nonneg _) (qS.norm_iteratedFDeriv_le_seminorm Complex m 0)
  have hB : 0 ≤ B := by
    dsimp [B]
    apply mul_nonneg (norm_nonneg _)
    apply Finset.sum_nonneg
    intro i hi
    exact mul_nonneg
      (mul_nonneg (by positivity) (hHpos i).le)
      (hqnonneg (n - i))
  refine ⟨B, hB, ?_⟩
  intro u η
  let K : Set (Euclidean 2) :=
    Metric.closedBall 0 (16 : Real) ∩ {y : Euclidean 2 | (1 / 4 : Real) ≤ ‖y‖}
  have hKclosed : IsClosed K := by
    dsimp [K]
    apply IsClosed.inter Metric.isClosed_closedBall
    exact isClosed_le continuous_const continuous_norm
  have htsupp : tsupport (aux_circleAnnularEndpointSchwartzFamily C u : Euclidean 2 → Complex) ⊆ K := by
    change closure (Function.support (aux_circleAnnularEndpointSchwartzFamily C u : Euclidean 2 → Complex)) ⊆ K
    exact closure_minimal
      (circleAnnularEndpointSchwartzFamily_support_subset_annulus C u) hKclosed
  by_cases hηK : η ∈ K
  · have hηouter : ‖η‖ ≤ 16 := by
      simpa only [K, Metric.mem_closedBall, dist_zero_right] using hηK.1
    have hηinner : (1 / 4 : Real) ≤ ‖η‖ := hηK.2
    have hηne : η ≠ 0 := by
      intro hzero
      subst η
      norm_num at hηinner
    let s : Set (Euclidean 2) := ({0}ᶜ : Set (Euclidean 2))
    have hsopen : IsOpen s := by
      simpa only [s] using (isOpen_compl_singleton : IsOpen ({0}ᶜ : Set (Euclidean 2)))
    have hsunique : UniqueDiffOn Real s := hsopen.uniqueDiffOn
    have hηs : η ∈ s := by simpa [s] using hηne
    let g : Real → Complex := circleEndpointScaledRadialAmplitude u.1 u.2.1 u.2.2
    let f : Euclidean 2 → Real := fun y => ‖y‖
    let h : Euclidean 2 → Complex := fun y => g (f y)
    have hg : ContDiff Real n g := by
      dsimp [g]
      unfold circleEndpointScaledRadialAmplitude
      apply ContDiff.mul
      · fun_prop
      · apply (contDiff_circleEndpointAmplitude u.1).of_le
          (show (n : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) by
            exact WithTop.coe_le_coe.mpr le_top)
          |>.comp
        fun_prop
    have hf : ContDiffOn Real n f s := by
      intro x hx
      exact (contDiffAt_norm Real (by simpa [s] using hx)).contDiffWithinAt
    have hh : ContDiffOn Real n h s := by
      change ContDiffOn Real n (g ∘ f) s
      exact hg.comp_contDiffOn hf
    have hq : ContDiff Real n q := by
      change ContDiff Real n (qS : Euclidean 2 → Complex)
      exact qS.smooth n
    have hradialAt : ContDiffAt Real n h η := by
      change ContDiffAt Real n (g ∘ f) η
      exact hg.contDiffAt.comp η (contDiffAt_norm Real hηne)
    have hqAt : ContDiffAt Real n q η := hq.contDiffAt
    have hprodAt : ContDiffAt Real n (fun y => h y * q y) η := hradialAt.mul hqAt
    have hprod := norm_iteratedFDerivWithin_mul_le
      hh hq.contDiffOn hsunique hηs
      (show (n : WithTop ENat) ≤ (n : WithTop ENat) by rfl)
    have hprodEq : iteratedFDerivWithin Real n (fun y => h y * q y) s η =
        iteratedFDeriv Real n (fun y => h y * q y) η :=
      iteratedFDerivWithin_eq_iteratedFDeriv hsunique hprodAt hηs
    have hsum :
        ∑ i ∈ Finset.range (n + 1),
          (n.choose i : Real) * ‖iteratedFDerivWithin Real i h s η‖ *
            ‖iteratedFDerivWithin Real (n - i) q s η‖ ≤
        ∑ i ∈ Finset.range (n + 1),
          (n.choose i : Real) * H i * SchwartzMap.seminorm Complex 0 (n - i) qS := by
      apply Finset.sum_le_sum
      intro i hi
      have hin : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      have hradialAt_i : ContDiffAt Real i h η := by
        change ContDiffAt Real i (g ∘ f) η
        exact (hg.of_le (by exact_mod_cast hin)).contDiffAt.comp η
          (contDiffAt_norm Real hηne)
      have hqAt_i : ContDiffAt Real (n - i : Nat) q η := by
        change ContDiffAt Real (n - i : Nat) (qS : Euclidean 2 → Complex) η
        exact qS.contDiffAt (n - i)
      have hradialEq : iteratedFDerivWithin Real i h s η = iteratedFDeriv Real i h η :=
        iteratedFDerivWithin_eq_iteratedFDeriv hsunique hradialAt_i hηs
      have hqEq : iteratedFDerivWithin Real (n - i) q s η =
          iteratedFDeriv Real (n - i) q η :=
        iteratedFDerivWithin_eq_iteratedFDeriv hsunique hqAt_i hηs
      rw [hradialEq, hqEq]
      have hradial : ‖iteratedFDeriv Real i h η‖ ≤ H i := by
        change ‖iteratedFDeriv Real i
          (fun y : Euclidean 2 => circleEndpointScaledRadialAmplitude u.1 u.2.1 u.2.2.1 ‖y‖) η‖ ≤ H i
        exact hH i u.1 u.2.1 u.2.2.1 η u.2.2.2.1 hηinner hηouter
      have hqbound : ‖iteratedFDeriv Real (n - i) q η‖ ≤
          SchwartzMap.seminorm Complex 0 (n - i) qS := by
        change ‖iteratedFDeriv Real (n - i) (qS : Euclidean 2 → Complex) η‖ ≤ _
        exact qS.norm_iteratedFDeriv_le_seminorm Complex (n - i) η
      calc
        (n.choose i : Real) * ‖iteratedFDeriv Real i h η‖ *
            ‖iteratedFDeriv Real (n - i) q η‖ ≤
          (n.choose i : Real) * H i * ‖iteratedFDeriv Real (n - i) q η‖ :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left hradial (by positivity)) (norm_nonneg _)
        _ ≤ (n.choose i : Real) * H i * SchwartzMap.seminorm Complex 0 (n - i) qS :=
          mul_le_mul_of_nonneg_left hqbound
            (mul_nonneg (by positivity) (hHpos i).le)
    have hfamilyEq :
        (aux_circleAnnularEndpointSchwartzFamily C u : Euclidean 2 → Complex) =
          fun y => c * (h y * q y) := by
      funext y
      change circleAnnularEndpointScaledSymbol C u.1 u.2.1 u.2.2 y = _
      rw [circleAnnularEndpointScaledSymbol_apply]
      dsimp [c, h, q, qS, g, f]
      unfold circleEndpointScaledRadialAmplitude
      ring
    have hscalar : (fun y : Euclidean 2 => c * (h y * q y)) =
        fun y => c • (h y * q y) := by
      funext y
      simp [smul_eq_mul]
    calc
      ‖iteratedFDeriv Real n
          (aux_circleAnnularEndpointSchwartzFamily C u : Euclidean 2 → Complex) η‖ =
          ‖c‖ * ‖iteratedFDeriv Real n (fun y => h y * q y) η‖ := by
            rw [hfamilyEq, hscalar, iteratedFDeriv_const_smul_apply' hprodAt, norm_smul]
      _ = ‖c‖ * ‖iteratedFDerivWithin Real n (fun y => h y * q y) s η‖ := by
            rw [hprodEq]
      _ ≤ ‖c‖ * ∑ i ∈ Finset.range (n + 1),
          (n.choose i : Real) * ‖iteratedFDerivWithin Real i h s η‖ *
            ‖iteratedFDerivWithin Real (n - i) q s η‖ :=
          mul_le_mul_of_nonneg_left hprod (norm_nonneg _)
      _ ≤ B := by
            exact mul_le_mul_of_nonneg_left hsum (norm_nonneg _)
  · have hnot : η ∉ Function.support (iteratedFDeriv Real n
        (aux_circleAnnularEndpointSchwartzFamily C u : Euclidean 2 → Complex)) := by
      intro hmem
      exact hηK (htsupp (support_iteratedFDeriv_subset n hmem))
    have hzero : iteratedFDeriv Real n
        (aux_circleAnnularEndpointSchwartzFamily C u : Euclidean 2 → Complex) η = 0 := by
      by_contra hne
      exact hnot (Function.mem_support.mpr hne)
    rw [hzero]
    simpa using hB

/-- The corresponding relative frequency scale for each member of the
unit-frequency endpoint family. -/
def aux_circleAnnularEndpointFrequencyScale :
    aux_CircleAnnularEndpointLocalIndex → Ioi (0 : Real) :=
  fun u => aux_circleAnnularEndpointDyadicScale u.2.1

/-- The exact uniform kernel datum needed to invoke the compact-annular
Mikhlin mechanism for the circle endpoint factors. -/
def aux_HasCircleAnnularEndpointUniformKernelBound
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) : Prop :=
  ∃ A : Real, 0 ≤ A ∧ ∀ u : aux_CircleAnnularEndpointLocalIndex,
    _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize
      (aux_circleAnnularEndpointSchwartzFamily C u) ≤ A

/-- A finite Fourier-side certificate for the uniform endpoint-kernel datum.

The first term is the unit-frequency symbol mass, while the second is the
order-four compact Fourier integration-by-parts constant.  Thus the remaining
endpoint analysis is explicitly reduced to uniform bounds for finitely many
frequency derivatives on the fixed annulus; no pointwise smoothness is being
silently promoted to a uniform physical-kernel estimate. -/
theorem aux_hasCircleAnnularEndpointUniformKernelBound_of_uniform_fourierData
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (A₀ A₁ : Real) (hA₀ : 0 ≤ A₀) (hA₁ : 0 ≤ A₁)
    (hmass : ∀ u : aux_CircleAnnularEndpointLocalIndex,
      ∫ η : Euclidean 2, ‖aux_circleAnnularEndpointSchwartzFamily C u η‖ ≤ A₀)
    (hibp : ∀ u : aux_CircleAnnularEndpointLocalIndex,
      _root_.Auto.MikhlinHormander.compactFourierIBPConstant (N := 4)
        (aux_circleAnnularEndpointSchwartzFamily C u : Euclidean 2 → Complex) ≤ A₁) :
    aux_HasCircleAnnularEndpointUniformKernelBound C := by
  refine ⟨A₀ + A₁, add_nonneg hA₀ hA₁, ?_⟩
  intro u
  calc
    _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize
        (aux_circleAnnularEndpointSchwartzFamily C u) ≤
        (∫ η : Euclidean 2, ‖aux_circleAnnularEndpointSchwartzFamily C u η‖) +
          _root_.Auto.MikhlinHormander.compactFourierIBPConstant (N := 4)
            (aux_circleAnnularEndpointSchwartzFamily C u : Euclidean 2 → Complex) :=
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize_le_compactFourierIBP
        (aux_circleAnnularEndpointSchwartzFamily C u)
    _ ≤ A₀ + A₁ := add_le_add (hmass u) (hibp u)

/-- The common compact support and the proved finite-order endpoint
derivative bounds give a uniform order-four Fourier integration-by-parts
constant for the rescaled endpoint family. -/
theorem exists_compactFourierIBPConstant_circleAnnularEndpointSchwartzFamily_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ A₁ : Real, 0 ≤ A₁ ∧ ∀ u : aux_CircleAnnularEndpointLocalIndex,
      _root_.Auto.MikhlinHormander.compactFourierIBPConstant (N := 4)
        (aux_circleAnnularEndpointSchwartzFamily C u : Euclidean 2 → Complex) ≤ A₁ := by
  choose B hB hderiv using fun n : Nat =>
    exists_uniform_norm_iteratedFDeriv_circleAnnularEndpointSchwartzFamily_le C n
  let R : Real := (2 : Real) ^ (4 : Int)
  let A₁ : Real := (2 : Real) ^ 4 * ∑ n ∈ Finset.range (4 + 1),
    B n * (volume (Metric.closedBall (0 : Euclidean 2) R)).toReal
  have hA₁ : 0 ≤ A₁ := by
    dsimp [A₁]
    apply mul_nonneg (by positivity)
    apply Finset.sum_nonneg
    intro n hn
    exact mul_nonneg (hB n) ENNReal.toReal_nonneg
  refine ⟨A₁, hA₁, ?_⟩
  intro u
  have hmain :=
    _root_.Auto.MikhlinHormander.compactFourierIBPConstant_le_of_support_subset_of_uniform_deriv_bound
      (aux_circleAnnularEndpointSchwartzFamily C u : Euclidean 2 → Complex)
      ((aux_circleAnnularEndpointSchwartzFamily C u).smooth 4)
      (R := R) (circleAnnularEndpointSchwartzFamily_support_subset C u) B
      (fun n hn η => hderiv n u η)
  simpa [A₁, R] using hmain

/-- The rescaled circle endpoint family has the unconditional uniform
physical-kernel bound required by the compact-annular Mikhlin argument. -/
theorem hasCircleAnnularEndpointUniformKernelBound
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    aux_HasCircleAnnularEndpointUniformKernelBound C := by
  obtain ⟨A₀, hA₀, hmass⟩ := exists_integral_norm_circleAnnularEndpointSchwartzFamily_le C
  obtain ⟨A₁, hA₁, hibp⟩ :=
    exists_compactFourierIBPConstant_circleAnnularEndpointSchwartzFamily_le C
  exact aux_hasCircleAnnularEndpointUniformKernelBound_of_uniform_fourierData
    C A₀ A₁ hA₀ hA₁ hmass hibp

/-- The maximal compact-annular multiplier family associated to the local
circle endpoint symbols. It is real-valued because it takes a pointwise
supremum of complex multiplier norms. -/
noncomputable def aux_circleAnnularEndpointMultiplierMaximal
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Real :=
  _root_.Auto.MikhlinHormander.annularSchwartzMultiplier
    (aux_circleAnnularEndpointSchwartzFamily C)
    aux_circleAnnularEndpointFrequencyScale f

/-- At a fixed endpoint parameter, evaluating the unit-frequency Schwartz
symbol at its reciprocal dyadic radius recovers the literal physical
annular endpoint multiplier. -/
theorem aux_circleAnnularEndpointScaledSchwartzSymbol_at_dyadicScale
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real)
    (ξ : Euclidean 2) :
    aux_circleAnnularEndpointScaledSchwartzSymbol C σ j t
        ((aux_circleAnnularEndpointDyadicScale j).1 • ξ) =
      circleAnnularEndpointSchwartzSymbol C σ j t ξ := by
  rw [aux_circleAnnularEndpointScaledSchwartzSymbol_apply,
    circleAnnularEndpointScaledSymbol]
  simp [aux_circleAnnularEndpointDyadicScale,
    circleAnnularEndpointSchwartzSymbol_apply]

/-- The reciprocal dyadic-scale presentation retains the exact endpoint
factorization through the MSS half-wave symbol. -/
theorem aux_circleAnnularEndpointScaledSchwartzSymbol_factorization_at_dyadicScale
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real)
    (ξ : Euclidean 2) :
    (circleEndpointDyadicNormalization j)⁻¹ *
        aux_circleAnnularEndpointScaledSchwartzSymbol C σ j t
          ((aux_circleAnnularEndpointDyadicScale j).1 • ξ) *
        _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol C.cutoff σ j t ξ =
      ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖ξ‖)) *
        _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t ξ *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ := by
  rw [aux_circleAnnularEndpointScaledSchwartzSymbol_at_dyadicScale]
  exact circleAnnularEndpointSchwartzSymbol_factorization C σ j t ξ

/-- At a fixed endpoint parameter, the correctly scaled member of the
abstract compact-annular family is the literal Fourier multiplier by the
annular endpoint symbol. -/
theorem aux_circleAnnularEndpointRelativeMultiplierAt_dyadicScale
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Icc (1 : Real) 2)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
        (aux_circleAnnularEndpointSchwartzFamily C ⟨σ, ⟨j, t⟩⟩)
        (aux_circleAnnularEndpointFrequencyScale ⟨σ, ⟨j, t⟩⟩) f x =
      𝓕⁻ (fun ξ : Euclidean 2 =>
        circleAnnularEndpointSchwartzSymbol C σ j t.1 ξ *
          𝓕 (f : Euclidean 2 → Complex) ξ) x := by
  unfold _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext ξ
  change aux_circleAnnularEndpointScaledSchwartzSymbol C σ j t.1
      ((aux_circleAnnularEndpointDyadicScale j).1 • ξ) *
        𝓕 (f : Euclidean 2 → Complex) ξ = _
  rw [aux_circleAnnularEndpointScaledSchwartzSymbol_at_dyadicScale]

/-- The literal dyadic half-wave output, packaged as a Schwartz function for
the compact-annular relative-multiplier family. -/
noncomputable def circleAnnularEndpointHalfWaveOutput
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) : SchwartzMap (Euclidean 2) Complex :=
  𝓕⁻ (SchwartzMap.smulLeftCLM Complex
    (_root_.Auto.Spherical.MSSBase.dyadicHalfWaveSchwartzSymbol C σ j t :
      Euclidean 2 → Complex)
    (𝓕 f))

/-- Fourier-side formula for the Schwartz half-wave output used by the
annular endpoint factorization. -/
theorem circleAnnularEndpointHalfWaveOutput_fourier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) (ξ : Euclidean 2) :
    𝓕 (circleAnnularEndpointHalfWaveOutput C σ j t f : Euclidean 2 → Complex) ξ =
      _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol C.cutoff σ j t ξ *
        𝓕 (f : Euclidean 2 → Complex) ξ := by
  unfold circleAnnularEndpointHalfWaveOutput
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  simp only [SchwartzMap.smulLeftCLM_apply
    (_root_.Auto.Spherical.MSSBase.dyadicHalfWaveSchwartzSymbol C σ j t).hasTemperateGrowth,
    smul_eq_mul, _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSchwartzSymbol_apply,
    SchwartzMap.fourier_coe]

/-- The packaged endpoint half-wave output is pointwise the literal dyadic
half-wave, so the relative-multiplier factorization does not replace the
physical MSS operator by an auxiliary realization. -/
theorem circleAnnularEndpointHalfWaveOutput_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    circleAnnularEndpointHalfWaveOutput C σ j t f x =
      _root_.Auto.Spherical.MSSBase.dyadicHalfWave C.cutoff σ j t f x := by
  unfold circleAnnularEndpointHalfWaveOutput
  rw [SchwartzMap.fourierInv_coe]
  apply congrArg (fun q : Euclidean 2 → Complex => 𝓕⁻ q x)
  funext ξ
  simp only [SchwartzMap.smulLeftCLM_apply
    (_root_.Auto.Spherical.MSSBase.dyadicHalfWaveSchwartzSymbol C σ j t).hasTemperateGrowth,
    smul_eq_mul, _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSchwartzSymbol_apply,
    _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol, SchwartzMap.fourier_coe]

/-- The endpoint contribution written with the fat annular Schwartz symbol.
It agrees with the original low-pass presentation after multiplication by
the dyadic half-wave, but has a literal compact Schwartz multiplier factor. -/
noncomputable def aux_circleAnnularEndpointWaveContribution
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun ξ : Euclidean 2 =>
    (circleEndpointDyadicNormalization j)⁻¹ *
      circleAnnularEndpointSchwartzSymbol C σ j t ξ *
      _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol C.cutoff σ j t ξ *
      𝓕 (f : Euclidean 2 → Complex) ξ) x

/-- Each physical annular endpoint term is exactly one member of the proved
compact-annular relative multiplier family acting on the literal dyadic
half-wave output. -/
theorem aux_circleAnnularEndpointWaveContribution_eq_relativeMultiplier_halfWave
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Icc (1 : Real) 2)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    aux_circleAnnularEndpointWaveContribution C σ j t.1 f x =
      (circleEndpointDyadicNormalization j)⁻¹ *
        _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
          (aux_circleAnnularEndpointSchwartzFamily C ⟨σ, ⟨j, t⟩⟩)
          (aux_circleAnnularEndpointFrequencyScale ⟨σ, ⟨j, t⟩⟩)
          (circleAnnularEndpointHalfWaveOutput C σ j t.1 f) x := by
  rw [aux_circleAnnularEndpointRelativeMultiplierAt_dyadicScale]
  rw [aux_const_mul_fourierInv]
  unfold aux_circleAnnularEndpointWaveContribution
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext ξ
  rw [circleAnnularEndpointHalfWaveOutput_fourier]
  ring

/-- Uniform annular stability of the literal endpoint contribution.  After
the stationary normalization, every local-time/sign/scale endpoint is a
compact relative multiplier applied to the actual dyadic half-wave output;
the proved kernel certificate therefore gives one dyadic
Hardy--Littlewood-maximal majorant for all of them. -/
theorem exists_circleAnnularEndpointWaveContribution_dyadicBall_stability
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ K : Real, 0 < K ∧ ∀ (σ : _root_.Auto.Spherical.MSSBase.WaveSign)
      (j : Nat) (t : Icc (1 : Real) 2)
      (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2),
      ‖aux_circleAnnularEndpointWaveContribution C σ j t.1 f x‖ ≤
        ‖(circleEndpointDyadicNormalization j)⁻¹‖ *
          (K * _root_.Auto.HardyLittlewoodMaximal.dyadicBallMaximal 2
            (circleAnnularEndpointHalfWaveOutput C σ j t.1 f : Euclidean 2 → Complex) x) := by
  rcases hasCircleAnnularEndpointUniformKernelBound C with ⟨A, hA, hkernel⟩
  obtain ⟨K, hK, hterm⟩ :=
    _root_.Auto.MikhlinHormander.uniform_relativeSchwartzMultiplierAt_majorant_of_kernel_bound
      (aux_circleAnnularEndpointSchwartzFamily C) hA hkernel
  refine ⟨K, hK, ?_⟩
  intro σ j t f x
  rw [aux_circleAnnularEndpointWaveContribution_eq_relativeMultiplier_halfWave]
  rw [norm_mul]
  exact mul_le_mul_of_nonneg_left
    (hterm ⟨σ, ⟨j, t⟩⟩ (circleAnnularEndpointHalfWaveOutput C σ j t.1 f)
      (aux_circleAnnularEndpointFrequencyScale ⟨σ, ⟨j, t⟩⟩) x)
    (norm_nonneg _)

/-- Fixed-time `L⁴` stability of the literal annular endpoint contribution.
This is the spatial consequence of the uniform compact-annular multiplier
certificate: the local-time endpoint is controlled by the corresponding
literal dyadic half-wave output, uniformly in sign and dyadic scale. -/
theorem exists_integral_norm_pow_four_circleAnnularEndpointWaveContribution_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : _root_.Auto.Spherical.MSSBase.WaveSign)
      (j : Nat) (t : Icc (1 : Real) 2)
      (f : SchwartzMap (Euclidean 2) Complex),
      (∫ x : Euclidean 2, ‖aux_circleAnnularEndpointWaveContribution C σ j t.1 f x‖ ^ 4) ≤
        ‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * B *
          ∫ x : Euclidean 2, ‖circleAnnularEndpointHalfWaveOutput C σ j t.1 f x‖ ^ 4 := by
  rcases exists_circleAnnularEndpointWaveContribution_dyadicBall_stability C with
    ⟨K, hK, hstability⟩
  obtain ⟨H, hH, hhardy⟩ :=
    _root_.Auto.HardyLittlewoodMaximal.dyadic_hardy_littlewood_maximal_strong_type_schwartz
      (d := 2) (by norm_num) (p := 4) (by norm_num)
  refine ⟨K ^ 4 * H, mul_pos (Real.rpow_pos_of_pos hK _) hH, ?_⟩
  intro σ j t f
  let u : SchwartzMap (Euclidean 2) Complex :=
    circleAnnularEndpointHalfWaveOutput C σ j t.1 f
  let E : Euclidean 2 → Complex := aux_circleAnnularEndpointWaveContribution C σ j t.1 f
  let M : Euclidean 2 → Real :=
    _root_.Auto.HardyLittlewoodMaximal.dyadicBallMaximal 2
      (u : Euclidean 2 → Complex)
  have hM := hhardy u
  have hMnonneg (x : Euclidean 2) : 0 ≤ M x := ENNReal.toReal_nonneg
  have hMpowInt : Integrable (fun x : Euclidean 2 => M x ^ 4) := by
    have h := hM.1.integrable_norm_rpow (by norm_num : (ENNReal.ofReal (4 : Real)) ≠ 0)
      ENNReal.ofReal_ne_top
    convert h using 1
    funext x
    rw [Real.norm_eq_abs, abs_of_nonneg (hMnonneg x),
      ENNReal.toReal_ofReal (by norm_num : (0 : Real) ≤ 4)]
    norm_num
  have hEcont : Continuous E := by
    rw [show E = fun x => (circleEndpointDyadicNormalization j)⁻¹ *
        _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
          (aux_circleAnnularEndpointSchwartzFamily C ⟨σ, ⟨j, t⟩⟩)
          (aux_circleAnnularEndpointFrequencyScale ⟨σ, ⟨j, t⟩⟩) u x by
      funext x
      exact aux_circleAnnularEndpointWaveContribution_eq_relativeMultiplier_halfWave C σ j t f x]
    exact (_root_.Auto.MikhlinHormander.continuous_relativeSchwartzMultiplierAt
      (aux_circleAnnularEndpointSchwartzFamily C ⟨σ, ⟨j, t⟩⟩) u
      (aux_circleAnnularEndpointFrequencyScale ⟨σ, ⟨j, t⟩⟩)).const_mul _
  have hpoint (x : Euclidean 2) : ‖E x‖ ^ 4 ≤
      (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * K ^ 4) * M x ^ 4 := by
    have h := hstability σ j t f x
    change ‖E x‖ ≤ _ at h
    calc
      ‖E x‖ ^ 4 ≤ (‖(circleEndpointDyadicNormalization j)⁻¹‖ * (K * M x)) ^ 4 :=
        pow_le_pow_left₀ (norm_nonneg _) h 4
      _ = (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * K ^ 4) * M x ^ 4 := by
        ring
  have hdomInt : Integrable (fun x : Euclidean 2 =>
      (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * K ^ 4) * M x ^ 4) :=
    hMpowInt.const_mul _
  have hEpowInt : Integrable (fun x : Euclidean 2 => ‖E x‖ ^ 4) := by
    refine Integrable.mono' hdomInt (hEcont.norm.pow 4).aestronglyMeasurable ?_
    filter_upwards with x
    change ‖‖E x‖ ^ (4 : Nat)‖ ≤ _
    rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (norm_nonneg _) _)]
    exact hpoint x
  calc
    (∫ x : Euclidean 2, ‖aux_circleAnnularEndpointWaveContribution C σ j t.1 f x‖ ^ 4) =
        ∫ x : Euclidean 2, ‖E x‖ ^ 4 := rfl
    _ ≤ ∫ x : Euclidean 2, (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * K ^ 4) * M x ^ 4 :=
      integral_mono hEpowInt hdomInt hpoint
    _ = (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * K ^ 4) *
        ∫ x : Euclidean 2, M x ^ 4 := by rw [integral_const_mul]
    _ ≤ (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * K ^ 4) *
        (H * ∫ x : Euclidean 2, ‖u x‖ ^ 4) := by
      apply mul_le_mul_of_nonneg_left
        (show (∫ x : Euclidean 2, M x ^ 4) ≤ H * ∫ x : Euclidean 2, ‖u x‖ ^ 4 by
          convert hM.2 using 1
          · apply integral_congr_ae
            filter_upwards with x
            change M x ^ (4 : Nat) = M x ^ (4 : Real)
            exact (Real.rpow_natCast (M x) 4).symm
          · congr 1
            apply integral_congr_ae
            filter_upwards with x
            exact (Real.rpow_natCast ‖u x‖ 4).symm)
        (by positivity)
    _ = ‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * (K ^ 4 * H) *
        ∫ x : Euclidean 2, ‖u x‖ ^ 4 := by ring
    _ = _ := by simp [u]

/-- The annular endpoint contribution has the same literal Fourier-side
factorization as the original endpoint contribution. -/
theorem aux_circleAnnularEndpointWaveContribution_factorization
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    aux_circleAnnularEndpointWaveContribution C σ j t f x =
      𝓕⁻ (fun ξ : Euclidean 2 =>
        ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude σ (2 * Real.pi * (t * ‖ξ‖)) *
          _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t ξ *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ *
          𝓕 (f : Euclidean 2 → Complex) ξ) x := by
  unfold aux_circleAnnularEndpointWaveContribution
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext ξ
  rw [circleAnnularEndpointSchwartzSymbol_factorization]

/-- On the active dyadic half-wave the annular Schwartz endpoint and the
original low-pass endpoint give exactly the same physical-space term. -/
theorem aux_circleAnnularEndpointWaveContribution_eq_circleEndpointWaveContribution
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) :
    aux_circleAnnularEndpointWaveContribution C σ j t f =
      circleEndpointWaveContribution C σ j t f := by
  funext x
  rw [aux_circleAnnularEndpointWaveContribution_factorization,
    circleEndpointWaveContribution_factorization]

/-- Exact three-wave circle decomposition with both endpoint terms written
through their fat annular Schwartz multipliers. This is the form to which the
conditional uniform compact-annular multiplier estimate applies. -/
theorem aux_circleDyadicBandpassThreeWaveDecomposition_annularEndpoint
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) {t : Real} (ht : 0 ≤ t)
    (x : Euclidean 2) :
    circularAverage t
        (dyadicBandpassProjection
          (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j) f :
          Euclidean 2 → Complex) x =
      aux_circleAnnularEndpointWaveContribution C _root_.Auto.Spherical.MSSBase.WaveSign.minus
          j t f x +
        aux_circleAnnularEndpointWaveContribution C _root_.Auto.Spherical.MSSBase.WaveSign.plus
          j t f x + circleMiddleWaveContribution C j t f x := by
  rw [circleDyadicBandpassThreeWaveDecomposition C j f ht x,
    ← aux_circleAnnularEndpointWaveContribution_eq_circleEndpointWaveContribution,
    ← aux_circleAnnularEndpointWaveContribution_eq_circleEndpointWaveContribution]

/-- Under the explicit uniform endpoint-kernel hypothesis, the entire local
time/sign/scale endpoint family has one dyadic Hardy--Littlewood maximal
majorant. This is the pointwise multiplier input used before applying the
local-smoothing estimate. -/
theorem aux_circleAnnularEndpointMultiplierMaximal_majorant_of_uniformKernelBound
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (hkernel : aux_HasCircleAnnularEndpointUniformKernelBound C) :
    ∃ K : Real, 0 < K ∧ ∀ (f : SchwartzMap (Euclidean 2) Complex)
      (x : Euclidean 2),
      aux_circleAnnularEndpointMultiplierMaximal C f x ≤
        K * _root_.Auto.HardyLittlewoodMaximal.dyadicBallMaximal 2
          (f : Euclidean 2 → Complex) x := by
  rcases hkernel with ⟨A, hA, hfamily⟩
  simpa only [aux_circleAnnularEndpointMultiplierMaximal] using
    (_root_.Auto.MikhlinHormander.annularSchwartzMultiplier_majorant_of_kernel_bound
      (aux_circleAnnularEndpointSchwartzFamily C)
      aux_circleAnnularEndpointFrequencyScale hA hfamily)

/-- The unconditional endpoint majorant obtained from the uniform Fourier-side
certificate. -/
theorem aux_circleAnnularEndpointMultiplierMaximal_majorant
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ K : Real, 0 < K ∧ ∀ (f : SchwartzMap (Euclidean 2) Complex)
      (x : Euclidean 2),
      aux_circleAnnularEndpointMultiplierMaximal C f x ≤
        K * _root_.Auto.HardyLittlewoodMaximal.dyadicBallMaximal 2
          (f : Euclidean 2 → Complex) x :=
  aux_circleAnnularEndpointMultiplierMaximal_majorant_of_uniformKernelBound C
    (hasCircleAnnularEndpointUniformKernelBound C)

/-- Conditional form of the uniform strong type for the circle endpoint
cutoff family. -/
theorem aux_circleAnnularEndpointMultiplierMaximal_strong_type_of_uniformKernelBound
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {p : Real} (hp : 1 < p)
    (hkernel : aux_HasCircleAnnularEndpointUniformKernelBound C) :
    ∃ B : Real, 0 < B ∧ ∀ f : SchwartzMap (Euclidean 2) Complex,
      MemLp (aux_circleAnnularEndpointMultiplierMaximal C f) (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean 2, (aux_circleAnnularEndpointMultiplierMaximal C f x) ^ p) ≤
        B * ∫ x : Euclidean 2, ‖f x‖ ^ p := by
  rcases hkernel with ⟨A, hA, hfamily⟩
  simpa only [aux_circleAnnularEndpointMultiplierMaximal] using
    (_root_.Auto.MikhlinHormander.annularSchwartzMultiplier_strong_type_of_kernel_bound
      (d := 2) (by norm_num) hp
      (aux_circleAnnularEndpointSchwartzFamily C)
      aux_circleAnnularEndpointFrequencyScale hA hfamily)

/-- The unconditional strong type for the complete local endpoint family. -/
theorem aux_circleAnnularEndpointMultiplierMaximal_strong_type
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {p : Real} (hp : 1 < p) :
    ∃ B : Real, 0 < B ∧ ∀ f : SchwartzMap (Euclidean 2) Complex,
      MemLp (aux_circleAnnularEndpointMultiplierMaximal C f) (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean 2, (aux_circleAnnularEndpointMultiplierMaximal C f x) ^ p) ≤
        B * ∫ x : Euclidean 2, ‖f x‖ ^ p :=
  aux_circleAnnularEndpointMultiplierMaximal_strong_type_of_uniformKernelBound C hp
    (hasCircleAnnularEndpointUniformKernelBound C)

/-! ### Literal endpoint time derivative and its uniform annular factor

The literal time derivative is separated into a scale-uniform derivative-annular
factor and a compact radial input factor for the differentiated half-wave. -/

noncomputable def circleEndpointWaveContributionTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun xi : Euclidean 2 =>
    circleEndpointBandpassMultiplierTimeDerivative C σ j t xi *
      𝓕 (f : Euclidean 2 → Complex) xi) x

theorem circleEndpointWaveContributionTimeDerivative_eq_fourierInv_multiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    circleEndpointWaveContributionTimeDerivative C σ j t f x =
      𝓕⁻ (fun xi : Euclidean 2 =>
        circleEndpointBandpassMultiplierTimeDerivative C σ j t xi *
          𝓕 (f : Euclidean 2 → Complex) xi) x := rfl

/-- A compact Schwartz presentation of the literal endpoint multiplier,
used only to validate the ensuing Plancherel estimates. -/
private noncomputable def circleEndpointBandpassSchwartzSymbol
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real) :
    SchwartzMap (Euclidean 2) Complex :=
  (circleEndpointDyadicNormalization j)⁻¹ •
    SchwartzMap.smulLeftCLM Complex
      (circleAnnularEndpointSchwartzSymbol C σ j t : Euclidean 2 → Complex)
      (_root_.Auto.Spherical.MSSBase.dyadicHalfWaveSchwartzSymbol C σ j t)

private theorem circleEndpointBandpassSchwartzSymbol_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real)
    (xi : Euclidean 2) :
    circleEndpointBandpassSchwartzSymbol C σ j t xi =
      ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
        _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t xi *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi := by
  unfold circleEndpointBandpassSchwartzSymbol
  change (circleEndpointDyadicNormalization j)⁻¹ •
      (SchwartzMap.smulLeftCLM Complex
        (circleAnnularEndpointSchwartzSymbol C σ j t : Euclidean 2 → Complex)
        (_root_.Auto.Spherical.MSSBase.dyadicHalfWaveSchwartzSymbol C σ j t) xi) = _
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (circleAnnularEndpointSchwartzSymbol C σ j t).hasTemperateGrowth,
    _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSchwartzSymbol_apply]
  simpa only [smul_eq_mul, mul_assoc] using
    circleAnnularEndpointSchwartzSymbol_factorization C σ j t xi

/-- The amplitude part of the endpoint time derivative retains stationary
square-root decay: differentiating in time contributes `‖ξ‖`, which is
cancelled by the extra stationary derivative decay. -/
private theorem exists_norm_circleEndpointAmplitudeTimeDerivative_decay :
    ∃ A : Real, 0 < A ∧ ∀ (σ : _root_.Auto.Spherical.MSSBase.WaveSign)
      (t : Real) (xi : Euclidean 2), 1 ≤ t →
      1 ≤ 2 * Real.pi * (t * ‖xi‖) →
      ‖circleEndpointAmplitudeTimeDerivative σ t xi‖ ≤
        A / Real.sqrt (2 * Real.pi * (t * ‖xi‖)) := by
  obtain ⟨A, hA, hdecay⟩ := exists_iteratedDeriv_circleEndpointAmplitude_abs_decay 1
  refine ⟨A, hA, ?_⟩
  intro σ t xi ht hlarge
  let R : Real := 2 * Real.pi * ‖xi‖
  let L : Real := 2 * Real.pi * (t * ‖xi‖)
  have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one hlarge
  have hspos : 0 < Real.sqrt L := Real.sqrt_pos.2 hLpos
  have hRnonneg : 0 ≤ R := by
    dsimp [R]
    positivity
  have hRle : R ≤ L := by
    dsimp [R, L]
    have htnorm : ‖xi‖ ≤ t * ‖xi‖ :=
      le_mul_of_one_le_left (norm_nonneg xi) ht
    exact mul_le_mul_of_nonneg_left htnorm (by positivity)
  have hderiv := hdecay σ L (by
    rw [abs_of_nonneg hLpos.le]
    exact hlarge)
  have hderiv' : ‖deriv (circleEndpointAmplitude σ) L‖ ≤
      A / Real.sqrt L ^ 3 := by
    simpa [Auto.Spherical.FractalDilations.Auxiliary.quadraticMomentScale,
      abs_of_nonneg hLpos.le] using hderiv
  have hden : Real.sqrt L ^ 3 = Real.sqrt L * L := by
    calc
      Real.sqrt L ^ 3 = Real.sqrt L * (Real.sqrt L) ^ 2 := by ring
      _ = Real.sqrt L * L := by rw [Real.sq_sqrt hLpos.le]
  have hratio : R * (A / Real.sqrt L ^ 3) ≤ A / Real.sqrt L := by
    rw [hden]
    calc
      R * (A / (Real.sqrt L * L)) = (R / L) * (A / Real.sqrt L) := by
        field_simp
      _ ≤ 1 * (A / Real.sqrt L) := by
        gcongr
        exact (div_le_one₀ hLpos).mpr hRle
      _ = A / Real.sqrt L := by ring
  change ‖(R : Complex) * deriv (circleEndpointAmplitude σ) L‖ ≤ A / Real.sqrt L
  rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg hRnonneg]
  calc
    R * ‖deriv (circleEndpointAmplitude σ) L‖ ≤
        R * (A / Real.sqrt L ^ 3) :=
      mul_le_mul_of_nonneg_left hderiv' hRnonneg
    _ ≤ A / Real.sqrt L := hratio

/-- Fixed-time endpoint multiplier size before taking any time supremum. -/
private theorem exists_norm_circleEndpointBandpassMultiplier_le_dyadicSqrtInverse
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : _root_.Auto.Spherical.MSSBase.WaveSign)
      (j : Nat) (t : Real) (xi : Euclidean 2), 1 ≤ t → t ≤ 2 →
      ‖((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
        _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t xi *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ ≤
        B / Real.sqrt (dyadicScale j) := by
  obtain ⟨A, hA, hamp⟩ := exists_circleEndpointAmplitude_decay
  let K : Real := ‖((surfaceMass 2)⁻¹ : Complex)‖ * surfaceMass 1
  let B : Real := 2 * K * A
  have hmass2 : ((surfaceMass 2 : Real) : Complex) ≠ 0 := by
    exact_mod_cast surfaceMass_ne_zero (by norm_num : 0 < 2)
  have hK : 0 < K := by
    dsimp [K]
    have hinv : 0 < ‖((surfaceMass 2)⁻¹ : Complex)‖ :=
      norm_pos_iff.mpr (inv_ne_zero hmass2)
    have hmass1 : 0 < surfaceMass 1 := surfaceMass_pos (by norm_num)
    positivity
  have hB : 0 < B := by
    dsimp only [B]
    positivity
  refine ⟨B, hB, ?_⟩
  intro σ j t xi ht _
  by_cases hband :
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0
  · rw [show ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
        _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t xi *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0 by
          simp [hband]]
    rw [norm_zero]
    exact div_nonneg hB.le (Real.sqrt_nonneg _)
  · let L : Real := 2 * Real.pi * (t * ‖xi‖)
    have hfrequency : dyadicScale j ≤ L := by
      simpa only [dyadicScale] using
        aux_dyadicFrequency_le_circleEndpointFrequency C j t xi ht hband
    have hscaleone : 1 ≤ dyadicScale j := by
      calc
        1 = dyadicScale 0 := by simp [dyadicScale]
        _ ≤ dyadicScale j := dyadicScale_mono (Nat.zero_le j)
    have hlarge : 1 ≤ L := hscaleone.trans hfrequency
    have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one hlarge
    have hscalePos : 0 < dyadicScale j := dyadicScale_pos j
    have hsqrtScale : 0 < Real.sqrt (dyadicScale j) := Real.sqrt_pos.2 hscalePos
    have hamp' : ‖circleEndpointAmplitude σ L‖ ≤ A / Real.sqrt L :=
      hamp σ L hlarge
    have hratio : A / Real.sqrt L ≤ A / Real.sqrt (dyadicScale j) :=
      div_le_div_of_nonneg_left hA.le hsqrtScale
        (Real.sqrt_le_sqrt hfrequency)
    have hcut :
        ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ ≤ 2 :=
      _root_.Auto.LittlewoodPaley.norm_dyadicBandpassMultiplier_le_two C j xi
    have hinner : ‖circleEndpointAmplitude σ L‖ *
        ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ ≤
        (A / Real.sqrt L) * 2 := by
      exact mul_le_mul hamp' hcut (norm_nonneg _) (div_nonneg hA.le (Real.sqrt_nonneg _))
    have hmass1 : 0 ≤ surfaceMass 1 := (surfaceMass_pos (by norm_num)).le
    change ‖((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      circleEndpointAmplitude σ L *
      _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t xi *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ ≤
      B / Real.sqrt (dyadicScale j)
    calc
      ‖((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude σ L *
          _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ =
          K * (‖circleEndpointAmplitude σ L‖ *
            ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖) := by
          unfold K
          rw [norm_mul, norm_mul, norm_mul, norm_mul, Complex.norm_real,
            Real.norm_of_nonneg hmass1,
            _root_.Auto.Spherical.MSSBase.norm_halfWaveMultiplier]
          ring
      _ ≤ K * ((A / Real.sqrt L) * 2) :=
        mul_le_mul_of_nonneg_left hinner hK.le
      _ = (2 * K) * (A / Real.sqrt L) := by ring
      _ ≤ (2 * K) * (A / Real.sqrt (dyadicScale j)) := by
        exact mul_le_mul_of_nonneg_left hratio (by positivity)
      _ = B / Real.sqrt (dyadicScale j) := by
        dsimp [B]
        ring

/-- Plancherel turns the literal stationary endpoint multiplier estimate into
the exact fixed-time `L²` gain of one half dyadic power. -/
theorem exists_integral_norm_sq_circleEndpointWaveContribution_le_dyadicSqrtInverse
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : _root_.Auto.Spherical.MSSBase.WaveSign)
      (j : Nat) (t : Real), 1 ≤ t → t ≤ 2 →
      ∀ f : SchwartzMap (Euclidean 2) Complex,
        (∫ x : Euclidean 2, ‖circleEndpointWaveContribution C σ j t f x‖ ^ 2) ≤
          (B / Real.sqrt (dyadicScale j)) ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨B, hB, hpoint⟩ :=
    exists_norm_circleEndpointBandpassMultiplier_le_dyadicSqrtInverse C
  refine ⟨B, hB, ?_⟩
  intro σ j t ht htop f
  let m : SchwartzMap (Euclidean 2) Complex :=
    circleEndpointBandpassSchwartzSymbol C σ j t
  have hm_bound (xi : Euclidean 2) : ‖m xi‖ ≤ B / Real.sqrt (dyadicScale j) := by
    rw [show m xi = circleEndpointBandpassSchwartzSymbol C σ j t xi by rfl,
      circleEndpointBandpassSchwartzSymbol_apply]
    exact hpoint σ j t xi ht htop
  have hmult := _root_.Auto.Spherical.Auxiliary.integral_norm_sq_fourierInv_schwartz_multiplier_le
    m (𝓕 f) (div_nonneg hB.le (Real.sqrt_nonneg _)) hm_bound
  calc
    (∫ x : Euclidean 2, ‖circleEndpointWaveContribution C σ j t f x‖ ^ 2) =
        ∫ x : Euclidean 2, ‖𝓕⁻ (fun xi : Euclidean 2 =>
          m xi * 𝓕 (f : Euclidean 2 → Complex) xi) x‖ ^ 2 := by
          congr 1
          funext x
          rw [circleEndpointWaveContribution_factorization C σ j t f x]
          congr 2
          apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
          funext xi
          rw [show m xi = circleEndpointBandpassSchwartzSymbol C σ j t xi by rfl,
            circleEndpointBandpassSchwartzSymbol_apply]
    _ ≤ (B / Real.sqrt (dyadicScale j)) ^ 2 *
        ∫ xi : Euclidean 2, ‖𝓕 (f : Euclidean 2 → Complex) xi‖ ^ 2 := hmult
    _ = (B / Real.sqrt (dyadicScale j)) ^ 2 *
        ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
      rw [_root_.Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq]

private theorem norm_halfWaveMultiplierTimeDerivative
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (t : Real) (xi : Euclidean 2) :
    ‖_root_.Auto.Spherical.MSSBase.halfWaveMultiplierTimeDerivative σ t xi‖ =
      2 * Real.pi * ‖xi‖ := by
  cases σ <;>
    simp [
      _root_.Auto.Spherical.MSSBase.halfWaveMultiplierTimeDerivative,
      _root_.Auto.Spherical.MSSBase.WaveSign.toReal,
      norm_mul, _root_.Auto.Spherical.MSSBase.norm_halfWaveMultiplier,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg, Real.pi_pos.le,
      mul_nonneg]

/-- The literal endpoint multiplier time derivative has the expected
`sqrt (2^j)` size.  Thus fixed-time endpoint energy is `O(2^j)`, precisely
balancing the `O(2^{-j})` energy of the undifferentiated endpoint. -/
private theorem exists_norm_circleEndpointBandpassMultiplierTimeDerivative_le_dyadicSqrt
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : _root_.Auto.Spherical.MSSBase.WaveSign)
      (j : Nat) (t : Real) (xi : Euclidean 2), 1 ≤ t → t ≤ 2 →
      ‖circleEndpointBandpassMultiplierTimeDerivative C σ j t xi‖ ≤
        B * Real.sqrt (dyadicScale j) := by
  obtain ⟨A, hA, hamp⟩ := exists_circleEndpointAmplitude_decay
  obtain ⟨D, hD, htime⟩ := exists_norm_circleEndpointAmplitudeTimeDerivative_decay
  let K : Real := ‖((surfaceMass 2)⁻¹ : Complex)‖ * surfaceMass 1
  let B : Real := 2 * K * (D + 8 * Real.pi * A)
  have hmass2 : ((surfaceMass 2 : Real) : Complex) ≠ 0 := by
    exact_mod_cast surfaceMass_ne_zero (by norm_num : 0 < 2)
  have hK : 0 < K := by
    dsimp [K]
    have hinv : 0 < ‖((surfaceMass 2)⁻¹ : Complex)‖ :=
      norm_pos_iff.mpr (inv_ne_zero hmass2)
    have hmass1 : 0 < surfaceMass 1 := surfaceMass_pos (by norm_num)
    positivity
  have hB : 0 < B := by
    dsimp [B]
    positivity
  refine ⟨B, hB, ?_⟩
  intro σ j t xi ht _
  by_cases hband :
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0
  · rw [show circleEndpointBandpassMultiplierTimeDerivative C σ j t xi = 0 by
        simp [circleEndpointBandpassMultiplierTimeDerivative, hband]]
    rw [norm_zero]
    positivity
  · let d : Real := dyadicScale j
    let L : Real := 2 * Real.pi * (t * ‖xi‖)
    let R : Real := 2 * Real.pi * ‖xi‖
    have hdpos : 0 < d := by
      dsimp [d]
      exact dyadicScale_pos j
    have hdone : 1 ≤ d := by
      dsimp [d]
      calc
        1 = dyadicScale 0 := by simp [dyadicScale]
        _ ≤ dyadicScale j := dyadicScale_mono (Nat.zero_le j)
    have hfrequency : d ≤ L := by
      dsimp [d, L]
      simpa only [dyadicScale] using
        aux_dyadicFrequency_le_circleEndpointFrequency C j t xi ht hband
    have hlarge : 1 ≤ L := hdone.trans hfrequency
    have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one hlarge
    have hspos : 0 < Real.sqrt d := Real.sqrt_pos.2 hdpos
    have hsquare : (Real.sqrt d) * Real.sqrt d = d := by
      rw [← pow_two]
      exact Real.sq_sqrt hdpos.le
    have hxi : ‖xi‖ < (2 : Real) ^ (j + 2) := by
      by_contra hnot
      exact hband
        (_root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_le_norm C
          (le_of_not_gt hnot))
    have hpow : (2 : Real) ^ (j + 2) = 4 * d := by
      dsimp [d, dyadicScale]
      rw [show j + 2 = j + 2 by rfl, pow_add]
      ring
    have hxiupper : ‖xi‖ ≤ 4 * d := by
      calc
        ‖xi‖ ≤ (2 : Real) ^ (j + 2) := hxi.le
        _ = 4 * d := hpow
    have hRnonneg : 0 ≤ R := by
      dsimp [R]
      positivity
    have hRupper : R ≤ 8 * Real.pi * d := by
      dsimp [R]
      calc
        2 * Real.pi * ‖xi‖ ≤ 2 * Real.pi * (4 * d) :=
          mul_le_mul_of_nonneg_left hxiupper (by positivity)
        _ = 8 * Real.pi * d := by ring
    have hsqrt_le : Real.sqrt d ≤ Real.sqrt L := Real.sqrt_le_sqrt hfrequency
    have hampRaw : ‖circleEndpointAmplitude σ L‖ ≤ A / Real.sqrt L :=
      hamp σ L hlarge
    have hampBound : ‖circleEndpointAmplitude σ L‖ ≤ A / Real.sqrt d :=
      hampRaw.trans (div_le_div_of_nonneg_left hA.le hspos hsqrt_le)
    have htimeRaw : ‖circleEndpointAmplitudeTimeDerivative σ t xi‖ ≤
        D / Real.sqrt L := htime σ t xi ht hlarge
    have htimeBound : ‖circleEndpointAmplitudeTimeDerivative σ t xi‖ ≤
        D / Real.sqrt d :=
      htimeRaw.trans (div_le_div_of_nonneg_left hD.le hspos hsqrt_le)
    have hinv_le : (1 : Real) / Real.sqrt d ≤ Real.sqrt d := by
      apply (div_le_iff₀ hspos).mpr
      rw [hsquare]
      exact hdone
    have htimeSqrt : ‖circleEndpointAmplitudeTimeDerivative σ t xi‖ ≤
        D * Real.sqrt d := by
      calc
        ‖circleEndpointAmplitudeTimeDerivative σ t xi‖ ≤ D / Real.sqrt d := htimeBound
        _ = D * (1 / Real.sqrt d) := by ring
        _ ≤ D * Real.sqrt d := mul_le_mul_of_nonneg_left hinv_le hD.le
    have hhalfTime := norm_halfWaveMultiplierTimeDerivative σ t xi
    have hsecond : ‖circleEndpointAmplitude σ L *
        _root_.Auto.Spherical.MSSBase.halfWaveMultiplierTimeDerivative σ t xi‖ ≤
        (8 * Real.pi * A) * Real.sqrt d := by
      rw [norm_mul, hhalfTime]
      calc
        ‖circleEndpointAmplitude σ L‖ * R ≤ (A / Real.sqrt d) * R :=
          mul_le_mul_of_nonneg_right hampBound hRnonneg
        _ ≤ (A / Real.sqrt d) * (8 * Real.pi * d) :=
          mul_le_mul_of_nonneg_left hRupper (div_nonneg hA.le hspos.le)
        _ = (8 * Real.pi * A) * Real.sqrt d := by
          have hfactor : d / Real.sqrt d = Real.sqrt d := by
            calc
              d / Real.sqrt d = (Real.sqrt d * Real.sqrt d) / Real.sqrt d := by
                rw [hsquare]
              _ = Real.sqrt d := by
                field_simp
          calc
            (A / Real.sqrt d) * (8 * Real.pi * d) =
                (8 * Real.pi * A) * (d / Real.sqrt d) := by ring
            _ = _ := by rw [hfactor]
    have hfirst : ‖circleEndpointAmplitudeTimeDerivative σ t xi *
        _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t xi‖ ≤
        D * Real.sqrt d := by
      rw [norm_mul, _root_.Auto.Spherical.MSSBase.norm_halfWaveMultiplier, mul_one]
      exact htimeSqrt
    have hsum : ‖circleEndpointAmplitudeTimeDerivative σ t xi *
          _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t xi +
        circleEndpointAmplitude σ L *
          _root_.Auto.Spherical.MSSBase.halfWaveMultiplierTimeDerivative σ t xi‖ ≤
        (D + 8 * Real.pi * A) * Real.sqrt d := by
      calc
        _ ≤ ‖circleEndpointAmplitudeTimeDerivative σ t xi *
          _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t xi‖ +
          ‖circleEndpointAmplitude σ L *
            _root_.Auto.Spherical.MSSBase.halfWaveMultiplierTimeDerivative σ t xi‖ :=
          norm_add_le _ _
        _ ≤ D * Real.sqrt d + (8 * Real.pi * A) * Real.sqrt d :=
          add_le_add hfirst hsecond
        _ = (D + 8 * Real.pi * A) * Real.sqrt d := by ring
    have hcut :
        ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ ≤ 2 :=
      _root_.Auto.LittlewoodPaley.norm_dyadicBandpassMultiplier_le_two C j xi
    have hinner : ‖circleEndpointAmplitudeTimeDerivative σ t xi *
          _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t xi +
        circleEndpointAmplitude σ L *
          _root_.Auto.Spherical.MSSBase.halfWaveMultiplierTimeDerivative σ t xi‖ *
        ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ ≤
        ((D + 8 * Real.pi * A) * Real.sqrt d) * 2 :=
      mul_le_mul hsum hcut (norm_nonneg _) (by positivity)
    have hmass1 : 0 ≤ surfaceMass 1 := (surfaceMass_pos (by norm_num)).le
    change ‖((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      (circleEndpointAmplitudeTimeDerivative σ t xi *
          _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t xi +
        circleEndpointAmplitude σ L *
          _root_.Auto.Spherical.MSSBase.halfWaveMultiplierTimeDerivative σ t xi) *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ ≤
      B * Real.sqrt (dyadicScale j)
    calc
      ‖((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          (circleEndpointAmplitudeTimeDerivative σ t xi *
              _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t xi +
            circleEndpointAmplitude σ L *
              _root_.Auto.Spherical.MSSBase.halfWaveMultiplierTimeDerivative σ t xi) *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ =
          K * (‖circleEndpointAmplitudeTimeDerivative σ t xi *
              _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t xi +
            circleEndpointAmplitude σ L *
              _root_.Auto.Spherical.MSSBase.halfWaveMultiplierTimeDerivative σ t xi‖ *
            ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖) := by
          unfold K
          rw [norm_mul, norm_mul, norm_mul, Complex.norm_real,
            Real.norm_of_nonneg hmass1]
          ring
      _ ≤ K * (((D + 8 * Real.pi * A) * Real.sqrt d) * 2) :=
        mul_le_mul_of_nonneg_left hinner hK.le
      _ = B * Real.sqrt d := by
        dsimp [B]
        ring
      _ = B * Real.sqrt (dyadicScale j) := by rfl

private theorem circleEndpointBandpassMultiplierTimeDerivative_eventuallyEq_zero_at_zero
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real) :
    circleEndpointBandpassMultiplierTimeDerivative C σ j t =ᶠ[nhds 0] fun _ => 0 := by
  filter_upwards [Metric.ball_mem_nhds (0 : Euclidean 2) zero_lt_one] with xi hxi
  have hxinorm : ‖xi‖ < 1 := by
    simpa only [Metric.mem_ball, dist_zero_right] using hxi
  have hone : 1 ≤ (2 : Real) ^ j :=
    one_le_pow₀ (by norm_num : (1 : Real) ≤ 2)
  have hband :
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0 :=
    _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_norm_le C
      (hxinorm.le.trans hone)
  simp [circleEndpointBandpassMultiplierTimeDerivative, hband]

private theorem contDiff_circleEndpointBandpassMultiplierTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real) :
    ContDiff Real (⊤ : ℕ∞) (circleEndpointBandpassMultiplierTimeDerivative C σ j t) := by
  rw [contDiff_iff_contDiffAt]
  intro xi
  by_cases hxi : xi = 0
  · subst xi
    exact (contDiffAt_const (c := (0 : Complex))).congr_of_eventuallyEq
      (circleEndpointBandpassMultiplierTimeDerivative_eventuallyEq_zero_at_zero C σ j t)
  · have hnorm : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 => ‖eta‖) xi :=
      contDiffAt_norm Real hxi
    have hscale : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
        ((2 * Real.pi * ‖eta‖ : Real) : Complex)) xi := by
      have hscaleReal : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
          2 * Real.pi * ‖eta‖) xi := by
        fun_prop
      exact Complex.ofRealCLM.contDiff.contDiffAt.comp xi hscaleReal
    have harg : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
        2 * Real.pi * (t * ‖eta‖)) xi := by
      fun_prop
    have hderiv : ContDiff Real (⊤ : ℕ∞) (deriv (circleEndpointAmplitude σ)) :=
      (contDiff_infty_iff_deriv.mp (contDiff_circleEndpointAmplitude σ)).2
    have hampTime : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
        circleEndpointAmplitudeTimeDerivative σ t eta) xi := by
      unfold circleEndpointAmplitudeTimeDerivative
      exact hscale.mul (hderiv.contDiffAt.comp xi harg)
    have hamp : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖eta‖))) xi :=
      (contDiff_circleEndpointAmplitude σ).contDiffAt.comp xi harg
    have hhalf : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
        _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t eta) xi :=
      _root_.Auto.Spherical.MSSBase.halfWaveMultiplier_contDiffAt_of_ne_zero σ t hxi
    have hhalfTime : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
        _root_.Auto.Spherical.MSSBase.halfWaveMultiplierTimeDerivative σ t eta) xi := by
      unfold _root_.Auto.Spherical.MSSBase.halfWaveMultiplierTimeDerivative
      have hcoef : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
          (((σ.toReal * (2 * Real.pi) * ‖eta‖ : Real) : Complex) * Complex.I)) xi := by
        have hcoefReal : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
            σ.toReal * (2 * Real.pi) * ‖eta‖) xi := by
          fun_prop
        exact (Complex.ofRealCLM.contDiff.contDiffAt.comp xi hcoefReal).mul contDiffAt_const
      exact hcoef.mul hhalf
    have hcut : ContDiffAt Real (⊤ : ℕ∞)
        (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j) xi :=
      ((_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j).smooth
        (⊤ : ℕ∞)).contDiffAt
    unfold circleEndpointBandpassMultiplierTimeDerivative
    exact (((contDiffAt_const.mul contDiffAt_const).mul
      (hampTime.mul hhalf |>.add (hamp.mul hhalfTime))).mul hcut)

private theorem hasCompactSupport_circleEndpointBandpassMultiplierTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real) :
    HasCompactSupport (circleEndpointBandpassMultiplierTimeDerivative C σ j t) := by
  apply HasCompactSupport.intro
    (isCompact_closedBall (0 : Euclidean 2) ((2 : Real) ^ (j + 2)))
  intro xi hxi
  have hnorm : (2 : Real) ^ (j + 2) ≤ ‖xi‖ := by
    rw [Metric.mem_closedBall, dist_zero_right] at hxi
    exact le_of_not_ge hxi
  have hband :
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0 :=
    _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_le_norm C hnorm
  simp [circleEndpointBandpassMultiplierTimeDerivative, hband]

private noncomputable def circleEndpointBandpassMultiplierTimeDerivativeSchwartzSymbol
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real) :
    SchwartzMap (Euclidean 2) Complex :=
  (hasCompactSupport_circleEndpointBandpassMultiplierTimeDerivative C σ j t).toSchwartzMap
    (contDiff_circleEndpointBandpassMultiplierTimeDerivative C σ j t)

private theorem circleEndpointBandpassMultiplierTimeDerivativeSchwartzSymbol_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real)
    (xi : Euclidean 2) :
    circleEndpointBandpassMultiplierTimeDerivativeSchwartzSymbol C σ j t xi =
      circleEndpointBandpassMultiplierTimeDerivative C σ j t xi := rfl

/-- The derivative endpoint contribution has fixed-time `L²` energy of
order `2^j`; this is the sharp scaling expected from differentiating the
half-wave phase once in time. -/
theorem exists_integral_norm_sq_circleEndpointWaveContributionTimeDerivative_le_dyadicSqrt
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : _root_.Auto.Spherical.MSSBase.WaveSign)
      (j : Nat) (t : Real), 1 ≤ t → t ≤ 2 →
      ∀ f : SchwartzMap (Euclidean 2) Complex,
        (∫ x : Euclidean 2,
          ‖circleEndpointWaveContributionTimeDerivative C σ j t f x‖ ^ 2) ≤
          (B * Real.sqrt (dyadicScale j)) ^ 2 *
            ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨B, hB, hpoint⟩ :=
    exists_norm_circleEndpointBandpassMultiplierTimeDerivative_le_dyadicSqrt C
  refine ⟨B, hB, ?_⟩
  intro σ j t ht htop f
  let m : SchwartzMap (Euclidean 2) Complex :=
    circleEndpointBandpassMultiplierTimeDerivativeSchwartzSymbol C σ j t
  have hm_bound (xi : Euclidean 2) : ‖m xi‖ ≤ B * Real.sqrt (dyadicScale j) := by
    rw [show m xi = circleEndpointBandpassMultiplierTimeDerivativeSchwartzSymbol C σ j t xi by rfl,
      circleEndpointBandpassMultiplierTimeDerivativeSchwartzSymbol_apply]
    exact hpoint σ j t xi ht htop
  have hmult := _root_.Auto.Spherical.Auxiliary.integral_norm_sq_fourierInv_schwartz_multiplier_le
    m (𝓕 f) (mul_nonneg hB.le (Real.sqrt_nonneg _)) hm_bound
  calc
    (∫ x : Euclidean 2,
        ‖circleEndpointWaveContributionTimeDerivative C σ j t f x‖ ^ 2) =
        ∫ x : Euclidean 2, ‖𝓕⁻ (fun xi : Euclidean 2 =>
          m xi * 𝓕 (f : Euclidean 2 → Complex) xi) x‖ ^ 2 := by
          rfl
    _ ≤ (B * Real.sqrt (dyadicScale j)) ^ 2 *
        ∫ xi : Euclidean 2, ‖𝓕 (f : Euclidean 2 → Complex) xi‖ ^ 2 := hmult
    _ = (B * Real.sqrt (dyadicScale j)) ^ 2 *
        ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
      rw [_root_.Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq]

/-- The time derivative of the normalized radial endpoint amplitude.  This
is the multiplier-side derivative after the half-wave has been factored into
the input, so it is the appropriate candidate for a uniform annular kernel
certificate. -/
private noncomputable def circleEndpointScaledRadialAmplitudeTimeDerivative
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real) :
    Real → Complex :=
  fun ρ => circleEndpointDyadicNormalization j *
    ((2 * Real.pi * (2 : Real) ^ j * ρ : Real) : Complex) *
      deriv (circleEndpointAmplitude σ)
        ((2 * Real.pi * t * (2 : Real) ^ j) * ρ)

/-- Euler's identity turns the parameter derivative into `ρ/t` times one
radial derivative.  It exposes a direct route from the existing uniform
radial symbol bounds to the derivative family. -/
private theorem circleEndpointScaledRadialAmplitudeTimeDerivative_eq_rho_div_t_mul_deriv
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real) (ht : t ≠ 0) :
    circleEndpointScaledRadialAmplitudeTimeDerivative σ j t =
      fun ρ => ((ρ / t : Real) : Complex) *
        deriv (circleEndpointScaledRadialAmplitude σ j t) ρ := by
  funext ρ
  rw [show deriv (circleEndpointScaledRadialAmplitude σ j t) ρ =
      iteratedDeriv 1 (circleEndpointScaledRadialAmplitude σ j t) ρ by
        rw [iteratedDeriv_one]]
  rw [iteratedDeriv_circleEndpointScaledRadialAmplitude σ j 1 t]
  simp only [pow_one, Complex.real_smul]
  rw [iteratedDeriv_one]
  unfold circleEndpointScaledRadialAmplitudeTimeDerivative
  have hscalar : 2 * Real.pi * (2 : Real) ^ j * ρ =
      (ρ / t) * (2 * Real.pi * t * (2 : Real) ^ j) := by
    field_simp [ht]
  have hcast : ((2 * Real.pi * (2 : Real) ^ j * ρ : Real) : Complex) =
      ((ρ / t : Real) : Complex) *
        ((2 * Real.pi * t * (2 : Real) ^ j : Real) : Complex) := by
    exact_mod_cast hscalar
  rw [hcast]
  ring

private theorem iteratedDeriv_complex_ofReal_id
    (k : Nat) (ρ : Real) :
    iteratedDeriv k (fun r : Real => (r : Complex)) ρ =
      if k = 0 then (ρ : Complex) else if k = 1 then 1 else 0 := by
  cases k with
  | zero => simp
  | succ k =>
      rw [iteratedDeriv_succ']
      have hderiv : deriv (fun r : Real => (r : Complex)) = fun _ => (1 : Complex) := by
        funext r
        exact (hasDerivAt_id r).ofReal_comp.deriv
      rw [hderiv, iteratedDeriv_const]
      cases k <;> simp

private theorem norm_iteratedDeriv_timeEulerFactor_le
    (k : Nat) (t ρ : Real) (ht : 1 ≤ t) (hρ : 0 ≤ ρ) (hρtop : ρ ≤ 16) :
    ‖iteratedDeriv k (fun r : Real => ((t⁻¹ : Real) : Complex) * (r : Complex)) ρ‖ ≤ 16 := by
  rw [iteratedDeriv_const_mul_field]
  rw [iteratedDeriv_complex_ofReal_id]
  have htpos : 0 < t := lt_of_lt_of_le zero_lt_one ht
  have hinvnonneg : 0 ≤ t⁻¹ := inv_nonneg.mpr htpos.le
  have hinvle : t⁻¹ ≤ 1 := (inv_le_one₀ htpos).mpr ht
  by_cases hk0 : k = 0
  · subst k
    simp only [ite_true, norm_mul, Complex.norm_real]
    rw [Real.norm_of_nonneg hinvnonneg, Real.norm_of_nonneg hρ]
    calc
      t⁻¹ * ρ ≤ 1 * 16 := mul_le_mul hinvle hρtop hρ (by norm_num)
      _ = 16 := by norm_num
  · have hkpos : 0 < k := Nat.pos_of_ne_zero hk0
    simp only [if_neg hk0]
    by_cases hk1 : k = 1
    · subst k
      simp only [ite_true, norm_mul, Complex.norm_real,
        Real.norm_of_nonneg hinvnonneg, norm_one]
      simp only [mul_one]
      calc
        t⁻¹ ≤ 1 := hinvle
        _ ≤ 16 := by norm_num
    · simp [hk1]

private theorem norm_iteratedDeriv_mul_le
    {n : Nat} {f g : Real → Complex} {x : Real} {A B : Real}
    (hf : ContDiff Real (⊤ : ℕ∞) f)
    (hg : ContDiff Real (⊤ : ℕ∞) g)
    (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hfa : ∀ k : Nat, k ≤ n → ‖iteratedDeriv k f x‖ ≤ A)
    (hgb : ∀ k : Nat, k ≤ n → ‖iteratedDeriv k g x‖ ≤ B) :
    ‖iteratedDeriv n (fun u : Real => f u * g u) x‖ ≤
      ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) * A * B := by
  change ‖iteratedDeriv n (f * g) x‖ ≤ _
  rw [iteratedDeriv_mul
    ((hf.of_le (show (n : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) by
      exact WithTop.coe_le_coe.mpr le_top)).contDiffAt)
    ((hg.of_le (show (n : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) by
      exact WithTop.coe_le_coe.mpr le_top)).contDiffAt)]
  calc
    ‖∑ i ∈ Finset.range (n + 1), n.choose i * iteratedDeriv i f x *
        iteratedDeriv (n - i) g x‖ ≤
      ∑ i ∈ Finset.range (n + 1),
        ‖n.choose i * iteratedDeriv i f x * iteratedDeriv (n - i) g x‖ :=
      norm_sum_le _ _
    _ ≤ ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) * A * B := by
      apply Finset.sum_le_sum
      intro i hi
      have hi' : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      have hleft := hfa i hi'
      have hright := hgb (n - i) (Nat.sub_le _ _)
      rw [norm_mul, norm_mul, norm_natCast]
      calc
        (n.choose i : Real) * ‖iteratedDeriv i f x‖ *
            ‖iteratedDeriv (n - i) g x‖ =
            (n.choose i : Real) *
              (‖iteratedDeriv i f x‖ * ‖iteratedDeriv (n - i) g x‖) := by ring
        _ ≤ (n.choose i : Real) * (A * B) :=
          mul_le_mul_of_nonneg_left
            (mul_le_mul hleft hright (norm_nonneg _) hA)
            (Nat.cast_nonneg (n.choose i))
        _ = (n.choose i : Real) * A * B := by ring

private theorem contDiff_circleEndpointScaledRadialAmplitude
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real) :
    ContDiff Real (⊤ : ℕ∞) (circleEndpointScaledRadialAmplitude σ j t) := by
  unfold circleEndpointScaledRadialAmplitude
  apply ContDiff.mul
  · fun_prop
  · apply (contDiff_circleEndpointAmplitude σ).comp
    fun_prop

/-- Every fixed radial derivative of the multiplier-side time derivative is
uniform on the fixed positive annulus.  The proof is deliberately routed
through the existing all-order radial endpoint bounds via Euler's identity. -/
private theorem exists_uniform_norm_iteratedDeriv_circleEndpointScaledRadialAmplitudeTimeDerivative_le
    (n : Nat) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : _root_.Auto.Spherical.MSSBase.WaveSign)
      (j : Nat) (t ρ : Real), 1 ≤ t → (1 / 4 : Real) ≤ ρ → ρ ≤ 16 →
      ‖iteratedDeriv n
        (circleEndpointScaledRadialAmplitudeTimeDerivative σ j t) ρ‖ ≤ B := by
  choose H hHpos hH using fun k : Nat =>
    exists_uniform_norm_iteratedDeriv_circleEndpointScaledRadialAmplitude_le (k + 1)
  let A : Real := ∑ k ∈ Finset.range (n + 1), H k
  have hApos : 0 < A := by
    have hmem : 0 ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hle : H 0 ≤ A := by
      dsimp [A]
      exact Finset.single_le_sum (fun k hk => (hHpos k).le) hmem
    exact lt_of_lt_of_le (hHpos 0) hle
  let B : Real := ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) * 16 * A
  have hBpos : 0 < B := by
    have hmem : 0 ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hterm : 0 < (n.choose 0 : Real) * 16 * A := by
      simp
      positivity
    have hle : (n.choose 0 : Real) * 16 * A ≤ B := by
      dsimp [B]
      exact Finset.single_le_sum
        (s := Finset.range (n + 1))
        (f := fun i : Nat => (n.choose i : Real) * 16 * A)
        (fun i hi => by positivity) hmem
    exact lt_of_lt_of_le hterm hle
  refine ⟨B, hBpos, ?_⟩
  intro σ j t ρ ht hρ hρtop
  let F : Real → Complex := circleEndpointScaledRadialAmplitude σ j t
  let U : Real → Complex := fun r => ((t⁻¹ : Real) : Complex) * (r : Complex)
  have htne : t ≠ 0 := ne_of_gt (lt_of_lt_of_le zero_lt_one ht)
  have hformula : circleEndpointScaledRadialAmplitudeTimeDerivative σ j t =
      fun r => U r * deriv F r := by
    rw [circleEndpointScaledRadialAmplitudeTimeDerivative_eq_rho_div_t_mul_deriv
      σ j t htne]
    funext r
    dsimp [U]
    push_cast
    ring
  have hU : ContDiff Real (⊤ : ℕ∞) U := by
    dsimp [U]
    exact contDiff_const.mul Complex.ofRealCLM.contDiff
  have hF : ContDiff Real (⊤ : ℕ∞) F := by
    dsimp [F]
    exact contDiff_circleEndpointScaledRadialAmplitude σ j t
  have hF' : ContDiff Real (⊤ : ℕ∞) (deriv F) :=
    (contDiff_infty_iff_deriv.mp hF).2
  have hUbound (k : Nat) (hk : k ≤ n) : ‖iteratedDeriv k U ρ‖ ≤ 16 := by
    dsimp [U]
    exact norm_iteratedDeriv_timeEulerFactor_le k t ρ ht
      (by linarith) hρtop
  have hF'bound (k : Nat) (hk : k ≤ n) : ‖iteratedDeriv k (deriv F) ρ‖ ≤ A := by
    rw [← iteratedDeriv_succ']
    have hmain := hH k σ j t ρ ht hρ hρtop
    have hmem : k ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hle : H k ≤ A := by
      dsimp [A]
      exact Finset.single_le_sum (fun l hl => (hHpos l).le) hmem
    exact hmain.trans hle
  rw [hformula]
  have hprod := norm_iteratedDeriv_mul_le (n := n) hU hF'
    (by norm_num) hApos.le hUbound hF'bound
  exact hprod

private theorem contDiff_circleEndpointScaledRadialAmplitudeTimeDerivative
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real) :
    ContDiff Real (⊤ : ℕ∞)
      (circleEndpointScaledRadialAmplitudeTimeDerivative σ j t) := by
  unfold circleEndpointScaledRadialAmplitudeTimeDerivative
  apply ContDiff.mul
  · apply ContDiff.mul
    · fun_prop
    · exact Complex.ofRealCLM.contDiff.comp (contDiff_const.mul contDiff_id)
  · apply ((contDiff_infty_iff_deriv.mp
      (contDiff_circleEndpointAmplitude σ)).2).comp
    fun_prop

/-- The radial time-derivative family has uniformly bounded multivariable
derivatives on the fixed positive annulus. -/
private theorem exists_uniform_norm_iteratedFDeriv_circleEndpointScaledRadialAmplitudeTimeDerivativeComp_le
    (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ (σ : _root_.Auto.Spherical.MSSBase.WaveSign)
      (j : Nat) (t : Real) (η : Euclidean 2),
      1 ≤ t → (1 / 4 : Real) ≤ ‖η‖ → ‖η‖ ≤ 16 →
      ‖iteratedFDeriv Real n
        (fun y : Euclidean 2 =>
          circleEndpointScaledRadialAmplitudeTimeDerivative σ j t ‖y‖) η‖ ≤ C := by
  choose A hApos hAbound using fun i : Nat =>
    exists_uniform_norm_iteratedDeriv_circleEndpointScaledRadialAmplitudeTimeDerivative_le i
  choose D hDpos hDbound using fun i : Nat =>
    _root_.Auto.MikhlinHormander.exists_norm_iteratedFDeriv_norm_bound_on_annulus
      (d := 2) (r := 1 / 4) (R := 16) i (by norm_num : (0 : Real) < 1 / 4)
  let CA : Real := ∑ i ∈ Finset.range (n + 1), A i
  let CD : Real := (∑ i ∈ Finset.range (n + 1), D i) + 1
  have hCApos : 0 < CA := by
    have hmem : 0 ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hle : A 0 ≤ CA := by
      dsimp [CA]
      exact Finset.single_le_sum (fun i hi => (hApos i).le) hmem
    exact lt_of_lt_of_le (hApos 0) hle
  have hCDone : 1 ≤ CD := by
    dsimp [CD]
    have hsum : 0 ≤ ∑ i ∈ Finset.range (n + 1), D i :=
      Finset.sum_nonneg fun i hi => (hDpos i).le
    linarith
  refine ⟨((Nat.factorial n : Nat) : Real) * CA * CD ^ n, by positivity, ?_⟩
  intro σ j t η ht hηinner hηouter
  let s : Set (Euclidean 2) := ({0}ᶜ : Set (Euclidean 2))
  have hsopen : IsOpen s := by
    simpa only [s] using (isOpen_compl_singleton : IsOpen ({0}ᶜ : Set (Euclidean 2)))
  have hsunique : UniqueDiffOn Real s := hsopen.uniqueDiffOn
  have hηne : η ≠ 0 := by
    intro hzero
    subst η
    norm_num at hηinner
  have hηs : η ∈ s := by simpa [s] using hηne
  let g : Real → Complex :=
    circleEndpointScaledRadialAmplitudeTimeDerivative σ j t
  let f : Euclidean 2 → Real := fun y => ‖y‖
  have hg : ContDiff Real n g := by
    dsimp [g]
    exact (contDiff_circleEndpointScaledRadialAmplitudeTimeDerivative σ j t).of_le
      (show (n : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) by
        exact WithTop.coe_le_coe.mpr le_top)
  have hf : ContDiffOn Real n f s := by
    intro x hx
    exact (contDiffAt_norm Real (by simpa [s] using hx)).contDiffWithinAt
  have hgfAt : ContDiffAt Real n (g ∘ f) η :=
    hg.contDiffAt.comp η (contDiffAt_norm Real hηne)
  have hC : ∀ i, i ≤ n → ‖iteratedFDerivWithin Real i g Set.univ (f η)‖ ≤ CA := by
    intro i hi
    rw [iteratedFDerivWithin_univ]
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv]
    have hbase := hAbound i σ j t (f η) ht (by simpa [f] using hηinner)
      (by simpa [f] using hηouter)
    have hmem : i ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hle : A i ≤ CA := by
      dsimp [CA]
      exact Finset.single_le_sum (fun l hl => (hApos l).le) hmem
    exact hbase.trans hle
  have hD : ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDerivWithin Real i f s η‖ ≤ CD ^ i := by
    intro i hi1 hi
    have hfeq : iteratedFDerivWithin Real i f s η = iteratedFDeriv Real i f η :=
      iteratedFDerivWithin_eq_iteratedFDeriv hsunique
        ((contDiffAt_norm Real hηne).of_le
          (show (i : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) by
            exact WithTop.coe_le_coe.mpr le_top)) hηs
    rw [hfeq]
    have hbase := hDbound i η hηinner hηouter
    have hmem : i ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hle : D i ≤ CD := by
      dsimp [CD]
      calc
        D i ≤ ∑ l ∈ Finset.range (n + 1), D l :=
          Finset.single_le_sum (fun l hl => (hDpos l).le) hmem
        _ ≤ (∑ l ∈ Finset.range (n + 1), D l) + 1 := by linarith
    have hpow : CD ≤ CD ^ i := by
      obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hi1)
      rw [pow_succ]
      calc
        CD = 1 * CD := (one_mul _).symm
        _ ≤ CD ^ m * CD :=
          mul_le_mul_of_nonneg_right (one_le_pow₀ hCDone) (le_trans (by norm_num) hCDone)
    exact hbase.trans (hle.trans hpow)
  have hcomp := norm_iteratedFDerivWithin_comp_le
    (g := g) (f := f) (s := s) (t := Set.univ)
