/-- Uniform spatial derivatives of a smooth joint time--frequency symbol on
the compact box `Icc 1 2 × closedBall 0 16`. -/
private theorem exists_uniform_spatial_iteratedFDeriv_of_joint
    {g : Real × Euclidean 2 → Complex}
    (n : Nat) (hg : ContDiff Real n g) :
    ∃ B : Real, 0 ≤ B ∧ ∀ (t : Real) (eta : Euclidean 2),
      t ∈ Icc (1 : Real) 2 → eta ∈ Metric.closedBall 0 (16 : Real) →
        ‖iteratedFDeriv Real n (fun y => g (t, y)) eta‖ ≤ B := by
  let K : Set (Real × Euclidean 2) :=
    Icc (1 : Real) 2 ×ˢ Metric.closedBall 0 (16 : Real)
  have hKcompact : IsCompact K :=
    isCompact_Icc.prod (isCompact_closedBall (0 : Euclidean 2) 16)
  have hcont : Continuous (fun z => iteratedFDeriv Real n g z) :=
    hg.continuous_iteratedFDeriv (by exact_mod_cast le_rfl)
  obtain ⟨B0, hB0⟩ := hKcompact.exists_bound_of_continuousOn hcont.continuousOn
  let B : Real := max B0 0
  have hB : 0 ≤ B := le_max_right _ _
  refine ⟨B, hB, ?_⟩
  intro t eta ht heta
  let a : Real × Euclidean 2 := (t, 0)
  let L : Euclidean 2 →ₗᵢ[Real] (Real × Euclidean 2) :=
    LinearIsometry.inr Real Real (Euclidean 2)
  let h : Real × Euclidean 2 → Complex := fun z => g (a + z)
  have hh : ContDiff Real n h := by
    change ContDiff Real n (g ∘ fun z => a + z)
    apply hg.comp
    fun_prop
  have hslice : (fun y : Euclidean 2 => g (t, y)) = h ∘ L := by
    funext y
    simp [h, a, L]
  rw [hslice]
  change ‖iteratedFDeriv Real n (h ∘ L.toContinuousLinearMap) eta‖ ≤ B
  rw [L.toContinuousLinearMap.iteratedFDeriv_comp_right hh eta
    (by exact_mod_cast le_rfl)]
  calc
    ‖(iteratedFDeriv Real n h (L eta)).compContinuousLinearMap
        fun _ => L.toContinuousLinearMap‖ ≤ ‖iteratedFDeriv Real n h (L eta)‖ := by
      exact ContinuousMultilinearMap.norm_compContinuous_linearIsometry_le _ (fun _ => L)
    _ = ‖iteratedFDeriv Real n g (a + L eta)‖ := by
      rw [iteratedFDeriv_comp_add_left]
    _ ≤ B0 := by
      apply hB0
      simpa [K, a, L] using And.intro ht heta
    _ ≤ B := le_max_left _ _

theorem exists_uniform_norm_iteratedFDeriv_circleRelativeBandFatUnitFamily_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) (n : Nat) :
    ∃ B : Real, 0 ≤ B ∧ ∀ (t : CircleRelativeBandLocalTime) (eta : Euclidean 2),
      ‖iteratedFDeriv Real n
        (circleRelativeBandFatUnitFamily C t : Euclidean 2 → Complex) eta‖ ≤ B := by
  obtain ⟨B, hB, hjoint⟩ := exists_uniform_spatial_iteratedFDeriv_of_joint n
    (circleRelativeBandFatUnitJoint_contDiff C n)
  let K : Set (Euclidean 2) :=
    Metric.closedBall 0 (16 : Real) ∩ {eta : Euclidean 2 | (1 / 4 : Real) ≤ ‖eta‖}
  have hKclosed : IsClosed K := by
    dsimp [K]
    apply IsClosed.inter Metric.isClosed_closedBall
    exact isClosed_le continuous_const continuous_norm
  refine ⟨B, hB, ?_⟩
  intro t eta
  have htsupp : tsupport (circleRelativeBandFatUnitFamily C t : Euclidean 2 → Complex) ⊆ K := by
    change closure (Function.support (circleRelativeBandFatUnitFamily C t : Euclidean 2 → Complex)) ⊆ K
    exact closure_minimal (circleRelativeBandFatUnitFamily_support_subset_annulus C t) hKclosed
  by_cases hetaK : eta ∈ K
  · have hfamilyEq : (circleRelativeBandFatUnitFamily C t : Euclidean 2 → Complex) =
        fun y => circleRelativeBandFatUnitJoint C (t.1, y) := by
      funext y
      exact circleRelativeBandFatUnitFamily_apply_eq_joint C t y
    rw [hfamilyEq]
    exact hjoint t.1 eta t.2 hetaK.1
  · have hnot : eta ∉ Function.support (iteratedFDeriv Real n
        (circleRelativeBandFatUnitFamily C t : Euclidean 2 → Complex)) := by
      intro hmem
      exact hetaK (htsupp (support_iteratedFDeriv_subset n hmem))
    have hzero : iteratedFDeriv Real n
        (circleRelativeBandFatUnitFamily C t : Euclidean 2 → Complex) eta = 0 := by
      by_contra hne
      exact hnot (Function.mem_support.mpr hne)
    rw [hzero]
    simpa using hB

