    cases σ with
    | minus =>
        exact Auto.Spherical.FractalDilations.Auxiliary.contDiff_planarEndpointQuadraticIntegral.continuous
    | plus =>
        exact Auto.Spherical.FractalDilations.Auxiliary.contDiff_planarEndpointQuadraticIntegral.continuous.comp
          continuous_neg
