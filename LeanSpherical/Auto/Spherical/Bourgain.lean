/-- The simultaneous kernel certificate consumed by a time-dependent
compact-annular multiplier transfer. -/
theorem exists_circleRelativeBandFatUnit_uniformKernelBounds
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ A A' : Real, 0 ≤ A ∧ 0 ≤ A' ∧
      (∀ t : CircleRelativeBandLocalTime,
        _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize
          (circleRelativeBandFatUnitFamily C t) ≤ A) ∧
