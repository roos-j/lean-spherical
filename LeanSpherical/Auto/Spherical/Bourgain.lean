    DirectMiddleRapidLocalIndex → SchwartzMap (Euclidean 2) Complex :=
  fun u => directMiddleRapidSymbol r C u.1 u.2.1

noncomputable def directMiddleRapidTimeDerivativeFamily
    (r : Nat) (C : Auto.LittlewoodPaley.lpCutoffs 2) :
