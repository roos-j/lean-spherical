  have hUfinite' : (∫⁻ x : Euclidean 2, U x ^ (2 : Nat)) ≠ ∞ := by
    simpa only [U] using hUfinite
  have hUbound' : (∫⁻ x : Euclidean 2, U x ^ (2 : Nat)) ≤
      A * ∫⁻ x : Euclidean 2, ENNReal.ofReal
        (‖aux_unitFatInputProjection C j (aux_blockFrequencyData k f) x‖ ^
          (2 : Nat)) := by
    simpa only [U] using hUbound
  have hpoint (x : Euclidean 2) :
      restrictedRelativeBandpassSphericalMaximal 2
        (Icc ((2 : Real) ^ k) (2 * (2 : Real) ^ k)) C.cutoff j f x ≤
        ENNReal.ofReal q * U (a⁻¹ • x) := by
    simpa only [a, q, U] using
      aux_restrictedRelativeBandpass_block_le_unitFat_dilate C j k f x
  have hpow (x : Euclidean 2) :
      (restrictedRelativeBandpassSphericalMaximal 2
        (Icc ((2 : Real) ^ k) (2 * (2 : Real) ^ k)) C.cutoff j f x) ^
          (2 : Nat) ≤
        ENNReal.ofReal (q ^ (2 : Nat)) * (U (a⁻¹ • x)) ^ (2 : Nat) := by
    calc
      (restrictedRelativeBandpassSphericalMaximal 2
        (Icc ((2 : Real) ^ k) (2 * (2 : Real) ^ k)) C.cutoff j f x) ^
          (2 : Nat) ≤ (ENNReal.ofReal q * U (a⁻¹ • x)) ^ (2 : Nat) :=
        pow_le_pow_left' (hpoint x) _
      _ = ENNReal.ofReal (q ^ (2 : Nat)) * (U (a⁻¹ • x)) ^ (2 : Nat) := by
        rw [mul_pow, ← ENNReal.ofReal_pow hq]
  have hscale :
      (∫⁻ x : Euclidean 2, ENNReal.ofReal (q ^ (2 : Nat)) *
        (U (a⁻¹ • x)) ^ (2 : Nat)) =
        ENNReal.ofReal q * ∫⁻ x : Euclidean 2, U x ^ (2 : Nat) := by
    exact aux_l2_lintegral_scaled_comp_smul_two
      (fun y : Euclidean 2 => U y ^ (2 : Nat)) (hUmeas'.pow_const 2) hUfinite'
      (inv_pos.mpr ha) rfl
