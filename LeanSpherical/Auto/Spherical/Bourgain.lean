/-- The fixed fat multiplier is a finite telescoping sum of five integer
Littlewood--Paley bands. -/
theorem circleRelativeBand_fatDyadicBandpassMultiplier_eq_sum_intDyadic
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (xi : Euclidean 2) :
    _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j xi =
      ∑ i ∈ Finset.range 5,
        _root_.Auto.LittlewoodPaley.intDyadicBandpassMultiplier C.cutoff
          ((j : Int) - 2 + i) xi := by
  rw [_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier,
    _root_.Auto.LittlewoodPaley.shiftedFatMultiplier]
  have h := _root_.Auto.LittlewoodPaley.finiteIntegerDyadicResolution
    C ((j : Int) - 2) 5 xi
  rw [show ((j : Int) + 3) = ((j : Int) - 2) + 5 by omega]
  simpa using h.symm

private theorem circleRelativeBand_intDyadicBandpassMultiplier_ofNat_eq_dyadic
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (n : Nat) (xi : Euclidean 2) :
    _root_.Auto.LittlewoodPaley.intDyadicBandpassMultiplier C.cutoff
        (n : Int) xi =
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff n xi := by
  rw [_root_.Auto.LittlewoodPaley.intDyadicBandpassMultiplier_apply,
    _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier_apply]
  rw [show (n : Int) + 1 = ((n + 1 : Nat) : Int) by omega]
  simp only [zpow_natCast]

/-- Above the two low-frequency exceptional scales, the fat multiplier is
literally the sum of its five neighboring ordinary dyadic bands. -/
theorem circleRelativeBand_fatDyadicBandpassMultiplier_eq_sum_dyadic
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (hj : 2 ≤ j) (xi : Euclidean 2) :
    _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j xi =
      ∑ i ∈ Finset.range 5,
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff
          (j - 2 + i) xi := by
  rw [circleRelativeBand_fatDyadicBandpassMultiplier_eq_sum_intDyadic]
  apply Finset.sum_congr rfl
  intro i hi
  rw [show (j : Int) - 2 + i = ((j - 2 + i : Nat) : Int) by omega]
  rw [circleRelativeBand_intDyadicBandpassMultiplier_ofNat_eq_dyadic]

/-- The unrestricted-time scalar profile underlying the moving fat relative
band.  It is kept private because only the literal output and its derivative
are part of the public interface. -/
private noncomputable def aux_circleRelativeBandUnitDifferenceRaw
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (t : Real) (eta : Euclidean 2) : Complex :=
  C.cutoff (((2 : Real) ^ (0 + 1))⁻¹ • (t • eta)) -
    C.cutoff (((2 : Real) ^ 0)⁻¹ • (t • eta))

/-- The literal time derivative of the unrestricted moving relative profile. -/
private noncomputable def aux_circleRelativeBandUnitDifferenceRawTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (t : Real) (eta : Euclidean 2) : Complex :=
  fderiv Real (C.cutoff : Euclidean 2 → Complex)
      (((2 : Real) ^ (0 + 1))⁻¹ • (t • eta))
      (((2 : Real) ^ (0 + 1))⁻¹ • eta) -
    fderiv Real (C.cutoff : Euclidean 2 → Complex)
      (((2 : Real) ^ 0)⁻¹ • (t • eta))
      (((2 : Real) ^ 0)⁻¹ • eta)

/-- The literal moving fat relative-band multiplier applied to the ordinary
dyadic half-wave at scale `k`; `j` is the relative-band scale. -/
noncomputable def circleRelativeBandFatHalfWaveOutput
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j k : Nat) (σ : _root_.Auto.Spherical.MSSBase.WaveSign)
    (t : Real) (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun xi : Euclidean 2 =>
    aux_circleRelativeBandUnitDifferenceRaw C t (((2 : Real) ^ j)⁻¹ • xi) *
      _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
        (((2 : Real) ^ j)⁻¹ • xi) *
      _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol C.cutoff σ k t xi *
      𝓕 (f : Euclidean 2 → Complex) xi) x

/-- The literal time derivative of
`circleRelativeBandFatHalfWaveOutput`.  Its two summands are respectively the
moving relative multiplier derivative and the ordinary half-wave derivative. -/
noncomputable def circleRelativeBandFatHalfWaveOutputTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j k : Nat) (σ : _root_.Auto.Spherical.MSSBase.WaveSign)
    (t : Real) (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun xi : Euclidean 2 =>
    (aux_circleRelativeBandUnitDifferenceRawTimeDerivative C t
        (((2 : Real) ^ j)⁻¹ • xi) *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
          (((2 : Real) ^ j)⁻¹ • xi) *
        _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol C.cutoff σ k t xi +
      aux_circleRelativeBandUnitDifferenceRaw C t (((2 : Real) ^ j)⁻¹ • xi) *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
          (((2 : Real) ^ j)⁻¹ • xi) *
        (_root_.Auto.Spherical.MSSBase.halfWaveMultiplierTimeDerivative σ t xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k xi)) *
      𝓕 (f : Euclidean 2 → Complex) xi) x

private theorem aux_continuous_uncurry_circleRelativeBandUnitDifferenceRaw
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    Continuous (Function.uncurry (aux_circleRelativeBandUnitDifferenceRaw C)) := by
  change Continuous (fun q : Real × Euclidean 2 =>
    C.cutoff (((2 : Real) ^ (0 + 1))⁻¹ • (q.1 • q.2)) -
      C.cutoff (((2 : Real) ^ 0)⁻¹ • (q.1 • q.2)))
  exact ((C.cutoff.smooth 0).continuous.comp (by fun_prop)).sub
    ((C.cutoff.smooth 0).continuous.comp (by fun_prop))

private theorem aux_continuous_uncurry_circleRelativeBandUnitDifferenceRawTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    Continuous (Function.uncurry
      (aux_circleRelativeBandUnitDifferenceRawTimeDerivative C)) := by
  have hderiv : Continuous (fderiv Real (C.cutoff : Euclidean 2 → Complex)) :=
    (C.cutoff.smooth 1).continuous_fderiv (by norm_num)
  change Continuous (fun q : Real × Euclidean 2 =>
    fderiv Real (C.cutoff : Euclidean 2 → Complex)
        (((2 : Real) ^ (0 + 1))⁻¹ • (q.1 • q.2))
        (((2 : Real) ^ (0 + 1))⁻¹ • q.2) -
      fderiv Real (C.cutoff : Euclidean 2 → Complex)
        (((2 : Real) ^ 0)⁻¹ • (q.1 • q.2))
        (((2 : Real) ^ 0)⁻¹ • q.2))
  apply Continuous.sub
  · exact (hderiv.comp (by fun_prop)).clm_apply (by fun_prop)
  · exact (hderiv.comp (by fun_prop)).clm_apply (by fun_prop)

private theorem aux_continuous_uncurry_dyadicHalfWaveSymbol
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (k : Nat) :
    Continuous (Function.uncurry
      (fun t xi => _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol C.cutoff σ k t xi)) := by
  change Continuous (fun q : Real × Euclidean 2 =>
    _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ q.1 q.2 *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k q.2)
  have hhalf : Continuous (fun q : Real × Euclidean 2 =>
      _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ q.1 q.2) := by
    unfold _root_.Auto.Spherical.MSSBase.halfWaveMultiplier
    apply Complex.continuous_exp.comp
    exact (Complex.continuous_ofReal.comp (by fun_prop)).mul continuous_const
  exact hhalf.mul
    ((_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k).continuous.comp
      continuous_snd)

private theorem aux_continuous_uncurry_dyadicHalfWaveSymbolTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (k : Nat) :
    Continuous (Function.uncurry (fun t xi =>
      _root_.Auto.Spherical.MSSBase.halfWaveMultiplierTimeDerivative σ t xi *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k xi)) := by
  change Continuous (fun q : Real × Euclidean 2 =>
    _root_.Auto.Spherical.MSSBase.halfWaveMultiplierTimeDerivative σ q.1 q.2 *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k q.2)
  have hhalf : Continuous (fun q : Real × Euclidean 2 =>
      _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ q.1 q.2) := by
    unfold _root_.Auto.Spherical.MSSBase.halfWaveMultiplier
    apply Complex.continuous_exp.comp
    exact (Complex.continuous_ofReal.comp (by fun_prop)).mul continuous_const
  have hcoef : Continuous (fun q : Real × Euclidean 2 =>
      (((σ.toReal * (2 * Real.pi) * ‖q.2‖ : Real) : Complex) * Complex.I)) := by
    exact (Complex.continuous_ofReal.comp (by fun_prop)).mul continuous_const
  exact (hcoef.mul hhalf).mul
    ((_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k).continuous.comp
      continuous_snd)

private theorem aux_continuous_and_hasDerivAt_circleRelativeBandFatHalfWaveOutput
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j k : Nat) (σ : _root_.Auto.Spherical.MSSBase.WaveSign)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Continuous (Function.uncurry
      (fun t x => circleRelativeBandFatHalfWaveOutput C j k σ t f x)) ∧
      Continuous (Function.uncurry
        (fun t x => circleRelativeBandFatHalfWaveOutputTimeDerivative C j k σ t f x)) ∧
      ∀ t x, HasDerivAt
        (fun s => circleRelativeBandFatHalfWaveOutput C j k σ s f x)
        (circleRelativeBandFatHalfWaveOutputTimeDerivative C j k σ t f x) t := by
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleRelativeBandFatHalfWaveOutput C j k σ t f x
  let D : Real → Euclidean 2 → Complex := fun t x =>
    circleRelativeBandFatHalfWaveOutputTimeDerivative C j k σ t f x
  change Continuous (Function.uncurry F) ∧ Continuous (Function.uncurry D) ∧
    ∀ t x, HasDerivAt (fun s => F s x) (D t x) t
  let K : Set (Euclidean 2) := Metric.closedBall 0 ((2 : Real) ^ (k + 2))
  have hK : IsCompact K := isCompact_closedBall _ _
  have hKmeas : MeasurableSet K := hK.measurableSet
  let G : (Real × Euclidean 2) → Euclidean 2 → Complex := fun q xi =>
    (Real.fourierChar (inner Real xi q.2) : Complex) *
      (aux_circleRelativeBandUnitDifferenceRaw C q.1
          (((2 : Real) ^ j)⁻¹ • xi) *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
          (((2 : Real) ^ j)⁻¹ • xi) *
        _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol C.cutoff σ k q.1 xi *
        𝓕 (f : Euclidean 2 → Complex) xi)
  let G' : (Real × Euclidean 2) → Euclidean 2 → Complex := fun q xi =>
    (Real.fourierChar (inner Real xi q.2) : Complex) *
      ((aux_circleRelativeBandUnitDifferenceRawTimeDerivative C q.1
          (((2 : Real) ^ j)⁻¹ • xi) *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
          (((2 : Real) ^ j)⁻¹ • xi) *
        _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol C.cutoff σ k q.1 xi +
        aux_circleRelativeBandUnitDifferenceRaw C q.1
          (((2 : Real) ^ j)⁻¹ • xi) *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
          (((2 : Real) ^ j)⁻¹ • xi) *
        (_root_.Auto.Spherical.MSSBase.halfWaveMultiplierTimeDerivative σ q.1 xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k xi)) *
        𝓕 (f : Euclidean 2 → Complex) xi)
  have hGcont : Continuous (Function.uncurry G) := by
    change Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
      (Real.fourierChar (inner Real q.2 q.1.2) : Complex) *
        (aux_circleRelativeBandUnitDifferenceRaw C q.1.1
            (((2 : Real) ^ j)⁻¹ • q.2) *
          _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
            (((2 : Real) ^ j)⁻¹ • q.2) *
          _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol C.cutoff σ k q.1.1 q.2 *
          𝓕 (f : Euclidean 2 → Complex) q.2))
    have hchar : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (Real.fourierChar (inner Real q.2 q.1.2) : Complex)) := by fun_prop
    have hraw := aux_continuous_uncurry_circleRelativeBandUnitDifferenceRaw C
    have htime : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 => q.1.1) :=
      continuous_fst.comp continuous_fst
    have hscaled : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        ((2 : Real) ^ j)⁻¹ • q.2) :=
      (continuous_const : Continuous fun _ : (Real × Euclidean 2) × Euclidean 2 =>
        ((2 : Real) ^ j)⁻¹).smul continuous_snd
    have hrawpair : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (q.1.1, ((2 : Real) ^ j)⁻¹ • q.2)) := htime.prodMk hscaled
    have hhalfpair : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (q.1.1, q.2)) := htime.prodMk continuous_snd
    have hraw' : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        aux_circleRelativeBandUnitDifferenceRaw C q.1.1 (((2 : Real) ^ j)⁻¹ • q.2)) :=
      hraw.comp hrawpair
    have hfat : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
          (((2 : Real) ^ j)⁻¹ • q.2)) :=
      (_root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff).continuous.comp
        hscaled
    have hhalf := aux_continuous_uncurry_dyadicHalfWaveSymbol C σ k
    have hhalf' : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
      _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol C.cutoff σ k q.1.1 q.2) :=
      hhalf.comp hhalfpair
    have hfourier : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        𝓕 (f : Euclidean 2 → Complex) q.2) :=
      (𝓕 f).continuous.comp continuous_snd
    exact hchar.mul (((hraw'.mul hfat).mul hhalf').mul hfourier)
  have hG'cont : Continuous (Function.uncurry G') := by
    change Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
      (Real.fourierChar (inner Real q.2 q.1.2) : Complex) *
        ((aux_circleRelativeBandUnitDifferenceRawTimeDerivative C q.1.1
            (((2 : Real) ^ j)⁻¹ • q.2) *
          _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
            (((2 : Real) ^ j)⁻¹ • q.2) *
          _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol C.cutoff σ k q.1.1 q.2 +
          aux_circleRelativeBandUnitDifferenceRaw C q.1.1 (((2 : Real) ^ j)⁻¹ • q.2) *
          _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
            (((2 : Real) ^ j)⁻¹ • q.2) *
          (_root_.Auto.Spherical.MSSBase.halfWaveMultiplierTimeDerivative σ q.1.1 q.2 *
            _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k q.2)) *
          𝓕 (f : Euclidean 2 → Complex) q.2))
    have hchar : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (Real.fourierChar (inner Real q.2 q.1.2) : Complex)) := by fun_prop
    have hraw := aux_continuous_uncurry_circleRelativeBandUnitDifferenceRaw C
    have hrawdot := aux_continuous_uncurry_circleRelativeBandUnitDifferenceRawTimeDerivative C
    have htime : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 => q.1.1) :=
      continuous_fst.comp continuous_fst
    have hscaled : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        ((2 : Real) ^ j)⁻¹ • q.2) :=
      (continuous_const : Continuous fun _ : (Real × Euclidean 2) × Euclidean 2 =>
        ((2 : Real) ^ j)⁻¹).smul continuous_snd
    have hrawpair : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (q.1.1, ((2 : Real) ^ j)⁻¹ • q.2)) := htime.prodMk hscaled
    have hhalfpair : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (q.1.1, q.2)) := htime.prodMk continuous_snd
    have hraw' : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        aux_circleRelativeBandUnitDifferenceRaw C q.1.1 (((2 : Real) ^ j)⁻¹ • q.2)) :=
      hraw.comp hrawpair
    have hrawdot' : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        aux_circleRelativeBandUnitDifferenceRawTimeDerivative C q.1.1
          (((2 : Real) ^ j)⁻¹ • q.2)) :=
      hrawdot.comp hrawpair
    have hfat : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
          (((2 : Real) ^ j)⁻¹ • q.2)) :=
      (_root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff).continuous.comp
        hscaled
    have hhalf := aux_continuous_uncurry_dyadicHalfWaveSymbol C σ k
    have hhalf' : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol C.cutoff σ k q.1.1 q.2) :=
      hhalf.comp hhalfpair
    have hhalfDot' : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        _root_.Auto.Spherical.MSSBase.halfWaveMultiplierTimeDerivative σ q.1.1 q.2 *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k q.2) :=
      by
        change Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
          ((((σ.toReal * (2 * Real.pi) * ‖q.2‖ : Real) : Complex) * Complex.I) *
            _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ q.1.1 q.2) *
            _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k q.2)
        have hbase : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
            _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ q.1.1 q.2) := by
          unfold _root_.Auto.Spherical.MSSBase.halfWaveMultiplier
          apply Complex.continuous_exp.comp
          exact (Complex.continuous_ofReal.comp (by fun_prop)).mul continuous_const
        have hcoef : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
            (((σ.toReal * (2 * Real.pi) * ‖q.2‖ : Real) : Complex) * Complex.I)) := by
          exact (Complex.continuous_ofReal.comp (by fun_prop)).mul continuous_const
        exact (hcoef.mul hbase).mul
          ((_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k).continuous.comp
            continuous_snd)
    have hfourier : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        𝓕 (f : Euclidean 2 → Complex) q.2) :=
      (𝓕 f).continuous.comp continuous_snd
    exact hchar.mul (((hrawdot'.mul hfat).mul hhalf').add
      ((hraw'.mul hfat).mul hhalfDot') |>.mul hfourier)
  have hGsupport (q : Real × Euclidean 2) : Function.support (G q) ⊆ K := by
    intro xi hxi
    by_contra hxiK
    have hnorm : (2 : Real) ^ (k + 2) ≤ ‖xi‖ := by
      rw [Metric.mem_closedBall, dist_zero_right] at hxiK
      exact le_of_not_ge hxiK
    have hband :
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k xi = 0 :=
      _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_le_norm C hnorm
    change G q xi ≠ 0 at hxi
    exact hxi (by simp [G, _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol, hband])
  have hG'support (q : Real × Euclidean 2) : Function.support (G' q) ⊆ K := by
    intro xi hxi
    by_contra hxiK
    have hnorm : (2 : Real) ^ (k + 2) ≤ ‖xi‖ := by
      rw [Metric.mem_closedBall, dist_zero_right] at hxiK
      exact le_of_not_ge hxiK
    have hband :
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k xi = 0 :=
      _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_le_norm C hnorm
    change G' q xi ≠ 0 at hxi
    exact hxi (by simp [G', _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol, hband])
  have hGintegral (q : Real × Euclidean 2) :
      (∫ xi : Euclidean 2, G q xi) = ∫ xi in K, G q xi := by
    rw [← MeasureTheory.integral_indicator hKmeas]
    rw [Set.indicator_eq_self.mpr (hGsupport q)]
  have hG'integral (q : Real × Euclidean 2) :
      (∫ xi : Euclidean 2, G' q xi) = ∫ xi in K, G' q xi := by
    rw [← MeasureTheory.integral_indicator hKmeas]
    rw [Set.indicator_eq_self.mpr (hG'support q)]
  have hF_eq (q : Real × Euclidean 2) : F q.1 q.2 = ∫ xi in K, G q xi := by
    have hraw : F q.1 q.2 = ∫ xi : Euclidean 2, G q xi := by
      dsimp [F, G, circleRelativeBandFatHalfWaveOutput]
      rw [Real.fourierInv_eq]
      rfl
    rw [hraw]
    exact hGintegral q
  have hD_eq (q : Real × Euclidean 2) : D q.1 q.2 = ∫ xi in K, G' q xi := by
    have hraw : D q.1 q.2 = ∫ xi : Euclidean 2, G' q xi := by
      dsimp [D, G', circleRelativeBandFatHalfWaveOutputTimeDerivative]
      rw [Real.fourierInv_eq]
      rfl
    rw [hraw]
    exact hG'integral q
  have hFcont : Continuous (Function.uncurry F) := by
    have hcont := continuous_parametric_integral_of_continuous (μ := volume) hGcont hK
    rw [show Function.uncurry F = fun q : Real × Euclidean 2 =>
      ∫ xi in K, G q xi by
        funext q
        exact hF_eq q]
    exact hcont
  have hDcont : Continuous (Function.uncurry D) := by
    have hcont := continuous_parametric_integral_of_continuous (μ := volume) hG'cont hK
    rw [show Function.uncurry D = fun q : Real × Euclidean 2 =>
      ∫ xi in K, G' q xi by
        funext q
        exact hD_eq q]
    exact hcont
  refine ⟨hFcont, hDcont, ?_⟩
  intro s x
  have hGderiv (t : Real) (xi : Euclidean 2) :
      HasDerivAt (fun u : Real => G (u, x) xi) (G' (t, x) xi) t := by
    let eta : Euclidean 2 := ((2 : Real) ^ j)⁻¹ • xi
    have hq :=
      _root_.Auto.Spherical.Auxiliary.hasDerivAt_smooth_dyadic_bandpass_radial
        C.cutoff 0 t eta
    have hqfat := hq.mul_const
      (_root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff eta)
    have hhalf := _root_.Auto.Spherical.MSSBase.hasDerivAt_halfWaveMultiplier_time σ t xi
    have hsymbol := hhalf.mul_const
      (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k xi)
    have hproduct := hqfat.mul hsymbol
    have hfull := hproduct.mul_const (𝓕 (f : Euclidean 2 → Complex) xi)
    have hchar := hfull.const_mul (Real.fourierChar (inner Real xi x) : Complex)
    simpa [G, G', eta, aux_circleRelativeBandUnitDifferenceRaw,
      aux_circleRelativeBandUnitDifferenceRawTimeDerivative,
      _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol] using hchar
  have hFcurve : (fun t : Real => F t x) =
      fun t : Real => ∫ xi in K, G (t, x) xi := by
    funext t
    simpa only using hF_eq (t, x)
  have hDcurve : D s x = ∫ xi in K, G' (s, x) xi := by
    simpa only using hD_eq (s, x)
  have hGslice (t : Real) : Continuous (fun xi : Euclidean 2 => G (t, x) xi) := by
    change Continuous ((Function.uncurry G) ∘ fun xi : Euclidean 2 => ((t, x), xi))
    exact hGcont.comp
      ((continuous_const : Continuous fun _ : Euclidean 2 => (t, x)).prodMk continuous_id)
  have hG'slice (t : Real) : Continuous (fun xi : Euclidean 2 => G' (t, x) xi) := by
    change Continuous ((Function.uncurry G') ∘ fun xi : Euclidean 2 => ((t, x), xi))
    exact hG'cont.comp
      ((continuous_const : Continuous fun _ : Euclidean 2 => (t, x)).prodMk continuous_id)
  have hG'curve : Continuous (fun q : Real × Euclidean 2 => G' (q.1, x) q.2) := by
    change Continuous ((Function.uncurry G') ∘ fun q : Real × Euclidean 2 => ((q.1, x), q.2))
    exact hG'cont.comp (by fun_prop)
  have hFmeas : ∀ᶠ t in nhds s,
      AEStronglyMeasurable (fun xi : Euclidean 2 => G (t, x) xi) (volume.restrict K) := by
    filter_upwards [] with t
    exact (hGslice t).aestronglyMeasurable.restrict
  have hFint : Integrable (fun xi : Euclidean 2 => G (s, x) xi) (volume.restrict K) := by
    have hcompact : HasCompactSupport (fun xi : Euclidean 2 => G (s, x) xi) := by
      apply HasCompactSupport.of_support_subset_isCompact hK
      exact hGsupport (s, x)
    exact ((hGslice s).integrable_of_hasCompactSupport hcompact).restrict
  have hF'meas : AEStronglyMeasurable (fun xi : Euclidean 2 => G' (s, x) xi)
      (volume.restrict K) :=
    (hG'slice s).aestronglyMeasurable.restrict
  obtain ⟨A, hA⟩ := (isCompact_Icc.prod hK).exists_bound_of_continuousOn
    hG'curve.continuousOn
  have hbound : ∀ᵐ xi : Euclidean 2 ∂(volume.restrict K),
      ∀ t ∈ Icc (s - 1) (s + 1), ‖G' (t, x) xi‖ ≤ A := by
    filter_upwards [ae_restrict_mem hKmeas] with xi hxi
    intro t ht
    exact hA (t, xi) ⟨ht, hxi⟩
  have hAint : Integrable (fun _ : Euclidean 2 => A) (volume.restrict K) := by
    simpa only [IntegrableOn] using
      (integrableOn_const (μ := volume) (s := K) hK.measure_ne_top :
        IntegrableOn (fun _ : Euclidean 2 => A) K volume)
  have hdiff : ∀ᵐ xi : Euclidean 2 ∂(volume.restrict K),
      ∀ t ∈ Icc (s - 1) (s + 1),
        HasDerivAt (fun u : Real => G (u, x) xi) (G' (t, x) xi) t :=
    Filter.Eventually.of_forall fun xi t _ => hGderiv t xi
  have hs : Icc (s - 1) (s + 1) ∈ nhds s :=
    Icc_mem_nhds (sub_lt_self s zero_lt_one) (lt_add_of_pos_right s zero_lt_one)
  have hparam := hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := volume.restrict K) (s := Icc (s - 1) (s + 1)) (x₀ := s)
    (bound := fun _ : Euclidean 2 => A)
    (F := fun t (xi : Euclidean 2) => G (t, x) xi)
    (F' := fun t (xi : Euclidean 2) => G' (t, x) xi)
    hs hFmeas hFint hF'meas hbound hAint hdiff
  rw [hFcurve, hDcurve]
  exact hparam.2


private theorem aux_circleRelativeBandFatHalfWaveOutput_eq_relativeMultiplierAt
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j k : Nat) (σ : _root_.Auto.Spherical.MSSBase.WaveSign)
    (t : CircleRelativeBandLocalTime)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    circleRelativeBandFatHalfWaveOutput C j k σ t.1 f x =
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
        (circleRelativeBandFatUnitFamily C t)
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j)
        (circleAnnularEndpointHalfWaveOutput C σ k t.1 f) x := by
  unfold circleRelativeBandFatHalfWaveOutput
  unfold _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext xi
  change aux_circleRelativeBandUnitDifferenceRaw C t.1 (((2 : Real) ^ j)⁻¹ • xi) *
      _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
        (((2 : Real) ^ j)⁻¹ • xi) *
      _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol C.cutoff σ k t.1 xi *
      𝓕 (f : Euclidean 2 → Complex) xi =
    circleRelativeBandFatUnitFamily C t (((2 : Real) ^ j)⁻¹ • xi) *
      𝓕 (circleAnnularEndpointHalfWaveOutput C σ k t.1 f : Euclidean 2 → Complex) xi
  rw [circleRelativeBandFatUnitFamily_apply,
    circleAnnularEndpointHalfWaveOutput_fourier]
  simp only [aux_circleRelativeBandUnitDifferenceRaw]
  norm_num
  simp only [smul_smul]
  ring_nf


private theorem aux_circleRelativeBandFatUnitFamily_apply_raw
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (t : CircleRelativeBandLocalTime) (eta : Euclidean 2) :
    circleRelativeBandFatUnitFamily C t eta =
      aux_circleRelativeBandUnitDifferenceRaw C t.1 eta *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff eta := by
  rw [circleRelativeBandFatUnitFamily_apply]
  have hhalf : (t.1 / 2 : Real) • eta =
      ((2 : Real) ^ (0 + 1))⁻¹ • (t.1 • eta) := by
    norm_num
    simp only [smul_smul]
    congr 1
    ring
  have hone : t.1 • eta = ((2 : Real) ^ 0)⁻¹ • (t.1 • eta) := by norm_num
  have hdiff : C.cutoff ((t.1 / 2) • eta) - C.cutoff (t.1 • eta) =
      aux_circleRelativeBandUnitDifferenceRaw C t.1 eta := by
    unfold aux_circleRelativeBandUnitDifferenceRaw
    congr 1
    · exact congrArg C.cutoff hhalf
    · exact congrArg C.cutoff hone
  rw [hdiff]

private theorem aux_circleRelativeBandFatUnitTimeDerivative_apply_raw
