          (∑ k ∈ Finset.range n, ∫ t in u k..u (k + 1), ‖F t‖ ^ 2) +
        2 * δ *
          (∑ k ∈ Finset.range n, ∫ t in u k..u (k + 1), ‖F' t‖ ^ 2) := by
      rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
    _ = 2 * δ⁻¹ * (∫ t in (1 : ℝ)..2, ‖F t‖ ^ 2) +
        2 * δ * (∫ t in (1 : ℝ)..2, ‖F' t‖ ^ 2) := by
      rw [hsumF, hsumF', hu0, hun]

/-- Summing nonnegative interval integrals over a finite pairwise-disjoint
family of time cells never costs more than the integral over the ambient
unit time block.  The half-open cells make the disjointness hypothesis exact
even when consecutive cells share an endpoint. -/
theorem aux_sum_intervalIntegral_le_intervalIntegral_of_pairwiseDisjoint
    {ι : Type*} (s : Finset ι) (a b : ι → Real) {G : Real → Real}
    (hG : Continuous G) (hG_nonneg : ∀ t, 0 ≤ G t)
    (hab : ∀ i ∈ s, a i ≤ b i)
    (hcontained : ∀ i ∈ s, Ioc (a i) (b i) ⊆ Ioc (1 : Real) 2)
    (hdisjoint : Set.Pairwise (↑s)
      (Function.onFun Disjoint (fun i => Ioc (a i) (b i)))) :
    (∑ i ∈ s, ∫ t in a i..b i, G t) ≤ ∫ t in (1 : Real)..2, G t := by
  have hmeas : ∀ i ∈ s, MeasurableSet (Ioc (a i) (b i)) := by
    intro i hi
    exact measurableSet_Ioc
  have hint : ∀ i ∈ s, IntegrableOn G (Ioc (a i) (b i)) volume := by
    intro i hi
    exact hG.integrableOn_Ioc
  have hfull : IntegrableOn G (Ioc (1 : Real) 2) volume :=
    hG.integrableOn_Ioc
  have hnonneg : 0 ≤ᵐ[volume.restrict (Ioc (1 : Real) 2)] G :=
    Filter.Eventually.of_forall fun t => hG_nonneg t
  have hunion : (⋃ i ∈ s, Ioc (a i) (b i)) ⊆ Ioc (1 : Real) 2 := by
    intro t ht
    rcases Set.mem_iUnion.mp ht with ⟨i, ht⟩
    rcases Set.mem_iUnion.mp ht with ⟨hi, ht⟩
    exact hcontained i hi ht
  calc
    (∑ i ∈ s, ∫ t in a i..b i, G t) =
        ∑ i ∈ s, ∫ t in Ioc (a i) (b i), G t := by
      apply Finset.sum_congr rfl
      intro i hi
      rw [intervalIntegral.integral_of_le (hab i hi)]
    _ = ∫ t in ⋃ i ∈ s, Ioc (a i) (b i), G t := by
      symm
      exact integral_biUnion_finset s hmeas hdisjoint hint
    _ ≤ ∫ t in Ioc (1 : Real) 2, G t :=
      setIntegral_mono_set hfull hnonneg hunion.eventuallyLE
    _ = ∫ t in (1 : Real)..2, G t := by
      rw [intervalIntegral.integral_of_le (by norm_num)]

/-- Discrete `L²` time sampling for any finite family of disjoint time
cells.  This is the exact analytic summation step used for a separated set
once its points have been assigned bounded-overlap cells; disjoint cells are
the overlap-one special case. -/
theorem timeSamplingL2_of_pairwiseDisjointIntervals
    {ι : Type*} {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    [CompleteSpace E] {F F' : Real → E}
    (s : Finset ι) (a b sample : ι → Real) {δ : Real} (hδ : 0 < δ)
    (hab : ∀ i ∈ s, a i ≤ b i) (hlength : ∀ i ∈ s, b i - a i = δ)
    (hsample : ∀ i ∈ s, sample i ∈ Icc (a i) (b i))
    (hcontained : ∀ i ∈ s, Ioc (a i) (b i) ⊆ Ioc (1 : Real) 2)
    (hdisjoint : Set.Pairwise (↑s)
      (Function.onFun Disjoint (fun i => Ioc (a i) (b i))))
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ t, HasDerivAt F (F' t) t) :
    (∑ i ∈ s, ‖F (sample i)‖ ^ 2) ≤
      2 * δ⁻¹ * (∫ t in (1 : Real)..2, ‖F t‖ ^ 2) +
        2 * δ * (∫ t in (1 : Real)..2, ‖F' t‖ ^ 2) := by
  have hlocal : ∀ i ∈ s,
      ‖F (sample i)‖ ^ 2 ≤
        2 * δ⁻¹ * (∫ t in a i..b i, ‖F t‖ ^ 2) +
          2 * δ * (∫ t in a i..b i, ‖F' t‖ ^ 2) := by
    intro i hi
    have hpos : a i < b i := by
      rw [← sub_pos]
      simpa [hlength i hi] using hδ
    simpa only [hlength i hi] using
      timeSobolevL2 hpos (hsample i hi) hF hF' hderiv
  have hsum := Finset.sum_le_sum fun i hi => hlocal i hi
  have hsumF : (∑ i ∈ s, ∫ t in a i..b i, ‖F t‖ ^ 2) ≤
      ∫ t in (1 : Real)..2, ‖F t‖ ^ 2 := by
    simpa only [Pi.pow_apply, Function.comp_apply] using
      (aux_sum_intervalIntegral_le_intervalIntegral_of_pairwiseDisjoint
        s a b ((continuous_norm.comp hF).pow 2) (fun t => sq_nonneg _)
        hab hcontained hdisjoint)
  have hsumF' : (∑ i ∈ s, ∫ t in a i..b i, ‖F' t‖ ^ 2) ≤
      ∫ t in (1 : Real)..2, ‖F' t‖ ^ 2 := by
    simpa only [Pi.pow_apply, Function.comp_apply] using
      (aux_sum_intervalIntegral_le_intervalIntegral_of_pairwiseDisjoint
        s a b ((continuous_norm.comp hF').pow 2) (fun t => sq_nonneg _)
        hab hcontained hdisjoint)
  have hFnonneg : 0 ≤ ∫ t in (1 : Real)..2, ‖F t‖ ^ 2 :=
    intervalIntegral.integral_nonneg (by norm_num) fun _ _ => sq_nonneg _
  have hF'nonneg : 0 ≤ ∫ t in (1 : Real)..2, ‖F' t‖ ^ 2 :=
    intervalIntegral.integral_nonneg (by norm_num) fun _ _ => sq_nonneg _
  calc
    (∑ i ∈ s, ‖F (sample i)‖ ^ 2) ≤
        ∑ i ∈ s,
          (2 * δ⁻¹ * (∫ t in a i..b i, ‖F t‖ ^ 2) +
            2 * δ * (∫ t in a i..b i, ‖F' t‖ ^ 2)) := hsum
    _ = 2 * δ⁻¹ * (∑ i ∈ s, ∫ t in a i..b i, ‖F t‖ ^ 2) +
        2 * δ * (∑ i ∈ s, ∫ t in a i..b i, ‖F' t‖ ^ 2) := by
      rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
    _ ≤ 2 * δ⁻¹ * (∫ t in (1 : Real)..2, ‖F t‖ ^ 2) +
        2 * δ * (∫ t in (1 : Real)..2, ‖F' t‖ ^ 2) := by
      gcongr

/-- The same sampling estimate for cells with lengths in `[δ / 2, δ]`.
This is the form stable under clipping the radius-`δ / 2` cells at the two
endpoints of `[1,2]`. -/
theorem timeSamplingL2_of_pairwiseDisjointComparableIntervals
    {ι : Type*} {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    [CompleteSpace E] {F F' : Real → E}
    (s : Finset ι) (a b sample : ι → Real) {δ : Real} (hδ : 0 < δ)
    (hab : ∀ i ∈ s, a i ≤ b i)
    (hlength_lower : ∀ i ∈ s, δ / 2 ≤ b i - a i)
    (hlength_upper : ∀ i ∈ s, b i - a i ≤ δ)
    (hsample : ∀ i ∈ s, sample i ∈ Icc (a i) (b i))
    (hcontained : ∀ i ∈ s, Ioc (a i) (b i) ⊆ Ioc (1 : Real) 2)
    (hdisjoint : Set.Pairwise (↑s)
      (Function.onFun Disjoint (fun i => Ioc (a i) (b i))))
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ t, HasDerivAt F (F' t) t) :
    (∑ i ∈ s, ‖F (sample i)‖ ^ 2) ≤
      4 * δ⁻¹ * (∫ t in (1 : Real)..2, ‖F t‖ ^ 2) +
        2 * δ * (∫ t in (1 : Real)..2, ‖F' t‖ ^ 2) := by
  have hlocal : ∀ i ∈ s,
      ‖F (sample i)‖ ^ 2 ≤
        4 * δ⁻¹ * (∫ t in a i..b i, ‖F t‖ ^ 2) +
          2 * δ * (∫ t in a i..b i, ‖F' t‖ ^ 2) := by
    intro i hi
    have hpos : a i < b i := by
      rw [← sub_pos]
      exact lt_of_lt_of_le (by linarith [hδ]) (hlength_lower i hi)
    have hlength_pos : 0 < b i - a i := sub_pos.mpr hpos
    have hinv : (b i - a i)⁻¹ ≤ (δ / 2)⁻¹ := by
      simpa only [one_div] using
        (one_div_le_one_div_of_le (by linarith [hδ]) (hlength_lower i hi))
    have hcoeff : 2 * (b i - a i)⁻¹ ≤ 4 * δ⁻¹ := by
      calc
        2 * (b i - a i)⁻¹ ≤ 2 * (δ / 2)⁻¹ :=
          mul_le_mul_of_nonneg_left hinv (by norm_num)
        _ = 4 * δ⁻¹ := by
          field_simp [ne_of_gt hδ] ; ring
    have hIFn : 0 ≤ ∫ t in a i..b i, ‖F t‖ ^ 2 :=
      intervalIntegral.integral_nonneg hpos.le fun _ _ => sq_nonneg _
    have hI'n : 0 ≤ ∫ t in a i..b i, ‖F' t‖ ^ 2 :=
      intervalIntegral.integral_nonneg hpos.le fun _ _ => sq_nonneg _
    calc
      ‖F (sample i)‖ ^ 2 ≤
          2 * (b i - a i)⁻¹ * (∫ t in a i..b i, ‖F t‖ ^ 2) +
            2 * (b i - a i) * (∫ t in a i..b i, ‖F' t‖ ^ 2) :=
        timeSobolevL2 hpos (hsample i hi) hF hF' hderiv
      _ ≤ 4 * δ⁻¹ * (∫ t in a i..b i, ‖F t‖ ^ 2) +
            2 * δ * (∫ t in a i..b i, ‖F' t‖ ^ 2) := by
        apply add_le_add
        · exact mul_le_mul_of_nonneg_right hcoeff hIFn
        · apply mul_le_mul_of_nonneg_right _ hI'n
          exact mul_le_mul_of_nonneg_left (hlength_upper i hi) (by norm_num)
  have hsum := Finset.sum_le_sum fun i hi => hlocal i hi
  have hsumF : (∑ i ∈ s, ∫ t in a i..b i, ‖F t‖ ^ 2) ≤
      ∫ t in (1 : Real)..2, ‖F t‖ ^ 2 := by
    simpa only [Pi.pow_apply, Function.comp_apply] using
      (aux_sum_intervalIntegral_le_intervalIntegral_of_pairwiseDisjoint
        s a b ((continuous_norm.comp hF).pow 2) (fun t => sq_nonneg _)
        hab hcontained hdisjoint)
  have hsumF' : (∑ i ∈ s, ∫ t in a i..b i, ‖F' t‖ ^ 2) ≤
      ∫ t in (1 : Real)..2, ‖F' t‖ ^ 2 := by
    simpa only [Pi.pow_apply, Function.comp_apply] using
      (aux_sum_intervalIntegral_le_intervalIntegral_of_pairwiseDisjoint
        s a b ((continuous_norm.comp hF').pow 2) (fun t => sq_nonneg _)
        hab hcontained hdisjoint)
  calc
    (∑ i ∈ s, ‖F (sample i)‖ ^ 2) ≤
        ∑ i ∈ s,
          (4 * δ⁻¹ * (∫ t in a i..b i, ‖F t‖ ^ 2) +
            2 * δ * (∫ t in a i..b i, ‖F' t‖ ^ 2)) := hsum
    _ = 4 * δ⁻¹ * (∑ i ∈ s, ∫ t in a i..b i, ‖F t‖ ^ 2) +
        2 * δ * (∑ i ∈ s, ∫ t in a i..b i, ‖F' t‖ ^ 2) := by
      rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
    _ ≤ 4 * δ⁻¹ * (∫ t in (1 : Real)..2, ‖F t‖ ^ 2) +
        2 * δ * (∫ t in (1 : Real)..2, ‖F' t‖ ^ 2) := by
      gcongr

/-- The `L²` separated-time sampling estimate for the actual finite time
sets in the MSS statement.  Each selected time receives its clipped
radius-`2^{-j-1}` cell.  Separation makes the half-open cells disjoint, and
the endpoint clipping leaves every cell between half and one mesh long. -/
theorem timeSamplingL2_of_MSS_MaximalSeparated
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E] [CompleteSpace E]
    {F F' : Real → E} (j : Nat) (T : Finset Real)
    (hT : _root_.Auto.Spherical.MSSBase.MaximalSeparated j T)
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ t, HasDerivAt F (F' t) t) :
    (∑ t ∈ T, ‖F t‖ ^ 2) ≤
      4 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹ *
          (∫ t in (1 : Real)..2, ‖F t‖ ^ 2) +
        2 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j *
          (∫ t in (1 : Real)..2, ‖F' t‖ ^ 2) := by
  rcases hT with ⟨hTmem, hTsep, hTcover⟩
  let δ : Real := _root_.Auto.Spherical.MSSBase.dyadicTimeScale j
  let a : Real → Real := fun t => max 1 (t - δ / 2)
  let b : Real → Real := fun t => min 2 (t + δ / 2)
  have hδ : 0 < δ := by
    dsimp only [δ, _root_.Auto.Spherical.MSSBase.dyadicTimeScale]
    exact zpow_pos (by norm_num) _
  have hδone : δ ≤ 1 := by
    dsimp only [δ, _root_.Auto.Spherical.MSSBase.dyadicTimeScale]
    apply zpow_le_one_of_nonpos₀
    · norm_num
    · omega
  have hab : ∀ t ∈ T, a t ≤ b t := by
    intro t ht
    have htI : t ∈ Icc (1 : Real) 2 := hTmem t ht
    change max 1 (t - δ / 2) ≤ min 2 (t + δ / 2)
    apply max_le
    · apply le_min
      · norm_num
      · nlinarith [htI.1, hδ]
    · apply le_min
      · nlinarith [htI.2, hδ]
      · nlinarith [htI.1, htI.2, hδone]
  have hlength_lower : ∀ t ∈ T, δ / 2 ≤ b t - a t := by
    intro t ht
    have htI : t ∈ Icc (1 : Real) 2 := hTmem t ht
    change δ / 2 ≤ min 2 (t + δ / 2) - max 1 (t - δ / 2)
    by_cases hleft : 1 ≤ t - δ / 2
    · by_cases hright : t + δ / 2 ≤ 2
      · rw [max_eq_right hleft, min_eq_right hright]
        linarith [htI.1, htI.2]
      · have hright' : 2 ≤ t + δ / 2 := le_of_lt (lt_of_not_ge hright)
        rw [max_eq_right hleft, min_eq_left hright']
        linarith [htI.1, htI.2]
    · have hleft' : t - δ / 2 ≤ 1 := le_of_lt (lt_of_not_ge hleft)
      by_cases hright : t + δ / 2 ≤ 2
      · rw [max_eq_left hleft', min_eq_right hright]
        linarith [htI.1, htI.2]
      · have hright' : 2 ≤ t + δ / 2 := le_of_lt (lt_of_not_ge hright)
        rw [max_eq_left hleft', min_eq_left hright']
        linarith [htI.1, htI.2]
  have hlength_upper : ∀ t ∈ T, b t - a t ≤ δ := by
    intro t ht
    change min 2 (t + δ / 2) - max 1 (t - δ / 2) ≤ δ
    calc
      min 2 (t + δ / 2) - max 1 (t - δ / 2) ≤
          (t + δ / 2) - (t - δ / 2) :=
        sub_le_sub (min_le_right _ _) (le_max_right _ _)
      _ = δ := by ring
  have hsample : ∀ t ∈ T, t ∈ Icc (a t) (b t) := by
    intro t ht
    have htI : t ∈ Icc (1 : Real) 2 := hTmem t ht
    change max 1 (t - δ / 2) ≤ t ∧ t ≤ min 2 (t + δ / 2)
    constructor
    · exact max_le htI.1 (by linarith)
    · exact le_min htI.2 (by linarith)
  have hcontained : ∀ t ∈ T, Ioc (a t) (b t) ⊆ Ioc (1 : Real) 2 := by
    intro t ht u hu
    change 1 < u ∧ u ≤ 2
    change max 1 (t - δ / 2) < u ∧ u ≤ min 2 (t + δ / 2) at hu
    exact ⟨lt_of_le_of_lt (le_max_left _ _) hu.1, hu.2.trans (min_le_left _ _)⟩
  have hdisjoint : Set.Pairwise (↑T)
      (Function.onFun Disjoint fun t => Ioc (a t) (b t)) := by
    intro s hs t ht hst
    change Disjoint (Ioc (a s) (b s)) (Ioc (a t) (b t))
    rcases lt_or_gt_of_ne hst with hstlt | htslt
    · apply Ioc_disjoint_Ioc_of_le
      change min 2 (s + δ / 2) ≤ max 1 (t - δ / 2)
      calc
        min 2 (s + δ / 2) ≤ s + δ / 2 := min_le_right _ _
        _ ≤ t - δ / 2 := by
          have hsep : δ ≤ |s - t| := hTsep hs ht hst
          rw [abs_of_nonpos (by linarith)] at hsep
          linarith
        _ ≤ max 1 (t - δ / 2) := le_max_right _ _
    · apply Disjoint.symm
      apply Ioc_disjoint_Ioc_of_le
      change min 2 (t + δ / 2) ≤ max 1 (s - δ / 2)
      calc
        min 2 (t + δ / 2) ≤ t + δ / 2 := min_le_right _ _
        _ ≤ s - δ / 2 := by
          have hsep : δ ≤ |s - t| := hTsep hs ht hst
          rw [abs_of_nonneg (by linarith)] at hsep
          linarith
        _ ≤ max 1 (s - δ / 2) := le_max_right _ _
  simpa only [δ] using
    (timeSamplingL2_of_pairwiseDisjointComparableIntervals
      (s := T) (a := a) (b := b) (sample := fun t => t) hδ
      hab hlength_lower hlength_upper hsample hcontained hdisjoint hF hF' hderiv)

/-- The clipped time cells used above give the elementary packing bound for
an MSS maximal separated set.  Applying the sampling estimate to the
constant scalar function avoids any separate interval-packing argument. -/
theorem aux_card_le_four_inv_dyadicTimeScale_of_MSS_MaximalSeparated
    (j : Nat) (T : Finset Real)
    (hT : _root_.Auto.Spherical.MSSBase.MaximalSeparated j T) :
    (T.card : Real) ≤ 4 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹ := by
  have h := timeSamplingL2_of_MSS_MaximalSeparated
    (E := Real) (F := fun _ : Real => (1 : Real)) (F' := fun _ : Real => (0 : Real))
    j T hT continuous_const continuous_const
    (fun t => by simpa using (hasDerivAt_const (x := t) (c := (1 : Real))))
  norm_num [intervalIntegral.integral_const] at h ⊢
  simpa using h

/-- The fixed-time Plancherel endpoint and the preceding packing bound give
the actual separated-time `L²` baseline for a frequency-localized MSS
half-wave.  Its reciprocal-mesh loss is explicit; this deliberately does not
claim the positive local-smoothing gain needed for Bourgain's summation. -/
theorem aux_dyadicHalfWave_separatedSamplingL2
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat)
    (T : Finset Real) (hT : _root_.Auto.Spherical.MSSBase.MaximalSeparated j T)
    (f : SchwartzMap (Euclidean 2) Complex) :
    (∑ t ∈ T, ∫ x : Euclidean 2,
      ‖_root_.Auto.Spherical.MSSBase.dyadicHalfWave C.cutoff σ j t f x‖ ^ 2) ≤
      16 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹ *
        ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  have hcard :
      (T.card : Real) ≤ 4 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹ :=
    aux_card_le_four_inv_dyadicTimeScale_of_MSS_MaximalSeparated j T hT
  have hI : 0 ≤ ∫ x : Euclidean 2, ‖f x‖ ^ 2 :=
    integral_nonneg fun _ => sq_nonneg _
  calc
    (∑ t ∈ T, ∫ x : Euclidean 2,
        ‖_root_.Auto.Spherical.MSSBase.dyadicHalfWave C.cutoff σ j t f x‖ ^ 2) ≤
        ∑ _t ∈ T, 4 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
      apply Finset.sum_le_sum
      intro t ht
      exact _root_.Auto.Spherical.MSSBase.fixedTimeL2Endpoint C σ j t f
    _ = (T.card : Real) * (4 * ∫ x : Euclidean 2, ‖f x‖ ^ 2) := by
      simp [nsmul_eq_mul]
    _ ≤ (4 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹) *
        (4 * ∫ x : Euclidean 2, ‖f x‖ ^ 2) :=
      mul_le_mul_of_nonneg_right hcard (mul_nonneg (by norm_num) hI)
    _ = 16 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹ *
        ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by ring

/-- Spatially integrated `L²` time Sobolev control.  The product
integrability hypothesis is exactly the Fubini condition needed to exchange
the time interval integral and the spatial integral.  This is the
dimension-generic, finite-exponent part of the blueprint's space-time
corollary; no all-`p` assertion is made here. -/
theorem timeSobolevL2_spacetime
    {d : Nat} {F F' : Real → Euclidean d → Complex} {a b r : Real}
    (hr : r ∈ Icc a b)
    (hFr_meas : AEStronglyMeasurable (F r) volume)
    (hF'_cont : ∀ x, Continuous (fun t => F' t x))
    (hderiv : ∀ t x, HasDerivAt (fun s => F s x) (F' t x) t)
    (hFa : Integrable (fun x => ‖F a x‖ ^ 2) volume)
    (hF' : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc a b)).prod volume)) :
    (∫ x : Euclidean d, ‖F r x‖ ^ 2) ≤
      2 * (∫ x : Euclidean d, ‖F a x‖ ^ 2) +
        2 * (b - a) * (∫ t in a..b, ∫ x : Euclidean d, ‖F' t x‖ ^ 2) :=
  _root_.Auto.Spherical.Auxiliary.integral_norm_sq_radius_le_of_hasDerivAt
    hr hFr_meas hF'_cont hderiv hFa hF'

/-- Spatially integrated `L⁴` time Sobolev control on the unit slab.  This
is the quartic companion to `timeSobolevL2_spacetime`: it applies the proved
one-dimensional `timeSobolevFour_unit` pointwise and uses Fubini only under
explicit product-integrability hypotheses. -/
theorem timeSobolevFour_spacetime
    {d : Nat} {F F' : Real → Euclidean d → Complex} {r : Real}
    (hr : r ∈ Icc (1 : Real) 2)
    (hFr : Integrable (fun x : Euclidean d => ‖F r x‖ ^ 4) volume)
    (hF_cont : ∀ x, Continuous (fun t => F t x))
    (hF'_cont : ∀ x, Continuous (fun t => F' t x))
    (hderiv : ∀ t x, HasDerivAt (fun s => F s x) (F' t x) t)
    (hFspace : Integrable (fun p : Real × Euclidean d => ‖F p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume))
    (hF'space : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume)) :
    (∫ x : Euclidean d, ‖F r x‖ ^ 4) ≤
      8 * (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4) +
        8 * (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4) := by
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  have hFinner : Integrable (fun x : Euclidean d =>
      ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) volume := by
    have hG : Integrable (fun x : Euclidean d =>
        ∫ t : Real, ‖F t x‖ ^ 4 ∂ν) volume := by
      simpa only [ν] using hFspace.integral_prod_right
    have heq : (fun x : Euclidean d =>
        ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) =
        fun x => ∫ t : Real, ‖F t x‖ ^ 4 ∂ν := by
      funext x
      simp only [ν]
      rw [intervalIntegral.integral_of_le (by norm_num), ← integral_Icc_eq_integral_Ioc]
    rw [heq]
    exact hG
  have hF'inner : Integrable (fun x : Euclidean d =>
      ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) volume := by
    have hG : Integrable (fun x : Euclidean d =>
        ∫ t : Real, ‖F' t x‖ ^ 4 ∂ν) volume := by
      simpa only [ν] using hF'space.integral_prod_right
    have heq : (fun x : Euclidean d =>
        ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) =
        fun x => ∫ t : Real, ‖F' t x‖ ^ 4 ∂ν := by
      funext x
      simp only [ν]
      rw [intervalIntegral.integral_of_le (by norm_num), ← integral_Icc_eq_integral_Ioc]
    rw [heq]
    exact hG
  have hright : Integrable (fun x : Euclidean d =>
      8 * (∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) +
        8 * (∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4)) volume := by
    exact (hFinner.const_mul 8).add (hF'inner.const_mul 8)
  have hpoint (x : Euclidean d) : ‖F r x‖ ^ 4 ≤
      8 * (∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) +
        8 * (∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) :=
    timeSobolevFour_unit hr (hF_cont x) (hF'_cont x) (fun t => hderiv t x)
  have hFswap :
      (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) =
        ∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4 := by
    have hFuIoc : Integrable (fun p : Real × Euclidean d => ‖F p.1 p.2‖ ^ 4)
        ((volume.restrict (uIoc (1 : Real) 2)).prod volume) := by
      rw [uIoc_of_le (by norm_num), restrict_Ioc_eq_restrict_Icc]
      exact hFspace
    exact (intervalIntegral_integral_swap
      (f := fun t (x : Euclidean d) => ‖F t x‖ ^ 4) hFuIoc).symm
  have hF'swap :
      (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) =
        ∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4 := by
    have hF'uIoc : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 4)
        ((volume.restrict (uIoc (1 : Real) 2)).prod volume) := by
      rw [uIoc_of_le (by norm_num), restrict_Ioc_eq_restrict_Icc]
      exact hF'space
    exact (intervalIntegral_integral_swap
      (f := fun t (x : Euclidean d) => ‖F' t x‖ ^ 4) hF'uIoc).symm
  calc
    (∫ x : Euclidean d, ‖F r x‖ ^ 4) ≤ ∫ x : Euclidean d,
        8 * (∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) +
          8 * (∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) := by
      apply integral_mono_ae hFr hright
      exact Filter.Eventually.of_forall hpoint
    _ = 8 * (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) +
          8 * (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) := by
      rw [MeasureTheory.integral_add (hFinner.const_mul 8) (hF'inner.const_mul 8),
        MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul]
    _ = _ := by rw [hFswap, hF'swap]

/-- The measurable compact-time `L⁴` maximal form of
`timeSobolevFour_spacetime`.  Unlike a formal exchange of a supremum and an
integral, this proves measurability directly from joint continuity and then
integrates the pointwise quartic Sobolev estimate. -/
theorem measurable_and_lintegral_iSup_ennreal_norm_pow_four_le_timeSobolev
    {d : Nat} {F F' : Real → Euclidean d → Complex}
    (hF : Continuous (Function.uncurry F))
    (hF' : Continuous (Function.uncurry F'))
    (hderiv : ∀ t x, HasDerivAt (fun s => F s x) (F' t x) t)
    (hFspace : Integrable (fun p : Real × Euclidean d => ‖F p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume))
    (hF'space : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume)) :
    Measurable (fun x : Euclidean d =>
      ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) ∧
      (∫⁻ x : Euclidean d,
        ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) ≤
        ENNReal.ofReal
          (8 * (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4) +
            8 * (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4)) := by
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  have hmaxmeas : Measurable (fun x : Euclidean d =>
      ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) := by
    have hG : Measurable (⨆ r : Icc (1 : Real) 2, fun x : Euclidean d =>
        ENNReal.ofReal (‖F r.1 x‖ ^ 4)) := by
      apply measurable_iSup_of_lowerSemicontinuous
      · intro r
        exact (ENNReal.continuous_ofReal.comp
          ((hF.comp (continuous_const.prodMk continuous_id)).norm.pow 4)).measurable
      · intro x
        exact (ENNReal.continuous_ofReal.comp
          ((hF.comp (continuous_subtype_val.prodMk continuous_const)).norm.pow 4)).lowerSemicontinuous
    have hEq : (fun x : Euclidean d =>
        ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) =
        ⨆ r : Icc (1 : Real) 2, fun x : Euclidean d =>
          ENNReal.ofReal (‖F r.1 x‖ ^ 4) := by
      funext x
      exact (iSup_apply
        (f := fun r : Icc (1 : Real) 2 => fun x : Euclidean d =>
          ENNReal.ofReal (‖F r.1 x‖ ^ 4)) (a := x)).symm
    rw [hEq]
    exact hG
  refine ⟨hmaxmeas, ?_⟩
  have hFinner : Integrable (fun x : Euclidean d =>
      ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) volume := by
    have hG : Integrable (fun x : Euclidean d =>
        ∫ t : Real, ‖F t x‖ ^ 4 ∂ν) volume := by
      simpa only [ν] using hFspace.integral_prod_right
    have heq : (fun x : Euclidean d =>
        ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) =
        fun x => ∫ t : Real, ‖F t x‖ ^ 4 ∂ν := by
      funext x
      simp only [ν]
      rw [intervalIntegral.integral_of_le (by norm_num), ← integral_Icc_eq_integral_Ioc]
    rw [heq]
    exact hG
  have hF'inner : Integrable (fun x : Euclidean d =>
      ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) volume := by
    have hG : Integrable (fun x : Euclidean d =>
        ∫ t : Real, ‖F' t x‖ ^ 4 ∂ν) volume := by
      simpa only [ν] using hF'space.integral_prod_right
    have heq : (fun x : Euclidean d =>
        ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) =
        fun x => ∫ t : Real, ‖F' t x‖ ^ 4 ∂ν := by
      funext x
      simp only [ν]
      rw [intervalIntegral.integral_of_le (by norm_num), ← integral_Icc_eq_integral_Ioc]
    rw [heq]
    exact hG
  let R : Euclidean d → Real := fun x =>
    8 * (∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) +
      8 * (∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4)
  have hRint : Integrable R volume := by
    exact (hFinner.const_mul 8).add (hF'inner.const_mul 8)
  have hRnonneg (x : Euclidean d) : 0 ≤ R x := by
    dsimp only [R]
    apply add_nonneg
    · exact mul_nonneg (by norm_num)
        (intervalIntegral.integral_nonneg (by norm_num) fun _ _ => pow_nonneg (norm_nonneg _) _)
    · exact mul_nonneg (by norm_num)
        (intervalIntegral.integral_nonneg (by norm_num) fun _ _ => pow_nonneg (norm_nonneg _) _)
  have hpoint (x : Euclidean d) :
      (⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) ≤
        ENNReal.ofReal (R x) := by
    apply iSup_le
    intro r
    exact ENNReal.ofReal_le_ofReal
      (timeSobolevFour_unit r.2
        (hF.comp (continuous_id.prodMk
          (continuous_const : Continuous fun _ : Real => x)))
        (hF'.comp (continuous_id.prodMk
          (continuous_const : Continuous fun _ : Real => x)))
        (fun t => hderiv t x))
  have hswapF :
      (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) =
        ∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4 := by
    have hFuIoc : Integrable (fun p : Real × Euclidean d => ‖F p.1 p.2‖ ^ 4)
        ((volume.restrict (uIoc (1 : Real) 2)).prod volume) := by
      rw [uIoc_of_le (by norm_num), restrict_Ioc_eq_restrict_Icc]
      exact hFspace
    exact (intervalIntegral_integral_swap
      (f := fun t (x : Euclidean d) => ‖F t x‖ ^ 4) hFuIoc).symm
  have hswapF' :
      (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) =
        ∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4 := by
    have hF'uIoc : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 4)
        ((volume.restrict (uIoc (1 : Real) 2)).prod volume) := by
      rw [uIoc_of_le (by norm_num), restrict_Ioc_eq_restrict_Icc]
      exact hF'space
    exact (intervalIntegral_integral_swap
      (f := fun t (x : Euclidean d) => ‖F' t x‖ ^ 4) hF'uIoc).symm
  calc
    (∫⁻ x : Euclidean d,
        ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) ≤
        ∫⁻ x : Euclidean d, ENNReal.ofReal (R x) := by
      exact lintegral_mono hpoint
    _ = ENNReal.ofReal (∫ x : Euclidean d, R x) := by
      symm
      exact ofReal_integral_eq_lintegral_ofReal hRint
        (Filter.Eventually.of_forall hRnonneg)
    _ = ENNReal.ofReal
        (8 * (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4) +
          8 * (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4)) := by
      congr 1
      dsimp only [R]
      rw [MeasureTheory.integral_add (hFinner.const_mul 8) (hF'inner.const_mul 8),
        MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul,
        hswapF, hswapF']

/-- The scale-sensitive fourth-power one-dimensional Sobolev estimate.  On
an interval of length `b - a`, the derivative contribution carries the
correct cubic length factor. -/
theorem timeSobolevFour
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E] [CompleteSpace E]
    {F F' : Real → E} {a b r : Real} (hab : a < b) (hr : r ∈ Icc a b)
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ t, HasDerivAt F (F' t) t) :
    ‖F r‖ ^ 4 ≤
      8 * (b - a)⁻¹ * (∫ t in a..b, ‖F t‖ ^ 4) +
        8 * (b - a) ^ 3 * (∫ t in a..b, ‖F' t‖ ^ 4) := by
  let G : Real → Real := fun t => ‖F t‖ ^ 4
  have hG : Continuous G := (continuous_norm.comp hF).pow 4
  obtain ⟨c, hc, hcmean⟩ :=
    exists_eq_const_mul_intervalIntegral_of_nonneg (μ := volume)
      hG.continuousOn
      (intervalIntegrable_const : IntervalIntegrable (fun _ : Real => (1 : Real)) volume a b)
      (by intro _ _; positivity)
  have hc' : c ∈ Icc a b := by
    simpa only [uIcc_of_le hab.le] using hc
  have hlen : b - a ≠ 0 := sub_ne_zero.mpr hab.ne'
  have hcvalue : ‖F c‖ ^ 4 = (∫ t in a..b, ‖F t‖ ^ 4) / (b - a) := by
    apply (eq_div_iff hlen).mpr
    simpa [G, mul_comm] using hcmean.symm
  have hnorm := norm_le_norm_add_timeDerivativeIntegral hc' hr hF' hderiv
  let B : Real := ∫ t in a..b, ‖F' t‖
  have hB : 0 ≤ B := by
    dsimp [B]
    exact intervalIntegral.integral_nonneg hab.le fun _ _ => norm_nonneg _
  have hA : 0 ≤ ‖F c‖ := norm_nonneg _
  have hpow : ‖F r‖ ^ 4 ≤ (‖F c‖ + B) ^ 4 := by
    exact pow_le_pow_left₀ (norm_nonneg _) hnorm 4
  have hadd : (‖F c‖ + B) ^ 4 ≤ 8 * (‖F c‖ ^ 4 + B ^ 4) := by
    calc
      (‖F c‖ + B) ^ 4 ≤ 2 ^ (4 - 1) * (‖F c‖ ^ 4 + B ^ 4) :=
        add_pow_le hA hB 4
      _ = 8 * (‖F c‖ ^ 4 + B ^ 4) := by norm_num
  have hcs1 :=
    _root_.Auto.Spherical.Auxiliary.intervalIntegral_norm_sq_le_length_mul_intervalIntegral_norm_sq
      (g := F') (a := a) (b := b) hab.le hF'
  have hcs1' : B ^ 2 ≤ (b - a) * ∫ t in a..b, ‖F' t‖ ^ 2 := by
    calc
      B ^ 2 = (∫ t in a..b, ‖F' t‖) ^ 2 := by rfl
      _ ≤ (b - a) * ∫ t in a..b, ‖F' t‖ ^ 2 := hcs1
  have hF'sq : Continuous (fun t : Real => ‖F' t‖ ^ 2) :=
    (continuous_norm.comp hF').pow 2
  have hcs2 :=
    _root_.Auto.Spherical.Auxiliary.intervalIntegral_norm_sq_le_length_mul_intervalIntegral_norm_sq
      (g := fun t : Real => ‖F' t‖ ^ 2) (a := a) (b := b) hab.le hF'sq
  have hnormsq (t : Real) : ‖‖F' t‖ ^ 2‖ = ‖F' t‖ ^ 2 :=
    Real.norm_of_nonneg (sq_nonneg _)
  have hcs2raw : (∫ t in a..b, ‖F' t‖ ^ 2) ^ 2 ≤
      (b - a) * ∫ t in a..b, (‖F' t‖ ^ 2) ^ 2 := by
    simpa only [hnormsq] using hcs2
  have hcs2' : (∫ t in a..b, ‖F' t‖ ^ 2) ^ 2 ≤
      (b - a) * ∫ t in a..b, ‖F' t‖ ^ 4 := by
    calc
      (∫ t in a..b, ‖F' t‖ ^ 2) ^ 2 ≤
          (b - a) * ∫ t in a..b, (‖F' t‖ ^ 2) ^ 2 := hcs2raw
      _ = _ := by
        congr 1
        apply intervalIntegral.integral_congr
        intro t _
        ring
  have hBfour : B ^ 4 ≤ (b - a) ^ 3 * ∫ t in a..b, ‖F' t‖ ^ 4 := by
    calc
      B ^ 4 = (B ^ 2) ^ 2 := by ring
      _ ≤ ((b - a) * ∫ t in a..b, ‖F' t‖ ^ 2) ^ 2 :=
        pow_le_pow_left₀ (sq_nonneg B) hcs1' 2
      _ = (b - a) ^ 2 * (∫ t in a..b, ‖F' t‖ ^ 2) ^ 2 := by ring
      _ ≤ (b - a) ^ 2 * ((b - a) * ∫ t in a..b, ‖F' t‖ ^ 4) := by
        exact mul_le_mul_of_nonneg_left hcs2' (sq_nonneg (b - a))
      _ = _ := by ring
  calc
    ‖F r‖ ^ 4 ≤ (‖F c‖ + B) ^ 4 := hpow
    _ ≤ 8 * (‖F c‖ ^ 4 + B ^ 4) := hadd
    _ ≤ 8 * (((∫ t in a..b, ‖F t‖ ^ 4) / (b - a)) +
        (b - a) ^ 3 * ∫ t in a..b, ‖F' t‖ ^ 4) := by
      gcongr
      rw [hcvalue]
    _ = 8 * (b - a)⁻¹ * (∫ t in a..b, ‖F t‖ ^ 4) +
        8 * (b - a) ^ 3 * (∫ t in a..b, ‖F' t‖ ^ 4) := by
      rw [div_eq_mul_inv]
      ring

/-- Fourth-power sampling on pairwise-disjoint time cells whose lengths are
between half a mesh and a full mesh. -/
theorem timeSamplingFour_of_pairwiseDisjointComparableIntervals
    {ι : Type*} {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    [CompleteSpace E] {F F' : Real → E}
    (s : Finset ι) (a b sample : ι → Real) {δ : Real} (hδ : 0 < δ)
    (hab : ∀ i ∈ s, a i ≤ b i)
    (hlength_lower : ∀ i ∈ s, δ / 2 ≤ b i - a i)
    (hlength_upper : ∀ i ∈ s, b i - a i ≤ δ)
    (hsample : ∀ i ∈ s, sample i ∈ Icc (a i) (b i))
    (hcontained : ∀ i ∈ s, Ioc (a i) (b i) ⊆ Ioc (1 : Real) 2)
    (hdisjoint : Set.Pairwise (↑s)
      (Function.onFun Disjoint (fun i => Ioc (a i) (b i))))
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ t, HasDerivAt F (F' t) t) :
    (∑ i ∈ s, ‖F (sample i)‖ ^ 4) ≤
      16 * δ⁻¹ * (∫ t in (1 : Real)..2, ‖F t‖ ^ 4) +
        8 * δ ^ 3 * (∫ t in (1 : Real)..2, ‖F' t‖ ^ 4) := by
  have hlocal : ∀ i ∈ s,
      ‖F (sample i)‖ ^ 4 ≤
        16 * δ⁻¹ * (∫ t in a i..b i, ‖F t‖ ^ 4) +
          8 * δ ^ 3 * (∫ t in a i..b i, ‖F' t‖ ^ 4) := by
    intro i hi
    have hpos : a i < b i := by
      rw [← sub_pos]
      exact lt_of_lt_of_le (by linarith [hδ]) (hlength_lower i hi)
    have hinv : (b i - a i)⁻¹ ≤ (δ / 2)⁻¹ := by
      simpa only [one_div] using
        (one_div_le_one_div_of_le (by linarith [hδ]) (hlength_lower i hi))
    have hcoeff0 : 8 * (b i - a i)⁻¹ ≤ 16 * δ⁻¹ := by
      calc
        8 * (b i - a i)⁻¹ ≤ 8 * (δ / 2)⁻¹ :=
          mul_le_mul_of_nonneg_left hinv (by norm_num)
        _ = 16 * δ⁻¹ := by
          field_simp [ne_of_gt hδ]
          ring
    have hcoeff1 : 8 * (b i - a i) ^ 3 ≤ 8 * δ ^ 3 := by
      apply mul_le_mul_of_nonneg_left _ (by norm_num)
      exact pow_le_pow_left₀ (sub_nonneg.mpr (hab i hi)) (hlength_upper i hi) 3
    have hIFn : 0 ≤ ∫ t in a i..b i, ‖F t‖ ^ 4 :=
      intervalIntegral.integral_nonneg hpos.le fun _ _ => pow_nonneg (norm_nonneg _) _
    have hI'n : 0 ≤ ∫ t in a i..b i, ‖F' t‖ ^ 4 :=
      intervalIntegral.integral_nonneg hpos.le fun _ _ => pow_nonneg (norm_nonneg _) _
    calc
      ‖F (sample i)‖ ^ 4 ≤
          8 * (b i - a i)⁻¹ * (∫ t in a i..b i, ‖F t‖ ^ 4) +
            8 * (b i - a i) ^ 3 * (∫ t in a i..b i, ‖F' t‖ ^ 4) :=
        timeSobolevFour hpos (hsample i hi) hF hF' hderiv
      _ ≤ 16 * δ⁻¹ * (∫ t in a i..b i, ‖F t‖ ^ 4) +
            8 * δ ^ 3 * (∫ t in a i..b i, ‖F' t‖ ^ 4) := by
        apply add_le_add
        · exact mul_le_mul_of_nonneg_right hcoeff0 hIFn
        · exact mul_le_mul_of_nonneg_right hcoeff1 hI'n
  have hsum := Finset.sum_le_sum fun i hi => hlocal i hi
  have hsumF : (∑ i ∈ s, ∫ t in a i..b i, ‖F t‖ ^ 4) ≤
      ∫ t in (1 : Real)..2, ‖F t‖ ^ 4 := by
    simpa only [Pi.pow_apply, Function.comp_apply] using
      (aux_sum_intervalIntegral_le_intervalIntegral_of_pairwiseDisjoint
        s a b ((continuous_norm.comp hF).pow 4) (fun t => pow_nonneg (norm_nonneg _) _)
        hab hcontained hdisjoint)
  have hsumF' : (∑ i ∈ s, ∫ t in a i..b i, ‖F' t‖ ^ 4) ≤
      ∫ t in (1 : Real)..2, ‖F' t‖ ^ 4 := by
    simpa only [Pi.pow_apply, Function.comp_apply] using
      (aux_sum_intervalIntegral_le_intervalIntegral_of_pairwiseDisjoint
        s a b ((continuous_norm.comp hF').pow 4) (fun t => pow_nonneg (norm_nonneg _) _)
        hab hcontained hdisjoint)
  calc
    (∑ i ∈ s, ‖F (sample i)‖ ^ 4) ≤
        ∑ i ∈ s,
          (16 * δ⁻¹ * (∫ t in a i..b i, ‖F t‖ ^ 4) +
            8 * δ ^ 3 * (∫ t in a i..b i, ‖F' t‖ ^ 4)) := hsum
    _ = 16 * δ⁻¹ * (∑ i ∈ s, ∫ t in a i..b i, ‖F t‖ ^ 4) +
        8 * δ ^ 3 * (∑ i ∈ s, ∫ t in a i..b i, ‖F' t‖ ^ 4) := by
      rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
    _ ≤ 16 * δ⁻¹ * (∫ t in (1 : Real)..2, ‖F t‖ ^ 4) +
        8 * δ ^ 3 * (∫ t in (1 : Real)..2, ‖F' t‖ ^ 4) := by
      gcongr

/-- The fourth-power separated-time sampling estimate for the finite time
families occurring in the MSS maximal statement. -/
theorem timeSamplingFour_of_MSS_MaximalSeparated
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E] [CompleteSpace E]
    {F F' : Real → E} (j : Nat) (T : Finset Real)
    (hT : _root_.Auto.Spherical.MSSBase.MaximalSeparated j T)
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ t, HasDerivAt F (F' t) t) :
    (∑ t ∈ T, ‖F t‖ ^ 4) ≤
      16 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹ *
          (∫ t in (1 : Real)..2, ‖F t‖ ^ 4) +
        8 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j) ^ 3 *
          (∫ t in (1 : Real)..2, ‖F' t‖ ^ 4) := by
  rcases hT with ⟨hTmem, hTsep, hTcover⟩
  let δ : Real := _root_.Auto.Spherical.MSSBase.dyadicTimeScale j
  let a : Real → Real := fun t => max 1 (t - δ / 2)
  let b : Real → Real := fun t => min 2 (t + δ / 2)
  have hδ : 0 < δ := by
    dsimp only [δ, _root_.Auto.Spherical.MSSBase.dyadicTimeScale]
    exact zpow_pos (by norm_num) _
  have hδone : δ ≤ 1 := by
    dsimp only [δ, _root_.Auto.Spherical.MSSBase.dyadicTimeScale]
    apply zpow_le_one_of_nonpos₀
    · norm_num
    · omega
  have hab : ∀ t ∈ T, a t ≤ b t := by
    intro t ht
    have htI : t ∈ Icc (1 : Real) 2 := hTmem t ht
    change max 1 (t - δ / 2) ≤ min 2 (t + δ / 2)
    apply max_le
    · apply le_min
      · norm_num
      · nlinarith [htI.1, hδ]
    · apply le_min
      · nlinarith [htI.2, hδ]
      · nlinarith [htI.1, htI.2, hδone]
  have hlength_lower : ∀ t ∈ T, δ / 2 ≤ b t - a t := by
    intro t ht
    have htI : t ∈ Icc (1 : Real) 2 := hTmem t ht
    change δ / 2 ≤ min 2 (t + δ / 2) - max 1 (t - δ / 2)
    by_cases hleft : 1 ≤ t - δ / 2
    · by_cases hright : t + δ / 2 ≤ 2
      · rw [max_eq_right hleft, min_eq_right hright]
        linarith [htI.1, htI.2]
      · have hright' : 2 ≤ t + δ / 2 := le_of_lt (lt_of_not_ge hright)
        rw [max_eq_right hleft, min_eq_left hright']
        linarith [htI.1, htI.2]
    · have hleft' : t - δ / 2 ≤ 1 := le_of_lt (lt_of_not_ge hleft)
      by_cases hright : t + δ / 2 ≤ 2
      · rw [max_eq_left hleft', min_eq_right hright]
        linarith [htI.1, htI.2]
      · have hright' : 2 ≤ t + δ / 2 := le_of_lt (lt_of_not_ge hright)
        rw [max_eq_left hleft', min_eq_left hright']
        linarith [htI.1, htI.2]
  have hlength_upper : ∀ t ∈ T, b t - a t ≤ δ := by
    intro t ht
    change min 2 (t + δ / 2) - max 1 (t - δ / 2) ≤ δ
    calc
      min 2 (t + δ / 2) - max 1 (t - δ / 2) ≤
          (t + δ / 2) - (t - δ / 2) :=
        sub_le_sub (min_le_right _ _) (le_max_right _ _)
      _ = δ := by ring
  have hsample : ∀ t ∈ T, t ∈ Icc (a t) (b t) := by
    intro t ht
    have htI : t ∈ Icc (1 : Real) 2 := hTmem t ht
    change max 1 (t - δ / 2) ≤ t ∧ t ≤ min 2 (t + δ / 2)
    constructor
    · exact max_le htI.1 (by linarith)
    · exact le_min htI.2 (by linarith)
  have hcontained : ∀ t ∈ T, Ioc (a t) (b t) ⊆ Ioc (1 : Real) 2 := by
    intro t ht u hu
    change 1 < u ∧ u ≤ 2
    change max 1 (t - δ / 2) < u ∧ u ≤ min 2 (t + δ / 2) at hu
    exact ⟨lt_of_le_of_lt (le_max_left _ _) hu.1, hu.2.trans (min_le_left _ _)⟩
  have hdisjoint : Set.Pairwise (↑T)
      (Function.onFun Disjoint fun t => Ioc (a t) (b t)) := by
    intro s hs t ht hst
    change Disjoint (Ioc (a s) (b s)) (Ioc (a t) (b t))
    rcases lt_or_gt_of_ne hst with hstlt | htslt
    · apply Ioc_disjoint_Ioc_of_le
      change min 2 (s + δ / 2) ≤ max 1 (t - δ / 2)
      calc
        min 2 (s + δ / 2) ≤ s + δ / 2 := min_le_right _ _
        _ ≤ t - δ / 2 := by
          have hsep : δ ≤ |s - t| := hTsep hs ht hst
          rw [abs_of_nonpos (by linarith)] at hsep
          linarith
        _ ≤ max 1 (t - δ / 2) := le_max_right _ _
    · apply Disjoint.symm
      apply Ioc_disjoint_Ioc_of_le
      change min 2 (t + δ / 2) ≤ max 1 (s - δ / 2)
      calc
        min 2 (t + δ / 2) ≤ t + δ / 2 := min_le_right _ _
        _ ≤ s - δ / 2 := by
          have hsep : δ ≤ |s - t| := hTsep hs ht hst
          rw [abs_of_nonneg (by linarith)] at hsep
          linarith
        _ ≤ max 1 (s - δ / 2) := le_max_right _ _
  simpa only [δ] using
    (timeSamplingFour_of_pairwiseDisjointComparableIntervals
      (s := T) (a := a) (b := b) (sample := fun t => t) hδ
      hab hlength_lower hlength_upper hsample hcontained hdisjoint hF hF' hderiv)

/-- The fourth-power Hölder bound for an interval integral. -/
theorem intervalIntegral_norm_pow_four_le
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E] [CompleteSpace E]
    {G : Real → E} {a b : Real} (hab : a ≤ b) (hG : Continuous G) :
    (∫ t in a..b, ‖G t‖) ^ 4 ≤
      (b - a) ^ 3 * ∫ t in a..b, ‖G t‖ ^ 4 := by
  let B : Real := ∫ t in a..b, ‖G t‖
  have hcs1 :=
    _root_.Auto.Spherical.Auxiliary.intervalIntegral_norm_sq_le_length_mul_intervalIntegral_norm_sq
      (g := G) (a := a) (b := b) hab hG
  have hcs1' : B ^ 2 ≤ (b - a) * ∫ t in a..b, ‖G t‖ ^ 2 := by
    calc
      B ^ 2 = (∫ t in a..b, ‖G t‖) ^ 2 := by rfl
      _ ≤ (b - a) * ∫ t in a..b, ‖G t‖ ^ 2 := hcs1
  have hGsq : Continuous (fun t : Real => ‖G t‖ ^ 2) :=
    (continuous_norm.comp hG).pow 2
  have hcs2 :=
    _root_.Auto.Spherical.Auxiliary.intervalIntegral_norm_sq_le_length_mul_intervalIntegral_norm_sq
      (g := fun t : Real => ‖G t‖ ^ 2) (a := a) (b := b) hab hGsq
  have hnormsq (t : Real) : ‖‖G t‖ ^ 2‖ = ‖G t‖ ^ 2 :=
    Real.norm_of_nonneg (sq_nonneg _)
  have hcs2raw : (∫ t in a..b, ‖G t‖ ^ 2) ^ 2 ≤
      (b - a) * ∫ t in a..b, (‖G t‖ ^ 2) ^ 2 := by
    simpa only [hnormsq] using hcs2
  have hcs2' : (∫ t in a..b, ‖G t‖ ^ 2) ^ 2 ≤
      (b - a) * ∫ t in a..b, ‖G t‖ ^ 4 := by
    calc
      (∫ t in a..b, ‖G t‖ ^ 2) ^ 2 ≤
          (b - a) * ∫ t in a..b, (‖G t‖ ^ 2) ^ 2 := hcs2raw
      _ = _ := by
        congr 1
        apply intervalIntegral.integral_congr
        intro t _
        ring
  calc
    (∫ t in a..b, ‖G t‖) ^ 4 = B ^ 4 := by rfl
    _ = (B ^ 2) ^ 2 := by ring
    _ ≤ ((b - a) * ∫ t in a..b, ‖G t‖ ^ 2) ^ 2 :=
      pow_le_pow_left₀ (sq_nonneg B) hcs1' 2
    _ = (b - a) ^ 2 * (∫ t in a..b, ‖G t‖ ^ 2) ^ 2 := by ring
    _ ≤ (b - a) ^ 2 * ((b - a) * ∫ t in a..b, ‖G t‖ ^ 4) := by
      exact mul_le_mul_of_nonneg_left hcs2' (sq_nonneg (b - a))
    _ = _ := by ring

/-- Fourth-power control of a time increment by the fourth moment of its
time derivative over an ambient interval. -/
theorem norm_sub_pow_four_le_abs_sub_pow_three_mul_timeDerivativeEnergy
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E] [CompleteSpace E]
    {F F' : Real → E} {a b r s : Real} (_hab : a ≤ b)
    (hr : r ∈ Icc a b) (hs : s ∈ Icc a b)
    (hF' : Continuous F')
    (hderiv : ∀ t, HasDerivAt F (F' t) t) :
    ‖F r - F s‖ ^ 4 ≤ |r - s| ^ 3 * (∫ t in a..b, ‖F' t‖ ^ 4) := by
  have hnonneg : 0 ≤ᵐ[volume.restrict (Ioc a b)] fun t => ‖F' t‖ ^ 4 :=
    Filter.Eventually.of_forall fun _ => pow_nonneg (norm_nonneg _) _
  have hint : IntervalIntegrable (fun t => ‖F' t‖ ^ 4) volume a b :=
    ((continuous_norm.comp hF').pow 4).intervalIntegrable a b
  rcases le_total r s with hrs | hsr
  · have hftc : ∫ t in r..s, F' t = F s - F r := by
      apply intervalIntegral.integral_eq_sub_of_hasDerivAt
      · intro t _
        exact hderiv t
      · exact hF'.intervalIntegrable r s
    have hdiff : ‖F r - F s‖ ≤ ∫ t in r..s, ‖F' t‖ := by
      rw [norm_sub_rev, ← hftc]
      exact intervalIntegral.norm_integral_le_integral_norm hrs
    have hBfour := intervalIntegral_norm_pow_four_le (G := F') hrs hF'
    have hmono : (∫ t in r..s, ‖F' t‖ ^ 4) ≤ ∫ t in a..b, ‖F' t‖ ^ 4 :=
      intervalIntegral.integral_mono_interval hr.1 hrs hs.2 hnonneg hint
    have hpow : ‖F r - F s‖ ^ 4 ≤ (∫ t in r..s, ‖F' t‖) ^ 4 := by
      have hB : 0 ≤ ∫ t in r..s, ‖F' t‖ :=
        intervalIntegral.integral_nonneg hrs fun _ _ => norm_nonneg _
      exact pow_le_pow_left₀ (norm_nonneg _) hdiff 4
    calc
      ‖F r - F s‖ ^ 4 ≤ (∫ t in r..s, ‖F' t‖) ^ 4 := hpow
      _ ≤ (s - r) ^ 3 * ∫ t in r..s, ‖F' t‖ ^ 4 := hBfour
      _ ≤ (s - r) ^ 3 * ∫ t in a..b, ‖F' t‖ ^ 4 := by
        exact mul_le_mul_of_nonneg_left hmono (pow_nonneg (sub_nonneg.mpr hrs) _)
      _ = |r - s| ^ 3 * ∫ t in a..b, ‖F' t‖ ^ 4 := by
        rw [abs_of_nonpos (sub_nonpos.mpr hrs)]
        ring
  · have hftc : ∫ t in s..r, F' t = F r - F s := by
      apply intervalIntegral.integral_eq_sub_of_hasDerivAt
      · intro t _
        exact hderiv t
      · exact hF'.intervalIntegrable s r
    have hdiff : ‖F r - F s‖ ≤ ∫ t in s..r, ‖F' t‖ := by
      rw [← hftc]
      exact intervalIntegral.norm_integral_le_integral_norm hsr
    have hBfour := intervalIntegral_norm_pow_four_le (G := F') hsr hF'
    have hmono : (∫ t in s..r, ‖F' t‖ ^ 4) ≤ ∫ t in a..b, ‖F' t‖ ^ 4 :=
      intervalIntegral.integral_mono_interval hs.1 hsr hr.2 hnonneg hint
    have hpow : ‖F r - F s‖ ^ 4 ≤ (∫ t in s..r, ‖F' t‖) ^ 4 := by
      have hB : 0 ≤ ∫ t in s..r, ‖F' t‖ :=
        intervalIntegral.integral_nonneg hsr fun _ _ => norm_nonneg _
      exact pow_le_pow_left₀ (norm_nonneg _) hdiff 4
    calc
      ‖F r - F s‖ ^ 4 ≤ (∫ t in s..r, ‖F' t‖) ^ 4 := hpow
      _ ≤ (r - s) ^ 3 * ∫ t in s..r, ‖F' t‖ ^ 4 := hBfour
      _ ≤ (r - s) ^ 3 * ∫ t in a..b, ‖F' t‖ ^ 4 := by
        exact mul_le_mul_of_nonneg_left hmono (pow_nonneg (sub_nonneg.mpr hsr) _)
      _ = |r - s| ^ 3 * ∫ t in a..b, ‖F' t‖ ^ 4 := by
        rw [abs_of_nonneg (sub_nonneg.mpr hsr)]

/-- A finite MSS maximal-separated family reduces the genuine fourth-power
continuous time maximum to scale-sensitive fourth moments. -/
theorem timeSupremumFour_of_MSS_MaximalSeparated
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E] [CompleteSpace E]
    {F F' : Real → E} (j : Nat) (T : Finset Real)
    (hT : _root_.Auto.Spherical.MSSBase.MaximalSeparated j T)
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ t, HasDerivAt F (F' t) t) :
    (⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1‖ ^ 4)) ≤
      ENNReal.ofReal
        (128 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹ *
            (∫ t in (1 : Real)..2, ‖F t‖ ^ 4) +
          72 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j) ^ 3 *
            (∫ t in (1 : Real)..2, ‖F' t‖ ^ 4)) := by
  let δ : Real := _root_.Auto.Spherical.MSSBase.dyadicTimeScale j
  let A : Real := ∫ t in (1 : Real)..2, ‖F t‖ ^ 4
  let D : Real := ∫ t in (1 : Real)..2, ‖F' t‖ ^ 4
  let S : Real := ∑ t ∈ T, ‖F t‖ ^ 4
  have hδ : 0 < δ := by
    dsimp only [δ, _root_.Auto.Spherical.MSSBase.dyadicTimeScale]
    exact zpow_pos (by norm_num) _
  have hA : 0 ≤ A := by
    dsimp only [A]
    exact intervalIntegral.integral_nonneg (by norm_num) fun _ _ =>
      pow_nonneg (norm_nonneg _) _
  have hD : 0 ≤ D := by
    dsimp only [D]
    exact intervalIntegral.integral_nonneg (by norm_num) fun _ _ =>
      pow_nonneg (norm_nonneg _) _
  have hsample : S ≤ 16 * δ⁻¹ * A + 8 * δ ^ 3 * D := by
    dsimp only [S, A, D, δ]
    exact timeSamplingFour_of_MSS_MaximalSeparated j T hT hF hF' hderiv
  have hcombined : 8 * S + 8 * δ ^ 3 * D ≤
      128 * δ⁻¹ * A + 72 * δ ^ 3 * D := by
    calc
      8 * S + 8 * δ ^ 3 * D ≤
          8 * (16 * δ⁻¹ * A + 8 * δ ^ 3 * D) + 8 * δ ^ 3 * D := by
        gcongr
      _ = 128 * δ⁻¹ * A + 72 * δ ^ 3 * D := by ring
  apply iSup_le
  intro r
  rcases hT.2.2 r r.2 with ⟨s, hs, hrs⟩
  have hinc : ‖F r.1 - F s‖ ^ 4 ≤ δ ^ 3 * D := by
    have h := norm_sub_pow_four_le_abs_sub_pow_three_mul_timeDerivativeEnergy
      (F := F) (F' := F') (a := (1 : Real)) (b := 2) (r := r.1) (s := s)
      (by norm_num) r.2 (hT.1 s hs) hF' hderiv
    calc
      ‖F r.1 - F s‖ ^ 4 ≤ |r.1 - s| ^ 3 * D := by
        simpa only [D] using h
      _ ≤ δ ^ 3 * D := by
        apply mul_le_mul_of_nonneg_right _ hD
        exact pow_le_pow_left₀ (abs_nonneg _) (le_of_lt hrs) 3
  have hnorm : ‖F r.1‖ ≤ ‖F r.1 - F s‖ + ‖F s‖ := by
    calc
      ‖F r.1‖ = ‖(F r.1 - F s) + F s‖ := by rw [sub_add_cancel]
      _ ≤ _ := norm_add_le _ _
  have hnormfour : ‖F r.1‖ ^ 4 ≤
      8 * ‖F s‖ ^ 4 + 8 * ‖F r.1 - F s‖ ^ 4 := by
    have hpow : ‖F r.1‖ ^ 4 ≤ (‖F r.1 - F s‖ + ‖F s‖) ^ 4 :=
      pow_le_pow_left₀ (norm_nonneg _) hnorm 4
    calc
      ‖F r.1‖ ^ 4 ≤ (‖F r.1 - F s‖ + ‖F s‖) ^ 4 := hpow
      _ ≤ 2 ^ (4 - 1) * (‖F r.1 - F s‖ ^ 4 + ‖F s‖ ^ 4) :=
        add_pow_le (norm_nonneg _) (norm_nonneg _) 4
      _ = 8 * (‖F r.1 - F s‖ ^ 4 + ‖F s‖ ^ 4) := by norm_num
      _ = 8 * ‖F s‖ ^ 4 + 8 * ‖F r.1 - F s‖ ^ 4 := by ring
  have hsS : ‖F s‖ ^ 4 ≤ S := by
    dsimp only [S]
    exact Finset.single_le_sum (fun t _ => pow_nonneg (norm_nonneg _) _) hs
  have hpoint : ‖F r.1‖ ^ 4 ≤ 8 * S + 8 * δ ^ 3 * D := by
    calc
      ‖F r.1‖ ^ 4 ≤ 8 * ‖F s‖ ^ 4 + 8 * ‖F r.1 - F s‖ ^ 4 := hnormfour
      _ ≤ 8 * S + 8 * δ ^ 3 * D := by
        apply add_le_add
        · exact mul_le_mul_of_nonneg_left hsS (by norm_num)
        · calc
            8 * ‖F r.1 - F s‖ ^ 4 ≤ 8 * (δ ^ 3 * D) :=
              mul_le_mul_of_nonneg_left hinc (by norm_num)
            _ = 8 * δ ^ 3 * D := by ring
  exact ENNReal.ofReal_le_ofReal (hpoint.trans hcombined)

/-- The measurable product-space fourth-power form of scale-sensitive time
sampling.  The hypotheses make both the time maximum and its Fubini
interchange literal. -/
theorem measurable_and_lintegral_iSup_ennreal_norm_pow_four_le_timeSamplingL4
    {d : Nat} {F F' : Real → Euclidean d → Complex}
    (j : Nat) (T : Finset Real)
    (hT : _root_.Auto.Spherical.MSSBase.MaximalSeparated j T)
    (hF : Continuous (Function.uncurry F))
    (hF' : Continuous (Function.uncurry F'))
    (hderiv : ∀ t x, HasDerivAt (fun s => F s x) (F' t x) t)
    (hFspace : Integrable (fun p : Real × Euclidean d => ‖F p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume))
    (hF'space : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume)) :
    Measurable (fun x : Euclidean d =>
      ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) ∧
      (∫⁻ x : Euclidean d,
        ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) ≤
        ENNReal.ofReal
          (128 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹ *
              (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4) +
            72 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j) ^ 3 *
              (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4)) := by
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  have hmaxmeas : Measurable (fun x : Euclidean d =>
      ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) := by
    have hG : Measurable (⨆ r : Icc (1 : Real) 2, fun x : Euclidean d =>
        ENNReal.ofReal (‖F r.1 x‖ ^ 4)) := by
      apply measurable_iSup_of_lowerSemicontinuous
      · intro r
        exact (ENNReal.continuous_ofReal.comp
          ((hF.comp (continuous_const.prodMk continuous_id)).norm.pow 4)).measurable
      · intro x
        exact (ENNReal.continuous_ofReal.comp
          ((hF.comp (continuous_subtype_val.prodMk continuous_const)).norm.pow 4)).lowerSemicontinuous
    have hEq : (fun x : Euclidean d =>
        ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) =
        ⨆ r : Icc (1 : Real) 2, fun x : Euclidean d =>
          ENNReal.ofReal (‖F r.1 x‖ ^ 4) := by
      funext x
      exact (iSup_apply
        (f := fun r : Icc (1 : Real) 2 => fun x : Euclidean d =>
          ENNReal.ofReal (‖F r.1 x‖ ^ 4)) (a := x)).symm
    rw [hEq]
    exact hG
  refine ⟨hmaxmeas, ?_⟩
  have hFinner : Integrable (fun x : Euclidean d =>
      ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) volume := by
    have hG : Integrable (fun x : Euclidean d =>
        ∫ t : Real, ‖F t x‖ ^ 4 ∂ν) volume := by
      simpa only [ν] using hFspace.integral_prod_right
    have heq : (fun x : Euclidean d =>
        ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) =
        fun x => ∫ t : Real, ‖F t x‖ ^ 4 ∂ν := by
      funext x
      simp only [ν]
      rw [intervalIntegral.integral_of_le (by norm_num), ← integral_Icc_eq_integral_Ioc]
    rw [heq]
    exact hG
  have hF'inner : Integrable (fun x : Euclidean d =>
      ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) volume := by
    have hG : Integrable (fun x : Euclidean d =>
        ∫ t : Real, ‖F' t x‖ ^ 4 ∂ν) volume := by
      simpa only [ν] using hF'space.integral_prod_right
    have heq : (fun x : Euclidean d =>
        ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) =
        fun x => ∫ t : Real, ‖F' t x‖ ^ 4 ∂ν := by
      funext x
      simp only [ν]
      rw [intervalIntegral.integral_of_le (by norm_num), ← integral_Icc_eq_integral_Ioc]
    rw [heq]
    exact hG
  let R : Euclidean d → Real := fun x =>
    128 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹ *
        (∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) +
      72 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j) ^ 3 *
        (∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4)
  have hRint : Integrable R volume := by
    exact (hFinner.const_mul
      (128 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹)).add
      (hF'inner.const_mul
        (72 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j) ^ 3))
  have hRnonneg (x : Euclidean d) : 0 ≤ R x := by
    dsimp only [R]
    have hscale : 0 < _root_.Auto.Spherical.MSSBase.dyadicTimeScale j := by
      dsimp only [_root_.Auto.Spherical.MSSBase.dyadicTimeScale]
      exact zpow_pos (by norm_num) _
    apply add_nonneg
    · exact mul_nonneg
        (mul_nonneg (by norm_num) (inv_nonneg.mpr hscale.le))
        (intervalIntegral.integral_nonneg (by norm_num) fun _ _ =>
          pow_nonneg (norm_nonneg _) _)
    · exact mul_nonneg
        (mul_nonneg (by norm_num) (pow_nonneg hscale.le _))
        (intervalIntegral.integral_nonneg (by norm_num) fun _ _ =>
          pow_nonneg (norm_nonneg _) _)
  have hpoint (x : Euclidean d) :
      (⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) ≤
        ENNReal.ofReal (R x) := by
    change (⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) ≤
      ENNReal.ofReal
        (128 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹ *
            (∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) +
          72 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j) ^ 3 *
            (∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4))
    exact timeSupremumFour_of_MSS_MaximalSeparated
      (F := fun t => F t x) (F' := fun t => F' t x) j T hT
      (hF.comp (continuous_id.prodMk
        (continuous_const : Continuous fun _ : Real => x)))
      (hF'.comp (continuous_id.prodMk
        (continuous_const : Continuous fun _ : Real => x)))
      (fun t => hderiv t x)
  have hswapF :
      (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) =
        ∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4 := by
    have hFuIoc : Integrable (fun p : Real × Euclidean d => ‖F p.1 p.2‖ ^ 4)
        ((volume.restrict (uIoc (1 : Real) 2)).prod volume) := by
      rw [uIoc_of_le (by norm_num), restrict_Ioc_eq_restrict_Icc]
      exact hFspace
    exact (intervalIntegral_integral_swap
      (f := fun t (x : Euclidean d) => ‖F t x‖ ^ 4) hFuIoc).symm
  have hswapF' :
      (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) =
        ∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4 := by
    have hF'uIoc : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 4)
        ((volume.restrict (uIoc (1 : Real) 2)).prod volume) := by
      rw [uIoc_of_le (by norm_num), restrict_Ioc_eq_restrict_Icc]
      exact hF'space
    exact (intervalIntegral_integral_swap
      (f := fun t (x : Euclidean d) => ‖F' t x‖ ^ 4) hF'uIoc).symm
  calc
    (∫⁻ x : Euclidean d,
        ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) ≤
        ∫⁻ x : Euclidean d, ENNReal.ofReal (R x) := by
      exact lintegral_mono hpoint
    _ = ENNReal.ofReal (∫ x : Euclidean d, R x) := by
      symm
      exact ofReal_integral_eq_lintegral_ofReal hRint
        (Filter.Eventually.of_forall hRnonneg)
    _ = ENNReal.ofReal
        (128 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹ *
            (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4) +
          72 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j) ^ 3 *
            (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4)) := by
      congr 1
      dsimp only [R]
      rw [MeasureTheory.integral_add
        (hFinner.const_mul (128 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹))
        (hF'inner.const_mul
          (72 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j) ^ 3)),
        MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul,
        hswapF, hswapF']

/-- A measurable finite quartic lower-integral bound produces an `L⁴`
fourth-root function with the corresponding ordinary fourth-power integral
bound. -/
private theorem memLp_four_and_integral_norm_pow_four_of_measurable_lintegral
    {α : Type*} [MeasurableSpace α] {μ : Measure α}
    (Q : α → ENNReal) (hQmeas : Measurable Q) {K : Real} (hK : 0 ≤ K)
    (hQlin : (∫⁻ x, Q x ∂μ) ≤ ENNReal.ofReal K) :
    MemLp (fun x => (Q x).toReal ^ ((4 : Real)⁻¹)) 4 μ ∧
      (∫ x, ‖(Q x).toReal ^ ((4 : Real)⁻¹)‖ ^ 4 ∂μ) ≤ K := by
  let G : α → Real := fun x => (Q x).toReal ^ ((4 : Real)⁻¹)
  have hQfinite : (∫⁻ x, Q x ∂μ) ≠ ∞ :=
    ne_top_of_le_ne_top ENNReal.ofReal_ne_top hQlin
  have hQint : Integrable (fun x => (Q x).toReal) μ :=
    integrable_toReal_of_lintegral_ne_top hQmeas.aemeasurable hQfinite
  have hGmeas : AEStronglyMeasurable G μ := by
    exact ((Real.continuous_rpow_const (by positivity)).measurable.comp
      hQmeas.ennreal_toReal).aestronglyMeasurable
  have hGpow (x : α) : ‖G x‖ ^ 4 = (Q x).toReal := by
    dsimp only [G]
    rw [Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg ENNReal.toReal_nonneg _),
      ← Real.rpow_natCast,
      ← Real.rpow_mul ENNReal.toReal_nonneg]
    norm_num
  have hGpow' (x : α) : ‖G x‖ ^ (4 : ENNReal).toReal = (Q x).toReal := by
    dsimp only [G]
    change |(Q x).toReal ^ ((4 : Real)⁻¹)| ^ (4 : Real) = (Q x).toReal
    rw [abs_of_nonneg (Real.rpow_nonneg ENNReal.toReal_nonneg _),
      ← Real.rpow_mul ENNReal.toReal_nonneg]
    norm_num
  have hGmem : MemLp G 4 μ := by
    apply (integrable_norm_rpow_iff hGmeas (by norm_num) (by simp)).mp
    rw [show (fun x : α => ‖G x‖ ^ (4 : ENNReal).toReal) =
        fun x => (Q x).toReal by
          funext x
          exact hGpow' x]
    exact hQint
  have hQae : ∀ᵐ x ∂μ, Q x < ∞ := ae_lt_top hQmeas hQfinite
  have hGbound : (∫ x, ‖G x‖ ^ 4 ∂μ) ≤ K := by
    calc
      (∫ x, ‖G x‖ ^ 4 ∂μ) = ∫ x, (Q x).toReal ∂μ := by
        apply MeasureTheory.integral_congr_ae
        filter_upwards with x
        exact hGpow x
      _ = (∫⁻ x, Q x ∂μ).toReal :=
        integral_toReal hQmeas.aemeasurable hQae
      _ ≤ (ENNReal.ofReal K).toReal :=
        (ENNReal.toReal_le_toReal hQfinite ENNReal.ofReal_ne_top).2 hQlin
      _ = K := ENNReal.toReal_ofReal hK
  exact ⟨by simpa only [G] using hGmem, by simpa only [G] using hGbound⟩

/-- A literal fourth-power integral bound controls the extended-real `L⁴`
seminorm. -/
private theorem eLpNorm_four_le_of_memLp_and_integral_norm_pow_four
    {α : Type*} [MeasurableSpace α] {μ : Measure α} {G : α → Real}
    {K : Real} (hGmem : MemLp G 4 μ)
    (hGbound : (∫ x, ‖G x‖ ^ 4 ∂μ) ≤ K) :
    eLpNorm G 4 μ ≤ ENNReal.ofReal (K ^ ((4 : Real)⁻¹)) := by
  rw [hGmem.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
  norm_num
  exact ENNReal.ofReal_le_ofReal
    (Real.rpow_le_rpow (integral_nonneg fun _ => pow_nonneg (abs_nonneg _) _)
      hGbound (by positivity))

/-- On a nonempty compact time interval, the fourth root of the quartic
`ENNReal` maximum is the ordinary `ENNReal` norm maximum. -/
private theorem toReal_iSup_norm_eq_fourthRoot_of_continuous
    {X E : Type*} [TopologicalSpace X] [NormedAddCommGroup E]
    {F : Real → X → E} {a b : Real}
    (hab : a ≤ b) (hF : Continuous (Function.uncurry F)) (x : X) :
    (⨆ r : Icc a b, ENNReal.ofReal ‖F r.1 x‖).toReal =
      ((⨆ r : Icc a b, ENNReal.ofReal (‖F r.1 x‖ ^ 4)).toReal) ^ ((4 : Real)⁻¹) := by
  have hnorm : Continuous (fun r : Real => ‖F r x‖) := by
    exact (hF.comp (continuous_id.prodMk
      (continuous_const : Continuous fun _ : Real => x))).norm
  obtain ⟨r₀, hr₀, hmax⟩ := isCompact_Icc.exists_isMaxOn
    (nonempty_Icc.mpr hab) hnorm.continuousOn
  have hsup :
      (⨆ r : Icc a b, ENNReal.ofReal ‖F r.1 x‖) =
        ENNReal.ofReal ‖F r₀ x‖ := by
    apply le_antisymm
    · apply iSup_le
      intro r
      exact ENNReal.ofReal_le_ofReal (hmax r.2)
    · exact le_iSup (fun r : Icc a b => ENNReal.ofReal ‖F r.1 x‖) ⟨r₀, hr₀⟩
  have hsup_pow :
      (⨆ r : Icc a b, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) =
        ENNReal.ofReal (‖F r₀ x‖ ^ 4) := by
    apply le_antisymm
    · apply iSup_le
      intro r
      exact ENNReal.ofReal_le_ofReal
        (pow_le_pow_left₀ (norm_nonneg _) (hmax r.2) 4)
    · exact le_iSup (fun r : Icc a b => ENNReal.ofReal (‖F r.1 x‖ ^ 4)) ⟨r₀, hr₀⟩
  rw [hsup, hsup_pow, ENNReal.toReal_ofReal (norm_nonneg _),
    ENNReal.toReal_ofReal (pow_nonneg (norm_nonneg _) _), ← Real.rpow_natCast,
    ← Real.rpow_mul (norm_nonneg _)]
  norm_num

/-- On a nonempty compact time interval, the literal real supremum agrees
with the corresponding finite `ENNReal` supremum. -/
private theorem iSup_norm_eq_toReal_iSup_ennreal_norm_of_continuous
    {X E : Type*} [TopologicalSpace X] [NormedAddCommGroup E]
    {F : Real → X → E} {a b : Real}
    (hab : a ≤ b) (hF : Continuous (Function.uncurry F)) (x : X) :
    (⨆ r : Icc a b, ‖F r.1 x‖) =
      (⨆ r : Icc a b, ENNReal.ofReal ‖F r.1 x‖).toReal := by
  letI : Nonempty (Icc a b) := ⟨⟨a, le_rfl, hab⟩⟩
  have hnorm : Continuous (fun r : Real => ‖F r x‖) := by
    exact (hF.comp (continuous_id.prodMk
      (continuous_const : Continuous fun _ : Real => x))).norm
  obtain ⟨r₀, hr₀, hmax⟩ := isCompact_Icc.exists_isMaxOn
    (nonempty_Icc.mpr hab) hnorm.continuousOn
  have hsup : (⨆ r : Icc a b, ‖F r.1 x‖) = ‖F r₀ x‖ := by
    apply le_antisymm
    · apply ciSup_le
      intro r
      exact hmax r.2
    · have hbdd : BddAbove (Set.range fun r : Icc a b => ‖F r.1 x‖) := by
        refine ⟨‖F r₀ x‖, ?_⟩
        rintro _ ⟨r, rfl⟩
        exact hmax r.2
      exact le_ciSup hbdd ⟨r₀, hr₀⟩
  have hsup_ennreal :
      (⨆ r : Icc a b, ENNReal.ofReal ‖F r.1 x‖) =
        ENNReal.ofReal ‖F r₀ x‖ := by
    apply le_antisymm
    · apply iSup_le
      intro r
      exact ENNReal.ofReal_le_ofReal (hmax r.2)
    · exact le_iSup (fun r : Icc a b => ENNReal.ofReal ‖F r.1 x‖) ⟨r₀, hr₀⟩
  rw [hsup, hsup_ennreal, ENNReal.toReal_ofReal (norm_nonneg _)]

/-- The scalar dyadic bookkeeping behind the endpoint-shaped `L⁴` sampling
estimate. -/
private theorem timeSamplingL4_dyadic_rate
    {δ A B E ρ EF ED : Real}
    (hδ : 0 < δ)
    (hFenergy : EF ≤ A * δ ^ (1 + 4 * ρ) * E)
    (hDenergy : ED ≤ B * δ ^ (-3 + 4 * ρ) * E) :
    128 * δ⁻¹ * EF + 72 * δ ^ 3 * ED ≤
      (128 * A + 72 * B) * δ ^ (4 * ρ) * E := by
  have hscaleF : δ⁻¹ * δ ^ (1 + 4 * ρ) = δ ^ (4 * ρ) := by
    rw [← Real.rpow_neg_one δ, ← Real.rpow_add hδ]
    congr 1
    ring
  have hscaleD : δ ^ 3 * δ ^ (-3 + 4 * ρ) = δ ^ (4 * ρ) := by
    rw [← Real.rpow_natCast, ← Real.rpow_add hδ]
    congr 1
    ring
  have hfirst : 128 * δ⁻¹ * EF ≤ 128 * A * δ ^ (4 * ρ) * E := by
    calc
      128 * δ⁻¹ * EF ≤ 128 * δ⁻¹ * (A * δ ^ (1 + 4 * ρ) * E) := by
        exact mul_le_mul_of_nonneg_left hFenergy
          (mul_nonneg (by norm_num) (inv_nonneg.mpr hδ.le))
      _ = 128 * A * δ ^ (4 * ρ) * E := by
        rw [show 128 * δ⁻¹ * (A * δ ^ (1 + 4 * ρ) * E) =
            128 * A * (δ⁻¹ * δ ^ (1 + 4 * ρ)) * E by ring, hscaleF]
  have hsecond : 72 * δ ^ 3 * ED ≤ 72 * B * δ ^ (4 * ρ) * E := by
    calc
      72 * δ ^ 3 * ED ≤ 72 * δ ^ 3 * (B * δ ^ (-3 + 4 * ρ) * E) := by
        exact mul_le_mul_of_nonneg_left hDenergy
          (mul_nonneg (by norm_num) (pow_nonneg hδ.le _))
      _ = 72 * B * δ ^ (4 * ρ) * E := by
        rw [show 72 * δ ^ 3 * (B * δ ^ (-3 + 4 * ρ) * E) =
            72 * B * (δ ^ 3 * δ ^ (-3 + 4 * ρ)) * E by ring, hscaleD]
  calc
    128 * δ⁻¹ * EF + 72 * δ ^ 3 * ED ≤
        128 * A * δ ^ (4 * ρ) * E + 72 * B * δ ^ (4 * ρ) * E :=
      add_le_add hfirst hsecond
    _ = (128 * A + 72 * B) * δ ^ (4 * ρ) * E := by ring

/-- Factor the fourth root of the sampled quartic energy into the local
smoothing gain and the input energy. -/
private theorem timeSamplingL4_dyadic_rate_fourth_root
    {δ A B E ρ : Real}
    (hδ : 0 < δ) (hA : 0 ≤ A) (hB : 0 ≤ B) (hE : 0 ≤ E) :
    ((128 * A + 72 * B) * δ ^ (4 * ρ) * E) ^ ((4 : Real)⁻¹) =
      (128 * A + 72 * B) ^ ((4 : Real)⁻¹) * δ ^ ρ * E ^ ((4 : Real)⁻¹) := by
  have hAB : 0 ≤ 128 * A + 72 * B := by positivity
  have hδpow : 0 ≤ δ ^ (4 * ρ) := Real.rpow_nonneg hδ.le _
  rw [Real.mul_rpow (mul_nonneg hAB hδpow) hE,
    Real.mul_rpow hAB hδpow, ← Real.rpow_mul hδ.le]
  congr 1
  ring_nf

/-- Literal dyadic `L⁴` product-energy estimates for a jointly continuous
time family and its derivative yield a real time-maximal `L⁴` bound.  The
two energy exponents are exactly those produced by an endpoint stationary
normalization and one time derivative; the resulting maximal gain is
`(dyadicTimeScale j) ^ ρ`. -/
theorem memLp_four_and_eLpNorm_iSup_timeSamplingL4_of_dyadic_energy
    {d : Nat} {F F' : Real → Euclidean d → Complex}
    (j : Nat) (T : Finset Real)
    (hT : _root_.Auto.Spherical.MSSBase.MaximalSeparated j T)
    (hF : Continuous (Function.uncurry F))
    (hF' : Continuous (Function.uncurry F'))
    (hderiv : ∀ t x, HasDerivAt (fun s => F s x) (F' t x) t)
    (hFspace : Integrable (fun p : Real × Euclidean d => ‖F p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume))
    (hF'space : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume))
    {A B E ρ : Real} (hA : 0 ≤ A) (hB : 0 ≤ B) (hE : 0 ≤ E)
    (hFenergy :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4) ≤
        A * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j) ^ (1 + 4 * ρ) * E)
    (hF'energy :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4) ≤
        B * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j) ^ (-3 + 4 * ρ) * E) :
    MemLp (fun x : Euclidean d =>
      ⨆ r : Icc (1 : Real) 2, ‖F r.1 x‖) 4 volume ∧
      eLpNorm (fun x : Euclidean d =>
        ⨆ r : Icc (1 : Real) 2, ‖F r.1 x‖) 4 volume ≤
        ENNReal.ofReal
          ((128 * A + 72 * B) ^ ((4 : Real)⁻¹) *
            (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j) ^ ρ * E ^ ((4 : Real)⁻¹)) := by
  let δ : Real := _root_.Auto.Spherical.MSSBase.dyadicTimeScale j
  let Q : Euclidean d → ENNReal := fun x =>
    ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)
  let K : Real := (128 * A + 72 * B) * δ ^ (4 * ρ) * E
  have hδ : 0 < δ := by
    dsimp only [δ, _root_.Auto.Spherical.MSSBase.dyadicTimeScale]
    exact zpow_pos (by norm_num) _
  have hQ := measurable_and_lintegral_iSup_ennreal_norm_pow_four_le_timeSamplingL4
    j T hT hF hF' hderiv hFspace hF'space
  have hQmeas : Measurable Q := by
    simpa only [Q] using hQ.1
  have hrawrate :
      128 * δ⁻¹ * (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4) +
        72 * δ ^ 3 * (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4) ≤ K := by
    simpa only [δ, K] using
      (timeSamplingL4_dyadic_rate (δ := δ) hδ hFenergy hF'energy)
  have hQlin : (∫⁻ x : Euclidean d, Q x) ≤ ENNReal.ofReal K := by
    refine hQ.2.trans (ENNReal.ofReal_le_ofReal ?_)
    simpa only [δ] using hrawrate
  have hK : 0 ≤ K := by
    dsimp only [K]
    exact mul_nonneg
      (mul_nonneg (by positivity) (Real.rpow_nonneg hδ.le _)) hE
  have hroot := memLp_four_and_integral_norm_pow_four_of_measurable_lintegral
    Q hQmeas hK hQlin
  have hnorm := eLpNorm_four_le_of_memLp_and_integral_norm_pow_four
    hroot.1 hroot.2
  have hfactor := timeSamplingL4_dyadic_rate_fourth_root
    (δ := δ) (ρ := ρ) hδ hA hB hE
  have hnorm' :
      eLpNorm (fun x : Euclidean d => (Q x).toReal ^ ((4 : Real)⁻¹)) 4 volume ≤
        ENNReal.ofReal
          ((128 * A + 72 * B) ^ ((4 : Real)⁻¹) * δ ^ ρ * E ^ ((4 : Real)⁻¹)) := by
    calc
      eLpNorm (fun x : Euclidean d => (Q x).toReal ^ ((4 : Real)⁻¹)) 4 volume ≤
          ENNReal.ofReal (K ^ ((4 : Real)⁻¹)) := hnorm
      _ = ENNReal.ofReal
          ((128 * A + 72 * B) ^ ((4 : Real)⁻¹) * δ ^ ρ * E ^ ((4 : Real)⁻¹)) := by
        exact congrArg ENNReal.ofReal (by
          simpa only [K] using hfactor)
  have heq : (fun x : Euclidean d =>
      ⨆ r : Icc (1 : Real) 2, ‖F r.1 x‖) =
      fun x : Euclidean d =>
        ((⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)).toReal) ^
          ((4 : Real)⁻¹) := by
    funext x
    calc
      (⨆ r : Icc (1 : Real) 2, ‖F r.1 x‖) =
          (⨆ r : Icc (1 : Real) 2, ENNReal.ofReal ‖F r.1 x‖).toReal :=
        iSup_norm_eq_toReal_iSup_ennreal_norm_of_continuous
          (F := F) (a := (1 : Real)) (b := 2) (by norm_num) hF x
      _ = _ :=
        toReal_iSup_norm_eq_fourthRoot_of_continuous
          (F := F) (a := (1 : Real)) (b := 2) (by norm_num) hF x
  rw [heq]
  constructor
  · simpa only [Q] using hroot.1
  · simpa only [Q, δ] using hnorm'

/-- The finite `L²` space-time sampling estimate for the actual separated
time sets used by MSS.  The hypotheses record precisely what is needed to
apply Fubini at a finite collection of individual time slices: product
integrability on the unit slab and integrability at every sampled time. -/
theorem timeSamplingL2_spacetime_of_MSS_MaximalSeparated
    {d : Nat} {F F' : Real → Euclidean d → Complex}
    (j : Nat) (T : Finset Real)
    (hT : _root_.Auto.Spherical.MSSBase.MaximalSeparated j T)
    (hF_cont : ∀ x, Continuous (fun t => F t x))
    (hF'_cont : ∀ x, Continuous (fun t => F' t x))
    (hderiv : ∀ x t, HasDerivAt (fun s => F s x) (F' t x) t)
    (hFslice : ∀ t ∈ T, Integrable (fun x => ‖F t x‖ ^ 2) volume)
    (hFspace : Integrable (fun p : Real × Euclidean d => ‖F p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume))
    (hF'space : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume)) :
    (∑ t ∈ T, ∫ x : Euclidean d, ‖F t x‖ ^ 2) ≤
      4 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹ *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 2) +
        2 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 2) := by
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  have hFinner : Integrable (fun x : Euclidean d =>
      ∫ t in (1 : Real)..2, ‖F t x‖ ^ 2) volume := by
    have hG : Integrable (fun x : Euclidean d =>
        ∫ t : Real, ‖F t x‖ ^ 2 ∂ν) volume := by
      simpa only [ν] using hFspace.integral_prod_right
    have heq : (fun x : Euclidean d =>
        ∫ t in (1 : Real)..2, ‖F t x‖ ^ 2) =
        fun x => ∫ t : Real, ‖F t x‖ ^ 2 ∂ν := by
      funext x
      simp only [ν]
      rw [intervalIntegral.integral_of_le (by norm_num), ← integral_Icc_eq_integral_Ioc]
    rw [heq]
    exact hG
  have hF'inner : Integrable (fun x : Euclidean d =>
      ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 2) volume := by
    have hG : Integrable (fun x : Euclidean d =>
        ∫ t : Real, ‖F' t x‖ ^ 2 ∂ν) volume := by
      simpa only [ν] using hF'space.integral_prod_right
    have heq : (fun x : Euclidean d =>
        ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 2) =
        fun x => ∫ t : Real, ‖F' t x‖ ^ 2 ∂ν := by
      funext x
      simp only [ν]
      rw [intervalIntegral.integral_of_le (by norm_num), ← integral_Icc_eq_integral_Ioc]
    rw [heq]
    exact hG
  let H : Euclidean d → Real := fun x => ∑ t ∈ T, ‖F t x‖ ^ 2
  have hH : Integrable H volume := by
    dsimp only [H]
    exact integrable_finsetSum T fun t ht => hFslice t ht
  have hright : Integrable (fun x : Euclidean d =>
      4 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹ *
          (∫ t in (1 : Real)..2, ‖F t x‖ ^ 2) +
        2 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j *
          (∫ t in (1 : Real)..2, ‖F' t x‖ ^ 2)) volume := by
    exact (hFinner.const_mul
      (4 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹)).add
      (hF'inner.const_mul
        (2 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j))
  have hpoint (x : Euclidean d) : H x ≤
      4 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹ *
          (∫ t in (1 : Real)..2, ‖F t x‖ ^ 2) +
        2 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j *
          (∫ t in (1 : Real)..2, ‖F' t x‖ ^ 2) := by
    dsimp only [H]
    exact timeSamplingL2_of_MSS_MaximalSeparated j T hT
      (hF_cont x) (hF'_cont x) (fun t => hderiv x t)
  have hFswap :
      (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F t x‖ ^ 2) =
        ∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 2 := by
    have hFuIoc : Integrable (fun p : Real × Euclidean d => ‖F p.1 p.2‖ ^ 2)
        ((volume.restrict (uIoc (1 : Real) 2)).prod volume) := by
      rw [uIoc_of_le (by norm_num), restrict_Ioc_eq_restrict_Icc]
      exact hFspace
    exact (intervalIntegral_integral_swap
      (f := fun t (x : Euclidean d) => ‖F t x‖ ^ 2) hFuIoc).symm
  have hF'swap :
      (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 2) =
        ∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 2 := by
    have hF'uIoc : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 2)
        ((volume.restrict (uIoc (1 : Real) 2)).prod volume) := by
      rw [uIoc_of_le (by norm_num), restrict_Ioc_eq_restrict_Icc]
      exact hF'space
    exact (intervalIntegral_integral_swap
      (f := fun t (x : Euclidean d) => ‖F' t x‖ ^ 2) hF'uIoc).symm
  calc
    (∑ t ∈ T, ∫ x : Euclidean d, ‖F t x‖ ^ 2) = ∫ x : Euclidean d, H x := by
      symm
      simpa only [H] using (integral_finsetSum T fun t ht => hFslice t ht)
    _ ≤ ∫ x : Euclidean d,
        4 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹ *
            (∫ t in (1 : Real)..2, ‖F t x‖ ^ 2) +
          2 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j *
            (∫ t in (1 : Real)..2, ‖F' t x‖ ^ 2) := by
      apply integral_mono_ae hH hright
      exact Filter.Eventually.of_forall hpoint
    _ = 4 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹ *
          (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F t x‖ ^ 2) +
        2 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j *
          (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 2) := by
      rw [MeasureTheory.integral_add
        (hFinner.const_mul (4 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹))
        (hF'inner.const_mul (2 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j)),
        MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul]
    _ = 4 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹ *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 2) +
        2 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 2) := by
      rw [hFswap, hF'swap]

/-- Extended-real supremum form of the proved `L²` time Sobolev estimate. -/
theorem timeSupremumL2
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    {F F' : ℝ → E} {a b : ℝ} (hab : a < b)
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ t, HasDerivAt F (F' t) t) :
    (⨆ r : Icc a b, ENNReal.ofReal (‖F r.1‖ ^ 2)) ≤
      ENNReal.ofReal
        (2 * (b - a)⁻¹ * (∫ t in a..b, ‖F t‖ ^ 2) +
          2 * (b - a) * (∫ t in a..b, ‖F' t‖ ^ 2)) := by
  apply iSup_le
  intro r
  exact ENNReal.ofReal_le_ofReal (timeSobolevL2 hab r.2 hF hF' hderiv)

/-- The dyadic MSS time scale is the reciprocal of the corresponding
positive natural dyadic power. -/
theorem dyadicTimeScale_eq_inv_natPow (j : Nat) :
    _root_.Auto.Spherical.MSSBase.dyadicTimeScale j =
      ((2 ^ j : Nat) : Real)⁻¹ := by
  rw [_root_.Auto.Spherical.MSSBase.dyadicTimeScale, zpow_neg, zpow_natCast]
  congr 1
  norm_cast

/-- The explicit dyadic grid used to witness finite maximal separation. -/
noncomputable def aux_dyadicTimeGrid (j : Nat) : Finset Real :=
  (Finset.range (2 ^ j + 1)).image
    (fun k : Nat => 1 + (k : Real) * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j)

/-- Every MSS dyadic time scale has a literal finite maximal separated
family.  The grid has exactly the natural mesh `2⁻ʲ`, and the floor map
provides the strict covering clause at every point of the unit time slab. -/
theorem exists_MSS_MaximalSeparated (j : Nat) :
    ∃ T : Finset Real, _root_.Auto.Spherical.MSSBase.MaximalSeparated j T := by
  let n : Nat := 2 ^ j
  let δ : Real := _root_.Auto.Spherical.MSSBase.dyadicTimeScale j
  let g : Nat → Real := fun k => 1 + (k : Real) * δ
  refine ⟨aux_dyadicTimeGrid j, ?_⟩
  have hδ : 0 < δ := by
    dsimp only [δ, _root_.Auto.Spherical.MSSBase.dyadicTimeScale]
    exact zpow_pos (by norm_num) _
  have hnpos : 0 < n := by
    dsimp only [n]
    positivity
  have hnreal : 0 < (n : Real) := by exact_mod_cast hnpos
  have hδeq : δ = (n : Real)⁻¹ := by
    dsimp only [δ, n]
    exact dyadicTimeScale_eq_inv_natPow j
  have hndelta : (n : Real) * δ = 1 := by
    rw [hδeq]
    field_simp
  have hgrid : aux_dyadicTimeGrid j =
      (Finset.range (n + 1)).image g := by
    rfl
  rw [hgrid]
  constructor
  · intro t ht
    rcases Finset.mem_image.mp ht with ⟨k, hk, rfl⟩
    have hk' : k ≤ n := Nat.le_of_lt_succ (Finset.mem_range.mp hk)
    constructor
    · dsimp only [g]
      have hk0 : (0 : Real) ≤ k := by positivity
      nlinarith [mul_nonneg hk0 hδ.le]
    · dsimp only [g]
      have hkn : (k : Real) ≤ n := by exact_mod_cast hk'
      have hmul := mul_le_mul_of_nonneg_right hkn hδ.le
      nlinarith [hndelta]
  constructor
  · intro s hs t ht hst
    rcases Finset.mem_image.mp hs with ⟨k, hk, hks⟩
    rcases Finset.mem_image.mp ht with ⟨l, hl, hlt⟩
    subst s
    subst t
    have hkl : k ≠ l := by
      intro h
      subst l
      exact hst rfl
    rcases lt_or_gt_of_ne hkl with hkl_lt | hlk_lt
    · have hcast : (k : Real) + 1 ≤ (l : Real) := by
        exact_mod_cast (Nat.succ_le_iff.mpr hkl_lt)
      have hmul := mul_le_mul_of_nonneg_right hcast hδ.le
      have hnonpos :
          1 + (k : Real) * δ - (1 + (l : Real) * δ) ≤ 0 := by
        nlinarith
      rw [abs_of_nonpos hnonpos]
      nlinarith
    · have hcast : (l : Real) + 1 ≤ (k : Real) := by
        exact_mod_cast (Nat.succ_le_iff.mpr hlk_lt)
      have hmul := mul_le_mul_of_nonneg_right hcast hδ.le
      have hnonneg :
          0 ≤ 1 + (k : Real) * δ - (1 + (l : Real) * δ) := by
        nlinarith
      rw [abs_of_nonneg hnonneg]
      nlinarith
  · intro t ht
    let q : Real := (t - 1) / δ
    let k : Nat := ⌊q⌋₊
    have hqnonneg : 0 ≤ q := by
      dsimp only [q]
      exact div_nonneg (by linarith [ht.1]) hδ.le
    have hqmul : q * δ = t - 1 := by
      dsimp only [q]
      field_simp [ne_of_gt hδ]
    have hqle : q ≤ (n : Real) := by
      rw [show q = (t - 1) / δ by rfl, div_le_iff₀ hδ]
      nlinarith [hndelta, ht.2]
    have hq_lt : q < (n + 1 : Nat) := by
      have hlt : (n : Real) < (n + 1 : Nat) := by norm_num
      exact lt_of_le_of_lt hqle hlt
    have hk_mem : k ∈ Finset.range (n + 1) := by
      apply Finset.mem_range.mpr
      exact (Nat.floor_lt hqnonneg).mpr hq_lt
    refine ⟨g k, Finset.mem_image.mpr ⟨k, hk_mem, rfl⟩, ?_⟩
    have hfloor_le : (k : Real) ≤ q := Nat.floor_le hqnonneg
    have hfloor_lt : q < (k : Real) + 1 := Nat.lt_floor_add_one q
    have hmul_le := mul_le_mul_of_nonneg_right hfloor_le hδ.le
    have hmul_lt := mul_lt_mul_of_pos_right hfloor_lt hδ
    have hnonneg : 0 ≤ t - g k := by
      dsimp only [g]
      nlinarith [hqmul]
    have hlt : t - g k < δ := by
      dsimp only [g]
      nlinarith [hqmul]
    rw [abs_of_nonneg hnonneg]
    exact hlt

/-- The square of the time increment is controlled by the interval length
times the derivative energy on any ambient interval containing both times. -/
theorem norm_sub_sq_le_abs_sub_mul_timeDerivativeEnergy
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E] [CompleteSpace E]
    {F F' : Real → E} {a b r s : Real} (_hab : a ≤ b)
    (hr : r ∈ Icc a b) (hs : s ∈ Icc a b)
    (hF' : Continuous F')
    (hderiv : ∀ t, HasDerivAt F (F' t) t) :
    ‖F r - F s‖ ^ 2 ≤ |r - s| * (∫ t in a..b, ‖F' t‖ ^ 2) := by
  have hnonneg : 0 ≤ᵐ[volume.restrict (Ioc a b)] fun t => ‖F' t‖ ^ 2 :=
    Filter.Eventually.of_forall fun _ => sq_nonneg _
  have hint : IntervalIntegrable (fun t => ‖F' t‖ ^ 2) volume a b :=
    ((continuous_norm.comp hF').pow 2).intervalIntegrable a b
  rcases le_total r s with hrs | hsr
  · have hftc : ∫ t in r..s, F' t = F s - F r := by
      apply intervalIntegral.integral_eq_sub_of_hasDerivAt
      · intro t _
        exact hderiv t
      · exact hF'.intervalIntegrable r s
    have hdiff : ‖F r - F s‖ ≤ ∫ t in r..s, ‖F' t‖ := by
      rw [norm_sub_rev, ← hftc]
      exact intervalIntegral.norm_integral_le_integral_norm hrs
    have hlocalnonneg : 0 ≤ ∫ t in r..s, ‖F' t‖ :=
      intervalIntegral.integral_nonneg hrs fun _ _ => norm_nonneg _
    have hsq : ‖F r - F s‖ ^ 2 ≤ (∫ t in r..s, ‖F' t‖) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) hlocalnonneg).2 hdiff
    have hcs :=
      _root_.Auto.Spherical.Auxiliary.intervalIntegral_norm_sq_le_length_mul_intervalIntegral_norm_sq
        hrs hF'
    have hmono : (∫ t in r..s, ‖F' t‖ ^ 2) ≤ ∫ t in a..b, ‖F' t‖ ^ 2 :=
      intervalIntegral.integral_mono_interval hr.1 hrs hs.2 hnonneg hint
    calc
      ‖F r - F s‖ ^ 2 ≤ (∫ t in r..s, ‖F' t‖) ^ 2 := hsq
      _ ≤ (s - r) * (∫ t in r..s, ‖F' t‖ ^ 2) := hcs
      _ ≤ (s - r) * (∫ t in a..b, ‖F' t‖ ^ 2) := by
        gcongr
      _ = |r - s| * (∫ t in a..b, ‖F' t‖ ^ 2) := by
        rw [abs_of_nonpos (sub_nonpos.mpr hrs)]
        ring
  · have hftc : ∫ t in s..r, F' t = F r - F s := by
      apply intervalIntegral.integral_eq_sub_of_hasDerivAt
      · intro t _
        exact hderiv t
      · exact hF'.intervalIntegrable s r
    have hdiff : ‖F r - F s‖ ≤ ∫ t in s..r, ‖F' t‖ := by
      rw [← hftc]
      exact intervalIntegral.norm_integral_le_integral_norm hsr
    have hlocalnonneg : 0 ≤ ∫ t in s..r, ‖F' t‖ :=
      intervalIntegral.integral_nonneg hsr fun _ _ => norm_nonneg _
    have hsq : ‖F r - F s‖ ^ 2 ≤ (∫ t in s..r, ‖F' t‖) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) hlocalnonneg).2 hdiff
    have hcs :=
      _root_.Auto.Spherical.Auxiliary.intervalIntegral_norm_sq_le_length_mul_intervalIntegral_norm_sq
        hsr hF'
    have hmono : (∫ t in s..r, ‖F' t‖ ^ 2) ≤ ∫ t in a..b, ‖F' t‖ ^ 2 :=
      intervalIntegral.integral_mono_interval hs.1 hsr hr.2 hnonneg hint
    calc
      ‖F r - F s‖ ^ 2 ≤ (∫ t in s..r, ‖F' t‖) ^ 2 := hsq
      _ ≤ (r - s) * (∫ t in s..r, ‖F' t‖ ^ 2) := hcs
      _ ≤ (r - s) * (∫ t in a..b, ‖F' t‖ ^ 2) := by
        gcongr
      _ = |r - s| * (∫ t in a..b, ‖F' t‖ ^ 2) := by
        rw [abs_of_nonneg (sub_nonneg.mpr hsr)]

/-- A finite maximal separated family reduces the genuine supremum over the
unit time slab to its sampled values and a mesh-sized derivative energy. -/
theorem timeSupremumL2_of_MSS_MaximalSeparated
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E] [CompleteSpace E]
    {F F' : Real → E} (j : Nat) (T : Finset Real)
    (hT : _root_.Auto.Spherical.MSSBase.MaximalSeparated j T)
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ t, HasDerivAt F (F' t) t) :
    (⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1‖ ^ 2)) ≤
      ENNReal.ofReal
        (8 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹ *
            (∫ t in (1 : Real)..2, ‖F t‖ ^ 2) +
          6 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j *
            (∫ t in (1 : Real)..2, ‖F' t‖ ^ 2)) := by
  let δ : Real := _root_.Auto.Spherical.MSSBase.dyadicTimeScale j
  let A : Real := ∫ t in (1 : Real)..2, ‖F t‖ ^ 2
  let D : Real := ∫ t in (1 : Real)..2, ‖F' t‖ ^ 2
  let S : Real := ∑ t ∈ T, ‖F t‖ ^ 2
  have hδ : 0 < δ := by
    dsimp only [δ, _root_.Auto.Spherical.MSSBase.dyadicTimeScale]
    exact zpow_pos (by norm_num) _
  have hA : 0 ≤ A := by
    dsimp only [A]
    exact intervalIntegral.integral_nonneg (by norm_num) fun _ _ => sq_nonneg _
  have hD : 0 ≤ D := by
    dsimp only [D]
    exact intervalIntegral.integral_nonneg (by norm_num) fun _ _ => sq_nonneg _
  have hsample : S ≤ 4 * δ⁻¹ * A + 2 * δ * D := by
    dsimp only [S, A, D, δ]
    exact timeSamplingL2_of_MSS_MaximalSeparated j T hT hF hF' hderiv
  have hcombined : 2 * S + 2 * δ * D ≤ 8 * δ⁻¹ * A + 6 * δ * D := by
    calc
      2 * S + 2 * δ * D ≤ 2 * (4 * δ⁻¹ * A + 2 * δ * D) + 2 * δ * D := by
        gcongr
      _ = 8 * δ⁻¹ * A + 6 * δ * D := by ring
  apply iSup_le
  intro r
  rcases hT.2.2 r r.2 with ⟨s, hs, hrs⟩
  have hinc : ‖F r.1 - F s‖ ^ 2 ≤ δ * D := by
    have h := norm_sub_sq_le_abs_sub_mul_timeDerivativeEnergy
      (F := F) (F' := F') (a := (1 : Real)) (b := 2) (r := r.1) (s := s)
      (by norm_num) r.2 (hT.1 s hs) hF' hderiv
    calc
      ‖F r.1 - F s‖ ^ 2 ≤ |r.1 - s| * D := by
        simpa only [D] using h
      _ ≤ δ * D := by
        exact mul_le_mul_of_nonneg_right (le_of_lt hrs) hD
  have hnorm : ‖F r.1‖ ≤ ‖F r.1 - F s‖ + ‖F s‖ := by
    calc
      ‖F r.1‖ = ‖(F r.1 - F s) + F s‖ := by rw [sub_add_cancel]
      _ ≤ _ := norm_add_le _ _
  have hsum_nonneg : 0 ≤ ‖F r.1 - F s‖ + ‖F s‖ :=
    add_nonneg (norm_nonneg _) (norm_nonneg _)
  have hnormsq : ‖F r.1‖ ^ 2 ≤
      2 * ‖F s‖ ^ 2 + 2 * ‖F r.1 - F s‖ ^ 2 := by
    have hsq : ‖F r.1‖ ^ 2 ≤ (‖F r.1 - F s‖ + ‖F s‖) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) hsum_nonneg).2 hnorm
    calc
      ‖F r.1‖ ^ 2 ≤ (‖F r.1 - F s‖ + ‖F s‖) ^ 2 := hsq
      _ ≤ 2 * ‖F s‖ ^ 2 + 2 * ‖F r.1 - F s‖ ^ 2 := by
        nlinarith [sq_nonneg (‖F r.1 - F s‖ - ‖F s‖)]
  have hsS : ‖F s‖ ^ 2 ≤ S := by
    dsimp only [S]
    exact Finset.single_le_sum (fun t _ => sq_nonneg (‖F t‖)) hs
  have hpoint : ‖F r.1‖ ^ 2 ≤ 2 * S + 2 * δ * D := by
    calc
      ‖F r.1‖ ^ 2 ≤ 2 * ‖F s‖ ^ 2 + 2 * ‖F r.1 - F s‖ ^ 2 := hnormsq
      _ ≤ 2 * S + 2 * δ * D := by
        apply add_le_add
        · exact mul_le_mul_of_nonneg_left hsS (by norm_num)
        · calc
            2 * ‖F r.1 - F s‖ ^ 2 ≤ 2 * (δ * D) :=
              mul_le_mul_of_nonneg_left hinc (by norm_num)
            _ = 2 * δ * D := by ring
  exact ENNReal.ofReal_le_ofReal (hpoint.trans hcombined)

/-- The measurable space-time form of scale-sensitive time sampling.  It
controls the actual continuous time supremum by product energies, while the
finite separated family is used only inside the proved scalar reduction. -/
theorem measurable_and_lintegral_iSup_ennreal_norm_sq_le_timeSamplingL2
    {d : Nat} {F F' : Real → Euclidean d → Complex}
    (j : Nat) (T : Finset Real)
    (hT : _root_.Auto.Spherical.MSSBase.MaximalSeparated j T)
    (hF : Continuous (Function.uncurry F))
    (hF' : Continuous (Function.uncurry F'))
    (hderiv : ∀ t x, HasDerivAt (fun s => F s x) (F' t x) t)
    (hFspace : Integrable (fun p : Real × Euclidean d => ‖F p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume))
    (hF'space : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume)) :
    Measurable (fun x : Euclidean d =>
      ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 2)) ∧
      (∫⁻ x : Euclidean d,
        ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 2)) ≤
        ENNReal.ofReal
          (8 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹ *
              (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 2) +
            6 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j *
              (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 2)) := by
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  have hmaxmeas : Measurable (fun x : Euclidean d =>
      ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 2)) := by
    have hG : Measurable (⨆ r : Icc (1 : Real) 2, fun x : Euclidean d =>
        ENNReal.ofReal (‖F r.1 x‖ ^ 2)) := by
      apply measurable_iSup_of_lowerSemicontinuous
      · intro r
        exact (ENNReal.continuous_ofReal.comp
          ((hF.comp (continuous_const.prodMk continuous_id)).norm.pow 2)).measurable
      · intro x
        exact (ENNReal.continuous_ofReal.comp
          ((hF.comp (continuous_subtype_val.prodMk continuous_const)).norm.pow 2)).lowerSemicontinuous
    have hEq : (fun x : Euclidean d =>
        ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 2)) =
        ⨆ r : Icc (1 : Real) 2, fun x : Euclidean d =>
          ENNReal.ofReal (‖F r.1 x‖ ^ 2) := by
      funext x
      exact (iSup_apply
        (f := fun r : Icc (1 : Real) 2 => fun x : Euclidean d =>
          ENNReal.ofReal (‖F r.1 x‖ ^ 2)) (a := x)).symm
    rw [hEq]
    exact hG
  refine ⟨hmaxmeas, ?_⟩
  have hFinner : Integrable (fun x : Euclidean d =>
      ∫ t in (1 : Real)..2, ‖F t x‖ ^ 2) volume := by
    have hG : Integrable (fun x : Euclidean d =>
        ∫ t : Real, ‖F t x‖ ^ 2 ∂ν) volume := by
      simpa only [ν] using hFspace.integral_prod_right
    have heq : (fun x : Euclidean d =>
        ∫ t in (1 : Real)..2, ‖F t x‖ ^ 2) =
        fun x => ∫ t : Real, ‖F t x‖ ^ 2 ∂ν := by
      funext x
      simp only [ν]
      rw [intervalIntegral.integral_of_le (by norm_num), ← integral_Icc_eq_integral_Ioc]
    rw [heq]
    exact hG
  have hF'inner : Integrable (fun x : Euclidean d =>
      ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 2) volume := by
    have hG : Integrable (fun x : Euclidean d =>
        ∫ t : Real, ‖F' t x‖ ^ 2 ∂ν) volume := by
      simpa only [ν] using hF'space.integral_prod_right
    have heq : (fun x : Euclidean d =>
        ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 2) =
        fun x => ∫ t : Real, ‖F' t x‖ ^ 2 ∂ν := by
      funext x
      simp only [ν]
      rw [intervalIntegral.integral_of_le (by norm_num), ← integral_Icc_eq_integral_Ioc]
    rw [heq]
    exact hG
  let R : Euclidean d → Real := fun x =>
    8 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹ *
        (∫ t in (1 : Real)..2, ‖F t x‖ ^ 2) +
      6 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j *
        (∫ t in (1 : Real)..2, ‖F' t x‖ ^ 2)
  have hRint : Integrable R volume := by
    exact (hFinner.const_mul
      (8 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹)).add
      (hF'inner.const_mul
        (6 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j))
  have hRnonneg (x : Euclidean d) : 0 ≤ R x := by
    dsimp only [R]
    have hscale : 0 < _root_.Auto.Spherical.MSSBase.dyadicTimeScale j := by
      dsimp only [_root_.Auto.Spherical.MSSBase.dyadicTimeScale]
      exact zpow_pos (by norm_num) _
    apply add_nonneg
    · exact mul_nonneg
        (mul_nonneg (by norm_num) (inv_nonneg.mpr hscale.le))
        (intervalIntegral.integral_nonneg (by norm_num) fun _ _ => sq_nonneg _)
    · exact mul_nonneg
        (mul_nonneg (by norm_num) hscale.le)
        (intervalIntegral.integral_nonneg (by norm_num) fun _ _ => sq_nonneg _)
  have hpoint (x : Euclidean d) :
      (⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 2)) ≤
        ENNReal.ofReal (R x) := by
    exact timeSupremumL2_of_MSS_MaximalSeparated j T hT
      (hF.comp (continuous_id.prodMk
        (continuous_const : Continuous fun _ : Real => x)))
      (hF'.comp (continuous_id.prodMk
        (continuous_const : Continuous fun _ : Real => x)))
      (fun t => hderiv t x)
  have hswapF :
      (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F t x‖ ^ 2) =
        ∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 2 := by
    have hFuIoc : Integrable (fun p : Real × Euclidean d => ‖F p.1 p.2‖ ^ 2)
        ((volume.restrict (uIoc (1 : Real) 2)).prod volume) := by
      rw [uIoc_of_le (by norm_num), restrict_Ioc_eq_restrict_Icc]
      exact hFspace
    exact (intervalIntegral_integral_swap
      (f := fun t (x : Euclidean d) => ‖F t x‖ ^ 2) hFuIoc).symm
  have hswapF' :
      (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 2) =
        ∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 2 := by
    have hF'uIoc : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 2)
        ((volume.restrict (uIoc (1 : Real) 2)).prod volume) := by
      rw [uIoc_of_le (by norm_num), restrict_Ioc_eq_restrict_Icc]
      exact hF'space
    exact (intervalIntegral_integral_swap
      (f := fun t (x : Euclidean d) => ‖F' t x‖ ^ 2) hF'uIoc).symm
  calc
    (∫⁻ x : Euclidean d,
        ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 2)) ≤
        ∫⁻ x : Euclidean d, ENNReal.ofReal (R x) := by
      exact lintegral_mono hpoint
    _ = ENNReal.ofReal (∫ x : Euclidean d, R x) := by
      symm
      exact ofReal_integral_eq_lintegral_ofReal hRint
        (Filter.Eventually.of_forall hRnonneg)
    _ = ENNReal.ofReal
        (8 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹ *
            (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 2) +
          6 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j *
            (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 2)) := by
      congr 1
      dsimp only [R]
      rw [MeasureTheory.integral_add
        (hFinner.const_mul (8 * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j)⁻¹))
        (hF'inner.const_mul
          (6 * _root_.Auto.Spherical.MSSBase.dyadicTimeScale j)),
        MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul,
        hswapF, hswapF']

/-- The sharp stationary estimates for the planar surface Fourier transform
are already available from the circle calculation.  This is the Fourier-side
input for the high-frequency circular argument. -/
theorem circleStationaryPhase : HasCircleSurfaceFourierSharpBounds :=
  hasCircleSurfaceFourierSharpBounds

/-- The literal middle-meridian term in the coordinate circle decomposition
has the expected nonstationary inverse-frequency decay.  This keeps the
remainder quantitative rather than treating it as an unnamed error term. -/
theorem exists_circleMiddleMeridianLocalizedIntegral_decay_one :
    ∃ C : Real, 0 < C ∧ ∀ l : Real, 1 ≤ |l| →
      ‖Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianLocalizedIntegral
        0 l‖ ≤ C / |l| :=
  Auto.Spherical.FractalDilations.Auxiliary.exists_coordinateMiddleMeridianLocalizedIntegral_decay_one 0

/-- Exact angular-meridian normal form for the planar surface Fourier factor.
This is the source-checked Fourier-side decomposition available independently
of the endpoint-amplitude construction. -/
theorem circleSurfaceFourierMeridianNormalForm (xi : Euclidean 2) :
    surfaceFourier 2 xi =
      (surfaceMass 1 : Complex) *
        ∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
          Auto.Spherical.SurfaceMeasureDecay.circleMeridianPhase
            (2 * Real.pi * ‖xi‖) theta :=
  Auto.Spherical.SurfaceMeasureDecay.surfaceFourier_two_meridian xi

/-- Exact outgoing, incoming, and middle coordinate-wave decomposition of
the planar surface Fourier factor.  The endpoint factors are the literal
compact quadratic symbols whose stationary estimates were proved in the
planar stationary-phase foundation; the middle term remains literal for the
subsequent nonstationary analysis. -/
theorem circleSurfaceFourierCoordinateWaveDecomposition (xi : Euclidean 2) :
    surfaceFourier 2 xi =
      (surfaceMass 1 : Complex) *
        (Complex.exp (((-(2 * Real.pi * ‖xi‖) : Real) : Complex) * Complex.I) *
            Auto.Spherical.FractalDilations.Auxiliary.planarEndpointQuadraticIntegral
              (2 * Real.pi * ‖xi‖) +
          Complex.exp (((2 * Real.pi * ‖xi‖ : Real) : Complex) * Complex.I) *
            Auto.Spherical.FractalDilations.Auxiliary.planarEndpointQuadraticIntegral
              (-(2 * Real.pi * ‖xi‖)) +
          Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianLocalizedIntegral
            0 (2 * Real.pi * ‖xi‖)) := by
  exact Auto.Spherical.FractalDilations.Auxiliary.surfaceFourier_two_eq_coordinatePlanarSmoothWaves xi

/-- Exact frequency-localized meridian normal form for a positive-radius
circular average.  This is the source-checked Fourier-side portion of the
blueprint's circle-wave decomposition: the meridian integral is retained
exactly, before the unavailable endpoint-symbol split into outgoing and
incoming half-waves. -/
theorem circleBandpassFourierMeridianNormalForm
    (psi f : SchwartzMap (ℝ^2) Complex) {t : Real} (ht : 0 ≤ t)
    (x : Euclidean 2) :
    circularAverage t (dyadicBandpassProjection psi f : ℝ^2 → Complex) x =
      ((surfaceMass 2)⁻¹ : Complex) *
        𝓕⁻ (fun xi : Euclidean 2 =>
          ((surfaceMass 1 : Complex) *
            ∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
              Auto.Spherical.SurfaceMeasureDecay.circleMeridianPhase
                (2 * Real.pi * (t * ‖xi‖)) theta) *
            (psi xi * 𝓕 (f : Euclidean 2 → Complex) xi)) x := by
  change _root_.Spherical.sphericalAverage t
    (dyadicBandpassProjection psi f : Euclidean 2 → Complex) x = _
  rw [Auto.Spherical.PowerWeights.sphericalAverage_eq_normalizedSphericalAverage]
  unfold normalizedSphericalAverage
  rw [Auto.Spherical.Auxiliary.sphericalAverage_eq_fourierInv_surfaceMultiplier_schwartz]
  congr 1
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext xi
  rw [circleSurfaceFourierMeridianNormalForm (-t • xi)]
  have hnorm : ‖-t • xi‖ = t * ‖xi‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_neg, abs_of_nonneg ht]
  rw [hnorm]
  unfold dyadicBandpassProjection
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  rw [SchwartzMap.smulLeftCLM_apply psi.hasTemperateGrowth,
    SchwartzMap.fourier_coe]
  simp only [smul_eq_mul]

/-- Exact frequency-localized coordinate-wave normal form for a positive-radius
circular average.  Unlike the meridian version, this exposes the literal
outgoing, incoming, and middle pieces of the planar surface Fourier factor.
No multiplier or local-smoothing estimate is used here. -/
theorem circleBandpassFourierCoordinateWaveNormalForm
    (psi f : SchwartzMap (ℝ^2) Complex) {t : Real} (ht : 0 ≤ t)
    (x : Euclidean 2) :
    circularAverage t (dyadicBandpassProjection psi f : ℝ^2 → Complex) x =
      ((surfaceMass 2)⁻¹ : Complex) *
        𝓕⁻ (fun xi : Euclidean 2 =>
          ((surfaceMass 1 : Complex) *
            (Complex.exp (((-(2 * Real.pi * (t * ‖xi‖)) : Real) : Complex) * Complex.I) *
                Auto.Spherical.FractalDilations.Auxiliary.planarEndpointQuadraticIntegral
                  (2 * Real.pi * (t * ‖xi‖)) +
              Complex.exp (((2 * Real.pi * (t * ‖xi‖) : Real) : Complex) * Complex.I) *
                Auto.Spherical.FractalDilations.Auxiliary.planarEndpointQuadraticIntegral
                  (-(2 * Real.pi * (t * ‖xi‖))) +
              Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianLocalizedIntegral
                0 (2 * Real.pi * (t * ‖xi‖)))) *
            (psi xi * 𝓕 (f : Euclidean 2 → Complex) xi)) x := by
  change _root_.Spherical.sphericalAverage t
    (dyadicBandpassProjection psi f : Euclidean 2 → Complex) x = _
  rw [Auto.Spherical.PowerWeights.sphericalAverage_eq_normalizedSphericalAverage]
  unfold normalizedSphericalAverage
  rw [Auto.Spherical.Auxiliary.sphericalAverage_eq_fourierInv_surfaceMultiplier_schwartz]
  congr 1
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext xi
  rw [circleSurfaceFourierCoordinateWaveDecomposition (-t • xi)]
  have hnorm : ‖-t • xi‖ = t * ‖xi‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_neg, abs_of_nonneg ht]
  rw [hnorm]
  unfold dyadicBandpassProjection
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  rw [SchwartzMap.smulLeftCLM_apply psi.hasTemperateGrowth,
    SchwartzMap.fourier_coe]
  simp only [smul_eq_mul]

/-- The stationary endpoint amplitude paired with a half-wave orientation.
The negative half-wave carries the endpoint at positive quadratic frequency,
and conversely. -/
noncomputable def circleEndpointAmplitude
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (r : Real) : Complex :=
  match σ with
  | .minus =>
      Auto.Spherical.FractalDilations.Auxiliary.planarEndpointQuadraticIntegral r
  | .plus =>
      Auto.Spherical.FractalDilations.Auxiliary.planarEndpointQuadraticIntegral (-r)

/-- The dyadic normalization used for the endpoint multipliers in the
circle-wave decomposition. -/
noncomputable def circleEndpointDyadicNormalization (j : Nat) : Complex :=
  (((2 : Real) ^ ((j : Real) / 2) : Real) : Complex)

theorem circleEndpointDyadicNormalization_ne_zero (j : Nat) :
    circleEndpointDyadicNormalization j ≠ 0 := by
  unfold circleEndpointDyadicNormalization
  exact_mod_cast ne_of_gt (Real.rpow_pos_of_pos (by norm_num) _)

/-- The one-dimensional stationary-phase estimate controls both oriented
circle endpoint amplitudes with the same constant. -/
theorem exists_circleEndpointAmplitude_decay :
    ∃ A : Real, 0 < A ∧ ∀ (σ : _root_.Auto.Spherical.MSSBase.WaveSign)
      (r : Real), 1 ≤ r → ‖circleEndpointAmplitude σ r‖ ≤ A / Real.sqrt r := by
  obtain ⟨A, hA, hdecay⟩ :=
    Auto.Spherical.FractalDilations.Auxiliary.exists_planarEndpointQuadraticIntegral_decay
  refine ⟨A, hA, ?_⟩
  intro σ r hr
  cases σ with
  | minus =>
      simpa [circleEndpointAmplitude] using hdecay r hr
  | plus =>
      rw [circleEndpointAmplitude,
        Auto.Spherical.FractalDilations.Auxiliary.norm_planarEndpointQuadraticIntegral_neg]
      exact hdecay r hr

/-- The absolute value of the dyadic normalization is the square root of
the corresponding dyadic frequency. -/
theorem norm_circleEndpointDyadicNormalization (j : Nat) :
    ‖circleEndpointDyadicNormalization j‖ = Real.sqrt ((2 : Real) ^ j) := by
  unfold circleEndpointDyadicNormalization
  rw [Complex.norm_real, Real.norm_of_nonneg
    (Real.rpow_nonneg (by norm_num) _), Real.sqrt_eq_rpow]
  rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0 : Real) ≤ 2)]
  congr 1
  ring

/-- A nonzero `j`th dyadic band-pass frequency lies strictly above the
lower edge of its annulus. -/
theorem aux_norm_lt_of_dyadicBandpassMultiplier_ne_zero
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (xi : Euclidean 2)
    (hband : _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi ≠ 0) :
    (2 : Real) ^ j < ‖xi‖ := by
  by_contra hnot
  exact hband
    (_root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_norm_le C
      (le_of_not_gt hnot))

/-- On the active dyadic annulus and for positive unit-scale time, the
endpoint stationary frequency dominates the dyadic frequency. -/
theorem aux_dyadicFrequency_le_circleEndpointFrequency
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (xi : Euclidean 2) (ht : 1 ≤ t)
    (hband : _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi ≠ 0) :
    (2 : Real) ^ j ≤ 2 * Real.pi * (t * ‖xi‖) := by
  have hxi : (2 : Real) ^ j ≤ ‖xi‖ :=
    (aux_norm_lt_of_dyadicBandpassMultiplier_ne_zero C j xi hband).le
  have hpi : 1 ≤ 2 * Real.pi := by
    have hpi' := Real.pi_gt_three
    linarith
  have htnorm : ‖xi‖ ≤ t * ‖xi‖ := by
    exact le_mul_of_one_le_left (norm_nonneg xi) ht
  have ht0 : 0 ≤ t := by linarith
  calc
    (2 : Real) ^ j ≤ ‖xi‖ := hxi
    _ ≤ t * ‖xi‖ := htnorm
    _ ≤ 2 * Real.pi * (t * ‖xi‖) :=
      le_mul_of_one_le_left (mul_nonneg ht0 (norm_nonneg xi)) hpi

/-- The stationary square-root denominator dominates the normalizing
dyadic half-power on an active band-pass. -/
theorem aux_norm_circleEndpointDyadicNormalization_le_sqrt_endpointFrequency
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (xi : Euclidean 2) (ht : 1 ≤ t)
    (hband : _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi ≠ 0) :
    ‖circleEndpointDyadicNormalization j‖ ≤
      Real.sqrt (2 * Real.pi * (t * ‖xi‖)) := by
  rw [norm_circleEndpointDyadicNormalization]
  exact Real.sqrt_le_sqrt
    (aux_dyadicFrequency_le_circleEndpointFrequency C j t xi ht hband)

/-- The compact frequency-localized multiplier denoted `b_{j,±}` in the
blueprint.  Its low-pass factor is one on the support of the `j`th dyadic
band-pass, but makes the multiplier compactly frequency localized. -/
noncomputable def circleEndpointMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real) :
    Euclidean 2 → Complex :=
  fun xi =>
    circleEndpointDyadicNormalization j * ((surfaceMass 2)⁻¹ : Complex) *
      (surfaceMass 1 : Complex) *
      circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier C.cutoff (j + 2) xi

/-- The annular version of the circle endpoint multiplier.  The fat dyadic
cutoff is identically one on the active band-pass and removes a neighborhood
of the origin from the endpoint symbol. -/
noncomputable def circleAnnularEndpointMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real) :
    Euclidean 2 → Complex :=
  fun xi =>
    circleEndpointDyadicNormalization j * ((surfaceMass 2)⁻¹ : Complex) *
      (surfaceMass 1 : Complex) *
      circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j xi

/-- The enlarged cutoff in `circleEndpointMultiplier` gives genuine compact
frequency support. -/
theorem hasCompactSupport_circleEndpointMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real) :
    HasCompactSupport (circleEndpointMultiplier C σ j t) := by
  apply HasCompactSupport.intro
    (isCompact_closedBall (0 : Euclidean 2) ((2 : Real) ^ (j + 3)))
  intro xi hxi
  have hnorm : (2 : Real) ^ (j + 3) ≤ ‖xi‖ := by
    rw [Metric.mem_closedBall, dist_zero_right] at hxi
    exact le_of_not_ge hxi
  have hpow : 0 < (2 : Real) ^ (j + 2) := by positivity
  have htwopow : 2 * (2 : Real) ^ (j + 2) = (2 : Real) ^ (j + 3) := by
    rw [show j + 3 = (j + 2) + 1 by omega, pow_succ]
    ring
  have hscaled : 2 ≤ ‖((2 : Real) ^ (j + 2))⁻¹ • xi‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hpow)]
    rw [show ((2 : Real) ^ (j + 2))⁻¹ * ‖xi‖ =
        ‖xi‖ / (2 : Real) ^ (j + 2) by
          rw [div_eq_mul_inv, mul_comm]]
    apply (le_div_iff₀ hpow).mpr
    simpa only [htwopow] using hnorm
  have hcut : C.cutoff (((2 : Real) ^ (j + 2))⁻¹ • xi) = 0 :=
    C.cutoff_zero _ hscaled
  simp [circleEndpointMultiplier,
    _root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier_apply, hcut]

/-- A pointwise endpoint-amplitude bound transfers directly to the compact
circle endpoint multiplier. -/
theorem norm_circleEndpointMultiplier_le_of_amplitude_bound
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real)
    (xi : Euclidean 2) (A : Real) (hA : 0 ≤ A)
    (hamp : ‖circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖))‖ ≤
      A / Real.sqrt (2 * Real.pi * (t * ‖xi‖))) :
    ‖circleEndpointMultiplier C σ j t xi‖ ≤
      ‖circleEndpointDyadicNormalization j‖ * ‖((surfaceMass 2)⁻¹ : Complex)‖ *
        surfaceMass 1 * (A / Real.sqrt (2 * Real.pi * (t * ‖xi‖))) := by
  have hmass1 : 0 ≤ surfaceMass 1 := (surfaceMass_pos (by norm_num)).le
  have hcut :
      ‖_root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier C.cutoff (j + 2) xi‖ ≤
        1 := by
    rw [_root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier_apply]
    exact C.norm_le_one _
  have hratio : 0 ≤ A / Real.sqrt (2 * Real.pi * (t * ‖xi‖)) :=
    div_nonneg hA (Real.sqrt_nonneg _)
  have hinner :
      ‖circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖))‖ *
          ‖_root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier C.cutoff (j + 2) xi‖ ≤
        (A / Real.sqrt (2 * Real.pi * (t * ‖xi‖))) * 1 := by
    calc
      ‖circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖))‖ *
          ‖_root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier C.cutoff (j + 2) xi‖ ≤
        (A / Real.sqrt (2 * Real.pi * (t * ‖xi‖))) *
          ‖_root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier C.cutoff (j + 2) xi‖ :=
        mul_le_mul_of_nonneg_right hamp (norm_nonneg _)
      _ ≤ (A / Real.sqrt (2 * Real.pi * (t * ‖xi‖))) * 1 :=
        mul_le_mul_of_nonneg_left hcut hratio
  have houter : 0 ≤
      ‖circleEndpointDyadicNormalization j‖ * ‖((surfaceMass 2)⁻¹ : Complex)‖ *
        surfaceMass 1 := by positivity
  unfold circleEndpointMultiplier
  rw [norm_mul, norm_mul, norm_mul, norm_mul, Complex.norm_real,
    Real.norm_of_nonneg hmass1]
  calc
    ‖circleEndpointDyadicNormalization j‖ * ‖((surfaceMass 2)⁻¹ : Complex)‖ *
          surfaceMass 1 * ‖circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖))‖ *
          ‖_root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier C.cutoff (j + 2) xi‖ =
        (‖circleEndpointDyadicNormalization j‖ * ‖((surfaceMass 2)⁻¹ : Complex)‖ *
          surfaceMass 1) *
          (‖circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖))‖ *
            ‖_root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier C.cutoff (j + 2) xi‖) := by ring
    _ ≤ (‖circleEndpointDyadicNormalization j‖ * ‖((surfaceMass 2)⁻¹ : Complex)‖ *
          surfaceMass 1) * ((A / Real.sqrt (2 * Real.pi * (t * ‖xi‖))) * 1) :=
      mul_le_mul_of_nonneg_left hinner houter
    _ = ‖circleEndpointDyadicNormalization j‖ * ‖((surfaceMass 2)⁻¹ : Complex)‖ *
          surfaceMass 1 * (A / Real.sqrt (2 * Real.pi * (t * ‖xi‖))) := by ring

/-- The compact endpoint multipliers are uniformly pointwise bounded on the
active dyadic band-pass for all unit-scale times.  This is only a zero-order
stationary-phase estimate, not a Mikhlin estimate. -/
theorem exists_norm_circleEndpointMultiplier_le_on_dyadicBandpass
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : _root_.Auto.Spherical.MSSBase.WaveSign)
      (j : Nat) (t : Real) (xi : Euclidean 2), 1 ≤ t → t ≤ 2 →
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi ≠ 0 →
        ‖circleEndpointMultiplier C σ j t xi‖ ≤ B := by
  obtain ⟨A, hA, hdecay⟩ := exists_circleEndpointAmplitude_decay
  let B : Real := ‖((surfaceMass 2)⁻¹ : Complex)‖ * surfaceMass 1 * A
  have hmass2 : ((surfaceMass 2 : Real) : Complex) ≠ 0 := by
    exact_mod_cast surfaceMass_ne_zero (by norm_num : 0 < 2)
  have hinv : 0 < ‖((surfaceMass 2)⁻¹ : Complex)‖ :=
    norm_pos_iff.mpr (inv_ne_zero hmass2)
  have hmass1 : 0 < surfaceMass 1 := surfaceMass_pos (by norm_num)
  refine ⟨B, mul_pos (mul_pos hinv hmass1) hA, ?_⟩
  intro σ j t xi ht _htop hband
  have hlower : (2 : Real) ^ j ≤ 2 * Real.pi * (t * ‖xi‖) :=
    aux_dyadicFrequency_le_circleEndpointFrequency C j t xi ht hband
  have honepow : 1 ≤ (2 : Real) ^ j :=
    one_le_pow₀ (by norm_num : (1 : Real) ≤ 2)
  have hlambda : 1 ≤ 2 * Real.pi * (t * ‖xi‖) := honepow.trans hlower
  have hlambdapos : 0 < 2 * Real.pi * (t * ‖xi‖) :=
    lt_of_lt_of_le zero_lt_one hlambda
  have hamp := hdecay σ (2 * Real.pi * (t * ‖xi‖)) hlambda
  have hpoint := norm_circleEndpointMultiplier_le_of_amplitude_bound
    C σ j t xi A hA.le hamp
  have hnormal : ‖circleEndpointDyadicNormalization j‖ ≤
      Real.sqrt (2 * Real.pi * (t * ‖xi‖)) :=
    aux_norm_circleEndpointDyadicNormalization_le_sqrt_endpointFrequency C j t xi ht hband
  have hsqrtpos : 0 < Real.sqrt (2 * Real.pi * (t * ‖xi‖)) :=
    Real.sqrt_pos.2 hlambdapos
  have hratio : ‖circleEndpointDyadicNormalization j‖ *
      (A / Real.sqrt (2 * Real.pi * (t * ‖xi‖))) ≤ A := by
    calc
      ‖circleEndpointDyadicNormalization j‖ *
          (A / Real.sqrt (2 * Real.pi * (t * ‖xi‖))) =
        A * (‖circleEndpointDyadicNormalization j‖ /
          Real.sqrt (2 * Real.pi * (t * ‖xi‖))) := by
        rw [div_eq_mul_inv]
        ring
      _ ≤ A * 1 :=
        mul_le_mul_of_nonneg_left
          ((div_le_iff₀ hsqrtpos).mpr (by simpa using hnormal)) hA.le
      _ = A := by ring
  have hsurface : 0 ≤ ‖((surfaceMass 2)⁻¹ : Complex)‖ * surfaceMass 1 := by positivity
  calc
    ‖circleEndpointMultiplier C σ j t xi‖ ≤
        ‖circleEndpointDyadicNormalization j‖ * ‖((surfaceMass 2)⁻¹ : Complex)‖ *
          surfaceMass 1 * (A / Real.sqrt (2 * Real.pi * (t * ‖xi‖))) := hpoint
    _ = (‖((surfaceMass 2)⁻¹ : Complex)‖ * surfaceMass 1) *
          (‖circleEndpointDyadicNormalization j‖ *
            (A / Real.sqrt (2 * Real.pi * (t * ‖xi‖)))) := by ring
    _ ≤ (‖((surfaceMass 2)⁻¹ : Complex)‖ * surfaceMass 1) * A :=
      mul_le_mul_of_nonneg_left hratio hsurface
    _ = B := by rfl

/-- The enlarged low-pass cutoff is identically one on the support of the
`j`th band-pass multiplier. -/
theorem aux_dyadicLowpassMultiplier_mul_dyadicBandpassMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (xi : Euclidean 2) :
    _root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier C.cutoff (j + 2) xi *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi =
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi := by
  by_cases hband :
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0
  · rw [hband, mul_zero]
  · have hxi : ‖xi‖ < (2 : Real) ^ (j + 2) := by
      by_contra hnot
      exact hband
        (_root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_le_norm C
          (le_of_not_gt hnot))
    have hpow : 0 < (2 : Real) ^ (j + 2) := by positivity
    have hscaled : ‖((2 : Real) ^ (j + 2))⁻¹ • xi‖ ≤ 1 := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hpow)]
      rw [show ((2 : Real) ^ (j + 2))⁻¹ * ‖xi‖ =
          ‖xi‖ / (2 : Real) ^ (j + 2) by
            rw [div_eq_mul_inv, mul_comm]]
      exact (div_le_iff₀ hpow).mpr (by simpa using hxi.le)
    have hlow :
        _root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier C.cutoff (j + 2) xi =
          1 := by
      rw [_root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier_apply]
      exact C.cutoff_one _ hscaled
    rw [hlow, one_mul]

/-- Exact Fourier-symbol factorization of an endpoint contribution through
the MSS frequency-localized half-wave multiplier.  This is the algebraic
part of the circle-wave decomposition; uniform Mikhlin estimates are a
separate later step. -/
theorem circleEndpointMultiplier_factorization
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real)
    (xi : Euclidean 2) :
    (circleEndpointDyadicNormalization j)⁻¹ *
        circleEndpointMultiplier C σ j t xi *
        _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol C.cutoff σ j t xi =
      ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
        _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t xi *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi := by
  have hnormal : circleEndpointDyadicNormalization j ≠ 0 :=
    circleEndpointDyadicNormalization_ne_zero j
  unfold circleEndpointMultiplier _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol
  calc
    (circleEndpointDyadicNormalization j)⁻¹ *
          (circleEndpointDyadicNormalization j * ((surfaceMass 2)⁻¹ : Complex) *
            (surfaceMass 1 : Complex) *
            circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
            _root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier C.cutoff (j + 2) xi) *
          (_root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t xi *
            _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi) =
        ((circleEndpointDyadicNormalization j)⁻¹ * circleEndpointDyadicNormalization j) *
          (((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
            circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
            _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t xi) *
          (_root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier C.cutoff (j + 2) xi *
            _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi) := by ring
    _ = ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
          _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi := by
      rw [inv_mul_cancel₀ hnormal,
        aux_dyadicLowpassMultiplier_mul_dyadicBandpassMultiplier]
      ring

/-- Exact endpoint factorization with the annular fat dyadic cutoff.  The
fat cutoff is one on the ordinary dyadic band-pass, so it leaves the endpoint
contribution unchanged while keeping the multiplier away from the origin. -/
theorem circleAnnularEndpointMultiplier_factorization
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real)
    (xi : Euclidean 2) :
    (circleEndpointDyadicNormalization j)⁻¹ *
        circleAnnularEndpointMultiplier C σ j t xi *
        _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol C.cutoff σ j t xi =
      ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
        _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t xi *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi := by
  have hnormal : circleEndpointDyadicNormalization j ≠ 0 :=
    circleEndpointDyadicNormalization_ne_zero j
  calc
    (circleEndpointDyadicNormalization j)⁻¹ *
          circleAnnularEndpointMultiplier C σ j t xi *
          _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol C.cutoff σ j t xi =
        ((circleEndpointDyadicNormalization j)⁻¹ * circleEndpointDyadicNormalization j) *
          (((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
            circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
            _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t xi) *
          (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
            _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j xi) := by
      unfold circleAnnularEndpointMultiplier _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol
      ring
    _ = ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
          _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi := by
      rw [inv_mul_cancel₀ hnormal,
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier_mul_fatDyadicBandpassMultiplier]
      ring

/-- Both oriented stationary endpoint amplitudes are globally smooth in the
one-dimensional frequency parameter.  The fat annular cutoff below removes
the separate nonsmoothness of `‖xi‖` at the spatial frequency origin. -/
theorem contDiff_circleEndpointAmplitude
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) :
    ContDiff Real (⊤ : ℕ∞) (circleEndpointAmplitude σ) := by
  cases σ with
  | minus =>
      exact Auto.Spherical.FractalDilations.Auxiliary.contDiff_planarEndpointQuadraticIntegral
  | plus =>
      exact Auto.Spherical.FractalDilations.Auxiliary.contDiff_planarEndpointQuadraticIntegral.comp
        (by fun_prop)

/-- The literal time derivative of a stationary endpoint amplitude after
evaluation at the half-wave frequency `2π t ‖ξ‖`. -/
noncomputable def circleEndpointAmplitudeTimeDerivative
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (t : Real) (ξ : Euclidean 2) : Complex :=
  ((2 * Real.pi * ‖ξ‖ : Real) : Complex) *
    deriv (circleEndpointAmplitude σ) (2 * Real.pi * (t * ‖ξ‖))

/-- The stationary endpoint amplitude has the expected pointwise time
derivative at every fixed frequency.  Together with the half-wave derivative,
this supplies the literal chain-rule input for a temporal sampling argument. -/
theorem hasDerivAt_circleEndpointAmplitude_time
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (t : Real) (ξ : Euclidean 2) :
    HasDerivAt
      (fun s : Real => circleEndpointAmplitude σ (2 * Real.pi * (s * ‖ξ‖)) )
      (circleEndpointAmplitudeTimeDerivative σ t ξ) t := by
  have harg : HasDerivAt (fun s : Real => 2 * Real.pi * (s * ‖ξ‖))
      (2 * Real.pi * ‖ξ‖) t := by
    refine (hasDerivAt_iff_hasFDerivAt).mpr ?_
    simpa only [mul_assoc, mul_left_comm, mul_comm] using
      (hasDerivAt_const_mul (2 * Real.pi * ‖ξ‖)).hasFDerivAt
  have hamp : HasDerivAt (circleEndpointAmplitude σ)
      (deriv (circleEndpointAmplitude σ) (2 * Real.pi * (t * ‖ξ‖)))
      (2 * Real.pi * (t * ‖ξ‖)) := by
    apply ((contDiff_circleEndpointAmplitude σ).contDiffAt.differentiableAt
      (by norm_num)).hasDerivAt
  apply (hasDerivAt_iff_hasFDerivAt).mpr
  have hcomp := HasFDerivAt.comp t hamp.hasFDerivAt harg.hasFDerivAt
  have hfun : (circleEndpointAmplitude σ) ∘
      (fun s : Real => 2 * Real.pi * (s * ‖ξ‖)) =
      fun s : Real => circleEndpointAmplitude σ (2 * Real.pi * (s * ‖ξ‖)) := rfl
  rw [hfun] at hcomp
  have hmap :
      (ContinuousLinearMap.toSpanSingleton Real
        (deriv (circleEndpointAmplitude σ) (2 * Real.pi * (t * ‖ξ‖))) ∘SL
        ContinuousLinearMap.toSpanSingleton Real (2 * Real.pi * ‖ξ‖)) =
      ContinuousLinearMap.toSpanSingleton Real
        (circleEndpointAmplitudeTimeDerivative σ t ξ) := by
    ext
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.toSpanSingleton_apply,
      circleEndpointAmplitudeTimeDerivative, Complex.real_smul, smul_eq_mul, one_smul]
    push_cast
    ring_nf
  rw [hmap] at hcomp
  exact hcomp

/-- The parameter derivatives of either oriented circle endpoint obey the
same absolute-frequency stationary-phase scale. -/
theorem exists_iteratedDeriv_circleEndpointAmplitude_abs_decay
    (k : Nat) :
    ∃ A : Real, 0 < A ∧ ∀ (σ : _root_.Auto.Spherical.MSSBase.WaveSign)
      (r : Real), 1 ≤ |r| →
      ‖iteratedDeriv k (circleEndpointAmplitude σ) r‖ ≤
        A / Auto.Spherical.FractalDilations.Auxiliary.quadraticMomentScale
          (2 * k) |r| := by
  obtain ⟨A, hA, hdecay⟩ :=
    Auto.Spherical.FractalDilations.Auxiliary.exists_iteratedDeriv_planarEndpointQuadraticIntegral_abs_decay k
  refine ⟨A, hA, ?_⟩
  intro σ r hr
  cases σ with
  | minus =>
      change ‖iteratedDeriv k
        Auto.Spherical.FractalDilations.Auxiliary.planarEndpointQuadraticIntegral r‖ ≤ _
      exact hdecay r hr
  | plus =>
      rw [show circleEndpointAmplitude _root_.Auto.Spherical.MSSBase.WaveSign.plus =
          fun s : Real =>
            Auto.Spherical.FractalDilations.Auxiliary.planarEndpointQuadraticIntegral (-s) by rfl,
        iteratedDeriv_comp_neg]
      simpa only [norm_smul, Real.norm_eq_abs, abs_pow, abs_neg, abs_one,
        one_pow, one_mul] using hdecay (-r) (by simpa using hr)

/-- The radial endpoint factor after rescaling the `j`th annulus to unit
frequency.  This records the exact dyadic normalization before multiplying
by the fixed fat Schwartz cutoff. -/
noncomputable def circleEndpointScaledRadialAmplitude
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real) :
    Real → Complex :=
  fun ρ =>
    circleEndpointDyadicNormalization j *
      circleEndpointAmplitude σ ((2 * Real.pi * t * (2 : Real) ^ j) * ρ)

/-- Exact radial derivatives of the rescaled endpoint factor. -/
theorem iteratedDeriv_circleEndpointScaledRadialAmplitude
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j k : Nat) (t : Real) :
    iteratedDeriv k (circleEndpointScaledRadialAmplitude σ j t) =
      fun ρ => circleEndpointDyadicNormalization j *
        ((2 * Real.pi * t * (2 : Real) ^ j) ^ k •
          iteratedDeriv k (circleEndpointAmplitude σ)
            ((2 * Real.pi * t * (2 : Real) ^ j) * ρ)) := by
  unfold circleEndpointScaledRadialAmplitude
  funext ρ
  have hk : (k : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by
    change ((k : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞)
    exact WithTop.coe_le_coe.mpr le_top
  rw [iteratedDeriv_const_mul_field,
    iteratedDeriv_comp_const_smul ((contDiff_circleEndpointAmplitude σ).of_le hk)]

/-- The scaled radial endpoint factor retains the literal stationary-phase
bound in every derivative.  This is the quantitative input before the
separate product estimates for the fat cutoff. -/
theorem exists_norm_iteratedDeriv_circleEndpointScaledRadialAmplitude_decay
    (k : Nat) :
    ∃ A : Real, 0 < A ∧ ∀ (σ : _root_.Auto.Spherical.MSSBase.WaveSign)
      (j : Nat) (t ρ : Real),
      1 ≤ |(2 * Real.pi * t * (2 : Real) ^ j) * ρ| →
      ‖iteratedDeriv k (circleEndpointScaledRadialAmplitude σ j t) ρ‖ ≤
        ‖circleEndpointDyadicNormalization j‖ *
          |2 * Real.pi * t * (2 : Real) ^ j| ^ k *
          (A / Auto.Spherical.FractalDilations.Auxiliary.quadraticMomentScale (2 * k)
              |(2 * Real.pi * t * (2 : Real) ^ j) * ρ|) := by
  obtain ⟨A, hA, hdecay⟩ :=
    exists_iteratedDeriv_circleEndpointAmplitude_abs_decay k
  refine ⟨A, hA, ?_⟩
  intro σ j t ρ hlarge
  rw [iteratedDeriv_circleEndpointScaledRadialAmplitude]
  change ‖circleEndpointDyadicNormalization j *
      ((2 * Real.pi * t * (2 : Real) ^ j) ^ k •
        iteratedDeriv k (circleEndpointAmplitude σ)
          ((2 * Real.pi * t * (2 : Real) ^ j) * ρ))‖ ≤ _
  rw [norm_mul, norm_smul, Real.norm_eq_abs, abs_pow]
  have hfactor : 0 ≤ |2 * Real.pi * t * (2 : Real) ^ j| ^ k :=
    pow_nonneg (abs_nonneg _) _
  have hinner := hdecay σ ((2 * Real.pi * t * (2 : Real) ^ j) * ρ) hlarge
  calc
    ‖circleEndpointDyadicNormalization j‖ *
        (|2 * Real.pi * t * (2 : Real) ^ j| ^ k *
          ‖iteratedDeriv k (circleEndpointAmplitude σ)
            ((2 * Real.pi * t * (2 : Real) ^ j) * ρ)‖) ≤
        ‖circleEndpointDyadicNormalization j‖ *
          (|2 * Real.pi * t * (2 : Real) ^ j| ^ k *
            (A / Auto.Spherical.FractalDilations.Auxiliary.quadraticMomentScale
              (2 * k) |(2 * Real.pi * t * (2 : Real) ^ j) * ρ|)) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hinner hfactor) (norm_nonneg _)
    _ = _ := by ring

/-- On the fixed fat annulus, every fixed-order radial derivative of the
rescaled endpoint amplitude is uniform in the dyadic scale.  This is the
one-dimensional stationary input for the later multivariable compact-annulus
derivative certificate. -/
theorem exists_uniform_norm_iteratedDeriv_circleEndpointScaledRadialAmplitude_le
    (k : Nat) :
    ∃ A : Real, 0 < A ∧ ∀ (σ : _root_.Auto.Spherical.MSSBase.WaveSign)
      (j : Nat) (t ρ : Real), 1 ≤ t → (1 / 4 : Real) ≤ ρ → ρ ≤ 16 →
      ‖iteratedDeriv k (circleEndpointScaledRadialAmplitude σ j t) ρ‖ ≤ A := by
  obtain ⟨A, hA, hdecay⟩ :=
    exists_norm_iteratedDeriv_circleEndpointScaledRadialAmplitude_decay k
  let B : Real := A * 4 ^ k
  have hB : 0 < B := mul_pos hA (pow_pos (by norm_num) _)
  refine ⟨B, hB, ?_⟩
  intro σ j t ρ ht hρ hρtop
  let s : Real := (2 : Real) ^ j
  let a : Real := 2 * Real.pi * t * s
  let freq : Real := a * ρ
  have hspos : 0 < s := by
    dsimp [s]
    positivity
  have htpos : 0 < t := lt_of_lt_of_le zero_lt_one ht
  have hρpos : 0 < ρ := lt_of_lt_of_le (by norm_num) hρ
  have hapos : 0 < a := by
    dsimp [a]
    positivity
  have hfreqpos : 0 < freq := by
    dsimp [freq]
    positivity
  have hfactor : 1 ≤ 2 * Real.pi * t * ρ := by
    have htr : (1 / 4 : Real) ≤ t * ρ := by
      calc
        (1 / 4 : Real) = 1 * (1 / 4 : Real) := by ring
        _ ≤ t * ρ := mul_le_mul ht hρ (by norm_num) htpos.le
    have hpi : (3 : Real) ≤ Real.pi := Real.pi_gt_three.le
    have hpit : 3 * (1 / 4 : Real) ≤ Real.pi * (t * ρ) :=
      mul_le_mul hpi htr (by norm_num) (by linarith [Real.pi_gt_three])
    nlinarith
  have hlambda : s ≤ freq := by
    change s ≤ a * ρ
    change s ≤ (2 * Real.pi * t * s) * ρ
    rw [show (2 * Real.pi * t * s) * ρ = s * (2 * Real.pi * t * ρ) by ring]
    exact le_mul_of_one_le_right hspos.le hfactor
  have hlambdaone : 1 ≤ freq := by
    have hsone : 1 ≤ s := by
      dsimp [s]
      exact one_le_pow₀ (by norm_num)
    exact hsone.trans hlambda
  have hmain := hdecay σ j t ρ (by
    change 1 ≤ |a * ρ|
    rw [abs_of_pos hfreqpos]
    exact hlambdaone)
  have hmain' :
      ‖iteratedDeriv k (circleEndpointScaledRadialAmplitude σ j t) ρ‖ ≤
        ‖circleEndpointDyadicNormalization j‖ * |a| ^ k *
          (A / Auto.Spherical.FractalDilations.Auxiliary.quadraticMomentScale
            (2 * k) |freq|) := by
    simpa [s, a, freq] using hmain
  change ‖iteratedDeriv k (circleEndpointScaledRadialAmplitude σ j t) ρ‖ ≤ B
  rw [abs_of_pos hapos, abs_of_pos hfreqpos] at hmain'
  rw [norm_circleEndpointDyadicNormalization] at hmain'
  unfold Auto.Spherical.FractalDilations.Auxiliary.quadraticMomentScale at hmain'
  have hsqrt : Real.sqrt s ≤ Real.sqrt freq := Real.sqrt_le_sqrt hlambda
  have hsqrtpos : 0 < Real.sqrt s := Real.sqrt_pos.2 hspos
  have hfreqsqrtpos : 0 < Real.sqrt freq := Real.sqrt_pos.2 hfreqpos
  have hpow : a ^ k ≤ (4 * freq) ^ k :=
    pow_le_pow_left₀ hapos.le (by
      dsimp [freq]
      have hfactorρ : 1 ≤ 4 * ρ := by nlinarith
      calc
        a = a * 1 := by ring
        _ ≤ a * (4 * ρ) := mul_le_mul_of_nonneg_left hfactorρ hapos.le
        _ = 4 * freq := by dsimp [freq]; ring) _
  have hden : (Real.sqrt freq) ^ (2 * k + 1) =
      Real.sqrt freq * freq ^ k := by
    calc
      (Real.sqrt freq) ^ (2 * k + 1) =
          Real.sqrt freq * ((Real.sqrt freq) ^ 2) ^ k := by
        rw [show 2 * k + 1 = 1 + 2 * k by omega, pow_add, pow_one, pow_mul]
      _ = Real.sqrt freq * freq ^ k := by
        rw [Real.sq_sqrt hfreqpos.le]
  calc
    ‖iteratedDeriv k (circleEndpointScaledRadialAmplitude σ j t) ρ‖ ≤
        Real.sqrt s * a ^ k * (A / (Real.sqrt freq) ^ (2 * k + 1)) := by
      simpa using hmain'
    _ ≤ Real.sqrt freq * (4 * freq) ^ k * (A / (Real.sqrt freq) ^ (2 * k + 1)) := by
      gcongr
    _ = A * 4 ^ k := by
      rw [hden, mul_pow]
      field_simp

/-- On a fixed positive annulus, the one-dimensional uniform endpoint bounds
lift through the Euclidean norm to multivariable iterated Fréchet derivatives.
This isolates the only use of the nonzero-radius condition in the uniform
Fourier-side endpoint certificate. -/
theorem exists_uniform_norm_iteratedFDeriv_circleEndpointScaledRadialComp_le
    (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ (σ : _root_.Auto.Spherical.MSSBase.WaveSign)
      (j : Nat) (t : Real) (η : Euclidean 2),
      1 ≤ t → (1 / 4 : Real) ≤ ‖η‖ → ‖η‖ ≤ 16 →
      ‖iteratedFDeriv Real n
        (fun y : Euclidean 2 => circleEndpointScaledRadialAmplitude σ j t ‖y‖) η‖ ≤ C := by
  choose A hApos hAbound using fun i : Nat =>
    exists_uniform_norm_iteratedDeriv_circleEndpointScaledRadialAmplitude_le i
  choose D hDpos hDbound using fun i : Nat =>
    _root_.Auto.MikhlinHormander.exists_norm_iteratedFDeriv_norm_bound_on_annulus
      (d := 2) (r := 1 / 4) (R := 16) i (by norm_num : (0 : Real) < 1 / 4)
  let CA : Real := ∑ i ∈ Finset.range (n + 1), A i
  let CD : Real := (∑ i ∈ Finset.range (n + 1), D i) + 1
  have hCApos : 0 < CA := by
    have hmem : 0 ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hle : A 0 ≤ CA := by
      dsimp [CA]
      exact Finset.single_le_sum (fun i hi => (hApos i).le) hmem
    exact lt_of_lt_of_le (hApos 0) hle
  have hCDone : 1 ≤ CD := by
    dsimp [CD]
    have hsum : 0 ≤ ∑ i ∈ Finset.range (n + 1), D i :=
      Finset.sum_nonneg fun i hi => (hDpos i).le
    linarith
  refine ⟨((Nat.factorial n : Nat) : Real) * CA * CD ^ n, by positivity, ?_⟩
  intro σ j t η ht hηinner hηouter
  let s : Set (Euclidean 2) := ({0}ᶜ : Set (Euclidean 2))
  have hsopen : IsOpen s := by
    simpa only [s] using (isOpen_compl_singleton : IsOpen ({0}ᶜ : Set (Euclidean 2)))
  have hsunique : UniqueDiffOn Real s := hsopen.uniqueDiffOn
  have hηne : η ≠ 0 := by
    intro hzero
    subst η
    norm_num at hηinner
  have hηs : η ∈ s := by simpa [s] using hηne
  let g : Real → Complex := circleEndpointScaledRadialAmplitude σ j t
  let f : Euclidean 2 → Real := fun y => ‖y‖
  have hg : ContDiff Real n g := by
    dsimp [g]
    unfold circleEndpointScaledRadialAmplitude
    apply ContDiff.mul
    · fun_prop
    · apply (contDiff_circleEndpointAmplitude σ).of_le
        (show (n : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) by
          exact WithTop.coe_le_coe.mpr le_top)
        |>.comp
      fun_prop
  have hf : ContDiffOn Real n f s := by
    intro x hx
    exact (contDiffAt_norm Real (by simpa [s] using hx)).contDiffWithinAt
  have hgfAt : ContDiffAt Real n (g ∘ f) η :=
    hg.contDiffAt.comp η (contDiffAt_norm Real hηne)
  have hC : ∀ i, i ≤ n → ‖iteratedFDerivWithin Real i g Set.univ (f η)‖ ≤ CA := by
    intro i hi
    rw [iteratedFDerivWithin_univ]
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv]
    have hbase := hAbound i σ j t (f η) ht (by simpa [f] using hηinner)
      (by simpa [f] using hηouter)
    have hmem : i ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hle : A i ≤ CA := by
      dsimp [CA]
      exact Finset.single_le_sum (fun l hl => (hApos l).le) hmem
    exact hbase.trans hle
  have hD : ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDerivWithin Real i f s η‖ ≤ CD ^ i := by
    intro i hi1 hi
    have hfeq : iteratedFDerivWithin Real i f s η = iteratedFDeriv Real i f η :=
      iteratedFDerivWithin_eq_iteratedFDeriv hsunique
        ((contDiffAt_norm Real hηne).of_le
          (show (i : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) by
            exact WithTop.coe_le_coe.mpr le_top)) hηs
    rw [hfeq]
    have hbase := hDbound i η hηinner hηouter
    have hmem : i ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hle : D i ≤ CD := by
      dsimp [CD]
      calc
        D i ≤ ∑ l ∈ Finset.range (n + 1), D l :=
          Finset.single_le_sum (fun l hl => (hDpos l).le) hmem
        _ ≤ (∑ l ∈ Finset.range (n + 1), D l) + 1 := by linarith
    have hpow : CD ≤ CD ^ i := by
      obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hi1)
      rw [pow_succ]
      calc
        CD = 1 * CD := (one_mul _).symm
        _ ≤ CD ^ m * CD :=
          mul_le_mul_of_nonneg_right (one_le_pow₀ hCDone) (le_trans (by norm_num) hCDone)
    exact hbase.trans (hle.trans hpow)
  have hcomp := norm_iteratedFDerivWithin_comp_le
    (g := g) (f := f) (s := s) (t := Set.univ)
    hg.contDiffOn hf (show (n : WithTop ENat) ≤ (n : WithTop ENat) by rfl)
    uniqueDiffOn_univ hsunique (by simp) hηs hC hD
  have hEq : iteratedFDerivWithin Real n (g ∘ f) s η =
      iteratedFDeriv Real n (g ∘ f) η :=
    iteratedFDerivWithin_eq_iteratedFDeriv hsunique hgfAt hηs
  change ‖iteratedFDeriv Real n (g ∘ f) η‖ ≤ _
  rw [← hEq]
  exact hcomp

/-- The unit-scale presentation of the annular endpoint multiplier.  Its
cutoff is the fixed Schwartz prototype from the Littlewood--Paley layer;
only the explicitly displayed stationary amplitude remains scale dependent. -/
noncomputable def circleAnnularEndpointScaledSymbol
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real) :
    Euclidean 2 → Complex :=
  fun η => circleAnnularEndpointMultiplier C σ j t ((2 : Real) ^ j • η)

/-- After radial dyadic rescaling, the fat cutoff in the annular endpoint
symbol is exactly the fixed compact Schwartz profile. -/
theorem circleAnnularEndpointScaledSymbol_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real)
    (η : Euclidean 2) :
    circleAnnularEndpointScaledSymbol C σ j t η =
      circleEndpointDyadicNormalization j * ((surfaceMass 2)⁻¹ : Complex) *
        (surfaceMass 1 : Complex) *
        circleEndpointAmplitude σ
          ((2 * Real.pi * t * (2 : Real) ^ j) * ‖η‖) *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff η := by
  unfold circleAnnularEndpointScaledSymbol circleAnnularEndpointMultiplier
  rw [_root_.Auto.MikhlinHormander.fatDyadicBandpassMultiplier_eq_prototype_scale]
  have hpow : 0 ≤ (2 : Real) ^ j := by positivity
  have hpow_ne : (2 : Real) ^ j ≠ 0 := ne_of_gt (by positivity)
  rw [smul_smul, inv_mul_cancel₀ hpow_ne, one_smul]
  rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hpow]
  have harg : 2 * Real.pi * (t * ((2 : Real) ^ j * ‖η‖)) =
      (2 * Real.pi * t * (2 : Real) ^ j) * ‖η‖ := by ring
  rw [harg]

/-- The fat annular cutoff makes the endpoint multiplier identically zero
on a neighborhood of the frequency origin.  This is the removable-singularity
input needed to regard its radial amplitude as a smooth multiplier. -/
private theorem aux_circleAnnularEndpointMultiplier_eventuallyEq_zero_at_zero
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real) :
    Filter.EventuallyEq (nhds (0 : Euclidean 2))
      (circleAnnularEndpointMultiplier C σ j t) (fun _ => 0) := by
  let rhigh : Real := (2 : Real) ^ ((j : Int) + 3)
  let rlow : Real := (2 : Real) ^ ((j : Int) - 2)
  have hhigh : 0 < rhigh := by
    dsimp [rhigh]
    positivity
  have hlow : 0 < rlow := by
    dsimp [rlow]
    positivity
  filter_upwards [Metric.ball_mem_nhds (0 : Euclidean 2) (lt_min hhigh hlow)] with ξ hξ
  have hξnorm : ‖ξ‖ < min rhigh rlow := by
    simpa only [Metric.mem_ball, dist_zero_right] using hξ
  have hright : ‖rhigh⁻¹ • ξ‖ ≤ 1 := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hhigh)]
    rw [show rhigh⁻¹ * ‖ξ‖ = ‖ξ‖ / rhigh by ring]
    exact (div_le_one₀ hhigh).mpr (hξnorm.le.trans (min_le_left _ _))
  have hleft : ‖rlow⁻¹ • ξ‖ ≤ 1 := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hlow)]
    rw [show rlow⁻¹ * ‖ξ‖ = ‖ξ‖ / rlow by ring]
    exact (div_le_one₀ hlow).mpr (hξnorm.le.trans (min_le_right _ _))
  have hfat :
      _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j ξ = 0 := by
    rw [_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier_eq_shiftedFatMultiplier,
      _root_.Auto.LittlewoodPaley.shiftedFatMultiplier_apply]
    simp only [sub_zero]
    change C.cutoff (rhigh⁻¹ • ξ) - C.cutoff (rlow⁻¹ • ξ) = 0
    rw [C.cutoff_one _ hright, C.cutoff_one _ hleft]
    ring
  simp [circleAnnularEndpointMultiplier, hfat]

/-- The same fat annular cutoff gives compact frequency support to the
endpoint multiplier. -/
private theorem aux_hasCompactSupport_circleAnnularEndpointMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real) :
    HasCompactSupport (circleAnnularEndpointMultiplier C σ j t) := by
  let rhigh : Real := (2 : Real) ^ ((j : Int) + 3)
  let rlow : Real := (2 : Real) ^ ((j : Int) - 2)
  have hhigh : 0 < rhigh := by
    dsimp [rhigh]
    positivity
  have hlow : 0 < rlow := by
    dsimp [rlow]
    positivity
  apply HasCompactSupport.intro
    (isCompact_closedBall (0 : Euclidean 2) (2 * max rhigh rlow))
  intro ξ hξ
  have hξnorm : 2 * max rhigh rlow ≤ ‖ξ‖ := by
    rw [Metric.mem_closedBall, dist_zero_right] at hξ
    exact le_of_not_ge hξ
  have hright : 2 ≤ ‖rhigh⁻¹ • ξ‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hhigh)]
    rw [show rhigh⁻¹ * ‖ξ‖ = ‖ξ‖ / rhigh by ring]
    apply (le_div_iff₀ hhigh).mpr
    calc
      2 * rhigh ≤ 2 * max rhigh rlow :=
        mul_le_mul_of_nonneg_left (le_max_left _ _) (by norm_num)
      _ ≤ ‖ξ‖ := hξnorm
  have hleft : 2 ≤ ‖rlow⁻¹ • ξ‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hlow)]
    rw [show rlow⁻¹ * ‖ξ‖ = ‖ξ‖ / rlow by ring]
    apply (le_div_iff₀ hlow).mpr
    calc
      2 * rlow ≤ 2 * max rhigh rlow :=
        mul_le_mul_of_nonneg_left (le_max_right _ _) (by norm_num)
      _ ≤ ‖ξ‖ := hξnorm
  have hfat :
      _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j ξ = 0 := by
    rw [_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier_eq_shiftedFatMultiplier,
      _root_.Auto.LittlewoodPaley.shiftedFatMultiplier_apply]
    simp only [sub_zero]
    change C.cutoff (rhigh⁻¹ • ξ) - C.cutoff (rlow⁻¹ • ξ) = 0
    rw [C.cutoff_zero _ hright, C.cutoff_zero _ hleft]
    ring
  simp [circleAnnularEndpointMultiplier, hfat]

/-- The annular endpoint multiplier is smooth: away from zero this follows
from smoothness of the norm and endpoint amplitude, and at zero the preceding
local vanishing lemma removes the radial singularity. -/
private theorem aux_contDiff_circleAnnularEndpointMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real) :
    ContDiff Real (⊤ : ℕ∞) (circleAnnularEndpointMultiplier C σ j t) := by
  rw [contDiff_iff_contDiffAt]
  intro ξ
  by_cases hξ : ξ = 0
  · subst ξ
    exact (contDiffAt_const (c := (0 : Complex))).congr_of_eventuallyEq
      (aux_circleAnnularEndpointMultiplier_eventuallyEq_zero_at_zero C σ j t)
  · have hnorm : ContDiffAt Real (⊤ : ℕ∞) (fun η : Euclidean 2 => ‖η‖) ξ :=
      contDiffAt_norm Real hξ
    have harg : ContDiffAt Real (⊤ : ℕ∞) (fun η : Euclidean 2 =>
        2 * Real.pi * (t * ‖η‖)) ξ := by
      fun_prop
    have hamp : ContDiffAt Real (⊤ : ℕ∞) (fun η : Euclidean 2 =>
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖η‖))) ξ :=
      (contDiff_circleEndpointAmplitude σ).contDiffAt.comp ξ harg
    have hcut : ContDiffAt Real (⊤ : ℕ∞)
        (_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j) ξ :=
      ((_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j).smooth
        (⊤ : ℕ∞)).contDiffAt
    unfold circleAnnularEndpointMultiplier
    exact (((contDiffAt_const.mul contDiffAt_const).mul contDiffAt_const).mul hamp).mul hcut

/-- The compact, smooth annular endpoint factor as a Schwartz multiplier.
This is the precise multiplier object to which a later uniform kernel or
Mikhlin estimate must be applied. -/
noncomputable def circleAnnularEndpointSchwartzSymbol
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real) :
    SchwartzMap (Euclidean 2) Complex :=
  (aux_hasCompactSupport_circleAnnularEndpointMultiplier C σ j t).toSchwartzMap
    (aux_contDiff_circleAnnularEndpointMultiplier C σ j t)

/-- Coercion from the Schwartz package recovers the literal fat annular
endpoint multiplier. -/
theorem circleAnnularEndpointSchwartzSymbol_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real)
    (ξ : Euclidean 2) :
    circleAnnularEndpointSchwartzSymbol C σ j t ξ =
      circleAnnularEndpointMultiplier C σ j t ξ := rfl

/-- The Schwartz-packaged annular endpoint symbol has the same exact
factorization through the dyadic MSS half-wave. -/
theorem circleAnnularEndpointSchwartzSymbol_factorization
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real)
    (ξ : Euclidean 2) :
    (circleEndpointDyadicNormalization j)⁻¹ *
        circleAnnularEndpointSchwartzSymbol C σ j t ξ *
        _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol C.cutoff σ j t ξ =
      ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖ξ‖)) *
        _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t ξ *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ := by
  rw [circleAnnularEndpointSchwartzSymbol_apply]
  exact circleAnnularEndpointMultiplier_factorization C σ j t ξ

/-- The endpoint term obtained by applying `b_{j,±}` to the Fourier side of
the corresponding MSS dyadic half-wave. -/
noncomputable def circleEndpointWaveContribution
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun xi : Euclidean 2 =>
    (circleEndpointDyadicNormalization j)⁻¹ *
      circleEndpointMultiplier C σ j t xi *
      _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSymbol C.cutoff σ j t xi *
      𝓕 (f : Euclidean 2 → Complex) xi) x

/-- Literal Fourier factorization of a circle endpoint through an MSS
dyadic half-wave. -/
theorem circleEndpointWaveContribution_factorization
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    circleEndpointWaveContribution C σ j t f x =
      𝓕⁻ (fun xi : Euclidean 2 =>
        ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
          _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
          𝓕 (f : Euclidean 2 → Complex) xi) x := by
  unfold circleEndpointWaveContribution
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext xi
  rw [circleEndpointMultiplier_factorization]

/-- The literal time derivative of the Fourier multiplier in one circle
endpoint contribution.  The two displayed terms differentiate respectively
the stationary amplitude and the half-wave phase. -/
noncomputable def circleEndpointBandpassMultiplierTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real) :
    Euclidean 2 → Complex :=
  fun ξ =>
    ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      (circleEndpointAmplitudeTimeDerivative σ t ξ *
          _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t ξ +
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖ξ‖)) *
          _root_.Auto.Spherical.MSSBase.halfWaveMultiplierTimeDerivative σ t ξ) *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ

/-- The literal endpoint multiplier has the product-rule time derivative
recorded above.  This is pointwise in frequency and makes no unproved
interchange of differentiation and Fourier inversion. -/
theorem hasDerivAt_circleEndpointBandpassMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (j : Nat) (t : Real) (ξ : Euclidean 2) :
    HasDerivAt
      (fun s : Real =>
        ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude σ (2 * Real.pi * (s * ‖ξ‖)) *
          _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ s ξ *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ)
      (circleEndpointBandpassMultiplierTimeDerivative C σ j t ξ) t := by
  let c : Complex := ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex)
  let b : Complex :=
    _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ
  have hA := hasDerivAt_circleEndpointAmplitude_time σ t ξ
  have hH := _root_.Auto.Spherical.MSSBase.hasDerivAt_halfWaveMultiplier_time σ t ξ
  have hproduct := (hA.mul hH).const_mul c |>.mul_const b
  change HasDerivAt
    (fun s : Real => c *
      circleEndpointAmplitude σ (2 * Real.pi * (s * ‖ξ‖)) *
      _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ s ξ * b)
    (c *
      (circleEndpointAmplitudeTimeDerivative σ t ξ *
          _root_.Auto.Spherical.MSSBase.halfWaveMultiplier σ t ξ +
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖ξ‖)) *
          _root_.Auto.Spherical.MSSBase.halfWaveMultiplierTimeDerivative σ t ξ) * b) t
  simpa only [Pi.mul_apply, mul_assoc] using hproduct

/-- The literal Fourier contribution of the nonstationary middle meridian
piece on one dyadic annulus. -/
noncomputable def circleMiddleWaveContribution
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex) :
    Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun xi : Euclidean 2 =>
    ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianLocalizedIntegral
        0 (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
      𝓕 (f : Euclidean 2 → Complex) xi) x

/-- The Fourier multiplier of the nonstationary middle meridian on one
dyadic block.  Separating it from the input Fourier transform makes the
extra full power of dyadic decay visible. -/
noncomputable def aux_circleMiddleBandpassMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) : Euclidean 2 → Complex :=
  fun xi =>
    ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianLocalizedIntegral
        0 (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi

/-- The literal middle contribution is inverse Fourier transformation of its
separated dyadic multiplier. -/
theorem aux_circleMiddleWaveContribution_eq_fourierInv_multiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) :
    circleMiddleWaveContribution C j t f x =
      𝓕⁻ (fun xi : Euclidean 2 =>
        aux_circleMiddleBandpassMultiplier C j t xi *
          𝓕 (f : Euclidean 2 → Complex) xi) x := by
  rfl

/-- On the active `j`th annulus at unit-scale time, the middle meridian has
one full inverse power of the dyadic frequency.  This is strictly better
than the stationary endpoint size and follows directly from the proved
nonstationary integration-by-parts estimate. -/
theorem aux_exists_norm_circleMiddleBandpassMultiplier_le_dyadicInverse
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (j : Nat) (t : Real) (xi : Euclidean 2),
      1 ≤ t → t ≤ 2 →
      ‖aux_circleMiddleBandpassMultiplier C j t xi‖ ≤ B / dyadicScale j := by
  obtain ⟨A, hA, hdecay⟩ := exists_circleMiddleMeridianLocalizedIntegral_decay_one
  let K : Real := ‖((surfaceMass 2)⁻¹ : Complex)‖ * surfaceMass 1
  let B : Real := 2 * K * A
  have hmass2 : ((surfaceMass 2 : Real) : Complex) ≠ 0 := by
    exact_mod_cast surfaceMass_ne_zero (by norm_num : 0 < 2)
  have hinv : 0 < ‖((surfaceMass 2)⁻¹ : Complex)‖ :=
    norm_pos_iff.mpr (inv_ne_zero hmass2)
  have hmass1 : 0 < surfaceMass 1 := surfaceMass_pos (by norm_num)
  have hK : 0 < K := by
    dsimp only [K]
    positivity
  have hB : 0 < B := by
    dsimp only [B]
    positivity
  refine ⟨B, hB, ?_⟩
  intro j t xi ht _htop
  by_cases hband :
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0
  · rw [show aux_circleMiddleBandpassMultiplier C j t xi = 0 by
        simp [aux_circleMiddleBandpassMultiplier, hband]]
    simpa using (div_nonneg hB.le (dyadicScale_pos j).le)
  · have hfrequency : dyadicScale j ≤ 2 * Real.pi * (t * ‖xi‖) := by
      simpa only [dyadicScale] using
        aux_dyadicFrequency_le_circleEndpointFrequency C j t xi ht hband
    have hscale_one : 1 ≤ dyadicScale j := by
      calc
        1 = dyadicScale 0 := by simp [dyadicScale]
        _ ≤ dyadicScale j := dyadicScale_mono (Nat.zero_le j)
    have hlambda : 1 ≤ 2 * Real.pi * (t * ‖xi‖) :=
      hscale_one.trans hfrequency
    have hlambda_nonneg : 0 ≤ 2 * Real.pi * (t * ‖xi‖) :=
      zero_le_one.trans hlambda
    have hmiddle_raw := hdecay (2 * Real.pi * (t * ‖xi‖)) (by
      rw [abs_of_nonneg hlambda_nonneg]
      exact hlambda)
    have hmiddle :
        ‖Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianLocalizedIntegral
            0 (2 * Real.pi * (t * ‖xi‖))‖ ≤ A / (2 * Real.pi * (t * ‖xi‖)) := by
      simpa only [abs_of_nonneg hlambda_nonneg] using hmiddle_raw
    have hratio : A / (2 * Real.pi * (t * ‖xi‖)) ≤ A / dyadicScale j :=
      div_le_div_of_nonneg_left hA.le (dyadicScale_pos j) hfrequency
    have hcut :
        ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ ≤ 2 :=
      _root_.Auto.LittlewoodPaley.norm_dyadicBandpassMultiplier_le_two C j xi
    have hinner :
        ‖Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianLocalizedIntegral
            0 (2 * Real.pi * (t * ‖xi‖))‖ *
          ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ ≤
          (A / (2 * Real.pi * (t * ‖xi‖))) * 2 := by
      exact mul_le_mul hmiddle hcut (norm_nonneg _)
        (div_nonneg hA.le (by positivity))
    calc
      ‖aux_circleMiddleBandpassMultiplier C j t xi‖ =
          K *
            ‖Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianLocalizedIntegral
                0 (2 * Real.pi * (t * ‖xi‖))‖ *
              ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ := by
            unfold aux_circleMiddleBandpassMultiplier
            rw [norm_mul, norm_mul, norm_mul, Complex.norm_real,
              Real.norm_of_nonneg hmass1.le]
      _ = K *
          (‖Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianLocalizedIntegral
              0 (2 * Real.pi * (t * ‖xi‖))‖ *
            ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖) := by
          ring
      _ ≤ K * ((A / (2 * Real.pi * (t * ‖xi‖))) * 2) := by
        exact mul_le_mul_of_nonneg_left hinner hK.le
      _ = (2 * K) * (A / (2 * Real.pi * (t * ‖xi‖))) := by ring
      _ ≤ (2 * K) * (A / dyadicScale j) := by
        exact mul_le_mul_of_nonneg_left hratio (by positivity)
      _ = B / dyadicScale j := by
        dsimp only [B]
        ring

/-- The ordinary dyadic band-pass has compact frequency support.  This local
version is used to turn the smooth full circle multiplier into a Schwartz
symbol before subtracting the two already-Schwartz endpoint pieces. -/
private theorem aux_hasCompactSupport_dyadicBandpassMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) (j : Nat) :
    HasCompactSupport
      (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j :
        Euclidean 2 → Complex) := by
  apply HasCompactSupport.intro
    (isCompact_closedBall (0 : Euclidean 2) ((2 : Real) ^ (j + 2)))
  intro xi hxi
  have hnorm : (2 : Real) ^ (j + 2) ≤ ‖xi‖ := by
    rw [Metric.mem_closedBall, dist_zero_right] at hxi
    exact le_of_not_ge hxi
  exact _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_le_norm C hnorm

/-- The literal middle dyadic multiplier is Schwartz despite its original
oscillatory-integral presentation.  We obtain the package by subtracting the
two compact endpoint symbols from the smooth compactly localized full circle
multiplier; the exact coordinate-wave identity identifies the result with the
middle meridian. -/
theorem aux_exists_circleMiddleBandpassSchwartzSymbol
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (ht : 0 ≤ t) :
    ∃ m : SchwartzMap (Euclidean 2) Complex, ∀ xi : Euclidean 2,
      m xi = aux_circleMiddleBandpassMultiplier C j t xi := by
  let psi : SchwartzMap (Euclidean 2) Complex :=
    _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j
  obtain ⟨mfull, hmfull⟩ :=
    exists_schwartz_compactSupport_mul_surfaceFourier psi
      (aux_hasCompactSupport_dyadicBandpassMultiplier C j) t
  let m0 : SchwartzMap (Euclidean 2) Complex :=
    ((surfaceMass 2)⁻¹ : Complex) • mfull
  let qminus : SchwartzMap (Euclidean 2) Complex :=
    (circleEndpointDyadicNormalization j)⁻¹ •
      SchwartzMap.smulLeftCLM Complex
        (circleAnnularEndpointSchwartzSymbol C _root_.Auto.Spherical.MSSBase.WaveSign.minus j t :
          Euclidean 2 → Complex)
        (_root_.Auto.Spherical.MSSBase.dyadicHalfWaveSchwartzSymbol C
          _root_.Auto.Spherical.MSSBase.WaveSign.minus j t)
  let qplus : SchwartzMap (Euclidean 2) Complex :=
    (circleEndpointDyadicNormalization j)⁻¹ •
      SchwartzMap.smulLeftCLM Complex
        (circleAnnularEndpointSchwartzSymbol C _root_.Auto.Spherical.MSSBase.WaveSign.plus j t :
          Euclidean 2 → Complex)
        (_root_.Auto.Spherical.MSSBase.dyadicHalfWaveSchwartzSymbol C
          _root_.Auto.Spherical.MSSBase.WaveSign.plus j t)
  have hqminus (xi : Euclidean 2) :
      qminus xi =
        ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude _root_.Auto.Spherical.MSSBase.WaveSign.minus
            (2 * Real.pi * (t * ‖xi‖)) *
          _root_.Auto.Spherical.MSSBase.halfWaveMultiplier
            _root_.Auto.Spherical.MSSBase.WaveSign.minus t xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi := by
    dsimp only [qminus]
    change (circleEndpointDyadicNormalization j)⁻¹ •
      (SchwartzMap.smulLeftCLM Complex
        (circleAnnularEndpointSchwartzSymbol C _root_.Auto.Spherical.MSSBase.WaveSign.minus j t :
          Euclidean 2 → Complex)
        (_root_.Auto.Spherical.MSSBase.dyadicHalfWaveSchwartzSymbol C
          _root_.Auto.Spherical.MSSBase.WaveSign.minus j t) xi) = _
    rw [SchwartzMap.smulLeftCLM_apply_apply
      (circleAnnularEndpointSchwartzSymbol C _root_.Auto.Spherical.MSSBase.WaveSign.minus j t).hasTemperateGrowth,
      _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSchwartzSymbol_apply]
    simpa only [smul_eq_mul, mul_assoc] using
      circleAnnularEndpointSchwartzSymbol_factorization C
        _root_.Auto.Spherical.MSSBase.WaveSign.minus j t xi
  have hqplus (xi : Euclidean 2) :
      qplus xi =
        ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude _root_.Auto.Spherical.MSSBase.WaveSign.plus
            (2 * Real.pi * (t * ‖xi‖)) *
          _root_.Auto.Spherical.MSSBase.halfWaveMultiplier
            _root_.Auto.Spherical.MSSBase.WaveSign.plus t xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi := by
    dsimp only [qplus]
    change (circleEndpointDyadicNormalization j)⁻¹ •
      (SchwartzMap.smulLeftCLM Complex
        (circleAnnularEndpointSchwartzSymbol C _root_.Auto.Spherical.MSSBase.WaveSign.plus j t :
          Euclidean 2 → Complex)
        (_root_.Auto.Spherical.MSSBase.dyadicHalfWaveSchwartzSymbol C
          _root_.Auto.Spherical.MSSBase.WaveSign.plus j t) xi) = _
    rw [SchwartzMap.smulLeftCLM_apply_apply
      (circleAnnularEndpointSchwartzSymbol C _root_.Auto.Spherical.MSSBase.WaveSign.plus j t).hasTemperateGrowth,
      _root_.Auto.Spherical.MSSBase.dyadicHalfWaveSchwartzSymbol_apply]
    simpa only [smul_eq_mul, mul_assoc] using
      circleAnnularEndpointSchwartzSymbol_factorization C
        _root_.Auto.Spherical.MSSBase.WaveSign.plus j t xi
  refine ⟨m0 - qminus - qplus, ?_⟩
  intro xi
  have hsurface := circleSurfaceFourierCoordinateWaveDecomposition (-t • xi)
  have hnorm : ‖-t • xi‖ = t * ‖xi‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_neg, abs_of_nonneg ht]
  rw [hnorm] at hsurface
  change ((surfaceMass 2)⁻¹ : Complex) • mfull xi - qminus xi - qplus xi = _
  rw [hmfull xi, hqminus xi, hqplus xi]
  dsimp only [psi]
  change ((surfaceMass 2)⁻¹ : Complex) *
      (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
        surfaceFourier 2 (-t • xi)) - _ - _ = _
  rw [hsurface]
  unfold aux_circleMiddleBandpassMultiplier
  have hminus :
      circleEndpointAmplitude _root_.Auto.Spherical.MSSBase.WaveSign.minus
          (2 * Real.pi * (t * ‖xi‖)) *
        _root_.Auto.Spherical.MSSBase.halfWaveMultiplier
          _root_.Auto.Spherical.MSSBase.WaveSign.minus t xi =
        Complex.exp (((-(2 * Real.pi * (t * ‖xi‖)) : Real) : Complex) * Complex.I) *
          Auto.Spherical.FractalDilations.Auxiliary.planarEndpointQuadraticIntegral
            (2 * Real.pi * (t * ‖xi‖)) := by
    simp only [circleEndpointAmplitude,
      _root_.Auto.Spherical.MSSBase.halfWaveMultiplier,
      _root_.Auto.Spherical.MSSBase.WaveSign.toReal]
    rw [mul_comm]
    congr 1
    push_cast
    ring
  have hplus :
      circleEndpointAmplitude _root_.Auto.Spherical.MSSBase.WaveSign.plus
          (2 * Real.pi * (t * ‖xi‖)) *
        _root_.Auto.Spherical.MSSBase.halfWaveMultiplier
          _root_.Auto.Spherical.MSSBase.WaveSign.plus t xi =
        Complex.exp (((2 * Real.pi * (t * ‖xi‖) : Real) : Complex) * Complex.I) *
          Auto.Spherical.FractalDilations.Auxiliary.planarEndpointQuadraticIntegral
            (-(2 * Real.pi * (t * ‖xi‖))) := by
    simp only [circleEndpointAmplitude,
      _root_.Auto.Spherical.MSSBase.halfWaveMultiplier,
      _root_.Auto.Spherical.MSSBase.WaveSign.toReal]
    rw [mul_comm]
    congr 1
    push_cast
    ring
  have hminus' :
      ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude _root_.Auto.Spherical.MSSBase.WaveSign.minus
            (2 * Real.pi * (t * ‖xi‖)) *
          _root_.Auto.Spherical.MSSBase.halfWaveMultiplier
            _root_.Auto.Spherical.MSSBase.WaveSign.minus t xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi =
        ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          (Complex.exp (((-(2 * Real.pi * (t * ‖xi‖)) : Real) : Complex) * Complex.I) *
            Auto.Spherical.FractalDilations.Auxiliary.planarEndpointQuadraticIntegral
              (2 * Real.pi * (t * ‖xi‖))) *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi := by
    calc
      _ = ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          (circleEndpointAmplitude _root_.Auto.Spherical.MSSBase.WaveSign.minus
              (2 * Real.pi * (t * ‖xi‖)) *
            _root_.Auto.Spherical.MSSBase.halfWaveMultiplier
              _root_.Auto.Spherical.MSSBase.WaveSign.minus t xi) *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi := by ring
      _ = _ := by rw [hminus]
  have hplus' :
      ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude _root_.Auto.Spherical.MSSBase.WaveSign.plus
            (2 * Real.pi * (t * ‖xi‖)) *
          _root_.Auto.Spherical.MSSBase.halfWaveMultiplier
            _root_.Auto.Spherical.MSSBase.WaveSign.plus t xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi =
        ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          (Complex.exp (((2 * Real.pi * (t * ‖xi‖) : Real) : Complex) * Complex.I) *
            Auto.Spherical.FractalDilations.Auxiliary.planarEndpointQuadraticIntegral
              (-(2 * Real.pi * (t * ‖xi‖))) *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi) := by
    calc
      _ = ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          (circleEndpointAmplitude _root_.Auto.Spherical.MSSBase.WaveSign.plus
              (2 * Real.pi * (t * ‖xi‖)) *
            _root_.Auto.Spherical.MSSBase.halfWaveMultiplier
              _root_.Auto.Spherical.MSSBase.WaveSign.plus t xi) *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi := by ring
      _ = _ := by rw [hplus]; ring
  rw [hminus', hplus']
  ring

/-- Plancherel upgrades the full inverse-frequency middle-multiplier bound
to a fixed-time dyadic `L²` gain.  No maximal estimate is hidden here: the
conclusion is explicitly for one time, which is the harmless-remainder input
available before the time-Sobolev/local-smoothing stage. -/
theorem aux_exists_integral_norm_sq_circleMiddleWaveContribution_le_dyadicInverse
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (j : Nat) (t : Real), 1 ≤ t → t ≤ 2 →
      ∀ f : SchwartzMap (Euclidean 2) Complex,
        (∫ x : Euclidean 2, ‖circleMiddleWaveContribution C j t f x‖ ^ 2) ≤
          (B / dyadicScale j) ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨B, hB, hpoint⟩ :=
    aux_exists_norm_circleMiddleBandpassMultiplier_le_dyadicInverse C
  refine ⟨B, hB, ?_⟩
  intro j t ht htop f
  obtain ⟨m, hm⟩ := aux_exists_circleMiddleBandpassSchwartzSymbol C j t
    (zero_le_one.trans ht)
  have hm_bound (xi : Euclidean 2) : ‖m xi‖ ≤ B / dyadicScale j := by
    rw [hm xi]
    exact hpoint j t xi ht htop
  have hsymbol :
      (fun xi : Euclidean 2 => m xi * 𝓕 (f : Euclidean 2 → Complex) xi) =
        fun xi : Euclidean 2 => aux_circleMiddleBandpassMultiplier C j t xi *
          𝓕 (f : Euclidean 2 → Complex) xi := by
    funext xi
    rw [hm xi]
  have hmult := _root_.Auto.Spherical.Auxiliary.integral_norm_sq_fourierInv_schwartz_multiplier_le
    m (𝓕 f) (div_nonneg hB.le (dyadicScale_pos j).le) hm_bound
  calc
    (∫ x : Euclidean 2, ‖circleMiddleWaveContribution C j t f x‖ ^ 2) =
        ∫ x : Euclidean 2, ‖𝓕⁻ (fun xi : Euclidean 2 =>
          aux_circleMiddleBandpassMultiplier C j t xi *
            𝓕 (f : Euclidean 2 → Complex) xi) x‖ ^ 2 := by
          apply MeasureTheory.integral_congr_ae
          filter_upwards with x
          rw [aux_circleMiddleWaveContribution_eq_fourierInv_multiplier C j t f x]
    _ = ∫ x : Euclidean 2, ‖𝓕⁻ (fun xi : Euclidean 2 =>
          m xi * 𝓕 (f : Euclidean 2 → Complex) xi) x‖ ^ 2 := by
          rw [hsymbol]
    _ ≤ (B / dyadicScale j) ^ 2 *
          ∫ xi : Euclidean 2, ‖𝓕 (f : Euclidean 2 → Complex) xi‖ ^ 2 := hmult
    _ = (B / dyadicScale j) ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
          rw [_root_.Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq]

/-- The smooth coordinate middle cutoff is uniformly bounded.  The rough
constant `3` is sufficient for dominated differentiation and is obtained
directly from the two endpoint bump bounds. -/
private theorem aux_norm_coordinateMiddleMeridianCutoff_le_three (theta : Real) :
    ‖(Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianCutoff
      theta : Complex)‖ ≤ 3 := by
  let U : Real :=
    Auto.Spherical.FractalDilations.Auxiliary.coordinateUpperMeridianCutoff theta
  let L : Real :=
    Auto.Spherical.FractalDilations.Auxiliary.coordinateLowerMeridianCutoff theta
  have hU0 : 0 ≤ U := by
    dsimp only [U]
    unfold Auto.Spherical.FractalDilations.Auxiliary.coordinateUpperMeridianCutoff
      Auto.Spherical.FractalDilations.Auxiliary.endpointCoreCutoff
    exact ContDiffBump.nonneg' _ _
  have hU1 : U ≤ 1 := by
    dsimp only [U]
    unfold Auto.Spherical.FractalDilations.Auxiliary.coordinateUpperMeridianCutoff
      Auto.Spherical.FractalDilations.Auxiliary.endpointCoreCutoff
    exact ContDiffBump.le_one _
  have hL0 : 0 ≤ L := by
    dsimp only [L]
    unfold Auto.Spherical.FractalDilations.Auxiliary.coordinateLowerMeridianCutoff
      Auto.Spherical.FractalDilations.Auxiliary.endpointCoreCutoff
    exact ContDiffBump.nonneg' _ _
  have hL1 : L ≤ 1 := by
    dsimp only [L]
    unfold Auto.Spherical.FractalDilations.Auxiliary.coordinateLowerMeridianCutoff
      Auto.Spherical.FractalDilations.Auxiliary.endpointCoreCutoff
    exact ContDiffBump.le_one _
  rw [Complex.norm_real, Real.norm_eq_abs]
  change |1 - U - L| ≤ 3
  calc
    |1 - U - L| ≤ |1| + |U| + |L| := by
      rw [show 1 - U - L = 1 + (-U) + (-L) by ring]
      calc
        |1 + -U + -L| ≤ |1 + -U| + |-L| := abs_add_le _ _
        _ ≤ (|1| + |-U|) + |-L| := by gcongr; exact abs_add_le _ _
        _ = |1| + |U| + |L| := by rw [abs_neg, abs_neg]
    _ = 1 + U + L := by rw [abs_of_nonneg hU0, abs_of_nonneg hL0]; norm_num
    _ ≤ 3 := by linarith

/-- The frequency derivative of the literal middle meridian. -/
noncomputable def aux_circleMiddleMeridianFrequencyDerivative (l : Real) : Complex :=
  ∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
    (Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianCutoff
      theta : Complex) *
      Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I) *
        (((-Real.sin theta : Real) : Complex) * Complex.I)

/-- Differentiation under the compact meridian integral identifies the
frequency derivative of the middle term. -/
theorem aux_hasDerivAt_circleMiddleMeridianLocalizedIntegral_zero
    (l : Real) :
    HasDerivAt
      (Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianLocalizedIntegral 0)
      (aux_circleMiddleMeridianFrequencyDerivative l) l := by
  let a : Real := -(Real.pi / 2)
  let b : Real := Real.pi / 2
  let F : Real → Real → Complex := fun u theta =>
    (Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianCutoff
      theta : Complex) *
      Complex.exp (((-u * Real.sin theta : Real) : Complex) * Complex.I)
  let F' : Real → Real → Complex := fun u theta =>
    (Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianCutoff
      theta : Complex) *
      Complex.exp (((-u * Real.sin theta : Real) : Complex) * Complex.I) *
        (((-Real.sin theta : Real) : Complex) * Complex.I)
  have hab : a ≤ b := by
    dsimp [a, b]
    linarith [Real.pi_pos]
  have hcutcont : Continuous (fun theta : Real =>
      (Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianCutoff
        theta : Complex)) :=
    Complex.continuous_ofReal.comp
      Auto.Spherical.FractalDilations.Auxiliary.contDiff_coordinateMiddleMeridianCutoff.continuous
  have hmiddle_eq (u : Real) :
      Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianLocalizedIntegral 0 u =
        ∫ theta in a..b, F u theta := by
    rw [Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianLocalizedIntegral_eq_middle_cutoff]
    apply intervalIntegral.integral_congr
    intro theta _
    dsimp [a, b, F]
    simp
  have hmiddle_deriv_eq :
      aux_circleMiddleMeridianFrequencyDerivative l = ∫ theta in a..b, F' l theta := by
    rfl
  have hEcont (u : Real) : Continuous (fun theta : Real =>
      Complex.exp (((-u * Real.sin theta : Real) : Complex) * Complex.I)) := by
    fun_prop
  have hFcont (u : Real) : Continuous (F u) := by
    dsimp [F]
    exact hcutcont.mul (hEcont u)
  have hF'cont (u : Real) : Continuous (F' u) := by
    dsimp [F']
    exact (hcutcont.mul (hEcont u)).mul (by fun_prop)
  have h := hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := volume.restrict (Ioc a b)) (s := Set.univ) (x₀ := l)
    (bound := fun _ : Real => (3 : Real))
    (F := F) (F' := F') Filter.univ_mem ?_ ?_ ?_ ?_ ?_ ?_
  · rw [show Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianLocalizedIntegral 0 =
        fun u : Real => ∫ theta in a..b, F u theta by
          funext u
          exact hmiddle_eq u,
      hmiddle_deriv_eq]
    simp_rw [intervalIntegral.integral_of_le hab]
    exact h.2
  · filter_upwards [] with u
    exact (hFcont u).aestronglyMeasurable
  · refine Integrable.of_bound ?_ 3 ?_
    · exact (hFcont l).aestronglyMeasurable
    · filter_upwards with theta
      dsimp [F]
      rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one]
      exact aux_norm_coordinateMiddleMeridianCutoff_le_three theta
  · exact (hF'cont l).aestronglyMeasurable
  · filter_upwards with theta
    intro u hu
    dsimp [F']
    have hsin : ‖(((-Real.sin theta : Real) : Complex) * Complex.I)‖ ≤ 1 := by
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, Complex.norm_I, mul_one]
      simpa using Real.abs_sin_le_one theta
    rw [norm_mul, norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one]
    calc
      ‖(Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianCutoff
          theta : Complex)‖ * ‖(((-Real.sin theta : Real) : Complex) * Complex.I)‖ ≤ 3 * 1 :=
        mul_le_mul (aux_norm_coordinateMiddleMeridianCutoff_le_three theta)
          hsin (norm_nonneg _) (by norm_num)
      _ = 3 := by norm_num
  · exact integrableOn_const (hs := measure_Ioc_lt_top.ne)
  · filter_upwards with theta
    intro u hu
    dsimp [F, F']
    have harg : HasDerivAt
        (fun v : Real => ((-v * Real.sin theta : Real) : Complex) * Complex.I)
        (((-Real.sin theta : Real) : Complex) * Complex.I) u := by
      have hreal : HasDerivAt (fun v : Real => -v * Real.sin theta)
          (-Real.sin theta) u := by
        simpa [mul_comm] using (hasDerivAt_id u).mul_const (-Real.sin theta)
      simpa only [Complex.real_smul] using hreal.smul_const Complex.I
    have hexp := harg.cexp
    simpa [mul_assoc, mul_left_comm, mul_comm] using
      hexp.const_mul
        (Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianCutoff
          theta : Complex)

/-- The compact meridian sine moments used to record all parameter
derivatives of the literal middle factor. -/
noncomputable def aux_circleMiddleSineMoment (n : Nat) (l : Real) : Complex :=
  ∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
    (Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianCutoff
      theta : Complex) *
      ((Real.sin theta ^ n : Real) : Complex) *
        Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I)

private theorem aux_circleMiddleSineMoment_zero_eq_middle (l : Real) :
    aux_circleMiddleSineMoment 0 l =
      Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianLocalizedIntegral
        0 l := by
  rw [Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianLocalizedIntegral_eq_middle_cutoff]
  unfold aux_circleMiddleSineMoment
  apply intervalIntegral.integral_congr
  intro theta _
  simp

private theorem aux_exists_pos_norm_circleMiddleSineMomentAmplitude_le
    (n : Nat) :
    ∃ M : Real, 0 < M ∧ ∀ theta ∈ Icc (-(Real.pi / 2) : Real) (Real.pi / 2),
      ‖(Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianCutoff
          theta : Complex) * ((Real.sin theta ^ n : Real) : Complex)‖ ≤ M := by
  let A : Real → Complex := fun theta =>
    (Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianCutoff
      theta : Complex) * ((Real.sin theta ^ n : Real) : Complex)
  have hcut : Continuous (fun theta : Real =>
      (Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianCutoff
        theta : Complex)) :=
    Complex.continuous_ofReal.comp
      Auto.Spherical.FractalDilations.Auxiliary.contDiff_coordinateMiddleMeridianCutoff.continuous
  have hA : Continuous A := by
    dsimp [A]
    exact hcut.mul (by fun_prop)
  have hbounded : Bornology.IsBounded
      (A '' Icc (-(Real.pi / 2) : Real) (Real.pi / 2)) :=
    (isCompact_Icc.image_of_continuousOn hA.continuousOn).isBounded
  rcases hbounded.exists_pos_norm_le with ⟨M, hM, hbound⟩
  exact ⟨M, hM, fun theta htheta => hbound _ (mem_image_of_mem _ htheta)⟩

private theorem aux_hasDerivAt_circleMiddleSineMoment
    (n : Nat) (l : Real) :
    HasDerivAt (aux_circleMiddleSineMoment n)
      (-Complex.I * aux_circleMiddleSineMoment (n + 1) l) l := by
  obtain ⟨M, hM, hMbound⟩ :=
    aux_exists_pos_norm_circleMiddleSineMomentAmplitude_le (n + 1)
  let F : Real → Real → Complex := fun u theta =>
    (Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianCutoff
      theta : Complex) *
      ((Real.sin theta ^ n : Real) : Complex) *
        Complex.exp (((-u * Real.sin theta : Real) : Complex) * Complex.I)
  let F' : Real → Real → Complex := fun u theta =>
    -Complex.I *
      ((Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianCutoff
        theta : Complex) *
        ((Real.sin theta ^ (n + 1) : Real) : Complex) *
          Complex.exp (((-u * Real.sin theta : Real) : Complex) * Complex.I))
  let a : Real := -(Real.pi / 2)
  let b : Real := Real.pi / 2
  have hab : a ≤ b := by
    dsimp [a, b]
    linarith [Real.pi_pos]
  have hFcont (u : Real) : Continuous (F u) := by
    dsimp [F]
    have hcut : Continuous (fun theta : Real =>
        (Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianCutoff
          theta : Complex)) :=
      Complex.continuous_ofReal.comp
        Auto.Spherical.FractalDilations.Auxiliary.contDiff_coordinateMiddleMeridianCutoff.continuous
    have hsin : Continuous (fun theta : Real => ((Real.sin theta ^ n : Real) : Complex)) := by
      fun_prop
    have hexp : Continuous (fun theta : Real =>
        Complex.exp (((-u * Real.sin theta : Real) : Complex) * Complex.I)) := by
      fun_prop
    exact (hcut.mul hsin).mul hexp
  have hF'cont (u : Real) : Continuous (F' u) := by
    dsimp [F']
    have hcut : Continuous (fun theta : Real =>
        (Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianCutoff
          theta : Complex)) :=
      Complex.continuous_ofReal.comp
        Auto.Spherical.FractalDilations.Auxiliary.contDiff_coordinateMiddleMeridianCutoff.continuous
    have hsin : Continuous (fun theta : Real =>
        ((Real.sin theta ^ (n + 1) : Real) : Complex)) := by
      fun_prop
    have hexp : Continuous (fun theta : Real =>
        Complex.exp (((-u * Real.sin theta : Real) : Complex) * Complex.I)) := by
      fun_prop
    exact continuous_const.mul ((hcut.mul hsin).mul hexp)
  change HasDerivAt (fun u : Real => ∫ theta in a..b, F u theta)
    (-Complex.I * aux_circleMiddleSineMoment (n + 1) l) l
  have hparam := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := volume) (a := a) (b := b) (s := Set.univ) (x₀ := l)
    (bound := fun _ : Real => M) (F := F) (F' := F') Filter.univ_mem
    (by
      filter_upwards [] with u
      exact (hFcont u).aestronglyMeasurable)
    ((hFcont l).intervalIntegrable a b)
    ((hF'cont l).aestronglyMeasurable)
    (by
      filter_upwards with theta
      intro htheta u hu
      have htheta' : theta ∈ Icc (-(Real.pi / 2) : Real) (Real.pi / 2) := by
        rw [uIoc_of_le hab] at htheta
        exact ⟨by simpa [a, b] using htheta.1.le,
          by simpa [a, b] using htheta.2⟩
      have hbase := hMbound theta htheta'
      dsimp [F']
      simpa only [norm_mul, norm_neg, Complex.norm_I, one_mul,
        Complex.norm_exp_ofReal_mul_I, mul_one] using hbase)
    ((by fun_prop : Continuous (fun _ : Real => M)).intervalIntegrable a b)
    (by
      filter_upwards with theta
      intro htheta u hu
      have hreal : HasDerivAt (fun v : Real => -v * Real.sin theta)
          (-Real.sin theta) u := by
        simpa [mul_comm] using (hasDerivAt_id u).const_mul (-Real.sin theta)
      have harg : HasDerivAt
          (fun v : Real => ((-v * Real.sin theta : Real) : Complex) * Complex.I)
          (((-Real.sin theta : Real) : Complex) * Complex.I) u := by
        simpa only [Complex.real_smul] using hreal.smul_const Complex.I
      dsimp [F, F']
      have h := (harg.cexp).const_mul
        ((Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianCutoff
          theta : Complex) * ((Real.sin theta ^ n : Real) : Complex))
      simpa [pow_succ, mul_assoc, mul_left_comm, mul_comm] using h)
  have hF'int :
      (∫ theta in a..b, F' l theta) =
        -Complex.I * aux_circleMiddleSineMoment (n + 1) l := by
    unfold aux_circleMiddleSineMoment
    rw [← intervalIntegral.integral_const_mul]
  rw [hF'int] at hparam
  exact hparam.2

private theorem aux_iteratedDeriv_circleMiddleSineMoment
    (n k : Nat) :
    iteratedDeriv k (aux_circleMiddleSineMoment n) =
      fun l => (-Complex.I) ^ k * aux_circleMiddleSineMoment (n + k) l := by
  induction k with
  | zero =>
      ext l
      simp [iteratedDeriv]
  | succ k ih =>
      rw [iteratedDeriv_succ, ih]
      funext l
      rw [deriv_const_mul_field,
        (aux_hasDerivAt_circleMiddleSineMoment (n + k) l).deriv]
      simp only [Nat.succ_eq_add_one, pow_succ]
      ring

private theorem aux_contDiff_circleMiddleSineMoment
    (n : Nat) :
    ContDiff Real (⊤ : ℕ∞) (aux_circleMiddleSineMoment n) := by
  apply contDiff_of_differentiable_iteratedDeriv
  intro k _
  rw [aux_iteratedDeriv_circleMiddleSineMoment]
  have hd : Differentiable Real
      (fun l => aux_circleMiddleSineMoment (n + k) l) := fun l =>
    (aux_hasDerivAt_circleMiddleSineMoment (n + k) l).differentiableAt
  exact hd.const_mul ((-Complex.I) ^ k)

private theorem aux_circleMiddleMeridianFrequencyDerivative_eq_sineMoment
    (l : Real) :
    aux_circleMiddleMeridianFrequencyDerivative l =
      -Complex.I * aux_circleMiddleSineMoment 1 l := by
  unfold aux_circleMiddleMeridianFrequencyDerivative aux_circleMiddleSineMoment
  rw [← intervalIntegral.integral_const_mul]
  apply intervalIntegral.integral_congr
  intro theta _
  push_cast
  ring

private theorem aux_contDiff_circleMiddleMeridianFrequencyDerivative :
    ContDiff Real (⊤ : ℕ∞) aux_circleMiddleMeridianFrequencyDerivative := by
  rw [show aux_circleMiddleMeridianFrequencyDerivative =
      fun l => -Complex.I * aux_circleMiddleSineMoment 1 l by
        funext l
        exact aux_circleMiddleMeridianFrequencyDerivative_eq_sineMoment l]
  exact contDiff_const.mul (aux_contDiff_circleMiddleSineMoment 1)

/-- One nonstationary integration by parts on the meridian, stated for an
arbitrary smooth amplitude which vanishes at the two poles.  The phase
derivative vanishes at the poles, so the formulation deliberately puts the
cosine factor in the integrand rather than dividing there. -/
private theorem aux_meridian_nonstationary_ibp
    (A : Real → Complex) (hA : ContDiff Real (⊤ : ℕ∞) A)
    (hends : A (-(Real.pi / 2)) = 0 ∧ A (Real.pi / 2) = 0)
    {l : Real} (hl : l ≠ 0) :
    (∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
      A theta * ((Real.cos theta : Real) : Complex) *
        Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I)) =
      -((((-l : Real) : Complex) * Complex.I)⁻¹) *
        ∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
          deriv A theta *
            Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I) := by
  let a : Real := -(Real.pi / 2)
  let b : Real := Real.pi / 2
  let E : Real → Complex := fun theta =>
    Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I)
  let q : Complex := ((-l : Real) : Complex) * Complex.I
  let s : Complex := q⁻¹
  let A' : Real → Complex := fun theta => deriv A theta
  have hq : q ≠ 0 := by
    dsimp [q]
    exact mul_ne_zero (Complex.ofReal_ne_zero.mpr (neg_ne_zero.mpr hl))
      Complex.I_ne_zero
  have hsq : s * q = 1 := by
    dsimp [s]
    exact inv_mul_cancel₀ hq
  have hAderiv : ∀ theta ∈ uIcc a b, HasDerivAt A (A' theta) theta := by
    intro theta _
    exact ((hA.differentiable (by simp) theta).hasDerivAt)
  have hE : ∀ theta ∈ uIcc a b,
      HasDerivAt E (E theta * (q * (Real.cos theta : Complex))) theta := by
    intro theta _
    dsimp [E, q]
    have hreal : HasDerivAt (fun x : Real => -l * Real.sin x)
        (-l * Real.cos theta) theta := by
      simpa [mul_comm] using (Real.hasDerivAt_sin theta).const_mul (-l)
    have harg : HasDerivAt
        (fun x : Real => ((-l * Real.sin x : Real) : Complex) * Complex.I)
        (((-l * Real.cos theta : Real) : Complex) * Complex.I) theta := by
      simpa only [Complex.real_smul] using hreal.smul_const Complex.I
    simpa [mul_assoc, mul_left_comm, mul_comm] using harg.cexp
  have hV : ∀ theta ∈ uIcc a b,
      HasDerivAt (fun x : Real => s * E x)
        (E theta * (Real.cos theta : Complex)) theta := by
    intro theta htheta
    have h := (hE theta htheta).const_mul s
    have hcancel : s * (E theta * (q * (Real.cos theta : Complex))) =
        E theta * (Real.cos theta : Complex) := by
      calc
        s * (E theta * (q * (Real.cos theta : Complex))) =
            (s * q) * (E theta * (Real.cos theta : Complex)) := by ring
        _ = E theta * (Real.cos theta : Complex) := by rw [hsq, one_mul]
    simpa only [hcancel] using h
  have hA'cont : Continuous A' := by
    dsimp [A']
    exact hA.continuous_deriv (by simp)
  have hV'cont : Continuous (fun theta : Real =>
      E theta * (Real.cos theta : Complex)) := by
    dsimp [E]
    fun_prop
  have hparts := intervalIntegral.integral_mul_deriv_eq_deriv_mul
    (u := A) (u' := A') (v := fun theta : Real => s * E theta)
    (v' := fun theta : Real => E theta * (Real.cos theta : Complex))
    hAderiv hV (hA'cont.intervalIntegrable a b) (hV'cont.intervalIntegrable a b)
  have hboundary :
      A b * (s * E b) - A a * (s * E a) = 0 := by
    dsimp [a, b]
    rw [hends.1, hends.2]
    ring
  have hright :
      (∫ theta in a..b, A' theta * (s * E theta)) =
        s * ∫ theta in a..b, A' theta * E theta := by
    rw [← intervalIntegral.integral_const_mul]
    refine intervalIntegral.integral_congr (fun theta _ => ?_)
    ring
  calc
    (∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
      A theta * ((Real.cos theta : Real) : Complex) *
        Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I)) =
      ∫ theta in a..b, A theta * (E theta * (Real.cos theta : Complex)) := by
        apply intervalIntegral.integral_congr
        intro theta _
        dsimp [a, b, E]
        ring
    _ = A b * (s * E b) - A a * (s * E a) -
        ∫ theta in a..b, A' theta * (s * E theta) := hparts
    _ = -s * ∫ theta in a..b, A' theta * E theta := by
      rw [hboundary, hright]
      ring
    _ = -((((-l : Real) : Complex) * Complex.I)⁻¹) *
        ∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
          deriv A theta *
            Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I) := by
      rfl

/-- A smooth pole-vanishing meridian amplitude has the basic `|l|⁻¹`
nonstationary bound. -/
private theorem aux_exists_meridian_nonstationary_decay
    (A : Real → Complex) (hA : ContDiff Real (⊤ : ℕ∞) A)
    (hends : A (-(Real.pi / 2)) = 0 ∧ A (Real.pi / 2) = 0) :
    ∃ C : Real, 0 < C ∧ ∀ l : Real, 1 ≤ |l| →
      ‖∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
        A theta * ((Real.cos theta : Real) : Complex) *
          Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I)‖ ≤ C / |l| := by
  let A' : Real → Complex := fun theta => deriv A theta
  have hA'cont : Continuous A' := by
    dsimp [A']
    exact hA.continuous_deriv (by simp)
  have hcompact : IsCompact
      (A' '' Icc (-(Real.pi / 2) : Real) (Real.pi / 2)) :=
    isCompact_Icc.image_of_continuousOn hA'cont.continuousOn
  rcases hcompact.isBounded.exists_pos_norm_le with ⟨M, hM, hMbound⟩
  refine ⟨Real.pi * M, mul_pos Real.pi_pos hM, ?_⟩
  intro l hl
  have hlne : l ≠ 0 := by
    intro hzero
    rw [hzero, abs_zero] at hl
    norm_num at hl
  have hinv : ‖-((((-l : Real) : Complex) * Complex.I)⁻¹)‖ = 1 / |l| := by
    rw [norm_neg, norm_inv, norm_mul, Complex.norm_real, Complex.norm_I,
      mul_one, Real.norm_eq_abs, abs_neg]
    exact inv_eq_one_div _
  have hlength : |(Real.pi / 2 : Real) - -(Real.pi / 2)| = Real.pi := by
    rw [abs_of_nonneg]
    · ring
    · nlinarith [Real.pi_pos]
  have hint :
      ‖∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
          deriv A theta *
            Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I)‖ ≤
        M * Real.pi := by
    calc
      ‖∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
          deriv A theta *
            Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I)‖ ≤
          M * |(Real.pi / 2 : Real) - -(Real.pi / 2)| := by
            apply intervalIntegral.norm_integral_le_of_norm_le_const
            intro theta htheta
            have htheta' : theta ∈ Icc (-(Real.pi / 2) : Real) (Real.pi / 2) := by
              rw [uIoc_of_le (by linarith [Real.pi_pos])] at htheta
              exact ⟨htheta.1.le, htheta.2⟩
            rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one]
            exact hMbound _ (mem_image_of_mem _ htheta')
      _ = M * Real.pi := by rw [hlength]
  rw [aux_meridian_nonstationary_ibp A hA hends hlne]
  calc
    ‖-((((-l : Real) : Complex) * Complex.I)⁻¹) *
        ∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
          deriv A theta *
            Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I)‖ =
      ‖-((((-l : Real) : Complex) * Complex.I)⁻¹)‖ *
        ‖∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
          deriv A theta *
            Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I)‖ := by
        rw [norm_mul]
    _ ≤ (1 / |l|) * (M * Real.pi) := by
      rw [hinv]
      exact mul_le_mul_of_nonneg_left hint (by positivity)
    _ = (Real.pi * M) / |l| := by ring

/-- The frequency derivative of the middle meridian has the same
nonstationary `|l|⁻¹` decay as the middle meridian itself.  The key point is
that the derivative's sine factor is absorbed into the already guarded
cosine quotient before one more elementary meridian integration by parts. -/
theorem aux_exists_norm_circleMiddleMeridianFrequencyDerivative_decay_one :
    ∃ C : Real, 0 < C ∧ ∀ l : Real, 1 ≤ |l| →
      ‖aux_circleMiddleMeridianFrequencyDerivative l‖ ≤ C / |l| := by
  let A : Real → Complex :=
    Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleIBPAmplitude 0
  let B : Real → Complex := fun theta =>
    A theta * (((-Real.sin theta : Real) : Complex) * Complex.I)
  have hB : ContDiff Real (⊤ : ℕ∞) B := by
    dsimp [B, A]
    refine Auto.Spherical.FractalDilations.Auxiliary.contDiff_coordinateMiddleIBPAmplitude 0 |>.mul ?_
    exact (Complex.ofRealCLM.contDiff.comp Real.contDiff_sin.neg).mul contDiff_const
  have hends : B (-(Real.pi / 2)) = 0 ∧ B (Real.pi / 2) = 0 := by
    rcases Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleIBPAmplitude_eq_zero_at_meridian_endpoints
      0 with ⟨hleft, hright⟩
    constructor
    · simp [B, A, hleft]
    · simp [B, A, hright]
  obtain ⟨C, hC, hdecay⟩ := aux_exists_meridian_nonstationary_decay B hB hends
  refine ⟨C, hC, ?_⟩
  intro l hl
  have hidentity : aux_circleMiddleMeridianFrequencyDerivative l =
      ∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
        B theta * ((Real.cos theta : Real) : Complex) *
          Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I) := by
    unfold aux_circleMiddleMeridianFrequencyDerivative
    apply intervalIntegral.integral_congr
    intro theta htheta
    have htheta' : theta ∈ Icc (-(Real.pi / 2) : Real) (Real.pi / 2) := by
      rw [uIcc_of_le (by linarith [Real.pi_pos])] at htheta
      exact htheta
    have hmiddle := Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleIBPAmplitude_mul_cos_eq_middle
      0 htheta'
    have hmiddle' : A theta * ((Real.cos theta : Real) : Complex) =
        (Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianCutoff
          theta : Complex) := by
      dsimp [A]
      simpa using hmiddle
    dsimp [B]
    rw [← hmiddle']
    ring
  rw [hidentity]
  exact hdecay l hl

/-- Chain rule for the middle meridian along the radial time-frequency
parameter. -/
theorem aux_hasDerivAt_circleMiddleMeridian_timeParameter
    (t : Real) (xi : Euclidean 2) :
    HasDerivAt
      (fun s : Real =>
        Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianLocalizedIntegral
          0 (2 * Real.pi * (s * ‖xi‖)))
      (((2 * Real.pi * ‖xi‖ : Real) : Complex) *
        aux_circleMiddleMeridianFrequencyDerivative (2 * Real.pi * (t * ‖xi‖))) t := by
  have harg : HasDerivAt (fun s : Real => 2 * Real.pi * (s * ‖xi‖))
      (2 * Real.pi * ‖xi‖) t := by
    simpa [mul_assoc] using
      ((hasDerivAt_id t).mul_const ‖xi‖).const_mul (2 * Real.pi)
  have hcomp :=
    (aux_hasDerivAt_circleMiddleMeridianLocalizedIntegral_zero
      (2 * Real.pi * (t * ‖xi‖))).scomp t harg
  change HasDerivAt
    (Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianLocalizedIntegral 0 ∘
      fun s : Real => 2 * Real.pi * (s * ‖xi‖))
    (((2 * Real.pi * ‖xi‖ : Real) : Complex) *
      aux_circleMiddleMeridianFrequencyDerivative (2 * Real.pi * (t * ‖xi‖))) t
  exact hcomp

/-- On the high-frequency, unit-time range, the radial time derivative of
the scalar middle meridian is uniformly bounded.  Its factor `‖xi‖` is
cancelled by the proven `|l|⁻¹` nonstationary decay of the frequency
derivative. -/
theorem aux_exists_norm_circleMiddleMeridian_timeDerivative_le_one :
    ∃ C : Real, 0 < C ∧ ∀ (t : Real) (xi : Euclidean 2), 1 ≤ t →
      1 ≤ 2 * Real.pi * (t * ‖xi‖) →
      ‖((2 * Real.pi * ‖xi‖ : Real) : Complex) *
        aux_circleMiddleMeridianFrequencyDerivative (2 * Real.pi * (t * ‖xi‖))‖ ≤ C := by
  obtain ⟨C, hC, hdecay⟩ :=
    aux_exists_norm_circleMiddleMeridianFrequencyDerivative_decay_one
  refine ⟨C, hC, ?_⟩
  intro t xi ht hlambda
  let R : Real := 2 * Real.pi * ‖xi‖
  let L : Real := 2 * Real.pi * (t * ‖xi‖)
  have htpos : 0 < t := lt_of_lt_of_le zero_lt_one ht
  have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one hlambda
  have hnormpos : 0 < ‖xi‖ := by
    by_contra hnot
    have hnormzero : ‖xi‖ = 0 := le_antisymm (le_of_not_gt hnot) (norm_nonneg _)
    have hLzero : L = 0 := by
      dsimp [L]
      rw [hnormzero]
      ring
    linarith
  have hRpos : 0 < R := by
    dsimp [R]
    positivity
  have hRle : R ≤ L := by
    dsimp [R, L]
    have htnorm : ‖xi‖ ≤ t * ‖xi‖ :=
      le_mul_of_one_le_left (norm_nonneg xi) ht
    exact mul_le_mul_of_nonneg_left htnorm (by positivity)
  have hderiv : ‖aux_circleMiddleMeridianFrequencyDerivative L‖ ≤ C / L := by
    have h := hdecay L (by rwa [abs_of_nonneg hLpos.le])
    simpa only [abs_of_nonneg hLpos.le] using h
  have hratio : R * (C / L) ≤ C := by
    calc
      R * (C / L) ≤ R * (C / R) :=
        mul_le_mul_of_nonneg_left
          (div_le_div_of_nonneg_left hC.le hRpos hRle) hRpos.le
      _ = C := by field_simp [hRpos.ne']
  change ‖(R : Complex) * aux_circleMiddleMeridianFrequencyDerivative L‖ ≤ C
  rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg hRpos.le]
  calc
    R * ‖aux_circleMiddleMeridianFrequencyDerivative L‖ ≤ R * (C / L) :=
      mul_le_mul_of_nonneg_left hderiv hRpos.le
    _ ≤ C := hratio

/-- The literal time derivative multiplier for the dyadic middle wave. -/
noncomputable def aux_circleMiddleBandpassMultiplierTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) : Euclidean 2 → Complex :=
  fun xi =>
    ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      (((2 * Real.pi * ‖xi‖ : Real) : Complex) *
        aux_circleMiddleMeridianFrequencyDerivative (2 * Real.pi * (t * ‖xi‖))) *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi

/-- The preceding multiplier is the genuine time derivative of the literal
middle dyadic multiplier. -/
theorem aux_hasDerivAt_circleMiddleBandpassMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (xi : Euclidean 2) :
    HasDerivAt (fun s : Real => aux_circleMiddleBandpassMultiplier C j s xi)
      (aux_circleMiddleBandpassMultiplierTimeDerivative C j t xi) t := by
  let c : Complex := ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex)
  let b : Complex :=
    _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi
  have hscalar := aux_hasDerivAt_circleMiddleMeridian_timeParameter t xi
  have hproduct := (hscalar.const_mul c).mul_const b
  change HasDerivAt (fun s : Real => c *
      Auto.Spherical.FractalDilations.Auxiliary.coordinateMiddleMeridianLocalizedIntegral
        0 (2 * Real.pi * (s * ‖xi‖)) * b)
    (c * (((2 * Real.pi * ‖xi‖ : Real) : Complex) *
      aux_circleMiddleMeridianFrequencyDerivative (2 * Real.pi * (t * ‖xi‖))) * b) t
  exact hproduct

/-- Uniform pointwise control of the literal time derivative multiplier once
the radial frequency is at least one. -/
theorem aux_exists_norm_circleMiddleBandpassMultiplierTimeDerivative_le_of_frequency
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (j : Nat) (t : Real) (xi : Euclidean 2), 1 ≤ t →
      1 ≤ 2 * Real.pi * (t * ‖xi‖) →
      ‖aux_circleMiddleBandpassMultiplierTimeDerivative C j t xi‖ ≤ B := by
  obtain ⟨A, hA, htime⟩ := aux_exists_norm_circleMiddleMeridian_timeDerivative_le_one
  let K : Real := ‖((surfaceMass 2)⁻¹ : Complex)‖ * surfaceMass 1
  let B : Real := 2 * K * A
  have hmass2 : ((surfaceMass 2 : Real) : Complex) ≠ 0 := by
    exact_mod_cast surfaceMass_ne_zero (by norm_num : 0 < 2)
  have hK : 0 < K := by
    dsimp only [K]
    have hinv : 0 < ‖((surfaceMass 2)⁻¹ : Complex)‖ :=
      norm_pos_iff.mpr (inv_ne_zero hmass2)
    have hmass1 : 0 < surfaceMass 1 := surfaceMass_pos (by norm_num)
    positivity
  refine ⟨B, by dsimp only [B]; positivity, ?_⟩
  intro j t xi ht hlambda
  have hcut :
      ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ ≤ 2 :=
    _root_.Auto.LittlewoodPaley.norm_dyadicBandpassMultiplier_le_two C j xi
  have hscalar := htime t xi ht hlambda
  have hinner :
      ‖((2 * Real.pi * ‖xi‖ : Real) : Complex) *
          aux_circleMiddleMeridianFrequencyDerivative (2 * Real.pi * (t * ‖xi‖))‖ *
        ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ ≤ A * 2 :=
    mul_le_mul hscalar hcut (norm_nonneg _) (by positivity)
  have hmass1 : 0 ≤ surfaceMass 1 := (surfaceMass_pos (by norm_num)).le
  calc
    ‖aux_circleMiddleBandpassMultiplierTimeDerivative C j t xi‖ =
        K *
          ‖((2 * Real.pi * ‖xi‖ : Real) : Complex) *
            aux_circleMiddleMeridianFrequencyDerivative (2 * Real.pi * (t * ‖xi‖))‖ *
          ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ := by
          unfold aux_circleMiddleBandpassMultiplierTimeDerivative
          rw [norm_mul, norm_mul, norm_mul, Complex.norm_real,
            Real.norm_of_nonneg hmass1]
    _ = K *
        (‖((2 * Real.pi * ‖xi‖ : Real) : Complex) *
            aux_circleMiddleMeridianFrequencyDerivative (2 * Real.pi * (t * ‖xi‖))‖ *
          ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖) := by ring
    _ ≤ K * (A * 2) := mul_le_mul_of_nonneg_left hinner hK.le
    _ = B := by dsimp only [B]; ring

/-- On the active dyadic band at unit-scale time, the literal middle time
derivative multiplier has a uniform pointwise bound. -/
theorem aux_exists_norm_circleMiddleBandpassMultiplierTimeDerivative_le_on_dyadicBandpass
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (j : Nat) (t : Real) (xi : Euclidean 2),
      1 ≤ t → t ≤ 2 →
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi ≠ 0 →
      ‖aux_circleMiddleBandpassMultiplierTimeDerivative C j t xi‖ ≤ B := by
  obtain ⟨B, hB, hbound⟩ :=
    aux_exists_norm_circleMiddleBandpassMultiplierTimeDerivative_le_of_frequency C
  refine ⟨B, hB, ?_⟩
  intro j t xi ht htop hband
  apply hbound j t xi ht
  have hfrequency : dyadicScale j ≤ 2 * Real.pi * (t * ‖xi‖) :=
    aux_dyadicFrequency_le_circleEndpointFrequency C j t xi ht hband
  have hone : 1 ≤ dyadicScale j := by
    calc
      1 = dyadicScale 0 := by simp [dyadicScale]
      _ ≤ dyadicScale j := dyadicScale_mono (Nat.zero_le j)
  exact hone.trans hfrequency

private theorem aux_circleMiddleBandpassMultiplierTimeDerivative_eventuallyEq_zero_at_zero
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) :
    aux_circleMiddleBandpassMultiplierTimeDerivative C j t =ᶠ[nhds 0] fun _ => 0 := by
  filter_upwards [Metric.ball_mem_nhds (0 : Euclidean 2) zero_lt_one] with xi hxi
  have hxinorm : ‖xi‖ < 1 := by
    simpa only [Metric.mem_ball, dist_zero_right] using hxi
  have hone : 1 ≤ (2 : Real) ^ j :=
    one_le_pow₀ (by norm_num : (1 : Real) ≤ 2)
  have hband :
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0 :=
    _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_norm_le C
      (hxinorm.le.trans hone)
  simp [aux_circleMiddleBandpassMultiplierTimeDerivative, hband]

private theorem aux_contDiff_circleMiddleBandpassMultiplierTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) :
    ContDiff Real (⊤ : ℕ∞)
      (aux_circleMiddleBandpassMultiplierTimeDerivative C j t) := by
  rw [contDiff_iff_contDiffAt]
  intro xi
  by_cases hxi : xi = 0
  · subst xi
    exact (contDiffAt_const (c := (0 : Complex))).congr_of_eventuallyEq
      (aux_circleMiddleBandpassMultiplierTimeDerivative_eventuallyEq_zero_at_zero C j t)
  · have hnorm : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 => ‖eta‖) xi :=
      contDiffAt_norm Real hxi
    have hscale : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
        ((2 * Real.pi * ‖eta‖ : Real) : Complex)) xi := by
      have hscaleReal : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
          2 * Real.pi * ‖eta‖) xi := by
        fun_prop
      exact Complex.ofRealCLM.contDiff.contDiffAt.comp xi hscaleReal
    have harg : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
        2 * Real.pi * (t * ‖eta‖)) xi := by
      fun_prop
    have hfrequency : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
        aux_circleMiddleMeridianFrequencyDerivative
          (2 * Real.pi * (t * ‖eta‖))) xi :=
      aux_contDiff_circleMiddleMeridianFrequencyDerivative.contDiffAt.comp xi harg
    have hcut : ContDiffAt Real (⊤ : ℕ∞)
        (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j) xi :=
      ((_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j).smooth
        (⊤ : ℕ∞)).contDiffAt
    unfold aux_circleMiddleBandpassMultiplierTimeDerivative
    exact (((contDiffAt_const.mul contDiffAt_const).mul
      (hscale.mul hfrequency)).mul hcut)

private theorem aux_hasCompactSupport_circleMiddleBandpassMultiplierTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) :
    HasCompactSupport (aux_circleMiddleBandpassMultiplierTimeDerivative C j t) := by
  apply HasCompactSupport.intro
    (isCompact_closedBall (0 : Euclidean 2) ((2 : Real) ^ (j + 2)))
  intro xi hxi
  have hnorm : (2 : Real) ^ (j + 2) ≤ ‖xi‖ := by
    rw [Metric.mem_closedBall, dist_zero_right] at hxi
    exact le_of_not_ge hxi
  have hband :
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0 :=
    _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_le_norm C hnorm
  simp [aux_circleMiddleBandpassMultiplierTimeDerivative, hband]

/-- The compactly frequency-localized time derivative of the middle wave as
a genuine Schwartz multiplier. -/
noncomputable def aux_circleMiddleBandpassMultiplierTimeDerivativeSchwartzSymbol
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) : SchwartzMap (Euclidean 2) Complex :=
  (aux_hasCompactSupport_circleMiddleBandpassMultiplierTimeDerivative C j t).toSchwartzMap
    (aux_contDiff_circleMiddleBandpassMultiplierTimeDerivative C j t)

theorem aux_circleMiddleBandpassMultiplierTimeDerivativeSchwartzSymbol_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (xi : Euclidean 2) :
    aux_circleMiddleBandpassMultiplierTimeDerivativeSchwartzSymbol C j t xi =
      aux_circleMiddleBandpassMultiplierTimeDerivative C j t xi := rfl

/-- The inverse Fourier contribution associated to the literal time
derivative of the dyadic middle multiplier. -/
noncomputable def aux_circleMiddleWaveContributionTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex) :
    Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun xi : Euclidean 2 =>
    aux_circleMiddleBandpassMultiplierTimeDerivativeSchwartzSymbol C j t xi *
      𝓕 (f : Euclidean 2 → Complex) xi) x

theorem aux_circleMiddleWaveContributionTimeDerivative_eq_fourierInv_multiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) :
    aux_circleMiddleWaveContributionTimeDerivative C j t f x =
      𝓕⁻ (fun xi : Euclidean 2 =>
        aux_circleMiddleBandpassMultiplierTimeDerivative C j t xi *
          𝓕 (f : Euclidean 2 → Complex) xi) x := by
  unfold aux_circleMiddleWaveContributionTimeDerivative
  apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
  funext xi
  rw [aux_circleMiddleBandpassMultiplierTimeDerivativeSchwartzSymbol_apply]

/-- Plancherel gives a uniform fixed-time `L²` estimate for the derivative
middle contribution on the unit time interval. -/
theorem aux_exists_integral_norm_sq_circleMiddleWaveContributionTimeDerivative_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (j : Nat) (t : Real), 1 ≤ t → t ≤ 2 →
      ∀ f : SchwartzMap (Euclidean 2) Complex,
        (∫ x : Euclidean 2, ‖aux_circleMiddleWaveContributionTimeDerivative C j t f x‖ ^ 2) ≤
          B ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨B, hB, hpoint⟩ :=
    aux_exists_norm_circleMiddleBandpassMultiplierTimeDerivative_le_on_dyadicBandpass C
  refine ⟨B, hB, ?_⟩
  intro j t ht htop f
  let m : SchwartzMap (Euclidean 2) Complex :=
    aux_circleMiddleBandpassMultiplierTimeDerivativeSchwartzSymbol C j t
  have hm_bound (xi : Euclidean 2) : ‖m xi‖ ≤ B := by
    rw [show m xi = aux_circleMiddleBandpassMultiplierTimeDerivative C j t xi by
      exact aux_circleMiddleBandpassMultiplierTimeDerivativeSchwartzSymbol_apply C j t xi]
    by_cases hband :
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0
    · simp [aux_circleMiddleBandpassMultiplierTimeDerivative, hband, hB.le]
    · exact hpoint j t xi ht htop hband
  have hmult := _root_.Auto.Spherical.Auxiliary.integral_norm_sq_fourierInv_schwartz_multiplier_le
    m (𝓕 f) hB.le hm_bound
  calc
    (∫ x : Euclidean 2, ‖aux_circleMiddleWaveContributionTimeDerivative C j t f x‖ ^ 2) =
        ∫ x : Euclidean 2, ‖𝓕⁻ (fun xi : Euclidean 2 =>
          m xi * 𝓕 (f : Euclidean 2 → Complex) xi) x‖ ^ 2 := by
          rfl
    _ ≤ B ^ 2 * ∫ xi : Euclidean 2, ‖𝓕 (f : Euclidean 2 → Complex) xi‖ ^ 2 := hmult
    _ = B ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
      rw [_root_.Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq]

private theorem aux_continuous_circleEndpointAmplitude
    (σ : _root_.Auto.Spherical.MSSBase.WaveSign) (t : Real) :
    Continuous (fun xi : Euclidean 2 =>
      circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖))) := by
