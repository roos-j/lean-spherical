theorem exists_compactFourierIBPConstant_circleRelativeBandFatUnitFamily_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ A₁ : Real, 0 ≤ A₁ ∧ ∀ t : CircleRelativeBandLocalTime,
      _root_.Auto.MikhlinHormander.compactFourierIBPConstant (N := 4)
