  intro j hj σ f
  obtain ⟨T, hT⟩ := exists_MSS_MaximalSeparated j
  have hjoint := continuous_and_hasDerivAt_circleEndpointWaveContribution C σ j f
  have hFspace : Integrable (fun p : Real × Euclidean 2 =>
