      calc
        (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) ≤
            Q * (A / Real.sqrt R) ^ 2 * E := hF
        _ = (Q * A ^ 2 / R) * E := by
          rw [aux_sq_div_sqrt A R hR]
          ring
    have hD :
        (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) ≤
          B * R * E := by
      simpa only [D, R, E] using hDbound j k f
    let δ : Real := Auto.Spherical.MSSBase.dyadicTimeScale k
    have hδ : δ = R⁻¹ := by
      dsimp only [δ, R]
      simp [Auto.Spherical.MSSBase.dyadicTimeScale, dyadicScale, zpow_neg]
    have hδnonneg : 0 ≤ δ := by
      rw [hδ]
      exact inv_nonneg.mpr hR.le
    have hδinvnonneg : 0 ≤ δ⁻¹ := inv_nonneg.mpr hδnonneg
    have hsamplebound :
        8 * δ⁻¹ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) +
          6 * δ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) ≤
          8 * δ⁻¹ * ((Q * A ^ 2 / R) * E) + 6 * δ * (B * R * E) := by
      apply add_le_add
      · have h := mul_le_mul_of_nonneg_left hF'
          (mul_nonneg (by norm_num : (0 : Real) ≤ 8) hδinvnonneg)
        simpa only [mul_assoc, mul_left_comm, mul_comm] using h
      · have h := mul_le_mul_of_nonneg_left hD
          (mul_nonneg (by norm_num : (0 : Real) ≤ 6) hδnonneg)
        simpa only [mul_assoc, mul_left_comm, mul_comm] using h
    have hformula :
        8 * δ⁻¹ * ((Q * A ^ 2 / R) * E) + 6 * δ * (B * R * E) =
          (8 * Q * A ^ 2 + 6 * B) * E := by
      rw [hδ]
      field_simp [hR.ne']
    have hlinear : 8 * Q * A ^ 2 + 6 * B ≤ 8 * S := by
      dsimp only [S]
      nlinarith
    have hSbound : 8 * S ≤ M ^ 2 := by
      dsimp only [M]
      nlinarith [sq_nonneg S]
    have hcoeff : 8 * Q * A ^ 2 + 6 * B ≤ M ^ 2 :=
      hlinear.trans hSbound
    have hfinal : (8 * Q * A ^ 2 + 6 * B) * E ≤ M ^ 2 * E := by
      exact mul_le_mul_of_nonneg_right hcoeff hE
    calc
      8 * (Auto.Spherical.MSSBase.dyadicTimeScale k)⁻¹ *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) +
        6 * Auto.Spherical.MSSBase.dyadicTimeScale k *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) =
          8 * δ⁻¹ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) +
            6 * δ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) := by rfl
      _ ≤ 8 * δ⁻¹ * ((Q * A ^ 2 / R) * E) + 6 * δ * (B * R * E) :=
        hsamplebound
      _ = (8 * Q * A ^ 2 + 6 * B) * E := hformula
      _ ≤ M ^ 2 * E := hfinal
      _ = M ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by rfl

/-- A finite five-term `ENNReal` square estimate that remains valid at `∞`.
This avoids converting raw maximal functions to real-valued representatives
before the unit-slab fourth-moment-style bookkeeping. -/
private theorem aux_l2_sum_range_five_sq_le (u : Nat → ENNReal) :
    (∑ i ∈ Finset.range 5, u i) ^ 2 ≤
      25 * ∑ i ∈ Finset.range 5, (u i) ^ 2 := by
  let S : Finset ENNReal := (Finset.range 5).image u
  have hS : S.Nonempty := by
    refine ⟨u 0, ?_⟩
    exact Finset.mem_image.mpr ⟨0, Finset.mem_range.mpr (by norm_num), rfl⟩
  let m : ENNReal := S.max' hS
  have hterm (i : Nat) (hi : i ∈ Finset.range 5) : u i ≤ m := by
    exact Finset.le_max' S (u i) (Finset.mem_image.mpr ⟨i, hi, rfl⟩)
  have hsum : (∑ i ∈ Finset.range 5, u i) ≤ (Finset.range 5).card • m :=
    Finset.sum_le_card_nsmul (Finset.range 5) u m hterm
  have hsum' : (∑ i ∈ Finset.range 5, u i) ≤ 5 • m := by
    simpa using hsum
  have hsq : (∑ i ∈ Finset.range 5, u i) ^ 2 ≤ (5 • m) ^ 2 :=
    pow_le_pow_left₀ bot_le hsum' 2
  obtain ⟨i, hi, him⟩ := Finset.mem_image.mp (Finset.max'_mem S hS)
  have hm : m = u i := by
    exact him.symm
  have hmi : m ^ 2 ≤ ∑ i ∈ Finset.range 5, (u i) ^ 2 := by
    rw [hm]
    exact Finset.single_le_sum (f := fun i => (u i) ^ 2)
      (fun _ _ => by positivity) hi
  calc
    (∑ i ∈ Finset.range 5, u i) ^ 2 ≤ (5 • m) ^ 2 := hsq
    _ = 25 * m ^ 2 := by rw [nsmul_eq_mul]; ring
    _ ≤ 25 * ∑ i ∈ Finset.range 5, (u i) ^ 2 :=
      mul_le_mul_of_nonneg_left hmi (by norm_num)

/-- The sampler bound in raw form for one literal ordinary dyadic piece. -/
private theorem aux_exists_measurable_lintegral_iSup_circleRelativeBandFatUnitSlabDyadicOutput_le
    (C : lpCutoffs 2) :
    ∃ M : Real, 0 < M ∧ ∀ (j k : Nat)
      (f : SchwartzMap (Euclidean 2) Complex),
      Measurable (fun x : Euclidean 2 =>
        ⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal
            (‖circleRelativeBandFatUnitSlabDyadicOutput C j k t f x‖ ^ 2)) ∧
        (∫⁻ x : Euclidean 2,
          ⨆ t : Icc (1 : Real) 2,
            ENNReal.ofReal
              (‖circleRelativeBandFatUnitSlabDyadicOutput C j k t f x‖ ^ 2)) ≤
          ENNReal.ofReal (M ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2) := by
  obtain ⟨M, hM, hbound⟩ :=
    aux_exists_measurable_lintegral_iSup_circleRelativeBandFatUnitSlabDyadicOutputExtended_le C
  refine ⟨M, hM, ?_⟩
  intro j k f
  obtain ⟨hmeas, hmoment⟩ := hbound j k f
  have hfun :
      (fun x : Euclidean 2 =>
        ⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal
            (‖aux_circleRelativeBandFatUnitSlabDyadicOutputExtended C j k t.1 f x‖ ^ 2)) =
        fun x : Euclidean 2 =>
          ⨆ t : Icc (1 : Real) 2,
            ENNReal.ofReal
              (‖circleRelativeBandFatUnitSlabDyadicOutput C j k t f x‖ ^ 2) := by
    funext x
    apply iSup_congr
    intro t
    rw [aux_circleRelativeBandFatUnitSlabDyadicOutputExtended_eq_literal C j k t f x]
  rw [hfun] at hmeas hmoment
  exact ⟨hmeas, hmoment⟩

/- The exact five-piece identity is converted at the level of the literal
raw `ENNReal` maximal function.  This keeps the later local hypothesis in
the same form as the all-radius reassembly theorem. -/
private theorem aux_circleRelativeBandFatUnitSlabMaximal_sq_le_sum_five_dyadic_sq
    (C : lpCutoffs 2) (j : Nat) (hj : 2 ≤ j)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    (circleRelativeBandFatUnitSlabMaximal C j f x) ^ 2 ≤
      25 * ∑ i ∈ Finset.range 5,
        (⨆ t : CircleRelativeBandLocalTime,
          ENNReal.ofReal
            (‖circleRelativeBandFatUnitSlabDyadicOutput C j (j - 2 + i) t f x‖ ^ 2)) := by
  classical
  letI : Nonempty CircleRelativeBandLocalTime :=
    ⟨⟨1, by norm_num⟩⟩
  let U : Nat → ENNReal := fun i =>
    ⨆ t : CircleRelativeBandLocalTime,
      ENNReal.ofReal
        ‖circleRelativeBandFatUnitSlabDyadicOutput C j (j - 2 + i) t f x‖
  have hmax : circleRelativeBandFatUnitSlabMaximal C j f x ≤
      ∑ i ∈ Finset.range 5, U i := by
    unfold circleRelativeBandFatUnitSlabMaximal
    apply iSup_le
    intro t
    rw [circleRelativeBandFatUnitSlabOutput_eq_sum_five_dyadic C j hj t f x]
    calc
      ENNReal.ofReal
          ‖∑ i ∈ Finset.range 5,
            circleRelativeBandFatUnitSlabDyadicOutput C j (j - 2 + i) t f x‖ ≤
          ENNReal.ofReal (∑ i ∈ Finset.range 5,
            ‖circleRelativeBandFatUnitSlabDyadicOutput C j (j - 2 + i) t f x‖) :=
        ENNReal.ofReal_le_ofReal (norm_sum_le _ _)
      _ = ∑ i ∈ Finset.range 5,
          ENNReal.ofReal
            ‖circleRelativeBandFatUnitSlabDyadicOutput C j (j - 2 + i) t f x‖ := by
          rw [ENNReal.ofReal_sum_of_nonneg]
          intro i hi
          exact norm_nonneg _
      _ ≤ ∑ i ∈ Finset.range 5, U i := by
          apply Finset.sum_le_sum
          intro i hi
          exact le_iSup (fun s : CircleRelativeBandLocalTime =>
            ENNReal.ofReal
              ‖circleRelativeBandFatUnitSlabDyadicOutput C j (j - 2 + i) s f x‖) t
  calc
    (circleRelativeBandFatUnitSlabMaximal C j f x) ^ 2 ≤
        (∑ i ∈ Finset.range 5, U i) ^ 2 :=
      pow_le_pow_left' hmax 2
    _ ≤ 25 * ∑ i ∈ Finset.range 5, (U i) ^ 2 :=
      aux_l2_sum_range_five_sq_le U
    _ = 25 * ∑ i ∈ Finset.range 5,
        (⨆ t : CircleRelativeBandLocalTime,
          ENNReal.ofReal
            (‖circleRelativeBandFatUnitSlabDyadicOutput C j (j - 2 + i) t f x‖ ^ 2)) := by
      apply congrArg (fun z : ENNReal => 25 * z)
      apply Finset.sum_congr rfl
      intro i hi
      dsimp [U]
      rw [ENNReal.iSup_pow]
      apply iSup_congr
      intro t
      rw [ENNReal.ofReal_pow (norm_nonneg _)]

private theorem aux_lintegral_circleRelativeBandFatInputProjection_sq_eq
    (C : lpCutoffs 2) (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    (∫⁻ x : Euclidean 2, ENNReal.ofReal
      (‖circleRelativeBandFatInputProjection C j f x‖ ^ (2 : Nat))) =
      ENNReal.ofReal (∫ x : Euclidean 2,
        ‖circleRelativeBandFatInputProjection C j f x‖ ^ (2 : Nat)) := by
  let P : SchwartzMap (Euclidean 2) Complex :=
    aux_circleRelativeBandFatInputProjectionSchwartz C j f
  have hPint : Integrable (fun x : Euclidean 2 => ‖P x‖ ^ (2 : Nat)) volume :=
    (P.memLp 2 volume).integrable_norm_pow (by norm_num)
  have hPnonneg : ∀ᵐ x : Euclidean 2 ∂volume, 0 ≤ ‖P x‖ ^ (2 : Nat) :=
    Filter.Eventually.of_forall fun _ => pow_nonneg (norm_nonneg _) _
  have hlin : (∫⁻ x : Euclidean 2, ENNReal.ofReal (‖P x‖ ^ (2 : Nat))) =
      ENNReal.ofReal (∫ x : Euclidean 2, ‖P x‖ ^ (2 : Nat)) :=
    (ofReal_integral_eq_lintegral_ofReal hPint hPnonneg).symm
  calc
    (∫⁻ x : Euclidean 2, ENNReal.ofReal
        (‖circleRelativeBandFatInputProjection C j f x‖ ^ (2 : Nat))) =
        ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖P x‖ ^ (2 : Nat)) := by
          apply lintegral_congr
          intro x
          rw [show P x = circleRelativeBandFatInputProjection C j f x by
            exact aux_circleRelativeBandFatInputProjectionSchwartz_apply C j f x]
    _ = ENNReal.ofReal (∫ x : Euclidean 2, ‖P x‖ ^ (2 : Nat)) := hlin
    _ = ENNReal.ofReal (∫ x : Euclidean 2,
        ‖circleRelativeBandFatInputProjection C j f x‖ ^ (2 : Nat)) := by
          congr 1
          apply integral_congr_ae
          filter_upwards with x
          rw [show P x = circleRelativeBandFatInputProjection C j f x by
            exact aux_circleRelativeBandFatInputProjectionSchwartz_apply C j f x]

/- The high relative scales are reassembled directly from the five literal
ordinary dyadic maxima.  The constant is uniform in the relative scale. -/
private theorem aux_exists_high_circleRelativeBandFatUnitSlab_second_moment
    (C : lpCutoffs 2) :
    ∃ A : ENNReal, A ≠ ∞ ∧ ∀ (j : Nat), 2 ≤ j →
      ∀ f : SchwartzMap (Euclidean 2) Complex,
        Measurable (circleRelativeBandFatUnitSlabMaximal C j f) ∧
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≠ ∞ ∧
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≤
          A * ∫⁻ x : Euclidean 2, ENNReal.ofReal
            (‖circleRelativeBandFatInputProjection C j f x‖ ^ (2 : Nat)) := by
  obtain ⟨M, hM, hdyadic⟩ :=
    aux_exists_measurable_lintegral_iSup_circleRelativeBandFatUnitSlabDyadicOutput_le C
  let A : ENNReal := ENNReal.ofReal (125 * M ^ (2 : Nat))
  have hAtop : A ≠ ∞ := by
    dsimp [A]
    exact ENNReal.ofReal_ne_top
  refine ⟨A, hAtop, ?_⟩
  intro j hj f
  let P : SchwartzMap (Euclidean 2) Complex :=
    aux_circleRelativeBandFatInputProjectionSchwartz C j f
  let E : Real := ∫ x : Euclidean 2, ‖P x‖ ^ (2 : Nat)
  let B : ENNReal := ENNReal.ofReal (M ^ (2 : Nat) * E)
  let Q : Nat → Euclidean 2 → ENNReal := fun i x =>
    ⨆ t : CircleRelativeBandLocalTime,
      ENNReal.ofReal
        (‖circleRelativeBandFatUnitSlabDyadicOutput C j (j - 2 + i) t P x‖ ^ 2)
  have hQ (i : Nat) : Measurable (Q i) ∧ (∫⁻ x : Euclidean 2, Q i x) ≤ B := by
    simpa only [Q, B, E] using hdyadic j (j - 2 + i) P
  have hsummeas : Measurable (fun x : Euclidean 2 =>
      ∑ i ∈ Finset.range 5, Q i x) :=
    Finset.measurable_sum _ (fun i hi => (hQ i).1)
  have hpieces : (∑ i ∈ Finset.range 5, ∫⁻ x : Euclidean 2, Q i x) ≤
      5 * B := by
    calc
      (∑ i ∈ Finset.range 5, ∫⁻ x : Euclidean 2, Q i x) ≤
          ∑ i ∈ Finset.range 5, B := by
            apply Finset.sum_le_sum
            intro i hi
            exact (hQ i).2
      _ = 5 * B := by norm_num
  have hmaxeq (x : Euclidean 2) :
      circleRelativeBandFatUnitSlabMaximal C j f x =
        circleRelativeBandFatUnitSlabMaximal C j P x := by
    unfold circleRelativeBandFatUnitSlabMaximal
    apply iSup_congr
    intro t
    rw [aux_circleRelativeBandFatUnitSlabOutput_eq_projectedInput C j t f x]
  have hmomentP :
      (∫⁻ x : Euclidean 2,
        (circleRelativeBandFatUnitSlabMaximal C j P x) ^ (2 : Nat)) ≤
        ENNReal.ofReal (125 * M ^ (2 : Nat)) * ENNReal.ofReal E := by
    calc
      (∫⁻ x : Euclidean 2,
        (circleRelativeBandFatUnitSlabMaximal C j P x) ^ (2 : Nat)) ≤
          ∫⁻ x : Euclidean 2, 25 * ∑ i ∈ Finset.range 5, Q i x :=
        lintegral_mono fun x =>
          aux_circleRelativeBandFatUnitSlabMaximal_sq_le_sum_five_dyadic_sq
            C j hj P x
      _ = 25 * ∫⁻ x : Euclidean 2, ∑ i ∈ Finset.range 5, Q i x := by
        rw [lintegral_const_mul _ hsummeas]
      _ = 25 * ∑ i ∈ Finset.range 5, ∫⁻ x : Euclidean 2, Q i x := by
        rw [MeasureTheory.lintegral_finsetSum (Finset.range 5)
          (fun i hi => (hQ i).1)]
      _ ≤ 25 * (5 * B) :=
        mul_le_mul_of_nonneg_left hpieces (by norm_num)
      _ = ENNReal.ofReal (125 * M ^ (2 : Nat)) * ENNReal.ofReal E := by
        dsimp only [B]
        rw [ENNReal.ofReal_mul (sq_nonneg M),
          ENNReal.ofReal_mul (by norm_num : (0 : Real) ≤ 125)]
        norm_num
        ring
  have hEeq : E = ∫ x : Euclidean 2,
      ‖circleRelativeBandFatInputProjection C j f x‖ ^ (2 : Nat) := by
    dsimp only [E]
    apply integral_congr_ae
    filter_upwards with x
    rw [show P x = circleRelativeBandFatInputProjection C j f x by
      exact aux_circleRelativeBandFatInputProjectionSchwartz_apply C j f x]
  let J : ENNReal := ∫⁻ x : Euclidean 2, ENNReal.ofReal
    (‖circleRelativeBandFatInputProjection C j f x‖ ^ (2 : Nat))
  have hJ : J = ENNReal.ofReal E := by
    dsimp only [J]
    rw [aux_lintegral_circleRelativeBandFatInputProjection_sq_eq C j f, ← hEeq]
  have hJtop : J ≠ ∞ := by
    rw [hJ]
    exact ENNReal.ofReal_ne_top
  have hrighttop : A * J ≠ ∞ := ENNReal.mul_ne_top hAtop hJtop
  have hbound :
      (∫⁻ x : Euclidean 2,
        (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≤ A * J := by
    calc
      (∫⁻ x : Euclidean 2,
        (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) =
          ∫⁻ x : Euclidean 2,
            (circleRelativeBandFatUnitSlabMaximal C j P x) ^ (2 : Nat) := by
              apply lintegral_congr
              intro x
              rw [hmaxeq x]
      _ ≤ ENNReal.ofReal (125 * M ^ (2 : Nat)) * ENNReal.ofReal E := hmomentP
      _ = A * J := by
        dsimp only [A]
        rw [hJ]
  refine ⟨?_, ne_top_of_le_ne_top hrighttop hbound, ?_⟩
  · rw [show circleRelativeBandFatUnitSlabMaximal C j f =
        circleRelativeBandFatUnitSlabMaximal C j P by
          funext x
          exact hmaxeq x]
    exact aux_measurable_circleRelativeBandFatUnitSlabMaximal_of_two_le C j hj P
  · simpa only [J] using hbound

/- The low compact-annular family needs a raw `ENNReal` version of the
standard multiplier estimate, since the literal local maximal function is
not its `toReal` presentation. -/
private theorem aux_raw_annular_two_of_kernel_bound
    {ι : Type*}
    (φ : ι → SchwartzMap (Euclidean 2) Complex)
    (r : ι → Set.Ioi (0 : Real))
    {A : Real} (hA : 0 ≤ A)
    (hφ : ∀ u, _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize
      (φ u) ≤ A) :
    ∃ D : Real, 0 < D ∧ ∀ f : SchwartzMap (Euclidean 2) Complex,
      Measurable (fun x =>
        _root_.Auto.MikhlinHormander.annularSchwartzMultiplierRaw φ r f x) ∧
      (∫⁻ x, (_root_.Auto.MikhlinHormander.annularSchwartzMultiplierRaw
        φ r f x) ^ (2 : Nat)) ≤
        ENNReal.ofReal (D * ∫ x, ‖f x‖ ^ (2 : Nat)) := by
  obtain ⟨K, hK, hterm⟩ :=
    _root_.Auto.MikhlinHormander.uniform_relativeSchwartzMultiplierAt_majorant_of_kernel_bound
      φ hA hφ
  obtain ⟨D, hD, hstrong⟩ :=
    _root_.Auto.MikhlinHormander.annularSchwartzMultiplier_strong_type_of_kernel_bound
      (d := 2) (by norm_num) (p := 2) (by norm_num) φ r hA hφ
  refine ⟨D, hD, ?_⟩
  intro f
  let R : Euclidean 2 → ENNReal := fun x =>
    _root_.Auto.MikhlinHormander.annularSchwartzMultiplierRaw φ r f x
  let H : Euclidean 2 → Real := fun x =>
    _root_.Auto.MikhlinHormander.annularSchwartzMultiplier φ r f x
  have hRle (x : Euclidean 2) :
      R x ≤ ENNReal.ofReal (K *
        _root_.Auto.HardyLittlewoodMaximal.dyadicBallMaximal 2
          (f : Euclidean 2 → Complex) x) := by
    dsimp [R, _root_.Auto.MikhlinHormander.annularSchwartzMultiplierRaw]
    apply iSup_le
    intro u
    exact ENNReal.ofReal_le_ofReal (hterm u f (r u) x)
  have hRfinite (x : Euclidean 2) : R x ≠ ⊤ :=
    ne_top_of_le_ne_top ENNReal.ofReal_ne_top (hRle x)
  have hReq (x : Euclidean 2) : R x = ENNReal.ofReal (H x) := by
    dsimp [R, H, _root_.Auto.MikhlinHormander.annularSchwartzMultiplier]
    exact (ENNReal.ofReal_toReal (hRfinite x)).symm
  have hHmeas : Measurable H := by
    dsimp [H]
    apply ENNReal.measurable_toReal.comp
    apply LowerSemicontinuous.measurable
    apply lowerSemicontinuous_iSup
    intro u
    exact (ENNReal.continuous_ofReal.comp
      (_root_.Auto.MikhlinHormander.continuous_relativeSchwartzMultiplierAt
        (φ u) f (r u)).norm).lowerSemicontinuous
  have hRmeas : Measurable R := by
    rw [show R = fun x => ENNReal.ofReal (H x) by
      funext x
      exact hReq x]
    exact hHmeas.ennreal_ofReal
  have hHmem : MemLp H 2 volume := by
    convert (hstrong f).1 using 1 <;> norm_num [H]
  have hHbound' : (∫ x, H x ^ (2 : Real)) ≤
      D * ∫ x, ‖f x‖ ^ (2 : Real) := by
    simpa only [H] using (hstrong f).2
  change (∫ x, H x ^ (↑(2 : Nat) : Real)) ≤
      D * ∫ x, ‖f x‖ ^ (↑(2 : Nat) : Real) at hHbound'
  have hHbound : (∫ x, H x ^ (2 : Nat)) ≤
      D * ∫ x, ‖f x‖ ^ (2 : Nat) := by
    simpa only [Real.rpow_natCast] using hHbound'
  have hHint : Integrable (fun x => H x ^ (2 : Nat)) volume := by
    rw [show (fun x => H x ^ (2 : Nat)) = fun x => ‖H x‖ ^ (2 : Nat) by
      funext x
      rw [Real.norm_eq_abs, abs_of_nonneg
        (_root_.Auto.MikhlinHormander.annularSchwartzMultiplier_nonneg
          φ r f x)]]
    exact hHmem.integrable_norm_pow (by norm_num)
  have hHnonneg : ∀ᵐ x ∂volume, 0 ≤ H x ^ (2 : Nat) :=
    Filter.Eventually.of_forall fun x => pow_nonneg
      (_root_.Auto.MikhlinHormander.annularSchwartzMultiplier_nonneg φ r f x) _
  refine ⟨?_, ?_⟩
  · simpa only [R] using hRmeas
  · calc
      (∫⁻ x, (R x) ^ (2 : Nat)) =
          ∫⁻ x, ENNReal.ofReal (H x ^ (2 : Nat)) := by
            apply lintegral_congr
            intro x
            rw [hReq x,
              ← ENNReal.ofReal_pow
                (_root_.Auto.MikhlinHormander.annularSchwartzMultiplier_nonneg
                  φ r f x)]
      _ = ENNReal.ofReal (∫ x, H x ^ (2 : Nat)) :=
        (ofReal_integral_eq_lintegral_ofReal hHint hHnonneg).symm
      _ ≤ ENNReal.ofReal (D * ∫ x, ‖f x‖ ^ (2 : Nat)) :=
        ENNReal.ofReal_le_ofReal hHbound

/- The finite compact family of low relative scales has a uniform raw
second-moment bound. -/
private theorem aux_exists_low_circleRelativeBandFatUnitSlab_second_moment_unprojected
    (C : lpCutoffs 2) :
    ∃ A : Real, 0 < A ∧ ∀ (a : Fin 3) (f : SchwartzMap (Euclidean 2) Complex),
      Measurable (circleRelativeBandFatUnitSlabMaximal C a.1 f) ∧
      (∫⁻ x : Euclidean 2,
        (circleRelativeBandFatUnitSlabMaximal C a.1 f x) ^ (2 : Nat)) ≤
        ENNReal.ofReal (A * ∫ x : Euclidean 2, ‖f x‖ ^ (2 : Nat)) := by
  obtain ⟨B, hB, hkernel⟩ :=
    aux_exists_relativeSchwartzMultiplierKernelSize_circleRelativeBandFatLowSymbol_le C
  choose D hDpos hD using fun a : Fin 3 =>
    aux_raw_annular_two_of_kernel_bound
      (fun t : CircleRelativeBandLocalTime => aux_circleRelativeBandFatLowSymbol C a.1 t)
      (fun _ : CircleRelativeBandLocalTime =>
        _root_.Auto.MikhlinHormander.dyadicFrequencyScale a.1)
      hB (fun t => hkernel a t)
  let A : Real := ∑ a : Fin 3, D a
  have hApos : 0 < A := by
    apply lt_of_lt_of_le (hDpos ⟨0, by norm_num⟩)
    dsimp [A]
    exact Finset.single_le_sum (fun b _ => (hDpos b).le) (Finset.mem_univ _)
  refine ⟨A, hApos, ?_⟩
  intro a f
  have hrawfun : circleRelativeBandFatUnitSlabMaximal C a.1 f =
      fun x : Euclidean 2 =>
        _root_.Auto.MikhlinHormander.annularSchwartzMultiplierRaw
          (fun t : CircleRelativeBandLocalTime =>
            aux_circleRelativeBandFatLowSymbol C a.1 t)
          (fun _ : CircleRelativeBandLocalTime =>
            _root_.Auto.MikhlinHormander.dyadicFrequencyScale a.1) f x := by
    funext x
    exact aux_circleRelativeBandFatUnitSlabMaximal_eq_lowSymbolRaw C a f x
  have hDle : D a ≤ A := by
    dsimp [A]
    exact Finset.single_le_sum (fun b _ => (hDpos b).le) (Finset.mem_univ a)
  have hInonneg : 0 ≤ ∫ x : Euclidean 2, ‖f x‖ ^ (2 : Nat) := by
    exact integral_nonneg fun _ => pow_nonneg (norm_nonneg _) _
  refine ⟨?_, ?_⟩
  · rw [hrawfun]
    exact (hD a f).1
  · rw [hrawfun]
    calc
      (∫⁻ x : Euclidean 2,
          (_root_.Auto.MikhlinHormander.annularSchwartzMultiplierRaw
            (fun t : CircleRelativeBandLocalTime =>
              aux_circleRelativeBandFatLowSymbol C a.1 t)
            (fun _ : CircleRelativeBandLocalTime =>
              _root_.Auto.MikhlinHormander.dyadicFrequencyScale a.1) f x) ^
              (2 : Nat)) ≤
          ENNReal.ofReal (D a * ∫ x : Euclidean 2, ‖f x‖ ^ (2 : Nat)) :=
        (hD a f).2
      _ ≤ ENNReal.ofReal (A * ∫ x : Euclidean 2, ‖f x‖ ^ (2 : Nat)) :=
        ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right hDle hInonneg)

/- The same low-scale bound with the exact physical fat projection on its
right-hand side. -/
private theorem aux_exists_low_circleRelativeBandFatUnitSlab_second_moment
    (C : lpCutoffs 2) :
    ∃ A : Real, 0 < A ∧ ∀ (a : Fin 3) (f : SchwartzMap (Euclidean 2) Complex),
      Measurable (circleRelativeBandFatUnitSlabMaximal C a.1 f) ∧
      (∫⁻ x : Euclidean 2,
        (circleRelativeBandFatUnitSlabMaximal C a.1 f x) ^ (2 : Nat)) ≤
        ENNReal.ofReal (A * ∫ x : Euclidean 2,
          ‖circleRelativeBandFatInputProjection C a.1 f x‖ ^ (2 : Nat)) := by
  obtain ⟨A, hA, hlow⟩ :=
    aux_exists_low_circleRelativeBandFatUnitSlab_second_moment_unprojected C
  refine ⟨A, hA, ?_⟩
  intro a f
  let P : SchwartzMap (Euclidean 2) Complex :=
    aux_circleRelativeBandFatInputProjectionSchwartz C a.1 f
  have hmaxeq : circleRelativeBandFatUnitSlabMaximal C a.1 f =
      circleRelativeBandFatUnitSlabMaximal C a.1 P := by
    funext x
    unfold circleRelativeBandFatUnitSlabMaximal
    apply iSup_congr
    intro t
    rw [aux_circleRelativeBandFatUnitSlabOutput_eq_projectedInput C a.1 t f x]
  obtain ⟨hmeas, hmoment⟩ := hlow a P
  refine ⟨?_, ?_⟩
  · rw [hmaxeq]
    exact hmeas
  · rw [hmaxeq]
    calc
      (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C a.1 P x) ^ (2 : Nat)) ≤
          ENNReal.ofReal (A * ∫ x : Euclidean 2, ‖P x‖ ^ (2 : Nat)) := hmoment
      _ = ENNReal.ofReal (A * ∫ x : Euclidean 2,
          ‖circleRelativeBandFatInputProjection C a.1 f x‖ ^ (2 : Nat)) := by
        congr 2
        apply integral_congr_ae
        filter_upwards with x
        rw [show P x = circleRelativeBandFatInputProjection C a.1 f x by
          exact aux_circleRelativeBandFatInputProjectionSchwartz_apply C a.1 f x]

/- Combine the high five-dyadic sampler with the finite compact low family
in the exact local hypothesis consumed by the all-radius `L²` reassembly. -/
private theorem aux_exists_circleRelativeBandFatUnitSlab_second_moment
    (C : lpCutoffs 2) :
    ∃ A : ENNReal, A ≠ ∞ ∧
      ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
        Measurable (circleRelativeBandFatUnitSlabMaximal C j f) ∧
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≠ ∞ ∧
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≤
          A * ∫⁻ x : Euclidean 2, ENNReal.ofReal
            (‖circleRelativeBandFatInputProjection C j f x‖ ^ (2 : Nat)) := by
  obtain ⟨Ah, hAhtop, hhigh⟩ :=
    aux_exists_high_circleRelativeBandFatUnitSlab_second_moment C
  obtain ⟨Al, hAl, hlow⟩ :=
    aux_exists_low_circleRelativeBandFatUnitSlab_second_moment C
  let A : ENNReal := Ah + ENNReal.ofReal Al
  have hAtop : A ≠ ∞ := by
    dsimp [A]
    exact ENNReal.add_ne_top.mpr ⟨hAhtop, ENNReal.ofReal_ne_top⟩
  have hAhle : Ah ≤ A := by
    dsimp [A]
    exact le_add_of_nonneg_right bot_le
  have hAlle : ENNReal.ofReal Al ≤ A := by
    dsimp [A]
    exact le_add_of_nonneg_left bot_le
  refine ⟨A, hAtop, ?_⟩
  intro j f
  let I : Real := ∫ x : Euclidean 2,
    ‖circleRelativeBandFatInputProjection C j f x‖ ^ (2 : Nat)
  let J : ENNReal := ∫⁻ x : Euclidean 2, ENNReal.ofReal
    (‖circleRelativeBandFatInputProjection C j f x‖ ^ (2 : Nat))
  have hJ : J = ENNReal.ofReal I := by
    dsimp only [I, J]
    exact aux_lintegral_circleRelativeBandFatInputProjection_sq_eq C j f
  have hJtop : J ≠ ∞ := by
    rw [hJ]
    exact ENNReal.ofReal_ne_top
  have hrighttop : A * J ≠ ∞ := ENNReal.mul_ne_top hAtop hJtop
  by_cases hj : 2 ≤ j
  · obtain ⟨hmeas, hfinite, hmoment⟩ := hhigh j hj f
    have hbound :
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≤ A * J := by
      calc
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≤ Ah * J := by
          simpa only [J] using hmoment
        _ ≤ A * J := mul_le_mul_of_nonneg_right hAhle bot_le
    exact ⟨hmeas, ne_top_of_le_ne_top hrighttop hbound, by simpa only [J] using hbound⟩
  · have hjlt : j < 2 := Nat.lt_of_not_ge hj
    let a : Fin 3 := ⟨j, lt_trans hjlt (by norm_num : 2 < 3)⟩
    obtain ⟨hmeas, hmoment⟩ := hlow a f
    have hI : 0 ≤ I := by
      dsimp only [I]
      exact integral_nonneg fun _ => pow_nonneg (norm_nonneg _) _
    have hlowbound :
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≤
          ENNReal.ofReal Al * J := by
      have hraw := hmoment
      have hraw' :
          (∫⁻ x : Euclidean 2,
            (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≤
            ENNReal.ofReal (Al * I) := by
        simpa only [a, I] using hraw
      calc
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≤
            ENNReal.ofReal (Al * I) := hraw'
        _ = ENNReal.ofReal Al * J := by
          rw [hJ, ENNReal.ofReal_mul hAl.le]
    have hbound :
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≤ A * J :=
      hlowbound.trans (mul_le_mul_of_nonneg_right hAlle bot_le)
    refine ⟨?_, ne_top_of_le_ne_top hrighttop hbound, ?_⟩
    · simpa only [a] using hmeas
    · simpa only [J] using hbound

/-- The literal moving-fat relative circular maximal function is uniformly
bounded at planar `L²` over all positive radii.  The constant is independent
of the relative dyadic scale. -/
theorem exists_memLp_two_and_eLpNorm_restrictedRelativeBandpassSphericalMaximal
    (C : lpCutoffs 2) :
    ∃ L : Real, 0 < L ∧
      ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
        MemLp (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f)
          (ENNReal.ofReal (2 : Real)) volume ∧
        eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f)
          (ENNReal.ofReal (2 : Real)) volume ≤
          ENNReal.ofReal L *
            eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal (2 : Real)) volume := by
  obtain ⟨A, hAtop, hlocal⟩ := aux_exists_circleRelativeBandFatUnitSlab_second_moment C
  exact exists_memLp_two_and_eLpNorm_restrictedRelativeBandpassSphericalMaximal_of_circleRelativeBandFatUnitSlab
    C ⟨A, hAtop, hlocal⟩

/-! ## All finite exponents from the literal planar endpoints -/

open Auto.Spherical.PowerWeights
open Auto.Spherical.Auxiliary
open Auto.Spherical.Auxiliary
open Auto.Spherical.Auxiliary

/-- The raw all-radius top endpoint retains the `ENNReal` estimate, so it
also provides literal pointwise finiteness for the relative band. -/
private theorem aux_relativeInterpolation_exists_restrictedRelativeBandpass_raw_top_bound
    {d : Nat} (phi : SchwartzMap (Euclidean d) Complex) :
    ∃ Ctop : Real, 0 < Ctop ∧ ∀ (j : Nat) (E : Set Real)
      (f : SchwartzMap (Euclidean d) Complex) (a : Real), 0 ≤ a →
      (∀ x, ‖f x‖ ≤ a) → ∀ x,
        restrictedRelativeBandpassSphericalMaximal d E phi j f x ≤
          ENNReal.ofReal (Ctop * a) := by
  obtain ⟨psi, hpsi⟩ := exists_schwartzMap_smooth_dyadic_bandpass phi 0
  let B : Real :=
    (∫ y : Euclidean d, ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) Complex) y‖) *
      surfaceMass d
  have hB : 0 ≤ B := by
    dsimp only [B]
    exact mul_nonneg (integral_nonneg fun y => norm_nonneg _) ENNReal.toReal_nonneg
  refine ⟨B + 1, by linarith, ?_⟩
  intro j E f a ha hfa x
  have hscalar : (2 : Real)⁻¹ * ((2 : Real) ^ j)⁻¹ = ((2 : Real) ^ (j + 1))⁻¹ := by
    rw [pow_succ, mul_inv_rev]
  have hmult (r : Ioi (0 : Real)) :
      (fun ξ : Euclidean d =>
        surfaceFourier d (-r.1 • ξ) *
          (phi (((2 : Real) ^ (j + 1))⁻¹ • (r.1 • ξ)) -
            phi (((2 : Real) ^ j)⁻¹ • (r.1 • ξ))) *
          𝓕 (f : Euclidean d → Complex) ξ) =
        fun ξ : Euclidean d =>
          surfaceFourier d (-r.1 • ξ) *
            psi (((2 : Real) ^ j)⁻¹ • (r.1 • ξ)) *
              𝓕 (f : Euclidean d → Complex) ξ := by
    funext ξ
    rw [hpsi (((2 : Real) ^ j)⁻¹ • (r.1 • ξ))]
    simp only [zero_add, pow_one, pow_zero, inv_one, one_smul]
    have hfirst : (2 : Real)⁻¹ • (((2 : Real) ^ j)⁻¹ • (r.1 • ξ)) =
        ((2 : Real) ^ (j + 1))⁻¹ • (r.1 • ξ) := by
      calc
        (2 : Real)⁻¹ • (((2 : Real) ^ j)⁻¹ • (r.1 • ξ)) =
            ((2 : Real)⁻¹ * ((2 : Real) ^ j)⁻¹) • (r.1 • ξ) := smul_smul _ _ _
        _ = _ := by rw [hscalar]
    rw [hfirst]
  have hrestricted :
      restrictedRelativeBandpassSphericalMaximal d E phi j f x ≤
        ⨆ r : Ioi (0 : Real), ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean d =>
          surfaceFourier d (-r.1 • ξ) *
            psi (((2 : Real) ^ j)⁻¹ • (r.1 • ξ)) *
            𝓕 (f : Euclidean d → Complex) ξ) x‖ := by
    unfold restrictedRelativeBandpassSphericalMaximal
    apply iSup_le
    intro r
    rw [hmult ⟨r.1, r.2.2⟩]
    exact le_iSup
      (fun q : Ioi (0 : Real) => ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean d =>
        surfaceFourier d (-q.1 • ξ) *
          psi (((2 : Real) ^ j)⁻¹ • (q.1 • ξ)) *
          𝓕 (f : Euclidean d → Complex) ξ) x‖)
      ⟨r.1, r.2.2⟩
  have hall :=
    iSup_ennreal_norm_fourierInv_relative_surface_scaled_schwartz_multiplier_le
      psi f j hfa x
  have hraw :
      restrictedRelativeBandpassSphericalMaximal d E phi j f x ≤
        ENNReal.ofReal (B * a) := by
    calc
      restrictedRelativeBandpassSphericalMaximal d E phi j f x ≤
          ⨆ r : Ioi (0 : Real), ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean d =>
            surfaceFourier d (-r.1 • ξ) *
              psi (((2 : Real) ^ j)⁻¹ • (r.1 • ξ)) *
              𝓕 (f : Euclidean d → Complex) ξ) x‖ := hrestricted
      _ ≤ ENNReal.ofReal
          ((a * ∫ y : Euclidean d, ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) Complex) y‖) *
            surfaceMass d) := hall
      _ = ENNReal.ofReal (B * a) := by
        congr 1
        dsimp only [B]
        ring
  have hBa : 0 ≤ B * a := mul_nonneg hB ha
  calc
    restrictedRelativeBandpassSphericalMaximal d E phi j f x ≤
        ENNReal.ofReal (B * a) := hraw
    _ ≤ ENNReal.ofReal ((B + 1) * a) := by
      apply ENNReal.ofReal_le_ofReal
      nlinarith

/-- Finite raw output lets its `ENNReal` and real-valued norm presentations
agree exactly. -/
private theorem aux_relativeInterpolation_eLpNorm_ennreal_eq_eLpNorm_toReal_of_forall_ne_top
    {X : Type*} [MeasurableSpace X] (F : X → ENNReal) (q : ENNReal)
    (μ : Measure X) (hF : ∀ x, F x ≠ ∞) :
    eLpNorm F q μ = eLpNorm (fun x => (F x).toReal) q μ := by
  apply eLpNorm_congr_enorm_ae
  filter_upwards with x
  rw [enorm_eq_self, ← ofReal_norm]
  simpa only [Real.norm_eq_abs, abs_of_nonneg ENNReal.toReal_nonneg] using
    (ENNReal.ofReal_toReal (hF x)).symm

private theorem aux_relativeInterpolation_memLp_ennreal_of_memLp_toReal
    {X : Type*} [MeasurableSpace X] (F : X → ENNReal) {q : ENNReal}
    {μ : Measure X} (hFmeas : Measurable F) (hFtop : ∀ x, F x ≠ ∞)
    (hF : MemLp (fun x => (F x).toReal) q μ) :
    MemLp F q μ := by
  apply hF.congr_enorm
  · exact hFmeas.aestronglyMeasurable
  · filter_upwards with x
    rw [enorm_eq_self, ← ofReal_norm]
    simpa only [Real.norm_eq_abs, abs_of_nonneg ENNReal.toReal_nonneg] using
      ENNReal.ofReal_toReal (hFtop x)

/-- Raw top control makes every literal all-radius relative-band value finite
on Schwartz inputs. -/
private theorem aux_relativeInterpolation_restrictedRelativeBandpass_ne_top
    (C : Auto.LittlewoodPaley.lpCutoffs 2) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) :
    restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f x ≠ ∞ := by
  rcases aux_relativeInterpolation_exists_restrictedRelativeBandpass_raw_top_bound C.cutoff with
    ⟨Ctop, hCtop, htop⟩
  let a : Real := SchwartzMap.seminorm Complex 0 0 f
  have ha : 0 ≤ a := by
    dsimp only [a]
    exact (norm_nonneg (f 0)).trans (SchwartzMap.norm_le_seminorm Complex f 0)
  have hfa : ∀ y : Euclidean 2, ‖f y‖ ≤ a := by
    intro y
    exact SchwartzMap.norm_le_seminorm Complex f y
  apply ne_top_of_le_ne_top ENNReal.ofReal_ne_top
  exact htop j (Ioi (0 : Real)) f a ha hfa x

/-- Measurability of the low smooth splitting profile in the literal
`ENNReal` moment form used by the source/output interpolation engine. -/
private theorem aux_relativeInterpolation_measurable_smooth_low_profile_lintegrals
    {d : Nat} (f : SchwartzMap (Euclidean d) Complex)
    (low high : Real → SchwartzMap (Euclidean d) Complex)
    (hlow : ∀ t x, low t x =
      ((smooth_half_height_bump ((t⁻¹ : Real) • f x) : Real) : Complex) • f x)
    (_hhigh : ∀ t, high t = f - low t)
    {μ : Measure (Euclidean d)} [SFinite μ] (q : Real) :
    Measurable (fun t : Real => ∫⁻ x,
      (ENNReal.ofReal ‖low t x‖) ^ q ∂μ) := by
  have hjoint : Measurable (fun z : Real × Euclidean d => low z.1 z.2) := by
    rw [show (fun z : Real × Euclidean d => low z.1 z.2) =
      fun z => ((smooth_half_height_bump ((z.1⁻¹ : Real) • f z.2) : Real) : Complex) •
        f z.2 by
      funext z
      exact hlow z.1 z.2]
    let η : ContDiffBump (0 : Complex) := smooth_half_height_bump
    have hf : Measurable (fun z : Real × Euclidean d => f z.2) :=
      f.continuous.measurable.comp measurable_snd
    have hscale : Measurable (fun z : Real × Euclidean d =>
        (z.1⁻¹ : Real) • f z.2) :=
      measurable_fst.inv.smul hf
    have hcut_real : Measurable (fun z : Real × Euclidean d =>
        η ((z.1⁻¹ : Real) • f z.2)) :=
      η.continuous.measurable.comp hscale
    have hcut : Measurable (fun z : Real × Euclidean d =>
        ((η ((z.1⁻¹ : Real) • f z.2) : Real) : Complex)) :=
      Complex.ofRealCLM.continuous.measurable.comp hcut_real
    exact hcut.smul hf
  apply Measurable.lintegral_prod_right
  exact ENNReal.continuous_rpow_const.measurable.comp
    hjoint.norm.ennreal_ofReal

/-- The generic literal Schwartz-core 2--4 source/output interpolation
argument. -/
private theorem aux_relativeInterpolation_two_four_smooth_interpolation
    (T : SchwartzMap (Euclidean 2) Complex → Euclidean 2 → Real)
    (hTnonneg : ∀ g x, 0 ≤ T g x)
    (hTsub : ∀ g h x, T (g + h) x ≤ T g x + T h x)
    (hTmeas : ∀ g, AEStronglyMeasurable (T g) volume)
    {p : Real} (hp2 : 2 < p) (hp4 : p < 4)
    (B2 B4 : ENNReal)
    (hstrong2 : ∀ g : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (T g) (ENNReal.ofReal 2) volume ≤
        B2 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 2) volume)
    (hstrong4 : ∀ g : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (T g) (ENNReal.ofReal 4) volume ≤
        B4 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume)
    (s : Real) (hs : 0 < s)
    (f : SchwartzMap (Euclidean 2) Complex) :
    eLpNorm (T f) (ENNReal.ofReal p) volume ≤
      (Auto.Spherical.MSSBase.sourceOutputTwoPairMarcinkiewiczMomentCoefficient p 2 4
        (B2 ^ (2 : Real)) (B4 ^ (4 : Real))
        ((ENNReal.ofReal s) ^ ((2 : Real) - p) *
          ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2)))
        ((ENNReal.ofReal s) ^ ((4 : Real) - p) *
          ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
            (ENNReal.ofReal (4 - p))⁻¹))) ^ p⁻¹ *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
  let D : Set (SchwartzMap (Euclidean 2) Complex) := Set.univ
  let eval : SchwartzMap (Euclidean 2) Complex → Euclidean 2 → Complex := fun g => g
  have hTf : AEMeasurable (T f) volume := (hTmeas f).aemeasurable
  rcases exists_schwartz_smooth_low_high_family f with
    ⟨low, high, hlow, hhigh, hsplit⟩
  have hlowI_raw : Measurable (fun t : Real => ∫⁻ x,
      (ENNReal.ofReal ‖low t x‖) ^ (4 : Real)) :=
    aux_relativeInterpolation_measurable_smooth_low_profile_lintegrals f low high hlow hhigh 4
  have hhighI_raw : Measurable (fun t : Real => ∫⁻ x,
      (ENNReal.ofReal ‖high t x‖) ^ (2 : Real)) :=
    measurable_smooth_high_profile_lintegrals f low high hlow hhigh 2
  have hlowI_meas : Measurable (fun t =>
      (eLpNorm (eval (low t)) (ENNReal.ofReal 4) volume) ^ (4 : Real)) := by
    rw [show (fun t =>
      (eLpNorm (eval (low t)) (ENNReal.ofReal 4) volume) ^ (4 : Real)) =
      fun t => ∫⁻ x, (ENNReal.ofReal ‖low t x‖) ^ (4 : Real) by
      funext t
      exact (Auto.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow
        (by norm_num) (low t)).symm]
    exact hlowI_raw
  have hhighI_meas : Measurable (fun t =>
      (eLpNorm (eval (high t)) (ENNReal.ofReal 2) volume) ^ (2 : Real)) := by
    rw [show (fun t =>
      (eLpNorm (eval (high t)) (ENNReal.ofReal 2) volume) ^ (2 : Real)) =
      fun t => ∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ (2 : Real) by
      funext t
      exact (Auto.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow
        (by norm_num) (high t)).symm]
    exact hhighI_raw
  have hhighTailRaw := smooth_bump_schwartz_high_q_weighted_tail f low high hlow hhigh
    (q := 2) (p := p) (by norm_num) hp2
  have hhigh_tail :
      (∫⁻ t in Ioi (0 : Real),
        (eLpNorm (eval (high t)) (ENNReal.ofReal 2) volume) ^ (2 : Real) *
          (ENNReal.ofReal t) ^ (p - 2 - 1)) ≤
        ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2)) *
          (eLpNorm (eval f) (ENNReal.ofReal p) volume) ^ p := by
    calc
      (∫⁻ t in Ioi (0 : Real),
        (eLpNorm (eval (high t)) (ENNReal.ofReal 2) volume) ^ (2 : Real) *
          (ENNReal.ofReal t) ^ (p - 2 - 1)) =
          ∫⁻ t in Ioi (0 : Real),
            (∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ (2 : Real)) *
              (ENNReal.ofReal t) ^ (p - 2 - 1) := by
            apply lintegral_congr
            intro t
            exact congrArg (fun a => a * (ENNReal.ofReal t) ^ (p - 2 - 1))
              (Auto.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow
                (by norm_num) (high t)).symm
      _ ≤ ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2)) *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := hhighTailRaw
      _ = _ := by
        rw [Auto.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow
          (lt_trans (by norm_num) hp2) f]
  have hlowTailRaw := Auto.Spherical.MSSBase.smooth_bump_schwartz_low_q_weighted_tail
    f low high hlow hhigh (p := p) (q := 4) (lt_trans (by norm_num) hp2) hp4
  have hlow_tail :
      (∫⁻ t in Ioi (0 : Real),
        (eLpNorm (eval (low t)) (ENNReal.ofReal 4) volume) ^ (4 : Real) *
          (ENNReal.ofReal t) ^ (p - 4 - 1)) ≤
        ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
          (ENNReal.ofReal (4 - p))⁻¹) *
          (eLpNorm (eval f) (ENNReal.ofReal p) volume) ^ p := by
    calc
      (∫⁻ t in Ioi (0 : Real),
        (eLpNorm (eval (low t)) (ENNReal.ofReal 4) volume) ^ (4 : Real) *
          (ENNReal.ofReal t) ^ (p - 4 - 1)) =
          ∫⁻ t in Ioi (0 : Real),
            (∫⁻ x, (ENNReal.ofReal ‖low t x‖) ^ (4 : Real)) *
              (ENNReal.ofReal t) ^ (p - 4 - 1) := by
            apply lintegral_congr
            intro t
            exact congrArg (fun a => a * (ENNReal.ofReal t) ^ (p - 4 - 1))
              (Auto.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow
                (by norm_num) (low t)).symm
      _ ≤ ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
          (ENNReal.ofReal (4 - p))⁻¹) *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := hlowTailRaw
      _ = _ := by
        rw [Auto.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow
          (lt_trans (by norm_num) hp2) f]
  exact Auto.Spherical.MSSBase.sourceOutput_two_pair_eLpNorm_le_of_scaled_strong_endpoints_and_split_tails
    D eval T hTnonneg
    (by
      intro g h _ _ x
      exact hTsub g h x)
    (by
      intro g _
      exact hTmeas g)
    (by norm_num) (by norm_num) (lt_trans (by norm_num) hp2)
    B2 B4
    (by
      intro g _
      exact hstrong2 g)
    (by
      intro g _
      exact hstrong4 g)
    f hTf low high
    (fun _ => by simp [D]) (fun _ => by simp [D])
    (fun t => by
      ext x
      exact hsplit t x)
    hlowI_meas hhighI_meas
    ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2))
    ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
      (ENNReal.ofReal (4 - p))⁻¹)
    hhigh_tail hlow_tail s hs

/-- Algebraic normalization for the uniform L2 / decaying L4 split. -/
private theorem aux_relativeInterpolation_two_four_uniform_decay_coefficient_factor
    {p b : Real} (_hp : 0 < p) (hb : 0 < b)
    (B2 H L : ENNReal) :
    Auto.Spherical.MSSBase.sourceOutputTwoPairMarcinkiewiczMomentCoefficient p 2 4
        (B2 ^ (2 : Real)) ((ENNReal.ofReal b) ^ (4 : Real))
        ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((2 : Real) - p) * H)
        ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((4 : Real) - p) * L) =
      (ENNReal.ofReal p *
        ((ENNReal.ofReal 2) ^ (2 : Real) * B2 ^ (2 : Real) * H +
          (ENNReal.ofReal 2) ^ (4 : Real) * L)) *
        (ENNReal.ofReal b) ^ (2 * p - 4) := by
  let B : ENNReal := ENNReal.ofReal b
  let Q : ENNReal := ENNReal.ofReal 2
  have hB0 : B ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hb
  have hBtop : B ≠ ∞ := ENNReal.ofReal_ne_top
  have hs : ENNReal.ofReal (b⁻¹ * b⁻¹) = B ^ (-2 : Real) := by
    rw [ENNReal.ofReal_mul (inv_nonneg.mpr hb.le), ENNReal.ofReal_inv_of_pos hb]
    dsimp only [B]
    rw [← ENNReal.rpow_neg_one]
    rw [← ENNReal.rpow_add _ _ hB0 hBtop]
    congr 1
    ring
  have hpow0 : (B ^ (-2 : Real)) ^ ((2 : Real) - p) = B ^ (2 * p - 4) := by
    rw [← ENNReal.rpow_mul]
    congr 1
    ring
  have hpow1 : B ^ (4 : Real) * (B ^ (-2 : Real)) ^ ((4 : Real) - p) =
      B ^ (2 * p - 4) := by
    rw [← ENNReal.rpow_mul]
    rw [← ENNReal.rpow_add _ _ hB0 hBtop]
    congr 1
    ring
  change ENNReal.ofReal p *
      (Q ^ (2 : Real) * B2 ^ (2 : Real) *
          (ENNReal.ofReal (b⁻¹ * b⁻¹) ^ ((2 : Real) - p) * H) +
        Q ^ (4 : Real) * B ^ (4 : Real) *
          (ENNReal.ofReal (b⁻¹ * b⁻¹) ^ ((4 : Real) - p) * L)) = _
  rw [hs, hpow0]
  rw [show Q ^ (4 : Real) * B ^ (4 : Real) *
      ((B ^ (-2 : Real)) ^ ((4 : Real) - p) * L) =
      Q ^ (4 : Real) * (B ^ (4 : Real) *
        (B ^ (-2 : Real)) ^ ((4 : Real) - p)) * L by ac_rfl, hpow1]
  rw [show Q ^ (2 : Real) * B2 ^ (2 : Real) *
      (B ^ (2 * p - 4) * H) +
      Q ^ (4 : Real) * B ^ (2 * p - 4) * L =
      (Q ^ (2 : Real) * B2 ^ (2 :Real) * H + Q ^ (4 : Real) * L) *
        B ^ (2 * p - 4) by
      rw [add_mul]
      ac_rfl]
  ac_rfl

private theorem aux_relativeInterpolation_two_four_uniform_decay_root_factor
    {p : Real} (hp : 0 < p) (K b : ENNReal) :
    (K * b ^ (2 * p - 4)) ^ p⁻¹ =
      K ^ p⁻¹ * b ^ (2 - 4 / p) := by
  rw [ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hp.le),
    ← ENNReal.rpow_mul]
  congr 1
  field_simp

private theorem aux_relativeInterpolation_ofReal_product_pow_rpow
    {a r θ : Real} (ha : 0 < a) (hr : 0 < r) (hθ : 0 ≤ θ) (j : Nat) :
    (ENNReal.ofReal (a * r ^ j)) ^ θ =
      ENNReal.ofReal (a ^ θ) * ENNReal.ofReal (r ^ ((j : Real) * θ)) := by
  rw [ENNReal.ofReal_mul ha.le,
    ENNReal.mul_rpow_of_nonneg _ _ hθ]
  rw [ENNReal.ofReal_rpow_of_pos ha]
  congr 1
  rw [show r ^ ((j : Real) * θ) = (r ^ j) ^ θ by
    rw [← Real.rpow_natCast]
    rw [← Real.rpow_mul hr.le]]
  rw [ENNReal.ofReal_rpow_of_pos (pow_pos hr _)]

/-- Replace a finite `ENNReal` geometric rate by a positive real majorant,
including the possible endpoint rate zero. -/
private theorem aux_relativeInterpolation_exists_positive_real_geometric_majorant
    {B rho : ENNReal} (hBtop : B ≠ ∞) (hrho : rho < 1) :
    ∃ A r : Real, 0 < A ∧ 0 < r ∧ r < 1 ∧
      ∀ j : Nat, B * rho ^ j ≤ ENNReal.ofReal (A * r ^ j) := by
  let A : Real := B.toReal + 1
  let r : Real := (rho.toReal + 1) / 2
  have hrhotop : rho ≠ ∞ := ne_top_of_le_ne_top ENNReal.one_ne_top (le_of_lt hrho)
  have hrhoreal : rho.toReal < 1 := by
    simpa only [ENNReal.toReal_one] using
      (ENNReal.toReal_lt_toReal hrhotop ENNReal.one_ne_top).mpr hrho
  have hA : 0 < A := by
    dsimp only [A]
    positivity
  have hr : 0 < r := by
    dsimp only [r]
    positivity
  have hrone : r < 1 := by
    dsimp only [r]
    linarith
  have hB : B ≤ ENNReal.ofReal A := by
    calc
      B = ENNReal.ofReal B.toReal := (ENNReal.ofReal_toReal hBtop).symm
      _ ≤ ENNReal.ofReal (B.toReal + 1) := by
        apply ENNReal.ofReal_le_ofReal
        linarith
      _ = ENNReal.ofReal A := rfl
  have hrho : rho ≤ ENNReal.ofReal r := by
    rw [← ENNReal.ofReal_toReal hrhotop]
    apply ENNReal.ofReal_le_ofReal
    dsimp only [r]
    linarith
  refine ⟨A, r, hA, hr, hrone, ?_⟩
  intro j
  calc
    B * rho ^ j ≤ ENNReal.ofReal A * (ENNReal.ofReal r) ^ j := by
      gcongr
    _ = ENNReal.ofReal (A * r ^ j) := by
      rw [← ENNReal.ofReal_pow hr.le, ← ENNReal.ofReal_mul hA.le]

private theorem aux_relativeInterpolation_two_four_uniform_decay_static_finite
    {p : Real} (hp2 : 2 < p) (hp4 : p < 4)
    {B2 : ENNReal} (hB2top : B2 ≠ ∞) :
    (ENNReal.ofReal p *
      ((ENNReal.ofReal 2) ^ (2 : Real) * B2 ^ (2 : Real) *
        ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2)) +
        (ENNReal.ofReal 2) ^ (4 : Real) *
          ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
            (ENNReal.ofReal (4 - p))⁻¹))) ^ p⁻¹ ≠ ∞ := by
  have hp0 : 0 < p := lt_trans (by norm_num) hp2
  have hp2' : 0 < p - 2 := sub_pos.mpr hp2
  have hp4' : 0 < 4 - p := sub_pos.mpr hp4
  apply ENNReal.rpow_ne_top_of_nonneg (inv_nonneg.mpr hp0.le)
  apply ENNReal.mul_ne_top ENNReal.ofReal_ne_top
  apply ENNReal.add_ne_top.mpr
  constructor
  · apply ENNReal.mul_ne_top
    · apply ENNReal.mul_ne_top
      · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
      · exact ENNReal.rpow_ne_top_of_nonneg (by norm_num) hB2top
    · apply ENNReal.mul_ne_top
      · exact ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hp2')
      · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
  · apply ENNReal.mul_ne_top
    · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
    · apply ENNReal.add_ne_top.mpr
      constructor
      · apply ENNReal.mul_ne_top
        · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
        · exact ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hp0)
      · exact ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hp4')

/-- Interpolate a uniform literal L2 band endpoint with a real-valued
geometrically decaying L4 endpoint at one fixed dyadic band. -/
private theorem aux_relativeInterpolation_relative_band_two_four_uniform_decay_coefficient
    (C : Auto.LittlewoodPaley.lpCutoffs 2)
    (B2 : ENNReal)
    (h2 : ∀ (j : Nat) (g : SchwartzMap (Euclidean 2) Complex),
      eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
        C.cutoff j g) (ENNReal.ofReal 2) volume ≤
        B2 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 2) volume)
    {A r : Real} (hA : 0 < A) (hr : 0 < r)
    (h4 : ∀ (j : Nat) (g : SchwartzMap (Euclidean 2) Complex),
      eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
        C.cutoff j g) (ENNReal.ofReal 4) volume ≤
        ENNReal.ofReal (A * r ^ j) *
          eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume)
    {p : Real} (hp2 : 2 < p) (hp4 : p < 4)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    eLpNorm (fun x =>
      (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f x).toReal)
        (ENNReal.ofReal p) volume ≤
      ((ENNReal.ofReal p *
        ((ENNReal.ofReal 2) ^ (2 : Real) * B2 ^ (2 : Real) *
          ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2)) +
          (ENNReal.ofReal 2) ^ (4 : Real) *
            ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
              (ENNReal.ofReal (4 - p))⁻¹))) ^ p⁻¹ *
        (ENNReal.ofReal (A * r ^ j)) ^ (2 - 4 / p)) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
  let T : SchwartzMap (Euclidean 2) Complex → Euclidean 2 → Real :=
    fun g x =>
      (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j g x).toReal
  have hTnonneg : ∀ g x, 0 ≤ T g x := by
    intro g x
    exact ENNReal.toReal_nonneg
  have hTsub : ∀ g h x, T (g + h) x ≤ T g x + T h x := by
    intro g h x
    dsimp only [T]
    exact toReal_restrictedRelativeBandpassSphericalMaximal_add_le_of_ne_top
      (Ioi (0 : Real)) C.cutoff g h j x
      (fun k => aux_relativeInterpolation_restrictedRelativeBandpass_ne_top C j k x)
  have hTmeas : ∀ g, AEStronglyMeasurable (T g) volume := by
    intro g
    dsimp only [T]
    exact (measurable_restrictedRelativeBandpassSphericalMaximal_global
      (Ioi (0 : Real)) C.cutoff g C.cutoff_one C.cutoff_zero j).ennreal_toReal.aestronglyMeasurable
  let b : Real := A * r ^ j
  have hb : 0 < b := by
    dsimp only [b]
    exact mul_pos hA (pow_pos hr _)
  have hstrong2 : ∀ g : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (T g) (ENNReal.ofReal 2) volume ≤
        B2 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 2) volume := by
    intro g
    calc
      eLpNorm (T g) (ENNReal.ofReal 2) volume =
          eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
            C.cutoff j g) (ENNReal.ofReal 2) volume := by
        exact (aux_relativeInterpolation_eLpNorm_ennreal_eq_eLpNorm_toReal_of_forall_ne_top
          (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j g)
          (ENNReal.ofReal 2) volume
          (fun x => aux_relativeInterpolation_restrictedRelativeBandpass_ne_top C j g x)).symm
      _ ≤ B2 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 2) volume := h2 j g
  have hstrong4 : ∀ g : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (T g) (ENNReal.ofReal 4) volume ≤
        ENNReal.ofReal b * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := by
    intro g
    calc
      eLpNorm (T g) (ENNReal.ofReal 4) volume =
          eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
            C.cutoff j g) (ENNReal.ofReal 4) volume := by
        exact (aux_relativeInterpolation_eLpNorm_ennreal_eq_eLpNorm_toReal_of_forall_ne_top
          (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j g)
          (ENNReal.ofReal 4) volume
          (fun x => aux_relativeInterpolation_restrictedRelativeBandpass_ne_top C j g x)).symm
      _ ≤ ENNReal.ofReal (A * r ^ j) *
          eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := h4 j g
      _ = ENNReal.ofReal b *
          eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := rfl
  let H : ENNReal := (ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2)
  let L : ENNReal :=
    (ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
      (ENNReal.ofReal (4 - p))⁻¹
  let K : ENNReal := ENNReal.ofReal p *
    ((ENNReal.ofReal 2) ^ (2 : Real) * B2 ^ (2 : Real) * H +
      (ENNReal.ofReal 2) ^ (4 : Real) * L)
  have hs : 0 < b⁻¹ * b⁻¹ := by positivity
  have hinterp := aux_relativeInterpolation_two_four_smooth_interpolation
    T hTnonneg hTsub hTmeas hp2 hp4
    B2 (ENNReal.ofReal b) hstrong2 hstrong4 (b⁻¹ * b⁻¹) hs f
  have hcoef :
      Auto.Spherical.MSSBase.sourceOutputTwoPairMarcinkiewiczMomentCoefficient p 2 4
          (B2 ^ (2 : Real)) ((ENNReal.ofReal b) ^ (4 : Real))
          ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((2 : Real) - p) * H)
          ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((4 : Real) - p) * L) =
        K * (ENNReal.ofReal b) ^ (2 * p - 4) := by
    dsimp only [K]
    exact aux_relativeInterpolation_two_four_uniform_decay_coefficient_factor
      (lt_trans (by norm_num) hp2) hb B2 H L
  have hroot := aux_relativeInterpolation_two_four_uniform_decay_root_factor
    (lt_trans (by norm_num) hp2) K (ENNReal.ofReal b)
  calc
    eLpNorm (fun x =>
      (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f x).toReal)
        (ENNReal.ofReal p) volume = eLpNorm (T f) (ENNReal.ofReal p) volume := rfl
    _ ≤ (Auto.Spherical.MSSBase.sourceOutputTwoPairMarcinkiewiczMomentCoefficient p 2 4
          (B2 ^ (2 : Real)) ((ENNReal.ofReal b) ^ (4 : Real))
          ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((2 : Real) - p) * H)
          ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((4 : Real) - p) * L)) ^ p⁻¹ *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
      exact hinterp
    _ = (K * (ENNReal.ofReal b) ^ (2 * p - 4)) ^ p⁻¹ *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by rw [hcoef]
    _ = (K ^ p⁻¹ * (ENNReal.ofReal b) ^ (2 - 4 / p)) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by rw [hroot]
    _ = (ENNReal.ofReal p *
        ((ENNReal.ofReal 2) ^ (2 : Real) * B2 ^ (2 : Real) * H +
          (ENNReal.ofReal 2) ^ (4 : Real) * L)) ^ p⁻¹ *
        (ENNReal.ofReal b) ^ (2 - 4 / p) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
      dsimp only [K]
    _ = (ENNReal.ofReal p *
        ((ENNReal.ofReal 2) ^ (2 : Real) * B2 ^ (2 : Real) *
          ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2)) +
          (ENNReal.ofReal 2) ^ (4 : Real) *
            ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
              (ENNReal.ofReal (4 - p))⁻¹))) ^ p⁻¹ *
        (ENNReal.ofReal (A * r ^ j)) ^ (2 - 4 / p) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
      dsimp only [H, L, b]

/-- The below-four bridge: a literal uniform all-radius L2 endpoint plus the
geometrically decaying L4 endpoint gives decay at every `2 < p < 4`. -/
private theorem aux_relativeInterpolation_hasRelativeCircularBandGeometricDecay_two_four_of_uniform
    (C : Auto.LittlewoodPaley.lpCutoffs 2)
    (B2 : ENNReal) (hB2top : B2 ≠ ∞)
    (h2 : ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      MemLp (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
        C.cutoff j f) (ENNReal.ofReal 2) volume ∧
        eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
          C.cutoff j f) (ENNReal.ofReal 2) volume ≤
          B2 * eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal 2) volume)
    (h4 : HasRelativeCircularBandGeometricDecay 4 C.cutoff)
    {p : Real} (hp2 : 2 < p) (hp4 : p < 4) :
    HasRelativeCircularBandGeometricDecay p C.cutoff := by
  rcases h4 with ⟨B4, rho4, hB4top, hrho4, h4⟩
  rcases aux_relativeInterpolation_exists_positive_real_geometric_majorant hB4top hrho4 with
    ⟨A, r, hA, hr, hrone, hmajor⟩
  let θ : Real := 2 - 4 / p
  have hp0 : 0 < p := lt_trans (by norm_num) hp2
  have hθ : 0 < θ := by
    dsimp only [θ]
    apply sub_pos.mpr
    rw [div_lt_iff₀ hp0]
    nlinarith
  let K : ENNReal := ENNReal.ofReal p *
    ((ENNReal.ofReal 2) ^ (2 : Real) * B2 ^ (2 : Real) *
      ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2)) +
      (ENNReal.ofReal 2) ^ (4 : Real) *
        ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
          (ENNReal.ofReal (4 - p))⁻¹))
  let bandConst : ENNReal := K ^ p⁻¹ * (ENNReal.ofReal A) ^ θ
  let rho : ENNReal := (ENNReal.ofReal r) ^ θ
  have hKtop : K ^ p⁻¹ ≠ ∞ := by
    dsimp only [K]
    exact aux_relativeInterpolation_two_four_uniform_decay_static_finite hp2 hp4 hB2top
  have hAtop : (ENNReal.ofReal A) ^ θ ≠ ∞ :=
    ENNReal.rpow_ne_top_of_nonneg hθ.le ENNReal.ofReal_ne_top
  have hbandConstTop : bandConst ≠ ∞ := by
    dsimp only [bandConst]
    exact ENNReal.mul_ne_top hKtop hAtop
  have hrho : rho < 1 := by
    dsimp only [rho]
    exact ENNReal.rpow_lt_one (ENNReal.ofReal_lt_one.mpr hrone) hθ
  refine ⟨bandConst, rho, hbandConstTop, hrho, ?_⟩
  intro j f
  have h4' : ∀ (k : Nat) (g : SchwartzMap (Euclidean 2) Complex),
      eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
        C.cutoff k g) (ENNReal.ofReal 4) volume ≤
        ENNReal.ofReal (A * r ^ k) *
          eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := by
    intro k g
    calc
      eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
          C.cutoff k g) (ENNReal.ofReal 4) volume ≤
          B4 * rho4 ^ k *
            eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := (h4 k g).2
      _ ≤ ENNReal.ofReal (A * r ^ k) *
            eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume :=
        mul_le_mul_of_nonneg_right (hmajor k) (by positivity)
  have hinterp := aux_relativeInterpolation_relative_band_two_four_uniform_decay_coefficient
    C B2 (fun k g => (h2 k g).2) hA hr h4' hp2 hp4 j f
  have hinterp' :
      eLpNorm (fun x =>
        (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f x).toReal)
          (ENNReal.ofReal p) volume ≤
        K ^ p⁻¹ * (ENNReal.ofReal (A * r ^ j)) ^ θ *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
    simpa only [K, θ] using hinterp
  have hratepow : ENNReal.ofReal (r ^ ((j : Real) * θ)) = rho ^ j := by
    dsimp only [rho]
    calc
      ENNReal.ofReal (r ^ ((j : Real) * θ)) =
          (ENNReal.ofReal r) ^ ((j : Real) * θ) :=
        (ENNReal.ofReal_rpow_of_pos hr).symm
      _ = (ENNReal.ofReal r) ^ (θ * (j : Real)) := by
        congr 1
        ring
      _ = ((ENNReal.ofReal r) ^ θ) ^ ((j : Real)) :=
        ENNReal.rpow_mul _ θ (j : Real)
      _ = ((ENNReal.ofReal r) ^ θ) ^ j := by
        rw [ENNReal.rpow_natCast]
  have hArate : (ENNReal.ofReal (A * r ^ j)) ^ θ =
      (ENNReal.ofReal A) ^ θ * rho ^ j := by
    rw [aux_relativeInterpolation_ofReal_product_pow_rpow hA hr hθ.le j,
      ENNReal.ofReal_rpow_of_pos hA, hratepow]
  have hnorm :
      eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
        C.cutoff j f) (ENNReal.ofReal p) volume ≤
        bandConst * rho ^ j *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
    calc
      eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
          C.cutoff j f) (ENNReal.ofReal p) volume =
          eLpNorm (fun x =>
            (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
              C.cutoff j f x).toReal) (ENNReal.ofReal p) volume :=
        aux_relativeInterpolation_eLpNorm_ennreal_eq_eLpNorm_toReal_of_forall_ne_top
          (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f)
          (ENNReal.ofReal p) volume
          (fun x => aux_relativeInterpolation_restrictedRelativeBandpass_ne_top C j f x)
      _ ≤ K ^ p⁻¹ * (ENNReal.ofReal (A * r ^ j)) ^ θ *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := hinterp'
      _ = bandConst * rho ^ j *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
        rw [hArate]
        dsimp only [bandConst]
        ac_rfl
  have hrhoTop : rho ≠ ∞ :=
    ENNReal.rpow_ne_top_of_nonneg hθ.le ENNReal.ofReal_ne_top
  have hfmem : MemLp (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume :=
    f.memLp _ volume
  have hrightTop : bandConst * rho ^ j *
      eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume ≠ ∞ :=
    ENNReal.mul_ne_top
      (ENNReal.mul_ne_top hbandConstTop (ENNReal.pow_ne_top hrhoTop)) hfmem.eLpNorm_ne_top
  have hrealmem : MemLp (fun x =>
      (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f x).toReal)
        (ENNReal.ofReal p) volume :=
    Auto.LpSpaceFacts.memLp_of_aestronglyMeasurable_of_eLpNorm_le
      ((measurable_restrictedRelativeBandpassSphericalMaximal_global
        (Ioi (0 : Real)) C.cutoff f C.cutoff_one C.cutoff_zero j).ennreal_toReal.aestronglyMeasurable)
      (by
        exact (aux_relativeInterpolation_eLpNorm_ennreal_eq_eLpNorm_toReal_of_forall_ne_top
          (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f)
          (ENNReal.ofReal p) volume
          (fun x => aux_relativeInterpolation_restrictedRelativeBandpass_ne_top C j f x)).symm ▸ hnorm)
      (lt_top_iff_ne_top.mpr hrightTop)
  refine ⟨aux_relativeInterpolation_memLp_ennreal_of_memLp_toReal
    (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f)
    (measurable_restrictedRelativeBandpassSphericalMaximal_global
      (Ioi (0 : Real)) C.cutoff f C.cutoff_one C.cutoff_zero j)
    (fun x => aux_relativeInterpolation_restrictedRelativeBandpass_ne_top C j f x) hrealmem, hnorm⟩

/-- The generic literal Schwartz-core L4--L∞ source/output interpolation
argument used for the exponents above four. -/
private theorem aux_relativeInterpolation_four_top_smooth_interpolation
    (T : SchwartzMap (Euclidean 2) Complex → Euclidean 2 → Real)
    (hTnonneg : ∀ g x, 0 ≤ T g x)
    (hTsub : ∀ g h x, T (g + h) x ≤ T g x + T h x)
    (hTmeas : ∀ g, AEStronglyMeasurable (T g) volume)
    {p : Real} (hp4 : 4 < p)
    (B4 : ENNReal)
    (hstrong4 : ∀ g : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (T g) (ENNReal.ofReal 4) volume ≤
        B4 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume)
    (Btop : Real) (hBtop : 0 < Btop)
    (hTop : ∀ (g : SchwartzMap (Euclidean 2) Complex) (a : Real), 0 ≤ a →
      (∀ x, ‖g x‖ ≤ a) → ∀ x, T g x ≤ Btop * a)
    (f : SchwartzMap (Euclidean 2) Complex) :
    eLpNorm (T f) (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal Btop *
        (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
          (B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) *
          ((ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)))) ^ p⁻¹ *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
  let D : Set (SchwartzMap (Euclidean 2) Complex) := Set.univ
  let eval : SchwartzMap (Euclidean 2) Complex → Euclidean 2 → Complex := fun g => g
  let S : SchwartzMap (Euclidean 2) Complex → Euclidean 2 → Real :=
    fun g x => T g x / Btop
  have hSnonneg : ∀ g x, 0 ≤ S g x := by
    intro g x
    exact div_nonneg (hTnonneg g x) hBtop.le
  have hSsub : ∀ ⦃g h : SchwartzMap (Euclidean 2) Complex⦄,
      g ∈ D → h ∈ D → ∀ x, S (g + h) x ≤ S g x + S h x := by
    intro g h _ _ x
    change T (g + h) x / Btop ≤ T g x / Btop + T h x / Btop
    rw [← add_div]
    exact div_le_div_of_nonneg_right (hTsub g h x) hBtop.le
  have hSmeas : ∀ g, g ∈ D → AEStronglyMeasurable (S g) volume := by
    intro g _
    simpa only [S, div_eq_mul_inv] using (hTmeas g).mul_const (Btop⁻¹)
  have hSstrong : ∀ g, g ∈ D →
      eLpNorm (S g) (ENNReal.ofReal 4) volume ≤
        (B4 * (ENNReal.ofReal Btop)⁻¹) *
          eLpNorm (eval g) (ENNReal.ofReal 4) volume := by
    intro g _
    have hSeq : S g = (Btop⁻¹) • T g := by
      funext x
      change T g x / Btop = Btop⁻¹ * T g x
      field_simp [hBtop.ne']
    calc
      eLpNorm (S g) (ENNReal.ofReal 4) volume =
          ENNReal.ofReal (Btop⁻¹) * eLpNorm (T g) (ENNReal.ofReal 4) volume := by
        rw [hSeq, eLpNorm_const_smul]
        rw [Real.enorm_eq_ofReal (inv_nonneg.mpr hBtop.le)]
      _ ≤ ENNReal.ofReal (Btop⁻¹) *
          (B4 * eLpNorm (eval g) (ENNReal.ofReal 4) volume) := by
        apply mul_le_mul_right
        calc
          eLpNorm (T g) (ENNReal.ofReal 4) volume ≤
              B4 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume :=
            hstrong4 g
          _ = B4 * eLpNorm (eval g) (ENNReal.ofReal 4) volume := rfl
      _ = (B4 * (ENNReal.ofReal Btop)⁻¹) *
          eLpNorm (eval g) (ENNReal.ofReal 4) volume := by
        rw [ENNReal.ofReal_inv_of_pos hBtop]
        ac_rfl
  have hSweak : ∀ g, g ∈ D → ∀ {u : Real}, 0 < u →
      (ENNReal.ofReal u) ^ (4 : Real) *
          volume {x | u < S g x} ≤
        (B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) *
          (∫⁻ x, (ENNReal.ofReal ‖eval g x‖) ^ (4 : Real)) := by
    intro g _ u hu
    have hcheb := Auto.Spherical.MSSBase.sourceOutput_weak_distribution_of_eLpNorm (S g)
      (hSmeas g (by simp [D])) (by norm_num : (0 : Real) < 4) hu
      ((B4 * (ENNReal.ofReal Btop)⁻¹) *
        eLpNorm (eval g) (ENNReal.ofReal 4) volume) (hSstrong g (by simp [D]))
    calc
      (ENNReal.ofReal u) ^ (4 : Real) * volume {x | u < S g x} =
          volume {x | u < S g x} * (ENNReal.ofReal u) ^ (4 : Real) := by ac_rfl
      _ ≤ ((B4 * (ENNReal.ofReal Btop)⁻¹) *
          eLpNorm (eval g) (ENNReal.ofReal 4) volume) ^ (4 : Real) := hcheb
      _ = (B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) *
          (eLpNorm (eval g) (ENNReal.ofReal 4) volume) ^ (4 : Real) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]
      _ = _ := by
        rw [← Auto.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow
          (by norm_num) (eval g)]
  have hStop : ∀ g, g ∈ D → ∀ a : Real, 0 ≤ a →
      (∀ x, ‖eval g x‖ ≤ a) → ∀ x, S g x ≤ a := by
    intro g _ a ha hga x
    change T g x / Btop ≤ a
    rw [div_le_iff₀ hBtop]
    simpa [mul_comm] using hTop g a ha hga x
  rcases exists_schwartz_smooth_low_high_family f with
    ⟨low, high, hlow, hhigh, hsplit⟩
  have hhighI_meas : Measurable (fun t : Real => ∫⁻ x,
      (ENNReal.ofReal ‖eval (high t) x‖) ^ (4 : Real)) := by
    simpa only [eval] using
      (measurable_smooth_high_profile_lintegrals f low high hlow hhigh 4)
  have hhighTailRaw := smooth_bump_schwartz_high_q_weighted_tail f low high hlow hhigh
    (q := 4) (p := p) (by norm_num) hp4
  have hhigh_tail :
      (∫⁻ t in Ioi (0 : Real),
        (∫⁻ x, (ENNReal.ofReal ‖eval (high t) x‖) ^ (4 : Real)) *
          (ENNReal.ofReal t) ^ (p - 4 - 1)) ≤
        ((ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)) *
          ∫⁻ x, (ENNReal.ofReal ‖eval f x‖) ^ p := by
    simpa only [eval] using hhighTailRaw
  have hSmoment := Auto.Spherical.MSSBase.sourceOutput_marcinkiewicz_weak_q_top_on_additive_split
    D eval S hSnonneg hSsub (4 : Real) (by norm_num)
    ((B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real)) hSweak hStop hp4 f
    (hSmeas f (by simp [D])).aemeasurable low high
    (fun _ => by simp [D]) (fun _ => by simp [D])
    (fun t => by ext x; exact hsplit t x)
    (fun t ht x => smooth_low_norm_le_half_height f (low t) ht (hlow t) x)
    hhighI_meas
    (((ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)) *
      ∫⁻ x, (ENNReal.ofReal ‖eval f x‖) ^ p)
    hhigh_tail
  let H : ENNReal := (ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)
  let K : ENNReal := ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
    (B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) * H)
  have hSmoment' : (∫⁻ x, ENNReal.ofReal ((S f x) ^ p)) ≤
      K * (∫⁻ x, (ENNReal.ofReal ‖eval f x‖) ^ p) := by
    dsimp only [K, H]
    simpa only [mul_assoc] using hSmoment
  have hSbound := Auto.Spherical.MSSBase.sourceOutput_eLpNorm_le_of_nonnegative_moment S f
    (lt_trans (by norm_num) hp4) (hSnonneg f)
    (K * ∫⁻ x, (ENNReal.ofReal ‖eval f x‖) ^ p) hSmoment'
  have hin : (∫⁻ x, (ENNReal.ofReal ‖eval f x‖) ^ p) =
      (eLpNorm (eval f) (ENNReal.ofReal p) volume) ^ p :=
    Auto.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow
      (lt_trans (by norm_num) hp4) (eval f)
  rw [hin] at hSbound
  have hSbound' : eLpNorm (S f) (ENNReal.ofReal p) volume ≤
      K ^ p⁻¹ * eLpNorm (eval f) (ENNReal.ofReal p) volume := by
    calc
      eLpNorm (S f) (ENNReal.ofReal p) volume ≤
          (K * (eLpNorm (eval f) (ENNReal.ofReal p) volume) ^ p) ^ p⁻¹ := hSbound
      _ = K ^ p⁻¹ * eLpNorm (eval f) (ENNReal.ofReal p) volume := by
        rw [ENNReal.mul_rpow_of_nonneg _ _
          (inv_nonneg.mpr (lt_trans (by norm_num) hp4).le), ← ENNReal.rpow_mul]
        have hpp : p * p⁻¹ = (1 : Real) := by field_simp
        rw [hpp, ENNReal.rpow_one]
  have hTeq : T f = Btop • S f := by
    funext x
    change T f x = Btop * (T f x / Btop)
    field_simp [hBtop.ne']
  calc
    eLpNorm (T f) (ENNReal.ofReal p) volume =
        ENNReal.ofReal Btop * eLpNorm (S f) (ENNReal.ofReal p) volume := by
      rw [hTeq, eLpNorm_const_smul, Real.enorm_eq_ofReal hBtop.le]
    _ ≤ ENNReal.ofReal Btop *
        (K ^ p⁻¹ * eLpNorm (eval f) (ENNReal.ofReal p) volume) :=
      mul_le_mul_right hSbound' _
    _ = ENNReal.ofReal Btop *
        (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
          (B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) *
          ((ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)))) ^ p⁻¹ *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
      dsimp only [K, H, eval]
      ac_rfl

/-- Factor the p>4 coefficient so that all dyadic dependence is the positive
power `b^(4 / p)`. -/
private theorem aux_relativeInterpolation_four_top_decay_coefficient_factor
    {p b Btop : Real} (hp : 0 < p) (H : ENNReal) :
    (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
      (ENNReal.ofReal b * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) * H)) ^ p⁻¹ =
      (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
        ((ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) * H)) ^ p⁻¹ *
        (ENNReal.ofReal b) ^ (4 / p) := by
  have hinside :
      ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
        (ENNReal.ofReal b * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) * H) =
        (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
          ((ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) * H)) *
          (ENNReal.ofReal b) ^ (4 : Real) := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : Real) ≤ 4)]
    ac_rfl
  rw [hinside, ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hp.le),
    ← ENNReal.rpow_mul]
  congr 1

private theorem aux_relativeInterpolation_four_top_static_finite
    {p Btop : Real} (hp4 : 4 < p) (hBtop : 0 < Btop) :
    ENNReal.ofReal Btop *
      (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
        ((ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) *
        ((ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)))) ^ p⁻¹ ≠ ∞ := by
  refine ENNReal.mul_ne_top ENNReal.ofReal_ne_top ?_
  apply ENNReal.rpow_ne_top_of_nonneg
  · exact inv_nonneg.mpr (lt_trans (by norm_num) hp4).le
  apply ENNReal.mul_ne_top
  · exact ENNReal.ofReal_ne_top
  apply ENNReal.mul_ne_top
  · apply ENNReal.mul_ne_top
    · exact ENNReal.rpow_ne_top_of_nonneg (by norm_num) ENNReal.ofReal_ne_top
    · apply ENNReal.rpow_ne_top_of_nonneg
      · norm_num
      apply ENNReal.inv_ne_top.mpr
      exact ENNReal.ofReal_ne_zero_iff.mpr hBtop
  apply ENNReal.mul_ne_top
  · apply ENNReal.inv_ne_top.mpr
    exact ENNReal.ofReal_ne_zero_iff.mpr (sub_pos.mpr hp4)
  · apply ENNReal.rpow_ne_top_of_nonneg
    · exact sub_nonneg.mpr hp4.le
    · exact ENNReal.ofReal_ne_top

/-- The above-four half of the literal relative-band interpolation bridge. -/
private theorem aux_relativeInterpolation_hasRelativeCircularBandGeometricDecay_four_top
    (C : Auto.LittlewoodPaley.lpCutoffs 2)
    (h4 : HasRelativeCircularBandGeometricDecay 4 C.cutoff)
    {p : Real} (hp4 : 4 < p) :
    HasRelativeCircularBandGeometricDecay p C.cutoff := by
  rcases h4 with ⟨B4, rho4, hB4top, hrho4, h4⟩
  rcases aux_relativeInterpolation_exists_positive_real_geometric_majorant hB4top hrho4 with
    ⟨A, r, hA, hr, hrone, hmajor⟩
  rcases aux_relativeInterpolation_exists_restrictedRelativeBandpass_raw_top_bound C.cutoff with
    ⟨Btop, hBtop, hrawTop⟩
  let θ : Real := 4 / p
  have hp0 : 0 < p := lt_trans (by norm_num) hp4
  have hθ : 0 < θ := by
    dsimp only [θ]
    exact div_pos (by norm_num) hp0
  let H : ENNReal := (ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)
  let static : ENNReal := ENNReal.ofReal Btop *
    (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
      ((ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) * H)) ^ p⁻¹
  let bandConst : ENNReal := static * (ENNReal.ofReal A) ^ θ
  let rho : ENNReal := (ENNReal.ofReal r) ^ θ
  have hstaticTop : static ≠ ∞ := by
    dsimp only [static, H]
    exact aux_relativeInterpolation_four_top_static_finite hp4 hBtop
  have hAtop : (ENNReal.ofReal A) ^ θ ≠ ∞ :=
    ENNReal.rpow_ne_top_of_nonneg hθ.le ENNReal.ofReal_ne_top
  have hbandConstTop : bandConst ≠ ∞ := by
    dsimp only [bandConst]
    exact ENNReal.mul_ne_top hstaticTop hAtop
  have hrho : rho < 1 := by
    dsimp only [rho]
    exact ENNReal.rpow_lt_one (ENNReal.ofReal_lt_one.mpr hrone) hθ
  refine ⟨bandConst, rho, hbandConstTop, hrho, ?_⟩
  intro j f
  let b : Real := A * r ^ j
  have hb : 0 < b := by
    dsimp only [b]
    exact mul_pos hA (pow_pos hr _)
  let T : SchwartzMap (Euclidean 2) Complex → Euclidean 2 → Real :=
    fun g x =>
      (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j g x).toReal
  have hTnonneg : ∀ g x, 0 ≤ T g x := by
    intro g x
    exact ENNReal.toReal_nonneg
  have hTsub : ∀ g h x, T (g + h) x ≤ T g x + T h x := by
    intro g h x
    dsimp only [T]
    exact toReal_restrictedRelativeBandpassSphericalMaximal_add_le_of_ne_top
      (Ioi (0 : Real)) C.cutoff g h j x
      (fun k => aux_relativeInterpolation_restrictedRelativeBandpass_ne_top C j k x)
  have hTmeas : ∀ g, AEStronglyMeasurable (T g) volume := by
    intro g
    dsimp only [T]
    exact (measurable_restrictedRelativeBandpassSphericalMaximal_global
      (Ioi (0 : Real)) C.cutoff g C.cutoff_one C.cutoff_zero j).ennreal_toReal.aestronglyMeasurable
  have hstrong4 : ∀ g : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (T g) (ENNReal.ofReal 4) volume ≤
        ENNReal.ofReal b * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := by
    intro g
    calc
      eLpNorm (T g) (ENNReal.ofReal 4) volume =
          eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
            C.cutoff j g) (ENNReal.ofReal 4) volume := by
        exact (aux_relativeInterpolation_eLpNorm_ennreal_eq_eLpNorm_toReal_of_forall_ne_top
          (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j g)
          (ENNReal.ofReal 4) volume
          (fun x => aux_relativeInterpolation_restrictedRelativeBandpass_ne_top C j g x)).symm
      _ ≤ B4 * rho4 ^ j *
          eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := (h4 j g).2
      _ ≤ ENNReal.ofReal (A * r ^ j) *
          eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume :=
        mul_le_mul_of_nonneg_right (hmajor j) (by positivity)
      _ = ENNReal.ofReal b *
          eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := rfl
  have hTop : ∀ (g : SchwartzMap (Euclidean 2) Complex) (a : Real), 0 ≤ a →
      (∀ x, ‖g x‖ ≤ a) → ∀ x, T g x ≤ Btop * a := by
    intro g a ha hga x
    dsimp only [T]
    calc
      (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j g x).toReal ≤
          (ENNReal.ofReal (Btop * a)).toReal :=
        (ENNReal.toReal_le_toReal
          (aux_relativeInterpolation_restrictedRelativeBandpass_ne_top C j g x) ENNReal.ofReal_ne_top).mpr
          (hrawTop j (Ioi (0 : Real)) g a ha hga x)
      _ = Btop * a := ENNReal.toReal_ofReal (mul_nonneg hBtop.le ha)
  have hinterp := aux_relativeInterpolation_four_top_smooth_interpolation T hTnonneg hTsub hTmeas hp4
    (ENNReal.ofReal b) hstrong4 Btop hBtop hTop f
  have hcoef :
      ENNReal.ofReal Btop *
        (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
          (ENNReal.ofReal b * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) * H)) ^ p⁻¹ =
        static * (ENNReal.ofReal b) ^ θ := by
    dsimp only [static, θ]
    rw [aux_relativeInterpolation_four_top_decay_coefficient_factor hp0 H]
    ac_rfl
  have hinterp' : eLpNorm (T f) (ENNReal.ofReal p) volume ≤
      static * (ENNReal.ofReal b) ^ θ *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
    calc
      eLpNorm (T f) (ENNReal.ofReal p) volume ≤
          ENNReal.ofReal Btop *
            (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
              (ENNReal.ofReal b * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) * H)) ^ p⁻¹ *
            eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
        simpa only [H] using hinterp
      _ = static * (ENNReal.ofReal b) ^ θ *
            eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
        rw [hcoef]
  have hratepow : ENNReal.ofReal (r ^ ((j : Real) * θ)) = rho ^ j := by
    dsimp only [rho]
    calc
      ENNReal.ofReal (r ^ ((j : Real) * θ)) =
          (ENNReal.ofReal r) ^ ((j : Real) * θ) :=
        (ENNReal.ofReal_rpow_of_pos hr).symm
      _ = (ENNReal.ofReal r) ^ (θ * (j : Real)) := by
        congr 1
        ring
      _ = ((ENNReal.ofReal r) ^ θ) ^ ((j : Real)) :=
        ENNReal.rpow_mul _ θ (j : Real)
      _ = ((ENNReal.ofReal r) ^ θ) ^ j := by
        rw [ENNReal.rpow_natCast]
  have hbrate : (ENNReal.ofReal b) ^ θ =
      (ENNReal.ofReal A) ^ θ * rho ^ j := by
    dsimp only [b]
    rw [aux_relativeInterpolation_ofReal_product_pow_rpow hA hr hθ.le j,
      ENNReal.ofReal_rpow_of_pos hA, hratepow]
  have hnorm :
      eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
        C.cutoff j f) (ENNReal.ofReal p) volume ≤
        bandConst * rho ^ j *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
    calc
