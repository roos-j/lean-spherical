/-! ### Moving relative bandpass package

For the radius slab `1 ≤ t ≤ 2`, the literal relative band
`φ(2^{-(j+1)} t ξ) - φ(2^{-j} t ξ)` can be represented by one compact
unit-frequency Schwartz family evaluated at `2^{-j} ξ`.  The fixed fat
cutoff is exactly one on the moving band, so this is an identity rather than
an approximation.  The same package records an unconditional uniform kernel
bound for the family and its time derivative. -/

/-- The local radius parameter for the unit dyadic slab. -/
abbrev CircleRelativeBandLocalTime := Icc (1 : Real) 2

/-- The moving unit relative band before multiplying by the fixed fat
annulus. -/
noncomputable def circleRelativeBandUnitDifference
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (t : CircleRelativeBandLocalTime) : SchwartzMap (Euclidean 2) Complex :=
  let Ahalf : Euclidean 2 ≃L[Real] Euclidean 2 :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 (t.1 / 2) (ne_of_gt (by nlinarith [t.2.1])))
  let A : Euclidean 2 ≃L[Real] Euclidean 2 :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 t.1 (ne_of_gt (lt_of_lt_of_le (by norm_num) t.2.1)))
  (SchwartzMap.compCLMOfContinuousLinearEquiv Complex Ahalf) C.cutoff -
    (SchwartzMap.compCLMOfContinuousLinearEquiv Complex A) C.cutoff

theorem circleRelativeBandUnitDifference_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (t : CircleRelativeBandLocalTime) (eta : Euclidean 2) :
    circleRelativeBandUnitDifference C t eta =
      C.cutoff ((t.1 / 2) • eta) - C.cutoff (t.1 • eta) := by
  simp [circleRelativeBandUnitDifference]

/-- The compact unit-frequency multiplier which realizes the moving relative
bandpass on the local radius slab. -/
noncomputable def circleRelativeBandFatUnitFamily
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (t : CircleRelativeBandLocalTime) : SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex
    (circleRelativeBandUnitDifference C t : Euclidean 2 → Complex)
    (_root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff)

theorem circleRelativeBandFatUnitFamily_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (t : CircleRelativeBandLocalTime) (eta : Euclidean 2) :
    circleRelativeBandFatUnitFamily C t eta =
      (C.cutoff ((t.1 / 2) • eta) - C.cutoff (t.1 • eta)) *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff eta := by
  rw [circleRelativeBandFatUnitFamily,
    SchwartzMap.smulLeftCLM_apply (circleRelativeBandUnitDifference C t).hasTemperateGrowth]
  change circleRelativeBandUnitDifference C t eta •
      _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff eta = _
  rw [circleRelativeBandUnitDifference_apply]
  simp only [smul_eq_mul]

/-- At the reciprocal dyadic scale, the unit family is the moving relative
band multiplied by the fixed fat dyadic annulus. -/
theorem circleRelativeBandFatUnitFamily_at_dyadicScale
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : CircleRelativeBandLocalTime) (xi : Euclidean 2) :
    circleRelativeBandFatUnitFamily C t (((2 : Real) ^ j)⁻¹ • xi) =
      (C.cutoff (((2 : Real) ^ (j + 1))⁻¹ • (t.1 • xi)) -
        C.cutoff (((2 : Real) ^ j)⁻¹ • (t.1 • xi))) *
        _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j xi := by
  rw [circleRelativeBandFatUnitFamily_apply,
    _root_.Auto.MikhlinHormander.fatDyadicBandpassMultiplier_eq_prototype_scale]
  have hpow : (2 : Real) ^ j ≠ 0 := ne_of_gt (by positivity)
  have hhalf : (t.1 / 2) * ((2 : Real) ^ j)⁻¹ =
      ((2 : Real) ^ (j + 1))⁻¹ * t.1 := by
    rw [show (2 : Real) ^ (j + 1) = (2 : Real) ^ j * 2 by rw [pow_succ]]
    field_simp
  have hone : t.1 * ((2 : Real) ^ j)⁻¹ = ((2 : Real) ^ j)⁻¹ * t.1 := by ring
  simp only [smul_smul]
  rw [hhalf, hone]

/-- The fat cutoff is exactly one on the local moving relative band.
Consequently the preceding rescaled Schwartz multiplier is literally the
relative bandpass cutoff appearing in the global reassembly target. -/
theorem circleRelativeBandFatUnitFamily_at_dyadicScale_eq_movingBand
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : CircleRelativeBandLocalTime) (xi : Euclidean 2) :
    circleRelativeBandFatUnitFamily C t (((2 : Real) ^ j)⁻¹ • xi) =
      C.cutoff (((2 : Real) ^ (j + 1))⁻¹ • (t.1 • xi)) -
        C.cutoff (((2 : Real) ^ j)⁻¹ • (t.1 • xi)) := by
  rw [circleRelativeBandFatUnitFamily_at_dyadicScale]
  have h :=
    _root_.Auto.Spherical.Auxiliary.relative_dyadic_bandpass_mul_fat_cutoff
      (phi := C.cutoff) C.cutoff_one C.cutoff_zero (j := j) (k := (0 : Int))
      (r := t.1) (by
        convert t.2 using 1
        all_goals norm_num) xi (1 : Complex)
      (fun _ : Euclidean 2 => (1 : Complex))
  simpa only [_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier,
    _root_.Auto.LittlewoodPaley.shiftedFatMultiplier_apply,
    one_mul, mul_one] using h.symm

theorem circleRelativeBandFatUnitFamily_support_subset_annulus
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (t : CircleRelativeBandLocalTime) :
    Function.support (circleRelativeBandFatUnitFamily C t : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 (16 : Real) ∩ {eta : Euclidean 2 | (1 / 4 : Real) ≤ ‖eta‖} := by
  intro eta heta
  constructor
  · rw [Metric.mem_closedBall, dist_zero_right]
    by_contra hout
    have hlarge : (2 : Real) ^ (4 : Int) ≤ ‖eta‖ := by
      norm_num
      exact le_of_not_ge hout
    have hzero :=
      _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype_eq_zero_of_le_norm C hlarge
    rw [Function.mem_support] at heta
    apply heta
    rw [circleRelativeBandFatUnitFamily_apply, hzero, mul_zero]
  · by_contra hinner
    have hsmall : ‖eta‖ ≤ (2 : Real) ^ (-2 : Int) := by
      norm_num
      exact (lt_of_not_ge hinner).le
    have hzero :=
      _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype_eq_zero_of_norm_le C hsmall
    rw [Function.mem_support] at heta
    apply heta
    rw [circleRelativeBandFatUnitFamily_apply, hzero, mul_zero]

/-- The chosen compact Schwartz realization of the time derivative of the
moving unit band. -/
noncomputable def circleRelativeBandFatUnitTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (t : CircleRelativeBandLocalTime) : SchwartzMap (Euclidean 2) Complex :=
  Classical.choose
    (_root_.Auto.Spherical.SphericalMaximal.exists_compactlySupported_schwartzMap_deriv_relative_dyadic_bandpass_mul
      C.cutoff
      (_root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff)
      (_root_.Auto.MikhlinHormander.hasCompactSupport_fatDyadicBandpassPrototype C)
      0 t.1)

theorem circleRelativeBandFatUnitTimeDerivative_apply_core
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (t : CircleRelativeBandLocalTime) (eta : Euclidean 2) :
    circleRelativeBandFatUnitTimeDerivative C t eta =
      deriv (fun s : Real =>
        C.cutoff (((2 : Real) ^ (0 + 1))⁻¹ • (s • eta)) -
          C.cutoff (((2 : Real) ^ 0)⁻¹ • (s • eta))) t.1 *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff eta := by
  exact (Classical.choose_spec
    (_root_.Auto.Spherical.SphericalMaximal.exists_compactlySupported_schwartzMap_deriv_relative_dyadic_bandpass_mul
      C.cutoff
      (_root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff)
      (_root_.Auto.MikhlinHormander.hasCompactSupport_fatDyadicBandpassPrototype C)
      0 t.1)).1 eta

/-- Explicit formula for the time derivative, in terms of the cutoff
Fréchet derivative. -/
theorem circleRelativeBandFatUnitTimeDerivative_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (t : CircleRelativeBandLocalTime) (eta : Euclidean 2) :
    circleRelativeBandFatUnitTimeDerivative C t eta =
      (fderiv Real (C.cutoff : Euclidean 2 → Complex)
        (((2 : Real) ^ (0 + 1))⁻¹ • (t.1 • eta))
        (((2 : Real) ^ (0 + 1))⁻¹ • eta) -
      fderiv Real (C.cutoff : Euclidean 2 → Complex)
        (((2 : Real) ^ 0)⁻¹ • (t.1 • eta))
        (((2 : Real) ^ 0)⁻¹ • eta)) *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff eta := by
  rw [circleRelativeBandFatUnitTimeDerivative_apply_core]
  rw [(_root_.Auto.Spherical.Auxiliary.hasDerivAt_smooth_dyadic_bandpass_radial
    C.cutoff 0 t.1 eta).deriv]

theorem circleRelativeBandFatUnitTimeDerivative_support_subset_annulus
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (t : CircleRelativeBandLocalTime) :
    Function.support (circleRelativeBandFatUnitTimeDerivative C t : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 (16 : Real) ∩ {eta : Euclidean 2 | (1 / 4 : Real) ≤ ‖eta‖} := by
  intro eta heta
  constructor
  · rw [Metric.mem_closedBall, dist_zero_right]
    by_contra hout
    have hlarge : (2 : Real) ^ (4 : Int) ≤ ‖eta‖ := by
      norm_num
      exact le_of_not_ge hout
    have hzero :=
      _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype_eq_zero_of_le_norm C hlarge
    rw [Function.mem_support] at heta
    apply heta
    rw [circleRelativeBandFatUnitTimeDerivative_apply_core, hzero, mul_zero]
  · by_contra hinner
    have hsmall : ‖eta‖ ≤ (2 : Real) ^ (-2 : Int) := by
      norm_num
      exact (lt_of_not_ge hinner).le
    have hzero :=
      _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype_eq_zero_of_norm_le C hsmall
    rw [Function.mem_support] at heta
    apply heta
    rw [circleRelativeBandFatUnitTimeDerivative_apply_core, hzero, mul_zero]

private noncomputable def circleRelativeBandFatUnitJoint
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    Real × Euclidean 2 → Complex := fun z =>
  (C.cutoff ((z.1 / 2) • z.2) - C.cutoff (z.1 • z.2)) *
    _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff z.2

private theorem circleRelativeBandFatUnitJoint_contDiff
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) (n : Nat) :
    ContDiff Real n (circleRelativeBandFatUnitJoint C) := by
  unfold circleRelativeBandFatUnitJoint
  apply ContDiff.mul
  · apply ContDiff.sub
    · exact (C.cutoff.smooth n).comp (by fun_prop)
    · exact (C.cutoff.smooth n).comp (by fun_prop)
  · exact ((_root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff).smooth
      n |>.comp contDiff_snd)

private noncomputable def circleRelativeBandFatUnitTimeDerivativeJoint
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    Real × Euclidean 2 → Complex := fun z =>
  (fderiv Real (C.cutoff : Euclidean 2 → Complex)
      (((2 : Real) ^ (0 + 1))⁻¹ • (z.1 • z.2))
      (((2 : Real) ^ (0 + 1))⁻¹ • z.2) -
    fderiv Real (C.cutoff : Euclidean 2 → Complex)
      (((2 : Real) ^ 0)⁻¹ • (z.1 • z.2))
      (((2 : Real) ^ 0)⁻¹ • z.2)) *
    _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff z.2

private theorem circleRelativeBandFatUnitTimeDerivativeJoint_contDiff
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) (n : Nat) :
    ContDiff Real n (circleRelativeBandFatUnitTimeDerivativeJoint C) := by
  let phiFamily : (Real × Euclidean 2) → Euclidean 2 → Complex := fun _ => C.cutoff
  have hphiFamily : ContDiff Real (n + 1) (Function.uncurry phiFamily) := by
    change ContDiff Real (n + 1) (fun q : (Real × Euclidean 2) × Euclidean 2 =>
      C.cutoff q.2)
    exact (C.cutoff.smooth (n + 1)).comp contDiff_snd
  have harg1 : ContDiff Real n
      (fun z : Real × Euclidean 2 => ((2 : Real) ^ (0 + 1))⁻¹ • (z.1 • z.2)) := by
    fun_prop
  have harg0 : ContDiff Real n
      (fun z : Real × Euclidean 2 => ((2 : Real) ^ 0)⁻¹ • (z.1 • z.2)) := by
    fun_prop
  have hvec1 : ContDiff Real n
      (fun z : Real × Euclidean 2 => ((2 : Real) ^ (0 + 1))⁻¹ • z.2) := by
    fun_prop
  have hvec0 : ContDiff Real n
      (fun z : Real × Euclidean 2 => ((2 : Real) ^ 0)⁻¹ • z.2) := by
    fun_prop
  unfold circleRelativeBandFatUnitTimeDerivativeJoint
  exact ((hphiFamily.fderiv_apply harg1 hvec1 le_rfl).sub
    (hphiFamily.fderiv_apply harg0 hvec0 le_rfl)).mul
      ((_root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff).smooth
        n |>.comp contDiff_snd)

private theorem circleRelativeBandFatUnitFamily_apply_eq_joint
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (t : CircleRelativeBandLocalTime) (eta : Euclidean 2) :
    circleRelativeBandFatUnitFamily C t eta = circleRelativeBandFatUnitJoint C (t.1, eta) := by
  rw [circleRelativeBandFatUnitFamily_apply]
