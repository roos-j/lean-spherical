  rw [aux_const_mul_fourierInv]
  unfold relativeSchwartzMultiplierAt directMiddleRapidFamily directMiddleRapidFrequencyScale
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext xi
  change directMiddleRapidSymbol r C j t.1 ((dyadicFrequencyScale j).1 • xi) *
      𝓕 (f : Euclidean 2 → Complex) xi = _
  rw [directMiddleRapidSymbol_at_dyadicScale]
  ring

