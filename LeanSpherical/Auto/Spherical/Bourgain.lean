/-- A fixed homogeneous frequency packet can arise from at most five shifted
fat annuli.  This cardinality-free overlap is the finite combinatorial input
to the `L⁴` reassembly. -/
private theorem aux_sum_five_shifted_windows_le
    (a : Int) (K : Finset Int) (e : Int → Real)
    (he : ∀ n, 0 ≤ e n) :
    (∑ k ∈ K, ∑ i ∈ Finset.range 5, e (a - k + (i : Int))) ≤
      5 * ∑ n ∈ (K.product (Finset.range 5)).image
        (fun p : Int × Nat => a - p.1 + (p.2 : Int)), e n := by
  classical
  let S : Finset (Int × Nat) := K.product (Finset.range 5)
  let m : Int × Nat → Int := fun p => a - p.1 + (p.2 : Int)
  let T : Finset Int := S.image m
  have hmap : ∀ p ∈ S, m p ∈ T := by
    intro p hp
    exact Finset.mem_image.mpr ⟨p, hp, rfl⟩
  have hfiber_card (n : Int) : (S.filter fun p => m p = n).card ≤ 5 := by
    have hcard : (S.filter fun p => m p = n).card ≤ (Finset.range 5).card := by
      apply Finset.card_le_card_of_injOn Prod.snd
      · intro p hp
        have hp' := (Finset.mem_filter.mp hp).1
        exact (Finset.mem_product.mp hp').2
      · intro p hp q hq hpq
        have hp' : m p = n := (Finset.mem_filter.mp hp).2
        have hq' : m q = n := (Finset.mem_filter.mp hq).2
        dsimp only [m] at hp' hq'
        have hfirst : p.1 = q.1 := by omega
        exact Prod.ext hfirst hpq
    simpa using hcard
  have hfiber_bound (n : Int) (hn : n ∈ T) :
      (∑ p ∈ S with m p = n, e n) ≤ 5 * e n := by
    rw [Finset.sum_const, nsmul_eq_mul]
    exact mul_le_mul_of_nonneg_right (by exact_mod_cast hfiber_card n) (he n)
  have hfiber_sum :
      (∑ n ∈ T, ∑ p ∈ S with m p = n, e n) ≤
        ∑ n ∈ T, 5 * e n := by
    apply Finset.sum_le_sum
    intro n hn
    exact hfiber_bound n hn
  have hdouble :
      (∑ n ∈ T, ∑ p ∈ S with m p = n, e n) =
        ∑ p ∈ S, e (m p) := by
    exact Finset.sum_fiberwise_of_maps_to' hmap e
  calc
    (∑ k ∈ K, ∑ i ∈ Finset.range 5, e (a - k + (i : Int))) =
        ∑ p ∈ S, e (m p) := by
      change Finset.sum K (fun k => Finset.sum (Finset.range 5)
        (fun i => e (a - k + (i : Int)))) =
        Finset.sum (K.product (Finset.range 5))
          (fun p => e (a - p.1 + (p.2 : Int)))
      exact (Finset.sum_product K (Finset.range 5)
        (fun p : Int × Nat => e (a - p.1 + (p.2 : Int)))).symm
    _ = ∑ n ∈ T, ∑ p ∈ S with m p = n, e n := hdouble.symm
    _ ≤ ∑ n ∈ T, 5 * e n := hfiber_sum
    _ = 5 * ∑ n ∈ T, e n := by rw [Finset.mul_sum]
    _ = 5 * ∑ n ∈ (K.product (Finset.range 5)).image
        (fun p : Int × Nat => a - p.1 + (p.2 : Int)), e n := by rfl

/-- The shifted fat cutoff is exactly five adjacent homogeneous dyadic
annuli. -/
private theorem aux_shiftedFatMultiplier_eq_sum_five_integerDyadic
    {d : Nat} (C : lpCutoffs d) (j : Nat) (k : Int) (xi : Euclidean d) :
    shiftedFatMultiplier C.cutoff j k xi =
      ∑ i ∈ Finset.range 5,
        intDyadicBandpassMultiplier C.cutoff ((j : Int) - 2 - k + i) xi := by
  let m : Int := (j : Int) - 2 - k
  have h := finiteIntegerDyadicResolution C m 5 xi
  have htop : m + (↑(5 : Nat) : Int) = (j : Int) + 3 - k := by
    dsimp only [m]
    omega
  rw [htop] at h
  rw [shiftedFatMultiplier]
  change intDyadicLowpassMultiplier C.cutoff ((j : Int) + 3 - k) xi -
      intDyadicLowpassMultiplier C.cutoff ((j : Int) - 2 - k) xi = _
  simpa only [m] using h.symm

/-- Fourier inversion preserves the five-term homogeneous decomposition of a
shifted fat annulus. -/
private theorem aux_fourierInv_shiftedFatMultiplier_eq_sum_five_integerDyadicProjection
    {d : Nat} (C : lpCutoffs d) (j : Nat) (k : Int)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    𝓕⁻ (fun xi : Euclidean d =>
      shiftedFatMultiplier C.cutoff j k xi * 𝓕 (f : Euclidean d → Complex) xi) x =
      ∑ i ∈ Finset.range 5,
        integerDyadicProjection C.cutoff ((j : Int) - 2 - k + i) f x := by
  let F : SchwartzMap (Euclidean d) Complex := fourier f
  let g : Nat → SchwartzMap (Euclidean d) Complex := fun i =>
    SchwartzMap.smulLeftCLM Complex
      (intDyadicBandpassMultiplier C.cutoff ((j : Int) - 2 - k + i) :
        Euclidean d → Complex) F
  have hg (i : Nat) (xi : Euclidean d) :
      g i xi = intDyadicBandpassMultiplier C.cutoff ((j : Int) - 2 - k + i) xi *
        F xi := by
    dsimp [g]
    simp only [SchwartzMap.smulLeftCLM_apply
      (intDyadicBandpassMultiplier C.cutoff ((j : Int) - 2 - k + i)).hasTemperateGrowth,
      smul_eq_mul]
  have hginv (i : Nat) (y : Euclidean d) :
      (fourierInv (g i) : SchwartzMap (Euclidean d) Complex) y =
        fourierInv (fun xi : Euclidean d =>
          intDyadicBandpassMultiplier C.cutoff ((j : Int) - 2 - k + i) xi *
            fourier (f : Euclidean d → Complex) xi) y := by
    rw [SchwartzMap.fourierInv_coe]
    dsimp [g, F]
    apply congrArg (fun h : Euclidean d → Complex => fourierInv h y)
    funext xi
    rw [SchwartzMap.smulLeftCLM_apply
      (intDyadicBandpassMultiplier C.cutoff ((j : Int) - 2 - k + i)).hasTemperateGrowth]
    rfl
  have hdata :
      SchwartzMap.smulLeftCLM Complex
        (shiftedFatMultiplier C.cutoff j k : Euclidean d → Complex) F =
          ∑ i ∈ Finset.range 5, g i := by
    have hsum_apply (xi : Euclidean d) :
        (∑ i ∈ Finset.range 5, g i : SchwartzMap (Euclidean d) Complex) xi =
          ∑ i ∈ Finset.range 5, g i xi := by
      change (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean d) Complex)
          (Euclidean d) Complex)
          (∑ i ∈ Finset.range 5, g i) xi =
        ∑ i ∈ Finset.range 5,
          (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean d) Complex)
            (Euclidean d) Complex) (g i) xi
      simpa only [Finset.sum_apply] using
        congrFun (map_sum (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean d) Complex)
          (Euclidean d) Complex) g (Finset.range 5)) xi
    ext xi
    rw [SchwartzMap.smulLeftCLM_apply
      (shiftedFatMultiplier C.cutoff j k).hasTemperateGrowth]
    change shiftedFatMultiplier C.cutoff j k xi * F xi = _
    rw [aux_shiftedFatMultiplier_eq_sum_five_integerDyadic C j k xi]
    rw [Finset.sum_mul, hsum_apply]
    apply Finset.sum_congr rfl
    intro i hi
    exact (hg i xi).symm
  have hfun : (fun xi : Euclidean d =>
      shiftedFatMultiplier C.cutoff j k xi * F xi) =
      (SchwartzMap.smulLeftCLM Complex
        (shiftedFatMultiplier C.cutoff j k : Euclidean d → Complex) F :
          Euclidean d → Complex) := by
    funext xi
    rw [SchwartzMap.smulLeftCLM_apply
      (shiftedFatMultiplier C.cutoff j k).hasTemperateGrowth]
    change shiftedFatMultiplier C.cutoff j k xi * F xi =
      shiftedFatMultiplier C.cutoff j k xi * F xi
    rfl
  change fourierInv (fun xi : Euclidean d =>
    shiftedFatMultiplier C.cutoff j k xi * F xi) x = _
  rw [hfun]
  rw [← SchwartzMap.fourierInv_coe]
  rw [hdata, fourierInv_sum]
  have hinvsum_apply (y : Euclidean d) :
      (∑ i ∈ Finset.range 5,
        fourierInv (g i) : SchwartzMap (Euclidean d) Complex) y =
        ∑ i ∈ Finset.range 5,
          (fourierInv (g i) : SchwartzMap (Euclidean d) Complex) y := by
    change (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean d) Complex)
        (Euclidean d) Complex)
        (∑ i ∈ Finset.range 5, fourierInv (g i)) y =
      ∑ i ∈ Finset.range 5,
        (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean d) Complex)
          (Euclidean d) Complex) (fourierInv (g i)) y
    simpa only [Finset.sum_apply] using
      congrFun (map_sum (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean d) Complex)
        (Euclidean d) Complex) (fun i => fourierInv (g i)) (Finset.range 5)) y
  rw [hinvsum_apply]
  apply Finset.sum_congr rfl
  intro i hi
  simpa only [integerDyadicProjection] using hginv i x

private theorem aux_integrable_norm_pow_four_of_schwartz
