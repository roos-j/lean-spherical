noncomputable def directMiddleRapidFrequencyScale : DirectMiddleRapidLocalIndex → Ioi (0 : Real) :=
  fun u => dyadicFrequencyScale u.1

private theorem exists_directMiddleRapidFamily_uniformKernelBound
    (r : Nat) (C : Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ A : Real, 0 ≤ A ∧ ∀ u : DirectMiddleRapidLocalIndex,
      relativeSchwartzMultiplierKernelSize (directMiddleRapidFamily r C u) ≤ A := by
  obtain ⟨A, hA, hbound⟩ :=
    exists_relativeSchwartzMultiplierKernelSize_directMiddleRapidSymbol_le r C
  refine ⟨A, hA, ?_⟩
  intro u
  exact hbound u.1 u.2.1 u.2.2.1 u.2.2.2

private theorem exists_directMiddleRapidTimeDerivativeFamily_uniformKernelBound
    (r : Nat) (C : Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ A : Real, 0 ≤ A ∧ ∀ u : DirectMiddleRapidLocalIndex,
