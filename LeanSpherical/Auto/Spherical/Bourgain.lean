    let D : Euclidean 2 → Complex := fun x =>
      aux_circleAnnularEndpointWaveContribution C σ j t P x
    have hA : Integrable (fun x : Euclidean 2 => ‖A x‖ ^ 4) volume := by
      simpa only [A] using
        aux_integrable_norm_pow_four_aux_circleAnnularEndpointTimeDerivativeWaveContribution
          C σ j ts f
    have hD : Integrable (fun x : Euclidean 2 => ‖D x‖ ^ 4) volume := by
      simpa only [D] using
        aux_integrable_norm_pow_four_aux_circleAnnularEndpointWaveContribution C σ j ts P
    have hdD : Integrable (fun x : Euclidean 2 => ‖d * D x‖ ^ 4) volume := by
      have h := hD.const_mul (‖d‖ ^ 4)
      refine h.congr ?_
      filter_upwards with x
      rw [norm_mul, mul_pow]
    have hright : Integrable (fun x : Euclidean 2 =>
        8 * (‖A x‖ ^ 4 + ‖d * D x‖ ^ 4)) volume :=
