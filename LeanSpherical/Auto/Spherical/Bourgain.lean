          (_root_.Auto.Spherical.MSSBase.dyadicTimeScale k) ^ (-1 / 2 + ρ) := by
      rw [← Real.rpow_add hδ]
      congr 1
      ring
    calc
      (_root_.Auto.Spherical.MSSBase.dyadicTimeScale k) ^ (-(1 / 2 : Real)) *
          ((128 * A + 72 * B) ^ ((4 : Real)⁻¹) *
            (_root_.Auto.Spherical.MSSBase.dyadicTimeScale k) ^ ρ * E ^ ((4 : Real)⁻¹)) =
          (128 * A + 72 * B) ^ ((4 : Real)⁻¹) *
            ((_root_.Auto.Spherical.MSSBase.dyadicTimeScale k) ^ (-(1 / 2 : Real)) *
              (_root_.Auto.Spherical.MSSBase.dyadicTimeScale k) ^ ρ) * E ^ ((4 : Real)⁻¹) := by ring
      _ = _ := by rw [hpow]
  have hrawnorm : eLpNorm Graw 4 volume ≤
      ENNReal.ofReal
        (K * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale k) ^ (-1 / 2 + ρ) *
          E ^ ((4 : Real)⁻¹)) := by
    rw [hGraw]
    change eLpNorm (‖N‖ • G) 4 volume ≤ _
    rw [eLpNorm_const_smul, Real.enorm_eq_ofReal (norm_nonneg N)]
    calc
      ENNReal.ofReal ‖N‖ * eLpNorm G 4 volume ≤
          ENNReal.ofReal ‖N‖ * ENNReal.ofReal
            ((128 * A + 72 * B) ^ ((4 : Real)⁻¹) *
              (_root_.Auto.Spherical.MSSBase.dyadicTimeScale k) ^ ρ * E ^ ((4 : Real)⁻¹)) :=
        by
          simpa only [mul_comm] using
            (mul_le_mul_right hsample.2 (ENNReal.ofReal ‖N‖))
      _ = ENNReal.ofReal
          (K * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale k) ^ (-1 / 2 + ρ) *
            E ^ ((4 : Real)⁻¹)) := by
          rw [← ENNReal.ofReal_mul (norm_nonneg N), hscale]
  constructor
  · simpa only [Graw] using hrawmem
  · simpa only [Graw, K, E] using hrawnorm

end

