  let N : Complex := circleEndpointDyadicNormalization k
  let F : Real → Euclidean 2 → Complex := fun t x =>
    n * circleRelativeBandFatHalfWaveOutput C j k σ t f x
  let D : Real → Euclidean 2 → Complex := fun t x =>
    n * circleRelativeBandFatHalfWaveOutputTimeDerivative C j k σ t f x
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 4
  have hjoint := aux_continuous_and_hasDerivAt_circleRelativeBandFatHalfWaveOutput
    C j k σ f
  have hFcont : Continuous (Function.uncurry F) := by
    dsimp [F]
    exact continuous_const.mul hjoint.1
  have hDcont : Continuous (Function.uncurry D) := by
    dsimp [D]
    exact continuous_const.mul hjoint.2.1
  have hderiv : ∀ t x, HasDerivAt (fun s => F s x) (D t x) t := by
    intro t x
    dsimp [F, D]
    exact (hjoint.2.2 t x).const_mul n
  have hFraw : Integrable (fun p : Real × Euclidean 2 =>
      ‖circleRelativeBandFatHalfWaveOutput C j k σ p.1 f p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) :=
    aux_integrable_norm_pow_four_circleRelativeBandFatHalfWaveOutput_prod_of_gain
      C hgain j k hk σ f
  have hDraw : Integrable (fun p : Real × Euclidean 2 =>
      ‖circleRelativeBandFatHalfWaveOutputTimeDerivative C j k σ p.1 f p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) :=
    aux_integrable_norm_pow_four_circleRelativeBandFatHalfWaveOutputTimeDerivative_prod_of_gain
      C hgain j k hk σ f
  have hFspace : Integrable (fun p : Real × Euclidean 2 => ‖F p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    have h := hFraw.const_mul (‖n‖ ^ (4 : Nat))
    refine h.congr ?_
    filter_upwards with p
    dsimp [F]
    rw [norm_mul, mul_pow]
  have hDspace : Integrable (fun p : Real × Euclidean 2 => ‖D p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    have h := hDraw.const_mul (‖n‖ ^ (4 : Nat))
    refine h.congr ?_
    filter_upwards with p
    dsimp [D]
    rw [norm_mul, mul_pow]
  have hFnrg :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 4) ≤
        A * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale k) ^ (1 + 4 * ρ) * E := by
    simpa only [F, n, E] using hFenergy j k hk σ f
  have hDnrg :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 4) ≤
        B * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale k) ^ (-3 + 4 * ρ) * E := by
    simpa only [D, n, E] using hDenergy j k hk σ f
  have hsample := memLp_four_and_eLpNorm_iSup_timeSamplingL4_of_dyadic_energy
    k T hT hFcont hDcont hderiv hFspace hDspace hA.le hB.le
      (integral_nonneg fun x => pow_nonneg (norm_nonneg _) _) hFnrg hDnrg
  let G : Euclidean 2 → Real := fun x =>
    ⨆ t : Icc (1 : Real) 2, ‖F t.1 x‖
  let Graw : Euclidean 2 → Real := fun x =>
    ⨆ t : Icc (1 : Real) 2,
      ‖circleRelativeBandFatHalfWaveOutput C j k σ t.1 f x‖
  have hN : N ≠ 0 := circleEndpointDyadicNormalization_ne_zero k
  have hmax (x : Euclidean 2) : Graw x = ‖N‖ * G x := by
    dsimp [Graw, G, F, n, N]
    calc
      (⨆ t : Icc (1 : Real) 2,
          ‖circleRelativeBandFatHalfWaveOutput C j k σ t.1 f x‖) =
          ⨆ t : Icc (1 : Real) 2,
            ‖circleEndpointDyadicNormalization k *
              ((circleEndpointDyadicNormalization k)⁻¹ *
                circleRelativeBandFatHalfWaveOutput C j k σ t.1 f x)‖ := by
              apply iSup_congr
              intro t
              congr 1
              symm
