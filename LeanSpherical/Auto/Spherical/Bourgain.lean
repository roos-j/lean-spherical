                    ((circleEndpointDyadicNormalization k)⁻¹ *
                      circleRelativeBandFatHalfWaveOutput C j k σ t.1 f x) =
                    (circleEndpointDyadicNormalization k *
                      (circleEndpointDyadicNormalization k)⁻¹) *
                      circleRelativeBandFatHalfWaveOutput C j k σ t.1 f x := by ring
                _ = _ := by rw [mul_inv_cancel₀ hN, one_mul]
      _ = ⨆ t : Icc (1 : Real) 2,
          ‖circleEndpointDyadicNormalization k‖ *
            ‖(circleEndpointDyadicNormalization k)⁻¹ *
              circleRelativeBandFatHalfWaveOutput C j k σ t.1 f x‖ := by
              simp_rw [norm_mul]
      _ = ‖circleEndpointDyadicNormalization k‖ *
          (⨆ t : Icc (1 : Real) 2,
            ‖(circleEndpointDyadicNormalization k)⁻¹ *
              circleRelativeBandFatHalfWaveOutput C j k σ t.1 f x‖) :=
        (Real.mul_iSup_of_nonneg (norm_nonneg _) _).symm
  have hGraw : Graw = fun x => ‖N‖ * G x := by
    funext x
    exact hmax x
  have hrawmem : MemLp Graw 4 volume := by
    rw [hGraw]
    exact hsample.1.const_mul ‖N‖
  have hδ : 0 < _root_.Auto.Spherical.MSSBase.dyadicTimeScale k := by
    dsimp [_root_.Auto.Spherical.MSSBase.dyadicTimeScale]
    exact zpow_pos (by norm_num) _
  have hscale :
      ‖N‖ *
          ((128 * A + 72 * B) ^ ((4 : Real)⁻¹) *
            (_root_.Auto.Spherical.MSSBase.dyadicTimeScale k) ^ ρ * E ^ ((4 : Real)⁻¹)) =
        K * (_root_.Auto.Spherical.MSSBase.dyadicTimeScale k) ^ (-1 / 2 + ρ) *
          E ^ ((4 : Real)⁻¹) := by
    dsimp [K, N]
    rw [aux_norm_circleEndpointDyadicNormalization_eq_dyadicTimeScale_neg_half]
    have hpow :
        (_root_.Auto.Spherical.MSSBase.dyadicTimeScale k) ^ (-(1 / 2 : Real)) *
