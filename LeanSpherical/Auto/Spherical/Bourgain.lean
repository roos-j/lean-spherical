private theorem directMiddleRapidTimeDerivativeSymbol_at_dyadicScale
    (r : Nat) (C : Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (xi : Euclidean 2) :
    directMiddleRapidTimeDerivativeSymbol r C j t ((dyadicFrequencyScale j).1 • xi) =
      ((((2 : Real) ^ j) ^ (r + 1) : Real) : Complex) *
        aux_circleMiddleBandpassMultiplierTimeDerivative C j t xi := by
  rw [directMiddleRapidTimeDerivativeSymbol_apply]
  unfold directMiddleRapidTimeDerivativeSymbolFun
    middleRapidNormalizedScaledRadialAmplitudeTimeDerivative
    middleScaledRadialAmplitudeTimeDerivative
  rw [fixedDyadicFatBandpass_apply]
  simp only [dyadicFrequencyScale]
  have hpow : 0 < (2 : Real) ^ j := by positivity
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hpow)]
  have harg :
      (2 * Real.pi * t * (2 : Real) ^ j) * (((2 : Real) ^ j)⁻¹ * ‖xi‖) =
        2 * Real.pi * (t * ‖xi‖) := by field_simp
  rw [harg, deriv_coordinateMiddleMeridianLocalizedIntegral_zero_eq_aux]
  have hscalar :
      ((2 * Real.pi * (2 : Real) ^ j * (((2 : Real) ^ j)⁻¹ * ‖xi‖) : Real) : Complex) =
        ((2 * Real.pi * ‖xi‖ : Real) : Complex) := by
    congr 1
    field_simp
  rw [hscalar]
  rw [← fatDyadicBandpassMultiplier_eq_prototype_scale]
  rw [← Auto.Spherical.MSSBase.dyadicBandpassMultiplier_eq_levelZero_scaled]
  unfold aux_circleMiddleBandpassMultiplierTimeDerivative
  rw [show Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j xi *
        Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi =
      Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
        Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j xi by ring]
  rw [Auto.LittlewoodPaley.dyadicBandpassMultiplier_mul_fatDyadicBandpassMultiplier]
  push_cast
  rw [pow_succ]
  ring

private theorem relativeMultiplier_directMiddleRapid_eq_scaled_middle
    (r : Nat) (C : Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Icc (1 : Real) 2) (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) :
    relativeSchwartzMultiplierAt
      (directMiddleRapidFamily r C ⟨j, t⟩)
      (directMiddleRapidFrequencyScale ⟨j, t⟩) f x =
      ((((2 : Real) ^ j) ^ (r + 1) : Real) : Complex) *
        circleMiddleWaveContribution C j t.1 f x := by
