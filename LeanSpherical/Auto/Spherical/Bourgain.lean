  rw [aux_const_mul_fourierInv]
  unfold relativeSchwartzMultiplierAt directMiddleRapidTimeDerivativeFamily
    directMiddleRapidFrequencyScale
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext xi
  change directMiddleRapidTimeDerivativeSymbol r C j t.1
      ((dyadicFrequencyScale j).1 • xi) * 𝓕 (f : Euclidean 2 → Complex) xi = _
  rw [directMiddleRapidTimeDerivativeSymbol_at_dyadicScale]
  ring

private theorem aux_directMiddleRapid_scale_identity (r j : Nat) :
    ‖((((2 : Real) ^ j) ^ (r + 1) : Real) : Complex)‖⁻¹ *
        (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j) ^ (-(1 / 4 : Real)) =
      (_root_.Auto.Spherical.MSSBase.dyadicTimeScale j) ^
        ((r : Real) + (3 : Real) / 4) := by
  let R : Real := (2 : Real) ^ j
  have hR : 0 ≤ R := by
    dsimp [R]
    positivity
  have hRpos : 0 < R := by
    dsimp [R]
    positivity
  have hδ : _root_.Auto.Spherical.MSSBase.dyadicTimeScale j = R⁻¹ := by
