    have hb := div_le_div_of_nonneg_right
      (upperMinkowskiExponent_le_uniformAssouadDimension hE hEpos) hd1.le
    change 1 + _root_.Spherical.upperMinkowskiExponent E / ((d : ℝ) - 1) < p
    linarith
  exact Auto.Spherical.SWW.eLpNorm_restrictedSphericalMaximal_le hd hEpos
    ((ENNReal.ofReal_lt_ofReal_iff hp0).mpr hcritical)

/-- Section 2, low input geometry: radii at least one cannot meet the input
ball of radius `1/4` from a center in the closed ball of radius `1/2`. -/
theorem lowInput_maximal_eq_zero {d : ℕ} {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (f : Euclidean d → ℂ)
    (hf : ∀ y, 1 / 4 < ‖y‖ → f y = 0) {x : Euclidean d}
    (hx : ‖x‖ ≤ 1 / 2) : restrictedNormalizedSphericalMaximal d E f x = 0 := by
  apply restrictedNormalizedSphericalMaximal_eq_zero_of_forall E f x
  intro r hr ω
  apply hf
  have hω : ‖(ω : Euclidean d)‖ = 1 := mem_sphere_zero_iff_norm.mp ω.property
  have hnorm : ‖r • (ω : Euclidean d)‖ = r := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hr.2, hω, mul_one]
  have htri := norm_sub_le (x + r • (ω : Euclidean d)) x
  rw [add_sub_cancel_left, hnorm] at htri
  linarith [(hE hr.1).1]

/-- Section 2, equation `eq:lowconst`, weighted reduction for the low input.
This is an intermediate reduction from an unweighted moment bound, not an
assertion that the Assouad hypothesis already supplies that bound. -/
theorem lowInput_weighted_moment_of_unweighted {d : ℕ} {E : Set ℝ} {p α : ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hp : 0 < p) (hα : α ≤ 0)
    (f : SchwartzMap (Euclidean d) ℂ)
    (hf : ∀ y, 1 / 4 < ‖y‖ → f y = 0) (A : ℝ≥0∞)
    (hbound : (∫⁻ x, (restrictedNormalizedSphericalMaximal d E
      (f : Euclidean d → ℂ) x) ^ p) ≤ A * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p) :
    (∫⁻ x, (restrictedNormalizedSphericalMaximal d E
      (f : Euclidean d → ℂ) x) ^ p ∂powerWeightedVolume d α) ≤
      (ENNReal.ofReal (1 / 2 : ℝ)) ^ α * A *
        ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂powerWeightedVolume d α := by
  let G : Euclidean d → ℝ≥0∞ := fun x => (ENNReal.ofReal ‖f x‖) ^ p
  let M : Euclidean d → ℝ≥0∞ := fun x =>
    (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x) ^ p
  have hG : Measurable G :=
    ENNReal.continuous_rpow_const.measurable.comp f.continuous.norm.measurable.ennreal_ofReal
  have hM : Measurable M := ENNReal.continuous_rpow_const.measurable.comp
    (measurable_restrictedNormalizedSphericalMaximal E _ f.continuous)
  have hinput : (∫⁻ x, G x) ≤ ∫⁻ x, G x ∂powerWeightedVolume d α := by
    rw [powerWeightedVolume, lintegral_withDensity_eq_lintegral_mul _
      (measurable_radialPowerWeight d α) hG]
    apply lintegral_mono
    intro x
    by_cases hx : 1 / 4 < ‖x‖
    · simp [G, hf x hx, ENNReal.zero_rpow_of_pos hp]
    · have hw : 1 ≤ radialPowerWeight d α x := by
        simpa using radialPowerWeight_ge_of_mem_closedBall_nonpos hα
          (show (0 : ℝ) < 1 by norm_num)
          (show x ∈ Metric.closedBall (0 : Euclidean d) 1 by
            rw [Metric.mem_closedBall, dist_zero_right]
            linarith)
      simpa only [Pi.mul_apply, one_mul] using mul_le_mul' hw (le_refl (G x))
  have houtput : (∫⁻ x, M x ∂powerWeightedVolume d α) ≤
      (ENNReal.ofReal (1 / 2 : ℝ)) ^ α * ∫⁻ x, M x := by
    rw [powerWeightedVolume, lintegral_withDensity_eq_lintegral_mul _
      (measurable_radialPowerWeight d α) hM, ← lintegral_const_mul _ hM]
    apply lintegral_mono
    intro x
    by_cases hx : ‖x‖ ≤ 1 / 2
    · have hzero : M x = 0 := by
        dsimp [M]
        rw [lowInput_maximal_eq_zero hE _ hf hx, ENNReal.zero_rpow_of_pos hp]
      simp [Pi.mul_apply, hzero]
    · have hnorm : 0 < ‖x‖ := by linarith
      have hw : radialPowerWeight d α x ≤ (ENNReal.ofReal (1 / 2 : ℝ)) ^ α := by
        rw [radialPowerWeight, ENNReal.ofReal_rpow_of_pos hnorm,
          ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 1 / 2)]
        exact ENNReal.ofReal_le_ofReal
          (Real.rpow_le_rpow_of_nonpos (by norm_num) (by linarith) hα)
      exact mul_le_mul' hw (le_refl (M x))
  calc
    (∫⁻ x, M x ∂powerWeightedVolume d α) ≤
        (ENNReal.ofReal (1 / 2 : ℝ)) ^ α * ∫⁻ x, M x := houtput
    _ ≤ (ENNReal.ofReal (1 / 2 : ℝ)) ^ α * (A * ∫⁻ x, G x) :=
      mul_le_mul' le_rfl hbound
    _ ≤ (ENNReal.ofReal (1 / 2 : ℝ)) ^ α *
        (A * ∫⁻ x, G x ∂powerWeightedVolume d α) :=
      mul_le_mul' le_rfl (mul_le_mul' le_rfl hinput)
    _ = _ := by rw [mul_assoc]

/-- Section 2, `eq:lowconst`, on the Schwartz core: the low input obeys
a uniform weighted moment bound for every nonpositive power, assuming only
the paper's dimension threshold. -/
theorem lowInput_bound_of_uniformAssouadDimension {d : ℕ} (hd : 2 ≤ d)
    {E : Set ℝ} (hE : E.Nonempty) (hEI : E ⊆ Icc (1 : ℝ) 2) {p α : ℝ}
    (hp : 1 + uniformAssouadDimension E / ((d : ℝ) - 1) < p) (hα : α ≤ 0) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ f : SchwartzMap (Euclidean d) ℂ,
      (∀ y, 1 / 4 < ‖y‖ → f y = 0) →
      (∫⁻ x, (restrictedNormalizedSphericalMaximal d E
        (f : Euclidean d → ℂ) x) ^ p ∂powerWeightedVolume d α) ≤
        A * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂powerWeightedVolume d α := by
  have hEpos : E ⊆ Ioi (0 : ℝ) := fun _ hx => lt_of_lt_of_le zero_lt_one (hEI hx).1
  have hd1 : 0 ≤ (d : ℝ) - 1 := by
    have : (2 : ℝ) ≤ d := by exact_mod_cast hd
    linarith
  have hp0 : 0 < p := by
    have := div_nonneg (uniformAssouadDimension_nonneg E) hd1
    linarith
  obtain ⟨C, hC⟩ := unweighted_bound_of_uniformAssouadDimension hd hE hEpos hp
  refine ⟨(ENNReal.ofReal (1 / 2 : ℝ)) ^ α * (ENNReal.ofReal C) ^ p, ?_, ?_⟩
  · apply ENNReal.mul_ne_top
    · rw [ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 1 / 2)]
      exact ENNReal.ofReal_ne_top
    · exact ENNReal.rpow_ne_top_of_nonneg hp0.le ENNReal.ofReal_ne_top
  · intro f hf
    have hnorm := (hC (f : Euclidean d → ℂ) (f.memLp (ENNReal.ofReal p) volume)).2
    change eLpNorm (_root_.Spherical.restrictedSphericalMaximal E (f : Euclidean d → ℂ))
      (ENNReal.ofReal p) volume ≤ _ at hnorm
    rw [restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal] at hnorm
    apply lowInput_weighted_moment_of_unweighted hEI hp0 hα f hf ((ENNReal.ofReal C) ^ p)
    simpa only [enorm_eq_self, ofReal_norm] using
      lintegral_enorm_rpow_le_of_eLpNorm_le volume hp0 (ENNReal.ofReal C)
        (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ))
        (f : Euclidean d → ℂ) hnorm
        (measurable_restrictedNormalizedSphericalMaximal E _ f.continuous).aestronglyMeasurable
        f.continuous.aestronglyMeasurable

/-- Positivity of spherical averages in the local form needed for the high
input: comparison is required only on the sphere being sampled. -/
theorem norm_sphericalAverage_le_of_sample_bound {d : ℕ} {f : Euclidean d → ℂ}
    {g : Euclidean d → ℝ} (hg : Continuous g) (hg0 : ∀ y, 0 ≤ g y)
    {B t : ℝ} (_hB : 0 ≤ B) (x : Euclidean d)
    (hfg : ∀ ω : Metric.sphere (0 : Euclidean d) 1,
      ‖f (x + t • (ω : Euclidean d))‖ ≤ B * g (x + t • (ω : Euclidean d))) :
    ‖_root_.Spherical.sphericalAverage t f x‖ ≤
      B * ‖_root_.Spherical.sphericalAverage t (fun y => (g y : ℂ)) x‖ := by
  let : IsFiniteMeasure (_root_.Spherical.unitSphereMeasure d) := by
    unfold _root_.Spherical.unitSphereMeasure
    infer_instance
  have hgi : Integrable (fun ω : Metric.sphere (0 : Euclidean d) 1 =>
      g (x + t • (ω : Euclidean d))) (_root_.Spherical.unitSphereMeasure d) :=
    (hg.comp
      ((continuous_const : Continuous fun _ : Metric.sphere (0 : Euclidean d) 1 => x).add
        ((continuous_const : Continuous fun _ : Metric.sphere (0 : Euclidean d) 1 => t).smul
          continuous_subtype_val))).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  have hnorm : ‖_root_.Spherical.sphericalAverage t (fun y => (g y : ℂ)) x‖ =
      ∫ ω : Metric.sphere (0 : Euclidean d) 1,
        g (x + t • (ω : Euclidean d)) ∂_root_.Spherical.unitSphereMeasure d := by
    unfold _root_.Spherical.sphericalAverage
    change ‖∫ ω : Metric.sphere (0 : Euclidean d) 1,
      Complex.ofRealCLM (g (x + t • (ω : Euclidean d))) ∂_root_.Spherical.unitSphereMeasure d‖ = _
    rw [Complex.ofRealCLM.integral_comp_comm hgi]
    simp only [Complex.ofRealCLM_apply, Complex.norm_real, Real.norm_eq_abs]
    exact abs_of_nonneg (integral_nonneg fun ω => hg0 _)
  rw [hnorm, ← integral_const_mul]
  apply (norm_integral_le_integral_norm _).trans
  apply integral_mono_of_nonneg
  · exact Filter.Eventually.of_forall fun _ => norm_nonneg _
  · exact hgi.const_mul B
  · exact Filter.Eventually.of_forall hfg

/-- A continuous regularized weight for the high-input conjugation.
For negative `a`, this weight is at most one and at most `‖y‖^a` away from zero. -/
def highInputMagnitude {d : ℕ} (f : Euclidean d → ℂ) (a : ℝ) (y : Euclidean d) : ℝ :=
  ‖f y‖ * (1 + ‖y‖) ^ a

theorem continuous_highInputMagnitude {d : ℕ} {f : Euclidean d → ℂ}
    (hf : Continuous f) (a : ℝ) : Continuous (highInputMagnitude f a) := by
  have hw : Continuous (fun y : Euclidean d => (1 + ‖y‖) ^ a) :=
    (continuous_const.add continuous_norm).rpow_const (fun y =>
      Or.inl (show (1 : ℝ) + ‖y‖ ≠ 0 by positivity))
  exact hf.norm.mul hw

theorem highInputMagnitude_nonneg {d : ℕ} (f : Euclidean d → ℂ) (a : ℝ) (y : Euclidean d) :
    0 ≤ highInputMagnitude f a y := by
  unfold highInputMagnitude
  positivity

/-- Local radii yield the pointwise conjugation estimate outside radius two. -/
theorem highInput_maximal_conjugation {d : ℕ} {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {f : Euclidean d → ℂ} (hf : Continuous f) {a : ℝ} (ha : a ≤ 0)
    {x : Euclidean d} (hx : 2 ≤ ‖x‖) :
    _root_.Spherical.M E f x ≤ ENNReal.ofReal ((3 * ‖x‖) ^ (-a)) *
      _root_.Spherical.M E (fun y => (highInputMagnitude f a y : ℂ)) x := by
  unfold _root_.Spherical.M _root_.Spherical.restrictedSphericalMaximal
  apply iSup_le
  intro t
  apply iSup_le
  intro ht
  have hsample : ∀ ω : Metric.sphere (0 : Euclidean d) 1,
      ‖f (x + t • (ω : Euclidean d))‖ ≤
        (3 * ‖x‖) ^ (-a) * highInputMagnitude f a (x + t • (ω : Euclidean d)) := by
    intro ω
    let y := x + t • (ω : Euclidean d)
    have hω : ‖(ω : Euclidean d)‖ = 1 := mem_sphere_zero_iff_norm.mp ω.property
    have hy : 1 + ‖y‖ ≤ 3 * ‖x‖ := by
      have htri := norm_add_le x (t • (ω : Euclidean d))
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos ht.2, hω, mul_one] at htri
      dsimp [y]
      linarith [(hE ht.1).2]
    have hpow : (1 + ‖y‖) ^ (-a) ≤ (3 * ‖x‖) ^ (-a) :=
      Real.rpow_le_rpow (by positivity) hy (neg_nonneg.mpr ha)
    have hid : (1 + ‖y‖) ^ (-a) * highInputMagnitude f a y = ‖f y‖ := by
      unfold highInputMagnitude
      rw [← mul_left_comm, ← Real.rpow_add (by positivity), neg_add_cancel, Real.rpow_zero, mul_one]
    rw [← hid]
    exact mul_le_mul_of_nonneg_right hpow (highInputMagnitude_nonneg f a y)
  have h := ENNReal.ofReal_le_ofReal
    (norm_sphericalAverage_le_of_sample_bound (continuous_highInputMagnitude hf a)
      (highInputMagnitude_nonneg f a) (Real.rpow_nonneg (by positivity) _) x hsample)
  rw [ENNReal.ofReal_mul (Real.rpow_nonneg (by positivity) _)] at h
  refine h.trans (mul_le_mul' le_rfl ?_)
  exact le_iSup_of_le t (le_iSup_of_le ht le_rfl)

/-- High inputs vanish after spherical averaging at centers of norm at most two. -/
theorem highInput_maximal_eq_zero {d : ℕ} {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {f : Euclidean d → ℂ}
    (hf : ∀ y, ‖y‖ ≤ 4 → f y = 0) {x : Euclidean d} (hx : ‖x‖ ≤ 2) :
    _root_.Spherical.M E f x = 0 := by
  rw [_root_.Spherical.M, restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal]
  apply restrictedNormalizedSphericalMaximal_eq_zero_of_forall E f x
  intro r hr ω
  apply hf
  have hω : ‖(ω : Euclidean d)‖ = 1 := mem_sphere_zero_iff_norm.mp ω.property
  have htri := norm_add_le x (r • (ω : Euclidean d))
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos hr.2, hω, mul_one] at htri
  linarith [(hE hr.1).2]

/-- The conjugation exactly cancels the radial output weight, up to a
constant depending only on the exponent. -/
theorem highInput_weighted_pointwise {d : ℕ} {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {f : Euclidean d → ℂ} (hf : Continuous f) (hfs : ∀ y, ‖y‖ ≤ 4 → f y = 0)
    {p α : ℝ} (hp : 0 < p) (hα : α ≤ 0) (x : Euclidean d) :
    radialPowerWeight d α x * (_root_.Spherical.M E f x) ^ p ≤
      ENNReal.ofReal ((3 : ℝ) ^ (-α)) *
        (_root_.Spherical.M E (fun y => (highInputMagnitude f (α / p) y : ℂ)) x) ^ p := by
  by_cases hx : ‖x‖ ≤ 2
  · rw [highInput_maximal_eq_zero hE hfs hx, ENNReal.zero_rpow_of_pos hp, mul_zero]
    exact bot_le
  have hxpos : 0 < ‖x‖ := by linarith
  have hpoint := highInput_maximal_conjugation hE hf (div_nonpos_of_nonpos_of_nonneg hα hp.le)
    (le_of_lt (lt_of_not_ge hx))
  have hcoef : radialPowerWeight d α x *
      (ENNReal.ofReal ((3 * ‖x‖) ^ (-(α / p)))) ^ p = ENNReal.ofReal ((3 : ℝ) ^ (-α)) := by
    have hreal : ‖x‖ ^ α * ((3 * ‖x‖) ^ (-(α / p))) ^ p = (3 : ℝ) ^ (-α) := by
      rw [← Real.rpow_mul (by positivity), show -(α / p) * p = -α by field_simp,
        Real.mul_rpow (by norm_num : (0 : ℝ) ≤ 3) hxpos.le]
      rw [mul_left_comm, ← Real.rpow_add hxpos, add_neg_cancel, Real.rpow_zero, mul_one]
    rw [radialPowerWeight, ENNReal.ofReal_rpow_of_pos hxpos,
      ENNReal.ofReal_rpow_of_pos (Real.rpow_pos_of_pos (by positivity) _),
      ← ENNReal.ofReal_mul (Real.rpow_nonneg hxpos.le _), hreal]
  calc
    radialPowerWeight d α x * (_root_.Spherical.M E f x) ^ p ≤
        radialPowerWeight d α x *
          (ENNReal.ofReal ((3 * ‖x‖) ^ (-(α / p))) *
            _root_.Spherical.M E (fun y => (highInputMagnitude f (α / p) y : ℂ)) x) ^ p :=
      mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hpoint hp.le)
    _ = _ := by rw [ENNReal.mul_rpow_of_nonneg _ _ hp.le, ← mul_assoc, hcoef]

/-- The conjugated input moment is bounded by the original weighted moment. -/
theorem highInputMagnitude_moment_le {d : ℕ} {f : Euclidean d → ℂ}
    (hfs : ∀ y, ‖y‖ ≤ 4 → f y = 0) {p α : ℝ} (hp : 0 < p) (hα : α ≤ 0)
    (y : Euclidean d) :
    ENNReal.ofReal (highInputMagnitude f (α / p) y) ^ p ≤
      radialPowerWeight d α y * ENNReal.ofReal ‖f y‖ ^ p := by
  by_cases hy : ‖y‖ ≤ 4
  · simp [highInputMagnitude, hfs y hy, ENNReal.zero_rpow_of_pos hp]
  have hypos : 0 < ‖y‖ := by linarith
  have hreal : highInputMagnitude f (α / p) y ^ p ≤ ‖y‖ ^ α * ‖f y‖ ^ p := by
    unfold highInputMagnitude
    rw [Real.mul_rpow (norm_nonneg _) (Real.rpow_nonneg (by positivity) _),
      ← Real.rpow_mul (by positivity), div_mul_cancel₀ _ hp.ne']
    have hw : (1 + ‖y‖) ^ α ≤ ‖y‖ ^ α :=
      Real.rpow_le_rpow_of_nonpos hypos (by linarith) hα
    simpa only [mul_comm] using mul_le_mul_of_nonneg_right hw (Real.rpow_nonneg (norm_nonneg _) _)
  rw [ENNReal.ofReal_rpow_of_nonneg (highInputMagnitude_nonneg f _ y) hp.le,
    radialPowerWeight, ENNReal.ofReal_rpow_of_pos hypos,
    ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp.le,
    ← ENNReal.ofReal_mul (Real.rpow_nonneg hypos.le _)]
  exact ENNReal.ofReal_le_ofReal hreal

/-- An unweighted bound with its constant retained, for use uniformly over
normalized radius blocks. -/
def UnweightedMaximalBound (d : ℕ) (E : Set ℝ) (p C : ℝ) : Prop :=
  ∀ f : Euclidean d → ℂ, MemLp f (ENNReal.ofReal p) volume →
    MemLp (_root_.Spherical.M E f) (ENNReal.ofReal p) volume ∧
      eLpNorm (_root_.Spherical.M E f) (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal p) volume

/-- Source `eq:highconst`, retaining the dependence on the unweighted
constant explicitly. -/
theorem highInput_bound_of_unweighted {d : ℕ} {E : Set ℝ}
    (hEI : E ⊆ Icc (1 : ℝ) 2) {p α C : ℝ} (hp0 : 0 < p) (hα : α ≤ 0)
    (hC : UnweightedMaximalBound d E p C) :
    ∀ f : SchwartzMap (Euclidean d) ℂ,
      (∀ y, ‖y‖ ≤ 4 → f y = 0) →
      (∫⁻ x, (_root_.Spherical.M E (f : Euclidean d → ℂ) x) ^ p ∂powerWeightedVolume d α) ≤
        (ENNReal.ofReal ((3 : ℝ) ^ (-α)) * ENNReal.ofReal C ^ p) *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂powerWeightedVolume d α := by
  have ha : α / p ≤ 0 := div_nonpos_of_nonpos_of_nonneg hα hp0.le
  intro f hfs
  let g : Euclidean d → ℂ := fun y => (highInputMagnitude (f : Euclidean d → ℂ) (α / p) y : ℂ)
  have hg : Continuous g :=
    Complex.continuous_ofReal.comp (continuous_highInputMagnitude f.continuous (α / p))
  have hgnorm (y : Euclidean d) : ‖g y‖ = highInputMagnitude (f : Euclidean d → ℂ) (α / p) y := by
    exact Complex.norm_of_nonneg (highInputMagnitude_nonneg _ _ y)
  have hgmem : MemLp g (ENNReal.ofReal p) volume := by
    apply (f.memLp (ENNReal.ofReal p) volume).mono hg.aestronglyMeasurable
    exact Filter.Eventually.of_forall fun y => by
      rw [hgnorm]
      change ‖f y‖ * (1 + ‖y‖) ^ (α / p) ≤ ‖f y‖
      have hw := Real.rpow_le_one_of_one_le_of_nonpos
        (show 1 ≤ 1 + ‖y‖ by linarith [norm_nonneg y]) ha
      nlinarith [norm_nonneg (f y)]
  obtain ⟨hMg, hbound⟩ := hC g hgmem
  have hmoment : (∫⁻ x, (_root_.Spherical.M E g x) ^ p) ≤
      ENNReal.ofReal C ^ p * ∫⁻ x, ENNReal.ofReal ‖g x‖ ^ p := by
    simpa only [enorm_eq_self, ofReal_norm] using
      lintegral_enorm_rpow_le_of_eLpNorm_le volume hp0 (ENNReal.ofReal C)
        (_root_.Spherical.M E g) g hbound hMg.aestronglyMeasurable hg.aestronglyMeasurable
  have hinput : (∫⁻ x, ENNReal.ofReal ‖g x‖ ^ p) ≤
      ∫⁻ x, ENNReal.ofReal ‖f x‖ ^ p ∂powerWeightedVolume d α := by
    have hfpow : Measurable (fun x : Euclidean d => ENNReal.ofReal ‖f x‖ ^ p) :=
      ENNReal.continuous_rpow_const.measurable.comp f.continuous.norm.measurable.ennreal_ofReal
    rw [powerWeightedVolume, lintegral_withDensity_eq_lintegral_mul _
      (measurable_radialPowerWeight d α) hfpow]
    apply lintegral_mono
    intro x
    change ENNReal.ofReal ‖g x‖ ^ p ≤ radialPowerWeight d α x * ENNReal.ofReal ‖f x‖ ^ p
    rw [hgnorm]
    exact highInputMagnitude_moment_le hfs hp0 hα x
  have hMf : Measurable (_root_.Spherical.M E (f : Euclidean d → ℂ)) := by
    change Measurable (_root_.Spherical.restrictedSphericalMaximal E (f : Euclidean d → ℂ))
    rw [restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal]
    exact measurable_restrictedNormalizedSphericalMaximal E _ f.continuous
  have hMgm : Measurable (_root_.Spherical.M E g) := by
    change Measurable (_root_.Spherical.restrictedSphericalMaximal E g)
    rw [restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal]
    exact measurable_restrictedNormalizedSphericalMaximal E _ hg
  have hMfpow : Measurable (fun x => (_root_.Spherical.M E (f : Euclidean d → ℂ) x) ^ p) :=
    ENNReal.continuous_rpow_const.measurable.comp hMf
  conv_lhs =>
    rw [powerWeightedVolume, lintegral_withDensity_eq_lintegral_mul _
      (measurable_radialPowerWeight d α) hMfpow]
  calc
    (∫⁻ x, (radialPowerWeight d α *
        fun x => (_root_.Spherical.M E (f : Euclidean d → ℂ) x) ^ p) x) ≤
        ∫⁻ x, ENNReal.ofReal ((3 : ℝ) ^ (-α)) * (_root_.Spherical.M E g x) ^ p :=
      lintegral_mono (highInput_weighted_pointwise hEI f.continuous hfs hp0 hα)
    _ = ENNReal.ofReal ((3 : ℝ) ^ (-α)) * ∫⁻ x, (_root_.Spherical.M E g x) ^ p :=
      lintegral_const_mul _ (ENNReal.continuous_rpow_const.measurable.comp hMgm)
    _ ≤ ENNReal.ofReal ((3 : ℝ) ^ (-α)) *
        (ENNReal.ofReal C ^ p * ∫⁻ x, ENNReal.ofReal ‖g x‖ ^ p) := mul_le_mul' le_rfl hmoment
    _ ≤ ENNReal.ofReal ((3 : ℝ) ^ (-α)) *
        (ENNReal.ofReal C ^ p * ∫⁻ x, ENNReal.ofReal ‖f x‖ ^ p ∂powerWeightedVolume d α) :=
      mul_le_mul' le_rfl (mul_le_mul' le_rfl hinput)
    _ = _ := by rw [mul_assoc]

/-- Section 2, `eq:highconst`, on the Schwartz core. The fixed-radius
geometry and SWW bound control high inputs for every nonpositive weight. -/
theorem highInput_bound_of_uniformAssouadDimension {d : ℕ} (hd : 2 ≤ d)
    {E : Set ℝ} (hE : E.Nonempty) (hEI : E ⊆ Icc (1 : ℝ) 2) {p α : ℝ}
    (hp : 1 + uniformAssouadDimension E / ((d : ℝ) - 1) < p) (hα : α ≤ 0) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ f : SchwartzMap (Euclidean d) ℂ,
      (∀ y, ‖y‖ ≤ 4 → f y = 0) →
      (∫⁻ x, (_root_.Spherical.M E (f : Euclidean d → ℂ) x) ^ p ∂powerWeightedVolume d α) ≤
        A * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂powerWeightedVolume d α := by
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hp0 : 0 < p := by
    have := div_nonneg (uniformAssouadDimension_nonneg E)
      (show 0 ≤ (d : ℝ) - 1 by linarith)
    linarith
  obtain ⟨C, hC⟩ := unweighted_bound_of_uniformAssouadDimension hd hE
    (fun t ht => lt_of_lt_of_le zero_lt_one (hEI ht).1) hp
  refine ⟨ENNReal.ofReal ((3 : ℝ) ^ (-α)) * ENNReal.ofReal C ^ p,
    ENNReal.mul_ne_top ENNReal.ofReal_ne_top
      (ENNReal.rpow_ne_top_of_nonneg hp0.le ENNReal.ofReal_ne_top), ?_⟩
  exact highInput_bound_of_unweighted hEI hp0 hα hC

/-- Section 2, `eq:midconst`: annular inputs are controlled outside every
fixed positive radius. The source chooses `a=1/4`, `b=4`, `r=1/16`;
slightly enlarged annuli allow a smooth partition of Schwartz inputs. -/
theorem middleInput_exterior_bound_of_uniformAssouadDimension {d : ℕ} (hd : 2 ≤ d)
    {E : Set ℝ} (hE : E.Nonempty) (hEI : E ⊆ Icc (1 : ℝ) 2) {p α : ℝ}
    (hp : 1 + uniformAssouadDimension E / ((d : ℝ) - 1) < p) (hα : α ≤ 0)
    {a b r : ℝ} (ha : 0 < a) (hab : a ≤ b) (hr : 0 < r) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ f : SchwartzMap (Euclidean d) ℂ,
      (∀ y, y ∉ euclideanAnnulus d a b → f y = 0) →
      (∫⁻ x in (Metric.closedBall (0 : Euclidean d) r)ᶜ,
        (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x) ^ p
          ∂powerWeightedVolume d α) ≤
        A * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂powerWeightedVolume d α := by
  have hEpos : E ⊆ Ioi (0 : ℝ) := fun _ hx => lt_of_lt_of_le zero_lt_one (hEI hx).1
  have hd1 : 0 ≤ (d : ℝ) - 1 := by
    have : (2 : ℝ) ≤ d := by exact_mod_cast hd
    linarith
  have hp0 : 0 < p := by
    have := div_nonneg (uniformAssouadDimension_nonneg E) hd1
    linarith
  obtain ⟨C, hC⟩ := unweighted_bound_of_uniformAssouadDimension hd hE hEpos hp
  refine ⟨(ENNReal.ofReal r) ^ α * ENNReal.ofReal C ^ p * (ENNReal.ofReal b ^ α)⁻¹,
    ?_, ?_⟩
  · apply ENNReal.mul_ne_top
    · apply ENNReal.mul_ne_top
      · rw [ENNReal.ofReal_rpow_of_pos hr]
        exact ENNReal.ofReal_ne_top
      · exact ENNReal.rpow_ne_top_of_nonneg hp0.le ENNReal.ofReal_ne_top
    · rw [ENNReal.inv_ne_top, ENNReal.ofReal_rpow_of_pos (ha.trans_le hab)]
      exact ENNReal.ofReal_ne_zero_iff.mpr (Real.rpow_pos_of_pos (ha.trans_le hab) _)
  · intro f hf
    have hnorm := (hC (f : Euclidean d → ℂ) (f.memLp (ENNReal.ofReal p) volume)).2
    change eLpNorm (_root_.Spherical.restrictedSphericalMaximal E (f : Euclidean d → ℂ))
      (ENNReal.ofReal p) volume ≤ _ at hnorm
    rw [restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal] at hnorm
    exact restrictedNormalizedSphericalMaximal_exterior_moment_of_unweighted_annular_of_radius
      hp0 hα ha hab hr E f hf C hnorm

/-- A smooth low/middle/high split of a Schwartz input. Its slight overlap
preserves the source's geometry while keeping every input in the Schwartz core. -/
theorem exists_low_middle_high_split {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ) :
    ∃ L G H : SchwartzMap (Euclidean d) ℂ,
      f = L + G + H ∧
      (∀ y, 1 / 4 < ‖y‖ → L y = 0) ∧
      (∀ y, y ∉ euclideanAnnulus d (1 / 8) 8 → G y = 0) ∧
      (∀ y, ‖y‖ ≤ 4 → H y = 0) ∧
      (∀ y, ‖L y‖ ≤ 2 * ‖f y‖) ∧
      (∀ y, ‖G y‖ ≤ 2 * ‖f y‖) ∧
      (∀ y, ‖H y‖ ≤ 2 * ‖f y‖) := by
  obtain ⟨φ, hφ1, hφ0, hφn⟩ := exists_schwartz_spatial_ball_cutoff d (1 / 8) (by norm_num)
  obtain ⟨ψ, hψ1, hψ0, hψn⟩ := exists_schwartz_spatial_ball_cutoff d 4 (by norm_num)
  let L := SchwartzMap.smulLeftCLM ℂ (φ : Euclidean d → ℂ) f
  let K := SchwartzMap.smulLeftCLM ℂ (ψ : Euclidean d → ℂ) f
  have hL (y) : L y = φ y * f y := by
    simp only [L, SchwartzMap.smulLeftCLM_apply φ.hasTemperateGrowth, smul_eq_mul]
  have hK (y) : K y = ψ y * f y := by
    simp only [K, SchwartzMap.smulLeftCLM_apply ψ.hasTemperateGrowth, smul_eq_mul]
  have hLn (y) : ‖L y‖ ≤ ‖f y‖ := by
    rw [hL, norm_mul]
    simpa only [one_mul] using mul_le_mul_of_nonneg_right (hφn y) (norm_nonneg (f y))
  have hKn (y) : ‖K y‖ ≤ ‖f y‖ := by
    rw [hK, norm_mul]
    simpa only [one_mul] using mul_le_mul_of_nonneg_right (hψn y) (norm_nonneg (f y))
  refine ⟨L, K - L, f - K, by abel, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro y hy
    rw [hL, hφ0 y (by linarith), zero_mul]
  · intro y hy
    have hy' : ¬ (‖y‖ ≤ 8 ∧ 1 / 8 ≤ ‖y‖) := by
      simpa [euclideanAnnulus, Metric.mem_closedBall, Metric.mem_ball, dist_zero_right] using hy
    change K y - L y = 0
    rw [hK, hL]
    by_cases hlo : ‖y‖ < 1 / 8
    · rw [hφ1 y hlo.le, hψ1 y (by linarith), sub_self]
    · have hhi : 8 < ‖y‖ := lt_of_not_ge fun h => hy' ⟨h, le_of_not_gt hlo⟩
      rw [hφ0 y (by linarith), hψ0 y (by linarith), zero_mul, sub_self]
  · intro y hy
    change f y - K y = 0
    rw [hK, hψ1 y hy, one_mul, sub_self]
  · intro y
    linarith [hLn y, norm_nonneg (f y)]
  · intro y
    change ‖K y - L y‖ ≤ _
    exact (norm_sub_le _ _).trans (by linarith [hKn y, hLn y])
  · intro y
    change ‖f y - K y‖ ≤ _
    exact (norm_sub_le _ _).trans (by linarith [hKn y])

/-- Section 2, finiteness of the truncated norm, on the Schwartz core.
The constant may depend on the positive truncation radius. Its uniformity
as the radius tends to zero is the subsequent endpoint proof obligation. -/
theorem truncated_bound_of_uniformAssouadDimension {d : ℕ} (hd : 2 ≤ d)
    {E : Set ℝ} (hE : E.Nonempty) (hEI : E ⊆ Icc (1 : ℝ) 2) {p α : ℝ}
    (hp : 1 + uniformAssouadDimension E / ((d : ℝ) - 1) < p) (hα : α ≤ 0)
    {r : ℝ} (hr : 0 < r) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ f : SchwartzMap (Euclidean d) ℂ,
      (∫⁻ x in (Metric.closedBall (0 : Euclidean d) r)ᶜ,
        (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x) ^ p
          ∂powerWeightedVolume d α) ≤
        A * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂powerWeightedVolume d α := by
  have hd1 : 0 ≤ (d : ℝ) - 1 := by
    have : (2 : ℝ) ≤ d := by exact_mod_cast hd
    linarith
  have hp1 : 1 ≤ p := by
    have := div_nonneg (uniformAssouadDimension_nonneg E) hd1
    linarith
  have hp0 : 0 ≤ p := zero_le_one.trans hp1
  obtain ⟨AL, hAL, hL⟩ := lowInput_bound_of_uniformAssouadDimension hd hE hEI hp hα
  obtain ⟨AG, hAG, hG⟩ := middleInput_exterior_bound_of_uniformAssouadDimension hd hE hEI hp hα
    (by norm_num : (0 : ℝ) < 1 / 8) (by norm_num : (1 / 8 : ℝ) ≤ 8) hr
  obtain ⟨AH, hAH, hH⟩ := highInput_bound_of_uniformAssouadDimension hd hE hEI hp hα
  refine ⟨(2 ^ (p - 1) * 2 ^ (p - 1)) * (AL + AG + AH) * 2 ^ p, ?_, ?_⟩
  · apply ENNReal.mul_ne_top
    · exact ENNReal.mul_ne_top
        (ENNReal.mul_ne_top
          (ENNReal.rpow_ne_top_of_nonneg (by linarith) (by norm_num))
          (ENNReal.rpow_ne_top_of_nonneg (by linarith) (by norm_num)))
        (ENNReal.add_ne_top.mpr ⟨ENNReal.add_ne_top.mpr ⟨hAL, hAG⟩, hAH⟩)
    · exact ENNReal.rpow_ne_top_of_nonneg hp0 (by norm_num)
  · intro f
    obtain ⟨L, G, H, hsplit, hLs, hGs, hHs, hLn, hGn, hHn⟩ := exists_low_middle_high_split f
    let μ := powerWeightedVolume d α
    let N : SchwartzMap (Euclidean d) ℂ → ℝ≥0∞ := fun u =>
      ∫⁻ x, ENNReal.ofReal ‖u x‖ ^ p ∂μ
    let M : SchwartzMap (Euclidean d) ℂ → Euclidean d → ℝ≥0∞ :=
      fun u => restrictedNormalizedSphericalMaximal d E (u : Euclidean d → ℂ)
    let B : Set (Euclidean d) := (Metric.closedBall 0 r)ᶜ
    have hN (u : SchwartzMap (Euclidean d) ℂ) (hu : ∀ y, ‖u y‖ ≤ 2 * ‖f y‖) :
        N u ≤ 2 ^ p * N f := by
      have hfp : Measurable (fun x : Euclidean d => ENNReal.ofReal ‖f x‖ ^ p) :=
        ENNReal.continuous_rpow_const.measurable.comp f.continuous.norm.measurable.ennreal_ofReal
      change (∫⁻ x, ENNReal.ofReal ‖u x‖ ^ p ∂μ) ≤ _
      rw [show 2 ^ p * N f = ∫⁻ x, (2 : ℝ≥0∞) ^ p * ENNReal.ofReal ‖f x‖ ^ p ∂μ by
        rw [lintegral_const_mul _ hfp]]
      apply lintegral_mono
      intro x
      have h := ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal (hu x)) hp0
      simpa only [ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2), ENNReal.ofReal_ofNat,
        ENNReal.mul_rpow_of_nonneg _ _ hp0] using h
    have hLbound : (∫⁻ x in B, M L x ^ p ∂μ) ≤ AL * (2 ^ p * N f) :=
      ((setLIntegral_le_lintegral B _).trans (hL L hLs)).trans (mul_le_mul' le_rfl (hN L hLn))
    have hGbound : (∫⁻ x in B, M G x ^ p ∂μ) ≤ AG * (2 ^ p * N f) :=
      (hG G hGs).trans (mul_le_mul' le_rfl (hN G hGn))
    have hHfull : (∫⁻ x, M H x ^ p ∂μ) ≤ AH * N H := by
      simpa only [_root_.Spherical.M,
        restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal] using hH H hHs
    have hHbound : (∫⁻ x in B, M H x ^ p ∂μ) ≤ AH * (2 ^ p * N f) :=
      ((setLIntegral_le_lintegral B _).trans hHfull).trans (mul_le_mul' le_rfl (hN H hHn))
    have hpoint (x) (_hx : x ∈ B) : M f x ≤ M L x + M G x + M H x := by
      have h₁ := restrictedNormalizedSphericalMaximal_add_le E
        ((L + G : SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) (H : Euclidean d → ℂ)
        (L + G).continuous H.continuous x
      have h₂ := restrictedNormalizedSphericalMaximal_add_le E
        (L : Euclidean d → ℂ) (G : Euclidean d → ℂ) L.continuous G.continuous x
      calc
        M f x = M (L + G + H) x := by rw [hsplit]
        _ ≤ M (L + G) x + M H x := h₁
        _ ≤ _ := add_le_add h₂ le_rfl
    have hmeas (u : SchwartzMap (Euclidean d) ℂ) : Measurable (fun x => M u x ^ p) :=
      ENNReal.continuous_rpow_const.measurable.comp
        (measurable_restrictedNormalizedSphericalMaximal E _ u.continuous)
    have hsum := lintegral_rpow_restrict_le_of_le_add_add_of_moments μ B hp1
      (M f) (M L) (M G) (M H) measurableSet_closedBall.compl hpoint
      (hmeas L) (hmeas G) (hmeas H) _ _ _ hLbound hGbound hHbound
    convert hsum using 1
    dsimp only [M, N, μ, B]
    ring

/-! ## Compact Calderón factorization for Section 2

The polynomial `P(z) = 3z² - 2z³` satisfies `P(0) = 0`, `P(1) = 1`,
and `P'(1) = 0`. Factoring `P(a) - P(b)` produces two cancelling factors
from consecutive approximate identities, without losing compact support.
-/

open scoped FourierTransform Convolution

/-- Ordinary convolution on the Schwartz space, used in `eq:resolotionofid`. -/
def compactConvolution {d : ℕ} (f g : SchwartzMap (Euclidean d) ℂ) :
    SchwartzMap (Euclidean d) ℂ :=
  SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) f g

/-- The cubic lowpass polynomial applied in the convolution algebra. -/
def compactLowpass {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ) :
    SchwartzMap (Euclidean d) ℂ :=
  (3 : ℂ) • compactConvolution f f -
    (2 : ℂ) • compactConvolution (compactConvolution f f) f

/-- The second cancelling factor of a difference of cubic lowpasses. -/
def compactDualDifference {d : ℕ} (f g : SchwartzMap (Euclidean d) ℂ) :
    SchwartzMap (Euclidean d) ℂ :=
  (3 : ℂ) • (f + g) - (2 : ℂ) •
    (compactConvolution f f + compactConvolution f g + compactConvolution g g)

/-- Fourier transform converts the Schwartz convolution to multiplication. -/
theorem fourier_compactConvolution {d : ℕ} (f g : SchwartzMap (Euclidean d) ℂ)
    (ξ : Euclidean d) :
    𝓕 (compactConvolution f g) ξ = 𝓕 f ξ * 𝓕 g ξ := by
  simp [compactConvolution, SchwartzMap.fourier_convolution]

/-- Compact support is preserved by the Schwartz convolution. -/
theorem hasCompactSupport_compactConvolution {d : ℕ}
    {f g : SchwartzMap (Euclidean d) ℂ}
    (hf : HasCompactSupport (f : Euclidean d → ℂ))
    (hg : HasCompactSupport (g : Euclidean d → ℂ)) :
    HasCompactSupport (compactConvolution f g : Euclidean d → ℂ) := by
  have h : (compactConvolution f g : Euclidean d → ℂ) =
      (f : Euclidean d → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] (g : Euclidean d → ℂ) :=
    funext (SchwartzMap.convolution_apply _ f g)
  rw [h]
  exact hf.convolution _ hg

/-- The lowpass polynomial remains compactly supported. -/
theorem hasCompactSupport_compactLowpass {d : ℕ}
    {f : SchwartzMap (Euclidean d) ℂ}
    (hf : HasCompactSupport (f : Euclidean d → ℂ)) :
    HasCompactSupport (compactLowpass f : Euclidean d → ℂ) := by
  exact ((hasCompactSupport_compactConvolution hf hf).smul_left).sub
    ((hasCompactSupport_compactConvolution
      (hasCompactSupport_compactConvolution hf hf) hf).smul_left)

/-- Both factors of the cubic lowpass difference have compact support. -/
theorem hasCompactSupport_compactDualDifference {d : ℕ}
    {f g : SchwartzMap (Euclidean d) ℂ}
    (hf : HasCompactSupport (f : Euclidean d → ℂ))
    (hg : HasCompactSupport (g : Euclidean d → ℂ)) :
    HasCompactSupport (compactDualDifference f g : Euclidean d → ℂ) := by
  exact ((hf.add hg).smul_left).sub
    ((((hasCompactSupport_compactConvolution hf hf).add
      (hasCompactSupport_compactConvolution hf hg)).add
      (hasCompactSupport_compactConvolution hg hg)).smul_left)

/-- The integral of a Schwartz convolution is the product of the integrals. -/
theorem integral_compactConvolution {d : ℕ} (f g : SchwartzMap (Euclidean d) ℂ) :
    (∫ x, compactConvolution f g x) = (∫ x, f x) * (∫ x, g x) := by
  have h := fourier_compactConvolution f g 0
  simpa [SchwartzMap.fourier_coe, Real.fourier_eq'] using h

/-- The cubic lowpass has integral one when its input has integral one. -/
theorem integral_compactLowpass {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ)
    (hf : (∫ x, f x) = 1) : (∫ x, compactLowpass f x) = 1 := by
  change (∫ x, (3 : ℂ) * compactConvolution f f x -
    (2 : ℂ) * compactConvolution (compactConvolution f f) f x) = 1
  rw [integral_sub ((compactConvolution f f).integrable.const_mul _)
    ((compactConvolution (compactConvolution f f) f).integrable.const_mul _),
    integral_const_mul, integral_const_mul]
  norm_num [integral_compactConvolution, hf]

/-- The dual difference cancels the constant moment of unit-mass inputs. -/
theorem integral_compactDualDifference {d : ℕ} (f g : SchwartzMap (Euclidean d) ℂ)
    (hf : (∫ x, f x) = 1) (hg : (∫ x, g x) = 1) :
    (∫ x, compactDualDifference f g x) = 0 := by
  have hzero (u : SchwartzMap (Euclidean d) ℂ) :
      𝓕 u 0 = ∫ x, u x := by
    simp [SchwartzMap.fourier_coe, Real.fourier_eq']
  rw [← hzero]
  simp only [compactDualDifference, sub_eq_add_neg, FourierTransform.fourier_add,
    FourierTransform.fourier_neg, FourierTransform.fourier_smul,
    add_apply, neg_apply, smul_apply, smul_eq_mul,
    hzero, integral_compactConvolution, hf, hg]
  norm_num
/-- Algebraic factorization underlying the compact resolution in Section 2. -/
theorem compactLowpass_sub {d : ℕ} (f g : SchwartzMap (Euclidean d) ℂ) :
    compactLowpass f - compactLowpass g =
      compactConvolution (f - g) (compactDualDifference f g) := by
  have h : 𝓕 (compactLowpass f - compactLowpass g) =
      𝓕 (compactConvolution (f - g) (compactDualDifference f g)) := by
    ext ξ
    simp only [compactLowpass, compactDualDifference, sub_eq_add_neg, FourierTransform.fourier_neg,
      FourierTransform.fourier_add, FourierTransform.fourier_smul,
      neg_apply, add_apply, smul_apply,
      fourier_compactConvolution, smul_eq_mul]
    ring
  simpa using congrArg (fun f : SchwartzMap (Euclidean d) ℂ => 𝓕⁻ f) h

/-- Finite telescoping identity for the factored compact lowpasses.
Specializing `φ` to normalized dyadic dilates gives `eq:telescoping`. -/
theorem compactLowpass_telescoping {d : ℕ}
    (φ : ℕ → SchwartzMap (Euclidean d) ℂ) (J : ℕ) :
    compactLowpass (φ 0) + ∑ j ∈ Finset.range J,
      compactConvolution (φ (j + 1) - φ j) (compactDualDifference (φ (j + 1)) (φ j)) =
        compactLowpass (φ J) := by
  simp_rw [← compactLowpass_sub]
  induction J with
  | zero => simp
  | succ J ih =>
    rw [Finset.sum_range_succ, ← add_assoc, ih]
    abel

/-- Normalized dyadic dilation of a Schwartz kernel in dimension `d`. -/
def compactDyadicDilate {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ) (j : ℕ) :
    SchwartzMap (Euclidean d) ℂ :=
  (((2 : ℝ) ^ j) ^ d : ℝ) • SchwartzMap.compCLMOfContinuousLinearEquiv ℂ
    (ContinuousLinearEquiv.smulLeft (Units.mk0 ((2 : ℝ) ^ j) (by positivity))) f

/-- Physical-space formula for the normalized dyadic dilation. -/
theorem compactDyadicDilate_apply {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ)
    (j : ℕ) (x : Euclidean d) :
    compactDyadicDilate f j x = (((2 : ℝ) ^ j) ^ d : ℝ) • f ((2 : ℝ) ^ j • x) := rfl

/-- The dyadic dilation preserves the integral, including for complex kernels. -/
theorem integral_compactDyadicDilate {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ)
    (j : ℕ) : (∫ x, compactDyadicDilate f j x) = ∫ x, f x := by
  simp only [compactDyadicDilate_apply, integral_smul]
  rw [Measure.integral_comp_smul_of_nonneg volume (f : Euclidean d → ℂ)
    ((2 : ℝ) ^ j) (hR := by positivity)]
  simp

/-- Normalized dilation preserves compact support. -/
theorem hasCompactSupport_compactDyadicDilate {d : ℕ}
    {f : SchwartzMap (Euclidean d) ℂ}
    (hf : HasCompactSupport (f : Euclidean d → ℂ)) (j : ℕ) :
    HasCompactSupport (compactDyadicDilate f j : Euclidean d → ℂ) := by
  have h := hf.comp_homeomorph
    (ContinuousLinearEquiv.smulLeft
      (Units.mk0 ((2 : ℝ) ^ j) (by positivity)) :
        Euclidean d ≃L[ℝ] Euclidean d).toHomeomorph
  exact h.smul_left

/-- The kernel support shrinks at exactly the dyadic scale. -/
theorem compactDyadicDilate_eq_zero {d : ℕ} {f : SchwartzMap (Euclidean d) ℂ}
    {R : ℝ} (hf : ∀ x, R < ‖x‖ → f x = 0) (j : ℕ) {x : Euclidean d}
    (hx : R / (2 : ℝ) ^ j < ‖x‖) : compactDyadicDilate f j x = 0 := by
  rw [compactDyadicDilate_apply, hf, smul_zero]
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos (by positivity : (0 : ℝ) < 2 ^ j)]
  simpa [mul_comm] using (div_lt_iff₀ (by positivity : (0 : ℝ) < 2 ^ j)).mp hx

/-- Change variables in convolution with a normalized dyadic kernel. -/
theorem compactConvolution_dilate_left {d : ℕ}
    (f g : SchwartzMap (Euclidean d) ℂ) (j : ℕ) (x : Euclidean d) :
    compactConvolution (compactDyadicDilate f j) g x =
      ∫ y, f y * g (x - ((2 : ℝ) ^ j)⁻¹ • y) := by
  let a : ℝ := (2 : ℝ) ^ j
  have ha : a ≠ 0 := by dsimp [a]; positivity
  let H : Euclidean d → ℂ := fun y => f y * g (x - a⁻¹ • y)
  have heq : (fun y => compactDyadicDilate f j y * g (x - y)) =
      fun y => a ^ d • H (a • y) := by
    funext y
    simp [compactDyadicDilate_apply, H, a, mul_assoc]
  rw [compactConvolution, SchwartzMap.convolution_apply]
  change (∫ y, compactDyadicDilate f j y * g (x - y)) = _
  rw [heq, integral_smul, Measure.integral_comp_smul_of_nonneg volume H a
    (hR := by dsimp [a]; positivity)]
  simp [H, a]

/-- Normalized dyadic dilation is compatible with convolution. -/
theorem compactDyadicDilate_convolution {d : ℕ}
    (f g : SchwartzMap (Euclidean d) ℂ) (j : ℕ) :
    compactDyadicDilate (compactConvolution f g) j =
      compactConvolution (compactDyadicDilate f j) (compactDyadicDilate g j) := by
  ext x
  rw [compactConvolution_dilate_left, compactDyadicDilate_apply,
    compactConvolution, SchwartzMap.convolution_apply]
  change ((2 : ℝ) ^ j) ^ d • (∫ y, f y * g ((2 : ℝ) ^ j • x - y)) = _
  rw [← integral_smul]
  apply integral_congr_ae
  filter_upwards with y
  simp [compactDyadicDilate_apply, smul_sub, smul_smul, mul_left_comm]

/-- Dyadic dilation commutes with the cubic lowpass polynomial. -/
theorem compactDyadicDilate_lowpass {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ)
    (j : ℕ) : compactDyadicDilate (compactLowpass f) j =
      compactLowpass (compactDyadicDilate f j) := by
  have hlin : ∀ (a b : SchwartzMap (Euclidean d) ℂ),
      compactDyadicDilate ((3 : ℂ) • a - (2 : ℂ) • b) j =
        (3 : ℂ) • compactDyadicDilate a j - (2 : ℂ) • compactDyadicDilate b j := by
    intro a b
    ext x
    simp [compactDyadicDilate_apply, smul_sub, mul_left_comm]
  rw [compactLowpass, hlin, compactDyadicDilate_convolution,
    compactDyadicDilate_convolution, compactDyadicDilate_convolution]
  rfl

/-- The dyadically dilated kernel is an approximate identity on Schwartz inputs.
No positivity of the kernel is needed, so this applies to moment-cancelling lowpasses. -/
theorem tendsto_compactConvolution_dilate {d : ℕ}
    (f g : SchwartzMap (Euclidean d) ℂ) (hf : (∫ y, f y) = 1)
    (x : Euclidean d) :
    Tendsto (fun j : ℕ => compactConvolution (compactDyadicDilate f j) g x)
      atTop (𝓝 (g x)) := by
  let B : ℝ := SchwartzMap.seminorm ℝ 0 0 g
  have hB (z : Euclidean d) : ‖g z‖ ≤ B := SchwartzMap.norm_le_seminorm ℝ g z
  have hmeas (j : ℕ) : AEStronglyMeasurable
      (fun y => f y * g (x - ((2 : ℝ) ^ j)⁻¹ • y)) volume := by
    have hc : Continuous (fun y : Euclidean d => x - ((2 : ℝ) ^ j)⁻¹ • y) :=
      continuous_const.sub
        ((continuous_id : Continuous (fun y : Euclidean d => y)).const_smul (((2 : ℝ) ^ j)⁻¹))
    exact (f.continuous.mul (g.continuous.comp hc)).aestronglyMeasurable
  have hdom (j : ℕ) : ∀ᵐ y : Euclidean d,
      ‖f y * g (x - ((2 : ℝ) ^ j)⁻¹ • y)‖ ≤ ‖f y‖ * B := by
    filter_upwards with y
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (hB _) (norm_nonneg _)
  have hlim : ∀ᵐ y : Euclidean d,
      Tendsto (fun j : ℕ => f y * g (x - ((2 : ℝ) ^ j)⁻¹ • y)) atTop
        (𝓝 (f y * g x)) := by
    filter_upwards with y
    have hscale : Tendsto (fun j : ℕ => ((2 : ℝ) ^ j)⁻¹) atTop (𝓝 0) := by
      simpa only [inv_pow] using tendsto_pow_atTop_nhds_zero_of_lt_one
        (by norm_num : (0 : ℝ) ≤ 2⁻¹) (by norm_num : (2 : ℝ)⁻¹ < 1)
    have harg : Tendsto (fun j : ℕ => x - ((2 : ℝ) ^ j)⁻¹ • y) atTop (𝓝 x) := by
      simpa using (tendsto_const_nhds (x := x)).sub (hscale.smul_const y)
    exact tendsto_const_nhds.mul (g.continuous.continuousAt.tendsto.comp harg)
  have h := tendsto_integral_of_dominated_convergence (fun y => ‖f y‖ * B)
    hmeas (f.integrable.norm.mul_const B) hdom hlim
  simpa only [← compactConvolution_dilate_left, integral_mul_const, hf, one_mul] using h

/-- The finite factored resolution converges pointwise to every Schwartz input.
This is the reproducing-identity part of `eq:resolotionofid`; the required
high-order cancellation and support-radius construction are separate obligations. -/
theorem compact_resolution_tendsto {d : ℕ} (φ f : SchwartzMap (Euclidean d) ℂ)
    (hφ : (∫ y, φ y) = 1) (x : Euclidean d) :
    Tendsto (fun J : ℕ => compactConvolution
      (compactLowpass (compactDyadicDilate φ 0) + ∑ j ∈ Finset.range J,
        compactConvolution (compactDyadicDilate φ (j + 1) - compactDyadicDilate φ j)
          (compactDualDifference (compactDyadicDilate φ (j + 1)) (compactDyadicDilate φ j)))
      f x) atTop (𝓝 (f x)) := by
  simp_rw [compactLowpass_telescoping, ← compactDyadicDilate_lowpass]
  exact tendsto_compactConvolution_dilate (compactLowpass φ) f (integral_compactLowpass φ hφ) x

/-- Coordinate monomials used to specify every moment, not just radial moments. -/
def coordinateMonomial {d : ℕ} (m : Fin d → ℕ) (x : Euclidean d) : ℝ :=
  ∏ i, x i ^ m i

/-- Total-degree homogeneity of the coordinate monomials. -/
theorem coordinateMonomial_smul {d : ℕ} (m : Fin d → ℕ) (a : ℝ) (x : Euclidean d) :
    coordinateMonomial m (a • x) = a ^ (∑ i, m i) * coordinateMonomial m x := by
  simp [coordinateMonomial, mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum]

/-- The complex moment of a kernel for a coordinate multi-index. -/
def kernelMoment {d : ℕ} (m : Fin d → ℕ) (f : Euclidean d → ℂ) : ℂ :=
  ∫ x, (coordinateMonomial m x : ℂ) * f x

/-- Every moment of a compactly supported continuous kernel is integrable. -/
theorem integrable_kernelMoment {d : ℕ} (m : Fin d → ℕ) {f : Euclidean d → ℂ}
    (hf : Continuous f) (hs : HasCompactSupport f) :
    Integrable (fun x => (coordinateMonomial m x : ℂ) * f x) volume := by
  have hc : Continuous (coordinateMonomial m) := by
    unfold coordinateMonomial
    exact continuous_finsetProd _ fun i _ => (EuclideanSpace.proj i).continuous.pow _
  exact ((Complex.continuous_ofReal.comp hc).mul hf).integrable_of_hasCompactSupport
    hs.mul_left

/-- Dilation scales a moment by the inverse power of its total degree. -/
theorem kernelMoment_compactDyadicDilate {d : ℕ} (m : Fin d → ℕ)
    (f : SchwartzMap (Euclidean d) ℂ) (j : ℕ) :
    kernelMoment m (compactDyadicDilate f j) =
      ((((2 : ℝ) ^ j)⁻¹ ^ (∑ i, m i) : ℝ) : ℂ) * kernelMoment m f := by
  let a : ℝ := (2 : ℝ) ^ j
  let H : Euclidean d → ℂ := fun y => (coordinateMonomial m (a⁻¹ • y) : ℂ) * f y
  have heq : (fun x => (coordinateMonomial m x : ℂ) * compactDyadicDilate f j x) =
      fun x => a ^ d • H (a • x) := by
    funext x
    simp [compactDyadicDilate_apply, H, a, mul_left_comm]
  unfold kernelMoment
  rw [heq, integral_smul, Measure.integral_comp_smul_of_nonneg volume H a
    (hR := by dsimp [a]; positivity)]
  simp only [finrank_euclideanSpace_fin, smul_smul]
  rw [mul_inv_cancel₀ (by dsimp [a]; positivity), one_smul]
  simp only [H, coordinateMonomial_smul, Complex.ofReal_mul, mul_assoc]
  rw [integral_const_mul]

/-- Linearity of moments under multiplication by a constant. -/
theorem kernelMoment_smul {d : ℕ} (m : Fin d → ℕ) (f : Euclidean d → ℂ) (c : ℂ) :
    kernelMoment m (c • f) = c * kernelMoment m f := by
  simp only [kernelMoment, Pi.smul_apply, smul_eq_mul]
  simp_rw [mul_left_comm _ c]
  rw [integral_const_mul]

/-- Linearity of moments for compactly supported continuous kernels. -/
theorem kernelMoment_sub {d : ℕ} (m : Fin d → ℕ) {f g : Euclidean d → ℂ}
    (hf : Continuous f) (hg : Continuous g)
    (hsf : HasCompactSupport f) (hsg : HasCompactSupport g) :
    kernelMoment m (f - g) = kernelMoment m f - kernelMoment m g := by
  simp only [kernelMoment, Pi.sub_apply, mul_sub]
  exact integral_sub (integrable_kernelMoment m hf hsf) (integrable_kernelMoment m hg hsg)

/-- One correction removes all moments of degree `n` simultaneously. -/
def momentCorrection {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ) (n : ℕ) :
    SchwartzMap (Euclidean d) ℂ :=
  ((2 : ℂ) ^ n - 1)⁻¹ • ((2 : ℂ) ^ n • compactDyadicDilate f 1 - f)

/-- Moment correction preserves compact support. -/
theorem hasCompactSupport_momentCorrection {d : ℕ} {f : SchwartzMap (Euclidean d) ℂ}
    (hf : HasCompactSupport (f : Euclidean d → ℂ)) (n : ℕ) :
    HasCompactSupport (momentCorrection f n : Euclidean d → ℂ) :=
  (((hasCompactSupport_compactDyadicDilate hf 1).smul_left).sub hf).smul_left

/-- Exact multiplier by which a correction changes each coordinate moment. -/
theorem kernelMoment_momentCorrection {d : ℕ} (m : Fin d → ℕ)
    (f : SchwartzMap (Euclidean d) ℂ) (hs : HasCompactSupport (f : Euclidean d → ℂ))
    (n : ℕ) :
    kernelMoment m (momentCorrection f n) =
      ((2 : ℂ) ^ n - 1)⁻¹ * ((2 : ℂ) ^ n * (2 : ℂ)⁻¹ ^ (∑ i, m i) - 1) *
        kernelMoment m f := by
  change kernelMoment m (((2 : ℂ) ^ n - 1)⁻¹ •
    ((2 : ℂ) ^ n • (compactDyadicDilate f 1 : Euclidean d → ℂ) - f)) = _
  rw [kernelMoment_smul, kernelMoment_sub m
    ((compactDyadicDilate f 1).continuous.const_smul _) f.continuous
    (hasCompactSupport_compactDyadicDilate hs 1).smul_left hs,
    kernelMoment_smul, kernelMoment_compactDyadicDilate]
  push_cast
  simp only [pow_one]
  ring

/-- The correction kills the prescribed positive degree. -/
theorem kernelMoment_momentCorrection_eq_zero {d : ℕ} (m : Fin d → ℕ)
    (f : SchwartzMap (Euclidean d) ℂ) (hs : HasCompactSupport (f : Euclidean d → ℂ)) :
    kernelMoment m (momentCorrection f (∑ i, m i)) = 0 := by
  rw [kernelMoment_momentCorrection m f hs]
  simp

/-- Correct all positive moments up to the indicated order. -/
def correctedProfile {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ) :
    ℕ → SchwartzMap (Euclidean d) ℂ
  | 0 => f
  | n + 1 => momentCorrection (correctedProfile f n) (n + 1)

/-- Iterated moment correction keeps the kernel compactly supported. -/
theorem hasCompactSupport_correctedProfile {d : ℕ} {f : SchwartzMap (Euclidean d) ℂ}
    (hf : HasCompactSupport (f : Euclidean d → ℂ)) (n : ℕ) :
    HasCompactSupport (correctedProfile f n : Euclidean d → ℂ) := by
  induction n with
  | zero => exact hf
  | succ n ih => exact hasCompactSupport_momentCorrection ih (n + 1)

/-- Every positive coordinate moment through degree `n` vanishes. -/
theorem kernelMoment_correctedProfile_eq_zero {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ)
    (hs : HasCompactSupport (f : Euclidean d → ℂ)) (n : ℕ) (m : Fin d → ℕ)
    (hm0 : 0 < ∑ i, m i) (hmn : ∑ i, m i ≤ n) :
    kernelMoment m (correctedProfile f n) = 0 := by
  induction n with
  | zero => omega
  | succ n ih =>
    rw [correctedProfile]
    by_cases heq : ∑ i, m i = n + 1
    · rw [← heq]
      exact kernelMoment_momentCorrection_eq_zero m _ (hasCompactSupport_correctedProfile hs n)
    · rw [kernelMoment_momentCorrection m _ (hasCompactSupport_correctedProfile hs n),
        ih (by omega), mul_zero]

/-- The constant multi-index recovers the integral. -/
theorem kernelMoment_zero {d : ℕ} (f : Euclidean d → ℂ) :
    kernelMoment (fun _ : Fin d => 0) f = ∫ x, f x := by
  simp [kernelMoment, coordinateMonomial]

/-- A correction of positive degree preserves total mass. -/
theorem integral_momentCorrection {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ)
    (hs : HasCompactSupport (f : Euclidean d → ℂ)) {n : ℕ} (hn : 0 < n) :
    (∫ x, momentCorrection f n x) = ∫ x, f x := by
  have htwo : (2 : ℂ) ^ n - 1 ≠ 0 := by
    have hr : (1 : ℝ) < 2 ^ n := one_lt_pow₀ (by norm_num) hn.ne'
    have hc : (2 : ℂ) ^ n ≠ 1 := by exact_mod_cast hr.ne'
    exact sub_ne_zero.mpr hc
  rw [← kernelMoment_zero, kernelMoment_momentCorrection _ f hs]
  simp [kernelMoment_zero, htwo]

/-- Iterated correction preserves the original total mass. -/
theorem integral_correctedProfile {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ)
    (hs : HasCompactSupport (f : Euclidean d → ℂ)) (n : ℕ) :
    (∫ x, correctedProfile f n x) = ∫ x, f x := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [correctedProfile, integral_momentCorrection _
      (hasCompactSupport_correctedProfile hs n) (by omega), ih]

/-- Corrections use only smaller dilates, so they do not enlarge a centered support ball. -/
theorem correctedProfile_eq_zero {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ)
    {R : ℝ} (hR : 0 ≤ R) (hf : ∀ x, R < ‖x‖ → f x = 0) (n : ℕ) :
    ∀ x, R < ‖x‖ → correctedProfile f n x = 0 := by
  induction n with
  | zero => exact hf
  | succ n ih =>
    intro x hx
    have hsmall : R / (2 : ℝ) ^ 1 < ‖x‖ := by norm_num; linarith
    have hd := compactDyadicDilate_eq_zero ih 1 hsmall
    simp [correctedProfile, momentCorrection, hd, ih x hx]

/-- A radial smooth compact unit-mass kernel exists in every positive-radius ball. -/
theorem exists_radial_unitMass_kernel (d : ℕ) {R : ℝ} (hR : 0 < R) :
    ∃ f : SchwartzMap (Euclidean d) ℂ,
      HasCompactSupport (f : Euclidean d → ℂ) ∧ (∫ x, f x) = 1 ∧
      (∀ x, R ≤ ‖x‖ → f x = 0) ∧
      (∀ x y, ‖x‖ = ‖y‖ → f x = f y) := by
  let b := ContDiffBumpBase.ofInnerProductSpace (Euclidean d)
  let χ : Euclidean d → ℝ := fun x => b.toFun 2 ((2 / R : ℝ) • x)
  have hsmooth : ContDiff ℝ (⊤ : ℕ∞) χ := by
    apply contDiff_iff_contDiffAt.mpr
    intro x
    have hb : ContDiffAt ℝ (⊤ : ℕ∞) (Function.uncurry b.toFun)
        (2, (2 / R : ℝ) • x) :=
      b.smooth.contDiffAt (prod_mem_nhds (Ioi_mem_nhds (by norm_num)) univ_mem)
    have hi : ContDiffAt ℝ (⊤ : ℕ∞)
        (fun y : Euclidean d => ((2 : ℝ), (2 / R : ℝ) • y)) x :=
      contDiffAt_const.prodMk
        ((contDiffAt_id : ContDiffAt ℝ (⊤ : ℕ∞) (fun y : Euclidean d => y) x).const_smul
          (2 / R : ℝ))
    have hh := hb.comp x hi
    exact hh
  have hzero (x : Euclidean d) (hx : R ≤ ‖x‖) : χ x = 0 := by
    change b.toFun 2 ((2 / R : ℝ) • x) = 0
    apply Function.notMem_support.mp
    rw [b.support 2 (by norm_num)]
    simp only [Metric.mem_ball, dist_zero_right, norm_smul, Real.norm_eq_abs,
      abs_of_pos (div_pos (by norm_num : (0 : ℝ) < 2) hR), not_lt]
    rw [div_mul_eq_mul_div, le_div_iff₀ hR]
    nlinarith
  have hs : HasCompactSupport χ := by
    apply HasCompactSupport.intro (isCompact_closedBall (0 : Euclidean d) R)
    intro x hx
    exact hzero x (le_of_lt (by simpa using hx))
  have hnonneg (x : Euclidean d) : 0 ≤ χ x := (b.mem_Icc _ _).1
  have hone : χ 0 = 1 := by
    apply b.eq_one 2 (by norm_num)
    simp
  have hmass : 0 < ∫ x, χ x :=
    hsmooth.continuous.integral_pos_of_hasCompactSupport_nonneg_nonzero
      hs hnonneg (by rw [hone]; norm_num)
  let g : Euclidean d → ℂ := fun x => (χ x / (∫ y, χ y) : ℝ)
  have hgs : HasCompactSupport g :=
    hs.comp_left (g := fun t : ℝ => ((t / (∫ y, χ y) : ℝ) : ℂ)) (by simp)
  have hgc : ContDiff ℝ (⊤ : ℕ∞) g :=
    Complex.ofRealCLM.contDiff.comp (hsmooth.div_const _)
  refine ⟨hgs.toSchwartzMap hgc, hgs, ?_, ?_, ?_⟩
  · change (∫ x, (χ x / (∫ y, χ y) : ℝ) : ℂ) = 1
    rw [integral_complex_ofReal, integral_div, div_self hmass.ne']
    norm_num
  · intro x hx
    change (χ x / (∫ y, χ y) : ℝ) = (0 : ℂ)
    simp [hzero x hx]
  · intro x y hxy
    change (χ x / (∫ y, χ y) : ℝ) = ((χ y / (∫ y, χ y) : ℝ) : ℂ)
    have hχ : χ x = χ y := by
      simp only [χ, b, ContDiffBumpBase.ofInnerProductSpace, norm_smul, hxy]
    rw [hχ]

/-- Moment correction preserves radial symmetry. -/
theorem correctedProfile_radial {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ)
    (hf : ∀ x y, ‖x‖ = ‖y‖ → f x = f y) (n : ℕ) :
    ∀ x y, ‖x‖ = ‖y‖ → correctedProfile f n x = correctedProfile f n y := by
  induction n with
  | zero => exact hf
  | succ n ih =>
    intro x y hxy
    have hd : compactDyadicDilate (correctedProfile f n) 1 x =
        compactDyadicDilate (correctedProfile f n) 1 y := by
      simp only [compactDyadicDilate_apply]
      rw [ih ((2 : ℝ) ^ 1 • x) ((2 : ℝ) ^ 1 • y) (by simp only [norm_smul, hxy])]
    simp only [correctedProfile, momentCorrection, smul_apply, sub_apply, hd, ih x y hxy]

/-- Compact radial unit-mass profiles with arbitrarily many vanishing moments.
This supplies the profile used to construct the four kernels before
`eq:resolotionofid`. The radius and moment order are arbitrary. -/
theorem exists_radial_moment_profile (d N : ℕ) {R : ℝ} (hR : 0 < R) :
    ∃ f : SchwartzMap (Euclidean d) ℂ,
      HasCompactSupport (f : Euclidean d → ℂ) ∧ (∫ x, f x) = 1 ∧
      (∀ x, R < ‖x‖ → f x = 0) ∧
      (∀ x y, ‖x‖ = ‖y‖ → f x = f y) ∧
      ∀ m : Fin d → ℕ, 0 < ∑ i, m i → (∑ i, m i) ≤ N → kernelMoment m f = 0 := by
  obtain ⟨f, hs, hm, hz, hr⟩ := exists_radial_unitMass_kernel d hR
  refine ⟨correctedProfile f N, hasCompactSupport_correctedProfile hs N,
    ?_, correctedProfile_eq_zero f hR.le (fun x hx => hz x hx.le) N,
    correctedProfile_radial f hr N, kernelMoment_correctedProfile_eq_zero f hs N⟩
  rw [integral_correctedProfile f hs, hm]

/-- Scaling of a moment against any homogeneous test function.
Directional powers, which occur in the Fourier character's Taylor polynomial,
are covered without expanding them into coordinate monomials. -/
theorem integral_homogeneous_dilate {d : ℕ} (h : Euclidean d → ℂ) (k : ℕ)
    (hh : ∀ (a : ℝ) x, h (a • x) = (a : ℂ) ^ k * h x)
    (f : SchwartzMap (Euclidean d) ℂ) (j : ℕ) :
    (∫ x, h x * compactDyadicDilate f j x) =
      (2 : ℂ)⁻¹ ^ (j * k) * ∫ x, h x * f x := by
  let a : ℝ := (2 : ℝ) ^ j
  let H : Euclidean d → ℂ := fun y => h (a⁻¹ • y) * f y
  have heq : (fun x => h x * compactDyadicDilate f j x) =
      fun x => a ^ d • H (a • x) := by
    funext x
    simp [compactDyadicDilate_apply, H, a, mul_left_comm]
  rw [heq, integral_smul, Measure.integral_comp_smul_of_nonneg volume H a
    (hR := by dsimp [a]; positivity)]
  simp only [finrank_euclideanSpace_fin, smul_smul]
  rw [mul_inv_cancel₀ (by dsimp [a]; positivity), one_smul]
  simp only [H, hh, mul_assoc, integral_const_mul]
  simp [a, inv_pow, pow_mul]

/-- Exact effect of moment correction on a homogeneous test function. -/
theorem integral_homogeneous_correction {d : ℕ} (h : Euclidean d → ℂ)
    (hc : Continuous h) (k : ℕ)
    (hh : ∀ (a : ℝ) x, h (a • x) = (a : ℂ) ^ k * h x)
    (f : SchwartzMap (Euclidean d) ℂ) (hs : HasCompactSupport (f : Euclidean d → ℂ))
    (n : ℕ) :
    (∫ x, h x * momentCorrection f n x) =
      ((2 : ℂ) ^ n - 1)⁻¹ * ((2 : ℂ) ^ n * (2 : ℂ)⁻¹ ^ k - 1) *
        ∫ x, h x * f x := by
  have hi (g : SchwartzMap (Euclidean d) ℂ)
      (hgs : HasCompactSupport (g : Euclidean d → ℂ)) :
      Integrable (fun x => h x * g x) volume :=
    (hc.mul g.continuous).integrable_of_hasCompactSupport hgs.mul_left
  have heq : (fun x => h x * momentCorrection f n x) = fun x =>
      ((2 : ℂ) ^ n - 1)⁻¹ * ((2 : ℂ) ^ n * (h x * compactDyadicDilate f 1 x) -
        h x * f x) := by
    funext x
    simp only [momentCorrection, smul_apply, sub_apply, smul_eq_mul]
    ring
  rw [heq, integral_const_mul, integral_sub
    ((hi _ (hasCompactSupport_compactDyadicDilate hs 1)).const_mul _) (hi f hs),
    integral_const_mul, integral_homogeneous_dilate h k hh f 1]
  simp only [one_mul]
  ring

/-- The corrected profile annihilates every positive homogeneous polynomial
of degree up to the chosen order, including all directional Taylor terms. -/
theorem integral_homogeneous_correctedProfile_eq_zero {d : ℕ}
    (h : Euclidean d → ℂ) (hc : Continuous h) (k : ℕ)
    (hh : ∀ (a : ℝ) x, h (a • x) = (a : ℂ) ^ k * h x)
    (f : SchwartzMap (Euclidean d) ℂ) (hs : HasCompactSupport (f : Euclidean d → ℂ))
    (N : ℕ) (hk : 0 < k) (hkN : k ≤ N) :
    (∫ x, h x * correctedProfile f N x) = 0 := by
  induction N with
  | zero => omega
  | succ N ih =>
    rw [correctedProfile, integral_homogeneous_correction h hc k hh _
      (hasCompactSupport_correctedProfile hs N)]
    by_cases heq : k = N + 1
    · simp [← heq]
    · rw [ih (by omega), mul_zero]

/-- Vanishing directional moments for the Fourier Taylor expansion. -/
theorem directionalMoment_correctedProfile_eq_zero {d : ℕ}
    (f : SchwartzMap (Euclidean d) ℂ) (hs : HasCompactSupport (f : Euclidean d → ℂ))
    (N k : ℕ) (hk : 0 < k) (hkN : k ≤ N) (ξ : Euclidean d) :
    (∫ x, (inner ℝ x ξ : ℂ) ^ k * correctedProfile f N x) = 0 := by
  apply integral_homogeneous_correctedProfile_eq_zero _ _ k _ f hs N hk hkN
  · exact (Complex.continuous_ofReal.comp (continuous_id.inner continuous_const)).pow k
  · intro a x
    simp [inner_smul_left, mul_pow]

/-- Fourier cancellation from compact support and directional moments.
This is the quantitative Taylor remainder needed for the kernels in Section 2. -/
theorem norm_fourier_sub_mass_le_of_directional_moments {d N : ℕ}
    (f : SchwartzMap (Euclidean d) ℂ) (hs : HasCompactSupport (f : Euclidean d → ℂ))
    {R : ℝ} (_hR : 0 ≤ R) (hz : ∀ x, R < ‖x‖ → f x = 0)
    (hN : 0 < N) (hm : ∀ k, 0 < k → k < N → ∀ ξ : Euclidean d,
      (∫ x, (inner ℝ x ξ : ℂ) ^ k * f x) = 0)
    (ξ : Euclidean d) (hξ : 2 * Real.pi * R * ‖ξ‖ ≤ 1) :
    ‖𝓕 f ξ - ∫ x, f x‖ ≤
      (2 * Real.pi * R * ‖ξ‖) ^ N *
        ((N + 1 : ℕ) : ℝ) * ((N.factorial : ℝ) * N)⁻¹ * ∫ x, ‖f x‖ := by
  let c : ℂ := (-2 * Real.pi : ℝ) * Complex.I
  let z : Euclidean d → ℂ := fun x => c * (inner ℝ x ξ : ℂ)
  let T : Euclidean d → ℂ := fun x => ∑ k ∈ Finset.range N, z x ^ k / (k.factorial : ℂ)
  have zcont : Continuous z := by dsimp [z]; fun_prop
  have tcont : Continuous T := by dsimp [T]; fun_prop
  have hint (a : Euclidean d → ℂ) (ha : Continuous a) :
      Integrable (fun x => a x * f x) volume :=
    (ha.mul f.continuous).integrable_of_hasCompactSupport hs.mul_left
  have hterm (k : ℕ) : (∫ x, z x ^ k / (k.factorial : ℂ) * f x) =
      (c ^ k / (k.factorial : ℂ)) * ∫ x, (inner ℝ x ξ : ℂ) ^ k * f x := by
    simp only [z, mul_pow, mul_div_assoc, mul_assoc]
    simp_rw [show ∀ x, c ^ k * ((inner ℝ x ξ : ℂ) ^ k / (k.factorial : ℂ) * f x) =
      (c ^ k / (k.factorial : ℂ)) * ((inner ℝ x ξ : ℂ) ^ k * f x) from fun x => by ring]
    rw [integral_const_mul]
  have hmass : (∫ x, T x * f x) = ∫ x, f x := by
    simp only [T, Finset.sum_mul]
    have hi (k : ℕ) : Integrable (fun x => z x ^ k / (k.factorial : ℂ) * f x) volume :=
      hint _ ((zcont.pow k).div_const (k.factorial : ℂ))
    rw [integral_finsetSum (Finset.range N) (fun k _ => hi k)]
    rw [Finset.sum_eq_single 0]
    · simp [z]
    · intro k hk hk0
      rw [hterm, hm k (Nat.pos_of_ne_zero hk0) (Finset.mem_range.mp hk) ξ, mul_zero]
    · intro h
      exact False.elim (h (Finset.mem_range.mpr hN))
  have hfour : 𝓕 f ξ = ∫ x, Complex.exp (z x) * f x := by
    rw [SchwartzMap.fourier_coe, Real.fourier_eq']
    apply integral_congr_ae
    filter_upwards with x
    simp only [z, c, Complex.ofReal_mul, Complex.ofReal_neg, Complex.ofReal_ofNat,
      smul_eq_mul]
    congr 2
    ring
  have hrem : 𝓕 f ξ - ∫ x, f x = ∫ x, (Complex.exp (z x) - T x) * f x := by
    simp_rw [sub_mul]
    have hi : Integrable (fun x => Complex.exp (z x) * f x) volume :=
      hint _ (Complex.continuous_exp.comp zcont)
    rw [integral_sub hi (hint T tcont),
      ← hfour, hmass]
  let A : ℝ := (2 * Real.pi * R * ‖ξ‖) ^ N *
    ((N + 1 : ℕ) : ℝ) * ((N.factorial : ℝ) * N)⁻¹
  have hpoint (x : Euclidean d) : ‖(Complex.exp (z x) - T x) * f x‖ ≤ A * ‖f x‖ := by
    by_cases hx : ‖x‖ ≤ R
    · have hnz : ‖z x‖ ≤ 2 * Real.pi * R * ‖ξ‖ := by
        have hnc : ‖c‖ = 2 * Real.pi := by
          simp [c, abs_of_pos Real.pi_pos]
        rw [show z x = c * (inner ℝ x ξ : ℂ) from rfl, norm_mul, hnc,
          Complex.norm_real, Real.norm_eq_abs]
        calc
          2 * Real.pi * |inner ℝ x ξ| ≤ 2 * Real.pi * (‖x‖ * ‖ξ‖) :=
            mul_le_mul_of_nonneg_left (abs_real_inner_le_norm _ _) (by positivity)
          _ ≤ 2 * Real.pi * R * ‖ξ‖ := by rw [← mul_assoc]; gcongr
      have he := Complex.exp_bound (hnz.trans hξ) hN
      rw [norm_mul]
      apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
      apply he.trans
      dsimp [A]
      rw [mul_assoc]
      exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (norm_nonneg _) hnz N)
        (by positivity)
    · simp [hz x (lt_of_not_ge hx)]
  rw [hrem]
  calc
    ‖∫ x, (Complex.exp (z x) - T x) * f x‖ ≤
        ∫ x, ‖(Complex.exp (z x) - T x) * f x‖ := norm_integral_le_integral_norm _
    _ ≤ ∫ x, A * ‖f x‖ := integral_mono
      (hint _ ((Complex.continuous_exp.comp zcont).sub tcont)).norm
      (f.integrable.norm.const_mul A) hpoint
    _ = _ := by rw [integral_const_mul]

/-- Big-O form of the Fourier cancellation estimate in Section 2. -/
theorem fourier_sub_mass_isBigO_of_directional_moments {d N : ℕ}
    (f : SchwartzMap (Euclidean d) ℂ) (hs : HasCompactSupport (f : Euclidean d → ℂ))
    {R : ℝ} (hR : 0 ≤ R) (hz : ∀ x, R < ‖x‖ → f x = 0)
    (hN : 0 < N) (hm : ∀ k, 0 < k → k < N → ∀ ξ : Euclidean d,
      (∫ x, (inner ℝ x ξ : ℂ) ^ k * f x) = 0) :
    Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 f ξ - ∫ x, f x) (fun ξ => ‖ξ‖ ^ N) := by
  have he : ∀ᶠ ξ : Euclidean d in 𝓝 0, 2 * Real.pi * R * ‖ξ‖ ≤ 1 := by
    have hc : Continuous (fun ξ : Euclidean d => 2 * Real.pi * R * ‖ξ‖) :=
      continuous_const.mul continuous_norm
    exact (hc.continuousAt.eventually (eventually_le_nhds (by norm_num))).mono fun _ h => h
  refine Asymptotics.IsBigO.of_bound
    ((2 * Real.pi * R) ^ N * ((N + 1 : ℕ) : ℝ) *
      ((N.factorial : ℝ) * N)⁻¹ * ∫ x, ‖f x‖) ?_
  filter_upwards [he] with ξ hξ
  have h := norm_fourier_sub_mass_le_of_directional_moments f hs hR hz hN hm ξ hξ
  convert h using 1
  simp only [Real.norm_eq_abs, abs_pow, abs_norm, mul_pow]
  ring

/-- The corrected compact radial profiles have the Fourier jet prescribed
before `eq:resolotionofid`. -/
theorem fourier_correctedProfile_sub_mass_isBigO {d N : ℕ}
    (f : SchwartzMap (Euclidean d) ℂ) (hs : HasCompactSupport (f : Euclidean d → ℂ))
    {R : ℝ} (hR : 0 ≤ R) (hz : ∀ x, R < ‖x‖ → f x = 0) (hN : 0 < N) :
    Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 (correctedProfile f N) ξ - ∫ x, f x) (fun ξ => ‖ξ‖ ^ N) := by
  have h := fourier_sub_mass_isBigO_of_directional_moments (correctedProfile f N)
    (hasCompactSupport_correctedProfile hs N) hR (correctedProfile_eq_zero f hR hz N) hN
    (fun k hk hkN ξ => directionalMoment_correctedProfile_eq_zero f hs N k hk hkN.le ξ)
  simpa only [integral_correctedProfile f hs] using h

/-- Fourier covariance of normalized dyadic dilation. -/
theorem fourier_compactDyadicDilate {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ)
    (j : ℕ) (ξ : Euclidean d) :
    𝓕 (compactDyadicDilate f j) ξ = 𝓕 f (((2 : ℝ) ^ j)⁻¹ • ξ) := by
  let G : SchwartzMap (Euclidean d) ℂ :=
    SchwartzMap.compCLMOfContinuousLinearEquiv ℂ
      (ContinuousLinearEquiv.smulLeft
        (Units.mk0 (((2 : ℝ) ^ j)⁻¹) (by positivity))) (𝓕 f)
  have hG : 𝓕⁻ G = compactDyadicDilate f j := by
    ext x
    rw [SchwartzMap.fourierInv_coe]
    change 𝓕⁻ (fun ξ => 𝓕 f (((2 : ℝ) ^ j)⁻¹ • ξ)) x = _
    rw [Auto.Spherical.Auxiliary.fourierInv_comp_inv_smul _ (by positivity)]
    simp only [finrank_euclideanSpace_fin, ← SchwartzMap.fourierInv_coe,
      FourierTransform.fourierInv_fourier_eq, compactDyadicDilate_apply]
  have h := congrArg (fun g : SchwartzMap (Euclidean d) ℂ => 𝓕 g) hG
  rw [FourierTransform.fourier_fourierInv_eq] at h
  exact congrArg (fun g : SchwartzMap (Euclidean d) ℂ => g ξ) h.symm

/-- Dilation preserves the order of the Fourier jet at the origin. -/
theorem fourier_dilate_sub_one_isBigO {d N : ℕ} (f : SchwartzMap (Euclidean d) ℂ)
    (hf : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 f ξ - 1) (fun ξ => ‖ξ‖ ^ N)) (j : ℕ) :
    Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 (compactDyadicDilate f j) ξ - 1) (fun ξ => ‖ξ‖ ^ N) := by
  have ht : Tendsto (fun ξ : Euclidean d => ((2 : ℝ) ^ j)⁻¹ • ξ) (𝓝 0) (𝓝 0) := by
    have hc : Continuous (fun ξ : Euclidean d => ((2 : ℝ) ^ j)⁻¹ • ξ) := by fun_prop
    simpa only [smul_zero] using hc.tendsto (0 : Euclidean d)
  have h := hf.comp_tendsto ht
  have hg : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ : Euclidean d => ‖((2 : ℝ) ^ j)⁻¹ • ξ‖ ^ N) (fun ξ => ‖ξ‖ ^ N) := by
    refine Asymptotics.IsBigO.of_bound (‖((2 : ℝ) ^ j)⁻¹‖ ^ N) ?_
    filter_upwards with ξ
    simp [norm_smul, mul_pow]
  simpa only [fourier_compactDyadicDilate, Function.comp_def] using h.trans hg

/-- Multiplying two functions equal to one to order `N` preserves that jet. -/
theorem sub_one_mul_isBigO {d N : ℕ} {u v : Euclidean d → ℂ}
    (hu : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => u ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hv : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => v ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hvc : ContinuousAt v 0) :
    Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => u ξ * v ξ - 1) (fun ξ => ‖ξ‖ ^ N) := by
  have hb : Asymptotics.IsBigO (𝓝 (0 : Euclidean d)) v (fun _ => (1 : ℝ)) :=
    Asymptotics.isBigO_const_of_tendsto hvc.tendsto (by norm_num)
  have hprod : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => (u ξ - 1) * v ξ) (fun ξ => ‖ξ‖ ^ N) := by
    simpa only [mul_one] using hu.mul hb
  exact (hprod.add hv).congr_left (fun ξ => by ring)

/-- Convolution preserves the unit Fourier jet. -/
theorem fourier_convolution_sub_one_isBigO {d N : ℕ}
    (f g : SchwartzMap (Euclidean d) ℂ)
    (hf : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 f ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hg : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 g ξ - 1) (fun ξ => ‖ξ‖ ^ N)) :
    Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 (compactConvolution f g) ξ - 1) (fun ξ => ‖ξ‖ ^ N) := by
  simpa only [fourier_compactConvolution] using
    sub_one_mul_isBigO hf hg (𝓕 g).continuous.continuousAt

/-- The second cancelling factor vanishes to the same Fourier order. -/
theorem fourier_compactDualDifference_isBigO {d N : ℕ}
    (f g : SchwartzMap (Euclidean d) ℂ)
    (hf : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 f ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hg : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 g ξ - 1) (fun ξ => ‖ξ‖ ^ N)) :
    Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 (compactDualDifference f g) ξ) (fun ξ => ‖ξ‖ ^ N) := by
  have hff := fourier_convolution_sub_one_isBigO f f hf hf
  have hfg := fourier_convolution_sub_one_isBigO f g hf hg
  have hgg := fourier_convolution_sub_one_isBigO g g hg hg
  apply (((hf.add hg).const_mul_left (3 : ℂ)).sub
    (((hff.add hfg).add hgg).const_mul_left (2 : ℂ))).congr_left
  intro ξ
  simp only [compactDualDifference, sub_eq_add_neg, FourierTransform.fourier_add,
    FourierTransform.fourier_neg, FourierTransform.fourier_smul,
    add_apply, neg_apply, smul_apply, smul_eq_mul]
  ring

/-- The low-frequency dual factor, paired with the original unit-mass profile. -/
def compactDualLowpass {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ) :
    SchwartzMap (Euclidean d) ℂ :=
  (3 : ℂ) • f - (2 : ℂ) • compactConvolution f f

/-- The low-frequency dual factor has the same unit Fourier jet. -/
theorem fourier_compactDualLowpass_sub_one_isBigO {d N : ℕ}
    (f : SchwartzMap (Euclidean d) ℂ)
    (hf : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 f ξ - 1) (fun ξ => ‖ξ‖ ^ N)) :
    Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 (compactDualLowpass f) ξ - 1) (fun ξ => ‖ξ‖ ^ N) := by
  apply ((hf.const_mul_left (3 : ℂ)).sub
    ((fourier_convolution_sub_one_isBigO f f hf hf).const_mul_left (2 : ℂ))).congr_left
  intro ξ
  simp only [compactDualLowpass, sub_eq_add_neg, FourierTransform.fourier_add,
    FourierTransform.fourier_neg, FourierTransform.fourier_smul,
    add_apply, neg_apply, smul_apply, smul_eq_mul]
  ring

/-- Convolution adds the radii of centered kernel supports. -/
theorem compactConvolution_eq_zero_of_radius {d : ℕ}
    (f g : SchwartzMap (Euclidean d) ℂ) {R S : ℝ}
    (hf : ∀ x, R < ‖x‖ → f x = 0) (hg : ∀ x, S < ‖x‖ → g x = 0)
    {x : Euclidean d} (hx : R + S < ‖x‖) : compactConvolution f g x = 0 := by
  rw [compactConvolution, SchwartzMap.convolution_apply]
  apply integral_eq_zero_of_ae
  filter_upwards with y
  change f y * g (x - y) = 0
  by_cases hy : R < ‖y‖
  · rw [hf y hy, zero_mul]
  · rw [hg (x - y), mul_zero]
    have hnorm : ‖x‖ ≤ ‖x - y‖ + ‖y‖ := by
      simpa only [sub_add_cancel] using norm_add_le (x - y) y
    linarith [le_of_not_gt hy]

/-- Orthogonal invariance of convolution of radial kernels. -/
theorem compactConvolution_radial {d : ℕ} (f g : SchwartzMap (Euclidean d) ℂ)
    (hf : ∀ x y, ‖x‖ = ‖y‖ → f x = f y)
    (hg : ∀ x y, ‖x‖ = ‖y‖ → g x = g y) :
    ∀ x y, ‖x‖ = ‖y‖ → compactConvolution f g x = compactConvolution f g y := by
  intro x y hxy
  let U : Euclidean d ≃ₗᵢ[ℝ] Euclidean d :=
    Submodule.reflection (ℝ ∙ (x - y))ᗮ
  have hU : U x = y := Submodule.reflection_sub hxy
  simp only [compactConvolution, SchwartzMap.convolution_apply, convolution_def,
    ContinuousLinearMap.mul_apply']
  rw [← U.measurePreserving.integral_comp U.toHomeomorph.measurableEmbedding
    (fun z => f z * g (y - z))]
  apply integral_congr_ae
  filter_upwards with z
  rw [hf (U z) z (U.norm_map z)]
  congr 1
  apply hg
  rw [← hU, ← map_sub U, U.norm_map]

/-- The lowpass polynomial factors through its low-frequency dual. -/
theorem compactLowpass_eq_convolution {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ) :
    compactLowpass f = compactConvolution f (compactDualLowpass f) := by
  have h : 𝓕 (compactLowpass f) = 𝓕 (compactConvolution f (compactDualLowpass f)) := by
    ext ξ
    simp only [compactLowpass, compactDualLowpass, sub_eq_add_neg,
      FourierTransform.fourier_add, FourierTransform.fourier_neg, FourierTransform.fourier_smul,
      add_apply, neg_apply, smul_apply, smul_eq_mul, fourier_compactConvolution]
    ring
  simpa using congrArg (fun f : SchwartzMap (Euclidean d) ℂ => 𝓕⁻ f) h

/-- Analysis kernels of the compact resolution, indexed as in Section 2. -/
def compactAnalysisKernel {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ) :
    ℕ → SchwartzMap (Euclidean d) ℂ
  | 0 => f
  | j + 1 => compactDyadicDilate f (j + 1) - compactDyadicDilate f j

/-- Synthesis kernels of the compact resolution, indexed as in Section 2. -/
def compactSynthesisKernel {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ) :
    ℕ → SchwartzMap (Euclidean d) ℂ
  | 0 => compactDualLowpass f
  | j + 1 => compactDualDifference (compactDyadicDilate f (j + 1)) (compactDyadicDilate f j)

/-- The zero-scale normalized dilation is the original kernel. -/
theorem compactDyadicDilate_zero {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ) :
    compactDyadicDilate f 0 = f := by
  ext x
  simp [compactDyadicDilate_apply]

/-- Equation `eq:telescoping`: the partial reproducing kernel is the
normalized dilation of a single compact lowpass kernel. -/
theorem compact_kernel_telescoping {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ) (J : ℕ) :
    ∑ j ∈ Finset.range (J + 1), compactConvolution
      (compactAnalysisKernel f j) (compactSynthesisKernel f j) =
        compactDyadicDilate (compactLowpass f) J := by
  induction J with
  | zero => simp [compactAnalysisKernel, compactSynthesisKernel, compactDyadicDilate_zero,
      ← compactLowpass_eq_convolution]
  | succ J ih =>
    rw [Finset.sum_range_succ, ih]
    simp only [compactAnalysisKernel, compactSynthesisKernel, ← compactLowpass_sub,
      ← compactDyadicDilate_lowpass]
    abel

/-- Equation `eq:resolotionofid`: partial sums of the paired resolution
converge pointwise on Schwartz functions to the input. -/
theorem compact_kernel_resolution {d : ℕ} (φ f : SchwartzMap (Euclidean d) ℂ)
    (hφ : (∫ x, φ x) = 1) (x : Euclidean d) :
    Tendsto (fun J : ℕ => compactConvolution
      (∑ j ∈ Finset.range (J + 1), compactConvolution
        (compactAnalysisKernel φ j) (compactSynthesisKernel φ j)) f x)
      atTop (𝓝 (f x)) := by
  simp_rw [compact_kernel_telescoping]
  exact tendsto_compactConvolution_dilate (compactLowpass φ) f
    (integral_compactLowpass φ hφ) x

/-- Compact support of every analysis kernel. -/
theorem compactAnalysisKernel_hasCompactSupport {d : ℕ}
    (f : SchwartzMap (Euclidean d) ℂ) (hs : HasCompactSupport (f : Euclidean d → ℂ))
    (j : ℕ) : HasCompactSupport (compactAnalysisKernel f j : Euclidean d → ℂ) := by
  cases j with
  | zero => exact hs
  | succ j =>
    exact (hasCompactSupport_compactDyadicDilate hs (j + 1)).sub
      (hasCompactSupport_compactDyadicDilate hs j)

/-- Compact support of every synthesis kernel. -/
theorem compactSynthesisKernel_hasCompactSupport {d : ℕ}
    (f : SchwartzMap (Euclidean d) ℂ) (hs : HasCompactSupport (f : Euclidean d → ℂ))
    (j : ℕ) : HasCompactSupport (compactSynthesisKernel f j : Euclidean d → ℂ) := by
  cases j with
  | zero => exact hs.smul_left.sub (hasCompactSupport_compactConvolution hs hs).smul_left
  | succ j =>
    exact hasCompactSupport_compactDualDifference
      (hasCompactSupport_compactDyadicDilate hs (j + 1))
      (hasCompactSupport_compactDyadicDilate hs j)

/-- Fourier cancellation of all positive-scale analysis kernels. -/
theorem compactAnalysisKernel_fourier_isBigO {d N : ℕ}
    (f : SchwartzMap (Euclidean d) ℂ)
    (hf : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 f ξ - 1) (fun ξ => ‖ξ‖ ^ N)) (j : ℕ) :
    Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 (compactAnalysisKernel f (j + 1)) ξ) (fun ξ => ‖ξ‖ ^ N) := by
  apply ((fourier_dilate_sub_one_isBigO f hf (j + 1)).sub
    (fourier_dilate_sub_one_isBigO f hf j)).congr_left
  intro ξ
  simp only [compactAnalysisKernel, sub_eq_add_neg, FourierTransform.fourier_add,
    FourierTransform.fourier_neg, add_apply, neg_apply]
  ring

/-- Fourier cancellation of all positive-scale synthesis kernels. -/
theorem compactSynthesisKernel_fourier_isBigO {d N : ℕ}
    (f : SchwartzMap (Euclidean d) ℂ)
    (hf : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 f ξ - 1) (fun ξ => ‖ξ‖ ^ N)) (j : ℕ) :
    Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 (compactSynthesisKernel f (j + 1)) ξ) (fun ξ => ‖ξ‖ ^ N) :=
  fourier_compactDualDifference_isBigO _ _ (fourier_dilate_sub_one_isBigO f hf (j + 1))
    (fourier_dilate_sub_one_isBigO f hf j)

/-- Additivity of normalized dilation. -/
theorem compactDyadicDilate_add {d : ℕ} (f g : SchwartzMap (Euclidean d) ℂ) (j : ℕ) :
    compactDyadicDilate (f + g) j = compactDyadicDilate f j + compactDyadicDilate g j := by
  ext x
  simp [compactDyadicDilate_apply, smul_add]

/-- Subtraction commutes with normalized dilation. -/
theorem compactDyadicDilate_sub {d : ℕ} (f g : SchwartzMap (Euclidean d) ℂ) (j : ℕ) :
    compactDyadicDilate (f - g) j = compactDyadicDilate f j - compactDyadicDilate g j := by
  ext x
  simp [compactDyadicDilate_apply, smul_sub]

/-- Complex scalars commute with normalized dilation. -/
theorem compactDyadicDilate_smul {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ) (j : ℕ)
    (c : ℂ) : compactDyadicDilate (c • f) j = c • compactDyadicDilate f j := by
  ext x
  simp [compactDyadicDilate_apply, mul_left_comm]

/-- Composition law for dyadic dilations. -/
theorem compactDyadicDilate_comp {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ) (i j : ℕ) :
    compactDyadicDilate (compactDyadicDilate f i) j = compactDyadicDilate f (i + j) := by
  ext x
  simp [compactDyadicDilate_apply, pow_add, smul_smul, mul_pow, mul_left_comm, mul_assoc]

/-- Positive analysis kernels are dilates of one fixed kernel, as in Section 2. -/
theorem compactAnalysisKernel_succ {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ) (j : ℕ) :
    compactAnalysisKernel f (j + 1) = compactDyadicDilate (compactAnalysisKernel f 1) j := by
  simp [compactAnalysisKernel, compactDyadicDilate_sub, compactDyadicDilate_comp,
    compactDyadicDilate_zero, Nat.add_comm]

/-- Positive synthesis kernels are dilates of one fixed kernel, as in Section 2. -/
theorem compactSynthesisKernel_succ {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ) (j : ℕ) :
    compactSynthesisKernel f (j + 1) = compactDyadicDilate (compactSynthesisKernel f 1) j := by
  simp [compactSynthesisKernel, compactDualDifference, compactDyadicDilate_sub,
    compactDyadicDilate_add, compactDyadicDilate_smul, compactDyadicDilate_convolution,
    compactDyadicDilate_comp, compactDyadicDilate_zero, Nat.add_comm]

/-- Dilation preserves radial symmetry. -/
theorem compactDyadicDilate_radial {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ)
    (hf : ∀ x y, ‖x‖ = ‖y‖ → f x = f y) (j : ℕ) :
    ∀ x y, ‖x‖ = ‖y‖ → compactDyadicDilate f j x = compactDyadicDilate f j y := by
  intro x y hxy
  simp only [compactDyadicDilate_apply]
  rw [hf ((2 : ℝ) ^ j • x) ((2 : ℝ) ^ j • y) (by simp only [norm_smul, hxy])]

/-- All analysis kernels are radial. -/
theorem compactAnalysisKernel_radial {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ)
    (hf : ∀ x y, ‖x‖ = ‖y‖ → f x = f y) (j : ℕ) :
    ∀ x y, ‖x‖ = ‖y‖ → compactAnalysisKernel f j x = compactAnalysisKernel f j y := by
  cases j with
  | zero => exact hf
  | succ j =>
    intro x y hxy
    simp only [compactAnalysisKernel, sub_apply,
      compactDyadicDilate_radial f hf (j + 1) x y hxy,
      compactDyadicDilate_radial f hf j x y hxy]

/-- All synthesis kernels are radial. -/
theorem compactSynthesisKernel_radial {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ)
    (hf : ∀ x y, ‖x‖ = ‖y‖ → f x = f y) (j : ℕ) :
    ∀ x y, ‖x‖ = ‖y‖ → compactSynthesisKernel f j x = compactSynthesisKernel f j y := by
  cases j with
  | zero =>
    intro x y hxy
    simp only [compactSynthesisKernel, compactDualLowpass, sub_apply, smul_apply,
      hf x y hxy, compactConvolution_radial f f hf hf x y hxy]
  | succ j =>
    intro x y hxy
    have ha := compactDyadicDilate_radial f hf (j + 1)
    have hb := compactDyadicDilate_radial f hf j
    simp only [compactSynthesisKernel, compactDualDifference, sub_apply, smul_apply, add_apply,
      ha x y hxy, hb x y hxy, compactConvolution_radial _ _ ha ha x y hxy,
      compactConvolution_radial _ _ ha hb x y hxy, compactConvolution_radial _ _ hb hb x y hxy]

/-- Nonnegative dyadic scales do not enlarge the original support ball. -/
theorem compactDyadicDilate_eq_zero_of_radius {d : ℕ}
    (f : SchwartzMap (Euclidean d) ℂ) {R : ℝ} (hR : 0 ≤ R)
    (hf : ∀ x, R < ‖x‖ → f x = 0) (j : ℕ) :
    ∀ x, R < ‖x‖ → compactDyadicDilate f j x = 0 := by
  intro x hx
  apply compactDyadicDilate_eq_zero hf j
  exact (div_le_self hR (one_le_pow₀ (by norm_num : (1 : ℝ) ≤ 2))).trans_lt hx

/-- Analysis kernel support bound, uniform in the nonnegative scale. -/
theorem compactAnalysisKernel_eq_zero {d : ℕ}
    (f : SchwartzMap (Euclidean d) ℂ) {R : ℝ} (hR : 0 ≤ R)
    (hf : ∀ x, R < ‖x‖ → f x = 0) (j : ℕ) :
    ∀ x, R < ‖x‖ → compactAnalysisKernel f j x = 0 := by
  cases j with
  | zero => exact hf
  | succ j =>
    intro x hx
    simp [compactAnalysisKernel, compactDyadicDilate_eq_zero_of_radius f hR hf _ x hx]

/-- Synthesis kernel supports have radius at most twice the profile radius. -/
theorem compactSynthesisKernel_eq_zero {d : ℕ}
    (f : SchwartzMap (Euclidean d) ℂ) {R : ℝ} (hR : 0 ≤ R)
    (hf : ∀ x, R < ‖x‖ → f x = 0) (j : ℕ) :
    ∀ x, 2 * R < ‖x‖ → compactSynthesisKernel f j x = 0 := by
  intro x hx
  have hxR : R < ‖x‖ := by linarith
  have hxsum : R + R < ‖x‖ := by linarith
  cases j with
  | zero =>
    simp [compactSynthesisKernel, compactDualLowpass, hf x hxR,
      compactConvolution_eq_zero_of_radius f f hf hf hxsum]
  | succ j =>
    have ha := compactDyadicDilate_eq_zero_of_radius f hR hf (j + 1)
    have hb := compactDyadicDilate_eq_zero_of_radius f hR hf j
    simp [compactSynthesisKernel, compactDualDifference, ha x hxR, hb x hxR,
      compactConvolution_eq_zero_of_radius _ _ ha ha hxsum,
      compactConvolution_eq_zero_of_radius _ _ ha hb hxsum,
      compactConvolution_eq_zero_of_radius _ _ hb hb hxsum]

/-- Convolution is commutative on these scalar Schwartz kernels. -/
theorem compactConvolution_comm {d : ℕ} (f g : SchwartzMap (Euclidean d) ℂ) :
    compactConvolution f g = compactConvolution g f := by
  have h : 𝓕 (compactConvolution f g) = 𝓕 (compactConvolution g f) := by
    ext ξ
    simp only [fourier_compactConvolution, mul_comm]
  simpa using congrArg (fun f : SchwartzMap (Euclidean d) ℂ => 𝓕⁻ f) h

/-- Convolution is associative on the Schwartz space. -/
theorem compactConvolution_assoc {d : ℕ} (f g h : SchwartzMap (Euclidean d) ℂ) :
    compactConvolution (compactConvolution f g) h =
      compactConvolution f (compactConvolution g h) := by
  have he : 𝓕 (compactConvolution (compactConvolution f g) h) =
      𝓕 (compactConvolution f (compactConvolution g h)) := by
    ext ξ
    simp only [fourier_compactConvolution, mul_assoc]
  simpa using congrArg (fun f : SchwartzMap (Euclidean d) ℂ => 𝓕⁻ f) he

/-- The resolution written as the sum of synthesis operators applied to
analysis operators, exactly in the order of `eq:resolotionofid`. -/
theorem compact_kernel_resolution_sum {d : ℕ} (φ f : SchwartzMap (Euclidean d) ℂ)
    (hφ : (∫ x, φ x) = 1) (x : Euclidean d) :
    Tendsto (fun J : ℕ => ∑ j ∈ Finset.range (J + 1),
      compactConvolution (compactSynthesisKernel φ j)
        (compactConvolution (compactAnalysisKernel φ j) f) x)
      atTop (𝓝 (f x)) := by
  have h := compact_kernel_resolution φ f hφ x
  apply h.congr
  intro J
  simp only [compactConvolution, map_sum, sum_apply]
  apply Finset.sum_congr rfl
  intro j _
  change compactConvolution (compactConvolution _ _) f x = _
  rw [compactConvolution_comm (compactAnalysisKernel φ j), compactConvolution_assoc]
  rfl

/-- Existence of a concrete profile producing all four compact radial kernels
of Section 2. The kernel-specific support, jet, dilation, and resolution
properties are supplied by the preceding universal theorems. -/
theorem exists_compact_resolution_profile (d N : ℕ) (hN : 0 < N) :
    ∃ φ : SchwartzMap (Euclidean d) ℂ,
      HasCompactSupport (φ : Euclidean d → ℂ) ∧ (∫ x, φ x) = 1 ∧
      (∀ x, (1 : ℝ) / 1000 < ‖x‖ → φ x = 0) ∧
      (∀ x y, ‖x‖ = ‖y‖ → φ x = φ y) ∧
      Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
        (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N) := by
  obtain ⟨f, hs, hm, hz, hr⟩ := exists_radial_unitMass_kernel d
    (R := (1 : ℝ) / 1000) (by norm_num)
  refine ⟨correctedProfile f N, hasCompactSupport_correctedProfile hs N,
    ?_, correctedProfile_eq_zero f (by norm_num) (fun x hx => hz x hx.le) N,
    correctedProfile_radial f hr N, ?_⟩
  · rw [integral_correctedProfile f hs, hm]
  · simpa only [hm] using fourier_correctedProfile_sub_mass_isBigO f hs
      (by norm_num : (0 : ℝ) ≤ 1 / 1000) (fun x hx => hz x hx.le) hN

/-- Section 2, `eq:resolotionofid` and `eq:telescoping`: compact radial
Littlewood--Paley kernels with arbitrary Fourier cancellation order.
The reproducing series converges in its natural order, pointwise on Schwartz inputs. -/
theorem exists_compact_littlewoodPaley_resolution (d N : ℕ) (hN : 0 < N) :
    ∃ (ψ η : ℕ → SchwartzMap (Euclidean d) ℂ) (Φ : SchwartzMap (Euclidean d) ℂ),
      (∀ j x, (1 : ℝ) / 200 < ‖x‖ → ψ j x = 0 ∧ η j x = 0) ∧
      (∀ j x y, ‖x‖ = ‖y‖ → ψ j x = ψ j y ∧ η j x = η j y) ∧
      (∀ j, ψ (j + 1) = compactDyadicDilate (ψ 1) j ∧
        η (j + 1) = compactDyadicDilate (η 1) j) ∧
      Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
        (fun ξ => 𝓕 (ψ 0) ξ - 1) (fun ξ => ‖ξ‖ ^ N) ∧
      Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
        (fun ξ => 𝓕 (η 0) ξ - 1) (fun ξ => ‖ξ‖ ^ N) ∧
      (∀ j, Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
        (fun ξ => 𝓕 (ψ (j + 1)) ξ) (fun ξ => ‖ξ‖ ^ N) ∧
        Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
        (fun ξ => 𝓕 (η (j + 1)) ξ) (fun ξ => ‖ξ‖ ^ N)) ∧
      HasCompactSupport (Φ : Euclidean d → ℂ) ∧ (∫ x, Φ x) = 1 ∧
      (∀ J, ∑ j ∈ Finset.range (J + 1), compactConvolution (η j) (ψ j) =
        compactDyadicDilate Φ J) ∧
      ∀ (f : SchwartzMap (Euclidean d) ℂ) x,
        Tendsto (fun J : ℕ => ∑ j ∈ Finset.range (J + 1),
          compactConvolution (η j) (compactConvolution (ψ j) f) x) atTop (𝓝 (f x)) := by
  obtain ⟨φ, hs, hm, hz, hr, hflat⟩ := exists_compact_resolution_profile d N hN
  refine ⟨compactAnalysisKernel φ, compactSynthesisKernel φ, compactLowpass φ,
    ?_, ?_, ?_, hflat, fourier_compactDualLowpass_sub_one_isBigO φ hflat, ?_,
    hasCompactSupport_compactLowpass hs, integral_compactLowpass φ hm, ?_,
    fun f => compact_kernel_resolution_sum φ f hm⟩
  · intro j x hx
    exact ⟨compactAnalysisKernel_eq_zero φ (by norm_num) hz j x (by linarith),
      compactSynthesisKernel_eq_zero φ (by norm_num) hz j x (by linarith)⟩
  · intro j x y hxy
    exact ⟨compactAnalysisKernel_radial φ hr j x y hxy,
      compactSynthesisKernel_radial φ hr j x y hxy⟩
  · intro j
    exact ⟨compactAnalysisKernel_succ φ j, compactSynthesisKernel_succ φ j⟩
  · intro j
    exact ⟨compactAnalysisKernel_fourier_isBigO φ hflat j,
      compactSynthesisKernel_fourier_isBigO φ hflat j⟩
  · intro J
    simpa only [compactConvolution_comm] using compact_kernel_telescoping φ J

/-! ## Low-frequency localized estimate (`lem:k>j`) -/

/-- The absolute mass of a dyadically smoothed spherical kernel is `O(2^j)`
uniformly in radii at least one. This reuses the existing sphere-cap growth
estimate and its Schwartz-kernel consequence. -/
theorem exists_smoothed_sphere_kernel_bound {d : ℕ} (hd : 0 < d)
    (K : SchwartzMap (Euclidean d) ℂ) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : ℕ) (t : ℝ), 1 ≤ t → ∀ x : Euclidean d,
      (∫ ω : Metric.sphere (0 : Euclidean d) 1,
        ‖compactDyadicDilate K j (x + t • (ω : Euclidean d))‖ ∂unitSurfaceMeasure d) ≤
          C * (2 : ℝ) ^ j := by
  let Kneg : SchwartzMap (Euclidean d) ℂ :=
    SchwartzMap.compCLMOfContinuousLinearEquiv ℂ
      (ContinuousLinearEquiv.smulLeft (Units.mk0 (-1 : ℝ) (by norm_num))) K
  have hneg (u : Euclidean d) : Kneg u = K (-u) := by
    change K ((-1 : ℝ) • u) = K (-u)
    rw [neg_one_smul]
  obtain ⟨C, hC, hbound⟩ :=
    Auto.Spherical.Auxiliary.exists_surface_smoothed_schwartz_kernel_shell_bound hd Kneg
  refine ⟨C, hC, ?_⟩
  intro j t ht x
  have htpos : 0 < t := lt_of_lt_of_le zero_lt_one ht
  let L : ℝ := (2 : ℝ) ^ j * t
  let z : Euclidean d := -(t⁻¹ • x)
  have hL : 1 ≤ L := by
    have hj : (1 : ℝ) ≤ 2 ^ j := one_le_pow₀ (by norm_num)
    dsimp [L]
    nlinarith
  have hpoint (ω : Metric.sphere (0 : Euclidean d) 1) :
      t ^ d • compactDyadicDilate K j (x + t • (ω : Euclidean d)) =
        L ^ d • Kneg (L • (z - (ω : Euclidean d))) := by
    rw [hneg, compactDyadicDilate_apply, smul_smul]
    have harg : -(L • (z - (ω : Euclidean d))) =
        (2 : ℝ) ^ j • (x + t • (ω : Euclidean d)) := by
      dsimp [L, z]
      simp only [smul_sub, smul_neg, smul_smul, smul_add]
      rw [mul_assoc, mul_inv_cancel₀ htpos.ne', mul_one]
      module
    rw [harg]
    congr 1
    dsimp [L]
    rw [mul_pow, mul_comm]
  have heq : t ^ d * (∫ ω : Metric.sphere (0 : Euclidean d) 1,
      ‖compactDyadicDilate K j (x + t • (ω : Euclidean d))‖ ∂unitSurfaceMeasure d) =
      ∫ ω : Metric.sphere (0 : Euclidean d) 1,
        ‖L ^ d • Kneg (L • (z - (ω : Euclidean d)))‖ ∂unitSurfaceMeasure d := by
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with ω
    rw [← hpoint ω, norm_smul, Real.norm_eq_abs, abs_of_pos (pow_pos htpos _)]
  have hb := (hbound L hL z).1
  rw [← heq] at hb
  have hi : 0 ≤ ∫ ω : Metric.sphere (0 : Euclidean d) 1,
      ‖compactDyadicDilate K j (x + t • (ω : Euclidean d))‖ ∂unitSurfaceMeasure d :=
    integral_nonneg (fun _ => norm_nonneg _)
  have hp : t ≤ t ^ d := by
    simpa only [pow_one] using pow_le_pow_right₀ ht hd
  have hh := mul_le_mul_of_nonneg_right hp hi
  dsimp [L] at hb
  nlinarith

/-- Weighted Hölder in moment form, used for the low-frequency estimate.
The weights may vanish, and neither input moment needs to be finite. -/
theorem weighted_lintegral_rpow_le {X : Type*} [MeasurableSpace X] (μ : Measure X)
    {a b : X → ℝ≥0∞} (ha : AEMeasurable a μ) (hb : AEMeasurable b μ)
    {p : ℝ} (hp : 1 ≤ p) :
    (∫⁻ x, a x * b x ∂μ) ^ p ≤
      (∫⁻ x, a x ∂μ) ^ (p - 1) * ∫⁻ x, a x * b x ^ p ∂μ := by
  rcases eq_or_lt_of_le hp with h | h
  · rw [← h]
    simp
  let q := Real.conjExponent p
  have hconj : q.HolderConjugate p := (Real.HolderConjugate.conjExponent h).symm
  have hp0 : 0 < p := by linarith
  have hq0 : 0 < q := hconj.pos
  have hsum : 1 / q + 1 / p = 1 := by simpa using hconj.one_div_add_one_div
  have hsplit (x : X) : a x * b x =
      a x ^ (1 / q) * (a x ^ (1 / p) * b x) := by
    rw [← mul_assoc, ← ENNReal.rpow_add_of_nonneg _ _ (by positivity) (by positivity),
      hsum, ENNReal.rpow_one]
  have hh := ENNReal.lintegral_mul_le_Lp_mul_Lq μ hconj
    (ha.pow_const (1 / q)) ((ha.pow_const (1 / p)).mul hb)
  have hfirst : (fun x => (a x ^ (1 / q)) ^ q) = a := by
    funext x
    rw [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
  have hsecond : (fun x => (a x ^ (1 / p) * b x) ^ p) =
      fun x => a x * b x ^ p := by
    funext x
    rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul, one_div,
      inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one]
  simp only [Pi.mul_apply, hfirst, hsecond] at hh
  rw [lintegral_congr hsplit]
  have hpow := ENNReal.rpow_le_rpow hh hp0.le
  rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul,
    ← ENNReal.rpow_mul, show (1 / p) * p = 1 by field_simp,
    ENNReal.rpow_one] at hpow
  have hqp : (1 / q) * p = p - 1 := by
    have hq : 1 / q = 1 - 1 / p := by linarith
    rw [hq]
    field_simp
  simpa only [hqp] using hpow

/-- Convolution with a Schwartz kernel, allowing arbitrary continuous inputs. -/
def smoothInput {d : ℕ} (K : SchwartzMap (Euclidean d) ℂ)
    (f : Euclidean d → ℂ) (x : Euclidean d) : ℂ := ∫ y, K y * f (x - y)

theorem smoothInput_eq_compactConvolution {d : ℕ}
    (K f : SchwartzMap (Euclidean d) ℂ) :
    smoothInput K f = compactConvolution K f := by
  funext x
  rw [compactConvolution, SchwartzMap.convolution_apply]
  rfl

theorem smoothInput_measurable {d : ℕ} (K : SchwartzMap (Euclidean d) ℂ)
    {f : Euclidean d → ℂ} (hf : Continuous f) : Measurable (smoothInput K f) := by
  have hc : Continuous (fun z : Euclidean d × Euclidean d => K z.2 * f (z.1 - z.2)) :=
    (K.continuous.comp continuous_snd).mul (hf.comp (continuous_fst.sub continuous_snd))
  exact hc.stronglyMeasurable.integral_prod_right'.measurable

/-- Pointwise weighted Hölder estimate for convolution. -/
theorem enorm_smoothInput_rpow_le {d : ℕ}
    (K : SchwartzMap (Euclidean d) ℂ) {f : Euclidean d → ℂ} (hf : Continuous f)
    {p : ℝ} (hp : 1 ≤ p) (x : Euclidean d) :
    ‖smoothInput K f x‖ₑ ^ p ≤ (∫⁻ y, ‖K y‖ₑ) ^ (p - 1) *
      ∫⁻ y, ‖K y‖ₑ * ‖f (x - y)‖ₑ ^ p := by
  have hbase : ‖smoothInput K f x‖ₑ ≤ ∫⁻ y, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
    simpa only [smoothInput, enorm_mul] using enorm_integral_le_lintegral_enorm
      (fun y => K y * f (x - y))
  apply (ENNReal.rpow_le_rpow hbase (by linarith)).trans
  exact weighted_lintegral_rpow_le volume K.continuous.measurable.enorm.aemeasurable
    (hf.measurable.comp (measurable_const.sub measurable_id)).enorm.aemeasurable hp

/-- Pointwise weighted Hölder estimate for Schwartz convolution. -/
theorem enorm_compactConvolution_rpow_le {d : ℕ}
    (K f : SchwartzMap (Euclidean d) ℂ) {p : ℝ} (hp : 1 ≤ p) (x : Euclidean d) :
    ‖compactConvolution K f x‖ₑ ^ p ≤ (∫⁻ y, ‖K y‖ₑ) ^ (p - 1) *
      ∫⁻ y, ‖K y‖ₑ * ‖f (x - y)‖ₑ ^ p := by
  have hbase : ‖compactConvolution K f x‖ₑ ≤ ∫⁻ y, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
    rw [compactConvolution, SchwartzMap.convolution_apply]
    change ‖∫ y, K y * f (x - y)‖ₑ ≤ _
    simpa only [enorm_mul] using enorm_integral_le_lintegral_enorm
      (fun y => K y * f (x - y))
  apply (ENNReal.rpow_le_rpow hbase (by linarith)).trans
  exact weighted_lintegral_rpow_le volume K.continuous.measurable.enorm.aemeasurable
    (f.continuous.measurable.comp (measurable_const.sub measurable_id)).enorm.aemeasurable hp

/-- The absolute kernel mass is unchanged by normalized dyadic dilation. -/
theorem lintegral_enorm_compactDyadicDilate {d : ℕ}
    (K : SchwartzMap (Euclidean d) ℂ) (j : ℕ) :
    (∫⁻ y, ‖compactDyadicDilate K j y‖ₑ) = ∫⁻ y, ‖K y‖ₑ := by
  rw [← ofReal_integral_norm_eq_lintegral_enorm (compactDyadicDilate K j).integrable,
    ← ofReal_integral_norm_eq_lintegral_enorm K.integrable]
  congr 1
  exact integral_norm_dilate_eq d (K : Euclidean d → ℂ) (by positivity : (0 : ℝ) < 2 ^ j)

/-- ENNReal form of the smoothed sphere kernel estimate. -/
theorem exists_smoothed_sphere_kernel_enorm_bound {d : ℕ} (hd : 0 < d)
    (K : SchwartzMap (Euclidean d) ℂ) :
    ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ (j : ℕ) (t : ℝ), 1 ≤ t → ∀ x : Euclidean d,
      (∫⁻ ω : Metric.sphere (0 : Euclidean d) 1,
        ‖compactDyadicDilate K j (x + t • (ω : Euclidean d))‖ₑ ∂unitSurfaceMeasure d) ≤
          C * ENNReal.ofReal ((2 : ℝ) ^ j) := by
  obtain ⟨C, hC, hb⟩ := exists_smoothed_sphere_kernel_bound hd K
  refine ⟨ENNReal.ofReal C, ENNReal.ofReal_ne_top, ?_⟩
  intro j t ht x
  have hc : Continuous (fun ω : Metric.sphere (0 : Euclidean d) 1 =>
      compactDyadicDilate K j (x + t • (ω : Euclidean d))) :=
    (compactDyadicDilate K j).continuous.comp (by fun_prop)
  have hi := hc.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
    (μ := unitSurfaceMeasure d)
  rw [← ofReal_integral_norm_eq_lintegral_enorm hi, ← ENNReal.ofReal_mul hC.le]
  exact ENNReal.ofReal_le_ofReal (hb j t ht x)

/-- Tonelli and translation expose the smoothed sphere kernel inside the
pointwise moment estimate. All integrands are nonnegative. -/
theorem spherical_convolution_moment_swap {d : ℕ}
    (K : SchwartzMap (Euclidean d) ℂ) {f : Euclidean d → ℂ}
    (hf : Continuous f) (p t : ℝ) (x : Euclidean d) :
    (∫⁻ ω : Metric.sphere (0 : Euclidean d) 1, (∫⁻ y,
      ‖K y‖ₑ * ‖f (x + t • (ω : Euclidean d) - y)‖ₑ ^ p) ∂unitSurfaceMeasure d) =
      ∫⁻ y, (∫⁻ ω : Metric.sphere (0 : Euclidean d) 1,
        ‖K (x + t • (ω : Euclidean d) - y)‖ₑ ∂unitSurfaceMeasure d) * ‖f y‖ₑ ^ p := by
  have hshift (ω : Metric.sphere (0 : Euclidean d) 1) :
      (∫⁻ y, ‖K y‖ₑ * ‖f (x + t • (ω : Euclidean d) - y)‖ₑ ^ p) =
        ∫⁻ y, ‖K (x + t • (ω : Euclidean d) - y)‖ₑ * ‖f y‖ₑ ^ p := by
    have h := lintegral_sub_left_eq_self (μ := (volume : Measure (Euclidean d)))
      (fun y => ‖K y‖ₑ * ‖f (x + t • (ω : Euclidean d) - y)‖ₑ ^ p)
      (x + t • (ω : Euclidean d))
    simpa only [sub_sub_cancel] using h.symm
  simp_rw [hshift]
  have hc : Continuous (fun z : Metric.sphere (0 : Euclidean d) 1 × Euclidean d =>
      K (x + t • (z.1 : Euclidean d) - z.2)) := K.continuous.comp (by fun_prop)
  have hm : Measurable (fun z : Metric.sphere (0 : Euclidean d) 1 × Euclidean d =>
      ‖K (x + t • (z.1 : Euclidean d) - z.2)‖ₑ * ‖f z.2‖ₑ ^ p) :=
    hc.measurable.enorm.mul ((hf.measurable.comp measurable_snd).enorm.pow_const p)
  rw [lintegral_lintegral_swap hm.aemeasurable]
  apply lintegral_congr
  intro y
  apply lintegral_mul_const
  exact (K.continuous.comp
    (show Continuous (fun ω : Metric.sphere (0 : Euclidean d) 1 =>
      x + t • (ω : Euclidean d) - y) by fun_prop)).measurable.enorm

/-- Unnormalized spherical averaging of a smoothed input, in moment form. -/
theorem sphericalAverage_convolution_rpow_le {d : ℕ}
    (K : SchwartzMap (Euclidean d) ℂ) {f : Euclidean d → ℂ}
    (hf : Continuous f) {p : ℝ} (hp : 1 ≤ p)
    (t : ℝ) (x : Euclidean d) :
    ‖sphericalAverage d (smoothInput K f) t x‖ₑ ^ p ≤
      (unitSurfaceMeasure d univ) ^ (p - 1) * (∫⁻ y, ‖K y‖ₑ) ^ (p - 1) *
        ∫⁻ y, (∫⁻ ω : Metric.sphere (0 : Euclidean d) 1,
          ‖K (x + t • (ω : Euclidean d) - y)‖ₑ ∂unitSurfaceMeasure d) * ‖f y‖ₑ ^ p := by
  have hc : Measurable (fun ω : Metric.sphere (0 : Euclidean d) 1 =>
      smoothInput K f (x + t • (ω : Euclidean d))) :=
    (smoothInput_measurable K hf).comp (by fun_prop)
  have hholder := weighted_lintegral_rpow_le (unitSurfaceMeasure d)
    (a := fun _ => 1) aemeasurable_const hc.enorm.aemeasurable hp
  simp only [one_mul, lintegral_const] at hholder
  have hnorm := ENNReal.rpow_le_rpow
    (enorm_integral_le_lintegral_enorm
      (fun ω : Metric.sphere (0 : Euclidean d) 1 =>
        smoothInput K f (x + t • (ω : Euclidean d))) (μ := unitSurfaceMeasure d))
    (show 0 ≤ p by linarith)
  apply (hnorm.trans hholder).trans
  calc
    (unitSurfaceMeasure d univ) ^ (p - 1) *
        (∫⁻ ω : Metric.sphere (0 : Euclidean d) 1,
          ‖smoothInput K f (x + t • (ω : Euclidean d))‖ₑ ^ p ∂unitSurfaceMeasure d) ≤
      (unitSurfaceMeasure d univ) ^ (p - 1) *
        (∫⁻ ω : Metric.sphere (0 : Euclidean d) 1,
          (∫⁻ y, ‖K y‖ₑ) ^ (p - 1) *
            (∫⁻ y, ‖K y‖ₑ * ‖f (x + t • (ω : Euclidean d) - y)‖ₑ ^ p)
              ∂unitSurfaceMeasure d) :=
      mul_le_mul' le_rfl (lintegral_mono (fun _ => enorm_smoothInput_rpow_le K hf hp _))
    _ = _ := by
      rw [lintegral_const_mul' _ _ (ENNReal.rpow_ne_top_of_nonneg (by linarith)
        K.integrable.hasFiniteIntegral.ne), spherical_convolution_moment_swap K hf, mul_assoc]

/-- A fixed-scale smoothing costs only one dyadic power, uniformly over all
spherical radii at least one. -/
theorem smoothed_maximal_pointwise_bound {d : ℕ} (hd : 0 < d)
    (K : SchwartzMap (Euclidean d) ℂ) {p : ℝ} (hp : 1 ≤ p) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (E : Set ℝ), E ⊆ Ici 1 →
      ∀ (j : ℕ) (f : Euclidean d → ℂ), Continuous f → ∀ (x : Euclidean d),
      (restrictedNormalizedSphericalMaximal d E
        (smoothInput (compactDyadicDilate K j) f) x) ^ p ≤
          A * ENNReal.ofReal ((2 : ℝ) ^ j) * ∫⁻ y, ‖f y‖ₑ ^ p := by
  obtain ⟨C, hC, hkernel⟩ := exists_smoothed_sphere_kernel_enorm_bound hd K
  let B : ℝ≥0∞ := ‖((surfaceMass d)⁻¹ : ℂ)‖ₑ ^ p *
    (unitSurfaceMeasure d univ) ^ (p - 1) * (∫⁻ y, ‖K y‖ₑ) ^ (p - 1)
  have hp0 : 0 < p := by linarith
  have hB : B ≠ ∞ := by
    exact ENNReal.mul_ne_top
      (ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg hp0.le enorm_ne_top)
        (ENNReal.rpow_ne_top_of_nonneg (by linarith) (measure_ne_top _ _)))
      (ENNReal.rpow_ne_top_of_nonneg (by linarith) K.integrable.hasFiniteIntegral.ne)
  refine ⟨B * C, ENNReal.mul_ne_top hB hC, ?_⟩
  intro E hE j f hf x
  apply (ENNReal.le_rpow_inv_iff hp0).mp
  apply iSup_le
  intro t
  apply (ENNReal.le_rpow_inv_iff hp0).mpr
  rw [ofReal_norm, normalizedSphericalAverage, enorm_mul,
    ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
  have havg := sphericalAverage_convolution_rpow_le (compactDyadicDilate K j) hf hp t x
  rw [lintegral_enorm_compactDyadicDilate] at havg
  have hint : (∫⁻ y, (∫⁻ ω : Metric.sphere (0 : Euclidean d) 1,
        ‖compactDyadicDilate K j (x + (t : ℝ) • (ω : Euclidean d) - y)‖ₑ
          ∂unitSurfaceMeasure d) * ‖f y‖ₑ ^ p) ≤
      (C * ENNReal.ofReal ((2 : ℝ) ^ j)) * ∫⁻ y, ‖f y‖ₑ ^ p := by
    rw [← lintegral_const_mul' _ _ (ENNReal.mul_ne_top hC ENNReal.ofReal_ne_top)]
    apply lintegral_mono
    intro y
    apply mul_le_mul' _ le_rfl
    simpa only [sub_add_eq_add_sub] using hkernel j t (hE t.property.1) (x - y)
  calc
    _ ≤ B * (∫⁻ y, (∫⁻ ω : Metric.sphere (0 : Euclidean d) 1,
        ‖compactDyadicDilate K j (x + (t : ℝ) • (ω : Euclidean d) - y)‖ₑ
          ∂unitSurfaceMeasure d) * ‖f y‖ₑ ^ p) := by
      simpa only [B, mul_assoc] using mul_le_mul' le_rfl havg
    _ ≤ B * ((C * ENNReal.ofReal ((2 : ℝ) ^ j)) * ∫⁻ y, ‖f y‖ₑ ^ p) :=
      mul_le_mul' le_rfl hint
    _ = _ := by simp only [mul_assoc]

/-- The low-frequency small-ball estimate for continuous inputs. The bound
holds for all dyadic indices, including the source range `j < k`. -/
theorem smoothed_maximal_smallBall_bound {d : ℕ} (hd : 0 < d)
    (K : SchwartzMap (Euclidean d) ℂ) {p : ℝ} (hp : 1 ≤ p) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (E : Set ℝ), E ⊆ Ici 1 →
      ∀ (j k : ℕ) (f : Euclidean d → ℂ), Continuous f →
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) (((2 : ℝ) ^ k)⁻¹),
        (restrictedNormalizedSphericalMaximal d E
          (smoothInput (compactDyadicDilate K j) f) x) ^ p
            ∂powerWeightedVolume d (1 - (d : ℝ))) ≤
        A * ENNReal.ofReal ((2 : ℝ) ^ j) * (ENNReal.ofReal ((2 : ℝ) ^ k))⁻¹ *
          ∫⁻ y, ‖f y‖ₑ ^ p := by
  obtain ⟨A, hA, hb⟩ := smoothed_maximal_pointwise_bound hd K hp
  let μ := powerWeightedVolume d (1 - (d : ℝ))
  have hα : -(d : ℝ) < 1 - (d : ℝ) := by linarith
  let : IsFiniteMeasureOnCompacts μ := powerWeightedVolume_isFiniteMeasureOnCompacts hd hα
  refine ⟨A * μ (Metric.closedBall 0 1), ENNReal.mul_ne_top hA
    (ne_of_lt (isCompact_closedBall (0 : Euclidean d) 1).measure_lt_top), ?_⟩
  intro E hE j k f hf
  calc
    _ ≤ ∫⁻ _ in Metric.closedBall (0 : Euclidean d) (((2 : ℝ) ^ k)⁻¹),
        A * ENNReal.ofReal ((2 : ℝ) ^ j) * (∫⁻ y, ‖f y‖ₑ ^ p) ∂μ :=
      lintegral_mono (fun x => hb E hE j f hf x)
    _ = _ := by
      rw [setLIntegral_const]
      have hscale := powerWeightedVolume_closedBall_inv_dyadic_scale hd hα k
      have he : -((d : ℝ) + (1 - (d : ℝ))) = -1 := by ring
      rw [he, ENNReal.rpow_neg_one] at hscale
      change _ * powerWeightedVolume d (1 - (d : ℝ)) _ = _
      rw [hscale]
      simp only [μ]
      ring

/-- Source Lemma `lem:k>j`, in equivalent moment form, for the actual synthesis
kernels of the compact resolution. The constant is independent of both indices. -/
theorem synthesis_low_frequency_bound {d : ℕ} (hd : 0 < d)
    (φ : SchwartzMap (Euclidean d) ℂ) {p : ℝ} (hp : 1 ≤ p) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (j k : ℕ) (f : Euclidean d → ℂ), Continuous f →
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) (((2 : ℝ) ^ k)⁻¹),
        (restrictedNormalizedSphericalMaximal d (Icc 1 2)
          (smoothInput (compactSynthesisKernel φ j) f) x) ^ p
            ∂powerWeightedVolume d (1 - (d : ℝ))) ≤
        A * ENNReal.ofReal ((2 : ℝ) ^ j) * (ENNReal.ofReal ((2 : ℝ) ^ k))⁻¹ *
          ∫⁻ y, ‖f y‖ₑ ^ p := by
  obtain ⟨A₀, hA₀, hb₀⟩ := smoothed_maximal_smallBall_bound hd (compactSynthesisKernel φ 0) hp
  obtain ⟨A₁, hA₁, hb₁⟩ := smoothed_maximal_smallBall_bound hd (compactSynthesisKernel φ 1) hp
  refine ⟨max A₀ A₁, ne_of_lt (max_lt (lt_top_iff_ne_top.mpr hA₀)
    (lt_top_iff_ne_top.mpr hA₁)), ?_⟩
  intro j k f hf
  cases j with
  | zero =>
    have hb := hb₀ (Icc 1 2) (fun _ h => h.1) 0 k f hf
    rw [compactDyadicDilate_zero] at hb
    exact hb.trans (mul_le_mul' (mul_le_mul' (mul_le_mul' (le_max_left _ _) le_rfl) le_rfl) le_rfl)
  | succ j =>
    rw [compactSynthesisKernel_succ]
    apply (hb₁ (Icc 1 2) (fun _ h => h.1) j k f hf).trans
    apply mul_le_mul' _ le_rfl
    apply mul_le_mul' _ le_rfl
    exact mul_le_mul' (le_max_right _ _)
      (ENNReal.ofReal_le_ofReal (pow_le_pow_right₀ (by norm_num) (Nat.le_succ j)))

/-- Incidence with a small spatial ball occupies a codimension-one cap of
every sphere whose radius is at least one. -/
theorem sphere_smallBall_incidence_bound {d : ℕ} (hd : 0 < d) :
    ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ (t R : ℝ), 1 ≤ t → 0 < R → ∀ y : Euclidean d,
      unitSurfaceMeasure d {ω : Metric.sphere (0 : Euclidean d) 1 |
        y - t • (ω : Euclidean d) ∈ Metric.closedBall 0 R} ≤
          C * ENNReal.ofReal (R ^ (d - 1)) := by
  obtain ⟨C, hC, hcap⟩ := exists_unitSurfaceMeasure_cap_le_power hd
  refine ⟨C * ENNReal.ofReal ((2 : ℝ) ^ (d - 1)),
    ENNReal.mul_ne_top hC ENNReal.ofReal_ne_top, ?_⟩
  intro t R ht hR y
  have ht0 : 0 < t := by linarith
  have hsub : {ω : Metric.sphere (0 : Euclidean d) 1 |
      y - t • (ω : Euclidean d) ∈ Metric.closedBall 0 R} ⊆
      (fun ω : Metric.sphere (0 : Euclidean d) 1 => (ω : Euclidean d)) ⁻¹'
        Metric.ball (t⁻¹ • y) (2 * R) := by
    intro ω hω
    have hn : ‖y - t • (ω : Euclidean d)‖ ≤ R := by simpa using hω
    have he : t⁻¹ • (y - t • (ω : Euclidean d)) = t⁻¹ • y - (ω : Euclidean d) := by
      rw [smul_sub, smul_smul, inv_mul_cancel₀ ht0.ne', one_smul]
    have hi : t⁻¹ ≤ 1 := inv_le_one_of_one_le₀ ht
    have hn' : ‖t⁻¹ • y - (ω : Euclidean d)‖ ≤ R := by
      rw [← he, norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr ht0)]
      exact (mul_le_mul_of_nonneg_left hn (inv_nonneg.mpr ht0.le)).trans
        (by simpa using mul_le_mul_of_nonneg_right hi hR.le)
    change dist (ω : Euclidean d) (t⁻¹ • y) < 2 * R
    rw [dist_eq_norm, norm_sub_rev]
    linarith
  calc
    _ ≤ unitSurfaceMeasure d
        ((fun ω : Metric.sphere (0 : Euclidean d) 1 => (ω : Euclidean d)) ⁻¹'
          Metric.ball (t⁻¹ • y) (2 * R)) := measure_mono hsub
    _ ≤ C * ENNReal.ofReal ((2 * R) ^ (d - 1)) := hcap _ _ (by positivity)
    _ = _ := by rw [mul_pow, ENNReal.ofReal_mul (by positivity), mul_assoc]

/-- Translation and Tonelli identify a localized spherical integral with its
incidence multiplicity. -/
theorem sphere_translate_ball_identity {d : ℕ} {b : Euclidean d → ℝ≥0∞}
    (hb : Measurable b) (t R : ℝ) :
    (∫⁻ x in Metric.closedBall (0 : Euclidean d) R,
      (∫⁻ ω : Metric.sphere (0 : Euclidean d) 1,
        b (x + t • (ω : Euclidean d)) ∂unitSurfaceMeasure d)) =
      ∫⁻ y, b y * unitSurfaceMeasure d {ω : Metric.sphere (0 : Euclidean d) 1 |
        y - t • (ω : Euclidean d) ∈ Metric.closedBall 0 R} := by
  classical
  let B := Metric.closedBall (0 : Euclidean d) R
  have hB : MeasurableSet B := measurableSet_closedBall
  have hm : Measurable (fun z : Euclidean d × Metric.sphere (0 : Euclidean d) 1 =>
      b (z.1 + t • (z.2 : Euclidean d))) := hb.comp (by fun_prop)
  rw [lintegral_lintegral_swap hm.aemeasurable]
  have hshift (ω : Metric.sphere (0 : Euclidean d) 1) :
      (∫⁻ x in B, b (x + t • (ω : Euclidean d))) =
        ∫⁻ y, B.indicator (fun _ => b y) (y - t • (ω : Euclidean d)) := by
    rw [← lintegral_indicator hB]
    have he := lintegral_add_right_eq_self (μ := (volume : Measure (Euclidean d)))
      (fun y => B.indicator (fun _ => b y) (y - t • (ω : Euclidean d)))
      (t • (ω : Euclidean d))
    rw [← he]
    apply lintegral_congr
    intro x
    by_cases hx : x ∈ B <;> simp [hx]
  change (∫⁻ ω : Metric.sphere (0 : Euclidean d) 1, (∫⁻ x in B,
    b (x + t • (ω : Euclidean d))) ∂unitSurfaceMeasure d) = _
  simp_rw [hshift]
  have hprod : Measurable (fun z : Metric.sphere (0 : Euclidean d) 1 × Euclidean d =>
      B.indicator (fun _ => b z.2) (z.2 - t • (z.1 : Euclidean d))) := by
    have hs : MeasurableSet {z : Metric.sphere (0 : Euclidean d) 1 × Euclidean d |
        z.2 - t • (z.1 : Euclidean d) ∈ B} := hB.preimage (by fun_prop)
    convert (hb.comp measurable_snd).indicator hs using 1
    funext z
    by_cases hz : z.2 - t • (z.1 : Euclidean d) ∈ B <;> simp [hz]
  rw [lintegral_lintegral_swap hprod.aemeasurable]
  apply lintegral_congr
  intro y
  have hs : MeasurableSet {ω : Metric.sphere (0 : Euclidean d) 1 |
      y - t • (ω : Euclidean d) ∈ B} := hB.preimage (by fun_prop)
  convert lintegral_indicator_const hs (b y) using 1
  congr 1

/-- The fixed-radius localized `L¹` estimate behind the high-frequency lemma. -/
theorem sphericalAverage_smallBall_L1_bound {d : ℕ} (hd : 0 < d) :
    ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ (t R : ℝ), 1 ≤ t → 0 < R →
      ∀ (f : Euclidean d → ℂ), Measurable f →
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) R,
        ‖sphericalAverage d f t x‖ₑ) ≤
          C * ENNReal.ofReal (R ^ (d - 1)) * ∫⁻ y, ‖f y‖ₑ := by
  obtain ⟨C, hC, hb⟩ := sphere_smallBall_incidence_bound hd
  refine ⟨C, hC, ?_⟩
  intro t R ht hR f hf
  calc
    _ ≤ ∫⁻ x in Metric.closedBall (0 : Euclidean d) R,
        (∫⁻ ω : Metric.sphere (0 : Euclidean d) 1,
          ‖f (x + t • (ω : Euclidean d))‖ₑ ∂unitSurfaceMeasure d) :=
      lintegral_mono (fun x => enorm_integral_le_lintegral_enorm _)
    _ = _ := sphere_translate_ball_identity hf.enorm t R
    _ ≤ ∫⁻ y, ‖f y‖ₑ * (C * ENNReal.ofReal (R ^ (d - 1))) :=
      lintegral_mono (fun y => mul_le_mul' le_rfl (hb t R ht hR y))
    _ = _ := by rw [lintegral_mul_const _ hf.enorm, mul_comm]

/-- The `L¹` convolution inequality, with extended integrals so no input
integrability premise is needed. -/
theorem lintegral_smoothInput_le {d : ℕ}
    (K : SchwartzMap (Euclidean d) ℂ) {f : Euclidean d → ℂ} (hf : Continuous f) :
    (∫⁻ x, ‖smoothInput K f x‖ₑ) ≤ (∫⁻ y, ‖K y‖ₑ) * ∫⁻ x, ‖f x‖ₑ := by
  have hm : Measurable (fun z : Euclidean d × Euclidean d =>
      ‖K z.2‖ₑ * ‖f (z.1 - z.2)‖ₑ) :=
    (K.continuous.measurable.comp measurable_snd).enorm.mul
      (hf.measurable.comp (measurable_fst.sub measurable_snd)).enorm
  calc
    _ ≤ ∫⁻ x, ∫⁻ y, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
      apply lintegral_mono
      intro x
      simpa only [ENNReal.rpow_one, sub_self, ENNReal.rpow_zero, one_mul] using
        enorm_smoothInput_rpow_le K hf (p := 1) le_rfl x
    _ = ∫⁻ y, ∫⁻ x, ‖K y‖ₑ * ‖f (x - y)‖ₑ :=
      lintegral_lintegral_swap hm.aemeasurable
    _ = ∫⁻ y, ‖K y‖ₑ * ∫⁻ x, ‖f x‖ₑ := by
      apply lintegral_congr
      intro y
      rw [lintegral_const_mul' _ _ enorm_ne_top,
        lintegral_sub_right_eq_self (μ := (volume : Measure (Euclidean d)))
          (fun x => ‖f x‖ₑ) y]
    _ = _ := lintegral_mul_const _ K.continuous.measurable.enorm

/-- Uniform localized `L¹` bound for every dyadic smoothing of a fixed kernel. -/
theorem smoothed_sphericalAverage_smallBall_L1_bound {d : ℕ} (hd : 0 < d)
    (K : SchwartzMap (Euclidean d) ℂ) :
    ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ (j : ℕ) (t R : ℝ), 1 ≤ t → 0 < R →
      ∀ (f : Euclidean d → ℂ), Continuous f →
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) R,
        ‖sphericalAverage d (smoothInput (compactDyadicDilate K j) f) t x‖ₑ) ≤
          C * ENNReal.ofReal (R ^ (d - 1)) * ∫⁻ y, ‖f y‖ₑ := by
  obtain ⟨C, hC, hb⟩ := sphericalAverage_smallBall_L1_bound hd
  refine ⟨C * ∫⁻ y, ‖K y‖ₑ, ENNReal.mul_ne_top hC K.integrable.hasFiniteIntegral.ne, ?_⟩
  intro j t R ht hR f hf
  apply (hb t R ht hR _ (smoothInput_measurable _ hf)).trans
  have hi := lintegral_smoothInput_le (compactDyadicDilate K j) hf
  rw [lintegral_enorm_compactDyadicDilate] at hi
  calc
    _ ≤ (C * ENNReal.ofReal (R ^ (d - 1))) * ((∫⁻ y, ‖K y‖ₑ) * ∫⁻ y, ‖f y‖ₑ) :=
      mul_le_mul' le_rfl hi
    _ = _ := by ring

/-- A bounded Schwartz function with a vanishing jet is globally bounded by
every smaller nonnegative power of the distance to the origin. -/
theorem schwartz_norm_le_rpow_of_flat {d N : ℕ}
    (g : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => g ξ) (fun ξ => ‖ξ‖ ^ N))
    {s : ℝ} (hs : 0 ≤ s) (hsN : s ≤ N) :
    ∃ C : ℝ, 0 < C ∧ ∀ ξ, ‖g ξ‖ ≤ C * ‖ξ‖ ^ s := by
  obtain ⟨c, hc, hb⟩ := Asymptotics.isBigO_iff'.mp hflat
  obtain ⟨ε, hε, he⟩ := Metric.eventually_nhds_iff.mp hb
  let r := min ε 1
  have hr : 0 < r := lt_min hε zero_lt_one
  let M := SchwartzMap.seminorm ℝ 0 0 g
  have hM : 0 ≤ M := apply_nonneg _ _
  refine ⟨max c (M / r ^ s), hc.trans_le (le_max_left _ _), ?_⟩
  intro ξ
  by_cases hξ : ‖ξ‖ < r
  · have hnear := he (y := ξ) (by simpa using hξ.trans_le (min_le_left ε 1))
    have hpow : ‖ξ‖ ^ N ≤ ‖ξ‖ ^ s := by
      rw [← Real.rpow_natCast]
      exact Real.rpow_le_rpow_of_exponent_ge' (norm_nonneg _)
        (hξ.le.trans (min_le_right ε 1)) hs hsN
    have hnear' : ‖g ξ‖ ≤ c * ‖ξ‖ ^ N := by
      simpa only [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (norm_nonneg _) _)] using hnear
    exact hnear'.trans (mul_le_mul (le_max_left _ _) hpow
      (pow_nonneg (norm_nonneg _) _) (hc.le.trans (le_max_left _ _)))
  · have hrpow : 0 < r ^ s := Real.rpow_pos_of_pos hr _
    have hpow : r ^ s ≤ ‖ξ‖ ^ s := Real.rpow_le_rpow hr.le (le_of_not_gt hξ) hs
    calc
      ‖g ξ‖ ≤ M := SchwartzMap.norm_le_seminorm ℝ g ξ
      _ = (M / r ^ s) * r ^ s := (div_mul_cancel₀ M hrpow.ne').symm
      _ ≤ max c (M / r ^ s) * ‖ξ‖ ^ s :=
        mul_le_mul (le_max_right _ _) hpow hrpow.le
          ((div_nonneg hM hrpow.le).trans (le_max_right _ _))

/-- The existing sharp sphere Fourier estimates in a common dimension notation. -/
theorem exists_sharp_surfaceFourier_decay {d : ℕ} (hd : 2 ≤ d) :
    ∃ C : ℝ, 0 < C ∧ ∀ ξ : Euclidean d, 1 ≤ ‖ξ‖ →
      ‖surfaceFourier d ξ‖ ≤ C / ‖ξ‖ ^ (((d : ℝ) - 1) / 2) := by
  by_cases htwo : d = 2
  · subst d
    convert exists_sharp_surfaceFourier_two_decay using 1
    norm_num
  obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : d ≠ 0)
  obtain ⟨C, _, hC, _, hb, _⟩ := exists_sharp_surfaceFourier_succ_decay_and_deriv (by omega : 2 ≤ n)
  refine ⟨C, hC, ?_⟩
  simpa only [Nat.cast_succ, add_sub_cancel_right] using hb

/-- Sharp decay as a global weighted bound, including zero frequency. -/
theorem exists_surfaceFourier_weighted_bound {d : ℕ} (hd : 2 ≤ d) :
    ∃ C : ℝ, 0 < C ∧ ∀ ξ : Euclidean d,
      ‖surfaceFourier d ξ‖ * ‖ξ‖ ^ (((d : ℝ) - 1) / 2) ≤ C := by
  obtain ⟨C, hC, hb⟩ := exists_sharp_surfaceFourier_decay hd
  refine ⟨max C (surfaceMass d), hC.trans_le (le_max_left _ _), ?_⟩
  intro ξ
  have hs : 0 ≤ ((d : ℝ) - 1) / 2 := by have := (show (2 : ℝ) ≤ d by exact_mod_cast hd); linarith
  by_cases hξ : 1 ≤ ‖ξ‖
  · have hp : 0 < ‖ξ‖ ^ (((d : ℝ) - 1) / 2) :=
      Real.rpow_pos_of_pos (lt_of_lt_of_le zero_lt_one hξ) _
    exact ((mul_le_mul_of_nonneg_right (hb ξ hξ) hp.le).trans_eq
      (div_mul_cancel₀ C hp.ne')).trans (le_max_left _ _)
  · have hp : ‖ξ‖ ^ (((d : ℝ) - 1) / 2) ≤ 1 :=
      Real.rpow_le_one (norm_nonneg _) (le_of_not_ge hξ) hs
    have hm : ‖surfaceFourier d ξ‖ ≤ surfaceMass d := norm_surfaceFourier_le_surfaceMass d ξ
    exact (mul_le_mul hm hp (Real.rpow_nonneg (norm_nonneg _) _)
      (show 0 ≤ surfaceMass d from measureReal_nonneg)).trans (by simp)

/-- Cancellation of a compact smoothing kernel and sharp sphere decay give
the uniform dyadic `L²` multiplier scale. -/
theorem exists_smoothed_surface_multiplier_bound {d N : ℕ} (hd : 2 ≤ d)
    (K : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 K ξ) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : ℕ) (t : ℝ), 1 ≤ t → ∀ ξ : Euclidean d,
      ‖surfaceFourier d (-t • ξ) * 𝓕 (compactDyadicDilate K j) ξ‖ ≤
        C / ((2 : ℝ) ^ j) ^ (((d : ℝ) - 1) / 2) := by
  let s := ((d : ℝ) - 1) / 2
  have hs : 0 ≤ s := by
    have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
    dsimp [s]
    linarith
  obtain ⟨A, hA, hkernel⟩ := schwartz_norm_le_rpow_of_flat (𝓕 K) hflat hs hN
  obtain ⟨B, hB, hsurface⟩ := exists_surfaceFourier_weighted_bound hd
  refine ⟨A * B, mul_pos hA hB, ?_⟩
  intro j t ht ξ
  have ht0 : 0 < t := by linarith
  have hscale : 0 < (2 : ℝ) ^ j := by positivity
  have hn : ‖ξ‖ ≤ ‖-t • ξ‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_neg, abs_of_pos ht0]
    nlinarith [norm_nonneg ξ]
  have hsurf : ‖surfaceFourier d (-t • ξ)‖ * ‖ξ‖ ^ s ≤ B :=
    (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (norm_nonneg _) hn hs)
      (norm_nonneg _)).trans (hsurface _)
  have hk := hkernel (((2 : ℝ) ^ j)⁻¹ • ξ)
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hscale),
    Real.mul_rpow (inv_nonneg.mpr hscale.le) (norm_nonneg _),
    Real.inv_rpow hscale.le] at hk
  rw [norm_mul, fourier_compactDyadicDilate]
  calc
    _ ≤ ‖surfaceFourier d (-t • ξ)‖ * (A * (((2 : ℝ) ^ j) ^ s)⁻¹ * ‖ξ‖ ^ s) :=
      mul_le_mul_of_nonneg_left (by simpa only [mul_assoc] using hk) (norm_nonneg _)
    _ = (A / ((2 : ℝ) ^ j) ^ s) * (‖surfaceFourier d (-t • ξ)‖ * ‖ξ‖ ^ s) := by ring
    _ ≤ (A / ((2 : ℝ) ^ j) ^ s) * B :=
      mul_le_mul_of_nonneg_left hsurf (div_nonneg hA.le (Real.rpow_nonneg hscale.le _))
    _ = _ := by ring

/-- The characteristic function of a measure supported in the unit ball has
bounded derivatives of every order, hence temperate growth. -/
theorem charFun_hasTemperateGrowth_of_unitBall {d : ℕ}
    (μ : Measure (Euclidean d)) [IsFiniteMeasure μ]
    (hbound : ∀ᵐ x ∂μ, ‖x‖ ≤ 1) : Function.HasTemperateGrowth (MeasureTheory.charFun μ) := by
  have htop : MemLp (id : Euclidean d → Euclidean d) ⊤ μ :=
    memLp_top_of_bound continuous_id.aestronglyMeasurable 1 hbound
  have hmoment (n : ℕ) : MemLp (id : Euclidean d → Euclidean d) (n : ℝ≥0∞) μ :=
    htop.mono_exponent le_top
  refine ⟨(MeasureTheory.contDiff_charFun' (n := ⊤) hmoment).of_le (by simp), ?_⟩
  intro n
  refine ⟨0, μ.real univ, ?_⟩
  intro t
  simp only [pow_zero, mul_one]
  apply ContinuousMultilinearMap.opNorm_le_bound measureReal_nonneg
  intro v
  rw [MeasureTheory.iteratedFDeriv_charFun (hmoment n), norm_mul, norm_pow,
    Complex.norm_I, one_pow, one_mul]
  have hb : ∀ᵐ y ∂μ,
      ‖(↑(∏ i, inner ℝ y (v i)) : ℂ) * Complex.exp (↑(inner ℝ y t) * Complex.I)‖ ≤
        ∏ i, ‖v i‖ := by
    filter_upwards [hbound] with y hy
    rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one, Complex.norm_real,
      Real.norm_eq_abs, Finset.abs_prod]
    apply Finset.prod_le_prod₀
    · intro i _
      exact abs_nonneg _
    · intro i _
      exact (abs_real_inner_le_norm y (v i)).trans
        (by simpa using mul_le_mul_of_nonneg_right hy (norm_nonneg (v i)))
  exact (norm_integral_le_of_norm_le_const hb).trans_eq (mul_comm _ _)

/-- The sphere multiplier and all its derivatives grow at most polynomially. -/
theorem surfaceFourier_hasTemperateGrowth (d : ℕ) :
    Function.HasTemperateGrowth (surfaceFourier d) := by
  let μ : Measure (Euclidean d) := Measure.map Subtype.val (unitSurfaceMeasure d)
  have hbound : ∀ᵐ x : Euclidean d ∂μ, ‖x‖ ≤ 1 := by
    rw [MeasureTheory.ae_map_iff continuous_subtype_val.aemeasurable
      (measurableSet_le continuous_norm.measurable measurable_const)]
    filter_upwards with ω
    have hn : ‖(ω : Euclidean d)‖ = 1 := by
      simpa only [Metric.mem_sphere, dist_zero_right] using ω.property
    exact hn.le
  have heq : surfaceFourier d = fun ξ : Euclidean d =>
      MeasureTheory.charFun μ ((-2 * Real.pi) • ξ) := by
    funext ξ
    unfold surfaceFourier MeasureTheory.charFun μ
    rw [MeasureTheory.integral_map continuous_subtype_val.aemeasurable]
    · apply MeasureTheory.integral_congr_ae
      filter_upwards with ω
      unfold surfacePhase
      rw [inner_smul_right]
    · exact (by fun_prop)
  rw [heq]
  exact (charFun_hasTemperateGrowth_of_unitBall μ hbound).comp (by fun_prop)

/-- Schwartz realization of the sphere multiplier times an arbitrary Schwartz
factor; compact frequency support is unnecessary. -/
def schwartzSurfaceMultiplier {d : ℕ} (K : SchwartzMap (Euclidean d) ℂ) (t : ℝ) :
    SchwartzMap (Euclidean d) ℂ :=
  SchwartzMap.smulLeftCLM ℂ (fun ξ => surfaceFourier d (-t • ξ)) (𝓕 K)

theorem schwartzSurfaceMultiplier_apply {d : ℕ}
    (K : SchwartzMap (Euclidean d) ℂ) (t : ℝ) (ξ : Euclidean d) :
    schwartzSurfaceMultiplier K t ξ = surfaceFourier d (-t • ξ) * 𝓕 K ξ := by
  have ht : Function.HasTemperateGrowth (fun ξ : Euclidean d => surfaceFourier d (-t • ξ)) :=
    (surfaceFourier_hasTemperateGrowth d).comp (by fun_prop)
  simp only [schwartzSurfaceMultiplier, SchwartzMap.smulLeftCLM_apply ht, smul_eq_mul]

/-- The fixed-radius smoothed spherical `L²` estimate. -/
theorem smoothed_sphericalAverage_L2_bound {d N : ℕ} (hd : 2 ≤ d)
    (K : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 K ξ) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : ℕ) (t : ℝ), 1 ≤ t →
      ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∫ x, ‖sphericalAverage d (compactConvolution (compactDyadicDilate K j) f) t x‖ ^ 2) ≤
        (C / ((2 : ℝ) ^ j) ^ (((d : ℝ) - 1) / 2)) ^ 2 * ∫ x, ‖f x‖ ^ 2 := by
  obtain ⟨C, hC, hb⟩ := exists_smoothed_surface_multiplier_bound hd K hflat hN
  refine ⟨C, hC, ?_⟩
  intro j t ht f
  let m := schwartzSurfaceMultiplier (compactDyadicDilate K j) t
  have hm (ξ : Euclidean d) : ‖m ξ‖ ≤ C / ((2 : ℝ) ^ j) ^ (((d : ℝ) - 1) / 2) := by
    rw [schwartzSurfaceMultiplier_apply]
    exact hb j t ht ξ
  have havg : sphericalAverage d (compactConvolution (compactDyadicDilate K j) f) t =
      𝓕⁻ (fun ξ => m ξ * 𝓕 f ξ) := by
    rw [Auto.Spherical.Auxiliary.sphericalAverage_eq_fourierInv_surfaceMultiplier_schwartz]
    congr 1
    funext ξ
    rw [← SchwartzMap.fourier_coe, fourier_compactConvolution]
    simp only [m, schwartzSurfaceMultiplier_apply, mul_assoc]
  rw [havg]
  have hmult := Auto.Spherical.Auxiliary.integral_norm_sq_fourierInv_schwartz_multiplier_le
    m (𝓕 f) (div_nonneg hC.le (Real.rpow_nonneg (by positivity) _)) hm
  have hpl := Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq f
  rw [SchwartzMap.fourier_coe] at hmult
  exact hmult.trans_eq (congrArg (fun z : ℝ =>
    (C / ((2 : ℝ) ^ j) ^ (((d : ℝ) - 1) / 2)) ^ 2 * z) hpl)

/-- Spherical averages preserve the Schwartz space. -/
def schwartzSphericalAverage {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ) (t : ℝ) :
    SchwartzMap (Euclidean d) ℂ := 𝓕⁻ (schwartzSurfaceMultiplier f t)

theorem schwartzSphericalAverage_apply {d : ℕ}
    (f : SchwartzMap (Euclidean d) ℂ) (t : ℝ) :
    (schwartzSphericalAverage f t : Euclidean d → ℂ) = sphericalAverage d f t := by
  rw [Auto.Spherical.Auxiliary.sphericalAverage_eq_fourierInv_surfaceMultiplier_schwartz]
  simp only [schwartzSphericalAverage, SchwartzMap.fourierInv_coe]
  congr 1
  funext ξ
  rw [schwartzSurfaceMultiplier_apply, SchwartzMap.fourier_coe]

/-- Convert a Schwartz square moment to its nonnegative integral. -/
theorem schwartz_lintegral_sq {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ) :
    (∫⁻ x, ‖f x‖ₑ ^ (2 : ℕ)) = ENNReal.ofReal (∫ x, ‖f x‖ ^ (2 : ℕ)) := by
  have hi := (f.memLp 2 volume).integrable_norm_pow (by norm_num : (2 : ℕ) ≠ 0)
  rw [ofReal_integral_eq_lintegral_ofReal hi (ae_of_all _ (fun x => sq_nonneg ‖f x‖))]
  apply lintegral_congr
  intro x
  rw [ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm]

/-- Extended-integral form of the fixed-radius `L²` estimate. -/
theorem smoothed_sphericalAverage_L2_moment_bound {d N : ℕ} (hd : 2 ≤ d)
    (K : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 K ξ) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : ℕ) (t : ℝ), 1 ≤ t →
      ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x, ‖sphericalAverage d (compactConvolution (compactDyadicDilate K j) f) t x‖ₑ ^ (2 : ℕ)) ≤
        ENNReal.ofReal ((C / ((2 : ℝ) ^ j) ^ (((d : ℝ) - 1) / 2)) ^ 2) *
          ∫⁻ x, ‖f x‖ₑ ^ (2 : ℕ) := by
  obtain ⟨C, hC, hb⟩ := smoothed_sphericalAverage_L2_bound hd K hflat hN
  refine ⟨C, hC, ?_⟩
  intro j t ht f
  rw [← schwartzSphericalAverage_apply, schwartz_lintegral_sq, schwartz_lintegral_sq,
    ← ENNReal.ofReal_mul (sq_nonneg _)]
  apply ENNReal.ofReal_le_ofReal
  simpa only [schwartzSphericalAverage_apply] using hb j t ht f

/-- Constants in the repository's rational Schwartz amplitude split. -/
def lowSplitConstant (p : ℝ) : ℝ≥0∞ :=
  ENNReal.ofReal ((1 : ℝ) / 4) * (ENNReal.ofReal p)⁻¹ + (ENNReal.ofReal (2 - p))⁻¹

def highSplitConstant (p : ℝ) : ℝ≥0∞ :=
  (ENNReal.ofReal (p - 1))⁻¹ + (ENNReal.ofReal (3 - p))⁻¹

/-- Reuse the existing rational amplitude split to interpolate arbitrary
Schwartz-sublinear operators with their two literal moment bounds. -/
theorem schwartz_one_two_moment_interpolation {d : ℕ}
    (T : SchwartzMap (Euclidean d) ℂ → Euclidean d → ℝ)
    (hTmeas : ∀ f, AEMeasurable (T f) volume)
    (hTnonneg : ∀ f x, 0 ≤ T f x)
    (hTsub : ∀ f g x, T (f + g) x ≤ T f x + T g x)
    (C₁ C₂ : ℝ≥0∞)
    (h₁ : ∀ f, (∫⁻ x, ENNReal.ofReal (T f x)) ≤ C₁ * ∫⁻ x, ‖f x‖ₑ)
    (h₂ : ∀ f, (∫⁻ x, ENNReal.ofReal ((T f x) ^ (2 : ℕ))) ≤ C₂ * ∫⁻ x, ‖f x‖ₑ ^ (2 : ℕ))
    {p : ℝ} (hp₁ : 1 < p) (hp₂ : p < 2) (s : ℝ) (hs : 0 < s)
    (f : SchwartzMap (Euclidean d) ℂ) :
    (∫⁻ x, ENNReal.ofReal ((T f x) ^ p)) ≤
      (ENNReal.ofReal p *
        (4 * C₂ * (ENNReal.ofReal s) ^ (2 - p) * lowSplitConstant p +
          2 * C₁ * (ENNReal.ofReal s) ^ (1 - p) * highSplitConstant p)) *
            ∫⁻ x, ‖f x‖ₑ ^ p := by
  have hw₁ (g : SchwartzMap (Euclidean d) ℂ) {a : ℝ} (ha : 0 < a) :
      ENNReal.ofReal a * volume {x | a < T g x} ≤ C₁ * ∫⁻ x, ENNReal.ofReal ‖g x‖ := by
    have hsub : {x | a < T g x} ⊆ {x | ENNReal.ofReal a ≤ ENNReal.ofReal (T g x)} :=
      fun x hx => ENNReal.ofReal_le_ofReal hx.le
    exact (mul_le_mul' le_rfl (measure_mono hsub)).trans
      ((mul_meas_ge_le_lintegral₀ (hTmeas g).ennreal_ofReal _).trans (by simpa using h₁ g))
  have hw₂ (g : SchwartzMap (Euclidean d) ℂ) {a : ℝ} (ha : 0 < a) :
      ENNReal.ofReal (a ^ (2 : ℕ)) * volume {x | a < T g x} ≤
        C₂ * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) := by
    have hsub : {x | a < T g x} ⊆
        {x | ENNReal.ofReal (a ^ (2 : ℕ)) ≤ ENNReal.ofReal ((T g x) ^ (2 : ℕ))} := by
      intro x hx
      change a < T g x at hx
      apply ENNReal.ofReal_le_ofReal
      nlinarith [hTnonneg g x]
    have hm := ((hTmeas g).pow_const (2 : ℕ)).ennreal_ofReal
    apply (mul_le_mul' le_rfl (measure_mono hsub)).trans
    apply (mul_meas_ge_le_lintegral₀ hm _).trans
    simpa only [ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm] using h₂ g
  obtain ⟨low, high, hlow, hhigh, hsplit⟩ :=
    Auto.Spherical.Auxiliary.exists_schwartz_rational_low_high_family f
  have hprofiles := Auto.Spherical.Auxiliary.measurable_rational_low_high_profile_lintegrals
    f low high hlow hhigh (μ := volume)
  have hlo := Auto.Spherical.Auxiliary.rational_schwartz_low_weighted_tail
    f low high hlow hhigh hp₁ hp₂
  have hhi := Auto.Spherical.Auxiliary.rational_schwartz_high_weighted_tail
    f low high hlow hhigh hp₁ hp₂
  have hinterp := Auto.Spherical.Auxiliary.marcinkiewicz_weak_one_two_on_additive_split_scaled
    (univ : Set (SchwartzMap (Euclidean d) ℂ))
    (fun g : SchwartzMap (Euclidean d) ℂ => (g : Euclidean d → ℂ)) T hTnonneg
    (by intro g h _ _; exact ae_of_all _ (hTsub g h)) C₁ C₂
    (by intro g _ a ha; exact hw₁ g ha) (by intro g _ a ha; exact hw₂ g ha)
    hp₁ hp₂ f (hTmeas f) low high (by simp) (by simp)
    (by intro t; ext x; exact hsplit t x) hprofiles.1 hprofiles.2
    (lowSplitConstant p * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p)
    (highSplitConstant p * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p) hlo hhi s hs
  apply hinterp.trans_eq
  simp only [ofReal_norm]
  ring

theorem compactConvolution_add_right {d : ℕ} (K f g : SchwartzMap (Euclidean d) ℂ) :
    compactConvolution K (f + g) = compactConvolution K f + compactConvolution K g := by
  have h : 𝓕 (compactConvolution K (f + g)) =
      𝓕 (compactConvolution K f + compactConvolution K g) := by
    ext ξ
    simp only [fourier_compactConvolution, FourierTransform.fourier_add, add_apply, mul_add]
  simpa using congrArg (fun f : SchwartzMap (Euclidean d) ℂ => 𝓕⁻ f) h

theorem schwartzSphericalAverage_add {d : ℕ}
    (f g : SchwartzMap (Euclidean d) ℂ) (t : ℝ) :
    schwartzSphericalAverage (f + g) t =
      schwartzSphericalAverage f t + schwartzSphericalAverage g t := by
  simp only [schwartzSphericalAverage, schwartzSurfaceMultiplier,
    FourierTransform.fourier_add, map_add, FourierTransform.fourierInv_add]

/-- Localizing the norm and then taking a moment is the same as restricting
the moment measure. -/
theorem indicator_norm_moment {d : ℕ} (B : Set (Euclidean d)) (hB : MeasurableSet B)
    (f : Euclidean d → ℂ) {p : ℝ} (hp : 0 < p) :
    (∫⁻ x, ENNReal.ofReal ((B.indicator (fun y => ‖f y‖) x) ^ p)) =
      ∫⁻ x in B, ‖f x‖ₑ ^ p := by
  rw [← lintegral_indicator hB]
  apply lintegral_congr
  intro x
  by_cases hx : x ∈ B
  · simp only [Set.indicator_of_mem hx]
    rw [← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp.le, ofReal_norm]
  · simp [hx, Real.zero_rpow hp.ne']

/-- The two endpoint estimates yield a localized bound at every intermediate
exponent, with the amplitude balancing parameter still explicit. -/
theorem smoothed_sphericalAverage_intermediate_bound {d N : ℕ} (hd : 2 ≤ d)
    (K : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 K ξ) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) :
    ∃ C₁ : ℝ≥0∞, ∃ C₂ : ℝ, C₁ ≠ ∞ ∧ 0 < C₂ ∧
      ∀ (j : ℕ) (t R : ℝ), 1 ≤ t → 0 < R →
      ∀ (p s : ℝ), 1 < p → p < 2 → 0 < s →
      ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) R,
        ‖sphericalAverage d (compactConvolution (compactDyadicDilate K j) f) t x‖ₑ ^ p) ≤
        (ENNReal.ofReal p *
          (4 * ENNReal.ofReal ((C₂ / ((2 : ℝ) ^ j) ^ (((d : ℝ) - 1) / 2)) ^ 2) *
              (ENNReal.ofReal s) ^ (2 - p) * lowSplitConstant p +
            2 * (C₁ * ENNReal.ofReal (R ^ (d - 1))) *
              (ENNReal.ofReal s) ^ (1 - p) * highSplitConstant p)) *
                ∫⁻ x, ‖f x‖ₑ ^ p := by
  obtain ⟨C₁, hC₁, hb₁⟩ := smoothed_sphericalAverage_smallBall_L1_bound (by omega) K
  obtain ⟨C₂, hC₂, hb₂⟩ := smoothed_sphericalAverage_L2_moment_bound hd K hflat hN
  refine ⟨C₁, C₂, hC₁, hC₂, ?_⟩
  intro j t R ht hR p s hp₁ hp₂ hs f
  let B := Metric.closedBall (0 : Euclidean d) R
  let S (g : SchwartzMap (Euclidean d) ℂ) :=
    schwartzSphericalAverage (compactConvolution (compactDyadicDilate K j) g) t
  let T (g : SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℝ :=
    B.indicator (fun x => ‖S g x‖)
  have hmeas (g) : Measurable (T g) :=
    (S g).continuous.norm.measurable.indicator measurableSet_closedBall
  have hnonneg (g x) : 0 ≤ T g x := Set.indicator_nonneg (fun _ _ => norm_nonneg _) _
  have hsub (g h : SchwartzMap (Euclidean d) ℂ) (x) : T (g + h) x ≤ T g x + T h x := by
    by_cases hx : x ∈ B
    · simp only [T, Set.indicator_of_mem hx, S, compactConvolution_add_right,
        schwartzSphericalAverage_add, add_apply]
      exact norm_add_le _ _
    · simp [T, hx]
  have h₁ (g) : (∫⁻ x, ENNReal.ofReal (T g x)) ≤
      (C₁ * ENNReal.ofReal (R ^ (d - 1))) * ∫⁻ x, ‖g x‖ₑ := by
    have he := indicator_norm_moment B measurableSet_closedBall (S g) (p := 1) zero_lt_one
    simp only [Real.rpow_one, ENNReal.rpow_one] at he
    rw [show (∫⁻ x, ENNReal.ofReal (T g x)) = _ from he]
    have h := hb₁ j t R ht hR g g.continuous
    rw [smoothInput_eq_compactConvolution] at h
    simpa only [S, schwartzSphericalAverage_apply] using h
  have h₂ (g) : (∫⁻ x, ENNReal.ofReal ((T g x) ^ (2 : ℕ))) ≤
      ENNReal.ofReal ((C₂ / ((2 : ℝ) ^ j) ^ (((d : ℝ) - 1) / 2)) ^ 2) *
        ∫⁻ x, ‖g x‖ₑ ^ (2 : ℕ) := by
    apply (lintegral_mono (g := fun x => ‖S g x‖ₑ ^ (2 : ℕ)) ?_).trans
    · simpa only [S, schwartzSphericalAverage_apply] using hb₂ j t ht g
    · intro x
      by_cases hx : x ∈ B
      · simp only [T, Set.indicator_of_mem hx, ENNReal.ofReal_pow (norm_nonneg _),
          ofReal_norm, le_refl]
      · simp [T, hx]
  have hi := schwartz_one_two_moment_interpolation T (fun g => (hmeas g).aemeasurable)
    hnonneg hsub (C₁ * ENNReal.ofReal (R ^ (d - 1)))
    (ENNReal.ofReal ((C₂ / ((2 : ℝ) ^ j) ^ (((d : ℝ) - 1) / 2)) ^ 2)) h₁ h₂ hp₁ hp₂ s hs f
  rw [indicator_norm_moment B measurableSet_closedBall (S f) (by linarith)] at hi
  simpa only [S, schwartzSphericalAverage_apply] using hi

/-- Algebraic normalization of the square-endpoint dyadic factor. -/
theorem dyadic_square_multiplier_factor (C : ℝ) (d j : ℕ) :
    ENNReal.ofReal ((C / ((2 : ℝ) ^ j) ^ (((d : ℝ) - 1) / 2)) ^ 2) =
      ENNReal.ofReal (C ^ 2) * (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1))) := by
  have hden : (((2 : ℝ) ^ j) ^ (((d : ℝ) - 1) / 2)) ^ (2 : ℕ) =
      (2 : ℝ) ^ ((j : ℝ) * ((d : ℝ) - 1)) := by
    simp only [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
    congr 1
    ring
  rw [div_pow, hden, div_eq_mul_inv, ← Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2),
    ENNReal.ofReal_mul (sq_nonneg _),
    ← ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 2)]
  norm_num

/-- The two endpoint terms have the same decay at the optimal amplitude scale. -/
theorem dyadic_interpolation_balance (d j k : ℕ) (p : ℝ) :
    ((2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1))) *
      ((2 : ℝ≥0∞) ^ (((j : ℝ) - k) * ((d : ℝ) - 1))) ^ (2 - p) =
      (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
        (k : ℝ) * ((d : ℝ) - 1) * (2 - p))) ∧
    ((2 : ℝ≥0∞) ^ (-((k : ℝ) * ((d : ℝ) - 1))) *
      ((2 : ℝ≥0∞) ^ (((j : ℝ) - k) * ((d : ℝ) - 1))) ^ (1 - p) =
      (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
        (k : ℝ) * ((d : ℝ) - 1) * (2 - p))) := by
  constructor <;> rw [← ENNReal.rpow_mul,
    ← ENNReal.rpow_add _ _ (by norm_num : (2 : ℝ≥0∞) ≠ 0) (by norm_num : (2 : ℝ≥0∞) ≠ ∞)] <;>
    congr 1 <;> ring

theorem lowSplitConstant_ne_top {p : ℝ} (hp₁ : 1 < p) (hp₂ : p < 2) :
    lowSplitConstant p ≠ ∞ := by
  apply ENNReal.add_ne_top.mpr
  exact ⟨ENNReal.mul_ne_top ENNReal.ofReal_ne_top
    (ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr (by linarith))),
    ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr (by linarith))⟩

theorem highSplitConstant_ne_top {p : ℝ} (hp₁ : 1 < p) (hp₂ : p < 2) :
    highSplitConstant p ≠ ∞ := by
  apply ENNReal.add_ne_top.mpr
  exact ⟨ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr (by linarith)),
    ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr (by linarith))⟩

/-- The source's localized fixed-radius decay, before the finite sum over
radius-cover representatives. This is the nonendpoint interpolation range. -/
theorem smoothed_sphericalAverage_dyadic_Lp_bound {d N : ℕ} (hd : 2 ≤ d)
    (K : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 K ξ) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) {p : ℝ} (hp₁ : 1 < p) (hp₂ : p < 2) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (j k : ℕ) (t : ℝ), 1 ≤ t →
      ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) (((2 : ℝ) ^ k)⁻¹),
        ‖sphericalAverage d (compactConvolution (compactDyadicDilate K j) f) t x‖ₑ ^ p) ≤
          A * (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
            (k : ℝ) * ((d : ℝ) - 1) * (2 - p)) * ∫⁻ x, ‖f x‖ₑ ^ p := by
  obtain ⟨C₁, C₂, hC₁, hC₂, hb⟩ := smoothed_sphericalAverage_intermediate_bound hd K hflat hN
  let A := ENNReal.ofReal p * (4 * ENNReal.ofReal (C₂ ^ 2) * lowSplitConstant p +
    2 * C₁ * highSplitConstant p)
  have hA : A ≠ ∞ := ENNReal.mul_ne_top ENNReal.ofReal_ne_top
    (ENNReal.add_ne_top.mpr ⟨ENNReal.mul_ne_top
      (ENNReal.mul_ne_top (by norm_num) ENNReal.ofReal_ne_top) (lowSplitConstant_ne_top hp₁ hp₂),
      ENNReal.mul_ne_top (ENNReal.mul_ne_top (by norm_num) hC₁) (highSplitConstant_ne_top hp₁ hp₂)⟩)
  refine ⟨A, hA, ?_⟩
  intro j k t ht f
  let s : ℝ := (2 : ℝ) ^ (((j : ℝ) - k) * ((d : ℝ) - 1))
  have hs : 0 < s := Real.rpow_pos_of_pos (by norm_num) _
  have hi := hb j t (((2 : ℝ) ^ k)⁻¹) ht (by positivity) p s hp₁ hp₂ hs f
  have hs' : ENNReal.ofReal s = (2 : ℝ≥0∞) ^ (((j : ℝ) - k) * ((d : ℝ) - 1)) := by
    dsimp only [s]
    rw [← ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 2)]
    norm_num
  have hR : ENNReal.ofReal ((((2 : ℝ) ^ k)⁻¹) ^ (d - 1)) =
      (2 : ℝ≥0∞) ^ (-((k : ℝ) * ((d : ℝ) - 1))) := by
    have he : (((2 : ℝ) ^ k)⁻¹) ^ (d - 1) = (2 : ℝ) ^ (-((k : ℝ) * ((d : ℝ) - 1))) := by
      rw [inv_pow, ← pow_mul, ← Real.rpow_natCast,
        ← Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2)]
      congr 1
      rw [Nat.cast_mul, Nat.cast_sub (by omega : 1 ≤ d), Nat.cast_one]
    rw [he, ← ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 2)]
    norm_num
  rw [dyadic_square_multiplier_factor, hs', hR] at hi
  apply hi.trans_eq
  have hbalance := dyadic_interpolation_balance d j k p
  have hcoeff :
      ENNReal.ofReal p *
        (4 * (ENNReal.ofReal (C₂ ^ 2) * (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1)))) *
            ((2 : ℝ≥0∞) ^ (((j : ℝ) - k) * ((d : ℝ) - 1))) ^ (2 - p) * lowSplitConstant p +
          2 * (C₁ * (2 : ℝ≥0∞) ^ (-((k : ℝ) * ((d : ℝ) - 1)))) *
            ((2 : ℝ≥0∞) ^ (((j : ℝ) - k) * ((d : ℝ) - 1))) ^ (1 - p) * highSplitConstant p) =
        A * (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
          (k : ℝ) * ((d : ℝ) - 1) * (2 - p)) := by
    calc
      _ = ENNReal.ofReal p *
          ((4 * ENNReal.ofReal (C₂ ^ 2) * lowSplitConstant p) *
            ((2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1))) *
              ((2 : ℝ≥0∞) ^ (((j : ℝ) - k) * ((d : ℝ) - 1))) ^ (2 - p)) +
           (2 * C₁ * highSplitConstant p) *
            ((2 : ℝ≥0∞) ^ (-((k : ℝ) * ((d : ℝ) - 1))) *
              ((2 : ℝ≥0∞) ^ (((j : ℝ) - k) * ((d : ℝ) - 1))) ^ (1 - p))) := by ring
      _ = _ := by rw [hbalance.1, hbalance.2]; dsimp [A]; ring
  rw [hcoeff]

/-- Fixed-radius estimate for the actual positive-scale synthesis kernels. -/
theorem synthesis_fixedRadius_Lp_bound {d N : ℕ} (hd : 2 ≤ d)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) {p : ℝ} (hp₁ : 1 < p) (hp₂ : p < 2) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (j k : ℕ), 0 < j → ∀ (t : ℝ), 1 ≤ t →
      ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) (((2 : ℝ) ^ k)⁻¹),
        ‖sphericalAverage d (compactConvolution (compactSynthesisKernel φ j) f) t x‖ₑ ^ p) ≤
          A * (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
            (k : ℝ) * ((d : ℝ) - 1) * (2 - p)) * ∫⁻ x, ‖f x‖ₑ ^ p := by
  obtain ⟨A, hA, hb⟩ := smoothed_sphericalAverage_dyadic_Lp_bound hd
    (compactSynthesisKernel φ 1) (compactSynthesisKernel_fourier_isBigO φ hflat 0) hN hp₁ hp₂
  refine ⟨A * (2 : ℝ≥0∞) ^ (((d : ℝ) - 1) * (p - 1)),
    ENNReal.mul_ne_top hA (ENNReal.rpow_ne_top_of_nonneg
      (by
        have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
        exact mul_nonneg (by linarith) (by linarith)) (by norm_num)), ?_⟩
  intro j k hj t ht f
  obtain ⟨i, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hj)
  rw [compactSynthesisKernel_succ]
  apply (hb i k t ht f).trans_eq
  have he :
      (2 : ℝ≥0∞) ^ (-((i : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
        (k : ℝ) * ((d : ℝ) - 1) * (2 - p)) =
      (2 : ℝ≥0∞) ^ (((d : ℝ) - 1) * (p - 1)) *
        (2 : ℝ≥0∞) ^ (-((i.succ : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
          (k : ℝ) * ((d : ℝ) - 1) * (2 - p)) := by
    rw [← ENNReal.rpow_add _ _ (by norm_num : (2 : ℝ≥0∞) ≠ 0)
      (by norm_num : (2 : ℝ≥0∞) ≠ ∞), Nat.cast_succ]
    congr 1
    ring
  rw [he]
  simp only [mul_assoc]

/-- Finite representative-radius version of the source estimate `eq:jkmu-1`.
The spatial ball bound also bounds its dyadic subannulus. -/
theorem synthesis_finiteRadius_Lp_bound {d N : ℕ} (hd : 2 ≤ d)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) {p : ℝ} (hp₁ : 1 < p) (hp₂ : p < 2) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (j k : ℕ), 0 < j →
      ∀ (I : Finset ℝ), (∀ t ∈ I, 1 ≤ t) → ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∑ t ∈ I, ∫⁻ x in Metric.closedBall (0 : Euclidean d) (((2 : ℝ) ^ k)⁻¹),
        ‖sphericalAverage d (compactConvolution (compactSynthesisKernel φ j) f) t x‖ₑ ^ p) ≤
          A * I.card * (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
            (k : ℝ) * ((d : ℝ) - 1) * (2 - p)) * ∫⁻ x, ‖f x‖ₑ ^ p := by
  obtain ⟨A, hA, hb⟩ := synthesis_fixedRadius_Lp_bound hd φ hflat hN hp₁ hp₂
  refine ⟨A, hA, ?_⟩
  intro j k hj I hI f
  apply (Finset.sum_le_sum (fun t ht => hb j k hj t (hI t ht) f)).trans_eq
  rw [Finset.sum_const, nsmul_eq_mul]
  ring

/-- Radius derivative of the literal spherical average. -/
def sphericalRadiusDerivative {d : ℕ} (f : Euclidean d → ℂ) (t : ℝ) (x : Euclidean d) : ℂ :=
  deriv (fun r => sphericalAverage d f r x) t

theorem sphericalRadiusDerivative_eq {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ)
    (t : ℝ) (x : Euclidean d) :
    sphericalRadiusDerivative f t x = ∫ ω : Metric.sphere (0 : Euclidean d) 1,
      fderiv ℝ (f : Euclidean d → ℂ) (x + t • (ω : Euclidean d)) (ω : Euclidean d)
        ∂unitSurfaceMeasure d := by
  let D := (SchwartzMap.fderivCLM ℂ (Euclidean d) ℂ) f
  have hb (y : Euclidean d) : ‖fderiv ℝ (f : Euclidean d → ℂ) y‖ ≤
      SchwartzMap.seminorm ℝ 0 0 D := by
    rw [← SchwartzMap.fderivCLM_apply ℂ f y]
    exact SchwartzMap.norm_le_seminorm ℝ D y
  exact (Auto.Spherical.SphericalMaximalL2.hasDerivAt_sphericalAverage f
    (by simpa using f.smooth (1 : ℕ∞)) hb x t).deriv

/-- Spatial localization gives the same cap gain for a radius derivative,
with the input gradient replacing the input. -/
theorem sphericalRadiusDerivative_smallBall_L1_bound {d : ℕ} (hd : 0 < d) :
    ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ (t R : ℝ), 1 ≤ t → 0 < R →
      ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) R, ‖sphericalRadiusDerivative f t x‖ₑ) ≤
        C * ENNReal.ofReal (R ^ (d - 1)) *
          ∫⁻ y, ‖fderiv ℝ (f : Euclidean d → ℂ) y‖ₑ := by
  obtain ⟨C, hC, hb⟩ := sphere_smallBall_incidence_bound hd
  refine ⟨C, hC, ?_⟩
  intro t R ht hR f
  have hf : Measurable (fun y => ‖fderiv ℝ (f : Euclidean d → ℂ) y‖ₑ) :=
    (f.smooth (1 : ℕ∞)).continuous_fderiv (by norm_num) |>.measurable.enorm
  calc
    _ ≤ ∫⁻ x in Metric.closedBall (0 : Euclidean d) R,
        (∫⁻ ω : Metric.sphere (0 : Euclidean d) 1,
          ‖fderiv ℝ (f : Euclidean d → ℂ) (x + t • (ω : Euclidean d))‖ₑ
            ∂unitSurfaceMeasure d) := by
      apply lintegral_mono
      intro x
      dsimp only
      rw [sphericalRadiusDerivative_eq f t x]
      apply (enorm_integral_le_lintegral_enorm _).trans
      apply lintegral_mono
      intro ω
      dsimp only
      rw [← ofReal_norm, ← ofReal_norm]
      apply ENNReal.ofReal_le_ofReal
      have hn : ‖(ω : Euclidean d)‖ = 1 := by simp
      simpa only [hn, mul_one] using
        (fderiv ℝ (f : Euclidean d → ℂ) (x + t • (ω : Euclidean d))).le_opNorm ω
    _ = _ := sphere_translate_ball_identity hf t R
    _ ≤ ∫⁻ y, ‖fderiv ℝ (f : Euclidean d → ℂ) y‖ₑ *
        (C * ENNReal.ofReal (R ^ (d - 1))) :=
      lintegral_mono (fun y => mul_le_mul' le_rfl (hb t R ht hR y))
    _ = _ := by rw [lintegral_mul_const _ hf, mul_comm]

/-- The existing differentiated-convolution estimate in the compact-kernel notation. -/
theorem integral_norm_fderiv_compactDyadicConvolution_le {d : ℕ}
    (K f : SchwartzMap (Euclidean d) ℂ) (j : ℕ) :
    (∫ x, ‖fderiv ℝ (compactConvolution (compactDyadicDilate K j) f : Euclidean d → ℂ) x‖) ≤
      (2 : ℝ) ^ j * (∫ x, ‖f x‖) * ∫ x, ‖fderiv ℝ (K : Euclidean d → ℂ) x‖ := by
  have hi := Auto.Spherical.Auxiliary.integral_norm_fderiv_fourierInv_scaled_schwartz_multiplier_le
    (𝓕 K) f (R := (2 : ℝ) ^ j) (by positivity)
  have he : (fun y => 𝓕⁻ (fun ξ : Euclidean d =>
      𝓕 K (((2 : ℝ) ^ j)⁻¹ • ξ) * 𝓕 (f : Euclidean d → ℂ) ξ) y) =
      (compactConvolution (compactDyadicDilate K j) f : Euclidean d → ℂ) := by
    have hsymbol : (fun ξ : Euclidean d =>
        𝓕 K (((2 : ℝ) ^ j)⁻¹ • ξ) * 𝓕 (f : Euclidean d → ℂ) ξ) =
        ((𝓕 (compactConvolution (compactDyadicDilate K j) f) :
          SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) := by
      funext ξ
      simp only [fourier_compactConvolution, fourier_compactDyadicDilate, SchwartzMap.fourier_coe]
    rw [hsymbol, ← SchwartzMap.fourierInv_coe, FourierTransform.fourierInv_fourier_eq]
  rw [he, FourierTransform.fourierInv_fourier_eq] at hi
  exact hi

theorem integrable_fderiv_schwartz {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ) :
    Integrable (fderiv ℝ (f : Euclidean d → ℂ)) volume := by
  have he : (fun x => ((SchwartzMap.fderivCLM ℂ (Euclidean d) ℂ) f) x) =
      fderiv ℝ (f : Euclidean d → ℂ) := by
    funext x
    exact SchwartzMap.fderivCLM_apply ℂ f x
  rw [← he]
  exact ((SchwartzMap.fderivCLM ℂ (Euclidean d) ℂ) f).integrable

/-- Localized radius-derivative `L¹` bound, with precisely one dyadic power
lost to differentiation. -/
theorem smoothed_sphericalRadiusDerivative_smallBall_L1_bound {d : ℕ} (hd : 0 < d)
    (K : SchwartzMap (Euclidean d) ℂ) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (j : ℕ) (t R : ℝ), 1 ≤ t → 0 < R →
      ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) R,
        ‖sphericalRadiusDerivative (compactConvolution (compactDyadicDilate K j) f) t x‖ₑ) ≤
          A * ENNReal.ofReal ((2 : ℝ) ^ j) * ENNReal.ofReal (R ^ (d - 1)) *
            ∫⁻ y, ‖f y‖ₑ := by
  obtain ⟨C, hC, hb⟩ := sphericalRadiusDerivative_smallBall_L1_bound hd
  let D := ENNReal.ofReal (∫ y, ‖fderiv ℝ (K : Euclidean d → ℂ) y‖)
  refine ⟨C * D, ENNReal.mul_ne_top hC ENNReal.ofReal_ne_top, ?_⟩
  intro j t R ht hR f
  apply (hb t R ht hR (compactConvolution (compactDyadicDilate K j) f)).trans
  have hg := integrable_fderiv_schwartz (compactConvolution (compactDyadicDilate K j) f)
  have hi := ENNReal.ofReal_le_ofReal (integral_norm_fderiv_compactDyadicConvolution_le K f j)
  rw [ofReal_integral_norm_eq_lintegral_enorm hg,
    ENNReal.ofReal_mul (mul_nonneg (by positivity) (integral_nonneg (fun _ => norm_nonneg _))),
    ENNReal.ofReal_mul (by positivity), ofReal_integral_norm_eq_lintegral_enorm f.integrable] at hi
  calc
    _ ≤ (C * ENNReal.ofReal (R ^ (d - 1))) *
        (ENNReal.ofReal ((2 : ℝ) ^ j) * (∫⁻ x, ‖f x‖ₑ) * D) := mul_le_mul' le_rfl hi
    _ = _ := by ring

/-- A Schwartz bound for slightly negative powers, needed for the planar
radius derivative. The zero point is excluded here. -/
theorem schwartz_norm_le_rpow_of_flat_ne_zero {d N : ℕ}
    (g : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => g ξ) (fun ξ => ‖ξ‖ ^ N))
    {s : ℝ} (hs : -1 ≤ s) (hsN : s ≤ N) :
    ∃ C : ℝ, 0 < C ∧ ∀ ξ, ξ ≠ 0 → ‖g ξ‖ ≤ C * ‖ξ‖ ^ s := by
  by_cases hs0 : 0 ≤ s
  · obtain ⟨C, hC, hb⟩ := schwartz_norm_le_rpow_of_flat g hflat hs0 hsN
    exact ⟨C, hC, fun ξ _ => hb ξ⟩
  let M₀ := SchwartzMap.seminorm ℝ 0 0 g
  let M₁ := SchwartzMap.seminorm ℝ 1 0 g
  have hM₀ : 0 ≤ M₀ := apply_nonneg _ _
  have hM₁ : 0 ≤ M₁ := apply_nonneg _ _
  refine ⟨M₀ + M₁ + 1, by linarith, ?_⟩
  intro ξ hξ
  have hn : 0 < ‖ξ‖ := norm_pos_iff.mpr hξ
  by_cases hn1 : ‖ξ‖ ≤ 1
  · have hp := Real.one_le_rpow_of_pos_of_le_one_of_nonpos hn hn1 (le_of_not_ge hs0)
    calc
      ‖g ξ‖ ≤ M₀ := SchwartzMap.norm_le_seminorm ℝ g ξ
      _ ≤ (M₀ + M₁ + 1) * ‖ξ‖ ^ s := by nlinarith
  · have hp : ‖ξ‖⁻¹ ≤ ‖ξ‖ ^ s := by
      rw [← Real.rpow_neg_one]
      exact Real.rpow_le_rpow_of_exponent_le (le_of_not_ge hn1) hs
    have hb : ‖g ξ‖ ≤ M₁ / ‖ξ‖ := by
      apply (le_div_iff₀ hn).mpr
      have h := SchwartzMap.norm_pow_mul_le_seminorm ℝ g 1 ξ
      simpa only [pow_one, mul_comm] using h
    calc
      ‖g ξ‖ ≤ M₁ / ‖ξ‖ := hb
      _ ≤ (M₀ + M₁ + 1) * ‖ξ‖ ^ s := by
        rw [div_eq_mul_inv]
        exact mul_le_mul (by linarith) hp (inv_nonneg.mpr hn.le) (by linarith)

/-- Concrete Fourier symbol of radius differentiation. -/
def surfaceRadiusSymbol (d : ℕ) (t : ℝ) (ξ : Euclidean d) : ℂ :=
  fderiv ℝ (surfaceFourier d) (t • (-ξ)) (-ξ)

theorem surfaceRadiusSymbol_eq_deriv (d : ℕ) (t : ℝ) (ξ : Euclidean d) :
    surfaceRadiusSymbol d t ξ = deriv (fun r : ℝ => surfaceFourier d (r • (-ξ))) t := by
  have hsurf : HasFDerivAt (surfaceFourier d)
      (fderiv ℝ (surfaceFourier d) (t • (-ξ))) (t • (-ξ)) :=
    ((contDiff_surfaceFourier d).differentiable (by simp)).differentiableAt.hasFDerivAt
  have hlin : HasDerivAt (fun r : ℝ => r • (-ξ)) (-ξ) t := by
    simpa only [id_eq, one_smul] using (hasDerivAt_id t).smul_const (-ξ)
  simpa only [surfaceRadiusSymbol, Function.comp_def] using
    (hsurf.comp_hasDerivAt t hlin).deriv.symm

theorem surfaceRadiusSymbol_hasTemperateGrowth (d : ℕ) (t : ℝ) :
    Function.HasTemperateGrowth (surfaceRadiusSymbol d t) := by
  have hg := surfaceFourier_hasTemperateGrowth d
  have hd : Function.HasTemperateGrowth (fderiv ℝ (surfaceFourier d)) := by
    refine ⟨hg.1.fderiv_right (by simp), ?_⟩
    intro n
    obtain ⟨k, C, hb⟩ := hg.2 (n + 1)
    exact ⟨k, C, fun x => by simpa only [norm_iteratedFDeriv_fderiv] using hb x⟩
  have hv : Function.HasTemperateGrowth (fun ξ : Euclidean d => -ξ) := by fun_prop
  have ha : Function.HasTemperateGrowth (fun ξ : Euclidean d => t • (-ξ)) := by fun_prop
  exact (ContinuousLinearMap.apply ℝ ℂ).bilinear_hasTemperateGrowth hv (hd.comp ha)

theorem exists_sharp_surfaceRadiusSymbol_decay {d : ℕ} (hd : 2 ≤ d) :
    ∃ C : ℝ, 0 < C ∧ ∀ (t : ℝ), t ∈ Icc 1 2 → ∀ ξ : Euclidean d, 1 ≤ ‖ξ‖ →
      ‖surfaceRadiusSymbol d t ξ‖ ≤ C / ‖ξ‖ ^ (((d : ℝ) - 1) / 2 - 1) := by
  have hsharp : ∃ C : ℝ, 0 < C ∧ ∀ ξ : Euclidean d, ∀ t : ℝ,
      1 ≤ ‖ξ‖ → t ∈ Icc 1 2 →
        ‖deriv (fun r : ℝ => surfaceFourier d (r • ξ)) t‖ ≤
          C / ‖ξ‖ ^ (((d : ℝ) - 1) / 2 - 1) := by
    by_cases htwo : d = 2
    · subst d
      convert exists_sharp_surfaceFourier_two_deriv using 1
      norm_num
    obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : d ≠ 0)
    obtain ⟨_, C, _, hC, _, hb⟩ := exists_sharp_surfaceFourier_succ_decay_and_deriv
      (by omega : 2 ≤ n)
    exact ⟨C, hC, by simpa only [Nat.cast_succ, add_sub_cancel_right] using hb⟩
  obtain ⟨C, hC, hb⟩ := hsharp
  refine ⟨C, hC, ?_⟩
  intro t ht ξ hξ
  rw [surfaceRadiusSymbol_eq_deriv]
  simpa only [norm_neg] using hb (-ξ) t (by simpa using hξ) ht

/-- Uniform weighted bound for the radius symbol, both below and above unit frequency. -/
theorem exists_surfaceRadiusSymbol_weighted_bound {d : ℕ} (hd : 2 ≤ d) :
    ∃ C : ℝ, 0 < C ∧ ∀ (t : ℝ), t ∈ Icc 1 2 → ∀ ξ : Euclidean d, ξ ≠ 0 →
      ‖surfaceRadiusSymbol d t ξ‖ * ‖ξ‖ ^ (((d : ℝ) - 1) / 2 - 1) ≤ C := by
  obtain ⟨C, hC, hb⟩ := exists_sharp_surfaceRadiusSymbol_decay hd
  have hc : Continuous (fderiv ℝ (surfaceFourier d)) :=
    (contDiff_surfaceFourier d).continuous_fderiv (by simp)
  obtain ⟨M, hM⟩ := (isCompact_closedBall (0 : Euclidean d) 2).exists_bound_of_continuousOn
    hc.continuousOn
  refine ⟨max C (max M 0), hC.trans_le (le_max_left _ _), ?_⟩
  intro t ht ξ hξ
  have hn : 0 < ‖ξ‖ := norm_pos_iff.mpr hξ
  have hs : 0 ≤ ((d : ℝ) - 1) / 2 := by
    have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
    linarith
  by_cases hn1 : 1 ≤ ‖ξ‖
  · have hp := Real.rpow_pos_of_pos hn (((d : ℝ) - 1) / 2 - 1)
    exact ((mul_le_mul_of_nonneg_right (hb t ht ξ hn1) hp.le).trans_eq
      (div_mul_cancel₀ C hp.ne')).trans (le_max_left _ _)
  · have hnle : ‖ξ‖ ≤ 1 := le_of_not_ge hn1
    have harg : t • (-ξ) ∈ Metric.closedBall (0 : Euclidean d) 2 := by
      simp only [Metric.mem_closedBall, dist_zero_right, norm_smul, norm_neg, Real.norm_eq_abs,
        abs_of_nonneg (by linarith [ht.1] : 0 ≤ t)]
      nlinarith [ht.1, ht.2]
    have hnorm : ‖surfaceRadiusSymbol d t ξ‖ ≤ max M 0 * ‖ξ‖ := by
      apply ((fderiv ℝ (surfaceFourier d) (t • (-ξ))).le_opNorm (-ξ)).trans
      simpa only [norm_neg] using mul_le_mul_of_nonneg_right
        ((hM _ harg).trans (le_max_left _ _)) hn.le
    have he : ‖ξ‖ * ‖ξ‖ ^ (((d : ℝ) - 1) / 2 - 1) = ‖ξ‖ ^ (((d : ℝ) - 1) / 2) := by
      nth_rw 1 [← Real.rpow_one ‖ξ‖]
      rw [← Real.rpow_add hn]
      congr 1
      ring
    calc
      _ ≤ max M 0 * (‖ξ‖ * ‖ξ‖ ^ (((d : ℝ) - 1) / 2 - 1)) := by
        simpa only [mul_assoc] using mul_le_mul_of_nonneg_right hnorm
          (Real.rpow_nonneg hn.le _)
      _ ≤ max M 0 := by
        rw [he]
        exact (mul_le_mul_of_nonneg_left (Real.rpow_le_one hn.le hnle hs)
          (le_max_right M 0)).trans_eq (mul_one _)
      _ ≤ _ := le_max_right _ _

/-- The radius derivative loses one power of the dyadic frequency scale. -/
theorem exists_smoothed_surfaceRadius_multiplier_bound {d N : ℕ} (hd : 2 ≤ d)
    (K : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 K ξ) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : ℕ) (t : ℝ), t ∈ Icc 1 2 → ∀ ξ : Euclidean d,
      ‖surfaceRadiusSymbol d t ξ * 𝓕 (compactDyadicDilate K j) ξ‖ ≤
        C / ((2 : ℝ) ^ j) ^ (((d : ℝ) - 1) / 2 - 1) := by
  let s := ((d : ℝ) - 1) / 2 - 1
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hs : -1 ≤ s := by dsimp [s]; linarith
  have hsN : s ≤ N := by dsimp [s]; linarith
  obtain ⟨A, hA, hkernel⟩ := schwartz_norm_le_rpow_of_flat_ne_zero (𝓕 K) hflat hs hsN
  obtain ⟨B, hB, hsurface⟩ := exists_surfaceRadiusSymbol_weighted_bound hd
  refine ⟨A * B, mul_pos hA hB, ?_⟩
  intro j t ht ξ
  have hscale : 0 < (2 : ℝ) ^ j := by positivity
  by_cases hξ : ξ = 0
  · subst ξ
    simp only [surfaceRadiusSymbol, neg_zero, smul_zero, map_zero, zero_mul, norm_zero]
    positivity
  have hk := hkernel (((2 : ℝ) ^ j)⁻¹ • ξ)
    (smul_ne_zero (inv_ne_zero hscale.ne') hξ)
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hscale),
    Real.mul_rpow (inv_nonneg.mpr hscale.le) (norm_nonneg _), Real.inv_rpow hscale.le] at hk
  rw [norm_mul, fourier_compactDyadicDilate]
  calc
    _ ≤ ‖surfaceRadiusSymbol d t ξ‖ * (A * (((2 : ℝ) ^ j) ^ s)⁻¹ * ‖ξ‖ ^ s) :=
      mul_le_mul_of_nonneg_left (by simpa only [mul_assoc] using hk) (norm_nonneg _)
    _ = (A / ((2 : ℝ) ^ j) ^ s) * (‖surfaceRadiusSymbol d t ξ‖ * ‖ξ‖ ^ s) := by ring
    _ ≤ (A / ((2 : ℝ) ^ j) ^ s) * B :=
      mul_le_mul_of_nonneg_left (hsurface t ht ξ hξ)
        (div_nonneg hA.le (Real.rpow_nonneg hscale.le _))
    _ = _ := by ring

/-- Schwartz multiplier for a smoothed radius derivative. -/
def schwartzRadiusMultiplier {d : ℕ} (K : SchwartzMap (Euclidean d) ℂ) (t : ℝ) :
    SchwartzMap (Euclidean d) ℂ :=
  SchwartzMap.smulLeftCLM ℂ (surfaceRadiusSymbol d t) (𝓕 K)

theorem schwartzRadiusMultiplier_apply {d : ℕ}
    (K : SchwartzMap (Euclidean d) ℂ) (t : ℝ) (ξ : Euclidean d) :
    schwartzRadiusMultiplier K t ξ = surfaceRadiusSymbol d t ξ * 𝓕 K ξ := by
  simp only [schwartzRadiusMultiplier,
    SchwartzMap.smulLeftCLM_apply (surfaceRadiusSymbol_hasTemperateGrowth d t), smul_eq_mul]

/-- The radius derivative of a Schwartz input is again Schwartz. -/
def schwartzSphericalRadiusDerivative {d : ℕ}
    (f : SchwartzMap (Euclidean d) ℂ) (t : ℝ) : SchwartzMap (Euclidean d) ℂ :=
  𝓕⁻ (schwartzRadiusMultiplier f t)

theorem schwartzSphericalRadiusDerivative_apply {d : ℕ}
    (f : SchwartzMap (Euclidean d) ℂ) (t : ℝ) :
    (schwartzSphericalRadiusDerivative f t : Euclidean d → ℂ) = sphericalRadiusDerivative f t := by
  funext x
  rw [sphericalRadiusDerivative_eq]
  have hi := Auto.Spherical.SphericalMaximalL2.sphericalAverage_radiusDerivative_fourierInv_schwartz
    (𝓕 f) t x
  rw [FourierTransform.fourierInv_fourier_eq] at hi
  rw [hi]
  simp only [schwartzSphericalRadiusDerivative, SchwartzMap.fourierInv_coe]
  have he : (schwartzRadiusMultiplier f t : Euclidean d → ℂ) =
      fun ξ => deriv (fun r : ℝ => surfaceFourier d (r • (-ξ))) t * 𝓕 f ξ := by
    funext ξ
    rw [schwartzRadiusMultiplier_apply, surfaceRadiusSymbol_eq_deriv]
  rw [he]

/-- Plancherel bound for the smoothed radius derivative. -/
theorem smoothed_sphericalRadiusDerivative_L2_bound {d N : ℕ} (hd : 2 ≤ d)
    (K : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 K ξ) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : ℕ) (t : ℝ), t ∈ Icc 1 2 →
      ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∫ x, ‖sphericalRadiusDerivative (compactConvolution (compactDyadicDilate K j) f) t x‖ ^ 2) ≤
        (C / ((2 : ℝ) ^ j) ^ (((d : ℝ) - 1) / 2 - 1)) ^ 2 * ∫ x, ‖f x‖ ^ 2 := by
  obtain ⟨C, hC, hb⟩ := exists_smoothed_surfaceRadius_multiplier_bound hd K hflat hN
  refine ⟨C, hC, ?_⟩
  intro j t ht f
  let m := schwartzRadiusMultiplier (compactDyadicDilate K j) t
  have hm (ξ : Euclidean d) :
      ‖m ξ‖ ≤ C / ((2 : ℝ) ^ j) ^ (((d : ℝ) - 1) / 2 - 1) := by
    rw [schwartzRadiusMultiplier_apply]
    exact hb j t ht ξ
  have he : sphericalRadiusDerivative (compactConvolution (compactDyadicDilate K j) f) t =
      𝓕⁻ (fun ξ => m ξ * 𝓕 f ξ) := by
    rw [← schwartzSphericalRadiusDerivative_apply]
    simp only [schwartzSphericalRadiusDerivative, SchwartzMap.fourierInv_coe]
    congr 1
    funext ξ
    simp only [schwartzRadiusMultiplier_apply, fourier_compactConvolution, m, mul_assoc]
  rw [he]
  have hmult := Auto.Spherical.Auxiliary.integral_norm_sq_fourierInv_schwartz_multiplier_le
    m (𝓕 f) (div_nonneg hC.le (Real.rpow_nonneg (by positivity) _)) hm
  rw [SchwartzMap.fourier_coe] at hmult
  exact hmult.trans_eq (congrArg (fun z : ℝ =>
    (C / ((2 : ℝ) ^ j) ^ (((d : ℝ) - 1) / 2 - 1)) ^ 2 * z)
      (Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq f))

/-- Extended-integral form of the radius derivative `L²` estimate. -/
theorem smoothed_sphericalRadiusDerivative_L2_moment_bound {d N : ℕ} (hd : 2 ≤ d)
    (K : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 K ξ) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : ℕ) (t : ℝ), t ∈ Icc 1 2 →
      ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x, ‖sphericalRadiusDerivative (compactConvolution (compactDyadicDilate K j) f) t x‖ₑ ^
        (2 : ℕ)) ≤ ENNReal.ofReal ((C / ((2 : ℝ) ^ j) ^ (((d : ℝ) - 1) / 2 - 1)) ^ 2) *
          ∫⁻ x, ‖f x‖ₑ ^ (2 : ℕ) := by
  obtain ⟨C, hC, hb⟩ := smoothed_sphericalRadiusDerivative_L2_bound hd K hflat hN
  refine ⟨C, hC, ?_⟩
  intro j t ht f
  rw [← schwartzSphericalRadiusDerivative_apply, schwartz_lintegral_sq, schwartz_lintegral_sq,
    ← ENNReal.ofReal_mul (sq_nonneg _)]
  apply ENNReal.ofReal_le_ofReal
  simpa only [schwartzSphericalRadiusDerivative_apply] using hb j t ht f

def normalizedRadiusDerivative {d : ℕ} (K f : SchwartzMap (Euclidean d) ℂ) (j : ℕ) (t : ℝ) :
    SchwartzMap (Euclidean d) ℂ :=
  (((2 : ℝ) ^ j)⁻¹) • schwartzSphericalRadiusDerivative
    (compactConvolution (compactDyadicDilate K j) f) t

theorem normalizedRadiusDerivative_enorm {d : ℕ}
    (K f : SchwartzMap (Euclidean d) ℂ) (j : ℕ) (t : ℝ) (x : Euclidean d) :
    ‖normalizedRadiusDerivative K f j t x‖ₑ =
      ENNReal.ofReal (((2 : ℝ) ^ j)⁻¹) *
        ‖sphericalRadiusDerivative (compactConvolution (compactDyadicDilate K j) f) t x‖ₑ := by
  rw [normalizedRadiusDerivative, smul_apply, enorm_smul]
  rw [← ofReal_norm, Real.norm_eq_abs, abs_of_pos (by positivity)]
  rw [schwartzSphericalRadiusDerivative_apply]

theorem normalizedRadiusDerivative_L1_bound {d : ℕ} (hd : 0 < d)
    (K : SchwartzMap (Euclidean d) ℂ) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (j : ℕ) (t R : ℝ), 1 ≤ t → 0 < R →
      ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) R, ‖normalizedRadiusDerivative K f j t x‖ₑ) ≤
        A * ENNReal.ofReal (R ^ (d - 1)) * ∫⁻ y, ‖f y‖ₑ := by
  obtain ⟨A, hA, hb⟩ := smoothed_sphericalRadiusDerivative_smallBall_L1_bound hd K
  refine ⟨A, hA, ?_⟩
  intro j t R ht hR f
  simp_rw [normalizedRadiusDerivative_enorm]
  rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  apply (mul_le_mul' le_rfl (hb j t R ht hR f)).trans_eq
  have he : ENNReal.ofReal (((2 : ℝ) ^ j)⁻¹) * ENNReal.ofReal ((2 : ℝ) ^ j) = 1 := by
    rw [← ENNReal.ofReal_mul (by positivity), inv_mul_cancel₀ (by positivity)]
    norm_num
  calc
    _ = A * (ENNReal.ofReal (((2 : ℝ) ^ j)⁻¹) * ENNReal.ofReal ((2 : ℝ) ^ j)) *
        ENNReal.ofReal (R ^ (d - 1)) * ∫⁻ y, ‖f y‖ₑ := by ring
    _ = _ := by rw [he, mul_one]

theorem normalizedRadiusDerivative_L2_bound {d N : ℕ} (hd : 2 ≤ d)
    (K : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 K ξ) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : ℕ) (t : ℝ), t ∈ Icc 1 2 →
      ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x, ‖normalizedRadiusDerivative K f j t x‖ₑ ^ (2 : ℕ)) ≤
        ENNReal.ofReal ((C / ((2 : ℝ) ^ j) ^ (((d : ℝ) - 1) / 2)) ^ 2) *
          ∫⁻ x, ‖f x‖ₑ ^ (2 : ℕ) := by
  obtain ⟨C, hC, hb⟩ := smoothed_sphericalRadiusDerivative_L2_moment_bound hd K hflat hN
  refine ⟨C, hC, ?_⟩
  intro j t ht f
  simp_rw [normalizedRadiusDerivative_enorm, mul_pow]
  rw [lintegral_const_mul' _ _ (ENNReal.pow_ne_top ENNReal.ofReal_ne_top)]
  apply (mul_le_mul' le_rfl (hb j t ht f)).trans_eq
  have hscale : 0 < (2 : ℝ) ^ j := by positivity
  have he : (((2 : ℝ) ^ j)⁻¹) ^ (2 : ℕ) *
      (C / ((2 : ℝ) ^ j) ^ (((d : ℝ) - 1) / 2 - 1)) ^ 2 =
      (C / ((2 : ℝ) ^ j) ^ (((d : ℝ) - 1) / 2)) ^ 2 := by
    rw [← mul_pow, Real.rpow_sub hscale, Real.rpow_one]
    congr 1
    field_simp
  rw [← mul_assoc, ← ENNReal.ofReal_pow (by positivity),
    ← ENNReal.ofReal_mul (sq_nonneg _), he]

/-- Localized interpolation for an additive Schwartz operator. -/
theorem localized_schwartz_interpolation {d : ℕ}
    (S : SchwartzMap (Euclidean d) ℂ → SchwartzMap (Euclidean d) ℂ)
    (hS : ∀ f g, S (f + g) = S f + S g)
    (B : Set (Euclidean d)) (hB : MeasurableSet B) (C₁ C₂ : ℝ≥0∞)
    (h₁ : ∀ f, (∫⁻ x in B, ‖S f x‖ₑ) ≤ C₁ * ∫⁻ x, ‖f x‖ₑ)
    (h₂ : ∀ f, (∫⁻ x, ‖S f x‖ₑ ^ (2 : ℕ)) ≤ C₂ * ∫⁻ x, ‖f x‖ₑ ^ (2 : ℕ))
    {p : ℝ} (hp₁ : 1 < p) (hp₂ : p < 2) (s : ℝ) (hs : 0 < s)
    (f : SchwartzMap (Euclidean d) ℂ) :
    (∫⁻ x in B, ‖S f x‖ₑ ^ p) ≤
      (ENNReal.ofReal p *
        (4 * C₂ * (ENNReal.ofReal s) ^ (2 - p) * lowSplitConstant p +
          2 * C₁ * (ENNReal.ofReal s) ^ (1 - p) * highSplitConstant p)) *
            ∫⁻ x, ‖f x‖ₑ ^ p := by
  let T (g : SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℝ :=
    B.indicator (fun x => ‖S g x‖)
  have hmeas (g) : Measurable (T g) := (S g).continuous.norm.measurable.indicator hB
  have hnonneg (g x) : 0 ≤ T g x := Set.indicator_nonneg (fun _ _ => norm_nonneg _) _
  have hsub (g h : SchwartzMap (Euclidean d) ℂ) (x) : T (g + h) x ≤ T g x + T h x := by
    by_cases hx : x ∈ B
    · simp only [T, Set.indicator_of_mem hx, hS, add_apply]
      exact norm_add_le _ _
    · simp [T, hx]
  have hb₁ (g) : (∫⁻ x, ENNReal.ofReal (T g x)) ≤ C₁ * ∫⁻ x, ‖g x‖ₑ := by
    have he := indicator_norm_moment B hB (S g) (p := 1) zero_lt_one
    simp only [Real.rpow_one, ENNReal.rpow_one] at he
    rw [show (∫⁻ x, ENNReal.ofReal (T g x)) = _ from he]
    exact h₁ g
  have hb₂ (g) : (∫⁻ x, ENNReal.ofReal ((T g x) ^ (2 : ℕ))) ≤
      C₂ * ∫⁻ x, ‖g x‖ₑ ^ (2 : ℕ) := by
    apply (lintegral_mono (g := fun x => ‖S g x‖ₑ ^ (2 : ℕ)) ?_).trans (h₂ g)
    intro x
    by_cases hx : x ∈ B
    · simp only [T, Set.indicator_of_mem hx, ENNReal.ofReal_pow (norm_nonneg _),
        ofReal_norm, le_refl]
    · simp [T, hx]
  have hi := schwartz_one_two_moment_interpolation T (fun g => (hmeas g).aemeasurable)
    hnonneg hsub C₁ C₂ hb₁ hb₂ hp₁ hp₂ s hs f
  rw [indicator_norm_moment B hB (S f) (by linarith)] at hi
  exact hi

theorem normalizedRadiusDerivative_add {d : ℕ}
    (K f g : SchwartzMap (Euclidean d) ℂ) (j : ℕ) (t : ℝ) :
    normalizedRadiusDerivative K (f + g) j t =
      normalizedRadiusDerivative K f j t + normalizedRadiusDerivative K g j t := by
  simp only [normalizedRadiusDerivative, schwartzSphericalRadiusDerivative,
    schwartzRadiusMultiplier, compactConvolution_add_right, FourierTransform.fourier_add,
    map_add, FourierTransform.fourierInv_add, smul_add]

theorem normalizedRadiusDerivative_intermediate_bound {d N : ℕ} (hd : 2 ≤ d)
    (K : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 K ξ) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) :
    ∃ C₁ : ℝ≥0∞, ∃ C₂ : ℝ, C₁ ≠ ∞ ∧ 0 < C₂ ∧
      ∀ (j : ℕ) (t R : ℝ), t ∈ Icc 1 2 → 0 < R →
      ∀ (p s : ℝ), 1 < p → p < 2 → 0 < s →
      ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) R,
        ‖normalizedRadiusDerivative K f j t x‖ₑ ^ p) ≤
        (ENNReal.ofReal p *
          (4 * ENNReal.ofReal ((C₂ / ((2 : ℝ) ^ j) ^ (((d : ℝ) - 1) / 2)) ^ 2) *
              (ENNReal.ofReal s) ^ (2 - p) * lowSplitConstant p +
            2 * (C₁ * ENNReal.ofReal (R ^ (d - 1))) *
              (ENNReal.ofReal s) ^ (1 - p) * highSplitConstant p)) *
                ∫⁻ x, ‖f x‖ₑ ^ p := by
  obtain ⟨C₁, hC₁, hb₁⟩ := normalizedRadiusDerivative_L1_bound (by omega) K
  obtain ⟨C₂, hC₂, hb₂⟩ := normalizedRadiusDerivative_L2_bound hd K hflat hN
  refine ⟨C₁, C₂, hC₁, hC₂, ?_⟩
  intro j t R ht hR p s hp₁ hp₂ hs f
  exact localized_schwartz_interpolation (fun g => normalizedRadiusDerivative K g j t)
    (fun g h => normalizedRadiusDerivative_add K g h j t)
    (Metric.closedBall 0 R) measurableSet_closedBall
    (C₁ * ENNReal.ofReal (R ^ (d - 1)))
    (ENNReal.ofReal ((C₂ / ((2 : ℝ) ^ j) ^ (((d : ℝ) - 1) / 2)) ^ 2))
    (hb₁ j t R ht.1 hR) (hb₂ j t ht) hp₁ hp₂ s hs f

/-- Dyadic localized bound for the normalized radius derivative. -/
theorem normalizedRadiusDerivative_dyadic_Lp_bound {d N : ℕ} (hd : 2 ≤ d)
    (K : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 K ξ) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) {p : ℝ} (hp₁ : 1 < p) (hp₂ : p < 2) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (j k : ℕ) (t : ℝ), t ∈ Icc 1 2 →
      ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) (((2 : ℝ) ^ k)⁻¹),
        ‖normalizedRadiusDerivative K f j t x‖ₑ ^ p) ≤
          A * (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
            (k : ℝ) * ((d : ℝ) - 1) * (2 - p)) * ∫⁻ x, ‖f x‖ₑ ^ p := by
  obtain ⟨C₁, C₂, hC₁, hC₂, hb⟩ := normalizedRadiusDerivative_intermediate_bound hd K hflat hN
  let A := ENNReal.ofReal p * (4 * ENNReal.ofReal (C₂ ^ 2) * lowSplitConstant p +
    2 * C₁ * highSplitConstant p)
  have hA : A ≠ ∞ := ENNReal.mul_ne_top ENNReal.ofReal_ne_top
    (ENNReal.add_ne_top.mpr ⟨ENNReal.mul_ne_top
      (ENNReal.mul_ne_top (by norm_num) ENNReal.ofReal_ne_top) (lowSplitConstant_ne_top hp₁ hp₂),
      ENNReal.mul_ne_top (ENNReal.mul_ne_top (by norm_num) hC₁) (highSplitConstant_ne_top hp₁ hp₂)⟩)
  refine ⟨A, hA, ?_⟩
  intro j k t ht f
  let s : ℝ := (2 : ℝ) ^ (((j : ℝ) - k) * ((d : ℝ) - 1))
  have hs : 0 < s := Real.rpow_pos_of_pos (by norm_num) _
  have hi := hb j t (((2 : ℝ) ^ k)⁻¹) ht (by positivity) p s hp₁ hp₂ hs f
  have hs' : ENNReal.ofReal s = (2 : ℝ≥0∞) ^ (((j : ℝ) - k) * ((d : ℝ) - 1)) := by
    dsimp only [s]
    rw [← ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 2)]
    norm_num
  have hR : ENNReal.ofReal ((((2 : ℝ) ^ k)⁻¹) ^ (d - 1)) =
      (2 : ℝ≥0∞) ^ (-((k : ℝ) * ((d : ℝ) - 1))) := by
    have he : (((2 : ℝ) ^ k)⁻¹) ^ (d - 1) = (2 : ℝ) ^ (-((k : ℝ) * ((d : ℝ) - 1))) := by
      rw [inv_pow, ← pow_mul, ← Real.rpow_natCast,
        ← Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2)]
      congr 1
      rw [Nat.cast_mul, Nat.cast_sub (by omega : 1 ≤ d), Nat.cast_one]
    rw [he, ← ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 2)]
    norm_num
  rw [dyadic_square_multiplier_factor, hs', hR] at hi
  apply hi.trans_eq
  have hbalance := dyadic_interpolation_balance d j k p
  have hcoeff :
      ENNReal.ofReal p *
        (4 * (ENNReal.ofReal (C₂ ^ 2) * (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1)))) *
            ((2 : ℝ≥0∞) ^ (((j : ℝ) - k) * ((d : ℝ) - 1))) ^ (2 - p) * lowSplitConstant p +
          2 * (C₁ * (2 : ℝ≥0∞) ^ (-((k : ℝ) * ((d : ℝ) - 1)))) *
            ((2 : ℝ≥0∞) ^ (((j : ℝ) - k) * ((d : ℝ) - 1))) ^ (1 - p) * highSplitConstant p) =
        A * (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
          (k : ℝ) * ((d : ℝ) - 1) * (2 - p)) := by
    calc
      _ = ENNReal.ofReal p *
          ((4 * ENNReal.ofReal (C₂ ^ 2) * lowSplitConstant p) *
            ((2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1))) *
              ((2 : ℝ≥0∞) ^ (((j : ℝ) - k) * ((d : ℝ) - 1))) ^ (2 - p)) +
           (2 * C₁ * highSplitConstant p) *
            ((2 : ℝ≥0∞) ^ (-((k : ℝ) * ((d : ℝ) - 1))) *
              ((2 : ℝ≥0∞) ^ (((j : ℝ) - k) * ((d : ℝ) - 1))) ^ (1 - p))) := by ring
      _ = _ := by rw [hbalance.1, hbalance.2]; dsimp [A]; ring
  rw [hcoeff]

/-- The derivative normalization used for the source's synthesis family. -/
def normalizedSynthesisRadiusDerivative {d : ℕ}
    (φ f : SchwartzMap (Euclidean d) ℂ) (j : ℕ) (t : ℝ) : SchwartzMap (Euclidean d) ℂ :=
  (((2 : ℝ) ^ j)⁻¹) • schwartzSphericalRadiusDerivative
    (compactConvolution (compactSynthesisKernel φ j) f) t

theorem normalizedSynthesisRadiusDerivative_apply {d : ℕ}
    (φ f : SchwartzMap (Euclidean d) ℂ) (j : ℕ) (t : ℝ) (x : Euclidean d) :
    normalizedSynthesisRadiusDerivative φ f j t x =
      (((2 : ℝ) ^ j)⁻¹) •
        sphericalRadiusDerivative (compactConvolution (compactSynthesisKernel φ j) f) t x := by
  rw [normalizedSynthesisRadiusDerivative, smul_apply, schwartzSphericalRadiusDerivative_apply]

theorem normalizedSynthesisRadiusDerivative_succ {d : ℕ}
    (φ f : SchwartzMap (Euclidean d) ℂ) (j : ℕ) (t : ℝ) :
    normalizedSynthesisRadiusDerivative φ f (j + 1) t =
      (1 / 2 : ℝ) • normalizedRadiusDerivative (compactSynthesisKernel φ 1) f j t := by
  unfold normalizedSynthesisRadiusDerivative normalizedRadiusDerivative
  rw [compactSynthesisKernel_succ φ j, smul_smul]
  congr 1
  rw [pow_succ, mul_inv_rev, one_div]

/-- Localized derivative estimate for the actual synthesis kernels. -/
theorem synthesis_radiusDerivative_Lp_bound {d N : ℕ} (hd : 2 ≤ d)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) {p : ℝ} (hp₁ : 1 < p) (hp₂ : p < 2) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (j k : ℕ), 0 < j → ∀ (t : ℝ), t ∈ Icc 1 2 →
      ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) (((2 : ℝ) ^ k)⁻¹),
        ‖normalizedSynthesisRadiusDerivative φ f j t x‖ₑ ^ p) ≤
          A * (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
            (k : ℝ) * ((d : ℝ) - 1) * (2 - p)) * ∫⁻ x, ‖f x‖ₑ ^ p := by
  obtain ⟨A, hA, hb⟩ := normalizedRadiusDerivative_dyadic_Lp_bound hd
    (compactSynthesisKernel φ 1) (compactSynthesisKernel_fourier_isBigO φ hflat 0) hN hp₁ hp₂
  refine ⟨A * (2 : ℝ≥0∞) ^ (((d : ℝ) - 1) * (p - 1)),
    ENNReal.mul_ne_top hA (ENNReal.rpow_ne_top_of_nonneg
      (by
        have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
        exact mul_nonneg (by linarith) (by linarith)) (by norm_num)), ?_⟩
  intro j k hj t ht f
  obtain ⟨i, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hj)
  have hpoint (x : Euclidean d) :
      ‖normalizedSynthesisRadiusDerivative φ f (i + 1) t x‖ₑ ^ p ≤
        ‖normalizedRadiusDerivative (compactSynthesisKernel φ 1) f i t x‖ₑ ^ p := by
    apply ENNReal.rpow_le_rpow _ (by linarith)
    rw [normalizedSynthesisRadiusDerivative_succ, smul_apply, enorm_smul]
    have hc : ‖(1 / 2 : ℝ)‖ₑ ≤ 1 := by rw [← ofReal_norm]; norm_num
    exact (mul_le_mul' hc le_rfl).trans_eq (one_mul _)
  apply (lintegral_mono hpoint).trans
  apply (hb i k t ht f).trans_eq
  have he :
      (2 : ℝ≥0∞) ^ (-((i : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
        (k : ℝ) * ((d : ℝ) - 1) * (2 - p)) =
      (2 : ℝ≥0∞) ^ (((d : ℝ) - 1) * (p - 1)) *
        (2 : ℝ≥0∞) ^ (-((i.succ : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
          (k : ℝ) * ((d : ℝ) - 1) * (2 - p)) := by
    rw [← ENNReal.rpow_add _ _ (by norm_num : (2 : ℝ≥0∞) ≠ 0)
      (by norm_num : (2 : ℝ≥0∞) ≠ ∞), Nat.cast_succ]
    congr 1
    ring
  rw [he]
  simp only [mul_assoc]

/-- Finite-radius counterpart of `eq:jkmu-2`, including its `2⁻ʲ` normalization. -/
theorem synthesis_finiteRadius_derivative_Lp_bound {d N : ℕ} (hd : 2 ≤ d)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) {p : ℝ} (hp₁ : 1 < p) (hp₂ : p < 2) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (j k : ℕ), 0 < j →
      ∀ (I : Finset ℝ), (∀ t ∈ I, t ∈ Icc 1 2) → ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∑ t ∈ I, ∫⁻ x in Metric.closedBall (0 : Euclidean d) (((2 : ℝ) ^ k)⁻¹),
        ‖normalizedSynthesisRadiusDerivative φ f j t x‖ₑ ^ p) ≤
          A * I.card * (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
            (k : ℝ) * ((d : ℝ) - 1) * (2 - p)) * ∫⁻ x, ‖f x‖ₑ ^ p := by
  obtain ⟨A, hA, hb⟩ := synthesis_radiusDerivative_Lp_bound hd φ hflat hN hp₁ hp₂
  refine ⟨A, hA, ?_⟩
  intro j k hj I hI f
  apply (Finset.sum_le_sum (fun t ht => hb j k hj t (hI t ht) f)).trans_eq
  rw [Finset.sum_const, nsmul_eq_mul]
  ring

/-- Fundamental theorem of calculus and Hölder on a short radius interval,
in the moment form used by the finite-cover argument. -/
theorem interval_supremum_moment_bound {F D : ℝ → ℂ}
    (hD : Continuous D) (hderiv : ∀ t, HasDerivAt F (D t) t)
    {a b r p : ℝ} (hr : r ∈ Icc a b) (hp : 1 ≤ p) :
    ‖F r‖ₑ ^ p ≤ (2 : ℝ≥0∞) ^ p *
      (‖F a‖ₑ ^ p + (ENNReal.ofReal (b - a)) ^ (p - 1) *
        ∫⁻ t in Ioc a b, ‖D t‖ₑ ^ p) := by
  have hab : a ≤ b := hr.1.trans hr.2
  have hi : IntegrableOn (fun t => ‖D t‖) (Ioc a b) :=
    hD.norm.integrableOn_Icc.mono_set Ioc_subset_Icc_self
  have hftc := Auto.Spherical.Auxiliary.norm_le_norm_add_intervalIntegral_norm_of_hasDerivAt
    hr hD hderiv
  rw [intervalIntegral.integral_of_le hab] at hftc
  have hnorm := ENNReal.ofReal_le_ofReal hftc
  rw [ENNReal.ofReal_add (norm_nonneg _) (integral_nonneg (fun _ => norm_nonneg _)),
    ofReal_norm, ofReal_norm,
    ofReal_integral_eq_lintegral_ofReal hi (ae_of_all _ (fun _ => norm_nonneg _))] at hnorm
  simp only [ofReal_norm] at hnorm
  have hh := weighted_lintegral_rpow_le (volume.restrict (Ioc a b))
    (a := fun _ => 1) aemeasurable_const hD.measurable.enorm.aemeasurable hp
  simp only [one_mul, lintegral_const, Measure.restrict_apply_univ, Real.volume_Ioc] at hh
  apply (ENNReal.rpow_le_rpow hnorm (by linarith)).trans
  apply (ENNReal.add_rpow_le_two_rpow_mul_rpow_add_rpow _ _ (by linarith)).trans
  exact mul_le_mul' le_rfl (add_le_add le_rfl hh)

theorem hasDerivAt_sphericalAverage_schwartz {d : ℕ}
    (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) (t : ℝ) :
    HasDerivAt (fun r => sphericalAverage d f r x) (sphericalRadiusDerivative f t x) t := by
  rw [sphericalRadiusDerivative_eq]
  apply Auto.Spherical.SphericalMaximalL2.hasDerivAt_sphericalAverage f
    (by simpa using f.smooth (1 : ℕ∞))
    (C := SchwartzMap.seminorm ℝ 0 0 ((SchwartzMap.fderivCLM ℂ (Euclidean d) ℂ) f))
  intro y
  rw [← SchwartzMap.fderivCLM_apply ℂ f y]
  exact SchwartzMap.norm_le_seminorm ℝ _ y

theorem continuous_sphericalRadiusDerivative {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ) :
    Continuous (fun z : ℝ × Euclidean d => sphericalRadiusDerivative f z.1 z.2) := by
  simp_rw [sphericalRadiusDerivative_eq]
  let D := (SchwartzMap.fderivCLM ℂ (Euclidean d) ℂ) f
  let C := SchwartzMap.seminorm ℝ 0 0 D
  have hb (y : Euclidean d) : ‖fderiv ℝ (f : Euclidean d → ℂ) y‖ ≤ C := by
    rw [← SchwartzMap.fderivCLM_apply ℂ f y]
    exact SchwartzMap.norm_le_seminorm ℝ D y
  have hfd : Continuous (fderiv ℝ (f : Euclidean d → ℂ)) :=
    (f.smooth (1 : ℕ∞)).continuous_fderiv (by norm_num)
  apply continuous_of_dominated
    (F := fun z : ℝ × Euclidean d => fun ω : Metric.sphere (0 : Euclidean d) 1 =>
      fderiv ℝ (f : Euclidean d → ℂ) (z.2 + z.1 • (ω : Euclidean d)) (ω : Euclidean d))
    (bound := fun _ => C)
  · intro z
    have hc : Continuous (fun ω : Metric.sphere (0 : Euclidean d) 1 =>
        fderiv ℝ (f : Euclidean d → ℂ) (z.2 + z.1 • (ω : Euclidean d)) (ω : Euclidean d)) :=
      (hfd.comp (by fun_prop)).clm_apply continuous_subtype_val
    exact hc.aestronglyMeasurable
  · intro z
    filter_upwards with ω
    have hn : ‖(ω : Euclidean d)‖ = 1 := by simp
    exact ((fderiv ℝ (f : Euclidean d → ℂ) (z.2 + z.1 • (ω : Euclidean d))).le_opNorm ω).trans
      (by simpa only [hn, mul_one] using hb (z.2 + z.1 • (ω : Euclidean d)))
  · exact integrable_const C
  · filter_upwards with ω
    exact (hfd.comp (show Continuous (fun z : ℝ × Euclidean d =>
      z.2 + z.1 • (ω : Euclidean d)) by fun_prop)).clm_apply continuous_const

/-- Short-interval bound for a Schwartz spherical average. -/
theorem sphericalAverage_interval_moment_bound {d : ℕ}
    (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d)
    {a b r p : ℝ} (hr : r ∈ Icc a b) (hp : 1 ≤ p) :
    ‖sphericalAverage d f r x‖ₑ ^ p ≤ (2 : ℝ≥0∞) ^ p *
      (‖sphericalAverage d f a x‖ₑ ^ p + (ENNReal.ofReal (b - a)) ^ (p - 1) *
        ∫⁻ t in Ioc a b, ‖sphericalRadiusDerivative f t x‖ₑ ^ p) :=
  interval_supremum_moment_bound
    ((continuous_sphericalRadiusDerivative f).comp (continuous_id.prodMk continuous_const))
    (fun t => hasDerivAt_sphericalAverage_schwartz f x t) hr hp

/-- Normalize the derivative by the interval-cover scale. An interval no
longer than that scale then costs just its reciprocal in the moment estimate. -/
theorem short_interval_moment_bound {F D : ℝ → ℂ}
    (hD : Continuous D) (hderiv : ∀ t, HasDerivAt F (D t) t)
    {a b r p δ : ℝ} (hr : r ∈ Icc a b) (hp : 1 ≤ p)
    (hδ : 0 < δ) (hlen : b - a ≤ δ) :
    ‖F r‖ₑ ^ p ≤ (2 : ℝ≥0∞) ^ p *
      (‖F a‖ₑ ^ p + (ENNReal.ofReal δ)⁻¹ * ∫⁻ t in Ioc a b, ‖δ • D t‖ₑ ^ p) := by
  have hδ0 : ENNReal.ofReal δ ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hδ
  have hδT : ENNReal.ofReal δ ≠ ∞ := ENNReal.ofReal_ne_top
  have he (t : ℝ) : ‖δ • D t‖ₑ ^ p = (ENNReal.ofReal δ) ^ p * ‖D t‖ₑ ^ p := by
    rw [enorm_smul, ← ofReal_norm δ, Real.norm_eq_abs, abs_of_pos hδ,
      ENNReal.mul_rpow_of_nonneg _ _ (by linarith)]
  have hpow : (ENNReal.ofReal (b - a)) ^ (p - 1) ≤ (ENNReal.ofReal δ) ^ (p - 1) :=
    ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal hlen) (by linarith)
  have hfactor : (ENNReal.ofReal δ) ^ (p - 1) = (ENNReal.ofReal δ)⁻¹ * (ENNReal.ofReal δ) ^ p := by
    rw [← ENNReal.rpow_neg_one, ← ENNReal.rpow_add _ _ hδ0 hδT]
    congr 1
    ring
  apply (interval_supremum_moment_bound hD hderiv hr hp).trans
  apply mul_le_mul' le_rfl
  apply add_le_add le_rfl
  calc
    _ ≤ (ENNReal.ofReal δ) ^ (p - 1) * ∫⁻ t in Ioc a b, ‖D t‖ₑ ^ p :=
      mul_le_mul' hpow le_rfl
    _ = _ := by
      simp_rw [he]
      rw [lintegral_const_mul' _ _ (ENNReal.rpow_ne_top_of_nonneg (by linarith) hδT),
        hfactor, mul_assoc]

/-- Finite-cover maximal estimate from fixed-radius and normalized derivative
moments. This formulation permits restriction of the spatial measure. -/
theorem finite_interval_cover_maximal_moment {X ι : Type*} [MeasurableSpace X]
    (μ : Measure X) [SFinite μ] (F D : ℝ → X → ℂ)
    (hF : ∀ t, Measurable (F t)) (hD : Measurable (Function.uncurry D))
    (hDc : ∀ x, Continuous (fun t => D t x))
    (hderiv : ∀ x t, HasDerivAt (fun r => F r x) (D t x) t)
    {E J : Set ℝ} (I : Finset ι) (a b : ι → ℝ)
    (hab : ∀ i ∈ I, a i ≤ b i) (hJ : ∀ i ∈ I, Icc (a i) (b i) ⊆ J)
    (hcover : ∀ t ∈ E, ∃ i ∈ I, t ∈ Icc (a i) (b i))
    {p δ : ℝ} (hp : 1 ≤ p) (hδ : 0 < δ) (hlen : ∀ i ∈ I, b i - a i ≤ δ)
    (B₁ B₂ : ℝ≥0∞)
    (h₁ : ∀ t ∈ J, (∫⁻ x, ‖F t x‖ₑ ^ p ∂μ) ≤ B₁)
    (h₂ : ∀ t ∈ J, (∫⁻ x, ‖δ • D t x‖ₑ ^ p ∂μ) ≤ B₂) :
    (∫⁻ x, (⨆ t : E, ‖F t x‖ₑ) ^ p ∂μ) ≤
      (2 : ℝ≥0∞) ^ p * (B₁ + B₂) * I.card := by
  classical
  have hp0 : 0 < p := by linarith
  have hδ0 : ENNReal.ofReal δ ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hδ
  have hδinv : (ENNReal.ofReal δ)⁻¹ ≠ ∞ := ENNReal.inv_ne_top.mpr hδ0
  have hm : Measurable (fun z : X × ℝ => ‖δ • D z.2 z.1‖ₑ ^ p) :=
    ((hD.comp measurable_swap).const_smul δ).enorm.pow_const p
  let G (i : ι) (x : X) : ℝ≥0∞ := ‖F (a i) x‖ₑ ^ p +
    (ENNReal.ofReal δ)⁻¹ * ∫⁻ t in Ioc (a i) (b i), ‖δ • D t x‖ₑ ^ p
  have hG (i : ι) : Measurable (G i) :=
    ((hF (a i)).enorm.pow_const p).add
      (measurable_const.mul (hm.lintegral_prod_right' (ν := volume.restrict (Ioc (a i) (b i)))))
  have hpoint (x : X) : (⨆ t : E, ‖F t x‖ₑ) ^ p ≤ (2 : ℝ≥0∞) ^ p * ∑ i ∈ I, G i x := by
    apply (ENNReal.le_rpow_inv_iff hp0).mp
    apply iSup_le
    intro t
    apply (ENNReal.le_rpow_inv_iff hp0).mpr
    obtain ⟨i, hi, hti⟩ := hcover t t.property
    apply (short_interval_moment_bound (hDc x) (hderiv x) hti hp hδ (hlen i hi)).trans
    exact mul_le_mul' le_rfl (Finset.single_le_sum
      (f := fun i => G i x) (fun _ _ => bot_le) hi)
  have hGi (i : ι) (hi : i ∈ I) : (∫⁻ x, G i x ∂μ) ≤ B₁ + B₂ := by
    have hinner :
        (∫⁻ x, (∫⁻ t in Ioc (a i) (b i), ‖δ • D t x‖ₑ ^ p) ∂μ) ≤
          B₂ * ENNReal.ofReal (b i - a i) := by
      rw [lintegral_lintegral_swap hm.aemeasurable]
      calc
        _ ≤ ∫⁻ _ in Ioc (a i) (b i), B₂ := by
          apply lintegral_mono_ae
          filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
          exact h₂ t (hJ i hi ⟨ht.1.le, ht.2⟩)
        _ = _ := by rw [setLIntegral_const, Real.volume_Ioc]
    calc
      _ = (∫⁻ x, ‖F (a i) x‖ₑ ^ p ∂μ) + (ENNReal.ofReal δ)⁻¹ *
          ∫⁻ x, (∫⁻ t in Ioc (a i) (b i), ‖δ • D t x‖ₑ ^ p) ∂μ := by
        dsimp only [G]
        rw [lintegral_add_left ((hF (a i)).enorm.pow_const p),
          lintegral_const_mul' _ _ hδinv]
      _ ≤ B₁ + (ENNReal.ofReal δ)⁻¹ * (B₂ * ENNReal.ofReal (b i - a i)) :=
        add_le_add (h₁ (a i) (hJ i hi ⟨le_rfl, hab i hi⟩)) (mul_le_mul' le_rfl hinner)
      _ ≤ B₁ + (ENNReal.ofReal δ)⁻¹ * (B₂ * ENNReal.ofReal δ) :=
        add_le_add le_rfl (mul_le_mul' le_rfl
          (mul_le_mul' le_rfl (ENNReal.ofReal_le_ofReal (hlen i hi))))
      _ = B₁ + B₂ := by
        rw [mul_left_comm, ENNReal.inv_mul_cancel hδ0 ENNReal.ofReal_ne_top, mul_one]
  calc
    _ ≤ ∫⁻ x, (2 : ℝ≥0∞) ^ p * ∑ i ∈ I, G i x ∂μ := lintegral_mono hpoint
    _ = (2 : ℝ≥0∞) ^ p * ∑ i ∈ I, ∫⁻ x, G i x ∂μ := by
      rw [lintegral_const_mul' _ _ (ENNReal.rpow_ne_top_of_nonneg hp0.le (by norm_num)),
        lintegral_finsetSum I (fun i _ => hG i)]
    _ ≤ (2 : ℝ≥0∞) ^ p * ∑ _i ∈ I, (B₁ + B₂) :=
      mul_le_mul' le_rfl (Finset.sum_le_sum hGi)
    _ = _ := by rw [Finset.sum_const, nsmul_eq_mul]; ring

/-- Source `eq:ptwest`: the short-interval supremum bound for the actual
synthesis kernels, with the number of intervals explicit. -/
theorem synthesis_intervalCover_Lp_bound {d N : ℕ} (hd : 2 ≤ d)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) {p : ℝ} (hp₁ : 1 < p) (hp₂ : p < 2) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (j k : ℕ), 0 < j →
      ∀ (E : Set ℝ) (I : Finset ℝ) (a b : ℝ → ℝ),
      (∀ i ∈ I, a i ≤ b i) → (∀ i ∈ I, Icc (a i) (b i) ⊆ Icc 1 2) →
      (∀ t ∈ E, ∃ i ∈ I, t ∈ Icc (a i) (b i)) →
      (∀ i ∈ I, b i - a i ≤ ((2 : ℝ) ^ j)⁻¹) →
      ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) (((2 : ℝ) ^ k)⁻¹),
        (⨆ t : E,
          ‖sphericalAverage d (compactConvolution (compactSynthesisKernel φ j) f) t x‖ₑ) ^ p) ≤
        A * I.card * (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
          (k : ℝ) * ((d : ℝ) - 1) * (2 - p)) * ∫⁻ x, ‖f x‖ₑ ^ p := by
  obtain ⟨A₁, hA₁, hb₁⟩ := synthesis_fixedRadius_Lp_bound hd φ hflat hN hp₁ hp₂
  obtain ⟨A₂, hA₂, hb₂⟩ := synthesis_radiusDerivative_Lp_bound hd φ hflat hN hp₁ hp₂
  refine ⟨(2 : ℝ≥0∞) ^ p * (A₁ + A₂), ENNReal.mul_ne_top
    (ENNReal.rpow_ne_top_of_nonneg (by linarith) (by norm_num))
    (ENNReal.add_ne_top.mpr ⟨hA₁, hA₂⟩), ?_⟩
  intro j k hj E I a b hab hJ hcover hlen f
  let g := compactConvolution (compactSynthesisKernel φ j) f
  let W := (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
    (k : ℝ) * ((d : ℝ) - 1) * (2 - p)) * ∫⁻ x, ‖f x‖ₑ ^ p
  have hF (t : ℝ) : Measurable (sphericalAverage d g t) := by
    rw [← schwartzSphericalAverage_apply]
    exact (schwartzSphericalAverage g t).continuous.measurable
  have hD := continuous_sphericalRadiusDerivative g
  have hfixed (t : ℝ) (ht : t ∈ Icc (1 : ℝ) 2) :
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) (((2 : ℝ) ^ k)⁻¹),
        ‖sphericalAverage d g t x‖ₑ ^ p) ≤ A₁ * W := by
    simpa only [W, mul_assoc] using hb₁ j k hj t ht.1 f
  have hderivative (t : ℝ) (ht : t ∈ Icc (1 : ℝ) 2) :
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) (((2 : ℝ) ^ k)⁻¹),
        ‖(((2 : ℝ) ^ j)⁻¹) • sphericalRadiusDerivative g t x‖ₑ ^ p) ≤ A₂ * W := by
    simpa only [normalizedSynthesisRadiusDerivative_apply, W, mul_assoc]
      using hb₂ j k hj t ht f
  have hDc (x : Euclidean d) : Continuous (fun t => sphericalRadiusDerivative g t x) := by
    have hc : Continuous (fun t : ℝ => (t, x)) := continuous_id.prodMk continuous_const
    have hc' := hD.comp hc
    exact hc'
  have hb := finite_interval_cover_maximal_moment
    (X := Euclidean d) (ι := ℝ) (p := p) (δ := ((2 : ℝ) ^ j)⁻¹)
    (E := E) (J := Icc 1 2)
    (volume.restrict (Metric.closedBall (0 : Euclidean d) (((2 : ℝ) ^ k)⁻¹)))
    (sphericalAverage d g) (sphericalRadiusDerivative g)
  have hb' := hb hF hD.measurable hDc
    (hasDerivAt_sphericalAverage_schwartz g)
    I a b hab hJ hcover hp₁.le
    (by positivity : 0 < ((2 : ℝ) ^ j)⁻¹) hlen (A₁ * W) (A₂ * W)
    hfixed hderivative
  exact hb'.trans_eq (by dsimp only [W]; ring)

/-- Clip a finite equal-length cover to the radius range `[1,2]`, discarding
empty intersections without increasing its cardinality. -/
theorem intervalCover_clip {E : Set ℝ} {δ : ℝ} {I : Finset ℝ}
    (hE : E ⊆ Icc 1 2) (hcover : IsIntervalCover E δ I) :
    ∃ I' : Finset ℝ, I'.card ≤ I.card ∧
      (∀ i ∈ I', max 1 (i - δ / 2) ≤ min 2 (i + δ / 2)) ∧
      (∀ i ∈ I', Icc (max 1 (i - δ / 2)) (min 2 (i + δ / 2)) ⊆ Icc 1 2) ∧
      (∀ t ∈ E, ∃ i ∈ I', t ∈ Icc (max 1 (i - δ / 2)) (min 2 (i + δ / 2))) ∧
      (∀ i ∈ I', min 2 (i + δ / 2) - max 1 (i - δ / 2) ≤ δ) := by
  classical
  let I' := I.filter (fun i => max 1 (i - δ / 2) ≤ min 2 (i + δ / 2))
  refine ⟨I', Finset.card_filter_le _ _, ?_, ?_, ?_, ?_⟩
  · intro i hi
    exact (Finset.mem_filter.mp hi).2
  · intro i _ t ht
    exact ⟨(le_max_left _ _).trans ht.1, ht.2.trans (min_le_left _ _)⟩
  · intro t ht
    obtain ⟨i, hi, hti⟩ := Set.mem_iUnion₂.mp (hcover ht)
    have hl : max 1 (i - δ / 2) ≤ t := max_le (hE ht).1 hti.1
    have hr : t ≤ min 2 (i + δ / 2) := le_min (hE ht).2 hti.2
    exact ⟨i, Finset.mem_filter.mpr ⟨hi, hl.trans hr⟩, hl, hr⟩
  · intro i _
    have hl := le_max_right (1 : ℝ) (i - δ / 2)
    have hr := min_le_right (2 : ℝ) (i + δ / 2)
    linarith

/-- Source `eq:ptwest`, finite-cover form: the localized spherical supremum
has the interpolated dyadic decay times the covering cardinality. -/
theorem synthesis_finiteCover_Lp_bound {d N : ℕ} (hd : 2 ≤ d)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) {p : ℝ} (hp₁ : 1 < p) (hp₂ : p < 2) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (j k : ℕ), 0 < j →
      ∀ (E : Set ℝ), E ⊆ Icc 1 2 → ∀ (I : Finset ℝ),
      IsIntervalCover E (((2 : ℝ) ^ j)⁻¹) I →
      ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) (((2 : ℝ) ^ k)⁻¹),
        (⨆ t : E,
          ‖sphericalAverage d (compactConvolution (compactSynthesisKernel φ j) f) t x‖ₑ) ^ p) ≤
        A * I.card * (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
          (k : ℝ) * ((d : ℝ) - 1) * (2 - p)) * ∫⁻ x, ‖f x‖ₑ ^ p := by
  obtain ⟨A, hA, hb⟩ := synthesis_intervalCover_Lp_bound hd φ hflat hN hp₁ hp₂
  refine ⟨A, hA, ?_⟩
  intro j k hj E hE I hI f
  obtain ⟨I', hcard, hab, hJ, hcover, hlen⟩ := intervalCover_clip hE hI
  apply (hb j k hj E I' (fun i => max 1 (i - (((2 : ℝ) ^ j)⁻¹) / 2))
    (fun i => min 2 (i + (((2 : ℝ) ^ j)⁻¹) / 2)) hab hJ hcover hlen f).trans
  exact mul_le_mul' (mul_le_mul' (mul_le_mul' le_rfl (by exact_mod_cast hcard))
    le_rfl) le_rfl

/-- Compact spatial synthesis kernels see only a thin input annulus when
the output is restricted to a small ball (source proof of `lem:k<j`). -/
theorem sphericalAverage_smoothInput_congr_on_shell {d : ℕ}
    (K : SchwartzMap (Euclidean d) ℂ) (f g : Euclidean d → ℂ)
    {r R t : ℝ} {x : Euclidean d}
    (hK : ∀ y, r < ‖y‖ → K y = 0) (hx : ‖x‖ ≤ R) (ht : 0 ≤ t)
    (hfg : ∀ y, |‖y‖ - t| ≤ R + r → f y = g y) :
    sphericalAverage d (smoothInput K f) t x =
      sphericalAverage d (smoothInput K g) t x := by
  unfold sphericalAverage
  apply integral_congr_ae
  filter_upwards with ω
  unfold smoothInput
  apply integral_congr_ae
  filter_upwards with y
  by_cases hy : r < ‖y‖
  · rw [hK y hy]
    simp
  · have hy' : ‖y‖ ≤ r := le_of_not_gt hy
    have hω : ‖(ω : Euclidean d)‖ = 1 := by simp
    have htw : ‖t • (ω : Euclidean d)‖ = t := by
      rw [norm_smul, Real.norm_of_nonneg ht, hω, mul_one]
    have hdist : |‖x + t • (ω : Euclidean d) - y‖ - t| ≤ R + r := by
      calc
        _ = |‖x + t • (ω : Euclidean d) - y‖ - ‖t • (ω : Euclidean d)‖| := by rw [htw]
        _ ≤ ‖(x + t • (ω : Euclidean d) - y) - t • (ω : Euclidean d)‖ :=
          abs_norm_sub_norm_le _ _
        _ = ‖x - y‖ := by congr 1; abel
        _ ≤ ‖x‖ + ‖y‖ := norm_sub_le _ _
        _ ≤ R + r := add_le_add hx hy'
    rw [hfg _ hdist]

/-- Smooth annular input localization avoids applying a Schwartz estimate
to discontinuous indicator truncations in the proof of `lem:k<j`. -/
theorem exists_schwartz_shell_cutoff (d : ℕ) {c R : ℝ}
    (hc : 1 ≤ c) (hR : 0 < R) (hR' : R ≤ 1 / 16) :
    ∃ χ : SchwartzMap (Euclidean d) ℂ,
      (∀ y, |‖y‖ - c| ≤ 2 * R → χ y = 1) ∧
      (∀ y, 3 * R ≤ |‖y‖ - c| → χ y = 0) ∧
      (∀ y, ‖χ y‖ ≤ 1) := by
  let outer : ContDiffBump (0 : Euclidean d) :=
    ⟨c + 2 * R, c + 3 * R, by linarith, by linarith⟩
  let inner : ContDiffBump (0 : Euclidean d) :=
    ⟨c - 3 * R, c - 2 * R, by linarith, by linarith⟩
  let u : Euclidean d → ℝ := fun y => outer y * (1 - inner y)
  have hu : HasCompactSupport u := outer.hasCompactSupport.mul_right
  have hs : ContDiff ℝ (⊤ : ℕ∞) u := outer.contDiff.mul (contDiff_const.sub inner.contDiff)
  have huc : HasCompactSupport (fun y => (u y : ℂ)) := by
    have hh := hu.comp_left (g := Complex.ofReal) (by simp)
    exact hh
  have hsc : ContDiff ℝ (⊤ : ℕ∞) (fun y => (u y : ℂ)) := by
    have hh := Complex.ofRealCLM.contDiff.comp hs
    exact hh
  refine ⟨huc.toSchwartzMap hsc, ?_, ?_, ?_⟩
  · intro y hy
    have hy' := abs_le.mp hy
    have ho : outer y = 1 := outer.one_of_mem_closedBall (by
      change dist y 0 ≤ c + 2 * R
      rw [dist_zero_right]
      linarith)
    have hi : inner y = 0 := inner.zero_of_le_dist (by
      change c - 2 * R ≤ dist y 0
      rw [dist_zero_right]
      linarith)
    change (outer y * (1 - inner y) : ℝ) = (1 : ℂ)
    simp [ho, hi]
  · intro y hy
    change (outer y * (1 - inner y) : ℝ) = (0 : ℂ)
    rcases le_abs.mp hy with hy | hy
    · have ho : outer y = 0 := outer.zero_of_le_dist (by
        change c + 3 * R ≤ dist y 0
        rw [dist_zero_right]
        linarith)
      simp [ho]
    · have hi : inner y = 1 := inner.one_of_mem_closedBall (by
        change dist y 0 ≤ c - 3 * R
        rw [dist_zero_right]
        linarith)
      simp [hi]
  · intro y
    change ‖((outer y * (1 - inner y) : ℝ) : ℂ)‖ ≤ 1
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg
      (mul_nonneg outer.nonneg (sub_nonneg.mpr inner.le_one))]
    calc
      outer y * (1 - inner y) ≤ outer y * 1 :=
        mul_le_mul_of_nonneg_left (sub_le_self _ inner.nonneg) outer.nonneg
      _ ≤ 1 := by simpa using outer.le_one (x := y)

/-- The enlarged thin input annuli have uniformly bounded overlap. -/
theorem thin_shell_overlap_card_le (I : Finset ℤ) {R : ℝ} (hR : 0 < R) (u : ℝ) :
    (I.filter (fun m : ℤ => |u - (m : ℝ) * R| < 3 * R)).card ≤ 8 := by
  classical
  let n : ℤ := ⌊u / R⌋
  have hsub : I.filter (fun m : ℤ => |u - (m : ℝ) * R| < 3 * R) ⊆
      Finset.Icc (n - 3) (n + 4) := by
    intro m hm
    have hab := abs_lt.mp (Finset.mem_filter.mp hm).2
    have h₁ : u / R < (m : ℝ) + 3 := (div_lt_iff₀ hR).mpr (by nlinarith)
    have h₂ : (m : ℝ) - 3 < u / R := (lt_div_iff₀ hR).mpr (by nlinarith)
    have hn₁ : (n : ℝ) ≤ u / R := Int.floor_le _
    have hn₂ : u / R < (n : ℝ) + 1 := Int.lt_floor_add_one _
    have hl : (n : ℝ) - 3 ≤ m := by linarith
    have hr : (m : ℝ) ≤ (n : ℝ) + 4 := by linarith
    rw [Finset.mem_Icc]
    constructor
    · exact_mod_cast hl
    · exact_mod_cast hr
  apply (Finset.card_le_card hsub).trans
  rw [Int.card_Icc]
  omega

/-- Summing the moments of smoothly localized inputs costs only the
eightfold overlap of the enlarged thin annuli. -/
theorem thin_shell_sum_moments_le {d : ℕ} (I : Finset ℤ) {R p : ℝ}
    (hR : 0 < R) (hp : 0 < p) (f : SchwartzMap (Euclidean d) ℂ)
    (g : ℤ → SchwartzMap (Euclidean d) ℂ)
    (hnorm : ∀ m ∈ I, ∀ x, ‖g m x‖ ≤ ‖f x‖)
    (hsupp : ∀ m ∈ I, ∀ x, 3 * R ≤ |‖x‖ - (m : ℝ) * R| → g m x = 0) :
    (∑ m ∈ I, ∫⁻ x, ‖g m x‖ₑ ^ p) ≤ 8 * ∫⁻ x, ‖f x‖ₑ ^ p := by
  classical
  have hpoint (x : Euclidean d) : (∑ m ∈ I, ‖g m x‖ₑ ^ p) ≤ 8 * ‖f x‖ₑ ^ p := by
    let J := I.filter (fun m : ℤ => |‖x‖ - (m : ℝ) * R| < 3 * R)
    have heq : (∑ m ∈ I, ‖g m x‖ₑ ^ p) = ∑ m ∈ J, ‖g m x‖ₑ ^ p := by
      symm
      apply Finset.sum_subset (Finset.filter_subset _ _)
      intro m hm hmJ
      have hzero : g m x = 0 := hsupp m hm x (by
        by_contra hh
        exact hmJ (Finset.mem_filter.mpr ⟨hm, lt_of_not_ge hh⟩))
      rw [hzero, enorm_zero, ENNReal.zero_rpow_of_pos hp]
    rw [heq]
    calc
      _ ≤ ∑ _m ∈ J, ‖f x‖ₑ ^ p := by
        apply Finset.sum_le_sum
        intro m hm
        apply ENNReal.rpow_le_rpow _ hp.le
        simpa only [← ofReal_norm] using
          ENNReal.ofReal_le_ofReal (hnorm m (Finset.mem_filter.mp hm).1 x)
      _ = (J.card : ℝ≥0∞) * ‖f x‖ₑ ^ p := by rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ 8 * ‖f x‖ₑ ^ p := mul_le_mul' (by
        exact_mod_cast thin_shell_overlap_card_le I hR ‖x‖) le_rfl
  calc
    _ = ∫⁻ x, ∑ m ∈ I, ‖g m x‖ₑ ^ p :=
      (lintegral_finsetSum I (fun m _ => (g m).continuous.measurable.enorm.pow_const p)).symm
    _ ≤ ∫⁻ x, 8 * ‖f x‖ₑ ^ p := lintegral_mono hpoint
    _ = _ := lintegral_const_mul _ (f.continuous.measurable.enorm.pow_const p)

/-- A Schwartz input may be localized to one enlarged thin annulus without
changing the smoothed averages on the corresponding output ball and radius window. -/
theorem exists_schwartz_shell_localization {d : ℕ}
    (K f : SchwartzMap (Euclidean d) ℂ) {c R : ℝ}
    (hc : 1 ≤ c) (hR : 0 < R) (hR' : R ≤ 1 / 16)
    (hK : ∀ y, R / 2 < ‖y‖ → K y = 0) :
    ∃ g : SchwartzMap (Euclidean d) ℂ,
      (∀ y, ‖g y‖ ≤ ‖f y‖) ∧
      (∀ y, 3 * R ≤ |‖y‖ - c| → g y = 0) ∧
      (∀ t, 0 ≤ t → |t - c| ≤ R / 2 → ∀ x, ‖x‖ ≤ R →
        sphericalAverage d (compactConvolution K f) t x =
          sphericalAverage d (compactConvolution K g) t x) := by
  obtain ⟨χ, hχ₁, hχ₀, hχn⟩ := exists_schwartz_shell_cutoff d hc hR hR'
  let g := SchwartzMap.smulLeftCLM ℂ (χ : Euclidean d → ℂ) f
  have hg (y) : g y = χ y * f y := by
    simp only [g, SchwartzMap.smulLeftCLM_apply χ.hasTemperateGrowth, smul_eq_mul]
  refine ⟨g, ?_, ?_, ?_⟩
  · intro y
    rw [hg, norm_mul]
    simpa only [one_mul] using mul_le_mul_of_nonneg_right (hχn y) (norm_nonneg (f y))
  · intro y hy
    rw [hg, hχ₀ y hy, zero_mul]
  · intro t ht htc x hx
    rw [← smoothInput_eq_compactConvolution, ← smoothInput_eq_compactConvolution]
    apply sphericalAverage_smoothInput_congr_on_shell K f g hK hx ht
    intro y hy
    have hdist : |‖y‖ - c| ≤ 2 * R := by
      calc
        _ = |(‖y‖ - t) + (t - c)| := by congr 1; ring
        _ ≤ |‖y‖ - t| + |t - c| := abs_add_le _ _
        _ ≤ 2 * R := by linarith
    rw [hg, hχ₁ y hdist, one_mul]

/-- At high frequency the synthesis support is smaller than half the
output-ball radius, as required for thin-annulus localization. -/
theorem synthesis_highFrequency_support {d : ℕ}
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hφ : ∀ x, (1 : ℝ) / 8 < ‖x‖ → φ x = 0)
    {j k : ℕ} (hj : 0 < j) (hkj : k ≤ j) :
    ∀ x, (((2 : ℝ) ^ k)⁻¹) / 2 < ‖x‖ → compactSynthesisKernel φ j x = 0 := by
  obtain ⟨i, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hj)
  intro x hx
  rw [compactSynthesisKernel_succ φ i]
  apply compactDyadicDilate_eq_zero
    (compactSynthesisKernel_eq_zero φ (by norm_num : (0 : ℝ) ≤ 1 / 8) hφ 1) i
  have he : (2 * ((1 : ℝ) / 8)) / 2 ^ i = ((2 : ℝ) ^ (i + 1))⁻¹ / 2 := by
    rw [pow_succ]
    field_simp
    ring
  rw [he]
  apply lt_of_le_of_lt _ hx
  apply div_le_div_of_nonneg_right _ (by norm_num)
  have hh := one_div_le_one_div_of_le (by positivity : (0 : ℝ) < 2 ^ k)
    (pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2) hkj)
  simpa only [one_div] using hh

/-- Supremums of Schwartz spherical averages over arbitrary radius sets
are measurable by lower semicontinuity in the spatial variable. -/
theorem measurable_schwartz_radius_supremum {d : ℕ}
    (f : SchwartzMap (Euclidean d) ℂ) (E : Set ℝ) :
    Measurable (fun x => ⨆ t : E, ‖sphericalAverage d f t x‖ₑ) := by
  have hc (t : E) : Continuous (fun x => ‖sphericalAverage d f t x‖ₑ) := by
    rw [← schwartzSphericalAverage_apply]
    exact (schwartzSphericalAverage f t).continuous.enorm
  exact (lowerSemicontinuous_iSup (fun t => (hc t).lowerSemicontinuous)).measurable

/-- Finite radius-window reassembly after localizing the input separately
on each window. The equality is required only on the measured output set. -/
theorem spherical_radius_window_reassembly {d : ℕ} (I : Finset ℤ)
    (E : Set ℝ) (W : ℤ → Set ℝ) (B : Set (Euclidean d))
    (hB : MeasurableSet B) (f : SchwartzMap (Euclidean d) ℂ)
    (g : ℤ → SchwartzMap (Euclidean d) ℂ) {p : ℝ} (hp : 0 < p)
    (hcover : ∀ t ∈ E, ∃ m ∈ I, t ∈ W m)
    (heq : ∀ m ∈ I, ∀ t ∈ E ∩ W m, ∀ x ∈ B,
      sphericalAverage d f t x = sphericalAverage d (g m) t x) :
    (∫⁻ x in B, (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p) ≤
      ∑ m ∈ I, ∫⁻ x in B, (⨆ t : (E ∩ W m : Set ℝ), ‖sphericalAverage d (g m) t x‖ₑ) ^ p := by
  have hpoint (x : Euclidean d) (hx : x ∈ B) :
      (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p ≤
        ∑ m ∈ I, (⨆ t : (E ∩ W m : Set ℝ), ‖sphericalAverage d (g m) t x‖ₑ) ^ p := by
    apply (ENNReal.le_rpow_inv_iff hp).mp
    apply iSup_le
    intro t
    apply (ENNReal.le_rpow_inv_iff hp).mpr
    obtain ⟨m, hm, htm⟩ := hcover t t.property
    rw [heq m hm t ⟨t.property, htm⟩ x hx]
    apply (ENNReal.rpow_le_rpow
      (le_iSup (fun t : (E ∩ W m : Set ℝ) => ‖sphericalAverage d (g m) t x‖ₑ)
        ⟨t, t.property, htm⟩) hp.le).trans
    exact Finset.single_le_sum
      (f := fun m => (⨆ t : (E ∩ W m : Set ℝ),
        ‖sphericalAverage d (g m) t x‖ₑ) ^ p) (fun _ _ => bot_le) hm
  calc
    _ ≤ ∫⁻ x in B, ∑ m ∈ I,
        (⨆ t : (E ∩ W m : Set ℝ), ‖sphericalAverage d (g m) t x‖ₑ) ^ p := by
      apply lintegral_mono_ae
      filter_upwards [ae_restrict_mem hB] with x hx
      exact hpoint x hx
    _ = _ := lintegral_finsetSum I
      (fun m _ => (measurable_schwartz_radius_supremum (g m) (E ∩ W m)).pow_const p)

/-- Source `lem:k<j`, unweighted ball form with a uniform finite-cover
bound on the thin radius windows. The input is a genuine Schwartz function. -/
theorem synthesis_thinWindow_Lp_bound {d N : ℕ} (hd : 2 ≤ d)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N)
    (hφ : ∀ x, (1 : ℝ) / 8 < ‖x‖ → φ x = 0)
    {p : ℝ} (hp₁ : 1 < p) (hp₂ : p < 2) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (j k : ℕ), 0 < j → k ≤ j →
      (((2 : ℝ) ^ k)⁻¹) ≤ 1 / 16 →
      ∀ (E : Set ℝ), E ⊆ Icc 1 2 → ∀ (I : Finset ℤ),
      (∀ m ∈ I, 1 ≤ (m : ℝ) * (((2 : ℝ) ^ k)⁻¹)) →
      (∀ t ∈ E, ∃ m ∈ I,
        |t - (m : ℝ) * (((2 : ℝ) ^ k)⁻¹)| ≤ (((2 : ℝ) ^ k)⁻¹) / 2) →
      ∀ (M : ℝ≥0∞),
      (∀ m ∈ I, ∃ J : Finset ℝ,
        IsIntervalCover
          (E ∩ {t | |t - (m : ℝ) * (((2 : ℝ) ^ k)⁻¹)| ≤ (((2 : ℝ) ^ k)⁻¹) / 2})
          (((2 : ℝ) ^ j)⁻¹) J ∧ (J.card : ℝ≥0∞) ≤ M) →
      ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) (((2 : ℝ) ^ k)⁻¹),
        (⨆ t : E,
          ‖sphericalAverage d (compactConvolution (compactSynthesisKernel φ j) f) t x‖ₑ) ^ p) ≤
        A * M * (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
          (k : ℝ) * ((d : ℝ) - 1) * (2 - p)) * ∫⁻ x, ‖f x‖ₑ ^ p := by
  classical
  obtain ⟨A, hA, hb⟩ := synthesis_finiteCover_Lp_bound hd φ hflat hN hp₁ hp₂
  refine ⟨A * 8, ENNReal.mul_ne_top hA (by norm_num), ?_⟩
  intro j k hj hkj hk E hE I hcenter hcover M hM f
  let R : ℝ := ((2 : ℝ) ^ k)⁻¹
  let K := compactSynthesisKernel φ j
  let W : ℤ → Set ℝ := fun m => {t | |t - (m : ℝ) * R| ≤ R / 2}
  let Q : ℝ≥0∞ := (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
    (k : ℝ) * ((d : ℝ) - 1) * (2 - p))
  have hR : 0 < R := by dsimp only [R]; positivity
  have hK : ∀ y, R / 2 < ‖y‖ → K y = 0 := synthesis_highFrequency_support φ hφ hj hkj
  have hex (m : ℤ) : ∃ g : SchwartzMap (Euclidean d) ℂ, m ∈ I →
      (∀ y, ‖g y‖ ≤ ‖f y‖) ∧
      (∀ y, 3 * R ≤ |‖y‖ - (m : ℝ) * R| → g y = 0) ∧
      (∀ t, 0 ≤ t → t ∈ W m → ∀ x, ‖x‖ ≤ R →
        sphericalAverage d (compactConvolution K f) t x =
          sphericalAverage d (compactConvolution K g) t x) := by
    by_cases hm : m ∈ I
    · obtain ⟨g, hg⟩ := exists_schwartz_shell_localization K f (hcenter m hm) hR hk hK
      exact ⟨g, fun _ => hg⟩
    · exact ⟨0, fun hh => (hm hh).elim⟩
  choose g hg using hex
  have hlocal (m : ℤ) (hm : m ∈ I) :
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) R,
        (⨆ t : (E ∩ W m : Set ℝ),
          ‖sphericalAverage d (compactConvolution K (g m)) t x‖ₑ) ^ p) ≤
        (A * M * Q) * ∫⁻ x, ‖g m x‖ₑ ^ p := by
    obtain ⟨J, hJ, hcard⟩ := hM m hm
    apply (hb j k hj (E ∩ W m) (fun t ht => hE ht.1) J hJ (g m)).trans
    dsimp only [Q]
    exact mul_le_mul' (mul_le_mul' (mul_le_mul' le_rfl hcard)
      le_rfl) le_rfl
  have hsum := thin_shell_sum_moments_le I hR (by linarith : 0 < p) f g
    (fun m hm => (hg m hm).1) (fun m hm => (hg m hm).2.1)
  have hreassemble := spherical_radius_window_reassembly I E W
    (Metric.closedBall (0 : Euclidean d) R) measurableSet_closedBall
    (compactConvolution K f) (fun m => compactConvolution K (g m))
    (by linarith : 0 < p) hcover
    (fun m hm t ht x hx => (hg m hm).2.2 t (by linarith [(hE ht.1).1]) ht.2 x
      (by simpa only [Metric.mem_closedBall, dist_zero_right] using hx))
  apply hreassemble.trans
  calc
    _ ≤ ∑ m ∈ I, (A * M * Q) * ∫⁻ x, ‖g m x‖ₑ ^ p := Finset.sum_le_sum hlocal
    _ = (A * M * Q) * ∑ m ∈ I, ∫⁻ x, ‖g m x‖ₑ ^ p := (Finset.mul_sum ..).symm
    _ ≤ (A * M * Q) * (8 * ∫⁻ x, ‖f x‖ₑ ^ p) := mul_le_mul' le_rfl hsum
    _ = _ := by dsimp only [Q]; ring

/-- The weight on a dyadic output annulus contributes the expected power
of its radius, with a constant depending only on the weight exponent. -/
theorem dyadic_annulus_weight_moment_le {d : ℕ} (G : Euclidean d → ℝ≥0∞)
    (hG : Measurable G) (α : ℝ) (k : ℕ) :
    (∫⁻ x in euclideanAnnulus d ((((2 : ℝ) ^ k)⁻¹) / 2) (((2 : ℝ) ^ k)⁻¹),
      G x ∂powerWeightedVolume d α) ≤
      ((2 : ℝ≥0∞) ^ (-α) + 1) * (2 : ℝ≥0∞) ^ (-((k : ℝ) * α)) *
        ∫⁻ x in Metric.closedBall (0 : Euclidean d) (((2 : ℝ) ^ k)⁻¹), G x := by
  let R : ℝ := ((2 : ℝ) ^ k)⁻¹
  have hR : 0 < R := by dsimp only [R]; positivity
  have he : ENNReal.ofReal R ^ α = (2 : ℝ≥0∞) ^ (-((k : ℝ) * α)) := by
    dsimp only [R]
    rw [ENNReal.ofReal_inv_of_pos (by positivity), ENNReal.ofReal_pow (by norm_num)]
    norm_num only [ENNReal.ofReal_ofNat]
    rw [← ENNReal.rpow_natCast, ← ENNReal.rpow_neg_one, ← ENNReal.rpow_mul,
      ← ENNReal.rpow_mul]
    congr 1
    ring
  have hehalf : ENNReal.ofReal (R / 2) ^ α =
      (2 : ℝ≥0∞) ^ (-α) * (2 : ℝ≥0∞) ^ (-((k : ℝ) * α)) := by
    rw [div_eq_mul_inv, ENNReal.ofReal_mul hR.le,
      ENNReal.mul_rpow_of_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top, he,
      ENNReal.ofReal_inv_of_pos (by norm_num : (0 : ℝ) < 2)]
    norm_num only [ENNReal.ofReal_ofNat]
    rw [ENNReal.inv_rpow, ← ENNReal.rpow_neg, mul_comm]
  have hsub : euclideanAnnulus d (R / 2) R ⊆ Metric.closedBall (0 : Euclidean d) R :=
    fun _ hx => hx.1
  by_cases hα : α ≤ 0
  · have hh := setLIntegral_powerWeightedVolume_euclideanAnnulus_le (R := R) hα
      (by positivity : 0 < R / 2) G hG
    apply hh.trans
    rw [hehalf]
    exact mul_le_mul' (mul_le_mul' (le_add_right le_rfl) le_rfl)
      (lintegral_mono_set hsub)
  · have hh := setLIntegral_powerWeightedVolume_euclideanAnnulus_le_nonneg
      (le_of_not_ge hα) (r := R / 2) (R := R) G hG
    apply hh.trans
    rw [he]
    calc
      _ = 1 * (2 : ℝ≥0∞) ^ (-((k : ℝ) * α)) *
          ∫⁻ x in euclideanAnnulus d (R / 2) R, G x := by rw [one_mul]
      _ ≤ _ := mul_le_mul' (mul_le_mul' (le_add_left le_rfl) le_rfl)
        (lintegral_mono_set hsub)

/-- A finite dyadic grid inside `[1,2]` covers that interval by centered
windows of length `2⁻ᵏ`. Its centers remain in the admissible radius range. -/
theorem dyadic_radius_grid_cover (k : ℕ) :
    ∃ I : Finset ℤ,
      (∀ m ∈ I, (m : ℝ) * (((2 : ℝ) ^ k)⁻¹) ∈ Icc 1 2) ∧
      (∀ t ∈ Icc (1 : ℝ) 2, ∃ m ∈ I,
        |t - (m : ℝ) * (((2 : ℝ) ^ k)⁻¹)| ≤ (((2 : ℝ) ^ k)⁻¹) / 2) := by
  let n : ℤ := 2 ^ k
  have hn : (n : ℝ) = (2 : ℝ) ^ k := by simp [n]
  have hnpos : 0 < (n : ℝ) := by rw [hn]; positivity
  refine ⟨Finset.Icc n (2 * n), ?_, ?_⟩
  · intro m hm
    have hm' := Finset.mem_Icc.mp hm
    have hl : (n : ℝ) ≤ m := by exact_mod_cast hm'.1
    have hr : (m : ℝ) ≤ 2 * n := by exact_mod_cast hm'.2
    rw [← hn, ← div_eq_mul_inv]
    exact ⟨(le_div_iff₀ hnpos).mpr (by linarith),
      (div_le_iff₀ hnpos).mpr (by linarith)⟩
  · intro t ht
    let m : ℤ := ⌊(n : ℝ) * t + 1 / 2⌋
    have hlo : (m : ℝ) ≤ (n : ℝ) * t + 1 / 2 := Int.floor_le _
    have hhi : (n : ℝ) * t + 1 / 2 < (m : ℝ) + 1 := Int.lt_floor_add_one _
    have hmlo : n ≤ m := by
      have hh : (n : ℝ) < (m : ℝ) + 1 := by nlinarith [ht.1]
      have hh' : n < m + 1 := by exact_mod_cast hh
      omega
    have hmhi : m ≤ 2 * n := by
      have hh : (m : ℝ) < (2 * n : ℤ) + 1 := by
        push_cast
        nlinarith [ht.2]
      have hh' : m < 2 * n + 1 := by exact_mod_cast hh
      omega
    refine ⟨m, Finset.mem_Icc.mpr ⟨hmlo, hmhi⟩, ?_⟩
    rw [← hn, ← div_eq_mul_inv]
    apply abs_le.mpr
    constructor
    · have hh : (m : ℝ) / n ≤ t + (n : ℝ)⁻¹ / 2 := by
        apply (div_le_iff₀ hnpos).mpr
        have hh : (n : ℝ)⁻¹ * n = 1 := inv_mul_cancel₀ hnpos.ne'
        nlinarith
      linarith
    · have hh : t - (n : ℝ)⁻¹ / 2 ≤ (m : ℝ) / n := by
        apply (le_div_iff₀ hnpos).mpr
        have hh : (n : ℝ)⁻¹ * n = 1 := inv_mul_cancel₀ hnpos.ne'
        nlinarith
      linarith

/-- Assouad interval covers control each centered thin radius window,
including the windows meeting the endpoints of `[1,2]`. -/
theorem thin_window_cover_of_assouad {E : Set ℝ} (hE : E ⊆ Icc 1 2)
    {C γ δ R c : ℝ} (hC : 0 ≤ C) (hγ : 0 ≤ γ)
    (hδ : 0 < δ) (hδR : δ ≤ R) (hR : R ≤ 1) (hc : c ∈ Icc 1 2)
    (hcover : ∀ a b : ℝ, 1 ≤ a → a ≤ b → b ≤ 2 → δ ≤ b - a →
      ∃ J : Finset ℝ, IsIntervalCover (E ∩ Icc a b) δ J ∧
        (J.card : ℝ) ≤ C * ((b - a) / δ) ^ γ) :
    ∃ J : Finset ℝ, IsIntervalCover (E ∩ {t | |t - c| ≤ R / 2}) δ J ∧
      (J.card : ℝ≥0∞) ≤ ENNReal.ofReal (C * ((2 * R) / δ) ^ γ) := by
  let a := max 1 (c - R)
  let b := min 2 (c + R)
  have hR0 : 0 < R := hδ.trans_le hδR
  have hac : a ≤ c := max_le hc.1 (by linarith)
  have hcb : c ≤ b := le_min hc.2 (by linarith)
  have hlen : R ≤ b - a := by
    dsimp only [a, b]
    rcases le_total (1 : ℝ) (c - R) with hh | hh <;>
      rcases le_total (2 : ℝ) (c + R) with hh' | hh'
    · rw [max_eq_right hh, min_eq_left hh']; linarith [hc.2]
    · rw [max_eq_right hh, min_eq_right hh']; linarith
    · rw [max_eq_left hh, min_eq_left hh']; linarith
    · rw [max_eq_left hh, min_eq_right hh']; linarith [hc.1]
  have hlen' : b - a ≤ 2 * R := by
    have ha : c - R ≤ a := le_max_right _ _
    have hb : b ≤ c + R := min_le_right _ _
    linarith
  obtain ⟨J, hJ, hcard⟩ := hcover a b (le_max_left _ _) (hac.trans hcb)
    (min_le_left _ _) (hδR.trans hlen)
  refine ⟨J, ?_, ?_⟩
  · intro t ht
    have htt := abs_le.mp (show |t - c| ≤ R / 2 from ht.2)
    exact hJ ⟨ht.1, max_le (hE ht.1).1 (by linarith),
      le_min (hE ht.1).2 (by linarith)⟩
  · have hcard' : (J.card : ℝ) ≤ C * ((2 * R) / δ) ^ γ :=
      hcard.trans (mul_le_mul_of_nonneg_left
        (Real.rpow_le_rpow (div_nonneg (by linarith) hδ.le)
          (div_le_div_of_nonneg_right hlen' hδ.le) hγ) hC)
    simpa only [ENNReal.ofReal_natCast] using ENNReal.ofReal_le_ofReal hcard'

/-- Source `lem:k<j` combined with the Assouad cover estimate, before
collecting the dyadic powers. This is a weighted Schwartz-core estimate. -/
theorem synthesis_assouad_weighted_bound {d N : ℕ} (hd : 2 ≤ d)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N)
    (hφ : ∀ x, (1 : ℝ) / 8 < ‖x‖ → φ x = 0)
    {p : ℝ} (hp₁ : 1 < p) (hp₂ : p < 2) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (E : Set ℝ), E ⊆ Icc 1 2 →
      ∀ (C γ α : ℝ), 0 ≤ C → 0 ≤ γ →
      (∀ δ a b : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ a → a ≤ b → b ≤ 2 → δ ≤ b - a →
        ∃ J : Finset ℝ, IsIntervalCover (E ∩ Icc a b) δ J ∧
          (J.card : ℝ) ≤ C * ((b - a) / δ) ^ γ) →
      ∀ (j k : ℕ), 4 ≤ k → k ≤ j → ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x in euclideanAnnulus d ((((2 : ℝ) ^ k)⁻¹) / 2) (((2 : ℝ) ^ k)⁻¹),
        (⨆ t : E,
          ‖sphericalAverage d (compactConvolution (compactSynthesisKernel φ j) f) t x‖ₑ) ^ p
          ∂powerWeightedVolume d α) ≤
        ((2 : ℝ≥0∞) ^ (-α) + 1) * (2 : ℝ≥0∞) ^ (-((k : ℝ) * α)) *
          (A * ENNReal.ofReal (C * ((2 * (((2 : ℝ) ^ k)⁻¹)) /
            (((2 : ℝ) ^ j)⁻¹)) ^ γ) *
            (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
              (k : ℝ) * ((d : ℝ) - 1) * (2 - p)) * ∫⁻ x, ‖f x‖ₑ ^ p) := by
  obtain ⟨A, hA, hb⟩ := synthesis_thinWindow_Lp_bound hd φ hflat hN hφ hp₁ hp₂
  refine ⟨A, hA, ?_⟩
  intro E hE C γ α hC hγ hcover j k hk hkj f
  have hR : 0 < ((2 : ℝ) ^ k)⁻¹ := by positivity
  have hδ : 0 < ((2 : ℝ) ^ j)⁻¹ := by positivity
  have hsmall : ((2 : ℝ) ^ k)⁻¹ ≤ 1 / 16 := by
    have hh := one_div_le_one_div_of_le (by norm_num : (0 : ℝ) < 2 ^ 4)
      (pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2) hk)
    norm_num at hh ⊢
    exact hh
  have hδR : ((2 : ℝ) ^ j)⁻¹ ≤ ((2 : ℝ) ^ k)⁻¹ := by
    simpa only [one_div] using one_div_le_one_div_of_le (by positivity : (0 : ℝ) < 2 ^ k)
      (pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2) hkj)
  obtain ⟨I, hI, hgrid⟩ := dyadic_radius_grid_cover k
  have hM (m : ℤ) (hm : m ∈ I) := thin_window_cover_of_assouad hE hC hγ hδ hδR
    (by linarith : ((2 : ℝ) ^ k)⁻¹ ≤ 1) (hI m hm)
    (fun a b ha hab hb hs => hcover _ a b hδ (by linarith) ha hab hb hs)
  have hu := hb j k (by omega) hkj hsmall E hE I (fun m hm => (hI m hm).1)
    (fun t ht => hgrid t (hE ht)) _ hM f
  have hw := dyadic_annulus_weight_moment_le
    (fun x => (⨆ t : E,
      ‖sphericalAverage d (compactConvolution (compactSynthesisKernel φ j) f) t x‖ₑ) ^ p)
    ((measurable_schwartz_radius_supremum
      (compactConvolution (compactSynthesisKernel φ j) f) E).pow_const p) α k
  exact hw.trans (mul_le_mul' le_rfl hu)

/-- Dyadic covering ratios contribute precisely the Assouad exponent. -/
theorem dyadic_cover_factor (j k : ℕ) (C γ : ℝ) (hC : 0 ≤ C) :
    ENNReal.ofReal (C * ((2 * (((2 : ℝ) ^ k)⁻¹)) / (((2 : ℝ) ^ j)⁻¹)) ^ γ) =
      ENNReal.ofReal C * (2 : ℝ≥0∞) ^ (((j : ℝ) - k + 1) * γ) := by
  have he : (2 * (((2 : ℝ) ^ k)⁻¹)) / (((2 : ℝ) ^ j)⁻¹) =
      (2 : ℝ) ^ ((j : ℝ) - k + 1) := by
    rw [Real.rpow_add (by norm_num : (0 : ℝ) < 2),
      Real.rpow_sub (by norm_num : (0 : ℝ) < 2), Real.rpow_one,
      Real.rpow_natCast, Real.rpow_natCast, div_inv_eq_mul, div_eq_mul_inv]
    ring
  rw [he, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2), ENNReal.ofReal_mul hC,
    ← ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 2)]
  norm_num

/-- At weight `1-d`, the spatial and Fourier powers combine into decay
in the difference of the frequency and spatial dyadic indices. -/
theorem endpoint_dyadic_decay_identity (d j k : ℕ) (p γ : ℝ) :
    (2 : ℝ≥0∞) ^ (-((k : ℝ) * (1 - (d : ℝ)))) *
      (2 : ℝ≥0∞) ^ (((j : ℝ) - k + 1) * γ) *
      (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
        (k : ℝ) * ((d : ℝ) - 1) * (2 - p)) =
      (2 : ℝ≥0∞) ^ γ * (2 : ℝ≥0∞) ^
        (-(((j : ℝ) - k) * (((d : ℝ) - 1) * (p - 1) - γ))) := by
  rw [← ENNReal.rpow_add _ _ (by norm_num : (2 : ℝ≥0∞) ≠ 0)
    (by norm_num : (2 : ℝ≥0∞) ≠ ∞),
    ← ENNReal.rpow_add _ _ (by norm_num : (2 : ℝ≥0∞) ≠ 0)
      (by norm_num : (2 : ℝ≥0∞) ≠ ∞),
    ← ENNReal.rpow_add _ _ (by norm_num : (2 : ℝ≥0∞) ≠ 0)
      (by norm_num : (2 : ℝ≥0∞) ≠ ∞)]
  congr 1
  ring

/-- The high-frequency weighted diagonal estimate at weight `1-d`, with
decay exponent `(d-1)(p-1)-γ`, on Schwartz inputs. -/
theorem synthesis_assouad_endpoint_decay {d N : ℕ} (hd : 2 ≤ d)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N)
    (hφ : ∀ x, (1 : ℝ) / 8 < ‖x‖ → φ x = 0)
    {p γ : ℝ} (hp₁ : 1 < p) (hp₂ : p < 2) (hγ : 0 ≤ γ) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (E : Set ℝ), E ⊆ Icc 1 2 →
      ∀ (C : ℝ), 0 ≤ C →
      (∀ δ a b : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ a → a ≤ b → b ≤ 2 → δ ≤ b - a →
        ∃ J : Finset ℝ, IsIntervalCover (E ∩ Icc a b) δ J ∧
          (J.card : ℝ) ≤ C * ((b - a) / δ) ^ γ) →
      ∀ (j k : ℕ), 4 ≤ k → k ≤ j → ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x in euclideanAnnulus d ((((2 : ℝ) ^ k)⁻¹) / 2) (((2 : ℝ) ^ k)⁻¹),
        (⨆ t : E,
          ‖sphericalAverage d (compactConvolution (compactSynthesisKernel φ j) f) t x‖ₑ) ^ p
          ∂powerWeightedVolume d (1 - (d : ℝ))) ≤
        A * ENNReal.ofReal C * (2 : ℝ≥0∞) ^
          (-(((j : ℝ) - k) * (((d : ℝ) - 1) * (p - 1) - γ))) *
          ∫⁻ x, ‖f x‖ₑ ^ p := by
  obtain ⟨A, hA, hb⟩ := synthesis_assouad_weighted_bound hd φ hflat hN hφ hp₁ hp₂
  let B := ((2 : ℝ≥0∞) ^ (-(1 - (d : ℝ))) + 1) * A * (2 : ℝ≥0∞) ^ γ
  have hB : B ≠ ∞ := by
    apply ENNReal.mul_ne_top _ (ENNReal.rpow_ne_top_of_nonneg hγ (by norm_num))
    apply ENNReal.mul_ne_top _ hA
    apply ENNReal.add_ne_top.mpr
    refine ⟨ENNReal.rpow_ne_top_of_nonneg ?_ (by norm_num), by norm_num⟩
    have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
    linarith
  refine ⟨B, hB, ?_⟩
  intro E hE C hC hcover j k hk hkj f
  apply (hb E hE C γ (1 - (d : ℝ)) hC hγ hcover j k hk hkj f).trans_eq
  rw [dyadic_cover_factor j k C γ hC]
  calc
    _ = (((2 : ℝ≥0∞) ^ (-(1 - (d : ℝ))) + 1) * A * ENNReal.ofReal C) *
        ((2 : ℝ≥0∞) ^ (-((k : ℝ) * (1 - (d : ℝ)))) *
          (2 : ℝ≥0∞) ^ (((j : ℝ) - k + 1) * γ) *
          (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
            (k : ℝ) * ((d : ℝ) - 1) * (2 - p))) * ∫⁻ x, ‖f x‖ₑ ^ p := by ring
    _ = _ := by rw [endpoint_dyadic_decay_identity]; dsimp only [B]; ring

/-- Source `eq:LpellpS`, diagonal moment-sum form on Schwartz sequences.
The constant is uniform in the finite set of spatial scales and the shift. -/
theorem synthesis_assouad_diagonal_sum {d N : ℕ} (hd : 2 ≤ d)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N)
    (hφ : ∀ x, (1 : ℝ) / 8 < ‖x‖ → φ x = 0)
    {p γ : ℝ} (hp₁ : 1 < p) (hp₂ : p < 2) (hγ : 0 ≤ γ) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (E : Set ℝ), E ⊆ Icc 1 2 →
      ∀ (C : ℝ), 0 ≤ C →
      (∀ δ a b : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ a → a ≤ b → b ≤ 2 → δ ≤ b - a →
        ∃ J : Finset ℝ, IsIntervalCover (E ∩ Icc a b) δ J ∧
          (J.card : ℝ) ≤ C * ((b - a) / δ) ^ γ) →
      ∀ (L : Finset ℕ), (∀ k ∈ L, 4 ≤ k) → ∀ (n : ℕ)
      (f : ℕ → SchwartzMap (Euclidean d) ℂ),
      (∑ k ∈ L, ∫⁻ x in euclideanAnnulus d
        ((((2 : ℝ) ^ k)⁻¹) / 2) (((2 : ℝ) ^ k)⁻¹),
        (⨆ t : E, ‖sphericalAverage d
          (compactConvolution (compactSynthesisKernel φ (k + n)) (f k)) t x‖ₑ) ^ p
          ∂powerWeightedVolume d (1 - (d : ℝ))) ≤
        A * ENNReal.ofReal C * (2 : ℝ≥0∞) ^
          (-((n : ℝ) * (((d : ℝ) - 1) * (p - 1) - γ))) *
          ∫⁻ x, ∑ k ∈ L, ‖f k x‖ₑ ^ p := by
  obtain ⟨A, hA, hb⟩ := synthesis_assouad_endpoint_decay hd φ hflat hN hφ hp₁ hp₂ hγ
  refine ⟨A, hA, ?_⟩
  intro E hE C hC hcover L hL n f
  have hi (k : ℕ) (hk : k ∈ L) := hb E hE C hC hcover (k + n) k (hL k hk)
    (Nat.le_add_right _ _) (f k)
  simp only [Nat.cast_add, add_sub_cancel_left] at hi
  calc
    _ ≤ ∑ k ∈ L, (A * ENNReal.ofReal C * (2 : ℝ≥0∞) ^
          (-((n : ℝ) * (((d : ℝ) - 1) * (p - 1) - γ)))) *
          ∫⁻ x, ‖f k x‖ₑ ^ p := Finset.sum_le_sum hi
    _ = _ := by
      rw [← Finset.mul_sum, lintegral_finsetSum L
        (fun k _ => (f k).continuous.measurable.enorm.pow_const p)]

/-- For disjoint output sets, a maximal norm of a finite sum has exactly
the sum of the localized moments. This is the diagonal sequence identity. -/
theorem disjoint_indicator_maximal_moment {X ι T : Type*} [MeasurableSpace X]
    (μ : Measure X) (I : Finset ι) (S : ι → Set X) (F : ι → T → X → ℂ)
    (hS : ∀ i, MeasurableSet (S i))
    (hdisj : Pairwise (Function.onFun Disjoint S))
    (hF : ∀ i, Measurable (fun x => ⨆ t, ‖F i t x‖ₑ)) {p : ℝ} (hp : 0 < p) :
    (∫⁻ x, (⨆ t, ‖∑ i ∈ I, (S i).indicator (F i t) x‖ₑ) ^ p ∂μ) =
      ∑ i ∈ I, ∫⁻ x in S i, (⨆ t, ‖F i t x‖ₑ) ^ p ∂μ := by
  classical
  have hpoint (x : X) :
      (⨆ t, ‖∑ i ∈ I, (S i).indicator (F i t) x‖ₑ) ^ p =
        ∑ i ∈ I, (S i).indicator (fun y => (⨆ t, ‖F i t y‖ₑ) ^ p) x := by
    by_cases hx : ∃ i ∈ I, x ∈ S i
    · obtain ⟨i, hi, hxi⟩ := hx
      have hother (j : ι) (hji : j ≠ i) : x ∉ S j := by
        intro hxj
        exact Set.disjoint_left.mp (hdisj hji) hxj hxi
      have hs (t : T) : (∑ j ∈ I, (S j).indicator (F j t) x) = F i t x := by
        rw [Finset.sum_eq_single i]
        · exact Set.indicator_of_mem hxi _
        · intro j _ hji
          exact Set.indicator_of_notMem (hother j hji) _
        · exact fun hh => (hh hi).elim
      simp_rw [hs]
      rw [Finset.sum_eq_single i]
      · rw [Set.indicator_of_mem hxi]
      · intro j _ hji
        exact Set.indicator_of_notMem (hother j hji) _
      · exact fun hh => (hh hi).elim
    · have hn (i : ι) (hi : i ∈ I) : x ∉ S i := fun hh => hx ⟨i, hi, hh⟩
      have hs (t : T) : (∑ i ∈ I, (S i).indicator (F i t) x) = 0 := by
        apply Finset.sum_eq_zero
        intro i hi
        exact Set.indicator_of_notMem (hn i hi) _
      have hzero : (⨆ _t : T, (0 : ℝ≥0∞)) = 0 :=
        le_antisymm (iSup_le fun _ => le_rfl) bot_le
      simp_rw [hs, enorm_zero]
      rw [hzero, ENNReal.zero_rpow_of_pos hp]
      symm
      apply Finset.sum_eq_zero
      intro i hi
      exact Set.indicator_of_notMem (hn i hi) _
  simp_rw [hpoint]
  rw [lintegral_finsetSum I (fun i _ => ((hF i).pow_const p).indicator (hS i))]
  apply Finset.sum_congr rfl
  intro i _
  exact lintegral_indicator (hS i) _

/-- The existing half-open dyadic shells at negative indices lie in the
closed annuli used for the localized weighted estimates. -/
theorem negative_dyadicSpatialShell_subset_annulus (d k : ℕ) :
    dyadicSpatialShell d (-(k : ℤ) - 1) ⊆
      euclideanAnnulus d ((((2 : ℝ) ^ k)⁻¹) / 2) (((2 : ℝ) ^ k)⁻¹) := by
  intro x hx
  have hlo : (2 : ℝ) ^ (-(k : ℤ) - 1) = (((2 : ℝ) ^ k)⁻¹) / 2 := by
    rw [zpow_sub₀ (by norm_num), zpow_neg, zpow_natCast, zpow_one]
  have hhi : (2 : ℝ) ^ ((-(k : ℤ) - 1) + 1) = ((2 : ℝ) ^ k)⁻¹ := by
    simp only [sub_add_cancel, zpow_neg, zpow_natCast]
  change (2 : ℝ) ^ (-(k : ℤ) - 1) < ‖x‖ ∧
    ‖x‖ ≤ (2 : ℝ) ^ ((-(k : ℤ) - 1) + 1) at hx
  rw [hlo, hhi] at hx
  exact ⟨by simpa only [Metric.mem_closedBall, dist_zero_right] using hx.2,
    by simpa only [Metric.mem_ball, dist_zero_right, not_lt] using hx.1.le⟩

theorem pairwiseDisjoint_negative_dyadicSpatialShell (d : ℕ) :
    Pairwise (Function.onFun Disjoint (fun k : ℕ => dyadicSpatialShell d (-(k : ℤ) - 1))) := by
  intro j k hjk
  apply pairwiseDisjoint_dyadicSpatialShell d
  intro hh
  exact hjk (by omega)

/-- Source `eq:LpellpS`: the maximal estimate for the sum of disjointly
localized high-frequency operators, on finite Schwartz sequences. -/
theorem synthesis_assouad_diagonal_maximal {d N : ℕ} (hd : 2 ≤ d)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N)
    (hφ : ∀ x, (1 : ℝ) / 8 < ‖x‖ → φ x = 0)
    {p γ : ℝ} (hp₁ : 1 < p) (hp₂ : p < 2) (hγ : 0 ≤ γ) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (E : Set ℝ), E ⊆ Icc 1 2 →
      ∀ (C : ℝ), 0 ≤ C →
      (∀ δ a b : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ a → a ≤ b → b ≤ 2 → δ ≤ b - a →
        ∃ J : Finset ℝ, IsIntervalCover (E ∩ Icc a b) δ J ∧
          (J.card : ℝ) ≤ C * ((b - a) / δ) ^ γ) →
      ∀ (L : Finset ℕ), (∀ k ∈ L, 4 ≤ k) → ∀ (n : ℕ)
      (f : ℕ → SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x, (⨆ t : E, ‖∑ k ∈ L, (dyadicSpatialShell d (-(k : ℤ) - 1)).indicator
        (sphericalAverage d (compactConvolution (compactSynthesisKernel φ (k + n)) (f k)) t)
        x‖ₑ) ^ p ∂powerWeightedVolume d (1 - (d : ℝ))) ≤
        A * ENNReal.ofReal C * (2 : ℝ≥0∞) ^
          (-((n : ℝ) * (((d : ℝ) - 1) * (p - 1) - γ))) *
          ∫⁻ x, ∑ k ∈ L, ‖f k x‖ₑ ^ p := by
  obtain ⟨A, hA, hb⟩ := synthesis_assouad_diagonal_sum hd φ hflat hN hφ hp₁ hp₂ hγ
  refine ⟨A, hA, ?_⟩
  intro E hE C hC hcover L hL n f
  rw [disjoint_indicator_maximal_moment _ L
    (fun k : ℕ => dyadicSpatialShell d (-(k : ℤ) - 1))
    (fun k (t : E) => sphericalAverage d
      (compactConvolution (compactSynthesisKernel φ (k + n)) (f k)) t)
    (fun k => measurableSet_dyadicSpatialShell d (-(k : ℤ) - 1))
    (pairwiseDisjoint_negative_dyadicSpatialShell d)
    (fun k => measurable_schwartz_radius_supremum
      (compactConvolution (compactSynthesisKernel φ (k + n)) (f k)) E)
    (by linarith : 0 < p)]
  apply le_trans _ (hb E hE C hC hcover L hL n f)
  apply Finset.sum_le_sum
  intro k _
  exact lintegral_mono_set (negative_dyadicSpatialShell_subset_annulus d k)

open Auto.HardyLittlewoodMaximal

/-- The literal Hardy--Littlewood maximal function respects a bounded
pointwise norm majorant, with no representative ambiguity. -/
theorem dyadicBallMaximal_mono_of_bounded {d : ℕ}
    (f g : Euclidean d → ℂ) (hfg : ∀ x, ‖f x‖ ≤ ‖g x‖)
    (hg : ∃ a : ℝ, 0 ≤ a ∧ ∀ x, ‖g x‖ ≤ a) (x : Euclidean d) :
    dyadicBallMaximal d f x ≤ dyadicBallMaximal d g x := by
  obtain ⟨a, ha, hg⟩ := hg
  have htop : dyadicBallMaximalRaw d g x ≠ ∞ :=
    ne_top_of_le_ne_top ENNReal.ofReal_ne_top
      (dyadic_ball_maximal_raw_le_of_norm_le g a ha hg x)
  apply ENNReal.toReal_mono htop
  apply iSup_le
  intro n
  apply le_trans _ (le_iSup (fun n : ℤ =>
    (volume (Metric.ball x ((2 : ℝ) ^ n)))⁻¹ *
      ∫⁻ y in Metric.ball x ((2 : ℝ) ^ n), ENNReal.ofReal ‖g y‖) n)
  apply mul_le_mul' le_rfl
  exact lintegral_mono (fun y => ENNReal.ofReal_le_ofReal (hfg y))

/-- Every dilate of a Schwartz synthesis profile is pointwise dominated
by a fixed multiple of the literal Hardy--Littlewood maximal function. -/
theorem compactDyadicConvolution_le_dyadicBallMaximal {d : ℕ}
    (K : SchwartzMap (Euclidean d) ℂ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (j : ℕ) (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d),
      ‖compactConvolution (compactDyadicDilate K j) f x‖ ≤
        C * dyadicBallMaximal d f x := by
  let C : ℝ := 2 * (SchwartzMap.seminorm ℂ 0 0 K +
    SchwartzMap.seminorm ℂ (d + 2) 0 K) *
      (volume (Metric.ball (0 : Euclidean d) 1)).toReal * (2 : ℝ) ^ (2 * d)
  refine ⟨C, by dsimp only [C]; positivity, ?_⟩
  intro j f x
  have h := Auto.Spherical.Auxiliary.norm_scaled_schwartz_convolution_le_dyadic_average_sup K f
    (r := (((2 : ℝ) ^ j)⁻¹)) (by positivity) x
  simp only [inv_inv] at h
  have he : (fun y : Euclidean d => ((2 : ℝ) ^ j) ^ d • K ((2 : ℝ) ^ j • y)) =
      (compactDyadicDilate K j : Euclidean d → ℂ) := by
    funext y
    exact (compactDyadicDilate_apply K j y).symm
  rw [he] at h
  have hleft :
      (((compactDyadicDilate K j : Euclidean d → ℂ)
        ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] (f : Euclidean d → ℂ)) x) =
        compactConvolution (compactDyadicDilate K j) f x := by
    rw [compactConvolution, SchwartzMap.convolution_apply]
  rw [hleft] at h
  apply h.trans_eq
  dsimp only [C, dyadicBallMaximal, dyadicBallMaximalRaw]
  ring

/-- The actual synthesis family has a uniform Hardy--Littlewood majorant. -/
theorem synthesis_convolution_le_dyadicBallMaximal {d : ℕ}
    (φ : SchwartzMap (Euclidean d) ℂ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (j : ℕ) (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d),
      ‖compactConvolution (compactSynthesisKernel φ j) f x‖ ≤
        C * dyadicBallMaximal d f x := by
  obtain ⟨C₀, hC₀, hb₀⟩ := compactDyadicConvolution_le_dyadicBallMaximal
    (compactSynthesisKernel φ 0)
  obtain ⟨C₁, hC₁, hb₁⟩ := compactDyadicConvolution_le_dyadicBallMaximal
    (compactSynthesisKernel φ 1)
  refine ⟨C₀ + C₁, add_nonneg hC₀ hC₁, ?_⟩
  intro j f x
  cases j with
  | zero =>
    have hh := hb₀ 0 f x
    rw [compactDyadicDilate_zero] at hh
    exact hh.trans (mul_le_mul_of_nonneg_right (by linarith) ENNReal.toReal_nonneg)
  | succ j =>
    rw [compactSynthesisKernel_succ φ j]
    exact (hb₁ j f x).trans
      (mul_le_mul_of_nonneg_right (by linarith) ENNReal.toReal_nonneg)

/-- The finite pointwise norm envelope, viewed as a nonnegative complex
function so that the existing maximal-operator APIs apply directly. -/
def finiteSchwartzEnvelope {d : ℕ} {ι : Type*} (I : Finset ι)
    (f : ι → SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) : ℂ :=
  ((I.sup (fun i => ‖f i x‖₊) : ℝ≥0) : ℝ)

theorem norm_finiteSchwartzEnvelope {d : ℕ} {ι : Type*} (I : Finset ι)
    (f : ι → SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    ‖finiteSchwartzEnvelope I f x‖ = ((I.sup (fun i => ‖f i x‖₊) : ℝ≥0) : ℝ) := by
  simp only [finiteSchwartzEnvelope, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (NNReal.coe_nonneg _)]

theorem continuous_finiteSchwartzEnvelope {d : ℕ} {ι : Type*} (I : Finset ι)
    (f : ι → SchwartzMap (Euclidean d) ℂ) : Continuous (finiteSchwartzEnvelope I f) := by
  have hc : Continuous (fun x => I.sup (fun i => ‖f i x‖₊)) :=
    Continuous.finset_sup_apply (fun i _ => (f i).continuous.nnnorm)
  have hr := NNReal.continuous_coe.comp hc
  have hh := Complex.continuous_ofReal.comp hr
  exact hh

theorem norm_le_finiteSchwartzEnvelope {d : ℕ} {ι : Type*} (I : Finset ι)
    (f : ι → SchwartzMap (Euclidean d) ℂ) {i : ι} (hi : i ∈ I) (x : Euclidean d) :
    ‖f i x‖ ≤ ‖finiteSchwartzEnvelope I f x‖ := by
  rw [norm_finiteSchwartzEnvelope]
  exact_mod_cast (Finset.le_sup (f := fun i => ‖f i x‖₊) hi)

theorem finiteSchwartzEnvelope_bounded {d : ℕ} {ι : Type*} (I : Finset ι)
    (f : ι → SchwartzMap (Euclidean d) ℂ) :
    ∃ a : ℝ, 0 ≤ a ∧ ∀ x, ‖finiteSchwartzEnvelope I f x‖ ≤ a := by
  refine ⟨((I.sup (fun i => ‖(f i).toBoundedContinuousFunction‖₊) : ℝ≥0) : ℝ),
    NNReal.coe_nonneg _, ?_⟩
  intro x
  rw [norm_finiteSchwartzEnvelope]
  apply NNReal.coe_le_coe.mpr
  apply Finset.sup_le
  intro i hi
  apply le_trans _ (Finset.le_sup hi)
  exact_mod_cast BoundedContinuousFunction.norm_coe_le_norm (f i).toBoundedContinuousFunction x

/-- Uniform pointwise domination of a finite sequence of synthesized
inputs by the Hardy--Littlewood maximal function of its norm envelope. -/
theorem synthesis_envelope_le_dyadicBallMaximal {d : ℕ}
    (φ : SchwartzMap (Euclidean d) ℂ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (I : Finset ℕ) (j : ℕ → ℕ)
      (f : ℕ → SchwartzMap (Euclidean d) ℂ) (x : Euclidean d),
      ‖finiteSchwartzEnvelope I
        (fun i => compactConvolution (compactSynthesisKernel φ (j i)) (f i)) x‖ ≤
        C * dyadicBallMaximal d (finiteSchwartzEnvelope I f) x := by
  obtain ⟨C, hC, hb⟩ := synthesis_convolution_le_dyadicBallMaximal φ
  refine ⟨C, hC, ?_⟩
  intro I j f x
  have hnonneg : 0 ≤ C * dyadicBallMaximal d (finiteSchwartzEnvelope I f) x :=
    mul_nonneg hC ENNReal.toReal_nonneg
  rw [norm_finiteSchwartzEnvelope]
  have hh : I.sup (fun i =>
      ‖compactConvolution (compactSynthesisKernel φ (j i)) (f i) x‖₊) ≤
      ⟨C * dyadicBallMaximal d (finiteSchwartzEnvelope I f) x, hnonneg⟩ := by
    apply Finset.sup_le
    intro i hi
    have hm := dyadicBallMaximal_mono_of_bounded (f i) (finiteSchwartzEnvelope I f)
      (fun y => norm_le_finiteSchwartzEnvelope I f hi y) (finiteSchwartzEnvelope_bounded I f) x
    have hh := (hb (j i) (f i) x).trans (mul_le_mul_of_nonneg_left hm hC)
    exact_mod_cast hh
  exact_mod_cast hh

/-- The synthesis envelope is bounded on unweighted `Lᵖ`, uniformly in
the sequence length and in the assigned frequency indices. -/
theorem synthesis_envelope_moment_bound {d : ℕ} (hd : 0 < d)
    (φ : SchwartzMap (Euclidean d) ℂ) {p : ℝ} (hp : 1 < p) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (I : Finset ℕ) (j : ℕ → ℕ)
      (f : ℕ → SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x, ‖finiteSchwartzEnvelope I
        (fun i => compactConvolution (compactSynthesisKernel φ (j i)) (f i)) x‖ₑ ^ p) ≤
        A * ∫⁻ x, ‖finiteSchwartzEnvelope I f x‖ₑ ^ p := by
  obtain ⟨C, hC, hb⟩ := synthesis_envelope_le_dyadicBallMaximal φ
  let D : ℝ≥0∞ := ENNReal.ofReal p *
    (2 * (ENNReal.ofReal (4 : ℝ)) ^ d * (ENNReal.ofReal (p - 1))⁻¹ *
      (ENNReal.ofReal (2 : ℝ)) ^ (p - 1))
  have hp0 : 0 ≤ p := by linarith
  have hCpow : ENNReal.ofReal C ^ p ≠ ∞ :=
    ENNReal.rpow_ne_top_of_nonneg hp0 ENNReal.ofReal_ne_top
  have hD : D ≠ ∞ := by
    apply ENNReal.mul_ne_top ENNReal.ofReal_ne_top
    apply ENNReal.mul_ne_top
    · apply ENNReal.mul_ne_top
      · exact ENNReal.mul_ne_top (by norm_num)
          (ENNReal.pow_ne_top ENNReal.ofReal_ne_top)
      · exact ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr (by linarith))
    · exact ENNReal.rpow_ne_top_of_nonneg (by linarith) ENNReal.ofReal_ne_top
  refine ⟨ENNReal.ofReal C ^ p * D, ENNReal.mul_ne_top hCpow hD, ?_⟩
  intro I j f
  have hpoint (x : Euclidean d) :
      ‖finiteSchwartzEnvelope I
        (fun i => compactConvolution (compactSynthesisKernel φ (j i)) (f i)) x‖ₑ ^ p ≤
        ENNReal.ofReal C ^ p * ENNReal.ofReal
          ((dyadicBallMaximal d (finiteSchwartzEnvelope I f) x) ^ p) := by
    calc
      _ ≤ ENNReal.ofReal (C * dyadicBallMaximal d (finiteSchwartzEnvelope I f) x) ^ p := by
        apply ENNReal.rpow_le_rpow _ hp0
        simpa only [ofReal_norm] using ENNReal.ofReal_le_ofReal (hb I j f x)
      _ = _ := by
        have hmax0 : 0 ≤ dyadicBallMaximal d (finiteSchwartzEnvelope I f) x :=
          ENNReal.toReal_nonneg
        rw [ENNReal.ofReal_mul hC, ENNReal.mul_rpow_of_nonneg _ _ hp0,
          ENNReal.ofReal_rpow_of_nonneg hmax0 hp0]
  have hmax := dyadic_ball_maximal_lintegral_bound_of_bounded hd hp
    (finiteSchwartzEnvelope I f) (continuous_finiteSchwartzEnvelope I f).measurable
    (finiteSchwartzEnvelope_bounded I f)
  calc
    _ ≤ ∫⁻ x, ENNReal.ofReal C ^ p * ENNReal.ofReal
        ((dyadicBallMaximal d (finiteSchwartzEnvelope I f) x) ^ p) := lintegral_mono hpoint
    _ = ENNReal.ofReal C ^ p * ∫⁻ x, ENNReal.ofReal
        ((dyadicBallMaximal d (finiteSchwartzEnvelope I f) x) ^ p) :=
      lintegral_const_mul' _ _ hCpow
    _ ≤ _ := by
      have hh := mul_le_mul' (le_refl (ENNReal.ofReal C ^ p)) hmax
      simpa only [D, ofReal_norm, mul_assoc] using hh

/-- Positivity of spherical averaging transfers a pointwise norm majorant
to the averaged functions. -/
theorem norm_sphericalAverage_le_nonnegative_majorant {d : ℕ}
    (f g : Euclidean d → ℂ) (hg : Continuous g)
    (hgreal : ∀ y, g y = (‖g y‖ : ℂ)) (hfg : ∀ y, ‖f y‖ ≤ ‖g y‖)
    (t : ℝ) (x : Euclidean d) :
    ‖sphericalAverage d f t x‖ ≤ ‖sphericalAverage d g t x‖ := by
  have hc : Continuous (fun ω : Metric.sphere (0 : Euclidean d) 1 =>
      ‖g (x + t • (ω : Euclidean d))‖) := by fun_prop
  have hi := hc.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
    (μ := unitSurfaceMeasure d)
  have he : sphericalAverage d g t x =
      ((∫ ω : Metric.sphere (0 : Euclidean d) 1,
        ‖g (x + t • (ω : Euclidean d))‖ ∂unitSurfaceMeasure d : ℝ) : ℂ) := by
    unfold sphericalAverage
    calc
      _ = ∫ ω : Metric.sphere (0 : Euclidean d) 1,
          (‖g (x + t • (ω : Euclidean d))‖ : ℂ) ∂unitSurfaceMeasure d :=
        integral_congr_ae (ae_of_all _ (fun ω => hgreal (x + t • (ω : Euclidean d))))
      _ = _ := integral_complex_ofReal
  rw [he, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg
    (integral_nonneg (fun _ => norm_nonneg _))]
  apply (norm_integral_le_integral_norm _).trans
  apply integral_mono_of_nonneg
  · exact ae_of_all _ (fun _ => norm_nonneg _)
  · exact hi
  · exact ae_of_all _ (fun ω => hfg (x + t • (ω : Euclidean d)))

/-- Disjoint output supports prevent a loss depending on sequence length
when a common pointwise bound is used. -/
theorem disjoint_indicator_sum_norm_le {X ι : Type*} (I : Finset ι)
    (S : ι → Set X) (F : ι → X → ℂ)
    (hdisj : Pairwise (Function.onFun Disjoint S)) (x : X)
    {B : ℝ} (hB : 0 ≤ B) (hF : ∀ i ∈ I, ‖F i x‖ ≤ B) :
    ‖∑ i ∈ I, (S i).indicator (F i) x‖ ≤ B := by
  classical
  by_cases hx : ∃ i ∈ I, x ∈ S i
  · obtain ⟨i, hi, hxi⟩ := hx
    rw [Finset.sum_eq_single i, Set.indicator_of_mem hxi]
    · exact hF i hi
    · intro j _ hji
      apply Set.indicator_of_notMem
      intro hxj
      exact Set.disjoint_left.mp (hdisj hji) hxj hxi
    · exact fun hh => (hh hi).elim
  · have hz : (∑ i ∈ I, (S i).indicator (F i) x) = 0 := by
      apply Finset.sum_eq_zero
      intro i hi
      exact Set.indicator_of_notMem (fun hh => hx ⟨i, hi, hh⟩) _
    simpa only [hz, norm_zero] using hB

/-- Continuous compactly supported inputs admit uniform Schwartz
approximations with a common compact support. This supplies the envelope
extension needed in the positivity step. -/
theorem exists_schwartz_uniform_approximation {d : ℕ}
    (f : Euclidean d → ℂ) (hf : Continuous f) {R ε : ℝ}
    (hR : 0 < R) (hε : 0 < ε) (hzero : ∀ x, R < ‖x‖ → f x = 0) :
    ∃ g : SchwartzMap (Euclidean d) ℂ,
      (∀ x, ‖g x - f x‖ ≤ ε) ∧ (∀ x, 2 * R ≤ ‖x‖ → g x = 0) := by
  have hcompact : HasCompactSupport f := by
    apply HasCompactSupport.of_support_subset_isCompact (isCompact_closedBall (0 : Euclidean d) R)
    intro x hx
    by_contra hh
    have hx' : R < ‖x‖ := by simpa only [Metric.mem_closedBall, dist_zero_right, not_le] using hh
    exact hx (hzero x hx')
  obtain ⟨h, hhs, hha⟩ :=
    (hcompact.uniformContinuous_of_continuous hf).exists_contDiff_dist_le hε
  obtain ⟨χ, hχ₁, hχ₀, hχn⟩ := exists_schwartz_spatial_ball_cutoff d R hR
  have hχc : HasCompactSupport (χ : Euclidean d → ℂ) := by
    apply HasCompactSupport.of_support_subset_isCompact
      (isCompact_closedBall (0 : Euclidean d) (2 * R))
    intro x hx
    by_contra hh
    have hx' : 2 * R < ‖x‖ := by
      simpa only [Metric.mem_closedBall, dist_zero_right, not_le] using hh
    exact hx (hχ₀ x hx'.le)
  let u : Euclidean d → ℂ := fun x => χ x * h x
  have hu : HasCompactSupport u := hχc.mul_right
  have hus : ContDiff ℝ (⊤ : ℕ∞) u := (χ.smooth (⊤ : ℕ∞)).mul hhs
  refine ⟨hu.toSchwartzMap hus, ?_, ?_⟩
  · intro x
    have he : χ x * f x = f x := by
      by_cases hx : ‖x‖ ≤ R
      · rw [hχ₁ x hx, one_mul]
      · rw [hzero x (lt_of_not_ge hx), mul_zero]
    change ‖χ x * h x - f x‖ ≤ ε
    calc
      _ = ‖χ x * (h x - f x)‖ := by rw [mul_sub, he]
      _ = ‖χ x‖ * ‖h x - f x‖ := norm_mul _ _
      _ ≤ ‖h x - f x‖ := by
        simpa only [one_mul] using mul_le_mul_of_nonneg_right (hχn x) (norm_nonneg _)
      _ ≤ ε := by simpa only [dist_eq_norm] using (hha x).le
  · intro x hx
    change χ x * h x = 0
    rw [hχ₀ x hx, zero_mul]

/-- Compact convolution cannot move an input supported away from the
origin by more than the kernel's support radius. -/
theorem compactConvolution_eq_zero_of_inner_radius {d : ℕ}
    (K f : SchwartzMap (Euclidean d) ℂ) {s r : ℝ}
    (hK : ∀ y, s < ‖y‖ → K y = 0) (hf : ∀ y, ‖y‖ < r → f y = 0)
    {x : Euclidean d} (hx : ‖x‖ < r - s) : compactConvolution K f x = 0 := by
  rw [← smoothInput_eq_compactConvolution]
  unfold smoothInput
  apply integral_eq_zero_of_ae
  filter_upwards with y
  change K y * f (x - y) = 0
  by_cases hy : s < ‖y‖
  · rw [hK y hy, zero_mul]
  · have hxy : ‖x - y‖ < r := by
      have hh := norm_sub_le x y
      have hy' := le_of_not_gt hy
      linarith
    rw [hf _ hxy, mul_zero]

theorem finiteSchwartzEnvelope_eq_zero {d : ℕ} {ι : Type*} (I : Finset ι)
    (f : ι → SchwartzMap (Euclidean d) ℂ) (x : Euclidean d)
    (hf : ∀ i ∈ I, f i x = 0) : finiteSchwartzEnvelope I f x = 0 := by
  have hh : I.sup (fun i => ‖f i x‖₊) = 0 := by
    apply le_antisymm _ bot_le
    apply Finset.sup_le
    intro i hi
    rw [hf i hi, nnnorm_zero]
    exact le_rfl
  simp only [finiteSchwartzEnvelope, hh, NNReal.coe_zero, Complex.ofReal_zero]

/-- Synthesis of annular inputs stays in a fixed annulus, uniformly over
all nonnegative frequency indices. -/
theorem synthesis_envelope_annular_support {d : ℕ}
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hφ : ∀ x, (1 : ℝ) / 64 < ‖x‖ → φ x = 0)
    (I : Finset ℕ) (j : ℕ → ℕ) (f : ℕ → SchwartzMap (Euclidean d) ℂ)
    (hinner : ∀ i ∈ I, ∀ y, ‖y‖ < 1 / 9 → f i y = 0)
    (houter : ∀ i ∈ I, ∀ y, 9 < ‖y‖ → f i y = 0) :
    ∀ x, x ∉ euclideanAnnulus d (1 / 32) 10 →
      finiteSchwartzEnvelope I
        (fun i => compactConvolution (compactSynthesisKernel φ (j i)) (f i)) x = 0 := by
  intro x hx
  apply finiteSchwartzEnvelope_eq_zero
  intro i hi
  have hK : ∀ y, (1 : ℝ) / 32 < ‖y‖ → compactSynthesisKernel φ (j i) y = 0 := by
    have hh := compactSynthesisKernel_eq_zero φ (by norm_num : (0 : ℝ) ≤ 1 / 64) hφ (j i)
    norm_num at hh
    exact hh
  have hx' : ¬ (‖x‖ ≤ 10 ∧ 1 / 32 ≤ ‖x‖) := by
    simpa only [euclideanAnnulus, Set.mem_sdiff, Metric.mem_closedBall, Metric.mem_ball,
      dist_zero_right, not_lt] using hx
  by_cases hsmall : ‖x‖ < 1 / 32
  · apply compactConvolution_eq_zero_of_inner_radius _ _ hK (hinner i hi)
    linarith
  · have hlarge : 10 < ‖x‖ := lt_of_not_ge (fun hh => hx' ⟨hh, le_of_not_gt hsmall⟩)
    apply compactConvolution_eq_zero_of_radius _ _ hK (houter i hi)
    linarith

/-- On annular inputs the synthesis envelope has a uniform weighted
moment bound, obtained from the unweighted Hardy--Littlewood estimate. -/
theorem synthesis_envelope_weighted_moment_bound {d : ℕ} (hd : 0 < d)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hφ : ∀ x, (1 : ℝ) / 64 < ‖x‖ → φ x = 0)
    {p α : ℝ} (hp : 1 < p) (hα : α ≤ 0) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (I : Finset ℕ) (j : ℕ → ℕ)
      (f : ℕ → SchwartzMap (Euclidean d) ℂ),
      (∀ i ∈ I, ∀ y, ‖y‖ < 1 / 9 → f i y = 0) →
      (∀ i ∈ I, ∀ y, 9 < ‖y‖ → f i y = 0) →
      (∫⁻ x, ‖finiteSchwartzEnvelope I
        (fun i => compactConvolution (compactSynthesisKernel φ (j i)) (f i)) x‖ₑ ^ p
          ∂powerWeightedVolume d α) ≤
        A * ∫⁻ x, ‖finiteSchwartzEnvelope I f x‖ₑ ^ p := by
  obtain ⟨A, hA, hb⟩ := synthesis_envelope_moment_bound hd φ hp
  have hwfin : ENNReal.ofReal ((1 : ℝ) / 32) ^ α ≠ ∞ := by
    rw [ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 1 / 32)]
    exact ENNReal.ofReal_ne_top
  refine ⟨ENNReal.ofReal ((1 : ℝ) / 32) ^ α * A, ENNReal.mul_ne_top hwfin hA, ?_⟩
  intro I j f hinner houter
  let g := finiteSchwartzEnvelope I
    (fun i => compactConvolution (compactSynthesisKernel φ (j i)) (f i))
  have hg : Measurable (fun x => ‖g x‖ₑ ^ p) :=
    (continuous_finiteSchwartzEnvelope I _).measurable.enorm.pow_const p
  have hzero := synthesis_envelope_annular_support φ hφ I j f hinner houter
  rw [lintegral_eq_lintegral_restrict_of_support (euclideanAnnulus d (1 / 32) 10)
    (measurableSet_closedBall.diff measurableSet_ball) (fun x => ‖g x‖ₑ ^ p)
    (fun x hx => by
      dsimp only [g]
      rw [hzero x hx, enorm_zero, ENNReal.zero_rpow_of_pos (by linarith : 0 < p)])]
  apply (setLIntegral_powerWeightedVolume_euclideanAnnulus_le hα
    (by norm_num : (0 : ℝ) < 1 / 32) _ hg).trans
  calc
    _ ≤ ENNReal.ofReal ((1 : ℝ) / 32) ^ α * ∫⁻ x, ‖g x‖ₑ ^ p :=
      mul_le_mul' le_rfl (setLIntegral_le_lintegral _ _)
    _ ≤ _ := by
      have hh := mul_le_mul' (le_refl (ENNReal.ofReal ((1 : ℝ) / 32) ^ α)) (hb I j f)
      simpa only [mul_assoc] using hh

/-- Uniform convergence of continuous inputs passes through every literal
spherical average. -/
theorem tendsto_sphericalAverage_of_uniform_error {d : ℕ}
    (F : ℕ → Euclidean d → ℂ) (f : Euclidean d → ℂ)
    (hF : ∀ n, Continuous (F n)) (hf : Continuous f)
    (ε : ℕ → ℝ) (hε : Tendsto ε atTop (𝓝 0))
    (herr : ∀ n x, ‖F n x - f x‖ ≤ ε n) (t : ℝ) (x : Euclidean d) :
    Tendsto (fun n => sphericalAverage d (F n) t x) atTop
      (𝓝 (sphericalAverage d f t x)) := by
  apply tendsto_iff_norm_sub_tendsto_zero.mpr
  apply squeeze_zero (fun _ => norm_nonneg _)
    (fun n => show ‖sphericalAverage d (F n) t x - sphericalAverage d f t x‖ ≤
      ε n * surfaceMass d from ?_) (by simpa using hε.mul_const (surfaceMass d))
  rw [← sphericalAverage_sub_of_continuous (F n) f (hF n) hf]
  exact norm_sphericalAverage_le_surfaceMass_mul d (F n - f) t x (herr n)

/-- Uniform approximation with a common compact support preserves moments
for any locally finite measure, including the endpoint power weight. -/
theorem tendsto_moment_of_uniform_compact_error {d : ℕ}
    (μ : Measure (Euclidean d)) [IsFiniteMeasureOnCompacts μ]
    (F : ℕ → Euclidean d → ℂ) (f : Euclidean d → ℂ)
    (hF : ∀ n, Continuous (F n)) (hf : Continuous f)
    (ε : ℕ → ℝ) (hε : Tendsto ε atTop (𝓝 0)) (hε₁ : ∀ n, ε n ≤ 1)
    (herr : ∀ n x, ‖F n x - f x‖ ≤ ε n)
    {R p : ℝ} (hp : 0 < p) (hsupp : ∀ n x, R < ‖x‖ → F n x = 0) :
    Tendsto (fun n => ∫⁻ x, ‖F n x‖ₑ ^ p ∂μ) atTop (𝓝 (∫⁻ x, ‖f x‖ₑ ^ p ∂μ)) := by
  obtain ⟨C, hC⟩ := (isCompact_closedBall (0 : Euclidean d) R).exists_bound_of_continuousOn
    hf.continuousOn
  let A : ℝ≥0∞ := ENNReal.ofReal (|C| + 1) ^ p
  let B : Set (Euclidean d) := Metric.closedBall 0 R
  have hB : MeasurableSet B := measurableSet_closedBall
  have hfin : (∫⁻ x, B.indicator (fun _ => A) x ∂μ) ≠ ∞ := by
    rw [lintegral_indicator hB, setLIntegral_const]
    exact ENNReal.mul_ne_top
      (ENNReal.rpow_ne_top_of_nonneg hp.le ENNReal.ofReal_ne_top)
      (isCompact_closedBall (0 : Euclidean d) R).measure_lt_top.ne
  refine tendsto_lintegral_of_dominated_convergence (B.indicator (fun _ => A))
    (fun n => (hF n).measurable.enorm.pow_const p) ?_ hfin ?_
  · intro n
    filter_upwards with x
    by_cases hx : x ∈ B
    · rw [Set.indicator_of_mem hx]
      have hnorm : ‖F n x‖ ≤ |C| + 1 := by
        have hh := norm_sub_norm_le (F n x) (f x)
        have hc := hC x hx
        have hc' := le_abs_self C
        linarith [herr n x, hε₁ n]
      apply ENNReal.rpow_le_rpow _ hp.le
      simpa only [ofReal_norm] using ENNReal.ofReal_le_ofReal hnorm
    · rw [Set.indicator_of_notMem hx, hsupp n x (by
        simpa only [B, Metric.mem_closedBall, dist_zero_right, not_le] using hx),
        enorm_zero, ENNReal.zero_rpow_of_pos hp]
  · filter_upwards with x
    have ht : Tendsto (fun n => F n x) atTop (𝓝 (f x)) :=
      tendsto_iff_norm_sub_tendsto_zero.mpr
        (squeeze_zero (fun _ => norm_nonneg _) (fun n => herr n x) hε)
    exact (ENNReal.continuous_rpow_const.tendsto ‖f x‖ₑ).comp
      ((continuous_enorm.tendsto (f x)).comp ht)

/-- A finite spherical maximal moment bound on the Schwartz core extends
to compactly supported continuous functions, with the same constant. -/
theorem spherical_maximal_moment_core_extension {d : ℕ}
    (μ ν : Measure (Euclidean d)) [IsFiniteMeasureOnCompacts μ]
    (E : Set ℝ) {p : ℝ} (hp : 0 < p) {A : ℝ≥0∞} (hA : A ≠ ∞)
    (hcore : ∀ g : SchwartzMap (Euclidean d) ℂ,
      (∫⁻ x, (⨆ t : E, ‖sphericalAverage d g t x‖ₑ) ^ p ∂ν) ≤
        A * ∫⁻ x, ‖g x‖ₑ ^ p ∂μ)
    (f : Euclidean d → ℂ) (hf : Continuous f) {R : ℝ} (hR : 0 < R)
    (hsupp : ∀ x, R < ‖x‖ → f x = 0) :
    (∫⁻ x, (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p ∂ν) ≤
      A * ∫⁻ x, ‖f x‖ₑ ^ p ∂μ := by
  let ε : ℕ → ℝ := fun n => 1 / ((n : ℝ) + 1)
  have hε : Tendsto ε atTop (𝓝 0) := tendsto_one_div_add_atTop_nhds_zero_nat
  have hεpos (n : ℕ) : 0 < ε n := by dsimp only [ε]; positivity
  have hε₁ (n : ℕ) : ε n ≤ 1 := by
    dsimp only [ε]
    apply (div_le_one (by positivity : (0 : ℝ) < n + 1)).mpr
    linarith [Nat.cast_nonneg (α := ℝ) n]
  choose F hFerr hFsupp using
    (fun n => exists_schwartz_uniform_approximation f hf hR (hεpos n) hsupp)
  have hinput := tendsto_moment_of_uniform_compact_error μ (fun n => F n) f
    (fun n => (F n).continuous) hf ε hε hε₁ hFerr hp
    (fun n x hx => hFsupp n x hx.le)
  have hproduct := (ENNReal.continuous_const_mul hA).continuousAt.tendsto.comp hinput
  have hpoint (x : Euclidean d) :
      (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p ≤
        liminf (fun n => (⨆ t : E, ‖sphericalAverage d (F n) t x‖ₑ) ^ p) atTop := by
    apply (ENNReal.le_rpow_inv_iff hp).mp
    apply iSup_le
    intro t
    apply (ENNReal.le_rpow_inv_iff hp).mpr
    have ht := tendsto_sphericalAverage_of_uniform_error (fun n => F n) f
      (fun n => (F n).continuous) hf ε hε hFerr t x
    have htp := (ENNReal.continuous_rpow_const (y := p)).continuousAt.tendsto.comp
      ((continuous_enorm.tendsto (sphericalAverage d f t x)).comp ht)
    rw [← htp.liminf_eq]
    exact liminf_le_liminf (Eventually.of_forall (fun n => ENNReal.rpow_le_rpow
      (le_iSup (fun t : E => ‖sphericalAverage d (F n) t x‖ₑ) t) hp.le))
  calc
    _ ≤ ∫⁻ x, liminf (fun n =>
        (⨆ t : E, ‖sphericalAverage d (F n) t x‖ₑ) ^ p) atTop ∂ν := lintegral_mono hpoint
    _ ≤ liminf (fun n => ∫⁻ x,
        (⨆ t : E, ‖sphericalAverage d (F n) t x‖ₑ) ^ p ∂ν) atTop :=
      lintegral_liminf_le (fun n => (measurable_schwartz_radius_supremum (F n) E).pow_const p)
    _ ≤ liminf (fun n => A * ∫⁻ x, ‖F n x‖ₑ ^ p ∂μ) atTop :=
      liminf_le_liminf (Eventually.of_forall (fun n => hcore (F n)))
    _ = _ := hproduct.liminf_eq

/-- Source `eq:LpellinftyS`: the sequence supremum endpoint inherits a
finite scalar maximal bound, with a constant independent of the frequency
assignments and the number of disjoint output pieces. -/
theorem synthesis_sequence_supremum_bound {d : ℕ} (hd : 0 < d)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hφ : ∀ x, (1 : ℝ) / 64 < ‖x‖ → φ x = 0)
    {p α : ℝ} (hp : 1 < p) (hα : α ≤ 0) (hαlower : -(d : ℝ) < α) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (ν : Measure (Euclidean d)) (E : Set ℝ)
      (B : ℝ≥0∞), B ≠ ∞ →
      (∀ g : SchwartzMap (Euclidean d) ℂ,
        (∫⁻ x, (⨆ t : E, ‖sphericalAverage d g t x‖ₑ) ^ p ∂ν) ≤
          B * ∫⁻ x, ‖g x‖ₑ ^ p ∂powerWeightedVolume d α) →
      ∀ (I : Finset ℕ) (j : ℕ → ℕ) (S : ℕ → Set (Euclidean d)),
      Pairwise (Function.onFun Disjoint S) → ∀ (f : ℕ → SchwartzMap (Euclidean d) ℂ),
      (∀ i ∈ I, ∀ y, ‖y‖ < 1 / 9 → f i y = 0) →
      (∀ i ∈ I, ∀ y, 9 < ‖y‖ → f i y = 0) →
      (∫⁻ x, (⨆ t : E, ‖∑ i ∈ I, (S i).indicator
        (sphericalAverage d (compactConvolution (compactSynthesisKernel φ (j i)) (f i)) t)
        x‖ₑ) ^ p ∂ν) ≤
        B * A * ∫⁻ x, ‖finiteSchwartzEnvelope I f x‖ₑ ^ p := by
  obtain ⟨A, hA, hb⟩ := synthesis_envelope_weighted_moment_bound hd φ hφ hp hα
  refine ⟨A, hA, ?_⟩
  intro ν E B hB hcore I j S hS f hinner houter
  let g := finiteSchwartzEnvelope I
    (fun i => compactConvolution (compactSynthesisKernel φ (j i)) (f i))
  have hg : Continuous g := continuous_finiteSchwartzEnvelope I _
  have hgreal (x : Euclidean d) : g x = (‖g x‖ : ℂ) := by
    rw [show ‖g x‖ = ((I.sup (fun i =>
      ‖compactConvolution (compactSynthesisKernel φ (j i)) (f i) x‖₊) : ℝ≥0) : ℝ)
      from norm_finiteSchwartzEnvelope I _ x]
    rfl
  have hgzero (x : Euclidean d) (hx : 10 < ‖x‖) : g x = 0 :=
    synthesis_envelope_annular_support φ hφ I j f hinner houter x (by
      intro hh
      have hnorm : ‖x‖ ≤ 10 := by
        simpa only [Metric.mem_closedBall, dist_zero_right] using hh.1
      linarith)
  have hpoint (x : Euclidean d) :
      (⨆ t : E, ‖∑ i ∈ I, (S i).indicator
        (sphericalAverage d (compactConvolution (compactSynthesisKernel φ (j i)) (f i)) t)
        x‖ₑ) ≤ ⨆ t : E, ‖sphericalAverage d g t x‖ₑ := by
    apply iSup_le
    intro t
    have hh := disjoint_indicator_sum_norm_le I S
      (fun i => sphericalAverage d
        (compactConvolution (compactSynthesisKernel φ (j i)) (f i)) t)
      hS x (norm_nonneg (sphericalAverage d g t x))
      (fun i hi => norm_sphericalAverage_le_nonnegative_majorant _ g hg hgreal
        (fun y => norm_le_finiteSchwartzEnvelope I _ hi y) t x)
    apply le_trans _ (le_iSup (fun t : E => ‖sphericalAverage d g t x‖ₑ) t)
    simpa only [ofReal_norm] using ENNReal.ofReal_le_ofReal hh
  let : IsFiniteMeasureOnCompacts (powerWeightedVolume d α) :=
    powerWeightedVolume_isFiniteMeasureOnCompacts hd hαlower
  have hscalar := spherical_maximal_moment_core_extension
    (powerWeightedVolume d α) ν E (by linarith : 0 < p) hB hcore g hg
    (by norm_num : (0 : ℝ) < 10) hgzero
  apply (lintegral_mono (fun x => ENNReal.rpow_le_rpow (hpoint x) (by linarith))).trans
  apply hscalar.trans
  have hh := mul_le_mul' (le_refl B) (hb I j f hinner houter)
  simpa only [mul_assoc] using hh

/-- Smooth amplitude splitting relative to a variable square envelope.
The positive regularization keeps both pieces Schwartz even at common zeros. -/
theorem exists_schwartz_variable_amplitude_split {d : ℕ}
    (f : SchwartzMap (Euclidean d) ℂ) (hfc : HasCompactSupport (f : Euclidean d → ℂ))
    (G : Euclidean d → ℝ) (hGs : ContDiff ℝ (⊤ : ℕ∞) G) (hG : ∀ x, 0 ≤ G x)
    {δ : ℝ} (hδ : 0 < δ) (s : ℝ) :
    ∃ low high : SchwartzMap (Euclidean d) ℂ,
      f = low + high ∧
      (∀ x, ‖low x‖ ≤ ‖f x‖) ∧ (∀ x, ‖high x‖ ≤ ‖f x‖) ∧
      (∀ x, ‖low x‖ ≤ 2 * Real.sqrt (δ ^ 2 + s ^ 2 * G x)) ∧
      (∀ x, ‖f x‖ ^ 2 ≤ δ ^ 2 + s ^ 2 * G x → high x = 0) ∧
      (∀ x, f x = 0 → low x = 0 ∧ high x = 0) := by
  let b : ContDiffBump (0 : ℝ) := ⟨1, 4, by norm_num, by norm_num⟩
  let A : Euclidean d → ℝ := fun x => δ ^ 2 + s ^ 2 * G x
  have hApos (x : Euclidean d) : 0 < A x :=
    add_pos_of_pos_of_nonneg (sq_pos_of_pos hδ) (mul_nonneg (sq_nonneg s) (hG x))
  have hAs : ContDiff ℝ (⊤ : ℕ∞) A :=
    contDiff_const.add (contDiff_const.mul hGs)
  let u : Euclidean d → ℝ := fun x => ‖f x‖ ^ 2 / A x
  have hu (x) : 0 ≤ u x := div_nonneg (sq_nonneg _) (hApos x).le
  have hfsq : ContDiff ℝ (⊤ : ℕ∞) (fun x => ‖f x‖ ^ 2) :=
    (contDiff_norm_sq ℝ).comp (f.smooth (⊤ : ℕ∞))
  have hus : ContDiff ℝ (⊤ : ℕ∞) u :=
    hfsq.div hAs (fun x => (hApos x).ne')
  let l : Euclidean d → ℂ := fun x => b (u x) • f x
  have hlc : HasCompactSupport l := by
    have hh := hfc.smul_left (f := fun x => b (u x))
    exact hh
  have hbc : ContDiff ℝ (⊤ : ℕ∞) (fun x => b (u x)) := by
    have hh := b.contDiff.comp hus
    exact hh
  have hls : ContDiff ℝ (⊤ : ℕ∞) l := hbc.smul (f.smooth (⊤ : ℕ∞))
  let low := hlc.toSchwartzMap hls
  let high := f - low
  have hl (x) : low x = b (u x) • f x := rfl
  have hh (x) : high x = (1 - b (u x)) • f x := by
    change f x - b (u x) • f x = _
    rw [sub_smul, one_smul]
  have hln (x) : ‖low x‖ ≤ ‖f x‖ := by
    rw [hl, norm_smul, Real.norm_eq_abs, abs_of_nonneg b.nonneg]
    exact (mul_le_mul_of_nonneg_right b.le_one (norm_nonneg _)).trans_eq (one_mul _)
  refine ⟨low, high, by dsimp only [high]; abel, hln, ?_, ?_, ?_, ?_⟩
  · intro x
    rw [hh, norm_smul, Real.norm_eq_abs, abs_of_nonneg (sub_nonneg.mpr b.le_one)]
    exact (mul_le_mul_of_nonneg_right (sub_le_self _ b.nonneg) (norm_nonneg _)).trans_eq
      (one_mul _)
  · intro x
    change ‖low x‖ ≤ 2 * Real.sqrt (A x)
    by_cases hx : ‖f x‖ ≤ 2 * Real.sqrt (A x)
    · exact (hln x).trans hx
    · have hu4 : 4 ≤ u x := by
        apply (le_div_iff₀ (hApos x)).mpr
        have hs := Real.sq_sqrt (hApos x).le
        have hs0 := Real.sqrt_nonneg (A x)
        have hx' := lt_of_not_ge hx
        nlinarith [norm_nonneg (f x)]
      have hb0 : b (u x) = 0 := b.zero_of_le_dist (by
        simpa only [Real.dist_eq, sub_zero, abs_of_nonneg (hu x)] using hu4)
      rw [hl, hb0, zero_smul, norm_zero]
      positivity
  · intro x hx
    have hu1 : u x ≤ 1 := (div_le_one (hApos x)).mpr hx
    have hb1 : b (u x) = 1 := b.one_of_mem_closedBall (by
      simpa only [Metric.mem_closedBall, Real.dist_eq, sub_zero, abs_of_nonneg (hu x)] using hu1)
    rw [hh, hb1, sub_self, zero_smul]
  · intro x hx
    rw [hl, hh, hx, smul_zero, smul_zero]
    exact ⟨rfl, rfl⟩

/-- The large-amplitude part converts a square moment to a `p`-moment
with the scale factor used in the sequence interpolation step. -/
theorem high_amplitude_moment_le {u v t p : ℝ}
    (hv : 0 ≤ v) (hvu : v ≤ u) (ht : 0 < t) (hp : 0 < p) (hp₂ : p ≤ 2)
    (hzero : u ≤ t → v = 0) : v ^ p ≤ t ^ (p - 2) * u ^ 2 := by
  by_cases hut : u ≤ t
  · rw [hzero hut, Real.zero_rpow hp.ne']
    exact mul_nonneg (Real.rpow_nonneg ht.le _) (sq_nonneg _)
  · have hu : 0 < u := ht.trans (lt_of_not_ge hut)
    calc
      v ^ p ≤ u ^ p := Real.rpow_le_rpow hv hvu hp.le
      _ = u ^ (p - 2) * u ^ 2 := by
        rw [← Real.rpow_natCast u 2, ← Real.rpow_add hu]
        congr 1
        norm_num
      _ ≤ t ^ (p - 2) * u ^ 2 := mul_le_mul_of_nonneg_right
        (Real.rpow_le_rpow_of_nonpos ht (le_of_not_ge hut) (by linarith)) (sq_nonneg _)

/-- Scaling the square envelope in the large-amplitude estimate. -/
theorem square_envelope_scale_identity {s F : ℝ} (hs : 0 < s) (hF : 0 < F) (p : ℝ) :
    (s * F) ^ (p - 2) * F ^ 2 = s ^ (p - 2) * F ^ p := by
  rw [Real.mul_rpow hs.le hF.le, mul_assoc, ← Real.rpow_natCast F 2,
    ← Real.rpow_add hF]
  congr 2
  norm_num

/-- Smoothness of the finite square envelope before taking its square root. -/
theorem contDiff_schwartz_square_sum {d : ℕ} {ι : Type*} (I : Finset ι)
    (f : ι → SchwartzMap (Euclidean d) ℂ) :
    ContDiff ℝ (⊤ : ℕ∞) (fun x => ∑ i ∈ I, ‖f i x‖ ^ 2) := by
  apply ContDiff.sum
  intro i _
  exact (contDiff_norm_sq ℝ).comp ((f i).smooth (⊤ : ℕ∞))

/-- The literal finite square-function envelope of Schwartz inputs. -/
def schwartzSquareEnvelope {d : ℕ} {ι : Type*} (I : Finset ι)
    (f : ι → SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) : ℝ :=
  Real.sqrt (∑ i ∈ I, ‖f i x‖ ^ 2)

theorem schwartzSquareEnvelope_nonneg {d : ℕ} {ι : Type*} (I : Finset ι)
    (f : ι → SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    0 ≤ schwartzSquareEnvelope I f x := Real.sqrt_nonneg _

theorem schwartzSquareEnvelope_sq {d : ℕ} {ι : Type*} (I : Finset ι)
    (f : ι → SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    schwartzSquareEnvelope I f x ^ 2 = ∑ i ∈ I, ‖f i x‖ ^ 2 :=
  Real.sq_sqrt (Finset.sum_nonneg (fun _ _ => sq_nonneg _))

theorem continuous_schwartzSquareEnvelope {d : ℕ} {ι : Type*} (I : Finset ι)
    (f : ι → SchwartzMap (Euclidean d) ℂ) : Continuous (schwartzSquareEnvelope I f) :=
  (contDiff_schwartz_square_sum I f).continuous.sqrt

theorem schwartz_eq_zero_of_squareEnvelope_eq_zero {d : ℕ} {ι : Type*} (I : Finset ι)
    (f : ι → SchwartzMap (Euclidean d) ℂ) {i : ι} (hi : i ∈ I) (x : Euclidean d)
    (hx : schwartzSquareEnvelope I f x = 0) : f i x = 0 := by
  have hs := schwartzSquareEnvelope_sq I f x
  have hi' := Finset.single_le_sum (f := fun i => ‖f i x‖ ^ 2) (fun _ _ => sq_nonneg _) hi
  rw [hx, zero_pow (by norm_num : (2 : ℕ) ≠ 0)] at hs
  apply norm_eq_zero.mp
  nlinarith [norm_nonneg (f i x)]

/-- The finite Schwartz sequence split used for the `q=2` interpolation
step. It preserves every input's zero set. -/
theorem exists_schwartz_square_envelope_split {d : ℕ} (I : Finset ℕ)
    (f : ℕ → SchwartzMap (Euclidean d) ℂ)
    (hfc : ∀ i ∈ I, HasCompactSupport (f i : Euclidean d → ℂ))
    {δ s p : ℝ} (hδ : 0 < δ) (hs : 0 < s) (hp : 0 < p) (hp₂ : p ≤ 2) :
    ∃ low high : ℕ → SchwartzMap (Euclidean d) ℂ,
      (∀ i, f i = low i + high i) ∧
      (∀ x, ‖finiteSchwartzEnvelope I low x‖ ≤
        2 * (δ + s * schwartzSquareEnvelope I f x)) ∧
      (∀ x, (∑ i ∈ I, ‖high i x‖ ^ p) ≤ s ^ (p - 2) * schwartzSquareEnvelope I f x ^ p) ∧
      (∀ i ∈ I, ∀ x, f i x = 0 → low i x = 0 ∧ high i x = 0) := by
  classical
  let G : Euclidean d → ℝ := fun x => ∑ i ∈ I, ‖f i x‖ ^ 2
  have hG (x) : 0 ≤ G x := Finset.sum_nonneg (fun _ _ => sq_nonneg _)
  have hex (i : ℕ) : ∃ low high : SchwartzMap (Euclidean d) ℂ,
      f i = low + high ∧ (i ∈ I →
        (∀ x, ‖low x‖ ≤ ‖f i x‖) ∧ (∀ x, ‖high x‖ ≤ ‖f i x‖) ∧
        (∀ x, ‖low x‖ ≤ 2 * Real.sqrt (δ ^ 2 + s ^ 2 * G x)) ∧
        (∀ x, ‖f i x‖ ^ 2 ≤ δ ^ 2 + s ^ 2 * G x → high x = 0) ∧
        (∀ x, f i x = 0 → low x = 0 ∧ high x = 0)) := by
    by_cases hi : i ∈ I
    · obtain ⟨low, high, hsplit, hh⟩ := exists_schwartz_variable_amplitude_split
        (f i) (hfc i hi) G (contDiff_schwartz_square_sum I f) hG hδ s
      exact ⟨low, high, hsplit, fun _ => hh⟩
    · exact ⟨f i, 0, by simp, fun hh => (hi hh).elim⟩
  choose low high hsplit hparts using hex
  refine ⟨low, high, hsplit, ?_, ?_, fun i hi => (hparts i hi).2.2.2.2⟩
  · intro x
    let F := schwartzSquareEnvelope I f x
    have hF : 0 ≤ F := schwartzSquareEnvelope_nonneg I f x
    have hFsq : F ^ 2 = G x := schwartzSquareEnvelope_sq I f x
    have hsqrt : Real.sqrt (δ ^ 2 + s ^ 2 * G x) ≤ δ + s * F := by
      apply Real.sqrt_le_iff.mpr
      constructor
      · positivity
      · rw [← hFsq]
        nlinarith [mul_nonneg (mul_nonneg hδ.le hs.le) hF]
    have hbound (i : ℕ) (hi : i ∈ I) : ‖low i x‖ ≤ 2 * (δ + s * F) :=
      ((hparts i hi).2.2.1 x).trans (by linarith)
    rw [norm_finiteSchwartzEnvelope]
    have hh : I.sup (fun i => ‖low i x‖₊) ≤ ⟨2 * (δ + s * F), by positivity⟩ := by
      apply Finset.sup_le
      intro i hi
      exact_mod_cast hbound i hi
    exact_mod_cast hh
  · intro x
    let F := schwartzSquareEnvelope I f x
    have hF : 0 ≤ F := schwartzSquareEnvelope_nonneg I f x
    have hFsq : F ^ 2 = G x := schwartzSquareEnvelope_sq I f x
    by_cases hF0 : F = 0
    · have hz (i : ℕ) (hi : i ∈ I) : high i x = 0 :=
        ((hparts i hi).2.2.2.2 x (schwartz_eq_zero_of_squareEnvelope_eq_zero I f hi x hF0)).2
      have hsum : (∑ i ∈ I, ‖high i x‖ ^ p) = 0 := by
        apply Finset.sum_eq_zero
        intro i hi
        rw [hz i hi, norm_zero, Real.zero_rpow hp.ne']
      rw [hsum]
      exact mul_nonneg (Real.rpow_nonneg hs.le _) (Real.rpow_nonneg hF _)
    · have hFpos : 0 < F := lt_of_le_of_ne hF (Ne.symm hF0)
      have hi (i : ℕ) (hi : i ∈ I) : ‖high i x‖ ^ p ≤ (s * F) ^ (p - 2) * ‖f i x‖ ^ 2 := by
        apply high_amplitude_moment_le (norm_nonneg _) ((hparts i hi).2.1 x)
          (mul_pos hs hFpos) hp hp₂
        intro hh
        have hsq := pow_le_pow_left₀ (norm_nonneg (f i x)) hh 2
        rw [mul_pow, hFsq] at hsq
        have hz := (hparts i hi).2.2.2.1 x
          (hsq.trans (le_add_of_nonneg_left (sq_nonneg δ)))
        rw [hz, norm_zero]
      calc
        _ ≤ ∑ i ∈ I, (s * F) ^ (p - 2) * ‖f i x‖ ^ 2 := Finset.sum_le_sum hi
        _ = (s * F) ^ (p - 2) * F ^ 2 := by rw [← Finset.mul_sum, hFsq]
        _ = _ := square_envelope_scale_identity hs hFpos p

/-- Integrated high-amplitude estimate, with no dependence on the sequence length. -/
theorem square_envelope_high_moment_le {d : ℕ} (I : Finset ℕ)
    (f high : ℕ → SchwartzMap (Euclidean d) ℂ) (μ : Measure (Euclidean d))
    {s p : ℝ} (hs : 0 < s) (hp : 0 < p)
    (h : ∀ x, (∑ i ∈ I, ‖high i x‖ ^ p) ≤
      s ^ (p - 2) * schwartzSquareEnvelope I f x ^ p) :
    (∫⁻ x, ∑ i ∈ I, ‖high i x‖ₑ ^ p ∂μ) ≤
      ENNReal.ofReal (s ^ (p - 2)) *
        ∫⁻ x, ENNReal.ofReal (schwartzSquareEnvelope I f x) ^ p ∂μ := by
  rw [← lintegral_const_mul' _ _]
  · apply lintegral_mono
    intro x
    have hh := ENNReal.ofReal_le_ofReal (h x)
    rw [ENNReal.ofReal_mul (Real.rpow_nonneg hs.le _),
      ← ENNReal.ofReal_rpow_of_nonneg (schwartzSquareEnvelope_nonneg I f x) hp.le] at hh
    simpa only [ENNReal.ofReal_sum_of_nonneg (fun i hi => Real.rpow_nonneg (norm_nonneg _) _),
      ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp.le, ofReal_norm] using hh
  · exact ENNReal.ofReal_ne_top

/-- Integrated low-amplitude estimate. The regularization error is confined
to the common finite-measure input support. -/
theorem square_envelope_low_moment_le {d : ℕ} (I : Finset ℕ)
    (f low : ℕ → SchwartzMap (Euclidean d) ℂ) (μ : Measure (Euclidean d))
    (U : Set (Euclidean d)) (hU : MeasurableSet U)
    {δ s p : ℝ} (hδ : 0 ≤ δ) (hs : 0 ≤ s) (hp : 0 < p)
    (h : ∀ x, ‖finiteSchwartzEnvelope I low x‖ ≤
      2 * (δ + s * schwartzSquareEnvelope I f x))
    (hz : ∀ i ∈ I, ∀ x ∉ U, low i x = 0) :
    (∫⁻ x, ‖finiteSchwartzEnvelope I low x‖ₑ ^ p ∂μ) ≤
      (2 : ℝ≥0∞) ^ p * 2 ^ p *
        (ENNReal.ofReal δ ^ p * μ U + ENNReal.ofReal s ^ p *
          ∫⁻ x, ENNReal.ofReal (schwartzSquareEnvelope I f x) ^ p ∂μ) := by
  let F := fun x => ENNReal.ofReal (schwartzSquareEnvelope I f x)
  have hFm : Measurable F := ENNReal.continuous_ofReal.measurable.comp
    (continuous_schwartzSquareEnvelope I f).measurable
  have hpoint (x : Euclidean d) : ‖finiteSchwartzEnvelope I low x‖ₑ ^ p ≤
      (2 : ℝ≥0∞) ^ p * 2 ^ p *
        (U.indicator (fun _ => ENNReal.ofReal δ ^ p) x + ENNReal.ofReal s ^ p * F x ^ p) := by
    by_cases hx : x ∈ U
    · rw [Set.indicator_of_mem hx]
      have hh := ENNReal.ofReal_le_ofReal (h x)
      rw [ofReal_norm, ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2),
        ENNReal.ofReal_add hδ (mul_nonneg hs (schwartzSquareEnvelope_nonneg I f x)),
        ENNReal.ofReal_mul hs, ENNReal.ofReal_ofNat] at hh
      apply (ENNReal.rpow_le_rpow hh hp.le).trans
      rw [ENNReal.mul_rpow_of_nonneg _ _ hp.le]
      have hb := ENNReal.add_rpow_le_two_rpow_mul_rpow_add_rpow
        (ENNReal.ofReal δ) (ENNReal.ofReal s * F x) hp.le
      rw [ENNReal.mul_rpow_of_nonneg _ _ hp.le] at hb
      simpa only [mul_assoc] using mul_le_mul' (le_refl ((2 : ℝ≥0∞) ^ p)) hb
    · rw [finiteSchwartzEnvelope_eq_zero I low x (fun i hi => hz i hi x hx),
        enorm_zero, ENNReal.zero_rpow_of_pos hp]
      exact bot_le
  apply (lintegral_mono hpoint).trans
  rw [lintegral_const_mul' _ _ (by finiteness),
    lintegral_add_left (measurable_const.indicator hU),
    lintegral_indicator_const hU,
    lintegral_const_mul' _ _ (by finiteness)]

/-- The square-sequence interpolation estimate before optimizing the positive
splitting scale. Endpoint hypotheses only concern functions supported wherever
the corresponding original input is supported. -/
theorem schwartz_square_interpolation_at_scale {d : ℕ} (I : Finset ℕ)
    (f : ℕ → SchwartzMap (Euclidean d) ℂ) (μ : Measure (Euclidean d))
    (U : Set (Euclidean d)) (hU : MeasurableSet U) (hUfin : μ U ≠ ∞)
    (hfc : ∀ i ∈ I, HasCompactSupport (f i : Euclidean d → ℂ))
    (hzero : ∀ i ∈ I, ∀ x ∉ U, f i x = 0)
    (T : (ℕ → SchwartzMap (Euclidean d) ℂ) → ℝ≥0∞)
    {C a b : ℝ≥0∞} (hC : C ≠ ∞) (hb : b ≠ ∞)
    (hadd : ∀ g h, T (fun i => g i + h i) ≤ C * (T g + T h))
    {p s : ℝ} (hp : 0 < p) (hp₂ : p ≤ 2) (hs : 0 < s)
    (hdiag : ∀ g, (∀ i ∈ I, ∀ x, f i x = 0 → g i x = 0) →
      T g ≤ a * ∫⁻ x, ∑ i ∈ I, ‖g i x‖ₑ ^ p ∂μ)
    (hsup : ∀ g, (∀ i ∈ I, ∀ x, f i x = 0 → g i x = 0) →
      T g ≤ b * ∫⁻ x, ‖finiteSchwartzEnvelope I g x‖ₑ ^ p ∂μ) :
    T f ≤ C * (a * ENNReal.ofReal (s ^ (p - 2)) *
      (∫⁻ x, ENNReal.ofReal (schwartzSquareEnvelope I f x) ^ p ∂μ) +
      b * ((2 : ℝ≥0∞) ^ p * 2 ^ p) * ENNReal.ofReal s ^ p *
        ∫⁻ x, ENNReal.ofReal (schwartzSquareEnvelope I f x) ^ p ∂μ) := by
  let Q := ∫⁻ x, ENNReal.ofReal (schwartzSquareEnvelope I f x) ^ p ∂μ
  let D : ℝ≥0∞ := (2 : ℝ≥0∞) ^ p * 2 ^ p
  have hD : D ≠ ∞ := by dsimp only [D]; finiteness
  let ε : ℕ → ℝ := fun n => 1 / ((n : ℝ) + 1)
  have hε : Tendsto ε atTop (𝓝 0) := tendsto_one_div_add_atTop_nhds_zero_nat
  have hεpos (n : ℕ) : 0 < ε n := by dsimp only [ε]; positivity
  have hn (n : ℕ) : T f ≤ C *
      (a * ENNReal.ofReal (s ^ (p - 2)) * Q + b * D *
        (ENNReal.ofReal (ε n) ^ p * μ U + ENNReal.ofReal s ^ p * Q)) := by
    obtain ⟨low, high, hsplit, hl, hh, hz⟩ :=
      exists_schwartz_square_envelope_split I f hfc (hεpos n) hs hp hp₂
    have heq : f = fun i => high i + low i := funext (fun i => by
      rw [add_comm]; exact hsplit i)
    have ht : T f ≤ C * (T high + T low) := by rw [heq]; exact hadd high low
    have hhigh := (hdiag high (fun i hi x hx => (hz i hi x hx).2)).trans
      (mul_le_mul' le_rfl (square_envelope_high_moment_le I f high μ hs hp hh))
    have hlow := (hsup low (fun i hi x hx => (hz i hi x hx).1)).trans
      (mul_le_mul' le_rfl (square_envelope_low_moment_le I f low μ U hU
        (hεpos n).le hs.le hp hl (fun i hi x hx => (hz i hi x (hzero i hi x hx)).1)))
    apply ht.trans
    simpa only [D, Q, mul_assoc] using mul_le_mul' (le_refl C) (add_le_add hhigh hlow)
  have he : Tendsto (fun n => ENNReal.ofReal (ε n) ^ p) atTop (𝓝 0) := by
    have hh := (ENNReal.continuous_rpow_const (y := p)).continuousAt.tendsto.comp
      (ENNReal.continuous_ofReal.continuousAt.tendsto.comp hε)
    simpa only [Function.comp_def, ENNReal.ofReal_zero, ENNReal.zero_rpow_of_pos hp] using hh
  have heU := ENNReal.Tendsto.mul_const he (Or.inr hUfin)
  simp only [zero_mul] at heU
  have hlow := ENNReal.Tendsto.const_mul
    (heU.add (tendsto_const_nhds (x := ENNReal.ofReal s ^ p * Q)))
    (Or.inr (ENNReal.mul_ne_top hb hD))
  simp only [zero_add] at hlow
  have ht := ENNReal.Tendsto.const_mul
    ((tendsto_const_nhds (x := a * ENNReal.ofReal (s ^ (p - 2)) * Q)).add hlow)
    (Or.inr hC)
  have hh := ge_of_tendsto ht (Eventually.of_forall hn)
  simpa only [D, Q, mul_assoc] using hh

/-- Balancing the diagonal and supremum endpoint coefficients. -/
theorem square_interpolation_balance {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (p : ℝ) :
    let s := a ^ (1 / 2 : ℝ) * b ^ (-1 / 2 : ℝ)
    a * s ^ (p - 2) = a ^ (p / 2) * b ^ (1 - p / 2) ∧
      b * s ^ p = a ^ (p / 2) * b ^ (1 - p / 2) := by
  dsimp only
  constructor
  · rw [Real.mul_rpow (Real.rpow_nonneg ha.le _) (Real.rpow_nonneg hb.le _),
      ← Real.rpow_mul ha.le, ← Real.rpow_mul hb.le]
    calc
      _ = (a ^ (1 : ℝ) * a ^ ((1 / 2 : ℝ) * (p - 2))) *
          b ^ ((-1 / 2 : ℝ) * (p - 2)) := by rw [Real.rpow_one]; ring
      _ = _ := by
        rw [← Real.rpow_add ha]
        congr 1 <;> congr 1 <;> ring
  · rw [Real.mul_rpow (Real.rpow_nonneg ha.le _) (Real.rpow_nonneg hb.le _),
      ← Real.rpow_mul ha.le, ← Real.rpow_mul hb.le]
    calc
      _ = a ^ ((1 / 2 : ℝ) * p) * (b ^ (1 : ℝ) * b ^ ((-1 / 2 : ℝ) * p)) := by
        rw [Real.rpow_one]; ring
      _ = _ := by
        rw [← Real.rpow_add hb]
        congr 1 <;> congr 1 <;> ring

/-- Elementary `q=2` interpolation of finite Schwartz sequence moments.
The endpoint constants enter with exponents `p/2` and `1-p/2`, uniformly
in the number of inputs. -/
theorem schwartz_square_interpolation {d : ℕ} (I : Finset ℕ)
    (f : ℕ → SchwartzMap (Euclidean d) ℂ) (μ : Measure (Euclidean d))
    (U : Set (Euclidean d)) (hU : MeasurableSet U) (hUfin : μ U ≠ ∞)
    (hfc : ∀ i ∈ I, HasCompactSupport (f i : Euclidean d → ℂ))
    (hzero : ∀ i ∈ I, ∀ x ∉ U, f i x = 0)
    (T : (ℕ → SchwartzMap (Euclidean d) ℂ) → ℝ≥0∞)
    {C : ℝ≥0∞} (hC : C ≠ ∞)
    (hadd : ∀ g h, T (fun i => g i + h i) ≤ C * (T g + T h))
    {a b p : ℝ} (ha : 0 < a) (hb : 0 < b) (hp : 0 < p) (hp₂ : p ≤ 2)
    (hdiag : ∀ g, (∀ i ∈ I, ∀ x, f i x = 0 → g i x = 0) →
      T g ≤ ENNReal.ofReal a * ∫⁻ x, ∑ i ∈ I, ‖g i x‖ₑ ^ p ∂μ)
    (hsup : ∀ g, (∀ i ∈ I, ∀ x, f i x = 0 → g i x = 0) →
      T g ≤ ENNReal.ofReal b * ∫⁻ x, ‖finiteSchwartzEnvelope I g x‖ₑ ^ p ∂μ) :
    T f ≤ C * (1 + (2 : ℝ≥0∞) ^ p * 2 ^ p) *
      ENNReal.ofReal (a ^ (p / 2) * b ^ (1 - p / 2)) *
        ∫⁻ x, ENNReal.ofReal (schwartzSquareEnvelope I f x) ^ p ∂μ := by
  let s := a ^ (1 / 2 : ℝ) * b ^ (-1 / 2 : ℝ)
  have hs : 0 < s := mul_pos (Real.rpow_pos_of_pos ha _) (Real.rpow_pos_of_pos hb _)
  have hbal := square_interpolation_balance ha hb p
  have hae : ENNReal.ofReal a * ENNReal.ofReal (s ^ (p - 2)) =
      ENNReal.ofReal (a ^ (p / 2) * b ^ (1 - p / 2)) := by
    rw [← ENNReal.ofReal_mul ha.le, hbal.1]
  have hbe : ENNReal.ofReal b * ENNReal.ofReal s ^ p =
      ENNReal.ofReal (a ^ (p / 2) * b ^ (1 - p / 2)) := by
    rw [ENNReal.ofReal_rpow_of_pos hs, ← ENNReal.ofReal_mul hb.le, hbal.2]
  apply (schwartz_square_interpolation_at_scale I f μ U hU hUfin hfc hzero
    T hC ENNReal.ofReal_ne_top hadd hp hp₂ hs hdiag hsup).trans_eq
  let Q := ∫⁻ x, ENNReal.ofReal (schwartzSquareEnvelope I f x) ^ p ∂μ
  change C * (ENNReal.ofReal a * ENNReal.ofReal (s ^ (p - 2)) * Q +
    ENNReal.ofReal b * (2 ^ p * 2 ^ p) * ENNReal.ofReal s ^ p * Q) = _
  calc
    _ = C * ((ENNReal.ofReal a * ENNReal.ofReal (s ^ (p - 2))) * Q +
        (2 ^ p * 2 ^ p) * (ENNReal.ofReal b * ENNReal.ofReal s ^ p) * Q) := by ring
    _ = _ := by rw [hae, hbe]; ring

/-- Subadditivity of a spherical maximal moment on the Schwartz core. -/
theorem schwartz_spherical_maximal_moment_add_le {d : ℕ}
    (f g : SchwartzMap (Euclidean d) ℂ) (E : Set ℝ)
    (μ : Measure (Euclidean d)) {p : ℝ} (hp : 0 ≤ p) :
    (∫⁻ x, (⨆ t : E, ‖sphericalAverage d (f + g) t x‖ₑ) ^ p ∂μ) ≤
      (2 : ℝ≥0∞) ^ p *
        ((∫⁻ x, (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p ∂μ) +
          ∫⁻ x, (⨆ t : E, ‖sphericalAverage d g t x‖ₑ) ^ p ∂μ) := by
  have hpoint (x : Euclidean d) :
      (⨆ t : E, ‖sphericalAverage d (f + g) t x‖ₑ) ≤
        (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) +
          ⨆ t : E, ‖sphericalAverage d g t x‖ₑ := by
    apply iSup_le
    intro t
    have heq : sphericalAverage d (f + g) t x =
        sphericalAverage d f t x + sphericalAverage d g t x := by
      have hcoe : (⇑(f + g) : Euclidean d → ℂ) = ⇑f + ⇑g := by
        ext y
        exact add_apply f g y
      simpa only [schwartzSphericalAverage_apply, add_apply, hcoe] using
        congrArg (fun h : SchwartzMap (Euclidean d) ℂ => h x)
          (schwartzSphericalAverage_add f g t)
    rw [heq]
    apply (enorm_add_le _ _).trans
    exact add_le_add (le_iSup (fun t : E => ‖sphericalAverage d f t x‖ₑ) t)
      (le_iSup (fun t : E => ‖sphericalAverage d g t x‖ₑ) t)
  calc
    _ ≤ ∫⁻ x, (2 : ℝ≥0∞) ^ p *
        ((⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p +
          (⨆ t : E, ‖sphericalAverage d g t x‖ₑ) ^ p) ∂μ := by
      apply lintegral_mono
      intro x
      exact (ENNReal.rpow_le_rpow (hpoint x) hp).trans
        (ENNReal.add_rpow_le_two_rpow_mul_rpow_add_rpow _ _ hp)
    _ = _ := by
      rw [lintegral_const_mul' _ _ (by finiteness),
        lintegral_add_left ((measurable_schwartz_radius_supremum f E).pow_const p)]

/-- The sequence operator has a moment subadditivity constant independent
of both the sequence length and the frequency assignments. -/
theorem synthesis_sequence_moment_add_le {d : ℕ}
    (φ : SchwartzMap (Euclidean d) ℂ) (I : Finset ℕ) (j : ℕ → ℕ)
    (S : ℕ → Set (Euclidean d)) (hS : ∀ i, MeasurableSet (S i))
    (hdisj : Pairwise (Function.onFun Disjoint S)) (E : Set ℝ)
    (μ : Measure (Euclidean d)) {p : ℝ} (hp : 0 < p)
    (f g : ℕ → SchwartzMap (Euclidean d) ℂ) :
    let T := fun h : ℕ → SchwartzMap (Euclidean d) ℂ =>
      ∫⁻ x, (⨆ t : E, ‖∑ i ∈ I, (S i).indicator
        (sphericalAverage d (compactConvolution (compactSynthesisKernel φ (j i)) (h i)) t)
        x‖ₑ) ^ p ∂μ
    T (fun i => f i + g i) ≤ (2 : ℝ≥0∞) ^ p * (T f + T g) := by
  classical
  dsimp only
  have heq (h : ℕ → SchwartzMap (Euclidean d) ℂ) :=
    disjoint_indicator_maximal_moment μ I S
      (fun i (t : E) => sphericalAverage d
        (compactConvolution (compactSynthesisKernel φ (j i)) (h i)) t)
      hS hdisj (fun i => measurable_schwartz_radius_supremum _ E) hp
  rw [heq, heq, heq]
  simp only [compactConvolution_add_right]
  calc
    _ ≤ ∑ i ∈ I, (2 : ℝ≥0∞) ^ p *
        ((∫⁻ x in S i, (⨆ t : E, ‖sphericalAverage d
          (compactConvolution (compactSynthesisKernel φ (j i)) (f i)) t x‖ₑ) ^ p ∂μ) +
        ∫⁻ x in S i, (⨆ t : E, ‖sphericalAverage d
          (compactConvolution (compactSynthesisKernel φ (j i)) (g i)) t x‖ₑ) ^ p ∂μ) := by
      apply Finset.sum_le_sum
      intro i _
      exact schwartz_spherical_maximal_moment_add_le _ _ E (μ.restrict (S i)) hp.le
    _ = _ := by rw [← Finset.mul_sum, Finset.sum_add_distrib]

/-- Source `eq:LpellqS`, specialized to `q=2`: interpolate an annular
diagonal sequence estimate with the scalar maximal bound. -/
theorem synthesis_sequence_square_bound {d : ℕ} (hd : 0 < d)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hφ : ∀ x, (1 : ℝ) / 64 < ‖x‖ → φ x = 0)
    {p α : ℝ} (hp : 1 < p) (hp₂ : p ≤ 2) (hα : α ≤ 0)
    (hαlower : -(d : ℝ) < α) :
    ∃ A : ℝ, 0 < A ∧ ∀ (ν : Measure (Euclidean d)) (E : Set ℝ)
      (B : ℝ), 0 < B →
      (∀ g : SchwartzMap (Euclidean d) ℂ,
        (∫⁻ x, (⨆ t : E, ‖sphericalAverage d g t x‖ₑ) ^ p ∂ν) ≤
          ENNReal.ofReal B * ∫⁻ x, ‖g x‖ₑ ^ p ∂powerWeightedVolume d α) →
      ∀ (I : Finset ℕ) (j : ℕ → ℕ) (S : ℕ → Set (Euclidean d)),
      (∀ i, MeasurableSet (S i)) → Pairwise (Function.onFun Disjoint S) →
      ∀ a : ℝ, 0 < a →
      (∀ g : ℕ → SchwartzMap (Euclidean d) ℂ,
        (∫⁻ x, (⨆ t : E, ‖∑ i ∈ I, (S i).indicator
          (sphericalAverage d (compactConvolution (compactSynthesisKernel φ (j i)) (g i)) t)
          x‖ₑ) ^ p ∂ν) ≤ ENNReal.ofReal a * ∫⁻ x, ∑ i ∈ I, ‖g i x‖ₑ ^ p) →
      ∀ f : ℕ → SchwartzMap (Euclidean d) ℂ,
      (∀ i ∈ I, ∀ y, ‖y‖ < 1 / 9 → f i y = 0) →
      (∀ i ∈ I, ∀ y, 9 < ‖y‖ → f i y = 0) →
      (∫⁻ x, (⨆ t : E, ‖∑ i ∈ I, (S i).indicator
        (sphericalAverage d (compactConvolution (compactSynthesisKernel φ (j i)) (f i)) t)
        x‖ₑ) ^ p ∂ν) ≤
        (2 : ℝ≥0∞) ^ p * (1 + 2 ^ p * 2 ^ p) *
          ENNReal.ofReal (a ^ (p / 2) * (B * A) ^ (1 - p / 2)) *
            ∫⁻ x, ENNReal.ofReal (schwartzSquareEnvelope I f x) ^ p := by
  obtain ⟨A₀, hA₀, hsup⟩ := synthesis_sequence_supremum_bound hd φ hφ hp hα hαlower
  let A := A₀.toReal + 1
  have hA : 0 < A := by dsimp only [A]; positivity
  have hAle : A₀ ≤ ENNReal.ofReal A := by
    rw [← ENNReal.ofReal_toReal hA₀]
    exact ENNReal.ofReal_le_ofReal (by dsimp only [A]; linarith)
  refine ⟨A, hA, ?_⟩
  intro ν E B hB hcore I j S hS hdisj a ha hdiag f hinner houter
  let T := fun g : ℕ → SchwartzMap (Euclidean d) ℂ =>
    ∫⁻ x, (⨆ t : E, ‖∑ i ∈ I, (S i).indicator
      (sphericalAverage d (compactConvolution (compactSynthesisKernel φ (j i)) (g i)) t)
      x‖ₑ) ^ p ∂ν
  have hfc (i : ℕ) (hi : i ∈ I) : HasCompactSupport (f i : Euclidean d → ℂ) := by
    apply HasCompactSupport.of_support_subset_isCompact (isCompact_closedBall 0 (9 : ℝ))
    intro x hx
    simp only [Metric.mem_closedBall, dist_zero_right]
    exact le_of_not_gt (fun hh => hx (houter i hi x hh))
  apply schwartz_square_interpolation I f volume (Metric.closedBall 0 9)
    measurableSet_closedBall (isCompact_closedBall (0 : Euclidean d) 9).measure_lt_top.ne
    hfc (fun i hi x hx => houter i hi x (by
      simpa only [Metric.mem_closedBall, dist_zero_right, not_le] using hx))
    T (by finiteness) (synthesis_sequence_moment_add_le φ I j S hS hdisj E ν (by linarith))
    ha (mul_pos hB hA) (by linarith) hp₂
  · exact fun g _ => hdiag g
  · intro g hg
    have hh := hsup ν E (ENNReal.ofReal B) ENNReal.ofReal_ne_top hcore I j S hdisj g
      (fun i hi x hx => hg i hi x (hinner i hi x hx))
      (fun i hi x hx => hg i hi x (houter i hi x hx))
    apply hh.trans
    rw [ENNReal.ofReal_mul hB.le]
    exact mul_le_mul' (mul_le_mul' le_rfl hAle) le_rfl

/-- Convert the literal unnormalized spherical supremum to the normalized
operator used by the existing power-weight development. -/
theorem spherical_supremum_le_surfaceMass_mul_normalized {d : ℕ} (hd : 0 < d)
    (E : Set ℝ) (hE : E ⊆ Ioi 0) (f : Euclidean d → ℂ) (x : Euclidean d) :
    (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ≤
      ‖(surfaceMass d : ℂ)‖ₑ * restrictedNormalizedSphericalMaximal d E f x := by
  apply iSup_le
  intro t
  have heq : sphericalAverage d f t x =
      (surfaceMass d : ℂ) * normalizedSphericalAverage d f t x := by
    rw [normalizedSphericalAverage, ← mul_assoc,
      mul_inv_cancel₀ (show (surfaceMass d : ℂ) ≠ 0 by
        exact_mod_cast surfaceMass_ne_zero hd), one_mul]
  rw [heq, enorm_mul]
  apply mul_le_mul' le_rfl
  simpa only [ofReal_norm] using
    ennreal_norm_normalizedSphericalAverage_le_restrictedNormalizedSphericalMaximal
      f t.property (hE t.property) x

theorem dyadic_low_frequency_factor {k m : ℕ} (hmk : m ≤ k) :
    ENNReal.ofReal ((2 : ℝ) ^ (k - m)) * (ENNReal.ofReal ((2 : ℝ) ^ k))⁻¹ =
      ENNReal.ofReal (((2 : ℝ) ^ m)⁻¹) := by
  rw [← ENNReal.ofReal_inv_of_pos (by positivity : (0 : ℝ) < 2 ^ k),
    ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ 2 ^ (k - m))]
  congr 1
  have heq : (2 : ℝ) ^ k = 2 ^ (k - m) * 2 ^ m := by
    rw [← pow_add, Nat.sub_add_cancel hmk]
  rw [heq, mul_inv_rev]
  field_simp

/-- Unnormalized form of the low-frequency estimate, with its explicit
decay in the difference of the spatial and frequency indices. -/
theorem synthesis_low_frequency_moment_bound {d : ℕ} (hd : 0 < d)
    (φ : SchwartzMap (Euclidean d) ℂ) {p : ℝ} (hp : 1 ≤ p) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (E : Set ℝ), E ⊆ Icc 1 2 →
      ∀ (k m : ℕ), m ≤ k → ∀ f : SchwartzMap (Euclidean d) ℂ,
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) (((2 : ℝ) ^ k)⁻¹),
        (⨆ t : E, ‖sphericalAverage d
          (compactConvolution (compactSynthesisKernel φ (k - m)) f) t x‖ₑ) ^ p
          ∂powerWeightedVolume d (1 - (d : ℝ))) ≤
        A * ENNReal.ofReal (((2 : ℝ) ^ m)⁻¹) * ∫⁻ x, ‖f x‖ₑ ^ p := by
  obtain ⟨A, hA, hb⟩ := synthesis_low_frequency_bound hd φ hp
  let M : ℝ≥0∞ := ‖(surfaceMass d : ℂ)‖ₑ ^ p
  have hM : M ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (by linarith) enorm_ne_top
  refine ⟨M * A, ENNReal.mul_ne_top hM hA, ?_⟩
  intro E hE k m hmk f
  have hpoint (x : Euclidean d) :
      (⨆ t : E, ‖sphericalAverage d
        (compactConvolution (compactSynthesisKernel φ (k - m)) f) t x‖ₑ) ^ p ≤
      M * (restrictedNormalizedSphericalMaximal d (Icc 1 2)
        (compactConvolution (compactSynthesisKernel φ (k - m)) f) x) ^ p := by
    have hh := spherical_supremum_le_surfaceMass_mul_normalized hd E
      (fun t ht => lt_of_lt_of_le zero_lt_one (hE ht).1)
      (compactConvolution (compactSynthesisKernel φ (k - m)) f) x
    have hmono : restrictedNormalizedSphericalMaximal d E
        (compactConvolution (compactSynthesisKernel φ (k - m)) f) x ≤
        restrictedNormalizedSphericalMaximal d (Icc 1 2)
          (compactConvolution (compactSynthesisKernel φ (k - m)) f) x := by
      apply iSup_le
      intro t
      exact le_iSup_of_le ⟨t, hE t.property.1, t.property.2⟩ le_rfl
    have hh' := ENNReal.rpow_le_rpow (hh.trans (mul_le_mul' le_rfl hmono))
      (by linarith : 0 ≤ p)
    simpa only [ENNReal.mul_rpow_of_nonneg _ _ (by linarith : 0 ≤ p)] using hh'
  apply (lintegral_mono hpoint).trans
  rw [lintegral_const_mul' _ _ hM]
  have hh := hb (k - m) k f f.continuous
  rw [smoothInput_eq_compactConvolution] at hh
  apply (mul_le_mul' (le_refl M) hh).trans_eq
  rw [mul_assoc A, dyadic_low_frequency_factor hmk]
  ring

/-- The diagonal low-frequency sequence endpoint. -/
theorem synthesis_low_frequency_diagonal_maximal {d : ℕ} (hd : 0 < d)
    (φ : SchwartzMap (Euclidean d) ℂ) {p : ℝ} (hp : 1 ≤ p) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (E : Set ℝ), E ⊆ Icc 1 2 →
      ∀ (L : Finset ℕ) (m : ℕ), (∀ k ∈ L, m ≤ k) →
      ∀ f : ℕ → SchwartzMap (Euclidean d) ℂ,
      (∫⁻ x, (⨆ t : E, ‖∑ k ∈ L, (dyadicSpatialShell d (-(k : ℤ) - 1)).indicator
        (sphericalAverage d (compactConvolution (compactSynthesisKernel φ (k - m)) (f k)) t)
        x‖ₑ) ^ p ∂powerWeightedVolume d (1 - (d : ℝ))) ≤
        A * ENNReal.ofReal (((2 : ℝ) ^ m)⁻¹) * ∫⁻ x, ∑ k ∈ L, ‖f k x‖ₑ ^ p := by
  obtain ⟨A, hA, hb⟩ := synthesis_low_frequency_moment_bound hd φ hp
  refine ⟨A, hA, ?_⟩
  intro E hE L m hL f
  rw [disjoint_indicator_maximal_moment _ L
    (fun k : ℕ => dyadicSpatialShell d (-(k : ℤ) - 1))
    (fun k (t : E) => sphericalAverage d
      (compactConvolution (compactSynthesisKernel φ (k - m)) (f k)) t)
    (fun k => measurableSet_dyadicSpatialShell d (-(k : ℤ) - 1))
    (pairwiseDisjoint_negative_dyadicSpatialShell d)
    (fun k => measurable_schwartz_radius_supremum _ E) (by linarith : 0 < p)]
  calc
    _ ≤ ∑ k ∈ L, A * ENNReal.ofReal (((2 : ℝ) ^ m)⁻¹) * ∫⁻ x, ‖f k x‖ₑ ^ p := by
      apply Finset.sum_le_sum
      intro k hk
      apply le_trans _ (hb E hE k m (hL k hk) (f k))
      apply lintegral_mono_set
      intro x hx
      have hh := (negative_dyadicSpatialShell_subset_annulus d k hx).1
      simpa only [Metric.mem_closedBall, dist_zero_right] using hh
    _ = _ := by
      rw [← Finset.mul_sum, lintegral_finsetSum L
        (fun k _ => (f k).continuous.measurable.enorm.pow_const p)]

/-- Source `eq:LpellqT` for `q=2`, on the annular Schwartz core. This also
holds after restricting the output measure, as needed by the bootstrap. -/
theorem synthesis_low_frequency_square_maximal {d : ℕ} (hd : 2 ≤ d)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hφ : ∀ x, (1 : ℝ) / 64 < ‖x‖ → φ x = 0)
    {p : ℝ} (hp : 1 < p) (hp₂ : p ≤ 2) :
    ∃ A₀ A₁ : ℝ, 0 < A₀ ∧ 0 < A₁ ∧
      ∀ (ν : Measure (Euclidean d)), ν ≤ powerWeightedVolume d (1 - (d : ℝ)) →
      ∀ (E : Set ℝ), E ⊆ Icc 1 2 → ∀ B : ℝ, 0 < B →
      (∀ g : SchwartzMap (Euclidean d) ℂ,
        (∫⁻ x, (⨆ t : E, ‖sphericalAverage d g t x‖ₑ) ^ p ∂ν) ≤
          ENNReal.ofReal B * ∫⁻ x, ‖g x‖ₑ ^ p ∂powerWeightedVolume d (1 - (d : ℝ))) →
      ∀ (L : Finset ℕ) (m : ℕ), (∀ k ∈ L, m ≤ k) →
      ∀ f : ℕ → SchwartzMap (Euclidean d) ℂ,
      (∀ k ∈ L, ∀ y, ‖y‖ < 1 / 9 → f k y = 0) →
      (∀ k ∈ L, ∀ y, 9 < ‖y‖ → f k y = 0) →
      (∫⁻ x, (⨆ t : E, ‖∑ k ∈ L, (dyadicSpatialShell d (-(k : ℤ) - 1)).indicator
        (sphericalAverage d (compactConvolution (compactSynthesisKernel φ (k - m)) (f k)) t)
        x‖ₑ) ^ p ∂ν) ≤
        (2 : ℝ≥0∞) ^ p * (1 + 2 ^ p * 2 ^ p) *
          ENNReal.ofReal ((A₀ * ((2 : ℝ) ^ m)⁻¹) ^ (p / 2) *
            (B * A₁) ^ (1 - p / 2)) *
              ∫⁻ x, ENNReal.ofReal (schwartzSquareEnvelope L f x) ^ p := by
  obtain ⟨D, hD, hdiag⟩ := synthesis_low_frequency_diagonal_maximal (by omega) φ hp.le
  obtain ⟨A₁, hA₁, hsq⟩ := synthesis_sequence_square_bound (by omega) φ hφ hp hp₂
    (show 1 - (d : ℝ) ≤ 0 by exact_mod_cast (show 1 - (d : ℤ) ≤ 0 by omega))
    (show -(d : ℝ) < 1 - (d : ℝ) by linarith)
  let A₀ := D.toReal + 1
  have hA₀ : 0 < A₀ := by dsimp only [A₀]; positivity
  have hDle : D ≤ ENNReal.ofReal A₀ := by
    rw [← ENNReal.ofReal_toReal hD]
    exact ENNReal.ofReal_le_ofReal (by dsimp only [A₀]; linarith)
  refine ⟨A₀, A₁, hA₀, hA₁, ?_⟩
  intro ν hν E hE B hB hcore L m hL f hinner houter
  apply hsq ν E B hB hcore L (fun k => k - m)
    (fun k => dyadicSpatialShell d (-(k : ℤ) - 1))
    (fun k => measurableSet_dyadicSpatialShell d (-(k : ℤ) - 1))
    (pairwiseDisjoint_negative_dyadicSpatialShell d)
    (A₀ * ((2 : ℝ) ^ m)⁻¹) (mul_pos hA₀ (by positivity))
    ?_ f hinner houter
  intro g
  apply (lintegral_mono' hν le_rfl).trans
  apply (hdiag E hE L m hL g).trans
  rw [ENNReal.ofReal_mul hA₀.le]
  exact mul_le_mul' (mul_le_mul' hDle le_rfl) le_rfl

/-- A telescoping majorant for the two tails of a cancellative dyadic
multiplier. It avoids choosing a logarithmic transition scale. -/
theorem min_self_inv_le_dyadic_difference {r : ℝ} (hr : 0 ≤ r) :
    min r r⁻¹ ≤ 6 * (r / (1 + r) - (r / 2) / (1 + r / 2)) := by
  have h₁ : 0 < 1 + r := by positivity
  have h₂ : 0 < 2 + r := by positivity
  have heq : r / (1 + r) - (r / 2) / (1 + r / 2) = r / ((1 + r) * (2 + r)) := by
    field_simp
    ring
  rw [heq]
  by_cases hr₁ : r ≤ 1
  · apply (min_le_left r r⁻¹).trans
    rw [← mul_div_assoc, le_div_iff₀ (mul_pos h₁ h₂)]
    nlinarith [mul_nonneg hr (sub_nonneg.mpr hr₁),
      mul_nonneg hr (mul_nonneg hr (sub_nonneg.mpr hr₁))]
  · have hrpos : 0 < r := by linarith
    apply (min_le_right r r⁻¹).trans
    rw [← mul_div_assoc, le_div_iff₀ (mul_pos h₁ h₂)]
    apply (mul_le_mul_iff_right₀ hrpos).mp
    have he : r * (r⁻¹ * ((1 + r) * (2 + r))) = (1 + r) * (2 + r) := by
      field_simp
    rw [he]
    nlinarith [sq_nonneg (r - 1)]

/-- Uniform finite geometric-tail summation for a cancellative profile. -/
theorem finite_dyadic_min_sum_le (I : Finset ℕ) {R : ℝ} (hR : 0 ≤ R) :
    (∑ j ∈ I, min (((2 : ℝ) ^ j)⁻¹ * R) ((((2 : ℝ) ^ j)⁻¹ * R)⁻¹)) ≤ 6 := by
  classical
  let r : ℕ → ℝ := fun j => ((2 : ℝ) ^ j)⁻¹ * R
  let F : ℕ → ℝ := fun j => r j / (1 + r j)
  have hr (j : ℕ) : 0 ≤ r j := by dsimp only [r]; positivity
  have hstep (j : ℕ) : r (j + 1) = r j / 2 := by dsimp only [r]; rw [pow_succ]; ring
  have hpoint (j : ℕ) : min (r j) (r j)⁻¹ ≤ 6 * (F j - F (j + 1)) := by
    simpa only [F, hstep] using min_self_inv_le_dyadic_difference (hr j)
  have htel (n : ℕ) : (∑ j ∈ Finset.range n, (F j - F (j + 1))) = F 0 - F n := by
    induction n with
    | zero => simp
    | succ n ih => rw [Finset.sum_range_succ, ih]; ring
  let n := I.sup id + 1
  have hsub : I ⊆ Finset.range n := by
    intro j hj
    exact Finset.mem_range.mpr (Nat.lt_succ_of_le (Finset.le_sup (f := id) hj))
  calc
    _ ≤ ∑ j ∈ Finset.range n, min (r j) (r j)⁻¹ :=
      Finset.sum_le_sum_of_subset_of_nonneg hsub
        (fun j _ _ => le_min (hr j) (inv_nonneg.mpr (hr j)))
    _ ≤ ∑ j ∈ Finset.range n, 6 * (F j - F (j + 1)) :=
      Finset.sum_le_sum (fun j _ => hpoint j)
    _ = 6 * (F 0 - F n) := by rw [← Finset.mul_sum, htel]
    _ ≤ 6 := by
      have hn : 0 ≤ F n := div_nonneg (hr n) (by positivity)
      have h₀ : F 0 ≤ 1 := (div_le_one (by positivity : 0 < 1 + r 0)).mpr (by linarith)
      linarith

/-- Cancellation at the origin and Schwartz decay bound every weighted
derivative by the same two-tail profile. -/
theorem schwartz_weighted_derivative_min_bound {d : ℕ}
    (G : SchwartzMap (Euclidean d) ℂ) (hG : G 0 = 0) (k : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : Euclidean d,
      ‖x‖ ^ k * ‖iteratedFDeriv ℝ k G x‖ ≤ C * min ‖x‖ ‖x‖⁻¹ := by
  let C := max (SchwartzMap.seminorm ℝ (k + 1) k G)
    (max (SchwartzMap.seminorm ℝ 0 k G) (SchwartzMap.seminorm ℝ 0 1 G))
  have hdec : SchwartzMap.seminorm ℝ (k + 1) k G ≤ C := le_max_left _ _
  have hder : SchwartzMap.seminorm ℝ 0 k G ≤ C := (le_max_left _ _).trans (le_max_right _ _)
  have hlip : SchwartzMap.seminorm ℝ 0 1 G ≤ C := (le_max_right _ _).trans (le_max_right _ _)
  have hC : 0 ≤ C := (apply_nonneg (SchwartzMap.seminorm ℝ 0 k) G).trans hder
  refine ⟨C, hC, ?_⟩
  intro x
  by_cases hx : x = 0
  · subst x
    cases k <;> simp [norm_iteratedFDeriv_zero, hG]
  have hxpos : 0 < ‖x‖ := norm_pos_iff.mpr hx
  have hinv : ‖x‖ ^ k * ‖iteratedFDeriv ℝ k G x‖ ≤ C * ‖x‖⁻¹ := by
    rw [← div_eq_mul_inv, le_div_iff₀ hxpos]
    have hh := (G.le_seminorm ℝ (k + 1) k x).trans hdec
    simpa only [pow_succ, mul_assoc, mul_left_comm, mul_comm] using hh
  by_cases hsmall : ‖x‖ ≤ 1
  · have hmin : ‖x‖ ≤ ‖x‖⁻¹ := by
      rw [inv_eq_one_div, le_div_iff₀ hxpos]
      nlinarith [norm_nonneg x]
    rw [min_eq_left hmin]
    cases k with
    | zero =>
      simp only [pow_zero, one_mul, norm_iteratedFDeriv_zero]
      have hbound (y : Euclidean d) (_hy : y ∈ (univ : Set (Euclidean d))) :
          ‖fderiv ℝ G y‖ ≤ C := by
        simpa only [norm_iteratedFDeriv_one] using
          (G.norm_iteratedFDeriv_le_seminorm ℝ 1 y).trans hlip
      have hh := Convex.norm_image_sub_le_of_norm_fderiv_le
        (fun y (_hy : y ∈ (univ : Set (Euclidean d))) => G.differentiableAt)
        hbound convex_univ (mem_univ (0 : Euclidean d)) (mem_univ x)
      simpa only [hG, sub_zero] using hh
    | succ k =>
      have hpw : ‖x‖ ^ (k + 1) ≤ ‖x‖ := by
        rw [pow_succ]
        exact mul_le_of_le_one_left (norm_nonneg _) (pow_le_one₀ (norm_nonneg _) hsmall)
      exact mul_le_mul hpw ((G.norm_iteratedFDeriv_le_seminorm ℝ (k + 1) x).trans hder)
        (norm_nonneg _) (norm_nonneg _) |>.trans_eq (mul_comm _ _)
  · have hmin : ‖x‖⁻¹ ≤ ‖x‖ := by
      rw [inv_eq_one_div, div_le_iff₀ hxpos]
      nlinarith
    rw [min_eq_right hmin]
    exact hinv

/-! ## Compact-kernel frequency tails (upper-bounds note, Section 6) -/

/-- The first absolute moment loses one factor under normalized dilation. -/
theorem integral_firstMoment_compactDyadicDilate {d : ℕ}
    (K : SchwartzMap (Euclidean d) ℂ) (j : ℕ) :
    (∫ x, ‖x‖ * ‖compactDyadicDilate K j x‖) =
      ((2 : ℝ) ^ j)⁻¹ * ∫ x, ‖x‖ * ‖K x‖ := by
  let R : ℝ := (2 : ℝ) ^ j
  have hR : 0 < R := by dsimp only [R]; positivity
  let H : Euclidean d → ℝ := fun x => ‖x‖ * ‖K x‖
  have heq (x : Euclidean d) :
      ‖x‖ * ‖compactDyadicDilate K j x‖ = R⁻¹ * (R ^ d * H (R • x)) := by
    change ‖x‖ * ‖(R ^ d : ℝ) • K (R • x)‖ = _
    rw [norm_smul, Real.norm_of_nonneg (pow_nonneg hR.le _)]
    simp only [H, norm_smul, Real.norm_of_nonneg hR.le]
    field_simp [hR.ne']
  calc
    _ = R⁻¹ * (R ^ d * ∫ x, H (R • x)) := by
      simp_rw [heq]
      rw [integral_const_mul, integral_const_mul]
    _ = R⁻¹ * ∫ x, H x := by
      rw [Measure.integral_comp_smul_of_nonneg volume H R (hR := hR.le)]
      simp [hR.ne']
    _ = _ := rfl

/-- The derivative mass gains one factor under normalized dilation. -/
theorem integral_norm_fderiv_compactDyadicDilate {d : ℕ}
    (K : SchwartzMap (Euclidean d) ℂ) (j : ℕ) :
    (∫ x, ‖fderiv ℝ (compactDyadicDilate K j : Euclidean d → ℂ) x‖) =
      (2 : ℝ) ^ j * ∫ x, ‖fderiv ℝ (K : Euclidean d → ℂ) x‖ := by
  exact Auto.Spherical.SurfaceMeasureDecay.integral_norm_fderiv_dilate_eq
    (K : Euclidean d → ℂ) (K.smooth 1) (by positivity)

/-- Cancellation turns a Schwartz convolution into the first absolute
moment of its mean-zero factor times the derivative mass of its other factor. -/
theorem compactConvolution_mean_zero_L1_bound {d : ℕ}
    (K L : SchwartzMap (Euclidean d) ℂ) (hK : (∫ y, K y) = 0) :
    (∫ x, ‖compactConvolution K L x‖) ≤
      (∫ y, ‖y‖ * ‖K y‖) * ∫ x, ‖fderiv ℝ (L : Euclidean d → ℂ) x‖ := by
  have hc := Auto.Spherical.PowerWeights.integral_norm_mean_zero_kernel_convolution_le
    (L : Euclidean d → ℂ) L.integrable (K : Euclidean d → ℂ) K.integrable hK 0
  have heq (x : Euclidean d) : compactConvolution K L x =
      ∫ y, K y * L (x - y) := by
    rw [compactConvolution, SchwartzMap.convolution_apply]
    rfl
  simp_rw [← heq] at hc
  have ht (y : Euclidean d) : (∫ x, ‖L (x - y) - L x‖) ≤
      ‖y‖ * ∫ x, ‖fderiv ℝ (L : Euclidean d → ℂ) x‖ := by
    simpa only [sub_eq_add_neg, norm_neg] using
      Auto.Spherical.PowerWeights.integral_norm_sub_translate_le_norm_mul_integral_norm_fderiv
        (L : Euclidean d → ℂ) (L.smooth 1) (integrable_fderiv_schwartz L) (-y)
  have hm : Integrable (fun y : Euclidean d => ‖y‖ * ‖K y‖) volume := by
    simpa only [pow_one] using K.integrable_pow_mul volume 1
  apply hc.trans
  calc
    _ ≤ ∫ y, (‖y‖ * ‖K y‖) *
        (∫ x, ‖fderiv ℝ (L : Euclidean d → ℂ) x‖) := by
      apply integral_mono_of_nonneg
      · filter_upwards with y
        exact mul_nonneg (norm_nonneg _) (integral_nonneg fun _ => norm_nonneg _)
      · exact hm.mul_const _
      · filter_upwards with y
        simpa only [sub_zero, mul_assoc, mul_left_comm, mul_comm] using
          mul_le_mul_of_nonneg_left (ht y) (norm_nonneg (K y))
    _ = _ := integral_mul_const _ _

/-- The literal two-scale convolution bound before comparing the scales.
Only the first factor needs a vanishing constant moment. -/
theorem compactDyadicConvolution_one_sided_L1_bound {d : ℕ}
    (K L : SchwartzMap (Euclidean d) ℂ) (hK : (∫ y, K y) = 0) (n m : ℕ) :
    (∫ x, ‖compactConvolution (compactDyadicDilate K n) (compactDyadicDilate L m) x‖) ≤
      (((2 : ℝ) ^ n)⁻¹ * (2 : ℝ) ^ m) *
        ((∫ y, ‖y‖ * ‖K y‖) * ∫ x, ‖fderiv ℝ (L : Euclidean d → ℂ) x‖) := by
  have hb := compactConvolution_mean_zero_L1_bound
    (compactDyadicDilate K n) (compactDyadicDilate L m)
    (by rw [integral_compactDyadicDilate, hK])
  rw [integral_firstMoment_compactDyadicDilate,
    integral_norm_fderiv_compactDyadicDilate] at hb
  simpa only [mul_assoc, mul_left_comm, mul_comm] using hb

/-- Two mean-zero Schwartz kernels have a geometric off-diagonal `L¹`
convolution bound. This proves the note's frequency-tail estimate with
order one, which exceeds every permitted smoothing gain. -/
theorem compactDyadicConvolution_L1_off_diagonal {d : ℕ}
    (K L : SchwartzMap (Euclidean d) ℂ)
    (hK : (∫ y, K y) = 0) (hL : (∫ y, L y) = 0) :
    ∃ C : ℝ, 0 < C ∧ ∀ n m : ℕ,
      (∫ x, ‖compactConvolution (compactDyadicDilate K n) (compactDyadicDilate L m) x‖) ≤
        C * (2 : ℝ) ^ (-|(m : ℝ) - n|) := by
  let A : ℝ := (∫ y, ‖y‖ * ‖K y‖) * ∫ x, ‖fderiv ℝ (L : Euclidean d → ℂ) x‖
  let B : ℝ := (∫ y, ‖y‖ * ‖L y‖) * ∫ x, ‖fderiv ℝ (K : Euclidean d → ℂ) x‖
  let C : ℝ := max A B + 1
  have hA : 0 ≤ A := by dsimp only [A]; positivity
  have hC : 0 < C := by dsimp only [C]; linarith [le_max_left A B]
  have hscale (n m : ℕ) : ((2 : ℝ) ^ n)⁻¹ * (2 : ℝ) ^ m =
      (2 : ℝ) ^ ((m : ℝ) - n) := by
    rw [← Real.rpow_natCast, ← Real.rpow_natCast,
      ← Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2),
      ← Real.rpow_add (by norm_num : (0 : ℝ) < 2)]
    congr 1
    ring
  refine ⟨C, hC, ?_⟩
  intro n m
  by_cases hmn : m ≤ n
  · have hd : (m : ℝ) - n ≤ 0 := by
      have hh : (m : ℝ) ≤ n := by exact_mod_cast hmn
      linarith
    have hb := compactDyadicConvolution_one_sided_L1_bound K L hK n m
    rw [abs_of_nonpos hd, neg_neg]
    apply hb.trans
    rw [hscale]
    exact mul_le_mul_of_nonneg_left
      (show A ≤ C by dsimp only [C]; linarith [le_max_left A B]) (by positivity)
      |>.trans_eq (mul_comm _ _)
  · have hd : 0 ≤ (m : ℝ) - n := by
      have hh : (n : ℝ) ≤ m := by exact_mod_cast (lt_of_not_ge hmn).le
      linarith
    rw [compactConvolution_comm]
    have hb := compactDyadicConvolution_one_sided_L1_bound L K hL m n
    rw [abs_of_nonneg hd]
    apply hb.trans
    rw [hscale]
    have he : (n : ℝ) - m = -((m : ℝ) - n) := by ring
    rw [he]
    exact mul_le_mul_of_nonneg_left
      (show B ≤ C by dsimp only [C]; linarith [le_max_right A B]) (by positivity)
      |>.trans_eq (mul_comm _ _)

/-- The inverse Fourier transform of the product of two scaled symbols is
the literal convolution of their normalized physical dilates. -/
theorem fourierInv_scaled_product_eq_compactDyadicConvolution {d : ℕ}
    (K L : SchwartzMap (Euclidean d) ℂ) (n m : ℕ) (x : Euclidean d) :
    FourierTransform.fourierInv (fun ξ : Euclidean d =>
      𝓕 K (((2 : ℝ) ^ n)⁻¹ • ξ) * 𝓕 L (((2 : ℝ) ^ m)⁻¹ • ξ)) x =
      compactConvolution (compactDyadicDilate K n) (compactDyadicDilate L m) x := by
  have hs : (fun ξ : Euclidean d =>
      𝓕 K (((2 : ℝ) ^ n)⁻¹ • ξ) * 𝓕 L (((2 : ℝ) ^ m)⁻¹ • ξ)) =
      (𝓕 (compactConvolution (compactDyadicDilate K n) (compactDyadicDilate L m)) :
        SchwartzMap (Euclidean d) ℂ) := by
    funext ξ
    simp only [fourier_compactConvolution, fourier_compactDyadicDilate]
  rw [hs, ← SchwartzMap.fourierInv_coe, FourierTransform.fourierInv_fourier_eq]

/-- A Schwartz frequency profile vanishing at zero has a mean-zero inverse
Fourier kernel. -/
theorem integral_fourierInv_eq_zero_of_profile_zero {d : ℕ}
    (G : SchwartzMap (Euclidean d) ℂ) (hG : G 0 = 0) :
    (∫ x, (𝓕⁻ G : SchwartzMap (Euclidean d) ℂ) x) = 0 := by
  have hz (K : SchwartzMap (Euclidean d) ℂ) : 𝓕 K 0 = ∫ x, K x := by
    simp [SchwartzMap.fourier_coe, Real.fourier_eq']
  rw [← hz, FourierTransform.fourier_fourierInv_eq, hG]

/-- The note's geometric inverse-Fourier product tail with order one.
In particular it applies to every fixed smooth annular output cutoff;
its only needed cancellation condition is that its value at zero vanishes. -/
theorem inverseFourier_schwartz_profile_L1_off_diagonal {d : ℕ}
    (G η : SchwartzMap (Euclidean d) ℂ) (hG : G 0 = 0) (hη : η 0 = 0) :
    ∃ C : ℝ, 0 < C ∧ ∀ n m : ℕ,
      (∫ x, ‖FourierTransform.fourierInv (fun ξ : Euclidean d =>
        G (((2 : ℝ) ^ n)⁻¹ • ξ) * η (((2 : ℝ) ^ m)⁻¹ • ξ)) x‖) ≤
          C * (2 : ℝ) ^ (-|(m : ℝ) - n|) := by
  obtain ⟨C, hC, hb⟩ := compactDyadicConvolution_L1_off_diagonal
    (𝓕⁻ G) (𝓕⁻ η) (integral_fourierInv_eq_zero_of_profile_zero G hG)
    (integral_fourierInv_eq_zero_of_profile_zero η hη)
  refine ⟨C, hC, ?_⟩
  intro n m
  have he (x : Euclidean d) :=
    fourierInv_scaled_product_eq_compactDyadicConvolution (𝓕⁻ G) (𝓕⁻ η) n m x
  simp only [FourierTransform.fourier_fourierInv_eq] at he
  simpa only [← he] using hb n m

/-- The inhomogeneous low output projection has the required one-sided
tail too. It need not vanish at frequency zero. -/
theorem inverseFourier_schwartz_profile_lowpass_L1_tail {d : ℕ}
    (G η : SchwartzMap (Euclidean d) ℂ) (hG : G 0 = 0) :
    ∃ C : ℝ, 0 < C ∧ ∀ n : ℕ,
      (∫ x, ‖FourierTransform.fourierInv (fun ξ : Euclidean d =>
        G (((2 : ℝ) ^ n)⁻¹ • ξ) * η ξ) x‖) ≤ C * ((2 : ℝ) ^ n)⁻¹ := by
  let K : SchwartzMap (Euclidean d) ℂ := 𝓕⁻ G
  let L : SchwartzMap (Euclidean d) ℂ := 𝓕⁻ η
  let A : ℝ := (∫ y, ‖y‖ * ‖K y‖) * ∫ x, ‖fderiv ℝ (L : Euclidean d → ℂ) x‖
  have hA : 0 ≤ A := by dsimp only [A]; positivity
  refine ⟨A + 1, by linarith, ?_⟩
  intro n
  have hb := compactDyadicConvolution_one_sided_L1_bound K L
    (integral_fourierInv_eq_zero_of_profile_zero G hG) n 0
  have he (x : Euclidean d) := fourierInv_scaled_product_eq_compactDyadicConvolution K L n 0 x
  simp only [K, L, FourierTransform.fourier_fourierInv_eq, pow_zero, inv_one, one_smul] at he
  rw [pow_zero, mul_one] at hb
  calc
    _ = ∫ x, ‖compactConvolution (compactDyadicDilate K n) (compactDyadicDilate L 0) x‖ := by
      apply integral_congr_ae
      filter_upwards with x
      exact congrArg norm (he x)
    _ ≤ _ := hb.trans
      (mul_le_mul_of_nonneg_left (show A ≤ A + 1 by linarith) (by positivity)
        |>.trans_eq (mul_comm _ _))

/-- Every positive compact synthesis kernel has a vanishing constant moment. -/
theorem integral_compactSynthesisKernel_succ_eq_zero {d : ℕ}
    (φ : SchwartzMap (Euclidean d) ℂ) (hφ : (∫ x, φ x) = 1) (j : ℕ) :
    (∫ x, compactSynthesisKernel φ (j + 1) x) = 0 := by
  apply integral_compactDualDifference
  · rwa [integral_compactDyadicDilate]
  · rwa [integral_compactDyadicDilate]

/-- Equation (21) for the manuscript's actual positive compact synthesis
symbols, including their frequency tails against an annular output cutoff. -/
theorem compactSynthesis_annular_frequency_L1_tail {d : ℕ}
    (φ η : SchwartzMap (Euclidean d) ℂ) (hφ : (∫ x, φ x) = 1) (hη : η 0 = 0) :
    ∃ C : ℝ, 0 < C ∧ ∀ n m : ℕ,
      (∫ x, ‖FourierTransform.fourierInv (fun ξ : Euclidean d =>
        𝓕 (compactSynthesisKernel φ (n + 1)) ξ *
          η (((2 : ℝ) ^ m)⁻¹ • ξ)) x‖) ≤ C * (2 : ℝ) ^ (-|(m : ℝ) - n|) := by
  have hz : 𝓕 (compactSynthesisKernel φ 1) 0 = 0 := by
    rw [SchwartzMap.fourier_coe, Real.fourier_eq']
    simpa using integral_compactSynthesisKernel_succ_eq_zero φ hφ 0
  obtain ⟨C, hC, hb⟩ :=
    inverseFourier_schwartz_profile_L1_off_diagonal (𝓕 (compactSynthesisKernel φ 1)) η hz hη
  refine ⟨C, hC, ?_⟩
  intro n m
  rw [compactSynthesisKernel_succ φ n]
  simpa only [fourier_compactDyadicDilate] using hb n m

/-- Equation (21) at the inhomogeneous low output frequency, for the same
actual compact synthesis symbols. -/
theorem compactSynthesis_lowpass_frequency_L1_tail {d : ℕ}
    (φ η : SchwartzMap (Euclidean d) ℂ) (hφ : (∫ x, φ x) = 1) :
    ∃ C : ℝ, 0 < C ∧ ∀ n : ℕ,
      (∫ x, ‖FourierTransform.fourierInv (fun ξ : Euclidean d =>
        𝓕 (compactSynthesisKernel φ (n + 1)) ξ * η ξ) x‖) ≤
          C * ((2 : ℝ) ^ n)⁻¹ := by
  have hz : 𝓕 (compactSynthesisKernel φ 1) 0 = 0 := by
    rw [SchwartzMap.fourier_coe, Real.fourier_eq']
    simpa using integral_compactSynthesisKernel_succ_eq_zero φ hφ 0
  obtain ⟨C, hC, hb⟩ :=
    inverseFourier_schwartz_profile_lowpass_L1_tail (𝓕 (compactSynthesisKernel φ 1)) η hz
  refine ⟨C, hC, ?_⟩
  intro n
  rw [compactSynthesisKernel_succ φ n]
  simpa only [fourier_compactDyadicDilate] using hb n

/-- The physical compact synthesis kernel after the shell rescaling
`x = 2^(-k) X`, with its exact Jacobian. -/
def rescaledCompactSynthesisKernel {d : ℕ}
    (φ : SchwartzMap (Euclidean d) ℂ) (k n : ℕ) : SchwartzMap (Euclidean d) ℂ :=
  let r : ℝ := ((2 : ℝ) ^ k)⁻¹
  (r ^ d : ℝ) • SchwartzMap.compCLMOfContinuousLinearEquiv ℂ
    (ContinuousLinearEquiv.smulLeft (Units.mk0 r (by dsimp only [r]; positivity)))
      (compactSynthesisKernel φ (k + n))

theorem rescaledCompactSynthesisKernel_apply {d : ℕ}
    (φ : SchwartzMap (Euclidean d) ℂ) (k n : ℕ) (X : Euclidean d) :
    rescaledCompactSynthesisKernel φ k n X =
      ((((2 : ℝ) ^ k)⁻¹) ^ d : ℝ) •
        compactSynthesisKernel φ (k + n) (((2 : ℝ) ^ k)⁻¹ • X) := rfl

/-- The fixed half-dilated synthesis prototype in equation (20).
Unlike the zero synthesis term, this prototype has a vanishing constant moment. -/
def rescaledCompactSynthesisPrototype {d : ℕ}
    (φ : SchwartzMap (Euclidean d) ℂ) : SchwartzMap (Euclidean d) ℂ :=
  rescaledCompactSynthesisKernel φ 1 0

theorem rescaledCompactSynthesisPrototype_apply {d : ℕ}
    (φ : SchwartzMap (Euclidean d) ℂ) (X : Euclidean d) :
    rescaledCompactSynthesisPrototype φ X =
      ((2 : ℝ)⁻¹ ^ d : ℝ) • compactSynthesisKernel φ 1 ((2 : ℝ)⁻¹ • X) := by
  simp only [rescaledCompactSynthesisPrototype, rescaledCompactSynthesisKernel_apply,
    pow_one, Nat.add_zero]

theorem integral_rescaledCompactSynthesisPrototype_eq_zero {d : ℕ}
    (φ : SchwartzMap (Euclidean d) ℂ) (hφ : (∫ x, φ x) = 1) :
    (∫ X, rescaledCompactSynthesisPrototype φ X) = 0 := by
  simp_rw [rescaledCompactSynthesisPrototype_apply]
  rw [integral_smul, Measure.integral_comp_smul_of_nonneg volume
    (compactSynthesisKernel φ 1 : Euclidean d → ℂ) (2 : ℝ)⁻¹ (hR := by norm_num)]
  rw [integral_compactSynthesisKernel_succ_eq_zero φ hφ 0]
  simp

/-- Equation (20) exactly, including the relative level `n = 0`:
all shell-rescaled kernels are normalized dilates of one half-dilated prototype. -/
theorem rescaledCompactSynthesisKernel_eq_dilate {d : ℕ}
    (φ : SchwartzMap (Euclidean d) ℂ) {k : ℕ} (hk : 1 ≤ k) (n : ℕ) :
    rescaledCompactSynthesisKernel φ k n =
      compactDyadicDilate (rescaledCompactSynthesisPrototype φ) n := by
  obtain ⟨l, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (show k ≠ 0 by omega)
  ext X
  rw [rescaledCompactSynthesisKernel_apply, compactDyadicDilate_apply,
    rescaledCompactSynthesisPrototype_apply,
    show l + 1 + n = (l + n) + 1 by omega, compactSynthesisKernel_succ,
    compactDyadicDilate_apply]
  have hs : ((2 : ℝ) ^ (l + 1))⁻¹ * (2 : ℝ) ^ (l + n) =
      (2 : ℝ) ^ n * (2 : ℝ)⁻¹ := by
    rw [pow_succ, pow_add]
    field_simp
  have hs' : (2 : ℝ) ^ (l + n) * ((2 : ℝ) ^ (l + 1))⁻¹ =
      (2 : ℝ)⁻¹ * (2 : ℝ) ^ n := by simpa only [mul_comm] using hs
  simp only [smul_smul, ← mul_pow]
  rw [hs, hs']

/-- After the exact shell rescaling, the compact synthesis kernels have
support radius at most one half. Thus the output cutoff in the supplied
repair, Section 6 following (20), covers every sampled convolution point. -/
theorem rescaledCompactSynthesisKernel_support {d : ℕ}
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hφ : ∀ Y : Euclidean d, 1 / 8 < ‖Y‖ → φ Y = 0)
    {k : ℕ} (hk : 1 ≤ k) (n : ℕ) (Y : Euclidean d) (hY : 1 / 2 < ‖Y‖) :
    rescaledCompactSynthesisKernel φ k n Y = 0 := by
  have hp : ∀ Z : Euclidean d, 1 / 2 < ‖Z‖ →
      rescaledCompactSynthesisPrototype φ Z = 0 := by
    intro Z hZ
    rw [rescaledCompactSynthesisPrototype_apply,
      compactSynthesisKernel_eq_zero φ (by norm_num : (0 : ℝ) ≤ 1 / 8) hφ 1]
    · exact smul_zero _
    · have hn : ‖(2 : ℝ)⁻¹ • Z‖ = (1 / 2 : ℝ) * ‖Z‖ := by norm_num [norm_smul]
      rw [hn]
      linarith
  rw [rescaledCompactSynthesisKernel_eq_dilate φ hk]
  apply compactDyadicDilate_eq_zero hp n
  have hpow : (1 : ℝ) ≤ 2 ^ n := one_le_pow₀ (by norm_num)
  have hb : (1 / 2 : ℝ) / (2 : ℝ) ^ n ≤ 1 / 2 := by
    apply (div_le_iff₀ (by positivity)).mpr
    linarith
  exact hb.trans_lt hY

/-- The actual rescaled kernels satisfy equation (21), uniformly in the
original shell scale and including relative level zero. -/
theorem rescaledCompactSynthesis_annular_frequency_L1_tail {d : ℕ}
    (φ η : SchwartzMap (Euclidean d) ℂ) (hφ : (∫ x, φ x) = 1) (hη : η 0 = 0) :
    ∃ C : ℝ, 0 < C ∧ ∀ k : ℕ, 1 ≤ k → ∀ n m : ℕ,
      (∫ x, ‖FourierTransform.fourierInv (fun ξ : Euclidean d =>
        𝓕 (rescaledCompactSynthesisKernel φ k n) ξ *
          η (((2 : ℝ) ^ m)⁻¹ • ξ)) x‖) ≤ C * (2 : ℝ) ^ (-|(m : ℝ) - n|) := by
  have hz : 𝓕 (rescaledCompactSynthesisPrototype φ) 0 = 0 := by
    simp only [SchwartzMap.fourier_coe, Real.fourier_eq']
    simpa using integral_rescaledCompactSynthesisPrototype_eq_zero φ hφ
  obtain ⟨C, hC, hb⟩ := inverseFourier_schwartz_profile_L1_off_diagonal
    (𝓕 (rescaledCompactSynthesisPrototype φ)) η hz hη
  refine ⟨C, hC, ?_⟩
  intro k hk n m
  simpa only [rescaledCompactSynthesisKernel_eq_dilate φ hk,
    fourier_compactDyadicDilate] using hb n m

/-- The same scale-uniform frequency tail for the low spatial output projection. -/
theorem rescaledCompactSynthesis_lowpass_frequency_L1_tail {d : ℕ}
    (φ η : SchwartzMap (Euclidean d) ℂ) (hφ : (∫ x, φ x) = 1) :
    ∃ C : ℝ, 0 < C ∧ ∀ k : ℕ, 1 ≤ k → ∀ n : ℕ,
      (∫ x, ‖FourierTransform.fourierInv (fun ξ : Euclidean d =>
        𝓕 (rescaledCompactSynthesisKernel φ k n) ξ * η ξ) x‖) ≤
          C * ((2 : ℝ) ^ n)⁻¹ := by
  have hz : 𝓕 (rescaledCompactSynthesisPrototype φ) 0 = 0 := by
    simp only [SchwartzMap.fourier_coe, Real.fourier_eq']
    simpa using integral_rescaledCompactSynthesisPrototype_eq_zero φ hφ
  obtain ⟨C, hC, hb⟩ := inverseFourier_schwartz_profile_lowpass_L1_tail
    (𝓕 (rescaledCompactSynthesisPrototype φ)) η hz
  refine ⟨C, hC, ?_⟩
  intro k hk n
  simpa only [rescaledCompactSynthesisKernel_eq_dilate φ hk,
    fourier_compactDyadicDilate] using hb n

/-- Uniform Mikhlin bounds for arbitrary finite signed dyadic dilates of
a Schwartz frequency profile vanishing at the origin. -/
theorem signed_dyadic_schwartz_mikhlin {d : ℕ}
    (G : SchwartzMap (Euclidean d) ℂ) (hG : G 0 = 0) (N : ℕ) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ (I : Finset ℕ) (c : ℕ → ℂ),
      (∀ j ∈ I, ‖c j‖ ≤ 1) → Auto.MikhlinHormander.MikhlinCondition N
        (fun x => ∑ j ∈ I, c j • G (((2 : ℝ) ^ j)⁻¹ • x)) A := by
  classical
  choose C hC hbound using schwartz_weighted_derivative_min_bound G hG
  let D := ∑ k ∈ Finset.range (N + 1), C k
  have hD : 0 ≤ D := Finset.sum_nonneg (fun k _ => hC k)
  have hCD (k : ℕ) (hk : k ≤ N) : C k ≤ D :=
    Finset.single_le_sum (fun i _ => hC i) (Finset.mem_range.mpr (by omega))
  refine ⟨6 * D, by positivity, ?_⟩
  intro I c hc
  have hsm (j : ℕ) (k : ℕ) :
      ContDiff ℝ k (fun x : Euclidean d => G (((2 : ℝ) ^ j)⁻¹ • x)) :=
    (G.smooth k).comp (contDiff_id.const_smul (((2 : ℝ) ^ j)⁻¹))
  have hterm (j : ℕ) (k : ℕ) :
      ContDiff ℝ k (fun x : Euclidean d => c j • G (((2 : ℝ) ^ j)⁻¹ • x)) :=
    (hsm j k).const_smul (c j)
  refine ⟨(ContDiff.sum (fun j _ => hterm j N)).contDiffOn, ?_⟩
  intro k hk x _hx
  rw [iteratedFDeriv_fun_sum_apply (fun j _ => (hterm j k).contDiffAt)]
  apply (mul_le_mul_of_nonneg_left (norm_sum_le _ _) (pow_nonneg (norm_nonneg _) _)).trans
  rw [Finset.mul_sum]
  have hpiece (j : ℕ) (hj : j ∈ I) :
      ‖x‖ ^ k * ‖iteratedFDeriv ℝ k
        (fun y => c j • G (((2 : ℝ) ^ j)⁻¹ • y)) x‖ ≤
      C k * min (((2 : ℝ) ^ j)⁻¹ * ‖x‖) ((((2 : ℝ) ^ j)⁻¹ * ‖x‖)⁻¹) := by
    rw [iteratedFDeriv_const_smul_apply' (hsm j k).contDiffAt, norm_smul]
    have hder := congrFun (iteratedFDeriv_comp_const_smul (((2 : ℝ) ^ j)⁻¹)
      (G.smooth k)) x
    rw [hder, norm_smul, norm_pow, Real.norm_of_nonneg (by positivity :
      0 ≤ ((2 : ℝ) ^ j)⁻¹)]
    calc
      _ ≤ ‖x‖ ^ k * ((((2 : ℝ) ^ j)⁻¹) ^ k *
          ‖iteratedFDeriv ℝ k G (((2 : ℝ) ^ j)⁻¹ • x)‖) := by
        apply mul_le_mul_of_nonneg_left _ (pow_nonneg (norm_nonneg _) _)
        exact mul_le_of_le_one_left (by positivity) (hc j hj)
      _ = ‖((2 : ℝ) ^ j)⁻¹ • x‖ ^ k *
          ‖iteratedFDeriv ℝ k G (((2 : ℝ) ^ j)⁻¹ • x)‖ := by
        rw [norm_smul, Real.norm_of_nonneg (by positivity : 0 ≤ ((2 : ℝ) ^ j)⁻¹), mul_pow]
        ring
      _ ≤ _ := by
        simpa only [norm_smul, Real.norm_of_nonneg (by positivity : 0 ≤ ((2 : ℝ) ^ j)⁻¹)]
          using hbound k (((2 : ℝ) ^ j)⁻¹ • x)
  calc
    _ ≤ ∑ j ∈ I, C k * min (((2 : ℝ) ^ j)⁻¹ * ‖x‖)
        ((((2 : ℝ) ^ j)⁻¹ * ‖x‖)⁻¹) := Finset.sum_le_sum hpiece
    _ ≤ C k * 6 := by
      rw [← Finset.mul_sum]
      exact mul_le_mul_of_nonneg_left (finite_dyadic_min_sum_le I (norm_nonneg x)) (hC k)
    _ ≤ 6 * D := by nlinarith [hCD k hk]

/-- A finite signed convolution sum is the literal Mikhlin multiplier
of the corresponding cancellative frequency profile. -/
theorem signed_dyadic_convolution_eq_mikhlin {d : ℕ}
    (K : SchwartzMap (Euclidean d) ℂ) (hK : 𝓕 K 0 = 0)
    (I : Finset ℕ) (c : ℕ → ℂ) (f : SchwartzMap (Euclidean d) ℂ) :
    (⇑(∑ j ∈ I, c j • compactConvolution (compactDyadicDilate K j) f) : Euclidean d → ℂ) =
      Auto.MikhlinHormander.mikhlinMultiplier
        (fun ξ => ∑ j ∈ I, c j • 𝓕 K (((2 : ℝ) ^ j)⁻¹ • ξ)) f := by
  classical
  let H := ∑ j ∈ I, c j • compactConvolution (compactDyadicDilate K j) f
  have hfour (ξ : Euclidean d) : 𝓕 H ξ =
      (∑ j ∈ I, c j • 𝓕 K (((2 : ℝ) ^ j)⁻¹ • ξ)) * 𝓕 f ξ := by
    simp only [H, FourierTransform.fourier_sum, FourierTransform.fourier_smul,
      sum_apply, smul_apply, fourier_compactConvolution, fourier_compactDyadicDilate,
      smul_eq_mul, Finset.sum_mul, mul_assoc]
  have hpunct : Auto.MikhlinHormander.aux_puncturedSymbol
      (fun ξ => ∑ j ∈ I, c j • 𝓕 K (((2 : ℝ) ^ j)⁻¹ • ξ)) =
        fun ξ => ∑ j ∈ I, c j • 𝓕 K (((2 : ℝ) ^ j)⁻¹ • ξ) := by
    ext ξ
    by_cases hξ : ξ = 0
    · simp [Auto.MikhlinHormander.aux_puncturedSymbol, hξ, hK]
    · simp only [Auto.MikhlinHormander.aux_puncturedSymbol, ite_eq_right hξ]
  unfold Auto.MikhlinHormander.mikhlinMultiplier
  rw [hpunct]
  have heq : (fun ξ => (∑ j ∈ I, c j • 𝓕 K (((2 : ℝ) ^ j)⁻¹ • ξ)) *
      𝓕 (f : Euclidean d → ℂ) ξ) = (⇑(𝓕 H : SchwartzMap (Euclidean d) ℂ)) := by
    ext ξ
    simpa only [SchwartzMap.fourier_coe] using (hfour ξ).symm
  rw [heq, ← SchwartzMap.fourierInv_coe]
  simp only [FourierTransform.fourierInv_fourier_eq]
  rfl

/-- The existing Mikhlin theorem controls finite signed cancellative
dyadic convolution sums uniformly over all scales and signs. -/
theorem signed_dyadic_convolution_Lp_bound {d : ℕ} (hd : 0 < d)
    (K : SchwartzMap (Euclidean d) ℂ) (hK : 𝓕 K 0 = 0)
    {p : ℝ} (hp : 1 < p) :
    ∃ B : ℝ≥0∞, B ≠ ∞ ∧ ∀ (I : Finset ℕ) (c : ℕ → ℂ),
      (∀ j ∈ I, ‖c j‖ ≤ 1) → ∀ f : SchwartzMap (Euclidean d) ℂ,
      eLpNorm (⇑(∑ j ∈ I, c j • compactConvolution (compactDyadicDilate K j) f))
        (ENNReal.ofReal p) volume ≤ B * eLpNorm (⇑f) (ENNReal.ofReal p) volume := by
  classical
  let : NeZero d := ⟨by omega⟩
  obtain ⟨A, hA, hM⟩ := signed_dyadic_schwartz_mikhlin (𝓕 K) hK (d + 1)
  let J := {v : Finset ℕ × (ℕ → ℂ) // ∀ j ∈ v.1, ‖v.2 j‖ ≤ 1}
  let m : J → Euclidean d → ℂ := fun v ξ =>
    ∑ j ∈ v.val.1, v.val.2 j • 𝓕 K (((2 : ℝ) ^ j)⁻¹ • ξ)
  obtain ⟨B, hB, hb⟩ := Auto.MikhlinHormander.mikhlin m hA
    (fun v => hM v.val.1 v.val.2 v.property) (by omega) hp
  refine ⟨B, hB, ?_⟩
  intro I c hc f
  rw [signed_dyadic_convolution_eq_mikhlin K hK I c f]
  exact hb ⟨(I, c), hc⟩ f

/-- The existing Rademacher lower moment estimate in square-envelope form. -/
theorem square_envelope_le_rademacher_moment {ι : Type*} [DecidableEq ι]
    (I : Finset ι) (z : ι → ℂ) {p : ℝ} (hp : 0 ≤ p) :
    (Real.sqrt (∑ i ∈ I, ‖z i‖ ^ 2)) ^ p ≤
      (12 * (2 : ℝ) ^ (p / 2) / I.powerset.card) *
        ∑ u ∈ I.powerset, ‖Auto.LittlewoodPaley.rademacherSignedSum I u z‖ ^ p := by
  have hh := Auto.LittlewoodPaley.rademacher_lower_moment I z hp
  have hS : 0 ≤ ∑ i ∈ I, ‖z i‖ ^ 2 := Finset.sum_nonneg (fun _ _ => sq_nonneg _)
  have hcard : 0 < (I.powerset.card : ℝ) := by positivity
  have htwo : 0 < (2 : ℝ) ^ (p / 2) := Real.rpow_pos_of_pos (by norm_num) _
  rw [Real.div_rpow hS (by norm_num : (0 : ℝ) ≤ 2)] at hh
  have he : (I.powerset.card : ℝ) / 12 * ((∑ i ∈ I, ‖z i‖ ^ 2) ^ (p / 2) /
      (2 : ℝ) ^ (p / 2)) = (I.powerset.card : ℝ) * (∑ i ∈ I, ‖z i‖ ^ 2) ^ (p / 2) /
        (12 * (2 : ℝ) ^ (p / 2)) := by ring
  rw [he] at hh
  have hh' := (div_le_iff₀ (mul_pos (by norm_num : (0 : ℝ) < 12) htwo)).mp hh
  rw [Real.sqrt_eq_rpow, ← Real.rpow_mul hS]
  have he₁ : (1 / 2 : ℝ) * p = p / 2 := by ring
  rw [he₁, div_mul_eq_mul_div, le_div_iff₀ hcard]
  nlinarith

/-- Finite square moments follow from uniform signed moments, with a
constant independent of the number of terms. -/
theorem schwartz_square_moment_of_signed {d : ℕ} (I : Finset ℕ)
    (f : ℕ → SchwartzMap (Euclidean d) ℂ) (μ : Measure (Euclidean d))
    {p : ℝ} (hp : 0 < p) {M Q : ℝ≥0∞}
    (hsigned : ∀ u ∈ I.powerset,
      (∫⁻ x, ‖Auto.LittlewoodPaley.rademacherSignedSum I u (fun i => f i x)‖ₑ ^ p ∂μ) ≤
        M * Q) :
    (∫⁻ x, ENNReal.ofReal (schwartzSquareEnvelope I f x) ^ p ∂μ) ≤
      ENNReal.ofReal (12 * (2 : ℝ) ^ (p / 2)) * M * Q := by
  classical
  let A := 12 * (2 : ℝ) ^ (p / 2) / I.powerset.card
  have hA : 0 ≤ A := by dsimp only [A]; positivity
  have hpoint (x : Euclidean d) : ENNReal.ofReal (schwartzSquareEnvelope I f x) ^ p ≤
      ENNReal.ofReal A * ∑ u ∈ I.powerset,
        ‖Auto.LittlewoodPaley.rademacherSignedSum I u (fun i => f i x)‖ₑ ^ p := by
    have hh := ENNReal.ofReal_le_ofReal
      (square_envelope_le_rademacher_moment I (fun i => f i x) hp.le)
    rw [ENNReal.ofReal_mul hA] at hh
    simpa only [schwartzSquareEnvelope, A,
      ENNReal.ofReal_sum_of_nonneg (fun u hu => Real.rpow_nonneg (norm_nonneg _) _),
      ← ENNReal.ofReal_rpow_of_nonneg (Real.sqrt_nonneg _) hp.le,
      ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp.le, ofReal_norm] using hh
  have hmeas (u : Finset ℕ) : Measurable (fun x =>
      ‖Auto.LittlewoodPaley.rademacherSignedSum I u (fun i => f i x)‖ₑ ^ p) := by
    apply Measurable.pow_const
    apply Continuous.measurable
    apply Continuous.enorm
    exact continuous_finsetSum I (fun i _ => continuous_const.mul (f i).continuous)
  apply (lintegral_mono hpoint).trans
  rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
    lintegral_finsetSum I.powerset (fun u _ => hmeas u)]
  calc
    _ ≤ ENNReal.ofReal A * ∑ u ∈ I.powerset, M * Q :=
      mul_le_mul' le_rfl (Finset.sum_le_sum hsigned)
    _ = ENNReal.ofReal A * (I.powerset.card : ℝ≥0∞) * M * Q := by
      rw [Finset.sum_const, nsmul_eq_mul]
      ring
    _ = _ := by
      have hcard : (I.powerset.card : ℝ) ≠ 0 := by positivity
      rw [← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul hA]
      simp only [A, div_mul_cancel₀ _ hcard]

/-- A cancellative Schwartz convolution profile has a uniform dyadic
square-function estimate for every `1<p<∞`. -/
theorem cancellative_dyadic_square_moment_bound {d : ℕ} (hd : 0 < d)
    (K : SchwartzMap (Euclidean d) ℂ) (hK : 𝓕 K 0 = 0)
    {p : ℝ} (hp : 1 < p) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (I : Finset ℕ) (f : SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x, ENNReal.ofReal (schwartzSquareEnvelope I
        (fun j => compactConvolution (compactDyadicDilate K j) f) x) ^ p) ≤
          A * ∫⁻ x, ‖f x‖ₑ ^ p := by
  classical
  obtain ⟨B, hB, hb⟩ := signed_dyadic_convolution_Lp_bound hd K hK hp
  let A := ENNReal.ofReal (12 * (2 : ℝ) ^ (p / 2)) * B ^ p
  have hp0 : 0 < p := by linarith
  have hA : A ≠ ∞ := ENNReal.mul_ne_top ENNReal.ofReal_ne_top
    (ENNReal.rpow_ne_top_of_nonneg hp0.le hB)
  refine ⟨A, hA, ?_⟩
  intro I f
  have hm (g : SchwartzMap (Euclidean d) ℂ) :
      (∫⁻ x, ‖g x‖ₑ ^ p) = eLpNorm (⇑g) (ENNReal.ofReal p) volume ^ p := by
    simpa only [ofReal_norm] using
      Auto.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow hp0
        (⇑g) g.continuous.aestronglyMeasurable
  have hsign (u : Finset ℕ) (j : ℕ) : ‖Auto.LittlewoodPaley.rademacherSign u j‖ ≤ 1 := by
    simp only [Auto.LittlewoodPaley.rademacherSign]
    split <;> norm_num
  have hbound (u : Finset ℕ) (_hu : u ∈ I.powerset) :
      (∫⁻ x, ‖Auto.LittlewoodPaley.rademacherSignedSum I u
        (fun j => compactConvolution (compactDyadicDilate K j) f x)‖ₑ ^ p) ≤
          B ^ p * ∫⁻ x, ‖f x‖ₑ ^ p := by
    let H := ∑ j ∈ I, Auto.LittlewoodPaley.rademacherSign u j •
      compactConvolution (compactDyadicDilate K j) f
    have heq (x : Euclidean d) : H x = Auto.LittlewoodPaley.rademacherSignedSum I u
        (fun j => compactConvolution (compactDyadicDilate K j) f x) := by
      simp only [H, sum_apply, smul_apply, smul_eq_mul,
        Auto.LittlewoodPaley.rademacherSignedSum]
    have hh := ENNReal.rpow_le_rpow
      (hb I (Auto.LittlewoodPaley.rademacherSign u) (fun j _ => hsign u j) f) hp0.le
    rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← hm f] at hh
    change eLpNorm (⇑H) (ENNReal.ofReal p) volume ^ p ≤ _ at hh
    rw [← hm H] at hh
    simpa only [heq] using hh
  have hh := schwartz_square_moment_of_signed I
    (fun j => compactConvolution (compactDyadicDilate K j) f) volume hp0 hbound
  exact hh

/-- The existing BRRS Young inequality supplies the single lowpass term. -/
theorem compactConvolution_moment_bound {d : ℕ}
    (K f : SchwartzMap (Euclidean d) ℂ) {p : ℝ} (hp : 1 ≤ p) :
    (∫⁻ x, ‖compactConvolution K f x‖ₑ ^ p) ≤
      (∫⁻ y, ‖K y‖ₑ) ^ p * ∫⁻ x, ‖f x‖ₑ ^ p := by
  have hp0 : 0 < p := by linarith
  have hb := Auto.Spherical.BRRS.brrs_eLpNorm_schwartz_convolution_le_of_memLp
    K p hp (f.memLp (ENNReal.ofReal p) volume)
  have heq : (⇑(compactConvolution K f) : Euclidean d → ℂ) =
      (⇑K) ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] (⇑f) := by
    rw [← smoothInput_eq_compactConvolution]
    rfl
  rw [← heq] at hb
  have hh := ENNReal.rpow_le_rpow hb hp0.le
  rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le] at hh
  have hm (g : SchwartzMap (Euclidean d) ℂ) :=
    Auto.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow (μ := volume) hp0
      (⇑g) g.continuous.aestronglyMeasurable
  simpa only [← hm, ofReal_norm] using hh

/-- Uniform Littlewood--Paley square moments for the actual compact
analysis kernels, including the noncancellative lowpass term. -/
theorem compactAnalysis_square_moment_bound {d : ℕ} (hd : 0 < d)
    (φ : SchwartzMap (Euclidean d) ℂ) {p : ℝ} (hp : 1 < p) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (N : ℕ) (f : SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x, ENNReal.ofReal (schwartzSquareEnvelope (Finset.range N)
        (fun j => compactConvolution (compactAnalysisKernel φ j) f) x) ^ p) ≤
          A * ∫⁻ x, ‖f x‖ₑ ^ p := by
  classical
  let ψ := compactAnalysisKernel φ 1
  have hψ : 𝓕 ψ 0 = 0 := by
    simp only [ψ, compactAnalysisKernel, sub_eq_add_neg, FourierTransform.fourier_add,
      FourierTransform.fourier_neg, add_apply, neg_apply, fourier_compactDyadicDilate,
      smul_zero, add_neg_cancel]
  obtain ⟨A₁, hA₁, hb⟩ := cancellative_dyadic_square_moment_bound hd ψ hψ hp
  let A₀ : ℝ≥0∞ := (∫⁻ y, ‖φ y‖ₑ) ^ p
  have hA₀ : A₀ ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (by linarith)
    φ.integrable.hasFiniteIntegral.ne
  refine ⟨(2 : ℝ≥0∞) ^ p * (A₀ + A₁), by finiteness, ?_⟩
  intro N f
  cases N with
  | zero => simp [schwartzSquareEnvelope, ENNReal.zero_rpow_of_pos (by linarith : 0 < p)]
  | succ N =>
    let g := fun j => compactConvolution (compactAnalysisKernel φ j) f
    let h := fun j => compactConvolution (compactDyadicDilate ψ j) f
    have hpoint (x : Euclidean d) : schwartzSquareEnvelope (Finset.range (N + 1)) g x ≤
        ‖compactConvolution φ f x‖ + schwartzSquareEnvelope (Finset.range N) h x := by
      have hsq : schwartzSquareEnvelope (Finset.range (N + 1)) g x ^ 2 =
          ‖compactConvolution φ f x‖ ^ 2 + schwartzSquareEnvelope (Finset.range N) h x ^ 2 := by
        rw [schwartzSquareEnvelope_sq, schwartzSquareEnvelope_sq, Finset.sum_range_succ']
        change (∑ j ∈ Finset.range N, ‖g (j + 1) x‖ ^ 2) + ‖g 0 x‖ ^ 2 = _
        have hsum : (∑ j ∈ Finset.range N, ‖g (j + 1) x‖ ^ 2) =
            ∑ j ∈ Finset.range N, ‖h j x‖ ^ 2 := by
          apply Finset.sum_congr rfl
          intro j _
          dsimp only [g, h]
          rw [compactAnalysisKernel_succ φ j]
        rw [hsum]
        change _ + ‖compactConvolution φ f x‖ ^ 2 = _
        ring
      have hleft := schwartzSquareEnvelope_nonneg (Finset.range (N + 1)) g x
      have hright := schwartzSquareEnvelope_nonneg (Finset.range N) h x
      nlinarith [norm_nonneg (compactConvolution φ f x),
        mul_nonneg (norm_nonneg (compactConvolution φ f x)) hright]
    have hpow (x : Euclidean d) :
        ENNReal.ofReal (schwartzSquareEnvelope (Finset.range (N + 1)) g x) ^ p ≤
          (2 : ℝ≥0∞) ^ p * (‖compactConvolution φ f x‖ₑ ^ p +
            ENNReal.ofReal (schwartzSquareEnvelope (Finset.range N) h x) ^ p) := by
      have hh := ENNReal.ofReal_le_ofReal (hpoint x)
      rw [ENNReal.ofReal_add (norm_nonneg _)
        (schwartzSquareEnvelope_nonneg (Finset.range N) h x), ofReal_norm] at hh
      exact (ENNReal.rpow_le_rpow hh (by linarith)).trans
        (ENNReal.add_rpow_le_two_rpow_mul_rpow_add_rpow _ _ (by linarith))
    apply (lintegral_mono hpow).trans
    rw [lintegral_const_mul' _ _ (by finiteness),
      lintegral_add_left ((compactConvolution φ f).continuous.measurable.enorm.pow_const p)]
    have hh := mul_le_mul' (le_refl ((2 : ℝ≥0∞) ^ p))
      (add_le_add (compactConvolution_moment_bound φ f hp.le) (hb (Finset.range N) f))
    simpa only [A₀, add_mul, mul_assoc] using hh

/-- Selecting distinct frequency indices cannot increase a finite square
envelope beyond the envelope of an enclosing set of frequencies. -/
theorem schwartzSquareEnvelope_reindex_le {d : ℕ} (I J : Finset ℕ)
    (ρ : ℕ → ℕ) (hρ : Set.InjOn ρ (↑I : Set ℕ))
    (hIJ : ∀ i ∈ I, ρ i ∈ J) (f : ℕ → SchwartzMap (Euclidean d) ℂ)
    (x : Euclidean d) :
    schwartzSquareEnvelope I (fun i => f (ρ i)) x ≤ schwartzSquareEnvelope J f x := by
  classical
  apply Real.sqrt_le_sqrt
  change (∑ i ∈ I, ‖f (ρ i) x‖ ^ 2) ≤ ∑ j ∈ J, ‖f j x‖ ^ 2
  rw [← Finset.sum_image (f := fun j => ‖f j x‖ ^ 2) hρ]
  apply Finset.sum_le_sum_of_subset_of_nonneg
  · intro j hj
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hj
    exact hIJ i hi
  · exact fun j _ _ => sq_nonneg _

/-- Uniform analysis square moments for any finite selection of distinct
frequency indices, including both shifts used in the source. -/
theorem compactAnalysis_reindexed_square_moment_bound {d : ℕ} (hd : 0 < d)
    (φ : SchwartzMap (Euclidean d) ℂ) {p : ℝ} (hp : 1 < p) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (I : Finset ℕ) (ρ : ℕ → ℕ),
      Set.InjOn ρ (↑I : Set ℕ) → ∀ f : SchwartzMap (Euclidean d) ℂ,
      (∫⁻ x, ENNReal.ofReal (schwartzSquareEnvelope I
        (fun i => compactConvolution (compactAnalysisKernel φ (ρ i)) f) x) ^ p) ≤
          A * ∫⁻ x, ‖f x‖ₑ ^ p := by
  classical
  obtain ⟨A, hA, hb⟩ := compactAnalysis_square_moment_bound hd φ hp
  refine ⟨A, hA, ?_⟩
  intro I ρ hρ f
  let N := I.sup ρ + 1
  have hIJ : ∀ i ∈ I, ρ i ∈ Finset.range N := fun i hi =>
    Finset.mem_range.mpr (Nat.lt_succ_of_le (Finset.le_sup (f := ρ) hi))
  have hpoint (x : Euclidean d) := schwartzSquareEnvelope_reindex_le I (Finset.range N) ρ hρ
    hIJ (fun j => compactConvolution (compactAnalysisKernel φ j) f) x
  exact (lintegral_mono (fun x => ENNReal.rpow_le_rpow
    (ENNReal.ofReal_le_ofReal (hpoint x)) (by linarith : 0 ≤ p))).trans (hb N f)

/-- Compact analysis preserves the enlarged input annulus needed by the
two sequence estimates. -/
theorem compactAnalysis_annular_support {d : ℕ}
    (φ f : SchwartzMap (Euclidean d) ℂ)
    (hφ : ∀ x, (1 : ℝ) / 200 < ‖x‖ → φ x = 0)
    (hinner : ∀ x, ‖x‖ < 1 / 8 → f x = 0)
    (houter : ∀ x, 8 < ‖x‖ → f x = 0) (j : ℕ) :
    (∀ x, ‖x‖ < 1 / 9 → compactConvolution (compactAnalysisKernel φ j) f x = 0) ∧
      (∀ x, 9 < ‖x‖ → compactConvolution (compactAnalysisKernel φ j) f x = 0) := by
  have hK := compactAnalysisKernel_eq_zero φ (by norm_num : (0 : ℝ) ≤ 1 / 200) hφ j
  constructor
  · intro x hx
    apply compactConvolution_eq_zero_of_inner_radius _ _ hK hinner
    linarith
  · intro x hx
    apply compactConvolution_eq_zero_of_radius _ _ hK houter
    linarith

/-- On the middle input annulus, the unweighted compact analysis square
estimate is controlled by the original endpoint weighted input moment. -/
theorem compactAnalysis_annular_square_moment_bound {d : ℕ} (hd : 0 < d)
    (φ : SchwartzMap (Euclidean d) ℂ) {p : ℝ} (hp : 1 < p) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (I : Finset ℕ) (ρ : ℕ → ℕ),
      Set.InjOn ρ (↑I : Set ℕ) → ∀ f : SchwartzMap (Euclidean d) ℂ,
      (∀ x, ‖x‖ < 1 / 8 → f x = 0) → (∀ x, 8 < ‖x‖ → f x = 0) →
      (∫⁻ x, ENNReal.ofReal (schwartzSquareEnvelope I
        (fun i => compactConvolution (compactAnalysisKernel φ (ρ i)) f) x) ^ p) ≤
          A * ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d (1 - (d : ℝ)) := by
  obtain ⟨A, hA, hb⟩ := compactAnalysis_reindexed_square_moment_bound hd φ hp
  let W : ℝ≥0∞ := (8 ^ (1 - (d : ℝ)))⁻¹
  have hW : W ≠ ∞ := ENNReal.inv_ne_top.mpr (ENNReal.rpow_pos
    (by norm_num : (0 : ℝ≥0∞) < 8) (by norm_num)).ne'
  refine ⟨A * W, ENNReal.mul_ne_top hA hW, ?_⟩
  intro I ρ hρ f hinner houter
  have hd' : (1 : ℝ) ≤ d := by exact_mod_cast hd
  have hsupport (x : Euclidean d) (hx : x ∉ euclideanAnnulus d (1 / 8) 8) :
      ‖f x‖ₑ ^ p = 0 := by
    have hx' : ¬ (‖x‖ ≤ 8 ∧ 1 / 8 ≤ ‖x‖) := by
      simpa only [euclideanAnnulus, Set.mem_sdiff, Metric.mem_closedBall, Metric.mem_ball,
        dist_zero_right, not_lt] using hx
    have hz : f x = 0 := by
      by_cases hh : ‖x‖ ≤ 8
      · exact hinner x (lt_of_not_ge (fun h => hx' ⟨hh, h⟩))
      · exact houter x (lt_of_not_ge hh)
    rw [hz, enorm_zero, ENNReal.zero_rpow_of_pos (by linarith : 0 < p)]
  have hh := lintegral_volume_le_outerPower_inv_mul_powerWeightedVolume_of_annular_support
    (by linarith : 1 - (d : ℝ) ≤ 0) (by norm_num : (0 : ℝ) < 1 / 8)
    (by norm_num : (1 : ℝ) / 8 ≤ 8) (fun x => ‖f x‖ₑ ^ p)
    (f.continuous.measurable.enorm.pow_const p) hsupport
  apply (hb I ρ hρ f).trans
  simpa only [ENNReal.ofReal_ofNat, W, mul_assoc] using mul_le_mul' (le_refl A) hh

/-- Spherical averaging commutes with Schwartz convolution. -/
theorem schwartzSphericalAverage_compactConvolution {d : ℕ}
    (K f : SchwartzMap (Euclidean d) ℂ) (t : ℝ) :
    schwartzSphericalAverage (compactConvolution K f) t =
      compactConvolution K (schwartzSphericalAverage f t) := by
  have he : 𝓕 (schwartzSphericalAverage (compactConvolution K f) t) =
      𝓕 (compactConvolution K (schwartzSphericalAverage f t)) := by
    ext ξ
    simp only [schwartzSphericalAverage, FourierTransform.fourier_fourierInv_eq,
      schwartzSurfaceMultiplier_apply, fourier_compactConvolution]
    ring
  simpa using congrArg (fun g : SchwartzMap (Euclidean d) ℂ => 𝓕⁻ g) he

/-- Supplied repair, Section 6, (19): after rescaling a spatial shell, the
actual compact synthesis piece is spatial convolution against the exact
normalized circular average. The support condition ensures that every
sampled output point stays in the nonsingular normalized coordinate box. -/
theorem sphericalAverage_compactSynthesis_rescaled
    (φ f : SchwartzMap (Euclidean 2) ℂ) (k n : ℕ)
    {a ρ : ℝ} (ha : 0 < a) (_hρ : 0 ≤ ρ) (X : Euclidean 2) (s : ℝ)
    (hK : ∀ Y : Euclidean 2, ρ < ‖Y‖ → rescaledCompactSynthesisKernel φ k n Y = 0)
    (hsmall : |((2 : ℝ) ^ k)⁻¹ / a| * (|s| + ‖X‖ + ρ) ≤ 1 / 2) :
    sphericalAverage 2 (compactConvolution (compactSynthesisKernel φ (k + n)) f)
        (a + ((2 : ℝ) ^ k)⁻¹ * s) (((2 : ℝ) ^ k)⁻¹ • X) =
      ∫ Y : Euclidean 2, rescaledCompactSynthesisKernel φ k n Y *
        Auto.Spherical.MSS.normalizedCircleAverage (((2 : ℝ) ^ k)⁻¹ / a)
          (fun ω u => f ((a + ((2 : ℝ) ^ k)⁻¹ * u) • ω)) (X - Y) s := by
  let r : ℝ := ((2 : ℝ) ^ k)⁻¹
  have hr : 0 < r := by dsimp only [r]; positivity
  let t : ℝ := a + r * s
  let K := compactSynthesisKernel φ (k + n)
  let H : Euclidean 2 → ℂ := fun z => K z * sphericalAverage 2 f t (r • X - z)
  have hav : sphericalAverage 2 (compactConvolution K f) t (r • X) =
      compactConvolution K (schwartzSphericalAverage f t) (r • X) := by
    have he := congrArg (fun g : SchwartzMap (Euclidean 2) ℂ => g (r • X))
      (schwartzSphericalAverage_compactConvolution K f t)
    simpa only [schwartzSphericalAverage_apply] using he
  have hscale : (∫ Y : Euclidean 2, (r ^ 2 : ℝ) • H (r • Y)) = ∫ z, H z := by
    rw [integral_smul, Measure.integral_comp_smul_of_nonneg volume H r (hR := hr.le)]
    simp [hr.ne']
  change sphericalAverage 2 (compactConvolution K f) t (r • X) = _
  rw [hav, compactConvolution, SchwartzMap.convolution_apply]
  simp_rw [schwartzSphericalAverage_apply]
  change (∫ z : Euclidean 2, H z) = _
  rw [← hscale]
  apply integral_congr_ae
  filter_upwards [] with Y
  have hpt : (r ^ 2 : ℝ) • H (r • Y) =
      rescaledCompactSynthesisKernel φ k n Y *
        sphericalAverage 2 f t (r • (X - Y)) := by
    simp only [H, rescaledCompactSynthesisKernel_apply, K, r, smul_sub,
      smul_mul_assoc]
  rw [hpt]
  by_cases hzero : rescaledCompactSynthesisKernel φ k n Y = 0
  · simp only [hzero, zero_mul]
  · have hY : ‖Y‖ ≤ ρ := le_of_not_gt (fun hY => hzero (hK Y hY))
    have hb : |r / a| * (|s| + ‖X - Y‖) ≤ 1 / 2 := by
      apply le_trans _ hsmall
      apply mul_le_mul_of_nonneg_left _ (abs_nonneg _)
      have hn := norm_sub_le X Y
      linarith
    rw [Auto.Spherical.MSS.sphericalAverage_eq_normalizedCircleAverage ha r (X - Y) s f hb]

/-- The compact resolution passes through every spherical average. This
provides the pointwise limit needed after the uniform finite-sum estimates. -/
theorem sphericalAverage_compact_resolution {d : ℕ}
    (φ f : SchwartzMap (Euclidean d) ℂ) (hφ : (∫ x, φ x) = 1)
    (t : ℝ) (x : Euclidean d) :
    Tendsto (fun J : ℕ => ∑ j ∈ Finset.range (J + 1),
      sphericalAverage d (compactConvolution (compactSynthesisKernel φ j)
        (compactConvolution (compactAnalysisKernel φ j) f)) t x)
      atTop (𝓝 (sphericalAverage d f t x)) := by
  have hh := compact_kernel_resolution_sum φ (schwartzSphericalAverage f t) hφ x
  simpa only [← schwartzSphericalAverage_apply, schwartzSphericalAverage_compactConvolution]
    using hh

/-- Finite Minkowski summation in moment form, allowing infinite moments
but with no loss depending on the number of terms. -/
theorem finite_sum_moment_bound {X : Type*} [MeasurableSpace X]
    (μ : Measure X) (I : Finset ℕ) (G : ℕ → X → ℝ≥0∞)
    (hG : ∀ i ∈ I, Measurable (G i)) {p : ℝ} (hp : 1 ≤ p)
    (a : ℕ → ℝ≥0∞) (Q : ℝ≥0∞)
    (hbound : ∀ i ∈ I, (∫⁻ x, G i x ^ p ∂μ) ≤ a i ^ p * Q) :
    (∫⁻ x, (∑ i ∈ I, G i x) ^ p ∂μ) ≤ (∑ i ∈ I, a i) ^ p * Q := by
  have hp0 : 0 < p := by linarith
  have hnorm (i : ℕ) (hi : i ∈ I) :
      eLpNorm' (G i) p μ ≤ a i * Q ^ (1 / p) := by
    rw [eLpNorm'_eq_lintegral_enorm]
    simp only [enorm_eq_self]
    have hh := ENNReal.rpow_le_rpow (hbound i hi) (by positivity : 0 ≤ 1 / p)
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : 0 ≤ 1 / p),
      ← ENNReal.rpow_mul, mul_one_div_cancel hp0.ne', ENNReal.rpow_one] at hh
    exact hh
  have hh := (eLpNorm'_sum_le (fun i hi => (hG i hi).aestronglyMeasurable) hp).trans
    (Finset.sum_le_sum hnorm)
  rw [← Finset.sum_mul] at hh
  have hpw := ENNReal.rpow_le_rpow hh hp0.le
  rw [← lintegral_rpow_enorm_eq_rpow_eLpNorm' hp0,
    ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul,
    one_div_mul_cancel hp0.ne', ENNReal.rpow_one] at hpw
  simpa only [Finset.sum_apply, enorm_eq_self] using hpw

/-- Maximal sums are dominated by the sum of their individual maximal
norms, followed by finite Minkowski summation. -/
theorem finite_maximal_sum_moment_bound {X T : Type*} [MeasurableSpace X]
    (μ : Measure X) (I : Finset ℕ) (F : ℕ → T → X → ℂ)
    (hF : ∀ i ∈ I, Measurable (fun x => ⨆ t, ‖F i t x‖ₑ))
    {p : ℝ} (hp : 1 ≤ p) (a : ℕ → ℝ≥0∞) (Q : ℝ≥0∞)
    (hbound : ∀ i ∈ I, (∫⁻ x, (⨆ t, ‖F i t x‖ₑ) ^ p ∂μ) ≤ a i ^ p * Q) :
    (∫⁻ x, (⨆ t, ‖∑ i ∈ I, F i t x‖ₑ) ^ p ∂μ) ≤ (∑ i ∈ I, a i) ^ p * Q := by
  apply le_trans _ (finite_sum_moment_bound μ I (fun i x => ⨆ t, ‖F i t x‖ₑ)
    hF hp a Q hbound)
  apply lintegral_mono
  intro x
  apply ENNReal.rpow_le_rpow _ (by linarith)
  apply iSup_le
  intro t
  exact (enorm_sum_le _ _).trans
    (Finset.sum_le_sum (fun i _ => le_iSup (fun t => ‖F i t x‖ₑ) t))

/-- The pointwise disjoint-shell identity underlying the diagonal moment
formula, now exposed for measurability of the frequency sums. -/
theorem disjoint_indicator_maximal_norm_eq {X ι T : Type*}
    (I : Finset ι) (S : ι → Set X) (F : ι → T → X → ℂ)
    (hdisj : Pairwise (Function.onFun Disjoint S)) (x : X) :
    (⨆ t, ‖∑ i ∈ I, (S i).indicator (F i t) x‖ₑ) =
      ∑ i ∈ I, (S i).indicator (fun y => ⨆ t, ‖F i t y‖ₑ) x := by
  classical
  by_cases hx : ∃ i ∈ I, x ∈ S i
  · obtain ⟨i, hi, hxi⟩ := hx
    have hother (j : ι) (hji : j ≠ i) : x ∉ S j := by
      intro hxj
      exact Set.disjoint_left.mp (hdisj hji) hxj hxi
    have hs (t : T) : (∑ j ∈ I, (S j).indicator (F j t) x) = F i t x := by
      rw [Finset.sum_eq_single i]
      · exact Set.indicator_of_mem hxi _
      · intro j _ hji
        exact Set.indicator_of_notMem (hother j hji) _
      · exact fun hh => (hh hi).elim
    simp_rw [hs]
    rw [Finset.sum_eq_single i]
    · rw [Set.indicator_of_mem hxi]
    · intro j _ hji
      exact Set.indicator_of_notMem (hother j hji) _
    · exact fun hh => (hh hi).elim
  · have hn (i : ι) (hi : i ∈ I) : x ∉ S i := fun hh => hx ⟨i, hi, hh⟩
    have hs (t : T) : (∑ i ∈ I, (S i).indicator (F i t) x) = 0 := by
      apply Finset.sum_eq_zero
      intro i hi
      exact Set.indicator_of_notMem (hn i hi) _
    have hzero : (⨆ _t : T, (0 : ℝ≥0∞)) = 0 :=
      le_antisymm (iSup_le fun _ => le_rfl) bot_le
    simp_rw [hs, enorm_zero]
    rw [hzero]
    symm
    apply Finset.sum_eq_zero
    intro i hi
    exact Set.indicator_of_notMem (hn i hi) _

theorem measurable_disjoint_indicator_maximal_norm {X ι T : Type*} [MeasurableSpace X]
    (I : Finset ι) (S : ι → Set X) (F : ι → T → X → ℂ)
    (hS : ∀ i, MeasurableSet (S i)) (hdisj : Pairwise (Function.onFun Disjoint S))
    (hF : ∀ i, Measurable (fun x => ⨆ t, ‖F i t x‖ₑ)) :
    Measurable (fun x => ⨆ t, ‖∑ i ∈ I, (S i).indicator (F i t) x‖ₑ) := by
  simp_rw [disjoint_indicator_maximal_norm_eq I S F hdisj]
  exact Finset.measurable_sum I (fun i _ => (hF i).indicator (hS i))

/-- The high-frequency square estimate with the Assouad decay and scalar
bootstrap constant displayed separately. -/
theorem synthesis_high_frequency_square_maximal {d N : ℕ} (hd : 2 ≤ d)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N)
    (hφ : ∀ x, (1 : ℝ) / 64 < ‖x‖ → φ x = 0)
    {p γ : ℝ} (hp : 1 < p) (hp₂ : p < 2) (hγ : 0 ≤ γ) :
    ∃ A₀ A₁ : ℝ, 0 < A₀ ∧ 0 < A₁ ∧
      ∀ (ν : Measure (Euclidean d)), ν ≤ powerWeightedVolume d (1 - (d : ℝ)) →
      ∀ (E : Set ℝ), E ⊆ Icc 1 2 → ∀ C : ℝ, 0 ≤ C →
      (∀ δ a b : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ a → a ≤ b → b ≤ 2 → δ ≤ b - a →
        ∃ J : Finset ℝ, IsIntervalCover (E ∩ Icc a b) δ J ∧
          (J.card : ℝ) ≤ C * ((b - a) / δ) ^ γ) →
      ∀ B : ℝ, 0 < B →
      (∀ g : SchwartzMap (Euclidean d) ℂ,
        (∫⁻ x, (⨆ t : E, ‖sphericalAverage d g t x‖ₑ) ^ p ∂ν) ≤
          ENNReal.ofReal B * ∫⁻ x, ‖g x‖ₑ ^ p ∂powerWeightedVolume d (1 - (d : ℝ))) →
      ∀ (L : Finset ℕ), (∀ k ∈ L, 4 ≤ k) → ∀ (n : ℕ)
      (f : ℕ → SchwartzMap (Euclidean d) ℂ),
      (∀ k ∈ L, ∀ y, ‖y‖ < 1 / 9 → f k y = 0) →
      (∀ k ∈ L, ∀ y, 9 < ‖y‖ → f k y = 0) →
      (∫⁻ x, (⨆ t : E, ‖∑ k ∈ L, (dyadicSpatialShell d (-(k : ℤ) - 1)).indicator
        (sphericalAverage d (compactConvolution (compactSynthesisKernel φ (k + n)) (f k)) t)
        x‖ₑ) ^ p ∂ν) ≤
        (2 : ℝ≥0∞) ^ p * (1 + 2 ^ p * 2 ^ p) *
          ENNReal.ofReal ((A₀ * (C + 1) * (2 : ℝ) ^
            (-((n : ℝ) * (((d : ℝ) - 1) * (p - 1) - γ)))) ^ (p / 2) *
              (B * A₁) ^ (1 - p / 2)) *
                ∫⁻ x, ENNReal.ofReal (schwartzSquareEnvelope L f x) ^ p := by
  obtain ⟨D, hD, hdiag⟩ := synthesis_assouad_diagonal_maximal hd φ hflat hN
    (fun x hx => hφ x (by linarith)) hp hp₂ hγ
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  obtain ⟨A₁, hA₁, hsq⟩ := synthesis_sequence_square_bound (by omega) φ hφ hp hp₂.le
    (show 1 - (d : ℝ) ≤ 0 by linarith) (show -(d : ℝ) < 1 - (d : ℝ) by linarith)
  let A₀ := D.toReal + 1
  have hA₀ : 0 < A₀ := by dsimp only [A₀]; positivity
  have hDle : D ≤ ENNReal.ofReal A₀ := by
    rw [← ENNReal.ofReal_toReal hD]
    exact ENNReal.ofReal_le_ofReal (by dsimp only [A₀]; linarith)
  refine ⟨A₀, A₁, hA₀, hA₁, ?_⟩
  intro ν hν E hE C hC hcover B hB hcore L hL n f hinner houter
  let r := -((n : ℝ) * (((d : ℝ) - 1) * (p - 1) - γ))
  apply hsq ν E B hB hcore L (fun k => k + n)
    (fun k => dyadicSpatialShell d (-(k : ℤ) - 1))
    (fun k => measurableSet_dyadicSpatialShell d (-(k : ℤ) - 1))
    (pairwiseDisjoint_negative_dyadicSpatialShell d)
    (A₀ * (C + 1) * (2 : ℝ) ^ r) (by positivity) ?_ f hinner houter
  intro g
  apply (lintegral_mono' hν le_rfl).trans
  apply (hdiag E hE C hC hcover L hL n g).trans
  have hpow : ENNReal.ofReal ((2 : ℝ) ^ r) = (2 : ℝ≥0∞) ^ r := by
    rw [← ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 2), ENNReal.ofReal_ofNat]
  rw [ENNReal.ofReal_mul (mul_nonneg hA₀.le (by linarith)),
    ENNReal.ofReal_mul hA₀.le, hpow]
  exact mul_le_mul' (mul_le_mul' (mul_le_mul' hDle
    (ENNReal.ofReal_le_ofReal (by linarith))) le_rfl) le_rfl

theorem sequence_interpolation_coefficient_factor {a b B r p : ℝ}
    (ha : 0 < a) (hb : 0 < b) (hB : 0 < B) (hr : 0 < r)
    (hp : 0 ≤ p) (hp₂ : p ≤ 2) :
    ENNReal.ofReal ((a * r) ^ (p / 2) * (B * b) ^ (1 - p / 2)) =
      ENNReal.ofReal a ^ (p / 2) * ENNReal.ofReal b ^ (1 - p / 2) *
        ENNReal.ofReal B ^ (1 - p / 2) * ENNReal.ofReal r ^ (p / 2) := by
  rw [ENNReal.ofReal_mul (Real.rpow_nonneg (mul_nonneg ha.le hr.le) _),
    ← ENNReal.ofReal_rpow_of_pos (mul_pos ha hr),
    ← ENNReal.ofReal_rpow_of_pos (mul_pos hB hb),
    ENNReal.ofReal_mul ha.le, ENNReal.ofReal_mul hB.le,
    ENNReal.mul_rpow_of_nonneg _ _ (by linarith : 0 ≤ p / 2),
    ENNReal.mul_rpow_of_nonneg _ _ (by linarith : 0 ≤ 1 - p / 2)]
  ring

theorem dyadic_square_decay_identity (n : ℕ) (β p : ℝ) :
    ((2 : ℝ≥0∞) ^ (-((n : ℝ) * β))) ^ (p / 2) =
      (((2 : ℝ≥0∞) ^ (-β / 2)) ^ n) ^ p := by
  rw [← ENNReal.rpow_natCast ((2 : ℝ≥0∞) ^ (-β / 2)) n]
  simp only [← ENNReal.rpow_mul]
  congr 1
  ring

/-- A geometric series of maximal pieces has a bound uniform over every
finite set of frequency differences. -/
theorem finite_geometric_maximal_moment_bound {X T : Type*} [MeasurableSpace X]
    (μ : Measure X) (I : Finset ℕ) (F : ℕ → T → X → ℂ)
    (hF : ∀ i ∈ I, Measurable (fun x => ⨆ t, ‖F i t x‖ₑ))
    {p : ℝ} (hp : 1 ≤ p) (r Q : ℝ≥0∞)
    (hbound : ∀ i ∈ I, (∫⁻ x, (⨆ t, ‖F i t x‖ₑ) ^ p ∂μ) ≤ (r ^ i) ^ p * Q) :
    (∫⁻ x, (⨆ t, ‖∑ i ∈ I, F i t x‖ₑ) ^ p ∂μ) ≤ ((1 - r)⁻¹) ^ p * Q := by
  apply (finite_maximal_sum_moment_bound μ I F hF hp (fun i => r ^ i) Q hbound).trans
  apply mul_le_mul' _ le_rfl
  apply ENNReal.rpow_le_rpow _ (by linarith)
  exact (ENNReal.sum_le_tsum I).trans_eq (ENNReal.tsum_geometric r)

/-- One term of the compact resolution, with the analysis and synthesis
operators kept together. -/
def compactResolutionPiece {d : ℕ} (φ : SchwartzMap (Euclidean d) ℂ)
    (j : ℕ) (f : SchwartzMap (Euclidean d) ℂ) : SchwartzMap (Euclidean d) ℂ :=
  compactConvolution (compactSynthesisKernel φ j)
    (compactConvolution (compactAnalysisKernel φ j) f)

/-- The finite spatial localization of selected compact resolution terms. -/
def localizedResolutionPiece {d : ℕ} (φ : SchwartzMap (Euclidean d) ℂ)
    (L : Finset ℕ) (ρ : ℕ → ℕ) (f : SchwartzMap (Euclidean d) ℂ)
    (t : ℝ) (x : Euclidean d) : ℂ :=
  ∑ k ∈ L, (dyadicSpatialShell d (-(k : ℤ) - 1)).indicator
    (sphericalAverage d (compactResolutionPiece φ (ρ k) f) t) x

theorem measurable_localizedResolutionPiece_maximal {d : ℕ}
    (φ : SchwartzMap (Euclidean d) ℂ) (L : Finset ℕ) (ρ : ℕ → ℕ)
    (f : SchwartzMap (Euclidean d) ℂ) (E : Set ℝ) :
    Measurable (fun x => ⨆ t : E, ‖localizedResolutionPiece φ L ρ f t x‖ₑ) := by
  exact measurable_disjoint_indicator_maximal_norm L
    (fun k => dyadicSpatialShell d (-(k : ℤ) - 1))
    (fun k (t : E) => sphericalAverage d (compactResolutionPiece φ (ρ k) f) t)
    (fun k => measurableSet_dyadicSpatialShell d (-(k : ℤ) - 1))
    (pairwiseDisjoint_negative_dyadicSpatialShell d)
    (fun k => measurable_schwartz_radius_supremum _ E)

/-- Source `eq:I-II`: the high-frequency summand, after inserting the
actual compact analysis of the middle input. -/
theorem high_resolution_piece_moment_bound {d N : ℕ} (hd : 2 ≤ d)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N)
    (hφ : ∀ x, (1 : ℝ) / 200 < ‖x‖ → φ x = 0)
    {p γ C : ℝ} (hp : 1 < p) (hp₂ : p < 2) (hγ : 0 ≤ γ) (hC : 0 ≤ C) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧
      ∀ (ν : Measure (Euclidean d)), ν ≤ powerWeightedVolume d (1 - (d : ℝ)) →
      ∀ (E : Set ℝ), E ⊆ Icc 1 2 →
      (∀ δ a b : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ a → a ≤ b → b ≤ 2 → δ ≤ b - a →
        ∃ J : Finset ℝ, IsIntervalCover (E ∩ Icc a b) δ J ∧
          (J.card : ℝ) ≤ C * ((b - a) / δ) ^ γ) →
      ∀ B : ℝ, 0 < B →
      (∀ g : SchwartzMap (Euclidean d) ℂ,
        (∫⁻ x, (⨆ t : E, ‖sphericalAverage d g t x‖ₑ) ^ p ∂ν) ≤
          ENNReal.ofReal B * ∫⁻ x, ‖g x‖ₑ ^ p ∂powerWeightedVolume d (1 - (d : ℝ))) →
      ∀ (L : Finset ℕ), (∀ k ∈ L, 4 ≤ k) → ∀ (n : ℕ)
      (f : SchwartzMap (Euclidean d) ℂ),
      (∀ x, ‖x‖ < 1 / 8 → f x = 0) → (∀ x, 8 < ‖x‖ → f x = 0) →
      (∫⁻ x, (⨆ t : E, ‖localizedResolutionPiece φ L (fun k => k + n) f t x‖ₑ) ^ p ∂ν) ≤
        (((2 : ℝ≥0∞) ^ (-(((d : ℝ) - 1) * (p - 1) - γ) / 2)) ^ n) ^ p *
          (A * ENNReal.ofReal B ^ (1 - p / 2) *
            ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d (1 - (d : ℝ))) := by
  obtain ⟨A₀, A₁, hA₀, hA₁, hb⟩ := synthesis_high_frequency_square_maximal hd φ hflat hN
    (fun x hx => hφ x (by linarith)) hp hp₂ hγ
  obtain ⟨P, hP, hsq⟩ := compactAnalysis_annular_square_moment_bound (by omega) φ hp
  let A : ℝ≥0∞ := 2 ^ p * (1 + 2 ^ p * 2 ^ p) *
    ENNReal.ofReal (A₀ * (C + 1)) ^ (p / 2) * ENNReal.ofReal A₁ ^ (1 - p / 2) * P
  have hp₀ : 0 ≤ p := by linarith
  have hhalf : 0 ≤ p / 2 := by linarith
  have hθ : 0 ≤ 1 - p / 2 := by linarith
  refine ⟨A, ?_, ?_⟩
  · exact ENNReal.mul_ne_top (ENNReal.mul_ne_top (ENNReal.mul_ne_top
      (ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg hp₀ (by norm_num))
        (ENNReal.add_ne_top.mpr ⟨by norm_num, ENNReal.mul_ne_top
          (ENNReal.rpow_ne_top_of_nonneg hp₀ (by norm_num))
          (ENNReal.rpow_ne_top_of_nonneg hp₀ (by norm_num))⟩))
      (ENNReal.rpow_ne_top_of_nonneg hhalf ENNReal.ofReal_ne_top))
      (ENNReal.rpow_ne_top_of_nonneg hθ ENNReal.ofReal_ne_top)) hP
  intro ν hν E hE hcover B hB hcore L hL n f hinner houter
  have hs := compactAnalysis_annular_support φ f hφ hinner houter
  have hρ : Set.InjOn (fun k : ℕ => k + n) (↑L : Set ℕ) := by
    intro i _ j _ hij
    exact Nat.add_right_cancel hij
  have hh := hb ν hν E hE C hC hcover B hB hcore L hL n
    (fun k => compactConvolution (compactAnalysisKernel φ (k + n)) f)
    (fun k _ => (hs (k + n)).1) (fun k _ => (hs (k + n)).2)
  apply hh.trans
  apply (mul_le_mul' (le_refl _) (hsq L _ hρ f hinner houter)).trans_eq
  rw [sequence_interpolation_coefficient_factor (mul_pos hA₀ (by linarith))
    hA₁ hB (by positivity) hp₀ hp₂.le,
    ← ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 2), ENNReal.ofReal_ofNat,
    dyadic_square_decay_identity]
  dsimp only [A]
  ring

/-- Source `eq:I-II`: the low-frequency summand has a summable geometric
factor independent of the spatial truncation. -/
theorem low_resolution_piece_moment_bound {d : ℕ} (hd : 2 ≤ d)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hφ : ∀ x, (1 : ℝ) / 200 < ‖x‖ → φ x = 0)
    {p : ℝ} (hp : 1 < p) (hp₂ : p ≤ 2) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧
      ∀ (ν : Measure (Euclidean d)), ν ≤ powerWeightedVolume d (1 - (d : ℝ)) →
      ∀ (E : Set ℝ), E ⊆ Icc 1 2 → ∀ B : ℝ, 0 < B →
      (∀ g : SchwartzMap (Euclidean d) ℂ,
        (∫⁻ x, (⨆ t : E, ‖sphericalAverage d g t x‖ₑ) ^ p ∂ν) ≤
          ENNReal.ofReal B * ∫⁻ x, ‖g x‖ₑ ^ p ∂powerWeightedVolume d (1 - (d : ℝ))) →
      ∀ (L : Finset ℕ) (m : ℕ), (∀ k ∈ L, m ≤ k) →
      ∀ f : SchwartzMap (Euclidean d) ℂ,
      (∀ x, ‖x‖ < 1 / 8 → f x = 0) → (∀ x, 8 < ‖x‖ → f x = 0) →
      (∫⁻ x, (⨆ t : E, ‖localizedResolutionPiece φ L (fun k => k - m) f t x‖ₑ) ^ p ∂ν) ≤
        (((2 : ℝ≥0∞) ^ (-(1 : ℝ) / 2)) ^ m) ^ p *
          (A * ENNReal.ofReal B ^ (1 - p / 2) *
            ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d (1 - (d : ℝ))) := by
  obtain ⟨A₀, A₁, hA₀, hA₁, hb⟩ := synthesis_low_frequency_square_maximal hd φ
    (fun x hx => hφ x (by linarith)) hp hp₂
  obtain ⟨P, hP, hsq⟩ := compactAnalysis_annular_square_moment_bound (by omega) φ hp
  let A : ℝ≥0∞ := 2 ^ p * (1 + 2 ^ p * 2 ^ p) *
    ENNReal.ofReal A₀ ^ (p / 2) * ENNReal.ofReal A₁ ^ (1 - p / 2) * P
  have hp₀ : 0 ≤ p := by linarith
  have hhalf : 0 ≤ p / 2 := by linarith
  have hθ : 0 ≤ 1 - p / 2 := by linarith
  refine ⟨A, ?_, ?_⟩
  · exact ENNReal.mul_ne_top (ENNReal.mul_ne_top (ENNReal.mul_ne_top
      (ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg hp₀ (by norm_num))
        (ENNReal.add_ne_top.mpr ⟨by norm_num, ENNReal.mul_ne_top
          (ENNReal.rpow_ne_top_of_nonneg hp₀ (by norm_num))
          (ENNReal.rpow_ne_top_of_nonneg hp₀ (by norm_num))⟩))
      (ENNReal.rpow_ne_top_of_nonneg hhalf ENNReal.ofReal_ne_top))
      (ENNReal.rpow_ne_top_of_nonneg hθ ENNReal.ofReal_ne_top)) hP
  intro ν hν E hE B hB hcore L m hL f hinner houter
  have hs := compactAnalysis_annular_support φ f hφ hinner houter
  have hρ : Set.InjOn (fun k : ℕ => k - m) (↑L : Set ℕ) := by
    intro i hi j hj hij
    have hi' := hL i hi
    have hj' := hL j hj
    dsimp only at hij
    omega
  have hh := hb ν hν E hE B hB hcore L m hL
    (fun k => compactConvolution (compactAnalysisKernel φ (k - m)) f)
    (fun k _ => (hs (k - m)).1) (fun k _ => (hs (k - m)).2)
  apply hh.trans
  apply (mul_le_mul' (le_refl _) (hsq L _ hρ f hinner houter)).trans_eq
  rw [sequence_interpolation_coefficient_factor hA₀ hA₁ hB (by positivity) hp₀ hp₂]
  have he : ENNReal.ofReal (((2 : ℝ) ^ m)⁻¹) = (2 : ℝ≥0∞) ^ (-((m : ℝ) * 1)) := by
    rw [mul_one, ENNReal.rpow_neg, ENNReal.rpow_natCast, ENNReal.ofReal_inv_of_pos (by positivity),
      ENNReal.ofReal_pow (by norm_num), ENNReal.ofReal_ofNat]
  rw [he, dyadic_square_decay_identity]
  dsimp only [A]
  ring

/-- Quantitative local Assouad covers on the normalized radius interval. -/
def LocalAssouadCoverBound (E : Set ℝ) (γ C : ℝ) : Prop :=
  ∀ δ a b : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ a → a ≤ b → b ≤ 2 → δ ≤ b - a →
    ∃ J : Finset ℝ, IsIntervalCover (E ∩ Icc a b) δ J ∧
      (J.card : ℝ) ≤ C * ((b - a) / δ) ^ γ

/-- A scalar core estimate used as bootstrap data, with the output measure
allowed to be truncated. This is not an assertion of the target theorem. -/
def SchwartzCoreMomentBound {d : ℕ} (ν : Measure (Euclidean d))
    (E : Set ℝ) (p B : ℝ) : Prop :=
  ∀ g : SchwartzMap (Euclidean d) ℂ,
    (∫⁻ x, (⨆ t : E, ‖sphericalAverage d g t x‖ₑ) ^ p ∂ν) ≤
      ENNReal.ofReal B * ∫⁻ x, ‖g x‖ₑ ^ p ∂powerWeightedVolume d (1 - (d : ℝ))

/-- Both geometric series in source `eq:I-II`, for arbitrary finite
frequency differences and arbitrary compatible finite shell selections. -/
theorem finite_geometric_sum_moment_bound {X : Type*} [MeasurableSpace X]
    (μ : Measure X) (I : Finset ℕ) (F : ℕ → X → ℝ≥0∞)
    (hF : ∀ i ∈ I, Measurable (F i)) {p : ℝ} (hp : 1 ≤ p) (r Q : ℝ≥0∞)
    (hbound : ∀ i ∈ I, (∫⁻ x, F i x ^ p ∂μ) ≤ (r ^ i) ^ p * Q) :
    (∫⁻ x, (∑ i ∈ I, F i x) ^ p ∂μ) ≤ ((1 - r)⁻¹) ^ p * Q := by
  apply (finite_sum_moment_bound μ I F hF hp (fun i => r ^ i) Q hbound).trans
  exact mul_le_mul' (ENNReal.rpow_le_rpow
    ((ENNReal.sum_le_tsum I).trans_eq (ENNReal.tsum_geometric r)) (by linarith)) le_rfl

theorem resolution_frequency_sums_moment_bound {d N : ℕ} (hd : 2 ≤ d)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N)
    (hφ : ∀ x, (1 : ℝ) / 200 < ‖x‖ → φ x = 0)
    {p γ C : ℝ} (hp : 1 < p) (hp₂ : p < 2) (hγ : 0 ≤ γ) (hC : 0 ≤ C)
    (hgap : γ < ((d : ℝ) - 1) * (p - 1)) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧
      ∀ (ν : Measure (Euclidean d)), ν ≤ powerWeightedVolume d (1 - (d : ℝ)) →
      ∀ (E : Set ℝ), E ⊆ Icc 1 2 → LocalAssouadCoverBound E γ C →
      ∀ B : ℝ, 0 < B → SchwartzCoreMomentBound ν E p B →
      ∀ (I : Finset ℕ) (L : ℕ → Finset ℕ) (f : SchwartzMap (Euclidean d) ℂ),
      (∀ x, ‖x‖ < 1 / 8 → f x = 0) → (∀ x, 8 < ‖x‖ → f x = 0) →
      ((∀ n ∈ I, ∀ k ∈ L n, 4 ≤ k) →
        (∫⁻ x, (∑ n ∈ I, ⨆ t : E,
          ‖localizedResolutionPiece φ (L n) (fun k => k + n) f t x‖ₑ) ^ p ∂ν) ≤
            A * ENNReal.ofReal B ^ (1 - p / 2) *
              ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d (1 - (d : ℝ))) ∧
      ((∀ m ∈ I, ∀ k ∈ L m, m ≤ k) →
        (∫⁻ x, (∑ m ∈ I, ⨆ t : E,
          ‖localizedResolutionPiece φ (L m) (fun k => k - m) f t x‖ₑ) ^ p ∂ν) ≤
            A * ENNReal.ofReal B ^ (1 - p / 2) *
              ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d (1 - (d : ℝ))) := by
  obtain ⟨H, hH, hbH⟩ := high_resolution_piece_moment_bound hd φ hflat hN hφ hp hp₂ hγ hC
  obtain ⟨D, hD, hbD⟩ := low_resolution_piece_moment_bound hd φ hφ hp hp₂.le
  let r : ℝ≥0∞ := 2 ^ (-(((d : ℝ) - 1) * (p - 1) - γ) / 2)
  let s : ℝ≥0∞ := 2 ^ (-(1 : ℝ) / 2)
  have hr : r < 1 := ENNReal.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  have hs : s < 1 := ENNReal.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by norm_num)
  have hR : ((1 - r)⁻¹) ^ p ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (by linarith)
    (ENNReal.inv_ne_top.mpr (tsub_pos_iff_lt.mpr hr).ne')
  have hS : ((1 - s)⁻¹) ^ p ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (by linarith)
    (ENNReal.inv_ne_top.mpr (tsub_pos_iff_lt.mpr hs).ne')
  let A := ((1 - r)⁻¹) ^ p * H + ((1 - s)⁻¹) ^ p * D
  refine ⟨A, ENNReal.add_ne_top.mpr ⟨ENNReal.mul_ne_top hR hH,
    ENNReal.mul_ne_top hS hD⟩, ?_⟩
  intro ν hν E hE hcover B hB hcore I L f hinner houter
  constructor
  · intro hL
    have hh := finite_geometric_sum_moment_bound ν I
      (fun n x => ⨆ t : E, ‖localizedResolutionPiece φ (L n) (fun k => k + n) f t x‖ₑ)
      (fun n _ => measurable_localizedResolutionPiece_maximal φ (L n) _ f E) hp.le r
      (H * ENNReal.ofReal B ^ (1 - p / 2) *
        ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d (1 - (d : ℝ)))
      (fun n hn => hbH ν hν E hE hcover B hB hcore (L n) (hL n hn) n f hinner houter)
    apply hh.trans
    simpa only [mul_assoc] using mul_le_mul' (mul_le_mul'
      (le_add_right (le_refl (((1 - r)⁻¹) ^ p * H))) le_rfl) le_rfl
  · intro hL
    have hh := finite_geometric_sum_moment_bound ν I
      (fun m x => ⨆ t : E, ‖localizedResolutionPiece φ (L m) (fun k => k - m) f t x‖ₑ)
      (fun m _ => measurable_localizedResolutionPiece_maximal φ (L m) _ f E) hp.le s
      (D * ENNReal.ofReal B ^ (1 - p / 2) *
        ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d (1 - (d : ℝ)))
      (fun m hm => hbD ν hν E hE B hB hcore (L m) m (hL m hm) f hinner houter)
    apply hh.trans
    simpa only [mul_assoc] using mul_le_mul' (mul_le_mul'
      (le_add_left (le_refl (((1 - s)⁻¹) ^ p * D))) le_rfl) le_rfl

/-- Reindexing a finite frequency interval above and below a spatial index. -/
theorem finite_frequency_split {V : Type*} [AddCommMonoid V]
    (u : ℕ → V) (J k K : ℕ) (hk : k ≤ K) :
    (∑ j ∈ Finset.range (J + 1), u j) =
      (∑ n ∈ (Finset.range (J + 1)).filter (fun n => k + n ≤ J), u (k + n)) +
      ∑ m ∈ (Finset.range (K + 1)).filter
        (fun m => 0 < m ∧ m ≤ k ∧ k - m ≤ J), u (k - m) := by
  classical
  have hhigh : (∑ j ∈ (Finset.range (J + 1)).filter (fun j => k ≤ j), u j) =
      ∑ n ∈ (Finset.range (J + 1)).filter (fun n => k + n ≤ J), u (k + n) := by
    apply Finset.sum_bij (fun j _ => j - k)
    · intro j hj
      simp only [Finset.mem_filter, Finset.mem_range] at hj ⊢
      omega
    · intro i hi j hj hij
      simp only [Finset.mem_filter, Finset.mem_range] at hi hj
      omega
    · intro n hn
      simp only [Finset.mem_filter, Finset.mem_range] at hn
      refine ⟨k + n, ?_, by omega⟩
      simp only [Finset.mem_filter, Finset.mem_range]
      omega
    · intro j hj
      simp only [Finset.mem_filter, Finset.mem_range] at hj
      congr 1
      omega
  have hlow : (∑ j ∈ (Finset.range (J + 1)).filter (fun j => ¬ k ≤ j), u j) =
      ∑ m ∈ (Finset.range (K + 1)).filter
        (fun m => 0 < m ∧ m ≤ k ∧ k - m ≤ J), u (k - m) := by
    apply Finset.sum_bij (fun j _ => k - j)
    · intro j hj
      simp only [Finset.mem_filter, Finset.mem_range] at hj ⊢
      omega
    · intro i hi j hj hij
      simp only [Finset.mem_filter, Finset.mem_range] at hi hj
      omega
    · intro m hm
      simp only [Finset.mem_filter, Finset.mem_range] at hm
      refine ⟨k - m, ?_, by omega⟩
      simp only [Finset.mem_filter, Finset.mem_range]
      omega
    · intro j hj
      simp only [Finset.mem_filter, Finset.mem_range] at hj
      congr 1
      omega
  rw [← hhigh, ← hlow, Finset.sum_filter_add_sum_filter_not]

/-- The finite high/low decomposition is exact before taking norms. -/
theorem localized_resolution_frequency_split {d : ℕ}
    (φ f : SchwartzMap (Euclidean d) ℂ) (L : Finset ℕ) (J : ℕ)
    (t : ℝ) (x : Euclidean d) :
    (∑ k ∈ L, (dyadicSpatialShell d (-(k : ℤ) - 1)).indicator
      (fun y => ∑ j ∈ Finset.range (J + 1),
        sphericalAverage d (compactResolutionPiece φ j f) t y) x) =
      (∑ n ∈ Finset.range (J + 1), localizedResolutionPiece φ
        (L.filter (fun k => k + n ≤ J)) (fun k => k + n) f t x) +
      ∑ m ∈ Finset.range (L.sup id + 1), localizedResolutionPiece φ
        (L.filter (fun k => 0 < m ∧ m ≤ k ∧ k - m ≤ J)) (fun k => k - m) f t x := by
  classical
  simp only [localizedResolutionPiece, Finset.sum_filter]
  rw [Finset.sum_comm (s := Finset.range (J + 1)),
    Finset.sum_comm (s := Finset.range (L.sup id + 1)), ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro k hk
  by_cases hx : x ∈ dyadicSpatialShell d (-(k : ℤ) - 1)
  · simp only [Set.indicator_of_mem hx]
    simpa only [Finset.sum_filter] using finite_frequency_split
      (fun j => sphericalAverage d (compactResolutionPiece φ j f) t x)
      J k (L.sup id) (Finset.le_sup (f := id) hk)
  · simp [Set.indicator_of_notMem hx]

/-- Fatou's lemma for maximal functions with pointwise convergence for
each parameter. Uniformity in the parameter is not required. -/
theorem maximal_moment_le_of_tendsto {X T : Type*} [MeasurableSpace X]
    (μ : Measure X) (F : T → X → ℂ) (Fj : ℕ → T → X → ℂ)
    {p : ℝ} (hp : 0 < p) (Q : ℝ≥0∞)
    (hFj : ∀ j, Measurable (fun x => ⨆ t, ‖Fj j t x‖ₑ))
    (hlim : ∀ t x, Tendsto (fun j => Fj j t x) atTop (𝓝 (F t x)))
    (hb : ∀ j, (∫⁻ x, (⨆ t, ‖Fj j t x‖ₑ) ^ p ∂μ) ≤ Q) :
    (∫⁻ x, (⨆ t, ‖F t x‖ₑ) ^ p ∂μ) ≤ Q := by
  have hpoint (x : X) : (⨆ t, ‖F t x‖ₑ) ^ p ≤
      liminf (fun j => (⨆ t, ‖Fj j t x‖ₑ) ^ p) atTop := by
    apply (ENNReal.le_rpow_inv_iff hp).mp
    apply iSup_le
    intro t
    apply (ENNReal.le_rpow_inv_iff hp).mpr
    have ht := (ENNReal.continuous_rpow_const (y := p)).continuousAt.tendsto.comp
      ((continuous_enorm.tendsto (F t x)).comp (hlim t x))
    rw [← ht.liminf_eq]
    exact liminf_le_liminf (Eventually.of_forall (fun j => ENNReal.rpow_le_rpow
      (le_iSup (fun t => ‖Fj j t x‖ₑ) t) hp.le))
  calc
    _ ≤ ∫⁻ x, liminf (fun j => (⨆ t, ‖Fj j t x‖ₑ) ^ p) atTop ∂μ := lintegral_mono hpoint
    _ ≤ liminf (fun j => ∫⁻ x, (⨆ t, ‖Fj j t x‖ₑ) ^ p ∂μ) atTop :=
      lintegral_liminf_le (fun j => (hFj j).pow_const p)
    _ ≤ liminf (fun _j : ℕ => Q) atTop :=
      liminf_le_liminf (Eventually.of_forall hb)
    _ = Q := liminf_const _

/-- Source `eq:I-II` on every finite selection of inner spatial shells.
The constant is independent of both truncation lengths. -/
theorem localized_resolution_moment_bound {d N : ℕ} (hd : 2 ≤ d)
    (φ : SchwartzMap (Euclidean d) ℂ) (hmass : ∫ x, φ x = 1)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N)
    (hφ : ∀ x, (1 : ℝ) / 200 < ‖x‖ → φ x = 0)
    {p γ C : ℝ} (hp : 1 < p) (hp₂ : p < 2) (hγ : 0 ≤ γ) (hC : 0 ≤ C)
    (hgap : γ < ((d : ℝ) - 1) * (p - 1)) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧
      ∀ (ν : Measure (Euclidean d)), ν ≤ powerWeightedVolume d (1 - (d : ℝ)) →
      ∀ (E : Set ℝ), E ⊆ Icc 1 2 → LocalAssouadCoverBound E γ C →
      ∀ B : ℝ, 0 < B → SchwartzCoreMomentBound ν E p B →
      ∀ (L : Finset ℕ), (∀ k ∈ L, 4 ≤ k) → ∀ f : SchwartzMap (Euclidean d) ℂ,
      (∀ x, ‖x‖ < 1 / 8 → f x = 0) → (∀ x, 8 < ‖x‖ → f x = 0) →
      (∫⁻ x, (⨆ t : E, ‖∑ k ∈ L, (dyadicSpatialShell d (-(k : ℤ) - 1)).indicator
        (sphericalAverage d f t) x‖ₑ) ^ p ∂ν) ≤
          A * ENNReal.ofReal B ^ (1 - p / 2) *
            ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d (1 - (d : ℝ)) := by
  classical
  obtain ⟨A, hA, hb⟩ := resolution_frequency_sums_moment_bound hd φ hflat hN hφ
    hp hp₂ hγ hC hgap
  refine ⟨2 ^ p * (A + A), ENNReal.mul_ne_top
    (ENNReal.rpow_ne_top_of_nonneg (by linarith) (by norm_num))
    (ENNReal.add_ne_top.mpr ⟨hA, hA⟩), ?_⟩
  intro ν hν E hE hcover B hB hcore L hL f hinner houter
  let Fj := fun J (t : E) (x : Euclidean d) =>
    ∑ k ∈ L, (dyadicSpatialShell d (-(k : ℤ) - 1)).indicator
      (fun y => ∑ j ∈ Finset.range (J + 1),
        sphericalAverage d (compactResolutionPiece φ j f) t y) x
  apply maximal_moment_le_of_tendsto ν _ Fj (by linarith)
  · intro J
    apply measurable_disjoint_indicator_maximal_norm L
      (fun k => dyadicSpatialShell d (-(k : ℤ) - 1))
      (fun _ (t : E) y => ∑ j ∈ Finset.range (J + 1),
        sphericalAverage d (compactResolutionPiece φ j f) t y)
      (fun k => measurableSet_dyadicSpatialShell d (-(k : ℤ) - 1))
      (pairwiseDisjoint_negative_dyadicSpatialShell d)
    intro k
    apply LowerSemicontinuous.measurable
    apply lowerSemicontinuous_iSup
    intro t
    apply Continuous.lowerSemicontinuous
    apply Continuous.enorm
    apply continuous_finsetSum
    intro j _
    rw [← schwartzSphericalAverage_apply]
    exact (schwartzSphericalAverage (compactResolutionPiece φ j f) t).continuous
  · intro t x
    apply tendsto_finsetSum L
    intro k _
    by_cases hx : x ∈ dyadicSpatialShell d (-(k : ℤ) - 1)
    · simp only [Set.indicator_of_mem hx]
      exact sphericalAverage_compact_resolution φ f hmass t x
    · simp only [Set.indicator_of_notMem hx]
      exact tendsto_const_nhds
  · intro J
    let H := fun x => ∑ n ∈ Finset.range (J + 1), ⨆ t : E,
      ‖localizedResolutionPiece φ (L.filter (fun k => k + n ≤ J))
        (fun k => k + n) f t x‖ₑ
    let D := fun x => ∑ m ∈ Finset.range (L.sup id + 1), ⨆ t : E,
      ‖localizedResolutionPiece φ (L.filter (fun k => 0 < m ∧ m ≤ k ∧ k - m ≤ J))
        (fun k => k - m) f t x‖ₑ
    have hH : Measurable H := Finset.measurable_sum _ (fun n _ =>
      measurable_localizedResolutionPiece_maximal φ _ _ f E)
    have hpoint (x : Euclidean d) : (⨆ t : E, ‖Fj J t x‖ₑ) ≤ H x + D x := by
      apply iSup_le
      intro t
      dsimp only [Fj]
      rw [localized_resolution_frequency_split]
      apply (enorm_add_le _ _).trans
      apply add_le_add
      · exact (enorm_sum_le _ _).trans (Finset.sum_le_sum (fun n _ =>
          le_iSup (fun t : E => ‖localizedResolutionPiece φ _ _ f t x‖ₑ) t))
      · exact (enorm_sum_le _ _).trans (Finset.sum_le_sum (fun m _ =>
          le_iSup (fun t : E => ‖localizedResolutionPiece φ _ _ f t x‖ₑ) t))
    have hbH := (hb ν hν E hE hcover B hB hcore (Finset.range (J + 1))
      (fun n => L.filter (fun k => k + n ≤ J)) f hinner houter).1
      (fun n _ k hk => hL k (Finset.mem_filter.mp hk).1)
    have hbD := (hb ν hν E hE hcover B hB hcore (Finset.range (L.sup id + 1))
      (fun m => L.filter (fun k => 0 < m ∧ m ≤ k ∧ k - m ≤ J)) f hinner houter).2
      (fun m _ k hk => (Finset.mem_filter.mp hk).2.2.1)
    calc
      _ ≤ ∫⁻ x, (2 : ℝ≥0∞) ^ p * (H x ^ p + D x ^ p) ∂ν := by
        apply lintegral_mono
        intro x
        exact (ENNReal.rpow_le_rpow (hpoint x) (by linarith)).trans
          (ENNReal.add_rpow_le_two_rpow_mul_rpow_add_rpow _ _ (by linarith))
      _ = 2 ^ p * ((∫⁻ x, H x ^ p ∂ν) + ∫⁻ x, D x ^ p ∂ν) := by
        rw [lintegral_const_mul' _ _ (by finiteness), lintegral_add_left (hH.pow_const p)]
      _ ≤ _ := by
        have hh := mul_le_mul' (le_refl ((2 : ℝ≥0∞) ^ p)) (add_le_add hbH hbD)
        simpa only [mul_add, add_mul, mul_assoc] using hh

/-- The negative dyadic shells starting at index four cover the punctured
inner ball used in Section 2. -/
theorem inner_ball_subset_negative_shells {d : ℕ} {x : Euclidean d}
    (hx : ‖x‖ ≤ 1 / 16) (hx₀ : x ≠ 0) :
    x ∈ ⋃ k : ℕ, dyadicSpatialShell d (-((k + 4 : ℕ) : ℤ) - 1) := by
  obtain ⟨j, hj⟩ := exists_mem_Ioc_zpow (norm_pos_iff.mpr hx₀)
    (by norm_num : (1 : ℝ) < 2)
  have hjneg : j ≤ -5 := by
    by_contra hn
    have hh := zpow_le_zpow_right₀ (by norm_num : (1 : ℝ) ≤ 2)
      (show (-4 : ℤ) ≤ j by omega)
    norm_num at hh
    linarith [hj.1]
  let k := (-j - 5).toNat
  have hk : (k : ℤ) = -j - 5 := Int.toNat_of_nonneg (by omega)
  apply Set.mem_iUnion.mpr
  refine ⟨k, ?_⟩
  change (2 : ℝ) ^ (-((k + 4 : ℕ) : ℤ) - 1) < ‖x‖ ∧
    ‖x‖ ≤ (2 : ℝ) ^ ((-((k + 4 : ℕ) : ℤ) - 1) + 1)
  have he : -((k + 4 : ℕ) : ℤ) - 1 = j := by push_cast; omega
  simpa only [he, Set.mem_Ioc] using hj

/-- A uniform bound on finite localized sums controls the entire inner
ball. The origin is null for every dominated endpoint power measure. -/
theorem inner_ball_moment_of_finite_shells {d : ℕ} (hd : 0 < d)
    (ν : Measure (Euclidean d)) (hν : ν ≤ powerWeightedVolume d (1 - (d : ℝ)))
    (E : Set ℝ) (f : SchwartzMap (Euclidean d) ℂ) {p : ℝ} (hp : 0 < p)
    (Q : ℝ≥0∞)
    (hb : ∀ (L : Finset ℕ), (∀ k ∈ L, 4 ≤ k) →
      (∫⁻ x, (⨆ t : E, ‖∑ k ∈ L, (dyadicSpatialShell d (-(k : ℤ) - 1)).indicator
        (sphericalAverage d f t) x‖ₑ) ^ p ∂ν) ≤ Q) :
    (∫⁻ x in Metric.closedBall (0 : Euclidean d) (1 / 16),
      (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p ∂ν) ≤ Q := by
  classical
  let S := fun k : ℕ => dyadicSpatialShell d (-((k + 4 : ℕ) : ℤ) - 1)
  let F := fun x => (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p
  have hfinite (I : Finset ℕ) : (∑ k ∈ I, ∫⁻ x in S k, F x ∂ν) ≤ Q := by
    have hh := hb (I.image (fun k => k + 4)) (by
      intro k hk
      obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hk
      omega)
    rw [disjoint_indicator_maximal_moment ν _
      (fun k : ℕ => dyadicSpatialShell d (-(k : ℤ) - 1))
      (fun _ (t : E) => sphericalAverage d f t)
      (fun k => measurableSet_dyadicSpatialShell d (-(k : ℤ) - 1))
      (pairwiseDisjoint_negative_dyadicSpatialShell d)
      (fun _ => measurable_schwartz_radius_supremum f E) hp] at hh
    rw [Finset.sum_image (fun i _ j _ hij => Nat.add_right_cancel hij)] at hh
    exact hh
  have hsum : (∑' k, ∫⁻ x in S k, F x ∂ν) ≤ Q :=
    ENNReal.summable.tsum_le_of_sum_le hfinite
  have hU : MeasurableSet (⋃ k, S k) := MeasurableSet.iUnion (fun k =>
    measurableSet_dyadicSpatialShell d _)
  have hzero : ν ({0} : Set (Euclidean d)) = 0 := by
    apply le_antisymm _ bot_le
    exact (hν _).trans_eq (powerWeightedVolume_singleton_zero hd (1 - (d : ℝ)))
  have hae : ∀ᵐ x ∂ν, x ≠ (0 : Euclidean d) := by
    simpa only [ae_iff, not_not, Set.ofPred_eq_eq_singleton] using hzero
  calc
    _ = ∫⁻ x, (Metric.closedBall (0 : Euclidean d) (1 / 16)).indicator F x ∂ν :=
      (lintegral_indicator measurableSet_closedBall F).symm
    _ ≤ ∫⁻ x, (⋃ k, S k).indicator F x ∂ν := by
      apply lintegral_mono_ae
      filter_upwards [hae] with x hx₀
      by_cases hx : x ∈ Metric.closedBall (0 : Euclidean d) (1 / 16)
      · have hxs : x ∈ ⋃ k, S k := inner_ball_subset_negative_shells
          (by simpa only [Metric.mem_closedBall, dist_zero_right] using hx) hx₀
        simp only [Set.indicator_of_mem hx, Set.indicator_of_mem hxs]
        exact le_rfl
      · rw [Set.indicator_of_notMem hx]
        exact bot_le
    _ = ∫⁻ x in ⋃ k, S k, F x ∂ν := lintegral_indicator hU F
    _ ≤ ∑' k, ∫⁻ x in S k, F x ∂ν := lintegral_iUnion_le S F
    _ ≤ Q := hsum

/-- The elementary absorption inequality in the conclusion of Section 2. -/
theorem sublinear_bootstrap_bound {B K θ : ℝ} (hB : 0 ≤ B) (hK : 0 ≤ K)
    (hθ : θ < 1) (hb : B ≤ 1 + K * (1 + B ^ θ)) :
    B ≤ max (2 * (1 + K)) ((2 * K) ^ (1 / (1 - θ))) := by
  by_cases hsmall : B ≤ 2 * (1 + K)
  · exact hsmall.trans (le_max_left _ _)
  have hBpos : 0 < B := by linarith
  have hpow : 0 < B ^ θ := Real.rpow_pos_of_pos hBpos _
  have he : B ^ θ * B ^ (1 - θ) = B := by
    rw [← Real.rpow_add hBpos, add_sub_cancel, Real.rpow_one]
  have hbound : B ^ (1 - θ) ≤ 2 * K := by
    apply (mul_le_mul_iff_right₀ hpow).mp
    rw [he]
    nlinarith
  have hs : 0 < 1 - θ := by linarith
  have hh := Real.rpow_le_rpow (Real.rpow_nonneg hB _) hbound (one_div_pos.mpr hs).le
  rw [← Real.rpow_mul hB, mul_one_div_cancel hs.ne', Real.rpow_one] at hh
  exact hh.trans (le_max_right _ _)

/-- Taking the infimum of admissible core constants turns an improvement
estimate into a bound independent of the initially available constant. -/
theorem core_constant_of_sublinear_improvement {d : ℕ}
    (ν : Measure (Euclidean d)) (E : Set ℝ) (p : ℝ) {K θ : ℝ}
    (hK : 0 ≤ K) (hθ : θ < 1)
    (hfinite : ∃ B : ℝ, 0 ≤ B ∧ SchwartzCoreMomentBound ν E p B)
    (himprove : ∀ B : ℝ, 0 < B → SchwartzCoreMomentBound ν E p B →
      SchwartzCoreMomentBound ν E p (K * (1 + B ^ θ))) :
    SchwartzCoreMomentBound ν E p
      (max (2 * (1 + K)) ((2 * K) ^ (1 / (1 - θ)))) := by
  let S : Set ℝ := {B | 0 ≤ B ∧ SchwartzCoreMomentBound ν E p B}
  have hS : S.Nonempty := hfinite
  have hSlower : BddBelow S := ⟨0, fun _ h => h.1⟩
  have hinf : 0 ≤ sInf S := le_csInf hS (fun _ h => h.1)
  let B := sInf S + 1
  have hB : 0 < B := by dsimp only [B]; linarith
  obtain ⟨b, hb, hbB⟩ := exists_lt_of_csInf_lt hS (show sInf S < B by dsimp only [B]; linarith)
  have hcore : SchwartzCoreMomentBound ν E p B := by
    intro f
    exact (hb.2 f).trans (mul_le_mul' (ENNReal.ofReal_le_ofReal hbB.le) le_rfl)
  have hnext := himprove B hB hcore
  have hnextpos : 0 ≤ K * (1 + B ^ θ) := mul_nonneg hK (by positivity)
  have hinext : sInf S ≤ K * (1 + B ^ θ) := csInf_le hSlower ⟨hnextpos, hnext⟩
  have hbound := sublinear_bootstrap_bound hB.le hK hθ
    (show B ≤ 1 + K * (1 + B ^ θ) by dsimp only [B]; linarith)
  intro f
  exact (hcore f).trans (mul_le_mul' (ENNReal.ofReal_le_ofReal hbound) le_rfl)

/-- Pointwise domination controls the weighted input moment of each piece
of the smooth low/middle/high partition. -/
theorem schwartz_moment_le_of_norm_le {d : ℕ} (μ : Measure (Euclidean d))
    (f g : SchwartzMap (Euclidean d) ℂ) {p c : ℝ} (hp : 0 ≤ p) (hc : 0 ≤ c)
    (hfg : ∀ x, ‖g x‖ ≤ c * ‖f x‖) :
    (∫⁻ x, ‖g x‖ₑ ^ p ∂μ) ≤ ENNReal.ofReal c ^ p * ∫⁻ x, ‖f x‖ₑ ^ p ∂μ := by
  rw [← lintegral_const_mul' _ _ (ENNReal.rpow_ne_top_of_nonneg hp ENNReal.ofReal_ne_top)]
  apply lintegral_mono
  intro x
  have hh := ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal (hfg x)) hp
  simpa only [ENNReal.ofReal_mul hc, ofReal_norm, ENNReal.mul_rpow_of_nonneg _ _ hp] using hh

/-- Combining the three source input estimates gives the sublinear
improvement of the scalar core constant. -/
theorem core_improvement_of_split_bounds {d : ℕ} {p : ℝ} (hp : 1 < p)
    (AL AG AH D : ℝ≥0∞) (hAL : AL ≠ ∞) (hAG : AG ≠ ∞) (hAH : AH ≠ ∞) (hD : D ≠ ∞) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ E : Set ℝ,
    (∀ f : SchwartzMap (Euclidean d) ℂ, (∀ y, 1 / 4 < ‖y‖ → f y = 0) →
      (∫⁻ x, (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p
        ∂powerWeightedVolume d (1 - (d : ℝ))) ≤
          AL * ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d (1 - (d : ℝ))) →
    (∀ f : SchwartzMap (Euclidean d) ℂ,
      (∀ y, y ∉ euclideanAnnulus d (1 / 8) 8 → f y = 0) →
      (∫⁻ x in (Metric.closedBall (0 : Euclidean d) (1 / 16))ᶜ,
        (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p
          ∂powerWeightedVolume d (1 - (d : ℝ))) ≤
            AG * ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d (1 - (d : ℝ))) →
    (∀ f : SchwartzMap (Euclidean d) ℂ, (∀ y, ‖y‖ ≤ 4 → f y = 0) →
      (∫⁻ x, (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p
        ∂powerWeightedVolume d (1 - (d : ℝ))) ≤
          AH * ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d (1 - (d : ℝ))) →
    ∀ (ν : Measure (Euclidean d)),
      ν ≤ powerWeightedVolume d (1 - (d : ℝ)) → ∀ B : ℝ, 0 < B →
      (∀ f : SchwartzMap (Euclidean d) ℂ,
        (∀ y, ‖y‖ < 1 / 8 → f y = 0) → (∀ y, 8 < ‖y‖ → f y = 0) →
        (∫⁻ x in Metric.closedBall (0 : Euclidean d) (1 / 16),
          (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p ∂ν) ≤
            D * ENNReal.ofReal B ^ (1 - p / 2) *
              ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d (1 - (d : ℝ))) →
      SchwartzCoreMomentBound ν E p (K * (1 + B ^ (1 - p / 2))) := by
  let c : ℝ≥0∞ := 2 ^ p
  let Z := AL + AG + AH + D
  let K₀ := c * (c * (Z + Z) + Z) * c
  have hc : c ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (by linarith) (by norm_num)
  have hZ : Z ≠ ∞ := by dsimp only [Z]; finiteness
  have hK₀ : K₀ ≠ ∞ := by dsimp only [K₀]; finiteness
  let K := K₀.toReal + 1
  have hK : 0 ≤ K := by dsimp only [K]; positivity
  have hKle : K₀ ≤ ENNReal.ofReal K := by
    rw [← ENNReal.ofReal_toReal hK₀]
    exact ENNReal.ofReal_le_ofReal (by dsimp only [K]; linarith)
  refine ⟨K, hK, ?_⟩
  intro E hL hG hH ν hν B hB hinner f
  obtain ⟨L, G, H, hsplit, hLs, hGs, hHs, hLn, hGn, hHn⟩ := exists_low_middle_high_split f
  let μ := powerWeightedVolume d (1 - (d : ℝ))
  let Q := ∫⁻ x, ‖f x‖ₑ ^ p ∂μ
  let b := ENNReal.ofReal B ^ (1 - p / 2)
  let U := Z * (1 + b) * (c * Q)
  have hinput (g : SchwartzMap (Euclidean d) ℂ) (hg : ∀ y, ‖g y‖ ≤ 2 * ‖f y‖) :
      (∫⁻ x, ‖g x‖ₑ ^ p ∂μ) ≤ c * Q := by
    simpa only [ENNReal.ofReal_ofNat] using schwartz_moment_le_of_norm_le μ f g
      (by linarith : 0 ≤ p) (by norm_num : (0 : ℝ) ≤ 2) hg
  have hALZ : AL ≤ Z := by dsimp only [Z]; exact le_add_right (le_add_right (le_add_right le_rfl))
  have hAGZ : AG ≤ Z := by
    dsimp only [Z]
    exact le_add_right (le_add_right (le_add_left le_rfl))
  have hAHZ : AH ≤ Z := by dsimp only [Z]; exact le_add_right (le_add_left le_rfl)
  have hDZ : D ≤ Z := by dsimp only [Z]; exact le_add_left le_rfl
  have hZb : Z ≤ Z * (1 + b) := by
    simpa only [mul_one] using mul_le_mul' (le_refl Z) (le_add_right (le_refl 1))
  have hlow : (∫⁻ x, (⨆ t : E, ‖sphericalAverage d L t x‖ₑ) ^ p ∂ν) ≤ U :=
    ((lintegral_mono' hν le_rfl).trans (hL L hLs)).trans
      (mul_le_mul' (hALZ.trans hZb) (hinput L hLn))
  have hhigh : (∫⁻ x, (⨆ t : E, ‖sphericalAverage d H t x‖ₑ) ^ p ∂ν) ≤ U :=
    ((lintegral_mono' hν le_rfl).trans (hH H hHs)).trans
      (mul_le_mul' (hAHZ.trans hZb) (hinput H hHn))
  have hGi : ∀ y, ‖y‖ < 1 / 8 → G y = 0 := by
    intro y hy
    apply hGs y
    simpa only [euclideanAnnulus, Set.mem_sdiff, Metric.mem_ball, Metric.mem_closedBall,
      dist_zero_right, not_and, not_not] using (fun _ => hy)
  have hGo : ∀ y, 8 < ‖y‖ → G y = 0 := by
    intro y hy
    apply hGs y
    simp only [euclideanAnnulus, Set.mem_sdiff, Metric.mem_closedBall, dist_zero_right]
    exact fun hh => (not_le.mpr hy) hh.1
  have hmiddle : (∫⁻ x, (⨆ t : E, ‖sphericalAverage d G t x‖ₑ) ^ p ∂ν) ≤ U := by
    rw [← lintegral_add_compl (A := Metric.closedBall (0 : Euclidean d) (1 / 16))
      _ measurableSet_closedBall]
    have hi := (hinner G hGi hGo).trans (mul_le_mul' le_rfl (hinput G hGn))
    have ho := ((lintegral_mono' (Measure.restrict_mono_measure hν _) le_rfl).trans
      (hG G hGs)).trans (mul_le_mul' le_rfl (hinput G hGn))
    apply (add_le_add hi ho).trans
    have he : D * b + AG ≤ Z * (1 + b) := by
      calc
        _ ≤ Z * b + Z := add_le_add (mul_le_mul' hDZ le_rfl) hAGZ
        _ = _ := by ring
    simpa only [U, ← add_mul] using mul_le_mul' he (le_refl (c * Q))
  have hsum := (schwartz_spherical_maximal_moment_add_le (L + G) H E ν
    (by linarith : 0 ≤ p)).trans (mul_le_mul' le_rfl (add_le_add
      ((schwartz_spherical_maximal_moment_add_le L G E ν (by linarith)).trans
        (mul_le_mul' le_rfl (add_le_add hlow hmiddle))) hhigh))
  have htotal : (∫⁻ x, (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p ∂ν) ≤
      K₀ * (1 + b) * Q := by
    rw [hsplit]
    convert hsum using 1
    dsimp only [K₀, U, c]
    ring
  apply htotal.trans
  rw [ENNReal.ofReal_mul hK, ENNReal.ofReal_add (by norm_num : (0 : ℝ) ≤ 1)
      (Real.rpow_nonneg hB.le (1 - p / 2)),
    ENNReal.ofReal_one, ← ENNReal.ofReal_rpow_of_pos hB]
  exact mul_le_mul' (mul_le_mul' hKle le_rfl) le_rfl

/-- Transfer an existing normalized maximal moment estimate to the
surface-measure normalization of the paper. -/
theorem spherical_moment_le_of_normalized {d : ℕ} (hd : 0 < d)
    (E : Set ℝ) (hE : E ⊆ Ioi 0) (f : Euclidean d → ℂ)
    (ν : Measure (Euclidean d)) {p : ℝ} (hp : 0 ≤ p) (Q : ℝ≥0∞)
    (hb : (∫⁻ x, restrictedNormalizedSphericalMaximal d E f x ^ p ∂ν) ≤ Q) :
    (∫⁻ x, (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p ∂ν) ≤
      ‖(surfaceMass d : ℂ)‖ₑ ^ p * Q := by
  calc
    _ ≤ ∫⁻ x, (‖(surfaceMass d : ℂ)‖ₑ *
        restrictedNormalizedSphericalMaximal d E f x) ^ p ∂ν :=
      lintegral_mono (fun x => ENNReal.rpow_le_rpow
        (spherical_supremum_le_surfaceMass_mul_normalized hd E hE f x) hp)
    _ = ‖(surfaceMass d : ℂ)‖ₑ ^ p *
        ∫⁻ x, restrictedNormalizedSphericalMaximal d E f x ^ p ∂ν := by
      simp_rw [ENNReal.mul_rpow_of_nonneg _ _ hp]
      exact lintegral_const_mul' _ _ (by finiteness)
    _ ≤ _ := mul_le_mul' le_rfl hb

/-- The low-input constant is uniform over sets with a common unweighted bound. -/
theorem uniform_low_input_constant {d : ℕ} {p α : ℝ} (hp : 0 < p)
    (hα : α ≤ 0) (C : ℝ) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ E : Set ℝ, E ⊆ Icc (1 : ℝ) 2 →
      UnweightedMaximalBound d E p C → ∀ f : SchwartzMap (Euclidean d) ℂ,
      (∀ y, 1 / 4 < ‖y‖ → f y = 0) →
      (∫⁻ x, restrictedNormalizedSphericalMaximal d E f x ^ p ∂powerWeightedVolume d α) ≤
        A * ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d α := by
  refine ⟨ENNReal.ofReal (1 / 2 : ℝ) ^ α * ENNReal.ofReal C ^ p, ?_, ?_⟩
  · apply ENNReal.mul_ne_top
    · rw [ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 1 / 2)]
      exact ENNReal.ofReal_ne_top
    · exact ENNReal.rpow_ne_top_of_nonneg hp.le ENNReal.ofReal_ne_top
  · intro E hEI hC f hf
    have hnorm := (hC f (f.memLp (ENNReal.ofReal p) volume)).2
    change eLpNorm (_root_.Spherical.restrictedSphericalMaximal E (f : Euclidean d → ℂ))
      (ENNReal.ofReal p) volume ≤ _ at hnorm
    rw [restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal] at hnorm
    simpa only [ofReal_norm] using lowInput_weighted_moment_of_unweighted hEI hp hα f hf
      (ENNReal.ofReal C ^ p) (by
        simpa only [enorm_eq_self, ofReal_norm] using
          lintegral_enorm_rpow_le_of_eLpNorm_le volume hp (ENNReal.ofReal C)
            (restrictedNormalizedSphericalMaximal d E f) (f : Euclidean d → ℂ) hnorm
            (measurable_restrictedNormalizedSphericalMaximal E _ f.continuous).aestronglyMeasurable
            f.continuous.aestronglyMeasurable)

/-- Exterior annular-input constants retain only the common unweighted constant. -/
theorem uniform_middle_input_constant {d : ℕ} {p α r : ℝ} (hp : 0 < p)
    (hα : α ≤ 0) (hr : 0 < r) (C : ℝ) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ E : Set ℝ,
      UnweightedMaximalBound d E p C → ∀ f : SchwartzMap (Euclidean d) ℂ,
      (∀ y, y ∉ euclideanAnnulus d (1 / 8) 8 → f y = 0) →
      (∫⁻ x in (Metric.closedBall (0 : Euclidean d) r)ᶜ,
        restrictedNormalizedSphericalMaximal d E f x ^ p ∂powerWeightedVolume d α) ≤
        A * ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d α := by
  refine ⟨ENNReal.ofReal r ^ α * ENNReal.ofReal C ^ p *
    (ENNReal.ofReal (8 : ℝ) ^ α)⁻¹, ?_, ?_⟩
  · apply ENNReal.mul_ne_top
    · apply ENNReal.mul_ne_top
      · rw [ENNReal.ofReal_rpow_of_pos hr]
        exact ENNReal.ofReal_ne_top
      · exact ENNReal.rpow_ne_top_of_nonneg hp.le ENNReal.ofReal_ne_top
    · rw [ENNReal.inv_ne_top, ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 8)]
      exact ENNReal.ofReal_ne_zero_iff.mpr (Real.rpow_pos_of_pos (by norm_num) _)
  · intro E hC f hf
    have hnorm := (hC f (f.memLp (ENNReal.ofReal p) volume)).2
    change eLpNorm (_root_.Spherical.restrictedSphericalMaximal E (f : Euclidean d → ℂ))
      (ENNReal.ofReal p) volume ≤ _ at hnorm
    rw [restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal] at hnorm
    simpa only [ofReal_norm] using
      restrictedNormalizedSphericalMaximal_exterior_moment_of_unweighted_annular_of_radius
        hp hα (by norm_num : (0 : ℝ) < 1 / 8) (by norm_num : (1 / 8 : ℝ) ≤ 8)
        hr E f hf C hnorm

/-- High-input constants retain only the common unweighted constant. -/
theorem uniform_high_input_constant {d : ℕ} {p α : ℝ} (hp : 0 < p)
    (hα : α ≤ 0) (C : ℝ) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ E : Set ℝ, E ⊆ Icc (1 : ℝ) 2 →
      UnweightedMaximalBound d E p C → ∀ f : SchwartzMap (Euclidean d) ℂ,
      (∀ y, ‖y‖ ≤ 4 → f y = 0) →
      (∫⁻ x, restrictedNormalizedSphericalMaximal d E f x ^ p ∂powerWeightedVolume d α) ≤
        A * ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d α := by
  refine ⟨ENNReal.ofReal ((3 : ℝ) ^ (-α)) * ENNReal.ofReal C ^ p,
    ENNReal.mul_ne_top ENNReal.ofReal_ne_top
      (ENNReal.rpow_ne_top_of_nonneg hp.le ENNReal.ofReal_ne_top), ?_⟩
  intro E hEI hC f hf
  have hh := highInput_bound_of_unweighted hEI hp hα hC f hf
  change (∫⁻ x, (_root_.Spherical.restrictedSphericalMaximal E (f : Euclidean d → ℂ) x) ^ p
    ∂powerWeightedVolume d α) ≤ _ at hh
  rw [restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal] at hh
  simpa only [ofReal_norm] using hh

/-- The improvement constant is uniform in the radius set when the covering
and unweighted constants are uniform. This quantifier order is needed for globalization. -/
theorem uniform_assouad_core_improvement {d : ℕ} (hd : 2 ≤ d)
    {p γ C : ℝ} (hp : 1 < p) (hp₂ : p < 2) (hγ : 0 ≤ γ) (hC : 0 ≤ C)
    (hgap : γ < ((d : ℝ) - 1) * (p - 1)) (U : ℝ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ E : Set ℝ, E ⊆ Icc (1 : ℝ) 2 →
      LocalAssouadCoverBound E γ C → UnweightedMaximalBound d E p U →
      ∀ ν : Measure (Euclidean d), ν ≤ powerWeightedVolume d (1 - (d : ℝ)) →
      ∀ B : ℝ, 0 < B → SchwartzCoreMomentBound ν E p B →
        SchwartzCoreMomentBound ν E p (K * (1 + B ^ (1 - p / 2))) := by
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hα : 1 - (d : ℝ) ≤ 0 := by linarith
  obtain ⟨φ, _, hmass, hφ, _, hflat⟩ := exists_compact_resolution_profile d (d + 1) (by omega)
  have hN : ((d : ℝ) - 1) / 2 ≤ (d + 1 : ℕ) := by push_cast; linarith
  obtain ⟨D, hD, hinner⟩ := localized_resolution_moment_bound hd φ hmass hflat hN
    (fun x hx => hφ x (by linarith)) hp hp₂ hγ hC hgap
  obtain ⟨AL, hAL, hlow⟩ := uniform_low_input_constant (by linarith : 0 < p) hα U
  obtain ⟨AG, hAG, hmid⟩ := uniform_middle_input_constant (by linarith : 0 < p) hα
    (by norm_num : (0 : ℝ) < 1 / 16) U
  obtain ⟨AH, hAH, hhigh⟩ := uniform_high_input_constant (by linarith : 0 < p) hα U
  let M : ℝ≥0∞ := ‖(surfaceMass d : ℂ)‖ₑ ^ p
  have hM : M ≠ ∞ := by dsimp only [M]; finiteness
  obtain ⟨K, hK, hb⟩ := core_improvement_of_split_bounds hp
    (M * AL) (M * AG) (M * AH) D
    (ENNReal.mul_ne_top hM hAL) (ENNReal.mul_ne_top hM hAG)
    (ENNReal.mul_ne_top hM hAH) hD
  refine ⟨K, hK, ?_⟩
  intro E hEI hcovers hU
  have hEpos : E ⊆ Ioi 0 := fun t ht => lt_of_lt_of_le zero_lt_one (hEI ht).1
  have hb' := hb E
    (fun f hf => by
      simpa only [mul_assoc] using spherical_moment_le_of_normalized
        (by omega) E hEpos f _ (by linarith : 0 ≤ p) _ (hlow E hEI hU f hf))
    (fun f hf => by
      simpa only [mul_assoc] using spherical_moment_le_of_normalized
        (by omega) E hEpos f _ (by linarith : 0 ≤ p) _ (hmid E hU f hf))
    (fun f hf => by
      simpa only [mul_assoc] using spherical_moment_le_of_normalized
        (by omega) E hEpos f _ (by linarith : 0 ≤ p) _ (hhigh E hEI hU f hf))
  intro ν hν B hB hcore
  apply hb' ν hν B hB
  intro f hfi hfo
  apply inner_ball_moment_of_finite_shells (by omega) ν hν E f (by linarith)
  intro L hL
  exact hinner ν hν E hEI hcovers B hB hcore L hL f hfi hfo

/-- Finiteness away from the origin needs only an unweighted bound, not a
dimension hypothesis for the individual normalized radius block. -/
theorem truncated_core_bound_of_unweighted {d : ℕ} (hd : 2 ≤ d)
    {p U r : ℝ} (hp : 1 < p) (hr : 0 < r) {E : Set ℝ}
    (hEI : E ⊆ Icc (1 : ℝ) 2) (hU : UnweightedMaximalBound d E p U) :
    ∃ B : ℝ, 0 ≤ B ∧ SchwartzCoreMomentBound
      ((powerWeightedVolume d (1 - (d : ℝ))).restrict
        (Metric.closedBall (0 : Euclidean d) r)ᶜ) E p B := by
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hα : 1 - (d : ℝ) ≤ 0 := by linarith
  have hp0 : 0 < p := by linarith
  obtain ⟨AL, hAL, hlow⟩ := uniform_low_input_constant hp0 hα U
  obtain ⟨AG, hAG, hmid⟩ := uniform_middle_input_constant hp0 hα
    (by norm_num : (0 : ℝ) < 1 / 16) U
  obtain ⟨AH, hAH, hhigh⟩ := uniform_high_input_constant hp0 hα U
  obtain ⟨D, hD, htrunc⟩ := uniform_middle_input_constant hp0 hα hr U
  let M : ℝ≥0∞ := ‖(surfaceMass d : ℂ)‖ₑ ^ p
  have hM : M ≠ ∞ := by dsimp only [M]; finiteness
  have hEpos : E ⊆ Ioi 0 := fun t ht => lt_of_lt_of_le zero_lt_one (hEI ht).1
  obtain ⟨K, hK, hb⟩ := core_improvement_of_split_bounds hp
    (M * AL) (M * AG) (M * AH) (M * D)
    (ENNReal.mul_ne_top hM hAL) (ENNReal.mul_ne_top hM hAG)
    (ENNReal.mul_ne_top hM hAH) (ENNReal.mul_ne_top hM hD)
  refine ⟨K * (1 + 1 ^ (1 - p / 2)), by positivity, ?_⟩
  apply hb E
    (fun f hf => by
      simpa only [mul_assoc] using spherical_moment_le_of_normalized
        (by omega) E hEpos f _ hp0.le _ (hlow E hEI hU f hf))
    (fun f hf => by
      simpa only [mul_assoc] using spherical_moment_le_of_normalized
        (by omega) E hEpos f _ hp0.le _ (hmid E hU f hf))
    (fun f hf => by
      simpa only [mul_assoc] using spherical_moment_le_of_normalized
        (by omega) E hEpos f _ hp0.le _ (hhigh E hEI hU f hf))
    _ Measure.restrict_le_self 1 zero_lt_one
  intro f hfi hfo
  have hf : ∀ y, y ∉ euclideanAnnulus d (1 / 8) 8 → f y = 0 := by
    intro y hy
    by_cases hi : ‖y‖ < 1 / 8
    · exact hfi y hi
    · apply hfo y
      have hh : ¬ (‖y‖ ≤ 8 ∧ 1 / 8 ≤ ‖y‖) := by
        simpa [euclideanAnnulus, Metric.mem_closedBall, Metric.mem_ball, dist_zero_right] using hy
      exact lt_of_not_ge fun ho => hh ⟨ho, le_of_not_gt hi⟩
  have hh := spherical_moment_le_of_normalized (by omega) E hEpos f _ hp0.le _
    (htrunc E hU f hf)
  simp only [ENNReal.ofReal_one, ENNReal.one_rpow, mul_one]
  exact (setLIntegral_le_lintegral _ _).trans (by simpa only [mul_assoc] using hh)

/-- The bootstrap improvement supplied by the source's Assouad hypothesis.
Only the scalar input constant is assumed, and it enters with power below one. -/
theorem assouad_core_improvement {d : ℕ} (hd : 2 ≤ d)
    {E : Set ℝ} (hE : E.Nonempty) (hEI : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 + uniformAssouadDimension E / ((d : ℝ) - 1) < p) (hp₂ : p < 2) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (ν : Measure (Euclidean d)),
      ν ≤ powerWeightedVolume d (1 - (d : ℝ)) → ∀ B : ℝ, 0 < B →
      SchwartzCoreMomentBound ν E p B →
        SchwartzCoreMomentBound ν E p (K * (1 + B ^ (1 - p / 2))) := by
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hdpos : 0 < (d : ℝ) - 1 := by linarith
  have hp₁ : 1 < p := by
    have := div_nonneg (uniformAssouadDimension_nonneg E) hdpos.le
    linarith
  have hgap : uniformAssouadDimension E < ((d : ℝ) - 1) * (p - 1) := by
    have hh := (div_lt_iff₀ hdpos).mp (show uniformAssouadDimension E /
      ((d : ℝ) - 1) < p - 1 by linarith)
    nlinarith
  obtain ⟨γ, hγlo, hγhi⟩ := exists_between hgap
  have hγ : 0 ≤ γ := (uniformAssouadDimension_nonneg E).trans hγlo.le
  obtain ⟨C, hC, hcover⟩ := (hasUniformAssouadExponent_of_dimension_lt hγlo).closedBlock_cover hγ
  have hcovers : LocalAssouadCoverBound E γ C := by
    intro δ a b hδ hδ₁ ha hab hb hs
    obtain ⟨J, hJ, hcard⟩ := hcover 1 (by norm_num) δ a b hδ hδ₁ ha hab hb hs
    refine ⟨J, ?_, hcard⟩
    intro t ht
    apply hJ
    refine ⟨?_, ht.2⟩
    exact ⟨t, ⟨ht.1, by simpa using hEI ht.1⟩, by simp⟩
  obtain ⟨φ, _, hmass, hφ, _, hflat⟩ := exists_compact_resolution_profile d (d + 1) (by omega)
  have hN : ((d : ℝ) - 1) / 2 ≤ (d + 1 : ℕ) := by push_cast; linarith
  obtain ⟨D, hD, hinner⟩ := localized_resolution_moment_bound hd φ hmass hflat hN
    (fun x hx => hφ x (by linarith)) hp₁ hp₂ hγ hC.le hγhi
  have hα : 1 - (d : ℝ) ≤ 0 := by linarith
  obtain ⟨AL, hAL, hlow⟩ := lowInput_bound_of_uniformAssouadDimension hd hE hEI hp hα
  obtain ⟨AG, hAG, hmid⟩ := middleInput_exterior_bound_of_uniformAssouadDimension hd hE hEI hp hα
    (by norm_num : (0 : ℝ) < 1 / 8) (by norm_num : (1 / 8 : ℝ) ≤ 8)
    (by norm_num : (0 : ℝ) < 1 / 16)
  obtain ⟨AH, hAH, hhigh⟩ := highInput_bound_of_uniformAssouadDimension hd hE hEI hp hα
  let M : ℝ≥0∞ := ‖(surfaceMass d : ℂ)‖ₑ ^ p
  have hM : M ≠ ∞ := by dsimp only [M]; finiteness
  have hEpos : E ⊆ Ioi 0 := fun t ht => lt_of_lt_of_le zero_lt_one (hEI ht).1
  obtain ⟨K, hK, hb⟩ := core_improvement_of_split_bounds hp₁
    (M * AL) (M * AG) (M * AH) D
    (ENNReal.mul_ne_top hM hAL) (ENNReal.mul_ne_top hM hAG)
    (ENNReal.mul_ne_top hM hAH) hD
  have hb' := hb E
    (fun f hf => by
      simpa only [mul_assoc, ofReal_norm] using spherical_moment_le_of_normalized
        (by omega) E hEpos f _ (by linarith : 0 ≤ p) _ (hlow f hf))
    (fun f hf => by
      simpa only [mul_assoc, ofReal_norm] using spherical_moment_le_of_normalized
        (by omega) E hEpos f _ (by linarith : 0 ≤ p) _ (hmid f hf))
    (fun f hf => by
      have hh := hhigh f hf
      change (∫⁻ x, (_root_.Spherical.restrictedSphericalMaximal E (f : Euclidean d → ℂ) x) ^ p
        ∂powerWeightedVolume d (1 - (d : ℝ))) ≤ _ at hh
      rw [restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal] at hh
      simpa only [mul_assoc, ofReal_norm] using spherical_moment_le_of_normalized
        (by omega) E hEpos f _ (by linarith : 0 ≤ p) _ hh)
  refine ⟨K, hK, ?_⟩
  intro ν hν B hB hcore
  apply hb' ν hν B hB
  intro f hfi hfo
  apply inner_ball_moment_of_finite_shells (by omega) ν hν E f (by linarith)
  intro L hL
  exact hinner ν hν E hEI hcovers B hB hcore L hL f hfi hfo

/-- Section 2, uniform truncated norm: the initially radius-dependent
Schwartz bound is improved and absorbed, giving one constant for every cutoff. -/
theorem uniform_truncated_core_bound {d : ℕ} (hd : 2 ≤ d)
    {E : Set ℝ} (hE : E.Nonempty) (hEI : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 + uniformAssouadDimension E / ((d : ℝ) - 1) < p) (hp₂ : p < 2) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ r : ℝ, 0 < r →
      SchwartzCoreMomentBound ((powerWeightedVolume d (1 - (d : ℝ))).restrict
        (Metric.closedBall (0 : Euclidean d) r)ᶜ) E p B := by
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hp₁ : 1 < p := by
    have := div_nonneg (uniformAssouadDimension_nonneg E)
      (show 0 ≤ (d : ℝ) - 1 by linarith)
    linarith
  obtain ⟨K, hK, himprove⟩ := assouad_core_improvement hd hE hEI hp hp₂
  refine ⟨max (2 * (1 + K)) ((2 * K) ^ (1 / (1 - (1 - p / 2)))),
    (by positivity), ?_⟩
  intro r hr
  apply core_constant_of_sublinear_improvement _ E p hK (by linarith : 1 - p / 2 < 1)
  · obtain ⟨A, hA, hb⟩ := truncated_bound_of_uniformAssouadDimension hd hE hEI hp
      (by linarith : 1 - (d : ℝ) ≤ 0) hr
    let M : ℝ≥0∞ := ‖(surfaceMass d : ℂ)‖ₑ ^ p * A
    have hM : M ≠ ∞ := by dsimp only [M]; finiteness
    refine ⟨M.toReal, ENNReal.toReal_nonneg, ?_⟩
    intro f
    rw [ENNReal.ofReal_toReal hM]
    simpa only [M, mul_assoc, ofReal_norm] using spherical_moment_le_of_normalized
      (by omega) E (fun t ht => lt_of_lt_of_le zero_lt_one (hEI ht).1) f _
      (by linarith : 0 ≤ p) _ (hb f)
  · exact himprove _ Measure.restrict_le_self

/-- Removing exterior-ball truncations loses only the null origin. -/
theorem lintegral_le_of_exterior_ball_bounds {d : ℕ}
    (ν : Measure (Euclidean d)) (hzero : ν ({0} : Set (Euclidean d)) = 0)
    (F : Euclidean d → ℝ≥0∞) (hF : Measurable F) (Q : ℝ≥0∞)
    (hb : ∀ r : ℝ, 0 < r → (∫⁻ x in (Metric.closedBall (0 : Euclidean d) r)ᶜ, F x ∂ν) ≤ Q) :
    (∫⁻ x, F x ∂ν) ≤ Q := by
  let r : ℕ → ℝ := fun n => 1 / ((n : ℝ) + 1)
  have hr : Tendsto r atTop (𝓝 0) := tendsto_one_div_add_atTop_nhds_zero_nat
  let G := fun n => (Metric.closedBall (0 : Euclidean d) (r n))ᶜ.indicator F
  have hG (n : ℕ) : Measurable (G n) := hF.indicator measurableSet_closedBall.compl
  have hae : ∀ᵐ x ∂ν, x ≠ (0 : Euclidean d) := by
    simpa only [ae_iff, not_not, Set.ofPred_eq_eq_singleton] using hzero
  have hpoint : ∀ᵐ x ∂ν, F x = liminf (fun n => G n x) atTop := by
    filter_upwards [hae] with x hx
    have hevent : ∀ᶠ n in atTop, r n < ‖x‖ := (tendsto_order.mp hr).2 _ (norm_pos_iff.mpr hx)
    have heq : (fun n => G n x) =ᶠ[atTop] fun _ => F x := by
      filter_upwards [hevent] with n hn
      apply Set.indicator_of_mem
      simpa only [Set.mem_compl_iff, Metric.mem_closedBall, dist_zero_right, not_le] using hn
    exact ((tendsto_const_nhds.congr' heq.symm).liminf_eq).symm
  calc
    _ = ∫⁻ x, liminf (fun n => G n x) atTop ∂ν := lintegral_congr_ae hpoint
    _ ≤ liminf (fun n => ∫⁻ x, G n x ∂ν) atTop := lintegral_liminf_le hG
    _ ≤ liminf (fun _n : ℕ => Q) atTop := by
      apply liminf_le_liminf (Eventually.of_forall _)
      intro n
      rw [lintegral_indicator measurableSet_closedBall.compl]
      exact hb (r n) (by dsimp only [r]; positivity)
    _ = Q := liminf_const _

/-- Section 2 with uniform data: a single endpoint core constant works for
every normalized radius set with the prescribed covering and unweighted bounds. -/
theorem uniform_local_assouad_core_bound {d : ℕ} (hd : 2 ≤ d)
    {p γ C : ℝ} (hp : 1 < p) (hp₂ : p < 2) (hγ : 0 ≤ γ) (hC : 0 ≤ C)
    (hgap : γ < ((d : ℝ) - 1) * (p - 1)) (U : ℝ) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ E : Set ℝ, E ⊆ Icc (1 : ℝ) 2 →
      LocalAssouadCoverBound E γ C → UnweightedMaximalBound d E p U →
      SchwartzCoreMomentBound (powerWeightedVolume d (1 - (d : ℝ))) E p B := by
  obtain ⟨K, hK, himprove⟩ := uniform_assouad_core_improvement hd hp hp₂ hγ hC hgap U
  refine ⟨max (2 * (1 + K)) ((2 * K) ^ (1 / (1 - (1 - p / 2)))), by positivity, ?_⟩
  intro E hEI hcovers hU f
  apply lintegral_le_of_exterior_ball_bounds _ (powerWeightedVolume_singleton_zero (by omega) _)
    _ ((measurable_schwartz_radius_supremum f E).pow_const p)
  intro r hr
  have hh := core_constant_of_sublinear_improvement
    ((powerWeightedVolume d (1 - (d : ℝ))).restrict
      (Metric.closedBall (0 : Euclidean d) r)ᶜ) E p hK (by linarith : 1 - p / 2 < 1)
    (truncated_core_bound_of_unweighted hd hp hr hEI hU)
    (himprove E hEI hcovers hU _ Measure.restrict_le_self)
  exact hh f

/-- Section 2, cutoff removal on the Schwartz core for `1<p<2`. -/
theorem local_assouad_schwartz_core_bound {d : ℕ} (hd : 2 ≤ d)
    {E : Set ℝ} (hE : E.Nonempty) (hEI : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 + uniformAssouadDimension E / ((d : ℝ) - 1) < p) (hp₂ : p < 2) :
    ∃ B : ℝ, 0 ≤ B ∧ SchwartzCoreMomentBound (powerWeightedVolume d (1 - (d : ℝ))) E p B := by
  obtain ⟨B, hB, hb⟩ := uniform_truncated_core_bound hd hE hEI hp hp₂
  refine ⟨B, hB, ?_⟩
  intro f
  apply lintegral_le_of_exterior_ball_bounds _ (powerWeightedVolume_singleton_zero (by omega) _)
    _ ((measurable_schwartz_radius_supremum f E).pow_const p)
  intro r hr
  exact hb r hr f

/-- The normalization bridge in the other direction, used to reuse the
existing weighted density and globalization theorems. -/
theorem normalized_maximal_le_spherical_supremum {d : ℕ}
    (E : Set ℝ) (f : Euclidean d → ℂ) (x : Euclidean d) :
    restrictedNormalizedSphericalMaximal d E f x ≤
      ‖((surfaceMass d : ℂ)⁻¹)‖ₑ * (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) := by
  unfold restrictedNormalizedSphericalMaximal
  apply iSup_le
  intro t
  rw [ofReal_norm, normalizedSphericalAverage, enorm_mul]
  exact mul_le_mul' le_rfl (le_iSup (fun t : E => ‖sphericalAverage d f t x‖ₑ)
    ⟨t, t.property.1⟩)

/-- A fixed raw core moment constant gives a fixed normalized norm constant,
uniformly in the radius set. -/
theorem uniform_normalized_bound_of_core {d : ℕ} (hd : 1 ≤ d)
    {p : ℝ} (hp : 1 < p) (B : ℝ) :
    ∃ C : ℝ, 0 < C ∧ ∀ E : Set ℝ,
      SchwartzCoreMomentBound (powerWeightedVolume d (1 - (d : ℝ))) E p B →
      ∀ f : SchwartzMap (Euclidean d) ℂ,
      MemLp (restrictedNormalizedSphericalMaximal d E f) (ENNReal.ofReal p)
        (powerWeightedVolume d (1 - (d : ℝ))) ∧
      eLpNorm (restrictedNormalizedSphericalMaximal d E f) (ENNReal.ofReal p)
        (powerWeightedVolume d (1 - (d : ℝ))) ≤ ENNReal.ofReal C *
      eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p)
        (powerWeightedVolume d (1 - (d : ℝ))) := by
  let μ := powerWeightedVolume d (1 - (d : ℝ))
  let : μ.HasTemperateGrowth := powerWeightedVolume_hasTemperateGrowth hd (by linarith)
  let K : ℝ≥0∞ := ‖((surfaceMass d : ℂ)⁻¹)‖ₑ ^ p * ENNReal.ofReal B
  let L : ℝ≥0∞ := K ^ (1 / p)
  have hK : K ≠ ∞ := by dsimp only [K]; finiteness
  have hL : L ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (by positivity) hK
  have hLC : L ≤ ENNReal.ofReal (1 + L.toReal) := by
    rw [ENNReal.ofReal_add zero_le_one ENNReal.toReal_nonneg,
      ENNReal.ofReal_one, ENNReal.ofReal_toReal hL]
    exact le_add_of_nonneg_left bot_le
  refine ⟨1 + L.toReal, by positivity, ?_⟩
  intro E hb f
  have hp0 : 0 < p := by linarith
  have hm := (measurable_restrictedNormalizedSphericalMaximal E _ f.continuous)
  have hmoment : (∫⁻ x, restrictedNormalizedSphericalMaximal d E f x ^ p ∂μ) ≤
      K * ∫⁻ x, ‖f x‖ₑ ^ p ∂μ := by
    calc
      _ ≤ ∫⁻ x, (‖((surfaceMass d : ℂ)⁻¹)‖ₑ *
          (⨆ t : E, ‖sphericalAverage d f t x‖ₑ)) ^ p ∂μ :=
        lintegral_mono fun x => ENNReal.rpow_le_rpow
          (normalized_maximal_le_spherical_supremum E f x) hp0.le
      _ = ‖((surfaceMass d : ℂ)⁻¹)‖ₑ ^ p *
          ∫⁻ x, (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p ∂μ := by
        simp_rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
        exact lintegral_const_mul' _ _ (by finiteness)
      _ ≤ _ := by simpa only [K, mul_assoc] using
        mul_le_mul' (le_refl (‖((surfaceMass d : ℂ)⁻¹)‖ₑ ^ p)) (hb f)
  have hnorm : eLpNorm (restrictedNormalizedSphericalMaximal d E f) (ENNReal.ofReal p) μ ≤
      ENNReal.ofReal (1 + L.toReal) * eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p) μ := by
    rw [eLpNorm_ennreal_eq_lintegral_rpow μ _ p hp0 hm.aestronglyMeasurable,
      eLpNorm_eq_lintegral_rpow_enorm_toReal (ENNReal.ofReal_ne_zero_iff.mpr hp0)
        ENNReal.ofReal_ne_top f.continuous.aestronglyMeasurable]
    simp only [ENNReal.toReal_ofReal hp0.le]
    exact (ENNReal.rpow_le_rpow hmoment (by positivity)).trans (by
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : 0 ≤ 1 / p)]
      exact mul_le_mul' hLC le_rfl)
  refine ⟨?_, hnorm⟩
  exact hnorm.trans_lt (ENNReal.mul_lt_top ENNReal.ofReal_lt_top (f.memLp _ μ))

/-- The literal spherical core bound implies the repository's normalized
weighted strong-type predicate, without an additional analytic assumption. -/
theorem normalized_strongType_of_core_moment {d : ℕ} (E : Set ℝ) {p B : ℝ}
    (hp : 1 < p)
    (hb : SchwartzCoreMomentBound (powerWeightedVolume d (1 - (d : ℝ))) E p B) :
    HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E p (1 - (d : ℝ)) := by
  let K : ℝ≥0∞ := ‖((surfaceMass d : ℂ)⁻¹)‖ₑ ^ p * ENNReal.ofReal B
  have hK : K ≠ ∞ := by dsimp only [K]; finiteness
  apply hasStrongType_of_moment_bound_globalToLocal E hp.le K hK
  intro f _
  calc
    _ ≤ ∫⁻ x, (‖((surfaceMass d : ℂ)⁻¹)‖ₑ *
        (⨆ t : E, ‖sphericalAverage d f t x‖ₑ)) ^ p ∂powerWeightedVolume d (1 - (d : ℝ)) :=
      lintegral_mono (fun x => ENNReal.rpow_le_rpow
        (normalized_maximal_le_spherical_supremum E f x) (by linarith))
    _ = ‖((surfaceMass d : ℂ)⁻¹)‖ₑ ^ p *
        ∫⁻ x, (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p
          ∂powerWeightedVolume d (1 - (d : ℝ)) := by
      simp_rw [ENNReal.mul_rpow_of_nonneg _ _ (by linarith : 0 ≤ p)]
      exact lintegral_const_mul' _ _ (by finiteness)
    _ ≤ K * ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d (1 - (d : ℝ)) := by
      simpa only [K, mul_assoc] using mul_le_mul' (le_refl (‖((surfaceMass d : ℂ)⁻¹)‖ₑ ^ p))
        (hb f)

/-- Reuse the existing weighted density theorem with all regularity
hypotheses supplied by the valid power-weight range. -/
theorem weighted_bound_of_normalized_strongType {d : ℕ} (hd : 1 ≤ d)
    (E : Set ℝ) {p α : ℝ} (hp : 1 < p) (hα : -(d : ℝ) < α)
    (hb : HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E p α) :
    ∃ C : ℝ, 0 < C ∧ ∀ f : Euclidean d → ℂ,
      MemLp f (ENNReal.ofReal p) (powerWeightedVolume d α) →
      MemLp (_root_.Spherical.M E f) (ENNReal.ofReal p) (powerWeightedVolume d α) ∧
        eLpNorm (_root_.Spherical.M E f) (ENNReal.ofReal p) (powerWeightedVolume d α) ≤
          ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal p) (powerWeightedVolume d α) := by
  obtain ⟨C, hC, hcore⟩ := hb
  let : (powerWeightedVolume d α).HasTemperateGrowth := powerWeightedVolume_hasTemperateGrowth hd hα
  let : IsFiniteMeasureOnCompacts (powerWeightedVolume d α) :=
    powerWeightedVolume_isFiniteMeasureOnCompacts hd hα
  refine ⟨C, hC, ?_⟩
  intro f hf
  apply memLp_restrictedSphericalMaximal_of_memLp_of_schwartz_bound
    (show 1 ≤ ENNReal.ofReal p by simpa using ENNReal.ofReal_le_ofReal hp.le)
    (ENNReal.ofReal_ne_zero_iff.mpr (by linarith : 0 < p)) ENNReal.ofReal_ne_top _ hf
  intro g
  have hh := (hcore g (g.memLp (ENNReal.ofReal p) (powerWeightedVolume d α))).2
  rw [← restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal] at hh
  exact hh

/-- Local Assouad endpoint on the normalized Schwartz core, including
empty radius sets, for the range proved by the Section 2 bootstrap. -/
theorem local_assouad_normalized_strongType_lt_two {d : ℕ} (hd : 2 ≤ d)
    {E : Set ℝ} (hEI : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 + uniformAssouadDimension E / ((d : ℝ) - 1) < p) (hp₂ : p < 2) :
    HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E p (1 - (d : ℝ)) := by
  have hp₁ : 1 < p := by
    have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
    have := div_nonneg (uniformAssouadDimension_nonneg E) (show 0 ≤ (d : ℝ) - 1 by linarith)
    linarith
  rcases E.eq_empty_or_nonempty with rfl | hE
  · exact hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_empty _ _ _
  · obtain ⟨B, _, hb⟩ := local_assouad_schwartz_core_bound hd hE hEI hp hp₂
    exact normalized_strongType_of_core_moment E hp₁ hb

/-- Positive dilation and radius restriction preserve the unweighted
constant, and the existing density theorem preserves it on all inputs. -/
theorem UnweightedMaximalBound.normalized_block {d : ℕ} (hd : 1 ≤ d)
    {E : Set ℝ} {p U R : ℝ} (hp : 1 < p) (hR : 0 < R)
    (hU : UnweightedMaximalBound d E p U) :
    UnweightedMaximalBound d (normalizedRadiusBlock E R) p U := by
  have hp0 : 0 < p := by linarith
  have hdil := restrictedNormalizedSphericalMaximal_dilateRadiusSet_bound
    (E := E) (α := 0) (C := U) hd hp0 (inv_pos.mpr hR) (by
      intro f hf
      have hh := hU f (by simpa only [powerWeightedVolume_zero] using hf)
      change MemLp (_root_.Spherical.restrictedSphericalMaximal E (f : Euclidean d → ℂ))
        (ENNReal.ofReal p) volume ∧
        eLpNorm (_root_.Spherical.restrictedSphericalMaximal E (f : Euclidean d → ℂ))
          (ENNReal.ofReal p) volume ≤ _ at hh
      rw [restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal] at hh
      simpa only [powerWeightedVolume_zero] using hh)
  intro f hf
  apply memLp_restrictedSphericalMaximal_of_memLp_of_schwartz_bound
    (show 1 ≤ ENNReal.ofReal p by simpa using ENNReal.ofReal_le_ofReal hp.le)
    (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top _ hf
  intro g
  have hgbound := (hdil g (by
    simpa only [powerWeightedVolume_zero] using g.memLp (ENNReal.ofReal p) volume)).2
  simp only [powerWeightedVolume_zero] at hgbound
  change eLpNorm (_root_.Spherical.restrictedSphericalMaximal (normalizedRadiusBlock E R)
    (g : Euclidean d → ℂ)) (ENNReal.ofReal p) volume ≤ _
  rw [restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal]
  apply (eLpNorm_mono_enorm
    (measurable_restrictedNormalizedSphericalMaximal (normalizedRadiusBlock E R)
      _ g.continuous).aestronglyMeasurable (fun x => ?_)).trans hgbound
  simpa only [enorm_eq_self] using restrictedNormalizedSphericalMaximal_mono
    (normalizedRadiusBlock_subset_dilateRadiusSet E) (g : Euclidean d → ℂ) x

/-- Section 2, the bounded extension for a normalized radius set in the
range `1<p<2`. This concerns the actual maximal operator on all weighted
`L^p` inputs, not only its Schwartz core. -/
theorem local_assouad_weighted_bound_lt_two {d : ℕ} (hd : 2 ≤ d)
    {E : Set ℝ} (hEI : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 + uniformAssouadDimension E / ((d : ℝ) - 1) < p) (hp₂ : p < 2) :
    ∃ C : ℝ, 0 < C ∧ ∀ f : Euclidean d → ℂ,
      MemLp f (ENNReal.ofReal p) (powerWeightedVolume d (1 - (d : ℝ))) →
      MemLp (_root_.Spherical.M E f) (ENNReal.ofReal p) (powerWeightedVolume d (1 - (d : ℝ))) ∧
        eLpNorm (_root_.Spherical.M E f) (ENNReal.ofReal p)
          (powerWeightedVolume d (1 - (d : ℝ))) ≤
            ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal p)
              (powerWeightedVolume d (1 - (d : ℝ))) := by
  have hp₁ : 1 < p := by
    have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
    have := div_nonneg (uniformAssouadDimension_nonneg E) (show 0 ≤ (d : ℝ) - 1 by linarith)
    linarith
  exact weighted_bound_of_normalized_strongType (by omega) E hp₁ (by linarith)
    (local_assouad_normalized_strongType_lt_two hd hEI hp hp₂)

/-- The introduction's Assouad endpoint, in the range `1<p<2`, for an
arbitrary positive radius set. The local constants are uniform over all blocks. -/
theorem global_assouad_normalized_strongType_lt_two {d : ℕ} (hd : 2 ≤ d)
    {E : Set ℝ} (hEpos : E ⊆ Ioi (0 : ℝ)) {p : ℝ}
    (hp : 1 + uniformAssouadDimension E / ((d : ℝ) - 1) < p) (hp₂ : p < 2) :
    HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E p (1 - (d : ℝ)) := by
  rcases E.eq_empty_or_nonempty with rfl | hE
  · exact hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_empty _ _ _
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hdpos : 0 < (d : ℝ) - 1 := by linarith
  have hp₁ : 1 < p := by
    have := div_nonneg (uniformAssouadDimension_nonneg E) hdpos.le
    linarith
  have hgap : uniformAssouadDimension E < ((d : ℝ) - 1) * (p - 1) := by
    have hh := (div_lt_iff₀ hdpos).mp (show uniformAssouadDimension E /
      ((d : ℝ) - 1) < p - 1 by linarith)
    nlinarith
  obtain ⟨γ, hγlo, hγhi⟩ := exists_between hgap
  have hγ : 0 ≤ γ := (uniformAssouadDimension_nonneg E).trans hγlo.le
  obtain ⟨C, hC, hcover⟩ := (hasUniformAssouadExponent_of_dimension_lt hγlo).closedBlock_cover hγ
  obtain ⟨U, hU⟩ := unweighted_bound_of_uniformAssouadDimension hd hE hEpos hp
  obtain ⟨B, _, hb⟩ := uniform_local_assouad_core_bound hd hp₁ hp₂ hγ hC.le hγhi U
  obtain ⟨V, _, hv⟩ := uniform_normalized_bound_of_core (d := d) (by omega) hp₁ B
  have hunweighted : HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E p 0 := by
    refine ⟨|U| + 1, by positivity, ?_⟩
    intro f hf
    have hh := hU f (by simpa only [powerWeightedVolume_zero] using hf)
    change MemLp (_root_.Spherical.restrictedSphericalMaximal E (f : Euclidean d → ℂ))
      (ENNReal.ofReal p) volume ∧
      eLpNorm (_root_.Spherical.restrictedSphericalMaximal E (f : Euclidean d → ℂ))
        (ENNReal.ofReal p) volume ≤ _ at hh
    rw [restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal] at hh
    simp only [powerWeightedVolume_zero]
    refine ⟨hh.1, hh.2.trans (mul_le_mul' ?_ le_rfl)⟩
    exact ENNReal.ofReal_le_ofReal (by linarith [le_abs_self U])
  apply hasRestrNormdSphMaxPowerWeightStrongType_of_unif_normd_local_and_unweighted
    (C := V) (by omega) E hp₁.le (by linarith) hunweighted
  intro R hR f _
  apply hv _ (hb _ (normalizedRadiusBlock_subset_Icc_one_two hR)
    (hcover R hR) (UnweightedMaximalBound.normalized_block (by omega) hp₁ hR hU)) f

/-- The same global endpoint estimate for every weighted `L^p` input,
with no compactness or Schwartz restriction, in the range `1<p<2`. -/
theorem global_assouad_weighted_bound_lt_two {d : ℕ} (hd : 2 ≤ d)
    {E : Set ℝ} (hEpos : E ⊆ Ioi (0 : ℝ)) {p : ℝ}
    (hp : 1 + uniformAssouadDimension E / ((d : ℝ) - 1) < p) (hp₂ : p < 2) :
    ∃ C : ℝ, 0 < C ∧ ∀ f : Euclidean d → ℂ,
      MemLp f (ENNReal.ofReal p) (powerWeightedVolume d (1 - (d : ℝ))) →
        MemLp (_root_.Spherical.M E f) (ENNReal.ofReal p)
          (powerWeightedVolume d (1 - (d : ℝ))) ∧
        eLpNorm (_root_.Spherical.M E f) (ENNReal.ofReal p)
          (powerWeightedVolume d (1 - (d : ℝ))) ≤ ENNReal.ofReal C *
        eLpNorm f (ENNReal.ofReal p) (powerWeightedVolume d (1 - (d : ℝ))) := by
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hp₁ : 1 < p := by
    have := div_nonneg (uniformAssouadDimension_nonneg E) (show 0 ≤ (d : ℝ) - 1 by linarith)
    linarith
  exact weighted_bound_of_normalized_strongType (by omega) E hp₁ (by linarith)
    (global_assouad_normalized_strongType_lt_two hd hEpos hp hp₂)

/-- Exponent raising gives the Assouad endpoint for every admissible `p`
whenever the Assouad threshold is strictly below two. -/
theorem global_assouad_normalized_strongType_of_dimension_lt {d : ℕ} (hd : 2 ≤ d)
    {E : Set ℝ} (hEpos : E ⊆ Ioi (0 : ℝ)) {p : ℝ}
    (hdim : uniformAssouadDimension E < (d : ℝ) - 1)
    (hp : 1 + uniformAssouadDimension E / ((d : ℝ) - 1) < p) :
    HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E p (1 - (d : ℝ)) := by
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hdpos : 0 < (d : ℝ) - 1 := by linarith
  have hthreshold : 1 + uniformAssouadDimension E / ((d : ℝ) - 1) < 2 := by
    have hh := (div_lt_one hdpos).mpr hdim
    linarith
  obtain ⟨q, hqlo, hqhi⟩ := exists_between (lt_min hthreshold hp)
  have hq : 1 < q := by
    have := div_nonneg (uniformAssouadDimension_nonneg E) hdpos.le
    linarith
  exact hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_of_strong_type_lt_integrable
    (by omega) (by linarith) hq (lt_of_lt_of_le hqhi (min_le_right _ _))
    (global_assouad_normalized_strongType_lt_two hd hEpos hqlo
      (lt_of_lt_of_le hqhi (min_le_left _ _)))

/-- The all-input form of the endpoint after exponent raising. -/
theorem global_assouad_weighted_bound_of_dimension_lt {d : ℕ} (hd : 2 ≤ d)
    {E : Set ℝ} (hEpos : E ⊆ Ioi (0 : ℝ)) {p : ℝ}
    (hdim : uniformAssouadDimension E < (d : ℝ) - 1)
    (hp : 1 + uniformAssouadDimension E / ((d : ℝ) - 1) < p) :
    ∃ C : ℝ, 0 < C ∧ ∀ f : Euclidean d → ℂ,
      MemLp f (ENNReal.ofReal p) (powerWeightedVolume d (1 - (d : ℝ))) →
        MemLp (_root_.Spherical.M E f) (ENNReal.ofReal p)
          (powerWeightedVolume d (1 - (d : ℝ))) ∧
        eLpNorm (_root_.Spherical.M E f) (ENNReal.ofReal p)
          (powerWeightedVolume d (1 - (d : ℝ))) ≤ ENNReal.ofReal C *
        eLpNorm f (ENNReal.ofReal p) (powerWeightedVolume d (1 - (d : ℝ))) := by
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hp₁ : 1 < p := by
    have := div_nonneg (uniformAssouadDimension_nonneg E) (show 0 ≤ (d : ℝ) - 1 by linarith)
    linarith
  exact weighted_bound_of_normalized_strongType (by omega) E hp₁ (by linarith)
    (global_assouad_normalized_strongType_of_dimension_lt hd hEpos hdim hp)

/-- In dimensions at least three the Assouad dimension is always below
`d-1`, so exponent raising covers the full range in `thm:newfullga`. -/
theorem global_assouad_weighted_bound_three_le {d : ℕ} (hd : 3 ≤ d)
    {E : Set ℝ} (hEpos : E ⊆ Ioi (0 : ℝ)) {p : ℝ}
    (hp : 1 + uniformAssouadDimension E / ((d : ℝ) - 1) < p) :
    ∃ C : ℝ, 0 < C ∧ ∀ f : Euclidean d → ℂ,
      MemLp f (ENNReal.ofReal p) (powerWeightedVolume d (1 - (d : ℝ))) →
        MemLp (_root_.Spherical.M E f) (ENNReal.ofReal p)
          (powerWeightedVolume d (1 - (d : ℝ))) ∧
        eLpNorm (_root_.Spherical.M E f) (ENNReal.ofReal p)
          (powerWeightedVolume d (1 - (d : ℝ))) ≤ ENNReal.ofReal C *
        eLpNorm f (ENNReal.ofReal p) (powerWeightedVolume d (1 - (d : ℝ))) := by
  apply global_assouad_weighted_bound_of_dimension_lt (by omega) hEpos _ hp
  have hd' : (3 : ℝ) ≤ d := by exact_mod_cast hd
  linarith [uniformAssouadDimension_le_one E]



/-! The independent repair, Section 7: square-function summation for p >= 2. -/

theorem finite_lp_power_le_square_power {ι : Type*}
    (I : Finset ι) (a : ι → Real) (ha : ∀ i ∈ I, 0 ≤ a i)
    {p : Real} (hp : 2 ≤ p) :
    (∑ i ∈ I, (a i)^p) ≤ (Real.sqrt (∑ i ∈ I, (a i)^2))^p := by
  let A : Real := ∑ i ∈ I, (a i)^2
  have hA : 0 ≤ A := Finset.sum_nonneg (fun i hi => sq_nonneg (a i))
  have hs : Real.sqrt A ^ 2 = A := Real.sq_sqrt hA
  have hsingle (i : ι) (hi : i ∈ I) : a i ≤ Real.sqrt A :=
    (Real.le_sqrt (ha i hi) hA).mpr
      (Finset.single_le_sum (fun j hj => sq_nonneg (a j)) hi)
  calc
    _ = ∑ i ∈ I, (a i)^2*(a i)^(p-2) := by
      apply Finset.sum_congr rfl
      intro i hi
      have he : p = (2:Real)+(p-2) := by ring
      conv_lhs => rw [he, Real.rpow_add_of_nonneg (ha i hi)
        (by norm_num : (0:Real) ≤ 2) (by linarith : 0 ≤ p-2),Real.rpow_two]
    _ ≤ ∑ i ∈ I, (a i)^2*(Real.sqrt A)^(p-2) :=
      Finset.sum_le_sum (fun i hi => mul_le_mul_of_nonneg_left
        (Real.rpow_le_rpow (ha i hi) (hsingle i hi) (by linarith)) (sq_nonneg _))
    _ = A*(Real.sqrt A)^(p-2) := (Finset.sum_mul _ _ _).symm
    _ = (Real.sqrt A)^p := by
      calc
        A*(Real.sqrt A)^(p-2) = (Real.sqrt A)^2*(Real.sqrt A)^(p-2) := by rw [hs]
        _ = (Real.sqrt A)^p := by
          rw [← Real.rpow_two, ← Real.rpow_add_of_nonneg (Real.sqrt_nonneg A)
            (by norm_num : (0:Real) ≤ 2) (by linarith : 0 ≤ p-2)]
          congr 1
          ring

theorem schwartz_sum_moments_le_square_moment {d : Nat} {ι : Type*}
    (I : Finset ι) (f : ι → SchwartzMap (Euclidean d) Complex)
    (μ : Measure (Euclidean d)) {p : Real} (hp : 2 ≤ p) :
    (∑ i ∈ I, ∫⁻ x, ‖f i x‖ₑ^p ∂μ) ≤
      ∫⁻ x, ENNReal.ofReal (schwartzSquareEnvelope I f x)^p ∂μ := by
  rw [← lintegral_finsetSum I (fun i hi => (f i).continuous.measurable.enorm.pow_const p)]
  apply lintegral_mono
  intro x
  have hh := ENNReal.ofReal_le_ofReal
    (finite_lp_power_le_square_power I (fun i => ‖f i x‖)
      (fun i hi => norm_nonneg _) hp)
  simpa only [ENNReal.ofReal_sum_of_nonneg (fun i hi =>
      Real.rpow_nonneg (norm_nonneg _) _),
    ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by linarith : 0 ≤ p),
    ← ENNReal.ofReal_rpow_of_nonneg (Real.sqrt_nonneg _) (by linarith : 0 ≤ p),
    ofReal_norm,schwartzSquareEnvelope] using hh

theorem compactAnalysis_annular_sum_moment_bound {d : Nat} (hd : 0 < d)
    (φ : SchwartzMap (Euclidean d) Complex) {p : Real} (hp : 2 ≤ p) :
    ∃ A : ENNReal, A ≠ ⊤ ∧ ∀ (I : Finset Nat) (ρ : Nat → Nat),
      Set.InjOn ρ (↑I : Set Nat) → ∀ f : SchwartzMap (Euclidean d) Complex,
      (∀ x, ‖x‖ < 1/8 → f x = 0) → (∀ x, 8 < ‖x‖ → f x = 0) →
      (∑ i ∈ I, ∫⁻ x, ‖compactConvolution (compactAnalysisKernel φ (ρ i)) f x‖ₑ^p) ≤
        A * ∫⁻ x, ‖f x‖ₑ^p ∂powerWeightedVolume d (1-(d:Real)) := by
  obtain ⟨A,hA,hEst⟩ := compactAnalysis_annular_square_moment_bound hd φ
    (by linarith : 1 < p)
  refine ⟨A,hA,?_⟩
  intro I ρ hρ f hfi hfo
  exact (schwartz_sum_moments_le_square_moment I _ volume hp).trans
    (hEst I ρ hρ f hfi hfo)


/-- For p at least two, disjoint output-shell summation consumes a scalar
shell estimate using the ordinary input Littlewood--Paley square function.
There is no vector-valued bootstrap constant in this implication. -/
theorem resolution_piece_moment_of_scalar_shells_ge_two {d : Nat} (hd : 0 < d)
    (φ : SchwartzMap (Euclidean d) Complex) {p : Real} (hp : 2 ≤ p) :
    ∃ A : ENNReal, A ≠ ⊤ ∧
      ∀ (ν : Measure (Euclidean d)) (E : Set Real)
      (L : Finset Nat) (ρ : Nat → Nat), Set.InjOn ρ (↑L : Set Nat) →
      ∀ f : SchwartzMap (Euclidean d) Complex,
      (∀ x, ‖x‖ < 1/8 → f x = 0) → (∀ x, 8 < ‖x‖ → f x = 0) →
      ∀ a : ENNReal,
      (∀ k ∈ L, ∀ g : SchwartzMap (Euclidean d) Complex,
        (∫⁻ x in dyadicSpatialShell d (-(k:Int)-1),
          (⨆ t : E, ‖sphericalAverage d
            (compactConvolution (compactSynthesisKernel φ (ρ k)) g) t x‖ₑ)^p ∂ν) ≤
          a * ∫⁻ y, ‖g y‖ₑ^p) →
      (∫⁻ x, (⨆ t : E, ‖localizedResolutionPiece φ L ρ f t x‖ₑ)^p ∂ν) ≤
        a * A * ∫⁻ x, ‖f x‖ₑ^p ∂powerWeightedVolume d (1-(d:Real)) := by
  obtain ⟨A,hA,hEst⟩ := compactAnalysis_annular_sum_moment_bound hd φ hp
  refine ⟨A,hA,?_⟩
  intro ν E L ρ hρ f hfi hfo a hscalar
  simp only [localizedResolutionPiece]
  rw [disjoint_indicator_maximal_moment ν L
    (fun k : Nat => dyadicSpatialShell d (-(k:Int)-1))
    (fun k (t : E) => sphericalAverage d (compactResolutionPiece φ (ρ k) f) t)
    (fun k => measurableSet_dyadicSpatialShell d _)
    (pairwiseDisjoint_negative_dyadicSpatialShell d)
    (fun k => measurable_schwartz_radius_supremum (compactResolutionPiece φ (ρ k) f) E)
    (by linarith : 0 < p)]
  calc
    _ ≤ ∑ k ∈ L, a * ∫⁻ y,
        ‖compactConvolution (compactAnalysisKernel φ (ρ k)) f y‖ₑ^p :=
      Finset.sum_le_sum (fun k hk => hscalar k hk _)
    _ = a * (∑ k ∈ L, ∫⁻ y,
        ‖compactConvolution (compactAnalysisKernel φ (ρ k)) f y‖ₑ^p) :=
      (Finset.mul_sum _ _ _).symm
    _ ≤ a * (A * ∫⁻ x, ‖f x‖ₑ^p ∂powerWeightedVolume d (1-(d:Real))) :=
      mul_le_mul_right (hEst L ρ hρ f hfi hfo) _
    _ = _ := by ring

theorem dyadic_synthesis_low_ratio {k m : Nat} (hm : m ≤ k) :
    ENNReal.ofReal ((2:Real)^(k-m)) * (ENNReal.ofReal ((2:Real)^k))⁻¹ =
      (2:ENNReal)^(-(m:Real)) := by
  have hr : (2:Real)^(k-m) * ((2:Real)^k)⁻¹ = ((2:Real)^m)⁻¹ := by
    have he : k = (k-m)+m := (Nat.sub_add_cancel hm).symm
    nth_rw 2 [he]
    rw [pow_add,mul_inv]
    field_simp
  rw [← ENNReal.ofReal_inv_of_pos (by positivity : 0 < (2:Real)^k),
    ← ENNReal.ofReal_mul (by positivity : 0 ≤ (2:Real)^(k-m)),hr,
    ENNReal.ofReal_inv_of_pos (by positivity : 0 < (2:Real)^m),
    ENNReal.ofReal_pow (by norm_num : (0:Real) ≤ 2)]
  norm_num only [ENNReal.ofReal_ofNat]
  rw [ENNReal.rpow_neg,ENNReal.rpow_natCast]

/-- Repair Section 7, (27)--(28): for p at least two the low-frequency
resolution sum uses disjoint shells and the ordinary input square function. -/
theorem low_resolution_piece_moment_bound_ge_two {d : Nat} (hd : 0 < d)
    (φ : SchwartzMap (Euclidean d) Complex) {p : Real} (hp : 2 ≤ p) :
    ∃ A : ENNReal, A ≠ ⊤ ∧
      ∀ (ν : Measure (Euclidean d)), ν ≤ powerWeightedVolume d (1-(d:Real)) →
      ∀ E : Set Real, E ⊆ Icc 1 2 →
      ∀ (L : Finset Nat) (m : Nat), (∀ k ∈ L, m ≤ k) →
      ∀ f : SchwartzMap (Euclidean d) Complex,
      (∀ x, ‖x‖ < 1/8 → f x = 0) → (∀ x, 8 < ‖x‖ → f x = 0) →
      (∫⁻ x, (⨆ t : E, ‖localizedResolutionPiece φ L (fun k => k-m) f t x‖ₑ)^p ∂ν) ≤
        (2:ENNReal)^(-(m:Real)) * A *
          ∫⁻ x, ‖f x‖ₑ^p ∂powerWeightedVolume d (1-(d:Real)) := by
  obtain ⟨D,hD,hLow⟩ := synthesis_low_frequency_bound hd φ (by linarith : 1 ≤ p)
  obtain ⟨A,hA,hPiece⟩ := resolution_piece_moment_of_scalar_shells_ge_two hd φ hp
  let M : ENNReal := ‖(surfaceMass d : Complex)‖ₑ^p
  have hM : M ≠ ⊤ := by dsimp [M]; finiteness
  refine ⟨M*D*A,by finiteness,?_⟩
  intro ν hν E hE L m hLm f hfi hfo
  have hρ : Set.InjOn (fun k : Nat => k-m) (↑L : Set Nat) := by
    intro i hi j hj hij
    have hi' := hLm i hi
    have hj' := hLm j hj
    dsimp at hij
    omega
  have hscalar (k : Nat) (hk : k ∈ L) (g : SchwartzMap (Euclidean d) Complex) :
      (∫⁻ x in dyadicSpatialShell d (-(k:Int)-1),
        (⨆ t : E, ‖sphericalAverage d
          (compactConvolution (compactSynthesisKernel φ (k-m)) g) t x‖ₑ)^p ∂ν) ≤
        (M*D*(2:ENNReal)^(-(m:Real))) * ∫⁻ x, ‖g x‖ₑ^p := by
    let G := compactConvolution (compactSynthesisKernel φ (k-m)) g
    let B := Metric.closedBall (0 : Euclidean d) (((2:Real)^k)⁻¹)
    have hnorm := hLow (k-m) k (g : Euclidean d → Complex) g.continuous
    rw [smoothInput_eq_compactConvolution] at hnorm
    have hraw := spherical_moment_le_of_normalized hd (Icc (1:Real) 2)
      (fun t ht => lt_of_lt_of_le zero_lt_one ht.1) (G : Euclidean d → Complex)
      ((powerWeightedVolume d (1-(d:Real))).restrict B) (by linarith : 0 ≤ p) _ hnorm
    have hsub : dyadicSpatialShell d (-(k:Int)-1) ⊆ B :=
      (negative_dyadicSpatialShell_subset_annulus d k).trans (fun x hx => hx.1)
    calc
      _ ≤ ∫⁻ x in dyadicSpatialShell d (-(k:Int)-1),
          (⨆ t : E, ‖sphericalAverage d G t x‖ₑ)^p
          ∂powerWeightedVolume d (1-(d:Real)) :=
        lintegral_mono' (Measure.restrict_mono_measure hν _) le_rfl
      _ ≤ ∫⁻ x in B, (⨆ t : Icc (1:Real) 2, ‖sphericalAverage d G t x‖ₑ)^p
          ∂powerWeightedVolume d (1-(d:Real)) := by
        apply (lintegral_mono (fun x => ENNReal.rpow_le_rpow
          (iSup_le (fun (t : E) => le_iSup (fun s : Icc (1:Real) 2 =>
            ‖sphericalAverage d G s x‖ₑ) ⟨t.1,hE t.2⟩)) (by linarith))).trans
        exact lintegral_mono_set hsub
      _ ≤ _ := hraw.trans_eq (by
        rw [mul_assoc D,dyadic_synthesis_low_ratio (hLm k hk)]
        dsimp [M]
        ring)
  have hh := hPiece ν E L (fun k => k-m) hρ f hfi hfo
    (M*D*(2:ENNReal)^(-(m:Real))) hscalar
  exact hh.trans_eq (by ring)

theorem dyadic_moment_decay_as_norm_decay {p : Real} (hp : 0 < p) (m : Nat) :
    (2:ENNReal)^(-(m:Real)) = (((2:ENNReal)^(-1/p))^m)^p := by
  rw [← ENNReal.rpow_natCast]
  simp only [← ENNReal.rpow_mul]
  congr 1
  field_simp
/-- Section 7 of the repair: any genuine summable high-shell gain combines
with the unconditional low-frequency estimate. -/
theorem resolution_frequency_sums_moment_bound_ge_two {d : Nat} (hd : 0 < d)
    (φ : SchwartzMap (Euclidean d) Complex) {p : Real} (hp : 2 ≤ p)
    (k₀ : Nat) (r H : ENNReal) (hr : r < 1) (hH : H ≠ ⊤)
    (hHigh : ∀ (ν : Measure (Euclidean d)), ν ≤ powerWeightedVolume d (1 - (d : Real)) →
      ∀ (E : Set Real), E ⊆ Icc 1 2 →
      ∀ (L : Finset Nat), (∀ k ∈ L, k₀ ≤ k) → ∀ n : Nat,
      ∀ f : SchwartzMap (Euclidean d) Complex,
      (∀ x, ‖x‖ < 1/8 → f x = 0) → (∀ x, 8 < ‖x‖ → f x = 0) →
      (∫⁻ x, (⨆ t : E, ‖localizedResolutionPiece φ L (fun k => k+n) f t x‖ₑ)^p ∂ν) ≤
        (r^n)^p * (H * ∫⁻ x, ‖f x‖ₑ^p ∂powerWeightedVolume d (1-(d:Real)))) :
    ∃ A : ENNReal, A ≠ ⊤ ∧
      ∀ (ν : Measure (Euclidean d)), ν ≤ powerWeightedVolume d (1-(d:Real)) →
      ∀ (E : Set Real), E ⊆ Icc 1 2 →
      ∀ (I : Finset Nat) (L : Nat → Finset Nat) (f : SchwartzMap (Euclidean d) Complex),
      (∀ x, ‖x‖ < 1/8 → f x = 0) → (∀ x, 8 < ‖x‖ → f x = 0) →
      ((∀ n ∈ I, ∀ k ∈ L n, k₀ ≤ k) →
        (∫⁻ x, (∑ n ∈ I, ⨆ t : E,
          ‖localizedResolutionPiece φ (L n) (fun k => k+n) f t x‖ₑ)^p ∂ν) ≤
            A * ∫⁻ x, ‖f x‖ₑ^p ∂powerWeightedVolume d (1-(d:Real))) ∧
      ((∀ m ∈ I, ∀ k ∈ L m, m ≤ k) →
        (∫⁻ x, (∑ m ∈ I, ⨆ t : E,
          ‖localizedResolutionPiece φ (L m) (fun k => k-m) f t x‖ₑ)^p ∂ν) ≤
            A * ∫⁻ x, ‖f x‖ₑ^p ∂powerWeightedVolume d (1-(d:Real))) := by
  obtain ⟨D,hD,hLow⟩ := low_resolution_piece_moment_bound_ge_two hd φ hp
  let s : ENNReal := 2^(-1/p)
  have hs : s < 1 := ENNReal.rpow_lt_one_of_one_lt_of_neg (by norm_num)
    (div_neg_of_neg_of_pos (by norm_num) (by linarith))
  have hR : ((1-r)⁻¹)^p ≠ ⊤ :=
    ENNReal.rpow_ne_top_of_nonneg (by linarith)
      (ENNReal.inv_ne_top.mpr (tsub_pos_iff_lt.mpr hr).ne')
  have hS : ((1-s)⁻¹)^p ≠ ⊤ :=
    ENNReal.rpow_ne_top_of_nonneg (by linarith)
      (ENNReal.inv_ne_top.mpr (tsub_pos_iff_lt.mpr hs).ne')
  refine ⟨((1-r)⁻¹)^p*H+((1-s)⁻¹)^p*D,by finiteness,?_⟩
  intro ν hν E hE I L f hfi hfo
  constructor
  · intro hL
    have hh := finite_geometric_sum_moment_bound ν I
      (fun n x => ⨆ t : E, ‖localizedResolutionPiece φ (L n) (fun k => k+n) f t x‖ₑ)
      (fun n _ => measurable_localizedResolutionPiece_maximal φ (L n) _ f E)
      (by linarith : 1 ≤ p) r
      (H*∫⁻ x, ‖f x‖ₑ^p ∂powerWeightedVolume d (1-(d:Real)))
      (fun n hn => hHigh ν hν E hE (L n) (hL n hn) n f hfi hfo)
    apply hh.trans
    simpa only [mul_assoc] using mul_le_mul'
      (le_add_right (le_refl (((1-r)⁻¹)^p*H))) le_rfl
  · intro hL
    have hb (m : Nat) (hm : m ∈ I) :
        (∫⁻ x, (⨆ t : E,
          ‖localizedResolutionPiece φ (L m) (fun k => k-m) f t x‖ₑ)^p ∂ν) ≤
          (s^m)^p*(D*∫⁻ x, ‖f x‖ₑ^p ∂powerWeightedVolume d (1-(d:Real))) := by
      have hh := hLow ν hν E hE (L m) m (hL m hm) f hfi hfo
      rw [dyadic_moment_decay_as_norm_decay (by linarith : 0 < p)] at hh
      simpa only [s,mul_assoc] using hh
    have hh := finite_geometric_sum_moment_bound ν I
      (fun m x => ⨆ t : E, ‖localizedResolutionPiece φ (L m) (fun k => k-m) f t x‖ₑ)
      (fun m _ => measurable_localizedResolutionPiece_maximal φ (L m) _ f E)
      (by linarith : 1 ≤ p) s
      (D*∫⁻ x, ‖f x‖ₑ^p ∂powerWeightedVolume d (1-(d:Real))) hb
    apply hh.trans
    simpa only [mul_assoc] using mul_le_mul'
      (le_add_left (le_refl (((1-s)⁻¹)^p*D))) le_rfl
/-- Recover the actual spherical maximal operator from its compact resolution.
Only positive high-shell decay is required in this p >= 2 argument. -/
theorem localized_resolution_moment_bound_ge_two {d : Nat} (hd : 0 < d)
    (φ : SchwartzMap (Euclidean d) Complex) (hmass : ∫ x, φ x = 1)
    {p : Real} (hp : 2 ≤ p) (k₀ : Nat)
    (r H : ENNReal) (hr : r < 1) (hH : H ≠ ⊤)
    (hHigh : ∀ (ν : Measure (Euclidean d)), ν ≤ powerWeightedVolume d (1 - (d : Real)) →
      ∀ (E : Set Real), E ⊆ Icc 1 2 →
      ∀ (L : Finset Nat), (∀ k ∈ L, k₀ ≤ k) → ∀ n : Nat,
      ∀ f : SchwartzMap (Euclidean d) Complex,
      (∀ x, ‖x‖ < 1/8 → f x = 0) → (∀ x, 8 < ‖x‖ → f x = 0) →
      (∫⁻ x, (⨆ t : E, ‖localizedResolutionPiece φ L (fun k => k+n) f t x‖ₑ)^p ∂ν) ≤
        (r^n)^p * (H * ∫⁻ x, ‖f x‖ₑ^p ∂powerWeightedVolume d (1-(d:Real)))) :
    ∃ A : ENNReal, A ≠ ⊤ ∧
      ∀ (ν : Measure (Euclidean d)), ν ≤ powerWeightedVolume d (1-(d:Real)) →
      ∀ (E : Set Real), E ⊆ Icc 1 2 →
      ∀ (L : Finset Nat), (∀ k ∈ L, k₀ ≤ k) →
      ∀ f : SchwartzMap (Euclidean d) Complex,
      (∀ x, ‖x‖ < 1/8 → f x = 0) → (∀ x, 8 < ‖x‖ → f x = 0) →
      (∫⁻ x, (⨆ t : E, ‖∑ k ∈ L,
        (dyadicSpatialShell d (-(k:Int)-1)).indicator
          (sphericalAverage d f t) x‖ₑ)^p ∂ν) ≤
        A * ∫⁻ x, ‖f x‖ₑ^p ∂powerWeightedVolume d (1-(d:Real)) := by
  classical
  obtain ⟨A,hA,hb⟩ := resolution_frequency_sums_moment_bound_ge_two hd φ hp k₀ r H hr hH hHigh
  refine ⟨2 ^ p * (A + A), ENNReal.mul_ne_top
    (ENNReal.rpow_ne_top_of_nonneg (by linarith) (by norm_num))
    (ENNReal.add_ne_top.mpr ⟨hA, hA⟩), ?_⟩
  intro ν hν E hE L hL f hinner houter
  let Fj := fun J (t : E) (x : Euclidean d) =>
    ∑ k ∈ L, (dyadicSpatialShell d (-(k : ℤ) - 1)).indicator
      (fun y => ∑ j ∈ Finset.range (J + 1),
        sphericalAverage d (compactResolutionPiece φ j f) t y) x
  apply maximal_moment_le_of_tendsto ν _ Fj (by linarith)
  · intro J
    apply measurable_disjoint_indicator_maximal_norm L
      (fun k => dyadicSpatialShell d (-(k : ℤ) - 1))
      (fun _ (t : E) y => ∑ j ∈ Finset.range (J + 1),
        sphericalAverage d (compactResolutionPiece φ j f) t y)
      (fun k => measurableSet_dyadicSpatialShell d (-(k : ℤ) - 1))
      (pairwiseDisjoint_negative_dyadicSpatialShell d)
    intro k
    apply LowerSemicontinuous.measurable
    apply lowerSemicontinuous_iSup
    intro t
    apply Continuous.lowerSemicontinuous
    apply Continuous.enorm
    apply continuous_finsetSum
    intro j _
    rw [← schwartzSphericalAverage_apply]
    exact (schwartzSphericalAverage (compactResolutionPiece φ j f) t).continuous
  · intro t x
    apply tendsto_finsetSum L
    intro k _
    by_cases hx : x ∈ dyadicSpatialShell d (-(k : ℤ) - 1)
    · simp only [Set.indicator_of_mem hx]
      exact sphericalAverage_compact_resolution φ f hmass t x
    · simp only [Set.indicator_of_notMem hx]
      exact tendsto_const_nhds
  · intro J
    let H := fun x => ∑ n ∈ Finset.range (J + 1), ⨆ t : E,
      ‖localizedResolutionPiece φ (L.filter (fun k => k + n ≤ J))
        (fun k => k + n) f t x‖ₑ
    let D := fun x => ∑ m ∈ Finset.range (L.sup id + 1), ⨆ t : E,
      ‖localizedResolutionPiece φ (L.filter (fun k => 0 < m ∧ m ≤ k ∧ k - m ≤ J))
        (fun k => k - m) f t x‖ₑ
    have hH : Measurable H := Finset.measurable_sum _ (fun n _ =>
      measurable_localizedResolutionPiece_maximal φ _ _ f E)
    have hpoint (x : Euclidean d) : (⨆ t : E, ‖Fj J t x‖ₑ) ≤ H x + D x := by
      apply iSup_le
      intro t
      dsimp only [Fj]
      rw [localized_resolution_frequency_split]
      apply (enorm_add_le _ _).trans
      apply add_le_add
      · exact (enorm_sum_le _ _).trans (Finset.sum_le_sum (fun n _ =>
          le_iSup (fun t : E => ‖localizedResolutionPiece φ _ _ f t x‖ₑ) t))
      · exact (enorm_sum_le _ _).trans (Finset.sum_le_sum (fun m _ =>
          le_iSup (fun t : E => ‖localizedResolutionPiece φ _ _ f t x‖ₑ) t))
    have hbH := (hb ν hν E hE (Finset.range (J + 1))
      (fun n => L.filter (fun k => k + n ≤ J)) f hinner houter).1
      (fun n _ k hk => hL k (Finset.mem_filter.mp hk).1)
    have hbD := (hb ν hν E hE (Finset.range (L.sup id + 1))
      (fun m => L.filter (fun k => 0 < m ∧ m ≤ k ∧ k - m ≤ J)) f hinner houter).2
      (fun m _ k hk => (Finset.mem_filter.mp hk).2.2.1)
    calc
      _ ≤ ∫⁻ x, (2 : ℝ≥0∞) ^ p * (H x ^ p + D x ^ p) ∂ν := by
        apply lintegral_mono
        intro x
        exact (ENNReal.rpow_le_rpow (hpoint x) (by linarith)).trans
          (ENNReal.add_rpow_le_two_rpow_mul_rpow_add_rpow _ _ (by linarith))
      _ = 2 ^ p * ((∫⁻ x, H x ^ p ∂ν) + ∫⁻ x, D x ^ p ∂ν) := by
        rw [lintegral_const_mul' _ _ (by finiteness), lintegral_add_left (hH.pow_const p)]
      _ ≤ _ := by
        have hh := mul_le_mul' (le_refl ((2 : ℝ≥0∞) ^ p)) (add_le_add hbH hbD)
        simpa only [mul_add, add_mul, mul_assoc] using hh

/-- Any sufficiently small punctured ball is the union of its actual dyadic shells. -/
theorem inner_ball_subset_negative_shells_from {d : Nat} (k₀ : Nat)
    {x : Euclidean d} (hx : ‖x‖ ≤ (2 : Real) ^ (-(k₀ : Int))) (hx₀ : x ≠ 0) :
    x ∈ ⋃ k : Nat, dyadicSpatialShell d (-((k+k₀:Nat):Int)-1) := by
  obtain ⟨j,hj⟩ := exists_mem_Ioc_zpow (norm_pos_iff.mpr hx₀)
    (by norm_num : (1:Real) < 2)
  have hjneg : j ≤ -(k₀:Int)-1 := by
    have hh : (2:Real)^j < (2:Real)^(-(k₀:Int)) := hj.1.trans_le hx
    have hh' : j < -(k₀:Int) := (zpow_lt_zpow_iff_right₀ (by norm_num : (1:Real) < 2)).mp hh
    omega
  let k := (-j-(k₀:Int)-1).toNat
  have hk : (k:Int) = -j-(k₀:Int)-1 := Int.toNat_of_nonneg (by omega)
  apply Set.mem_iUnion.mpr
  refine ⟨k,?_⟩
  change (2:Real)^(-((k+k₀:Nat):Int)-1) < ‖x‖ ∧
    ‖x‖ ≤ (2:Real)^((-((k+k₀:Nat):Int)-1)+1)
  have he : -((k+k₀:Nat):Int)-1 = j := by push_cast; omega
  simpa only [he,Set.mem_Ioc] using hj

theorem inner_ball_moment_of_finite_shells_from {d : ℕ} (hd : 0 < d)
    (k₀ : Nat) (ν : Measure (Euclidean d)) (hν : ν ≤ powerWeightedVolume d (1 - (d : ℝ)))
    (E : Set ℝ) (f : SchwartzMap (Euclidean d) ℂ) {p : ℝ} (hp : 0 < p)
    (Q : ℝ≥0∞)
    (hb : ∀ (L : Finset ℕ), (∀ k ∈ L, k₀ ≤ k) →
      (∫⁻ x, (⨆ t : E, ‖∑ k ∈ L, (dyadicSpatialShell d (-(k : ℤ) - 1)).indicator
        (sphericalAverage d f t) x‖ₑ) ^ p ∂ν) ≤ Q) :
    (∫⁻ x in Metric.closedBall (0 : Euclidean d) ((2:Real)^(-(k₀:Int))),
      (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p ∂ν) ≤ Q := by
  classical
  let S := fun k : ℕ => dyadicSpatialShell d (-((k + k₀ : ℕ) : ℤ) - 1)
  let F := fun x => (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p
  have hfinite (I : Finset ℕ) : (∑ k ∈ I, ∫⁻ x in S k, F x ∂ν) ≤ Q := by
    have hh := hb (I.image (fun k => k + k₀)) (by
      intro k hk
      obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hk
      omega)
    rw [disjoint_indicator_maximal_moment ν _
      (fun k : ℕ => dyadicSpatialShell d (-(k : ℤ) - 1))
      (fun _ (t : E) => sphericalAverage d f t)
      (fun k => measurableSet_dyadicSpatialShell d (-(k : ℤ) - 1))
      (pairwiseDisjoint_negative_dyadicSpatialShell d)
      (fun _ => measurable_schwartz_radius_supremum f E) hp] at hh
    rw [Finset.sum_image (fun i _ j _ hij => Nat.add_right_cancel hij)] at hh
    exact hh
  have hsum : (∑' k, ∫⁻ x in S k, F x ∂ν) ≤ Q :=
    ENNReal.summable.tsum_le_of_sum_le hfinite
  have hU : MeasurableSet (⋃ k, S k) := MeasurableSet.iUnion (fun k =>
    measurableSet_dyadicSpatialShell d _)
  have hzero : ν ({0} : Set (Euclidean d)) = 0 := by
    apply le_antisymm _ bot_le
    exact (hν _).trans_eq (powerWeightedVolume_singleton_zero hd (1 - (d : ℝ)))
  have hae : ∀ᵐ x ∂ν, x ≠ (0 : Euclidean d) := by
    simpa only [ae_iff, not_not, Set.ofPred_eq_eq_singleton] using hzero
  calc
    _ = ∫⁻ x, (Metric.closedBall (0 : Euclidean d) ((2:Real)^(-(k₀:Int)))).indicator F x ∂ν :=
      (lintegral_indicator measurableSet_closedBall F).symm
    _ ≤ ∫⁻ x, (⋃ k, S k).indicator F x ∂ν := by
      apply lintegral_mono_ae
      filter_upwards [hae] with x hx₀
      by_cases hx : x ∈ Metric.closedBall (0 : Euclidean d) ((2:Real)^(-(k₀:Int)))
      · have hxs : x ∈ ⋃ k, S k := inner_ball_subset_negative_shells_from k₀
          (by simpa only [Metric.mem_closedBall, dist_zero_right] using hx) hx₀
        simp only [Set.indicator_of_mem hx, Set.indicator_of_mem hxs]
        exact le_rfl
      · rw [Set.indicator_of_notMem hx]
        exact bot_le
    _ = ∫⁻ x in ⋃ k, S k, F x ∂ν := lintegral_indicator hU F
    _ ≤ ∑' k, ∫⁻ x in S k, F x ∂ν := lintegral_iUnion_le S F
    _ ≤ Q := hsum

/-- A bound on an arbitrarily small inner ball suffices for the full
weighted core, by the existing low/middle/high input decomposition. -/
theorem uniform_core_moment_bound_of_inner_ball {d : Nat} (hd : 2 ≤ d)
    {p R : Real} (hp : 1 < p) (hR : 0 < R) (U : Real)
    (D : ENNReal) (hD : D ≠ ⊤)
    (hInner : ∀ (E : Set Real), E ⊆ Icc 1 2 → UnweightedMaximalBound d E p U →
      ∀ f : SchwartzMap (Euclidean d) Complex,
      (∀ x, ‖x‖ < 1/8 → f x = 0) → (∀ x, 8 < ‖x‖ → f x = 0) →
      (∫⁻ x in Metric.closedBall (0:Euclidean d) R,
        (⨆ t : E, ‖sphericalAverage d f t x‖ₑ)^p
          ∂powerWeightedVolume d (1-(d:Real))) ≤
        D*(∫⁻ x, ‖f x‖ₑ^p ∂powerWeightedVolume d (1-(d:Real)))) :
    ∃ B : Real, 0 ≤ B ∧ ∀ E : Set Real, E ⊆ Icc 1 2 →
      UnweightedMaximalBound d E p U →
      SchwartzCoreMomentBound (powerWeightedVolume d (1-(d:Real))) E p B := by
  have hd' : (2:Real) ≤ d := by exact_mod_cast hd
  have hα : 1-(d:Real) ≤ 0 := by linarith
  obtain ⟨AL,hAL,hLow⟩ := uniform_low_input_constant (by linarith : 0 < p) hα U
  obtain ⟨AG,hAG,hMid⟩ := uniform_middle_input_constant (by linarith : 0 < p) hα
    (by norm_num : (0:Real) < 1/16) U
  obtain ⟨AR,hAR,hMidR⟩ := uniform_middle_input_constant (by linarith : 0 < p) hα hR U
  obtain ⟨AH,hAH,hHigh⟩ := uniform_high_input_constant (by linarith : 0 < p) hα U
  let M : ENNReal := ‖(surfaceMass d : Complex)‖ₑ^p
  have hM : M ≠ ⊤ := by dsimp [M]; finiteness
  obtain ⟨K,hK,hCore⟩ := core_improvement_of_split_bounds hp
    (M*AL) (M*AG) (M*AH) (D+M*AR)
    (by finiteness) (by finiteness) (by finiteness) (by finiteness)
  refine ⟨2*K,by positivity,?_⟩
  intro E hE hU
  have hEpos : E ⊆ Ioi 0 := fun t ht => lt_of_lt_of_le zero_lt_one (hE ht).1
  have hCore' := hCore E
    (fun f hf => by
      simpa only [M,mul_assoc] using spherical_moment_le_of_normalized (by omega)
        E hEpos f _ (by linarith : 0 ≤ p) _ (hLow E hE hU f hf))
    (fun f hf => by
      simpa only [M,mul_assoc] using spherical_moment_le_of_normalized (by omega)
        E hEpos f _ (by linarith : 0 ≤ p) _ (hMid E hU f hf))
    (fun f hf => by
      simpa only [M,mul_assoc] using spherical_moment_le_of_normalized (by omega)
        E hEpos f _ (by linarith : 0 ≤ p) _ (hHigh E hE hU f hf))
    (powerWeightedVolume d (1-(d:Real))) le_rfl 1 (by norm_num)
  have hh : SchwartzCoreMomentBound (powerWeightedVolume d (1-(d:Real))) E p
      (K*(1+(1:Real)^(1-p/2))) := by
    apply hCore'
    intro f hfi hfo
    have hf : ∀ x, x ∉ euclideanAnnulus d (1/8) 8 → f x = 0 := by
      intro x hx
      have hx' : ¬(‖x‖ ≤ 8 ∧ 1/8 ≤ ‖x‖) := by
        simpa only [euclideanAnnulus,Set.mem_sdiff,Metric.mem_closedBall,Metric.mem_ball,
          dist_zero_right,not_lt] using hx
      by_cases ho : ‖x‖ ≤ 8
      · exact hfi x (lt_of_not_ge (fun hi => hx' ⟨ho,hi⟩))
      · exact hfo x (lt_of_not_ge ho)
    have ho := spherical_moment_le_of_normalized (by omega : 0 < d) E hEpos f
      ((powerWeightedVolume d (1-(d:Real))).restrict
        (Metric.closedBall (0:Euclidean d) R)ᶜ) (by linarith : 0 ≤ p) _ (hMidR E hU f hf)
    have hi := hInner E hE hU f hfi hfo
    calc
      _ ≤ ∫⁻ x, (⨆ t : E, ‖sphericalAverage d f t x‖ₑ)^p
          ∂powerWeightedVolume d (1-(d:Real)) :=
        lintegral_mono' Measure.restrict_le_self le_rfl
      _ = (∫⁻ x in Metric.closedBall (0:Euclidean d) R,
          (⨆ t : E, ‖sphericalAverage d f t x‖ₑ)^p
            ∂powerWeightedVolume d (1-(d:Real))) +
          ∫⁻ x in (Metric.closedBall (0:Euclidean d) R)ᶜ,
          (⨆ t : E, ‖sphericalAverage d f t x‖ₑ)^p
            ∂powerWeightedVolume d (1-(d:Real)) :=
        (lintegral_add_compl _ measurableSet_closedBall).symm
      _ ≤ _ := by
        simpa only [ENNReal.ofReal_one,ENNReal.one_rpow,mul_one,add_mul,mul_assoc,M]
          using add_le_add hi ho
  simpa only [Real.one_rpow,show (1:Real)+1 = 2 by norm_num,mul_comm K] using hh

/-- Interpolate the actual compact-synthesis shell operator at its genuine
relative scale. The endpoint constants are independent of both dyadic indices. -/
theorem compact_synthesis_two_four_shell_gain {d : Nat}
    (K : SchwartzMap (Euclidean d) Complex) (ν : Measure (Euclidean d)) [SFinite ν]
    {p μ σ B : Real} (hp₂ : 2 < p) (hp₄ : p < 4)
    (A : ENNReal) (hB : 0 < B) (hμ : 0 < μ) (hσ : 0 < σ)
    (hTwo : ∀ g : SchwartzMap (Euclidean d) Complex,
      (∫⁻ x, (⨆ t : Icc (1:Real) 2,
        ‖sphericalAverage d (compactConvolution K g) t x‖ₑ)^(2:Real) ∂ν) ≤
          A*∫⁻ x, ‖g x‖ₑ^(2:Real))
    (hFour : ∀ g : SchwartzMap (Euclidean d) Complex,
      (∫⁻ x, (⨆ t : Icc (1:Real) 2,
        ‖sphericalAverage d (compactConvolution K g) t x‖ₑ)^(4:Real) ∂ν) ≤
          ENNReal.ofReal B^(4:Real)*ENNReal.ofReal μ^(-(4*σ))*
            ∫⁻ x, ‖g x‖ₑ^(4:Real)) (f : SchwartzMap (Euclidean d) Complex) :
    (∫⁻ x, (⨆ t : Icc (1:Real) 2,
      ‖sphericalAverage d (compactConvolution K f) t x‖ₑ)^p ∂ν) ≤
        Auto.Spherical.MSS.schwartzTwoFourMomentConstant p A*
          ENNReal.ofReal B^(2*p-4)*ENNReal.ofReal μ^(-(2*σ*(p-2)))*
            ∫⁻ x, ‖f x‖ₑ^p := by
  let T := fun (g : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) =>
    (⨆ t : Icc (1:Real) 2, ‖sphericalAverage d (compactConvolution K g) t x‖ₑ).toReal
  have hTsub (g h : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
      T (g+h) x ≤ T g x + T h x := by
    dsimp only [T]
    rw [compactConvolution_add_right]
    have hcoe : ((compactConvolution K g + compactConvolution K h :
        SchwartzMap (Euclidean d) Complex) : Euclidean d → Complex) =
      (compactConvolution K g : Euclidean d → Complex) +
        (compactConvolution K h : Euclidean d → Complex) := rfl
    rw [hcoe]
    simpa only [ofReal_norm] using
      Auto.Spherical.Auxiliary.toReal_iSup_ennreal_norm_sphericalAverage_add_le
        (compactConvolution K g) (compactConvolution K h)
        (compactConvolution K g).continuous (compactConvolution K h).continuous
        (by norm_num : (1:Real) ≤ 2) x
  have hT (g : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
      ENNReal.ofReal (T g x) =
        ⨆ t : Icc (1:Real) 2, ‖sphericalAverage d (compactConvolution K g) t x‖ₑ := by
    apply ENNReal.ofReal_toReal
    simpa only [ofReal_norm] using
      Auto.Spherical.Auxiliary.iSup_ennreal_norm_sphericalAverage_ne_top
        (compactConvolution K g) (compactConvolution K g).continuous
        (by norm_num : (1:Real) ≤ 2) x
  have hh := Auto.Spherical.MSS.schwartz_sublinear_two_four_frequency_gain_moment ν T
    (fun _ _ => ENNReal.toReal_nonneg) hTsub
    (fun g => (measurable_schwartz_radius_supremum (compactConvolution K g)
      (Icc (1:Real) 2)).ennreal_toReal.aestronglyMeasurable)
    hp₂ hp₄ A hB hμ hσ
    (fun g => by simpa only [hT] using hTwo g)
    (fun g => by simpa only [hT] using hFour g) f
  simpa only [hT] using hh

/-! The planar second-moment endpoint uses the same actual compact kernels,
finite interval covers, and thin input shells as the open interpolation range. -/

open Metric _root_.Spherical


private theorem synthesis_two_coefficient (C : ℝ) (i : ℕ) :
    ENNReal.ofReal ((C / ((2 : ℝ)^i)^(((2:ℝ)-1)/2))^2) =
      ENNReal.ofReal (2*C^2)*(2:ENNReal)^(-((i+1:ℕ):ℝ)) := by
  have hs : (((2:ℝ)^i)^(((2:ℝ)-1)/2))^2 = (2:ℝ)^i := by
    rw [← Real.rpow_natCast,← Real.rpow_mul (by positivity : (0:ℝ) ≤ 2^i)]
    norm_num
  rw [div_pow,hs,div_eq_mul_inv,ENNReal.ofReal_mul (sq_nonneg _)]
  have hh : ENNReal.ofReal (((2:ℝ)^i)⁻¹) = (2:ENNReal)^(-(i:ℝ)) := by
    rw [ENNReal.ofReal_inv_of_pos (by positivity : (0 : ℝ) < 2^i),
      ENNReal.ofReal_pow (by norm_num : (0 : ℝ) ≤ 2)]
    norm_num only [ENNReal.ofReal_ofNat]
    rw [← ENNReal.rpow_natCast,← ENNReal.rpow_neg_one,← ENNReal.rpow_mul]
    congr 1
    ring
  rw [hh,ENNReal.ofReal_mul (by norm_num : (0:ℝ) ≤ 2)]
  norm_num only [ENNReal.ofReal_ofNat]
  have he : (2:ENNReal)^(-(i:ℝ)) =
      (2:ENNReal)*(2:ENNReal)^(-((i+1:ℕ):ℝ)) := by
    calc
      _ = (2:ENNReal)^((1:ℝ)+(-((i+1:ℕ):ℝ))) := by
        congr 1
        push_cast
        ring
      _ = (2:ENNReal)^(1:ℝ)*(2:ENNReal)^(-((i+1:ℕ):ℝ)) :=
        ENNReal.rpow_add _ _ (by norm_num) (by norm_num)
      _ = _ := by rw [ENNReal.rpow_one]
  convert congrArg (fun z : ENNReal => ENNReal.ofReal (C^2)*z) he using 1
  ring

theorem synthesis_fixed_and_derivative_two_bound {N : ℕ}
    (φ : SchwartzMap (Euclidean 2) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean 2))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : (1 : ℝ) / 2 ≤ N) :
    ∃ A₁ A₂ : ENNReal,A₁ ≠ ⊤ ∧ A₂ ≠ ⊤ ∧
      ∀ j : ℕ,0 < j → ∀ t : ℝ,t ∈ Icc 1 2 → ∀ f : SchwartzMap (Euclidean 2) ℂ,
      (∫⁻ x,‖sphericalAverage 2 (compactConvolution (compactSynthesisKernel φ j) f) t x‖ₑ^(2:ℝ)) ≤
        A₁*(2:ENNReal)^(-(j:ℝ))*(∫⁻ x,‖f x‖ₑ^(2:ℝ)) ∧
      (∫⁻ x,‖normalizedSynthesisRadiusDerivative φ f j t x‖ₑ^(2:ℝ)) ≤
        A₂*(2:ENNReal)^(-(j:ℝ))*(∫⁻ x,‖f x‖ₑ^(2:ℝ)) := by
  have hN' : ((2:ℝ)-1)/2 ≤ N := by norm_num; exact hN
  obtain ⟨C₁,hC₁,hb₁⟩ := smoothed_sphericalAverage_L2_moment_bound (by norm_num : 2 ≤ 2)
    (compactSynthesisKernel φ 1) (compactSynthesisKernel_fourier_isBigO φ hflat 0) hN'
  obtain ⟨C₂,hC₂,hb₂⟩ := normalizedRadiusDerivative_L2_bound (by norm_num : 2 ≤ 2)
    (compactSynthesisKernel φ 1) (compactSynthesisKernel_fourier_isBigO φ hflat 0) hN'
  refine ⟨ENNReal.ofReal (2*C₁^2),ENNReal.ofReal (2*C₂^2),
    ENNReal.ofReal_ne_top,ENNReal.ofReal_ne_top,?_⟩
  intro j hj t ht f
  obtain ⟨i,rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hj)
  constructor
  · rw [compactSynthesisKernel_succ]
    have hb := hb₁ i t ht.1 f
    change (∫⁻ x,‖sphericalAverage 2 (compactConvolution
      (compactDyadicDilate (compactSynthesisKernel φ 1) i) f) t x‖ₑ^2) ≤
      ENNReal.ofReal ((C₁/((2:ℝ)^i)^(((2:ℝ)-1)/2))^2)*(∫⁻ x,‖f x‖ₑ^2) at hb
    rw [synthesis_two_coefficient] at hb
    simpa only [ENNReal.rpow_two,Nat.succ_eq_add_one] using hb
  · have hm : (∫⁻ x,‖normalizedSynthesisRadiusDerivative φ f (i+1) t x‖ₑ^2) ≤
        ∫⁻ x,‖normalizedRadiusDerivative (compactSynthesisKernel φ 1) f i t x‖ₑ^2 := by
      apply lintegral_mono
      intro x
      rw [normalizedSynthesisRadiusDerivative_succ]
      change ‖(1/2:ℝ) • (normalizedRadiusDerivative (compactSynthesisKernel φ 1) f i t x)‖ₑ^2 ≤
        ‖normalizedRadiusDerivative (compactSynthesisKernel φ 1) f i t x‖ₑ^2
      rw [enorm_smul]
      norm_num only [Real.enorm_eq_ofReal, Real.norm_eq_abs,
        abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 1/2),
        ENNReal.ofReal_div_of_pos (by norm_num : (0:ℝ) < 2),ENNReal.ofReal_one,
        ENNReal.ofReal_ofNat,mul_pow]
      exact mul_le_of_le_one_left (by positivity)
        (pow_le_one₀ (by positivity)
          (by simpa only [one_div] using
            (ENNReal.inv_le_one.mpr (show (1 : ENNReal) ≤ 2 by norm_num))))
    have hb := hm.trans (hb₂ i t ht f)
    change (∫⁻ x,‖normalizedSynthesisRadiusDerivative φ f (i+1) t x‖ₑ^2) ≤
      ENNReal.ofReal ((C₂/((2:ℝ)^i)^(((2:ℝ)-1)/2))^2)*(∫⁻ x,‖f x‖ₑ^2) at hb
    rw [synthesis_two_coefficient] at hb
    simpa only [ENNReal.rpow_two,Nat.succ_eq_add_one] using hb
theorem synthesis_intervalCover_two_bound {N : ℕ}
    (φ : SchwartzMap (Euclidean 2) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean 2))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((2 : ℝ) - 1) / 2 ≤ N) :
     ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (j k : ℕ), 0 < j →
      ∀ (E : Set ℝ) (I : Finset ℝ) (a b : ℝ → ℝ),
      (∀ i ∈ I, a i ≤ b i) → (∀ i ∈ I, Icc (a i) (b i) ⊆ Icc 1 2) →
      (∀ t ∈ E, ∃ i ∈ I, t ∈ Icc (a i) (b i)) →
      (∀ i ∈ I, b i - a i ≤ ((2 : ℝ) ^ j)⁻¹) →
      ∀ (f : SchwartzMap (Euclidean 2) ℂ),
      (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (((2 : ℝ) ^ k)⁻¹),
        (⨆ t : E,
          ‖sphericalAverage 2 (compactConvolution (compactSynthesisKernel φ j) f) t x‖ₑ) ^ (2:ℝ)) ≤
        A * I.card * (2 : ℝ≥0∞) ^ (-(j:ℝ)) * ∫⁻ x, ‖f x‖ₑ ^ (2:ℝ) := by
  obtain ⟨A₁,A₂,hA₁,hA₂,hbounds⟩ := synthesis_fixed_and_derivative_two_bound φ hflat
    (by norm_num at hN ⊢; exact hN)
  refine ⟨(2:ENNReal)^(2:ℝ)*(A₁+A₂),ENNReal.mul_ne_top (by norm_num)
    (ENNReal.add_ne_top.mpr ⟨hA₁,hA₂⟩),?_⟩
  intro j k hj E I a b hab hJ hcover hlen f
  let g := compactConvolution (compactSynthesisKernel φ j) f
  let W := (2 : ℝ≥0∞) ^ (-(j:ℝ)) * ∫⁻ x, ‖f x‖ₑ ^ (2:ℝ)
  have hF (t : ℝ) : Measurable (sphericalAverage 2 g t) := by
    rw [← schwartzSphericalAverage_apply]
    exact (schwartzSphericalAverage g t).continuous.measurable
  have hD := continuous_sphericalRadiusDerivative g
  have hfixed (t : ℝ) (ht : t ∈ Icc (1 : ℝ) 2) :
      (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (((2 : ℝ) ^ k)⁻¹),
        ‖sphericalAverage 2 g t x‖ₑ ^ (2:ℝ)) ≤ A₁ * W := by
    simpa only [W, mul_assoc] using
      ((lintegral_mono' Measure.restrict_le_self le_rfl).trans (hbounds j hj t ht f).1)
  have hderivative (t : ℝ) (ht : t ∈ Icc (1 : ℝ) 2) :
      (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (((2 : ℝ) ^ k)⁻¹),
        ‖(((2 : ℝ) ^ j)⁻¹) • sphericalRadiusDerivative g t x‖ₑ ^ (2:ℝ)) ≤ A₂ * W := by
    simpa only [normalizedSynthesisRadiusDerivative_apply, W, mul_assoc]
      using ((lintegral_mono' Measure.restrict_le_self le_rfl).trans (hbounds j hj t ht f).2)
  have hDc (x : Euclidean 2) : Continuous (fun t => sphericalRadiusDerivative g t x) := by
    have hc : Continuous (fun t : ℝ => (t, x)) := continuous_id.prodMk continuous_const
    have hc' := hD.comp hc
    exact hc'
  have hb := finite_interval_cover_maximal_moment
    (X := Euclidean 2) (ι := ℝ) (p := (2:ℝ)) (δ := ((2 : ℝ) ^ j)⁻¹)
    (E := E) (J := Icc 1 2)
    (volume.restrict (Metric.closedBall (0 : Euclidean 2) (((2 : ℝ) ^ k)⁻¹)))
    (sphericalAverage 2 g) (sphericalRadiusDerivative g)
  have hb' := hb hF hD.measurable hDc
    (hasDerivAt_sphericalAverage_schwartz g)
    I a b hab hJ hcover (by norm_num : 1 ≤ (2:ℝ))
    (by positivity : 0 < ((2 : ℝ) ^ j)⁻¹) hlen (A₁ * W) (A₂ * W)
    hfixed hderivative
  exact hb'.trans_eq (by dsimp only [W]; ring)

theorem synthesis_finiteCover_two_bound {N : ℕ}
    (φ : SchwartzMap (Euclidean 2) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean 2))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((2 : ℝ) - 1) / 2 ≤ N) :
     ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (j k : ℕ), 0 < j →
      ∀ (E : Set ℝ), E ⊆ Icc 1 2 → ∀ (I : Finset ℝ),
      IsIntervalCover E (((2 : ℝ) ^ j)⁻¹) I →
      ∀ (f : SchwartzMap (Euclidean 2) ℂ),
      (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (((2 : ℝ) ^ k)⁻¹),
        (⨆ t : E,
          ‖sphericalAverage 2 (compactConvolution (compactSynthesisKernel φ j) f) t x‖ₑ) ^ (2:ℝ)) ≤
        A * I.card * (2 : ℝ≥0∞) ^ (-(j:ℝ)) * ∫⁻ x, ‖f x‖ₑ ^ (2:ℝ) := by
  obtain ⟨A, hA, hb⟩ := synthesis_intervalCover_two_bound φ hflat hN
  refine ⟨A, hA, ?_⟩
  intro j k hj E hE I hI f
  obtain ⟨I', hcard, hab, hJ, hcover, hlen⟩ := intervalCover_clip hE hI
  apply (hb j k hj E I' (fun i => max 1 (i - (((2 : ℝ) ^ j)⁻¹) / 2))
    (fun i => min 2 (i + (((2 : ℝ) ^ j)⁻¹) / 2)) hab hJ hcover hlen f).trans
  exact mul_le_mul' (mul_le_mul' (mul_le_mul' le_rfl (by exact_mod_cast hcard))
    le_rfl) le_rfl

theorem synthesis_thinWindow_two_bound {N : ℕ}
    (φ : SchwartzMap (Euclidean 2) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean 2))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((2 : ℝ) - 1) / 2 ≤ N)
    (hφ : ∀ x, (1 : ℝ) / 8 < ‖x‖ → φ x = 0)
     :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (j k : ℕ), 0 < j → k ≤ j →
      (((2 : ℝ) ^ k)⁻¹) ≤ 1 / 16 →
      ∀ (E : Set ℝ), E ⊆ Icc 1 2 → ∀ (I : Finset ℤ),
      (∀ m ∈ I, 1 ≤ (m : ℝ) * (((2 : ℝ) ^ k)⁻¹)) →
      (∀ t ∈ E, ∃ m ∈ I,
        |t - (m : ℝ) * (((2 : ℝ) ^ k)⁻¹)| ≤ (((2 : ℝ) ^ k)⁻¹) / 2) →
      ∀ (M : ℝ≥0∞),
      (∀ m ∈ I, ∃ J : Finset ℝ,
        IsIntervalCover
          (E ∩ {t | |t - (m : ℝ) * (((2 : ℝ) ^ k)⁻¹)| ≤ (((2 : ℝ) ^ k)⁻¹) / 2})
          (((2 : ℝ) ^ j)⁻¹) J ∧ (J.card : ℝ≥0∞) ≤ M) →
      ∀ (f : SchwartzMap (Euclidean 2) ℂ),
      (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (((2 : ℝ) ^ k)⁻¹),
        (⨆ t : E,
          ‖sphericalAverage 2 (compactConvolution (compactSynthesisKernel φ j) f) t x‖ₑ) ^ (2:ℝ)) ≤
        A * M * (2 : ℝ≥0∞) ^ (-(j:ℝ)) * ∫⁻ x, ‖f x‖ₑ ^ (2:ℝ) := by
  classical
  obtain ⟨A, hA, hb⟩ := synthesis_finiteCover_two_bound φ hflat hN
  refine ⟨A * 8, ENNReal.mul_ne_top hA (by norm_num), ?_⟩
  intro j k hj hkj hk E hE I hcenter hcover M hM f
  let R : ℝ := ((2 : ℝ) ^ k)⁻¹
  let K := compactSynthesisKernel φ j
  let W : ℤ → Set ℝ := fun m => {t | |t - (m : ℝ) * R| ≤ R / 2}
  let Q : ℝ≥0∞ := (2 : ℝ≥0∞) ^ (-(j:ℝ))
  have hR : 0 < R := by dsimp only [R]; positivity
  have hK : ∀ y, R / 2 < ‖y‖ → K y = 0 := synthesis_highFrequency_support φ hφ hj hkj
  have hex (m : ℤ) : ∃ g : SchwartzMap (Euclidean 2) ℂ, m ∈ I →
      (∀ y, ‖g y‖ ≤ ‖f y‖) ∧
      (∀ y, 3 * R ≤ |‖y‖ - (m : ℝ) * R| → g y = 0) ∧
      (∀ t, 0 ≤ t → t ∈ W m → ∀ x, ‖x‖ ≤ R →
        sphericalAverage 2 (compactConvolution K f) t x =
          sphericalAverage 2 (compactConvolution K g) t x) := by
    by_cases hm : m ∈ I
    · obtain ⟨g, hg⟩ := exists_schwartz_shell_localization K f (hcenter m hm) hR hk hK
      exact ⟨g, fun _ => hg⟩
    · exact ⟨0, fun hh => (hm hh).elim⟩
  choose g hg using hex
  have hlocal (m : ℤ) (hm : m ∈ I) :
      (∫⁻ x in Metric.closedBall (0 : Euclidean 2) R,
        (⨆ t : (E ∩ W m : Set ℝ),
          ‖sphericalAverage 2 (compactConvolution K (g m)) t x‖ₑ) ^ (2:ℝ)) ≤
        (A * M * Q) * ∫⁻ x, ‖g m x‖ₑ ^ (2:ℝ) := by
    obtain ⟨J, hJ, hcard⟩ := hM m hm
    apply (hb j k hj (E ∩ W m) (fun t ht => hE ht.1) J hJ (g m)).trans
    dsimp only [Q]
    exact mul_le_mul' (mul_le_mul' (mul_le_mul' le_rfl hcard)
      le_rfl) le_rfl
  have hsum := thin_shell_sum_moments_le I hR (by linarith : 0 < (2:ℝ)) f g
    (fun m hm => (hg m hm).1) (fun m hm => (hg m hm).2.1)
  have hreassemble := spherical_radius_window_reassembly I E W
    (Metric.closedBall (0 : Euclidean 2) R) measurableSet_closedBall
    (compactConvolution K f) (fun m => compactConvolution K (g m))
    (by linarith : 0 < (2:ℝ)) hcover
    (fun m hm t ht x hx => (hg m hm).2.2 t (by linarith [(hE ht.1).1]) ht.2 x
      (by simpa only [Metric.mem_closedBall, dist_zero_right] using hx))
  apply hreassemble.trans
  calc
    _ ≤ ∑ m ∈ I, (A * M * Q) * ∫⁻ x, ‖g m x‖ₑ ^ (2:ℝ) := Finset.sum_le_sum hlocal
    _ = (A * M * Q) * ∑ m ∈ I, ∫⁻ x, ‖g m x‖ₑ ^ (2:ℝ) := (Finset.mul_sum ..).symm
    _ ≤ (A * M * Q) * (8 * ∫⁻ x, ‖f x‖ₑ ^ (2:ℝ)) := mul_le_mul' le_rfl hsum
    _ = _ := by dsimp only [Q]; ring

theorem synthesis_assouad_weighted_two_bound {N : ℕ}
    (φ : SchwartzMap (Euclidean 2) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean 2))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((2 : ℝ) - 1) / 2 ≤ N)
    (hφ : ∀ x, (1 : ℝ) / 8 < ‖x‖ → φ x = 0)
     :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (E : Set ℝ), E ⊆ Icc 1 2 →
      ∀ (C γ α : ℝ), 0 ≤ C → 0 ≤ γ →
      (∀ δ a b : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ a → a ≤ b → b ≤ 2 → δ ≤ b - a →
        ∃ J : Finset ℝ, IsIntervalCover (E ∩ Icc a b) δ J ∧
          (J.card : ℝ) ≤ C * ((b - a) / δ) ^ γ) →
      ∀ (j k : ℕ), 4 ≤ k → k ≤ j → ∀ (f : SchwartzMap (Euclidean 2) ℂ),
      (∫⁻ x in euclideanAnnulus 2 ((((2 : ℝ) ^ k)⁻¹) / 2) (((2 : ℝ) ^ k)⁻¹),
        (⨆ t : E,
          ‖sphericalAverage 2 (compactConvolution (compactSynthesisKernel φ j) f) t x‖ₑ) ^ (2:ℝ)
          ∂powerWeightedVolume 2 α) ≤
        ((2 : ℝ≥0∞) ^ (-α) + 1) * (2 : ℝ≥0∞) ^ (-((k : ℝ) * α)) *
          (A * ENNReal.ofReal (C * ((2 * (((2 : ℝ) ^ k)⁻¹)) /
            (((2 : ℝ) ^ j)⁻¹)) ^ γ) *
            (2 : ℝ≥0∞) ^ (-(j:ℝ)) * ∫⁻ x, ‖f x‖ₑ ^ (2:ℝ)) := by
  obtain ⟨A, hA, hb⟩ := synthesis_thinWindow_two_bound φ hflat hN hφ
  refine ⟨A, hA, ?_⟩
  intro E hE C γ α hC hγ hcover j k hk hkj f
  have hR : 0 < ((2 : ℝ) ^ k)⁻¹ := by positivity
  have hδ : 0 < ((2 : ℝ) ^ j)⁻¹ := by positivity
  have hsmall : ((2 : ℝ) ^ k)⁻¹ ≤ 1 / 16 := by
    have hh := one_div_le_one_div_of_le (by norm_num : (0 : ℝ) < 2 ^ 4)
      (pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2) hk)
    norm_num at hh ⊢
    exact hh
  have hδR : ((2 : ℝ) ^ j)⁻¹ ≤ ((2 : ℝ) ^ k)⁻¹ := by
    simpa only [one_div] using one_div_le_one_div_of_le (by positivity : (0 : ℝ) < 2 ^ k)
      (pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2) hkj)
  obtain ⟨I, hI, hgrid⟩ := dyadic_radius_grid_cover k
  have hM (m : ℤ) (hm : m ∈ I) := thin_window_cover_of_assouad hE hC hγ hδ hδR
    (by linarith : ((2 : ℝ) ^ k)⁻¹ ≤ 1) (hI m hm)
    (fun a b ha hab hb hs => hcover _ a b hδ (by linarith) ha hab hb hs)
  have hu := hb j k (by omega) hkj hsmall E hE I (fun m hm => (hI m hm).1)
    (fun t ht => hgrid t (hE ht)) _ hM f
  have hw := dyadic_annulus_weight_moment_le
    (fun x => (⨆ t : E,
      ‖sphericalAverage 2 (compactConvolution (compactSynthesisKernel φ j) f) t x‖ₑ) ^ (2:ℝ))
    ((measurable_schwartz_radius_supremum
      (compactConvolution (compactSynthesisKernel φ j) f) E).pow_const (2:ℝ)) α k
  exact hw.trans (mul_le_mul' le_rfl hu)


/-- The actual compact synthesis has a uniform weighted planar shell
second moment, including the frequency/spatial diagonal. -/
theorem synthesis_planar_shell_two_bound {N : ℕ}
    (φ : SchwartzMap (Euclidean 2) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean 2))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : (1 : ℝ) / 2 ≤ N)
    (hφ : ∀ x, (1 : ℝ) / 8 < ‖x‖ → φ x = 0) :
    ∃ A : ENNReal,A ≠ ⊤ ∧ ∀ (E : Set ℝ),E ⊆ Icc 1 2 →
      ∀ (j k : ℕ),4 ≤ k → k ≤ j → ∀ f : SchwartzMap (Euclidean 2) ℂ,
      (∫⁻ x in euclideanAnnulus 2 ((((2:ℝ)^k)⁻¹)/2) (((2:ℝ)^k)⁻¹),
        (⨆ t : E,‖sphericalAverage 2
          (compactConvolution (compactSynthesisKernel φ j) f) t x‖ₑ)^(2:ℝ)
          ∂powerWeightedVolume 2 (-1)) ≤
        A*(∫⁻ x,‖f x‖ₑ^(2:ℝ)) := by
  obtain ⟨A,hA,hb⟩ := synthesis_assouad_weighted_two_bound φ hflat (by norm_num; exact hN) hφ
  refine ⟨24*A,ENNReal.mul_ne_top (by norm_num) hA,?_⟩
  intro E hE j k hk hkj f
  have hcover (δ a b : ℝ) (hδ : 0 < δ) (_ : δ ≤ 1)
      (_ : 1 ≤ a) (hab : a ≤ b) (_ : b ≤ 2) (hs : δ ≤ b-a) :
      ∃ J : Finset ℝ,IsIntervalCover (E ∩ Icc a b) δ J ∧
        (J.card:ℝ) ≤ 4*((b-a)/δ)^(1:ℝ) := by
    obtain ⟨J,hJ,hcard⟩ := exists_intervalCover_of_subset_Icc
      (F := E ∩ Icc a b) hδ hab inter_subset_right
    have hratio : 1 ≤ (b-a)/δ := (le_div_iff₀ hδ).mpr (by simpa using hs)
    have hceil := (Nat.ceil_lt_add_one (show 0 ≤ (b-a)/δ by positivity)).le
    refine ⟨J,hJ,?_⟩
    rw [Real.rpow_one]
    linarith
  apply (hb E hE 4 1 (-1) (by norm_num) (by norm_num) hcover j k hk hkj f).trans_eq
  rw [dyadic_cover_factor j k 4 1 (by norm_num)]
  have he : (2:ENNReal)^(k:ℝ) *
      (2:ENNReal)^((j:ℝ)-k+1)*(2:ENNReal)^(-(j:ℝ)) = 2 := by
    rw [← ENNReal.rpow_add _ _ (by norm_num : (2:ENNReal) ≠ 0)
      (by norm_num : (2:ENNReal) ≠ ⊤),
      ← ENNReal.rpow_add _ _ (by norm_num : (2:ENNReal) ≠ 0)
      (by norm_num : (2:ENNReal) ≠ ⊤)]
    convert ENNReal.rpow_one (2:ENNReal) using 1
    congr 1
    ring
  norm_num only [neg_neg,mul_neg,neg_mul,neg_one_mul,mul_one,ENNReal.rpow_one,
    ENNReal.ofReal_ofNat] at *
  calc
    _ = (12*A)*((2:ENNReal)^(k:ℝ)*
        (2:ENNReal)^((j:ℝ)-k+1)*(2:ENNReal)^(-(j:ℝ)))*
          (∫⁻ x,‖f x‖ₑ^(2:ℝ)) := by ring
    _ = _ := by rw [he]; ring
/-- True spatial dilation and thin input shells pass a normalized-window
fourth-moment gain to the full weighted planar output shell. -/
theorem synthesis_planar_shell_four_of_normalized_windows
    (φ : SchwartzMap (Euclidean 2) ℂ)
    (hφ : ∀ x, (1 : ℝ) / 8 < ‖x‖ → φ x = 0)
    (C δ : ℝ) (hC : 0 ≤ C)
    (hNorm : ∀ (k n : ℕ), 7 ≤ k → ∀ a ∈ Icc (1 : ℝ) 2,
      ∀ g : SchwartzMap (Euclidean 2) ℂ,
      (∫⁻ X in closedBall (0:Euclidean 2) 1,(⨆ s : Icc (-1:ℝ) 1,
        ‖sphericalAverage 2 (compactConvolution (compactSynthesisKernel φ (k+n)) g)
          (a+(((2:ℝ)^k)⁻¹)*s) ((((2:ℝ)^k)⁻¹) • X)‖ₑ)^(4:ℝ)) ≤
        ENNReal.ofReal (C/(((2:ℝ)^k)⁻¹))*(2:ENNReal)^(-δ*(n:ℝ))*
          (∫⁻ x,‖g x‖ₑ^(4:ℝ))) :
    ∀ (k n : ℕ),7 ≤ k → ∀ (E : Set ℝ),E ⊆ Icc 1 2 →
      ∀ f : SchwartzMap (Euclidean 2) ℂ,
      (∫⁻ x in euclideanAnnulus 2 ((((2:ℝ)^k)⁻¹)/2) (((2:ℝ)^k)⁻¹),
        (⨆ t : E,‖sphericalAverage 2
          (compactConvolution (compactSynthesisKernel φ (k+n)) f) t x‖ₑ)^(4:ℝ)
          ∂powerWeightedVolume 2 (-1)) ≤
        ENNReal.ofReal (24*C)*(2:ENNReal)^(-δ*(n:ℝ))*
          (∫⁻ x,‖f x‖ₑ^(4:ℝ)) := by
  classical
  intro k n hk E hE f
  let R : ℝ := ((2:ℝ)^k)⁻¹
  let K := compactSynthesisKernel φ (k+n)
  let D : ENNReal := (2:ENNReal)^(-δ*(n:ℝ))
  have hR : 0 < R := by dsimp only [R]; positivity
  have hsmall : R ≤ 1/16 := by
    have hh := one_div_le_one_div_of_le (by norm_num : (0:ℝ) < 2^4)
      (pow_le_pow_right₀ (by norm_num : (1:ℝ) ≤ 2) (show 4 ≤ k by omega))
    norm_num only [one_div] at hh
    exact hh
  have hK : ∀ y,R/2 < ‖y‖ → K y = 0 :=
    synthesis_highFrequency_support φ hφ (by omega) (by omega)
  obtain ⟨I,hI,hgrid⟩ := dyadic_radius_grid_cover k
  let W : ℤ → Set ℝ := fun m => {t | |t-(m:ℝ)*R| ≤ R/2}
  have hex (m : ℤ) : ∃ g : SchwartzMap (Euclidean 2) ℂ,m ∈ I →
      (∀ y,‖g y‖ ≤ ‖f y‖) ∧
      (∀ y,3*R ≤ |‖y‖-(m:ℝ)*R| → g y = 0) ∧
      (∀ t,0 ≤ t → t ∈ W m → ∀ x,‖x‖ ≤ R →
        sphericalAverage 2 (compactConvolution K f) t x =
          sphericalAverage 2 (compactConvolution K g) t x) := by
    by_cases hm : m ∈ I
    · obtain ⟨g,hg⟩ := exists_schwartz_shell_localization K f (hI m hm).1 hR hsmall hK
      exact ⟨g,fun _ => hg⟩
    · exact ⟨0,fun h => (hm h).elim⟩
  choose g hg using hex
  have hlocal (m : ℤ) (hm : m ∈ I) :
      (∫⁻ x in closedBall (0:Euclidean 2) R,
        (⨆ t : (E ∩ W m : Set ℝ),
          ‖sphericalAverage 2 (compactConvolution K (g m)) t x‖ₑ)^(4:ℝ)) ≤
        (ENNReal.ofReal C*ENNReal.ofReal R*D)*(∫⁻ x,‖g m x‖ₑ^(4:ℝ)) := by
    let G : Euclidean 2 → ENNReal := (closedBall (0:Euclidean 2) 1).indicator (fun X =>
      (⨆ s : Icc (-1:ℝ) 1,‖sphericalAverage 2 (compactConvolution K (g m))
        ((m:ℝ)*R+R*s) (R • X)‖ₑ)^(4:ℝ))
    have hp (x : Euclidean 2) (hxR : x ∈ closedBall (0:Euclidean 2) R) :
        (⨆ t : (E ∩ W m : Set ℝ),
          ‖sphericalAverage 2 (compactConvolution K (g m)) t x‖ₑ)^(4:ℝ) ≤ G (R⁻¹ • x) := by
      have hxn : ‖x‖ ≤ R := by simpa only [mem_closedBall,dist_zero_right] using hxR
      have hxb : R⁻¹ • x ∈ closedBall (0:Euclidean 2) 1 := by
        simp only [mem_closedBall,dist_zero_right,norm_smul,Real.norm_eq_abs,abs_inv,abs_of_pos hR]
        exact (mul_le_mul_of_nonneg_left hxn (inv_nonneg.mpr hR.le)).trans_eq
          (inv_mul_cancel₀ hR.ne')
      dsimp only [G]
      rw [Set.indicator_of_mem hxb]
      apply ENNReal.rpow_le_rpow _ (by norm_num : (0:ℝ) ≤ 4)
      apply iSup_le
      intro t
      have ht := abs_le.mp (show |(t:ℝ)-(m:ℝ)*R| ≤ R/2 from t.property.2)
      have hs : ((t:ℝ)-(m:ℝ)*R)/R ∈ Icc (-1:ℝ) 1 := by
        constructor
        · apply (le_div_iff₀ hR).mpr
          linarith
        · apply (div_le_iff₀ hR).mpr
          linarith
      have he : (m:ℝ)*R+R*(((t:ℝ)-(m:ℝ)*R)/R) = t := by field_simp [hR.ne']; ring
      have hx : R • (R⁻¹ • x) = x := by rw [smul_smul,mul_inv_cancel₀ hR.ne',one_smul]
      have hh := le_iSup (fun s : Icc (-1:ℝ) 1 =>
        ‖sphericalAverage 2 (compactConvolution K (g m)) ((m:ℝ)*R+R*s)
          (R • (R⁻¹ • x))‖ₑ) ⟨_,hs⟩
      simpa only [he,hx] using hh
    have hcomp : (∫⁻ x in closedBall (0:Euclidean 2) R,
        (⨆ t : (E ∩ W m : Set ℝ),
          ‖sphericalAverage 2 (compactConvolution K (g m)) t x‖ₑ)^(4:ℝ)) ≤
        ∫⁻ x : Euclidean 2,G (R⁻¹ • x) := by
      apply (lintegral_mono_ae ?_).trans (lintegral_mono' Measure.restrict_le_self le_rfl)
      filter_upwards [ae_restrict_mem measurableSet_closedBall] with x hx
      exact hp x hx
    apply hcomp.trans
    rw [Auto.Spherical.MSS.sourcePacket_spatial_inverse_dilation_lintegral R hR G]
    have hG : (∫⁻ X : Euclidean 2,G X) =
        ∫⁻ X in closedBall (0:Euclidean 2) 1,(⨆ s : Icc (-1:ℝ) 1,
          ‖sphericalAverage 2 (compactConvolution K (g m)) ((m:ℝ)*R+R*s) (R • X)‖ₑ)^(4:ℝ) :=
      lintegral_indicator measurableSet_closedBall _
    rw [hG]
    apply (mul_le_mul' le_rfl (hNorm k n hk ((m:ℝ)*R) (hI m hm) (g m))).trans_eq
    have he : ENNReal.ofReal (R^2)*ENNReal.ofReal (C/R) =
        ENNReal.ofReal C*ENNReal.ofReal R := by
      rw [← ENNReal.ofReal_mul (sq_nonneg R),← ENNReal.ofReal_mul hC]
      congr 1
      field_simp [hR.ne']
    change ENNReal.ofReal (R^2)*(ENNReal.ofReal (C/R)*D*
      (∫⁻ x,‖g m x‖ₑ^(4:ℝ))) = _
    rw [← mul_assoc,← mul_assoc,he]
  have hsum := thin_shell_sum_moments_le I hR (by norm_num : (0:ℝ) < 4) f g
    (fun m hm => (hg m hm).1) (fun m hm => (hg m hm).2.1)
  have hreassemble := spherical_radius_window_reassembly I E W (closedBall (0:Euclidean 2) R)
    measurableSet_closedBall (compactConvolution K f) (fun m => compactConvolution K (g m))
    (by norm_num : (0:ℝ) < 4) (fun t ht => hgrid t (hE ht))
    (fun m hm t ht x hx => (hg m hm).2.2 t (by linarith [(hE ht.1).1]) ht.2 x
      (by simpa only [mem_closedBall,dist_zero_right] using hx))
  have hball : (∫⁻ x in closedBall (0:Euclidean 2) R,
      (⨆ t : E,‖sphericalAverage 2 (compactConvolution K f) t x‖ₑ)^(4:ℝ)) ≤
      (ENNReal.ofReal C*ENNReal.ofReal R*D)*(8*(∫⁻ x,‖f x‖ₑ^(4:ℝ))) := by
    apply hreassemble.trans
    calc
      _ ≤ ∑ m ∈ I,(ENNReal.ofReal C*ENNReal.ofReal R*D)*(∫⁻ x,‖g m x‖ₑ^(4:ℝ)) :=
        Finset.sum_le_sum hlocal
      _ = (ENNReal.ofReal C*ENNReal.ofReal R*D)*∑ m ∈ I,(∫⁻ x,‖g m x‖ₑ^(4:ℝ)) :=
        (Finset.mul_sum ..).symm
      _ ≤ _ := mul_le_mul' le_rfl hsum
  have hw := dyadic_annulus_weight_moment_le
    (fun x => (⨆ t : E,‖sphericalAverage 2 (compactConvolution K f) t x‖ₑ)^(4:ℝ))
    ((measurable_schwartz_radius_supremum (compactConvolution K f) E).pow_const 4) (-1) k
  have hscale : (2:ENNReal)^(k:ℝ)*ENNReal.ofReal R = 1 := by
    dsimp only [R]
    rw [ENNReal.rpow_natCast,ENNReal.ofReal_inv_of_pos (by positivity),
      ENNReal.ofReal_pow (by norm_num : (0:ℝ) ≤ 2)]
    norm_num only [ENNReal.ofReal_ofNat]
    exact ENNReal.mul_inv_cancel (by positivity) (by finiteness)
  apply (hw.trans (mul_le_mul' le_rfl hball)).trans_eq
  norm_num only [neg_neg,mul_neg,neg_mul,neg_one_mul,mul_one,ENNReal.rpow_one]
  rw [ENNReal.ofReal_mul (by norm_num : (0:ℝ) ≤ 24)]
  norm_num only [ENNReal.ofReal_ofNat]
  calc
    _ = (24*ENNReal.ofReal C)*((2:ENNReal)^(k:ℝ)*ENNReal.ofReal R)*D*
        (∫⁻ x,‖f x‖ₑ^(4:ℝ)) := by ring
    _ = _ := by rw [hscale]; dsimp only [D]; ring_nf

theorem finite_constant_le_fourth (A : ENNReal) (hA : A ≠ ⊤) :
    ∃ B : Real, 0 < B ∧ A ≤ ENNReal.ofReal B^(4:Real) := by
  let B : Real := A.toReal+1
  have hB : 1 ≤ B := by
    have hpos : 0 ≤ A.toReal := ENNReal.toReal_nonneg
    dsimp [B]
    linarith
  refine ⟨B,by linarith,?_⟩
  rw [ENNReal.rpow_ofNat,← ENNReal.ofReal_pow (by linarith : 0 ≤ B),
    ← ENNReal.ofReal_toReal hA]
  apply ENNReal.ofReal_le_ofReal
  calc
    A.toReal ≤ B := by dsimp [B]; linarith
    _ ≤ B^4 := by
      have hh := mul_le_mul_of_nonneg_left
        (show (1 : Real) ≤ B^(3 : Nat) from one_le_pow₀ hB) (by linarith : 0 ≤ B)
      simpa only [pow_succ,pow_zero,mul_one,one_mul,mul_comm] using hh

/-- The independent repair's scalar fourth-moment gain suffices for the
weighted local planar core. All synthesis and maximal operators are literal. -/
theorem planar_local_core_of_synthesis_shell_four_gain {N : Nat}
    (φ : SchwartzMap (Euclidean 2) Complex) (hmass : ∫ x, φ x = 1)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean 2))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : (1 : Real) / 2 ≤ N) (hφ : ∀ x, (1 : Real) / 8 < ‖x‖ → φ x = 0)
    {p σ B₄ : Real} (hp₂ : 2 < p) (hp₄ : p < 4) (hσ : 0 < σ) (hB₄ : 0 < B₄)
    (k₀ : Nat) (hk₀ : 4 ≤ k₀)
    (hFour : ∀ k : Nat,k₀ ≤ k → ∀ n : Nat,∀ g : SchwartzMap (Euclidean 2) Complex,
      (∫⁻ x in euclideanAnnulus 2 ((((2:Real)^k)⁻¹)/2) (((2:Real)^k)⁻¹),
        (⨆ t : Icc (1:Real) 2,‖sphericalAverage 2
          (compactConvolution (compactSynthesisKernel φ (k+n)) g) t x‖ₑ)^(4:Real)
            ∂powerWeightedVolume 2 (-1)) ≤
        ENNReal.ofReal B₄^(4:Real)*ENNReal.ofReal ((2:Real)^n)^(-(4*σ))*
          ∫⁻ x,‖g x‖ₑ^(4:Real)) :
    ∃ B : Real,0 ≤ B ∧ SchwartzCoreMomentBound
      (powerWeightedVolume 2 (1-(2:Real))) (Icc (1:Real) 2) p B := by
  obtain ⟨A₂,hA₂,hTwo⟩ := synthesis_planar_shell_two_bound φ hflat hN hφ
  obtain ⟨P,hP,hPiece⟩ := resolution_piece_moment_of_scalar_shells_ge_two
    (by norm_num : 0 < 2) φ hp₂.le
  let C : ENNReal := Auto.Spherical.MSS.schwartzTwoFourMomentConstant p A₂*
    ENNReal.ofReal B₄^(2*p-4)
  have hC : C ≠ ⊤ := ENNReal.mul_ne_top
    (Auto.Spherical.MSS.schwartzTwoFourMomentConstant_ne_top hp₂ hp₄ hA₂)
    (ENNReal.rpow_ne_top_of_nonneg (by linarith) ENNReal.ofReal_ne_top)
  let r : ENNReal := 2^(-(2*σ*(p-2)/p))
  have hr : r < 1 := ENNReal.rpow_lt_one_of_one_lt_of_neg (by norm_num)
    (neg_neg_of_pos (div_pos (mul_pos (mul_pos (by norm_num) hσ)
      (by linarith)) (by linarith)))
  have hScale (n : Nat) :
      ENNReal.ofReal ((2:Real)^n)^(-(2*σ*(p-2))) = (r^n)^p := by
    rw [ENNReal.ofReal_pow (by norm_num : (0:Real) ≤ 2),ENNReal.ofReal_ofNat]
    dsimp only [r]
    simp only [← ENNReal.rpow_natCast,← ENNReal.rpow_mul]
    congr 1
    field_simp
  let W := powerWeightedVolume 2 (1-(2:Real))
  let : IsFiniteMeasureOnCompacts W :=
    powerWeightedVolume_isFiniteMeasureOnCompacts (by norm_num) (by norm_num)
  have hHigh (ν : Measure (Euclidean 2)) (hν : ν ≤ W)
      (E : Set Real) (hE : E ⊆ Icc 1 2) (L : Finset Nat) (hL : ∀ k ∈ L,k₀ ≤ k)
      (n : Nat) (f : SchwartzMap (Euclidean 2) Complex)
      (hfi : ∀ x,‖x‖ < 1/8 → f x = 0) (hfo : ∀ x,8 < ‖x‖ → f x = 0) :
      (∫⁻ x,(⨆ t : E,‖localizedResolutionPiece φ L (fun k => k+n) f t x‖ₑ)^p ∂ν) ≤
        (r^n)^p*(C*P*∫⁻ x,‖f x‖ₑ^p ∂W) := by
    have hScalar (k : Nat) (hk : k ∈ L) (g : SchwartzMap (Euclidean 2) Complex) :
        (∫⁻ x in dyadicSpatialShell 2 (-(k:Int)-1),
          (⨆ t : E,‖sphericalAverage 2
            (compactConvolution (compactSynthesisKernel φ (k+n)) g) t x‖ₑ)^p ∂ν) ≤
          ((r^n)^p*C)*∫⁻ x,‖g x‖ₑ^p := by
      have hTwo' (g : SchwartzMap (Euclidean 2) Complex) :
          (∫⁻ x in dyadicSpatialShell 2 (-(k:Int)-1),
            (⨆ t : Icc (1:Real) 2,‖sphericalAverage 2
              (compactConvolution (compactSynthesisKernel φ (k+n)) g) t x‖ₑ)^(2:Real) ∂W) ≤
            A₂*∫⁻ x,‖g x‖ₑ^(2:Real) := by
        apply (lintegral_mono_set (negative_dyadicSpatialShell_subset_annulus 2 k)).trans
        simpa only [W,show 1-(2:Real) = -1 by norm_num] using
          hTwo (Icc 1 2) Subset.rfl (k+n) k (hk₀.trans (hL k hk)) (by omega) g
      have hFour' (g : SchwartzMap (Euclidean 2) Complex) :
          (∫⁻ x in dyadicSpatialShell 2 (-(k:Int)-1),
            (⨆ t : Icc (1:Real) 2,‖sphericalAverage 2
              (compactConvolution (compactSynthesisKernel φ (k+n)) g) t x‖ₑ)^(4:Real) ∂W) ≤
            ENNReal.ofReal B₄^(4:Real)*ENNReal.ofReal ((2:Real)^n)^(-(4*σ))*
              ∫⁻ x,‖g x‖ₑ^(4:Real) := by
        apply (lintegral_mono_set (negative_dyadicSpatialShell_subset_annulus 2 k)).trans
        simpa only [W,show 1-(2:Real) = -1 by norm_num] using hFour k (hL k hk) n g
      have hh := compact_synthesis_two_four_shell_gain (compactSynthesisKernel φ (k+n))
        (W.restrict (dyadicSpatialShell 2 (-(k:Int)-1))) hp₂ hp₄ A₂ hB₄
        (by positivity : (0:Real) < 2^n) hσ hTwo' hFour' g
      apply (lintegral_mono' (Measure.restrict_mono_measure hν _) (fun x =>
        ENNReal.rpow_le_rpow (iSup_le (fun t : E =>
          le_iSup (fun s : Icc (1:Real) 2 => ‖sphericalAverage 2
            (compactConvolution (compactSynthesisKernel φ (k+n)) g) s x‖ₑ)
            ⟨t.1,hE t.2⟩)) (by linarith : 0 ≤ p))).trans
      rw [hScale] at hh
      simpa only [C,mul_assoc,mul_comm,mul_left_comm] using hh
    have hh := hPiece ν E L (fun k => k+n)
      (fun _ _ _ _ hij => Nat.add_right_cancel hij) f hfi hfo ((r^n)^p*C) hScalar
    simpa only [W,Nat.cast_ofNat,mul_assoc] using hh
  obtain ⟨D,hD,hResolution⟩ := localized_resolution_moment_bound_ge_two (by norm_num)
    φ hmass hp₂.le k₀ r (C*P) hr (by finiteness) hHigh
  obtain ⟨U,hU⟩ := unweighted_bound_of_uniformAssouadDimension (p := p) (by norm_num : 2 ≤ 2)
    (show (Icc (1:Real) 2).Nonempty from ⟨1,by norm_num⟩)
    (fun t ht => lt_of_lt_of_le zero_lt_one ht.1)
    (by
      norm_num only [Nat.cast_ofNat,show (2:Real)-1 = 1 by norm_num,div_one]
      linarith [uniformAssouadDimension_le_one (Icc (1:Real) 2)])
  obtain ⟨B,hB,hCore⟩ := uniform_core_moment_bound_of_inner_ball (by norm_num : 2 ≤ 2)
    (by linarith : 1 < p) (by positivity : (0:Real) < 2^(-(k₀:Int))) U D hD (by
      intro E hE _ g hfi hfo
      apply inner_ball_moment_of_finite_shells_from (by norm_num) k₀ _ le_rfl E g
        (by linarith : 0 < p)
      intro L hL
      exact hResolution _ le_rfl E hE L hL g hfi hfo)
  exact ⟨B,hB,hCore (Icc 1 2) Subset.rfl hU⟩

/-- The proved local planar weighted core gives the all-radius bound by the
existing dilation and global-to-local theorem. -/
theorem planar_global_strongType_of_local_core {p B : Real} (hp : 2 < p)
    (hCore : SchwartzCoreMomentBound (powerWeightedVolume 2 (1 - (2 : Real)))
      (Icc (1 : Real) 2) p B) :
    HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType 2 (Ioi (0:Real))
      p (1-(2:Real)) := by
  obtain ⟨C,_,hC⟩ := uniform_normalized_bound_of_core (d := 2) (by norm_num)
    (by linarith : 1 < p) B
  apply hasRestrNormdSphMaxPowerWeightStrongType_of_unif_normd_local_and_unweighted
    (C := C) (by norm_num) (Ioi (0:Real)) (by linarith : 1 ≤ p) (by norm_num)
    (hasRestrNormdSphMaxPowerWeightStrongType_zero_plan_of_bourgain_of_subset_Ioi
      (Ioi (0:Real)) Subset.rfl hp)
  intro R hR f _
  apply hC (normalizedRadiusBlock (Ioi (0:Real)) R) ?_ f
  intro g
  apply (lintegral_mono (fun x => ENNReal.rpow_le_rpow ?_ (by linarith : 0 ≤ p))).trans
    (hCore g)
  apply iSup_le
  intro t
  exact le_iSup (fun s : Icc (1:Real) 2 => ‖sphericalAverage 2 g s x‖ₑ)
    ⟨t.1,normalizedRadiusBlock_subset_Icc_one_two hR t.2⟩

/-- Exact physical rescaling of compact synthesis, before any normalized
incidence coordinates or frequency estimate is inserted. -/
theorem sphericalAverage_compactSynthesis_physical_rescaled
    (φ f : SchwartzMap (Euclidean 2) Complex) (k n : Nat)
    (a s : Real) (X : Euclidean 2) :
    sphericalAverage 2 (compactConvolution (compactSynthesisKernel φ (k+n)) f)
      (a+((2:Real)^k)⁻¹*s) (((2:Real)^k)⁻¹ • X) =
      ∫ Y : Euclidean 2,rescaledCompactSynthesisKernel φ k n Y*
        sphericalAverage 2 f (a+((2:Real)^k)⁻¹*s)
          (((2:Real)^k)⁻¹ • (X-Y)) := by
  let r : Real := ((2:Real)^k)⁻¹
  let t : Real := a+r*s
  let K := compactSynthesisKernel φ (k+n)
  let H : Euclidean 2 → Complex := fun z => K z*sphericalAverage 2 f t (r•X-z)
  have hr : 0 < r := by dsimp [r];positivity
  have hav : sphericalAverage 2 (compactConvolution K f) t (r•X) =
      compactConvolution K (schwartzSphericalAverage f t) (r•X) := by
    simpa only [schwartzSphericalAverage_apply] using
      congrArg (fun g : SchwartzMap (Euclidean 2) Complex => g (r•X))
        (schwartzSphericalAverage_compactConvolution K f t)
  have hscale : (∫ Y : Euclidean 2,(r^2:Real) • H (r•Y)) = ∫ z,H z := by
    rw [integral_smul,Measure.integral_comp_smul_of_nonneg volume H r (hR := hr.le)]
    simp [hr.ne']
  change sphericalAverage 2 (compactConvolution K f) t (r•X) = _
  rw [hav,compactConvolution,SchwartzMap.convolution_apply]
  simp_rw [schwartzSphericalAverage_apply]
  change (∫ z : Euclidean 2,H z) = _
  simpa only [H,rescaledCompactSynthesisKernel_apply,K,r,smul_sub,smul_mul_assoc] using hscale.symm

set_option maxHeartbeats 2000000 in
-- The kernel reconstruction and weighted rescaling require a larger elaboration budget.
open Auto.Spherical.MSS Auto.LittlewoodPaley in
/-- Repair Proposition 3.1 at four: the literal compact synthesis has
positive decay at the relative scale 2^(j-k), uniformly in the shell. -/
theorem exists_synthesis_planar_shell_four_gain
    (φ : SchwartzMap (Euclidean 2) Complex) (hmass : ∫ x, φ x = 1)
    (hφ : ∀ x, (1 : Real) / 8 < ‖x‖ → φ x = 0) :
    ∃ D : Real,0 ≤ D ∧ ∀ k n : Nat,7 ≤ k → ∀ E : Set Real,E ⊆ Icc 1 2 →
      ∀ g : SchwartzMap (Euclidean 2) Complex,
      (∫⁻ x in euclideanAnnulus 2 ((((2:Real)^k)⁻¹)/2) (((2:Real)^k)⁻¹),
        (⨆ t : E,‖sphericalAverage 2
          (compactConvolution (compactSynthesisKernel φ (k+n)) g) t x‖ₑ)^(4:Real)
          ∂powerWeightedVolume 2 (-1)) ≤
        ENNReal.ofReal D*(2:ENNReal)^(-(n:Real)/16)*∫⁻ x,‖g x‖ₑ^(4:Real) := by
  obtain ⟨C⟩ := exists_lpCutoffs 2
  have hz : mssSpatialLPFatAnnular C 0 = 0 := by
    simp [mssSpatialLPFatAnnular,dyadicLowpassMultiplier_apply,mssTranslatedDilatedCutoff_apply]
  obtain ⟨Cb,hCb,hBand⟩ := rescaledCompactSynthesis_annular_frequency_L1_tail
    φ (mssSpatialLPFatAnnular C) hmass hz
  obtain ⟨Cl,hCl,hLow⟩ := rescaledCompactSynthesis_lowpass_frequency_L1_tail
    φ (mssSpatialLPFatLowpass C) hmass
  obtain ⟨chiOut,_,hOne,_,D,hD,hGain⟩ :=
    exists_normalizedCirclePhysicalCompactKernel_timeMax_gain_real_tails C (Cb+Cl) (by linarith)
  have hNorm : ∀ k n : Nat,7 ≤ k → ∀ a ∈ Icc (1:Real) 2,
      ∀ g : SchwartzMap (Euclidean 2) Complex,
      (∫⁻ X in Metric.closedBall (0:Euclidean 2) 1,(⨆ s : Icc (-1:Real) 1,
        ‖sphericalAverage 2 (compactConvolution (compactSynthesisKernel φ (k+n)) g)
          (a+((2:Real)^k)⁻¹*s) (((2:Real)^k)⁻¹ • X)‖ₑ)^(4:Real)) ≤
        ENNReal.ofReal (D/((2:Real)^k)⁻¹)*(2:ENNReal)^(-(1/16:Real)*(n:Real))*
          ∫⁻ x,‖g x‖ₑ^(4:Real) := by
    intro k n hk a ha g
    let K := rescaledCompactSynthesisKernel φ k n
    let r : Real := ((2:Real)^k)⁻¹
    let M : SchwartzMap (Euclidean 2) Complex := 𝓕 K
    have hProd (η : SchwartzMap (Euclidean 2) Complex) :
        ((SchwartzMap.smulLeftCLM Complex (M : Euclidean 2 → Complex) η) :
          Euclidean 2 → Complex) = fun ξ => M ξ*η ξ := by
      funext ξ
      rw [SchwartzMap.smulLeftCLM_apply_apply M.hasTemperateGrowth,smul_eq_mul]
    have hr : 0 < r := by dsimp [r];positivity
    have hrs : r ≤ 1/128 := by
      have hh := one_div_le_one_div_of_le (by norm_num : (0:Real) < 2^7)
        (pow_le_pow_right₀ (by norm_num : (1:Real) ≤ 2) hk)
      norm_num only [one_div] at hh
      exact hh
    have hklow : (∫ Y : Euclidean 2,‖(FourierTransform.fourierInv
        (SchwartzMap.smulLeftCLM Complex (M : Euclidean 2 → Complex)
          (mssSpatialLPFatLowpass C)) : SchwartzMap (Euclidean 2) Complex) Y‖) ≤
        (Cb+Cl)*((2:Real)^n)⁻¹ := by
      apply (show _ ≤ Cl*((2:Real)^n)⁻¹ from by
        rw [SchwartzMap.fourierInv_coe,hProd]
        simpa only [M,K] using hLow k (by omega) n).trans
      exact mul_le_mul_of_nonneg_right (by linarith) (by positivity)
    have hkband (m : Nat) : (∫ Y : Euclidean 2,‖(FourierTransform.fourierInv
        (SchwartzMap.smulLeftCLM Complex (M : Euclidean 2 → Complex)
          (dyadicLowpassMultiplier (mssSpatialLPFatAnnular C) m)) :
            SchwartzMap (Euclidean 2) Complex) Y‖) ≤
        (Cb+Cl)*(2:Real)^(-|(m:Real)-n|) := by
      apply (show _ ≤ Cb*(2:Real)^(-|(m:Real)-n|) from by
        rw [SchwartzMap.fourierInv_coe,hProd]
        simpa only [M,dyadicLowpassMultiplier_apply,K] using hBand k (by omega) n m).trans
      exact mul_le_mul_of_nonneg_right (by linarith) (by positivity)
    have hh := hGain a r ha.1 hr hrs g n (𝓕 K) hklow hkband
    rw [FourierTransform.fourierInv_fourier_eq] at hh
    have heq (X : Euclidean 2) (hX : X ∈ Metric.closedBall (0:Euclidean 2) 1)
        (s : Icc (-1:Real) 1) :
        sphericalAverage 2 (compactConvolution (compactSynthesisKernel φ (k+n)) g)
          (a+r*s) (r•X) =
        ∫ Y : Euclidean 2,K Y*chiOut (X-Y,s.1)*
          sphericalAverage 2 g (a+r*s) (r•(X-Y)) := by
      rw [sphericalAverage_compactSynthesis_physical_rescaled]
      apply integral_congr_ae
      filter_upwards with Y
      by_cases hzero : K Y = 0
      · simp only [show rescaledCompactSynthesisKernel φ k n Y = K Y from rfl,hzero,zero_mul]
      · have hY : ‖Y‖ ≤ 1/2 := le_of_not_gt (fun hY =>
          hzero (rescaledCompactSynthesisKernel_support φ hφ (by omega) n Y hY))
        have hXn : ‖X‖ ≤ 1 := by simpa only
          [Metric.mem_closedBall,dist_zero_right] using hX
        rw [hOne (X-Y,s.1) (by dsimp;linarith [norm_sub_le X Y]) (abs_le.mpr s.2),mul_one]
    calc
      _ = ∫⁻ X in Metric.closedBall (0:Euclidean 2) 1,⨆ s : Icc (-1:Real) 1,
          ENNReal.ofReal (‖∫ Y : Euclidean 2,K Y*chiOut (X-Y,s.1)*
            sphericalAverage 2 g (a+r*s.1) (r•(X-Y))‖^4) := by
        simp only [ENNReal.rpow_ofNat,ENNReal.iSup_pow_of_ne_zero (by norm_num : (4:Nat) ≠ 0)]
        apply lintegral_congr_ae
        filter_upwards [ae_restrict_mem measurableSet_closedBall] with X hX
        apply iSup_congr
        intro s
        rw [heq X hX s]
        rw [ENNReal.ofReal_pow (norm_nonneg _),ofReal_norm]
      _ ≤ _ := (setLIntegral_le_lintegral _ _).trans hh
        |>.trans_eq (by
          simp only [ENNReal.rpow_ofNat,r,show -(1/16:Real)*(n:Real) = -(n:Real)/16 by ring])
  refine ⟨24*D,by positivity,?_⟩
  intro k n hk E hE g
  simpa only [show -(1/16:Real)*(n:Real) = -(n:Real)/16 by ring] using
    synthesis_planar_shell_four_of_normalized_windows φ hφ D (1/16) hD.le hNorm k n hk E hE g

/-- Independent repair, Sections 7--8: the full planar maximal operator
has the endpoint weight |x|^(-1) for every p>2. -/
theorem planar_spherical_maximal_endpoint {p : Real} (hp : 2 < p) :
    HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType
      2 (Ioi (0:Real)) p (1-(2:Real)) := by
  obtain ⟨q,hq,hqu⟩ := exists_between (lt_min hp (by norm_num : (2:Real) < 4))
  have hq4 : q < 4 := lt_of_lt_of_le hqu (min_le_right _ _)
  have hqp : q < p := lt_of_lt_of_le hqu (min_le_left _ _)
  obtain ⟨φ,_,hmass,hsupp,_,hflat⟩ :=
    exists_compact_resolution_profile 2 1 (by norm_num)
  have hφ : ∀ x,(1:Real)/8 < ‖x‖ → φ x = 0 :=
    fun x hx => hsupp x (by linarith)
  obtain ⟨D,_,hFour⟩ := exists_synthesis_planar_shell_four_gain φ hmass hφ
  obtain ⟨B₄,hB₄,hDB⟩ :=
    finite_constant_le_fourth (ENNReal.ofReal D) ENNReal.ofReal_ne_top
  have hFour' := fun k n hk => hFour k n hk (Icc (1:Real) 2) Subset.rfl
  obtain ⟨B,_,hCore⟩ := planar_local_core_of_synthesis_shell_four_gain
    φ hmass hflat (by norm_num : (1:Real)/2 ≤ (1:Nat)) hφ
    hq hq4 (by norm_num : (0:Real) < 1/64) hB₄ 7 (by norm_num) (by
      intro k hk n g
      have hh := hFour' k n hk g
      have he : (2:ENNReal)^(-(n:Real)/16) =
          ENNReal.ofReal ((2:Real)^n)^(-(4*(1/64:Real))) := by
        rw [ENNReal.ofReal_pow (by norm_num),ENNReal.ofReal_ofNat,
          ← ENNReal.rpow_natCast,← ENNReal.rpow_mul]
        congr 1
        ring
      rw [he] at hh
      exact hh.trans (mul_le_mul' (mul_le_mul' hDB le_rfl) le_rfl))
  exact hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_of_strong_type_lt_integrable
    (by norm_num : 1 ≤ 2) (by norm_num : -(2:Real) < 1-(2:Real))
    (by linarith : 1 < q) hqp (planar_global_strongType_of_local_core hq hCore)

/-- Introduction, `thm:newfullga` (Theorem 1.2): for d≥2 and
p>1+γ/(d-1), the maximal operator over any positive dilation set of
uniform Assouad dimension γ is bounded on L^p(|x|^(1-d)).
The planar γ=1 case uses the independent repair, Sections 3--8. -/
theorem general_assouad_maximal_endpoint {d : ℕ} (hd : 2 ≤ d)
    {E : Set ℝ} (hEpos : E ⊆ Ioi (0 : ℝ)) {p : ℝ}
    (hp : 1 + uniformAssouadDimension E / ((d : ℝ) - 1) < p) :
    ∃ C : ℝ, 0 < C ∧ ∀ f : Euclidean d → ℂ,
      MemLp f (ENNReal.ofReal p) (powerWeightedVolume d (1 - (d : ℝ))) →
        MemLp (_root_.Spherical.M E f) (ENNReal.ofReal p)
          (powerWeightedVolume d (1 - (d : ℝ))) ∧
        eLpNorm (_root_.Spherical.M E f) (ENNReal.ofReal p)
          (powerWeightedVolume d (1 - (d : ℝ))) ≤ ENNReal.ofReal C *
        eLpNorm f (ENNReal.ofReal p) (powerWeightedVolume d (1 - (d : ℝ))) := by
  rcases eq_or_lt_of_le hd with h2 | h3
  · subst d
    by_cases hdim : uniformAssouadDimension E < 1
    · exact global_assouad_weighted_bound_of_dimension_lt (by norm_num) hEpos
        (by norm_num; exact hdim) hp
    · have heq : uniformAssouadDimension E = 1 :=
        le_antisymm (uniformAssouadDimension_le_one E) (le_of_not_gt hdim)
      have hp₂ : 2 < p := by norm_num [heq] at hp; exact hp
      exact weighted_bound_of_normalized_strongType (by norm_num) E
        (by linarith : 1 < p) (by norm_num : -(2:Real) < 1-(2:Real))
        (HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType.of_subset
          hEpos (planar_spherical_maximal_endpoint hp₂))
  · exact global_assouad_weighted_bound_three_le (by omega) hEpos hp

/-- Introduction, `thm:newfull` (Theorem 1.1): for `d ≥ 2` and
`p > d/(d-1)`, the full spherical maximal operator is bounded on
`L^p(|x|^(1-d))`. The estimate applies to every weighted `L^p` input. -/
theorem full_spherical_maximal_endpoint {d : ℕ} (hd : 2 ≤ d) {p : ℝ}
    (hp : (d : ℝ) / ((d : ℝ) - 1) < p) :
    ∃ C : ℝ, 0 < C ∧ ∀ f : Euclidean d → ℂ,
      MemLp f (ENNReal.ofReal p) (powerWeightedVolume d (1 - (d : ℝ))) →
        MemLp (_root_.Spherical.M (Ioi (0 : ℝ)) f) (ENNReal.ofReal p)
          (powerWeightedVolume d (1 - (d : ℝ))) ∧
        eLpNorm (_root_.Spherical.M (Ioi (0 : ℝ)) f) (ENNReal.ofReal p)
          (powerWeightedVolume d (1 - (d : ℝ))) ≤ ENNReal.ofReal C *
        eLpNorm f (ENNReal.ofReal p) (powerWeightedVolume d (1 - (d : ℝ))) := by
  apply general_assouad_maximal_endpoint hd (Subset.rfl) _
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hpos : 0 < (d : ℝ) - 1 := by linarith
  have hdim := div_le_div_of_nonneg_right
    (uniformAssouadDimension_le_one (Ioi (0 : ℝ))) hpos.le
  have heq : 1 + 1 / ((d : ℝ) - 1) = (d : ℝ) / ((d : ℝ) - 1) := by
    field_simp
    ring
