  · -- fine inputs
    apply (hfine s m a b hsm hm4 ha hab hb2 hlen h hout').trans
    have hms' : (s : ℝ) + 1 ≤ m := by exact_mod_cast hsm
    calc
      _ ≤ A₁ * (2 : ℝ≥0∞) ^ ((s : ℝ) * (p - 1) - (m : ℝ) * d * (p - 1)) *
