      _ ≤ _ := by
        gcongr
        calc
          A₂ = A₂ * 1 := (mul_one _).symm
          _ ≤ (A₁ + A₂) * (2 : ℝ≥0∞) ^ α := mul_le_mul' le_add_self h2α

/-- The radii of `E^μ` within `2^{-s}` of the accumulation point. -/
def sequenceLowTimes (μ : ℝ) (s : ℕ) : Set ℝ :=
  sequenceSet μ ∩ Icc 1 (1 + ((2 : ℝ) ^ s)⁻¹)

/-- The dyadic radius block `E^μ ∩ (1 + 2^{-J-1}, 1 + 2^{-J}]` (the source's
`I_l`, reindexed by the distance to `1`). -/
def sequenceBlock (μ : ℝ) (J : ℕ) : Set ℝ :=
  sequenceSet μ ∩ Ioc (1 + ((2 : ℝ) ^ (J + 1))⁻¹) (1 + ((2 : ℝ) ^ J)⁻¹)

theorem sequenceLowTimes_subset (μ : ℝ) (s : ℕ) : sequenceLowTimes μ s ⊆ sequenceSet μ :=
  inter_subset_left

theorem sequenceBlock_subset (μ : ℝ) (J : ℕ) : sequenceBlock μ J ⊆ sequenceSet μ :=
  inter_subset_left

/-- Every radius of `E^μ` lies either within `2^{-s}` of `1` or in a block
`J < s`. -/
theorem sequenceSet_low_or_block {μ : ℝ} (hμ : 0 ≤ μ) {t : ℝ} (ht : t ∈ sequenceSet μ)
    (s : ℕ) : t ∈ sequenceLowTimes μ s ∨ ∃ J, J < s ∧ t ∈ sequenceBlock μ J := by
  classical
  have htI := sequenceSet_subset_Icc hμ ht
  have hu : 0 < t - 1 := by
    obtain ⟨n, hn, rfl⟩ := ht
    have := (rpow_neg_mem_Ioc hμ hn).1
    linarith
  by_cases hlow : t ≤ 1 + ((2 : ℝ) ^ s)⁻¹
  · exact Or.inl ⟨ht, htI.1, hlow⟩
  · right
    push Not at hlow
    have hs : 0 < s := by
      rcases Nat.eq_zero_or_pos s with hs | hs
      · subst hs; simp only [pow_zero, inv_one] at hlow; linarith [htI.2]
      · exact hs
    have hwit : ((2 : ℝ) ^ (s - 1 + 1))⁻¹ < t - 1 := by
      rw [Nat.sub_add_cancel hs]; linarith
    have hex : ∃ J : ℕ, ((2 : ℝ) ^ (J + 1))⁻¹ < t - 1 := ⟨s - 1, hwit⟩
    let J := Nat.find hex
    have hJ : ((2 : ℝ) ^ (J + 1))⁻¹ < t - 1 := Nat.find_spec hex
    have hJs : J < s := by
      have : J ≤ s - 1 := Nat.find_min' hex hwit
      omega
    refine ⟨J, hJs, ht, by linarith, ?_⟩
    rcases Nat.eq_zero_or_pos J with hJ0 | hJ0
    · rw [hJ0]; simp only [pow_zero, inv_one]; linarith [htI.2]
    · have hnot := Nat.find_min hex (show J - 1 < J by omega)
      push Not at hnot
      rw [Nat.sub_add_cancel hJ0] at hnot
      linarith

/-- The block `J` contains at most `2^{(J+1)/μ}` radii. -/
theorem sequenceBlock_finite_cover {μ : ℝ} (hμ : 0 < μ) (J : ℕ) :
    ∃ F : Finset ℝ, sequenceBlock μ J ⊆ ↑F ∧ (∀ t ∈ F, t ∈ Icc (1 : ℝ) 2) ∧
      (F.card : ℝ) ≤ (2 : ℝ) ^ (((J : ℝ) + 1) / μ) := by
  classical
  set x : ℝ := (2 : ℝ) ^ (((J : ℝ) + 1) / μ)
  have hx : 0 ≤ x := by positivity
  refine ⟨(Finset.Icc 1 ⌊x⌋₊).image (fun n : ℕ => 1 + (n : ℝ) ^ (-μ)), ?_, ?_, ?_⟩
  · rintro t ⟨⟨n, hn, rfl⟩, hlo, _⟩
    simp only [Finset.coe_image, Finset.coe_Icc, Set.mem_image, Set.mem_Icc]
    refine ⟨n, ⟨hn, ?_⟩, rfl⟩
    apply Nat.le_floor
    have hn0 : (0 : ℝ) < n := by exact_mod_cast hn
    have h1 : ((2 : ℝ) ^ (J + 1))⁻¹ < (n : ℝ) ^ (-μ) := by linarith
    rw [Real.rpow_neg hn0.le, inv_lt_inv₀ (by positivity) (by positivity)] at h1
    have h2 := Real.rpow_lt_rpow (by positivity) h1 (show 0 < 1 / μ by positivity)
    rw [← Real.rpow_mul hn0.le, mul_one_div_cancel hμ.ne', Real.rpow_one, ← Real.rpow_natCast,
      ← Real.rpow_mul (by norm_num)] at h2
    convert h2.le using 2
    push_cast; ring
  · intro t ht
    obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp ht
    have hn1 := (Finset.mem_Icc.mp hn).1
    have h := rpow_neg_mem_Ioc hμ.le hn1
    exact ⟨by linarith [h.1], by linarith [h.2]⟩
  · calc
      _ ≤ ((Finset.Icc 1 ⌊x⌋₊).card : ℝ) := by exact_mod_cast Finset.card_image_le
      _ = ⌊x⌋₊ := by simp
      _ ≤ x := Nat.floor_le hx

/-- The block `J` is covered by at most `12 · 2^{s-J-1}` intervals of length
`2^{-s}` inside `[1,2]`, when `s ≥ J+1`. -/
theorem sequenceBlock_interval_cover {μ : ℝ} (hμ : 0 < μ) {J s : ℕ} (hJs : J + 1 ≤ s) :
    ∃ (I : Finset ℝ) (a b : ℝ → ℝ), (∀ i ∈ I, a i ≤ b i) ∧ (∀ i ∈ I, 1 ≤ a i) ∧
      (∀ i ∈ I, b i ≤ 2) ∧ (∀ i ∈ I, b i - a i ≤ ((2 : ℝ) ^ s)⁻¹) ∧
      (∀ t ∈ sequenceBlock μ J, ∃ i ∈ I, t ∈ Icc (a i) (b i)) ∧
      (I.card : ℝ≥0∞) ≤ 12 * (2 : ℝ≥0∞) ^ ((s : ℝ) - (J + 1)) := by
  set c : ℝ := 1 + 3 * ((2 : ℝ) ^ (J + 2))⁻¹
  obtain ⟨I, hI, hcard⟩ := sequenceSet_window_cover hμ hJs c
  have hsub : sequenceBlock μ J ⊆ sequenceSet μ ∩ {t | |t - c| ≤ (((2 : ℝ) ^ (J + 1))⁻¹) / 2} := by
    rintro t ⟨ht, hlo, hhi⟩
    refine ⟨ht, ?_⟩
    have e1 : ((2 : ℝ) ^ (J + 1))⁻¹ = 2 * ((2 : ℝ) ^ (J + 2))⁻¹ := by
      rw [pow_succ 2 (J + 1)]; field_simp
    have e2 : ((2 : ℝ) ^ J)⁻¹ = 4 * ((2 : ℝ) ^ (J + 2))⁻¹ := by
      rw [pow_succ 2 (J + 1), pow_succ 2 J]; field_simp; ring
    change |t - c| ≤ _
    rw [abs_le, e1]
    constructor <;> dsimp only [c] <;> linarith
  have hE : sequenceBlock μ J ⊆ Icc 1 2 := (sequenceBlock_subset μ J).trans
    (sequenceSet_subset_Icc hμ.le)
  have hcov : IsIntervalCover (sequenceBlock μ J) (((2 : ℝ) ^ s)⁻¹) I := fun t ht => hI (hsub ht)
  obtain ⟨I', hcard', hab, hJ, hcover, hlen⟩ := intervalCover_clip hE hcov
  refine ⟨I', fun i => max 1 (i - ((2 : ℝ) ^ s)⁻¹ / 2), fun i => min 2 (i + ((2 : ℝ) ^ s)⁻¹ / 2),
    hab, fun i _ => le_max_left _ _, fun i _ => min_le_left _ _, hlen, hcover, ?_⟩
  calc
    (I'.card : ℝ≥0∞) ≤ I.card := by exact_mod_cast hcard'
    _ ≤ 12 * (2 : ℝ≥0∞) ^ (min ((s : ℝ) - (J + 1 : ℕ)) ((s : ℝ) / (μ + 1))) := hcard
    _ ≤ _ := by
      gcongr
      · norm_num
      · push_cast; exact min_le_left _ _

theorem two_rpow_regroup (X : ℝ≥0∞) (a b c e : ℝ) (h : a + b = c + e) :
    (2 : ℝ≥0∞) ^ a * (X * (2 : ℝ≥0∞) ^ b) = (2 : ℝ≥0∞) ^ c * X * (2 : ℝ≥0∞) ^ e := by
  rw [mul_left_comm, two_rpow_add, h, ← two_rpow_add]; ring

/-- The lowpass piece: frequencies `≲ 1` acting on the input shell `m ≥ 4`,
supremum over all radii in `[1,2]`, with decay `2^{-(p-1+β) m}` relative to
the weighted input moment. -/
theorem exists_lowpass_piece_bound {d : ℕ} (hd : 2 ≤ d)
    (K : SchwartzMap (Euclidean d) ℂ) (hK : ∀ u, (1 : ℝ) / 100 < ‖u‖ → K u = 0)
    {p β : ℝ} (hp : 1 < p) (hα : 0 ≤ ((d : ℝ) - 1) * (p - 1) - β) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ m : ℕ, 4 ≤ m → ∀ (h : SchwartzMap (Euclidean d) ℂ),
      (∀ y, ‖y‖ ≤ ((2 : ℝ) ^ (m + 1))⁻¹ → h y = 0) →
      (∀ y, 2 * ((2 : ℝ) ^ m)⁻¹ ≤ ‖y‖ → h y = 0) →
      (∫⁻ x, (⨆ t : Icc (1 : ℝ) 2,
          ‖sphericalAverage d (compactConvolution (compactDyadicDilate K 0) h) t x‖ₑ) ^ p) ≤
        A * (2 : ℝ≥0∞) ^ (-((p - 1 + β) * m)) *
          ∫⁻ y, ‖h y‖ₑ ^ p ∂powerWeightedVolume d (((d : ℝ) - 1) * (p - 1) - β) := by
  set α := ((d : ℝ) - 1) * (p - 1) - β with hαdef
  obtain ⟨A₁, hA₁, hfine⟩ := exists_smoothed_shell_dyadic_bound (by omega) K hK hp.le
  refine ⟨A₁ * (2 : ℝ≥0∞) ^ α, ENNReal.mul_ne_top hA₁ (two_rpow_ne_top _), ?_⟩
  intro m hm h hin hout
  have hw := lintegral_shell_le_weighted (p := p) hα m h hin (by linarith)
  apply (hfine 0 m 1 2 (by omega) hm le_rfl (by norm_num) le_rfl (by norm_num) h
    (fun y hy => hout y hy.le)).trans
  set W := ∫⁻ y, ‖h y‖ₑ ^ p ∂powerWeightedVolume d α
  calc
    _ ≤ A₁ * (2 : ℝ≥0∞) ^ (((0 : ℕ) : ℝ) * (p - 1) - (m : ℝ) * d * (p - 1)) *
        ((2 : ℝ≥0∞) ^ (((m : ℝ) + 1) * α) * W) := mul_le_mul' le_rfl hw
    _ = A₁ * ((2 : ℝ≥0∞) ^ (((0 : ℕ) : ℝ) * (p - 1) - (m : ℝ) * d * (p - 1)) *
        (2 : ℝ≥0∞) ^ (((m : ℝ) + 1) * α)) * W := by ring
    _ = A₁ * (2 : ℝ≥0∞) ^ (α + -((p - 1 + β) * m)) * W := by
      rw [two_rpow_add, show ((0 : ℕ) : ℝ) * (p - 1) - (m : ℝ) * d * (p - 1) +
        ((m : ℝ) + 1) * α = α + -((p - 1 + β) * m) by rw [hαdef]; push_cast; ring]
    _ = _ := by rw [← two_rpow_add]; ring

/-- Source `eq:Iaest`/`eq:IIaest`, one block: on the radius block `J` the
frequency `2^s` (with `s ≥ J+1`) contributes `2^{-c|s - (μ+1)J/μ|}` with
`c = min(β, 1-β)`, `β = 1/(μ+1)`; the source's count `#(E^μ ∩ I_l)` and its
`2^{-l-n}`-separated count are the two cover bounds. -/
theorem sequence_block_bound {μ : ℝ} (hμ : 0 < μ) {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ)
    {p : ℝ} (hp : 0 < p) {s J : ℕ} (hJs : J + 1 ≤ s) (B : ℝ≥0∞)
    (hB : ∀ a b : ℝ, 1 ≤ a → a ≤ b → b ≤ 2 → b - a ≤ ((2 : ℝ) ^ s)⁻¹ →
      (∫⁻ x, (⨆ t : Icc a b, ‖sphericalAverage d f t x‖ₑ) ^ p) ≤
        B * (2 : ℝ≥0∞) ^ (-(1 / (μ + 1) * s))) :
    (∫⁻ x, (⨆ t : sequenceBlock μ J, ‖sphericalAverage d f t x‖ₑ) ^ p) ≤
      (12 + (2 : ℝ≥0∞) ^ (1 / μ)) * B *
        (2 : ℝ≥0∞) ^ (-(min (1 / (μ + 1)) (μ / (μ + 1)) * |(s : ℝ) - (μ + 1) / μ * J|)) := by
  set β := 1 / (μ + 1)
  have hμ1 : 0 < μ + 1 := by linarith
  have hβ : 0 < β := by positivity
  set c := min β (μ / (μ + 1))
  have hβa : β * ((μ + 1) / μ) = 1 / μ := by dsimp only [β]; field_simp
  have h1βa : (μ / (μ + 1)) * ((μ + 1) / μ) = 1 := by field_simp
  have h1β : 1 - β = μ / (μ + 1) := by dsimp only [β]; field_simp; ring
  set y := (μ + 1) / μ * (J : ℝ)
  have hs : ((J : ℝ) + 1) ≤ s := by exact_mod_cast hJs
  rcases le_or_gt y s with hys | hys
  · -- many points: use the singleton cover
    obtain ⟨F, hF, hFI, hcard⟩ := sequenceBlock_finite_cover hμ J
    have hcov := maximal_moment_le_sum_cover volume f (sequenceBlock μ J) F (fun t => t)
      (fun t => t) (fun t ht => ⟨t, hF ht, le_rfl, le_rfl⟩) hp
    apply hcov.trans
    calc
      _ ≤ ∑ _t ∈ F, B * (2 : ℝ≥0∞) ^ (-(β * s)) := Finset.sum_le_sum fun t ht =>
          hB t t (hFI t ht).1 le_rfl (hFI t ht).2 (by rw [sub_self]; positivity)
      _ = (F.card : ℝ≥0∞) * (B * (2 : ℝ≥0∞) ^ (-(β * s))) := by
          rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ (2 : ℝ≥0∞) ^ (((J : ℝ) + 1) / μ) * (B * (2 : ℝ≥0∞) ^ (-(β * s))) := by
          gcongr
          rw [← ofReal_two_rpow, ← ENNReal.ofReal_natCast]
          exact ENNReal.ofReal_le_ofReal hcard
      _ = (2 : ℝ≥0∞) ^ (1 / μ) * B * (2 : ℝ≥0∞) ^ (-(β * |(s : ℝ) - y|)) := by
          rw [abs_of_nonneg (by linarith)]
          apply two_rpow_regroup
          dsimp only [y]
          rw [show ((J : ℝ) + 1) / μ = (J : ℝ) / μ + 1 / μ by ring,
            show (J : ℝ) / μ = β * ((μ + 1) / μ) * J by rw [hβa]; ring]
          ring
      _ ≤ _ := by
          gcongr
          · exact le_add_self
          · norm_num
          · exact min_le_left _ _
  · -- few scales: use the equal-length cover
    obtain ⟨I, a, b, hab, ha, hb, hlen, hcover, hcard⟩ := sequenceBlock_interval_cover hμ hJs
    have hcov := maximal_moment_le_sum_cover volume f (sequenceBlock μ J) I a b hcover hp
    apply hcov.trans
    calc
      _ ≤ ∑ _i ∈ I, B * (2 : ℝ≥0∞) ^ (-(β * s)) := Finset.sum_le_sum fun i hi =>
          hB (a i) (b i) (ha i hi) (hab i hi) (hb i hi) (hlen i hi)
      _ = (I.card : ℝ≥0∞) * (B * (2 : ℝ≥0∞) ^ (-(β * s))) := by
          rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ 12 * (2 : ℝ≥0∞) ^ ((s : ℝ) - (J + 1)) * (B * (2 : ℝ≥0∞) ^ (-(β * s))) := by
          gcongr
      _ = 12 * (2 : ℝ≥0∞) ^ (-1 : ℝ) * B * (2 : ℝ≥0∞) ^ (-((μ / (μ + 1)) * |(s : ℝ) - y|)) := by
          rw [abs_of_neg (by linarith), mul_assoc 12, two_rpow_regroup B _ _ (-1 : ℝ)
            (-((μ / (μ + 1)) * -((s : ℝ) - y))) ?_]
          · ring
          dsimp only [y]
          rw [← h1β]
          have : (J : ℝ) = (1 - β) * ((μ + 1) / μ) * J := by rw [h1β, h1βa, one_mul]
          nth_rewrite 1 [this]
          ring
      _ ≤ _ := by
          gcongr
          · calc 12 * (2 : ℝ≥0∞) ^ (-1 : ℝ) ≤ 12 * 1 := by
                  gcongr; exact ENNReal.rpow_le_one_of_one_le_of_neg (by norm_num) (by norm_num)
              _ = 12 := mul_one _
              _ ≤ _ := le_self_add
          · norm_num
          · exact min_le_right _ _

/-- Discrete weighted Hölder: `(∑ b c)^p ≤ (∑ b)^{p-1} ∑ b c^p`. -/
theorem finset_weighted_rpow_le {ι : Type*} (S : Finset ι) (b c : ι → ℝ≥0∞) {p : ℝ}
    (hp : 1 ≤ p) :
    (∑ k ∈ S, b k * c k) ^ p ≤ (∑ k ∈ S, b k) ^ (p - 1) * ∑ k ∈ S, b k * c k ^ p := by
  classical
  let _ : MeasurableSpace S := ⊤
  have : MeasurableSingletonClass S := ⟨fun _ => trivial⟩
  have h := weighted_lintegral_rpow_le (Measure.count : Measure S)
    (a := fun k : S => b k) (b := fun k : S => c k)
    (Measurable.aemeasurable (fun _ _ => trivial)) (Measurable.aemeasurable (fun _ _ => trivial)) hp
  simp only [lintegral_count, tsum_fintype] at h
  rwa [Finset.sum_coe_sort S (fun k => b k * c k), Finset.sum_coe_sort S b,
    Finset.sum_coe_sort S (fun k => b k * c k ^ p)] at h

/-- One-sided geometric sums. -/
theorem sum_two_rpow_neg_mul_le (I : Finset ℕ) {c : ℝ} (hc : 0 < c) :
    ∑ k ∈ I, (2 : ℝ≥0∞) ^ (-(c * k)) ≤ 2 * (2 : ℝ≥0∞) ^ c * (1 - (2 : ℝ≥0∞) ^ (-c))⁻¹ := by
  apply le_trans _ (sum_two_rpow_neg_abs_le I 0 hc)
  apply Finset.sum_le_sum
  intro k _
  rw [zero_sub, abs_neg, abs_of_nonneg (Nat.cast_nonneg k)]

/-- `(X^{1/p} 2^{-e/p})^p = X 2^{-e}`. -/
theorem rpow_inv_mul_two_rpow_rpow (X : ℝ≥0∞) (e : ℝ) {p : ℝ} (hp : 0 < p) :
    (X ^ (1 / p) * (2 : ℝ≥0∞) ^ (-(e / p))) ^ p = X * (2 : ℝ≥0∞) ^ (-e) := by
  rw [ENNReal.mul_rpow_of_nonneg _ _ hp.le, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
    one_div_mul_cancel hp.ne', ENNReal.rpow_one]
  congr 2
  field_simp

theorem sequenceSet_exists_block {μ : ℝ} (hμ : 0 ≤ μ) {t : ℝ} (ht : t ∈ sequenceSet μ) :
    ∃ J, t ∈ sequenceBlock μ J := by
  have hu : 0 < t - 1 := by
    obtain ⟨n, hn, rfl⟩ := ht
    have := (rpow_neg_mem_Ioc hμ hn).1
    linarith
  obtain ⟨s, hs⟩ := exists_pow_lt_of_lt_one hu (by norm_num : (1 / 2 : ℝ) < 1)
  rcases sequenceSet_low_or_block hμ ht s with hlow | ⟨J, _, hJ⟩
  · exfalso
    have := hlow.2.2
    rw [one_div, inv_pow] at hs
    linarith
  · exact ⟨J, hJ⟩

theorem sequenceBlock_mem_low {μ : ℝ} {t : ℝ} {J s : ℕ} (ht : t ∈ sequenceBlock μ J)
    (hsJ : s ≤ J) : t ∈ sequenceLowTimes μ s := by
  obtain ⟨htE, hlo, hhi⟩ := ht
  refine ⟨htE, by linarith [show (0 : ℝ) < ((2 : ℝ) ^ (J + 1))⁻¹ by positivity], ?_⟩
  have : ((2 : ℝ) ^ J)⁻¹ ≤ ((2 : ℝ) ^ s)⁻¹ :=
    inv_anti₀ (by positivity) (pow_le_pow_right₀ (by norm_num) hsJ)
  linarith

/-- `finite_sum_moment_bound` for an arbitrary finite index set. -/
theorem finite_sum_moment_bound_gen {X ι : Type*} [MeasurableSpace X]
    (μ : Measure X) (I : Finset ι) (G : ι → X → ℝ≥0∞)
    (hG : ∀ i ∈ I, Measurable (G i)) {p : ℝ} (hp : 1 ≤ p)
    (a : ι → ℝ≥0∞) (Q : ℝ≥0∞)
    (hbound : ∀ i ∈ I, (∫⁻ x, G i x ^ p ∂μ) ≤ a i ^ p * Q) :
    (∫⁻ x, (∑ i ∈ I, G i x) ^ p ∂μ) ≤ (∑ i ∈ I, a i) ^ p * Q := by
  have hp0 : 0 < p := by linarith
  have hnorm (i : ι) (hi : i ∈ I) :
      eLpNorm' (G i) p μ ≤ a i * Q ^ (1 / p) := by
    rw [eLpNorm'_eq_lintegral_enorm]
    simp only [enorm_eq_self]
    have hh := ENNReal.rpow_le_rpow (hbound i hi) (by positivity : 0 ≤ 1 / p)
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : 0 ≤ 1 / p),
      ← ENNReal.rpow_mul, mul_one_div_cancel hp0.ne', ENNReal.rpow_one] at hh
    exact hh
  have hh := (eLpNorm'_sum_le (fun i hi => (hG i hi).aestronglyMeasurable) hp).trans
    (Finset.sum_le_sum hnorm)
  rw [← Finset.sum_mul] at hh
  have hpw := ENNReal.rpow_le_rpow hh hp0.le
  rw [← lintegral_rpow_enorm_eq_rpow_eLpNorm' hp0,
    ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul,
    one_div_mul_cancel hp0.ne', ENNReal.rpow_one] at hpw
  simpa only [Finset.sum_apply, enorm_eq_self] using hpw

/-- Source Section 3.5, truncated form of `eq:Iaest` + `eq:IIaest` + the
low frequencies: the frequency pieces `≤ N` of the input shells `4 ≤ m < N`,
with the supremum over all of `E^μ`, are bounded at `α = U(p)` uniformly in
`N`. The source's lacunary lemma for the lowest frequencies is replaced by
the summable bound `2^{-βs}` on the window `[1, 1+2^{-s}]`. -/
theorem sequence_near_truncated_bound {d : ℕ} (hd : 2 ≤ d) {μ p : ℝ} (hμ : 0 < μ)
    (hp : 1 < p) (hα : 0 < ((d : ℝ) - 1) * (p - 1) - 1 / (μ + 1))
    (K₀ 𝒦 : SchwartzMap (Euclidean d) ℂ) (hK₀ : ∀ u, (1 : ℝ) / 100 < ‖u‖ → K₀ u = 0)
    (h𝒦 : ∀ u, (1 : ℝ) / 100 < ‖u‖ → 𝒦 u = 0) {N₀ : ℕ}
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d)) (fun ξ => 𝓕 𝒦 ξ) (fun ξ => ‖ξ‖ ^ N₀))
    (hN : ((d : ℝ) - 1) / 2 ≤ N₀)
    (P : ℕ → SchwartzMap (Euclidean d) ℂ → SchwartzMap (Euclidean d) ℂ)
    (hPn : ∀ m g y, ‖P m g y‖ ≤ 2 * ‖g y‖)
    (hPi : ∀ m g y, ‖y‖ ≤ ((2 : ℝ) ^ (m + 1))⁻¹ → P m g y = 0)
    (hPo : ∀ m g y, 2 * ((2 : ℝ) ^ m)⁻¹ ≤ ‖y‖ → P m g y = 0) :
    ∃ B : ℝ≥0∞, B ≠ ∞ ∧ ∀ (N : ℕ) (g : SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x, (⨆ t : sequenceSet μ, ‖∑ m ∈ Finset.Ico 4 N,
          (sphericalAverage d (compactConvolution (compactDyadicDilate K₀ 0) (P m g)) t x +
            ∑ s ∈ Finset.range N,
              sphericalAverage d (compactConvolution (compactDyadicDilate 𝒦 s) (P m g)) t x)‖ₑ) ^
          p) ≤
        B * ∫⁻ y, ‖g y‖ₑ ^ p ∂powerWeightedVolume d (((d : ℝ) - 1) * (p - 1) - 1 / (μ + 1)) := by
  classical
  set β := 1 / (μ + 1) with hβdef
  set α := ((d : ℝ) - 1) * (p - 1) - β with hαdef
  have hμ1 : 0 < μ + 1 := by linarith
  have hβ0 : 0 < β := by positivity
  have hβ1 : β < 1 := by rw [hβdef, div_lt_one hμ1]; linarith
  have hp0 : 0 < p := by linarith
  have hd2 : 2 ≤ d := by omega
  obtain ⟨A𝒦, hA𝒦, ε, hε, hpiece⟩ := exists_sequence_piece_bound hd 𝒦 h𝒦 hflat hN hp hβ0 hβ1 hα
  obtain ⟨A₀, hA₀, hlow0⟩ := exists_lowpass_piece_bound hd2 K₀ hK₀ hp hα.le
  set c := min β (μ / (μ + 1)) with hcdef
  have hc : 0 < c := lt_min hβ0 (by positivity)
  set a := (μ + 1) / μ with hadef
  have ha1 : 1 ≤ a := by rw [one_le_div hμ]; linarith
  -- geometric constants
  let G : ℝ → ℝ≥0∞ := fun x => 2 * (2 : ℝ≥0∞) ^ x * (1 - (2 : ℝ≥0∞) ^ (-x))⁻¹
  have hG (x : ℝ) (hx : 0 < x) : G x ≠ ∞ := two_rpow_geometric_constant_ne_top hx
  set D := (12 + (2 : ℝ≥0∞) ^ (1 / μ)) * A𝒦
  have hD : D ≠ ∞ := ENNReal.mul_ne_top (ENNReal.add_ne_top.mpr ⟨by norm_num,
    two_rpow_ne_top _⟩) hA𝒦
  set La0 := (A₀ * 2 ^ p) ^ (1 / p) * G ((p - 1 + β) / p)
  set La := (A𝒦 * 2 ^ p) ^ (1 / p) * (G (β / p) * G (ε / p))
  set Sb := D ^ (1 / p) * (G (ε / p) * G (c / p))
  have hpos1 : 0 < (p - 1 + β) / p := by positivity
  have hpos2 : 0 < β / p := by positivity
  have hpos3 : 0 < ε / p := by positivity
  have hpos4 : 0 < c / p := by positivity
  have hLa0 : La0 ≠ ∞ := ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg (by positivity)
    (ENNReal.mul_ne_top hA₀ (by finiteness))) (hG _ hpos1)
  have hLa : La ≠ ∞ := ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg (by positivity)
    (ENNReal.mul_ne_top hA𝒦 (by finiteness))) (ENNReal.mul_ne_top (hG _ hpos2) (hG _ hpos3))
  have hSb : Sb ≠ ∞ := ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg (by positivity) hD)
    (ENNReal.mul_ne_top (hG _ hpos3) (hG _ hpos4))
  refine ⟨(2 : ℝ≥0∞) ^ (p - 1) * ((2 : ℝ≥0∞) ^ (p - 1) * (La0 ^ p + La ^ p) +
      Sb ^ p * (2 * 2 ^ p)), by finiteness, ?_⟩
  intro N g
  set Q := ∫⁻ y, ‖g y‖ₑ ^ p ∂powerWeightedVolume d α
  set W : ℕ → ℝ≥0∞ := fun m => ∫⁻ y, ‖P m g y‖ₑ ^ p ∂powerWeightedVolume d α
  have hWQ (m : ℕ) : W m ≤ 2 ^ p * Q := by
    simp only [W, Q]
    rw [← lintegral_const_mul' _ _ (by finiteness)]
    apply lintegral_mono
    intro y
    dsimp only
    rw [← ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
    apply ENNReal.rpow_le_rpow _ hp0.le
    rw [← ofReal_norm, ← ofReal_norm]
    exact (ENNReal.ofReal_le_ofReal (hPn m g y)).trans_eq
      (by rw [ENNReal.ofReal_mul (by norm_num)]; norm_num)
  have hWsum (S : Finset ℕ) : ∑ m ∈ S, W m ≤ 2 * 2 ^ p * Q := by
    simp only [W, Q]
    rw [← lintegral_finsetSum _ (fun m _ =>
      (P m g).continuous.measurable.enorm.pow_const p),
      ← lintegral_const_mul' _ _ (by finiteness)]
    exact lintegral_mono fun y => dyadic_pieces_overlap P hPn hPi hPo S g y hp0
  -- the maximal pieces
  let T := Finset.range N ×ˢ Finset.Ico 4 N
  let Y0 : ℕ → Euclidean d → ℝ≥0∞ := fun m x => ⨆ t : Icc (1 : ℝ) 2,
    ‖sphericalAverage d (compactConvolution (compactDyadicDilate K₀ 0) (P m g)) t x‖ₑ
  let Y : ℕ × ℕ → Euclidean d → ℝ≥0∞ := fun k x => ⨆ t : sequenceLowTimes μ k.1,
    ‖sphericalAverage d (compactConvolution (compactDyadicDilate 𝒦 k.1) (P k.2 g)) t x‖ₑ
  let X : ℕ → ℕ × ℕ → Euclidean d → ℝ≥0∞ := fun J k x => ⨆ t : sequenceBlock μ J,
    ‖sphericalAverage d (compactConvolution (compactDyadicDilate 𝒦 k.1) (P k.2 g)) t x‖ₑ
  let L : Euclidean d → ℝ≥0∞ := fun x => (∑ m ∈ Finset.Ico 4 N, Y0 m x) + ∑ k ∈ T, Y k x
  let Z : ℕ → Euclidean d → ℝ≥0∞ := fun J x => ∑ k ∈ T.filter (fun k => J < k.1), X J k x
  have hY0m (m : ℕ) : Measurable (Y0 m) := measurable_schwartz_radius_supremum _ _
  have hYm (k : ℕ × ℕ) : Measurable (Y k) := measurable_schwartz_radius_supremum _ _
  have hXm (J : ℕ) (k : ℕ × ℕ) : Measurable (X J k) := measurable_schwartz_radius_supremum _ _
  have hLm : Measurable L := (Finset.measurable_sum _ fun m _ => hY0m m).add
    (Finset.measurable_sum _ fun k _ => hYm k)
  have hZm (J : ℕ) : Measurable (Z J) := Finset.measurable_sum _ fun k _ => hXm J k
  -- pointwise reduction
  have hpoint (x : Euclidean d) :
      (⨆ t : sequenceSet μ, ‖∑ m ∈ Finset.Ico 4 N,
          (sphericalAverage d (compactConvolution (compactDyadicDilate K₀ 0) (P m g)) t x +
            ∑ s ∈ Finset.range N,
              sphericalAverage d (compactConvolution (compactDyadicDilate 𝒦 s) (P m g)) t x)‖ₑ) ^
          p ≤
        (2 : ℝ≥0∞) ^ (p - 1) * (L x ^ p + ∑ J ∈ Finset.range N, Z J x ^ p) := by
    apply (ENNReal.le_rpow_inv_iff hp0).mp
    apply iSup_le
    intro t
    apply (ENNReal.le_rpow_inv_iff hp0).mpr
    obtain ⟨J0, hJ0⟩ := sequenceSet_exists_block hμ.le t.2
    have htI : (t : ℝ) ∈ Icc (1 : ℝ) 2 := sequenceSet_subset_Icc hμ.le t.2
    have hsplit : ‖∑ m ∈ Finset.Ico 4 N,
        (sphericalAverage d (compactConvolution (compactDyadicDilate K₀ 0) (P m g)) t x +
          ∑ s ∈ Finset.range N,
            sphericalAverage d (compactConvolution (compactDyadicDilate 𝒦 s) (P m g)) t x)‖ₑ ≤
        L x + Z J0 x := by
      apply (enorm_sum_le _ _).trans
      have h1 : ∀ m ∈ Finset.Ico 4 N,
          ‖sphericalAverage d (compactConvolution (compactDyadicDilate K₀ 0) (P m g)) t x +
            ∑ s ∈ Finset.range N,
              sphericalAverage d (compactConvolution (compactDyadicDilate 𝒦 s) (P m g)) t x‖ₑ ≤
          Y0 m x + ∑ s ∈ Finset.range N,
            ‖sphericalAverage d (compactConvolution (compactDyadicDilate 𝒦 s) (P m g)) t x‖ₑ :=
        fun m _ => (enorm_add_le _ _).trans (add_le_add
          (le_iSup (fun t : Icc (1 : ℝ) 2 => ‖sphericalAverage d
            (compactConvolution (compactDyadicDilate K₀ 0) (P m g)) t x‖ₑ) ⟨t, htI⟩)
          (enorm_sum_le _ _))
      apply (Finset.sum_le_sum h1).trans
      rw [Finset.sum_add_distrib, Finset.sum_comm, ← Finset.sum_product']
      dsimp only [L, Z]
      rw [add_assoc]
      apply add_le_add le_rfl
      rw [← Finset.sum_filter_add_sum_filter_not T (fun k => J0 < k.1), add_comm]
      apply add_le_add
      · refine (Finset.sum_le_sum (fun k hk => ?_)).trans
          (Finset.sum_le_sum_of_subset (f := fun k => Y k x) (Finset.filter_subset _ T))
        have hk' := (Finset.mem_filter.mp hk).2
        exact le_iSup (fun t : sequenceLowTimes μ k.1 => ‖sphericalAverage d
          (compactConvolution (compactDyadicDilate 𝒦 k.1) (P k.2 g)) t x‖ₑ)
          ⟨t, sequenceBlock_mem_low hJ0 (not_lt.mp hk')⟩
      · apply Finset.sum_le_sum
        intro k _
        exact le_iSup (fun t : sequenceBlock μ J0 => ‖sphericalAverage d
          (compactConvolution (compactDyadicDilate 𝒦 k.1) (P k.2 g)) t x‖ₑ) ⟨t, hJ0⟩
    apply (ENNReal.rpow_le_rpow hsplit hp0.le).trans
    apply (ENNReal.rpow_add_le_mul_rpow_add_rpow _ _ hp.le).trans
    apply mul_le_mul' le_rfl (add_le_add le_rfl _)
    by_cases hJN : J0 < N
    · exact Finset.single_le_sum (f := fun J => Z J x ^ p) (fun _ _ => bot_le)
        (Finset.mem_range.mpr hJN)
    · have : Z J0 x = 0 := by
        apply Finset.sum_eq_zero
        intro k hk
        obtain ⟨hkT, hk⟩ := Finset.mem_filter.mp hk
        have := (Finset.mem_range.mp (Finset.mem_product.mp hkT).1)
        omega
      rw [this, ENNReal.zero_rpow_of_pos hp0]
      exact bot_le
  -- the low windows
  have hY0 (m : ℕ) (hm : m ∈ Finset.Ico 4 N) : (∫⁻ x, Y0 m x ^ p) ≤
      ((A₀ * 2 ^ p) ^ (1 / p) * (2 : ℝ≥0∞) ^ (-(((p - 1 + β) / p) * m))) ^ p * Q := by
    have hm4 := (Finset.mem_Ico.mp hm).1
    rw [show ((p - 1 + β) / p) * (m : ℝ) = (p - 1 + β) * m / p by ring,
      rpow_inv_mul_two_rpow_rpow _ _ hp0]
    apply (hlow0 m hm4 (P m g) (hPi m g) (hPo m g)).trans
    calc
      _ ≤ A₀ * (2 : ℝ≥0∞) ^ (-((p - 1 + β) * m)) * (2 ^ p * Q) := mul_le_mul' le_rfl (hWQ m)
      _ = _ := by ring
  have hY (k : ℕ × ℕ) (hk : k ∈ T) : (∫⁻ x, Y k x ^ p) ≤
      ((A𝒦 * 2 ^ p) ^ (1 / p) * ((2 : ℝ≥0∞) ^ (-((β / p) * k.1)) *
        (2 : ℝ≥0∞) ^ (-((ε / p) * |(k.1 : ℝ) - k.2|)))) ^ p * Q := by
    obtain ⟨hs, hm⟩ := Finset.mem_product.mp hk
    have hm4 := (Finset.mem_Ico.mp hm).1
    rw [two_rpow_add, show -((β / p) * k.1) + -((ε / p) * |(k.1 : ℝ) - k.2|) =
      -((β * k.1 + ε * |(k.2 : ℝ) - k.1|) / p) by rw [abs_sub_comm]; ring,
      rpow_inv_mul_two_rpow_rpow _ _ hp0]
    have hsub := maximal_moment_le_sum_cover volume
      (compactConvolution (compactDyadicDilate 𝒦 k.1) (P k.2 g)) (sequenceLowTimes μ k.1)
      ({0} : Finset ℕ) (fun _ => (1 : ℝ)) (fun _ => 1 + ((2 : ℝ) ^ k.1)⁻¹)
      (fun t ht => ⟨0, Finset.mem_singleton_self 0, ht.2⟩) hp0
    rw [Finset.sum_singleton] at hsub
    have hinv : ((2 : ℝ) ^ k.1)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (one_le_pow₀ (by norm_num))
    have hnn : (0 : ℝ) ≤ ((2 : ℝ) ^ k.1)⁻¹ := by positivity
    apply hsub.trans
    apply (hpiece k.1 k.2 1 (1 + ((2 : ℝ) ^ k.1)⁻¹) hm4 le_rfl (by linarith) (by linarith)
      (by linarith) (P k.2 g) (hPi k.2 g) (hPo k.2 g)).trans
    calc
      _ ≤ A𝒦 * (2 : ℝ≥0∞) ^ (-(β * k.1 + ε * |(k.2 : ℝ) - k.1|)) * (2 ^ p * Q) :=
        mul_le_mul' le_rfl (hWQ k.2)
      _ = _ := by ring
  have hLsum : ∫⁻ x, L x ^ p ≤ (2 : ℝ≥0∞) ^ (p - 1) * (La0 ^ p + La ^ p) * Q := by
    have hA := finite_sum_moment_bound_gen volume (Finset.Ico 4 N) Y0 (fun m _ => hY0m m) hp.le
      _ Q hY0
    have hB := finite_sum_moment_bound_gen volume T Y (fun k _ => hYm k) hp.le _ Q hY
    have hA' : ∑ m ∈ Finset.Ico 4 N,
        (A₀ * 2 ^ p) ^ (1 / p) * (2 : ℝ≥0∞) ^ (-(((p - 1 + β) / p) * m)) ≤ La0 := by
      rw [← Finset.mul_sum]
      exact mul_le_mul' le_rfl (sum_two_rpow_neg_mul_le _ hpos1)
    have hB' : ∑ k ∈ T, (A𝒦 * 2 ^ p) ^ (1 / p) * ((2 : ℝ≥0∞) ^ (-((β / p) * k.1)) *
        (2 : ℝ≥0∞) ^ (-((ε / p) * |(k.1 : ℝ) - k.2|))) ≤ La := by
      rw [← Finset.mul_sum]
      apply mul_le_mul' le_rfl
      rw [Finset.sum_product]
      calc
        _ ≤ ∑ s ∈ Finset.range N, (2 : ℝ≥0∞) ^ (-((β / p) * s)) * G (ε / p) := by
          apply Finset.sum_le_sum
          intro s _
          dsimp only
          rw [← Finset.mul_sum]
          exact mul_le_mul' le_rfl (sum_two_rpow_neg_abs_le _ _ hpos3)
        _ = (∑ s ∈ Finset.range N, (2 : ℝ≥0∞) ^ (-((β / p) * s))) * G (ε / p) := by
          rw [Finset.sum_mul]
        _ ≤ _ := mul_le_mul' (sum_two_rpow_neg_mul_le _ hpos2) le_rfl
    calc
      _ ≤ ∫⁻ x, (2 : ℝ≥0∞) ^ (p - 1) * ((∑ m ∈ Finset.Ico 4 N, Y0 m x) ^ p +
          (∑ k ∈ T, Y k x) ^ p) :=
        lintegral_mono fun x => ENNReal.rpow_add_le_mul_rpow_add_rpow _ _ hp.le
      _ = (2 : ℝ≥0∞) ^ (p - 1) * ((∫⁻ x, (∑ m ∈ Finset.Ico 4 N, Y0 m x) ^ p) +
          ∫⁻ x, (∑ k ∈ T, Y k x) ^ p) := by
        rw [lintegral_const_mul' _ _ (by finiteness), lintegral_add_left
          ((Finset.measurable_sum _ fun m _ => hY0m m).pow_const p)]
      _ ≤ (2 : ℝ≥0∞) ^ (p - 1) * (La0 ^ p * Q + La ^ p * Q) := by
        gcongr
        · exact hA.trans (mul_le_mul' (ENNReal.rpow_le_rpow hA' hp0.le) le_rfl)
        · exact hB.trans (mul_le_mul' (ENNReal.rpow_le_rpow hB' hp0.le) le_rfl)
      _ = _ := by ring
  -- the blocks
  let b : ℕ → ℕ × ℕ → ℝ≥0∞ := fun J k => D ^ (1 / p) *
    ((2 : ℝ≥0∞) ^ (-((ε / p) * |(k.1 : ℝ) - k.2|)) *
      (2 : ℝ≥0∞) ^ (-((c / p) * |(k.1 : ℝ) - a * J|)))
  have hX (J : ℕ) (k : ℕ × ℕ) (hk : k ∈ T.filter (fun k => J < k.1)) :
      (∫⁻ x, X J k x ^ p) ≤ (b J k * W k.2 ^ (1 / p)) ^ p * 1 := by
    obtain ⟨hkT, hJk⟩ := Finset.mem_filter.mp hk
    obtain ⟨_, hm⟩ := Finset.mem_product.mp hkT
    have hm4 := (Finset.mem_Ico.mp hm).1
    have hblock := sequence_block_bound hμ
      (compactConvolution (compactDyadicDilate 𝒦 k.1) (P k.2 g)) hp0 (s := k.1) (J := J)
      (by omega) (A𝒦 * (2 : ℝ≥0∞) ^ (-(ε * |(k.2 : ℝ) - k.1|)) * W k.2) (by
        intro a' b' ha' hab' hb' hlen'
        apply (hpiece k.1 k.2 a' b' hm4 ha' hab' hb' hlen' (P k.2 g) (hPi k.2 g)
          (hPo k.2 g)).trans_eq
        rw [neg_add, ← two_rpow_add]
        dsimp only [W]
        ring)
    apply hblock.trans_eq
    simp only [b]
    rw [mul_one, ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ENNReal.mul_rpow_of_nonneg _ _ hp0.le,
      ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul D, ← ENNReal.rpow_mul (W k.2),
      one_div_mul_cancel hp0.ne', ENNReal.rpow_one, ENNReal.rpow_one, ← ENNReal.rpow_mul 2,
      ← ENNReal.rpow_mul 2]
    have e1 : -((ε / p) * |(k.1 : ℝ) - k.2|) * p = -(ε * |(k.2 : ℝ) - k.1|) := by
      rw [abs_sub_comm]; field_simp
    have e2 : -((c / p) * |(k.1 : ℝ) - a * J|) * p =
        -(min (1 / (μ + 1)) (μ / (μ + 1)) * |(k.1 : ℝ) - (μ + 1) / μ * J|) := by
      rw [hcdef, hβdef, hadef]; field_simp
    rw [e1, e2]
    simp only [D]
    ring
  have hbsum (J : ℕ) : ∑ k ∈ T, b J k ≤ Sb := by
    simp only [b, Sb]
    rw [← Finset.mul_sum]
    apply mul_le_mul' le_rfl
    rw [Finset.sum_product]
    calc
      _ ≤ ∑ s ∈ Finset.range N, G (ε / p) * (2 : ℝ≥0∞) ^ (-((c / p) * |(s : ℝ) - a * J|)) := by
        apply Finset.sum_le_sum
        intro s _
        dsimp only
        rw [← Finset.sum_mul]
        exact mul_le_mul' (sum_two_rpow_neg_abs_le _ _ hpos3) le_rfl
      _ = G (ε / p) * ∑ s ∈ Finset.range N,
          (2 : ℝ≥0∞) ^ (-((c / p) * |a * J - (s : ℝ)|)) := by
        rw [Finset.mul_sum]
        congr 1; funext s; rw [abs_sub_comm]
      _ ≤ _ := mul_le_mul' le_rfl (sum_two_rpow_neg_abs_le _ _ hpos4)
  have hZ (J : ℕ) : (∫⁻ x, Z J x ^ p) ≤
      Sb ^ (p - 1) * ∑ k ∈ T.filter (fun k => J < k.1), b J k * W k.2 := by
    have hM := finite_sum_moment_bound_gen volume (T.filter (fun k => J < k.1)) (X J)
      (fun k _ => hXm J k) hp.le (fun k => b J k * W k.2 ^ (1 / p)) 1 (hX J)
    rw [mul_one] at hM
    apply hM.trans
    apply (finset_weighted_rpow_le _ (b J) (fun k => W k.2 ^ (1 / p)) hp.le).trans
    have hW (k : ℕ × ℕ) : (W k.2 ^ (1 / p)) ^ p = W k.2 := by
      rw [← ENNReal.rpow_mul, one_div_mul_cancel hp0.ne', ENNReal.rpow_one]
    simp only [hW]
    apply mul_le_mul' _ le_rfl
    exact ENNReal.rpow_le_rpow ((Finset.sum_le_sum_of_subset (Finset.filter_subset _ T)).trans
      (hbsum J)) (by linarith)
  have hZsum : ∑ J ∈ Finset.range N, ∑ k ∈ T.filter (fun k => J < k.1), b J k * W k.2 ≤
      Sb * (2 * 2 ^ p * Q) := by
    calc
      _ ≤ ∑ J ∈ Finset.range N, ∑ k ∈ T, b J k * W k.2 :=
        Finset.sum_le_sum fun J _ => Finset.sum_le_sum_of_subset (Finset.filter_subset _ T)
      _ = ∑ k ∈ T, W k.2 * ∑ J ∈ Finset.range N, b J k := by
        rw [Finset.sum_comm]
        congr 1; funext k; rw [Finset.mul_sum]; congr 1; funext J; ring
      _ ≤ ∑ k ∈ T, W k.2 * (D ^ (1 / p) *
          ((2 : ℝ≥0∞) ^ (-((ε / p) * |(k.1 : ℝ) - k.2|)) * G (c / p))) := by
        apply Finset.sum_le_sum
        intro k _
        apply mul_le_mul' le_rfl
        simp only [b]
        rw [← Finset.mul_sum, ← Finset.mul_sum]
        exact mul_le_mul' le_rfl (mul_le_mul' le_rfl
          (sum_two_rpow_neg_abs_mul_le _ _ ha1 hpos4))
      _ = D ^ (1 / p) * G (c / p) *
          ∑ k ∈ T, W k.2 * (2 : ℝ≥0∞) ^ (-((ε / p) * |(k.1 : ℝ) - k.2|)) := by
        rw [Finset.mul_sum]; congr 1; funext k; ring
      _ = D ^ (1 / p) * G (c / p) * ∑ m ∈ Finset.Ico 4 N, W m *
          ∑ s ∈ Finset.range N, (2 : ℝ≥0∞) ^ (-((ε / p) * |(m : ℝ) - s|)) := by
        congr 1
        rw [Finset.sum_product, Finset.sum_comm]
        congr 1; funext m; rw [Finset.mul_sum]; congr 1; funext s; dsimp only
        rw [abs_sub_comm]
      _ ≤ D ^ (1 / p) * G (c / p) * ∑ m ∈ Finset.Ico 4 N, W m * G (ε / p) := by
        gcongr with m
        exact sum_two_rpow_neg_abs_le _ _ hpos3
      _ = Sb * ∑ m ∈ Finset.Ico 4 N, W m := by
        rw [← Finset.sum_mul]; simp only [Sb]; ring
      _ ≤ _ := mul_le_mul' le_rfl (hWsum _)
  -- conclusion
  calc
    _ ≤ ∫⁻ x, (2 : ℝ≥0∞) ^ (p - 1) * (L x ^ p + ∑ J ∈ Finset.range N, Z J x ^ p) :=
      lintegral_mono hpoint
    _ = (2 : ℝ≥0∞) ^ (p - 1) * ((∫⁻ x, L x ^ p) +
        ∑ J ∈ Finset.range N, ∫⁻ x, Z J x ^ p) := by
      rw [lintegral_const_mul' _ _ (by finiteness), lintegral_add_left (hLm.pow_const p),
        lintegral_finsetSum _ (fun J _ => (hZm J).pow_const p)]
    _ ≤ (2 : ℝ≥0∞) ^ (p - 1) * ((2 : ℝ≥0∞) ^ (p - 1) * (La0 ^ p + La ^ p) * Q +
        Sb ^ (p - 1) * (Sb * (2 * 2 ^ p * Q))) := by
      gcongr
      exact (Finset.sum_le_sum fun J _ => hZ J).trans
        ((Finset.mul_sum _ _ _).symm.le.trans (mul_le_mul' le_rfl hZsum))
    _ = _ := by
      have hSbp : Sb ^ (p - 1) * Sb = Sb ^ p := by
        calc
          Sb ^ (p - 1) * Sb = Sb ^ (p - 1) * Sb ^ (1 : ℝ) := by rw [ENNReal.rpow_one]
          _ = Sb ^ (p - 1 + 1) := (ENNReal.rpow_add_of_nonneg _ _ (by linarith) zero_le_one).symm
          _ = Sb ^ p := by ring_nf
      rw [← mul_assoc (Sb ^ (p - 1)), hSbp]
      ring

theorem sphericalAverage_schwartz_add {d : ℕ} (f g : SchwartzMap (Euclidean d) ℂ) (t : ℝ)
    (x : Euclidean d) :
    sphericalAverage d (f + g : SchwartzMap (Euclidean d) ℂ) t x =
      sphericalAverage d f t x + sphericalAverage d g t x := by
  rw [← schwartzSphericalAverage_apply, schwartzSphericalAverage_add, add_apply,
    schwartzSphericalAverage_apply, schwartzSphericalAverage_apply]

/-- `∫ |h| ≤ M |B_r|` for inputs bounded by `M` and vanishing beyond radius `r`. -/
theorem lintegral_enorm_le_of_bound_support {d : ℕ} (h : SchwartzMap (Euclidean d) ℂ)
    {M r : ℝ} (hM : 0 ≤ M) (hr : 0 ≤ r) (hbd : ∀ y, ‖h y‖ ≤ M)
    (hsupp : ∀ y, r ≤ ‖y‖ → h y = 0) :
    (∫⁻ y, ‖h y‖ₑ) ≤
      ENNReal.ofReal (M * (r ^ d * (volume (Metric.ball (0 : Euclidean d) 1)).toReal)) := by
  have hV : volume (Metric.ball (0 : Euclidean d) 1) ≠ ∞ := measure_ball_lt_top.ne
  calc
    _ ≤ ∫⁻ y, (Metric.closedBall (0 : Euclidean d) r).indicator
        (fun _ => ENNReal.ofReal M) y := by
      apply lintegral_mono
      intro y
      by_cases hy : y ∈ Metric.closedBall (0 : Euclidean d) r
      · rw [Set.indicator_of_mem hy]
        change ‖h y‖ₑ ≤ _
        rw [← ofReal_norm]
        exact ENNReal.ofReal_le_ofReal (hbd y)
      · have : r ≤ ‖y‖ := by
          simp only [Metric.mem_closedBall, dist_zero_right, not_le] at hy; exact hy.le
        simp [hsupp y this]
    _ = ENNReal.ofReal M * volume (Metric.closedBall (0 : Euclidean d) r) :=
      lintegral_indicator_const measurableSet_closedBall _
    _ = _ := by
      rw [Measure.addHaar_closedBall _ _ hr, finrank_euclideanSpace_fin,
        ← ENNReal.ofReal_toReal hV, ← ENNReal.ofReal_mul (by positivity),
        ← ENNReal.ofReal_mul hM]
      ring_nf
      rw [ENNReal.ofReal_toReal hV]

/-- The spatial remainder of the dyadic decomposition is negligible after
the first `N` resolution pieces: pointwise `O((N+1) 2^N M r^d)`. -/
theorem exists_resolution_remainder_bound {d : ℕ} (hd : 0 < d)
    (K₀ 𝒦 : SchwartzMap (Euclidean d) ℂ) :
    ∃ C : ℝ, 0 < C ∧ ∀ (N : ℕ) (h : SchwartzMap (Euclidean d) ℂ) (M r : ℝ), 0 ≤ M → 0 ≤ r →
      (∀ y, ‖h y‖ ≤ M) → (∀ y, r ≤ ‖y‖ → h y = 0) → ∀ t : ℝ, 1 ≤ t → ∀ x : Euclidean d,
      ‖sphericalAverage d (compactConvolution (compactDyadicDilate K₀ 0) h) t x +
          ∑ s ∈ Finset.range N,
            sphericalAverage d (compactConvolution (compactDyadicDilate 𝒦 s) h) t x‖ ≤
        ((N : ℝ) + 1) * (C * (2 : ℝ) ^ N) *
          (M * (r ^ d * (volume (Metric.ball (0 : Euclidean d) 1)).toReal)) := by
  obtain ⟨C₀, hC₀, hb₀⟩ := exists_smoothed_sphericalAverage_pointwise_bound hd K₀
  obtain ⟨C₁, hC₁, hb₁⟩ := exists_smoothed_sphericalAverage_pointwise_bound hd 𝒦
  refine ⟨C₀ + C₁, by linarith, ?_⟩
  intro N h M r hM hr hbd hsupp t ht x
  set I := M * (r ^ d * (volume (Metric.ball (0 : Euclidean d) 1)).toReal)
  have hI : 0 ≤ I := by positivity
  have hint := lintegral_enorm_le_of_bound_support h hM hr hbd hsupp
  have hj (s : ℕ) (hs : s ≤ N) : (C₁ * (2 : ℝ) ^ s) ≤ (C₀ + C₁) * 2 ^ N := by
    have : (2 : ℝ) ^ s ≤ 2 ^ N := pow_le_pow_right₀ (by norm_num) hs
    nlinarith [pow_pos (two_pos (α := ℝ)) s]
  have hterm0 : ‖sphericalAverage d (compactConvolution (compactDyadicDilate K₀ 0) h) t x‖ ≤
      (C₀ + C₁) * 2 ^ N * I := by
    have h1 := (hb₀ 0 t ht h x).trans (mul_le_mul' le_rfl hint)
    rw [← ENNReal.ofReal_mul (by positivity), ← ofReal_norm] at h1
    apply ((ENNReal.ofReal_le_ofReal_iff (by positivity)).mp h1).trans
    apply mul_le_mul_of_nonneg_right _ hI
    have : (1 : ℝ) ≤ 2 ^ N := one_le_pow₀ (by norm_num)
    simp only [pow_zero, mul_one]
    nlinarith
  have hterm (s : ℕ) (hs : s ∈ Finset.range N) :
      ‖sphericalAverage d (compactConvolution (compactDyadicDilate 𝒦 s) h) t x‖ ≤
        (C₀ + C₁) * 2 ^ N * I := by
    have h1 := (hb₁ s t ht h x).trans (mul_le_mul' le_rfl hint)
    rw [← ENNReal.ofReal_mul (by positivity), ← ofReal_norm] at h1
    apply ((ENNReal.ofReal_le_ofReal_iff (by positivity)).mp h1).trans
    exact mul_le_mul_of_nonneg_right (hj s (Finset.mem_range.mp hs).le) hI
  calc
    _ ≤ ‖sphericalAverage d (compactConvolution (compactDyadicDilate K₀ 0) h) t x‖ +
        ∑ s ∈ Finset.range N,
          ‖sphericalAverage d (compactConvolution (compactDyadicDilate 𝒦 s) h) t x‖ :=
      (norm_add_le _ _).trans (add_le_add le_rfl (norm_sum_le _ _))
    _ ≤ (C₀ + C₁) * 2 ^ N * I + ∑ _s ∈ Finset.range N, (C₀ + C₁) * 2 ^ N * I :=
      add_le_add hterm0 (Finset.sum_le_sum hterm)
    _ = _ := by rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]; ring

/-- Source Section 3.5 (lines 1510-1564 and `eq:Iaest`, `eq:IIaest`): for
inputs supported in `|y| ≤ 1/16`, the unweighted `L^p` moment of the
`E^μ`-maximal function is bounded by the `|y|^{U(p)}`-weighted input moment,
for `d ≥ 3` and `U(p) > 0`. -/
theorem sequence_near_origin_bound {d : ℕ} (hd : 2 ≤ d) {μ p : ℝ} (hμ : 0 < μ)
    (hp : 1 < p) (hα : 0 < ((d : ℝ) - 1) * (p - 1) - 1 / (μ + 1)) :
    ∃ B : ℝ≥0∞, B ≠ ∞ ∧ ∀ g : SchwartzMap (Euclidean d) ℂ, (∀ y, 1 / 16 < ‖y‖ → g y = 0) →
      (∫⁻ x, (⨆ t : sequenceSet μ, ‖sphericalAverage d g t x‖ₑ) ^ p) ≤
        B * ∫⁻ y, ‖g y‖ₑ ^ p ∂powerWeightedVolume d (((d : ℝ) - 1) * (p - 1) - 1 / (μ + 1)) := by
  classical
  obtain ⟨φ, hmass, K₀, 𝒦, hK₀, h𝒦, hflat, hRes0, hResS⟩ :=
    exists_resolution_single_kernels d (d + 1) (by omega)
  have hN : ((d : ℝ) - 1) / 2 ≤ ((d + 1 + (d + 1) : ℕ) : ℝ) := by push_cast; linarith
  obtain ⟨P, R, hPn, hPi, hPo, hRn, hRo, hdec⟩ := exists_dyadic_input_pieces d
  obtain ⟨B, hB, hbound⟩ := sequence_near_truncated_bound hd hμ hp hα K₀ 𝒦 hK₀ h𝒦 hflat hN
    P hPn hPi hPo
  obtain ⟨C, hC, hrem⟩ := exists_resolution_remainder_bound (d := d) (by omega) K₀ 𝒦
  refine ⟨B, hB, ?_⟩
  intro g hg
  have hp0 : 0 < p := by linarith
  let Fj : ℕ → sequenceSet μ → Euclidean d → ℂ := fun N t x => ∑ m ∈ Finset.Ico 4 N,
    (sphericalAverage d (compactConvolution (compactDyadicDilate K₀ 0) (P m g)) t x +
      ∑ s ∈ Finset.range N,
        sphericalAverage d (compactConvolution (compactDyadicDilate 𝒦 s) (P m g)) t x)
  -- each truncation is the spherical average of one Schwartz function
  let GN : ℕ → SchwartzMap (Euclidean d) ℂ := fun N => ∑ m ∈ Finset.Ico 4 N,
    (compactConvolution (compactDyadicDilate K₀ 0) (P m g) +
      ∑ s ∈ Finset.range N, compactConvolution (compactDyadicDilate 𝒦 s) (P m g))
  have hFG (N : ℕ) (t : ℝ) (x : Euclidean d) : sphericalAverage d (GN N) t x =
      ∑ m ∈ Finset.Ico 4 N,
        (sphericalAverage d (compactConvolution (compactDyadicDilate K₀ 0) (P m g)) t x +
          ∑ s ∈ Finset.range N,
            sphericalAverage d (compactConvolution (compactDyadicDilate 𝒦 s) (P m g)) t x) := by
    simp only [GN, sphericalAverage_schwartz_sum, sphericalAverage_schwartz_add]
  -- the truncations as resolution pieces of `g - R_N g`
  have hFres (N : ℕ) (t : ℝ) (x : Euclidean d) : sphericalAverage d (GN N) t x =
      ∑ i ∈ Finset.range (N + 1), sphericalAverage d (compactResolutionPiece φ i g) t x -
        (sphericalAverage d (compactConvolution (compactDyadicDilate K₀ 0) (R N g)) t x +
          ∑ s ∈ Finset.range N,
            sphericalAverage d (compactConvolution (compactDyadicDilate 𝒦 s) (R N g)) t x) := by
    have hsplit (i : ℕ) : sphericalAverage d (compactResolutionPiece φ i g) t x =
        ∑ m ∈ Finset.Ico 4 N, sphericalAverage d (compactResolutionPiece φ i (P m g)) t x +
          sphericalAverage d (compactResolutionPiece φ i (R N g)) t x := by
      conv_lhs => rw [hdec N g hg]
      rw [compactResolutionPiece_add, sphericalAverage_schwartz_add, compactResolutionPiece_sum,
        sphericalAverage_schwartz_sum]
    simp only [hsplit, Finset.sum_add_distrib, Finset.sum_range_succ', hRes0, hResS]
    rw [hFG, Finset.sum_comm (s := Finset.range N), Finset.sum_add_distrib]
    ring
  apply maximal_moment_le_of_tendsto volume (fun (t : sequenceSet μ) x => sphericalAverage d g t x)
    Fj hp0 _ _ _ (fun N => hbound N g)
  · intro N
    have : (fun x => ⨆ t : sequenceSet μ, ‖Fj N t x‖ₑ) =
        fun x => ⨆ t : sequenceSet μ, ‖sphericalAverage d (GN N) t x‖ₑ := by
      funext x; simp only [Fj, hFG]
    rw [this]
    exact measurable_schwartz_radius_supremum _ _
  · intro t x
    have ht1 : 1 ≤ (t : ℝ) := (sequenceSet_subset_Icc hμ.le t.2).1
    have hres := sphericalAverage_compact_resolution φ g hmass t x
    -- the remainder tends to zero
    set Mg := SchwartzMap.seminorm ℝ 0 0 g
    have hMg : 0 ≤ Mg := apply_nonneg _ _
    have hgb (N : ℕ) (y : Euclidean d) : ‖R N g y‖ ≤ Mg :=
      (hRn N g y).trans (SchwartzMap.norm_le_seminorm ℝ g y)
    set V := (volume (Metric.ball (0 : Euclidean d) 1)).toReal
    have hV : 0 ≤ V := ENNReal.toReal_nonneg
    have hremb (N : ℕ) : ‖sphericalAverage d (compactConvolution (compactDyadicDilate K₀ 0)
        (R N g)) t x + ∑ s ∈ Finset.range N,
          sphericalAverage d (compactConvolution (compactDyadicDilate 𝒦 s) (R N g)) t x‖ ≤
        C * Mg * V * 2 ^ d * (((N : ℝ) + 1) * (1 / 2) ^ N) := by
      apply (hrem N (R N g) Mg (2 * ((2 : ℝ) ^ N)⁻¹) hMg (by positivity) (hgb N)
        (hRo N g) t ht1 x).trans
      have hd1 : 1 ≤ d := by omega
      have e1 : (2 * ((2 : ℝ) ^ N)⁻¹) ^ d = 2 ^ d * (((2 : ℝ) ^ N)⁻¹) ^ d := by rw [mul_pow]
      have e2 : (((2 : ℝ) ^ N)⁻¹) ^ d ≤ ((2 : ℝ) ^ N)⁻¹ * ((2 : ℝ) ^ N)⁻¹ := by
        have h1 : ((2 : ℝ) ^ N)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (one_le_pow₀ (by norm_num))
        have h0 : 0 ≤ ((2 : ℝ) ^ N)⁻¹ := by positivity
        calc (((2 : ℝ) ^ N)⁻¹) ^ d ≤ (((2 : ℝ) ^ N)⁻¹) ^ 2 :=
              pow_le_pow_of_le_one h0 h1 (by omega)
          _ = _ := sq _
      have e3 : (2 : ℝ) ^ N * (((2 : ℝ) ^ N)⁻¹ * ((2 : ℝ) ^ N)⁻¹) = (1 / 2) ^ N := by
        rw [one_div, inv_pow]; field_simp
      rw [e1]
      calc
        _ ≤ ((N : ℝ) + 1) * (C * 2 ^ N) * (Mg * (2 ^ d * (((2 : ℝ) ^ N)⁻¹ * ((2 : ℝ) ^ N)⁻¹) *
            V)) := by gcongr
        _ = C * Mg * V * 2 ^ d * (((N : ℝ) + 1) * ((2 : ℝ) ^ N *
            (((2 : ℝ) ^ N)⁻¹ * ((2 : ℝ) ^ N)⁻¹))) := by ring
        _ = _ := by rw [e3]
    have hzero : Tendsto (fun N : ℕ => C * Mg * V * 2 ^ d * (((N : ℝ) + 1) * (1 / 2) ^ N))
        atTop (𝓝 0) := by
      have h1 := tendsto_self_mul_const_pow_of_lt_one (r := 1 / 2) (by norm_num) (by norm_num)
      have h2 := tendsto_pow_atTop_nhds_zero_of_lt_one (r := (1 / 2 : ℝ)) (by norm_num)
        (by norm_num)
      have h3 := (h1.add h2).const_mul (C * Mg * V * 2 ^ d)
      simp only [add_zero, mul_zero] at h3
      refine h3.congr fun N => ?_
      ring
    have hremt : Tendsto (fun N => sphericalAverage d (compactConvolution (compactDyadicDilate K₀ 0)
        (R N g)) t x + ∑ s ∈ Finset.range N,
          sphericalAverage d (compactConvolution (compactDyadicDilate 𝒦 s) (R N g)) t x)
        atTop (𝓝 0) := squeeze_zero_norm hremb hzero
    have := hres.sub hremt
    rw [sub_zero] at this
    refine this.congr fun N => ?_
    simp only [Fj]
    rw [← hFG, hFres]
    rfl

/-- The conjugated input `|f(y)| |y|^a` for nonnegative `a`. -/
def farInputMagnitude {d : ℕ} (f : Euclidean d → ℂ) (a : ℝ) (y : Euclidean d) : ℝ :=
  ‖f y‖ * ‖y‖ ^ a

theorem continuous_farInputMagnitude {d : ℕ} {f : Euclidean d → ℂ} (hf : Continuous f)
    {a : ℝ} (ha : 0 ≤ a) : Continuous (farInputMagnitude f a) :=
  hf.norm.mul (continuous_norm.rpow_const fun _ => Or.inr ha)

theorem farInputMagnitude_nonneg {d : ℕ} (f : Euclidean d → ℂ) (a : ℝ) (y : Euclidean d) :
    0 ≤ farInputMagnitude f a y := by
  unfold farInputMagnitude; positivity

/-- Source Section 3.5, lines 1513-1520 (the unweighted bounds away from the
origin), for positive weights: if `f` vanishes near the origin, the output
weight `|x|^a` is dominated on the sampled sphere by `65^a |y|^a`. -/
theorem farInput_maximal_conjugation {d : ℕ} {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {f : Euclidean d → ℂ} (hf : Continuous f) (hfs : ∀ y, ‖y‖ ≤ 1 / 32 → f y = 0)
    {a : ℝ} (ha : 0 < a) (x : Euclidean d) :
    ENNReal.ofReal (‖x‖ ^ a) * _root_.Spherical.M E f x ≤ ENNReal.ofReal ((65 : ℝ) ^ a) *
      _root_.Spherical.M E (fun y => (farInputMagnitude f a y : ℂ)) x := by
  by_cases hx : x = 0
  · rw [hx, norm_zero, Real.zero_rpow ha.ne', ENNReal.ofReal_zero, zero_mul]
    exact bot_le
  have hxpos : 0 < ‖x‖ := norm_pos_iff.mpr hx
  unfold _root_.Spherical.M _root_.Spherical.restrictedSphericalMaximal
  rw [ENNReal.mul_iSup]
  apply iSup_le
  intro t
  rw [ENNReal.mul_iSup]
  apply iSup_le
  intro ht
  set B := (65 : ℝ) ^ a / ‖x‖ ^ a
  have hB : 0 ≤ B := by positivity
  have hsample : ∀ ω : Metric.sphere (0 : Euclidean d) 1,
      ‖f (x + t • (ω : Euclidean d))‖ ≤ B * farInputMagnitude f a (x + t • (ω : Euclidean d)) := by
    intro ω
    set y := x + t • (ω : Euclidean d)
    by_cases hy : f y = 0
    · rw [hy, norm_zero]
      exact mul_nonneg hB (farInputMagnitude_nonneg f a y)
    have hy32 : 1 / 32 < ‖y‖ := lt_of_not_ge fun h => hy (hfs y h)
    have hω : ‖(ω : Euclidean d)‖ = 1 := mem_sphere_zero_iff_norm.mp ω.property
    have hx65 : ‖x‖ ≤ 65 * ‖y‖ := by
      have := norm_sub_le y (t • (ω : Euclidean d))
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos ht.2, hω, mul_one,
        show y - t • (ω : Euclidean d) = x by simp [y]] at this
      linarith [(hE ht.1).2]
    have hpow : ‖x‖ ^ a ≤ (65 : ℝ) ^ a * ‖y‖ ^ a := by
      rw [← Real.mul_rpow (by norm_num) (norm_nonneg _)]
      exact Real.rpow_le_rpow (norm_nonneg _) hx65 ha.le
    unfold farInputMagnitude
    have hxa : 0 < ‖x‖ ^ a := Real.rpow_pos_of_pos hxpos a
    rw [show B * (‖f y‖ * ‖y‖ ^ a) = ‖f y‖ * ((65 : ℝ) ^ a * ‖y‖ ^ a / ‖x‖ ^ a) by
      simp only [B]; ring]
    have : 1 ≤ (65 : ℝ) ^ a * ‖y‖ ^ a / ‖x‖ ^ a := by rw [le_div_iff₀ hxa]; linarith
    nlinarith [norm_nonneg (f y)]
  have h := norm_sphericalAverage_le_of_sample_bound (continuous_farInputMagnitude hf ha.le)
    (farInputMagnitude_nonneg f a) hB x hsample
  calc
    ENNReal.ofReal (‖x‖ ^ a) * ENNReal.ofReal ‖_root_.Spherical.sphericalAverage t f x‖ ≤
        ENNReal.ofReal (‖x‖ ^ a) * ENNReal.ofReal (B * ‖_root_.Spherical.sphericalAverage t
          (fun y => (farInputMagnitude f a y : ℂ)) x‖) :=
      mul_le_mul' le_rfl (ENNReal.ofReal_le_ofReal h)
    _ = ENNReal.ofReal ((65 : ℝ) ^ a) * ENNReal.ofReal ‖_root_.Spherical.sphericalAverage t
          (fun y => (farInputMagnitude f a y : ℂ)) x‖ := by
      rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
      congr 1
      simp only [B]
      field_simp
    _ ≤ _ := mul_le_mul' le_rfl (le_iSup₂_of_le t ht le_rfl)

/-- Inputs vanishing near the origin, positive weights: the conjugated
unweighted bound controls the `|x|^α`-weighted maximal moment. -/
theorem farInput_bound_of_unweighted {d : ℕ} {E : Set ℝ}
    (hEI : E ⊆ Icc (1 : ℝ) 2) {p α C : ℝ} (hp0 : 0 < p) (hα : 0 < α) (hC0 : 0 < C)
    (hC : UnweightedMaximalBound d E p C) :
    ∀ f : SchwartzMap (Euclidean d) ℂ, (∀ y, ‖y‖ ≤ 1 / 32 → f y = 0) →
      (∫⁻ x, (_root_.Spherical.M E (f : Euclidean d → ℂ) x) ^ p ∂powerWeightedVolume d α) ≤
        (ENNReal.ofReal ((65 : ℝ) ^ α) * ENNReal.ofReal C ^ p) *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂powerWeightedVolume d α := by
  intro f hfs
  set a := α / p
  have ha : 0 < a := div_pos hα hp0
  let g : Euclidean d → ℂ := fun y => (farInputMagnitude (f : Euclidean d → ℂ) a y : ℂ)
  have hg : Continuous g :=
    Complex.continuous_ofReal.comp (continuous_farInputMagnitude f.continuous ha.le)
  have hgnorm (y : Euclidean d) : ‖g y‖ = farInputMagnitude (f : Euclidean d → ℂ) a y :=
    Complex.norm_of_nonneg (farInputMagnitude_nonneg _ _ y)
  have hfpow : Measurable (fun x : Euclidean d => ENNReal.ofReal ‖f x‖ ^ p) :=
    ENNReal.continuous_rpow_const.measurable.comp f.continuous.norm.measurable.ennreal_ofReal
  have hinput : (∫⁻ x, ENNReal.ofReal ‖g x‖ ^ p) =
      ∫⁻ x, ENNReal.ofReal ‖f x‖ ^ p ∂powerWeightedVolume d α := by
    rw [powerWeightedVolume, lintegral_withDensity_eq_lintegral_mul _
      (measurable_radialPowerWeight d α) hfpow]
    apply lintegral_congr
    intro y
    change ENNReal.ofReal ‖g y‖ ^ p = radialPowerWeight d α y * ENNReal.ofReal ‖f y‖ ^ p
    rw [hgnorm, farInputMagnitude, ENNReal.ofReal_mul (norm_nonneg _),
      ENNReal.mul_rpow_of_nonneg _ _ hp0.le, radialPowerWeight,
      ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _) hp0.le,
      ← Real.rpow_mul (norm_nonneg _), div_mul_cancel₀ _ hp0.ne',
      ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hα.le, mul_comm]
  by_cases hfin : (∫⁻ x, ENNReal.ofReal ‖f x‖ ^ p ∂powerWeightedVolume d α) = ∞
  · rw [hfin, ENNReal.mul_top]
    · exact le_top
    · exact mul_ne_zero (ENNReal.ofReal_pos.mpr (by positivity)).ne' (by
        exact (ENNReal.rpow_pos (by simpa using hC0) ENNReal.ofReal_ne_top).ne')
  have hgmem : MemLp g (ENNReal.ofReal p) volume := by
    rw [memLp_iff, eLpNorm_eq_eLpNorm' (by simpa using hp0) ENNReal.ofReal_ne_top
      hg.aestronglyMeasurable, eLpNorm'_eq_lintegral_enorm, ENNReal.toReal_ofReal hp0.le]
    apply ENNReal.rpow_lt_top_of_nonneg (by positivity)
    simp only [← ofReal_norm]
    rw [hinput]
    exact hfin
  obtain ⟨hMg, hbound⟩ := hC g hgmem
  have hmoment : (∫⁻ x, (_root_.Spherical.M E g x) ^ p) ≤
      ENNReal.ofReal C ^ p * ∫⁻ x, ENNReal.ofReal ‖g x‖ ^ p := by
    simpa only [enorm_eq_self, ofReal_norm] using
      lintegral_enorm_rpow_le_of_eLpNorm_le volume hp0 (ENNReal.ofReal C)
        (_root_.Spherical.M E g) g hbound hMg.aestronglyMeasurable hg.aestronglyMeasurable
  have hMf : Measurable (_root_.Spherical.M E (f : Euclidean d → ℂ)) := by
    change Measurable (_root_.Spherical.restrictedSphericalMaximal E (f : Euclidean d → ℂ))
    rw [restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal]
    exact measurable_restrictedNormalizedSphericalMaximal E _ f.continuous
  have hMgm : Measurable (_root_.Spherical.M E g) := by
    change Measurable (_root_.Spherical.restrictedSphericalMaximal E g)
    rw [restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal]
    exact measurable_restrictedNormalizedSphericalMaximal E _ hg
  have hpoint (x : Euclidean d) :
      radialPowerWeight d α x * (_root_.Spherical.M E (f : Euclidean d → ℂ) x) ^ p ≤
        ENNReal.ofReal ((65 : ℝ) ^ α) * (_root_.Spherical.M E g x) ^ p := by
    have hw : radialPowerWeight d α x = ENNReal.ofReal (‖x‖ ^ a) ^ p := by
      rw [radialPowerWeight, ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)
        hp0.le, ← Real.rpow_mul (norm_nonneg _), div_mul_cancel₀ _ hp0.ne',
        ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hα.le]
    have h65 : ENNReal.ofReal ((65 : ℝ) ^ α) = ENNReal.ofReal ((65 : ℝ) ^ a) ^ p := by
      rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) hp0.le, ← Real.rpow_mul (by norm_num),
        div_mul_cancel₀ _ hp0.ne']
    rw [hw, h65, ← ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
    exact ENNReal.rpow_le_rpow (farInput_maximal_conjugation hEI f.continuous hfs ha x) hp0.le
  have hMfpow : Measurable (fun x => (_root_.Spherical.M E (f : Euclidean d → ℂ) x) ^ p) :=
    ENNReal.continuous_rpow_const.measurable.comp hMf
  conv_lhs =>
    rw [powerWeightedVolume, lintegral_withDensity_eq_lintegral_mul _
      (measurable_radialPowerWeight d α) hMfpow]
  calc
    (∫⁻ x, (radialPowerWeight d α *
        fun x => (_root_.Spherical.M E (f : Euclidean d → ℂ) x) ^ p) x) ≤
        ∫⁻ x, ENNReal.ofReal ((65 : ℝ) ^ α) * (_root_.Spherical.M E g x) ^ p :=
      lintegral_mono hpoint
    _ = ENNReal.ofReal ((65 : ℝ) ^ α) * ∫⁻ x, (_root_.Spherical.M E g x) ^ p :=
      lintegral_const_mul _ (ENNReal.continuous_rpow_const.measurable.comp hMgm)
    _ ≤ ENNReal.ofReal ((65 : ℝ) ^ α) *
        (ENNReal.ofReal C ^ p * ∫⁻ x, ENNReal.ofReal ‖g x‖ ^ p) := mul_le_mul' le_rfl hmoment
    _ = _ := by rw [hinput, mul_assoc]

theorem UnweightedMaximalBound.mono_const {d : ℕ} {E : Set ℝ} {p C C' : ℝ} (hCC : C ≤ C')
    (hC : UnweightedMaximalBound d E p C) : UnweightedMaximalBound d E p C' := by
  intro f hf
  obtain ⟨hM, hb⟩ := hC f hf
  exact ⟨hM, hb.trans (mul_le_mul' (ENNReal.ofReal_le_ofReal hCC) le_rfl)⟩

/-- Source Section 3.5 (`Boundedness for M_{E^μ} when α = U(p)`): for `d ≥ 2`
and `p > p(μ)`, the local maximal operator `M_{E^μ}` is bounded on
`L^p(|x|^{U(p)})`, `U(p) = (d-1)(p-1) - 1/(μ+1)`, for every weighted `L^p`
input. -/
theorem sequence_upper_endpoint_bound {d : ℕ} (hd : 2 ≤ d) {μ p : ℝ} (hμ : 0 < μ)
    (hp : sequenceCriticalExponent d μ < p) :
    WeightedMaximalBound d (sequenceSet μ) p (sequenceUpperEndpoint d μ p) := by
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hn : 0 < (d : ℝ) - 1 := by linarith
  have hμ1 : 0 < μ + 1 := by linarith
  have hα : 0 < ((d : ℝ) - 1) * (p - 1) - 1 / (μ + 1) := by
    unfold sequenceCriticalExponent at hp
    have h1 : 1 / ((μ + 1) * ((d : ℝ) - 1)) < p - 1 := by linarith
    rw [div_lt_iff₀ (by positivity)] at h1
    have : 1 / (μ + 1) < ((d : ℝ) - 1) * (p - 1) := by
      rw [div_lt_iff₀ hμ1]; nlinarith
    linarith
  have hp1 : 1 < p := by
    unfold sequenceCriticalExponent at hp
    have : 0 < 1 / ((μ + 1) * ((d : ℝ) - 1)) := by positivity
    linarith
  have hp0 : 0 < p := by linarith
  set α := sequenceUpperEndpoint d μ p with hαdef
  have hαeq : α = ((d : ℝ) - 1) * (p - 1) - 1 / (μ + 1) := rfl
  have hα0 : 0 < α := hα
  have hEI : sequenceSet μ ⊆ Icc 1 2 := sequenceSet_subset_Icc hμ.le
  have hEpos : sequenceSet μ ⊆ Ioi 0 := sequenceSet_subset_Ioi hμ.le
  obtain ⟨U, hU⟩ := sequence_unweighted_bound (by omega) hμ hp
  have hU' := hU.mono_const (le_max_left U 1)
  have hU0 : 0 < max U 1 := lt_of_lt_of_le one_pos (le_max_right _ _)
  obtain ⟨Bn, hBn, hnear⟩ := sequence_near_origin_bound hd hμ hp1 hα
  obtain ⟨χ, hχ1, hχ0, hχn⟩ := exists_schwartz_spatial_ball_cutoff d (1 / 32) (by norm_num)
  set Mσ : ℝ≥0∞ := ‖(surfaceMass d : ℂ)‖ₑ ^ p
  set K : ℝ≥0∞ := 2 ^ p * (ENNReal.ofReal ((3 : ℝ) ^ α) * Bn +
    Mσ * ((ENNReal.ofReal ((65 : ℝ) ^ α) * ENNReal.ofReal (max U 1) ^ p) * 2 ^ p))
  have hK : K ≠ ∞ := by finiteness
  have hcore : CoreMomentBoundAt α (powerWeightedVolume d α) (sequenceSet μ) p K.toReal := by
    intro g
    rw [ENNReal.ofReal_toReal hK]
    set w := powerWeightedVolume d α
    set Q := ∫⁻ y, ‖g y‖ₑ ^ p ∂w
    let Nr := SchwartzMap.smulLeftCLM ℂ (χ : Euclidean d → ℂ) g
    have hNr (y) : Nr y = χ y * g y := by
      simp only [Nr, SchwartzMap.smulLeftCLM_apply χ.hasTemperateGrowth, smul_eq_mul]
    let Fa := g - Nr
    have hFa (y) : Fa y = (1 - χ y) * g y := by
      simp only [Fa, sub_apply, hNr]; ring
    have hsplit : g = Nr + Fa := by simp only [Fa]; abel
    -- near part
    have hNrs : ∀ y, 1 / 16 < ‖y‖ → Nr y = 0 := by
      intro y hy
      rw [hNr, hχ0 y (by linarith), zero_mul]
    have hNrn (y) : ‖Nr y‖ ≤ ‖g y‖ := by
      rw [hNr, norm_mul]
      exact mul_le_of_le_one_left (norm_nonneg _) (hχn y)
    have hnearw : (∫⁻ x, (⨆ t : sequenceSet μ, ‖sphericalAverage d Nr t x‖ₑ) ^ p ∂w) ≤
        ENNReal.ofReal ((3 : ℝ) ^ α) * Bn * Q := by
      have hF := (measurable_schwartz_radius_supremum Nr (sequenceSet μ)).pow_const p
      rw [show w = powerWeightedVolume d α from rfl, powerWeightedVolume,
        lintegral_withDensity_eq_lintegral_mul _ (measurable_radialPowerWeight d α) hF]
      calc
        _ ≤ ∫⁻ x, ENNReal.ofReal ((3 : ℝ) ^ α) *
            (⨆ t : sequenceSet μ, ‖sphericalAverage d Nr t x‖ₑ) ^ p := by
          apply lintegral_mono
          intro x
          simp only [Pi.mul_apply]
          by_cases hx : ‖x‖ ≤ 3
          · apply mul_le_mul' _ le_rfl
            rw [radialPowerWeight, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hα0.le]
            exact ENNReal.ofReal_le_ofReal (Real.rpow_le_rpow (norm_nonneg _) hx hα0.le)
          · have h0 : ∀ t : sequenceSet μ, sphericalAverage d Nr t x = 0 := fun t =>
              sphericalAverage_eq_zero_of_far Nr hNrs (by linarith [(hEI t.2).1])
                (by linarith [(hEI t.2).2])
            simp [h0, ENNReal.zero_rpow_of_pos hp0]
        _ = ENNReal.ofReal ((3 : ℝ) ^ α) *
            ∫⁻ x, (⨆ t : sequenceSet μ, ‖sphericalAverage d Nr t x‖ₑ) ^ p :=
          lintegral_const_mul _ hF
        _ ≤ ENNReal.ofReal ((3 : ℝ) ^ α) * (Bn * ∫⁻ y, ‖Nr y‖ₑ ^ p ∂w) :=
          mul_le_mul' le_rfl (hnear Nr hNrs)
        _ ≤ ENNReal.ofReal ((3 : ℝ) ^ α) * (Bn * Q) := by
          apply mul_le_mul' le_rfl (mul_le_mul' le_rfl (lintegral_mono fun y =>
            ENNReal.rpow_le_rpow ?_ hp0.le))
          rw [← ofReal_norm, ← ofReal_norm]
          exact ENNReal.ofReal_le_ofReal (hNrn y)
        _ = _ := by ring
    -- far part
    have hFas : ∀ y, ‖y‖ ≤ 1 / 32 → Fa y = 0 := by
      intro y hy
      rw [hFa, hχ1 y hy, sub_self, zero_mul]
    have hFan (y) : ‖Fa y‖ ≤ 2 * ‖g y‖ := by
      rw [hFa, norm_mul]
      have : ‖1 - χ y‖ ≤ 2 := (norm_sub_le _ _).trans (by
        rw [norm_one]; linarith [hχn y])
      exact mul_le_mul_of_nonneg_right this (norm_nonneg _)
    have hfarw : (∫⁻ x, (⨆ t : sequenceSet μ, ‖sphericalAverage d Fa t x‖ₑ) ^ p ∂w) ≤
        Mσ * ((ENNReal.ofReal ((65 : ℝ) ^ α) * ENNReal.ofReal (max U 1) ^ p) * (2 ^ p * Q)) := by
      apply spherical_moment_le_of_normalized (by omega) _ hEpos Fa w hp0.le
      have h := farInput_bound_of_unweighted hEI hp0 hα0 hU0 hU' Fa hFas
      have hMeq : _root_.Spherical.M (sequenceSet μ) (Fa : Euclidean d → ℂ) =
          restrictedNormalizedSphericalMaximal d (sequenceSet μ) Fa := by
        change _root_.Spherical.restrictedSphericalMaximal _ _ = _
        rw [restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal]
      rw [← hMeq]
      apply h.trans
      apply mul_le_mul' le_rfl
      rw [← lintegral_const_mul' _ _ (by finiteness)]
      apply lintegral_mono
      intro y
      dsimp only
      rw [← ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
      apply ENNReal.rpow_le_rpow _ hp0.le
      rw [← ofReal_norm]
      exact (ENNReal.ofReal_le_ofReal (hFan y)).trans_eq
        (by rw [ENNReal.ofReal_mul (by norm_num)]; norm_num)
    rw [hsplit]
    apply (schwartz_spherical_maximal_moment_add_le Nr Fa _ w hp0.le).trans
    calc
      _ ≤ (2 : ℝ≥0∞) ^ p * (ENNReal.ofReal ((3 : ℝ) ^ α) * Bn * Q +
          Mσ * ((ENNReal.ofReal ((65 : ℝ) ^ α) * ENNReal.ofReal (max U 1) ^ p) * (2 ^ p * Q))) :=
        mul_le_mul' le_rfl (add_le_add hnearw hfarw)
      _ = K * Q := by simp only [K]; ring
      _ = _ := rfl
  exact weighted_bound_of_normalized_strongType (by omega) _ hp1 (by linarith)
    (normalized_strongType_of_core_moment_at _ hp1 hcore)

/-- Source `thm:sequences` (Theorem 1.3) for `d ≥ 2`: for `p(μ) < p < ∞`,
`M_{E^μ}` is bounded on `L^p(|x|^α)` if and only if
`d/(d-1) < p` and `1-d ≤ α ≤ U(p)`, or `p = d/(d-1)` and `1-d < α ≤ U(p)`, or
`p < d/(d-1)` and `1-d+(d-(d-1)p)/μ ≤ α ≤ U(p)`, where
`U(p) = (d-1)(p-1) - 1/(μ+1)`. -/
theorem sequence_iff {d : ℕ} (hd : 2 ≤ d) {μ p α : ℝ} (hμ : 0 < μ)
    (hp : sequenceCriticalExponent d μ < p) :
    WeightedMaximalBound d (sequenceSet μ) p α ↔
      ((d : ℝ) / ((d : ℝ) - 1) < p ∧ 1 - (d : ℝ) ≤ α ∧ α ≤ sequenceUpperEndpoint d μ p) ∨
      (p = (d : ℝ) / ((d : ℝ) - 1) ∧ 1 - (d : ℝ) < α ∧ α ≤ sequenceUpperEndpoint d μ p) ∨
      (p < (d : ℝ) / ((d : ℝ) - 1) ∧
        1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ ≤ α ∧
          α ≤ sequenceUpperEndpoint d μ p) := by
  have hd2 : 2 ≤ d := by omega
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hn : 0 < (d : ℝ) - 1 := by linarith
  have hp1 : 1 < p := by
    unfold sequenceCriticalExponent at hp
    have : 0 < 1 / ((μ + 1) * ((d : ℝ) - 1)) := by
      have : 0 < μ + 1 := by linarith
      positivity
    linarith
  constructor
  · intro h
    obtain ⟨_, hL, hU⟩ := sequence_necessary hd2 hμ hp1.le h
    rcases lt_trichotomy ((d : ℝ) / ((d : ℝ) - 1)) p with hgt | heq | hlt
    · rw [sequenceLowerEndpoint_of_ge hd2 hμ hgt.le] at hL
      exact Or.inl ⟨hgt, hL, hU⟩
    · rw [sequenceLowerEndpoint_of_ge hd2 hμ heq.le] at hL
      refine Or.inr (Or.inl ⟨heq.symm, lt_of_le_of_ne hL ?_, hU⟩)
      rintro rfl
      exact sequence_critical_unbounded hd2 hμ (heq ▸ h)
    · rw [sequenceLowerEndpoint_of_le hd2 hμ hlt.le] at hL
      exact Or.inr (Or.inr ⟨hlt, hL, hU⟩)
  · intro h
    have hU : α ≤ sequenceUpperEndpoint d μ p := by
      rcases h with ⟨_, _, h⟩ | ⟨_, _, h⟩ | ⟨_, _, h⟩ <;> exact h
    have hL : sequenceLowerEndpoint d μ p ≤ α := by
      rcases h with ⟨h1, h2, _⟩ | ⟨h1, h2, _⟩ | ⟨h1, h2, _⟩
      · rw [sequenceLowerEndpoint_of_ge hd2 hμ h1.le]; exact h2
      · rw [sequenceLowerEndpoint_of_ge hd2 hμ h1.ge]; exact h2.le
      · rw [sequenceLowerEndpoint_of_le hd2 hμ h1.le]; exact h2
    rcases eq_or_lt_of_le hU with hαU | hαU
    · rw [hαU]; exact sequence_upper_endpoint_bound hd2 hμ hp
    rcases eq_or_lt_of_le hL with hαL | hαL
    · -- the lower endpoint
      rcases lt_trichotomy ((d : ℝ) / ((d : ℝ) - 1)) p with hgt | heq | hlt
      · rw [sequenceLowerEndpoint_of_ge hd2 hμ hgt.le] at hαL
        rw [← hαL]
        apply general_assouad_maximal_endpoint hd2 (sequenceSet_subset_Ioi hμ.le)
        have hγ := uniformAssouadDimension_le_one (sequenceSet μ)
        have : uniformAssouadDimension (sequenceSet μ) / ((d : ℝ) - 1) ≤ 1 / ((d : ℝ) - 1) :=
          div_le_div_of_nonneg_right hγ hn.le
        have hpd : 1 + 1 / ((d : ℝ) - 1) = (d : ℝ) / ((d : ℝ) - 1) := by field_simp; ring
        linarith
      · exfalso
        rcases h with ⟨h1, _, _⟩ | ⟨_, h2, _⟩ | ⟨h1, _, _⟩
        · linarith
        · rw [sequenceLowerEndpoint_of_ge hd2 hμ heq.le] at hαL; linarith
        · linarith
      · rw [← hαL]
        exact sequence_lower_endpoint_bound hd2 hμ hp hlt
    · exact sequence_interior_bound hd2 hμ hp hαL hαU
end

