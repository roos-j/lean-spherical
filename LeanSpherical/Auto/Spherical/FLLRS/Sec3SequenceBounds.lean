/-- All positive compact-synthesis scales have the same genuine top bound. -/
theorem compactSynthesis_uniform_max_top
    (φ : SchwartzMap (Euclidean 2) Complex) :
    ∃ B : Real,0 < B ∧ ∀ j : ℕ,0 < j →
      ∀ f : SchwartzMap (Euclidean 2) Complex,∀ a : Real,0 ≤ a →
      (∀ x,‖f x‖ ≤ a) → ∀ x : Euclidean 2,
      (⨆ t : Icc (1:Real) 2,
        ‖sphericalAverage 2 (compactConvolution (compactSynthesisKernel φ j) f) t x‖ₑ).toReal ≤ B*a := by
  let M : Real := ∫ y,‖compactSynthesisKernel φ 1 y‖
  let B : Real := M*surfaceMass 2+1
  have hM : 0 ≤ M := integral_nonneg (fun _ => norm_nonneg _)
  have hsurface : 0 < surfaceMass 2 := surfaceMass_pos (by norm_num)
  have hB : 0 < B := by dsimp only [B]; positivity
  refine ⟨B,hB,?_⟩
  intro j hj f a ha hfa x
  obtain ⟨i,rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hj)
  have hmass : (∫ y,‖compactSynthesisKernel φ (i+1) y‖) = M := by
    rw [compactSynthesisKernel_succ]
    exact integral_norm_dilate_eq 2 (compactSynthesisKernel φ 1 : Euclidean 2 → Complex)
      (by positivity : (0:Real) < 2^i)
  have hc (y : Euclidean 2) : ‖compactConvolution (compactSynthesisKernel φ (i+1)) f y‖ ≤ a*M := by
    rw [compactConvolution,SchwartzMap.convolution_apply]
    change ‖∫ z,compactSynthesisKernel φ (i+1) z*f (y-z)‖ ≤ _
    apply (norm_integral_le_of_norm_le
      ((compactSynthesisKernel φ (i+1)).integrable.norm.mul_const a)
      (Filter.Eventually.of_forall (fun z => by
        rw [norm_mul]
        exact mul_le_mul_of_nonneg_left (hfa _) (norm_nonneg _)))).trans_eq
    rw [integral_mul_const,hmass,mul_comm]
  have hav (t : Real) :
      ‖sphericalAverage 2 (compactConvolution (compactSynthesisKernel φ (i+1)) f) t x‖ ≤ B*a := by
    apply (norm_sphericalAverage_le_surfaceMass_mul 2 _ t x hc).trans
    dsimp only [B]
    nlinarith
  have hh : (⨆ t : Icc (1:Real) 2,
        ‖sphericalAverage 2 (compactConvolution (compactSynthesisKernel φ (i+1)) f) t x‖ₑ) ≤ ENNReal.ofReal (B*a) := by
    apply iSup_le
    intro t
    simpa only [ofReal_norm] using ENNReal.ofReal_le_ofReal (hav t)
  exact (ENNReal.toReal_mono ENNReal.ofReal_ne_top hh).trans_eq
    (ENNReal.toReal_ofReal (mul_nonneg hB.le ha))

/-- The actual compact top bound extends a genuine fourth shell gain to
every exponent above four, with the same fourth-moment dyadic decay. -/
theorem synthesis_planar_shell_above_four_of_four_gain
    (φ : SchwartzMap (Euclidean 2) Complex)
    {p δ : Real} (hp : 4 < p) (A₄ : ENNReal) (hA₄ : A₄ ≠ ⊤)
    (k₀ : ℕ) (hk₀ : 1 ≤ k₀)
    (hFour : ∀ k : ℕ,k₀ ≤ k → ∀ n : ℕ,∀ g : SchwartzMap (Euclidean 2) Complex,
      (∫⁻ x in euclideanAnnulus 2 ((((2:Real)^k)⁻¹)/2) (((2:Real)^k)⁻¹),
        (⨆ t : Icc (1:Real) 2,‖sphericalAverage 2
          (compactConvolution (compactSynthesisKernel φ (k+n)) g) t x‖ₑ)^(4:Real)
          ∂powerWeightedVolume 2 (-1)) ≤
        A₄*(2:ENNReal)^(-δ*(n:Real))*(∫⁻ x,‖g x‖ₑ^(4:Real))) :
    ∃ A : ENNReal,A ≠ ⊤ ∧ ∀ k : ℕ,k₀ ≤ k → ∀ n : ℕ,
      ∀ f : SchwartzMap (Euclidean 2) Complex,
      (∫⁻ x in euclideanAnnulus 2 ((((2:Real)^k)⁻¹)/2) (((2:Real)^k)⁻¹),
        (⨆ t : Icc (1:Real) 2,‖sphericalAverage 2
          (compactConvolution (compactSynthesisKernel φ (k+n)) f) t x‖ₑ)^p
          ∂powerWeightedVolume 2 (-1)) ≤
        A*(2:ENNReal)^(-δ*(n:Real))*(∫⁻ x,‖f x‖ₑ^p) := by
  obtain ⟨B,hB,htop⟩ := compactSynthesis_uniform_max_top φ
  let C : ENNReal := (ENNReal.ofReal p*(2:ENNReal)^(4:Real)*
    (ENNReal.ofReal (p-4))⁻¹*(4:ENNReal)^(p-4))*A₄*ENNReal.ofReal B^(p-4)
  have hC : C ≠ ⊤ := by
    dsimp only [C]
    finiteness
  refine ⟨C,hC,?_⟩
  intro k hk n f
  let K := compactSynthesisKernel φ (k+n)
  let : IsFiniteMeasureOnCompacts (powerWeightedVolume 2 (-1)) :=
    powerWeightedVolume_isFiniteMeasureOnCompacts (by norm_num) (by norm_num)
  let ν := (powerWeightedVolume 2 (-1)).restrict
    (euclideanAnnulus 2 ((((2:Real)^k)⁻¹)/2) (((2:Real)^k)⁻¹))
  let T := fun (g : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) =>
    (⨆ t : Icc (1:Real) 2,‖sphericalAverage 2 (compactConvolution K g) t x‖ₑ).toReal
  have hTsub (g h : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
      T (g+h) x ≤ T g x+T h x := by
    dsimp only [T]
    rw [compactConvolution_add_right]
    have hcoe : ((compactConvolution K g+compactConvolution K h :
        SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex) =
      (compactConvolution K g : Euclidean 2 → Complex)+(compactConvolution K h : Euclidean 2 → Complex) := rfl
    rw [hcoe]
    simpa only [ofReal_norm] using
      Auto.Spherical.Auxiliary.toReal_iSup_ennreal_norm_sphericalAverage_add_le
        (compactConvolution K g) (compactConvolution K h)
        (compactConvolution K g).continuous (compactConvolution K h).continuous
        (by norm_num : (1:Real) ≤ 2) x
  have hT (g : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
      ENNReal.ofReal (T g x) = ⨆ t : Icc (1:Real) 2,
        ‖sphericalAverage 2 (compactConvolution K g) t x‖ₑ := by
    apply ENNReal.ofReal_toReal
    simpa only [ofReal_norm] using
      Auto.Spherical.Auxiliary.iSup_ennreal_norm_sphericalAverage_ne_top
        (compactConvolution K g) (compactConvolution K g).continuous
        (by norm_num : (1:Real) ≤ 2) x
  have hh := Auto.Spherical.MSS.schwartz_sublinear_q_top_moment_on_support_scaled
    ν Set.univ T (fun _ _ => ENNReal.toReal_nonneg) hTsub
    (fun g => (measurable_schwartz_radius_supremum (compactConvolution K g)
      (Icc (1:Real) 2)).ennreal_toReal.aemeasurable)
    (by norm_num : (0:Real) < 4) hp (A₄*(2:ENNReal)^(-δ*(n:Real))) B hB
    (fun g _ => by simpa only [hT] using hFour k hk n g)
    (fun g _ a ha hga x => htop (k+n) (by omega) g a ha hga x)
    f (fun x hx => (hx (Set.mem_univ x)).elim)
  simpa only [hT,C,mul_assoc,mul_comm,mul_left_comm] using hh
/-- A genuine scalar fourth-moment shell gain yields the repair's
quantitative scalar synthesis estimate for every finite p greater than two. -/
theorem synthesis_planar_shell_all_p_of_four_gain {N : ℕ}
    (φ : SchwartzMap (Euclidean 2) Complex)
    (hflat : Asymptotics.IsBigO (𝓝 (0:Euclidean 2))
      (fun ξ => 𝓕 φ ξ-1) (fun ξ => ‖ξ‖^N))
    (hN : (1:Real)/2 ≤ N) (hφ : ∀ x,(1:Real)/8 < ‖x‖ → φ x = 0)
    (A₄ : ENNReal) (hA₄ : A₄ ≠ ⊤) {δ : Real} (hδ : 0 < δ)
    (hFour : ∀ k : ℕ,7 ≤ k → ∀ n : ℕ,∀ g : SchwartzMap (Euclidean 2) Complex,
      (∫⁻ x in euclideanAnnulus 2 ((((2:Real)^k)⁻¹)/2) (((2:Real)^k)⁻¹),
        (⨆ t : Icc (1:Real) 2,‖sphericalAverage 2
          (compactConvolution (compactSynthesisKernel φ (k+n)) g) t x‖ₑ)^(4:Real)
          ∂powerWeightedVolume 2 (-1)) ≤
        A₄*(2:ENNReal)^(-δ*(n:Real))*(∫⁻ x,‖g x‖ₑ^(4:Real)))
    {p : Real} (hp : 2 < p) :
    let e : Real := if p < 4 then δ*(p-2)/2 else δ
    0 < e ∧ ∃ A : ENNReal,A ≠ ⊤ ∧ ∀ k : ℕ,7 ≤ k → ∀ n : ℕ,
      ∀ g : SchwartzMap (Euclidean 2) Complex,
      (∫⁻ x in euclideanAnnulus 2 ((((2:Real)^k)⁻¹)/2) (((2:Real)^k)⁻¹),
        (⨆ t : Icc (1:Real) 2,‖sphericalAverage 2
          (compactConvolution (compactSynthesisKernel φ (k+n)) g) t x‖ₑ)^p
          ∂powerWeightedVolume 2 (-1)) ≤
        A*(2:ENNReal)^(-e*(n:Real))*(∫⁻ x,‖g x‖ₑ^p) := by
  classical
  let : IsFiniteMeasureOnCompacts (powerWeightedVolume 2 (-1)) :=
    powerWeightedVolume_isFiniteMeasureOnCompacts (by norm_num) (by norm_num)
  by_cases hp4 : p < 4
  · dsimp only
    rw [ite_eq_left hp4]
    refine ⟨by positivity,?_⟩
    obtain ⟨A₂,hA₂,hTwo⟩ := synthesis_planar_shell_two_bound φ hflat hN hφ
    obtain ⟨B,hB,hA⟩ := finite_constant_le_fourth A₄ hA₄
    let C : ENNReal := Auto.Spherical.MSS.schwartzTwoFourMomentConstant p A₂*
      ENNReal.ofReal B^(2*p-4)
    have hC : C ≠ ⊤ := ENNReal.mul_ne_top
      (Auto.Spherical.MSS.schwartzTwoFourMomentConstant_ne_top hp hp4 hA₂)
      (ENNReal.rpow_ne_top_of_nonneg (by linarith) ENNReal.ofReal_ne_top)
    refine ⟨C,hC,?_⟩
    intro k hk n g
    have hStrongTwo (f : SchwartzMap (Euclidean 2) Complex) :
        (∫⁻ x in euclideanAnnulus 2 ((((2:Real)^k)⁻¹)/2) (((2:Real)^k)⁻¹),
          (⨆ t : Icc (1:Real) 2,‖sphericalAverage 2
            (compactConvolution (compactSynthesisKernel φ (k+n)) f) t x‖ₑ)^(2:Real)
            ∂powerWeightedVolume 2 (-1)) ≤ A₂*(∫⁻ x,‖f x‖ₑ^(2:Real)) :=
      hTwo (Icc 1 2) Subset.rfl (k+n) k (by omega) (by omega) f
    have hStrongFour (f : SchwartzMap (Euclidean 2) Complex) :
        (∫⁻ x in euclideanAnnulus 2 ((((2:Real)^k)⁻¹)/2) (((2:Real)^k)⁻¹),
          (⨆ t : Icc (1:Real) 2,‖sphericalAverage 2
            (compactConvolution (compactSynthesisKernel φ (k+n)) f) t x‖ₑ)^(4:Real)
            ∂powerWeightedVolume 2 (-1)) ≤
          ENNReal.ofReal B^(4:Real)*ENNReal.ofReal ((2:Real)^n)^(-(4*(δ/4)))*
            (∫⁻ x,‖f x‖ₑ^(4:Real)) := by
      have he : ENNReal.ofReal ((2:Real)^n)^(-(4*(δ/4))) = (2:ENNReal)^(-δ*(n:Real)) := by
        rw [ENNReal.ofReal_pow (by norm_num : (0:Real) ≤ 2),ENNReal.ofReal_ofNat,
          ← ENNReal.rpow_natCast,← ENNReal.rpow_mul]
        congr 1
        ring
      rw [he]
      exact (hFour k hk n f).trans (mul_le_mul' (mul_le_mul' hA le_rfl) le_rfl)
    have hh := compact_synthesis_two_four_shell_gain (compactSynthesisKernel φ (k+n))
      ((powerWeightedVolume 2 (-1)).restrict (euclideanAnnulus 2
        ((((2:Real)^k)⁻¹)/2) (((2:Real)^k)⁻¹)))
      hp hp4 A₂ hB (by positivity : (0:Real) < 2^n) (by positivity : 0 < δ/4)
      hStrongTwo hStrongFour g
    have he : ENNReal.ofReal ((2:Real)^n)^(-(2*(δ/4)*(p-2))) =
        (2:ENNReal)^(-(δ*(p-2)/2)*(n:Real)) := by
      rw [ENNReal.ofReal_pow (by norm_num : (0:Real) ≤ 2),ENNReal.ofReal_ofNat,
        ← ENNReal.rpow_natCast,← ENNReal.rpow_mul]
      congr 1
      ring
    simpa only [he,C] using hh
  · dsimp only
    rw [ite_eq_right hp4]
    refine ⟨hδ,?_⟩
    rcases eq_or_lt_of_le (le_of_not_gt hp4) with rfl | hp4
    · exact ⟨A₄,hA₄,hFour⟩
    · exact synthesis_planar_shell_above_four_of_four_gain φ hp4 A₄ hA₄ 7 (by norm_num) hFour
/-- Independent repair Proposition 3.1: the actual planar compact-synthesis
shell operator has positive uniform dyadic decay for every finite p>2. -/
theorem exists_synthesis_planar_shell_all_p_gain {N : ℕ}
    (φ : SchwartzMap (Euclidean 2) Complex) (hmass : ∫ x,φ x = 1)
    (hflat : Asymptotics.IsBigO (𝓝 (0:Euclidean 2))
      (fun ξ => 𝓕 φ ξ-1) (fun ξ => ‖ξ‖^N))
    (hN : (1:Real)/2 ≤ N) (hφ : ∀ x,(1:Real)/8 < ‖x‖ → φ x = 0)
    {p : Real} (hp : 2 < p) :
    let e : Real := if p < 4 then (p-2)/32 else 1/16
    0 < e ∧ ∃ A : ENNReal,A ≠ ⊤ ∧ ∀ k : ℕ,7 ≤ k → ∀ n : ℕ,
      ∀ E : Set Real,E ⊆ Icc 1 2 → ∀ g : SchwartzMap (Euclidean 2) Complex,
      (∫⁻ x in euclideanAnnulus 2 ((((2:Real)^k)⁻¹)/2) (((2:Real)^k)⁻¹),
        (⨆ t : E,‖sphericalAverage 2
          (compactConvolution (compactSynthesisKernel φ (k+n)) g) t x‖ₑ)^p
          ∂powerWeightedVolume 2 (-1)) ≤
        A*(2:ENNReal)^(-e*(n:Real))*(∫⁻ x,‖g x‖ₑ^p) := by
  classical
  obtain ⟨D,_,hFour⟩ := exists_synthesis_planar_shell_four_gain φ hmass hφ
  have hh := synthesis_planar_shell_all_p_of_four_gain φ hflat hN hφ
    (ENNReal.ofReal D) ENNReal.ofReal_ne_top (by norm_num : (0:Real) < 1/16)
    (fun k hk n g => by
      simpa only [show -(1/16:Real)*(n:Real) = -(n:Real)/16 by ring] using
        hFour k n hk (Icc 1 2) Subset.rfl g) hp
  have heq : (if p < 4 then (1/16:Real)*(p-2)/2 else 1/16) =
      (if p < 4 then (p-2)/32 else 1/16) := by split_ifs <;> ring
  rw [heq] at hh
  obtain ⟨he,A,hA,hgain⟩ := hh
  refine ⟨he,A,hA,?_⟩
  intro k hk n E hE g
  apply (lintegral_mono (fun x => ENNReal.rpow_le_rpow ?_ (by linarith : (0:Real) ≤ p))).trans
    (hgain k hk n g)
  apply iSup_le
  intro t
  exact le_iSup (fun s : Icc (1:Real) 2 => ‖sphericalAverage 2
    (compactConvolution (compactSynthesisKernel φ (k+n)) g) s x‖ₑ) ⟨t.1,hE t.2⟩
