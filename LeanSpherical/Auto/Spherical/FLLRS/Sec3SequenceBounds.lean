  have hδ1 : δ ≤ 1 := hδD.trans hD1
  have hμ1 : 0 < μ + 1 := by linarith
  set s := sequenceLegendreAssouad μ ρ with hs
  have hs1 : 1 / (μ + 1) ≤ s := le_trans (le_max_left _ _) (le_max_left _ _)
  have hs2 : (μ * ρ + 1) / (μ + 1) ≤ s := le_trans (le_max_right _ _) (le_max_left _ _)
  have hs3 : ρ ≤ s := le_max_right _ _
  have key : ∀ x ≤ s, δ ^ (-x) ≤ δ ^ (-s) := fun x hx =>
    Real.rpow_le_rpow_of_exponent_ge hδ hδ1 (by linarith)
  set D₀ := δ ^ (μ / (μ + 1)) with hD₀
  have hD₀pos : 0 < D₀ := Real.rpow_pos_of_pos hδ _
  have hsplit : μ / (μ + 1) + 1 / (μ + 1) = 1 := by field_simp
  rcases le_total D₀ D with hbig | hsmall
  · -- large windows: use the global count
    apply (mul_le_mul_of_nonneg_left (min_le_right _ _) (Real.rpow_nonneg hD.le _)).trans
    rcases le_or_gt 0 ρ with hρ | hρ
    · have h1 : D ^ (-ρ) ≤ D₀ ^ (-ρ) :=
        Real.rpow_le_rpow_of_nonpos hD₀pos hbig (by linarith)
      have h2 : D₀ ^ (-ρ) * δ ^ (-(1 / (μ + 1))) = δ ^ (-((μ * ρ + 1) / (μ + 1))) := by
        rw [hD₀, ← Real.rpow_mul hδ.le, ← Real.rpow_add hδ]
        congr 1
        field_simp
        ring
      calc D ^ (-ρ) * δ ^ (-(1 / (μ + 1))) ≤ D₀ ^ (-ρ) * δ ^ (-(1 / (μ + 1))) :=
            mul_le_mul_of_nonneg_right h1 (Real.rpow_nonneg hδ.le _)
        _ = _ := h2
        _ ≤ _ := key _ hs2
    · have h1 : D ^ (-ρ) ≤ 1 := Real.rpow_le_one hD.le hD1 (by linarith)
      calc D ^ (-ρ) * δ ^ (-(1 / (μ + 1))) ≤ 1 * δ ^ (-(1 / (μ + 1))) :=
            mul_le_mul_of_nonneg_right h1 (Real.rpow_nonneg hδ.le _)
        _ = _ := one_mul _
        _ ≤ _ := key _ hs1
  · -- small windows: use the local interval count
    apply (mul_le_mul_of_nonneg_left (min_le_left _ _) (Real.rpow_nonneg hD.le _)).trans
    have hrw : D ^ (-ρ) * (D / δ) = D ^ (1 - ρ) * δ ^ (-1 : ℝ) := by
      rw [Real.rpow_sub hD, Real.rpow_one, Real.rpow_neg_one, Real.rpow_neg hD.le]
      field_simp
    rw [hrw]
    rcases le_or_gt ρ 1 with hρ | hρ
    · have h1 : D ^ (1 - ρ) ≤ D₀ ^ (1 - ρ) :=
        Real.rpow_le_rpow hD.le hsmall (by linarith)
      have h2 : D₀ ^ (1 - ρ) * δ ^ (-1 : ℝ) = δ ^ (-((μ * ρ + 1) / (μ + 1))) := by
        rw [hD₀, ← Real.rpow_mul hδ.le, ← Real.rpow_add hδ]
        congr 1
        field_simp
        ring
      calc D ^ (1 - ρ) * δ ^ (-1 : ℝ) ≤ D₀ ^ (1 - ρ) * δ ^ (-1 : ℝ) :=
            mul_le_mul_of_nonneg_right h1 (Real.rpow_nonneg hδ.le _)
        _ = _ := h2
        _ ≤ _ := key _ hs2
    · have h1 : D ^ (1 - ρ) ≤ δ ^ (1 - ρ) :=
        Real.rpow_le_rpow_of_nonpos hδ hδD (by linarith)
      have h2 : δ ^ (1 - ρ) * δ ^ (-1 : ℝ) = δ ^ (-ρ) := by
        rw [← Real.rpow_add hδ]; congr 1; ring
      calc D ^ (1 - ρ) * δ ^ (-1 : ℝ) ≤ δ ^ (1 - ρ) * δ ^ (-1 : ℝ) :=
            mul_le_mul_of_nonneg_right h1 (Real.rpow_nonneg hδ.le _)
        _ = _ := h2
        _ ≤ _ := key _ hs3

/-- Upper bound for the Legendre--Assouad profile of `E^μ` at every scale
`0 < δ ≤ 1`. -/
theorem sequenceSet_profile_le {μ : ℝ} (hμ : 0 < μ) (ρ : ℝ) {δ : ℝ≥0}
    (hδ : 0 < δ) (hδ1 : δ ≤ 1) :
    multiplicativeLegendreAssouadProfile (sequenceSet μ) ρ δ ≤
      78 * (δ : ℝ≥0∞) ^ (-sequenceLegendreAssouad μ ρ) := by
  have hδr : (0 : ℝ) < δ := hδ
  unfold multiplicativeLegendreAssouadProfile
  refine iSup_le fun c => iSup_le fun D => ?_
  have hδD : δ ≤ D.1 := D.2.1
  have hD1 : D.1 ≤ 1 := D.2.2
  have hDpos : (0 : ℝ) < D.1 := hδr.trans_le hδD
  have hent := sequenceSet_localEntropy_le hμ c hδ hδ1 hδD
  have hreal := sequence_profile_real_bound (ρ := ρ) hμ hδr (show (δ : ℝ) ≤ D.1 from hδD)
    (show (D.1 : ℝ) ≤ 1 from hD1)
  have hcoe : ((D.1 : ℝ≥0) : ℝ≥0∞) ^ (-ρ) = ENNReal.ofReal ((D.1 : ℝ) ^ (-ρ)) := by
    rw [← ENNReal.ofReal_rpow_of_pos hDpos, ENNReal.ofReal_coe_nnreal]
  have hcoe' : (δ : ℝ≥0∞) ^ (-sequenceLegendreAssouad μ ρ) =
      ENNReal.ofReal ((δ : ℝ) ^ (-sequenceLegendreAssouad μ ρ)) := by
    rw [← ENNReal.ofReal_rpow_of_pos hδr, ENNReal.ofReal_coe_nnreal]
  rw [hcoe, hcoe']
  calc ENNReal.ofReal ((D.1 : ℝ) ^ (-ρ)) *
        ((localMultiplicativeEntropy (sequenceSet μ) c D.1 δ : ℕ∞) : ℝ≥0∞)
      ≤ ENNReal.ofReal ((D.1 : ℝ) ^ (-ρ)) *
        ENNReal.ofReal (78 * min ((D.1 : ℝ) / δ) ((δ : ℝ) ^ (-(1 / (μ + 1))))) :=
        mul_le_mul' le_rfl hent
    _ = ENNReal.ofReal (78 * ((D.1 : ℝ) ^ (-ρ) *
          min ((D.1 : ℝ) / δ) ((δ : ℝ) ^ (-(1 / (μ + 1)))))) := by
        rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hDpos.le _)]
        ring_nf
    _ ≤ ENNReal.ofReal (78 * (δ : ℝ) ^ (-sequenceLegendreAssouad μ ρ)) :=
        ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hreal (by norm_num))
    _ = 78 * ENNReal.ofReal ((δ : ℝ) ^ (-sequenceLegendreAssouad μ ρ)) := by
        rw [ENNReal.ofReal_mul (by norm_num)]; norm_num

/-- Introduction, line 739: `ν♯_{E^μ}(ρ) ≤ max(1/(μ+1), (μρ+1)/(μ+1), ρ)`. -/
theorem sequenceSet_legendreAssouad_le {μ : ℝ} (hμ : 0 < μ) (ρ : ℝ) :
    multiplicativeLegendreAssouadExponent (sequenceSet μ) ρ ≤
      (sequenceLegendreAssouad μ ρ : EReal) := by
  apply multiplicativeLegendreAssouadExponent_le_of_profile_power_bound
    (A := 78) (by norm_num)
  have hsmall : ∀ᶠ δ : ℝ≥0 in 𝓝[>] (0 : ℝ≥0), δ ∈ Ioo 0 1 :=
    nhdsGT_basis 0 |>.mem_of_mem zero_lt_one
  filter_upwards [hsmall] with δ hδ
  exact sequenceSet_profile_le hμ ρ hδ.1 hδ.2.le

/-- Introduction, line 737: `β(E^μ) ≤ 1/(μ+1)`. -/
theorem sequenceSet_minkowski_le {μ : ℝ} (hμ : 0 < μ) :
    multiplicativeMinkowskiExponent (sequenceSet μ) ≤ ((1 / (μ + 1) : ℝ) : EReal) := by
  have h := (multiplicativeMinkowskiExponent_le_multiplicativeLegendreAssouadExponent
    (sequenceSet μ) 0).trans (sequenceSet_legendreAssouad_le hμ 0)
  have hval : sequenceLegendreAssouad μ 0 = 1 / (μ + 1) := by
    have hμ1 : 0 < μ + 1 := by linarith
    simp only [sequenceLegendreAssouad, mul_zero, zero_add]
    rw [max_self, max_eq_left (one_div_pos.mpr hμ1).le]
  rwa [hval] at h

/-! ## Fractal exponents of `E^μ`: lower bounds -/

open Filter

/-- A power lower bound along a sequence of scales tending to zero bounds the
limsup of the logarithmic entropy quotient from below. -/
theorem le_limsup_entropyLogQuotient_of_power_lower {F : ℝ≥0 → ℝ≥0∞} {s c : ℝ}
    (hc : 0 < c) {u : ℕ → ℝ≥0} (hu : Tendsto u atTop (𝓝[>] 0))
    (hb : ∀ᶠ N in atTop, ENNReal.ofReal c * (u N : ℝ≥0∞) ^ (-s) ≤ F (u N)) :
    (s : EReal) ≤ limsup (fun δ => entropyLogQuotient (F δ) δ) (𝓝[>] 0) := by
  -- it suffices to prove `s - η ≤ limsup` for every `η > 0`
  have hη : ∀ η : ℝ, 0 < η →
      ((s - η : ℝ) : EReal) ≤ limsup (fun δ => entropyLogQuotient (F δ) δ) (𝓝[>] 0) := by
    intro η hηpos
    refine Filter.le_limsup_of_frequently_le ?_ (by isBoundedDefault)
    have hsmall : ∀ᶠ δ : ℝ≥0 in 𝓝[>] 0, δ ∈ Ioo 0 (min 1 ((c ^ (1 / η)).toNNReal)) := by
      apply nhdsGT_basis 0 |>.mem_of_mem
      simp only [lt_min_iff, zero_lt_one, true_and]
      exact Real.toNNReal_pos.mpr (Real.rpow_pos_of_pos hc _)
    have hev : ∀ᶠ N in atTop, ((s - η : ℝ) : EReal) ≤
        entropyLogQuotient (F (u N)) (u N) := by
      filter_upwards [hb, hu.eventually hsmall] with N hN hδ
      set δ := u N
      have hδ0 : 0 < δ := hδ.1
      have hδ1 : δ < 1 := lt_of_lt_of_le hδ.2 (min_le_left _ _)
      have hδc : (δ : ℝ) ≤ c ^ (1 / η) := by
        have := lt_of_lt_of_le hδ.2 (min_le_right _ _)
        have h' : (δ : ℝ) < ((c ^ (1 / η)).toNNReal : ℝ) := by exact_mod_cast this
        rw [Real.coe_toNNReal _ (Real.rpow_nonneg hc.le _)] at h'
        exact h'.le
      have hδr : (0 : ℝ) < δ := hδ0
      have hpow : (δ : ℝ) ^ η ≤ c := by
        calc (δ : ℝ) ^ η ≤ (c ^ (1 / η)) ^ η :=
              Real.rpow_le_rpow hδr.le hδc hηpos.le
          _ = c := by
            rw [← Real.rpow_mul hc.le, one_div_mul_cancel hηpos.ne', Real.rpow_one]
      have hδne : (δ : ℝ≥0∞) ≠ 0 := by exact_mod_cast hδ0.ne'
      have hle : (δ : ℝ≥0∞) ^ (-(s - η)) ≤ F δ := by
        calc (δ : ℝ≥0∞) ^ (-(s - η)) = (δ : ℝ≥0∞) ^ η * (δ : ℝ≥0∞) ^ (-s) := by
              rw [← ENNReal.rpow_add _ _ hδne ENNReal.coe_ne_top]; congr 1; ring
          _ ≤ ENNReal.ofReal c * (δ : ℝ≥0∞) ^ (-s) := by
              gcongr
              rw [← ENNReal.ofReal_coe_nnreal, ENNReal.ofReal_rpow_of_pos hδr]
              exact ENNReal.ofReal_le_ofReal hpow
          _ ≤ F δ := hN
      calc ((s - η : ℝ) : EReal) = entropyLogQuotient ((δ : ℝ≥0∞) ^ (-(s - η))) δ :=
            (entropyLogQuotient_inv_rpow hδ0 hδ1).symm
        _ ≤ entropyLogQuotient (F δ) δ := entropyLogQuotient_mono hδ0 hδ1 hle
    exact hu.frequently hev.frequently
  -- conclude
  by_contra hlt
  push_neg at hlt
  obtain ⟨z, hz1, hz2⟩ := EReal.lt_iff_exists_real_btwn.mp hlt
  have hzs : z < s := EReal.coe_lt_coe_iff.mp hz2
  have := hη (s - z) (by linarith)
  rw [show s - (s - z) = z by ring] at this
  exact absurd (lt_of_le_of_lt this hz1) (lt_irrefl _)

/-- The packing scale `δ_N = μ (3N)^{-μ-1} / 4` used in the lower bounds. -/
def sequencePackingScale (μ : ℝ) (N : ℕ) : ℝ := μ * (3 * (N : ℝ)) ^ (-(μ + 1)) / 4

theorem sequencePackingScale_pos {μ : ℝ} (hμ : 0 < μ) {N : ℕ} (hN : 1 ≤ N) :
    0 < sequencePackingScale μ N := by
  have h1 : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have : (0 : ℝ) < 3 * N := by linarith
  unfold sequencePackingScale
  positivity

/-- Logarithmic separation of consecutive points: for `n ≥ 1`,
`log₂(1+n^{-μ}) - log₂(1+(n+1)^{-μ}) ≥ μ (n+1)^{-μ-1} / 2`. -/
theorem logRadius_sequence_gap {μ : ℝ} (hμ : 0 < μ) {n : ℕ} (hn : 1 ≤ n) :
    μ * ((n : ℝ) + 1) ^ (-μ - 1) / 2 ≤
      Real.log (1 + (n : ℝ) ^ (-μ)) / Real.log 2 -
        Real.log (1 + ((n : ℝ) + 1) ^ (-μ)) / Real.log 2 := by
  have hlog2 : 0 < Real.log 2 := Real.log_pos one_lt_two
  have hlog2le : Real.log 2 ≤ 1 := by
    nlinarith [Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)]
  obtain ⟨hgap, -⟩ := sequenceSet_gap_bounds hμ hn
  have ha := rpow_neg_mem_Ioc hμ.le hn
  have hb : ((n : ℝ) + 1) ^ (-μ) ∈ Ioc 0 1 := by
    have := rpow_neg_mem_Ioc hμ.le (n := n + 1) (by omega)
    simpa using this
  set u := 1 + (n : ℝ) ^ (-μ)
  set v := 1 + ((n : ℝ) + 1) ^ (-μ)
  have hu : 0 < u := by linarith [ha.1]
  have hv : 0 < v := by linarith [hb.1]
  have hu2 : u ≤ 2 := by linarith [ha.2]
  have huv : u - v = (n : ℝ) ^ (-μ) - ((n : ℝ) + 1) ^ (-μ) := by ring
  have hgap0 : 0 ≤ μ * ((n : ℝ) + 1) ^ (-μ - 1) :=
    mul_nonneg hμ.le (Real.rpow_nonneg (by positivity) _)
  have huv0 : 0 ≤ u - v := by linarith
  have hq : Real.log (v / u) ≤ v / u - 1 := Real.log_le_sub_one_of_pos (div_pos hv hu)
  rw [Real.log_div hv.ne' hu.ne'] at hq
  have h1 : (u - v) / 2 ≤ Real.log u - Real.log v := by
    have : (u - v) / 2 ≤ (u - v) / u :=
      div_le_div_of_nonneg_left huv0 hu hu2
    have : (u - v) / u = 1 - v / u := by field_simp
    linarith
  have h0 : 0 ≤ Real.log u - Real.log v := by linarith
  have h2 : Real.log u - Real.log v ≤ (Real.log u - Real.log v) / Real.log 2 := by
    rw [le_div_iff₀ hlog2]
    exact mul_le_of_le_one_right h0 hlog2le
  rw [← sub_div]
  linarith

/-- The `N+1` points `1 + n^{-μ}`, `N ≤ n ≤ 2N`, as positive radii. -/
def sequencePackingRadii (μ : ℝ) (N : ℕ) : Finset PositiveRadius :=
  (Finset.Icc N (2 * N)).image fun n : ℕ =>
    ⟨1 + (n : ℝ) ^ (-μ), lt_of_lt_of_le zero_lt_one
      (le_add_of_nonneg_right (Real.rpow_nonneg (Nat.cast_nonneg _) _))⟩

theorem sequencePackingRadii_card {μ : ℝ} (hμ : 0 < μ) {N : ℕ} (hN : 1 ≤ N) :
    (sequencePackingRadii μ N).card = N + 1 := by
  unfold sequencePackingRadii
  rw [Finset.card_image_of_injOn, Nat.card_Icc]
  · omega
  intro n hn m hm hnm
  have hn1 : 1 ≤ n := hN.trans (Finset.mem_Icc.mp hn).1
  have hm1 : 1 ≤ m := hN.trans (Finset.mem_Icc.mp hm).1
  have h := congrArg Subtype.val hnm
  simp only [add_right_inj] at h
  have hn' : (0 : ℝ) < n := by exact_mod_cast hn1
  have hm' : (0 : ℝ) < m := by exact_mod_cast hm1
  by_contra hne
  rcases lt_or_gt_of_ne hne with hlt | hlt
  · have hlt' : (n : ℝ) < m := by exact_mod_cast hlt
    have := Real.rpow_lt_rpow_of_neg hn' hlt' (by linarith : -μ < 0)
    linarith
  · have hlt' : (m : ℝ) < n := by exact_mod_cast hlt
    have := Real.rpow_lt_rpow_of_neg hm' hlt' (by linarith : -μ < 0)
    linarith

/-- The packing points lie in `E^μ` and in the multiplicative interval about
`1` of diameter `4 N^{-μ}`. -/
theorem sequencePackingRadii_mem {μ : ℝ} (hμ : 0 < μ) {N : ℕ} (hN : 1 ≤ N) :
    ∀ r ∈ sequencePackingRadii μ N, (r : ℝ) ∈ sequenceSet μ ∩
      multiplicativeInterval ⟨1, one_pos⟩ (4 * (N : ℝ) ^ (-μ)).toNNReal := by
  intro r hr
  obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hr
  have hn1 : 1 ≤ n := hN.trans (Finset.mem_Icc.mp hn).1
  have hNn : (N : ℝ) ≤ n := by exact_mod_cast (Finset.mem_Icc.mp hn).1
  have hN0 : (0 : ℝ) < N := by exact_mod_cast hN
  refine ⟨⟨n, hn1, rfl⟩, ?_, ?_⟩
  · exact lt_of_lt_of_le zero_lt_one
      (le_add_of_nonneg_right (Real.rpow_nonneg (Nat.cast_nonneg _) _))
  · have hlog2 : 0 < Real.log 2 := Real.log_pos one_lt_two
    have hlog2' : 1 / 2 ≤ Real.log 2 := by linarith [Real.log_two_gt_d9]
    have hx := rpow_neg_mem_Ioc hμ.le hn1
    have hxN : (n : ℝ) ^ (-μ) ≤ (N : ℝ) ^ (-μ) :=
      Real.rpow_le_rpow_of_nonpos hN0 hNn (by linarith)
    have hlogle : Real.log (1 + (n : ℝ) ^ (-μ)) ≤ (n : ℝ) ^ (-μ) := by
      have := Real.log_le_sub_one_of_pos (by linarith [hx.1] : (0 : ℝ) < 1 + (n : ℝ) ^ (-μ))
      linarith
    have hlogpos : 0 ≤ Real.log (1 + (n : ℝ) ^ (-μ)) := Real.log_nonneg (by linarith [hx.1])
    simp only [logRadius, Real.log_one, zero_div, sub_zero]
    rw [Real.coe_toNNReal _ (by positivity), abs_of_nonneg (div_nonneg hlogpos hlog2.le),
      div_le_iff₀ hlog2]
    nlinarith

/-- The packing points are `δ_N`-separated in logarithmic coordinates. -/
theorem sequencePackingRadii_isSeparated {μ : ℝ} (hμ : 0 < μ) {N : ℕ} (hN : 1 ≤ N) :
    Metric.IsSeparated ((sequencePackingScale μ N).toNNReal : ℝ≥0∞)
      (logRadius '' (↑(sequencePackingRadii μ N) : Set PositiveRadius)) := by
  have hN0 : (0 : ℝ) < N := by exact_mod_cast hN
  have hδpos := sequencePackingScale_pos hμ hN
  -- logarithms of the packing points
  set L : ℕ → ℝ := fun n => Real.log (1 + (n : ℝ) ^ (-μ)) / Real.log 2 with hL
  have hstep : ∀ n, N ≤ n → n < 2 * N →
      2 * sequencePackingScale μ N ≤ L n - L (n + 1) := by
    intro n hNn hn2
    have hn1 : 1 ≤ n := hN.trans hNn
    have hgap := logRadius_sequence_gap hμ hn1
    have hle : (n : ℝ) + 1 ≤ 3 * N := by
      have : (n : ℝ) + 1 ≤ 2 * N := by exact_mod_cast hn2
      linarith
    have hpow : (3 * (N : ℝ)) ^ (-μ - 1) ≤ ((n : ℝ) + 1) ^ (-μ - 1) :=
      Real.rpow_le_rpow_of_nonpos (by positivity) hle (by linarith)
    have : 2 * sequencePackingScale μ N = μ * (3 * (N : ℝ)) ^ (-μ - 1) / 2 := by
      unfold sequencePackingScale; rw [show -(μ + 1) = -μ - 1 by ring]; ring
    rw [this]
    have hL1 : L n - L (n + 1) = Real.log (1 + (n : ℝ) ^ (-μ)) / Real.log 2 -
        Real.log (1 + ((n : ℝ) + 1) ^ (-μ)) / Real.log 2 := by simp only [hL]; push_cast; rfl
    rw [hL1]
    have := mul_le_mul_of_nonneg_left hpow hμ.le
    linarith
  have hanti : ∀ n m, N ≤ n → n < m → m ≤ 2 * N →
      2 * sequencePackingScale μ N ≤ L n - L m := by
    intro n m hNn hnm hm
    induction m, hnm using Nat.le_induction with
    | base => exact hstep n hNn (by omega)
    | succ m hm' ih =>
      have h1 := ih (by omega)
      have h2 := hstep m (by omega) (by omega)
      linarith [hδpos]
  rintro x ⟨r, hr, rfl⟩ y ⟨r', hr', rfl⟩ hxy
  obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hr
  obtain ⟨m, hm, rfl⟩ := Finset.mem_image.mp hr'
  have hn' := Finset.mem_Icc.mp hn
  have hm' := Finset.mem_Icc.mp hm
  have hlogeq : ∀ k : ℕ, logRadius ⟨1 + (k : ℝ) ^ (-μ), lt_of_lt_of_le zero_lt_one
      (le_add_of_nonneg_right (Real.rpow_nonneg (Nat.cast_nonneg _) _))⟩ = L k := fun _ => rfl
  rw [hlogeq, hlogeq] at hxy ⊢
  rw [edist_dist, Real.dist_eq]
  change ENNReal.ofReal (sequencePackingScale μ N) < ENNReal.ofReal |L n - L m|
  have hnm : n ≠ m := fun h => hxy (by rw [h])
  have hlt : sequencePackingScale μ N < |L n - L m| := by
    rcases lt_or_gt_of_ne hnm with h | h
    · have := hanti n m hn'.1 h hm'.2
      linarith [le_abs_self (L n - L m)]
    · have := hanti m n hm'.1 h hn'.2
      linarith [neg_abs_le (L n - L m)]
  exact (ENNReal.ofReal_lt_ofReal_iff (hδpos.trans hlt)).mpr hlt

/-- The packing scales tend to zero from above. -/
theorem tendsto_sequencePackingScale {μ : ℝ} (hμ : 0 < μ) :
    Tendsto (fun N : ℕ => (sequencePackingScale μ N).toNNReal) atTop (𝓝[>] 0) := by
  apply tendsto_nhdsWithin_iff.mpr
  constructor
  · have h3 : Tendsto (fun N : ℕ => 3 * (N : ℝ)) atTop atTop :=
      Tendsto.const_mul_atTop (by norm_num) tendsto_natCast_atTop_atTop
    have hpow := (tendsto_rpow_neg_atTop (by linarith : 0 < μ + 1)).comp h3
    have hreal : Tendsto (fun N : ℕ => sequencePackingScale μ N) atTop (𝓝 0) := by
      have := (hpow.const_mul μ).div_const 4
      simpa [sequencePackingScale] using this
    exact (by simpa using (continuous_real_toNNReal.tendsto 0).comp hreal :
      Tendsto (Real.toNNReal ∘ fun N : ℕ => sequencePackingScale μ N) atTop (𝓝 0))
  · filter_upwards [eventually_ge_atTop 1] with N hN
    exact Real.toNNReal_pos.mpr (sequencePackingScale_pos hμ hN)

/-- At the packing scale, the window of diameter `D_N = 4N^{-μ}` carries
`D_N^{-ρ} N = 4^{-ρ} a^s δ_N^{-s}` with `a = μ 3^{-μ-1}/4` and
`s = (μρ+1)/(μ+1)`. -/
theorem sequencePacking_real_identity {μ : ℝ} (hμ : 0 < μ) (ρ : ℝ) {N : ℕ} (hN : 1 ≤ N) :
    (4 * (N : ℝ) ^ (-μ)) ^ (-ρ) * N =
      (4 : ℝ) ^ (-ρ) * (μ * (3 : ℝ) ^ (-(μ + 1)) / 4) ^ ((μ * ρ + 1) / (μ + 1)) *
        (sequencePackingScale μ N) ^ (-((μ * ρ + 1) / (μ + 1))) := by
  have hN0 : (0 : ℝ) < N := by exact_mod_cast hN
  have hμ1 : 0 < μ + 1 := by linarith
  set s := (μ * ρ + 1) / (μ + 1) with hs
  set a := μ * (3 : ℝ) ^ (-(μ + 1)) / 4 with ha
  have hapos : 0 < a := by rw [ha]; positivity
  have hscale : sequencePackingScale μ N = a * (N : ℝ) ^ (-(μ + 1)) := by
    unfold sequencePackingScale
    rw [Real.mul_rpow (by norm_num) hN0.le, ha]
    ring
  rw [hscale, Real.mul_rpow hapos.le (Real.rpow_nonneg hN0.le _),
    Real.mul_rpow (by norm_num) (Real.rpow_nonneg hN0.le _)]
  have e1 : (a : ℝ) ^ s * a ^ (-s) = 1 := by
    rw [← Real.rpow_add hapos]; simp
  have e2 : ((N : ℝ) ^ (-μ)) ^ (-ρ) * N = ((N : ℝ) ^ (-(μ + 1))) ^ (-s) := by
    rw [← Real.rpow_mul hN0.le, ← Real.rpow_mul hN0.le]
    conv_lhs => rhs; rw [← Real.rpow_one (N : ℝ)]
    rw [← Real.rpow_add hN0]
    congr 1
    rw [hs]; field_simp
  calc (4 : ℝ) ^ (-ρ) * ((N : ℝ) ^ (-μ)) ^ (-ρ) * N
      = (4 : ℝ) ^ (-ρ) * (((N : ℝ) ^ (-μ)) ^ (-ρ) * N) := by ring
    _ = (4 : ℝ) ^ (-ρ) * (a ^ s * a ^ (-s)) * ((N : ℝ) ^ (-(μ + 1))) ^ (-s) := by
        rw [e1, e2]; ring
    _ = _ := by ring

/-- The packing estimate: at scale `δ_N`, the window about `1` of diameter
`4N^{-μ}` has local entropy at least `N + 1`. -/
theorem sequenceSet_localEntropy_ge {μ : ℝ} (hμ : 0 < μ) {N : ℕ} (hN : 1 ≤ N) :
    ((N + 1 : ℕ) : ℕ∞) ≤ localMultiplicativeEntropy (sequenceSet μ) ⟨1, one_pos⟩
      (4 * (N : ℝ) ^ (-μ)).toNNReal (sequencePackingScale μ N).toNNReal := by
  rw [← sequencePackingRadii_card hμ hN]
  apply finset_card_le_localMultiplicativeEntropy_of_radius_isSeparated
  · exact sequencePackingRadii_mem hμ hN
  · exact sequencePackingRadii_isSeparated hμ hN

/-- Eventual admissibility of the packing window: `δ_N ≤ 4 N^{-μ} ≤ 1`. -/
theorem eventually_sequencePacking_window {μ : ℝ} (hμ : 0 < μ) :
    ∀ᶠ N : ℕ in atTop, 1 ≤ N ∧ sequencePackingScale μ N ≤ 4 * (N : ℝ) ^ (-μ) ∧
      4 * (N : ℝ) ^ (-μ) ≤ 1 := by
  filter_upwards [eventually_ge_atTop 1,
    eventually_ge_atTop ⌈(4 : ℝ) ^ (1 / μ)⌉₊, eventually_ge_atTop ⌈μ⌉₊] with N hN hN4 hNμ
  have hN0 : (0 : ℝ) < N := by exact_mod_cast hN
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hN4' : (4 : ℝ) ^ (1 / μ) ≤ N := (Nat.ceil_le).mp hN4
  have hNμ' : μ ≤ N := (Nat.ceil_le).mp hNμ
  refine ⟨hN, ?_, ?_⟩
  · unfold sequencePackingScale
    rw [Real.mul_rpow (by norm_num) hN0.le]
    have h3 : (3 : ℝ) ^ (-(μ + 1)) ≤ 1 :=
      Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by linarith)
    have hsplit : (N : ℝ) ^ (-(μ + 1)) = (N : ℝ) ^ (-μ) * (N : ℝ)⁻¹ := by
      rw [show -(μ + 1) = -μ + -1 by ring, Real.rpow_add hN0, Real.rpow_neg_one]
    have hμN : μ * (N : ℝ)⁻¹ ≤ 1 := by
      rw [mul_inv_le_iff₀ hN0]; linarith
    have hp0 : 0 ≤ (N : ℝ) ^ (-μ) := Real.rpow_nonneg hN0.le _
    have hp1 : 0 ≤ (3 : ℝ) ^ (-(μ + 1)) := Real.rpow_nonneg (by norm_num) _
    have hinv : 0 ≤ μ * (N : ℝ)⁻¹ := by positivity
    rw [hsplit]
    calc μ * ((3 : ℝ) ^ (-(μ + 1)) * ((N : ℝ) ^ (-μ) * (N : ℝ)⁻¹)) / 4
        = (μ * (N : ℝ)⁻¹) * (3 : ℝ) ^ (-(μ + 1)) * (N : ℝ) ^ (-μ) / 4 := by ring
      _ ≤ 1 * 1 * (N : ℝ) ^ (-μ) / 4 := by gcongr
      _ ≤ 4 * (N : ℝ) ^ (-μ) := by linarith
  · have : (4 : ℝ) ≤ (N : ℝ) ^ μ := by
      calc (4 : ℝ) = ((4 : ℝ) ^ (1 / μ)) ^ μ := by
            rw [← Real.rpow_mul (by norm_num), one_div_mul_cancel hμ.ne', Real.rpow_one]
        _ ≤ (N : ℝ) ^ μ := Real.rpow_le_rpow (by positivity) hN4' hμ.le
    rw [Real.rpow_neg hN0.le]
    have hpos : 0 < (N : ℝ) ^ μ := Real.rpow_pos_of_pos hN0 _
    rw [mul_inv_le_iff₀ hpos]
    linarith

/-- The packing lower bound in `ℝ≥0∞` form: at the scale `δ_N`, the local
entropy of the window of diameter `D_N` weighted by `D_N^{-ρ}` dominates
`c δ_N^{-s}`, `s = (μρ+1)/(μ+1)`. -/
theorem sequencePacking_weighted_lower {μ : ℝ} (hμ : 0 < μ) (ρ : ℝ) {N : ℕ} (hN : 1 ≤ N) :
    ENNReal.ofReal ((4 : ℝ) ^ (-ρ) * (μ * (3 : ℝ) ^ (-(μ + 1)) / 4) ^ ((μ * ρ + 1) / (μ + 1))) *
        (((sequencePackingScale μ N).toNNReal : ℝ≥0) : ℝ≥0∞) ^ (-((μ * ρ + 1) / (μ + 1))) ≤
      (((4 * (N : ℝ) ^ (-μ)).toNNReal : ℝ≥0) : ℝ≥0∞) ^ (-ρ) *
        ((localMultiplicativeEntropy (sequenceSet μ) ⟨1, one_pos⟩
          (4 * (N : ℝ) ^ (-μ)).toNNReal (sequencePackingScale μ N).toNNReal : ℕ∞) : ℝ≥0∞) := by
  have hN0 : (0 : ℝ) < N := by exact_mod_cast hN
  have hδ := sequencePackingScale_pos hμ hN
  have hD : (0 : ℝ) < 4 * (N : ℝ) ^ (-μ) := by positivity
  have hcoe : ∀ {x : ℝ}, 0 < x → ∀ t : ℝ,
      (((x.toNNReal : ℝ≥0) : ℝ≥0∞) ^ t) = ENNReal.ofReal (x ^ t) := by
    intro x hx t
    rw [← ENNReal.ofReal_rpow_of_pos hx]
    rfl
  rw [hcoe hδ, hcoe hD, ← ENNReal.ofReal_mul (by positivity),
    ← sequencePacking_real_identity hμ ρ hN, ENNReal.ofReal_mul (Real.rpow_nonneg hD.le _)]
  apply mul_le_mul' le_rfl
  have h := ENat.toENNReal_mono (sequenceSet_localEntropy_ge hμ hN)
  refine le_trans ?_ h
  rw [ENNReal.ofReal_natCast]
  simp only [ENat.toENNReal_coe, Nat.cast_le]
  exact_mod_cast Nat.le_succ N

/-- Introduction, line 739: the lower bound `ν♯_{E^μ}(ρ) ≥ (μρ+1)/(μ+1)`,
valid for every real `ρ`. -/
theorem sequenceSet_legendreAssouad_ge {μ : ℝ} (hμ : 0 < μ) (ρ : ℝ) :
    (((μ * ρ + 1) / (μ + 1) : ℝ) : EReal) ≤
      multiplicativeLegendreAssouadExponent (sequenceSet μ) ρ := by
  unfold multiplicativeLegendreAssouadExponent
  apply le_limsup_entropyLogQuotient_of_power_lower
    (c := (4 : ℝ) ^ (-ρ) * (μ * (3 : ℝ) ^ (-(μ + 1)) / 4) ^ ((μ * ρ + 1) / (μ + 1)))
    (by positivity) (tendsto_sequencePackingScale hμ)
  filter_upwards [eventually_sequencePacking_window hμ] with N hN
  obtain ⟨hN1, hδD, hD1⟩ := hN
  refine (sequencePacking_weighted_lower hμ ρ hN1).trans ?_
  unfold multiplicativeLegendreAssouadProfile
  have hmem : (4 * (N : ℝ) ^ (-μ)).toNNReal ∈
      Icc (sequencePackingScale μ N).toNNReal 1 :=
    ⟨Real.toNNReal_le_toNNReal hδD, Real.toNNReal_le_one.mpr hD1⟩
  exact le_iSup_of_le (⟨1, one_pos⟩ : PositiveRadius)
    (le_iSup_of_le (⟨_, hmem⟩ : Icc (sequencePackingScale μ N).toNNReal 1) le_rfl)

/-- Introduction, line 737: the lower bound `β(E^μ) ≥ 1/(μ+1)`. -/
theorem sequenceSet_minkowski_ge {μ : ℝ} (hμ : 0 < μ) :
    ((1 / (μ + 1) : ℝ) : EReal) ≤ multiplicativeMinkowskiExponent (sequenceSet μ) := by
  unfold multiplicativeMinkowskiExponent
  have hs : (μ * 0 + 1) / (μ + 1) = 1 / (μ + 1) := by ring
  apply le_limsup_entropyLogQuotient_of_power_lower
    (c := (4 : ℝ) ^ (0 : ℝ) * (μ * (3 : ℝ) ^ (-(μ + 1)) / 4) ^ (1 / (μ + 1)))
    (by positivity) (tendsto_sequencePackingScale hμ)
  filter_upwards [eventually_sequencePacking_window hμ] with N hN
  obtain ⟨hN1, hδD, hD1⟩ := hN
  have h := sequencePacking_weighted_lower hμ 0 hN1
  rw [hs, neg_zero, ENNReal.rpow_zero, one_mul] at h
  refine h.trans ?_
  apply ENat.toENNReal_mono
  unfold unitMultiplicativeEntropy localMultiplicativeEntropy
  refine le_iSup_of_le (⟨1, one_pos⟩ : PositiveRadius) ?_
  apply multiplicativeEntropy_mono
  exact inter_subset_inter_right _ (multiplicativeInterval_mono _
    (Real.toNNReal_le_one.mpr hD1))

/-- Introduction, line 737: `β(E^μ) = 1/(μ+1)`. -/
theorem sequenceSet_minkowski_eq {μ : ℝ} (hμ : 0 < μ) :
    multiplicativeMinkowskiExponent (sequenceSet μ) = ((1 / (μ + 1) : ℝ) : EReal) :=
  le_antisymm (sequenceSet_minkowski_le hμ) (sequenceSet_minkowski_ge hμ)

/-- Introduction, line 739: the Legendre--Assouad function of `E^μ`,
`ν♯(ρ) = max(1/(μ+1), (μρ+1)/(μ+1), ρ)`; on `0 ≤ ρ ≤ 1` this equals
`μρ/(μ+1) + 1/(μ+1)` as stated in the source. -/
theorem sequenceSet_legendreAssouad_eq {μ : ℝ} (hμ : 0 < μ) (ρ : ℝ) :
    multiplicativeLegendreAssouadExponent (sequenceSet μ) ρ =
      (sequenceLegendreAssouad μ ρ : EReal) := by
  apply le_antisymm (sequenceSet_legendreAssouad_le hμ ρ)
  have hβ := (sequenceSet_minkowski_ge hμ).trans
    (multiplicativeMinkowskiExponent_le_multiplicativeLegendreAssouadExponent _ ρ)
  have hρ := le_multiplicativeLegendreAssouadExponent_of_nonempty_of_subset_Ioi
    (sequenceSet_nonempty μ) (sequenceSet_subset_Ioi hμ.le) ρ
  have hmid := sequenceSet_legendreAssouad_ge hμ ρ
  unfold sequenceLegendreAssouad
  rw [EReal.coe_strictMono.monotone.map_max, EReal.coe_strictMono.monotone.map_max]
  exact max_le (max_le hβ hmid) hρ

/-! ## The endpoint functions `L` and `U` for `E^μ` (introduction, lines 739-753) -/

/-- The critical exponent `p(μ) = 1 + 1/((μ+1)(d-1))`. -/
def sequenceCriticalExponent (d : ℕ) (μ : ℝ) : ℝ := 1 + 1 / ((μ + 1) * ((d : ℝ) - 1))

/-- Introduction, lines 745-752: the lower endpoint
`L(p) = 1-d + (d-(d-1)p)/μ` for `p ≤ d/(d-1)` and `L(p) = 1-d` for
`p ≥ d/(d-1)`; equivalently the maximum of the two expressions. -/
def sequenceLowerEndpoint (d : ℕ) (μ p : ℝ) : ℝ :=
  max (1 - (d : ℝ)) (1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ)

/-- Introduction, line 744: the upper endpoint `U(p) = (d-1)(p-1) - 1/(μ+1)`. -/
def sequenceUpperEndpoint (d : ℕ) (μ p : ℝ) : ℝ := ((d : ℝ) - 1) * (p - 1) - 1 / (μ + 1)

theorem sequenceLowerEndpoint_of_le {d : ℕ} (hd : 2 ≤ d) {μ p : ℝ} (hμ : 0 < μ)
    (hp : p ≤ (d : ℝ) / ((d : ℝ) - 1)) :
    sequenceLowerEndpoint d μ p = 1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ := by
  have hd' : (1 : ℝ) < d := by exact_mod_cast (show 1 < d by omega)
  have hn : 0 < (d : ℝ) - 1 := by linarith
  have : 0 ≤ (d : ℝ) - ((d : ℝ) - 1) * p := by
    rw [le_div_iff₀ hn] at hp; linarith
  exact max_eq_right (by have := div_nonneg this hμ.le; linarith)

theorem sequenceLowerEndpoint_of_ge {d : ℕ} (hd : 2 ≤ d) {μ p : ℝ} (hμ : 0 < μ)
    (hp : (d : ℝ) / ((d : ℝ) - 1) ≤ p) :
    sequenceLowerEndpoint d μ p = 1 - (d : ℝ) := by
  have hd' : (1 : ℝ) < d := by exact_mod_cast (show 1 < d by omega)
  have hn : 0 < (d : ℝ) - 1 := by linarith
  have : (d : ℝ) - ((d : ℝ) - 1) * p ≤ 0 := by
    rw [div_le_iff₀ hn] at hp; linarith
  exact max_eq_left (by have := div_nonpos_of_nonpos_of_nonneg this hμ.le; linarith)

open Auto.Spherical.PowerWeights in
/-- Introduction, lines 739-753: for `E^μ`, the implicit FRS condition holds
iff `p ≥ p(μ)` and `L(p) ≤ α ≤ U(p)`. -/
theorem sequence_implicitCondition_iff {d : ℕ} (hd : 2 ≤ d) {μ : ℝ} (hμ : 0 < μ)
    (p α : ℝ) :
    powerWeightEntropyImplicitCondition d (sequenceSet μ) p α ↔
      1 / (μ + 1) ≤ ((d : ℝ) - 1) * (p - 1) ∧
        sequenceLowerEndpoint d μ p ≤ α ∧ α ≤ sequenceUpperEndpoint d μ p := by
  have hd' : (1 : ℝ) < d := by exact_mod_cast (show 1 < d by omega)
  have hn : 0 < (d : ℝ) - 1 := by linarith
  have hμ1 : 0 < μ + 1 := by linarith
  unfold powerWeightEntropyImplicitCondition
  rw [sequenceSet_minkowski_eq hμ, sequenceSet_legendreAssouad_eq hμ, ← EReal.coe_add,
    ← EReal.coe_strictMono.monotone.map_max, EReal.coe_le_coe_iff]
  simp only [sequenceLegendreAssouad, sequenceLowerEndpoint, sequenceUpperEndpoint,
    max_le_iff]
  have hdn : (d : ℝ) = ((d : ℝ) - 1) + 1 := by ring
  set n := (d : ℝ) - 1 with hn_def
  have e1 : (μ * (n * (p - 2) - α) + 1) / (μ + 1) ≤ n * (p - 1) ↔
      1 - (d : ℝ) + ((d : ℝ) - n * p) / μ ≤ α := by
    rw [div_le_iff₀ hμ1]
    have : 1 - (d : ℝ) + ((d : ℝ) - n * p) / μ ≤ α ↔ (d : ℝ) - n * p ≤ (α - (1 - d)) * μ := by
      rw [← div_le_iff₀ hμ]; constructor <;> intro h <;> linarith
    rw [this, hdn]
    constructor <;> intro h <;> nlinarith
  have e2 : n * (p - 2) - α ≤ n * (p - 1) ↔ 1 - (d : ℝ) ≤ α := by
    rw [hdn]; constructor <;> intro h <;> linarith
  have e3 : α + 1 / (μ + 1) ≤ n * (p - 1) ↔ α ≤ n * (p - 1) - 1 / (μ + 1) := by
    constructor <;> intro h <;> linarith
  rw [e1, e2, e3]
  tauto

/-- The strict form of `sequence_implicitCondition_iff`: the strict FRS
condition for `E^μ` holds iff `p > p(μ)` and `L(p) < α < U(p)`. -/
theorem sequence_strictCondition_iff {d : ℕ} (hd : 2 ≤ d) {μ : ℝ} (hμ : 0 < μ)
    (p α : ℝ) :
    max ((α : EReal) + multiplicativeMinkowskiExponent (sequenceSet μ))
        (multiplicativeLegendreAssouadExponent (sequenceSet μ)
          (((d : ℝ) - 1) * (p - 2) - α)) < (↑(((d : ℝ) - 1) * (p - 1)) : EReal) ↔
      1 / (μ + 1) < ((d : ℝ) - 1) * (p - 1) ∧
        sequenceLowerEndpoint d μ p < α ∧ α < sequenceUpperEndpoint d μ p := by
  have hd' : (1 : ℝ) < d := by exact_mod_cast (show 1 < d by omega)
  have hμ1 : 0 < μ + 1 := by linarith
  rw [sequenceSet_minkowski_eq hμ, sequenceSet_legendreAssouad_eq hμ, ← EReal.coe_add,
    ← EReal.coe_strictMono.monotone.map_max, EReal.coe_lt_coe_iff]
  simp only [sequenceLegendreAssouad, sequenceLowerEndpoint, sequenceUpperEndpoint,
    max_lt_iff]
  have hdn : (d : ℝ) = ((d : ℝ) - 1) + 1 := by ring
  set n := (d : ℝ) - 1 with hn_def
  have e1 : (μ * (n * (p - 2) - α) + 1) / (μ + 1) < n * (p - 1) ↔
      1 - (d : ℝ) + ((d : ℝ) - n * p) / μ < α := by
    rw [div_lt_iff₀ hμ1]
    have : 1 - (d : ℝ) + ((d : ℝ) - n * p) / μ < α ↔ (d : ℝ) - n * p < (α - (1 - d)) * μ := by
      rw [← div_lt_iff₀ hμ]; constructor <;> intro h <;> linarith
    rw [this, hdn]
    constructor <;> intro h <;> nlinarith
  have e2 : n * (p - 2) - α < n * (p - 1) ↔ 1 - (d : ℝ) < α := by
    rw [hdn]; constructor <;> intro h <;> linarith
  have e3 : α + 1 / (μ + 1) < n * (p - 1) ↔ α < n * (p - 1) - 1 / (μ + 1) := by
    constructor <;> intro h <;> linarith
  rw [e1, e2, e3]
  tauto

open Auto.Spherical.PowerWeights Auto.Spherical.MSS Auto.FractalDimensions in
/-- The strict FRS sufficiency theorem (arXiv:2602.17613, Thm. 1.1) for `d ≥ 3`,
packaged from the inputs assembled in `power_weight_spherical_maximal_main`:
the strict implicit condition gives the restricted weighted strong type. -/
theorem frs_strict_strongType_three_le {d : ℕ} (hd : 3 ≤ d) (E : Set ℝ) (hE : E.Nonempty)
    (hEpos : E ⊆ Ioi (0 : ℝ)) {p α : ℝ} (hp : 1 < p)
    (hstrict : max ((α : EReal) + multiplicativeMinkowskiExponent E)
        (multiplicativeLegendreAssouadExponent E (((d : ℝ) - 1) * (p - 2) - α)) <
      (↑(((d : ℝ) - 1) * (p - 1)) : EReal)) :
    HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E p α := by
  have hunweighted : ∀ ⦃q : Real⦄, 1 < q →
      multiplicativeMinkowskiExponent E <
        (↑(((d : Real) - 1) * (q - 1)) : EReal) →
      HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E q 0 := by
    intro q hq hcritical
    by_cases hq2 : q < 2
    · obtain ⟨beta, _hbeta, hM, hbetacritical⟩ :=
        exists_nonneg_real_between_multiplicativeMinkowskiExponent_and
          hE hEpos hcritical
      exact
        hasRestrNormdSphMaxPowWtStrType_zero_of_mulMinkExp_lt_and_unif_fin_phys_CZ_wk_one_dim
          (by omega : 2 ≤ d) E hE hEpos hq hq2 hM
          (by simpa only [Nat.cast_sub (by omega : 1 ≤ d), Nat.cast_one]
            using hbetacritical)
          (hfinite_weak_one_restrictedRelativeBandpassSphericalMaximal_of_shifted_physical_CZ
            (by omega : 2 ≤ d) E hE hEpos)
    · exact
        hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_zero_of_two_le
          hd E (le_of_not_gt hq2)
  apply hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_of_strict_implicit
    hd E hE hEpos hp hstrict
  · intro q a hq hq2 ha hqstrict
    exact hasRestrictedNormdSphMaximalPowerWeightStrongType_of_strict_negative_subtwo
      (by omega) E hE hEpos hq hq2 ha hqstrict
      (hunweighted hq (multiplicativeMinkowskiExponent_lt_critical_of_strict_implicit hqstrict))
  · intro q a hq ha hqstrict
    exact hasRestrictedNormdSphMaxPowerWeightStrongType_of_strict_implicit_nonnegative
      (by omega) E hE hEpos hq ha hqstrict hunweighted

open Auto.Spherical.PowerWeights Auto.Spherical.MSS Auto.FractalDimensions in
/-- Strict FRS sufficiency in every dimension at least two. -/
theorem frs_strict_strongType_two_le {d : ℕ} (hd : 2 ≤ d) (E : Set ℝ) (hE : E.Nonempty)
    (hEpos : E ⊆ Ioi (0 : ℝ)) {p α : ℝ} (hp : 1 < p)
    (hstrict : max ((α : EReal) + multiplicativeMinkowskiExponent E)
        (multiplicativeLegendreAssouadExponent E (((d : ℝ) - 1) * (p - 2) - α)) <
      (↑(((d : ℝ) - 1) * (p - 1)) : EReal)) :
    HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E p α := by
  rcases eq_or_lt_of_le hd with rfl | hd
  · exact hasRestrictedNormdSphMaximalPowerWeightStrongType_planar_of_strict_implicit
      E hE hEpos hp hstrict
  · exact frs_strict_strongType_three_le (by omega) E hE hEpos hp hstrict

open MeasureTheory Auto.Spherical.SurfaceMeasureDecay Auto.Spherical.PowerWeights
/-- `eq:typesetexplicit` for `E^μ`, interior: for `d ≥ 2`, `p > p(μ)` and
`L(p) < α < U(p)`, `M_{E^μ}` is bounded on `L^p(|x|^α)` for all inputs. -/
theorem sequence_interior_bound {d : ℕ} (hd : 2 ≤ d) {μ : ℝ} (hμ : 0 < μ) {p α : ℝ}
    (hp : sequenceCriticalExponent d μ < p)
    (hL : sequenceLowerEndpoint d μ p < α) (hU : α < sequenceUpperEndpoint d μ p) :
    ∃ C : ℝ, 0 < C ∧ ∀ f : Euclidean d → ℂ,
      MemLp f (ENNReal.ofReal p) (powerWeightedVolume d α) →
      MemLp (_root_.Spherical.M (sequenceSet μ) f) (ENNReal.ofReal p)
          (powerWeightedVolume d α) ∧
        eLpNorm (_root_.Spherical.M (sequenceSet μ) f) (ENNReal.ofReal p)
          (powerWeightedVolume d α) ≤
          ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal p) (powerWeightedVolume d α) := by
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hn : 0 < (d : ℝ) - 1 := by linarith
  have hμ1 : 0 < μ + 1 := by linarith
  have hcrit : 1 / (μ + 1) < ((d : ℝ) - 1) * (p - 1) := by
    unfold sequenceCriticalExponent at hp
    have h1 : 1 / ((μ + 1) * ((d : ℝ) - 1)) < p - 1 := by linarith
    rw [div_lt_iff₀ (by positivity)] at h1
    rw [div_lt_iff₀ hμ1]; nlinarith
  have hp1 : 1 < p := by
    have : 0 < 1 / (μ + 1) := by positivity
    by_contra h; push_neg at h; nlinarith
  have hα : -(d : ℝ) < α := by
    have : 1 - (d : ℝ) ≤ sequenceLowerEndpoint d μ p := le_max_left _ _
    linarith
  apply weighted_bound_of_normalized_strongType (by omega) _ hp1 hα
  exact frs_strict_strongType_two_le hd _ (sequenceSet_nonempty μ)
    (sequenceSet_subset_Ioi hμ.le) hp1
    ((sequence_strictCondition_iff (by omega) hμ p α).mpr ⟨hcrit, hL, hU⟩)

/-- Boundedness of `M_E` on `L^p(|x|^α)` in the sense used for the main
theorems: a uniform estimate for every weighted `L^p` input. -/
def WeightedMaximalBound (d : ℕ) (E : Set ℝ) (p α : ℝ) : Prop :=
  ∃ C : ℝ, 0 < C ∧ ∀ f : Euclidean d → ℂ,
    MemLp f (ENNReal.ofReal p) (powerWeightedVolume d α) →
    MemLp (_root_.Spherical.M E f) (ENNReal.ofReal p) (powerWeightedVolume d α) ∧
      eLpNorm (_root_.Spherical.M E f) (ENNReal.ofReal p) (powerWeightedVolume d α) ≤
        ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal p) (powerWeightedVolume d α)

/-- Restricting a weighted bound to Schwartz inputs gives the internal
restricted strong type of the FRS development. -/
theorem WeightedMaximalBound.strongType {d : ℕ} {E : Set ℝ} {p α : ℝ}
    (h : WeightedMaximalBound d E p α) :
    HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E p α := by
  obtain ⟨C, hC, hb⟩ := h
  refine ⟨C, hC, fun f hf => ?_⟩
  have := hb f hf
  have hM : _root_.Spherical.M E (f : Euclidean d → ℂ) =
      restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) :=
    restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal E _
  rwa [hM] at this

/-- `eq:lowerbdL` and `eq:lowerboundU(p)` for `E^μ`: boundedness on
`L^p(|x|^α)` with `p ≥ 1` forces `p ≥ p(μ)` and `L(p) ≤ α ≤ U(p)`. This is
the FRS necessary condition (arXiv:2602.17613, Thm. 1.1) evaluated with the
exponents of `E^μ`. -/
theorem sequence_necessary {d : ℕ} (hd : 2 ≤ d) {μ : ℝ} (hμ : 0 < μ) {p α : ℝ}
    (hp : 1 ≤ p) (h : WeightedMaximalBound d (sequenceSet μ) p α) :
    1 / (μ + 1) ≤ ((d : ℝ) - 1) * (p - 1) ∧
      sequenceLowerEndpoint d μ p ≤ α ∧ α ≤ sequenceUpperEndpoint d μ p :=
  (sequence_implicitCondition_iff hd hμ p α).mp
    (powerWeightEntropyImplicitCondition_of_restrictedStrongType hd (sequenceSet_nonempty μ)
      (sequenceSet_subset_Ioi hμ.le) hp h.strongType)

/-! ## Section 3.1: the two regimes of `Λ_{k,j}` (`eq:Lambdabounds`) -/

/-- Comparison of power weights on a ball: for `β ≤ α`, on `|x| ≤ R`,
`|x|^α ≤ R^{α-β} |x|^β`. -/
theorem setLIntegral_powerWeightedVolume_le_of_le {d : ℕ} (hd : 0 < d) {α β R : ℝ}
    (hβα : β ≤ α) {S : Set (Euclidean d)} (hS : MeasurableSet S)
    (hSR : S ⊆ Metric.closedBall 0 R) (G : Euclidean d → ℝ≥0∞) (hG : Measurable G) :
    (∫⁻ x in S, G x ∂powerWeightedVolume d α) ≤
      ENNReal.ofReal R ^ (α - β) * ∫⁻ x in S, G x ∂powerWeightedVolume d β := by
  rw [powerWeightedVolume, powerWeightedVolume,
    setLIntegral_withDensity_eq_setLIntegral_mul volume
      (measurable_radialPowerWeight d α) hG hS,
    setLIntegral_withDensity_eq_setLIntegral_mul volume
      (measurable_radialPowerWeight d β) hG hS, ← lintegral_const_mul' _ _
        (ENNReal.rpow_ne_top_of_nonneg (by linarith) ENNReal.ofReal_ne_top)]
  apply lintegral_mono_ae
  have hzero : ∀ᵐ x ∂(volume.restrict S), x ≠ (0 : Euclidean d) := by
    have : (volume : Measure (Euclidean d)) {0} = 0 := by
      have : Nontrivial (Euclidean d) := by
        have : Nonempty (Fin d) := ⟨⟨0, hd⟩⟩
        infer_instance
      exact measure_singleton 0
    exact ae_restrict_of_ae (measure_eq_zero_iff_ae_notMem.mp this |>.mono fun x hx => hx)
  filter_upwards [hzero, ae_restrict_mem hS] with x hx hxS
  have hxpos : 0 < ‖x‖ := norm_pos_iff.mpr hx
  have hxR : ‖x‖ ≤ R := by simpa using hSR hxS
  simp only [Pi.mul_apply, radialPowerWeight]
  have hne : ENNReal.ofReal ‖x‖ ≠ 0 := by simpa using hxpos
  have hsplit : ENNReal.ofReal ‖x‖ ^ α =
      ENNReal.ofReal ‖x‖ ^ (α - β) * ENNReal.ofReal ‖x‖ ^ β := by
    rw [← ENNReal.rpow_add _ _ hne ENNReal.ofReal_ne_top]; ring_nf
  rw [hsplit, mul_assoc]
  exact mul_le_mul' (ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal hxR) (by linarith)) le_rfl

/-- Exponent bookkeeping behind `eq:Lambdabounds`: with `n = d-1`,
`θ = d-(d-1)p`, `κ = (d-1)(p-1) - 1/(μ+1)` and `a = 1-d+θ/μ`, the exponent of
`Λ_{k,j}(p,a)` is `min(θ(j-Ak), κ(Ak-j))` with `A = (μ+1)/μ`, hence at most
`-min(θ,κ) |j - Ak|`. -/
theorem sequence_lambda_exponent_le {d : ℕ} {μ p : ℝ} (hμ : 0 < μ)
    (hθ : 0 < (d : ℝ) - ((d : ℝ) - 1) * p)
    (hκ : 0 < ((d : ℝ) - 1) * (p - 1) - 1 / (μ + 1)) (j k : ℝ) :
    -(k * (1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ)) +
        min (j - k) (j / (μ + 1)) -
        (j * ((d : ℝ) - 1) * (p - 1)) - k * ((d : ℝ) - 1) * (2 - p) ≤
      -(min ((d : ℝ) - ((d : ℝ) - 1) * p) (((d : ℝ) - 1) * (p - 1) - 1 / (μ + 1)) *
        |j - (μ + 1) / μ * k|) := by
  set θ := (d : ℝ) - ((d : ℝ) - 1) * p with hθdef
  set κ := ((d : ℝ) - 1) * (p - 1) - 1 / (μ + 1) with hκdef
  have hμ1 : 0 < μ + 1 := by linarith
  have e1 : -(k * (1 - (d : ℝ) + θ / μ)) + (j - k) - (j * ((d : ℝ) - 1) * (p - 1)) -
      k * ((d : ℝ) - 1) * (2 - p) = θ * (j - (μ + 1) / μ * k) := by
    rw [hθdef]; field_simp; ring
  have e2 : -(k * (1 - (d : ℝ) + θ / μ)) + j / (μ + 1) - (j * ((d : ℝ) - 1) * (p - 1)) -
      k * ((d : ℝ) - 1) * (2 - p) = κ * ((μ + 1) / μ * k - j) := by
    rw [hθdef, hκdef]; field_simp; ring
  have hmin : -(k * (1 - (d : ℝ) + θ / μ)) + min (j - k) (j / (μ + 1)) -
      (j * ((d : ℝ) - 1) * (p - 1)) - k * ((d : ℝ) - 1) * (2 - p) =
      min (θ * (j - (μ + 1) / μ * k)) (κ * ((μ + 1) / μ * k - j)) := by
    rw [← e1, ← e2]
    rcases le_total (j - k) (j / (μ + 1)) with h | h
    · rw [min_eq_left h, min_eq_left (by linarith)]
    · rw [min_eq_right h, min_eq_right (by linarith)]
  rw [hmin]
  have hε1 : min θ κ ≤ θ := min_le_left _ _
  have hε2 : min θ κ ≤ κ := min_le_right _ _
  have hε0 : 0 ≤ min θ κ := le_min hθ.le hκ.le
  rcases le_total 0 (j - (μ + 1) / μ * k) with h | h
  · rw [abs_of_nonneg h]
    apply (min_le_right _ _).trans
    nlinarith
  · rw [abs_of_nonpos h]
    apply (min_le_left _ _).trans
    nlinarith

/-- Windows of length `2^{-k}` meet `E^μ` in at most `12·2^{min(j-k, j/(μ+1))}`
intervals of length `2^{-j}`, `k ≤ j` (Section 3.1, lines 1324-1331). -/
theorem sequenceSet_window_cover {μ : ℝ} (hμ : 0 < μ) {j k : ℕ} (hkj : k ≤ j) (c : ℝ) :
    ∃ J : Finset ℝ, IsIntervalCover
        (sequenceSet μ ∩ {t | |t - c| ≤ (((2 : ℝ) ^ k)⁻¹) / 2}) (((2 : ℝ) ^ j)⁻¹) J ∧
      (J.card : ℝ≥0∞) ≤ 12 * (2 : ℝ≥0∞) ^ (min ((j : ℝ) - k) ((j : ℝ) / (μ + 1))) := by
  have hμ1 : 0 < μ + 1 := by linarith
  have hδ : (0 : ℝ) < ((2 : ℝ) ^ j)⁻¹ := by positivity
  have hδ1 : ((2 : ℝ) ^ j)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (one_le_pow₀ (by norm_num))
  have hS : {t : ℝ | |t - c| ≤ (((2 : ℝ) ^ k)⁻¹) / 2} ⊆
      Icc (c - (((2 : ℝ) ^ k)⁻¹) / 2) (c + (((2 : ℝ) ^ k)⁻¹) / 2) := by
    intro t ht
    have := abs_le.mp (show |t - c| ≤ (((2 : ℝ) ^ k)⁻¹) / 2 from ht)
    exact ⟨by linarith, by linarith⟩
  obtain ⟨J, hJ, hcard⟩ := sequenceSet_cover_min hμ hδ hδ1
    (by have : (0 : ℝ) < ((2 : ℝ) ^ k)⁻¹ := by positivity
        linarith) hS
  refine ⟨J, hJ, ?_⟩
  have hratio : (c + (((2 : ℝ) ^ k)⁻¹) / 2 - (c - (((2 : ℝ) ^ k)⁻¹) / 2)) /
      ((2 : ℝ) ^ j)⁻¹ = (2 : ℝ) ^ ((j : ℝ) - k) := by
    rw [Real.rpow_sub (by norm_num), Real.rpow_natCast, Real.rpow_natCast]
    field_simp
    ring
  have hpow : (((2 : ℝ) ^ j)⁻¹) ^ (-(1 / (μ + 1))) = (2 : ℝ) ^ ((j : ℝ) / (μ + 1)) := by
    rw [← Real.rpow_natCast, ← Real.rpow_neg_one, ← Real.rpow_mul (by norm_num),
      ← Real.rpow_mul (by norm_num)]
    congr 1; ring
  rw [hratio, hpow] at hcard
  have hone : (1 : ℝ) ≤ (2 : ℝ) ^ ((j : ℝ) - k) :=
    Real.one_le_rpow (by norm_num) (by have : (k : ℝ) ≤ j := by exact_mod_cast hkj
                                       linarith)
  have hmin : min ((2 : ℝ) ^ ((j : ℝ) - k) + 1) ((2 : ℝ) ^ ((j : ℝ) / (μ + 1))) ≤
      2 * (2 : ℝ) ^ (min ((j : ℝ) - k) ((j : ℝ) / (μ + 1))) := by
    rcases le_total ((j : ℝ) - k) ((j : ℝ) / (μ + 1)) with h | h
    · rw [min_eq_left h]
      exact (min_le_left _ _).trans (by linarith)
    · rw [min_eq_right h]
      have : (0 : ℝ) ≤ (2 : ℝ) ^ ((j : ℝ) / (μ + 1)) := by positivity
      exact (min_le_right _ _).trans (by linarith)
  have hreal : (J.card : ℝ) ≤ 12 * (2 : ℝ) ^ (min ((j : ℝ) - k) ((j : ℝ) / (μ + 1))) := by
    linarith
  calc (J.card : ℝ≥0∞) = ENNReal.ofReal (J.card : ℝ) := by simp
    _ ≤ ENNReal.ofReal (12 * (2 : ℝ) ^ (min ((j : ℝ) - k) ((j : ℝ) / (μ + 1)))) :=
      ENNReal.ofReal_le_ofReal hreal
    _ = _ := by
      rw [ENNReal.ofReal_mul (by norm_num), ← ENNReal.ofReal_rpow_of_pos (by norm_num)]
      norm_num

/-- `ENNReal.ofReal (2^{-k}) = 2^{-k}`. -/
theorem ofReal_inv_two_pow (k : ℕ) :
    ENNReal.ofReal (((2 : ℝ) ^ k)⁻¹) = (2 : ℝ≥0∞) ^ (-(k : ℝ)) := by
  rw [ENNReal.ofReal_inv_of_pos (by positivity), ENNReal.ofReal_pow (by norm_num),
    ENNReal.ofReal_ofNat, ENNReal.rpow_neg, ENNReal.rpow_natCast]

theorem two_rpow_ne_top (x : ℝ) : (2 : ℝ≥0∞) ^ x ≠ ∞ :=
  ENNReal.rpow_ne_top_of_ne_zero (by norm_num) (by norm_num)

/-- Source `eq:Lambdabounds` together with `lem:k<j` and `lem:k>j`: for the
weight `a = L(p) = 1-d+θ/μ`, every frequency `j` and every output shell
`|x| ≈ 2^{-k}`, `k ≥ 4`, the localized maximal estimate for `E^μ` carries the
factor `2^{-ε|j - (μ+1)k/μ|}`, `ε = min(θ, κ)`. The case `j ≥ k` uses the two
covering regimes of `E^μ`; the case `j < k` uses the low-frequency lemma and
the weight comparison `|x|^a ≤ 2^{-kθ/μ} |x|^{1-d}` on the shell. -/
theorem sequence_shell_bound {d N : ℕ} (hd : 2 ≤ d)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N)
    (hφ : ∀ x, (1 : ℝ) / 8 < ‖x‖ → φ x = 0)
    {μ p : ℝ} (hμ : 0 < μ) (hp₁ : 1 < p) (hp₂ : p < 2)
    (hθ : 0 < (d : ℝ) - ((d : ℝ) - 1) * p)
    (hκ : 0 < ((d : ℝ) - 1) * (p - 1) - 1 / (μ + 1)) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (j k : ℕ), 4 ≤ k → ∀ f : SchwartzMap (Euclidean d) ℂ,
      (∫⁻ x in euclideanAnnulus d ((((2 : ℝ) ^ k)⁻¹) / 2) (((2 : ℝ) ^ k)⁻¹),
        (⨆ t : sequenceSet μ,
          ‖sphericalAverage d (compactConvolution (compactSynthesisKernel φ j) f) t x‖ₑ) ^ p
          ∂powerWeightedVolume d (1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ)) ≤
        A * (2 : ℝ≥0∞) ^ (-(min ((d : ℝ) - ((d : ℝ) - 1) * p)
            (((d : ℝ) - 1) * (p - 1) - 1 / (μ + 1)) * |(j : ℝ) - (μ + 1) / μ * k|)) *
          ∫⁻ x, ‖f x‖ₑ ^ p := by
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hE : sequenceSet μ ⊆ Icc 1 2 := sequenceSet_subset_Icc hμ.le
  obtain ⟨A₁, hA₁, hb₁⟩ := synthesis_thinWindow_Lp_bound hd φ hflat hN hφ hp₁ hp₂
  obtain ⟨A₂, hA₂, hb₂⟩ := synthesis_low_frequency_moment_bound (by omega : 0 < d) φ hp₁.le
  set θ := (d : ℝ) - ((d : ℝ) - 1) * p with hθdef
  set κ := ((d : ℝ) - 1) * (p - 1) - 1 / (μ + 1) with hκdef
  set a := 1 - (d : ℝ) + θ / μ with hadef
  set ε := min θ κ with hεdef
  have hθ1 : θ ≤ 1 := by rw [hθdef]; nlinarith
  have hεθ : ε ≤ θ := min_le_left _ _
  have hε0 : 0 ≤ ε := le_min hθ.le hκ.le
  have haθ : a - (1 - (d : ℝ)) = θ / μ := by rw [hadef]; ring
  have ha_ge : 1 - (d : ℝ) ≤ a := by
    have := div_nonneg hθ.le hμ.le; linarith
  set W : ℝ≥0∞ := (2 : ℝ≥0∞) ^ (-a) + 1
  have hW : W ≠ ∞ := ENNReal.add_ne_top.mpr ⟨two_rpow_ne_top _, by norm_num⟩
  refine ⟨W * A₁ * 12 + A₂, ENNReal.add_ne_top.mpr
    ⟨ENNReal.mul_ne_top (ENNReal.mul_ne_top hW hA₁) (by norm_num), hA₂⟩, ?_⟩
  intro j k hk f
  set G : Euclidean d → ℝ≥0∞ := fun x => (⨆ t : sequenceSet μ,
    ‖sphericalAverage d (compactConvolution (compactSynthesisKernel φ j) f) t x‖ₑ) ^ p
  have hGm : Measurable G :=
    (measurable_schwartz_radius_supremum _ (sequenceSet μ)).pow_const p
  have hkr : (4 : ℝ) ≤ k := by exact_mod_cast hk
  have hAk : (μ + 1) / μ * (k : ℝ) = k + k / μ := by field_simp
  rcases le_or_gt k j with hkj | hjk
  · -- high frequencies: the two covering regimes
    obtain ⟨I, hI, hgrid⟩ := dyadic_radius_grid_cover k
    have hsmall : ((2 : ℝ) ^ k)⁻¹ ≤ 1 / 16 := by
      have hh := one_div_le_one_div_of_le (by norm_num : (0 : ℝ) < 2 ^ 4)
        (pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2) hk)
      norm_num at hh ⊢
      exact hh
    set m : ℝ := min ((j : ℝ) - k) ((j : ℝ) / (μ + 1))
    have hu := hb₁ j k (by omega) hkj hsmall (sequenceSet μ) hE I
      (fun m hm => (hI m hm).1) (fun t ht => hgrid t (hE ht))
      (12 * (2 : ℝ≥0∞) ^ m) (fun c _ => sequenceSet_window_cover hμ hkj _) f
    have hw := dyadic_annulus_weight_moment_le G hGm a k
    have hexp := sequence_lambda_exponent_le (d := d) (μ := μ) (p := p) hμ hθ hκ j k
    have hexp' : -((k : ℝ) * a) + m + (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
        (k : ℝ) * ((d : ℝ) - 1) * (2 - p)) ≤ -(ε * |(j : ℝ) - (μ + 1) / μ * k|) := by
      rw [hadef]; linarith
    have hpow : (2 : ℝ≥0∞) ^ (-((k : ℝ) * a)) * (2 : ℝ≥0∞) ^ m *
        (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
          (k : ℝ) * ((d : ℝ) - 1) * (2 - p)) ≤
        (2 : ℝ≥0∞) ^ (-(ε * |(j : ℝ) - (μ + 1) / μ * k|)) := by
      rw [← ENNReal.rpow_add _ _ (by norm_num) (by norm_num),
        ← ENNReal.rpow_add _ _ (by norm_num) (by norm_num)]
      exact ENNReal.rpow_le_rpow_of_exponent_le (by norm_num) hexp'
    calc (∫⁻ x in euclideanAnnulus d ((((2 : ℝ) ^ k)⁻¹) / 2) (((2 : ℝ) ^ k)⁻¹),
          G x ∂powerWeightedVolume d a)
        ≤ W * (2 : ℝ≥0∞) ^ (-((k : ℝ) * a)) *
            ∫⁻ x in Metric.closedBall (0 : Euclidean d) (((2 : ℝ) ^ k)⁻¹), G x := hw
      _ ≤ W * (2 : ℝ≥0∞) ^ (-((k : ℝ) * a)) *
            (A₁ * (12 * (2 : ℝ≥0∞) ^ m) * (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
              (k : ℝ) * ((d : ℝ) - 1) * (2 - p)) * ∫⁻ x, ‖f x‖ₑ ^ p) :=
          mul_le_mul' le_rfl hu
      _ = (W * A₁ * 12) * ((2 : ℝ≥0∞) ^ (-((k : ℝ) * a)) * (2 : ℝ≥0∞) ^ m *
            (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1)) -
              (k : ℝ) * ((d : ℝ) - 1) * (2 - p))) * ∫⁻ x, ‖f x‖ₑ ^ p := by ring
      _ ≤ (W * A₁ * 12) * (2 : ℝ≥0∞) ^ (-(ε * |(j : ℝ) - (μ + 1) / μ * k|)) *
            ∫⁻ x, ‖f x‖ₑ ^ p := by gcongr
      _ ≤ _ := by gcongr; exact le_self_add
  · -- low frequencies: `lem:k>j` and the weight comparison
    have hball : euclideanAnnulus d ((((2 : ℝ) ^ k)⁻¹) / 2) (((2 : ℝ) ^ k)⁻¹) ⊆
        Metric.closedBall (0 : Euclidean d) (((2 : ℝ) ^ k)⁻¹) := fun x hx => hx.1
    have hcmp := setLIntegral_powerWeightedVolume_le_of_le (R := ((2 : ℝ) ^ k)⁻¹) (by omega : 0 < d) ha_ge
      measurableSet_closedBall (subset_refl _) G hGm
    have hlow := hb₂ (sequenceSet μ) hE k (k - j) (by omega) f
    rw [show k - (k - j) = j by omega] at hlow
    have hkj' : ((k - j : ℕ) : ℝ) = (k : ℝ) - j := by
      rw [Nat.cast_sub hjk.le]
    have hjk' : (j : ℝ) < k := by exact_mod_cast hjk
    have hexp : -((k : ℝ) * (θ / μ)) + -(((k - j : ℕ) : ℝ)) ≤
        -(ε * |(j : ℝ) - (μ + 1) / μ * k|) := by
      rw [hkj', hAk, abs_of_neg (by
        have : 0 ≤ (k : ℝ) / μ := div_nonneg (by linarith) hμ.le
        linarith)]
      have h1 : ε * ((k : ℝ) - j) ≤ (k : ℝ) - j :=
        mul_le_of_le_one_left (by linarith) (hεθ.trans hθ1)
      have h2 : ε * ((k : ℝ) / μ) ≤ (k : ℝ) * (θ / μ) := by
        rw [mul_div_assoc', mul_div_assoc', mul_comm (k : ℝ) θ]
        exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right hεθ (by linarith))
          hμ.le
      nlinarith
    have hpow : ENNReal.ofReal (((2 : ℝ) ^ k)⁻¹) ^ (a - (1 - (d : ℝ))) *
        ENNReal.ofReal (((2 : ℝ) ^ (k - j))⁻¹) ≤
        (2 : ℝ≥0∞) ^ (-(ε * |(j : ℝ) - (μ + 1) / μ * k|)) := by
      rw [ofReal_inv_two_pow, ofReal_inv_two_pow, ← ENNReal.rpow_mul, haθ,
        ← ENNReal.rpow_add _ _ (by norm_num) (by norm_num)]
      apply ENNReal.rpow_le_rpow_of_exponent_le (by norm_num)
      linarith
    calc (∫⁻ x in euclideanAnnulus d ((((2 : ℝ) ^ k)⁻¹) / 2) (((2 : ℝ) ^ k)⁻¹),
          G x ∂powerWeightedVolume d a)
        ≤ ∫⁻ x in Metric.closedBall (0 : Euclidean d) (((2 : ℝ) ^ k)⁻¹),
            G x ∂powerWeightedVolume d a := lintegral_mono_set hball
      _ ≤ ENNReal.ofReal (((2 : ℝ) ^ k)⁻¹) ^ (a - (1 - (d : ℝ))) *
            ∫⁻ x in Metric.closedBall (0 : Euclidean d) (((2 : ℝ) ^ k)⁻¹),
              G x ∂powerWeightedVolume d (1 - (d : ℝ)) := hcmp
      _ ≤ ENNReal.ofReal (((2 : ℝ) ^ k)⁻¹) ^ (a - (1 - (d : ℝ))) *
            (A₂ * ENNReal.ofReal (((2 : ℝ) ^ (k - j))⁻¹) * ∫⁻ x, ‖f x‖ₑ ^ p) := by
          gcongr
      _ = A₂ * (ENNReal.ofReal (((2 : ℝ) ^ k)⁻¹) ^ (a - (1 - (d : ℝ))) *
            ENNReal.ofReal (((2 : ℝ) ^ (k - j))⁻¹)) * ∫⁻ x, ‖f x‖ₑ ^ p := by ring
      _ ≤ A₂ * (2 : ℝ≥0∞) ^ (-(ε * |(j : ℝ) - (μ + 1) / μ * k|)) *
            ∫⁻ x, ‖f x‖ₑ ^ p := by gcongr
      _ ≤ _ := by gcongr; exact le_add_self

/-- Source `eq:LpellpSmod`: the diagonal estimate for disjointly localized
pieces at frequencies `ρ(k)`, where every `2^{-ε|ρ(k) - (μ+1)k/μ|}` is bounded
by `Q`. -/
theorem sequence_diagonal_maximal {d N : ℕ} (hd : 2 ≤ d)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N)
    (hφ : ∀ x, (1 : ℝ) / 8 < ‖x‖ → φ x = 0)
    {μ p : ℝ} (hμ : 0 < μ) (hp₁ : 1 < p) (hp₂ : p < 2)
    (hθ : 0 < (d : ℝ) - ((d : ℝ) - 1) * p)
    (hκ : 0 < ((d : ℝ) - 1) * (p - 1) - 1 / (μ + 1)) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (L : Finset ℕ), (∀ k ∈ L, 4 ≤ k) → ∀ (ρ : ℕ → ℕ) (Q : ℝ≥0∞),
      (∀ k ∈ L, (2 : ℝ≥0∞) ^ (-(min ((d : ℝ) - ((d : ℝ) - 1) * p)
          (((d : ℝ) - 1) * (p - 1) - 1 / (μ + 1)) * |((ρ k : ℕ) : ℝ) - (μ + 1) / μ * k|)) ≤ Q) →
      ∀ f : ℕ → SchwartzMap (Euclidean d) ℂ,
      (∫⁻ x, (⨆ t : sequenceSet μ, ‖∑ k ∈ L, (dyadicSpatialShell d (-(k : ℤ) - 1)).indicator
        (sphericalAverage d (compactConvolution (compactSynthesisKernel φ (ρ k)) (f k)) t)
        x‖ₑ) ^ p ∂powerWeightedVolume d (1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ)) ≤
        A * Q * ∫⁻ x, ∑ k ∈ L, ‖f k x‖ₑ ^ p := by
  obtain ⟨A, hA, hb⟩ := sequence_shell_bound hd φ hflat hN hφ hμ hp₁ hp₂ hθ hκ
  refine ⟨A, hA, ?_⟩
  intro L hL ρ Q hQ f
  rw [disjoint_indicator_maximal_moment _ L
    (fun k : ℕ => dyadicSpatialShell d (-(k : ℤ) - 1))
    (fun k (t : sequenceSet μ) => sphericalAverage d
      (compactConvolution (compactSynthesisKernel φ (ρ k)) (f k)) t)
    (fun k => measurableSet_dyadicSpatialShell d (-(k : ℤ) - 1))
    (pairwiseDisjoint_negative_dyadicSpatialShell d)
    (fun k => measurable_schwartz_radius_supremum
      (compactConvolution (compactSynthesisKernel φ (ρ k)) (f k)) _)
    (by linarith : 0 < p)]
  rw [lintegral_finsetSum L (fun k _ => (f k).continuous.measurable.enorm.pow_const p),
    Finset.mul_sum]
  apply Finset.sum_le_sum
  intro k hk
  calc _ ≤ ∫⁻ x in euclideanAnnulus d ((((2 : ℝ) ^ k)⁻¹) / 2) (((2 : ℝ) ^ k)⁻¹),
        (⨆ t : sequenceSet μ, ‖sphericalAverage d
          (compactConvolution (compactSynthesisKernel φ (ρ k)) (f k)) t x‖ₑ) ^ p
          ∂powerWeightedVolume d (1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ) :=
        lintegral_mono_set (negative_dyadicSpatialShell_subset_annulus d k)
    _ ≤ _ := hb (ρ k) k (hL k hk) (f k)
    _ ≤ A * Q * ∫⁻ x, ‖f k x‖ₑ ^ p := by gcongr; exact hQ k hk

/-- The frequency assignment `j_n(k) = ⌊(μ+1)k/μ⌋ + n` of Section 3.1. -/
def sequenceFrequency (μ : ℝ) (n : ℤ) (k : ℕ) : ℕ :=
  (⌊(μ + 1) / μ * (k : ℝ)⌋ + n).toNat

/-- The distance of `j_n(k)` from the peak `(μ+1)k/μ` is at least `|n| - 1`
when `j_n(k) ≥ 0` is not truncated. -/
theorem abs_sequenceFrequency_sub_ge {μ : ℝ} {n : ℤ} {k : ℕ}
    (hpos : 0 ≤ ⌊(μ + 1) / μ * (k : ℝ)⌋ + n) :
    |(n : ℝ)| - 1 ≤ |((sequenceFrequency μ n k : ℕ) : ℝ) - (μ + 1) / μ * k| := by
  unfold sequenceFrequency
  have hcast : (((⌊(μ + 1) / μ * (k : ℝ)⌋ + n).toNat : ℕ) : ℝ) =
      (⌊(μ + 1) / μ * (k : ℝ)⌋ : ℝ) + n := by
    have := Int.toNat_of_nonneg hpos
    exact_mod_cast this
  rw [hcast]
  have h1 := Int.floor_le ((μ + 1) / μ * (k : ℝ))
  have h2 := Int.lt_floor_add_one ((μ + 1) / μ * (k : ℝ))
  rcases le_total 0 (n : ℝ) with hn | hn
  · rw [abs_of_nonneg hn]
    calc (n : ℝ) - 1 ≤ (⌊(μ + 1) / μ * (k : ℝ)⌋ : ℝ) + n - (μ + 1) / μ * k := by linarith
      _ ≤ _ := le_abs_self _
  · rw [abs_of_nonpos hn]
    calc -(n : ℝ) - 1 ≤ -((⌊(μ + 1) / μ * (k : ℝ)⌋ : ℝ) + n - (μ + 1) / μ * k) := by
          linarith
      _ ≤ _ := neg_le_abs _

/-! ## The Section 2 bootstrap at a general weight

Section 3.1 runs the argument of Section 2 with the weight `|x|^{L(p)}` in
place of `|x|^{1-d}`. The following statements are the weight-general forms of
the corresponding Section 2 lemmas in `MainTheorems.lean`; their proofs are the
same, with `1-d` replaced by `α`. -/

/-- The scalar core estimate at weight `α`, with the output measure allowed to
be truncated (`SchwartzCoreMomentBound` is the case `α = 1-d`). -/
def CoreMomentBoundAt {d : ℕ} (α : ℝ) (ν : Measure (Euclidean d))
    (E : Set ℝ) (p B : ℝ) : Prop :=
  ∀ g : SchwartzMap (Euclidean d) ℂ,
    (∫⁻ x, (⨆ t : E, ‖sphericalAverage d g t x‖ₑ) ^ p ∂ν) ≤
      ENNReal.ofReal B * ∫⁻ x, ‖g x‖ₑ ^ p ∂powerWeightedVolume d α

/-- Weight-general form of `inner_ball_moment_of_finite_shells`. -/
theorem inner_ball_moment_of_finite_shells_at {d : ℕ} (hd : 0 < d) {α : ℝ}
    (ν : Measure (Euclidean d)) (hν : ν ≤ powerWeightedVolume d α)
    (E : Set ℝ) (f : SchwartzMap (Euclidean d) ℂ) {p : ℝ} (hp : 0 < p)
    (Q : ℝ≥0∞)
    (hb : ∀ (L : Finset ℕ), (∀ k ∈ L, 4 ≤ k) →
      (∫⁻ x, (⨆ t : E, ‖∑ k ∈ L, (dyadicSpatialShell d (-(k : ℤ) - 1)).indicator
        (sphericalAverage d f t) x‖ₑ) ^ p ∂ν) ≤ Q) :
    (∫⁻ x in Metric.closedBall (0 : Euclidean d) (1 / 16),
      (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p ∂ν) ≤ Q := by
  classical
  let S := fun k : ℕ => dyadicSpatialShell d (-((k + 4 : ℕ) : ℤ) - 1)
  let F := fun x => (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p
  have hfinite (I : Finset ℕ) : (∑ k ∈ I, ∫⁻ x in S k, F x ∂ν) ≤ Q := by
    have hh := hb (I.image (fun k => k + 4)) (by
      intro k hk
      obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hk
      omega)
    rw [disjoint_indicator_maximal_moment ν _
      (fun k : ℕ => dyadicSpatialShell d (-(k : ℤ) - 1))
      (fun _ (t : E) => sphericalAverage d f t)
      (fun k => measurableSet_dyadicSpatialShell d (-(k : ℤ) - 1))
      (pairwiseDisjoint_negative_dyadicSpatialShell d)
      (fun _ => measurable_schwartz_radius_supremum f E) hp] at hh
    rw [Finset.sum_image (fun i _ j _ hij => Nat.add_right_cancel hij)] at hh
    exact hh
  have hsum : (∑' k, ∫⁻ x in S k, F x ∂ν) ≤ Q :=
    ENNReal.summable.tsum_le_of_sum_le hfinite
  have hU : MeasurableSet (⋃ k, S k) := MeasurableSet.iUnion (fun k =>
    measurableSet_dyadicSpatialShell d _)
  have hzero : ν ({0} : Set (Euclidean d)) = 0 := by
    apply le_antisymm _ bot_le
    exact (hν _).trans_eq (powerWeightedVolume_singleton_zero hd α)
  have hae : ∀ᵐ x ∂ν, x ≠ (0 : Euclidean d) := by
    simpa only [ae_iff, not_not, Set.ofPred_eq_eq_singleton] using hzero
  calc
    _ = ∫⁻ x, (Metric.closedBall (0 : Euclidean d) (1 / 16)).indicator F x ∂ν :=
      (lintegral_indicator measurableSet_closedBall F).symm
    _ ≤ ∫⁻ x, (⋃ k, S k).indicator F x ∂ν := by
      apply lintegral_mono_ae
      filter_upwards [hae] with x hx₀
      by_cases hx : x ∈ Metric.closedBall (0 : Euclidean d) (1 / 16)
      · have hxs : x ∈ ⋃ k, S k := inner_ball_subset_negative_shells
          (by simpa only [Metric.mem_closedBall, dist_zero_right] using hx) hx₀
        simp only [Set.indicator_of_mem hx, Set.indicator_of_mem hxs]
        exact le_rfl
      · rw [Set.indicator_of_notMem hx]
        exact bot_le
    _ = ∫⁻ x in ⋃ k, S k, F x ∂ν := lintegral_indicator hU F
    _ ≤ ∑' k, ∫⁻ x in S k, F x ∂ν := lintegral_iUnion_le S F
    _ ≤ Q := hsum

/-- Weight-general form of `core_constant_of_sublinear_improvement`. -/
theorem core_constant_of_sublinear_improvement_at {d : ℕ} {α : ℝ}
    (ν : Measure (Euclidean d)) (E : Set ℝ) (p : ℝ) {K θ : ℝ}
    (hK : 0 ≤ K) (hθ : θ < 1)
    (hfinite : ∃ B : ℝ, 0 ≤ B ∧ CoreMomentBoundAt α ν E p B)
    (himprove : ∀ B : ℝ, 0 < B → CoreMomentBoundAt α ν E p B →
      CoreMomentBoundAt α ν E p (K * (1 + B ^ θ))) :
    CoreMomentBoundAt α ν E p (max (2 * (1 + K)) ((2 * K) ^ (1 / (1 - θ)))) := by
  let S : Set ℝ := {B | 0 ≤ B ∧ CoreMomentBoundAt α ν E p B}
  have hS : S.Nonempty := hfinite
  have hSlower : BddBelow S := ⟨0, fun _ h => h.1⟩
  have hinf : 0 ≤ sInf S := le_csInf hS (fun _ h => h.1)
  let B := sInf S + 1
  have hB : 0 < B := by dsimp only [B]; linarith
  obtain ⟨b, hb, hbB⟩ := exists_lt_of_csInf_lt hS (show sInf S < B by dsimp only [B]; linarith)
  have hcore : CoreMomentBoundAt α ν E p B := by
    intro f
    exact (hb.2 f).trans (mul_le_mul' (ENNReal.ofReal_le_ofReal hbB.le) le_rfl)
  have hnext := himprove B hB hcore
  have hnextpos : 0 ≤ K * (1 + B ^ θ) := mul_nonneg hK (by positivity)
  have hinext : sInf S ≤ K * (1 + B ^ θ) := csInf_le hSlower ⟨hnextpos, hnext⟩
  have hbound := sublinear_bootstrap_bound hB.le hK hθ
    (show B ≤ 1 + K * (1 + B ^ θ) by dsimp only [B]; linarith)
  intro f
  exact (hcore f).trans (mul_le_mul' (ENNReal.ofReal_le_ofReal hbound) le_rfl)

/-- Weight-general form of `core_improvement_of_split_bounds`. -/
theorem core_improvement_of_split_bounds_at {d : ℕ} {p : ℝ} (hp : 1 < p) (α : ℝ)
    (AL AG AH D : ℝ≥0∞) (hAL : AL ≠ ∞) (hAG : AG ≠ ∞) (hAH : AH ≠ ∞) (hD : D ≠ ∞) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ E : Set ℝ,
    (∀ f : SchwartzMap (Euclidean d) ℂ, (∀ y, 1 / 4 < ‖y‖ → f y = 0) →
      (∫⁻ x, (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p ∂powerWeightedVolume d α) ≤
          AL * ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d α) →
    (∀ f : SchwartzMap (Euclidean d) ℂ,
      (∀ y, y ∉ euclideanAnnulus d (1 / 8) 8 → f y = 0) →
      (∫⁻ x in (Metric.closedBall (0 : Euclidean d) (1 / 16))ᶜ,
        (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p ∂powerWeightedVolume d α) ≤
            AG * ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d α) →
    (∀ f : SchwartzMap (Euclidean d) ℂ, (∀ y, ‖y‖ ≤ 4 → f y = 0) →
      (∫⁻ x, (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p ∂powerWeightedVolume d α) ≤
          AH * ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d α) →
    ∀ (ν : Measure (Euclidean d)),
      ν ≤ powerWeightedVolume d α → ∀ B : ℝ, 0 < B →
      (∀ f : SchwartzMap (Euclidean d) ℂ,
        (∀ y, ‖y‖ < 1 / 8 → f y = 0) → (∀ y, 8 < ‖y‖ → f y = 0) →
        (∫⁻ x in Metric.closedBall (0 : Euclidean d) (1 / 16),
          (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p ∂ν) ≤
            D * ENNReal.ofReal B ^ (1 - p / 2) *
              ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d α) →
      CoreMomentBoundAt α ν E p (K * (1 + B ^ (1 - p / 2))) := by
  let c : ℝ≥0∞ := 2 ^ p
  let Z := AL + AG + AH + D
  let K₀ := c * (c * (Z + Z) + Z) * c
  have hc : c ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (by linarith) (by norm_num)
  have hZ : Z ≠ ∞ := by dsimp only [Z]; finiteness
  have hK₀ : K₀ ≠ ∞ := by dsimp only [K₀]; finiteness
  let K := K₀.toReal + 1
  have hK : 0 ≤ K := by dsimp only [K]; positivity
  have hKle : K₀ ≤ ENNReal.ofReal K := by
    rw [← ENNReal.ofReal_toReal hK₀]
    exact ENNReal.ofReal_le_ofReal (by dsimp only [K]; linarith)
  refine ⟨K, hK, ?_⟩
  intro E hL hG hH ν hν B hB hinner f
  obtain ⟨L, G, H, hsplit, hLs, hGs, hHs, hLn, hGn, hHn⟩ := exists_low_middle_high_split f
  let μ := powerWeightedVolume d α
  let Q := ∫⁻ x, ‖f x‖ₑ ^ p ∂μ
  let b := ENNReal.ofReal B ^ (1 - p / 2)
  let U := Z * (1 + b) * (c * Q)
  have hinput (g : SchwartzMap (Euclidean d) ℂ) (hg : ∀ y, ‖g y‖ ≤ 2 * ‖f y‖) :
      (∫⁻ x, ‖g x‖ₑ ^ p ∂μ) ≤ c * Q := by
    simpa only [ENNReal.ofReal_ofNat] using schwartz_moment_le_of_norm_le μ f g
      (by linarith : 0 ≤ p) (by norm_num : (0 : ℝ) ≤ 2) hg
  have hALZ : AL ≤ Z := by dsimp only [Z]; exact le_add_right (le_add_right (le_add_right le_rfl))
  have hAGZ : AG ≤ Z := by
    dsimp only [Z]
    exact le_add_right (le_add_right (le_add_left le_rfl))
  have hAHZ : AH ≤ Z := by dsimp only [Z]; exact le_add_right (le_add_left le_rfl)
  have hDZ : D ≤ Z := by dsimp only [Z]; exact le_add_left le_rfl
  have hZb : Z ≤ Z * (1 + b) := by
    simpa only [mul_one] using mul_le_mul' (le_refl Z) (le_add_right (le_refl 1))
  have hlow : (∫⁻ x, (⨆ t : E, ‖sphericalAverage d L t x‖ₑ) ^ p ∂ν) ≤ U :=
    ((lintegral_mono' hν le_rfl).trans (hL L hLs)).trans
      (mul_le_mul' (hALZ.trans hZb) (hinput L hLn))
  have hhigh : (∫⁻ x, (⨆ t : E, ‖sphericalAverage d H t x‖ₑ) ^ p ∂ν) ≤ U :=
    ((lintegral_mono' hν le_rfl).trans (hH H hHs)).trans
      (mul_le_mul' (hAHZ.trans hZb) (hinput H hHn))
  have hGi : ∀ y, ‖y‖ < 1 / 8 → G y = 0 := by
    intro y hy
    apply hGs y
    simpa only [euclideanAnnulus, Set.mem_sdiff, Metric.mem_ball, Metric.mem_closedBall,
      dist_zero_right, not_and, not_not] using (fun _ => hy)
  have hGo : ∀ y, 8 < ‖y‖ → G y = 0 := by
    intro y hy
    apply hGs y
    simp only [euclideanAnnulus, Set.mem_sdiff, Metric.mem_closedBall, dist_zero_right]
    exact fun hh => (not_le.mpr hy) hh.1
  have hmiddle : (∫⁻ x, (⨆ t : E, ‖sphericalAverage d G t x‖ₑ) ^ p ∂ν) ≤ U := by
    rw [← lintegral_add_compl (A := Metric.closedBall (0 : Euclidean d) (1 / 16))
      _ measurableSet_closedBall]
    have hi := (hinner G hGi hGo).trans (mul_le_mul' le_rfl (hinput G hGn))
    have ho := ((lintegral_mono' (Measure.restrict_mono_measure hν _) le_rfl).trans
      (hG G hGs)).trans (mul_le_mul' le_rfl (hinput G hGn))
    apply (add_le_add hi ho).trans
    have he : D * b + AG ≤ Z * (1 + b) := by
      calc
        _ ≤ Z * b + Z := add_le_add (mul_le_mul' hDZ le_rfl) hAGZ
        _ = _ := by ring
    simpa only [U, ← add_mul] using mul_le_mul' he (le_refl (c * Q))
  have hsum := (schwartz_spherical_maximal_moment_add_le (L + G) H E ν
    (by linarith : 0 ≤ p)).trans (mul_le_mul' le_rfl (add_le_add
      ((schwartz_spherical_maximal_moment_add_le L G E ν (by linarith)).trans
        (mul_le_mul' le_rfl (add_le_add hlow hmiddle))) hhigh))
  have htotal : (∫⁻ x, (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p ∂ν) ≤
      K₀ * (1 + b) * Q := by
    rw [hsplit]
    convert hsum using 1
    dsimp only [K₀, U, c]
    ring
  apply htotal.trans
  rw [ENNReal.ofReal_mul hK, ENNReal.ofReal_add (by norm_num : (0 : ℝ) ≤ 1)
      (Real.rpow_nonneg hB.le (1 - p / 2)),
    ENNReal.ofReal_one, ← ENNReal.ofReal_rpow_of_pos hB]
  exact mul_le_mul' (mul_le_mul' hKle le_rfl) le_rfl

/-- Weight-general form of `truncated_core_bound_of_unweighted`, for
`α ≤ 0`. -/
theorem truncated_core_bound_of_unweighted_at {d : ℕ} (hd : 2 ≤ d)
    {p U r α : ℝ} (hp : 1 < p) (hr : 0 < r) (hα : α ≤ 0) {E : Set ℝ}
    (hEI : E ⊆ Icc (1 : ℝ) 2) (hU : UnweightedMaximalBound d E p U) :
    ∃ B : ℝ, 0 ≤ B ∧ CoreMomentBoundAt α
      ((powerWeightedVolume d α).restrict (Metric.closedBall (0 : Euclidean d) r)ᶜ) E p B := by
  have hp0 : 0 < p := by linarith
  obtain ⟨AL, hAL, hlow⟩ := uniform_low_input_constant hp0 hα U
  obtain ⟨AG, hAG, hmid⟩ := uniform_middle_input_constant hp0 hα
    (by norm_num : (0 : ℝ) < 1 / 16) U
  obtain ⟨AH, hAH, hhigh⟩ := uniform_high_input_constant hp0 hα U
  obtain ⟨D, hD, htrunc⟩ := uniform_middle_input_constant hp0 hα hr U
  let M : ℝ≥0∞ := ‖(surfaceMass d : ℂ)‖ₑ ^ p
  have hM : M ≠ ∞ := by dsimp only [M]; finiteness
  have hEpos : E ⊆ Ioi 0 := fun t ht => lt_of_lt_of_le zero_lt_one (hEI ht).1
  obtain ⟨K, hK, hb⟩ := core_improvement_of_split_bounds_at (d := d) hp α
    (M * AL) (M * AG) (M * AH) (M * D)
    (ENNReal.mul_ne_top hM hAL) (ENNReal.mul_ne_top hM hAG)
    (ENNReal.mul_ne_top hM hAH) (ENNReal.mul_ne_top hM hD)
  refine ⟨K * (1 + 1 ^ (1 - p / 2)), by positivity, ?_⟩
  apply hb E
    (fun f hf => by
      simpa only [mul_assoc] using spherical_moment_le_of_normalized
        (by omega) E hEpos f _ hp0.le _ (hlow E hEI hU f hf))
    (fun f hf => by
      simpa only [mul_assoc] using spherical_moment_le_of_normalized
        (by omega) E hEpos f _ hp0.le _ (hmid E hU f hf))
    (fun f hf => by
      simpa only [mul_assoc] using spherical_moment_le_of_normalized
        (by omega) E hEpos f _ hp0.le _ (hhigh E hEI hU f hf))
    _ Measure.restrict_le_self 1 zero_lt_one
  intro f hfi hfo
  have hf : ∀ y, y ∉ euclideanAnnulus d (1 / 8) 8 → f y = 0 := by
    intro y hy
    by_cases hi : ‖y‖ < 1 / 8
    · exact hfi y hi
    · apply hfo y
      have hh : ¬ (‖y‖ ≤ 8 ∧ 1 / 8 ≤ ‖y‖) := by
        simpa [euclideanAnnulus, Metric.mem_closedBall, Metric.mem_ball, dist_zero_right] using hy
      exact lt_of_not_ge fun ho => hh ⟨ho, le_of_not_gt hi⟩
  have hh := spherical_moment_le_of_normalized (by omega) E hEpos f _ hp0.le _
    (htrunc E hU f hf)
  simp only [ENNReal.ofReal_one, ENNReal.one_rpow, mul_one]
  exact (setLIntegral_le_lintegral _ _).trans (by simpa only [mul_assoc] using hh)

/-- Weight-general form of `normalized_strongType_of_core_moment`. -/
theorem normalized_strongType_of_core_moment_at {d : ℕ} (E : Set ℝ) {p B α : ℝ}
    (hp : 1 < p) (hb : CoreMomentBoundAt α (powerWeightedVolume d α) E p B) :
    HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E p α := by
  let K : ℝ≥0∞ := ‖((surfaceMass d : ℂ)⁻¹)‖ₑ ^ p * ENNReal.ofReal B
  have hK : K ≠ ∞ := by dsimp only [K]; finiteness
  apply hasStrongType_of_moment_bound_globalToLocal E hp.le K hK
  intro f _
  calc
    _ ≤ ∫⁻ x, (‖((surfaceMass d : ℂ)⁻¹)‖ₑ *
        (⨆ t : E, ‖sphericalAverage d f t x‖ₑ)) ^ p ∂powerWeightedVolume d α :=
      lintegral_mono (fun x => ENNReal.rpow_le_rpow
        (normalized_maximal_le_spherical_supremum E f x) (by linarith))
    _ = ‖((surfaceMass d : ℂ)⁻¹)‖ₑ ^ p *
        ∫⁻ x, (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ^ p ∂powerWeightedVolume d α := by
      simp_rw [ENNReal.mul_rpow_of_nonneg _ _ (by linarith : 0 ≤ p)]
      exact lintegral_const_mul' _ _ (by finiteness)
    _ ≤ K * ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d α := by
      simpa only [K, mul_assoc] using mul_le_mul' (le_refl (‖((surfaceMass d : ℂ)⁻¹)‖ₑ ^ p))
        (hb f)

/-! ## Section 3.1: the resolution pieces at the weight `L(p)` -/

/-- Comparison of power weights away from the origin: if `G` vanishes on the
ball of radius `r` and `β ≤ α`, then `|x|^β ≤ r^{β-α} |x|^α` on its support. -/
theorem lintegral_powerWeightedVolume_le_of_vanish {d : ℕ} {α β r : ℝ} (hβα : β ≤ α)
    (hr : 0 < r) (G : Euclidean d → ℝ≥0∞) (hG : Measurable G)
    (hvan : ∀ x, ‖x‖ < r → G x = 0) :
    (∫⁻ x, G x ∂powerWeightedVolume d β) ≤
      ENNReal.ofReal r ^ (β - α) * ∫⁻ x, G x ∂powerWeightedVolume d α := by
  rw [powerWeightedVolume, powerWeightedVolume,
    lintegral_withDensity_eq_lintegral_mul _ (measurable_radialPowerWeight d β) hG,
    lintegral_withDensity_eq_lintegral_mul _ (measurable_radialPowerWeight d α) hG,
    ← lintegral_const_mul' _ _
      (ENNReal.rpow_ne_top_of_ne_zero (ENNReal.ofReal_pos.mpr hr).ne' ENNReal.ofReal_ne_top)]
  apply lintegral_mono
  intro x
  simp only [Pi.mul_apply, radialPowerWeight]
  by_cases hx : ‖x‖ < r
  · rw [hvan x hx]; simp
  · push_neg at hx
    have hxpos : 0 < ‖x‖ := hr.trans_le hx
    have hne : ENNReal.ofReal ‖x‖ ≠ 0 := by simpa using hxpos
    have hsplit : ENNReal.ofReal ‖x‖ ^ β =
        ENNReal.ofReal ‖x‖ ^ (β - α) * ENNReal.ofReal ‖x‖ ^ α := by
      rw [← ENNReal.rpow_add _ _ hne ENNReal.ofReal_ne_top]; ring_nf
    rw [hsplit, mul_assoc]
    have hmono : ENNReal.ofReal ‖x‖ ^ (β - α) ≤ ENNReal.ofReal r ^ (β - α) := by
      have hneg : ∀ y : ℝ≥0∞, y ^ (β - α) = (y ^ (α - β))⁻¹ := fun y => by
        rw [← ENNReal.rpow_neg, neg_sub]
      rw [hneg, hneg]
      exact ENNReal.inv_le_inv.mpr
        (ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal hx) (by linarith))
    exact mul_le_mul' hmono le_rfl

/-- The analysis square function bound of Section 2 (`Section 2 lines
1250-1278`) with the input weight `|x|^α`, `α ≥ 1-d`, for inputs supported in
the annulus `1/8 ≤ |x| ≤ 8`. -/
theorem compactAnalysis_annular_square_moment_bound_at {d : ℕ} (hd : 0 < d)
    (φ : SchwartzMap (Euclidean d) ℂ) {p α : ℝ} (hp : 1 < p) (hα : 1 - (d : ℝ) ≤ α) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (I : Finset ℕ) (ρ : ℕ → ℕ),
      Set.InjOn ρ (↑I : Set ℕ) → ∀ f : SchwartzMap (Euclidean d) ℂ,
      (∀ x, ‖x‖ < 1 / 8 → f x = 0) → (∀ x, 8 < ‖x‖ → f x = 0) →
      (∫⁻ x, ENNReal.ofReal (schwartzSquareEnvelope I
        (fun i => compactConvolution (compactAnalysisKernel φ (ρ i)) f) x) ^ p) ≤
          A * ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d α := by
  obtain ⟨P, hP, hb⟩ := compactAnalysis_annular_square_moment_bound hd φ hp
  set c : ℝ≥0∞ := ENNReal.ofReal (1 / 8) ^ ((1 - (d : ℝ)) - α)
  have hc : c ≠ ∞ := ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
  refine ⟨P * c, ENNReal.mul_ne_top hP hc, ?_⟩
  intro I ρ hρ f hinner houter
  apply (hb I ρ hρ f hinner houter).trans
  rw [mul_assoc]
  gcongr
  exact lintegral_powerWeightedVolume_le_of_vanish hα (by norm_num)
    (fun x => ‖f x‖ₑ ^ p) (f.continuous.measurable.enorm.pow_const p)
    (fun x hx => by simp [hinner x hx, ENNReal.zero_rpow_of_pos (by linarith : 0 < p)])

/-- Source `eq:LpellqSmod` (`q = 2`) combined with the analysis square
function: one localized resolution family at frequencies `ρ(k)` is bounded by
`Q^{p/2} B^{1-p/2}`, where `Q` dominates every `2^{-ε|ρ(k)-(μ+1)k/μ|}` and `B`
is the scalar bootstrap constant (`eq:LpellinftySmod`). -/
theorem sequence_resolution_piece_bound {d N : ℕ} (hd : 2 ≤ d)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N)
    (hφ : ∀ x, (1 : ℝ) / 200 < ‖x‖ → φ x = 0)
    {μ p : ℝ} (hμ : 0 < μ) (hp₁ : 1 < p) (hp₂ : p < 2)
    (hθ : 0 < (d : ℝ) - ((d : ℝ) - 1) * p)
    (hκ : 0 < ((d : ℝ) - 1) * (p - 1) - 1 / (μ + 1))
    (ha0 : 1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ ≤ 0) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧
      ∀ (ν : Measure (Euclidean d)),
        ν ≤ powerWeightedVolume d (1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ) →
      ∀ B : ℝ, 0 < B →
        CoreMomentBoundAt (1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ) ν
          (sequenceSet μ) p B →
      ∀ (L : Finset ℕ), (∀ k ∈ L, 4 ≤ k) → ∀ (ρ : ℕ → ℕ), Set.InjOn ρ (↑L : Set ℕ) →
      ∀ Q : ℝ, 0 < Q →
      (∀ k ∈ L, (2 : ℝ≥0∞) ^ (-(min ((d : ℝ) - ((d : ℝ) - 1) * p)
          (((d : ℝ) - 1) * (p - 1) - 1 / (μ + 1)) * |((ρ k : ℕ) : ℝ) - (μ + 1) / μ * k|)) ≤
            ENNReal.ofReal Q) →
      ∀ f : SchwartzMap (Euclidean d) ℂ,
      (∀ x, ‖x‖ < 1 / 8 → f x = 0) → (∀ x, 8 < ‖x‖ → f x = 0) →
      (∫⁻ x, (⨆ t : sequenceSet μ, ‖localizedResolutionPiece φ L ρ f t x‖ₑ) ^ p ∂ν) ≤
        A * ENNReal.ofReal Q ^ (p / 2) * ENNReal.ofReal B ^ (1 - p / 2) *
          ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d
            (1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ) := by
  set a := 1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ with hadef
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have ha_ge : 1 - (d : ℝ) ≤ a := by
    have := div_nonneg hθ.le hμ.le; linarith
  obtain ⟨D, hD, hdiag⟩ := sequence_diagonal_maximal hd φ hflat hN
    (fun x hx => hφ x (by linarith)) hμ hp₁ hp₂ hθ hκ
  obtain ⟨A₁, hA₁, hsq⟩ := synthesis_sequence_square_bound (by omega) φ
    (fun x hx => hφ x (by linarith)) hp₁ hp₂.le ha0 (by linarith)
  obtain ⟨P, hP, hsqA⟩ := compactAnalysis_annular_square_moment_bound_at (by omega) φ hp₁ ha_ge
  let A₀ := D.toReal + 1
  have hA₀ : 0 < A₀ := by dsimp only [A₀]; positivity
  have hDle : D ≤ ENNReal.ofReal A₀ := by
    rw [← ENNReal.ofReal_toReal hD]
    exact ENNReal.ofReal_le_ofReal (by dsimp only [A₀]; linarith)
  have hp₀ : 0 ≤ p := by linarith
  let A : ℝ≥0∞ := 2 ^ p * (1 + 2 ^ p * 2 ^ p) *
    ENNReal.ofReal A₀ ^ (p / 2) * ENNReal.ofReal A₁ ^ (1 - p / 2) * P
  refine ⟨A, ?_, ?_⟩
  · dsimp only [A]
    exact ENNReal.mul_ne_top (ENNReal.mul_ne_top (ENNReal.mul_ne_top
      (ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg hp₀ (by norm_num))
        (ENNReal.add_ne_top.mpr ⟨by norm_num, ENNReal.mul_ne_top
          (ENNReal.rpow_ne_top_of_nonneg hp₀ (by norm_num))
          (ENNReal.rpow_ne_top_of_nonneg hp₀ (by norm_num))⟩))
      (ENNReal.rpow_ne_top_of_nonneg (by linarith) ENNReal.ofReal_ne_top))
      (ENNReal.rpow_ne_top_of_nonneg (by linarith) ENNReal.ofReal_ne_top)) hP
  intro ν hν B hB hcore L hL ρ hρ Q hQ hQb f hinner houter
  have hs := compactAnalysis_annular_support φ f hφ hinner houter
  have hh := hsq ν (sequenceSet μ) B hB hcore L ρ
    (fun k => dyadicSpatialShell d (-(k : ℤ) - 1))
    (fun k => measurableSet_dyadicSpatialShell d (-(k : ℤ) - 1))
    (pairwiseDisjoint_negative_dyadicSpatialShell d)
    (A₀ * Q) (by positivity) ?_
    (fun k => compactConvolution (compactAnalysisKernel φ (ρ k)) f)
    (fun k _ => (hs (ρ k)).1) (fun k _ => (hs (ρ k)).2)
  · apply hh.trans
    apply (mul_le_mul' (le_refl _) (hsqA L ρ hρ f hinner houter)).trans_eq
    rw [sequence_interpolation_coefficient_factor hA₀ hA₁ hB hQ hp₀ hp₂.le]
    dsimp only [A]
    ring
  · intro g
    apply (lintegral_mono' hν le_rfl).trans
    apply (hdiag L hL ρ (ENNReal.ofReal Q) hQb g).trans
    rw [ENNReal.ofReal_mul hA₀.le]
    exact mul_le_mul' (mul_le_mul' hDle le_rfl) le_rfl

/-- The peak frequency `⌊(μ+1)k/μ⌋` of the output shell `|x| ≈ 2^{-k}`. -/
def sequencePeak (μ : ℝ) (k : ℕ) : ℕ := ⌊(μ + 1) / μ * (k : ℝ)⌋₊

theorem sequencePeak_le {μ : ℝ} (hμ : 0 < μ) (k : ℕ) :
    (sequencePeak μ k : ℝ) ≤ (μ + 1) / μ * k :=
  Nat.floor_le (by positivity)

theorem lt_sequencePeak_add_one {μ : ℝ} (k : ℕ) :
    (μ + 1) / μ * k < (sequencePeak μ k : ℝ) + 1 :=
  Nat.lt_floor_add_one _

theorem sequencePeak_strictMono {μ : ℝ} (hμ : 0 < μ) : StrictMono (sequencePeak μ) := by
  intro k k' hkk'
  have hA : 1 < (μ + 1) / μ := by rw [one_lt_div hμ]; linarith
  have hk : (k : ℝ) + 1 ≤ k' := by exact_mod_cast hkk'
  have h1 := sequencePeak_le hμ k
  have h2 := lt_sequencePeak_add_one (μ := μ) k
  have h3 : (μ + 1) / μ * (k : ℝ) + 1 ≤ (μ + 1) / μ * k' := by nlinarith
  have h4 : ((sequencePeak μ k + 1 : ℕ) : ℝ) ≤ (μ + 1) / μ * k' := by push_cast; linarith
  have h5 : sequencePeak μ k + 1 ≤ sequencePeak μ k' :=
    Nat.le_floor h4
  omega

/-- Decay factor of the frequencies above the peak, `j = F(k) + n`. -/
theorem sequence_high_family_decay {μ ε : ℝ} (hμ : 0 < μ) (hε : 0 ≤ ε) (k n : ℕ) :
    (2 : ℝ≥0∞) ^ (-(ε * |(((sequencePeak μ k + n : ℕ)) : ℝ) - (μ + 1) / μ * k|)) ≤
      ENNReal.ofReal ((2 : ℝ) ^ (ε - ε * n)) := by
  rw [← ENNReal.ofReal_rpow_of_pos (by norm_num), ENNReal.ofReal_ofNat]
  apply ENNReal.rpow_le_rpow_of_exponent_le (by norm_num)
  have h1 := sequencePeak_le hμ k
  have h2 := lt_sequencePeak_add_one (μ := μ) k
  push_cast
  have : (n : ℝ) - 1 ≤ |(sequencePeak μ k : ℝ) + n - (μ + 1) / μ * k| :=
    le_trans (by linarith) (le_abs_self _)
  nlinarith

/-- Decay factor of the frequencies below the peak, `j = F(k) - m`. -/
theorem sequence_low_family_decay {μ ε : ℝ} (hμ : 0 < μ) (hε : 0 ≤ ε) {k m : ℕ}
    (hm : m ≤ sequencePeak μ k) :
    (2 : ℝ≥0∞) ^ (-(ε * |(((sequencePeak μ k - m : ℕ)) : ℝ) - (μ + 1) / μ * k|)) ≤
      ENNReal.ofReal ((2 : ℝ) ^ (-(ε * m))) := by
  rw [← ENNReal.ofReal_rpow_of_pos (by norm_num), ENNReal.ofReal_ofNat]
  apply ENNReal.rpow_le_rpow_of_exponent_le (by norm_num)
  have h1 := sequencePeak_le hμ k
  rw [Nat.cast_sub hm]
  have : (m : ℝ) ≤ |(sequencePeak μ k : ℝ) - m - (μ + 1) / μ * k| := by
    rw [abs_of_nonpos (by linarith)]; linarith
  nlinarith

/-- The finite frequency sum on each output shell splits into the families
above and below its peak frequency. -/
theorem sequence_resolution_frequency_split {d : ℕ} (μ : ℝ)
    (φ f : SchwartzMap (Euclidean d) ℂ) (L : Finset ℕ) (J : ℕ)
    (t : ℝ) (x : Euclidean d) :
    (∑ k ∈ L, (dyadicSpatialShell d (-(k : ℤ) - 1)).indicator
      (fun y => ∑ j ∈ Finset.range (J + 1),
        sphericalAverage d (compactResolutionPiece φ j f) t y) x) =
      (∑ n ∈ Finset.range (J + 1), localizedResolutionPiece φ
        (L.filter (fun k => sequencePeak μ k + n ≤ J)) (fun k => sequencePeak μ k + n) f t x) +
      ∑ m ∈ Finset.range (L.sup (sequencePeak μ) + 1), localizedResolutionPiece φ
        (L.filter (fun k => 0 < m ∧ m ≤ sequencePeak μ k ∧ sequencePeak μ k - m ≤ J))
        (fun k => sequencePeak μ k - m) f t x := by
  classical
  simp only [localizedResolutionPiece, Finset.sum_filter]
  rw [Finset.sum_comm (s := Finset.range (J + 1)),
    Finset.sum_comm (s := Finset.range (L.sup (sequencePeak μ) + 1)), ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro k hk
  by_cases hx : x ∈ dyadicSpatialShell d (-(k : ℤ) - 1)
  · simp only [Set.indicator_of_mem hx]
    simpa only [Finset.sum_filter] using finite_frequency_split
      (fun j => sphericalAverage d (compactResolutionPiece φ j f) t x)
      J (sequencePeak μ k) (L.sup (sequencePeak μ)) (Finset.le_sup (f := sequencePeak μ) hk)
  · simp [Set.indicator_of_notMem hx]

/-- Rewriting the family factors `Q^{p/2}` as geometric terms. -/
theorem ofReal_two_rpow_family (ε p c : ℝ) (n : ℕ) :
    ENNReal.ofReal ((2 : ℝ) ^ (c - ε * n)) ^ (p / 2) =
      (((2 : ℝ≥0∞) ^ (-ε / 2)) ^ n) ^ p * (2 : ℝ≥0∞) ^ (c * p / 2) := by
  rw [← ENNReal.ofReal_rpow_of_pos (by norm_num), ENNReal.ofReal_ofNat,
    ← ENNReal.rpow_natCast, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
    ← ENNReal.rpow_add _ _ (by norm_num) (by norm_num)]
  congr 1
  ring

/-- Source `eq:goalseq` on finite selections of inner shells: the analogue of
`eq:I-II` at the weight `L(p)`, with the frequency families organized around
the peak `⌊(μ+1)k/μ⌋`. The constant is independent of the truncations. -/
theorem sequence_localized_resolution_moment_bound {d N : ℕ} (hd : 2 ≤ d)
    (φ : SchwartzMap (Euclidean d) ℂ) (hmass : ∫ x, φ x = 1)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d))
      (fun ξ => 𝓕 φ ξ - 1) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N)
    (hφ : ∀ x, (1 : ℝ) / 200 < ‖x‖ → φ x = 0)
    {μ p : ℝ} (hμ : 0 < μ) (hp₁ : 1 < p) (hp₂ : p < 2)
    (hθ : 0 < (d : ℝ) - ((d : ℝ) - 1) * p)
    (hκ : 0 < ((d : ℝ) - 1) * (p - 1) - 1 / (μ + 1))
    (ha0 : 1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ ≤ 0) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧
      ∀ (ν : Measure (Euclidean d)),
        ν ≤ powerWeightedVolume d (1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ) →
      ∀ B : ℝ, 0 < B →
        CoreMomentBoundAt (1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ) ν
          (sequenceSet μ) p B →
      ∀ (L : Finset ℕ), (∀ k ∈ L, 4 ≤ k) → ∀ f : SchwartzMap (Euclidean d) ℂ,
      (∀ x, ‖x‖ < 1 / 8 → f x = 0) → (∀ x, 8 < ‖x‖ → f x = 0) →
      (∫⁻ x, (⨆ t : sequenceSet μ, ‖∑ k ∈ L, (dyadicSpatialShell d (-(k : ℤ) - 1)).indicator
        (sphericalAverage d f t) x‖ₑ) ^ p ∂ν) ≤
          A * ENNReal.ofReal B ^ (1 - p / 2) *
            ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d
              (1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ) := by
  classical
  set a := 1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ with hadef
  set ε := min ((d : ℝ) - ((d : ℝ) - 1) * p) (((d : ℝ) - 1) * (p - 1) - 1 / (μ + 1))
    with hεdef
  have hε : 0 < ε := lt_min hθ hκ
  obtain ⟨P, hP, hpiece⟩ := sequence_resolution_piece_bound hd φ hflat hN hφ hμ hp₁ hp₂
    hθ hκ ha0
  set r : ℝ≥0∞ := (2 : ℝ≥0∞) ^ (-ε / 2) with hrdef
  have hr : r < 1 := ENNReal.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  have hR : ((1 - r)⁻¹) ^ p ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (by linarith)
    (ENNReal.inv_ne_top.mpr (tsub_pos_iff_lt.mpr hr).ne')
  set H : ℝ≥0∞ := P * (2 : ℝ≥0∞) ^ (ε * p / 2)
  have hH : H ≠ ∞ := ENNReal.mul_ne_top hP (two_rpow_ne_top _)
  set A : ℝ≥0∞ := ((1 - r)⁻¹) ^ p * H + ((1 - r)⁻¹) ^ p * P
  have hA : A ≠ ∞ := ENNReal.add_ne_top.mpr
    ⟨ENNReal.mul_ne_top hR hH, ENNReal.mul_ne_top hR hP⟩
  refine ⟨2 ^ p * (A + A), ENNReal.mul_ne_top
    (ENNReal.rpow_ne_top_of_nonneg (by linarith) (by norm_num))
    (ENNReal.add_ne_top.mpr ⟨hA, hA⟩), ?_⟩
  intro ν hν B hB hcore L hL f hinner houter
  set b := ENNReal.ofReal B ^ (1 - p / 2)
  set Q := ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d a
  -- the high family `F(k)+n`
  have hhigh : ∀ (I : Finset ℕ) (Lf : ℕ → Finset ℕ), (∀ n ∈ I, Lf n ⊆ L) →
      (∫⁻ x, (∑ n ∈ I, ⨆ t : sequenceSet μ,
        ‖localizedResolutionPiece φ (Lf n) (fun k => sequencePeak μ k + n) f t x‖ₑ) ^ p ∂ν) ≤
        A * b * Q := by
    intro I Lf hLf
    apply (finite_geometric_sum_moment_bound ν I _
      (fun n _ => measurable_localizedResolutionPiece_maximal φ _ _ f _) hp₁.le r
      (H * b * Q) ?_).trans
    · simpa only [mul_assoc] using mul_le_mul' (mul_le_mul'
        (le_add_right (le_refl (((1 - r)⁻¹) ^ p * H))) le_rfl) le_rfl
    intro n hn
    have hh := hpiece ν hν B hB hcore (Lf n) (fun k hk => hL k (hLf n hn hk))
      (fun k => sequencePeak μ k + n)
      (fun i _ j _ hij => (sequencePeak_strictMono hμ).injective (Nat.add_right_cancel hij))
      ((2 : ℝ) ^ (ε - ε * n)) (by positivity)
      (fun k _ => sequence_high_family_decay hμ hε.le k n) f hinner houter
    apply hh.trans_eq
    rw [ofReal_two_rpow_family]
    ring
  -- the low family `F(k)-m`
  have hlow : ∀ (I : Finset ℕ) (Lf : ℕ → Finset ℕ), (∀ m ∈ I, Lf m ⊆ L) →
      (∀ m ∈ I, ∀ k ∈ Lf m, m ≤ sequencePeak μ k) →
      (∫⁻ x, (∑ m ∈ I, ⨆ t : sequenceSet μ,
        ‖localizedResolutionPiece φ (Lf m) (fun k => sequencePeak μ k - m) f t x‖ₑ) ^ p ∂ν) ≤
        A * b * Q := by
    intro I Lf hLf hpeak
    apply (finite_geometric_sum_moment_bound ν I _
      (fun m _ => measurable_localizedResolutionPiece_maximal φ _ _ f _) hp₁.le r
      (P * b * Q) ?_).trans
    · simpa only [mul_assoc] using mul_le_mul' (mul_le_mul'
        (le_add_left (le_refl (((1 - r)⁻¹) ^ p * P))) le_rfl) le_rfl
    intro m hm
    have hinj : Set.InjOn (fun k => sequencePeak μ k - m) (↑(Lf m) : Set ℕ) := by
      intro i hi j hj hij
      have hi' := hpeak m hm i hi
      have hj' := hpeak m hm j hj
      have : sequencePeak μ i = sequencePeak μ j := by simp only at hij; omega
      exact (sequencePeak_strictMono hμ).injective this
    have hh := hpiece ν hν B hB hcore (Lf m) (fun k hk => hL k (hLf m hm hk))
      (fun k => sequencePeak μ k - m) hinj
      ((2 : ℝ) ^ (0 - ε * m)) (by positivity)
      (fun k hk => by
        have := sequence_low_family_decay hμ hε.le (hpeak m hm k hk)
        rwa [show -(ε * (m : ℝ)) = 0 - ε * m by ring] at this) f hinner houter
    apply hh.trans_eq
    rw [ofReal_two_rpow_family]
    simp only [zero_mul, zero_div, ENNReal.rpow_zero, mul_one]
    ring
  -- Fatou along the frequency truncations
  let Fj := fun J (t : sequenceSet μ) (x : Euclidean d) =>
    ∑ k ∈ L, (dyadicSpatialShell d (-(k : ℤ) - 1)).indicator
      (fun y => ∑ j ∈ Finset.range (J + 1),
        sphericalAverage d (compactResolutionPiece φ j f) t y) x
  apply maximal_moment_le_of_tendsto ν _ Fj (by linarith)
  · intro J
    apply measurable_disjoint_indicator_maximal_norm L
      (fun k => dyadicSpatialShell d (-(k : ℤ) - 1))
      (fun _ (t : sequenceSet μ) y => ∑ j ∈ Finset.range (J + 1),
        sphericalAverage d (compactResolutionPiece φ j f) t y)
      (fun k => measurableSet_dyadicSpatialShell d (-(k : ℤ) - 1))
      (pairwiseDisjoint_negative_dyadicSpatialShell d)
    intro k
    apply LowerSemicontinuous.measurable
    apply lowerSemicontinuous_iSup
    intro t
    apply Continuous.lowerSemicontinuous
    apply Continuous.enorm
    apply continuous_finsetSum
    intro j _
    rw [← schwartzSphericalAverage_apply]
    exact (schwartzSphericalAverage (compactResolutionPiece φ j f) t).continuous
  · intro t x
    apply tendsto_finsetSum L
    intro k _
    by_cases hx : x ∈ dyadicSpatialShell d (-(k : ℤ) - 1)
    · simp only [Set.indicator_of_mem hx]
      exact sphericalAverage_compact_resolution φ f hmass t x
    · simp only [Set.indicator_of_notMem hx]
      exact tendsto_const_nhds
  · intro J
    let Hs := fun x => ∑ n ∈ Finset.range (J + 1), ⨆ t : sequenceSet μ,
      ‖localizedResolutionPiece φ (L.filter (fun k => sequencePeak μ k + n ≤ J))
        (fun k => sequencePeak μ k + n) f t x‖ₑ
    let Ds := fun x => ∑ m ∈ Finset.range (L.sup (sequencePeak μ) + 1),
      ⨆ t : sequenceSet μ,
      ‖localizedResolutionPiece φ
        (L.filter (fun k => 0 < m ∧ m ≤ sequencePeak μ k ∧ sequencePeak μ k - m ≤ J))
        (fun k => sequencePeak μ k - m) f t x‖ₑ
    have hHs : Measurable Hs := Finset.measurable_sum _ (fun n _ =>
      measurable_localizedResolutionPiece_maximal φ _ _ f _)
    have hpoint (x : Euclidean d) : (⨆ t : sequenceSet μ, ‖Fj J t x‖ₑ) ≤ Hs x + Ds x := by
      apply iSup_le
      intro t
      dsimp only [Fj]
      rw [sequence_resolution_frequency_split μ]
      apply (enorm_add_le _ _).trans
      apply add_le_add
      · exact (enorm_sum_le _ _).trans (Finset.sum_le_sum (fun n _ =>
          le_iSup (fun t : sequenceSet μ => ‖localizedResolutionPiece φ _ _ f t x‖ₑ) t))
      · exact (enorm_sum_le _ _).trans (Finset.sum_le_sum (fun m _ =>
          le_iSup (fun t : sequenceSet μ => ‖localizedResolutionPiece φ _ _ f t x‖ₑ) t))
    have hbH := hhigh (Finset.range (J + 1))
      (fun n => L.filter (fun k => sequencePeak μ k + n ≤ J))
      (fun n _ => Finset.filter_subset _ _)
    have hbD := hlow (Finset.range (L.sup (sequencePeak μ) + 1))
      (fun m => L.filter (fun k => 0 < m ∧ m ≤ sequencePeak μ k ∧ sequencePeak μ k - m ≤ J))
      (fun m _ => Finset.filter_subset _ _)
      (fun m _ k hk => (Finset.mem_filter.mp hk).2.2.1)
    calc
      _ ≤ ∫⁻ x, (2 : ℝ≥0∞) ^ p * (Hs x ^ p + Ds x ^ p) ∂ν := by
        apply lintegral_mono
        intro x
        exact (ENNReal.rpow_le_rpow (hpoint x) (by linarith)).trans
          (ENNReal.add_rpow_le_two_rpow_mul_rpow_add_rpow _ _ (by linarith))
      _ = 2 ^ p * ((∫⁻ x, Hs x ^ p ∂ν) + ∫⁻ x, Ds x ^ p ∂ν) := by
        rw [lintegral_const_mul' _ _ (by finiteness), lintegral_add_left (hHs.pow_const p)]
      _ ≤ _ := by
        have hh := mul_le_mul' (le_refl ((2 : ℝ≥0∞) ^ p)) (add_le_add hbH hbD)
        simpa only [mul_add, add_mul, mul_assoc] using hh

/-- The unweighted input of Section 3.1: by Seeger--Wainger--Wright,
`M_{E^μ}` is bounded on `L^p` for `p > p(μ) = 1 + β(E^μ)/(d-1)`. -/
theorem sequence_unweighted_bound {d : ℕ} (hd : 2 ≤ d) {μ p : ℝ} (hμ : 0 < μ)
    (hp : sequenceCriticalExponent d μ < p) :
    ∃ U : ℝ, UnweightedMaximalBound d (sequenceSet μ) p U := by
  have hd1 : 0 < (d : ℝ) - 1 := by
    have : (2 : ℝ) ≤ d := by exact_mod_cast hd
    linarith
  have hμ1 : 0 < μ + 1 := by linarith
  have hp0 : 0 < p := by
    unfold sequenceCriticalExponent at hp
    have : 0 < 1 / ((μ + 1) * ((d : ℝ) - 1)) := by positivity
    linarith
  have hβ : _root_.Spherical.upperMinkowskiExponent (sequenceSet μ) = 1 / (μ + 1) := by
    rw [upperMinkowskiExponent_eq_multiplicativeMinkowskiExponent_toReal,
      sequenceSet_minkowski_eq hμ, EReal.toReal_coe]
  have hcritical : _root_.Spherical.RestrictedDilations.criticalExponent d (sequenceSet μ) < p := by
    unfold _root_.Spherical.RestrictedDilations.criticalExponent
    change 1 + _root_.Spherical.upperMinkowskiExponent (sequenceSet μ) / ((d : ℝ) - 1) < p
    rw [hβ]
    unfold sequenceCriticalExponent at hp
    rw [div_div]; exact hp
  exact Auto.Spherical.SWW.eLpNorm_restrictedSphericalMaximal_le hd
    (sequenceSet_subset_Ioi hμ.le) ((ENNReal.ofReal_lt_ofReal_iff hp0).mpr hcritical)

/-- The bootstrap improvement of Section 3.1 at the weight `L(p)`: the scalar
constant enters with power `1 - p/2 < 1`. -/
theorem sequence_core_improvement {d : ℕ} (hd : 2 ≤ d) {μ p U : ℝ} (hμ : 0 < μ)
    (hp₁ : 1 < p) (hp₂ : p < 2)
    (hθ : 0 < (d : ℝ) - ((d : ℝ) - 1) * p)
    (hκ : 0 < ((d : ℝ) - 1) * (p - 1) - 1 / (μ + 1))
    (ha0 : 1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ ≤ 0)
    (hU : UnweightedMaximalBound d (sequenceSet μ) p U) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ ν : Measure (Euclidean d),
      ν ≤ powerWeightedVolume d (1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ) →
      ∀ B : ℝ, 0 < B →
      CoreMomentBoundAt (1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ) ν
        (sequenceSet μ) p B →
      CoreMomentBoundAt (1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ) ν
        (sequenceSet μ) p (K * (1 + B ^ (1 - p / 2))) := by
  set a := 1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ with hadef
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hEI : sequenceSet μ ⊆ Icc 1 2 := sequenceSet_subset_Icc hμ.le
  have hEpos : sequenceSet μ ⊆ Ioi 0 := sequenceSet_subset_Ioi hμ.le
  obtain ⟨φ, _, hmass, hφ, _, hflat⟩ := exists_compact_resolution_profile d (d + 1) (by omega)
  have hN : ((d : ℝ) - 1) / 2 ≤ (d + 1 : ℕ) := by push_cast; linarith
  obtain ⟨D, hD, hinner⟩ := sequence_localized_resolution_moment_bound hd φ hmass hflat hN
    (fun x hx => hφ x (by linarith)) hμ hp₁ hp₂ hθ hκ ha0
  obtain ⟨AL, hAL, hlow⟩ := uniform_low_input_constant (d := d) (by linarith : 0 < p) ha0 U
  obtain ⟨AG, hAG, hmid⟩ := uniform_middle_input_constant (d := d) (by linarith : 0 < p) ha0
    (by norm_num : (0 : ℝ) < 1 / 16) U
  obtain ⟨AH, hAH, hhigh⟩ := uniform_high_input_constant (d := d) (by linarith : 0 < p) ha0 U
  let M : ℝ≥0∞ := ‖(surfaceMass d : ℂ)‖ₑ ^ p
  have hM : M ≠ ∞ := by dsimp only [M]; finiteness
  obtain ⟨K, hK, hb⟩ := core_improvement_of_split_bounds_at (d := d) hp₁ a
    (M * AL) (M * AG) (M * AH) D
    (ENNReal.mul_ne_top hM hAL) (ENNReal.mul_ne_top hM hAG)
    (ENNReal.mul_ne_top hM hAH) hD
  refine ⟨K, hK, ?_⟩
  have hb' := hb (sequenceSet μ)
    (fun f hf => by
      simpa only [mul_assoc] using spherical_moment_le_of_normalized
        (by omega) _ hEpos f _ (by linarith : 0 ≤ p) _ (hlow _ hEI hU f hf))
    (fun f hf => by
      simpa only [mul_assoc] using spherical_moment_le_of_normalized
        (by omega) _ hEpos f _ (by linarith : 0 ≤ p) _ (hmid _ hU f hf))
    (fun f hf => by
      simpa only [mul_assoc] using spherical_moment_le_of_normalized
        (by omega) _ hEpos f _ (by linarith : 0 ≤ p) _ (hhigh _ hEI hU f hf))
  intro ν hν B hB hcore
  apply hb' ν hν B hB
  intro f hfi hfo
  apply inner_ball_moment_of_finite_shells_at (by omega) ν hν _ f (by linarith)
  intro L hL
  exact hinner ν hν B hB hcore L hL f hfi hfo

/-- Section 3.1: for `d ≥ 2` and `p(μ) < p < d/(d-1)`, `M_{E^μ}` is bounded on
`L^p(|x|^{L(p)})`, `L(p) = 1-d+(d-(d-1)p)/μ`, for every weighted `L^p` input. -/
theorem sequence_lower_endpoint_bound {d : ℕ} (hd : 2 ≤ d) {μ p : ℝ} (hμ : 0 < μ)
    (hp : sequenceCriticalExponent d μ < p) (hpd : p < (d : ℝ) / ((d : ℝ) - 1)) :
    WeightedMaximalBound d (sequenceSet μ) p (sequenceLowerEndpoint d μ p) := by
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hn : 0 < (d : ℝ) - 1 := by linarith
  have hμ1 : 0 < μ + 1 := by linarith
  rw [sequenceLowerEndpoint_of_le hd hμ hpd.le]
  set a := 1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * p) / μ with hadef
  -- the parameters
  have hθ : 0 < (d : ℝ) - ((d : ℝ) - 1) * p := by
    rw [lt_div_iff₀ hn] at hpd; linarith
  have hκ : 0 < ((d : ℝ) - 1) * (p - 1) - 1 / (μ + 1) := by
    unfold sequenceCriticalExponent at hp
    have h1 : 1 / ((μ + 1) * ((d : ℝ) - 1)) < p - 1 := by linarith
    rw [div_lt_iff₀ (by positivity)] at h1
    have : 1 / (μ + 1) < ((d : ℝ) - 1) * (p - 1) := by
      rw [div_lt_iff₀ hμ1]; nlinarith
    linarith
  have hp₁ : 1 < p := by
    have : 0 < 1 / (μ + 1) := by positivity
    nlinarith
  have hp₂ : p < 2 := by
    have : (d : ℝ) / ((d : ℝ) - 1) ≤ 2 := by
      rw [div_le_iff₀ hn]; linarith
    linarith
  have hθμ : ((d : ℝ) - ((d : ℝ) - 1) * p) / μ < 1 := by
    -- `θ < μ/(μ+1)` since `(d-1)(p-1) > 1/(μ+1)`
    rw [div_lt_one hμ]
    have : 1 / (μ + 1) * (μ + 1) = 1 := by field_simp
    have hlt : (d : ℝ) - ((d : ℝ) - 1) * p < 1 - 1 / (μ + 1) := by linarith
    have : 1 - 1 / (μ + 1) < μ := by
      have : 0 < 1 / (μ + 1) := by positivity
      have : 1 - 1 / (μ + 1) = μ / (μ + 1) := by field_simp; ring
      rw [this, div_lt_iff₀ hμ1]; nlinarith
    linarith
  have ha0 : a ≤ 0 := by rw [hadef]; linarith
  have ha_d : -(d : ℝ) < a := by
    have := div_nonneg hθ.le hμ.le; rw [hadef]; linarith
  obtain ⟨U, hU⟩ := sequence_unweighted_bound hd hμ hp
  obtain ⟨K, hK, himprove⟩ := sequence_core_improvement hd hμ hp₁ hp₂ hθ hκ ha0 hU
  set Bst := max (2 * (1 + K)) ((2 * K) ^ (1 / (1 - (1 - p / 2))))
  have hcore : CoreMomentBoundAt a (powerWeightedVolume d a) (sequenceSet μ) p Bst := by
    intro f
    apply lintegral_le_of_exterior_ball_bounds _ (powerWeightedVolume_singleton_zero (by omega) _)
      _ ((measurable_schwartz_radius_supremum f _).pow_const p)
    intro r hr
    have hh := core_constant_of_sublinear_improvement_at
      ((powerWeightedVolume d a).restrict (Metric.closedBall (0 : Euclidean d) r)ᶜ)
      (sequenceSet μ) p hK (by linarith : 1 - p / 2 < 1)
      (truncated_core_bound_of_unweighted_at hd hp₁ hr ha0 (sequenceSet_subset_Icc hμ.le) hU)
      (himprove _ Measure.restrict_le_self)
    exact hh f
  exact weighted_bound_of_normalized_strongType (by omega) _ hp₁ ha_d
    (normalized_strongType_of_core_moment_at _ hp₁ hcore)

/-! ## Section 3.2: unboundedness on `L^{d/(d-1)}(|x|^{1-d})`

We use the source's second example (valid for every `μ > 0`), with the index
range `k < j ≤ min(2k, (μ+1)k/μ - C)`: the bumps `R^j` are graph tubes of
horizontal radius `2^{k-j}` and thickness `2^{-j}` about the south-pole cap of
the unit sphere. Their amplitudes grow geometrically in `j`, so the input norm
is controlled by the number of bumps. -/

/-- The points `n^{-μ}` approximate every `u ∈ (0, 1/2]` to within
`μ 2^{μ+1} u^{(μ+1)/μ}` (the local gap of `E^μ` at height `u`). -/
theorem exists_sequence_point_near {μ u : ℝ} (hμ : 0 < μ) (hu : 0 < u) (hu2 : u ≤ 1 / 2) :
    ∃ n : ℕ, 1 ≤ n ∧ |(n : ℝ) ^ (-μ) - u| ≤ μ * 2 ^ (μ + 1) * u ^ ((μ + 1) / μ) := by
  set v := u ^ (-(1 / μ)) with hv
  have hv1 : 1 < v := Real.one_lt_rpow_of_pos_of_lt_one_of_neg hu (by linarith)
    (by have := one_div_pos.mpr hμ; linarith)
  set n : ℕ := ⌈v⌉₊ with hn
  have hnv : v ≤ n := Nat.le_ceil v
  have hnv' : (n : ℝ) < v + 1 := Nat.ceil_lt_add_one (by linarith)
  have hn2 : 2 ≤ n := by
    have : (1 : ℝ) < n := by linarith
    exact_mod_cast this
  have hvu : v ^ (-μ) = u := by
    rw [hv, ← Real.rpow_mul hu.le]; field_simp; simp
  refine ⟨n, by omega, ?_⟩
  have hn1 : (1 : ℝ) ≤ (n - 1 : ℕ) := by exact_mod_cast (show 1 ≤ n - 1 by omega)
  have hcast : ((n - 1 : ℕ) : ℝ) = (n : ℝ) - 1 := by rw [Nat.cast_sub (by omega)]; simp
  have hlo : (n : ℝ) ^ (-μ) ≤ u := by
    rw [← hvu]; exact Real.rpow_le_rpow_of_nonpos (by linarith) hnv (by linarith)
  have hhi : u ≤ ((n - 1 : ℕ) : ℝ) ^ (-μ) := by
    rw [← hvu, hcast]
    exact Real.rpow_le_rpow_of_nonpos (by linarith) (by linarith) (by linarith)
  obtain ⟨-, hgap⟩ := sequenceSet_gap_bounds hμ (n := n - 1) (by omega)
  have hsucc : ((n - 1 : ℕ) : ℝ) + 1 = n := by rw [hcast]; ring
  rw [hsucc] at hgap
  have hhalf : (n : ℝ) / 2 ≤ ((n - 1 : ℕ) : ℝ) := by
    rw [hcast]; have : (2 : ℝ) ≤ n := by exact_mod_cast hn2
    linarith
  have hpow : ((n - 1 : ℕ) : ℝ) ^ (-μ - 1) ≤ 2 ^ (μ + 1) * u ^ ((μ + 1) / μ) := by
    have h1 : ((n - 1 : ℕ) : ℝ) ^ (-μ - 1) ≤ ((n : ℝ) / 2) ^ (-μ - 1) :=
      Real.rpow_le_rpow_of_nonpos (by positivity) hhalf (by linarith)
    have h2 : ((n : ℝ) / 2) ^ (-μ - 1) ≤ (v / 2) ^ (-μ - 1) :=
      Real.rpow_le_rpow_of_nonpos (by positivity) (by linarith) (by linarith)
    have h3 : (v / 2) ^ (-μ - 1) = 2 ^ (μ + 1) * u ^ ((μ + 1) / μ) := by
      rw [Real.div_rpow (by linarith) (by norm_num), hv, ← Real.rpow_mul hu.le,
        div_eq_mul_inv, ← Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2),
        show -(1 / μ) * (-μ - 1) = (μ + 1) / μ by field_simp; ring,
        show -(-μ - 1) = μ + 1 by ring, mul_comm]
    linarith
  rw [abs_of_nonpos (by linarith)]
  calc -((n : ℝ) ^ (-μ) - u) ≤ ((n - 1 : ℕ) : ℝ) ^ (-μ) - (n : ℝ) ^ (-μ) := by linarith
    _ ≤ μ * ((n - 1 : ℕ) : ℝ) ^ (-μ - 1) := hgap
    _ ≤ μ * (2 ^ (μ + 1) * u ^ ((μ + 1) / μ)) := by gcongr
    _ = _ := by ring

/-- The south pole of the unit sphere in `ℝ^{n+1}`. -/
def southPole (n : ℕ) : Euclidean (n + 1) := -northPole n

theorem succCoordinates_southPole (n : ℕ) :
    succCoordinates n (southPole n) = (0, -1) := by
  have h : northPole n = joinCoordinates n (0, 1) := by
    apply (MeasurableEquiv.toLp 2 (Fin (n + 1) → ℝ)).symm.injective
    funext i
    cases i using Fin.lastCases
    · simp [northPole, joinCoordinates]
    · simp [northPole, joinCoordinates]
  rw [southPole, ← neg_one_smul ℝ (northPole n), succCoordinates_smul, h,
    succCoordinates_joinCoordinates]
  simp

theorem norm_southPole (n : ℕ) : ‖southPole n‖ = 1 := by
  rw [southPole, norm_neg, norm_northPole]

/-- Section 3.2, incidence geometry. Let `x` have horizontal part `x'` with
`|x'| ≤ a` and height `s`, let `t` be within `η` of `s + √(1-|x'|²)`, and let
`ω` lie in the cap of chordal radius `h` about the south pole. Then `x + tω`
lies in the graph tube of horizontal radius `ρ` and thickness `b` about the
south-pole cap of the unit sphere, provided `a + 2h < ρ` and
`2(4η + 4ah + 4sh²) < b`. -/
theorem translate_southCap_mem_graphTube (n : ℕ) {a s t η h ρ b : ℝ}
    {x : Euclidean (n + 1)} (hx' : ‖(succCoordinates n x).1‖ ≤ a)
    (hs : (succCoordinates n x).2 = s) (hs0 : 0 ≤ s) (hs1 : s ≤ 1 / 16)
    (ha : a ≤ 1 / 16) (ht1 : 1 ≤ t) (ht2 : t ≤ 2)
    (hη : |t - (s + Real.sqrt (1 - ‖(succCoordinates n x).1‖ ^ 2))| ≤ η)
    (hh0 : 0 < h) (hh : h ≤ 1 / 16) (hρ : a + 2 * h < ρ)
    (hb : 2 * (4 * η + 4 * a * h + 4 * s * h ^ 2) < b)
    {ω : Metric.sphere (0 : Euclidean (n + 1)) 1}
    (hω : dist (ω : Euclidean (n + 1)) (southPole n) < h) :
    x + t • (ω : Euclidean (n + 1)) ∈ graphTube n 1 0 ρ b := by
  set x' := (succCoordinates n x).1 with hx'def
  set w' := (succCoordinates n (ω : Euclidean (n + 1))).1 with hw'def
  set wd := (succCoordinates n (ω : Euclidean (n + 1))).2 with hwddef
  have hωnorm : ‖(ω : Euclidean (n + 1))‖ = 1 := mem_sphere_zero_iff_norm.mp ω.property
  have hω1 : ‖w'‖ ^ 2 + wd ^ 2 = 1 := by
    rw [← norm_sq_succCoordinates, hωnorm]; norm_num
  -- the cap condition in coordinates
  have hdiff := norm_sq_succCoordinates n ((ω : Euclidean (n + 1)) - southPole n)
  rw [succCoordinates_sub, succCoordinates_southPole] at hdiff
  simp only [Prod.fst_sub, Prod.snd_sub, sub_zero, sub_neg_eq_add] at hdiff
  have hdist : ‖(ω : Euclidean (n + 1)) - southPole n‖ < h := by
    rwa [← dist_eq_norm]
  have hsq : ‖w'‖ ^ 2 + (wd + 1) ^ 2 < h ^ 2 := by
    rw [← hdiff]
    exact pow_lt_pow_left₀ hdist (norm_nonneg _) (by norm_num)
  have hw' : ‖w'‖ < h := by
    have : ‖w'‖ ^ 2 < h ^ 2 := by linarith [sq_nonneg (wd + 1)]
    exact lt_of_pow_lt_pow_left₀ 2 hh0.le this
  have hwd : |wd + 1| < h := by
    have : (wd + 1) ^ 2 < h ^ 2 := by linarith [sq_nonneg ‖w'‖]
    exact abs_lt_of_sq_lt_sq this hh0.le
  set e := wd + 1 with he
  have hwd1 : |wd| ≤ 1 := by
    rw [← sq_le_one_iff_abs_le_one]; linarith [sq_nonneg ‖w'‖]
  have he0 : 0 ≤ e := by rw [he]; linarith [(abs_le.mp hwd1).1]
  have he16 : e ≤ 1 / 16 := (le_abs_self e).trans (hwd.le.trans hh)
  have he_le : e ≤ ‖w'‖ ^ 2 := by
    have hrel : e * (2 - e) = ‖w'‖ ^ 2 := by
      have : wd = e - 1 := by rw [he]; ring
      rw [this] at hω1; linear_combination -hω1
    have hmul : e * 1 ≤ e * (2 - e) := mul_le_mul_of_nonneg_left (by linarith) he0
    linarith
  -- coordinates of `y = x + tω`
  set y := x + t • (ω : Euclidean (n + 1)) with hy
  have hy' : (succCoordinates n y).1 = x' + t • w' := by
    rw [hy, succCoordinates_add, succCoordinates_smul]; rfl
  have hyd : (succCoordinates n y).2 = s + t * wd := by
    rw [hy, succCoordinates_add, succCoordinates_smul, ← hs]; rfl
  have ha0 : 0 ≤ a := (norm_nonneg _).trans hx'
  have htw : t * ‖w'‖ ≤ 2 * h := mul_le_mul ht2 hw'.le (norm_nonneg _) (by norm_num)
  have hny' : ‖(succCoordinates n y).1‖ ≤ a + 2 * h := by
    rw [hy']
    calc ‖x' + t • w'‖ ≤ ‖x'‖ + ‖t • w'‖ := norm_add_le _ _
      _ = ‖x'‖ + t * ‖w'‖ := by rw [norm_smul, Real.norm_of_nonneg (by linarith)]
      _ ≤ a + 2 * h := by linarith
  -- `|y|² - 1`
  have hinner : |inner ℝ x' w'| ≤ a * h :=
    (abs_real_inner_le_norm x' w').trans (mul_le_mul hx' hw'.le (norm_nonneg _) ha0)
  have hnormy : ‖x' + t • w'‖ ^ 2 + (s + t * wd) ^ 2 =
      (t - s) ^ 2 + ‖x'‖ ^ 2 + 2 * t * inner ℝ x' w' + 2 * t * s * e := by
    rw [norm_add_sq_real, norm_smul, Real.norm_of_nonneg (by linarith), inner_smul_right]
    have : ‖w'‖ ^ 2 = 1 - wd ^ 2 := by linarith
    rw [mul_pow, this, he]
    ring
  set tstar := s + Real.sqrt (1 - ‖x'‖ ^ 2) with htstar
  have hx'sq : ‖x'‖ ^ 2 ≤ 1 := by
    have := pow_le_pow_left₀ (norm_nonneg x') (hx'.trans (by linarith : a ≤ 1)) 2
    linarith
  have htstar_sq : (tstar - s) ^ 2 = 1 - ‖x'‖ ^ 2 := by
    rw [htstar, add_sub_cancel_left, Real.sq_sqrt (by linarith)]
  have hsqrt_le : Real.sqrt (1 - ‖x'‖ ^ 2) ≤ 1 := by
    rw [Real.sqrt_le_one]; linarith [sq_nonneg ‖x'‖]
  have hsqrt0 := Real.sqrt_nonneg (1 - ‖x'‖ ^ 2)
  have hη0 : 0 ≤ η := (abs_nonneg _).trans hη
  have hdelta : |(t - s) ^ 2 + ‖x'‖ ^ 2 + 2 * t * inner ℝ x' w' + 2 * t * s * e - 1| ≤
      4 * η + 4 * a * h + 4 * s * h ^ 2 := by
    have h1 : (t - s) ^ 2 + ‖x'‖ ^ 2 - 1 = (t - tstar) * (t + tstar - 2 * s) := by
      have : ‖x'‖ ^ 2 - 1 = -(tstar - s) ^ 2 := by rw [htstar_sq]; ring
      linear_combination this
    have h2 : |(t - tstar) * (t + tstar - 2 * s)| ≤ 4 * η := by
      rw [abs_mul]
      have h4 : |t + tstar - 2 * s| ≤ 4 :=
        abs_le.mpr ⟨by rw [htstar]; linarith, by rw [htstar]; linarith⟩
      have := mul_le_mul hη h4 (abs_nonneg _) hη0
      linarith
    have h3 : |2 * t * inner ℝ x' w'| ≤ 4 * a * h := by
      rw [abs_mul, abs_of_nonneg (by linarith : 0 ≤ 2 * t)]
      have := mul_le_mul (by linarith : 2 * t ≤ 4) hinner (abs_nonneg _) (by norm_num)
      linarith
    have h4 : |2 * t * s * e| ≤ 4 * s * h ^ 2 := by
      have hse : 0 ≤ s * e := mul_nonneg hs0 he0
      rw [abs_of_nonneg (by nlinarith)]
      have heh : e ≤ h ^ 2 := he_le.trans (pow_le_pow_left₀ (norm_nonneg _) hw'.le 2)
      have := mul_le_mul (by linarith : 2 * t ≤ 4)
        (mul_le_mul_of_nonneg_left heh hs0) hse (by norm_num)
      linarith
    calc _ = |((t - s) ^ 2 + ‖x'‖ ^ 2 - 1) + 2 * t * inner ℝ x' w' + 2 * t * s * e| := by
          ring_nf
      _ ≤ |(t - s) ^ 2 + ‖x'‖ ^ 2 - 1| + |2 * t * inner ℝ x' w'| + |2 * t * s * e| :=
          abs_add_three _ _ _
      _ ≤ _ := by rw [h1]; linarith
  -- graph tube membership
  rw [mem_graphTube_iff]
  refine ⟨lt_of_le_of_lt hny' hρ, ?_⟩
  rw [hyd]
  simp only [graphHeight, zero_sub, one_pow, sub_neg_eq_add]
  set Y := ‖(succCoordinates n y).1‖ with hY
  have hY2 : Y ^ 2 ≤ 1 / 4 := by
    have : Y ≤ 1 / 2 := hny'.trans (by linarith)
    have := pow_le_pow_left₀ (norm_nonneg _) this 2
    linarith
  have hwdneg : wd ≤ -15 / 16 := by linarith [(abs_lt.mp hwd).2]
  have htwd : t * wd ≤ 1 * wd := mul_le_mul_of_nonpos_right ht1 (by linarith)
  have hydneg : s + t * wd ≤ -7 / 8 := by linarith
  have hsqY : Real.sqrt (1 - Y ^ 2) ^ 2 = 1 - Y ^ 2 := Real.sq_sqrt (by linarith)
  have hsqY0 := Real.sqrt_nonneg (1 - Y ^ 2)
  have hfactor : (s + t * wd + Real.sqrt (1 - Y ^ 2)) *
      (Real.sqrt (1 - Y ^ 2) - (s + t * wd)) =
      -((Y ^ 2 + (s + t * wd) ^ 2) - 1) := by
    linear_combination hsqY
  have hYeq : Y ^ 2 + (s + t * wd) ^ 2 =
      (t - s) ^ 2 + ‖x'‖ ^ 2 + 2 * t * inner ℝ x' w' + 2 * t * s * e := by
    rw [hY, hy', hnormy]
  rw [hYeq] at hfactor
  have hden : 7 / 8 ≤ Real.sqrt (1 - Y ^ 2) - (s + t * wd) := by linarith
  have habs := congrArg abs hfactor
  rw [abs_mul, abs_neg, abs_of_pos (by linarith : 0 < Real.sqrt (1 - Y ^ 2) - (s + t * wd))]
    at habs
  have hlow := mul_le_mul_of_nonneg_left hden (abs_nonneg (s + t * wd + Real.sqrt (1 - Y ^ 2)))
  have hbound0 : 0 ≤ 4 * η + 4 * a * h + 4 * s * h ^ 2 := (abs_nonneg _).trans hdelta
  linarith

/-- Geometric domination: if the amplitudes at least double from one index to
the next, a sum of amplitudes times `0/1` values is at most twice its largest
active term, so its `p`-th power is at most `2^p` times the sum of `p`-th
powers. -/
theorem geometric_indicator_sum_rpow_le (J : Finset ℕ) (lam : ℕ → ℝ)
    (hlam0 : ∀ j, 0 ≤ lam j) (hlam : ∀ j, 2 * lam j ≤ lam (j + 1))
    (χ : ℕ → ℝ) (hχ : ∀ j, χ j = 0 ∨ χ j = 1) {p : ℝ} (hp : 0 < p) :
    (∑ j ∈ J, lam j * χ j) ^ p ≤ 2 ^ p * ∑ j ∈ J, lam j ^ p * χ j := by
  classical
  have hχ0 : ∀ j, 0 ≤ χ j := fun j => by rcases hχ j with h | h <;> simp [h]
  set J' := J.filter (fun j => χ j = 1) with hJ'
  have hsum : ∑ j ∈ J, lam j * χ j = ∑ j ∈ J', lam j := by
    rw [hJ', Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro j _
    rcases hχ j with h | h <;> simp [h]
  have hsump : ∑ j ∈ J, lam j ^ p * χ j = ∑ j ∈ J', lam j ^ p := by
    rw [hJ', Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro j _
    rcases hχ j with h | h <;> simp [h]
  rw [hsum, hsump]
  rcases J'.eq_empty_or_nonempty with he | hne
  · simp [he, Real.zero_rpow hp.ne']
  set M := J'.max' hne
  have hmono : ∀ i l, lam i * 2 ^ l ≤ lam (i + l) := by
    intro i l
    induction l with
    | zero => simp
    | succ l ih =>
      have := hlam (i + l)
      rw [pow_succ, ← add_assoc]
      nlinarith [pow_pos (by norm_num : (0 : ℝ) < 2) l]
  have hterm : ∀ i ∈ J', lam i ≤ lam M * (1 / 2) ^ (M - i) := by
    intro i hi
    have hiM : i ≤ M := J'.le_max' i hi
    have := hmono i (M - i)
    rw [Nat.add_sub_cancel' hiM] at this
    rw [one_div_pow, mul_one_div, le_div_iff₀ (by positivity)]
    exact this
  have hgeo : ∑ i ∈ J', ((1 : ℝ) / 2) ^ (M - i) ≤ 2 := by
    have hinj : Set.InjOn (fun i => M - i) (↑J' : Set ℕ) := by
      intro i hi j hj hij
      have := J'.le_max' i hi
      have := J'.le_max' j hj
      simp only at hij
      omega
    calc ∑ i ∈ J', ((1 : ℝ) / 2) ^ (M - i)
        = ∑ l ∈ J'.image (fun i => M - i), ((1 : ℝ) / 2) ^ l := by
          rw [Finset.sum_image (fun i hi j hj hij => hinj hi hj hij)]
      _ ≤ ∑ l ∈ Finset.range (M + 1), ((1 : ℝ) / 2) ^ l := by
          apply Finset.sum_le_sum_of_subset_of_nonneg
          · intro l hl
            obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hl
            simp only [Finset.mem_range]; omega
          · intro _ _ _; positivity
      _ ≤ 2 := by
          have := sum_geometric_two_le (M + 1)
          simpa [one_div] using this
  have hbound : ∑ i ∈ J', lam i ≤ 2 * lam M := by
    calc ∑ i ∈ J', lam i ≤ ∑ i ∈ J', lam M * (1 / 2) ^ (M - i) :=
          Finset.sum_le_sum hterm
      _ = lam M * ∑ i ∈ J', ((1 : ℝ) / 2) ^ (M - i) := by rw [Finset.mul_sum]
      _ ≤ lam M * 2 := mul_le_mul_of_nonneg_left hgeo (hlam0 M)
      _ = 2 * lam M := by ring
  have hM : M ∈ J' := J'.max'_mem hne
  calc (∑ i ∈ J', lam i) ^ p ≤ (2 * lam M) ^ p :=
        Real.rpow_le_rpow (Finset.sum_nonneg (fun i _ => hlam0 i)) hbound hp.le
    _ = 2 ^ p * lam M ^ p := Real.mul_rpow (by norm_num) (hlam0 M)
    _ ≤ 2 ^ p * ∑ i ∈ J', lam i ^ p := by
        gcongr
        exact Finset.single_le_sum (fun i _ => Real.rpow_nonneg (hlam0 i) p) hM

/-- The real normalized spherical average. -/
def realSphericalAverage (d : ℕ) (g : Euclidean d → ℝ) (t : ℝ) (x : Euclidean d) : ℝ :=
  (surfaceMass d)⁻¹ * ∫ ω : Metric.sphere (0 : Euclidean d) 1,
    g (x + t • (ω : Euclidean d)) ∂unitSurfaceMeasure d

theorem normalizedSphericalAverage_ofReal {d : ℕ} (g : Euclidean d → ℝ) (t : ℝ)
    (x : Euclidean d) :
    normalizedSphericalAverage d (fun y => (g y : ℂ)) t x =
      (realSphericalAverage d g t x : ℂ) := by
  unfold normalizedSphericalAverage sphericalAverage realSphericalAverage
  rw [integral_complex_ofReal]
  push_cast
  ring

/-- A lower bound `c` on a measurable set of directions gives the average at
least `c` times its normalized surface measure. -/
theorem le_realSphericalAverage_of_cap {d : ℕ} (hd : 0 < d) (g : Euclidean d → ℝ)
    (t : ℝ) (x : Euclidean d) (A : Set (Metric.sphere (0 : Euclidean d) 1))
    (hA : MeasurableSet A) {c : ℝ} (hc : 0 ≤ c)
    (hgi : Integrable (fun ω : Metric.sphere (0 : Euclidean d) 1 =>
      g (x + t • (ω : Euclidean d))) (unitSurfaceMeasure d))
    (hg0 : ∀ ω : Metric.sphere (0 : Euclidean d) 1, 0 ≤ g (x + t • (ω : Euclidean d)))
    (hgc : ∀ ω ∈ A, c ≤ g (x + t • (ω : Euclidean d))) :
    c * (unitSurfaceMeasure d).real A / surfaceMass d ≤ realSphericalAverage d g t x := by
  have hmass : 0 < surfaceMass d := surfaceMass_pos hd
  have hχi : Integrable (A.indicator (fun _ => c)) (unitSurfaceMeasure d) :=
    (integrable_const c).indicator hA
  have hle : A.indicator (fun _ => c) ≤ fun ω : Metric.sphere (0 : Euclidean d) 1 =>
      g (x + t • (ω : Euclidean d)) := by
    intro ω
    by_cases hω : ω ∈ A
    · rw [Set.indicator_of_mem hω]; exact hgc ω hω
    · rw [Set.indicator_of_notMem hω]; exact hg0 ω
  have hint := integral_mono hχi hgi hle
  rw [integral_indicator hA, setIntegral_const, smul_eq_mul] at hint
  unfold realSphericalAverage
  rw [div_eq_inv_mul, mul_comm c]
  exact mul_le_mul_of_nonneg_left (by simpa [Measure.real_def] using hint)
    (inv_nonneg.mpr hmass.le)

/-- Section 3.2, the bumps `R^j`: graph tubes of horizontal radius `2^{k-j}` and
thickness `2^{-j}` about the south-pole cap of the unit sphere in `ℝ^{n+1}`. -/
def criticalTube (n k j : ℕ) : Set (Euclidean (n + 1)) :=
  graphTube n 1 0 ((2 : ℝ) ^ ((k : ℝ) - j)) ((2 : ℝ) ^ (-(j : ℝ)))

/-- Section 3.2, the amplitudes `λ_j = (2^{(j-k)n + j})^{1/p}` at `p = (n+1)/n`. -/
def criticalAmp (n k j : ℕ) : ℝ := (2 : ℝ) ^ ((((j : ℝ) - k) * n + j) * (n / (n + 1)))

/-- Section 3.2, the test function `f_k = Σ_{k<j≤k+m} λ_j 1_{R^j}`. -/
def criticalInput (n k m : ℕ) (y : Euclidean (n + 1)) : ℝ :=
  ∑ j ∈ Finset.Ioc k (k + m), criticalAmp n k j * (criticalTube n k j).indicator 1 y

theorem criticalAmp_pos (n k j : ℕ) : 0 < criticalAmp n k j := by
  unfold criticalAmp; positivity

theorem criticalAmp_double {n : ℕ} (hn : 1 ≤ n) (k j : ℕ) :
    2 * criticalAmp n k j ≤ criticalAmp n k (j + 1) := by
  unfold criticalAmp
  have hn' : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have he : ((((j + 1 : ℕ) : ℝ) - k) * n + (j + 1 : ℕ)) * (n / (n + 1)) =
      (((j : ℝ) - k) * n + j) * (n / (n + 1)) + n := by
    push_cast; field_simp; ring
  rw [he, Real.rpow_add (by norm_num)]
  have h2 : (2 : ℝ) ≤ (2 : ℝ) ^ (n : ℝ) := by
    calc (2 : ℝ) = 2 ^ (1 : ℝ) := by norm_num
      _ ≤ 2 ^ (n : ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) hn'
  have h3 : 0 < (2 : ℝ) ^ ((((j : ℝ) - k) * n + j) * (n / (n + 1))) := by positivity
  nlinarith

theorem measurableSet_criticalTube (n k j : ℕ) : MeasurableSet (criticalTube n k j) :=
  measurableSet_graphTube n _ _ _ _

/-- The bumps stay away from the origin: they lie outside the ball of radius
`1/4` when `j > k`. -/
theorem criticalTube_norm_ge {n k j : ℕ} (hkj : k < j) {y : Euclidean (n + 1)}
    (hy : y ∈ criticalTube n k j) : 1 / 4 ≤ ‖y‖ := by
  rw [criticalTube, mem_graphTube_iff] at hy
  obtain ⟨hhor, hvert⟩ := hy
  have hkj' : (k : ℝ) + 1 ≤ j := by exact_mod_cast hkj
  have hρ : (2 : ℝ) ^ ((k : ℝ) - j) ≤ 1 / 2 := by
    calc (2 : ℝ) ^ ((k : ℝ) - j) ≤ 2 ^ (-1 : ℝ) :=
          Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
      _ = 1 / 2 := by norm_num
  have hb : (2 : ℝ) ^ (-(j : ℝ)) ≤ 1 / 2 := by
    calc (2 : ℝ) ^ (-(j : ℝ)) ≤ 2 ^ (-1 : ℝ) :=
          Real.rpow_le_rpow_of_exponent_le (by norm_num)
            (by linarith [(Nat.cast_nonneg k : (0 : ℝ) ≤ k)])
      _ = 1 / 2 := by norm_num
  set Y := ‖(succCoordinates n y).1‖
  set yd := (succCoordinates n y).2
  have hY : Y < 1 / 2 := hhor.trans_le hρ
  have hY2 : Y ^ 2 < 1 / 4 := by nlinarith [norm_nonneg (succCoordinates n y).1]
  have hsqrt : 3 / 4 ≤ Real.sqrt (1 - Y ^ 2) := by
    rw [Real.le_sqrt (by norm_num) (by linarith)]; linarith
  simp only [graphHeight, zero_sub, one_pow, sub_neg_eq_add] at hvert
  have hyd : yd < -(1 / 4) := by linarith [(abs_lt.mp hvert).2]
  have hnorm := norm_sq_succCoordinates n y
  have : (1 / 4 : ℝ) ^ 2 ≤ ‖y‖ ^ 2 := by nlinarith [sq_nonneg Y]
  exact le_of_pow_le_pow_left₀ two_ne_zero (norm_nonneg y) this

theorem criticalInput_nonneg (n k m : ℕ) (y : Euclidean (n + 1)) :
    0 ≤ criticalInput n k m y :=
  Finset.sum_nonneg fun j _ => mul_nonneg (criticalAmp_pos n k j).le
    (Set.indicator_nonneg (fun _ _ => zero_le_one) y)

/-- The unit-mass identity `λ_j^p · ρ_j^n · b_j = 1` for the bumps of
Section 3.2 at `p = (n+1)/n`. -/
theorem criticalAmp_mass_identity {n : ℕ} (hn : 1 ≤ n) (k j : ℕ) :
    criticalAmp n k j ^ (((n : ℝ) + 1) / n) * ((2 : ℝ) ^ ((k : ℝ) - j)) ^ n *
      (2 : ℝ) ^ (-(j : ℝ)) = 1 := by
  have hn' : (0 : ℝ) < n := by exact_mod_cast hn
  unfold criticalAmp
  rw [← Real.rpow_mul (by norm_num), ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num),
    ← Real.rpow_add (by norm_num), ← Real.rpow_add (by norm_num)]
  have : (((j : ℝ) - k) * n + j) * (n / (n + 1)) * ((n + 1) / n) + ((k : ℝ) - j) * n +
      -(j : ℝ) = 0 := by
    field_simp; ring
  rw [this, Real.rpow_zero]

/-- `eq:normfk` (with the corrected bumps): the weighted `L^p` moment of the
Section 3.2 test function, `p = (n+1)/n`, is at most a constant times the
number `m` of bumps. -/
theorem criticalInput_moment_le {n : ℕ} (hn : 1 ≤ n) :
    ∃ K : ℝ≥0∞, K ≠ ∞ ∧ ∀ k m : ℕ,
      (∫⁻ y, ‖((criticalInput n k m y : ℝ) : ℂ)‖ₑ ^ (((n : ℝ) + 1) / n)
        ∂powerWeightedVolume (n + 1) (-(n : ℝ))) ≤ K * m := by
  have hn' : (0 : ℝ) < n := by exact_mod_cast hn
  set p : ℝ := ((n : ℝ) + 1) / n with hpdef
  have hp : 0 < p := by positivity
  haveI : Nonempty (Fin n) := ⟨⟨0, hn⟩⟩
  set Kb : ℝ := Real.sqrt Real.pi ^ n / Real.Gamma (n / 2 + 1) with hKb
  have hKb0 : 0 ≤ Kb := by
    rw [hKb]; exact div_nonneg (by positivity) (Real.Gamma_pos_of_pos (by positivity)).le
  set c : ℝ := 2 ^ p * 4 ^ (n : ℝ) * Kb * 2 with hc
  refine ⟨ENNReal.ofReal c, ENNReal.ofReal_ne_top, ?_⟩
  intro k m
  set J := Finset.Ioc k (k + m)
  -- pointwise geometric domination
  have hpoint : ∀ y, ‖((criticalInput n k m y : ℝ) : ℂ)‖ₑ ^ p ≤
      ∑ j ∈ J, ENNReal.ofReal (2 ^ p * criticalAmp n k j ^ p) *
        (criticalTube n k j).indicator 1 y := by
    intro y
    have h0 := criticalInput_nonneg n k m y
    rw [show ‖((criticalInput n k m y : ℝ) : ℂ)‖ₑ = ENNReal.ofReal (criticalInput n k m y) by
      rw [← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg h0],
      ENNReal.ofReal_rpow_of_nonneg h0 hp.le]
    have hgeo := geometric_indicator_sum_rpow_le J (criticalAmp n k)
      (fun j => (criticalAmp_pos n k j).le) (criticalAmp_double hn k)
      (fun j => (criticalTube n k j).indicator 1 y)
      (fun j => by
        by_cases hy : y ∈ criticalTube n k j
        · right; simp [Set.indicator_of_mem hy]
        · left; simp [Set.indicator_of_notMem hy]) hp
    apply (ENNReal.ofReal_le_ofReal hgeo).trans
    rw [Finset.mul_sum, ENNReal.ofReal_sum_of_nonneg (fun j _ => by
      apply mul_nonneg (by positivity)
      exact mul_nonneg (Real.rpow_nonneg (criticalAmp_pos n k j).le _) (Set.indicator_nonneg (fun _ _ => zero_le_one) y))]
    apply Finset.sum_le_sum
    intro j _
    by_cases hy : y ∈ criticalTube n k j
    · simp [Set.indicator_of_mem hy]
    · simp [Set.indicator_of_notMem hy]
  -- each bump has weighted mass at most `c / (2^p λ_j^p)`
  have hbump : ∀ j ∈ J, ENNReal.ofReal (2 ^ p * criticalAmp n k j ^ p) *
      powerWeightedVolume (n + 1) (-(n : ℝ)) (criticalTube n k j) ≤ ENNReal.ofReal c := by
    intro j hj
    have hkj : k < j := (Finset.mem_Ioc.mp hj).1
    have hvan := lintegral_powerWeightedVolume_le_of_vanish (d := n + 1)
      (β := -(n : ℝ)) (α := 0) (r := 1 / 4) (by linarith) (by norm_num)
      ((criticalTube n k j).indicator 1)
      (measurable_one.indicator (measurableSet_criticalTube n k j))
      (fun y hy => Set.indicator_of_notMem (fun hmem =>
        absurd (criticalTube_norm_ge hkj hmem) (not_le.mpr hy)) _)
    rw [lintegral_indicator_one (measurableSet_criticalTube n k j),
      lintegral_indicator_one (measurableSet_criticalTube n k j),
      powerWeightedVolume_zero, criticalTube, volume_graphTube,
      EuclideanSpace.volume_ball, Fintype.card_fin] at hvan
    have hρ0 : (0 : ℝ) ≤ (2 : ℝ) ^ ((k : ℝ) - j) := by positivity
    have hb0 : (0 : ℝ) ≤ (2 : ℝ) ^ (-(j : ℝ)) := by positivity
    calc ENNReal.ofReal (2 ^ p * criticalAmp n k j ^ p) *
          powerWeightedVolume (n + 1) (-(n : ℝ)) (criticalTube n k j)
        ≤ ENNReal.ofReal (2 ^ p * criticalAmp n k j ^ p) *
          (ENNReal.ofReal (1 / 4) ^ (-(n : ℝ) - 0) *
            (ENNReal.ofReal ((2 : ℝ) ^ ((k : ℝ) - j)) ^ n * ENNReal.ofReal Kb *
              ENNReal.ofReal (2 * (2 : ℝ) ^ (-(j : ℝ))))) := by
          gcongr
          rw [criticalTube]; exact hvan
      _ = ENNReal.ofReal (2 ^ p * criticalAmp n k j ^ p *
            (((1 / 4 : ℝ) ^ (-(n : ℝ))) * (((2 : ℝ) ^ ((k : ℝ) - j)) ^ n * Kb *
              (2 * (2 : ℝ) ^ (-(j : ℝ)))))) := by
          rw [sub_zero, ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 1 / 4),
            ← ENNReal.ofReal_pow hρ0,
            ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity),
            ← ENNReal.ofReal_mul (by positivity),
            ← ENNReal.ofReal_mul (mul_nonneg (by positivity)
              (Real.rpow_nonneg (criticalAmp_pos n k j).le _))]
      _ = ENNReal.ofReal c := by
          congr 1
          have hid := criticalAmp_mass_identity hn k j
          have h4 : (1 / 4 : ℝ) ^ (-(n : ℝ)) = 4 ^ (n : ℝ) := by
            rw [one_div, Real.inv_rpow (by norm_num), Real.rpow_neg (by norm_num), inv_inv]
          rw [h4, hc]
          rw [← hpdef] at hid
          linear_combination (2 ^ p * 4 ^ (n : ℝ) * Kb * 2) * hid
  calc (∫⁻ y, ‖((criticalInput n k m y : ℝ) : ℂ)‖ₑ ^ p ∂powerWeightedVolume (n + 1) (-(n : ℝ)))
      ≤ ∫⁻ y, ∑ j ∈ J, ENNReal.ofReal (2 ^ p * criticalAmp n k j ^ p) *
          (criticalTube n k j).indicator 1 y ∂powerWeightedVolume (n + 1) (-(n : ℝ)) :=
        lintegral_mono hpoint
    _ = ∑ j ∈ J, ENNReal.ofReal (2 ^ p * criticalAmp n k j ^ p) *
          powerWeightedVolume (n + 1) (-(n : ℝ)) (criticalTube n k j) := by
        rw [lintegral_finsetSum _ (fun j _ => (measurable_one.indicator
          (measurableSet_criticalTube n k j)).const_mul _)]
        apply Finset.sum_congr rfl
        intro j _
        rw [lintegral_const_mul _ (measurable_one.indicator (measurableSet_criticalTube n k j)),
          lintegral_indicator_one (measurableSet_criticalTube n k j)]
    _ ≤ ∑ j ∈ J, ENNReal.ofReal c := Finset.sum_le_sum hbump
    _ = ENNReal.ofReal c * m := by
        rw [Finset.sum_const, Nat.card_Ioc, add_tsub_cancel_left, nsmul_eq_mul, mul_comm]

/-- `λ_j · (2^{k-j})^n = 2^{kn/(n+1)}`: every bump contributes the same amount
to the spherical averages over the caps of radius `≈ 2^{k-j}`. -/
theorem criticalAmp_cap_identity {n : ℕ} (hn : 1 ≤ n) (k j : ℕ) :
    criticalAmp n k j * ((2 : ℝ) ^ ((k : ℝ) - j)) ^ n =
      (2 : ℝ) ^ ((k : ℝ) * (n / (n + 1))) := by
  have hn' : (0 : ℝ) < n := by exact_mod_cast hn
  unfold criticalAmp
  rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num), ← Real.rpow_add (by norm_num)]
  congr 1
  field_simp
  ring

/-- The planar moving-cap lower bound, from the exact cosine pushforward
of circle measure. It has the same coefficient as the higher-dimensional
bound, allowing the Section 3.2 counterexample in every dimension at least two. -/
theorem planar_sphericalCap_real_lower {v : Euclidean 2} (hv : ‖v‖ = 1)
    {h : ℝ} (hh : 0 < h) (hh1 : h ≤ 1) :
    surfaceMass 1 * (h / 2) ≤ (unitSurfaceMeasure 2).real (sphericalCap 1 v h) := by
  let H : Metric.sphere (0 : Euclidean 2) 1 → ℝ := fun ω => (ω : Euclidean 2) (Fin.last 1)
  have hH : Measurable H := by dsimp [H]; fun_prop
  let A : Set ℝ := Ioi (1 - h ^ 2 / 2)
  have hA : MeasurableSet A := measurableSet_Ioi
  have hsub : H ⁻¹' A ⊆ northPoleCap 1 h := by
    intro ω hω
    have hn : ‖(ω : Euclidean 2)‖ = 1 := mem_sphere_zero_iff_norm.mp ω.property
    have heq : dist (ω : Euclidean 2) (northPole 1) ^ 2 = 2 * (1 - H ω) := by
      rw [dist_eq_norm, norm_sub_sq_real, hn, norm_northPole, inner_northPole]
      dsimp [H]; ring
    change 1 - h ^ 2 / 2 < H ω at hω
    change dist (ω : Euclidean 2) (northPole 1) < h
    nlinarith [dist_nonneg (x := (ω : Euclidean 2)) (y := northPole 1)]
  have hangle : Ioo (0 : ℝ) (h / 2) ⊆ Real.cos ⁻¹' A ∩ Ioo 0 Real.pi := by
    intro θ hθ
    refine ⟨?_, ⟨hθ.1, ?_⟩⟩
    · change 1 - h ^ 2 / 2 < Real.cos θ
      have hcos := Real.one_sub_sq_div_two_le_cos (x := θ)
      nlinarith [hθ.1, hθ.2, sq_nonneg (h - θ)]
    · linarith [hθ.2, Real.pi_gt_three]
  have hm : ENNReal.ofReal (surfaceMass 1) * ENNReal.ofReal (h / 2) ≤
      unitSurfaceMeasure 2 (sphericalCap 1 v h) := by
    rw [unitSurfaceMeasure_sphericalCap_eq_pole 1 hv h]
    calc
      _ = ENNReal.ofReal (surfaceMass 1) * volume (Ioo (0 : ℝ) (h / 2)) := by
        rw [Real.volume_Ioo]; simp
      _ ≤ ENNReal.ofReal (surfaceMass 1) * volume (Real.cos ⁻¹' A ∩ Ioo 0 Real.pi) :=
        mul_le_mul' le_rfl (measure_mono hangle)
      _ = unitSurfaceMeasure 2 (H ⁻¹' A) := by
        have heq := congrArg (fun μ : Measure ℝ => μ A) map_unitSurfaceMeasure_two_height
        rw [Measure.map_apply hH hA, Measure.smul_apply,
          Measure.map_apply Real.continuous_cos.measurable hA,
          Measure.restrict_apply (hA.preimage Real.continuous_cos.measurable)] at heq
        exact heq.symm
      _ ≤ _ := measure_mono hsub
  rw [← ENNReal.ofReal_mul (surfaceMass_pos (by norm_num : 0 < 1)).le] at hm
  exact (ENNReal.ofReal_le_iff_le_toReal (measure_ne_top _ _)).mp hm

/-- Real form of the moving-cap surface measure bound: a cap of chordal radius
`h ≤ 1` has measure at least `σ_n (h/2)^n`. -/
theorem unitSurfaceMeasure_sphericalCap_real_lower {n : ℕ} (hn : 1 ≤ n)
    {v : Euclidean (n + 1)} (hv : ‖v‖ = 1) {h : ℝ} (hh : 0 < h) (hh1 : h ≤ 1) :
    surfaceMass n * (h / 2) ^ n ≤ (unitSurfaceMeasure (n + 1)).real (sphericalCap n v h) := by
  rcases eq_or_lt_of_le hn with hn | hn
  · subst n
    simpa using planar_sphericalCap_real_lower hv hh hh1
  have hn : 2 ≤ n := hn
  have hlow := unitSurfaceMeasure_sphericalCap_lower hn hv hh hh1
  have hσ : 0 ≤ surfaceMass n := (surfaceMass_pos (by omega)).le
  have heq : surfaceMass n * (h / 2) ^ n =
      surfaceMass n * ((h / 2) ^ (n - 2) * (h ^ 2 / 4)) := by
    have : (h / 2) ^ n = (h / 2) ^ (n - 2) * (h / 2) ^ 2 := by
      rw [← pow_add, Nat.sub_add_cancel hn]
    rw [this]; ring
  rw [heq, Measure.real_def]
  rw [← ENNReal.ofReal_pow (by positivity), ← ENNReal.ofReal_mul (by positivity),
    ← ENNReal.ofReal_mul hσ] at hlow
  exact (ENNReal.ofReal_le_iff_le_toReal (measure_ne_top _ _)).mp hlow

/-- `eq:Mfknorm`, pointwise: on the slab `V_k` of centres, some radius
`t ∈ E^μ` makes the spherical average of the test function at least
`m σ_n/σ_{n+1} 128^{-n} 2^{kn/(n+1)}`. The hypothesis `hη` encodes that the
gaps of `E^μ` near `1 + 2^{-k}` are below `2^{-(k+m)}/64`. -/
theorem criticalInput_average_lower {n : ℕ} (hn : 1 ≤ n) {μ : ℝ} (hμ : 0 < μ)
    {k m : ℕ} (hk4 : 4 ≤ k) (hmk : m ≤ k)
    (hη : μ * 2 ^ (μ + 1) * (2 : ℝ) ^ (-((k : ℝ) / μ)) ≤ (2 : ℝ) ^ (-(m : ℝ)) / 64)
    {x : Euclidean (n + 1)}
    (hx : x ∈ horizontalSlab n ((2 : ℝ) ^ (-(k : ℝ)) / 64) ((2 : ℝ) ^ (-(k : ℝ)) / 2)
      ((2 : ℝ) ^ (-(k : ℝ)))) :
    ∃ t ∈ sequenceSet μ,
      m * (surfaceMass n / surfaceMass (n + 1) * (1 / 128) ^ n *
        (2 : ℝ) ^ ((k : ℝ) * (n / (n + 1)))) ≤
        realSphericalAverage (n + 1) (criticalInput n k m) t x := by
  have hn1 : 1 ≤ n := by omega
  -- the coordinates of the centre
  rw [horizontalSlab, Set.mem_preimage, Set.mem_prod, Metric.mem_ball, dist_zero_right,
    Set.mem_Ioo] at hx
  obtain ⟨hx', hs⟩ := hx
  set x' := (succCoordinates n x).1
  set s := (succCoordinates n x).2
  set q : ℝ := (2 : ℝ) ^ (-(k : ℝ)) with hq
  have hq0 : 0 < q := by positivity
  have hq16 : q ≤ 1 / 16 := by
    rw [hq]
    calc (2 : ℝ) ^ (-(k : ℝ)) ≤ 2 ^ (-(4 : ℝ)) :=
          Real.rpow_le_rpow_of_exponent_le (by norm_num)
            (by have : (4 : ℝ) ≤ k := by exact_mod_cast hk4
                linarith)
      _ = 1 / 16 := by norm_num
  have hx'2 : ‖x'‖ ^ 2 ≤ q ^ 2 / 4096 := by
    have := pow_le_pow_left₀ (norm_nonneg _) hx'.le 2
    nlinarith
  -- the target radius and the nearby point of `E^μ`
  set u := s + Real.sqrt (1 - ‖x'‖ ^ 2) - 1 with hu
  have hsqrt_ge : 1 - ‖x'‖ ^ 2 ≤ Real.sqrt (1 - ‖x'‖ ^ 2) := by
    have h0 : 0 ≤ 1 - ‖x'‖ ^ 2 := by nlinarith
    have h1 : 1 - ‖x'‖ ^ 2 ≤ 1 := by nlinarith [sq_nonneg ‖x'‖]
    calc 1 - ‖x'‖ ^ 2 = Real.sqrt ((1 - ‖x'‖ ^ 2) ^ 2) := (Real.sqrt_sq h0).symm
      _ ≤ Real.sqrt (1 - ‖x'‖ ^ 2) := Real.sqrt_le_sqrt (by nlinarith)
  have hsqrt_le : Real.sqrt (1 - ‖x'‖ ^ 2) ≤ 1 := by
    rw [Real.sqrt_le_one]; nlinarith [sq_nonneg ‖x'‖]
  have hu0 : 0 < u := by rw [hu]; nlinarith
  have huq : u ≤ q := by rw [hu]; linarith
  obtain ⟨N, hN1, hN⟩ := exists_sequence_point_near hμ hu0 (by linarith)
  set t : ℝ := 1 + (N : ℝ) ^ (-μ) with ht
  have hNmem := rpow_neg_mem_Ioc hμ.le hN1
  have ht1 : 1 ≤ t := by linarith [hNmem.1]
  have ht2 : t ≤ 2 := by linarith [hNmem.2]
  refine ⟨t, ⟨N, hN1, rfl⟩, ?_⟩
  -- the approximation error
  set η := μ * 2 ^ (μ + 1) * u ^ ((μ + 1) / μ) with hηdef
  have hηt : |t - (s + Real.sqrt (1 - ‖x'‖ ^ 2))| ≤ η := by
    have : t - (s + Real.sqrt (1 - ‖x'‖ ^ 2)) = (N : ℝ) ^ (-μ) - u := by rw [ht, hu]; ring
    rw [this]; exact hN
  have hηsmall : η ≤ q * (2 : ℝ) ^ (-(m : ℝ)) / 64 := by
    have h1 : u ^ ((μ + 1) / μ) ≤ q ^ ((μ + 1) / μ) :=
      Real.rpow_le_rpow hu0.le huq (by positivity)
    have h2 : q ^ ((μ + 1) / μ) = q * (2 : ℝ) ^ (-((k : ℝ) / μ)) := by
      rw [hq, ← Real.rpow_mul (by norm_num), ← Real.rpow_add (by norm_num)]
      congr 1; field_simp; ring
    have hc : 0 ≤ μ * 2 ^ (μ + 1) := by positivity
    calc η ≤ μ * 2 ^ (μ + 1) * (q * (2 : ℝ) ^ (-((k : ℝ) / μ))) := by
          rw [hηdef, ← h2]; exact mul_le_mul_of_nonneg_left h1 hc
      _ = q * (μ * 2 ^ (μ + 1) * (2 : ℝ) ^ (-((k : ℝ) / μ))) := by ring
      _ ≤ q * ((2 : ℝ) ^ (-(m : ℝ)) / 64) := mul_le_mul_of_nonneg_left hη hq0.le
      _ = _ := by ring
  have hη0 : 0 ≤ η := (abs_nonneg _).trans hηt
  -- each bump captures a cap of directions
  have hcap : ∀ j ∈ Finset.Ioc k (k + m), ∀ ω ∈ sphericalCap n (southPole n)
      ((2 : ℝ) ^ ((k : ℝ) - j) / 64),
      x + t • (ω : Euclidean (n + 1)) ∈ criticalTube n k j := by
    intro j hj ω hω
    obtain ⟨hkj, hjm⟩ := Finset.mem_Ioc.mp hj
    have hkj' : (k : ℝ) + 1 ≤ j := by exact_mod_cast hkj
    have hjm' : (j : ℝ) ≤ k + m := by exact_mod_cast hjm
    have hmk' : (m : ℝ) ≤ k := by exact_mod_cast hmk
    set r := (2 : ℝ) ^ ((k : ℝ) - j) with hr
    set b := (2 : ℝ) ^ (-(j : ℝ)) with hb
    have hr0 : 0 < r := by positivity
    have hr1 : r ≤ 1 / 2 := by
      calc r ≤ 2 ^ (-1 : ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
        _ = 1 / 2 := by norm_num
    have hqr : q * r = b := by
      rw [hq, hr, hb, ← Real.rpow_add (by norm_num)]; ring_nf
    have hqr' : q ≤ r := by
      rw [hq, hr]; exact Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
    have hbm : q * (2 : ℝ) ^ (-(m : ℝ)) ≤ b := by
      rw [← hqr]; apply mul_le_mul_of_nonneg_left _ hq0.le
      rw [hr]; exact Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
    apply translate_southCap_mem_graphTube n (a := q / 64) hx'.le rfl
      (by linarith [hs.1, hq0]) (by linarith [hs.2]) (by linarith) ht1 ht2 hηt
      (by positivity) (by linarith) (by linarith) _ hω
    -- the thickness condition
    have h1 : 8 * η ≤ b / 8 := by linarith
    have h2 : 8 * (q / 64) * (r / 64) = b / 512 := by rw [← hqr]; ring
    have h3 : 8 * s * (r / 64) ^ 2 ≤ b / 512 := by
      have hsq : s ≤ q := hs.2.le
      have : s * r ^ 2 ≤ q * r := by
        have hs0 : 0 ≤ s := by linarith [hs.1, hq0]
        calc s * r ^ 2 ≤ q * r ^ 2 := mul_le_mul_of_nonneg_right hsq (by positivity)
          _ ≤ q * r := mul_le_mul_of_nonneg_left (by nlinarith) hq0.le
      linarith
    have hb0 : 0 < b := by positivity
    linarith
  -- linearity of the average and the cap lower bounds
  have hcont : Continuous (fun ω : Metric.sphere (0 : Euclidean (n + 1)) 1 =>
      x + t • (ω : Euclidean (n + 1))) := by fun_prop
  have hind : ∀ j, Integrable (fun ω : Metric.sphere (0 : Euclidean (n + 1)) 1 =>
      (criticalTube n k j).indicator (1 : Euclidean (n + 1) → ℝ)
        (x + t • (ω : Euclidean (n + 1)))) (unitSurfaceMeasure (n + 1)) := by
    intro j
    apply Integrable.of_bound
      (((measurable_one.indicator (measurableSet_criticalTube n k j)).comp
        hcont.measurable).aestronglyMeasurable) 1
    exact ae_of_all _ fun ω => by
      by_cases h : x + t • (ω : Euclidean (n + 1)) ∈ criticalTube n k j
      · simp [Set.indicator_of_mem h]
      · simp [Set.indicator_of_notMem h]
  have hsum : realSphericalAverage (n + 1) (criticalInput n k m) t x =
      ∑ j ∈ Finset.Ioc k (k + m), criticalAmp n k j *
        realSphericalAverage (n + 1) ((criticalTube n k j).indicator 1) t x := by
    unfold realSphericalAverage criticalInput
    rw [integral_finsetSum _ (fun j _ => (hind j).const_mul _), Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    rw [integral_const_mul]
    ring
  rw [hsum]
  have hσ : 0 < surfaceMass (n + 1) := surfaceMass_pos (by omega)
  have hterm : ∀ j ∈ Finset.Ioc k (k + m),
      surfaceMass n / surfaceMass (n + 1) * (1 / 128) ^ n *
        (2 : ℝ) ^ ((k : ℝ) * (n / (n + 1))) ≤
      criticalAmp n k j * realSphericalAverage (n + 1) ((criticalTube n k j).indicator 1) t x := by
    intro j hj
    obtain ⟨hkj, _⟩ := Finset.mem_Ioc.mp hj
    have hkj' : (k : ℝ) + 1 ≤ j := by exact_mod_cast hkj
    set r := (2 : ℝ) ^ ((k : ℝ) - j) with hr
    have hr0 : 0 < r := by positivity
    have hr1 : r ≤ 1 / 2 := by
      calc r ≤ 2 ^ (-1 : ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
        _ = 1 / 2 := by norm_num
    have hcapm := unitSurfaceMeasure_sphericalCap_real_lower hn (norm_southPole n)
      (h := r / 64) (by positivity) (by linarith)
    have havg := le_realSphericalAverage_of_cap (d := n + 1) (by omega)
      ((criticalTube n k j).indicator 1) t x _
      (measurableSet_sphericalCap n (southPole n) (r / 64))
      zero_le_one (hind j)
      (fun ω => Set.indicator_nonneg (fun _ _ => zero_le_one) _)
      (fun ω hω => by rw [Set.indicator_of_mem (hcap j hj ω hω)]; simp)
    have hlamj := criticalAmp_pos n k j
    have hid := criticalAmp_cap_identity hn1 k j
    rw [← hr] at hid
    have hσn : 0 ≤ surfaceMass n := (surfaceMass_pos (by omega)).le
    calc surfaceMass n / surfaceMass (n + 1) * (1 / 128) ^ n *
          (2 : ℝ) ^ ((k : ℝ) * (n / (n + 1)))
        = criticalAmp n k j * (1 * (surfaceMass n * (r / 64 / 2) ^ n) /
            surfaceMass (n + 1)) := by
          rw [← hid, show r / 64 / 2 = r / 128 by ring, div_pow, div_pow, one_pow]
          field_simp
      _ ≤ criticalAmp n k j * (1 * (unitSurfaceMeasure (n + 1)).real
            (sphericalCap n (southPole n) (r / 64)) / surfaceMass (n + 1)) := by
          gcongr
      _ ≤ _ := mul_le_mul_of_nonneg_left havg hlamj.le
  calc (m : ℝ) * (surfaceMass n / surfaceMass (n + 1) * (1 / 128) ^ n *
        (2 : ℝ) ^ ((k : ℝ) * (n / (n + 1))))
      = ∑ j ∈ Finset.Ioc k (k + m), surfaceMass n / surfaceMass (n + 1) * (1 / 128) ^ n *
          (2 : ℝ) ^ ((k : ℝ) * (n / (n + 1))) := by
        rw [Finset.sum_const, Nat.card_Ioc, add_tsub_cancel_left, nsmul_eq_mul]
    _ ≤ _ := Finset.sum_le_sum hterm

/-- Section 3.2 (`sec:lowerboundpd`), for `d ≥ 2`: `M_{E^μ}` is unbounded on
`L^{d/(d-1)}(|x|^{1-d})` for every `μ > 0`. The test functions are the
corrected second example of the source (see `ErrorReport_fllrs.md`): with `m`
bumps the input moment is `O(m)` (`eq:normfk`) while the output moment is
`≳ m^p` (`eq:Mfknorm`), `p = d/(d-1) > 1`. -/
theorem sequence_critical_unbounded {d : ℕ} (hd : 2 ≤ d) {μ : ℝ} (hμ : 0 < μ) :
    ¬ WeightedMaximalBound d (sequenceSet μ) ((d : ℝ) / ((d : ℝ) - 1)) (1 - (d : ℝ)) := by
  obtain ⟨n, rfl⟩ : ∃ n, d = n + 1 := ⟨d - 1, by omega⟩
  have hn : 1 ≤ n := by omega
  have hn1 : 1 ≤ n := by omega
  have hn' : (0 : ℝ) < n := by exact_mod_cast hn1
  have hpe : ((n + 1 : ℕ) : ℝ) / (((n + 1 : ℕ) : ℝ) - 1) = ((n : ℝ) + 1) / n := by
    push_cast; ring_nf
  have hwe : (1 : ℝ) - ((n + 1 : ℕ) : ℝ) = -(n : ℝ) := by push_cast; ring
  rw [hpe, hwe]
  rintro ⟨C, hC, hb⟩
  set p : ℝ := ((n : ℝ) + 1) / n with hpdef
  have hp1 : 1 < p := by rw [hpdef, lt_div_iff₀ hn']; linarith
  have hp0 : 0 < p := by linarith
  set w := powerWeightedVolume (n + 1) (-(n : ℝ))
  obtain ⟨K, hK, hin⟩ := criticalInput_moment_le hn1
  set c0 : ℝ := surfaceMass n / surfaceMass (n + 1) * (1 / 128) ^ n with hc0
  have hc0pos : 0 < c0 := by
    have := surfaceMass_pos (d := n) (by omega)
    have := surfaceMass_pos (d := n + 1) (by omega)
    positivity
  haveI : Nonempty (Fin n) := ⟨⟨0, by omega⟩⟩
  set Kb : ℝ := Real.sqrt Real.pi ^ n / Real.Gamma (n / 2 + 1) with hKb
  have hKbpos : 0 < Kb := by
    rw [hKb]; exact div_pos (by positivity) (Real.Gamma_pos_of_pos (by positivity))
  set c1 : ℝ := c0 ^ p * (2 : ℝ) ^ (-(n : ℝ)) * (1 / 64) ^ n * Kb / 2 with hc1
  have hc1pos : 0 < c1 := by rw [hc1]; positivity
  -- the main inequality, for every number of bumps
  have hmain : ∀ m : ℕ, 1 ≤ m → ENNReal.ofReal ((m : ℝ) ^ p * c1) ≤
      ENNReal.ofReal C ^ p * (K * m) := by
    intro m hm
    -- choose the spatial scale `k`
    have hT : Tendsto (fun k : ℕ => μ * 2 ^ (μ + 1) * (2 : ℝ) ^ (-((k : ℝ) / μ))) atTop
        (𝓝 0) := by
      have hbase : (2 : ℝ) ^ (-(1 / μ)) < 1 :=
        Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by
          have := one_div_pos.mpr hμ; linarith)
      have hgeo := tendsto_pow_atTop_nhds_zero_of_lt_one (by positivity) hbase
      have heq : (fun k : ℕ => μ * 2 ^ (μ + 1) * (2 : ℝ) ^ (-((k : ℝ) / μ))) =
          fun k : ℕ => μ * 2 ^ (μ + 1) * ((2 : ℝ) ^ (-(1 / μ))) ^ k := by
        funext k
        rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]
        congr 2; ring
      rw [heq]
      simpa using hgeo.const_mul (μ * 2 ^ (μ + 1))
    obtain ⟨k, hk⟩ := ((hT.eventually (gt_mem_nhds (show (0 : ℝ) < (2 : ℝ) ^ (-(m : ℝ)) / 64
      by positivity))).and (eventually_ge_atTop (max 4 m))).exists
    obtain ⟨hη, hkm⟩ := hk
    have hk4 : 4 ≤ k := (le_max_left _ _).trans hkm
    have hmk : m ≤ k := (le_max_right _ _).trans hkm
    -- the test function and its maximal function
    set f : Euclidean (n + 1) → ℂ := fun y => ((criticalInput n k m y : ℝ) : ℂ) with hf
    have hfm : Measurable (fun y => criticalInput n k m y) := by
      unfold criticalInput
      exact Finset.measurable_sum _ (fun j _ =>
        (measurable_one.indicator (measurableSet_criticalTube n k j)).const_mul _)
    have hfmem : MemLp f (ENNReal.ofReal p) w := by
      rw [memLp_iff]
      rw [eLpNorm_eq_eLpNorm' (by simpa using hp0) ENNReal.ofReal_ne_top
        (show AEStronglyMeasurable f w from
          (Complex.measurable_ofReal.comp hfm).aestronglyMeasurable),
        eLpNorm'_eq_lintegral_enorm, ENNReal.toReal_ofReal hp0.le]
      exact ENNReal.rpow_lt_top_of_nonneg (by positivity)
        (ne_top_of_le_ne_top (ENNReal.mul_ne_top hK (by simp)) (hin k m))
    obtain ⟨hMmem, hMbd⟩ := hb f hfmem
    -- moment form of the assumed bound
    have hmom : (∫⁻ x, (_root_.Spherical.M (sequenceSet μ) f x) ^ p ∂w) ≤
        ENNReal.ofReal C ^ p * ∫⁻ x, ‖f x‖ₑ ^ p ∂w := by
      rw [eLpNorm_eq_eLpNorm' (by simpa using hp0) ENNReal.ofReal_ne_top hMmem.aestronglyMeasurable,
        eLpNorm_eq_eLpNorm' (by simpa using hp0) ENNReal.ofReal_ne_top hfmem.aestronglyMeasurable,
        eLpNorm'_eq_lintegral_enorm, eLpNorm'_eq_lintegral_enorm,
        ENNReal.toReal_ofReal hp0.le] at hMbd
      have h := ENNReal.rpow_le_rpow hMbd hp0.le
      rw [← ENNReal.rpow_mul, one_div_mul_cancel hp0.ne', ENNReal.rpow_one,
        ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul,
        one_div_mul_cancel hp0.ne', ENNReal.rpow_one] at h
      simpa only [enorm_eq_self] using h
    -- the slab of centres and the pointwise lower bound
    set q : ℝ := (2 : ℝ) ^ (-(k : ℝ)) with hq
    have hq0 : 0 < q := by positivity
    set V := horizontalSlab n (q / 64) (q / 2) q
    have hVm : MeasurableSet V := measurableSet_horizontalSlab n _ _ _
    set L : ℝ := (m : ℝ) * (c0 * (2 : ℝ) ^ ((k : ℝ) * (n / (n + 1)))) with hL
    have hL0 : 0 ≤ L := by positivity
    have hpoint : ∀ x ∈ V, ENNReal.ofReal (L ^ p) ≤
        (_root_.Spherical.M (sequenceSet μ) f x) ^ p := by
      intro x hx
      obtain ⟨t, ht, havg⟩ := criticalInput_average_lower hn hμ hk4 hmk hη.le hx
      have ht0 : t ∈ sequenceSet μ ∩ Ioi 0 := ⟨ht, sequenceSet_subset_Ioi hμ.le ht⟩
      have hM : ENNReal.ofReal L ≤ _root_.Spherical.M (sequenceSet μ) f x := by
        rw [show _root_.Spherical.M (sequenceSet μ) f = _ from
          restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal _ _]
        refine le_trans ?_ (le_iSup (fun r : ↥(sequenceSet μ ∩ Ioi (0 : ℝ)) =>
          ENNReal.ofReal ‖normalizedSphericalAverage (n + 1) f r.1 x‖) ⟨t, ht0⟩)
        apply ENNReal.ofReal_le_ofReal
        rw [hf, normalizedSphericalAverage_ofReal, Complex.norm_real, Real.norm_eq_abs]
        calc L = (m : ℝ) * (c0 * (2 : ℝ) ^ ((k : ℝ) * (n / (n + 1)))) := hL
          _ ≤ _ := by simpa [hc0, mul_assoc] using havg
          _ ≤ _ := le_abs_self _
      rw [← ENNReal.ofReal_rpow_of_nonneg hL0 hp0.le]
      exact ENNReal.rpow_le_rpow hM hp0.le
    -- the weighted measure of the slab
    have hwV : ENNReal.ofReal ((2 * q) ^ (-(n : ℝ))) *
        (ENNReal.ofReal (q / 64) ^ n * ENNReal.ofReal Kb * ENNReal.ofReal (q / 2)) ≤ w V := by
      have hvol : volume V = ENNReal.ofReal (q / 64) ^ n * ENNReal.ofReal Kb *
          ENNReal.ofReal (q / 2) := by
        rw [volume_horizontalSlab, EuclideanSpace.volume_ball, Fintype.card_fin]
        congr 1; congr 1; ring
      rw [← hvol]
      change _ ≤ (volume.withDensity (radialPowerWeight (n + 1) (-(n : ℝ)))) V
      rw [withDensity_apply _ hVm, ← setLIntegral_const]
      apply setLIntegral_mono' hVm
      intro x hx
      change x ∈ horizontalSlab n (q / 64) (q / 2) q at hx
      rw [horizontalSlab, Set.mem_preimage, Set.mem_prod, Metric.mem_ball, dist_zero_right,
        Set.mem_Ioo] at hx
      have hxn : ‖x‖ ≤ 2 * q := by
        have := norm_le_succCoordinates n x
        rw [abs_of_pos (by linarith [hx.2.1])] at this
        linarith [hx.1, hx.2.2]
      have hxpos : 0 < ‖x‖ := by
        have := norm_sq_succCoordinates n x
        have h2 : 0 < (succCoordinates n x).2 := by linarith [hx.2.1]
        nlinarith [sq_nonneg ‖(succCoordinates n x).1‖, norm_nonneg x]
      unfold radialPowerWeight
      rw [ENNReal.ofReal_rpow_of_pos hxpos]
      exact ENNReal.ofReal_le_ofReal
        (Real.rpow_le_rpow_of_nonpos hxpos hxn (by linarith))
    -- the real identity for the lower bound
    have hreal : (m : ℝ) ^ p * c1 = L ^ p * ((2 * q) ^ (-(n : ℝ)) *
        ((q / 64) ^ n * Kb * (q / 2))) := by
      have hc0' := hc0pos.le
      have h1 : (k : ℝ) * (n / (n + 1)) * p = k := by rw [hpdef]; field_simp
      have hLp : L ^ p = (m : ℝ) ^ p * c0 ^ p * (2 : ℝ) ^ (k : ℝ) := by
        clear_value c0
        rw [hL, Real.mul_rpow (by positivity) (by positivity),
          Real.mul_rpow hc0' (by positivity), ← Real.rpow_mul (by norm_num), h1]
        ring
      have h2 : (2 : ℝ) ^ (k : ℝ) = q⁻¹ := by
        rw [hq, Real.rpow_neg (by norm_num), inv_inv]
      have h3 : (2 * q) ^ (-(n : ℝ)) = (2 : ℝ) ^ (-(n : ℝ)) * (q ^ n)⁻¹ := by
        rw [Real.mul_rpow (by norm_num) hq0.le, Real.rpow_neg hq0.le, Real.rpow_natCast]
      clear_value c0 Kb
      rw [hLp, h2, h3, hc1, div_pow, div_pow, one_pow]
      field_simp
    have hsplit : ENNReal.ofReal ((m : ℝ) ^ p * c1) = ENNReal.ofReal (L ^ p) *
        (ENNReal.ofReal ((2 * q) ^ (-(n : ℝ))) *
          (ENNReal.ofReal (q / 64) ^ n * ENNReal.ofReal Kb * ENNReal.ofReal (q / 2))) := by
      rw [hreal, ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity),
        ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity),
        ENNReal.ofReal_pow (by positivity)]
    calc ENNReal.ofReal ((m : ℝ) ^ p * c1)
        ≤ ENNReal.ofReal (L ^ p) * w V := by rw [hsplit]; gcongr
      _ = ∫⁻ x in V, ENNReal.ofReal (L ^ p) ∂w := (setLIntegral_const _ _).symm
      _ ≤ ∫⁻ x in V, (_root_.Spherical.M (sequenceSet μ) f x) ^ p ∂w :=
          setLIntegral_mono' hVm hpoint
      _ ≤ ∫⁻ x, (_root_.Spherical.M (sequenceSet μ) f x) ^ p ∂w :=
          setLIntegral_le_lintegral _ _
      _ ≤ ENNReal.ofReal C ^ p * ∫⁻ x, ‖f x‖ₑ ^ p ∂w := hmom
      _ ≤ ENNReal.ofReal C ^ p * (K * m) := mul_le_mul' le_rfl (hin k m)
  -- `m^p ≲ m` for all `m` contradicts `p > 1`
  set K' : ℝ := C ^ p * K.toReal with hK'
  have hreal : ∀ m : ℕ, 1 ≤ m → (m : ℝ) ^ p * c1 ≤ K' * m := by
    intro m hm
    have h := hmain m hm
    rw [← ENNReal.ofReal_toReal hK, ← ENNReal.ofReal_natCast,
      ← ENNReal.ofReal_mul ENNReal.toReal_nonneg,
      ENNReal.ofReal_rpow_of_nonneg hC.le hp0.le,
      ← ENNReal.ofReal_mul (Real.rpow_nonneg hC.le _)] at h
    have := (ENNReal.ofReal_le_ofReal_iff (by positivity)).mp h
    rw [hK']; linarith
  have htend : Tendsto (fun m : ℕ => (m : ℝ) ^ (p - 1)) atTop atTop :=
    (tendsto_rpow_atTop (by linarith)).comp tendsto_natCast_atTop_atTop
  obtain ⟨m, hm⟩ := ((htend.eventually_gt_atTop (K' / c1)).and
    (eventually_ge_atTop 1)).exists
  obtain ⟨hbig, hm1⟩ := hm
  have hm0 : (0 : ℝ) < m := by exact_mod_cast hm1
  have h := hreal m hm1
  have hpow : (m : ℝ) ^ p = (m : ℝ) ^ (p - 1) * m := by
    rw [← Real.rpow_add_one hm0.ne']; ring_nf
  rw [div_lt_iff₀ hc1pos] at hbig
  rw [hpow] at h
  have h' : ((m : ℝ) ^ (p - 1) * c1) * m ≤ K' * m := by linarith
  have := le_of_mul_le_mul_right h' hm0
  linarith

/-! ## Section 3.3: the global operator at `α = U(p)` -/

/-- The global dilation set `𝓔^μ = ⋃_{k ∈ ℤ} 2^k E^μ` (introduction, line 906). -/
def globalSequenceSet (μ : ℝ) : Set ℝ :=
  {t | ∃ k : ℤ, ∃ s ∈ sequenceSet μ, t = (2 : ℝ) ^ k * s}

theorem sequenceSet_subset_global (μ : ℝ) : sequenceSet μ ⊆ globalSequenceSet μ :=
  fun s hs => ⟨0, s, hs, by simp⟩

/-- A sphere of radius `t ≥ 1` whose centre lies within `1/100` of distance `t`
from the origin meets the unit ball in a cap of chordal radius `1/(2t)`; hence
the average of `1_{B(0,1)}` is at least `σ_n (4t)^{-n}/σ_{n+1}`. -/
theorem realSphericalAverage_unitBall_lower {n : ℕ} (hn : 1 ≤ n) {t : ℝ} (ht : 1 ≤ t)
    {x : Euclidean (n + 1)} (hx : |‖x‖ - t| < 1 / 100) :
    surfaceMass n * (1 / (4 * t)) ^ n / surfaceMass (n + 1) ≤
      realSphericalAverage (n + 1) ((Metric.closedBall (0 : Euclidean (n + 1)) 1).indicator 1)
        t x := by
  have hxpos : 0 < ‖x‖ := by linarith [(abs_lt.mp hx).1]
  set v : Euclidean (n + 1) := -(‖x‖⁻¹ • x) with hv
  have hvn : ‖v‖ = 1 := by
    rw [hv, norm_neg, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hxpos.ne']
  set h : ℝ := 1 / (2 * t) with hh
  have hh0 : 0 < h := by positivity
  have hh1 : h ≤ 1 := by rw [hh, div_le_one (by positivity)]; linarith
  have hcont : Continuous (fun ω : Metric.sphere (0 : Euclidean (n + 1)) 1 =>
      x + t • (ω : Euclidean (n + 1))) := by fun_prop
  have hint : Integrable (fun ω : Metric.sphere (0 : Euclidean (n + 1)) 1 =>
      (Metric.closedBall (0 : Euclidean (n + 1)) 1).indicator (1 : Euclidean (n + 1) → ℝ)
        (x + t • (ω : Euclidean (n + 1)))) (unitSurfaceMeasure (n + 1)) := by
    apply Integrable.of_bound
      (((measurable_one.indicator measurableSet_closedBall).comp
        hcont.measurable).aestronglyMeasurable) 1
    exact ae_of_all _ fun ω => by
      by_cases hω : x + t • (ω : Euclidean (n + 1)) ∈ Metric.closedBall (0 : Euclidean (n + 1)) 1
      · simp [Set.indicator_of_mem hω]
      · simp [Set.indicator_of_notMem hω]
  have hcap : ∀ ω ∈ sphericalCap n v h, x + t • (ω : Euclidean (n + 1)) ∈
      Metric.closedBall (0 : Euclidean (n + 1)) 1 := by
    intro ω hω
    have hω' : ‖(ω : Euclidean (n + 1)) - v‖ < h := by
      simpa [sphericalCap, dist_eq_norm] using hω
    have hdecomp : x + t • (ω : Euclidean (n + 1)) =
        (1 - t / ‖x‖) • x + t • ((ω : Euclidean (n + 1)) - v) := by
      rw [hv, smul_sub, smul_neg, sub_neg_eq_add, smul_smul, sub_smul, one_smul]
      field_simp
      abel
    rw [Metric.mem_closedBall, dist_zero_right, hdecomp]
    calc ‖(1 - t / ‖x‖) • x + t • ((ω : Euclidean (n + 1)) - v)‖
        ≤ ‖(1 - t / ‖x‖) • x‖ + ‖t • ((ω : Euclidean (n + 1)) - v)‖ := norm_add_le _ _
      _ = |‖x‖ - t| + t * ‖(ω : Euclidean (n + 1)) - v‖ := by
          rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_of_nonneg (by linarith)]
          congr 1
          rw [← abs_of_pos hxpos, ← abs_mul, abs_of_pos hxpos]
          congr 1; field_simp
      _ ≤ 1 / 100 + t * h := by gcongr
      _ ≤ 1 := by rw [hh]; field_simp; linarith
  have havg := le_realSphericalAverage_of_cap (d := n + 1) (by omega)
    ((Metric.closedBall (0 : Euclidean (n + 1)) 1).indicator 1) t x _
    (measurableSet_sphericalCap n v h) zero_le_one hint
    (fun ω => Set.indicator_nonneg (fun _ _ => zero_le_one) _)
    (fun ω hω => by rw [Set.indicator_of_mem (hcap ω hω)]; simp)
  have hcapm := unitSurfaceMeasure_sphericalCap_real_lower (by omega) hvn hh0 hh1
  have hσ : 0 < surfaceMass (n + 1) := surfaceMass_pos (by omega)
  calc surfaceMass n * (1 / (4 * t)) ^ n / surfaceMass (n + 1)
      = 1 * (surfaceMass n * (h / 2) ^ n) / surfaceMass (n + 1) := by
        rw [hh]; congr 1; field_simp; ring
    _ ≤ 1 * (unitSurfaceMeasure (n + 1)).real (sphericalCap n v h) / surfaceMass (n + 1) := by
        gcongr
    _ ≤ _ := havg

/-- Volume of a thin spherical shell: `vol{r - ε < |x| < r + ε} ≥ V_d 2ε (r-ε)^{d-1}`,
with `V_d` the volume of the unit ball. -/
theorem volume_shell_lower {n : ℕ} {r ε : ℝ} (hε : 0 < ε) (hεr : ε ≤ r) :
    ENNReal.ofReal (Real.sqrt Real.pi ^ (n + 1) / Real.Gamma ((n + 1 : ℕ) / 2 + 1) *
      (2 * ε * (r - ε) ^ n)) ≤
      volume (Metric.ball (0 : Euclidean (n + 1)) (r + ε) \
        Metric.closedBall (0 : Euclidean (n + 1)) (r - ε)) := by
  set V : ℝ := Real.sqrt Real.pi ^ (n + 1) / Real.Gamma ((n + 1 : ℕ) / 2 + 1)
  have hV : 0 ≤ V := div_nonneg (by positivity) (Real.Gamma_pos_of_pos (by positivity)).le
  have hsub : Metric.closedBall (0 : Euclidean (n + 1)) (r - ε) ⊆
      Metric.ball (0 : Euclidean (n + 1)) (r + ε) :=
    Metric.closedBall_subset_ball (by linarith)
  rw [measure_sdiff hsub measurableSet_closedBall.nullMeasurableSet
      (measure_ne_top_of_subset hsub (measure_ball_lt_top).ne),
    EuclideanSpace.volume_ball, EuclideanSpace.volume_closedBall, Fintype.card_fin]
  have hab : (r - ε) ^ (n + 1) + 2 * ε * (r - ε) ^ n ≤ (r + ε) ^ (n + 1) := by
    have h1 : (r - ε) ^ (n + 1) + 2 * ε * (r - ε) ^ n = (r - ε) ^ n * (r + ε) := by ring
    rw [h1, pow_succ]
    exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (by linarith) (by linarith) n)
      (by linarith)
  rw [← ENNReal.ofReal_pow (by linarith), ← ENNReal.ofReal_pow (by linarith),
    ← ENNReal.ofReal_mul (pow_nonneg (by linarith) _), ← ENNReal.ofReal_mul (pow_nonneg (by linarith) _),
    ← ENNReal.ofReal_sub _ (by positivity)]
  apply ENNReal.ofReal_le_ofReal
  have : V * (2 * ε * (r - ε) ^ n) ≤ V * ((r + ε) ^ (n + 1) - (r - ε) ^ (n + 1)) :=
    mul_le_mul_of_nonneg_left (by linarith) hV
  linarith

/-- The radii `r_{k,j} = 2^k (1 + j^{-μ})` of the global set and the thin shells
of half-width `1/200` around them (Section 3.3). -/
def globalShell (n : ℕ) (μ : ℝ) (k j : ℕ) : Set (Euclidean (n + 1)) :=
  Metric.ball 0 ((2 : ℝ) ^ k * (1 + (j : ℝ) ^ (-μ)) + 1 / 200) \
    Metric.closedBall 0 ((2 : ℝ) ^ k * (1 + (j : ℝ) ^ (-μ)) - 1 / 200)

/-- The number of well-separated radii at scale `2^k`. -/
def globalShellCount (μ : ℝ) (k : ℕ) : ℕ := ⌊(100 * μ * (2 : ℝ) ^ k) ^ (1 / (μ + 1))⌋₊ - 1

/-- Consecutive admissible radii at scale `2^k` are at least `1/100` apart, so
the shells are disjoint. -/
theorem globalShell_disjoint {n : ℕ} {μ : ℝ} (hμ : 0 < μ) (k : ℕ) {j j' : ℕ}
    (hj : 1 ≤ j) (hjj' : j < j') (hj' : j' ≤ globalShellCount μ k) :
    Disjoint (globalShell n μ k j) (globalShell n μ k j') := by
  have hμ1 : 0 < μ + 1 := by linarith
  set N := globalShellCount μ k
  have hj1 : (j : ℝ) + 1 ≤ (100 * μ * (2 : ℝ) ^ k) ^ (1 / (μ + 1)) := by
    have h1 : j + 1 ≤ N + 1 := by omega
    have h2 : N + 1 ≤ ⌊(100 * μ * (2 : ℝ) ^ k) ^ (1 / (μ + 1))⌋₊ := by
      have : 0 < j' := by omega
      unfold N globalShellCount at hj' ⊢; omega
    have h3 := Nat.floor_le (show (0 : ℝ) ≤ (100 * μ * (2 : ℝ) ^ k) ^ (1 / (μ + 1)) by
      positivity)
    have : ((j + 1 : ℕ) : ℝ) ≤ ⌊(100 * μ * (2 : ℝ) ^ k) ^ (1 / (μ + 1))⌋₊ := by
      exact_mod_cast h1.trans h2
    push_cast at this; linarith
  -- the gap between the radii
  obtain ⟨hgap, -⟩ := sequenceSet_gap_bounds hμ hj
  have hpow : ((j : ℝ) + 1) ^ (μ + 1) ≤ 100 * μ * (2 : ℝ) ^ k := by
    have := Real.rpow_le_rpow (by positivity) hj1 hμ1.le
    rwa [← Real.rpow_mul (by positivity), one_div_mul_cancel hμ1.ne', Real.rpow_one] at this
  have hinv : (1 : ℝ) / 100 ≤ (2 : ℝ) ^ k * (μ * ((j : ℝ) + 1) ^ (-μ - 1)) := by
    rw [show -μ - 1 = -(μ + 1) by ring, Real.rpow_neg (by positivity)]
    have hpos : 0 < ((j : ℝ) + 1) ^ (μ + 1) := by positivity
    have heq : (2 : ℝ) ^ k * (μ * (((j : ℝ) + 1) ^ (μ + 1))⁻¹) =
        μ * (2 : ℝ) ^ k / ((j : ℝ) + 1) ^ (μ + 1) := by field_simp
    rw [heq, le_div_iff₀ hpos]
    linarith
  have hmono : (j' : ℝ) ^ (-μ) ≤ ((j : ℝ) + 1) ^ (-μ) := by
    apply Real.rpow_le_rpow_of_nonpos (by positivity) _ (by linarith)
    have : j + 1 ≤ j' := hjj'
    exact_mod_cast this
  have hsep : (2 : ℝ) ^ k * (1 + (j' : ℝ) ^ (-μ)) + 1 / 200 ≤
      (2 : ℝ) ^ k * (1 + (j : ℝ) ^ (-μ)) - 1 / 200 := by
    have h2k : (0 : ℝ) < 2 ^ k := by positivity
    nlinarith [mul_le_mul_of_nonneg_left hgap h2k.le, mul_le_mul_of_nonneg_left hmono h2k.le]
  rw [Set.disjoint_left]
  intro x hx hx'
  have h1 : (2 : ℝ) ^ k * (1 + (j : ℝ) ^ (-μ)) - 1 / 200 < ‖x‖ := by
    have := hx.2; simpa [Metric.mem_closedBall, dist_zero_right, not_le] using this
  have h2 : ‖x‖ < (2 : ℝ) ^ k * (1 + (j' : ℝ) ^ (-μ)) + 1 / 200 := by
    simpa [Metric.mem_ball, dist_zero_right] using hx'.1
  linarith

/-- Lower bound for the shell count: `N_k ≥ (100μ)^{1/(μ+1)} 2^{k/(μ+1)} / 2` once
the right side is at least `2`. -/
theorem globalShellCount_lower {μ : ℝ} (hμ : 0 < μ) {k : ℕ}
    (hk : 4 ≤ (100 * μ * (2 : ℝ) ^ k) ^ (1 / (μ + 1))) :
    (100 * μ * (2 : ℝ) ^ k) ^ (1 / (μ + 1)) / 2 ≤ globalShellCount μ k := by
  unfold globalShellCount
  set x := (100 * μ * (2 : ℝ) ^ k) ^ (1 / (μ + 1))
  have h1 := Nat.lt_floor_add_one x
  have h2 : 1 ≤ ⌊x⌋₊ := Nat.le_floor (by norm_num; linarith)
  rw [Nat.cast_sub h2]
  push_cast
  linarith

/-- Section 3.3, one shell: the global maximal function of `1_{B(0,1)}` is at
least `c 2^{-kn}` on the shell of radius `r_{k,j}`, which has weighted measure
`≳ 2^{k(α+n)}`. -/
theorem globalShell_moment_lower {n : ℕ} (hn : 1 ≤ n) {μ p α : ℝ} (hμ : 0 < μ) (hp : 0 < p)
    (hα : 0 ≤ α) {k j : ℕ} (hk : 1 ≤ k) (hj : 1 ≤ j) :
    ENNReal.ofReal ((surfaceMass n * (1 / 8) ^ n / surfaceMass (n + 1)) ^ p *
        (Real.sqrt Real.pi ^ (n + 1) / Real.Gamma ((n + 1 : ℕ) / 2 + 1) / 100) *
        (1 / 2) ^ (α + n) * (2 : ℝ) ^ ((k : ℝ) * (α + n - n * p))) ≤
      ∫⁻ x in globalShell n μ k j,
        (_root_.Spherical.M (globalSequenceSet μ)
          (fun y => (((Metric.closedBall (0 : Euclidean (n + 1)) 1).indicator 1 y : ℝ) : ℂ))
          x) ^ p ∂powerWeightedVolume (n + 1) α := by
  set r : ℝ := (2 : ℝ) ^ k * (1 + (j : ℝ) ^ (-μ)) with hr
  have hjm := rpow_neg_mem_Ioc hμ.le hj
  have h2k : (2 : ℝ) ≤ 2 ^ k := by
    calc (2 : ℝ) = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ k := pow_le_pow_right₀ (by norm_num) hk
  have hr1 : 2 ^ k ≤ r := by rw [hr]; nlinarith [hjm.1]
  have hr2 : r ≤ 2 ^ (k + 1) := by rw [hr, pow_succ]; nlinarith [hjm.2]
  have hrmem : r ∈ globalSequenceSet μ ∩ Ioi 0 :=
    ⟨⟨k, 1 + (j : ℝ) ^ (-μ), ⟨j, hj, rfl⟩, by rw [hr]; norm_cast⟩, by
      show (0 : ℝ) < r; linarith⟩
  set c3 : ℝ := surfaceMass n * (1 / 8) ^ n / surfaceMass (n + 1) with hc3
  have hσ : 0 < surfaceMass (n + 1) := surfaceMass_pos (by omega)
  have hσn : 0 < surfaceMass n := surfaceMass_pos (by omega)
  have hc3pos : 0 < c3 := by rw [hc3]; positivity
  -- pointwise lower bound on the shell
  have hpoint : ∀ x ∈ globalShell n μ k j, ENNReal.ofReal ((c3 * (2 : ℝ) ^ (-(k * n : ℝ))) ^ p) ≤
      (_root_.Spherical.M (globalSequenceSet μ)
        (fun y => (((Metric.closedBall (0 : Euclidean (n + 1)) 1).indicator 1 y : ℝ) : ℂ))
        x) ^ p := by
    intro x hx
    have hx1 : r - 1 / 200 < ‖x‖ := by
      have := hx.2; simpa [Metric.mem_closedBall, dist_zero_right, not_le] using this
    have hx2 : ‖x‖ < r + 1 / 200 := by simpa [Metric.mem_ball, dist_zero_right] using hx.1
    have hxr : |‖x‖ - r| < 1 / 100 := abs_lt.mpr ⟨by linarith, by linarith⟩
    have havg := realSphericalAverage_unitBall_lower hn (by linarith) hxr
    have hlow : c3 * (2 : ℝ) ^ (-(k * n : ℝ)) ≤
        surfaceMass n * (1 / (4 * r)) ^ n / surfaceMass (n + 1) := by
      rw [hc3, div_mul_eq_mul_div, div_le_div_iff_of_pos_right hσ, mul_assoc]
      apply mul_le_mul_of_nonneg_left _ hσn.le
      have h4r : 4 * r ≤ 8 * 2 ^ k := by rw [pow_succ] at hr2; linarith
      have : (1 / 8 : ℝ) ^ n * (2 : ℝ) ^ (-(k * n : ℝ)) = (1 / (8 * 2 ^ k)) ^ n := by
        rw [Real.rpow_neg (by norm_num),
          show ((k : ℝ) * n) = ((k * n : ℕ) : ℝ) by push_cast; ring, Real.rpow_natCast,
          pow_mul, ← inv_pow, ← mul_pow]
        congr 1
        field_simp
      rw [this]
      exact pow_le_pow_left₀ (by positivity)
        (one_div_le_one_div_of_le (by positivity) h4r) n
    have hM : ENNReal.ofReal (c3 * (2 : ℝ) ^ (-(k * n : ℝ))) ≤
        _root_.Spherical.M (globalSequenceSet μ)
          (fun y => (((Metric.closedBall (0 : Euclidean (n + 1)) 1).indicator 1 y : ℝ) : ℂ)) x := by
      rw [show _root_.Spherical.M (globalSequenceSet μ) _ = _ from
        restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal _ _]
      refine le_trans ?_ (le_iSup (fun t : ↥(globalSequenceSet μ ∩ Ioi (0 : ℝ)) =>
        ENNReal.ofReal ‖normalizedSphericalAverage (n + 1) _ t.1 x‖) ⟨r, hrmem⟩)
      apply ENNReal.ofReal_le_ofReal
      rw [normalizedSphericalAverage_ofReal, Complex.norm_real, Real.norm_eq_abs]
      exact (hlow.trans havg).trans (le_abs_self _)
    rw [← ENNReal.ofReal_rpow_of_nonneg (by positivity) hp.le]
    exact ENNReal.rpow_le_rpow hM hp.le
  -- the weighted measure of the shell
  set V : ℝ := Real.sqrt Real.pi ^ (n + 1) / Real.Gamma ((n + 1 : ℕ) / 2 + 1) with hV
  have hV0 : 0 ≤ V := div_nonneg (by positivity) (Real.Gamma_pos_of_pos (by positivity)).le
  have hS : MeasurableSet (globalShell n μ k j) :=
    measurableSet_ball.diff measurableSet_closedBall
  have hrε : 2 ^ (k - 1 : ℕ) ≤ r - 1 / 200 := by
    have : (2 : ℝ) ^ (k - 1 : ℕ) * 2 = 2 ^ k := by rw [← pow_succ, Nat.sub_add_cancel hk]
    linarith
  have hwS : ENNReal.ofReal (((2 : ℝ) ^ (k - 1 : ℕ)) ^ α * (V / 100 *
      ((2 : ℝ) ^ (k - 1 : ℕ)) ^ n)) ≤ powerWeightedVolume (n + 1) α (globalShell n μ k j) := by
    have hvol := volume_shell_lower (n := n) (r := r) (ε := 1 / 200) (by norm_num)
      (by linarith)
    change _ ≤ (volume.withDensity (radialPowerWeight (n + 1) α)) _
    rw [withDensity_apply _ hS]
    calc ENNReal.ofReal (((2 : ℝ) ^ (k - 1 : ℕ)) ^ α * (V / 100 * ((2 : ℝ) ^ (k - 1 : ℕ)) ^ n))
        ≤ ENNReal.ofReal (((2 : ℝ) ^ (k - 1 : ℕ)) ^ α) *
            volume (globalShell n μ k j) := by
          rw [ENNReal.ofReal_mul (by positivity)]
          gcongr
          refine le_trans (ENNReal.ofReal_le_ofReal ?_) hvol
          rw [← hV]
          have : (2 : ℝ) ^ (k - 1 : ℕ) ≤ r - 1 / 200 := hrε
          have := pow_le_pow_left₀ (by positivity) this n
          nlinarith
      _ = ∫⁻ x in globalShell n μ k j, ENNReal.ofReal (((2 : ℝ) ^ (k - 1 : ℕ)) ^ α) :=
          (setLIntegral_const _ _).symm
      _ ≤ ∫⁻ x in globalShell n μ k j, radialPowerWeight (n + 1) α x := by
          apply setLIntegral_mono' hS
          intro x hx
          have hx1 : r - 1 / 200 < ‖x‖ := by
            have := hx.2; simpa [Metric.mem_closedBall, dist_zero_right, not_le] using this
          have h2pos : (0 : ℝ) < 2 ^ (k - 1 : ℕ) := by positivity
          unfold radialPowerWeight
          rw [ENNReal.ofReal_rpow_of_pos (by linarith)]
          exact ENNReal.ofReal_le_ofReal (Real.rpow_le_rpow h2pos.le (by linarith) hα)
  -- combine
  calc ENNReal.ofReal (c3 ^ p * (V / 100) * (1 / 2) ^ (α + n) *
        (2 : ℝ) ^ ((k : ℝ) * (α + n - n * p)))
      = ENNReal.ofReal ((c3 * (2 : ℝ) ^ (-(k * n : ℝ))) ^ p) *
          ENNReal.ofReal (((2 : ℝ) ^ (k - 1 : ℕ)) ^ α * (V / 100 *
            ((2 : ℝ) ^ (k - 1 : ℕ)) ^ n)) := by
        rw [← ENNReal.ofReal_mul (by positivity)]
        congr 1
        have hk1 : ((k - 1 : ℕ) : ℝ) = k - 1 := by rw [Nat.cast_sub hk]; simp
        clear_value c3 V
        rw [Real.mul_rpow hc3pos.le (by positivity), ← Real.rpow_mul (by norm_num),
          ← Real.rpow_natCast (2 : ℝ) (k - 1), ← Real.rpow_mul (by norm_num),
          ← Real.rpow_natCast ((2 : ℝ) ^ ((k - 1 : ℕ) : ℝ)) n, ← Real.rpow_mul (by norm_num),
          hk1, show (1 / 2 : ℝ) ^ (α + n) = (2 : ℝ) ^ (-(α + n)) by
            rw [Real.rpow_neg (by norm_num), one_div, Real.inv_rpow (by norm_num)]]
        have e1 : (2 : ℝ) ^ (-(α + n)) * (2 : ℝ) ^ ((k : ℝ) * (α + n - n * p)) =
            (2 : ℝ) ^ (-(k * n : ℝ) * p) * ((2 : ℝ) ^ (((k : ℝ) - 1) * α) *
              (2 : ℝ) ^ (((k : ℝ) - 1) * n)) := by
          rw [← Real.rpow_add (by norm_num), ← Real.rpow_add (by norm_num),
            ← Real.rpow_add (by norm_num)]
          congr 1; ring
        linear_combination (c3 ^ p * (V / 100)) * e1
    _ ≤ ∫⁻ x in globalShell n μ k j, ENNReal.ofReal ((c3 * (2 : ℝ) ^ (-(k * n : ℝ))) ^ p)
          ∂powerWeightedVolume (n + 1) α := by
        rw [setLIntegral_const]; exact mul_le_mul' le_rfl hwS
    _ ≤ _ := setLIntegral_mono' hS hpoint

/-- The shells at scale `2^k` lie in the annulus `2^k - 1/200 < |x| < 2^{k+1} + 1/200`. -/
theorem globalShell_subset {n : ℕ} {μ : ℝ} (hμ : 0 < μ) {k j : ℕ} (hj : 1 ≤ j)
    {x : Euclidean (n + 1)} (hx : x ∈ globalShell n μ k j) :
    (2 : ℝ) ^ k - 1 / 200 < ‖x‖ ∧ ‖x‖ < (2 : ℝ) ^ (k + 1) + 1 / 200 := by
  have hjm := rpow_neg_mem_Ioc hμ.le hj
  have h2k : (0 : ℝ) < 2 ^ k := by positivity
  have hx1 : (2 : ℝ) ^ k * (1 + (j : ℝ) ^ (-μ)) - 1 / 200 < ‖x‖ := by
    have := hx.2; simpa [Metric.mem_closedBall, dist_zero_right, not_le] using this
  have hx2 : ‖x‖ < (2 : ℝ) ^ k * (1 + (j : ℝ) ^ (-μ)) + 1 / 200 := by
    simpa [Metric.mem_ball, dist_zero_right] using hx.1
  constructor
  · nlinarith [hjm.1]
  · rw [pow_succ]; nlinarith [hjm.2]

/-- Section 3.3: for `d ≥ 2` and `p > p(μ)`, the global maximal operator
`M_{𝓔^μ}` is unbounded on `L^p(|x|^{U(p)})`. Each dyadic scale `2^k` carries
`≈ 2^{k/(μ+1)}` disjoint shells, each contributing `≳ 2^{-k/(μ+1)}` to the
weighted moment of `M 1_{B(0,1)}`, so every scale contributes a fixed amount. -/
theorem global_sequence_unbounded_upper {d : ℕ} (hd : 2 ≤ d) {μ p : ℝ} (hμ : 0 < μ)
    (hp : sequenceCriticalExponent d μ < p) :
    ¬ WeightedMaximalBound d (globalSequenceSet μ) p (sequenceUpperEndpoint d μ p) := by
  obtain ⟨n, rfl⟩ : ∃ n, d = n + 1 := ⟨d - 1, by omega⟩
  have hn : 1 ≤ n := by omega
  have hn' : (0 : ℝ) < n := by exact_mod_cast (show 0 < n by omega)
  have hμ1 : 0 < μ + 1 := by linarith
  have hcast : ((n + 1 : ℕ) : ℝ) - 1 = n := by push_cast; ring
  set α := sequenceUpperEndpoint (n + 1) μ p with hαdef
  have hαeq : α = n * (p - 1) - 1 / (μ + 1) := by rw [hαdef, sequenceUpperEndpoint, hcast]
  have hα0 : 0 < α := by
    rw [hαeq]
    unfold sequenceCriticalExponent at hp
    rw [hcast] at hp
    have h1 : 1 / ((μ + 1) * n) < p - 1 := by linarith
    rw [div_lt_iff₀ (by positivity)] at h1
    have : 1 / (μ + 1) < n * (p - 1) := by
      rw [div_lt_iff₀ hμ1]; nlinarith
    linarith
  have hp1 : 1 < p := by
    have : 0 < n * (p - 1) := by have := one_div_pos.mpr hμ1; rw [hαeq] at hα0; linarith
    by_contra h; push_neg at h; nlinarith
  have hp0 : 0 < p := by linarith
  have hexp0 : α + n - n * p = -(1 / (μ + 1)) := by rw [hαeq]; ring
  rintro ⟨C, hC, hb⟩
  set w := powerWeightedVolume (n + 1) α
  set B := Metric.closedBall (0 : Euclidean (n + 1)) 1
  set f : Euclidean (n + 1) → ℂ := fun y => ((B.indicator 1 y : ℝ) : ℂ) with hf
  have hfm : Measurable f :=
    Complex.measurable_ofReal.comp (measurable_one.indicator measurableSet_closedBall)
  have hfp : ∀ y, ‖f y‖ₑ ^ p = B.indicator 1 y := by
    intro y
    by_cases hy : y ∈ B
    · simp [hf, Set.indicator_of_mem hy]
    · simp [hf, Set.indicator_of_notMem hy, ENNReal.zero_rpow_of_pos hp0]
  have hfint : (∫⁻ y, ‖f y‖ₑ ^ p ∂w) = w B := by
    simp_rw [hfp]; rw [lintegral_indicator_one measurableSet_closedBall]
  have hwB : w B < ∞ := powerWeightedVolume_closedBall_lt_top hα0.le
  have hfmem : MemLp f (ENNReal.ofReal p) w := by
    rw [memLp_iff, eLpNorm_eq_eLpNorm' (by simpa using hp0) ENNReal.ofReal_ne_top
      hfm.aestronglyMeasurable, eLpNorm'_eq_lintegral_enorm, ENNReal.toReal_ofReal hp0.le,
      hfint]
    exact ENNReal.rpow_lt_top_of_nonneg (by positivity) hwB.ne
  obtain ⟨hMmem, hMbd⟩ := hb f hfmem
  have hmom : (∫⁻ x, (_root_.Spherical.M (globalSequenceSet μ) f x) ^ p ∂w) ≤
      ENNReal.ofReal C ^ p * w B := by
    rw [eLpNorm_eq_eLpNorm' (by simpa using hp0) ENNReal.ofReal_ne_top
        hMmem.aestronglyMeasurable,
      eLpNorm_eq_eLpNorm' (by simpa using hp0) ENNReal.ofReal_ne_top hfmem.aestronglyMeasurable,
      eLpNorm'_eq_lintegral_enorm, eLpNorm'_eq_lintegral_enorm,
      ENNReal.toReal_ofReal hp0.le] at hMbd
    have h := ENNReal.rpow_le_rpow hMbd hp0.le
    rw [← ENNReal.rpow_mul, one_div_mul_cancel hp0.ne', ENNReal.rpow_one,
      ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul,
      one_div_mul_cancel hp0.ne', ENNReal.rpow_one, hfint] at h
    simpa only [enorm_eq_self] using h
  set G := fun x => (_root_.Spherical.M (globalSequenceSet μ) f x) ^ p
  -- the contribution of one scale
  set c4 : ℝ := (surfaceMass n * (1 / 8) ^ n / surfaceMass (n + 1)) ^ p *
    (Real.sqrt Real.pi ^ (n + 1) / Real.Gamma ((n + 1 : ℕ) / 2 + 1) / 100) *
    (1 / 2) ^ (α + n) with hc4
  have hc4pos : 0 < c4 := by
    have := surfaceMass_pos (d := n) (by omega)
    have := surfaceMass_pos (d := n + 1) (by omega)
    have := Real.Gamma_pos_of_pos (show (0 : ℝ) < ((n + 1 : ℕ) : ℝ) / 2 + 1 by positivity)
    rw [hc4]; positivity
  set c5 : ℝ := c4 * ((100 * μ) ^ (1 / (μ + 1)) / 2) with hc5
  have hc5pos : 0 < c5 := by rw [hc5]; positivity
  have hT : Tendsto (fun k : ℕ => (100 * μ * (2 : ℝ) ^ k) ^ (1 / (μ + 1))) atTop atTop := by
    have h1 : Tendsto (fun k : ℕ => 100 * μ * (2 : ℝ) ^ k) atTop atTop :=
      Tendsto.const_mul_atTop (by positivity)
        (tendsto_pow_atTop_atTop_of_one_lt (by norm_num))
    exact (tendsto_rpow_atTop (by positivity)).comp h1
  obtain ⟨k₁, hk₁⟩ := ((hT.eventually_ge_atTop 4).and (eventually_ge_atTop 1)).exists_forall_of_atTop
  have hscale : ∀ k, k₁ ≤ k → ENNReal.ofReal c5 ≤
      ∫⁻ x in ⋃ j ∈ Finset.Icc 1 (globalShellCount μ k), globalShell n μ k j, G x ∂w := by
    intro k hk
    obtain ⟨hk4, hk1⟩ := hk₁ k hk
    have hdisj : Set.PairwiseDisjoint (↑(Finset.Icc 1 (globalShellCount μ k)))
        (globalShell n μ k) := by
      intro j hj j' hj' hne
      simp only [Finset.coe_Icc, Set.mem_Icc] at hj hj'
      rcases lt_or_gt_of_ne hne with h | h
      · exact globalShell_disjoint hμ k hj.1 h hj'.2
      · exact (globalShell_disjoint hμ k hj'.1 h hj.2).symm
    rw [lintegral_biUnion_finset hdisj (fun j _ => measurableSet_ball.diff measurableSet_closedBall)]
    have hshell : ∀ j ∈ Finset.Icc 1 (globalShellCount μ k),
        ENNReal.ofReal (c4 * (2 : ℝ) ^ ((k : ℝ) * (α + n - n * p))) ≤
          ∫⁻ x in globalShell n μ k j, G x ∂w :=
      fun j hj => globalShell_moment_lower hn hμ hp0 hα0.le hk1 (Finset.mem_Icc.mp hj).1
    refine le_trans ?_ (Finset.sum_le_sum hshell)
    rw [Finset.sum_const, Nat.card_Icc, add_tsub_cancel_right, nsmul_eq_mul,
      ← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (Nat.cast_nonneg _)]
    apply ENNReal.ofReal_le_ofReal
    have hN := globalShellCount_lower hμ hk4
    have hsplit : (100 * μ * (2 : ℝ) ^ k) ^ (1 / (μ + 1)) =
        (100 * μ) ^ (1 / (μ + 1)) * (2 : ℝ) ^ ((k : ℝ) * (1 / (μ + 1))) := by
      rw [Real.mul_rpow (by positivity) (by positivity), ← Real.rpow_natCast,
        ← Real.rpow_mul (by norm_num)]
    have hcancel : (2 : ℝ) ^ ((k : ℝ) * (1 / (μ + 1))) *
        (2 : ℝ) ^ ((k : ℝ) * (α + n - n * p)) = 1 := by
      rw [← Real.rpow_add (by norm_num), hexp0]; simp
    calc c5 = c4 * ((100 * μ) ^ (1 / (μ + 1)) / 2) := hc5
      _ = (100 * μ * (2 : ℝ) ^ k) ^ (1 / (μ + 1)) / 2 *
            (c4 * (2 : ℝ) ^ ((k : ℝ) * (α + n - n * p))) := by
          rw [hsplit]
          linear_combination (c4 * (100 * μ) ^ (1 / (μ + 1)) / 2) * hcancel.symm
      _ ≤ (globalShellCount μ k : ℝ) * (c4 * (2 : ℝ) ^ ((k : ℝ) * (α + n - n * p))) :=
          mul_le_mul_of_nonneg_right hN (by positivity)
  -- disjoint scales `k₁ + 2i`
  have hsum : ∀ I : ℕ, (I : ℝ≥0∞) * ENNReal.ofReal c5 ≤ ∫⁻ x, G x ∂w := by
    intro I
    set A : ℕ → Set (Euclidean (n + 1)) := fun i =>
      ⋃ j ∈ Finset.Icc 1 (globalShellCount μ (k₁ + 2 * i)), globalShell n μ (k₁ + 2 * i) j
    have hAm : ∀ i ∈ Finset.range I, MeasurableSet (A i) := fun i _ =>
      Finset.measurableSet_biUnion _ (fun j _ => measurableSet_ball.diff measurableSet_closedBall)
    have hAsub : ∀ i x, x ∈ A i →
        (2 : ℝ) ^ (k₁ + 2 * i) - 1 / 200 < ‖x‖ ∧
          ‖x‖ < (2 : ℝ) ^ (k₁ + 2 * i + 1) + 1 / 200 := by
      intro i x hx
      simp only [A, Set.mem_iUnion, Finset.mem_Icc] at hx
      obtain ⟨j, ⟨hj1, _⟩, hxj⟩ := hx
      exact globalShell_subset hμ hj1 hxj
    have hAdisj : Set.PairwiseDisjoint (↑(Finset.range I)) A := by
      intro i _ i' _ hne
      rw [Function.onFun, Set.disjoint_left]
      intro x hx hx'
      have h1 := hAsub i x hx
      have h2 := hAsub i' x hx'
      rcases lt_or_gt_of_ne hne with h | h
      · have hle : (2 : ℝ) ^ (k₁ + 2 * i + 1) * 2 ≤ 2 ^ (k₁ + 2 * i') := by
          rw [← pow_succ]; exact pow_le_pow_right₀ (by norm_num) (by omega)
        have : (1 : ℝ) ≤ 2 ^ (k₁ + 2 * i + 1) := one_le_pow₀ (by norm_num)
        linarith [h1.2, h2.1]
      · have hle : (2 : ℝ) ^ (k₁ + 2 * i' + 1) * 2 ≤ 2 ^ (k₁ + 2 * i) := by
          rw [← pow_succ]; exact pow_le_pow_right₀ (by norm_num) (by omega)
        have : (1 : ℝ) ≤ 2 ^ (k₁ + 2 * i' + 1) := one_le_pow₀ (by norm_num)
        linarith [h1.1, h2.2]
    calc (I : ℝ≥0∞) * ENNReal.ofReal c5 = ∑ i ∈ Finset.range I, ENNReal.ofReal c5 := by
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
      _ ≤ ∑ i ∈ Finset.range I, ∫⁻ x in A i, G x ∂w :=
          Finset.sum_le_sum fun i _ => hscale (k₁ + 2 * i) (by omega)
      _ = ∫⁻ x in ⋃ i ∈ Finset.range I, A i, G x ∂w :=
          (lintegral_biUnion_finset hAdisj hAm _).symm
      _ ≤ ∫⁻ x, G x ∂w := setLIntegral_le_lintegral _ _
  -- contradiction with the finite bound
  have hQ : ENNReal.ofReal C ^ p * w B ≠ ∞ :=
    ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg hp0.le ENNReal.ofReal_ne_top) hwB.ne
  obtain ⟨I, hI⟩ := exists_nat_gt ((ENNReal.ofReal C ^ p * w B).toReal / c5)
  have h := (hsum I).trans hmom
  rw [← ENNReal.ofReal_toReal hQ, ← ENNReal.ofReal_natCast,
    ← ENNReal.ofReal_mul (Nat.cast_nonneg _),
    ENNReal.ofReal_le_ofReal_iff ENNReal.toReal_nonneg] at h
  rw [div_lt_iff₀ hc5pos] at hI
  linarith

/-! ## The fractal exponents of the global set `𝓔^μ` -/

/-- A multiplicative window of diameter at most one meets at most two
consecutive dyadic copies `2^k E^μ`, `2^{k+1} E^μ` of the sequence set. -/
theorem globalSequenceSet_inter_window_subset {μ : ℝ} (hμ : 0 ≤ μ) (c : PositiveRadius)
    {D : ℝ≥0} (hD : D ≤ 1) :
    ∃ k : ℤ, globalSequenceSet μ ∩ multiplicativeInterval c D ⊆
      (dilateRadiusSet ((2 : ℝ) ^ k) (sequenceSet μ) ∩ multiplicativeInterval c D) ∪
        (dilateRadiusSet ((2 : ℝ) ^ (k + 1)) (sequenceSet μ) ∩ multiplicativeInterval c D) := by
  have hlog2 : 0 < Real.log 2 := Real.log_pos one_lt_two
  have hDr : (D : ℝ) ≤ 1 := by exact_mod_cast hD
  set L := logRadius c
  refine ⟨⌈L - (D : ℝ) / 2⌉ - 1, ?_⟩
  set k : ℤ := ⌈L - (D : ℝ) / 2⌉ - 1
  have hk1 : (k : ℝ) < L - (D : ℝ) / 2 := by
    have := Int.ceil_lt_add_one (L - (D : ℝ) / 2); push_cast [k]; linarith
  have hk2 : L - (D : ℝ) / 2 ≤ (k : ℝ) + 1 := by push_cast [k]; linarith [Int.le_ceil (L - (D : ℝ) / 2)]
  rintro t ⟨⟨m, s, hs, rfl⟩, hI⟩
  have hsI := sequenceSet_subset_Icc hμ hs
  have hs1 : 1 < s := by
    obtain ⟨j, hj, rfl⟩ := hs
    linarith [(rpow_neg_mem_Ioc hμ hj).1]
  have hlog : Real.log ((2 : ℝ) ^ m * s) / Real.log 2 = m + Real.log s / Real.log 2 := by
    rw [Real.log_mul (by positivity) (by linarith), Real.log_zpow]; field_simp
  have hls0 : 0 < Real.log s / Real.log 2 := div_pos (Real.log_pos hs1) hlog2
  have hls1 : Real.log s / Real.log 2 ≤ 1 := by
    rw [div_le_one hlog2]; exact Real.log_le_log (by linarith) hsI.2
  have hIabs : |Real.log ((2 : ℝ) ^ m * s) / Real.log 2 - L| ≤ (D : ℝ) / 2 := hI.2
  rw [hlog] at hIabs
  have ha := (abs_le.mp hIabs)
  have hmk : k ≤ m := by
    have : (k : ℝ) < m + 1 := by linarith
    exact_mod_cast (show k < m + 1 by exact_mod_cast this) |> Int.lt_add_one_iff.mp
  have hmk2 : m ≤ k + 1 := by
    have : (m : ℝ) < k + 2 := by linarith
    have : m < k + 2 := by exact_mod_cast this
    omega
  rcases (show m = k ∨ m = k + 1 by omega) with h | h
  · left; exact ⟨⟨s, hs, by rw [h]⟩, hI⟩
  · right; exact ⟨⟨s, hs, by rw [h]⟩, hI⟩

/-- The localized entropy of `𝓔^μ` is at most twice the bound for `E^μ`. -/
theorem globalSequenceSet_localEntropy_le {μ : ℝ} (hμ : 0 < μ) (c : PositiveRadius)
    {D δ : ℝ≥0} (hδ : 0 < δ) (hδ1 : δ ≤ 1) (hδD : δ ≤ D) (hD : D ≤ 1) :
    ((localMultiplicativeEntropy (globalSequenceSet μ) c D δ : ℕ∞) : ℝ≥0∞) ≤
      2 * ENNReal.ofReal (78 * min ((D : ℝ) / δ) ((δ : ℝ) ^ (-(1 / (μ + 1))))) := by
  obtain ⟨k, hk⟩ := globalSequenceSet_inter_window_subset hμ.le c hD
  have hpiece : ∀ m : ℤ, ((multiplicativeEntropy
      (dilateRadiusSet ((2 : ℝ) ^ m) (sequenceSet μ) ∩ multiplicativeInterval c D) δ : ℕ∞) :
        ℝ≥0∞) ≤ ENNReal.ofReal (78 * min ((D : ℝ) / δ) ((δ : ℝ) ^ (-(1 / (μ + 1))))) := by
    intro m
    have ha : (0 : ℝ) < 2 ^ m := by positivity
    set c' : PositiveRadius := ⟨((2 : ℝ) ^ m)⁻¹ * c.1, mul_pos (inv_pos.mpr ha) c.2⟩
    have hc : (⟨(2 : ℝ) ^ m * c'.1, mul_pos ha c'.2⟩ : PositiveRadius) = c := by
      apply Subtype.ext; simp [c', ha.ne']
    have heq := dilateRadiusSet_inter_multiplicativeInterval (sequenceSet μ) c' D ha
    rw [hc] at heq
    rw [← heq, multiplicativeEntropy_dilateRadiusSet _ _ ha]
    exact sequenceSet_localEntropy_le hμ c' hδ hδ1 hδD
  unfold localMultiplicativeEntropy
  calc ((multiplicativeEntropy (globalSequenceSet μ ∩ multiplicativeInterval c D) δ : ℕ∞) :
        ℝ≥0∞)
      ≤ ((multiplicativeEntropy
          (dilateRadiusSet ((2 : ℝ) ^ k) (sequenceSet μ) ∩ multiplicativeInterval c D) δ +
        multiplicativeEntropy
          (dilateRadiusSet ((2 : ℝ) ^ (k + 1)) (sequenceSet μ) ∩ multiplicativeInterval c D) δ :
          ℕ∞) : ℝ≥0∞) :=
        ENat.toENNReal_mono ((multiplicativeEntropy_mono hk δ).trans
          (multiplicativeEntropy_union_le _ _ _))
    _ = _ + _ := ENat.toENNReal_add _ _
    _ ≤ _ := by rw [two_mul]; exact add_le_add (hpiece k) (hpiece (k + 1))

/-- Upper bound for the Legendre--Assouad exponent of `𝓔^μ`. -/
theorem globalSequenceSet_legendreAssouad_le {μ : ℝ} (hμ : 0 < μ) (ρ : ℝ) :
    multiplicativeLegendreAssouadExponent (globalSequenceSet μ) ρ ≤
      (sequenceLegendreAssouad μ ρ : EReal) := by
  apply multiplicativeLegendreAssouadExponent_le_of_profile_power_bound
    (A := 2 * 78) (by norm_num)
  have hsmall : ∀ᶠ δ : ℝ≥0 in 𝓝[>] (0 : ℝ≥0), δ ∈ Ioo 0 1 :=
    nhdsGT_basis 0 |>.mem_of_mem zero_lt_one
  filter_upwards [hsmall] with δ hδ
  have hδr : (0 : ℝ) < δ := hδ.1
  unfold multiplicativeLegendreAssouadProfile
  refine iSup_le fun c => iSup_le fun D => ?_
  have hδD : δ ≤ D.1 := D.2.1
  have hD1 : D.1 ≤ 1 := D.2.2
  have hDpos : (0 : ℝ) < D.1 := hδr.trans_le hδD
  have hent := globalSequenceSet_localEntropy_le hμ c hδ.1 hδ.2.le hδD hD1
  have hreal := sequence_profile_real_bound (ρ := ρ) hμ hδr (show (δ : ℝ) ≤ D.1 from hδD)
    (show (D.1 : ℝ) ≤ 1 from hD1)
  have hcoe : ((D.1 : ℝ≥0) : ℝ≥0∞) ^ (-ρ) = ENNReal.ofReal ((D.1 : ℝ) ^ (-ρ)) := by
    rw [← ENNReal.ofReal_rpow_of_pos hDpos, ENNReal.ofReal_coe_nnreal]
  have hcoe' : (δ : ℝ≥0∞) ^ (-sequenceLegendreAssouad μ ρ) =
      ENNReal.ofReal ((δ : ℝ) ^ (-sequenceLegendreAssouad μ ρ)) := by
    rw [← ENNReal.ofReal_rpow_of_pos hδr, ENNReal.ofReal_coe_nnreal]
  rw [hcoe, hcoe']
  calc ENNReal.ofReal ((D.1 : ℝ) ^ (-ρ)) *
        ((localMultiplicativeEntropy (globalSequenceSet μ) c D.1 δ : ℕ∞) : ℝ≥0∞)
      ≤ ENNReal.ofReal ((D.1 : ℝ) ^ (-ρ)) *
        (2 * ENNReal.ofReal (78 * min ((D.1 : ℝ) / δ) ((δ : ℝ) ^ (-(1 / (μ + 1)))))) :=
        mul_le_mul' le_rfl hent
    _ = 2 * ENNReal.ofReal (78 * ((D.1 : ℝ) ^ (-ρ) *
          min ((D.1 : ℝ) / δ) ((δ : ℝ) ^ (-(1 / (μ + 1)))))) := by
        rw [mul_left_comm, ← ENNReal.ofReal_mul (Real.rpow_nonneg hDpos.le _)]
        ring_nf
    _ ≤ 2 * ENNReal.ofReal (78 * (δ : ℝ) ^ (-sequenceLegendreAssouad μ ρ)) :=
        mul_le_mul' le_rfl (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hreal
          (by norm_num)))
    _ = 2 * 78 * ENNReal.ofReal ((δ : ℝ) ^ (-sequenceLegendreAssouad μ ρ)) := by
        rw [ENNReal.ofReal_mul (by norm_num), mul_assoc]; norm_num

/-- Monotonicity of the limsup of logarithmic entropy quotients. -/
theorem limsup_entropyLogQuotient_mono {F G : ℝ≥0 → ℝ≥0∞} (h : ∀ δ, F δ ≤ G δ) :
    Filter.limsup (fun δ : ℝ≥0 => entropyLogQuotient (F δ) δ) (𝓝[>] 0) ≤
      Filter.limsup (fun δ : ℝ≥0 => entropyLogQuotient (G δ) δ) (𝓝[>] 0) := by
  apply Filter.limsup_le_limsup _ (by isBoundedDefault) (by isBoundedDefault)
  have hsmall : ∀ᶠ δ : ℝ≥0 in 𝓝[>] (0 : ℝ≥0), δ ∈ Ioo 0 1 :=
    nhdsGT_basis 0 |>.mem_of_mem zero_lt_one
  filter_upwards [hsmall] with δ hδ
  exact entropyLogQuotient_mono hδ.1 hδ.2 (h δ)

/-- The exponents of `𝓔^μ` coincide with those of `E^μ`. -/
theorem globalSequenceSet_minkowski_eq {μ : ℝ} (hμ : 0 < μ) :
    multiplicativeMinkowskiExponent (globalSequenceSet μ) = ((1 / (μ + 1) : ℝ) : EReal) := by
  apply le_antisymm
  · have h := (multiplicativeMinkowskiExponent_le_multiplicativeLegendreAssouadExponent
      (globalSequenceSet μ) 0).trans (globalSequenceSet_legendreAssouad_le hμ 0)
    have hval : sequenceLegendreAssouad μ 0 = 1 / (μ + 1) := by
      have hμ1 : 0 < μ + 1 := by linarith
      simp only [sequenceLegendreAssouad, mul_zero, zero_add]
      rw [max_self, max_eq_left (one_div_pos.mpr hμ1).le]
    rwa [hval] at h
  · rw [← sequenceSet_minkowski_eq hμ]
    exact limsup_entropyLogQuotient_mono
      (fun δ => ENat.toENNReal_mono (unitMultiplicativeEntropy_mono
        (sequenceSet_subset_global μ) δ))

theorem globalSequenceSet_legendreAssouad_eq {μ : ℝ} (hμ : 0 < μ) (ρ : ℝ) :
    multiplicativeLegendreAssouadExponent (globalSequenceSet μ) ρ =
      (sequenceLegendreAssouad μ ρ : EReal) := by
  apply le_antisymm (globalSequenceSet_legendreAssouad_le hμ ρ)
  rw [← sequenceSet_legendreAssouad_eq hμ ρ]
  exact limsup_entropyLogQuotient_mono
    (fun δ => multiplicativeLegendreAssouadProfile_mono (sequenceSet_subset_global μ) ρ δ)

/-! ## The global operator below the upper endpoint (introduction, lines 906-909) -/

/-- Weighted bounds pass to smaller dilation sets (through the Schwartz core
and the density theorem). -/
theorem WeightedMaximalBound.mono {d : ℕ} (hd : 1 ≤ d) {E F : Set ℝ} {p α : ℝ}
    (hp : 1 < p) (hα : -(d : ℝ) < α) (hEF : E ⊆ F)
    (h : WeightedMaximalBound d F p α) : WeightedMaximalBound d E p α :=
  weighted_bound_of_normalized_strongType hd E hp hα (h.strongType.of_subset hEF)

theorem dilateRadiusSet_dilateRadiusSet (a b : ℝ) (E : Set ℝ) :
    dilateRadiusSet a (dilateRadiusSet b E) = dilateRadiusSet (a * b) E := by
  ext t
  simp only [dilateRadiusSet, Set.mem_image]
  constructor
  · rintro ⟨_, ⟨s, hs, rfl⟩, rfl⟩; exact ⟨s, hs, by ring⟩
  · rintro ⟨s, hs, rfl⟩; exact ⟨b * s, ⟨s, hs, rfl⟩, by ring⟩

/-- The normalized blocks of `𝓔^μ` lie in the union of two dilates of `E^μ`. -/
theorem normalizedRadiusBlock_globalSequenceSet_subset {μ : ℝ} (hμ : 0 ≤ μ) {R : ℝ}
    (hR : 0 < R) :
    ∃ a b : ℝ, 0 < a ∧ 0 < b ∧ normalizedRadiusBlock (globalSequenceSet μ) R ⊆
      dilateRadiusSet a (sequenceSet μ) ∪ dilateRadiusSet b (sequenceSet μ) := by
  set c : PositiveRadius := ⟨Real.sqrt 2 * R, mul_pos (by positivity) hR⟩
  have hwin : Icc R (2 * R) ⊆ multiplicativeInterval c 1 := by
    intro t ht
    have htpos : 0 < t := hR.trans_le ht.1
    refine ⟨htpos, ?_⟩
    have hlog2 : 0 < Real.log 2 := Real.log_pos one_lt_two
    have hsq : Real.log (Real.sqrt 2) = Real.log 2 / 2 := by
      rw [Real.log_sqrt (by norm_num)]
    change |Real.log t / Real.log 2 - Real.log (Real.sqrt 2 * R) / Real.log 2| ≤ (1 : ℝ) / 2
    rw [Real.log_mul (by positivity) hR.ne', hsq, ← sub_div, abs_div, abs_of_pos hlog2,
      div_le_iff₀ hlog2, abs_le]
    have h1 := Real.log_le_log hR ht.1
    have h2 := Real.log_le_log htpos ht.2
    rw [Real.log_mul (by norm_num) hR.ne'] at h2
    constructor <;> linarith
  obtain ⟨k, hk⟩ := globalSequenceSet_inter_window_subset hμ c (le_refl 1)
  refine ⟨R⁻¹ * 2 ^ k, R⁻¹ * 2 ^ (k + 1), by positivity, by positivity, ?_⟩
  rintro u ⟨t, ⟨htE, htI⟩, rfl⟩
  rcases hk ⟨htE, hwin htI⟩ with h | h
  · left
    rw [← dilateRadiusSet_dilateRadiusSet]; exact ⟨t, h.1, rfl⟩
  · right
    rw [← dilateRadiusSet_dilateRadiusSet]; exact ⟨t, h.1, rfl⟩

/-- Global-to-local at the lower endpoint `α = L(p) < 0`, `p(μ) < p < d/(d-1)`:
the uniform local bounds for the normalized blocks of `𝓔^μ` (two dilates of
`E^μ`) and the global unweighted SWW bound give the global weighted bound. -/
theorem global_sequence_lower_endpoint_bound {d : ℕ} (hd : 2 ≤ d) {μ p : ℝ} (hμ : 0 < μ)
    (hp : sequenceCriticalExponent d μ < p) (hpd : p < (d : ℝ) / ((d : ℝ) - 1)) :
    WeightedMaximalBound d (globalSequenceSet μ) p (sequenceLowerEndpoint d μ p) := by
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hn : 0 < (d : ℝ) - 1 := by linarith
  have hμ1 : 0 < μ + 1 := by linarith
  set a := sequenceLowerEndpoint d μ p with hadef
  have hloc := sequence_lower_endpoint_bound hd hμ hp hpd
  have hp1 : 1 < p := by
    unfold sequenceCriticalExponent at hp
    have : 0 < 1 / ((μ + 1) * ((d : ℝ) - 1)) := by positivity
    linarith
  have ha0 : a < 0 := by
    rw [hadef, sequenceLowerEndpoint_of_le hd hμ hpd.le]
    have hθ : (d : ℝ) - ((d : ℝ) - 1) * p < μ / (μ + 1) := by
      unfold sequenceCriticalExponent at hp
      have h1 : 1 / ((μ + 1) * ((d : ℝ) - 1)) < p - 1 := by linarith
      rw [div_lt_iff₀ (by positivity)] at h1
      have : μ / (μ + 1) = 1 - 1 / (μ + 1) := by field_simp; ring
      rw [this]
      have : 1 / (μ + 1) < ((d : ℝ) - 1) * (p - 1) := by
        rw [div_lt_iff₀ hμ1]; nlinarith
      linarith
    have : ((d : ℝ) - ((d : ℝ) - 1) * p) / μ < 1 / (μ + 1) := by
      rw [div_lt_iff₀ hμ]
      calc (d : ℝ) - ((d : ℝ) - 1) * p < μ / (μ + 1) := hθ
        _ = 1 / (μ + 1) * μ := by ring
    have : 1 / (μ + 1) < 1 := by rw [div_lt_one hμ1]; linarith
    linarith
  have had : -(d : ℝ) < a := by
    have : 1 - (d : ℝ) ≤ a := le_max_left _ _
    linarith
  -- the local constant for `E^μ` on the Schwartz core
  obtain ⟨C, hC, hcore⟩ := hloc.strongType
  -- the unweighted global SWW bound
  have hβ : _root_.Spherical.upperMinkowskiExponent (globalSequenceSet μ) = 1 / (μ + 1) := by
    rw [upperMinkowskiExponent_eq_multiplicativeMinkowskiExponent_toReal,
      globalSequenceSet_minkowski_eq hμ, EReal.toReal_coe]
  have hEpos : globalSequenceSet μ ⊆ Ioi 0 := by
    rintro t ⟨k, s, hs, rfl⟩; exact mul_pos (by positivity) (sequenceSet_subset_Ioi hμ.le hs)
  have hcritical :
      _root_.Spherical.RestrictedDilations.criticalExponent d (globalSequenceSet μ) < p := by
    unfold _root_.Spherical.RestrictedDilations.criticalExponent
    change 1 + _root_.Spherical.upperMinkowskiExponent (globalSequenceSet μ) / ((d : ℝ) - 1) < p
    rw [hβ]
    unfold sequenceCriticalExponent at hp
    rw [div_div]; exact hp
  obtain ⟨U, hU⟩ := Auto.Spherical.SWW.eLpNorm_restrictedSphericalMaximal_le hd hEpos
    ((ENNReal.ofReal_lt_ofReal_iff (by linarith)).mpr hcritical)
  have hunweighted : HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d
      (globalSequenceSet μ) p 0 := by
    refine ⟨|U| + 1, by positivity, ?_⟩
    intro f hf
    have hh := hU f (by simpa only [powerWeightedVolume_zero] using hf)
    change MemLp (_root_.Spherical.restrictedSphericalMaximal _ (f : Euclidean d → ℂ))
      (ENNReal.ofReal p) volume ∧
      eLpNorm (_root_.Spherical.restrictedSphericalMaximal _ (f : Euclidean d → ℂ))
        (ENNReal.ofReal p) volume ≤ _ at hh
    rw [restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal] at hh
    simp only [powerWeightedVolume_zero]
    refine ⟨hh.1, hh.2.trans (mul_le_mul' ?_ le_rfl)⟩
    exact ENNReal.ofReal_le_ofReal (by linarith [le_abs_self U])
  -- the global-to-local principle
  have hglobal : HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d
      (globalSequenceSet μ) p a := by
    apply hasRestrNormdSphMaxPowerWeightStrongType_of_unif_normd_local_and_unweighted
      (C := 2 * C) (by omega) _ hp1.le ha0 hunweighted
    intro R hR g hg
    obtain ⟨u, v, hu, hv, hsub⟩ := normalizedRadiusBlock_globalSequenceSet_subset hμ.le hR
    have h1 := restrictedNormalizedSphericalMaximal_dilateRadiusSet_bound (by omega)
      (by linarith) hu hcore g hg
    have h2 := restrictedNormalizedSphericalMaximal_dilateRadiusSet_bound (by omega)
      (by linarith) hv hcore g hg
    have hle : eLpNorm (restrictedNormalizedSphericalMaximal d
        (normalizedRadiusBlock (globalSequenceSet μ) R) (g : Euclidean d → ℂ))
        (ENNReal.ofReal p) (powerWeightedVolume d a) ≤
        ENNReal.ofReal (2 * C) * eLpNorm (g : Euclidean d → ℂ) (ENNReal.ofReal p)
          (powerWeightedVolume d a) := by
      calc _ ≤ eLpNorm (restrictedNormalizedSphericalMaximal d
              (dilateRadiusSet u (sequenceSet μ)) (g : Euclidean d → ℂ) +
            restrictedNormalizedSphericalMaximal d
              (dilateRadiusSet v (sequenceSet μ)) (g : Euclidean d → ℂ))
            (ENNReal.ofReal p) (powerWeightedVolume d a) := by
            apply eLpNorm_mono_enorm
              (measurable_restrictedNormalizedSphericalMaximal _ _ g.continuous).aestronglyMeasurable
            intro x
            simp only [enorm_eq_self, Pi.add_apply]
            exact (restrictedNormalizedSphericalMaximal_mono hsub _ x).trans
              (restrictedNormalizedSphericalMaximal_union_le _ _ _ x)
        _ ≤ eLpNorm (restrictedNormalizedSphericalMaximal d
              (dilateRadiusSet u (sequenceSet μ)) (g : Euclidean d → ℂ))
              (ENNReal.ofReal p) (powerWeightedVolume d a) +
            eLpNorm (restrictedNormalizedSphericalMaximal d
              (dilateRadiusSet v (sequenceSet μ)) (g : Euclidean d → ℂ))
              (ENNReal.ofReal p) (powerWeightedVolume d a) :=
            eLpNorm_add_le
              (by simpa using ENNReal.ofReal_le_ofReal hp1.le)
        _ ≤ ENNReal.ofReal C * eLpNorm (g : Euclidean d → ℂ) (ENNReal.ofReal p)
              (powerWeightedVolume d a) +
            ENNReal.ofReal C * eLpNorm (g : Euclidean d → ℂ) (ENNReal.ofReal p)
              (powerWeightedVolume d a) := add_le_add h1.2 h2.2
        _ = _ := by
            rw [← add_mul, ← ENNReal.ofReal_add hC.le hC.le]; ring_nf
    exact ⟨hle.trans_lt (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hg), hle⟩
  exact weighted_bound_of_normalized_strongType (by omega) _ hp1 had hglobal

/-- `p > p(μ)` is the condition `(d-1)(p-1) > 1/(μ+1)`. -/
theorem sequenceCriticalExponent_lt_iff {d : ℕ} (hd : 2 ≤ d) {μ p : ℝ} (hμ : 0 < μ) :
    sequenceCriticalExponent d μ < p ↔ 1 / (μ + 1) < ((d : ℝ) - 1) * (p - 1) := by
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hn : 0 < (d : ℝ) - 1 := by linarith
  have hμ1 : 0 < μ + 1 := by linarith
  unfold sequenceCriticalExponent
  rw [show 1 + 1 / ((μ + 1) * ((d : ℝ) - 1)) < p ↔ 1 / ((μ + 1) * ((d : ℝ) - 1)) < p - 1 by
    constructor <;> intro h <;> linarith, div_lt_iff₀ (by positivity), div_lt_iff₀ hμ1]
  constructor <;> intro h <;> nlinarith

/-- Introduction, lines 906-909 (the global sequence theorem), for `d ≥ 2`: for
`p(μ) < p < ∞`, `M_{𝓔^μ}` is bounded on `L^p(|x|^α)` iff `α < U(p)` and `M_{E^μ}`
is bounded on `L^p(|x|^α)`. -/
theorem global_sequence_iff {d : ℕ} (hd : 2 ≤ d) {μ p α : ℝ} (hμ : 0 < μ)
    (hp : sequenceCriticalExponent d μ < p) :
    WeightedMaximalBound d (globalSequenceSet μ) p α ↔
      α < sequenceUpperEndpoint d μ p ∧ WeightedMaximalBound d (sequenceSet μ) p α := by
  have hd2 : 2 ≤ d := by omega
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hn : 0 < (d : ℝ) - 1 := by linarith
  have hcrit := (sequenceCriticalExponent_lt_iff hd2 hμ).mp hp
  have hμ1 : 0 < μ + 1 := by linarith
  have hp1 : 1 < p := by
    have : 0 < 1 / (μ + 1) := by positivity
    by_contra h; push_neg at h; nlinarith
  have hEpos : globalSequenceSet μ ⊆ Ioi 0 := by
    rintro t ⟨k, s, hs, rfl⟩; exact mul_pos (by positivity) (sequenceSet_subset_Ioi hμ.le hs)
  constructor
  · intro h
    have hα : -(d : ℝ) < α := neg_dim_lt_alpha_of_restrictedStrongType (by omega)
      ⟨_, sequenceSet_subset_global μ (sequenceSet_nonempty μ).some_mem,
        sequenceSet_subset_Ioi hμ.le (sequenceSet_nonempty μ).some_mem⟩ hp1.le h.strongType
    have hloc := h.mono (by omega) hp1 hα (sequenceSet_subset_global μ)
    refine ⟨?_, hloc⟩
    obtain ⟨-, -, hU⟩ := sequence_necessary hd2 hμ hp1.le hloc
    rcases hU.lt_or_eq with hlt | heq
    · exact hlt
    · exact absurd (heq ▸ h) (global_sequence_unbounded_upper hd2 hμ hp)
  · rintro ⟨hαU, hloc⟩
    obtain ⟨-, hL, -⟩ := sequence_necessary hd2 hμ hp1.le hloc
    rcases hL.lt_or_eq with hLlt | hLeq
    · -- interior: the FRS strict theorem for `𝓔^μ`
      have hα : -(d : ℝ) < α := by
        have : 1 - (d : ℝ) ≤ sequenceLowerEndpoint d μ p := le_max_left _ _
        linarith
      have hstrictE := (sequence_strictCondition_iff hd2 hμ p α).mpr ⟨hcrit, hLlt, hαU⟩
      rw [sequenceSet_minkowski_eq hμ, sequenceSet_legendreAssouad_eq hμ] at hstrictE
      have hstrict : max ((α : EReal) + multiplicativeMinkowskiExponent (globalSequenceSet μ))
          (multiplicativeLegendreAssouadExponent (globalSequenceSet μ)
            (((d : ℝ) - 1) * (p - 2) - α)) < (↑(((d : ℝ) - 1) * (p - 1)) : EReal) := by
        rw [globalSequenceSet_minkowski_eq hμ, globalSequenceSet_legendreAssouad_eq hμ]
        exact hstrictE
      exact weighted_bound_of_normalized_strongType (by omega) _ hp1 hα
        (frs_strict_strongType_two_le hd2 _ ⟨_, sequenceSet_subset_global μ
          (sequenceSet_nonempty μ).some_mem⟩ hEpos hp1 hstrict)
    · -- the lower endpoint `α = L(p)`
      subst hLeq
      rcases lt_trichotomy p ((d : ℝ) / ((d : ℝ) - 1)) with hpd | hpd | hpd
      · exact global_sequence_lower_endpoint_bound hd2 hμ hp hpd
      · rw [sequenceLowerEndpoint_of_le hd2 hμ hpd.le, hpd] at hloc
        have : 1 - (d : ℝ) + ((d : ℝ) - ((d : ℝ) - 1) * ((d : ℝ) / ((d : ℝ) - 1))) / μ =
            1 - (d : ℝ) := by field_simp; ring
        rw [this] at hloc
        exact absurd hloc (sequence_critical_unbounded (by omega) hμ)
      · rw [sequenceLowerEndpoint_of_ge hd2 hμ hpd.le]
        apply general_assouad_maximal_endpoint hd2 hEpos
        have hγ := uniformAssouadDimension_le_one (globalSequenceSet μ)
        have : 1 + uniformAssouadDimension (globalSequenceSet μ) / ((d : ℝ) - 1) ≤
            (d : ℝ) / ((d : ℝ) - 1) := by
          rw [show (d : ℝ) / ((d : ℝ) - 1) = 1 + 1 / ((d : ℝ) - 1) by field_simp; ring]
          gcongr
        linarith


/-! ## Section 3.5: boundedness of `M_{E^μ}` at `α = U(p)`

The source (lines 1485-1720) splits the input at the origin, resolves it in
frequency and dyadic input shells, and bounds each piece with Schur-type
estimates (`lem:Gamma`) and an interpolation for `p ≥ 2`. Here the pieces are
the smooth dyadic shells `2^{-m-1} < |y| < 2^{1-m}` and the compact resolution
at frequency `2^s`; the radii of `E^μ` are grouped into the window
`[1, 1+2^{-s}]` and the dyadic blocks `(1+2^{-J-1}, 1+2^{-J}]` (the source's
`I_l`). Each piece, on one radius interval of length `2^{-s}`, contributes
`2^{-βs - ε|m-s|}` times the weighted input moment: by the support-volume bound
when `m > s` (`z ≥ 0` in the source), by the Section 2 interpolation when
`m ≤ s` and `p < 2`, and by log-convexity between the cap-Hölder `L^∞` bound
and the `L²` bound when `m ≤ s` and `p ≥ 2`, with the planar extension below. The
block counts `min(2^{J/μ}, 2^{s-J})` give the decay `2^{-c|s-(μ+1)J/μ|}`.
The source's unproved lacunary lemma for the lowest frequencies is replaced by
the summable window bound `2^{-βs}`. -/
/-- Tonelli form of the smoothed spherical kernel: the sphere integral of a
convolution is dominated by the input against the sphere-averaged kernel. -/
theorem lintegral_sphere_kernel_swap {d : ℕ}
    (K : SchwartzMap (Euclidean d) ℂ) (b : Euclidean d → ℝ≥0∞) (hb : Measurable b)
    (t : ℝ) (x : Euclidean d) :
    (∫⁻ ω : Metric.sphere (0 : Euclidean d) 1, (∫⁻ y,
        ‖K (x + t • (ω : Euclidean d) - y)‖ₑ * b y) ∂unitSurfaceMeasure d) =
      ∫⁻ y, b y * ∫⁻ ω : Metric.sphere (0 : Euclidean d) 1,
        ‖K (x - y + t • (ω : Euclidean d))‖ₑ ∂unitSurfaceMeasure d := by
  rw [lintegral_lintegral_swap]
  · apply lintegral_congr
    intro y
    have hm : Measurable (fun ω : Metric.sphere (0 : Euclidean d) 1 =>
        ‖K (x + t • (ω : Euclidean d) - y)‖ₑ) :=
      (K.continuous.comp (by fun_prop)).measurable.enorm
    rw [lintegral_mul_const _ hm, mul_comm]
    congr 1
    apply lintegral_congr
    intro ω
    congr 2
    abel
  · apply Measurable.aemeasurable
    apply Measurable.mul
    · exact (K.continuous.measurable.comp (by fun_prop)).enorm
    · exact hb.comp measurable_snd

/-- The pointwise convolution bound behind every fixed-radius estimate. -/
theorem enorm_sphericalAverage_compactConvolution_le {d : ℕ}
    (K h : SchwartzMap (Euclidean d) ℂ) (t : ℝ) (x : Euclidean d) :
    ‖sphericalAverage d (compactConvolution K h) t x‖ₑ ≤
      ∫⁻ ω : Metric.sphere (0 : Euclidean d) 1, (∫⁻ y,
        ‖K (x + t • (ω : Euclidean d) - y)‖ₑ * ‖h y‖ₑ) ∂unitSurfaceMeasure d := by
  have hconv (z : Euclidean d) : ‖compactConvolution K h z‖ₑ ≤
      ∫⁻ y, ‖K (z - y)‖ₑ * ‖h y‖ₑ := by
    rw [compactConvolution, SchwartzMap.convolution_apply]
    change ‖∫ u, K u * h (z - u)‖ₑ ≤ _
    apply (enorm_integral_le_lintegral_enorm _).trans
    simp only [enorm_mul]
    rw [← lintegral_sub_left_eq_self (μ := (volume : Measure (Euclidean d)))
      (fun u => ‖K u‖ₑ * ‖h (z - u)‖ₑ) z]
    simp only [sub_sub_cancel, le_refl]
  exact (enorm_integral_le_lintegral_enorm _).trans (lintegral_mono (fun ω => hconv _))

/-- Lintegral form of `exists_smoothed_sphere_kernel_bound`. -/
theorem exists_smoothed_sphere_kernel_lintegral_bound {d : ℕ} (hd : 0 < d)
    (K : SchwartzMap (Euclidean d) ℂ) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : ℕ) (t : ℝ), 1 ≤ t → ∀ z : Euclidean d,
      (∫⁻ ω : Metric.sphere (0 : Euclidean d) 1,
        ‖compactDyadicDilate K j (z + t • (ω : Euclidean d))‖ₑ ∂unitSurfaceMeasure d) ≤
          ENNReal.ofReal (C * (2 : ℝ) ^ j) := by
  obtain ⟨C, hC, hb⟩ := exists_smoothed_sphere_kernel_bound hd K
  refine ⟨C, hC, ?_⟩
  intro j t ht z
  have hint : Integrable (fun ω : Metric.sphere (0 : Euclidean d) 1 =>
      compactDyadicDilate K j (z + t • (ω : Euclidean d))) (unitSurfaceMeasure d) := by
    apply Integrable.mono' (integrable_const
      (SchwartzMap.seminorm ℝ 0 0 (compactDyadicDilate K j)))
    · exact ((compactDyadicDilate K j).continuous.comp (by fun_prop)).aestronglyMeasurable
    · exact Eventually.of_forall (fun ω => SchwartzMap.norm_le_seminorm ℝ _ _)
  rw [← ofReal_integral_norm_eq_lintegral_enorm hint]
  exact ENNReal.ofReal_le_ofReal (hb j t ht z)

/-- Source `eq:pge2part`, `L^∞` input: the smoothed spherical average of
an integrable input is pointwise `O(2^j ‖h‖₁)`. -/
theorem exists_smoothed_sphericalAverage_pointwise_bound {d : ℕ} (hd : 0 < d)
    (K : SchwartzMap (Euclidean d) ℂ) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : ℕ) (t : ℝ), 1 ≤ t → ∀ (h : SchwartzMap (Euclidean d) ℂ)
      (x : Euclidean d),
      ‖sphericalAverage d (compactConvolution (compactDyadicDilate K j) h) t x‖ₑ ≤
        ENNReal.ofReal (C * (2 : ℝ) ^ j) * ∫⁻ y, ‖h y‖ₑ := by
  obtain ⟨C, hC, hb⟩ := exists_smoothed_sphere_kernel_lintegral_bound hd K
  refine ⟨C, hC, ?_⟩
  intro j t ht h x
  apply (enorm_sphericalAverage_compactConvolution_le _ h t x).trans
  rw [lintegral_sphere_kernel_swap _ _ h.continuous.measurable.enorm]
  calc
    _ ≤ ∫⁻ y, ‖h y‖ₑ * ENNReal.ofReal (C * (2 : ℝ) ^ j) :=
      lintegral_mono (fun y => mul_le_mul' le_rfl (hb j t ht (x - y)))
    _ = _ := by rw [lintegral_mul_const _ h.continuous.measurable.enorm, mul_comm]

/-- Hölder on the incidence cap: if the smoothed input vanishes outside the
ball of radius `R`, the `p`-th power of its spherical average is bounded by
the cap measure to the power `p-1` times `2^j ‖h‖_p^p`. -/
theorem exists_smoothed_sphericalAverage_pointwise_rpow_bound {d : ℕ} (hd : 0 < d)
    (K : SchwartzMap (Euclidean d) ℂ) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : ℕ) (t : ℝ), 1 ≤ t → ∀ (h : SchwartzMap (Euclidean d) ℂ)
      (R : ℝ), (∀ z, R < ‖z‖ → compactConvolution (compactDyadicDilate K j) h z = 0) →
      ∀ {p : ℝ}, 1 ≤ p → ∀ x : Euclidean d,
      ‖sphericalAverage d (compactConvolution (compactDyadicDilate K j) h) t x‖ₑ ^ p ≤
        unitSurfaceMeasure d {ω : Metric.sphere (0 : Euclidean d) 1 |
            -x - t • (ω : Euclidean d) ∈ Metric.closedBall 0 R} ^ (p - 1) *
          (∫⁻ y, ‖K y‖ₑ) ^ (p - 1) * ENNReal.ofReal (C * (2 : ℝ) ^ j) *
            ∫⁻ y, ‖h y‖ₑ ^ p := by
  obtain ⟨C, hC, hb⟩ := exists_smoothed_sphere_kernel_lintegral_bound hd K
  refine ⟨C, hC, ?_⟩
  intro j t ht h R hR p hp x
  set F := compactConvolution (compactDyadicDilate K j) h
  set cap := {ω : Metric.sphere (0 : Euclidean d) 1 |
    -x - t • (ω : Euclidean d) ∈ Metric.closedBall 0 R}
  have hcap : MeasurableSet cap := measurableSet_closedBall.preimage (by fun_prop)
  have hFm : Measurable (fun ω : Metric.sphere (0 : Euclidean d) 1 =>
      ‖F (x + t • (ω : Euclidean d))‖ₑ) := (F.continuous.comp (by fun_prop)).measurable.enorm
  have hsplit : (fun ω : Metric.sphere (0 : Euclidean d) 1 => ‖F (x + t • (ω : Euclidean d))‖ₑ) =
      fun ω => cap.indicator (fun _ => (1 : ℝ≥0∞)) ω * ‖F (x + t • (ω : Euclidean d))‖ₑ := by
    funext ω
    by_cases hω : ω ∈ cap
    · simp [Set.indicator_of_mem hω]
    · have hz : R < ‖x + t • (ω : Euclidean d)‖ := by
        have : ¬ ‖-x - t • (ω : Euclidean d)‖ ≤ R := by
          simpa [cap, Metric.mem_closedBall, dist_zero_right] using hω
        rw [show -x - t • (ω : Euclidean d) = -(x + t • (ω : Euclidean d)) by abel,
          norm_neg] at this
        exact lt_of_not_ge this
      simp [Set.indicator_of_notMem hω, hR _ hz]
  have hconv (z : Euclidean d) : ‖F z‖ₑ ^ p ≤ (∫⁻ y, ‖K y‖ₑ) ^ (p - 1) *
      ∫⁻ y, ‖compactDyadicDilate K j (z - y)‖ₑ * ‖h y‖ₑ ^ p := by
    have hh := enorm_compactConvolution_rpow_le (compactDyadicDilate K j) h hp z
    rw [lintegral_enorm_compactDyadicDilate] at hh
    apply hh.trans_eq
    congr 1
    rw [← lintegral_sub_left_eq_self (μ := (volume : Measure (Euclidean d)))
      (fun u => ‖compactDyadicDilate K j u‖ₑ * ‖h (z - u)‖ₑ ^ p) z]
    simp only [sub_sub_cancel]
  calc
    _ ≤ (∫⁻ ω : Metric.sphere (0 : Euclidean d) 1,
        ‖F (x + t • (ω : Euclidean d))‖ₑ ∂unitSurfaceMeasure d) ^ p :=
      ENNReal.rpow_le_rpow (enorm_integral_le_lintegral_enorm _) (by linarith)
    _ ≤ (∫⁻ ω : Metric.sphere (0 : Euclidean d) 1,
          cap.indicator (fun _ => (1 : ℝ≥0∞)) ω ∂unitSurfaceMeasure d) ^ (p - 1) *
        ∫⁻ ω : Metric.sphere (0 : Euclidean d) 1, cap.indicator (fun _ => (1 : ℝ≥0∞)) ω *
          ‖F (x + t • (ω : Euclidean d))‖ₑ ^ p ∂unitSurfaceMeasure d := by
      rw [hsplit]
      exact weighted_lintegral_rpow_le _ (measurable_const.indicator hcap).aemeasurable
        hFm.aemeasurable hp
    _ ≤ unitSurfaceMeasure d cap ^ (p - 1) *
        ∫⁻ ω : Metric.sphere (0 : Euclidean d) 1,
          (∫⁻ y, ‖K y‖ₑ) ^ (p - 1) * (∫⁻ y,
            ‖compactDyadicDilate K j (x + t • (ω : Euclidean d) - y)‖ₑ * ‖h y‖ₑ ^ p)
              ∂unitSurfaceMeasure d := by
      rw [lintegral_indicator_const hcap, one_mul]
      apply mul_le_mul' le_rfl
      apply lintegral_mono
      intro ω
      have hi : cap.indicator (fun _ => (1 : ℝ≥0∞)) ω ≤ 1 := by
        by_cases hω : ω ∈ cap <;> simp [hω]
      exact (mul_le_of_le_one_left' hi).trans (hconv _)
    _ = unitSurfaceMeasure d cap ^ (p - 1) * (∫⁻ y, ‖K y‖ₑ) ^ (p - 1) *
        ∫⁻ y, ‖h y‖ₑ ^ p * ∫⁻ ω : Metric.sphere (0 : Euclidean d) 1,
          ‖compactDyadicDilate K j (x - y + t • (ω : Euclidean d))‖ₑ ∂unitSurfaceMeasure d := by
      rw [lintegral_const_mul' _ _ (ENNReal.rpow_ne_top_of_nonneg (by linarith)
        K.integrable.hasFiniteIntegral.ne), mul_assoc,
        lintegral_sphere_kernel_swap _ _ (h.continuous.measurable.enorm.pow_const p)]
    _ ≤ unitSurfaceMeasure d cap ^ (p - 1) * (∫⁻ y, ‖K y‖ₑ) ^ (p - 1) *
        ∫⁻ y, ‖h y‖ₑ ^ p * ENNReal.ofReal (C * (2 : ℝ) ^ j) := by
      gcongr with y
      exact hb j t ht (x - y)
    _ = _ := by
      rw [lintegral_mul_const _ (h.continuous.measurable.enorm.pow_const p)]
      ring

/-- Hölder on the support ball: `‖h‖₁^p ≤ |B_r|^{p-1} ‖h‖_p^p`. -/
theorem lintegral_enorm_rpow_le_of_support {d : ℕ} {h : Euclidean d → ℂ} (hh : Measurable h)
    {r : ℝ} (hsupp : ∀ y, r < ‖y‖ → h y = 0) {p : ℝ} (hp : 1 ≤ p) :
    (∫⁻ y, ‖h y‖ₑ) ^ p ≤
      volume (Metric.closedBall (0 : Euclidean d) r) ^ (p - 1) * ∫⁻ y, ‖h y‖ₑ ^ p := by
  set B := Metric.closedBall (0 : Euclidean d) r
  have hB : MeasurableSet B := measurableSet_closedBall
  have hsplit : (fun y => ‖h y‖ₑ) = fun y => B.indicator (fun _ => (1 : ℝ≥0∞)) y * ‖h y‖ₑ := by
    funext y
    by_cases hy : y ∈ B
    · simp [Set.indicator_of_mem hy]
    · have : r < ‖y‖ := by simpa [B, Metric.mem_closedBall, dist_zero_right] using hy
      simp [Set.indicator_of_notMem hy, hsupp y this]
  calc
    _ = (∫⁻ y, B.indicator (fun _ => (1 : ℝ≥0∞)) y * ‖h y‖ₑ) ^ p := by
      rw [show (fun y => ‖h y‖ₑ) = _ from hsplit]
    _ ≤ (∫⁻ y, B.indicator (fun _ => (1 : ℝ≥0∞)) y) ^ (p - 1) *
        ∫⁻ y, B.indicator (fun _ => (1 : ℝ≥0∞)) y * ‖h y‖ₑ ^ p :=
      weighted_lintegral_rpow_le _ (measurable_const.indicator hB).aemeasurable
        hh.enorm.aemeasurable hp
    _ ≤ _ := by
      rw [lintegral_indicator_const hB, one_mul]
      apply mul_le_mul' le_rfl
      apply lintegral_mono
      intro y
      by_cases hy : y ∈ B <;> simp [hy]

/-- The volume of a spherical shell `A ≤ |x| ≤ B` with `0 ≤ A ≤ B ≤ 3`. -/
theorem volume_shell_le {d : ℕ} (hd : 0 < d) {A B : ℝ} (hA : 0 ≤ A) (hAB : A ≤ B) (hB : B ≤ 3) :
    volume {x : Euclidean d | A ≤ ‖x‖ ∧ ‖x‖ ≤ B} ≤
      ENNReal.ofReal ((d : ℝ) * 3 ^ (d - 1) * (B - A)) *
        volume (Metric.ball (0 : Euclidean d) 1) := by
  have : Nonempty (Fin d) := ⟨⟨0, hd⟩⟩
  have hS : {x : Euclidean d | A ≤ ‖x‖ ∧ ‖x‖ ≤ B} =
      Metric.closedBall 0 B \ Metric.ball 0 A := by
    ext x
    simp [Metric.mem_closedBall, Metric.mem_ball, dist_zero_right, and_comm]
  rw [hS, measure_sdiff (Metric.ball_subset_closedBall.trans
      (Metric.closedBall_subset_closedBall hAB)) measurableSet_ball.nullMeasurableSet
      measure_ball_lt_top.ne,
    Measure.addHaar_closedBall _ _ (hA.trans hAB), Measure.addHaar_ball _ _ hA,
    finrank_euclideanSpace_fin, ← ENNReal.sub_mul (fun _ _ => measure_ball_lt_top.ne),
    ← ENNReal.ofReal_sub _ (pow_nonneg hA _)]
  apply mul_le_mul' _ le_rfl
  apply ENNReal.ofReal_le_ofReal
  have h := abs_pow_sub_pow_le (a := B) (b := A) (n := d)
  rw [abs_of_nonneg (sub_nonneg.mpr (pow_le_pow_left₀ hA hAB d)),
    abs_of_nonneg (sub_nonneg.mpr hAB), abs_of_nonneg (hA.trans hAB), abs_of_nonneg hA,
    max_eq_left hAB] at h
  have hp : B ^ (d - 1) ≤ 3 ^ (d - 1) := pow_le_pow_left₀ (hA.trans hAB) hB _
  have hBA : 0 ≤ B - A := sub_nonneg.mpr hAB
  calc
    _ ≤ (B - A) * d * B ^ (d - 1) := h
    _ ≤ (B - A) * d * 3 ^ (d - 1) := by gcongr
    _ = _ := by ring

/-- Source `eq:Iaest`, regime `z ≥ 0`: on a radius interval `[a,b] ⊆ [1,2]`,
the smoothed spherical supremum of an input supported in a small ball is
pointwise `O(2^j ‖h‖₁)` and lives in a shell of width `b-a+2R`. -/
theorem exists_smoothed_shell_interval_bound {d : ℕ} (hd : 0 < d)
    (K : SchwartzMap (Euclidean d) ℂ) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : ℕ) (a b r ρ : ℝ), 1 ≤ a → a ≤ b → b ≤ 2 → 0 ≤ r → r ≤ 1 / 8 →
      0 ≤ ρ → ρ ≤ 1 / 8 → (∀ u, ρ < ‖u‖ → K u = 0) →
      ∀ (h : SchwartzMap (Euclidean d) ℂ), (∀ y, r < ‖y‖ → h y = 0) → ∀ {p : ℝ}, 1 ≤ p →
      (∫⁻ x, (⨆ t : Icc a b,
          ‖sphericalAverage d (compactConvolution (compactDyadicDilate K j) h) t x‖ₑ) ^ p) ≤
        ENNReal.ofReal (C * (2 : ℝ) ^ j) ^ p *
          volume (Metric.closedBall (0 : Euclidean d) r) ^ (p - 1) *
          (ENNReal.ofReal ((d : ℝ) * 3 ^ (d - 1) * (b - a + 2 * (r + ρ / (2 : ℝ) ^ j))) *
            volume (Metric.ball (0 : Euclidean d) 1)) * ∫⁻ y, ‖h y‖ₑ ^ p := by
  obtain ⟨C, hC, hb⟩ := exists_smoothed_sphericalAverage_pointwise_bound hd K
  refine ⟨C, hC, ?_⟩
  intro j a b r ρ ha hab hb2 hr hr8 hρ hρ8 hK h hh p hp
  set F := compactConvolution (compactDyadicDilate K j) h
  set R := r + ρ / (2 : ℝ) ^ j
  have hj : (1 : ℝ) ≤ 2 ^ j := one_le_pow₀ (by norm_num)
  have hρj : ρ / (2 : ℝ) ^ j ≤ ρ := div_le_self hρ hj
  have hR0 : 0 ≤ R := by positivity
  have hR : R ≤ 1 / 4 := by linarith
  have hF : ∀ z, R < ‖z‖ → F z = 0 := fun z hz =>
    compactConvolution_eq_zero_of_radius _ _
      (fun u hu => compactDyadicDilate_eq_zero hK j hu) hh (by linarith)
  set S := {x : Euclidean d | a - R ≤ ‖x‖ ∧ ‖x‖ ≤ b + R}
  have hSm : MeasurableSet S :=
    (measurableSet_le measurable_const measurable_norm).inter
      (measurableSet_le measurable_norm measurable_const)
  set M := ENNReal.ofReal (C * (2 : ℝ) ^ j) * ∫⁻ y, ‖h y‖ₑ
  have hp0 : 0 < p := by linarith
  have hpoint (x : Euclidean d) :
      (⨆ t : Icc a b, ‖sphericalAverage d F t x‖ₑ) ^ p ≤ S.indicator (fun _ => M ^ p) x := by
    by_cases hx : x ∈ S
    · rw [Set.indicator_of_mem hx]
      apply ENNReal.rpow_le_rpow _ hp0.le
      exact iSup_le fun t => hb j t (ha.trans t.2.1) h x
    · rw [Set.indicator_of_notMem hx]
      have hzero : ∀ t : Icc a b, sphericalAverage d F t x = 0 := by
        intro t
        unfold sphericalAverage
        apply integral_eq_zero_of_ae
        filter_upwards with ω
        apply hF
        have hω : ‖(ω : Euclidean d)‖ = 1 := by simp
        have ht0 : 0 ≤ (t : ℝ) := by linarith [t.2.1]
        have htw : ‖(t : ℝ) • (ω : Euclidean d)‖ = t := by
          rw [norm_smul, hω, mul_one, Real.norm_of_nonneg ht0]
        simp only [S, Set.mem_ofPred_eq, not_and_or, not_le] at hx
        rcases hx with hx | hx
        · have := norm_sub_norm_le ((t : ℝ) • (ω : Euclidean d)) (-x)
          rw [htw, norm_neg, sub_neg_eq_add, add_comm] at this
          linarith [t.2.1]
        · have := norm_sub_norm_le x (-((t : ℝ) • (ω : Euclidean d)))
          rw [norm_neg, htw, sub_neg_eq_add] at this
          linarith [t.2.2]
      simp [hzero, ENNReal.zero_rpow_of_pos hp0]
  calc
    _ ≤ ∫⁻ x, S.indicator (fun _ => M ^ p) x := lintegral_mono hpoint
    _ = M ^ p * volume S := lintegral_indicator_const hSm _
    _ ≤ (ENNReal.ofReal (C * (2 : ℝ) ^ j) ^ p *
          (volume (Metric.closedBall (0 : Euclidean d) r) ^ (p - 1) * ∫⁻ y, ‖h y‖ₑ ^ p)) *
        (ENNReal.ofReal ((d : ℝ) * 3 ^ (d - 1) * (b - a + 2 * R)) *
          volume (Metric.ball (0 : Euclidean d) 1)) := by
      apply mul_le_mul'
      · rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
        exact mul_le_mul' le_rfl
          (lintegral_enorm_rpow_le_of_support h.continuous.measurable hh hp)
      · have hv := volume_shell_le (d := d) hd (A := a - R) (B := b + R) (by linarith)
          (by linarith) (by linarith)
        convert hv using 3
        ring
    _ = _ := by ring

theorem normalizedRadiusDerivative_apply {d : ℕ}
    (K f : SchwartzMap (Euclidean d) ℂ) (j : ℕ) (t : ℝ) (x : Euclidean d) :
    normalizedRadiusDerivative K f j t x =
      (((2 : ℝ) ^ j)⁻¹) •
        sphericalRadiusDerivative (compactConvolution (compactDyadicDilate K j) f) t x := by
  rw [normalizedRadiusDerivative, smul_apply, schwartzSphericalRadiusDerivative_apply]

/-- The interpolation coefficient of the Section 2 intermediate bounds at the
balancing amplitude `s = 2^{j(d-1)}`, with a fixed output ball of radius `R`. -/
theorem intermediate_coefficient_balance (C₁ : ℝ≥0∞) (C₂ R : ℝ) (d j : ℕ) (p : ℝ) :
    ENNReal.ofReal p *
        (4 * ENNReal.ofReal ((C₂ / ((2 : ℝ) ^ j) ^ (((d : ℝ) - 1) / 2)) ^ 2) *
            (ENNReal.ofReal ((2 : ℝ) ^ ((j : ℝ) * ((d : ℝ) - 1)))) ^ (2 - p) *
              lowSplitConstant p +
          2 * (C₁ * ENNReal.ofReal (R ^ (d - 1))) *
            (ENNReal.ofReal ((2 : ℝ) ^ ((j : ℝ) * ((d : ℝ) - 1)))) ^ (1 - p) *
              highSplitConstant p) =
      ENNReal.ofReal p * (4 * ENNReal.ofReal (C₂ ^ 2) * lowSplitConstant p +
          2 * (C₁ * ENNReal.ofReal (R ^ (d - 1))) * highSplitConstant p) *
        (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1))) := by
  rw [dyadic_square_multiplier_factor,
    ← ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 2), ENNReal.ofReal_ofNat]
  have h1 : (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1))) *
      ((2 : ℝ≥0∞) ^ ((j : ℝ) * ((d : ℝ) - 1))) ^ (2 - p) =
      (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1))) := by
    rw [← ENNReal.rpow_mul,
      ← ENNReal.rpow_add _ _ (by norm_num : (2 : ℝ≥0∞) ≠ 0) (by norm_num : (2 : ℝ≥0∞) ≠ ∞)]
    congr 1; ring
  have h2 : ((2 : ℝ≥0∞) ^ ((j : ℝ) * ((d : ℝ) - 1))) ^ (1 - p) =
      (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1))) := by
    rw [← ENNReal.rpow_mul]; congr 1; ring
  calc
    _ = ENNReal.ofReal p * (4 * ENNReal.ofReal (C₂ ^ 2) * lowSplitConstant p *
          ((2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1))) *
            ((2 : ℝ≥0∞) ^ ((j : ℝ) * ((d : ℝ) - 1))) ^ (2 - p)) +
        2 * (C₁ * ENNReal.ofReal (R ^ (d - 1))) * highSplitConstant p *
          ((2 : ℝ≥0∞) ^ ((j : ℝ) * ((d : ℝ) - 1))) ^ (1 - p)) := by ring
    _ = _ := by rw [h1, h2]; ring

/-- Source `eq:ple2part`, one short radius interval: for `1 < p < 2` the
supremum over an interval of length `2^{-j}` of the smoothed spherical
average obeys the fixed-time decay `2^{-j(d-1)(p-1)}` on the ball of radius
four. -/
theorem exists_smoothed_interval_Lp_bound_lt_two {d N : ℕ} (hd : 2 ≤ d)
    (K : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d)) (fun ξ => 𝓕 K ξ) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) {p : ℝ} (hp₁ : 1 < p) (hp₂ : p < 2) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (j : ℕ) (a b : ℝ), 1 ≤ a → a ≤ b → b ≤ 2 →
      b - a ≤ ((2 : ℝ) ^ j)⁻¹ → ∀ (h : SchwartzMap (Euclidean d) ℂ),
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) 4, (⨆ t : Icc a b,
          ‖sphericalAverage d (compactConvolution (compactDyadicDilate K j) h) t x‖ₑ) ^ p) ≤
        A * (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1))) * ∫⁻ y, ‖h y‖ₑ ^ p := by
  obtain ⟨C₁, C₂, hC₁, hC₂, hb₁⟩ := smoothed_sphericalAverage_intermediate_bound hd K hflat hN
  obtain ⟨D₁, D₂, hD₁, hD₂, hb₂⟩ := normalizedRadiusDerivative_intermediate_bound hd K hflat hN
  set A₁ := ENNReal.ofReal p * (4 * ENNReal.ofReal (C₂ ^ 2) * lowSplitConstant p +
    2 * (C₁ * ENNReal.ofReal ((4 : ℝ) ^ (d - 1))) * highSplitConstant p)
  set A₂ := ENNReal.ofReal p * (4 * ENNReal.ofReal (D₂ ^ 2) * lowSplitConstant p +
    2 * (D₁ * ENNReal.ofReal ((4 : ℝ) ^ (d - 1))) * highSplitConstant p)
  have hA₁ : A₁ ≠ ∞ := by
    have := lowSplitConstant_ne_top hp₁ hp₂
    have := highSplitConstant_ne_top hp₁ hp₂
    dsimp only [A₁]; finiteness
  have hA₂ : A₂ ≠ ∞ := by
    have := lowSplitConstant_ne_top hp₁ hp₂
    have := highSplitConstant_ne_top hp₁ hp₂
    dsimp only [A₂]; finiteness
  refine ⟨(2 : ℝ≥0∞) ^ p * (A₁ + A₂), by finiteness, ?_⟩
  intro j a b ha hab hb hlen h
  let g := compactConvolution (compactDyadicDilate K j) h
  let s : ℝ := (2 : ℝ) ^ ((j : ℝ) * ((d : ℝ) - 1))
  have hs : 0 < s := Real.rpow_pos_of_pos (by norm_num) _
  let W := (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1) * (p - 1))) * ∫⁻ y, ‖h y‖ₑ ^ p
  have hF (t : ℝ) : Measurable (sphericalAverage d g t) := by
    rw [← schwartzSphericalAverage_apply]
    exact (schwartzSphericalAverage g t).continuous.measurable
  have hD := continuous_sphericalRadiusDerivative g
  have hDc (x : Euclidean d) : Continuous (fun t => sphericalRadiusDerivative g t x) := by
    have hc : Continuous (fun t : ℝ => (t, x)) := continuous_id.prodMk continuous_const
    have hc' := hD.comp hc
    exact hc'
  have hfixed (t : ℝ) (ht : t ∈ Icc (1 : ℝ) 2) :
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) 4, ‖sphericalAverage d g t x‖ₑ ^ p) ≤
        A₁ * W := by
    have hi := hb₁ j t 4 ht.1 (by norm_num) p s hp₁ hp₂ hs h
    rw [intermediate_coefficient_balance] at hi
    exact hi.trans_eq (by simp only [A₁, W]; ring)
  have hderivative (t : ℝ) (ht : t ∈ Icc (1 : ℝ) 2) :
      (∫⁻ x in Metric.closedBall (0 : Euclidean d) 4,
        ‖(((2 : ℝ) ^ j)⁻¹) • sphericalRadiusDerivative g t x‖ₑ ^ p) ≤ A₂ * W := by
    have hi := hb₂ j t 4 ht (by norm_num) p s hp₁ hp₂ hs h
    rw [intermediate_coefficient_balance] at hi
    simp only [normalizedRadiusDerivative_apply] at hi
    exact hi.trans_eq (by simp only [A₂, W]; ring)
  have hb' := finite_interval_cover_maximal_moment
    (X := Euclidean d) (ι := ℝ) (p := p) (δ := ((2 : ℝ) ^ j)⁻¹)
    (E := Icc a b) (J := Icc 1 2)
    (volume.restrict (Metric.closedBall (0 : Euclidean d) 4))
    (sphericalAverage d g) (sphericalRadiusDerivative g) hF hD.measurable hDc
    (hasDerivAt_sphericalAverage_schwartz g) {a} (fun _ => a) (fun _ => b)
    (fun _ _ => hab) (fun _ _ => Icc_subset_Icc ha hb) (fun t ht => ⟨a, by simp, ht⟩)
    hp₁.le (by positivity) (fun _ _ => hlen) (A₁ * W) (A₂ * W) hfixed hderivative
  apply hb'.trans_eq
  simp only [Finset.card_singleton, Nat.cast_one, mul_one, W]
  ring

/-- Hölder on the support ball, quadratic form:
`‖h‖₂² ≤ |B_r|^{1-2/p} (‖h‖_p^p)^{2/p}` for `p ≥ 2`. -/
theorem lintegral_enorm_sq_le_of_support {d : ℕ} {h : Euclidean d → ℂ} (hh : Measurable h)
    {r : ℝ} (hsupp : ∀ y, r < ‖y‖ → h y = 0) {p : ℝ} (hp : 2 ≤ p) :
    (∫⁻ y, ‖h y‖ₑ ^ (2 : ℝ)) ≤
      volume (Metric.closedBall (0 : Euclidean d) r) ^ (1 - 2 / p) *
        (∫⁻ y, ‖h y‖ₑ ^ p) ^ (2 / p) := by
  set B := Metric.closedBall (0 : Euclidean d) r
  have hB : MeasurableSet B := measurableSet_closedBall
  have hp0 : 0 < p := by linarith
  set q := p / 2
  have hq : 1 ≤ q := by dsimp only [q]; linarith
  have hsplit : (fun y => ‖h y‖ₑ ^ (2 : ℝ)) =
      fun y => B.indicator (fun _ => (1 : ℝ≥0∞)) y * ‖h y‖ₑ ^ (2 : ℝ) := by
    funext y
    by_cases hy : y ∈ B
    · simp [Set.indicator_of_mem hy]
    · have : r < ‖y‖ := by simpa [B, Metric.mem_closedBall, dist_zero_right] using hy
      simp [Set.indicator_of_notMem hy, hsupp y this]
  have hhol : (∫⁻ y, ‖h y‖ₑ ^ (2 : ℝ)) ^ q ≤ volume B ^ (q - 1) * ∫⁻ y, ‖h y‖ₑ ^ p := by
    calc
      _ = (∫⁻ y, B.indicator (fun _ => (1 : ℝ≥0∞)) y * ‖h y‖ₑ ^ (2 : ℝ)) ^ q := by
        rw [show (fun y => ‖h y‖ₑ ^ (2 : ℝ)) = _ from hsplit]
      _ ≤ (∫⁻ y, B.indicator (fun _ => (1 : ℝ≥0∞)) y) ^ (q - 1) *
          ∫⁻ y, B.indicator (fun _ => (1 : ℝ≥0∞)) y * (‖h y‖ₑ ^ (2 : ℝ)) ^ q :=
        weighted_lintegral_rpow_le _ (measurable_const.indicator hB).aemeasurable
          (hh.enorm.pow_const _).aemeasurable hq
      _ ≤ _ := by
        rw [lintegral_indicator_const hB, one_mul]
        apply mul_le_mul' le_rfl
        apply lintegral_mono
        intro y
        dsimp only
        rw [← ENNReal.rpow_mul, show (2 : ℝ) * q = p by dsimp only [q]; ring]
        by_cases hy : y ∈ B <;> simp [hy]
  have hq0 : 0 < q := by linarith
  calc
    _ = ((∫⁻ y, ‖h y‖ₑ ^ (2 : ℝ)) ^ q) ^ (1 / q) := by
      rw [← ENNReal.rpow_mul, mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ ≤ (volume B ^ (q - 1) * ∫⁻ y, ‖h y‖ₑ ^ p) ^ (1 / q) :=
      ENNReal.rpow_le_rpow hhol (by positivity)
    _ = _ := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul]
      congr 2
      · dsimp only [q]; field_simp
      · dsimp only [q]; field_simp

/-- Operator interpolation on a fixed spatial support. Smooth level truncations
preserve that support, so the weak-Lq/Linfinity argument applies without a
density passage or loss from the volume of the input support. -/
theorem schwartz_strong_q_top_moment_on_support
    {d : ℕ} {Y : Type*} [MeasurableSpace Y] (ν : Measure Y) [SFinite ν]
    (S : Set (Euclidean d)) (T : SchwartzMap (Euclidean d) ℂ → Y → ℝ)
    (hTnonneg : ∀ f y, 0 ≤ T f y)
    (hTsub : ∀ f g y, T (f + g) y ≤ T f y + T g y)
    (hTmeas : ∀ f, AEMeasurable (T f) ν)
    {q p : ℝ} (hq : 0 < q) (hqp : q < p) (A : ℝ≥0∞)
    (hstrong : ∀ f : SchwartzMap (Euclidean d) ℂ,
      (∀ x, x ∉ S → f x = 0) →
      (∫⁻ y, ENNReal.ofReal (T f y) ^ q ∂ν) ≤ A * ∫⁻ x, ‖f x‖ₑ ^ q)
    (htop : ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∀ x, x ∉ S → f x = 0) →
      ∀ a : ℝ, 0 ≤ a → (∀ x, ‖f x‖ ≤ a) → ∀ y, T f y ≤ a)
    (f : SchwartzMap (Euclidean d) ℂ) (hf : ∀ x, x ∉ S → f x = 0) :
    (∫⁻ y, ENNReal.ofReal (T f y) ^ p ∂ν) ≤
      (ENNReal.ofReal p * (2 : ℝ≥0∞) ^ q * (ENNReal.ofReal (p - q))⁻¹ *
        (4 : ℝ≥0∞) ^ (p - q)) * A * ∫⁻ x, ‖f x‖ₑ ^ p := by
  let D : Set (SchwartzMap (Euclidean d) ℂ) := {g | ∀ x, x ∉ S → g x = 0}
  have hweak (g : SchwartzMap (Euclidean d) ℂ) (hg : g ∈ D) {a : ℝ} (ha : 0 < a) :
      ENNReal.ofReal a ^ q * ν {y | a < T g y} ≤ A * ∫⁻ x, ‖g x‖ₑ ^ q := by
    have hsub : {y | a < T g y} ⊆
        {y | ENNReal.ofReal a ^ q ≤ ENNReal.ofReal (T g y) ^ q} := by
      intro y hy
      exact ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal hy.le) hq.le
    exact (mul_le_mul' le_rfl (measure_mono hsub)).trans
      ((mul_meas_ge_le_lintegral₀ ((hTmeas g).ennreal_ofReal.pow_const q) _).trans
        (hstrong g hg))
  obtain ⟨low, high, hlow, hhigh, hsplit⟩ := Auto.Spherical.Auxiliary.exists_schwartz_smooth_low_high_family f
  have hlowD (t : ℝ) : low t ∈ D := by
    intro x hx
    rw [hlow t x, hf x hx, smul_zero]
  have hhighD (t : ℝ) : high t ∈ D := by
    intro x hx
    rw [hhigh t, sub_apply, hf x hx, hlowD t x hx, sub_self]
  have h := Auto.MarcinkiewiczInterpolation.sourceOutput_marcinkiewicz_weak_q_top_on_additive_split
    (μ := volume) (ν := ν) D
    (fun g : SchwartzMap (Euclidean d) ℂ => (g : Euclidean d → ℂ))
    T hTnonneg (fun {_ _} _ _ => hTsub _ _) q hq A
    (by simpa only [ofReal_norm] using hweak)
    (fun g hg => htop g hg) hqp f (hTmeas f) low high hlowD hhighD
    (fun t => by ext x; exact hsplit t x)
    (fun t ht x => Auto.Spherical.Auxiliary.smooth_low_norm_le_half_height f (low t) ht (hlow t) x)
    (Auto.Spherical.Auxiliary.measurable_smooth_high_profile_lintegrals f low high hlow hhigh q)
    _ (Auto.Spherical.Auxiliary.smooth_bump_schwartz_high_q_weighted_tail f low high hlow hhigh hq hqp)
  have heq : (fun y => ENNReal.ofReal ((T f y) ^ p)) =
      fun y => ENNReal.ofReal (T f y) ^ p := by
    funext y
    exact (ENNReal.ofReal_rpow_of_nonneg (hTnonneg f y) (hq.trans hqp).le).symm
  rw [heq] at h
  simpa only [ofReal_norm, ENNReal.ofReal_ofNat, mul_assoc, mul_left_comm, mul_comm] using h

/-- The support-preserving interpolation estimate with both endpoint
constants explicit. In particular the top constant contributes power p-q. -/
theorem schwartz_strong_q_top_moment_on_support_scaled
    {d : ℕ} {Y : Type*} [MeasurableSpace Y] (ν : Measure Y) [SFinite ν]
    (S : Set (Euclidean d)) (T : SchwartzMap (Euclidean d) ℂ → Y → ℝ)
    (hTnonneg : ∀ f y, 0 ≤ T f y)
    (hTsub : ∀ f g y, T (f + g) y ≤ T f y + T g y)
    (hTmeas : ∀ f, AEMeasurable (T f) ν)
    {q p : ℝ} (hq : 0 < q) (hqp : q < p) (A : ℝ≥0∞) (B : ℝ) (hB : 0 < B)
    (hstrong : ∀ f : SchwartzMap (Euclidean d) ℂ,
      (∀ x, x ∉ S → f x = 0) →
      (∫⁻ y, ENNReal.ofReal (T f y) ^ q ∂ν) ≤ A * ∫⁻ x, ‖f x‖ₑ ^ q)
    (htop : ∀ (f : SchwartzMap (Euclidean d) ℂ),
      (∀ x, x ∉ S → f x = 0) →
      ∀ a : ℝ, 0 ≤ a → (∀ x, ‖f x‖ ≤ a) → ∀ y, T f y ≤ B * a)
    (f : SchwartzMap (Euclidean d) ℂ) (hf : ∀ x, x ∉ S → f x = 0) :
    (∫⁻ y, ENNReal.ofReal (T f y) ^ p ∂ν) ≤
      (ENNReal.ofReal p * (2 : ℝ≥0∞) ^ q * (ENNReal.ofReal (p - q))⁻¹ *
        (4 : ℝ≥0∞) ^ (p - q)) * A * ENNReal.ofReal B ^ (p - q) *
          ∫⁻ x, ‖f x‖ₑ ^ p := by
  let U : SchwartzMap (Euclidean d) ℂ → Y → ℝ := fun g y => T g y / B
  have hUm (g) : AEMeasurable (U g) ν := (hTmeas g).div_const B
  have hscale (g : SchwartzMap (Euclidean d) ℂ) (r : ℝ) (hr : 0 ≤ r) :
      (∫⁻ y, ENNReal.ofReal (U g y) ^ r ∂ν) =
        (ENNReal.ofReal B ^ r)⁻¹ * ∫⁻ y, ENNReal.ofReal (T g y) ^ r ∂ν := by
    simp only [U, ENNReal.ofReal_div_of_pos hB]
    simp only [div_eq_mul_inv, ENNReal.mul_rpow_of_nonneg _ _ hr, ENNReal.inv_rpow]
    rw [lintegral_mul_const' _ _ (ENNReal.inv_ne_top.mpr (ne_of_gt (by positivity))), mul_comm]
  have hUs (g : SchwartzMap (Euclidean d) ℂ) (hg : ∀ x, x ∉ S → g x = 0) :
      (∫⁻ y, ENNReal.ofReal (U g y) ^ q ∂ν) ≤
        ((ENNReal.ofReal B ^ q)⁻¹ * A) * ∫⁻ x, ‖g x‖ₑ ^ q := by
    rw [hscale _ _ hq.le, mul_assoc]
    exact mul_le_mul' le_rfl (hstrong g hg)
  have h := schwartz_strong_q_top_moment_on_support ν S U
    (fun g y => div_nonneg (hTnonneg g y) hB.le)
    (fun g h y => by
      dsimp [U]
      rw [← add_div]
      exact div_le_div_of_nonneg_right (hTsub g h y) hB.le)
    hUm hq hqp ((ENNReal.ofReal B ^ q)⁻¹ * A) hUs
    (fun g hg a ha hga y => by
      dsimp [U]
      rw [div_le_iff₀ hB]
      simpa [mul_comm] using htop g hg a ha hga y) f hf
  have hp : 0 < p := hq.trans hqp
  rw [hscale _ _ hp.le] at h
  have hb0 : ENNReal.ofReal B ≠ 0 := (ENNReal.ofReal_pos.mpr hB).ne'
  have hbtop : ENNReal.ofReal B ≠ ∞ := ENNReal.ofReal_ne_top
  have hbp0 : ENNReal.ofReal B ^ p ≠ 0 := ne_of_gt (by positivity)
  have hbptop := ENNReal.rpow_ne_top_of_nonneg hp.le hbtop
  have hh := mul_le_mul' (le_refl (ENNReal.ofReal B ^ p)) h
  rw [← mul_assoc, ENNReal.mul_inv_cancel hbp0 hbptop, one_mul] at hh
  apply hh.trans_eq
  rw [ENNReal.rpow_sub p q hb0 hbtop, div_eq_mul_inv]
  ring


/-- Schwartz data have a finite radius supremum, even before localization. -/
theorem schwartz_spherical_sup_ne_top {d : ℕ}
    (f : SchwartzMap (Euclidean d) ℂ) (E : Set ℝ) (x : Euclidean d) :
    (⨆ t : E, ‖sphericalAverage d f t x‖ₑ) ≠ ∞ := by
  let B := ‖f.toBoundedContinuousFunction‖
  have hbound (y : Euclidean d) : ‖f y‖ₑ ≤ ENNReal.ofReal B := by
    rw [← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal
      (BoundedContinuousFunction.norm_coe_le_norm f.toBoundedContinuousFunction y)
  apply ne_top_of_le_ne_top
    (show (unitSurfaceMeasure d) univ * ENNReal.ofReal B ≠ ∞ by finiteness)
  apply iSup_le
  intro t
  apply (enorm_integral_le_lintegral_enorm _).trans
  calc
    (∫⁻ ω : Metric.sphere (0 : Euclidean d) 1,
        ‖f (x + (t : ℝ) • (ω : Euclidean d))‖ₑ ∂unitSurfaceMeasure d) ≤
      ∫⁻ _ω : Metric.sphere (0 : Euclidean d) 1,
        ENNReal.ofReal B ∂unitSurfaceMeasure d := lintegral_mono fun _ => hbound _
    _ = _ := by simp [mul_comm]

/-- The top endpoint retains the small incidence-cap mass. -/
theorem sphericalAverage_supported_enorm_le {d : ℕ}
    (f : SchwartzMap (Euclidean d) ℂ) {R H : ℝ}
    (hf : ∀ y, R < ‖y‖ → f y = 0) (hH : ∀ y, ‖f y‖ ≤ H)
    (t : ℝ) (x : Euclidean d) :
    ‖sphericalAverage d f t x‖ₑ ≤
      unitSurfaceMeasure d {ω : Metric.sphere (0 : Euclidean d) 1 |
        -x - t • (ω : Euclidean d) ∈ Metric.closedBall 0 R} * ENNReal.ofReal H := by
  let C : Set (Metric.sphere (0 : Euclidean d) 1) :=
    {ω | -x - t • (ω : Euclidean d) ∈ Metric.closedBall 0 R}
  have hC : MeasurableSet C := measurableSet_closedBall.preimage (by fun_prop)
  apply (enorm_integral_le_lintegral_enorm _).trans
  calc
    (∫⁻ ω : Metric.sphere (0 : Euclidean d) 1,
        ‖f (x + t • (ω : Euclidean d))‖ₑ ∂unitSurfaceMeasure d) ≤
      ∫⁻ ω, C.indicator (fun _ => ENNReal.ofReal H) ω ∂unitSurfaceMeasure d := by
      apply lintegral_mono
      intro ω
      dsimp only
      by_cases hω : ω ∈ C
      · rw [Set.indicator_of_mem hω, ← ofReal_norm]
        exact ENNReal.ofReal_le_ofReal (hH _)
      · rw [Set.indicator_of_notMem hω]
        have hz : R < ‖x + t • (ω : Euclidean d)‖ := by
          have hn : ¬ ‖-x - t • (ω : Euclidean d)‖ ≤ R := by
            simpa [C, Metric.mem_closedBall, dist_zero_right] using hω
          rw [show -x - t • (ω : Euclidean d) = -(x + t • (ω : Euclidean d)) by abel,
            norm_neg] at hn
          exact lt_of_not_ge hn
        rw [hf _ hz, enorm_zero]
    _ = _ := by rw [lintegral_indicator_const hC, mul_comm]

/-- The convolution top endpoint is its absolute kernel mass. -/
theorem compactConvolution_norm_le_of_bound {d : ℕ}
    (K f : SchwartzMap (Euclidean d) ℂ) {a : ℝ} (ha : 0 ≤ a)
    (hf : ∀ y, ‖f y‖ ≤ a) (x : Euclidean d) :
    ‖compactConvolution K f x‖ ≤ (∫ y, ‖K y‖) * a := by
  have h := enorm_compactConvolution_rpow_le K f (p := 1) le_rfl x
  simp only [ENNReal.rpow_one, sub_self, ENNReal.rpow_zero, one_mul] at h
  have hh : ‖compactConvolution K f x‖ₑ ≤
      (∫⁻ y, ‖K y‖ₑ) * ENNReal.ofReal a := by
    apply h.trans
    calc
      _ ≤ ∫⁻ y, ‖K y‖ₑ * ENNReal.ofReal a := by
        apply lintegral_mono
        intro y
        apply mul_le_mul' le_rfl
        rw [← ofReal_norm]
        exact ENNReal.ofReal_le_ofReal (hf _)
      _ = _ := lintegral_mul_const _ K.continuous.measurable.enorm
  rw [← ofReal_norm, ← ofReal_integral_norm_eq_lintegral_enorm K.integrable,
    ← ENNReal.ofReal_mul (integral_nonneg fun _ => norm_nonneg _)] at hh
  exact (ENNReal.ofReal_le_ofReal_iff (mul_nonneg (integral_nonneg fun _ => norm_nonneg _) ha)).mp hh


/-- Source `eq:pge2part`, one short radius interval: for `p ≥ 2` the supremum
over an interval of length `2^{-j}` is controlled by log-convexity between the
cap-Hölder `L^∞` bound and the `L²` decay `2^{-j(d-1)}`. -/
theorem exists_smoothed_interval_Lp_bound_ge_two {d N : ℕ} (hd : 2 ≤ d)
    (K : SchwartzMap (Euclidean d) ℂ)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d)) (fun ξ => 𝓕 K ξ) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) :
    ∃ C : ℝ, 0 < C ∧ ∃ I : ℝ≥0∞, I ≠ ∞ ∧ ∃ A : ℝ≥0∞, A ≠ ∞ ∧
      ∀ (j : ℕ) (a b r ρ : ℝ), 1 ≤ a → a ≤ b → b ≤ 2 →
      b - a ≤ ((2 : ℝ) ^ j)⁻¹ → 0 < r → 0 ≤ ρ → ρ / (2 : ℝ) ^ j ≤ r →
      (∀ u, ρ < ‖u‖ → K u = 0) →
      ∀ (h : SchwartzMap (Euclidean d) ℂ), (∀ y, r < ‖y‖ → h y = 0) → ∀ {p : ℝ}, 2 ≤ p →
      (∫⁻ x, (⨆ t : Icc a b,
          ‖sphericalAverage d (compactConvolution (compactDyadicDilate K j) h) t x‖ₑ) ^ p) ≤
        ((I * ENNReal.ofReal ((2 * r) ^ (d - 1))) ^ (p - 1) * (∫⁻ y, ‖K y‖ₑ) ^ (p - 1) *
            ENNReal.ofReal (C * (2 : ℝ) ^ j) *
            volume (Metric.closedBall (0 : Euclidean d) r)) ^ (1 - 2 / p) *
          (A * (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1)))) * ∫⁻ y, ‖h y‖ₑ ^ p := by
  obtain ⟨C, hC, hpt⟩ := exists_smoothed_sphericalAverage_pointwise_rpow_bound (by omega) K
  obtain ⟨I, hI, hinc⟩ := sphere_smallBall_incidence_bound (d := d) (by omega)
  obtain ⟨C₂, hC₂, hb₁⟩ := smoothed_sphericalAverage_L2_moment_bound hd K hflat hN
  obtain ⟨D₂, hD₂, hb₂⟩ := normalizedRadiusDerivative_L2_bound hd K hflat hN
  refine ⟨C, hC, I, hI, (2 : ℝ≥0∞) ^ (2 : ℝ) * (ENNReal.ofReal (C₂ ^ 2) + ENNReal.ofReal (D₂ ^ 2)),
    by finiteness, ?_⟩
  intro j a b r ρ ha hab hb hlen hr hρ hρr hK h hh p hp
  let g := compactConvolution (compactDyadicDilate K j) h
  have hp0 : 0 < p := by linarith
  have hgs : ∀ z, 2 * r < ‖z‖ → g z = 0 := fun z hz =>
    compactConvolution_eq_zero_of_radius _ _
      (fun u hu => compactDyadicDilate_eq_zero hK j hu) hh (by linarith)
  set X := ∫⁻ y, ‖h y‖ₑ ^ p
  set Mp := (I * ENNReal.ofReal ((2 * r) ^ (d - 1))) ^ (p - 1) * (∫⁻ y, ‖K y‖ₑ) ^ (p - 1) *
    ENNReal.ofReal (C * (2 : ℝ) ^ j) * X
  set G := fun x => ⨆ t : Icc a b, ‖sphericalAverage d g t x‖ₑ
  have hGm : Measurable G := measurable_schwartz_radius_supremum g _
  -- the `L^∞` bound
  have hsup (x : Euclidean d) : G x ^ p ≤ Mp := by
    apply (ENNReal.le_rpow_inv_iff hp0).mp
    apply iSup_le
    intro t
    apply (ENNReal.le_rpow_inv_iff hp0).mpr
    have ht1 : 1 ≤ (t : ℝ) := ha.trans t.2.1
    apply (hpt j t ht1 h (2 * r) hgs (by linarith) x).trans
    apply mul_le_mul' (mul_le_mul' (mul_le_mul' _ le_rfl) le_rfl) le_rfl
    apply ENNReal.rpow_le_rpow _ (by linarith)
    exact hinc t (2 * r) ht1 (by positivity) (-x)
  -- the `L²` interval bound
  have hF (t : ℝ) : Measurable (sphericalAverage d g t) := by
    rw [← schwartzSphericalAverage_apply]
    exact (schwartzSphericalAverage g t).continuous.measurable
  have hD := continuous_sphericalRadiusDerivative g
  have hDc (x : Euclidean d) : Continuous (fun t => sphericalRadiusDerivative g t x) := by
    have hc : Continuous (fun t : ℝ => (t, x)) := continuous_id.prodMk continuous_const
    have hc' := hD.comp hc
    exact hc'
  set Y := ∫⁻ y, ‖h y‖ₑ ^ (2 : ℝ)
  have hfixed (t : ℝ) (ht : t ∈ Icc (1 : ℝ) 2) :
      (∫⁻ x, ‖sphericalAverage d g t x‖ₑ ^ (2 : ℝ)) ≤
        ENNReal.ofReal (C₂ ^ 2) * (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1))) * Y := by
    have hi := hb₁ j t ht.1 h
    rw [dyadic_square_multiplier_factor] at hi
    simp only [ENNReal.rpow_two, Y]
    simpa only [ENNReal.rpow_two, pow_two] using hi
  have hderivative (t : ℝ) (ht : t ∈ Icc (1 : ℝ) 2) :
      (∫⁻ x, ‖(((2 : ℝ) ^ j)⁻¹) • sphericalRadiusDerivative g t x‖ₑ ^ (2 : ℝ)) ≤
        ENNReal.ofReal (D₂ ^ 2) * (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1))) * Y := by
    have hi := hb₂ j t ht h
    rw [dyadic_square_multiplier_factor] at hi
    simp only [normalizedRadiusDerivative_apply] at hi
    simp only [ENNReal.rpow_two, Y]
    simpa only [ENNReal.rpow_two, pow_two] using hi
  have hL2 := finite_interval_cover_maximal_moment
    (X := Euclidean d) (ι := ℝ) (p := (2 : ℝ)) (δ := ((2 : ℝ) ^ j)⁻¹)
    (E := Icc a b) (J := Icc 1 2) volume
    (sphericalAverage d g) (sphericalRadiusDerivative g) hF hD.measurable hDc
    (hasDerivAt_sphericalAverage_schwartz g) {a} (fun _ => a) (fun _ => b)
    (fun _ _ => hab) (fun _ _ => Icc_subset_Icc ha hb) (fun t ht => ⟨a, by simp, ht⟩)
    (by norm_num) (by positivity) (fun _ _ => hlen) _ _ hfixed hderivative
  simp only [Finset.card_singleton, Nat.cast_one, mul_one] at hL2
  -- Hölder for the input
  have hY := lintegral_enorm_sq_le_of_support h.continuous.measurable hh hp
  -- log-convexity
  have hpos : 0 ≤ 1 - 2 / p := by rw [sub_nonneg, div_le_one hp0]; exact hp
  have hpoint (x : Euclidean d) : G x ^ p ≤ Mp ^ (1 - 2 / p) * G x ^ (2 : ℝ) := by
    have hsplit : G x ^ p = (G x ^ p) ^ (1 - 2 / p) * G x ^ (2 : ℝ) := by
      have h1 : 0 ≤ p * (1 - 2 / p) := mul_nonneg hp0.le hpos
      rw [← ENNReal.rpow_mul, ← ENNReal.rpow_add_of_nonneg _ _ h1 (by norm_num : (0 : ℝ) ≤ 2)]
      congr 1; field_simp; ring
    rw [hsplit]
    exact mul_le_mul' (ENNReal.rpow_le_rpow (hsup x) hpos) le_rfl
  calc
    _ ≤ ∫⁻ x, Mp ^ (1 - 2 / p) * G x ^ (2 : ℝ) := lintegral_mono hpoint
    _ = Mp ^ (1 - 2 / p) * ∫⁻ x, G x ^ (2 : ℝ) := lintegral_const_mul _ (hGm.pow_const _)
    _ ≤ Mp ^ (1 - 2 / p) * ((2 : ℝ≥0∞) ^ (2 : ℝ) *
        ((ENNReal.ofReal (C₂ ^ 2) + ENNReal.ofReal (D₂ ^ 2)) *
          (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1))) *
          (volume (Metric.closedBall (0 : Euclidean d) r) ^ (1 - 2 / p) * X ^ (2 / p)))) := by
      apply mul_le_mul' le_rfl
      apply hL2.trans
      apply mul_le_mul' le_rfl
      calc
        _ = (ENNReal.ofReal (C₂ ^ 2) + ENNReal.ofReal (D₂ ^ 2)) *
            (2 : ℝ≥0∞) ^ (-((j : ℝ) * ((d : ℝ) - 1))) * Y := by ring
        _ ≤ _ := mul_le_mul' le_rfl hY
    _ = _ := by
      have hX : X = X ^ (1 - 2 / p) * X ^ (2 / p) := by
        rw [← ENNReal.rpow_add_of_nonneg _ _ hpos (by positivity)]
        simp
      conv_rhs => rw [hX]
      simp only [Mp, ENNReal.mul_rpow_of_nonneg _ _ hpos]
      ring

/-- Geometric sums along an injective map into `ℕ` are bounded by the full series. -/
theorem sum_geometric_injOn_le {ι : Type*} (I : Finset ι) (f : ι → ℕ)
    (hf : Set.InjOn f (↑I : Set ι)) (r : ℝ≥0∞) :
    ∑ k ∈ I, r ^ f k ≤ (1 - r)⁻¹ := by
  classical
  rw [← Finset.sum_image (f := fun l => r ^ l) hf]
  exact (ENNReal.sum_le_tsum _).trans_eq (ENNReal.tsum_geometric r)

/-- Two-sided geometric sums: `∑_{k ∈ I} 2^{-c|x-k|} ≤ 2^{c+1} (1-2^{-c})^{-1}`
for every finite set of naturals and every real centre `x`. -/
theorem sum_two_rpow_neg_abs_le (I : Finset ℕ) (x : ℝ) {c : ℝ} (hc : 0 < c) :
    ∑ k ∈ I, (2 : ℝ≥0∞) ^ (-(c * |x - k|)) ≤
      2 * (2 : ℝ≥0∞) ^ c * (1 - (2 : ℝ≥0∞) ^ (-c))⁻¹ := by
  classical
  set r : ℝ≥0∞ := (2 : ℝ≥0∞) ^ (-c)
  set n0 : ℤ := ⌊x⌋
  have hn0 : (n0 : ℝ) ≤ x ∧ x < n0 + 1 := ⟨Int.floor_le x, Int.lt_floor_add_one x⟩
  -- each term is at most `2^c r^{|n0 - k|}`
  have hterm (k : ℕ) : (2 : ℝ≥0∞) ^ (-(c * |x - k|)) ≤
      (2 : ℝ≥0∞) ^ c * r ^ (Int.natAbs (n0 - k)) := by
    rw [show r ^ (Int.natAbs (n0 - k)) = (2 : ℝ≥0∞) ^ (-c * (Int.natAbs (n0 - k) : ℝ)) by
      rw [← ENNReal.rpow_natCast, ← ENNReal.rpow_mul],
      ← ENNReal.rpow_add _ _ (by norm_num) (by norm_num)]
    apply ENNReal.rpow_le_rpow_of_exponent_le (by norm_num)
    have habs : ((Int.natAbs (n0 - k) : ℕ) : ℝ) = |(n0 : ℝ) - k| := by
      rw [Nat.cast_natAbs, Int.cast_abs]; push_cast; ring_nf
    rw [habs]
    have : |(n0 : ℝ) - k| ≤ |x - k| + 1 := by
      calc
        |(n0 : ℝ) - k| = |((n0 : ℝ) - x) + (x - k)| := by ring_nf
        _ ≤ |(n0 : ℝ) - x| + |x - k| := abs_add_le _ _
        _ ≤ 1 + |x - k| := by
          gcongr
          rw [abs_le]; constructor <;> linarith
        _ = _ := by ring
    nlinarith
  have hsplit : ∑ k ∈ I, r ^ (Int.natAbs (n0 - k)) ≤ 2 * (1 - r)⁻¹ := by
    rw [← Finset.sum_filter_add_sum_filter_not I (fun k : ℕ => n0 ≤ (k : ℤ)), two_mul]
    apply add_le_add
    · apply sum_geometric_injOn_le
      intro a ha b hb hab
      simp only [Finset.coe_filter, Set.mem_ofPred_eq] at ha hb
      have h1 : ((Int.natAbs (n0 - a) : ℕ) : ℤ) = a - n0 := by omega
      have h2 : ((Int.natAbs (n0 - b) : ℕ) : ℤ) = b - n0 := by omega
      have : (a : ℤ) = b := by
        have := congrArg (fun n : ℕ => (n : ℤ)) hab
        simp only at this
        omega
      exact_mod_cast this
    · apply sum_geometric_injOn_le
      intro a ha b hb hab
      simp only [Finset.coe_filter, Set.mem_ofPred_eq] at ha hb
      have : (a : ℤ) = b := by
        have := congrArg (fun n : ℕ => (n : ℤ)) hab
        simp only at this
        omega
      exact_mod_cast this
  calc
    _ ≤ ∑ k ∈ I, (2 : ℝ≥0∞) ^ c * r ^ (Int.natAbs (n0 - k)) := Finset.sum_le_sum fun k _ => hterm k
    _ = (2 : ℝ≥0∞) ^ c * ∑ k ∈ I, r ^ (Int.natAbs (n0 - k)) := by rw [Finset.mul_sum]
    _ ≤ (2 : ℝ≥0∞) ^ c * (2 * (1 - r)⁻¹) := mul_le_mul' le_rfl hsplit
    _ = _ := by ring

/-- The same bound for centres moving faster than the summation index:
`∑_J 2^{-c|s - aJ|}` with `a ≥ 1`. -/
theorem sum_two_rpow_neg_abs_mul_le (I : Finset ℕ) (s : ℝ) {a c : ℝ} (ha : 1 ≤ a)
    (hc : 0 < c) :
    ∑ J ∈ I, (2 : ℝ≥0∞) ^ (-(c * |s - a * J|)) ≤
      2 * (2 : ℝ≥0∞) ^ c * (1 - (2 : ℝ≥0∞) ^ (-c))⁻¹ := by
  apply le_trans _ (sum_two_rpow_neg_abs_le I (s / a) hc)
  apply Finset.sum_le_sum
  intro J _
  apply ENNReal.rpow_le_rpow_of_exponent_le (by norm_num)
  have ha0 : 0 < a := by linarith
  have : |s / a - J| ≤ |s - a * J| := by
    rw [show s / a - J = (s - a * J) / a by field_simp, abs_div, abs_of_pos ha0]
    exact div_le_self (abs_nonneg _) ha
  nlinarith

theorem two_rpow_geometric_constant_ne_top {c : ℝ} (hc : 0 < c) :
    2 * (2 : ℝ≥0∞) ^ c * (1 - (2 : ℝ≥0∞) ^ (-c))⁻¹ ≠ ∞ := by
  have hr : (2 : ℝ≥0∞) ^ (-c) < 1 :=
    ENNReal.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  have : (1 - (2 : ℝ≥0∞) ^ (-c))⁻¹ ≠ ∞ :=
    ENNReal.inv_ne_top.mpr (tsub_pos_iff_lt.mpr hr).ne'
  exact ENNReal.mul_ne_top (ENNReal.mul_ne_top (by norm_num) (two_rpow_ne_top c)) this

/-- A supremum over a set covered by finitely many intervals is controlled by
the sum of the interval suprema. -/
theorem maximal_moment_le_sum_cover {d : ℕ} (μ : Measure (Euclidean d))
    (f : SchwartzMap (Euclidean d) ℂ) (T : Set ℝ) {ι : Type*} (K : Finset ι) (a b : ι → ℝ)
    (hcover : ∀ t ∈ T, ∃ k ∈ K, t ∈ Icc (a k) (b k)) {p : ℝ} (hp : 0 < p) :
    (∫⁻ x, (⨆ t : T, ‖sphericalAverage d f t x‖ₑ) ^ p ∂μ) ≤
      ∑ k ∈ K, ∫⁻ x, (⨆ t : Icc (a k) (b k), ‖sphericalAverage d f t x‖ₑ) ^ p ∂μ := by
  rw [← lintegral_finsetSum _ (fun k _ =>
    (measurable_schwartz_radius_supremum f _).pow_const p)]
  apply lintegral_mono
  intro x
  apply (ENNReal.le_rpow_inv_iff hp).mp
  apply iSup_le
  intro t
  obtain ⟨k, hk, htk⟩ := hcover t t.2
  apply (ENNReal.le_rpow_inv_iff hp).mpr
  calc
    _ ≤ (⨆ s : Icc (a k) (b k), ‖sphericalAverage d f s x‖ₑ) ^ p :=
      ENNReal.rpow_le_rpow (le_iSup_of_le ⟨t, htk⟩ le_rfl) hp.le
    _ ≤ _ := Finset.single_le_sum (f := fun k =>
        (⨆ s : Icc (a k) (b k), ‖sphericalAverage d f s x‖ₑ) ^ p) (fun _ _ => bot_le) hk

/-- The smooth dyadic decomposition of an input concentrated near the origin
(the source's `χ_k`, `Section 3.5`), with Schwartz pieces. The pieces live in
`2^{-m-1} < |y| < 2^{1-m}`, have at most twofold overlap, and telescope with a
remainder supported in the ball of radius `2^{1-M}`. -/
theorem exists_dyadic_input_pieces (d : ℕ) :
    ∃ (P : ℕ → SchwartzMap (Euclidean d) ℂ → SchwartzMap (Euclidean d) ℂ)
      (R : ℕ → SchwartzMap (Euclidean d) ℂ → SchwartzMap (Euclidean d) ℂ),
      (∀ m g y, ‖P m g y‖ ≤ 2 * ‖g y‖) ∧
      (∀ m g y, ‖y‖ ≤ ((2 : ℝ) ^ (m + 1))⁻¹ → P m g y = 0) ∧
      (∀ m g y, 2 * ((2 : ℝ) ^ m)⁻¹ ≤ ‖y‖ → P m g y = 0) ∧
      (∀ M g y, ‖R M g y‖ ≤ ‖g y‖) ∧
      (∀ M g y, 2 * ((2 : ℝ) ^ M)⁻¹ ≤ ‖y‖ → R M g y = 0) ∧
      (∀ M g, (∀ y, 1 / 16 < ‖y‖ → g y = 0) →
        g = (∑ m ∈ Finset.Ico 4 M, P m g) + R M g) := by
  obtain ⟨χ, hχ1, hχ0, hχn⟩ := exists_schwartz_spatial_ball_cutoff d 1 one_pos
  let D (m : ℕ) : Euclidean d ≃L[ℝ] Euclidean d :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 ((2 : ℝ) ^ m) (by positivity))
  let χm (m : ℕ) : SchwartzMap (Euclidean d) ℂ :=
    SchwartzMap.compCLMOfContinuousLinearEquiv ℂ (D m) χ
  have hχm (m : ℕ) (y : Euclidean d) : χm m y = χ ((2 : ℝ) ^ m • y) := rfl
  let P (m : ℕ) (g : SchwartzMap (Euclidean d) ℂ) : SchwartzMap (Euclidean d) ℂ :=
    SchwartzMap.smulLeftCLM ℂ ((χm m - χm (m + 1) : SchwartzMap (Euclidean d) ℂ) :
      Euclidean d → ℂ) g
  let R (M : ℕ) (g : SchwartzMap (Euclidean d) ℂ) : SchwartzMap (Euclidean d) ℂ :=
    SchwartzMap.smulLeftCLM ℂ (χm M : Euclidean d → ℂ) g
  have hP (m g y) : P m g y = (χm m y - χm (m + 1) y) * g y := by
    simp only [P, SchwartzMap.smulLeftCLM_apply (χm m - χm (m + 1)).hasTemperateGrowth,
      smul_eq_mul, sub_apply]
  have hR (M g y) : R M g y = χm M y * g y := by
    simp only [R, SchwartzMap.smulLeftCLM_apply (χm M).hasTemperateGrowth, smul_eq_mul]
  have hnorm (m : ℕ) (y : Euclidean d) : ‖(2 : ℝ) ^ m • y‖ = (2 : ℝ) ^ m * ‖y‖ := by
    rw [norm_smul, Real.norm_of_nonneg (by positivity)]
  have hone (m : ℕ) (y : Euclidean d) (hy : ‖y‖ ≤ ((2 : ℝ) ^ m)⁻¹) : χm m y = 1 := by
    rw [hχm]; apply hχ1
    rw [hnorm]
    calc (2 : ℝ) ^ m * ‖y‖ ≤ (2 : ℝ) ^ m * ((2 : ℝ) ^ m)⁻¹ := by gcongr
      _ = 1 := mul_inv_cancel₀ (by positivity)
  have hzero (m : ℕ) (y : Euclidean d) (hy : 2 * ((2 : ℝ) ^ m)⁻¹ ≤ ‖y‖) : χm m y = 0 := by
    rw [hχm]; apply hχ0
    rw [hnorm]
    calc (2 : ℝ) * 1 = (2 : ℝ) ^ m * (2 * ((2 : ℝ) ^ m)⁻¹) := by field_simp
      _ ≤ _ := by gcongr
  refine ⟨P, R, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro m g y
    rw [hP, norm_mul]
    have : ‖χm m y - χm (m + 1) y‖ ≤ 2 := by
      calc _ ≤ ‖χm m y‖ + ‖χm (m + 1) y‖ := norm_sub_le _ _
        _ ≤ 1 + 1 := add_le_add (by rw [hχm]; exact hχn _) (by rw [hχm]; exact hχn _)
        _ = 2 := by norm_num
    exact mul_le_mul_of_nonneg_right this (norm_nonneg _)
  · intro m g y hy
    have h2 : ((2 : ℝ) ^ (m + 1))⁻¹ ≤ ((2 : ℝ) ^ m)⁻¹ :=
      inv_anti₀ (by positivity) (pow_le_pow_right₀ (by norm_num) (by omega))
    rw [hP, hone m y (hy.trans h2), hone (m + 1) y hy]; ring
  · intro m g y hy
    have h2 : 2 * ((2 : ℝ) ^ (m + 1))⁻¹ ≤ 2 * ((2 : ℝ) ^ m)⁻¹ := by
      gcongr
      · norm_num
      · omega
    rw [hP, hzero m y hy, hzero (m + 1) y (h2.trans hy)]; ring
  · intro M g y
    rw [hR, norm_mul]
    exact mul_le_of_le_one_left (norm_nonneg _) (by rw [hχm]; exact hχn _)
  · intro M g y hy
    rw [hR, hzero M y hy, zero_mul]
  · intro M g hg
    ext y
    rw [add_apply, sum_apply]
    simp only [hP, hR, ← Finset.sum_mul]
    by_cases hy : 1 / 16 < ‖y‖
    · simp [hg y hy]
    · push Not at hy
      by_cases hM : 4 ≤ M
      · have htel : ∀ n : ℕ, ∑ k ∈ Finset.range n, (χm (4 + k) y - χm (4 + k + 1) y) =
            χm 4 y - χm (4 + n) y := by
          intro n
          induction n with
          | zero => simp
          | succ n ih => rw [Finset.sum_range_succ, ih]; ring_nf
        rw [Finset.sum_Ico_eq_sum_range, htel, show 4 + (M - 4) = M by omega,
          hone 4 y (by norm_num; linarith)]
        ring
      · rw [Finset.Ico_eq_empty (by omega), Finset.sum_empty, zero_mul, zero_add]
        rw [hone M y (by
          have : (2 : ℝ) ^ M ≤ 2 ^ 4 := pow_le_pow_right₀ (by norm_num) (by omega)
          calc ‖y‖ ≤ 1 / 16 := hy
            _ = ((2 : ℝ) ^ 4)⁻¹ := by norm_num
            _ ≤ _ := inv_anti₀ (by positivity) this)]
        ring

/-- Twofold overlap of the dyadic pieces. -/
theorem dyadic_pieces_overlap {d : ℕ}
    (P : ℕ → SchwartzMap (Euclidean d) ℂ → SchwartzMap (Euclidean d) ℂ)
    (hPn : ∀ m g y, ‖P m g y‖ ≤ 2 * ‖g y‖)
    (hPi : ∀ m g y, ‖y‖ ≤ ((2 : ℝ) ^ (m + 1))⁻¹ → P m g y = 0)
    (hPo : ∀ m g y, 2 * ((2 : ℝ) ^ m)⁻¹ ≤ ‖y‖ → P m g y = 0)
    (S : Finset ℕ) (g : SchwartzMap (Euclidean d) ℂ) (y : Euclidean d) {p : ℝ} (hp : 0 < p) :
    ∑ m ∈ S, ‖P m g y‖ₑ ^ p ≤ 2 * (2 : ℝ≥0∞) ^ p * ‖g y‖ₑ ^ p := by
  classical
  set S' := S.filter (fun m => P m g y ≠ 0)
  have hS' : ∑ m ∈ S, ‖P m g y‖ₑ ^ p = ∑ m ∈ S', ‖P m g y‖ₑ ^ p := by
    rw [Finset.sum_filter_of_ne]
    intro m _ hm h0
    exact hm (by rw [h0, enorm_zero, ENNReal.zero_rpow_of_pos hp])
  have hclose (a b : ℕ) (ha : a ∈ S') (hb : b ∈ S') : b ≤ a + 1 := by
    have ha' := (Finset.mem_filter.mp ha).2
    have hb' := (Finset.mem_filter.mp hb).2
    have h1 : ((2 : ℝ) ^ (a + 1))⁻¹ < ‖y‖ := lt_of_not_ge fun h => ha' (hPi a g y h)
    have h2 : ‖y‖ < 2 * ((2 : ℝ) ^ b)⁻¹ := lt_of_not_ge fun h => hb' (hPo b g y h)
    have h3 : (2 : ℝ) ^ b < 2 ^ (a + 2) := by
      have key : ((2 : ℝ) ^ (a + 1))⁻¹ * (2 ^ (a + 1) * 2 ^ b) <
          2 * ((2 : ℝ) ^ b)⁻¹ * (2 ^ (a + 1) * 2 ^ b) :=
        mul_lt_mul_of_pos_right (h1.trans h2) (by positivity)
      have e1 : ((2 : ℝ) ^ (a + 1))⁻¹ * (2 ^ (a + 1) * 2 ^ b) = 2 ^ b := by field_simp
      have e2 : 2 * ((2 : ℝ) ^ b)⁻¹ * (2 ^ (a + 1) * 2 ^ b) = 2 ^ (a + 2) := by
        field_simp; ring
      rwa [e1, e2] at key
    have := (pow_lt_pow_iff_right₀ (by norm_num : (1 : ℝ) < 2)).mp h3
    omega
  have hcard : S'.card ≤ 2 := by
    rcases S'.eq_empty_or_nonempty with h | h
    · simp [h]
    · set a0 := S'.min' h
      have hsub : S' ⊆ {a0, a0 + 1} := by
        intro b hb
        have h1 : a0 ≤ b := S'.min'_le b hb
        have h2 := hclose a0 b (S'.min'_mem h) hb
        simp only [Finset.mem_insert, Finset.mem_singleton]
        omega
      exact (Finset.card_le_card hsub).trans (Finset.card_le_two)
  rw [hS']
  calc
    _ ≤ ∑ _m ∈ S', (2 : ℝ≥0∞) ^ p * ‖g y‖ₑ ^ p := by
      apply Finset.sum_le_sum
      intro m _
      rw [← ENNReal.mul_rpow_of_nonneg _ _ hp.le]
      apply ENNReal.rpow_le_rpow _ hp.le
      rw [← ofReal_norm, ← ofReal_norm]
      exact (ENNReal.ofReal_le_ofReal (hPn m g y)).trans_eq
        (by rw [ENNReal.ofReal_mul (by norm_num)]; norm_num)
    _ = S'.card * ((2 : ℝ≥0∞) ^ p * ‖g y‖ₑ ^ p) := by rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ 2 * ((2 : ℝ≥0∞) ^ p * ‖g y‖ₑ ^ p) := by
      gcongr
      exact_mod_cast hcard
    _ = _ := by ring

theorem compactResolutionPiece_sum {d : ℕ} (φ : SchwartzMap (Euclidean d) ℂ) (i : ℕ)
    {ι : Type*} (S : Finset ι) (f : ι → SchwartzMap (Euclidean d) ℂ) :
    compactResolutionPiece φ i (∑ m ∈ S, f m) = ∑ m ∈ S, compactResolutionPiece φ i (f m) := by
  simp only [compactResolutionPiece, compactConvolution, map_sum]

theorem compactResolutionPiece_add {d : ℕ} (φ : SchwartzMap (Euclidean d) ℂ) (i : ℕ)
    (f g : SchwartzMap (Euclidean d) ℂ) :
    compactResolutionPiece φ i (f + g) =
      compactResolutionPiece φ i f + compactResolutionPiece φ i g := by
  simp only [compactResolutionPiece, compactConvolution, map_add]

theorem sphericalAverage_schwartz_sum {d : ℕ} {ι : Type*} (S : Finset ι)
    (f : ι → SchwartzMap (Euclidean d) ℂ) (t : ℝ) (x : Euclidean d) :
    sphericalAverage d (∑ m ∈ S, f m : SchwartzMap (Euclidean d) ℂ) t x =
      ∑ m ∈ S, sphericalAverage d (f m) t x := by
  classical
  induction S using Finset.induction_on with
  | empty =>
    simp [sphericalAverage]
  | insert a S ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha, ← schwartzSphericalAverage_apply,
      schwartzSphericalAverage_add, add_apply, schwartzSphericalAverage_apply,
      schwartzSphericalAverage_apply, ih]

/-- The single-kernel form of the compact resolution pieces: the zeroth
piece is convolution with a fixed compact kernel `K₀`, and every later piece
is a normalized dyadic dilate of one compact kernel `𝒦` with vanishing
Fourier jet of order `N`. -/
theorem exists_resolution_single_kernels (d N : ℕ) (hN : 0 < N) :
    ∃ φ : SchwartzMap (Euclidean d) ℂ, (∫ x, φ x) = 1 ∧
      ∃ K₀ 𝒦 : SchwartzMap (Euclidean d) ℂ,
        (∀ u, (1 : ℝ) / 100 < ‖u‖ → K₀ u = 0) ∧ (∀ u, (1 : ℝ) / 100 < ‖u‖ → 𝒦 u = 0) ∧
        Asymptotics.IsBigO (𝓝 (0 : Euclidean d)) (fun ξ => 𝓕 𝒦 ξ)
          (fun ξ => ‖ξ‖ ^ (N + N)) ∧
        (∀ f, compactResolutionPiece φ 0 f =
          compactConvolution (compactDyadicDilate K₀ 0) f) ∧
        (∀ i f, compactResolutionPiece φ (i + 1) f =
          compactConvolution (compactDyadicDilate 𝒦 i) f) := by
  obtain ⟨φ, _, hmass, hφ, _, hflat⟩ := exists_compact_resolution_profile d N hN
  refine ⟨φ, hmass, compactConvolution (compactSynthesisKernel φ 0) (compactAnalysisKernel φ 0),
    compactConvolution (compactSynthesisKernel φ 1) (compactAnalysisKernel φ 1), ?_, ?_, ?_, ?_, ?_⟩
  · intro u hu
    apply compactConvolution_eq_zero_of_radius _ _
      (compactSynthesisKernel_eq_zero φ (by norm_num) hφ 0)
      (compactAnalysisKernel_eq_zero φ (by norm_num) hφ 0)
    linarith
  · intro u hu
    apply compactConvolution_eq_zero_of_radius _ _
      (compactSynthesisKernel_eq_zero φ (by norm_num) hφ 1)
      (compactAnalysisKernel_eq_zero φ (by norm_num) hφ 1)
    linarith
  · have h1 := compactSynthesisKernel_fourier_isBigO φ hflat 0
    have h2 := compactAnalysisKernel_fourier_isBigO φ hflat 0
    simp only [zero_add] at h1 h2
    refine ((h1.mul h2).congr_left (fun ξ => ?_)).congr_right (fun ξ => ?_)
    · rw [fourier_compactConvolution]
    · rw [pow_add]
  · intro f
    rw [compactDyadicDilate_zero, compactResolutionPiece, compactConvolution_assoc]
  · intro i f
    rw [compactDyadicDilate_convolution, ← compactSynthesisKernel_succ,
      ← compactAnalysisKernel_succ, compactResolutionPiece, compactConvolution_assoc]

theorem ofReal_two_rpow (x : ℝ) : ENNReal.ofReal ((2 : ℝ) ^ x) = (2 : ℝ≥0∞) ^ x := by
  rw [← ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 2), ENNReal.ofReal_ofNat]

theorem two_rpow_add (x y : ℝ) : (2 : ℝ≥0∞) ^ x * (2 : ℝ≥0∞) ^ y = (2 : ℝ≥0∞) ^ (x + y) :=
  (ENNReal.rpow_add _ _ (by norm_num) (by norm_num)).symm

/-- The dyadic input radius `2 · 2^{-m} = 2^{1-m}`. -/
theorem two_mul_inv_two_pow (m : ℕ) : 2 * ((2 : ℝ) ^ m)⁻¹ = (2 : ℝ) ^ ((1 : ℝ) - m) := by
  rw [Real.rpow_sub (by norm_num), Real.rpow_one, Real.rpow_natCast, div_eq_mul_inv]

theorem inv_two_pow_eq_rpow (s : ℕ) : ((2 : ℝ) ^ s)⁻¹ = (2 : ℝ) ^ (-(s : ℝ)) := by
  rw [Real.rpow_neg (by norm_num), Real.rpow_natCast]

/-- The volume of a dyadic ball. -/
theorem volume_closedBall_two_rpow {d : ℕ} (x : ℝ) :
    volume (Metric.closedBall (0 : Euclidean d) ((2 : ℝ) ^ x)) =
      (2 : ℝ≥0∞) ^ (x * d) * volume (Metric.ball (0 : Euclidean d) 1) := by
  rw [Measure.addHaar_closedBall _ _ (by positivity), finrank_euclideanSpace_fin,
    ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num), ofReal_two_rpow]

/-- Source `eq:Iaest`, regime `z ≥ 0`, in dyadic form: for inputs supported
in `|y| ≤ 2^{1-m}` with `m ≥ s+1`, one radius interval of length `2^{-s}`
contributes `O(2^{s(p-1) - m d (p-1)}) ‖h‖_p^p`. -/
theorem exists_smoothed_shell_dyadic_bound {d : ℕ} (hd : 0 < d)
    (K : SchwartzMap (Euclidean d) ℂ) (hK : ∀ u, (1 : ℝ) / 100 < ‖u‖ → K u = 0)
    {p : ℝ} (hp : 1 ≤ p) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (s m : ℕ) (a b : ℝ), s + 1 ≤ m → 4 ≤ m → 1 ≤ a → a ≤ b → b ≤ 2 →
      b - a ≤ ((2 : ℝ) ^ s)⁻¹ → ∀ (h : SchwartzMap (Euclidean d) ℂ),
      (∀ y, 2 * ((2 : ℝ) ^ m)⁻¹ < ‖y‖ → h y = 0) →
      (∫⁻ x, (⨆ t : Icc a b,
          ‖sphericalAverage d (compactConvolution (compactDyadicDilate K s) h) t x‖ₑ) ^ p) ≤
        A * (2 : ℝ≥0∞) ^ ((s : ℝ) * (p - 1) - (m : ℝ) * d * (p - 1)) * ∫⁻ y, ‖h y‖ₑ ^ p := by
  obtain ⟨C, hC, hb⟩ := exists_smoothed_shell_interval_bound hd K
  set V := volume (Metric.ball (0 : Euclidean d) 1)
  have hV : V ≠ ∞ := measure_ball_lt_top.ne
  refine ⟨ENNReal.ofReal C ^ p * V ^ (p - 1) * ENNReal.ofReal (4 * (d * 3 ^ (d - 1))) * V *
    (2 : ℝ≥0∞) ^ ((d : ℝ) * (p - 1)), by
      have : V ^ (p - 1) ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (by linarith) hV
      have : ENNReal.ofReal C ^ p ≠ ∞ :=
        ENNReal.rpow_ne_top_of_nonneg (by linarith) ENNReal.ofReal_ne_top
      exact ENNReal.mul_ne_top (ENNReal.mul_ne_top (ENNReal.mul_ne_top (ENNReal.mul_ne_top
        this (by assumption)) ENNReal.ofReal_ne_top) hV) (two_rpow_ne_top _), ?_⟩
  intro s m a b hsm hm4 ha hab hb2 hlen h hh
  set r := 2 * ((2 : ℝ) ^ m)⁻¹
  have hr0 : 0 ≤ r := by positivity
  have hr8 : r ≤ 1 / 8 := by
    have : (2 : ℝ) ^ 4 ≤ 2 ^ m := pow_le_pow_right₀ (by norm_num) hm4
    have : ((2 : ℝ) ^ m)⁻¹ ≤ ((2 : ℝ) ^ 4)⁻¹ := inv_anti₀ (by positivity) this
    dsimp only [r]; norm_num at this ⊢; linarith
  have hrs : r ≤ ((2 : ℝ) ^ s)⁻¹ := by
    have : (2 : ℝ) ^ (s + 1) ≤ 2 ^ m := pow_le_pow_right₀ (by norm_num) hsm
    dsimp only [r]
    rw [pow_succ] at this
    rw [← div_eq_mul_inv, div_le_iff₀ (by positivity), inv_mul_eq_div, le_div_iff₀ (by positivity)]
    linarith
  have hbound := hb s a b r (1 / 100) ha hab hb2 hr0 hr8 (by norm_num) (by norm_num) hK h
    (fun y hy => hh y hy) hp
  apply hbound.trans
  have hwidth : b - a + 2 * (r + 1 / 100 / (2 : ℝ) ^ s) ≤ 4 * ((2 : ℝ) ^ s)⁻¹ := by
    have e : 1 / 100 / (2 : ℝ) ^ s = 1 / 100 * ((2 : ℝ) ^ s)⁻¹ := by ring
    have : 0 ≤ ((2 : ℝ) ^ s)⁻¹ := by positivity
    rw [e]; linarith
  have hw : ENNReal.ofReal ((d : ℝ) * 3 ^ (d - 1) * (b - a + 2 * (r + 1 / 100 / (2 : ℝ) ^ s))) ≤
      ENNReal.ofReal (4 * (d * 3 ^ (d - 1))) * (2 : ℝ≥0∞) ^ (-(s : ℝ)) := by
    rw [← ofReal_two_rpow, ← ENNReal.ofReal_mul (by positivity), ← inv_two_pow_eq_rpow]
    apply ENNReal.ofReal_le_ofReal
    have : 0 ≤ (d : ℝ) * 3 ^ (d - 1) := by positivity
    nlinarith
  have hvol : volume (Metric.closedBall (0 : Euclidean d) r) ^ (p - 1) =
      V ^ (p - 1) * (2 : ℝ≥0∞) ^ (((1 : ℝ) - m) * d * (p - 1)) := by
    rw [show r = (2 : ℝ) ^ ((1 : ℝ) - m) from two_mul_inv_two_pow m, volume_closedBall_two_rpow,
      ENNReal.mul_rpow_of_nonneg _ _ (by linarith), ← ENNReal.rpow_mul, mul_comm]
  have hC2 : ENNReal.ofReal (C * (2 : ℝ) ^ s) ^ p =
      ENNReal.ofReal C ^ p * (2 : ℝ≥0∞) ^ ((s : ℝ) * p) := by
    rw [ENNReal.ofReal_mul hC.le, ENNReal.mul_rpow_of_nonneg _ _ (by linarith),
      ← Real.rpow_natCast, ofReal_two_rpow, ← ENNReal.rpow_mul]
  rw [hC2, hvol]
  have hexp : (2 : ℝ≥0∞) ^ ((s : ℝ) * p) * (2 : ℝ≥0∞) ^ (((1 : ℝ) - m) * d * (p - 1)) *
      (2 : ℝ≥0∞) ^ (-(s : ℝ)) = (2 : ℝ≥0∞) ^ ((d : ℝ) * (p - 1)) *
        (2 : ℝ≥0∞) ^ ((s : ℝ) * (p - 1) - (m : ℝ) * d * (p - 1)) := by
    rw [two_rpow_add, two_rpow_add, two_rpow_add]; congr 1; ring
  calc
    _ ≤ ENNReal.ofReal C ^ p * (2 : ℝ≥0∞) ^ ((s : ℝ) * p) *
          (V ^ (p - 1) * (2 : ℝ≥0∞) ^ (((1 : ℝ) - m) * d * (p - 1))) *
          (ENNReal.ofReal (4 * (d * 3 ^ (d - 1))) * (2 : ℝ≥0∞) ^ (-(s : ℝ)) * V) *
          ∫⁻ y, ‖h y‖ₑ ^ p := by
      gcongr
    _ = ENNReal.ofReal C ^ p * V ^ (p - 1) * ENNReal.ofReal (4 * (d * 3 ^ (d - 1))) * V *
          ((2 : ℝ≥0∞) ^ ((s : ℝ) * p) * (2 : ℝ≥0∞) ^ (((1 : ℝ) - m) * d * (p - 1)) *
            (2 : ℝ≥0∞) ^ (-(s : ℝ))) * ∫⁻ y, ‖h y‖ₑ ^ p := by ring
    _ = _ := by rw [hexp]; ring

/-- Source `eq:pge2part`, regime `z < 0`, in dyadic form: for inputs supported
in `|y| ≤ 2^{1-m}` with `m ≤ s+1` and `p ≥ 2`, one radius interval of length
`2^{-s}` contributes `O(2^{s((p-2)/p-(d-1)) - m κ}) ‖h‖_p^p`, where
`κ = (1-2/p)((d-1)(p-1)+d)`. -/
theorem exists_smoothed_interval_dyadic_bound_ge_two {d N : ℕ} (hd : 2 ≤ d)
    (K : SchwartzMap (Euclidean d) ℂ) (hK : ∀ u, (1 : ℝ) / 100 < ‖u‖ → K u = 0)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d)) (fun ξ => 𝓕 K ξ) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) {p : ℝ} (hp : 2 ≤ p) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (s m : ℕ) (a b : ℝ), m ≤ s + 1 → 1 ≤ a → a ≤ b → b ≤ 2 →
      b - a ≤ ((2 : ℝ) ^ s)⁻¹ → ∀ (h : SchwartzMap (Euclidean d) ℂ),
      (∀ y, 2 * ((2 : ℝ) ^ m)⁻¹ < ‖y‖ → h y = 0) →
      (∫⁻ x, (⨆ t : Icc a b,
          ‖sphericalAverage d (compactConvolution (compactDyadicDilate K s) h) t x‖ₑ) ^ p) ≤
        A * (2 : ℝ≥0∞) ^ ((s : ℝ) * ((1 - 2 / p) - (d - 1)) -
          (m : ℝ) * ((1 - 2 / p) * ((d - 1) * (p - 1) + d))) * ∫⁻ y, ‖h y‖ₑ ^ p := by
  obtain ⟨C, hC, I, hI, A, hA, hb⟩ := exists_smoothed_interval_Lp_bound_ge_two hd K hflat hN
  set V := volume (Metric.ball (0 : Euclidean d) 1)
  have hV : V ≠ ∞ := measure_ball_lt_top.ne
  have hp0 : 0 < p := by linarith
  set θ := 1 - 2 / p
  have hθ : 0 ≤ θ := by dsimp only [θ]; rw [sub_nonneg, div_le_one hp0]; exact hp
  set L := ∫⁻ y, ‖K y‖ₑ
  have hL : L ≠ ∞ := K.integrable.hasFiniteIntegral.ne
  have hd1 : (1 : ℝ) ≤ d := by exact_mod_cast (show 1 ≤ d by omega)
  set c₀ := (I ^ (p - 1) * L ^ (p - 1) * ENNReal.ofReal C * V) ^ θ * A *
    (2 : ℝ≥0∞) ^ (θ * (2 * ((d - 1) * (p - 1)) + d))
  have hc₀ : c₀ ≠ ∞ := by
    have h1 : I ^ (p - 1) ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (by linarith) hI
    have h2 : L ^ (p - 1) ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (by linarith) hL
    have h3 : (I ^ (p - 1) * L ^ (p - 1) * ENNReal.ofReal C * V) ^ θ ≠ ∞ :=
      ENNReal.rpow_ne_top_of_nonneg hθ (by finiteness)
    exact ENNReal.mul_ne_top (ENNReal.mul_ne_top h3 hA) (two_rpow_ne_top _)
  refine ⟨c₀, hc₀, ?_⟩
  intro s m a b hms ha hab hb2 hlen h hh
  set r := 2 * ((2 : ℝ) ^ m)⁻¹
  have hr : r = (2 : ℝ) ^ ((1 : ℝ) - m) := two_mul_inv_two_pow m
  have hr0 : 0 < r := by positivity
  have hρr : 1 / 100 / (2 : ℝ) ^ s ≤ r := by
    have : (2 : ℝ) ^ m ≤ 2 ^ (s + 1) := pow_le_pow_right₀ (by norm_num) hms
    rw [pow_succ] at this
    dsimp only [r]
    rw [div_le_iff₀ (by positivity)]
    have hpos : 0 < (2 : ℝ) ^ m := by positivity
    rw [mul_assoc, mul_comm (((2 : ℝ) ^ m)⁻¹), ← div_eq_mul_inv, mul_div_assoc', le_div_iff₀ hpos]
    nlinarith [pow_pos (two_pos (α := ℝ)) s]
  have hbound := hb s a b r (1 / 100) ha hab hb2 hlen hr0 (by norm_num) hρr hK h
    (fun y hy => hh y hy) hp
  apply hbound.trans
  -- rewrite the radius-dependent factors as powers of two
  have h2r : ENNReal.ofReal ((2 * r) ^ (d - 1)) = (2 : ℝ≥0∞) ^ (((2 : ℝ) - m) * (d - 1)) := by
    rw [hr, show (2 : ℝ) * 2 ^ ((1 : ℝ) - m) = 2 ^ ((2 : ℝ) - m) by
        rw [show (2 : ℝ) - m = 1 + (1 - m) by ring, Real.rpow_add (by norm_num), Real.rpow_one],
      ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num), ofReal_two_rpow,
      Nat.cast_sub (by omega : 1 ≤ d), Nat.cast_one]
  have hvol : volume (Metric.closedBall (0 : Euclidean d) r) =
      (2 : ℝ≥0∞) ^ (((1 : ℝ) - m) * d) * V := by
    rw [hr, volume_closedBall_two_rpow]
  have hC2 : ENNReal.ofReal (C * (2 : ℝ) ^ s) = ENNReal.ofReal C * (2 : ℝ≥0∞) ^ (s : ℝ) := by
    rw [ENNReal.ofReal_mul hC.le, ← Real.rpow_natCast, ofReal_two_rpow]
  rw [h2r, hvol, hC2]
  have hregroup : (I * (2 : ℝ≥0∞) ^ (((2 : ℝ) - m) * (d - 1))) ^ (p - 1) * L ^ (p - 1) *
      (ENNReal.ofReal C * (2 : ℝ≥0∞) ^ (s : ℝ)) * ((2 : ℝ≥0∞) ^ (((1 : ℝ) - m) * d) * V) =
      (I ^ (p - 1) * L ^ (p - 1) * ENNReal.ofReal C * V) *
        (2 : ℝ≥0∞) ^ (((2 : ℝ) - m) * (d - 1) * (p - 1) + s + ((1 : ℝ) - m) * d) := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by linarith), ← ENNReal.rpow_mul,
      ← two_rpow_add, ← two_rpow_add]
    ring
  rw [hregroup, ENNReal.mul_rpow_of_nonneg _ _ hθ, ← ENNReal.rpow_mul]
  have hexp : (2 : ℝ≥0∞) ^ ((((2 : ℝ) - m) * (d - 1) * (p - 1) + s + ((1 : ℝ) - m) * d) * θ) *
      (2 : ℝ≥0∞) ^ (-((s : ℝ) * ((d : ℝ) - 1))) =
      (2 : ℝ≥0∞) ^ (θ * (2 * ((d - 1) * (p - 1)) + d)) *
        (2 : ℝ≥0∞) ^ ((s : ℝ) * (θ - (d - 1)) - (m : ℝ) * (θ * ((d - 1) * (p - 1) + d))) := by
    rw [two_rpow_add, two_rpow_add]; congr 1; ring
  apply le_of_eq
  calc
    _ = (I ^ (p - 1) * L ^ (p - 1) * ENNReal.ofReal C * V) ^ θ * A *
        ((2 : ℝ≥0∞) ^ ((((2 : ℝ) - m) * (d - 1) * (p - 1) + s + ((1 : ℝ) - m) * d) * θ) *
          (2 : ℝ≥0∞) ^ (-((s : ℝ) * ((d : ℝ) - 1)))) * ∫⁻ y, ‖h y‖ₑ ^ p := by ring
    _ = _ := by rw [hexp]; simp only [c₀]; ring

/-- Section 3.5, eq:pge2part: genuine L2-Linfinity operator interpolation
retains the cap factor to power p-2. The resulting estimate also works in
dimension two, unlike the preceding coarse log-convexity estimate. -/
theorem exists_smoothed_interval_dyadic_bound_gt_two_sharp {d N : ℕ} (hd : 2 ≤ d)
    (K : SchwartzMap (Euclidean d) ℂ) (hK : ∀ u, (1 : ℝ) / 100 < ‖u‖ → K u = 0)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d)) (fun ξ => 𝓕 K ξ) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) {p : ℝ} (hp : 2 < p) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (s m : ℕ) (a b : ℝ), m ≤ s + 1 → 1 ≤ a → a ≤ b → b ≤ 2 →
      b - a ≤ ((2 : ℝ) ^ s)⁻¹ → ∀ (h : SchwartzMap (Euclidean d) ℂ),
      (∀ y, 2 * ((2 : ℝ) ^ m)⁻¹ < ‖y‖ → h y = 0) →
      (∫⁻ x, (⨆ t : Icc a b,
          ‖sphericalAverage d (compactConvolution (compactDyadicDilate K s) h) t x‖ₑ) ^ p) ≤
        A * (2 : ℝ≥0∞) ^ (-((s : ℝ) * (d - 1)) -
          (m : ℝ) * ((d - 1) * (p - 2))) * ∫⁻ y, ‖h y‖ₑ ^ p := by
  obtain ⟨_, _, _, _, A, hA, hb⟩ := exists_smoothed_interval_Lp_bound_ge_two hd K hflat hN
  obtain ⟨I, hI, hinc⟩ := sphere_smallBall_incidence_bound (d := d) (by omega)
  let J : ℝ := (∫ y, ‖K y‖) + 1
  have hJ : 0 < J := by dsimp [J]; positivity
  let D : ℝ := (I.toReal + 1) * J
  have hD : 0 < D := by dsimp [D]; positivity
  let P : ℝ≥0∞ := ENNReal.ofReal p * (2 : ℝ≥0∞) ^ (2 : ℝ) *
    (ENNReal.ofReal (p - 2))⁻¹ * (4 : ℝ≥0∞) ^ (p - 2)
  have hP : P ≠ ∞ := by
    have hinv : (ENNReal.ofReal (p - 2))⁻¹ ≠ ∞ :=
      ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr (by linarith))
    have hpow : (4 : ℝ≥0∞) ^ (p - 2) ≠ ∞ :=
      ENNReal.rpow_ne_top_of_nonneg (by linarith) (by norm_num)
    dsimp [P]; finiteness
  let A' := P * A * ENNReal.ofReal (D * (4 : ℝ) ^ (d - 1)) ^ (p - 2)
  have hA' : A' ≠ ∞ := by
    have hpow := ENNReal.rpow_ne_top_of_nonneg (show 0 ≤ p - 2 by linarith)
      (show ENNReal.ofReal (D * (4 : ℝ) ^ (d - 1)) ≠ ∞ from ENNReal.ofReal_ne_top)
    dsimp [A']; finiteness
  refine ⟨A', hA', ?_⟩
  intro s m a b hms ha hab hb2 hlen f hf
  let r : ℝ := 2 * ((2 : ℝ) ^ m)⁻¹
  have hr : 0 < r := by dsimp [r]; positivity
  have hρr : 1 / 100 / (2 : ℝ) ^ s ≤ r := by
    have hm : (2 : ℝ) ^ m ≤ 2 ^ (s + 1) := pow_le_pow_right₀ (by norm_num) hms
    rw [pow_succ] at hm
    dsimp [r]
    rw [div_le_iff₀ (by positivity)]
    have hpos : 0 < (2 : ℝ) ^ m := by positivity
    rw [mul_assoc, mul_comm (((2 : ℝ) ^ m)⁻¹), ← div_eq_mul_inv, mul_div_assoc',
      le_div_iff₀ hpos]
    nlinarith [pow_pos (two_pos (α := ℝ)) s]
  let F (g : SchwartzMap (Euclidean d) ℂ) :=
