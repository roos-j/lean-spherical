    apply (hcoarse s m a b hm4 hms ha hab hb2 hlen h hout').trans
    have hms' : (m : ℝ) ≤ s := by exact_mod_cast hms
    calc
      _ ≤ A₂ * (2 : ℝ≥0∞) ^ (-(β * s + ε * ((s : ℝ) - m)) - ((m : ℝ) + 1) * α) *
          ((2 : ℝ≥0∞) ^ (((m : ℝ) + 1) * α) * W) := mul_le_mul' le_rfl hw
      _ = A₂ * (2 : ℝ≥0∞) ^ (-(β * s + ε * |(m : ℝ) - s|)) * W := by
        rw [abs_sub_comm, abs_of_nonneg (by linarith), mul_assoc A₂, ← mul_assoc _ _ W,
