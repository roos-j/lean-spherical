  obtain ⟨A₂, hA₂, hcoarse⟩ := hcoarse
  have hα0 : 0 ≤ α := hα.le
  have h2α : (1 : ℝ≥0∞) ≤ (2 : ℝ≥0∞) ^ α := ENNReal.one_le_rpow (by norm_num) hα
  refine ⟨(A₁ + A₂) * (2 : ℝ≥0∞) ^ α, ENNReal.mul_ne_top (ENNReal.add_ne_top.mpr ⟨hA₁, hA₂⟩)
