/-- A light-ray tube in space-time, with spatial intercept `a` and velocity `v`.
For unit `v` this is comparable to the Euclidean tubes in Wolff (2001),
Section 1. The product coordinates preserve the time parameter exactly. -/
def lightRayTube {d : ℕ} (a v : Euclidean d) (δ : ℝ) : Set (Euclidean d × ℝ) :=
  {z | ‖z.1 - (a + z.2 • v)‖ ≤ δ}

/-- The displacement estimate used in Wolff (2001), Lemma 1.3, Eq. (4). -/
theorem lightRayTube_displacement {d : ℕ} {a v : Euclidean d} {δ : ℝ}
    {z z' : Euclidean d × ℝ} (hz : z ∈ lightRayTube a v δ)
    (hz' : z' ∈ lightRayTube a v δ) :
    ‖(z.1 - z'.1) - (z.2 - z'.2) • v‖ ≤ 2 * δ := by
  have heq : (z.1 - z'.1) - (z.2 - z'.2) • v =
      (z.1 - (a + z.2 • v)) - (z'.1 - (a + z'.2 • v)) := by
    rw [sub_smul]
    abel
  rw [heq]
  have h := norm_sub_le (z.1 - (a + z.2 • v)) (z'.1 - (a + z'.2 • v))
  change ‖z.1 - (a + z.2 • v)‖ ≤ δ at hz
  change ‖z'.1 - (a + z'.2 • v)‖ ≤ δ at hz'
  linarith

/-- Transverse tubes have bounded time overlap (Wolff, Lemma 1.3, Eq. (4)). -/
theorem lightRayTube_intersection_time {d : ℕ} {a b v w : Euclidean d}
    {δ κ : ℝ} (hκ : 0 < κ) (hvw : κ ≤ ‖v - w‖)
    {z z' : Euclidean d × ℝ}
    (hz : z ∈ lightRayTube a v δ ∩ lightRayTube b w δ)
    (hz' : z' ∈ lightRayTube a v δ ∩ lightRayTube b w δ) :
    |z.2 - z'.2| ≤ 4 * δ / κ := by
  have hv := lightRayTube_displacement hz.1 hz'.1
  have hw := lightRayTube_displacement hz.2 hz'.2
  have heq : (z.2 - z'.2) • (v - w) =
      ((z.1 - z'.1) - (z.2 - z'.2) • w) -
      ((z.1 - z'.1) - (z.2 - z'.2) • v) := by
    rw [smul_sub]
    abel
  have hbound : ‖(z.2 - z'.2) • (v - w)‖ ≤ 4 * δ := by
    rw [heq]
    exact (norm_sub_le _ _).trans (by linarith)
  rw [norm_smul, Real.norm_eq_abs] at hbound
  exact (le_div_iff₀ hκ).2
    ((mul_le_mul_of_nonneg_left hvw (abs_nonneg _)).trans hbound)

/-- The spatial component of the transverse overlap estimate. -/
theorem lightRayTube_intersection_space {d : ℕ} {a b v w : Euclidean d}
    {δ κ : ℝ} (hκ : 0 < κ) (hvw : κ ≤ ‖v - w‖) (hv : ‖v‖ ≤ 1)
    {z z' : Euclidean d × ℝ}
    (hz : z ∈ lightRayTube a v δ ∩ lightRayTube b w δ)
    (hz' : z' ∈ lightRayTube a v δ ∩ lightRayTube b w δ) :
    ‖z.1 - z'.1‖ ≤ 2 * δ + 4 * δ / κ := by
  have htime := lightRayTube_intersection_time hκ hvw hz hz'
  have hdisp := lightRayTube_displacement hz.1 hz'.1
  calc
    ‖z.1 - z'.1‖ = ‖((z.1 - z'.1) - (z.2 - z'.2) • v) +
        (z.2 - z'.2) • v‖ := by rw [sub_add_cancel]
    _ ≤ ‖(z.1 - z'.1) - (z.2 - z'.2) • v‖ + ‖(z.2 - z'.2) • v‖ := norm_add_le _ _
    _ ≤ 2 * δ + 4 * δ / κ := by
      rw [norm_smul, Real.norm_eq_abs]
      have := mul_le_mul_of_nonneg_left hv (abs_nonneg (z.2 - z'.2))
      linarith

/-- Containment in a spatial ball times a time interval, centered at any
point of the intersection (Wolff, Lemma 1.3, Eq. (4)). -/
theorem lightRayTube_intersection_subset {d : ℕ} {a b v w : Euclidean d}
    {δ κ : ℝ} (hκ : 0 < κ) (hvw : κ ≤ ‖v - w‖) (hv : ‖v‖ ≤ 1)
    {z₀ : Euclidean d × ℝ}
    (hz₀ : z₀ ∈ lightRayTube a v δ ∩ lightRayTube b w δ) :
    lightRayTube a v δ ∩ lightRayTube b w δ ⊆
      Metric.closedBall z₀.1 (2 * δ + 4 * δ / κ) ×ˢ
        Icc (z₀.2 - 4 * δ / κ) (z₀.2 + 4 * δ / κ) := by
  intro z hz
  refine ⟨?_, ?_⟩
  · simpa only [Metric.mem_closedBall, dist_eq_norm] using
      lightRayTube_intersection_space hκ hvw hv hz hz₀
  · have ht := abs_le.mp (lightRayTube_intersection_time hκ hvw hz hz₀)
    constructor <;> linarith [ht.1, ht.2]

/-- The intersection volume bound in three-dimensional space-time.
Its explicit right side is cubic in the radius, as in Wolff (2001),
Lemma 1.3, Equation (4). -/
theorem lightRayTube_intersection_volume {a b v w : Euclidean 2}
    {δ κ : ℝ} (hκ : 0 < κ) (hvw : κ ≤ ‖v - w‖) (hv : ‖v‖ ≤ 1) :
    (volume.prod volume) (lightRayTube a v δ ∩ lightRayTube b w δ) ≤
      ENNReal.ofReal (2 * δ + 4 * δ / κ) ^ 2 * ENNReal.ofReal Real.pi *
        ENNReal.ofReal (8 * δ / κ) := by
  by_cases hne : (lightRayTube a v δ ∩ lightRayTube b w δ).Nonempty
  · obtain ⟨z₀, hz₀⟩ := hne
    calc
      _ ≤ (volume.prod volume) (Metric.closedBall z₀.1 (2 * δ + 4 * δ / κ) ×ˢ
          Icc (z₀.2 - 4 * δ / κ) (z₀.2 + 4 * δ / κ)) :=
        measure_mono (lightRayTube_intersection_subset hκ hvw hv hz₀)
      _ = _ := by
        rw [Measure.prod_prod, EuclideanSpace.volume_closedBall_fin_two, Real.volume_Icc]
        congr 2
        ring
  · rw [Set.not_nonempty_iff_eq_empty.mp hne, measure_empty]
    exact bot_le

/-- The cubic dependence on tube radius in Wolff's transverse overlap
estimate; the constant depends only on the angular separation. -/
theorem lightRayTube_intersection_volume_cubic {κ : ℝ} (hκ : 0 < κ) :
    ∃ C : ℝ, 0 < C ∧ ∀ a b v w : Euclidean 2, ∀ δ : ℝ, 0 ≤ δ →
      κ ≤ ‖v - w‖ → ‖v‖ ≤ 1 →
      (volume.prod volume) (lightRayTube a v δ ∩ lightRayTube b w δ) ≤
        ENNReal.ofReal C * ENNReal.ofReal δ ^ 3 := by
  let A : ℝ := 2 + 4 / κ
  let B : ℝ := 8 / κ
  have hA : 0 < A := by dsimp [A]; positivity
  have hB : 0 < B := by dsimp [B]; positivity
  refine ⟨A ^ 2 * Real.pi * B, by positivity, ?_⟩
  intro a b v w δ hδ hvw hv
  have hR : 2 * δ + 4 * δ / κ = A * δ := by dsimp [A]; ring
  have hT : 8 * δ / κ = B * δ := by dsimp [B]; ring
  calc
    _ ≤ ENNReal.ofReal (2 * δ + 4 * δ / κ) ^ 2 * ENNReal.ofReal Real.pi *
        ENNReal.ofReal (8 * δ / κ) :=
      lightRayTube_intersection_volume hκ hvw hv
    _ = _ := by
      rw [hR, hT, ENNReal.ofReal_mul hA.le, ENNReal.ofReal_mul hB.le,
        ENNReal.ofReal_mul (by positivity : 0 ≤ A ^ 2 * Real.pi),
        ENNReal.ofReal_mul (sq_nonneg A), ENNReal.ofReal_pow hA.le]
      ring

/-- The tube is closed, so its intersections and restricted integrals
have the measurability needed for the light-ray incidence argument. -/
theorem isClosed_lightRayTube {d : ℕ} (a v : Euclidean d) (δ : ℝ) :
    IsClosed (lightRayTube a v δ) := by
  apply isClosed_le _ continuous_const
  exact (continuous_fst.sub (continuous_const.add
    (continuous_snd.smul continuous_const))).norm

open Classical in
/-- Finite incidence form of bush extraction (Wolff 2001, Lemma 1.4).
The remainder has fewer than `m` incident objects at every allowed base
point. Every removed object belongs to a bush at a selected base point.
The number of base points is controlled by the number of removed objects. -/
theorem finite_bush_extraction {ι X : Type*} (s : Finset ι) (U : Set X)
    (R : ι → X → Prop) (m : ℕ) (hm : 0 < m) :
    ∃ g : Finset ι, ∃ P : Finset X,
      g ⊆ s ∧ (∀ x ∈ P, x ∈ U) ∧
      m * P.card + g.card ≤ s.card ∧
      (∀ x ∈ U, (g.filter (fun i => R i x)).card < m) ∧
      (∀ i ∈ s, i ∉ g → ∃ x ∈ P, R i x) := by
  classical
  induction s using Finset.strongInductionOn with
  | _ s ih =>
    by_cases hgood : ∀ x ∈ U, (s.filter (fun i => R i x)).card < m
    · refine ⟨s, ∅, Subset.rfl, by simp, by simp, hgood, ?_⟩
      intro i hi hni
      exact (hni hi).elim
    · push Not at hgood
      obtain ⟨x, hxU, hx⟩ := hgood
      let B := s.filter (fun i => R i x)
      let t := s \ B
      have hB : B ⊆ s := Finset.filter_subset _ _
      have hcard : t.card + B.card = s.card := Finset.card_sdiff_add_card_eq_card hB
      have hBt : 0 < B.card := lt_of_lt_of_le hm hx
      have ht : t ⊂ s := Finset.ssubset_iff_subset_ne.mpr
        ⟨Finset.sdiff_subset, by intro heq; have := congrArg Finset.card heq; omega⟩
      obtain ⟨g, P, hgt, hPU, hcount, hremain, hcover⟩ := ih t ht
      refine ⟨g, insert x P, hgt.trans Finset.sdiff_subset, ?_, ?_, hremain, ?_⟩
      · intro y hy
        rcases Finset.mem_insert.mp hy with rfl | hy
        · exact hxU
        · exact hPU y hy
      · have hPc : (insert x P).card ≤ P.card + 1 := Finset.card_insert_le _ _
        have hmult := Nat.mul_le_mul_left m hPc
        dsimp [B] at hcard hBt
        nlinarith
      · intro i his hig
        by_cases hiB : i ∈ B
        · exact ⟨x, Finset.mem_insert_self _ _, (Finset.mem_filter.mp hiB).2⟩
        · obtain ⟨y, hyP, hiy⟩ := hcover i (Finset.mem_sdiff.mpr ⟨his, hiB⟩) hig
          exact ⟨y, Finset.mem_insert_of_mem hyP, hiy⟩

open Classical in
/-- Light-ray specialization of the finite bush selection. The selected
points lie in the prescribed region; the discarded tubes form their
bushes, and the surviving family has no `m`-fold points there.
This is the incidence decomposition of Wolff (2001), Lemma 1.4. -/
theorem lightRayTube_bush_extraction {ι : Type*} {d : ℕ}
    (s : Finset ι) (a v : ι → Euclidean d) (δ : ℝ)
    (U : Set (Euclidean d × ℝ)) (m : ℕ) (hm : 0 < m) :
    ∃ g : Finset ι, ∃ P : Finset (Euclidean d × ℝ),
      g ⊆ s ∧ (∀ z ∈ P, z ∈ U) ∧
      m * P.card + g.card ≤ s.card ∧
      (∀ z ∈ U, (g.filter (fun i => z ∈ lightRayTube (a i) (v i) δ)).card < m) ∧
      (∀ i ∈ s, i ∉ g → ∃ z ∈ P, z ∈ lightRayTube (a i) (v i) δ) :=
  finite_bush_extraction s U (fun i z => z ∈ lightRayTube (a i) (v i) δ) m hm

open Classical in
/-- Truncated layer decomposition for a decaying profile. The remainder
is the final tail bound. This supplies the pointwise step left implicit
in Wolff (2001), Lemma 1.2. -/
theorem profile_le_truncated_layers (a : ℝ) (b : ℕ → ℝ) (R : ℕ → Prop)
    (hb : ∀ k, 0 ≤ b k) (ha : a ≤ b 0)
    (hout : ∀ k, ¬R k → a ≤ b k) (N : ℕ) :
    a ≤ b N + ∑ k ∈ Finset.range N, if R (k + 1) then b k else 0 := by
  classical
  induction N with
  | zero => simpa using ha
  | succ N ih =>
    rw [Finset.sum_range_succ]
    by_cases hR : R (N + 1)
    · rw [ite_eq_left hR]
      linarith [hb (N + 1)]
    · rw [ite_eq_right hR]
      have hs : 0 ≤ ∑ k ∈ Finset.range N, if R (k + 1) then b k else 0 :=
        Finset.sum_nonneg fun k _ => by
          split_ifs
          · exact hb k
          · exact le_rfl
      linarith [hout (N + 1) hR]

open Classical in
/-- A smooth multiplicity with a small tail forces a dense bush at one
of finitely many scales. The reciprocal number of scales is the logarithmic
factor in Wolff (2001), Lemma 1.2. -/
theorem finite_weighted_bush_extraction {ι K : Type*} (s : Finset ι)
    (J : Finset K) (hJ : J.Nonempty) (a : ι → ℝ) (b : K → ℝ)
    (R : ι → K → Prop) (τ μ : ℝ)
    (hpoint : ∀ i ∈ s, a i ≤ τ + ∑ k ∈ J, if R i k then b k else 0)
    (hmass : μ ≤ ∑ i ∈ s, a i) (htail : (s.card : ℝ) * τ ≤ μ / 2) :
    ∃ k ∈ J, μ / (2 * (J.card : ℝ)) ≤
      b k * ((s.filter (fun i => R i k)).card : ℝ) := by
  classical
  have hsum : (∑ i ∈ s, a i) ≤ (s.card : ℝ) * τ +
      ∑ k ∈ J, b k * ((s.filter (fun i => R i k)).card : ℝ) := by
    calc
      _ ≤ ∑ i ∈ s, (τ + ∑ k ∈ J, if R i k then b k else 0) :=
        Finset.sum_le_sum hpoint
      _ = _ := by
        rw [Finset.sum_add_distrib, Finset.sum_comm]
        simp only [Finset.sum_const, nsmul_eq_mul]
        congr 1
        apply Finset.sum_congr rfl
        intro k hk
        rw [← Finset.sum_filter]
        simp [mul_comm]
  have hcard : (0 : ℝ) < J.card := by exact_mod_cast hJ.card_pos
  have heq : ∑ _k ∈ J, μ / (2 * (J.card : ℝ)) = μ / 2 := by
    rw [Finset.sum_const, nsmul_eq_mul]
    field_simp
  apply Finset.exists_le_of_sum_le hJ
  rw [heq]
  linarith

/-- A nonsingular polynomial tube profile, equivalent up to fixed
constants to Wolff's profile (2). Here `r` is the distance to the axis. -/
def tubeDecayProfile (δ : ℝ) (M : ℕ) (r : ℝ) : ℝ :=
  (δ / (δ + r)) ^ M

/-- Polynomial profiles are bounded by one for nonnegative distances. -/
theorem tubeDecayProfile_le_one {δ r : ℝ} (hδ : 0 < δ) (hr : 0 ≤ r) (M : ℕ) :
    tubeDecayProfile δ M r ≤ 1 := by
  apply pow_le_one₀ (by positivity)
  exact (div_le_one (by linarith)).2 (by linarith)

/-- The tail of the tube profile outside a dyadic enlargement. -/
theorem tubeDecayProfile_le_dyadic_tail {δ r : ℝ} (hδ : 0 < δ) (hr : 0 ≤ r)
    (M k : ℕ) (hout : δ * (2 : ℝ) ^ k < r) :
    tubeDecayProfile δ M r ≤ ((2 : ℝ) ^ k)⁻¹ ^ M := by
  apply pow_le_pow_left₀ (by positivity)
  rw [inv_eq_one_div]
  apply (div_le_div_iff₀ (by linarith) (by positivity)).2
  nlinarith

open Classical in
/-- The concrete dyadic layer estimate for polynomial tube profiles,
including the tail at the final scale (Wolff 2001, Lemma 1.2). -/
theorem tubeDecayProfile_le_layers {δ r : ℝ} (hδ : 0 < δ) (hr : 0 ≤ r)
    (M N : ℕ) :
    tubeDecayProfile δ M r ≤ ((2 : ℝ) ^ N)⁻¹ ^ M +
      ∑ k ∈ Finset.range N,
        if r ≤ δ * (2 : ℝ) ^ (k + 1) then ((2 : ℝ) ^ k)⁻¹ ^ M else 0 := by
  apply profile_le_truncated_layers (tubeDecayProfile δ M r)
    (fun k => ((2 : ℝ) ^ k)⁻¹ ^ M) (fun k => r ≤ δ * (2 : ℝ) ^ k)
  · intro k
    positivity
  · simpa using tubeDecayProfile_le_one hδ hr M
  · intro k hk
    exact tubeDecayProfile_le_dyadic_tail hδ hr M k (lt_of_not_ge hk)

open Classical in
/-- A large smooth multiplicity yields a bush at a dyadic enlargement,
provided the final tail is at most half the multiplicity. This is the
quantitative finite-scale assertion behind Wolff (2001), Lemma 1.2. -/
theorem tubeDecayProfile_bush_extraction {ι : Type*} (s : Finset ι)
    (r : ι → ℝ) (hr : ∀ i ∈ s, 0 ≤ r i) {δ μ : ℝ} (hδ : 0 < δ)
    (M N : ℕ) (hN : 0 < N)
    (hmass : μ ≤ ∑ i ∈ s, tubeDecayProfile δ M (r i))
    (htail : (s.card : ℝ) * (((2 : ℝ) ^ N)⁻¹ ^ M) ≤ μ / 2) :
    ∃ k < N, μ / (2 * (N : ℝ)) ≤ ((2 : ℝ) ^ k)⁻¹ ^ M *
      ((s.filter (fun i => r i ≤ δ * (2 : ℝ) ^ (k + 1))).card : ℝ) := by
  obtain ⟨k, hk, hbound⟩ := finite_weighted_bush_extraction s (Finset.range N)
    (Finset.nonempty_range_iff.mpr (Nat.ne_of_gt hN)) (fun i => tubeDecayProfile δ M (r i))
    (fun k => ((2 : ℝ) ^ k)⁻¹ ^ M)
    (fun i k => r i ≤ δ * (2 : ℝ) ^ (k + 1))
    (((2 : ℝ) ^ N)⁻¹ ^ M) μ
    (fun i hi => tubeDecayProfile_le_layers hδ (hr i hi) M N) hmass htail
  exact ⟨k, Finset.mem_range.mp hk, by simpa using hbound⟩

/-- Exact normalization bridge to the existing MSS decay profile.
All integrability and positive bandlimited majorants for that profile
can therefore be reused for the present tube geometry. -/
theorem tubeDecayProfile_eq_mss {δ : ℝ} (hδ : 0 < δ)
    (M : ℕ) (u : Euclidean 2) :
    tubeDecayProfile δ M ‖u‖ =
      Auto.Spherical.MSS.lightRayDecayProfile M (δ⁻¹ • u) := by
  unfold tubeDecayProfile Auto.Spherical.MSS.lightRayDecayProfile
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hδ)]
  congr 1
  field_simp

/-- On the existing MSS time slab, its backwards-ray tube is exactly
the present tube with the velocity sign reversed. -/
theorem mss_lightRayTube_eq (a v : Euclidean 2) (δ : ℝ) :
    Auto.Spherical.MSS.lightRayTube δ (-v) a =
      {z : Euclidean 2 × ℝ | z.2 ∈ Auto.Spherical.MSS.lightRayTimeInterval} ∩
        lightRayTube a v δ := by
  ext z
  have heq : z.1 + z.2 • (-v) - a = z.1 - (a + z.2 • v) := by
    rw [smul_neg]
    abel
  simp only [Auto.Spherical.MSS.lightRayTube, lightRayTube, mem_ofPred_eq,
    mem_inter_iff, heq]

/-- Reuse the MSS normalized polynomial kernel exactly, including its
width-squared normalization. No new packet kernel is introduced. -/
theorem mss_lightRayKernel_eq_tubeDecayProfile {δ : ℝ} (hδ : 0 < δ)
    (M : ℕ) (a v : Euclidean 2) (z : Euclidean 2 × ℝ) :
    Auto.Spherical.MSS.lightRayKernel δ M (-v) a z =
      (δ⁻¹) ^ 2 * tubeDecayProfile δ M ‖z.1 - (a + z.2 • v)‖ := by
  rw [Auto.Spherical.MSS.lightRayKernel_eq_scaled_decayProfile hδ,
    ← tubeDecayProfile_eq_mss hδ]
  congr 3
  rw [smul_neg]
  abel

/-- Reuse the positive bandlimited dyadic majorant already proved in MSS.
The constants and cores are independent of the tube width and the point;
the majorant series is summable for every decay order greater than two. -/
theorem tubeDecayProfile_bandlimited_majorant (M : ℕ) (hM : 2 < M) :
    ∃ c r : ℝ, 0 < c ∧ 0 < r ∧ ∀ δ : ℝ, 0 < δ → ∀ u : Euclidean 2,
      tubeDecayProfile δ M ‖u‖ ≤
        ∑' j : ℕ, Auto.Spherical.MSS.canonicalBandlimitedDyadicCoefficient M c r j *
          Auto.Spherical.MSS.canonicalBandlimitedDyadicCore r j (δ⁻¹ • u) ∧
      Summable (fun j : ℕ =>
        Auto.Spherical.MSS.canonicalBandlimitedDyadicCoefficient M c r j *
          Auto.Spherical.MSS.canonicalBandlimitedDyadicCore r j (δ⁻¹ • u)) := by
  obtain ⟨c, r, hc, hr, hcore⟩ :=
    Auto.Spherical.MSS.exists_canonicalPositiveCore_lower_closedBall
  refine ⟨c, r, hc, hr, ?_⟩
  intro δ hδ u
  rw [tubeDecayProfile_eq_mss hδ]
  exact ⟨Auto.Spherical.MSS.lightRayDecayProfile_le_tsum_canonicalBandlimitedDyadicCore
    M hM hc hr hcore _,
    Auto.Spherical.MSS.summable_canonicalBandlimitedDyadicTerm M hM hc hr _⟩

/-- The ambient one-dimensional cover has no subpower loss, including at
Assouad dimension one. The constant is independent of the radius set. -/
theorem subpowerAssouadCoverBound_one (E : Set ℝ) :
    HasSubpowerAssouadCoverBound E 1 0 4 := by
  intro δ a b hδ _ _ hab _ hlength
  obtain ⟨s, hs, hcard⟩ := exists_intervalCover_of_subset_Icc
    (F := E ∩ Icc a b) hδ hab inter_subset_right
  refine ⟨s, hs, ?_⟩
  have hratio : 1 ≤ (b - a) / δ := (le_div_iff₀ hδ).mpr (by simpa using hlength)
  have hceil := (Nat.ceil_lt_add_one (by linarith : 0 ≤ (b - a) / δ)).le
  simp only [neg_zero, Real.rpow_zero, mul_one, Real.rpow_one]
  linarith

/-- The already proved RS planar endpoint, specialized to the full interval.
This is an actual `L^(5/2) → L^5` estimate for the circular band maximal
operator. Its only frequency loss is `(j+3)^2`; no dimension hypothesis or
positive subpower loss remains. -/
theorem planar_rs_q4_full_interval (φ : SchwartzMap (Euclidean 2) ℂ)
    (hφone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → φ ξ = 1)
    (hφzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → φ ξ = 0)
    (hφrad : Auto.Spherical.AHRS.IsNormRadial (φ : Euclidean 2 → ℂ)) :
    ∃ D : ℝ, 0 < D ∧ ∀ j : ℕ, ∀ f : SchwartzMap (Euclidean 2) ℂ,
      eLpNorm (Auto.Spherical.SphericalMaximalL2.fractalDyadicBandpassMaximal 2 (Icc (1 : ℝ) 2)
          (Auto.Spherical.AHRS.absoluteDyadicBandpass φ hφone hφzero j) f)
          (ENNReal.ofReal 5) volume ≤
        ENNReal.ofReal (D * ((j : ℝ) + 3) ^ 2) *
          eLpNorm (f : Euclidean 2 → ℂ) (ENNReal.ofReal (5 / 2)) volume := by
  obtain ⟨D, hD, hbound⟩ := Auto.Spherical.RS.exists_q4_single_scale
    φ hφone hφzero hφrad (E := Icc (1 : ℝ) 2) Subset.rfl
    (subpowerAssouadCoverBound_one _) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (p := 5 / 2) (by norm_num)
  refine ⟨D, hD, ?_⟩
  intro j f
  have h := hbound j f
  norm_num only [show (2 : ℝ) * (5 / 2) = 5 by norm_num,
    zero_div, Real.rpow_zero, mul_one] at h
  exact h

/-- The MSS logarithmic cutoff also bounds the largest geometric bush
radius. This complements its existing lower bound on the dyadic scale. -/
theorem mss_bush_cutoff_bounds {ρ : ℝ} (hρ : 0 < ρ) (hρone : ρ ≤ 1) :
    0 < Auto.Spherical.MSS.kakeyaRadialBandLevel ρ ∧
      (2 : ℝ) ^ Auto.Spherical.MSS.kakeyaRadialBandLevel ρ < 16 / ρ := by
  have hlo := Auto.Spherical.MSS.four_div_rho_le_two_pow_kakeyaRadialBandLevel hρ
  have hfour : (4 : ℝ) ≤ 4 / ρ := by
    apply (le_div_iff₀ hρ).mpr
    nlinarith
  constructor
  · by_contra hn
    have hz : Auto.Spherical.MSS.kakeyaRadialBandLevel ρ = 0 := by omega
    rw [hz, pow_zero] at hlo
    linarith
  · have harg : 1 ≤ 8 / ρ := by
      apply (le_div_iff₀ hρ).mpr
      linarith
    have hceil := Nat.ceil_lt_add_one (Real.logb_nonneg one_lt_two harg)
    have hpow := Real.rpow_lt_rpow_of_exponent_lt one_lt_two hceil
    rw [Real.rpow_add (by norm_num), Real.rpow_one,
      Real.rpow_logb (by norm_num) (by norm_num) (by positivity)] at hpow
    simpa only [Auto.Spherical.MSS.kakeyaRadialBandLevel, Real.rpow_natCast,
      show 8 / ρ * 2 = 16 / ρ by ring] using hpow

open Classical in
/-- Uniform smooth bush extraction with the logarithmic number of layers
supplied by MSS. The explicit tail hypothesis involves only the original
cardinality and the requested relative radius, not the chosen layer. -/
theorem tubeDecayProfile_logarithmic_bush :
    ∃ A : ℝ, 0 < A ∧ ∀ {ι : Type*} (s : Finset ι) (r : ι → ℝ),
      (∀ i ∈ s, 0 ≤ r i) → ∀ {δ ρ μ : ℝ}, 0 < δ → 0 < ρ → ρ ≤ 1 → 0 < μ →
      ∀ M : ℕ, μ ≤ ∑ i ∈ s, tubeDecayProfile δ M (r i) →
      (s.card : ℝ) * ρ ^ M ≤ μ / 2 →
      ∃ k : ℕ, δ * (2 : ℝ) ^ (k + 1) < 16 * δ / ρ ∧
        μ / (2 * A * (1 + |Real.log ρ|)) ≤ ((2 : ℝ) ^ k)⁻¹ ^ M *
          ((s.filter (fun i => r i ≤ δ * (2 : ℝ) ^ (k + 1))).card : ℝ) := by
  obtain ⟨A, hA, hlog⟩ := Auto.Spherical.MSS.exists_kakeyaRadialBandLevel_log_bound
  refine ⟨A, hA, ?_⟩
  intro ι s r hr δ ρ μ hδ hρ hρone hμ M hmass htail
  let N := Auto.Spherical.MSS.kakeyaRadialBandLevel ρ
  obtain ⟨hN, hNupper⟩ := mss_bush_cutoff_bounds hρ hρone
  have hlower := Auto.Spherical.MSS.four_div_rho_le_two_pow_kakeyaRadialBandLevel hρ
  have hinv : ((2 : ℝ) ^ N)⁻¹ ≤ ρ := by
    rw [← one_div]
    apply (div_le_iff₀ (by positivity)).mpr
    have h := (div_le_iff₀ hρ).mp hlower
    dsimp only [N]
    nlinarith
  have htailN : (s.card : ℝ) * (((2 : ℝ) ^ N)⁻¹ ^ M) ≤ μ / 2 :=
    (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) hinv M)
      (by positivity)).trans htail
  obtain ⟨k, hk, hbound⟩ := tubeDecayProfile_bush_extraction s r hr hδ M N hN hmass htailN
  refine ⟨k, ?_, ?_⟩
  · have hpow : (2 : ℝ) ^ (k + 1) ≤ 2 ^ N :=
      pow_le_pow_right₀ (by norm_num) (by omega)
    calc δ * (2 : ℝ) ^ (k + 1) ≤ δ * 2 ^ N := mul_le_mul_of_nonneg_left hpow hδ.le
      _ < δ * (16 / ρ) := mul_lt_mul_of_pos_left hNupper hδ
      _ = 16 * δ / ρ := by ring
  · apply le_trans ?_ hbound
    apply div_le_div_of_nonneg_left hμ.le (by positivity)
    have h := hlog ρ hρ hρone
    dsimp only [N]
    nlinarith

/-- Polynomial cardinality and multiplicity bounds discharge the smooth
tail. The decay order is chosen before the spatial scale; in particular the
constants do not grow with the number of dyadic layers. -/
theorem tubeDecayProfile_polynomial_tail {n δ a b e μ : ℝ} {M : ℕ}
    (hδ : 0 < δ) (hδhalf : δ ≤ 1 / 2)
    (hcard : n ≤ δ ^ (-a)) (hmass : δ ^ b ≤ μ)
    (horder : a + b + 1 ≤ e * (M : ℝ)) :
    n * (δ ^ e) ^ M ≤ μ / 2 := by
  have hδone : δ ≤ 1 := by linarith
  have hpow : (δ ^ e) ^ M = δ ^ (e * (M : ℝ)) := by
    rw [← Real.rpow_natCast, Real.rpow_mul hδ.le]
  calc n * (δ ^ e) ^ M ≤ δ ^ (-a) * (δ ^ e) ^ M := by
        exact mul_le_mul_of_nonneg_right hcard (by positivity)
    _ = δ ^ (-a + e * (M : ℝ)) := by rw [hpow, Real.rpow_add hδ]
    _ ≤ δ ^ (b + 1) :=
      Real.rpow_le_rpow_of_exponent_ge hδ hδone (by linarith)
    _ = δ ^ b * δ := by rw [Real.rpow_add hδ, Real.rpow_one]
    _ ≤ μ / 2 := by
      have hμ : 0 ≤ μ := (Real.rpow_pos_of_pos hδ b).le.trans hmass
      nlinarith [mul_le_mul_of_nonneg_right hmass hδ.le]

/-- The largest enlargement selected by the logarithmic cutoff lies below
the admissible power radius when the original scale is sufficiently small. -/
theorem bush_radius_le_power {δ e : ℝ} (hδ : 0 < δ)
    (hsmall : δ ^ e ≤ 1 / 16) :
    16 * δ / δ ^ e ≤ δ ^ (1 - 2 * e) := by
  have hid : 16 * δ / δ ^ e = (16 * δ ^ e) * δ ^ (1 - 2 * e) := by
    apply (div_eq_iff (Real.rpow_pos_of_pos hδ e).ne').mpr
    calc 16 * δ = 16 * δ ^ (e + (1 - 2 * e) + e) := by
          rw [show e + (1 - 2 * e) + e = 1 by ring, Real.rpow_one]
      _ = (16 * δ ^ e) * δ ^ (1 - 2 * e) * δ ^ e := by
          rw [Real.rpow_add hδ, Real.rpow_add hδ]
          ring
  rw [hid]
  exact mul_le_of_le_one_left (Real.rpow_nonneg hδ.le _) (by linarith)

open Classical in
/-- Wolff's smooth multiplicity extraction at an admissible power radius.
Here `e` is half the source's small loss parameter. The hypotheses on the
decay order and scale explicitly discharge the tail, using the existing
MSS logarithmic cutoff. -/
theorem tubeDecayProfile_admissible_bush :
    ∃ A : ℝ, 0 < A ∧ ∀ {ι : Type*} (s : Finset ι) (r : ι → ℝ),
      (∀ i ∈ s, 0 ≤ r i) → ∀ {δ a b e μ : ℝ}, 0 < δ → δ ≤ 1 / 2 →
      0 < e → δ ^ e ≤ 1 / 16 → (s.card : ℝ) ≤ δ ^ (-a) → δ ^ b ≤ μ →
      ∀ M : ℕ, a + b + 1 ≤ e * (M : ℝ) →
      μ ≤ ∑ i ∈ s, tubeDecayProfile δ M (r i) →
      ∃ k : ℕ, δ * (2 : ℝ) ^ (k + 1) ≤ δ ^ (1 - 2 * e) ∧
        μ / (2 * A * (1 + e * |Real.log δ|)) ≤ ((2 : ℝ) ^ k)⁻¹ ^ M *
          ((s.filter (fun i => r i ≤ δ * (2 : ℝ) ^ (k + 1))).card : ℝ) := by
  obtain ⟨A, hA, hmain⟩ := tubeDecayProfile_logarithmic_bush
  refine ⟨A, hA, ?_⟩
  intro ι s r hr δ a b e μ hδ hδhalf he hsmall hcard hμ M horder hmass
  have hρ : 0 < δ ^ e := Real.rpow_pos_of_pos hδ e
  have hρone : δ ^ e ≤ 1 := by linarith
  have hμpos : 0 < μ := (Real.rpow_pos_of_pos hδ b).trans_le hμ
  have htail := tubeDecayProfile_polynomial_tail hδ hδhalf hcard hμ horder
  obtain ⟨k, hk, hbound⟩ := hmain s r hr hδ hρ hρone hμpos M hmass htail
  refine ⟨k, hk.le.trans (bush_radius_le_power hδ hsmall), ?_⟩
  have hlog : |Real.log (δ ^ e)| = e * |Real.log δ| := by
    rw [Real.log_rpow hδ, abs_mul, abs_of_pos he]
  simpa only [hlog] using hbound

/-- The decay order and small-scale threshold can be fixed using only the
polynomial exponents and the desired radius loss. -/
theorem exists_bush_decay_parameters (a b : ℝ) {e : ℝ} (he : 0 < e) :
    ∃ M : ℕ, ∃ δ₀ : ℝ, 0 < δ₀ ∧ δ₀ ≤ 1 / 2 ∧
      a + b + 1 ≤ e * (M : ℝ) ∧
      ∀ δ : ℝ, 0 < δ → δ ≤ δ₀ → δ ^ e ≤ 1 / 16 := by
  let M : ℕ := ⌈(a + b + 1) / e⌉₊
  let c : ℝ := (1 / 16 : ℝ) ^ e⁻¹
  have hc : 0 < c := Real.rpow_pos_of_pos (by norm_num) _
  refine ⟨M, min (1 / 2) c, lt_min (by norm_num) hc, min_le_left _ _, ?_, ?_⟩
  · have h := (div_le_iff₀ he).mp (Nat.le_ceil ((a + b + 1) / e))
    simpa only [M, mul_comm] using h
  · intro δ hδ hsmall
    calc δ ^ e ≤ c ^ e :=
          Real.rpow_le_rpow hδ.le (hsmall.trans (min_le_right _ _)) he.le
      _ = (1 / 16 : ℝ) := by
          dsimp only [c]
          rw [← Real.rpow_mul (by norm_num), inv_mul_cancel₀ he.ne', Real.rpow_one]

open Classical in
/-- Uniform form of the smooth bush lemma: the decay order and admissible
scale depend only on the polynomial multiplicity bounds and radius loss.
The weighted cardinality inequality is equivalent to the usual lower bound
of a constant times `μ * 2^(k*M) / (1+|log δ|)` for the selected bush. -/
theorem tubeDecayProfile_uniform_bush (a b : ℝ) {e : ℝ} (he : 0 < e) :
    ∃ M : ℕ, ∃ δ₀ A : ℝ, 0 < δ₀ ∧ 0 < A ∧
      ∀ {ι : Type*} (s : Finset ι) (r : ι → ℝ), (∀ i ∈ s, 0 ≤ r i) →
      ∀ {δ μ : ℝ}, 0 < δ → δ ≤ δ₀ → (s.card : ℝ) ≤ δ ^ (-a) → δ ^ b ≤ μ →
      μ ≤ ∑ i ∈ s, tubeDecayProfile δ M (r i) →
      ∃ k : ℕ, δ * (2 : ℝ) ^ (k + 1) ≤ δ ^ (1 - 2 * e) ∧
        μ / (A * (1 + |Real.log δ|)) ≤ ((2 : ℝ) ^ k)⁻¹ ^ M *
          ((s.filter (fun i => r i ≤ δ * (2 : ℝ) ^ (k + 1))).card : ℝ) := by
  obtain ⟨M, δ₀, hδ₀, hδ₀half, horder, hsmall⟩ := exists_bush_decay_parameters a b he
  obtain ⟨A, hA, hmain⟩ := tubeDecayProfile_admissible_bush
  refine ⟨M, δ₀, 2 * A * (1 + e), hδ₀, by positivity, ?_⟩
  intro ι s r hr δ μ hδ hδsmall hcard hμ hmass
  obtain ⟨k, hk, hb⟩ := hmain s r hr hδ (hδsmall.trans hδ₀half) he
    (hsmall δ hδ hδsmall) hcard hμ M horder hmass
  refine ⟨k, hk, le_trans ?_ hb⟩
  apply div_le_div_of_nonneg_left ((Real.rpow_pos_of_pos hδ b).le.trans hμ)
    (by positivity)
  have hlog : 0 ≤ |Real.log δ| := abs_nonneg _
  nlinarith [mul_nonneg hA.le hlog, mul_nonneg hA.le he.le]

open Classical in
/-- The converse smooth bush estimate: every member whose distance from the
base is at most `η` contributes the stated positive amount to multiplicity.
For `δ ≤ η`, this is at least `(δ/(2η))^M`, the source's converse up to a
constant depending only on the fixed decay order. -/
theorem bush_cardinality_le_smooth_multiplicity {ι : Type*} (s : Finset ι)
    (r : ι → ℝ) (hr : ∀ i ∈ s, 0 ≤ r i) {δ η : ℝ}
    (hδ : 0 < δ) (hη : 0 ≤ η) (M : ℕ) :
    ((s.filter (fun i => r i ≤ η)).card : ℝ) * (δ / (δ + η)) ^ M ≤
      ∑ i ∈ s, tubeDecayProfile δ M (r i) := by
  calc ((s.filter (fun i => r i ≤ η)).card : ℝ) * (δ / (δ + η)) ^ M
      = ∑ i ∈ s.filter (fun i => r i ≤ η), (δ / (δ + η)) ^ M := by simp
    _ ≤ ∑ i ∈ s.filter (fun i => r i ≤ η), tubeDecayProfile δ M (r i) := by
      apply Finset.sum_le_sum
      intro i hi
      obtain ⟨his, hir⟩ := Finset.mem_filter.mp hi
      unfold tubeDecayProfile
      apply pow_le_pow_left₀ (by positivity)
      exact div_le_div_of_nonneg_left hδ.le (by linarith [hr i his]) (by linarith)
    _ ≤ ∑ i ∈ s, tubeDecayProfile δ M (r i) := by
      apply Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
      intro i hi _
      unfold tubeDecayProfile
      exact pow_nonneg (div_nonneg hδ.le (by linarith [hr i hi])) _

/-- A dyadic enlargement simultaneously contains two residuals and pays
for the smaller of their smooth profiles. -/
theorem exists_dyadic_profile_layer {δ r s : ℝ} (hδ : 0 < δ)
    (hr : 0 ≤ r) (_hs : 0 ≤ s) (M : ℕ) :
    ∃ k : ℕ, r ≤ δ * (2 : ℝ) ^ (k + 1) ∧ s ≤ δ * (2 : ℝ) ^ (k + 1) ∧
      min (tubeDecayProfile δ M r) (tubeDecayProfile δ M s) ≤ ((2 : ℝ) ^ k)⁻¹ ^ M := by
  by_cases hsmall : max r s ≤ δ
  · refine ⟨0, ?_, ?_, ?_⟩
    · norm_num
      linarith [le_max_left r s]
    · norm_num
      linarith [le_max_right r s]
    · simpa using (min_le_left _ _).trans (tubeDecayProfile_le_one hδ hr M)
  · have hratio : 1 ≤ max r s / δ := (le_div_iff₀ hδ).mpr (by linarith)
    obtain ⟨k, hklo, hkhi⟩ := exists_nat_pow_near hratio (by norm_num : (1 : ℝ) < 2)
    have hu : max r s ≤ δ * (2 : ℝ) ^ (k + 1) := by
      have h := (div_lt_iff₀ hδ).mp hkhi
      nlinarith
    have hl : δ * (2 : ℝ) ^ k ≤ max r s := by
      have h := (le_div_iff₀ hδ).mp hklo
      nlinarith
    refine ⟨k, (le_max_left r s).trans hu, (le_max_right r s).trans hu, ?_⟩
    have hb : tubeDecayProfile δ M (max r s) ≤ ((2 : ℝ) ^ k)⁻¹ ^ M := by
      apply pow_le_pow_left₀ (by positivity)
      rw [inv_eq_one_div]
      apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
      linarith
    rcases le_total r s with h | h
    · rw [max_eq_right h] at hb
      exact (min_le_right _ _).trans hb
    · rw [max_eq_left h] at hb
      exact (min_le_left _ _).trans hb

open Classical in
/-- Smooth transverse overlap is majorized by a series of hard tube
intersections, so the verified cubic volume estimate can be integrated
without discarding the tails. -/
theorem min_tubeDecayProfile_le_tsum_intersections {a b v w : Euclidean 2}
    {δ : ℝ} (hδ : 0 < δ) (M : ℕ) (z : Euclidean 2 × ℝ) :
    ENNReal.ofReal (min (tubeDecayProfile δ M ‖z.1 - (a + z.2 • v)‖)
      (tubeDecayProfile δ M ‖z.1 - (b + z.2 • w)‖)) ≤
      ∑' k : ℕ, (lightRayTube a v (δ * (2 : ℝ) ^ (k + 1)) ∩
        lightRayTube b w (δ * (2 : ℝ) ^ (k + 1))).indicator
          (fun _ => ENNReal.ofReal (((2 : ℝ) ^ k)⁻¹ ^ M)) z := by
  obtain ⟨k, hk₁, hk₂, hk⟩ := exists_dyadic_profile_layer hδ
    (norm_nonneg (z.1 - (a + z.2 • v))) (norm_nonneg (z.1 - (b + z.2 • w))) M
  have hmem : z ∈ lightRayTube a v (δ * (2 : ℝ) ^ (k + 1)) ∩
      lightRayTube b w (δ * (2 : ℝ) ^ (k + 1)) := ⟨hk₁, hk₂⟩
  apply le_trans (ENNReal.ofReal_le_ofReal hk)
  have h := ENNReal.le_tsum k (f := fun k : ℕ =>
    (lightRayTube a v (δ * (2 : ℝ) ^ (k + 1)) ∩
      lightRayTube b w (δ * (2 : ℝ) ^ (k + 1))).indicator
        (fun _ => ENNReal.ofReal (((2 : ℝ) ^ k)⁻¹ ^ M)) z)
  simpa only [Set.indicator_of_mem hmem] using h

/-- The fourth-order profile and cubic tube volume leave a summable
geometric factor. -/
theorem dyadic_profile_volume_coefficient (δ : ℝ) (k : ℕ) :
    (((2 : ℝ) ^ k)⁻¹ ^ 4) * (δ * (2 : ℝ) ^ (k + 1)) ^ 3 =
      8 * δ ^ 3 * ((1 / 2 : ℝ) ^ k) := by
  rw [pow_succ, one_div_pow]
  field_simp
  ring

open Classical in
/-- The smooth transverse overlap integral has the same cubic scale as
hard tube intersection. This includes all spatial and temporal tails. -/
theorem lightRayTube_smooth_overlap {κ : ℝ} (hκ : 0 < κ) :
    ∃ C : ℝ, 0 < C ∧ ∀ a b v w : Euclidean 2, ∀ δ : ℝ, 0 < δ →
      κ ≤ ‖v - w‖ → ‖v‖ ≤ 1 →
      (∫⁻ z : Euclidean 2 × ℝ,
        ENNReal.ofReal (min (tubeDecayProfile δ 4 ‖z.1 - (a + z.2 • v)‖)
          (tubeDecayProfile δ 4 ‖z.1 - (b + z.2 • w)‖)) ∂volume.prod volume) ≤
        ENNReal.ofReal (C * δ ^ 3) := by
  obtain ⟨C, hC, hvolume⟩ := lightRayTube_intersection_volume_cubic hκ
  refine ⟨16 * C, by positivity, ?_⟩
  intro a b v w δ hδ hvw hv
  let T : ℕ → Set (Euclidean 2 × ℝ) := fun k =>
    lightRayTube a v (δ * (2 : ℝ) ^ (k + 1)) ∩
      lightRayTube b w (δ * (2 : ℝ) ^ (k + 1))
  have hT : ∀ k, MeasurableSet (T k) := fun k =>
    ((isClosed_lightRayTube _ _ _).inter (isClosed_lightRayTube _ _ _)).measurableSet
  have hseries : (∫⁻ z : Euclidean 2 × ℝ,
      ∑' k : ℕ, (T k).indicator (fun _ => ENNReal.ofReal (((2 : ℝ) ^ k)⁻¹ ^ 4)) z
        ∂volume.prod volume) =
      ∑' k : ℕ, ENNReal.ofReal (((2 : ℝ) ^ k)⁻¹ ^ 4) * (volume.prod volume) (T k) := by
    rw [lintegral_tsum (fun k => (measurable_const.indicator (hT k)).aemeasurable)]
    congr 1
    funext k
    rw [lintegral_indicator (hT k), lintegral_const, Measure.restrict_apply_univ]
  calc
    _ ≤ ∫⁻ z : Euclidean 2 × ℝ,
        ∑' k : ℕ, (T k).indicator (fun _ => ENNReal.ofReal (((2 : ℝ) ^ k)⁻¹ ^ 4)) z
          ∂volume.prod volume :=
      lintegral_mono (min_tubeDecayProfile_le_tsum_intersections hδ 4)
    _ = ∑' k : ℕ, ENNReal.ofReal (((2 : ℝ) ^ k)⁻¹ ^ 4) *
        (volume.prod volume) (T k) := hseries
    _ ≤ ∑' k : ℕ, ENNReal.ofReal (8 * C * δ ^ 3) * ENNReal.ofReal ((1 / 2 : ℝ) ^ k) := by
      apply ENNReal.tsum_le_tsum
      intro k
      calc _ ≤ ENNReal.ofReal (((2 : ℝ) ^ k)⁻¹ ^ 4) *
            (ENNReal.ofReal C * ENNReal.ofReal (δ * (2 : ℝ) ^ (k + 1)) ^ 3) :=
          mul_le_mul' le_rfl (hvolume a b v w _ (by positivity) hvw hv)
        _ = _ := by
          rw [← ENNReal.ofReal_pow (by positivity),
            ← ENNReal.ofReal_mul hC.le, ← ENNReal.ofReal_mul (by positivity),
            ← ENNReal.ofReal_mul (by positivity)]
          congr 1
          have h := dyadic_profile_volume_coefficient δ k
          nlinarith [h]
    _ = ENNReal.ofReal ((16 * C) * δ ^ 3) := by
      simp_rw [ENNReal.ofReal_pow (by norm_num : (0 : ℝ) ≤ 1 / 2)]
      simp_rw [ENNReal.ofReal_div_of_pos (by norm_num : (0 : ℝ) < 2)]
      rw [ENNReal.tsum_mul_left]
      simp only [ENNReal.ofReal_one, ENNReal.ofReal_ofNat, one_div,
        ENNReal.tsum_geometric_two]
      rw [← ENNReal.ofReal_ofNat (n := 2)]
      rw [← ENNReal.ofReal_mul (by positivity)]
      congr 1
      ring

/-- Increasing the distance decreases the tube profile. -/
theorem tubeDecayProfile_antitone_radius {δ r s : ℝ} (hδ : 0 < δ)
    (hr : 0 ≤ r) (hrs : r ≤ s) (M : ℕ) :
    tubeDecayProfile δ M s ≤ tubeDecayProfile δ M r := by
  have hs : 0 ≤ s := hr.trans hrs
  apply pow_le_pow_left₀ (by positivity)
  exact div_le_div_of_nonneg_left hδ.le (by linarith) (by linarith)

/-- The smaller profile is precisely the profile at the larger distance. -/
theorem min_tubeDecayProfile {δ r s : ℝ} (hδ : 0 < δ)
    (hr : 0 ≤ r) (hs : 0 ≤ s) (M : ℕ) :
    min (tubeDecayProfile δ M r) (tubeDecayProfile δ M s) =
      tubeDecayProfile δ M (max r s) := by
  rcases le_total r s with h | h
  · rw [max_eq_right h, min_eq_right (tubeDecayProfile_antitone_radius hδ hr h M)]
  · rw [max_eq_left h, min_eq_left (tubeDecayProfile_antitone_radius hδ hs h M)]

/-- Away from at least one axis, reserve four decay powers for integrable
transverse overlap and retain all the remaining powers as distance decay. -/
theorem min_tubeDecayProfile_far {δ r s R : ℝ} (hδ : 0 < δ)
    (hr : 0 ≤ r) (hs : 0 ≤ s) (hR : 0 ≤ R) (hfar : R ≤ max r s) (M : ℕ) :
    min (tubeDecayProfile δ (M + 4) r) (tubeDecayProfile δ (M + 4) s) ≤
      (δ / (δ + R)) ^ M * min (tubeDecayProfile δ 4 r) (tubeDecayProfile δ 4 s) := by
  rw [min_tubeDecayProfile hδ hr hs, min_tubeDecayProfile hδ hr hs]
  have h := tubeDecayProfile_antitone_radius hδ hR hfar M
  unfold tubeDecayProfile at h ⊢
  rw [pow_add]
  exact mul_le_mul_of_nonneg_right h (by positivity)

/-- The transverse smooth overlap on a region separated from the two axes.
The decay order is arbitrary, and the constant is uniform in that order,
the axes, the tube width, and the distance to the axes. -/
theorem lightRayTube_smooth_overlap_far {κ : ℝ} (hκ : 0 < κ) :
    ∃ C : ℝ, 0 < C ∧ ∀ a b v w : Euclidean 2, ∀ δ R : ℝ,
      0 < δ → 0 ≤ R → κ ≤ ‖v - w‖ → ‖v‖ ≤ 1 →
      ∀ Ω : Set (Euclidean 2 × ℝ), MeasurableSet Ω →
      (∀ z ∈ Ω, R ≤ max ‖z.1 - (a + z.2 • v)‖ ‖z.1 - (b + z.2 • w)‖) →
      ∀ M : ℕ,
      (∫⁻ z : Euclidean 2 × ℝ in Ω,
        ENNReal.ofReal (min (tubeDecayProfile δ (M + 4) ‖z.1 - (a + z.2 • v)‖)
          (tubeDecayProfile δ (M + 4) ‖z.1 - (b + z.2 • w)‖)) ∂volume.prod volume) ≤
        ENNReal.ofReal (C * δ ^ 3 * (δ / (δ + R)) ^ M) := by
  obtain ⟨C, hC, hpair⟩ := lightRayTube_smooth_overlap hκ
  refine ⟨C, hC, ?_⟩
  intro a b v w δ R hδ hR hvw hv Ω hΩ hfar M
  let F : Euclidean 2 × ℝ → ENNReal := fun z =>
    ENNReal.ofReal (min (tubeDecayProfile δ 4 ‖z.1 - (a + z.2 • v)‖)
      (tubeDecayProfile δ 4 ‖z.1 - (b + z.2 • w)‖))
  let c : ℝ := (δ / (δ + R)) ^ M
  have hc : 0 ≤ c := by dsimp [c]; positivity
  calc
    _ ≤ ∫⁻ z in Ω, ENNReal.ofReal c * F z ∂volume.prod volume := by
      apply lintegral_mono_ae
      filter_upwards [ae_restrict_mem hΩ] with z hz
      rw [← ENNReal.ofReal_mul hc]
      exact ENNReal.ofReal_le_ofReal
        (min_tubeDecayProfile_far hδ (norm_nonneg _) (norm_nonneg _) hR (hfar z hz) M)
    _ = ENNReal.ofReal c * ∫⁻ z in Ω, F z ∂volume.prod volume :=
      lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
    _ ≤ ENNReal.ofReal c * ∫⁻ z, F z ∂volume.prod volume :=
      mul_le_mul' le_rfl (lintegral_mono' Measure.restrict_le_self le_rfl)
    _ ≤ ENNReal.ofReal c * ENNReal.ofReal (C * δ ^ 3) :=
      mul_le_mul' le_rfl (hpair a b v w δ hδ hvw hv)
    _ = ENNReal.ofReal (C * δ ^ 3 * (δ / (δ + R)) ^ M) := by
      rw [← ENNReal.ofReal_mul hc]
      congr 1
      exact mul_comm _ _

/-- The null-cone identity for two chords from a common unit direction.
It converts proximity of the scaled chords into control of their time
parameters, provided one direction is transverse to the common direction. -/
theorem unit_chord_time_identity {d : ℕ} {u v w : Euclidean d}
    (hu : ‖u‖ = 1) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1) (t s : ℝ) :
    ‖t • (v - w)‖ ^ 2 - ‖s • (u - w)‖ ^ 2 +
      2 * s * inner ℝ w (t • (v - w) - s • (u - w)) =
        t * (t - s) * ‖v - w‖ ^ 2 := by
  simp only [norm_smul, Real.norm_eq_abs, mul_pow, sq_abs, inner_sub_right,
    real_inner_smul_right, norm_sub_sq_real, real_inner_self_eq_norm_sq,
    hu, hv, hw, real_inner_comm w v, real_inner_comm w u]
  ring

/-- Approximate intersection of two rays from a bush with a transverse
light ray forces their time parameters to be close away from the base. -/
theorem unit_chord_time_separation {d : ℕ} {u v w : Euclidean d}
    (hu : ‖u‖ = 1) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1)
    {t s R κ ε : ℝ} (hR : 0 < R) (ht : R ≤ t) (htone : t ≤ 1)
    (hs : 0 ≤ s) (hsone : s ≤ 1) (hκ : 0 < κ) (hsep : κ ≤ ‖v - w‖)
    (hclose : ‖t • (v - w) - s • (u - w)‖ ≤ ε) :
    |t - s| ≤ 6 * ε / (R * κ ^ 2) := by
  have ht0 : 0 ≤ t := hR.le.trans ht
  have hε : 0 ≤ ε := (norm_nonneg _).trans hclose
  have hvw : ‖v - w‖ ≤ 2 := by
    have h := norm_sub_le v w
    rw [hv, hw] at h
    linarith
  have huw : ‖u - w‖ ≤ 2 := by
    have h := norm_sub_le u w
    rw [hu, hw] at h
    linarith
  have htv : ‖t • (v - w)‖ ≤ 2 := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg ht0]
    nlinarith [norm_nonneg (v - w)]
  have hsu : ‖s • (u - w)‖ ≤ 2 := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hs]
    nlinarith [norm_nonneg (u - w)]
  have hn := (abs_norm_sub_norm_le (t • (v - w)) (s • (u - w))).trans hclose
  have hsq : |‖t • (v - w)‖ ^ 2 - ‖s • (u - w)‖ ^ 2| ≤ 4 * ε := by
    rw [sq_sub_sq, abs_mul, abs_of_nonneg (by positivity :
      0 ≤ ‖t • (v - w)‖ + ‖s • (u - w)‖)]
    exact (mul_le_mul_of_nonneg_left hn (by positivity)).trans (by nlinarith)
  have hi : |inner ℝ w (t • (v - w) - s • (u - w))| ≤ ε := by
    exact (abs_real_inner_le_norm _ _).trans (by simpa [hw] using hclose)
  have hid := unit_chord_time_identity hu hv hw t s
  have hab : t * |t - s| * ‖v - w‖ ^ 2 ≤ 6 * ε := by
    have heq : |t * (t - s) * ‖v - w‖ ^ 2| = t * |t - s| * ‖v - w‖ ^ 2 := by
      simp only [abs_mul, abs_of_nonneg ht0, abs_of_nonneg (sq_nonneg ‖v - w‖)]
    rw [← heq, ← hid]
    apply (abs_add_le _ _).trans
    rw [abs_mul, abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2), abs_of_nonneg hs]
    nlinarith [mul_le_mul_of_nonneg_left hi (by positivity : 0 ≤ 2 * s)]
  apply (le_div_iff₀ (by positivity)).mpr
  have hk : κ ^ 2 ≤ ‖v - w‖ ^ 2 := by nlinarith [norm_nonneg (v - w)]
  have hrt : R * κ ^ 2 ≤ t * ‖v - w‖ ^ 2 :=
    (mul_le_mul_of_nonneg_right ht (sq_nonneg κ)).trans
      (mul_le_mul_of_nonneg_left hk ht0)
  nlinarith [mul_le_mul_of_nonneg_left hrt (abs_nonneg (t - s))]

/-- The directions of two rays in a bush are close if both meet the same
transverse ray away from the base, with an explicit error bound. -/
theorem unit_chord_direction_separation {d : ℕ} {u v w : Euclidean d}
    (hu : ‖u‖ = 1) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1)
    {t s R κ ε : ℝ} (hR : 0 < R) (ht : R ≤ t) (htone : t ≤ 1)
    (hs : 0 ≤ s) (hsone : s ≤ 1) (hκ : 0 < κ) (hsep : κ ≤ ‖v - w‖)
    (hclose : ‖t • (v - w) - s • (u - w)‖ ≤ ε) :
    ‖v - u‖ ≤ (ε + 12 * ε / (R * κ ^ 2)) / R := by
  have htime := unit_chord_time_separation hu hv hw hR ht htone hs hsone hκ hsep hclose
  have hε : 0 ≤ ε := (norm_nonneg _).trans hclose
  have huw : ‖u - w‖ ≤ 2 := by
    have h := norm_sub_le u w
    rw [hu, hw] at h
    linarith
  have heq : t • (v - u) = (t • (v - w) - s • (u - w)) - (t - s) • (u - w) := by
    module
  have hnorm : t * ‖v - u‖ ≤ ε + 12 * ε / (R * κ ^ 2) := by
    have h := norm_sub_le (t • (v - w) - s • (u - w)) ((t - s) • (u - w))
    rw [← heq, norm_smul, Real.norm_eq_abs, abs_of_nonneg (hR.le.trans ht),
      norm_smul, Real.norm_eq_abs] at h
    have hprod := mul_le_mul_of_nonneg_left huw (abs_nonneg (t - s))
    calc t * ‖v - u‖ ≤ ε + |t - s| * 2 := h.trans (add_le_add hclose hprod)
      _ ≤ ε + (6 * ε / (R * κ ^ 2)) * 2 := by gcongr
      _ = ε + 12 * ε / (R * κ ^ 2) := by ring
  apply (le_div_iff₀ hR).mpr
  nlinarith [mul_le_mul_of_nonneg_right ht (norm_nonneg (v - u))]

/-- Tube displacement with different widths at the two points. -/
theorem lightRayTube_displacement_two_widths {d : ℕ} {a v : Euclidean d}
    {δ η : ℝ} {z p : Euclidean d × ℝ}
    (hz : z ∈ lightRayTube a v δ) (hp : p ∈ lightRayTube a v η) :
    ‖(z.1 - p.1) - (z.2 - p.2) • v‖ ≤ δ + η := by
  have heq : (z.1 - p.1) - (z.2 - p.2) • v =
      (z.1 - (a + z.2 • v)) - (p.1 - (a + p.2 • v)) := by module
  rw [heq]
  exact (norm_sub_le _ _).trans (add_le_add hz hp)

/-- Literal bush and transverse-tube incidences imply the chord proximity
used by the geometric direction count. -/
theorem lightRayTube_bush_chord_proximity {d : ℕ} {a a' b u v w : Euclidean d}
    {δ η ρ : ℝ} {z z' p : Euclidean d × ℝ}
    (hz : z ∈ lightRayTube a v δ) (hz' : z' ∈ lightRayTube a' u δ)
    (hp : p ∈ lightRayTube a v η) (hp' : p ∈ lightRayTube a' u η)
    (hb : z ∈ lightRayTube b w ρ) (hb' : z' ∈ lightRayTube b w ρ) :
    ‖(z.2 - p.2) • (v - w) - (z'.2 - p.2) • (u - w)‖ ≤
      2 * δ + 2 * η + 2 * ρ := by
  have h₁ := lightRayTube_displacement_two_widths hz hp
  have h₂ := lightRayTube_displacement_two_widths hz' hp'
  have h₃ := lightRayTube_displacement hb hb'
  have heq : (z.2 - p.2) • (v - w) - (z'.2 - p.2) • (u - w) =
      -((z.1 - p.1) - (z.2 - p.2) • v) +
        ((z'.1 - p.1) - (z'.2 - p.2) • u) +
          ((z.1 - z'.1) - (z.2 - z'.2) • w) := by module
  rw [heq]
  have h := norm_add_le (-((z.1 - p.1) - (z.2 - p.2) • v) +
    ((z'.1 - p.1) - (z'.2 - p.2) • u)) ((z.1 - z'.1) - (z.2 - z'.2) • w)
  have h' := norm_add_le (-((z.1 - p.1) - (z.2 - p.2) • v))
    ((z'.1 - p.1) - (z'.2 - p.2) • u)
  rw [norm_neg] at h'
  linarith

