/-- The sharp short-interval estimate, including the quadratic endpoint. -/
theorem exists_smoothed_interval_dyadic_bound_ge_two_sharp {d N : ℕ} (hd : 2 ≤ d)
    (K : SchwartzMap (Euclidean d) ℂ) (hK : ∀ u, (1 : ℝ) / 100 < ‖u‖ → K u = 0)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d)) (fun ξ => 𝓕 K ξ) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) {p : ℝ} (hp : 2 ≤ p) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (s m : ℕ) (a b : ℝ), m ≤ s + 1 → 1 ≤ a → a ≤ b → b ≤ 2 →
      b - a ≤ ((2 : ℝ) ^ s)⁻¹ → ∀ (h : SchwartzMap (Euclidean d) ℂ),
      (∀ y, 2 * ((2 : ℝ) ^ m)⁻¹ < ‖y‖ → h y = 0) →
      (∫⁻ x, (⨆ t : Icc a b,
          ‖sphericalAverage d (compactConvolution (compactDyadicDilate K s) h) t x‖ₑ) ^ p) ≤
        A * (2 : ℝ≥0∞) ^ (-((s : ℝ) * (d - 1)) -
          (m : ℝ) * ((d - 1) * (p - 2))) * ∫⁻ y, ‖h y‖ₑ ^ p := by
  rcases eq_or_lt_of_le hp with rfl | hp
  · simpa only [div_self (by norm_num : (2 : ℝ) ≠ 0), sub_self, zero_mul, mul_zero,
      sub_zero, zero_sub, mul_neg] using
      exists_smoothed_interval_dyadic_bound_ge_two hd K hK hflat hN (p := 2) le_rfl
  · exact exists_smoothed_interval_dyadic_bound_gt_two_sharp hd K hK hflat hN hp


/-- Spherical averages of inputs near the origin vanish far away. -/
theorem sphericalAverage_eq_zero_of_far {d : ℕ} (F : SchwartzMap (Euclidean d) ℂ) {R : ℝ}
    (hF : ∀ z, R < ‖z‖ → F z = 0) {t : ℝ} (ht0 : 0 ≤ t) {x : Euclidean d}
    (hx : t + R < ‖x‖) : sphericalAverage d F t x = 0 := by
  unfold sphericalAverage
  apply integral_eq_zero_of_ae
  filter_upwards with ω
  apply hF
  have hω : ‖(ω : Euclidean d)‖ = 1 := by simp
  have := norm_sub_norm_le x (-(t • (ω : Euclidean d)))
  rw [norm_neg, norm_smul, hω, mul_one, Real.norm_of_nonneg ht0, sub_neg_eq_add] at this
  linarith

/-- Source `eq:ple2part` in the form used for the assembly: for `1 < p < 2`
the bound on the ball of radius four is a bound on all of space, since the
inputs live near the origin. -/
theorem exists_smoothed_interval_dyadic_bound_lt_two {d N : ℕ} (hd : 2 ≤ d)
    (K : SchwartzMap (Euclidean d) ℂ) (hK : ∀ u, (1 : ℝ) / 100 < ‖u‖ → K u = 0)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d)) (fun ξ => 𝓕 K ξ) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) {p : ℝ} (hp₁ : 1 < p) (hp₂ : p < 2) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ (s : ℕ) (a b : ℝ), 1 ≤ a → a ≤ b → b ≤ 2 →
      b - a ≤ ((2 : ℝ) ^ s)⁻¹ → ∀ (h : SchwartzMap (Euclidean d) ℂ),
      (∀ y, 1 / 8 < ‖y‖ → h y = 0) →
      (∫⁻ x, (⨆ t : Icc a b,
          ‖sphericalAverage d (compactConvolution (compactDyadicDilate K s) h) t x‖ₑ) ^ p) ≤
        A * (2 : ℝ≥0∞) ^ (-((s : ℝ) * ((d : ℝ) - 1) * (p - 1))) * ∫⁻ y, ‖h y‖ₑ ^ p := by
  obtain ⟨A, hA, hb⟩ := exists_smoothed_interval_Lp_bound_lt_two hd K hflat hN hp₁ hp₂
  refine ⟨A, hA, ?_⟩
  intro s a b ha hab hb2 hlen h hh
  set F := compactConvolution (compactDyadicDilate K s) h
  have hj : (1 : ℝ) ≤ 2 ^ s := one_le_pow₀ (by norm_num)
  have hFs : ∀ z, 1 / 4 < ‖z‖ → F z = 0 := fun z hz =>
    compactConvolution_eq_zero_of_radius _ _
      (fun u hu => compactDyadicDilate_eq_zero hK s hu) hh (by
        have : 1 / 100 / (2 : ℝ) ^ s ≤ 1 / 100 := div_le_self (by norm_num) hj
        linarith)
  have hp0 : 0 < p := by linarith
  have heq : (∫⁻ x, (⨆ t : Icc a b, ‖sphericalAverage d F t x‖ₑ) ^ p) =
      ∫⁻ x in Metric.closedBall (0 : Euclidean d) 4,
        (⨆ t : Icc a b, ‖sphericalAverage d F t x‖ₑ) ^ p := by
    rw [← lintegral_indicator measurableSet_closedBall]
    apply lintegral_congr
    intro x
    by_cases hx : x ∈ Metric.closedBall (0 : Euclidean d) 4
    · rw [Set.indicator_of_mem hx]
    · rw [Set.indicator_of_notMem hx]
      have hx4 : 4 < ‖x‖ := by simpa [Metric.mem_closedBall, dist_zero_right] using hx
      have : ∀ t : Icc a b, sphericalAverage d F t x = 0 := fun t =>
        sphericalAverage_eq_zero_of_far F hFs (by linarith [t.2.1]) (by linarith [t.2.2])
      simp [this, ENNReal.zero_rpow_of_pos hp0]
  rw [heq]
  exact hb s a b ha hab hb2 hlen h

/-- An input living outside the ball of radius `2^{-m-1}` has unweighted
moment at most `2^{(m+1)α}` times its `|y|^α`-weighted moment, `α ≥ 0`. -/
theorem lintegral_shell_le_weighted {d : ℕ} {α : ℝ} (hα : 0 ≤ α) (m : ℕ)
    (h : SchwartzMap (Euclidean d) ℂ) (hh : ∀ y, ‖y‖ ≤ ((2 : ℝ) ^ (m + 1))⁻¹ → h y = 0)
    {p : ℝ} (hp : 0 < p) :
    (∫⁻ y, ‖h y‖ₑ ^ p) ≤
      (2 : ℝ≥0∞) ^ (((m : ℝ) + 1) * α) * ∫⁻ y, ‖h y‖ₑ ^ p ∂powerWeightedVolume d α := by
  have hb := lintegral_powerWeightedVolume_le_of_vanish (d := d) hα
    (show (0 : ℝ) < ((2 : ℝ) ^ (m + 1))⁻¹ by positivity) (fun y => ‖h y‖ₑ ^ p)
    (h.continuous.measurable.enorm.pow_const p) (fun y hy => by
      simp [hh y hy.le, ENNReal.zero_rpow_of_pos hp])
  rw [powerWeightedVolume_zero] at hb
  apply hb.trans_eq
  congr 1
  rw [show ((2 : ℝ) ^ (m + 1))⁻¹ = (2 : ℝ) ^ (-((m : ℝ) + 1)) by
      rw [Real.rpow_neg (by norm_num), ← Real.rpow_natCast]; push_cast; ring_nf,
    ofReal_two_rpow, ← ENNReal.rpow_mul]
  congr 1; ring

/-- Source `eq:Iaest`-`eq:IIaest`, one piece: for `d ≥ 2`, `α = (d-1)(p-1) - β`
with `0 < β < 1` and `α > 0`, the input shell `m` and the frequency `2^s`
contribute, over one radius interval of length `2^{-s}`, at most
`2^{-βs - ε|m-s|}` times the weighted input moment. -/
theorem exists_sequence_piece_bound {d N : ℕ} (hd : 2 ≤ d)
    (K : SchwartzMap (Euclidean d) ℂ) (hK : ∀ u, (1 : ℝ) / 100 < ‖u‖ → K u = 0)
    (hflat : Asymptotics.IsBigO (𝓝 (0 : Euclidean d)) (fun ξ => 𝓕 K ξ) (fun ξ => ‖ξ‖ ^ N))
    (hN : ((d : ℝ) - 1) / 2 ≤ N) {p β : ℝ} (hp : 1 < p) (hβ0 : 0 < β) (hβ1 : β < 1)
    (hα : 0 < ((d : ℝ) - 1) * (p - 1) - β) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∃ ε : ℝ, 0 < ε ∧ ∀ (s m : ℕ) (a b : ℝ), 4 ≤ m → 1 ≤ a → a ≤ b →
      b ≤ 2 → b - a ≤ ((2 : ℝ) ^ s)⁻¹ → ∀ (h : SchwartzMap (Euclidean d) ℂ),
      (∀ y, ‖y‖ ≤ ((2 : ℝ) ^ (m + 1))⁻¹ → h y = 0) →
      (∀ y, 2 * ((2 : ℝ) ^ m)⁻¹ ≤ ‖y‖ → h y = 0) →
      (∫⁻ x, (⨆ t : Icc a b,
          ‖sphericalAverage d (compactConvolution (compactDyadicDilate K s) h) t x‖ₑ) ^ p) ≤
        A * (2 : ℝ≥0∞) ^ (-(β * s + ε * |(m : ℝ) - s|)) *
          ∫⁻ y, ‖h y‖ₑ ^ p ∂powerWeightedVolume d (((d : ℝ) - 1) * (p - 1) - β) := by
  set α := ((d : ℝ) - 1) * (p - 1) - β with hαdef
  have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hp0 : 0 < p := by linarith
  set ε := min (p - 1 + β) (min α ((d : ℝ) - 1 - β))
  have hε : 0 < ε := by
    exact lt_min (by linarith) (lt_min hα (by linarith))
  have hε1 : ε ≤ p - 1 + β := min_le_left _ _
  have hε2 : ε ≤ α := (min_le_right _ _).trans (min_le_left _ _)
  have hε3 : ε ≤ (d : ℝ) - 1 - β := (min_le_right _ _).trans (min_le_right _ _)
  -- the fine-input regime `m ≥ s+1`
  obtain ⟨A₁, hA₁, hfine⟩ := exists_smoothed_shell_dyadic_bound (by omega) K hK hp.le
  -- the coarse-input regime `m ≤ s`
  have hcoarse : ∃ A₂ : ℝ≥0∞, A₂ ≠ ∞ ∧ ∀ (s m : ℕ) (a b : ℝ), 4 ≤ m → m ≤ s → 1 ≤ a →
      a ≤ b → b ≤ 2 → b - a ≤ ((2 : ℝ) ^ s)⁻¹ → ∀ (h : SchwartzMap (Euclidean d) ℂ),
      (∀ y, 2 * ((2 : ℝ) ^ m)⁻¹ < ‖y‖ → h y = 0) →
      (∫⁻ x, (⨆ t : Icc a b,
          ‖sphericalAverage d (compactConvolution (compactDyadicDilate K s) h) t x‖ₑ) ^ p) ≤
        A₂ * (2 : ℝ≥0∞) ^ (-(β * s + ε * ((s : ℝ) - m)) - ((m : ℝ) + 1) * α) *
