/-- Two radii in `(0,2]` lying in one multiplicative interval of diameter
`D` are at physical distance at most `2D`. -/
theorem abs_sub_le_of_mem_multiplicativeInterval {c : PositiveRadius} {D : ℝ≥0}
    {r r' : ℝ} (hr : r ∈ multiplicativeInterval c D) (hr' : r' ∈ multiplicativeInterval c D)
    (hr2 : r ≤ 2) (hr2' : r' ≤ 2) : |r - r'| ≤ 2 * (D : ℝ) := by
  have hlog2 : 0 < Real.log 2 := Real.log_pos one_lt_two
  have hlog2le : Real.log 2 ≤ 1 := by
    nlinarith [Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)]
  have hD : (0 : ℝ) ≤ D := D.2
  -- logarithmic distance
  have hlog : |Real.log r - Real.log r'| ≤ (D : ℝ) := by
    have h1 := hr.2
    have h2 := hr'.2
    have hdiff : |Real.log r / Real.log 2 - Real.log r' / Real.log 2| ≤ (D : ℝ) := by
      have := abs_sub_le (Real.log r / Real.log 2) (logRadius c) (Real.log r' / Real.log 2)
      rw [abs_sub_comm (logRadius c)] at this
      linarith
    rw [← sub_div, abs_div, abs_of_pos hlog2, div_le_iff₀ hlog2] at hdiff
    nlinarith [abs_nonneg (Real.log r - Real.log r')]
  -- `r - r' ≤ r (log r - log r')` for `r' ≤ r`
  have key : ∀ {u v : ℝ}, 0 < u → 0 < v → v ≤ u → u ≤ 2 →
      |Real.log u - Real.log v| ≤ (D : ℝ) → u - v ≤ 2 * (D : ℝ) := by
    intro u v hu hv _ hu2 hl
    have hq : Real.log (v / u) ≤ v / u - 1 := Real.log_le_sub_one_of_pos (div_pos hv hu)
    rw [Real.log_div hv.ne' hu.ne'] at hq
    have h1 : 1 - v / u ≤ Real.log u - Real.log v := by linarith
    have h2 : u - v = u * (1 - v / u) := by field_simp
    have h3 : Real.log u - Real.log v ≤ D := (le_abs_self _).trans hl
    rw [h2]
    calc u * (1 - v / u) ≤ u * (Real.log u - Real.log v) :=
          mul_le_mul_of_nonneg_left h1 hu.le
      _ ≤ 2 * D := by nlinarith [hu.le, le_abs_self (Real.log u - Real.log v)]
  rcases le_total r' r with h | h
  · rw [abs_of_nonneg (by linarith)]
    exact key hr.1 hr'.1 h hr2 hlog
  · rw [abs_of_nonpos (by linarith), neg_sub]
    exact key hr'.1 hr.1 h hr2' (by rwa [abs_sub_comm])

