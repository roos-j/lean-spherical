      gcongr
      · norm_num
      · have hms' : (m : ℝ) ≤ s := by exact_mod_cast hms
        have : -((s : ℝ) * (d - 1) * (p - 1)) = -(β * s + α * (s - m)) - (m + 1) * α + α := by
          rw [hαdef]; ring
        rw [this]
        nlinarith
    · obtain ⟨A, hA, hb⟩ := exists_smoothed_interval_dyadic_bound_ge_two_sharp hd K hK hflat hN
        hp2
      refine ⟨A * (2 : ℝ≥0∞) ^ α, ENNReal.mul_ne_top hA (two_rpow_ne_top _), ?_⟩
      intro s m a b hm4 hms ha hab hb2 hlen h hh
      apply (hb s m a b (by omega) ha hab hb2 hlen h hh).trans
      apply mul_le_mul' _ le_rfl
      rw [mul_assoc A, two_rpow_add]
      gcongr
      · norm_num
      · have hms' : (m : ℝ) ≤ s := by exact_mod_cast hms
        have : -((s : ℝ) * (d - 1)) - (m : ℝ) * ((d - 1) * (p - 2)) =
            -(β * s + ((d : ℝ) - 1 - β) * (s - m)) - (m + 1) * α + α := by
          rw [hαdef]; ring
