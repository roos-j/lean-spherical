          htheta htheta_norm j s hs
  have hDcoeff : 2 * S ^ 2 + 2 * T ^ 2 ≤ C ^ 2 := by
    dsimp only [C]
    nlinarith [sq_nonneg (S - T), mul_nonneg hS hT]
  have hDbound (s : ℝ) (hs : s ∈ Icc (1 : ℝ) 2) :
      (∫ x, ‖D s x‖ ^ 2) ≤ C ^ 2 * E :=
    (hDrawbound s hs).trans (mul_le_mul_of_nonneg_right hDcoeff hE)
  have hFmem (s : ℝ) (hs : s ∈ Icc (1 : ℝ) 2) : MemLp (F s) 2 volume := by
    exact (memLp_two_iff_integrable_sq_norm (hFslice_cont s).aestronglyMeasurable).2
