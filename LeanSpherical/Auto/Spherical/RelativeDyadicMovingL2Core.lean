  have hDmem (s : ℝ) (hs : s ∈ Icc (1 : ℝ) 2) : MemLp (D s) 2 volume := by
    exact (memLp_two_iff_integrable_sq_norm (hDslice_cont s).aestronglyMeasurable).2
