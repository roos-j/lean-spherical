  have hS : 0 ≤ S := by
    dsimp only [S]
    exact div_nonneg (mul_nonneg (by norm_num) hC1.le)
      (Real.rpow_nonneg (dyadicScale_pos j).le _)
  have hT : 0 ≤ T := by
    dsimp only [T]
    exact div_nonneg
      (mul_nonneg (mul_nonneg (by norm_num) hC0.le) (norm_nonneg _))
      (Real.rpow_nonneg (dyadicScale_pos j).le _)
  have hC : 0 ≤ C := by
    dsimp only [C]
    positivity
  have hE : 0 ≤ E := by
    dsimp only [E]
    exact integral_nonneg fun _ => sq_nonneg _
  have hFslice_cont (s : ℝ) : Continuous (F s) := by
    change Continuous ((Function.uncurry F) ∘ fun x : Euclidean (d + 1) => (s, x))
    exact hFcont.comp
      ((continuous_const : Continuous fun _ : Euclidean (d + 1) => s).prodMk continuous_id)
  have hDslice_cont (s : ℝ) : Continuous (D s) := by
    change Continuous ((Function.uncurry D) ∘ fun x : Euclidean (d + 1) => (s, x))
