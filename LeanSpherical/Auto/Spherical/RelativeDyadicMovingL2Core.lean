        rw [Real.sqrt_mul (sq_nonneg B), Real.sqrt_sq_eq_abs, abs_of_nonneg hB]
  have hDsqrt (s : ℝ) (hs : s ∈ Icc (1 : ℝ) 2) :
      √(∫ x, ‖D s x‖ ^ 2) ≤ C * √E := by
    calc
      √(∫ x, ‖D s x‖ ^ 2) ≤ √(C ^ 2 * E) :=
        Real.sqrt_le_sqrt (hDbound s hs)
      _ = C * √E := by
        rw [Real.sqrt_mul (sq_nonneg C), Real.sqrt_sq_eq_abs, abs_of_nonneg hC]
  have hprod_bound (s : ℝ) (hs : s ∈ Icc (1 : ℝ) 2) :
      (∫ x, ‖F s x‖ * ‖D s x‖) ≤ B * C * E := by
    calc
