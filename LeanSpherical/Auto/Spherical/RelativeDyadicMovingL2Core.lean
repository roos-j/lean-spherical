  have hholder (s : ℝ) (hs : s ∈ Icc (1 : ℝ) 2) :
      (∫ x, ‖F s x‖ * ‖D s x‖) ≤
        √(∫ x, ‖F s x‖ ^ 2) * √(∫ x, ‖D s x‖ ^ 2) := by
    simpa [Real.sqrt_eq_rpow] using
