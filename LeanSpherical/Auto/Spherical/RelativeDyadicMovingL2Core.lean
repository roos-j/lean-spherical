    have hsne : s ≠ 0 := ne_of_gt (lt_of_lt_of_le zero_lt_one hs.1)
    simpa only [F] using
      integrable_norm_sq_fourierInv_relative_dyadic_surface_multiplier
        phi theta f htheta j s hsne
  have hDint (s : ℝ) (hs : s ∈ Icc (1 : ℝ) 2) :
