        constructor
        · calc
            1 = a⁻¹ * a := (inv_mul_cancel₀ ha.ne').symm
            _ ≤ a⁻¹ * r.1 := mul_le_mul_of_nonneg_left r.2.1 (inv_nonneg.mpr ha.le)
