        _ ≤ ⨆ r : Icc a (2 * a), ENNReal.ofReal ‖𝓕⁻ (fun xi : Euclidean (d + 1) =>
            surfaceFourier (d + 1) (-r.1 • xi) *
              (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
                phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) * g xi) x‖ :=
              le_iSup (fun t : Icc a (2 * a) =>
