                  surfaceFourier (d + 1) (-t.1 • xi) *
                    (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (t.1 • xi)) -
                    phi (((2 : ℝ) ^ j)⁻¹ • (t.1 • xi))) * g xi) x‖) r
  have hBM (x : Euclidean (d + 1)) : B x = q * M (a⁻¹ • x) := by
    dsimp only [B, M]
    rw [hblockENN, ENNReal.toReal_mul, ENNReal.toReal_ofReal hq]
  have hMint : Integrable (fun y : Euclidean (d + 1) => ‖M y‖ ^ 2) volume :=
    (memLp_two_iff_integrable_sq_norm hMlocal.1.aestronglyMeasurable).1 hMlocal.1
  have hcompint : Integrable (fun x : Euclidean (d + 1) => ‖M (a⁻¹ • x)‖ ^ 2) volume :=
    Integrable.comp_smul hMint (inv_ne_zero ha.ne')
  have hBsq : (fun x : Euclidean (d + 1) => ‖B x‖ ^ 2) =
      fun x => q ^ 2 * ‖M (a⁻¹ • x)‖ ^ 2 := by
    funext x
    rw [hBM, norm_mul, Real.norm_eq_abs, abs_of_nonneg hq]
    ring
  have hBint : Integrable (fun x : Euclidean (d + 1) => ‖B x‖ ^ 2) volume := by
    rw [hBsq]
    exact hcompint.const_mul (q ^ 2)
  have hBmeas_ae : AEStronglyMeasurable B volume := by
    have hMcomp : AEStronglyMeasurable (fun x : Euclidean (d + 1) =>
        M (a⁻¹ • x)) volume :=
      hMlocal.1.aestronglyMeasurable.comp_quasiMeasurePreserving
        (Measure.quasiMeasurePreserving_smul volume (inv_ne_zero ha.ne'))
    rw [show B = fun x : Euclidean (d + 1) => q * M (a⁻¹ • x) by
      funext x
      exact hBM x]
    exact hMcomp.const_mul q
  have hslice_cont (r : Icc a (2 * a)) :
      Continuous (fun x : Euclidean (d + 1) =>
        𝓕⁻ (fun xi : Euclidean (d + 1) =>
          surfaceFourier (d + 1) (-r.1 • xi) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) * g xi) x) := by
    have hrne : r.1 ≠ 0 := ne_of_gt (lt_of_lt_of_le ha r.2.1)
    rcases exists_compactlySupported_schwartzMap_relative_dyadic_bandpass_mul
        phi g hg j r.1 hrne with ⟨psi, hpsi, hpsi_compact⟩
    rcases exists_schwartz_compactSupport_mul_surfaceFourier psi hpsi_compact r.1 with
      ⟨m, hm⟩
    have hsymbol : (fun xi : Euclidean (d + 1) =>
        surfaceFourier (d + 1) (-r.1 • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) * g xi) = m := by
      funext xi
      rw [hm xi, hpsi xi]
      ring
    rw [hsymbol]
    simpa only [SchwartzMap.fourierInv_coe] using
      (𝓕⁻ m : SchwartzMap (Euclidean (d + 1)) ℂ).continuous
  have hBmeas : Measurable B := by
    dsimp only [B]
    apply ENNReal.measurable_toReal.comp
    apply LowerSemicontinuous.measurable
    apply lowerSemicontinuous_iSup
    intro r
    exact (ENNReal.continuous_ofReal.comp (hslice_cont r).norm).lowerSemicontinuous
  refine ⟨hBmeas,
    (memLp_two_iff_integrable_sq_norm hBmeas_ae).2 hBint, ?_⟩
  have hBint_eq : (∫ x : Euclidean (d + 1), ‖B x‖ ^ 2) =
      q * ∫ y : Euclidean (d + 1), ‖M y‖ ^ 2 := by
    rw [hBsq, integral_const_mul,
      integral_norm_sq_comp_smul_eq (d + 1) M (inv_pos.mpr ha)]
    dsimp only [q]
    field_simp [ha.ne']
  have hgaint : (∫ eta : Euclidean (d + 1), ‖ga eta‖ ^ 2) =
      q⁻¹ * ∫ xi : Euclidean (d + 1), ‖g xi‖ ^ 2 := by
    calc
      (∫ eta : Euclidean (d + 1), ‖ga eta‖ ^ 2) =
          ∫ eta : Euclidean (d + 1), ‖g (a⁻¹ • eta)‖ ^ 2 := by
            apply integral_congr_ae
            filter_upwards with eta
            rw [hga]
      _ = q⁻¹ * ∫ xi : Euclidean (d + 1), ‖g xi‖ ^ 2 := by
        simpa only [q] using
          integral_norm_sq_comp_smul_eq (d + 1) g (inv_pos.mpr ha)
  calc
    (∫ x : Euclidean (d + 1), ‖B x‖ ^ 2) =
        q * ∫ y : Euclidean (d + 1), ‖M y‖ ^ 2 := hBint_eq
    _ ≤ q *
        ((((4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)) ^ 2 +
          2 * ((4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)) *
            (2 * ((8 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1) +
              (12 * C0 *
                  ‖((SchwartzMap.fderivCLM ℂ
                    (Euclidean (d + 1)) ℂ) phi).toBoundedContinuousFunction‖) /
                (dyadicScale j) ^ ((d : ℝ) / 2)))) *
          (∫ eta : Euclidean (d + 1), ‖ga eta‖ ^ 2)) :=
      mul_le_mul_of_nonneg_left hMlocal.2 hq
    _ =
        (((4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)) ^ 2 +
          2 * ((4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)) *
            (2 * ((8 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1) +
              (12 * C0 *
                  ‖((SchwartzMap.fderivCLM ℂ
                    (Euclidean (d + 1)) ℂ) phi).toBoundedContinuousFunction‖) /
                (dyadicScale j) ^ ((d : ℝ) / 2)))) *
          (∫ xi : Euclidean (d + 1), ‖g xi‖ ^ 2) := by
      rw [hgaint]
      field_simp [hqpos.ne']

theorem finite_relative_dyadic_radius_blocks_l2
    {d : Nat} (hd : 1 ≤ d) (C0 C1 : ℝ) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ xi : Euclidean (d + 1), 1 ≤ ‖xi‖ →
      ‖surfaceFourier (d + 1) xi‖ ≤ C0 / ‖xi‖ ^ ((d : ℝ) / 2))
    (hderiv : ∀ xi : Euclidean (d + 1), ∀ r : ℝ, 1 ≤ ‖xi‖ →
      r ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun s : ℝ => surfaceFourier (d + 1) (s • xi)) r‖ ≤
        C1 / ‖xi‖ ^ ((d : ℝ) / 2 - 1))
    (phi f : SchwartzMap (Euclidean (d + 1)) ℂ)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1)
    (j : Nat) (K : Finset ℤ) (hK : K.Nonempty) :
    let u : ℤ → Euclidean (d + 1) → ℝ := fun k x =>
      (⨆ r : Icc ((2 : ℝ) ^ k) (2 * (2 : ℝ) ^ k), ENNReal.ofReal
        (‖(𝓕⁻ (fun xi : Euclidean (d + 1) =>
          surfaceFourier (d + 1) (-r.1 • xi) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
            ((phi (((2 : ℝ) ^ ((j : ℤ) + 3 - k))⁻¹ • xi) -
              phi (((2 : ℝ) ^ ((j : ℤ) - 2 - k))⁻¹ • xi)) *
              𝓕 (f : Euclidean (d + 1) → ℂ) xi)) x)‖)).toReal
    Measurable (fun x => K.sup' hK (fun k => u k x)) ∧
      MemLp (fun x => K.sup' hK (fun k => u k x)) 2 volume ∧
      (∫ x : Euclidean (d + 1), ‖K.sup' hK (fun k => u k x)‖ ^ 2) ≤
        24 *
          (((4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)) ^ 2 +
            2 * ((4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)) *
              (2 * ((8 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1) +
                (12 * C0 *
                    ‖((SchwartzMap.fderivCLM ℂ
                      (Euclidean (d + 1)) ℂ) phi).toBoundedContinuousFunction‖) /
                  (dyadicScale j) ^ ((d : ℝ) / 2)))) *
          (∫ x : Euclidean (d + 1), ‖f x‖ ^ 2) := by
  classical
  choose theta htheta htheta_compact using fun k : ℤ =>
    exists_compactlySupported_schwartzMap_scaled_sub phi hphi_zero
      ((2 : ℝ) ^ ((j : ℤ) + 3 - k))
      ((2 : ℝ) ^ ((j : ℤ) - 2 - k))
      (zpow_pos (by norm_num) _)
      (zpow_pos (by norm_num) _)
      ((zpow_right_strictMono₀ (by norm_num : (1 : ℝ) < 2)).monotone (by omega))
  let g : ℤ → SchwartzMap (Euclidean (d + 1)) ℂ := fun k =>
    SchwartzMap.smulLeftCLM ℂ (theta k : Euclidean (d + 1) → ℂ) (𝓕 f)
  have hg (k : ℤ) (xi : Euclidean (d + 1)) :
      g k xi =
        (phi (((2 : ℝ) ^ ((j : ℤ) + 3 - k))⁻¹ • xi) -
          phi (((2 : ℝ) ^ ((j : ℤ) - 2 - k))⁻¹ • xi)) *
          𝓕 (f : Euclidean (d + 1) → ℂ) xi := by
    simp only [g, SchwartzMap.smulLeftCLM_apply_apply (theta k).hasTemperateGrowth,
      smul_eq_mul, SchwartzMap.fourier_coe]
    rw [htheta k xi]
  have hg_compact (k : ℤ) : HasCompactSupport (g k : Euclidean (d + 1) → ℂ) := by
    have hgeq : (g k : Euclidean (d + 1) → ℂ) =
        fun xi => theta k xi * 𝓕 (f : Euclidean (d + 1) → ℂ) xi := by
      funext xi
      simp only [g, SchwartzMap.smulLeftCLM_apply_apply (theta k).hasTemperateGrowth,
        smul_eq_mul, SchwartzMap.fourier_coe]
    rw [hgeq]
    exact (htheta_compact k).mul_right
  let u : ℤ → Euclidean (d + 1) → ℝ := fun k x =>
    (⨆ r : Icc ((2 : ℝ) ^ k) (2 * (2 : ℝ) ^ k), ENNReal.ofReal
      ‖𝓕⁻ (fun xi : Euclidean (d + 1) =>
        surfaceFourier (d + 1) (-r.1 • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) * g k xi) x‖).toReal
  let L : ℝ :=
    (((4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)) ^ 2 +
      2 * ((4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)) *
        (2 * ((8 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1) +
          (12 * C0 *
            ‖((SchwartzMap.fderivCLM ℂ
              (Euclidean (d + 1)) ℂ) phi).toBoundedContinuousFunction‖) /
            (dyadicScale j) ^ ((d : ℝ) / 2))))
  have hL : 0 ≤ L := by
    dsimp only [L]
    have hA : 0 ≤ (4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2) := by
      exact div_nonneg (by positivity)
        (Real.rpow_pos_of_pos (dyadicScale_pos j) _).le
    have hB : 0 ≤ (8 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1) := by
      exact div_nonneg (by positivity)
        (Real.rpow_pos_of_pos (dyadicScale_pos j) _).le
    have hC : 0 ≤
        (12 * C0 *
          ‖((SchwartzMap.fderivCLM ℂ
            (Euclidean (d + 1)) ℂ) phi).toBoundedContinuousFunction‖) /
          (dyadicScale j) ^ ((d : ℝ) / 2) := by
      exact div_nonneg (by positivity)
        (Real.rpow_pos_of_pos (dyadicScale_pos j) _).le
    exact add_nonneg (sq_nonneg _)
      (mul_nonneg (mul_nonneg (by norm_num) hA)
        (mul_nonneg (by norm_num) (add_nonneg hB hC)))
  have hblock (k : ℤ) : Measurable (u k) ∧ MemLp (u k) 2 volume ∧
      (∫ x : Euclidean (d + 1), ‖u k x‖ ^ 2) ≤
        L * ∫ xi : Euclidean (d + 1), ‖g k xi‖ ^ 2 := by
    simpa only [u, L] using
      memLp_two_iSup_relative_dyadic_radius_block_compact_data
        hd C0 C1 hC0 hC1 hdecay hderiv phi (g k)
          hphi_one hphi_zero hphi_norm (hg_compact k) j ((2 : ℝ) ^ k)
          (zpow_pos (by norm_num) k)
  have hunonneg (k : ℤ) (x : Euclidean (d + 1)) : 0 ≤ u k x := by
    dsimp only [u]
    exact ENNReal.toReal_nonneg
  have huint (k : ℤ) : Integrable (fun x : Euclidean (d + 1) => (u k x) ^ 2) volume := by
    have h := (memLp_two_iff_integrable_sq_norm (hblock k).2.1.aestronglyMeasurable).1
      (hblock k).2.1
    convert h using 1
    funext x
    rw [Real.norm_of_nonneg (hunonneg k x)]
  have hfinite := integrable_sq_finset_sup_radius_blocks K hK u
    (fun k hk => (hblock k).1) (fun k hk => huint k)
  have hUmeas : Measurable (fun x : Euclidean (d + 1) =>
      K.sup' hK (fun k => u k x)) := by
    have hsup_apply : (K.sup' hK u : Euclidean (d + 1) → ℝ) =
        fun x => K.sup' hK (fun k => u k x) := by
      funext x
      exact Finset.sup'_apply hK u x
    rw [← hsup_apply]
    exact Finset.measurable_sup' hK (fun k hk => (hblock k).1)
  have hUnonneg (x : Euclidean (d + 1)) : 0 ≤ K.sup' hK (fun k => u k x) := by
    rcases K.exists_mem_eq_sup' hK (fun k => u k x) with ⟨k, hk, hsup⟩
    rw [hsup]
    exact hunonneg k x
  have hUintegrable : Integrable (fun x : Euclidean (d + 1) =>
      ‖K.sup' hK (fun k => u k x)‖ ^ 2) volume := by
    refine hfinite.1.congr ?_
    filter_upwards with x
    rw [Real.norm_of_nonneg (hUnonneg x)]
  have hUmem : MemLp (fun x : Euclidean (d + 1) =>
      K.sup' hK (fun k => u k x)) 2 volume :=
    (memLp_two_iff_integrable_sq_norm hUmeas.aestronglyMeasurable).2 hUintegrable
  let fhat : SchwartzMap (Euclidean (d + 1)) ℂ := 𝓕 f
  have hfhat (xi : Euclidean (d + 1)) :
      fhat xi = 𝓕 (f : Euclidean (d + 1) → ℂ) xi := by
    simp only [fhat, SchwartzMap.fourier_coe]
  have henergy (k : ℤ) : (∫ xi : Euclidean (d + 1), ‖g k xi‖ ^ 2) =
      ∫ x : Euclidean (d + 1),
        ‖𝓕⁻ (fun xi : Euclidean (d + 1) =>
          (phi (((2 : ℝ) ^ ((j : ℤ) + 3 - k))⁻¹ • xi) -
            phi (((2 : ℝ) ^ ((j : ℤ) - 2 - k))⁻¹ • xi)) *
          𝓕 (f : Euclidean (d + 1) → ℂ) xi) x‖ ^ 2 := by
    have hgtheta (xi : Euclidean (d + 1)) :
        g k xi = theta k xi * fhat xi := by
      rw [show g k xi = theta k xi * (𝓕 f) xi by
        simp only [g, SchwartzMap.smulLeftCLM_apply_apply (theta k).hasTemperateGrowth,
          smul_eq_mul]]
    have hproduct :
        (fun xi : Euclidean (d + 1) => theta k xi * fhat xi) =
          fun xi =>
            (phi (((2 : ℝ) ^ ((j : ℤ) + 3 - k))⁻¹ • xi) -
              phi (((2 : ℝ) ^ ((j : ℤ) - 2 - k))⁻¹ • xi)) *
              𝓕 (f : Euclidean (d + 1) → ℂ) xi := by
      funext xi
      rw [htheta k xi]
      rw [hfhat]
    calc
      (∫ xi : Euclidean (d + 1), ‖g k xi‖ ^ 2) =
          ∫ xi : Euclidean (d + 1), ‖theta k xi * fhat xi‖ ^ 2 := by
            apply integral_congr_ae
            filter_upwards with xi
            rw [hgtheta]
      _ = ∫ x : Euclidean (d + 1),
          ‖𝓕⁻ (fun xi : Euclidean (d + 1) => theta k xi * fhat xi) x‖ ^ 2 :=
        (integral_norm_sq_fourierInv_schwartz_multiplier_eq
          (E := Euclidean (d + 1)) (theta k) fhat).symm
      _ = _ := by rw [hproduct]
  have hsumenergy : (∑ k ∈ K, ∫ xi : Euclidean (d + 1), ‖g k xi‖ ^ 2) ≤
      24 * ∫ x : Euclidean (d + 1), ‖f x‖ ^ 2 := by
    calc
      (∑ k ∈ K, ∫ xi : Euclidean (d + 1), ‖g k xi‖ ^ 2) =
          ∑ k ∈ K, ∫ x : Euclidean (d + 1),
            ‖𝓕⁻ (fun xi : Euclidean (d + 1) =>
              (phi (((2 : ℝ) ^ ((j : ℤ) + 3 - k))⁻¹ • xi) -
                phi (((2 : ℝ) ^ ((j : ℤ) - 2 - k))⁻¹ • xi)) *
              𝓕 (f : Euclidean (d + 1) → ℂ) xi) x‖ ^ 2 := by
            apply Finset.sum_congr rfl
            intro k hk
            rw [henergy k]
      _ ≤ 24 * ∫ x : Euclidean (d + 1), ‖f x‖ ^ 2 :=
        finite_fat_relative_dyadic_cutoff_square_function_le
          phi hphi_one hphi_zero hphi_norm j K f
  have hUmem' : MemLp (fun x : Euclidean (d + 1) =>
      K.sup' hK (fun k =>
        (⨆ r : Icc ((2 : ℝ) ^ k) (2 * (2 : ℝ) ^ k), ENNReal.ofReal
          (‖(𝓕⁻ (fun xi : Euclidean (d + 1) =>
            surfaceFourier (d + 1) (-r.1 • xi) *
              (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
                phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
              ((phi (((2 : ℝ) ^ ((j : ℤ) + 3 - k))⁻¹ • xi) -
                phi (((2 : ℝ) ^ ((j : ℤ) - 2 - k))⁻¹ • xi)) *
                𝓕 (f : Euclidean (d + 1) → ℂ) xi)) x)‖)).toReal)) 2 volume := by
    simpa only [u, hg] using hUmem
  refine ⟨?_, hUmem', ?_⟩
  · simpa only [u, g, hg] using hUmeas
  have hbound :
      (∫ x : Euclidean (d + 1), ‖K.sup' hK (fun k => u k x)‖ ^ 2) ≤
        24 * L * ∫ x : Euclidean (d + 1), ‖f x‖ ^ 2 := by
    calc
      (∫ x : Euclidean (d + 1), ‖K.sup' hK (fun k => u k x)‖ ^ 2) =
          ∫ x : Euclidean (d + 1), (K.sup' hK (fun k => u k x)) ^ 2 := by
            apply integral_congr_ae
            filter_upwards with x
            rw [Real.norm_of_nonneg (hUnonneg x)]
      _ ≤ ∑ k ∈ K, ∫ x : Euclidean (d + 1), (u k x) ^ 2 := hfinite.2
      _ = ∑ k ∈ K, ∫ x : Euclidean (d + 1), ‖u k x‖ ^ 2 := by
        apply Finset.sum_congr rfl
        intro k hk
        apply integral_congr_ae
        filter_upwards with x
        rw [Real.norm_of_nonneg (hunonneg k x)]
      _ ≤ ∑ k ∈ K, L * ∫ xi : Euclidean (d + 1), ‖g k xi‖ ^ 2 := by
        apply Finset.sum_le_sum
        intro k hk
        exact (hblock k).2.2
      _ = L * (∑ k ∈ K, ∫ xi : Euclidean (d + 1), ‖g k xi‖ ^ 2) := by
        rw [Finset.mul_sum]
      _ ≤ L * (24 * ∫ x : Euclidean (d + 1), ‖f x‖ ^ 2) :=
        mul_le_mul_of_nonneg_left hsumenergy hL
      _ = 24 * L * ∫ x : Euclidean (d + 1), ‖f x‖ ^ 2 := by ring
  simpa only [u, hg, L] using hbound

end

