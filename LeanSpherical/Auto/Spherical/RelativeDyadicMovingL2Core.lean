/-- On the unit radius interval, the literal moving relative-bandpass family
obeys the product Sobolev `L²` maximal estimate. -/
theorem memLp_two_iSup_relative_dyadic_moving_bandpass_of_sharp
    {d : Nat} (hd : 1 ≤ d) (C0 C1 : ℝ) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ xi : Euclidean (d + 1), 1 ≤ ‖xi‖ →
      ‖surfaceFourier (d + 1) xi‖ ≤ C0 / ‖xi‖ ^ ((d : ℝ) / 2))
    (hderiv : ∀ xi : Euclidean (d + 1), ∀ r : ℝ, 1 ≤ ‖xi‖ →
      r ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun s : ℝ => surfaceFourier (d + 1) (s • xi)) r‖ ≤
        C1 / ‖xi‖ ^ ((d : ℝ) / 2 - 1))
    (phi theta f : SchwartzMap (Euclidean (d + 1)) ℂ)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1)
    (htheta : HasCompactSupport (theta : Euclidean (d + 1) → ℂ))
    (htheta_norm : ∀ xi, ‖theta xi‖ ≤ 2) (j : Nat) :
    let F : ℝ → Euclidean (d + 1) → ℂ := fun s x =>
      𝓕⁻ (fun xi : Euclidean (d + 1) =>
        surfaceFourier (d + 1) (-s • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) * theta xi *
          𝓕 (f : Euclidean (d + 1) → ℂ) xi) x
    MemLp (fun x : Euclidean (d + 1) =>
      (⨆ r : Icc (1 : ℝ) 2, ENNReal.ofReal ‖F r.1 x‖).toReal) 2 volume ∧
      (∫ x : Euclidean (d + 1),
        ‖(⨆ r : Icc (1 : ℝ) 2, ENNReal.ofReal ‖F r.1 x‖).toReal‖ ^ 2) ≤
        (((4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)) ^ 2 +
          2 * ((4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)) *
            (2 * ((8 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1) +
              (12 * C0 *
                  ‖((SchwartzMap.fderivCLM ℂ
                    (Euclidean (d + 1)) ℂ) phi).toBoundedContinuousFunction‖) /
                (dyadicScale j) ^ ((d : ℝ) / 2)))) *
          (∫ xi : Euclidean (d + 1), ‖𝓕 (f : Euclidean (d + 1) → ℂ) xi‖ ^ 2) := by
  let F : ℝ → Euclidean (d + 1) → ℂ := fun s x =>
    𝓕⁻ (fun xi : Euclidean (d + 1) =>
      surfaceFourier (d + 1) (-s • xi) *
        (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
          phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) * theta xi *
        𝓕 (f : Euclidean (d + 1) → ℂ) xi) x
  let D : ℝ → Euclidean (d + 1) → ℂ := fun s x =>
    𝓕⁻ (fun xi : Euclidean (d + 1) =>
      (deriv (fun u => surfaceFourier (d + 1) (-u • xi)) s *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) +
        surfaceFourier (d + 1) (-s • xi) *
          deriv (fun u =>
            phi (((2 : ℝ) ^ (j + 1))⁻¹ • (u • xi)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (u • xi))) s) * theta xi *
        𝓕 (f : Euclidean (d + 1) → ℂ) xi) x
  let B : ℝ := (4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)
  let S : ℝ := (8 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1)
  let T : ℝ := (12 * C0 *
    ‖((SchwartzMap.fderivCLM ℂ (Euclidean (d + 1)) ℂ) phi).toBoundedContinuousFunction‖) /
    (dyadicScale j) ^ ((d : ℝ) / 2)
  let C : ℝ := 2 * (S + T)
  let E : ℝ := ∫ xi : Euclidean (d + 1), ‖𝓕 (f : Euclidean (d + 1) → ℂ) xi‖ ^ 2
  have hjoint := continuous_and_hasDerivAt_fourierInv_relative_dyadic_bandpass
    phi theta f htheta j
  dsimp only at hjoint
  have hFcont : Continuous (Function.uncurry F) := by
    simpa only [F] using hjoint.1
  have hDcont : Continuous (Function.uncurry D) := by
    simpa only [D] using hjoint.2.1
  have hderivAt : ∀ s x, HasDerivAt (fun t => F t x) (D s x) s := by
    simpa only [F, D] using hjoint.2.2
  have hB : 0 ≤ B := by
    dsimp only [B]
