/-!
# Dyadic entropy exponents

The dimension quantities in Fraccaroli--Roos--Seeger are logarithmic growth
rates of local covering numbers as the scale tends to zero.  At the dyadic
scale `2^{-j}`, the denominator `log (delta^{-1})` is `j * log 2`.  We retain
extended-real values here: this makes the definitions total before finiteness
of the entropy profiles has been established.

The usual continuous-scale definitions are recovered from these dyadic ones
after the standard covering-number discretization lemma.  That lemma is kept
separate because it is an analytic fact about the chosen interval convention,
not a definitional change of the exponent.
-/
open Filter Set
open scoped ENNReal NNReal Topology

noncomputable section

/-- The logarithmic quotient occurring in the continuous-scale definitions
of the dimension exponents.  We retain an `EReal` value so that the formula
is total before local entropy finiteness is proved. -/
def entropyLogQuotient (N : ℝ≥0∞) (δ : ℝ≥0) : EReal :=
  ENNReal.log N / (Real.log ((δ : ℝ)⁻¹) : EReal)

/-- The entropy profile in the continuous definition of the
Legendre--Assouad function. -/
def multiplicativeLegendreAssouadProfile (E : Set ℝ) (rho : ℝ)
    (δ : ℝ≥0) : ℝ≥0∞ :=
  ⨆ c : PositiveRadius, ⨆ diam : Set.Icc δ 1,
    ((diam.1 : ℝ≥0) : ℝ≥0∞) ^ (-rho) *
      localMultiplicativeEntropy E c diam.1 δ

/-- Enlarging the radius set can only enlarge every finite-scale
Legendre--Assouad entropy profile. -/
theorem multiplicativeLegendreAssouadProfile_mono {E F : Set ℝ} (hEF : E ⊆ F)
    (rho : ℝ) (δ : ℝ≥0) :
    multiplicativeLegendreAssouadProfile E rho δ ≤
      multiplicativeLegendreAssouadProfile F rho δ := by
  apply iSup_mono
  intro c
  apply iSup_mono
  intro diam
  gcongr
  exact localMultiplicativeEntropy_mono hEF c diam.1 δ

/-- The upper Minkowski exponent `β` in the paper's original
continuous-scale convention. -/
def multiplicativeMinkowskiExponent (E : Set ℝ) : EReal :=
  Filter.limsup
    (fun δ : ℝ≥0 => entropyLogQuotient (unitMultiplicativeEntropy E δ) δ)
    (𝓝[>] (0 : ℝ≥0))

/-- The Legendre--Assouad exponent `ν♯` in the paper's original
continuous-scale convention. -/
def multiplicativeLegendreAssouadExponent (E : Set ℝ) (rho : ℝ) : EReal :=
  Filter.limsup
    (fun δ : ℝ≥0 =>
      entropyLogQuotient (multiplicativeLegendreAssouadProfile E rho δ) δ)
    (𝓝[>] (0 : ℝ≥0))

/-- The multiplicative diameter `2^{-j}`. -/
def dyadicMultiplicativeScale (j : ℕ) : ℝ≥0 :=
  (2 : ℝ≥0)⁻¹ ^ j

@[simp] theorem dyadicMultiplicativeScale_zero :
    dyadicMultiplicativeScale 0 = 1 := by
  simp [dyadicMultiplicativeScale]

theorem dyadicMultiplicativeScale_pos (j : ℕ) :
    0 < dyadicMultiplicativeScale j := by
  exact pow_pos (by norm_num) _

/-- The unit-window entropy at scale `2^{-j}`. -/
def dyadicUnitMultiplicativeEntropy (E : Set ℝ) (j : ℕ) : ℝ≥0∞ :=
  unitMultiplicativeEntropy E (dyadicMultiplicativeScale j)

theorem dyadicUnitMultiplicativeEntropy_mono {E F : Set ℝ} (hEF : E ⊆ F)
    (j : ℕ) :
    dyadicUnitMultiplicativeEntropy E j ≤
      dyadicUnitMultiplicativeEntropy F j := by
  change (unitMultiplicativeEntropy E (dyadicMultiplicativeScale j) : ℝ≥0∞) ≤
    (unitMultiplicativeEntropy F (dyadicMultiplicativeScale j) : ℝ≥0∞)
  exact_mod_cast unitMultiplicativeEntropy_mono hEF (dyadicMultiplicativeScale j)

/-- The dyadic form of the upper Minkowski exponent `beta`.

`ExpGrowth.expGrowthSup` is `limsup_j log(u_j) / j`; division by `log 2`
therefore gives exactly `limsup_j log(u_j) / log((2^{-j})^{-1})`. -/
def dyadicMinkowskiExponent (E : Set ℝ) : EReal :=
  ExpGrowth.expGrowthSup (dyadicUnitMultiplicativeEntropy E) / (Real.log 2)

/-- At scale `2^{-j}`, the entropy profile appearing in the definition of the
Legendre--Assouad function.  The subtype for `diam` is the exact condition
`2^{-j} ≤ |J|_times ≤ 1` from the paper. -/
def dyadicLegendreAssouadProfile (E : Set ℝ) (rho : ℝ) (j : ℕ) : ℝ≥0∞ :=
  ⨆ c : PositiveRadius, ⨆ diam : Set.Icc (dyadicMultiplicativeScale j) 1,
    ((diam.1 : ℝ≥0) : ℝ≥0∞) ^ (-rho) *
      localMultiplicativeEntropy E c diam.1 (dyadicMultiplicativeScale j)

theorem dyadicLegendreAssouadProfile_mono {E F : Set ℝ} (hEF : E ⊆ F)
    (rho : ℝ) (j : ℕ) :
    dyadicLegendreAssouadProfile E rho j ≤
      dyadicLegendreAssouadProfile F rho j := by
  apply iSup_mono
  intro c
  apply iSup_mono
  intro diam
  gcongr
  exact localMultiplicativeEntropy_mono hEF c diam.1 (dyadicMultiplicativeScale j)

/-- The dyadic form of the Legendre--Assouad function `nu^sharp`. -/
def dyadicLegendreAssouadExponent (E : Set ℝ) (rho : ℝ) : EReal :=
  ExpGrowth.expGrowthSup (dyadicLegendreAssouadProfile E rho) / (Real.log 2)

end
