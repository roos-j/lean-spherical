/-!
# Logarithmic radius geometry for power-weighted spherical maximal operators

The dilation geometry in Fraccaroli--Roos--Seeger is the ordinary Euclidean
geometry after applying `logb 2` to the positive radii.  This file keeps that
identification explicit.  In particular, `multiplicativeEntropy E δ` is the
least number of logarithmic intervals of diameter `δ` needed to cover `E`.
-/
open Set
open scoped ENNReal NNReal

noncomputable section

/-- Positive radii, regarded as a type. -/
abbrev PositiveRadius := Ioi (0 : ℝ)

/-- The base-two logarithmic coordinate on the positive radii. -/
def logRadius (r : PositiveRadius) : ℝ := Real.log r.1 / Real.log 2

/-- The image of a set of radii in logarithmic coordinates. -/
def logRadiusSet (E : Set ℝ) : Set ℝ :=
  {u | ∃ r : PositiveRadius, (r : ℝ) ∈ E ∧ logRadius r = u}

/-- A multiplicative interval, represented as a closed interval in logarithmic
coordinates.  Its multiplicative diameter is `diam`. -/
def multiplicativeInterval (c : PositiveRadius) (diam : ℝ≥0) : Set ℝ :=
  {r | 0 < r ∧ |(Real.log r / Real.log 2) - logRadius c| ≤ (diam : ℝ) / 2}

/-- The entropy of `E` at multiplicative diameter `δ`.

`Metric.externalCoveringNumber` uses closed balls, hence its radius is `δ / 2`.
This is exactly the interval-diameter convention used in the paper. -/
def multiplicativeEntropy (E : Set ℝ) (δ : ℝ≥0) : ℕ∞ :=
  Metric.externalCoveringNumber (δ / 2) (logRadiusSet E)

/-- Entropy localized to a multiplicative interval. -/
def localMultiplicativeEntropy (E : Set ℝ) (c : PositiveRadius)
    (diam δ : ℝ≥0) : ℕ∞ :=
  multiplicativeEntropy (E ∩ multiplicativeInterval c diam) δ

/-- The supremal entropy over multiplicative intervals of diameter one. -/
def unitMultiplicativeEntropy (E : Set ℝ) (δ : ℝ≥0) : ℕ∞ :=
  ⨆ c : PositiveRadius, localMultiplicativeEntropy E c 1 δ

theorem logRadiusSet_mono {E F : Set ℝ} (hEF : E ⊆ F) :
    logRadiusSet E ⊆ logRadiusSet F := by
  rintro u ⟨r, hrE, hru⟩
  exact ⟨r, hEF hrE, hru⟩

theorem multiplicativeEntropy_mono {E F : Set ℝ} (hEF : E ⊆ F) (δ : ℝ≥0) :
    multiplicativeEntropy E δ ≤ multiplicativeEntropy F δ := by
  exact Metric.externalCoveringNumber_mono_set (logRadiusSet_mono hEF)

theorem logRadiusSet_empty : logRadiusSet (∅ : Set ℝ) = ∅ := by
  ext u
  simp [logRadiusSet]

@[simp]
theorem multiplicativeEntropy_empty (δ : ℝ≥0) :
    multiplicativeEntropy (∅ : Set ℝ) δ = 0 := by
  simp [multiplicativeEntropy, logRadiusSet_empty]

theorem localMultiplicativeEntropy_mono {E F : Set ℝ} (hEF : E ⊆ F)
    (c : PositiveRadius) (diam δ : ℝ≥0) :
    localMultiplicativeEntropy E c diam δ ≤
      localMultiplicativeEntropy F c diam δ := by
  apply multiplicativeEntropy_mono
  exact inter_subset_inter_left _ hEF

theorem unitMultiplicativeEntropy_mono {E F : Set ℝ} (hEF : E ⊆ F)
    (δ : ℝ≥0) :
    unitMultiplicativeEntropy E δ ≤ unitMultiplicativeEntropy F δ := by
  apply iSup_mono
  intro c
  exact localMultiplicativeEntropy_mono hEF c 1 δ

end
end Consolidated_Definitions

