open Auto.FractalDimensions







/-!
# Finite entropy covers of the radius set

The entropy in the power-weight theorem is defined by the external covering
number of the logarithmic radius set.  This file extracts an actual finite
family of centres from a finite entropy bound.  The second form converts the
logarithmic cover to physical radius intervals, which is the input required
by the finite-radius variation estimate.
-/
open Set
open scoped ENNReal NNReal

noncomputable section

/-- A finite bound for the multiplicative entropy gives a finite logarithmic
cover with no more centres than the stated bound. -/
theorem exists_finset_logRadius_cover_of_multiplicativeEntropy_le
    (E : Set ℝ) (δ : ℝ≥0) (N : ℕ)
    (hN : multiplicativeEntropy E δ ≤ N) :
    ∃ C : Finset ℝ, C.card ≤ N ∧
      ∀ r : PositiveRadius, (r : ℝ) ∈ E → ∃ c ∈ C,
        |logRadius r - c| ≤ (δ : ℝ) / 2 := by
  classical
  let A : Set ℝ := logRadiusSet E
  let ε : ℝ≥0 := δ / 2
  have hN' : Metric.externalCoveringNumber ε A ≤ (N : ℕ∞) := by
    simpa only [A, ε, multiplicativeEntropy] using hN
  let I := {C : Set ℝ // Metric.IsCover ε A C}
  have hI : Nonempty I := by
    refine ⟨Set.univ, ?_⟩
    intro x hx
    exact ⟨x, Set.mem_univ _, by simp⟩
  letI : Nonempty I := hI
  obtain ⟨C, hC⟩ := ENat.exists_eq_iInf (fun C : I => (C : Set ℝ).encard)
  have hCeq : (C : Set ℝ).encard = Metric.externalCoveringNumber ε A := by
    calc
      (C : Set ℝ).encard = ⨅ x : I, (x : Set ℝ).encard := hC
      _ = ⨅ C : Set ℝ, ⨅ _ : Metric.IsCover ε A C, C.encard := iInf_subtype
      _ = Metric.externalCoveringNumber ε A := rfl
  have hCcard : (C : Set ℝ).encard ≤ (N : ℕ∞) := hCeq.le.trans hN'
  have hCfinite : (C : Set ℝ).Finite := by
    apply Set.encard_ne_top_iff.mp
    apply ne_top_of_le_ne_top (by simp) hCcard
  let D : Finset ℝ := hCfinite.toFinset
  have hDco : (D : Set ℝ) = (C : Set ℝ) := hCfinite.coe_toFinset
  have hDcard : D.card ≤ N := by
    apply ENat.coe_le_coe.mp
    rw [← hCfinite.encard_eq_coe_toFinset_card]
    exact hCcard
  refine ⟨D, hDcard, ?_⟩
  intro r hr
  have hrA : logRadius r ∈ A := ⟨r, hr, rfl⟩
  obtain ⟨c, hcC, hdist⟩ := C.2 hrA
  refine ⟨c, ?_, ?_⟩
  · change c ∈ (D : Set ℝ)
    rw [hDco]
    exact hcC
  · change edist (logRadius r) c ≤ ε at hdist
    rw [edist_dist] at hdist
    simpa [Real.dist_eq, ε, NNReal.coe_div] using
      (ENNReal.ofReal_le_coe.mp hdist)

/-- Base-two exponentiation inverts `logRadius` on positive radii. -/
theorem two_rpow_logRadius (r : PositiveRadius) :
    (2 : ℝ) ^ logRadius r = (r : ℝ) := by
  rw [logRadius, Real.rpow_def_of_pos (by norm_num)]
  rw [mul_div_cancel₀ _ (ne_of_gt (Real.log_pos (by norm_num : (1 : ℝ) < 2)))]
  exact Real.exp_log r.2

/-- A finite entropy bound supplies physical intervals which cover every
positive radius in `E`; their endpoints are the inverse logarithmic images
of the covering cells. -/
theorem exists_finset_physical_radius_cover_of_multiplicativeEntropy_le
    (E : Set ℝ) (δ : ℝ≥0) (N : ℕ)
