  have hleftS : (α : EReal) + multiplicativeMinkowskiExponent E < (s : EReal) :=
    (le_max_left _ _).trans_lt ((le_max_left _ _).trans_lt hs)
  have hsposE : (0 : EReal) < (s : EReal) :=
    (le_max_right _ _).trans_lt hs
