    g u * Complex.exp (((theta + epsilon * lambda * u ^ 2 : Real) : Complex) * Complex.I) =
        g u * (Complex.exp (((theta : Real) : Complex) * Complex.I) *
          Complex.exp (((epsilon * lambda * u ^ 2 : Real) : Complex) * Complex.I)) := by
            rw [← Complex.exp_add]
            congr 1
            push_cast
            ring
