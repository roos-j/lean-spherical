  transportedAmplitude_vanishesNearOne : VanishesNearOne transportedAmplitude
  transport : ∀ lambda : Real,
    normalizedStationaryOscillatoryIntegral a phase left right criticalValue lambda =
      quadraticNormalFormOscillatoryIntegral transportedAmplitude 0 orientation lambda

/-- A one-dimensional smooth inverse-function theorem in the form used by
the local Morse reduction.  It keeps the local inverse explicit: the inverse
is smooth at the image point and is a right inverse on a neighborhood there. -/
theorem localInverse_of_contDiffAt_of_hasDerivAt_ne
    {f : Real → Real} {x f' : Real}
    (hf : ContDiffAt Real (⊤ : ℕ∞) f x)
    (hfd : HasDerivAt f f' x) (hf'_ne : f' ≠ 0) :
    ∃ g : Real → Real,
      g (f x) = x ∧
        ContDiffAt Real (⊤ : ℕ∞) g (f x) ∧
          ∀ᶠ y in nhds (f x), f (g y) = y := by
  let e : Real ≃L[Real] Real :=
    (ContinuousLinearEquiv.unitsEquivAut Real) (Units.mk0 f' hf'_ne)
  have hfd' : HasFDerivAt f (e : Real →L[Real] Real) x :=
    hfd.hasFDerivAt_equiv hf'_ne
  let g : Real → Real := hf.localInverse hfd' (by simp)
  refine ⟨g, ?_, ?_, ?_⟩
  · exact hf.localInverse_apply_image hfd' (by simp)
  · exact hf.to_localInverse hfd' (by simp)
  · exact (hf.hasStrictFDerivAt' hfd' (by simp)).eventually_right_inverse

/-- A local signed quadratic coordinate for a phase.  This is the exact
input needed by the inverse-function part of the one-dimensional Morse
reduction; producing `coordinate` from bare second-derivative data is the
separate smooth factorization obligation. -/
structure HasLocalQuadraticMorseCoordinate
    (phase : Real → Real) (criticalPoint orientation : Real) where
  coordinate : Real → Real
  coordinate_smooth : ContDiffAt Real (⊤ : ℕ∞) coordinate criticalPoint
  coordinate_zero : coordinate criticalPoint = 0
  coordinate_deriv_ne : deriv coordinate criticalPoint ≠ 0
  phase_eq : phase =ᶠ[nhds criticalPoint]
    fun x => phase criticalPoint + orientation * (coordinate x) ^ 2

/-- A smooth local inverse of a signed quadratic Morse coordinate. -/
structure HasLocalQuadraticMorseInverse
    (phase : Real → Real) (criticalPoint orientation : Real) where
  inverse : Real → Real
  inverse_zero : inverse 0 = criticalPoint
  inverse_smooth : ContDiffAt Real (⊤ : ℕ∞) inverse 0
  phase_eq : (fun u => phase (inverse u)) =ᶠ[nhds 0]
    fun u => phase criticalPoint + orientation * u ^ 2

/-- Mathlib's smooth inverse-function theorem turns a signed local quadratic
coordinate into a smooth local inverse branch. -/
def HasLocalQuadraticMorseCoordinate.toHasLocalQuadraticMorseInverse
    {phase : Real → Real} {criticalPoint orientation : Real}
    (h : HasLocalQuadraticMorseCoordinate phase criticalPoint orientation) :
    HasLocalQuadraticMorseInverse phase criticalPoint orientation := by
  have hderiv : HasDerivAt h.coordinate (deriv h.coordinate criticalPoint) criticalPoint :=
    (h.coordinate_smooth.differentiableAt (by simp)).hasDerivAt
  let hlocal := localInverse_of_contDiffAt_of_hasDerivAt_ne h.coordinate_smooth hderiv
    h.coordinate_deriv_ne
  let inverse : Real → Real := Classical.choose hlocal
  have hinverse_image : inverse (h.coordinate criticalPoint) = criticalPoint :=
    (Classical.choose_spec hlocal).1
  have hinverse_smooth : ContDiffAt Real (⊤ : ℕ∞) inverse (h.coordinate criticalPoint) :=
    (Classical.choose_spec hlocal).2.1
  have hinverse_right : ∀ᶠ u in nhds (h.coordinate criticalPoint),
      h.coordinate (inverse u) = u := (Classical.choose_spec hlocal).2.2
  have hinverse_zero : inverse 0 = criticalPoint := by
    simpa only [h.coordinate_zero] using hinverse_image
  have hinverse_smooth_zero : ContDiffAt Real (⊤ : ℕ∞) inverse 0 := by
    simpa only [h.coordinate_zero] using hinverse_smooth
  refine {
    inverse := inverse
    inverse_zero := hinverse_zero
    inverse_smooth := hinverse_smooth_zero
    phase_eq := ?_ }
  have hinverse_tendsto : Tendsto inverse (nhds 0) (nhds criticalPoint) := by
    have htendsto := hinverse_smooth_zero.continuousAt.tendsto
    rwa [hinverse_zero] at htendsto
  have hcoordinate_inverse : ∀ᶠ u in nhds 0, h.coordinate (inverse u) = u := by
    simpa only [h.coordinate_zero] using hinverse_right
  filter_upwards [hinverse_tendsto.eventually h.phase_eq, hcoordinate_inverse] with
      u huPhase huCoordinate
  rw [huPhase, huCoordinate]

/-- The phase rescaling that turns a radius-`radius` quadratic coordinate
into the unit quadratic normal form. -/
def quadraticMorsePhaseRescale
    (phase : Real → Real) (criticalPoint radius : Real) : Real → Real :=
  fun x => phase criticalPoint + (phase x - phase criticalPoint) / radius ^ 2

theorem contDiff_quadraticMorsePhaseRescale
    {phase : Real → Real} {criticalPoint radius : Real}
    (hphase : ContDiff Real (⊤ : ℕ∞) phase) :
    ContDiff Real (⊤ : ℕ∞)
      (quadraticMorsePhaseRescale phase criticalPoint radius) := by
  unfold quadraticMorsePhaseRescale
  fun_prop

/-- A local Morse inverse really does furnish a positive coordinate radius on
which its quadratic phase identity is valid.  This remains a local statement:
it says nothing about global branch extensions or reaching unit coordinate
radius. -/
theorem HasLocalQuadraticMorseInverse.exists_pos_radius_phase_eq
    {phase : Real → Real} {criticalPoint orientation : Real}
    (h : HasLocalQuadraticMorseInverse phase criticalPoint orientation) :
    ∃ radius : Real, 0 < radius ∧ ∀ u : Real, |u| ≤ radius →
      phase (h.inverse u) = phase criticalPoint + orientation * u ^ 2 := by
  rcases (Metric.mem_nhds_iff.mp h.phase_eq) with ⟨R, hR, hball⟩
  refine ⟨R / 2, half_pos hR, ?_⟩
  intro u hu
  apply hball
  rw [Metric.mem_ball, Real.dist_eq]
  exact lt_of_le_of_lt (by simpa using hu) (half_lt_self hR)

/-- The canonical twice-divided difference for the one-dimensional Hadamard
factorization at a critical point.  The exact algebraic factorization below
does not by itself assert smoothness of this extension at the base point. -/
def quadraticHadamardFactor (phase : Real → Real) (criticalPoint : Real) : Real → Real :=
  dslope (dslope (fun x => phase x - phase criticalPoint) criticalPoint) criticalPoint

/-- The canonical twice-divided-difference factor gives the exact quadratic
factorization of any phase critical at the base point. -/
theorem phase_sub_eq_sq_mul_quadraticHadamardFactor
    {phase : Real → Real} {criticalPoint : Real}
    (hcritical : deriv phase criticalPoint = 0) (x : Real) :
    phase x - phase criticalPoint = (x - criticalPoint) ^ 2 *
      quadraticHadamardFactor phase criticalPoint x := by
  let g : Real → Real := fun y => phase y - phase criticalPoint
  have hderiv_g : deriv g criticalPoint = 0 := by
    simp only [g, deriv_sub_const]
    exact hcritical
  have hfirst : (x - criticalPoint) * dslope g criticalPoint x =
      phase x - phase criticalPoint := by
    simpa [g] using sub_smul_dslope g criticalPoint x
  have hsecond : (x - criticalPoint) * quadraticHadamardFactor phase criticalPoint x =
      dslope g criticalPoint x := by
    have h := sub_smul_dslope (dslope g criticalPoint) criticalPoint x
    rw [dslope_same, hderiv_g] at h
    simpa only [quadraticHadamardFactor, sub_zero, smul_eq_mul] using h
  calc
    phase x - phase criticalPoint = (x - criticalPoint) * dslope g criticalPoint x := hfirst.symm
    _ = (x - criticalPoint) * ((x - criticalPoint) *
        quadraticHadamardFactor phase criticalPoint x) := by rw [hsecond]
    _ = (x - criticalPoint) ^ 2 * quadraticHadamardFactor phase criticalPoint x := by ring

/-- A compact affine average with a polynomial parameter weight.  Its
successive parameter moments encode the derivatives of the Taylor remainder
factor below. -/
def affineMomentAverage (order : Nat) (g : Real → Real)
    (criticalPoint x : Real) : Real :=
  ∫ t in (0 : Real)..1,
    (1 - t) * t ^ order * g (criticalPoint + t * (x - criticalPoint))

/-- A continuous integrand on the compact parameter interval gives a
continuous affine moment average. -/
theorem continuous_affineMomentAverage
    {g : Real → Real} {criticalPoint : Real} {order : Nat}
    (hg : Continuous g) :
    Continuous (affineMomentAverage order g criticalPoint) := by
  let F : Real → Real → Real := fun x t =>
    (1 - t) * t ^ order * g (criticalPoint + t * (x - criticalPoint))
  have hF : Continuous F.uncurry := by
    dsimp [F]
    fun_prop
  have hI : Continuous (fun x => ∫ t in Icc (0 : Real) 1, F x t) :=
    continuous_parametric_integral_of_continuous hF isCompact_Icc
  have hrewrite : affineMomentAverage order g criticalPoint =
      fun x => ∫ t in Icc (0 : Real) 1, F x t := by
    funext x
    unfold affineMomentAverage
    rw [intervalIntegral.integral_of_le (by norm_num),
      ← MeasureTheory.integral_Icc_eq_integral_Ioc]
  rw [hrewrite]
  exact hI

private theorem hasDerivAt_affineMomentIntegrand
    {g : Real → Real} {criticalPoint x t : Real} {order : Nat}
    (hg : ContDiff Real (1 : ℕ∞) g) :
    HasDerivAt
      (fun y => (1 - t) * t ^ order * g
        (criticalPoint + t * (y - criticalPoint)))
      ((1 - t) * t ^ order *
        (deriv g (criticalPoint + t * (x - criticalPoint)) * t)) x := by
  have hg' : HasDerivAt g (deriv g (criticalPoint + t * (x - criticalPoint)))
      (criticalPoint + t * (x - criticalPoint)) :=
    (hg.differentiable (by norm_num) _).hasDerivAt
  have harg : HasDerivAt (fun y => criticalPoint + t * (y - criticalPoint)) t x := by
    have hbase := (hasDerivAt_const x (criticalPoint - t * criticalPoint)).add
      (hasDerivAt_const_mul (x := x) t)
    simpa only [zero_add] using hbase.congr_of_eventuallyEq (by
      filter_upwards with y
      simp only [Pi.add_apply]
      ring)
  have hmain := (hg'.comp x harg).const_mul ((1 - t) * t ^ order)
  simpa only [Function.comp_apply] using hmain

/-- Differentiation in the affine variable increments the parameter moment
and differentiates the input function.  The proof uses a compact local bound
on the differentiated integrand and Mathlib's dominated differentiation API. -/
theorem hasDerivAt_affineMomentAverage
    {g : Real → Real} {criticalPoint x : Real} {order : Nat}
    (hg : ContDiff Real (1 : ℕ∞) g) :
    HasDerivAt (affineMomentAverage order g criticalPoint)
      (affineMomentAverage (order + 1) (deriv g) criticalPoint x) x := by
  let F : Real → Real → Real := fun y t =>
    (1 - t) * t ^ order * g (criticalPoint + t * (y - criticalPoint))
  let F' : Real → Real → Real := fun y t =>
    (1 - t) * t ^ order *
      (deriv g (criticalPoint + t * (y - criticalPoint)) * t)
  have hderivCont : Continuous (deriv g) := hg.continuous_deriv_one
  have hFcont (y : Real) : Continuous (F y) := by
    dsimp [F]
    fun_prop
  have hF'cont (y : Real) : Continuous (F' y) := by
    dsimp [F']
    fun_prop
  have hF'joint : Continuous (fun p : Real × Real => F' p.1 p.2) := by
    dsimp [F']
    fun_prop
  obtain ⟨M, hM⟩ := IsCompact.exists_bound_of_continuousOn
    ((isCompact_closedBall x 1).prod (isCompact_Icc : IsCompact (Icc (0 : Real) 1)))
    hF'joint.continuousOn
  have hFmeas : ∀ᶠ y in nhds x,
      AEStronglyMeasurable (F y) (volume.restrict (uIoc (0 : Real) 1)) := by
    filter_upwards with y
    exact (hFcont y).aestronglyMeasurable
  have hbound : ∀ᵐ t ∂volume, t ∈ uIoc (0 : Real) 1 →
      ∀ y ∈ Metric.closedBall x 1, ‖F' y t‖ ≤ max M 0 := by
    filter_upwards with t ht y hy
    have ht' : t ∈ Icc (0 : Real) 1 := by
      simpa [uIcc_of_le (by norm_num : (0 : Real) ≤ 1)] using uIoc_subset_uIcc ht
    exact (hM (y, t) ⟨hy, ht'⟩).trans (le_max_left _ _)
  have hderiv := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (F := F) (F' := F') (x₀ := x) (s := Metric.closedBall x 1)
    (bound := fun _ : Real => max M 0)
    (Metric.closedBall_mem_nhds x zero_lt_one)
    hFmeas
    ((hFcont x).intervalIntegrable 0 1)
    (hF'cont x).aestronglyMeasurable
    hbound
    ((continuous_const : Continuous (fun _ : Real => max M 0)).intervalIntegrable 0 1)
    (by
      filter_upwards with t ht y hy
      simpa only [F, F'] using hasDerivAt_affineMomentIntegrand hg)
  have hfactor : (∫ t in (0 : Real)..1, F' x t) =
      affineMomentAverage (order + 1) (deriv g) criticalPoint x := by
    unfold affineMomentAverage F'
    apply intervalIntegral.integral_congr
    intro t _
    change (1 - t) * t ^ order *
        (deriv g (criticalPoint + t * (x - criticalPoint)) * t) =
      (1 - t) * t ^ (order + 1) *
        deriv g (criticalPoint + t * (x - criticalPoint))
    rw [pow_succ]
    ring
  rw [hfactor] at hderiv
  simpa only [affineMomentAverage, F] using! hderiv.2

/-- The pointwise derivative form of `hasDerivAt_affineMomentAverage`. -/
theorem deriv_affineMomentAverage
    {g : Real → Real} {criticalPoint : Real} {order : Nat}
    (hg : ContDiff Real (1 : ℕ∞) g) :
    deriv (affineMomentAverage order g criticalPoint) =
      affineMomentAverage (order + 1) (deriv g) criticalPoint := by
  funext x
  exact (hasDerivAt_affineMomentAverage hg).deriv

/-- Every finite differentiability order is preserved by the compact affine
moment operator. -/
theorem contDiff_affineMomentAverage
    (order n : Nat) {g : Real → Real} {criticalPoint : Real}
    (hg : ContDiff Real (n : ℕ∞) g) :
    ContDiff Real (n : ℕ∞) (affineMomentAverage order g criticalPoint) := by
  induction n generalizing order g with
  | zero =>
      exact (contDiff_zero (𝕜 := Real)).mpr
        (continuous_affineMomentAverage ((contDiff_zero (𝕜 := Real)).mp hg))
  | succ n ih =>
      have hg' : ContDiff Real ((n : ℕ∞) + 1) g := by
        convert hg using 1 <;> norm_num
      have hgOne : ContDiff Real (1 : ℕ∞) g := hg'.of_le (by simp)
      change ContDiff Real ((n : ℕ∞) + 1)
        (affineMomentAverage order g criticalPoint)
      refine (contDiff_succ_iff_deriv (𝕜 := Real)).2 ⟨?_, ?_, ?_⟩
      · intro x
        exact (hasDerivAt_affineMomentAverage hgOne).differentiableAt
      · intro htop
        simp at htop
      · rw [deriv_affineMomentAverage hgOne]
        exact ih (order + 1) (contDiff_succ_iff_deriv (𝕜 := Real) |>.mp hg').2.2

/-- A smooth input remains smooth after taking any compact affine moment. -/
theorem contDiff_infty_affineMomentAverage
    {g : Real → Real} {criticalPoint : Real} {order : Nat}
    (hg : ContDiff Real (⊤ : ℕ∞) g) :
    ContDiff Real (⊤ : ℕ∞) (affineMomentAverage order g criticalPoint) := by
  rw [contDiff_infty]
  intro n
  have hgn : ContDiff Real (n : ℕ∞) g := hg.of_le
    (WithTop.coe_le_coe.mpr (show (n : ℕ∞) ≤ (⊤ : ℕ∞) from le_top))
  exact contDiff_affineMomentAverage order n hgn

/-- The explicit integral Taylor remainder factor at a one-dimensional base
point.  Unlike the raw divided-difference factor, this has a usable smoothness
theorem below. -/
def quadraticTaylorFactor (phase : Real → Real) (criticalPoint : Real) (x : Real) : Real :=
  ∫ t in (0 : Real)..1,
    (1 - t) * deriv (deriv phase) (criticalPoint + t * (x - criticalPoint))

private theorem iteratedFDeriv_one_const
    (f : Real → Real) (z v : Real) :
    iteratedFDeriv Real 1 f z (fun _ => v) = v * deriv f z := by
  rw [iteratedFDeriv_one_apply]
  have hv : v = v • (1 : Real) := by simp
  rw [hv, (fderiv Real f z).map_smul, fderiv_apply_one_eq_deriv]
  simp only [smul_eq_mul, mul_one]

private theorem iteratedFDeriv_two_const
    (f : Real → Real) (z v : Real) :
    iteratedFDeriv Real 2 f z (fun _ => v) = v ^ 2 *
      iteratedFDeriv Real 2 f z (fun _ => (1 : Real)) := by
  let D := iteratedFDeriv Real 2 f z
  change D (fun _ => v) = v ^ 2 * D (fun _ => (1 : Real))
  have hv : (fun _ : Fin 2 => v) = fun _ => v • (1 : Real) := by
    funext i
    simp
  rw [hv, D.map_smul_univ]
  simp only [Fin.prod_univ_two, smul_eq_mul]
  ring

private theorem iteratedFDeriv_two_one_eq_deriv_deriv
    {f : Real → Real} {z : Real} (h : ContDiff Real (2 : ℕ∞) f) :
    iteratedFDeriv Real 2 f z (fun _ => (1 : Real)) = deriv (deriv f) z := by
  have hkey := (h.contDiffAt).deriv_fderiv_add_smul
    (n := 1) (x := z) (t := 0) (y := (1 : Real))
  norm_num at hkey
  rw [deriv_comp_const_add] at hkey
  simpa using hkey.symm

private def quadraticTaylorFDerivFactor (phase : Real → Real)
    (criticalPoint x : Real) : Real :=
  ∫ t in (0 : Real)..1, (1 - t) *
    iteratedFDeriv Real 2 phase (criticalPoint + t * (x - criticalPoint))
      (fun _ => (1 : Real))

private theorem phase_sub_eq_sq_mul_quadraticTaylorFDerivFactor
    {phase : Real → Real} {criticalPoint x : Real}
    (hphase : ContDiff Real (2 : ℕ∞) phase)
    (hcritical : deriv phase criticalPoint = 0) :
    phase x - phase criticalPoint = (x - criticalPoint) ^ 2 *
      quadraticTaylorFDerivFactor phase criticalPoint x := by
  have hTaylor := map_add_eq_sum_add_integral_iteratedFDeriv
    (f := phase) (x := criticalPoint) (y := x - criticalPoint) (n := 1)
    (fun t _ => (hphase.contDiffAt).of_le (by norm_num))
  norm_num at hTaylor
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, zero_add,
    iteratedFDeriv_zero_apply, Nat.factorial_zero, Nat.factorial_one,
    Nat.cast_one, inv_one, iteratedFDeriv_one_const] at hTaylor
  simp only [Nat.reduceAdd] at hTaylor
  have hTaylorIntegrand : (∫ t in (0 : Real)..1,
      (1 - t) * (iteratedFDeriv Real 2 phase
        (criticalPoint + t * (x - criticalPoint))) (fun _ => x - criticalPoint)) =
      ∫ t in (0 : Real)..1,
        (1 - t) * ((x - criticalPoint) ^ 2 *
          (iteratedFDeriv Real 2 phase
            (criticalPoint + t * (x - criticalPoint))) (fun _ => (1 : Real))) := by
    apply intervalIntegral.integral_congr
    intro t _
    change (1 - t) * (iteratedFDeriv Real 2 phase
      (criticalPoint + t * (x - criticalPoint)) (fun _ : Fin 2 => x - criticalPoint)) =
      (1 - t) * ((x - criticalPoint) ^ 2 *
        (iteratedFDeriv Real 2 phase
          (criticalPoint + t * (x - criticalPoint)) (fun _ : Fin 2 => (1 : Real))))
    rw [iteratedFDeriv_two_const]
  rw [hTaylorIntegrand] at hTaylor
  have hInt : (∫ t in (0 : Real)..1,
      (1 - t) * ((x - criticalPoint) ^ 2 *
        iteratedFDeriv Real 2 phase (criticalPoint + t * (x - criticalPoint))
          (fun _ => (1 : Real)))) =
      (x - criticalPoint) ^ 2 * quadraticTaylorFDerivFactor phase criticalPoint x := by
    unfold quadraticTaylorFDerivFactor
    have hreorder :
      (fun t : Real => (1 - t) * ((x - criticalPoint) ^ 2 *
        (iteratedFDeriv Real 2 phase
          (criticalPoint + t * (x - criticalPoint))) (fun _ : Fin 2 => (1 : Real)))) =
      (fun t : Real => (x - criticalPoint) ^ 2 * ((1 - t) *
        (iteratedFDeriv Real 2 phase
          (criticalPoint + t * (x - criticalPoint))) (fun _ : Fin 2 => (1 : Real)))) := by
      funext t
      ring
    rw [hreorder, intervalIntegral.integral_const_mul]
  rw [hInt, hcritical] at hTaylor
  norm_num at hTaylor
  linarith

private theorem quadraticTaylorFDerivFactor_eq_quadraticTaylorFactor
    {phase : Real → Real} {criticalPoint x : Real}
    (hphase : ContDiff Real (2 : ℕ∞) phase) :
    quadraticTaylorFDerivFactor phase criticalPoint x =
      quadraticTaylorFactor phase criticalPoint x := by
  unfold quadraticTaylorFDerivFactor quadraticTaylorFactor
  apply intervalIntegral.integral_congr
  intro t _
  change (1 - t) *
      iteratedFDeriv Real 2 phase (criticalPoint + t * (x - criticalPoint))
        (fun _ => (1 : Real)) =
    (1 - t) * deriv (deriv phase) (criticalPoint + t * (x - criticalPoint))
  rw [iteratedFDeriv_two_one_eq_deriv_deriv hphase]

/-- Taylor's integral remainder yields the exact quadratic factorization at a
critical point. -/
theorem phase_sub_eq_sq_mul_quadraticTaylorFactor
    {phase : Real → Real} {criticalPoint x : Real}
    (hphase : ContDiff Real (2 : ℕ∞) phase)
    (hcritical : deriv phase criticalPoint = 0) :
    phase x - phase criticalPoint = (x - criticalPoint) ^ 2 *
      quadraticTaylorFactor phase criticalPoint x := by
  rw [← quadraticTaylorFDerivFactor_eq_quadraticTaylorFactor hphase]
  exact phase_sub_eq_sq_mul_quadraticTaylorFDerivFactor hphase hcritical

/-- The Taylor factor is the zeroth affine moment of the second derivative. -/
theorem quadraticTaylorFactor_eq_affineMomentAverage
    (phase : Real → Real) (criticalPoint : Real) :
    quadraticTaylorFactor phase criticalPoint =
      affineMomentAverage 0 (deriv (deriv phase)) criticalPoint := by
  funext x
  unfold quadraticTaylorFactor affineMomentAverage
  apply intervalIntegral.integral_congr
  intro t _
  simp only [pow_zero]
  ring

/-- The explicit Taylor factor is smooth whenever the phase is smooth. -/
theorem contDiff_infty_quadraticTaylorFactor
    {phase : Real → Real} {criticalPoint : Real}
    (hphase : ContDiff Real (⊤ : ℕ∞) phase) :
    ContDiff Real (⊤ : ℕ∞) (quadraticTaylorFactor phase criticalPoint) := by
  have hphase' : ContDiff Real (⊤ : ℕ∞) (deriv phase) :=
    (contDiff_infty_iff_deriv.mp hphase).2
  have hphase'' : ContDiff Real (⊤ : ℕ∞) (deriv (deriv phase)) :=
    (contDiff_infty_iff_deriv.mp hphase').2
  rw [quadraticTaylorFactor_eq_affineMomentAverage]
  exact contDiff_infty_affineMomentAverage hphase''

private theorem intervalIntegral_integral_one_sub (a b : Real) :
    (∫ t in a..b, (1 - t : Real)) =
      (b - b ^ 2 / 2) - (a - a ^ 2 / 2) := by
  have hp : ∀ t : Real, HasDerivAt (fun t : Real => t - t ^ 2 / 2) (1 - t) t := by
    intro t
    convert! (hasDerivAt_id' t).sub (((hasDerivAt_id' t).pow 2).div_const 2) using 1 <;> ring
  exact intervalIntegral.integral_eq_sub_of_hasDerivAt
    (fun t _ => hp t)
    ((by fun_prop : Continuous (fun t : Real => 1 - t)).intervalIntegrable a b)

/-- The integral Taylor factor takes the expected half-second-derivative
value at its base point. -/
theorem quadraticTaylorFactor_at_criticalPoint
    (phase : Real → Real) (criticalPoint : Real) :
    quadraticTaylorFactor phase criticalPoint criticalPoint =
      deriv (deriv phase) criticalPoint / 2 := by
  have hbase : (∫ t in (0 : Real)..1, (1 - t : Real)) = 1 / 2 := by
    rw [intervalIntegral_integral_one_sub]
    norm_num
  unfold quadraticTaylorFactor
  have hrewrite : (fun t : Real => (1 - t) * deriv (deriv phase)
      (criticalPoint + t * (criticalPoint - criticalPoint))) =
      fun t => deriv (deriv phase) criticalPoint * (1 - t) := by
    funext t
    ring
  rw [hrewrite, intervalIntegral.integral_const_mul, hbase]
  ring

/-- A smooth signed quadratic factor with positive value at the base point
produces a local one-dimensional Morse coordinate.  This is explicitly local:
it makes no claim about extending the coordinate to two interval endpoints. -/
def HasLocalQuadraticMorseCoordinate.ofSmoothFactor
    {phase q : Real → Real} {criticalPoint orientation : Real}
    (horientation : orientation = 1 ∨ orientation = -1)
    (hq_smooth : ContDiff Real (⊤ : ℕ∞) q)
    (hfactor : ∀ x : Real,
      phase x - phase criticalPoint = (x - criticalPoint) ^ 2 * q x)
    (hpositive : 0 < orientation * q criticalPoint) :
    HasLocalQuadraticMorseCoordinate phase criticalPoint orientation := by
  let signedFactor : Real → Real := fun x => orientation * q x
  let coordinate : Real → Real := fun x => (x - criticalPoint) * Real.sqrt (signedFactor x)
  have hsigned_smooth : ContDiff Real (⊤ : ℕ∞) signedFactor := by
    dsimp [signedFactor]
    fun_prop
  have hsigned_ne : signedFactor criticalPoint ≠ 0 := by
    exact ne_of_gt hpositive
  have hroot_smooth : ContDiffAt Real (⊤ : ℕ∞)
      (fun x => Real.sqrt (signedFactor x)) criticalPoint :=
    hsigned_smooth.contDiffAt.sqrt hsigned_ne
  have hcoordinate_smooth : ContDiffAt Real (⊤ : ℕ∞) coordinate criticalPoint := by
    dsimp [coordinate]
    fun_prop
  have hsigned_positive : ∀ᶠ x in nhds criticalPoint, 0 < signedFactor x := by
    exact hsigned_smooth.continuous.continuousAt.tendsto.eventually
      (eventually_gt_nhds hpositive)
  have hcoordinate_zero : coordinate criticalPoint = 0 := by
    simp only [coordinate, sub_self, zero_mul]
  have hroot_pos : 0 < Real.sqrt (signedFactor criticalPoint) :=
    Real.sqrt_pos.2 hpositive
  have hcoordinate_deriv : deriv coordinate criticalPoint =
      Real.sqrt (signedFactor criticalPoint) := by
    have hlinear : HasDerivAt (fun x : Real => x - criticalPoint) 1 criticalPoint := by
      simpa using (hasDerivAt_id' criticalPoint).sub_const criticalPoint
    have hroot_deriv : HasDerivAt (fun x => Real.sqrt (signedFactor x))
        (deriv (fun x => Real.sqrt (signedFactor x)) criticalPoint) criticalPoint :=
      (hroot_smooth.differentiableAt (by simp)).hasDerivAt
    have hproduct := hlinear.mul hroot_deriv
    simpa only [coordinate, Pi.mul_apply, sub_self, one_mul, zero_mul, add_zero] using!
      hproduct.deriv
  refine {
    coordinate := coordinate
    coordinate_smooth := hcoordinate_smooth
    coordinate_zero := hcoordinate_zero
    coordinate_deriv_ne := by rw [hcoordinate_deriv]; exact hroot_pos.ne'
    phase_eq := ?_ }
  filter_upwards [hsigned_positive] with x hx
  rw [show phase x = phase criticalPoint + (x - criticalPoint) ^ 2 * q x by
    linarith [hfactor x]]
  have hsqrt : (Real.sqrt (signedFactor x)) ^ 2 = signedFactor x :=
    Real.sq_sqrt hx.le
  dsimp [coordinate, signedFactor]
  rcases horientation with h | h
  · subst orientation
    dsimp [signedFactor] at hsqrt
    rw [mul_pow, hsqrt]
    ring
  · subst orientation
    dsimp [signedFactor] at hsqrt
    rw [mul_pow, hsqrt]
    ring

/-- A bare smooth nondegenerate critical point produces the local signed
quadratic coordinate required by the inverse-function part of the Morse
reduction.  It deliberately stops before any global two-branch extension. -/
def HasLocalQuadraticMorseCoordinate.ofNondegenerate
    {phase : Real → Real} {criticalPoint : Real}
    (hphase : ContDiff Real (⊤ : ℕ∞) phase)
    (hcritical : deriv phase criticalPoint = 0)
    (hsecond_ne : deriv (deriv phase) criticalPoint ≠ 0) :
    HasLocalQuadraticMorseCoordinate phase criticalPoint
      (if 0 < deriv (deriv phase) criticalPoint then 1 else -1) := by
  let q : Real → Real := quadraticTaylorFactor phase criticalPoint
  let orientation : Real := if 0 < deriv (deriv phase) criticalPoint then 1 else -1
  have horientation : orientation = 1 ∨ orientation = -1 := by
    dsimp [orientation]
    split_ifs <;> simp
  have hq_smooth : ContDiff Real (⊤ : ℕ∞) q := by
    dsimp [q]
    exact contDiff_infty_quadraticTaylorFactor hphase
  have hfactor : ∀ x : Real,
      phase x - phase criticalPoint = (x - criticalPoint) ^ 2 * q x := by
    intro x
    dsimp [q]
    exact phase_sub_eq_sq_mul_quadraticTaylorFactor
      (hphase.of_le (WithTop.coe_le_coe.mpr
        (show (2 : ℕ∞) ≤ (⊤ : ℕ∞) by norm_num))) hcritical
  have hq_at : q criticalPoint = deriv (deriv phase) criticalPoint / 2 := by
    dsimp [q]
    exact quadraticTaylorFactor_at_criticalPoint phase criticalPoint
  have hpositive : 0 < orientation * q criticalPoint := by
    dsimp [orientation]
    split_ifs with hpositive
    · rw [hq_at]
      exact mul_pos one_pos (div_pos hpositive (by norm_num))
    · have hnonpos : deriv (deriv phase) criticalPoint ≤ 0 := le_of_not_gt hpositive
      have hnegative : deriv (deriv phase) criticalPoint < 0 :=
        lt_of_le_of_ne hnonpos hsecond_ne
      rw [hq_at]
      have hquotient : deriv (deriv phase) criticalPoint / 2 < 0 :=
        div_neg_of_neg_of_pos hnegative (by norm_num)
      nlinarith
  exact HasLocalQuadraticMorseCoordinate.ofSmoothFactor horientation hq_smooth hfactor hpositive

/-- Combining the proved smooth Taylor factorization with the local inverse
theorem gives a positive coordinate radius for every bare smooth
nondegenerate critical point.  No global chart is asserted. -/
theorem exists_pos_radius_phase_eq_ofNondegenerate
    {phase : Real → Real} {criticalPoint : Real}
    (hphase : ContDiff Real (⊤ : ℕ∞) phase)
    (hcritical : deriv phase criticalPoint = 0)
    (hsecond_ne : deriv (deriv phase) criticalPoint ≠ 0) :
    ∃ radius : Real, 0 < radius ∧ ∀ u : Real, |u| ≤ radius →
      phase
          ((HasLocalQuadraticMorseCoordinate.toHasLocalQuadraticMorseInverse
            (HasLocalQuadraticMorseCoordinate.ofNondegenerate hphase hcritical hsecond_ne)).inverse u) =
        phase criticalPoint +
          (if 0 < deriv (deriv phase) criticalPoint then 1 else -1) * u ^ 2 := by
  exact HasLocalQuadraticMorseInverse.exists_pos_radius_phase_eq
    (HasLocalQuadraticMorseCoordinate.toHasLocalQuadraticMorseInverse
      (HasLocalQuadraticMorseCoordinate.ofNondegenerate hphase hcritical hsecond_ne))

/-- Two smooth inverse branches of a local one-dimensional quadratic Morse
coordinate, parametrized by the nonnegative coordinate `u ∈ [0,1]`.

The structure records the actual smooth branch data rather than merely an
oscillatory-integral identity.  Constructing these branches from the bare
critical-point hypotheses is the remaining local Morse-lemma obligation. -/
structure HasTwoBranchQuadraticMorseChart
    (phase : Real → Real) (left right : Real) where
  criticalPoint : Real
  left_le_critical : left ≤ criticalPoint
  critical_le_right : criticalPoint ≤ right
  critical_deriv_zero : deriv phase criticalPoint = 0
  critical_second_deriv_ne : deriv (deriv phase) criticalPoint ≠ 0
  orientation : Real
  orientation_eq : orientation = 1 ∨ orientation = -1
  leftInverse : Real → Real
  rightInverse : Real → Real
  leftInverse_smooth : ContDiff Real (⊤ : ℕ∞) leftInverse
  rightInverse_smooth : ContDiff Real (⊤ : ℕ∞) rightInverse
  leftInverse_zero : leftInverse 0 = criticalPoint
  leftInverse_one : leftInverse 1 = left
  rightInverse_zero : rightInverse 0 = criticalPoint
  rightInverse_one : rightInverse 1 = right
  left_phase : ∀ u ∈ Icc (0 : Real) 1,
    phase (leftInverse u) = phase criticalPoint + orientation * u ^ 2
  right_phase : ∀ u ∈ Icc (0 : Real) 1,
    phase (rightInverse u) = phase criticalPoint + orientation * u ^ 2

/-- A quadratic normal form whose local coordinate has radius `radius`.

The transported quadratic model is evaluated at `radius^2 * lambda`; this is
the exact scale forced by a coordinate range smaller than the artificial unit
endpoint.  Unlike `HasQuadraticNormalForm`, this interface does not pretend
that a merely local chart reaches coordinate value one for the original phase.
-/
structure HasRadiusScaledQuadraticNormalForm
    (a : Real → Complex) (phase : Real → Real) (left right : Real) where
  criticalValue : Real
  radius : Real
  radius_pos : 0 < radius
  orientation : Real
  orientation_eq : orientation = 1 ∨ orientation = -1
  transportedAmplitude : Real → Complex
  transportedAmplitude_smooth : ContDiff Real (⊤ : ℕ∞) transportedAmplitude
  transportedAmplitude_vanishesNearOne : VanishesNearOne transportedAmplitude
  transport : ∀ lambda : Real,
    normalizedStationaryOscillatoryIntegral a phase left right criticalValue lambda =
      quadraticNormalFormOscillatoryIntegral transportedAmplitude 0 orientation
        (radius ^ 2 * lambda)

/-- An explicit smooth two-branch chart on a coordinate interval of radius
`radius`.  Its branch extensions are deliberately part of the data: a local
inverse from the inverse-function theorem only has pointwise `∞` regularity
in the current API, not a certified global smooth extension. -/
structure HasRadiusScaledQuadraticMorseChart
    (phase : Real → Real) (left right : Real) where
  criticalPoint : Real
  radius : Real
  radius_pos : 0 < radius
  left_le_critical : left ≤ criticalPoint
  critical_le_right : criticalPoint ≤ right
  /-- These two fields make the rescaled phase compatible with the existing
  unit-chart interface.  They are kept explicit rather than inferred from a
  bare local inverse. -/
  rescaled_critical_deriv_zero :
    deriv (quadraticMorsePhaseRescale phase criticalPoint radius) criticalPoint = 0
  rescaled_critical_second_deriv_ne :
    deriv (deriv (quadraticMorsePhaseRescale phase criticalPoint radius)) criticalPoint ≠ 0
  orientation : Real
  orientation_eq : orientation = 1 ∨ orientation = -1
  leftInverse : Real → Real
  rightInverse : Real → Real
  leftInverse_smooth : ContDiff Real (⊤ : ℕ∞) leftInverse
  rightInverse_smooth : ContDiff Real (⊤ : ℕ∞) rightInverse
  leftInverse_zero : leftInverse 0 = criticalPoint
  leftInverse_one : leftInverse 1 = left
  rightInverse_zero : rightInverse 0 = criticalPoint
  rightInverse_one : rightInverse 1 = right
  left_phase : ∀ u ∈ Icc (0 : Real) 1,
    phase (leftInverse u) = phase criticalPoint + orientation * (radius * u) ^ 2
  right_phase : ∀ u ∈ Icc (0 : Real) 1,
    phase (rightInverse u) = phase criticalPoint + orientation * (radius * u) ^ 2

/-- A radius-scaled chart becomes an ordinary unit chart after dividing the
phase variation by `radius^2`. -/
def HasRadiusScaledQuadraticMorseChart.toUnitChart
    {phase : Real → Real} {left right : Real}
    (h : HasRadiusScaledQuadraticMorseChart phase left right) :
    HasTwoBranchQuadraticMorseChart
      (quadraticMorsePhaseRescale phase h.criticalPoint h.radius) left right := by
  refine {
    criticalPoint := h.criticalPoint
    left_le_critical := h.left_le_critical
    critical_le_right := h.critical_le_right
    critical_deriv_zero := h.rescaled_critical_deriv_zero
    critical_second_deriv_ne := h.rescaled_critical_second_deriv_ne
    orientation := h.orientation
    orientation_eq := h.orientation_eq
    leftInverse := h.leftInverse
    rightInverse := h.rightInverse
    leftInverse_smooth := h.leftInverse_smooth
    rightInverse_smooth := h.rightInverse_smooth
    leftInverse_zero := h.leftInverse_zero
    leftInverse_one := h.leftInverse_one
    rightInverse_zero := h.rightInverse_zero
    rightInverse_one := h.rightInverse_one
    left_phase := ?_
    right_phase := ?_ }
  · intro u hu
    unfold quadraticMorsePhaseRescale
    rw [h.left_phase u hu]
    field_simp [ne_of_gt h.radius_pos]
    ring
  · intro u hu
    unfold quadraticMorsePhaseRescale
    rw [h.right_phase u hu]
    field_simp [ne_of_gt h.radius_pos]
    ring

/-- The sum of the two Jacobian-weighted pullbacks through the inverse Morse
branches. -/
def twoBranchQuadraticTransportedAmplitude
    (a : Real → Complex) (leftInverse rightInverse : Real → Real) (u : Real) : Complex :=
  a (rightInverse u) * ((deriv rightInverse u : Real) : Complex) -
    a (leftInverse u) * ((deriv leftInverse u : Real) : Complex)

private theorem contDiff_real_to_complex_morse
    (f : Real → Real) (hf : ContDiff Real (⊤ : ℕ∞) f) :
    ContDiff Real (⊤ : ℕ∞) (fun x : Real => (f x : Complex)) := by
  change ContDiff Real (⊤ : ℕ∞) (Complex.ofRealCLM ∘ f)
  exact Complex.ofRealCLM.contDiff.comp hf

/-- The two-branch pullback amplitude is smooth whenever the original
amplitude and both inverse branches are smooth. -/
theorem contDiff_twoBranchQuadraticTransportedAmplitude
    {a : Real → Complex} {leftInverse rightInverse : Real → Real}
    (ha : ContDiff Real (⊤ : ℕ∞) a)
    (hleft : ContDiff Real (⊤ : ℕ∞) leftInverse)
    (hright : ContDiff Real (⊤ : ℕ∞) rightInverse) :
    ContDiff Real (⊤ : ℕ∞)
      (twoBranchQuadraticTransportedAmplitude a leftInverse rightInverse) := by
  have hleftDerivC := contDiff_real_to_complex_morse (deriv leftInverse)
    ((contDiff_infty_iff_deriv.mp hleft).2)
  have hrightDerivC := contDiff_real_to_complex_morse (deriv rightInverse)
    ((contDiff_infty_iff_deriv.mp hright).2)
  exact (ha.comp hright).mul hrightDerivC |>.sub ((ha.comp hleft).mul hleftDerivC)

/-- If the original amplitude vanishes near both chart endpoints, the
two-branch transported amplitude has the endpoint vanishing required by the
quadratic stationary estimate. -/
theorem twoBranchQuadraticTransportedAmplitude_vanishesNearOne
    {a : Real → Complex} {left right : Real} {leftInverse rightInverse : Real → Real}
    (ha_left : a =ᶠ[nhds left] 0) (ha_right : a =ᶠ[nhds right] 0)
    (hleft : Continuous leftInverse) (hright : Continuous rightInverse)
    (hleft_one : leftInverse 1 = left) (hright_one : rightInverse 1 = right) :
    VanishesNearOne (twoBranchQuadraticTransportedAmplitude a leftInverse rightInverse) := by
  have hleftAt : ContinuousAt leftInverse (1 : Real) := hleft.continuousAt
  have hrightAt : ContinuousAt rightInverse (1 : Real) := hright.continuousAt
  have hleftTendsto : Tendsto leftInverse (nhds (1 : Real)) (nhds left) := by
    simpa only [hleft_one] using hleftAt.tendsto
  have hrightTendsto : Tendsto rightInverse (nhds (1 : Real)) (nhds right) := by
    simpa only [hright_one] using hrightAt.tendsto
  have hleftZero : (fun u : Real => a (leftInverse u)) =ᶠ[nhds 1] 0 :=
    hleftTendsto.eventually ha_left
  have hrightZero : (fun u : Real => a (rightInverse u)) =ᶠ[nhds 1] 0 :=
    hrightTendsto.eventually ha_right
  filter_upwards [hleftZero, hrightZero] with u huLeft huRight
  simp [twoBranchQuadraticTransportedAmplitude, huLeft, huRight]

private def twoBranchQuadraticLeftAmplitude
    (a : Real → Complex) (leftInverse : Real → Real) (u : Real) : Complex :=
  -(a (leftInverse u) * ((deriv leftInverse u : Real) : Complex))

private def twoBranchQuadraticRightAmplitude
    (a : Real → Complex) (rightInverse : Real → Real) (u : Real) : Complex :=
  a (rightInverse u) * ((deriv rightInverse u : Real) : Complex)

/-- The decreasing inverse branch supplies the left half of the normalized
quadratic normal form by the proved interval-integral substitution theorem. -/
private theorem HasTwoBranchQuadraticMorseChart.left_branch_transport
    {a : Real → Complex} {phase : Real → Real} {left right : Real}
    (hchart : HasTwoBranchQuadraticMorseChart phase left right)
    (ha : Continuous a) (hphase : Continuous phase) (lambda : Real) :
    normalizedStationaryOscillatoryIntegral a phase left hchart.criticalPoint
        (phase hchart.criticalPoint) lambda =
      quadraticNormalFormOscillatoryIntegral
        (twoBranchQuadraticLeftAmplitude a hchart.leftInverse)
        0 hchart.orientation lambda := by
  let G : Real → Complex := fun s =>
    a s * Complex.exp (((lambda * phase s : Real) : Complex) * Complex.I)
  have hGcont : Continuous G := by
    dsimp [G]
    fun_prop
  have hleftDeriv : ∀ u ∈ uIcc (0 : Real) 1,
      HasDerivAt hchart.leftInverse (deriv hchart.leftInverse u) u := by
    intro u hu
    exact ((hchart.leftInverse_smooth.differentiable (by simp) u).hasDerivAt)
  have hleftDerivCont : ContinuousOn (deriv hchart.leftInverse) (uIcc (0 : Real) 1) :=
    ((contDiff_infty_iff_deriv.mp hchart.leftInverse_smooth).2).continuous.continuousOn
  have hsubst := intervalIntegral.integral_deriv_smul_comp
    (a := (0 : Real)) (b := (1 : Real)) (f := hchart.leftInverse)
    (f' := deriv hchart.leftInverse) (g := G) hleftDeriv hleftDerivCont hGcont
  rw [hchart.leftInverse_zero, hchart.leftInverse_one] at hsubst
  change Complex.exp (((-(lambda * phase hchart.criticalPoint) : Real) : Complex) * Complex.I) *
      (∫ s in left..hchart.criticalPoint, G s) =
    ∫ u in (0 : Real)..1,
      twoBranchQuadraticLeftAmplitude a hchart.leftInverse u *
        Complex.exp (((0 + hchart.orientation * lambda * u ^ 2 : Real) : Complex) * Complex.I)
  calc
    Complex.exp (((-(lambda * phase hchart.criticalPoint) : Real) : Complex) * Complex.I) *
        (∫ s in left..hchart.criticalPoint, G s) =
      - (Complex.exp (((-(lambda * phase hchart.criticalPoint) : Real) : Complex) * Complex.I) *
        ∫ s in hchart.criticalPoint..left, G s) := by
          rw [intervalIntegral.integral_symm]
          ring
    _ = - (Complex.exp (((-(lambda * phase hchart.criticalPoint) : Real) : Complex) * Complex.I) *
        ∫ u in (0 : Real)..1,
          deriv hchart.leftInverse u • (G ∘ hchart.leftInverse) u) := by
          rw [hsubst]
    _ = ∫ u in (0 : Real)..1,
        -(Complex.exp (((-(lambda * phase hchart.criticalPoint) : Real) : Complex) * Complex.I) *
          (deriv hchart.leftInverse u • (G ∘ hchart.leftInverse) u)) := by
          rw [← intervalIntegral.integral_const_mul, ← intervalIntegral.integral_neg]
    _ = ∫ u in (0 : Real)..1,
        twoBranchQuadraticLeftAmplitude a hchart.leftInverse u *
          Complex.exp (((0 + hchart.orientation * lambda * u ^ 2 : Real) : Complex) * Complex.I) := by
          apply intervalIntegral.integral_congr
          intro u hu
          have hexp :
              Complex.exp (((-(lambda * phase hchart.criticalPoint) : Real) : Complex) * Complex.I) *
                Complex.exp (((lambda *
                  (phase hchart.criticalPoint + hchart.orientation * u ^ 2) : Real) : Complex) *
                    Complex.I) =
                  Complex.exp (((hchart.orientation * lambda * u ^ 2 : Real) : Complex) *
                    Complex.I) := by
              rw [← Complex.exp_add]
              congr 1
              push_cast
              ring
          dsimp [G, Function.comp_apply, twoBranchQuadraticLeftAmplitude]
          have hu' : u ∈ Icc (0 : Real) 1 := by
            have hu'' := hu
            rw [uIcc_of_le (by norm_num : (0 : Real) ≤ 1)] at hu''
            exact hu''
          rw [hchart.left_phase u hu']
          simp only [zero_add]
          calc
            _ =
              -(a (hchart.leftInverse u) * ((deriv hchart.leftInverse u : Real) : Complex)) *
                (Complex.exp (((-(lambda * phase hchart.criticalPoint) : Real) : Complex) * Complex.I) *
                  Complex.exp (((lambda *
                    (phase hchart.criticalPoint + hchart.orientation * u ^ 2) : Real) : Complex) *
                      Complex.I)) := by ring
            _ = _ := by rw [hexp]

/-- The increasing inverse branch supplies the right half of the normalized
quadratic normal form. -/
private theorem HasTwoBranchQuadraticMorseChart.right_branch_transport
    {a : Real → Complex} {phase : Real → Real} {left right : Real}
    (hchart : HasTwoBranchQuadraticMorseChart phase left right)
    (ha : Continuous a) (hphase : Continuous phase) (lambda : Real) :
    normalizedStationaryOscillatoryIntegral a phase hchart.criticalPoint right
        (phase hchart.criticalPoint) lambda =
      quadraticNormalFormOscillatoryIntegral
        (twoBranchQuadraticRightAmplitude a hchart.rightInverse)
        0 hchart.orientation lambda := by
  let G : Real → Complex := fun s =>
    a s * Complex.exp (((lambda * phase s : Real) : Complex) * Complex.I)
  have hGcont : Continuous G := by
    dsimp [G]
    fun_prop
  have hrightDeriv : ∀ u ∈ uIcc (0 : Real) 1,
      HasDerivAt hchart.rightInverse (deriv hchart.rightInverse u) u := by
    intro u hu
    exact ((hchart.rightInverse_smooth.differentiable (by simp) u).hasDerivAt)
  have hrightDerivCont : ContinuousOn (deriv hchart.rightInverse) (uIcc (0 : Real) 1) :=
    ((contDiff_infty_iff_deriv.mp hchart.rightInverse_smooth).2).continuous.continuousOn
  have hsubst := intervalIntegral.integral_deriv_smul_comp
    (a := (0 : Real)) (b := (1 : Real)) (f := hchart.rightInverse)
    (f' := deriv hchart.rightInverse) (g := G) hrightDeriv hrightDerivCont hGcont
  rw [hchart.rightInverse_zero, hchart.rightInverse_one] at hsubst
  change Complex.exp (((-(lambda * phase hchart.criticalPoint) : Real) : Complex) * Complex.I) *
      (∫ s in hchart.criticalPoint..right, G s) =
    ∫ u in (0 : Real)..1,
      twoBranchQuadraticRightAmplitude a hchart.rightInverse u *
        Complex.exp (((0 + hchart.orientation * lambda * u ^ 2 : Real) : Complex) * Complex.I)
  calc
    Complex.exp (((-(lambda * phase hchart.criticalPoint) : Real) : Complex) * Complex.I) *
        (∫ s in hchart.criticalPoint..right, G s) =
      Complex.exp (((-(lambda * phase hchart.criticalPoint) : Real) : Complex) * Complex.I) *
        ∫ u in (0 : Real)..1,
          deriv hchart.rightInverse u • (G ∘ hchart.rightInverse) u := by
          rw [hsubst]
    _ = ∫ u in (0 : Real)..1,
        Complex.exp (((-(lambda * phase hchart.criticalPoint) : Real) : Complex) * Complex.I) *
          (deriv hchart.rightInverse u • (G ∘ hchart.rightInverse) u) := by
          rw [← intervalIntegral.integral_const_mul]
    _ = ∫ u in (0 : Real)..1,
        twoBranchQuadraticRightAmplitude a hchart.rightInverse u *
          Complex.exp (((0 + hchart.orientation * lambda * u ^ 2 : Real) : Complex) * Complex.I) := by
          apply intervalIntegral.integral_congr
          intro u hu
          have hexp :
              Complex.exp (((-(lambda * phase hchart.criticalPoint) : Real) : Complex) * Complex.I) *
                Complex.exp (((lambda *
                  (phase hchart.criticalPoint + hchart.orientation * u ^ 2) : Real) : Complex) *
                    Complex.I) =
                  Complex.exp (((hchart.orientation * lambda * u ^ 2 : Real) : Complex) *
                    Complex.I) := by
              rw [← Complex.exp_add]
              congr 1
              push_cast
              ring
          dsimp [G, Function.comp_apply, twoBranchQuadraticRightAmplitude]
          have hu' : u ∈ Icc (0 : Real) 1 := by
            have hu'' := hu
            rw [uIcc_of_le (by norm_num : (0 : Real) ≤ 1)] at hu''
            exact hu''
          rw [hchart.right_phase u hu']
          simp only [zero_add]
          calc
            _ =
              a (hchart.rightInverse u) * ((deriv hchart.rightInverse u : Real) : Complex) *
                (Complex.exp (((-(lambda * phase hchart.criticalPoint) : Real) : Complex) * Complex.I) *
                  Complex.exp (((lambda *
                    (phase hchart.criticalPoint + hchart.orientation * u ^ 2) : Real) : Complex) *
                      Complex.I)) := by ring
            _ = _ := by rw [hexp]

/-- A bounded assembly theorem: two explicitly verified branch transports
produce the existing `HasQuadraticNormalForm` object.  The direct theorem
below discharges these branch identities from the chart equations using
`intervalIntegral.integral_deriv_smul_comp`. -/
private def HasTwoBranchQuadraticMorseChart.toHasQuadraticNormalForm_of_branchTransport
    {a : Real → Complex} {phase : Real → Real} {left right : Real}
    (hchart : HasTwoBranchQuadraticMorseChart phase left right)
    (ha : ContDiff Real (⊤ : ℕ∞) a)
    (ha_left : a =ᶠ[nhds left] 0) (ha_right : a =ᶠ[nhds right] 0)
    (hphase : ContDiff Real (⊤ : ℕ∞) phase)
    (hleft_transport : ∀ lambda : Real,
      normalizedStationaryOscillatoryIntegral a phase left hchart.criticalPoint
          (phase hchart.criticalPoint) lambda =
        quadraticNormalFormOscillatoryIntegral
          (twoBranchQuadraticLeftAmplitude a hchart.leftInverse)
          0 hchart.orientation lambda)
    (hright_transport : ∀ lambda : Real,
      normalizedStationaryOscillatoryIntegral a phase hchart.criticalPoint right
          (phase hchart.criticalPoint) lambda =
        quadraticNormalFormOscillatoryIntegral
          (twoBranchQuadraticRightAmplitude a hchart.rightInverse)
          0 hchart.orientation lambda) :
    HasQuadraticNormalForm a phase left right := by
  refine {
    criticalValue := phase hchart.criticalPoint
    orientation := hchart.orientation
    orientation_eq := hchart.orientation_eq
    transportedAmplitude := twoBranchQuadraticTransportedAmplitude a
      hchart.leftInverse hchart.rightInverse
    transportedAmplitude_smooth :=
      contDiff_twoBranchQuadraticTransportedAmplitude ha hchart.leftInverse_smooth
        hchart.rightInverse_smooth
    transportedAmplitude_vanishesNearOne :=
      twoBranchQuadraticTransportedAmplitude_vanishesNearOne ha_left ha_right
        hchart.leftInverse_smooth.continuous hchart.rightInverse_smooth.continuous
        hchart.leftInverse_one hchart.rightInverse_one
    transport := ?_ }
  intro lambda
  let G : Real → Complex := fun s =>
    a s * Complex.exp (((lambda * phase s : Real) : Complex) * Complex.I)
  have hGcont : Continuous G := by
    dsimp [G]
    fun_prop
  have hsplit :
      stationaryOscillatoryIntegral a phase left right lambda =
        stationaryOscillatoryIntegral a phase left hchart.criticalPoint lambda +
          stationaryOscillatoryIntegral a phase hchart.criticalPoint right lambda := by
    unfold stationaryOscillatoryIntegral
    exact (intervalIntegral.integral_add_adjacent_intervals
      (hGcont.intervalIntegrable left hchart.criticalPoint)
      (hGcont.intervalIntegrable hchart.criticalPoint right)).symm
  have hnormalized_split :
      normalizedStationaryOscillatoryIntegral a phase left right
          (phase hchart.criticalPoint) lambda =
        normalizedStationaryOscillatoryIntegral a phase left hchart.criticalPoint
          (phase hchart.criticalPoint) lambda +
          normalizedStationaryOscillatoryIntegral a phase hchart.criticalPoint right
          (phase hchart.criticalPoint) lambda := by
    unfold normalizedStationaryOscillatoryIntegral
    rw [hsplit]
    ring
  rw [hnormalized_split, hleft_transport lambda, hright_transport lambda]
  unfold quadraticNormalFormOscillatoryIntegral
  have hleftDerivC := contDiff_real_to_complex_morse (deriv hchart.leftInverse)
    ((contDiff_infty_iff_deriv.mp hchart.leftInverse_smooth).2)
  have hrightDerivC := contDiff_real_to_complex_morse (deriv hchart.rightInverse)
    ((contDiff_infty_iff_deriv.mp hchart.rightInverse_smooth).2)
  have hleftAmpCont : Continuous
      (twoBranchQuadraticLeftAmplitude a hchart.leftInverse) := by
    have h := (ha.comp hchart.leftInverse_smooth).mul hleftDerivC
    change Continuous (fun u : Real =>
      -(a (hchart.leftInverse u) * ((deriv hchart.leftInverse u : Real) : Complex)))
    exact h.continuous.neg
  have hrightAmpCont : Continuous
      (twoBranchQuadraticRightAmplitude a hchart.rightInverse) := by
    have h := (ha.comp hchart.rightInverse_smooth).mul hrightDerivC
    change Continuous (fun u : Real =>
      a (hchart.rightInverse u) * ((deriv hchart.rightInverse u : Real) : Complex))
    exact h.continuous
  let E : Real → Complex := fun u =>
    Complex.exp (((0 + hchart.orientation * lambda * u ^ 2 : Real) : Complex) * Complex.I)
  change (∫ u in (0 : Real)..1,
      twoBranchQuadraticLeftAmplitude a hchart.leftInverse u * E u) +
      ∫ u in (0 : Real)..1,
        twoBranchQuadraticRightAmplitude a hchart.rightInverse u * E u =
      ∫ u in (0 : Real)..1,
        twoBranchQuadraticTransportedAmplitude a hchart.leftInverse hchart.rightInverse u * E u
  have hleftInt : IntervalIntegrable
      (fun u : Real => twoBranchQuadraticLeftAmplitude a hchart.leftInverse u * E u)
      volume 0 1 := (hleftAmpCont.mul (by dsimp [E]; fun_prop)).intervalIntegrable 0 1
  have hrightInt : IntervalIntegrable
      (fun u : Real => twoBranchQuadraticRightAmplitude a hchart.rightInverse u * E u)
      volume 0 1 := (hrightAmpCont.mul (by dsimp [E]; fun_prop)).intervalIntegrable 0 1
  rw [← intervalIntegral.integral_add hleftInt hrightInt]
  apply intervalIntegral.integral_congr
  intro u hu
  simp only [twoBranchQuadraticLeftAmplitude, twoBranchQuadraticRightAmplitude,
    twoBranchQuadraticTransportedAmplitude]
  ring

/-- An explicit smooth two-branch Morse chart yields the existing quadratic
normal-form witness for every smooth amplitude supported away from the two
outer chart endpoints. -/
def HasTwoBranchQuadraticMorseChart.toHasQuadraticNormalForm
    {a : Real → Complex} {phase : Real → Real} {left right : Real}
    (hchart : HasTwoBranchQuadraticMorseChart phase left right)
    (ha : ContDiff Real (⊤ : ℕ∞) a)
    (ha_left : a =ᶠ[nhds left] 0) (ha_right : a =ᶠ[nhds right] 0)
    (hphase : ContDiff Real (⊤ : ℕ∞) phase) :
    HasQuadraticNormalForm a phase left right :=
  hchart.toHasQuadraticNormalForm_of_branchTransport ha ha_left ha_right hphase
    (fun lambda => hchart.left_branch_transport ha.continuous hphase.continuous lambda)
    (fun lambda => hchart.right_branch_transport ha.continuous hphase.continuous lambda)

/-- Normalizing the original phase at frequency `lambda` agrees exactly with
normalizing its radius-rescaled phase at frequency `radius^2 * lambda`. -/
theorem normalizedStationaryOscillatoryIntegral_quadraticMorsePhaseRescale
    (a : Real → Complex) (phase : Real → Real)
    (left right criticalPoint radius lambda : Real)
    (hradius : radius ≠ 0) :
    normalizedStationaryOscillatoryIntegral a phase left right
        (phase criticalPoint) lambda =
      normalizedStationaryOscillatoryIntegral a
        (quadraticMorsePhaseRescale phase criticalPoint radius) left right
        (quadraticMorsePhaseRescale phase criticalPoint radius criticalPoint)
        (radius ^ 2 * lambda) := by
  unfold normalizedStationaryOscillatoryIntegral stationaryOscillatoryIntegral
    quadraticMorsePhaseRescale
  rw [← intervalIntegral.integral_const_mul,
    ← intervalIntegral.integral_const_mul]
  apply intervalIntegral.integral_congr
  intro x hx
  have hmain :
      (- (lambda * phase criticalPoint) + lambda * phase x : Real) =
        (- ((radius ^ 2 * lambda) *
              (phase criticalPoint +
                (phase criticalPoint - phase criticalPoint) / radius ^ 2)) +
          (radius ^ 2 * lambda) *
            (phase criticalPoint +
              (phase x - phase criticalPoint) / radius ^ 2)) := by
    field_simp
    ring
  calc
    Complex.exp (((-(lambda * phase criticalPoint) : Real) : Complex) * Complex.I) *
        (a x * Complex.exp (((lambda * phase x : Real) : Complex) * Complex.I)) =
      a x * (Complex.exp (((-(lambda * phase criticalPoint) : Real) : Complex) * Complex.I) *
        Complex.exp (((lambda * phase x : Real) : Complex) * Complex.I)) := by ring
    _ = a x * Complex.exp
        (((-(lambda * phase criticalPoint) + lambda * phase x : Real) : Complex) *
          Complex.I) := by
          rw [← Complex.exp_add]
          congr 1
          push_cast
          ring
    _ = a x * Complex.exp
        (((- ((radius ^ 2 * lambda) *
              (phase criticalPoint +
                (phase criticalPoint - phase criticalPoint) / radius ^ 2)) +
          (radius ^ 2 * lambda) *
            (phase criticalPoint +
              (phase x - phase criticalPoint) / radius ^ 2) : Real) : Complex) *
          Complex.I) := by rw [hmain]
    _ = a x * (Complex.exp
        (((- ((radius ^ 2 * lambda) *
              (phase criticalPoint +
                (phase criticalPoint - phase criticalPoint) / radius ^ 2)) : Real) : Complex) *
          Complex.I) * Complex.exp
          ((((radius ^ 2 * lambda) *
            (phase criticalPoint +
              (phase x - phase criticalPoint) / radius ^ 2) : Real) : Complex) *
            Complex.I)) := by
          rw [← Complex.exp_add]
          congr 1
          push_cast
          ring
    _ = Complex.exp
        (((- ((radius ^ 2 * lambda) *
              (phase criticalPoint +
                (phase criticalPoint - phase criticalPoint) / radius ^ 2)) : Real) : Complex) *
          Complex.I) *
        (a x * Complex.exp
          ((((radius ^ 2 * lambda) *
            (phase criticalPoint +
              (phase x - phase criticalPoint) / radius ^ 2) : Real) : Complex) *
            Complex.I)) := by ring

/-- A proved unit normal form for the rescaled phase gives a radius-scaled
normal form for the original phase. -/
def HasQuadraticNormalForm.toHasRadiusScaledQuadraticNormalForm
    {a : Real → Complex} {phase : Real → Real} {left right criticalPoint radius : Real}
    (hnormal : HasQuadraticNormalForm a
      (quadraticMorsePhaseRescale phase criticalPoint radius) left right)
    (hradius : 0 < radius)
    (hcriticalValue : hnormal.criticalValue = phase criticalPoint) :
    HasRadiusScaledQuadraticNormalForm a phase left right := by
  refine {
    criticalValue := phase criticalPoint
    radius := radius
    radius_pos := hradius
    orientation := hnormal.orientation
    orientation_eq := hnormal.orientation_eq
    transportedAmplitude := hnormal.transportedAmplitude
    transportedAmplitude_smooth := hnormal.transportedAmplitude_smooth
    transportedAmplitude_vanishesNearOne := hnormal.transportedAmplitude_vanishesNearOne
    transport := ?_ }
  intro lambda
  calc
    normalizedStationaryOscillatoryIntegral a phase left right
        (phase criticalPoint) lambda =
      normalizedStationaryOscillatoryIntegral a
        (quadraticMorsePhaseRescale phase criticalPoint radius) left right
        (quadraticMorsePhaseRescale phase criticalPoint radius criticalPoint)
        (radius ^ 2 * lambda) :=
      normalizedStationaryOscillatoryIntegral_quadraticMorsePhaseRescale a phase left right
        criticalPoint radius lambda (ne_of_gt hradius)
    _ = normalizedStationaryOscillatoryIntegral a
        (quadraticMorsePhaseRescale phase criticalPoint radius) left right
        hnormal.criticalValue (radius ^ 2 * lambda) := by
      rw [hcriticalValue]
      simp [quadraticMorsePhaseRescale]
    _ = quadraticNormalFormOscillatoryIntegral hnormal.transportedAmplitude 0
        hnormal.orientation (radius ^ 2 * lambda) := hnormal.transport _

/-- An explicit globally smooth unit chart for the rescaled phase supplies
the radius-scaled transport.  The chart hypothesis is intentionally explicit:
the pointwise local inverse theorem alone does not produce global smooth branch
extensions. -/
def HasTwoBranchQuadraticMorseChart.toHasRadiusScaledQuadraticNormalForm
    {a : Real → Complex} {phase : Real → Real} {left right criticalPoint radius : Real}
    (hchart : HasTwoBranchQuadraticMorseChart
      (quadraticMorsePhaseRescale phase criticalPoint radius) left right)
    (hchart_critical : hchart.criticalPoint = criticalPoint)
    (ha : ContDiff Real (⊤ : ℕ∞) a)
    (ha_left : a =ᶠ[nhds left] 0) (ha_right : a =ᶠ[nhds right] 0)
    (hphase : ContDiff Real (⊤ : ℕ∞) phase)
    (hradius : 0 < radius) :
    HasRadiusScaledQuadraticNormalForm a phase left right := by
  let hnormal := hchart.toHasQuadraticNormalForm ha ha_left ha_right
    (contDiff_quadraticMorsePhaseRescale hphase)
  apply hnormal.toHasRadiusScaledQuadraticNormalForm hradius
  change quadraticMorsePhaseRescale phase criticalPoint radius
    hchart.criticalPoint = phase criticalPoint
  rw [hchart_critical]
  simp [quadraticMorsePhaseRescale]

/-- The explicit radius-scaled chart yields its exact radius-scaled normal
form for every smooth amplitude vanishing near the two artificial outer
endpoints. -/
def HasRadiusScaledQuadraticMorseChart.toHasRadiusScaledQuadraticNormalForm
    {a : Real → Complex} {phase : Real → Real} {left right : Real}
    (hchart : HasRadiusScaledQuadraticMorseChart phase left right)
    (ha : ContDiff Real (⊤ : ℕ∞) a)
    (ha_left : a =ᶠ[nhds left] 0) (ha_right : a =ᶠ[nhds right] 0)
    (hphase : ContDiff Real (⊤ : ℕ∞) phase) :
    HasRadiusScaledQuadraticNormalForm a phase left right :=
  hchart.toUnitChart.toHasRadiusScaledQuadraticNormalForm rfl ha ha_left ha_right
    hphase hchart.radius_pos

theorem contDiff_quadraticNormalFormOscillatoryIntegral
    (g : Real → Complex) (hg : ContDiff Real (⊤ : ℕ∞) g)
    (theta epsilon : Real) :
    ContDiff Real (⊤ : ℕ∞)
      (fun lambda => quadraticNormalFormOscillatoryIntegral g theta epsilon lambda) := by
  have hquad : ContDiff Real (⊤ : ℕ∞) (quadraticOscillatoryIntegral g) := by
    rw [show quadraticOscillatoryIntegral g = quadraticMomentIntegral 0 g by
      funext r
      simp [quadraticOscillatoryIntegral, quadraticMomentIntegral]]
    exact contDiff_quadraticMomentIntegral 0 g hg
  have hnormal :
      (fun r => quadraticNormalFormOscillatoryIntegral g theta epsilon r) =
        (fun r => Complex.exp (((theta : Real) : Complex) * Complex.I) *
          quadraticOscillatoryIntegral g (epsilon * r)) := by
    funext r
    exact quadraticNormalFormOscillatoryIntegral_eq g theta epsilon r
  rw [hnormal]
  fun_prop

/-- The exact high-frequency symbol estimate attached to a radius-scaled
quadratic normal form.  The condition `1 ≤ radius^2 * lambda` is the honest
one inherited from the unit quadratic estimate. -/
theorem HasRadiusScaledQuadraticNormalForm.hasScaledHalfOrderStationarySymbol
    {a : Real → Complex} {phase : Real → Real} {left right : Real}
    (h : HasRadiusScaledQuadraticNormalForm a phase left right) :
    ∀ k : Nat, ∃ C : Real, 0 < C ∧ ∀ lambda : Real,
      1 ≤ h.radius ^ 2 * lambda →
      ‖iteratedDeriv k
          (fun r => normalizedStationaryOscillatoryIntegral a phase left right
            h.criticalValue r) lambda‖ ≤
        (h.radius ^ 2) ^ k * C /
          Real.sqrt (h.radius ^ 2 * lambda) ^ (2 * k + 1) := by
  intro k
  obtain ⟨C, hC, hbound⟩ := quadraticNormalFormStationaryPhase_iteratedDeriv
    h.transportedAmplitude h.transportedAmplitude_smooth
    h.transportedAmplitude_vanishesNearOne k
  refine ⟨C, hC, ?_⟩
  intro lambda hlambda
  have hqcont : ContDiff Real (⊤ : ℕ∞)
      (fun r => quadraticNormalFormOscillatoryIntegral h.transportedAmplitude
        0 h.orientation r) :=
    contDiff_quadraticNormalFormOscillatoryIntegral h.transportedAmplitude
      h.transportedAmplitude_smooth 0 h.orientation
  have hk : (k : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by
    change ((k : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞)
    exact WithTop.coe_le_coe.mpr le_top
  have hfun :
      (fun r => normalizedStationaryOscillatoryIntegral a phase left right
        h.criticalValue r) =
        (fun r => quadraticNormalFormOscillatoryIntegral h.transportedAmplitude
          0 h.orientation (h.radius ^ 2 * r)) := by
    funext r
    exact h.transport r
  rw [hfun, iteratedDeriv_comp_const_smul (hqcont.of_le hk) (h.radius ^ 2),
    norm_smul, Real.norm_eq_abs, abs_pow, abs_of_nonneg (sq_nonneg h.radius)]
  calc
    (h.radius ^ 2) ^ k *
        ‖iteratedDeriv k
          (fun r => quadraticNormalFormOscillatoryIntegral h.transportedAmplitude
            0 h.orientation r) (h.radius ^ 2 * lambda)‖ ≤
      (h.radius ^ 2) ^ k *
        (C / Real.sqrt (h.radius ^ 2 * lambda) ^ (2 * k + 1)) :=
      mul_le_mul_of_nonneg_left
        (hbound 0 h.orientation (h.radius ^ 2 * lambda) h.orientation_eq hlambda)
        (pow_nonneg (sq_nonneg h.radius) _)
    _ = (h.radius ^ 2) ^ k * C /
        Real.sqrt (h.radius ^ 2 * lambda) ^ (2 * k + 1) := by
      rw [mul_div_assoc]

/-- The concrete derivative bounds for a one-dimensional stationary symbol
of order `-1/2`.  This is the direct form needed by the wave-symbol layer;
multiplying by `sqrt lambda` converts it to the usual order-zero coefficient
in a classical stationary-phase expansion. -/
def HasHalfOrderStationarySymbol (F : Real → Complex) : Prop :=
  ∀ k : Nat, ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
    ‖iteratedDeriv k F lambda‖ ≤ C / Real.sqrt lambda ^ (2 * k + 1)

/-- A verified quadratic-normal-form transport has the full stationary
symbol estimates.  This uses only the proved compact quadratic normal-form
estimate, leaving the separate construction of the Morse coordinate explicit
in the hypothesis. -/
theorem HasQuadraticNormalForm.hasHalfOrderStationarySymbol
    {a : Real → Complex} {phase : Real → Real} {left right : Real}
    (h : HasQuadraticNormalForm a phase left right) :
    HasHalfOrderStationarySymbol
      (normalizedStationaryOscillatoryIntegral a phase left right h.criticalValue) := by
  intro k
  obtain ⟨C, hC, hbound⟩ := quadraticNormalFormStationaryPhase_iteratedDeriv
    h.transportedAmplitude h.transportedAmplitude_smooth
    h.transportedAmplitude_vanishesNearOne k
  refine ⟨C, hC, ?_⟩
  intro lambda hlambda
  have hfun :
      (fun r => normalizedStationaryOscillatoryIntegral
        a phase left right h.criticalValue r) =
        (fun r => quadraticNormalFormOscillatoryIntegral
          h.transportedAmplitude 0 h.orientation r) := by
    funext r
    exact h.transport r
  change ‖iteratedDeriv k
    (fun r => normalizedStationaryOscillatoryIntegral
      a phase left right h.criticalValue r) lambda‖ ≤ _
  rw [hfun]
  exact hbound 0 h.orientation lambda h.orientation_eq hlambda

/-- A remainder whose parameter derivatives decay faster than every power on
the high-frequency half-line.  This is the literal remainder conclusion in
the one-dimensional stationary-phase theorem. -/
def HasRapidDecayRemainder (R : Real → Complex) : Prop :=
  ∀ N k : Nat, ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
    ‖iteratedDeriv k R lambda‖ ≤ C / lambda ^ N

/-- A stationary-phase expansion with the carrier phase displayed
explicitly.  The coefficient uses the already formalized half-order symbol
form; equivalently, multiplying it by `sqrt lambda` gives the usual
order-zero stationary coefficient. -/
def HasStationaryPhaseExpansion (F : Real → Complex) (theta : Real) : Prop :=
  ∃ b R : Real → Complex,
    HasHalfOrderStationarySymbol b ∧ HasRapidDecayRemainder R ∧
      ∀ lambda : Real, F lambda =
        Complex.exp (((lambda * theta : Real) : Complex) * Complex.I) * b lambda + R lambda

/-- Reintroducing the constant critical phase recovers the original
oscillatory integral from its normalized form. -/
theorem stationaryOscillatoryIntegral_eq_phase_mul_normalized
    (a : Real → Complex) (phase : Real → Real) (left right theta lambda : Real) :
    stationaryOscillatoryIntegral a phase left right lambda =
      Complex.exp (((lambda * theta : Real) : Complex) * Complex.I) *
        normalizedStationaryOscillatoryIntegral a phase left right theta lambda := by
  unfold normalizedStationaryOscillatoryIntegral
  have hneg : (((-(lambda * theta) : Real) : Complex) * Complex.I) =
      -(((lambda * theta : Real) : Complex) * Complex.I) := by
    push_cast
    ring
  rw [hneg, ← mul_assoc, ← Complex.exp_add]
  simp

/-- An explicit quadratic normal-form witness for the critical contribution,
together with a separately proved rapidly decaying remainder, yields the
literal stationary-phase expansion.  This theorem deliberately does not
construct either datum from an arbitrary phase: applications must prove the
Morse transport and the nonstationary remainder using their concrete
coordinates. -/
theorem stationaryPhase_of_normalForm_and_rapidRemainder
    {a stationaryAmplitude : Real → Complex} {phase : Real → Real} {left right : Real}
    {R : Real → Complex}
    (hnormal : HasQuadraticNormalForm stationaryAmplitude phase left right)
    (hR : HasRapidDecayRemainder R)
    (hsplit : ∀ lambda : Real,
      stationaryOscillatoryIntegral a phase left right lambda =
        stationaryOscillatoryIntegral stationaryAmplitude phase left right lambda + R lambda) :
    HasStationaryPhaseExpansion
      (stationaryOscillatoryIntegral a phase left right) hnormal.criticalValue := by
  refine ⟨normalizedStationaryOscillatoryIntegral stationaryAmplitude phase left right
    hnormal.criticalValue, R, hnormal.hasHalfOrderStationarySymbol, hR, ?_⟩
  intro lambda
  rw [hsplit lambda,
    stationaryOscillatoryIntegral_eq_phase_mul_normalized]

/-- Quantitative finite-order nonstationary phase for a linear phase.

This exposes the existing repeated integration-by-parts result through the
one-dimensional stationary-phase namespace, where it is used to control the
pieces away from a critical point. -/
theorem nonstationaryPhase
    {a b freq M : Real} {F : Nat → Real → Complex} {N : Nat}
    (hab : a ≤ b) (hfreq : freq ≠ 0)
    (hchain : HasOscillatoryIBPChain a b F N)
    (hM : 0 ≤ M) (hbound : ∀ t ∈ Icc a b, ‖F N t‖ ≤ M) :
    ‖∫ t in a..b, F 0 t * oscillatoryExp freq t‖ ≤
      (1 / |freq|) ^ N * ((b - a) * M) := by
  exact norm_intervalIntegral_mul_oscillatoryExp_le_iterated
    hab hfreq hchain hM hbound

/-- The complex wave associated with a real (not necessarily linear) phase.

The phase is kept separate from the frequency parameter.  This is the form
which occurs on the noncritical angular pieces of circular arclength. -/
def nonstationaryPhaseExp (freq : Real) (phase : Real → Real) (t : Real) : Complex :=
  Complex.exp (((freq * phase t : Real) : Complex) * Complex.I)

/-- Real phases have unit-modulus oscillatory exponentials. -/
theorem norm_nonstationaryPhaseExp (freq : Real) (phase : Real → Real) (t : Real) :
    ‖nonstationaryPhaseExp freq phase t‖ = 1 := by
  unfold nonstationaryPhaseExp
  exact Complex.norm_exp_ofReal_mul_I _

/-- A phase-adapted integration-by-parts chain.  The successor is the
derivative of the preceding amplitude divided by the phase derivative.  The
chain is intentionally explicit: it is exactly the regularity datum needed
for arbitrary nonlinear phases, without silently asserting a global smooth
inverse-function theorem. -/
def HasNonstationaryPhaseIBPChain (a b : Real) (phaseDeriv : Real → Real)
    (F : Nat → Real → Complex) (N : Nat) : Prop :=
  ∀ k : Nat, k < N →
    (∀ t ∈ uIcc a b,
      HasDerivAt (fun s => F k s * ((phaseDeriv s : Real) : Complex)⁻¹)
        (F (k + 1) t) t) ∧
      Continuous (F (k + 1)) ∧ F k a = 0 ∧ F k b = 0

/-- One exact integration by parts for a nonlinear nonstationary phase.

The explicit chain in `HasNonstationaryPhaseIBPChain` is what supplies the
derivative of the quotient by `phaseDeriv`.  Thus the result applies to any
concrete smooth phase once those elementary derivative identities have been
established. -/
theorem intervalIntegral_mul_nonstationaryPhaseExp_eq_neg_inv_mul
    {a b freq : Real} {phase phaseDeriv : Real → Real} {F G : Real → Complex}
    (hfreq : freq ≠ 0) (hphase : ∀ t ∈ uIcc a b, HasDerivAt phase (phaseDeriv t) t)
    (hphaseDeriv_ne : ∀ t ∈ uIcc a b, phaseDeriv t ≠ 0)
    (hphase_cont : Continuous phase) (hphaseDeriv_cont : Continuous phaseDeriv)
    (hF : ∀ t ∈ uIcc a b,
      HasDerivAt (fun s => F s * ((phaseDeriv s : Real) : Complex)⁻¹) (G t) t)
    (hG : Continuous G) (hFa : F a = 0) (hFb : F b = 0) :
    (∫ t in a..b, F t * nonstationaryPhaseExp freq phase t) =
      -(((freq : Complex) * Complex.I)⁻¹) *
        ∫ t in a..b, G t * nonstationaryPhaseExp freq phase t := by
  let z : Complex := (freq : Complex) * Complex.I
  let s : Complex := z⁻¹
  let E : Real → Complex := nonstationaryPhaseExp freq phase
  have hz : z ≠ 0 := by
    dsimp [z]
    exact mul_ne_zero (Complex.ofReal_ne_zero.mpr hfreq) Complex.I_ne_zero
  have hsz : s * z = 1 := by
    dsimp [s]
    exact inv_mul_cancel₀ hz
  have hE (t : Real) (ht : t ∈ uIcc a b) :
      HasDerivAt E (E t * (((freq * phaseDeriv t : Real) : Complex) * Complex.I)) t := by
    have hreal : HasDerivAt (fun u : Real => freq * phase u) (freq * phaseDeriv t) t := by
      simpa [mul_comm] using (hphase t ht).const_mul freq
    have harg : HasDerivAt
        (fun u : Real => ((freq * phase u : Real) : Complex) * Complex.I)
        (((freq * phaseDeriv t : Real) : Complex) * Complex.I) t := by
      simpa only [Complex.real_smul] using hreal.smul_const Complex.I
    change HasDerivAt
      (fun u : Real => Complex.exp (((freq * phase u : Real) : Complex) * Complex.I))
      (Complex.exp (((freq * phase t : Real) : Complex) * Complex.I) *
        (((freq * phaseDeriv t : Real) : Complex) * Complex.I)) t
    simpa [mul_assoc, mul_left_comm, mul_comm] using harg.cexp
  have hEcont : Continuous E := by
    dsimp [E, nonstationaryPhaseExp]
    exact Complex.continuous_exp.comp
      ((Complex.continuous_ofReal.comp (continuous_const.mul hphase_cont)).mul
        continuous_const)
  have hV (t : Real) (ht : t ∈ uIcc a b) :
      HasDerivAt (fun u => s * E u) ((phaseDeriv t : Complex) * E t) t := by
    have h := (hE t ht).const_mul s
    have hcancel :
        s * (E t * (((freq * phaseDeriv t : Real) : Complex) * Complex.I)) =
          (phaseDeriv t : Complex) * E t := by
      calc
        s * (E t * (((freq * phaseDeriv t : Real) : Complex) * Complex.I)) =
            (s * z) * ((phaseDeriv t : Complex) * E t) := by
              dsimp [z]
              push_cast
              ring
        _ = (phaseDeriv t : Complex) * E t := by rw [hsz, one_mul]
    simpa only [hcancel] using h
  have hV'cont : Continuous (fun t : Real => (phaseDeriv t : Complex) * E t) :=
    (Complex.continuous_ofReal.comp hphaseDeriv_cont).mul hEcont
  have hparts := intervalIntegral.integral_mul_deriv_eq_deriv_mul
    (u := fun u => F u * ((phaseDeriv u : Real) : Complex)⁻¹) (u' := G)
    (v := fun u => s * E u) (v' := fun u => (phaseDeriv u : Complex) * E u)
    hF (fun t ht => hV t ht) (hG.intervalIntegrable a b) (hV'cont.intervalIntegrable a b)
  have hboundary :
      (F b * ((phaseDeriv b : Real) : Complex)⁻¹) * (s * E b) -
        (F a * ((phaseDeriv a : Real) : Complex)⁻¹) * (s * E a) = 0 := by
    rw [hFb, hFa]
    ring
  have hfactor :
      (∫ t in a..b, G t * (s * E t)) = s * ∫ t in a..b, G t * E t := by
    rw [← intervalIntegral.integral_const_mul]
    apply intervalIntegral.integral_congr
    intro t ht
    ring
  have hintegrand (t : Real) (ht : t ∈ uIcc a b) :
      F t * E t =
        (F t * ((phaseDeriv t : Real) : Complex)⁻¹) *
          ((phaseDeriv t : Complex) * E t) := by
    have hne : (phaseDeriv t : Complex) ≠ 0 :=
      Complex.ofReal_ne_zero.mpr (hphaseDeriv_ne t ht)
    symm
    calc
      (F t * ((phaseDeriv t : Real) : Complex)⁻¹) *
          ((phaseDeriv t : Complex) * E t) =
          F t * (((phaseDeriv t : Complex)⁻¹ * (phaseDeriv t : Complex)) * E t) := by
            ring
      _ = F t * E t := by rw [inv_mul_cancel₀ hne, one_mul]
  calc
    (∫ t in a..b, F t * nonstationaryPhaseExp freq phase t) =
        ∫ t in a..b, F t * E t := rfl
    _ = ∫ t in a..b,
        (F t * ((phaseDeriv t : Real) : Complex)⁻¹) *
          ((phaseDeriv t : Complex) * E t) := by
            apply intervalIntegral.integral_congr
            intro t ht
            exact hintegrand t ht
    _ = (F b * ((phaseDeriv b : Real) : Complex)⁻¹) * (s * E b) -
          (F a * ((phaseDeriv a : Real) : Complex)⁻¹) * (s * E a) -
          ∫ t in a..b, G t * (s * E t) := hparts
    _ = - (∫ t in a..b, G t * (s * E t)) := by rw [hboundary]; ring
    _ = -s * ∫ t in a..b, G t * E t := by rw [hfactor]; ring
    _ = -(((freq : Complex) * Complex.I)⁻¹) *
          ∫ t in a..b, G t * nonstationaryPhaseExp freq phase t := by
            rfl

/-- Finite iteration of nonlinear nonstationary integration by parts. -/
private theorem intervalIntegral_mul_nonstationaryPhaseExp_iterated
    {a b freq : Real} {phase phaseDeriv : Real → Real} {F : Nat → Real → Complex}
    {L N k : Nat}
    (hfreq : freq ≠ 0) (hphase : ∀ t ∈ uIcc a b, HasDerivAt phase (phaseDeriv t) t)
    (hphaseDeriv_ne : ∀ t ∈ uIcc a b, phaseDeriv t ≠ 0)
    (hphase_cont : Continuous phase) (hphaseDeriv_cont : Continuous phaseDeriv)
    (hchain : HasNonstationaryPhaseIBPChain a b phaseDeriv F L)
    (hkn : k + N ≤ L) :
    (∫ t in a..b, F k t * nonstationaryPhaseExp freq phase t) =
      (-(((freq : Complex) * Complex.I)⁻¹)) ^ N *
        ∫ t in a..b, F (k + N) t * nonstationaryPhaseExp freq phase t := by
  induction N generalizing k with
  | zero => simp
  | succ N ih =>
      have hklt : k < L := by omega
      rcases hchain k hklt with ⟨hderiv, hcont, hleft, hright⟩
      have hone := intervalIntegral_mul_nonstationaryPhaseExp_eq_neg_inv_mul
        hfreq hphase hphaseDeriv_ne hphase_cont hphaseDeriv_cont hderiv hcont hleft hright
      have hnext : (k + 1) + N ≤ L := by omega
      have htail := ih (k := k + 1) hnext
      rw [hone, htail, pow_succ]
      have hindex : k + 1 + N = k + (N + 1) := by omega
      rw [hindex]
      ring

/-- Quantitative arbitrary-order nonstationary phase for a verified
phase-adapted integration-by-parts chain. -/
theorem nonstationaryPhase_of_chain
    {a b freq M : Real} {phase phaseDeriv : Real → Real}
    {F : Nat → Real → Complex} {N : Nat}
    (hab : a ≤ b) (hfreq : freq ≠ 0)
    (hphase : ∀ t ∈ uIcc a b, HasDerivAt phase (phaseDeriv t) t)
    (hphaseDeriv_ne : ∀ t ∈ uIcc a b, phaseDeriv t ≠ 0)
    (hphase_cont : Continuous phase) (hphaseDeriv_cont : Continuous phaseDeriv)
    (hchain : HasNonstationaryPhaseIBPChain a b phaseDeriv F N)
    (_hM : 0 ≤ M) (hbound : ∀ t ∈ Icc a b, ‖F N t‖ ≤ M) :
    ‖∫ t in a..b, F 0 t * nonstationaryPhaseExp freq phase t‖ ≤
      (1 / |freq|) ^ N * ((b - a) * M) := by
  have hiter := intervalIntegral_mul_nonstationaryPhaseExp_iterated
    (L := N) (N := N) (k := 0) hfreq hphase hphaseDeriv_ne hphase_cont hphaseDeriv_cont hchain
      (by omega)
  have hlast :
      ‖∫ t in a..b, F N t * nonstationaryPhaseExp freq phase t‖ ≤ (b - a) * M := by
    calc
      ‖∫ t in a..b, F N t * nonstationaryPhaseExp freq phase t‖ ≤ M * |b - a| := by
        apply intervalIntegral.norm_integral_le_of_norm_le_const
        intro t ht
        have ht' : t ∈ Icc a b := by
          rw [uIoc_of_le hab] at ht
          exact ⟨ht.1.le, ht.2⟩
        rw [norm_mul, norm_nonstationaryPhaseExp, mul_one]
        exact hbound t ht'
      _ = (b - a) * M := by
        rw [abs_of_nonneg (sub_nonneg.mpr hab)]
        ring
  have hfactor : ‖-(((freq : Complex) * Complex.I)⁻¹)‖ = 1 / |freq| := by
    rw [norm_neg, norm_inv, norm_mul, Complex.norm_real,
      Complex.norm_I, mul_one, Real.norm_eq_abs]
    exact inv_eq_one_div _
  rw [hiter, norm_mul, norm_pow, hfactor]
  exact mul_le_mul_of_nonneg_left (by simpa using hlast)
    (pow_nonneg (one_div_nonneg.mpr (abs_pos.mpr hfreq).le) _)

/-- A compact interval supplies the final uniform amplitude constant for a
nonstationary phase chain.  Together with `nonstationaryPhase_of_chain`, this
is the reusable arbitrary-power decay statement used after a middle angular
cutoff has been differentiated into its quotient-derivative chain. -/
theorem exists_nonstationaryPhaseBound_of_chain
    {a b freq : Real} {phase phaseDeriv : Real → Real}
    {F : Nat → Real → Complex} {N : Nat}
    (hab : a ≤ b) (hfreq : freq ≠ 0)
    (hphase : ∀ t ∈ uIcc a b, HasDerivAt phase (phaseDeriv t) t)
    (hphaseDeriv_ne : ∀ t ∈ uIcc a b, phaseDeriv t ≠ 0)
    (hphase_cont : Continuous phase) (hphaseDeriv_cont : Continuous phaseDeriv)
    (hchain : HasNonstationaryPhaseIBPChain a b phaseDeriv F N)
    (hfinal : Continuous (F N)) :
    ∃ M : Real, 0 < M ∧
      ‖∫ t in a..b, F 0 t * nonstationaryPhaseExp freq phase t‖ ≤
        (1 / |freq|) ^ N * ((b - a) * M) := by
  have hbounded : Bornology.IsBounded ((F N) '' Icc a b) :=
    (isCompact_Icc.image_of_continuousOn hfinal.continuousOn).isBounded
  rcases hbounded.exists_pos_norm_le with ⟨M, hM, hbound⟩
  refine ⟨M, hM, ?_⟩
  exact nonstationaryPhase_of_chain hab hfreq hphase hphaseDeriv_ne hphase_cont
    hphaseDeriv_cont hchain hM.le
    (fun t ht => hbound _ (mem_image_of_mem _ ht))

/-- The `k`-th parameter moment of a literal stationary oscillatory integral.
It is exactly the integral obtained by differentiating the frequency
parameter `k` times. -/
def stationaryPhaseMomentIntegral
    (a : Real → Complex) (phase : Real → Real) (k : Nat)
    (left right lambda : Real) : Complex :=
  ∫ t in left..right,
    a t * (((phase t : Complex) * Complex.I) ^ k) *
      Complex.exp (((lambda * phase t : Real) : Complex) * Complex.I)

/-- Differentiating a compact oscillatory integral in its frequency parameter
inserts one copy of `I * phase`.  Compactness supplies a local uniform
dominating function, so this is a literal parametric-integral calculation
rather than a formal differentiation under the integral sign. -/
theorem hasDerivAt_stationaryPhaseMomentIntegral
    {a : Real → Complex} {phase : Real → Real} {left right : Real}
    (hleft : left ≤ right) (ha : Continuous a) (hphase : Continuous phase)
    (k : Nat) (lambda : Real) :
    HasDerivAt (stationaryPhaseMomentIntegral a phase k left right)
      (stationaryPhaseMomentIntegral a phase (k + 1) left right lambda) lambda := by
  let A : Real → Complex := fun t =>
    a t * (((phase t : Complex) * Complex.I) ^ (k + 1))
  have hAcont : Continuous A := by
    dsimp [A]
    fun_prop
  have hAbounded : Bornology.IsBounded (A '' Icc left right) :=
    (isCompact_Icc.image_of_continuousOn hAcont.continuousOn).isBounded
  obtain ⟨M, hM, hMbound⟩ := hAbounded.exists_pos_norm_le
  let F : Real → Real → Complex := fun u t =>
    a t * (((phase t : Complex) * Complex.I) ^ k) *
      Complex.exp (((u * phase t : Real) : Complex) * Complex.I)
  let F' : Real → Real → Complex := fun u t =>
    a t * (((phase t : Complex) * Complex.I) ^ (k + 1)) *
      Complex.exp (((u * phase t : Real) : Complex) * Complex.I)
  have hFcont (u : Real) : Continuous (F u) := by
    dsimp [F]
    fun_prop
  have hF'cont (u : Real) : Continuous (F' u) := by
    dsimp [F']
    fun_prop
  change HasDerivAt (fun u : Real => ∫ t in left..right, F u t)
    (stationaryPhaseMomentIntegral a phase (k + 1) left right lambda) lambda
  have hparam := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := volume) (a := left) (b := right) (s := Set.univ) (x₀ := lambda)
    (bound := fun _ : Real => M) (F := F) (F' := F') Filter.univ_mem
    (by
      filter_upwards [] with u
      exact (hFcont u).aestronglyMeasurable)
    ((hFcont lambda).intervalIntegrable left right)
    ((hF'cont lambda).aestronglyMeasurable)
    (by
      filter_upwards with t
      intro ht u hu
      have ht' : t ∈ Icc left right := by
        have ht'' : t ∈ Ioc left right := by
          simpa only [uIoc_of_le hleft] using ht
        exact ⟨ht''.1.le, ht''.2⟩
      have hbase := hMbound _ (mem_image_of_mem _ ht')
      dsimp [F']
      rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one]
      exact hbase)
    ((by fun_prop : Continuous (fun _ : Real => M)).intervalIntegrable left right)
    (by
      filter_upwards with t
      intro ht u hu
      have hreal : HasDerivAt (fun v : Real => v * phase t) (phase t) u := by
        simpa [mul_comm] using (hasDerivAt_id u).const_mul (phase t)
      have harg : HasDerivAt
          (fun v : Real => ((v * phase t : Real) : Complex) * Complex.I)
          (((phase t : Real) : Complex) * Complex.I) u := by
        simpa only [Complex.real_smul] using hreal.smul_const Complex.I
      dsimp [F, F']
      convert (harg.cexp).const_mul
        (a t * (((phase t : Complex) * Complex.I) ^ k)) using 1
        <;> first | rfl | exact Subsingleton.elim _ _ |
          (push_cast; rw [pow_succ]; ring))
  have hF'int :
      (∫ t in left..right, F' lambda t) =
        stationaryPhaseMomentIntegral a phase (k + 1) left right lambda := by
    unfold stationaryPhaseMomentIntegral
    apply intervalIntegral.integral_congr
    intro t ht
    rfl
  rw [hF'int] at hparam
  exact hparam.2

/-- Every parameter derivative of the literal stationary integral is its
corresponding phase moment. -/
theorem iteratedDeriv_stationaryOscillatoryIntegral_eq_stationaryPhaseMomentIntegral
    {a : Real → Complex} {phase : Real → Real} {left right : Real}
    (hleft : left ≤ right) (ha : Continuous a) (hphase : Continuous phase)
    (k : Nat) :
    iteratedDeriv k (stationaryOscillatoryIntegral a phase left right) =
      fun lambda => stationaryPhaseMomentIntegral a phase k left right lambda := by
  induction k with
  | zero =>
      funext lambda
      simp [iteratedDeriv, stationaryOscillatoryIntegral,
        stationaryPhaseMomentIntegral]
  | succ k ih =>
      rw [iteratedDeriv_succ, ih]
      funext lambda
      exact (hasDerivAt_stationaryPhaseMomentIntegral hleft ha hphase k lambda).deriv

/-- Concrete data which turns a nonstationary oscillatory integral into a
rapidly decaying parameter remainder.  The family `amplitudes k N` is an
actual quotient-derivative integration-by-parts chain for the amplitude with
the `k`-th parameter moment inserted. -/
structure HasNonstationaryRapidDecayData
    (a : Real → Complex) (phase phaseDeriv : Real → Real)
    (left right : Real) where
  left_le : left ≤ right
  amplitude_cont : Continuous a
  phase_cont : Continuous phase
  phaseDeriv_cont : Continuous phaseDeriv
  phase_deriv : ∀ t ∈ uIcc left right, HasDerivAt phase (phaseDeriv t) t
  derivative_lower : ∃ c : Real, 0 < c ∧
    ∀ t ∈ Icc left right, c ≤ |phaseDeriv t|
  amplitudes : Nat → Nat → Nat → Real → Complex
  amplitudes_zero : ∀ k N t,
    amplitudes k N 0 t =
      a t * (((phase t : Complex) * Complex.I) ^ k)
  chains : ∀ k N,
    HasNonstationaryPhaseIBPChain left right phaseDeriv (amplitudes k N) N
  final_cont : ∀ k N, Continuous (amplitudes k N N)

/-- Explicit nonstationary phase data gives a remainder whose every parameter
derivative decays faster than every power.  The proof first identifies a
parameter derivative with a phase moment, then applies the supplied
quotient-derivative integration-by-parts chain to that moment. -/
theorem HasNonstationaryRapidDecayData.hasRapidDecayRemainder
    {a : Real → Complex} {phase phaseDeriv : Real → Real} {left right : Real}
    (h : HasNonstationaryRapidDecayData a phase phaseDeriv left right) :
    HasRapidDecayRemainder (stationaryOscillatoryIntegral a phase left right) := by
  intro N k
  have hbounded : Bornology.IsBounded ((h.amplitudes k N N) '' Icc left right) :=
    (isCompact_Icc.image_of_continuousOn (h.final_cont k N).continuousOn).isBounded
  rcases hbounded.exists_pos_norm_le with ⟨M, hM, hMbound⟩
  have hlength_nonneg : 0 ≤ right - left := sub_nonneg.mpr h.left_le
  have hCpos : 0 < (right - left) * M + 1 := by
    nlinarith [mul_nonneg hlength_nonneg hM.le]
  refine ⟨(right - left) * M + 1, hCpos, ?_⟩
  intro lambda hlambda
  have hlambda_nonneg : 0 ≤ lambda := le_trans zero_le_one hlambda
  have hlambda_ne : lambda ≠ 0 := ne_of_gt (lt_of_lt_of_le zero_lt_one hlambda)
  have hphaseDeriv_ne : ∀ t ∈ uIcc left right, phaseDeriv t ≠ 0 := by
    obtain ⟨c, hc, hclower⟩ := h.derivative_lower
    intro t ht
    have ht' : t ∈ Icc left right := by
      simpa only [uIcc_of_le h.left_le] using ht
    exact abs_pos.mp (lt_of_lt_of_le hc (hclower t ht'))
  have hnonstationary := nonstationaryPhase_of_chain
    h.left_le hlambda_ne h.phase_deriv hphaseDeriv_ne h.phase_cont h.phaseDeriv_cont
    (h.chains k N) hM.le
    (fun t ht => hMbound _ (mem_image_of_mem _ ht))
  have hmoment :
      stationaryPhaseMomentIntegral a phase k left right lambda =
        ∫ t in left..right,
          h.amplitudes k N 0 t * nonstationaryPhaseExp lambda phase t := by
    unfold stationaryPhaseMomentIntegral
    apply intervalIntegral.integral_congr
    intro t ht
    change a t * (((phase t : Complex) * Complex.I) ^ k) *
        Complex.exp (((lambda * phase t : Real) : Complex) * Complex.I) =
      h.amplitudes k N 0 t *
        Complex.exp (((lambda * phase t : Real) : Complex) * Complex.I)
    rw [h.amplitudes_zero]
  rw [iteratedDeriv_stationaryOscillatoryIntegral_eq_stationaryPhaseMomentIntegral
    h.left_le h.amplitude_cont h.phase_cont k]
  change ‖stationaryPhaseMomentIntegral a phase k left right lambda‖ ≤ _
  rw [hmoment]
  rw [abs_of_nonneg hlambda_nonneg] at hnonstationary
  calc
    ‖∫ t in left..right,
        h.amplitudes k N 0 t * nonstationaryPhaseExp lambda phase t‖ ≤
        (1 / lambda) ^ N * ((right - left) * M) := hnonstationary
    _ = ((right - left) * M) / lambda ^ N := by
      rw [one_div_pow]
      ring
    _ ≤ ((right - left) * M + 1) / lambda ^ N := by
      apply div_le_div_of_nonneg_right
      · linarith
      · exact pow_nonneg hlambda_nonneg N

/-- The recursive quotient amplitudes produced by nonlinear integration by
parts.  The successor differentiates the preceding amplitude after division
by the supplied phase derivative. -/
def nonstationaryIBPAmplitude
    (phaseDeriv : Real → Real) (F : Real → Complex) : Nat → Real → Complex
  | 0 => F
  | Nat.succ k => fun x =>
      deriv (fun y => nonstationaryIBPAmplitude phaseDeriv F k y *
        ((phaseDeriv y : Real) : Complex)⁻¹) x

private theorem contDiff_real_to_complex
    (f : Real → Real) (hf : ContDiff Real (⊤ : ℕ∞) f) :
    ContDiff Real (⊤ : ℕ∞) (fun x : Real => (f x : Complex)) := by
  change ContDiff Real (⊤ : ℕ∞) (Complex.ofRealCLM ∘ f)
  exact Complex.ofRealCLM.contDiff.comp hf

/-- Smoothness of the recursively constructed nonlinear IBP amplitudes.
The global nonvanishing hypothesis is precisely what makes reciprocal phase
derivatives smooth at every recursion stage. -/
theorem contDiff_nonstationaryIBPAmplitude
    (phaseDeriv : Real → Real) (F : Real → Complex)
    (hphaseDeriv : ContDiff Real (⊤ : ℕ∞) phaseDeriv)
    (hphaseDeriv_ne : ∀ x, phaseDeriv x ≠ 0)
    (hF : ContDiff Real (⊤ : ℕ∞) F) (k : Nat) :
    ContDiff Real (⊤ : ℕ∞) (nonstationaryIBPAmplitude phaseDeriv F k) := by
  induction k with
  | zero =>
      simpa [nonstationaryIBPAmplitude] using hF
  | succ k ih =>
      have hphaseDerivC := contDiff_real_to_complex phaseDeriv hphaseDeriv
      have hquot : ContDiff Real (⊤ : ℕ∞)
          (fun x : Real => nonstationaryIBPAmplitude phaseDeriv F k x *
            ((phaseDeriv x : Real) : Complex)⁻¹) :=
        ih.mul (hphaseDerivC.inv (fun x =>
          Complex.ofReal_ne_zero.mpr (hphaseDeriv_ne x)))
      simpa only [nonstationaryIBPAmplitude] using
        (contDiff_infty_iff_deriv.mp hquot).2

/-- Endpoint vanishing in a neighbourhood survives every quotient-derivative
stage. -/
theorem nonstationaryIBPAmplitude_eventuallyEq_zero
    (phaseDeriv : Real → Real) (F : Real → Complex) {x : Real}
    (hF : F =ᶠ[nhds x] 0) (k : Nat) :
    nonstationaryIBPAmplitude phaseDeriv F k =ᶠ[nhds x] 0 := by
  induction k with
  | zero => simpa [nonstationaryIBPAmplitude] using hF
  | succ k ih =>
      have hquot :
          (fun y => nonstationaryIBPAmplitude phaseDeriv F k y *
            ((phaseDeriv y : Real) : Complex)⁻¹) =ᶠ[nhds x] 0 := by
        filter_upwards [ih] with y hy
        rw [hy]
        simp
      simpa [nonstationaryIBPAmplitude] using hquot.deriv

/-- A smooth endpoint-vanishing amplitude and a globally smooth nonzero
phase derivative produce the explicit nonlinear chain required by
`nonstationaryPhase_of_chain`. -/
theorem hasNonstationaryPhaseIBPChain_nonstationaryIBPAmplitude_of_contDiff
    {left right : Real} (phaseDeriv : Real → Real) (F : Real → Complex)
    (hphaseDeriv : ContDiff Real (⊤ : ℕ∞) phaseDeriv)
    (hphaseDeriv_ne : ∀ x, phaseDeriv x ≠ 0)
    (hF : ContDiff Real (⊤ : ℕ∞) F)
    (hFleft : F =ᶠ[nhds left] 0) (hFright : F =ᶠ[nhds right] 0)
    (N : Nat) :
    HasNonstationaryPhaseIBPChain left right phaseDeriv
      (nonstationaryIBPAmplitude phaseDeriv F) N := by
  intro k hk
  constructor
  · intro t ht
    have hcont := contDiff_nonstationaryIBPAmplitude phaseDeriv F hphaseDeriv
      hphaseDeriv_ne hF k
    have hphaseDerivC := contDiff_real_to_complex phaseDeriv hphaseDeriv
    have hquot : ContDiff Real (⊤ : ℕ∞)
        (fun x : Real => nonstationaryIBPAmplitude phaseDeriv F k x *
          ((phaseDeriv x : Real) : Complex)⁻¹) :=
      hcont.mul (hphaseDerivC.inv (fun x =>
        Complex.ofReal_ne_zero.mpr (hphaseDeriv_ne x)))
    simpa [nonstationaryIBPAmplitude] using
      ((hquot.differentiable (by simp)) t).hasDerivAt
  constructor
  · exact (contDiff_nonstationaryIBPAmplitude phaseDeriv F hphaseDeriv
      hphaseDeriv_ne hF (k + 1)).continuous
  constructor
  · have hzero := nonstationaryIBPAmplitude_eventuallyEq_zero phaseDeriv F hFleft k
    have hvalue := Filter.EventuallyEq.iteratedDeriv_eq 0 hzero
    simpa [iteratedDeriv] using hvalue
  · have hzero := nonstationaryIBPAmplitude_eventuallyEq_zero phaseDeriv F hFright k
    have hvalue := Filter.EventuallyEq.iteratedDeriv_eq 0 hzero
    simpa [iteratedDeriv] using hvalue

/-- Builds all the explicit chain data for a smooth compact nonstationary
amplitude.  Here `phaseDeriv` is a globally smooth nonvanishing extension of
the actual derivative on the integration interval; only its stated lower
bound is used to obtain the nonstationary estimate there. -/
def nonstationaryRapidDecayData_of_contDiff
    {a : Real → Complex} {phase phaseDeriv : Real → Real} {left right : Real}
    (hleft : left ≤ right)
    (ha : ContDiff Real (⊤ : ℕ∞) a)
    (ha_left : a =ᶠ[nhds left] 0) (ha_right : a =ᶠ[nhds right] 0)
    (hphase : ContDiff Real (⊤ : ℕ∞) phase)
    (hphaseDeriv : ContDiff Real (⊤ : ℕ∞) phaseDeriv)
    (hphaseDeriv_ne : ∀ x, phaseDeriv x ≠ 0)
    (hphase_deriv : ∀ t ∈ uIcc left right, HasDerivAt phase (phaseDeriv t) t)
    (hlower : ∃ c : Real, 0 < c ∧
      ∀ t ∈ Icc left right, c ≤ |phaseDeriv t|) :
    HasNonstationaryRapidDecayData a phase phaseDeriv left right := by
  have hphaseC := contDiff_real_to_complex phase hphase
  have hmoment_cont (k : Nat) : ContDiff Real (⊤ : ℕ∞)
      (fun t : Real => a t * (((phase t : Complex) * Complex.I) ^ k)) :=
    ha.mul ((hphaseC.mul contDiff_const).pow k)
  have hmoment_left (k : Nat) :
      (fun t : Real => a t * (((phase t : Complex) * Complex.I) ^ k)) =ᶠ[nhds left] 0 := by
    filter_upwards [ha_left] with t ht
    rw [ht]
    simp
  have hmoment_right (k : Nat) :
      (fun t : Real => a t * (((phase t : Complex) * Complex.I) ^ k)) =ᶠ[nhds right] 0 := by
    filter_upwards [ha_right] with t ht
    rw [ht]
    simp
  refine {
    left_le := hleft
    amplitude_cont := ha.continuous
    phase_cont := hphase.continuous
    phaseDeriv_cont := hphaseDeriv.continuous
    phase_deriv := hphase_deriv
    derivative_lower := hlower
    amplitudes := fun k _ => nonstationaryIBPAmplitude phaseDeriv
      (fun t : Real => a t * (((phase t : Complex) * Complex.I) ^ k))
    amplitudes_zero := ?_
    chains := ?_
    final_cont := ?_ }
  · intro k N t
    simp [nonstationaryIBPAmplitude]
  · intro k N
    exact hasNonstationaryPhaseIBPChain_nonstationaryIBPAmplitude_of_contDiff phaseDeriv
      (fun t : Real => a t * (((phase t : Complex) * Complex.I) ^ k))
      hphaseDeriv hphaseDeriv_ne (hmoment_cont k) (hmoment_left k) (hmoment_right k) N
  · intro k N
    exact (contDiff_nonstationaryIBPAmplitude phaseDeriv
      (fun t : Real => a t * (((phase t : Complex) * Complex.I) ^ k))
      hphaseDeriv hphaseDeriv_ne (hmoment_cont k) N).continuous

/-- The preceding data construction immediately yields all-derivative rapid
decay for a smooth compact nonstationary oscillatory integral. -/
theorem hasRapidDecayRemainder_of_contDiff
    {a : Real → Complex} {phase phaseDeriv : Real → Real} {left right : Real}
    (hleft : left ≤ right)
    (ha : ContDiff Real (⊤ : ℕ∞) a)
    (ha_left : a =ᶠ[nhds left] 0) (ha_right : a =ᶠ[nhds right] 0)
    (hphase : ContDiff Real (⊤ : ℕ∞) phase)
    (hphaseDeriv : ContDiff Real (⊤ : ℕ∞) phaseDeriv)
    (hphaseDeriv_ne : ∀ x, phaseDeriv x ≠ 0)
    (hphase_deriv : ∀ t ∈ uIcc left right, HasDerivAt phase (phaseDeriv t) t)
    (hlower : ∃ c : Real, 0 < c ∧
      ∀ t ∈ Icc left right, c ≤ |phaseDeriv t|) :
    HasRapidDecayRemainder (stationaryOscillatoryIntegral a phase left right) :=
  (nonstationaryRapidDecayData_of_contDiff hleft ha ha_left ha_right hphase
    hphaseDeriv hphaseDeriv_ne hphase_deriv hlower).hasRapidDecayRemainder

/-- A convenient specialization when the actual derivative of the smooth
phase is globally nonzero. -/
def nonstationaryRapidDecayData_of_contDiff_deriv
    {a : Real → Complex} {phase : Real → Real} {left right : Real}
    (hleft : left ≤ right)
    (ha : ContDiff Real (⊤ : ℕ∞) a)
    (ha_left : a =ᶠ[nhds left] 0) (ha_right : a =ᶠ[nhds right] 0)
    (hphase : ContDiff Real (⊤ : ℕ∞) phase)
    (hderiv_ne : ∀ x, deriv phase x ≠ 0)
    (hlower : ∃ c : Real, 0 < c ∧
      ∀ t ∈ Icc left right, c ≤ |deriv phase t|) :
    HasNonstationaryRapidDecayData a phase (deriv phase) left right := by
  apply nonstationaryRapidDecayData_of_contDiff hleft ha ha_left ha_right hphase
    ((contDiff_infty_iff_deriv.mp hphase).2) hderiv_ne
  · intro t ht
    exact ((hphase.differentiable (by simp) t).hasDerivAt)
  · exact hlower

/-- The direct nonstationary rapid-decay corollary under a globally
nonvanishing smooth phase derivative. -/
theorem hasRapidDecayRemainder_of_contDiff_deriv
    {a : Real → Complex} {phase : Real → Real} {left right : Real}
    (hleft : left ≤ right)
    (ha : ContDiff Real (⊤ : ℕ∞) a)
    (ha_left : a =ᶠ[nhds left] 0) (ha_right : a =ᶠ[nhds right] 0)
    (hphase : ContDiff Real (⊤ : ℕ∞) phase)
    (hderiv_ne : ∀ x, deriv phase x ≠ 0)
    (hlower : ∃ c : Real, 0 < c ∧
      ∀ t ∈ Icc left right, c ≤ |deriv phase t|) :
    HasRapidDecayRemainder (stationaryOscillatoryIntegral a phase left right) :=
  (nonstationaryRapidDecayData_of_contDiff_deriv hleft ha ha_left ha_right
    hphase hderiv_ne hlower).hasRapidDecayRemainder

end

end Auto.OneDimStationaryPhase

