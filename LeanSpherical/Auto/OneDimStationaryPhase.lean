/-- The literal oscillatory integral of a complex amplitude against a real
one-dimensional phase on an oriented compact interval. -/
def stationaryOscillatoryIntegral
    (a : Real → Complex) (phase : Real → Real) (left right lambda : Real) : Complex :=
  ∫ s in left..right,
    a s * Complex.exp (((lambda * phase s : Real) : Complex) * Complex.I)

/-- Removes the constant critical phase from a stationary oscillatory
integral.  A quadratic normal form identifies this normalized expression
with the compact quadratic model. -/
def normalizedStationaryOscillatoryIntegral
    (a : Real → Complex) (phase : Real → Real)
    (left right theta lambda : Real) : Complex :=
  Complex.exp (((-(lambda * theta) : Real) : Complex) * Complex.I) *
    stationaryOscillatoryIntegral a phase left right lambda

