/-- The coordinate-free, dimension-generic Mikhlin seminorm condition used in
this development.  Bounding all iterated derivatives through order `N` is a
slightly stronger invariant formulation of the usual multi-index condition.
The factor is interpreted as `1` at order zero. -/
def aux_MikhlinCondition {d : Nat} (N : Nat) (m : Euclidean d → Complex)
    (C : Real) : Prop :=
  ∀ k ≤ N, ∀ ξ : Euclidean d, ξ ≠ 0 →
    ‖ξ‖ ^ k * ‖iteratedFDeriv Real k m ξ‖ ≤ C

/-- The regular dimension-generic Mikhlin condition.  The differentiability
clause is essential: Lean's derivative is totalized, so derivative-size
bounds alone would otherwise permit arbitrary behaviour at points where the
derivative does not exist. -/
def MikhlinCondition {d : Nat} (N : Nat) (m : Euclidean d → Complex)
    (C : Real) : Prop :=
  ContDiffOn Real N m ({0}ᶜ : Set (Euclidean d)) ∧
  aux_MikhlinCondition N m C

/-- A continuous multilinear map on Euclidean space is bounded by its values
on standard-coordinate tuples.  This elementary finite-dimensional estimate
is used to pass from the coordinate form of Mikhlin's hypothesis to the
invariant Fréchet-derivative form. -/
theorem norm_continuousMultilinearMap_le_of_basis_coordinates
    {d n : Nat}
    (T : Euclidean d [×n]→L[Real] Complex)
    {B : Real} (hB : 0 ≤ B)
    (hcoord : ∀ σ : Fin n → Fin d,
      ‖T (fun i => EuclideanSpace.basisFun (Fin d) Real (σ i))‖ ≤ B) :
    ‖T‖ ≤ (d : Real) ^ n * B := by
  classical
  let b : OrthonormalBasis (Fin d) Real (Euclidean d) :=
    EuclideanSpace.basisFun (Fin d) Real
  have hexpand (v : Fin n → Euclidean d) :
      T v = ∑ σ : Fin n → Fin d,
        (∏ i, (b.repr (v i)) (σ i)) • T (fun i => b (σ i)) := by
    calc
      T v = T (fun i => ∑ j, (b.repr (v i)) j • b j) := by
        congr 1
        funext i
        exact (b.sum_repr (v i)).symm
      _ = ∑ σ : Fin n → Fin d,
          T (fun i => (b.repr (v i)) (σ i) • b (σ i)) := by
        rw [T.map_sum]
      _ = ∑ σ : Fin n → Fin d,
          (∏ i, (b.repr (v i)) (σ i)) • T (fun i => b (σ i)) := by
        apply Finset.sum_congr rfl
        intro σ hσ
        rw [T.map_smul_univ]
  refine ContinuousMultilinearMap.opNorm_le_bound ?_ fun v => ?_
  · positivity
  rw [hexpand v]
  calc
    ‖∑ σ : Fin n → Fin d,
        (∏ i, (b.repr (v i)) (σ i)) • T (fun i => b (σ i))‖ ≤
        ∑ σ : Fin n → Fin d,
          ‖(∏ i, (b.repr (v i)) (σ i)) • T (fun i => b (σ i))‖ :=
      norm_sum_le _ _
    _ = ∑ σ : Fin n → Fin d,
        (∏ i, ‖(b.repr (v i)) (σ i)‖) * ‖T (fun i => b (σ i))‖ := by
      apply Finset.sum_congr rfl
      intro σ hσ
      simp only [norm_smul, norm_prod]
    _ ≤ ∑ σ : Fin n → Fin d,
        (∏ i, ‖v i‖) * B := by
      refine Finset.sum_le_sum fun σ hσ => ?_
      have hprod : (∏ i, ‖(b.repr (v i)) (σ i)‖) ≤ ∏ i, ‖v i‖ :=
        Finset.prod_le_prod
          (fun i hi => norm_nonneg _)
          (fun i hi =>
            (PiLp.norm_apply_le (b.repr (v i)) (σ i)).trans_eq (b.repr.norm_map _))
      calc
        (∏ i, ‖(b.repr (v i)) (σ i)‖) * ‖T (fun i => b (σ i))‖ ≤
            (∏ i, ‖(b.repr (v i)) (σ i)‖) * B :=
          mul_le_mul_of_nonneg_left (by simpa [b] using hcoord σ)
            (Finset.prod_nonneg fun i hi => norm_nonneg _)
        _ ≤ (∏ i, ‖v i‖) * B := mul_le_mul_of_nonneg_right hprod hB
    _ = ((d : Real) ^ n * B) * ∏ i, ‖v i‖ := by
      simp [Fintype.card_fin, Nat.cast_pow, mul_assoc, mul_comm, mul_left_comm]

/-- The coordinate-directional version of the finite-order Mikhlin
assumptions. At a smooth point, evaluating the iterated Fréchet derivative on
standard basis vectors is the usual ordered coordinate partial derivative.
The single constant may be chosen as the maximum of the finitely many usual
multi-index seminorm bounds. -/
def CoordinateMikhlinCondition {d : Nat} (N : Nat) (m : Euclidean d → Complex)
    (C : Real) : Prop :=
  0 ≤ C ∧
  ContDiffOn Real N m ({0}ᶜ : Set (Euclidean d)) ∧
  ∀ k ≤ N, ∀ ξ : Euclidean d, ξ ≠ 0 → ∀ σ : Fin k → Fin d,
    ‖ξ‖ ^ k * ‖(iteratedFDeriv Real k m ξ)
      (fun i => EuclideanSpace.basisFun (Fin d) Real (σ i))‖ ≤ C

/-- Coordinate-directional finite-order bounds imply the invariant
Fréchet-derivative formulation used by the Mikhlin construction. -/
theorem coordinateMikhlinCondition_to_mikhlinCondition
    {d N : Nat} [NeZero d] {m : Euclidean d → Complex} {C : Real}
    (h : CoordinateMikhlinCondition N m C) :
    MikhlinCondition N m ((d : Real) ^ N * C) := by
  rcases h with ⟨hC, hcont, hderiv⟩
  refine ⟨hcont, ?_⟩
  intro k hk ξ hξ
  let T : Euclidean d [×k]→L[Real] Complex :=
    (‖ξ‖ ^ k) • iteratedFDeriv Real k m ξ
  have hTcoord : ∀ σ : Fin k → Fin d,
      ‖T (fun i => EuclideanSpace.basisFun (Fin d) Real (σ i))‖ ≤ C := by
    intro σ
    simpa [T, norm_smul, Real.norm_of_nonneg (pow_nonneg (norm_nonneg _) _)] using
      hderiv k hk ξ hξ σ
  have hTnorm : ‖T‖ ≤ (d : Real) ^ k * C :=
    norm_continuousMultilinearMap_le_of_basis_coordinates T hC hTcoord
  have hdNat : 1 ≤ d := (Nat.one_le_iff_ne_zero).2 (NeZero.ne d)
  have hd : (1 : Real) ≤ d := by exact_mod_cast hdNat
  have hpow : (d : Real) ^ k ≤ (d : Real) ^ N := pow_le_pow_right₀ hd hk
  calc
    ‖ξ‖ ^ k * ‖iteratedFDeriv Real k m ξ‖ = ‖T‖ := by
      simp [T, norm_smul, Real.norm_of_nonneg (pow_nonneg (norm_nonneg _) _)]
    _ ≤ (d : Real) ^ k * C := hTnorm
    _ ≤ (d : Real) ^ N * C := mul_le_mul_of_nonneg_right hpow hC

