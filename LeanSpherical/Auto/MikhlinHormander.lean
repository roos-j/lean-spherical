/-- Quantitative Leibniz localization for a punctured Mikhlin symbol.  The
estimate is dimension-generic and keeps the natural weighted derivative
structure explicit, so it can be combined with any fixed annular cutoff
without committing to a planar or `L⁴` specialization. -/
theorem norm_iteratedFDeriv_cutoff_mul_mikhlin_le
    {d N : Nat} (χ m : Euclidean d → Complex) {C : Real}
    (hχ : ContDiff Real N χ) (hm : MikhlinCondition N m C)
    {x : Euclidean d} (hx : x ≠ 0) {n : Nat} (hn : n ≤ N) :
    ‖x‖ ^ n * ‖iteratedFDeriv Real n (fun y => χ y * m y) x‖ ≤
      C * ∑ i ∈ Finset.range (n + 1),
        (n.choose i : Real) * (‖x‖ ^ i * ‖iteratedFDeriv Real i χ x‖) := by
  let s : Set (Euclidean d) := ({0}ᶜ : Set (Euclidean d))
  have hsopen : IsOpen s := by
    simpa only [s] using
      (isOpen_compl_singleton : IsOpen ({0}ᶜ : Set (Euclidean d)))
  have hsunique : UniqueDiffOn Real s := hsopen.uniqueDiffOn
  have hxs : x ∈ s := by simpa [s] using hx
  have hχat : ContDiffAt Real N χ x := hχ.contDiffAt
  have hmat : ContDiffAt Real N m x := hm.1.contDiffAt (hsopen.mem_nhds hxs)
  have hprodat : ContDiffAt Real N (fun y => χ y * m y) x := hχat.mul hmat
  have hwithin := norm_iteratedFDerivWithin_mul_le
    (s := s) hχ.contDiffOn hm.1 hsunique hxs (n := n) (by exact_mod_cast hn)
  have hprodeq : iteratedFDerivWithin Real n (fun y => χ y * m y) s x =
      iteratedFDeriv Real n (fun y => χ y * m y) x :=
    iteratedFDerivWithin_eq_iteratedFDeriv hsunique
      (hprodat.of_le (by exact_mod_cast hn)) hxs
  have hχeq (i : Nat) (hi : i ≤ n) :
      iteratedFDerivWithin Real i χ s x = iteratedFDeriv Real i χ x :=
    iteratedFDerivWithin_eq_iteratedFDeriv hsunique
      (hχat.of_le (by exact_mod_cast (le_trans hi hn))) hxs
  have hmeq (i : Nat) (hi : i ≤ n) :
      iteratedFDerivWithin Real i m s x = iteratedFDeriv Real i m x :=
    iteratedFDerivWithin_eq_iteratedFDeriv hsunique
      (hmat.of_le (by exact_mod_cast (le_trans hi hn))) hxs
  have hprod : ‖iteratedFDeriv Real n (fun y => χ y * m y) x‖ ≤
      ∑ i ∈ Finset.range (n + 1),
        (n.choose i : Real) * ‖iteratedFDeriv Real i χ x‖ *
          ‖iteratedFDeriv Real (n - i) m x‖ := by
    rw [← hprodeq]
    refine hwithin.trans_eq ?_
    apply Finset.sum_congr rfl
    intro i hi
    have hin : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
    rw [hχeq i hin, hmeq (n - i) (Nat.sub_le _ _)]
  calc
    ‖x‖ ^ n * ‖iteratedFDeriv Real n (fun y => χ y * m y) x‖ ≤
        ‖x‖ ^ n * ∑ i ∈ Finset.range (n + 1),
          (n.choose i : Real) * ‖iteratedFDeriv Real i χ x‖ *
            ‖iteratedFDeriv Real (n - i) m x‖ :=
      mul_le_mul_of_nonneg_left hprod (pow_nonneg (norm_nonneg x) _)
    _ = ∑ i ∈ Finset.range (n + 1),
        (n.choose i : Real) * (‖x‖ ^ i * ‖iteratedFDeriv Real i χ x‖) *
          (‖x‖ ^ (n - i) * ‖iteratedFDeriv Real (n - i) m x‖) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i hi
      have hin : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      have hpow : ‖x‖ ^ n = ‖x‖ ^ i * ‖x‖ ^ (n - i) := by
        rw [← pow_add, Nat.add_sub_of_le hin]
      rw [hpow]
      ring
    _ ≤ ∑ i ∈ Finset.range (n + 1),
        C * ((n.choose i : Real) * (‖x‖ ^ i * ‖iteratedFDeriv Real i χ x‖)) := by
      apply Finset.sum_le_sum
      intro i hi
      have hderiv := hm.2 (n - i) (le_trans (Nat.sub_le _ _) hn) x hx
      have hfac : 0 ≤ (n.choose i : Real) *
          (‖x‖ ^ i * ‖iteratedFDeriv Real i χ x‖) := by positivity
      calc
        (n.choose i : Real) * (‖x‖ ^ i * ‖iteratedFDeriv Real i χ x‖) *
            (‖x‖ ^ (n - i) * ‖iteratedFDeriv Real (n - i) m x‖) ≤
            ((n.choose i : Real) * (‖x‖ ^ i * ‖iteratedFDeriv Real i χ x‖)) * C :=
          mul_le_mul_of_nonneg_left hderiv hfac
        _ = C * ((n.choose i : Real) *
            (‖x‖ ^ i * ‖iteratedFDeriv Real i χ x‖)) := by ring
    _ = C * ∑ i ∈ Finset.range (n + 1),
        (n.choose i : Real) * (‖x‖ ^ i * ‖iteratedFDeriv Real i χ x‖) := by
      rw [Finset.mul_sum]

