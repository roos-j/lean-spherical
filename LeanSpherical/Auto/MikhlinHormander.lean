  let Q := continuousMultilinearCurryFin1 Real (Euclidean d) Complex
  have hEq : VectorFourier.fourierSMulRight (-innerSL Real)
      (normalizedIntDyadicMikhlinPiece C m k) = fun v => Q (P v) := by
    funext v
    ext w
    simp [P, Q, VectorFourier.fourierPowSMulRight_apply,
      VectorFourier.fourierSMulRight_apply]
  calc
    ‖iteratedFDeriv Real n
        (VectorFourier.fourierSMulRight (-innerSL Real)
          (normalizedIntDyadicMikhlinPiece C m k)) x‖ =
        ‖iteratedFDeriv Real n P x‖ := by
      rw [hEq]
      simpa only [Function.comp_def] using Q.norm_iteratedFDeriv_comp_left P x n
    _ ≤ _ := deriv_fourierPowSMulRight_normalizedIntDyadicMikhlinPiece_le
      C m hm hA k hn x

theorem tsupport_fourierSMulRight_normalizedIntDyadicMikhlinPiece_subset_unit_annulus
