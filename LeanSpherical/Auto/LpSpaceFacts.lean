      eLpNorm g (ENNReal.ofReal p) μ =
        (∫⁻ x, ENNReal.ofReal ((g x) ^ p) ∂μ) ^ p⁻¹ := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop]
    simp only [ENNReal.toReal_ofReal hp.le, one_div]
    congr 1
