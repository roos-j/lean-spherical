theorem eLpNorm_power_interpolation_of_holder
    {α E : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    {μ : Measure α} {p q r : ENNReal} [ENNReal.HolderTriple p q r]
    {a : Real} (ha : 0 < a) (f : α → E) (hf : AEStronglyMeasurable f μ) :
    (eLpNorm f (r * ENNReal.ofReal (2 * a)) μ) ^ (2 * a) ≤
      (eLpNorm f (p * ENNReal.ofReal a) μ) ^ a *
        (eLpNorm f (q * ENNReal.ofReal a) μ) ^ a := by
  have hpow : AEStronglyMeasurable (fun x => ‖f x‖ ^ a) μ :=
    (hf.norm.aemeasurable.pow_const a).aestronglyMeasurable
  have hholder := eLpNorm_le_eLpNorm_mul_eLpNorm_of_nnnorm
    (p := p) (q := q) (r := r) hpow hpow (fun u v : Real => u * v) 1 (by
      filter_upwards with x
      simp only [nnnorm_mul, one_mul]
      exact le_rfl)
  have hprod : eLpNorm (fun x => (‖f x‖ ^ a) * (‖f x‖ ^ a)) r μ =
      eLpNorm (fun x => ‖f x‖ ^ (2 * a)) r μ := by
    apply eLpNorm_congr_ae
    filter_upwards with x
    by_cases hx : ‖f x‖ = 0
    case pos =>
      rw [hx]
      have htwo : (2 * a : Real) ≠ 0 := by positivity
      simp [Real.zero_rpow ha.ne', Real.zero_rpow htwo]
    case neg =>
