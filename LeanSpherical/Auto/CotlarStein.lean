/-! ### The main estimate -/

/-- **The Cotlar--Stein almost orthogonality lemma.**  If the square roots of the norms of the
products `(T i)* (T k)` have column sums at most `A`, and the square roots of the norms of the
products `(T i) (T k)*` have row sums at most `A`, then the sum `∑ T i` has norm at most `A`. -/
theorem norm_sum_le_of_cotlar_stein (T : ι → (E →L[𝕜] F)) {s : Finset ι} {A : ℝ} (hA : 0 ≤ A)
    (hcol : ∀ i ∈ s, ∑ k ∈ s, Real.sqrt ‖(adjoint (T i)) ∘L (T k)‖ ≤ A)
    (hrow : ∀ i ∈ s, ∑ k ∈ s, Real.sqrt ‖(T i) ∘L (adjoint (T k))‖ ≤ A) :
    ‖∑ i ∈ s, T i‖ ≤ A := by
  have hcol' : ∀ i ∈ s, ∑ k ∈ s, cEntry T i k ≤ A := hcol
  have hrow' : ∀ i ∈ s, ∑ k ∈ s, dEntry T i k ≤ A := hrow
  -- each individual operator has norm at most `A`
  have hdiag : ∀ i ∈ s, ‖T i‖ ≤ A := by
    intro i hi
    have hdd : cEntry T i i = ‖T i‖ := by
      rw [cEntry, ContinuousLinearMap.norm_adjoint_comp_self, Real.sqrt_mul_self (norm_nonneg _)]
    have hle : cEntry T i i ≤ ∑ k ∈ s, cEntry T i k :=
      Finset.single_le_sum (fun k _ => cEntry_nonneg T i k) hi
    rw [hdd] at hle
    exact le_trans hle (hcol' i hi)
  set Tot : E →L[𝕜] F := ∑ i ∈ s, T i with hTot
  set S : E →L[𝕜] E := (adjoint Tot) ∘L Tot with hS
  have hSnorm : ‖S‖ = ‖Tot‖ * ‖Tot‖ := by
    rw [hS]; exact ContinuousLinearMap.norm_adjoint_comp_self Tot
  have hSsa : IsSelfAdjoint S := by
    show star S = S
    rw [ContinuousLinearMap.star_eq_adjoint, hS, ContinuousLinearMap.adjoint_comp,
      ContinuousLinearMap.adjoint_adjoint]
  -- the key bound along powers of two
  have hkey : ∀ k : ℕ, ‖Tot‖ ^ (2 ^ (k + 1)) ≤ (s.card : ℝ) * A ^ (2 ^ (k + 1)) := by
    intro k
    have hpow : ‖S ^ 2 ^ k‖ = ‖S‖ ^ 2 ^ k := hSsa.norm_pow_two_pow k
    have hexpand : S ^ 2 ^ k = ∑ w ∈ wordFinset s (2 ^ k), wordOp T w := by
      rw [hS, hTot]
      exact pow_eq_sum_wordOp T s (2 ^ k)
    obtain ⟨m, hm⟩ : ∃ m : ℕ, 2 ^ k = m + 1 := ⟨2 ^ k - 1, by
      have : 1 ≤ 2 ^ k := Nat.one_le_two_pow
      omega⟩
    have hbound : ‖S ^ 2 ^ k‖ ≤ (s.card : ℝ) * A ^ (2 * 2 ^ k) := by
      rw [hexpand]
      refine le_trans (norm_sum_le _ _) ?_
      refine le_trans (Finset.sum_le_sum fun w _ => norm_wordOp_le_phiBound T w) ?_
      rw [hm]
      exact sum_phiBound_le T hA hcol' hrow' hdiag m
    rw [hpow, hSnorm] at hbound
    have hleft : (‖Tot‖ * ‖Tot‖) ^ 2 ^ k = ‖Tot‖ ^ (2 ^ (k + 1)) := by
      rw [← pow_two, ← pow_mul, pow_succ, mul_comm]
    have hright : 2 * 2 ^ k = 2 ^ (k + 1) := by
      rw [pow_succ, mul_comm]
    rw [hleft, hright] at hbound
    exact hbound
  -- the degenerate case
  rcases eq_or_lt_of_le hA with hA0 | hApos
  · have h := hkey 0
    rw [← hA0] at h
    norm_num at h
    rw [h]
    simpa using hA
  -- conclude by letting the exponent tend to infinity
  by_contra hcon
  rw [not_le] at hcon
  set r : ℝ := ‖Tot‖ / A with hr
  have hr1 : 1 < r := by
    rw [hr, lt_div_iff₀ hApos, one_mul]
    exact hcon
  have hrpow : ∀ k : ℕ, r ^ (2 ^ (k + 1)) ≤ (s.card : ℝ) := by
    intro k
    have h := hkey k
    rw [hr, div_pow, div_le_iff₀ (pow_pos hApos _)]
    exact h
  have hbern : ∀ k : ℕ, 1 + (k + 1 : ℝ) * (r - 1) ≤ (s.card : ℝ) := by
    intro k
    have hmono : r ^ (k + 1) ≤ r ^ (2 ^ (k + 1)) :=
      pow_le_pow_right₀ hr1.le (Nat.le_of_lt Nat.lt_two_pow_self)
    have hb : 1 + (k + 1 : ℝ) * (r - 1) ≤ r ^ (k + 1) := by
      have h := one_add_mul_le_pow (a := r - 1) (by linarith) (k + 1)
      have hone : 1 + (r - 1) = r := by ring
      rw [hone] at h
      push_cast at h
      exact h
    exact le_trans (le_trans hb hmono) (hrpow k)
  obtain ⟨N, hN⟩ := exists_nat_gt (((s.card : ℝ) - 1) / (r - 1))
  have hcontra := hbern N
  have hrm1 : 0 < r - 1 := by linarith
  rw [div_lt_iff₀ hrm1] at hN
  linarith [hcontra, hN, hrm1]

end

