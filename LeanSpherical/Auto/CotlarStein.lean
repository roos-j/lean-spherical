/-! ### The finite set of words -/

/-- The finite set of alternating words of length `n` with letters in `s ×ˢ s`. -/
def wordFinset (s : Finset ι) : ℕ → Finset (List (ι × ι))
  | 0 => {[]}
  | n + 1 => ((s ×ˢ s) ×ˢ wordFinset s n).map
      ⟨fun pw => pw.1 :: pw.2, by
        intro a b hab
        simp only [List.cons.injEq] at hab
        exact Prod.ext hab.1 hab.2⟩

@[simp] theorem wordFinset_zero (s : Finset ι) : wordFinset s 0 = {[]} := rfl

theorem sum_wordFinset_succ {M : Type*} [AddCommMonoid M] (s : Finset ι) (n : ℕ)
    (f : List (ι × ι) → M) :
    ∑ w ∈ wordFinset s (n + 1), f w = ∑ p ∈ s ×ˢ s, ∑ w ∈ wordFinset s n, f (p :: w) := by
  rw [wordFinset, Finset.sum_map, Finset.sum_product]
  rfl

/-! ### Expansion of the `n`-th power into words -/

theorem adjoint_sum_comp_sum (T : ι → (E →L[𝕜] F)) (s : Finset ι) :
    (adjoint (∑ i ∈ s, T i)) ∘L (∑ i ∈ s, T i)
      = ∑ i ∈ s, ∑ j ∈ s, ((adjoint (T i)) ∘L (T j)) := by
  rw [map_sum, sum_comp]
  exact Finset.sum_congr rfl fun i _ => comp_sum s (adjoint (T i)) T

theorem pow_eq_sum_wordOp (T : ι → (E →L[𝕜] F)) (s : Finset ι) (n : ℕ) :
    ((adjoint (∑ i ∈ s, T i)) ∘L (∑ i ∈ s, T i)) ^ n = ∑ w ∈ wordFinset s n, wordOp T w := by
