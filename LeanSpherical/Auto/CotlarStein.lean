  | zero => simp
  | succ n ih =>
      rw [pow_succ', ih, ContinuousLinearMap.mul_def, adjoint_sum_comp_sum,
        sum_wordFinset_succ, Finset.sum_product, sum_comp]
      refine Finset.sum_congr rfl fun i _ => ?_
