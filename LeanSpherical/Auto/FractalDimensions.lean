  have hLpos : 0 < L := by
    dsimp only [L]
    have hδθ : 0 < δ ^ θ := Real.rpow_pos_of_pos hδ θ
    exact hδθ.trans_le hscale
  have hδle : δ ≤ L := by
    have hpow : δ ≤ δ ^ θ := by
      calc
        δ = δ ^ (1 : ℝ) := by rw [Real.rpow_one]
