  change sSup A = sSup B
  exact le_antisymm hA_le_B hB_le_A

/-- The quasi-Assouad dimension is exactly the left limit of the upper
Assouad spectrum at scale parameter one. -/
theorem hasQuasiAssouadDimension :
    ∀ E : Set ℝ, HasQuasiAssouadDimension E (quasiAssouadDimension E) := by
  intro E
  have hmono : MonotoneOn (upperAssouadSpectrum E) (Ioo (0 : ℝ) 1) :=
    fun _ hθ _ hθ' hθθ' =>
      upperAssouadSpectrum_monotoneOn E ⟨hθ.1.le, hθ.2.le⟩
        ⟨hθ'.1.le, hθ'.2.le⟩ hθθ'
  have hlim := MonotoneOn.tendsto_nhdsWithin_Ioo_left
    (f := upperAssouadSpectrum E) (x := (1 : ℝ)) (y := (0 : ℝ))
    (by exact ⟨1 / 2, by norm_num, by norm_num⟩) hmono
    (upperAssouadSpectrum_bddAbove_Ioo E)
  change Tendsto (upperAssouadSpectrum E) (nhdsWithin 1 (Iio 1))
    (𝓝 (quasiAssouadDimension E))
  rw [← sSup_upperAssouadSpectrum_image_Ioo_eq_quasiAssouadDimension E]
  exact hlim

/-- The filter-limit and supremal formulations of quasi-Assouad dimension
are equivalent for the upper spectrum. -/
theorem hasQuasiAssouadDimension_iff
    {E : Set ℝ} {γ : ℝ} :
    HasQuasiAssouadDimension E γ ↔ quasiAssouadDimension E = γ := by
  constructor
  · intro h
    exact tendsto_nhds_unique (hasQuasiAssouadDimension E) h
  · intro h
    rw [← h]
    exact hasQuasiAssouadDimension E

end
