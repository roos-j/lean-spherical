/-!
# Upper Minkowski data for sets of radii

This file records the covering formulation of upper Minkowski dimension used
for compact subsets of the radius interval.  We deliberately use covers by
closed intervals: this is the convention in Anderson--Hughes--Roos--Seeger.
-/
open Set

/-- `F` is covered by the finite family `ι` of closed intervals of radius
`δ / 2`.  Thus every interval in the cover has length `δ`. -/
def IsIntervalCover (F : Set ℝ) (δ : ℝ) (ι : Finset ℝ) : Prop :=
  F ⊆ ⋃ a ∈ ι, Icc (a - δ / 2) (a + δ / 2)

/-- The upper Minkowski covering estimate of exponent `β`.  The harmless
`ε` loss is built into the definition, matching (1.2) of the paper. -/
def HasUpperMinkowskiExponent (F : Set ℝ) (β : ℝ) : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 < C ∧ ∀ δ : ℝ, 0 < δ → δ < 1 →
    ∃ ι : Finset ℝ, IsIntervalCover F δ ι ∧
      (ι.card : ℝ) ≤ C * δ ^ (-(β + ε))

/-- The upper Minkowski dimension, presented as the infimum of admissible
covering exponents.  Formulations below use `HasUpperMinkowskiExponent`
directly, avoiding any need to assume that this infimum is attained. -/
noncomputable def upperMinkowskiDimension (F : Set ℝ) : ℝ :=
  sInf {β : ℝ | 0 ≤ β ∧ HasUpperMinkowskiExponent F β}

/-- Restricting a finite interval cover preserves the cover property. -/
theorem IsIntervalCover.mono {F G : Set ℝ} {δ : ℝ} {ι : Finset ℝ}
    (hFG : F ⊆ G) (hι : IsIntervalCover G δ ι) : IsIntervalCover F δ ι :=
  hFG.trans hι

/-- Upper Minkowski estimates are inherited by subsets. -/
theorem HasUpperMinkowskiExponent.mono {F G : Set ℝ} {β : ℝ}
    (hFG : F ⊆ G) (hG : HasUpperMinkowskiExponent G β) :
    HasUpperMinkowskiExponent F β := by
  intro ε hε
  obtain ⟨C, hC, hcover⟩ := hG ε hε
  refine ⟨C, hC, fun δ hδ hδone => ?_⟩
  obtain ⟨ι, hι, hcard⟩ := hcover δ hδ hδone
  exact ⟨ι, hι.mono hFG, hcard⟩

/-- An upper Minkowski estimate remains true after increasing its exponent. -/
theorem HasUpperMinkowskiExponent.of_le {F : Set ℝ} {β β' : ℝ}
    (hβ : β ≤ β') (hF : HasUpperMinkowskiExponent F β) :
    HasUpperMinkowskiExponent F β' := by
  intro ε hε
  obtain ⟨C, hC, hcover⟩ := hF ε hε
  refine ⟨C, hC, fun δ hδ hδone => ?_⟩
  obtain ⟨ι, hι, hcard⟩ := hcover δ hδ hδone
  refine ⟨ι, hι, hcard.trans ?_⟩
  apply mul_le_mul_of_nonneg_left
  · apply Real.rpow_le_rpow_of_exponent_ge hδ hδone.le
    linarith
  · exact hC.le

/-- The empty set has every upper Minkowski exponent. -/
theorem empty_hasUpperMinkowskiExponent (β : ℝ) :
    HasUpperMinkowskiExponent (∅ : Set ℝ) β := by
  intro ε hε
  refine ⟨1, zero_lt_one, fun δ hδ hδone => ?_⟩
  refine ⟨∅, ?_, ?_⟩
  · exact Set.empty_subset _
  · simp only [Finset.card_empty, Nat.cast_zero]
    exact mul_nonneg zero_le_one (Real.rpow_nonneg hδ.le _)

/-- A finite set has each nonnegative upper Minkowski exponent. -/
theorem finite_hasUpperMinkowskiExponent (F : Set ℝ) (hF : F.Finite)
    {β : ℝ} (hβ : 0 ≤ β) : HasUpperMinkowskiExponent F β := by
  intro ε hε
  let ι : Finset ℝ := hF.toFinset
  refine ⟨(ι.card : ℝ) + 1, by positivity, fun δ hδ hδone => ?_⟩
  refine ⟨ι, ?_, ?_⟩
  · intro x hx
    have hxι : x ∈ ι := by
      simpa only [ι, Set.Finite.mem_toFinset] using hx
    refine Set.mem_iUnion.2 ⟨x, Set.mem_iUnion.2 ⟨hxι, ?_⟩⟩
    constructor <;> nlinarith [hδ.le]
  · have hpow : 1 ≤ δ ^ (-(β + ε)) := by
      apply Real.one_le_rpow_of_pos_of_le_one_of_nonpos hδ hδone.le
      linarith
    calc
      (ι.card : ℝ) ≤ (ι.card : ℝ) + 1 := by linarith
      _ ≤ ((ι.card : ℝ) + 1) * δ ^ (-(β + ε)) := by
        exact le_mul_of_one_le_right (by positivity) hpow
