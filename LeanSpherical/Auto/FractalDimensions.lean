/-!
# Upper Assouad spectrum and quasi-Assouad dimension

Unlike the equality-scale spectrum in the original paper, we use the *upper*
Assouad spectrum: intervals of every length at least `δ ^ θ` are allowed.
For radius sets contained in `[1, 2]`, restricting these intervals to length at
most one makes the `θ = 0` case the usual global covering estimate rather than
a vacuous condition.  The quasi-Assouad dimension is the limiting (equivalently,
for the upper spectrum, supremal) value as `θ → 1`.
-/
open Set Filter
open scoped Topology

/-- Upper Assouad-spectrum covering estimate.  The condition
`δ ^ θ ≤ |I| ≤ 1` is the requested upper-spectrum variant; it replaces the
equality `|I| = δ ^ θ` in the spectrum used in the cited paper.  The exponent
is exact here; the infimum in `upperAssouadSpectrum` supplies the familiar
arbitrarily small loss. -/
def HasUpperAssouadSpectrumExponent (F : Set ℝ) (θ γ : ℝ) : Prop :=
  ∃ C : ℝ, 0 < C ∧ ∀ δ a b : ℝ, 0 < δ → δ < 1 → 1 ≤ a → a ≤ b → b ≤ 2 →
    δ ^ θ ≤ b - a → ∃ ι : Finset ℝ, IsIntervalCover (F ∩ Icc a b) δ ι ∧
      (ι.card : ℝ) ≤ C * ((b - a) / δ) ^ γ

/-- The upper Assouad spectrum at scale parameter `θ`. -/
noncomputable def upperAssouadSpectrum (F : Set ℝ) (θ : ℝ) : ℝ :=
  sInf {γ : ℝ | 0 ≤ γ ∧ HasUpperAssouadSpectrumExponent F θ γ}

/-- Restricting the radius set preserves an upper-spectrum estimate. -/
theorem HasUpperAssouadSpectrumExponent.mono {F G : Set ℝ} {θ γ : ℝ}
    (hFG : F ⊆ G) (hG : HasUpperAssouadSpectrumExponent G θ γ) :
    HasUpperAssouadSpectrumExponent F θ γ := by
  obtain ⟨C, hC, hcover⟩ := hG
  refine ⟨C, hC, fun δ a b hδ hδone ha hab hb hscale => ?_⟩
  obtain ⟨ι, hι, hcard⟩ := hcover δ a b hδ hδone ha hab hb hscale
  exact ⟨ι, hι.mono (inter_subset_inter_left _ hFG), hcard⟩

/-- On the usual spectrum range `0 ≤ θ ≤ 1`, an estimate at an exponent
also holds at every larger exponent. -/
theorem HasUpperAssouadSpectrumExponent.of_le
    {F : Set ℝ} {θ γ γ' : ℝ} (_hθ : 0 ≤ θ) (hθone : θ ≤ 1)
    (hγ : γ ≤ γ') (hF : HasUpperAssouadSpectrumExponent F θ γ) :
    HasUpperAssouadSpectrumExponent F θ γ' := by
  obtain ⟨C, hC, hcover⟩ := hF
  refine ⟨C, hC, fun δ a b hδ hδone ha hab hb hscale => ?_⟩
  obtain ⟨ι, hι, hcard⟩ := hcover δ a b hδ hδone ha hab hb hscale
  refine ⟨ι, hι, hcard.trans ?_⟩
  apply mul_le_mul_of_nonneg_left
  · have hpow : δ ≤ δ ^ θ := by
      calc
        δ = δ ^ (1 : ℝ) := by simp
        _ ≤ δ ^ θ := Real.rpow_le_rpow_of_exponent_ge hδ hδone.le hθone
    have hratio : 1 ≤ (b - a) / δ := by
      rw [le_div_iff₀ hδ]
      nlinarith [hpow.trans hscale]
    exact Real.rpow_le_rpow_of_exponent_le hratio hγ
  · exact hC.le

/-- Increasing the spectrum parameter asks for estimates on more intervals.
Consequently an estimate at the larger parameter can be restricted to the
smaller one. -/
theorem HasUpperAssouadSpectrumExponent.restrict_parameter
    {F : Set ℝ} {θ θ' γ : ℝ} (hθ : θ ≤ θ')
    (hF : HasUpperAssouadSpectrumExponent F θ' γ) :
    HasUpperAssouadSpectrumExponent F θ γ := by
  obtain ⟨C, hC, hcover⟩ := hF
  refine ⟨C, hC, fun δ a b hδ hδone ha hab hb hscale => ?_⟩
  apply hcover δ a b hδ hδone ha hab hb
  calc
    δ ^ θ' ≤ δ ^ θ := Real.rpow_le_rpow_of_exponent_ge hδ hδone.le hθ
    _ ≤ b - a := hscale

/-- The empty set has every nonnegative upper-spectrum exponent. -/
theorem empty_hasUpperAssouadSpectrumExponent (θ γ : ℝ) :
    HasUpperAssouadSpectrumExponent (∅ : Set ℝ) θ γ := by
  refine ⟨1, zero_lt_one, fun δ a b hδ hδone ha hab hb hscale => ?_⟩
  refine ⟨∅, ?_, ?_⟩
  · simp [IsIntervalCover]
  simp only [Finset.card_empty, Nat.cast_zero]
  exact mul_nonneg zero_le_one (Real.rpow_nonneg (by positivity) _)

/-- The quasi-Assouad dimension.  The upper spectrum is increasing in the
scale parameter, so this supremum is its left limit at `1`.  Defining it this
way avoids assigning an arbitrary value before that monotonicity theorem is
used. -/
noncomputable def quasiAssouadDimension (F : Set ℝ) : ℝ :=
  sSup (upperAssouadSpectrum F '' Ico (0 : ℝ) 1)

/-- The filter formulation of the assertion that `γ` is the quasi-Assouad
dimension.  This is useful when the proof needs to choose a parameter `θ`
arbitrarily close to one. -/
def HasQuasiAssouadDimension (F : Set ℝ) (γ : ℝ) : Prop :=
  Tendsto (fun θ : ℝ => upperAssouadSpectrum F θ) (nhdsWithin 1 (Iio 1)) (𝓝 γ)

/-- The regularity hypothesis used for sharpness, with `γ` interpreted as
quasi-Assouad dimension rather than the full Assouad dimension. -/
def IsQuasiAssouadRegular (F : Set ℝ) (β γ : ℝ) : Prop :=
  upperMinkowskiDimension F = β ∧ quasiAssouadDimension F = γ ∧
    (γ = 0 ∨ ∀ θ : ℝ, 0 ≤ θ → θ < 1 → 1 - β / γ < θ →
      upperAssouadSpectrum F θ = γ)
