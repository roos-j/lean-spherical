theorem unitMultiplicativeEntropy_mono {E F : Set ℝ} (hEF : E ⊆ F)
    (δ : ℝ≥0) :
    unitMultiplicativeEntropy E δ ≤ unitMultiplicativeEntropy F δ := by
  apply iSup_mono
  intro c
  exact localMultiplicativeEntropy_mono hEF c 1 δ

