/-- **The bathtub principle** for the Riesz kernel: among sets of a given finite measure, the ball
centred at `s` maximizes the integral of the decreasing kernel `|s - ·|^{-λ}`. -/
theorem lintegral_rk_le_ball {lam : ℝ} (hlam0 : 0 < lam) {B : Set ℝ} (hB : MeasurableSet B)
    (hBfin : volume B ≠ ⊤) (s : ℝ) :
    (∫⁻ u in B, ‖s - u‖ₑ ^ (-lam))
      ≤ ∫⁻ u in Metric.ball s ((volume B).toReal / 2), ‖s - u‖ₑ ^ (-lam) := by
  set R : ℝ := (volume B).toReal / 2 with hRdef
  have hRnn : 0 ≤ R := by
    rw [hRdef]
    positivity
  rcases eq_or_lt_of_le hRnn with hR0 | hRpos
  · -- degenerate: `B` is null
    have hv : volume B = 0 := by
      have h1 : (volume B).toReal = 0 := by
        rw [hRdef] at hR0
        linarith
      exact (ENNReal.toReal_eq_zero_iff _).mp h1 |>.resolve_right hBfin
    have : (∫⁻ u in B, ‖s - u‖ₑ ^ (-lam)) = 0 := setLIntegral_measure_zero _ _ hv
    rw [this]
    exact zero_le
  · set K : ℝ≥0∞ := (ENNReal.ofReal R) ^ (-lam) with hKdef
    have hballmeas : MeasurableSet (Metric.ball s R) := measurableSet_ball
    have hvball : volume (Metric.ball s R) = volume B := by
      rw [Real.volume_ball, hRdef]
      rw [show 2 * ((volume B).toReal / 2) = (volume B).toReal by ring]
      exact ENNReal.ofReal_toReal hBfin
    -- the four pieces
    have hsplitB : (∫⁻ u in B, ‖s - u‖ₑ ^ (-lam))
        = (∫⁻ u in B ∩ Metric.ball s R, ‖s - u‖ₑ ^ (-lam))
          + ∫⁻ u in B \ Metric.ball s R, ‖s - u‖ₑ ^ (-lam) := by
      rw [← lintegral_inter_add_diff (μ := volume) _ B hballmeas]
    have hsplitBall : (∫⁻ u in Metric.ball s R, ‖s - u‖ₑ ^ (-lam))
        = (∫⁻ u in Metric.ball s R ∩ B, ‖s - u‖ₑ ^ (-lam))
          + ∫⁻ u in Metric.ball s R \ B, ‖s - u‖ₑ ^ (-lam) := by
      rw [← lintegral_inter_add_diff (μ := volume) _ (Metric.ball s R) hB]
    have hinter : B ∩ Metric.ball s R = Metric.ball s R ∩ B := Set.inter_comm _ _
    -- the measures of the two symmetric differences agree
    have hmeasfin : volume (B ∩ Metric.ball s R) ≠ ⊤ :=
      ne_top_of_le_ne_top hBfin (measure_mono Set.inter_subset_left)
    have hdiffeq : volume (B \ Metric.ball s R) = volume (Metric.ball s R \ B) := by
      have h1 : volume (B ∩ Metric.ball s R) + volume (B \ Metric.ball s R) = volume B :=
        measure_inter_add_diff _ hballmeas
      have h2 : volume (Metric.ball s R ∩ B) + volume (Metric.ball s R \ B)
          = volume (Metric.ball s R) := measure_inter_add_diff _ hB
      rw [← hinter, hvball] at h2
      have := h1.trans h2.symm
      exact WithTop.add_left_cancel hmeasfin this
    -- the two tail integrals compare
    have htail : (∫⁻ u in B \ Metric.ball s R, ‖s - u‖ₑ ^ (-lam))
        ≤ ∫⁻ u in Metric.ball s R \ B, ‖s - u‖ₑ ^ (-lam) := by
      have hup : (∫⁻ u in B \ Metric.ball s R, ‖s - u‖ₑ ^ (-lam))
          ≤ K * volume (B \ Metric.ball s R) := by
        rw [← setLIntegral_const (B \ Metric.ball s R) K]
        refine setLIntegral_mono' (hB.diff hballmeas) ?_
        intro u hu
        exact rk_le_of_notMem_ball (le_of_lt hlam0) hu.2
      have hlow : K * volume (Metric.ball s R \ B)
          ≤ ∫⁻ u in Metric.ball s R \ B, ‖s - u‖ₑ ^ (-lam) := by
        rw [← setLIntegral_const (Metric.ball s R \ B) K]
        refine setLIntegral_mono' (hballmeas.diff hB) ?_
        intro u hu
        exact rk_ge_of_mem_ball (le_of_lt hlam0) hu.1
      rw [hdiffeq] at hup
      exact le_trans hup hlow
    rw [hsplitB, hsplitBall, hinter]
    exact add_le_add (le_refl _) htail

/-- The Riesz kernel over an arbitrary measurable set. -/
theorem lintegral_rk_set_le {lam : ℝ} (hlam0 : 0 < lam) (hlam1 : lam < 1) {B : Set ℝ}
    (hB : MeasurableSet B) (s : ℝ) :
    (∫⁻ u in B, ‖s - u‖ₑ ^ (-lam))
      ≤ ENNReal.ofReal (2 / (1 - lam)) * (volume B) ^ (1 - lam) := by
  have hlpos : (0 : ℝ) < 1 - lam := by linarith
  by_cases hBfin : volume B = ⊤
  · have htop : (volume B) ^ (1 - lam) = ⊤ := by
      rw [hBfin]
      exact ENNReal.top_rpow_of_pos hlpos
    have hne : ENNReal.ofReal (2 / (1 - lam)) ≠ 0 := by
      rw [ne_eq, ENNReal.ofReal_eq_zero, not_le]
      positivity
    rw [htop, ENNReal.mul_top hne]
    exact le_top
  · set R : ℝ := (volume B).toReal / 2 with hRdef
    have hRnn : 0 ≤ R := by rw [hRdef]; positivity
    rcases eq_or_lt_of_le hRnn with hR0 | hRpos
    · have hv : volume B = 0 := by
        have h1 : (volume B).toReal = 0 := by rw [hRdef] at hR0; linarith
        exact (ENNReal.toReal_eq_zero_iff _).mp h1 |>.resolve_right hBfin
      rw [setLIntegral_measure_zero _ _ hv]
      exact zero_le
    · refine le_trans (lintegral_rk_le_ball hlam0 hB hBfin s) ?_
      refine le_trans (lintegral_rk_ball hlam0 hlam1 hRpos s) ?_
      have hvtnn : 0 ≤ (volume B).toReal := ENNReal.toReal_nonneg
      have hrpow : (volume B) ^ (1 - lam)
          = ENNReal.ofReal (((volume B).toReal) ^ (1 - lam)) := by
        rw [← ENNReal.ofReal_rpow_of_nonneg hvtnn (le_of_lt hlpos),
          ENNReal.ofReal_toReal hBfin]
      rw [hrpow, ← ENNReal.ofReal_mul (by positivity)]
      refine ENNReal.ofReal_le_ofReal ?_
      have hhalf : R ^ (1 - lam) ≤ ((volume B).toReal) ^ (1 - lam) := by
        refine Real.rpow_le_rpow hRnn ?_ (le_of_lt hlpos)
        rw [hRdef]
        linarith
      have hnn : (0 : ℝ) ≤ ((volume B).toReal) ^ (1 - lam) := Real.rpow_nonneg hvtnn _
      have h2 : (0 : ℝ) < 2 / (1 - lam) := by positivity
      calc 2 * (R ^ (1 - lam) / (1 - lam))
          = (2 / (1 - lam)) * R ^ (1 - lam) := by ring
        _ ≤ (2 / (1 - lam)) * ((volume B).toReal) ^ (1 - lam) :=
            mul_le_mul_of_nonneg_left hhalf (le_of_lt h2)

/-- The kernel over a product of sets, in the two symmetric forms. -/
theorem lintegral_prod_rk_le {lam : ℝ} (hlam0 : 0 < lam) (hlam1 : lam < 1) {A B : Set ℝ}
    (hA : MeasurableSet A) (hB : MeasurableSet B) :
    (∫⁻ s in A, ∫⁻ u in B, ‖s - u‖ₑ ^ (-lam))
      ≤ ENNReal.ofReal (2 / (1 - lam)) * ((volume B) ^ (1 - lam) * volume A) := by
  calc (∫⁻ s in A, ∫⁻ u in B, ‖s - u‖ₑ ^ (-lam))
      ≤ ∫⁻ _s in A, ENNReal.ofReal (2 / (1 - lam)) * (volume B) ^ (1 - lam) :=
        lintegral_mono fun s => lintegral_rk_set_le hlam0 hlam1 hB s
    _ = ENNReal.ofReal (2 / (1 - lam)) * (volume B) ^ (1 - lam) * volume A := by
        rw [setLIntegral_const]
    _ = ENNReal.ofReal (2 / (1 - lam)) * ((volume B) ^ (1 - lam) * volume A) := by
        rw [mul_assoc]

theorem lintegral_prod_rk_swap {A B : Set ℝ}
    (hA : MeasurableSet A) (hB : MeasurableSet B) (lamr : ℝ) :
    (∫⁻ s in A, ∫⁻ u in B, ‖s - u‖ₑ ^ (-lamr))
      = ∫⁻ u in B, ∫⁻ s in A, ‖s - u‖ₑ ^ (-lamr) := by
  have hm : AEMeasurable (fun p : ℝ × ℝ => ‖p.1 - p.2‖ₑ ^ (-lamr))
      ((volume.restrict A).prod (volume.restrict B)) := by
    refine Measurable.aemeasurable ?_
    exact ((measurable_fst.sub measurable_snd).enorm).pow_const _
  exact lintegral_lintegral_swap hm

theorem lintegral_prod_rk_le' {lam : ℝ} (hlam0 : 0 < lam) (hlam1 : lam < 1) {A B : Set ℝ}
    (hA : MeasurableSet A) (hB : MeasurableSet B) :
    (∫⁻ s in A, ∫⁻ u in B, ‖s - u‖ₑ ^ (-lam))
      ≤ ENNReal.ofReal (2 / (1 - lam)) * ((volume A) ^ (1 - lam) * volume B) := by
  rw [lintegral_prod_rk_swap hA hB lam]
  have hsymm : ∀ u : ℝ, (∫⁻ s in A, ‖s - u‖ₑ ^ (-lam))
      = ∫⁻ s in A, ‖u - s‖ₑ ^ (-lam) := by
    intro u
    refine setLIntegral_congr_fun hA ?_
    intro s _
    show ‖s - u‖ₑ ^ (-lam) = ‖u - s‖ₑ ^ (-lam)
    rw [show ‖s - u‖ₑ = ‖u - s‖ₑ by rw [← enorm_neg (s - u), neg_sub]]
  calc (∫⁻ u in B, ∫⁻ s in A, ‖s - u‖ₑ ^ (-lam))
      = ∫⁻ u in B, ∫⁻ s in A, ‖u - s‖ₑ ^ (-lam) := by
        refine lintegral_congr fun u => ?_
        exact hsymm u
    _ ≤ ENNReal.ofReal (2 / (1 - lam)) * ((volume A) ^ (1 - lam) * volume B) :=
        lintegral_prod_rk_le hlam0 hlam1 hB hA

end Kernel

/-! ## Dyadic level sets -/

section LevelSets

/-- The dyadic value `2^m`, kept as `ENNReal.ofReal` of a real power so that all the exponent
arithmetic happens in `ℝ`. -/
noncomputable def dy (m : ℤ) : ℝ≥0∞ := ENNReal.ofReal ((2 : ℝ) ^ m)

theorem dy_pos (m : ℤ) : 0 < dy m := by
  rw [dy, ENNReal.ofReal_pos]
  positivity

theorem dy_ne_zero (m : ℤ) : dy m ≠ 0 := (dy_pos m).ne'

theorem dy_ne_top (m : ℤ) : dy m ≠ ⊤ := by
  rw [dy]
  exact ENNReal.ofReal_ne_top

theorem dy_succ (m : ℤ) : dy (m + 1) = 2 * dy m := by
  rw [dy, dy, show (2 : ℝ) ^ (m + 1) = 2 * (2 : ℝ) ^ m by
    rw [zpow_add₀ (two_ne_zero), zpow_one]; ring]
  rw [ENNReal.ofReal_mul (by norm_num : (0:ℝ) ≤ 2)]
  congr 1
  rw [show (2:ℝ) = ((2:ℕ):ℝ) by norm_num, ENNReal.ofReal_natCast]
  norm_num

theorem dy_rpow (m : ℤ) (t : ℝ) :
    (dy m) ^ t = ENNReal.ofReal ((2 : ℝ) ^ ((m : ℝ) * t)) := by
  rw [dy, ENNReal.ofReal_rpow_of_pos (by positivity : (0:ℝ) < (2:ℝ) ^ m)]
  congr 1
  rw [← Real.rpow_intCast (2 : ℝ) m, ← Real.rpow_mul (by norm_num : (0:ℝ) ≤ 2)]

/-- Every finite nonzero extended real lies in a unique dyadic bracket. -/
theorem exists_dyadic_bracket {x : ℝ≥0∞} (hx0 : x ≠ 0) (hxt : x ≠ ⊤) :
    ∃ m : ℤ, dy m ≤ x ∧ x < dy (m + 1) := by
  have hcpos : 0 < x.toReal := ENNReal.toReal_pos hx0 hxt
  set m : ℤ := ⌊Real.logb 2 x.toReal⌋ with hm
  have h1 : (2 : ℝ) ^ m ≤ x.toReal := by
    have hle : (m : ℝ) ≤ Real.logb 2 x.toReal := by
      rw [hm]; exact Int.floor_le _
    have hmono : (2 : ℝ) ^ ((m : ℝ)) ≤ (2 : ℝ) ^ (Real.logb 2 x.toReal) :=
      Real.rpow_le_rpow_of_exponent_le (by norm_num) hle
    rw [Real.rpow_logb (by norm_num) (by norm_num) hcpos] at hmono
    rwa [Real.rpow_intCast] at hmono
  have h2 : x.toReal < (2 : ℝ) ^ (m + 1) := by
    have hlt : Real.logb 2 x.toReal < (m : ℝ) + 1 := by
      rw [hm]
      exact Int.lt_floor_add_one _
    have hmono : (2 : ℝ) ^ (Real.logb 2 x.toReal) < (2 : ℝ) ^ ((m : ℝ) + 1) :=
      Real.rpow_lt_rpow_of_exponent_lt (by norm_num) hlt
    rw [Real.rpow_logb (by norm_num) (by norm_num) hcpos] at hmono
    have hcast : ((m + 1 : ℤ) : ℝ) = (m : ℝ) + 1 := by push_cast; ring
    rwa [← hcast, Real.rpow_intCast] at hmono
  refine ⟨m, ?_, ?_⟩
  · rw [dy, ← ENNReal.ofReal_toReal hxt]
    exact ENNReal.ofReal_le_ofReal h1
  · rw [dy, ← ENNReal.ofReal_toReal hxt]
    exact ENNReal.ofReal_lt_ofReal_iff_of_nonneg ENNReal.toReal_nonneg |>.mpr h2

/-- The `m`-th dyadic level set of `f`. -/
def lvl (f : ℝ → ℝ≥0∞) (m : ℤ) : Set ℝ := {s | dy m ≤ f s ∧ f s < dy (m + 1)}

theorem measurableSet_lvl {f : ℝ → ℝ≥0∞} (hf : Measurable f) (m : ℤ) :
    MeasurableSet (lvl f m) := by
  have h1 : MeasurableSet {s | dy m ≤ f s} := measurableSet_le measurable_const hf
  have h2 : MeasurableSet {s | f s < dy (m + 1)} := measurableSet_lt hf measurable_const
  exact h1.inter h2

/-- The pointwise domination by the level-set decomposition. -/
theorem le_tsum_lvl {f : ℝ → ℝ≥0∞} {s : ℝ} (hs : f s ≠ ⊤) :
    f s ≤ ∑' m : ℤ, 2 * dy m * (lvl f m).indicator (fun _ => (1 : ℝ≥0∞)) s := by
  rcases eq_or_ne (f s) 0 with h0 | h0
  · rw [h0]
    exact zero_le
  · obtain ⟨m, hm1, hm2⟩ := exists_dyadic_bracket h0 hs
    have hmem : s ∈ lvl f m := ⟨hm1, hm2⟩
    have hterm : 2 * dy m * (lvl f m).indicator (fun _ => (1 : ℝ≥0∞)) s = 2 * dy m := by
      rw [Set.indicator_of_mem hmem, mul_one]
    refine le_trans ?_ (ENNReal.le_tsum m)
    rw [hterm, ← dy_succ]
    exact le_of_lt hm2

/-- The measure of a level set is controlled by the `r`-th moment. -/
theorem dy_rpow_mul_measure_lvl_le {f : ℝ → ℝ≥0∞} (hf : Measurable f) {r : ℝ} (hr : 0 < r)
    (m : ℤ) :
    (dy m) ^ r * volume (lvl f m) ≤ ∫⁻ s in lvl f m, f s ^ r := by
  rw [← setLIntegral_const (lvl f m) ((dy m) ^ r)]
  refine setLIntegral_mono' (measurableSet_lvl hf m) ?_
  intro s hs
  exact ENNReal.rpow_le_rpow hs.1 (le_of_lt hr)

theorem tsum_dy_rpow_mul_measure_lvl_le {f : ℝ → ℝ≥0∞} (hf : Measurable f) {r : ℝ}
    (hr : 0 < r) :
    (∑' m : ℤ, (dy m) ^ r * volume (lvl f m)) ≤ ∫⁻ s, f s ^ r := by
  have hdisj : Pairwise (Function.onFun Disjoint (lvl f)) := by
    intro m n hmn
    rw [Function.onFun, Set.disjoint_left]
    intro s hs hs'
    rcases lt_or_gt_of_ne hmn with hlt | hgt
    · have h1 : dy (m + 1) ≤ dy n := by
        rw [dy, dy]
        refine ENNReal.ofReal_le_ofReal ?_
        exact zpow_le_zpow_right₀ (by norm_num) (by omega)
      exact absurd hs.2 (not_lt.mpr (le_trans h1 hs'.1))
    · have h1 : dy (n + 1) ≤ dy m := by
        rw [dy, dy]
        refine ENNReal.ofReal_le_ofReal ?_
        exact zpow_le_zpow_right₀ (by norm_num) (by omega)
      exact absurd hs'.2 (not_lt.mpr (le_trans h1 hs.1))
  have hsum : (∑' m : ℤ, ∫⁻ s in lvl f m, f s ^ r) ≤ ∫⁻ s, f s ^ r := by
    rw [← lintegral_iUnion (fun m => measurableSet_lvl hf m) hdisj]
    exact lintegral_mono_set (Set.subset_univ _) |>.trans_eq (by rw [Measure.restrict_univ])
  refine le_trans (ENNReal.tsum_le_tsum fun m => ?_) hsum
  exact dy_rpow_mul_measure_lvl_le hf hr m

end LevelSets

/-! ## The two-sided geometric sum over `ℤ` -/

section GeomZ

/-- `ℕ` enumerates the nonnegative integers. -/
def natToIci : ℕ ≃ (Set.Ici (0 : ℤ)) where
  toFun n := ⟨(n : ℤ), by simp⟩
  invFun x := (x : ℤ).toNat
  left_inv n := by simp
  right_inv x := by
    refine Subtype.ext ?_
    exact Int.toNat_of_nonneg x.2

/-- `ℕ` enumerates the negative integers. -/
def natToIio : ℕ ≃ (Set.Iio (0 : ℤ)) where
  toFun n := ⟨-((n : ℤ) + 1), by simp only [Set.mem_Iio]; omega⟩
  invFun x := (-(x : ℤ) - 1).toNat
  left_inv n := by
    simp only []
    omega
  right_inv x := by
    refine Subtype.ext ?_
    have hx : (x : ℤ) < 0 := x.2
    simp only []
    omega

theorem tsum_geoZ_le {ρ : ℝ≥0∞} (hρ : ρ ≤ 1) :
    (∑' k : ℤ, ρ ^ (k.natAbs)) ≤ 2 * (1 - ρ)⁻¹ := by
  have huniv : (Set.Ici (0 : ℤ)) ∪ (Set.Iio (0 : ℤ)) = Set.univ := by
    ext k
    simp only [Set.mem_union, Set.mem_Ici, Set.mem_Iio, Set.mem_univ, iff_true]
    omega
  have h1 : (∑' k : ℤ, ρ ^ (k.natAbs))
      = ∑' x : (Set.univ : Set ℤ), ρ ^ ((x : ℤ).natAbs) := (tsum_univ _).symm
  have h2 : (∑' x : (Set.univ : Set ℤ), ρ ^ ((x : ℤ).natAbs))
      ≤ (∑' x : (Set.Ici (0 : ℤ)), ρ ^ ((x : ℤ).natAbs))
        + ∑' x : (Set.Iio (0 : ℤ)), ρ ^ ((x : ℤ).natAbs) := by
    rw [← huniv]
    exact ENNReal.tsum_union_le (fun k : ℤ => ρ ^ k.natAbs) _ _
  have h3 : (∑' x : (Set.Ici (0 : ℤ)), ρ ^ ((x : ℤ).natAbs)) = ∑' j : ℕ, ρ ^ j := by
    rw [← natToIci.tsum_eq (fun x : (Set.Ici (0 : ℤ)) => ρ ^ ((x : ℤ).natAbs))]
    refine tsum_congr fun j => ?_
    congr 1
  have h4 : (∑' x : (Set.Iio (0 : ℤ)), ρ ^ ((x : ℤ).natAbs)) = ∑' j : ℕ, ρ ^ (j + 1) := by
    rw [← natToIio.tsum_eq (fun x : (Set.Iio (0 : ℤ)) => ρ ^ ((x : ℤ).natAbs))]
    refine tsum_congr fun j => ?_
    congr 1
  rw [h1]
  refine le_trans h2 ?_
  rw [h3, h4, ENNReal.tsum_geometric, ENNReal.tsum_geometric_add_one, two_mul]
  refine add_le_add (le_refl _) ?_
  exact mul_le_of_le_one_left' hρ

/-- Translating the index does not change a `ℤ`-indexed sum. -/
theorem tsum_shift (f : ℤ → ℝ≥0∞) (m : ℤ) : (∑' n : ℤ, f (m - n)) = ∑' k : ℤ, f k :=
  (Equiv.subLeft m).tsum_eq f

end GeomZ

/-! ## Assembling the double sum -/

section Assembly

/-- Restricting a product integral to a product of sets. -/
theorem lintegral_prod_indicator_mul {Am Bn : Set ℝ} (hA : MeasurableSet Am)
    (hB : MeasurableSet Bn) (Kf : ℝ → ℝ → ℝ≥0∞)
    (hK : ∀ s : ℝ, Measurable (Kf s)) :
    (∫⁻ s, ∫⁻ u, Kf s u
        * (Am.indicator (fun _ => (1 : ℝ≥0∞)) s * Bn.indicator (fun _ => (1 : ℝ≥0∞)) u))
      = ∫⁻ s in Am, ∫⁻ u in Bn, Kf s u := by
  have hinner : ∀ s : ℝ, (∫⁻ u, Kf s u
      * (Am.indicator (fun _ => (1 : ℝ≥0∞)) s * Bn.indicator (fun _ => (1 : ℝ≥0∞)) u))
      = Am.indicator (fun _ => (1 : ℝ≥0∞)) s * ∫⁻ u in Bn, Kf s u := by
    intro s
    have hpt : ∀ u : ℝ, Kf s u
        * (Am.indicator (fun _ => (1 : ℝ≥0∞)) s * Bn.indicator (fun _ => (1 : ℝ≥0∞)) u)
        = Am.indicator (fun _ => (1 : ℝ≥0∞)) s * Bn.indicator (fun u' => Kf s u') u := by
      intro u
      by_cases hu : u ∈ Bn
      · rw [Set.indicator_of_mem hu, Set.indicator_of_mem hu, mul_one]
        ring
      · rw [Set.indicator_of_notMem hu, Set.indicator_of_notMem hu]
        simp
    have hne : Am.indicator (fun _ => (1 : ℝ≥0∞)) s ≠ ⊤ := by
      by_cases hs : s ∈ Am
      · rw [Set.indicator_of_mem hs]
        exact ENNReal.one_ne_top
      · rw [Set.indicator_of_notMem hs]
        exact ENNReal.zero_ne_top
    rw [lintegral_congr hpt, lintegral_const_mul' _ _ hne, lintegral_indicator hB]
  rw [lintegral_congr hinner]
  have hfun : (fun s => Am.indicator (fun _ => (1 : ℝ≥0∞)) s * ∫⁻ u in Bn, Kf s u)
      = Am.indicator (fun s => ∫⁻ u in Bn, Kf s u) := by
    funext s
    by_cases hs : s ∈ Am
    · rw [Set.indicator_of_mem hs, Set.indicator_of_mem hs, one_mul]
    · rw [Set.indicator_of_notMem hs, Set.indicator_of_notMem hs, zero_mul]
  rw [hfun, lintegral_indicator hA]

theorem ofReal_two_rpow_pow (a : ℝ) (k : ℕ) :
    ENNReal.ofReal ((2 : ℝ) ^ a) ^ k = ENNReal.ofReal ((2 : ℝ) ^ (a * (k : ℝ))) := by
  rw [← ENNReal.ofReal_pow (by positivity), ← Real.rpow_natCast ((2 : ℝ) ^ a) k,
    ← Real.rpow_mul (by norm_num : (0:ℝ) ≤ 2)]

/-- The `(m,n)` term estimated with the `B`-side bathtub bound. -/
theorem term_bound_left {lam : ℝ} (hlam0 : 0 < lam) (hlam1 : lam < 1) (m n : ℤ)
    (am bn : ℝ≥0∞) (hyn1 : (dy n) ^ (2 / (2 - lam)) * bn ≤ 1) :
    dy m * dy n * (bn ^ (1 - lam) * am)
      ≤ ENNReal.ofReal ((2 : ℝ) ^ ((lam / (2 - lam)) * ((n : ℝ) - (m : ℝ))))
        * ((dy m) ^ (2 / (2 - lam)) * am) := by
  set r : ℝ := 2 / (2 - lam) with hrdef
  set kap : ℝ := lam / (2 - lam) with hkdef
  have h2l : (0 : ℝ) < 2 - lam := by linarith
  have hrk : r - 1 = kap := by
    rw [hrdef, hkdef]
    field_simp
    ring
  have hrl : 1 - r * (1 - lam) = kap := by
    rw [hrdef, hkdef]
    field_simp
    ring
  have hlnn : (0 : ℝ) ≤ 1 - lam := by linarith
  -- step 1 : `bn ≤ (dy n)^{-r}`
  have hb1 : bn ≤ (dy n) ^ (-r) := by
    have h : (dy n) ^ (-r) * ((dy n) ^ r * bn) ≤ (dy n) ^ (-r) * 1 :=
      mul_le_mul' (le_refl _) hyn1
    rw [mul_one, ← mul_assoc, ← ENNReal.rpow_add _ _ (dy_ne_zero n) (dy_ne_top n),
      show -r + r = (0:ℝ) by ring, ENNReal.rpow_zero, one_mul] at h
    exact h
  -- step 2 : `dy n * bn^{1-λ} ≤ (dy n)^κ`
  have hb2 : dy n * bn ^ (1 - lam) ≤ (dy n) ^ kap := by
    have h1 : bn ^ (1 - lam) ≤ ((dy n) ^ (-r)) ^ (1 - lam) :=
      ENNReal.rpow_le_rpow hb1 hlnn
    rw [← ENNReal.rpow_mul] at h1
    have h2 : dy n * ((dy n) ^ (-r * (1 - lam))) = (dy n) ^ (1 - r * (1 - lam)) := by
      rw [show (1:ℝ) - r * (1 - lam) = 1 + (-r * (1 - lam)) by ring,
        ENNReal.rpow_add _ _ (dy_ne_zero n) (dy_ne_top n), ENNReal.rpow_one]
    calc dy n * bn ^ (1 - lam) ≤ dy n * ((dy n) ^ (-r * (1 - lam))) :=
          mul_le_mul' (le_refl _) h1
      _ = (dy n) ^ (1 - r * (1 - lam)) := h2
      _ = (dy n) ^ kap := by rw [hrl]
  -- step 3 : the powers of `dy` recombine
  have hm : (dy m) ^ r = dy m * (dy m) ^ kap := by
    rw [show r = 1 + kap by rw [← hrk]; ring,
      ENNReal.rpow_add _ _ (dy_ne_zero m) (dy_ne_top m), ENNReal.rpow_one]
  have hkey : ENNReal.ofReal ((2 : ℝ) ^ (kap * ((n : ℝ) - (m : ℝ)))) * ((dy m) ^ kap)
      = (dy n) ^ kap := by
    rw [dy_rpow, dy_rpow, ← ENNReal.ofReal_mul (by positivity),
      ← Real.rpow_add (by norm_num : (0:ℝ) < 2)]
    congr 1
    ring
  -- combine
  calc dy m * dy n * (bn ^ (1 - lam) * am)
      = (dy n * bn ^ (1 - lam)) * (dy m * am) := by ring
    _ ≤ ((dy n) ^ kap) * (dy m * am) := mul_le_mul' hb2 (le_refl _)
    _ = dy m * ((dy n) ^ kap) * am := by ring
    _ = dy m * (ENNReal.ofReal ((2 : ℝ) ^ (kap * ((n : ℝ) - (m : ℝ)))) * ((dy m) ^ kap))
          * am := by rw [hkey]
    _ = ENNReal.ofReal ((2 : ℝ) ^ (kap * ((n : ℝ) - (m : ℝ))))
          * ((dy m * (dy m) ^ kap) * am) := by ring
    _ = ENNReal.ofReal ((2 : ℝ) ^ (kap * ((n : ℝ) - (m : ℝ)))) * ((dy m) ^ r * am) := by
        rw [hm]

/-- The `(m,n)` term with both bathtub bounds combined. -/
theorem key_term_bound_of {lam : ℝ} (hlam0 : 0 < lam) (hlam1 : lam < 1) (m n : ℤ)
    (am bn T Ck : ℝ≥0∞)
    (hxm1 : (dy m) ^ (2 / (2 - lam)) * am ≤ 1)
    (hyn1 : (dy n) ^ (2 / (2 - lam)) * bn ≤ 1)
    (hT1 : T ≤ Ck * (bn ^ (1 - lam) * am))
    (hT2 : T ≤ Ck * (am ^ (1 - lam) * bn)) :
    dy m * dy n * T
      ≤ Ck * (ENNReal.ofReal ((2 : ℝ) ^ (-(lam / (2 - lam)))) ^ ((m - n).natAbs)
        * ((dy m) ^ (2 / (2 - lam)) * am + (dy n) ^ (2 / (2 - lam)) * bn)) := by
  set kap : ℝ := lam / (2 - lam) with hkdef
  have h2l : (0 : ℝ) < 2 - lam := by linarith
  rcases le_or_gt n m with hnm | hnm
  · have hk : ((m - n).natAbs : ℝ) = (m : ℝ) - (n : ℝ) := by
      have h2 : ((m - n).natAbs : ℤ) = m - n := by omega
      have h3 : (((m - n).natAbs : ℤ) : ℝ) = ((m - n : ℤ) : ℝ) :=
        congrArg (fun z : ℤ => (z : ℝ)) h2
      rw [Int.cast_natCast] at h3
      rw [h3, Int.cast_sub]
    have hgeo : ENNReal.ofReal ((2 : ℝ) ^ (-kap)) ^ ((m - n).natAbs)
        = ENNReal.ofReal ((2 : ℝ) ^ (kap * ((n : ℝ) - (m : ℝ)))) := by
      rw [ofReal_two_rpow_pow, hk]
      congr 2
      ring
    rw [hgeo]
    calc dy m * dy n * T ≤ dy m * dy n * (Ck * (bn ^ (1 - lam) * am)) :=
          mul_le_mul' (le_refl _) hT1
      _ = Ck * (dy m * dy n * (bn ^ (1 - lam) * am)) := by ring
      _ ≤ Ck * (ENNReal.ofReal ((2 : ℝ) ^ (kap * ((n : ℝ) - (m : ℝ))))
            * ((dy m) ^ (2 / (2 - lam)) * am)) :=
          mul_le_mul' (le_refl _) (term_bound_left hlam0 hlam1 m n am bn hyn1)
      _ ≤ Ck * (ENNReal.ofReal ((2 : ℝ) ^ (kap * ((n : ℝ) - (m : ℝ))))
            * ((dy m) ^ (2 / (2 - lam)) * am + (dy n) ^ (2 / (2 - lam)) * bn)) :=
          mul_le_mul' (le_refl _) (mul_le_mul' (le_refl _) le_self_add)
  · have hk : ((m - n).natAbs : ℝ) = (n : ℝ) - (m : ℝ) := by
      have h2 : ((m - n).natAbs : ℤ) = n - m := by omega
      have h3 : (((m - n).natAbs : ℤ) : ℝ) = ((n - m : ℤ) : ℝ) :=
        congrArg (fun z : ℤ => (z : ℝ)) h2
      rw [Int.cast_natCast] at h3
      rw [h3, Int.cast_sub]
    have hgeo : ENNReal.ofReal ((2 : ℝ) ^ (-kap)) ^ ((m - n).natAbs)
        = ENNReal.ofReal ((2 : ℝ) ^ (kap * ((m : ℝ) - (n : ℝ)))) := by
      rw [ofReal_two_rpow_pow, hk]
      congr 2
      ring
    rw [hgeo]
    calc dy m * dy n * T ≤ dy m * dy n * (Ck * (am ^ (1 - lam) * bn)) :=
          mul_le_mul' (le_refl _) hT2
      _ = Ck * (dy n * dy m * (am ^ (1 - lam) * bn)) := by ring
      _ ≤ Ck * (ENNReal.ofReal ((2 : ℝ) ^ (kap * ((m : ℝ) - (n : ℝ))))
            * ((dy n) ^ (2 / (2 - lam)) * bn)) :=
          mul_le_mul' (le_refl _) (term_bound_left hlam0 hlam1 n m bn am hxm1)
      _ ≤ Ck * (ENNReal.ofReal ((2 : ℝ) ^ (kap * ((m : ℝ) - (n : ℝ))))
            * ((dy m) ^ (2 / (2 - lam)) * am + (dy n) ^ (2 / (2 - lam)) * bn)) :=
          mul_le_mul' (le_refl _) (mul_le_mul' (le_refl _) le_add_self)

/-- Translating the index the other way. -/
theorem tsum_shift' (f : ℤ → ℝ≥0∞) (n : ℤ) : (∑' m : ℤ, f (m - n)) = ∑' k : ℤ, f k := by
  have h := (Equiv.addRight n).tsum_eq (fun m : ℤ => f (m - n))
  simpa using h.symm

end Assembly

/-! ## The main inequality -/

section Main

/-- The constant in the bilinear Hardy--Littlewood--Sobolev inequality. -/
noncomputable def hlsConst (lam : ℝ) : ℝ :=
  32 / ((1 - lam) * (1 - (2 : ℝ) ^ (-(lam / (2 - lam)))))

theorem two_rpow_neg_lt_one_hls {lam : ℝ} (hlam0 : 0 < lam) (hlam1 : lam < 1) :
    (2 : ℝ) ^ (-(lam / (2 - lam))) < 1 := by
  have h2l : (0 : ℝ) < 2 - lam := by linarith
  have hk : 0 < lam / (2 - lam) := by positivity
  rw [show (1 : ℝ) = (2 : ℝ) ^ (0 : ℝ) by norm_num]
  exact Real.rpow_lt_rpow_of_exponent_lt (by norm_num) (by linarith)

/-- The measure of the `m`-th level set. -/
noncomputable def lvlMeas (f : ℝ → ℝ≥0∞) (m : ℤ) : ℝ≥0∞ := volume (lvl f m)

/-- The weighted measure of the `m`-th level set. -/
noncomputable def lvlWt (lam : ℝ) (f : ℝ → ℝ≥0∞) (m : ℤ) : ℝ≥0∞ :=
  (dy m) ^ (2 / (2 - lam)) * lvlMeas f m

theorem tsum_lvlWt_le {f : ℝ → ℝ≥0∞} (hf : Measurable f) {lam : ℝ} (h2l : 0 < 2 - lam) :
    (∑' m : ℤ, lvlWt lam f m) ≤ ∫⁻ s, f s ^ (2 / (2 - lam)) := by
  have hrpos : (0 : ℝ) < 2 / (2 - lam) := by positivity
  exact tsum_dy_rpow_mul_measure_lvl_le hf hrpos

/-- The geometric factor is finite and explicitly bounded. -/
theorem tsum_rho_le {lam : ℝ} (hlam0 : 0 < lam) (hlam1 : lam < 1) :
    (∑' k : ℤ, ENNReal.ofReal ((2 : ℝ) ^ (-(lam / (2 - lam)))) ^ (k.natAbs))
      ≤ ENNReal.ofReal (2 / (1 - (2 : ℝ) ^ (-(lam / (2 - lam))))) := by
  set c : ℝ := (2 : ℝ) ^ (-(lam / (2 - lam))) with hcdef
  have hc1 : c < 1 := two_rpow_neg_lt_one_hls hlam0 hlam1
  have hc0 : 0 < c := by rw [hcdef]; positivity
  have hrho1 : ENNReal.ofReal c ≤ 1 := by
    rw [← ENNReal.ofReal_one]
    exact ENNReal.ofReal_le_ofReal (le_of_lt hc1)
  refine le_trans (tsum_geoZ_le hrho1) ?_
  have hsub : (1 : ℝ≥0∞) - ENNReal.ofReal c = ENNReal.ofReal (1 - c) := by
    rw [← ENNReal.ofReal_one, ← ENNReal.ofReal_sub _ (le_of_lt hc0)]
  rw [hsub, ← ENNReal.ofReal_inv_of_pos (by linarith)]
  rw [show (2 : ℝ) / (1 - c) = 2 * (1 - c)⁻¹ by field_simp]
  rw [ENNReal.ofReal_mul (by norm_num : (0:ℝ) ≤ 2)]
  refine mul_le_mul' (le_of_eq ?_) (le_refl _)
  rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, ENNReal.ofReal_natCast]
  norm_num

/-- **The bilinear Hardy--Littlewood--Sobolev inequality**, normalized case. -/
theorem lintegral_bilinear_riesz_le_of_norm {lam : ℝ} (hlam0 : 0 < lam) (hlam1 : lam < 1)
    {h g : ℝ → ℝ≥0∞} (hhm : Measurable h) (hgm : Measurable g)
    (hh1 : (∫⁻ s, h s ^ (2 / (2 - lam))) ≤ 1)
    (hg1 : (∫⁻ u, g u ^ (2 / (2 - lam))) ≤ 1) :
    (∫⁻ s : ℝ, ∫⁻ u : ℝ, ‖s - u‖ₑ ^ (-lam) * (h s * g u))
      ≤ ENNReal.ofReal (hlsConst lam) := by
  have h2l : (0 : ℝ) < 2 - lam := by linarith
  have hrpos : (0 : ℝ) < 2 / (2 - lam) := by positivity
  have hkpos : (0 : ℝ) < lam / (2 - lam) := by positivity
  -- the two moment sums
  have hxsum : (∑' m : ℤ, lvlWt lam h m) ≤ 1 := le_trans (tsum_lvlWt_le hhm h2l) hh1
  have hysum : (∑' n : ℤ, lvlWt lam g n) ≤ 1 := le_trans (tsum_lvlWt_le hgm h2l) hg1
  have hx1 : ∀ m : ℤ, lvlWt lam h m ≤ 1 := fun m => le_trans (ENNReal.le_tsum m) hxsum
  have hy1 : ∀ n : ℤ, lvlWt lam g n ≤ 1 := fun n => le_trans (ENNReal.le_tsum n) hysum
  -- finiteness almost everywhere
  have hhfin : ∀ᵐ s : ℝ, h s ≠ ⊤ := by
    have hne : (∫⁻ s, h s ^ (2 / (2 - lam))) ≠ ⊤ :=
      ne_top_of_le_ne_top ENNReal.one_ne_top hh1
    filter_upwards [ae_lt_top (hhm.pow_const _) hne] with s hs
    intro hcon
    rw [hcon, ENNReal.top_rpow_of_pos hrpos] at hs
    exact absurd hs (lt_irrefl _)
  have hgfin : ∀ᵐ u : ℝ, g u ≠ ⊤ := by
    have hne : (∫⁻ u, g u ^ (2 / (2 - lam))) ≠ ⊤ :=
      ne_top_of_le_ne_top ENNReal.one_ne_top hg1
    filter_upwards [ae_lt_top (hgm.pow_const _) hne] with u hu
    intro hcon
    rw [hcon, ENNReal.top_rpow_of_pos hrpos] at hu
    exact absurd hu (lt_irrefl _)
  -- step 1 : dominate `h` and `g` by their level-set decompositions
  have step1 : (∫⁻ s : ℝ, ∫⁻ u : ℝ, ‖s - u‖ₑ ^ (-lam) * (h s * g u))
      ≤ ∫⁻ s : ℝ, ∫⁻ u : ℝ, ‖s - u‖ₑ ^ (-lam)
          * ((∑' m : ℤ, 2 * dy m * (lvl h m).indicator (fun _ => (1 : ℝ≥0∞)) s)
            * (∑' n : ℤ, 2 * dy n * (lvl g n).indicator (fun _ => (1 : ℝ≥0∞)) u)) := by
    refine lintegral_mono_ae ?_
    filter_upwards [hhfin] with s hs
    refine lintegral_mono_ae ?_
    filter_upwards [hgfin] with u hu
    exact mul_le_mul' (le_refl _) (mul_le_mul' (le_tsum_lvl hs) (le_tsum_lvl hu))
  -- step 2 : the pointwise expansion into a sum over `ℤ × ℤ`
  have hptid : ∀ s u : ℝ, ‖s - u‖ₑ ^ (-lam)
        * ((∑' m : ℤ, 2 * dy m * (lvl h m).indicator (fun _ => (1 : ℝ≥0∞)) s)
          * (∑' n : ℤ, 2 * dy n * (lvl g n).indicator (fun _ => (1 : ℝ≥0∞)) u))
      = ∑' q : ℤ × ℤ, (2 * dy q.1 * (2 * dy q.2))
          * (‖s - u‖ₑ ^ (-lam) * ((lvl h q.1).indicator (fun _ => (1 : ℝ≥0∞)) s
            * (lvl g q.2).indicator (fun _ => (1 : ℝ≥0∞)) u)) := by
    intro s u
    have e1 : (∑' m : ℤ, 2 * dy m * (lvl h m).indicator (fun _ => (1 : ℝ≥0∞)) s)
          * (∑' n : ℤ, 2 * dy n * (lvl g n).indicator (fun _ => (1 : ℝ≥0∞)) u)
        = ∑' m : ℤ, ∑' n : ℤ,
            (2 * dy m * (lvl h m).indicator (fun _ => (1 : ℝ≥0∞)) s)
              * (2 * dy n * (lvl g n).indicator (fun _ => (1 : ℝ≥0∞)) u) := by
      rw [← ENNReal.tsum_mul_right]
      exact tsum_congr fun m => (ENNReal.tsum_mul_left).symm
    rw [e1, ← ENNReal.tsum_prod]
    rw [← ENNReal.tsum_mul_left]
    refine tsum_congr fun q => ?_
    ring
  -- step 3 : integrate term by term
  have step2 : (∫⁻ s : ℝ, ∫⁻ u : ℝ, ‖s - u‖ₑ ^ (-lam)
          * ((∑' m : ℤ, 2 * dy m * (lvl h m).indicator (fun _ => (1 : ℝ≥0∞)) s)
            * (∑' n : ℤ, 2 * dy n * (lvl g n).indicator (fun _ => (1 : ℝ≥0∞)) u)))
      = ∑' q : ℤ × ℤ, (2 * dy q.1 * (2 * dy q.2))
          * (∫⁻ s in lvl h q.1, ∫⁻ u in lvl g q.2, ‖s - u‖ₑ ^ (-lam)) := by
    have hmeasq : ∀ q : ℤ × ℤ, ∀ s : ℝ, Measurable fun u : ℝ =>
        (2 * dy q.1 * (2 * dy q.2))
          * (‖s - u‖ₑ ^ (-lam) * ((lvl h q.1).indicator (fun _ => (1 : ℝ≥0∞)) s
            * (lvl g q.2).indicator (fun _ => (1 : ℝ≥0∞)) u)) := by
      intro q s
      refine measurable_const.mul ((measurable_rk lam s).mul (measurable_const.mul ?_))
      exact (measurable_one.indicator (measurableSet_lvl hgm q.2))
    have hmeasq2 : ∀ q : ℤ × ℤ, Measurable fun s : ℝ =>
        ∫⁻ u : ℝ, (2 * dy q.1 * (2 * dy q.2))
          * (‖s - u‖ₑ ^ (-lam) * ((lvl h q.1).indicator (fun _ => (1 : ℝ≥0∞)) s
            * (lvl g q.2).indicator (fun _ => (1 : ℝ≥0∞)) u)) := by
      intro q
      have hjoint : Measurable fun p : ℝ × ℝ => (2 * dy q.1 * (2 * dy q.2))
          * (‖p.1 - p.2‖ₑ ^ (-lam) * ((lvl h q.1).indicator (fun _ => (1 : ℝ≥0∞)) p.1
            * (lvl g q.2).indicator (fun _ => (1 : ℝ≥0∞)) p.2)) := by
        refine measurable_const.mul ((((measurable_fst.sub measurable_snd).enorm).pow_const _).mul
          (((measurable_one.indicator (measurableSet_lvl hhm q.1)).comp measurable_fst).mul
            ((measurable_one.indicator (measurableSet_lvl hgm q.2)).comp measurable_snd)))
      exact hjoint.lintegral_prod_right'
    have hin0 : ∀ s : ℝ, (∫⁻ u : ℝ, ‖s - u‖ₑ ^ (-lam)
          * ((∑' m : ℤ, 2 * dy m * (lvl h m).indicator (fun _ => (1 : ℝ≥0∞)) s)
            * (∑' n : ℤ, 2 * dy n * (lvl g n).indicator (fun _ => (1 : ℝ≥0∞)) u)))
        = ∫⁻ u : ℝ, ∑' q : ℤ × ℤ, (2 * dy q.1 * (2 * dy q.2))
            * (‖s - u‖ₑ ^ (-lam) * ((lvl h q.1).indicator (fun _ => (1 : ℝ≥0∞)) s
              * (lvl g q.2).indicator (fun _ => (1 : ℝ≥0∞)) u)) :=
      fun s => lintegral_congr (fun u => hptid s u)
    rw [lintegral_congr hin0]
    rw [lintegral_congr (fun s => lintegral_tsum (fun q => (hmeasq q s).aemeasurable))]
    rw [lintegral_tsum (fun q => (hmeasq2 q).aemeasurable)]
    refine tsum_congr fun q => ?_
    have hcne : (2 * dy q.1 * (2 * dy q.2)) ≠ ⊤ := by
      refine ENNReal.mul_ne_top (ENNReal.mul_ne_top (by simp) (dy_ne_top q.1)) ?_
      exact ENNReal.mul_ne_top (by simp) (dy_ne_top q.2)
    have e1 : ∀ s : ℝ, (∫⁻ u : ℝ, (2 * dy q.1 * (2 * dy q.2))
          * (‖s - u‖ₑ ^ (-lam) * ((lvl h q.1).indicator (fun _ => (1 : ℝ≥0∞)) s
            * (lvl g q.2).indicator (fun _ => (1 : ℝ≥0∞)) u)))
        = (2 * dy q.1 * (2 * dy q.2)) * ∫⁻ u : ℝ,
            (‖s - u‖ₑ ^ (-lam) * ((lvl h q.1).indicator (fun _ => (1 : ℝ≥0∞)) s
              * (lvl g q.2).indicator (fun _ => (1 : ℝ≥0∞)) u)) :=
      fun s => lintegral_const_mul' _ _ hcne
    rw [lintegral_congr e1, lintegral_const_mul' _ _ hcne,
      lintegral_prod_indicator_mul (measurableSet_lvl hhm q.1) (measurableSet_lvl hgm q.2)
        (fun s u => ‖s - u‖ₑ ^ (-lam)) (fun s => measurable_rk lam s)]
  -- step 4 : the two kernel bounds
  have step3 : ∀ q : ℤ × ℤ, (2 * dy q.1 * (2 * dy q.2))
        * (∫⁻ s in lvl h q.1, ∫⁻ u in lvl g q.2, ‖s - u‖ₑ ^ (-lam))
      ≤ 4 * (ENNReal.ofReal (2 / (1 - lam))
          * (ENNReal.ofReal ((2 : ℝ) ^ (-(lam / (2 - lam)))) ^ ((q.1 - q.2).natAbs)
            * (lvlWt lam h q.1 + lvlWt lam g q.2))) := by
    intro q
    have hT1 := lintegral_prod_rk_le hlam0 hlam1 (measurableSet_lvl hhm q.1)
      (measurableSet_lvl hgm q.2)
    have hT2 := lintegral_prod_rk_le' hlam0 hlam1 (measurableSet_lvl hhm q.1)
      (measurableSet_lvl hgm q.2)
    have hkey := key_term_bound_of hlam0 hlam1 q.1 q.2 (lvlMeas h q.1) (lvlMeas g q.2)
      (∫⁻ s in lvl h q.1, ∫⁻ u in lvl g q.2, ‖s - u‖ₑ ^ (-lam))
      (ENNReal.ofReal (2 / (1 - lam))) (hx1 q.1) (hy1 q.2) hT1 hT2
    calc (2 * dy q.1 * (2 * dy q.2))
          * (∫⁻ s in lvl h q.1, ∫⁻ u in lvl g q.2, ‖s - u‖ₑ ^ (-lam))
        = 4 * (dy q.1 * dy q.2
            * (∫⁻ s in lvl h q.1, ∫⁻ u in lvl g q.2, ‖s - u‖ₑ ^ (-lam))) := by ring
      _ ≤ 4 * (ENNReal.ofReal (2 / (1 - lam))
            * (ENNReal.ofReal ((2 : ℝ) ^ (-(lam / (2 - lam)))) ^ ((q.1 - q.2).natAbs)
              * (lvlWt lam h q.1 + lvlWt lam g q.2))) := mul_le_mul' (le_refl _) hkey
  -- step 5 : the double sum
  have hSp : (∑' k : ℤ, ENNReal.ofReal ((2 : ℝ) ^ (-(lam / (2 - lam)))) ^ (k.natAbs))
      ≤ ENNReal.ofReal (2 / (1 - (2 : ℝ) ^ (-(lam / (2 - lam))))) := tsum_rho_le hlam0 hlam1
  have hpartA : (∑' m : ℤ, ∑' n : ℤ,
      ENNReal.ofReal ((2 : ℝ) ^ (-(lam / (2 - lam)))) ^ ((m - n).natAbs) * lvlWt lam h m)
      ≤ ENNReal.ofReal (2 / (1 - (2 : ℝ) ^ (-(lam / (2 - lam))))) := by
    have hin : ∀ m : ℤ, (∑' n : ℤ,
        ENNReal.ofReal ((2 : ℝ) ^ (-(lam / (2 - lam)))) ^ ((m - n).natAbs) * lvlWt lam h m)
        = (∑' k : ℤ, ENNReal.ofReal ((2 : ℝ) ^ (-(lam / (2 - lam)))) ^ (k.natAbs))
          * lvlWt lam h m := by
      intro m
      rw [← ENNReal.tsum_mul_right,
        tsum_shift (fun k : ℤ => ENNReal.ofReal ((2 : ℝ) ^ (-(lam / (2 - lam)))) ^ (k.natAbs)
          * lvlWt lam h m) m]
    rw [tsum_congr hin, ENNReal.tsum_mul_left]
    calc (∑' k : ℤ, ENNReal.ofReal ((2 : ℝ) ^ (-(lam / (2 - lam)))) ^ (k.natAbs))
          * (∑' m : ℤ, lvlWt lam h m)
        ≤ ENNReal.ofReal (2 / (1 - (2 : ℝ) ^ (-(lam / (2 - lam))))) * 1 :=
          mul_le_mul' hSp hxsum
      _ = ENNReal.ofReal (2 / (1 - (2 : ℝ) ^ (-(lam / (2 - lam))))) := by rw [mul_one]
  have hpartB : (∑' m : ℤ, ∑' n : ℤ,
      ENNReal.ofReal ((2 : ℝ) ^ (-(lam / (2 - lam)))) ^ ((m - n).natAbs) * lvlWt lam g n)
      ≤ ENNReal.ofReal (2 / (1 - (2 : ℝ) ^ (-(lam / (2 - lam))))) := by
    rw [ENNReal.tsum_comm]
    have hin : ∀ n : ℤ, (∑' m : ℤ,
        ENNReal.ofReal ((2 : ℝ) ^ (-(lam / (2 - lam)))) ^ ((m - n).natAbs) * lvlWt lam g n)
        = (∑' k : ℤ, ENNReal.ofReal ((2 : ℝ) ^ (-(lam / (2 - lam)))) ^ (k.natAbs))
          * lvlWt lam g n := by
      intro n
      rw [← ENNReal.tsum_mul_right,
        tsum_shift' (fun k : ℤ => ENNReal.ofReal ((2 : ℝ) ^ (-(lam / (2 - lam)))) ^ (k.natAbs)
          * lvlWt lam g n) n]
    rw [tsum_congr hin, ENNReal.tsum_mul_left]
    calc (∑' k : ℤ, ENNReal.ofReal ((2 : ℝ) ^ (-(lam / (2 - lam)))) ^ (k.natAbs))
          * (∑' n : ℤ, lvlWt lam g n)
        ≤ ENNReal.ofReal (2 / (1 - (2 : ℝ) ^ (-(lam / (2 - lam))))) * 1 :=
          mul_le_mul' hSp hysum
      _ = ENNReal.ofReal (2 / (1 - (2 : ℝ) ^ (-(lam / (2 - lam))))) := by rw [mul_one]
  have step4 : (∑' q : ℤ × ℤ,
        ENNReal.ofReal ((2 : ℝ) ^ (-(lam / (2 - lam)))) ^ ((q.1 - q.2).natAbs)
          * (lvlWt lam h q.1 + lvlWt lam g q.2))
      ≤ 2 * ENNReal.ofReal (2 / (1 - (2 : ℝ) ^ (-(lam / (2 - lam))))) := by
    rw [ENNReal.tsum_prod (f := fun m n : ℤ =>
      ENNReal.ofReal ((2 : ℝ) ^ (-(lam / (2 - lam)))) ^ ((m - n).natAbs)
        * (lvlWt lam h m + lvlWt lam g n))]
    have hsplit : ∀ m n : ℤ,
        ENNReal.ofReal ((2 : ℝ) ^ (-(lam / (2 - lam)))) ^ ((m - n).natAbs)
          * (lvlWt lam h m + lvlWt lam g n)
        = ENNReal.ofReal ((2 : ℝ) ^ (-(lam / (2 - lam)))) ^ ((m - n).natAbs) * lvlWt lam h m
          + ENNReal.ofReal ((2 : ℝ) ^ (-(lam / (2 - lam)))) ^ ((m - n).natAbs)
              * lvlWt lam g n := by
      intro m n
      rw [mul_add]
    rw [tsum_congr fun m => tsum_congr fun n => hsplit m n]
    rw [tsum_congr fun m => ENNReal.tsum_add]
    rw [ENNReal.tsum_add, two_mul]
    exact add_le_add hpartA hpartB
  -- assemble
  refine le_trans step1 (le_trans (le_of_eq step2) ?_)
  refine le_trans (ENNReal.tsum_le_tsum step3) ?_
  rw [ENNReal.tsum_mul_left, ENNReal.tsum_mul_left]
  refine le_trans (mul_le_mul' (le_refl _) (mul_le_mul' (le_refl _) step4)) ?_
  have hc1 : (2 : ℝ) ^ (-(lam / (2 - lam))) < 1 := two_rpow_neg_lt_one_hls hlam0 hlam1
  have h2e : (2 : ℝ≥0∞) = ENNReal.ofReal 2 := by
    rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, ENNReal.ofReal_natCast]
    norm_num
  have h4e : (4 : ℝ≥0∞) = ENNReal.ofReal 4 := by
    rw [show (4 : ℝ) = ((4 : ℕ) : ℝ) by norm_num, ENNReal.ofReal_natCast]
    norm_num
  rw [h4e, h2e, ← ENNReal.ofReal_mul (by norm_num : (0:ℝ) ≤ 2),
    ← ENNReal.ofReal_mul (by positivity : (0:ℝ) ≤ 2 / (1 - lam)),
    ← ENNReal.ofReal_mul (by norm_num : (0:ℝ) ≤ 4)]
  refine ENNReal.ofReal_le_ofReal (le_of_eq ?_)
  rw [hlsConst]
  field_simp
  ring

/-- **The bilinear Hardy--Littlewood--Sobolev inequality on the line**, at the symmetric
exponent `r = 2/(2-λ)`:
`∫∫ |s-u|^{-λ} h(s) g(u) ds du ≤ c_λ ‖h‖_r ‖g‖_r`. -/
theorem lintegral_bilinear_riesz_le {lam : ℝ} (hlam0 : 0 < lam) (hlam1 : lam < 1)
    {h g : ℝ → ℝ≥0∞} (hhm : Measurable h) (hgm : Measurable g) :
    (∫⁻ s : ℝ, ∫⁻ u : ℝ, ‖s - u‖ₑ ^ (-lam) * (h s * g u))
      ≤ ENNReal.ofReal (hlsConst lam)
        * ((∫⁻ s, h s ^ (2 / (2 - lam))) ^ ((2 - lam) / 2))
        * ((∫⁻ u, g u ^ (2 / (2 - lam))) ^ ((2 - lam) / 2)) := by
  have h2l : (0 : ℝ) < 2 - lam := by linarith
  have hrpos : (0 : ℝ) < 2 / (2 - lam) := by positivity
  have hqpos : (0 : ℝ) < (2 - lam) / 2 := by positivity
  have hqr : ((2 - lam) / 2) * (2 / (2 - lam)) = 1 := by field_simp
  have hCpos : 0 < hlsConst lam := by
    have hc := two_rpow_neg_lt_one_hls hlam0 hlam1
    have h1 : (0 : ℝ) < 1 - lam := by linarith
    have h2 : (0 : ℝ) < 1 - (2 : ℝ) ^ (-(lam / (2 - lam))) := by linarith
    rw [hlsConst]
    positivity
  have hCne : ENNReal.ofReal (hlsConst lam) ≠ 0 := by
    rw [ne_eq, ENNReal.ofReal_eq_zero, not_le]
    exact hCpos
  by_cases hh0 : (∫⁻ s, h s ^ (2 / (2 - lam))) = 0
  · have hae : ∀ᵐ s : ℝ, h s = 0 := by
      rw [lintegral_eq_zero_iff (hhm.pow_const _)] at hh0
      filter_upwards [hh0] with s hs
      rcases ENNReal.rpow_eq_zero_iff.mp hs with hcase | hcase
      · exact hcase.1
      · exact absurd hcase.2 (by linarith)
    have hzero : (∫⁻ s : ℝ, ∫⁻ u : ℝ, ‖s - u‖ₑ ^ (-lam) * (h s * g u)) = 0 := by
      have hcongr : (fun s : ℝ => ∫⁻ u : ℝ, ‖s - u‖ₑ ^ (-lam) * (h s * g u))
          =ᶠ[MeasureTheory.ae volume] 0 := by
        filter_upwards [hae] with s hs
        simp [hs]
      rw [lintegral_congr_ae hcongr]
      simp
    rw [hzero]
    exact zero_le
  by_cases hg0 : (∫⁻ u, g u ^ (2 / (2 - lam))) = 0
  · have hae : ∀ᵐ u : ℝ, g u = 0 := by
      rw [lintegral_eq_zero_iff (hgm.pow_const _)] at hg0
      filter_upwards [hg0] with u hu
      rcases ENNReal.rpow_eq_zero_iff.mp hu with hcase | hcase
      · exact hcase.1
      · exact absurd hcase.2 (by linarith)
    have hzero : (∫⁻ s : ℝ, ∫⁻ u : ℝ, ‖s - u‖ₑ ^ (-lam) * (h s * g u)) = 0 := by
      have hinner : ∀ s : ℝ, (∫⁻ u : ℝ, ‖s - u‖ₑ ^ (-lam) * (h s * g u)) = 0 := by
        intro s
        have hcongr : (fun u : ℝ => ‖s - u‖ₑ ^ (-lam) * (h s * g u))
            =ᶠ[MeasureTheory.ae volume] 0 := by
          filter_upwards [hae] with u hu
          simp [hu]
        rw [lintegral_congr_ae hcongr]
        simp
      rw [lintegral_congr hinner]
      simp
    rw [hzero]
    exact zero_le
  by_cases hhtop : (∫⁻ s, h s ^ (2 / (2 - lam))) = ⊤
  · have htop : ((∫⁻ s, h s ^ (2 / (2 - lam))) ^ ((2 - lam) / 2)) = ⊤ := by
      rw [hhtop]
      exact ENNReal.top_rpow_of_pos hqpos
    have hgne : ((∫⁻ u, g u ^ (2 / (2 - lam))) ^ ((2 - lam) / 2)) ≠ 0 := by
      rw [ne_eq, ENNReal.rpow_eq_zero_iff]
      intro hcon
      rcases hcon with hcase | hcase
      · exact hg0 hcase.1
      · exact absurd hcase.2 (by linarith)
    rw [htop, ENNReal.mul_top hCne, ENNReal.top_mul hgne]
    exact le_top
  by_cases hgtop : (∫⁻ u, g u ^ (2 / (2 - lam))) = ⊤
  · have htop : ((∫⁻ u, g u ^ (2 / (2 - lam))) ^ ((2 - lam) / 2)) = ⊤ := by
      rw [hgtop]
      exact ENNReal.top_rpow_of_pos hqpos
    have hne : ENNReal.ofReal (hlsConst lam)
        * ((∫⁻ s, h s ^ (2 / (2 - lam))) ^ ((2 - lam) / 2)) ≠ 0 := by
      refine mul_ne_zero hCne ?_
      rw [ne_eq, ENNReal.rpow_eq_zero_iff]
      intro hcon
      rcases hcon with hcase | hcase
      · exact hh0 hcase.1
      · exact absurd hcase.2 (by linarith)
    rw [htop, ENNReal.mul_top hne]
    exact le_top
  have hAh0 : ((∫⁻ s, h s ^ (2 / (2 - lam))) ^ ((2 - lam) / 2)) ≠ 0 := by
    rw [ne_eq, ENNReal.rpow_eq_zero_iff]
    intro hcon
    rcases hcon with hcase | hcase
    · exact hh0 hcase.1
    · exact absurd hcase.2 (by linarith)
  have hAg0 : ((∫⁻ u, g u ^ (2 / (2 - lam))) ^ ((2 - lam) / 2)) ≠ 0 := by
    rw [ne_eq, ENNReal.rpow_eq_zero_iff]
    intro hcon
    rcases hcon with hcase | hcase
    · exact hg0 hcase.1
    · exact absurd hcase.2 (by linarith)
  have hAhtop : ((∫⁻ s, h s ^ (2 / (2 - lam))) ^ ((2 - lam) / 2)) ≠ ⊤ := by
    rw [ne_eq, ENNReal.rpow_eq_top_iff]
    intro hcon
    rcases hcon with hcase | hcase
    · exact absurd hcase.2 (by linarith)
    · exact hhtop hcase.1
  have hAgtop : ((∫⁻ u, g u ^ (2 / (2 - lam))) ^ ((2 - lam) / 2)) ≠ ⊤ := by
    rw [ne_eq, ENNReal.rpow_eq_top_iff]
    intro hcon
    rcases hcon with hcase | hcase
    · exact absurd hcase.2 (by linarith)
    · exact hgtop hcase.1
  set Ah : ℝ≥0∞ := (∫⁻ s, h s ^ (2 / (2 - lam))) ^ ((2 - lam) / 2) with hAhdef
  set Ag : ℝ≥0∞ := (∫⁻ u, g u ^ (2 / (2 - lam))) ^ ((2 - lam) / 2) with hAgdef
  have hAhr : Ah ^ (2 / (2 - lam)) = ∫⁻ s, h s ^ (2 / (2 - lam)) := by
    rw [hAhdef, ← ENNReal.rpow_mul, hqr, ENNReal.rpow_one]
  have hAgr : Ag ^ (2 / (2 - lam)) = ∫⁻ u, g u ^ (2 / (2 - lam)) := by
    rw [hAgdef, ← ENNReal.rpow_mul, hqr, ENNReal.rpow_one]
  have hAhinvtop : Ah⁻¹ ≠ ⊤ := by
    rw [ne_eq, ENNReal.inv_eq_top]
    exact hAh0
  have hAginvtop : Ag⁻¹ ≠ ⊤ := by
    rw [ne_eq, ENNReal.inv_eq_top]
    exact hAg0
  have hnormh : (∫⁻ s, (Ah⁻¹ * h s) ^ (2 / (2 - lam))) ≤ 1 := by
    have hpt : ∀ s : ℝ, (Ah⁻¹ * h s) ^ (2 / (2 - lam))
        = (Ah⁻¹) ^ (2 / (2 - lam)) * h s ^ (2 / (2 - lam)) := fun s =>
      ENNReal.mul_rpow_of_nonneg _ _ (le_of_lt hrpos)
    have hcne : (Ah⁻¹) ^ (2 / (2 - lam)) ≠ ⊤ := by
      rw [ne_eq, ENNReal.rpow_eq_top_iff]
      intro hcon
      rcases hcon with hcase | hcase
      · exact absurd hcase.2 (by linarith)
      · exact hAhinvtop hcase.1
    rw [lintegral_congr hpt, lintegral_const_mul' _ _ hcne, ← hAhr,
      ← ENNReal.rpow_neg_one Ah, ← ENNReal.rpow_mul,
      show (-1 : ℝ) * (2 / (2 - lam)) = -(2 / (2 - lam)) by ring, ENNReal.rpow_neg,
      ENNReal.inv_mul_cancel (by rw [hAhr]; exact hh0) (by rw [hAhr]; exact hhtop)]
  have hnormg : (∫⁻ u, (Ag⁻¹ * g u) ^ (2 / (2 - lam))) ≤ 1 := by
    have hpt : ∀ u : ℝ, (Ag⁻¹ * g u) ^ (2 / (2 - lam))
        = (Ag⁻¹) ^ (2 / (2 - lam)) * g u ^ (2 / (2 - lam)) := fun u =>
      ENNReal.mul_rpow_of_nonneg _ _ (le_of_lt hrpos)
    have hcne : (Ag⁻¹) ^ (2 / (2 - lam)) ≠ ⊤ := by
      rw [ne_eq, ENNReal.rpow_eq_top_iff]
      intro hcon
      rcases hcon with hcase | hcase
      · exact absurd hcase.2 (by linarith)
      · exact hAginvtop hcase.1
    rw [lintegral_congr hpt, lintegral_const_mul' _ _ hcne, ← hAgr,
      ← ENNReal.rpow_neg_one Ag, ← ENNReal.rpow_mul,
      show (-1 : ℝ) * (2 / (2 - lam)) = -(2 / (2 - lam)) by ring, ENNReal.rpow_neg,
      ENNReal.inv_mul_cancel (by rw [hAgr]; exact hg0) (by rw [hAgr]; exact hgtop)]
  have hnorm := lintegral_bilinear_riesz_le_of_norm hlam0 hlam1
    (hhm.const_mul (Ah⁻¹)) (hgm.const_mul (Ag⁻¹)) hnormh hnormg
  have hinvne : (Ah⁻¹ * Ag⁻¹) ≠ ⊤ := ENNReal.mul_ne_top hAhinvtop hAginvtop
  have hscale : (∫⁻ s : ℝ, ∫⁻ u : ℝ, ‖s - u‖ₑ ^ (-lam) * ((Ah⁻¹ * h s) * (Ag⁻¹ * g u)))
      = (Ah⁻¹ * Ag⁻¹) * ∫⁻ s : ℝ, ∫⁻ u : ℝ, ‖s - u‖ₑ ^ (-lam) * (h s * g u) := by
    have hinner : ∀ s : ℝ, (∫⁻ u : ℝ, ‖s - u‖ₑ ^ (-lam) * ((Ah⁻¹ * h s) * (Ag⁻¹ * g u)))
        = (Ah⁻¹ * Ag⁻¹) * ∫⁻ u : ℝ, ‖s - u‖ₑ ^ (-lam) * (h s * g u) := by
      intro s
      rw [← lintegral_const_mul' _ _ hinvne]
      refine lintegral_congr fun u => ?_
      ring
    rw [lintegral_congr hinner, ← lintegral_const_mul' _ _ hinvne]
  rw [hscale] at hnorm
  have hprodne : (Ah * Ag) ≠ 0 := mul_ne_zero hAh0 hAg0
  have hprodtop : (Ah * Ag) ≠ ⊤ := ENNReal.mul_ne_top hAhtop hAgtop
  have hmul := mul_le_mul' (le_refl (Ah * Ag)) hnorm
  have hinvprod : (Ah * Ag) * (Ah⁻¹ * Ag⁻¹) = 1 := by
    rw [show Ah⁻¹ * Ag⁻¹ = (Ah * Ag)⁻¹ by
      rw [ENNReal.mul_inv (Or.inl hAh0) (Or.inl hAhtop)]]
    exact ENNReal.mul_inv_cancel hprodne hprodtop
  rw [← mul_assoc, hinvprod, one_mul] at hmul
  calc (∫⁻ s : ℝ, ∫⁻ u : ℝ, ‖s - u‖ₑ ^ (-lam) * (h s * g u))
      ≤ (Ah * Ag) * ENNReal.ofReal (hlsConst lam) := hmul
    _ = ENNReal.ofReal (hlsConst lam) * Ah * Ag := by ring

end Main

