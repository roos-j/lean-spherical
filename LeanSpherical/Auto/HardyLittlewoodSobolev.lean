  have hsing : (∫⁻ u in ({s} : Set ℝ), ‖s - u‖ₑ ^ (-lam)) = 0 := by
    refine setLIntegral_measure_zero _ _ ?_
    simp
  refine le_trans (lintegral_union_le _ _ _) ?_
  refine le_trans (add_le_add (le_refl _) (lintegral_union_le _ _ _)) ?_
