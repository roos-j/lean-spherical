      ≤ ENNReal.ofReal (2 * (R ^ (1 - lam) / (1 - lam))) := by
  have hball : Metric.ball s R = Set.Ioo (s - R) s ∪ ({s} ∪ Set.Ioo s (s + R)) := by
    rw [Real.ball_eq_Ioo]
    ext x
    simp only [Set.mem_Ioo, Set.mem_union, Set.mem_singleton_iff]
    constructor
    · intro ⟨h1, h2⟩
      rcases lt_trichotomy x s with h | h | h
      · exact Or.inl ⟨h1, h⟩
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr ⟨h, h2⟩)
    · intro h
      rcases h with ⟨h1, h2⟩ | h | ⟨h1, h2⟩
      · exact ⟨h1, by linarith⟩
      · subst h
        exact ⟨by linarith, by linarith⟩
      · exact ⟨by linarith, h2⟩
