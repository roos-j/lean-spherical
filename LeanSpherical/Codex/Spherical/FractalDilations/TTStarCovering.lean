/-- The radius interval of half-width `L`, clipped to the ambient interval
`[1,2]`. -/
def localRadiusInterval (x L : ℝ) : Set ℝ :=
  Icc (max 1 (x - L)) (min 2 (x + L))

/-- Two radii are in one gap shell when their distance lies in `[u,L)`.
Only the upper gap `L` is needed for the local-cover degree bound. -/
def radiusGapShellNeighbors (u L x y : ℝ) : Prop :=
  u ≤ |x - y| ∧ |x - y| < L

