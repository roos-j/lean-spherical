          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal r) volume <=
          CT * rho ^ j * ENNReal.ofReal
            (Real.sqrt (∫ x, ‖(f : Euclidean d -> Complex) x‖ ^ (2 : Nat))) := by
  have hdsource : 3 <= d ∨ d = 2 ∧ gamma <= 1 / 2 := by
    rcases hd with hd3 | htwo
    · exact Or.inl hd3
