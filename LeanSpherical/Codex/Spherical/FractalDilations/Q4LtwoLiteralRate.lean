/-- The genuinely critical planar `Q4` active dyadic estimate.  At
`gamma = 1 / 2` the individual gap exponent is positive, so this is not an
instance of the preceding strict-gap theorem: it uses the literal finite
range `n < j + 3` through
`q4ActiveDyadicLtwoRealConstant_le_planar_critical_dyadic_rate`.

The cutoff is an explicit argument.  In particular, applications can use
this theorem and its non-critical counterpart at several nearby exponents
without silently changing the maximal operator being interpolated. -/
theorem q4_active_ltwo_planar_critical_dyadic_rate_of_fixed_normRadial_cutoff
    {E : Set Real} {eta Ccover : Real}
    (phi : SchwartzMap (Euclidean 2) Complex)
    (hphiOne : ∀ xi, ‖xi‖ <= 1 -> phi xi = 1)
    (hphiZero : ∀ xi, 2 <= ‖xi‖ -> phi xi = 0)
    (hphiNorm : ∀ xi, ‖phi xi‖ <= 1)
    (hphiRadial : IsNormRadial phi)
    (hE : E ⊆ Icc (1 : Real) 2) (hEne : E.Nonempty)
    (hcover : HasSubpowerAssouadCoverBound E (1 / 2) eta Ccover)
    (hCcover : 0 <= Ccover) (heta : 0 <= eta)
    {u theta : Real} (hu1 : 1 < u) (hu2 : u < 2)
    (houtput : 2 / theta = u / (u - 1))
    (htheta : 1 / 2 < theta) (hthetaOne : theta < 1)
    (hcombined : q4FrequencyExponentWithSubpowerLoss 2 theta eta +
      q4GapExponent 2 (1 / 2) theta < 0) :
    ∃ CT rho : ENNReal, 0 < CT ∧ CT < ⊤ ∧ rho < 1 ∧
      rho = ENNReal.ofReal
        ((2 : Real) ^
          ((q4FrequencyExponentWithSubpowerLoss 2 theta eta +
            q4GapExponent 2 (1 / 2) theta) / 2)) ∧
      ∀ j : Nat, 1 <= j -> ∀ f : SchwartzMap (Euclidean 2) Complex,
        MemLp (fractalDyadicBandpassMaximal 2 E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal (2 / theta)) volume ∧
        eLpNorm (fractalDyadicBandpassMaximal 2 E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal (2 / theta)) volume <=
          CT * rho ^ j * ENNReal.ofReal
            (Real.sqrt (∫ x, ‖(f : Euclidean 2 -> Complex) x‖ ^ (2 : Nat))) := by
  have hdsource : 3 <= 2 ∨ 2 = 2 ∧ (1 / 2 : Real) <= 1 / 2 := by
    exact Or.inr ⟨rfl, le_rfl⟩
  obtain ⟨C0, hC0, hdecay0⟩ :=
    (exists_theoremOneSharpSurfaceFourierInput
      (d := 2) (gamma := (1 / 2 : Real)) hdsource).decay
  obtain ⟨C1, hC1, hderiv1⟩ := theoremOne_exists_sharp_derivative_at_one
    (exists_theoremOneSharpSurfaceFourierInput
      (d := 2) (gamma := (1 / 2 : Real)) hdsource)
  obtain ⟨Cendpoint, hCendpoint, hendpointDecay⟩ :=
    exists_hasQ4DyadicPairKernelGapDecayOn_absoluteDyadicBandpass_two
      phi hphiOne hphiZero hphiNorm hphiRadial
  obtain ⟨Cderivative, hCderivative, hderivativeDecay⟩ :=
    exists_hasQ4ScaledNormalizedDyadicSurfaceRadiusDerivativePairKernelGapDecayOn_absoluteDyadicBandpass_two
      phi hphiOne hphiZero hphiNorm hphiRadial
  have htheta0 : theta ≠ 0 := by linarith
  have hthetaPos : 0 < theta := by linarith
  have hqgtwo : 2 < 2 / theta := by
    rw [lt_div_iff₀ hthetaPos]
    nlinarith
  have hthetaOutput : 2 / (2 / theta) = theta := by
    field_simp [htheta0]
  let a : Real := q4FrequencyExponentWithSubpowerLoss 2 theta eta
  let b : Real := q4GapExponent 2 (1 / 2) theta
  let combined : Real := a + b
  let rhoReal : Real := (2 : Real) ^ (combined / 2)
  have hcombined' : combined < 0 := by
    simpa only [combined, a, b] using hcombined
  have hrhoReal := q4_sqrt_frequency_ratio_mem_Ioo hcombined'
  let E0 : Real := 4 * C0 ^ 2 * (2 : Real) ^ ((2 : Real) - 1)
  let D0 : Real := 160 * C1 ^ 2 * ‖(surfaceMass 2 : Complex)⁻¹‖ ^ 2
  let Aendpoint : Real :=
    q4DiagonalStrongFrequencyPrefactor Cendpoint E0 (2 / theta) +
      q4PositiveGapStrongFrequencyPrefactor 2 (1 / 2) Ccover Cendpoint E0
        (2 / theta)
  let Aderivative : Real :=
    q4DiagonalStrongFrequencyPrefactor Cderivative D0 (2 / theta) +
      q4PositiveGapStrongFrequencyPrefactor 2 (1 / 2) Ccover Cderivative D0
        (2 / theta)
  let Cbar : Real := ‖(surfaceMass 2)⁻¹ : Complex‖ *
      Real.sqrt (q4PlanarCriticalShellSummationConstant Aendpoint theta) +
    Real.sqrt (q4PlanarCriticalShellSummationConstant Aderivative theta)
  let CTreal : Real := Cbar + 1
  have hE0 : 0 <= E0 := by
    dsimp only [E0]
    exact mul_nonneg
      (mul_nonneg (by norm_num) (sq_nonneg C0))
      (Real.rpow_nonneg (by norm_num) _)
  have hD0 : 0 <= D0 := by
    dsimp only [D0]
    exact mul_nonneg
      (mul_nonneg (by norm_num) (sq_nonneg C1)) (sq_nonneg _)
  have hAendpoint : 0 <= Aendpoint := by
    dsimp only [Aendpoint]
    exact add_nonneg
      (q4DiagonalStrongFrequencyPrefactor_nonneg hqgtwo hCendpoint hE0)
      (q4PositiveGapStrongFrequencyPrefactor_nonneg
        hqgtwo hCendpoint hCcover hE0)
  have hAderivative : 0 <= Aderivative := by
    dsimp only [Aderivative]
    exact add_nonneg
      (q4DiagonalStrongFrequencyPrefactor_nonneg hqgtwo hCderivative hD0)
      (q4PositiveGapStrongFrequencyPrefactor_nonneg
        hqgtwo hCderivative hCcover hD0)
  have hCbar : 0 <= Cbar := by
    dsimp only [Cbar]
    exact add_nonneg
      (mul_nonneg (norm_nonneg _) (Real.sqrt_nonneg _))
      (Real.sqrt_nonneg _)
  have hCTreal : 0 < CTreal := by
    dsimp only [CTreal]
    linarith
  refine ⟨ENNReal.ofReal CTreal, ENNReal.ofReal rhoReal,
    ENNReal.ofReal_pos.mpr hCTreal, ENNReal.ofReal_lt_top, ?_, ?_, ?_⟩
  · rw [← ENNReal.ofReal_one]
    exact (ENNReal.ofReal_lt_ofReal_iff_of_nonneg hrhoReal.1).mpr hrhoReal.2
  · rfl
  · intro j hj f
    let hs : (activeDyadicIndices E j).Nonempty :=
      activeDyadicIndices_nonempty_of_nonempty hE hEne
    let Bendpointj : Real :=
      q4EnlargedPairMultiplierBound C0 ((1 : Real) / 2) j
    let Bderivativej : Real :=
      q4PlanarEnlargedScaledNormalizedDerivativePairMultiplierBound C1 j
    have hdeltaone : dyadicScale j < 1 :=
      lt_of_le_of_lt (dyadicScale_le_half_of_one_le hj) (by norm_num)
    have hlevelEndpoint : ∀ k n : Nat,
        q4ActiveDyadicLevelStrongConstant 2 (1 / 2) eta Ccover Cendpoint
          (q4EnlargedPairMultiplierBound C0 ((1 : Real) / 2) k) k n
            (2 / theta) <=
          ENNReal.ofReal
            (Aendpoint * (2 : Real) ^
              (q4FrequencyExponentWithSubpowerLoss 2 theta eta * (k : Real) +
                q4GapExponent 2 (1 / 2) theta * (n : Real))) := by
      intro k n
      simpa only [Aendpoint, E0, hthetaOutput] using
        (q4ActiveDyadicLevelStrongConstant_le_dyadic_normalForm_of_ordinaryMultiplier
          (d := 2) (gamma := (1 / 2 : Real)) (eta := eta) (Ccover := Ccover)
          (Ckernel := Cendpoint) (C := C0) (q := 2 / theta)
          hqgtwo hCendpoint hCcover (by norm_num) heta k n)
    have hlevelDerivative : ∀ k n : Nat,
        q4ActiveDyadicLevelStrongConstant 2 (1 / 2) eta Ccover Cderivative
          (q4PlanarEnlargedScaledNormalizedDerivativePairMultiplierBound C1 k) k n
            (2 / theta) <=
          ENNReal.ofReal
            (Aderivative * (2 : Real) ^
              (q4FrequencyExponentWithSubpowerLoss 2 theta eta * (k : Real) +
                q4GapExponent 2 (1 / 2) theta * (n : Real))) := by
      intro k n
      simpa only [Aderivative, D0, hthetaOutput] using
        (q4ActiveDyadicLevelStrongConstant_le_dyadic_normalForm_of_planarSignedDerivativeMultiplier
          (gamma := (1 / 2 : Real)) (eta := eta) (Ccover := Ccover)
          (Ckernel := Cderivative) (C := C1) (q := 2 / theta)
          hqgtwo hCderivative hCcover (by norm_num) heta k n)
    have hcoefficient :=
      q4ActiveDyadicLtwoRealConstant_le_planar_critical_dyadic_rate_at
        (eta := eta) (Ccover := Ccover)
        (Cendpoint := Cendpoint) (Bendpoint := Bendpointj)
        (Cderivative := Cderivative) (Bderivative := Bderivativej)
        (Aendpoint := Aendpoint) (Aderivative := Aderivative) (theta := theta) j
        hAendpoint hAderivative htheta hcombined
        (hlevelEndpoint j) (hlevelDerivative j)
    have hcoefficient' :
        q4ActiveDyadicLtwoRealConstant 2 (1 / 2) eta Ccover
          Cendpoint Bendpointj Cderivative Bderivativej j (2 / theta) <=
          CTreal * rhoReal ^ j := by
      calc
        q4ActiveDyadicLtwoRealConstant 2 (1 / 2) eta Ccover
            Cendpoint Bendpointj Cderivative Bderivativej j (2 / theta) <=
            Cbar * rhoReal ^ j := by
              simpa only [Cbar, rhoReal, combined, a, b] using hcoefficient
        _ <= CTreal * rhoReal ^ j := by
          apply mul_le_mul_of_nonneg_right
          · dsimp only [CTreal]
            linarith
          · exact pow_nonneg hrhoReal.1 _
    have hbase := q4ActiveDyadicMaximal_memLp_and_eLpNorm_le_ltwoReal_of_active_multipliers
      (by omega) hj hE hEne hcover hCcover (by norm_num) hdeltaone hs
      (absoluteDyadicBandpass phi hphiOne hphiZero j)
      (absoluteDyadicBandpass_compact phi hphiOne hphiZero j)
      hCendpoint (by simpa only using hendpointDecay)
      (by
        dsimp only [Bendpointj, q4EnlargedPairMultiplierBound]
        exact sq_nonneg _)
      (fun i hi l hl xi => by
        simpa only [Bendpointj] using
          norm_q4ActiveDyadicPairMultiplier_absoluteDyadicBandpass_le_of_sharp
            C0 hC0 hdecay0 phi hphiOne hphiZero hphiNorm j hj hE i hi l hl xi)
      hCderivative (by simpa only using hderivativeDecay)
      (by
        dsimp only [Bderivativej,
          q4PlanarEnlargedScaledNormalizedDerivativePairMultiplierBound]
        exact sq_nonneg _)
      (fun u hu i hi l hl xi => by
        simpa only [Bderivativej] using
          norm_q4ActiveDyadicScaledNormalizedDerivativePairMultiplier_absoluteDyadicBandpass_le_planar_signed_on_half
            C1 hC1 hderiv1 phi hphiOne hphiZero hphiNorm j hj hE
              u hu i hi l hl xi)
      hu1 hu2 houtput f
    refine ⟨hbase.1, ?_⟩
    simpa only [CTreal, rhoReal] using
      (q4_active_ltwo_eLpNorm_le_of_ltwoReal_strict_rate
        (d := 2) (E := E) (gamma := (1 / 2 : Real)) (eta := eta)
        (Ccover := Ccover) (Cendpoint := Cendpoint) (Bendpoint := Bendpointj)
        (Cderivative := Cderivative) (Bderivative := Bderivativej)
        (psi := absoluteDyadicBandpass phi hphiOne hphiZero j) (f := f)
        (r := 2 / theta) (C := CTreal) (a := combined) hCTreal.le
        hcoefficient' hbase.2)

/-- Existential packaging of the fixed-cutoff rate.  Applications which need
two nearby output exponents should instead first choose the cutoff with
`exists_normRadial_schwartz_frequency_cutoff_norm_le_one` and apply
`q4_active_ltwo_strict_dyadic_rate_of_fixed_normRadial_cutoff` twice; that
keeps both estimates on exactly the same maximal operator. -/
theorem exists_q4_active_ltwo_strict_dyadic_rate_of_theoremOne_inputs
    {d : Nat} {E : Set Real} {gamma eta Ccover : Real}
    (hd : 3 <= d ∨ d = 2 ∧ gamma < 1 / 2)
    (hE : E ⊆ Icc (1 : Real) 2) (hEne : E.Nonempty)
    (hcover : HasSubpowerAssouadCoverBound E gamma eta Ccover)
    (hCcover : 0 <= Ccover) (hgamma : 0 <= gamma) (heta : 0 <= eta)
    {u r : Real} (hu1 : 1 < u) (hu2 : u < 2)
    (hr : r = u / (u - 1))
    (ha : q4FrequencyExponentWithSubpowerLoss d (2 / r) eta < 0)
    (hb : q4GapExponent d gamma (2 / r) < 0) :
    ∃ (phi : SchwartzMap (Euclidean d) Complex)
      (hphiOne : ∀ xi, ‖xi‖ <= 1 -> phi xi = 1)
      (hphiZero : ∀ xi, 2 <= ‖xi‖ -> phi xi = 0)
      (hphiNorm : ∀ xi, ‖phi xi‖ <= 1),
      IsNormRadial phi ∧ ∃ CT rho : ENNReal, 0 < CT ∧ CT < ⊤ ∧ rho < 1 ∧
        ∀ j : Nat, 1 <= j -> ∀ f : SchwartzMap (Euclidean d) Complex,
          MemLp (fractalDyadicBandpassMaximal d E
            (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
            (ENNReal.ofReal r) volume ∧
          eLpNorm (fractalDyadicBandpassMaximal d E
            (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
            (ENNReal.ofReal r) volume <=
            CT * rho ^ j * ENNReal.ofReal
              (Real.sqrt (∫ x, ‖(f : Euclidean d -> Complex) x‖ ^ (2 : Nat))) := by
  obtain ⟨phi, hphiOne, hphiZero, hphiNorm, hphiRadial⟩ :=
    exists_normRadial_schwartz_frequency_cutoff_norm_le_one d
  refine ⟨phi, hphiOne, hphiZero, hphiNorm, hphiRadial, ?_⟩
  obtain ⟨CT, rho, hCT, hCTtop, hrho, _hrhoeq, hbound⟩ :=
    q4_active_ltwo_strict_dyadic_rate_of_fixed_normRadial_cutoff
      phi hphiOne hphiZero hphiNorm hphiRadial hd hE hEne hcover hCcover
      hgamma heta hu1 hu2 hr ha hb
  exact ⟨CT, rho, hCT, hCTtop, hrho, hbound⟩

end

