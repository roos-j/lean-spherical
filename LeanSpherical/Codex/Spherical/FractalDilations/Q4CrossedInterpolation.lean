    (htwo : ∀ f : ι → X → ℂ,
      ‖U f‖ ≤ B * q4FibreL2Size μ s f)
    (G : Q4AmplitudeData μ s g) (Hdata : Q4AmplitudeData μ s h) :
    ‖q4KernelTTStarBilinear μ s R K g h‖ ≤
      (B * (G.threshold ^ ((2 - G.p) / 2) * G.moment ^ ((1 : ℝ) / 2)) +
        A * (G.threshold ^ (1 - G.p) * G.moment)) *
      (B * (Hdata.threshold ^ ((2 - Hdata.p) / 2) *
          Hdata.moment ^ ((1 : ℝ) / 2)) +
        A * (Hdata.threshold ^ (1 - Hdata.p) * Hdata.moment)) := by
  have hG : ‖U g‖ ≤
      B * (G.threshold ^ ((2 - G.p) / 2) * G.moment ^ ((1 : ℝ) / 2)) +
        A * (G.threshold ^ (1 - G.p) * G.moment) := by
    exact norm_le_of_factor_one_two_amplitude_data U
      (q4FibreL1Size μ s) (q4FibreL2Size μ s) A B G.moment G.p G.threshold
      G.low G.high g hsub hone htwo ⟨hA, hB⟩
      ⟨G.split, G.low_two, G.high_one⟩
  have hH : ‖U h‖ ≤
      B * (Hdata.threshold ^ ((2 - Hdata.p) / 2) *
          Hdata.moment ^ ((1 : ℝ) / 2)) +
        A * (Hdata.threshold ^ (1 - Hdata.p) * Hdata.moment) := by
    exact norm_le_of_factor_one_two_amplitude_data U
      (q4FibreL1Size μ s) (q4FibreL2Size μ s) A B Hdata.moment Hdata.p
      Hdata.threshold Hdata.low Hdata.high h hsub hone htwo ⟨hA, hB⟩
      ⟨Hdata.split, Hdata.low_two, Hdata.high_one⟩
  apply norm_q4KernelTTStarBilinear_le_of_factor_bounds μ s R K U g h hfactor
  · exact add_nonneg
      (mul_nonneg hB (mul_nonneg (Real.rpow_nonneg G.threshold_nonneg _)
        (Real.rpow_nonneg G.moment_nonneg _)))
      (mul_nonneg hA (mul_nonneg (Real.rpow_nonneg G.threshold_nonneg _)
        G.moment_nonneg))
  · exact hG
  · exact hH

/-- Fully concrete level-set form of the continuous crossed interpolation
step.  It uses the canonical low/high truncations of the two finite families
of measurable fields, so its conclusion is directly about the literal
integral `q4KernelTTStarBilinear`.  The endpoint hypotheses are bounds for a
Hilbert `TT*` factor; the preceding kernel and energy bridge lemmas supply
those bounds in the spherical application. -/
theorem norm_q4KernelTTStarBilinear_le_of_canonical_factor_amplitude_data
    {ι X H : Type*} [Sub X] [MeasurableSpace X]
    [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (μ : Measure X) (s : Finset ι) (R : ι → ι → Prop) [DecidableRel R]
    (K : ι → ι → X → ℂ) (U : (ι → X → ℂ) → H)
    (g h : ι → X → ℂ)
    {A B p tg th : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hp0 : 0 < p) (hp1 : 1 ≤ p) (hp2 : p ≤ 2)
    (htg : 0 < tg) (hth : 0 < th)
    (hfactor : ∀ f k,
      q4KernelTTStarBilinear μ s R K f k = inner ℂ (U f) (U k))
    (hsub : ∀ f k : ι → X → ℂ, ‖U (f + k)‖ ≤ ‖U f‖ + ‖U k‖)
    (hone : ∀ f : ι → X → ℂ,
      ‖U f‖ ≤ A * q4FibreL1Size μ s f)
    (htwo : ∀ f : ι → X → ℂ,
      ‖U f‖ ≤ B * q4FibreL2Size μ s f)
    (glow : ∀ i ∈ s, Integrable (fun x => ‖q4AmplitudeLow tg g i x‖ ^ 2) μ)
    (glow_major : ∀ i ∈ s, Integrable (fun x =>
      tg ^ (2 - p) * ‖g i x‖ ^ p) μ)
    (ghigh : ∀ i ∈ s, Integrable (fun x => ‖q4AmplitudeHigh tg g i x‖) μ)
    (ghigh_major : ∀ i ∈ s, Integrable (fun x =>
      tg ^ (1 - p) * ‖g i x‖ ^ p) μ)
    (hlow : ∀ i ∈ s, Integrable (fun x => ‖q4AmplitudeLow th h i x‖ ^ 2) μ)
    (hlow_major : ∀ i ∈ s, Integrable (fun x =>
      th ^ (2 - p) * ‖h i x‖ ^ p) μ)
    (hhigh : ∀ i ∈ s, Integrable (fun x => ‖q4AmplitudeHigh th h i x‖) μ)
    (hhigh_major : ∀ i ∈ s, Integrable (fun x =>
      th ^ (1 - p) * ‖h i x‖ ^ p) μ) :
    ‖q4KernelTTStarBilinear μ s R K g h‖ ≤
      (B * (tg ^ ((2 - p) / 2) *
          q4FibreLpMoment μ s p g ^ ((1 : ℝ) / 2)) +
        A * (tg ^ (1 - p) * q4FibreLpMoment μ s p g)) *
      (B * (th ^ ((2 - p) / 2) *
          q4FibreLpMoment μ s p h ^ ((1 : ℝ) / 2)) +
        A * (th ^ (1 - p) * q4FibreLpMoment μ s p h)) := by
  let G : Q4AmplitudeData μ s g :=
    q4CanonicalAmplitudeData μ s g hp0 hp1 hp2 htg
      glow glow_major ghigh ghigh_major
  let Hdata : Q4AmplitudeData μ s h :=
    q4CanonicalAmplitudeData μ s h hp0 hp1 hp2 hth
      hlow hlow_major hhigh hhigh_major
  have hmain := norm_q4KernelTTStarBilinear_le_of_factor_amplitude_data
    μ s R K U g h hA hB hfactor hsub hone htwo G Hdata
  simpa [G, Hdata, q4CanonicalAmplitudeData] using hmain

end

end LeanSpherical.HarmonicAnalysis.FractalDilations
