        apply ENNReal.ofReal_le_ofReal
        apply mul_le_mul_of_nonneg_right
        · linarith [ENNReal.toReal_nonneg (a := K)]
        · exact hI
      _ = ENNReal.ofReal (C * I) := by rfl
  simpa only [T, C, I] using
    memLp_and_integral_of_lintegral_rpow_bound (T f)
      hTfmeas.aestronglyMeasurable (hTnonneg f) hp0 hlinC
      (mul_nonneg (by linarith [ENNReal.toReal_nonneg (a := K)]) hI)

end

end LeanSpherical.HarmonicAnalysis.FractalDilations
