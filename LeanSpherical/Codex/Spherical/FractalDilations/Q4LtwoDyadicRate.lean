      (a * (j : Real) + b * (n : Real)) :=
    mul_nonneg hA (Real.rpow_nonneg (by norm_num) _)
  have htop : x ≠ ∞ :=
    ne_of_lt (lt_of_le_of_lt hx ENNReal.ofReal_lt_top)
  calc
    x.toReal <= (ENNReal.ofReal
        (A * (2 : Real) ^ (a * (j : Real) + b * (n : Real)))).toReal :=
      (ENNReal.toReal_le_toReal htop ENNReal.ofReal_ne_top).mpr hx
    _ = A * (2 : Real) ^ (a * (j : Real) + b * (n : Real)) :=
      ENNReal.toReal_ofReal hright

