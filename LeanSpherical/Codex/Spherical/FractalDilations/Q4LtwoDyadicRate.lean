/-- A decreasing radius-gap geometric series gives a uniform bound for the
finite shell range used in the Q4 decomposition. -/
theorem q4_real_geometric_shell_sum_le
    {A a b : Real} (hA : 0 <= A) (hb : b < 0) (j : Nat) :
    (∑ n ∈ Finset.range (j + 3),
      A * (2 : Real) ^ (a * (j : Real) + b * (n : Real))) <=
      (A * (1 - (2 : Real) ^ b)⁻¹) *
        (2 : Real) ^ (a * (j : Real)) := by
  let r : Real := (2 : Real) ^ b
  have hr0 : 0 <= r := by
    dsimp only [r]
    exact Real.rpow_nonneg (by norm_num) _
  have hr1 : r < 1 := by
    dsimp only [r]
    exact Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) hb
  have hfrequency : 0 <= (2 : Real) ^ (a * (j : Real)) :=
    Real.rpow_nonneg (by norm_num) _
  have hgeometric :
      (∑ n ∈ Finset.range (j + 3), r ^ n) <= (1 - r)⁻¹ :=
    finset_sum_geometric_le hr0 hr1 (Finset.range (j + 3))
  calc
    (∑ n ∈ Finset.range (j + 3),
        A * (2 : Real) ^ (a * (j : Real) + b * (n : Real))) =
        (A * (2 : Real) ^ (a * (j : Real))) *
          ∑ n ∈ Finset.range (j + 3), r ^ n := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro n hn
      dsimp only [r]
      rw [← Real.rpow_mul_natCast (by norm_num : (0 : Real) <= 2) b n]
      rw [← Real.rpow_add (by norm_num : (0 : Real) < 2)]
      ring
    _ <= (A * (2 : Real) ^ (a * (j : Real))) * (1 - r)⁻¹ :=
      mul_le_mul_of_nonneg_left hgeometric (mul_nonneg hA hfrequency)
    _ = (A * (1 - (2 : Real) ^ b)⁻¹) *
        (2 : Real) ^ (a * (j : Real)) := by
      dsimp only [r]
      ring

/-- Taking a real value out of an `ENNReal` level coefficient is legitimate
once it is bounded by a finite explicit normal form. -/
