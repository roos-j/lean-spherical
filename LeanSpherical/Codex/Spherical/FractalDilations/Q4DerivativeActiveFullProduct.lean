/-- The same fixed-offset canonical bridge with the coefficient in the
natural `ENNReal` form produced by the crossed shell summation.  This is
still the full-product estimate, so it retains the coefficient itself; the
square root is introduced only after the diagonal energy identity. -/
theorem q4ActiveDyadicScaledNormalizedDerivativeCanonicalFullProduct_rootMoment_le_of_eLpStrongENNReal
    {d : Nat} (E : Set Real) (j : Nat)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (u q qdual : Real) (hq : 1 < q) (hqtwo : 2 <= q)
    (hqdual : 0 < qdual) (hmul : (q - 1) * qdual = q)
    (C : ENNReal) (hC : C ≠ ⊤)
    (f : SchwartzMap (Euclidean d) Complex)
    (hstrong :
      eLpNorm
        (q4FiniteProductKernelShell volume (activeDyadicIndices E j) (fun _ _ => True)
          (q4ActiveDyadicScaledNormalizedDerivativePairKernel psi j u)
          (q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
            E j psi hpsiCompact u q f))
        (ENNReal.ofReal q) (q4ActiveDyadicProductCountingMeasure d E j) <=
      C * eLpNorm
        (q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
          E j psi hpsiCompact u q f)
        (ENNReal.ofReal qdual) (q4ActiveDyadicProductCountingMeasure d E j)) :
    (q4FibreLpMoment volume (activeDyadicIndices E j) q
      (q4FiniteProductToFibres (activeDyadicIndices E j)
        (q4FiniteProductKernelShell volume (activeDyadicIndices E j) (fun _ _ => True)
          (q4ActiveDyadicScaledNormalizedDerivativePairKernel psi j u)
          (q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
            E j psi hpsiCompact u q f)))) ^ (1 / q) <=
      C.toReal *
        (q4FibreLpMoment volume (activeDyadicIndices E j) qdual
          (q4PowerDualField q
            (q4ActiveDyadicScaledNormalizedDerivativeSchwartzAnalysisField
              psi hpsiCompact j u f))) ^ (1 / qdual) := by
  have hD : 0 <= C.toReal := ENNReal.toReal_nonneg
  apply q4ActiveDyadicScaledNormalizedDerivativeCanonicalFullProduct_rootMoment_le_of_eLpStrong
    E j psi hpsiCompact u q qdual C.toReal hq hqtwo hqdual hmul hD f
  rw [← ENNReal.ofReal_toReal hC] at hstrong
  exact hstrong

/-- The preceding full-product coefficient written in the square form used
by the finite-product `TT*` energy calculation.  This is merely the exact
identity `C = (sqrt C)^2`; no estimate is weakened here. -/
theorem q4ActiveDyadicScaledNormalizedDerivativeCanonicalFullProduct_rootMoment_le_of_eLpStrongENNReal_sq
    {d : Nat} (E : Set Real) (j : Nat)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (u q qdual : Real) (hq : 1 < q) (hqtwo : 2 <= q)
    (hqdual : 0 < qdual) (hmul : (q - 1) * qdual = q)
    (C : ENNReal) (hC : C ≠ ⊤)
    (f : SchwartzMap (Euclidean d) Complex)
    (hstrong :
      eLpNorm
        (q4FiniteProductKernelShell volume (activeDyadicIndices E j) (fun _ _ => True)
          (q4ActiveDyadicScaledNormalizedDerivativePairKernel psi j u)
          (q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
            E j psi hpsiCompact u q f))
        (ENNReal.ofReal q) (q4ActiveDyadicProductCountingMeasure d E j) <=
      C * eLpNorm
        (q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
          E j psi hpsiCompact u q f)
        (ENNReal.ofReal qdual) (q4ActiveDyadicProductCountingMeasure d E j)) :
    (q4FibreLpMoment volume (activeDyadicIndices E j) q
      (q4FiniteProductToFibres (activeDyadicIndices E j)
        (q4FiniteProductKernelShell volume (activeDyadicIndices E j) (fun _ _ => True)
          (q4ActiveDyadicScaledNormalizedDerivativePairKernel psi j u)
          (q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
            E j psi hpsiCompact u q f)))) ^ (1 / q) <=
      (Real.sqrt C.toReal) * (Real.sqrt C.toReal) *
        (q4FibreLpMoment volume (activeDyadicIndices E j) qdual
          (q4PowerDualField q
            (q4ActiveDyadicScaledNormalizedDerivativeSchwartzAnalysisField
              psi hpsiCompact j u f))) ^ (1 / qdual) := by
  have hroot :=
    q4ActiveDyadicScaledNormalizedDerivativeCanonicalFullProduct_rootMoment_le_of_eLpStrongENNReal
      E j psi hpsiCompact u q qdual hq hqtwo hqdual hmul C hC f hstrong
  have hsq : (Real.sqrt C.toReal) * (Real.sqrt C.toReal) = C.toReal := by
    rw [← pow_two]
    exact Real.sq_sqrt ENNReal.toReal_nonneg
  rw [hsq]
  exact hroot

/-- The paper's literal derivative kernel and multiplier estimates imply the
