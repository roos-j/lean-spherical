      ‖q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
        E j psi hpsiCompact u q f z‖ ^ (2 : Nat))
      (q4ActiveDyadicProductCountingMeasure d E j) := by
  unfold q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
  apply integrable_norm_sq_q4FibresToFiniteProduct_of_fibres
  · exact measurable_q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
      E j psi hpsiCompact u q hq f
  · intro i hi
    exact (q4PowerDualField_mem_Q4PhysicalDualCarrier q hq
      (fun k => q4ScaledNormalizedDyadicSurfaceRadiusDerivativeSchwartzPiece
        psi hpsiCompact j (dyadicLeft j k + u) f) i).2.1

/-- Every active physical fibre of the canonical derivative dual product is
an honest `L¹ ∩ L²` function. -/
theorem q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField_fibre_regular
    {d : Nat} (E : Set Real) (j : Nat)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (u q : Real) (hq : 2 <= q) (f : SchwartzMap (Euclidean d) Complex)
    (i : Int) (hi : i ∈ activeDyadicIndices E j) :
    Integrable (q4FiniteProductToFibres (activeDyadicIndices E j)
      (q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
        E j psi hpsiCompact u q f) i) volume /\
      MemLp (q4FiniteProductToFibres (activeDyadicIndices E j)
        (q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
          E j psi hpsiCompact u q f) i) 2 volume := by
  rw [q4FiniteProductToFibres_q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
    E j psi hpsiCompact u q f i hi]
  exact ⟨(q4PowerDualField_mem_Q4PhysicalDualCarrier q hq
      (fun k => q4ScaledNormalizedDyadicSurfaceRadiusDerivativeSchwartzPiece
        psi hpsiCompact j (dyadicLeft j k + u) f) i).1,
    (q4PowerDualField_mem_Q4PhysicalDualCarrier q hq
      (fun k => q4ScaledNormalizedDyadicSurfaceRadiusDerivativeSchwartzPiece
        psi hpsiCompact j (dyadicLeft j k + u) f) i).2.1⟩

/-- The `q'` power moment of the canonical derivative dual product is
integrable whenever `(q - 1) q' = q`.  This is the exact power identity in
the `TT*` dual test, not an auxiliary input assumption. -/
theorem integrable_norm_rpow_q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
    {d : Nat} (E : Set Real) (j : Nat)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (u q qdual : Real) (hq : 1 < q) (hqtwo : 2 <= q) (hqdual : 0 <= qdual)
    (hmul : (q - 1) * qdual = q)
    (f : SchwartzMap (Euclidean d) Complex) :
    Integrable (fun z =>
      ‖q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
        E j psi hpsiCompact u q f z‖ ^ qdual)
      (q4ActiveDyadicProductCountingMeasure d E j) := by
  let F : Int -> SchwartzMap (Euclidean d) Complex := fun i =>
    q4ScaledNormalizedDyadicSurfaceRadiusDerivativeSchwartzPiece
      psi hpsiCompact j (dyadicLeft j i + u) f
  have hqpos : 0 < q := lt_trans zero_lt_one hq
  have hmeas : Measurable (q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
      E j psi hpsiCompact u q f) :=
    measurable_q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
      E j psi hpsiCompact u q hqtwo f
  apply integrable_norm_rpow_q4FibresToFiniteProduct_of_fibres
    (activeDyadicIndices E j) (q4PowerDualField q (fun i => (F i : Euclidean d -> Complex)))
    (by simpa only [F, q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField,
      q4ActiveDyadicScaledNormalizedDerivativeSchwartzAnalysisField] using hmeas)
    hqdual
  intro i hi
  have hmem : MemLp (F i : Euclidean d -> Complex) (ENNReal.ofReal q) volume :=
    (F i).memLp (ENNReal.ofReal q) volume
  have hsource : Integrable (fun x : Euclidean d => ‖F i x‖ ^ q) volume := by
    have hraw := hmem.integrable_norm_rpow
      (ENNReal.ofReal_ne_zero_iff.mpr hqpos) ENNReal.ofReal_ne_top
    simpa only [ENNReal.toReal_ofReal hqpos.le] using hraw
  refine hsource.congr ?_
  filter_upwards with x
  rw [norm_q4PowerDualField q hq (fun k => (F k : Euclidean d -> Complex)) i x,
    ← Real.rpow_mul (norm_nonneg (F i x))]
  rw [hmul]

/-- The literal full derivative product shell on its canonical power-dual
input is a.e.-strongly measurable without a global multiplier hypothesis.
Each physical fibre is identified with the completed `L²` analysis--synthesis
representative, and the finite counting product then reassembles those
measurable fibres. -/
theorem aestronglyMeasurable_q4ActiveDyadicScaledNormalizedDerivativeFullKernelPowerDualProduct
    {d : Nat} (E : Set Real) (j : Nat)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (u q : Real) (hq : 2 <= q) (f : SchwartzMap (Euclidean d) Complex) :
    AEStronglyMeasurable
      (q4FiniteProductKernelShell volume (activeDyadicIndices E j) (fun _ _ => True)
        (q4ActiveDyadicScaledNormalizedDerivativePairKernel psi j u)
        (q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
          E j psi hpsiCompact u q f))
      (q4ActiveDyadicProductCountingMeasure d E j) := by
  let s : Finset Int := activeDyadicIndices E j
  let G : Euclidean d × {i // i ∈ s} -> Complex :=
    q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
      E j psi hpsiCompact u q f
  let P : Int -> Lp Complex 2 (volume : Measure (Euclidean d)) := fun i =>
    q4L2FiniteProductAnalysis
      (fun k => q4ScaledNormalizedDyadicSurfaceRadiusDerivativeL2Piece
        psi hpsiCompact j (dyadicLeft j k + u))
      (q4L2FiniteFibreSynthesis s
        (fun k => q4ScaledNormalizedDyadicSurfaceRadiusDerivativeAdjointL2Piece
          psi hpsiCompact j (dyadicLeft j k + u))
        (q4ActiveDyadicScaledNormalizedDerivativeSchwartzAnalysisPowerDualL2
          psi hpsiCompact j u q hq f)) i
  change AEStronglyMeasurable
    (q4FiniteProductKernelShell volume s (fun _ _ => True)
      (q4ActiveDyadicScaledNormalizedDerivativePairKernel psi j u) G)
    (q4FiniteProductCountingMeasure volume s)
  apply aestronglyMeasurable_q4FiniteProduct_of_fibres volume s
  intro i
  have hphysical :=
    q4ActiveDyadicScaledNormalizedDerivativeSchwartzPowerDualFullKernel_ae_eq_l2AnalysisSynthesis
      psi hpsiCompact j u s q hq f i.1 i.2
  have hphysical' :
      q4FiniteProductToFibres s
        (q4FiniteProductKernelShell volume s (fun _ _ => True)
          (q4ActiveDyadicScaledNormalizedDerivativePairKernel psi j u) G) i.1 =ᵐ[volume]
        (fun x : Euclidean d =>
          ((P i.1 : Lp Complex 2 (volume : Measure (Euclidean d))) :
            Euclidean d -> Complex) x) := by
    simpa only [s, G, P,
      q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField,
      q4ActiveDyadicScaledNormalizedDerivativeSchwartzAnalysisField] using hphysical
  have hslice :
      (fun x : Euclidean d =>
        q4FiniteProductKernelShell volume s (fun _ _ => True)
          (q4ActiveDyadicScaledNormalizedDerivativePairKernel psi j u) G (x, i)) =ᵐ[volume]
        (fun x : Euclidean d =>
          ((P i.1 : Lp Complex 2 (volume : Measure (Euclidean d))) :
            Euclidean d -> Complex) x) := by
    filter_upwards [hphysical'] with x hx
    simpa only [q4FiniteProductToFibres, dif_pos i.2] using hx
  exact (Lp.memLp (P i.1)).aestronglyMeasurable.congr_ae hslice.symm

/-- The literal scaled-derivative full-product estimate at one local offset
already gives the root fibre moment required by the `TT*` diagonal.  Both
input regularity and output measurability are obtained from the canonical
Schwartz power-dual field and the physical/`L²` comparison above; this
statement therefore has no carrier, arbitrary operator, or membership
assumption. -/
theorem q4ActiveDyadicScaledNormalizedDerivativeCanonicalFullProduct_rootMoment_le_of_eLpStrong
    {d : Nat} (E : Set Real) (j : Nat)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (u q qdual D : Real) (hq : 1 < q) (hqtwo : 2 <= q)
    (hqdual : 0 < qdual) (hmul : (q - 1) * qdual = q) (hD : 0 <= D)
    (f : SchwartzMap (Euclidean d) Complex)
    (hstrong :
      eLpNorm
        (q4FiniteProductKernelShell volume (activeDyadicIndices E j) (fun _ _ => True)
          (q4ActiveDyadicScaledNormalizedDerivativePairKernel psi j u)
          (q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
            E j psi hpsiCompact u q f))
        (ENNReal.ofReal q) (q4ActiveDyadicProductCountingMeasure d E j) <=
