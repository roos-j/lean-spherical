  · intro i hi
    exact (q4PowerDualField_mem_Q4PhysicalDualCarrier q hq
      (fun k => q4ScaledNormalizedDyadicSurfaceRadiusDerivativeSchwartzPiece
        psi hpsiCompact j (dyadicLeft j k + u) f) i).1

/-- The canonical derivative dual product has an integrable square, as
required by the literal physical convolution realization. -/
theorem integrable_norm_sq_q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
    {d : Nat} (E : Set Real) (j : Nat)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
