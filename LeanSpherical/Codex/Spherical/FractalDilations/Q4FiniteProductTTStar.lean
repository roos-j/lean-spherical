/-- The canonical `Lᵠ` norming field.  At the strict `Q4` exponents one has
`q > 2`, so this is an ordinary nonnegative power times the original field. -/
def q4PowerDualField
    {I X : Type*} (q : ℝ) (f : I → X → ℂ) : I → X → ℂ :=
  fun i x => ((‖f i x‖ ^ (q - 2) : ℝ) : ℂ) * f i x

/-- Pointwise norm of the canonical norming field. -/
theorem norm_q4PowerDualField
    {I X : Type*} (q : ℝ) (hq : 1 < q) (f : I → X → ℂ) (i : I) (x : X) :
    ‖q4PowerDualField q f i x‖ = ‖f i x‖ ^ (q - 1) := by
  unfold q4PowerDualField
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)]
  by_cases hz : ‖f i x‖ = 0
  · simp [hz, Real.zero_rpow (by linarith : q - 1 ≠ 0)]
  · have hpos : 0 < ‖f i x‖ := lt_of_le_of_ne (norm_nonneg _) (Ne.symm hz)
    calc
      ‖f i x‖ ^ (q - 2) * ‖f i x‖ =
          ‖f i x‖ ^ (q - 2) * ‖f i x‖ ^ (1 : Real) := by
            rw [Real.rpow_one]
      _ = ‖f i x‖ ^ ((q - 2) + 1) := (Real.rpow_add hpos _ _).symm
      _ = ‖f i x‖ ^ (q - 1) := by
        congr 1
        ring

/-- The canonical norming field realizes the pointwise `Lᵠ` pairing.  This
is the elementary identity behind the usual dual test; it is valid at zero
because `Real.rpow_add'` is used with the nonzero total exponent `q`. -/
theorem q4PowerDualField_pairing_pointwise
    {I X : Type*} (q : ℝ) (hq : 0 < q) (f : I → X → ℂ) (i : I) (x : X) :
    f i x * starRingEnd ℂ (q4PowerDualField q f i x) =
      ((‖f i x‖ ^ q : ℝ) : ℂ) := by
  unfold q4PowerDualField
  rw [starRingEnd_apply, star_mul, Complex.star_def, Complex.conj_ofReal]
  calc
    f i x * (star (f i x) * ((‖f i x‖ ^ (q - 2) : ℝ) : ℂ)) =
        ((‖f i x‖ ^ (q - 2) : ℝ) : ℂ) *
          (f i x * star (f i x)) := by ring
    _ = ((‖f i x‖ ^ (q - 2) : ℝ) : ℂ) *
          ((‖f i x‖ ^ 2 : ℝ) : ℂ) := by
      simpa only [starRingEnd_apply, ← Complex.ofReal_pow] using
        congrArg (fun z : Complex => ((‖f i x‖ ^ (q - 2) : ℝ) : Complex) * z)
          (Complex.mul_conj' (f i x))
    _ = ((‖f i x‖ ^ q : ℝ) : ℂ) := by
      rw [← Complex.ofReal_mul]
      rw [← Real.rpow_two]
      rw [← Real.rpow_add' (norm_nonneg _) (by linarith :
        (q - 2) + (2 : ℝ) ≠ 0)]
      congr 1
      ring_nf

/-- Summing the pointwise norming identity gives the exact finite-product
pairing identity.  It does not require an integrability side condition:
Bochner integration respects the real-to-complex continuous linear map even
for the conventionally defined nonintegrable integral. -/
theorem q4FiniteProductPairing_powerDualField_eq_moment
    {I X : Type*} [MeasurableSpace X]
    (μ : Measure X) (s : Finset I) (q : ℝ) (hq : 0 < q)
    (f : I → X → ℂ) :
    q4FiniteProductPairing μ s f (q4PowerDualField q f) =
      (q4FibreLpMoment μ s q f : ℂ) := by
  unfold q4FiniteProductPairing q4FibreLpMoment
  calc
    ∑ i ∈ s, ∫ x, f i x * starRingEnd ℂ (q4PowerDualField q f i x) ∂μ =
        ∑ i ∈ s, ∫ x, ((‖f i x‖ ^ q : ℝ) : ℂ) ∂μ := by
      apply Finset.sum_congr rfl
      intro i hi
      apply integral_congr_ae
      filter_upwards with x
      exact q4PowerDualField_pairing_pointwise q hq f i x
    _ = ∑ i ∈ s, ((∫ x, ‖f i x‖ ^ q ∂μ : ℝ) : ℂ) := by
      apply Finset.sum_congr rfl
      intro i hi
      exact integral_ofReal
    _ = ((∑ i ∈ s, ∫ x, ‖f i x‖ ^ q ∂μ : ℝ) : ℂ) := by
      exact (map_sum Complex.ofRealHom (fun i => ∫ x, ‖f i x‖ ^ q ∂μ) s).symm

/-- The `q'`-moment of the canonical norming field is the original
`q`-moment whenever the two exponents have the displayed multiplicative
relation. -/
theorem q4FibreLpMoment_powerDualField_eq
    {I X : Type*} [MeasurableSpace X]
    (μ : Measure X) (s : Finset I) (q qdual : ℝ) (f : I → X → ℂ)
    (hq : 1 < q) (hmul : (q - 1) * qdual = q) :
    q4FibreLpMoment μ s qdual (q4PowerDualField q f) =
      q4FibreLpMoment μ s q f := by
  unfold q4FibreLpMoment
  apply Finset.sum_congr rfl
  intro i hi
  apply integral_congr_ae
  filter_upwards with x
  calc
    ‖q4PowerDualField q f i x‖ ^ qdual =
        (‖f i x‖ ^ (q - 1)) ^ qdual := by
      rw [norm_q4PowerDualField q hq f i x]
    _ = ‖f i x‖ ^ ((q - 1) * qdual) :=
      (Real.rpow_mul (norm_nonneg _) (q - 1) qdual).symm
    _ = ‖f i x‖ ^ q := by rw [hmul]

/-- Data certifying an explicit norming test on the finite product.  The
canonical choice is `q4PowerDualField`; keeping the two integral identities
as fields makes the subsequent `TT*` lifting usable with smooth truncations
as well as with the raw power test. -/
structure Q4FiniteProductDualTest
    {I X : Type*} [MeasurableSpace X]
    (μ : Measure X) (s : Finset I) (q qdual : ℝ) (f : I → X → ℂ) where
  dual : I → X → ℂ
  pairing_eq : q4FiniteProductPairing μ s f dual =
    (q4FibreLpMoment μ s q f : ℂ)
  moment_eq : q4FibreLpMoment μ s qdual dual = q4FibreLpMoment μ s q f

/-- The raw power field supplies the finite-product dual test.  The
algebraic hypothesis is deliberately stated as `(q - 1) q' = q`, since this
is exactly the identity needed for the moment calculation and avoids hiding
any division-by-zero convention in the definition.  For conjugate finite
exponents it follows from `1 / q + 1 / q' = 1`. -/
def q4PowerDualTest
    {I X : Type*} [MeasurableSpace X]
    (μ : Measure X) (s : Finset I) (q qdual : ℝ) (f : I → X → ℂ)
    (hq : 1 < q) (hmul : (q - 1) * qdual = q) :
    Q4FiniteProductDualTest μ s q qdual f where
  dual := q4PowerDualField q f
  pairing_eq :=
    q4FiniteProductPairing_powerDualField_eq_moment μ s q
      (lt_trans zero_lt_one hq) f
  moment_eq := q4FibreLpMoment_powerDualField_eq μ s q qdual f hq hmul

/-- The standard reciprocal conjugacy equation implies the multiplicative
identity used by `q4PowerDualTest`. -/
theorem q4_mul_sub_one_eq_of_conjugate_exponents
    {q qdual : ℝ} (hq : 0 < q) (hqdual : 0 < qdual)
    (hconj : 1 / q + 1 / qdual = 1) :
    (q - 1) * qdual = q := by
  have hq0 : q ≠ 0 := ne_of_gt hq
  have hqdual0 : qdual ≠ 0 := ne_of_gt hqdual
  have h := hconj
  field_simp [hq0, hqdual0] at h
  nlinarith

/-- The elementary `Lᵠ` dual-test consequence used in the product-space
`TT*` argument.  Once the full shell is identified with `T T*`, Cauchy--
Schwarz and the strong shell estimate provide `hbilinear`; this lemma then
recovers the actual output `Lᵠ` moment without any selector or factor
interpolation. -/
theorem q4FibreLpMoment_rpow_one_div_le_of_dual_test_at_test
    {I X : Type*} [MeasurableSpace X]
    (μ : Measure X) (s : Finset I) {q qdual C F : ℝ}
    (hq : 0 < q) (_hqdual : 0 < qdual)
    (hconj : 1 / q + 1 / qdual = 1) (hCF : 0 ≤ C * F)
    (f : I → X → ℂ) (test : Q4FiniteProductDualTest μ s q qdual f)
    (hbilinear : ‖q4FiniteProductPairing μ s f test.dual‖ ≤
      C * F * (q4FibreLpMoment μ s qdual test.dual) ^ (1 / qdual)) :
    (q4FibreLpMoment μ s q f) ^ (1 / q) ≤ C * F := by
  let M : ℝ := q4FibreLpMoment μ s q f
  have hM0 : 0 ≤ M := by
    simpa only [M] using q4FibreLpMoment_nonneg μ s q f
  by_cases hM : M = 0
  · have hroot : 0 < 1 / q := one_div_pos.mpr hq
    change M ^ (1 / q) ≤ C * F
    rw [hM, Real.zero_rpow (ne_of_gt hroot)]
    exact hCF
  · have hMpos : 0 < M := lt_of_le_of_ne hM0 (Ne.symm hM)
    have htest := hbilinear
    rw [test.pairing_eq, test.moment_eq] at htest
    change ‖(M : ℂ)‖ ≤ C * F * M ^ (1 / qdual) at htest
    have hnorm : ‖(M : ℂ)‖ = M := by
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hM0]
    rw [hnorm] at htest
    have hsplit : M ^ (1 / q) * M ^ (1 / qdual) = M := by
      rw [← Real.rpow_add hMpos, hconj, Real.rpow_one]
    have hdualpos : 0 < M ^ (1 / qdual) :=
      Real.rpow_pos_of_pos hMpos _
    apply le_of_mul_le_mul_right ?_ hdualpos
    calc
      (M ^ (1 / q)) * M ^ (1 / qdual) = M := hsplit
      _ ≤ C * F * M ^ (1 / qdual) := htest

/-- Uniform bilinear control is a convenient sufficient form of the
single-dual-test lemma above. -/
theorem q4FibreLpMoment_rpow_one_div_le_of_dual_test
    {I X : Type*} [MeasurableSpace X]
    (μ : Measure X) (s : Finset I) {q qdual C F : ℝ}
    (hq : 0 < q) (hqdual : 0 < qdual)
    (hconj : 1 / q + 1 / qdual = 1) (hCF : 0 ≤ C * F)
    (f : I → X → ℂ) (test : Q4FiniteProductDualTest μ s q qdual f)
    (hbilinear : ∀ g : I → X → ℂ,
      ‖q4FiniteProductPairing μ s f g‖ ≤
        C * F * (q4FibreLpMoment μ s qdual g) ^ (1 / qdual)) :
    (q4FibreLpMoment μ s q f) ^ (1 / q) ≤ C * F := by
  exact q4FibreLpMoment_rpow_one_div_le_of_dual_test_at_test
    μ s hq hqdual hconj hCF f test (hbilinear test.dual)

/-- Cauchy--Schwarz applied after the literal finite-product adjoint
identity.  This is the `T*` half of the paper's `TT*` lifting, before the
strict shell estimate is inserted. -/
theorem norm_q4FiniteProductPairing_analysis_le_of_adjoint_eq
    {I X : Type*} [MeasurableSpace X] [DecidableEq I]
    (μ : Measure X) (s : Finset I)
    (T Tstar : I → (X → ℂ) →ₗ[ℂ] (X → ℂ))
    (u : X → ℂ) (g : I → X → ℂ)
    (hadj : q4FiniteProductPairing μ s (fun i => T i u) g =
      ∫ x, u x * starRingEnd ℂ (q4FiniteFibreSynthesis s Tstar g x) ∂μ)
    (hu : MemLp u 2 μ)
    (hg : MemLp (q4FiniteFibreSynthesis s Tstar g) 2 μ) :
    ‖q4FiniteProductPairing μ s (fun i => T i u) g‖ ≤
      √(∫ x, ‖u x‖ ^ 2 ∂μ) *
        √(∫ x, ‖q4FiniteFibreSynthesis s Tstar g x‖ ^ 2 ∂μ) := by
  rw [hadj]
  calc
    ‖∫ x, u x * starRingEnd ℂ (q4FiniteFibreSynthesis s Tstar g x) ∂μ‖ ≤
        ∫ x, ‖u x * starRingEnd ℂ (q4FiniteFibreSynthesis s Tstar g x)‖ ∂μ :=
      norm_integral_le_integral_norm _
    _ = ∫ x, ‖u x‖ * ‖q4FiniteFibreSynthesis s Tstar g x‖ ∂μ := by
      apply integral_congr_ae
      filter_upwards with x
      rw [norm_mul, starRingEnd_apply, norm_star]
    _ ≤ √(∫ x, ‖u x‖ ^ 2 ∂μ) *
        √(∫ x, ‖q4FiniteFibreSynthesis s Tstar g x‖ ^ 2 ∂μ) := by
      simpa [Real.sqrt_eq_rpow] using
        (integral_mul_norm_le_Lp_mul_Lq
          (μ := μ) (f := u) (g := q4FiniteFibreSynthesis s Tstar g)
          (p := 2) (q := 2)
          (by norm_num [Real.holderConjugate_iff])
          (by simpa using hu) (by simpa using hg))

/-- The preceding Cauchy--Schwarz estimate under the globally stated formal
adjoint identity. -/
theorem norm_q4FiniteProductPairing_analysis_le_of_formalAdjoint
    {I X : Type*} [MeasurableSpace X] [DecidableEq I]
    (μ : Measure X) (s : Finset I)
    (T Tstar : I → (X → ℂ) →ₗ[ℂ] (X → ℂ))
    (hadj : IsQ4FiniteProductFormalAdjoint μ s T Tstar)
    (u : X → ℂ) (g : I → X → ℂ)
    (hu : MemLp u 2 μ)
    (hg : MemLp (q4FiniteFibreSynthesis s Tstar g) 2 μ) :
    ‖q4FiniteProductPairing μ s (fun i => T i u) g‖ ≤
      √(∫ x, ‖u x‖ ^ 2 ∂μ) *
        √(∫ x, ‖q4FiniteFibreSynthesis s Tstar g x‖ ^ 2 ∂μ) := by
  exact norm_q4FiniteProductPairing_analysis_le_of_adjoint_eq
    μ s T Tstar u g (hadj u g) hu hg

/-- The synthesis `L^{q'}`-to-`L²` estimate gives the bilinear estimate
needed by the power dual test.  This is the exact Cauchy--Schwarz bridge from
the gap-summed `TT*` estimate to the analysis operator; it has no selector
and no endpoint interpolation input. -/
theorem q4FiniteProduct_analysis_bilinear_bound_of_adjoint_synthesis
    {I X : Type*} [MeasurableSpace X] [DecidableEq I]
    (μ : Measure X) (s : Finset I)
    (T Tstar : I → (X → ℂ) →ₗ[ℂ] (X → ℂ))
    (hadj : IsQ4FiniteProductFormalAdjoint μ s T Tstar)
    (u : X → ℂ) {qdual C F : ℝ}
    (hF : 0 ≤ F)
    (hu : MemLp u 2 μ)
    (hsource : √(∫ x, ‖u x‖ ^ 2 ∂μ) ≤ F)
    (hsynthesis_mem : ∀ g : I → X → ℂ,
      MemLp (q4FiniteFibreSynthesis s Tstar g) 2 μ)
    (hsynthesis : ∀ g : I → X → ℂ,
      √(∫ x, ‖q4FiniteFibreSynthesis s Tstar g x‖ ^ 2 ∂μ) ≤
        C * (q4FibreLpMoment μ s qdual g) ^ (1 / qdual)) :
    ∀ g : I → X → ℂ,
      ‖q4FiniteProductPairing μ s (fun i => T i u) g‖ ≤
        C * F * (q4FibreLpMoment μ s qdual g) ^ (1 / qdual) := by
  intro g
  calc
    ‖q4FiniteProductPairing μ s (fun i => T i u) g‖ ≤
        √(∫ x, ‖u x‖ ^ 2 ∂μ) *
          √(∫ x, ‖q4FiniteFibreSynthesis s Tstar g x‖ ^ 2 ∂μ) :=
      norm_q4FiniteProductPairing_analysis_le_of_formalAdjoint
        μ s T Tstar hadj u g hu (hsynthesis_mem g)
    _ ≤ F * (C * (q4FibreLpMoment μ s qdual g) ^ (1 / qdual)) :=
      mul_le_mul hsource (hsynthesis g) (Real.sqrt_nonneg _) hF
    _ = C * F * (q4FibreLpMoment μ s qdual g) ^ (1 / qdual) := by ring

/-- The finite-product `TT*` lifting used at the strict `Q4` exponents.
The only analytic hypothesis is the genuine synthesis estimate produced by
the paper's shell decomposition.  The conclusion is the strong finite
product `L² → Lᵠ` bound for the actual radius family. -/
theorem q4FiniteProductAnalysis_moment_le_of_formalAdjoint_synthesis
    {I X : Type*} [MeasurableSpace X] [DecidableEq I]
    (μ : Measure X) (s : Finset I)
    (T Tstar : I → (X → ℂ) →ₗ[ℂ] (X → ℂ))
    (hadj : IsQ4FiniteProductFormalAdjoint μ s T Tstar)
    (u : X → ℂ) {q qdual C F : ℝ}
    (hq : 1 < q) (hqdual : 0 < qdual)
    (hconj : 1 / q + 1 / qdual = 1) (hCF : 0 ≤ C * F)
    (hF : 0 ≤ F) (hu : MemLp u 2 μ)
    (hsource : √(∫ x, ‖u x‖ ^ 2 ∂μ) ≤ F)
    (hsynthesis_mem : ∀ g : I → X → ℂ,
      MemLp (q4FiniteFibreSynthesis s Tstar g) 2 μ)
    (hsynthesis : ∀ g : I → X → ℂ,
      √(∫ x, ‖q4FiniteFibreSynthesis s Tstar g x‖ ^ 2 ∂μ) ≤
        C * (q4FibreLpMoment μ s qdual g) ^ (1 / qdual)) :
    (q4FibreLpMoment μ s q (fun i => T i u)) ^ (1 / q) ≤ C * F := by
  have hmul : (q - 1) * qdual = q :=
    q4_mul_sub_one_eq_of_conjugate_exponents
      (lt_trans zero_lt_one hq) hqdual hconj
  apply q4FibreLpMoment_rpow_one_div_le_of_dual_test μ s
    (lt_trans zero_lt_one hq) hqdual hconj hCF
    (fun i => T i u)
    (q4PowerDualTest μ s q qdual (fun i => T i u) hq hmul)
  exact q4FiniteProduct_analysis_bilinear_bound_of_adjoint_synthesis
    μ s T Tstar hadj u hF hu hsource hsynthesis_mem hsynthesis

/-- The preceding lifting expressed on the literal product field
`X × s`, rather than its canonically equivalent active fibres. -/
theorem q4FiniteProductAnalysis_product_moment_le_of_formalAdjoint_synthesis
    {I X : Type*} [MeasurableSpace X] [DecidableEq I]
    (μ : Measure X) (s : Finset I)
    (T Tstar : I → (X → ℂ) →ₗ[ℂ] (X → ℂ))
    (hadj : IsQ4FiniteProductFormalAdjoint μ s T Tstar)
    (u : X → ℂ) {q qdual C F : ℝ}
    (hq : 1 < q) (hqdual : 0 < qdual)
    (hconj : 1 / q + 1 / qdual = 1) (hCF : 0 ≤ C * F)
    (hF : 0 ≤ F) (hu : MemLp u 2 μ)
    (hsource : √(∫ x, ‖u x‖ ^ 2 ∂μ) ≤ F)
    (hsynthesis_mem : ∀ g : I → X → ℂ,
      MemLp (q4FiniteFibreSynthesis s Tstar g) 2 μ)
    (hsynthesis : ∀ g : I → X → ℂ,
      √(∫ x, ‖q4FiniteFibreSynthesis s Tstar g x‖ ^ 2 ∂μ) ≤
        C * (q4FibreLpMoment μ s qdual g) ^ (1 / qdual)) :
    (q4FibreLpMoment μ s q
      (q4FiniteProductToFibres s (q4FiniteProductAnalysis s T u))) ^ (1 / q) ≤
        C * F := by
  rw [q4FibreLpMoment_toFibres_analysis_eq μ s q T u]
  exact q4FiniteProductAnalysis_moment_le_of_formalAdjoint_synthesis
    μ s T Tstar hadj u hq hqdual hconj hCF hF hu hsource
    hsynthesis_mem hsynthesis

/-- A domain on which the finite-product adjoint and the gap-summed
`T* : L^{q'}(X × s) → L²(X)` estimate have actually been established.

For the spherical application this domain is first the finite family of
smooth compact (or Schwartz) test fields and is then enlarged by the proved
density/continuity extension.  The theorem below only asks that it contain
the chosen norming test; no assertion about an individual gap shell being
`T T*` is encoded here. -/
structure Q4FiniteProductSynthesisDomain
    {I X : Type*} [MeasurableSpace X] [DecidableEq I]
    (μ : Measure X) (s : Finset I)
    (T Tstar : I → (X → ℂ) →ₗ[ℂ] (X → ℂ))
    (qdual A : ℝ) where
  carrier : Set (I → X → ℂ)
  adjoint : ∀ (u : X → ℂ) (g : I → X → ℂ), g ∈ carrier →
    q4FiniteProductPairing μ s (fun i => T i u) g =
      ∫ x, u x * starRingEnd ℂ (q4FiniteFibreSynthesis s Tstar g x) ∂μ
  synthesis_mem_two : ∀ g : I → X → ℂ, g ∈ carrier →
    MemLp (q4FiniteFibreSynthesis s Tstar g) 2 μ
  synthesis_bound : ∀ g : I → X → ℂ, g ∈ carrier →
    √(∫ x, ‖q4FiniteFibreSynthesis s Tstar g x‖ ^ 2 ∂μ) ≤
      A * (q4FibreLpMoment μ s qdual g) ^ (1 / qdual)

/-- Domain-restricted finite-product duality.  This is the form suited to
the paper's Schwartz-core proof: it only invokes the synthesis estimate on
the particular dual test, rather than postulating an unproved global bound
on arbitrary measurable fields. -/
theorem q4FiniteProductAnalysis_moment_le_of_dual_domain
    {I X : Type*} [MeasurableSpace X] [DecidableEq I]
    (μ : Measure X) (s : Finset I)
    (T Tstar : I → (X → ℂ) →ₗ[ℂ] (X → ℂ))
    {q qdual A F : ℝ}
    (D : Q4FiniteProductSynthesisDomain μ s T Tstar qdual A)
    (u : X → ℂ) (test : Q4FiniteProductDualTest μ s q qdual (fun i => T i u))
    (htest : test.dual ∈ D.carrier)
    (hq : 0 < q) (hqdual : 0 < qdual)
    (hconj : 1 / q + 1 / qdual = 1) (hAF : 0 ≤ A * F)
    (hF : 0 ≤ F) (hu : MemLp u 2 μ)
    (hsource : √(∫ x, ‖u x‖ ^ 2 ∂μ) ≤ F) :
    (q4FibreLpMoment μ s q (fun i => T i u)) ^ (1 / q) ≤ A * F := by
  apply q4FibreLpMoment_rpow_one_div_le_of_dual_test_at_test
    μ s hq hqdual hconj hAF (fun i => T i u) test
  calc
    ‖q4FiniteProductPairing μ s (fun i => T i u) test.dual‖ ≤
        √(∫ x, ‖u x‖ ^ 2 ∂μ) *
          √(∫ x, ‖q4FiniteFibreSynthesis s Tstar test.dual x‖ ^ 2 ∂μ) :=
      norm_q4FiniteProductPairing_analysis_le_of_adjoint_eq
        μ s T Tstar u test.dual (D.adjoint u test.dual htest) hu
          (D.synthesis_mem_two test.dual htest)
    _ ≤ F * (A * (q4FibreLpMoment μ s qdual test.dual) ^ (1 / qdual)) :=
      mul_le_mul hsource (D.synthesis_bound test.dual htest)
        (Real.sqrt_nonneg _) hF
    _ = A * F * (q4FibreLpMoment μ s qdual test.dual) ^ (1 / qdual) := by
      ring

/-- The preceding domain-restricted theorem with the canonical `|f|^{q-2}f`
test.  Its sole extra hypothesis records the needed domain-extension step:
the raw norming field belongs to the domain on which the synthesis estimate
has been proved.  Smooth truncations instead use the preceding generic
dual-test theorem together with their separately proved limiting identities. -/
theorem q4FiniteProductAnalysis_moment_le_of_power_dual_domain
    {I X : Type*} [MeasurableSpace X] [DecidableEq I]
    (μ : Measure X) (s : Finset I)
    (T Tstar : I → (X → ℂ) →ₗ[ℂ] (X → ℂ))
    {q qdual A F : ℝ}
    (D : Q4FiniteProductSynthesisDomain μ s T Tstar qdual A)
    (u : X → ℂ) (hq : 1 < q) (hqdual : 0 < qdual)
    (hconj : 1 / q + 1 / qdual = 1) (hAF : 0 ≤ A * F)
    (hF : 0 ≤ F) (hu : MemLp u 2 μ)
    (hsource : √(∫ x, ‖u x‖ ^ 2 ∂μ) ≤ F)
    (hpower : q4PowerDualField q (fun i => T i u) ∈ D.carrier) :
    (q4FibreLpMoment μ s q (fun i => T i u)) ^ (1 / q) ≤ A * F := by
  have hmul : (q - 1) * qdual = q :=
    q4_mul_sub_one_eq_of_conjugate_exponents
      (lt_trans zero_lt_one hq) hqdual hconj
  exact q4FiniteProductAnalysis_moment_le_of_dual_domain
    μ s T Tstar D u
    (q4PowerDualTest μ s q qdual (fun i => T i u) hq hmul)
    hpower (lt_trans zero_lt_one hq) hqdual hconj hAF hF hu hsource

/-- A finite gap partition reassembles the literal product shell exactly.
The proof is the same finite reindexing as for the selected formulation, but
does not introduce a nonlinear selector. -/
theorem q4FiniteProductKernelShell_eq_sum_levelShells
    {I L X : Type*} [Sub X] [MeasurableSpace X] [DecidableEq I] [DecidableEq L]
    (μ : Measure X) (s : Finset I) (R : I → I → Prop) [DecidableRel R]
    (level : I → I → L) (levels : Finset L)
    (hlevels : ∀ i l, R i l → level i l ∈ levels)
    (K : I → I → X → ℂ) (g : X × {i // i ∈ s} → ℂ)
    (z : X × {i // i ∈ s}) :
    q4FiniteProductKernelShell μ s R K g z =
      ∑ n ∈ levels,
        q4FiniteProductKernelShell μ s
          (q4LevelShellRelation R level n) K g z := by
  unfold q4FiniteProductKernelShell
  exact q4KernelTTStarShell_eq_sum_levelShells μ s R level levels hlevels K
    (q4FiniteProductToFibres s g) z.2.1 z.1

/-- The exact finite product partition followed by the ordinary triangle
inequality.  In particular, cancellation remains inside each gap shell. -/
theorem norm_q4FiniteProductKernelShell_le_sum_levelShells
    {I L X : Type*} [Sub X] [MeasurableSpace X] [DecidableEq I] [DecidableEq L]
    (μ : Measure X) (s : Finset I) (R : I → I → Prop) [DecidableRel R]
    (level : I → I → L) (levels : Finset L)
    (hlevels : ∀ i l, R i l → level i l ∈ levels)
    (K : I → I → X → ℂ) (g : X × {i // i ∈ s} → ℂ)
    (z : X × {i // i ∈ s}) :
    ‖q4FiniteProductKernelShell μ s R K g z‖ ≤
      ∑ n ∈ levels,
        ‖q4FiniteProductKernelShell μ s
          (q4LevelShellRelation R level n) K g z‖ := by
  rw [q4FiniteProductKernelShell_eq_sum_levelShells μ s R level levels
    hlevels K g z]
  exact norm_sum_le _ _

/-- Minkowski reassembles the literal product shell from its finitely many
gap shells.  The measure is left explicit so the spherical application uses
Lebesgue measure times counting measure on the active radius set. -/
theorem eLpNorm_norm_q4FiniteProductKernelShell_le_sum_levelShells
    {I L X : Type*} [Sub X] [MeasurableSpace X] [MeasurableSpace I]
    [DecidableEq I] [DecidableEq L]
    (μ : Measure X) (s : Finset I) (ν : Measure (X × {i // i ∈ s}))
    (R : I → I → Prop) [DecidableRel R]
    (level : I → I → L) (levels : Finset L)
    (hlevels : ∀ i l, R i l → level i l ∈ levels)
    (K : I → I → X → ℂ) (g : X × {i // i ∈ s} → ℂ)
    {q : ENNReal} (hq : 1 ≤ q)
    (hmeas : ∀ n ∈ levels, AEStronglyMeasurable
      (fun z => ‖q4FiniteProductKernelShell μ s
        (q4LevelShellRelation R level n) K g z‖) ν) :
    eLpNorm (fun z => ‖q4FiniteProductKernelShell μ s R K g z‖) q ν ≤
      ∑ n ∈ levels, eLpNorm (fun z => ‖q4FiniteProductKernelShell μ s
        (q4LevelShellRelation R level n) K g z‖) q ν := by
  let S : L → X × {i // i ∈ s} → ℝ := fun n z =>
    ‖q4FiniteProductKernelShell μ s (q4LevelShellRelation R level n) K g z‖
  calc
    eLpNorm (fun z => ‖q4FiniteProductKernelShell μ s R K g z‖) q ν ≤
        eLpNorm (fun z => ∑ n ∈ levels, S n z) q ν := by
      apply eLpNorm_mono_real
      intro z
      rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
      simpa only [S] using
        norm_q4FiniteProductKernelShell_le_sum_levelShells
          μ s R level levels hlevels K g z
    _ = eLpNorm (∑ n ∈ levels, S n) q ν := by
      apply eLpNorm_congr_ae
      filter_upwards with z
      simp only [Finset.sum_apply]
    _ ≤ ∑ n ∈ levels, eLpNorm (S n) q ν :=
      eLpNorm_sum_le (f := S) (s := levels)
        (fun n hn => by simpa only [S] using hmeas n hn) hq
    _ = ∑ n ∈ levels, eLpNorm (fun z => ‖q4FiniteProductKernelShell μ s
        (q4LevelShellRelation R level n) K g z‖) q ν := by
      apply Finset.sum_congr rfl
      intro n hn
      rfl

/-- Geometric strict shell bounds sum to a uniform product-shell bound.  This
is the non-endpoint summation replacing the Bourgain restricted-weak-type
device, and applies only after the exact finite relation partition above. -/
theorem eLpNorm_norm_q4FiniteProductKernelShell_le_geometric_levelShells
    {I X : Type*} [Sub X] [MeasurableSpace X] [MeasurableSpace I]
    [DecidableEq I]
    (μ : Measure X) (s : Finset I) (ν : Measure (X × {i // i ∈ s}))
    (R : I → I → Prop) [DecidableRel R]
    (level : I → I → ℕ) (N : ℕ)
    (hlevels : ∀ i l, R i l → level i l ∈ Finset.range N)
    (K : I → I → X → ℂ) (g : X × {i // i ∈ s} → ℂ)
    {q : ENNReal} (hq : 1 ≤ q)
    (hmeas : ∀ n, AEStronglyMeasurable
      (fun z => ‖q4FiniteProductKernelShell μ s
        (q4LevelShellRelation R level n) K g z‖) ν)
    (A r : ENNReal)
    (hshell : ∀ n, eLpNorm (fun z => ‖q4FiniteProductKernelShell μ s
      (q4LevelShellRelation R level n) K g z‖) q ν ≤ A * r ^ n) :
    eLpNorm (fun z => ‖q4FiniteProductKernelShell μ s R K g z‖) q ν ≤
      A * (1 - r)⁻¹ := by
  let S : ℕ → X × {i // i ∈ s} → ℝ := fun n z =>
    ‖q4FiniteProductKernelShell μ s (q4LevelShellRelation R level n) K g z‖
  calc
    eLpNorm (fun z => ‖q4FiniteProductKernelShell μ s R K g z‖) q ν ≤
        eLpNorm (fun z => ∑ n ∈ Finset.range N, S n z) q ν := by
      apply eLpNorm_mono_real
      intro z
      rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
      simpa only [S] using
        norm_q4FiniteProductKernelShell_le_sum_levelShells
          μ s R level (Finset.range N) hlevels K g z
    _ ≤ A * (1 - r)⁻¹ := by
      apply eLpNorm_sum_range_le_geometric ν q hq S
      · intro n
        simpa only [S] using hmeas n
      · intro n
        simpa only [S] using hshell n

/-- The exact kernel-composition hypothesis for the full finite-product
operator.  In the spherical application this is the Fourier/physical-space
identity for `T^j_{t_i} (T^j_{t_l})*`. -/
def IsQ4FiniteProductPairComposition
    {I X : Type*} [Sub X] [MeasurableSpace X]
    (μ : Measure X) (K : I → I → X → ℂ)
    (T Tstar : I → (X → ℂ) →ₗ[ℂ] (X → ℂ)) : Prop :=
  ∀ i l (f : X → ℂ) x,
    T i (Tstar l f) x = q4PairwiseKernelApply μ K i l f x

/-- For the unrestricted finite family, the literal product kernel shell is
exactly `T T*`.  No positivity enters: this is just linearity of the radius
pieces and the actual pair-composition identity. -/
theorem q4FiniteProduct_analysis_synthesis_eq_fullTTStar
    {I X : Type*} [Sub X] [MeasurableSpace X] [DecidableEq I]
    (μ : Measure X) (s : Finset I) (K : I → I → X → ℂ)
    (T Tstar : I → (X → ℂ) →ₗ[ℂ] (X → ℂ))
    (hcomp : IsQ4FiniteProductPairComposition μ K T Tstar)
    (g : X × {i // i ∈ s} → ℂ) (z : X × {i // i ∈ s}) :
    q4FiniteProductAnalysis s T (q4FiniteProductSynthesis s Tstar g) z =
      q4FiniteProductKernelShell μ s (fun _ _ => True) K g z := by
  classical
  unfold q4FiniteProductAnalysis q4FiniteProductSynthesis
    q4FiniteProductKernelShell q4KernelTTStarShell
  rw [map_sum]
  simp only [Finset.sum_filter, if_true]
  rw [Finset.sum_apply]
  apply Finset.sum_congr rfl
  intro l hl
  exact hcomp z.2.1 l (q4FiniteProductToFibres s g l) z.1

/-- Pair the literal finite-product kernel shell with a second fibre field.
For the unrestricted relation this is exactly the diagonal `TT*` form whose
strict bound is obtained only after all gap shells have been reassembled. -/
def q4FiniteProductKernelBilinear
    {I X : Type*} [Sub X] [MeasurableSpace X] [DecidableEq I]
    (μ : Measure X) (s : Finset I) (R : I → I → Prop) [DecidableRel R]
    (K : I → I → X → ℂ) (g h : I → X → ℂ) : ℂ :=
  q4FiniteProductPairing μ s
    (q4FiniteProductToFibres s
      (q4FiniteProductKernelShell μ s R K (q4FibresToFiniteProduct s g))) h

/-- On every active fibre, the unrestricted literal kernel shell agrees
with analysis applied to finite-fibre synthesis. -/
theorem q4FiniteProductToFibres_fullKernel_eq_analysis_synthesis_apply
    {I X : Type*} [Sub X] [MeasurableSpace X] [DecidableEq I]
    (μ : Measure X) (s : Finset I) (K : I → I → X → ℂ)
    (T Tstar : I → (X → ℂ) →ₗ[ℂ] (X → ℂ))
    (hcomp : IsQ4FiniteProductPairComposition μ K T Tstar)
    (g : I → X → ℂ) (i : I) (hi : i ∈ s) (x : X) :
    q4FiniteProductToFibres s
      (q4FiniteProductKernelShell μ s (fun _ _ => True) K
        (q4FibresToFiniteProduct s g)) i x =
      T i (q4FiniteFibreSynthesis s Tstar g) x := by
  have hfull := q4FiniteProduct_analysis_synthesis_eq_fullTTStar
    μ s K T Tstar hcomp (q4FibresToFiniteProduct s g) (x, ⟨i, hi⟩)
  rw [q4FiniteProductSynthesis_fibresToProduct_eq_fibreSynthesis] at hfull
  simpa [q4FiniteProductToFibres, q4FiniteProductAnalysis, hi] using hfull.symm

/-- The bilinear form of the full literal kernel is the analysis--synthesis
form.  This is an equality of the actual finite convolution shell, not a
formal factorization of any one radius-gap component. -/
theorem q4FiniteProductKernelBilinear_full_eq_analysis_synthesis
    {I X : Type*} [Sub X] [MeasurableSpace X] [DecidableEq I]
    (μ : Measure X) (s : Finset I) (K : I → I → X → ℂ)
    (T Tstar : I → (X → ℂ) →ₗ[ℂ] (X → ℂ))
    (hcomp : IsQ4FiniteProductPairComposition μ K T Tstar)
    (g h : I → X → ℂ) :
    q4FiniteProductKernelBilinear μ s (fun _ _ => True) K g h =
      q4FiniteProductPairing μ s
        (fun i => T i (q4FiniteFibreSynthesis s Tstar g)) h := by
  unfold q4FiniteProductKernelBilinear q4FiniteProductPairing
  apply Finset.sum_congr rfl
  intro i hi
  apply integral_congr_ae
  filter_upwards with x
  rw [q4FiniteProductToFibres_fullKernel_eq_analysis_synthesis_apply
    μ s K T Tstar hcomp g i hi x]

/-- The full-shell diagonal is exactly the nonnegative square energy of
synthesis.  This is the algebraic heart of the ordinary `TT*` lifting. -/
theorem q4FiniteFibreSynthesis_energy_eq_fullKernelDiagonal_of_adjoint_eq
    {I X : Type*} [Sub X] [MeasurableSpace X] [DecidableEq I]
    (μ : Measure X) (s : Finset I) (K : I → I → X → ℂ)
    (T Tstar : I → (X → ℂ) →ₗ[ℂ] (X → ℂ))
    (hcomp : IsQ4FiniteProductPairComposition μ K T Tstar)
    (g : I → X → ℂ)
    (hadj : q4FiniteProductPairing μ s
      (fun i => T i (q4FiniteFibreSynthesis s Tstar g)) g =
        ∫ x, q4FiniteFibreSynthesis s Tstar g x *
          starRingEnd ℂ (q4FiniteFibreSynthesis s Tstar g x) ∂μ)
    :
    q4FiniteProductKernelBilinear μ s (fun _ _ => True) K g g =
      ((∫ x, ‖q4FiniteFibreSynthesis s Tstar g x‖ ^ 2 ∂μ : ℝ) : ℂ) := by
  rw [q4FiniteProductKernelBilinear_full_eq_analysis_synthesis
    μ s K T Tstar hcomp g g]
  rw [hadj]
  calc
    ∫ x, q4FiniteFibreSynthesis s Tstar g x *
        starRingEnd ℂ (q4FiniteFibreSynthesis s Tstar g x) ∂μ =
        ∫ x, ((‖q4FiniteFibreSynthesis s Tstar g x‖ ^ 2 : ℝ) : ℂ) ∂μ := by
      apply integral_congr_ae
      filter_upwards with x
      rw [starRingEnd_apply]
      simpa only [starRingEnd_apply, ← Complex.ofReal_pow] using
        Complex.mul_conj' (q4FiniteFibreSynthesis s Tstar g x)
    _ = ((∫ x, ‖q4FiniteFibreSynthesis s Tstar g x‖ ^ 2 ∂μ : ℝ) : ℂ) :=
      integral_ofReal

/-- The preceding energy identity under the globally stated formal adjoint
hypothesis. -/
theorem q4FiniteFibreSynthesis_energy_eq_fullKernelDiagonal
    {I X : Type*} [Sub X] [MeasurableSpace X] [DecidableEq I]
    (μ : Measure X) (s : Finset I) (K : I → I → X → ℂ)
    (T Tstar : I → (X → ℂ) →ₗ[ℂ] (X → ℂ))
    (hcomp : IsQ4FiniteProductPairComposition μ K T Tstar)
    (hadj : IsQ4FiniteProductFormalAdjoint μ s T Tstar)
    (g : I → X → ℂ) :
    q4FiniteProductKernelBilinear μ s (fun _ _ => True) K g g =
      ((∫ x, ‖q4FiniteFibreSynthesis s Tstar g x‖ ^ 2 ∂μ : ℝ) : ℂ) := by
  exact q4FiniteFibreSynthesis_energy_eq_fullKernelDiagonal_of_adjoint_eq
    μ s K T Tstar hcomp g
    (hadj (q4FiniteFibreSynthesis s Tstar g) g)

/-- Turn a strict bound for the *full* literal product `TT*` shell into the
synthesis bound consumed by finite-product duality.  The squared form of the
shell estimate is the natural diagonal consequence of an
`L^{q'} → L^q` product-space bound. -/
def q4FiniteProductSynthesisDomain_of_fullKernelDiagonal
    {I X : Type*} [Sub X] [MeasurableSpace X] [DecidableEq I]
    (μ : Measure X) (s : Finset I) (K : I → I → X → ℂ)
    (T Tstar : I → (X → ℂ) →ₗ[ℂ] (X → ℂ))
    (qdual A : ℝ) (carrier : Set (I → X → ℂ))
    (hcomp : IsQ4FiniteProductPairComposition μ K T Tstar)
    (hadj : ∀ (u : X → ℂ) (g : I → X → ℂ), g ∈ carrier →
      q4FiniteProductPairing μ s (fun i => T i u) g =
        ∫ x, u x * starRingEnd ℂ (q4FiniteFibreSynthesis s Tstar g x) ∂μ)
    (hmem : ∀ g : I → X → ℂ, g ∈ carrier →
      MemLp (q4FiniteFibreSynthesis s Tstar g) 2 μ)
    (hA : 0 ≤ A)
    (hdiagonal : ∀ g : I → X → ℂ, g ∈ carrier →
      ‖q4FiniteProductKernelBilinear μ s (fun _ _ => True) K g g‖ ≤
        (A * (q4FibreLpMoment μ s qdual g) ^ (1 / qdual)) ^ 2) :
    Q4FiniteProductSynthesisDomain μ s T Tstar qdual A where
  carrier := carrier
  adjoint := hadj
  synthesis_mem_two := hmem
  synthesis_bound := by
    intro g hg
    let E : ℝ := ∫ x, ‖q4FiniteFibreSynthesis s Tstar g x‖ ^ 2 ∂μ
    have hE0 : 0 ≤ E := by
      simpa only [E] using
        (integral_nonneg fun x => sq_nonneg (‖q4FiniteFibreSynthesis s Tstar g x‖))
    have hdiag := hdiagonal g hg
    have henergy : q4FiniteProductKernelBilinear μ s (fun _ _ => True) K g g =
        (E : ℂ) := by
      simpa only [E] using
        q4FiniteFibreSynthesis_energy_eq_fullKernelDiagonal_of_adjoint_eq
          μ s K T Tstar hcomp g
          (hadj (q4FiniteFibreSynthesis s Tstar g) g hg)
    rw [henergy] at hdiag
    have hE : E ≤ (A * (q4FibreLpMoment μ s qdual g) ^ (1 / qdual)) ^ 2 := by
      change ‖(E : ℂ)‖ ≤
        (A * (q4FibreLpMoment μ s qdual g) ^ (1 / qdual)) ^ 2 at hdiag
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hE0] at hdiag
      exact hdiag
    have hmoment : 0 ≤ q4FibreLpMoment μ s qdual g :=
      q4FibreLpMoment_nonneg μ s qdual g
    have hright : 0 ≤ A * (q4FibreLpMoment μ s qdual g) ^ (1 / qdual) :=
      mul_nonneg hA (Real.rpow_nonneg hmoment _)
    change √E ≤ A * (q4FibreLpMoment μ s qdual g) ^ (1 / qdual)
    calc
      √E ≤ √((A * (q4FibreLpMoment μ s qdual g) ^ (1 / qdual)) ^ 2) :=
        Real.sqrt_le_sqrt hE
      _ = A * (q4FibreLpMoment μ s qdual g) ^ (1 / qdual) := by
        rw [Real.sqrt_sq_eq_abs, abs_of_nonneg hright]

/-- A genuine strong estimate for the unrestricted finite product shell
implies its diagonal `TT*` estimate.  The premise is deliberately a bound
for the literal full kernel acting on a finite product field; Hölder on that
same finite product is what converts it to the quadratic form.  Thus this
lemma does not assert, or use, a factorization of an individual gap shell. -/
theorem q4FiniteProductKernelDiagonal_le_of_fullKernelStrongMoment
    {I X : Type*} [Sub X] [MeasurableSpace X] [DecidableEq I]
    (μ : Measure X) (s : Finset I) (K : I → I → X → ℂ)
    {q qdual A : ℝ} (carrier : Set (I → X → ℂ))
    (hq : 1 < q) (hqdual : 0 < qdual)
    (hconj : 1 / q + 1 / qdual = 1)
    (hinput_mem : ∀ g : I → X → ℂ, g ∈ carrier →
      ∀ i ∈ s, MemLp (g i) (ENNReal.ofReal qdual) μ)
    (houtput_mem : ∀ g : I → X → ℂ, g ∈ carrier →
      ∀ i ∈ s, MemLp
        (q4FiniteProductToFibres s
          (q4FiniteProductKernelShell μ s (fun _ _ => True) K
            (q4FibresToFiniteProduct s g)) i)
        (ENNReal.ofReal q) μ)
    (hstrong : ∀ g : I → X → ℂ, g ∈ carrier →
      (q4FibreLpMoment μ s q
        (q4FiniteProductToFibres s
          (q4FiniteProductKernelShell μ s (fun _ _ => True) K
            (q4FibresToFiniteProduct s g)))) ^ (1 / q) ≤
        A * A * (q4FibreLpMoment μ s qdual g) ^ (1 / qdual)) :
    ∀ g : I → X → ℂ, g ∈ carrier →
      ‖q4FiniteProductKernelBilinear μ s (fun _ _ => True) K g g‖ ≤
        (A * (q4FibreLpMoment μ s qdual g) ^ (1 / qdual)) ^ 2 := by
  intro g hg
  let out : I → X → ℂ :=
    q4FiniteProductToFibres s
      (q4FiniteProductKernelShell μ s (fun _ _ => True) K
        (q4FibresToFiniteProduct s g))
  have hholder : ‖q4FiniteProductPairing μ s out g‖ ≤
      (q4FibreLpMoment μ s q out) ^ (1 / q) *
        (q4FibreLpMoment μ s qdual g) ^ (1 / qdual) :=
    norm_q4FiniteProductPairing_le_fibreLpMoment μ s hq hqdual hconj out g
      (houtput_mem g hg) (hinput_mem g hg)
  have hmoment_nonneg : 0 ≤
      (q4FibreLpMoment μ s qdual g) ^ (1 / qdual) :=
    Real.rpow_nonneg (q4FibreLpMoment_nonneg μ s qdual g) _
  change ‖q4FiniteProductPairing μ s out g‖ ≤
    (A * (q4FibreLpMoment μ s qdual g) ^ (1 / qdual)) ^ 2
  calc
    ‖q4FiniteProductPairing μ s out g‖ ≤
        (q4FibreLpMoment μ s q out) ^ (1 / q) *
          (q4FibreLpMoment μ s qdual g) ^ (1 / qdual) := hholder
    _ ≤ (A * A * (q4FibreLpMoment μ s qdual g) ^ (1 / qdual)) *
          (q4FibreLpMoment μ s qdual g) ^ (1 / qdual) :=
      mul_le_mul_of_nonneg_right (hstrong g hg) hmoment_nonneg
    _ = (A * (q4FibreLpMoment μ s qdual g) ^ (1 / qdual)) ^ 2 := by
      ring

/-- Full-shell `TT*` control gives the finite-family strong `L² → Lᵠ`
moment bound.  This is the product-space lifting step of the paper, stated
with the literal kernel and radius operators; a later max bridge can turn
this moment estimate into the sampled maximal estimate. -/
theorem q4FiniteProductAnalysis_moment_le_of_fullKernelDiagonal
    {I X : Type*} [Sub X] [MeasurableSpace X] [DecidableEq I]
    (μ : Measure X) (s : Finset I) (K : I → I → X → ℂ)
    (T Tstar : I → (X → ℂ) →ₗ[ℂ] (X → ℂ))
    {q qdual A F : ℝ} (carrier : Set (I → X → ℂ))
    (hcomp : IsQ4FiniteProductPairComposition μ K T Tstar)
    (hadj : ∀ (v : X → ℂ) (g : I → X → ℂ), g ∈ carrier →
      q4FiniteProductPairing μ s (fun i => T i v) g =
        ∫ x, v x * starRingEnd ℂ (q4FiniteFibreSynthesis s Tstar g x) ∂μ)
    (hmem : ∀ g : I → X → ℂ, g ∈ carrier →
      MemLp (q4FiniteFibreSynthesis s Tstar g) 2 μ)
    (hA : 0 ≤ A)
    (hdiagonal : ∀ g : I → X → ℂ, g ∈ carrier →
      ‖q4FiniteProductKernelBilinear μ s (fun _ _ => True) K g g‖ ≤
        (A * (q4FibreLpMoment μ s qdual g) ^ (1 / qdual)) ^ 2)
    (u : X → ℂ) (hq : 1 < q) (hqdual : 0 < qdual)
    (hconj : 1 / q + 1 / qdual = 1) (hAF : 0 ≤ A * F)
    (hF : 0 ≤ F) (hu : MemLp u 2 μ)
    (hsource : √(∫ x, ‖u x‖ ^ 2 ∂μ) ≤ F)
    (hpower : q4PowerDualField q (fun i => T i u) ∈ carrier) :
    (q4FibreLpMoment μ s q (fun i => T i u)) ^ (1 / q) ≤ A * F := by
  exact q4FiniteProductAnalysis_moment_le_of_power_dual_domain
    μ s T Tstar
    (q4FiniteProductSynthesisDomain_of_fullKernelDiagonal
      μ s K T Tstar qdual A carrier hcomp hadj hmem hA hdiagonal)
    u hq hqdual hconj hAF hF hu hsource hpower

/-- Full-product `L^{q'}`-to-`L^q` control gives the finite-family strong
`L²`-to-`L^q` moment estimate.  This is the concrete finite-dimensional
`TT*` step in the paper: after the dyadic gap shells have been summed into
the full product kernel, a strong product estimate supplies the diagonal
bound, and the preceding exact energy identity and dual test recover the
original family of radius operators. -/
theorem q4FiniteProductAnalysis_moment_le_of_fullKernelStrongMoment
    {I X : Type*} [Sub X] [MeasurableSpace X] [DecidableEq I]
    (μ : Measure X) (s : Finset I) (K : I → I → X → ℂ)
    (T Tstar : I → (X → ℂ) →ₗ[ℂ] (X → ℂ))
    {q qdual A F : ℝ} (carrier : Set (I → X → ℂ))
    (hcomp : IsQ4FiniteProductPairComposition μ K T Tstar)
    (hadj : ∀ (v : X → ℂ) (g : I → X → ℂ), g ∈ carrier →
      q4FiniteProductPairing μ s (fun i => T i v) g =
        ∫ x, v x * starRingEnd ℂ (q4FiniteFibreSynthesis s Tstar g x) ∂μ)
    (hsynthesis_mem : ∀ g : I → X → ℂ, g ∈ carrier →
      MemLp (q4FiniteFibreSynthesis s Tstar g) 2 μ)
    (hA : 0 ≤ A)
    (hinput_mem : ∀ g : I → X → ℂ, g ∈ carrier →
      ∀ i ∈ s, MemLp (g i) (ENNReal.ofReal qdual) μ)
    (houtput_mem : ∀ g : I → X → ℂ, g ∈ carrier →
      ∀ i ∈ s, MemLp
        (q4FiniteProductToFibres s
          (q4FiniteProductKernelShell μ s (fun _ _ => True) K
            (q4FibresToFiniteProduct s g)) i)
        (ENNReal.ofReal q) μ)
    (hstrong : ∀ g : I → X → ℂ, g ∈ carrier →
      (q4FibreLpMoment μ s q
        (q4FiniteProductToFibres s
          (q4FiniteProductKernelShell μ s (fun _ _ => True) K
            (q4FibresToFiniteProduct s g)))) ^ (1 / q) ≤
        A * A * (q4FibreLpMoment μ s qdual g) ^ (1 / qdual))
    (u : X → ℂ) (hq : 1 < q) (hqdual : 0 < qdual)
    (hconj : 1 / q + 1 / qdual = 1) (hAF : 0 ≤ A * F)
    (hF : 0 ≤ F) (hu : MemLp u 2 μ)
    (hsource : √(∫ x, ‖u x‖ ^ 2 ∂μ) ≤ F)
    (hpower : q4PowerDualField q (fun i => T i u) ∈ carrier) :
    (q4FibreLpMoment μ s q (fun i => T i u)) ^ (1 / q) ≤ A * F := by
  apply q4FiniteProductAnalysis_moment_le_of_fullKernelDiagonal
    μ s K T Tstar carrier hcomp hadj hsynthesis_mem hA
    (q4FiniteProductKernelDiagonal_le_of_fullKernelStrongMoment
      μ s K carrier hq hqdual hconj hinput_mem houtput_mem hstrong)
    u hq hqdual hconj hAF hF hu hsource hpower

end

end Codex.Spherical.FractalDilations.Q4FiniteProductTTStar