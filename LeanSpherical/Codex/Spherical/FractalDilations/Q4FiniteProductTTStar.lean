    unfold b
    exact Real.rpow_nonneg
      (integral_nonneg fun x => Real.rpow_nonneg (norm_nonneg _) _) _
  have hpair (i : I) (hi : i ∈ s) :
      ‖∫ x, f i x * starRingEnd ℂ (g i x) ∂μ‖ ≤ a i * b i := by
    calc
      ‖∫ x, f i x * starRingEnd ℂ (g i x) ∂μ‖ ≤
