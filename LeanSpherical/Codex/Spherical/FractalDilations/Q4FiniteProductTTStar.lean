/-- The literal complex pairing on the finite product, written as its finite
sum of spatial integrals. -/
def q4FiniteProductPairing
    {I X : Type*} [MeasurableSpace X]
    (μ : Measure X) (s : Finset I) (f g : I → X → ℂ) : ℂ :=
  ∑ i ∈ s, ∫ x, f i x * starRingEnd ℂ (g i x) ∂μ

/-- The literal adjoint identity for the finite product.  This is the
