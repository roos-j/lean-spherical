      a i ^ q = ∫ x, ‖f i x‖ ^ q ∂μ := by
    unfold a
    rw [show 1 / q = q⁻¹ by rw [one_div],
      Real.rpow_inv_rpow
        (integral_nonneg fun x => Real.rpow_nonneg (norm_nonneg _) _)
