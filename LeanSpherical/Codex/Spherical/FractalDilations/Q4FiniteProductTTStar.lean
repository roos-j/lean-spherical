      b i ^ qdual = ∫ x, ‖g i x‖ ^ qdual ∂μ := by
    unfold b
    rw [show 1 / qdual = qdual⁻¹ by rw [one_div],
      Real.rpow_inv_rpow
        (integral_nonneg fun x => Real.rpow_nonneg (norm_nonneg _) _)
