  let b : I → ℝ := fun i => (∫ x, ‖g i x‖ ^ qdual ∂μ) ^ (1 / qdual)
  have hholder : Real.HolderConjugate q qdual := by
    rw [Real.holderConjugate_iff]
    refine ⟨hq, ?_⟩
    simpa only [one_div] using hconj
  have ha0 (i : I) (hi : i ∈ s) : 0 ≤ a i := by
