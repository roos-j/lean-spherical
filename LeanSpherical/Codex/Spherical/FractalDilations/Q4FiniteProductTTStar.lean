/-- Regard a function on the finite product `X × s` as a family of fields on
`X`, extended by zero away from the active index set. -/
def q4FiniteProductToFibres
    {I X : Type*} [DecidableEq I]
    (s : Finset I) (g : X × {i // i ∈ s} → ℂ) : I → X → ℂ :=
  fun i x => if hi : i ∈ s then g (x, ⟨i, hi⟩) else 0

/-- The literal finite-product kernel operator.  Its output index belongs to
the active subtype, while the sum is the actual finite shell on `s`. -/
def q4FiniteProductKernelShell
    {I X : Type*} [Sub X] [MeasurableSpace X] [DecidableEq I]
    (μ : Measure X) (s : Finset I) (R : I → I → Prop) [DecidableRel R]
    (K : I → I → X → ℂ) (g : X × {i // i ∈ s} → ℂ) :
    X × {i // i ∈ s} → ℂ :=
  fun z => q4KernelTTStarShell μ s R K (q4FiniteProductToFibres s g) z.2.1 z.1

/-- The finite-product analysis operator associated with a family of linear
radius pieces. -/
def q4FiniteProductAnalysis
    {I X : Type*} [DecidableEq I]
    (s : Finset I) (T : I → (X → ℂ) →ₗ[ℂ] (X → ℂ)) (f : X → ℂ) :
    X × {i // i ∈ s} → ℂ :=
  fun z => T z.2.1 f z.1

/-- The finite-product synthesis operator formed from the formal adjoints of
the individual radius pieces. -/
def q4FiniteProductSynthesis
    {I X : Type*} [DecidableEq I]
    (s : Finset I) (Tstar : I → (X → ℂ) →ₗ[ℂ] (X → ℂ))
    (g : X × {i // i ∈ s} → ℂ) : X → ℂ :=
  ∑ i ∈ s, Tstar i (q4FiniteProductToFibres s g i)

/-- The same synthesis operator written directly on a finite family of
fibres.  This is definitionally the `X × s` synthesis after transporting a
product field to its fibres, and is convenient for the dual pairing. -/
def q4FiniteFibreSynthesis
    {I X : Type*} [DecidableEq I]
    (s : Finset I) (Tstar : I → (X → ℂ) →ₗ[ℂ] (X → ℂ))
    (g : I → X → ℂ) : X → ℂ :=
  ∑ i ∈ s, Tstar i (g i)

/-- Turn a finite family of fields into the literal product field on
`X × s`. -/
def q4FibresToFiniteProduct
    {I X : Type*} (s : Finset I) (g : I → X → ℂ) :
    X × {i // i ∈ s} → ℂ :=
  fun z => g z.2.1 z.1

/-- On active fibres, product-to-fibres followed by fibres-to-product is the
identity. -/
theorem q4FiniteProductToFibres_fibresToProduct_apply
    {I X : Type*} [DecidableEq I] (s : Finset I) (g : I → X → ℂ)
    (i : I) (hi : i ∈ s) (x : X) :
    q4FiniteProductToFibres s (q4FibresToFiniteProduct s g) i x = g i x := by
  simp [q4FiniteProductToFibres, q4FibresToFiniteProduct, hi]

/-- Product synthesis agrees exactly with synthesis of the active fibre
