    {I X : Type*} [MeasurableSpace X] [DecidableEq I]
    (μ : Measure X) (s : Finset I)
    (T Tstar : I → (X → ℂ) →ₗ[ℂ] (X → ℂ)) : Prop :=
  ∀ (u : X → ℂ) (g : I → X → ℂ),
    q4FiniteProductPairing μ s (fun i => T i u) g =
      ∫ x, u x * starRingEnd ℂ (q4FiniteFibreSynthesis s Tstar g x) ∂μ

