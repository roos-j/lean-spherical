  intro x
  by_cases hx : x ∈ ball (0 : Euclidean d) s
  · rw [Set.indicator_of_mem hx, norm_one]
    have hxnorm : ‖x‖ < s := by
      simpa only [mem_ball, dist_zero_right] using hx
