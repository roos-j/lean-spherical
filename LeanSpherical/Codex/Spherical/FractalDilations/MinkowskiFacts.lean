/-- If the upper Minkowski dimension equals `β`, every exponent strictly
larger than `β` is admissible.  This is the infimum approximation needed in
the non-endpoint maximal estimate. -/
theorem hasUpperMinkowskiExponent_add_of_upperMinkowskiDimension_eq
    {E : Set ℝ} {β ε : ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hβ : upperMinkowskiDimension E = β) (hε : 0 < ε) :
    HasUpperMinkowskiExponent E (β + ε) := by
  let S : Set ℝ := {s : ℝ | 0 ≤ s ∧ HasUpperMinkowskiExponent E s}
  have hS : S.Nonempty := by
    simpa only [S] using upperMinkowski_admissible_nonempty_of_subset_Icc hE
  have hsInf : sInf S = β := by
    simpa only [S, upperMinkowskiDimension] using hβ
  have hlt : sInf S < β + ε := by rw [hsInf]; linarith
  obtain ⟨s, hs, hslt⟩ := exists_lt_of_csInf_lt hS hlt
  exact HasUpperMinkowskiExponent.of_le hslt.le hs.2

/-- The same approximation result in the common `β + ε` form, with the loss
parameter named explicitly for downstream covering arguments. -/
theorem hasUpperMinkowskiExponent_of_upperMinkowskiDimension_lt
    {E : Set ℝ} {β β' : ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hβ : upperMinkowskiDimension E = β) (hβ' : β < β') :
    HasUpperMinkowskiExponent E β' := by
