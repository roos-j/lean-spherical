/-- Every subset of the radius interval has upper Minkowski covering exponent
`1`.  This supplies the nonemptiness needed when using the infimum definition
of upper Minkowski dimension. -/
theorem hasUpperMinkowskiExponent_one_of_subset_Icc
    {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) :
    HasUpperMinkowskiExponent E 1 := by
  intro ε hε
  refine ⟨4, by norm_num, fun δ hδ hδone => ?_⟩
  obtain ⟨ι, hι, hcard⟩ := exists_intervalCover_of_subset_Icc hδ (by norm_num) hE
  refine ⟨ι, hι, ?_⟩
  have hratio_pos : 0 < (1 : ℝ) / δ := div_pos zero_lt_one hδ
  have hceil : (Nat.ceil ((1 : ℝ) / δ) : ℝ) ≤ (1 : ℝ) / δ + 1 :=
    (Nat.ceil_lt_add_one hratio_pos.le).le
  have hratio_one : 1 ≤ (1 : ℝ) / δ := by
    exact (le_div_iff₀ hδ).2 (by linarith)
  have hgrid : (ι.card : ℝ) ≤ 4 * ((1 : ℝ) / δ) := by
    calc
      (ι.card : ℝ) ≤ (Nat.ceil ((2 - 1 : ℝ) / δ) : ℝ) + 2 := hcard
      _ = (Nat.ceil ((1 : ℝ) / δ) : ℝ) + 2 := by norm_num
      _ ≤ ((1 : ℝ) / δ + 1) + 2 := by linarith
      _ ≤ 4 * ((1 : ℝ) / δ) := by nlinarith
  have hpower : δ ^ (-1 : ℝ) ≤ δ ^ (-(1 + ε)) := by
    apply Real.rpow_le_rpow_of_exponent_ge hδ hδone.le
    linarith
  calc
    (ι.card : ℝ) ≤ 4 * ((1 : ℝ) / δ) := hgrid
    _ = 4 * δ ^ (-1 : ℝ) := by rw [Real.rpow_neg_one, one_div]
    _ ≤ 4 * δ ^ (-(1 + ε)) :=
      mul_le_mul_of_nonneg_left hpower (by norm_num)

/-- The set of nonnegative admissible upper Minkowski exponents is nonempty
for a radius set in `[1,2]`. -/
theorem upperMinkowski_admissible_nonempty_of_subset_Icc
    {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) :
    {s : ℝ | 0 ≤ s ∧ HasUpperMinkowskiExponent E s}.Nonempty := by
  exact ⟨1, zero_le_one, hasUpperMinkowskiExponent_one_of_subset_Icc hE⟩

/-- Upper Minkowski dimension is nonnegative for a radius set in `[1,2]`. -/
theorem upperMinkowskiDimension_nonneg_of_subset_Icc
    {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) :
    0 ≤ upperMinkowskiDimension E := by
  unfold upperMinkowskiDimension
  apply le_csInf (upperMinkowski_admissible_nonempty_of_subset_Icc hE)
  intro s hs
  exact hs.1

/-- A radius set is one-dimensional at most.  This elementary ambient bound
is useful when choosing a strictly sub-`L²` Q2 exponent before applying the
literal top-endpoint upgrade. -/
theorem upperMinkowskiDimension_le_one_of_subset_Icc
    {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) :
    upperMinkowskiDimension E ≤ 1 := by
