      eLpNorm (f : Euclidean d -> Complex) (ENNReal.ofReal r) volume ^ r =
        ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ r := by
    rw [eLpNorm_eq_eLpNorm' hrE0 hrET, ENNReal.toReal_ofReal hr.le]
