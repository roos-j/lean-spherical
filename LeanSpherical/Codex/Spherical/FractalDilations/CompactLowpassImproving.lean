  obtain ⟨hmem, hnorm⟩ := hstrong f
  have hrE0 : ENNReal.ofReal r ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hr
  have hrET : ENNReal.ofReal r ≠ ⊤ := ENNReal.ofReal_ne_top
