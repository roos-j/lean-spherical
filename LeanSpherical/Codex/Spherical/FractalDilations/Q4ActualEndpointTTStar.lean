          (q4FiniteProductKernelShell volume s (fun _ _ => True)
            (q4ActiveDyadicPairKernel psi j) (q4FibresToFiniteProduct s G)))) ^ (1 / q) <=
        A * A * (q4FibreLpMoment volume s p G) ^ (1 / p) := by
    simpa only [s, G, A] using
      q4ActiveDyadicCanonicalFullProduct_rootMoment_le_of_eLpStrongENNReal_sq
        E j psi hpsiCompact q p hqone hqtwo hp hmul C hC f hstrong
  have hS := q4ActiveDyadic_synthesis_norm_le_of_fullProductRoot
    psi hpsiCompact j s hqone hqtwo hp hconj hA f hout hinput hroot
  have hpair := q4ActiveDyadic_analysisPairing_eq_l2 psi hpsiCompact j s q hqtwo f
  let F : Int -> Euclidean d -> Complex := fun i =>
    (q4DyadicSurfaceSchwartzPiece psi hpsiCompact (dyadicLeft j i) f :
      Euclidean d -> Complex)
  let R : Real := (q4FibreLpMoment volume s p G) ^ (1 / p)
  have hbilinear : ‖q4FiniteProductPairing volume s F (q4PowerDualField q F)‖ <=
      A * ‖f.toLp 2 volume‖ * R := by
    calc
      ‖q4FiniteProductPairing volume s F (q4PowerDualField q F)‖ =
          ‖inner Complex
            (q4L2FiniteFibreSynthesis s
              (fun i => q4DyadicSurfaceAdjointL2Piece psi hpsiCompact (dyadicLeft j i))
              (q4ActiveDyadicSchwartzAnalysisPowerDualL2 psi hpsiCompact j q hqtwo f))
            (f.toLp 2 volume)‖ := by
        rw [show F = fun i =>
          (q4DyadicSurfaceSchwartzPiece psi hpsiCompact (dyadicLeft j i) f :
            Euclidean d -> Complex) by rfl]
        exact congrArg norm hpair
      _ <= ‖q4L2FiniteFibreSynthesis s
            (fun i => q4DyadicSurfaceAdjointL2Piece psi hpsiCompact (dyadicLeft j i))
            (q4ActiveDyadicSchwartzAnalysisPowerDualL2 psi hpsiCompact j q hqtwo f)‖ *
          ‖f.toLp 2 volume‖ := norm_inner_le_norm _ _
      _ <= (A * R) * ‖f.toLp 2 volume‖ :=
        mul_le_mul_of_nonneg_right (by simpa only [G, R] using hS) (norm_nonneg _)
      _ = A * ‖f.toLp 2 volume‖ * R := by ring
  have hCF : 0 <= A * ‖f.toLp 2 volume‖ := mul_nonneg hA (norm_nonneg _)
  have hmoment := q4FibreLpMoment_rpow_one_div_le_of_dual_test_at_test
    volume s hqpos hp hconj hCF F
    (q4PowerDualTest volume s q p F hqone hmul) (by
      simpa only [G, F, R] using hbilinear)
  have hphysical : q4FibreLpMoment volume s q
      (fun i x => q4DyadicSurfacePiece psi f (dyadicLeft j i) x) =
      q4FibreLpMoment volume s q F := by
    unfold q4FibreLpMoment
    apply Finset.sum_congr rfl
    intro i hi
    apply integral_congr_ae
    filter_upwards with x
    rw [show q4DyadicSurfacePiece psi f (dyadicLeft j i) x = F i x by
      simpa only [F] using
        (q4DyadicSurfaceSchwartzPiece_apply_eq_q4DyadicSurfacePiece
          psi hpsiCompact (dyadicLeft j i) f x).symm]
  rw [hphysical]
  simpa only [s, F, A] using hmoment

/-- The literal ordinary active family has its fixed-endpoint `L² → L^q`
root-moment estimate.  Its only analytic inputs are the actual stationary
pair-kernel decay and the actual active-index multiplier bound. -/
theorem q4ActiveDyadic_analysis_rootMoment_le_of_active_multiplier
    {d : Nat} {E : Set Real} {gamma eta Ccover : Real} {j : Nat}
    (hd : 1 <= d) (hj : 1 <= j)
    (hE : E ⊆ Icc (1 : Real) 2)
    (hcover : HasSubpowerAssouadCoverBound E gamma eta Ccover)
    (hCcover : 0 <= Ccover) (hgamma : 0 <= gamma)
    (hdeltaone : dyadicScale j < 1)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    {Ckernel B : Real} (hCkernel : 0 < Ckernel)
    (hdecay : HasQ4DyadicPairKernelGapDecayOn d (fun _ => psi)
      (1 / 2 : Real) (5 / 2) Ckernel)
    (hB : 0 <= B)
    (hmultiplier : forall i ∈ activeDyadicIndices E j,
      forall l ∈ activeDyadicIndices E j, forall xi : Euclidean d,
        ‖q4ActiveDyadicPairMultiplier psi hpsiCompact j i l xi‖ <= B)
    {p q : Real} (hp1 : 1 < p) (hp2 : p < 2)
    (hq : q = p / (p - 1))
    (f : SchwartzMap (Euclidean d) Complex) :
    (q4FibreLpMoment volume (activeDyadicIndices E j) q
      (fun i x => q4DyadicSurfacePiece psi f (dyadicLeft j i) x)) ^ (1 / q) <=
      Real.sqrt
        (∑ n ∈ Finset.range (j + 3),
          q4ActiveDyadicLevelStrongConstant d gamma eta Ccover Ckernel B j n q).toReal *
        ‖f.toLp 2 volume‖ := by
  let s : Finset Int := activeDyadicIndices E j
  have hqgtwo : 2 < q := by
    rw [hq]
    have hpminus : 0 < p - 1 := by linarith
    apply (lt_div_iff₀ hpminus).mpr
    nlinarith
  have hqtwo : 2 <= q := hqgtwo.le
  have hqpos : 0 < q := lt_trans zero_lt_two hqgtwo
  have hp : 0 < p := lt_trans zero_lt_one hp1
  have hmul : (q - 1) * p = q := by
    rw [hq]
    have hpminus : p - 1 ≠ 0 := ne_of_gt (by linarith [hp1])
    field_simp [hpminus]
    ring
  have hconj : 1 / q + 1 / p = 1 := by
    rw [hq]
    have hp0 : p ≠ 0 := ne_of_gt hp
    have hpminus : p - 1 ≠ 0 := ne_of_gt (by linarith [hp1])
    field_simp [hp0, hpminus]
    ring
  let Gproduct : Euclidean d × {i // i ∈ s} -> Complex :=
    q4ActiveDyadicPowerDualProductField E j psi hpsiCompact q f
  let G : Int -> Euclidean d -> Complex := q4PowerDualField q (fun i =>
    (q4DyadicSurfaceSchwartzPiece psi hpsiCompact (dyadicLeft j i) f :
      Euclidean d -> Complex))
  let L : ENNReal := ∑ n ∈ Finset.range (j + 3),
    q4ActiveDyadicLevelStrongConstant d gamma eta Ccover Ckernel B j n q
  let A : Real := Real.sqrt L.toReal
  have hL : L ≠ ⊤ := by
    simpa only [L] using q4ActiveDyadicLevelStrongConstant_sum_ne_top hqgtwo
  have hA : 0 <= A := Real.sqrt_nonneg _
  have hGmeas : Measurable Gproduct := by
    simpa only [s, Gproduct] using
      measurable_q4ActiveDyadicPowerDualProductField E j psi hpsiCompact q hqtwo f
  have hGint : Integrable Gproduct (q4FiniteProductCountingMeasure volume s) := by
    simpa only [s, Gproduct] using
      integrable_q4ActiveDyadicPowerDualProductField E j psi hpsiCompact q hqtwo f
  have hGsq : Integrable (fun z => ‖Gproduct z‖ ^ (2 : Nat))
      (q4FiniteProductCountingMeasure volume s) := by
    simpa only [s, Gproduct] using
      integrable_norm_sq_q4ActiveDyadicPowerDualProductField E j psi hpsiCompact q hqtwo f
  have hGfib : ∀ i ∈ s,
      Integrable (q4FiniteProductToFibres s Gproduct i) volume /\
        MemLp (q4FiniteProductToFibres s Gproduct i) 2 volume := by
    intro i hi
    simpa only [s, Gproduct] using
      q4ActiveDyadicPowerDualProductField_fibre_regular
        E j psi hpsiCompact q hqtwo f i hi
  have hGpower : Integrable (fun z => ‖Gproduct z‖ ^ p)
      (q4FiniteProductCountingMeasure volume s) := by
    simpa only [s, Gproduct] using
      integrable_norm_rpow_q4ActiveDyadicPowerDualProductField
        E j psi hpsiCompact q p (lt_trans one_lt_two hqgtwo)
          hqtwo hp.le hmul f
  have hfull : eLpNorm
      (q4FiniteProductKernelShell volume s (fun _ _ => True)
        (q4ActiveDyadicPairKernel psi j) Gproduct)
      (ENNReal.ofReal q) (q4FiniteProductCountingMeasure volume s) <=
      L * eLpNorm Gproduct (ENNReal.ofReal p)
        (q4FiniteProductCountingMeasure volume s) := by
    simpa only [s, Gproduct, L] using
      q4ActiveDyadicFullProductPairShell_eLpNorm_le_levelSum_of_active_multiplier_homogeneous
        hd hj hE hcover hCcover hgamma hdeltaone psi hpsiCompact hCkernel hdecay hB
          hmultiplier hp1 hp2 hq Gproduct hGmeas hGint hGsq hGfib hGpower rfl
  have houtmeas : AEStronglyMeasurable
      (q4FiniteProductKernelShell volume s (fun _ _ => True)
        (q4ActiveDyadicPairKernel psi j) Gproduct)
      (q4FiniteProductCountingMeasure volume s) := by
    simpa only [s, Gproduct] using
      aestronglyMeasurable_q4ActiveDyadicFullKernelPowerDualProduct
        E j psi hpsiCompact q hqtwo f
  have hout : ∀ i ∈ s, MemLp
      (q4FiniteProductToFibres s
        (q4FiniteProductKernelShell volume s (fun _ _ => True)
          (q4ActiveDyadicPairKernel psi j) (q4FibresToFiniteProduct s G))) i)
      (ENNReal.ofReal q) volume := by
    intro i hi
    have hmem := memLp_q4FiniteProductToFibres_of_product_eLpNorm_aestronglyMeasurable
      volume s
      (q4FiniteProductKernelShell volume s (fun _ _ => True)
        (q4ActiveDyadicPairKernel psi j) Gproduct)
      Gproduct hqpos hp L hL houtmeas hGmeas hGpower hfull i hi
    simpa only [G, Gproduct, q4ActiveDyadicPowerDualProductField,
      q4FiniteProductToFibres_q4FibresToFiniteProduct_apply] using hmem
  have hinput : ∀ i ∈ s, MemLp (G i) (ENNReal.ofReal p) volume := by
    intro i hi
    have hmeas : Measurable (G i) := by
      simpa only [G] using
        (q4PowerDualField_mem_Q4PhysicalDualCarrier q hqtwo
          (fun k => q4DyadicSurfaceSchwartzPiece psi hpsiCompact (dyadicLeft j k) f) i).2.2.1.measurable
    apply (integrable_norm_rpow_iff hmeas.aestronglyMeasurable
      (ENNReal.ofReal_ne_zero_iff.mpr hp) ENNReal.ofReal_ne_top).mp
    have hpow := integrable_norm_rpow_q4FiniteProductToFibres_of_integrable
      volume s Gproduct hGpower i hi
    rw [q4FiniteProductToFibres_q4ActiveDyadicPowerDualProductField
      E j psi hpsiCompact q f i hi] at hpow
    simpa only [G, ENNReal.toReal_ofReal hp.le] using hpow
  have hroot :
      (q4FibreLpMoment volume s q
        (q4FiniteProductToFibres s
          (q4FiniteProductKernelShell volume s (fun _ _ => True)
            (q4ActiveDyadicPairKernel psi j) (q4FibresToFiniteProduct s G)))) ^ (1 / q) <=
        A * A * (q4FibreLpMoment volume s p G) ^ (1 / p) := by
    simpa only [s, G, L, A] using
      q4ActiveDyadicCanonicalFullProduct_rootMoment_le_of_eLpStrongENNReal_sq
        E j psi hpsiCompact q p (lt_trans one_lt_two hqgtwo) hqtwo hp hmul L hL f
          (by simpa only [Gproduct] using hfull)
  have hS := q4ActiveDyadic_synthesis_norm_le_of_fullProductRoot
    psi hpsiCompact j s hq hqtwo hp hconj hA f hout hinput hroot
  have hpair := q4ActiveDyadic_analysisPairing_eq_l2 psi hpsiCompact j s q hqtwo f
  let F : Int -> Euclidean d -> Complex := fun i =>
    (q4DyadicSurfaceSchwartzPiece psi hpsiCompact (dyadicLeft j i) f :
      Euclidean d -> Complex)
  let R : Real := (q4FibreLpMoment volume s p G) ^ (1 / p)
  have hbilinear : ‖q4FiniteProductPairing volume s F (q4PowerDualField q F)‖ <=
      A * ‖f.toLp 2 volume‖ * R := by
    calc
      ‖q4FiniteProductPairing volume s F (q4PowerDualField q F)‖ =
          ‖inner Complex
            (q4L2FiniteFibreSynthesis s
              (fun i => q4DyadicSurfaceAdjointL2Piece psi hpsiCompact (dyadicLeft j i))
              (q4ActiveDyadicSchwartzAnalysisPowerDualL2 psi hpsiCompact j q hqtwo f))
            (f.toLp 2 volume)‖ := by
        rw [show F = fun i =>
          (q4DyadicSurfaceSchwartzPiece psi hpsiCompact (dyadicLeft j i) f :
            Euclidean d -> Complex) by rfl]
        exact congrArg norm hpair
      _ <= ‖q4L2FiniteFibreSynthesis s
            (fun i => q4DyadicSurfaceAdjointL2Piece psi hpsiCompact (dyadicLeft j i))
            (q4ActiveDyadicSchwartzAnalysisPowerDualL2 psi hpsiCompact j q hqtwo f)‖ *
          ‖f.toLp 2 volume‖ := norm_inner_le_norm _ _
      _ <= (A * R) * ‖f.toLp 2 volume‖ :=
        mul_le_mul_of_nonneg_right (by simpa only [G, R] using hS) (norm_nonneg _)
      _ = A * ‖f.toLp 2 volume‖ * R := by ring
  have hCF : 0 <= A * ‖f.toLp 2 volume‖ := mul_nonneg hA (norm_nonneg _)
  have hmoment := q4FibreLpMoment_rpow_one_div_le_of_dual_test_at_test
    volume s hqpos hp hconj hCF F
    (q4PowerDualTest volume s q p F (lt_trans one_lt_two hqgtwo) hmul) (by
      simpa only [G, F, R] using hbilinear)
  have hphysical : q4FibreLpMoment volume s q
      (fun i x => q4DyadicSurfacePiece psi f (dyadicLeft j i) x) =
      q4FibreLpMoment volume s q F := by
    unfold q4FibreLpMoment
    apply Finset.sum_congr rfl
    intro i hi
    apply integral_congr_ae
    filter_upwards with x
    rw [show q4DyadicSurfacePiece psi f (dyadicLeft j i) x = F i x by
      simpa only [F] using
        (q4DyadicSurfaceSchwartzPiece_apply_eq_q4DyadicSurfacePiece
          psi hpsiCompact (dyadicLeft j i) f x).symm]
  rw [hphysical]
  simpa only [s, F, L, A] using hmoment

/-- The active left-endpoint representative has the selector-free root
moment estimate supplied by the literal finite-product `TT*` calculation.
The deterministic selector used to *name* the measurable representative is
internal to `q4MeasurableActiveDyadicEndpointPiece`; no selector hypothesis
is present here. -/
theorem q4MeasurableActiveDyadicEndpointPiece_rootMoment_le_of_active_multiplier
    {d : Nat} {E : Set Real} {gamma eta Ccover : Real} {j : Nat}
    (hd : 1 <= d) (hj : 1 <= j)
    (hE : E ⊆ Icc (1 : Real) 2)
    (hcover : HasSubpowerAssouadCoverBound E gamma eta Ccover)
    (hCcover : 0 <= Ccover) (hgamma : 0 <= gamma)
    (hdeltaone : dyadicScale j < 1)
    (hs : (activeDyadicIndices E j).Nonempty)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    {Ckernel B : Real} (hCkernel : 0 < Ckernel)
    (hdecay : HasQ4DyadicPairKernelGapDecayOn d (fun _ => psi)
      (1 / 2 : Real) (5 / 2) Ckernel)
    (hB : 0 <= B)
    (hmultiplier : forall i ∈ activeDyadicIndices E j,
      forall l ∈ activeDyadicIndices E j, forall xi : Euclidean d,
        ‖q4ActiveDyadicPairMultiplier psi hpsiCompact j i l xi‖ <= B)
    {p q : Real} (hp1 : 1 < p) (hp2 : p < 2)
    (hq : q = p / (p - 1))
    (f : SchwartzMap (Euclidean d) Complex) :
    (∫ x, ‖q4MeasurableActiveDyadicEndpointPiece E j hs psi f x‖ ^ q ∂volume) ^
        (1 / q) <=
      Real.sqrt
        (∑ n ∈ Finset.range (j + 3),
          q4ActiveDyadicLevelStrongConstant d gamma eta Ccover Ckernel B j n q).toReal *
        ‖f.toLp 2 volume‖ := by
  have hqgtwo : 2 < q := by
    rw [hq]
    have hpminus : 0 < p - 1 := by linarith
    apply (lt_div_iff₀ hpminus).mpr
    nlinarith
  have hanalysis := q4ActiveDyadic_analysis_rootMoment_le_of_active_multiplier
    hd hj hE hcover hCcover hgamma hdeltaone psi hpsiCompact hCkernel hdecay hB
      hmultiplier hp1 hp2 hq f
  apply q4MeasurableActiveDyadicEndpointPiece_moment_le_of_fibreLpMoment
    E j hs psi f (lt_trans zero_lt_two hqgtwo) hanalysis
  · exact integrable_norm_q4MeasurableActiveDyadicEndpointPiece_rpow_of_schwartz
      E j hs psi hpsiCompact f (lt_trans zero_lt_two hqgtwo)
  · intro i hi
    exact integrable_norm_q4DyadicSurfacePiece_rpow_of_schwartz
      psi hpsiCompact (dyadicLeft j i) f (lt_trans zero_lt_two hqgtwo)

/-- Extended `L^q` form of the selector-free endpoint estimate.  This is
the direct input to the active-cell sampling inequality in the proof of
Theorem 1. -/
theorem q4MeasurableActiveDyadicEndpointPiece_eLpNorm_le_of_active_multiplier
    {d : Nat} {E : Set Real} {gamma eta Ccover : Real} {j : Nat}
    (hd : 1 <= d) (hj : 1 <= j)
    (hE : E ⊆ Icc (1 : Real) 2)
    (hcover : HasSubpowerAssouadCoverBound E gamma eta Ccover)
    (hCcover : 0 <= Ccover) (hgamma : 0 <= gamma)
    (hdeltaone : dyadicScale j < 1)
    (hs : (activeDyadicIndices E j).Nonempty)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    {Ckernel B : Real} (hCkernel : 0 < Ckernel)
    (hdecay : HasQ4DyadicPairKernelGapDecayOn d (fun _ => psi)
      (1 / 2 : Real) (5 / 2) Ckernel)
    (hB : 0 <= B)
    (hmultiplier : forall i ∈ activeDyadicIndices E j,
      forall l ∈ activeDyadicIndices E j, forall xi : Euclidean d,
        ‖q4ActiveDyadicPairMultiplier psi hpsiCompact j i l xi‖ <= B)
    {p q : Real} (hp1 : 1 < p) (hp2 : p < 2)
    (hq : q = p / (p - 1))
    (f : SchwartzMap (Euclidean d) Complex) :
    eLpNorm (q4MeasurableActiveDyadicEndpointPiece E j hs psi f)
      (ENNReal.ofReal q) volume <=
      ENNReal.ofReal
        (Real.sqrt
          (∑ n ∈ Finset.range (j + 3),
            q4ActiveDyadicLevelStrongConstant d gamma eta Ccover Ckernel B j n q).toReal *
          ‖f.toLp 2 volume‖) := by
  have hqgtwo : 2 < q := by
    rw [hq]
    have hpminus : 0 < p - 1 := by linarith
    apply (lt_div_iff₀ hpminus).mpr
    nlinarith
  have hqpos : 0 < q := lt_trans zero_lt_two hqgtwo
  have hroot := q4MeasurableActiveDyadicEndpointPiece_rootMoment_le_of_active_multiplier
    hd hj hE hcover hCcover hgamma hdeltaone hs psi hpsiCompact hCkernel hdecay hB
      hmultiplier hp1 hp2 hq f
  have hmem := memLp_norm_q4MeasurableActiveDyadicEndpointPiece_of_schwartz
    E j hs psi hpsiCompact f hqpos
  have hnorm := eLpNorm_le_of_rpow_root_moment volume
    (fun x => ‖q4MeasurableActiveDyadicEndpointPiece E j hs psi f x‖)
    hqpos hmem hroot
  simpa only [eLpNorm_norm] using hnorm

end

end Codex.Spherical.FractalDilations.Q4ActualEndpointTTStar