        (ENNReal.ofReal t) ^ (q - s - 1) := by
  rw [ofReal_rpow_weight_s ht]
  calc
    m * ((ENNReal.ofReal (2 : ℝ)) ^ s *
        (ENNReal.ofReal ((t / 2) ^ s) *
          (ENNReal.ofReal t) ^ (q - s - 1))) =
        (ENNReal.ofReal ((t / 2) ^ s) * m) *
