theorem ofReal_rpow_weight_s
    {s q t : ℝ} (ht : 0 < t) :
    ENNReal.ofReal (t ^ (q - 1)) =
      (ENNReal.ofReal (2 : ℝ)) ^ s *
        (ENNReal.ofReal ((t / 2) ^ s) *
          (ENNReal.ofReal t) ^ (q - s - 1)) := by
  have hhalf : 0 < t / 2 := by positivity
  have htwo : 0 < (2 : ℝ) := by norm_num
  have hreal :
      t ^ (q - 1) = (2 : ℝ) ^ s * ((t / 2) ^ s * t ^ (q - s - 1)) := by
