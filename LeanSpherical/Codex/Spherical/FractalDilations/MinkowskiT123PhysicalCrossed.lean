  exact minkowski_t123_physical_crossed_dyadic_rate_of_hasUpperMinkowskiExponent
    hn hE hEne halpha hM hp1 hps hs2 heta hcritical hq_relation hgain
    phi psi hphiOne hphiZero hphiNorm hpsi

