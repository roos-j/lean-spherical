    (upper_spectrum_polygon_sharpness (d := d) (E := E) (β := β) (θ := 0)
      (p := p) (q := q) hd hE hEne hβ hMinkowski
      ⟨by norm_num, by norm_num⟩ hspectrum hp hq (by simpa [hratio] using houtside))

