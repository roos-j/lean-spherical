/-- The geometric combination of the four tests gives Theorem 2(ii). -/
theorem upper_spectrum_polygon_sharpness
    {d : ℕ} (hd : 2 ≤ d)
    (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    {β θ p q : ℝ}
    (hβ : 0 ≤ β ∧ β ≤ 1)
    (hMinkowski : upperMinkowskiDimension E = β)
    (hθ : 0 ≤ θ ∧ θ < 1)
    (hspectrum : upperAssouadSpectrum E θ = β / (1 - θ))
    (hp : 0 < p) (hq : 1 ≤ q)
    (houtside : reciprocalExponentPoint p q ∉ Q d β (β / (1 - θ))) :
    FractalSphericalUnbounded d E p q := by
  have hd0 : 0 < d := by omega
  have hEpos : E ⊆ Ioi (0 : ℝ) := by
    intro r hr
    exact lt_of_lt_of_le zero_lt_one (hE hr).1
  have hden : 0 < 1 - θ := sub_pos.mpr hθ.2
  have hβγ : β ≤ β / (1 - θ) := by
    rw [le_div_iff₀ hden]
    have hden_le_one : 1 - θ ≤ 1 := by linarith [hθ.1]
    nlinarith [hβ.1]
  apply fractalSphericalUnbounded_of_not_mem_Q_of_tests hd hβ.1 hβ.2 hβγ
  · intro hbad
    exact translation_invariance_test hd0 E hEpos hEne hp
      (lt_of_lt_of_le zero_lt_one hq) hbad
  · intro hbad
    exact spherical_cap_test hd E hE hEne hp
      (lt_of_lt_of_le zero_lt_one hq) hbad
  · intro hbad
    exact minkowski_annulus_test hd E hE hEne hβ hMinkowski hp hq hbad
  · intro hbad
    apply upper_spectrum_cluster_test hd E hE hEne hβ hMinkowski hθ hspectrum hp hq
    have hfunctional :
        spectrumClusterFunctional d β (β / (1 - θ)) p q =
          clusterEdgeFunctional d (β / (β / (1 - θ))) β
            (reciprocalExponentPoint p q) := by
      simp only [spectrumClusterFunctional, clusterEdgeFunctional,
        reciprocalExponentPoint]
      ring
    rw [hfunctional]
    exact hbad
  · exact houtside

