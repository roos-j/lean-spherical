/-- The functional appearing in the clustered-radius test of §4.4.  Its
zero set is the line through `Q3(β)` and `Q4(γ)`. -/
def spectrumClusterFunctional (d : ℕ) (β γ p q : ℝ) : ℝ :=
  let α := β / γ
  α / 2 * ((d : ℝ) - 1) +
    ((d : ℝ) - β - ((d : ℝ) - 1) * α / 2) * q⁻¹ -
      (1 + α / 2 * ((d : ℝ) - 1)) * p⁻¹

