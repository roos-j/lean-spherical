    FractalSphericalUnbounded d E p q := by
  have hratio : β / (1 - 0) = β := by ring
  have hspectrum : upperAssouadSpectrum E 0 = β / (1 - 0) := by
    rw [upperAssouadSpectrum_zero_eq_upperMinkowskiDimension hE, hMinkowski]
    exact hratio.symm
