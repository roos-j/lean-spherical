    (hbad : spectrumClusterFunctional d β (β / (1 - θ)) p q < 0) :
    FractalSphericalUnbounded d E p q := by
  apply upper_spectrum_cluster_test_of_expanded_functional
    hd E hE hEne hβ hθ hspectrum hp hq
