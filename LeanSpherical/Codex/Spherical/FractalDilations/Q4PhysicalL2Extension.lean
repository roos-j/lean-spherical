is an honest `L¹ ∩ L²` input for every displayed physical convolution. -/
theorem q4ActiveDyadicSchwartzPowerDualFullKernel_ae_eq_l2PairShell
    {d : Nat} (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (j : Nat) (s : Finset Int) (q : Real) (hq : 2 ≤ q)
    (f : SchwartzMap (Euclidean d) Complex) (i : Int) (hi : i ∈ s) :
    q4FiniteProductToFibres s
      (q4FiniteProductKernelShell volume s (fun (_ _ : Int) => True)
        (q4ActiveDyadicPairKernel psi j)
        (q4FibresToFiniteProduct s
          (q4PowerDualField q
            (fun k => (q4DyadicSurfaceSchwartzPiece psi hpsiCompact
              (dyadicLeft j k) f : Euclidean d -> Complex))))) i =ᵐ[volume]
      fun x : Euclidean d =>
        ((q4L2FiniteProductPairShell s
          (fun a b => q4ActiveDyadicPairL2Piece psi hpsiCompact j a b)
          (q4ActiveDyadicSchwartzAnalysisPowerDualL2
            psi hpsiCompact j q hq f) i :
          Lp Complex 2 (volume : Measure (Euclidean d))) :
          Euclidean d -> Complex) x := by
  classical
  let F : Int -> SchwartzMap (Euclidean d) Complex := fun k =>
    q4DyadicSurfaceSchwartzPiece psi hpsiCompact (dyadicLeft j k) f
  let g : Int -> Euclidean d -> Complex :=
    q4PowerDualField q (fun k => (F k : Euclidean d -> Complex))
  have hcarrier : Q4PhysicalDualCarrier g := by
    simpa only [g] using
      q4PowerDualField_mem_Q4PhysicalDualCarrier q hq F
  have hphysical := q4FiniteProductToFibres_activeDyadicFullKernel_ae_eq_l2PairShell
    psi hpsiCompact j s g (fun l => (hcarrier l).1)
      (fun l => (hcarrier l).2.1) i hi
  have hdual (l : Int) :
      ((hcarrier l).2.1.toLp (g l) :
        Lp Complex 2 (volume : Measure (Euclidean d))) =
      q4ActiveDyadicSchwartzAnalysisPowerDualL2 psi hpsiCompact j q hq f l := by
    apply Lp.ext
    filter_upwards [(hcarrier l).2.1.coeFn_toLp,
      q4ActiveDyadicSchwartzAnalysisPowerDualL2_coeFn_ae_eq
        psi hpsiCompact j q hq f l] with x hx htarget
    rw [hx]
    simpa only [g, F] using htarget.symm
  have hpairshell :
      q4L2FiniteProductPairShell s
        (fun a b => q4ActiveDyadicPairL2Piece psi hpsiCompact j a b)
        (fun l => (hcarrier l).2.1.toLp (g l)) i =
      q4L2FiniteProductPairShell s
        (fun a b => q4ActiveDyadicPairL2Piece psi hpsiCompact j a b)
        (q4ActiveDyadicSchwartzAnalysisPowerDualL2
          psi hpsiCompact j q hq f) i := by
    unfold q4L2FiniteProductPairShell
    apply Finset.sum_congr rfl
    intro l hl
    rw [hdual l]
  filter_upwards [hphysical] with x hx
  simpa only [g, F, hpairshell] using hx

/-- The preceding physical identity expressed directly against the completed
analysis--synthesis operator.  This is the exact bridge from the paper's
literal full `TT*` kernel to the Hilbert-space energy used in the finite
strong-type argument. -/
theorem q4ActiveDyadicSchwartzPowerDualFullKernel_ae_eq_l2AnalysisSynthesis
    {d : Nat} (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (j : Nat) (s : Finset Int) (q : Real) (hq : 2 ≤ q)
    (f : SchwartzMap (Euclidean d) Complex) (i : Int) (hi : i ∈ s) :
    q4FiniteProductToFibres s
      (q4FiniteProductKernelShell volume s (fun (_ _ : Int) => True)
        (q4ActiveDyadicPairKernel psi j)
        (q4FibresToFiniteProduct s
          (q4PowerDualField q
            (fun k => (q4DyadicSurfaceSchwartzPiece psi hpsiCompact
              (dyadicLeft j k) f : Euclidean d -> Complex))))) i =ᵐ[volume]
      fun x : Euclidean d =>
        ((q4L2FiniteProductAnalysis
          (fun k => q4DyadicSurfaceL2Piece psi hpsiCompact (dyadicLeft j k))
          (q4L2FiniteFibreSynthesis s
            (fun k => q4DyadicSurfaceAdjointL2Piece psi hpsiCompact
              (dyadicLeft j k))
            (q4ActiveDyadicSchwartzAnalysisPowerDualL2
              psi hpsiCompact j q hq f)) i :
          Lp Complex 2 (volume : Measure (Euclidean d))) :
          Euclidean d -> Complex) x := by
  have hphysical := q4ActiveDyadicSchwartzPowerDualFullKernel_ae_eq_l2PairShell
    psi hpsiCompact j s q hq f i hi
  have hfactor := congrFun
    (q4ActiveDyadicL2FiniteProduct_analysis_synthesis_eq_pairShell
      psi hpsiCompact j s
      (q4ActiveDyadicSchwartzAnalysisPowerDualL2 psi hpsiCompact j q hq f)) i
  filter_upwards [hphysical] with x hx
  rw [hfactor]
  exact hx

end

