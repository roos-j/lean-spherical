theorem circle_minkowski_diagonal_strong_type_of_upperMinkowskiDimension_eq
    (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2)
    {β p : ℝ} (hβ : 0 ≤ β)
    (hMinkowski : upperMinkowskiDimension E = β)
    (hp1 : 1 < p) (hp2 : p < 2) (hcritical : β < p - 1) :
    HasFractalSphericalStrongType 2 E p p := by
  rcases eq_empty_or_nonempty E with rfl | hEne
  · refine ⟨1, zero_lt_one, ?_⟩
    intro f
    have hzero : fractalSphericalMaximalReal 2 (∅ : Set ℝ) f = 0 := by
      funext x
      simp [fractalSphericalMaximalReal, fractalSphericalMaximal]
    rw [hzero]
    simp
  let ε : ℝ := (p - 1 - β) / 2
  let α : ℝ := β + ε
  have hε : 0 < ε := by
    dsimp only [ε]
    linarith
  have hα : 0 ≤ α := by
    dsimp only [α]
    exact add_nonneg hβ hε.le
  have hαcritical : α < p - 1 := by
    dsimp only [α, ε]
    linarith
  have hM : HasUpperMinkowskiExponent E α := by
    simpa only [α] using
      hasUpperMinkowskiExponent_add_of_upperMinkowskiDimension_eq hE hMinkowski hε
  exact circle_minkowski_diagonal_strong_type_of_hasUpperMinkowskiExponent
    E hE hEne hα hM hp1 hp2 hαcritical

/-- The planar diagonal estimate above the `L²` line.  A strictly
subcritical Minkowski exponent admits an auxiliary exponent in `(1,2)`;
the result then follows from the preceding direct circle estimate and the
pointwise `L∞` contraction. -/
theorem circle_minkowski_diagonal_strong_type_of_hasUpperMinkowskiExponent_ge_two
    (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    {α p : ℝ} (hα : 0 ≤ α) (hαone : α < 1)
    (hM : HasUpperMinkowskiExponent E α) (hp : 2 ≤ p) :
    HasFractalSphericalStrongType 2 E p p := by
  let q : ℝ := (α + 3) / 2
  have hqone : 1 < q := by
    dsimp only [q]
    linarith
  have hqtwo : q < 2 := by
    dsimp only [q]
    linarith
  have hqpos : 0 < q := lt_trans zero_lt_one hqone
  have hcritical : α < q - 1 := by
    dsimp only [q]
    linarith
  have hqp : q < p := hqtwo.trans_le hp
  have hEpos : E ⊆ Ioi (0 : ℝ) := by
    intro r hr
    exact lt_of_lt_of_le zero_lt_one (hE hr).1
  have hqstrong : HasFractalSphericalStrongType 2 E q q :=
    circle_minkowski_diagonal_strong_type_of_hasUpperMinkowskiExponent
      E hE hEne hα hM hqone hqtwo hcritical
  exact fractalSphericalStrongType_of_diagonal_and_top (d := 2)
    (by norm_num) E hEpos hqpos hqp hqstrong

/-- The same above-`L²` planar diagonal estimate stated in terms of equality
of upper Minkowski dimension.  The harmless exponent loss is chosen below
one, which is exactly what the interpolation step needs. -/
theorem circle_minkowski_diagonal_strong_type_of_upperMinkowskiDimension_eq_ge_two
    (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2)
    {β p : ℝ} (hβ : 0 ≤ β) (hβone : β < 1)
    (hMinkowski : upperMinkowskiDimension E = β) (hp : 2 ≤ p) :
    HasFractalSphericalStrongType 2 E p p := by
  rcases eq_empty_or_nonempty E with rfl | hEne
  · refine ⟨1, zero_lt_one, ?_⟩
    intro f
    have hzero : fractalSphericalMaximalReal 2 (∅ : Set ℝ) f = 0 := by
      funext x
      simp [fractalSphericalMaximalReal, fractalSphericalMaximal]
    rw [hzero]
    simp
  let ε : ℝ := (1 - β) / 2
  let α : ℝ := β + ε
  have hε : 0 < ε := by
    dsimp only [ε]
    linarith
  have hα : 0 ≤ α := by
    dsimp only [α]
    exact add_nonneg hβ hε.le
  have hαone : α < 1 := by
    dsimp only [α, ε]
    linarith
  have hM : HasUpperMinkowskiExponent E α := by
    simpa only [α] using
      hasUpperMinkowskiExponent_add_of_upperMinkowskiDimension_eq hE hMinkowski hε
  exact circle_minkowski_diagonal_strong_type_of_hasUpperMinkowskiExponent_ge_two
    E hE hEne hα hαone hM hp

end

