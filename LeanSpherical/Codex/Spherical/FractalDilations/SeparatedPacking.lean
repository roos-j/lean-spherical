/-!
# Separated finite radius sets and interval covers

The discrete radius sets used in the dyadic maximal-function argument are
chosen at one mesh scale.  This file isolates the elementary packing fact:
a strictly mesh-separated finite family has cardinality at most that of every
closed interval cover at the same mesh scale.  It is useful both for the
upper `TT*` shell counts and for turning covering-number lower bounds into
disjoint sharpness witnesses.
-/

namespace LeanSpherical.HarmonicAnalysis.FractalDilations

open Set

noncomputable section

/-- A finite set of real numbers is strictly `δ`-separated when distinct
members have distance larger than `δ`.  The strict convention matches covers
by closed intervals of length `δ`, avoiding a boundary ambiguity. -/
def StrictlySeparated (s : Finset ℝ) (δ : ℝ) : Prop :=
  ∀ ⦃x y : ℝ⦄, x ∈ s → y ∈ s → x ≠ y → δ < |x - y|

/-- A same-scale closed interval cover cannot contain fewer intervals than a
strictly mesh-separated finite subset of the set it covers. -/
theorem Finset.card_le_card_of_strictlySeparated_intervalCover
    {F : Set ℝ} {δ : ℝ} {s ι : Finset ℝ}
    (_hδ : 0 < δ) (hsF : (↑s : Set ℝ) ⊆ F)
    (hsep : StrictlySeparated s δ) (hcover : IsIntervalCover F δ ι) :
    s.card ≤ ι.card := by
  classical
  have hexists : ∀ x : ℝ, x ∈ s →
      ∃ a : ℝ, a ∈ ι ∧ x ∈ Icc (a - δ / 2) (a + δ / 2) := by
    intro x hx
    rcases Set.mem_iUnion.mp (hcover (hsF hx)) with ⟨a, ha⟩
    rcases Set.mem_iUnion.mp ha with ⟨haι, hxa⟩
    exact ⟨a, haι, hxa⟩
  choose c hcι hc using hexists
  let g : ℝ → ℝ := fun x => if hx : x ∈ s then c x hx else 0
  have hg (x : ℝ) (hx : x ∈ s) : g x = c x hx := by
    simp only [g, dif_pos hx]
  apply Finset.card_le_card_of_injOn g
  · intro x hx
    rw [hg x hx]
    exact hcι x hx
  · intro x hx y hy hxy
    by_contra hne
    have hxI : x ∈ Icc (c x hx - δ / 2) (c x hx + δ / 2) := hc x hx
    have hyI : y ∈ Icc (c y hy - δ / 2) (c y hy + δ / 2) := hc y hy
    have hcEq : c x hx = c y hy := by
      calc
        c x hx = g x := (hg x hx).symm
        _ = g y := hxy
        _ = c y hy := hg y hy
    rw [← hcEq] at hyI
    have habs : |x - y| ≤ δ := by
      rw [abs_le]
      constructor <;> linarith [hxI.1, hxI.2, hyI.1, hyI.2]
    exact (not_lt_of_ge habs) (hsep hx hy hne)

/-- The packing bound in real-valued form, convenient for combining with
covering exponents. -/
theorem Finset.card_le_card_of_strictlySeparated_intervalCover_real
    {F : Set ℝ} {δ : ℝ} {s ι : Finset ℝ}
    (hδ : 0 < δ) (hsF : (↑s : Set ℝ) ⊆ F)
    (hsep : StrictlySeparated s δ) (hcover : IsIntervalCover F δ ι) :
    (s.card : ℝ) ≤ (ι.card : ℝ) := by
  exact_mod_cast Finset.card_le_card_of_strictlySeparated_intervalCover
    hδ hsF hsep hcover

end

