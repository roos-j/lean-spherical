  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_iteratedDeriv_bound_on_fixedAnnulus density hdensity N
  obtain ⟨B, hB, hBbound⟩ :=
    exists_uniform_planarCoordinateWave_physical N p
  obtain ⟨D, hD, hDbound⟩ :=
    exists_uniform_normalizedDyadicCutoffSquare_bound_on_unit (N := N)
      (by norm_num : 1 ≤ 2) phi hphiOne hphiZero hphiRadial
  let E : Real := ∑ l ∈ Finset.range (N + 1), tripleWaveLeibnizConstant l A B
  have hEnonneg : 0 ≤ E := by
    dsimp [E]
    apply Finset.sum_nonneg
    intro l hl
    exact tripleWaveLeibnizConstant_nonneg l hA.le hB.le
  let F : Real := ∑ l ∈ Finset.range (N + 1), tripleWaveLeibnizConstant l E D
  have hFnonneg : 0 ≤ F := by
    dsimp [F]
    apply Finset.sum_nonneg
    intro l hl
    exact tripleWaveLeibnizConstant_nonneg l hEnonneg hD.le
  refine ⟨F + 1, by linarith, ?_⟩
  intro v x hv k hk u hu
  let physical : Real → Complex := fun z : Real =>
    planarCoordinateWaveRadialAmplitude p ‖x‖ z
  let cutoff : Real → Complex := normalizedDyadicCutoffSquare phi v
  have hphysical : ContDiff Real (⊤ : ℕ∞) physical := by
    dsimp [physical]
    exact contDiff_planarCoordinateWaveRadialAmplitude p ‖x‖
  have hcutoff : ContDiff Real (⊤ : ℕ∞) cutoff := by
    dsimp [cutoff]
    exact contDiff_normalizedDyadicCutoffSquare phi v
  have hfirst : ∀ i : Nat, i ≤ k →
      ‖iteratedDeriv i (fun z : Real => density z * physical z) u‖ ≤ E := by
    intro i hi
    have hprod := norm_iteratedDeriv_mul_le_tripleWaveLeibnizConstant
      (n := i) hdensity hphysical hA.le hB.le
      (fun l hl => hAbound l (hl.trans (hi.trans hk)) u hu)
      (fun l hl => hBbound l (hl.trans (hi.trans hk)) ‖x‖ u (norm_nonneg _) hu)
    calc
      ‖iteratedDeriv i (fun z : Real => density z * physical z) u‖ ≤
          tripleWaveLeibnizConstant i A B := hprod
      _ ≤ E := by
        unfold E
        have himem : i ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
        exact Finset.single_le_sum
          (fun l hl => tripleWaveLeibnizConstant_nonneg l hA.le hB.le) himem
  have htotal := norm_iteratedDeriv_mul_le_tripleWaveLeibnizConstant
    (n := k) (hdensity.mul hphysical) hcutoff hEnonneg hD.le hfirst
    (fun l hl => hDbound v hv l (hl.trans hk) u hu)
  have hFbound : tripleWaveLeibnizConstant k E D ≤ F := by
    unfold F
    have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    exact Finset.single_le_sum
      (fun l hl => tripleWaveLeibnizConstant_nonneg l hEnonneg hD.le) hkmem
  unfold planarCoordinateTripleWaveFixedAmplitude
  change ‖iteratedDeriv k (fun z : Real => density z * physical z * cutoff z) u‖ ≤ F + 1
  calc
    ‖iteratedDeriv k (fun z : Real => density z * physical z * cutoff z) u‖ ≤
        tripleWaveLeibnizConstant k E D := htotal
    _ ≤ F + 1 := by linarith

/-- At level zero the literal absolute bandpass along a unit ray is its
normalized radial profile. -/
private theorem absoluteDyadicBandpass_zero_smul_eq_normalized_planar
    (phi : SchwartzMap (Euclidean 2) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (v : Euclidean 2) (u : Real) :
    absoluteDyadicBandpass phi hphiOne hphiZero 0 (u • v) =
      normalizedDyadicRadialBandpass phi v u := by
  exact absoluteDyadicBandpass_zero_smul_eq_normalized phi hphiOne hphiZero v u

/-- Exact factorization of the actual planar triple coefficient into its
fixed physical/cutoff factor and the two multiplier-side waves. -/
private theorem planarCoordinateTripleWaveCoefficient_eq_fixed_mul_pair
    (phi : SchwartzMap (Euclidean 2) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (R R' : Real) (v x : Euclidean 2)
    (p q t : CoordinateWavePart) (u : Real) :
    planarCoordinateTripleWaveCoefficient
      (absoluteDyadicBandpass phi hphiOne hphiZero 0)
      R R' v x p q t u =
      planarCoordinateTripleWaveFixedAmplitude phi v x p u *
        planarCoordinateWaveMultiplierPairAmplitude q t R R' u := by
  have hcutoff := absoluteDyadicBandpass_zero_smul_eq_normalized_planar
    phi hphiOne hphiZero v u
  unfold planarCoordinateTripleWaveCoefficient
    planarCoordinateTripleWaveFixedAmplitude
    planarCoordinateWaveMultiplierPairAmplitude normalizedDyadicCutoffSquare
  rw [hcutoff, map_mul]
  ring

/-- The literal planar coefficient has the `s⁻¹` stationary scale through
every prescribed finite radial derivative order. -/
private theorem exists_uniform_planarCoordinateTripleWaveCoefficient_scaled
    (N : Nat) (phi : SchwartzMap (Euclidean 2) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiRadial : IsNormRadial phi)
    (p q t : CoordinateWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N →
      ∀ s r r' u : Real, 1 ≤ s →
        r ∈ Icc (1 / 2 : Real) (5 / 2) →
        r' ∈ Icc (1 / 2 : Real) (5 / 2) →
        ∀ v x : Euclidean 2, ‖v‖ = 1 → u ∈ Icc (1 / 2 : Real) 8 →
          ‖iteratedDeriv k (fun z : Real =>
            planarCoordinateTripleWaveCoefficient
              (absoluteDyadicBandpass phi hphiOne hphiZero 0)
              (s * r) (s * r') v x p q t z) u‖ ≤ C / s := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_planarCoordinateTripleWaveFixedAmplitude_bound N phi
      hphiOne hphiZero hphiRadial p
  obtain ⟨B, hB, hBbound⟩ :=
    exists_uniform_planarCoordinateWaveMultiplierPair_scaled N q t
  let C : Real := ∑ l ∈ Finset.range (N + 1), tripleWaveLeibnizConstant l A B
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact tripleWaveLeibnizConstant_nonneg l hA.le hB.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk s r r' u hs hr hr' v x hv hu
  have hfixed : ∀ i : Nat, i ≤ k →
      ‖iteratedDeriv i (planarCoordinateTripleWaveFixedAmplitude phi v x p) u‖ ≤ A := by
    intro i hi
    exact hAbound v x hv i (hi.trans hk) u hu
  have hpair : ∀ i : Nat, i ≤ k →
      ‖iteratedDeriv i
        (planarCoordinateWaveMultiplierPairAmplitude q t (s * r) (s * r')) u‖ ≤
        B / s := by
    intro i hi
    exact hBbound i (hi.trans hk) s r r' u hs hr hr' hu
  have hprod := norm_iteratedDeriv_mul_le_tripleWaveLeibnizConstant
    (n := k) (contDiff_planarCoordinateTripleWaveFixedAmplitude phi v x p)
      (contDiff_planarCoordinateWaveMultiplierPairAmplitude q t (s * r) (s * r'))
      hA.le (div_nonneg hB.le (zero_le_one.trans hs)) hfixed hpair
  have hfactorfun : (fun z : Real =>
      planarCoordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        (s * r) (s * r') v x p q t z) =
      fun z : Real => planarCoordinateTripleWaveFixedAmplitude phi v x p z *
        planarCoordinateWaveMultiplierPairAmplitude q t (s * r) (s * r') z := by
    funext z
    exact planarCoordinateTripleWaveCoefficient_eq_fixed_mul_pair
      phi hphiOne hphiZero (s * r) (s * r') v x p q t z
  rw [hfactorfun]
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  calc
    ‖iteratedDeriv k (fun z : Real =>
        planarCoordinateTripleWaveFixedAmplitude phi v x p z *
          planarCoordinateWaveMultiplierPairAmplitude q t (s * r) (s * r') z) u‖ ≤
        tripleWaveLeibnizConstant k A (B / s) := hprod
    _ = tripleWaveLeibnizConstant k A B / s := by
      rw [tripleWaveLeibnizConstant_right_div k A B s hspos.ne']
    _ ≤ C / s := by
      apply div_le_div_of_nonneg_right
      · have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
        unfold C
        exact Finset.single_le_sum
          (fun l hl => tripleWaveLeibnizConstant_nonneg l hA.le hB.le) hkmem
      · exact hspos
    _ ≤ (C + 1) / s := by
      apply div_le_div_of_nonneg_right
      · linarith
      · exact hspos

/-- Endpoint vanishing of the literal planar coefficient on the enlarged
annulus supplies the boundary conditions for compact integration by parts. -/
private theorem planarCoordinateTripleWaveCoefficient_eventuallyEq_zero_left
    (phi : SchwartzMap (Euclidean 2) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (r r' : Real) (v x : Euclidean 2) (hv : ‖v‖ = 1)
    (p q t : CoordinateWavePart) :
    planarCoordinateTripleWaveCoefficient
      (absoluteDyadicBandpass phi hphiOne hphiZero 0)
      r r' v x p q t =ᶠ[𝓝 (1 / 2 : Real)] 0 := by
  filter_upwards [Metric.ball_mem_nhds (1 / 2 : Real)
      (by norm_num : (0 : Real) < 1 / 4)] with u hu
  rw [mem_ball, Real.dist_eq] at hu
  have huabs : |u - 1 / 2| < 1 / 4 := hu
  have hu0 : 1 / 2 ≤ u := by
    have := (abs_lt.mp huabs).1
    linarith
  have huone : u ≤ 1 := by
    have := (abs_lt.mp huabs).2
    linarith
  exact planarCoordinateTripleWaveCoefficient_absoluteDyadicBandpass_eq_zero_left
    phi hphiOne hphiZero r r' v x hv p q t ⟨hu0, huone⟩

private theorem planarCoordinateTripleWaveCoefficient_eventuallyEq_zero_right
    (phi : SchwartzMap (Euclidean 2) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (r r' : Real) (v x : Euclidean 2) (hv : ‖v‖ = 1)
    (p q t : CoordinateWavePart) :
    planarCoordinateTripleWaveCoefficient
      (absoluteDyadicBandpass phi hphiOne hphiZero 0)
      r r' v x p q t =ᶠ[𝓝 (8 : Real)] 0 := by
  filter_upwards [Metric.ball_mem_nhds (8 : Real)
      (by norm_num : (0 : Real) < 1)] with u hu
  rw [mem_ball, Real.dist_eq] at hu
  have huabs : |u - 8| < 1 := hu
  have hufour : 4 ≤ u := by
    have := (abs_lt.mp huabs).1
    linarith
  exact planarCoordinateTripleWaveCoefficient_absoluteDyadicBandpass_eq_zero_right
    phi hphiOne hphiZero r r' v x hv p q t ⟨hufour, by linarith⟩

private theorem hasOscillatoryIBPChain_planarCoordinateTripleWaveCoefficient
    (phi : SchwartzMap (Euclidean 2) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (r r' : Real) (v x : Euclidean 2) (hv : ‖v‖ = 1)
    (p q t : CoordinateWavePart) (N : Nat) :
    HasOscillatoryIBPChain (1 / 2 : Real) 8
      (fun k => iteratedDeriv k
        (planarCoordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          r r' v x p q t)) N := by
  apply hasOscillatoryIBPChain_iteratedDeriv_of_contDiff
  · exact contDiff_planarCoordinateTripleWaveCoefficient
      (absoluteDyadicBandpass phi hphiOne hphiZero 0) r r' v x p q t
  · exact planarCoordinateTripleWaveCoefficient_eventuallyEq_zero_left
      phi hphiOne hphiZero r r' v x hv p q t
  · exact planarCoordinateTripleWaveCoefficient_eventuallyEq_zero_right
      phi hphiOne hphiZero r r' v x hv p q t

private theorem norm_intervalIntegral_planarCoordinateTripleWaveCoefficient_le_iterated
    (N : Nat) (phi : SchwartzMap (Euclidean 2) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (r r' : Real) (v x : Euclidean 2) (hv : ‖v‖ = 1)
    (p q t : CoordinateWavePart) (freq M : Real)
    (hfreq : freq ≠ 0) (hM : 0 ≤ M)
    (hbound : ∀ u ∈ Icc (1 / 2 : Real) 8,
      ‖iteratedDeriv N (planarCoordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        r r' v x p q t) u‖ ≤ M) :
    ‖∫ u in (1 : Real)..4,
      planarCoordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        r r' v x p q t u * oscillatoryExp freq u‖ ≤
      (1 / |freq|) ^ N * ((8 - (1 / 2 : Real)) * M) := by
  rw [intervalIntegral_planarCoordinateTripleWaveCoefficient_eq_expanded
    phi hphiOne hphiZero r r' v x hv p q t]
  exact norm_intervalIntegral_mul_oscillatoryExp_le_iterated
    (by norm_num) hfreq
    (hasOscillatoryIBPChain_planarCoordinateTripleWaveCoefficient
      phi hphiOne hphiZero r r' v x hv p q t N)
    hM hbound

/-- Inner-cone endpoint triples have a literal nonstationary planar phase.
Two integrations by parts give more than the half-power gap decay needed in
dimension two. -/
private theorem exists_inner_endpoint_planarCoordinateTripleWaveIntegral_bound
    (phi : SchwartzMap (Euclidean 2) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiRadial : IsNormRadial phi)
    (p q t : CoordinateWavePart)
    (hp : p ≠ .middle) (hq : q ≠ .middle) (ht : t ≠ .middle) :
    ∃ C : Real, 0 < C ∧ ∀ s r r' : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) →
      r' ∈ Icc (1 / 2 : Real) (5 / 2) → r ≠ r' →
      ∀ v x : Euclidean 2, ‖v‖ = 1 → ‖x‖ ≤ |r - r'| / 4 →
      ‖∫ u in (1 : Real)..4,
        planarCoordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v (s • x) p q t u *
          oscillatoryExp
            (coordinateTripleWavePhase p q t ‖s • x‖ (s * r) (s * r')) u‖ ≤
        (4 / (s * |r - r'|)) ^ 2 *
          ((8 - (1 / 2 : Real)) * (C / s)) := by
  obtain ⟨C, hC, hCbound⟩ :=
    exists_uniform_planarCoordinateTripleWaveCoefficient_scaled 2 phi
      hphiOne hphiZero hphiRadial p q t
  refine ⟨C, hC, ?_⟩
  intro s r r' hs hr hr' hrr v x hv hxcone
  let y : Euclidean 2 := s • x
  let freq : Real := coordinateTripleWavePhase p q t ‖y‖ (s * r) (s * r')
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hgap : 0 < |r - r'| := abs_pos.mpr (sub_ne_zero.mpr hrr)
  have hscalednorm : ‖y‖ = s * ‖x‖ := by
    dsimp [y]
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hspos]
  have horig : |r - r'| / 4 ≤
      |coordinateTripleWavePhase p q t ‖x‖ r r'| :=
    abs_coordinateTripleWavePhase_ge_quarter_gap_of_endpoints hp hq ht hr hr'
      (norm_nonneg _) hxcone
  have hfreqscale : freq =
      s * coordinateTripleWavePhase p q t ‖x‖ r r' := by
    dsimp [freq]
    rw [hscalednorm]
    exact coordinateTripleWavePhase_scale s ‖x‖ r r' p q t
  have hfreqlower : s * |r - r'| / 4 ≤ |freq| := by
    rw [hfreqscale, abs_mul, abs_of_pos hspos]
    calc
      s * |r - r'| / 4 = s * (|r - r'| / 4) := by ring
      _ ≤ s * |coordinateTripleWavePhase p q t ‖x‖ r r'| :=
        mul_le_mul_of_nonneg_left horig hspos.le
  have hfreqpos : 0 < |freq| := by
    have : 0 < s * |r - r'| / 4 := by positivity
    exact lt_of_lt_of_le this hfreqlower
  have hinv : 1 / |freq| ≤ 4 / (s * |r - r'|) := by
    calc
      1 / |freq| ≤ 1 / (s * |r - r'| / 4) :=
        div_le_div_of_nonneg_left zero_le_one (by positivity) hfreqlower
      _ = 4 / (s * |r - r'|) := by
        field_simp [hspos.ne', hgap.ne']
        ring
  have hM : 0 ≤ C / s := div_nonneg hC.le hspos.le
  have hbound : ∀ u ∈ Icc (1 / 2 : Real) 8,
      ‖iteratedDeriv 2 (planarCoordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        (s * r) (s * r') v y p q t) u‖ ≤ C / s := by
    intro u hu
    exact hCbound 2 le_rfl s r r' u hs hr hr' v y hv hu
  have hIBP := norm_intervalIntegral_planarCoordinateTripleWaveCoefficient_le_iterated
    2 phi hphiOne hphiZero (s * r) (s * r') v y hv p q t freq
    (C / s) (ne_of_gt hfreqpos) hM hbound
  change ‖∫ u in (1 : Real)..4,
      planarCoordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        (s * r) (s * r') v y p q t u * oscillatoryExp freq u‖ ≤ _
  calc
    ‖∫ u in (1 : Real)..4,
        planarCoordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v y p q t u * oscillatoryExp freq u‖ ≤
        (1 / |freq|) ^ 2 * ((8 - (1 / 2 : Real)) * (C / s)) := hIBP
    _ ≤ (4 / (s * |r - r'|)) ^ 2 *
          ((8 - (1 / 2 : Real)) * (C / s)) := by
      apply mul_le_mul_of_nonneg_right
      · exact pow_le_pow_left₀ (by positivity) hinv _
      · positivity

/-- The same planar inner-cone calculation when the physical factor is the
middle wave.  Its phase is independent of the physical radius. -/
private theorem exists_inner_physicalMiddle_planarCoordinateTripleWaveIntegral_bound
    (phi : SchwartzMap (Euclidean 2) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiRadial : IsNormRadial phi)
    (q t : CoordinateWavePart) (hq : q ≠ .middle) (ht : t ≠ .middle) :
    ∃ C : Real, 0 < C ∧ ∀ s r r' : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) →
      r' ∈ Icc (1 / 2 : Real) (5 / 2) → r ≠ r' →
      ∀ v x : Euclidean 2, ‖v‖ = 1 → ‖x‖ ≤ |r - r'| / 4 →
      ‖∫ u in (1 : Real)..4,
        planarCoordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v (s • x) .middle q t u *
          oscillatoryExp
            (coordinateTripleWavePhase .middle q t ‖s • x‖ (s * r) (s * r')) u‖ ≤
        (4 / (s * |r - r'|)) ^ 2 *
          ((8 - (1 / 2 : Real)) * (C / s)) := by
  obtain ⟨C, hC, hCbound⟩ :=
    exists_uniform_planarCoordinateTripleWaveCoefficient_scaled 2 phi
      hphiOne hphiZero hphiRadial .middle q t
  refine ⟨C, hC, ?_⟩
  intro s r r' hs hr hr' hrr v x hv hxcone
  let y : Euclidean 2 := s • x
  let freq : Real := coordinateTripleWavePhase .middle q t ‖y‖ (s * r) (s * r')
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hgap : 0 < |r - r'| := abs_pos.mpr (sub_ne_zero.mpr hrr)
  have horig : |r - r'| / 4 ≤
      |coordinateTripleWavePhase .middle q t 0 r r'| :=
    abs_coordinateTripleWavePhase_ge_quarter_gap_of_physical_middle hq ht hr hr'
  have hmiddlephase (a b c : Real) :
      coordinateTripleWavePhase .middle q t a b c =
        coordinateTripleWavePhase .middle q t 0 b c := by
    simp [coordinateTripleWavePhase, coordinateWaveRadialPhase]
  have hfreqscale : freq =
      s * coordinateTripleWavePhase .middle q t 0 r r' := by
    dsimp [freq]
    rw [hmiddlephase]
    exact coordinateTripleWavePhase_scale s 0 r r' .middle q t
  have hfreqlower : s * |r - r'| / 4 ≤ |freq| := by
    rw [hfreqscale, abs_mul, abs_of_pos hspos]
    calc
      s * |r - r'| / 4 = s * (|r - r'| / 4) := by ring
      _ ≤ s * |coordinateTripleWavePhase .middle q t 0 r r'| :=
        mul_le_mul_of_nonneg_left horig hspos.le
  have hfreqpos : 0 < |freq| := by
    have : 0 < s * |r - r'| / 4 := by positivity
    exact lt_of_lt_of_le this hfreqlower
  have hinv : 1 / |freq| ≤ 4 / (s * |r - r'|) := by
    calc
      1 / |freq| ≤ 1 / (s * |r - r'| / 4) :=
        div_le_div_of_nonneg_left zero_le_one (by positivity) hfreqlower
      _ = 4 / (s * |r - r'|) := by
        field_simp [hspos.ne', hgap.ne']
        ring
  have hM : 0 ≤ C / s := div_nonneg hC.le hspos.le
  have hbound : ∀ u ∈ Icc (1 / 2 : Real) 8,
      ‖iteratedDeriv 2 (planarCoordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        (s * r) (s * r') v y .middle q t) u‖ ≤ C / s := by
    intro u hu
    exact hCbound 2 le_rfl s r r' u hs hr hr' v y hv hu
  have hIBP := norm_intervalIntegral_planarCoordinateTripleWaveCoefficient_le_iterated
    2 phi hphiOne hphiZero (s * r) (s * r') v y hv .middle q t freq
    (C / s) (ne_of_gt hfreqpos) hM hbound
  change ‖∫ u in (1 : Real)..4,
      planarCoordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        (s * r) (s * r') v y .middle q t u * oscillatoryExp freq u‖ ≤ _
  calc
    ‖∫ u in (1 : Real)..4,
        planarCoordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v y .middle q t u * oscillatoryExp freq u‖ ≤
        (1 / |freq|) ^ 2 * ((8 - (1 / 2 : Real)) * (C / s)) := hIBP
    _ ≤ (4 / (s * |r - r'|)) ^ 2 *
          ((8 - (1 / 2 : Real)) * (C / s)) := by
      apply mul_le_mul_of_nonneg_right
      · exact pow_le_pow_left₀ (by positivity) hinv _
      · positivity

/-- A multiplier-side planar middle wave has arbitrarily rapid normalized
dyadic decay. -/
private theorem exists_planarCoordinateWaveRadialAmplitude_middle_scaled_power
    (L : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ s r u : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) → u ∈ Icc (1 / 2 : Real) 8 →
      ‖planarCoordinateWaveRadialAmplitude .middle (s * r) u‖ ≤ C / s ^ L := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_norm_iteratedDeriv_planarCoordinateWaveRadialAmplitude_middle_decay 0 L
  refine ⟨C, hC, ?_⟩
  intro s r u hs hr hu
  obtain ⟨hfreq, hamp, hscale, hsqrt⟩ :=
    scaled_coordinate_frequency_geometry hs hr hu
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hden : s ^ L ≤ |(2 * Real.pi * (s * r)) * u| ^ L :=
    pow_le_pow_left₀ (zero_le_one.trans hs) hscale _
  calc
    ‖planarCoordinateWaveRadialAmplitude .middle (s * r) u‖ ≤
        C * |2 * Real.pi * (s * r)| ^ 0 /
          |(2 * Real.pi * (s * r)) * u| ^ L := hbound (s * r) u hfreq
    _ = C / |(2 * Real.pi * (s * r)) * u| ^ L := by simp
    _ ≤ C / s ^ L :=
      div_le_div_of_nonneg_left hC.le (pow_pos hspos _) hden

/-- One multiplier-side middle factor supplies an additional prescribed
dyadic power beyond the pair's `s⁻¹ᐟ²` stationary scale. -/
private theorem exists_planarCoordinateWaveMultiplierPairAmplitude_oneMiddle_scaled
    (L : Nat) (q t : CoordinateWavePart)
    (hmiddle : q = .middle ∨ t = .middle) :
    ∃ C : Real, 0 < C ∧ ∀ s r r' u : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) →
      r' ∈ Icc (1 / 2 : Real) (5 / 2) → u ∈ Icc (1 / 2 : Real) 8 →
      ‖planarCoordinateWaveMultiplierPairAmplitude q t (s * r) (s * r') u‖ ≤
        C / (s ^ L * Real.sqrt s) := by
  rcases hmiddle with hq | ht
  · subst q
    obtain ⟨A, hA, hAbound⟩ :=
      exists_planarCoordinateWaveRadialAmplitude_middle_scaled_power L
    obtain ⟨B, hB, hBbound⟩ :=
      exists_norm_iteratedDeriv_planarCoordinateWave_scaled 0 t
    refine ⟨A * B, mul_pos hA hB, ?_⟩
    intro s r r' u hs hr hr' hu
    have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
    have hqbound := hAbound s r u hs hr hu
    have htbound := hBbound s r' u hs hr' hu
    have hQpos : 0 < Real.sqrt s := Real.sqrt_pos.2 hspos
    unfold planarCoordinateWaveMultiplierPairAmplitude
    rw [norm_mul, norm_star]
    calc
      ‖planarCoordinateWaveRadialAmplitude .middle (s * r) u‖ *
          ‖planarCoordinateWaveRadialAmplitude t (s * r') u‖ ≤
          (A / s ^ L) * (B / Real.sqrt s) := by
        exact mul_le_mul hqbound htbound (norm_nonneg _)
          (div_nonneg hA.le (pow_nonneg hspos.le _))
      _ = (A * B) / (s ^ L * Real.sqrt s) := by
        field_simp [hspos.ne', hQpos.ne']
        ring
  · subst t
    obtain ⟨A, hA, hAbound⟩ :=
      exists_planarCoordinateWaveRadialAmplitude_middle_scaled_power L
    obtain ⟨B, hB, hBbound⟩ :=
      exists_norm_iteratedDeriv_planarCoordinateWave_scaled 0 q
    refine ⟨B * A, mul_pos hB hA, ?_⟩
    intro s r r' u hs hr hr' hu
    have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
    have hqbound := hBbound s r u hs hr hu
    have htbound := hAbound s r' u hs hr' hu
    have hQpos : 0 < Real.sqrt s := Real.sqrt_pos.2 hspos
    unfold planarCoordinateWaveMultiplierPairAmplitude
    rw [norm_mul, norm_star]
    calc
      ‖planarCoordinateWaveRadialAmplitude q (s * r) u‖ *
          ‖planarCoordinateWaveRadialAmplitude .middle (s * r') u‖ ≤
          (B / Real.sqrt s) * (A / s ^ L) := by
        exact mul_le_mul hqbound htbound (norm_nonneg _)
          (div_nonneg hB.le (Real.sqrt_nonneg _))
      _ = (B * A) / (s ^ L * Real.sqrt s) := by
        field_simp [hspos.ne', hQpos.ne']
        ring

/-- A planar triple with a multiplier-side middle wave is controlled
absolutely.  We deliberately retain the literal coefficient and its two
cutoff factors rather than replacing it by an abstract symbol. -/
private theorem exists_oneMiddle_planarCoordinateTripleWaveIntegral_bound
    (L : Nat) (phi : SchwartzMap (Euclidean 2) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiRadial : IsNormRadial phi)
    (p q t : CoordinateWavePart) (hmiddle : q = .middle ∨ t = .middle) :
    ∃ C : Real, 0 < C ∧ ∀ s r r' : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) →
      r' ∈ Icc (1 / 2 : Real) (5 / 2) →
      ∀ v x : Euclidean 2, ‖v‖ = 1 →
      ‖∫ u in (1 : Real)..4,
        planarCoordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v x p q t u *
          oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ (s * r) (s * r')) u‖ ≤
        C / (s ^ L * Real.sqrt s) := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_planarCoordinateTripleWaveFixedAmplitude_bound 0 phi
      hphiOne hphiZero hphiRadial p
  obtain ⟨B, hB, hBbound⟩ :=
    exists_planarCoordinateWaveMultiplierPairAmplitude_oneMiddle_scaled L q t hmiddle
  refine ⟨3 * A * B, mul_pos (mul_pos (by norm_num) hA) hB, ?_⟩
  intro s r r' hs hr hr' v x hv
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hdenpos : 0 < s ^ L * Real.sqrt s := by positivity
  have hpoint : ∀ u ∈ Icc (1 : Real) 4,
      ‖planarCoordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        (s * r) (s * r') v x p q t u *
        oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ (s * r) (s * r')) u‖ ≤
        (A * B) / (s ^ L * Real.sqrt s) := by
    intro u hu
    have huwide : u ∈ Icc (1 / 2 : Real) 8 := by
      constructor <;> linarith [hu.1, hu.2]
    have hfixed := hAbound v x hv 0 le_rfl u huwide
    have hpair := hBbound s r r' u hs hr hr' huwide
    have hfactor := planarCoordinateTripleWaveCoefficient_eq_fixed_mul_pair
      phi hphiOne hphiZero (s * r) (s * r') v x p q t u
    rw [hfactor, norm_mul, norm_oscillatoryExp, mul_one]
    calc
      ‖planarCoordinateTripleWaveFixedAmplitude phi v x p u‖ *
          ‖planarCoordinateWaveMultiplierPairAmplitude q t (s * r) (s * r') u‖ ≤
          A * (B / (s ^ L * Real.sqrt s)) := by
        exact mul_le_mul hfixed hpair (norm_nonneg _) hA.le
      _ = (A * B) / (s ^ L * Real.sqrt s) := by
        field_simp [hdenpos.ne']
        ring
  calc
    ‖∫ u in (1 : Real)..4,
        planarCoordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v x p q t u *
          oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ (s * r) (s * r')) u‖ ≤
        ((A * B) / (s ^ L * Real.sqrt s)) * |4 - (1 : Real)| := by
      apply intervalIntegral.norm_integral_le_of_norm_le_const
      intro u hu
      have hu' : u ∈ Icc (1 : Real) 4 := by
        rw [uIoc_of_le (by norm_num : (1 : Real) ≤ 4)] at hu
        exact ⟨hu.1.le, hu.2⟩
      exact hpoint u hu'
    _ = (3 * A * B) / (s ^ L * Real.sqrt s) := by
      norm_num
      ring

/-- The literal planar diagonal estimate: the two multiplier waves provide
the `s⁻¹` stationary size without using oscillation. -/
private theorem exists_planarCoordinateTripleWaveIntegral_crude_bound
    (phi : SchwartzMap (Euclidean 2) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiRadial : IsNormRadial phi)
    (p q t : CoordinateWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ s r r' : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) →
      r' ∈ Icc (1 / 2 : Real) (5 / 2) →
      ∀ v x : Euclidean 2, ‖v‖ = 1 →
      ‖∫ u in (1 : Real)..4,
        planarCoordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v x p q t u *
          oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ (s * r) (s * r')) u‖ ≤
        C / s := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_planarCoordinateTripleWaveFixedAmplitude_bound 0 phi
      hphiOne hphiZero hphiRadial p
  obtain ⟨B, hB, hBbound⟩ :=
    exists_uniform_planarCoordinateWaveMultiplierPair_scaled 0 q t
  refine ⟨3 * A * B, mul_pos (mul_pos (by norm_num) hA) hB, ?_⟩
  intro s r r' hs hr hr' v x hv
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hpoint : ∀ u ∈ Icc (1 : Real) 4,
      ‖planarCoordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        (s * r) (s * r') v x p q t u *
        oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ (s * r) (s * r')) u‖ ≤
        (A * B) / s := by
    intro u hu
    have huwide : u ∈ Icc (1 / 2 : Real) 8 := by
      constructor <;> linarith [hu.1, hu.2]
    have hfixed := hAbound v x hv 0 le_rfl u huwide
    have hpair := hBbound 0 le_rfl s r r' u hs hr hr' huwide
    have hfactor := planarCoordinateTripleWaveCoefficient_eq_fixed_mul_pair
      phi hphiOne hphiZero (s * r) (s * r') v x p q t u
    rw [hfactor, norm_mul, norm_oscillatoryExp, mul_one]
    calc
      ‖planarCoordinateTripleWaveFixedAmplitude phi v x p u‖ *
          ‖planarCoordinateWaveMultiplierPairAmplitude q t (s * r) (s * r') u‖ ≤
          A * (B / s) := by
        exact mul_le_mul hfixed hpair (norm_nonneg _) hA.le
      _ = (A * B) / s := by
        field_simp [hspos.ne']
        ring
  calc
    ‖∫ u in (1 : Real)..4,
        planarCoordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v x p q t u *
          oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ (s * r) (s * r')) u‖ ≤
        ((A * B) / s) * |4 - (1 : Real)| := by
      apply intervalIntegral.norm_integral_le_of_norm_le_const
      intro u hu
      have hu' : u ∈ Icc (1 : Real) 4 := by
        rw [uIoc_of_le (by norm_num : (1 : Real) ≤ 4)] at hu
        exact ⟨hu.1.le, hu.2⟩
      exact hpoint u hu'
    _ = (3 * A * B) / s := by
      norm_num
      ring

/-- Physical planar waves have their literal half-order stationary decay
away from the origin. -/
private theorem exists_planarCoordinateWaveRadialAmplitude_physical_decay
    (p : CoordinateWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ a u : Real, 1 ≤ a → u ∈ Icc (1 / 2 : Real) 8 →
      ‖planarCoordinateWaveRadialAmplitude p a u‖ ≤ C / Real.sqrt a := by
  obtain ⟨C, hC, hbound⟩ := exists_norm_iteratedDeriv_planarCoordinateWave_scaled 0 p
  refine ⟨C, hC, ?_⟩
  intro a u ha hu
  simpa using hbound a 1 u ha (by constructor <;> norm_num) hu

/-- In the outer cone, the physical planar wave supplies the gap factor
directly; no integration by parts is used in this branch. -/
private theorem exists_outer_planarCoordinateTripleWaveIntegral_bound
    (phi : SchwartzMap (Euclidean 2) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiRadial : IsNormRadial phi)
    (p q t : CoordinateWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ s r r' : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) →
      r' ∈ Icc (1 / 2 : Real) (5 / 2) →
      ∀ v x : Euclidean 2, ‖v‖ = 1 → 1 ≤ ‖x‖ →
      ‖∫ u in (1 : Real)..4,
        planarCoordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v x p q t u *
          oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ (s * r) (s * r')) u‖ ≤
        C / (s * Real.sqrt ‖x‖) := by
  let density : Real → Complex := fun u : Real => (u : Complex)
  have hdensity : ContDiff Real (⊤ : ℕ∞) density := by
    dsimp [density]
    fun_prop
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_iteratedDeriv_bound_on_fixedAnnulus density hdensity 0
  obtain ⟨D, hD, hDbound⟩ :=
    exists_uniform_normalizedDyadicCutoffSquare_bound_on_unit (N := 0)
      (by norm_num : 1 ≤ 2) phi hphiOne hphiZero hphiRadial
  obtain ⟨P, hP, hPbound⟩ :=
    exists_planarCoordinateWaveRadialAmplitude_physical_decay p
  obtain ⟨B, hB, hBbound⟩ :=
    exists_uniform_planarCoordinateWaveMultiplierPair_scaled 0 q t
  refine ⟨3 * A * P * D * B,
    mul_pos (mul_pos (mul_pos (mul_pos (by norm_num) hA) hP) hD) hB, ?_⟩
  intro s r r' hs hr hr' v x hv hx
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hxpos : 0 < ‖x‖ := lt_of_lt_of_le zero_lt_one hx
  have hsqrtpos : 0 < Real.sqrt ‖x‖ := Real.sqrt_pos.2 hxpos
  have hpoint : ∀ u ∈ Icc (1 : Real) 4,
      ‖planarCoordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        (s * r) (s * r') v x p q t u *
        oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ (s * r) (s * r')) u‖ ≤
        (A * P * D * B) / (s * Real.sqrt ‖x‖) := by
    intro u hu
    have huwide : u ∈ Icc (1 / 2 : Real) 8 := by
      constructor <;> linarith [hu.1, hu.2]
    have hden := hAbound 0 le_rfl u huwide
    have hcut := hDbound v hv 0 le_rfl u huwide
    have hphysical := hPbound ‖x‖ u hx huwide
    have hpair := hBbound 0 le_rfl s r r' u hs hr hr' huwide
    have hfactor := planarCoordinateTripleWaveCoefficient_eq_fixed_mul_pair
      phi hphiOne hphiZero (s * r) (s * r') v x p q t u
    rw [hfactor, norm_mul, norm_oscillatoryExp, mul_one]
    unfold planarCoordinateTripleWaveFixedAmplitude
    rw [norm_mul, norm_mul, norm_mul]
    calc
      ‖density u‖ * ‖planarCoordinateWaveRadialAmplitude p ‖x‖ u‖ *
          ‖normalizedDyadicCutoffSquare phi v u‖ *
            ‖planarCoordinateWaveMultiplierPairAmplitude q t (s * r) (s * r') u‖ ≤
          A * (P / Real.sqrt ‖x‖) * D * (B / s) := by
        gcongr
      _ = (A * P * D * B) / (s * Real.sqrt ‖x‖) := by
        field_simp [hspos.ne', hsqrtpos.ne']
        ring
  calc
    ‖∫ u in (1 : Real)..4,
        planarCoordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v x p q t u *
          oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ (s * r) (s * r')) u‖ ≤
        ((A * P * D * B) / (s * Real.sqrt ‖x‖)) * |4 - (1 : Real)| := by
      apply intervalIntegral.norm_integral_le_of_norm_le_const
      intro u hu
      have hu' : u ∈ Icc (1 : Real) 4 := by
        rw [uIoc_of_le (by norm_num : (1 : Real) ≤ 4)] at hu
        exact ⟨hu.1.le, hu.2⟩
      exact hpoint u hu'
    _ = (3 * A * P * D * B) / (s * Real.sqrt ‖x‖) := by
      norm_num
      ring

/-! ## The planar conic gap split -/

private theorem planar_q4_crude_scale_le_stationaryWeight
    {C s T : Real} (hs : 1 ≤ s) (hC : 0 ≤ C) (hT : 0 ≤ T)
    (hsmall : T ≤ 4) :
    C / s ≤ (C * (5 : Real) ^ 2) / s *
      (1 + T) ^ (-q4StationaryExponent 2) := by
  simpa using q4_crude_scale_le_stationaryWeight (d := 2)
    (by norm_num : 1 ≤ 2) hs hC hT hsmall

private theorem planar_q4_inner_ibp_scale_le_stationaryWeight
    {C s T : Real} (hs : 1 ≤ s) (hC : 0 ≤ C) (hT : 1 ≤ T) :
    (4 / T) ^ 2 * ((8 - (1 / 2 : Real)) * (C / s)) ≤
      ((8 - (1 / 2 : Real)) * C * (8 : Real) ^ 2) / s *
        (1 + T) ^ (-q4StationaryExponent 2) := by
  simpa using q4_inner_ibp_scale_le_stationaryWeight (d := 2)
    (by norm_num : 1 ≤ 2) hs hC hT

private theorem planar_q4_outer_scale_le_stationaryWeight
    {C s T X : Real} (hs : 1 ≤ s) (hC : 0 ≤ C) (hT : 1 ≤ T)
    (hX : T / 4 ≤ X) :
    C / (s * Real.sqrt X) ≤ (C * (8 : Real) ^ 2) / s *
      (1 + T) ^ (-q4StationaryExponent 2) := by
  simpa using q4_outer_scale_le_stationaryWeight (d := 2)
    (by norm_num : 1 ≤ 2) hs hC hT hX

private theorem planar_q4_middle_scale_le_stationaryWeight
    {C s T : Real} (hs : 1 ≤ s) (hC : 0 ≤ C) (hT : 0 ≤ T)
    (hTscale : T ≤ 2 * s) :
    C / (s ^ 4 * Real.sqrt s) ≤ (C * (3 : Real) ^ 2) / s *
      (1 + T) ^ (-q4StationaryExponent 2) := by
  simpa using q4_middle_scale_le_stationaryWeight (d := 2)
    (by norm_num : 1 ≤ 2) hs hC hT hTscale

private theorem planar_q4_scaleWeight_mono
    {A B s T : Real} (hs : 1 ≤ s) (hT : 0 ≤ T) (hAB : A ≤ B) :
    A / s * (1 + T) ^ (-q4StationaryExponent 2) ≤
      B / s * (1 + T) ^ (-q4StationaryExponent 2) := by
  simpa using q4_scaleWeight_mono (d := 2) hs hT hAB

/-- Every literal planar coordinate triple obeys the stationary radius-gap
estimate.  This is the paper's cone split specialized to the actual circle
normal form: small gaps are diagonal, outer points use physical stationary
decay, inner endpoint triples are integrated by parts, and middle factors
are made rapidly decreasing before the finite summation. -/
theorem exists_planarCoordinateTripleWaveIntegral_stationaryGap_bound
    (phi : SchwartzMap (Euclidean 2) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiRadial : IsNormRadial phi)
    (p q t : CoordinateWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ s r r' : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) →
      r' ∈ Icc (1 / 2 : Real) (5 / 2) →
      ∀ v x : Euclidean 2, ‖v‖ = 1 →
      ‖∫ u in (1 : Real)..4,
        planarCoordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v (s • x) p q t u *
          oscillatoryExp
            (coordinateTripleWavePhase p q t ‖s • x‖ (s * r) (s * r')) u‖ ≤
        C / s * (1 + s * |r - r'|) ^ (-q4StationaryExponent 2) := by
  obtain ⟨Csmall, hCsmall, hsmall⟩ :=
    exists_planarCoordinateTripleWaveIntegral_crude_bound
      phi hphiOne hphiZero hphiRadial p q t
  obtain ⟨Couter, hCouter, houter⟩ :=
    exists_outer_planarCoordinateTripleWaveIntegral_bound
      phi hphiOne hphiZero hphiRadial p q t
  by_cases hmiddle : q = .middle ∨ t = .middle
  · obtain ⟨Cmiddle, hCmiddle, hmiddleBound⟩ :=
      exists_oneMiddle_planarCoordinateTripleWaveIntegral_bound 4
        phi hphiOne hphiZero hphiRadial p q t hmiddle
    let C : Real := Csmall * (5 : Real) ^ 2 + Couter * (8 : Real) ^ 2 +
      Cmiddle * (3 : Real) ^ 2
    have hCnonneg : 0 ≤ C := by
      dsimp [C]
      positivity
    refine ⟨C + 1, by linarith, ?_⟩
    intro s r r' hs hr hr' v x hv
    let g : Real := |r - r'|
    let T : Real := s * g
    let y : Euclidean 2 := s • x
    have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
    have hg : 0 ≤ g := abs_nonneg _
    have hgupper : g ≤ 2 := by
      dsimp [g]
      apply (abs_le).2
      constructor <;> linarith [hr.1, hr.2, hr'.1, hr'.2]
    have hT : 0 ≤ T := by dsimp [T]; positivity
    have hTscale : T ≤ 2 * s := by
      dsimp [T]
      calc
        s * g ≤ s * 2 := mul_le_mul_of_nonneg_left hgupper hs.le
        _ = 2 * s := by ring
    have hyNorm : ‖y‖ = s * ‖x‖ := by
      dsimp [y]
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hspos]
    by_cases hsmallGap : T ≤ 4
    · have hcrude := hsmall s r r' hs hr hr' v y hv
      have hnum := planar_q4_crude_scale_le_stationaryWeight
        hs hCsmall.le hT hsmallGap
      calc
        ‖∫ u in (1 : Real)..4,
            planarCoordinateTripleWaveCoefficient
              (absoluteDyadicBandpass phi hphiOne hphiZero 0)
              (s * r) (s * r') v y p q t u *
              oscillatoryExp
                (coordinateTripleWavePhase p q t ‖y‖ (s * r) (s * r')) u‖ ≤
            Csmall / s := hcrude
        _ ≤ (Csmall * (5 : Real) ^ 2) / s *
            (1 + T) ^ (-q4StationaryExponent 2) := hnum
        _ ≤ (C + 1) / s *
            (1 + T) ^ (-q4StationaryExponent 2) := by
          apply planar_q4_scaleWeight_mono hs hT
          dsimp [C]
          positivity
    · have hlarge : 4 < T := lt_of_not_ge hsmallGap
      have hTone : 1 ≤ T := by linarith
      by_cases hphysical : g / 4 ≤ ‖x‖
      · have hyOuter : T / 4 ≤ ‖y‖ := by
          rw [hyNorm]
          dsimp [T]
          calc
            s * g / 4 = s * (g / 4) := by ring
            _ ≤ s * ‖x‖ := mul_le_mul_of_nonneg_left hphysical hs.le
        have hyOne : 1 ≤ ‖y‖ := by
          calc
            (1 : Real) ≤ T / 4 := by linarith
            _ ≤ ‖y‖ := hyOuter
        have hphysicalBound := houter s r r' hs hr hr' v y hv hyOne
        have hnum := planar_q4_outer_scale_le_stationaryWeight
          hs hCouter.le hTone hyOuter
        calc
          ‖∫ u in (1 : Real)..4,
              planarCoordinateTripleWaveCoefficient
                (absoluteDyadicBandpass phi hphiOne hphiZero 0)
                (s * r) (s * r') v y p q t u *
                oscillatoryExp
                  (coordinateTripleWavePhase p q t ‖y‖ (s * r) (s * r')) u‖ ≤
              Couter / (s * Real.sqrt ‖y‖) := hphysicalBound
          _ ≤ (Couter * (8 : Real) ^ 2) / s *
              (1 + T) ^ (-q4StationaryExponent 2) := hnum
          _ ≤ (C + 1) / s *
              (1 + T) ^ (-q4StationaryExponent 2) := by
            apply planar_q4_scaleWeight_mono hs hT
            dsimp [C]
            positivity

/-
/-- The finite planar coordinate summands are interval integrable on the
fixed annulus, allowing the literal 27-term triangle inequality. -/
private theorem intervalIntegrable_planarCoordinateTripleWaveTerm
    (phi : SchwartzMap (Euclidean 2) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (r r' : Real) (v x : Euclidean 2)
    (p q t : CoordinateWavePart) :
    IntervalIntegrable (fun u : Real =>
      planarCoordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        r r' v x p q t u *
        oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ r r') u)
      volume (1 : Real) 4 := by
  have hcoefficient : Continuous (fun u : Real =>
      planarCoordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        r r' v x p q t u) :=
    (contDiff_planarCoordinateTripleWaveCoefficient
      (absoluteDyadicBandpass phi hphiOne hphiZero 0) r r' v x p q t).continuous
  have hphase : Continuous
      (oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ r r')) := by
    unfold oscillatoryExp
    exact Complex.continuous_exp.comp
      ((Complex.continuous_ofReal.comp (continuous_const.mul continuous_id)).mul
        continuous_const)
  exact (hcoefficient.mul hphase).intervalIntegrable _ _

/-- The actual planar 27-term normal form gives the literal `Q4` pair
kernel gap estimate for the absolute dyadic bandpass.  This is the physical
circle branch used by the main theorem, not an abstract kernel hypothesis. -/
theorem exists_hasQ4DyadicPairKernelGapDecayOn_absoluteDyadicBandpass_two
    (phi : SchwartzMap (Euclidean 2) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiNorm : ∀ xi, ‖phi xi‖ ≤ 1)
    (hphiRadial : IsNormRadial phi) :
    ∃ C : Real, 0 < C ∧
      HasQ4DyadicPairKernelGapDecayOn 2
        (fun j => absoluteDyadicBandpass phi hphiOne hphiZero j)
        (1 / 2 : Real) (5 / 2) C := by
  have hterm : ∀ p q t : CoordinateWavePart, ∃ C : Real, 0 < C ∧
      ∀ s r r' : Real, 1 ≤ s →
        r ∈ Icc (1 / 2 : Real) (5 / 2) →
        r' ∈ Icc (1 / 2 : Real) (5 / 2) →
        ∀ v x : Euclidean 2, ‖v‖ = 1 →
        ‖∫ u in (1 : Real)..4,
          planarCoordinateTripleWaveCoefficient
            (absoluteDyadicBandpass phi hphiOne hphiZero 0)
            (s * r) (s * r') v (s • x) p q t u *
            oscillatoryExp
              (coordinateTripleWavePhase p q t ‖s • x‖ (s * r) (s * r')) u‖ ≤
          C / s * (1 + s * |r - r'|) ^ (-q4StationaryExponent 2) := by
    intro p q t
    exact exists_planarCoordinateTripleWaveIntegral_stationaryGap_bound
      phi hphiOne hphiZero hphiRadial p q t
  choose C hCpos hCbound using hterm
  let parts3 : Finset (CoordinateWavePart × (CoordinateWavePart × CoordinateWavePart)) :=
    coordinateWaveParts.product (coordinateWaveParts.product coordinateWaveParts)
  let K : Real := ∑ z in parts3, C z.1 z.2.1 z.2.2
  let z0 : CoordinateWavePart × (CoordinateWavePart × CoordinateWavePart) :=
    (.outgoing, (.outgoing, .outgoing))
  have hz0 : z0 ∈ parts3 := by
    dsimp [parts3, z0]
    simp [coordinateWaveParts]
  have hKpos : 0 < K := by
    have hle : C z0.1 z0.2.1 z0.2.2 ≤ K := by
      dsimp [K]
      exact Finset.single_le_sum
        (fun z hz => (hCpos z.1 z.2.1 z.2.2).le) hz0
    exact lt_of_lt_of_le (hCpos z0.1 z0.2.1 z0.2.2) hle
  refine ⟨K, hKpos, ?_⟩
  intro j r r' x hr hr'
  let s : Real := (2 : Real) ^ j
  have hspos : 0 < s := by
    dsimp [s]
    positivity
  have hs : 1 ≤ s := by
    dsimp [s]
    exact one_le_pow₀ (by norm_num)
  have hrpos : 0 < r := lt_of_lt_of_le (by norm_num) hr.1
  have hr'pos : 0 < r' := lt_of_lt_of_le (by norm_num) hr'.1
  let i : Fin 2 := ⟨0, by omega⟩
  let v : Euclidean 2 := EuclideanSpace.single i (1 : Real)
  have hv : ‖v‖ = 1 := by
    dsimp [v]
    simpa using (EuclideanSpace.norm_single i (1 : Real))
  have hsum (u : Real) :
      ∑ p ∈ coordinateWaveParts, ∑ q ∈ coordinateWaveParts,
        ∑ t ∈ coordinateWaveParts,
          planarCoordinateTripleWaveCoefficient
            (absoluteDyadicBandpass phi hphiOne hphiZero 0)
            (s * r) (s * r') v (s • x) p q t u *
            oscillatoryExp
              (coordinateTripleWavePhase p q t ‖s • x‖ (s * r) (s * r')) u =
        ∑ z in parts3,
          planarCoordinateTripleWaveCoefficient
            (absoluteDyadicBandpass phi hphiOne hphiZero 0)
            (s * r) (s * r') v (s • x) z.1 z.2.1 z.2.2 u *
            oscillatoryExp
              (coordinateTripleWavePhase z.1 z.2.1 z.2.2 ‖s • x‖
                (s * r) (s * r')) u := by
    simp only [parts3, Finset.sum_product]
  have hintegrable (z : CoordinateWavePart × (CoordinateWavePart × CoordinateWavePart))
      (hz : z ∈ parts3) :
      IntervalIntegrable (fun u : Real =>
        planarCoordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v (s • x) z.1 z.2.1 z.2.2 u *
          oscillatoryExp
            (coordinateTripleWavePhase z.1 z.2.1 z.2.2 ‖s • x‖
              (s * r) (s * r')) u)
        volume (1 : Real) 4 :=
    intervalIntegrable_planarCoordinateTripleWaveTerm phi hphiOne hphiZero
      (s * r) (s * r') v (s • x) z.1 z.2.1 z.2.2
  have hsumBound :
      ‖∫ u in (1 : Real)..4,
        ∑ p ∈ coordinateWaveParts, ∑ q ∈ coordinateWaveParts,
          ∑ t ∈ coordinateWaveParts,
            planarCoordinateTripleWaveCoefficient
              (absoluteDyadicBandpass phi hphiOne hphiZero 0)
              (s * r) (s * r') v (s • x) p q t u *
              oscillatoryExp
                (coordinateTripleWavePhase p q t ‖s • x‖ (s * r) (s * r')) u‖ ≤
        K / s * (1 + s * |r - r'|) ^ (-q4StationaryExponent 2) := by
    rw [show (∫ u in (1 : Real)..4,
        ∑ p ∈ coordinateWaveParts, ∑ q ∈ coordinateWaveParts,
          ∑ t ∈ coordinateWaveParts,
            planarCoordinateTripleWaveCoefficient
              (absoluteDyadicBandpass phi hphiOne hphiZero 0)
              (s * r) (s * r') v (s • x) p q t u *
              oscillatoryExp
                (coordinateTripleWavePhase p q t ‖s • x‖ (s * r) (s * r')) u) =
        ∫ u in (1 : Real)..4, ∑ z in parts3,
          planarCoordinateTripleWaveCoefficient
            (absoluteDyadicBandpass phi hphiOne hphiZero 0)
            (s * r) (s * r') v (s • x) z.1 z.2.1 z.2.2 u *
            oscillatoryExp
              (coordinateTripleWavePhase z.1 z.2.1 z.2.2 ‖s • x‖
                (s * r) (s * r')) u by
      apply intervalIntegral.integral_congr
      intro u hu
      exact hsum u]
    calc
      ‖∫ u in (1 : Real)..4, ∑ z in parts3,
          planarCoordinateTripleWaveCoefficient
            (absoluteDyadicBandpass phi hphiOne hphiZero 0)
            (s * r) (s * r') v (s • x) z.1 z.2.1 z.2.2 u *
            oscillatoryExp
              (coordinateTripleWavePhase z.1 z.2.1 z.2.2 ‖s • x‖
                (s * r) (s * r')) u‖ ≤
          ∑ z in parts3,
            ‖∫ u in (1 : Real)..4,
              planarCoordinateTripleWaveCoefficient
                (absoluteDyadicBandpass phi hphiOne hphiZero 0)
                (s * r) (s * r') v (s • x) z.1 z.2.1 z.2.2 u *
                oscillatoryExp
                  (coordinateTripleWavePhase z.1 z.2.1 z.2.2 ‖s • x‖
                    (s * r) (s * r')) u‖ :=
        norm_intervalIntegral_finsetSum_le parts3 _ (fun z hz => hintegrable z hz)
      _ ≤ ∑ z in parts3,
          C z.1 z.2.1 z.2.2 / s *
            (1 + s * |r - r'|) ^ (-q4StationaryExponent 2) := by
        apply Finset.sum_le_sum
        intro z hz
        exact hCbound z.1 z.2.1 z.2.2 s r r' hs hr hr' v x hv
      _ = K / s * (1 + s * |r - r'|) ^ (-q4StationaryExponent 2) := by
        change (∑ z in parts3,
          C z.1 z.2.1 z.2.2 / s *
            (1 + s * |r - r'|) ^ (-q4StationaryExponent 2)) = _
        rw [show (∑ z in parts3,
          C z.1 z.2.1 z.2.2 / s *
            (1 + s * |r - r'|) ^ (-q4StationaryExponent 2)) =
          (∑ z in parts3, C z.1 z.2.1 z.2.2) *
            ((1 / s) * (1 + s * |r - r'|) ^ (-q4StationaryExponent 2)) by
          rw [Finset.sum_mul]
          apply Finset.sum_congr rfl
          intro z hz
          ring]
        dsimp [K]
        ring
  have hkernel :=
    q4DyadicPairKernel_absoluteDyadicBandpass_two_eq_scaled_planarCoordinateTripleWave_finsetIntegral
      phi hphiOne hphiZero hphiRadial j hrpos hr'pos v x hv
  rw [hkernel]
  have hscalenonneg : 0 ≤ s ^ 2 := pow_nonneg hspos.le _
  have hscaleWeight :
      s ^ 2 * (K / s *
        (1 + s * |r - r'|) ^ (-q4StationaryExponent 2)) =
        K * s * (1 + s * |r - r'|) ^ (-q4StationaryExponent 2) := by
    field_simp [hspos.ne']
    ring
  calc
    ‖s ^ 2 • ∫ u in (1 : Real)..4,
        ∑ p ∈ coordinateWaveParts, ∑ q ∈ coordinateWaveParts,
          ∑ t ∈ coordinateWaveParts,
            planarCoordinateTripleWaveCoefficient
              (absoluteDyadicBandpass phi hphiOne hphiZero 0)
              (s * r) (s * r') v (s • x) p q t u *
              oscillatoryExp
                (coordinateTripleWavePhase p q t ‖s • x‖ (s * r) (s * r')) u‖ =
        s ^ 2 * ‖∫ u in (1 : Real)..4,
          ∑ p ∈ coordinateWaveParts, ∑ q ∈ coordinateWaveParts,
            ∑ t ∈ coordinateWaveParts,
              planarCoordinateTripleWaveCoefficient
                (absoluteDyadicBandpass phi hphiOne hphiZero 0)
                (s * r) (s * r') v (s • x) p q t u *
                oscillatoryExp
                  (coordinateTripleWavePhase p q t ‖s • x‖ (s * r) (s * r')) u‖ := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hscalenonneg]
    _ ≤ s ^ 2 * (K / s *
        (1 + s * |r - r'|) ^ (-q4StationaryExponent 2)) :=
      mul_le_mul_of_nonneg_left hsumBound hscalenonneg
    _ = K * s * (1 + s * |r - r'|) ^ (-q4StationaryExponent 2) :=
      hscaleWeight
    _ = K * (2 : Real) ^ j * q4PairKernelGapWeight 2 j r r' := by
      have hdyadic : dyadicScale j = s⁻¹ := by
        dsimp [dyadicScale, dyadicDenom, s]
        simp
      unfold q4PairKernelGapWeight
      rw [hdyadic, div_inv]
      unfold q4StationaryExponent
-/
      · have hmiddleBound' := hmiddleBound s r r' hs hr hr' v y hv
        have hnum := planar_q4_middle_scale_le_stationaryWeight
          hs hCmiddle.le hT hTscale
        calc
          ‖∫ u in (1 : Real)..4,
              planarCoordinateTripleWaveCoefficient
                (absoluteDyadicBandpass phi hphiOne hphiZero 0)
                (s * r) (s * r') v y p q t u *
                oscillatoryExp
                  (coordinateTripleWavePhase p q t ‖y‖ (s * r) (s * r')) u‖ ≤
              Cmiddle / (s ^ 4 * Real.sqrt s) := hmiddleBound'
          _ ≤ (Cmiddle * (3 : Real) ^ 2) / s *
              (1 + T) ^ (-q4StationaryExponent 2) := hnum
          _ ≤ (C + 1) / s *
              (1 + T) ^ (-q4StationaryExponent 2) := by
            apply planar_q4_scaleWeight_mono hs hT
            dsimp [C]
            positivity
  · have hq : q ≠ .middle := by
      intro hq
      exact hmiddle (Or.inl hq)
    have ht : t ≠ .middle := by
      intro ht
      exact hmiddle (Or.inr ht)
    obtain ⟨Cinner, hCinner, hinnerBound⟩ :
        ∃ C : Real, 0 < C ∧ ∀ s r r' : Real, 1 ≤ s →
          r ∈ Icc (1 / 2 : Real) (5 / 2) →
          r' ∈ Icc (1 / 2 : Real) (5 / 2) → r ≠ r' →
          ∀ v x : Euclidean 2, ‖v‖ = 1 → ‖x‖ ≤ |r - r'| / 4 →
          ‖∫ u in (1 : Real)..4,
            planarCoordinateTripleWaveCoefficient
              (absoluteDyadicBandpass phi hphiOne hphiZero 0)
              (s * r) (s * r') v (s • x) p q t u *
              oscillatoryExp
                (coordinateTripleWavePhase p q t ‖s • x‖ (s * r) (s * r')) u‖ ≤
            (4 / (s * |r - r'|)) ^ 2 *
              ((8 - (1 / 2 : Real)) * (C / s)) := by
      by_cases hp : p = .middle
      · subst p
        exact exists_inner_physicalMiddle_planarCoordinateTripleWaveIntegral_bound
          phi hphiOne hphiZero hphiRadial q t hq ht
      · exact exists_inner_endpoint_planarCoordinateTripleWaveIntegral_bound
          phi hphiOne hphiZero hphiRadial p q t hp hq ht
    let C : Real := Csmall * (5 : Real) ^ 2 + Couter * (8 : Real) ^ 2 +
      ((8 - (1 / 2 : Real)) * Cinner * (8 : Real) ^ 2)
    have hCnonneg : 0 ≤ C := by
      dsimp [C]
      positivity
    refine ⟨C + 1, by linarith, ?_⟩
    intro s r r' hs hr hr' v x hv
    let g : Real := |r - r'|
    let T : Real := s * g
    let y : Euclidean 2 := s • x
    have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
    have hg : 0 ≤ g := abs_nonneg _
    have hT : 0 ≤ T := by dsimp [T]; positivity
    have hyNorm : ‖y‖ = s * ‖x‖ := by
      dsimp [y]
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hspos]
    by_cases hsmallGap : T ≤ 4
    · have hcrude := hsmall s r r' hs hr hr' v y hv
      have hnum := planar_q4_crude_scale_le_stationaryWeight
        hs hCsmall.le hT hsmallGap
      calc
        ‖∫ u in (1 : Real)..4,
            planarCoordinateTripleWaveCoefficient
              (absoluteDyadicBandpass phi hphiOne hphiZero 0)
              (s * r) (s * r') v y p q t u *
              oscillatoryExp
                (coordinateTripleWavePhase p q t ‖y‖ (s * r) (s * r')) u‖ ≤
            Csmall / s := hcrude
        _ ≤ (Csmall * (5 : Real) ^ 2) / s *
            (1 + T) ^ (-q4StationaryExponent 2) := hnum
        _ ≤ (C + 1) / s *
            (1 + T) ^ (-q4StationaryExponent 2) := by
          apply planar_q4_scaleWeight_mono hs hT
          dsimp [C]
          positivity
    · have hlarge : 4 < T := lt_of_not_ge hsmallGap
      have hTone : 1 ≤ T := by linarith
      by_cases hphysical : g / 4 ≤ ‖x‖
      · have hyOuter : T / 4 ≤ ‖y‖ := by
          rw [hyNorm]
          dsimp [T]
          calc
            s * g / 4 = s * (g / 4) := by ring
            _ ≤ s * ‖x‖ := mul_le_mul_of_nonneg_left hphysical hs.le
        have hyOne : 1 ≤ ‖y‖ := by
          calc
            (1 : Real) ≤ T / 4 := by linarith
            _ ≤ ‖y‖ := hyOuter
        have hphysicalBound := houter s r r' hs hr hr' v y hv hyOne
        have hnum := planar_q4_outer_scale_le_stationaryWeight
          hs hCouter.le hTone hyOuter
        calc
          ‖∫ u in (1 : Real)..4,
              planarCoordinateTripleWaveCoefficient
                (absoluteDyadicBandpass phi hphiOne hphiZero 0)
                (s * r) (s * r') v y p q t u *
                oscillatoryExp
                  (coordinateTripleWavePhase p q t ‖y‖ (s * r) (s * r')) u‖ ≤
              Couter / (s * Real.sqrt ‖y‖) := hphysicalBound
          _ ≤ (Couter * (8 : Real) ^ 2) / s *
              (1 + T) ^ (-q4StationaryExponent 2) := hnum
          _ ≤ (C + 1) / s *
              (1 + T) ^ (-q4StationaryExponent 2) := by
            apply planar_q4_scaleWeight_mono hs hT
            dsimp [C]
            positivity
      · have hinner : ‖x‖ ≤ g / 4 := le_of_lt (lt_of_not_ge hphysical)
        have hIBP := hinnerBound s r r' hs hr hr'
          (by
            intro hrr
            have hzero : g = 0 := by
              dsimp [g]
              exact abs_eq_zero.mpr (sub_eq_zero.mpr hrr)
            dsimp [T] at hlarge
            rw [hzero, mul_zero] at hlarge
            linarith)
          v x hv hinner
        have hnum := planar_q4_inner_ibp_scale_le_stationaryWeight
          hs hCinner.le hTone
        calc
          ‖∫ u in (1 : Real)..4,
              planarCoordinateTripleWaveCoefficient
                (absoluteDyadicBandpass phi hphiOne hphiZero 0)
                (s * r) (s * r') v y p q t u *
                oscillatoryExp
                  (coordinateTripleWavePhase p q t ‖y‖ (s * r) (s * r')) u‖ ≤
              (4 / (s * g)) ^ 2 *
                ((8 - (1 / 2 : Real)) * (Cinner / s)) := by
              simpa only [y, T, g] using hIBP
          _ ≤ ((8 - (1 / 2 : Real)) * Cinner * (8 : Real) ^ 2) / s *
              (1 + T) ^ (-q4StationaryExponent 2) := by
              simpa only [T] using hnum
          _ ≤ (C + 1) / s *
              (1 + T) ^ (-q4StationaryExponent 2) := by
            apply planar_q4_scaleWeight_mono hs hT
            dsimp [C]
            positivity

end

