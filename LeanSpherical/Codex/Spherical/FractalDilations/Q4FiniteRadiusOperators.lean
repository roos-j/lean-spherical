    SchwartzMap.fourierMultiplierCLM Complex n f)
  funext xi
  simp only [Pi.mul_apply]
  rw [q4DyadicSurfaceSchwartzMultiplier_spec,
    q4DyadicSurfaceSchwartzAdjointMultiplier_spec,
    q4ActiveDyadicPairMultiplier_spec]
