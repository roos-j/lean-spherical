  refine ⟨hcompact.toSchwartzMap hsmooth, ?_, ?_⟩
  · change HasCompactSupport g
    exact hcompact
  · intro xi
    change starRingEnd Complex (m xi) =
      starRingEnd Complex (q4DyadicSurfaceMultiplier psi r xi)
