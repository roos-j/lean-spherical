  | outgoing =>
      refine ⟨-1, Or.inr rfl, ?_⟩
      simp [coordinateWaveRadialPhase]
      ring
  | incoming =>
      refine ⟨1, Or.inl rfl, ?_⟩
      simp [coordinateWaveRadialPhase]
      ring
  | middle => exact False.elim (hp rfl)

