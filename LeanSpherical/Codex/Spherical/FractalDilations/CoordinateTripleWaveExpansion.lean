/-- The combined linear radial frequency of one triple of coordinate waves.
The third sign is reversed because the second multiplier is adjointed in the
literal `A_j A_j^*` pair. -/
def coordinateTripleWavePhase
    (p q t : CoordinateWavePart) (u r r' : Real) : Real :=
  coordinateWaveRadialPhase p u + coordinateWaveRadialPhase q r -
    coordinateWaveRadialPhase t r'

/-- For a genuine endpoint piece, the extracted phase has sign `+1` or
`-1` after the common factor `2*pi` has been removed. -/
theorem exists_coordinateWaveRadialPhase_sign
    (p : CoordinateWavePart) (hp : p ≠ .middle) (a : Real) :
    ∃ e : Real, (e = 1 ∨ e = -1) ∧
      coordinateWaveRadialPhase p a = (2 * Real.pi) * (e * a) := by
