    (M : ENNReal) (hMtop : M < ⊤)
    (hmoment : (∫⁻ x, ENNReal.ofReal ((T f x) ^ q) ∂nu) ≤ M) :
    MemLp (T f) (ENNReal.ofReal q) nu ∧
      eLpNorm (T f) (ENNReal.ofReal q) nu ≤ M ^ q⁻¹ := by
  constructor
  · exact memLp_of_lintegral_ofReal_rpow_lt_top (T f) hTf hTnonneg hq
      (lt_of_le_of_lt hmoment hMtop)
  · exact eLpNorm_le_of_nonnegative_moment T f hq hTnonneg M hmoment

end

end Codex.Spherical.FractalDilations.SourceOutputMarcinkiewicz
