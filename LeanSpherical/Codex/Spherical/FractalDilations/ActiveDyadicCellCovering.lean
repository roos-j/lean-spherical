noncomputable section

/-- The active grid-cell indices whose left endpoints lie in a given radius
gap shell about the left endpoint of cell `k`. -/
noncomputable def activeDyadicRadiusGapNeighbors
    (E : Set ℝ) (j : ℕ) (u L : ℝ) (k : ℤ) : Finset ℤ := by
  classical
  exact (activeDyadicIndices E j).filter
    (radiusGapShellNeighbors u L (dyadicLeft j k) ∘ dyadicLeft j)

/-- The members of `s` whose cells meet the length-`δ` interval centered at
`a`, where `δ = 2^{-j}`. -/
noncomputable def dyadicCellsMeetingInterval
    (j : ℕ) (s : Finset ℤ) (a : ℝ) : Finset ℤ := by
  classical
  exact s.filter fun k =>
    (dyadicInterval j k ∩ Icc (a - dyadicScale j / 2)
      (a + dyadicScale j / 2)).Nonempty

/-- A length-`δ` interval can meet at most six cells of a `δ`-grid, even with
the closed-cell convention.  The constant is intentionally non-sharp; it is
uniform and is all the covering argument needs. -/
theorem card_dyadicCells_meeting_interval_le_six
    {j : ℕ} {s : Finset ℤ} {a : ℝ} :
    (dyadicCellsMeetingInterval j s a).card ≤ 6 := by
  classical
  let δ : ℝ := dyadicScale j
  let t : Finset ℤ := dyadicCellsMeetingInterval j s a
  let A : ℝ := (a - δ / 2 - 1) / δ - 1
  let B : ℝ := (a + δ / 2 - 1) / δ
  let tReal : Finset ℝ := t.image fun k : ℤ => (k : ℝ)
  have hδ : 0 < δ := by
    dsimp [δ]
    exact dyadicScale_pos j
  have htAB : (↑tReal : Set ℝ) ⊆ Icc A B := by
    intro z hz
    rcases Finset.mem_image.mp hz with ⟨k, hk, rfl⟩
    have hk' : (dyadicInterval j k ∩ Icc (a - δ / 2) (a + δ / 2)).Nonempty := by
      simpa only [t, dyadicCellsMeetingInterval, δ] using (Finset.mem_filter.mp hk).2
    rcases hk' with ⟨x, hxcell, hxcover⟩
    have hleft : dyadicLeft j k ≤ x := by
      simpa only [dyadicInterval] using hxcell.1
    have hright : x ≤ dyadicRight j k := by
      simpa only [dyadicInterval] using hxcell.2
    have hlow : a - δ / 2 ≤ x := hxcover.1
    have hupp : x ≤ a + δ / 2 := hxcover.2
    have hright' : x ≤ 1 + ((k + 1 : ℤ) : ℝ) * δ := by
      simpa only [δ, dyadicRight] using hright
    have hleft' : 1 + (k : ℝ) * δ ≤ x := by
      simpa only [δ, dyadicLeft] using hleft
    constructor
    · dsimp [A]
      rw [sub_le_iff_le_add, div_le_iff₀ hδ]
      norm_num at hright' ⊢
      linarith
    · dsimp [B]
      rw [le_div_iff₀ hδ]
      linarith
  have htsep : StrictlySeparated tReal (1 / 2 : ℝ) := by
    intro x y hx hy hxy
    rcases Finset.mem_image.mp hx with ⟨k, hk, rfl⟩
    rcases Finset.mem_image.mp hy with ⟨l, hl, rfl⟩
    have hkl : k ≠ l := by
      intro hkl
      apply hxy
      simp only [hkl]
    have hpos : (0 : ℤ) < |k - l| :=
      abs_pos.mpr (sub_ne_zero.mpr hkl)
    have hone : (1 : ℤ) ≤ |k - l| := by omega
    have honeReal : (1 : ℝ) ≤ |((k : ℝ) - (l : ℝ))| := by
      have hone' : (1 : ℝ) ≤ ((|k - l| : ℤ) : ℝ) := by
        exact_mod_cast hone
      calc
        (1 : ℝ) ≤ ((|k - l| : ℤ) : ℝ) := hone'
        _ = |((k - l : ℤ) : ℝ)| := Int.cast_abs
        _ = |(k : ℝ) - (l : ℝ)| := by rw [Int.cast_sub]
    linarith
  have hAB : A ≤ B := by
    dsimp [A, B]
    field_simp
    nlinarith [hδ]
  obtain ⟨ι, hιcover, hιcard⟩ := exists_intervalCover_of_subset_Icc
    (F := (↑tReal : Set ℝ)) (a := A) (b := B) (δ := (1 / 2 : ℝ))
    (by norm_num) hAB htAB
  have hpack : tReal.card ≤ ι.card :=
    Finset.card_le_card_of_strictlySeparated_intervalCover
      (F := (↑tReal : Set ℝ)) (by norm_num) (by intro x hx; exact hx) htsep hιcover
  have hratio : (B - A) / (1 / 2 : ℝ) = 4 := by
    dsimp [A, B]
    field_simp
    ring
  have hιsix : ι.card ≤ 6 := by
    have hιcard' := hιcard
    rw [hratio] at hιcard'
    norm_num at hιcard'
    exact_mod_cast hιcard'
  have htRealCard : tReal.card = t.card :=
    Finset.card_image_of_injective t (by
      intro k l hkl
      change (k : ℝ) = (l : ℝ) at hkl
      exact Int.cast_inj.mp hkl)
  change (dyadicCellsMeetingInterval j s a).card ≤ 6
  change t.card ≤ 6
  rw [← htRealCard]
  exact hpack.trans hιsix

/-- If every cell indexed by `s` meets `F`, then every same-scale interval
cover of `F` controls the number of those cells.  This is the elementary
bridge which lets us count active cells without selecting separated points of
`E`. -/
theorem card_dyadicCellIndices_le_six_mul_card_of_intervalCover
    {j : ℕ} {F : Set ℝ} {s : Finset ℤ} {ι : Finset ℝ}
    (hcell : ∀ k ∈ s, (F ∩ dyadicInterval j k).Nonempty)
    (hcover : IsIntervalCover F (dyadicScale j) ι) :
    s.card ≤ 6 * ι.card := by
  classical
  let fibres : ℝ → Finset ℤ := fun a => dyadicCellsMeetingInterval j s a
  have hs : s ⊆ ι.biUnion fibres := by
    intro k hk
    rcases hcell k hk with ⟨x, hxF, hxcell⟩
    rcases Set.mem_iUnion.mp (hcover hxF) with ⟨a, hxa⟩
    rcases Set.mem_iUnion.mp hxa with ⟨haι, hxcover⟩
    rw [Finset.mem_biUnion]
    refine ⟨a, haι, ?_⟩
    change k ∈ dyadicCellsMeetingInterval j s a
    unfold dyadicCellsMeetingInterval
    exact Finset.mem_filter.mpr ⟨hk, ⟨x, hxcell, hxcover⟩⟩
  calc
    s.card ≤ (ι.biUnion fibres).card := Finset.card_le_card hs
    _ ≤ ι.card * 6 := Finset.card_biUnion_le_card_mul ι fibres 6
      (fun a ha => card_dyadicCells_meeting_interval_le_six)
    _ = 6 * ι.card := by omega

/-- If a radius `x ∈ [1,2]` is localized at a radius at least `δ`, then the
clipped localization interval still has length at least `δ`.  Unlike the
half-width estimate used for separated samples, this version permits a large
localization radius and is therefore suited to the last dyadic gap shells. -/
theorem scale_le_localRadiusInterval_length
    {x δ R : ℝ} (hx : x ∈ Icc (1 : ℝ) 2)
    (hδ : 0 < δ) (hδone : δ < 1) (hδR : δ ≤ R) :
    δ ≤ min 2 (x + R) - max 1 (x - R) := by
  by_cases hnear : x ≤ 1 + δ
  · have hleft : max 1 (x - R) = 1 := by
      apply max_eq_left
      linarith
    have hright : 1 + δ ≤ min 2 (x + R) := by
      apply le_min
      · linarith
      · linarith [hx.1]
    rw [hleft]
    linarith
  · have hfar : 1 + δ < x := lt_of_not_ge hnear
    have hleft : max 1 (x - R) ≤ x - δ := by
      apply max_le
      · linarith
      · linarith
    have hright : x ≤ min 2 (x + R) := by
      apply le_min
      · exact hx.2
      · linarith
    linarith

/-- A point in a cell whose *left endpoint* is within `L` of the left
endpoint of another cell lies within `L + δ` of every point of the latter
cell.  This is the one-cell enlargement that replaces the unavailable claim
that the sampled left endpoints themselves lie in `E`. -/
theorem mem_localRadiusInterval_of_dyadicLeft_gap
    {j : ℕ} {k l : ℤ} {L x y : ℝ}
    (hxcell : x ∈ dyadicInterval j k)
    (hycell : y ∈ dyadicInterval j l)
    (hy : y ∈ Icc (1 : ℝ) 2)
    (hgap : |dyadicLeft j k - dyadicLeft j l| < L) :
    y ∈ localRadiusInterval x (L + dyadicScale j) := by
  have hδ : 0 < dyadicScale j := dyadicScale_pos j
  have hxleft : dyadicLeft j k ≤ x := hxcell.1
  have hxright : x ≤ dyadicRight j k := hxcell.2
  have hyleft : dyadicLeft j l ≤ y := hycell.1
  have hyright : y ≤ dyadicRight j l := hycell.2
  have hxright' : x ≤ dyadicLeft j k + dyadicScale j := by
    rw [← dyadicRight_sub_dyadicLeft j k]
    linarith
  have hyright' : y ≤ dyadicLeft j l + dyadicScale j := by
    rw [← dyadicRight_sub_dyadicLeft j l]
    linarith
  have hgap' : |dyadicLeft j l - dyadicLeft j k| < L := by
    simpa only [abs_sub_comm] using hgap
  rcases abs_lt.mp hgap' with ⟨hgaplower, hgapupper⟩
  have hxy : |y - x| < L + dyadicScale j := by
    rw [abs_lt]
    constructor <;> linarith
  rcases abs_lt.mp hxy with ⟨hxylower, hxyupper⟩
  constructor
  · apply max_le hy.1
    linarith
  · apply le_min hy.2
    linarith

/-- The local subpower Assouad cover bound controls every radius-gap degree
of the active dyadic grid.  The relation is imposed on the literal left
endpoints `dyadicLeft j k`, exactly as in the sampled `TT*` decomposition of
the paper; no endpoint is assumed to belong to `E`.

