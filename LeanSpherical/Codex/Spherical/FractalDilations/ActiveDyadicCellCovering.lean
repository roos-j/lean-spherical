allowance.  In the usual shells `2^{-j} ≤ L`, it is absorbed into the
absolute constants. -/
theorem activeDyadicRadiusGapNeighbors_card_le_of_hasSubpowerAssouadCoverBound
    {E : Set ℝ} {γ η C u L : ℝ} {j : ℕ} {k : ℤ}
    (hE : E ⊆ Icc (1 : ℝ) 2)
    (hcover : HasSubpowerAssouadCoverBound E γ η C)
    (hC : 0 ≤ C) (hγ : 0 ≤ γ)
    (hδone : dyadicScale j < 1) (hL : 0 ≤ L)
    (hk : k ∈ activeDyadicIndices E j) :
    ((activeDyadicRadiusGapNeighbors E j u L k).card : ℝ) ≤
      6 * C * (dyadicScale j) ^ (-η) *
        ((2 * (L + dyadicScale j)) / dyadicScale j) ^ γ := by
  classical
  let δ : ℝ := dyadicScale j
  let R : ℝ := L + δ
  rcases activeDyadicIndices_nonempty_intersection hk with ⟨x, hxE, hxcell⟩
  have hxIcc : x ∈ Icc (1 : ℝ) 2 := hE hxE
  have hδ : 0 < δ := by
    dsimp [δ]
    exact dyadicScale_pos j
  have hRnonneg : 0 ≤ R := by
    dsimp [R]
    linarith
  let a : ℝ := max 1 (x - R)
  let b : ℝ := min 2 (x + R)
  have ha : 1 ≤ a := by
    dsimp [a]
    exact le_max_left _ _
  have hb : b ≤ 2 := by
    dsimp [b]
    exact min_le_left _ _
  have hab : a ≤ b := by
    have hself := mem_localRadiusInterval_self hxIcc hRnonneg
    simpa only [a, b, localRadiusInterval] using hself.1.trans hself.2
  have hδlength : δ ≤ b - a := by
    dsimp [a, b]
    apply scale_le_localRadiusInterval_length hxIcc hδ
    · simpa only [δ] using hδone
    · dsimp [R]
      linarith
  obtain ⟨ι, hιcover, hιcard⟩ := hcover δ a b hδ (by simpa only [δ] using hδone)
    ha hab hb hδlength
  let t : Finset ℤ := activeDyadicRadiusGapNeighbors E j u L k
  have htcell : ∀ l ∈ t, ((E ∩ Icc a b) ∩ dyadicInterval j l).Nonempty := by
    intro l hl
    have hl' : l ∈ activeDyadicIndices E j ∧
        radiusGapShellNeighbors u L (dyadicLeft j k) (dyadicLeft j l) := by
      simpa only [t, activeDyadicRadiusGapNeighbors, Function.comp_apply] using
        Finset.mem_filter.mp hl
    rcases activeDyadicIndices_nonempty_intersection hl'.1 with ⟨y, hyE, hycell⟩
    have hyIcc : y ∈ Icc (1 : ℝ) 2 := hE hyE
    have hlocal : y ∈ localRadiusInterval x R := by
      dsimp only [R]
      exact mem_localRadiusInterval_of_dyadicLeft_gap hxcell hycell hyIcc hl'.2.2
    have hlocal' : y ∈ Icc a b := by
      simpa only [a, b, localRadiusInterval] using hlocal
