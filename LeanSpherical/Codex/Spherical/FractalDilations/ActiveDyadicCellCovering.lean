      exact mul_le_mul_of_nonneg_left hιcard (by norm_num)
    _ = (6 * C * δ ^ (-η)) * ((b - a) / δ) ^ γ := by ring
    _ ≤ (6 * C * δ ^ (-η)) * ((2 * R) / δ) ^ γ :=
      mul_le_mul_of_nonneg_left hpow hfactor_nonneg
    _ = 6 * C * δ ^ (-η) * ((2 * R) / δ) ^ γ := by ring

/-- On the usual nontrivial shells, `2^{-j} ≤ L`, the cell-boundary
enlargement is absorbed into `4L`.  This is the form whose dependence on the
gap scale is exactly the `L^γ` factor used in (3.5). -/
theorem activeDyadicRadiusGapNeighbors_card_le_of_hasSubpowerAssouadCoverBound_of_scale_le
    {E : Set ℝ} {γ η C u L : ℝ} {j : ℕ} {k : ℤ}
    (hE : E ⊆ Icc (1 : ℝ) 2)
    (hcover : HasSubpowerAssouadCoverBound E γ η C)
    (hC : 0 ≤ C) (hγ : 0 ≤ γ)
    (hδone : dyadicScale j < 1) (hδL : dyadicScale j ≤ L)
    (hk : k ∈ activeDyadicIndices E j) :
    ((activeDyadicRadiusGapNeighbors E j u L k).card : ℝ) ≤
      6 * C * (dyadicScale j) ^ (-η) *
        ((4 * L) / dyadicScale j) ^ γ := by
  have hδ : 0 < dyadicScale j := dyadicScale_pos j
  have hL : 0 ≤ L := hδ.le.trans hδL
  have hbase := activeDyadicRadiusGapNeighbors_card_le_of_hasSubpowerAssouadCoverBound
    (u := u) hE hcover hC hγ hδone hL hk
  have hratio :
      (2 * (L + dyadicScale j)) / dyadicScale j ≤
        (4 * L) / dyadicScale j := by
    apply (div_le_div_iff_of_pos_right hδ).mpr
    linarith
  have hpow :
      ((2 * (L + dyadicScale j)) / dyadicScale j) ^ γ ≤
        ((4 * L) / dyadicScale j) ^ γ := by
    apply Real.rpow_le_rpow
    · exact div_nonneg (by linarith) hδ.le
    · exact hratio
    · exact hγ
  have hfactor : 0 ≤ 6 * C * (dyadicScale j) ^ (-η) := by
    positivity
  calc
    ((activeDyadicRadiusGapNeighbors E j u L k).card : ℝ) ≤
        6 * C * (dyadicScale j) ^ (-η) *
          ((2 * (L + dyadicScale j)) / dyadicScale j) ^ γ := hbase
    _ ≤ 6 * C * (dyadicScale j) ^ (-η) *
          ((4 * L) / dyadicScale j) ^ γ :=
      mul_le_mul_of_nonneg_left hpow hfactor

/-- The literal finite `Q4` shell on active dyadic-cell indices.  The
classical decidable relation is internal to this definition so callers do not
need to manufacture a decidability instance for a real-valued gap relation. -/
noncomputable def q4ActiveDyadicRadiusGapShell
    (E : Set ℝ) (j : ℕ) (u L : ℝ)
    {V W : Type*} [AddCommMonoid W]
    (P : ℤ → ℤ → V → W) (g : ℤ → V) (i : ℤ) : W := by
  classical
  exact q4TTStarShell (activeDyadicIndices E j)
    (fun i l => radiusGapShellNeighbors u L (dyadicLeft j i) (dyadicLeft j l)) P g i

