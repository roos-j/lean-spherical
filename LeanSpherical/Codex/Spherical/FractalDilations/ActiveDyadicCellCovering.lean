    card_dyadicCellIndices_le_six_mul_card_of_intervalCover htcell hιcover
  have htcardReal : (t.card : ℝ) ≤ 6 * (ι.card : ℝ) := by
    exact_mod_cast htcard
  have hlength_upper : b - a ≤ 2 * R := by
    dsimp [a, b]
    exact localRadiusInterval_length_le_two_mul x R
  have hratio_nonneg : 0 ≤ (b - a) / δ :=
    div_nonneg (sub_nonneg.mpr hab) hδ.le
  have hratio : (b - a) / δ ≤ (2 * R) / δ :=
    (div_le_div_iff_of_pos_right hδ).mpr hlength_upper
  have hpow : ((b - a) / δ) ^ γ ≤ ((2 * R) / δ) ^ γ :=
    Real.rpow_le_rpow hratio_nonneg hratio hγ
