theorem lintegral_Ioi_eq_lintegral_Ioc_add_lintegral_Ioi_one
    (F : ℝ → ℝ≥0∞) :
    (∫⁻ t in Ioi (0 : ℝ), F t) =
      (∫⁻ t in Ioc (0 : ℝ) 1, F t) + ∫⁻ t in Ioi (1 : ℝ), F t := by
