    ext t
    constructor
    · intro ht
      rcases ht with ht | ht
      · exact ht.1
      · change 1 < t at ht
        exact lt_trans zero_lt_one ht
    · intro ht
      by_cases hle : t ≤ 1
      · exact Or.inl ⟨ht, hle⟩
      · exact Or.inr (lt_of_not_ge hle)
