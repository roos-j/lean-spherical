/-- Collect the two interpolated endpoint contributions at the Minkowski
balancing scale.  The common power is `R^(α + n - n p)`. -/
theorem minkowski_balance_one_two
    {n : ℕ} {R α p c₁ c₂ a₁ a₂ : ℝ} (hR : 0 < R) (hp0 : 0 < p)
    (hc₁ : 0 ≤ c₁) (hc₂ : 0 ≤ c₂) (ha₁ : 0 ≤ a₁) (ha₂ : 0 ≤ a₂)
    (I : ENNReal) :
    ENNReal.ofReal p *
      (4 * ENNReal.ofReal (c₂ * R ^ (α - n)) *
          ((ENNReal.ofReal (R ^ (n : ℝ))) ^ (2 - p) *
            (ENNReal.ofReal a₂ * I)) +
        2 * ENNReal.ofReal (c₁ * R ^ α) *
          ((ENNReal.ofReal (R ^ (n : ℝ))) ^ (1 - p) *
            (ENNReal.ofReal a₁ * I))) =
      ENNReal.ofReal (p * (4 * c₂ * a₂ + 2 * c₁ * a₁)) *
        (ENNReal.ofReal R) ^ (α + n - n * p) * I := by
  have hbal₂ := minkowski_balance_two_power (n := n) (α := α) (p := p) hR
  have hbal₁ := minkowski_balance_one_power (n := n) (α := α) (p := p) hR
  have hterm₂ :
      4 * ENNReal.ofReal (c₂ * R ^ (α - n)) *
          ((ENNReal.ofReal (R ^ (n : ℝ))) ^ (2 - p) *
            (ENNReal.ofReal a₂ * I)) =
        (4 * ENNReal.ofReal c₂ * ENNReal.ofReal a₂) *
          (ENNReal.ofReal R) ^ (α + n - n * p) * I := by
    rw [ENNReal.ofReal_mul hc₂]
    calc
      4 * (ENNReal.ofReal c₂ * ENNReal.ofReal (R ^ (α - n))) *
          ((ENNReal.ofReal (R ^ (n : ℝ))) ^ (2 - p) *
            (ENNReal.ofReal a₂ * I)) =
          (4 * ENNReal.ofReal c₂ * ENNReal.ofReal a₂) *
            (ENNReal.ofReal (R ^ (α - n)) *
              (ENNReal.ofReal (R ^ (n : ℝ))) ^ (2 - p)) * I := by ring
      _ = _ := by rw [hbal₂]
  have hterm₁ :
      2 * ENNReal.ofReal (c₁ * R ^ α) *
          ((ENNReal.ofReal (R ^ (n : ℝ))) ^ (1 - p) *
            (ENNReal.ofReal a₁ * I)) =
        (2 * ENNReal.ofReal c₁ * ENNReal.ofReal a₁) *
          (ENNReal.ofReal R) ^ (α + n - n * p) * I := by
    rw [ENNReal.ofReal_mul hc₁]
    calc
      2 * (ENNReal.ofReal c₁ * ENNReal.ofReal (R ^ α)) *
          ((ENNReal.ofReal (R ^ (n : ℝ))) ^ (1 - p) *
            (ENNReal.ofReal a₁ * I)) =
          (2 * ENNReal.ofReal c₁ * ENNReal.ofReal a₁) *
            (ENNReal.ofReal (R ^ α) *
              (ENNReal.ofReal (R ^ (n : ℝ))) ^ (1 - p)) * I := by ring
      _ = _ := by rw [hbal₁]
  have hconst₂ : 4 * ENNReal.ofReal c₂ * ENNReal.ofReal a₂ =
      ENNReal.ofReal (4 * c₂ * a₂) := by
    calc
      4 * ENNReal.ofReal c₂ * ENNReal.ofReal a₂ =
          ENNReal.ofReal (4 : ℝ) * ENNReal.ofReal c₂ * ENNReal.ofReal a₂ := by norm_num
      _ = ENNReal.ofReal ((4 : ℝ) * c₂) * ENNReal.ofReal a₂ := by
        rw [← ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 4)]
      _ = ENNReal.ofReal ((4 : ℝ) * c₂ * a₂) := by
        rw [← ENNReal.ofReal_mul (mul_nonneg (by norm_num) hc₂)]
  have hconst₁ : 2 * ENNReal.ofReal c₁ * ENNReal.ofReal a₁ =
      ENNReal.ofReal (2 * c₁ * a₁) := by
    calc
      2 * ENNReal.ofReal c₁ * ENNReal.ofReal a₁ =
          ENNReal.ofReal (2 : ℝ) * ENNReal.ofReal c₁ * ENNReal.ofReal a₁ := by norm_num
      _ = ENNReal.ofReal ((2 : ℝ) * c₁) * ENNReal.ofReal a₁ := by
        rw [← ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2)]
      _ = ENNReal.ofReal ((2 : ℝ) * c₁ * a₁) := by
        rw [← ENNReal.ofReal_mul (mul_nonneg (by norm_num) hc₁)]
  have hcoeff : ENNReal.ofReal p *
      (4 * ENNReal.ofReal c₂ * ENNReal.ofReal a₂ +
        2 * ENNReal.ofReal c₁ * ENNReal.ofReal a₁) =
      ENNReal.ofReal (p * (4 * c₂ * a₂ + 2 * c₁ * a₁)) := by
    rw [hconst₂, hconst₁]
    rw [← ENNReal.ofReal_add
      (mul_nonneg (mul_nonneg (by norm_num) hc₂) ha₂)
      (mul_nonneg (mul_nonneg (by norm_num) hc₁) ha₁)]
    rw [← ENNReal.ofReal_mul hp0.le]
  rw [hterm₂, hterm₁]
  calc
    ENNReal.ofReal p *
        ((4 * ENNReal.ofReal c₂ * ENNReal.ofReal a₂) *
            (ENNReal.ofReal R) ^ (α + n - n * p) * I +
          (2 * ENNReal.ofReal c₁ * ENNReal.ofReal a₁) *
            (ENNReal.ofReal R) ^ (α + n - n * p) * I) =
        (ENNReal.ofReal p *
