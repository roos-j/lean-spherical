    (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    fractalSphericalMaximalReal d E f x ≤
      s.sup' hs (fun i => fractalSphericalMaximalReal d (A i) f x) := by
  have hraw : fractalSphericalMaximal d E (f : Euclidean d → ℂ) x ≤
      s.sup' hs (fun i => fractalSphericalMaximal d (A i)
        (f : Euclidean d → ℂ) x) := by
    apply iSup_le
    intro r
    rcases Set.mem_iUnion.mp (hcover r.2) with ⟨i, hAi⟩
    rcases Set.mem_iUnion.mp hAi with ⟨hi, hri⟩
    exact (normalizedSphericalAverage_le_fractalSphericalMaximal (A i)
      (f : Euclidean d → ℂ) hri x).trans
      (Finset.le_sup' (fun k => fractalSphericalMaximal d (A k)
        (f : Euclidean d → ℂ) x) hi)
  rcases s.exists_mem_eq_sup' hs (fun i => fractalSphericalMaximal d (A i)
      (f : Euclidean d → ℂ) x) with ⟨i, hi, hmax⟩
  have hright : s.sup' hs (fun i => fractalSphericalMaximal d (A i)
      (f : Euclidean d → ℂ) x) ≠ ⊤ := by
    rw [hmax]
    exact fractalSphericalMaximal_ne_top hd (A i) (hApos i hi) f x
  have hleft : fractalSphericalMaximal d E (f : Euclidean d → ℂ) x ≠ ⊤ :=
    ne_top_of_le_ne_top hright hraw
  have hreal := (ENNReal.toReal_le_toReal hleft hright).mpr hraw
  calc
    fractalSphericalMaximalReal d E f x ≤
        (s.sup' hs (fun i => fractalSphericalMaximal d (A i)
          (f : Euclidean d → ℂ) x)).toReal := by
          exact hreal
    _ = fractalSphericalMaximalReal d (A i) f x := by
      rw [hmax]
      rfl
    _ ≤ s.sup' hs (fun i => fractalSphericalMaximalReal d (A i) f x) :=
      Finset.le_sup' (fun k => fractalSphericalMaximalReal d (A k) f x) hi

/-- Multiply the preceding cover estimate by the surface mass and replace
each normalized local maximum by its unnormalised counterpart. -/
theorem surfaceMass_mul_fractalSphericalMaximalReal_le_finset_sup_raw_of_cover
    {d : ℕ} {ι : Type*} {E : Set ℝ} (hd : 0 < d)
    (s : Finset ι) (hs : s.Nonempty) (a b : ι → ℝ)
    (hcover : E ⊆ ⋃ i ∈ s, Icc (a i) (b i))
    (hEpos : E ⊆ Ioi (0 : ℝ))
    (hinterval : ∀ i ∈ s, Icc (a i) (b i) ⊆ Ioi (0 : ℝ))
    (hab : ∀ i ∈ s, a i ≤ b i)
    (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    surfaceMass d * fractalSphericalMaximalReal d E f x ≤
      s.sup' hs (fun i => sphericalIntervalMaximalRaw (a i) (b i) f x) := by
  have hcoverReal := fractalSphericalMaximalReal_le_finset_sup_of_cover hd s hs
    (fun i => Icc (a i) (b i)) hcover hEpos hinterval f x
  rcases s.exists_mem_eq_sup' hs (fun i =>
      fractalSphericalMaximalReal d (Icc (a i) (b i)) f x) with ⟨i, hi, hmax⟩
  rw [hmax] at hcoverReal
  calc
    surfaceMass d * fractalSphericalMaximalReal d E f x ≤
        surfaceMass d * fractalSphericalMaximalReal d (Icc (a i) (b i)) f x :=
      mul_le_mul_of_nonneg_left hcoverReal (surfaceMass_pos hd).le
    _ ≤ surfaceMass d * ((surfaceMass d)⁻¹ *
          sphericalIntervalMaximalRaw (a i) (b i) f x) :=
      mul_le_mul_of_nonneg_left
        (fractalSphericalMaximalReal_interval_le_inv_surfaceMass_mul_raw hd
          (hab i hi) f x)
        (surfaceMass_pos hd).le
    _ = sphericalIntervalMaximalRaw (a i) (b i) f x := by
      rw [← mul_assoc, mul_inv_cancel₀ (surfaceMass_ne_zero hd), one_mul]
    _ ≤ s.sup' hs (fun k => sphericalIntervalMaximalRaw (a k) (b k) f x) :=
      Finset.le_sup' (fun k => sphericalIntervalMaximalRaw (a k) (b k) f x) hi

/-- The local `L¹` estimate from `SmoothDyadicIntervalL1`, expressed through
the absolute projection used in this file. -/
theorem sphericalIntervalMaximalRaw_memLp_one_of_scaled
    {d : ℕ} (hd : 0 < d)
    (ψ ψj f : SchwartzMap (Euclidean d) ℂ)
    {R a b : ℝ} (hR : 0 < R) (hab : a ≤ b)
    (hψj : ∀ ξ : Euclidean d, ψj ξ = ψ (R⁻¹ • ξ)) :
    MemLp (sphericalIntervalMaximalRaw a b (dyadicBandpassProjection ψj f)) 1 volume ∧
      (∫ x : Euclidean d,
        ‖sphericalIntervalMaximalRaw a b (dyadicBandpassProjection ψj f) x‖) ≤
        surfaceMass d *
          ((∫ x : Euclidean d, ‖f x‖) *
            (∫ x : Euclidean d, ‖(𝓕⁻ ψ : SchwartzMap (Euclidean d) ℂ) x‖) +
            (b - a) * R * (∫ x : Euclidean d, ‖f x‖) *
              (∫ x : Euclidean d,
                ‖fderiv ℝ ((𝓕⁻ ψ : SchwartzMap (Euclidean d) ℂ) :
                  Euclidean d → ℂ) x‖)) := by
  have hproj (x : Euclidean d) :
      dyadicBandpassProjection ψj f x =
        𝓕⁻ (fun ξ : Euclidean d => ψ (R⁻¹ • ξ) *
          𝓕 (f : Euclidean d → ℂ) ξ) x := by
    rw [dyadicBandpassProjection_apply]
    apply congrArg (fun h : Euclidean d → ℂ => 𝓕⁻ h x)
    funext ξ
    rw [hψj ξ]
  have hfunc : sphericalIntervalMaximalRaw a b (dyadicBandpassProjection ψj f) =
      fun x : Euclidean d =>
        (⨆ r : Icc a b, ENNReal.ofReal ‖sphericalAverage d
          (𝓕⁻ (fun ξ : Euclidean d => ψ (R⁻¹ • ξ) *
            𝓕 (f : Euclidean d → ℂ) ξ)) r.1 x‖).toReal := by
    funext x
    unfold sphericalIntervalMaximalRaw
    congr 1
    apply iSup_congr
    intro r
    congr 2
    apply congrArg (fun g : Euclidean d → ℂ =>
      sphericalAverage d g r.1 x)
    funext y
    exact hproj y
  have hlocal := scaled_schwartz_sphericalInterval_memLp_one hd ψ f hR hab
  rw [hfunc]
  exact hlocal

/-- The sharp local `L²` estimate from `SmoothDyadicIntervalL2`, expressed
through `dyadicBandpassProjection`. -/
theorem sphericalIntervalMaximalRaw_memLp_two_of_sharp
    {n : Nat} (hn : 2 ≤ n) (C0 C1 : ℝ) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ xi : Euclidean (n + 1), 1 ≤ ‖xi‖ →
      ‖surfaceFourier (n + 1) xi‖ ≤ C0 / ‖xi‖ ^ ((n : ℝ) / 2))
    (hderiv : ∀ xi : Euclidean (n + 1), ∀ r : ℝ, 1 ≤ ‖xi‖ →
      r ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun s : ℝ => surfaceFourier (n + 1) (s • xi)) r‖ ≤
        C1 / ‖xi‖ ^ ((n : ℝ) / 2 - 1))
    (phi f psi : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (hpsi : ∀ xi : Euclidean (n + 1),
      psi xi = phi (((2 : ℝ) ^ (j + 1))⁻¹ • xi) -
        phi (((2 : ℝ) ^ j)⁻¹ • xi))
    (hpsi_compact : HasCompactSupport (psi : Euclidean (n + 1) → ℂ))
    {a b : ℝ} (hab : a ≤ b) (hinterval : Icc a b ⊆ Icc (1 : ℝ) 2) :
    MemLp (sphericalIntervalMaximalRaw a b (dyadicBandpassProjection psi f)) 2 volume ∧
      (∫ x : Euclidean (n + 1),
        ‖sphericalIntervalMaximalRaw a b (dyadicBandpassProjection psi f) x‖ ^ 2) ≤
        (2 * ((2 * C0) / (dyadicScale j) ^ ((n : ℝ) / 2)) ^ 2 +
          2 * (b - a) ^ 2 *
            ((2 * C1) / (dyadicScale j) ^ ((n : ℝ) / 2 - 1)) ^ 2) *
          ∫ x : Euclidean (n + 1), ‖f x‖ ^ 2 := by
  unfold sphericalIntervalMaximalRaw
  exact smooth_dyadic_sphericalInterval_memLp_two_of_sharp_of_bandpass
    hn C0 C1 hC0 hC1 hdecay hderiv phi f psi hphi_one hphi_zero hphi_norm
    j hpsi hpsi_compact hab hinterval

/-- The coefficient in the short-radius `L²` estimate has the full
`R^{-n}` decay once the radius interval has length at most `R^{-1}`. -/
theorem short_interval_l2_coefficient_le_frequency_decay
    {n : ℕ} (hn : 2 ≤ n) (C0 C1 : ℝ) (hC0 : 0 ≤ C0) (hC1 : 0 ≤ C1)
    {R L : ℝ} (hR : 0 < R) (hRone : 1 ≤ R)
    (hL : 0 ≤ L) (hLR : L ≤ R⁻¹) :
    2 * ((2 * C0) / R ^ ((n : ℝ) / 2)) ^ 2 +
        2 * L ^ 2 * ((2 * C1) / R ^ ((n : ℝ) / 2 - 1)) ^ 2 ≤
      (8 * C0 ^ 2 + 8 * C1 ^ 2) * R ^ (-(n : ℝ)) := by
  have hR0 : 0 ≤ R := hR.le
  have hinv : 0 ≤ R⁻¹ := inv_nonneg.mpr hR0
  have hpow0 (e : ℝ) : 0 ≤ R ^ e := Real.rpow_nonneg hR0 e
  have hLsq : L ^ 2 ≤ (R⁻¹) ^ 2 :=
    (sq_le_sq₀ hL hinv).2 hLR
  have hfirst :
      ((2 * C0) / R ^ ((n : ℝ) / 2)) ^ 2 =
        (2 * C0) ^ 2 * R ^ (-(n : ℝ)) := by
    rw [div_eq_mul_inv, ← Real.rpow_neg hR0, mul_pow]
    congr 1
    rw [← Real.rpow_natCast, ← Real.rpow_mul hR0]
    congr 1
    ring
  have hsecond_eq :
      (R⁻¹) ^ 2 * ((2 * C1) / R ^ ((n : ℝ) / 2 - 1)) ^ 2 =
        (2 * C1) ^ 2 * R ^ (-(n : ℝ)) := by
    have hinvsq : (R⁻¹) ^ 2 = R ^ (-2 : ℝ) := by
      rw [show R⁻¹ = R ^ (-1 : ℝ) by rw [Real.rpow_neg_one]]
      rw [← Real.rpow_natCast, ← Real.rpow_mul hR0]
      congr 1
      norm_num
    rw [hinvsq]
    calc
      R ^ (-2 : ℝ) * ((2 * C1) / R ^ ((n : ℝ) / 2 - 1)) ^ 2 =
          R ^ (-2 : ℝ) *
            ((2 * C1) ^ 2 * R ^ (-(((n : ℝ) / 2 - 1) * 2)) ) := by
            congr 1
            rw [div_eq_mul_inv, ← Real.rpow_neg hR0, mul_pow]
            congr 1
            rw [← Real.rpow_natCast, ← Real.rpow_mul hR0]
            congr 1
            ring
      _ = (2 * C1) ^ 2 *
            (R ^ (-2 : ℝ) * R ^ (-(((n : ℝ) / 2 - 1) * 2))) := by ring
      _ = (2 * C1) ^ 2 * R ^ (-(n : ℝ)) := by
        rw [← Real.rpow_add hR]
        congr 1
        ring
  have hsecond :
      L ^ 2 * ((2 * C1) / R ^ ((n : ℝ) / 2 - 1)) ^ 2 ≤
        (2 * C1) ^ 2 * R ^ (-(n : ℝ)) := by
    calc
      L ^ 2 * ((2 * C1) / R ^ ((n : ℝ) / 2 - 1)) ^ 2 ≤
          (R⁻¹) ^ 2 * ((2 * C1) / R ^ ((n : ℝ) / 2 - 1)) ^ 2 :=
        mul_le_mul_of_nonneg_right hLsq (sq_nonneg _)
      _ = _ := hsecond_eq
  rw [hfirst]
  have hbase0 : 0 ≤ R ^ (-(n : ℝ)) := hpow0 _
  have hC0sq : 0 ≤ (2 * C0) ^ 2 := sq_nonneg _
  have hC1sq : 0 ≤ (2 * C1) ^ 2 := sq_nonneg _
  nlinarith

/-- At reciprocal frequency radius length, the local `L¹` bound is uniform
in the dyadic scale. -/
theorem sphericalIntervalMaximalRaw_l1_uniform_of_scaled
    {d : ℕ} (hd : 0 < d)
    (ψ ψj f : SchwartzMap (Euclidean d) ℂ)
    {R a b : ℝ} (hR : 0 < R) (hab : a ≤ b)
    (hlen : b - a ≤ R⁻¹)
    (hψj : ∀ ξ : Euclidean d, ψj ξ = ψ (R⁻¹ • ξ)) :
    MemLp (sphericalIntervalMaximalRaw a b (dyadicBandpassProjection ψj f)) 1 volume ∧
      (∫ x : Euclidean d,
        ‖sphericalIntervalMaximalRaw a b (dyadicBandpassProjection ψj f) x‖) ≤
        (surfaceMass d *
          ((∫ x : Euclidean d, ‖(𝓕⁻ ψ : SchwartzMap (Euclidean d) ℂ) x‖) +
            ∫ x : Euclidean d,
              ‖fderiv ℝ ((𝓕⁻ ψ : SchwartzMap (Euclidean d) ℂ) :
                Euclidean d → ℂ) x‖)) *
          ∫ x : Euclidean d, ‖f x‖ := by
  rcases sphericalIntervalMaximalRaw_memLp_one_of_scaled hd ψ ψj f hR hab hψj with
    ⟨hmem, hbound⟩
  refine ⟨hmem, ?_⟩
  let F : ℝ := ∫ x : Euclidean d, ‖f x‖
  let A : ℝ := ∫ x : Euclidean d, ‖(𝓕⁻ ψ : SchwartzMap (Euclidean d) ℂ) x‖
  let D : ℝ := ∫ x : Euclidean d,
    ‖fderiv ℝ ((𝓕⁻ ψ : SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) x‖
  have hlen0 : 0 ≤ b - a := sub_nonneg.mpr hab
  have hfactor : (b - a) * R ≤ 1 := by
    have := mul_le_mul_of_nonneg_right hlen hR.le
    rw [inv_mul_cancel₀ hR.ne'] at this
    simpa [mul_comm, mul_left_comm, mul_assoc] using this
  have hfactor0 : 0 ≤ (b - a) * R := mul_nonneg hlen0 hR.le
  have hF : 0 ≤ F := integral_nonneg fun _ => norm_nonneg _
  have hA : 0 ≤ A := integral_nonneg fun _ => norm_nonneg _
  have hD : 0 ≤ D := integral_nonneg fun _ => norm_nonneg _
  have hsecond : (b - a) * R * F * D ≤ F * D := by
    calc
      (b - a) * R * F * D = ((b - a) * R) * (F * D) := by ring
      _ ≤ 1 * (F * D) :=
        mul_le_mul_of_nonneg_right hfactor (mul_nonneg hF hD)
      _ = F * D := by ring
  have hmass : 0 ≤ surfaceMass d := (surfaceMass_pos hd).le
  calc
    (∫ x : Euclidean d,
      ‖sphericalIntervalMaximalRaw a b (dyadicBandpassProjection ψj f) x‖) ≤
        surfaceMass d * (F * A + (b - a) * R * F * D) := by
          simpa only [F, A, D] using hbound
    _ ≤ surfaceMass d * (F * A + F * D) := by
      exact mul_le_mul_of_nonneg_left (add_le_add_right hsecond _) hmass
    _ = (surfaceMass d * (A + D)) * F := by ring

/-- Assemble local `L¹` estimates over a finite radius cover.  The finite
sum is the expected full-cardinality endpoint. -/
theorem unnormalizedFractalDyadicBandpass_memLp_one_of_finite_raw_cover
    {d : ℕ} {ι : Type*} (hd : 0 < d)
    (E : Set ℝ) (ψ : SchwartzMap (Euclidean d) ℂ)
    (s : Finset ι) (hs : s.Nonempty) (a b : ι → ℝ)
    (hcover : E ⊆ ⋃ i ∈ s, Icc (a i) (b i))
    (hEpos : E ⊆ Ioi (0 : ℝ))
    (hinterval : ∀ i ∈ s, Icc (a i) (b i) ⊆ Ioi (0 : ℝ))
    (hab : ∀ i ∈ s, a i ≤ b i)
    (f : SchwartzMap (Euclidean d) ℂ) {B : ℝ}
    (hlocal : ∀ i ∈ s,
      MemLp (sphericalIntervalMaximalRaw (a i) (b i)
        (dyadicBandpassProjection ψ f)) 1 volume ∧
      (∫ x : Euclidean d,
        ‖sphericalIntervalMaximalRaw (a i) (b i)
          (dyadicBandpassProjection ψ f) x‖) ≤
        B * ∫ x : Euclidean d, ‖f x‖) :
    MemLp (unnormalizedFractalDyadicBandpassMaximal d E ψ f) 1 volume ∧
      (∫ x : Euclidean d,
        ‖unnormalizedFractalDyadicBandpassMaximal d E ψ f x‖) ≤
        (s.card : ℝ) * B * ∫ x : Euclidean d, ‖f x‖ := by
  let U : Euclidean d → ℝ := unnormalizedFractalDyadicBandpassMaximal d E ψ f
  let u : ι → Euclidean d → ℝ := fun i =>
    sphericalIntervalMaximalRaw (a i) (b i) (dyadicBandpassProjection ψ f)
  have hUmeas : Measurable U :=
    measurable_unnormalizedFractalDyadicBandpassMaximal E ψ f
  have hUnonneg (x : Euclidean d) : 0 ≤ U x :=
    unnormalizedFractalDyadicBandpassMaximal_nonneg E ψ f x
  have hunonneg : ∀ i ∈ s, ∀ x : Euclidean d, 0 ≤ u i x := by
    intro i hi x
    exact sphericalIntervalMaximalRaw_nonneg (a i) (b i)
      (dyadicBandpassProjection ψ f) x
  have huInt : ∀ i ∈ s, Integrable (u i) volume := by
    intro i hi
    exact (memLp_one_iff_integrable).mp (hlocal i hi).1
  have hle : ∀ x : Euclidean d, U x ≤ s.sup' hs (fun i => u i x) := by
    intro x
    exact surfaceMass_mul_fractalSphericalMaximalReal_le_finset_sup_raw_of_cover
      hd s hs a b hcover hEpos hinterval hab
      (dyadicBandpassProjection ψ f) x
  have hle_sum : ∀ x : Euclidean d, U x ≤ ∑ i ∈ s, u i x := by
    intro x
    apply (hle x).trans
    apply Finset.sup'_le hs (fun i => u i x)
    intro i hi
    exact Finset.single_le_sum (fun k hk => hunonneg k hk x) hi
  have hmain := memLp_one_of_le_finset_sum_of_local_integrable
    s U u hUmeas hUnonneg hunonneg huInt hle_sum
  refine ⟨hmain.1, ?_⟩
  calc
    (∫ x : Euclidean d, ‖U x‖) ≤
        ∑ i ∈ s, ∫ x : Euclidean d, ‖u i x‖ := hmain.2
    _ ≤ ∑ _i ∈ s, B * ∫ x : Euclidean d, ‖f x‖ := by
      apply Finset.sum_le_sum
      intro i hi
      exact hlocal i hi |>.2
    _ = (s.card : ℝ) * B * ∫ x : Euclidean d, ‖f x‖ := by
      simp [nsmul_eq_mul]
      ring

/-- Assemble local `L²` estimates over a finite radius cover.  Keeping the
finite supremum until this point gives the square-function/cardinality loss
used in the Minkowski argument. -/
theorem unnormalizedFractalDyadicBandpass_memLp_two_of_finite_raw_cover
    {d : ℕ} {ι : Type*} (hd : 0 < d)
    (E : Set ℝ) (ψ : SchwartzMap (Euclidean d) ℂ)
    (s : Finset ι) (hs : s.Nonempty) (a b : ι → ℝ)
    (hcover : E ⊆ ⋃ i ∈ s, Icc (a i) (b i))
    (hEpos : E ⊆ Ioi (0 : ℝ))
    (hinterval : ∀ i ∈ s, Icc (a i) (b i) ⊆ Ioi (0 : ℝ))
    (hab : ∀ i ∈ s, a i ≤ b i)
    (f : SchwartzMap (Euclidean d) ℂ) {B : ℝ}
    (hlocal : ∀ i ∈ s,
      MemLp (sphericalIntervalMaximalRaw (a i) (b i)
        (dyadicBandpassProjection ψ f)) 2 volume ∧
      (∫ x : Euclidean d,
        ‖sphericalIntervalMaximalRaw (a i) (b i)
          (dyadicBandpassProjection ψ f) x‖ ^ 2) ≤
        B * ∫ x : Euclidean d, ‖f x‖ ^ 2) :
    MemLp (unnormalizedFractalDyadicBandpassMaximal d E ψ f) 2 volume ∧
      (∫ x : Euclidean d,
        ‖unnormalizedFractalDyadicBandpassMaximal d E ψ f x‖ ^ 2) ≤
        (s.card : ℝ) * B * ∫ x : Euclidean d, ‖f x‖ ^ 2 := by
  let U : Euclidean d → ℝ := unnormalizedFractalDyadicBandpassMaximal d E ψ f
  let u : ι → Euclidean d → ℝ := fun i =>
    sphericalIntervalMaximalRaw (a i) (b i) (dyadicBandpassProjection ψ f)
  have hUmeas : Measurable U :=
    measurable_unnormalizedFractalDyadicBandpassMaximal E ψ f
  have hUnonneg (x : Euclidean d) : 0 ≤ U x :=
    unnormalizedFractalDyadicBandpassMaximal_nonneg E ψ f x
  have hunonneg : ∀ i ∈ s, ∀ x : Euclidean d, 0 ≤ u i x := by
    intro i hi x
    exact sphericalIntervalMaximalRaw_nonneg (a i) (b i)
      (dyadicBandpassProjection ψ f) x
  have humeas : ∀ i ∈ s, Measurable (u i) := by
    intro i hi
    exact sphericalIntervalMaximalRaw_measurable (dyadicBandpassProjection ψ f)
  have huInt : ∀ i ∈ s, Integrable (fun x => (u i x) ^ (2 : ℕ)) volume := by
    intro i hi
    have h := (memLp_two_iff_integrable_sq_norm (humeas i hi).aestronglyMeasurable).mp
      (hlocal i hi).1
    have heq : (fun x : Euclidean d => (u i x) ^ (2 : ℕ)) =
        fun x => ‖u i x‖ ^ (2 : ℕ) := by
      funext x
      rw [Real.norm_of_nonneg (hunonneg i hi x)]
    rw [heq]
    exact h
  have hle : ∀ x : Euclidean d, U x ≤ s.sup' hs (fun i => u i x) := by
    intro x
    exact surfaceMass_mul_fractalSphericalMaximalReal_le_finset_sup_raw_of_cover
      hd s hs a b hcover hEpos hinterval hab
      (dyadicBandpassProjection ψ f) x
  have hmain := memLp_two_of_le_finset_sup_of_local_sq
    s hs U u hUmeas hUnonneg hunonneg humeas huInt hle
  refine ⟨hmain.1, ?_⟩
  calc
    (∫ x : Euclidean d, ‖U x‖ ^ (2 : ℕ)) ≤
        ∑ i ∈ s, ∫ x : Euclidean d, (u i x) ^ (2 : ℕ) := hmain.2
    _ ≤ ∑ _i ∈ s, B * ∫ x : Euclidean d, ‖f x‖ ^ (2 : ℕ) := by
      apply Finset.sum_le_sum
      intro i hi
      calc
        (∫ x : Euclidean d, (u i x) ^ (2 : ℕ)) =
            ∫ x : Euclidean d, ‖u i x‖ ^ (2 : ℕ) := by
              apply integral_congr_ae
              filter_upwards with x
              rw [Real.norm_of_nonneg (hunonneg i hi x)]
        _ ≤ _ := (hlocal i hi).2
    _ = (s.card : ℝ) * B * ∫ x : Euclidean d, ‖f x‖ ^ (2 : ℕ) := by
      simp [nsmul_eq_mul]
      ring

/-- Interpolate strong `L¹` and `L²` endpoint estimates for an unnormalised
absolute dyadic maximal piece.  This is the analytic bridge used after the
Minkowski cover has supplied its two endpoint constants. -/
theorem unnormalizedFractalDyadicBandpass_lintegral_of_one_two
    {d : ℕ} (hd : 0 < d) {E : Set ℝ} (hE : E ⊆ Ioi (0 : ℝ))
    (ψ : SchwartzMap (Euclidean d) ℂ) {c₁ c₂ : ℝ}
    (hc₁ : 0 ≤ c₁) (hc₂ : 0 ≤ c₂)
    (hone : ∀ g : SchwartzMap (Euclidean d) ℂ,
      MemLp (unnormalizedFractalDyadicBandpassMaximal d E ψ g) 1 volume ∧
        (∫ x : Euclidean d,
          ‖unnormalizedFractalDyadicBandpassMaximal d E ψ g x‖) ≤
          c₁ * ∫ x : Euclidean d, ‖g x‖)
    (htwo : ∀ g : SchwartzMap (Euclidean d) ℂ,
      MemLp (unnormalizedFractalDyadicBandpassMaximal d E ψ g) 2 volume ∧
        (∫ x : Euclidean d,
          ‖unnormalizedFractalDyadicBandpassMaximal d E ψ g x‖ ^ (2 : ℕ)) ≤
          c₂ * ∫ x : Euclidean d, ‖g x‖ ^ (2 : ℕ))
    {p : ℝ} (hp1 : 1 < p) (hp2 : p < 2)
    (f : SchwartzMap (Euclidean d) ℂ) (s : ℝ) (hs : 0 < s) :
    (∫⁻ x, ENNReal.ofReal
      ((unnormalizedFractalDyadicBandpassMaximal d E ψ f x) ^ p)) ≤
      ENNReal.ofReal p *
        (4 * ENNReal.ofReal c₂ *
            ((ENNReal.ofReal s) ^ (2 - p) *
              ((ENNReal.ofReal ((1 : ℝ) / 4) * (ENNReal.ofReal p)⁻¹ +
                (ENNReal.ofReal (2 - p))⁻¹) *
                  (∫⁻ x, (ENNReal.ofReal ‖(f : Euclidean d → ℂ) x‖) ^ p))) +
          2 * ENNReal.ofReal c₁ *
            ((ENNReal.ofReal s) ^ (1 - p) *
              (((ENNReal.ofReal (p - 1))⁻¹ +
                (ENNReal.ofReal (3 - p))⁻¹) *
                  (∫⁻ x, (ENNReal.ofReal ‖(f : Euclidean d → ℂ) x‖) ^ p)))) := by
  let T : SchwartzMap (Euclidean d) ℂ → Euclidean d → ℝ :=
    unnormalizedFractalDyadicBandpassMaximal d E ψ
  refine schwartz_marcinkiewicz_one_two_scaled_lintegral T
    ?_ ?_ c₁ c₂ hc₁ hc₂ ?_ ?_ ?_ ?_ hp1 hp2 f ?_ s hs
  · intro g x
    exact unnormalizedFractalDyadicBandpassMaximal_nonneg E ψ g x
  · intro g h x
    exact unnormalizedFractalDyadicBandpassMaximal_add_le hd E hE ψ g h x
  · intro g
    exact (hone g).1
  · intro g
    have hrewrite :
        (∫ x : Euclidean d, T g x) =
          ∫ x : Euclidean d, ‖T g x‖ := by
      apply integral_congr_ae
      filter_upwards with x
      rw [Real.norm_of_nonneg
        (unnormalizedFractalDyadicBandpassMaximal_nonneg E ψ g x)]
    rw [hrewrite]
    exact (hone g).2
  · intro g
    exact (htwo g).1
  · intro g
    have hrewrite :
        (∫ x : Euclidean d, (T g x) ^ (2 : ℕ)) =
          ∫ x : Euclidean d, ‖T g x‖ ^ (2 : ℕ) := by
      apply integral_congr_ae
      filter_upwards with x
      rw [Real.norm_of_nonneg
        (unnormalizedFractalDyadicBandpassMaximal_nonneg E ψ g x)]
    rw [hrewrite]
    exact (htwo g).2
  · exact (measurable_unnormalizedFractalDyadicBandpassMaximal E ψ f).aemeasurable

/-- The two finite-cover endpoint estimates for one absolute dyadic piece.
The radius cover is clipped to `[1,2]`, so the local Fourier estimates apply
without any boundary extension. -/
theorem absolute_dyadic_minkowski_endpoints_of_cover
    {n : ℕ} (hn : 2 ≤ n)
    (C0 C1 : ℝ) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ xi : Euclidean (n + 1), 1 ≤ ‖xi‖ →
      ‖surfaceFourier (n + 1) xi‖ ≤ C0 / ‖xi‖ ^ ((n : ℝ) / 2))
    (hderiv : ∀ xi : Euclidean (n + 1), ∀ r : ℝ, 1 ≤ ‖xi‖ →
      r ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun t : ℝ => surfaceFourier (n + 1) (t • xi)) r‖ ≤
        C1 / ‖xi‖ ^ ((n : ℝ) / 2 - 1))
    {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    {R δ α C : ℝ} (hR : 0 < R) (hRone : 1 ≤ R)
    (hδ : 0 < δ) (hδone : δ < 1) (hδR : δ ≤ R⁻¹)
    (ι : Finset ℝ) (hcover : IsIntervalCover E δ ι)
    (hcard : (ι.card : ℝ) ≤ C * δ ^ (-α))
    (phi f psi ψj : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : ℕ)
    (hψj : ∀ xi : Euclidean (n + 1),
      ψj xi = phi (((2 : ℝ) ^ (j + 1))⁻¹ • xi) -
        phi (((2 : ℝ) ^ j)⁻¹ • xi))
    (hψj_compact : HasCompactSupport (ψj : Euclidean (n + 1) → ℂ))
    (hRscale : dyadicScale j = R)
    (hψscale : ∀ xi : Euclidean (n + 1), ψj xi = psi (R⁻¹ • xi)) :
    let B1 : ℝ := surfaceMass (n + 1) *
      ((∫ x : Euclidean (n + 1), ‖(𝓕⁻ psi : SchwartzMap (Euclidean (n + 1)) ℂ) x‖) +
        ∫ x : Euclidean (n + 1),
          ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean (n + 1)) ℂ) :
            Euclidean (n + 1) → ℂ) x‖)
    let B2 : ℝ := 8 * C0 ^ 2 + 8 * C1 ^ 2
    MemLp (unnormalizedFractalDyadicBandpassMaximal (n + 1) E ψj f) 1 volume ∧
      (∫ x : Euclidean (n + 1),
        ‖unnormalizedFractalDyadicBandpassMaximal (n + 1) E ψj f x‖) ≤
        (C * δ ^ (-α)) * B1 * ∫ x : Euclidean (n + 1), ‖f x‖ ∧
      MemLp (unnormalizedFractalDyadicBandpassMaximal (n + 1) E ψj f) 2 volume ∧
      (∫ x : Euclidean (n + 1),
        ‖unnormalizedFractalDyadicBandpassMaximal (n + 1) E ψj f x‖ ^ (2 : ℕ)) ≤
        (C * δ ^ (-α)) * (B2 * R ^ (-(n : ℝ))) *
          ∫ x : Euclidean (n + 1), ‖f x‖ ^ (2 : ℕ) := by
  classical
  dsimp only
  let s : Finset ℝ := clippedActiveCenters δ ι
  let a : ℝ → ℝ := fun c => max 1 (c - δ / 2)
  let b : ℝ → ℝ := fun c => min 2 (c + δ / 2)
  have hclipcover : E ⊆ ⋃ c ∈ s, Icc (a c) (b c) := by
    simpa only [s, a, b, clippedCoverInterval] using hcover.clippedActiveCover hE
  have hs : s.Nonempty := by
    rcases hEne with ⟨r, hr⟩
    rcases Set.mem_iUnion.mp (hclipcover hr) with ⟨c, hc⟩
    rcases Set.mem_iUnion.mp hc with ⟨hcs, _⟩
    exact ⟨c, hcs⟩
  have hEpos : E ⊆ Ioi (0 : ℝ) := by
    intro r hr
    exact lt_of_lt_of_le zero_lt_one (hE hr).1
  have hinterval : ∀ c ∈ s, Icc (a c) (b c) ⊆ Ioi (0 : ℝ) := by
    intro c hc r hr
    have hr' : r ∈ clippedCoverInterval c δ := by
      simpa only [a, b, clippedCoverInterval] using hr
    exact lt_of_lt_of_le zero_lt_one (clippedCoverInterval_subset_Icc c δ hr').1
  have hab : ∀ c ∈ s, a c ≤ b c := by
    intro c hc
    have hnonempty : (clippedCoverInterval c δ).Nonempty := by
      apply mem_clippedActiveCenters_interval_nonempty
      simpa only [s] using hc
    rcases hnonempty with ⟨r, hr⟩
    have har : a c ≤ r := by
      simpa only [a, b, clippedCoverInterval] using hr.1
    have hrb : r ≤ b c := by
      simpa only [a, b, clippedCoverInterval] using hr.2
    exact har.trans hrb
  have hlen : ∀ c ∈ s, b c - a c ≤ R⁻¹ := by
    intro c hc
    calc
      b c - a c ≤ δ := by
        simpa only [a, b] using clippedCoverInterval_length_le c δ
      _ ≤ R⁻¹ := hδR
  have hclipinterval : ∀ c ∈ s, Icc (a c) (b c) ⊆ Icc (1 : ℝ) 2 := by
    intro c hc r hr
    exact clippedCoverInterval_subset_Icc c δ (by
      simpa only [a, b, clippedCoverInterval] using hr)
  have hscard : (s.card : ℝ) ≤ C * δ ^ (-α) := by
    calc
      (s.card : ℝ) ≤ (ι.card : ℝ) := by
        exact_mod_cast card_clippedActiveCenters_le δ ι
      _ ≤ C * δ ^ (-α) := hcard
  let B1 : ℝ := surfaceMass (n + 1) *
    ((∫ x : Euclidean (n + 1), ‖(𝓕⁻ psi : SchwartzMap (Euclidean (n + 1)) ℂ) x‖) +
      ∫ x : Euclidean (n + 1),
        ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean (n + 1)) ℂ) :
          Euclidean (n + 1) → ℂ) x‖)
  let B2 : ℝ := 8 * C0 ^ 2 + 8 * C1 ^ 2
  have hB1 : 0 ≤ B1 := by
    dsimp only [B1]
    apply mul_nonneg (surfaceMass_pos (by omega)).le
    exact add_nonneg
      (integral_nonneg fun _ => norm_nonneg _)
      (integral_nonneg fun _ => norm_nonneg _)
  have hB2 : 0 ≤ B2 := by
    dsimp only [B2]
    positivity
  have hRpow : 0 ≤ R ^ (-(n : ℝ)) := Real.rpow_nonneg hR.le _
  have hI1 : 0 ≤ ∫ x : Euclidean (n + 1), ‖f x‖ :=
    integral_nonneg fun _ => norm_nonneg _
  have hI2 : 0 ≤ ∫ x : Euclidean (n + 1), ‖f x‖ ^ (2 : ℕ) :=
    integral_nonneg fun _ => sq_nonneg _
  have hl1local : ∀ c ∈ s,
      MemLp (sphericalIntervalMaximalRaw (a c) (b c)
        (dyadicBandpassProjection ψj f)) 1 volume ∧
      (∫ x : Euclidean (n + 1),
        ‖sphericalIntervalMaximalRaw (a c) (b c)
          (dyadicBandpassProjection ψj f) x‖) ≤
        B1 * ∫ x : Euclidean (n + 1), ‖f x‖ := by
    intro c hc
    simpa only [B1] using
      sphericalIntervalMaximalRaw_l1_uniform_of_scaled
        (d := n + 1) (by omega) psi ψj f hR (hab c hc) (hlen c hc) hψscale
  have hl2local : ∀ c ∈ s,
      MemLp (sphericalIntervalMaximalRaw (a c) (b c)
        (dyadicBandpassProjection ψj f)) 2 volume ∧
      (∫ x : Euclidean (n + 1),
        ‖sphericalIntervalMaximalRaw (a c) (b c)
          (dyadicBandpassProjection ψj f) x‖ ^ (2 : ℕ)) ≤
        (B2 * R ^ (-(n : ℝ))) * ∫ x : Euclidean (n + 1), ‖f x‖ ^ (2 : ℕ) := by
    intro c hc
    rcases sphericalIntervalMaximalRaw_memLp_two_of_sharp
      hn C0 C1 hC0 hC1 hdecay hderiv phi f ψj hphi_one hphi_zero hphi_norm
      j hψj hψj_compact (hab c hc) (hclipinterval c hc) with ⟨hmem, hbound⟩
    refine ⟨hmem, hbound.trans ?_⟩
    apply mul_le_mul_of_nonneg_right
      (by
        simpa only [hRscale, B2] using
          (short_interval_l2_coefficient_le_frequency_decay hn C0 C1 hC0.le hC1.le
            hR hRone (sub_nonneg.mpr (hab c hc)) (hlen c hc)))
      hI2
  rcases unnormalizedFractalDyadicBandpass_memLp_one_of_finite_raw_cover
    (d := n + 1) (ι := ℝ) (by omega) E ψj s hs a b hclipcover hEpos hinterval hab
    f hl1local with ⟨hmem1, hbound1⟩
  rcases unnormalizedFractalDyadicBandpass_memLp_two_of_finite_raw_cover
    (d := n + 1) (ι := ℝ) (by omega) E ψj s hs a b hclipcover hEpos hinterval hab
    f hl2local with ⟨hmem2, hbound2⟩
  refine ⟨hmem1, ?_, hmem2, ?_⟩
  · calc
      (∫ x : Euclidean (n + 1),
        ‖unnormalizedFractalDyadicBandpassMaximal (n + 1) E ψj f x‖) ≤
          (s.card : ℝ) * B1 * ∫ x : Euclidean (n + 1), ‖f x‖ := hbound1
      _ ≤ (C * δ ^ (-α)) * B1 * ∫ x : Euclidean (n + 1), ‖f x‖ := by
        apply mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_right hscard hB1)
          hI1
  · calc
      (∫ x : Euclidean (n + 1),
        ‖unnormalizedFractalDyadicBandpassMaximal (n + 1) E ψj f x‖ ^ (2 : ℕ)) ≤
          (s.card : ℝ) * (B2 * R ^ (-(n : ℝ))) *
            ∫ x : Euclidean (n + 1), ‖f x‖ ^ (2 : ℕ) := hbound2
      _ ≤ (C * δ ^ (-α)) * (B2 * R ^ (-(n : ℝ))) *
            ∫ x : Euclidean (n + 1), ‖f x‖ ^ (2 : ℕ) := by
        apply mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_right hscard (mul_nonneg hB2 hRpow))
          hI2

end

end LeanSpherical.HarmonicAnalysis.FractalDilations
