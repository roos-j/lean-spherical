        ∫⁻ x, ENNReal.ofReal (G x ^ p.toReal) ∂volume := by
      apply lintegral_congr
      intro x
      rw [Real.enorm_eq_ofReal (hG0 x),
        ENNReal.ofReal_rpow_of_nonneg (hG0 x) ENNReal.toReal_nonneg]
    _ ≤ A := hA

private theorem restrictedSphericalMaximal_le_liminf_of_trunc_majorants
    {d : ℕ} {E : Set ℝ} (f : (ℝ^d) → ℂ) (G : ℕ → (ℝ^d) → ℝ)
    (hGmeas : ∀ n, Measurable (G n))
    (hGbound : ∀ (n : ℕ) x, G n x ≤ (n : ℝ))
    (hGnonneg : ∀ (n : ℕ) x, 0 ≤ G n x)
    (hGmajor : ∀ (n : ℕ) x, min ‖f x‖ (n : ℝ) ≤ G n x) (x : ℝ^d) :
    M E f x ≤ atTop.liminf (fun n => M E (fun y => (G n y : ℂ)) x) := by
  unfold M restrictedSphericalMaximal
  calc
    ⨆ t ∈ E ∩ Ioi (0 : ℝ), ENNReal.ofReal ‖sphericalAverage t f x‖ ≤
        ⨆ t ∈ E ∩ Ioi (0 : ℝ), atTop.liminf (fun n : ℕ =>
          ENNReal.ofReal ‖sphericalAverage t
            (fun y => ((min ‖f y‖ n : ℝ) : ℂ)) x‖) := by
      apply iSup_mono
      intro t
      apply iSup_mono
      intro ht
      exact ofReal_le_liminf_of_nonneg (norm_nonneg _)
        (fun n => norm_nonneg _) (norm_sphericalAverage_le_liminf_norm_trunc f t x)
    _ = ⨆ t : ↥(E ∩ Ioi (0 : ℝ)), atTop.liminf (fun n : ℕ =>
          ENNReal.ofReal ‖sphericalAverage t.1
            (fun y => ((min ‖f y‖ n : ℝ) : ℂ)) x‖) := by
      rw [iSup_subtype']
    _ ≤ atTop.liminf (fun n : ℕ => ⨆ t : ↥(E ∩ Ioi (0 : ℝ)),
          ENNReal.ofReal ‖sphericalAverage t.1
            (fun y => ((min ‖f y‖ n : ℝ) : ℂ)) x‖) :=
      Filter.iSup_liminf_le_liminf_iSup
    _ ≤ atTop.liminf (fun n : ℕ => ⨆ t : ↥(E ∩ Ioi (0 : ℝ)),
          ENNReal.ofReal ‖sphericalAverage t.1 (fun y => (G n y : ℂ)) x‖) := by
      refine Filter.liminf_le_liminf ?_ (by isBoundedDefault) (by isBoundedDefault)
      filter_upwards with n
      apply iSup_mono
      intro t
      exact ENNReal.ofReal_le_ofReal
        (norm_sphericalAverage_le_of_norm_le_bounded_measurable (hGmeas n)
          (fun y => by
            rw [Real.norm_eq_abs, abs_of_nonneg (hGnonneg n y)]
            exact hGbound n y)
          (hGnonneg n) (fun y => by
            rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg]
            · exact hGmajor n y
            · exact le_min (norm_nonneg _) (Nat.cast_nonneg _)) t.1 x)
    _ = atTop.liminf (fun n : ℕ => M E (fun y => (G n y : ℂ)) x) := by
      congr with n
      unfold M restrictedSphericalMaximal
      rw [iSup_subtype]


private theorem eLpNorm_liminf_le_of_uniform {α : Type*} [MeasurableSpace α]
    {μ : Measure α} {p : ℝ≥0∞} (hp0 : p ≠ 0) (hptop : p ≠ ∞)
    {F : ℕ → α → ℝ≥0∞} {K : ℝ≥0∞}
    (hmeas : ∀ n, Measurable (F n))
    (hbound : ∀ n, eLpNorm (F n) p μ ≤ K) :
    eLpNorm (fun x => atTop.liminf (fun n => F n x)) p μ ≤ K := by
  have hq : 0 < p.toReal := ENNReal.toReal_pos hp0 hptop
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop]
  have hpow_liminf (x : α) :
      (atTop.liminf (fun n => F n x)) ^ p.toReal =
        atTop.liminf (fun n => (F n x) ^ p.toReal) := by
    let e : ℝ≥0∞ ≃o ℝ≥0∞ := ENNReal.orderIsoRpow p.toReal hq
    change e (atTop.liminf (fun n => F n x)) =
      atTop.liminf (fun n => e (F n x))
    exact OrderIso.liminf_apply e (by isBoundedDefault) (by isBoundedDefault)
      (by isBoundedDefault) (by isBoundedDefault)
  have hIntegral : ∫⁻ x, ‖atTop.liminf (fun n => F n x)‖ₑ ^ p.toReal ∂μ ≤
      K ^ p.toReal := by
    calc
      ∫⁻ x, ‖atTop.liminf (fun n => F n x)‖ₑ ^ p.toReal ∂μ =
          ∫⁻ x, atTop.liminf (fun n => (F n x) ^ p.toReal) ∂μ := by
        simp_rw [enorm_eq_self, hpow_liminf]
      _ ≤ atTop.liminf (fun n => ∫⁻ x, (F n x) ^ p.toReal ∂μ) := by
        apply lintegral_liminf_le'
        intro n
        exact (ENNReal.continuous_rpow_const.measurable.comp (hmeas n)).aemeasurable
      _ ≤ K ^ p.toReal := by
        apply liminf_le_of_le (by isBoundedDefault)
        intro b hb
        obtain ⟨n, hn⟩ := hb.exists
        have hn' := hbound n
        rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop] at hn'
        have hpow := ENNReal.rpow_le_rpow hn' hq.le
        rw [show 1 / p.toReal = (p.toReal)⁻¹ by ring] at hpow
        rw [ENNReal.rpow_inv_rpow hq.ne'] at hpow
        simpa only [enorm_eq_self] using hn.trans hpow
  calc
    (∫⁻ x, ‖atTop.liminf (fun n => F n x)‖ₑ ^ p.toReal ∂μ) ^
        (1 / p.toReal) ≤ (K ^ p.toReal) ^ (1 / p.toReal) :=
      ENNReal.rpow_le_rpow hIntegral (by positivity)
    _ = K := by
      rw [show 1 / p.toReal = (p.toReal)⁻¹ by ring]
      exact ENNReal.rpow_rpow_inv hq.ne' K

private theorem eLpNorm_liminf_le_liminf
    {α : Type*} [MeasurableSpace α] {μ : Measure α} {p : ℝ≥0∞}
    (hp0 : p ≠ 0) (hptop : p ≠ ∞)
    {F : ℕ → α → ℝ≥0∞}
    (hmeas : ∀ n, Measurable (F n)) :
    eLpNorm (fun x => atTop.liminf (fun n => F n x)) p μ ≤
      atTop.liminf (fun n => eLpNorm (F n) p μ) := by
  have hq : 0 < p.toReal := ENNReal.toReal_pos hp0 hptop
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop]
  have hpow_liminf (x : α) :
      (atTop.liminf (fun n => F n x)) ^ p.toReal =
        atTop.liminf (fun n => (F n x) ^ p.toReal) := by
    let e : ℝ≥0∞ ≃o ℝ≥0∞ := ENNReal.orderIsoRpow p.toReal hq
    change e (atTop.liminf (fun n => F n x)) =
      atTop.liminf (fun n => e (F n x))
    exact OrderIso.liminf_apply e (by isBoundedDefault) (by isBoundedDefault)
      (by isBoundedDefault) (by isBoundedDefault)
  have hIntegral : ∫⁻ x, ‖atTop.liminf (fun n => F n x)‖ₑ ^ p.toReal ∂μ ≤
      atTop.liminf (fun n => ∫⁻ x, (F n x) ^ p.toReal ∂μ) := by
    calc
      ∫⁻ x, ‖atTop.liminf (fun n => F n x)‖ₑ ^ p.toReal ∂μ =
          ∫⁻ x, atTop.liminf (fun n => (F n x) ^ p.toReal) ∂μ := by
        simp_rw [enorm_eq_self, hpow_liminf]
      _ ≤ atTop.liminf (fun n => ∫⁻ x, (F n x) ^ p.toReal ∂μ) := by
        apply lintegral_liminf_le'
        intro n
        exact (ENNReal.continuous_rpow_const.measurable.comp (hmeas n)).aemeasurable
  calc
    (∫⁻ x, ‖atTop.liminf (fun n => F n x)‖ₑ ^ p.toReal ∂μ) ^
        (1 / p.toReal) ≤
        (atTop.liminf (fun n => ∫⁻ x, (F n x) ^ p.toReal ∂μ)) ^
          (1 / p.toReal) := ENNReal.rpow_le_rpow hIntegral (by positivity)
    _ = atTop.liminf (fun n =>
        (∫⁻ x, (F n x) ^ p.toReal ∂μ) ^ (1 / p.toReal)) := by
      let e : ℝ≥0∞ ≃o ℝ≥0∞ :=
        ENNReal.orderIsoRpow (1 / p.toReal) (by positivity)
      change e (atTop.liminf (fun n => ∫⁻ x, (F n x) ^ p.toReal ∂μ)) =
        atTop.liminf (fun n => e (∫⁻ x, (F n x) ^ p.toReal ∂μ))
      exact OrderIso.liminf_apply e (by isBoundedDefault) (by isBoundedDefault)
        (by isBoundedDefault) (by isBoundedDefault)
    _ = atTop.liminf (fun n => eLpNorm (F n) p μ) := by
      congr 1
      funext n
      rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop]
      simp only [enorm_eq_self]

private theorem eLpNorm_le_of_ae_le_liminf_of_uniform {α : Type*} [MeasurableSpace α]
    {μ : Measure α} {p : ℝ≥0∞} (hp0 : p ≠ 0) (hptop : p ≠ ∞)
    {F : α → ℝ≥0∞} {G : ℕ → α → ℝ≥0∞} {K : ℝ≥0∞}
    (hle : ∀ᵐ x ∂μ, F x ≤ atTop.liminf (fun n => G n x))
    (hmeas : ∀ n, Measurable (G n))
    (hbound : ∀ n, eLpNorm (G n) p μ ≤ K) :
    eLpNorm F p μ ≤ K := by
  calc
    eLpNorm F p μ ≤ eLpNorm (fun x => atTop.liminf (fun n => G n x)) p μ :=
      eLpNorm_mono_enorm_ae (hle.mono fun x hx => by
        simpa only [enorm_eq_self] using hx)
    _ ≤ K := eLpNorm_liminf_le_of_uniform hp0 hptop hmeas hbound

private def smoothPos (ε z : ℝ) : ℝ :=
  z * Real.smoothTransition (z / ε)

private theorem smoothPos_nonneg {ε z : ℝ} (hε : 0 < ε) :
    0 ≤ smoothPos ε z := by
  by_cases hz : z ≤ 0
  · rw [show smoothPos ε z = 0 by
      simp [smoothPos, Real.smoothTransition.zero_of_nonpos
        (div_nonpos_of_nonpos_of_nonneg hz hε.le)]]
  · exact mul_nonneg (le_of_lt (lt_of_not_ge hz))
      (Real.smoothTransition.nonneg _)

private theorem smoothPos_le_max {ε z : ℝ} (hε : 0 < ε) :
    smoothPos ε z ≤ max 0 z := by
  by_cases hz : z ≤ 0
  · rw [show smoothPos ε z = 0 by
      simp [smoothPos, Real.smoothTransition.zero_of_nonpos
        (div_nonpos_of_nonpos_of_nonneg hz hε.le)], max_eq_left hz]
  · rw [max_eq_right (le_of_lt (lt_of_not_ge hz))]
    exact mul_le_of_le_one_right (lt_of_not_ge hz).le
      (Real.smoothTransition.le_one _)

private theorem max_le_smoothPos_add {ε z : ℝ} (hε : 0 < ε) :
    max 0 z ≤ smoothPos ε z + ε := by
  by_cases hz : z ≤ 0
  · rw [max_eq_left hz]
    linarith [smoothPos_nonneg hε (z := z)]
  · rw [max_eq_right (le_of_lt (lt_of_not_ge hz))]
    by_cases hze : ε ≤ z
    · have hdiv : 1 ≤ z / ε := (le_div_iff₀ hε).2 (by simpa using hze)
      rw [smoothPos, Real.smoothTransition.one_of_one_le hdiv]
      linarith
    · have hlt : z < ε := lt_of_not_ge hze
      linarith [smoothPos_nonneg hε (z := z)]

private theorem contDiff_smoothPos {ε : ℝ} (_ : ε ≠ 0) :
    ContDiff ℝ (⊤ : ℕ∞) (smoothPos ε) := by
  exact contDiff_id.mul
    (Real.smoothTransition.contDiff.comp (contDiff_id.div_const ε))

private theorem exists_smooth_minorant_of_continuous_compact
    {d : ℕ} (c : EuclideanSpace ℝ (Fin d) → ℝ) (hc : Continuous c)
    (hcsupp : HasCompactSupport c) (hc0 : ∀ x, 0 ≤ c x)
    {ε : ℝ} (hε : 0 < ε) :
    ∃ w : EuclideanSpace ℝ (Fin d) → ℝ,
      HasCompactSupport w ∧ ContDiff ℝ (⊤ : ℕ∞) w ∧
        (∀ x, 0 ≤ w x) ∧ (∀ x, w x ≤ c x) ∧
          ∀ x, c x ≤ w x + 3 * ε := by
  have huc : UniformContinuous c :=
    hc.uniformContinuous_of_tendsto_cocompact hcsupp.is_zero_at_infty
  obtain ⟨v, hv, hvclose⟩ := huc.exists_contDiff_dist_le hε
  let w : EuclideanSpace ℝ (Fin d) → ℝ := fun x => smoothPos ε (v x - ε)
  have hvupper (x : EuclideanSpace ℝ (Fin d)) : v x - ε < c x := by
    have h := hvclose x
    rw [Real.dist_eq] at h
    linarith [le_abs_self (v x - c x)]
  have hvlower (x : EuclideanSpace ℝ (Fin d)) : c x - ε < v x := by
    have h := hvclose x
    rw [Real.dist_eq] at h
    linarith [neg_le_abs (v x - c x)]
  refine ⟨w, ?_, ?_, ?_, ?_, ?_⟩
  · apply hcsupp.mono
    intro x hx
    by_contra hxc
    have hczero : c x = 0 := by
      rw [← Function.notMem_support]
      exact hxc
    have hneg : v x - ε < 0 := by linarith [hvupper x]
    have hwzero : w x = 0 := by
      change (v x - ε) * Real.smoothTransition ((v x - ε) / ε) = 0
      rw [Real.smoothTransition.zero_of_nonpos
        (div_nonpos_of_nonpos_of_nonneg hneg.le hε.le)]
      ring
    exact hx hwzero
  · exact (contDiff_smoothPos hε.ne').comp (hv.sub contDiff_const)
  · intro x
    exact smoothPos_nonneg hε
  · intro x
    calc
      w x ≤ max 0 (v x - ε) := smoothPos_le_max hε
      _ ≤ c x := by
        rw [max_le_iff]
        exact ⟨hc0 x, le_of_lt (hvupper x)⟩
  · intro x
    have hpos : max 0 (v x - ε) ≤ w x + ε := max_le_smoothPos_add hε
    have haux : c x ≤ max 0 (v x - ε) + 2 * ε := by
      by_cases hcx : c x ≤ 2 * ε
      · have : 0 ≤ max 0 (v x - ε) := le_max_left _ _
        linarith
      · rw [max_eq_right]
        · linarith [hvlower x]
        · linarith [hvlower x, hcx]
    linarith

private def lowerEnvelope {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (G : X → ℝ) (n : ℕ) (x : X) : ℝ :=
  ⨅ y : X, G y + (n : ℝ) * dist x y

private theorem lowerEnvelope_bddBelow {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (G : X → ℝ) (hG0 : ∀ x, 0 ≤ G x)
    (n : ℕ) (x : X) :
    BddBelow (range fun y : X => G y + (n : ℝ) * dist x y) := by
  refine ⟨0, ?_⟩
  rintro z ⟨y, rfl⟩
  exact add_nonneg (hG0 y) (mul_nonneg (Nat.cast_nonneg _) dist_nonneg)

private theorem lowerEnvelope_nonneg {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (G : X → ℝ) (hG0 : ∀ x, 0 ≤ G x)
    (n : ℕ) (x : X) : 0 ≤ lowerEnvelope G n x := by
  unfold lowerEnvelope
  apply le_ciInf
  intro y
  exact add_nonneg (hG0 y) (mul_nonneg (Nat.cast_nonneg _) dist_nonneg)

private theorem lowerEnvelope_le {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (G : X → ℝ) (hG0 : ∀ x, 0 ≤ G x)
    (n : ℕ) (x : X) : lowerEnvelope G n x ≤ G x := by
  unfold lowerEnvelope
  simpa using ciInf_le (lowerEnvelope_bddBelow G hG0 n x) x

private theorem lowerEnvelope_lipschitz {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (G : X → ℝ) (hG0 : ∀ x, 0 ≤ G x)
    (n : ℕ) : LipschitzWith (n : NNReal) (lowerEnvelope G n) := by
  apply LipschitzWith.of_le_add_mul
  intro x y
  unfold lowerEnvelope
  have hmono :
      (⨅ z : X, G z + (n : ℝ) * dist x z) ≤
        (⨅ z : X, G z + (n : ℝ) * dist y z + (n : ℝ) * dist x y) := by
    apply ciInf_mono (lowerEnvelope_bddBelow G hG0 n x)
    intro z
    calc
      G z + (n : ℝ) * dist x z ≤
          G z + (n : ℝ) * (dist y z + dist x y) := by
            gcongr
            calc
              dist x z ≤ dist x y + dist y z := dist_triangle _ _ _
              _ = dist y z + dist x y := by ring
      _ = G z + (n : ℝ) * dist y z + (n : ℝ) * dist x y := by ring
  have hadd :
      (⨅ z : X, G z + (n : ℝ) * dist y z + (n : ℝ) * dist x y) =
        (⨅ z : X, G z + (n : ℝ) * dist y z) + (n : ℝ) * dist x y := by
    refine (Monotone.map_ciInf_of_continuousAt
      (f := fun u : ℝ => u + (n : ℝ) * dist x y)
      (g := fun z : X => G z + (n : ℝ) * dist y z) ?_ ?_ ?_).symm
    · exact continuousAt_id.add continuousAt_const
    · intro a b hab
      simpa [add_comm] using add_le_add_right hab ((n : ℝ) * dist x y)
    · exact lowerEnvelope_bddBelow G hG0 n y
  simpa using hmono.trans_eq hadd

private theorem lowerEnvelope_continuous {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (G : X → ℝ) (hG0 : ∀ x, 0 ≤ G x)
    (n : ℕ) : Continuous (lowerEnvelope G n) :=
  (lowerEnvelope_lipschitz G hG0 n).continuous

private theorem eventually_lt_lowerEnvelope_of_lt {X : Type*} [NormedAddCommGroup X]
    [NormedSpace ℝ X]
    (G : X → ℝ) (hG0 : ∀ x, 0 ≤ G x) {B : ℝ} (hGB : ∀ x, G x ≤ B)
    (hG : LowerSemicontinuous G) (x : X) {a : ℝ} (ha : a < G x) :
    ∀ᶠ n : ℕ in atTop, a < lowerEnvelope G n x := by
  obtain ⟨b, hab, hb⟩ := exists_between ha
  obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.mp (hG.isOpen_preimage b) x hb
  obtain ⟨N, hN⟩ : ∃ N : ℕ, B / δ < N := exists_nat_gt (B / δ)
  filter_upwards [eventually_ge_atTop N] with n hn
  have hncast : (N : ℝ) ≤ n := by exact_mod_cast hn
  have hnreal : B / δ < (n : ℝ) := hN.trans_le hncast
  have hndelta : B < (n : ℝ) * δ := (div_lt_iff₀ hδ).mp hnreal
  unfold lowerEnvelope
  refine lt_of_lt_of_le hab (le_ciInf fun y => ?_)
  by_cases hy : y ∈ Metric.ball x δ
  · exact (hball hy).le.trans (le_add_of_nonneg_right
      (mul_nonneg (Nat.cast_nonneg _) dist_nonneg))
  · have hdist : δ ≤ dist x y := by
      apply le_of_not_gt
      intro hlt
      apply hy
      rw [Metric.mem_ball]
      simpa [dist_comm] using hlt
    have hbB : b ≤ B := hb.le.trans (hGB x)
    exact (calc
      b ≤ B := hbB
      _ < (n : ℝ) * δ := hndelta
      _ ≤ G y + (n : ℝ) * dist x y := by
        simpa using add_le_add (hG0 y)
          (mul_le_mul_of_nonneg_left hdist (Nat.cast_nonneg n))).le

private theorem exists_schwartz_minorants_of_bounded_lsc
    {d : ℕ} (G : EuclideanSpace ℝ (Fin d) → ℝ) (hG0 : ∀ x, 0 ≤ G x)
    {B : ℝ} (hGB : ∀ x, G x ≤ B) (hG : LowerSemicontinuous G) :
    ∃ ψ : ℕ → SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ,
      (∀ n x, ψ n x = ((ψ n x).re : ℂ)) ∧
      (∀ n x, 0 ≤ (ψ n x).re) ∧
      (∀ n x, (ψ n x).re ≤ G x) ∧
      ∀ x, Tendsto (fun n => (ψ n x).re) atTop (𝓝 (G x)) := by
  let L : ℕ → EuclideanSpace ℝ (Fin d) → ℝ := lowerEnvelope G
  let b : ℕ → ContDiffBump (0 : EuclideanSpace ℝ (Fin d)) := fun n =>
    ⟨(n : ℝ) + 1, (n : ℝ) + 2, by positivity, by linarith⟩
  let c : ℕ → EuclideanSpace ℝ (Fin d) → ℝ := fun n x => b n x * L n x
  have hL0 (n : ℕ) (x : EuclideanSpace ℝ (Fin d)) : 0 ≤ L n x :=
    lowerEnvelope_nonneg G hG0 n x
  have hLle (n : ℕ) (x : EuclideanSpace ℝ (Fin d)) : L n x ≤ G x :=
    lowerEnvelope_le G hG0 n x
  have hLcont (n : ℕ) : Continuous (L n) :=
    lowerEnvelope_continuous G hG0 n
  have hLtend (x : EuclideanSpace ℝ (Fin d)) :
      Tendsto (fun n => L n x) atTop (𝓝 (G x)) := by
    apply tendsto_order.2
    constructor
    · intro a ha
      exact eventually_lt_lowerEnvelope_of_lt G hG0 hGB hG x ha
    · intro a ha
      filter_upwards with n
      exact (hLle n x).trans_lt ha
  have hb_tend (x : EuclideanSpace ℝ (Fin d)) :
      Tendsto (fun n => b n x) atTop (𝓝 1) := by
    apply tendsto_nhds_of_eventually_eq
    obtain ⟨N, hN⟩ : ∃ N : ℕ, ‖x‖ ≤ (N : ℝ) := exists_nat_ge ‖x‖
    filter_upwards [eventually_ge_atTop N] with n hn
    apply (b n).one_of_mem_closedBall
    rw [Metric.mem_closedBall, dist_zero_right]
    change ‖x‖ ≤ (n : ℝ) + 1
    have hnreal : (N : ℝ) ≤ n := by exact_mod_cast hn
    linarith
  have hc0 (n : ℕ) (x : EuclideanSpace ℝ (Fin d)) : 0 ≤ c n x := by
    exact mul_nonneg ((b n).nonneg' x) (hL0 n x)
  have hcle (n : ℕ) (x : EuclideanSpace ℝ (Fin d)) : c n x ≤ G x := by
    change b n x * L n x ≤ G x
    calc
      b n x * L n x ≤ 1 * L n x :=
        mul_le_mul_of_nonneg_right (ContDiffBump.le_one (b n)) (hL0 n x)
      _ = L n x := one_mul _
      _ ≤ G x := hLle n x
  have hccont (n : ℕ) : Continuous (c n) :=
    ((b n).contDiff (n := (⊤ : ℕ∞))).continuous.mul (hLcont n)
  have hcsupp (n : ℕ) : HasCompactSupport (c n) :=
    (b n).hasCompactSupport.mul_right
  have hctend (x : EuclideanSpace ℝ (Fin d)) :
      Tendsto (fun n => c n x) atTop (𝓝 (G x)) := by
    have hmul := (hb_tend x).mul (hLtend x)
    simpa [c] using hmul
  choose w hwsupp hwsmooth hw0 hwle hwerr using fun n =>
    exists_smooth_minorant_of_continuous_compact (c n) (hccont n) (hcsupp n) (hc0 n)
      (by positivity : 0 < 1 / ((n : ℝ) + 1))
  let ψ : ℕ → SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ := fun n =>
    ((hwsupp n).comp_left (g := Complex.ofRealCLM) rfl).toSchwartzMap
      (Complex.ofRealCLM.contDiff.comp (hwsmooth n))
  refine ⟨ψ, ?_, ?_, ?_, ?_⟩
  · intro n x
    simp [ψ]
  · intro n x
    simpa [ψ] using hw0 n x
  · intro n x
    have hψle : (ψ n x).re ≤ c n x := by
      simpa [ψ] using hwle n x
    exact hψle.trans (hcle n x)
  · intro x
    have hε : Tendsto (fun n : ℕ => 3 * (1 / ((n : ℝ) + 1))) atTop (𝓝 0) := by
      simpa using
        (show Tendsto (fun n : ℕ => (3 : ℝ) * (1 / ((n : ℝ) + 1))) atTop
          (𝓝 (3 * 0)) from
          (tendsto_const_nhds.mul tendsto_one_div_add_atTop_nhds_zero_nat))
    have hupper : ∀ n, (ψ n x).re ≤ c n x := fun n => by
      simpa [ψ] using hwle n x
    have hlower : ∀ n, c n x - 3 * (1 / ((n : ℝ) + 1)) ≤ (ψ n x).re := fun n => by
      apply sub_le_iff_le_add.mpr
      simpa [ψ] using hwerr n x
    have hlowt : Tendsto (fun n : ℕ => c n x - 3 * (1 / ((n : ℝ) + 1))) atTop
        (𝓝 (G x)) := by
      simpa using (hctend x).sub hε
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le' hlowt (hctend x)
      (Eventually.of_forall hlower) (Eventually.of_forall hupper)

private theorem restrictedSphericalMaximal_ofReal_le_liminf_schwartz
    {d : ℕ} {E : Set ℝ} {G : (ℝ^d) → ℝ} {B : ℝ}
    (_hG0 : ∀ x, 0 ≤ G x) (hGB : ∀ x, G x ≤ B)
    (ψ : ℕ → SchwartzMap (ℝ^d) ℂ)
    (hreal : ∀ n x, ψ n x = ((ψ n x).re : ℂ))
    (hψ0 : ∀ n x, 0 ≤ (ψ n x).re)
    (hψG : ∀ n x, (ψ n x).re ≤ G x)
    (hψtend : ∀ x, Tendsto (fun n => (ψ n x).re) atTop (𝓝 (G x)))
    (x : ℝ^d) :
    M E (fun y => (G y : ℂ)) x ≤
      atTop.liminf (fun n => M E (ψ n : (ℝ^d) → ℂ) x) := by
  have hcont (n : ℕ) : Continuous (ψ n : (ℝ^d) → ℂ) := (ψ n).continuous
  have hbound (n : ℕ) (y : ℝ^d) : ‖ψ n y‖ ≤ B := by
    calc
      ‖ψ n y‖ = ‖((ψ n y).re : ℂ)‖ := congrArg norm (hreal n y)
      _ = ‖(ψ n y).re‖ := Complex.norm_real _
      _ = (ψ n y).re := by rw [Real.norm_eq_abs, abs_of_nonneg (hψ0 n y)]
      _ ≤ G y := hψG n y
      _ ≤ B := hGB y
  have htend (y : ℝ^d) : Tendsto (fun n => ψ n y) atTop (𝓝 ((G y : ℝ) : ℂ)) := by
    have h := (Complex.continuous_ofReal.tendsto (G y)).comp (hψtend y)
    apply h.congr'
    filter_upwards with n
    exact (hreal n y).symm
  unfold M restrictedSphericalMaximal
  simp_rw [iSup_subtype']
  calc
    (⨆ t : ↥(E ∩ Ioi 0),
        ENNReal.ofReal ‖sphericalAverage t (fun y => (G y : ℂ)) x‖) ≤
        ⨆ t : ↥(E ∩ Ioi 0), atTop.liminf (fun n =>
          ENNReal.ofReal ‖sphericalAverage t (ψ n : (ℝ^d) → ℂ) x‖) := by
      apply iSup_mono
      intro t
      have havg := sphericalAverage_tendsto_of_bound hcont hbound htend t x
      have hnorm : Tendsto (fun n => ‖sphericalAverage t (ψ n : (ℝ^d) → ℂ) x‖)
          atTop (𝓝 ‖sphericalAverage t (fun y => (G y : ℂ)) x‖) :=
        tendsto_norm.comp havg
      have hofreal : Tendsto (fun n =>
          ENNReal.ofReal ‖sphericalAverage t (ψ n : (ℝ^d) → ℂ) x‖) atTop
          (𝓝 (ENNReal.ofReal ‖sphericalAverage t (fun y => (G y : ℂ)) x‖)) :=
        (ENNReal.continuous_ofReal.tendsto _).comp hnorm
      rw [hofreal.liminf_eq]
    _ ≤ atTop.liminf (fun n =>
        ⨆ t : ↥(E ∩ Ioi 0),
          ENNReal.ofReal ‖sphericalAverage t (ψ n : (ℝ^d) → ℂ) x‖) :=
      Filter.iSup_liminf_le_liminf_iSup

private theorem exists_measurable_envelope_of_bounded_lsc
    {d : ℕ} {E : Set ℝ} {p : ℝ≥0∞} (hp0 : p ≠ 0) (hptop : p ≠ ∞)
    {C : ℝ≥0∞}
    (hstrong : ∀ φ : SchwartzMap (ℝ^d) ℂ,
      eLpNorm (M E (φ : (ℝ^d) → ℂ)) p volume ≤
        C * eLpNorm (φ : (ℝ^d) → ℂ) p volume)
    {G : (ℝ^d) → ℝ} {B : ℝ}
    (hG0 : ∀ x, 0 ≤ G x) (hGB : ∀ x, G x ≤ B)
    (ψ : ℕ → SchwartzMap (ℝ^d) ℂ)
    (hreal : ∀ n x, ψ n x = ((ψ n x).re : ℂ))
    (hψ0 : ∀ n x, 0 ≤ (ψ n x).re)
    (hψG : ∀ n x, (ψ n x).re ≤ G x)
    (hψtend : ∀ x, Tendsto (fun n => (ψ n x).re) atTop (𝓝 (G x))) :
    ∃ J : (ℝ^d) → ℝ≥0∞, Measurable J ∧
      (∀ x, M E (fun y => (G y : ℂ)) x ≤ J x) ∧
      eLpNorm J p volume ≤ C * eLpNorm (fun y => (G y : ℂ)) p volume := by
  let J : (ℝ^d) → ℝ≥0∞ := fun x =>
    atTop.liminf (fun n => M E (ψ n : (ℝ^d) → ℂ) x)
  have hMmeas (n : ℕ) : Measurable (M E (ψ n : (ℝ^d) → ℂ)) := by
    change Measurable (restrictedSphericalMaximal E (ψ n : (ℝ^d) → ℂ))
    rw [restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal]
    exact _root_.Codex.Spherical.PowerWeights.RestrictedMaximal.measurable_restrictedNormalizedSphericalMaximal_schwartz E (ψ n)
  have hJmeas : Measurable J := by
    exact Measurable.liminf hMmeas
  have hψnorm (n : ℕ) :
      eLpNorm (ψ n : (ℝ^d) → ℂ) p volume ≤
        eLpNorm (fun y => (G y : ℂ)) p volume := by
    apply eLpNorm_mono
    intro y
    calc
      ‖ψ n y‖ = ‖((ψ n y).re : ℂ)‖ := congrArg norm (hreal n y)
      _ = ‖(ψ n y).re‖ := Complex.norm_real _
      _ = (ψ n y).re := by rw [Real.norm_eq_abs, abs_of_nonneg (hψ0 n y)]
      _ ≤ G y := hψG n y
      _ = ‖(G y : ℂ)‖ := by
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hG0 y)]
  refine ⟨J, hJmeas, ?_, ?_⟩
  · intro x
    exact restrictedSphericalMaximal_ofReal_le_liminf_schwartz hG0 hGB ψ hreal hψ0
      hψG hψtend x
  · apply eLpNorm_liminf_le_of_uniform hp0 hptop hMmeas
    intro n
    calc
      eLpNorm (M E (ψ n : (ℝ^d) → ℂ)) p volume ≤
          C * eLpNorm (ψ n : (ℝ^d) → ℂ) p volume := hstrong (ψ n)
      _ ≤ C * eLpNorm (fun y => (G y : ℂ)) p volume :=
        mul_le_mul_right (hψnorm n) C

private theorem endpoint_of_ae_maximal_null
    {d : ℕ} (hd0 : 0 < d) {E : Set ℝ} {f g : (ℝ^d) → ℂ} {K : ℝ}
    (hgmeas : StronglyMeasurable g) (hgbound : ∀ x, ‖g x‖ ≤ K)
    (hzero : M E (f - g) =ᵐ[volume] 0) :
    eLpNorm (M E f) ∞ volume ≤ ENNReal.ofReal K := by
  rw [eLpNorm_exponent_top]
  apply eLpNormEssSup_le_of_ae_enorm_bound
  filter_upwards [hzero] with x hx
  have hx' : M E (f - g) x = 0 := by simpa using hx
  simp only [enorm_eq_self]
  unfold M restrictedSphericalMaximal
  apply iSup_le
  intro t
  apply iSup_le
  intro ht
  let φ : Metric.sphere (0 : ℝ^d) 1 → ℝ^d :=
    fun ω => x + t • (ω : ℝ^d)
  have hφ : Measurable φ := by
    exact ((continuous_const : Continuous fun _ : Metric.sphere (0 : ℝ^d) 1 => x).add
      ((continuous_const : Continuous fun _ : Metric.sphere (0 : ℝ^d) 1 => t).smul
        continuous_subtype_val)).measurable
  letI : IsFiniteMeasure (unitSphereMeasure d) := by
    unfold unitSphereMeasure
    infer_instance
  have hgint : Integrable (fun ω : Metric.sphere (0 : ℝ^d) 1 => g (φ ω))
      (unitSphereMeasure d) := by
    apply Integrable.of_bound
    · change AEStronglyMeasurable (g ∘ φ) (unitSphereMeasure d)
      exact (hgmeas.comp_measurable hφ).aestronglyMeasurable
    · filter_upwards with ω
      exact hgbound _
  by_cases hfint : Integrable (fun ω : Metric.sphere (0 : ℝ^d) 1 => f (φ ω))
      (unitSphereMeasure d)
  · have hsubint : Integrable (fun ω : Metric.sphere (0 : ℝ^d) 1 =>
        (f - g) (φ ω)) (unitSphereMeasure d) := by
      change Integrable ((fun ω : Metric.sphere (0 : ℝ^d) 1 => f (φ ω)) -
        fun ω => g (φ ω)) (unitSphereMeasure d)
      exact hfint.sub hgint
    have hle : ENNReal.ofReal ‖sphericalAverage t (f - g) x‖ ≤
        M E (f - g) x := by
      unfold M restrictedSphericalMaximal
      exact le_iSup_of_le t (le_iSup_of_le ht le_rfl)
    rw [hx'] at hle
    have havgsub : sphericalAverage t (f - g) x = 0 := by
      apply norm_eq_zero.mp
      exact le_antisymm
        (ENNReal.ofReal_eq_zero.mp (le_antisymm hle bot_le)) (norm_nonneg _)
    have havgeq : sphericalAverage t f x = sphericalAverage t g x := by
      have havgsub' : ∫ ω : Metric.sphere (0 : ℝ^d) 1,
          (f - g) (φ ω) ∂unitSphereMeasure d = 0 := by
        simpa [φ, sphericalAverage] using havgsub
      unfold sphericalAverage
      change (∫ ω, f (φ ω) ∂unitSphereMeasure d) =
        ∫ ω, g (φ ω) ∂unitSphereMeasure d
      calc
        ∫ ω, f (φ ω) ∂unitSphereMeasure d =
            ∫ ω, g (φ ω) + (f - g) (φ ω) ∂unitSphereMeasure d := by
          apply integral_congr_ae
          filter_upwards with ω
          simp
        _ = (∫ ω, g (φ ω) ∂unitSphereMeasure d) +
            ∫ ω, (f - g) (φ ω) ∂unitSphereMeasure d := integral_add hgint hsubint
        _ = _ := by rw [havgsub', add_zero]
    rw [havgeq]
    calc
      ENNReal.ofReal ‖sphericalAverage t g x‖ ≤
          M E g x := by
        unfold M restrictedSphericalMaximal
        exact le_iSup_of_le t (le_iSup_of_le ht le_rfl)
      _ = Codex.Spherical.PowerWeights.RestrictedMaximal.restrictedNormalizedSphericalMaximal d E g x := by
        rw [← restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal]
      _ ≤ Codex.Spherical.SurfaceCore.normalizedSphericalMaximal d g x :=
        Codex.Spherical.PowerWeights.RestrictedMaximal.restrictedNormalizedSphericalMaximal_le_normalizedSphericalMaximal d E g x
      _ ≤ ENNReal.ofReal K :=
        Codex.Spherical.SurfaceCore.normalizedSphericalMaximal_le_of_norm_le hd0 g x hgbound
  · rw [sphericalAverage, integral_undef]
    simp
    simpa only [φ] using hfint

private theorem endpoint_of_raw_null
    {d : ℕ} (hd0 : 0 < d) {E : Set ℝ}
    (hraw_null : ∀ h : (ℝ^d) → ℂ, h =ᵐ[volume] 0 → M E h =ᵐ[volume] 0)
    {f : (ℝ^d) → ℂ} (hf : MemLp f ∞ volume) :
    eLpNorm (M E f) ∞ volume ≤ eLpNorm f ∞ volume := by
  let K : ℝ := lpNorm f ∞ volume
  let f0 : (ℝ^d) → ℂ := AEStronglyMeasurable.mk f hf.1
  let S : Set (ℝ^d) := {x | ‖f0 x‖ ≤ K}
  let g : (ℝ^d) → ℂ := S.indicator f0
  have hf0meas : StronglyMeasurable f0 := hf.1.stronglyMeasurable_mk
  have hS : MeasurableSet S := by
    exact hf0meas.norm.measurableSet_le stronglyMeasurable_const
  have hgmeas : StronglyMeasurable g := hf0meas.indicator hS
  have hgbound : ∀ x, ‖g x‖ ≤ K := by
    intro x
    by_cases hx : x ∈ S
    · change ‖S.indicator f0 x‖ ≤ K
      rw [Set.indicator_of_mem hx]
      exact hx
    · change ‖S.indicator f0 x‖ ≤ K
      rw [Set.indicator_of_notMem hx, norm_zero]
      exact lpNorm_nonneg
  have hfg : f =ᵐ[volume] g := by
    filter_upwards [hf.1.ae_eq_mk, ae_le_lpNorm_exponent_top hf] with x hfx hx
    have hxS : x ∈ S := by
      change ‖f0 x‖ ≤ K
      simpa [hfx] using hx
    change f x = S.indicator f0 x
    rw [Set.indicator_of_mem hxS]
    exact hfx
  have hsubzero : f - g =ᵐ[volume] 0 := by
    filter_upwards [hfg] with x hx
    simp [hx]
  have hzero := hraw_null (f - g) hsubzero
  calc
    eLpNorm (M E f) ∞ volume ≤ ENNReal.ofReal K :=
      endpoint_of_ae_maximal_null hd0 hgmeas hgbound hzero
    _ = eLpNorm f ∞ volume := ofReal_lpNorm hf

private theorem raw_null_of_measurable_envelope
    {d : ℕ} {E : Set ℝ} {q : ℝ≥0∞} (hq0 : q ≠ 0) {A : ℝ≥0∞}
    (hlift : ∀ h : (ℝ^d) → ℂ, MemLp h q volume →
      ∃ J : (ℝ^d) → ℝ≥0∞, Measurable J ∧
        (∀ x, M E h x ≤ J x) ∧
        eLpNorm J q volume ≤ A * eLpNorm h q volume)
  (h : (ℝ^d) → ℂ) (hhzero : h =ᵐ[volume] 0) :
    M E h =ᵐ[volume] 0 := by
  have hh : MemLp h q volume := by
    exact MemLp.ae_eq hhzero.symm MemLp.zero
  obtain ⟨J, hJmeas, hdom, hJbound⟩ := hlift h hh
  have hnormh : eLpNorm h q volume = 0 := eLpNorm_eq_zero_of_ae_zero hhzero
  have hnormJ : eLpNorm J q volume = 0 := by
    apply le_antisymm
    · simpa [hnormh] using hJbound
    · exact bot_le
  have hJzero : J =ᵐ[volume] 0 :=
    (eLpNorm_eq_zero_iff hJmeas.aestronglyMeasurable hq0).mp hnormJ
  filter_upwards [hJzero] with x hx
  apply le_antisymm
  · simpa [hx] using hdom x
  · exact bot_le

private theorem top_strong_of_finite_envelope
    {d : ℕ} {E : Set ℝ} {q : ℝ≥0∞} (hd0 : 0 < d) (hq0 : q ≠ 0)
    (hfinite : ∃ A : ℝ≥0∞, ∀ h : (ℝ^d) → ℂ, MemLp h q volume →
      ∃ J : (ℝ^d) → ℝ≥0∞, Measurable J ∧
        (∀ x, M E h x ≤ J x) ∧
        eLpNorm J q volume ≤ A * eLpNorm h q volume) :
    ∃ C : ℝ, ∀ f : (ℝ^d) → ℂ, MemLp f ∞ volume →
      eLpNorm (M E f) ∞ volume ≤ ENNReal.ofReal C * eLpNorm f ∞ volume := by
  obtain ⟨A, hlift⟩ := hfinite
  refine ⟨1, ?_⟩
  intro f hf
  have hraw_null : ∀ h : (ℝ^d) → ℂ, h =ᵐ[volume] 0 → M E h =ᵐ[volume] 0 := by
    intro h hh
    exact raw_null_of_measurable_envelope (q := q) (A := A) hq0 hlift h hh
  have htop := endpoint_of_raw_null (E := E) hd0 hraw_null hf
  simpa using htop

private theorem restrictedSphericalMaximal_mono
    {d : ℕ} {E F : Set ℝ} (hEF : E ⊆ F) (f : (ℝ^d) → ℂ) (x : ℝ^d) :
    M E f x ≤ M F f x := by
  unfold M restrictedSphericalMaximal
  apply iSup_le
  intro t
  apply iSup_le
  intro ht
  exact le_iSup_of_le t (le_iSup_of_le ⟨hEF ht.1, ht.2⟩ le_rfl)

private theorem memLp_indicator_closedBall_of_memLp_top
    {d : ℕ} {q : ℝ≥0∞} {f : (ℝ^d) → ℂ} (hf : MemLp f ∞ volume) (R : ℝ) :
    MemLp ((Metric.closedBall (0 : ℝ^d) R).indicator f) q volume := by
  refine HasCompactSupport.memLp_of_enorm_bound (p := q)
    (C := eLpNorm f ∞ volume) ?_ ?_ ?_ ?_
  · apply HasCompactSupport.intro (isCompact_closedBall (0 : ℝ^d) R)
    intro x hx
    exact Set.indicator_of_notMem hx f
  · exact hf.1.indicator Metric.isClosed_closedBall.measurableSet
  · filter_upwards [enorm_ae_le_eLpNormEssSup f volume] with x hx
    rw [eLpNorm_exponent_top]
    by_cases h : x ∈ Metric.closedBall (0 : ℝ^d) R
    · simp [Set.indicator_of_mem h, hx]
    · simp [Set.indicator_of_notMem h]
  · exact ne_of_lt hf.2

private theorem restrictedSphericalMaximal_local_eq
    {d : ℕ} {E : Set ℝ} (f : (ℝ^d) → ℂ) (m n : ℕ) {x : ℝ^d}
    (hx : x ∈ Metric.closedBall (0 : ℝ^d) (n : ℝ)) :
    M (E ∩ Iic (m : ℝ)) f x =
      M (E ∩ Iic (m : ℝ))
        ((Metric.closedBall (0 : ℝ^d) ((n + m : ℕ) : ℝ)).indicator f) x := by
  have hxnorm : ‖x‖ ≤ (n : ℝ) := by
    simpa only [Metric.mem_closedBall, dist_zero_right] using hx
  have havg (t : ℝ) (ht : t ∈ (E ∩ Iic (m : ℝ)) ∩ Ioi (0 : ℝ)) :
      sphericalAverage t f x = sphericalAverage t
        ((Metric.closedBall (0 : ℝ^d) ((n + m : ℕ) : ℝ)).indicator f) x := by
    unfold sphericalAverage
    apply integral_congr_ae
    filter_upwards with ω
    rw [Set.indicator_of_mem]
    rw [Metric.mem_closedBall, dist_zero_right]
    calc
      ‖x + t • (ω : ℝ^d)‖ ≤ ‖x‖ + ‖t • (ω : ℝ^d)‖ := norm_add_le _ _
      _ = ‖x‖ + |t| := by
        rw [norm_smul, Real.norm_eq_abs]
        have hω : ‖(ω : ℝ^d)‖ = 1 := mem_sphere_zero_iff_norm.mp ω.property
        rw [hω, mul_one]
      _ = ‖x‖ + t := by rw [abs_of_pos ht.2]
      _ ≤ (n : ℝ) + (m : ℝ) := add_le_add hxnorm ht.1.2
      _ = ((n + m : ℕ) : ℝ) := by norm_num
  apply le_antisymm
  · unfold M restrictedSphericalMaximal
    apply iSup_le
    intro t
    apply iSup_le
    intro ht
    exact le_iSup_of_le t (le_iSup_of_le ht (by rw [havg t ht]))
  · unfold M restrictedSphericalMaximal
    apply iSup_le
    intro t
    apply iSup_le
    intro ht
    exact le_iSup_of_le t (le_iSup_of_le ht (by rw [havg t ht]))

private theorem restrictedSphericalMaximal_eq_iSup_nat
    {d : ℕ} (E : Set ℝ) (f : (ℝ^d) → ℂ) (x : ℝ^d) :
    M E f x = ⨆ m : ℕ, M (E ∩ Iic (m : ℝ)) f x := by
  apply le_antisymm
  · unfold M restrictedSphericalMaximal
    apply iSup_le
    intro t
    apply iSup_le
    intro ht
    obtain ⟨m, hm⟩ := exists_nat_ge t
    exact le_iSup_of_le m (le_iSup_of_le t
      (le_iSup_of_le ⟨⟨ht.1, hm⟩, ht.2⟩ le_rfl))
  · apply iSup_le
    intro m
    exact restrictedSphericalMaximal_mono (by intro t ht; exact ht.1) f x

private theorem aemeasurable_restrictedSphericalMaximal_of_memLp_top
    {d : ℕ} {E : Set ℝ} {q : ℝ≥0∞} {C : ℝ}
    (hqone : 1 ≤ q) (hq0 : q ≠ 0) (hqtop : q ≠ ∞)
    (hstrong : ∀ φ : SchwartzMap (ℝ^d) ℂ,
      eLpNorm (M E (φ : (ℝ^d) → ℂ)) q volume ≤
        ENNReal.ofReal C * eLpNorm (φ : (ℝ^d) → ℂ) q volume)
    {f : (ℝ^d) → ℂ} (hf : MemLp f ∞ volume) :
    AEMeasurable (M E f) volume := by
  have hrestricted (m n : ℕ) :
      MemLp (M (E ∩ Iic (m : ℝ))
        ((Metric.closedBall (0 : ℝ^d) ((n + m : ℕ) : ℝ)).indicator f))
        q volume := by
    refine (_root_.Codex.Spherical.PowerWeights.RawLpLift.memLp_restrictedSphericalMaximal_of_memLp_of_schwartz_bound
      (E := E ∩ Iic (m : ℝ)) (μ := volume) (p := q) (C := C)
      hqone hq0 hqtop ?_ ?_).1
    · intro φ
      have hmono (x : ℝ^d) :
          M (E ∩ Iic (m : ℝ)) (φ : (ℝ^d) → ℂ) x ≤
            M E (φ : (ℝ^d) → ℂ) x :=
        restrictedSphericalMaximal_mono (by rintro t ⟨ht, _⟩; exact ht)
          (φ : (ℝ^d) → ℂ) x
      have hnorm :
          eLpNorm (M (E ∩ Iic (m : ℝ)) (φ : (ℝ^d) → ℂ)) q volume ≤
            eLpNorm (M E (φ : (ℝ^d) → ℂ)) q volume :=
        eLpNorm_mono_enorm fun x => by
          simpa only [enorm_eq_self] using hmono x
      exact hnorm.trans (hstrong φ)
    · exact memLp_indicator_closedBall_of_memLp_top (q := q) hf _
  have hlocal (m : ℕ) : AEMeasurable (M (E ∩ Iic (m : ℝ)) f) volume := by
    have heq (n : ℕ) : Set.EqOn (M (E ∩ Iic (m : ℝ)) f)
        (M (E ∩ Iic (m : ℝ))
          ((Metric.closedBall (0 : ℝ^d) ((n + m : ℕ) : ℝ)).indicator f))
        (Metric.closedBall (0 : ℝ^d) (n : ℝ)) := fun x hx =>
      restrictedSphericalMaximal_local_eq f m n hx
    have h := AEMeasurable.iUnion (fun n : ℕ =>
      ((hrestricted m n).1.aemeasurable.mono_measure Measure.restrict_le_self).congr
        ((heq n).aeEq_restrict Metric.isClosed_closedBall.measurableSet).symm)
    rw [Metric.iUnion_closedBall_nat] at h
    simpa using h
  have hsup : AEMeasurable (fun x => ⨆ m : ℕ, M (E ∩ Iic (m : ℝ)) f x) volume :=
    AEMeasurable.iSup hlocal
  exact hsup.congr (Filter.Eventually.of_forall fun x =>
    (restrictedSphericalMaximal_eq_iSup_nat E f x).symm)

private theorem exists_bounded_nonneg_lsc_root_majorant
    {d : ℕ} (u : (ℝ^d) → ℝ≥0) (hu : AEMeasurable u volume)
    {q : ℝ} (hq : 0 < q) {B : ℝ≥0} (hB : ∀ x, u x ≤ B)
    {ε : ℝ≥0∞} (hε : ε ≠ 0) :
    ∃ G : (ℝ^d) → ℝ,
      (∀ x, 0 ≤ G x) ∧
      (∀ x, G x ≤ (B : ℝ) ^ q⁻¹) ∧
      LowerSemicontinuous G ∧
      (∀ x, (u x : ℝ) ^ q⁻¹ ≤ G x) ∧
      (∫⁻ x, ENNReal.ofReal (G x ^ q) ∂volume) ≤
        (∫⁻ x, (u x : ℝ≥0∞) ∂volume) + ε := by
  obtain ⟨g, hug, hglsc, hgint⟩ :=
    exists_lt_lowerSemicontinuous_lintegral_ge_of_aemeasurable volume u hu hε
  let T : ℝ≥0∞ := B
  have hTtop : T ≠ ∞ := by simp [T]
  let H : (ℝ^d) → ℝ := fun x => ENNReal.truncateToReal T (g x)
  have hHnonneg (x : ℝ^d) : 0 ≤ H x := by
    exact ENNReal.truncateToReal_nonneg
  have hHle (x : ℝ^d) : H x ≤ (B : ℝ) := by
    simpa [H, T] using ENNReal.truncateToReal_le hTtop (x := g x)
  let G : (ℝ^d) → ℝ := fun x => (max 0 (H x)) ^ q⁻¹
  have hGnonneg (x : ℝ^d) : 0 ≤ G x := by
    dsimp [G]
    exact Real.rpow_nonneg (le_max_left _ _) _
  have hGlsc : LowerSemicontinuous G := by
    have hHlsc : LowerSemicontinuous H := by
      exact (ENNReal.continuous_truncateToReal hTtop).comp_lowerSemicontinuous hglsc
        (ENNReal.monotone_truncateToReal hTtop)
    have hbasecont : Continuous fun z : ℝ => max 0 z := continuous_const.max continuous_id
    have hbase : Continuous fun z : ℝ => (max 0 z) ^ q⁻¹ :=
      hbasecont.rpow_const (fun z => Or.inr (inv_nonneg.mpr hq.le))
    exact hbase.comp_lowerSemicontinuous hHlsc (by
      intro a b hab
      exact Real.rpow_le_rpow (le_max_left _ _) (max_le_max_left _ hab)
        (inv_nonneg.mpr hq.le))
  have hGle (x : ℝ^d) : G x ≤ (B : ℝ) ^ q⁻¹ := by
    dsimp [G]
    rw [max_eq_right (hHnonneg x)]
    exact Real.rpow_le_rpow (hHnonneg x) (hHle x) (inv_nonneg.mpr hq.le)
  have huG (x : ℝ^d) : (u x : ℝ) ^ q⁻¹ ≤ G x := by
    have hmin : (u x : ℝ≥0∞) ≤ min T (g x) := by
      refine le_min ?_ (le_of_lt (hug x))
      simpa [T] using (hB x)
    have hmin_top : min T (g x) ≠ ∞ := by
      refine ne_top_of_le_ne_top hTtop ?_
      exact min_le_left _ _
    have huH : (u x : ℝ) ≤ H x := by
      change ((u x : ℝ≥0∞).toReal) ≤ (min T (g x)).toReal
      exact (ENNReal.toReal_le_toReal (by simp) hmin_top).2 hmin
    dsimp [G]
    rw [max_eq_right (hHnonneg x)]
    exact Real.rpow_le_rpow (NNReal.coe_nonneg _) huH (inv_nonneg.mpr hq.le)
  have hGpow (x : ℝ^d) : ENNReal.ofReal (G x ^ q) = min T (g x) := by
    have hmin_top : min T (g x) ≠ ∞ := by
      refine ne_top_of_le_ne_top hTtop ?_
      exact min_le_left _ _
    change ENNReal.ofReal (((max 0 (H x)) ^ q⁻¹) ^ q) = min T (g x)
    rw [max_eq_right (hHnonneg x), Real.rpow_inv_rpow (hHnonneg x) hq.ne']
    change ENNReal.ofReal ((min T (g x)).toReal) = min T (g x)
    exact ENNReal.ofReal_toReal hmin_top
  refine ⟨G, hGnonneg, hGle, hGlsc, huG, ?_⟩
  calc
    ∫⁻ x, ENNReal.ofReal (G x ^ q) ∂volume = ∫⁻ x, min T (g x) ∂volume := by
      apply lintegral_congr
      intro x
      exact hGpow x
    _ ≤ ∫⁻ x, g x ∂volume := by
      apply lintegral_mono
      intro x
      exact min_le_right _ _
    _ ≤ ∫⁻ x, (u x : ℝ≥0∞) ∂volume + ε := hgint

private theorem exists_bounded_nonneg_lsc_majorant_of_memLp
    {d : ℕ} (f : (ℝ^d) → ℂ) {p : ℝ≥0∞} (hp0 : p ≠ 0) (hptop : p ≠ ∞)
    (hf : MemLp f p volume) (n : ℕ) {ε : ℝ≥0∞} (hε : ε ≠ 0) :
    ∃ G : (ℝ^d) → ℝ,
      (∀ x, 0 ≤ G x) ∧
      (∀ x, G x ≤ n) ∧
      LowerSemicontinuous G ∧
      (∀ x, min ‖f x‖ n ≤ G x) ∧
      (∫⁻ x, ENNReal.ofReal (G x ^ p.toReal) ∂volume) ≤
        (∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂volume) + ε := by
  have hq : 0 < p.toReal := ENNReal.toReal_pos hp0 hptop
  let N : ℝ≥0 := n
  let u : (ℝ^d) → ℝ≥0 := fun x => (min ‖f x‖₊ N) ^ p.toReal
  have hu : AEMeasurable u volume := by
    dsimp [u]
    exact (NNReal.continuous_rpow_const hq.le).measurable.comp_aemeasurable
      (hf.aemeasurable.nnnorm.min measurable_const.aemeasurable)
  have huN (x : ℝ^d) : u x ≤ N ^ p.toReal := by
    dsimp [u]
    exact NNReal.rpow_le_rpow (min_le_right _ _) hq.le
  obtain ⟨G, hG0, hGN, hGlsc, huG, hGint⟩ :=
    exists_bounded_nonneg_lsc_root_majorant u hu hq huN hε
  refine ⟨G, hG0, ?_, hGlsc, ?_, ?_⟩
  · intro x
    have hN0 : 0 ≤ (N : ℝ) := NNReal.coe_nonneg _
    have hpow : ((N : ℝ) ^ p.toReal) ^ (p.toReal)⁻¹ = N := by
      rw [Real.rpow_rpow_inv hN0 hq.ne']
    calc
      G x ≤ ((N ^ p.toReal : ℝ≥0) : ℝ) ^ (p.toReal)⁻¹ := hGN x
      _ = ((N : ℝ) ^ p.toReal) ^ (p.toReal)⁻¹ := by rw [NNReal.coe_rpow]
      _ = N := hpow
      _ = n := by simp [N]
  · intro x
    let a : ℝ := ((min ‖f x‖₊ N : ℝ≥0) : ℝ)
    have hbase0 : 0 ≤ a := by
      dsimp [a]
      exact NNReal.coe_nonneg _
    have hroot : (a ^ p.toReal) ^ (p.toReal)⁻¹ = a := by
      rw [Real.rpow_rpow_inv hbase0 hq.ne']
    have hreal : min ‖f x‖ (n : ℝ) = a := by simp [a, N]
    have hu_eq : ((u x : ℝ≥0) : ℝ) = a ^ p.toReal := by
      dsimp [u, a]
    calc
      min ‖f x‖ (n : ℝ) = a := hreal
      _ = ((u x : ℝ≥0) : ℝ) ^ (p.toReal)⁻¹ := by
        rw [hu_eq]
        exact hroot.symm
      _ ≤ G x := huG x
  · calc
      ∫⁻ x, ENNReal.ofReal (G x ^ p.toReal) ∂volume ≤
          (∫⁻ x, (u x : ℝ≥0∞) ∂volume) + ε := hGint
      _ ≤ (∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂volume) + ε := by
        gcongr
        calc
          (u x : ℝ≥0∞) = (↑(min ‖f x‖₊ N) : ℝ≥0∞) ^ p.toReal := by
            rw [ENNReal.coe_rpow_of_nonneg _ hq.le]
          _ ≤ (↑‖f x‖₊ : ℝ≥0∞) ^ p.toReal := by
            apply ENNReal.rpow_le_rpow
            · exact_mod_cast min_le_left _ _
            · exact hq.le
          _ = ‖f x‖ₑ ^ p.toReal := by rw [enorm_eq_nnnorm]

private theorem exists_measurable_raw_envelope_at_eps
    {d : ℕ} {E : Set ℝ} {p : ℝ≥0∞} (hp0 : p ≠ 0) (hptop : p ≠ ∞)
    {C : ℝ≥0∞}
    (hstrong : ∀ φ : SchwartzMap (ℝ^d) ℂ,
      eLpNorm (M E (φ : (ℝ^d) → ℂ)) p volume ≤
        C * eLpNorm (φ : (ℝ^d) → ℂ) p volume)
    {f : (ℝ^d) → ℂ} (hf : MemLp f p volume)
    {ε : ℝ≥0∞} (hε : ε ≠ 0) :
    ∃ J : (ℝ^d) → ℝ≥0∞, Measurable J ∧ (∀ x, M E f x ≤ J x) ∧
      eLpNorm J p volume ≤ C *
        ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂volume) + ε) ^ (p.toReal)⁻¹ := by
  choose G hG0 hGbound hGlsc hGmajor hGint using fun n : ℕ =>
    exists_bounded_nonneg_lsc_majorant_of_memLp f hp0 hptop hf n hε
  choose ψ hψreal hψ0 hψG hψtend using fun n : ℕ =>
    exists_schwartz_minorants_of_bounded_lsc (G n) (hG0 n) (hGbound n) (hGlsc n)
  choose J hJmeas hJG hJbound using fun n : ℕ =>
    exists_measurable_envelope_of_bounded_lsc hp0 hptop hstrong
      (hG0 n) (hGbound n) (ψ n) (hψreal n) (hψ0 n) (hψG n) (hψtend n)
  let H : (ℝ^d) → ℝ≥0∞ := fun x => atTop.liminf (fun n => J n x)
  have hHmeas : Measurable H := by
    exact Measurable.liminf hJmeas
  have hHdom (x : ℝ^d) : M E f x ≤ H x := by
    calc
      M E f x ≤ atTop.liminf (fun n => M E (fun y => (G n y : ℂ)) x) :=
        restrictedSphericalMaximal_le_liminf_of_trunc_majorants f G
          (fun n => (hGlsc n).measurable) hGbound hG0 hGmajor x
      _ ≤ atTop.liminf (fun n => J n x) := by
        refine Filter.liminf_le_liminf ?_ (by isBoundedDefault) (by isBoundedDefault)
        filter_upwards with n
        exact hJG n x
      _ = H x := rfl
  refine ⟨H, hHmeas, hHdom, ?_⟩
  apply eLpNorm_liminf_le_of_uniform hp0 hptop hJmeas
  intro n
  calc
    eLpNorm (J n) p volume ≤ C * eLpNorm (fun y => (G n y : ℂ)) p volume :=
      hJbound n
    _ ≤ C * ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂volume) + ε) ^ (p.toReal)⁻¹ := by
      exact mul_le_mul_of_nonneg_left
        (eLpNorm_real_le_of_lintegral_rpow_le hp0 hptop (hG0 n) (hGint n)) bot_le

private theorem exists_measurable_raw_envelope_of_memLp
    {d : ℕ} {E : Set ℝ} {p : ℝ≥0∞} (hp0 : p ≠ 0) (hptop : p ≠ ∞)
    {C : ℝ≥0∞} (hCtop : C ≠ ∞)
    (hstrong : ∀ φ : SchwartzMap (ℝ^d) ℂ,
      eLpNorm (M E (φ : (ℝ^d) → ℂ)) p volume ≤
        C * eLpNorm (φ : (ℝ^d) → ℂ) p volume)
    {f : (ℝ^d) → ℂ} (hf : MemLp f p volume) :
    ∃ J : (ℝ^d) → ℝ≥0∞, Measurable J ∧ (∀ x, M E f x ≤ J x) ∧
      eLpNorm J p volume ≤ C * eLpNorm f p volume := by
  choose J hJmeas hJdom hJbound using fun n : ℕ =>
    exists_measurable_raw_envelope_at_eps hp0 hptop hstrong hf
      (by simp : (((n + 1 : ℕ) : ℝ≥0∞)⁻¹) ≠ 0)
  let H : (ℝ^d) → ℝ≥0∞ := fun x => atTop.liminf (fun n => J n x)
  have hHmeas : Measurable H := by
    exact Measurable.liminf hJmeas
  have hHdom (x : ℝ^d) : M E f x ≤ H x := by
    change M E f x ≤ atTop.liminf (fun n => J n x)
    rw [Filter.le_liminf_iff]
    intro y hy
    filter_upwards with n
    exact hy.trans_le (hJdom n x)
  have hshiftNat : Tendsto (fun n : ℕ => n + 1) atTop atTop :=
    (Filter.tendsto_add_atTop_iff_nat 1).2 tendsto_id
  have hinv : Tendsto (fun n : ℕ => ((n + 1 : ℕ) : ℝ≥0∞)⁻¹) atTop (𝓝 0) :=
    ENNReal.tendsto_inv_nat_nhds_zero.comp hshiftNat
  have hsum : Tendsto (fun n : ℕ =>
      (∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂volume) + ((n + 1 : ℕ)⁻¹ : ℝ≥0∞)) atTop
      (𝓝 ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂volume) + 0)) :=
    tendsto_const_nhds.add hinv
  have hpow : Tendsto (fun n : ℕ =>
      ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂volume) + ((n + 1 : ℕ)⁻¹ : ℝ≥0∞)) ^
        (p.toReal)⁻¹) atTop
      (𝓝 ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂volume) ^ (p.toReal)⁻¹)) := by
    change Tendsto ((fun z : ℝ≥0∞ => z ^ (p.toReal)⁻¹) ∘
      fun n : ℕ => (∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂volume) +
        ((n + 1 : ℕ)⁻¹ : ℝ≥0∞)) atTop
      (𝓝 ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂volume) ^ (p.toReal)⁻¹))
    simpa only [add_zero] using
      (ENNReal.continuous_rpow_const.tendsto
        ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂volume) + 0)).comp hsum
  have hKlim : Tendsto (fun n : ℕ => C *
      ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂volume) + ((n + 1 : ℕ)⁻¹ : ℝ≥0∞)) ^
        (p.toReal)⁻¹) atTop
      (𝓝 (C * (∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂volume) ^ (p.toReal)⁻¹)) :=
    ((ENNReal.continuous_const_mul hCtop).tendsto
      ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂volume) ^ (p.toReal)⁻¹)).comp hpow
  refine ⟨H, hHmeas, hHdom, ?_⟩
  calc
    eLpNorm H p volume ≤ atTop.liminf (fun n => eLpNorm (J n) p volume) :=
      eLpNorm_liminf_le_liminf hp0 hptop hJmeas
    _ ≤ atTop.liminf (fun n => C *
        ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂volume) + ((n + 1 : ℕ)⁻¹ : ℝ≥0∞)) ^
          (p.toReal)⁻¹) := by
      refine Filter.liminf_le_liminf ?_ (by isBoundedDefault) (by isBoundedDefault)
      filter_upwards with n
      exact hJbound n
    _ = C * (∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂volume) ^ (p.toReal)⁻¹ :=
      hKlim.liminf_eq
    _ = C * eLpNorm f p volume := by
      rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop]
      rw [show 1 / p.toReal = (p.toReal)⁻¹ by ring]

/-- A finite-exponent Bourgain bound on the Schwartz core lifts directly to
the raw full circular maximal function.  This is kept conditional here so
that the analytic Bourgain argument can be developed independently. -/
theorem aux_bourgain_full_finite_eLpNorm
    {p : ENNReal} (hp : (2 : ENNReal) < p) (hptop : p ≠ ∞)
    (hbourgain : Codex.Spherical.Bourgain.HasCircularMaximalSchwartzBound p.toReal) :
    ∃ C : ℝ, ∀ f : (ℝ^2) → ℂ, MemLp f p volume →
      MemLp (M (Ioi (0 : ℝ)) f) p volume ∧
        eLpNorm (M (Ioi (0 : ℝ)) f) p volume ≤
          ENNReal.ofReal C * eLpNorm f p volume := by
  obtain ⟨C, _hC, hschwartz⟩ := hbourgain
  have hpone : (1 : ENNReal) ≤ p := by
    exact le_trans (by norm_num) hp.le
  have hp0 : p ≠ 0 := ne_of_gt (lt_trans (by norm_num) hp)
  refine ⟨C, ?_⟩
  intro f hf
  refine (_root_.Codex.Spherical.PowerWeights.RawLpLift.memLp_restrictedSphericalMaximal_of_memLp_of_schwartz_bound
      (μ := volume) (C := C) hpone hp0 hptop ?_ hf)
  intro φ
  rw [← ENNReal.ofReal_toReal hptop]
  simpa only [Codex.Spherical.Bourgain.fullCircularMaximal,
    Codex.Spherical.Bourgain.circularMaximal] using hschwartz φ

/-- The same conditional Bourgain input at exponent three supplies the
measurable finite-exponent envelope required for the raw `L∞` endpoint. -/
theorem aux_bourgain_full_top_eLpNorm
    (hbourgain : Codex.Spherical.Bourgain.HasCircularMaximalSchwartzBound 3) :
    ∃ C : ℝ, ∀ f : (ℝ^2) → ℂ, MemLp f ∞ volume →
      MemLp (M (Ioi (0 : ℝ)) f) ∞ volume ∧
        eLpNorm (M (Ioi (0 : ℝ)) f) ∞ volume ≤
          ENNReal.ofReal C * eLpNorm f ∞ volume := by
  obtain ⟨C, _hC, hschwartz⟩ := hbourgain
  have hraw : ∀ φ : SchwartzMap (ℝ^2) ℂ,
      eLpNorm (M (Ioi (0 : ℝ)) (φ : (ℝ^2) → ℂ))
          (ENNReal.ofReal (3 : ℝ)) volume ≤
        ENNReal.ofReal C * eLpNorm (φ : (ℝ^2) → ℂ)
          (ENNReal.ofReal (3 : ℝ)) volume := by
    intro φ
    simpa only [Codex.Spherical.Bourgain.fullCircularMaximal,
      Codex.Spherical.Bourgain.circularMaximal] using hschwartz φ
  obtain ⟨Ctop, htop⟩ := top_strong_of_finite_envelope
    (q := ENNReal.ofReal (3 : ℝ))
    (by norm_num) (by norm_num)
    ⟨ENNReal.ofReal C, fun f hf =>
      exists_measurable_raw_envelope_of_memLp (p := ENNReal.ofReal (3 : ℝ))
        (by norm_num) (by norm_num) ENNReal.ofReal_ne_top hraw hf⟩
  refine ⟨Ctop, ?_⟩
  intro f hf
  refine ⟨⟨(aemeasurable_restrictedSphericalMaximal_of_memLp_top
    (q := ENNReal.ofReal (3 : ℝ))
    (by norm_num) (by norm_num) (by norm_num) hraw hf).aestronglyMeasurable,
    ?_⟩, htop f hf⟩
  exact (htop f hf).trans_lt (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hf.2)

private theorem full_log_mem (u : ℝ) (hu : |u| ≤ 1) :
    u ∈ logDilationSet
      ((Ioi (0 : ℝ)) ∩ logBall ⟨1, by norm_num⟩ 1) := by
  let r : Ioi (0 : ℝ) :=
    ⟨(2 : ℝ) ^ u, Real.rpow_pos_of_pos (by norm_num) _⟩
  refine ⟨r, ?_, ?_⟩
  · constructor
    · exact r.2
    · constructor
      · exact r.2
      · change |Real.log r.1 / Real.log 2 - Real.log 1 / Real.log 2| ≤ (1 : ℝ)
        rw [show r.1 = (2 : ℝ) ^ u from rfl,
          Real.log_rpow (by norm_num : (0 : ℝ) < 2)]
        norm_num
        simpa using hu
  · change Real.log r.1 / Real.log 2 = u
    rw [show r.1 = (2 : ℝ) ^ u from rfl,
      Real.log_rpow (by norm_num : (0 : ℝ) < 2)]
    field_simp

private def full_grid (n : ℕ) : Finset ℝ :=
  (Finset.range (n + 1)).image fun k : ℕ => -1 + 2 * (k : ℝ) / n

private theorem full_grid_card (n : ℕ) (hn : 0 < n) :
    (full_grid n).card = n + 1 := by
  unfold full_grid
  rw [Finset.card_image_of_injective]
  · simp
  · intro a b hab
    have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast (ne_of_gt hn)
    have hab' : (a : ℝ) = b := by
      field_simp [hn0] at hab
      linarith
    exact_mod_cast hab'

private theorem abs_full_grid_le_one {n : ℕ} (hn : 0 < n) {x : ℝ}
    (hx : x ∈ full_grid n) : |x| ≤ 1 := by
  rw [full_grid, Finset.mem_image] at hx
  obtain ⟨k, hk, rfl⟩ := hx
  have hklt : k < n + 1 := Finset.mem_range.mp hk
  have hk' : k ≤ n := by omega
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hkreal : (k : ℝ) ≤ n := by exact_mod_cast hk'
  have hfrac_nonneg : 0 ≤ (k : ℝ) / n := by positivity
  have hfrac_le_one : (k : ℝ) / n ≤ 1 := (div_le_one₀ hnreal).2 hkreal
  have hform : 2 * (k : ℝ) / n = 2 * ((k : ℝ) / n) := by ring
  rw [abs_le, hform]
  constructor <;> linarith

private theorem full_grid_distance {n k l : ℕ} (hn : 0 < n) (hkl : k ≠ l) :
    2 / ((n + 1 : ℕ) : ℝ) <
      |(-1 + 2 * (k : ℝ) / n) - (-1 + 2 * (l : ℝ) / n)| := by
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have habs : (1 : ℝ) ≤ |(k : ℝ) - l| := by
    rcases lt_or_gt_of_ne hkl with hlt | hgt
    · have hcast : (k : ℝ) < l := by exact_mod_cast hlt
      have hstep : (k : ℝ) + 1 ≤ l := by
        exact_mod_cast (Nat.succ_le_iff.mpr hlt)
      rw [abs_of_nonpos (by linarith)]
      linarith
    · have hcast : (l : ℝ) < k := by exact_mod_cast hgt
      have hstep : (l : ℝ) + 1 ≤ k := by
        exact_mod_cast (Nat.succ_le_iff.mpr hgt)
      rw [abs_of_nonneg (by linarith)]
      linarith
  have hdiff :
      (-1 + 2 * (k : ℝ) / n) - (-1 + 2 * (l : ℝ) / n) =
        2 * ((k : ℝ) - l) / n := by ring
  rw [hdiff, abs_div, abs_mul, abs_of_pos hnreal]
  have htwo : (0 : ℝ) < 2 := by norm_num
  rw [abs_of_pos htwo]
  have hmain : 2 / ((n + 1 : ℕ) : ℝ) < 2 / (n : ℝ) := by
    apply (div_lt_div_iff_of_pos_left htwo (by positivity) hnreal).2
    norm_num
  calc
    2 / ((n + 1 : ℕ) : ℝ) < 2 / (n : ℝ) := hmain
    _ ≤ 2 * |(k : ℝ) - l| / n := by
      apply (div_le_div_iff_of_pos_right hnreal).2
      nlinarith

private def full_grid_scale (n : ℕ) : ℝ≥0 := ((n + 1 : ℕ) : ℝ≥0)⁻¹

private theorem coe_full_grid_scale (n : ℕ) :
    (full_grid_scale n : ℝ) = 1 / ((n + 1 : ℕ) : ℝ) := by
  simp [full_grid_scale]

private theorem full_grid_isSeparated {n : ℕ} (hn : 0 < n) :
    Metric.IsSeparated (2 * full_grid_scale n) (full_grid n : Set ℝ) := by
  unfold Metric.IsSeparated
  rintro x hx y hy hxy
  change x ∈ full_grid n at hx
  change y ∈ full_grid n at hy
  rw [full_grid, Finset.mem_image] at hx hy
  obtain ⟨k, hk, rfl⟩ := hx
  obtain ⟨l, hl, rfl⟩ := hy
  have hkl : k ≠ l := by
    intro h
    subst l
    exact hxy rfl
  rw [edist_dist, Real.dist_eq]
  apply ENNReal.coe_lt_ofReal.2
  rw [NNReal.coe_mul, coe_full_grid_scale]
  simpa [div_eq_mul_inv] using full_grid_distance hn hkl

private theorem full_grid_subset_logDilationSet {n : ℕ} (hn : 0 < n) :
    (full_grid n : Set ℝ) ⊆ logDilationSet
      ((Ioi (0 : ℝ)) ∩ logBall ⟨1, by norm_num⟩ 1) := by
  intro x hx
  change x ∈ full_grid n at hx
  exact full_log_mem x (abs_full_grid_le_one hn hx)

private theorem full_entropy_lower {n : ℕ} (hn : 0 < n) :
    (n + 1 : ℕ∞) ≤ N
      ((Ioi (0 : ℝ)) ∩ logBall ⟨1, by norm_num⟩ 1)
      (full_grid_scale n) := by
  change (n + 1 : ℕ∞) ≤ Metric.externalCoveringNumber (full_grid_scale n)
    (logDilationSet ((Ioi (0 : ℝ)) ∩ logBall ⟨1, by norm_num⟩ 1))
  calc
    (n + 1 : ℕ∞) = (full_grid n : Set ℝ).encard := by
      rw [Set.encard_coe_eq_coe_finsetCard, full_grid_card n hn]
      norm_num
    _ ≤ Metric.packingNumber (2 * full_grid_scale n)
        (logDilationSet ((Ioi (0 : ℝ)) ∩ logBall ⟨1, by norm_num⟩ 1)) :=
      (full_grid_isSeparated hn).encard_le_packingNumber
        (full_grid_subset_logDilationSet hn)
    _ ≤ Metric.externalCoveringNumber (full_grid_scale n)
        (logDilationSet ((Ioi (0 : ℝ)) ∩ logBall ⟨1, by norm_num⟩ 1)) :=
      Metric.packingNumber_two_mul_le_externalCoveringNumber _ _

private theorem log_full_grid_scale_inv (n : ℕ) :
    ENNReal.log ((n + 1 : ℕ) : ℝ≥0∞) =
      (Real.log ((full_grid_scale n : ℝ)⁻¹) : EReal) := by
  rw [← ENNReal.ofReal_natCast, ENNReal.log_ofReal]
  have hpos : (0 : ℝ) < ((n + 1 : ℕ) : ℝ) := by positivity
  rw [if_neg (not_le_of_gt hpos)]
  rw [coe_full_grid_scale]
  have hne : ((n + 1 : ℕ) : ℝ) ≠ 0 := ne_of_gt hpos
  field_simp

private theorem one_le_full_entropy_quotient {n : ℕ} (hn : 0 < n) :
    (1 : EReal) ≤ ENNReal.log ((⨆ c : Ioi (0 : ℝ),
      N ((Ioi (0 : ℝ)) ∩ logBall c 1) (full_grid_scale n) : ℕ∞) : ℝ≥0∞) /
      (Real.log ((full_grid_scale n : ℝ)⁻¹) : EReal) := by
  have hNnat : (n + 1 : ℕ∞) ≤ ⨆ c : Ioi (0 : ℝ),
      N ((Ioi (0 : ℝ)) ∩ logBall c 1) (full_grid_scale n) := by
    let c0 : Ioi (0 : ℝ) := ⟨1, by norm_num⟩
    apply le_iSup_of_le c0
    exact full_entropy_lower hn
  have hN : ((n + 1 : ℕ) : ℝ≥0∞) ≤ ((⨆ c : Ioi (0 : ℝ),
      N ((Ioi (0 : ℝ)) ∩ logBall c 1) (full_grid_scale n) : ℕ∞) : ℝ≥0∞) := by
    exact_mod_cast hNnat
  have hscale : ((full_grid_scale n : ℝ)⁻¹) = ((n + 1 : ℕ) : ℝ) := by
    rw [coe_full_grid_scale]
    have hne : ((n + 1 : ℕ) : ℝ) ≠ 0 := by positivity
    field_simp
  have hdenreal : 0 < Real.log ((full_grid_scale n : ℝ)⁻¹) := by
    rw [hscale]
    apply Real.log_pos
    have : 1 < n + 1 := by omega
    exact_mod_cast this
  have hden : (0 : EReal) < (Real.log ((full_grid_scale n : ℝ)⁻¹) : EReal) :=
    by exact_mod_cast hdenreal
  by_contra h
  have hlt : ENNReal.log ((⨆ c : Ioi (0 : ℝ),
      N ((Ioi (0 : ℝ)) ∩ logBall c 1) (full_grid_scale n) : ℕ∞) : ℝ≥0∞) /
      (Real.log ((full_grid_scale n : ℝ)⁻¹) : EReal) < 1 := lt_of_not_ge h
  have hmul := (EReal.div_lt_iff hden (EReal.coe_ne_top _)).1 hlt
  have hnum : (Real.log ((full_grid_scale n : ℝ)⁻¹) : EReal) ≤ ENNReal.log
      ((⨆ c : Ioi (0 : ℝ),
        N ((Ioi (0 : ℝ)) ∩ logBall c 1) (full_grid_scale n) : ℕ∞) : ℝ≥0∞) := by
    rw [← log_full_grid_scale_inv n]
    exact ENNReal.log_le_log hN
  exact (not_lt_of_ge hnum) (by simpa using hmul)

private theorem tendsto_full_grid_scale :
    Tendsto full_grid_scale atTop (𝓝[>] (0 : ℝ≥0)) := by
  have hshiftNat : Tendsto (fun n : ℕ => n + 1) atTop atTop :=
    (Filter.tendsto_add_atTop_iff_nat 1).2 tendsto_id
  have hshift : Tendsto (fun n : ℕ => ((n + 1 : ℕ) : ℝ≥0)) atTop atTop :=
    tendsto_natCast_atTop_iff.2 hshiftNat
  change Tendsto (fun n : ℕ => ((n + 1 : ℕ) : ℝ≥0)⁻¹) atTop (𝓝[>] (0 : ℝ≥0))
  exact tendsto_inv_atTop_nhdsGT_zero.comp hshift

private def full_entropy_quotient (δ : ℝ≥0) : EReal :=
  ENNReal.log ((⨆ c : Ioi (0 : ℝ),
    N ((Ioi (0 : ℝ)) ∩ logBall c 1) δ : ℕ∞) : ℝ≥0∞) /
    (Real.log ((δ : ℝ)⁻¹) : EReal)

private theorem frequently_one_le_full_entropy_quotient :
    ∃ᶠ δ : ℝ≥0 in 𝓝[>] (0 : ℝ≥0),
      (1 : EReal) ≤ full_entropy_quotient δ := by
  have hpos : ∀ᶠ n : ℕ in atTop, 0 < n :=
    Filter.eventually_atTop.2 ⟨1, fun n hn => hn⟩
  apply tendsto_full_grid_scale.frequently
  exact (hpos.mono fun n hn => one_le_full_entropy_quotient hn).frequently

private theorem beta_full :
    β (Ioi (0 : ℝ)) = 1 := by
  change upperMinkowskiExponent (Ioi (0 : ℝ)) = 1
  rw [upperMinkowskiExponent_eq_legacyMinkowskiExponent]
  have hlow : (1 : EReal) ≤ legacyMinkowskiExponent (Ioi (0 : ℝ)) := by
    unfold legacyMinkowskiExponent entropyLogQuotient legacyUnitEntropy
    change (1 : EReal) ≤ Filter.limsup full_entropy_quotient (𝓝[>] (0 : ℝ≥0))
    exact Filter.le_limsup_of_frequently_le' frequently_one_le_full_entropy_quotient
  have hupp : legacyMinkowskiExponent (Ioi (0 : ℝ)) ≤ (1 : EReal) := by
    rw [← multiplicativeMinkowskiExponent_eq_legacyMinkowskiExponent]
    exact multiplicativeMinkowskiExponent_le_one _
  have heq : legacyMinkowskiExponent (Ioi (0 : ℝ)) = (1 : EReal) :=
    le_antisymm hupp hlow
  rw [heq]
  rfl

private theorem criticalExponent_full (d : ℕ) (hd : 2 ≤ d) :
    criticalExponent d (Ioi (0 : ℝ)) = (d : ℝ) / (d - 1) := by
  rw [criticalExponent, beta_full]
  have hdreal : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hden : (d : ℝ) - 1 ≠ 0 := by
    linarith
  field_simp
  ring

/-- Seeger--Wainger--Wright theorem. -/
theorem eLpNorm_restrictedSphericalMaximal_le {d : ℕ} {p : ℝ≥0∞}
    (hd : 3 ≤ d) {E : Set ℝ} (hE : E ⊆ Ioi 0)
    (hp : ENNReal.ofReal (criticalExponent d E) <
      p) :
    ∃ C : ℝ, ∀ f : (ℝ^d) → ℂ, MemLp f p volume →
      MemLp (M E f) p volume ∧
        eLpNorm (M E f) p volume ≤ (ENNReal.ofReal C) * eLpNorm f p volume := by
  by_cases hEempty : E = ∅
  · subst E
    exact empty_restrictedSphericalMaximal_bound
  have hEnonempty : E.Nonempty := Set.nonempty_iff_ne_empty.mpr hEempty
  by_cases hptop : p = ∞
  · subst p
    obtain ⟨C, _hC, hbound⟩ :=
      (hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_zero_iff d E 2).mp
        (core_of_root_critical hd hEnonempty hE
          (criticalExponent_lt_two_of_nonempty hd hEnonempty hE))
    have hschwartz : ∀ φ : SchwartzMap (ℝ^d) ℂ,
        eLpNorm (M E (φ : (ℝ^d) → ℂ)) (2 : ℝ≥0∞) volume ≤
          ENNReal.ofReal C * eLpNorm (φ : (ℝ^d) → ℂ) (2 : ℝ≥0∞) volume := by
      intro φ
      have h := (hbound φ (by
        simpa using (φ.memLp (ENNReal.ofReal (2 : ℝ)) volume))).2
      rw [← restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal] at h
      norm_num at h ⊢
      exact h
    obtain ⟨Ctop, htop⟩ := top_strong_of_finite_envelope (q := (2 : ℝ≥0∞))
      (by omega : 0 < d) (by norm_num)
      ⟨ENNReal.ofReal C, fun f hf =>
        exists_measurable_raw_envelope_of_memLp (p := (2 : ℝ≥0∞))
          (by norm_num) (by norm_num) ENNReal.ofReal_ne_top hschwartz hf⟩
    refine ⟨Ctop, ?_⟩
    intro f hf
    refine ⟨⟨(aemeasurable_restrictedSphericalMaximal_of_memLp_top
      (q := (2 : ℝ≥0∞)) (by norm_num) (by norm_num) (by norm_num) hschwartz hf).aestronglyMeasurable,
      ?_⟩, htop f hf⟩
    exact (htop f hf).trans_lt (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hf.2)
  · have hp0 : p ≠ 0 := by
      apply ne_of_gt
      exact lt_of_le_of_lt bot_le hp
    obtain ⟨C, _hC, hbound⟩ :=
      (hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_zero_iff d E p.toReal).mp
        (core_of_root_critical_ennreal hd hEnonempty hE hptop hp)
    refine ⟨C, ?_⟩
    intro f hf
    have hschwartz : ∀ φ : SchwartzMap (ℝ^d) ℂ,
        eLpNorm (M E (φ : (ℝ^d) → ℂ)) p volume ≤
          ENNReal.ofReal C * eLpNorm (φ : (ℝ^d) → ℂ) p volume := by
      intro φ
      have h := (hbound φ (φ.memLp (ENNReal.ofReal p.toReal) volume)).2
      rw [← restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal,
        ENNReal.ofReal_toReal hptop] at h
      exact h
    have hbeta_nonneg : 0 ≤ upperMinkowskiExponent E := by
      rw [upperMinkowskiExponent_eq_multiplicativeMinkowskiExponent_toReal E]
      exact EReal.toReal_nonneg
        (_root_.Codex.Spherical.PowerWeights.EntropyComparison.multiplicativeMinkowskiExponent_nonneg_of_nonempty_of_subset_Ioi
          hEnonempty hE)
    have hden : 0 < (d : ℝ) - 1 := by
      have hd' : (1 : ℝ) < d := by exact_mod_cast (show 1 < d by omega)
      linarith
    have hcritical : (1 : ℝ) ≤ criticalExponent d E := by
      unfold criticalExponent
      exact le_add_of_nonneg_right (div_nonneg hbeta_nonneg hden.le)
    have hpone : (1 : ℝ≥0∞) ≤ p := by
      calc
        (1 : ℝ≥0∞) = ENNReal.ofReal 1 := by norm_num
        _ ≤ ENNReal.ofReal (criticalExponent d E) := ENNReal.ofReal_le_ofReal hcritical
        _ ≤ p := hp.le
    exact _root_.Codex.Spherical.PowerWeights.RawLpLift.memLp_restrictedSphericalMaximal_of_memLp_of_schwartz_bound
      (μ := volume) hpone hp0 hptop hschwartz hf

/-- Stein's spherical maximal theorem, obtained from the restricted theorem
on the full set of positive radii. -/
theorem eLpNorm_sphericalMaximal_le {d : ℕ} {p : ENNReal} (hd : 3 ≤ d)
    (hp : (d : ENNReal) / (d - 1) < p) :
    ∃ C : ℝ, ∀ f : (ℝ^d) → ℂ, MemLp f p volume →
      MemLp (M (Ioi (0 : ℝ)) f) p volume ∧
        eLpNorm (M (Ioi (0 : ℝ)) f) p volume ≤
          (ENNReal.ofReal C) * eLpNorm f p volume := by
  apply eLpNorm_restrictedSphericalMaximal_le hd
    (by exact fun x hx => hx)
  have hdreal : (2 : ℝ) ≤ d := by
    exact_mod_cast (by omega : 2 ≤ d)
  have hden : (0 : ℝ) < (d : ℝ) - 1 := by linarith
  have hsub : ENNReal.ofReal ((d : ℝ) - 1) = (d : ENNReal) - 1 := by
    rw [ENNReal.ofReal_sub _ (by norm_num : (0 : ℝ) ≤ 1)]
    norm_num
  rw [criticalExponent_full d (by omega),
    ENNReal.ofReal_div_of_pos hden, hsub]
  simpa using hp

/-- The all-radii diagonal estimate in every dimension at least two, once the
planar Bourgain Schwartz-core theorem is supplied.  The non-planar branch is
the existing Stein/restricted-dilation theorem; the planar finite and top
exponent branches use the two raw-operator lifts above.  This isolates the
only genuinely new input needed to lower the dimension threshold. -/
theorem eLpNorm_sphericalMaximal_le_of_bourgain
    {d : ℕ} {p : ENNReal} (hd : 2 ≤ d)
    (hp : (d : ENNReal) / (d - 1) < p)
    (hbourgain : ∀ q : ℝ, 2 < q →
      Codex.Spherical.Bourgain.HasCircularMaximalSchwartzBound q) :
    ∃ C : ℝ, ∀ f : (ℝ^d) → ℂ, MemLp f p volume →
      MemLp (M (Ioi (0 : ℝ)) f) p volume ∧
        eLpNorm (M (Ioi (0 : ℝ)) f) p volume ≤
          (ENNReal.ofReal C) * eLpNorm f p volume := by
  by_cases hd2 : d = 2
  · subst d
    by_cases hptop : p = ∞
    · subst p
      exact aux_bourgain_full_top_eLpNorm (hbourgain 3 (by norm_num))
    · have hp2 : (2 : ENNReal) < p := by
        have hden : ((2 : Nat) : ENNReal) - 1 = (1 : ENNReal) := by
          apply ENNReal.sub_eq_of_eq_add ENNReal.one_ne_top
          exact_mod_cast (show (2 : Nat) = 1 + 1 by norm_num)
        rw [hden, div_one] at hp
        exact hp
      have hp2real : 2 < p.toReal := by
        apply (ENNReal.ofReal_lt_iff_lt_toReal (by norm_num) hptop).mp
        simpa using hp2
      exact aux_bourgain_full_finite_eLpNorm hp2 hptop
        (hbourgain p.toReal hp2real)
  · have hd3 : 3 ≤ d := by omega
    exact eLpNorm_sphericalMaximal_le hd3 hp

/-- The dyadic lacunary set has zero upper Minkowski exponent. -/
private theorem lacunary_log_subset (c : Ioi (0 : ℝ)) :
    logDilationSet (({2 ^ k | k : ℤ} : Set ℝ) ∩ logBall c 1) ⊆
      (fun k : ℤ => (k : ℝ)) ''
        Set.Icc (⌊Real.log c.1 / Real.log 2 - 1⌋ : ℤ)
          (⌊Real.log c.1 / Real.log 2 - 1⌋ + 2) := by
  intro x hx
  rcases hx with ⟨r, hr, hxr⟩
  rcases hr.1 with ⟨k, hk⟩
  have hlog : Real.log ((2 : ℝ) ^ k) / Real.log 2 = (k : ℝ) := by
    cases k with
    | ofNat n =>
        rw [Int.ofNat_eq_natCast, zpow_natCast, Real.log_pow]
        field_simp
        norm_num
    | negSucc n =>
        rw [zpow_negSucc, Real.log_inv, Real.log_pow]
        field_simp
        norm_num
  have hxk : x = (k : ℝ) := by
    calc
      x = Real.log r.1 / Real.log 2 := hxr.symm
      _ = Real.log ((2 : ℝ) ^ k) / Real.log 2 := by rw [hk]
      _ = (k : ℝ) := hlog
  refine ⟨k, ?_, hxk.symm⟩
  have hball := hr.2.2
  rw [← hk, hlog] at hball
  have hlo : Real.log c.1 / Real.log 2 - 1 ≤ (k : ℝ) := by
    have hdiff := (neg_le_neg hball).trans
      (neg_abs_le ((k : ℝ) - Real.log c.1 / Real.log 2))
    have hdiff' : -(1 : ℝ) ≤ (k : ℝ) - Real.log c.1 / Real.log 2 := by
      simpa using hdiff
    linarith
  have hhi : (k : ℝ) ≤ Real.log c.1 / Real.log 2 + 1 := by
    have hdiff := (le_abs_self ((k : ℝ) - Real.log c.1 / Real.log 2)).trans hball
    have hdiff' : (k : ℝ) - Real.log c.1 / Real.log 2 ≤ (1 : ℝ) := by
      simpa using hdiff
    linarith
  constructor
  · exact Int.cast_le.1 ((Int.floor_le _).trans hlo)
  · have hkminus : k - 2 ≤ ⌊Real.log c.1 / Real.log 2 - 1⌋ := by
      apply Int.le_floor.2
      rw [Int.cast_sub]
      linarith
    omega

private theorem lacunary_entropy_bound (c : Ioi (0 : ℝ)) (δ : ℝ≥0) :
    N (({2 ^ k | k : ℤ} : Set ℝ) ∩ logBall c 1) δ ≤ 3 := by
  let A := logDilationSet (({2 ^ k | k : ℤ} : Set ℝ) ∩ logBall c 1)
  let m : ℤ := ⌊Real.log c.1 / Real.log 2 - 1⌋
  have hA : A ⊆ (fun k : ℤ => (k : ℝ)) '' Set.Icc m (m + 2) := by
    simpa [A, m] using lacunary_log_subset c
  calc
    N (({2 ^ k | k : ℤ} : Set ℝ) ∩ logBall c 1) δ
        = Metric.externalCoveringNumber δ A := rfl
    _ ≤ A.encard := Metric.externalCoveringNumber_le_encard_self A
    _ ≤ ((fun k : ℤ => (k : ℝ)) '' Set.Icc m (m + 2)).encard :=
      Set.encard_le_encard hA
    _ ≤ (Set.Icc m (m + 2) : Set ℤ).encard := Set.encard_image_le _ _
    _ = 3 := by
      rw [← Set.coe_fintypeCard]
      have hcard := Int.card_fintype_Icc_of_le (a := m) (b := m + 2) (by omega)
      have hcard_int : (Fintype.card (Set.Icc m (m + 2)) : ℤ) = 3 := by
        omega
      have hcard' : Fintype.card (Set.Icc m (m + 2)) = 3 := by
        exact_mod_cast hcard_int
      rw [hcard']
      norm_num

theorem beta_lacunary :
    β ({2 ^ k | k : ℤ} : Set ℝ) = 0 := by
  let D : Set ℝ := {2 ^ k | k : ℤ}
  let q : ℝ≥0 → EReal := fun δ =>
    ENNReal.log (⨆ c : Ioi (0 : ℝ), (N (D ∩ logBall c 1) δ : ENNReal)) /
      (Real.log ((δ : ℝ)⁻¹) : EReal)
  have hN (c : Ioi (0 : ℝ)) (δ : ℝ≥0) :
      N (D ∩ logBall c 1) δ ≤ 3 := by
    simpa [D] using lacunary_entropy_bound c δ
  have hsup_one (δ : ℝ≥0) :
      (1 : ENNReal) ≤ (⨆ c : Ioi (0 : ℝ),
        (N (D ∩ logBall c 1) δ : ENNReal)) := by
    let c0 : Ioi (0 : ℝ) := ⟨1, by norm_num⟩
    apply le_iSup_of_le c0
    have hpos : 0 < N (D ∩ logBall c0 1) δ :=
      Metric.externalCoveringNumber_pos_iff.2 <| by
      refine ⟨0, ?_⟩
      refine ⟨⟨1, by norm_num⟩, ?_⟩
      constructor
      · constructor
        · exact ⟨0, by simp⟩
        · simp [logBall, c0]
      · simp
    have hone : (1 : ENat) ≤ N (D ∩ logBall c0 1) δ :=
      Order.one_le_iff_ne_zero.2 (ne_of_gt hpos)
    exact_mod_cast hone
  have hnum_le (δ : ℝ≥0) :
      ENNReal.log (⨆ c : Ioi (0 : ℝ),
        (N (D ∩ logBall c 1) δ : ENNReal)) ≤ ENNReal.log (3 : ENNReal) := by
    apply ENNReal.log_le_log
    exact iSup_le fun c => by exact_mod_cast hN c δ
  have hnum_nonneg (δ : ℝ≥0) :
      (0 : EReal) ≤ ENNReal.log
        (⨆ c : Ioi (0 : ℝ), (N (D ∩ logBall c 1) δ : ENNReal)) := by
    rw [← ENNReal.log_one]
    apply ENNReal.log_le_log
    exact hsup_one δ
  have hnum_top (δ : ℝ≥0) :
      ENNReal.log (⨆ c : Ioi (0 : ℝ),
        (N (D ∩ logBall c 1) δ : ENNReal)) < (⊤ : EReal) := by
    exact hnum_le δ |>.trans_lt (by norm_num)
  have hKtop : ENNReal.log (3 : ENNReal) < (⊤ : EReal) := by
    rw [← ENNReal.log_top]
    apply ENNReal.log_lt_log
    norm_num
  have hden : Tendsto (fun δ : ℝ≥0 =>
      (Real.log ((δ : ℝ)⁻¹) : EReal)) (𝓝[>] 0) (𝓝 (⊤ : EReal)) := by
    have hcoe : Tendsto (fun δ : ℝ≥0 => (δ : ℝ))
        (𝓝[>] 0) (𝓝[>] (0 : ℝ)) := by
      change (𝓝[>] (0 : ℝ≥0)).map NNReal.toReal ≤ 𝓝[>] (0 : ℝ)
      simp
    have hinv : Tendsto (fun δ : ℝ≥0 => ((δ : ℝ)⁻¹)) (𝓝[>] 0) atTop :=
      tendsto_inv_nhdsGT_zero.comp hcoe
    exact EReal.tendsto_coe_atTop.comp (Real.tendsto_log_atTop.comp hinv)
  have hden_pos : ∀ᶠ δ : ℝ≥0 in 𝓝[>] 0,
      (0 : EReal) < (Real.log ((δ : ℝ)⁻¹) : EReal) :=
    hden.eventually (lt_mem_nhds (EReal.coe_lt_top 0))
  have hq : Tendsto q (𝓝[>] 0) (𝓝 (0 : EReal)) := by
    apply tendsto_order.2
    constructor
    · intro a ha
      filter_upwards [hden_pos] with δ hδ
      have hq_nonneg : (0 : EReal) ≤ q δ := by
        dsimp [q]
        exact EReal.div_nonneg (hnum_nonneg δ) hδ.le
      exact ha.trans_le hq_nonneg
    · intro a ha
      cases a with
      | bot => simp at ha
      | top =>
          filter_upwards [hden_pos] with δ hδ
          dsimp [q]
          apply (EReal.div_lt_iff hδ (EReal.coe_ne_top _)).2
          rw [EReal.top_mul_of_pos hδ]
          exact hnum_top δ
      | coe a =>
          have ha_pos : 0 < a := EReal.coe_pos.1 ha
          have hmul : Tendsto (fun δ : ℝ≥0 =>
              (a : EReal) * (Real.log ((δ : ℝ)⁻¹) : EReal)) (𝓝[>] 0)
              (𝓝 (⊤ : EReal)) := by
            simpa [EReal.coe_mul_top_of_pos ha_pos] using
              (EReal.Tendsto.const_mul hden (a := (a : EReal))
                (b := (⊤ : EReal)) (by simp) (by simp))
          filter_upwards [hden_pos,
            hmul.eventually (lt_mem_nhds hKtop)] with δ hδ hmulδ
          dsimp [q]
          apply (EReal.div_lt_iff hδ (EReal.coe_ne_top _)).2
          exact (hnum_le δ).trans_lt hmulδ
  have hlimsup : Filter.limsup q (𝓝[>] 0) = 0 := hq.limsup_eq
  have hresult : (Filter.limsup q (𝓝[>] 0)).toReal = 0 := by
    rw [hlimsup]
    rfl
  simpa [q, D, upperMinkowskiExponent] using hresult

theorem criticalExponent_lacunary (d : ℕ) :
    criticalExponent d ({2 ^ k | k : ℤ} : Set ℝ) = 1 := by
  simp [criticalExponent, beta_lacunary]

/-- C.P. Calderon's lacunary spherical maximal theorem. -/
theorem eLpNorm_lacunarySphericalMaximal_le {d : ℕ} {p : ℝ≥0∞} (hd : 3 ≤ d)
    (hp : 1 < p) :
    ∃ C : ℝ, ∀ f : (ℝ^d) → ℂ, MemLp f p volume →
      MemLp (M {2 ^ k | k : ℤ} f) p volume ∧
        eLpNorm (M {2 ^ k | k : ℤ} f) p volume ≤
          (ENNReal.ofReal C) * eLpNorm f p volume := by
  apply eLpNorm_restrictedSphericalMaximal_le hd
    (by
      rintro x ⟨k, rfl⟩
      exact zpow_pos (show (0 : ℝ) < 2 by norm_num) k)
  rw [criticalExponent_lacunary d]
  simpa using hp

private theorem exists_raw_counterexample_of_not_strongType
    {d : ℕ} {E : Set ℝ} {p : ℝ≥0∞}
    (hp0 : 0 < p) (hptop : p ≠ ∞)
    (hnot : ¬ HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E p.toReal 0) :
    ∀ C : ℝ, ∃ f : (ℝ^d) → ℂ, MemLp f p volume ∧ 0 < eLpNorm f p volume ∧
      eLpNorm (M E f) p volume ≥ ENNReal.ofReal C * eLpNorm f p volume := by
  intro C
  let K : ℝ := max C 1
  have hK : 0 < K := lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  have hp_eq : ENNReal.ofReal p.toReal = p := ENNReal.ofReal_toReal hptop
  by_cases hlarge : ∃ f : SchwartzMap (ℝ^d) ℂ,
      ENNReal.ofReal K * eLpNorm (f : (ℝ^d) → ℂ) p volume <
        eLpNorm (restrictedNormalizedSphericalMaximal d E (f : (ℝ^d) → ℂ)) p volume
  · rcases hlarge with ⟨f, hlarge⟩
    have hf : MemLp (f : (ℝ^d) → ℂ) p volume := f.memLp p volume
    have hnorm_pos : 0 < eLpNorm (f : (ℝ^d) → ℂ) p volume := by
      apply pos_iff_ne_zero.mpr
      intro hnorm_zero
      have hzero_ae : (f : (ℝ^d) → ℂ) =ᵐ[volume] 0 :=
        (eLpNorm_eq_zero_iff hf.1 hp0.ne').mp hnorm_zero
      have hzero : (f : (ℝ^d) → ℂ) = 0 :=
        (Continuous.ae_eq_iff_eq volume f.continuous continuous_zero).mp hzero_ae
      have hmax_zero :
          restrictedNormalizedSphericalMaximal d E (f : (ℝ^d) → ℂ) = 0 := by
        rw [hzero]
        ext x
        simp [restrictedNormalizedSphericalMaximal,
          Codex.Spherical.SurfaceCore.normalizedSphericalAverage,
          Codex.Spherical.SurfaceCore.sphericalAverage]
      rw [hmax_zero, hnorm_zero] at hlarge
      simp at hlarge
    refine ⟨f, hf, hnorm_pos, ?_⟩
    change eLpNorm (_root_.Spherical.restrictedSphericalMaximal E (f : (ℝ^d) → ℂ))
        p volume ≥ ENNReal.ofReal C * eLpNorm (f : (ℝ^d) → ℂ) p volume
    rw [restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal E f]
    exact le_of_lt (lt_of_le_of_lt
      (mul_le_mul_left (ENNReal.ofReal_le_ofReal (le_max_left _ _)) _) hlarge)
  · apply False.elim
    apply hnot
    rw [hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_zero_iff]
    refine ⟨K, hK, ?_⟩
    intro f hf
    rw [hp_eq] at hf ⊢
    have hbound :
        eLpNorm (restrictedNormalizedSphericalMaximal d E (f : (ℝ^d) → ℂ)) p volume ≤
          ENNReal.ofReal K * eLpNorm (f : (ℝ^d) → ℂ) p volume := by
      exact le_of_not_gt fun h => hlarge ⟨f, h⟩
    refine ⟨?_, hbound⟩
    refine ⟨(measurable_restrictedNormalizedSphericalMaximal E
      (f : (ℝ^d) → ℂ) f.continuous).aestronglyMeasurable, ?_⟩
    exact hbound.trans_lt
      (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hf.eLpNorm_lt_top)

private theorem not_strongType_of_lt_critical_of_three_le
    {d : ℕ} (hd : 3 ≤ d) {E : Set ℝ} (hE : E.Nonempty)
    (hEpos : E ⊆ Ioi (0 : ℝ)) {p : ℝ≥0∞}
    (hp : p < ENNReal.ofReal (criticalExponent d E)) (hp0 : 0 < p) :
    ¬ HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E p.toReal 0 := by
  have hptop := ne_top_of_le_ne_top ENNReal.ofReal_ne_top hp.le
  have hpReal : p.toReal < criticalExponent d E :=
    (ENNReal.lt_ofReal_iff_toReal_lt hptop).mp hp
  have hpReal0 : 0 < p.toReal := ENNReal.toReal_pos (ne_of_gt hp0) hptop
  intro hstrong
  have hdim : d - 1 + 1 = d := Nat.sub_add_cancel (by omega)
  have hM :=
    _root_.Codex.Spherical.PowerWeights.BallOriginLower.alpha_add_multiplicativeMinkowskiExponent_le_of_restrictedStrongType_of_nonneg
      (E := E) (p := p.toReal) (d - 1) (by omega) hpReal0
      (show (0 : ℝ) ≤ 0 by norm_num)
      (by simpa only [hdim] using hstrong)
  have hM' : multiplicativeMinkowskiExponent E ≤
      ((((d - 1 : ℕ) : ℝ) * (p.toReal - 1) : ℝ) : EReal) := by
    simpa using hM
  have hMbot := multiplicativeMinkowskiExponent_ne_bot hE hEpos
  have hMreal : (multiplicativeMinkowskiExponent E).toReal ≤
      ((d - 1 : ℕ) : ℝ) * (p.toReal - 1) :=
    EReal.toReal_le_toReal hM' hMbot (EReal.coe_ne_top _)
  have hMreal' : (multiplicativeMinkowskiExponent E).toReal ≤
      ((d : ℝ) - 1) * (p.toReal - 1) := by
    simpa only [Nat.cast_sub (by omega : 1 ≤ d), Nat.cast_one] using hMreal
  have hden : 0 < (d : ℝ) - 1 := by
    have hdreal : (3 : ℝ) ≤ d := by exact_mod_cast hd
    linarith
  have hbeta : upperMinkowskiExponent E =
      (multiplicativeMinkowskiExponent E).toReal :=
    upperMinkowskiExponent_eq_multiplicativeMinkowskiExponent_toReal E
  have hdiv : (multiplicativeMinkowskiExponent E).toReal / ((d : ℝ) - 1) ≤
      p.toReal - 1 := by
    calc
      _ ≤ (((d : ℝ) - 1) * (p.toReal - 1)) / ((d : ℝ) - 1) :=
        div_le_div_of_nonneg_right hMreal' hden.le
      _ = p.toReal - 1 := by field_simp
  have hcrit' : 1 + (multiplicativeMinkowskiExponent E).toReal / ((d : ℝ) - 1) ≤
      p.toReal := by
    linarith
  have hcrit : criticalExponent d E ≤ p.toReal := by
    simpa only [criticalExponent, hbeta] using hcrit'
  exact (not_le_of_gt hpReal) hcrit

private theorem circle_radialShell_cap_average_lower
    (κ : ℝ≥0∞)
    (hκ : ∀ ε : ℝ, 0 < ε → ε ≤ 1 / 2 →
      κ * ENNReal.ofReal (ε ^ 1) ≤
        Codex.Spherical.SurfaceCore.unitSurfaceMeasure 2
          (Metric.ball
            (Codex.Spherical.FractalDilations.ClusterCapGeometry.euclideanSuccLastSphere 1) ε))
    {r b h R : ℝ} (hr : 0 < r) (hinner : b < r)
    (hmargin : b + r * h ≤ R) (hh : 0 < h) (hhalf : h ≤ 1 / 2)
    (g : (ℝ^2) → ℝ) (hgContinuous : Continuous g)
    (hgnonneg : ∀ y, 0 ≤ g y)
    (hg_one : ∀ y, ‖y‖ ≤ R → g y = 1)
    {x : (ℝ^2)} (hx : x ∈ radialShell 2 r b) :
    κ * ENNReal.ofReal h / ENNReal.ofReal (Codex.Spherical.SurfaceCore.surfaceMass 2) ≤
      ENNReal.ofReal ‖Codex.Spherical.SurfaceCore.normalizedSphericalAverage 2
        (fun y => (g y : ℂ)) r x‖ := by
  have hxshell : |‖x‖ - r| < b := hx
  have hxnorm : 0 < ‖x‖ := by
    have : r - b < ‖x‖ := by
      rcases abs_lt.mp hxshell with ⟨hlow, _⟩
      linarith
    linarith
  have hdir : ‖inwardRadialDirection x‖ = 1 := norm_inwardRadialDirection hxnorm
  have hgi : Integrable (fun w : Metric.sphere (0 : (ℝ^2)) 1 =>
      g (x + r • (w : (ℝ^2))))
      (Codex.Spherical.SurfaceCore.unitSurfaceMeasure 2) := by
    have hcont : Continuous (fun w : Metric.sphere (0 : (ℝ^2)) 1 =>
        g (x + r • (w : (ℝ^2)))) := by
      apply hgContinuous.comp
      fun_prop
    exact hcont.integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  have hcap : κ * ENNReal.ofReal h ≤
      Codex.Spherical.SurfaceCore.unitSurfaceMeasure 2
        (sphericalCap 1 (inwardRadialDirection x) h) := by
    have hpole : κ * ENNReal.ofReal h ≤
        Codex.Spherical.SurfaceCore.unitSurfaceMeasure 2 (northPoleCap 1 h) := by
      change κ * ENNReal.ofReal h ≤
        Codex.Spherical.SurfaceCore.unitSurfaceMeasure 2
          (Metric.ball
            (Codex.Spherical.FractalDilations.ClusterCapGeometry.euclideanSuccLastSphere 1) h)
      simpa using hκ h hh hhalf
    calc
      κ * ENNReal.ofReal h ≤
          Codex.Spherical.SurfaceCore.unitSurfaceMeasure 2 (northPoleCap 1 h) := hpole
      _ = Codex.Spherical.SurfaceCore.unitSurfaceMeasure 2
          (sphericalCap 1 (inwardRadialDirection x) h) :=
        (unitSurfaceMeasure_sphericalCap_eq_pole 1 hdir h).symm
  have havg := cap_fraction_le_ennreal_norm_normalizedSphericalAverage
    (d := 2) (by omega) g r x (sphericalCap 1 (inwardRadialDirection x) h)
      (measurableSet_sphericalCap 1 (inwardRadialDirection x) h) hgi
      (fun w => hgnonneg _) (by
        intro w hw
        apply hg_one
        have hmem := inwardRadial_cap_translate_subset_ball (n := 1)
          hr hinner hmargin hx hw
        rw [Metric.mem_ball, dist_zero_right] at hmem
        exact hmem.le)
  exact (ENNReal.div_le_div_right hcap _).trans havg

private def circleCapFactor (κ : ℝ≥0∞) (δ : ℝ≥0) : ℝ≥0∞ :=
  κ * ENNReal.ofReal ((δ : ℝ) / 8) /
    ENNReal.ofReal (Codex.Spherical.SurfaceCore.surfaceMass 2)

private def circleCapConstant (κ : ℝ≥0∞) : ℝ≥0∞ :=
  κ * ENNReal.ofReal ((1 : ℝ) / 8) /
    ENNReal.ofReal (Codex.Spherical.SurfaceCore.surfaceMass 2)

private theorem circleCapFactor_pos {κ : ℝ≥0∞} (hκ : 0 < κ)
    {δ : ℝ≥0} (hδ : 0 < δ) :
    0 < circleCapFactor κ δ := by
  have hδreal : 0 < (δ : ℝ) := by exact_mod_cast hδ
  have hfrac : 0 < (δ : ℝ) / 8 := div_pos hδreal (by norm_num)
  unfold circleCapFactor
  apply ENNReal.div_pos
  · exact (ENNReal.mul_pos (ne_of_gt hκ)
      (ENNReal.ofReal_pos.mpr hfrac).ne').ne'
  · exact ENNReal.ofReal_ne_top

private theorem circleCapFactor_ne_top {κ : ℝ≥0∞} (hκtop : κ ≠ ∞)
    (δ : ℝ≥0) :
    circleCapFactor κ δ ≠ ∞ := by
  unfold circleCapFactor
  apply ENNReal.div_ne_top
  · exact ENNReal.mul_ne_top hκtop ENNReal.ofReal_ne_top
  · exact (ENNReal.ofReal_pos.mpr
      (Codex.Spherical.SurfaceCore.surfaceMass_pos (by norm_num))).ne'

private theorem circleCapConstant_pos {κ : ℝ≥0∞} (hκ : 0 < κ) :
    0 < circleCapConstant κ := by
  have hfrac : 0 < (1 : ℝ) / 8 := by norm_num
  unfold circleCapConstant
  apply ENNReal.div_pos
  · exact (ENNReal.mul_pos (ne_of_gt hκ)
      (ENNReal.ofReal_pos.mpr hfrac).ne').ne'
  · exact ENNReal.ofReal_ne_top

private theorem circleCapConstant_ne_top {κ : ℝ≥0∞} (hκtop : κ ≠ ∞) :
    circleCapConstant κ ≠ ∞ := by
  unfold circleCapConstant
  apply ENNReal.div_ne_top
  · exact ENNReal.mul_ne_top hκtop ENNReal.ofReal_ne_top
  · exact (ENNReal.ofReal_pos.mpr
      (Codex.Spherical.SurfaceCore.surfaceMass_pos (by norm_num))).ne'

private theorem circleCapFactor_scale (κ : ℝ≥0∞) {δ : ℝ≥0} (hδ : 0 < δ) :
    circleCapFactor κ δ = circleCapConstant κ * (δ : ℝ≥0∞) := by
  have hδreal : 0 < (δ : ℝ) := by exact_mod_cast hδ
  unfold circleCapFactor circleCapConstant
  rw [show (δ : ℝ) / 8 = (δ : ℝ) * ((1 : ℝ) / 8) by ring,
    ENNReal.ofReal_mul hδreal.le]
  rw [ENNReal.ofReal_coe_nnreal]
  change κ * ((δ : ℝ≥0∞) * ENNReal.ofReal ((1 : ℝ) / 8)) /
      ENNReal.ofReal (Codex.Spherical.SurfaceCore.surfaceMass 2) =
    (κ * ENNReal.ofReal ((1 : ℝ) / 8) /
      ENNReal.ofReal (Codex.Spherical.SurfaceCore.surfaceMass 2)) * (δ : ℝ≥0∞)
  simp only [ENNReal.div_eq_inv_mul]
  ac_rfl

private theorem circle_finite_knapp_bound_of_bound
    (κ : ℝ≥0∞)
    (hκ : ∀ ε : ℝ, 0 < ε → ε ≤ 1 / 2 →
      κ * ENNReal.ofReal (ε ^ 1) ≤
        Codex.Spherical.SurfaceCore.unitSurfaceMeasure 2
          (Metric.ball
            (Codex.Spherical.FractalDilations.ClusterCapGeometry.euclideanSuccLastSphere 1) ε))
    {E : Set ℝ} {p C : ℝ}
    (hstrong : ∀ f : SchwartzMap (ℝ^2) ℂ,
      MemLp (f : (ℝ^2) → ℂ) (ENNReal.ofReal p) (powerWeightedVolume 2 0) →
        MemLp (restrictedNormalizedSphericalMaximal 2 E (f : (ℝ^2) → ℂ))
          (ENNReal.ofReal p) (powerWeightedVolume 2 0) ∧
        eLpNorm (restrictedNormalizedSphericalMaximal 2 E (f : (ℝ^2) → ℂ))
          (ENNReal.ofReal p) (powerWeightedVolume 2 0) ≤
          ENNReal.ofReal C * eLpNorm (f : (ℝ^2) → ℂ)
            (ENNReal.ofReal p) (powerWeightedVolume 2 0))
    (T : Finset PositiveRadius) {b h R : ℝ} {m : ℝ≥0∞}
    (hT : ∀ r ∈ T, (r : ℝ) ∈ E)
    (hsep : ∀ r ∈ T, ∀ s ∈ T, r ≠ s → 2 * b ≤ |(r : ℝ) - (s : ℝ)|)
    (hm : ∀ r ∈ T, m ≤ powerWeightedVolume 2 0 (radialShell 2 (r : ℝ) b))
    (hppos : 0 < p) (hRpos : 0 < R) (hh : 0 < h) (hhalf : h ≤ 1 / 2)
    (hinner : ∀ r ∈ T, b < (r : ℝ))
    (hmargin : ∀ r ∈ T, b + (r : ℝ) * h ≤ R)
    (hDfinite : powerWeightedVolume 2 0 (Metric.closedBall (0 : (ℝ^2)) (2 * R)) ≠ ∞) :
    (κ * ENNReal.ofReal h / ENNReal.ofReal (Codex.Spherical.SurfaceCore.surfaceMass 2)) *
        ((T.card : ℝ≥0∞) * m) ^ (1 / (ENNReal.ofReal p).toReal) ≤
      ENNReal.ofReal C *
        (powerWeightedVolume 2 0 (Metric.closedBall (0 : (ℝ^2)) (2 * R))) ^
          (1 / (ENNReal.ofReal p).toReal) := by
  classical
  let D : Set (ℝ^2) := Metric.closedBall 0 (2 * R)
  let U : PositiveRadius → Set (ℝ^2) :=
    fun r => radialShell 2 (r : ℝ) b
  let V : Set (ℝ^2) := ⋃ r ∈ (↑T : Set PositiveRadius), U r
  rcases exists_schwartz_nonnegative_ball_test 2 hRpos with
    ⟨g, f, hfg, hgcont, hgnonneg, hgleone, hgone, hzero⟩
  have hp0 : ENNReal.ofReal p ≠ 0 := ne_of_gt (ENNReal.ofReal_pos.mpr hppos)
  have hinput : eLpNorm (f : (ℝ^2) → ℂ) (ENNReal.ofReal p)
      (powerWeightedVolume 2 0) ≤
      (powerWeightedVolume 2 0 D) ^ (1 / (ENNReal.ofReal p).toReal) := by
    dsimp only [D]
    exact eLpNorm_nonnegative_ball_cutoff_le 2 hp0 g f hfg
      hgnonneg hgleone hzero
  have hq : 0 ≤ 1 / (ENNReal.ofReal p).toReal := by
    rw [ENNReal.toReal_ofReal hppos.le]
    positivity
  have hf : MemLp (f : (ℝ^2) → ℂ) (ENNReal.ofReal p)
      (powerWeightedVolume 2 0) := by
    refine ⟨f.continuous.aestronglyMeasurable, ?_⟩
    refine lt_of_le_of_lt hinput ?_
    exact ENNReal.rpow_lt_top_of_nonneg hq (by simpa only [D] using hDfinite)
  have hUmeas : ∀ r ∈ T, MeasurableSet (U r) := by
    intro r hr
    exact measurableSet_radialShell 2 (r : ℝ) b
  have hUdisjoint : (↑T : Set PositiveRadius).PairwiseDisjoint U := by
    intro r hr s hs hrs
    change Disjoint (U r) (U s)
    exact disjoint_radialShell_of_radius_separated 2
      (hsep r (by simpa using hr) s (by simpa using hs) hrs)
  have hVmeas : MeasurableSet V := by
    dsimp only [V]
    exact T.measurableSet_biUnion hUmeas
  have hpoint : ∀ x ∈ V,
      κ * ENNReal.ofReal h / ENNReal.ofReal (Codex.Spherical.SurfaceCore.surfaceMass 2) ≤
        restrictedNormalizedSphericalMaximal 2 E (f : (ℝ^2) → ℂ) x := by
    intro x hx
    rcases Set.mem_iUnion.mp hx with ⟨r, hx⟩
    rcases Set.mem_iUnion.mp hx with ⟨hrT, hxr⟩
    calc
      κ * ENNReal.ofReal h / ENNReal.ofReal (Codex.Spherical.SurfaceCore.surfaceMass 2) ≤
          ENNReal.ofReal ‖Codex.Spherical.SurfaceCore.normalizedSphericalAverage 2
            (fun y => (g y : ℂ)) (r : ℝ) x‖ :=
        circle_radialShell_cap_average_lower κ hκ r.2 (hinner r hrT) (hmargin r hrT)
          hh hhalf g hgcont hgnonneg hgone hxr
      _ = ENNReal.ofReal ‖Codex.Spherical.SurfaceCore.normalizedSphericalAverage 2
          (f : (ℝ^2) → ℂ) (r : ℝ) x‖ := by
        have hfun : (fun y : (ℝ^2) => (g y : ℂ)) = (f : (ℝ^2) → ℂ) := by
          funext y
          exact (hfg y).symm
        rw [hfun]
      _ ≤ restrictedNormalizedSphericalMaximal 2 E (f : (ℝ^2) → ℂ) x :=
        ennreal_norm_normalizedSphericalAverage_le_restrictedNormalizedSphericalMaximal
          f (hT r hrT) r.2 x
  have hvolume : (T.card : ℝ≥0∞) * m ≤ powerWeightedVolume 2 0 V := by
    calc
      (T.card : ℝ≥0∞) * m = ∑ r ∈ T, m := by simp [mul_comm]
      _ ≤ ∑ r ∈ T, powerWeightedVolume 2 0 (U r) := by
        gcongr with r hr
        exact hm r hr
      _ = powerWeightedVolume 2 0 V := by
        dsimp only [V]
        exact (measure_biUnion_finset hUdisjoint hUmeas).symm
  have hbound := restrictedStrongType_knapp_entropy_test_bound_of_bound
    hstrong (f := f) hf hVmeas hpoint hinput hvolume hppos
  simpa only [D] using hbound

/-- The planar origin-ball test in a fixed unit multiplicative window. -/
private theorem circle_unit_localEntropy_lower_of_bound
    (κ : ℝ≥0∞)
    (hκ : ∀ ε : ℝ, 0 < ε → ε ≤ 1 / 2 →
      κ * ENNReal.ofReal (ε ^ 1) ≤
        Codex.Spherical.SurfaceCore.unitSurfaceMeasure 2
          (Metric.ball
            (Codex.Spherical.FractalDilations.ClusterCapGeometry.euclideanSuccLastSphere 1) ε))
    {E : Set ℝ} {p C : ℝ}
    (hstrong : ∀ f : SchwartzMap (ℝ^2) ℂ,
      MemLp (f : (ℝ^2) → ℂ) (ENNReal.ofReal p) (powerWeightedVolume 2 0) →
        MemLp (restrictedNormalizedSphericalMaximal 2 E (f : (ℝ^2) → ℂ))
          (ENNReal.ofReal p) (powerWeightedVolume 2 0) ∧
        eLpNorm (restrictedNormalizedSphericalMaximal 2 E (f : (ℝ^2) → ℂ))
          (ENNReal.ofReal p) (powerWeightedVolume 2 0) ≤
          ENNReal.ofReal C * eLpNorm (f : (ℝ^2) → ℂ)
            (ENNReal.ofReal p) (powerWeightedVolume 2 0))
    (δ : ℝ≥0) (hδ : 0 < δ) (hδone : δ ≤ 1) (hppos : 0 < p) :
    circleCapFactor κ δ *
        ((localMultiplicativeEntropy E ⟨1, by norm_num⟩ 1 δ).toENNReal *
          ballOriginTubeMass 1 0 δ) ^ (1 / (ENNReal.ofReal p).toReal) ≤
      ENNReal.ofReal C *
        (ballOriginInputMass 1 0 δ) ^ (1 / (ENNReal.ofReal p).toReal) := by
  classical
  let c : PositiveRadius := ⟨1, by norm_num⟩
  let b : ℝ := Real.log 2 * (δ : ℝ) / 16
  let h : ℝ := (δ : ℝ) / 8
  let R : ℝ := (δ : ℝ)
  let ρ : ℝ := (1 : ℝ) / 4
  let m : ℝ≥0∞ := ballOriginTubeMass 1 0 δ
  let F : Set ℝ := E ∩ multiplicativeInterval c 1
  obtain ⟨T, hT, hnet, _hlogsep, hphyssep⟩ :=
    exists_finset_unitMultiplicative_packing F c δ hδ (by
      intro r hr
      exact hr.2)
  have hδreal : 0 < (δ : ℝ) := by exact_mod_cast hδ
  have hlogtwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hlogtwole : Real.log 2 ≤ 1 := by
    nlinarith [Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)]
  have hbpos : 0 < b := by
    dsimp only [b]
    positivity
  have hhpos : 0 < h := by
    dsimp only [h]
    positivity
  have hRpos : 0 < R := by
    dsimp only [R]
    exact hδreal
  have hhalf : h ≤ 1 / 2 := by
    dsimp only [h]
    have hδrealone : (δ : ℝ) ≤ 1 := by exact_mod_cast hδone
    linarith
  have hb_le_δ_sixteen : b ≤ (δ : ℝ) / 16 := by
    calc
      b = ((δ : ℝ) / 16) * Real.log 2 := by
        dsimp only [b]
        ring
      _ ≤ ((δ : ℝ) / 16) * 1 := by
        apply mul_le_mul_of_nonneg_left hlogtwole
        positivity
      _ = (δ : ℝ) / 16 := by ring
  have hb_le_sixteen : b ≤ (1 : ℝ) / 16 := by
    have hδrealone : (δ : ℝ) ≤ 1 := by exact_mod_cast hδone
    calc
      b ≤ (δ : ℝ) / 16 := hb_le_δ_sixteen
      _ ≤ (1 : ℝ) / 16 := by gcongr
  have hsep : ∀ r ∈ T, ∀ s ∈ T, r ≠ s →
      2 * b ≤ |(r : ℝ) - (s : ℝ)| := by
    intro r hr s hs hrs
    have hstrict := hphyssep r hr s hs hrs
    dsimp only [c] at hstrict
    have hscale : 2 * b ≤ Real.log 2 * (δ : ℝ) / 4 := by
      dsimp only [b]
      nlinarith [mul_nonneg (le_of_lt hlogtwo) (le_of_lt hδreal)]
    exact hscale.trans (by simpa using hstrict.le)
  have hinner : ∀ r ∈ T, b < (r : ℝ) := by
    intro r hr
    have hrhalf := half_center_le_radius_of_mem_unitMultiplicativeInterval c
      (hT r hr).2
    change (1 : ℝ) / 2 ≤ (r : ℝ) at hrhalf
    linarith
  have hmargin : ∀ r ∈ T, b + (r : ℝ) * h ≤ R := by
    intro r hr
    have hrupper := radius_le_two_center_of_mem_unitMultiplicativeInterval c
      (hT r hr).2
    dsimp only [c] at hrupper
    have hrupper' : (r : ℝ) ≤ 2 := by simpa using hrupper
    have hδrealone : (δ : ℝ) ≤ 1 := by exact_mod_cast hδone
    dsimp only [h, R]
    calc
      b + (r : ℝ) * ((δ : ℝ) / 8) ≤
          (δ : ℝ) / 16 + 2 * ((δ : ℝ) / 8) := by gcongr
      _ ≤ (δ : ℝ) := by linarith
  have hm : ∀ r ∈ T, m ≤ powerWeightedVolume 2 0
      (radialShell 2 (r : ℝ) b) := by
    intro r hr
    have hrhalf := half_center_le_radius_of_mem_unitMultiplicativeInterval c
      (hT r hr).2
    change (1 : ℝ) / 2 ≤ (r : ℝ) at hrhalf
    have hρr : ρ ≤ (r : ℝ) := by
      dsimp only [ρ]
      linarith
    rw [powerWeightedVolume_zero]
    calc
      m = volume (Codex.Spherical.PowerWeights.AnisotropicTubeLower.graphTube
          1 (r : ℝ) 0 ρ b) := by
        dsimp only [m, ρ, b]
        rw [Codex.Spherical.PowerWeights.AnisotropicTubeLower.volume_graphTube]
        simp only [ballOriginTubeMass, ENNReal.rpow_zero, one_mul]
        rw [show 2 * (Real.log 2 * (δ : ℝ) / 16) =
          Real.log 2 * (δ : ℝ) / 8 by ring]
      _ ≤ volume (radialShell 2 (r : ℝ) b) :=
        measure_mono (graphTube_subset_radialShell 1 r.2.le hρr)
  have hDfinite : powerWeightedVolume 2 0
      (Metric.closedBall (0 : (ℝ^2)) (2 * R)) ≠ ∞ := by
    rw [powerWeightedVolume_zero]
    exact ne_of_lt measure_closedBall_lt_top
  have hbound := circle_finite_knapp_bound_of_bound κ hκ hstrong T
    (by
      intro r hr
      exact (hT r hr).1)
    hsep hm hppos hRpos hhpos hhalf hinner hmargin hDfinite
  let centers : Set ℝ := logRadius '' (↑T : Set PositiveRadius)
  have hcover : Metric.IsCover (δ / 2) (logRadiusSet F) centers := by
    rintro u ⟨r, hrF, rfl⟩
    obtain ⟨t, htT, hrt⟩ := hnet r (by simpa only [F] using hrF)
    refine ⟨logRadius t, ⟨t, htT, rfl⟩, ?_⟩
    change edist (logRadius r) (logRadius t) ≤ ((δ / 2 : ℝ≥0) : ℝ≥0∞)
    rw [edist_dist]
    apply ENNReal.ofReal_le_coe.mpr
    simpa only [Real.dist_eq, NNReal.coe_div, NNReal.coe_ofNat] using hrt
  have hCcard : centers.encard = T.card := by
    have hC : centers = (↑(T.image logRadius) : Set ℝ) := by
      ext u
      simp [centers]
    rw [hC, Set.encard_coe_eq_coe_finsetCard,
      Finset.card_image_of_injective T logRadius_injective]
  have hentropyENat : localMultiplicativeEntropy E c 1 δ ≤ T.card := by
    change Metric.externalCoveringNumber (δ / 2) (logRadiusSet F) ≤ T.card
    rw [← hCcard]
    exact hcover.externalCoveringNumber_le_encard
  have hentropy : (localMultiplicativeEntropy E c 1 δ).toENNReal ≤
      (T.card : ℝ≥0∞) := by
    exact_mod_cast ENat.toENNReal_mono hentropyENat
  have hinput : powerWeightedVolume 2 0
      (Metric.closedBall (0 : (ℝ^2)) (2 * R)) = ballOriginInputMass 1 0 δ := by
    dsimp only [R]
    simp [powerWeightedVolume_zero, ballOriginInputMass]
  have hq : 0 ≤ 1 / (ENNReal.ofReal p).toReal := by
    rw [ENNReal.toReal_ofReal hppos.le]
    positivity
  calc
    circleCapFactor κ δ *
        ((localMultiplicativeEntropy E ⟨1, by norm_num⟩ 1 δ).toENNReal *
          ballOriginTubeMass 1 0 δ) ^ (1 / (ENNReal.ofReal p).toReal) ≤
        (κ * ENNReal.ofReal h /
          ENNReal.ofReal (Codex.Spherical.SurfaceCore.surfaceMass 2)) *
          ((T.card : ℝ≥0∞) * m) ^ (1 / (ENNReal.ofReal p).toReal) := by
      simp only [circleCapFactor]
      dsimp only [c, h, m] at hentropy ⊢
      gcongr
    _ ≤ ENNReal.ofReal C *
        (powerWeightedVolume 2 0
          (Metric.closedBall (0 : (ℝ^2)) (2 * R))) ^
            (1 / (ENNReal.ofReal p).toReal) := hbound
    _ = ENNReal.ofReal C *
        (ballOriginInputMass 1 0 δ) ^ (1 / (ENNReal.ofReal p).toReal) := by
      rw [hinput]

private theorem circle_entropy_le_of_knapp_bound
    {N a m B : ℝ≥0∞} {p : ℝ}
    (hp : 0 < p) (ha0 : a ≠ 0) (hatop : a ≠ (∞ : ℝ≥0∞))
    (hm0 : m ≠ 0) (hmtop : m ≠ (∞ : ℝ≥0∞))
    (h : a * (N * m) ^ (1 / p) ≤ B) :
    N ≤ (B / a) ^ p / m := by
  have hroot : (N * m) ^ (1 / p) ≤ B / a := by
    apply (ENNReal.le_div_iff_mul_le (Or.inl ha0) (Or.inl hatop)).mpr
    simpa [mul_comm] using h
  have hpow := ENNReal.rpow_le_rpow hroot hp.le
  have hNm : N * m ≤ (B / a) ^ p := by
    calc
      N * m = ((N * m) ^ (1 / p)) ^ p := by
        rw [show 1 / p = p⁻¹ by rw [one_div], ENNReal.rpow_inv_rpow hp.ne']
      _ ≤ (B / a) ^ p := hpow
  apply (ENNReal.le_div_iff_mul_le (Or.inl hm0) (Or.inl hmtop)).mpr
  simpa [mul_comm] using hNm

private theorem circle_unitMultiplicativeEntropy_bound_of_bound
    (κ : ℝ≥0∞)
    (hκ : ∀ ε : ℝ, 0 < ε → ε ≤ 1 / 2 →
      κ * ENNReal.ofReal (ε ^ 1) ≤
        Codex.Spherical.SurfaceCore.unitSurfaceMeasure 2
          (Metric.ball
            (Codex.Spherical.FractalDilations.ClusterCapGeometry.euclideanSuccLastSphere 1) ε))
    (hκpos : 0 < κ) (hκtop : κ ≠ ∞)
    {E : Set ℝ} {p C : ℝ}
    (hstrong : ∀ f : SchwartzMap (ℝ^2) ℂ,
      MemLp (f : (ℝ^2) → ℂ) (ENNReal.ofReal p) (powerWeightedVolume 2 0) →
        MemLp (restrictedNormalizedSphericalMaximal 2 E (f : (ℝ^2) → ℂ))
          (ENNReal.ofReal p) (powerWeightedVolume 2 0) ∧
        eLpNorm (restrictedNormalizedSphericalMaximal 2 E (f : (ℝ^2) → ℂ))
          (ENNReal.ofReal p) (powerWeightedVolume 2 0) ≤
          ENNReal.ofReal C * eLpNorm (f : (ℝ^2) → ℂ)
            (ENNReal.ofReal p) (powerWeightedVolume 2 0))
    (δ : ℝ≥0) (hδ : 0 < δ) (hδone : δ ≤ 1) (hppos : 0 < p) :
    (unitMultiplicativeEntropy E δ).toENNReal ≤
      ((ENNReal.ofReal C * (ballOriginInputMass 1 0 δ) ^ (1 / p)) /
        circleCapFactor κ δ) ^ p /
        ballOriginTubeMass 1 0 δ := by
  classical
  unfold unitMultiplicativeEntropy
  rw [ENat.toENNReal_iSup]
  apply iSup_le
  intro c
  let a : ℝ := (c : ℝ)⁻¹
  have hcpos : 0 < (c : ℝ) := c.2
  have ha : 0 < a := by
    dsimp only [a]
    exact inv_pos.mpr hcpos
  have hdil := restrictedNormalizedSphericalMaximal_dilateRadiusSet_bound
    (d := 2) (by omega) hppos ha hstrong
  have htest := circle_unit_localEntropy_lower_of_bound κ hκ hdil δ hδ hδone hppos
  have hcentre :
      (⟨a * (c : ℝ), mul_pos ha c.2⟩ : PositiveRadius) = ⟨1, by norm_num⟩ := by
    apply Subtype.ext
    dsimp only [a]
    exact inv_mul_cancel₀ hcpos.ne'
  have hlocal := localMultiplicativeEntropy_dilateRadiusSet E c 1 δ ha
  rw [hcentre] at hlocal
  rw [hlocal] at htest
  have htest' :
      circleCapFactor κ δ *
          ((localMultiplicativeEntropy E c 1 δ).toENNReal *
            ballOriginTubeMass 1 0 δ) ^ (1 / p) ≤
        ENNReal.ofReal C *
          (ballOriginInputMass 1 0 δ) ^ (1 / p) := by
    simpa only [ENNReal.toReal_ofReal hppos.le] using htest
  have hmpos : 0 < ballOriginTubeMass 1 0 δ := by
    have hlog : 0 < Real.log 2 * (δ : ℝ) / 8 := by positivity
    unfold ballOriginTubeMass
    apply ENNReal.mul_pos
    · exact (ENNReal.rpow_pos (ENNReal.ofReal_pos.mpr (by positivity))
        ENNReal.ofReal_ne_top).ne'
    · apply ne_of_gt
      apply ENNReal.mul_pos
      · exact (Metric.measure_ball_pos volume (0 : (ℝ^1)) (by positivity)).ne'
      · exact (ENNReal.ofReal_pos.mpr hlog).ne'
  have hmtop : ballOriginTubeMass 1 0 δ ≠ (∞ : ℝ≥0∞) := by
    unfold ballOriginTubeMass
    apply ENNReal.mul_ne_top
    · apply ENNReal.rpow_ne_top_of_ne_zero
      · exact (ENNReal.ofReal_pos.mpr (by positivity)).ne'
      · exact ENNReal.ofReal_ne_top
    · apply ENNReal.mul_ne_top
      · exact measure_ball_lt_top.ne
      · exact ENNReal.ofReal_ne_top
  exact circle_entropy_le_of_knapp_bound hppos
    (circleCapFactor_pos hκpos hδ).ne'
    (circleCapFactor_ne_top hκtop δ)
    hmpos.ne' hmtop htest'

private theorem circle_scaled_knapp_entropy_rhs
    {C I cap tube t : ℝ≥0∞} {p u v : ℝ}
    (hp : 0 < p) (ht0 : t ≠ 0) (httop : t ≠ (∞ : ℝ≥0∞))
    (hcap0 : cap ≠ 0) (hcaptop : cap ≠ (∞ : ℝ≥0∞))
    (htube0 : tube ≠ 0) (htubetop : tube ≠ (∞ : ℝ≥0∞)) :
    ((C * (I * t ^ u) ^ (1 / p) / (cap * t ^ v)) ^ p / (tube * t)) =
      ((C * I ^ (1 / p) / cap) ^ p / tube) *
        t ^ (u - v * p - 1) := by
  have hq : 0 ≤ 1 / p := by positivity
  have hroot : (I * t ^ u) ^ (1 / p) =
      I ^ (1 / p) * t ^ (u * (1 / p)) := by
    calc
      (I * t ^ u) ^ (1 / p) = I ^ (1 / p) * (t ^ u) ^ (1 / p) :=
        ENNReal.mul_rpow_of_nonneg _ _ hq
      _ = I ^ (1 / p) * t ^ (u * (1 / p)) := by
        rw [ENNReal.rpow_mul]
  have hu : u * (1 / p) * p = u := by
    field_simp [hp.ne']
  have hnum : (C * (I * t ^ u) ^ (1 / p)) ^ p =
      (C * I ^ (1 / p)) ^ p * t ^ u := by
    calc
      (C * (I * t ^ u) ^ (1 / p)) ^ p =
          ((C * I ^ (1 / p)) * t ^ (u * (1 / p))) ^ p := by
            rw [hroot]
            congr 1
            ring
      _ = (C * I ^ (1 / p)) ^ p * (t ^ (u * (1 / p))) ^ p :=
        ENNReal.mul_rpow_of_nonneg _ _ hp.le
      _ = (C * I ^ (1 / p)) ^ p * t ^ (u * (1 / p) * p) := by
        rw [← ENNReal.rpow_mul]
      _ = (C * I ^ (1 / p)) ^ p * t ^ u := by rw [hu]
  have hden : (cap * t ^ v) ^ p = cap ^ p * t ^ (v * p) := by
    calc
      (cap * t ^ v) ^ p = cap ^ p * (t ^ v) ^ p :=
        ENNReal.mul_rpow_of_nonneg _ _ hp.le
      _ = cap ^ p * t ^ (v * p) := by rw [← ENNReal.rpow_mul]
  have htpos : 0 < t := pos_iff_ne_zero.mpr ht0
  have htpow0 (r : ℝ) : t ^ r ≠ 0 :=
    (ENNReal.rpow_pos htpos httop).ne'
  have htpowtop (r : ℝ) : t ^ r ≠ (∞ : ℝ≥0∞) :=
    ENNReal.rpow_ne_top_of_ne_zero ht0 httop
  have hcappow0 : cap ^ p ≠ 0 :=
    (ENNReal.rpow_pos (pos_iff_ne_zero.mpr hcap0) hcaptop).ne'
  have hcapowtop : cap ^ p ≠ (∞ : ℝ≥0∞) :=
    ENNReal.rpow_ne_top_of_ne_zero hcap0 hcaptop
  have hscale : t ^ u / (t ^ (v * p) * t) =
      t ^ (u - v * p - 1) := by
    rw [show u - v * p - 1 = u - (v * p + 1) by ring,
      ENNReal.rpow_sub u (v * p + 1) ht0 httop,
      ENNReal.rpow_add (v * p) 1 ht0 httop, ENNReal.rpow_one]
  have hconst : (C * I ^ (1 / p) / cap) ^ p =
      (C * I ^ (1 / p)) ^ p / cap ^ p :=
    ENNReal.div_rpow_of_nonneg _ _ hp.le
  rw [ENNReal.div_rpow_of_nonneg _ _ hp.le, hnum, hden]
  calc
    ((C * I ^ (1 / p)) ^ p * t ^ u / (cap ^ p * t ^ (v * p))) /
        (tube * t) =
        ((C * I ^ (1 / p)) ^ p / cap ^ p / tube) *
          (t ^ u / (t ^ (v * p) * t)) := by
      simp only [ENNReal.div_eq_inv_mul]
      rw [ENNReal.mul_inv (Or.inl hcappow0) (Or.inl hcapowtop),
        ENNReal.mul_inv (Or.inl htube0) (Or.inl htubetop),
        ENNReal.mul_inv (Or.inl (htpow0 (v * p))) (Or.inl (htpowtop (v * p)))]
      ring
    _ = ((C * I ^ (1 / p) / cap) ^ p / tube) *
          t ^ (u - v * p - 1) := by
      rw [hconst, hscale]

private theorem circle_unitMultiplicativeEntropy_power_bound_of_bound
    (κ : ℝ≥0∞)
    (hκ : ∀ ε : ℝ, 0 < ε → ε ≤ 1 / 2 →
      κ * ENNReal.ofReal (ε ^ 1) ≤
        Codex.Spherical.SurfaceCore.unitSurfaceMeasure 2
          (Metric.ball
            (Codex.Spherical.FractalDilations.ClusterCapGeometry.euclideanSuccLastSphere 1) ε))
    (hκpos : 0 < κ) (hκtop : κ ≠ ∞)
    {E : Set ℝ} {p C : ℝ}
    (hstrong : ∀ f : SchwartzMap (ℝ^2) ℂ,
      MemLp (f : (ℝ^2) → ℂ) (ENNReal.ofReal p) (powerWeightedVolume 2 0) →
        MemLp (restrictedNormalizedSphericalMaximal 2 E (f : (ℝ^2) → ℂ))
          (ENNReal.ofReal p) (powerWeightedVolume 2 0) ∧
        eLpNorm (restrictedNormalizedSphericalMaximal 2 E (f : (ℝ^2) → ℂ))
          (ENNReal.ofReal p) (powerWeightedVolume 2 0) ≤
          ENNReal.ofReal C * eLpNorm (f : (ℝ^2) → ℂ)
            (ENNReal.ofReal p) (powerWeightedVolume 2 0))
    (hC : 0 < C) (hppos : 0 < p) :
    ∃ A : ℝ≥0∞, A ≠ ∞ ∧ ∀ δ : ℝ≥0, 0 < δ → δ ≤ 1 →
      (unitMultiplicativeEntropy E δ).toENNReal ≤
        A * (δ : ℝ≥0∞) ^ (-(p - 1)) := by
  let A : ℝ≥0∞ :=
    ((ENNReal.ofReal C * (ballOriginInputConstant 1 0) ^ (1 / p) /
      circleCapConstant κ) ^ p / ballOriginTubeConstant 1 0)
  have hinputpos : 0 < ballOriginInputConstant 1 0 := by
    have hclosed : 0 < volume (Metric.closedBall (0 : (ℝ^2)) 2) :=
      lt_of_lt_of_le
        (Metric.measure_ball_pos volume (0 : (ℝ^2)) (by norm_num))
        (measure_mono Metric.ball_subset_closedBall)
    unfold ballOriginInputConstant
    simp only [ENNReal.rpow_zero, one_mul]
    exact hclosed
  have hinputtop : ballOriginInputConstant 1 0 ≠ (∞ : ℝ≥0∞) := by
    unfold ballOriginInputConstant
    simp only [ENNReal.rpow_zero, one_mul]
    exact measure_closedBall_lt_top.ne
  have htubepos : 0 < ballOriginTubeConstant 1 0 := by
    have hlog : 0 < Real.log 2 / 8 := by positivity
    unfold ballOriginTubeConstant
    simp only [ENNReal.rpow_zero, one_mul]
    apply ENNReal.mul_pos
    · exact (Metric.measure_ball_pos volume (0 : (ℝ^1)) (by positivity)).ne'
    · exact (ENNReal.ofReal_pos.mpr hlog).ne'
  have htubetop : ballOriginTubeConstant 1 0 ≠ (∞ : ℝ≥0∞) := by
    unfold ballOriginTubeConstant
    simp only [ENNReal.rpow_zero, one_mul]
    exact ENNReal.mul_ne_top measure_ball_lt_top.ne ENNReal.ofReal_ne_top
  have hinnerpos : 0 < ENNReal.ofReal C *
      (ballOriginInputConstant 1 0) ^ (1 / p) / circleCapConstant κ := by
    apply ENNReal.div_pos
    · apply ne_of_gt
      apply ENNReal.mul_pos
      · exact (ENNReal.ofReal_pos.mpr hC).ne'
      · exact (ENNReal.rpow_pos hinputpos hinputtop).ne'
    · exact circleCapConstant_ne_top hκtop
  have hinnertop : ENNReal.ofReal C *
      (ballOriginInputConstant 1 0) ^ (1 / p) / circleCapConstant κ ≠ (∞ : ℝ≥0∞) := by
    apply ENNReal.div_ne_top
    · apply ENNReal.mul_ne_top
      · exact ENNReal.ofReal_ne_top
      · exact ENNReal.rpow_ne_top_of_ne_zero hinputpos.ne' hinputtop
    · exact (circleCapConstant_pos hκpos).ne'
  have hAtop : A ≠ (∞ : ℝ≥0∞) := by
    dsimp only [A]
    apply ENNReal.div_ne_top
    · exact ENNReal.rpow_ne_top_of_ne_zero hinnerpos.ne' hinnertop
    · exact htubepos.ne'
  refine ⟨A, hAtop, ?_⟩
  intro δ hδ hδone
  have hbound := circle_unitMultiplicativeEntropy_bound_of_bound κ hκ hκpos hκtop
    hstrong δ hδ hδone hppos
  have hinputscale : ballOriginInputMass 1 0 δ =
      ballOriginInputConstant 1 0 * (δ : ℝ≥0∞) ^ (2 : ℝ) := by
    simpa using ballOriginInputMass_scale 1 0 hδ
  have hcapscale := circleCapFactor_scale κ hδ
  have htubescale := ballOriginTubeMass_scale 1 0 hδ
  calc
    (unitMultiplicativeEntropy E δ).toENNReal ≤
        ((ENNReal.ofReal C * (ballOriginInputMass 1 0 δ) ^ (1 / p)) /
          circleCapFactor κ δ) ^ p /
          ballOriginTubeMass 1 0 δ := hbound
    _ = ((ENNReal.ofReal C *
          (ballOriginInputConstant 1 0 * (δ : ℝ≥0∞) ^ (2 : ℝ)) ^ (1 / p) /
          (circleCapConstant κ * (δ : ℝ≥0∞))) ^ p /
          (ballOriginTubeConstant 1 0 * (δ : ℝ≥0∞))) := by
      rw [hinputscale, hcapscale, htubescale]
    _ = A * (δ : ℝ≥0∞) ^ ((2 : ℝ) - 1 * p - 1) := by
      dsimp only [A]
      simpa only [ENNReal.rpow_one] using circle_scaled_knapp_entropy_rhs
        (C := ENNReal.ofReal C) (I := ballOriginInputConstant 1 0)
        (cap := circleCapConstant κ) (tube := ballOriginTubeConstant 1 0)
        (t := (δ : ℝ≥0∞)) (p := p) (u := (2 : ℝ)) (v := (1 : ℝ)) hppos
        (ne_of_gt (by exact_mod_cast hδ)) ENNReal.coe_ne_top
        (circleCapConstant_pos hκpos).ne'
        (circleCapConstant_ne_top hκtop)
        htubepos.ne' htubetop
    _ = A * (δ : ℝ≥0∞) ^ (-(p - 1)) := by
      congr 2
      ring

private theorem not_strongType_of_lt_critical_of_two
    {E : Set ℝ} (hE : E.Nonempty) (hEpos : E ⊆ Ioi (0 : ℝ))
    {p : ℝ≥0∞} (hp : p < ENNReal.ofReal (criticalExponent 2 E)) (hp0 : 0 < p) :
    ¬ HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType 2 E p.toReal 0 := by
  have hptop := ne_top_of_le_ne_top ENNReal.ofReal_ne_top hp.le
  have hpReal : p.toReal < criticalExponent 2 E :=
    (ENNReal.lt_ofReal_iff_toReal_lt hptop).mp hp
  have hpReal0 : 0 < p.toReal := ENNReal.toReal_pos (ne_of_gt hp0) hptop
  intro hstrong
  rcases hstrong with ⟨C, hC, hbound⟩
  rcases Codex.Spherical.FractalDilations.ClusterTubeVolume.exists_unitSurfaceMeasure_poleCap_ge_power 1
      with ⟨κ, hκpos, hκtop, hκ⟩
  rcases circle_unitMultiplicativeEntropy_power_bound_of_bound κ hκ hκpos hκtop
      hbound hC hpReal0 with ⟨A, hAtop, hpower⟩
  have hsmall : ∀ᶠ δ : ℝ≥0 in 𝓝[>] (0 : ℝ≥0), δ ∈ Ioo 0 1 :=
    nhdsGT_basis 0 |>.mem_of_mem zero_lt_one
  have hpower' : ∀ᶠ δ : ℝ≥0 in 𝓝[>] (0 : ℝ≥0),
      (unitMultiplicativeEntropy E δ).toENNReal ≤
        A * (δ : ℝ≥0∞) ^ (-(p.toReal - 1)) := by
    filter_upwards [hsmall] with δ hδ
    exact hpower δ hδ.1 hδ.2.le
  have hM : multiplicativeMinkowskiExponent E ≤ ((p.toReal - 1 : ℝ) : EReal) :=
    multiplicativeMinkowskiExponent_le_of_unitEntropy_power_bound hAtop hpower'
  have hMbot := multiplicativeMinkowskiExponent_ne_bot hE hEpos
  have hMreal : (multiplicativeMinkowskiExponent E).toReal ≤ p.toReal - 1 :=
    EReal.toReal_le_toReal hM hMbot (EReal.coe_ne_top _)
  have hbeta : upperMinkowskiExponent E =
      (multiplicativeMinkowskiExponent E).toReal :=
    upperMinkowskiExponent_eq_multiplicativeMinkowskiExponent_toReal E
  have hcrit : criticalExponent 2 E ≤ p.toReal := by
    rw [criticalExponent]
    change 1 + upperMinkowskiExponent E / ((2 : ℝ) - 1) ≤ p.toReal
    rw [hbeta]
    norm_num
    linarith
  exact (not_le_of_gt hpReal) hcrit

/-- Sharpness below the critical exponent for restricted spherical maximal
operators in every dimension at least two. -/
theorem eLpNorm_restrictedSphericalMaximal_ge_of_lt_criticalExponent
    {d : ℕ} {p : ℝ≥0∞} (hd : 2 ≤ d) {E : Set ℝ}
    (hEne : E.Nonempty) (hE : E ⊆ Ioi 0) (hp0 : 0 < p)
    (hp : p < ENNReal.ofReal (criticalExponent d E)) :
    ∀ C : ℝ, ∃ f : (ℝ^d) → ℂ, MemLp f p volume ∧ 0 < eLpNorm f p volume ∧
      eLpNorm (M E f) p volume ≥ ENNReal.ofReal C * eLpNorm f p volume := by
  have hptop := ne_top_of_le_ne_top ENNReal.ofReal_ne_top hp.le
  have hnot : ¬ HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType
      d E p.toReal 0 := by
    by_cases hd2 : d = 2
    · subst d
      exact not_strongType_of_lt_critical_of_two hEne hE hp hp0
    · have hd3 : 3 ≤ d := by omega
      exact not_strongType_of_lt_critical_of_three_le hd3 hEne hE hp hp0
  exact exists_raw_counterexample_of_not_strongType hp0 hptop hnot

end

