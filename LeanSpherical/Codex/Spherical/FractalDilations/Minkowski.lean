/-- `F` is covered by the finite family `ι` of closed intervals of radius
`δ / 2`.  Thus every interval in the cover has length `δ`. -/
def IsIntervalCover (F : Set ℝ) (δ : ℝ) (ι : Finset ℝ) : Prop :=
  F ⊆ ⋃ a ∈ ι, Icc (a - δ / 2) (a + δ / 2)

