          q4LevelShellRelation R level n i l -> ‖K i l z‖ <= A := by
        intro i l z hlevel
        have hactive := hlevel.1
        rw [show K i l z = q4ActiveDyadicPairKernel psi j i l z by
          exact q4ActiveDyadicRestrictedPairKernel_eq_of_mem
            psi j hactive.1 hactive.2 z]
        simpa only [A, q4ActiveDyadicPositiveGapKernelConstant, R, level,
          q4LevelShellRelation, if_neg hnzero] using hstationary n i l z hlevel
      change eLpNorm (fun z => ‖q4FiniteProductKernelShell volume
        (activeDyadicIndices E j) (q4LevelShellRelation R level n) K g z‖)
        (ENNReal.ofReal q) (q4ActiveDyadicProductCountingMeasure d E j) <= _
      simpa only [H, A, D, q4ActiveDyadicLevelStrongConstant, if_neg hnzero,
        q4ActiveDyadicPositiveGapStrongConstant, q4ActiveDyadicPositiveGapSquareConstant] using
        q4ActiveDyadicProductLevel_strong_of_literal_endpoints
          (q4LevelShellRelation R level n)
          (q4ActiveDyadicProductLevel_symm E j n) D hD hdegree
          K A hA hkernel H hp1 hp2 hq g (hdomain n) hgp hI0 hI0pos
  calc
    eLpNorm (fun z => ‖q4FiniteProductKernelShell volume
        (activeDyadicIndices E j) (fun _ _ => True)
        (q4ActiveDyadicPairKernel psi j) g z‖)
        (ENNReal.ofReal q) (q4ActiveDyadicProductCountingMeasure d E j) =
        eLpNorm (fun z => ‖q4FiniteProductKernelShell volume
          (activeDyadicIndices E j) (fun _ _ => True) K g z‖)
          (ENNReal.ofReal q) (q4ActiveDyadicProductCountingMeasure d E j) := by
      apply eLpNorm_congr_ae
      filter_upwards with z
      rw [q4FiniteProductKernelShell_activeDyadicRestricted_eq
        j psi (activeDyadicIndices E j) rfl (fun _ _ => True) g z]
    _ = eLpNorm (fun z => ‖q4FiniteProductKernelShell volume
          (activeDyadicIndices E j) R K g z‖)
          (ENNReal.ofReal q) (q4ActiveDyadicProductCountingMeasure d E j) := by
      apply eLpNorm_congr_ae
      filter_upwards with z
      rw [q4FiniteProductKernelShell_full_eq_activeDyadicRelation E j volume K g z]
    _ <= ∑ n ∈ Finset.range (j + 3),
        eLpNorm (fun z => ‖q4FiniteProductKernelShell volume
          (activeDyadicIndices E j) (q4LevelShellRelation R level n) K g z‖)
          (ENNReal.ofReal q) (q4ActiveDyadicProductCountingMeasure d E j) := by
      simpa only [R, level] using hreassembly
    _ <= ∑ n ∈ Finset.range (j + 3),
        q4ActiveDyadicLevelStrongConstant d gamma eta Ccover Ckernel B j n q *
          eLpNorm g (ENNReal.ofReal p) (q4ActiveDyadicProductCountingMeasure d E j) := by
      exact Finset.sum_le_sum fun n hn => hlevels n (Finset.mem_range.mp hn)

/-- Homogeneous active-multiplier form of the preceding literal endpoint
full-product estimate. -/
theorem q4ActiveDyadicFullProductPairShell_eLpNorm_le_levelSum_of_active_multiplier_homogeneous
    {d : Nat} {E : Set Real} {gamma eta Ccover : Real} {j : Nat}
    (hd : 1 <= d) (hj : 1 <= j)
    (hE : E ⊆ Icc (1 : Real) 2)
    (hcover : HasSubpowerAssouadCoverBound E gamma eta Ccover)
    (hCcover : 0 <= Ccover) (hgamma : 0 <= gamma)
    (hdeltaone : dyadicScale j < 1)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    {Ckernel B : Real} (hCkernel : 0 < Ckernel)
    (hdecay : HasQ4DyadicPairKernelGapDecayOn d (fun _ => psi)
      (1 / 2 : Real) (5 / 2) Ckernel)
    (hB : 0 <= B)
    (hmultiplier : forall i ∈ activeDyadicIndices E j,
      forall l ∈ activeDyadicIndices E j, forall xi : Euclidean d,
        ‖q4ActiveDyadicPairMultiplier psi hpsiCompact j i l xi‖ <= B)
    {p q I0 : Real} (hp1 : 1 < p) (hp2 : p < 2)
    (hq : q = p / (p - 1))
    (g : Euclidean d × {i // i ∈ activeDyadicIndices E j} -> Complex)
    (hgmeas : Measurable g)
    (hgint : Integrable g (q4ActiveDyadicProductCountingMeasure d E j))
    (hgsq : Integrable (fun z => ‖g z‖ ^ (2 : Nat))
      (q4ActiveDyadicProductCountingMeasure d E j))
    (hfib : forall i ∈ activeDyadicIndices E j,
      Integrable (q4FiniteProductToFibres (activeDyadicIndices E j) g i) volume /\
        MemLp (q4FiniteProductToFibres (activeDyadicIndices E j) g i) 2 volume)
    (hgp : Integrable (fun z => ‖g z‖ ^ p)
      (q4ActiveDyadicProductCountingMeasure d E j))
    (hI0 : I0 = ∫ z, ‖g z‖ ^ p ∂q4ActiveDyadicProductCountingMeasure d E j) :
    eLpNorm (q4FiniteProductKernelShell volume (activeDyadicIndices E j)
      (fun _ _ => True) (q4ActiveDyadicPairKernel psi j) g)
      (ENNReal.ofReal q) (q4ActiveDyadicProductCountingMeasure d E j) <=
      (∑ n ∈ Finset.range (j + 3),
        q4ActiveDyadicLevelStrongConstant d gamma eta Ccover Ckernel B j n q) *
          eLpNorm g (ENNReal.ofReal p) (q4ActiveDyadicProductCountingMeasure d E j) := by
  by_cases hI0pos : 0 < I0
  · have hstrong := q4ActiveDyadicFullProductPairShell_eLpNorm_le_levelSum_of_active_multiplier
      hd hj hE hcover hCcover hgamma hdeltaone psi hpsiCompact hCkernel hdecay hB
        hmultiplier hp1 hp2 hq g hgmeas hgint hgsq hfib hgp hI0 hI0pos
    simpa only [eLpNorm_norm] using hstrong
  · have hI0nonneg : 0 <= I0 := by
      rw [hI0]
      exact integral_nonneg fun z => Real.rpow_nonneg (norm_nonneg (g z)) _
    have hI0zero : I0 = 0 := le_antisymm (le_of_not_gt hI0pos) hI0nonneg
    have hzero : (∫ z, ‖g z‖ ^ p ∂q4ActiveDyadicProductCountingMeasure d E j) = 0 :=
      hI0.symm.trans hI0zero
    have hshellzero : q4FiniteProductKernelShell volume
        (activeDyadicIndices E j) (fun _ _ => True)
        (q4ActiveDyadicPairKernel psi j) g = 0 := by
      exact q4FiniteProductKernelShell_eq_zero_of_integral_norm_rpow_eq_zero
        volume (activeDyadicIndices E j) (fun _ _ => True)
        (q4ActiveDyadicPairKernel psi j) g (by linarith) hgp hzero
    rw [hshellzero]
    simp

/-- The literal physical-times-counting product used to test the ordinary
active endpoint family by its canonical `L^q` power dual. -/
noncomputable def q4ActiveDyadicPowerDualProductField
    {d : Nat} (E : Set Real) (j : Nat)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (q : Real) (f : SchwartzMap (Euclidean d) Complex) :
    Euclidean d × {i // i ∈ activeDyadicIndices E j} -> Complex :=
  q4FibresToFiniteProduct (activeDyadicIndices E j)
    (q4PowerDualField q (fun i =>
      (q4DyadicSurfaceSchwartzPiece psi hpsiCompact (dyadicLeft j i) f :
        Euclidean d -> Complex)))

/-- On each active fibre, the product field is the canonical power dual of
the corresponding literal endpoint analysis output. -/
theorem q4FiniteProductToFibres_q4ActiveDyadicPowerDualProductField
    {d : Nat} (E : Set Real) (j : Nat)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (q : Real) (f : SchwartzMap (Euclidean d) Complex)
    (i : Int) (hi : i ∈ activeDyadicIndices E j) :
    q4FiniteProductToFibres (activeDyadicIndices E j)
      (q4ActiveDyadicPowerDualProductField E j psi hpsiCompact q f) i =
      q4PowerDualField q (fun k =>
        (q4DyadicSurfaceSchwartzPiece psi hpsiCompact (dyadicLeft j k) f :
          Euclidean d -> Complex)) i := by
  funext x
  exact q4FiniteProductToFibres_q4FibresToFiniteProduct_apply
    (activeDyadicIndices E j)
    (q4PowerDualField q (fun k =>
      (q4DyadicSurfaceSchwartzPiece psi hpsiCompact (dyadicLeft j k) f :
        Euclidean d -> Complex))) i hi x

/-- Measurability of the endpoint power-dual product follows from the
continuous Schwartz representatives of its finitely many fibres. -/
theorem measurable_q4ActiveDyadicPowerDualProductField
    {d : Nat} (E : Set Real) (j : Nat)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (q : Real) (hq : 2 <= q) (f : SchwartzMap (Euclidean d) Complex) :
    Measurable (q4ActiveDyadicPowerDualProductField E j psi hpsiCompact q f) := by
  unfold q4ActiveDyadicPowerDualProductField
  apply measurable_q4FibresToFiniteProduct_of_continuous
  intro i
  exact (q4PowerDualField_mem_Q4PhysicalDualCarrier q hq
    (fun k => q4DyadicSurfaceSchwartzPiece psi hpsiCompact (dyadicLeft j k) f) i).2.2.1

/-- The endpoint power-dual product is integrable on the literal finite
physical-times-counting product. -/
theorem integrable_q4ActiveDyadicPowerDualProductField
    {d : Nat} (E : Set Real) (j : Nat)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (q : Real) (hq : 2 <= q) (f : SchwartzMap (Euclidean d) Complex) :
    Integrable (q4ActiveDyadicPowerDualProductField E j psi hpsiCompact q f)
      (q4ActiveDyadicProductCountingMeasure d E j) := by
  unfold q4ActiveDyadicPowerDualProductField
  apply integrable_q4FibresToFiniteProduct_of_fibres
  · exact measurable_q4ActiveDyadicPowerDualProductField E j psi hpsiCompact q hq f
  · intro i hi
    exact (q4PowerDualField_mem_Q4PhysicalDualCarrier q hq
      (fun k => q4DyadicSurfaceSchwartzPiece psi hpsiCompact (dyadicLeft j k) f) i).1

/-- The ordinary endpoint power-dual product has an integrable square. -/
theorem integrable_norm_sq_q4ActiveDyadicPowerDualProductField
    {d : Nat} (E : Set Real) (j : Nat)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (q : Real) (hq : 2 <= q) (f : SchwartzMap (Euclidean d) Complex) :
    Integrable (fun z => ‖q4ActiveDyadicPowerDualProductField
      E j psi hpsiCompact q f z‖ ^ (2 : Nat))
      (q4ActiveDyadicProductCountingMeasure d E j) := by
  unfold q4ActiveDyadicPowerDualProductField
  apply integrable_norm_sq_q4FibresToFiniteProduct_of_fibres
  · exact measurable_q4ActiveDyadicPowerDualProductField E j psi hpsiCompact q hq f
  · intro i hi
    exact (q4PowerDualField_mem_Q4PhysicalDualCarrier q hq
      (fun k => q4DyadicSurfaceSchwartzPiece psi hpsiCompact (dyadicLeft j k) f) i).2.1

/-- Every active fibre of the ordinary endpoint power-dual product is an
honest physical `L¹ ∩ L²` function. -/
theorem q4ActiveDyadicPowerDualProductField_fibre_regular
    {d : Nat} (E : Set Real) (j : Nat)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (q : Real) (hq : 2 <= q) (f : SchwartzMap (Euclidean d) Complex)
    (i : Int) (hi : i ∈ activeDyadicIndices E j) :
    Integrable (q4FiniteProductToFibres (activeDyadicIndices E j)
      (q4ActiveDyadicPowerDualProductField E j psi hpsiCompact q f) i) volume /\
      MemLp (q4FiniteProductToFibres (activeDyadicIndices E j)
        (q4ActiveDyadicPowerDualProductField E j psi hpsiCompact q f) i) 2 volume := by
  rw [q4FiniteProductToFibres_q4ActiveDyadicPowerDualProductField
    E j psi hpsiCompact q f i hi]
  exact ⟨(q4PowerDualField_mem_Q4PhysicalDualCarrier q hq
      (fun k => q4DyadicSurfaceSchwartzPiece psi hpsiCompact (dyadicLeft j k) f) i).1,
    (q4PowerDualField_mem_Q4PhysicalDualCarrier q hq
      (fun k => q4DyadicSurfaceSchwartzPiece psi hpsiCompact (dyadicLeft j k) f) i).2.1⟩

/-- The dual-exponent moment of the endpoint power-dual product follows
from the exact pointwise identity `(q - 1) q' = q`. -/
theorem integrable_norm_rpow_q4ActiveDyadicPowerDualProductField
    {d : Nat} (E : Set Real) (j : Nat)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (q qdual : Real) (hq : 1 < q) (hqtwo : 2 <= q) (hqdual : 0 <= qdual)
    (hmul : (q - 1) * qdual = q)
    (f : SchwartzMap (Euclidean d) Complex) :
    Integrable (fun z => ‖q4ActiveDyadicPowerDualProductField
      E j psi hpsiCompact q f z‖ ^ qdual)
      (q4ActiveDyadicProductCountingMeasure d E j) := by
  let F : Int -> SchwartzMap (Euclidean d) Complex := fun i =>
    q4DyadicSurfaceSchwartzPiece psi hpsiCompact (dyadicLeft j i) f
  have hqpos : 0 < q := lt_trans zero_lt_one hq
  have hmeas : Measurable (q4ActiveDyadicPowerDualProductField
      E j psi hpsiCompact q f) :=
    measurable_q4ActiveDyadicPowerDualProductField E j psi hpsiCompact q hqtwo f
  apply integrable_norm_rpow_q4FibresToFiniteProduct_of_fibres
    (activeDyadicIndices E j) (q4PowerDualField q (fun i => (F i : Euclidean d -> Complex)))
    (by simpa only [F, q4ActiveDyadicPowerDualProductField] using hmeas) qdual
  intro i hi
  have hmem : MemLp (F i : Euclidean d -> Complex) (ENNReal.ofReal q) volume :=
    (F i).memLp (ENNReal.ofReal q) volume
  have hsource : Integrable (fun x : Euclidean d => ‖F i x‖ ^ q) volume := by
    have hraw := hmem.integrable_norm_rpow
      (ENNReal.ofReal_ne_zero_iff.mpr hqpos) ENNReal.ofReal_ne_top
    simpa only [ENNReal.toReal_ofReal hqpos.le] using hraw
  refine hsource.congr ?_
  filter_upwards with x
  rw [norm_q4PowerDualField q hq (fun k => (F k : Euclidean d -> Complex)) i x,
    ← Real.rpow_mul (norm_nonneg (F i x))]
  rw [hmul]

/-- The literal ordinary full kernel on its canonical power-dual product is
a.e.-strongly measurable.  The proof is fibrewise: the literal convolution
is identified with the completed finite `L²` analysis--synthesis shell. -/
theorem aestronglyMeasurable_q4ActiveDyadicFullKernelPowerDualProduct
    {d : Nat} (E : Set Real) (j : Nat)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (q : Real) (hq : 2 <= q) (f : SchwartzMap (Euclidean d) Complex) :
    AEStronglyMeasurable
      (q4FiniteProductKernelShell volume (activeDyadicIndices E j) (fun _ _ => True)
        (q4ActiveDyadicPairKernel psi j)
        (q4ActiveDyadicPowerDualProductField E j psi hpsiCompact q f))
      (q4ActiveDyadicProductCountingMeasure d E j) := by
  let s : Finset Int := activeDyadicIndices E j
  let G : Euclidean d × {i // i ∈ s} -> Complex :=
    q4ActiveDyadicPowerDualProductField E j psi hpsiCompact q f
  let P : Int -> Lp Complex 2 (volume : Measure (Euclidean d)) := fun i =>
    q4L2FiniteProductAnalysis
      (fun k => q4DyadicSurfaceL2Piece psi hpsiCompact (dyadicLeft j k))
      (q4L2FiniteFibreSynthesis s
        (fun k => q4DyadicSurfaceAdjointL2Piece psi hpsiCompact (dyadicLeft j k))
        (q4ActiveDyadicSchwartzAnalysisPowerDualL2 psi hpsiCompact j q hq f)) i
  change AEStronglyMeasurable
    (q4FiniteProductKernelShell volume s (fun _ _ => True)
      (q4ActiveDyadicPairKernel psi j) G)
    (q4FiniteProductCountingMeasure volume s)
  apply aestronglyMeasurable_q4FiniteProduct_of_fibres volume s
  intro i
  have hphysical := q4ActiveDyadicSchwartzPowerDualFullKernel_ae_eq_l2AnalysisSynthesis
    psi hpsiCompact j s q hq f i.1 i.2
  have hphysical' :
      q4FiniteProductToFibres s
        (q4FiniteProductKernelShell volume s (fun _ _ => True)
          (q4ActiveDyadicPairKernel psi j) G) i.1 =ᵐ[volume]
        (fun x : Euclidean d =>
          ((P i.1 : Lp Complex 2 (volume : Measure (Euclidean d))) :
            Euclidean d -> Complex) x) := by
    simpa only [s, G, P, q4ActiveDyadicPowerDualProductField] using hphysical
  have hslice :
      (fun x : Euclidean d =>
        q4FiniteProductKernelShell volume s (fun _ _ => True)
          (q4ActiveDyadicPairKernel psi j) G (x, i)) =ᵐ[volume]
        (fun x : Euclidean d =>
          ((P i.1 : Lp Complex 2 (volume : Measure (Euclidean d))) :
            Euclidean d -> Complex) x) := by
    filter_upwards [hphysical'] with x hx
    simpa only [q4FiniteProductToFibres, dif_pos i.2] using hx
  exact (Lp.memLp (P i.1)).aestronglyMeasurable.congr_ae hslice.symm

/-- A literal full-product strong estimate on the canonical endpoint power
dual gives the fibre root moment needed by the finite `TT*` diagonal. -/
theorem q4ActiveDyadicCanonicalFullProduct_rootMoment_le_of_eLpStrongENNReal_sq
    {d : Nat} (E : Set Real) (j : Nat)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (q qdual : Real) (hq : 1 < q) (hqtwo : 2 <= q)
    (hqdual : 0 < qdual) (hmul : (q - 1) * qdual = q)
    (C : ENNReal) (hC : C ≠ ⊤)
    (f : SchwartzMap (Euclidean d) Complex)
    (hstrong :
      eLpNorm
        (q4FiniteProductKernelShell volume (activeDyadicIndices E j) (fun _ _ => True)
          (q4ActiveDyadicPairKernel psi j)
          (q4ActiveDyadicPowerDualProductField E j psi hpsiCompact q f))
        (ENNReal.ofReal q) (q4ActiveDyadicProductCountingMeasure d E j) <=
      C * eLpNorm (q4ActiveDyadicPowerDualProductField E j psi hpsiCompact q f)
        (ENNReal.ofReal qdual) (q4ActiveDyadicProductCountingMeasure d E j)) :
    (q4FibreLpMoment volume (activeDyadicIndices E j) q
      (q4FiniteProductToFibres (activeDyadicIndices E j)
        (q4FiniteProductKernelShell volume (activeDyadicIndices E j) (fun _ _ => True)
          (q4ActiveDyadicPairKernel psi j)
          (q4ActiveDyadicPowerDualProductField E j psi hpsiCompact q f)))) ^ (1 / q) <=
      (Real.sqrt C.toReal) * (Real.sqrt C.toReal) *
        (q4FibreLpMoment volume (activeDyadicIndices E j) qdual
          (q4PowerDualField q (fun i =>
            (q4DyadicSurfaceSchwartzPiece psi hpsiCompact (dyadicLeft j i) f :
              Euclidean d -> Complex)))) ^ (1 / qdual) := by
  let s : Finset Int := activeDyadicIndices E j
  let G : Euclidean d × {i // i ∈ s} -> Complex :=
    q4ActiveDyadicPowerDualProductField E j psi hpsiCompact q f
  have hGmeas : Measurable G := by
    simpa only [s, G] using
      measurable_q4ActiveDyadicPowerDualProductField E j psi hpsiCompact q hqtwo f
  have hGpow : Integrable (fun z => ‖G z‖ ^ qdual)
      (q4FiniteProductCountingMeasure volume s) := by
    simpa only [s, G] using
      integrable_norm_rpow_q4ActiveDyadicPowerDualProductField
        E j psi hpsiCompact q qdual hq hqtwo hqdual.le hmul f
  have houtmeas : AEStronglyMeasurable
      (q4FiniteProductKernelShell volume s (fun _ _ => True)
        (q4ActiveDyadicPairKernel psi j) G)
      (q4FiniteProductCountingMeasure volume s) := by
    simpa only [s, G] using
      aestronglyMeasurable_q4ActiveDyadicFullKernelPowerDualProduct
        E j psi hpsiCompact q hqtwo f
  have hroot := q4FibreLpMoment_root_le_of_product_eLpNorm_aestronglyMeasurable
    volume s
    (q4FiniteProductKernelShell volume s (fun _ _ => True)
      (q4ActiveDyadicPairKernel psi j) G)
    G (D := C.toReal) (lt_trans zero_lt_one hq) hqdual ENNReal.toReal_nonneg
      houtmeas hGmeas hGpow (by
        rw [← ENNReal.ofReal_toReal hC] at hstrong
        exact hstrong)
  have hGfibres : q4FiniteProductToFibres s G =
      q4PowerDualField q (fun i =>
        (q4DyadicSurfaceSchwartzPiece psi hpsiCompact (dyadicLeft j i) f :
          Euclidean d -> Complex)) := by
    funext i x
    exact q4FiniteProductToFibres_q4ActiveDyadicPowerDualProductField
      E j psi hpsiCompact q f i i.2 x
  have hsq : (Real.sqrt C.toReal) * (Real.sqrt C.toReal) = C.toReal := by
    rw [← pow_two]
    exact Real.sq_sqrt ENNReal.toReal_nonneg
  simpa only [s, G, hGfibres, hsq] using hroot

end

end Codex.Spherical.FractalDilations.Q4ActualEndpointFullProduct