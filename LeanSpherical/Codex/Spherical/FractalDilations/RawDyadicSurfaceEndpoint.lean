    ENNReal.toReal_nonneg
  have hA : 0 ≤ A := by
    dsimp only [A]
    exact mul_nonneg hB hvol
  apply rawDyadicSurfaceMaximalReal_le_of_uniform_kernel_bound (A := A)
    E (absoluteDyadicBandpass phi hphiOne hphiZero j)
    (absoluteDyadicBandpass_compact phi hphiOne hphiZero j) f hA hf hfmeas
  intro r hr z
  apply norm_rawDyadicSurfaceKernel_absoluteDyadicBandpass_le_volume_of_sharp_on_half
    C hC hdecay phi hphiOne hphiZero hphiNorm j hj r
  constructor
  · exact le_trans (by norm_num) (hE hr).1
  · exact le_trans (hE hr).2 (by norm_num)

/-- The same literal fixed-frequency endpoint in the original
Schwartz-facing API.  This is the form used with the rational low/high
Schwartz decomposition in the interpolation argument. -/
def absoluteDyadicSurfaceL1EndpointConstant (n : Nat) (C : Real) (j : Nat) : Real :=
  ‖((surfaceMass (n + 1))⁻¹ : Complex)‖ *
    (q4EnlargedSurfaceMultiplierBound C ((n : Real) / 2) j *
      (volume (ball (0 : Euclidean (n + 1)) ((2 : Real) ^ (j + 2)))).toReal)

/-- Positivity of the explicit literal `L¹ → L∞` coefficient. -/
theorem absoluteDyadicSurfaceL1EndpointConstant_nonneg
    (n : Nat) {C : Real} (hC : 0 ≤ C) (j : Nat) :
    0 ≤ absoluteDyadicSurfaceL1EndpointConstant n C j := by
  unfold absoluteDyadicSurfaceL1EndpointConstant
  apply mul_nonneg (norm_nonneg _)
  apply mul_nonneg
  · unfold q4EnlargedSurfaceMultiplierBound
    exact mul_nonneg (by norm_num)
      (div_nonneg hC (Real.rpow_nonneg (by positivity) _))
  · exact ENNReal.toReal_nonneg

theorem fractalDyadicBandpassMaximal_absoluteDyadicBandpass_le_of_sharp
    {n : Nat} {E : Set Real} (C : Real) (hC : 0 < C)
    (hdecay : ∀ z : Euclidean (n + 1), 1 ≤ ‖z‖ →
      ‖surfaceFourier (n + 1) z‖ ≤ C / ‖z‖ ^ ((n : Real) / 2))
    (phi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : ∀ z, ‖z‖ ≤ 1 → phi z = 1)
    (hphiZero : ∀ z, 2 ≤ ‖z‖ → phi z = 0)
    (hphiNorm : ∀ z, ‖phi z‖ ≤ 1)
    (j : Nat) (hj : 1 ≤ j) (hE : E ⊆ Icc (1 : Real) 2)
    (f : SchwartzMap (Euclidean (n + 1)) Complex)
    (x : Euclidean (n + 1)) :
    fractalDyadicBandpassMaximal (n + 1) E
      (absoluteDyadicBandpass phi hphiOne hphiZero j) f x ≤
      absoluteDyadicSurfaceL1EndpointConstant n C j *
        ∫ y, ‖(f : Euclidean (n + 1) -> Complex) y‖ := by
  rw [fractalDyadicBandpassMaximal_eq_rawDyadicSurfaceMaximalReal E
    (absoluteDyadicBandpass phi hphiOne hphiZero j) f
    (absoluteDyadicBandpass_compact phi hphiOne hphiZero j) x]
  simpa only [absoluteDyadicSurfaceL1EndpointConstant] using
    (rawDyadicSurfaceMaximalReal_absoluteDyadicBandpass_le_of_sharp
      C hC hdecay phi hphiOne hphiZero hphiNorm j hj hE
      (f : Euclidean (n + 1) -> Complex) f.integrable
      f.continuous.aestronglyMeasurable)

/-- The literal one-radius endpoint facts needed by the cutoff
interpolation: the original fixed-j maximal operator is nonnegative,
subadditive on the Schwartz carrier, measurable, and obeys the actual
compact-bandpass `L¹ → L∞` estimate.  The separate `L² → Lʳ` input is
supplied by the literal `Q4` calculation. -/
theorem fractalDyadicBandpassMaximal_literal_l1_endpoint_facts_of_sharp
    {n : Nat} {E : Set Real} (C : Real) (hC : 0 < C)
    (hdecay : ∀ z : Euclidean (n + 1), 1 ≤ ‖z‖ →
      ‖surfaceFourier (n + 1) z‖ ≤ C / ‖z‖ ^ ((n : Real) / 2))
    (phi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : ∀ z, ‖z‖ ≤ 1 → phi z = 1)
    (hphiZero : ∀ z, 2 ≤ ‖z‖ → phi z = 0)
    (hphiNorm : ∀ z, ‖phi z‖ ≤ 1)
    (j : Nat) (hj : 1 ≤ j) (hE : E ⊆ Icc (1 : Real) 2) :
    (∀ g : SchwartzMap (Euclidean (n + 1)) Complex,
      ∀ x, 0 ≤ fractalDyadicBandpassMaximal (n + 1) E
        (absoluteDyadicBandpass phi hphiOne hphiZero j) g x) ∧
    (∀ g h : SchwartzMap (Euclidean (n + 1)) Complex, ∀ x,
      fractalDyadicBandpassMaximal (n + 1) E
        (absoluteDyadicBandpass phi hphiOne hphiZero j) (g + h) x ≤
      fractalDyadicBandpassMaximal (n + 1) E
        (absoluteDyadicBandpass phi hphiOne hphiZero j) g x +
      fractalDyadicBandpassMaximal (n + 1) E
        (absoluteDyadicBandpass phi hphiOne hphiZero j) h x) ∧
    (∀ g : SchwartzMap (Euclidean (n + 1)) Complex,
      AEMeasurable (fractalDyadicBandpassMaximal (n + 1) E
        (absoluteDyadicBandpass phi hphiOne hphiZero j) g) volume) ∧
    (∀ g : SchwartzMap (Euclidean (n + 1)) Complex, ∀ x,
      fractalDyadicBandpassMaximal (n + 1) E
        (absoluteDyadicBandpass phi hphiOne hphiZero j) g x ≤
        absoluteDyadicSurfaceL1EndpointConstant n C j *
          ∫ y, ‖(g : Euclidean (n + 1) -> Complex) y‖) := by
  have hd : 0 < n + 1 := by omega
  have hEpos : E ⊆ Ioi (0 : Real) := by
    intro r hr
    exact lt_of_lt_of_le zero_lt_one (hE hr).1
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro g x
    exact fractalDyadicBandpassMaximal_nonneg E
      (absoluteDyadicBandpass phi hphiOne hphiZero j) g x
  · intro g h x
    exact fractalDyadicBandpassMaximal_add_le hd E hEpos
      (absoluteDyadicBandpass phi hphiOne hphiZero j) g h x
  · intro g
    exact (measurable_fractalDyadicBandpassMaximal E
      (absoluteDyadicBandpass phi hphiOne hphiZero j) g).aemeasurable
  · intro g x
    exact fractalDyadicBandpassMaximal_absoluteDyadicBandpass_le_of_sharp
      C hC hdecay phi hphiOne hphiZero hphiNorm j hj hE g x

end

