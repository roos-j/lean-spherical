      sphericalAverage d (absoluteCutoffProjection φ N f : Euclidean d → ℂ) r x) =
      fun N => ∫ ξ : Euclidean d, F N ξ by
        funext N
        rw [sphericalAverage_absoluteCutoffProjection, Real.fourierInv_eq]
        rfl,
    show sphericalAverage d (f : Euclidean d → ℂ) r x =
      ∫ ξ : Euclidean d, G ξ by
        rw [sphericalAverage_eq_fourierInv_surfaceMultiplier_schwartz f r,
          Real.fourierInv_eq]
        rfl]
  exact hInt

