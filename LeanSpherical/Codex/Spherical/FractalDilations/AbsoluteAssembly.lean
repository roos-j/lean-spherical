      (𝓝 (ENNReal.ofReal
        ‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖)) :=
    (ENNReal.continuous_ofReal.tendsto _).comp hW.norm
  have hPow : Tendsto (fun N : ℕ => (ENNReal.ofReal ‖W N‖) ^ p) atTop
      (𝓝 ((ENNReal.ofReal
        ‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖) ^ p)) :=
    (ENNReal.continuous_rpow_const.tendsto _).comp hE
  have hPow' : Tendsto (fun N : ℕ => ENNReal.ofReal (‖W N‖ ^ p)) atTop
      (𝓝 (ENNReal.ofReal
        (‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖ ^ p))) := by
    simpa only [ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hpNN] using hPow
  have hle (N : ℕ) : ENNReal.ofReal (‖W N‖ ^ p) ≤
      ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p) := by
    have hU_nonneg : 0 ≤ fractalAbsoluteCutoffMaximal d E φ N f x :=
      fractalAbsoluteCutoffMaximal_nonneg E φ N f x
    rw [← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hpNN,
      ← ENNReal.ofReal_rpow_of_nonneg hU_nonneg hpNN]
    apply ENNReal.rpow_le_rpow _ hpNN
    rw [show ENNReal.ofReal (fractalAbsoluteCutoffMaximal d E φ N f x) =
        fractalSphericalMaximal d E
          (absoluteCutoffProjection φ N f : Euclidean d → ℂ) x by
      change ENNReal.ofReal
        ((fractalSphericalMaximal d E
          (absoluteCutoffProjection φ N f : Euclidean d → ℂ) x).toReal) =
        fractalSphericalMaximal d E
          (absoluteCutoffProjection φ N f : Euclidean d → ℂ) x
      exact ENNReal.ofReal_toReal
        (fractalSphericalMaximal_ne_top hd0 E hEpos
          (absoluteCutoffProjection φ N f) x)]
    dsimp only [W]
    exact normalizedSphericalAverage_le_fractalSphericalMaximal E
      (absoluteCutoffProjection φ N f : Euclidean d → ℂ) r.2 x
  calc
    ENNReal.ofReal (‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖ ^ p) =
        liminf (fun N : ℕ => ENNReal.ofReal (‖W N‖ ^ p)) atTop :=
      hPow'.liminf_eq.symm
    _ ≤ liminf (fun N : ℕ =>
        ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p)) atTop :=
      Filter.liminf_le_liminf (Filter.Eventually.of_forall hle)

/-- The pointwise Fatou comparison used by both diagonal and off-diagonal
absolute-frequency reassembly. -/
theorem fractal_spherical_maximal_power_le_liminf_absolute_cutoff
    {d : ℕ} {p : ℝ} (hd0 : 0 < d) (hp0 : 0 < p) (hpNN : 0 ≤ p)
    (E : Set ℝ) (hEpos : E ⊆ Ioi (0 : ℝ))
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hφone : ∀ ξ, ‖ξ‖ ≤ 1 → φ ξ = 1)
    (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    ENNReal.ofReal ((fractalSphericalMaximalReal d E f x) ^ p) ≤
      liminf (fun N : ℕ =>
        ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p)) atTop := by
  let V : SchwartzMap (Euclidean d) ℂ → Euclidean d → ℝ :=
    fun g x => fractalSphericalMaximalReal d E g x
  have hVtop (g : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
      fractalSphericalMaximal d E (g : Euclidean d → ℂ) x ≠ ⊤ :=
    fractalSphericalMaximal_ne_top hd0 E hEpos g x
  have hV_eq (g : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
      ENNReal.ofReal (V g x) = fractalSphericalMaximal d E (g : Euclidean d → ℂ) x := by
    exact ENNReal.ofReal_toReal (hVtop g x)
  have hpoint : ENNReal.ofReal ((V f x) ^ p) ≤
      liminf (fun N : ℕ =>
        ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p)) atTop := by
    have hVnonneg : 0 ≤ V f x := ENNReal.toReal_nonneg
    rw [← ENNReal.ofReal_rpow_of_nonneg hVnonneg hpNN, hV_eq]
    unfold fractalSphericalMaximal
    have hpowmax :
        (⨆ r : E, ENNReal.ofReal
          ‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖) ^ p =
          ⨆ r : E, (ENNReal.ofReal
            ‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖) ^ p := by
      let e : ENNReal ≃o ENNReal :=
        (ENNReal.strictMono_rpow_of_pos hp0).orderIsoOfSurjective _
          (ENNReal.rpow_left_bijective hp0.ne.symm).2
      change e (⨆ r : E, ENNReal.ofReal
        ‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖) =
          ⨆ r : E, e (ENNReal.ofReal
            ‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖)
      exact e.map_iSup _
    rw [hpowmax]
    apply iSup_le
    intro r
    rw [ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hpNN]
    exact normalized_spherical_average_power_le_liminf_absolute_cutoff
      hd0 hpNN E hEpos φ hφone f r x
  simpa only [V] using hpoint

/-- Uniform strong estimates for the finite absolute cutoffs pass to the
restricted spherical maximal operator.  This is the Fatou step for the
absolute-frequency decomposition. -/
theorem absolute_reassembly_limit
    {d : ℕ} {p : ℝ} (hd0 : 0 < d) (hp0 : 0 < p)
    (E : Set ℝ) (hEpos : E ⊆ Ioi (0 : ℝ))
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hφone : ∀ ξ, ‖ξ‖ ≤ 1 → φ ξ = 1)
    (A : ℝ) (hA : 0 < A)
    (hfinite : ∀ (N : ℕ) (f : SchwartzMap (Euclidean d) ℂ),
      MemLp (fractalAbsoluteCutoffMaximal d E φ N f) (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean d,
        (fractalAbsoluteCutoffMaximal d E φ N f x) ^ p) ≤
        A * ∫ x : Euclidean d, ‖f x‖ ^ p) :
    HasFractalSphericalStrongType d E p p := by
  have hpNN : 0 ≤ p := hp0.le
  have hpEN0 : ENNReal.ofReal p ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp0
  have hpENT : ENNReal.ofReal p ≠ ⊤ := ENNReal.ofReal_ne_top
  have hUmeas (N : ℕ) (f : SchwartzMap (Euclidean d) ℂ) :
      AEMeasurable (fun x : Euclidean d =>
        ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p)) volume := by
    have hmeas : AEMeasurable (fun x : Euclidean d =>
        (ENNReal.ofReal (fractalAbsoluteCutoffMaximal d E φ N f x)) ^ p) volume :=
      ENNReal.continuous_rpow_const.measurable.comp_aemeasurable
        ((hfinite N f).1.1.aemeasurable.ennreal_ofReal)
    convert hmeas using 1
    funext x
    exact (ENNReal.ofReal_rpow_of_nonneg
      (fractalAbsoluteCutoffMaximal_nonneg E φ N f x) hpNN).symm
  have hUPowInt (N : ℕ) (f : SchwartzMap (Euclidean d) ℂ) :
      Integrable (fun x : Euclidean d =>
        (fractalAbsoluteCutoffMaximal d E φ N f x) ^ p) volume := by
    have h := (hfinite N f).1.integrable_norm_rpow hpEN0 hpENT
    convert h using 1
    funext x
    rw [Real.norm_eq_abs,
      abs_of_nonneg (fractalAbsoluteCutoffMaximal_nonneg E φ N f x),
      ENNReal.toReal_ofReal hpNN]
  have hUint (N : ℕ) (f : SchwartzMap (Euclidean d) ℂ) :
      (∫⁻ x : Euclidean d,
        ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p)) ≤
        ENNReal.ofReal (A * ∫ x : Euclidean d, ‖f x‖ ^ p) := by
    calc
      (∫⁻ x : Euclidean d,
        ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p)) =
          ENNReal.ofReal (∫ x : Euclidean d,
            (fractalAbsoluteCutoffMaximal d E φ N f x) ^ p) := by
          rw [ofReal_integral_eq_lintegral_ofReal (hUPowInt N f)]
          exact Filter.Eventually.of_forall fun x =>
            Real.rpow_nonneg (fractalAbsoluteCutoffMaximal_nonneg E φ N f x) p
      _ ≤ ENNReal.ofReal (A * ∫ x : Euclidean d, ‖f x‖ ^ p) :=
        ENNReal.ofReal_le_ofReal (hfinite N f).2
  have hFatou (f : SchwartzMap (Euclidean d) ℂ) :
      (∫⁻ x : Euclidean d,
        ENNReal.ofReal ((fractalSphericalMaximalReal d E f x) ^ p)) ≤
        liminf (fun N : ℕ =>
          ∫⁻ x : Euclidean d,
            ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p)) atTop := by
    calc
      (∫⁻ x : Euclidean d,
        ENNReal.ofReal ((fractalSphericalMaximalReal d E f x) ^ p)) ≤
          ∫⁻ x : Euclidean d,
            liminf (fun N : ℕ =>
              ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p)) atTop :=
        lintegral_mono (fun x =>
          fractal_spherical_maximal_power_le_liminf_absolute_cutoff
            hd0 hp0 hpNN E hEpos φ hφone f x)
      _ ≤ liminf (fun N : ℕ =>
          ∫⁻ x : Euclidean d,
            ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p)) atTop :=
        lintegral_liminf_le' fun N => hUmeas N f
  have hLiminfBound (f : SchwartzMap (Euclidean d) ℂ) :
      liminf (fun N : ℕ =>
        ∫⁻ x : Euclidean d,
          ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p)) atTop ≤
        ENNReal.ofReal (A * ∫ x : Euclidean d, ‖f x‖ ^ p) :=
    Filter.liminf_le_of_frequently_le'
      (Filter.Frequently.of_forall fun N => hUint N f)
  have hlin (f : SchwartzMap (Euclidean d) ℂ) :
      (∫⁻ x : Euclidean d,
        ENNReal.ofReal ((fractalSphericalMaximalReal d E f x) ^ p)) ≤
        ENNReal.ofReal (A * ∫ x : Euclidean d, ‖f x‖ ^ p) :=
    (hFatou f).trans (hLiminfBound f)
  apply HasFractalSphericalMomentStrongType.toStrongType hp0
  refine ⟨A, hA, ?_⟩
  intro f
  have hmaxmeas : AEStronglyMeasurable (fractalSphericalMaximalReal d E f) volume :=
    (measurable_fractalSphericalMaximalReal E f).aestronglyMeasurable
  have hmaxnonneg : ∀ x, 0 ≤ fractalSphericalMaximalReal d E f x := by
    intro x
    exact ENNReal.toReal_nonneg
  have hright : 0 ≤ A * ∫ x : Euclidean d, ‖f x‖ ^ p :=
    mul_nonneg hA.le (integral_nonneg fun _ => Real.rpow_nonneg (norm_nonneg _) p)
  rcases memLp_and_integral_of_lintegral_rpow_bound
    (fractalSphericalMaximalReal d E f) hmaxmeas hmaxnonneg hp0 (hlin f) hright with
      ⟨hmem, hmoment⟩
  refine ⟨hmem, ?_⟩
  calc
    (∫ x : Euclidean d, ‖fractalSphericalMaximalReal d E f x‖ ^ p) =
        ∫ x : Euclidean d, (fractalSphericalMaximalReal d E f x) ^ p := by
          apply integral_congr_ae
          filter_upwards with x
          rw [Real.norm_of_nonneg (hmaxnonneg x)]
    _ ≤ A * ∫ x : Euclidean d, ‖f x‖ ^ p := hmoment

/-- The level-zero absolute cutoff has a uniform restricted-maximal
strong-type estimate.  The proof only uses the smooth local lowpass bound;
the restriction `E ⊆ [1,2]` is used to compare it with the raw interval
maximal function. -/
theorem absolute_lowpass_strong_type
    {d : ℕ} (hd0 : 0 < d) (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2)
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hφzero : ∀ ξ, 2 ≤ ‖ξ‖ → φ ξ = 0)
    (hφnorm : ∀ ξ, ‖φ ξ‖ ≤ 1) {p : ℝ}
    (hp1 : 1 < p) (hp2 : p < 2) :
    ∃ B : ℝ, 0 < B ∧ ∀ f : SchwartzMap (Euclidean d) ℂ,
      MemLp (fractalSphericalMaximalReal d E
        (absoluteCutoffProjection φ 0 f)) (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean d,
        (fractalSphericalMaximalReal d E
          (absoluteCutoffProjection φ 0 f) x) ^ p) ≤
        B * ∫ x : Euclidean d, ‖f x‖ ^ p := by
  obtain ⟨C, hC, hraw⟩ :=
    smooth_lowpass_interval_strong_type hd0 φ hφzero hφnorm hp1 hp2
  let k : ℝ := (surfaceMass d)⁻¹
  let B : ℝ := k ^ p * C
  have hmass : 0 < surfaceMass d := surfaceMass_pos hd0
  have hk : 0 < k := by
    dsimp only [k]
    exact inv_pos.mpr hmass
  have hB : 0 < B := by
    dsimp only [B]
    exact mul_pos (Real.rpow_pos_of_pos hk _) hC
  refine ⟨B, hB, ?_⟩
  intro f
  have hEpos : E ⊆ Ioi (0 : ℝ) := by
    intro r hr
    exact lt_of_lt_of_le zero_lt_one (hE hr).1
  let R : Euclidean d → ℝ := fun x =>
    sphericalIntervalMaximalRaw 1 2 (dyadicBandpassProjection φ f) x
  let M : Euclidean d → ℝ := fun x =>
    fractalSphericalMaximalReal d E (absoluteCutoffProjection φ 0 f) x
  have hR0 (x : Euclidean d) : 0 ≤ R x :=
    sphericalIntervalMaximalRaw_nonneg 1 2 (dyadicBandpassProjection φ f) x
  have hM0 (x : Euclidean d) : 0 ≤ M x := ENNReal.toReal_nonneg
  have hpoint (x : Euclidean d) : M x ≤ k * R x := by
    dsimp only [M, R, k]
    calc
      fractalSphericalMaximalReal d E (absoluteCutoffProjection φ 0 f) x ≤
          fractalSphericalMaximalReal d (Icc (1 : ℝ) 2)
            (absoluteCutoffProjection φ 0 f) x :=
        fractalSphericalMaximalReal_mono hd0 hE
          (by intro r hr; exact lt_of_lt_of_le zero_lt_one hr.1)
          (absoluteCutoffProjection φ 0 f) x
      _ ≤ (surfaceMass d)⁻¹ *
          sphericalIntervalMaximalRaw 1 2 (absoluteCutoffProjection φ 0 f) x :=
        fractalSphericalMaximalReal_interval_le_inv_surfaceMass_mul_raw
          hd0 (by norm_num : (1 : ℝ) ≤ 2) (absoluteCutoffProjection φ 0 f) x
      _ = (surfaceMass d)⁻¹ *
          sphericalIntervalMaximalRaw 1 2 (dyadicBandpassProjection φ f) x := by
        rw [absoluteCutoffProjection_zero]
  have hrawmem : MemLp R (ENNReal.ofReal p) volume := by
    simpa only [R] using (hraw f).1
  have hscaledmem : MemLp (fun x : Euclidean d => k * R x)
      (ENNReal.ofReal p) volume := hrawmem.const_mul k
  have hMmem : MemLp M (ENNReal.ofReal p) volume := by
    apply hscaledmem.mono
      (measurable_fractalSphericalMaximalReal E (absoluteCutoffProjection φ 0 f)).aestronglyMeasurable
    filter_upwards with x
    rw [Real.norm_of_nonneg (hM0 x),
      Real.norm_of_nonneg (mul_nonneg hk.le (hR0 x))]
    exact hpoint x
  have hp0 : 0 < p := lt_trans zero_lt_one hp1
  have hpE0 : ENNReal.ofReal p ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp0
  have hpET : ENNReal.ofReal p ≠ ⊤ := ENNReal.ofReal_ne_top
  have hMint : Integrable (fun x : Euclidean d => M x ^ p) volume := by
    have h := hMmem.integrable_norm_rpow hpE0 hpET
    convert h using 1
    funext x
    rw [Real.norm_eq_abs, abs_of_nonneg (hM0 x),
      ENNReal.toReal_ofReal hp0.le]
  have hscaledint : Integrable (fun x : Euclidean d => (k * R x) ^ p) volume := by
    have h := hscaledmem.integrable_norm_rpow hpE0 hpET
    convert h using 1
    funext x
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hk.le (hR0 x)),
      ENNReal.toReal_ofReal hp0.le]
  refine ⟨?_, ?_⟩
  · simpa only [M] using hMmem
  · calc
      (∫ x : Euclidean d, M x ^ p) ≤ ∫ x : Euclidean d, (k * R x) ^ p :=
        integral_mono hMint hscaledint (fun x =>
          Real.rpow_le_rpow (hM0 x) (hpoint x) hp0.le)
      _ = k ^ p * ∫ x : Euclidean d, R x ^ p := by
        rw [show (fun x : Euclidean d => (k * R x) ^ p) =
            fun x => k ^ p * R x ^ p by
          funext x
          rw [Real.mul_rpow hk.le (hR0 x)]]
        rw [integral_const_mul]
      _ ≤ k ^ p * (C * ∫ x : Euclidean d, ‖f x‖ ^ p) := by
        apply mul_le_mul_of_nonneg_left
          (by simpa only [R] using (hraw f).2)
          (Real.rpow_nonneg hk.le _)
      _ = B * ∫ x : Euclidean d, ‖f x‖ ^ p := by
        dsimp only [B]
        ring

/-- Finite absolute cutoffs are uniformly bounded once their low frequency
term and their literal absolute dyadic annuli satisfy the displayed moment
estimates. -/
theorem finite_absolute_reassembly_from_estimates
    {d : ℕ} {p : ℝ} (hd0 : 0 < d) (hpone : 1 < p)
    (E : Set ℝ) (hEpos : E ⊆ Ioi (0 : ℝ))
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hφone : ∀ ξ, ‖ξ‖ ≤ 1 → φ ξ = 1)
    (hφzero : ∀ ξ, 2 ≤ ‖ξ‖ → φ ξ = 0)
    (hregular :
      ∃ B : ℝ, 0 < B ∧ ∀ f : SchwartzMap (Euclidean d) ℂ,
        MemLp (fractalSphericalMaximalReal d E
          (absoluteCutoffProjection φ 0 f)) (ENNReal.ofReal p) volume ∧
        (∫ x : Euclidean d,
          (fractalSphericalMaximalReal d E
            (absoluteCutoffProjection φ 0 f) x) ^ p) ≤
          B * ∫ x : Euclidean d, ‖f x‖ ^ p)
    (hdyadic :
      ∃ A ε : ℝ, 0 < A ∧ 0 < ε ∧
        ∀ (j : ℕ) (f : SchwartzMap (Euclidean d) ℂ),
          MemLp (fractalDyadicBandpassMaximal d E
            (absoluteDyadicBandpass φ hφone hφzero j) f) (ENNReal.ofReal p) volume ∧
          (∫ x : Euclidean d,
            (fractalDyadicBandpassMaximal d E
              (absoluteDyadicBandpass φ hφone hφzero j) f x) ^ p) ≤
            A * (2 : ℝ) ^ (-ε * j) * ∫ x : Euclidean d, ‖f x‖ ^ p) :
    ∃ C : ℝ, 0 < C ∧ ∀ (N : ℕ) (f : SchwartzMap (Euclidean d) ℂ),
      MemLp (fractalAbsoluteCutoffMaximal d E φ N f) (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean d,
        (fractalAbsoluteCutoffMaximal d E φ N f x) ^ p) ≤
        C * ∫ x : Euclidean d, ‖f x‖ ^ p := by
  obtain ⟨B, hB, hreg⟩ := hregular
  obtain ⟨A, ε, hA, hε, hdy⟩ := hdyadic
  have hp0 : 0 < p := lt_trans zero_lt_one hpone
  have hpENN : (1 : ENNReal) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]
    exact ENNReal.ofReal_le_ofReal hpone.le
  let ρ : ENNReal := ENNReal.ofReal ((2 : ℝ) ^ (-ε / p))
  let CT : ENNReal := ENNReal.ofReal (A ^ p⁻¹)
  let CR : ENNReal := ENNReal.ofReal (B ^ p⁻¹)
  let D : ENNReal := CR + CT * (1 - ρ)⁻¹
  have hρreal : (2 : ℝ) ^ (-ε / p) < 1 := by
    apply Real.rpow_lt_one_of_one_lt_of_neg
    · norm_num
    · exact div_neg_of_neg_of_pos (neg_lt_zero.mpr hε) hp0
  have hρ : ρ < 1 := by
    dsimp only [ρ]
    exact ENNReal.ofReal_lt_one.mpr hρreal
  have hρpos : 0 < 1 - ρ := tsub_pos_of_lt hρ
  have hρinvtop : (1 - ρ)⁻¹ < ⊤ := ENNReal.inv_lt_top.mpr hρpos
  have hCRtop : CR < ⊤ := by
    dsimp only [CR]
    exact ENNReal.ofReal_lt_top
  have hCTtop : CT < ⊤ := by
    dsimp only [CT]
    exact ENNReal.ofReal_lt_top
  have hDtop : D < ⊤ := by
    dsimp only [D]
    exact ENNReal.add_lt_top.mpr
      ⟨hCRtop, ENNReal.mul_lt_top hCTtop hρinvtop⟩
  let C : ℝ := D.toReal ^ p + 1
  have hC : 0 < C := by
    dsimp only [C]
    positivity
  refine ⟨C, hC, ?_⟩
  intro N f
  let I : ℝ := ∫ x : Euclidean d, ‖f x‖ ^ p
  have hI : 0 ≤ I := by
    dsimp only [I]
    exact integral_nonneg fun x => Real.rpow_nonneg (norm_nonneg _) p
  let hroot : ENNReal := ENNReal.ofReal (I ^ p⁻¹)
  have hR0 (x : Euclidean d) : 0 ≤
      fractalSphericalMaximalReal d E (absoluteCutoffProjection φ 0 f) x :=
    ENNReal.toReal_nonneg
  have hT0 (j : ℕ) (x : Euclidean d) : 0 ≤
      fractalDyadicBandpassMaximal d E
        (absoluteDyadicBandpass φ hφone hφzero j) f x := ENNReal.toReal_nonneg
  have hP0 (x : Euclidean d) : 0 ≤
      fractalAbsoluteCutoffMaximal d E φ N f x :=
    fractalAbsoluteCutoffMaximal_nonneg E φ N f x
  have hRnorm : eLpNorm
      (fractalSphericalMaximalReal d E (absoluteCutoffProjection φ 0 f))
      (ENNReal.ofReal p) volume ≤ CR * hroot := by
    simpa only [CR, hroot] using
      absolute_eLpNorm_le_of_lowpass_moment_bound hp0
        (fractalSphericalMaximalReal d E (absoluteCutoffProjection φ 0 f))
        (hreg f).1 hR0 hB.le hI (by simpa only [I] using (hreg f).2)
  have hTnorm (j : ℕ) : eLpNorm
      (fractalDyadicBandpassMaximal d E
        (absoluteDyadicBandpass φ hφone hφzero j) f)
      (ENNReal.ofReal p) volume ≤
        (CT * hroot) * ρ ^ j := by
    simpa only [CT, hroot, ρ] using
      absolute_eLpNorm_le_of_bandpass_real_moment_bound hp0
        (fractalDyadicBandpassMaximal d E
          (absoluteDyadicBandpass φ hφone hφzero j) f)
        (hdy j f).1 (hT0 j) hA.le hI j
        (by simpa only [I] using (hdy j f).2)
  have hP : MemLp (fractalAbsoluteCutoffMaximal d E φ N f)
      (ENNReal.ofReal p) volume ∧
      eLpNorm (fractalAbsoluteCutoffMaximal d E φ N f)
        (ENNReal.ofReal p) volume ≤ D * hroot := by
    simpa only [D] using
      absolute_finite_reassembly_eLpNorm hpENN
        (fractalAbsoluteCutoffMaximal d E φ N f)
        (fractalSphericalMaximalReal d E (absoluteCutoffProjection φ 0 f))
        (fun j => fractalDyadicBandpassMaximal d E
          (absoluteDyadicBandpass φ hφone hφzero j) f)
        N (measurable_fractalAbsoluteCutoffMaximal E φ N f).aestronglyMeasurable
        (fun x => fractalAbsoluteCutoffMaximal_le_low_add_band_sum
          hd0 E hEpos φ hφone hφzero N f x)
        hP0 hR0 hT0 (hreg f).1 CR hroot hRnorm
        (fun j => (hdy j f).1) CT ρ hTnorm
  refine ⟨hP.1, ?_⟩
  change (∫ x : Euclidean d,
    (fractalAbsoluteCutoffMaximal d E φ N f x) ^ p) ≤ C * I
  apply absolute_cutoff_moment_bound_of_eLpNorm hpone
    (fractalAbsoluteCutoffMaximal d E φ N f) hP.1 hP0 I hI D hDtop.ne
  · simpa only [hroot] using hP.2
  · dsimp only [C]
    exact le_add_of_nonneg_right (by norm_num)

/-- Assemble low and high absolute-frequency estimates and then pass from
the uniformly bounded smooth cutoffs to the restricted maximal operator. -/
theorem absolute_reassembly_from_estimates
    {d : ℕ} {p : ℝ} (hd0 : 0 < d) (hpone : 1 < p)
    (E : Set ℝ) (hEpos : E ⊆ Ioi (0 : ℝ))
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hφone : ∀ ξ, ‖ξ‖ ≤ 1 → φ ξ = 1)
    (hφzero : ∀ ξ, 2 ≤ ‖ξ‖ → φ ξ = 0)
    (hregular :
      ∃ B : ℝ, 0 < B ∧ ∀ f : SchwartzMap (Euclidean d) ℂ,
        MemLp (fractalSphericalMaximalReal d E
          (absoluteCutoffProjection φ 0 f)) (ENNReal.ofReal p) volume ∧
        (∫ x : Euclidean d,
          (fractalSphericalMaximalReal d E
            (absoluteCutoffProjection φ 0 f) x) ^ p) ≤
          B * ∫ x : Euclidean d, ‖f x‖ ^ p)
    (hdyadic :
      ∃ A ε : ℝ, 0 < A ∧ 0 < ε ∧
        ∀ (j : ℕ) (f : SchwartzMap (Euclidean d) ℂ),
          MemLp (fractalDyadicBandpassMaximal d E
            (absoluteDyadicBandpass φ hφone hφzero j) f) (ENNReal.ofReal p) volume ∧
          (∫ x : Euclidean d,
            (fractalDyadicBandpassMaximal d E
              (absoluteDyadicBandpass φ hφone hφzero j) f x) ^ p) ≤
            A * (2 : ℝ) ^ (-ε * j) * ∫ x : Euclidean d, ‖f x‖ ^ p) :
    HasFractalSphericalStrongType d E p p := by
  obtain ⟨A, hA, hfinite⟩ :=
    finite_absolute_reassembly_from_estimates hd0 hpone E hEpos φ hφone hφzero
      hregular hdyadic
  exact absolute_reassembly_limit hd0 (lt_trans zero_lt_one hpone) E hEpos φ hφone
    A hA hfinite

end

end Codex.Spherical.FractalDilations.AbsoluteAssembly