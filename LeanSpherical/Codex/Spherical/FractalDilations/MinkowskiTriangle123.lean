/-- A geometry-light higher-dimensional facade.  It chooses all auxiliary
sub-`L²` Q2 exponents from the strict analytic inequalities satisfied by an
arbitrary vertical source in the open Q1--Q2--Q3 triangle. -/
theorem strict_triangle123_higher_strong_type_of_strict_analytic_conditions
    {n : Nat} (hn : 2 ≤ n)
    {E : Set Real} (hE : E ⊆ Icc (1 : Real) 2) (hEne : E.Nonempty)
    {beta : Real} (hbeta : 0 ≤ beta)
    (hMinkowski : upperMinkowskiDimension E = beta)
    (phi psi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiNorm : ∀ xi, ‖phi xi‖ ≤ 1)
    (hphiRadial : ∀ xi eta : Euclidean (n + 1), ‖xi‖ = ‖eta‖ → phi xi = phi eta)
    (hpsi : ∀ xi : Euclidean (n + 1),
      psi xi = phi (((2 : Real) ^ (0 + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ 0)⁻¹ • xi))
    {p q : Real} (hqtwo : 2 < q)
    (hQ3 : q < (n : Real) + 2 - beta)
    (hp3p : q / (q - 1) < p) (hpq : p < q)
    (hpdiag : beta < n * (p - 1)) :
    HasFractalSphericalStrongType (n + 1) E p q := by
  have hnreal : (2 : Real) ≤ (n : Real) := by exact_mod_cast hn
  have hnpos : 0 < (n : Real) := by linarith
  have hnne : (n : Real) ≠ 0 := hnpos.ne'
  have hbetaone : beta ≤ 1 := by
    have h := upperMinkowskiDimension_le_one_of_subset_Icc hE
    simpa only [hMinkowski] using h
  have hbeta_lt_n : beta < (n : Real) := by linarith
  let p3 : Real := q / (q - 1)
  let eps3 : Real := ((n : Real) + 2 - beta - q) / 2
  have hqminus : 0 < q - 1 := by linarith
  have hp3one : 1 < p3 := by
    dsimp only [p3]
    rw [lt_div_iff₀ hqminus]
    linarith
  have hp3two : p3 < 2 := by
    dsimp only [p3]
    rw [div_lt_iff₀ hqminus]
    linarith
  have hqconj : q = p3 / (p3 - 1) := by
    dsimp only [p3]
    field_simp [hqminus.ne']
    ring
  have heps3 : 0 < eps3 := by
    dsimp only [eps3]
    linarith
  have hQ3strict : q < (n : Real) + 2 - (beta + eps3) := by
    dsimp only [eps3]
    linarith
  have hp3p' : p3 < p := by simpa only [p3] using hp3p
  let rQ : Real := 1 + (1 + beta / (n : Real)) / 2
  have hbeta_div_nonneg : 0 ≤ beta / (n : Real) := div_nonneg hbeta hnpos.le
  have hbeta_div_lt_one : beta / (n : Real) < 1 :=
    (div_lt_one₀ hnpos).mpr hbeta_lt_n
  have hrQone : 1 < rQ := by
    dsimp only [rQ]
    linarith
  have hrQtwo : rQ < 2 := by
    dsimp only [rQ]
    linarith
  have hrQcrit : beta < n * (rQ - 1) := by
    dsimp only [rQ]
    field_simp [hnne]
    nlinarith
  have hrQq : rQ < q := lt_trans hrQtwo hqtwo
  by_cases hpTwo : p < 2
  · let rP : Real := (1 + beta / (n : Real) + p) / 2
    have hbeta_div_lt : beta / (n : Real) < p - 1 :=
      (div_lt_iff₀ hnpos).mpr (by
        simpa only [Nat.cast_sub, Nat.cast_one] using hpdiag)
    have hrPone : 1 < rP := by
      dsimp only [rP]
      linarith
    have hrPtwo : rP < 2 := by
      dsimp only [rP]
      linarith
    have hrPcrit : beta < n * (rP - 1) := by
      dsimp only [rP]
      field_simp [hnne]
      nlinarith
    have hrPp : rP < p := by
      dsimp only [rP]
      linarith
    exact strict_triangle123_higher_strong_type_of_physical_parameters
      hn hE hEne hbeta hMinkowski phi psi hphiOne hphiZero hphiNorm hphiRadial hpsi
      hp3one hp3two hqconj heps3 hQ3strict hp3p' hpq (by linarith)
      hrQone hrQtwo hrQcrit hrQq hrPone hrPtwo hrPcrit hrPp
  · have hpTwo' : 2 ≤ p := le_of_not_gt hpTwo
    exact strict_triangle123_higher_strong_type_of_physical_parameters
      hn hE hEne hbeta hMinkowski phi psi hphiOne hphiZero hphiNorm hphiRadial hpsi
      hp3one hp3two hqconj heps3 hQ3strict hp3p' hpq (by linarith)
      hrQone hrQtwo hrQcrit hrQq hrQone hrQtwo hrQcrit
      (lt_of_lt_of_le hrQtwo hpTwo')

/-- Planar physical Q1--Q2--Q3 assembly.  It has the identical common-cutoff
interface; only the two source estimates use the angular circle calculation. -/
theorem strict_triangle123_planar_strong_type_of_physical_parameters
    {E : Set Real} (hE : E ⊆ Icc (1 : Real) 2) (hEne : E.Nonempty)
    {beta : Real} (hbeta : 0 ≤ beta)
    (hMinkowski : upperMinkowskiDimension E = beta)
    (phi psi : SchwartzMap (Euclidean 2) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiNorm : ∀ xi, ‖phi xi‖ ≤ 1)
    (hphiRadial : ∀ xi eta : Euclidean 2, ‖xi‖ = ‖eta‖ → phi xi = phi eta)
    (hpsi : ∀ xi : Euclidean 2,
      psi xi = phi (((2 : Real) ^ (0 + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ 0)⁻¹ • xi))
    {p q p3 rQ rP eps3 : Real}
    (hp3one : 1 < p3) (hp3two : p3 < 2)
    (hqconj : q = p3 / (p3 - 1)) (heps3 : 0 < eps3)
    (hQ3strict : q < 3 - (beta + eps3))
    (hp3p : p3 < p) (hpq : p < q) (hqone : 1 ≤ q)
    (hrQone : 1 < rQ) (hrQtwo : rQ < 2) (hrQcrit : beta < rQ - 1)
    (hrQq : rQ < q)
    (hrPone : 1 < rP) (hrPtwo : rP < 2) (hrPcrit : beta < rP - 1)
    (hrPp : rP < p) :
    HasFractalSphericalStrongType 2 E p q := by
  obtain ⟨C3, rho3, hC3, hC3top, hrho3, -, hQ3⟩ :=
    circle_q3_physical_strict_normalized_dyadic_rate_of_upperMinkowskiDimension_eq
      hE hEne hMinkowski heps3 hp3one hp3two hqconj hQ3strict
        phi psi hphiOne hphiZero hphiNorm hpsi
  obtain ⟨C2, rho2, hC2, hC2top, hrho2, hrho2one, hQ2all⟩ :=
    circle_q2_physical_upper_diagonal_dyadic_rate_of_upperMinkowskiDimension_eq
      hE hEne hbeta hMinkowski hrQone hrQtwo hrQcrit hrQq
        phi psi hphiOne hphiZero hphiNorm hpsi
  obtain ⟨CP, rhoP, hCP, hCPtop, hrhoP, hrhoPone, hPall⟩ :=
    circle_q2_physical_upper_diagonal_dyadic_rate_of_upperMinkowskiDimension_eq
      hE hEne hbeta hMinkowski hrPone hrPtwo hrPcrit hrPp
        phi psi hphiOne hphiZero hphiNorm hpsi
  let cP : Real := CP.toReal
  have hcP : 0 < cP := by
    dsimp only [cP]
    exact ENNReal.toReal_pos hCP.ne' hCPtop.ne
  have hdiagP : ∀ f : SchwartzMap (Euclidean 2) Complex,
      MemLp (fractalDyadicBandpassMaximal 2 E
        (absoluteDyadicBandpass phi hphiOne hphiZero 0) f)
        (ENNReal.ofReal p) volume ∧
      eLpNorm (fractalDyadicBandpassMaximal 2 E
        (absoluteDyadicBandpass phi hphiOne hphiZero 0) f)
        (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal cP *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
    intro f
    obtain ⟨hmem, hbound⟩ := hPall 0 f
    refine ⟨hmem, ?_⟩
    simpa only [cP, pow_zero, mul_one, ENNReal.ofReal_toReal hCPtop.ne] using hbound
  obtain ⟨Czero, hCzerotop, hzero⟩ :=
    compact_bandpass_improving_eLpNorm_of_diagonal
      (d := 2) (p := p) (q := q) (by norm_num) E hE
      (absoluteDyadicBandpass phi hphiOne hphiZero 0)
      (lt_trans hp3one hp3p) hpq ⟨cP, hcP, hdiagP⟩
  exact strict_triangle123_strong_type_of_literal_q2_q3_rates
    (d := 2) (by norm_num) E hE phi psi hphiOne hphiZero hphiNorm hpsi
    hp3one hp3p hpq hqone hC3top hC2top hrho3 hrho2one
    (by
      intro j hj f
      exact hQ3 j hj f)
    (by
      intro j hj f
      exact hQ2all j f)
    hCzerotop hzero

/-- The planar counterpart of the Q2-side physical assembly.  The only
dimension-specific inputs are the circle Q2 and Q3 literal estimates; the
ordinary same-input interpolation and the reassembly are exactly the common
ones above. -/
theorem strict_triangle123_planar_common_input_strong_type_of_physical_parameters
    {E : Set Real} (hE : E ⊆ Icc (1 : Real) 2) (hEne : E.Nonempty)
    {beta : Real} (hbeta : 0 ≤ beta)
    (hMinkowski : upperMinkowskiDimension E = beta)
    (phi psi : SchwartzMap (Euclidean 2) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiNorm : ∀ xi, ‖phi xi‖ ≤ 1)
    (hphiRadial : ∀ xi eta : Euclidean 2, ‖xi‖ = ‖eta‖ → phi xi = phi eta)
    (hpsi : ∀ xi : Euclidean 2,
      psi xi = phi (((2 : Real) ^ (0 + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ 0)⁻¹ • xi))
    {p q r eps3 : Real}
    (hpone : 1 < p) (hptwo : p < 2) (hpq : p < q)
    (hqpconj : q < p / (p - 1))
    (heps3 : 0 < eps3)
    (hQ3strict : p / (p - 1) < 3 - (beta + eps3))
    (hrone : 1 < r) (hrtwo : r < 2)
    (hrcrit : beta < r - 1) (hrp : r < p) :
    HasFractalSphericalStrongType 2 E p q := by
  obtain ⟨C2, rho2, hC2, hC2top, hrho2, hrho2one, hQ2all⟩ :=
    circle_q2_physical_upper_diagonal_dyadic_rate_of_upperMinkowskiDimension_eq
      hE hEne hbeta hMinkowski hrone hrtwo hrcrit hrp
        phi psi hphiOne hphiZero hphiNorm hpsi
  obtain ⟨C3, rho3, hC3, hC3top, hrho3, -, hQ3⟩ :=
