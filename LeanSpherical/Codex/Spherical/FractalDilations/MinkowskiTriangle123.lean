        phi psi hphiOne hphiZero hphiNorm hpsi
  obtain ⟨CP, rhoP, hCP, hCPtop, hrhoP, hrhoPone, hPall⟩ :=
    q2_physical_upper_diagonal_dyadic_rate_of_upperMinkowskiDimension_eq
      hn hE hEne hbeta hMinkowski hrPone hrPtwo hrPcrit hrPp
        phi psi hphiOne hphiZero hphiNorm hpsi
  let cP : Real := CP.toReal
  have hcP : 0 < cP := by
    dsimp only [cP]
    exact ENNReal.toReal_pos hCP.ne' hCPtop.ne
  have hdiagP : ∀ f : SchwartzMap (Euclidean (n + 1)) Complex,
      MemLp (fractalDyadicBandpassMaximal (n + 1) E
        (absoluteDyadicBandpass phi hphiOne hphiZero 0) f)
        (ENNReal.ofReal p) volume ∧
      eLpNorm (fractalDyadicBandpassMaximal (n + 1) E
        (absoluteDyadicBandpass phi hphiOne hphiZero 0) f)
        (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal cP *
          eLpNorm (f : Euclidean (n + 1) → Complex) (ENNReal.ofReal p) volume := by
    intro f
    obtain ⟨hmem, hbound⟩ := hPall 0 f
    refine ⟨hmem, ?_⟩
    simpa only [cP, pow_zero, mul_one, ENNReal.ofReal_toReal hCPtop.ne] using hbound
  obtain ⟨Czero, hCzerotop, hzero⟩ :=
    compact_bandpass_improving_eLpNorm_of_diagonal
      (d := n + 1) (p := p) (q := q) (by omega) E hE
      (absoluteDyadicBandpass phi hphiOne hphiZero 0)
      (lt_trans hp3one hp3p) hpq ⟨cP, hcP, hdiagP⟩
  exact strict_triangle123_strong_type_of_literal_q2_q3_rates
    (d := n + 1) (by omega) E hE phi psi hphiOne hphiZero hphiNorm hpsi
    hp3one hp3p hpq hqone hC3top hC2top hrho3 hrho2one
    (by
      intro j hj f
      exact hQ3 j hj f)
    (by
      intro j hj f
      exact hQ2all j f)
    hCzerotop hzero

/-- Rate-level version of the common-output physical T123 construction.

This intentionally stops before low-frequency reassembly.  The Q134 argument
needs precisely this literal estimate for the caller-supplied common cutoff
when it interpolates with its Q4 rate. -/
theorem strict_triangle123_higher_common_output_dyadic_rate_of_physical_parameters
    {n : Nat} (hn : 2 ≤ n)
    {E : Set Real} (hE : E ⊆ Icc (1 : Real) 2) (hEne : E.Nonempty)
    {beta : Real} (hbeta : 0 ≤ beta)
    (hMinkowski : upperMinkowskiDimension E = beta)
    (phi psi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiNorm : ∀ xi, ‖phi xi‖ ≤ 1)
    (hpsi : ∀ xi : Euclidean (n + 1),
      psi xi = phi (((2 : Real) ^ (0 + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ 0)⁻¹ • xi))
    {p q p3 rQ eps3 : Real}
    (hp3one : 1 < p3) (hp3two : p3 < 2)
    (hqconj : q = p3 / (p3 - 1)) (heps3 : 0 < eps3)
    (hQ3strict : q < (n : Real) + 2 - (beta + eps3))
    (hp3p : p3 < p) (hprQ : p < rQ) (hqone : 1 ≤ q)
    (hrQone : 1 < rQ) (hrQtwo : rQ < 2)
    (hrQcrit : beta < n * (rQ - 1)) (hrQq : rQ < q) :
    ∃ C rho : ENNReal, C < ⊤ ∧ rho < 1 ∧
      ∀ j : Nat, 1 ≤ j → ∀ f : SchwartzMap (Euclidean (n + 1)) Complex,
        MemLp (fractalDyadicBandpassMaximal (n + 1) E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal q) volume ∧
        eLpNorm (fractalDyadicBandpassMaximal (n + 1) E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal q) volume ≤
          (C * rho ^ j) *
            eLpNorm (f : Euclidean (n + 1) → Complex) (ENNReal.ofReal p) volume := by
  obtain ⟨C3, rho3, hC3, hC3top, hrho3, -, hQ3⟩ :=
    q3_physical_strict_normalized_dyadic_rate_of_upperMinkowskiDimension_eq
      hn hE hEne hMinkowski heps3 hp3one hp3two hqconj hQ3strict
        phi psi hphiOne hphiZero hphiNorm hpsi
  obtain ⟨C2, rho2, hC2, hC2top, hrho2, hrho2one, hQ2all⟩ :=
    q2_physical_upper_diagonal_dyadic_rate_of_upperMinkowskiDimension_eq
      hn hE hEne hbeta hMinkowski hrQone hrQtwo hrQcrit hrQq
        phi psi hphiOne hphiZero hphiNorm hpsi
  exact strict_triangle123_dyadic_rate_of_literal_q2_q3_rates
    (d := n + 1) (by omega) E hE phi hphiOne hphiZero
    hp3one hp3p (lt_trans hprQ hrQq) hqone hC3top hC2top hrho3 hrho2one
    (by
      intro j hj f
      exact hQ3 j hj f)
    (by
      intro j hj f
      exact hQ2all j f)

/-- Higher-dimensional physical assembly on the Q2 side of the strict
Q1--Q2--Q3 triangle.  The Q2 rate is used at the final input exponent `p`,
while the physical Q3 argument gives the conjugate output `p / (p - 1)` at
that same input.  Ordinary same-input interpolation fills every strict
intermediate output. -/
theorem strict_triangle123_higher_common_input_strong_type_of_physical_parameters
    {n : Nat} (hn : 2 ≤ n)
    {E : Set Real} (hE : E ⊆ Icc (1 : Real) 2) (hEne : E.Nonempty)
    {beta : Real} (hbeta : 0 ≤ beta)
    (hMinkowski : upperMinkowskiDimension E = beta)
    (phi psi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiNorm : ∀ xi, ‖phi xi‖ ≤ 1)
    (hphiRadial : ∀ xi eta : Euclidean (n + 1), ‖xi‖ = ‖eta‖ → phi xi = phi eta)
    (hpsi : ∀ xi : Euclidean (n + 1),
      psi xi = phi (((2 : Real) ^ (0 + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ 0)⁻¹ • xi))
    {p q r eps3 : Real}
    (hpone : 1 < p) (hptwo : p < 2) (hpq : p < q)
    (hqpconj : q < p / (p - 1))
    (heps3 : 0 < eps3)
    (hQ3strict : p / (p - 1) < (n : Real) + 2 - (beta + eps3))
    (hrone : 1 < r) (hrtwo : r < 2)
    (hrcrit : beta < n * (r - 1)) (hrp : r < p) :
    HasFractalSphericalStrongType (n + 1) E p q := by
  obtain ⟨C2, rho2, hC2, hC2top, hrho2, hrho2one, hQ2all⟩ :=
    q2_physical_upper_diagonal_dyadic_rate_of_upperMinkowskiDimension_eq
      hn hE hEne hbeta hMinkowski hrone hrtwo hrcrit hrp
        phi psi hphiOne hphiZero hphiNorm hpsi
  obtain ⟨C3, rho3, hC3, hC3top, hrho3, -, hQ3⟩ :=
    q3_physical_strict_normalized_dyadic_rate_of_upperMinkowskiDimension_eq
      (p := p) (q := p / (p - 1))
      hn hE hEne hMinkowski heps3 hpone hptwo (by rfl) hQ3strict
        phi psi hphiOne hphiZero hphiNorm hpsi
  let cP : Real := C2.toReal
  have hcP : 0 < cP := by
    dsimp only [cP]
    exact ENNReal.toReal_pos hC2.ne' hC2top.ne
  have hdiagP : ∀ f : SchwartzMap (Euclidean (n + 1)) Complex,
      MemLp (fractalDyadicBandpassMaximal (n + 1) E
        (absoluteDyadicBandpass phi hphiOne hphiZero 0) f)
        (ENNReal.ofReal p) volume ∧
      eLpNorm (fractalDyadicBandpassMaximal (n + 1) E
        (absoluteDyadicBandpass phi hphiOne hphiZero 0) f)
        (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal cP *
          eLpNorm (f : Euclidean (n + 1) → Complex) (ENNReal.ofReal p) volume := by
    intro f
    obtain ⟨hmem, hbound⟩ := hQ2all 0 f
    refine ⟨hmem, ?_⟩
    simpa only [cP, pow_zero, mul_one, ENNReal.ofReal_toReal hC2top.ne] using hbound
  obtain ⟨Czero, hCzerotop, hzero⟩ :=
    compact_bandpass_improving_eLpNorm_of_diagonal
      (d := n + 1) (p := p) (q := q) (by omega) E hE
      (absoluteDyadicBandpass phi hphiOne hphiZero 0)
      hpone hpq ⟨cP, hcP, hdiagP⟩
  exact strict_triangle123_strong_type_of_literal_q2_q3_common_input_rates
    (d := n + 1) (by omega) E hE phi psi hphiOne hphiZero hphiNorm hpsi
    hpone (lt_trans zero_lt_one hpone) hpq hqpconj hpq
      (le_of_lt (lt_trans hpone hpq)) hC2top hC3top hrho2one hrho3
    (by
      intro j hj f
      exact hQ2all j f)
    (by
      intro j hj f
      exact hQ3 j hj f)
    hCzerotop hzero

/-- Rate-level form of the fixed-input T123 interpolation.  This is kept
separate from its reassembly so a later vertical interpolation can use the
same high-frequency cutoff without changing representatives. -/
theorem strict_triangle123_higher_common_input_dyadic_rate_of_physical_parameters
    {n : Nat} (hn : 2 ≤ n)
    {E : Set Real} (hE : E ⊆ Icc (1 : Real) 2) (hEne : E.Nonempty)
    {beta : Real} (hbeta : 0 ≤ beta)
