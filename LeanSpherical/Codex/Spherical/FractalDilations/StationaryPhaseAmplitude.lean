      (fun u : ℝ => -2 / Real.sqrt (2 - u ^ 2)) (uIcc (0 : ℝ) 1) := by
    simpa [uIcc_of_le] using endpointCoordinate_deriv_continuousOn
  have hF : Continuous F := by
    dsimp [F]
    fun_prop
  have hsubst := intervalIntegral.integral_deriv_smul_comp
