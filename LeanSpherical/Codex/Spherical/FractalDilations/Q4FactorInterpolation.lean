    dsimp [X]
    exact div_pos (mul_pos hA (Real.rpow_pos_of_pos hI _)) hB
  have hpow :
      (X ^ (2 / p)) ^ ((2 - p) / 2) = X ^ (2 / p - 1) := by
    rw [← Real.rpow_mul hX.le]
    congr 1
    field_simp
  rw [hpow]
  change 2 * (B * (X ^ (2 / p - 1) * I ^ ((1 : ℝ) / 2))) = _
  rw [show X = (A * I ^ ((1 : ℝ) / 2)) / B by rfl]
  rw [Real.div_rpow (mul_nonneg hA.le (Real.rpow_nonneg hI.le _)) hB.le]
  rw [Real.mul_rpow hA.le (Real.rpow_nonneg hI.le _)]
  rw [← Real.rpow_mul hI.le]
  rw [div_eq_mul_inv, ← Real.rpow_neg hB.le]
  have hBcombine : B * B ^ (-(2 / p - 1)) = B ^ (2 - 2 / p) := by
    calc
      B * B ^ (-(2 / p - 1)) = B ^ (1 : ℝ) * B ^ (-(2 / p - 1)) := by
        rw [Real.rpow_one]
