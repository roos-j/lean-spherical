/-- A Schwartz input has an integrable real `p`-moment at every positive
exponent.  This is the finite real integral used by the amplitude split. -/
theorem q4_schwartz_integrable_norm_rpow
    {d : Nat} (f : SchwartzMap (Euclidean d) ℂ) {p : ℝ} (hp : 0 < p) :
    Integrable (fun x : Euclidean d => ‖f x‖ ^ p) volume := by
  have hmem : MemLp (f : Euclidean d → ℂ) (ENNReal.ofReal p) volume :=
    f.memLp (ENNReal.ofReal p) volume
  have h := hmem.integrable_norm_rpow
    (ENNReal.ofReal_ne_zero_iff.mpr hp) ENNReal.ofReal_ne_top
  simpa only [ENNReal.toReal_ofReal hp.le] using h

