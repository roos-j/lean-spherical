      t ^ (2 - p) * ‖f x‖ ^ p) volume := hfPow.const_mul _
  rw [← integral_const_mul]
  apply integral_mono hleft hright
  intro x
  exact (rational_low_high_pointwise_bounds f low high ht hp1 hp2 hlow hhigh x).1

