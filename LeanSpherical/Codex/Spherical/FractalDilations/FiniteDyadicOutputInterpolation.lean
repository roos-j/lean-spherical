    (h1 : eLpNorm (T f) (ENNReal.ofReal q1) μ ≤ A1 * ENNReal.ofReal s) :
    eLpNorm (T f) (ENNReal.ofReal q) μ ≤
      twoNearbyStrongOutputInterpolationConstant q0 q q1 A0 A1 *
