    (hTnonneg : ∀ f x, 0 ≤ T f x)
    (hTmeas : ∀ f, AEStronglyMeasurable (T f) volume)
    {p q0 q q1 : Real} (hp : 0 < p)
    (hq0 : 0 < q0) (hq0q : q0 < q) (hqq1 : q < q1)
    (A0 A1 : ENNReal)
    (h0 : ∀ f : SchwartzMap (Euclidean d) Complex,
