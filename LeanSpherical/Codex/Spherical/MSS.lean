/-- The square-function consequence of the conic plate-overlap theorem.
The source support hypotheses are stated directly through
`wavefrontPlateSupport`'s plate model, while the conclusion is the exact
`L⁴` angular recombination estimate used in the MSS proof. -/
def overlapSquareFunction (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real) : Prop :=
  plateOverlap maxLevel angularConstant sectorRadius spacingLower spacingUpper →
    ∀ η : Real, 0 < η → ∃ C : Real, 0 < C ∧
      ∀ gamma : Real, 0 < gamma → gamma < 1 / 10 →
        ∀ scale : Real, 2 ≤ scale →
          ∀ radialIndices angularIndices : Finset Int,
            ∀ directions : Int → Euclidean 2,
              angularSectorGeometry scale angularIndices directions
                sectorRadius spacingLower spacingUpper →
              ∀ G : Int → Int → WaveSpaceTime → Complex,
                (∀ n ∈ radialIndices, ∀ ν ∈ angularIndices,
                  Function.support (spaceTimeFourier (G n ν)) ⊆
                    conicPlate scale gamma angularConstant n (directions ν)) →
                eLpNorm
                    (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices G)
                    (4 : ENNReal) volume ≤
                  ENNReal.ofReal (C * scale ^ η) *
                    eLpNorm (angularRadialSquareFunction radialIndices angularIndices G)
                      (4 : ENNReal) volume

/-- A closed coordinate cube in the planar frequency space.  The radius is
the half side-length; keeping this definition coordinatewise is useful for
the Fourier-cube decompositions in the MSS square-function step. -/
def frequencyCube (center : Euclidean 2) (radius : Real) : Set (Euclidean 2) :=
  {ξ | ∀ i : Fin 2, |ξ i - center i| ≤ radius}

/-- Membership in a planar frequency cube is its coordinatewise bound. -/
theorem mem_frequencyCube_iff (center ξ : Euclidean 2) (radius : Real) :
    ξ ∈ frequencyCube center radius ↔
      ∀ i : Fin 2, |ξ i - center i| ≤ radius := Iff.rfl

/-- A Schwartz multiplier localized to one planar frequency cube.  The
support condition is intentionally separated from the square-overlap
condition: smooth cube cutoffs can overlap near their boundaries. -/
def isFourierCubeCutoff (center : Euclidean 2) (radius : Real)
    (m : SchwartzMap (Euclidean 2) Complex) : Prop :=
  0 ≤ radius ∧ Function.support (m : Euclidean 2 → Complex) ⊆
    frequencyCube center radius

/-- Cube containment in the spatial footprint supplies the spatial hypothesis
of the exact spectral conic-packet theorem above.  This is a spectral
Schwartz construction, not a compact physical-time-cutoff half-wave. -/
theorem support_spaceTimeFourier_spectralCubeRadialNormalPacket_subset_conicPlate_of_cube
    (β : Real → Complex) (scale gamma angularConstant : Real) (n : Int)
    (direction center : Euclidean 2) (radius : Real)
    (temporalProfile g : SchwartzMap Real Complex)
    (hprofile : ∀ τ : Real, temporalProfile τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (cubeProfile : SchwartzMap (Euclidean 2) Complex)
    (hcube : isFourierCubeCutoff center radius cubeProfile)
    (hcubePlate : frequencyCube center radius ⊆
      {ξ | scale / 4 ≤ ‖ξ‖ ∧ ‖ξ‖ ≤ 4 * scale ∧
        ξ ∈ angularSector direction (angularConstant * scale ^ (-(1 / 2 : Real)))})
    (hvertical : ∀ τ : Real,
      β ((Real.sqrt scale)⁻¹ * τ - n) ≠ 0 →
        |(Real.sqrt scale)⁻¹ * τ - n| ≤ 1)
    (hnormal : ∀ ξ : Euclidean 2,
      ξ ∈ Function.support (cubeProfile : Euclidean 2 → Complex) →
      ∀ τ : Real, τ ∈ Function.support (𝓕 (g : Real → Complex)) →
      β ((Real.sqrt scale)⁻¹ * τ - n) ≠ 0 →
        |τ - ‖ξ‖| ≤ 2 * scale ^ gamma) :
    Function.support
        (spaceTimeFourier (spectralCubeRadialNormalPacket β scale n cubeProfile g)) ⊆
      conicPlate scale gamma angularConstant n direction := by
  apply support_spaceTimeFourier_spectralCubeRadialNormalPacket_subset_conicPlate
    β scale gamma angularConstant n direction temporalProfile g hprofile cubeProfile
  · exact hcube.2.trans hcubePlate
  · exact hvertical
  · exact hnormal

/-- A literal spectral-packet instantiation of the still-analytic
`overlapSquareFunction` hypothesis.  Its geometric plate-overlap premise is
closed by the proved translated-unit-normal plate-overlap theorem; the only
remaining hypothesis here is the analytic square-function estimate itself. -/
theorem overlapSquareFunction_spectralCubeRadialNormalPackets
    (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real)
    (hoverlap : overlapSquareFunction maxLevel angularConstant sectorRadius
      spacingLower spacingUpper)
    (hangular : 0 < angularConstant)
    (eta : Real) (heta : 0 < eta)
    (gamma : Real) (hgamma : 0 < gamma) (hgammaUpper : gamma < 1 / 10)
    (scale : Real) (hscale : 2 ≤ scale)
    (radialIndices angularIndices : Finset Int) (directions : Int → Euclidean 2)
    (hgeometry : angularSectorGeometry scale angularIndices directions
      sectorRadius spacingLower spacingUpper)
    (beta : Real → Complex)
    (temporalProfiles g : Int → Int → SchwartzMap Real Complex)
    (cubeProfiles : Int → Int → SchwartzMap (Euclidean 2) Complex)
    (hprofile : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices, ∀ tau : Real,
      temporalProfiles n nu tau = beta ((Real.sqrt scale)⁻¹ * tau - n))
    (hspatial : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      Function.support (cubeProfiles n nu : Euclidean 2 → Complex) ⊆
        {xi | scale / 4 ≤ ‖xi‖ ∧ ‖xi‖ ≤ 4 * scale ∧
          xi ∈ angularSector (directions nu)
            (angularConstant * scale ^ (-(1 / 2 : Real)))})
    (hvertical : ∀ n ∈ radialIndices, ∀ tau : Real,
      beta ((Real.sqrt scale)⁻¹ * tau - n) ≠ 0 →
        |(Real.sqrt scale)⁻¹ * tau - n| ≤ 1)
    (hnormal : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      ∀ xi : Euclidean 2,
      xi ∈ Function.support (cubeProfiles n nu : Euclidean 2 → Complex) →
      ∀ tau : Real, tau ∈ Function.support (𝓕 (g n nu : Real → Complex)) →
      beta ((Real.sqrt scale)⁻¹ * tau - n) ≠ 0 →
        |tau - ‖xi‖| ≤ 2 * scale ^ gamma) :
    ∃ C : Real, 0 < C ∧
      eLpNorm
          (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices
            (fun n nu => spectralCubeRadialNormalPacket beta scale n
              (cubeProfiles n nu) (g n nu)))
          (4 : ENNReal) volume ≤
        ENNReal.ofReal (C * scale ^ eta) *
          eLpNorm
            (angularRadialSquareFunction radialIndices angularIndices
              (fun n nu => spectralCubeRadialNormalPacket beta scale n
                (cubeProfiles n nu) (g n nu)))
            (4 : ENNReal) volume := by
  have hplate : plateOverlap maxLevel angularConstant sectorRadius spacingLower spacingUpper :=
    plateOverlap_of_angularSectorGeometry maxLevel angularConstant sectorRadius
      spacingLower spacingUpper hangular
  rcases hoverlap hplate eta heta with ⟨C, hC, hCbound⟩
  refine ⟨C, hC, ?_⟩
  apply hCbound gamma hgamma hgammaUpper scale hscale radialIndices angularIndices directions
    hgeometry
  exact spectralCubeRadialNormalPackets_satisfy_conicPlateSupport beta scale gamma angularConstant
    radialIndices angularIndices directions temporalProfiles g cubeProfiles
    hprofile hspatial hvertical hnormal

/-- The finite thick-plate output energy can be populated by literal spectral
cube/radial-normal packets.  The two support conclusions ensure that the
packet factors genuinely inhabit the plates used to form each listed output
frequency; no compact physical-time cutoff is involved. -/
theorem exists_finitePlateOverlapSquareEnergy_spectralCubeRadialNormalPackets_le_scaled
    (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real)
    (hangular : 0 < angularConstant)
    (gamma : Real) (hgamma : 0 < gamma) (hgammaUpper : gamma < 1 / 10)
    (scale : Real) (hscale : 2 ≤ scale)
    (radialIndices angularIndices : Finset Int) (directions : Int → Euclidean 2)
    (hgeometry : angularSectorGeometry scale angularIndices directions
      sectorRadius spacingLower spacingUpper)
    (beta : Real → Complex)
    (temporalProfiles g : Int → Int → SchwartzMap Real Complex)
    (cubeProfiles : Int → Int → SchwartzMap (Euclidean 2) Complex)
    (hprofile : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices, ∀ tau : Real,
      temporalProfiles n nu tau = beta ((Real.sqrt scale)⁻¹ * tau - n))
    (hspatial : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      Function.support (cubeProfiles n nu : Euclidean 2 → Complex) ⊆
        {xi | scale / 4 ≤ ‖xi‖ ∧ ‖xi‖ ≤ 4 * scale ∧
          xi ∈ angularSector (directions nu)
            (angularConstant * scale ^ (-(1 / 2 : Real)))})
    (hvertical : ∀ n ∈ radialIndices, ∀ tau : Real,
      beta ((Real.sqrt scale)⁻¹ * tau - n) ≠ 0 →
        |(Real.sqrt scale)⁻¹ * tau - n| ≤ 1)
    (hnormal : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      ∀ xi : Euclidean 2,
      xi ∈ Function.support (cubeProfiles n nu : Euclidean 2 → Complex) →
      ∀ tau : Real, tau ∈ Function.support (𝓕 (g n nu : Real → Complex)) →
      beta ((Real.sqrt scale)⁻¹ * tau - n) ≠ 0 →
        |tau - ‖xi‖| ≤ 2 * scale ^ gamma)
    (n n' : Int) (hn : n ∈ radialIndices) (hn' : n' ∈ radialIndices)
    (k : Nat) (hk : k ≤ maxLevel scale) (outputs : Finset WaveSpaceTime)
    (z : WaveSpaceTime) :
    ∃ overlapExponent : Real, 0 < overlapExponent ∧
      ∃ Cgamma : Real, 0 < Cgamma ∧
        (∀ nu ∈ angularIndices,
          Function.support
              (spaceTimeFourier
                (spectralCubeRadialNormalPacket beta scale n
                  (cubeProfiles n nu) (g n nu))) ⊆
            conicPlate scale gamma angularConstant n (directions nu)) ∧
        (∀ nu ∈ angularIndices,
          Function.support
              (spaceTimeFourier
                (spectralCubeRadialNormalPacket beta scale n'
                  (cubeProfiles n' nu) (g n' nu))) ⊆
            conicPlate scale gamma angularConstant n' (directions nu)) ∧
        finitePlateOverlapSquareEnergy scale gamma angularConstant n n'
          angularIndices directions k outputs
          (fun nu => spectralCubeRadialNormalPacket beta scale n
            (cubeProfiles n nu) (g n nu))
          (fun nu => spectralCubeRadialNormalPacket beta scale n'
            (cubeProfiles n' nu) (g n' nu)) z ≤
          (Cgamma * scale ^ (overlapExponent * gamma)) *
            ∑ Z ∈ outputs,
              ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
                angularIndices directions k Z,
                ‖spectralCubeRadialNormalPacket beta scale n
                    (cubeProfiles n pair.1) (g n pair.1) z‖ ^ 2 *
                  ‖spectralCubeRadialNormalPacket beta scale n'
                    (cubeProfiles n' pair.2) (g n' pair.2) z‖ ^ 2 := by
  rcases exists_finitePlateOverlapSquareEnergy_le_scaled_of_angularSectorGeometry
    maxLevel angularConstant sectorRadius spacingLower spacingUpper hangular
    gamma hgamma hgammaUpper scale hscale radialIndices angularIndices directions hgeometry
    n hn n' hn' k hk outputs
    (fun nu => spectralCubeRadialNormalPacket beta scale n
      (cubeProfiles n nu) (g n nu))
    (fun nu => spectralCubeRadialNormalPacket beta scale n'
      (cubeProfiles n' nu) (g n' nu)) z with
    ⟨overlapExponent, hoverlapExponent, Cgamma, hCgamma, henergy⟩
  refine ⟨overlapExponent, hoverlapExponent, Cgamma, hCgamma, ?_, ?_, henergy⟩
  · intro nu hnu
    exact support_spaceTimeFourier_spectralCubeRadialNormalPacket_subset_conicPlate
      beta scale gamma angularConstant n (directions nu)
      (temporalProfiles n nu) (g n nu) (hprofile n hn nu hnu)
      (cubeProfiles n nu) (hspatial n hn nu hnu) (hvertical n hn)
      (hnormal n hn nu hnu)
  · intro nu hnu
    exact support_spaceTimeFourier_spectralCubeRadialNormalPacket_subset_conicPlate
      beta scale gamma angularConstant n' (directions nu)
      (temporalProfiles n' nu) (g n' nu) (hprofile n' hn' nu hnu)
      (cubeProfiles n' nu) (hspatial n' hn' nu hnu) (hvertical n' hn')
      (hnormal n' hn' nu hnu)

/-- The literal Fourier projection associated to a smooth planar cube
cutoff.  Its domain is Schwartz data so that every multiplier product and
every Plancherel identity below is available without a density argument. -/
noncomputable def fourierCubeProjection
    (m : SchwartzMap (Euclidean 2) Complex)
    (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun ξ : Euclidean 2 => m ξ * 𝓕 (f : Euclidean 2 → Complex) ξ) x

/-- Pointwise form of the Fourier-cube projection. -/
theorem fourierCubeProjection_apply
    (m : SchwartzMap (Euclidean 2) Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    fourierCubeProjection m f x =
      𝓕⁻ (fun ξ : Euclidean 2 => m ξ * 𝓕 (f : Euclidean 2 → Complex) ξ) x := rfl

/-- A literal finite partition of a Fourier multiplier reconstructs the
corresponding multiplier action on Schwartz data.  The pointwise partition
identity is an explicit hypothesis: this theorem does not assert that a
given cube family supplies one. -/
theorem sum_fourierCubeProjection_eq_fourierInv_multiplier_of_sum_eq
    {κ : Type*} (cubes : Finset κ)
    (m : κ → SchwartzMap (Euclidean 2) Complex)
    (multiplier : Euclidean 2 → Complex)
    (f : SchwartzMap (Euclidean 2) Complex)
    (hsum : ∀ ξ : Euclidean 2, ∑ cube ∈ cubes, m cube ξ = multiplier ξ) :
    (fun x => ∑ cube ∈ cubes, fourierCubeProjection (m cube) f x) =
      fun x => 𝓕⁻ (fun ξ => multiplier ξ * 𝓕 (f : Euclidean 2 → Complex) ξ) x := by
  classical
  let g : κ → SchwartzMap (Euclidean 2) Complex := fun cube =>
    SchwartzMap.smulLeftCLM Complex (m cube : Euclidean 2 → Complex) (𝓕 f)
  have hg : ∀ (cube : κ) (ξ : Euclidean 2),
      g cube ξ = m cube ξ * 𝓕 (f : Euclidean 2 → Complex) ξ := by
    intro cube ξ
    simp only [g, SchwartzMap.smulLeftCLM_apply (m cube).hasTemperateGrowth,
      smul_eq_mul, SchwartzMap.fourier_coe]
  funext x
  calc
    (∑ cube ∈ cubes, fourierCubeProjection (m cube) f x) =
        ∑ cube ∈ cubes, (𝓕⁻ (g cube) : SchwartzMap (Euclidean 2) Complex) x := by
      apply Finset.sum_congr rfl
      intro cube hcube
      unfold fourierCubeProjection
      rw [SchwartzMap.fourierInv_coe]
      apply congrArg (fun q : Euclidean 2 → Complex => 𝓕⁻ q x)
      funext ξ
      exact (hg cube ξ).symm
    _ = (𝓕⁻ (∑ cube ∈ cubes, g cube) : SchwartzMap (Euclidean 2) Complex) x := by
      rw [fourierInv_sum]
      change (∑ cube ∈ cubes, (𝓕⁻ (g cube) : SchwartzMap (Euclidean 2) Complex) x) =
        (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean 2) Complex)
          (Euclidean 2) Complex)
          (∑ cube ∈ cubes, 𝓕⁻ (g cube)) x
      rw [map_sum, Finset.sum_apply]
      apply Finset.sum_congr rfl
      intro cube hcube
      rfl
    _ = 𝓕⁻ (fun ξ => multiplier ξ * 𝓕 (f : Euclidean 2 → Complex) ξ) x := by
      rw [SchwartzMap.fourierInv_coe]
      apply congrArg (fun q : Euclidean 2 → Complex => 𝓕⁻ q x)
      funext ξ
      change (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean 2) Complex)
        (Euclidean 2) Complex) (∑ cube ∈ cubes, g cube) ξ = _
      rw [map_sum, Finset.sum_apply]
      change (∑ cube ∈ cubes, g cube ξ) = _
      simp_rw [hg]
      rw [← Finset.sum_mul]
      rw [hsum]

/-- If the radial cutoff at one label has a concrete Schwartz multiplier
representative, a finite partition of that multiplier synthesizes the
literal radial piece.  The existence of the representative and the finite
partition are hypotheses, not geometric assertions. -/
theorem sum_fourierCubeProjection_eq_radialPiece_of_sum_eq
    {κ : Type*} (cubes : Finset κ)
    (m : κ → SchwartzMap (Euclidean 2) Complex)
    (radialMultiplier : SchwartzMap (Euclidean 2) Complex)
    (β : Real → Complex) (scale : Real) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex)
    (hradial : ∀ ξ : Euclidean 2,
      radialMultiplier ξ = β ((Real.sqrt scale)⁻¹ * ‖ξ‖ - n))
    (hsum : ∀ ξ : Euclidean 2, ∑ cube ∈ cubes, m cube ξ = radialMultiplier ξ) :
    (fun x => ∑ cube ∈ cubes, fourierCubeProjection (m cube) f x) =
      radialPiece β scale n (f : Euclidean 2 → Complex) := by
  rw [sum_fourierCubeProjection_eq_fourierInv_multiplier_of_sum_eq
    cubes m (radialMultiplier : Euclidean 2 → Complex) f hsum]
  unfold radialPiece
  apply congrArg (fun q : Euclidean 2 → Complex => 𝓕⁻ q)
  funext ξ
  rw [hradial]

/-- Applying the conic half-wave operator to the finite radial synthesis
gives exactly the corresponding conic radial summand. -/
theorem conicOperator_sum_fourierCubeProjection_eq_radialPiece_of_sum_eq
    {κ : Type*} (cubes : Finset κ)
    (m : κ → SchwartzMap (Euclidean 2) Complex)
    (radialMultiplier : SchwartzMap (Euclidean 2) Complex)
    (β : Real → Complex) (scale : Real) (n : Int)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex)
    (f : SchwartzMap (Euclidean 2) Complex)
    (hradial : ∀ ξ : Euclidean 2,
      radialMultiplier ξ = β ((Real.sqrt scale)⁻¹ * ‖ξ‖ - n))
    (hsum : ∀ ξ : Euclidean 2, ∑ cube ∈ cubes, m cube ξ = radialMultiplier ξ) :
    conicOperator scale a ϑ
        (fun x => ∑ cube ∈ cubes, fourierCubeProjection (m cube) f x) =
      conicOperator scale a ϑ (radialPiece β scale n (f : Euclidean 2 → Complex)) := by
  rw [sum_fourierCubeProjection_eq_radialPiece_of_sum_eq
    cubes m radialMultiplier β scale n f hradial hsum]

/-- The literal spatial kernel of the existing planar Fourier-cube
projection. -/
noncomputable def fourierCubePhysicalKernel
    (m : SchwartzMap (Euclidean 2) Complex) (x y : Euclidean 2) : Complex :=
  SmoothDyadicPhysicalCore.fourierCubeSourceKernel m x y

/-- The existing Fourier-cube projection is exactly its physical kernel
integral. -/
theorem fourierCubeProjection_eq_physicalKernel
    (m f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    fourierCubeProjection m f x =
      ∫ y : Euclidean 2, fourierCubePhysicalKernel m x y * f y := by
  simpa only [fourierCubeProjection, fourierCubePhysicalKernel] using
    (SmoothDyadicPhysicalCore.fourierCubeProjection_eq_sourceKernel m f x)

theorem integrable_fourierCubePhysicalKernel
    (m : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    Integrable (fun y : Euclidean 2 => fourierCubePhysicalKernel m x y) volume := by
  exact SmoothDyadicPhysicalCore.integrable_fourierCubeSourceKernel m x

/-- The source mass of a planar cube projection is independent of its
output point. -/
theorem integral_norm_fourierCubePhysicalKernel_eq
    (m : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    (∫ y : Euclidean 2, ‖fourierCubePhysicalKernel m x y‖) =
      ∫ y : Euclidean 2, ‖SmoothDyadicPhysicalCore.fourierCubeKernel m y‖ := by
  exact SmoothDyadicPhysicalCore.integral_norm_fourierCubeSourceKernel_eq m x

/-- A concrete finite family of the existing cube cutoffs has a uniform
spatial source-mass bound. -/
theorem exists_uniform_fourierCubePhysicalKernelMass
    {ι : Type*} (cubes : Finset ι)
    (m : ι → SchwartzMap (Euclidean 2) Complex) :
    ∃ A : Real, 0 ≤ A ∧ ∀ cube ∈ cubes, ∀ x : Euclidean 2,
      Integrable (fun y : Euclidean 2 => fourierCubePhysicalKernel (m cube) x y)
        volume ∧
      (∫ y : Euclidean 2, ‖fourierCubePhysicalKernel (m cube) x y‖) ≤ A := by
  refine ⟨SmoothDyadicPhysicalCore.finiteFourierCubeKernelMass cubes m,
    SmoothDyadicPhysicalCore.finiteFourierCubeKernelMass_nonneg cubes m, ?_⟩
  intro cube hcube x
  exact ⟨integrable_fourierCubePhysicalKernel (m cube) x,
    by simpa only [fourierCubePhysicalKernel] using
      (SmoothDyadicPhysicalCore.integral_norm_fourierCubeSourceKernel_le_finiteMass
        cubes m hcube x)⟩

/-- The literal frequency symbol obtained by multiplying a dyadic half-wave
symbol by concrete angular and cube Schwartz cutoffs. -/
noncomputable def angularDyadicCubeSchwartzSymbol
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex (χ : Euclidean 2 → Complex)
    (SchwartzMap.smulLeftCLM Complex (m : Euclidean 2 → Complex)
      (dyadicHalfWaveSchwartzSymbol C σ j t))

theorem angularDyadicCubeSchwartzSymbol_apply
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m : SchwartzMap (Euclidean 2) Complex) (ξ : Euclidean 2) :
    angularDyadicCubeSchwartzSymbol C σ j t χ m ξ =
      χ ξ * m ξ * dyadicHalfWaveSchwartzSymbol C σ j t ξ := by
  rw [angularDyadicCubeSchwartzSymbol,
    SchwartzMap.smulLeftCLM_apply_apply χ.hasTemperateGrowth,
    SchwartzMap.smulLeftCLM_apply_apply m.hasTemperateGrowth]
  simp only [smul_eq_mul]
  ring

/-- The spatial kernel of the literal angular half-wave/cube symbol. -/
noncomputable def angularDyadicCubeKernel
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  𝓕⁻ (angularDyadicCubeSchwartzSymbol C σ j t χ m)

/-- The corresponding space-time source kernel, including the concrete time
cutoff. -/
noncomputable def angularDyadicCubeSpaceTimeKernel
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ m : SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (z : WaveSpaceTime) (y : Euclidean 2) : Complex :=
  ϑ z.2 * angularDyadicCubeKernel C σ j z.2 χ m (z.1 - y)

/-- The physical output of the literal angular half-wave/cube multiplier. -/
noncomputable def angularDyadicCubePiece
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun ξ : Euclidean 2 =>
    angularDyadicCubeSchwartzSymbol C σ j t χ m ξ *
      𝓕 (f : Euclidean 2 → Complex) ξ) x

/-- The angular half-wave/cube piece has its exact literal source-kernel
representation. -/
theorem angularDyadicCubePiece_eq_sourceKernel
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    angularDyadicCubePiece C σ j t χ m f x =
      ∫ y : Euclidean 2,
        angularDyadicCubeKernel C σ j t χ m (x - y) * f y := by
  simpa only [angularDyadicCubePiece, angularDyadicCubeKernel,
    SmoothDyadicPhysicalCore.fourierCubeSourceKernel,
    SmoothDyadicPhysicalCore.fourierCubeKernel] using
    (SmoothDyadicPhysicalCore.fourierCubeProjection_eq_sourceKernel
      (angularDyadicCubeSchwartzSymbol C σ j t χ m) f x)

/-- Each fixed space-time slice of the literal angular half-wave/cube kernel
is integrable in its source variable. -/
theorem angularDyadicCubeSpaceTimeKernel_integrable
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ m : SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (z : WaveSpaceTime) :
    Integrable (fun y : Euclidean 2 =>
      angularDyadicCubeSpaceTimeKernel C σ j χ m ϑ z y) volume := by
  exact ((angularDyadicCubeKernel C σ j z.2 χ m).integrable.comp_sub_left z.1)
    |>.const_mul (ϑ z.2)

/-- The source `L¹` mass of the literal kernel is its time-cutoff magnitude
times the spatial kernel mass. -/
theorem integral_norm_angularDyadicCubeSpaceTimeKernel_eq
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ m : SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (z : WaveSpaceTime) :
    (∫ y : Euclidean 2,
      ‖angularDyadicCubeSpaceTimeKernel C σ j χ m ϑ z y‖) =
      ‖ϑ z.2‖ * ∫ u : Euclidean 2,
        ‖angularDyadicCubeKernel C σ j z.2 χ m u‖ := by
  unfold angularDyadicCubeSpaceTimeKernel
  calc
    (∫ y : Euclidean 2, ‖ϑ z.2 *
        angularDyadicCubeKernel C σ j z.2 χ m (z.1 - y)‖) =
        ∫ y : Euclidean 2, ‖ϑ z.2‖ *
          ‖angularDyadicCubeKernel C σ j z.2 χ m (z.1 - y)‖ := by
      apply integral_congr_ae
      filter_upwards with y
      rw [norm_mul]
    _ = ‖ϑ z.2‖ * ∫ y : Euclidean 2,
          ‖angularDyadicCubeKernel C σ j z.2 χ m (z.1 - y)‖ :=
      integral_const_mul _ _
    _ = ‖ϑ z.2‖ * ∫ u : Euclidean 2,
          ‖angularDyadicCubeKernel C σ j z.2 χ m u‖ := by
      rw [integral_sub_left_eq_self
        (fun u : Euclidean 2 => ‖angularDyadicCubeKernel C σ j z.2 χ m u‖)
        volume z.1]

/-- The existing level-`j` angular piece of a Fourier-cube projection is
exactly the literal angular half-wave/cube source-kernel integral. -/
theorem angularPiece_dyadicCube_eq_spaceTimeKernel
    (C : lpCutoffs 2) (j : Nat) (χ m f : SchwartzMap (Euclidean 2) Complex)
    (ϑ : Real → Complex) (z : WaveSpaceTime) :
    angularPiece ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0)
      (χ : Euclidean 2 → Complex) ϑ (fourierCubeProjection m f) z =
      ∫ y : Euclidean 2,
        angularDyadicCubeSpaceTimeKernel C WaveSign.plus j χ m ϑ z y * f y := by
  have hproj : fourierCubeProjection m f =
      (SmoothDyadicPhysicalCore.fourierCubeProjectedSchwartz m f :
        Euclidean 2 → Complex) := by
    funext x
    exact (SmoothDyadicPhysicalCore.fourierCubeProjectedSchwartz_apply m f x).symm
  rw [hproj]
  unfold angularPiece
  have hsymbol :
      (fun ξ : Euclidean 2 =>
        χ ξ * dyadicBandpassMultiplier C.cutoff 0 (((2 : Real) ^ j)⁻¹ • ξ) *
          halfWaveMultiplier WaveSign.plus z.2 ξ *
          𝓕 (SmoothDyadicPhysicalCore.fourierCubeProjectedSchwartz m f :
            Euclidean 2 → Complex) ξ) =
        fun ξ : Euclidean 2 =>
          angularDyadicCubeSchwartzSymbol C WaveSign.plus j z.2 χ m ξ *
            𝓕 (f : Euclidean 2 → Complex) ξ := by
    funext ξ
    rw [SmoothDyadicPhysicalCore.fourier_fourierCubeProjectedSchwartz_apply,
      angularDyadicCubeSchwartzSymbol_apply,
      dyadicHalfWaveSchwartzSymbol_apply, dyadicHalfWaveSymbol,
      ← dyadicBandpassMultiplier_eq_levelZero_scaled C j ξ]
    ring
  rw [hsymbol]
  change ϑ z.2 * angularDyadicCubePiece C WaveSign.plus j z.2 χ m f z.1 = _
  rw [angularDyadicCubePiece_eq_sourceKernel]
  unfold angularDyadicCubeSpaceTimeKernel
  rw [← integral_const_mul]
  apply integral_congr_ae
  filter_upwards with y
  ring

/-- The literal angular half-wave/cube symbol is compactly supported.  The
dyadic half-wave cutoff supplies the support; the angular and cube factors do
not enlarge it. -/
theorem hasCompactSupport_angularDyadicCubeSchwartzSymbol
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m : SchwartzMap (Euclidean 2) Complex) :
    HasCompactSupport (angularDyadicCubeSchwartzSymbol C σ j t χ m :
      Euclidean 2 → Complex) := by
  have hhalf : HasCompactSupport (dyadicHalfWaveSchwartzSymbol C σ j t :
      Euclidean 2 → Complex) :=
    hasCompactSupport_dyadicHalfWaveSchwartzSymbol C σ j t
  have hprod : HasCompactSupport (fun ξ : Euclidean 2 =>
      (χ ξ * m ξ) * dyadicHalfWaveSchwartzSymbol C σ j t ξ) :=
    HasCompactSupport.mul_left hhalf
  have heq : (angularDyadicCubeSchwartzSymbol C σ j t χ m :
      Euclidean 2 → Complex) = fun ξ =>
      (χ ξ * m ξ) * dyadicHalfWaveSchwartzSymbol C σ j t ξ := by
    funext ξ
    rw [angularDyadicCubeSchwartzSymbol_apply]
  rw [heq]
  exact hprod

/-- The literal angular half-wave/cube symbol is smooth to every order. -/
theorem contDiff_angularDyadicCubeSchwartzSymbol
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m : SchwartzMap (Euclidean 2) Complex) :
    ContDiff Real (⊤ : ℕ∞) (angularDyadicCubeSchwartzSymbol C σ j t χ m :
      Euclidean 2 → Complex) := by
  exact (angularDyadicCubeSchwartzSymbol C σ j t χ m).smooth ⊤

/-- A concrete Fourier-cube cutoff centered at `scale • direction`, with
side-radius `width * sqrt scale`.  This is the frequency support interface
for a ray-directed MSS packet; it is not a tube-decay hypothesis. -/
def isScaledRayCubeCutoff (scale width : Real) (direction : Euclidean 2)
    (m : SchwartzMap (Euclidean 2) Complex) : Prop :=
  isFourierCubeCutoff (scale • direction) (width * Real.sqrt scale) m

/-- The concrete ray-cube multiplier obtained from one fixed Schwartz
prototype by translation to `scale • direction` and dilation by the cube
side-radius.  The positivity proof is only used to select the invertible
dilation; the resulting function is literally the stated affine pullback. -/
def scaledRayCubeCutoff (prototype : SchwartzMap (Euclidean 2) Complex)
    (scale width : Real) (direction : Euclidean 2)
    (hradius : 0 < width * Real.sqrt scale) :
    SchwartzMap (Euclidean 2) Complex :=
  translatedDilatedSchwartzCutoff prototype (scale • direction)
    (width * Real.sqrt scale) hradius.ne'

/-- Pointwise normal form of the concrete scaled ray-cube cutoff. -/
theorem scaledRayCubeCutoff_apply (prototype : SchwartzMap (Euclidean 2) Complex)
    (scale width : Real) (direction xi : Euclidean 2)
    (hradius : 0 < width * Real.sqrt scale) :
    scaledRayCubeCutoff prototype scale width direction hradius xi =
      prototype ((width * Real.sqrt scale)⁻¹ • (xi - scale • direction)) := by
  exact translatedDilatedSchwartzCutoff_apply prototype (scale • direction) xi
    (width * Real.sqrt scale) hradius.ne'

/-- A prototype supported in the unit coordinate cube produces a genuine
Fourier-cube cutoff at every positive translated/dilated scale. -/
theorem isFourierCubeCutoff_translatedDilatedSchwartzCutoff
    (prototype : SchwartzMap (Euclidean 2) Complex) (center : Euclidean 2)
    {radius : Real} (hradius : 0 < radius)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      frequencyCube 0 1) :
    isFourierCubeCutoff center radius
      (translatedDilatedSchwartzCutoff prototype center radius hradius.ne') := by
  refine ⟨hradius.le, ?_⟩
  intro xi hxi
  change translatedDilatedSchwartzCutoff prototype center radius hradius.ne' xi ≠ 0 at hxi
  have hne : prototype (radius⁻¹ • (xi - center)) ≠ 0 := by
    simpa only [translatedDilatedSchwartzCutoff_apply] using hxi
  have hunit := hprototype hne
  rw [mem_frequencyCube_iff] at hunit ⊢
  intro i
  have hdiv : |xi i - center i| / radius ≤ 1 := by
    simpa [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_inv,
      abs_of_pos hradius, div_eq_mul_inv, mul_comm] using hunit i
  simpa using (div_le_iff₀ hradius).mp hdiv

/-- The concrete affine pullback satisfies the existing ray-cube support
interface whenever its fixed prototype is supported in the unit cube. -/
theorem isScaledRayCubeCutoff_scaledRayCubeCutoff
    (prototype : SchwartzMap (Euclidean 2) Complex) (scale width : Real)
    (direction : Euclidean 2) (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      frequencyCube 0 1) :
    isScaledRayCubeCutoff scale width direction
      (scaledRayCubeCutoff prototype scale width direction hradius) :=
  isFourierCubeCutoff_translatedDilatedSchwartzCutoff prototype
    (scale • direction) hradius hprototype

/-- Exact all-order derivative-integral scaling for the concrete planar
ray-cube multiplier.  This supplies the cutoff-normalization half of the
residual seminorm bridge; phase mismatch estimates remain separate. -/
theorem integral_norm_iteratedFDeriv_scaledRayCubeCutoff
    (prototype : SchwartzMap (Euclidean 2) Complex) (scale width : Real)
    (direction : Euclidean 2) (hradius : 0 < width * Real.sqrt scale) (n : Nat) :
    ∫ xi : Euclidean 2,
      ‖iteratedFDeriv Real n
        (scaledRayCubeCutoff prototype scale width direction hradius) xi‖ =
      (width * Real.sqrt scale) ^ 2 *
        ((width * Real.sqrt scale)⁻¹) ^ n *
          ∫ eta : Euclidean 2, ‖iteratedFDeriv Real n prototype eta‖ := by
  have hdim : Module.finrank Real (Euclidean 2) = 2 := by norm_num
  simpa only [scaledRayCubeCutoff, hdim] using
    (integral_norm_iteratedFDeriv_translatedDilatedSchwartzCutoff prototype
      (scale • direction) hradius n)

/-- A Euclidean-ball prototype support gives the corresponding literal ball
support after the scaled ray-cube affine pullback.  This complements the
coordinate-cube support interface with the radial control needed for the
half-wave phase calculation. -/
theorem support_scaledRayCubeCutoff_subset_closedBall
    (prototype : SchwartzMap (Euclidean 2) Complex) (scale width : Real)
    (direction : Euclidean 2) (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1) :
    Function.support
      (scaledRayCubeCutoff prototype scale width direction hradius :
        Euclidean 2 → Complex) ⊆
      Metric.closedBall (scale • direction) (width * Real.sqrt scale) := by
  intro ξ hξ
  change scaledRayCubeCutoff prototype scale width direction hradius ξ ≠ 0 at hξ
  have hne : prototype
      ((width * Real.sqrt scale)⁻¹ • (ξ - scale • direction)) ≠ 0 := by
    simpa only [scaledRayCubeCutoff_apply] using hξ
  have hunit := hprototype hne
  rw [Metric.mem_closedBall, dist_zero_right] at hunit
  rw [Metric.mem_closedBall, dist_eq_norm]
  have hscale : 0 < width * Real.sqrt scale := hradius
  have hnorm : ‖(width * Real.sqrt scale)⁻¹ • (ξ - scale • direction)‖ =
      (width * Real.sqrt scale)⁻¹ * ‖ξ - scale • direction‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hscale)]
  rw [hnorm] at hunit
  have hscale_id (a : Real) : a =
      (width * Real.sqrt scale) * ((width * Real.sqrt scale)⁻¹ * a) := by
    let r : Real := width * Real.sqrt scale
    have hr : r ≠ 0 := by
      dsimp [r]
      exact hscale.ne'
    change a = r * (r⁻¹ * a)
    calc
      a = 1 * a := by ring
      _ = (r * r⁻¹) * a := by rw [mul_inv_cancel₀ hr]
      _ = r * (r⁻¹ * a) := by ring
  calc
    ‖ξ - scale • direction‖ =
        (width * Real.sqrt scale) *
          ((width * Real.sqrt scale)⁻¹ * ‖ξ - scale • direction‖) := by
      exact hscale_id _
    _ ≤ (width * Real.sqrt scale) * 1 :=
      mul_le_mul_of_nonneg_left hunit hscale.le
    _ = width * Real.sqrt scale := by ring

/-- All frequency derivatives of the concrete cube cutoff remain in the
same closed affine ball. -/
theorem support_iteratedFDeriv_scaledRayCubeCutoff_subset_closedBall
    (prototype : SchwartzMap (Euclidean 2) Complex) (scale width : Real)
    (direction : Euclidean 2) (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1) (n : Nat) :
    Function.support (iteratedFDeriv Real n
      (scaledRayCubeCutoff prototype scale width direction hradius :
        Euclidean 2 → Complex)) ⊆
      Metric.closedBall (scale • direction) (width * Real.sqrt scale) := by
  have hsupport := support_scaledRayCubeCutoff_subset_closedBall
    prototype scale width direction hradius hprototype
  have htsupport : tsupport
      (scaledRayCubeCutoff prototype scale width direction hradius :
        Euclidean 2 → Complex) ⊆
      Metric.closedBall (scale • direction) (width * Real.sqrt scale) :=
    closure_minimal hsupport Metric.isClosed_closedBall
  exact (support_iteratedFDeriv_subset n).trans htsupport

/-- The literal angular half-wave/cube symbol stays in the concrete frequency
cube supporting its cube multiplier. -/
theorem support_angularDyadicCubeSchwartzSymbol_subset_frequencyCube
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m : SchwartzMap (Euclidean 2) Complex) (center : Euclidean 2)
    (radius : Real) (hm : isFourierCubeCutoff center radius m) :
    Function.support (angularDyadicCubeSchwartzSymbol C σ j t χ m :
      Euclidean 2 → Complex) ⊆ frequencyCube center radius := by
  intro ξ hξ
  apply hm.2
  intro hzero
  apply hξ
  rw [angularDyadicCubeSchwartzSymbol_apply, hzero]
  ring

private noncomputable def aux_angularDyadicCubeProjectedSchwartz
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  𝓕⁻ (SchwartzMap.smulLeftCLM Complex
    (angularDyadicCubeSchwartzSymbol C σ j t χ m : Euclidean 2 → Complex) (𝓕 f))

private theorem aux_angularDyadicCubeProjectedSchwartz_apply
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    aux_angularDyadicCubeProjectedSchwartz C σ j t χ m f x =
      angularDyadicCubePiece C σ j t χ m f x := by
  simp only [aux_angularDyadicCubeProjectedSchwartz, SchwartzMap.fourierInv_coe,
    SchwartzMap.smulLeftCLM_apply
      (angularDyadicCubeSchwartzSymbol C σ j t χ m).hasTemperateGrowth,
    smul_eq_mul, SchwartzMap.fourier_coe, angularDyadicCubePiece]

/-- The fixed-time spatial Fourier transform of the literal angular/cube
half-wave piece is exactly its cube-localized multiplier times the input
Fourier transform.  This is a spatial statement only. -/
theorem fourier_angularDyadicCubePiece_apply
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m f : SchwartzMap (Euclidean 2) Complex) (ξ : Euclidean 2) :
    𝓕 (angularDyadicCubePiece C σ j t χ m f) ξ =
      angularDyadicCubeSchwartzSymbol C σ j t χ m ξ *
        𝓕 (f : Euclidean 2 → Complex) ξ := by
  have hpiece : angularDyadicCubePiece C σ j t χ m f =
      (aux_angularDyadicCubeProjectedSchwartz C σ j t χ m f :
        Euclidean 2 → Complex) := by
    funext x
    exact (aux_angularDyadicCubeProjectedSchwartz_apply C σ j t χ m f x).symm
  rw [hpiece]
  rw [← SchwartzMap.fourier_coe]
  unfold aux_angularDyadicCubeProjectedSchwartz
  rw [FourierTransform.fourier_fourierInv_eq]
  simp only [SchwartzMap.smulLeftCLM_apply_apply
    (angularDyadicCubeSchwartzSymbol C σ j t χ m).hasTemperateGrowth,
    smul_eq_mul, SchwartzMap.fourier_coe]

/-- Every fixed-time spatial Fourier slice of a literal angular/cube piece
stays in the frequency cube supporting its cube multiplier.  It does not
claim space-time conic-plate support. -/
theorem support_fourier_angularDyadicCubePiece_subset_frequencyCube
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ m f : SchwartzMap (Euclidean 2) Complex)
    (center : Euclidean 2) (radius : Real) (hm : isFourierCubeCutoff center radius m) :
    Function.support (𝓕 (angularDyadicCubePiece C σ j t χ m f)) ⊆
      frequencyCube center radius := by
  intro ξ hξ
  apply hm.2
  intro hzero
  apply hξ
  rw [fourier_angularDyadicCubePiece_apply,
    angularDyadicCubeSchwartzSymbol_apply, hzero]
  ring

/-- Specialization of the fixed-time Fourier-support theorem to the concrete
scaled ray cube.  The conclusion remains spatial and makes no normal-frequency
or conic-plate assertion. -/
theorem support_fourier_scaledRayAngularDyadicCubePiece_subset_frequencyCube
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t scale width : Real)
    (direction : Euclidean 2) (χ prototype f : SchwartzMap (Euclidean 2) Complex)
    (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      frequencyCube 0 1) :
    Function.support (𝓕 (angularDyadicCubePiece C σ j t χ
      (scaledRayCubeCutoff prototype scale width direction hradius) f)) ⊆
      frequencyCube (scale • direction) (width * Real.sqrt scale) := by
  exact support_fourier_angularDyadicCubePiece_subset_frequencyCube
    C σ j t χ (scaledRayCubeCutoff prototype scale width direction hradius) f
    (scale • direction) (width * Real.sqrt scale)
    (isScaledRayCubeCutoff_scaledRayCubeCutoff prototype scale width direction hradius hprototype)

/-- Remove the plus-wave ray translation from a literal angular/cube symbol.
Its inverse Fourier transform is the original spatial kernel evaluated in
the translated residual coordinate. -/
noncomputable def angularDyadicCubeResidualSymbol
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (direction : Euclidean 2) (χ m : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  SmoothDyadicPhysicalCore.planeWaveModulatedCompactSchwartz (-(t • direction))
    (angularDyadicCubeSchwartzSymbol C σ j t χ m : Euclidean 2 → Complex)
    (hasCompactSupport_angularDyadicCubeSchwartzSymbol C σ j t χ m)
    (contDiff_angularDyadicCubeSchwartzSymbol C σ j t χ m)

/-- Pointwise formula for the ray-residual symbol. -/
theorem angularDyadicCubeResidualSymbol_apply
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (direction : Euclidean 2) (χ m : SchwartzMap (Euclidean 2) Complex)
    (ξ : Euclidean 2) :
    angularDyadicCubeResidualSymbol C σ j t direction χ m ξ =
      ((Real.fourierChar (inner Real (-(t • direction)) ξ) : Circle) : Complex) *
        angularDyadicCubeSchwartzSymbol C σ j t χ m ξ := by
  exact SmoothDyadicPhysicalCore.planeWaveModulatedCompactSchwartz_apply
    (-(t • direction)) (angularDyadicCubeSchwartzSymbol C σ j t χ m :
      Euclidean 2 → Complex)
    (hasCompactSupport_angularDyadicCubeSchwartzSymbol C σ j t χ m)
    (contDiff_angularDyadicCubeSchwartzSymbol C σ j t χ m) ξ

/-- The actual ray-residual amplitude before multiplication by a particular
cube cutoff.  Its phase is the half-wave phase after the light-ray
translation has been removed. -/
noncomputable def angularDyadicResidualBaseSymbol
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (direction : Euclidean 2) (χ : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  SmoothDyadicPhysicalCore.planeWaveModulatedCompactSchwartz (-(t • direction))
    (fun ξ : Euclidean 2 => χ ξ * dyadicHalfWaveSchwartzSymbol C σ j t ξ)
    (HasCompactSupport.mul_left
      (hasCompactSupport_dyadicHalfWaveSchwartzSymbol C σ j t))
    ((χ.smooth (⊤ : ℕ∞)).mul
      ((dyadicHalfWaveSchwartzSymbol C σ j t).smooth (⊤ : ℕ∞)))

/-- Pointwise form of the residual base amplitude. -/
theorem angularDyadicResidualBaseSymbol_apply
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (direction ξ : Euclidean 2) (χ : SchwartzMap (Euclidean 2) Complex) :
    angularDyadicResidualBaseSymbol C σ j t direction χ ξ =
      ((Real.fourierChar (inner Real (-(t • direction)) ξ) : Circle) : Complex) *
        (χ ξ * dyadicHalfWaveSchwartzSymbol C σ j t ξ) := by
  exact SmoothDyadicPhysicalCore.planeWaveModulatedCompactSchwartz_apply
    (-(t • direction))
    (fun η : Euclidean 2 => χ η * dyadicHalfWaveSchwartzSymbol C σ j t η)
    (HasCompactSupport.mul_left
      (hasCompactSupport_dyadicHalfWaveSchwartzSymbol C σ j t))
    ((χ.smooth (⊤ : ℕ∞)).mul
      ((dyadicHalfWaveSchwartzSymbol C σ j t).smooth (⊤ : ℕ∞))) ξ

/-- The residual symbol factors exactly into the actual phase-mismatch base
amplitude and the cube cutoff. -/
theorem angularDyadicCubeResidualSymbol_eq_residualBase_mul
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (direction ξ : Euclidean 2) (χ m : SchwartzMap (Euclidean 2) Complex) :
    angularDyadicCubeResidualSymbol C σ j t direction χ m ξ =
      angularDyadicResidualBaseSymbol C σ j t direction χ ξ * m ξ := by
  rw [angularDyadicCubeResidualSymbol_apply,
    angularDyadicResidualBaseSymbol_apply,
    angularDyadicCubeSchwartzSymbol_apply]
  ring

/-- The literal phase remaining after translating along `direction`. -/
def angularDyadicRayPhaseMismatch
    (σ : WaveSign) (direction ξ : Euclidean 2) : Real :=
  σ.toReal * ‖ξ‖ - inner Real direction ξ

/-- Positive radial dilations have the expected all-order homogeneity away
from the origin.  The proof works on the punctured open space, so it does
not incorrectly treat the norm as globally smooth. -/
theorem iteratedFDeriv_norm_smul_pos
    {d : Nat} (n : Nat) (scale : Real) (hscale : 0 < scale)
    (x : Euclidean d) (hx : x ≠ 0) :
    (scale ^ n) • iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) (scale • x) =
      scale • iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) x := by
  let e : Euclidean d ≃L[Real] Euclidean d :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 scale hscale.ne')
  let s : Set (Euclidean d) := {y | y ≠ 0}
  have hs : IsOpen s := by
    simpa [s] using (isOpen_ne : IsOpen {y : Euclidean d | y ≠ 0})
  have hxs : x ∈ s := hx
  have hexs : e x ∈ s := by
    change scale • x ≠ 0
    exact smul_ne_zero hscale.ne' hx
  have hpre : e ⁻¹' s = s := by
    ext y
    change (scale • y ≠ 0) ↔ y ≠ 0
    constructor
    · exact fun hy hy0 => hy (by simp [hy0])
    · exact fun hy => smul_ne_zero hscale.ne' hy
  have hcomp := e.iteratedFDerivWithin_comp_right
    (fun y : Euclidean d => ‖y‖) hs.uniqueDiffOn hexs n
  have hleft : iteratedFDeriv Real n (fun y : Euclidean d => ‖e y‖) x =
      (scale ^ n) • iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) (e x) := by
    have hcomp' : iteratedFDerivWithin Real n
        ((fun y : Euclidean d => ‖y‖) ∘ e) s x =
        (iteratedFDerivWithin Real n (fun y : Euclidean d => ‖y‖) s (e x)).compContinuousLinearMap
          (fun _ => e) := by
      simpa only [hpre] using hcomp
    rw [iteratedFDerivWithin_of_isOpen n hs hxs,
      iteratedFDerivWithin_of_isOpen n hs hexs] at hcomp'
    rw [show (fun y : Euclidean d => ‖e y‖) = (fun y : Euclidean d => ‖y‖) ∘ e by rfl]
    rw [hcomp']
    ext m
    simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    change iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) (e x)
      (fun i => scale • m i) = _
    simpa using (iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) (e x)).map_smul_univ
      (fun _ : Fin n => scale) m
  have hhom : (fun y : Euclidean d => ‖e y‖) =
      fun y : Euclidean d => scale • ‖y‖ := by
    funext y
    change ‖scale • y‖ = scale • ‖y‖
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hscale]
    rfl
  rw [hhom] at hleft
  have hsmul : iteratedFDeriv Real n (fun y : Euclidean d => scale • ‖y‖) x =
      scale • iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) x := by
    change iteratedFDeriv Real n (scale • (fun y : Euclidean d => ‖y‖)) x = _
    exact iteratedFDeriv_const_smul_apply (a := scale)
      (contDiffAt_norm (n := (n : WithTop ℕ∞)) Real hx)
  rw [hsmul] at hleft
  simpa [e] using hleft.symm

private theorem exists_norm_iteratedFDeriv_norm_bound_on_unitAnnulus
    (d n : Nat) :
    ∃ A : Real, 0 ≤ A ∧ ∀ x : Euclidean d,
      (1 / 2 : Real) ≤ ‖x‖ → ‖x‖ ≤ 2 →
        ‖iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) x‖ ≤ A := by
  let K : Set (Euclidean d) := {x | (1 / 2 : Real) ≤ ‖x‖ ∧ ‖x‖ ≤ 2}
  have hKclosed : IsClosed K := by
    exact (isClosed_le continuous_const continuous_norm).inter
      (isClosed_le continuous_norm continuous_const)
  have hKsubset : K ⊆ Metric.closedBall (0 : Euclidean d) 2 := by
    intro x hx
    change dist x 0 ≤ 2
    simpa [dist_zero_right] using hx.2
  have hK : IsCompact K :=
    (isCompact_closedBall (0 : Euclidean d) 2).of_isClosed_subset hKclosed hKsubset
  have hcont : ContinuousOn (fun x : Euclidean d =>
      iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) x) K := by
    intro x hx
    have hx0 : x ≠ 0 := by
      intro hx0
      subst x
      change (1 / 2 : Real) ≤ ‖(0 : Euclidean d)‖ ∧ ‖(0 : Euclidean d)‖ ≤ 2 at hx
      norm_num at hx
    have hcd : ContDiffAt Real (⊤ : WithTop ℕ∞)
        (fun y : Euclidean d => ‖y‖) x :=
      contDiffAt_norm Real hx0
    exact (hcd.continuousAt_iteratedFDeriv (by simp)).continuousWithinAt
  obtain ⟨B, hB⟩ := hK.exists_bound_of_continuousOn hcont
  refine ⟨max B 0, le_max_right _ _, ?_⟩
  intro x hlow hupp
  exact (hB x ⟨hlow, hupp⟩).trans (le_max_left _ _)

/-- A compact normalized annulus controls every fixed radial derivative on
all positive dilates.  Equivalently, the `n`-th derivative of the norm has
size `O(scale^(1 - n))` when the frequency has size comparable to `scale`. -/
theorem exists_scaled_norm_iteratedFDeriv_bound
    (d n : Nat) (hn : 1 ≤ n) :
    ∃ A : Real, 0 ≤ A ∧ ∀ (scale : Real) (ξ : Euclidean d),
      0 < scale → scale / 2 ≤ ‖ξ‖ → ‖ξ‖ ≤ 2 * scale →
        scale ^ (n - 1) * ‖iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) ξ‖ ≤ A := by
  obtain ⟨A, hA0, hA⟩ := exists_norm_iteratedFDeriv_norm_bound_on_unitAnnulus d n
  refine ⟨A, hA0, ?_⟩
  intro scale ξ hscale hlow hupp
  let η : Euclidean d := scale⁻¹ • ξ
  have hηnorm : ‖η‖ = scale⁻¹ * ‖ξ‖ := by
    dsimp [η]
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hscale)]
  have hηlower : (1 / 2 : Real) ≤ ‖η‖ := by
    rw [hηnorm]
    calc
      (1 / 2 : Real) = scale⁻¹ * (scale / 2) := by
        field_simp [hscale.ne']
      _ ≤ scale⁻¹ * ‖ξ‖ :=
        mul_le_mul_of_nonneg_left hlow (inv_nonneg.mpr hscale.le)
  have hηupper : ‖η‖ ≤ 2 := by
    rw [hηnorm]
    calc
      scale⁻¹ * ‖ξ‖ ≤ scale⁻¹ * (2 * scale) :=
        mul_le_mul_of_nonneg_left hupp (inv_nonneg.mpr hscale.le)
      _ = 2 := by field_simp [hscale.ne']
  have hη0 : η ≠ 0 := by
    intro hη0
    rw [hη0, norm_zero] at hηlower
    norm_num at hηlower
  have hAη := hA η hηlower hηupper
  have hscaleη : scale • η = ξ := by
    dsimp [η]
    rw [smul_smul, mul_inv_cancel₀ hscale.ne', one_smul]
  have hid := iteratedFDeriv_norm_smul_pos n scale hscale η hη0
  rw [hscaleη] at hid
  have hidnorm : scale ^ n * ‖iteratedFDeriv Real n
      (fun y : Euclidean d => ‖y‖) ξ‖ =
      scale * ‖iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) η‖ := by
    have h := congrArg norm hid
    simpa [norm_smul, Real.norm_eq_abs, abs_of_pos hscale,
      abs_of_pos (pow_pos hscale _)] using h
  apply le_of_mul_le_mul_left ?_ hscale
  calc
    scale * (scale ^ (n - 1) * ‖iteratedFDeriv Real n
        (fun y : Euclidean d => ‖y‖) ξ‖) =
        scale ^ n * ‖iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) ξ‖ := by
      have hsum : (n - 1) + 1 = n := Nat.sub_add_cancel hn
      calc
        scale * (scale ^ (n - 1) * ‖iteratedFDeriv Real n
            (fun y : Euclidean d => ‖y‖) ξ‖) =
            (scale ^ (n - 1) * scale) * ‖iteratedFDeriv Real n
              (fun y : Euclidean d => ‖y‖) ξ‖ := by ring
        _ = scale ^ ((n - 1) + 1) * ‖iteratedFDeriv Real n
              (fun y : Euclidean d => ‖y‖) ξ‖ := by rw [pow_succ]
        _ = scale ^ n * ‖iteratedFDeriv Real n
              (fun y : Euclidean d => ‖y‖) ξ‖ := by rw [hsum]
    _ = scale * ‖iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) η‖ := hidnorm
    _ ≤ scale * A := mul_le_mul_of_nonneg_left hAη hscale.le

private theorem iteratedFDeriv_innerSL_two
    {d : Nat} (direction x : Euclidean d) :
    iteratedFDeriv Real 2 (innerSL Real direction : Euclidean d → Real) x = 0 := by
  have hfd : fderiv Real (innerSL Real direction : Euclidean d → Real) =
      fun _ : Euclidean d => innerSL Real direction := by
    funext y
    exact ContinuousLinearMap.fderiv _
  ext m
  rw [iteratedFDeriv_two_apply]
  rw [hfd]
  simp

private theorem iteratedFDeriv_innerSL_eq_zero_of_two_le
    {d : Nat} (direction : Euclidean d) {n : Nat} (hn : 2 ≤ n) :
    ∀ x : Euclidean d,
      iteratedFDeriv Real n (innerSL Real direction : Euclidean d → Real) x = 0 := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hn
  induction k with
  | zero =>
      intro x
      simpa using iteratedFDeriv_innerSL_two direction x
  | succ k ih =>
      intro x
      have hzero : iteratedFDeriv Real (2 + k)
          (innerSL Real direction : Euclidean d → Real) = 0 := by
        funext y
        exact ih (by omega) y
      have hindex : 2 + (k + 1) = (2 + k) + 1 := by omega
      rw [hindex, iteratedFDeriv_succ_eq_comp_left, hzero, fderiv_zero]
      exact (continuousMultilinearCurryLeftEquiv Real
        (fun _ : Fin ((2 + k) + 1) => Euclidean d) Real).symm.map_zero

/-- In derivative orders at least two, the translated plus-sheet ray phase
has exactly the same frequency derivatives as the radial norm: the ray term
is linear and therefore disappears. -/
theorem iteratedFDeriv_angularDyadicRayPhaseMismatch_plus_eq_norm_of_two_le
    {n : Nat} (hn : 2 ≤ n) (direction ξ : Euclidean 2) (hξ : ξ ≠ 0) :
    iteratedFDeriv Real n
        (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ =
      iteratedFDeriv Real n (fun η : Euclidean 2 => ‖η‖) ξ := by
  unfold angularDyadicRayPhaseMismatch
  simp only [WaveSign.toReal, one_mul]
  change iteratedFDeriv Real n
      ((fun η : Euclidean 2 => ‖η‖) - (innerSL Real direction : Euclidean 2 → Real)) ξ = _
  rw [iteratedFDeriv_sub_apply
    (contDiffAt_norm (n := (n : WithTop ℕ∞)) Real hξ)
    ((innerSL Real direction).contDiff.contDiffAt)]
  rw [iteratedFDeriv_innerSL_eq_zero_of_two_le direction hn ξ, sub_zero]

private theorem norm_bounds_of_mem_scaledRayBall
    {scale radius : Real} {direction ξ : Euclidean 2}
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * radius ≤ scale)
    (hξ : ξ ∈ Metric.closedBall (scale • direction) radius) :
    scale / 2 ≤ ‖ξ‖ ∧ ‖ξ‖ ≤ 2 * scale := by
  rw [Metric.mem_closedBall, dist_eq_norm] at hξ
  have hcenter : ‖scale • direction‖ = scale := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hscale, hunit, mul_one]
  constructor
  · have hreverse := norm_sub_norm_le (scale • direction) ξ
    rw [hcenter] at hreverse
    have hdist : ‖scale • direction - ξ‖ ≤ radius := by
      simpa only [norm_sub_rev] using hξ
    linarith
  · have hforward := norm_le_norm_add_norm_sub (scale • direction) ξ
    rw [hcenter] at hforward
    have hdist : ‖scale • direction - ξ‖ ≤ radius := by
      simpa only [norm_sub_rev] using hξ
    linarith

private theorem exists_scaledRayBall_plusMismatch_higherDerivativeBound
    (n : Nat) (hn : 2 ≤ n) :
    ∃ A : Real, 0 ≤ A ∧ ∀ (scale radius : Real) (direction ξ : Euclidean 2),
      0 < scale → ‖direction‖ = 1 → 2 * radius ≤ scale →
      ξ ∈ Metric.closedBall (scale • direction) radius →
        scale ^ (n - 1) * ‖iteratedFDeriv Real n
          (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ‖ ≤ A := by
  obtain ⟨A, hA0, hA⟩ := exists_scaled_norm_iteratedFDeriv_bound 2 n (by omega)
  refine ⟨A, hA0, ?_⟩
  intro scale radius direction ξ hscale hunit hsmall hξ
  have hrange := norm_bounds_of_mem_scaledRayBall hscale hunit hsmall hξ
  have hξ0 : ξ ≠ 0 := by
    intro hξ0
    subst ξ
    simp only [norm_zero] at hrange
    linarith
  rw [iteratedFDeriv_angularDyadicRayPhaseMismatch_plus_eq_norm_of_two_le
    hn direction ξ hξ0]
  exact hA scale ξ hscale hrange.1 hrange.2

/-- Every fixed higher derivative of the literal plus-sheet phase mismatch
is uniformly normalized on the support of every derivative of a matched
scaled ray-cube cutoff.  The constant depends only on the order; this is the
finite-order radial calculus input for higher-decay ray localization. -/
theorem exists_scaledRayCubeCutoff_plusMismatch_higherDerivativeBound
    (n : Nat) (hn : 2 ≤ n) :
    ∃ A : Real, 0 ≤ A ∧ ∀
      (prototype : SchwartzMap (Euclidean 2) Complex) (scale width : Real)
      (direction : Euclidean 2) (hradius : 0 < width * Real.sqrt scale),
      Function.support (prototype : Euclidean 2 → Complex) ⊆ Metric.closedBall 0 1 →
      0 < scale → ‖direction‖ = 1 → 2 * (width * Real.sqrt scale) ≤ scale →
      ∀ (k : Nat) {ξ : Euclidean 2}, ξ ∈ Function.support (iteratedFDeriv Real k
        (scaledRayCubeCutoff prototype scale width direction hradius :
          Euclidean 2 → Complex)) →
        scale ^ (n - 1) * ‖iteratedFDeriv Real n
          (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ‖ ≤ A := by
  obtain ⟨A, hA0, hA⟩ := exists_scaledRayBall_plusMismatch_higherDerivativeBound n hn
  refine ⟨A, hA0, ?_⟩
  intro prototype scale width direction hradius hprototype hscale hunit hsmall k ξ hξ
  have hball := support_iteratedFDeriv_scaledRayCubeCutoff_subset_closedBall
    prototype scale width direction hradius hprototype k hξ
  exact hA scale (width * Real.sqrt scale) direction ξ hscale hunit hsmall hball

private theorem fderiv_norm_eq_inv_smul_innerSL
    (ξ : Euclidean 2) (hξ : ξ ≠ 0) :
    fderiv Real (fun η : Euclidean 2 => ‖η‖) ξ =
      (‖ξ‖)⁻¹ • innerSL Real ξ := by
  have hdiff : DifferentiableAt Real (fun η : Euclidean 2 => ‖η‖) ξ :=
    (contDiffAt_norm Real hξ).differentiableAt one_ne_zero
  have hder := hdiff.hasFDerivAt.norm_sq.fderiv
  have hfun : (fun η : Euclidean 2 => ‖(‖η‖ : Real)‖ ^ 2) =
      fun η : Euclidean 2 => ‖η‖ ^ 2 := by
    funext η
    rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg η)]
  rw [hfun, fderiv_norm_sq_apply] at hder
  have hcomp : (innerSL Real (‖ξ‖)).comp
      (fderiv Real (fun η : Euclidean 2 => ‖η‖) ξ) =
      ‖ξ‖ • fderiv Real (fun η : Euclidean 2 => ‖η‖) ξ := by
    ext v
    simp [ContinuousLinearMap.comp_apply, innerSL_apply_apply]
    ring
  rw [hcomp] at hder
  have hmul : ‖ξ‖ • fderiv Real (fun η : Euclidean 2 => ‖η‖) ξ =
      innerSL Real ξ := by
    ext v
    have hv := congrArg (fun L : Euclidean 2 →L[Real] Real => L v) hder
    simp at hv
    simpa using hv.symm
  have hnorm : ‖ξ‖ ≠ 0 := norm_ne_zero_iff.mpr hξ
  calc
    fderiv Real (fun η : Euclidean 2 => ‖η‖) ξ =
        (1 : Real) • fderiv Real (fun η : Euclidean 2 => ‖η‖) ξ := by simp
    _ = ((‖ξ‖)⁻¹ * ‖ξ‖) • fderiv Real (fun η : Euclidean 2 => ‖η‖) ξ := by
      rw [inv_mul_cancel₀ hnorm]
    _ = (‖ξ‖)⁻¹ • (‖ξ‖ • fderiv Real (fun η : Euclidean 2 => ‖η‖) ξ) := by
      rw [smul_smul]
    _ = (‖ξ‖)⁻¹ • innerSL Real ξ := by rw [hmul]

/-- Away from the origin, the first frequency derivative of the literal
ray phase is its radial gradient minus the ray direction. -/
theorem fderiv_angularDyadicRayPhaseMismatch
    (σ : WaveSign) (direction ξ : Euclidean 2) (hξ : ξ ≠ 0) :
    fderiv Real (angularDyadicRayPhaseMismatch σ direction) ξ =
      σ.toReal • ((‖ξ‖)⁻¹ • innerSL Real ξ) - innerSL Real direction := by
  unfold angularDyadicRayPhaseMismatch
  change fderiv Real
      ((σ.toReal) • (fun η : Euclidean 2 => ‖η‖) -
        (innerSL Real direction : Euclidean 2 → Real)) ξ = _
  have hnorm : DifferentiableAt Real (fun η : Euclidean 2 => ‖η‖) ξ :=
    (contDiffAt_norm Real hξ).differentiableAt one_ne_zero
  have hlinear : DifferentiableAt Real (innerSL Real direction) ξ :=
    (innerSL Real direction).differentiableAt
  rw [fderiv_sub (hnorm.const_smul σ.toReal) hlinear]
  rw [fderiv_const_smul hnorm σ.toReal]
  rw [fderiv_norm_eq_inv_smul_innerSL ξ hξ]
  change σ.toReal • ((‖ξ‖)⁻¹ • innerSL Real ξ) -
      fderiv Real (innerSL Real direction) ξ = _
  rw [ContinuousLinearMap.fderiv]

private theorem norm_ge_half_scale_of_mem_scaledRayBall
    {scale radius : Real} {direction ξ : Euclidean 2}
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * radius ≤ scale)
    (hξ : ξ ∈ Metric.closedBall (scale • direction) radius) :
    scale / 2 ≤ ‖ξ‖ := by
  rw [Metric.mem_closedBall, dist_eq_norm] at hξ
  have hcenter : ‖scale • direction‖ = scale := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hscale, hunit, mul_one]
  have hreverse := norm_sub_norm_le (scale • direction) ξ
  have hdist : ‖scale • direction - ξ‖ ≤ radius := by
    simpa only [norm_sub_rev] using hξ
  rw [hcenter] at hreverse
  linarith

private theorem fderiv_angularDyadicRayPhaseMismatch_plus_eq_innerSL_sub
    (direction ξ : Euclidean 2) (hξ : ξ ≠ 0) :
    fderiv Real (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ =
      innerSL Real ((‖ξ‖)⁻¹ • ξ - direction) := by
  rw [fderiv_angularDyadicRayPhaseMismatch WaveSign.plus direction ξ hξ]
  simp only [WaveSign.toReal, one_smul]
  ext v
  simp

private theorem norm_fderiv_angularDyadicRayPhaseMismatch_plus_eq
    (direction ξ : Euclidean 2) (hξ : ξ ≠ 0) :
    ‖fderiv Real (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ‖ =
      ‖(‖ξ‖)⁻¹ • ξ - direction‖ := by
  rw [fderiv_angularDyadicRayPhaseMismatch_plus_eq_innerSL_sub direction ξ hξ]
  exact innerSL_apply_norm (𝕜 := Real) _

private theorem normalized_sub_le_four_mul_radius_div_scale
    {scale radius : Real} {direction ξ : Euclidean 2}
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * radius ≤ scale)
    (hξ : ξ ∈ Metric.closedBall (scale • direction) radius) :
    ‖(‖ξ‖)⁻¹ • ξ - direction‖ ≤ 4 * radius / scale := by
  rw [Metric.mem_closedBall, dist_eq_norm] at hξ
  have hlower : scale / 2 ≤ ‖ξ‖ :=
    norm_ge_half_scale_of_mem_scaledRayBall hscale hunit hsmall
      (by simpa [Metric.mem_closedBall, dist_eq_norm] using hξ)
  have hnormpos : 0 < ‖ξ‖ := by linarith
  have hnormne : ‖ξ‖ ≠ 0 := hnormpos.ne'
  have hcenter : ‖scale • direction‖ = scale := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hscale, hunit, mul_one]
  have hnormdiff : |scale - ‖ξ‖| ≤ radius := by
    have h := abs_norm_sub_norm_le ξ (scale • direction)
    rw [hcenter] at h
    have h' : |scale - ‖ξ‖| ≤ ‖ξ - scale • direction‖ := by
      simpa [abs_sub_comm, norm_sub_rev] using h
    exact h'.trans hξ
  have hradius : 0 ≤ radius := (abs_nonneg (scale - ‖ξ‖)).trans hnormdiff
  have hinsidenorm : ‖ξ - ‖ξ‖ • direction‖ ≤ 2 * radius := by
    calc
      ‖ξ - ‖ξ‖ • direction‖ =
          ‖(ξ - scale • direction) + (scale - ‖ξ‖) • direction‖ := by
        congr 1
        module
      _ ≤ ‖ξ - scale • direction‖ + ‖(scale - ‖ξ‖) • direction‖ := norm_add_le _ _
      _ = ‖ξ - scale • direction‖ + |scale - ‖ξ‖| * ‖direction‖ := by
        rw [norm_smul, Real.norm_eq_abs]
      _ = ‖ξ - scale • direction‖ + |scale - ‖ξ‖| * 1 := by rw [hunit]
      _ = ‖ξ - scale • direction‖ + |scale - ‖ξ‖| := by ring
      _ ≤ radius + radius := add_le_add hξ hnormdiff
      _ = radius + radius * 1 := by ring
      _ = 2 * radius := by ring
  have hnormal : (‖ξ‖)⁻¹ ≤ 2 / scale := by
    have hhalfpos : 0 < scale / 2 := by linarith
    have hinv : (‖ξ‖)⁻¹ ≤ (scale / 2)⁻¹ :=
      (inv_le_inv₀ hnormpos hhalfpos).2 hlower
    calc
      (‖ξ‖)⁻¹ ≤ (scale / 2)⁻¹ := hinv
      _ = 2 / scale := by field_simp [hscale.ne']
  have hrewrite : (‖ξ‖)⁻¹ • ξ - direction =
      (‖ξ‖)⁻¹ • (ξ - ‖ξ‖ • direction) := by
    rw [smul_sub, smul_smul, inv_mul_cancel₀ hnormne, one_smul]
  calc
    ‖(‖ξ‖)⁻¹ • ξ - direction‖ =
        (‖ξ‖)⁻¹ * ‖ξ - ‖ξ‖ • direction‖ := by
      rw [hrewrite, norm_smul, Real.norm_eq_abs,
        abs_of_pos (inv_pos.mpr hnormpos)]
    _ ≤ (‖ξ‖)⁻¹ * (2 * radius) :=
      mul_le_mul_of_nonneg_left hinsidenorm (inv_nonneg.mpr hnormpos.le)
    _ ≤ (2 / scale) * (2 * radius) :=
      mul_le_mul_of_nonneg_right hnormal (mul_nonneg (by norm_num) hradius)
    _ = 4 * radius / scale := by ring

private theorem abs_angularDyadicRayPhaseMismatch_plus_le_two_mul_radius
    {scale radius : Real} {direction ξ : Euclidean 2}
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hξ : ξ ∈ Metric.closedBall (scale • direction) radius) :
    |angularDyadicRayPhaseMismatch WaveSign.plus direction ξ| ≤ 2 * radius := by
  rw [Metric.mem_closedBall, dist_eq_norm] at hξ
  have hcenter : ‖scale • direction‖ = scale := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hscale, hunit, mul_one]
  have hnormdiff : |‖ξ‖ - scale| ≤ radius := by
    have h := abs_norm_sub_norm_le ξ (scale • direction)
    rw [hcenter] at h
    exact h.trans hξ
  have hinnerdiff : |inner Real direction (scale • direction - ξ)| ≤ radius := by
    calc
      |inner Real direction (scale • direction - ξ)| ≤
          ‖direction‖ * ‖scale • direction - ξ‖ := abs_real_inner_le_norm _ _
      _ = ‖scale • direction - ξ‖ := by rw [hunit, one_mul]
      _ ≤ radius := by simpa only [norm_sub_rev] using hξ
  unfold angularDyadicRayPhaseMismatch
  simp only [WaveSign.toReal, one_mul]
  calc
    |‖ξ‖ - inner Real direction ξ| =
        |(‖ξ‖ - scale) + inner Real direction (scale • direction - ξ)| := by
      congr 1
      rw [inner_sub_right, inner_smul_right, real_inner_self_eq_norm_sq, hunit]
      ring
    _ ≤ |‖ξ‖ - scale| + |inner Real direction (scale • direction - ξ)| := abs_add_le _ _
    _ ≤ radius + radius := add_le_add hnormdiff hinnerdiff
    _ = 2 * radius := by ring

/-- On the support of every derivative of a concrete scaled ray-cube cutoff,
the literal plus-sheet phase mismatch has explicit zeroth- and first-order
frequency derivative bounds.  The smallness condition makes the cutoff ball
stay away from the frequency origin; the estimate is phase-specific and does
not assert a corresponding minus-sheet statement for the current shared
frequency/ray-direction parameterization. -/
theorem norm_iteratedFDeriv_angularDyadicRayPhaseMismatch_plus_zero_one_on_scaledRayCubeCutoff
    (prototype : SchwartzMap (Euclidean 2) Complex) (scale width : Real)
    (direction : Euclidean 2) (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (n : Nat) {ξ : Euclidean 2}
    (hξ : ξ ∈ Function.support (iteratedFDeriv Real n
      (scaledRayCubeCutoff prototype scale width direction hradius :
        Euclidean 2 → Complex))) :
    ‖iteratedFDeriv Real 0
        (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ‖ ≤
      2 * (width * Real.sqrt scale) ∧
    ‖iteratedFDeriv Real 1
        (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ‖ ≤
      4 * (width * Real.sqrt scale) / scale := by
  have hball := support_iteratedFDeriv_scaledRayCubeCutoff_subset_closedBall
    prototype scale width direction hradius hprototype n hξ
  have hzero : ξ ≠ 0 := by
    have hlower := norm_ge_half_scale_of_mem_scaledRayBall hscale hunit hsmall hball
    intro hzero
    subst ξ
    simp only [norm_zero] at hlower
    linarith
  constructor
  · rw [norm_iteratedFDeriv_zero]
    exact abs_angularDyadicRayPhaseMismatch_plus_le_two_mul_radius hscale hunit hball
  · rw [norm_iteratedFDeriv_one]
    rw [norm_fderiv_angularDyadicRayPhaseMismatch_plus_eq direction ξ hzero]
    exact normalized_sub_le_four_mul_radius_div_scale
      hscale hunit hsmall hball

/-- Compact time support turns the preceding mismatch estimate into an
explicit bound for the actual real phase argument `2π t (‖ξ‖ - ⟪direction,ξ⟫)`.
It is the literal phase-calculus input for the first-order residual-symbol
estimate; derivatives of the angular and dyadic amplitudes remain separate. -/
theorem norm_iteratedFDeriv_time_angularDyadicRayPhaseMismatch_plus_zero_one_on_scaledRayCubeCutoff
    (prototype : SchwartzMap (Euclidean 2) Complex) (scale width : Real)
    (direction : Euclidean 2) (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (T t : Real) (hT : 0 ≤ T) (ht : |t| ≤ T)
    (n : Nat) {ξ : Euclidean 2}
    (hξ : ξ ∈ Function.support (iteratedFDeriv Real n
      (scaledRayCubeCutoff prototype scale width direction hradius :
        Euclidean 2 → Complex))) :
    ‖iteratedFDeriv Real 0
        (fun η : Euclidean 2 => (2 * Real.pi * t) •
          angularDyadicRayPhaseMismatch WaveSign.plus direction η) ξ‖ ≤
      4 * Real.pi * T * (width * Real.sqrt scale) ∧
    ‖iteratedFDeriv Real 1
        (fun η : Euclidean 2 => (2 * Real.pi * t) •
          angularDyadicRayPhaseMismatch WaveSign.plus direction η) ξ‖ ≤
      8 * Real.pi * T * (width * Real.sqrt scale) / scale := by
  have hphase := norm_iteratedFDeriv_angularDyadicRayPhaseMismatch_plus_zero_one_on_scaledRayCubeCutoff
    prototype scale width direction hradius hprototype hscale hunit hsmall n hξ
  have hphase0 : ‖angularDyadicRayPhaseMismatch WaveSign.plus direction ξ‖ ≤
      2 * (width * Real.sqrt scale) := by
    simpa only [norm_iteratedFDeriv_zero] using hphase.1
  have hball := support_iteratedFDeriv_scaledRayCubeCutoff_subset_closedBall
    prototype scale width direction hradius hprototype n hξ
  have hzero : ξ ≠ 0 := by
    have hlower := norm_ge_half_scale_of_mem_scaledRayBall hscale hunit hsmall hball
    intro hzero
    subst ξ
    simp only [norm_zero] at hlower
    linarith
  have htime : |2 * Real.pi * t| ≤ 2 * Real.pi * T := by
    rw [abs_mul, abs_mul, abs_of_nonneg (by positivity : 0 ≤ (2 : Real)),
      abs_of_nonneg Real.pi_pos.le]
    exact mul_le_mul_of_nonneg_left ht (by positivity)
  have hphaseDiff : DifferentiableAt Real
      (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ := by
    unfold angularDyadicRayPhaseMismatch
    change DifferentiableAt Real
      ((WaveSign.plus.toReal) • (fun η : Euclidean 2 => ‖η‖) -
        (innerSL Real direction : Euclidean 2 → Real)) ξ
    exact (((contDiffAt_norm Real hzero).differentiableAt one_ne_zero).const_smul _).sub
      ((innerSL Real direction).differentiableAt)
  constructor
  · rw [norm_iteratedFDeriv_zero, norm_smul]
    calc
      |2 * Real.pi * t| * ‖angularDyadicRayPhaseMismatch WaveSign.plus direction ξ‖ ≤
          (2 * Real.pi * T) * (2 * (width * Real.sqrt scale)) :=
        mul_le_mul htime hphase0 (norm_nonneg _) (by positivity)
      _ = 4 * Real.pi * T * (width * Real.sqrt scale) := by ring
  · rw [norm_iteratedFDeriv_one]
    change ‖fderiv Real
      ((2 * Real.pi * t) • angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ‖ ≤ _
    rw [fderiv_const_smul hphaseDiff]
    rw [norm_smul]
    calc
      |2 * Real.pi * t| * ‖fderiv Real
          (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ‖ ≤
          (2 * Real.pi * T) * (4 * (width * Real.sqrt scale) / scale) :=
        mul_le_mul htime (by
          simpa only [norm_iteratedFDeriv_one] using hphase.2)
          (norm_nonneg _) (by positivity)
      _ = 8 * Real.pi * T * (width * Real.sqrt scale) / scale := by ring

/-- The residual base amplitude has exactly the phase mismatch
`σ‖ξ‖ - ⟪direction, ξ⟫`; the other factor is the literal angular/dyadic
cutoff amplitude. -/
theorem angularDyadicResidualBaseSymbol_eq_phaseMismatch
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (direction ξ : Euclidean 2) (χ : SchwartzMap (Euclidean 2) Complex) :
    angularDyadicResidualBaseSymbol C σ j t direction χ ξ =
      Complex.exp
          (((2 * Real.pi * t * angularDyadicRayPhaseMismatch σ direction ξ : Real) : Complex) *
            Complex.I) *
        (χ ξ * dyadicBandpassMultiplier C.cutoff j ξ) := by
  rw [angularDyadicResidualBaseSymbol_apply,
    dyadicHalfWaveSchwartzSymbol_apply, dyadicHalfWaveSymbol]
  simp only [Real.fourierChar_apply]
  rw [halfWaveMultiplier]
  rw [show
    Complex.exp (((2 * Real.pi * inner Real (-(t • direction)) ξ : Real) : Complex) *
        Complex.I) *
        (χ ξ *
          (Complex.exp (((σ.toReal * (2 * Real.pi) * t * ‖ξ‖ : Real) : Complex) *
            Complex.I) * dyadicBandpassMultiplier C.cutoff j ξ)) =
      (Complex.exp (((2 * Real.pi * inner Real (-(t • direction)) ξ : Real) : Complex) *
          Complex.I) *
        Complex.exp (((σ.toReal * (2 * Real.pi) * t * ‖ξ‖ : Real) : Complex) *
          Complex.I)) *
        (χ ξ * dyadicBandpassMultiplier C.cutoff j ξ) by ring]
  rw [← Complex.exp_add]
  congr 1
  simp [angularDyadicRayPhaseMismatch, inner_neg_left, inner_smul_left]
  ring_nf

/-- The literal angular--dyadic amplitude remaining after the ray phase is
removed.  It is a genuine Schwartz multiplier, so its seminorms provide
concrete finite-order amplitude constants. -/
noncomputable def angularDyadicResidualAmplitude
    (C : lpCutoffs 2) (j : Nat) (χ : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex (χ : Euclidean 2 → Complex)
    (dyadicBandpassMultiplier C.cutoff j)

/-- Pointwise form of the literal angular--dyadic residual amplitude. -/
theorem angularDyadicResidualAmplitude_apply
    (C : lpCutoffs 2) (j : Nat) (χ : SchwartzMap (Euclidean 2) Complex)
    (ξ : Euclidean 2) :
    angularDyadicResidualAmplitude C j χ ξ =
      χ ξ * dyadicBandpassMultiplier C.cutoff j ξ := by
  rw [angularDyadicResidualAmplitude,
    SchwartzMap.smulLeftCLM_apply_apply χ.hasTemperateGrowth]
  simp only [smul_eq_mul]

private theorem norm_angularDyadicResidualAmplitude_zero_one
    (C : lpCutoffs 2) (j : Nat) (χ : SchwartzMap (Euclidean 2) Complex)
    (ξ : Euclidean 2) :
    ‖angularDyadicResidualAmplitude C j χ ξ‖ ≤
      SchwartzMap.seminorm Real 0 0 (angularDyadicResidualAmplitude C j χ) ∧
    ‖fderiv Real (angularDyadicResidualAmplitude C j χ :
        Euclidean 2 → Complex) ξ‖ ≤
      SchwartzMap.seminorm Real 0 1 (angularDyadicResidualAmplitude C j χ) := by
  constructor
  · simpa using SchwartzMap.le_seminorm Real 0 0
      (angularDyadicResidualAmplitude C j χ) ξ
  · rw [← norm_iteratedFDeriv_one]
    simpa using SchwartzMap.le_seminorm Real 0 1
      (angularDyadicResidualAmplitude C j χ) ξ

private theorem norm_fderiv_exp_ofReal_mul_I_le
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    (g : E → Real) (x : E) (hg : DifferentiableAt Real g x) :
    ‖fderiv Real (fun y => Complex.exp (((g y : Real) : Complex) * Complex.I)) x‖ ≤
      ‖fderiv Real g x‖ := by
  let L : Real →L[Real] Complex := Complex.ofRealCLM.smulRight Complex.I
  have hL : ∀ r : Real, L r = ((r : Complex) * Complex.I) := by
    intro r
    simp [L, ContinuousLinearMap.smulRight_apply, smul_eq_mul]
  have hcomp : HasFDerivAt (fun y => L (g y))
      (L.comp (fderiv Real g x)) x := by
    exact L.hasFDerivAt.comp x hg.hasFDerivAt
  have hexp := hcomp.cexp.fderiv
  have hfun : (fun y => Complex.exp (((g y : Real) : Complex) * Complex.I)) =
      fun y => Complex.exp (L (g y)) := by
    funext y
    rw [hL]
  rw [hfun, hexp]
  apply ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg _)
  intro v
  rw [ContinuousLinearMap.smul_apply, norm_smul, hL (g x),
    Complex.norm_exp_ofReal_mul_I]
  simp only [one_mul, ContinuousLinearMap.comp_apply]
  change ‖L (fderiv Real g x v)‖ ≤ ‖fderiv Real g x‖ * ‖v‖
  rw [hL]
  simp only [norm_mul, Complex.norm_real, Complex.norm_I, mul_one]
  exact (fderiv Real g x).le_opNorm v

private theorem angularDyadicResidualBaseSymbol_plus_eq_phaseAmplitude
    (C : lpCutoffs 2) (j : Nat) (t : Real)
    (direction ξ : Euclidean 2) (χ : SchwartzMap (Euclidean 2) Complex) :
    angularDyadicResidualBaseSymbol C WaveSign.plus j t direction χ ξ =
      Complex.exp
        (((((2 * Real.pi * t) •
          angularDyadicRayPhaseMismatch WaveSign.plus direction ξ : Real) : Complex) *
          Complex.I)) * angularDyadicResidualAmplitude C j χ ξ := by
  rw [angularDyadicResidualBaseSymbol_eq_phaseMismatch,
    angularDyadicResidualAmplitude_apply]
  congr 1

private theorem norm_fderiv_angularDyadicResidualBaseSymbol_plus
    (C : lpCutoffs 2) (j : Nat) (T t scale width : Real)
    (direction : Euclidean 2) (χ prototype : SchwartzMap (Euclidean 2) Complex)
    (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (hT : 0 ≤ T) (ht : |t| ≤ T)
    (n : Nat) {ξ : Euclidean 2}
    (hξ : ξ ∈ Function.support (iteratedFDeriv Real n
      (scaledRayCubeCutoff prototype scale width direction hradius :
        Euclidean 2 → Complex))) :
    ‖fderiv Real (angularDyadicResidualBaseSymbol C WaveSign.plus j t direction χ :
      Euclidean 2 → Complex) ξ‖ ≤
      SchwartzMap.seminorm Real 0 1 (angularDyadicResidualAmplitude C j χ) +
        (8 * Real.pi * T * (width * Real.sqrt scale) / scale) *
          SchwartzMap.seminorm Real 0 0 (angularDyadicResidualAmplitude C j χ) := by
  let g : Euclidean 2 → Real :=
    (2 * Real.pi * t) • angularDyadicRayPhaseMismatch WaveSign.plus direction
  let phase : Euclidean 2 → Complex := fun η =>
    Complex.exp (((g η : Real) : Complex) * Complex.I)
  let amp : SchwartzMap (Euclidean 2) Complex := angularDyadicResidualAmplitude C j χ
  have hball := support_iteratedFDeriv_scaledRayCubeCutoff_subset_closedBall
    prototype scale width direction hradius hprototype n hξ
  have hzero : ξ ≠ 0 := by
    have hlower := norm_ge_half_scale_of_mem_scaledRayBall hscale hunit hsmall hball
    intro hzero
    subst ξ
    simp only [norm_zero] at hlower
    linarith
  have hmisdiff : DifferentiableAt Real
      (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ := by
    unfold angularDyadicRayPhaseMismatch
    change DifferentiableAt Real
      ((WaveSign.plus.toReal) • (fun η : Euclidean 2 => ‖η‖) -
        (innerSL Real direction : Euclidean 2 → Real)) ξ
    exact (((contDiffAt_norm Real hzero).differentiableAt one_ne_zero).const_smul _).sub
      ((innerSL Real direction).differentiableAt)
  have hg : DifferentiableAt Real g ξ := by
    simpa only [g] using hmisdiff.const_smul (2 * Real.pi * t)
  let L : Real →L[Real] Complex := Complex.ofRealCLM.smulRight Complex.I
  have hphaseDiff : DifferentiableAt Real phase ξ := by
    change DifferentiableAt Real (fun η => Complex.exp (L (g η))) ξ
    exact (L.differentiableAt.comp ξ hg).cexp
  have hampDiff : DifferentiableAt Real (amp : Euclidean 2 → Complex) ξ :=
    amp.differentiableAt
  have hphaseDeriv := norm_fderiv_exp_ofReal_mul_I_le g ξ hg
  have htime :=
    norm_iteratedFDeriv_time_angularDyadicRayPhaseMismatch_plus_zero_one_on_scaledRayCubeCutoff
      prototype scale width direction hradius hprototype hscale hunit hsmall T t hT ht n hξ
  have hgDeriv : ‖fderiv Real g ξ‖ ≤
      8 * Real.pi * T * (width * Real.sqrt scale) / scale := by
    rw [← norm_iteratedFDeriv_one]
    exact htime.2
  have hphaseDeriv' : ‖fderiv Real phase ξ‖ ≤
      8 * Real.pi * T * (width * Real.sqrt scale) / scale := by
    exact hphaseDeriv.trans hgDeriv
  have hamp := norm_angularDyadicResidualAmplitude_zero_one C j χ ξ
  have hbase : (angularDyadicResidualBaseSymbol C WaveSign.plus j t direction χ :
      Euclidean 2 → Complex) = fun η => phase η * amp η := by
    funext η
    rw [angularDyadicResidualBaseSymbol_plus_eq_phaseAmplitude]
    rfl
  rw [hbase]
  change ‖fderiv Real (phase * (amp : Euclidean 2 → Complex)) ξ‖ ≤ _
  rw [fderiv_mul hphaseDiff hampDiff]
  calc
    ‖phase ξ • fderiv Real (amp : Euclidean 2 → Complex) ξ +
        amp ξ • fderiv Real phase ξ‖ ≤
      ‖phase ξ • fderiv Real (amp : Euclidean 2 → Complex) ξ‖ +
        ‖amp ξ • fderiv Real phase ξ‖ := norm_add_le _ _
    _ = ‖phase ξ‖ * ‖fderiv Real (amp : Euclidean 2 → Complex) ξ‖ +
        ‖amp ξ‖ * ‖fderiv Real phase ξ‖ := by rw [norm_smul, norm_smul]
    _ ≤ 1 * SchwartzMap.seminorm Real 0 1 amp +
        SchwartzMap.seminorm Real 0 0 amp *
          (8 * Real.pi * T * (width * Real.sqrt scale) / scale) := by
      apply add_le_add
      · apply mul_le_mul
        · change ‖Complex.exp (((g ξ : Real) : Complex) * Complex.I)‖ ≤ 1
          rw [Complex.norm_exp_ofReal_mul_I]
        · exact hamp.2
        · positivity
        · norm_num
      · apply mul_le_mul
        · exact hamp.1
        · exact hphaseDeriv'
        · positivity
        · positivity
    _ = SchwartzMap.seminorm Real 0 1 (angularDyadicResidualAmplitude C j χ) +
        (8 * Real.pi * T * (width * Real.sqrt scale) / scale) *
          SchwartzMap.seminorm Real 0 0 (angularDyadicResidualAmplitude C j χ) := by
      change _ = SchwartzMap.seminorm Real 0 1 amp + _
      ring

/-- On every derivative support of a matched plus-sheet scaled ray cutoff,
the actual residual base symbol has literal zeroth- and first-order bounds.
The constants are the seminorms of the actual angular--dyadic amplitude and
the compact-time phase-mismatch contribution. -/
theorem norm_iteratedFDeriv_angularDyadicResidualBaseSymbol_plus_zero_one_on_scaledRayCubeCutoff
    (C : lpCutoffs 2) (j : Nat) (T t scale width : Real)
    (direction : Euclidean 2) (χ prototype : SchwartzMap (Euclidean 2) Complex)
    (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (hT : 0 ≤ T) (ht : |t| ≤ T)
    (n : Nat) {ξ : Euclidean 2}
    (hξ : ξ ∈ Function.support (iteratedFDeriv Real n
      (scaledRayCubeCutoff prototype scale width direction hradius :
        Euclidean 2 → Complex))) :
    ‖iteratedFDeriv Real 0
        (angularDyadicResidualBaseSymbol C WaveSign.plus j t direction χ :
          Euclidean 2 → Complex) ξ‖ ≤
      SchwartzMap.seminorm Real 0 0 (angularDyadicResidualAmplitude C j χ) ∧
    ‖iteratedFDeriv Real 1
        (angularDyadicResidualBaseSymbol C WaveSign.plus j t direction χ :
          Euclidean 2 → Complex) ξ‖ ≤
      SchwartzMap.seminorm Real 0 1 (angularDyadicResidualAmplitude C j χ) +
        (8 * Real.pi * T * (width * Real.sqrt scale) / scale) *
          SchwartzMap.seminorm Real 0 0 (angularDyadicResidualAmplitude C j χ) := by
  constructor
  · rw [norm_iteratedFDeriv_zero,
      angularDyadicResidualBaseSymbol_plus_eq_phaseAmplitude,
      norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
    exact (norm_angularDyadicResidualAmplitude_zero_one C j χ ξ).1
  · rw [norm_iteratedFDeriv_one]
    exact norm_fderiv_angularDyadicResidualBaseSymbol_plus
      C j T t scale width direction χ prototype hradius hprototype hscale hunit hsmall
      hT ht n hξ

/-- Exact translation from the literal spatial kernel to its ray-residual
kernel.  This is the physical-coordinate input for a genuine tube-decay
estimate, with no modeled replacement kernel. -/
theorem angularDyadicCubeKernel_eq_residual_shifted
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (direction : Euclidean 2) (χ m : SchwartzMap (Euclidean 2) Complex)
    (u : Euclidean 2) :
    angularDyadicCubeKernel C σ j t χ m u =
      SmoothDyadicPhysicalCore.fourierCubeKernel
        (angularDyadicCubeResidualSymbol C σ j t direction χ m)
        (u + t • direction) := by
  simp only [angularDyadicCubeKernel,
    SmoothDyadicPhysicalCore.fourierCubeKernel]
  symm
  unfold angularDyadicCubeResidualSymbol
  rw [SchwartzMap.fourierInv_coe, SchwartzMap.fourierInv_coe]
  rw [SmoothDyadicPhysicalCore.fourierInv_planeWaveModulatedCompactSchwartz_eq_translate]
  simp only [add_neg_cancel_right]

/-- The literal finite physical kernel obtained by summing actual angular
half-wave/cube symbols. -/
noncomputable def angularDyadicCubeKernelSum {κ : Type*}
    (cubes : Finset κ) (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ : SchwartzMap (Euclidean 2) Complex)
    (m : κ → SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  𝓕⁻ (∑ cube ∈ cubes, angularDyadicCubeSchwartzSymbol C σ j t χ (m cube))

/-- Finite summation commutes with the literal angular half-wave/cube
physical kernel. -/
theorem angularDyadicCubeKernelSum_eq_sum {κ : Type*}
    (cubes : Finset κ) (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (χ : SchwartzMap (Euclidean 2) Complex)
    (m : κ → SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    angularDyadicCubeKernelSum cubes C σ j t χ m x =
      ∑ cube ∈ cubes, angularDyadicCubeKernel C σ j t χ (m cube) x := by
  classical
  unfold angularDyadicCubeKernelSum angularDyadicCubeKernel
  rw [fourierInv_sum]
  change (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean 2) Complex)
    (Euclidean 2) Complex)
      (∑ cube ∈ cubes, 𝓕⁻ (angularDyadicCubeSchwartzSymbol C σ j t χ (m cube))) x = _
  rw [map_sum, Finset.sum_apply]
  rfl

/-- The finite space-time packet kernel associated to a family of actual
angular dyadic cube multipliers. -/
noncomputable def angularDyadicCubeSpaceTimeKernelSum {κ : Type*}
    (cubes : Finset κ) (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ : SchwartzMap (Euclidean 2) Complex)
    (m : κ → SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (z : WaveSpaceTime) (y : Euclidean 2) : Complex :=
  ϑ z.2 * angularDyadicCubeKernelSum cubes C σ j z.2 χ m (z.1 - y)

/-- Finite packet summation commutes exactly with the literal space-time
source kernel. -/
theorem angularDyadicCubeSpaceTimeKernelSum_eq_sum {κ : Type*}
    (cubes : Finset κ) (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ : SchwartzMap (Euclidean 2) Complex)
    (m : κ → SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (z : WaveSpaceTime) (y : Euclidean 2) :
    angularDyadicCubeSpaceTimeKernelSum cubes C σ j χ m ϑ z y =
      ∑ cube ∈ cubes,
        angularDyadicCubeSpaceTimeKernel C σ j χ (m cube) ϑ z y := by
  unfold angularDyadicCubeSpaceTimeKernelSum angularDyadicCubeSpaceTimeKernel
  rw [angularDyadicCubeKernelSum_eq_sum, Finset.mul_sum]

/-- A literal cube packet kernel remains integrable after multiplication by
Schwartz data. -/
theorem integrable_angularDyadicCubeSpaceTimeKernel_mul {κ : Type*}
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ : SchwartzMap (Euclidean 2) Complex)
    (m : κ → SchwartzMap (Euclidean 2) Complex) (cube : κ)
    (ϑ : Real → Complex) (f : SchwartzMap (Euclidean 2) Complex)
    (z : WaveSpaceTime) :
    Integrable (fun y : Euclidean 2 =>
      angularDyadicCubeSpaceTimeKernel C σ j χ (m cube) ϑ z y * f y) volume := by
  apply (angularDyadicCubeSpaceTimeKernel_integrable C σ j χ (m cube) ϑ z).mul_bdd
  · exact f.continuous.aestronglyMeasurable
  · filter_upwards with y
    exact SchwartzMap.norm_le_seminorm Complex f y

/-- The actual finite packet sum obtained by integrating the summed source
kernel against Schwartz data. -/
noncomputable def angularDyadicCubePacket {κ : Type*}
    (cubes : Finset κ) (C : lpCutoffs 2) (j : Nat)
    (χ : SchwartzMap (Euclidean 2) Complex)
    (m : κ → SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (z : WaveSpaceTime) : Complex :=
  ∫ y : Euclidean 2,
    angularDyadicCubeSpaceTimeKernelSum cubes C WaveSign.plus j χ m ϑ z y * f y

private theorem angularDyadicCubePacket_eq_sum_of_integrable {κ : Type*}
    (cubes : Finset κ) (C : lpCutoffs 2) (j : Nat)
    (χ : SchwartzMap (Euclidean 2) Complex)
    (m : κ → SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (z : WaveSpaceTime)
    (hint : ∀ cube ∈ cubes, Integrable (fun y : Euclidean 2 =>
      angularDyadicCubeSpaceTimeKernel C WaveSign.plus j χ (m cube) ϑ z y * f y) volume) :
    angularDyadicCubePacket cubes C j χ m ϑ f z =
      ∑ cube ∈ cubes,
        angularPiece ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0)
          (χ : Euclidean 2 → Complex) ϑ (fourierCubeProjection (m cube) f) z := by
  unfold angularDyadicCubePacket
  simp_rw [angularDyadicCubeSpaceTimeKernelSum_eq_sum]
  have hpoint : (fun y : Euclidean 2 =>
      (∑ cube ∈ cubes,
        angularDyadicCubeSpaceTimeKernel C WaveSign.plus j χ (m cube) ϑ z y) * f y) =
      fun y : Euclidean 2 => ∑ cube ∈ cubes,
        angularDyadicCubeSpaceTimeKernel C WaveSign.plus j χ (m cube) ϑ z y * f y := by
    funext y
    rw [Finset.sum_mul]
  rw [hpoint, integral_finsetSum cubes hint]
  apply Finset.sum_congr rfl
  intro cube hcube
  exact (angularPiece_dyadicCube_eq_spaceTimeKernel C j χ (m cube) f ϑ z).symm

/-- A concrete finite angular half-wave packet is exactly the sum of its
literal cube-projected angular pieces.  This is a reconstruction identity,
not a claim that the cube family covers every angular packet. -/
theorem angularDyadicCubePacket_eq_sum {κ : Type*}
    (cubes : Finset κ) (C : lpCutoffs 2) (j : Nat)
    (χ : SchwartzMap (Euclidean 2) Complex)
    (m : κ → SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (z : WaveSpaceTime) :
    angularDyadicCubePacket cubes C j χ m ϑ f z =
      ∑ cube ∈ cubes,
        angularPiece ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0)
          (χ : Euclidean 2 → Complex) ϑ (fourierCubeProjection (m cube) f) z := by
  apply angularDyadicCubePacket_eq_sum_of_integrable
  intro cube hcube
  exact integrable_angularDyadicCubeSpaceTimeKernel_mul
    C WaveSign.plus j χ m cube ϑ f z

/-- A singleton literal packet is its time cutoff times the fixed-time cube
piece.  Together with the fixed-time Fourier-support theorem above, this
records the concrete spatial-frequency content of one packet without claiming
space-time conic-plate support. -/
theorem angularDyadicCubePacket_singleton_eq_timeCutoff_mul_piece
    {κ : Type*} (cube : κ) (C : lpCutoffs 2) (j : Nat)
    (χ : SchwartzMap (Euclidean 2) Complex)
    (m : κ → SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (z : WaveSpaceTime) :
    angularDyadicCubePacket ({cube} : Finset κ) C j χ m ϑ f z =
      ϑ z.2 * angularDyadicCubePiece C WaveSign.plus j z.2 χ (m cube) f z.1 := by
  classical
  rw [angularDyadicCubePacket_eq_sum]
  simp only [Finset.sum_singleton]
  rw [angularPiece_dyadicCube_eq_spaceTimeKernel]
  unfold angularDyadicCubeSpaceTimeKernel
  rw [show (fun y : Euclidean 2 =>
      (ϑ z.2 * angularDyadicCubeKernel C WaveSign.plus j z.2 χ (m cube) (z.1 - y)) * f y) =
      fun y => ϑ z.2 *
        (angularDyadicCubeKernel C WaveSign.plus j z.2 χ (m cube) (z.1 - y) * f y) by
        funext y
        ring]
  rw [integral_const_mul]
  rw [← angularDyadicCubePiece_eq_sourceKernel]

/-- The smooth, normalized kernel used by the two-dimensional light-ray
maximal operator.  Writing the decay exponent as a natural number avoids a
separate real-power theory while retaining the arbitrary high decay used by
the proof. -/
def lightRayKernel (δ : Real) (N : Nat) (ω y : Euclidean 2)
    (z : WaveSpaceTime) : Real :=
  (δ⁻¹) ^ 2 * (1 + δ⁻¹ * ‖z.1 + z.2 • ω - y‖)⁻¹ ^ N

/-- Modulation does not enlarge the literal frequency cube of an
angular/cube packet. -/
theorem support_angularDyadicCubeResidualSymbol_subset_frequencyCube
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t scale width : Real)
    (direction : Euclidean 2) (χ m : SchwartzMap (Euclidean 2) Complex)
    (hm : isScaledRayCubeCutoff scale width direction m) :
    Function.support (angularDyadicCubeResidualSymbol C σ j t direction χ m :
      Euclidean 2 → Complex) ⊆
        frequencyCube (scale • direction) (width * Real.sqrt scale) := by
  intro ξ hξ
  have hsymbol : angularDyadicCubeSchwartzSymbol C σ j t χ m ξ ≠ 0 := by
    intro hzero
    apply hξ
    rw [angularDyadicCubeResidualSymbol_apply, hzero, mul_zero]
  exact support_angularDyadicCubeSchwartzSymbol_subset_frequencyCube C σ j t χ m
    (scale • direction) (width * Real.sqrt scale) hm hsymbol

/-- A physical Schwartz seminorm of the literal ray-residual symbol is
controlled by the finite sum of its actual frequency-side derivative `L¹`
norms.  This is the Fourier integration-by-parts reduction needed for ray
localization.  It deliberately does not claim a scale- or time-uniform bound:
the current cube interface records support but not cutoff derivative bounds,
and a uniform phase estimate also requires a bounded time support. -/
theorem angularDyadicCubeResidualSymbol_fourierInv_seminorm_le_derivativeIntegrals
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (direction : Euclidean 2) (χ m : SchwartzMap (Euclidean 2) Complex)
    (N : Nat) :
    SchwartzMap.seminorm ℂ N 0
      (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m) :
        SchwartzMap (Euclidean 2) ℂ) ≤
      (2 : Real) ^ N * ∑ n ∈ Finset.range (N + 1),
        ∫ ξ : Euclidean 2,
          ‖iteratedFDeriv Real n
            (angularDyadicCubeResidualSymbol C σ j t direction χ m :
              Euclidean 2 → Complex) ξ‖ := by
  apply SchwartzMap.seminorm_le_bound Complex N 0
    (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m) :
      SchwartzMap (Euclidean 2) ℂ)
  · exact mul_nonneg (by positivity)
      (Finset.sum_nonneg fun _ _ => integral_nonneg fun _ => norm_nonneg _)
  · intro x
    rw [norm_iteratedFDeriv_zero]
    rw [SchwartzMap.fourierInv_coe]
    change ‖x‖ ^ N * ‖𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m :
      Euclidean 2 → Complex) x‖ ≤ _
    have h := Real.pow_mul_norm_iteratedFDeriv_fourier_le
      (f := (angularDyadicCubeResidualSymbol C σ j t direction χ m :
        Euclidean 2 → Complex)) (K := 0) (N := N)
      ((angularDyadicCubeResidualSymbol C σ j t direction χ m).smooth N)
      (fun k n hk hn => by
        have hk' : k = 0 := by simpa using hk
        subst k
        simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume
          (angularDyadicCubeResidualSymbol C σ j t direction χ m) 0 n)
      (k := 0) (n := N) (by simp) (by simp) (-x)
    simpa [Real.fourierInv_eq_fourier_neg] using h

/-- Explicit residual Schwartz-seminorm bounds give literal light-ray decay
for an angular half-wave/cube kernel.  The constant `T` controls the concrete
time cutoff.  This is a theorem about the actual Fourier kernel, not a
replacement localization predicate. -/
theorem norm_angularDyadicCubeSpaceTimeKernel_le_lightRayKernel_of_residual_seminorm
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ m : SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (δ A T : Real) (N : Nat) (direction : Euclidean 2)
    (hδ : 0 < δ) (hϑ : ∀ t, ‖ϑ t‖ ≤ T)
    (hN : ∀ t, SchwartzMap.seminorm ℂ N 0
      (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m) :
        SchwartzMap (Euclidean 2) ℂ) ≤ (A * (δ⁻¹) ^ 2) * δ ^ N)
    (hzero : ∀ t, SchwartzMap.seminorm ℂ 0 0
      (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m) :
        SchwartzMap (Euclidean 2) ℂ) ≤ A * (δ⁻¹) ^ 2)
    (z : WaveSpaceTime) (y : Euclidean 2) :
    ‖angularDyadicCubeSpaceTimeKernel C σ j χ m ϑ z y‖ ≤
      (T * (2 : Real) ^ N * A) * lightRayKernel δ N direction y z := by
  have hT : 0 ≤ T := (norm_nonneg (ϑ 0)).trans (hϑ 0)
  have hdecay := SmoothDyadicPhysicalCore.norm_fourierCubeKernel_le_scaled_seminorm_decay
    (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m)
    δ (A * (δ⁻¹) ^ 2) N hδ (hzero z.2) (hN z.2)
    (z.1 + z.2 • direction - y)
  have htranslate : (z.1 - y) + z.2 • direction =
      z.1 + z.2 • direction - y := by
    module
  calc
    ‖angularDyadicCubeSpaceTimeKernel C σ j χ m ϑ z y‖ =
        ‖ϑ z.2‖ * ‖angularDyadicCubeKernel C σ j z.2 χ m (z.1 - y)‖ := by
      rw [angularDyadicCubeSpaceTimeKernel, norm_mul]
    _ = ‖ϑ z.2‖ * ‖SmoothDyadicPhysicalCore.fourierCubeKernel
          (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m)
          (z.1 + z.2 • direction - y)‖ := by
      rw [angularDyadicCubeKernel_eq_residual_shifted, htranslate]
    _ ≤ T * ‖SmoothDyadicPhysicalCore.fourierCubeKernel
          (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m)
          (z.1 + z.2 • direction - y)‖ :=
      mul_le_mul_of_nonneg_right (hϑ z.2) (norm_nonneg _)
    _ ≤ T * ((2 : Real) ^ N * (A * (δ⁻¹) ^ 2) *
          (1 + δ⁻¹ * ‖z.1 + z.2 • direction - y‖)⁻¹ ^ N) :=
      mul_le_mul_of_nonneg_left hdecay hT
    _ = (T * (2 : Real) ^ N * A) * lightRayKernel δ N direction y z := by
      unfold lightRayKernel
      ring

/-- A concrete scaled Fourier cube together with the two residual seminorm
bounds is a literal ray-localized packet: the first conclusion records its
frequency support, and the second gives its physical light-ray decay. -/
theorem angularDyadicCubePacket_ray_localized_of_residual_seminorm
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ m : SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (scale width δ A T : Real) (N : Nat) (direction : Euclidean 2)
    (hm : isScaledRayCubeCutoff scale width direction m)
    (hδ : 0 < δ) (hϑ : ∀ t, ‖ϑ t‖ ≤ T)
    (hN : ∀ t, SchwartzMap.seminorm ℂ N 0
      (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m) :
        SchwartzMap (Euclidean 2) ℂ) ≤ (A * (δ⁻¹) ^ 2) * δ ^ N)
    (hzero : ∀ t, SchwartzMap.seminorm ℂ 0 0
      (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m) :
        SchwartzMap (Euclidean 2) ℂ) ≤ A * (δ⁻¹) ^ 2) :
    (∀ t, Function.support (angularDyadicCubeResidualSymbol C σ j t direction χ m :
      Euclidean 2 → Complex) ⊆
        frequencyCube (scale • direction) (width * Real.sqrt scale)) ∧
    (∀ z y, ‖angularDyadicCubeSpaceTimeKernel C σ j χ m ϑ z y‖ ≤
      (T * (2 : Real) ^ N * A) * lightRayKernel δ N direction y z) := by
  refine ⟨?_, ?_⟩
  · intro t
    exact support_angularDyadicCubeResidualSymbol_subset_frequencyCube
      C σ j t scale width direction χ m hm
  · intro z y
    exact norm_angularDyadicCubeSpaceTimeKernel_le_lightRayKernel_of_residual_seminorm
      C σ j χ m ϑ δ A T N direction hδ hϑ hN hzero z y

/-- Explicit finite `L¹` bounds for derivatives of the actual residual
angular/cube symbol give literal frequency-cube support and light-ray decay.
The hypotheses expose the remaining analytic input rather than replacing it
with a localization predicate: to verify them uniformly one still needs
quantitative cutoff derivative bounds and a bounded time support for `ϑ`. -/
theorem angularDyadicCubePacket_ray_localized_of_residual_derivativeIntegrals
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ m : SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (scale width δ A T : Real) (N : Nat) (direction : Euclidean 2)
    (hm : isScaledRayCubeCutoff scale width direction m)
    (hδ : 0 < δ) (hϑ : ∀ t, ‖ϑ t‖ ≤ T)
    (hderivN : ∀ t, (2 : Real) ^ N *
      (∑ n ∈ Finset.range (N + 1), ∫ ξ : Euclidean 2,
        ‖iteratedFDeriv Real n
          (angularDyadicCubeResidualSymbol C σ j t direction χ m :
            Euclidean 2 → Complex) ξ‖) ≤
        (A * (δ⁻¹) ^ 2) * δ ^ N)
    (hderiv0 : ∀ t, ∫ ξ : Euclidean 2,
      ‖angularDyadicCubeResidualSymbol C σ j t direction χ m ξ‖ ≤
        A * (δ⁻¹) ^ 2) :
    (∀ t, Function.support (angularDyadicCubeResidualSymbol C σ j t direction χ m :
      Euclidean 2 → Complex) ⊆
        frequencyCube (scale • direction) (width * Real.sqrt scale)) ∧
    (∀ z y, ‖angularDyadicCubeSpaceTimeKernel C σ j χ m ϑ z y‖ ≤
      (T * (2 : Real) ^ N * A) * lightRayKernel δ N direction y z) := by
  apply angularDyadicCubePacket_ray_localized_of_residual_seminorm
    C σ j χ m ϑ scale width δ A T N direction hm hδ hϑ
  · intro t
    exact (angularDyadicCubeResidualSymbol_fourierInv_seminorm_le_derivativeIntegrals
      C σ j t direction χ m N).trans (hderivN t)
  · intro t
    calc
      SchwartzMap.seminorm ℂ 0 0
        (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m) :
          SchwartzMap (Euclidean 2) ℂ) ≤
          (2 : Real) ^ 0 * ∑ n ∈ Finset.range (0 + 1),
            ∫ ξ : Euclidean 2,
              ‖iteratedFDeriv Real n
                (angularDyadicCubeResidualSymbol C σ j t direction χ m :
                  Euclidean 2 → Complex) ξ‖ :=
        angularDyadicCubeResidualSymbol_fourierInv_seminorm_le_derivativeIntegrals
          C σ j t direction χ m 0
      _ = ∫ ξ : Euclidean 2,
          ‖angularDyadicCubeResidualSymbol C σ j t direction χ m ξ‖ := by
        simp
      _ ≤ A * (δ⁻¹) ^ 2 := hderiv0 t

/-- The natural physical width for a cube of frequency radius `sqrt scale`
is `1 / sqrt scale`.  This specializes the preceding literal localization
theorem to the MSS ray scale. -/
theorem scaledRayCube_angularDyadicCubePacket_ray_localized_of_residual_seminorm
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ m : SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (scale width A T : Real) (N : Nat) (direction : Euclidean 2)
    (hscale : 0 < scale)
    (hm : isScaledRayCubeCutoff scale width direction m)
    (hϑ : ∀ t, ‖ϑ t‖ ≤ T)
    (hN : ∀ t, SchwartzMap.seminorm ℂ N 0
      (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m) :
        SchwartzMap (Euclidean 2) ℂ) ≤
        (A * (Real.sqrt scale) ^ 2) * (Real.sqrt scale)⁻¹ ^ N)
    (hzero : ∀ t, SchwartzMap.seminorm ℂ 0 0
      (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m) :
        SchwartzMap (Euclidean 2) ℂ) ≤ A * (Real.sqrt scale) ^ 2) :
    (∀ t, Function.support (angularDyadicCubeResidualSymbol C σ j t direction χ m :
      Euclidean 2 → Complex) ⊆
        frequencyCube (scale • direction) (width * Real.sqrt scale)) ∧
    (∀ z y, ‖angularDyadicCubeSpaceTimeKernel C σ j χ m ϑ z y‖ ≤
      (T * (2 : Real) ^ N * A) *
        lightRayKernel (Real.sqrt scale)⁻¹ N direction y z) := by
  have hδ : 0 < (Real.sqrt scale)⁻¹ :=
    inv_pos.mpr (Real.sqrt_pos.2 hscale)
  have hN' : ∀ t, SchwartzMap.seminorm ℂ N 0
      (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m) :
        SchwartzMap (Euclidean 2) ℂ) ≤
        (A * ((Real.sqrt scale)⁻¹)⁻¹ ^ 2) * (Real.sqrt scale)⁻¹ ^ N := by
    intro t
    simpa only [inv_inv] using hN t
  have hzero' : ∀ t, SchwartzMap.seminorm ℂ 0 0
      (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j t direction χ m) :
        SchwartzMap (Euclidean 2) ℂ) ≤ A * ((Real.sqrt scale)⁻¹)⁻¹ ^ 2 := by
    intro t
    simpa only [inv_inv] using hzero t
  exact angularDyadicCubePacket_ray_localized_of_residual_seminorm
    C σ j χ m ϑ scale width (Real.sqrt scale)⁻¹ A T N direction
    hm hδ hϑ hN' hzero'

/-- The explicit derivative budget contributed by one concrete scaled ray
cube cutoff.  The sum is the literal Leibniz expansion: the base-amplitude
derivative bound `B k` multiplies the exactly scaled `L¹` norm of the
order-`n-k` derivative of the fixed prototype. -/
def scaledRayCubeResidualDerivativeBound
    (prototype : SchwartzMap (Euclidean 2) Complex) (scale width : Real)
    (B : Nat → Real) (n : Nat) : Real :=
  ∑ k ∈ Finset.range (n + 1), (n.choose k : Real) * B k *
    ((width * Real.sqrt scale) ^ 2 *
      ((width * Real.sqrt scale)⁻¹) ^ (n - k) *
      ∫ η : Euclidean 2, ‖iteratedFDeriv Real (n - k) prototype η‖)

/-- Explicit derivative bounds for the actual phase-mismatch base amplitude
give an `L¹` derivative bound for the literal residual symbol with the
concrete scaled ray-cube cutoff.  This is a proved Leibniz estimate, not a
new localization predicate. -/
theorem integral_norm_iteratedFDeriv_angularDyadicCubeResidualSymbol_le_scaledRayCubeCutoff
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (direction : Euclidean 2) (χ prototype : SchwartzMap (Euclidean 2) Complex)
    (scale width : Real) (hradius : 0 < width * Real.sqrt scale)
    (N : Nat) (B : Nat → Real)
    (hbase : ∀ k ≤ N, ∀ ξ : Euclidean 2,
      ‖iteratedFDeriv Real k
        (angularDyadicResidualBaseSymbol C σ j t direction χ) ξ‖ ≤ B k)
    {n : Nat} (hn : n ≤ N) :
    ∫ ξ : Euclidean 2,
      ‖iteratedFDeriv Real n
        (angularDyadicCubeResidualSymbol C σ j t direction χ
          (scaledRayCubeCutoff prototype scale width direction hradius)) ξ‖ ≤
      scaledRayCubeResidualDerivativeBound prototype scale width B n := by
  let m : SchwartzMap (Euclidean 2) Complex :=
    scaledRayCubeCutoff prototype scale width direction hradius
  let base : SchwartzMap (Euclidean 2) Complex :=
    angularDyadicResidualBaseSymbol C σ j t direction χ
  have hfactor :
      (angularDyadicCubeResidualSymbol C σ j t direction χ m :
        Euclidean 2 → Complex) =
        fun ξ => base ξ * m ξ := by
    funext ξ
    exact angularDyadicCubeResidualSymbol_eq_residualBase_mul
      C σ j t direction ξ χ m
  have hresint : Integrable (fun ξ : Euclidean 2 =>
      ‖iteratedFDeriv Real n
        (angularDyadicCubeResidualSymbol C σ j t direction χ m) ξ‖) volume := by
    simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume
      (angularDyadicCubeResidualSymbol C σ j t direction χ m) 0 n
  have hsumint : Integrable (fun ξ : Euclidean 2 =>
      ∑ k ∈ Finset.range (n + 1),
        (n.choose k : Real) * B k * ‖iteratedFDeriv Real (n - k) m ξ‖) volume := by
    apply integrable_finsetSum
    intro k hk
    have hmint : Integrable (fun ξ : Euclidean 2 =>
        ‖iteratedFDeriv Real (n - k) m ξ‖) volume := by
      simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume m 0 (n - k)
    exact hmint.const_mul ((n.choose k : Real) * B k)
  calc
    ∫ ξ : Euclidean 2,
        ‖iteratedFDeriv Real n
          (angularDyadicCubeResidualSymbol C σ j t direction χ m) ξ‖ ≤
        ∫ ξ : Euclidean 2,
          ∑ k ∈ Finset.range (n + 1),
            (n.choose k : Real) * B k * ‖iteratedFDeriv Real (n - k) m ξ‖ := by
      apply integral_mono hresint hsumint
      intro ξ
      rw [hfactor]
      calc
        ‖iteratedFDeriv Real n (fun y => base y * m y) ξ‖ ≤
            ∑ k ∈ Finset.range (n + 1),
              (n.choose k : Real) * ‖iteratedFDeriv Real k base ξ‖ *
                ‖iteratedFDeriv Real (n - k) m ξ‖ :=
          norm_iteratedFDeriv_mul_le (base.smooth (N : ℕ∞))
            (m.smooth (N : ℕ∞)) ξ (by exact_mod_cast hn)
        _ ≤ ∑ k ∈ Finset.range (n + 1),
              (n.choose k : Real) * B k *
                ‖iteratedFDeriv Real (n - k) m ξ‖ := by
          apply Finset.sum_le_sum
          intro k hk
          have hk' : k ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
          have hkN : k ≤ N := le_trans hk' hn
          have hBk : 0 ≤ B k :=
            (norm_nonneg (iteratedFDeriv Real k base 0)).trans (hbase k hkN 0)
          exact mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left (hbase k hkN ξ) (by positivity))
            (norm_nonneg _)
    _ = ∑ k ∈ Finset.range (n + 1),
          (n.choose k : Real) * B k *
            ∫ ξ : Euclidean 2, ‖iteratedFDeriv Real (n - k) m ξ‖ := by
      rw [integral_finsetSum]
      · apply Finset.sum_congr rfl
        intro k hk
        rw [integral_const_mul]
      · intro k hk
        have hmint : Integrable (fun ξ : Euclidean 2 =>
            ‖iteratedFDeriv Real (n - k) m ξ‖) volume := by
          simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume m 0 (n - k)
        exact hmint.const_mul ((n.choose k : Real) * B k)
    _ = scaledRayCubeResidualDerivativeBound prototype scale width B n := by
      unfold scaledRayCubeResidualDerivativeBound
      apply Finset.sum_congr rfl
      intro k hk
      rw [show m = scaledRayCubeCutoff prototype scale width direction hradius by rfl,
        integral_norm_iteratedFDeriv_scaledRayCubeCutoff]

/-- A cutoff-supported version of the residual Leibniz estimate.  A base
derivative is only needed where the paired derivative of the concrete cube
cutoff is nonzero; this is the form compatible with local phase bounds on a
matched ray cube. -/
theorem integral_norm_iteratedFDeriv_angularDyadicCubeResidualSymbol_le_scaledRayCubeCutoff_of_supportBounds
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (direction : Euclidean 2) (χ prototype : SchwartzMap (Euclidean 2) Complex)
    (scale width : Real) (hradius : 0 < width * Real.sqrt scale)
    (N : Nat) (B : Nat → Real)
    (hbase : ∀ k ≤ N, ∀ ℓ ≤ N - k, ∀ ξ : Euclidean 2,
      ξ ∈ Function.support (iteratedFDeriv Real ℓ
        (scaledRayCubeCutoff prototype scale width direction hradius :
          Euclidean 2 → Complex)) →
      ‖iteratedFDeriv Real k
        (angularDyadicResidualBaseSymbol C σ j t direction χ) ξ‖ ≤ B k)
    {n : Nat} (hn : n ≤ N) :
    ∫ ξ : Euclidean 2,
      ‖iteratedFDeriv Real n
        (angularDyadicCubeResidualSymbol C σ j t direction χ
          (scaledRayCubeCutoff prototype scale width direction hradius)) ξ‖ ≤
      scaledRayCubeResidualDerivativeBound prototype scale width B n := by
  let m : SchwartzMap (Euclidean 2) Complex :=
    scaledRayCubeCutoff prototype scale width direction hradius
  let base : SchwartzMap (Euclidean 2) Complex :=
    angularDyadicResidualBaseSymbol C σ j t direction χ
  have hfactor :
      (angularDyadicCubeResidualSymbol C σ j t direction χ m :
        Euclidean 2 → Complex) =
        fun ξ => base ξ * m ξ := by
    funext ξ
    exact angularDyadicCubeResidualSymbol_eq_residualBase_mul
      C σ j t direction ξ χ m
  have hresint : Integrable (fun ξ : Euclidean 2 =>
      ‖iteratedFDeriv Real n
        (angularDyadicCubeResidualSymbol C σ j t direction χ m) ξ‖) volume := by
    simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume
      (angularDyadicCubeResidualSymbol C σ j t direction χ m) 0 n
  have hsumint : Integrable (fun ξ : Euclidean 2 =>
      ∑ k ∈ Finset.range (n + 1),
        (n.choose k : Real) * B k * ‖iteratedFDeriv Real (n - k) m ξ‖) volume := by
    apply integrable_finsetSum
    intro k hk
    have hmint : Integrable (fun ξ : Euclidean 2 =>
        ‖iteratedFDeriv Real (n - k) m ξ‖) volume := by
      simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume m 0 (n - k)
    exact hmint.const_mul ((n.choose k : Real) * B k)
  calc
    ∫ ξ : Euclidean 2,
        ‖iteratedFDeriv Real n
          (angularDyadicCubeResidualSymbol C σ j t direction χ m) ξ‖ ≤
        ∫ ξ : Euclidean 2,
          ∑ k ∈ Finset.range (n + 1),
            (n.choose k : Real) * B k * ‖iteratedFDeriv Real (n - k) m ξ‖ := by
      apply integral_mono hresint hsumint
      intro ξ
      rw [hfactor]
      calc
        ‖iteratedFDeriv Real n (fun y => base y * m y) ξ‖ ≤
            ∑ k ∈ Finset.range (n + 1),
              (n.choose k : Real) * ‖iteratedFDeriv Real k base ξ‖ *
                ‖iteratedFDeriv Real (n - k) m ξ‖ :=
          norm_iteratedFDeriv_mul_le (base.smooth (N : ℕ∞))
            (m.smooth (N : ℕ∞)) ξ (by exact_mod_cast hn)
        _ ≤ ∑ k ∈ Finset.range (n + 1),
              (n.choose k : Real) * B k *
                ‖iteratedFDeriv Real (n - k) m ξ‖ := by
          apply Finset.sum_le_sum
          intro k hk
          have hk' : k ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
          have hkN : k ≤ N := le_trans hk' hn
          by_cases hzero : iteratedFDeriv Real (n - k) m ξ = 0
          · simp [hzero]
          · have hsupport : ξ ∈ Function.support
                (iteratedFDeriv Real (n - k) m) := hzero
            have hlocal : ‖iteratedFDeriv Real k base ξ‖ ≤ B k :=
              hbase k hkN (n - k) (Nat.sub_le_sub_right hn k) ξ hsupport
            exact mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_left hlocal (by positivity))
              (norm_nonneg _)
    _ = ∑ k ∈ Finset.range (n + 1),
          (n.choose k : Real) * B k *
            ∫ ξ : Euclidean 2, ‖iteratedFDeriv Real (n - k) m ξ‖ := by
      rw [integral_finsetSum]
      · apply Finset.sum_congr rfl
        intro k hk
        rw [integral_const_mul]
      · intro k hk
        have hmint : Integrable (fun ξ : Euclidean 2 =>
            ‖iteratedFDeriv Real (n - k) m ξ‖) volume := by
          simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume m 0 (n - k)
        exact hmint.const_mul ((n.choose k : Real) * B k)
    _ = scaledRayCubeResidualDerivativeBound prototype scale width B n := by
      unfold scaledRayCubeResidualDerivativeBound
      apply Finset.sum_congr rfl
      intro k hk
      rw [show m = scaledRayCubeCutoff prototype scale width direction hradius by rfl,
        integral_norm_iteratedFDeriv_scaledRayCubeCutoff]

/-- The literal first-order residual derivative budget for a matched
plus-sheet scaled ray cube. -/
noncomputable def scaledRayCubePlusResidualFirstDerivativeBound
    (C : lpCutoffs 2) (j : Nat) (χ : SchwartzMap (Euclidean 2) Complex)
    (T scale width : Real) : Nat → Real := fun k =>
  if k = 0 then
    SchwartzMap.seminorm Real 0 0 (angularDyadicResidualAmplitude C j χ)
  else if k = 1 then
    SchwartzMap.seminorm Real 0 1 (angularDyadicResidualAmplitude C j χ) +
      (8 * Real.pi * T * (width * Real.sqrt scale) / scale) *
        SchwartzMap.seminorm Real 0 0 (angularDyadicResidualAmplitude C j χ)
  else 0

/-- The actual plus-sheet residual symbol has a concrete derivative-integral
bound through order one on a matched scaled ray cube.  No global
phase-mismatch derivative hypothesis is used. -/
theorem integral_norm_iteratedFDeriv_angularDyadicCubeResidualSymbol_plus_le_scaledRayCubeCutoff_firstOrder
    (C : lpCutoffs 2) (j : Nat) (T t scale width : Real)
    (direction : Euclidean 2) (χ prototype : SchwartzMap (Euclidean 2) Complex)
    (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (hT : 0 ≤ T) (ht : |t| ≤ T)
    {n : Nat} (hn : n ≤ 1) :
    ∫ ξ : Euclidean 2,
      ‖iteratedFDeriv Real n
        (angularDyadicCubeResidualSymbol C WaveSign.plus j t direction χ
          (scaledRayCubeCutoff prototype scale width direction hradius)) ξ‖ ≤
      scaledRayCubeResidualDerivativeBound prototype scale width
        (scaledRayCubePlusResidualFirstDerivativeBound C j χ T scale width) n := by
  apply integral_norm_iteratedFDeriv_angularDyadicCubeResidualSymbol_le_scaledRayCubeCutoff_of_supportBounds
    C WaveSign.plus j t direction χ prototype scale width hradius 1
    (scaledRayCubePlusResidualFirstDerivativeBound C j χ T scale width) ?_ hn
  intro k hk ℓ hℓ ξ hξ
  have hbound := norm_iteratedFDeriv_angularDyadicResidualBaseSymbol_plus_zero_one_on_scaledRayCubeCutoff
    C j T t scale width direction χ prototype hradius hprototype hscale hunit hsmall
    hT ht ℓ hξ
  interval_cases k
  · simpa [scaledRayCubePlusResidualFirstDerivativeBound] using hbound.1
  · simpa [scaledRayCubePlusResidualFirstDerivativeBound] using hbound.2

private theorem norm_angularDyadicCubeSpaceTimeKernel_le_lightRayKernel_of_residual_seminorm_at_time
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ m : SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (δ A T : Real) (N : Nat) (direction : Euclidean 2)
    (hδ : 0 < δ) (z : WaveSpaceTime) (y : Euclidean 2)
    (hϑ : ‖ϑ z.2‖ ≤ T)
    (hN : SchwartzMap.seminorm Complex N 0
      (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m) :
        SchwartzMap (Euclidean 2) Complex) ≤
      (A * (δ⁻¹) ^ 2) * δ ^ N)
    (hzero : SchwartzMap.seminorm Complex 0 0
      (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m) :
        SchwartzMap (Euclidean 2) Complex) ≤ A * (δ⁻¹) ^ 2) :
    ‖angularDyadicCubeSpaceTimeKernel C σ j χ m ϑ z y‖ ≤
      (T * (2 : Real) ^ N * A) * lightRayKernel δ N direction y z := by
  have hT : 0 ≤ T := (norm_nonneg (ϑ z.2)).trans hϑ
  have hdecay := SmoothDyadicPhysicalCore.norm_fourierCubeKernel_le_scaled_seminorm_decay
    (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m)
    δ (A * (δ⁻¹) ^ 2) N hδ hzero hN
    (z.1 + z.2 • direction - y)
  have htranslate : (z.1 - y) + z.2 • direction =
      z.1 + z.2 • direction - y := by
    module
  calc
    ‖angularDyadicCubeSpaceTimeKernel C σ j χ m ϑ z y‖ =
        ‖ϑ z.2‖ * ‖angularDyadicCubeKernel C σ j z.2 χ m (z.1 - y)‖ := by
      rw [angularDyadicCubeSpaceTimeKernel, norm_mul]
    _ = ‖ϑ z.2‖ * ‖SmoothDyadicPhysicalCore.fourierCubeKernel
          (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m)
          (z.1 + z.2 • direction - y)‖ := by
      rw [angularDyadicCubeKernel_eq_residual_shifted, htranslate]
    _ ≤ T * ‖SmoothDyadicPhysicalCore.fourierCubeKernel
          (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m)
          (z.1 + z.2 • direction - y)‖ :=
      mul_le_mul_of_nonneg_right hϑ (norm_nonneg _)
    _ ≤ T * ((2 : Real) ^ N * (A * (δ⁻¹) ^ 2) *
          (1 + δ⁻¹ * ‖z.1 + z.2 • direction - y‖)⁻¹ ^ N) :=
      mul_le_mul_of_nonneg_left hdecay hT
    _ = (T * (2 : Real) ^ N * A) * lightRayKernel δ N direction y z := by
      unfold lightRayKernel
      ring

/-- A compactly time-supported cutoff permits the concrete residual
derivative calculation to be used only on its support.  The hypotheses give
uniform derivative bounds for the *explicit* phase-mismatch amplitude on the
time slab and the resulting finite scaled-cutoff budgets.  No bound for the
unbounded-time phase is asserted. -/
theorem scaledRayCubeCutoff_ray_localized_of_residualBaseBounds_on_compactTimeSupport
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (χ prototype : SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (scale width δ A T t₀ t₁ : Real) (N : Nat) (direction : Euclidean 2)
    (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      frequencyCube 0 1)
    (hδ : 0 < δ) (hA : 0 ≤ A) (hϑ : ∀ t, ‖ϑ t‖ ≤ T)
    (hϑ_support : ∀ t, ϑ t ≠ 0 → t ∈ Icc t₀ t₁)
    (B : Nat → Real)
    (hbase : ∀ t ∈ Icc t₀ t₁, ∀ k ≤ N, ∀ ℓ ≤ N - k, ∀ ξ : Euclidean 2,
      ξ ∈ Function.support (iteratedFDeriv Real ℓ
        (scaledRayCubeCutoff prototype scale width direction hradius :
          Euclidean 2 → Complex)) →
      ‖iteratedFDeriv Real k
        (angularDyadicResidualBaseSymbol C σ j t direction χ) ξ‖ ≤ B k)
    (hbudgetN : (2 : Real) ^ N *
      (∑ n ∈ Finset.range (N + 1),
        scaledRayCubeResidualDerivativeBound prototype scale width B n) ≤
        (A * (δ⁻¹) ^ 2) * δ ^ N)
    (hbudget0 : scaledRayCubeResidualDerivativeBound prototype scale width B 0 ≤
      A * (δ⁻¹) ^ 2) :
    (∀ t, Function.support
      (angularDyadicCubeResidualSymbol C σ j t direction χ
        (scaledRayCubeCutoff prototype scale width direction hradius) :
        Euclidean 2 → Complex) ⊆
        frequencyCube (scale • direction) (width * Real.sqrt scale)) ∧
    (∀ z y, ‖angularDyadicCubeSpaceTimeKernel C σ j χ
      (scaledRayCubeCutoff prototype scale width direction hradius) ϑ z y‖ ≤
      (T * (2 : Real) ^ N * A) * lightRayKernel δ N direction y z) := by
  let m : SchwartzMap (Euclidean 2) Complex :=
    scaledRayCubeCutoff prototype scale width direction hradius
  have hm : isScaledRayCubeCutoff scale width direction m := by
    exact isScaledRayCubeCutoff_scaledRayCubeCutoff prototype scale width direction
      hradius hprototype
  refine ⟨?_, ?_⟩
  · intro t
    exact support_angularDyadicCubeResidualSymbol_subset_frequencyCube
      C σ j t scale width direction χ m hm
  · intro z y
    by_cases hϑ_zero : ϑ z.2 = 0
    · have hT : 0 ≤ T := (norm_nonneg (ϑ z.2)).trans (hϑ z.2)
      have hlight : 0 ≤ lightRayKernel δ N direction y z := by
        unfold lightRayKernel
        positivity
      calc
        ‖angularDyadicCubeSpaceTimeKernel C σ j χ m ϑ z y‖ = 0 := by
          simp [angularDyadicCubeSpaceTimeKernel, hϑ_zero]
        _ ≤ (T * (2 : Real) ^ N * A) * lightRayKernel δ N direction y z :=
          mul_nonneg
            (mul_nonneg (mul_nonneg hT (by positivity)) hA)
            hlight
    · have htime : z.2 ∈ Icc t₀ t₁ := hϑ_support z.2 hϑ_zero
      have hsum :
          (2 : Real) ^ N *
            (∑ n ∈ Finset.range (N + 1), ∫ ξ : Euclidean 2,
              ‖iteratedFDeriv Real n
                (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m) ξ‖) ≤
          (2 : Real) ^ N *
            (∑ n ∈ Finset.range (N + 1),
              scaledRayCubeResidualDerivativeBound prototype scale width B n) := by
        apply mul_le_mul_of_nonneg_left
        · apply Finset.sum_le_sum
          intro n hn
          exact integral_norm_iteratedFDeriv_angularDyadicCubeResidualSymbol_le_scaledRayCubeCutoff_of_supportBounds
            C σ j z.2 direction χ prototype scale width hradius N B
            (fun k hk ℓ hℓ ξ hξ => hbase z.2 htime k hk ℓ hℓ ξ hξ)
            (Nat.lt_succ_iff.mp (Finset.mem_range.mp hn))
        · positivity
      have hderivN :
          (2 : Real) ^ N *
            (∑ n ∈ Finset.range (N + 1), ∫ ξ : Euclidean 2,
              ‖iteratedFDeriv Real n
                (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m) ξ‖) ≤
            (A * (δ⁻¹) ^ 2) * δ ^ N :=
        hsum.trans hbudgetN
      have hderiv0 :
          ∫ ξ : Euclidean 2,
            ‖angularDyadicCubeResidualSymbol C σ j z.2 direction χ m ξ‖ ≤
              A * (δ⁻¹) ^ 2 := by
        calc
          ∫ ξ : Euclidean 2,
              ‖angularDyadicCubeResidualSymbol C σ j z.2 direction χ m ξ‖ =
            ∫ ξ : Euclidean 2,
              ‖iteratedFDeriv Real 0
                (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m) ξ‖ := by
              simp
          _ ≤ scaledRayCubeResidualDerivativeBound prototype scale width B 0 :=
            integral_norm_iteratedFDeriv_angularDyadicCubeResidualSymbol_le_scaledRayCubeCutoff_of_supportBounds
              C σ j z.2 direction χ prototype scale width hradius N B
              (fun k hk ℓ hℓ ξ hξ => hbase z.2 htime k hk ℓ hℓ ξ hξ)
              (Nat.zero_le _)
          _ ≤ A * (δ⁻¹) ^ 2 := hbudget0
      have hseminormN : SchwartzMap.seminorm Complex N 0
          (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m) :
            SchwartzMap (Euclidean 2) Complex) ≤
          (A * (δ⁻¹) ^ 2) * δ ^ N :=
        (angularDyadicCubeResidualSymbol_fourierInv_seminorm_le_derivativeIntegrals
          C σ j z.2 direction χ m N).trans hderivN
      have hseminorm0 : SchwartzMap.seminorm Complex 0 0
          (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m) :
            SchwartzMap (Euclidean 2) Complex) ≤ A * (δ⁻¹) ^ 2 := by
        calc
          SchwartzMap.seminorm Complex 0 0
              (𝓕⁻ (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m) :
                SchwartzMap (Euclidean 2) Complex) ≤
              (2 : Real) ^ 0 *
                ∑ n ∈ Finset.range (0 + 1), ∫ ξ : Euclidean 2,
                  ‖iteratedFDeriv Real n
                    (angularDyadicCubeResidualSymbol C σ j z.2 direction χ m) ξ‖ :=
            angularDyadicCubeResidualSymbol_fourierInv_seminorm_le_derivativeIntegrals
              C σ j z.2 direction χ m 0
          _ = ∫ ξ : Euclidean 2,
              ‖angularDyadicCubeResidualSymbol C σ j z.2 direction χ m ξ‖ := by
              simp
          _ ≤ A * (δ⁻¹) ^ 2 := hderiv0
      exact norm_angularDyadicCubeSpaceTimeKernel_le_lightRayKernel_of_residual_seminorm_at_time
        C σ j χ m ϑ δ A T N direction hδ z y
        (hϑ z.2) hseminormN hseminorm0

/-- The compact-time ray-localization bridge with the literal matched
plus-sheet first-order residual budget.  The only remaining numerical inputs
are the displayed finite budgets; no global residual derivative hypothesis is
assumed.  Its decay order is one, so higher-order radial phase calculus is
still required before using it for an integrable high-decay light-ray kernel. -/
theorem scaledRayCubeCutoff_ray_localized_of_concretePlusFirstDerivativeBounds_on_compactTimeSupport
    (C : lpCutoffs 2) (j : Nat)
    (χ prototype : SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (scale width δ A T t₀ t₁ : Real) (direction : Euclidean 2)
    (hradius : 0 < width * Real.sqrt scale)
    (hprototype_cube : Function.support (prototype : Euclidean 2 → Complex) ⊆
      frequencyCube 0 1)
    (hprototype_ball : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (hδ : 0 < δ) (hA : 0 ≤ A) (hT : 0 ≤ T)
    (hϑ : ∀ t, ‖ϑ t‖ ≤ T)
    (hϑ_support : ∀ t, ϑ t ≠ 0 → t ∈ Icc t₀ t₁)
    (hslab : ∀ t ∈ Icc t₀ t₁, |t| ≤ T)
    (hbudgetN : (2 : Real) ^ 1 *
      (∑ n ∈ Finset.range (1 + 1),
        scaledRayCubeResidualDerivativeBound prototype scale width
          (scaledRayCubePlusResidualFirstDerivativeBound C j χ T scale width) n) ≤
        (A * (δ⁻¹) ^ 2) * δ ^ 1)
    (hbudget0 : scaledRayCubeResidualDerivativeBound prototype scale width
      (scaledRayCubePlusResidualFirstDerivativeBound C j χ T scale width) 0 ≤
        A * (δ⁻¹) ^ 2) :
    (∀ t, Function.support
      (angularDyadicCubeResidualSymbol C WaveSign.plus j t direction χ
        (scaledRayCubeCutoff prototype scale width direction hradius) :
        Euclidean 2 → Complex) ⊆
        frequencyCube (scale • direction) (width * Real.sqrt scale)) ∧
    (∀ z y, ‖angularDyadicCubeSpaceTimeKernel C WaveSign.plus j χ
      (scaledRayCubeCutoff prototype scale width direction hradius) ϑ z y‖ ≤
      (T * (2 : Real) ^ 1 * A) * lightRayKernel δ 1 direction y z) := by
  apply scaledRayCubeCutoff_ray_localized_of_residualBaseBounds_on_compactTimeSupport
    C WaveSign.plus j χ prototype ϑ scale width δ A T t₀ t₁ 1 direction
    hradius hprototype_cube hδ hA hϑ hϑ_support
    (scaledRayCubePlusResidualFirstDerivativeBound C j χ T scale width)
  · intro t ht k hk ℓ hℓ ξ hξ
    have hbound := norm_iteratedFDeriv_angularDyadicResidualBaseSymbol_plus_zero_one_on_scaledRayCubeCutoff
      C j T t scale width direction χ prototype hradius hprototype_ball hscale hunit hsmall
      hT (hslab t ht) ℓ hξ
    interval_cases k
    · simpa [scaledRayCubePlusResidualFirstDerivativeBound] using hbound.1
    · simpa [scaledRayCubePlusResidualFirstDerivativeBound] using hbound.2
  · exact hbudgetN
  · exact hbudget0

/-!
### Literal high-order matched-ray packet bounds

The following finite-order calculation combines the all-order radial
phase-mismatch bounds above with the literal residual amplitude and the
existing scaled-cutoff Leibniz bridge.  Its final packet coefficient is
deliberately displayed with its dependence on the cutoff radius; the current
cutoff/amplitude hypotheses do not normalize that dependence uniformly in the
ray scale.
-/

private noncomputable def realMulI : Real →ₗᵢ[Real] Complex where
  toLinearMap := (Complex.ofRealCLM.smulRight Complex.I).toLinearMap
  norm_map' := by
    intro r
    simp

private lemma norm_iteratedFDeriv_exp_ofReal_mul_I_le_two
    (n : Nat) (r : Real) :
    ‖iteratedFDeriv Real n
      (fun s : Real => Complex.exp (((s : Complex) * Complex.I))) r‖ ≤ 2 := by
  let c : Real → Complex := fun s => (Real.cos s : Complex)
  let s : Real → Complex := fun q => (Real.sin q : Complex) * Complex.I
  have hcos : ContDiff Real (n : ℕ∞) Real.cos := Real.contDiff_cos
  have hsin : ContDiff Real (n : ℕ∞) Real.sin := Real.contDiff_sin
  have hfun : (fun q : Real => Complex.exp (((q : Complex) * Complex.I))) = c + s := by
    funext q
    simp [c, s, Complex.exp_mul_I]
  have hc : c = Complex.ofRealLI ∘ Real.cos := by rfl
  have hs : s = realMulI ∘ Real.sin := by rfl
  rw [hfun, hc, hs]
  rw [iteratedFDeriv_add (Complex.ofRealLI.contDiff.comp hcos)
    (realMulI.contDiff.comp hsin)]
  calc
      ‖iteratedFDeriv Real n c r + iteratedFDeriv Real n s r‖ ≤
          ‖iteratedFDeriv Real n c r‖ + ‖iteratedFDeriv Real n s r‖ := norm_add_le _ _
      _ ≤ 1 + 1 := by
        apply add_le_add
        · rw [hc, Complex.ofRealLI.norm_iteratedFDeriv_comp_left]
          · rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv]
            simpa [Real.norm_eq_abs] using Real.abs_iteratedDeriv_cos_le_one n r
          · exact hcos.contDiffAt
          · exact_mod_cast le_rfl
        · rw [hs, realMulI.norm_iteratedFDeriv_comp_left]
          · rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv]
            simpa [Real.norm_eq_abs] using Real.abs_iteratedDeriv_sin_le_one n r
          · exact hsin.contDiffAt
          · exact_mod_cast le_rfl
      _ = 2 := by norm_num

private lemma norm_iteratedFDeriv_comp_le_on_open
    {E F G : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    [NormedAddCommGroup F] [NormedSpace Real F]
    [NormedAddCommGroup G] [NormedSpace Real G]
    (s : Set E) (hs : IsOpen s) (f : E → F) (g : F → G)
    (N n : Nat) (hf : ContDiffOn Real (N : ℕ∞) f s)
    (hg : ContDiff Real (N : ℕ∞) g) {x : E} (hx : x ∈ s)
    (hnN : n ≤ N)
    {C D : Real}
    (hC : ∀ i, i ≤ n → ‖iteratedFDeriv Real i g (f x)‖ ≤ C)
    (hD : ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDeriv Real i f x‖ ≤ D ^ i) :
    ‖iteratedFDeriv Real n (g ∘ f) x‖ ≤ (n.factorial : Real) * C * D ^ n := by
  have hn : (n : WithTop ℕ∞) ≤ (↑(N : ℕ∞) : WithTop ℕ∞) := by
    exact_mod_cast hnN
  have hcomp := norm_iteratedFDerivWithin_comp_le
    (s := s) (t := Set.univ) (n := n) (N := (N : ℕ∞))
    hg.contDiffOn hf
    hn
    uniqueDiffOn_univ hs.uniqueDiffOn (by simp) hx
    (C := C) (D := D)
    (by
      intro i hi
      simpa only [iteratedFDerivWithin_univ] using hC i hi)
    (by
      intro i hi1 hin
      rw [iteratedFDerivWithin_of_isOpen i hs hx]
      exact hD i hi1 hin)
  rw [iteratedFDerivWithin_of_isOpen n hs hx] at hcomp
  exact hcomp

private noncomputable def timeAngularDyadicRayPhaseMismatchPlus
    (t : Real) (direction : Euclidean 2) : Euclidean 2 → Real := fun ξ =>
  (2 * Real.pi * t) • angularDyadicRayPhaseMismatch WaveSign.plus direction ξ

private lemma timeAngularDyadicRayPhaseMismatchPlus_contDiffOn
    (N : Nat) (t : Real) (direction : Euclidean 2) :
    ContDiffOn Real (N : ℕ∞) (timeAngularDyadicRayPhaseMismatchPlus t direction)
      {ξ : Euclidean 2 | ξ ≠ 0} := by
  intro ξ hξ
  have hnorm : ContDiffAt Real (N : ℕ∞) (fun η : Euclidean 2 => ‖η‖) ξ :=
    contDiffAt_norm Real hξ
  have hinner : ContDiffAt Real (N : ℕ∞)
      (innerSL Real direction : Euclidean 2 → Real) ξ :=
    (innerSL Real direction).contDiff.contDiffAt
  have hphasefun : timeAngularDyadicRayPhaseMismatchPlus t direction =
      fun η : Euclidean 2 => (2 * Real.pi * t) * (‖η‖ - inner Real direction η) := by
    funext η
    simp [timeAngularDyadicRayPhaseMismatchPlus, angularDyadicRayPhaseMismatch,
      WaveSign.toReal, smul_eq_mul]
  rw [hphasefun]
  exact ((hnorm.sub hinner).const_smul (2 * Real.pi * t)).contDiffWithinAt
    (s := {η : Euclidean 2 | η ≠ 0})

private lemma norm_iteratedFDeriv_timeAngularDyadicRayPhaseMismatchPlusExp_le
    (N n : Nat) (t : Real) (direction : Euclidean 2) {ξ : Euclidean 2}
    (hξ : ξ ≠ 0) (hn : n ≤ N) {D : Real}
    (hD : ∀ i, 1 ≤ i → i ≤ n →
      ‖iteratedFDeriv Real i (timeAngularDyadicRayPhaseMismatchPlus t direction) ξ‖ ≤ D ^ i) :
    ‖iteratedFDeriv Real n
      (fun η : Euclidean 2 => Complex.exp
        (((timeAngularDyadicRayPhaseMismatchPlus t direction η : Real) : Complex) * Complex.I)) ξ‖ ≤
      (n.factorial : Real) * 2 * D ^ n := by
  let e : Real → Complex := fun r => Complex.exp (((r : Complex) * Complex.I))
  have he : ContDiff Real (N : ℕ∞) e := by
    let L : Real →L[Real] Complex := Complex.ofRealCLM.smulRight Complex.I
    change ContDiff Real (N : ℕ∞) (fun r => Complex.exp (L r))
    exact Complex.contDiff_exp.comp L.contDiff
  have hsopen : IsOpen {η : Euclidean 2 | η ≠ 0} := by
    simpa using (isOpen_ne : IsOpen {η : Euclidean 2 | η ≠ 0})
  have hcomp := norm_iteratedFDeriv_comp_le_on_open
    {η : Euclidean 2 | η ≠ 0} hsopen
    (timeAngularDyadicRayPhaseMismatchPlus t direction) e N n
    (timeAngularDyadicRayPhaseMismatchPlus_contDiffOn N t direction) he hξ hn
    (C := 2) (D := D)
    (fun i hi => norm_iteratedFDeriv_exp_ofReal_mul_I_le_two i
      (timeAngularDyadicRayPhaseMismatchPlus t direction ξ)) hD
  change ‖iteratedFDeriv Real n (e ∘ timeAngularDyadicRayPhaseMismatchPlus t direction) ξ‖ ≤ _
  exact hcomp

private lemma norm_iteratedFDeriv_timeAngularDyadicRayPhaseMismatchPlus_high_le
    (A : Nat → Real)
    (hA : ∀ m : Nat, 0 ≤ A m ∧ ∀
      (prototype : SchwartzMap (Euclidean 2) Complex) (scale width : Real)
      (direction : Euclidean 2) (hradius : 0 < width * Real.sqrt scale),
      Function.support (prototype : Euclidean 2 → Complex) ⊆ Metric.closedBall 0 1 →
      0 < scale → ‖direction‖ = 1 → 2 * (width * Real.sqrt scale) ≤ scale →
      ∀ (k : Nat) {ξ : Euclidean 2}, ξ ∈ Function.support (iteratedFDeriv Real k
        (scaledRayCubeCutoff prototype scale width direction hradius :
          Euclidean 2 → Complex)) →
        scale ^ ((m + 2) - 1) * ‖iteratedFDeriv Real (m + 2)
          (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ‖ ≤ A m)
    (prototype : SchwartzMap (Euclidean 2) Complex) (scale width T t : Real)
    (direction : Euclidean 2) (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (hT : 0 ≤ T) (ht : |t| ≤ T)
    (m k : Nat) {ξ : Euclidean 2}
    (hξ : ξ ∈ Function.support (iteratedFDeriv Real k
      (scaledRayCubeCutoff prototype scale width direction hradius :
        Euclidean 2 → Complex))) :
    ‖iteratedFDeriv Real (m + 2) (timeAngularDyadicRayPhaseMismatchPlus t direction) ξ‖ ≤
      (2 * Real.pi * T) * A m * (scale ^ (m + 1))⁻¹ := by
  have hphase := (hA m).2 prototype scale width direction hradius hprototype hscale hunit hsmall k hξ
  have hpow : 0 < scale ^ (m + 1) := pow_pos hscale _
  have hmis : ‖iteratedFDeriv Real (m + 2)
      (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ‖ ≤
      A m * (scale ^ (m + 1))⁻¹ := by
    have hrewrite : (m + 2) - 1 = m + 1 := by omega
    rw [hrewrite] at hphase
    have hdiv : ‖iteratedFDeriv Real (m + 2)
        (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ‖ ≤
        A m / scale ^ (m + 1) := by
      apply (le_div_iff₀ hpow).mpr
      simpa [mul_comm] using hphase
    simpa only [div_eq_mul_inv] using hdiv
  have htime : |2 * Real.pi * t| ≤ 2 * Real.pi * T := by
    rw [abs_mul, abs_mul, abs_of_nonneg (by positivity : 0 ≤ (2 : Real)),
      abs_of_nonneg Real.pi_pos.le]
    exact mul_le_mul_of_nonneg_left ht (by positivity)
  have hmisdiff : ContDiffAt Real (m + 2 : ℕ∞)
      (angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ := by
    unfold angularDyadicRayPhaseMismatch
    simp only [WaveSign.toReal, one_mul]
    exact (contDiffAt_norm Real (by
      intro hzero
      have hball := support_iteratedFDeriv_scaledRayCubeCutoff_subset_closedBall
        prototype scale width direction hradius hprototype k hξ
      subst ξ
      rw [Metric.mem_closedBall, dist_eq_norm] at hball
      have hcenter : ‖scale • direction‖ = scale := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos hscale, hunit, mul_one]
      have hscalele : scale ≤ width * Real.sqrt scale := by
        simpa only [norm_sub_rev, sub_zero, hcenter] using hball
      nlinarith)).sub ((innerSL Real direction).contDiff.contDiffAt)
  change ‖iteratedFDeriv Real (m + 2)
    ((2 * Real.pi * t) • angularDyadicRayPhaseMismatch WaveSign.plus direction) ξ‖ ≤ _
  rw [iteratedFDeriv_const_smul_apply (a := 2 * Real.pi * t) hmisdiff]
  rw [norm_smul]
  exact (mul_le_mul htime hmis (norm_nonneg _) (by positivity)).trans_eq (by ring)

private lemma norm_iteratedFDeriv_timeAngularDyadicRayPhaseMismatchPlus_one_le
    (prototype : SchwartzMap (Euclidean 2) Complex) (scale width T t : Real)
    (direction : Euclidean 2) (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (hT : 0 ≤ T) (ht : |t| ≤ T)
    (k : Nat) {ξ : Euclidean 2}
    (hξ : ξ ∈ Function.support (iteratedFDeriv Real k
      (scaledRayCubeCutoff prototype scale width direction hradius :
        Euclidean 2 → Complex))) :
    ‖iteratedFDeriv Real 1 (timeAngularDyadicRayPhaseMismatchPlus t direction) ξ‖ ≤
      8 * Real.pi * T * (width * Real.sqrt scale) / scale := by
  have h := norm_iteratedFDeriv_time_angularDyadicRayPhaseMismatch_plus_zero_one_on_scaledRayCubeCutoff
    prototype scale width direction hradius hprototype hscale hunit hsmall T t hT ht k hξ
  change ‖iteratedFDeriv Real 1
    (fun η : Euclidean 2 => (2 * Real.pi * t) •
      angularDyadicRayPhaseMismatch WaveSign.plus direction η) ξ‖ ≤ _
  simpa only [norm_iteratedFDeriv_one] using h.2

private theorem exists_scaleControlled_timeAngularDyadicRayPhaseMismatchPlusDerivativePowerBound
    (N : Nat) (prototype : SchwartzMap (Euclidean 2) Complex)
    (scale width T : Real) (direction : Euclidean 2)
    (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (hT : 0 ≤ T) :
    ∃ D : Real, 1 ≤ D ∧ ∀ (t : Real), |t| ≤ T → ∀ (i k : Nat),
      1 ≤ i → i ≤ N → ∀ {ξ : Euclidean 2},
      ξ ∈ Function.support (iteratedFDeriv Real k
        (scaledRayCubeCutoff prototype scale width direction hradius :
          Euclidean 2 → Complex)) →
      ‖iteratedFDeriv Real i (timeAngularDyadicRayPhaseMismatchPlus t direction) ξ‖ ≤ D ^ i := by
  choose A hA0 hA using fun m : Nat =>
    exists_scaledRayCubeCutoff_plusMismatch_higherDerivativeBound (m + 2) (by omega)
  let d₁ : Real := 8 * Real.pi * T * (width * Real.sqrt scale) / scale
  let dHigh : Nat → Real := fun m =>
    (2 * Real.pi * T) * A m * (scale ^ (m + 1))⁻¹
  let D : Real := 1 + d₁ + ∑ m ∈ Finset.range (N + 1), dHigh m
  have hd₁0 : 0 ≤ d₁ := by
    dsimp [d₁]
    positivity
  have hdHigh0 : ∀ m : Nat, 0 ≤ dHigh m := by
    intro m
    dsimp [dHigh]
    exact mul_nonneg (mul_nonneg (mul_nonneg (by positivity) hT) (hA0 m))
      (inv_nonneg.mpr (pow_nonneg hscale.le _))
  have hsum0 : 0 ≤ ∑ m ∈ Finset.range (N + 1), dHigh m := by
    exact Finset.sum_nonneg fun m hm => hdHigh0 m
  have hD1 : 1 ≤ D := by
    dsimp [D]
    linarith
  refine ⟨D, hD1, ?_⟩
  intro t ht i k hi1 hiN ξ hξ
  have hDpow : D ≤ D ^ i := le_self_pow₀ hD1 (Nat.ne_of_gt hi1)
  by_cases hi_eq : i = 1
  · subst i
    have hphase := norm_iteratedFDeriv_timeAngularDyadicRayPhaseMismatchPlus_one_le
      prototype scale width T t direction hradius hprototype hscale hunit hsmall hT ht k hξ
    have hd₁le : d₁ ≤ D := by
      dsimp [D]
      linarith
    simpa only [pow_one] using hphase.trans (hd₁le.trans hDpow)
  · have hi2 : 2 ≤ i := by omega
    let m : Nat := i - 2
    have him : m + 2 = i := by
      dsimp [m]
      omega
    have hmrange : m ∈ Finset.range (N + 1) := by
      apply Finset.mem_range.mpr
      dsimp [m]
      omega
    have hphase := norm_iteratedFDeriv_timeAngularDyadicRayPhaseMismatchPlus_high_le
      A (fun m => ⟨hA0 m, hA m⟩) prototype scale width T t direction hradius hprototype
      hscale hunit hsmall hT ht m k hξ
    rw [him] at hphase
    have hdHighle : dHigh m ≤ D := by
      have hterm : dHigh m ≤ ∑ q ∈ Finset.range (N + 1), dHigh q := by
        exact Finset.single_le_sum (fun q hq => hdHigh0 q) hmrange
      dsimp [D]
      linarith
    exact hphase.trans (hdHighle.trans hDpow)

private lemma norm_iteratedFDeriv_mul_le_on_open
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    (s : Set E) (hs : IsOpen s) (f g : E → Complex)
    (N n : Nat) (hf : ContDiffOn Real (N : ℕ∞) f s)
    (hg : ContDiffOn Real (N : ℕ∞) g s) {x : E} (hx : x ∈ s)
    (hn : n ≤ N) :
    ‖iteratedFDeriv Real n (fun y => f y * g y) x‖ ≤
      ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) *
        ‖iteratedFDeriv Real i f x‖ * ‖iteratedFDeriv Real (n - i) g x‖ := by
  have hn' : (n : WithTop ℕ∞) ≤ (↑(N : ℕ∞) : WithTop ℕ∞) := by
    exact_mod_cast hn
  have h := norm_iteratedFDerivWithin_mul_le hf hg hs.uniqueDiffOn hx hn'
  rw [iteratedFDerivWithin_of_isOpen n hs hx] at h
  calc
    ‖iteratedFDeriv Real n (fun y => f y * g y) x‖ ≤
        ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) *
          ‖iteratedFDerivWithin Real i f s x‖ *
            ‖iteratedFDerivWithin Real (n - i) g s x‖ := h
    _ = ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) *
          ‖iteratedFDeriv Real i f x‖ * ‖iteratedFDeriv Real (n - i) g x‖ := by
      apply Finset.sum_congr rfl
      intro i hi
      rw [iteratedFDerivWithin_of_isOpen i hs hx,
        iteratedFDerivWithin_of_isOpen (n - i) hs hx]

/-- The literal finite-order base-amplitude budget for the matched plus ray. -/
noncomputable def scaledRayCubePlusResidualBaseDerivativeBound
    (C : lpCutoffs 2) (j : Nat) (χ : SchwartzMap (Euclidean 2) Complex)
    (D : Real) : Nat → Real := fun n =>
  ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) *
    ((i.factorial : Real) * 2 * D ^ i) *
      SchwartzMap.seminorm Real 0 (n - i) (angularDyadicResidualAmplitude C j χ)

/-- The all-order radial phase calculus gives explicit finite-order bounds for
the literal plus-sheet residual base amplitude on every derivative support of
a matched scaled ray cube. -/
theorem exists_scaledRayCubeCutoff_plusResidualBaseDerivativeBounds
    (C : lpCutoffs 2) (j N : Nat) (χ prototype : SchwartzMap (Euclidean 2) Complex)
    (scale width T : Real) (direction : Euclidean 2)
    (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (hT : 0 ≤ T) :
    ∃ (D : Real) (B : Nat → Real), 1 ≤ D ∧ (∀ n, 0 ≤ B n) ∧
      ∀ (t : Real), |t| ≤ T → ∀ (n k : Nat), n ≤ N → ∀ {ξ : Euclidean 2},
        ξ ∈ Function.support (iteratedFDeriv Real k
          (scaledRayCubeCutoff prototype scale width direction hradius :
            Euclidean 2 → Complex)) →
        ‖iteratedFDeriv Real n
          (angularDyadicResidualBaseSymbol C WaveSign.plus j t direction χ) ξ‖ ≤ B n := by
  obtain ⟨D, hD1, hD⟩ :=
    exists_scaleControlled_timeAngularDyadicRayPhaseMismatchPlusDerivativePowerBound
      N prototype scale width T direction hradius hprototype hscale hunit hsmall hT
  let B : Nat → Real := scaledRayCubePlusResidualBaseDerivativeBound C j χ D
  have hD0 : 0 ≤ D := le_trans zero_le_one hD1
  have hB0 : ∀ n, 0 ≤ B n := by
    intro n
    dsimp [B, scaledRayCubePlusResidualBaseDerivativeBound]
    apply Finset.sum_nonneg
    intro i hi
    have hfactor : 0 ≤ (i.factorial : Real) * 2 * D ^ i := by positivity
    have hsemi : 0 ≤ SchwartzMap.seminorm Real 0 (n - i) (angularDyadicResidualAmplitude C j χ) :=
      (norm_nonneg _).trans
        (SchwartzMap.norm_iteratedFDeriv_le_seminorm
          Real (angularDyadicResidualAmplitude C j χ) (n - i) 0)
    exact mul_nonneg (mul_nonneg (Nat.cast_nonneg _) hfactor) hsemi
  refine ⟨D, B, hD1, hB0, ?_⟩
  intro t ht n k hn ξ hξ
  let phase : Euclidean 2 → Complex := fun η => Complex.exp
    (((timeAngularDyadicRayPhaseMismatchPlus t direction η : Real) : Complex) * Complex.I)
  let amp : SchwartzMap (Euclidean 2) Complex := angularDyadicResidualAmplitude C j χ
  let U : Set (Euclidean 2) := {η : Euclidean 2 | η ≠ 0}
  have hU : IsOpen U := by
    simpa [U] using (isOpen_ne : IsOpen {η : Euclidean 2 | η ≠ 0})
  have hphaseSmooth : ContDiffOn Real (N : ℕ∞) phase U := by
    let e : Real → Complex := fun r => Complex.exp (((r : Complex) * Complex.I))
    have he : ContDiff Real (N : ℕ∞) e := by
      let L : Real →L[Real] Complex := Complex.ofRealCLM.smulRight Complex.I
      change ContDiff Real (N : ℕ∞) (fun r => Complex.exp (L r))
      exact Complex.contDiff_exp.comp L.contDiff
    change ContDiffOn Real (N : ℕ∞) (e ∘ timeAngularDyadicRayPhaseMismatchPlus t direction) U
    exact he.comp_contDiffOn (timeAngularDyadicRayPhaseMismatchPlus_contDiffOn N t direction)
  have hampSmooth : ContDiffOn Real (N : ℕ∞) (amp : Euclidean 2 → Complex) U := by
    exact ((amp.smooth (N : ℕ∞)).contDiffOn).mono (subset_univ _)
  have hball := support_iteratedFDeriv_scaledRayCubeCutoff_subset_closedBall
    prototype scale width direction hradius hprototype k hξ
  have hξ0 : ξ ≠ 0 := by
    intro hzero
    subst ξ
    rw [Metric.mem_closedBall, dist_eq_norm] at hball
    have hcenter : ‖scale • direction‖ = scale := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hscale, hunit, mul_one]
    have hscalele : scale ≤ width * Real.sqrt scale := by
      simpa only [norm_sub_rev, sub_zero, hcenter] using hball
    nlinarith
  have hphaseBound : ∀ i ≤ n, ‖iteratedFDeriv Real i phase ξ‖ ≤
      (i.factorial : Real) * 2 * D ^ i := by
    intro i hi
    dsimp [phase]
    apply norm_iteratedFDeriv_timeAngularDyadicRayPhaseMismatchPlusExp_le N i t direction hξ0
      (Nat.le_trans hi hn)
    intro r hr1 hri
    exact hD t ht r k hr1 (Nat.le_trans hri (Nat.le_trans hi hn)) hξ
  have hbaseeq : (angularDyadicResidualBaseSymbol C WaveSign.plus j t direction χ :
      Euclidean 2 → Complex) = fun η => phase η * amp η := by
    funext η
    simp only [phase, amp, angularDyadicResidualBaseSymbol_eq_phaseMismatch,
      angularDyadicResidualAmplitude_apply]
    simp [timeAngularDyadicRayPhaseMismatchPlus, angularDyadicRayPhaseMismatch,
      WaveSign.toReal, smul_eq_mul]
  calc
    ‖iteratedFDeriv Real n
        (angularDyadicResidualBaseSymbol C WaveSign.plus j t direction χ) ξ‖ =
      ‖iteratedFDeriv Real n (fun η => phase η * amp η) ξ‖ := by rw [hbaseeq]
    _ ≤ ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) *
        ‖iteratedFDeriv Real i phase ξ‖ * ‖iteratedFDeriv Real (n - i) amp ξ‖ :=
      norm_iteratedFDeriv_mul_le_on_open U hU phase amp N n hphaseSmooth hampSmooth
        hξ0 hn
    _ ≤ B n := by
      dsimp [B, scaledRayCubePlusResidualBaseDerivativeBound]
      apply Finset.sum_le_sum
      intro i hi
      have hin : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      have hphasei := hphaseBound i hin
      have hampa : ‖iteratedFDeriv Real (n - i) amp ξ‖ ≤
          SchwartzMap.seminorm Real 0 (n - i) amp := by
        simpa using SchwartzMap.le_seminorm Real 0 (n - i) amp ξ
      have hcoef : 0 ≤ (n.choose i : Real) := Nat.cast_nonneg _
      have hphaseBudget0 : 0 ≤ (i.factorial : Real) * 2 * D ^ i := by positivity
      have hamp0 : 0 ≤ ‖iteratedFDeriv Real (n - i) amp ξ‖ := norm_nonneg _
      calc
        (n.choose i : Real) * ‖iteratedFDeriv Real i phase ξ‖ *
            ‖iteratedFDeriv Real (n - i) amp ξ‖ ≤
          (n.choose i : Real) * ((i.factorial : Real) * 2 * D ^ i) *
            ‖iteratedFDeriv Real (n - i) amp ξ‖ := by
              exact mul_le_mul_of_nonneg_right
                (mul_le_mul_of_nonneg_left hphasei hcoef) hamp0
        _ ≤ (n.choose i : Real) * ((i.factorial : Real) * 2 * D ^ i) *
            SchwartzMap.seminorm Real 0 (n - i) amp := by
              exact mul_le_mul_of_nonneg_left hampa
                (mul_nonneg hcoef hphaseBudget0)

/-- The all-order base-amplitude calculation feeds the existing literal
cutoff-supported residual Leibniz bridge. -/
theorem exists_scaledRayCubeCutoff_plusResidualDerivativeIntegralBounds
    (C : lpCutoffs 2) (j N : Nat) (χ prototype : SchwartzMap (Euclidean 2) Complex)
    (scale width T : Real) (direction : Euclidean 2)
    (hradius : 0 < width * Real.sqrt scale)
    (hprototype : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (hT : 0 ≤ T) :
    ∃ (D : Real) (B : Nat → Real), 1 ≤ D ∧ (∀ n, 0 ≤ B n) ∧
      ∀ (t : Real), |t| ≤ T → ∀ n ≤ N,
        ∫ ξ : Euclidean 2,
          ‖iteratedFDeriv Real n
            (angularDyadicCubeResidualSymbol C WaveSign.plus j t direction χ
              (scaledRayCubeCutoff prototype scale width direction hradius)) ξ‖ ≤
          scaledRayCubeResidualDerivativeBound prototype scale width B n := by
  obtain ⟨D, B, hD1, hB0, hbase⟩ :=
    exists_scaledRayCubeCutoff_plusResidualBaseDerivativeBounds
      C j N χ prototype scale width T direction hradius hprototype hscale hunit hsmall hT
  refine ⟨D, B, hD1, hB0, ?_⟩
  intro t ht n hn
  apply integral_norm_iteratedFDeriv_angularDyadicCubeResidualSymbol_le_scaledRayCubeCutoff_of_supportBounds
    C WaveSign.plus j t direction χ prototype scale width hradius N B ?_ hn
  intro k hk ell hell ξ hξ
  exact hbase t ht k ell hk hξ

/-- The exact finite coefficient which turns derivative-integral budgets into
packet localization at reciprocal cube radius. -/
noncomputable def scaledRayCubePacketBudget
    (radius S R₀ : Real) (N : Nat) : Real :=
  S * (radius ^ 2 * (radius⁻¹) ^ N)⁻¹ + R₀ * (radius ^ 2)⁻¹

private lemma scaledRayCubePacketBudget_nonneg
    {radius S R₀ : Real} {N : Nat} (hradius : 0 < radius)
    (hS : 0 ≤ S) (hR₀ : 0 ≤ R₀) :
    0 ≤ scaledRayCubePacketBudget radius S R₀ N := by
  unfold scaledRayCubePacketBudget
  apply add_nonneg
  · exact mul_nonneg hS (inv_nonneg.mpr (by positivity))
  · exact mul_nonneg hR₀ (inv_nonneg.mpr (by positivity))

private lemma le_scaledRayCubePacketBudget_high
    {radius S R₀ : Real} {N : Nat} (hradius : 0 < radius)
    (hR₀ : 0 ≤ R₀) :
    S ≤ (scaledRayCubePacketBudget radius S R₀ N * radius ^ 2) *
      (radius⁻¹) ^ N := by
  let X : Real := radius ^ 2 * (radius⁻¹) ^ N
  have hX : 0 < X := by
    dsimp [X]
    positivity
  have hX0 : 0 ≤ X := le_of_lt hX
  have hXne : X ≠ 0 := ne_of_gt hX
  have hmain : S = (S * X⁻¹) * X := by
    calc
      S = S * (X⁻¹ * X) := by rw [inv_mul_cancel₀ hXne, mul_one]
      _ = (S * X⁻¹) * X := by ring
  have htail : 0 ≤ R₀ * (radius ^ 2)⁻¹ := by
    exact mul_nonneg hR₀ (inv_nonneg.mpr (by positivity))
  unfold scaledRayCubePacketBudget
  calc
    S = (S * X⁻¹) * X := hmain
    _ ≤ (S * X⁻¹ + R₀ * (radius ^ 2)⁻¹) * X :=
      mul_le_mul_of_nonneg_right (le_add_of_nonneg_right htail) hX0
    _ = (S * (radius ^ 2 * (radius⁻¹) ^ N)⁻¹ + R₀ * (radius ^ 2)⁻¹) *
        radius ^ 2 * (radius⁻¹) ^ N := by
      dsimp [X]
      ring

private lemma le_scaledRayCubePacketBudget_zero
    {radius S R₀ : Real} {N : Nat} (hradius : 0 < radius)
    (hS : 0 ≤ S) :
    R₀ ≤ scaledRayCubePacketBudget radius S R₀ N * radius ^ 2 := by
  have hsq : 0 < radius ^ 2 := by positivity
  have hsq0 : 0 ≤ radius ^ 2 := le_of_lt hsq
  have hsqne : radius ^ 2 ≠ 0 := ne_of_gt hsq
  have hmain : R₀ = (R₀ * (radius ^ 2)⁻¹) * radius ^ 2 := by
    calc
      R₀ = R₀ * ((radius ^ 2)⁻¹ * radius ^ 2) := by
        rw [inv_mul_cancel₀ hsqne, mul_one]
      _ = (R₀ * (radius ^ 2)⁻¹) * radius ^ 2 := by ring
  have hhead : 0 ≤ S * (radius ^ 2 * (radius⁻¹) ^ N)⁻¹ := by
    exact mul_nonneg hS (inv_nonneg.mpr (by positivity))
  unfold scaledRayCubePacketBudget
  calc
    R₀ = (R₀ * (radius ^ 2)⁻¹) * radius ^ 2 := hmain
    _ ≤ (S * (radius ^ 2 * (radius⁻¹) ^ N)⁻¹ + R₀ * (radius ^ 2)⁻¹) *
        radius ^ 2 :=
      mul_le_mul_of_nonneg_right (le_add_of_nonneg_left hhead) hsq0

private lemma scaledRayCubeResidualDerivativeBound_nonneg
    (prototype : SchwartzMap (Euclidean 2) Complex) (scale width : Real)
    (hradius : 0 < width * Real.sqrt scale)
    (B : Nat → Real) (hB : ∀ n, 0 ≤ B n) (n : Nat) :
    0 ≤ scaledRayCubeResidualDerivativeBound prototype scale width B n := by
  unfold scaledRayCubeResidualDerivativeBound
  apply Finset.sum_nonneg
  intro k hk
  apply mul_nonneg
  · exact mul_nonneg (Nat.cast_nonneg _) (hB k)
  · apply mul_nonneg
    · exact mul_nonneg (sq_nonneg _) (pow_nonneg (inv_nonneg.mpr hradius.le) _)
    · exact integral_nonneg fun ξ => norm_nonneg _

/-- The completely explicit, generally scale-dependent, localization
coefficient attached to the concrete high-order residual budget. -/
noncomputable def scaledRayCubePlusResidualLocalizationBudget
    (prototype : SchwartzMap (Euclidean 2) Complex) (scale width : Real)
    (B : Nat → Real) (N : Nat) : Real :=
  scaledRayCubePacketBudget (width * Real.sqrt scale)
    ((2 : Real) ^ N * ∑ n ∈ Finset.range (N + 1),
      scaledRayCubeResidualDerivativeBound prototype scale width B n)
    (scaledRayCubeResidualDerivativeBound prototype scale width B 0) N

/-- A literal matched plus-sheet scaled ray cube has arbitrary finite packet
decay on a compact time support.  Its coefficient is the displayed
`scaledRayCubePlusResidualLocalizationBudget`; no scale-uniform bound is
claimed here. -/
theorem exists_scaledRayCubeCutoff_plus_ray_localized_of_explicitHighOrderBounds
    (C : lpCutoffs 2) (j N : Nat)
    (χ prototype : SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (scale width T t₀ t₁ : Real) (direction : Euclidean 2)
    (hradius : 0 < width * Real.sqrt scale)
    (hprototype_cube : Function.support (prototype : Euclidean 2 → Complex) ⊆
      frequencyCube 0 1)
    (hprototype_ball : Function.support (prototype : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 1)
    (hscale : 0 < scale) (hunit : ‖direction‖ = 1)
    (hsmall : 2 * (width * Real.sqrt scale) ≤ scale)
    (hT : 0 ≤ T) (hϑ : ∀ t, ‖ϑ t‖ ≤ T)
    (hϑ_support : ∀ t, ϑ t ≠ 0 → t ∈ Icc t₀ t₁)
    (hslab : ∀ t ∈ Icc t₀ t₁, |t| ≤ T) :
    ∃ (D : Real) (B : Nat → Real), 1 ≤ D ∧ (∀ n, 0 ≤ B n) ∧
      (∀ t, Function.support
        (angularDyadicCubeResidualSymbol C WaveSign.plus j t direction χ
          (scaledRayCubeCutoff prototype scale width direction hradius) :
          Euclidean 2 → Complex) ⊆
          frequencyCube (scale • direction) (width * Real.sqrt scale)) ∧
      (∀ z y, ‖angularDyadicCubeSpaceTimeKernel C WaveSign.plus j χ
        (scaledRayCubeCutoff prototype scale width direction hradius) ϑ z y‖ ≤
        (T * (2 : Real) ^ N *
          scaledRayCubePlusResidualLocalizationBudget prototype scale width B N) *
          lightRayKernel (width * Real.sqrt scale)⁻¹ N direction y z) := by
  obtain ⟨D, B, hD1, hB0, hbase⟩ :=
    exists_scaledRayCubeCutoff_plusResidualBaseDerivativeBounds
      C j N χ prototype scale width T direction hradius hprototype_ball hscale hunit hsmall hT
  let radius : Real := width * Real.sqrt scale
  let S : Real := (2 : Real) ^ N * ∑ n ∈ Finset.range (N + 1),
    scaledRayCubeResidualDerivativeBound prototype scale width B n
  let R₀ : Real := scaledRayCubeResidualDerivativeBound prototype scale width B 0
  let A : Real := scaledRayCubePacketBudget radius S R₀ N
  have hradius' : 0 < radius := by
    simpa [radius] using hradius
  have hS : 0 ≤ S := by
    dsimp [S]
    apply mul_nonneg
    · positivity
    · apply Finset.sum_nonneg
      intro n hn
      exact scaledRayCubeResidualDerivativeBound_nonneg
        prototype scale width hradius B hB0 n
  have hR₀ : 0 ≤ R₀ := by
    dsimp [R₀]
    exact scaledRayCubeResidualDerivativeBound_nonneg
      prototype scale width hradius B hB0 0
  have hA : 0 ≤ A := scaledRayCubePacketBudget_nonneg hradius' hS hR₀
  refine ⟨D, B, hD1, hB0, ?_⟩
  apply scaledRayCubeCutoff_ray_localized_of_residualBaseBounds_on_compactTimeSupport
    C WaveSign.plus j χ prototype ϑ scale width radius⁻¹ A T t₀ t₁ N direction
    hradius hprototype_cube (inv_pos.mpr hradius') hA hϑ hϑ_support B
  · intro t ht k hk ell hell ξ hξ
    exact hbase t (hslab t ht) k ell hk hξ
  · change S ≤ (A * (radius⁻¹)⁻¹ ^ 2) * (radius⁻¹) ^ N
    simpa only [inv_inv] using
      (le_scaledRayCubePacketBudget_high hradius' hR₀)
  · change R₀ ≤ A * (radius⁻¹)⁻¹ ^ 2
    simpa only [inv_inv] using
      (le_scaledRayCubePacketBudget_zero hradius' hS)

/-- The finite square function formed from a family of planar Fourier-cube
projections. -/
noncomputable def fourierCubeSquareFunction {ι : Type*} (cubes : Finset ι)
    (m : ι → SchwartzMap (Euclidean 2) Complex)
    (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Real :=
  fun x => Real.sqrt (∑ cube ∈ cubes, ‖fourierCubeProjection (m cube) f x‖ ^ 2)

/-- The finite Fourier-cube square function is pointwise nonnegative. -/
theorem fourierCubeSquareFunction_nonneg {ι : Type*} (cubes : Finset ι)
    (m : ι → SchwartzMap (Euclidean 2) Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    0 ≤ fourierCubeSquareFunction cubes m f x :=
  Real.sqrt_nonneg _

/-- Squaring and integrating the finite physical-space Fourier-cube square
function gives exactly the sum of the individual projection energies. -/
theorem integral_sq_fourierCubeSquareFunction_eq {ι : Type*} (cubes : Finset ι)
    (m : ι → SchwartzMap (Euclidean 2) Complex)
    (f : SchwartzMap (Euclidean 2) Complex) :
    (∫ x : Euclidean 2, fourierCubeSquareFunction cubes m f x ^ 2) =
      ∑ cube ∈ cubes, ∫ x : Euclidean 2,
        ‖fourierCubeProjection (m cube) f x‖ ^ 2 := by
  classical
  unfold fourierCubeSquareFunction
  calc
    (∫ x : Euclidean 2,
        (Real.sqrt (∑ cube ∈ cubes, ‖fourierCubeProjection (m cube) f x‖ ^ 2)) ^ 2) =
        ∫ x : Euclidean 2, ∑ cube ∈ cubes,
          ‖fourierCubeProjection (m cube) f x‖ ^ 2 := by
      apply integral_congr_ae
      filter_upwards with x
      rw [Real.sq_sqrt]
      exact Finset.sum_nonneg fun cube hcube => sq_nonneg _
    _ = ∑ cube ∈ cubes, ∫ x : Euclidean 2,
        ‖fourierCubeProjection (m cube) f x‖ ^ 2 := by
      rw [integral_finsetSum]
      intro cube hcube
      simpa only [fourierCubeProjection, SchwartzMap.fourier_coe] using
        (integrable_norm_sq_fourierInv_schwartz_multiplier (m cube) (𝓕 f))

/-- The exact frequency-side energy formula for a finite family of planar
Fourier-cube projections.  This is the finite `L²` square-function identity
underlying the cube step of the MSS argument. -/
theorem integral_sq_fourierCubeSquareFunction_eq_frequency {ι : Type*}
    (cubes : Finset ι) (m : ι → SchwartzMap (Euclidean 2) Complex)
    (f : SchwartzMap (Euclidean 2) Complex) :
    (∫ x : Euclidean 2, fourierCubeSquareFunction cubes m f x ^ 2) =
      ∫ ξ : Euclidean 2,
        (∑ cube ∈ cubes, ‖m cube ξ‖ ^ 2) *
          ‖𝓕 (f : Euclidean 2 → Complex) ξ‖ ^ 2 := by
  classical
  calc
    (∫ x : Euclidean 2, fourierCubeSquareFunction cubes m f x ^ 2) =
        ∑ cube ∈ cubes, ∫ x : Euclidean 2,
          ‖fourierCubeProjection (m cube) f x‖ ^ 2 :=
      integral_sq_fourierCubeSquareFunction_eq cubes m f
    _ = ∑ cube ∈ cubes, ∫ ξ : Euclidean 2,
        ‖m cube ξ * 𝓕 (f : Euclidean 2 → Complex) ξ‖ ^ 2 := by
      apply Finset.sum_congr rfl
      intro cube hcube
      simpa only [fourierCubeProjection, SchwartzMap.fourier_coe] using
        (integral_norm_sq_fourierInv_schwartz_multiplier_eq (m cube) (𝓕 f))
    _ = ∫ ξ : Euclidean 2, ∑ cube ∈ cubes,
        ‖m cube ξ * 𝓕 (f : Euclidean 2 → Complex) ξ‖ ^ 2 := by
      rw [integral_finsetSum]
      intro cube hcube
      let h : SchwartzMap (Euclidean 2) Complex :=
        SchwartzMap.smulLeftCLM Complex (m cube : Euclidean 2 → Complex) (𝓕 f)
      have hsq : Integrable (fun ξ : Euclidean 2 => ‖h ξ‖ ^ 2) volume :=
        (memLp_two_iff_integrable_sq_norm h.continuous.aestronglyMeasurable).mp
          (h.memLp 2 volume)
      simpa only [h, SchwartzMap.smulLeftCLM_apply (m cube).hasTemperateGrowth,
        smul_eq_mul, SchwartzMap.fourier_coe] using hsq
    _ = ∫ ξ : Euclidean 2,
        (∑ cube ∈ cubes, ‖m cube ξ‖ ^ 2) *
          ‖𝓕 (f : Euclidean 2 → Complex) ξ‖ ^ 2 := by
      apply integral_congr_ae
      filter_upwards with ξ
      simp only [norm_mul, mul_pow, Finset.sum_mul]

/-- The honest finite `L²` Fourier-cube square-function estimate.  The
constant is exactly the pointwise square overlap of the cutoff family; no
all-`p` Rubio de Francia assertion is being used here. -/
theorem integral_sq_fourierCubeSquareFunction_le_of_square_overlap {ι : Type*}
    (cubes : Finset ι) (m : ι → SchwartzMap (Euclidean 2) Complex)
    (f : SchwartzMap (Euclidean 2) Complex) {C : Real}
    (hoverlap : ∀ ξ : Euclidean 2, ∑ cube ∈ cubes, ‖m cube ξ‖ ^ 2 ≤ C) :
    (∫ x : Euclidean 2, fourierCubeSquareFunction cubes m f x ^ 2) ≤
      C * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  calc
    (∫ x : Euclidean 2, fourierCubeSquareFunction cubes m f x ^ 2) =
        ∑ cube ∈ cubes, ∫ x : Euclidean 2,
          ‖fourierCubeProjection (m cube) f x‖ ^ 2 :=
      integral_sq_fourierCubeSquareFunction_eq cubes m f
    _ ≤ C * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
      simpa only [fourierCubeProjection] using
        (sum_integral_norm_sq_fourierInv_schwartz_multipliers_le cubes m f hoverlap)

/-- The unit directions relevant to planar light rays.  The separate
definition keeps the geometric restriction visible in the light-ray maximal
operator rather than taking a supremum over arbitrary speeds. -/
def unitLightRayDirections : Set (Euclidean 2) :=
  {ω | ‖ω‖ = 1}

/-- A unit vector is a permitted light-ray direction exactly when its norm is
one. -/
theorem mem_unitLightRayDirections_iff (ω : Euclidean 2) :
    ω ∈ unitLightRayDirections ↔ ‖ω‖ = 1 := Iff.rfl

/-- The compact type of unit directions used for the directional supremum.
Working with the subtype lets Mathlib provide a countable dense sequence,
which is the useful replacement for a measurable exact argmax selector. -/
abbrev aux_lightRayDirection := {ω : Euclidean 2 // ω ∈ unitLightRayDirections}

/-- A concrete unit direction, used only to make the compact direction type
nonempty. -/
noncomputable def aux_defaultLightRayDirection : aux_lightRayDirection :=
  ⟨(EuclideanSpace.basisFun (Fin 2) Real) 0,
    OrthonormalBasis.norm_eq_one _ _⟩

instance aux_lightRayDirection_nonempty : Nonempty aux_lightRayDirection :=
  ⟨aux_defaultLightRayDirection⟩

/-- The planar unit-direction set is compact. -/
theorem aux_isCompact_unitLightRayDirections :
    IsCompact unitLightRayDirections := by
  have heq : unitLightRayDirections = Metric.sphere (0 : Euclidean 2) 1 := by
    ext ω
    simp [unitLightRayDirections]
  rw [heq]
  exact isCompact_sphere _ _

/-- The compactness of the unit-direction subtype, obtained from the
preceding compact-set statement. -/
instance aux_lightRayDirection_compactSpace : CompactSpace aux_lightRayDirection :=
  isCompact_iff_compactSpace.mp aux_isCompact_unitLightRayDirections

/-- A fixed countable dense family of planar unit light-ray directions. -/
noncomputable def aux_lightRayDirectionDenseSequence : Nat → aux_lightRayDirection :=
  TopologicalSpace.denseSeq aux_lightRayDirection

/-- The fixed direction sequence is dense in the compact unit circle. -/
theorem aux_denseRange_lightRayDirectionDenseSequence :
    DenseRange aux_lightRayDirectionDenseSequence :=
  TopologicalSpace.denseRange_denseSeq aux_lightRayDirection

/-- Every positive angular tolerance admits a finite subfamily of the fixed
dense sequence covering the compact unit-direction circle.  This is the
literal finite-net replacement for an uncountable direction supremum. -/
theorem aux_exists_finiteNet_lightRayDirectionDenseSequence
    (ε : Real) (hε : 0 < ε) :
    ∃ directions : Finset Nat, ∀ ω : aux_lightRayDirection,
      ∃ n ∈ directions, dist ω (aux_lightRayDirectionDenseSequence n) < ε := by
  let U : Nat → Set aux_lightRayDirection := fun n =>
    Metric.ball (aux_lightRayDirectionDenseSequence n) ε
  have hUopen : ∀ n : Nat, IsOpen (U n) := fun n => Metric.isOpen_ball
  have hcover : Set.univ ⊆ ⋃ n : Nat, U n := by
    intro ω hω
    rcases (Metric.denseRange_iff.mp
      aux_denseRange_lightRayDirectionDenseSequence ω ε hε) with ⟨n, hn⟩
    exact Set.mem_iUnion.mpr ⟨n, hn⟩
  rcases isCompact_univ.elim_finite_subcover U hUopen hcover with ⟨directions, hdirections⟩
  refine ⟨directions, ?_⟩
  intro ω
  have hmem : ω ∈ ⋃ n ∈ directions, U n := hdirections (Set.mem_univ _)
  rcases Set.mem_iUnion.mp hmem with ⟨n, hmem⟩
  rcases Set.mem_iUnion.mp hmem with ⟨hn, hUn⟩
  exact ⟨n, hn, hUn⟩

/-- A continuous real function has the same supremum on a dense sequence as
on the whole domain.  This elementary lemma avoids a measurable-selection
assumption in the subsequent directional-supremum reduction. -/
theorem aux_csSup_eq_csSup_denseRange_of_continuous
    {X : Type*} [TopologicalSpace X] [Nonempty X]
    (u : Nat → X) (hu : DenseRange u) (F : X → Real) (hF : Continuous F)
    (hbounded : BddAbove (F '' Set.univ)) :
    sSup (F '' Set.univ) = sSup (Set.range (fun n => F (u n))) := by
  let S : Set Real := Set.range (F ∘ u)
  have hSne : S.Nonempty := Set.range_nonempty _
  have hFullne : (F '' Set.univ).Nonempty :=
    Set.image_nonempty.mpr Set.univ_nonempty
  have hsubset : S ⊆ F '' Set.univ := by
    intro z hz
    rcases hz with ⟨n, hn⟩
    rw [← hn]
    exact ⟨u n, Set.mem_univ _, rfl⟩
  have hSbdd : BddAbove S := hbounded.mono hsubset
  apply le_antisymm
  · apply csSup_le hFullne
    intro b hb
    rcases hb with ⟨x, hx, rfl⟩
    have hxclosure : x ∈ closure (Set.range u) := by
      rw [dense_iff_closure_eq.mp hu]
      exact Set.mem_univ _
    have himage : F x ∈ closure (F '' Set.range u) :=
      hF.continuousOn.image_closure ⟨x, hxclosure, rfl⟩
    have hFclosure : F x ∈ closure S := by
      change F x ∈ closure (Set.range (F ∘ u))
      rw [Set.range_comp]
      exact himage
    exact (closure_minimal (fun z hz => le_csSup hSbdd hz) isClosed_Iic) hFclosure
  · apply csSup_le hSne
    intro b hb
    exact le_csSup hbounded (hsubset hb)

/-- The fixed time interval traversed by the unit light-ray tubes in the MSS
argument. -/
def lightRayTimeInterval : Set Real := Icc (1 / 2 : Real) (5 / 2 : Real)

/-- Membership in the light-ray time interval is its displayed pair of
endpoint inequalities. -/
theorem mem_lightRayTimeInterval_iff (t : Real) :
    t ∈ lightRayTimeInterval ↔ (1 / 2 : Real) ≤ t ∧ t ≤ 5 / 2 := Iff.rfl

/-- The space-time tube following the backwards light ray ending at `y`.
Its equation is equivalent to the `x + t ω - y` kernel in the MSS
blueprint. -/
def lightRayTube (δ : Real) (ω y : Euclidean 2) : Set WaveSpaceTime :=
  {z | z.2 ∈ lightRayTimeInterval ∧
    ‖z.1 + z.2 • ω - y‖ ≤ δ}

/-- Literal membership criterion for a light-ray tube. -/
theorem mem_lightRayTube_iff (δ : Real) (ω y : Euclidean 2) (z : WaveSpaceTime) :
    z ∈ lightRayTube δ ω y ↔
      z.2 ∈ lightRayTimeInterval ∧
        ‖z.1 + z.2 • ω - y‖ ≤ δ := Iff.rfl

/-- Light-ray tubes are monotone in their transverse width. -/
theorem lightRayTube_mono {δ δ' : Real} (hδ : δ ≤ δ') (ω y : Euclidean 2) :
    lightRayTube δ ω y ⊆ lightRayTube δ' ω y := by
  intro z hz
  exact ⟨hz.1, hz.2.trans hδ⟩

/-- If two hard light-ray tubes meet at `z`, their terminal points differ by
the corresponding time-scaled direction difference, up to twice the tube
width.  This is the literal pairwise tube-intersection constraint used before
any planar Córdoba counting argument. -/
theorem norm_lightRayTerminalSeparation_sub_timeDirectionDifference_le_of_mem_inter
    {δ : Real} {ω ω' y y' : Euclidean 2} {z : WaveSpaceTime}
    (hz : z ∈ lightRayTube δ ω y) (hz' : z ∈ lightRayTube δ ω' y') :
    ‖(y - y') - z.2 • (ω - ω')‖ ≤ 2 * δ := by
  have hrewrite :
      (y - y') - z.2 • (ω - ω') =
        (z.1 + z.2 • ω' - y') - (z.1 + z.2 • ω - y) := by
    module
  calc
    ‖(y - y') - z.2 • (ω - ω')‖ =
        ‖(z.1 + z.2 • ω' - y') - (z.1 + z.2 • ω - y)‖ := by rw [hrewrite]
    _ ≤ ‖z.1 + z.2 • ω' - y'‖ + ‖z.1 + z.2 • ω - y‖ := norm_sub_le _ _
    _ ≤ δ + δ := add_le_add hz'.2 hz.2
    _ = 2 * δ := by ring

/-- An intersecting pair of hard light-ray tubes has terminal separation at
the angular scale prescribed by its intersection time. -/
theorem abs_norm_lightRayTerminalSeparation_sub_time_mul_normDirectionDifference_le_of_mem_inter
    {δ : Real} {ω ω' y y' : Euclidean 2} {z : WaveSpaceTime}
    (hz : z ∈ lightRayTube δ ω y) (hz' : z ∈ lightRayTube δ ω' y') :
    |‖y - y'‖ - z.2 * ‖ω - ω'‖| ≤ 2 * δ := by
  have hgeometry :=
    norm_lightRayTerminalSeparation_sub_timeDirectionDifference_le_of_mem_inter hz hz'
  have htime : 0 ≤ z.2 := by
    exact (by norm_num : (0 : Real) ≤ 1 / 2).trans hz.1.1
  calc
    |‖y - y'‖ - z.2 * ‖ω - ω'‖| =
        |‖y - y'‖ - ‖z.2 • (ω - ω')‖| := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg htime]
    _ ≤ ‖(y - y') - z.2 • (ω - ω')‖ :=
      abs_norm_sub_norm_le _ _
    _ ≤ 2 * δ := hgeometry

/-- The unscaled planar decay profile underlying the light-ray kernel.  Its
integrability is the elementary analytic input that makes the continuum
TT* tube-intersection kernel below a genuine integral rather than a formal
symbol. -/
def lightRayDecayProfile (N : Nat) (u : Euclidean 2) : Real :=
  (1 / (1 + ‖u‖)) ^ N

/-- In two spatial dimensions the polynomial light-ray decay profile is
integrable as soon as the decay exponent is strictly bigger than two. -/
theorem integrable_lightRayDecayProfile (N : Nat) (hN : 2 < N) :
    Integrable (lightRayDecayProfile N) volume := by
  have hdim : Module.finrank Real (Euclidean 2) = 2 := by
    simp [Euclidean]
  have hNreal : (Module.finrank Real (Euclidean 2) : Real) < (N : Real) := by
    rw [hdim]
    exact_mod_cast hN
  have h : Integrable (fun x : Euclidean 2 =>
      (1 + ‖x‖) ^ (-(N : Real))) (volume : Measure (Euclidean 2)) :=
    integrable_one_add_norm hNreal
  have heq : (fun x : Euclidean 2 => (1 + ‖x‖) ^ (-(N : Real))) =
      lightRayDecayProfile N := by
    funext x
    unfold lightRayDecayProfile
    rw [Real.rpow_neg (by positivity), Real.rpow_natCast]
    simp only [one_div, inv_pow]
  simpa only [heq] using h

/-- The light-ray kernel is a translated and dilated copy of the fixed
decay profile.  This is the scale normalization used in the continuum TT*
calculation. -/
theorem lightRayKernel_eq_scaled_decayProfile {δ : Real} (hδ : 0 < δ)
    (N : Nat) (ω y x : Euclidean 2) (t : Real) :
    lightRayKernel δ N ω y (x, t) =
      (δ⁻¹) ^ 2 * lightRayDecayProfile N (δ⁻¹ • (x + t • ω - y)) := by
  unfold lightRayKernel lightRayDecayProfile
  have hinv : 0 ≤ δ⁻¹ := inv_nonneg.mpr hδ.le
  have hnorm : ‖δ⁻¹ • (x + t • ω - y)‖ =
      δ⁻¹ * ‖x + t • ω - y‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hinv]
  simp only [one_div]
  rw [hnorm]

/-- For each fixed time and ray parameters, the spatial light-ray kernel is
integrable.  This is the first Fubini input in the TT* tube-intersection
calculation. -/
theorem integrable_lightRayKernel_spatial {δ : Real} (hδ : 0 < δ)
    (N : Nat) (hN : 2 < N) (ω y : Euclidean 2) (t : Real) :
    Integrable (fun x : Euclidean 2 => lightRayKernel δ N ω y (x, t)) volume := by
  have hprofile : Integrable (lightRayDecayProfile N) volume :=
    integrable_lightRayDecayProfile N hN
  have hinvne : δ⁻¹ ≠ 0 := inv_ne_zero hδ.ne'
  have hscaled : Integrable (fun x : Euclidean 2 =>
      lightRayDecayProfile N (δ⁻¹ • x)) volume :=
    hprofile.comp_smul hinvne
  have hshifted : Integrable (fun x : Euclidean 2 =>
      lightRayDecayProfile N (δ⁻¹ • (x + (t • ω - y)))) volume :=
    hscaled.comp_add_right (t • ω - y)
  have heq : (fun x : Euclidean 2 => lightRayKernel δ N ω y (x, t)) =
      fun x => (δ⁻¹) ^ 2 *
        lightRayDecayProfile N (δ⁻¹ • (x + (t • ω - y))) := by
    funext x
    simpa only [add_sub_assoc] using
      lightRayKernel_eq_scaled_decayProfile hδ N ω y x t
  rw [heq]
  exact hshifted.const_mul _

/-- The spatial mass of a literal light-ray kernel is exactly the mass of its
fixed planar decay profile.  In particular it is independent of the width,
terminal point, direction, and time; this is the normalization input for the
continuum tube-intersection calculation. -/
theorem integral_lightRayKernel_spatial_eq_decayProfile {δ : Real} (hδ : 0 < δ)
    (N : Nat) (ω y : Euclidean 2) (t : Real) :
    (∫ x : Euclidean 2, lightRayKernel δ N ω y (x, t)) =
      ∫ u : Euclidean 2, lightRayDecayProfile N u := by
  have hinv : 0 ≤ δ⁻¹ := inv_nonneg.mpr hδ.le
  have hfinrank : Module.finrank Real (Euclidean 2) = 2 := by
    simp [Euclidean]
  have htranslate :
      (∫ x : Euclidean 2,
        lightRayDecayProfile N (δ⁻¹ • (x + (t • ω - y)))) =
        ∫ x : Euclidean 2, lightRayDecayProfile N (δ⁻¹ • x) := by
    simpa using integral_add_right_eq_self
      (fun x : Euclidean 2 => lightRayDecayProfile N (δ⁻¹ • x)) (t • ω - y)
  have hscale := Measure.integral_comp_smul_of_nonneg
    (volume : Measure (Euclidean 2)) (lightRayDecayProfile N) δ⁻¹ (hR := hinv)
  rw [hfinrank] at hscale
  have hinvne : (δ⁻¹ : Real) ≠ 0 := inv_ne_zero hδ.ne'
  have hsqne : (δ⁻¹ : Real) ^ 2 ≠ 0 := pow_ne_zero 2 hinvne
  calc
    (∫ x : Euclidean 2, lightRayKernel δ N ω y (x, t)) =
        ∫ x : Euclidean 2, (δ⁻¹) ^ 2 *
          lightRayDecayProfile N (δ⁻¹ • (x + (t • ω - y))) := by
      apply integral_congr_ae
      filter_upwards with x
      simpa only [add_sub_assoc] using
        lightRayKernel_eq_scaled_decayProfile hδ N ω y x t
    _ = (δ⁻¹) ^ 2 * ∫ x : Euclidean 2,
        lightRayDecayProfile N (δ⁻¹ • (x + (t • ω - y))) := by
      rw [integral_const_mul]
    _ = (δ⁻¹) ^ 2 * ∫ x : Euclidean 2,
        lightRayDecayProfile N (δ⁻¹ • x) := by rw [htranslate]
    _ = (δ⁻¹) ^ 2 * ((δ⁻¹) ^ 2)⁻¹ *
        ∫ u : Euclidean 2, lightRayDecayProfile N u := by
      rw [hscale]
      simp only [smul_eq_mul, mul_assoc]
    _ = ∫ u : Euclidean 2, lightRayDecayProfile N u := by
      rw [mul_inv_cancel₀ hsqne, one_mul]

/-- Translating both the terminal point and the spatial point by the same
vector leaves a light-ray kernel unchanged.  This is the basic translation
covariance behind the tube-intersection geometry in the TT* argument. -/
theorem aux_lightRayKernel_terminal_translation (δ : Real) (N : Nat)
    (ω y x a : Euclidean 2) (t : Real) :
    lightRayKernel δ N ω (y + a) (x + a, t) =
      lightRayKernel δ N ω y (x, t) := by
  unfold lightRayKernel
  have htranslate : x + a + t • ω - (y + a) = x + t • ω - y := by
    module
  simpa only [Prod.fst, Prod.snd, htranslate]

/-- The light-ray kernel is nonnegative for a positive transverse width. -/
theorem lightRayKernel_nonneg {δ : Real} (hδ : 0 < δ) (N : Nat)
    (ω y : Euclidean 2) (z : WaveSpaceTime) :
    0 ≤ lightRayKernel δ N ω y z := by
  unfold lightRayKernel
  positivity

/-- The decaying factor in the light-ray kernel is at most one. -/
theorem lightRayKernel_decay_le_one {δ : Real} (hδ : 0 < δ) (N : Nat)
    (ω y : Euclidean 2) (z : WaveSpaceTime) :
    (1 + δ⁻¹ * ‖z.1 + z.2 • ω - y‖)⁻¹ ^ N ≤ 1 := by
  have hinv : 0 ≤ δ⁻¹ := inv_nonneg.mpr hδ.le
  have hinner : 1 ≤ 1 + δ⁻¹ * ‖z.1 + z.2 • ω - y‖ := by
    nlinarith [mul_nonneg hinv (norm_nonneg (z.1 + z.2 • ω - y))]
  have hbase : (1 + δ⁻¹ * ‖z.1 + z.2 • ω - y‖)⁻¹ ≤ 1 := by
    apply (inv_le_one₀ (lt_of_lt_of_le zero_lt_one hinner)).mpr
    exact hinner
  have hbase_nonneg : 0 ≤ (1 + δ⁻¹ * ‖z.1 + z.2 • ω - y‖)⁻¹ := by
    positivity
  exact pow_le_one₀ hbase_nonneg hbase

/-- The crude pointwise light-ray-kernel bound.  The sharp Kakeya estimate
uses the spatial concentration of this kernel; this elementary bound is used
only for finite bookkeeping. -/
theorem lightRayKernel_le_normalization {δ : Real} (hδ : 0 < δ) (N : Nat)
    (ω y : Euclidean 2) (z : WaveSpaceTime) :
    lightRayKernel δ N ω y z ≤ (δ⁻¹) ^ 2 := by
  unfold lightRayKernel
  have hnorm : 0 ≤ (δ⁻¹) ^ 2 := sq_nonneg _
  calc
    (δ⁻¹) ^ 2 * (1 + δ⁻¹ * ‖z.1 + z.2 • ω - y‖)⁻¹ ^ N ≤
        (δ⁻¹) ^ 2 * 1 :=
      mul_le_mul_of_nonneg_left (lightRayKernel_decay_le_one hδ N ω y z) hnorm
    _ = (δ⁻¹) ^ 2 := mul_one _

/-- A measurable direction selection makes the literal terminal-variable
light-ray kernel strongly measurable.  This is the minimum analytic
regularity needed before a direction-linearized TT* row can be asserted
integrable; unit length alone does not provide it. -/
theorem aestronglyMeasurable_lightRayKernel_terminal_of_aestronglyMeasurable_direction
    (δ : Real) (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (hdirection : AEStronglyMeasurable direction volume)
    (x : Euclidean 2) (t : Real) :
    AEStronglyMeasurable
      (fun y : Euclidean 2 => lightRayKernel δ N (direction y) y (x, t)) volume := by
  apply AEMeasurable.aestronglyMeasurable
  have hdir : AEMeasurable direction volume := hdirection.aemeasurable
  have hline : AEMeasurable (fun y : Euclidean 2 => x + t • direction y - y) volume := by
    change AEMeasurable ((fun _ : Euclidean 2 => x) + t • direction - id) volume
    exact (aemeasurable_const.add (hdir.const_smul t)).sub measurable_id.aemeasurable
  have hscaled : AEMeasurable (fun y : Euclidean 2 =>
      δ⁻¹ * ‖x + t • direction y - y‖) volume :=
    hline.norm.const_mul δ⁻¹
  have hbase : AEMeasurable (fun y : Euclidean 2 =>
      1 + δ⁻¹ * ‖x + t • direction y - y‖) volume :=
    aemeasurable_const.add hscaled
  change AEMeasurable (fun y : Euclidean 2 =>
      (δ⁻¹) ^ 2 *
        ((fun y : Euclidean 2 =>
          1 + δ⁻¹ * ‖x + t • direction y - y‖)⁻¹ y) ^ N) volume
  exact (hbase.inv.pow_const N).const_mul ((δ⁻¹) ^ 2)

/-- A measurable direction field remains sufficient after arbitrary measurable
coordinate substitutions.  This is the component-level form used to build
joint light-ray and TT* kernels. -/
theorem aestronglyMeasurable_lightRayKernel_of_aestronglyMeasurable_direction_comp
    {α : Type*} [MeasurableSpace α] (ν : Measure α)
    (δ : Real) (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (y x : α → Euclidean 2) (t : α → Real)
    (hdirection : AEStronglyMeasurable (fun a => direction (y a)) ν)
    (hy : AEMeasurable y ν) (hx : AEMeasurable x ν) (ht : AEMeasurable t ν) :
    AEStronglyMeasurable
      (fun a => lightRayKernel δ N (direction (y a)) (y a) (x a, t a)) ν := by
  apply AEMeasurable.aestronglyMeasurable
  have hline : AEMeasurable (fun a => x a + t a • direction (y a) - y a) ν :=
    (hx.add (ht.smul hdirection.aemeasurable)).sub hy
  have hscaled : AEMeasurable (fun a =>
      δ⁻¹ * ‖x a + t a • direction (y a) - y a‖) ν :=
    hline.norm.const_mul δ⁻¹
  have hbase : AEMeasurable (fun a =>
      1 + δ⁻¹ * ‖x a + t a • direction (y a) - y a‖) ν :=
    aemeasurable_const.add hscaled
  change AEMeasurable (fun a =>
      (δ⁻¹) ^ 2 *
        ((fun a => 1 + δ⁻¹ * ‖x a + t a • direction (y a) - y a‖)⁻¹ a) ^ N) ν
  exact (hbase.inv.pow_const N).const_mul ((δ⁻¹) ^ 2)

/-- A measurable terminal-direction selector gives a jointly measurable
light-ray kernel in the terminal and space-time variables. -/
theorem aestronglyMeasurable_lightRayKernel_joint_of_aestronglyMeasurable_direction
    (δ : Real) (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (hdirection : AEStronglyMeasurable direction volume)
    (μ : Measure WaveSpaceTime) :
    AEStronglyMeasurable
      (fun p : Euclidean 2 × WaveSpaceTime =>
        lightRayKernel δ N (direction p.1) p.1 p.2)
      (volume.prod μ) := by
  apply AEMeasurable.aestronglyMeasurable
  have hdirection' : AEMeasurable (fun p : Euclidean 2 × WaveSpaceTime =>
      direction p.1) (volume.prod μ) :=
    hdirection.aemeasurable.comp_fst
  have hx : AEMeasurable (fun p : Euclidean 2 × WaveSpaceTime => p.2.1)
      (volume.prod μ) :=
    (measurable_fst.comp measurable_snd).aemeasurable
  have ht : AEMeasurable (fun p : Euclidean 2 × WaveSpaceTime => p.2.2)
      (volume.prod μ) :=
    (measurable_snd.comp measurable_snd).aemeasurable
  have hy : AEMeasurable (fun p : Euclidean 2 × WaveSpaceTime => p.1)
      (volume.prod μ) :=
    measurable_fst.aemeasurable
  have hline : AEMeasurable (fun p : Euclidean 2 × WaveSpaceTime =>
      p.2.1 + p.2.2 • direction p.1 - p.1) (volume.prod μ) :=
    (hx.add (ht.smul hdirection')).sub hy
  have hscaled : AEMeasurable (fun p : Euclidean 2 × WaveSpaceTime =>
      δ⁻¹ * ‖p.2.1 + p.2.2 • direction p.1 - p.1‖) (volume.prod μ) :=
    hline.norm.const_mul δ⁻¹
  have hbase : AEMeasurable (fun p : Euclidean 2 × WaveSpaceTime =>
      1 + δ⁻¹ * ‖p.2.1 + p.2.2 • direction p.1 - p.1‖) (volume.prod μ) :=
    aemeasurable_const.add hscaled
  change AEMeasurable (fun p : Euclidean 2 × WaveSpaceTime =>
      (δ⁻¹) ^ 2 *
        ((fun p : Euclidean 2 × WaveSpaceTime =>
          1 + δ⁻¹ * ‖p.2.1 + p.2.2 • direction p.1 - p.1‖)⁻¹ p) ^ N)
      (volume.prod μ)
  exact (hbase.inv.pow_const N).const_mul ((δ⁻¹) ^ 2)

/-- Fubini transposition for a direction-linearized light-ray kernel.  The
finite-integral premise is kept explicit: measurability alone does not prove
the Córdoba row estimate. -/
theorem integral_lightRayKernel_mul_transpose_of_aestronglyMeasurable_direction
    (δ : Real) (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (hdirection : AEStronglyMeasurable direction volume)
    (μ : Measure WaveSpaceTime) [SFinite μ]
    (endpointWeight : Euclidean 2 → Real) (spaceTimeWeight : WaveSpaceTime → Real)
    (hEndpoint : AEStronglyMeasurable endpointWeight volume)
    (hSpaceTime : AEStronglyMeasurable spaceTimeWeight μ)
    (hfinite : HasFiniteIntegral (fun p : Euclidean 2 × WaveSpaceTime =>
      lightRayKernel δ N (direction p.1) p.1 p.2 * endpointWeight p.1 *
        spaceTimeWeight p.2) (volume.prod μ)) :
    (∫ y : Euclidean 2, ∫ z : WaveSpaceTime,
      lightRayKernel δ N (direction y) y z * endpointWeight y * spaceTimeWeight z ∂μ) =
      ∫ z : WaveSpaceTime, ∫ y : Euclidean 2,
        lightRayKernel δ N (direction y) y z * endpointWeight y *
          spaceTimeWeight z ∂volume ∂μ := by
  have hmeas : AEStronglyMeasurable (fun p : Euclidean 2 × WaveSpaceTime =>
      lightRayKernel δ N (direction p.1) p.1 p.2 * endpointWeight p.1 *
        spaceTimeWeight p.2) (volume.prod μ) :=
    ((aestronglyMeasurable_lightRayKernel_joint_of_aestronglyMeasurable_direction
      δ N direction hdirection μ).mul (hEndpoint.comp_fst)).mul hSpaceTime.comp_snd
  have hprod : Integrable (fun p : Euclidean 2 × WaveSpaceTime =>
      lightRayKernel δ N (direction p.1) p.1 p.2 * endpointWeight p.1 *
        spaceTimeWeight p.2) (volume.prod μ) :=
    ⟨hmeas, hfinite⟩
  simpa only [Function.uncurry] using
    (integral_integral_swap (μ := volume) (ν := μ)
      (f := fun y : Euclidean 2 => fun z : WaveSpaceTime =>
        lightRayKernel δ N (direction y) y z * endpointWeight y * spaceTimeWeight z)
      hprod)

/-- The literal product kernel in the light-ray TT* calculation is jointly
measurable as soon as the terminal direction selector is measurable. -/
theorem aestronglyMeasurable_lightRayTTStarIntegrand_of_aestronglyMeasurable_direction
    (δ : Real) (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (hdirection : AEStronglyMeasurable direction volume)
    (μ : Measure WaveSpaceTime) :
    AEStronglyMeasurable
      (fun p : (Euclidean 2 × Euclidean 2) × WaveSpaceTime =>
        lightRayKernel δ N (direction p.1.1) p.1.1 p.2 *
          lightRayKernel δ N (direction p.1.2) p.1.2 p.2)
      ((volume.prod volume).prod μ) := by
  have hfirst : AEStronglyMeasurable
      (fun p : (Euclidean 2 × Euclidean 2) × WaveSpaceTime =>
        lightRayKernel δ N (direction p.1.1) p.1.1 p.2)
      ((volume.prod volume).prod μ) := by
    apply aestronglyMeasurable_lightRayKernel_of_aestronglyMeasurable_direction_comp
      ((volume.prod volume).prod μ) δ N direction
      (fun p : (Euclidean 2 × Euclidean 2) × WaveSpaceTime => p.1.1)
      (fun p : (Euclidean 2 × Euclidean 2) × WaveSpaceTime => p.2.1)
      (fun p : (Euclidean 2 × Euclidean 2) × WaveSpaceTime => p.2.2)
    · exact (hdirection.comp_fst).comp_fst
    · exact (measurable_fst.comp measurable_fst).aemeasurable
    · exact (measurable_fst.comp measurable_snd).aemeasurable
    · exact (measurable_snd.comp measurable_snd).aemeasurable
  have hsecond : AEStronglyMeasurable
      (fun p : (Euclidean 2 × Euclidean 2) × WaveSpaceTime =>
        lightRayKernel δ N (direction p.1.2) p.1.2 p.2)
      ((volume.prod volume).prod μ) := by
    apply aestronglyMeasurable_lightRayKernel_of_aestronglyMeasurable_direction_comp
      ((volume.prod volume).prod μ) δ N direction
      (fun p : (Euclidean 2 × Euclidean 2) × WaveSpaceTime => p.1.2)
      (fun p : (Euclidean 2 × Euclidean 2) × WaveSpaceTime => p.2.1)
      (fun p : (Euclidean 2 × Euclidean 2) × WaveSpaceTime => p.2.2)
    · exact (hdirection.comp_snd).comp_fst
    · exact (measurable_snd.comp measurable_fst).aemeasurable
    · exact (measurable_fst.comp measurable_snd).aemeasurable
    · exact (measurable_snd.comp measurable_snd).aemeasurable
  exact hfirst.mul hsecond

/-- Integrating the jointly measurable TT* product produces a measurable
terminal-pair kernel under the usual sigma-finiteness hypothesis. -/
theorem aestronglyMeasurable_lightRayTTStarIntersectionProduct_of_aestronglyMeasurable_direction
    (δ : Real) (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (hdirection : AEStronglyMeasurable direction volume)
    (μ : Measure WaveSpaceTime) [SFinite μ] :
    AEStronglyMeasurable
      (fun q : Euclidean 2 × Euclidean 2 => ∫ z : WaveSpaceTime,
        lightRayKernel δ N (direction q.1) q.1 z *
          lightRayKernel δ N (direction q.2) q.2 z ∂μ)
      (volume.prod volume) := by
  exact
    (aestronglyMeasurable_lightRayTTStarIntegrand_of_aestronglyMeasurable_direction
      δ N direction hdirection μ).integral_prod_right'

/-- The literal smooth light-ray average.  Integration is over planar
space-time with its product Lebesgue measure. -/
noncomputable def lightRayAverage (δ : Real) (N : Nat)
    (ω y : Euclidean 2) (g : WaveSpaceTime → Complex) : Real :=
  ∫ t in lightRayTimeInterval, ∫ x : Euclidean 2,
    lightRayKernel δ N ω y (x, t) * ‖g (x, t)‖

/-- Smooth light-ray averages are nonnegative because both the kernel and
the absolute-value input are nonnegative. -/
theorem aux_lightRayAverage_nonneg {δ : Real} (hδ : 0 < δ) (N : Nat)
    (ω y : Euclidean 2) (g : WaveSpaceTime → Complex) :
    0 ≤ lightRayAverage δ N ω y g := by
  unfold lightRayAverage
  apply integral_nonneg
  intro t
  apply integral_nonneg
  intro x
  exact mul_nonneg (lightRayKernel_nonneg hδ N ω y (x, t)) (norm_nonneg _)

/-- The continuum planar light-ray maximal operator from the blueprint.
The later Nikodym--Kakeya theorem is precisely the non-elementary `L²`
estimate for this definition. -/
noncomputable def lightRayMaximal (δ : Real) (N : Nat)
    (g : WaveSpaceTime → Complex) : Euclidean 2 → Real :=
  fun y => sSup ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
    unitLightRayDirections)

/-- The literal directional supremum is nonnegative whenever it is bounded
above.  This elementary fact is what makes a multiplicative, rather than
additive, measurable near-maximizer possible. -/
theorem aux_lightRayMaximal_nonneg {δ : Real} (hδ : 0 < δ) (N : Nat)
    (g : WaveSpaceTime → Complex)
    (hbounded : ∀ y : Euclidean 2,
      BddAbove ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
        unitLightRayDirections)) (y : Euclidean 2) :
    0 ≤ lightRayMaximal δ N g y := by
  have hle : lightRayAverage δ N aux_defaultLightRayDirection.1 y g ≤
      lightRayMaximal δ N g y := by
    unfold lightRayMaximal
    apply le_csSup (hbounded y)
    exact ⟨aux_defaultLightRayDirection.1, aux_defaultLightRayDirection.2, rfl⟩
  exact (aux_lightRayAverage_nonneg hδ N aux_defaultLightRayDirection.1 y g).trans hle

/-- The maximum over a finite part of the fixed dense direction family.
Unlike the sampled finite operator elsewhere in this file, its individual
averages are still the literal continuum light-ray integrals. -/
noncomputable def aux_lightRayDenseFiniteMaximum
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (directions : Finset Nat) (hdirections : directions.Nonempty) :
    Euclidean 2 → Real :=
  fun y => directions.sup' hdirections (fun n =>
    lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g)

/-- Every finite dense-direction maximum lies below the literal directional
supremum, provided that supremum is bounded above. -/
theorem aux_lightRayDenseFiniteMaximum_le_lightRayMaximal
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (directions : Finset Nat) (hdirections : directions.Nonempty)
    (hbounded : ∀ y : Euclidean 2,
      BddAbove ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
        unitLightRayDirections)) (y : Euclidean 2) :
    aux_lightRayDenseFiniteMaximum δ N g directions hdirections y ≤
      lightRayMaximal δ N g y := by
  unfold aux_lightRayDenseFiniteMaximum lightRayMaximal
  apply Finset.sup'_le
  intro n hn
  apply le_csSup (hbounded y)
  exact ⟨(aux_lightRayDirectionDenseSequence n).1,
    (aux_lightRayDirectionDenseSequence n).2, rfl⟩

/-- The analytic continuity input for the compact-direction argument.  For
Schwartz data it should follow from dominated convergence; it is kept
separate here from the purely topological supremum reduction. -/
def aux_HasContinuousLightRayDirections (δ : Real) (N : Nat)
    (g : WaveSpaceTime → Complex) : Prop :=
  ∀ y : Euclidean 2,
    ContinuousOn (fun ω : Euclidean 2 => lightRayAverage δ N ω y g)
      unitLightRayDirections

/-- Directional continuity makes the set of light-ray averages bounded
above, by compactness of the unit circle. -/
theorem aux_bddAbove_lightRayAverages_of_continuity
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (y : Euclidean 2) :
    BddAbove ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
      unitLightRayDirections) := by
  exact (aux_isCompact_unitLightRayDirections.image_of_continuousOn
    (hcont y)).bddAbove

/-- For each endpoint `y`, directional continuity on the compact unit circle
gives a direction realizing the literal `sSup` in `lightRayMaximal`.  This
is pointwise choice only; measurability of the chosen argmax is deliberately
not claimed here. -/
theorem aux_exists_lightRayPointwiseMaximizer_of_continuity
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (y : Euclidean 2) :
    ∃ ω : Euclidean 2, ω ∈ unitLightRayDirections ∧
      lightRayMaximal δ N g y = lightRayAverage δ N ω y g := by
  rcases aux_isCompact_unitLightRayDirections.exists_isMaxOn
      ⟨aux_defaultLightRayDirection, aux_defaultLightRayDirection.property⟩
      (hcont y) with ⟨ω, hω, hmax⟩
  refine ⟨ω, hω, ?_⟩
  unfold lightRayMaximal
  apply IsGreatest.csSup_eq
  refine ⟨⟨ω, hω, rfl⟩, ?_⟩
  intro z hz
  rcases hz with ⟨ω', hω', rfl⟩
  exact hmax hω'

/-- A pointwise choice of a maximizing light-ray direction under the
continuity hypothesis.  It is not asserted measurable: the missing
measurable-maximum theorem is exactly the remaining selector issue. -/
noncomputable def aux_lightRayPointwiseMaximizer
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (y : Euclidean 2) : Euclidean 2 :=
  Classical.choose (aux_exists_lightRayPointwiseMaximizer_of_continuity
    δ N g hcont y)

/-- The pointwise argmax belongs to the unit direction circle. -/
theorem aux_lightRayPointwiseMaximizer_mem
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (y : Euclidean 2) :
    aux_lightRayPointwiseMaximizer δ N g hcont y ∈ unitLightRayDirections :=
  (Classical.choose_spec (aux_exists_lightRayPointwiseMaximizer_of_continuity
    δ N g hcont y)).1

/-- The pointwise argmax realizes the literal light-ray directional
supremum. -/
theorem aux_lightRayPointwiseMaximizer_realizes
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (y : Euclidean 2) :
    lightRayMaximal δ N g y =
      lightRayAverage δ N (aux_lightRayPointwiseMaximizer δ N g hcont y) y g :=
  (Classical.choose_spec (aux_exists_lightRayPointwiseMaximizer_of_continuity
    δ N g hcont y)).2

/-- Continuity in direction reduces the literal uncountable light-ray
supremum to the fixed countable dense family of unit directions.  This is
the usable finite-to-countable bridge when an exact measurable argmax is not
yet available. -/
theorem aux_lightRayMaximal_eq_csSup_denseDirections_of_continuity
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (y : Euclidean 2) :
    lightRayMaximal δ N g y =
      sSup (Set.range (fun n : Nat =>
        lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g)) := by
  let F : aux_lightRayDirection → Real := fun ω => lightRayAverage δ N ω.1 y g
  have hFcont : Continuous F := (hcont y).restrict
  have himage : F '' Set.univ =
      ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
        unitLightRayDirections) := by
    ext r
    constructor
    · intro hr
      rcases hr with ⟨ω, hω, hr⟩
      exact ⟨ω.1, ω.2, hr⟩
    · intro hr
      rcases hr with ⟨ω, hω, hr⟩
      exact ⟨⟨ω, hω⟩, Set.mem_univ _, hr⟩
  have hFbounded : BddAbove (F '' Set.univ) := by
    rw [himage]
    exact aux_bddAbove_lightRayAverages_of_continuity δ N g hcont y
  have hsup := aux_csSup_eq_csSup_denseRange_of_continuous
    aux_lightRayDirectionDenseSequence
    aux_denseRange_lightRayDirectionDenseSequence F hFcont hFbounded
  unfold lightRayMaximal
  rw [← himage]
  simpa only [F] using hsup

/-- Once the countable dense directional averages are measurable in the
endpoint variable, directional continuity makes the literal light-ray
maximal function measurable.  This avoids needing a measurable argmax for
measurability of the supremum itself. -/
theorem aux_aemeasurable_lightRayMaximal_of_continuity
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (hmeas : ∀ n : Nat,
      AEMeasurable (fun y : Euclidean 2 =>
        lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g) volume) :
    AEMeasurable (lightRayMaximal δ N g) volume := by
  have hsupmeas : AEMeasurable (fun y : Euclidean 2 =>
      ⨆ n : Nat, lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g)
      volume := AEMeasurable.iSup hmeas
  have heq : lightRayMaximal δ N g = fun y : Euclidean 2 =>
      ⨆ n : Nat, lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g := by
    funext y
    rw [aux_lightRayMaximal_eq_csSup_denseDirections_of_continuity δ N g hcont y,
      sSup_range]
  rw [heq]
  exact hsupmeas

/-- Measurable counterpart of the preceding countable-direction result. -/
theorem aux_measurable_lightRayMaximal_of_continuity
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (hmeas : ∀ n : Nat,
      Measurable (fun y : Euclidean 2 =>
        lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g)) :
    Measurable (lightRayMaximal δ N g) := by
  have hsupmeas : Measurable (fun y : Euclidean 2 =>
      ⨆ n : Nat, lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g) :=
    Measurable.iSup hmeas
  have heq : lightRayMaximal δ N g = fun y : Euclidean 2 =>
      ⨆ n : Nat, lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g := by
    funext y
    rw [aux_lightRayMaximal_eq_csSup_denseDirections_of_continuity δ N g hcont y,
      sSup_range]
  rw [heq]
  exact hsupmeas

/-- The countable dense direction predicate used for a measurable
epsilon-linearization of the supremum. -/
def aux_lightRayEpsilonDirectionPredicate (δ : Real) (N : Nat)
    (g : WaveSpaceTime → Complex) (ε : Real) (n : Nat) (y : Euclidean 2) : Prop :=
  lightRayMaximal δ N g y <
    lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g + ε

/-- A positive additive tolerance is attained by one direction in the
fixed dense sequence. -/
theorem aux_exists_lightRayEpsilonDirection_of_continuity
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε) (y : Euclidean 2) :
    ∃ n : Nat, aux_lightRayEpsilonDirectionPredicate δ N g ε n y := by
  let S : Set Real := Set.range (fun n : Nat =>
    lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g)
  have hSnonempty : S.Nonempty := Set.range_nonempty _
  have hSbounded : BddAbove S := by
    apply (aux_bddAbove_lightRayAverages_of_continuity δ N g hcont y).mono
    intro a ha
    rcases ha with ⟨n, hn⟩
    rw [← hn]
    exact ⟨(aux_lightRayDirectionDenseSequence n).1,
      (aux_lightRayDirectionDenseSequence n).2, rfl⟩
  have hsup : lightRayMaximal δ N g y = sSup S := by
    simpa only [S] using
      aux_lightRayMaximal_eq_csSup_denseDirections_of_continuity δ N g hcont y
  have hlt : lightRayMaximal δ N g y - ε < sSup S := by
    rw [← hsup]
    linarith
  rcases exists_lt_of_lt_csSup hSnonempty hlt with ⟨a, ha, hlt_a⟩
  rcases ha with ⟨n, hn⟩
  refine ⟨n, ?_⟩
  unfold aux_lightRayEpsilonDirectionPredicate
  rw [← hn] at hlt_a
  linarith

/-- The first dense direction whose average is within `ε` of the literal
supremum.  Unlike an exact argmax it is measurable once the countable
directional averages are measurable. -/
noncomputable def aux_lightRayEpsilonDirection
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε) : Euclidean 2 → Euclidean 2 :=
  by
    classical
    exact fun y => (aux_lightRayDirectionDenseSequence
      (Nat.find (aux_exists_lightRayEpsilonDirection_of_continuity
        δ N g hcont ε hε y))).1

/-- The epsilon direction is always an admissible unit light-ray direction. -/
theorem aux_lightRayEpsilonDirection_mem
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε) (y : Euclidean 2) :
    aux_lightRayEpsilonDirection δ N g hcont ε hε y ∈ unitLightRayDirections := by
  unfold aux_lightRayEpsilonDirection
  exact (aux_lightRayDirectionDenseSequence _).2

/-- The epsilon direction realizes the dense directional approximation at
every endpoint. -/
theorem aux_lightRayMaximal_lt_lightRayEpsilonDirection_add
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε) (y : Euclidean 2) :
    lightRayMaximal δ N g y <
      lightRayAverage δ N
        (aux_lightRayEpsilonDirection δ N g hcont ε hε y) y g + ε := by
  classical
  have hfind := Nat.find_spec
    (aux_exists_lightRayEpsilonDirection_of_continuity δ N g hcont ε hε y)
  simpa only [aux_lightRayEpsilonDirection,
    aux_lightRayEpsilonDirectionPredicate] using hfind

/-- The epsilon direction is Borel measurable when every fixed dense
directional average is Borel measurable.  This gives a fully constructive
measurable approximate linearization, without invoking a general measurable
maximum theorem. -/
theorem aux_measurable_lightRayEpsilonDirection_of_continuity
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε)
    (hmeas : ∀ n : Nat,
      Measurable (fun y : Euclidean 2 =>
        lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g)) :
    Measurable (aux_lightRayEpsilonDirection δ N g hcont ε hε) := by
  classical
  have hmaxmeas : Measurable (lightRayMaximal δ N g) :=
    aux_measurable_lightRayMaximal_of_continuity δ N g hcont hmeas
  unfold aux_lightRayEpsilonDirection
  simpa only using (Measurable.find
    (fun n : Nat =>
      (measurable_const : Measurable (fun _ : Euclidean 2 =>
        (aux_lightRayDirectionDenseSequence n).1)))
    (fun n => by
      change MeasurableSet {y : Euclidean 2 |
        aux_lightRayEpsilonDirectionPredicate δ N g ε n y}
      unfold aux_lightRayEpsilonDirectionPredicate
      exact measurableSet_lt hmaxmeas ((hmeas n).add measurable_const))
    (fun y => aux_exists_lightRayEpsilonDirection_of_continuity
      δ N g hcont ε hε y))

/-- The countable dense direction predicate used for a multiplicative
measurable near-linearization.  The multiplicative form is the one that can
be passed directly through an `L²` estimate on the whole plane. -/
def aux_lightRayMultiplicativeDirectionPredicate (δ : Real) (N : Nat)
    (g : WaveSpaceTime → Complex) (ε : Real) (n : Nat) (y : Euclidean 2) : Prop :=
  lightRayMaximal δ N g y ≤ (1 + ε) *
    lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g

/-- For positive width and positive relative tolerance, a fixed countable
dense family contains a direction attaining a multiplicative approximation
to the continuum directional supremum at every endpoint. -/
theorem aux_exists_lightRayMultiplicativeDirection_of_continuity
    {δ : Real} (hδ : 0 < δ) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε) (y : Euclidean 2) :
    ∃ n : Nat, aux_lightRayMultiplicativeDirectionPredicate δ N g ε n y := by
  let S : Set Real := Set.range (fun n : Nat =>
    lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g)
  have hSnonempty : S.Nonempty := Set.range_nonempty _
  have hSbounded : BddAbove S := by
    apply (aux_bddAbove_lightRayAverages_of_continuity δ N g hcont y).mono
    intro a ha
    rcases ha with ⟨n, hn⟩
    rw [← hn]
    exact ⟨(aux_lightRayDirectionDenseSequence n).1,
      (aux_lightRayDirectionDenseSequence n).2, rfl⟩
  have hsup : lightRayMaximal δ N g y = sSup S := by
    simpa only [S] using
      aux_lightRayMaximal_eq_csSup_denseDirections_of_continuity δ N g hcont y
  have hmaxnonneg : 0 ≤ lightRayMaximal δ N g y :=
    aux_lightRayMaximal_nonneg hδ N g
      (fun y => aux_bddAbove_lightRayAverages_of_continuity δ N g hcont y) y
  by_cases hzero : lightRayMaximal δ N g y = 0
  · refine ⟨0, ?_⟩
    unfold aux_lightRayMultiplicativeDirectionPredicate
    rw [hzero]
    exact mul_nonneg (by linarith) (aux_lightRayAverage_nonneg hδ N
      (aux_lightRayDirectionDenseSequence 0).1 y g)
  · have hmaxpos : 0 < lightRayMaximal δ N g y :=
      lt_of_le_of_ne hmaxnonneg (Ne.symm hzero)
    have hone : 1 < 1 + ε := by linarith
    have hfactor : 0 < 1 + ε := by linarith
    have hdiv : lightRayMaximal δ N g y / (1 + ε) < lightRayMaximal δ N g y :=
      div_lt_self hmaxpos hone
    have hlt : lightRayMaximal δ N g y / (1 + ε) < sSup S := by
      rwa [← hsup]
    rcases exists_lt_of_lt_csSup hSnonempty hlt with ⟨a, ha, hlt_a⟩
    rcases ha with ⟨n, hn⟩
    refine ⟨n, ?_⟩
    unfold aux_lightRayMultiplicativeDirectionPredicate
    rw [← hn] at hlt_a
    have hmul : lightRayMaximal δ N g y <
        lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g * (1 + ε) :=
      (div_lt_iff₀ hfactor).mp hlt_a
    simpa only [mul_comm] using hmul.le

/-- The first countable dense direction achieving the multiplicative
approximation.  This is an explicit pointwise selector; no compact argmax
or abstract measurable-selection theorem is used. -/
noncomputable def aux_lightRayMultiplicativeDirection
    {δ : Real} (hδ : 0 < δ) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε) : Euclidean 2 → Euclidean 2 :=
  by
    classical
    exact fun y => (aux_lightRayDirectionDenseSequence
      (Nat.find (aux_exists_lightRayMultiplicativeDirection_of_continuity
        hδ N g hcont ε hε y))).1

/-- The multiplicative selector only takes admissible unit directions. -/
theorem aux_lightRayMultiplicativeDirection_mem
    {δ : Real} (hδ : 0 < δ) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε) (y : Euclidean 2) :
    aux_lightRayMultiplicativeDirection hδ N g hcont ε hε y ∈ unitLightRayDirections := by
  unfold aux_lightRayMultiplicativeDirection
  exact (aux_lightRayDirectionDenseSequence _).2

/-- Pointwise multiplicative approximation of the literal continuum
light-ray maximal function by its explicit selected direction. -/
theorem aux_lightRayMaximal_le_lightRayMultiplicativeDirection_mul
    {δ : Real} (hδ : 0 < δ) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε) (y : Euclidean 2) :
    lightRayMaximal δ N g y ≤ (1 + ε) * lightRayAverage δ N
      (aux_lightRayMultiplicativeDirection hδ N g hcont ε hε y) y g := by
  classical
  have hfind := Nat.find_spec
    (aux_exists_lightRayMultiplicativeDirection_of_continuity hδ N g hcont ε hε y)
  simpa only [aux_lightRayMultiplicativeDirection,
    aux_lightRayMultiplicativeDirectionPredicate] using hfind

/-- The multiplicative selector is Borel measurable when the countable
fixed-direction averages are Borel measurable. -/
theorem aux_measurable_lightRayMultiplicativeDirection_of_continuity
    {δ : Real} (hδ : 0 < δ) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε)
    (hmeas : ∀ n : Nat,
      Measurable (fun y : Euclidean 2 =>
        lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g)) :
    Measurable (aux_lightRayMultiplicativeDirection hδ N g hcont ε hε) := by
  classical
  have hmaxmeas : Measurable (lightRayMaximal δ N g) :=
    aux_measurable_lightRayMaximal_of_continuity δ N g hcont hmeas
  unfold aux_lightRayMultiplicativeDirection
  simpa only using (Measurable.find
    (fun n : Nat =>
      (measurable_const : Measurable (fun _ : Euclidean 2 =>
        (aux_lightRayDirectionDenseSequence n).1)))
    (fun n => by
      change MeasurableSet {y : Euclidean 2 |
        aux_lightRayMultiplicativeDirectionPredicate δ N g ε n y}
      unfold aux_lightRayMultiplicativeDirectionPredicate
      exact measurableSet_le hmaxmeas
        (measurable_const.mul (hmeas n)))
    (fun y => aux_exists_lightRayMultiplicativeDirection_of_continuity
      hδ N g hcont ε hε y))

/-- At each endpoint and positive tolerance, a finite subfamily of the
fixed dense directions approximates the literal directional supremum from
below.  The finite family may depend on the endpoint and tolerance; this is
the precise pointwise finite-net statement, without an unproved measurable
selection assertion. -/
theorem aux_exists_lightRayDenseFiniteApproximation_of_continuity
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (y : Euclidean 2) (η : Real) (hη : 0 < η) :
    ∃ (directions : Finset Nat) (hdirections : directions.Nonempty),
      lightRayMaximal δ N g y ≤
        aux_lightRayDenseFiniteMaximum δ N g directions hdirections y + η := by
  rcases aux_exists_lightRayPointwiseMaximizer_of_continuity δ N g hcont y with
    ⟨ω, hω, hmax⟩
  let ω₀ : aux_lightRayDirection := ⟨ω, hω⟩
  let F : aux_lightRayDirection → Real := fun ω' => lightRayAverage δ N ω'.1 y g
  have hFcont : Continuous F := (hcont y).restrict
  have hFat : ContinuousAt F ω₀ := hFcont.continuousAt
  rcases (Metric.continuousAt_iff.mp hFat η hη) with ⟨ε, hε, hclose⟩
  rcases aux_exists_finiteNet_lightRayDirectionDenseSequence ε hε with
    ⟨directions, hnet⟩
  rcases hnet ω₀ with ⟨n, hn, hndist⟩
  have hdirections : directions.Nonempty := ⟨n, hn⟩
  refine ⟨directions, hdirections, ?_⟩
  have hdist : dist (aux_lightRayDirectionDenseSequence n) ω₀ < ε := by
    simpa only [dist_comm] using hndist
  have hvalueDist : dist (F (aux_lightRayDirectionDenseSequence n)) (F ω₀) < η :=
    hclose hdist
  have habs : |F (aux_lightRayDirectionDenseSequence n) - F ω₀| < η := by
    simpa only [Real.dist_eq] using hvalueDist
  have hsub : F ω₀ - F (aux_lightRayDirectionDenseSequence n) < η := by
    calc
      F ω₀ - F (aux_lightRayDirectionDenseSequence n) =
          -(F (aux_lightRayDirectionDenseSequence n) - F ω₀) := by ring
      _ ≤ |F (aux_lightRayDirectionDenseSequence n) - F ω₀| := neg_le_abs _
      _ < η := habs
  have hvalue : F ω₀ ≤ F (aux_lightRayDirectionDenseSequence n) + η := by
    linarith
  have hfinite : F (aux_lightRayDirectionDenseSequence n) ≤
      aux_lightRayDenseFiniteMaximum δ N g directions hdirections y := by
    unfold aux_lightRayDenseFiniteMaximum
    exact Finset.le_sup' (fun k =>
      lightRayAverage δ N (aux_lightRayDirectionDenseSequence k).1 y g) hn
  calc
    lightRayMaximal δ N g y = F ω₀ := by
      simpa only [F, ω₀] using hmax
    _ ≤ F (aux_lightRayDirectionDenseSequence n) + η := hvalue
    _ ≤ aux_lightRayDenseFiniteMaximum δ N g directions hdirections y + η :=
      by linarith

/-- A measurable-direction linearization of the light-ray average.  The
Nikodym maximal theorem is obtained by proving uniform `L²` bounds for such
linearizations and then passing to the directional supremum. -/
noncomputable def aux_lightRayLinearizedAverage (δ : Real) (N : Nat)
    (direction : Euclidean 2 → Euclidean 2)
    (g : WaveSpaceTime → Complex) : Euclidean 2 → Real :=
  fun y => lightRayAverage δ N (direction y) y g

/-- Every admissible linearized ray average is pointwise below the literal
directional supremum, provided the latter set of values is bounded above.
The boundedness condition is kept explicit because `sSup` on the reals does
not supply it automatically. -/
theorem aux_lightRayLinearizedAverage_le_lightRayMaximal
    (δ : Real) (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (g : WaveSpaceTime → Complex)
    (hdirection : ∀ y : Euclidean 2, direction y ∈ unitLightRayDirections)
    (hbounded : ∀ y : Euclidean 2,
      BddAbove ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
        unitLightRayDirections)) (y : Euclidean 2) :
    aux_lightRayLinearizedAverage δ N direction g y ≤
      lightRayMaximal δ N g y := by
  unfold aux_lightRayLinearizedAverage lightRayMaximal
  apply le_csSup (hbounded y)
  exact ⟨direction y, hdirection y, rfl⟩

/-- The explicit measurable dense-direction selector gives a multiplicative
linearization of the literal continuum maximal function.  This is the
selection bridge needed for `L²`: unlike an additive error, its cost can be
sent to one globally on the infinite-measure endpoint space. -/
theorem aux_lightRayMaximal_le_one_add_mul_lightRayLinearizedAverage
    {δ : Real} (hδ : 0 < δ) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε) (y : Euclidean 2) :
    lightRayMaximal δ N g y ≤ (1 + ε) *
      aux_lightRayLinearizedAverage δ N
        (aux_lightRayMultiplicativeDirection hδ N g hcont ε hε) g y := by
  simpa only [aux_lightRayLinearizedAverage] using
    aux_lightRayMaximal_le_lightRayMultiplicativeDirection_mul
      hδ N g hcont ε hε y

/-- The multiplicative selector transfers a linearized `L²` estimate to
the literal light-ray maximal function with its explicit `(1 + ε)` loss. -/
theorem aux_eLpNorm_lightRayMaximal_le_one_add_mul_linearized
    {δ : Real} (hδ : 0 < δ) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε) :
    eLpNorm (lightRayMaximal δ N g) 2 volume ≤
      ENNReal.ofReal (1 + ε) *
        eLpNorm (aux_lightRayLinearizedAverage δ N
          (aux_lightRayMultiplicativeDirection hδ N g hcont ε hε) g) 2 volume := by
  apply eLpNorm_le_mul_eLpNorm_of_ae_le_mul
    (Filter.Eventually.of_forall fun y => ?_) 2
  have hmaxnonneg : 0 ≤ lightRayMaximal δ N g y :=
    aux_lightRayMaximal_nonneg hδ N g
      (fun y => aux_bddAbove_lightRayAverages_of_continuity δ N g hcont y) y
  have hlinearnonneg : 0 ≤ aux_lightRayLinearizedAverage δ N
      (aux_lightRayMultiplicativeDirection hδ N g hcont ε hε) g y := by
    unfold aux_lightRayLinearizedAverage
    exact aux_lightRayAverage_nonneg hδ N
      (aux_lightRayMultiplicativeDirection hδ N g hcont ε hε y) y g
  rw [Real.norm_eq_abs, abs_of_nonneg hmaxnonneg,
    Real.norm_eq_abs, abs_of_nonneg hlinearnonneg]
  exact aux_lightRayMaximal_le_one_add_mul_lightRayLinearizedAverage
    hδ N g hcont ε hε y

/-- If a constant bounds the selected linearization, the preceding theorem
gives the corresponding explicit approximate maximal `L²` bound. -/
theorem aux_eLpNorm_lightRayMaximal_le_one_add_mul_of_selected_bound
    {δ : Real} (hδ : 0 < δ) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε) (A : ENNReal)
    (hbound : eLpNorm (aux_lightRayLinearizedAverage δ N
      (aux_lightRayMultiplicativeDirection hδ N g hcont ε hε) g) 2 volume ≤ A) :
    eLpNorm (lightRayMaximal δ N g) 2 volume ≤ ENNReal.ofReal (1 + ε) * A := by
  refine (aux_eLpNorm_lightRayMaximal_le_one_add_mul_linearized
    hδ N g hcont ε hε).trans ?_
  simpa only [mul_comm] using mul_le_mul_left hbound (ENNReal.ofReal (1 + ε))

/-- A chosen direction realizes the directional supremum when it supplies
the reverse pointwise inequality.  This records the exact logical bridge
needed after proving estimates uniform in all direction-linearizations. -/
theorem aux_lightRayMaximal_eq_linearized_of_pointwise_le
    (δ : Real) (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (g : WaveSpaceTime → Complex)
    (hdirection : ∀ y : Euclidean 2, direction y ∈ unitLightRayDirections)
    (hbounded : ∀ y : Euclidean 2,
      BddAbove ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
        unitLightRayDirections))
    (hselect : ∀ y : Euclidean 2,
      lightRayMaximal δ N g y ≤ aux_lightRayLinearizedAverage δ N direction g y) :
    lightRayMaximal δ N g = aux_lightRayLinearizedAverage δ N direction g := by
  funext y
  exact le_antisymm (hselect y)
    (aux_lightRayLinearizedAverage_le_lightRayMaximal δ N direction g
      hdirection hbounded y)

/-- The measurable-selection statement required to pass from uniform
linearized estimates to the literal directional supremum.  It is only a
target predicate: proving it needs continuity in the direction variable and
a measurable maximum/selection argument, neither of which is supplied by
the tube-overlap estimate itself. -/
def aux_HasLightRayExactSupremumLinearization (δ : Real) (N : Nat)
    (g : WaveSpaceTime → Complex) : Prop :=
  ∃ direction : Euclidean 2 → Euclidean 2,
    AEStronglyMeasurable direction volume ∧
    (∀ y : Euclidean 2, direction y ∈ unitLightRayDirections) ∧
    (∀ y : Euclidean 2,
      BddAbove ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
        unitLightRayDirections)) ∧
    (∀ᵐ y : Euclidean 2 ∂volume,
      lightRayMaximal δ N g y ≤ aux_lightRayLinearizedAverage δ N direction g y)

/-- If the pointwise compact argmax is additionally a.e. measurable,
continuity supplies the exact measurable supremum linearization used by the
linearized TT* argument.  Thus the only unproved selector ingredient is its
measurability, not pointwise attainment. -/
theorem aux_hasLightRayExactSupremumLinearization_of_continuity
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (hmeas : AEStronglyMeasurable
      (aux_lightRayPointwiseMaximizer δ N g hcont) volume) :
    aux_HasLightRayExactSupremumLinearization δ N g := by
  refine ⟨aux_lightRayPointwiseMaximizer δ N g hcont, hmeas,
    aux_lightRayPointwiseMaximizer_mem δ N g hcont, ?_, ?_⟩
  · exact aux_bddAbove_lightRayAverages_of_continuity δ N g hcont
  · filter_upwards with y
    rw [aux_lightRayPointwiseMaximizer_realizes δ N g hcont y]
    rfl

/-- Under an exact measurable supremum linearization, the squared energy of
the literal maximal function is the squared energy of one admissible
linearization.  This is the final selector bridge; it does not claim that
such a selector has yet been constructed. -/
theorem aux_integral_sq_lightRayMaximal_eq_of_exactSupremumLinearization
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hlinearize : aux_HasLightRayExactSupremumLinearization δ N g) :
    ∃ direction : Euclidean 2 → Euclidean 2,
      AEStronglyMeasurable direction volume ∧
      (∀ y : Euclidean 2, direction y ∈ unitLightRayDirections) ∧
      (∫ y, lightRayMaximal δ N g y ^ 2) =
        ∫ y, aux_lightRayLinearizedAverage δ N direction g y ^ 2 := by
  rcases hlinearize with ⟨direction, hmeas, hdirection, hbounded, hselect⟩
  refine ⟨direction, hmeas, hdirection, ?_⟩
  apply integral_congr_ae
  filter_upwards [hselect] with y hy
  have heq : lightRayMaximal δ N g y =
      aux_lightRayLinearizedAverage δ N direction g y :=
    le_antisymm hy
      (aux_lightRayLinearizedAverage_le_lightRayMaximal δ N direction g
        hdirection hbounded y)
  rw [heq]

/-- The exact TT* kernel for a linearized family of light-ray averages.  It
is the smooth intersection integral of the two light-ray tubes terminating
at `y` and `y'`; the time restriction is the same one used by
`lightRayAverage`. -/
noncomputable def aux_lightRayTTStarIntersection (δ : Real) (N : Nat)
    (direction : Euclidean 2 → Euclidean 2) (y y' : Euclidean 2) : Real :=
  ∫ t in lightRayTimeInterval, ∫ x : Euclidean 2,
    lightRayKernel δ N (direction y) y (x, t) *
      lightRayKernel δ N (direction y') y' (x, t)

/-- The TT* tube-intersection kernel is symmetric.  This elementary fact is
why one Schur row estimate is also the corresponding column estimate in the
standard scalar TT* argument. -/
theorem aux_lightRayTTStarIntersection_symm (δ : Real) (N : Nat)
    (direction : Euclidean 2 → Euclidean 2) (y y' : Euclidean 2) :
    aux_lightRayTTStarIntersection δ N direction y y' =
      aux_lightRayTTStarIntersection δ N direction y' y := by
  unfold aux_lightRayTTStarIntersection
  apply integral_congr_ae
  filter_upwards with t
  apply integral_congr_ae
  filter_upwards with x
  ring

/-- The smooth TT* intersection kernel is nonnegative for positive tube
width. -/
theorem aux_lightRayTTStarIntersection_nonneg {δ : Real} (hδ : 0 < δ)
    (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (y y' : Euclidean 2) :
    0 ≤ aux_lightRayTTStarIntersection δ N direction y y' := by
  unfold aux_lightRayTTStarIntersection
  apply integral_nonneg
  intro t
  apply integral_nonneg
  intro x
  exact mul_nonneg
    (lightRayKernel_nonneg hδ N (direction y) y (x, t))
    (lightRayKernel_nonneg hδ N (direction y') y' (x, t))

/-- The positive linear operator underlying a direction-linearized light-ray
average.  It is kept real-valued because the maximal operator acts on the
absolute value of its complex input. -/
noncomputable def aux_lightRayLinearizedOperator (δ : Real) (N : Nat)
    (direction : Euclidean 2 → Euclidean 2)
    (f : WaveSpaceTime → Real) : Euclidean 2 → Real :=
  fun y => ∫ t in lightRayTimeInterval, ∫ x : Euclidean 2,
    lightRayKernel δ N (direction y) y (x, t) * f (x, t)

/-- The original positive linearization is exactly the real operator above
applied to the pointwise complex norm. -/
theorem aux_lightRayLinearizedAverage_eq_operator_norm (δ : Real) (N : Nat)
    (direction : Euclidean 2 → Euclidean 2)
    (g : WaveSpaceTime → Complex) :
    aux_lightRayLinearizedAverage δ N direction g =
      aux_lightRayLinearizedOperator δ N direction (fun z => ‖g z‖) := rfl

/-- The bilinear form pairing the linearized light-ray operator with an
endpoint test function. -/
noncomputable def aux_lightRayLinearizedBilinear (δ : Real) (N : Nat)
    (direction : Euclidean 2 → Euclidean 2) (f : WaveSpaceTime → Real)
    (h : Euclidean 2 → Real) : Real :=
  ∫ y : Euclidean 2, aux_lightRayLinearizedOperator δ N direction f y * h y

/-- The quadratic form of the exact continuum TT* tube-intersection kernel. -/
noncomputable def aux_lightRayTTStarQuadratic (δ : Real) (N : Nat)
    (direction : Euclidean 2 → Euclidean 2)
    (h : Euclidean 2 → Real) : Real :=
  ∫ y : Euclidean 2, ∫ y' : Euclidean 2,
    aux_lightRayTTStarIntersection δ N direction y y' * h y * h y'

/-- The exact geometric Schur input in the continuum TT* proof of the
planar light-ray maximal estimate.  The exponent three is the square of the
`(1 + |log δ|)^(3/2)` factor in `HasLightRayMaximalEstimate`.  This property
contains no analytic conclusion by definition: its proof is precisely the
remaining Córdoba tube-intersection argument. -/
def aux_HasLightRayTTStarIntersectionSchurEstimate : Prop :=
  ∀ N : Nat, 3 < N → ∃ C : Real, 0 < C ∧
    ∀ δ : Real, 0 < δ → δ < 1 / 2 →
      ∀ direction : Euclidean 2 → Euclidean 2,
        (∀ y : Euclidean 2, direction y ∈ unitLightRayDirections) →
        (∀ y : Euclidean 2,
          Integrable (fun y' : Euclidean 2 =>
            aux_lightRayTTStarIntersection δ N direction y y') volume) ∧
        ∀ y : Euclidean 2,
          ∫ y' : Euclidean 2,
            aux_lightRayTTStarIntersection δ N direction y y' ≤
              C ^ 2 * (1 + |Real.log δ|) ^ 3

/-- The scalar Schur calculation for a symmetric nonnegative kernel.  The
integrability assumptions are deliberately displayed: in the light-ray
application they are the Fubini/measurability part of the continuum TT*
argument, whereas the row bound is the genuinely geometric tube-overlap
input. -/
theorem aux_kernelQuadratic_le_of_symmetricSchur
    {X : Type*} [MeasurableSpace X] (μ : Measure X) [SFinite μ]
    (K : X → X → Real)
    (B : Real) (hKnonneg : ∀ x y, 0 ≤ K x y)
    (hKsymm : ∀ x y, K x y = K y x)
    (hrow : ∀ x, Integrable (K x) μ)
    (hrowbound : ∀ x, (∫ y, K x y ∂μ) ≤ B)
    (h : X → Real) (hh : Integrable (fun x => h x ^ 2) μ)
    (hquad : Integrable (fun p : X × X =>
      K p.1 p.2 * h p.1 * h p.2) (μ.prod μ))
    (hleft : Integrable (fun p : X × X =>
      K p.1 p.2 * h p.1 ^ 2) (μ.prod μ))
    (hright : Integrable (fun p : X × X =>
      K p.1 p.2 * h p.2 ^ 2) (μ.prod μ)) :
    (∫ x, ∫ y, K x y * h x * h y ∂μ ∂μ) ≤
      B * ∫ x, h x ^ 2 ∂μ := by
  have hleft_bound :
      (∫ p : X × X, K p.1 p.2 * h p.1 ^ 2 ∂(μ.prod μ)) ≤
        B * ∫ x, h x ^ 2 ∂μ := by
    calc
      (∫ p : X × X, K p.1 p.2 * h p.1 ^ 2 ∂(μ.prod μ)) =
          ∫ x, ∫ y, K x y * h x ^ 2 ∂μ ∂μ :=
        integral_prod _ hleft
      _ ≤ ∫ x, B * h x ^ 2 ∂μ := by
        apply integral_mono hleft.integral_prod_left (hh.const_mul B)
        intro x
        change (∫ y, K x y * h x ^ 2 ∂μ) ≤ B * h x ^ 2
        rw [integral_mul_const_of_integrable (hrow x)]
        exact mul_le_mul_of_nonneg_right (hrowbound x) (sq_nonneg _)
      _ = B * ∫ x, h x ^ 2 ∂μ := by rw [integral_const_mul]
  have hright_bound :
      (∫ p : X × X, K p.1 p.2 * h p.2 ^ 2 ∂(μ.prod μ)) ≤
        B * ∫ x, h x ^ 2 ∂μ := by
    calc
      (∫ p : X × X, K p.1 p.2 * h p.2 ^ 2 ∂(μ.prod μ)) =
          ∫ x, ∫ y, K x y * h y ^ 2 ∂μ ∂μ :=
        integral_prod _ hright
      _ = ∫ y, ∫ x, K x y * h y ^ 2 ∂μ ∂μ :=
        integral_integral_swap hright
      _ ≤ ∫ y, B * h y ^ 2 ∂μ := by
        apply integral_mono hright.integral_prod_right (hh.const_mul B)
        intro y
        change (∫ x, K x y * h y ^ 2 ∂μ) ≤ B * h y ^ 2
        calc
          (∫ x, K x y * h y ^ 2 ∂μ) =
              ∫ x, K y x * h y ^ 2 ∂μ := by
            apply integral_congr_ae
            filter_upwards with x
            rw [hKsymm]
          _ = (∫ x, K y x ∂μ) * h y ^ 2 := by
            rw [integral_mul_const_of_integrable (hrow y)]
          _ ≤ B * h y ^ 2 :=
            mul_le_mul_of_nonneg_right (hrowbound y) (sq_nonneg _)
      _ = B * ∫ y, h y ^ 2 ∂μ := by rw [integral_const_mul]
  have hsum : Integrable (fun p : X × X =>
      K p.1 p.2 * h p.1 ^ 2 + K p.1 p.2 * h p.2 ^ 2) (μ.prod μ) :=
    hleft.add hright
  have hscaled : Integrable (fun p : X × X =>
      (1 / 2 : Real) *
        (K p.1 p.2 * h p.1 ^ 2 + K p.1 p.2 * h p.2 ^ 2)) (μ.prod μ) :=
    hsum.const_mul _
  have hpoint (p : X × X) :
      K p.1 p.2 * h p.1 * h p.2 ≤
        (1 / 2 : Real) *
          (K p.1 p.2 * h p.1 ^ 2 + K p.1 p.2 * h p.2 ^ 2) := by
    have hsquare : 0 ≤ K p.1 p.2 * (h p.1 - h p.2) ^ 2 :=
      mul_nonneg (hKnonneg p.1 p.2) (sq_nonneg _)
    nlinarith
  have hquad_bound :
      (∫ p : X × X, K p.1 p.2 * h p.1 * h p.2 ∂(μ.prod μ)) ≤
        ∫ p : X × X, (1 / 2 : Real) *
          (K p.1 p.2 * h p.1 ^ 2 + K p.1 p.2 * h p.2 ^ 2) ∂(μ.prod μ) :=
    integral_mono hquad hscaled hpoint
  calc
    (∫ x, ∫ y, K x y * h x * h y ∂μ ∂μ) =
        ∫ p : X × X, K p.1 p.2 * h p.1 * h p.2 ∂(μ.prod μ) :=
      (integral_prod _ hquad).symm
    _ ≤ ∫ p : X × X, (1 / 2 : Real) *
        (K p.1 p.2 * h p.1 ^ 2 + K p.1 p.2 * h p.2 ^ 2) ∂(μ.prod μ) :=
      hquad_bound
    _ = (1 / 2 : Real) *
        ((∫ p : X × X, K p.1 p.2 * h p.1 ^ 2 ∂(μ.prod μ)) +
          ∫ p : X × X, K p.1 p.2 * h p.2 ^ 2 ∂(μ.prod μ)) := by
      rw [integral_const_mul, integral_add hleft hright]
    _ ≤ (1 / 2 : Real) *
        (B * (∫ x, h x ^ 2 ∂μ) + B * (∫ x, h x ^ 2 ∂μ)) := by
      exact mul_le_mul_of_nonneg_left (add_le_add hleft_bound hright_bound) (by norm_num)
    _ = B * ∫ x, h x ^ 2 ∂μ := by ring

/-- Specialization of the scalar Schur calculation to the literal
light-ray tube-intersection kernel.  Only the displayed product
integrability hypotheses remain analytic; the row estimate is exactly the
geometric Kakeya input. -/
theorem aux_lightRayTTStarQuadratic_le_of_rowSchur {δ : Real} (hδ : 0 < δ)
    (N : Nat) (direction : Euclidean 2 → Euclidean 2) (B : Real)
    (hrow : ∀ y : Euclidean 2,
      Integrable (fun y' : Euclidean 2 =>
        aux_lightRayTTStarIntersection δ N direction y y') volume)
    (hrowbound : ∀ y : Euclidean 2,
      (∫ y' : Euclidean 2,
        aux_lightRayTTStarIntersection δ N direction y y') ≤ B)
    (h : Euclidean 2 → Real)
    (hh : Integrable (fun y => h y ^ 2) volume)
    (hquad : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 * h p.1 * h p.2)
      (volume.prod volume))
    (hleft : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 * h p.1 ^ 2)
      (volume.prod volume))
    (hright : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 * h p.2 ^ 2)
      (volume.prod volume)) :
    aux_lightRayTTStarQuadratic δ N direction h ≤
      B * ∫ y, h y ^ 2 := by
  unfold aux_lightRayTTStarQuadratic
  exact aux_kernelQuadratic_le_of_symmetricSchur volume
    (aux_lightRayTTStarIntersection δ N direction) B
    (fun y y' => aux_lightRayTTStarIntersection_nonneg hδ N direction y y')
    (aux_lightRayTTStarIntersection_symm δ N direction) hrow hrowbound h hh
    hquad hleft hright

/-- The global geometric Schur predicate supplies the preceding quadratic
bound with its stated logarithmic constant. -/
theorem aux_lightRayTTStarQuadratic_le_of_HasLightRayTTStarIntersectionSchurEstimate
    (hSchur : aux_HasLightRayTTStarIntersectionSchurEstimate)
    (N : Nat) (hN : 3 < N) {δ : Real} (hδ : 0 < δ) (hδsmall : δ < 1 / 2)
    (direction : Euclidean 2 → Euclidean 2)
    (hdirection : ∀ y : Euclidean 2, direction y ∈ unitLightRayDirections)
    (h : Euclidean 2 → Real)
    (hh : Integrable (fun y => h y ^ 2) volume)
    (hquad : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 * h p.1 * h p.2)
      (volume.prod volume))
    (hleft : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 * h p.1 ^ 2)
      (volume.prod volume))
    (hright : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 * h p.2 ^ 2)
      (volume.prod volume)) :
    ∃ C : Real, 0 < C ∧
      aux_lightRayTTStarQuadratic δ N direction h ≤
        (C ^ 2 * (1 + |Real.log δ|) ^ 3) * ∫ y, h y ^ 2 := by
  rcases hSchur N hN with ⟨C, hC, hCbound⟩
  refine ⟨C, hC, ?_⟩
  rcases hCbound δ hδ hδsmall direction hdirection with ⟨hrow, hrowbound⟩
  exact aux_lightRayTTStarQuadratic_le_of_rowSchur hδ N direction
    (C ^ 2 * (1 + |Real.log δ|) ^ 3) hrow hrowbound h hh hquad hleft hright

/-- The precise Cauchy--Schwarz/Fubini identity needed to pass from the
linearized operator to its TT* intersection kernel.  This is not assumed by
the geometric Schur predicate: it isolates the remaining analytic
factorization in a form that can be proved once joint measurability of a
chosen direction field is available. -/
def aux_HasLightRayLinearizedTTStarCauchy (δ : Real) (N : Nat)
    (direction : Euclidean 2 → Euclidean 2) : Prop :=
  ∀ (f : WaveSpaceTime → Real) (h : Euclidean 2 → Real),
    Integrable (fun z => f z ^ 2) volume →
    Integrable (fun y => h y ^ 2) volume →
    |aux_lightRayLinearizedBilinear δ N direction f h| ^ 2 ≤
      (∫ z, f z ^ 2) * aux_lightRayTTStarQuadratic δ N direction h

/-- Once the exact TT* Cauchy factorization and the Schur quadratic bound
are available, the scalar cancellation argument gives the linearized
`L²` energy bound.  No maximal-function selection is used here. -/
theorem aux_lightRayLinearizedEnergy_le_of_ttStar
    (δ : Real) (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (B : Real) (hB : 0 ≤ B)
    (hTTStar : aux_HasLightRayLinearizedTTStarCauchy δ N direction)
    (f : WaveSpaceTime → Real)
    (hf : Integrable (fun z => f z ^ 2) volume)
    (hout : Integrable (fun y =>
      aux_lightRayLinearizedOperator δ N direction f y ^ 2) volume)
    (hquadratic : aux_lightRayTTStarQuadratic δ N direction
      (aux_lightRayLinearizedOperator δ N direction f) ≤
        B * ∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) :
    (∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) ≤
      B * ∫ z, f z ^ 2 := by
  have hin_nonneg : 0 ≤ ∫ z, f z ^ 2 :=
    integral_nonneg fun _ => sq_nonneg _
  have hout_nonneg : 0 ≤ ∫ y,
      aux_lightRayLinearizedOperator δ N direction f y ^ 2 :=
    integral_nonneg fun _ => sq_nonneg _
  have hdiagonal :
      aux_lightRayLinearizedBilinear δ N direction f
        (aux_lightRayLinearizedOperator δ N direction f) =
        ∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2 := by
    simp only [aux_lightRayLinearizedBilinear, pow_two]
  have hCauchy := hTTStar f (aux_lightRayLinearizedOperator δ N direction f) hf hout
  rw [hdiagonal, abs_of_nonneg hout_nonneg] at hCauchy
  have hmult :
      (∫ z, f z ^ 2) *
          aux_lightRayTTStarQuadratic δ N direction
            (aux_lightRayLinearizedOperator δ N direction f) ≤
        (∫ z, f z ^ 2) *
          (B * ∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) :=
    mul_le_mul_of_nonneg_left hquadratic hin_nonneg
  have hsq :
      (∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) ^ 2 ≤
        (∫ z, f z ^ 2) *
          (B * ∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) :=
    hCauchy.trans hmult
  by_cases hzero : (∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) = 0
  · rw [hzero]
    exact mul_nonneg hB hin_nonneg
  · have hpos : 0 < ∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2 :=
      lt_of_le_of_ne hout_nonneg (Ne.symm hzero)
    apply le_of_mul_le_mul_right _ hpos
    calc
      (∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) *
          (∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) =
          (∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) ^ 2 := by ring
      _ ≤ (∫ z, f z ^ 2) *
          (B * ∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) := hsq
      _ = (B * ∫ z, f z ^ 2) *
          (∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) := by ring

/-- Conversion of the squared-energy conclusion into the usual extended
`L²` norm.  The square-root constant is kept literal so this lemma is
independent of any later simplification of the logarithmic power. -/
theorem aux_eLpNorm_lightRayLinearizedOperator_le_of_energy
    (δ : Real) (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (B : Real) (hB : 0 ≤ B) (f : WaveSpaceTime → Real)
    (hf : MemLp f 2 volume)
    (hout : MemLp (aux_lightRayLinearizedOperator δ N direction f) 2 volume)
    (henergy : (∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) ≤
      B * ∫ z, f z ^ 2) :
    eLpNorm (aux_lightRayLinearizedOperator δ N direction f) 2 volume ≤
      ENNReal.ofReal (Real.sqrt B) * eLpNorm f 2 volume := by
  let Iout : Real := ∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2
  let Iin : Real := ∫ z, f z ^ 2
  have hroot : Real.sqrt Iout ≤ Real.sqrt B * Real.sqrt Iin := by
    calc
      Real.sqrt Iout ≤ Real.sqrt (B * Iin) := Real.sqrt_le_sqrt (by
        simpa only [Iout, Iin] using henergy)
      _ = Real.sqrt B * Real.sqrt Iin := Real.sqrt_mul hB Iin
  have hrpow : Iout ^ (2 : Real)⁻¹ ≤
      Real.sqrt B * Iin ^ (2 : Real)⁻¹ := by
    rw [show (2 : Real)⁻¹ = 1 / 2 by norm_num, ← Real.sqrt_eq_rpow,
      ← Real.sqrt_eq_rpow]
    exact hroot
  have hnormout :
      eLpNorm (aux_lightRayLinearizedOperator δ N direction f) 2 volume =
        ENNReal.ofReal (Iout ^ (2 : Real)⁻¹) := by
    rw [hout.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    norm_num [Iout, Real.norm_eq_abs]
  have hnormin : eLpNorm f 2 volume =
      ENNReal.ofReal (Iin ^ (2 : Real)⁻¹) := by
    rw [hf.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    norm_num [Iin, Real.norm_eq_abs]
  rw [hnormout, hnormin]
  calc
    ENNReal.ofReal (Iout ^ (2 : Real)⁻¹) ≤
        ENNReal.ofReal (Real.sqrt B * Iin ^ (2 : Real)⁻¹) :=
      ENNReal.ofReal_le_ofReal hrpow
    _ = ENNReal.ofReal (Real.sqrt B) *
        ENNReal.ofReal (Iin ^ (2 : Real)⁻¹) :=
      ENNReal.ofReal_mul (Real.sqrt_nonneg _)

/-- The preceding norm conversion in the original complex-input notation
for a light-ray linearized average. -/
theorem aux_eLpNorm_lightRayLinearizedAverage_le_of_energy
    (δ : Real) (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (B : Real) (hB : 0 ≤ B) (g : WaveSpaceTime → Complex)
    (hg : MemLp g 2 volume)
    (hout : MemLp (aux_lightRayLinearizedAverage δ N direction g) 2 volume)
    (henergy : (∫ y, aux_lightRayLinearizedAverage δ N direction g y ^ 2) ≤
      B * ∫ z, ‖g z‖ ^ 2) :
    eLpNorm (aux_lightRayLinearizedAverage δ N direction g) 2 volume ≤
      ENNReal.ofReal (Real.sqrt B) * eLpNorm g 2 volume := by
  have hgnorm : MemLp (fun z => ‖g z‖) 2 volume := by
    simpa using hg.norm
  simpa only [aux_lightRayLinearizedAverage_eq_operator_norm, eLpNorm_norm] using
    (aux_eLpNorm_lightRayLinearizedOperator_le_of_energy δ N direction B hB
      (fun z => ‖g z‖) hgnorm
      (by simpa only [aux_lightRayLinearizedAverage_eq_operator_norm] using hout)
      (by simpa only [aux_lightRayLinearizedAverage_eq_operator_norm] using henergy))

/-- The continuum TT* Schur predicate, together with its explicit
Fubini/Cauchy hypotheses, yields the stated logarithmic `L²` energy bound
for every measurable-direction linearization. -/
theorem aux_lightRayLinearizedEnergy_le_of_HasLightRayTTStarIntersectionSchurEstimate
    (hSchur : aux_HasLightRayTTStarIntersectionSchurEstimate)
    (N : Nat) (hN : 3 < N) {δ : Real} (hδ : 0 < δ) (hδsmall : δ < 1 / 2)
    (direction : Euclidean 2 → Euclidean 2)
    (hdirection : ∀ y : Euclidean 2, direction y ∈ unitLightRayDirections)
    (hTTStar : aux_HasLightRayLinearizedTTStarCauchy δ N direction)
    (f : WaveSpaceTime → Real)
    (hf : Integrable (fun z => f z ^ 2) volume)
    (hout : Integrable (fun y =>
      aux_lightRayLinearizedOperator δ N direction f y ^ 2) volume)
    (hquad : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 *
        aux_lightRayLinearizedOperator δ N direction f p.1 *
        aux_lightRayLinearizedOperator δ N direction f p.2) (volume.prod volume))
    (hleft : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 *
        aux_lightRayLinearizedOperator δ N direction f p.1 ^ 2)
      (volume.prod volume))
    (hright : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 *
        aux_lightRayLinearizedOperator δ N direction f p.2 ^ 2)
      (volume.prod volume)) :
    ∃ C : Real, 0 < C ∧
      (∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) ≤
        (C ^ 2 * (1 + |Real.log δ|) ^ 3) * ∫ z, f z ^ 2 := by
  rcases hSchur N hN with ⟨C, hC, hCbound⟩
  refine ⟨C, hC, ?_⟩
  rcases hCbound δ hδ hδsmall direction hdirection with ⟨hrow, hrowbound⟩
  refine aux_lightRayLinearizedEnergy_le_of_ttStar δ N direction
    (C ^ 2 * (1 + |Real.log δ|) ^ 3) (by positivity) hTTStar f hf hout ?_
  exact aux_lightRayTTStarQuadratic_le_of_rowSchur hδ N direction
      (C ^ 2 * (1 + |Real.log δ|) ^ 3) hrow hrowbound
      (aux_lightRayLinearizedOperator δ N direction f) hout hquad hleft hright

/-- Direct extended-`L²` consequence of the continuum intersection Schur
predicate for one measurable-direction light-ray linearization.  The
square-root factor is exactly the TT* square root; the remaining hypotheses
are the explicitly exposed Fubini/Cauchy layer. -/
theorem aux_eLpNorm_lightRayLinearizedAverage_le_of_HasLightRayTTStarIntersectionSchurEstimate
    (hSchur : aux_HasLightRayTTStarIntersectionSchurEstimate)
    (N : Nat) (hN : 3 < N) {δ : Real} (hδ : 0 < δ) (hδsmall : δ < 1 / 2)
    (direction : Euclidean 2 → Euclidean 2)
    (hdirection : ∀ y : Euclidean 2, direction y ∈ unitLightRayDirections)
    (hTTStar : aux_HasLightRayLinearizedTTStarCauchy δ N direction)
    (g : WaveSpaceTime → Complex) (hg : MemLp g 2 volume)
    (hout : MemLp (aux_lightRayLinearizedAverage δ N direction g) 2 volume)
    (houtEnergy : Integrable (fun y =>
      aux_lightRayLinearizedAverage δ N direction g y ^ 2) volume)
    (hquad : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 *
        aux_lightRayLinearizedAverage δ N direction g p.1 *
        aux_lightRayLinearizedAverage δ N direction g p.2) (volume.prod volume))
    (hleft : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 *
        aux_lightRayLinearizedAverage δ N direction g p.1 ^ 2)
      (volume.prod volume))
    (hright : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 *
        aux_lightRayLinearizedAverage δ N direction g p.2 ^ 2)
      (volume.prod volume)) :
    ∃ C : Real, 0 < C ∧
      eLpNorm (aux_lightRayLinearizedAverage δ N direction g) 2 volume ≤
        ENNReal.ofReal
          (Real.sqrt (C ^ 2 * (1 + |Real.log δ|) ^ 3)) * eLpNorm g 2 volume := by
  have hgnorm : MemLp (fun z => ‖g z‖) 2 volume := by
    simpa using hg.norm
  have hinputEnergy : Integrable (fun z => ‖g z‖ ^ 2) volume := by
    have hsq := (memLp_two_iff_integrable_sq_norm hgnorm.aestronglyMeasurable).mp hgnorm
    simpa only [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)] using hsq
  have houtOperator : Integrable (fun y =>
      aux_lightRayLinearizedOperator δ N direction (fun z => ‖g z‖) y ^ 2)
      volume := by
    simpa only [← aux_lightRayLinearizedAverage_eq_operator_norm] using houtEnergy
  rcases aux_lightRayLinearizedEnergy_le_of_HasLightRayTTStarIntersectionSchurEstimate
      hSchur N hN hδ hδsmall direction hdirection hTTStar (fun z => ‖g z‖)
      hinputEnergy houtOperator
      (by simpa only [← aux_lightRayLinearizedAverage_eq_operator_norm] using hquad)
      (by simpa only [← aux_lightRayLinearizedAverage_eq_operator_norm] using hleft)
      (by simpa only [← aux_lightRayLinearizedAverage_eq_operator_norm] using hright) with
      ⟨C, hC, henergy⟩
  refine ⟨C, hC, ?_⟩
  exact aux_eLpNorm_lightRayLinearizedAverage_le_of_energy δ N direction
    (C ^ 2 * (1 + |Real.log δ|) ^ 3) (by positivity) g hg hout
    (by simpa only [← aux_lightRayLinearizedAverage_eq_operator_norm] using henergy)

/-- The sharp planar Nikodym--Kakeya input required by the MSS proof.  This
is recorded as the exact quantitative target for the preceding continuum
operator; no instance is introduced here, since its proof is the remaining
non-elementary geometric stage. -/
def HasLightRayMaximalEstimate : Prop :=
  ∀ N : Nat, 3 < N → ∃ C : Real, 0 < C ∧
    ∀ δ : Real, 0 < δ → δ < 1 / 2 →
      ∀ g : WaveSpaceTime → Complex, MemLp g 2 volume →
        eLpNorm (lightRayMaximal δ N g) 2 volume ≤
          ENNReal.ofReal (C * (1 + |Real.log δ|) ^ (3 / 2 : Real)) *
            eLpNorm g 2 volume

private theorem sq_norm_integral_le_weightedEnergy
    (K : Euclidean 2 → Complex) (w : Euclidean 2 → Real)
    (hwpos : ∀ y, 0 < w y)
    (henergy : Integrable (fun y => (w y)⁻¹ * ‖K y‖ ^ 2) volume)
    (hmass : Integrable w volume) :
    ‖∫ y : Euclidean 2, K y‖ ^ 2 ≤
      (∫ y : Euclidean 2, (w y)⁻¹ * ‖K y‖ ^ 2) *
        ∫ y : Euclidean 2, w y := by
  let F : Euclidean 2 → Real := fun y => Real.sqrt ((w y)⁻¹ * ‖K y‖ ^ 2)
  let G : Euclidean 2 → Real := fun y => Real.sqrt (w y)
  have hFmeas : AEStronglyMeasurable F volume := by
    exact Real.continuous_sqrt.comp_aestronglyMeasurable henergy.aestronglyMeasurable
  have hGmeas : AEStronglyMeasurable G volume := by
    exact Real.continuous_sqrt.comp_aestronglyMeasurable hmass.aestronglyMeasurable
  have hFsq : Integrable (fun y => F y ^ 2) volume := by
    refine henergy.congr ?_
    filter_upwards with y
    dsimp only [F]
    exact (Real.sq_sqrt (mul_nonneg (inv_nonneg.mpr (hwpos y).le) (sq_nonneg _))).symm
  have hGsq : Integrable (fun y => G y ^ 2) volume := by
    refine hmass.congr ?_
    filter_upwards with y
    dsimp only [G]
    exact (Real.sq_sqrt (hwpos y).le).symm
  have hFmem : MemLp F 2 volume :=
    (memLp_two_iff_integrable_sq hFmeas).mpr hFsq
  have hGmem : MemLp G 2 volume :=
    (memLp_two_iff_integrable_sq hGmeas).mpr hGsq
  have hFmem' : MemLp F (ENNReal.ofReal 2) volume := by
    norm_num
    exact hFmem
  have hGmem' : MemLp G (ENNReal.ofReal 2) volume := by
    norm_num
    exact hGmem
  have hholder := integral_mul_le_Lp_mul_Lq_of_nonneg (f := F) (g := G)
    Real.HolderConjugate.two_two
    (Eventually.of_forall fun y => Real.sqrt_nonneg _)
    (Eventually.of_forall fun y => Real.sqrt_nonneg _) hFmem' hGmem'
  have hleft : (fun y : Euclidean 2 => ‖K y‖) = fun y => F y * G y := by
    funext y
    dsimp only [F, G]
    have hroot : Real.sqrt (w y) ≠ 0 := ne_of_gt (Real.sqrt_pos.2 (hwpos y))
    symm
    calc
      Real.sqrt ((w y)⁻¹ * ‖K y‖ ^ 2) * Real.sqrt (w y) =
          (Real.sqrt (w y))⁻¹ * Real.sqrt (‖K y‖ ^ 2) * Real.sqrt (w y) := by
        rw [Real.sqrt_mul (inv_nonneg.mpr (hwpos y).le), Real.sqrt_inv]
      _ = ‖K y‖ := by
        rw [Real.sqrt_sq (norm_nonneg _)]
        field_simp
  have hFint : (∫ y : Euclidean 2, F y ^ 2) =
      ∫ y : Euclidean 2, (w y)⁻¹ * ‖K y‖ ^ 2 := by
    apply integral_congr_ae
    filter_upwards with y
    dsimp only [F]
    exact Real.sq_sqrt (mul_nonneg (inv_nonneg.mpr (hwpos y).le) (sq_nonneg _))
  have hGint : (∫ y : Euclidean 2, G y ^ 2) = ∫ y : Euclidean 2, w y := by
    apply integral_congr_ae
    filter_upwards with y
    dsimp only [G]
    exact Real.sq_sqrt (hwpos y).le
  have hcs : ‖∫ y : Euclidean 2, K y‖ ≤
      Real.sqrt (∫ y : Euclidean 2, (w y)⁻¹ * ‖K y‖ ^ 2) *
        Real.sqrt (∫ y : Euclidean 2, w y) := by
    calc
      ‖∫ y : Euclidean 2, K y‖ ≤ ∫ y : Euclidean 2, ‖K y‖ :=
        norm_integral_le_integral_norm _
      _ = ∫ y : Euclidean 2, F y * G y := by rw [hleft]
      _ ≤ (∫ y : Euclidean 2, F y ^ (2 : Real)) ^ (1 / (2 : Real)) *
          (∫ y : Euclidean 2, G y ^ (2 : Real)) ^ (1 / (2 : Real)) := hholder
      _ = Real.sqrt (∫ y : Euclidean 2, (w y)⁻¹ * ‖K y‖ ^ 2) *
          Real.sqrt (∫ y : Euclidean 2, w y) := by
        rw [show (fun y : Euclidean 2 => F y ^ (2 : Real)) = fun y => F y ^ 2 by
              funext y; rw [Real.rpow_two],
            show (fun y : Euclidean 2 => G y ^ (2 : Real)) = fun y => G y ^ 2 by
              funext y; rw [Real.rpow_two], hFint, hGint,
            Real.sqrt_eq_rpow, Real.sqrt_eq_rpow]
  have hright : 0 ≤ Real.sqrt (∫ y : Euclidean 2, (w y)⁻¹ * ‖K y‖ ^ 2) *
      Real.sqrt (∫ y : Euclidean 2, w y) :=
    mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
  calc
    ‖∫ y : Euclidean 2, K y‖ ^ 2 ≤
        (Real.sqrt (∫ y : Euclidean 2, (w y)⁻¹ * ‖K y‖ ^ 2) *
          Real.sqrt (∫ y : Euclidean 2, w y)) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) hright).mpr hcs
    _ = (∫ y : Euclidean 2, (w y)⁻¹ * ‖K y‖ ^ 2) *
        ∫ y : Euclidean 2, w y := by
      rw [mul_pow, Real.sq_sqrt (integral_nonneg fun y =>
        mul_nonneg (inv_nonneg.mpr (hwpos y).le) (sq_nonneg _)),
        Real.sq_sqrt (integral_nonneg fun y => (hwpos y).le)]

private theorem lightRayKernel_pos {δ : Real} (hδ : 0 < δ) (N : Nat)
    (ω y : Euclidean 2) (z : WaveSpaceTime) :
    0 < lightRayKernel δ N ω y z := by
  unfold lightRayKernel
  positivity

/-- A continuum kernel Cauchy--Schwarz bound for one localized fine piece. -/
theorem sq_norm_continuumFineKernelTerm_le_lightRayEnergy
    {δ A : Real} (hδ : 0 < δ) (N : Nat)
    (ω : Euclidean 2) (kernel : WaveSpaceTime → Euclidean 2 → Complex)
    (input : Euclidean 2 → Complex)
    (hkernel : ∀ z y, ‖kernel z y‖ ≤ lightRayKernel δ N ω y z)
    (hmass : ∀ z, Integrable (fun y : Euclidean 2 =>
      lightRayKernel δ N ω y z) volume ∧
      (∫ y : Euclidean 2, lightRayKernel δ N ω y z) ≤ A)
    (hmeas : ∀ z, AEStronglyMeasurable (fun y : Euclidean 2 =>
      (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y * input y‖ ^ 2) volume)
    (henergy : ∀ z, Integrable (fun y : Euclidean 2 =>
      lightRayKernel δ N ω y z * ‖input y‖ ^ 2) volume)
    (z : WaveSpaceTime) :
    ‖∫ y : Euclidean 2, kernel z y * input y‖ ^ 2 ≤
      A * ∫ y : Euclidean 2,
        lightRayKernel δ N ω y z * ‖input y‖ ^ 2 := by
  have hInvInt : Integrable (fun y : Euclidean 2 =>
      (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y * input y‖ ^ 2) volume := by
    apply (henergy z).mono' (hmeas z)
    filter_upwards with y
    have hLpos : 0 < lightRayKernel δ N ω y z := lightRayKernel_pos hδ N ω y z
    have hKsquared : ‖kernel z y‖ ^ 2 ≤ (lightRayKernel δ N ω y z) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) hLpos.le).mpr (hkernel z y)
    have hinner : (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y‖ ^ 2 ≤
        lightRayKernel δ N ω y z := by
      calc
        (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y‖ ^ 2 ≤
            (lightRayKernel δ N ω y z)⁻¹ * (lightRayKernel δ N ω y z) ^ 2 :=
          mul_le_mul_of_nonneg_left hKsquared (inv_nonneg.mpr hLpos.le)
        _ = lightRayKernel δ N ω y z := by
          field_simp [hLpos.ne']
    calc
      ‖(lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y * input y‖ ^ 2‖ =
          (lightRayKernel δ N ω y z)⁻¹ * (‖kernel z y‖ ^ 2 * ‖input y‖ ^ 2) := by
        rw [Real.norm_eq_abs,
          abs_of_nonneg (mul_nonneg (inv_nonneg.mpr hLpos.le) (sq_nonneg _)), norm_mul]
        ring
      _ = ((lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y‖ ^ 2) * ‖input y‖ ^ 2 := by
        ring
      _ ≤ lightRayKernel δ N ω y z * ‖input y‖ ^ 2 :=
        mul_le_mul_of_nonneg_right hinner (sq_nonneg _)
  have hbase := sq_norm_integral_le_weightedEnergy
    (fun y : Euclidean 2 => kernel z y * input y)
    (fun y : Euclidean 2 => lightRayKernel δ N ω y z)
    (fun y => lightRayKernel_pos hδ N ω y z) hInvInt (hmass z).1
  have hInvBound :
      (∫ y : Euclidean 2,
        (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y * input y‖ ^ 2) ≤
        ∫ y : Euclidean 2,
          lightRayKernel δ N ω y z * ‖input y‖ ^ 2 := by
    apply integral_mono hInvInt (henergy z)
    intro y
    have hLpos : 0 < lightRayKernel δ N ω y z := lightRayKernel_pos hδ N ω y z
    have hKsquared : ‖kernel z y‖ ^ 2 ≤ (lightRayKernel δ N ω y z) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) hLpos.le).mpr (hkernel z y)
    have hinner : (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y‖ ^ 2 ≤
        lightRayKernel δ N ω y z := by
      calc
        (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y‖ ^ 2 ≤
            (lightRayKernel δ N ω y z)⁻¹ * (lightRayKernel δ N ω y z) ^ 2 :=
          mul_le_mul_of_nonneg_left hKsquared (inv_nonneg.mpr hLpos.le)
        _ = lightRayKernel δ N ω y z := by
          field_simp [hLpos.ne']
    calc
      (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y * input y‖ ^ 2 =
          ((lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y‖ ^ 2) * ‖input y‖ ^ 2 := by
        rw [norm_mul]
        ring
      _ ≤ lightRayKernel δ N ω y z * ‖input y‖ ^ 2 :=
        mul_le_mul_of_nonneg_right hinner (sq_nonneg _)
  have hMassNonneg : 0 ≤ ∫ y : Euclidean 2, lightRayKernel δ N ω y z :=
    integral_nonneg fun y => lightRayKernel_nonneg hδ N ω y z
  have hEnergyNonneg : 0 ≤ ∫ y : Euclidean 2,
      lightRayKernel δ N ω y z * ‖input y‖ ^ 2 :=
    integral_nonneg fun y => mul_nonneg (lightRayKernel_nonneg hδ N ω y z) (sq_nonneg _)
  calc
    ‖∫ y : Euclidean 2, kernel z y * input y‖ ^ 2 ≤
        (∫ y : Euclidean 2,
          (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y * input y‖ ^ 2) *
          ∫ y : Euclidean 2, lightRayKernel δ N ω y z := hbase
    _ ≤ (∫ y : Euclidean 2,
          lightRayKernel δ N ω y z * ‖input y‖ ^ 2) *
          ∫ y : Euclidean 2, lightRayKernel δ N ω y z :=
      mul_le_mul_of_nonneg_right hInvBound hMassNonneg
    _ ≤ (∫ y : Euclidean 2,
          lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * A :=
      mul_le_mul_of_nonneg_left (hmass z).2 hEnergyNonneg
    _ = A * ∫ y : Euclidean 2,
          lightRayKernel δ N ω y z * ‖input y‖ ^ 2 := by ring

/-- The product measure corresponding to the literal time-restricted
space-time integration in a light-ray average. -/
noncomputable def continuumLightRayMeasure : Measure WaveSpaceTime :=
  (volume : Measure (Euclidean 2)).prod
    ((volume : Measure Real).restrict lightRayTimeInterval)

private theorem integral_lightRayKernel_mul_norm_eq_lightRayAverage
    (δ : Real) (N : Nat) (ω y : Euclidean 2)
    (g : WaveSpaceTime → Complex)
    (hprod : Integrable (fun z : WaveSpaceTime =>
      lightRayKernel δ N ω y z * ‖g z‖) continuumLightRayMeasure) :
    (∫ z : WaveSpaceTime,
      lightRayKernel δ N ω y z * ‖g z‖ ∂continuumLightRayMeasure) =
      lightRayAverage δ N ω y g := by
  unfold continuumLightRayMeasure
  calc
    (∫ z : WaveSpaceTime,
        lightRayKernel δ N ω y z * ‖g z‖
        ∂(volume : Measure (Euclidean 2)).prod
          ((volume : Measure Real).restrict lightRayTimeInterval)) =
      ∫ x : Euclidean 2, ∫ t : Real in lightRayTimeInterval,
        lightRayKernel δ N ω y (x, t) * ‖g (x, t)‖ :=
      integral_prod _ hprod
    _ = ∫ t : Real in lightRayTimeInterval, ∫ x : Euclidean 2,
        lightRayKernel δ N ω y (x, t) * ‖g (x, t)‖ :=
      integral_integral_swap hprod
    _ = lightRayAverage δ N ω y g := rfl

private theorem integral_lightRayEnergy_transpose
    (δ : Real) (N : Nat) (ω : Euclidean 2)
    (input : Euclidean 2 → Complex) (g : WaveSpaceTime → Complex)
    (henergy : ∀ z : WaveSpaceTime, Integrable (fun y : Euclidean 2 =>
      lightRayKernel δ N ω y z * ‖input y‖ ^ 2) volume)
    (hprod : Integrable (fun p : WaveSpaceTime × Euclidean 2 =>
      lightRayKernel δ N ω p.2 p.1 * ‖input p.2‖ ^ 2 * ‖g p.1‖)
      (continuumLightRayMeasure.prod volume)) :
    (∫ z : WaveSpaceTime,
      (∫ y : Euclidean 2,
        lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖
      ∂continuumLightRayMeasure) =
      ∫ y : Euclidean 2, ‖input y‖ ^ 2 *
        (∫ z : WaveSpaceTime,
          lightRayKernel δ N ω y z * ‖g z‖
          ∂continuumLightRayMeasure) := by
  letI : SFinite continuumLightRayMeasure := by
    unfold continuumLightRayMeasure
    infer_instance
  calc
      (∫ z : WaveSpaceTime,
        (∫ y : Euclidean 2,
          lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖
        ∂continuumLightRayMeasure) =
        (∫ z : WaveSpaceTime, (∫ y : Euclidean 2,
          (lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖)
          ∂continuumLightRayMeasure) := by
          apply integral_congr_ae
          filter_upwards with z
          rw [integral_mul_const_of_integrable (henergy z)]
    _ = (∫ y : Euclidean 2, (∫ z : WaveSpaceTime,
          (lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖
          ∂continuumLightRayMeasure)) := integral_integral_swap hprod
    _ = ∫ y : Euclidean 2, ‖input y‖ ^ 2 *
          (∫ z : WaveSpaceTime,
            lightRayKernel δ N ω y z * ‖g z‖
            ∂continuumLightRayMeasure) := by
      apply integral_congr_ae
      filter_upwards with y
      calc
        (∫ z : WaveSpaceTime,
            (lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖
            ∂continuumLightRayMeasure) =
            ∫ z : WaveSpaceTime,
              ‖input y‖ ^ 2 * (lightRayKernel δ N ω y z * ‖g z‖)
              ∂continuumLightRayMeasure := by
          apply integral_congr_ae
          filter_upwards with z
          ring
        _ = ‖input y‖ ^ 2 *
            (∫ z : WaveSpaceTime,
              lightRayKernel δ N ω y z * ‖g z‖
              ∂continuumLightRayMeasure) :=
          integral_const_mul _ _

/-- A genuine continuum version of the fine-cube kernel transposition step.
The hypotheses are the literal measurable/Fubini conditions required to turn
pointwise light-ray kernel localization into a weighted light-ray maximal
bound; no finite sampling or hidden Kakeya assertion is used. -/
theorem continuumFineKernelWeightedPairing_le_lightRayMaximal
    {δ A : Real} (hδ : 0 < δ) (hA : 0 ≤ A) (N : Nat)
    (ω : Euclidean 2) (hω : ω ∈ unitLightRayDirections)
    (kernel : WaveSpaceTime → Euclidean 2 → Complex)
    (input : Euclidean 2 → Complex) (g : WaveSpaceTime → Complex)
    (hkernel : ∀ z y, ‖kernel z y‖ ≤ lightRayKernel δ N ω y z)
    (hmass : ∀ z, Integrable (fun y : Euclidean 2 =>
      lightRayKernel δ N ω y z) volume ∧
      (∫ y : Euclidean 2, lightRayKernel δ N ω y z) ≤ A)
    (hmeas : ∀ z, AEStronglyMeasurable (fun y : Euclidean 2 =>
      (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y * input y‖ ^ 2) volume)
    (henergy : ∀ z, Integrable (fun y : Euclidean 2 =>
      lightRayKernel δ N ω y z * ‖input y‖ ^ 2) volume)
    (htermWeighted : Integrable (fun z : WaveSpaceTime =>
      ‖∫ y : Euclidean 2, kernel z y * input y‖ ^ 2 * ‖g z‖)
      continuumLightRayMeasure)
    (henergyWeighted : Integrable (fun z : WaveSpaceTime =>
      (∫ y : Euclidean 2,
        lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖)
      continuumLightRayMeasure)
    (hprod : Integrable (fun p : WaveSpaceTime × Euclidean 2 =>
      lightRayKernel δ N ω p.2 p.1 * ‖input p.2‖ ^ 2 * ‖g p.1‖)
      (continuumLightRayMeasure.prod volume))
    (hRayInt : ∀ y : Euclidean 2, Integrable (fun z : WaveSpaceTime =>
      lightRayKernel δ N ω y z * ‖g z‖) continuumLightRayMeasure)
    (hbounded : ∀ y : Euclidean 2,
      BddAbove ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
        unitLightRayDirections))
    (hmaxWeighted : Integrable (fun y : Euclidean 2 =>
      ‖input y‖ ^ 2 * lightRayMaximal δ N g y) volume) :
    (∫ z : WaveSpaceTime,
      ‖∫ y : Euclidean 2, kernel z y * input y‖ ^ 2 * ‖g z‖
      ∂continuumLightRayMeasure) ≤
      A * ∫ y : Euclidean 2,
        ‖input y‖ ^ 2 * lightRayMaximal δ N g y := by
  letI : SFinite continuumLightRayMeasure := by
    unfold continuumLightRayMeasure
    infer_instance
  have hpoint : ∀ z : WaveSpaceTime,
      ‖∫ y : Euclidean 2, kernel z y * input y‖ ^ 2 * ‖g z‖ ≤
        (A * ∫ y : Euclidean 2,
          lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖ := by
    intro z
    exact mul_le_mul_of_nonneg_right
      (sq_norm_continuumFineKernelTerm_le_lightRayEnergy hδ N ω kernel input
        hkernel hmass hmeas henergy z)
      (norm_nonneg _)
  have hrightInt : Integrable (fun z : WaveSpaceTime =>
      (A * ∫ y : Euclidean 2,
        lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖)
      continuumLightRayMeasure := by
    simpa only [mul_assoc] using henergyWeighted.const_mul A
  have htranspose := integral_lightRayEnergy_transpose δ N ω input g henergy hprod
  have havgInt : Integrable (fun y : Euclidean 2 =>
      ‖input y‖ ^ 2 * lightRayAverage δ N ω y g) volume := by
    refine hprod.integral_prod_right.congr ?_
    filter_upwards with y
    calc
      (∫ z : WaveSpaceTime,
          lightRayKernel δ N ω y z * ‖input y‖ ^ 2 * ‖g z‖
          ∂continuumLightRayMeasure) =
          ∫ z : WaveSpaceTime,
            ‖input y‖ ^ 2 * (lightRayKernel δ N ω y z * ‖g z‖)
            ∂continuumLightRayMeasure := by
        apply integral_congr_ae
        filter_upwards with z
        ring
      _ = ‖input y‖ ^ 2 *
          (∫ z : WaveSpaceTime,
            lightRayKernel δ N ω y z * ‖g z‖
            ∂continuumLightRayMeasure) := integral_const_mul _ _
      _ = ‖input y‖ ^ 2 * lightRayAverage δ N ω y g := by
        rw [integral_lightRayKernel_mul_norm_eq_lightRayAverage δ N ω y g
          (hRayInt y)]
  have havgmax : ∀ y : Euclidean 2,
      lightRayAverage δ N ω y g ≤ lightRayMaximal δ N g y := by
    intro y
    unfold lightRayMaximal
    apply le_csSup (hbounded y)
    exact ⟨ω, hω, rfl⟩
  have hweightedMono :
      (∫ y : Euclidean 2,
        ‖input y‖ ^ 2 * lightRayAverage δ N ω y g) ≤
        ∫ y : Euclidean 2,
          ‖input y‖ ^ 2 * lightRayMaximal δ N g y := by
    apply integral_mono havgInt hmaxWeighted
    intro y
    exact mul_le_mul_of_nonneg_left (havgmax y) (sq_nonneg _)
  calc
    (∫ z : WaveSpaceTime,
        ‖∫ y : Euclidean 2, kernel z y * input y‖ ^ 2 * ‖g z‖
        ∂continuumLightRayMeasure) ≤
        ∫ z : WaveSpaceTime,
          (A * ∫ y : Euclidean 2,
            lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖
          ∂continuumLightRayMeasure :=
      integral_mono htermWeighted hrightInt hpoint
    _ = A * (∫ z : WaveSpaceTime,
          (∫ y : Euclidean 2,
            lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖
          ∂continuumLightRayMeasure) := by
      calc
        (∫ z : WaveSpaceTime,
            (A * ∫ y : Euclidean 2,
              lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖
            ∂continuumLightRayMeasure) =
            ∫ z : WaveSpaceTime, A *
              ((∫ y : Euclidean 2,
                lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖)
              ∂continuumLightRayMeasure := by
          apply integral_congr_ae
          filter_upwards with z
          ring
        _ = A * (∫ z : WaveSpaceTime,
              (∫ y : Euclidean 2,
                lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖
              ∂continuumLightRayMeasure) := integral_const_mul _ _
    _ = A * ∫ y : Euclidean 2, ‖input y‖ ^ 2 *
          (∫ z : WaveSpaceTime,
            lightRayKernel δ N ω y z * ‖g z‖
            ∂continuumLightRayMeasure) := by rw [htranspose]
    _ = A * ∫ y : Euclidean 2,
          ‖input y‖ ^ 2 * lightRayAverage δ N ω y g := by
      congr 1
      apply integral_congr_ae
      filter_upwards with y
      rw [integral_lightRayKernel_mul_norm_eq_lightRayAverage δ N ω y g
        (hRayInt y)]
    _ ≤ A * ∫ y : Euclidean 2,
          ‖input y‖ ^ 2 * lightRayMaximal δ N g y :=
      mul_le_mul_of_nonneg_left hweightedMono hA

/-- The preceding continuum kernel transposition combined with an explicit
raw L2 light-ray maximal-energy estimate. -/
theorem continuumFineKernelWeightedPairing_le_of_lightRayL2Energy
    {δ A B : Real} (hδ : 0 < δ) (hA : 0 ≤ A) (N : Nat)
    (ω : Euclidean 2) (hω : ω ∈ unitLightRayDirections)
    (kernel : WaveSpaceTime → Euclidean 2 → Complex)
    (input : Euclidean 2 → Complex) (g : WaveSpaceTime → Complex)
    (hkernel : ∀ z y, ‖kernel z y‖ ≤ lightRayKernel δ N ω y z)
    (hmass : ∀ z, Integrable (fun y : Euclidean 2 =>
      lightRayKernel δ N ω y z) volume ∧
      (∫ y : Euclidean 2, lightRayKernel δ N ω y z) ≤ A)
    (hmeas : ∀ z, AEStronglyMeasurable (fun y : Euclidean 2 =>
      (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y * input y‖ ^ 2) volume)
    (henergy : ∀ z, Integrable (fun y : Euclidean 2 =>
      lightRayKernel δ N ω y z * ‖input y‖ ^ 2) volume)
    (htermWeighted : Integrable (fun z : WaveSpaceTime =>
      ‖∫ y : Euclidean 2, kernel z y * input y‖ ^ 2 * ‖g z‖)
      continuumLightRayMeasure)
    (henergyWeighted : Integrable (fun z : WaveSpaceTime =>
      (∫ y : Euclidean 2,
        lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖)
      continuumLightRayMeasure)
    (hprod : Integrable (fun p : WaveSpaceTime × Euclidean 2 =>
      lightRayKernel δ N ω p.2 p.1 * ‖input p.2‖ ^ 2 * ‖g p.1‖)
      (continuumLightRayMeasure.prod volume))
    (hRayInt : ∀ y : Euclidean 2, Integrable (fun z : WaveSpaceTime =>
      lightRayKernel δ N ω y z * ‖g z‖) continuumLightRayMeasure)
    (hbounded : ∀ y : Euclidean 2,
      BddAbove ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
        unitLightRayDirections))
    (hinputMeas : AEStronglyMeasurable input volume)
    (hinputFour : Integrable (fun y : Euclidean 2 => ‖input y‖ ^ 4) volume)
    (hmaxMeas : AEStronglyMeasurable (lightRayMaximal δ N g) volume)
    (hmaxTwo : Integrable (fun y : Euclidean 2 =>
      lightRayMaximal δ N g y ^ 2) volume)
    (hKakeya : (∫ y : Euclidean 2, lightRayMaximal δ N g y ^ 2) ≤
      B * ∫ z : WaveSpaceTime, ‖g z‖ ^ 2 ∂continuumLightRayMeasure) :
    (∫ z : WaveSpaceTime,
      ‖∫ y : Euclidean 2, kernel z y * input y‖ ^ 2 * ‖g z‖
      ∂continuumLightRayMeasure) ≤
      A * (∫ y : Euclidean 2, ‖input y‖ ^ 4) ^ ((2 : Real)⁻¹) *
        (B * ∫ z : WaveSpaceTime, ‖g z‖ ^ 2
          ∂continuumLightRayMeasure) ^ ((2 : Real)⁻¹) := by
  letI : SFinite continuumLightRayMeasure := by
    unfold continuumLightRayMeasure
    infer_instance
  have hinputSqMeas : AEStronglyMeasurable (fun y : Euclidean 2 =>
      ‖input y‖ ^ 2) volume := hinputMeas.norm.pow 2
  have hinputSqInt : Integrable (fun y : Euclidean 2 =>
      (‖input y‖ ^ 2) ^ 2) volume := by
    refine hinputFour.congr ?_
    filter_upwards with y
    ring
  have hinputSqMem : MemLp (fun y : Euclidean 2 => ‖input y‖ ^ 2) 2 volume :=
    (memLp_two_iff_integrable_sq hinputSqMeas).mpr hinputSqInt
  have hmaxMem : MemLp (lightRayMaximal δ N g) 2 volume :=
    (memLp_two_iff_integrable_sq hmaxMeas).mpr hmaxTwo
  have hmaxWeighted : Integrable (fun y : Euclidean 2 =>
      ‖input y‖ ^ 2 * lightRayMaximal δ N g y) volume := by
    exact hinputSqMem.integrable_mul hmaxMem
  have hpair := continuumFineKernelWeightedPairing_le_lightRayMaximal
    hδ hA N ω hω kernel input g hkernel hmass hmeas henergy htermWeighted
    henergyWeighted hprod hRayInt hbounded hmaxWeighted
  have hholder := integral_mul_le_Lp_mul_Lq_of_nonneg
    (f := fun y : Euclidean 2 => ‖input y‖ ^ 2)
    (g := lightRayMaximal δ N g)
    Real.HolderConjugate.two_two
    (Eventually.of_forall fun y => sq_nonneg (‖input y‖))
    (Eventually.of_forall fun y =>
      aux_lightRayMaximal_nonneg hδ N g hbounded y)
    (by norm_num; exact hinputSqMem)
    (by norm_num; exact hmaxMem)
  have hholder' :
      (∫ y : Euclidean 2,
        ‖input y‖ ^ 2 * lightRayMaximal δ N g y) ≤
        (∫ y : Euclidean 2, ‖input y‖ ^ 4) ^ ((2 : Real)⁻¹) *
          (∫ y : Euclidean 2,
            lightRayMaximal δ N g y ^ 2) ^ ((2 : Real)⁻¹) := by
    have hInputPow :
        (∫ y : Euclidean 2, (‖input y‖ ^ 2) ^ (2 : Real)) =
          ∫ y : Euclidean 2, ‖input y‖ ^ 4 := by
      apply integral_congr_ae
      filter_upwards with y
      rw [Real.rpow_two]
      ring
    have hMaxPow :
        (∫ y : Euclidean 2, lightRayMaximal δ N g y ^ (2 : Real)) =
          ∫ y : Euclidean 2, lightRayMaximal δ N g y ^ 2 := by
      apply integral_congr_ae
      filter_upwards with y
      rw [Real.rpow_two]
    calc
      (∫ y : Euclidean 2,
          ‖input y‖ ^ 2 * lightRayMaximal δ N g y) ≤
          (∫ y : Euclidean 2, (‖input y‖ ^ 2) ^ (2 : Real)) ^ (1 / (2 : Real)) *
            (∫ y : Euclidean 2,
              lightRayMaximal δ N g y ^ (2 : Real)) ^ (1 / (2 : Real)) := hholder
      _ = (∫ y : Euclidean 2, ‖input y‖ ^ 4) ^ ((2 : Real)⁻¹) *
          (∫ y : Euclidean 2,
            lightRayMaximal δ N g y ^ 2) ^ ((2 : Real)⁻¹) := by
        rw [hInputPow, hMaxPow]
        simp only [one_div]
  have hinputNonneg : 0 ≤ (∫ y : Euclidean 2, ‖input y‖ ^ 4) ^ ((2 : Real)⁻¹) :=
    Real.rpow_nonneg (integral_nonneg fun y => pow_nonneg (norm_nonneg _) _) _
  have hmaxSqrt :
      (∫ y : Euclidean 2, lightRayMaximal δ N g y ^ 2) ^ ((2 : Real)⁻¹) ≤
        (B * ∫ z : WaveSpaceTime, ‖g z‖ ^ 2
          ∂continuumLightRayMeasure) ^ ((2 : Real)⁻¹) := by
    exact Real.rpow_le_rpow
      (integral_nonneg fun y => sq_nonneg _)
      hKakeya (by norm_num)
  have hright :
      (∫ y : Euclidean 2,
        ‖input y‖ ^ 2 * lightRayMaximal δ N g y) ≤
        (∫ y : Euclidean 2, ‖input y‖ ^ 4) ^ ((2 : Real)⁻¹) *
          (B * ∫ z : WaveSpaceTime, ‖g z‖ ^ 2
            ∂continuumLightRayMeasure) ^ ((2 : Real)⁻¹) :=
    hholder'.trans (mul_le_mul_of_nonneg_left hmaxSqrt hinputNonneg)
  calc
    (∫ z : WaveSpaceTime,
        ‖∫ y : Euclidean 2, kernel z y * input y‖ ^ 2 * ‖g z‖
        ∂continuumLightRayMeasure) ≤
        A * ∫ y : Euclidean 2,
          ‖input y‖ ^ 2 * lightRayMaximal δ N g y := hpair
    _ ≤ A * ((∫ y : Euclidean 2, ‖input y‖ ^ 4) ^ ((2 : Real)⁻¹) *
          (B * ∫ z : WaveSpaceTime, ‖g z‖ ^ 2
            ∂continuumLightRayMeasure) ^ ((2 : Real)⁻¹)) :=
      mul_le_mul_of_nonneg_left hright hA
    _ = A * (∫ y : Euclidean 2, ‖input y‖ ^ 4) ^ ((2 : Real)⁻¹) *
        (B * ∫ z : WaveSpaceTime, ‖g z‖ ^ 2
          ∂continuumLightRayMeasure) ^ ((2 : Real)⁻¹) := by ring

/-- A finite Riemann-sum version of a light-ray average.  It provides a
fully finite setting for the elementary estimates below, independently of
any measure-theoretic Kakeya input. -/
def finiteLightRayAverage (δ : Real) (N : Nat) (ω y : Euclidean 2)
    (sample : Finset WaveSpaceTime) (g : WaveSpaceTime → Complex) : Real :=
  ∑ z ∈ sample, lightRayKernel δ N ω y z * ‖g z‖

/-- A finite directional light-ray maximal function.  A nonempty direction
set is explicit because finite suprema over the reals require a witness. -/
def finiteLightRayMaximal (δ : Real) (N : Nat) (directions : Finset (Euclidean 2))
    (hdirections : directions.Nonempty) (sample : Finset WaveSpaceTime)
    (g : WaveSpaceTime → Complex) : Euclidean 2 → Real :=
  fun y => directions.sup' hdirections (fun ω => finiteLightRayAverage δ N ω y sample g)

/-- Each finite light-ray average is nonnegative. -/
theorem finiteLightRayAverage_nonneg {δ : Real} (hδ : 0 < δ) (N : Nat)
    (ω y : Euclidean 2) (sample : Finset WaveSpaceTime)
    (g : WaveSpaceTime → Complex) :
    0 ≤ finiteLightRayAverage δ N ω y sample g := by
  unfold finiteLightRayAverage
  exact Finset.sum_nonneg fun z hz =>
    mul_nonneg (lightRayKernel_nonneg hδ N ω y z) (norm_nonneg _)

/-- The finite directional maximal function is nonnegative. -/
theorem finiteLightRayMaximal_nonneg {δ : Real} (hδ : 0 < δ) (N : Nat)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (sample : Finset WaveSpaceTime) (g : WaveSpaceTime → Complex) (y : Euclidean 2) :
    0 ≤ finiteLightRayMaximal δ N directions hdirections sample g y := by
  unfold finiteLightRayMaximal
  obtain ⟨ω, hω⟩ := hdirections
  exact (finiteLightRayAverage_nonneg hδ N ω y sample g).trans
    (Finset.le_sup' (fun ω => finiteLightRayAverage δ N ω y sample g) hω)

/-- The elementary kernel-size bound for a finite light-ray average. -/
theorem finiteLightRayAverage_le_normalization_mul_sum_norm {δ : Real}
    (hδ : 0 < δ) (N : Nat) (ω y : Euclidean 2)
    (sample : Finset WaveSpaceTime) (g : WaveSpaceTime → Complex) :
    finiteLightRayAverage δ N ω y sample g ≤
      (δ⁻¹) ^ 2 * ∑ z ∈ sample, ‖g z‖ := by
  unfold finiteLightRayAverage
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro z hz
  exact mul_le_mul_of_nonneg_right
    (lightRayKernel_le_normalization hδ N ω y z) (norm_nonneg _)

/-- Finite Cauchy--Schwarz for the sampled input values. -/
theorem sq_sum_norm_sample_le_card_mul_sum_sq
    (sample : Finset WaveSpaceTime) (g : WaveSpaceTime → Complex) :
    (∑ z ∈ sample, ‖g z‖) ^ 2 ≤
      (sample.card : Real) * ∑ z ∈ sample, ‖g z‖ ^ 2 :=
  sq_sum_le_card_mul_sum_sq

/-- The squared finite light-ray average obeys the elementary sampled `L²`
bound.  Its cardinality loss is exactly what the geometric Kakeya input must
replace in the continuum argument. -/
theorem sq_finiteLightRayAverage_le_crude_sampleEnergy {δ : Real}
    (hδ : 0 < δ) (N : Nat) (ω y : Euclidean 2)
    (sample : Finset WaveSpaceTime) (g : WaveSpaceTime → Complex) :
    finiteLightRayAverage δ N ω y sample g ^ 2 ≤
      ((δ⁻¹) ^ 2) ^ 2 * (sample.card : Real) *
        ∑ z ∈ sample, ‖g z‖ ^ 2 := by
  let B : Real := (δ⁻¹) ^ 2
  let S : Real := ∑ z ∈ sample, ‖g z‖
  let E : Real := ∑ z ∈ sample, ‖g z‖ ^ 2
  have hB : 0 ≤ B := by
    dsimp [B]
    exact sq_nonneg _
  have hS : 0 ≤ S := by
    dsimp [S]
    exact Finset.sum_nonneg fun z hz => norm_nonneg _
  have hA : 0 ≤ finiteLightRayAverage δ N ω y sample g :=
    finiteLightRayAverage_nonneg hδ N ω y sample g
  have haverage : finiteLightRayAverage δ N ω y sample g ≤ B * S := by
    simpa only [B, S] using
      finiteLightRayAverage_le_normalization_mul_sum_norm hδ N ω y sample g
  have hsquare : finiteLightRayAverage δ N ω y sample g ^ 2 ≤ (B * S) ^ 2 :=
    (sq_le_sq₀ hA (mul_nonneg hB hS)).mpr haverage
  have hcs : S ^ 2 ≤ (sample.card : Real) * E := by
    simpa only [S, E] using sq_sum_norm_sample_le_card_mul_sum_sq sample g
  have hE : 0 ≤ E := by
    dsimp [E]
    exact Finset.sum_nonneg fun z hz => sq_nonneg _
  calc
    finiteLightRayAverage δ N ω y sample g ^ 2 ≤ (B * S) ^ 2 := hsquare
    _ = B ^ 2 * S ^ 2 := by ring
    _ ≤ B ^ 2 * ((sample.card : Real) * E) :=
      mul_le_mul_of_nonneg_left hcs (sq_nonneg B)
    _ = ((δ⁻¹) ^ 2) ^ 2 * (sample.card : Real) *
          ∑ z ∈ sample, ‖g z‖ ^ 2 := by
      dsimp [B, E]
      ring

/-- Every finite directional maximum has the same elementary sampled bound.
This is deliberately the crude finite estimate, not the planar Kakeya
theorem. -/
theorem finiteLightRayMaximal_le_normalization_mul_sum_norm {δ : Real}
    (hδ : 0 < δ) (N : Nat) (directions : Finset (Euclidean 2))
    (hdirections : directions.Nonempty) (sample : Finset WaveSpaceTime)
    (g : WaveSpaceTime → Complex) (y : Euclidean 2) :
    finiteLightRayMaximal δ N directions hdirections sample g y ≤
      (δ⁻¹) ^ 2 * ∑ z ∈ sample, ‖g z‖ := by
  unfold finiteLightRayMaximal
  apply Finset.sup'_le
  intro ω hω
  exact finiteLightRayAverage_le_normalization_mul_sum_norm hδ N ω y sample g

/-- Squaring the finite directional maximum gives the same sampled energy
bound, uniformly in the choice of a terminal point. -/
theorem sq_finiteLightRayMaximal_le_crude_sampleEnergy {δ : Real}
    (hδ : 0 < δ) (N : Nat) (directions : Finset (Euclidean 2))
    (hdirections : directions.Nonempty) (sample : Finset WaveSpaceTime)
    (g : WaveSpaceTime → Complex) (y : Euclidean 2) :
    finiteLightRayMaximal δ N directions hdirections sample g y ^ 2 ≤
      ((δ⁻¹) ^ 2) ^ 2 * (sample.card : Real) *
        ∑ z ∈ sample, ‖g z‖ ^ 2 := by
  let B : Real := (δ⁻¹) ^ 2
  let S : Real := ∑ z ∈ sample, ‖g z‖
  let E : Real := ∑ z ∈ sample, ‖g z‖ ^ 2
  have hB : 0 ≤ B := by
    dsimp [B]
    exact sq_nonneg _
  have hS : 0 ≤ S := by
    dsimp [S]
    exact Finset.sum_nonneg fun z hz => norm_nonneg _
  have hmax : 0 ≤ finiteLightRayMaximal δ N directions hdirections sample g y :=
    finiteLightRayMaximal_nonneg hδ N directions hdirections sample g y
  have hbound : finiteLightRayMaximal δ N directions hdirections sample g y ≤ B * S := by
    simpa only [B, S] using
      finiteLightRayMaximal_le_normalization_mul_sum_norm hδ N directions hdirections sample g y
  have hsquare : finiteLightRayMaximal δ N directions hdirections sample g y ^ 2 ≤
      (B * S) ^ 2 :=
    (sq_le_sq₀ hmax (mul_nonneg hB hS)).mpr hbound
  have hcs : S ^ 2 ≤ (sample.card : Real) * E := by
    simpa only [S, E] using sq_sum_norm_sample_le_card_mul_sum_sq sample g
  calc
    finiteLightRayMaximal δ N directions hdirections sample g y ^ 2 ≤ (B * S) ^ 2 := hsquare
    _ = B ^ 2 * S ^ 2 := by ring
    _ ≤ B ^ 2 * ((sample.card : Real) * E) :=
      mul_le_mul_of_nonneg_left hcs (sq_nonneg B)
    _ = ((δ⁻¹) ^ 2) ^ 2 * (sample.card : Real) *
          ∑ z ∈ sample, ‖g z‖ ^ 2 := by
      dsimp [B, E]
      ring

/-- The discrete square energy of a finite directional light-ray maximal
function at a finite family of terminal points. -/
def finiteLightRaySquareEnergy (δ : Real) (N : Nat)
    (directions terminalPoints : Finset (Euclidean 2))
    (hdirections : directions.Nonempty) (sample : Finset WaveSpaceTime)
    (g : WaveSpaceTime → Complex) : Real :=
  ∑ y ∈ terminalPoints,
    finiteLightRayMaximal δ N directions hdirections sample g y ^ 2

/-- The completely elementary finite `L²` light-ray bookkeeping estimate.
It loses the cardinalities of both the sampled space-time set and terminal
set.  The MSS Nikodym--Kakeya theorem replaces this loss by a logarithm for
the continuum operator. -/
theorem finiteLightRaySquareEnergy_le_crude {δ : Real}
    (hδ : 0 < δ) (N : Nat) (directions terminalPoints : Finset (Euclidean 2))
    (hdirections : directions.Nonempty) (sample : Finset WaveSpaceTime)
    (g : WaveSpaceTime → Complex) :
    finiteLightRaySquareEnergy δ N directions terminalPoints hdirections sample g ≤
      (terminalPoints.card : Real) * ((δ⁻¹) ^ 2) ^ 2 * (sample.card : Real) *
        ∑ z ∈ sample, ‖g z‖ ^ 2 := by
  let E : Real := ((δ⁻¹) ^ 2) ^ 2 * (sample.card : Real) *
    ∑ z ∈ sample, ‖g z‖ ^ 2
  have hpoint : ∀ y : Euclidean 2,
      finiteLightRayMaximal δ N directions hdirections sample g y ^ 2 ≤ E := by
    intro y
    simpa only [E] using
      sq_finiteLightRayMaximal_le_crude_sampleEnergy hδ N directions hdirections sample g y
  unfold finiteLightRaySquareEnergy
  calc
    (∑ y ∈ terminalPoints,
        finiteLightRayMaximal δ N directions hdirections sample g y ^ 2) ≤
        ∑ _y ∈ terminalPoints, E := by
      apply Finset.sum_le_sum
      intro y hy
      exact hpoint y
    _ = (terminalPoints.card : Real) * E := by simp
    _ = (terminalPoints.card : Real) * ((δ⁻¹) ^ 2) ^ 2 * (sample.card : Real) *
          ∑ z ∈ sample, ‖g z‖ ^ 2 := by
      dsimp [E]
      ring

/-- Pointwise finite light-ray incidence data: the directions and terminal
points whose tubes contain a given space-time point. -/
noncomputable def lightRayTubeIncidences (δ : Real)
    (directions terminalPoints : Finset (Euclidean 2)) (z : WaveSpaceTime) :
    Finset (Euclidean 2 × Euclidean 2) := by
  classical
  exact (directions.product terminalPoints).filter
    (fun pair => z ∈ lightRayTube δ pair.1 pair.2)

/-- Membership in the finite light-ray incidence family spells out both
finite indexing conditions and tube membership. -/
theorem mem_lightRayTubeIncidences_iff (δ : Real)
    (directions terminalPoints : Finset (Euclidean 2)) (z : WaveSpaceTime)
    (pair : Euclidean 2 × Euclidean 2) :
    pair ∈ lightRayTubeIncidences δ directions terminalPoints z ↔
      pair.1 ∈ directions ∧ pair.2 ∈ terminalPoints ∧
        z ∈ lightRayTube δ pair.1 pair.2 := by
  classical
  simp [lightRayTubeIncidences, and_assoc]

/-- The finite tube-incidence multiplicity at one space-time point. -/
noncomputable def lightRayTubeMultiplicity (δ : Real)
    (directions terminalPoints : Finset (Euclidean 2)) (z : WaveSpaceTime) : Nat :=
  (lightRayTubeIncidences δ directions terminalPoints z).card

/-- Incidence multiplicity is literally the cardinality of the active tube
family. -/
theorem lightRayTubeMultiplicity_eq_card_lightRayTubeIncidences (δ : Real)
    (directions terminalPoints : Finset (Euclidean 2)) (z : WaveSpaceTime) :
    lightRayTubeMultiplicity δ directions terminalPoints z =
      (lightRayTubeIncidences δ directions terminalPoints z).card := rfl

/-- The elementary incidence bound before any planar Kakeya geometry is
applied. -/
theorem lightRayTubeMultiplicity_le_card_mul_card (δ : Real)
    (directions terminalPoints : Finset (Euclidean 2)) (z : WaveSpaceTime) :
    lightRayTubeMultiplicity δ directions terminalPoints z ≤
      directions.card * terminalPoints.card := by
  classical
  rw [lightRayTubeMultiplicity_eq_card_lightRayTubeIncidences]
  unfold lightRayTubeIncidences
  calc
    ((directions.product terminalPoints).filter
        (fun pair => z ∈ lightRayTube δ pair.1 pair.2)).card ≤
        (directions.product terminalPoints).card := by
      exact Finset.card_le_card (Finset.filter_subset _ _)
    _ = directions.card * terminalPoints.card := Finset.card_product _ _

/-- Weighted finite Cauchy--Schwarz in the form used by the fine
square-function kernel reduction.  A complex kernel bounded pointwise by a
nonnegative real kernel costs its total mass and leaves the weighted input
energy. -/
theorem sq_norm_sum_le_kernelMass_mul_weightedEnergy
    {α : Type*} (sources : Finset α) (K h : α → Complex) (L : α → Real)
    (hL : ∀ y ∈ sources, 0 ≤ L y)
    (hK : ∀ y ∈ sources, ‖K y‖ ≤ L y) :
    ‖∑ y ∈ sources, K y * h y‖ ^ 2 ≤
      (∑ y ∈ sources, L y) * ∑ y ∈ sources, L y * ‖h y‖ ^ 2 := by
  have hsum_nonneg : 0 ≤ ∑ y ∈ sources, L y * ‖h y‖ :=
    Finset.sum_nonneg fun y hy => mul_nonneg (hL y hy) (norm_nonneg _)
  have hnorm :
      ‖∑ y ∈ sources, K y * h y‖ ≤ ∑ y ∈ sources, L y * ‖h y‖ := by
    calc
      ‖∑ y ∈ sources, K y * h y‖ ≤ ∑ y ∈ sources, ‖K y * h y‖ :=
        norm_sum_le _ _
      _ = ∑ y ∈ sources, ‖K y‖ * ‖h y‖ := by
        apply Finset.sum_congr rfl
        intro y hy
        rw [norm_mul]
      _ ≤ ∑ y ∈ sources, L y * ‖h y‖ := by
        apply Finset.sum_le_sum
        intro y hy
        exact mul_le_mul_of_nonneg_right (hK y hy) (norm_nonneg _)
  have hcs :
      (∑ y ∈ sources, L y * ‖h y‖) ^ 2 ≤
        (∑ y ∈ sources, L y) * ∑ y ∈ sources, L y * ‖h y‖ ^ 2 := by
    have hcs' := Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul sources
      (r := fun y => L y * ‖h y‖) (f := L)
      (g := fun y => L y * ‖h y‖ ^ 2)
      (fun y hy => hL y hy)
      (fun y hy => mul_nonneg (hL y hy) (sq_nonneg _))
      (fun y hy => by nlinarith)
    simpa [mul_assoc] using hcs'
  exact (sq_le_sq₀ (norm_nonneg _) hsum_nonneg).mpr hnorm |>.trans hcs

/-- A finite cube-localized summand in the fine square-function argument.
The source variable is kept discrete here so that the kernel Cauchy--Schwarz
and transposition steps have a completely literal finite form. -/
noncomputable def finiteFineCubeTerm {ι κ : Type*}
    (sources : Finset (Euclidean 2))
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (piece : ι) (cube : κ) :
    WaveSpaceTime → Complex :=
  fun z => ∑ y ∈ sources, kernel piece cube z y * input cube y

/-- The finite sum of cube-localized terms belonging to one radial/angular
piece.  This is the discrete analogue of the decomposition
`T^ν_λ f_n = ∑_κ T^{n,ν,κ}_λ P^κ_λ f`. -/
noncomputable def finiteFinePiece {ι κ : Type*}
    (sources : Finset (Euclidean 2)) (cubeSets : ι → Finset κ)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (piece : ι) :
    WaveSpaceTime → Complex :=
  fun z => ∑ cube ∈ cubeSets piece,
    finiteFineCubeTerm sources kernel input piece cube z

/-- The finite version of the MSS fine square function.  Its `piece` index
packages the radial and angular labels, while `cubeSets piece` records the
few Fourier cubes meeting that piece. -/
noncomputable def finiteFineSquareFunction {ι κ : Type*}
    (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) : WaveSpaceTime → Real :=
  fun z => Real.sqrt (∑ piece ∈ pieces,
    ‖finiteFinePiece sources cubeSets kernel input piece z‖ ^ 2)

/-- The cube-expanded finite fine square function.  The comparison with
`finiteFineSquareFunction` is exactly the first Cauchy--Schwarz step in the
MSS fine-square proof. -/
noncomputable def finiteFineCubeSquareFunction {ι κ : Type*}
    (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) : WaveSpaceTime → Real :=
  fun z => Real.sqrt (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
    ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2)

/-- The finite family of radial/angular pieces to which one Fourier cube is
assigned.  This is the reverse bounded-overlap family in the fine kernel
lemma. -/
noncomputable def fineCubeIncidences {ι κ : Type*}
    (pieces : Finset ι) (cubeSets : ι → Finset κ) (cube : κ) : Finset ι := by
  classical
  exact pieces.filter (fun piece => cube ∈ cubeSets piece)

/-- A finite nonnegative dual test against the square of a space-time square
function.  Taking a norm of the test function is the discrete counterpart of
the positive `L²` dual test in the blueprint. -/
noncomputable def finiteFineDualPairing
    (targets : Finset WaveSpaceTime) (weight : WaveSpaceTime → Complex)
    (S : WaveSpaceTime → Real) : Real :=
  ∑ z ∈ targets, S z ^ 2 * ‖weight z‖

/-- The input cube energy weighted by a light-ray maximal function.  This is
the expression produced after the finite kernel transposition. -/
noncomputable def finiteFineCubeEnergy {κ : Type*}
    (cubes : Finset κ) (sources : Finset (Euclidean 2))
    (input : κ → Euclidean 2 → Complex) (M : Euclidean 2 → Real) : Real :=
  ∑ cube ∈ cubes, ∑ y ∈ sources, ‖input cube y‖ ^ 2 * M y

/-- The cube energy before using the reverse bounded-overlap part of the
cube decomposition.  Each occurrence of a cube is retained with its owning
radial/angular piece, which is the exact finite expression obtained directly
after kernel transposition. -/
noncomputable def finiteFineAssignedCubeEnergy {ι κ : Type*}
    (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (input : κ → Euclidean 2 → Complex)
    (M : Euclidean 2 → Real) : Real :=
  ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, ∑ y ∈ sources,
    ‖input cube y‖ ^ 2 * M y

/-- The pointwise kernel localization required for a finite fine
cube-localized summand.  It is the exact discrete interface supplied by the
nonstationary-phase kernel estimate in the MSS blueprint. -/
def HasFiniteFineKernelLocalization {ι κ : Type*}
    (δ : Real) (N : Nat) (pieces : Finset ι) (cubeSets : ι → Finset κ)
    (direction : ι → Euclidean 2)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex) : Prop :=
  ∀ piece ∈ pieces, ∀ cube ∈ cubeSets piece,
    ∀ z : WaveSpaceTime, ∀ y : Euclidean 2,
      ‖kernel piece cube z y‖ ≤ lightRayKernel δ N (direction piece) y z

/-- A uniform finite mass bound for the model light-ray kernels on the
source sample.  In the continuum proof this is the elementary `L¹` kernel
bound obtained by integrating the localized kernel in the source variable. -/
def HasFiniteFineKernelMassBound {ι κ : Type*}
    (δ : Real) (N : Nat) (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (direction : ι → Euclidean 2) (A : Real) : Prop :=
  ∀ piece ∈ pieces, ∀ cube ∈ cubeSets piece, ∀ z : WaveSpaceTime,
    (∑ y ∈ sources, lightRayKernel δ N (direction piece) y z) ≤ A

/-- A finite light-ray average in a permitted direction is bounded by the
corresponding finite directional maximal operator. -/
theorem finiteLightRayAverage_le_finiteLightRayMaximal
    (δ : Real) (N : Nat) (directions : Finset (Euclidean 2))
    (hdirections : directions.Nonempty) (sample : Finset WaveSpaceTime)
    (g : WaveSpaceTime → Complex) {ω : Euclidean 2} (hω : ω ∈ directions)
    (y : Euclidean 2) :
    finiteLightRayAverage δ N ω y sample g ≤
      finiteLightRayMaximal δ N directions hdirections sample g y := by
  unfold finiteLightRayMaximal
  exact Finset.le_sup' (fun ω => finiteLightRayAverage δ N ω y sample g) hω

/-- Cauchy--Schwarz for one finite cube-localized term under the exact
light-ray kernel localization and mass assumptions. -/
theorem sq_norm_finiteFineCubeTerm_le_of_lightRayLocalization
    {ι κ : Type*} {δ A : Real} (hδ : 0 < δ) (N : Nat)
    (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (direction : ι → Euclidean 2)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex)
    (hkernel : HasFiniteFineKernelLocalization δ N pieces cubeSets direction kernel)
    (hmass : HasFiniteFineKernelMassBound δ N pieces sources cubeSets direction A)
    {piece : ι} (hpiece : piece ∈ pieces) {cube : κ} (hcube : cube ∈ cubeSets piece)
    (z : WaveSpaceTime) :
    ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 ≤
      A * ∑ y ∈ sources,
        lightRayKernel δ N (direction piece) y z * ‖input cube y‖ ^ 2 := by
  have henergy_nonneg : 0 ≤ ∑ y ∈ sources,
      lightRayKernel δ N (direction piece) y z * ‖input cube y‖ ^ 2 :=
    Finset.sum_nonneg fun y hy =>
      mul_nonneg (lightRayKernel_nonneg hδ N (direction piece) y z) (sq_nonneg _)
  have hcs := sq_norm_sum_le_kernelMass_mul_weightedEnergy sources
    (fun y => kernel piece cube z y) (fun y => input cube y)
    (fun y => lightRayKernel δ N (direction piece) y z)
    (fun y hy => lightRayKernel_nonneg hδ N (direction piece) y z)
    (fun y hy => hkernel piece hpiece cube hcube z y)
  change ‖∑ y ∈ sources, kernel piece cube z y * input cube y‖ ^ 2 ≤ _
  calc
    ‖∑ y ∈ sources, kernel piece cube z y * input cube y‖ ^ 2 ≤
        (∑ y ∈ sources, lightRayKernel δ N (direction piece) y z) *
          ∑ y ∈ sources,
            lightRayKernel δ N (direction piece) y z * ‖input cube y‖ ^ 2 := hcs
    _ ≤ A * ∑ y ∈ sources,
          lightRayKernel δ N (direction piece) y z * ‖input cube y‖ ^ 2 :=
      mul_le_mul_of_nonneg_right (hmass piece hpiece cube hcube z) henergy_nonneg

/-- Finite duality and kernel transposition for one cube-localized fine
term.  This is the literal Cauchy--Schwarz reduction to the finite
light-ray maximal function; no Kakeya estimate is used. -/
theorem sum_sq_norm_finiteFineCubeTerm_mul_norm_le_lightRayMaximal
    {ι κ : Type*} {δ A : Real} (hδ : 0 < δ) (hA : 0 ≤ A) (N : Nat)
    (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (direction : ι → Euclidean 2)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (targets : Finset WaveSpaceTime)
    (weight : WaveSpaceTime → Complex)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (hkernel : HasFiniteFineKernelLocalization δ N pieces cubeSets direction kernel)
    (hmass : HasFiniteFineKernelMassBound δ N pieces sources cubeSets direction A)
    {piece : ι} (hpiece : piece ∈ pieces) {cube : κ} (hcube : cube ∈ cubeSets piece)
    (hdirection : direction piece ∈ directions) :
    (∑ z ∈ targets,
      ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖) ≤
      A * ∑ y ∈ sources, ‖input cube y‖ ^ 2 *
        finiteLightRayMaximal δ N directions hdirections targets weight y := by
  have hpoint : ∀ z ∈ targets,
      ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖ ≤
        (A * ∑ y ∈ sources,
          lightRayKernel δ N (direction piece) y z * ‖input cube y‖ ^ 2) *
            ‖weight z‖ := by
    intro z hz
    exact mul_le_mul_of_nonneg_right
      (sq_norm_finiteFineCubeTerm_le_of_lightRayLocalization hδ N
        pieces sources cubeSets direction kernel input hkernel hmass hpiece hcube z)
      (norm_nonneg _)
  have hrearrange :
      (∑ z ∈ targets,
        (A * ∑ y ∈ sources,
          lightRayKernel δ N (direction piece) y z * ‖input cube y‖ ^ 2) *
            ‖weight z‖) =
        A * ∑ y ∈ sources, ‖input cube y‖ ^ 2 *
          (∑ z ∈ targets,
            lightRayKernel δ N (direction piece) y z * ‖weight z‖) := by
    calc
      (∑ z ∈ targets,
        (A * ∑ y ∈ sources,
          lightRayKernel δ N (direction piece) y z * ‖input cube y‖ ^ 2) *
            ‖weight z‖) =
          ∑ z ∈ targets, ∑ y ∈ sources,
            A * ‖input cube y‖ ^ 2 *
              (lightRayKernel δ N (direction piece) y z * ‖weight z‖) := by
        apply Finset.sum_congr rfl
        intro z hz
        rw [Finset.mul_sum, Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro y hy
        ring
      _ = ∑ y ∈ sources, ∑ z ∈ targets,
            A * ‖input cube y‖ ^ 2 *
              (lightRayKernel δ N (direction piece) y z * ‖weight z‖) := by
        exact Finset.sum_comm
      _ = A * ∑ y ∈ sources, ‖input cube y‖ ^ 2 *
          (∑ z ∈ targets,
            lightRayKernel δ N (direction piece) y z * ‖weight z‖) := by
        calc
          (∑ y ∈ sources, ∑ z ∈ targets,
            A * ‖input cube y‖ ^ 2 *
              (lightRayKernel δ N (direction piece) y z * ‖weight z‖)) =
              ∑ y ∈ sources, (A * ‖input cube y‖ ^ 2) *
                (∑ z ∈ targets,
                  lightRayKernel δ N (direction piece) y z * ‖weight z‖) := by
            apply Finset.sum_congr rfl
            intro y hy
            rw [Finset.mul_sum]
          _ = A * ∑ y ∈ sources, ‖input cube y‖ ^ 2 *
                (∑ z ∈ targets,
                  lightRayKernel δ N (direction piece) y z * ‖weight z‖) := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro y hy
            ring
  have hmax : ∀ y ∈ sources,
      (∑ z ∈ targets,
        lightRayKernel δ N (direction piece) y z * ‖weight z‖) ≤
        finiteLightRayMaximal δ N directions hdirections targets weight y := by
    intro y hy
    simpa only [finiteLightRayAverage] using
      (finiteLightRayAverage_le_finiteLightRayMaximal δ N directions hdirections
        targets weight hdirection y)
  calc
    (∑ z ∈ targets,
      ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖) ≤
        ∑ z ∈ targets,
          (A * ∑ y ∈ sources,
            lightRayKernel δ N (direction piece) y z * ‖input cube y‖ ^ 2) *
              ‖weight z‖ := by
      apply Finset.sum_le_sum
      intro z hz
      exact hpoint z hz
    _ = A * ∑ y ∈ sources, ‖input cube y‖ ^ 2 *
          (∑ z ∈ targets,
            lightRayKernel δ N (direction piece) y z * ‖weight z‖) := hrearrange
    _ ≤ A * ∑ y ∈ sources, ‖input cube y‖ ^ 2 *
          finiteLightRayMaximal δ N directions hdirections targets weight y := by
      apply mul_le_mul_of_nonneg_left _ hA
      apply Finset.sum_le_sum
      intro y hy
      exact mul_le_mul_of_nonneg_left (hmax y hy) (sq_nonneg _)

/-- The finite duality/kernel reduction summed over every radial/angular
piece and every cube assigned to it.  This is the precise finite analogue of
the line in the MSS proof immediately before reverse cube-overlap and the
Nikodym--Kakeya estimate are invoked. -/
theorem sum_sq_norm_finiteFineCubeTerms_mul_norm_le_finiteLightRayMaximal
    {ι κ : Type*} {δ A : Real} (hδ : 0 < δ) (hA : 0 ≤ A) (N : Nat)
    (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (direction : ι → Euclidean 2)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (targets : Finset WaveSpaceTime)
    (weight : WaveSpaceTime → Complex)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (hkernel : HasFiniteFineKernelLocalization δ N pieces cubeSets direction kernel)
    (hmass : HasFiniteFineKernelMassBound δ N pieces sources cubeSets direction A)
    (hdirection : ∀ piece ∈ pieces, direction piece ∈ directions) :
    (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, ∑ z ∈ targets,
      ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖) ≤
      A * finiteFineAssignedCubeEnergy pieces sources cubeSets input
        (finiteLightRayMaximal δ N directions hdirections targets weight) := by
  have hterm : ∀ piece ∈ pieces, ∀ cube ∈ cubeSets piece,
      (∑ z ∈ targets,
        ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖) ≤
        A * ∑ y ∈ sources, ‖input cube y‖ ^ 2 *
          finiteLightRayMaximal δ N directions hdirections targets weight y := by
    intro piece hpiece cube hcube
    exact sum_sq_norm_finiteFineCubeTerm_mul_norm_le_lightRayMaximal hδ hA N
      pieces sources cubeSets direction kernel input targets weight directions hdirections
      hkernel hmass hpiece hcube (hdirection piece hpiece)
  have hrearrange :
      (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
        A * ∑ y ∈ sources, ‖input cube y‖ ^ 2 *
          finiteLightRayMaximal δ N directions hdirections targets weight y) =
        A * finiteFineAssignedCubeEnergy pieces sources cubeSets input
          (finiteLightRayMaximal δ N directions hdirections targets weight) := by
    unfold finiteFineAssignedCubeEnergy
    calc
      (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
        A * ∑ y ∈ sources, ‖input cube y‖ ^ 2 *
          finiteLightRayMaximal δ N directions hdirections targets weight y) =
          ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
            A * (∑ y ∈ sources, ‖input cube y‖ ^ 2 *
              finiteLightRayMaximal δ N directions hdirections targets weight y) := by
        apply Finset.sum_congr rfl
        intro piece hpiece
        apply Finset.sum_congr rfl
        intro cube hcube
        rw [Finset.mul_sum]
      _ = A * ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, ∑ y ∈ sources,
            ‖input cube y‖ ^ 2 *
              finiteLightRayMaximal δ N directions hdirections targets weight y := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro piece hpiece
        rw [Finset.mul_sum]
  calc
    (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, ∑ z ∈ targets,
      ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖) ≤
        ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
          A * ∑ y ∈ sources, ‖input cube y‖ ^ 2 *
            finiteLightRayMaximal δ N directions hdirections targets weight y := by
      apply Finset.sum_le_sum
      intro piece hpiece
      apply Finset.sum_le_sum
      intro cube hcube
      exact hterm piece hpiece cube hcube
    _ = A * finiteFineAssignedCubeEnergy pieces sources cubeSets input
          (finiteLightRayMaximal δ N directions hdirections targets weight) := hrearrange

/-- Squaring the finite fine square function removes its outer square root. -/
theorem sq_finiteFineSquareFunction {ι κ : Type*}
    (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (z : WaveSpaceTime) :
    finiteFineSquareFunction pieces sources cubeSets kernel input z ^ 2 =
      ∑ piece ∈ pieces,
        ‖finiteFinePiece sources cubeSets kernel input piece z‖ ^ 2 := by
  unfold finiteFineSquareFunction
  rw [Real.sq_sqrt]
  exact Finset.sum_nonneg fun piece hpiece => sq_nonneg _

/-- Squaring the cube-expanded fine square function removes its outer square
root and exposes the individual cube terms. -/
theorem sq_finiteFineCubeSquareFunction {ι κ : Type*}
    (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (z : WaveSpaceTime) :
    finiteFineCubeSquareFunction pieces sources cubeSets kernel input z ^ 2 =
      ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
        ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 := by
  unfold finiteFineCubeSquareFunction
  rw [Real.sq_sqrt]
  exact Finset.sum_nonneg fun piece hpiece =>
    Finset.sum_nonneg fun cube hcube => sq_nonneg _

/-- The first finite Cauchy--Schwarz step in the fine square-function proof:
the cube sum within one radial/angular piece costs its number of cubes. -/
theorem sq_norm_finiteFinePiece_le_card_mul_sum_sq {ι κ : Type*}
    (sources : Finset (Euclidean 2)) (cubeSets : ι → Finset κ)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (piece : ι) (z : WaveSpaceTime) :
    ‖finiteFinePiece sources cubeSets kernel input piece z‖ ^ 2 ≤
      ((cubeSets piece).card : Real) * ∑ cube ∈ cubeSets piece,
        ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 := by
  have hsum_nonneg : 0 ≤ ∑ cube ∈ cubeSets piece,
      ‖finiteFineCubeTerm sources kernel input piece cube z‖ :=
    Finset.sum_nonneg fun cube hcube => norm_nonneg _
  have hnorm :
      ‖finiteFinePiece sources cubeSets kernel input piece z‖ ≤
        ∑ cube ∈ cubeSets piece,
          ‖finiteFineCubeTerm sources kernel input piece cube z‖ := by
    unfold finiteFinePiece
    exact norm_sum_le _ _
  calc
    ‖finiteFinePiece sources cubeSets kernel input piece z‖ ^ 2 ≤
        (∑ cube ∈ cubeSets piece,
          ‖finiteFineCubeTerm sources kernel input piece cube z‖) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) hsum_nonneg).mpr hnorm
    _ ≤ ((cubeSets piece).card : Real) * ∑ cube ∈ cubeSets piece,
          ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 := by
      simpa using
        (sq_sum_le_card_mul_sum_sq (s := cubeSets piece)
          (f := fun cube => ‖finiteFineCubeTerm sources kernel input piece cube z‖))

/-- Boundedly many cubes per piece reduce the original finite fine square
function to the cube-expanded one. -/
theorem sq_finiteFineSquareFunction_le_cubeMultiplicity_mul_sq
    {ι κ : Type*} (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) {B : Real}
    (hcard : ∀ piece ∈ pieces, ((cubeSets piece).card : Real) ≤ B)
    (z : WaveSpaceTime) :
    finiteFineSquareFunction pieces sources cubeSets kernel input z ^ 2 ≤
      B * finiteFineCubeSquareFunction pieces sources cubeSets kernel input z ^ 2 := by
  have hpieceBound : ∀ piece ∈ pieces,
      ‖finiteFinePiece sources cubeSets kernel input piece z‖ ^ 2 ≤
        B * ∑ cube ∈ cubeSets piece,
          ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 := by
    intro piece hmem
    have henergy_nonneg : 0 ≤ ∑ cube ∈ cubeSets piece,
        ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 :=
      Finset.sum_nonneg fun cube hcube => sq_nonneg _
    calc
      ‖finiteFinePiece sources cubeSets kernel input piece z‖ ^ 2 ≤
          ((cubeSets piece).card : Real) * ∑ cube ∈ cubeSets piece,
            ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 :=
        sq_norm_finiteFinePiece_le_card_mul_sum_sq sources cubeSets kernel input piece z
      _ ≤ B * ∑ cube ∈ cubeSets piece,
            ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 :=
        mul_le_mul_of_nonneg_right (hcard piece hmem) henergy_nonneg
  rw [sq_finiteFineSquareFunction, sq_finiteFineCubeSquareFunction]
  calc
    (∑ piece ∈ pieces,
        ‖finiteFinePiece sources cubeSets kernel input piece z‖ ^ 2) ≤
        ∑ piece ∈ pieces, B * ∑ cube ∈ cubeSets piece,
          ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 := by
      apply Finset.sum_le_sum
      intro piece hmem
      exact hpieceBound piece hmem
    _ = B * ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
          ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 := by
      rw [Finset.mul_sum]

/-- The complete finite fine-square duality reduction.  Boundedly many cubes
per piece, kernel Cauchy--Schwarz, transposition, and the directional maximum
reduce the dual pairing of the fine square function to a weighted cube
energy.  The only analytic inputs are explicitly displayed as kernel
localization/mass assumptions; no continuum Kakeya estimate is invoked. -/
theorem finiteFineDualPairing_le_cubeMultiplicity_mul_finiteLightRayEnergy
    {ι κ : Type*} {δ A B : Real} (hδ : 0 < δ) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (N : Nat) (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (direction : ι → Euclidean 2)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (targets : Finset WaveSpaceTime)
    (weight : WaveSpaceTime → Complex)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (hcard : ∀ piece ∈ pieces, ((cubeSets piece).card : Real) ≤ B)
    (hkernel : HasFiniteFineKernelLocalization δ N pieces cubeSets direction kernel)
    (hmass : HasFiniteFineKernelMassBound δ N pieces sources cubeSets direction A)
    (hdirection : ∀ piece ∈ pieces, direction piece ∈ directions) :
    finiteFineDualPairing targets weight
      (finiteFineSquareFunction pieces sources cubeSets kernel input) ≤
      (B * A) * finiteFineAssignedCubeEnergy pieces sources cubeSets input
        (finiteLightRayMaximal δ N directions hdirections targets weight) := by
  have hpoint : ∀ z ∈ targets,
      finiteFineSquareFunction pieces sources cubeSets kernel input z ^ 2 * ‖weight z‖ ≤
        (B * finiteFineCubeSquareFunction pieces sources cubeSets kernel input z ^ 2) *
          ‖weight z‖ := by
    intro z hz
    exact mul_le_mul_of_nonneg_right
      (sq_finiteFineSquareFunction_le_cubeMultiplicity_mul_sq
        pieces sources cubeSets kernel input hcard z)
      (norm_nonneg _)
  have hcubePairing :
      (∑ z ∈ targets,
        finiteFineCubeSquareFunction pieces sources cubeSets kernel input z ^ 2 *
          ‖weight z‖) =
        ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, ∑ z ∈ targets,
          ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖ := by
    calc
      (∑ z ∈ targets,
        finiteFineCubeSquareFunction pieces sources cubeSets kernel input z ^ 2 *
          ‖weight z‖) =
          ∑ z ∈ targets, (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
            ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2) * ‖weight z‖ := by
        apply Finset.sum_congr rfl
        intro z hz
        rw [sq_finiteFineCubeSquareFunction]
      _ = ∑ z ∈ targets, ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
          ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖ := by
        apply Finset.sum_congr rfl
        intro z hz
        rw [Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro piece hpiece
        rw [Finset.sum_mul]
      _ = ∑ piece ∈ pieces, ∑ z ∈ targets, ∑ cube ∈ cubeSets piece,
          ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖ := by
        exact Finset.sum_comm
      _ = ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, ∑ z ∈ targets,
          ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖ := by
        apply Finset.sum_congr rfl
        intro piece hpiece
        exact Finset.sum_comm
  have htransposition :
      (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, ∑ z ∈ targets,
        ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖) ≤
        A * finiteFineAssignedCubeEnergy pieces sources cubeSets input
          (finiteLightRayMaximal δ N directions hdirections targets weight) :=
    sum_sq_norm_finiteFineCubeTerms_mul_norm_le_finiteLightRayMaximal
      hδ hA N pieces sources cubeSets direction kernel input targets weight directions
      hdirections hkernel hmass hdirection
  unfold finiteFineDualPairing
  calc
    (∑ z ∈ targets,
      finiteFineSquareFunction pieces sources cubeSets kernel input z ^ 2 * ‖weight z‖) ≤
        ∑ z ∈ targets,
          (B * finiteFineCubeSquareFunction pieces sources cubeSets kernel input z ^ 2) *
            ‖weight z‖ := by
      apply Finset.sum_le_sum
      intro z hz
      exact hpoint z hz
    _ = B * ∑ z ∈ targets,
        finiteFineCubeSquareFunction pieces sources cubeSets kernel input z ^ 2 *
          ‖weight z‖ := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro z hz
      ring
    _ = B * ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, ∑ z ∈ targets,
        ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖ := by
      rw [hcubePairing]
    _ ≤ B * (A * finiteFineAssignedCubeEnergy pieces sources cubeSets input
        (finiteLightRayMaximal δ N directions hdirections targets weight)) :=
      mul_le_mul_of_nonneg_left htransposition hB
    _ = (B * A) * finiteFineAssignedCubeEnergy pieces sources cubeSets input
        (finiteLightRayMaximal δ N directions hdirections targets weight) := by
      ring

/-- The elementary reverse-overlap bound for a finite cube family.  Without
the geometric cube-localization lemma it loses the number of pieces; the MSS
reverse bounded-overlap assertion is precisely what replaces this factor by
an absolute constant. -/
theorem finiteFineAssignedCubeEnergy_le_card_mul_finiteFineCubeEnergy
    {ι κ : Type*} [DecidableEq κ] (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (input : κ → Euclidean 2 → Complex)
    (M : Euclidean 2 → Real)
    (henergy : ∀ cube ∈ pieces.biUnion cubeSets,
      0 ≤ ∑ y ∈ sources, ‖input cube y‖ ^ 2 * M y) :
    finiteFineAssignedCubeEnergy pieces sources cubeSets input M ≤
      (pieces.card : Real) *
        finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input M := by
  classical
  have hpieceBound : ∀ piece ∈ pieces,
      (∑ cube ∈ cubeSets piece, ∑ y ∈ sources,
        ‖input cube y‖ ^ 2 * M y) ≤
        ∑ cube ∈ pieces.biUnion cubeSets, ∑ y ∈ sources,
          ‖input cube y‖ ^ 2 * M y := by
    intro piece hmem
    apply Finset.sum_le_sum_of_subset_of_nonneg
      (fun cube hcube => Finset.mem_biUnion.mpr ⟨piece, hmem, hcube⟩)
    intro cube hcube hnot
    exact henergy cube hcube
  unfold finiteFineAssignedCubeEnergy finiteFineCubeEnergy
  calc
    (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, ∑ y ∈ sources,
      ‖input cube y‖ ^ 2 * M y) ≤
        ∑ _piece ∈ pieces, ∑ cube ∈ pieces.biUnion cubeSets, ∑ y ∈ sources,
          ‖input cube y‖ ^ 2 * M y := by
      apply Finset.sum_le_sum
      intro piece hmem
      exact hpieceBound piece hmem
    _ = (pieces.card : Real) *
        ∑ cube ∈ pieces.biUnion cubeSets, ∑ y ∈ sources,
          ‖input cube y‖ ^ 2 * M y := by
      simp

/-- The finite set of piece--cube assignments.  Counting its fibers under
the second-coordinate map is the exact discrete form of reverse cube
overlap. -/
noncomputable def fineCubeAssignments {ι κ : Type*} [DecidableEq κ]
    (pieces : Finset ι) (cubeSets : ι → Finset κ) :
    Finset (Sigma fun _ : ι => κ) :=
  pieces.sigma cubeSets

/-- The assignments using a given cube.  Its cardinality counts the number
of radial/angular pieces to which that cube was assigned. -/
noncomputable def fineCubeAssignmentFiber {ι κ : Type*} [DecidableEq κ]
    (pieces : Finset ι) (cubeSets : ι → Finset κ) (cube : κ) :
    Finset (Sigma fun _ : ι => κ) :=
  (fineCubeAssignments pieces cubeSets).filter (fun assignment => assignment.2 = cube)

/-- Reverse bounded overlap in a finite Fourier-cube decomposition.  This
is the literal combinatorial content of the second cardinality assertion in
the MSS cube-localization lemma. -/
def HasFiniteFineCubeReverseOverlap {ι κ : Type*} [DecidableEq κ]
    (pieces : Finset ι) (cubeSets : ι → Finset κ) (B : Nat) : Prop :=
  ∀ cube ∈ pieces.biUnion cubeSets,
    (fineCubeAssignmentFiber pieces cubeSets cube).card ≤ B

/-- The finite cube fiber assigned to a specified packet owner.  This is an
explicit finite model: it does not assert that the angular sector geometry
supplies such an owner map. -/
noncomputable def ownerCubeSets {ι κ : Type*}
    (cubes : Finset κ) (owner : κ → ι) (piece : ι) : Finset κ :=
  by
    classical
    exact cubes.filter (fun cube => owner cube = piece)

private theorem mem_ownerCubeSets_iff {ι κ : Type*}
    (cubes : Finset κ) (owner : κ → ι) (piece : ι) (cube : κ) :
    cube ∈ ownerCubeSets cubes owner piece ↔
      cube ∈ cubes ∧ owner cube = piece := by
  classical
  simp [ownerCubeSets]

private theorem biUnion_ownerCubeSets_eq {ι κ : Type*} [DecidableEq κ]
    (pieces : Finset ι) (cubes : Finset κ) (owner : κ → ι)
    (howner : ∀ cube ∈ cubes, owner cube ∈ pieces) :
    pieces.biUnion (ownerCubeSets cubes owner) = cubes := by
  classical
  apply Finset.Subset.antisymm
  · intro cube hcube
    rcases Finset.mem_biUnion.mp hcube with ⟨piece, hpiece, hcube⟩
    exact (mem_ownerCubeSets_iff cubes owner piece cube).mp hcube |>.1
  · intro cube hcube
    apply Finset.mem_biUnion.mpr
    refine ⟨owner cube, howner cube hcube, ?_⟩
    exact (mem_ownerCubeSets_iff cubes owner (owner cube) cube).mpr ⟨hcube, rfl⟩

private theorem pairwiseDisjoint_ownerCubeSets {ι κ : Type*}
    (pieces : Finset ι) (cubes : Finset κ) (owner : κ → ι) :
    (↑pieces : Set ι).PairwiseDisjoint (ownerCubeSets cubes owner) := by
  classical
  intro piece hpiece piece' hpiece' hne
  refine Finset.disjoint_left.mpr ?_
  intro cube hcube hcube'
  have hleft := (mem_ownerCubeSets_iff cubes owner piece cube).mp hcube
  have hright := (mem_ownerCubeSets_iff cubes owner piece' cube).mp hcube'
  apply hne
  exact hleft.2.symm.trans hright.2

private theorem sum_ownerCubeSets_eq {ι κ M : Type*} [AddCommMonoid M]
    (pieces : Finset ι) (cubes : Finset κ) (owner : κ → ι) (E : κ → M)
    (howner : ∀ cube ∈ cubes, owner cube ∈ pieces) :
    (∑ piece ∈ pieces, ∑ cube ∈ ownerCubeSets cubes owner piece, E cube) =
      ∑ cube ∈ cubes, E cube := by
  classical
  rw [← Finset.sum_biUnion (pairwiseDisjoint_ownerCubeSets pieces cubes owner)]
  rw [biUnion_ownerCubeSets_eq pieces cubes owner howner]

/-- An explicit owner partition has reverse cube-overlap exactly one.  The
statement is a finite combinatorial model, conditional only on the supplied
owner map rather than on unformalized sector geometry. -/
theorem hasFiniteFineCubeReverseOverlap_ownerCubeSets
    {ι κ : Type*} [DecidableEq κ]
    (pieces : Finset ι) (cubes : Finset κ) (owner : κ → ι) :
    HasFiniteFineCubeReverseOverlap pieces (ownerCubeSets cubes owner) 1 := by
  classical
  intro cube hcube
  have hsubset : fineCubeAssignmentFiber pieces (ownerCubeSets cubes owner) cube ⊆
      ({⟨owner cube, cube⟩} : Finset (Sigma fun _ : ι => κ)) := by
    rintro ⟨piece, assignedCube⟩ hassignment
    have hassignment' : (piece ∈ pieces ∧
        assignedCube ∈ ownerCubeSets cubes owner piece) ∧ assignedCube = cube := by
      simpa [fineCubeAssignmentFiber, fineCubeAssignments] using hassignment
    have hownerEq : owner assignedCube = piece :=
      (mem_ownerCubeSets_iff cubes owner piece assignedCube).mp hassignment'.1.2 |>.2
    have hassigned : assignedCube = cube := hassignment'.2
    subst assignedCube
    simpa using hownerEq.symm
  exact (Finset.card_le_card hsubset).trans (by simp)

/-- Pointwise, the square energy of an owner-partitioned family of actual
Fourier cubes is exactly the established finite Fourier-cube square function.
No assertion is made that an angular sector decomposition supplies the owner
map. -/
theorem sum_sq_fourierCubeProjection_ownerCubeSets_eq
    {ι κ : Type*}
    (pieces : Finset ι) (cubes : Finset κ) (owner : κ → ι)
    (howner : ∀ cube ∈ cubes, owner cube ∈ pieces)
    (m : κ → SchwartzMap (Euclidean 2) Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    (∑ piece ∈ pieces, ∑ cube ∈ ownerCubeSets cubes owner piece,
      ‖fourierCubeProjection (m cube) f x‖ ^ 2) =
      fourierCubeSquareFunction cubes m f x ^ 2 := by
  rw [sum_ownerCubeSets_eq pieces cubes owner
    (fun cube => ‖fourierCubeProjection (m cube) f x‖ ^ 2) howner]
  unfold fourierCubeSquareFunction
  rw [Real.sq_sqrt]
  exact Finset.sum_nonneg fun cube hcube => sq_nonneg _

/-- Integrating an explicitly owner-partitioned cube energy gives the
literal frequency-side square energy of the original finite cube family. -/
theorem integral_ownerCubeSquareEnergy_eq_frequency
    {ι κ : Type*}
    (pieces : Finset ι) (cubes : Finset κ) (owner : κ → ι)
    (howner : ∀ cube ∈ cubes, owner cube ∈ pieces)
    (m : κ → SchwartzMap (Euclidean 2) Complex)
    (f : SchwartzMap (Euclidean 2) Complex) :
    (∫ x : Euclidean 2,
      ∑ piece ∈ pieces, ∑ cube ∈ ownerCubeSets cubes owner piece,
        ‖fourierCubeProjection (m cube) f x‖ ^ 2) =
      ∫ ξ : Euclidean 2,
        (∑ cube ∈ cubes, ‖m cube ξ‖ ^ 2) *
          ‖𝓕 (f : Euclidean 2 → Complex) ξ‖ ^ 2 := by
  calc
    (∫ x : Euclidean 2,
      ∑ piece ∈ pieces, ∑ cube ∈ ownerCubeSets cubes owner piece,
        ‖fourierCubeProjection (m cube) f x‖ ^ 2) =
        ∫ x : Euclidean 2, fourierCubeSquareFunction cubes m f x ^ 2 := by
      apply integral_congr_ae
      filter_upwards with x
      exact sum_sq_fourierCubeProjection_ownerCubeSets_eq
        pieces cubes owner howner m f x
    _ = ∫ ξ : Euclidean 2,
        (∑ cube ∈ cubes, ‖m cube ξ‖ ^ 2) *
          ‖𝓕 (f : Euclidean 2 → Complex) ξ‖ ^ 2 :=
      integral_sq_fourierCubeSquareFunction_eq_frequency cubes m f

/-- With a common angular cutoff, the literal owner-fiber packets reconstruct
the packet of the original finite actual-frequency cube family.  This does
not claim that present angular-sector geometry produces the required owner
map or a cubical cover. -/
theorem sum_angularDyadicCubePacket_ownerCubeSets_eq
    {ι κ : Type*}
    (pieces : Finset ι) (cubes : Finset κ) (owner : κ → ι)
    (howner : ∀ cube ∈ cubes, owner cube ∈ pieces)
    (C : lpCutoffs 2) (j : Nat)
    (χ : SchwartzMap (Euclidean 2) Complex)
    (m : κ → SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (z : WaveSpaceTime) :
    (∑ piece ∈ pieces,
      angularDyadicCubePacket (ownerCubeSets cubes owner piece)
        C j χ m ϑ f z) =
      angularDyadicCubePacket cubes C j χ m ϑ f z := by
  calc
    (∑ piece ∈ pieces,
      angularDyadicCubePacket (ownerCubeSets cubes owner piece)
        C j χ m ϑ f z) =
        ∑ piece ∈ pieces, ∑ cube ∈ ownerCubeSets cubes owner piece,
          angularPiece ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0)
            (χ : Euclidean 2 → Complex) ϑ
            (fourierCubeProjection (m cube) f) z := by
      apply Finset.sum_congr rfl
      intro piece hpiece
      exact angularDyadicCubePacket_eq_sum
        (ownerCubeSets cubes owner piece) C j χ m ϑ f z
    _ = ∑ cube ∈ cubes,
        angularPiece ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0)
          (χ : Euclidean 2 → Complex) ϑ
          (fourierCubeProjection (m cube) f) z :=
      sum_ownerCubeSets_eq pieces cubes owner
        (fun cube => angularPiece ((2 : Real) ^ j)
          (dyadicBandpassMultiplier C.cutoff 0) (χ : Euclidean 2 → Complex) ϑ
          (fourierCubeProjection (m cube) f) z) howner
    _ = angularDyadicCubePacket cubes C j χ m ϑ f z :=
      (angularDyadicCubePacket_eq_sum cubes C j χ m ϑ f z).symm

/-- The finite cube-decomposition and light-ray-kernel localization package
from the MSS fine-kernel lemma.  The four conjuncts are respectively the
bounded number of cubes per piece, pointwise light-ray domination, the
uniform kernel-mass bound, and reverse bounded cube overlap. -/
def fineKernelLocalization {ι κ : Type*} [DecidableEq κ]
    (δ A B : Real) (N D : Nat) (pieces : Finset ι)
    (sources : Finset (Euclidean 2)) (cubeSets : ι → Finset κ)
    (direction : ι → Euclidean 2)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex) : Prop :=
  (∀ piece ∈ pieces, ((cubeSets piece).card : Real) ≤ B) ∧
    HasFiniteFineKernelLocalization δ N pieces cubeSets direction kernel ∧
    HasFiniteFineKernelMassBound δ N pieces sources cubeSets direction A ∧
    HasFiniteFineCubeReverseOverlap pieces cubeSets D

/-- The exact finite double-counting identity that rewrites assigned cube
energy as a sum over cube fibers. -/
theorem finiteFineAssignedCubeEnergy_eq_sum_fibers
    {ι κ : Type*} [DecidableEq κ] (pieces : Finset ι)
    (sources : Finset (Euclidean 2)) (cubeSets : ι → Finset κ)
    (input : κ → Euclidean 2 → Complex) (M : Euclidean 2 → Real) :
    finiteFineAssignedCubeEnergy pieces sources cubeSets input M =
      ∑ cube ∈ pieces.biUnion cubeSets,
        ∑ _assignment ∈ fineCubeAssignmentFiber pieces cubeSets cube,
          ∑ y ∈ sources, ‖input cube y‖ ^ 2 * M y := by
  classical
  let assignments : Finset (Sigma fun _ : ι => κ) :=
    fineCubeAssignments pieces cubeSets
  let cubes : Finset κ := pieces.biUnion cubeSets
  let E : κ → Real := fun cube => ∑ y ∈ sources, ‖input cube y‖ ^ 2 * M y
  have hmaps : ∀ assignment ∈ assignments, assignment.2 ∈ cubes := by
    rintro ⟨piece, cube⟩ hassignment
    have hassignment' : piece ∈ pieces ∧ cube ∈ cubeSets piece := by
      simpa [assignments, fineCubeAssignments] using hassignment
    exact Finset.mem_biUnion.mpr ⟨piece, hassignment'.1, hassignment'.2⟩
  have hfiber := Finset.sum_fiberwise_of_maps_to'
    (s := assignments) (t := cubes) (g := fun assignment : Sigma fun _ : ι => κ => assignment.2)
    hmaps E
  change (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, E cube) =
    ∑ cube ∈ cubes, ∑ assignment ∈ assignments with assignment.2 = cube, E cube
  calc
    (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, E cube) =
        ∑ assignment ∈ assignments, E assignment.2 := by
      simpa [assignments, fineCubeAssignments] using
        (Finset.sum_sigma' pieces cubeSets (fun _ cube => E cube))
    _ = ∑ cube ∈ cubes, ∑ assignment ∈ assignments with assignment.2 = cube, E cube :=
      hfiber.symm

/-- A finite reverse-overlap bound with the actual maximum fiber
multiplicity, rather than the crude number of pieces. -/
theorem finiteFineAssignedCubeEnergy_le_reverseOverlap_mul_finiteFineCubeEnergy
    {ι κ : Type*} [DecidableEq κ] (pieces : Finset ι)
    (sources : Finset (Euclidean 2)) (cubeSets : ι → Finset κ)
    (input : κ → Euclidean 2 → Complex) (M : Euclidean 2 → Real) (B : Nat)
    (hoverlap : HasFiniteFineCubeReverseOverlap pieces cubeSets B)
    (henergy : ∀ cube ∈ pieces.biUnion cubeSets,
      0 ≤ ∑ y ∈ sources, ‖input cube y‖ ^ 2 * M y) :
    finiteFineAssignedCubeEnergy pieces sources cubeSets input M ≤
      (B : Real) * finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input M := by
  classical
  let E : κ → Real := fun cube => ∑ y ∈ sources, ‖input cube y‖ ^ 2 * M y
  have hfiberEq : ∀ cube : κ,
      (∑ assignment ∈ fineCubeAssignmentFiber pieces cubeSets cube, E cube) =
        ((fineCubeAssignmentFiber pieces cubeSets cube).card : Real) * E cube := by
    intro cube
    simp [E]
  calc
    finiteFineAssignedCubeEnergy pieces sources cubeSets input M =
        ∑ cube ∈ pieces.biUnion cubeSets,
          ∑ assignment ∈ fineCubeAssignmentFiber pieces cubeSets cube, E cube := by
      simpa only [E] using
        finiteFineAssignedCubeEnergy_eq_sum_fibers pieces sources cubeSets input M
    _ = ∑ cube ∈ pieces.biUnion cubeSets,
          ((fineCubeAssignmentFiber pieces cubeSets cube).card : Real) * E cube := by
      apply Finset.sum_congr rfl
      intro cube hcube
      exact hfiberEq cube
    _ ≤ ∑ cube ∈ pieces.biUnion cubeSets, (B : Real) * E cube := by
      apply Finset.sum_le_sum
      intro cube hcube
      have hmult : ((fineCubeAssignmentFiber pieces cubeSets cube).card : Real) ≤ B := by
        exact_mod_cast hoverlap cube hcube
      exact mul_le_mul_of_nonneg_right hmult (henergy cube hcube)
    _ = (B : Real) * finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input M := by
      unfold finiteFineCubeEnergy
      rw [Finset.mul_sum]

/-- Specializing the finite reverse-overlap bookkeeping to the nonnegative
finite light-ray maximal weight. -/
theorem finiteFineAssignedCubeEnergy_le_card_mul_finiteFineCubeEnergy_lightRay
    {ι κ : Type*} [DecidableEq κ] {δ : Real} (hδ : 0 < δ) (N : Nat)
    (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (input : κ → Euclidean 2 → Complex)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (targets : Finset WaveSpaceTime) (weight : WaveSpaceTime → Complex) :
    finiteFineAssignedCubeEnergy pieces sources cubeSets input
      (finiteLightRayMaximal δ N directions hdirections targets weight) ≤
      (pieces.card : Real) * finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input
        (finiteLightRayMaximal δ N directions hdirections targets weight) := by
  apply finiteFineAssignedCubeEnergy_le_card_mul_finiteFineCubeEnergy
  intro cube hcube
  exact Finset.sum_nonneg fun y hy =>
    mul_nonneg (sq_nonneg _)
      (finiteLightRayMaximal_nonneg hδ N directions hdirections targets weight y)

/-- The sharp finite reverse-overlap estimate with the supplied cube fiber
bound, specialized to the nonnegative finite light-ray maximal weight. -/
theorem finiteFineAssignedCubeEnergy_le_reverseOverlap_mul_finiteFineCubeEnergy_lightRay
    {ι κ : Type*} [DecidableEq κ] {δ : Real} (hδ : 0 < δ) (N : Nat)
    (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (input : κ → Euclidean 2 → Complex)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (targets : Finset WaveSpaceTime) (weight : WaveSpaceTime → Complex) (B : Nat)
    (hoverlap : HasFiniteFineCubeReverseOverlap pieces cubeSets B) :
    finiteFineAssignedCubeEnergy pieces sources cubeSets input
      (finiteLightRayMaximal δ N directions hdirections targets weight) ≤
      (B : Real) * finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input
        (finiteLightRayMaximal δ N directions hdirections targets weight) := by
  apply finiteFineAssignedCubeEnergy_le_reverseOverlap_mul_finiteFineCubeEnergy
    pieces sources cubeSets input _ B hoverlap
  intro cube hcube
  exact Finset.sum_nonneg fun y hy =>
    mul_nonneg (sq_nonneg _)
      (finiteLightRayMaximal_nonneg hδ N directions hdirections targets weight y)

/-- With bounded cube multiplicity in both directions, the complete finite
fine-square duality calculation has only the two expected constants.  This
is the sharp finite combinatorial version of the MSS reduction to the
light-ray maximal function. -/
theorem finiteFineDualPairing_le_cubeMultiplicities_mul_finiteLightRayEnergy
    {ι κ : Type*} [DecidableEq κ] {δ A B : Real} (hδ : 0 < δ) (hA : 0 ≤ A)
    (hB : 0 ≤ B) (N : Nat) (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (direction : ι → Euclidean 2)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (targets : Finset WaveSpaceTime)
    (weight : WaveSpaceTime → Complex)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (hcard : ∀ piece ∈ pieces, ((cubeSets piece).card : Real) ≤ B)
    (hkernel : HasFiniteFineKernelLocalization δ N pieces cubeSets direction kernel)
    (hmass : HasFiniteFineKernelMassBound δ N pieces sources cubeSets direction A)
    (hdirection : ∀ piece ∈ pieces, direction piece ∈ directions)
    (D : Nat) (hoverlap : HasFiniteFineCubeReverseOverlap pieces cubeSets D) :
    finiteFineDualPairing targets weight
      (finiteFineSquareFunction pieces sources cubeSets kernel input) ≤
      ((B * A) * (D : Real)) *
        finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input
          (finiteLightRayMaximal δ N directions hdirections targets weight) := by
  have hmain := finiteFineDualPairing_le_cubeMultiplicity_mul_finiteLightRayEnergy
    hδ hA hB N pieces sources cubeSets direction kernel input targets weight directions
    hdirections hcard hkernel hmass hdirection
  have hreverse :=
    finiteFineAssignedCubeEnergy_le_reverseOverlap_mul_finiteFineCubeEnergy_lightRay
      hδ N pieces sources cubeSets input directions hdirections targets weight D hoverlap
  calc
    finiteFineDualPairing targets weight
      (finiteFineSquareFunction pieces sources cubeSets kernel input) ≤
        (B * A) * finiteFineAssignedCubeEnergy pieces sources cubeSets input
          (finiteLightRayMaximal δ N directions hdirections targets weight) := hmain
    _ ≤ (B * A) * ((D : Real) *
        finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input
          (finiteLightRayMaximal δ N directions hdirections targets weight)) :=
      mul_le_mul_of_nonneg_left hreverse (mul_nonneg hB hA)
    _ = ((B * A) * (D : Real)) *
        finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input
          (finiteLightRayMaximal δ N directions hdirections targets weight) := by
      ring

/-- Combining the finite fine-square duality reduction with the elementary
reverse-overlap count gives a fully proved, if non-sharp, finite analogue of
the MSS fine square-function estimate. -/
theorem finiteFineDualPairing_le_cubeMultiplicity_card_mul_finiteLightRayEnergy
    {ι κ : Type*} [DecidableEq κ] {δ A B : Real} (hδ : 0 < δ) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (N : Nat) (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (direction : ι → Euclidean 2)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (targets : Finset WaveSpaceTime)
    (weight : WaveSpaceTime → Complex)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (hcard : ∀ piece ∈ pieces, ((cubeSets piece).card : Real) ≤ B)
    (hkernel : HasFiniteFineKernelLocalization δ N pieces cubeSets direction kernel)
    (hmass : HasFiniteFineKernelMassBound δ N pieces sources cubeSets direction A)
    (hdirection : ∀ piece ∈ pieces, direction piece ∈ directions) :
    finiteFineDualPairing targets weight
      (finiteFineSquareFunction pieces sources cubeSets kernel input) ≤
      ((B * A) * (pieces.card : Real)) *
        finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input
          (finiteLightRayMaximal δ N directions hdirections targets weight) := by
  have hmain := finiteFineDualPairing_le_cubeMultiplicity_mul_finiteLightRayEnergy
    hδ hA hB N pieces sources cubeSets direction kernel input targets weight directions
    hdirections hcard hkernel hmass hdirection
  have hoverlap := finiteFineAssignedCubeEnergy_le_card_mul_finiteFineCubeEnergy_lightRay
    hδ N pieces sources cubeSets input directions hdirections targets weight
  calc
    finiteFineDualPairing targets weight
      (finiteFineSquareFunction pieces sources cubeSets kernel input) ≤
        (B * A) * finiteFineAssignedCubeEnergy pieces sources cubeSets input
          (finiteLightRayMaximal δ N directions hdirections targets weight) := hmain
    _ ≤ (B * A) * ((pieces.card : Real) *
        finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input
          (finiteLightRayMaximal δ N directions hdirections targets weight)) :=
      mul_le_mul_of_nonneg_left hoverlap (mul_nonneg hB hA)
    _ = ((B * A) * (pieces.card : Real)) *
        finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input
          (finiteLightRayMaximal δ N directions hdirections targets weight) := by
      ring

/-- The discrete fourth-power input energy produced by the Fourier-cube
square function in the fine-square argument.  It is the counting-measure
counterpart of `‖∑_κ |P^κ_λ f|²‖²₂`. -/
noncomputable def aux_finiteFineInputQuarticEnergy {κ : Type*}
    (cubes : Finset κ) (sources : Finset (Euclidean 2))
    (input : κ → Euclidean 2 → Complex) : Real :=
  ∑ y ∈ sources, (∑ cube ∈ cubes, ‖input cube y‖ ^ 2) ^ 2

/-- The square of the cube energy is controlled by the fourth-power cube
square-function energy and the finite light-ray square energy.  This is the
finite Cauchy--Schwarz/Hölder step immediately after the kernel
transposition in the MSS fine-square proof. -/
theorem aux_sq_finiteFineCubeEnergy_le_inputQuartic_mul_finiteLightRaySquareEnergy
    {κ : Type*} (cubes : Finset κ) (sources : Finset (Euclidean 2))
    (input : κ → Euclidean 2 → Complex) (δ : Real) (N : Nat)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (targets : Finset WaveSpaceTime) (weight : WaveSpaceTime → Complex) :
    finiteFineCubeEnergy cubes sources input
        (finiteLightRayMaximal δ N directions hdirections targets weight) ^ 2 ≤
      aux_finiteFineInputQuarticEnergy cubes sources input *
        finiteLightRaySquareEnergy δ N directions sources hdirections targets weight := by
  classical
  let A : Euclidean 2 → Real := fun y =>
    ∑ cube ∈ cubes, ‖input cube y‖ ^ 2
  let M : Euclidean 2 → Real :=
    finiteLightRayMaximal δ N directions hdirections targets weight
  have hcs := Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul sources
    (r := fun y => A y * M y) (f := fun y => A y ^ 2)
    (g := fun y => M y ^ 2)
    (fun y hy => sq_nonneg (A y))
    (fun y hy => sq_nonneg (M y))
    (fun y hy => by
      rw [mul_pow])
  have hrearrange :
      (∑ cube ∈ cubes, ∑ y ∈ sources, ‖input cube y‖ ^ 2 * M y) =
        ∑ y ∈ sources, A y * M y := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro y hy
    dsimp [A]
    rw [Finset.sum_mul]
  change
    (∑ cube ∈ cubes, ∑ y ∈ sources, ‖input cube y‖ ^ 2 * M y) ^ 2 ≤
      (∑ y ∈ sources, A y ^ 2) * ∑ y ∈ sources, M y ^ 2
  rw [hrearrange]
  exact hcs

/-- A generic finite duality conclusion once the kernel reduction has
produced a cube-energy bound.  Its conclusion records the exact point at
which the finite light-ray square energy, and hence the planar Kakeya
estimate in the continuum proof, enters the MSS argument. -/
theorem aux_sq_finiteFineDualPairing_le_of_cubeEnergyBound
    {ι κ : Type*} [DecidableEq κ] {δ C : Real} (hδ : 0 < δ) (hC : 0 ≤ C)
    (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (targets : Finset WaveSpaceTime)
    (weight : WaveSpaceTime → Complex) (N : Nat)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (hbound : finiteFineDualPairing targets weight
      (finiteFineSquareFunction pieces sources cubeSets kernel input) ≤
        C * finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input
          (finiteLightRayMaximal δ N directions hdirections targets weight)) :
    finiteFineDualPairing targets weight
        (finiteFineSquareFunction pieces sources cubeSets kernel input) ^ 2 ≤
      C ^ 2 * aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input *
        finiteLightRaySquareEnergy δ N directions sources hdirections targets weight := by
  classical
  let S : WaveSpaceTime → Real :=
    finiteFineSquareFunction pieces sources cubeSets kernel input
  let M : Euclidean 2 → Real :=
    finiteLightRayMaximal δ N directions hdirections targets weight
  let E : Real := finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input M
  have hpairNonneg : 0 ≤ finiteFineDualPairing targets weight S := by
    unfold finiteFineDualPairing
    exact Finset.sum_nonneg fun z hz =>
      mul_nonneg (sq_nonneg (S z)) (norm_nonneg (weight z))
  have hMNonneg : ∀ y : Euclidean 2, 0 ≤ M y := by
    intro y
    exact finiteLightRayMaximal_nonneg hδ N directions hdirections targets weight y
  have hENonneg : 0 ≤ E := by
    unfold E finiteFineCubeEnergy
    exact Finset.sum_nonneg fun cube hcube =>
      Finset.sum_nonneg fun y hy =>
        mul_nonneg (sq_nonneg (‖input cube y‖)) (hMNonneg y)
  have hsquare : finiteFineDualPairing targets weight S ^ 2 ≤ (C * E) ^ 2 := by
    apply (sq_le_sq₀ hpairNonneg (mul_nonneg hC hENonneg)).mpr
    simpa only [S, E, M] using hbound
  have henergy : E ^ 2 ≤
      aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input *
        finiteLightRaySquareEnergy δ N directions sources hdirections targets weight := by
    simpa only [E, M] using
      (aux_sq_finiteFineCubeEnergy_le_inputQuartic_mul_finiteLightRaySquareEnergy
        (pieces.biUnion cubeSets) sources input δ N directions hdirections targets weight)
  calc
    finiteFineDualPairing targets weight S ^ 2 ≤ (C * E) ^ 2 := hsquare
    _ = C ^ 2 * E ^ 2 := by ring
    _ ≤ C ^ 2 *
        (aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input *
          finiteLightRaySquareEnergy δ N directions sources hdirections targets weight) :=
      mul_le_mul_of_nonneg_left henergy (sq_nonneg C)
    _ = C ^ 2 * aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input *
        finiteLightRaySquareEnergy δ N directions sources hdirections targets weight := by
      ring

/-- The complete finite fine-square/Kakeya reduction with an explicit
reverse cube-overlap constant.  Replacing the final finite light-ray energy
by the logarithmic continuum Nikodym--Kakeya estimate, and the preceding
quartic input energy by the Fourier-cube square-function estimate, is
exactly the remaining analytic passage to the MSS fine-square theorem. -/
theorem aux_sq_finiteFineDualPairing_le_of_reverseOverlap
    {ι κ : Type*} [DecidableEq κ] {δ A B : Real}
    (hδ : 0 < δ) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (N : Nat) (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (direction : ι → Euclidean 2)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (targets : Finset WaveSpaceTime)
    (weight : WaveSpaceTime → Complex)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (hcard : ∀ piece ∈ pieces, ((cubeSets piece).card : Real) ≤ B)
    (hkernel : HasFiniteFineKernelLocalization δ N pieces cubeSets direction kernel)
    (hmass : HasFiniteFineKernelMassBound δ N pieces sources cubeSets direction A)
    (hdirection : ∀ piece ∈ pieces, direction piece ∈ directions)
    (D : Nat) (hoverlap : HasFiniteFineCubeReverseOverlap pieces cubeSets D) :
    finiteFineDualPairing targets weight
        (finiteFineSquareFunction pieces sources cubeSets kernel input) ^ 2 ≤
      ((B * A) * (D : Real)) ^ 2 *
        aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input *
          finiteLightRaySquareEnergy δ N directions sources hdirections targets weight := by
  have hC : 0 ≤ (B * A) * (D : Real) := by positivity
  apply aux_sq_finiteFineDualPairing_le_of_cubeEnergyBound hδ hC pieces sources cubeSets
    kernel input targets weight N directions hdirections
  exact finiteFineDualPairing_le_cubeMultiplicities_mul_finiteLightRayEnergy
    hδ hA hB N pieces sources cubeSets direction kernel input targets weight directions
    hdirections hcard hkernel hmass hdirection D hoverlap

/-- The finite quartic cube-square energy is nonnegative. -/
theorem aux_finiteFineInputQuarticEnergy_nonneg {κ : Type*}
    (cubes : Finset κ) (sources : Finset (Euclidean 2))
    (input : κ → Euclidean 2 → Complex) :
    0 ≤ aux_finiteFineInputQuarticEnergy cubes sources input := by
  unfold aux_finiteFineInputQuarticEnergy
  exact Finset.sum_nonneg fun y hy => sq_nonneg _

/-- The completely unconditional finite version of the MSS fine-square
duality reduction.  All losses are displayed: the only term that must be
replaced to obtain the continuum MSS bound is the crude finite light-ray
square-energy factor on the right. -/
theorem aux_sq_finiteFineDualPairing_le_crude
    {ι κ : Type*} [DecidableEq κ] {δ A B : Real}
    (hδ : 0 < δ) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (N : Nat) (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (direction : ι → Euclidean 2)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (targets : Finset WaveSpaceTime)
    (weight : WaveSpaceTime → Complex)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (hcard : ∀ piece ∈ pieces, ((cubeSets piece).card : Real) ≤ B)
    (hkernel : HasFiniteFineKernelLocalization δ N pieces cubeSets direction kernel)
    (hmass : HasFiniteFineKernelMassBound δ N pieces sources cubeSets direction A)
    (hdirection : ∀ piece ∈ pieces, direction piece ∈ directions)
    (D : Nat) (hoverlap : HasFiniteFineCubeReverseOverlap pieces cubeSets D) :
    finiteFineDualPairing targets weight
        (finiteFineSquareFunction pieces sources cubeSets kernel input) ^ 2 ≤
      ((B * A) * (D : Real)) ^ 2 *
        aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input *
          ((sources.card : Real) * ((δ⁻¹) ^ 2) ^ 2 * (targets.card : Real) *
            ∑ z ∈ targets, ‖weight z‖ ^ 2) := by
  have hmain := aux_sq_finiteFineDualPairing_le_of_reverseOverlap
    hδ hA hB N pieces sources cubeSets direction kernel input targets weight directions
    hdirections hcard hkernel hmass hdirection D hoverlap
  have hkakeya := finiteLightRaySquareEnergy_le_crude hδ N directions sources
    hdirections targets weight
  have hinput : 0 ≤
      aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input :=
    aux_finiteFineInputQuarticEnergy_nonneg (pieces.biUnion cubeSets) sources input
  have hleft : 0 ≤ ((B * A) * (D : Real)) ^ 2 *
      aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input :=
    mul_nonneg (sq_nonneg _) hinput
  calc
    finiteFineDualPairing targets weight
        (finiteFineSquareFunction pieces sources cubeSets kernel input) ^ 2 ≤
      ((B * A) * (D : Real)) ^ 2 *
        aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input *
          finiteLightRaySquareEnergy δ N directions sources hdirections targets weight := hmain
    _ = (((B * A) * (D : Real)) ^ 2 *
        aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input) *
          finiteLightRaySquareEnergy δ N directions sources hdirections targets weight := by
      ring
    _ ≤ (((B * A) * (D : Real)) ^ 2 *
        aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input) *
          ((sources.card : Real) * ((δ⁻¹) ^ 2) ^ 2 * (targets.card : Real) *
            ∑ z ∈ targets, ‖weight z‖ ^ 2) :=
      mul_le_mul_of_nonneg_left hkakeya hleft
    _ = ((B * A) * (D : Real)) ^ 2 *
        aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input *
          ((sources.card : Real) * ((δ⁻¹) ^ 2) ^ 2 * (targets.card : Real) *
            ∑ z ∈ targets, ‖weight z‖ ^ 2) := by
      ring

/-- Cauchy--Schwarz on the active ordered-pair fiber in the exact
zero-thickness model.  The coefficient is the literal fiber multiplicity,
so this is the discrete Fourier-side square-function reduction before the
two-circle geometry is inserted. -/
theorem sq_sum_norm_mul_zeroThicknessPlateOverlapPairs_le_multiplicity_mul_sum_sq
    (radius radius' : Real) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime)
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    (∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
        ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
      (zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z : Real) *
        ∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
          ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
  calc
    (∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
        ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
        (zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z : Real) *
          ∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
            ‖(fun pair z => F pair.1 z * G pair.2 z) pair z‖ ^ 2 := by
      rw [zeroThicknessPlateOverlapMultiplicity]
      exact sq_sum_le_card_mul_sum_sq
    _ = (zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z : Real) *
        ∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
          ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
      congr 1
      apply Finset.sum_congr rfl
      intro pair hpair
      rw [norm_mul]
      ring

/-- The genuinely proved zero-thickness overlap estimate in the planar
angular-sector model.  Its factor two is sharp for ordered pairs because of
the swap symmetry at equal radii. -/
theorem sq_sum_norm_mul_zeroThicknessPlateOverlapPairs_le_two_mul_sum_sq
    {scale sectorRadius spacingLower spacingUpper radius radius' : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2} (k : Nat)
    (Z : WaveSpaceTime) (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hradius : 0 < radius) (hradius' : 0 < radius')
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    (∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
        ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
      2 * ∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
        ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
  have hmult :
      (zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z : Real) ≤ 2 := by
    exact_mod_cast
      zeroThicknessPlateOverlapMultiplicity_le_two_of_angularSectorGeometry
        k Z hscale hgeometry hradius hradius'
  have henergy : 0 ≤
      ∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
        ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
    Finset.sum_nonneg fun pair hpair =>
      mul_nonneg (sq_nonneg _) (sq_nonneg _)
  calc
    (∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
        ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
        (zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z : Real) *
          ∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
            ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
      sq_sum_norm_mul_zeroThicknessPlateOverlapPairs_le_multiplicity_mul_sum_sq
        radius radius' indices directions k Z F G z
    _ ≤ 2 * ∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
          ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
      mul_le_mul_of_nonneg_right hmult henergy

/-- The finite output-frequency square energy of the zero-thickness
pair-sum model.  Summing this quantity is the exact finite analogue of the
Plancherel square-function calculation after resolving output fibers. -/
noncomputable def finiteZeroThicknessOverlapSquareEnergy
    (radius radius' : Real) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (outputs : Finset WaveSpaceTime)
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) : Real :=
  ∑ Z ∈ outputs,
    (∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
      ‖F pair.1 z * G pair.2 z‖) ^ 2

/-- Summing the planar multiplicity-two overlap estimate over finitely many
output frequencies.  No unproved thick-plate or Kakeya estimate is hidden:
this is a direct consequence of the zero-thickness two-circle geometry. -/
theorem finiteZeroThicknessOverlapSquareEnergy_le_two_mul_sum
    {scale sectorRadius spacingLower spacingUpper radius radius' : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2} (k : Nat)
    (outputs : Finset WaveSpaceTime) (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hradius : 0 < radius) (hradius' : 0 < radius')
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    finiteZeroThicknessOverlapSquareEnergy radius radius' indices directions k outputs F G z ≤
      2 * ∑ Z ∈ outputs,
        ∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
          ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
  unfold finiteZeroThicknessOverlapSquareEnergy
  calc
    (∑ Z ∈ outputs,
      (∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
        ‖F pair.1 z * G pair.2 z‖) ^ 2) ≤
        ∑ Z ∈ outputs, 2 *
          ∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
            ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
      apply Finset.sum_le_sum
      intro Z hZ
      exact sq_sum_norm_mul_zeroThicknessPlateOverlapPairs_le_two_mul_sum_sq
        k Z hscale hgeometry hradius hradius' F G z
    _ = 2 * ∑ Z ∈ outputs,
        ∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
          ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
      rw [Finset.mul_sum]

/-- A completely finite model of vertical recombination.  The input is a
family of samples indexed by a radial label and a finite/counting spatial
label; `vertical n` is the discrete analogue of the multiplier
`V_n^λ`.  Values outside `indices` are ignored. -/
noncomputable def finiteVerticalRecombinedOnCounting {σ β : Type*}
    (indices : Finset Int) (vertical : Int → (σ → Complex) → β → Complex)
    (H : Int × σ → Complex) : β → Complex :=
  fun y => ∑ n ∈ indices, vertical n (fun x => H (n, x)) y

/-- The Riesz--Thorin counting-measure lemma gives a concrete `L² → L⁴`
vertical-recombination estimate once the finite model has its `L²` and
`L∞` endpoint bounds.  Unlike the continuum MSS target, this statement is
fully proved; the endpoint assumptions isolate exactly the remaining
multiplier estimates. -/
theorem eLpNorm_four_rpow_two_finiteVerticalRecombinedOnCounting_le_of_two_top
    {σ β : Type*} [MeasurableSpace σ] [MeasurableSingletonClass σ]
    [MeasurableSpace β] {ν : Measure β}
    (indices : Finset Int) (vertical : Int → (σ → Complex) → β → Complex)
    (H : Int × σ → Complex) {A₂ ATop : ENNReal}
    (hmeas : AEStronglyMeasurable
      (finiteVerticalRecombinedOnCounting indices vertical H) ν)
    (hTwo : eLpNorm (finiteVerticalRecombinedOnCounting indices vertical H)
      (2 : ENNReal) ν ≤ A₂ * eLpNorm H (2 : ENNReal) Measure.count)
    (hTop : eLpNorm (finiteVerticalRecombinedOnCounting indices vertical H) ⊤ ν ≤
      ATop * eLpNorm H ⊤ Measure.count) :
    (eLpNorm (finiteVerticalRecombinedOnCounting indices vertical H)
      (4 : ENNReal) ν) ^ (2 : Real) ≤
        (A₂ * ATop) * (eLpNorm H (2 : ENNReal) Measure.count) ^ (2 : Real) := by
  exact eLpNorm_four_rpow_two_le_of_two_top_operator_count
    (T := fun h => finiteVerticalRecombinedOnCounting indices vertical h) H
    hmeas hTwo hTop

/-- The MSS fine square function before vertical recombination.  It is the
square function of the angular half-wave pieces applied to their matched
radial inputs, exactly as in the blueprint's definition of `S_λ`. -/
noncomputable def fineSquareFunction
    (radialIndices angularIndices : Finset Int)
    (radialCutoff : Real → Complex)
    (angularCutoff : Int → Euclidean 2 → Complex) (scale : Real)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex)
    (f : Euclidean 2 → Complex) : WaveSpaceTime → Real :=
  angularRadialSquareFunction radialIndices angularIndices
    (fun n ν => angularPiece scale a (angularCutoff ν) ϑ
      (radialPiece radialCutoff scale n f))

/-- The endpoint MSS recombination estimate for one conically localized
half-wave.  It is stated before the fine-square estimate so that the two
remaining inputs in the blueprint remain visibly separate. -/
def recombination (radialCutoff : Real → Complex)
    (radialIndices angularIndices : Real → Finset Int)
    (angularCutoff : Int → Euclidean 2 → Complex)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex) : Prop :=
  ∀ η : Real, 0 < η → ∀ N : Nat, ∃ C : Real, 0 < C ∧
    ∀ scale : Real, 2 ≤ scale → ∀ f : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (conicOperator scale a ϑ (f : Euclidean 2 → Complex))
          (4 : ENNReal) volume ≤
        ENNReal.ofReal (C * scale ^ (1 / 8 + η)) *
          eLpNorm
            (fineSquareFunction (radialIndices scale) (angularIndices scale)
              radialCutoff angularCutoff scale a ϑ (f : Euclidean 2 → Complex))
            (4 : ENNReal) volume +
          ENNReal.ofReal (C * scale ^ (-(N : Real))) *
            eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume

/-- The sharp fine square-function estimate required in the MSS proof.
The preceding finite duality theorems reduce its kernel stage to
`lightRayMaximal`; completing this proposition needs the continuum cube
decomposition, its reverse overlap, the `L⁴` cube square function, and the
planar Nikodym--Kakeya bound. -/
def fineSquareFunctionEstimate
    (radialIndices angularIndices : Real → Finset Int)
    (radialCutoff : Real → Complex)
    (angularCutoff : Int → Euclidean 2 → Complex)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex) : Prop :=
  ∀ η : Real, 0 < η → ∃ C : Real, 0 < C ∧
    ∀ scale : Real, 2 ≤ scale → ∀ f : SchwartzMap (Euclidean 2) Complex,
      eLpNorm
          (fineSquareFunction (radialIndices scale) (angularIndices scale)
            radialCutoff angularCutoff scale a ϑ (f : Euclidean 2 → Complex))
          (4 : ENNReal) volume ≤
        ENNReal.ofReal (C * scale ^ η) *
          eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume

/-- The recombination and fine-square inputs combine to the concrete planar
conic `L⁴` estimate at the MSS exponent `1 / 8 + η`.

The two losses are split evenly; the rapidly decaying recombination residual
is absorbed using `scale ≥ 2`. -/
theorem conicL4Estimate_of_recombination_of_fineSquareFunctionEstimate
    (radialCutoff : Real → Complex)
    (radialIndices angularIndices : Real → Finset Int)
    (angularCutoff : Int → Euclidean 2 → Complex)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex)
    (hrec : recombination radialCutoff radialIndices angularIndices angularCutoff a ϑ)
    (hfine : fineSquareFunctionEstimate radialIndices angularIndices
      radialCutoff angularCutoff a ϑ) :
    ∀ η : Real, 0 < η → ∃ C : Real, 0 < C ∧
      ∀ scale : Real, 2 ≤ scale → ∀ f : SchwartzMap (Euclidean 2) Complex,
        eLpNorm (conicOperator scale a ϑ (f : Euclidean 2 → Complex))
            (4 : ENNReal) volume ≤
          ENNReal.ofReal (C * scale ^ ((1 / 8 : Real) + η)) *
            eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := by
  intro η hη
  have hηhalf : 0 < η / 2 := by linarith
  rcases hrec (η / 2) hηhalf 0 with ⟨Crec, hCrec, hrec⟩
  rcases hfine (η / 2) hηhalf with ⟨Cfine, hCfine, hfine⟩
  let C : Real := Crec * Cfine + Crec
  have hC : 0 < C := by
    dsimp only [C]
    positivity
  refine ⟨C, hC, ?_⟩
  intro scale hscale f
  have hscalePos : 0 < scale := lt_of_lt_of_le (by norm_num) hscale
  have hscaleNonneg : 0 ≤ scale := hscalePos.le
  have hγ : 0 ≤ (1 / 8 : Real) + η := by linarith
  have hpowγ : 1 ≤ scale ^ ((1 / 8 : Real) + η) :=
    Real.one_le_rpow (by linarith) hγ
  have hpowA : 0 ≤ scale ^ ((1 / 8 : Real) + η / 2) :=
    Real.rpow_nonneg hscaleNonneg _
  have hpowB : 0 ≤ scale ^ (η / 2) := Real.rpow_nonneg hscaleNonneg _
  have hpowZero : 0 ≤ scale ^ (-(0 : Real)) := Real.rpow_nonneg hscaleNonneg _
  have hX : 0 ≤ Crec * scale ^ ((1 / 8 : Real) + η / 2) :=
    mul_nonneg hCrec.le hpowA
  have hZ : 0 ≤ Cfine * scale ^ (η / 2) := mul_nonneg hCfine.le hpowB
  have hY : 0 ≤ Crec * scale ^ (-(0 : Real)) := mul_nonneg hCrec.le hpowZero
  have hpows : scale ^ ((1 / 8 : Real) + η / 2) * scale ^ (η / 2) =
      scale ^ ((1 / 8 : Real) + η) := by
    rw [← Real.rpow_add hscalePos]
    congr 1
    ring
  have hcoeff :
      ENNReal.ofReal (Crec * scale ^ ((1 / 8 : Real) + η / 2)) *
          ENNReal.ofReal (Cfine * scale ^ (η / 2)) +
        ENNReal.ofReal (Crec * scale ^ (-(0 : Real))) ≤
      ENNReal.ofReal (C * scale ^ ((1 / 8 : Real) + η)) := by
    rw [← ENNReal.ofReal_mul hX, ← ENNReal.ofReal_add (mul_nonneg hX hZ) hY]
    apply ENNReal.ofReal_le_ofReal
    dsimp only [C]
    rw [show (Crec * scale ^ ((1 / 8 : Real) + η / 2)) *
          (Cfine * scale ^ (η / 2)) =
          (Crec * Cfine) *
            (scale ^ ((1 / 8 : Real) + η / 2) * scale ^ (η / 2)) by ring,
      hpows]
    simp only [Real.rpow_zero, neg_zero, mul_one]
    have hCrecScale : Crec ≤ Crec * scale ^ ((1 / 8 : Real) + η) := by
      simpa using mul_le_mul_of_nonneg_left hpowγ hCrec.le
    calc
      (Crec * Cfine) * scale ^ ((1 / 8 : Real) + η) + Crec ≤
          (Crec * Cfine) * scale ^ ((1 / 8 : Real) + η) +
            Crec * scale ^ ((1 / 8 : Real) + η) :=
        add_le_add_right hCrecScale _
      _ = (Crec * Cfine + Crec) * scale ^ ((1 / 8 : Real) + η) := by ring
  have hrecAt := hrec scale hscale f
  have hfineAt := hfine scale hscale f
  calc
    eLpNorm (conicOperator scale a ϑ (f : Euclidean 2 → Complex))
        (4 : ENNReal) volume ≤
        ENNReal.ofReal (Crec * scale ^ ((1 / 8 : Real) + η / 2)) *
            eLpNorm
              (fineSquareFunction (radialIndices scale) (angularIndices scale)
                radialCutoff angularCutoff scale a ϑ (f : Euclidean 2 → Complex))
              (4 : ENNReal) volume +
          ENNReal.ofReal (Crec * scale ^ (-(0 : Real))) *
            eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := by
      simpa using hrecAt
    _ ≤ ENNReal.ofReal (Crec * scale ^ ((1 / 8 : Real) + η / 2)) *
          (ENNReal.ofReal (Cfine * scale ^ (η / 2)) *
            eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume) +
        ENNReal.ofReal (Crec * scale ^ (-(0 : Real))) *
          eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := by
      exact add_le_add (mul_le_mul_right hfineAt _) le_rfl
    _ = (ENNReal.ofReal (Crec * scale ^ ((1 / 8 : Real) + η / 2)) *
          ENNReal.ofReal (Cfine * scale ^ (η / 2)) +
        ENNReal.ofReal (Crec * scale ^ (-(0 : Real)))) *
          eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := by ring
    _ ≤ ENNReal.ofReal (C * scale ^ ((1 / 8 : Real) + η)) *
          eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume :=
      mul_le_mul_left hcoeff _

/-- A scale-`2^j` conic `L⁴` estimate with the level-zero annular amplitude
transfers to the positive dyadic half-wave on the unit time slab.  This is the
concrete scale normal form behind the positive-orientation part of the MSS
local-smoothing estimate.  The negative orientation requires a separately
transported reflected conic estimate. -/
theorem exists_plus_dyadicHalfWaveSpaceTime_L4_bound_of_conicData
    (C : lpCutoffs 2) (ϑ radialCutoff : Real → Complex)
    (radialIndices angularIndices : Real → Finset Int)
    (angularCutoff : Int → Euclidean 2 → Complex)
    (hϑ : ∀ t ∈ Icc (1 : Real) 2, ϑ t = 1)
    (hrec : recombination radialCutoff radialIndices angularIndices angularCutoff
      (dyadicBandpassMultiplier C.cutoff 0) ϑ)
    (hfine : fineSquareFunctionEstimate radialIndices angularIndices radialCutoff
      angularCutoff (dyadicBandpassMultiplier C.cutoff 0) ϑ) :
    ∀ η : Real, 0 < η → ∃ A : Real, 0 < A ∧
      ∀ j : Nat, 1 ≤ j → ∀ f : SchwartzMap (Euclidean 2) Complex,
        eLpNorm (dyadicHalfWaveSpaceTime C.cutoff WaveSign.plus j f) (4 : ENNReal)
            localSmoothingMeasure ≤
          ENNReal.ofReal (A * (2 : Real) ^
            ((j : Real) * ((1 / 8 : Real) + η))) *
            eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := by
  intro η hη
  rcases conicL4Estimate_of_recombination_of_fineSquareFunctionEstimate
    radialCutoff radialIndices angularIndices angularCutoff
    (dyadicBandpassMultiplier C.cutoff 0) ϑ hrec hfine η hη with ⟨A, hA, hbound⟩
  refine ⟨A, hA, ?_⟩
  intro j hj f
  have hscale : (2 : Real) ≤ (2 : Real) ^ j := by
    calc
      (2 : Real) = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ j := by exact pow_le_pow_right₀ (by norm_num) hj
  have hconic := hbound ((2 : Real) ^ j) hscale f
  have hpow : ((2 : Real) ^ j) ^ ((1 / 8 : Real) + η) =
      (2 : Real) ^ ((j : Real) * ((1 / 8 : Real) + η)) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : 0 ≤ (2 : Real))]
  calc
    eLpNorm (dyadicHalfWaveSpaceTime C.cutoff WaveSign.plus j f) (4 : ENNReal)
        localSmoothingMeasure ≤
      eLpNorm (conicOperator ((2 : Real) ^ j)
        (dyadicBandpassMultiplier C.cutoff 0) ϑ (f : Euclidean 2 → Complex))
        (4 : ENNReal) volume :=
      eLpNorm_dyadicHalfWaveSpaceTime_plus_le_conicOperator C ϑ j f hϑ
    _ ≤ ENNReal.ofReal (A * ((2 : Real) ^ j) ^ ((1 / 8 : Real) + η)) *
        eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := hconic
    _ = ENNReal.ofReal (A * (2 : Real) ^
        ((j : Real) * ((1 / 8 : Real) + η))) *
        eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := by
      rw [hpow]

/-- One conic datum whose time cutoff is one on both the positive and
reflected unit slabs supplies the matching dyadic `L⁴` estimate for both
half-wave orientations.  This is a scale-normal-form bridge only: it does
not assert the remaining annular-sector reconstruction or the full MSS
local-smoothing theorem. -/
theorem exists_bothSign_dyadicHalfWaveSpaceTime_L4_bound_of_twoSidedConicData
    (C : lpCutoffs 2) (ϑ radialCutoff : Real → Complex)
    (radialIndices angularIndices : Real → Finset Int)
    (angularCutoff : Int → Euclidean 2 → Complex)
    (hϑ : ∀ t ∈ Icc (1 : Real) 2, ϑ t = 1 ∧ ϑ (-t) = 1)
    (hmeas : ∀ j : Nat, ∀ f : SchwartzMap (Euclidean 2) Complex,
      AEStronglyMeasurable
        (conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) ϑ
          (f : Euclidean 2 → Complex)) volume)
    (hrec : recombination radialCutoff radialIndices angularIndices angularCutoff
      (dyadicBandpassMultiplier C.cutoff 0) ϑ)
    (hfine : fineSquareFunctionEstimate radialIndices angularIndices radialCutoff
      angularCutoff (dyadicBandpassMultiplier C.cutoff 0) ϑ) :
    ∀ η : Real, 0 < η → ∃ A : Real, 0 < A ∧
      ∀ j : Nat, 1 ≤ j → ∀ f : SchwartzMap (Euclidean 2) Complex,
        ∀ σ : WaveSign,
          eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j f) (4 : ENNReal)
              localSmoothingMeasure ≤
            ENNReal.ofReal (A * (2 : Real) ^
              ((j : Real) * ((1 / 8 : Real) + η))) *
              eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := by
  intro η hη
  rcases conicL4Estimate_of_recombination_of_fineSquareFunctionEstimate
    radialCutoff radialIndices angularIndices angularCutoff
    (dyadicBandpassMultiplier C.cutoff 0) ϑ hrec hfine η hη with ⟨A, hA, hbound⟩
  refine ⟨A, hA, ?_⟩
  intro j hj f σ
  have hscale : (2 : Real) ≤ (2 : Real) ^ j := by
    calc
      (2 : Real) = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ j := by exact pow_le_pow_right₀ (by norm_num) hj
  have hconic := hbound ((2 : Real) ^ j) hscale f
  have hpow : ((2 : Real) ^ j) ^ ((1 / 8 : Real) + η) =
      (2 : Real) ^ ((j : Real) * ((1 / 8 : Real) + η)) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : 0 ≤ (2 : Real))]
  cases σ with
  | plus =>
      calc
        eLpNorm (dyadicHalfWaveSpaceTime C.cutoff WaveSign.plus j f) (4 : ENNReal)
            localSmoothingMeasure ≤
          eLpNorm (conicOperator ((2 : Real) ^ j)
            (dyadicBandpassMultiplier C.cutoff 0) ϑ (f : Euclidean 2 → Complex))
            (4 : ENNReal) volume :=
          eLpNorm_dyadicHalfWaveSpaceTime_plus_le_conicOperator C ϑ j f
            (fun t ht => (hϑ t ht).1)
        _ ≤ ENNReal.ofReal (A * ((2 : Real) ^ j) ^ ((1 / 8 : Real) + η)) *
            eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := hconic
        _ = ENNReal.ofReal (A * (2 : Real) ^
            ((j : Real) * ((1 / 8 : Real) + η))) *
            eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := by
          rw [hpow]
  | minus =>
      calc
        eLpNorm (dyadicHalfWaveSpaceTime C.cutoff WaveSign.minus j f) (4 : ENNReal)
            localSmoothingMeasure ≤
          eLpNorm (conicOperator ((2 : Real) ^ j)
            (dyadicBandpassMultiplier C.cutoff 0) ϑ (f : Euclidean 2 → Complex))
            (4 : ENNReal) volume :=
          eLpNorm_dyadicHalfWaveSpaceTime_minus_le_conicOperator C ϑ j f
            (fun t ht => (hϑ t ht).2) (hmeas j f)
        _ ≤ ENNReal.ofReal (A * ((2 : Real) ^ j) ^ ((1 / 8 : Real) + η)) *
            eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := hconic
        _ = ENNReal.ofReal (A * (2 : Real) ^
            ((j : Real) * ((1 / 8 : Real) + η))) *
            eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := by
          rw [hpow]

/-- Conditional `p = 4` local smoothing from one two-sided conic datum.
The recombination and fine-square hypotheses remain explicit: this corollary
only assembles their already proved conic `L⁴` consequence with the exact
dyadic scale normal form. -/
theorem p4LocalSmoothing_of_twoSidedConicData
    (C : lpCutoffs 2) (ϑ radialCutoff : Real → Complex)
    (radialIndices angularIndices : Real → Finset Int)
    (angularCutoff : Int → Euclidean 2 → Complex)
    (hϑ : ∀ t ∈ Icc (1 : Real) 2, ϑ t = 1 ∧ ϑ (-t) = 1)
    (hmeas : ∀ j : Nat, ∀ f : SchwartzMap (Euclidean 2) Complex,
      AEStronglyMeasurable
        (conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) ϑ
          (f : Euclidean 2 → Complex)) volume)
    (hrec : recombination radialCutoff radialIndices angularIndices angularCutoff
      (dyadicBandpassMultiplier C.cutoff 0) ϑ)
    (hfine : fineSquareFunctionEstimate radialIndices angularIndices radialCutoff
      angularCutoff (dyadicBandpassMultiplier C.cutoff 0) ϑ) :
    p4LocalSmoothing C.cutoff := by
  intro η hη
  rcases exists_bothSign_dyadicHalfWaveSpaceTime_L4_bound_of_twoSidedConicData
    C ϑ radialCutoff radialIndices angularIndices angularCutoff hϑ hmeas hrec hfine η hη with
    ⟨A, hA, hbound⟩
  refine ⟨by norm_num, hη, A, hA, ?_⟩
  intro j hj f σ
  have hexponent :
      (j : Real) * (1 / 2 - 1 / 4 - mssGain 4 + η) =
        (j : Real) * ((1 / 8 : Real) + η) := by
    rw [mssGain_four]
    ring
  rw [hexponent]
  have hfour : ENNReal.ofReal (4 : Real) = (4 : ENNReal) := by norm_num
  rw [hfour]
  exact hbound j hj f σ

/-! ## Source--output Marcinkiewicz engines

The MSS operator maps spatial inputs to a space--time output, so the source
measure `volume` and the target `localSmoothingMeasure` must remain distinct.
The following supplied-split layer-cake statements record exactly that
separation.  They are intentionally formulated for an arbitrary additive
source carrier; the later applications use literal Schwartz maps, not an
unproved extension of the half-wave operator to all measurable functions.
-/

/-- Chebyshev in the source--output form needed by the split layer-cake
arguments. -/
theorem sourceOutput_weak_distribution_of_eLpNorm
    {β : Type*} [MeasurableSpace β] {ν : Measure β}
    (u : β → Real) (hu : AEStronglyMeasurable u ν)
    {r t : Real} (hr : 0 < r) (ht : 0 < t) (L : ENNReal)
    (hL : eLpNorm u (ENNReal.ofReal r) ν ≤ L) :
    ν {x | t < u x} * (ENNReal.ofReal t) ^ r ≤ L ^ r := by
  have hrE0 : ENNReal.ofReal r ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hr
  have hrET : ENNReal.ofReal r ≠ ⊤ := ENNReal.ofReal_ne_top
  have hsub : {x | t < u x} ⊆ {x | ENNReal.ofReal t ≤ ‖u x‖ₑ} := by
    intro x hx
    have hux : 0 ≤ u x := le_trans ht.le hx.le
    change ENNReal.ofReal t ≤ ‖u x‖ₑ
    rw [Real.enorm_eq_ofReal hux]
    exact ENNReal.ofReal_le_ofReal hx.le
  have hcheb := mul_meas_ge_le_pow_eLpNorm' ν hrE0 hrET hu
    (ENNReal.ofReal t)
  have hcheb' :
      (ENNReal.ofReal t) ^ r * ν {x | ENNReal.ofReal t ≤ ‖u x‖ₑ} ≤
        eLpNorm u (ENNReal.ofReal r) ν ^ r := by
    simpa only [ENNReal.toReal_ofReal hr.le] using hcheb
  calc
    ν {x | t < u x} * (ENNReal.ofReal t) ^ r =
        (ENNReal.ofReal t) ^ r * ν {x | t < u x} := by ring
    _ ≤ (ENNReal.ofReal t) ^ r * ν {x | ENNReal.ofReal t ≤ ‖u x‖ₑ} :=
      mul_le_mul_right (measure_mono hsub) _
    _ ≤ eLpNorm u (ENNReal.ofReal r) ν ^ r := hcheb'
    _ ≤ L ^ r := ENNReal.rpow_le_rpow hL hr.le

/-- Repackage a weak endpoint with the target layer-cake weight. -/
theorem sourceOutput_twoPair_ofReal_rpow_weight
    {r q t : Real} (ht : 0 < t) :
    ENNReal.ofReal (t ^ (q - 1)) =
      (ENNReal.ofReal (2 : Real)) ^ r *
        (ENNReal.ofReal ((t / 2) ^ r) *
          (ENNReal.ofReal t) ^ (q - r - 1)) := by
  have hhalf : 0 < t / 2 := by positivity
  have htwo : 0 < (2 : Real) := by norm_num
  have hreal :
      t ^ (q - 1) = (2 : Real) ^ r *
        ((t / 2) ^ r * t ^ (q - r - 1)) := by
    calc
      t ^ (q - 1) = t ^ (r + (q - r - 1)) := by congr 1 <;> ring
      _ = t ^ r * t ^ (q - r - 1) := Real.rpow_add ht _ _
      _ = ((2 : Real) ^ r * (t / 2) ^ r) * t ^ (q - r - 1) := by
        rw [← Real.mul_rpow htwo.le hhalf.le]
        congr 1
        ring
      _ = _ := by ring
  rw [hreal]
  rw [ENNReal.ofReal_mul (Real.rpow_nonneg htwo.le _)]
  rw [ENNReal.ofReal_mul (Real.rpow_nonneg hhalf.le _)]
  rw [← ENNReal.ofReal_rpow_of_pos htwo]
  rw [← ENNReal.ofReal_rpow_of_pos hhalf]
  rw [← ENNReal.ofReal_rpow_of_pos ht]

/-- Multiply a weak distribution estimate by the target layer-cake weight. -/
theorem sourceOutput_twoPair_direct_weak_weighted
    {r q t : Real} {m C I : ENNReal} (ht : 0 < t)
    (h : ENNReal.ofReal ((t / 2) ^ r) * m ≤ C * I) :
    m * ENNReal.ofReal (t ^ (q - 1)) ≤
      (ENNReal.ofReal (2 : Real)) ^ r * C * I *
        (ENNReal.ofReal t) ^ (q - r - 1) := by
  rw [sourceOutput_twoPair_ofReal_rpow_weight ht]
  calc
    m * ((ENNReal.ofReal (2 : Real)) ^ r *
        (ENNReal.ofReal ((t / 2) ^ r) *
          (ENNReal.ofReal t) ^ (q - r - 1))) =
        (ENNReal.ofReal ((t / 2) ^ r) * m) *
          ((ENNReal.ofReal (2 : Real)) ^ r *
            (ENNReal.ofReal t) ^ (q - r - 1)) := by ac_rfl
    _ ≤ (C * I) * ((ENNReal.ofReal (2 : Real)) ^ r *
          (ENNReal.ofReal t) ^ (q - r - 1)) :=
      mul_le_mul_of_nonneg_right h (by positivity)
    _ = (ENNReal.ofReal (2 : Real)) ^ r * C * I *
          (ENNReal.ofReal t) ^ (q - r - 1) := by ac_rfl

/-- The source--output two-pair Marcinkiewicz moment coefficient. -/
def sourceOutputTwoPairMarcinkiewiczMomentCoefficient
    (q q₀ q₁ : Real) (C₀ C₁ A₀ A₁ : ENNReal) : ENNReal :=
  ENNReal.ofReal q *
    ((ENNReal.ofReal (2 : Real)) ^ q₀ * C₀ * A₀ +
      (ENNReal.ofReal (2 : Real)) ^ q₁ * C₁ * A₁)

/-- The genuine supplied-split source--output layer-cake calculation. -/
theorem sourceOutput_two_pair_marcinkiewicz_moment_of_split_weak_endpoints
    {β F : Type*} [MeasurableSpace β] [Add F]
    {ν : Measure β} [SFinite ν]
    (D : Set F) (T : F → β → Real)
    (hTnonneg : ∀ g x, 0 ≤ T g x)
    (hTsub : ∀ ⦃g h : F⦄, g ∈ D → h ∈ D →
      ∀ x, T (g + h) x ≤ T g x + T h x)
    {q₀ q q₁ : Real} (hq : 0 < q)
    (C₀ C₁ : ENNReal) (I₀ I₁ : F → ENNReal)
    (hweak₀ : ∀ g, g ∈ D → ∀ ⦃s : Real⦄, 0 < s →
      ENNReal.ofReal (s ^ q₀) * ν {x | s < T g x} ≤ C₀ * I₀ g)
    (hweak₁ : ∀ g, g ∈ D → ∀ ⦃s : Real⦄, 0 < s →
      ENNReal.ofReal (s ^ q₁) * ν {x | s < T g x} ≤ C₁ * I₁ g)
    (f : F) (hTf : AEMeasurable (T f) ν)
    (low high : Real → F)
    (hlow_mem : ∀ t, low t ∈ D) (hhigh_mem : ∀ t, high t ∈ D)
    (hsplit : ∀ t, f = low t + high t)
    (hlowI_meas : Measurable (fun t => I₁ (low t)))
    (hhighI_meas : Measurable (fun t => I₀ (high t)))
    (A₀ A₁ : ENNReal)
    (hhigh_tail :
      (∫⁻ t in Ioi (0 : Real), I₀ (high t) *
        (ENNReal.ofReal t) ^ (q - q₀ - 1)) ≤ A₀)
    (hlow_tail :
      (∫⁻ t in Ioi (0 : Real), I₁ (low t) *
        (ENNReal.ofReal t) ^ (q - q₁ - 1)) ≤ A₁) :
    (∫⁻ x, ENNReal.ofReal ((T f x) ^ q) ∂ν) ≤
      sourceOutputTwoPairMarcinkiewiczMomentCoefficient q q₀ q₁ C₀ C₁ A₀ A₁ := by
  let lowI : Real → ENNReal := fun t => I₁ (low t)
  let highI : Real → ENNReal := fun t => I₀ (high t)
  let w : Real → ENNReal := fun t => ENNReal.ofReal (t ^ (q - 1))
  let whigh : Real → ENNReal := fun t =>
    (ENNReal.ofReal t) ^ (q - q₀ - 1)
  let wlow : Real → ENNReal := fun t =>
    (ENNReal.ofReal t) ^ (q - q₁ - 1)
  have hlowI_meas' : Measurable lowI := by
    simpa only [lowI] using hlowI_meas
  have hhighI_meas' : Measurable highI := by
    simpa only [highI] using hhighI_meas
  have hwhigh : Measurable whigh :=
    ENNReal.continuous_rpow_const.measurable.comp measurable_id.ennreal_ofReal
  have hwlow : Measurable wlow :=
    ENNReal.continuous_rpow_const.measurable.comp measurable_id.ennreal_ofReal
  have hhigh_prod_meas : Measurable (fun t => highI t * whigh t) :=
    hhighI_meas'.mul hwhigh
  have hlow_prod_meas : Measurable (fun t => lowI t * wlow t) :=
    hlowI_meas'.mul hwlow
  have hhigh_meas : Measurable (fun t =>
      (ENNReal.ofReal (2 : Real)) ^ q₀ * C₀ * highI t * whigh t) := by
    rw [show (fun t => (ENNReal.ofReal (2 : Real)) ^ q₀ * C₀ *
        highI t * whigh t) = fun t =>
        ((ENNReal.ofReal (2 : Real)) ^ q₀ * C₀) *
          (highI t * whigh t) by
      funext t
      ac_rfl]
    exact measurable_const.mul hhigh_prod_meas
  have hlow_meas : Measurable (fun t =>
      (ENNReal.ofReal (2 : Real)) ^ q₁ * C₁ * lowI t * wlow t) := by
    rw [show (fun t => (ENNReal.ofReal (2 : Real)) ^ q₁ * C₁ *
        lowI t * wlow t) = fun t =>
        ((ENNReal.ofReal (2 : Real)) ^ q₁ * C₁) *
          (lowI t * wlow t) by
      funext t
      ac_rfl]
    exact measurable_const.mul hlow_prod_meas
  have hhigh_endpoint (t : Real) (ht : 0 < t) :
      ENNReal.ofReal ((t / 2) ^ q₀) *
          ν {x | t / 2 < T (high t) x} ≤ C₀ * highI t := by
    simpa only [highI] using
      hweak₀ (high t) (hhigh_mem t) (by positivity)
  have hlow_endpoint (t : Real) (ht : 0 < t) :
      ENNReal.ofReal ((t / 2) ^ q₁) *
          ν {x | t / 2 < T (low t) x} ≤ C₁ * lowI t := by
    simpa only [lowI] using
      hweak₁ (low t) (hlow_mem t) (by positivity)
  have hhigh_weight (t : Real) (ht : 0 < t) :
      ν {x | t / 2 < T (high t) x} * w t ≤
        (ENNReal.ofReal (2 : Real)) ^ q₀ * C₀ * highI t * whigh t := by
    dsimp only [w, whigh]
    simpa only [ENNReal.ofReal_rpow_of_pos ht] using
      sourceOutput_twoPair_direct_weak_weighted (q := q) ht (hhigh_endpoint t ht)
  have hlow_weight (t : Real) (ht : 0 < t) :
      ν {x | t / 2 < T (low t) x} * w t ≤
        (ENNReal.ofReal (2 : Real)) ^ q₁ * C₁ * lowI t * wlow t := by
    dsimp only [w, wlow]
    simpa only [ENNReal.ofReal_rpow_of_pos ht] using
      sourceOutput_twoPair_direct_weak_weighted (q := q) ht (hlow_endpoint t ht)
  have hdistribution (t : Real) (ht : 0 < t) :
      ν {x | t < T f x} * w t ≤
        (ENNReal.ofReal (2 : Real)) ^ q₀ * C₀ * highI t * whigh t +
          (ENNReal.ofReal (2 : Real)) ^ q₁ * C₁ * lowI t * wlow t := by
    have hsplit' : ν {x | t < T f x} ≤
        ν {x | t / 2 < T (low t) x} +
          ν {x | t / 2 < T (high t) x} :=
      measure_distribution_split_additive ν T f (low t) (high t) t (hsplit t)
        (hTsub (hlow_mem t) (hhigh_mem t))
    calc
      ν {x | t < T f x} * w t ≤
          (ν {x | t / 2 < T (low t) x} +
            ν {x | t / 2 < T (high t) x}) * w t :=
        mul_le_mul_left hsplit' _
      _ = ν {x | t / 2 < T (high t) x} * w t +
          ν {x | t / 2 < T (low t) x} * w t := by
        rw [add_mul]
        ac_rfl
      _ ≤ (ENNReal.ofReal (2 : Real)) ^ q₀ * C₀ * highI t * whigh t +
          (ENNReal.ofReal (2 : Real)) ^ q₁ * C₁ * lowI t * wlow t :=
        add_le_add (hhigh_weight t ht) (hlow_weight t ht)
  have hdistribution_integral :
      (∫⁻ t in Ioi (0 : Real), ν {x | t < T f x} * w t) ≤
        (∫⁻ t in Ioi (0 : Real),
          (ENNReal.ofReal (2 : Real)) ^ q₀ * C₀ * highI t * whigh t) +
          ∫⁻ t in Ioi (0 : Real),
            (ENNReal.ofReal (2 : Real)) ^ q₁ * C₁ * lowI t * wlow t := by
    calc
      (∫⁻ t in Ioi (0 : Real), ν {x | t < T f x} * w t) ≤
          ∫⁻ t in Ioi (0 : Real),
            (ENNReal.ofReal (2 : Real)) ^ q₀ * C₀ * highI t * whigh t +
              (ENNReal.ofReal (2 : Real)) ^ q₁ * C₁ * lowI t * wlow t := by
          apply lintegral_mono_ae
          filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
          exact hdistribution t ht
      _ = (∫⁻ t in Ioi (0 : Real),
          (ENNReal.ofReal (2 : Real)) ^ q₀ * C₀ * highI t * whigh t) +
          ∫⁻ t in Ioi (0 : Real),
            (ENNReal.ofReal (2 : Real)) ^ q₁ * C₁ * lowI t * wlow t :=
        lintegral_add_left hhigh_meas _
  have hhigh_integral :
      (∫⁻ t in Ioi (0 : Real),
        (ENNReal.ofReal (2 : Real)) ^ q₀ * C₀ * highI t * whigh t) =
          (ENNReal.ofReal (2 : Real)) ^ q₀ * C₀ *
            (∫⁻ t in Ioi (0 : Real), highI t * whigh t) := by
    have hconst := lintegral_const_mul
      (μ := volume.restrict (Ioi (0 : Real)))
      ((ENNReal.ofReal (2 : Real)) ^ q₀ * C₀) hhigh_prod_meas
    calc
      (∫⁻ t in Ioi (0 : Real),
          (ENNReal.ofReal (2 : Real)) ^ q₀ * C₀ * highI t * whigh t) =
          ∫⁻ t in Ioi (0 : Real),
            ((ENNReal.ofReal (2 : Real)) ^ q₀ * C₀) *
              (highI t * whigh t) := by
            apply lintegral_congr
            intro t
            ac_rfl
      _ = _ := hconst
  have hlow_integral :
      (∫⁻ t in Ioi (0 : Real),
        (ENNReal.ofReal (2 : Real)) ^ q₁ * C₁ * lowI t * wlow t) =
          (ENNReal.ofReal (2 : Real)) ^ q₁ * C₁ *
            (∫⁻ t in Ioi (0 : Real), lowI t * wlow t) := by
    have hconst := lintegral_const_mul
      (μ := volume.restrict (Ioi (0 : Real)))
      ((ENNReal.ofReal (2 : Real)) ^ q₁ * C₁) hlow_prod_meas
    calc
      (∫⁻ t in Ioi (0 : Real),
          (ENNReal.ofReal (2 : Real)) ^ q₁ * C₁ * lowI t * wlow t) =
          ∫⁻ t in Ioi (0 : Real),
            ((ENNReal.ofReal (2 : Real)) ^ q₁ * C₁) *
              (lowI t * wlow t) := by
            apply lintegral_congr
            intro t
            ac_rfl
      _ = _ := hconst
  calc
    (∫⁻ x, ENNReal.ofReal ((T f x) ^ q) ∂ν) =
        ENNReal.ofReal q *
          (∫⁻ t in Ioi (0 : Real), ν {x | t < T f x} * w t) := by
      simpa only [w] using
        (lintegral_rpow_eq_lintegral_meas_lt_mul ν
          (Filter.Eventually.of_forall (hTnonneg f)) hTf hq)
    _ ≤ ENNReal.ofReal q *
        ((∫⁻ t in Ioi (0 : Real),
          (ENNReal.ofReal (2 : Real)) ^ q₀ * C₀ * highI t * whigh t) +
          ∫⁻ t in Ioi (0 : Real),
            (ENNReal.ofReal (2 : Real)) ^ q₁ * C₁ * lowI t * wlow t) :=
      mul_le_mul_right hdistribution_integral _
    _ = ENNReal.ofReal q *
        ((ENNReal.ofReal (2 : Real)) ^ q₀ * C₀ *
            (∫⁻ t in Ioi (0 : Real), highI t * whigh t) +
          (ENNReal.ofReal (2 : Real)) ^ q₁ * C₁ *
            (∫⁻ t in Ioi (0 : Real), lowI t * wlow t)) := by
      rw [hhigh_integral, hlow_integral]
    _ ≤ ENNReal.ofReal q *
        ((ENNReal.ofReal (2 : Real)) ^ q₀ * C₀ * A₀ +
          (ENNReal.ofReal (2 : Real)) ^ q₁ * C₁ * A₁) := by
      apply mul_le_mul_of_nonneg_left
      exact add_le_add
        (mul_le_mul_of_nonneg_left hhigh_tail (by positivity))
        (mul_le_mul_of_nonneg_left hlow_tail (by positivity))
      positivity
    _ = sourceOutputTwoPairMarcinkiewiczMomentCoefficient q q₀ q₁ C₀ C₁ A₀ A₁ := by
      rfl

/-- Source--output strong-endpoint form of the two-pair calculation. -/
theorem sourceOutput_two_pair_marcinkiewicz_moment_of_strong_endpoints_and_split_tails
    {α β E F : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [Add F]
    {μ : Measure α} {ν : Measure β} [SFinite μ] [SFinite ν]
    (D : Set F) (eval : F → α → E) (T : F → β → Real)
    (hTnonneg : ∀ g x, 0 ≤ T g x)
    (hTsub : ∀ ⦃g h : F⦄, g ∈ D → h ∈ D →
      ∀ x, T (g + h) x ≤ T g x + T h x)
    (hTmeas : ∀ g, g ∈ D → AEStronglyMeasurable (T g) ν)
    {p₀ p₁ q₀ q q₁ : Real}
    (hq₀ : 0 < q₀) (hq₁ : 0 < q₁) (hq : 0 < q)
    (B₀ B₁ : ENNReal)
    (hstrong₀ : ∀ g, g ∈ D →
      eLpNorm (T g) (ENNReal.ofReal q₀) ν ≤
        B₀ * eLpNorm (eval g) (ENNReal.ofReal p₀) μ)
    (hstrong₁ : ∀ g, g ∈ D →
      eLpNorm (T g) (ENNReal.ofReal q₁) ν ≤
        B₁ * eLpNorm (eval g) (ENNReal.ofReal p₁) μ)
    (f : F) (hTf : AEMeasurable (T f) ν)
    (low high : Real → F)
    (hlow_mem : ∀ t, low t ∈ D) (hhigh_mem : ∀ t, high t ∈ D)
    (hsplit : ∀ t, f = low t + high t)
    (hlowI_meas : Measurable (fun t =>
      (eLpNorm (eval (low t)) (ENNReal.ofReal p₁) μ) ^ q₁))
    (hhighI_meas : Measurable (fun t =>
      (eLpNorm (eval (high t)) (ENNReal.ofReal p₀) μ) ^ q₀))
    (A₀ A₁ : ENNReal)
    (hhigh_tail :
      (∫⁻ t in Ioi (0 : Real),
        (eLpNorm (eval (high t)) (ENNReal.ofReal p₀) μ) ^ q₀ *
          (ENNReal.ofReal t) ^ (q - q₀ - 1)) ≤ A₀)
    (hlow_tail :
      (∫⁻ t in Ioi (0 : Real),
        (eLpNorm (eval (low t)) (ENNReal.ofReal p₁) μ) ^ q₁ *
          (ENNReal.ofReal t) ^ (q - q₁ - 1)) ≤ A₁) :
    (∫⁻ x, ENNReal.ofReal ((T f x) ^ q) ∂ν) ≤
      sourceOutputTwoPairMarcinkiewiczMomentCoefficient q q₀ q₁
        (B₀ ^ q₀) (B₁ ^ q₁) A₀ A₁ := by
  have hweak₀ : ∀ g, g ∈ D → ∀ ⦃s : Real⦄, 0 < s →
      ENNReal.ofReal (s ^ q₀) * ν {x | s < T g x} ≤
        B₀ ^ q₀ *
          (eLpNorm (eval g) (ENNReal.ofReal p₀) μ) ^ q₀ := by
    intro g hg s hs
    have hcheb := sourceOutput_weak_distribution_of_eLpNorm (T g) (hTmeas g hg)
      hq₀ hs (B₀ * eLpNorm (eval g) (ENNReal.ofReal p₀) μ)
      (hstrong₀ g hg)
    calc
      ENNReal.ofReal (s ^ q₀) * ν {x | s < T g x} =
          ν {x | s < T g x} * (ENNReal.ofReal s) ^ q₀ := by
            rw [ENNReal.ofReal_rpow_of_pos hs]
            ac_rfl
      _ ≤ (B₀ * eLpNorm (eval g) (ENNReal.ofReal p₀) μ) ^ q₀ := hcheb
      _ = B₀ ^ q₀ *
          (eLpNorm (eval g) (ENNReal.ofReal p₀) μ) ^ q₀ := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ hq₀.le]
  have hweak₁ : ∀ g, g ∈ D → ∀ ⦃s : Real⦄, 0 < s →
      ENNReal.ofReal (s ^ q₁) * ν {x | s < T g x} ≤
        B₁ ^ q₁ *
          (eLpNorm (eval g) (ENNReal.ofReal p₁) μ) ^ q₁ := by
    intro g hg s hs
    have hcheb := sourceOutput_weak_distribution_of_eLpNorm (T g) (hTmeas g hg)
      hq₁ hs (B₁ * eLpNorm (eval g) (ENNReal.ofReal p₁) μ)
      (hstrong₁ g hg)
    calc
      ENNReal.ofReal (s ^ q₁) * ν {x | s < T g x} =
          ν {x | s < T g x} * (ENNReal.ofReal s) ^ q₁ := by
            rw [ENNReal.ofReal_rpow_of_pos hs]
            ac_rfl
      _ ≤ (B₁ * eLpNorm (eval g) (ENNReal.ofReal p₁) μ) ^ q₁ := hcheb
      _ = B₁ ^ q₁ *
          (eLpNorm (eval g) (ENNReal.ofReal p₁) μ) ^ q₁ := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ hq₁.le]
  exact sourceOutput_two_pair_marcinkiewicz_moment_of_split_weak_endpoints
    D T hTnonneg hTsub hq (B₀ ^ q₀) (B₁ ^ q₁)
    (fun g => (eLpNorm (eval g) (ENNReal.ofReal p₀) μ) ^ q₀)
    (fun g => (eLpNorm (eval g) (ENNReal.ofReal p₁) μ) ^ q₁)
    hweak₀ hweak₁ f hTf low high hlow_mem hhigh_mem hsplit
    hlowI_meas hhighI_meas A₀ A₁ hhigh_tail hlow_tail

/-- The change-of-variables factor for a weighted source tail under a
positive amplitude dilation. -/
private theorem sourceOutput_scale_weight
    (s q r : Real) (hs : 0 < s) :
    (ENNReal.ofReal s) ^ (-(q - r - 1)) * ENNReal.ofReal s⁻¹ =
      (ENNReal.ofReal s) ^ (r - q) := by
  rw [ENNReal.ofReal_inv_of_pos hs, ← ENNReal.rpow_neg_one]
  rw [← ENNReal.rpow_add _ _
    (ENNReal.ofReal_ne_zero_iff.mpr hs) ENNReal.ofReal_ne_top]
  congr 1
  ring

/-- Rescale a weighted positive-amplitude tail. -/
private theorem sourceOutput_scaled_weighted_tail
    (G : Real → ENNReal) (hG : Measurable G)
    {q r s : Real} (hs : 0 < s) (A : ENNReal)
    (hA : (∫⁻ t in Ioi (0 : Real), G t *
      (ENNReal.ofReal t) ^ (q - r - 1)) ≤ A) :
    (∫⁻ t in Ioi (0 : Real), G (s * t) *
      (ENNReal.ofReal t) ^ (q - r - 1)) ≤
      (ENNReal.ofReal s) ^ (r - q) * A := by
  calc
    (∫⁻ t in Ioi (0 : Real), G (s * t) *
        (ENNReal.ofReal t) ^ (q - r - 1)) =
        (ENNReal.ofReal s) ^ (-(q - r - 1)) *
          (ENNReal.ofReal s⁻¹ *
            ∫⁻ u in Ioi (0 : Real), G u *
              (ENNReal.ofReal u) ^ (q - r - 1)) :=
      lintegral_Ioi_comp_mul_weight G hG s hs (q - r - 1)
    _ = (ENNReal.ofReal s) ^ (r - q) *
          (∫⁻ u in Ioi (0 : Real), G u *
            (ENNReal.ofReal u) ^ (q - r - 1)) := by
      rw [← mul_assoc, sourceOutput_scale_weight s q r hs]
    _ ≤ (ENNReal.ofReal s) ^ (r - q) * A :=
      mul_le_mul_right hA _

/-- The supplied-split two-pair source--output argument after a positive
amplitude rescaling.  This is the form that retains the correct interpolation
power of a scale-dependent endpoint constant. -/
theorem sourceOutput_two_pair_marcinkiewicz_moment_of_strong_endpoints_and_scaled_split_tails
    {α β E F : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [Add F]
    {μ : Measure α} {ν : Measure β} [SFinite μ] [SFinite ν]
    (D : Set F) (eval : F → α → E) (T : F → β → Real)
    (hTnonneg : ∀ g x, 0 ≤ T g x)
    (hTsub : ∀ ⦃g h : F⦄, g ∈ D → h ∈ D →
      ∀ x, T (g + h) x ≤ T g x + T h x)
    (hTmeas : ∀ g, g ∈ D → AEStronglyMeasurable (T g) ν)
    {p₀ p₁ q₀ q q₁ : Real}
    (hq₀ : 0 < q₀) (hq₁ : 0 < q₁) (hq : 0 < q)
    (B₀ B₁ : ENNReal)
    (hstrong₀ : ∀ g, g ∈ D →
      eLpNorm (T g) (ENNReal.ofReal q₀) ν ≤
        B₀ * eLpNorm (eval g) (ENNReal.ofReal p₀) μ)
    (hstrong₁ : ∀ g, g ∈ D →
      eLpNorm (T g) (ENNReal.ofReal q₁) ν ≤
        B₁ * eLpNorm (eval g) (ENNReal.ofReal p₁) μ)
    (f : F) (hTf : AEMeasurable (T f) ν)
    (low high : Real → F)
    (hlow_mem : ∀ t, low t ∈ D) (hhigh_mem : ∀ t, high t ∈ D)
    (hsplit : ∀ t, f = low t + high t)
    (hlowI_meas : Measurable (fun t =>
      (eLpNorm (eval (low t)) (ENNReal.ofReal p₁) μ) ^ q₁))
    (hhighI_meas : Measurable (fun t =>
      (eLpNorm (eval (high t)) (ENNReal.ofReal p₀) μ) ^ q₀))
    (A₀ A₁ : ENNReal)
    (hhigh_tail :
      (∫⁻ t in Ioi (0 : Real),
        (eLpNorm (eval (high t)) (ENNReal.ofReal p₀) μ) ^ q₀ *
          (ENNReal.ofReal t) ^ (q - q₀ - 1)) ≤ A₀)
    (hlow_tail :
      (∫⁻ t in Ioi (0 : Real),
        (eLpNorm (eval (low t)) (ENNReal.ofReal p₁) μ) ^ q₁ *
          (ENNReal.ofReal t) ^ (q - q₁ - 1)) ≤ A₁)
    (s : Real) (hs : 0 < s) :
    (∫⁻ x, ENNReal.ofReal ((T f x) ^ q) ∂ν) ≤
      sourceOutputTwoPairMarcinkiewiczMomentCoefficient q q₀ q₁
        (B₀ ^ q₀) (B₁ ^ q₁)
        ((ENNReal.ofReal s) ^ (q₀ - q) * A₀)
        ((ENNReal.ofReal s) ^ (q₁ - q) * A₁) := by
  apply sourceOutput_two_pair_marcinkiewicz_moment_of_strong_endpoints_and_split_tails
    D eval T hTnonneg hTsub hTmeas hq₀ hq₁ hq B₀ B₁ hstrong₀ hstrong₁ f hTf
    (fun t => low (s * t)) (fun t => high (s * t))
  · intro t
    exact hlow_mem (s * t)
  · intro t
    exact hhigh_mem (s * t)
  · intro t
    exact hsplit (s * t)
  · exact hlowI_meas.comp (measurable_const_mul s)
  · exact hhighI_meas.comp (measurable_const_mul s)
  · exact sourceOutput_scaled_weighted_tail
      (fun t => (eLpNorm (eval (high t)) (ENNReal.ofReal p₀) μ) ^ q₀)
      hhighI_meas hs A₀ hhigh_tail
  · exact sourceOutput_scaled_weighted_tail
      (fun t => (eLpNorm (eval (low t)) (ENNReal.ofReal p₁) μ) ^ q₁)
      hlowI_meas hs A₁ hlow_tail

/-- Convert a source--output nonnegative moment estimate into an extended
`L^q` norm bound. -/
theorem sourceOutput_eLpNorm_le_of_nonnegative_moment
    {β F : Type*} [MeasurableSpace β] {ν : Measure β}
    (T : F → β → Real) (f : F) {q : Real} (hq : 0 < q)
    (hTnonneg : ∀ x, 0 ≤ T f x) (M : ENNReal)
    (hmoment : (∫⁻ x, ENNReal.ofReal ((T f x) ^ q) ∂ν) ≤ M) :
    eLpNorm (T f) (ENNReal.ofReal q) ν ≤ M ^ q⁻¹ := by
  have hqE0 : ENNReal.ofReal q ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hq
  have hqET : ENNReal.ofReal q ≠ ⊤ := ENNReal.ofReal_ne_top
  have hqinv : (1 : Real) / q = q⁻¹ := by field_simp
  have hmoment' : (∫⁻ x, ‖T f x‖ₑ ^ q ∂ν) ≤ M := by
    calc
      (∫⁻ x, ‖T f x‖ₑ ^ q ∂ν) =
          ∫⁻ x, ENNReal.ofReal ((T f x) ^ q) ∂ν := by
            apply lintegral_congr
            intro x
            rw [Real.enorm_eq_ofReal (hTnonneg x),
              ENNReal.ofReal_rpow_of_nonneg (hTnonneg x) hq.le]
      _ ≤ M := hmoment
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hqE0 hqET,
    ENNReal.toReal_ofReal hq.le, hqinv]
  exact ENNReal.rpow_le_rpow hmoment' (by positivity)

/-- Norm form of the scaled two-pair source--output calculation.  The source
tail constants are expressed relative to the target source `L^q` moment, so
the conclusion has the corresponding homogeneous `L^q` norm factor. -/
theorem sourceOutput_two_pair_eLpNorm_le_of_scaled_strong_endpoints_and_split_tails
    {α β E F : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [Add F]
    {μ : Measure α} {ν : Measure β} [SFinite μ] [SFinite ν]
    (D : Set F) (eval : F → α → E) (T : F → β → Real)
    (hTnonneg : ∀ g x, 0 ≤ T g x)
    (hTsub : ∀ ⦃g h : F⦄, g ∈ D → h ∈ D →
      ∀ x, T (g + h) x ≤ T g x + T h x)
    (hTmeas : ∀ g, g ∈ D → AEStronglyMeasurable (T g) ν)
    {p₀ p₁ q₀ q q₁ : Real}
    (hq₀ : 0 < q₀) (hq₁ : 0 < q₁) (hq : 0 < q)
    (B₀ B₁ : ENNReal)
    (hstrong₀ : ∀ g, g ∈ D →
      eLpNorm (T g) (ENNReal.ofReal q₀) ν ≤
        B₀ * eLpNorm (eval g) (ENNReal.ofReal p₀) μ)
    (hstrong₁ : ∀ g, g ∈ D →
      eLpNorm (T g) (ENNReal.ofReal q₁) ν ≤
        B₁ * eLpNorm (eval g) (ENNReal.ofReal p₁) μ)
    (f : F) (hTf : AEMeasurable (T f) ν)
    (low high : Real → F)
    (hlow_mem : ∀ t, low t ∈ D) (hhigh_mem : ∀ t, high t ∈ D)
    (hsplit : ∀ t, f = low t + high t)
    (hlowI_meas : Measurable (fun t =>
      (eLpNorm (eval (low t)) (ENNReal.ofReal p₁) μ) ^ q₁))
    (hhighI_meas : Measurable (fun t =>
      (eLpNorm (eval (high t)) (ENNReal.ofReal p₀) μ) ^ q₀))
    (A₀ A₁ : ENNReal)
    (hhigh_tail :
      (∫⁻ t in Ioi (0 : Real),
        (eLpNorm (eval (high t)) (ENNReal.ofReal p₀) μ) ^ q₀ *
          (ENNReal.ofReal t) ^ (q - q₀ - 1)) ≤
        A₀ * (eLpNorm (eval f) (ENNReal.ofReal q) μ) ^ q)
    (hlow_tail :
      (∫⁻ t in Ioi (0 : Real),
        (eLpNorm (eval (low t)) (ENNReal.ofReal p₁) μ) ^ q₁ *
          (ENNReal.ofReal t) ^ (q - q₁ - 1)) ≤
        A₁ * (eLpNorm (eval f) (ENNReal.ofReal q) μ) ^ q)
    (s : Real) (hs : 0 < s) :
    eLpNorm (T f) (ENNReal.ofReal q) ν ≤
      (sourceOutputTwoPairMarcinkiewiczMomentCoefficient q q₀ q₁
        (B₀ ^ q₀) (B₁ ^ q₁)
        ((ENNReal.ofReal s) ^ (q₀ - q) * A₀)
        ((ENNReal.ofReal s) ^ (q₁ - q) * A₁)) ^ q⁻¹ *
      eLpNorm (eval f) (ENNReal.ofReal q) μ := by
  let I : ENNReal := (eLpNorm (eval f) (ENNReal.ofReal q) μ) ^ q
  let K : ENNReal := sourceOutputTwoPairMarcinkiewiczMomentCoefficient q q₀ q₁
    (B₀ ^ q₀) (B₁ ^ q₁)
    ((ENNReal.ofReal s) ^ (q₀ - q) * A₀)
    ((ENNReal.ofReal s) ^ (q₁ - q) * A₁)
  have hhigh_tail' :
      (∫⁻ t in Ioi (0 : Real),
        (eLpNorm (eval (high t)) (ENNReal.ofReal p₀) μ) ^ q₀ *
          (ENNReal.ofReal t) ^ (q - q₀ - 1)) ≤ A₀ * I := by
    simpa only [I] using hhigh_tail
  have hlow_tail' :
      (∫⁻ t in Ioi (0 : Real),
        (eLpNorm (eval (low t)) (ENNReal.ofReal p₁) μ) ^ q₁ *
          (ENNReal.ofReal t) ^ (q - q₁ - 1)) ≤ A₁ * I := by
    simpa only [I] using hlow_tail
  have hmoment := sourceOutput_two_pair_marcinkiewicz_moment_of_strong_endpoints_and_scaled_split_tails
    D eval T hTnonneg hTsub hTmeas hq₀ hq₁ hq B₀ B₁ hstrong₀ hstrong₁ f hTf
    low high hlow_mem hhigh_mem hsplit hlowI_meas hhighI_meas (A₀ * I) (A₁ * I)
    hhigh_tail' hlow_tail' s hs
  have hfactor :
      sourceOutputTwoPairMarcinkiewiczMomentCoefficient q q₀ q₁
        (B₀ ^ q₀) (B₁ ^ q₁)
        ((ENNReal.ofReal s) ^ (q₀ - q) * (A₀ * I))
        ((ENNReal.ofReal s) ^ (q₁ - q) * (A₁ * I)) = K * I := by
    simp only [sourceOutputTwoPairMarcinkiewiczMomentCoefficient, K]
    rw [show
      ENNReal.ofReal 2 ^ q₀ * B₀ ^ q₀ *
          (ENNReal.ofReal s ^ (q₀ - q) * (A₀ * I)) +
        ENNReal.ofReal 2 ^ q₁ * B₁ ^ q₁ *
          (ENNReal.ofReal s ^ (q₁ - q) * (A₁ * I)) =
        (ENNReal.ofReal 2 ^ q₀ * B₀ ^ q₀ *
            (ENNReal.ofReal s ^ (q₀ - q) * A₀) +
          ENNReal.ofReal 2 ^ q₁ * B₁ ^ q₁ *
            (ENNReal.ofReal s ^ (q₁ - q) * A₁)) * I by
      rw [add_mul]
      ac_rfl]
    ac_rfl
  have hmoment' : (∫⁻ x, ENNReal.ofReal ((T f x) ^ q) ∂ν) ≤ K * I := by
    rwa [hfactor] at hmoment
  have hout := sourceOutput_eLpNorm_le_of_nonnegative_moment T f hq
    (hTnonneg f) (K * I) hmoment'
  have hroot : (K * I) ^ q⁻¹ =
      K ^ q⁻¹ * eLpNorm (eval f) (ENNReal.ofReal q) μ := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hq.le)]
    dsimp only [I]
    rw [← ENNReal.rpow_mul]
    have hqq : q * q⁻¹ = (1 : Real) := by field_simp
    rw [hqq, ENNReal.rpow_one]
  rw [hroot] at hout
  exact hout

/-! ## Arbitrary-power smooth low tails

The low-amplitude half of the smooth Schwartz split has two pointwise bounds:
it is bounded by `t / 2` at scale `t`, and by the original input.  Tonelli
then gives the weighted tail below for every `0 < p < q`; this is not tied to
the special exponent four. -/

private theorem mss_rpow_mul_lintegral_rpow_Ioi_eq
    {u q p : Real} (hu : 0 ≤ u) (hp : 0 < p) (hpq : p < q) :
    (ENNReal.ofReal u) ^ q *
      (∫⁻ t in Ioi u, (ENNReal.ofReal t) ^ (p - q - 1)) =
      (ENNReal.ofReal (q - p))⁻¹ * (ENNReal.ofReal u) ^ p := by
  rcases hu.eq_or_lt with rfl | hu
  · simp only [ENNReal.ofReal_zero, ENNReal.zero_rpow_of_pos (by linarith),
      zero_mul, ENNReal.zero_rpow_of_pos hp, mul_zero]
  rw [show p - q - 1 = (p - q + 2) - 3 by ring]
  rw [lintegral_rpow_Ioi_eq (p := p - q + 2) (by linarith) hu]
  rw [show p - q + 2 - 2 = p - q by ring]
  rw [show 2 - (p - q + 2) = q - p by ring]
  rw [ENNReal.ofReal_div_of_pos (by linarith : 0 < q - p)]
  rw [← ENNReal.ofReal_rpow_of_pos hu]
  have hu0 : ENNReal.ofReal u ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hu
  have hutop : ENNReal.ofReal u ≠ ⊤ := ENNReal.ofReal_ne_top
  rw [div_eq_mul_inv]
  calc
    ENNReal.ofReal u ^ q *
        (ENNReal.ofReal u ^ (p - q) * (ENNReal.ofReal (q - p))⁻¹) =
        (ENNReal.ofReal u ^ q * ENNReal.ofReal u ^ (p - q)) *
          (ENNReal.ofReal (q - p))⁻¹ := by ac_rfl
    _ = ENNReal.ofReal u ^ p * (ENNReal.ofReal (q - p))⁻¹ := by
      rw [← ENNReal.rpow_add _ _ hu0 hutop]
      congr 1
      ring_nf
    _ = (ENNReal.ofReal (q - p))⁻¹ * ENNReal.ofReal u ^ p := by ac_rfl

/-- The arbitrary-power two-region low-amplitude tail. -/
theorem weighted_low_tail_rpow_le_of_two_region_bounds
    {α E : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    {μ : Measure α} [SFinite μ]
    (u : α → Real) (hu : Measurable u) (hu_nonneg : ∀ x, 0 ≤ u x)
    (low : Real → α → E)
    {p q : Real} (hp : 0 < p) (hpq : p < q)
    (hlow_small : ∀ t x, 0 < t → t ≤ u x →
      (ENNReal.ofReal ‖low t x‖) ^ q ≤ (ENNReal.ofReal (t / 2)) ^ q)
    (hlow_large : ∀ t x, 0 < t → u x < t →
      (ENNReal.ofReal ‖low t x‖) ^ q ≤ (ENNReal.ofReal (u x)) ^ q) :
    (∫⁻ t in Ioi (0 : Real),
      (∫⁻ x, (ENNReal.ofReal ‖low t x‖) ^ q ∂μ) *
        (ENNReal.ofReal t) ^ (p - q - 1)) ≤
      ((ENNReal.ofReal (2 : Real)) ^ (-q) * (ENNReal.ofReal p)⁻¹ +
          (ENNReal.ofReal (q - p))⁻¹) *
        ∫⁻ x, (ENNReal.ofReal (u x)) ^ p ∂μ := by
  have hq : 0 < q := lt_trans hp hpq
  let w : Real → ENNReal := fun t => (ENNReal.ofReal t) ^ (p - q - 1)
  let a : Real → α → ENNReal := fun t x =>
    ({x | t ≤ u x}).indicator (fun _ => (ENNReal.ofReal (t / 2)) ^ q) x
  let b : Real → α → ENNReal := fun t x =>
    ({x | u x < t}).indicator (fun x => (ENNReal.ofReal (u x)) ^ q) x
  have hw : Measurable w := by
    exact ENNReal.continuous_rpow_const.measurable.comp
      ENNReal.continuous_ofReal.measurable
  have ha_meas : Measurable (Function.uncurry a) := by
    change Measurable (({r : Real × α | r.1 ≤ u r.2}).indicator
      (fun r : Real × α => (ENNReal.ofReal (r.1 / 2)) ^ q))
    exact (ENNReal.continuous_rpow_const.measurable.comp
      (ENNReal.continuous_ofReal.measurable.comp (measurable_fst.div_const 2))).indicator
      (measurableSet_le measurable_fst (hu.comp measurable_snd))
  have haI_meas : Measurable (fun t : Real => ∫⁻ x, a t x ∂μ) :=
    Measurable.lintegral_prod_right ha_meas
  have hbound (t : Real) (ht : 0 < t) :
      (∫⁻ x, (ENNReal.ofReal ‖low t x‖) ^ q ∂μ) ≤
        (∫⁻ x, a t x + b t x ∂μ) := by
    apply lintegral_mono
    intro x
    change (ENNReal.ofReal ‖low t x‖) ^ q ≤ a t x + b t x
    by_cases htx : t ≤ u x
    · have h1 := hlow_small t x ht htx
      rw [show a t x = (ENNReal.ofReal (t / 2)) ^ q by simp [a, htx]]
      rw [show b t x = 0 by simp [b, not_lt_of_ge htx]]
      simpa using h1
    · have htx' : u x < t := lt_of_not_ge htx
      rw [show a t x = 0 by simp [a, htx]]
      rw [show b t x = (ENNReal.ofReal (u x)) ^ q by simp [b, htx']]
      simpa using hlow_large t x ht htx'
  have houter :
      (∫⁻ t in Ioi (0 : Real),
        (∫⁻ x, (ENNReal.ofReal ‖low t x‖) ^ q ∂μ) * w t) ≤
      (∫⁻ t in Ioi (0 : Real),
        (∫⁻ x, a t x + b t x ∂μ) * w t) := by
    apply lintegral_mono_ae
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    calc
      (∫⁻ x, (ENNReal.ofReal ‖low t x‖) ^ q ∂μ) * w t =
          w t * (∫⁻ x, (ENNReal.ofReal ‖low t x‖) ^ q ∂μ) := mul_comm _ _
      _ ≤ w t * (∫⁻ x, a t x + b t x ∂μ) := mul_le_mul_right (hbound t ht) _
      _ = (∫⁻ x, a t x + b t x ∂μ) * w t := mul_comm _ _
  have hat_meas (t : Real) : Measurable (a t) := by
    change Measurable (({x | t ≤ u x}).indicator
      (fun _ : α => (ENNReal.ofReal (t / 2)) ^ q))
    exact measurable_const.indicator (measurableSet_le measurable_const hu)
  have houter_split :
      (∫⁻ t in Ioi (0 : Real),
        (∫⁻ x, a t x + b t x ∂μ) * w t) =
      (∫⁻ t in Ioi (0 : Real), (∫⁻ x, a t x ∂μ) * w t) +
        ∫⁻ t in Ioi (0 : Real), (∫⁻ x, b t x ∂μ) * w t := by
    calc
      (∫⁻ t in Ioi (0 : Real),
          (∫⁻ x, a t x + b t x ∂μ) * w t) =
          ∫⁻ t in Ioi (0 : Real),
            ((∫⁻ x, a t x ∂μ) + (∫⁻ x, b t x ∂μ)) * w t := by
          apply lintegral_congr
          intro t
          rw [lintegral_add_left (hat_meas t)]
      _ = ∫⁻ t in Ioi (0 : Real),
          (∫⁻ x, a t x ∂μ) * w t + (∫⁻ x, b t x ∂μ) * w t := by
          apply lintegral_congr
          intro t
          rw [add_mul]
      _ = _ := lintegral_add_left (haI_meas.mul hw) _
  let wa : Real → ENNReal := fun t =>
    (ENNReal.ofReal (2 : Real)) ^ (-q) * (ENNReal.ofReal t) ^ (p - 1)
  have hwa : Measurable wa := by
    exact measurable_const.mul
      (ENNReal.continuous_rpow_const.measurable.comp
        ENNReal.continuous_ofReal.measurable)
  have hsmall_weight (t : Real) (ht : 0 < t) :
      (ENNReal.ofReal (t / 2)) ^ q * w t = wa t := by
    have htzero : ENNReal.ofReal t ≠ 0 := (ENNReal.ofReal_pos.mpr ht).ne'
    have httop : ENNReal.ofReal t ≠ ⊤ := ENNReal.ofReal_ne_top
    have hhalf : ENNReal.ofReal (t / 2) =
        (ENNReal.ofReal (2 : Real))⁻¹ * ENNReal.ofReal t := by
      rw [ENNReal.ofReal_div_of_pos (by norm_num : (0 : Real) < 2)]
      rw [div_eq_mul_inv]
      ac_rfl
    have hhalfpow : (ENNReal.ofReal (t / 2)) ^ q =
        (ENNReal.ofReal (2 : Real)) ^ (-q) * (ENNReal.ofReal t) ^ q := by
      rw [hhalf, ENNReal.mul_rpow_of_nonneg _ _ hq.le, ENNReal.inv_rpow,
        ← ENNReal.rpow_neg]
    have hpows : (ENNReal.ofReal t) ^ q *
        (ENNReal.ofReal t) ^ (p - q - 1) = (ENNReal.ofReal t) ^ (p - 1) := by
      rw [← ENNReal.rpow_add _ _ htzero httop]
      congr 1
      ring
    dsimp only [w, wa]
    calc
      (ENNReal.ofReal (t / 2)) ^ q * (ENNReal.ofReal t) ^ (p - q - 1) =
          ((ENNReal.ofReal (2 : Real)) ^ (-q) * (ENNReal.ofReal t) ^ q) *
            (ENNReal.ofReal t) ^ (p - q - 1) := by rw [hhalfpow]
      _ = (ENNReal.ofReal (2 : Real)) ^ (-q) *
          ((ENNReal.ofReal t) ^ q * (ENNReal.ofReal t) ^ (p - q - 1)) := by ac_rfl
      _ = _ := by rw [hpows]
  have ha_inner (t : Real) (ht : 0 < t) :
      (∫⁻ x, a t x ∂μ) * w t =
        wa t * ∫⁻ x in {x | t ≤ u x}, (1 : ENNReal) ∂μ := by
    change (∫⁻ x, ({x | t ≤ u x}).indicator
      (fun _ => (ENNReal.ofReal (t / 2)) ^ q) x ∂μ) * w t = _
    rw [lintegral_indicator (measurableSet_le measurable_const hu)]
    have hconst :
        (∫⁻ x in {x | t ≤ u x}, (ENNReal.ofReal (t / 2)) ^ q ∂μ) =
          (ENNReal.ofReal (t / 2)) ^ q *
            (∫⁻ x in {x | t ≤ u x}, (1 : ENNReal) ∂μ) := by
      rw [← lintegral_const_mul _ measurable_const]
      apply lintegral_congr
      intro x
      simp
    rw [hconst]
    calc
      ((ENNReal.ofReal (t / 2)) ^ q *
          ∫⁻ x in {x | t ≤ u x}, (1 : ENNReal) ∂μ) * w t =
          ((ENNReal.ofReal (t / 2)) ^ q * w t) *
            ∫⁻ x in {x | t ≤ u x}, (1 : ENNReal) ∂μ := by ac_rfl
      _ = _ := by rw [hsmall_weight t ht]
  have ha_outer :
      (∫⁻ t in Ioi (0 : Real), (∫⁻ x, a t x ∂μ) * w t) =
        ∫⁻ t in Ioi (0 : Real),
          wa t * ∫⁻ x in {x | t ≤ u x}, (1 : ENNReal) ∂μ := by
    apply lintegral_congr_ae
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    exact ha_inner t ht
  have hshift (v : Real) (hv : 0 ≤ v) :
      (∫⁻ t in Ioc (0 : Real) v, (ENNReal.ofReal t) ^ (p - 1)) =
        (ENNReal.ofReal p)⁻¹ * (ENNReal.ofReal v) ^ p := by
    have h := lintegral_rpow_Ioc_eq (p := p + 1) (u := v) (by linarith) hv
    have hpow : p + 1 - 2 = p - 1 := by ring
    rw [hpow] at h
    rw [h]
    rw [show p + 1 - 1 = p by ring]
    rw [ENNReal.ofReal_div_of_pos hp]
    rw [ENNReal.ofReal_rpow_of_nonneg hv hp.le]
    simp [div_eq_mul_inv, mul_comm]
  have hu_pow_meas : Measurable (fun x => (ENNReal.ofReal (u x)) ^ p) :=
    ENNReal.continuous_rpow_const.measurable.comp hu.ennreal_ofReal
  have ha_eval :
      (∫⁻ t in Ioi (0 : Real),
        wa t * ∫⁻ x in {x | t ≤ u x}, (1 : ENNReal) ∂μ) =
        ((ENNReal.ofReal (2 : Real)) ^ (-q) * (ENNReal.ofReal p)⁻¹) *
          (∫⁻ x, (ENNReal.ofReal (u x)) ^ p ∂μ) := by
    rw [lintegral_swap_indicator_le u hu (fun _ => (1 : ENNReal)) measurable_const wa hwa]
    calc
      (∫⁻ x, (1 : ENNReal) * (∫⁻ t in Ioc (0 : Real) (u x), wa t) ∂μ) =
          ∫⁻ x, ((ENNReal.ofReal (2 : Real)) ^ (-q) * (ENNReal.ofReal p)⁻¹) *
            (ENNReal.ofReal (u x)) ^ p ∂μ := by
          apply lintegral_congr
          intro x
          rw [one_mul]
          let r : Real → ENNReal := fun t => (ENNReal.ofReal t) ^ (p - 1)
          have hr : Measurable r :=
            ENNReal.continuous_rpow_const.measurable.comp
              ENNReal.continuous_ofReal.measurable
          change (∫⁻ t in Ioc (0 : Real) (u x),
              (ENNReal.ofReal (2 : Real)) ^ (-q) * r t) = _
          rw [lintegral_const_mul
            (μ := volume.restrict (Ioc (0 : Real) (u x))) _ hr]
          change (ENNReal.ofReal (2 : Real)) ^ (-q) *
              (∫⁻ t in Ioc (0 : Real) (u x), (ENNReal.ofReal t) ^ (p - 1)) = _
          rw [hshift (u x) (hu_nonneg x)]
          ac_rfl
      _ = _ := lintegral_const_mul _ hu_pow_meas
  let v : α → ENNReal := fun x => (ENNReal.ofReal (u x)) ^ q
  have hv : Measurable v :=
    ENNReal.continuous_rpow_const.measurable.comp hu.ennreal_ofReal
  have hb_inner (t : Real) :
      (∫⁻ x, b t x ∂μ) * w t =
        w t * ∫⁻ x in {x | u x < t}, v x ∂μ := by
    change (∫⁻ x, ({x | u x < t}).indicator
      (fun x => (ENNReal.ofReal (u x)) ^ q) x ∂μ) * w t = _
    rw [lintegral_indicator (measurableSet_lt hu measurable_const)]
    exact mul_comm _ _
  have hb_outer :
      (∫⁻ t in Ioi (0 : Real), (∫⁻ x, b t x ∂μ) * w t) =
        ∫⁻ t in Ioi (0 : Real), w t * ∫⁻ x in {x | u x < t}, v x ∂μ := by
    apply lintegral_congr
    intro t
    exact hb_inner t
  have hb_eval :
      (∫⁻ t in Ioi (0 : Real),
        w t * ∫⁻ x in {x | u x < t}, v x ∂μ) =
        (ENNReal.ofReal (q - p))⁻¹ *
          (∫⁻ x, (ENNReal.ofReal (u x)) ^ p ∂μ) := by
    rw [lintegral_swap_indicator_lt u hu hu_nonneg v hv w hw]
    calc
      (∫⁻ x, (ENNReal.ofReal (u x)) ^ q *
          (∫⁻ t in Ioi (u x), (ENNReal.ofReal t) ^ (p - q - 1)) ∂μ) =
          ∫⁻ x, (ENNReal.ofReal (q - p))⁻¹ *
            (ENNReal.ofReal (u x)) ^ p ∂μ := by
          apply lintegral_congr
          intro x
          exact mss_rpow_mul_lintegral_rpow_Ioi_eq (hu_nonneg x) hp hpq
      _ = _ := lintegral_const_mul _ hu_pow_meas
  change (∫⁻ t in Ioi (0 : Real),
      (∫⁻ x, (ENNReal.ofReal ‖low t x‖) ^ q ∂μ) * w t) ≤ _
  calc
    (∫⁻ t in Ioi (0 : Real),
        (∫⁻ x, (ENNReal.ofReal ‖low t x‖) ^ q ∂μ) * w t) ≤
        ∫⁻ t in Ioi (0 : Real),
          (∫⁻ x, a t x + b t x ∂μ) * w t := houter
    _ = (∫⁻ t in Ioi (0 : Real), (∫⁻ x, a t x ∂μ) * w t) +
          ∫⁻ t in Ioi (0 : Real), (∫⁻ x, b t x ∂μ) * w t := houter_split
    _ = ((ENNReal.ofReal (2 : Real)) ^ (-q) * (ENNReal.ofReal p)⁻¹) *
          (∫⁻ x, (ENNReal.ofReal (u x)) ^ p ∂μ) +
        (ENNReal.ofReal (q - p))⁻¹ *
          (∫⁻ x, (ENNReal.ofReal (u x)) ^ p ∂μ) := by
          rw [ha_outer, ha_eval, hb_outer, hb_eval]
    _ = _ := by rw [add_mul]

/-- The smooth Schwartz low truncation satisfies the arbitrary-power tail. -/
theorem smooth_bump_schwartz_low_q_weighted_tail
    {d : Nat} (f : SchwartzMap (Euclidean d) Complex)
    (low high : Real → SchwartzMap (Euclidean d) Complex)
    (hlow : ∀ t x, low t x =
      ((smooth_half_height_bump ((t⁻¹ : Real) • f x) : Real) : Complex) • f x)
    (_hhigh : ∀ t, high t = f - low t)
    {p q : Real} (hp : 0 < p) (hpq : p < q) :
    (∫⁻ t in Ioi (0 : Real),
      (∫⁻ x, (ENNReal.ofReal ‖low t x‖) ^ q) *
        (ENNReal.ofReal t) ^ (p - q - 1)) ≤
      ((ENNReal.ofReal (2 : Real)) ^ (-q) * (ENNReal.ofReal p)⁻¹ +
          (ENNReal.ofReal (q - p))⁻¹) *
        ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := by
  have hq : 0 < q := lt_trans hp hpq
  apply weighted_low_tail_rpow_le_of_two_region_bounds
    (u := fun x : Euclidean d => ‖f x‖)
    (low := fun t x => low t x)
    f.continuous.norm.measurable (fun x => norm_nonneg _) hp hpq
  · intro t x ht htx
    exact ENNReal.rpow_le_rpow
      (ENNReal.ofReal_le_ofReal
        (smooth_low_norm_le_half_height f (low t) ht (hlow t) x)) hq.le
  · intro t x ht htx
    apply ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal ?_) hq.le
    rw [hlow t x, norm_smul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg smooth_half_height_bump.nonneg]
    calc
      (smooth_half_height_bump ((t⁻¹ : Real) • f x) : Real) * ‖f x‖ ≤
          1 * ‖f x‖ :=
            mul_le_mul_of_nonneg_right smooth_half_height_bump.le_one
              (norm_nonneg _)
      _ = ‖f x‖ := one_mul _

/-! ## Source--output supplied-split `L^q`--`L∞` engine -/

/-- The elementary layer-cake weight used at an upper `L∞` endpoint. -/
theorem sourceOutput_ofReal_rpow_weight_q
    {q p t : Real} (ht : 0 < t) :
    ENNReal.ofReal (t ^ (p - 1)) =
      (ENNReal.ofReal (2 : Real)) ^ q *
        ((ENNReal.ofReal (t / 2)) ^ q *
          ENNReal.ofReal (t ^ (p - q - 1))) := by
  have hreal : t ^ (p - 1) =
      2 ^ q * ((t / 2) ^ q * t ^ (p - q - 1)) := by
    calc
      t ^ (p - 1) = t ^ q * t ^ (p - q - 1) := by
        rw [← Real.rpow_add ht]
        congr 1
        ring
      _ = (2 * (t / 2)) ^ q * t ^ (p - q - 1) := by
        congr 2
        ring
      _ = 2 ^ q * ((t / 2) ^ q * t ^ (p - q - 1)) := by
        rw [Real.mul_rpow (by norm_num) (by positivity)]
        ring
  calc
    ENNReal.ofReal (t ^ (p - 1)) =
        ENNReal.ofReal (2 ^ q * ((t / 2) ^ q * t ^ (p - q - 1))) :=
      congrArg ENNReal.ofReal hreal
    _ = (ENNReal.ofReal (2 : Real)) ^ q *
        ((ENNReal.ofReal (t / 2)) ^ q *
          ENNReal.ofReal (t ^ (p - q - 1))) := by
      rw [ENNReal.ofReal_mul (Real.rpow_nonneg (by norm_num) _)]
      rw [ENNReal.ofReal_mul (Real.rpow_nonneg (by positivity) _)]
      rw [← ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : Real) < 2)]
      rw [← ENNReal.ofReal_rpow_of_pos (by positivity : 0 < t / 2)]

/-- Multiply a weak `L^q` distribution estimate by the target weight. -/
theorem sourceOutput_direct_weak_q_weighted
    {q p t : Real} {m C I : ENNReal} (ht : 0 < t)
    (h : (ENNReal.ofReal (t / 2)) ^ q * m ≤ C * I) :
    m * ENNReal.ofReal (t ^ (p - 1)) ≤
      (ENNReal.ofReal (2 : Real)) ^ q * C * I *
        ENNReal.ofReal (t ^ (p - q - 1)) := by
  rw [sourceOutput_ofReal_rpow_weight_q ht]
  calc
    m * ((ENNReal.ofReal (2 : Real)) ^ q *
        ((ENNReal.ofReal (t / 2)) ^ q *
          ENNReal.ofReal (t ^ (p - q - 1)))) =
        ((ENNReal.ofReal (t / 2)) ^ q * m) *
          ((ENNReal.ofReal (2 : Real)) ^ q *
            ENNReal.ofReal (t ^ (p - q - 1))) := by ac_rfl
    _ ≤ (C * I) * ((ENNReal.ofReal (2 : Real)) ^ q *
          ENNReal.ofReal (t ^ (p - q - 1))) :=
      mul_le_mul_of_nonneg_right h (by positivity)
    _ = (ENNReal.ofReal (2 : Real)) ^ q * C * I *
          ENNReal.ofReal (t ^ (p - q - 1)) := by ac_rfl

/-- Supplied-split source--output weak `(q,q)`--`L∞` interpolation. -/
theorem sourceOutput_marcinkiewicz_weak_q_top_on_additive_split
    {α β E F : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [Add F]
    {μ : Measure α} {ν : Measure β} [SFinite μ] [SFinite ν]
    (D : Set F) (eval : F → α → E) (T : F → β → Real)
    (hT_nonneg : ∀ g y, 0 ≤ T g y)
    (hT_subadd : ∀ ⦃g h : F⦄, g ∈ D → h ∈ D →
      ∀ y, T (g + h) y ≤ T g y + T h y)
    (q : Real) (hq : 0 < q) (Cq : ENNReal)
    (hweak_q : ∀ (g : F), g ∈ D → ∀ {s : Real}, 0 < s →
      (ENNReal.ofReal s) ^ q * ν {y | s < T g y} ≤
        Cq * (∫⁻ x, (ENNReal.ofReal ‖eval g x‖) ^ q ∂μ))
    (hT_top : ∀ (g : F), g ∈ D → ∀ (a : Real), 0 ≤ a →
      (∀ x, ‖eval g x‖ ≤ a) → ∀ y, T g y ≤ a)
    {p : Real} (hqp : q < p)
    (f : F) (hTf : AEMeasurable (T f) ν)
    (low high : Real → F)
    (hlow_mem : ∀ t, low t ∈ D) (hhigh_mem : ∀ t, high t ∈ D)
    (hsplit : ∀ t, f = low t + high t)
    (hlow_norm : ∀ t, 0 < t → ∀ x, ‖eval (low t) x‖ ≤ t / 2)
    (hhighI_meas : Measurable (fun t : Real =>
      ∫⁻ x, (ENNReal.ofReal ‖eval (high t) x‖) ^ q ∂μ))
    (Aq : ENNReal)
    (hhigh_tail :
      (∫⁻ t in Ioi (0 : Real),
        (∫⁻ x, (ENNReal.ofReal ‖eval (high t) x‖) ^ q ∂μ) *
          (ENNReal.ofReal t) ^ (p - q - 1)) ≤ Aq) :
    (∫⁻ y, ENNReal.ofReal ((T f y) ^ p) ∂ν) ≤
      ENNReal.ofReal p * ((ENNReal.ofReal (2 : Real)) ^ q * Cq * Aq) := by
  let highI : Real → ENNReal := fun t =>
    ∫⁻ x, (ENNReal.ofReal ‖eval (high t) x‖) ^ q ∂μ
  let w : Real → ENNReal := fun t => ENNReal.ofReal (t ^ (p - 1))
  let whigh : Real → ENNReal := fun t =>
    (ENNReal.ofReal t) ^ (p - q - 1)
  have hp : 0 < p := hq.trans hqp
  have hlow_bound (t : Real) (ht : 0 < t) (y : β) :
      T (low t) y ≤ t / 2 := by
    apply hT_top (low t) (hlow_mem t) (t / 2) (by positivity)
    exact hlow_norm t ht
  have hdistribution (t : Real) (ht : 0 < t) :
      ν {y | t < T f y} ≤ ν {y | t / 2 < T (high t) y} := by
    apply measure_mono
    intro y hy
    rw [hsplit t] at hy
    have hsum := hT_subadd (hlow_mem t) (hhigh_mem t) y
    have hlow := hlow_bound t ht y
    by_contra h
    have hhigh : T (high t) y ≤ t / 2 := le_of_not_gt h
    have : T (low t + high t) y ≤ t := by
      calc
        T (low t + high t) y ≤ T (low t) y + T (high t) y := hsum
        _ ≤ t / 2 + t / 2 := add_le_add hlow hhigh
        _ = t := by ring
    exact (not_lt_of_ge this) hy
  have hhigh_endpoint (t : Real) (ht : 0 < t) :
      (ENNReal.ofReal (t / 2)) ^ q * ν {y | t / 2 < T (high t) y} ≤
        Cq * highI t := by
    simpa only [highI] using hweak_q (high t) (hhigh_mem t) (by positivity)
  have hdistribution_weight (t : Real) (ht : 0 < t) :
      ν {y | t < T f y} * w t ≤
        (ENNReal.ofReal (2 : Real)) ^ q * Cq * highI t * whigh t := by
    dsimp only [w, whigh]
    calc
      ν {y | t < T f y} * ENNReal.ofReal (t ^ (p - 1)) ≤
          ν {y | t / 2 < T (high t) y} * ENNReal.ofReal (t ^ (p - 1)) :=
        mul_le_mul_of_nonneg_right (hdistribution t ht) (by simp)
      _ ≤ (ENNReal.ofReal (2 : Real)) ^ q * Cq * highI t *
          ENNReal.ofReal (t ^ (p - q - 1)) := by
        exact sourceOutput_direct_weak_q_weighted ht (hhigh_endpoint t ht)
      _ = (ENNReal.ofReal (2 : Real)) ^ q * Cq * highI t *
          (ENNReal.ofReal t) ^ (p - q - 1) := by
        rw [ENNReal.ofReal_rpow_of_pos ht]
  have hdistribution_integral :
      (∫⁻ t in Ioi (0 : Real), ν {y | t < T f y} * w t) ≤
        ∫⁻ t in Ioi (0 : Real),
          (ENNReal.ofReal (2 : Real)) ^ q * Cq * highI t * whigh t := by
    apply lintegral_mono_ae
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    exact hdistribution_weight t ht
  have hhigh_tail' :
      (∫⁻ t in Ioi (0 : Real), highI t * whigh t) ≤ Aq := by
    simpa only [highI, whigh] using hhigh_tail
  have hhigh_integral :
      (∫⁻ t in Ioi (0 : Real),
        (ENNReal.ofReal (2 : Real)) ^ q * Cq * highI t * whigh t) ≤
          (ENNReal.ofReal (2 : Real)) ^ q * Cq * Aq := by
    calc
      (∫⁻ t in Ioi (0 : Real),
        (ENNReal.ofReal (2 : Real)) ^ q * Cq * highI t * whigh t) =
          ((ENNReal.ofReal (2 : Real)) ^ q * Cq) *
            (∫⁻ t in Ioi (0 : Real), highI t * whigh t) := by
          have hconst :
              (∫⁻ t in Ioi (0 : Real),
                ((ENNReal.ofReal (2 : Real)) ^ q * Cq) * (highI t * whigh t)) =
                ((ENNReal.ofReal (2 : Real)) ^ q * Cq) *
                  (∫⁻ t in Ioi (0 : Real), highI t * whigh t) :=
            lintegral_const_mul (μ := volume.restrict (Ioi (0 : Real))) _
              (hhighI_meas.mul
                (ENNReal.continuous_rpow_const.measurable.comp
                  measurable_id.ennreal_ofReal))
          calc
            (∫⁻ t in Ioi (0 : Real),
              (ENNReal.ofReal (2 : Real)) ^ q * Cq * highI t * whigh t) =
                ∫⁻ t in Ioi (0 : Real),
                  ((ENNReal.ofReal (2 : Real)) ^ q * Cq) *
                    (highI t * whigh t) := by
                    apply lintegral_congr
                    intro t
                    ac_rfl
            _ = ((ENNReal.ofReal (2 : Real)) ^ q * Cq) *
                (∫⁻ t in Ioi (0 : Real), highI t * whigh t) := hconst
      _ ≤ (ENNReal.ofReal (2 : Real)) ^ q * Cq * Aq :=
        mul_le_mul_of_nonneg_left hhigh_tail' (by positivity)
  calc
    (∫⁻ y, ENNReal.ofReal ((T f y) ^ p) ∂ν) =
        ENNReal.ofReal p *
          (∫⁻ t in Ioi (0 : Real), ν {y | t < T f y} * w t) := by
      simpa only [w] using
        (lintegral_rpow_eq_lintegral_meas_lt_mul ν
          (Filter.Eventually.of_forall (hT_nonneg f)) hTf hp)
    _ ≤ ENNReal.ofReal p *
        (∫⁻ t in Ioi (0 : Real),
          (ENNReal.ofReal (2 : Real)) ^ q * Cq * highI t * whigh t) :=
      mul_le_mul_right hdistribution_integral _
    _ ≤ ENNReal.ofReal p * ((ENNReal.ofReal (2 : Real)) ^ q * Cq * Aq) :=
      mul_le_mul_of_nonneg_left hhigh_integral (by positivity)

/-! ## Literal Schwartz half-wave additivity -/

private noncomputable def mssHalfWaveOutputSchwartz
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) : SchwartzMap (Euclidean 2) Complex :=
  𝓕⁻ (SchwartzMap.smulLeftCLM Complex
    (dyadicHalfWaveSchwartzSymbol C σ j t : Euclidean 2 → Complex) (𝓕 f))

private theorem mssHalfWaveOutputSchwartz_apply
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    mssHalfWaveOutputSchwartz C σ j t f x = dyadicHalfWave C.cutoff σ j t f x := by
  unfold mssHalfWaveOutputSchwartz
  rw [SchwartzMap.fourierInv_coe]
  apply congrArg (fun q : Euclidean 2 → Complex => 𝓕⁻ q x)
  funext ξ
  simp only [SchwartzMap.smulLeftCLM_apply
    (dyadicHalfWaveSchwartzSymbol C σ j t).hasTemperateGrowth, smul_eq_mul,
    dyadicHalfWaveSchwartzSymbol_apply, dyadicHalfWaveSymbol,
    SchwartzMap.fourier_coe]

private theorem mssHalfWaveOutputSchwartz_add
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (f g : SchwartzMap (Euclidean 2) Complex) :
    mssHalfWaveOutputSchwartz C σ j t (f + g) =
      mssHalfWaveOutputSchwartz C σ j t f + mssHalfWaveOutputSchwartz C σ j t g := by
  unfold mssHalfWaveOutputSchwartz
  rw [fourier_add f g]
  rw [(SchwartzMap.smulLeftCLM Complex
    (dyadicHalfWaveSchwartzSymbol C σ j t : Euclidean 2 → Complex)).map_add]
  rw [fourierInv_add]

/-- The literal frequency-localized half-wave is additive on its Schwartz
input core. -/
theorem dyadicHalfWave_add
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (f g : SchwartzMap (Euclidean 2) Complex) :
    dyadicHalfWave C.cutoff σ j t (f + g) =
      dyadicHalfWave C.cutoff σ j t f + dyadicHalfWave C.cutoff σ j t g := by
  funext x
  rw [← mssHalfWaveOutputSchwartz_apply C σ j t (f + g) x,
    mssHalfWaveOutputSchwartz_add]
  change mssHalfWaveOutputSchwartz C σ j t f x +
      mssHalfWaveOutputSchwartz C σ j t g x = _
  rw [mssHalfWaveOutputSchwartz_apply, mssHalfWaveOutputSchwartz_apply]
  rfl

/-- The corresponding space--time half-wave is additive on Schwartz inputs. -/
theorem dyadicHalfWaveSpaceTime_add
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (f g : SchwartzMap (Euclidean 2) Complex) :
    dyadicHalfWaveSpaceTime C.cutoff σ j (f + g) =
      dyadicHalfWaveSpaceTime C.cutoff σ j f +
        dyadicHalfWaveSpaceTime C.cutoff σ j g := by
  funext z
  change dyadicHalfWave C.cutoff σ j z.2 (f + g) z.1 = _
  rw [dyadicHalfWave_add]
  rfl

/-! ## Slab-local half-wave magnitudes -/

/-- The nonnegative half-wave magnitude, set to zero off the time slab that
carries `localSmoothingMeasure`.  This wrapper lets a genuinely slab-local
pointwise endpoint feed a source--output interpolation theorem whose top
endpoint is pointwise on its full output type. -/
noncomputable def localDyadicHalfWaveMagnitude
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 × Real → Real :=
  {z | z.2 ∈ Icc (1 : Real) 2}.indicator
    (fun z => ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖)

theorem localDyadicHalfWaveMagnitude_nonneg
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) (z : Euclidean 2 × Real) :
    0 ≤ localDyadicHalfWaveMagnitude C σ j f z := by
  unfold localDyadicHalfWaveMagnitude
  by_cases hz : z ∈ {z | z.2 ∈ Icc (1 : Real) 2}
  · rw [Set.indicator_of_mem hz]
    positivity
  · rw [Set.indicator_of_notMem hz]

theorem measurable_localDyadicHalfWaveMagnitude
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Measurable (localDyadicHalfWaveMagnitude C σ j f) := by
  unfold localDyadicHalfWaveMagnitude
  apply (continuous_dyadicHalfWaveSpaceTime C σ j f).measurable.norm.indicator
  exact measurableSet_Icc.preimage measurable_snd

/-- The zero-off-slab wrapper agrees almost everywhere with the literal
space--time half-wave under the local smoothing measure. -/
theorem localDyadicHalfWaveMagnitude_ae_eq
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) :
    localDyadicHalfWaveMagnitude C σ j f =ᵐ[localSmoothingMeasure]
      fun z => ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖ := by
  have htime : ∀ᵐ t : Real ∂(volume.restrict (Icc (1 : Real) 2)),
      t ∈ Icc (1 : Real) 2 := ae_restrict_mem measurableSet_Icc
  have hslab : ∀ᵐ z : Euclidean 2 × Real ∂localSmoothingMeasure,
      z.2 ∈ Icc (1 : Real) 2 := by
    rw [localSmoothingMeasure]
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards with x
      exact htime
    · exact measurableSet_Icc.preimage measurable_snd
  filter_upwards [hslab] with z hz
  have hz' : z ∈ {z : Euclidean 2 × Real | z.2 ∈ Icc (1 : Real) 2} := hz
  rw [show localDyadicHalfWaveMagnitude C σ j f z =
      ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖ by
    unfold localDyadicHalfWaveMagnitude
    change ({z : Euclidean 2 × Real | z.2 ∈ Icc (1 : Real) 2}.indicator
      (fun z : Euclidean 2 × Real =>
        ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖)) z = _
    exact Set.indicator_of_mem hz'
      (fun z : Euclidean 2 × Real =>
        ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖)]

theorem localDyadicHalfWaveMagnitude_add_le
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (f g : SchwartzMap (Euclidean 2) Complex) (z : Euclidean 2 × Real) :
    localDyadicHalfWaveMagnitude C σ j (f + g) z ≤
      localDyadicHalfWaveMagnitude C σ j f z +
        localDyadicHalfWaveMagnitude C σ j g z := by
  unfold localDyadicHalfWaveMagnitude
  by_cases hz : z ∈ {z | z.2 ∈ Icc (1 : Real) 2}
  · rw [Set.indicator_of_mem hz, Set.indicator_of_mem hz,
      Set.indicator_of_mem hz]
    rw [dyadicHalfWaveSpaceTime_add]
    exact norm_add_le _ _
  · rw [Set.indicator_of_notMem hz, Set.indicator_of_notMem hz,
      Set.indicator_of_notMem hz]
    positivity

/-- Transport the proved fixed-time MSS endpoint to the slab-local magnitude.
No pointwise assertion is made off the physical time slab. -/
theorem localDyadicHalfWaveMagnitude_top
    (C : lpCutoffs 2) {B : Real} (hB : 0 < B)
    (hInfty : ∀ (σ : WaveSign) (j : Nat), 1 ≤ j →
      ∀ t : Real, t ∈ Icc (1 : Real) 2 →
        ∀ (f : SchwartzMap (Euclidean 2) Complex) {A : Real},
          (∀ x, ‖f x‖ ≤ A) → ∀ x,
            ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
              (B * Real.sqrt ((2 : Real) ^ j)) * A)
    (σ : WaveSign) (j : Nat) (hj : 1 ≤ j)
    (f : SchwartzMap (Euclidean 2) Complex) {A : Real}
    (hf : ∀ x, ‖f x‖ ≤ A) :
    ∀ z, localDyadicHalfWaveMagnitude C σ j f z ≤
      (B * Real.sqrt ((2 : Real) ^ j)) * A := by
  intro z
  by_cases hz : z ∈ {z | z.2 ∈ Icc (1 : Real) 2}
  · rw [show localDyadicHalfWaveMagnitude C σ j f z =
      ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖ by
      unfold localDyadicHalfWaveMagnitude
      change ({z : Euclidean 2 × Real | z.2 ∈ Icc (1 : Real) 2}.indicator
        (fun z : Euclidean 2 × Real =>
          ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖)) z = _
      exact Set.indicator_of_mem hz
        (fun z : Euclidean 2 × Real =>
          ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖)]
    exact hInfty σ j hj z.2 hz f hf z.1
  · rw [show localDyadicHalfWaveMagnitude C σ j f z = 0 by
      unfold localDyadicHalfWaveMagnitude
      change ({z : Euclidean 2 × Real | z.2 ∈ Icc (1 : Real) 2}.indicator
        (fun z : Euclidean 2 × Real =>
          ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖)) z = _
      exact Set.indicator_of_notMem hz
        (fun z : Euclidean 2 × Real =>
          ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖)]
    have hA : 0 ≤ A := le_trans (norm_nonneg (f 0)) (hf 0)
    positivity

/-! ## Literal Schwartz interpolation specializations -/

private theorem mss_measurable_smooth_low_profile_lintegrals
    {d : Nat} (f : SchwartzMap (Euclidean d) Complex)
    (low high : Real → SchwartzMap (Euclidean d) Complex)
    (hlow : ∀ t x, low t x =
      ((smooth_half_height_bump ((t⁻¹ : Real) • f x) : Real) : Complex) • f x)
    (_hhigh : ∀ t, high t = f - low t)
    {μ : Measure (Euclidean d)} [SFinite μ] (q : Real) :
    Measurable (fun t : Real => ∫⁻ x,
      (ENNReal.ofReal ‖low t x‖) ^ q ∂μ) := by
  have hjoint : Measurable (fun z : Real × Euclidean d => low z.1 z.2) := by
    rw [show (fun z : Real × Euclidean d => low z.1 z.2) =
      fun z => ((smooth_half_height_bump ((z.1⁻¹ : Real) • f z.2) : Real) : Complex) •
        f z.2 by
      funext z
      exact hlow z.1 z.2]
    let η : ContDiffBump (0 : Complex) := smooth_half_height_bump
    have hf : Measurable (fun z : Real × Euclidean d => f z.2) :=
      f.continuous.measurable.comp measurable_snd
    have hscale : Measurable (fun z : Real × Euclidean d =>
        (z.1⁻¹ : Real) • f z.2) :=
      measurable_fst.inv.smul hf
    have hcut_real : Measurable (fun z : Real × Euclidean d =>
        η ((z.1⁻¹ : Real) • f z.2)) :=
      η.continuous.measurable.comp hscale
    have hcut : Measurable (fun z : Real × Euclidean d =>
        ((η ((z.1⁻¹ : Real) • f z.2) : Real) : Complex)) :=
      Complex.ofRealCLM.continuous.measurable.comp hcut_real
    exact hcut.smul hf
  apply Measurable.lintegral_prod_right
  exact ENNReal.continuous_rpow_const.measurable.comp
    hjoint.norm.ennreal_ofReal

/-- The literal cutoff half-wave on the Schwartz core obeys the scaled
two-pair `L²`--`L⁴` interpolation estimate.  The scale `s` is intentionally
supplied explicitly: choosing it from the `L⁴` endpoint coefficient is what
recovers the correct interpolation exponent. -/
theorem mss_two_four_coefficient
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    {p : Real} (hp2 : 2 < p) (hp4 : p < 4)
    (B4 : ENNReal)
    (hstrong4 : ∀ g : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j g) (ENNReal.ofReal 4)
          localSmoothingMeasure ≤
        B4 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume)
    (s : Real) (hs : 0 < s)
    (f : SchwartzMap (Euclidean 2) Complex) :
    eLpNorm (localDyadicHalfWaveMagnitude C σ j f) (ENNReal.ofReal p)
        localSmoothingMeasure ≤
      (sourceOutputTwoPairMarcinkiewiczMomentCoefficient p 2 4
        ((ENNReal.ofReal 2) ^ (2 : Real)) (B4 ^ (4 : Real))
        ((ENNReal.ofReal s) ^ ((2 : Real) - p) *
          ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2)))
        ((ENNReal.ofReal s) ^ ((4 : Real) - p) *
          ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
            (ENNReal.ofReal (4 - p))⁻¹))) ^ p⁻¹ *
      eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
  letI : SFinite localSmoothingMeasure := by
    rw [localSmoothingMeasure]
    infer_instance
  let D : Set (SchwartzMap (Euclidean 2) Complex) := Set.univ
  let eval : SchwartzMap (Euclidean 2) Complex → Euclidean 2 → Complex := fun g => g
  let T : SchwartzMap (Euclidean 2) Complex → Euclidean 2 × Real → Real :=
    fun g => localDyadicHalfWaveMagnitude C σ j g
  have hTnonneg : ∀ g x, 0 ≤ T g x := by
    intro g x
    exact localDyadicHalfWaveMagnitude_nonneg C σ j g x
  have hTsub : ∀ ⦃g h : SchwartzMap (Euclidean 2) Complex⦄,
      g ∈ D → h ∈ D → ∀ x, T (g + h) x ≤ T g x + T h x := by
    intro g h _ _ x
    exact localDyadicHalfWaveMagnitude_add_le C σ j g h x
  have hTmeas : ∀ g, g ∈ D → AEStronglyMeasurable (T g) localSmoothingMeasure := by
    intro g _
    exact (measurable_localDyadicHalfWaveMagnitude C σ j g).aestronglyMeasurable
  have hstrong2 : ∀ g, g ∈ D →
      eLpNorm (T g) (ENNReal.ofReal 2) localSmoothingMeasure ≤
        ENNReal.ofReal 2 * eLpNorm (eval g) (ENNReal.ofReal 2) volume := by
    intro g _
    calc
      eLpNorm (T g) (ENNReal.ofReal 2) localSmoothingMeasure =
          eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j g)
            (ENNReal.ofReal 2) localSmoothingMeasure := by
            rw [eLpNorm_congr_ae (localDyadicHalfWaveMagnitude_ae_eq C σ j g),
              eLpNorm_norm]
      _ ≤ ENNReal.ofReal 2 * eLpNorm (g : Euclidean 2 → Complex)
          (ENNReal.ofReal 2) volume := localL2Endpoint_proof C j g σ
      _ = ENNReal.ofReal 2 * eLpNorm (eval g) (ENNReal.ofReal 2) volume := rfl
  have hstrong4' : ∀ g, g ∈ D →
      eLpNorm (T g) (ENNReal.ofReal 4) localSmoothingMeasure ≤
        B4 * eLpNorm (eval g) (ENNReal.ofReal 4) volume := by
    intro g _
    calc
      eLpNorm (T g) (ENNReal.ofReal 4) localSmoothingMeasure =
          eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j g)
            (ENNReal.ofReal 4) localSmoothingMeasure := by
            rw [eLpNorm_congr_ae (localDyadicHalfWaveMagnitude_ae_eq C σ j g),
              eLpNorm_norm]
      _ ≤ B4 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume :=
        hstrong4 g
      _ = B4 * eLpNorm (eval g) (ENNReal.ofReal 4) volume := rfl
  have hTf : AEMeasurable (T f) localSmoothingMeasure :=
    (hTmeas f (by simp [D])).aemeasurable
  rcases exists_schwartz_smooth_low_high_family f with
    ⟨low, high, hlow, hhigh, hsplit⟩
  have hlowI_raw : Measurable (fun t : Real => ∫⁻ x,
      (ENNReal.ofReal ‖low t x‖) ^ (4 : Real)) :=
    mss_measurable_smooth_low_profile_lintegrals f low high hlow hhigh 4
  have hhighI_raw : Measurable (fun t : Real => ∫⁻ x,
      (ENNReal.ofReal ‖high t x‖) ^ (2 : Real)) :=
    measurable_smooth_high_profile_lintegrals f low high hlow hhigh 2
  have hlowI_meas : Measurable (fun t =>
      (eLpNorm (eval (low t)) (ENNReal.ofReal 4) volume) ^ (4 : Real)) := by
    rw [show (fun t =>
      (eLpNorm (eval (low t)) (ENNReal.ofReal 4) volume) ^ (4 : Real)) =
      fun t => ∫⁻ x, (ENNReal.ofReal ‖low t x‖) ^ (4 : Real) by
      funext t
      exact (lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow (by norm_num) (low t)).symm]
    exact hlowI_raw
  have hhighI_meas : Measurable (fun t =>
      (eLpNorm (eval (high t)) (ENNReal.ofReal 2) volume) ^ (2 : Real)) := by
    rw [show (fun t =>
      (eLpNorm (eval (high t)) (ENNReal.ofReal 2) volume) ^ (2 : Real)) =
      fun t => ∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ (2 : Real) by
      funext t
      exact (lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow (by norm_num) (high t)).symm]
    exact hhighI_raw
  have hhighTailRaw := smooth_bump_schwartz_high_q_weighted_tail f low high hlow hhigh
    (q := 2) (p := p) (by norm_num) hp2
  have hhigh_tail :
      (∫⁻ t in Ioi (0 : Real),
        (eLpNorm (eval (high t)) (ENNReal.ofReal 2) volume) ^ (2 : Real) *
          (ENNReal.ofReal t) ^ (p - 2 - 1)) ≤
        ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2)) *
          (eLpNorm (eval f) (ENNReal.ofReal p) volume) ^ p := by
    calc
      (∫⁻ t in Ioi (0 : Real),
        (eLpNorm (eval (high t)) (ENNReal.ofReal 2) volume) ^ (2 : Real) *
          (ENNReal.ofReal t) ^ (p - 2 - 1)) =
        ∫⁻ t in Ioi (0 : Real),
          (∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ (2 : Real)) *
            (ENNReal.ofReal t) ^ (p - 2 - 1) := by
          apply lintegral_congr
          intro t
          exact congrArg (fun a => a * (ENNReal.ofReal t) ^ (p - 2 - 1))
            (lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow (by norm_num) (high t)).symm
      _ ≤ ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2)) *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := hhighTailRaw
      _ = _ := by rw [lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow (lt_trans (by norm_num) hp2) f]
  have hlowTailRaw := smooth_bump_schwartz_low_q_weighted_tail f low high hlow hhigh
    (p := p) (q := 4) (lt_trans (by norm_num) hp2) hp4
  have hlow_tail :
      (∫⁻ t in Ioi (0 : Real),
        (eLpNorm (eval (low t)) (ENNReal.ofReal 4) volume) ^ (4 : Real) *
          (ENNReal.ofReal t) ^ (p - 4 - 1)) ≤
        ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
          (ENNReal.ofReal (4 - p))⁻¹) *
          (eLpNorm (eval f) (ENNReal.ofReal p) volume) ^ p := by
    calc
      (∫⁻ t in Ioi (0 : Real),
        (eLpNorm (eval (low t)) (ENNReal.ofReal 4) volume) ^ (4 : Real) *
          (ENNReal.ofReal t) ^ (p - 4 - 1)) =
        ∫⁻ t in Ioi (0 : Real),
          (∫⁻ x, (ENNReal.ofReal ‖low t x‖) ^ (4 : Real)) *
            (ENNReal.ofReal t) ^ (p - 4 - 1) := by
          apply lintegral_congr
          intro t
          exact congrArg (fun a => a * (ENNReal.ofReal t) ^ (p - 4 - 1))
            (lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow (by norm_num) (low t)).symm
      _ ≤ ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
          (ENNReal.ofReal (4 - p))⁻¹) *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := hlowTailRaw
      _ = _ := by rw [lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow (lt_trans (by norm_num) hp2) f]
  exact sourceOutput_two_pair_eLpNorm_le_of_scaled_strong_endpoints_and_split_tails
    D eval T hTnonneg hTsub hTmeas (by norm_num) (by norm_num)
    (lt_trans (by norm_num) hp2) (ENNReal.ofReal 2) B4 hstrong2 hstrong4' f hTf low high
    (fun _ => by simp [D]) (fun _ => by simp [D])
    (fun t => by ext x; exact hsplit t x) hlowI_meas hhighI_meas
    ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2))
    ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
      (ENNReal.ofReal (4 - p))⁻¹)
    hhigh_tail hlow_tail s hs

/-- The literal cutoff half-wave on the Schwartz core obeys the supplied-split
`L⁴`--`L∞` interpolation estimate.  The top endpoint is transported through
`localDyadicHalfWaveMagnitude`, so it is never asserted outside `[1,2]`. -/
theorem mss_four_top_coefficient
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    {p : Real} (hp4 : 4 < p)
    (B4 : ENNReal)
    (hstrong4 : ∀ g : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j g) (ENNReal.ofReal 4)
          localSmoothingMeasure ≤
        B4 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume)
    (Btop : Real) (hBtop : 0 < Btop)
    (hTop : ∀ (g : SchwartzMap (Euclidean 2) Complex) (a : Real), 0 ≤ a →
      (∀ x, ‖g x‖ ≤ a) → ∀ z,
        localDyadicHalfWaveMagnitude C σ j g z ≤ Btop * a)
    (f : SchwartzMap (Euclidean 2) Complex) :
    eLpNorm (localDyadicHalfWaveMagnitude C σ j f) (ENNReal.ofReal p)
        localSmoothingMeasure ≤
      ENNReal.ofReal Btop *
        (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
          (B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) *
          ((ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)))) ^ p⁻¹ *
      eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
  letI : SFinite localSmoothingMeasure := by
    rw [localSmoothingMeasure]
    infer_instance
  let D : Set (SchwartzMap (Euclidean 2) Complex) := Set.univ
  let eval : SchwartzMap (Euclidean 2) Complex → Euclidean 2 → Complex := fun g => g
  let T : SchwartzMap (Euclidean 2) Complex → Euclidean 2 × Real → Real :=
    fun g => localDyadicHalfWaveMagnitude C σ j g
  let S : SchwartzMap (Euclidean 2) Complex → Euclidean 2 × Real → Real :=
    fun g z => T g z / Btop
  have hSnonneg : ∀ g z, 0 ≤ S g z := by
    intro g z
    exact div_nonneg (localDyadicHalfWaveMagnitude_nonneg C σ j g z) hBtop.le
  have hSsub : ∀ ⦃g h : SchwartzMap (Euclidean 2) Complex⦄,
      g ∈ D → h ∈ D → ∀ z, S (g + h) z ≤ S g z + S h z := by
    intro g h _ _ z
    change T (g + h) z / Btop ≤ T g z / Btop + T h z / Btop
    rw [← add_div]
    exact div_le_div_of_nonneg_right
      (localDyadicHalfWaveMagnitude_add_le C σ j g h z) hBtop.le
  have hSmeas : ∀ g, g ∈ D → AEStronglyMeasurable (S g) localSmoothingMeasure := by
    intro g _
    exact ((measurable_localDyadicHalfWaveMagnitude C σ j g).div_const Btop).aestronglyMeasurable
  have hSstrong : ∀ g, g ∈ D →
      eLpNorm (S g) (ENNReal.ofReal 4) localSmoothingMeasure ≤
        (B4 * (ENNReal.ofReal Btop)⁻¹) *
          eLpNorm (eval g) (ENNReal.ofReal 4) volume := by
    intro g _
    have hSeq : S g = (Btop⁻¹) • T g := by
      funext z
      change T g z / Btop = Btop⁻¹ * T g z
      field_simp [hBtop.ne']
    calc
      eLpNorm (S g) (ENNReal.ofReal 4) localSmoothingMeasure =
          ENNReal.ofReal (Btop⁻¹) * eLpNorm (T g) (ENNReal.ofReal 4)
            localSmoothingMeasure := by
            rw [hSeq, eLpNorm_const_smul]
            rw [Real.enorm_eq_ofReal (inv_nonneg.mpr hBtop.le)]
      _ ≤ ENNReal.ofReal (Btop⁻¹) *
          (B4 * eLpNorm (eval g) (ENNReal.ofReal 4) volume) := by
            apply mul_le_mul_right
            calc
              eLpNorm (T g) (ENNReal.ofReal 4) localSmoothingMeasure =
                  eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j g)
                    (ENNReal.ofReal 4) localSmoothingMeasure := by
                    rw [eLpNorm_congr_ae
                      (localDyadicHalfWaveMagnitude_ae_eq C σ j g), eLpNorm_norm]
              _ ≤ B4 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume :=
                hstrong4 g
              _ = B4 * eLpNorm (eval g) (ENNReal.ofReal 4) volume := rfl
      _ = (B4 * (ENNReal.ofReal Btop)⁻¹) *
          eLpNorm (eval g) (ENNReal.ofReal 4) volume := by
            rw [ENNReal.ofReal_inv_of_pos hBtop]
            ac_rfl
  have hSweak : ∀ g, g ∈ D → ∀ {u : Real}, 0 < u →
      (ENNReal.ofReal u) ^ (4 : Real) *
          localSmoothingMeasure {z | u < S g z} ≤
        (B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) *
          (∫⁻ x, (ENNReal.ofReal ‖eval g x‖) ^ (4 : Real)) := by
    intro g _ u hu
    have hcheb := sourceOutput_weak_distribution_of_eLpNorm (S g)
      (hSmeas g (by simp [D])) (by norm_num : (0 : Real) < 4) hu
      ((B4 * (ENNReal.ofReal Btop)⁻¹) *
        eLpNorm (eval g) (ENNReal.ofReal 4) volume) (hSstrong g (by simp [D]))
    calc
      (ENNReal.ofReal u) ^ (4 : Real) *
          localSmoothingMeasure {z | u < S g z} =
          localSmoothingMeasure {z | u < S g z} * (ENNReal.ofReal u) ^ (4 : Real) := by
            ac_rfl
      _ ≤ ((B4 * (ENNReal.ofReal Btop)⁻¹) *
          eLpNorm (eval g) (ENNReal.ofReal 4) volume) ^ (4 : Real) := hcheb
      _ = (B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) *
          (eLpNorm (eval g) (ENNReal.ofReal 4) volume) ^ (4 : Real) := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]
      _ = _ := by
            rw [← lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow (by norm_num) (eval g)]
  have hStop : ∀ g, g ∈ D → ∀ a : Real, 0 ≤ a →
      (∀ x, ‖eval g x‖ ≤ a) → ∀ z, S g z ≤ a := by
    intro g _ a ha hga z
    change T g z / Btop ≤ a
    rw [div_le_iff₀ hBtop]
    simpa [mul_comm] using hTop g a ha hga z
  rcases exists_schwartz_smooth_low_high_family f with
    ⟨low, high, hlow, hhigh, hsplit⟩
  have hhighI_meas : Measurable (fun t : Real => ∫⁻ x,
      (ENNReal.ofReal ‖eval (high t) x‖) ^ (4 : Real)) := by
    simpa only [eval] using
      (measurable_smooth_high_profile_lintegrals f low high hlow hhigh 4)
  have hhighTailRaw := smooth_bump_schwartz_high_q_weighted_tail f low high hlow hhigh
    (q := 4) (p := p) (by norm_num) hp4
  have hhigh_tail :
      (∫⁻ t in Ioi (0 : Real),
        (∫⁻ x, (ENNReal.ofReal ‖eval (high t) x‖) ^ (4 : Real)) *
          (ENNReal.ofReal t) ^ (p - 4 - 1)) ≤
        ((ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)) *
          ∫⁻ x, (ENNReal.ofReal ‖eval f x‖) ^ p := by
    simpa only [eval] using hhighTailRaw
  have hSmoment := sourceOutput_marcinkiewicz_weak_q_top_on_additive_split
    D eval S hSnonneg hSsub (4 : Real) (by norm_num)
    ((B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real)) hSweak hStop hp4 f
    (hSmeas f (by simp [D])).aemeasurable low high
    (fun _ => by simp [D]) (fun _ => by simp [D])
    (fun t => by ext x; exact hsplit t x)
    (fun t ht x => smooth_low_norm_le_half_height f (low t) ht (hlow t) x)
    hhighI_meas
    (((ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)) *
      ∫⁻ x, (ENNReal.ofReal ‖eval f x‖) ^ p)
    hhigh_tail
  let H : ENNReal := (ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)
  let K : ENNReal := ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
    (B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) * H)
  have hSmoment' : (∫⁻ z, ENNReal.ofReal ((S f z) ^ p) ∂localSmoothingMeasure) ≤
      K * (∫⁻ x, (ENNReal.ofReal ‖eval f x‖) ^ p) := by
    dsimp only [K, H]
    simpa only [mul_assoc] using hSmoment
  have hSbound := sourceOutput_eLpNorm_le_of_nonnegative_moment S f
    (lt_trans (by norm_num) hp4) (hSnonneg f)
    (K * ∫⁻ x, (ENNReal.ofReal ‖eval f x‖) ^ p) hSmoment'
  have hin : (∫⁻ x, (ENNReal.ofReal ‖eval f x‖) ^ p) =
      (eLpNorm (eval f) (ENNReal.ofReal p) volume) ^ p :=
    lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow (lt_trans (by norm_num) hp4) (eval f)
  rw [hin] at hSbound
  have hSbound' : eLpNorm (S f) (ENNReal.ofReal p) localSmoothingMeasure ≤
      K ^ p⁻¹ * eLpNorm (eval f) (ENNReal.ofReal p) volume := by
    calc
      eLpNorm (S f) (ENNReal.ofReal p) localSmoothingMeasure ≤
          (K * (eLpNorm (eval f) (ENNReal.ofReal p) volume) ^ p) ^ p⁻¹ := hSbound
      _ = K ^ p⁻¹ * eLpNorm (eval f) (ENNReal.ofReal p) volume := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr (lt_trans (by norm_num) hp4).le),
          ← ENNReal.rpow_mul]
        have hpp : p * p⁻¹ = (1 : Real) := by field_simp
        rw [hpp, ENNReal.rpow_one]
  have hTeq : T f = Btop • S f := by
    funext z
    change T f z = Btop * (T f z / Btop)
    field_simp [hBtop.ne']
  calc
    eLpNorm (localDyadicHalfWaveMagnitude C σ j f) (ENNReal.ofReal p)
        localSmoothingMeasure = eLpNorm (T f) (ENNReal.ofReal p)
          localSmoothingMeasure := rfl
    _ = ENNReal.ofReal Btop * eLpNorm (S f) (ENNReal.ofReal p)
          localSmoothingMeasure := by
          rw [hTeq, eLpNorm_const_smul, Real.enorm_eq_ofReal hBtop.le]
    _ ≤ ENNReal.ofReal Btop *
        (K ^ p⁻¹ * eLpNorm (eval f) (ENNReal.ofReal p) volume) :=
      mul_le_mul_right hSbound' _
    _ = ENNReal.ofReal Btop *
        (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
          (B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) *
          ((ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)))) ^ p⁻¹ *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
      dsimp only [K, H, eval]
      ac_rfl

/-- A finite extended-nonnegative constant can be absorbed into a positive
real coefficient.  This is used only to package scale-independent
interpolation constants in the exact `localSmoothing` format. -/
private theorem mss_ennreal_exists_pos_real_majorant
    {K : ENNReal} (hK : K ≠ ∞) :
    ∃ C : Real, 0 < C ∧ K ≤ ENNReal.ofReal C := by
  refine ⟨K.toReal + 1, by positivity, ?_⟩
  calc
    K = ENNReal.ofReal K.toReal := (ENNReal.ofReal_toReal hK).symm
    _ ≤ ENNReal.ofReal (K.toReal + 1) := by
      have hKnonneg : 0 ≤ K.toReal := ENNReal.toReal_nonneg
      exact ENNReal.ofReal_le_ofReal (by linarith)

/-- Algebraic normalization of the scale chosen for the two-pair
`L²`--`L⁴` source-output interpolation engine. -/
private theorem mss_two_four_coefficient_factor
    {p b : Real} (_hp : 0 < p) (hb : 0 < b)
    (H L : ENNReal) :
    sourceOutputTwoPairMarcinkiewiczMomentCoefficient p 2 4
        ((ENNReal.ofReal 2) ^ (2 : Real)) ((ENNReal.ofReal b) ^ (4 : Real))
        ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((2 : Real) - p) * H)
        ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((4 : Real) - p) * L) =
      (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) * (H + L))) *
        (ENNReal.ofReal b) ^ (2 * p - 4) := by
  let B : ENNReal := ENNReal.ofReal b
  let Q : ENNReal := ENNReal.ofReal 2
  have hB0 : B ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hb
  have hBtop : B ≠ ∞ := ENNReal.ofReal_ne_top
  have hQ0 : Q ≠ 0 := by norm_num [Q]
  have hQtop : Q ≠ ∞ := ENNReal.ofReal_ne_top
  have hs : ENNReal.ofReal (b⁻¹ * b⁻¹) = B ^ (-2 : Real) := by
    rw [ENNReal.ofReal_mul (inv_nonneg.mpr hb.le), ENNReal.ofReal_inv_of_pos hb]
    dsimp only [B]
    rw [← ENNReal.rpow_neg_one]
    rw [← ENNReal.rpow_add _ _ hB0 hBtop]
    congr 1
    ring
  have hpow0 : (B ^ (-2 : Real)) ^ ((2 : Real) - p) = B ^ (2 * p - 4) := by
    rw [← ENNReal.rpow_mul]
    congr 1
    ring
  have hpow1 : B ^ (4 : Real) * (B ^ (-2 : Real)) ^ ((4 : Real) - p) =
      B ^ (2 * p - 4) := by
    rw [← ENNReal.rpow_mul]
    rw [← ENNReal.rpow_add _ _ hB0 hBtop]
    congr 1
    ring
  change ENNReal.ofReal p *
      (Q ^ (2 : Real) * Q ^ (2 : Real) *
          (ENNReal.ofReal (b⁻¹ * b⁻¹) ^ ((2 : Real) - p) * H) +
        Q ^ (4 : Real) * B ^ (4 : Real) *
          (ENNReal.ofReal (b⁻¹ * b⁻¹) ^ ((4 : Real) - p) * L)) = _
  rw [hs]
  rw [hpow0]
  have hQpow : Q ^ (2 : Real) * Q ^ (2 : Real) = Q ^ (4 : Real) := by
    rw [← ENNReal.rpow_add _ _ hQ0 hQtop]
    congr 1
    ring
  rw [hQpow]
  rw [show Q ^ (4 : Real) * B ^ (4 : Real) *
      ((B ^ (-2 : Real)) ^ ((4 : Real) - p) * L) =
      Q ^ (4 : Real) *
        (B ^ (4 : Real) * (B ^ (-2 : Real)) ^ ((4 : Real) - p)) * L by
      ac_rfl, hpow1]
  rw [show Q ^ (4 : Real) * (B ^ (2 * p - 4) * H) +
      Q ^ (4 : Real) * B ^ (2 * p - 4) * L =
      (Q ^ (4 : Real) * (H + L)) * B ^ (2 * p - 4) by
      calc
        Q ^ (4 : Real) * (B ^ (2 * p - 4) * H) +
            Q ^ (4 : Real) * B ^ (2 * p - 4) * L =
            (Q ^ (4 : Real) * H + Q ^ (4 : Real) * L) * B ^ (2 * p - 4) := by
              rw [add_mul]
              ac_rfl
        _ = _ := by rw [mul_add]]
  ac_rfl

private theorem mss_two_four_root_factor
    {p : Real} (hp : 0 < p) (K b : ENNReal) :
    (K * b ^ (2 * p - 4)) ^ p⁻¹ =
      K ^ p⁻¹ * b ^ (2 - 4 / p) := by
  rw [ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hp.le),
    ← ENNReal.rpow_mul]
  congr 1
  field_simp

private theorem mss_ofReal_product_rpow
    {a r θ : Real} (ha : 0 < a) (hθ : 0 ≤ θ) (j : Nat) :
    (ENNReal.ofReal (a * (2 : Real) ^ ((j : Real) * r))) ^ θ =
      ENNReal.ofReal (a ^ θ) *
        ENNReal.ofReal ((2 : Real) ^ ((j : Real) * (r * θ))) := by
  rw [ENNReal.ofReal_mul ha.le,
    ENNReal.mul_rpow_of_nonneg _ _ hθ]
  rw [ENNReal.ofReal_rpow_of_pos ha]
  congr 1
  rw [show (2 : Real) ^ ((j : Real) * (r * θ)) =
      ((2 : Real) ^ ((j : Real) * r)) ^ θ by
      rw [← Real.rpow_mul (by norm_num : (0 : Real) ≤ 2)]
      congr 1
      ring]
  rw [ENNReal.ofReal_rpow_of_pos
    (Real.rpow_pos_of_pos (by norm_num) _)]

private theorem mss_two_four_theta_pos {p : Real} (hp2 : 2 < p) :
    0 < 2 - 4 / p := by
  have hp0 : 0 < p := lt_trans (by norm_num) hp2
  apply sub_pos.mpr
  rw [div_lt_iff₀ hp0]
  nlinarith

private theorem mss_two_four_rate
    {p η : Real} (hp : 0 < p) (hθ : 0 < 2 - 4 / p) :
    (1 / 8 + η / (2 - 4 / p)) * (2 - 4 / p) =
      1 / 4 - 1 / (2 * p) + η := by
  calc
    (1 / 8 + η / (2 - 4 / p)) * (2 - 4 / p) =
        (1 / 8) * (2 - 4 / p) + (η / (2 - 4 / p)) * (2 - 4 / p) := by ring
    _ = (1 / 8) * (2 - 4 / p) + η := by
      rw [div_mul_cancel₀ _ hθ.ne']
    _ = 1 / 4 - 1 / (2 * p) + η := by
      field_simp [hp.ne']
      ring

private theorem mss_two_four_constant_finite
    {p : Real} (hp2 : 2 < p) (hp4 : p < 4) :
    (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
      ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2) +
        ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
          (ENNReal.ofReal (4 - p))⁻¹)))) ^ p⁻¹ ≠ ∞ := by
  have hp0 : 0 < p := lt_trans (by norm_num) hp2
  have hp2' : 0 < p - 2 := sub_pos.mpr hp2
  have hp4' : 0 < 4 - p := sub_pos.mpr hp4
  apply ENNReal.rpow_ne_top_of_nonneg (inv_nonneg.mpr hp0.le)
  apply ENNReal.mul_ne_top ENNReal.ofReal_ne_top
  apply ENNReal.mul_ne_top
  · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
  apply ENNReal.add_ne_top.mpr
  constructor
  · apply ENNReal.mul_ne_top
    · exact ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hp2')
    · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
  · apply ENNReal.add_ne_top.mpr
    constructor
    · apply ENNReal.mul_ne_top
      · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
      · exact ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hp0)
    · exact ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hp4')

/-- The proved local `L²` endpoint and a literal Schwartz-core `p=4`
local-smoothing estimate interpolate to every `2 < p < 4`.  The proof uses
the radius-scaled two-pair source-output engine, so the gain has the exact
MSS exponent rather than an unscaled interpolation loss. -/
theorem p4LocalSmoothing_to_localSmoothing_two_four
    (C : lpCutoffs 2) (h4 : p4LocalSmoothing C.cutoff)
    {p η : Real} (hp2 : 2 < p) (hp4 : p < 4) (hη : 0 < η) :
    localSmoothing C.cutoff p η := by
  let θ : Real := 2 - 4 / p
  have hθ : 0 < θ := by
    dsimp only [θ]
    exact mss_two_four_theta_pos hp2
  let δ : Real := η / θ
  have hδ : 0 < δ := div_pos hη hθ
  rcases h4 δ hδ with ⟨_, _, A, hA, hA_bound⟩
  refine ⟨hp2, hη, ?_⟩
  let H : ENNReal := (ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2)
  let L : ENNReal :=
    (ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
      (ENNReal.ofReal (4 - p))⁻¹
  let K : ENNReal := ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) * (H + L))
  have hKtop : K ^ p⁻¹ ≠ ∞ := by
    dsimp only [K, H, L]
    exact mss_two_four_constant_finite hp2 hp4
  let D : Real := (K ^ p⁻¹).toReal * A ^ θ + 1
  have hD : 0 < D := by
    dsimp only [D]
    positivity
  refine ⟨D, hD, ?_⟩
  intro j hj f σ
  let b : Real := A * (2 : Real) ^ ((j : Real) * (1 / 8 + δ))
  have hb : 0 < b := by
    dsimp only [b]
    exact mul_pos hA (Real.rpow_pos_of_pos (by norm_num) _)
  have hstrong4 : ∀ g : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j g) (ENNReal.ofReal 4)
          localSmoothingMeasure ≤
        ENNReal.ofReal b * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := by
    intro g
    convert hA_bound j hj g σ using 1 <;>
      dsimp only [b] <;> rw [mssGain_four] <;> ring
  have hs : 0 < b⁻¹ * b⁻¹ := by positivity
  have hinterp := mss_two_four_coefficient C σ j hp2 hp4 (ENNReal.ofReal b)
    hstrong4 (b⁻¹ * b⁻¹) hs f
  have hcoef :
      sourceOutputTwoPairMarcinkiewiczMomentCoefficient p 2 4
          ((ENNReal.ofReal 2) ^ (2 : Real)) ((ENNReal.ofReal b) ^ (4 : Real))
          ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((2 : Real) - p) * H)
          ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((4 : Real) - p) * L) =
        K * (ENNReal.ofReal b) ^ (2 * p - 4) := by
    dsimp only [K, H, L]
    exact mss_two_four_coefficient_factor (lt_trans (by norm_num) hp2) hb _ _
  have hroot := mss_two_four_root_factor (lt_trans (by norm_num) hp2) K
    (ENNReal.ofReal b)
  have hBpow : (ENNReal.ofReal b) ^ θ =
      ENNReal.ofReal (A ^ θ) *
        ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 8 + δ) * θ))) := by
    dsimp only [b]
    exact mss_ofReal_product_rpow hA hθ.le j
  have hrate : (1 / 8 + δ) * θ =
      1 / 4 - 1 / (2 * p) + η := by
    dsimp only [δ, θ]
    exact mss_two_four_rate (lt_trans (by norm_num) hp2)
      (mss_two_four_theta_pos hp2)
  have hstatic : K ^ p⁻¹ * ENNReal.ofReal (A ^ θ) ≤ ENNReal.ofReal D := by
    calc
      K ^ p⁻¹ * ENNReal.ofReal (A ^ θ) =
          ENNReal.ofReal ((K ^ p⁻¹).toReal) * ENNReal.ofReal (A ^ θ) := by
            rw [ENNReal.ofReal_toReal hKtop]
      _ =
          ENNReal.ofReal ((K ^ p⁻¹).toReal * A ^ θ) := by
            rw [← ENNReal.ofReal_mul ENNReal.toReal_nonneg]
      _ ≤ ENNReal.ofReal ((K ^ p⁻¹).toReal * A ^ θ + 1) := by
        apply ENNReal.ofReal_le_ofReal
        have hnon : 0 ≤ (K ^ p⁻¹).toReal * A ^ θ :=
          mul_nonneg ENNReal.toReal_nonneg (Real.rpow_nonneg hA.le _)
        linarith
      _ = ENNReal.ofReal D := rfl
  have htargetrate : 1 / 2 - 1 / p - mssGain p + η =
      1 / 4 - 1 / (2 * p) + η := by
    rw [mssGain_of_le_four hp4.le]
    ring
  calc
    eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j f) (ENNReal.ofReal p)
        localSmoothingMeasure =
        eLpNorm (localDyadicHalfWaveMagnitude C σ j f) (ENNReal.ofReal p)
          localSmoothingMeasure := by
            rw [eLpNorm_congr_ae (localDyadicHalfWaveMagnitude_ae_eq C σ j f), eLpNorm_norm]
    _ ≤ (sourceOutputTwoPairMarcinkiewiczMomentCoefficient p 2 4
          ((ENNReal.ofReal 2) ^ (2 : Real)) ((ENNReal.ofReal b) ^ (4 : Real))
          ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((2 : Real) - p) * H)
          ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((4 : Real) - p) * L)) ^ p⁻¹ *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          exact hinterp
    _ = (K * (ENNReal.ofReal b) ^ (2 * p - 4)) ^ p⁻¹ *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by rw [hcoef]
    _ = (K ^ p⁻¹ * (ENNReal.ofReal b) ^ θ) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          rw [hroot]
    _ = (K ^ p⁻¹ * ENNReal.ofReal (A ^ θ) *
        ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 8 + δ) * θ)))) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          rw [hBpow]
          ac_rfl
    _ ≤ (ENNReal.ofReal D *
        ENNReal.ofReal ((2 : Real) ^ ((j : Real) *
          (1 / 4 - 1 / (2 * p) + η)))) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          rw [hrate]
          gcongr
    _ = ENNReal.ofReal (D * (2 : Real) ^
        ((j : Real) * (1 / 2 - 1 / p - mssGain p + η))) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          rw [htargetrate]
          rw [ENNReal.ofReal_mul hD.le]

private theorem mss_four_top_root_factor
    {p : Real} (hp : 0 < p) (K b4 btop : ENNReal)
    (hbtop0 : btop ≠ 0) (hbtopT : btop ≠ ∞) :
    btop * (K * (b4 * btop⁻¹) ^ (4 : Real)) ^ p⁻¹ =
      K ^ p⁻¹ * b4 ^ (4 / p) * btop ^ (1 - 4 / p) := by
  have hinv : 0 ≤ p⁻¹ := inv_nonneg.mpr hp.le
  rw [ENNReal.mul_rpow_of_nonneg _ _ hinv]
  rw [← ENNReal.rpow_mul]
  have hfour : (4 : Real) * p⁻¹ = 4 / p := by field_simp
  rw [hfour]
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : 0 ≤ 4 / p)]
  rw [ENNReal.inv_rpow]
  rw [← ENNReal.rpow_neg]
  rw [show btop * (K ^ p⁻¹ * (b4 ^ (4 / p) * btop ^ (-(4 / p)))) =
      (K ^ p⁻¹ * b4 ^ (4 / p)) * (btop * btop ^ (-(4 / p))) by ac_rfl]
  rw [show btop * btop ^ (-(4 / p)) = btop ^ (1 - 4 / p) by
    calc
      btop * btop ^ (-(4 / p)) = btop ^ (1 : Real) * btop ^ (-(4 / p)) := by
        rw [ENNReal.rpow_one]
      _ = btop ^ (1 + -(4 / p)) := (ENNReal.rpow_add _ _ hbtop0 hbtopT).symm
      _ = btop ^ (1 - 4 / p) := by congr 1 <;> ring]

private theorem mss_four_top_constant_finite
    {p : Real} (hp4 : 4 < p) :
    (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
      ((ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)))) ^ p⁻¹ ≠ ∞ := by
  have hp0 : 0 < p := lt_trans (by norm_num) hp4
  have hp4' : 0 < p - 4 := sub_pos.mpr hp4
  apply ENNReal.rpow_ne_top_of_nonneg (inv_nonneg.mpr hp0.le)
  apply ENNReal.mul_ne_top ENNReal.ofReal_ne_top
  apply ENNReal.mul_ne_top
  · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
  · apply ENNReal.mul_ne_top
    · exact ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hp4')
    · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top

private theorem mss_sqrt_two_rpow (j : Nat) :
    Real.sqrt ((2 : Real) ^ j) = (2 : Real) ^ ((j : Real) * (1 / 2)) := by
  calc
    Real.sqrt ((2 : Real) ^ j) = ((2 : Real) ^ j) ^ (1 / 2 : Real) :=
      Real.sqrt_eq_rpow _
    _ = ((2 : Real) ^ (j : Real)) ^ (1 / 2 : Real) := by
      rw [Real.rpow_natCast]
    _ = (2 : Real) ^ ((j : Real) * (1 / 2)) :=
      (Real.rpow_mul (by norm_num : (0 : Real) ≤ 2) _ _).symm

private theorem mss_four_top_rate
    {p η : Real} (hp : 0 < p) :
    (1 / 8 + p * η / 4) * (4 / p) +
      (1 / 2) * (1 - 4 / p) =
        1 / 2 - 3 / (2 * p) + η := by
  field_simp [hp.ne']
  ring

/-- A literal Schwartz-core `p=4` local-smoothing estimate and the proved
slab-local `L∞` endpoint interpolate to every `4 < p`.  The `L∞` assertion is
used only through `localDyadicHalfWaveMagnitude`, which is zero off the
physical time slab. -/
theorem p4LocalSmoothing_to_localSmoothing_four_top
    (C : lpCutoffs 2) (h4 : p4LocalSmoothing C.cutoff)
    {p η : Real} (hp4 : 4 < p) (hη : 0 < η) :
    localSmoothing C.cutoff p η := by
  let δ : Real := p * η / 4
  have hp0 : 0 < p := lt_trans (by norm_num) hp4
  have hδ : 0 < δ := by
    dsimp only [δ]
    positivity
  rcases h4 δ hδ with ⟨_, _, A, hA, hA_bound⟩
  rcases mssLInfinityEndpoint C with ⟨B, hB, hInfty⟩
  refine ⟨lt_trans (by norm_num) hp4, hη, ?_⟩
  let H : ENNReal := (ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)
  let K : ENNReal := ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) * H)
  have hKtop : K ^ p⁻¹ ≠ ∞ := by
    dsimp only [K, H]
    exact mss_four_top_constant_finite hp4
  let θ4 : Real := 4 / p
  have hθ4 : 0 < θ4 := by
    dsimp only [θ4]
    positivity
  let θtop : Real := 1 - 4 / p
  have hθtop : 0 < θtop := by
    dsimp only [θtop]
    apply sub_pos.mpr
    rw [div_lt_iff₀ hp0]
    simpa using hp4
  let S : ENNReal := K ^ p⁻¹ * ENNReal.ofReal (A ^ θ4) * ENNReal.ofReal (B ^ θtop)
  have hStop : S ≠ ∞ := by
    dsimp only [S]
    apply ENNReal.mul_ne_top
    · apply ENNReal.mul_ne_top
      · exact hKtop
      · exact ENNReal.ofReal_ne_top
    · exact ENNReal.ofReal_ne_top
  rcases mss_ennreal_exists_pos_real_majorant hStop with ⟨D, hD, hSle⟩
  refine ⟨D, hD, ?_⟩
  intro j hj f σ
  let b4 : Real := A * (2 : Real) ^ ((j : Real) * (1 / 8 + δ))
  have hb4 : 0 < b4 := by
    dsimp only [b4]
    exact mul_pos hA (Real.rpow_pos_of_pos (by norm_num) _)
  let btop : Real := B * Real.sqrt ((2 : Real) ^ j)
  have hbtop : 0 < btop := by
    dsimp only [btop]
    apply mul_pos hB
    exact Real.sqrt_pos.2 (pow_pos (by norm_num) _)
  have hstrong4 : ∀ g : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j g) (ENNReal.ofReal 4)
          localSmoothingMeasure ≤
        ENNReal.ofReal b4 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := by
    intro g
    convert hA_bound j hj g σ using 1 <;>
      dsimp only [b4] <;> rw [mssGain_four] <;> ring
  have hTop : ∀ (g : SchwartzMap (Euclidean 2) Complex) (a : Real), 0 ≤ a →
      (∀ x, ‖g x‖ ≤ a) → ∀ z,
        localDyadicHalfWaveMagnitude C σ j g z ≤ btop * a := by
    intro g a ha hga
    exact localDyadicHalfWaveMagnitude_top C hB hInfty σ j hj g hga
  have hinterp := mss_four_top_coefficient C σ j hp4 (ENNReal.ofReal b4) hstrong4
    btop hbtop hTop f
  have hcoef :
      ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
          (ENNReal.ofReal b4 * (ENNReal.ofReal btop)⁻¹) ^ (4 : Real) * H) =
        K * (ENNReal.ofReal b4 * (ENNReal.ofReal btop)⁻¹) ^ (4 : Real) := by
    dsimp only [K]
    ac_rfl
  have hroot := mss_four_top_root_factor hp0 K (ENNReal.ofReal b4)
    (ENNReal.ofReal btop) (ENNReal.ofReal_ne_zero_iff.mpr hbtop) ENNReal.ofReal_ne_top
  have hB4pow : (ENNReal.ofReal b4) ^ θ4 =
      ENNReal.ofReal (A ^ θ4) *
        ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 8 + δ) * θ4))) := by
    dsimp only [b4]
    exact mss_ofReal_product_rpow hA hθ4.le j
  have hBtoppow : (ENNReal.ofReal btop) ^ θtop =
      ENNReal.ofReal (B ^ θtop) *
        ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 2) * θtop))) := by
    dsimp only [btop]
    rw [mss_sqrt_two_rpow]
    exact mss_ofReal_product_rpow hB hθtop.le j
  have hrate : (1 / 8 + δ) * θ4 + (1 / 2) * θtop =
      1 / 2 - 3 / (2 * p) + η := by
    dsimp only [δ, θ4, θtop]
    exact mss_four_top_rate hp0
  have hscale :
      ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 8 + δ) * θ4))) *
        ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 2) * θtop))) =
      ENNReal.ofReal ((2 : Real) ^ ((j : Real) *
        (1 / 2 - 3 / (2 * p) + η))) := by
    rw [← ENNReal.ofReal_mul (Real.rpow_nonneg (by norm_num) _)]
    rw [← Real.rpow_add (by norm_num : (0 : Real) < 2)]
    congr 1
    rw [← mul_add, hrate]
  have htargetrate : 1 / 2 - 1 / p - mssGain p + η =
      1 / 2 - 3 / (2 * p) + η := by
    rw [mssGain_of_four_lt hp4]
    field_simp [hp0.ne']
    ring
  calc
    eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j f) (ENNReal.ofReal p)
        localSmoothingMeasure =
        eLpNorm (localDyadicHalfWaveMagnitude C σ j f) (ENNReal.ofReal p)
          localSmoothingMeasure := by
            rw [eLpNorm_congr_ae (localDyadicHalfWaveMagnitude_ae_eq C σ j f), eLpNorm_norm]
    _ ≤ ENNReal.ofReal btop *
        (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
          (ENNReal.ofReal b4 * (ENNReal.ofReal btop)⁻¹) ^ (4 : Real) * H)) ^ p⁻¹ *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          exact hinterp
    _ = (K ^ p⁻¹ * (ENNReal.ofReal b4) ^ θ4 *
        (ENNReal.ofReal btop) ^ θtop) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          rw [hcoef, hroot]
    _ = (K ^ p⁻¹ * ENNReal.ofReal (A ^ θ4) * ENNReal.ofReal (B ^ θtop)) *
        (ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 8 + δ) * θ4))) *
          ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 2) * θtop))) *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume) := by
          rw [hB4pow, hBtoppow]
          ac_rfl
    _ = S *
        (ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 8 + δ) * θ4))) *
          ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 2) * θtop))) *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume) := by
          rfl
    _ ≤ ENNReal.ofReal D *
        (ENNReal.ofReal ((2 : Real) ^ ((j : Real) *
          (1 / 2 - 3 / (2 * p) + η))) *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume) := by
          rw [hscale]
          gcongr
    _ = ENNReal.ofReal (D * (2 : Real) ^
        ((j : Real) * (1 / 2 - 1 / p - mssGain p + η))) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          rw [htargetrate]
          rw [ENNReal.ofReal_mul hD.le]
          ac_rfl

/-- A sharp local `p=4` estimate yields the complete real-exponent MSS
local-smoothing family.  The proof is direct at `p=4`, uses the proved local
`L²` endpoint below four, and uses the slab-local proved `L∞` endpoint above
four. -/
theorem p4LocalSmoothing_to_localSmoothing_all_p
    (C : lpCutoffs 2) (h4 : p4LocalSmoothing C.cutoff)
    {p η : Real} (hp : 2 < p) (hη : 0 < η) :
    localSmoothing C.cutoff p η := by
  by_cases hp4 : p ≤ 4
  · rcases lt_or_eq_of_le hp4 with hplt | rfl
    · exact p4LocalSmoothing_to_localSmoothing_two_four C h4 hp hplt hη
    · exact h4 η hη
  · exact p4LocalSmoothing_to_localSmoothing_four_top C h4 (lt_of_not_ge hp4) hη

end

end Codex.Spherical.MSS
