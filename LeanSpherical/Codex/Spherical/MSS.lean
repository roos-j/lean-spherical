  exact norm_dyadicHalfWave_le_kernelL1 C σ j t f hfbound x

/-- Scale-explicit form of the physical fixed-time endpoint.  This is an
exact reduction of the dyadic kernel bound to the level-zero kernel at time
`2^j t`; it does not assert a numerical oscillatory-kernel estimate. -/
theorem fixedTimePhysicalLInfinityEndpoint_scaled (C : lpCutoffs 2)
    (σ : WaveSign) (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex)
    {A : Real} (hfbound : ∀ x, ‖f x‖ ≤ A) (x : Euclidean 2) :
    ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
      A * dyadicHalfWaveKernelL1 C σ 0 ((2 : Real) ^ j * t) := by
  rw [← dyadicHalfWaveKernelL1_eq_levelZero_scaled]
  exact fixedTimePhysicalLInfinityEndpoint C σ j t f hfbound x

/-- Any explicit upper bound for the physical kernel `L¹` norm yields the
corresponding fixed-time physical `L∞` estimate. -/
theorem fixedTimePhysicalLInfinityEndpoint_of_kernelL1_le (C : lpCutoffs 2)
    (σ : WaveSign) (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex)
    {A B : Real} (hfbound : ∀ x, ‖f x‖ ≤ A)
    (hkernel : dyadicHalfWaveKernelL1 C σ j t ≤ B) (x : Euclidean 2) :
    ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤ A * B := by
  have hA : 0 ≤ A := le_trans (norm_nonneg (f 0)) (hfbound 0)
  calc
    ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤ A * dyadicHalfWaveKernelL1 C σ j t :=
      fixedTimePhysicalLInfinityEndpoint C σ j t f hfbound x
    _ ≤ A * B := mul_le_mul_of_nonneg_left hkernel hA

/-- The compact cutoff half-wave symbol has an integrable physical-space
kernel.  This is the qualitative kernel fact supplied directly by the
Schwartz calculus; obtaining a numerical bound on this norm over a time
range requires a separate oscillatory-kernel estimate. -/
theorem waveKernelL1 (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real) :
    Integrable (dyadicHalfWaveKernel C σ j t : Euclidean 2 → Complex) := by
  exact (dyadicHalfWaveKernel C σ j t).integrable

set_option maxHeartbeats 1000000 in
/-- The inverse Fourier transform turns a frequency Laplacian into
multiplication by `-4 π² ‖x‖²` in the plane. -/
private theorem fourierInv_laplacian_eq_normSq_smul
    (q : SchwartzMap (Euclidean 2) Complex) :
    (𝓕⁻ (Laplacian.laplacian q) : SchwartzMap (Euclidean 2) Complex) =
        ((-(2 * Real.pi) ^ 2 : Real) : Complex) •
          (SchwartzMap.smulLeftCLM Complex
            (fun x : Euclidean 2 => ‖x‖ ^ 2)
            (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) := by
  classical
  let b := stdOrthonormalBasis Real (Euclidean 2)
  rw [SchwartzMap.laplacian_eq_sum b q]
  rw [fourierInv_sum]
  ext x
  change (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean 2) Complex)
      (Euclidean 2) Complex)
      (∑ i, 𝓕⁻ (LineDeriv.lineDerivOp (b i)
        (LineDeriv.lineDerivOp (b i) q))) x = _
  rw [map_sum, Finset.sum_apply]
  simp_rw [SchwartzMap.fourierInv_lineDerivOp_eq]
  have hsmul (a : Complex) (f : SchwartzMap (Euclidean 2) Complex) :
      (a • f) x = a * f x := by
    simpa [smul_eq_mul] using (smul_apply f a x)
  have hmul_inner (i : Fin (Module.finrank Real (Euclidean 2)))
      (f : SchwartzMap (Euclidean 2) Complex) :
      (SchwartzMap.smulLeftCLM Complex (fun y => inner Real y (b i)) f) x =
        ((inner Real x (b i) : Real) : Complex) * f x := by
    simpa [smul_eq_mul] using
      congrFun (SchwartzMap.smulLeftCLM_apply
        (show (fun y : Euclidean 2 => inner Real y (b i)).HasTemperateGrowth by fun_prop) f) x
  have hmul_norm (f : SchwartzMap (Euclidean 2) Complex) :
      (SchwartzMap.smulLeftCLM Complex
        (fun y : Euclidean 2 => ‖y‖ ^ 2) f) x =
        ((‖x‖ ^ 2 : Real) : Complex) * f x := by
    simpa [smul_eq_mul] using congrFun (SchwartzMap.smulLeftCLM_apply
      (show (fun y : Euclidean 2 => ‖y‖ ^ 2).HasTemperateGrowth by fun_prop) f) x
  change (∑ i, ((-(2 * ↑Real.pi * Complex.I) : Complex) •
      (SchwartzMap.smulLeftCLM Complex (fun y => inner Real y (b i))
        ((-(2 * ↑Real.pi * Complex.I) : Complex) •
          (SchwartzMap.smulLeftCLM Complex (fun y => inner Real y (b i))
            (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)))) :
        SchwartzMap (Euclidean 2) Complex) x) =
      (((-(2 * Real.pi) ^ 2 : Real) : Complex) •
        (SchwartzMap.smulLeftCLM Complex
          (fun y : Euclidean 2 => ‖y‖ ^ 2)
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex))) x
  simp_rw [hsmul]
  simp_rw [hmul_inner, hmul_norm]
  simp_rw [hsmul]
  simp_rw [hmul_inner]
  have hc : (-(2 * ↑Real.pi * Complex.I) : Complex) *
      (-(2 * ↑Real.pi * Complex.I) : Complex) =
      ((-(2 * Real.pi) ^ 2 : Real) : Complex) := by
    push_cast
    calc
      -(2 * ↑Real.pi * Complex.I) * -(2 * ↑Real.pi * Complex.I) =
          (2 * (Real.pi : Complex)) ^ 2 * (Complex.I * Complex.I) := by ring
      _ = -(2 * (Real.pi : Complex)) ^ 2 := by rw [Complex.I_mul_I]; ring
      _ = -(2 * ↑Real.pi) ^ 2 := by ring
  calc
    (∑ i, (-(2 * ↑Real.pi * Complex.I) : Complex) *
        (((inner Real x (b i) : Real) : Complex) *
          ((-(2 * ↑Real.pi * Complex.I) : Complex) *
            (((inner Real x (b i) : Real) : Complex) *
              (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x)))) =
        ∑ i, ((-(2 * Real.pi) ^ 2 : Real) : Complex) *
          ((inner Real x (b i) : Real) : Complex) ^ 2 *
            (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x := by
      apply Finset.sum_congr rfl
      intro i hi
      calc
        _ = ((-(2 * ↑Real.pi * Complex.I) : Complex) *
            (-(2 * ↑Real.pi * Complex.I) : Complex)) *
            ((inner Real x (b i) : Real) : Complex) ^ 2 *
              (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x := by ring
        _ = _ := by rw [hc]
    _ = ((-(2 * Real.pi) ^ 2 : Real) : Complex) *
        (∑ i, ((inner Real x (b i) : Real) : Complex) ^ 2) *
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x := by
      rw [Finset.mul_sum, Finset.sum_mul]
    _ = ((-(2 * Real.pi) ^ 2 : Real) : Complex) *
        (((‖x‖ ^ 2 : Real) : Complex) *
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x) := by
      rw [show ∑ i, ((inner Real x (b i) : Real) : Complex) ^ 2 =
        ((‖x‖ ^ 2 : Real) : Complex) by
          norm_cast
          exact b.sum_sq_inner_left x]
      ring

/-- The exact Fourier identity behind the quadratic distance-to-cone weight.
The phase-specific argument only has to bound the cancelled frequency symbol
on the left. -/
theorem fourierInv_cancelled_laplacian_eq_cone_quadratic
    (q : SchwartzMap (Euclidean 2) Complex) (s : Real) :
    (𝓕⁻ (-Laplacian.laplacian q -
        (((2 * Real.pi * s) ^ 2 : Real) : Complex) • q) :
        SchwartzMap (Euclidean 2) Complex) =
      (((2 * Real.pi) ^ 2 : Real) : Complex) •
        (SchwartzMap.smulLeftCLM Complex
          (fun x : Euclidean 2 => ‖x‖ ^ 2 - s ^ 2)
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) := by
  rw [sub_eq_add_neg, fourierInv_add, fourierInv_neg, fourierInv_neg,
    fourierInv_smul, fourierInv_laplacian_eq_normSq_smul]
  ext x
  have hsmul (a : Complex) (f : SchwartzMap (Euclidean 2) Complex) :
      (a • f) x = a * f x := by
    simpa [smul_eq_mul] using (smul_apply f a x)
  have hmul_norm (f : SchwartzMap (Euclidean 2) Complex) :
      (SchwartzMap.smulLeftCLM Complex
        (fun y : Euclidean 2 => ‖y‖ ^ 2) f) x =
        ((‖x‖ ^ 2 : Real) : Complex) * f x := by
    simpa [smul_eq_mul] using congrFun (SchwartzMap.smulLeftCLM_apply
      (show (fun y : Euclidean 2 => ‖y‖ ^ 2).HasTemperateGrowth by fun_prop) f) x
  have hmul_cone (f : SchwartzMap (Euclidean 2) Complex) :
      (SchwartzMap.smulLeftCLM Complex
        (fun y : Euclidean 2 => ‖y‖ ^ 2 - s ^ 2) f) x =
        ((‖x‖ ^ 2 - s ^ 2 : Real) : Complex) * f x := by
    simpa [smul_eq_mul] using congrFun (SchwartzMap.smulLeftCLM_apply
      (show (fun y : Euclidean 2 => ‖y‖ ^ 2 - s ^ 2).HasTemperateGrowth by fun_prop) f) x
  change (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean 2) Complex)
      (Euclidean 2) Complex)
      (-((( -(2 * Real.pi) ^ 2 : Real) : Complex) •
          (SchwartzMap.smulLeftCLM Complex (fun y : Euclidean 2 => ‖y‖ ^ 2)
            (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex))) +
        -((((2 * Real.pi * s) ^ 2 : Real) : Complex) •
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex))) x = _
  rw [map_add, map_neg, map_neg]
  simp only [Pi.add_apply, Pi.neg_apply]
  change
    -(((-(2 * Real.pi) ^ 2 : Real) : Complex) •
        (SchwartzMap.smulLeftCLM Complex (fun y : Euclidean 2 => ‖y‖ ^ 2)
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex))) x +
      -((((2 * Real.pi * s) ^ 2 : Real) : Complex) •
        (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) x =
      (((2 * Real.pi) ^ 2 : Real) : Complex) *
        (SchwartzMap.smulLeftCLM Complex
          (fun y : Euclidean 2 => ‖y‖ ^ 2 - s ^ 2)
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) x
  rw [hsmul, hsmul]
  rw [hmul_norm, hmul_cone]
  push_cast
  ring

/-- The quadratic weight measuring distance to the planar wave cone at time
`s`.  Dividing the radial discrepancy `‖x‖² - s²` by `s` makes the resulting
reciprocal weight have mass of order `s`. -/
def coneWeight (s : Real) (x : Euclidean 2) : Real :=
  1 + ((‖x‖ ^ 2 - s ^ 2) / s) ^ 2

/-- The reciprocal of the planar wave-cone weight. -/
def coneReciprocal (s : Real) (x : Euclidean 2) : Real :=
  (coneWeight s x)⁻¹

/-- The planar cone weight is strictly positive, including at `s = 0`. -/
theorem coneWeight_pos (s : Real) (x : Euclidean 2) : 0 < coneWeight s x := by
  unfold coneWeight
  positivity

private theorem integrable_radius_coneReciprocal (s : Real) (hs : 0 < s) :
    IntegrableOn (fun r : Real => r * (1 + ((r ^ 2 - s ^ 2) / s) ^ 2)⁻¹) (Ioi 0) := by
  let g : Real → Real := fun u => (1 + u ^ 2)⁻¹
  let q : Real → Real := fun u => g ((u - s ^ 2) / s)
  have hg : Integrable g := by
    simpa only [g] using integrable_inv_one_add_sq
  have hq : Integrable q := by
    have hshift : Integrable (fun u : Real => g (u - s)) := hg.comp_sub_right s
    have hscale : Integrable (fun u : Real => g ((s : Real)⁻¹ * u - s)) := by
      exact (MeasureTheory.integrable_comp_mul_left_iff
        (fun u : Real => g (u - s)) (inv_ne_zero hs.ne')).mpr hshift
    refine hscale.congr ?_
    filter_upwards with u
    dsimp only [q]
    congr 1
    field_simp [hs.ne']
  have hqIoi : IntegrableOn q (Ioi 0) := hq.integrableOn
  have hqSquareIoi : IntegrableOn (fun r : Real => r * q (r ^ 2)) (Ioi 0) := by
    have h := (integrableOn_Ioi_comp_rpow_iff' q (by norm_num : (2 : Real) ≠ 0)).mpr hqIoi
    norm_num at h
    simpa only [smul_eq_mul, one_mul] using h
  refine hqSquareIoi.congr ?_
  filter_upwards with r
  rfl

/-- The radial integral of the reciprocal wave-cone weight is an elementary
one-dimensional Cauchy profile. -/
theorem integral_radius_coneReciprocal (s : Real) (hs : 0 < s) :
    (∫ r : Real in Ioi 0, r * (1 + ((r ^ 2 - s ^ 2) / s) ^ 2)⁻¹) =
      (s / 2) * (∫ u : Real in Ioi (-s), (1 + u ^ 2)⁻¹) := by
  let g : Real → Real := fun u => (1 + u ^ 2)⁻¹
  let f : Real → Real := fun r => (r ^ 2 - s ^ 2) / s
  let f' : Real → Real := fun r => (2 * r) / s
  let q : Real → Real := fun u => g ((u - s ^ 2) / s)
  have hg : Integrable g := by
    simpa only [g] using integrable_inv_one_add_sq
  have hq : Integrable q := by
    have hshift : Integrable (fun u : Real => g (u - s)) := hg.comp_sub_right s
    have hscale : Integrable (fun u : Real => g ((s : Real)⁻¹ * u - s)) := by
      exact (MeasureTheory.integrable_comp_mul_left_iff
        (fun u : Real => g (u - s)) (inv_ne_zero hs.ne')).mpr hshift
    refine hscale.congr ?_
    filter_upwards with u
    dsimp only [q]
    congr 1
    field_simp [hs.ne']
  have hqIoi : IntegrableOn q (Ioi 0) := hq.integrableOn
  have hqSquareIoi : IntegrableOn (fun r : Real => r * q (r ^ 2)) (Ioi 0) := by
    have h := (integrableOn_Ioi_comp_rpow_iff' q (by norm_num : (2 : Real) ≠ 0)).mpr hqIoi
    norm_num at h
    simpa only [smul_eq_mul, one_mul] using h
  have hqSquareIci : IntegrableOn (fun r : Real => r * q (r ^ 2)) (Ici 0) :=
    (integrableOn_Ici_iff_integrableOn_Ioi).mpr hqSquareIoi
  have hcomp : IntegrableOn (fun r : Real => (g ∘ f) r * f' r) (Ici 0) := by
    have h := hqSquareIci.const_mul (2 / s)
    refine h.congr ?_
    filter_upwards with r
    dsimp only [f, f', q, Function.comp_apply]
    field_simp [hs.ne']
  have hfcont : Continuous f := by
    dsimp only [f]
    fun_prop
  have hftend : Tendsto f atTop atTop := by
    apply tendsto_atTop.2
    intro b
    filter_upwards [eventually_ge_atTop (max 1 (s * b + s ^ 2))] with r hr
    have hrone : 1 ≤ r := (le_max_left _ _).trans hr
    have hrlin : r ≤ r ^ 2 := by nlinarith
    have hbound : s * b + s ^ 2 ≤ r ^ 2 :=
      (le_max_right _ _).trans (hr.trans hrlin)
    dsimp only [f]
    apply (le_div_iff₀ hs).mpr
    nlinarith
  have hfderiv : ∀ r ∈ Ioi (0 : Real), HasDerivWithinAt f (f' r) (Ioi r) r := by
    intro r hr
    have hpow : HasDerivAt (fun x : Real => x ^ 2) (2 * r) r := by
      simpa using! (hasDerivAt_id r).pow 2
    simpa only [f, f'] using ((hpow.sub_const (s ^ 2)).div_const s).hasDerivWithinAt
  have hgcont : Continuous g := by
    dsimp only [g]
    apply Continuous.inv₀
    · fun_prop
    · intro u
      positivity
  have hchange := integral_comp_mul_deriv_Ioi
    (f := f) (f' := f') (g := g) (a := (0 : Real)) hfcont.continuousOn hftend hfderiv
      hgcont.continuousOn hg.integrableOn hcomp
  have hfactor : (fun r : Real => r * (1 + ((r ^ 2 - s ^ 2) / s) ^ 2)⁻¹) =
      fun r => (s / 2) * ((g ∘ f) r * f' r) := by
    funext r
    dsimp only [f, f', g, Function.comp_apply]
    field_simp [hs.ne']
  have hfzero : f 0 = -s := by
    dsimp only [f]
    field_simp [hs.ne']
    ring
  rw [hfactor, integral_const_mul, hchange, hfzero]

/-- The reciprocal planar wave-cone weight is integrable for positive time. -/
theorem integrable_coneReciprocal (s : Real) (hs : 0 < s) :
    Integrable (fun x : Euclidean 2 => coneReciprocal s x) := by
  let w : Real → Real := fun r => (1 + ((r ^ 2 - s ^ 2) / s) ^ 2)⁻¹
  have hrewrite : (fun x : Euclidean 2 => coneReciprocal s x) =
      fun x => w ‖x‖ := rfl
  rw [hrewrite]
  rw [integrable_fun_norm_addHaar (E := Euclidean 2)
    (μ := (volume : Measure (Euclidean 2)))]
  norm_num [finrank_euclideanSpace_fin, smul_eq_mul]
  exact integrable_radius_coneReciprocal s hs

/-- The total mass of the reciprocal planar wave-cone weight is `O(s)`. -/
theorem integral_coneReciprocal_le (s : Real) (hs : 0 < s) :
    (∫ x : Euclidean 2, coneReciprocal s x) ≤
      (volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s := by
  have hrad := integral_fun_norm_addHaar (E := Euclidean 2)
    (μ := (volume : Measure (Euclidean 2)))
    (fun r : Real => (1 + ((r ^ 2 - s ^ 2) / s) ^ 2)⁻¹)
  have hrewrite : (fun x : Euclidean 2 => coneReciprocal s x) =
      fun x => (1 + ((‖x‖ ^ 2 - s ^ 2) / s) ^ 2)⁻¹ := rfl
  rw [hrewrite]
  have hmeasure : 0 ≤ volume.real (Metric.ball (0 : Euclidean 2) 1) :=
    MeasureTheory.measureReal_nonneg
  have hpi : 0 ≤ Real.pi := Real.pi_pos.le
  have hI : (∫ u : Real in Ioi (-s), (1 + u ^ 2)⁻¹) ≤ Real.pi := by
    rw [integral_Ioi_inv_one_add_sq, Real.arctan_neg]
    linarith [Real.arctan_lt_pi_div_two s]
  have hradius := integral_radius_coneReciprocal s hs
  norm_num [finrank_euclideanSpace_fin, smul_eq_mul] at hrad
  rw [hradius] at hrad
  rw [hrad]
  calc
    2 * (volume.real (Metric.ball (0 : Euclidean 2) 1) *
        ((s / 2) * ∫ u : Real in Ioi (-s), (1 + u ^ 2)⁻¹)) ≤
      2 * (volume.real (Metric.ball (0 : Euclidean 2) 1) *
        ((s / 2) * Real.pi)) := by
      gcongr
    _ = (volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s := by
      ring

private theorem weighted_cauchy_schwarz
    (K : Euclidean 2 → Complex) (w : Euclidean 2 → Real)
    (hwpos : ∀ x, 0 < w x)
    (henergy : Integrable (fun x => w x * ‖K x‖ ^ 2))
    (hinv : Integrable (fun x => (w x)⁻¹)) :
    (∫ x : Euclidean 2, ‖K x‖) ≤
      (∫ x : Euclidean 2, w x * ‖K x‖ ^ 2) ^ ((2 : Real)⁻¹) *
        (∫ x : Euclidean 2, (w x)⁻¹) ^ ((2 : Real)⁻¹) := by
  let F : Euclidean 2 → Real := fun x => Real.sqrt (w x * ‖K x‖ ^ 2)
  let G : Euclidean 2 → Real := fun x => Real.sqrt ((w x)⁻¹)
  have hFmeas : AEStronglyMeasurable F volume := by
    exact Real.continuous_sqrt.comp_aestronglyMeasurable henergy.aestronglyMeasurable
  have hGmeas : AEStronglyMeasurable G volume := by
    exact Real.continuous_sqrt.comp_aestronglyMeasurable hinv.aestronglyMeasurable
  have hFsq : Integrable (fun x => F x ^ 2) := by
    refine henergy.congr ?_
    filter_upwards with x
    dsimp only [F]
    exact (Real.sq_sqrt (mul_nonneg (hwpos x).le (sq_nonneg _))).symm
  have hGsq : Integrable (fun x => G x ^ 2) := by
    refine hinv.congr ?_
    filter_upwards with x
    dsimp only [G]
    exact (Real.sq_sqrt (inv_nonneg.mpr (hwpos x).le)).symm
  have hFmem : MemLp F 2 volume :=
    (memLp_two_iff_integrable_sq hFmeas).mpr hFsq
  have hGmem : MemLp G 2 volume :=
    (memLp_two_iff_integrable_sq hGmeas).mpr hGsq
  have hFmem' : MemLp F (ENNReal.ofReal 2) volume := by
    norm_num
    exact hFmem
  have hGmem' : MemLp G (ENNReal.ofReal 2) volume := by
    norm_num
    exact hGmem
  have hholder := integral_mul_le_Lp_mul_Lq_of_nonneg (f := F) (g := G)
    Real.HolderConjugate.two_two
    (Eventually.of_forall fun x => Real.sqrt_nonneg _)
    (Eventually.of_forall fun x => Real.sqrt_nonneg _) hFmem' hGmem'
  have hleft : (fun x : Euclidean 2 => ‖K x‖) = fun x => F x * G x := by
    funext x
    dsimp only [F, G]
    have hroot : Real.sqrt (w x) ≠ 0 := ne_of_gt (Real.sqrt_pos.2 (hwpos x))
    symm
    calc
      Real.sqrt (w x * ‖K x‖ ^ 2) * Real.sqrt ((w x)⁻¹) =
          (Real.sqrt (w x) * Real.sqrt (‖K x‖ ^ 2)) * (Real.sqrt (w x))⁻¹ := by
        rw [Real.sqrt_mul (hwpos x).le, Real.sqrt_inv]
      _ = ‖K x‖ := by
        rw [Real.sqrt_sq (norm_nonneg _)]
        field_simp
  have hFint : (∫ x : Euclidean 2, F x ^ 2) =
      ∫ x : Euclidean 2, w x * ‖K x‖ ^ 2 := by
    apply integral_congr_ae
    filter_upwards with x
    dsimp only [F]
    exact Real.sq_sqrt (mul_nonneg (hwpos x).le (sq_nonneg _))
  have hGint : (∫ x : Euclidean 2, G x ^ 2) =
      ∫ x : Euclidean 2, (w x)⁻¹ := by
    apply integral_congr_ae
    filter_upwards with x
    dsimp only [G]
    exact Real.sq_sqrt (inv_nonneg.mpr (hwpos x).le)
  calc
    (∫ x : Euclidean 2, ‖K x‖) = ∫ x : Euclidean 2, F x * G x := by rw [hleft]
    _ ≤ (∫ x : Euclidean 2, F x ^ (2 : Real)) ^ (1 / (2 : Real)) *
        (∫ x : Euclidean 2, G x ^ (2 : Real)) ^ (1 / (2 : Real)) := hholder
    _ = (∫ x : Euclidean 2, w x * ‖K x‖ ^ 2) ^ ((2 : Real)⁻¹) *
        (∫ x : Euclidean 2, (w x)⁻¹) ^ ((2 : Real)⁻¹) := by
      rw [show (fun x : Euclidean 2 => F x ^ (2 : Real)) = fun x => F x ^ 2 by
        funext x
        rw [Real.rpow_two],
        show (fun x : Euclidean 2 => G x ^ (2 : Real)) = fun x => G x ^ 2 by
        funext x
        rw [Real.rpow_two], hFint, hGint]
      ring_nf

/-- A conditional weighted-`L²` estimate implies the planar wave-kernel
`L¹` bound needed for the sharp half-wave endpoint.  The only hypothesis is
integrability of the cone-weighted energy; the Fourier-side cancellation is
supplied separately. -/
theorem integral_norm_le_coneWeightedEnergy
    (K : Euclidean 2 → Complex) (s : Real) (hs : 0 < s)
    (henergy : Integrable (fun x => coneWeight s x * ‖K x‖ ^ 2)) :
    (∫ x : Euclidean 2, ‖K x‖) ≤
      (∫ x : Euclidean 2, coneWeight s x * ‖K x‖ ^ 2) ^ ((2 : Real)⁻¹) *
        ((volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s) ^ ((2 : Real)⁻¹) := by
  have hinv : Integrable (fun x : Euclidean 2 => (coneWeight s x)⁻¹) := by
    simpa only [coneReciprocal] using integrable_coneReciprocal s hs
  have hcs := weighted_cauchy_schwarz K (coneWeight s) (coneWeight_pos s) henergy hinv
  calc
    (∫ x : Euclidean 2, ‖K x‖) ≤
        (∫ x : Euclidean 2, coneWeight s x * ‖K x‖ ^ 2) ^ ((2 : Real)⁻¹) *
          (∫ x : Euclidean 2, (coneWeight s x)⁻¹) ^ ((2 : Real)⁻¹) := hcs
    _ ≤ (∫ x : Euclidean 2, coneWeight s x * ‖K x‖ ^ 2) ^ ((2 : Real)⁻¹) *
        ((volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s) ^ ((2 : Real)⁻¹) := by
      apply mul_le_mul_of_nonneg_left
      · apply Real.rpow_le_rpow
        · exact integral_nonneg fun x => inv_nonneg.mpr (coneWeight_pos s x).le
        · simpa only [coneReciprocal] using integral_coneReciprocal_le s hs
        · positivity
      · exact Real.rpow_nonneg
          (integral_nonneg fun x => mul_nonneg (coneWeight_pos s x).le (sq_nonneg _)) _

/-- The frequency-space wave operator whose leading `s²` contribution is
cancelled by the half-wave phase. -/
def cancelledWaveLaplacian
    (q : SchwartzMap (Euclidean 2) Complex) (s : Real) :
    SchwartzMap (Euclidean 2) Complex :=
  -Laplacian.laplacian q - (((2 * Real.pi * s) ^ 2 : Real) : Complex) • q

private def radialPhase (a : Real) : Euclidean 2 → Complex :=
  fun x => Complex.exp (((a * ‖x‖ : Real) : Complex) * Complex.I)

private def radialPhaseCoeff (a : Real) (x v : Euclidean 2) : Complex :=
  (((a * ‖x‖⁻¹ * inner Real x v : Real) : Complex) * Complex.I)

private def radialLaplacianCoeff (a : Real) (x : Euclidean 2) : Complex :=
  (((a * ‖x‖⁻¹ : Real) : Complex) * Complex.I)

private theorem radial_phase_laplacian_mul_cancelled
    (chi : Euclidean 2 → Complex) (a b : Real) (x : Euclidean 2)
    (hx : x ≠ 0) (hchi : ContDiffAt Real 2 chi x) (hsq : a ^ 2 = b ^ 2) :
    -Laplacian.laplacian (fun y => radialPhase a y * chi y) x -
        ((b ^ 2 : Real) : Complex) * (radialPhase a x * chi x) =
      -radialPhase a x *
        (Laplacian.laplacian chi x +
          (∑ i, (radialPhaseCoeff a x (stdOrthonormalBasis Real (Euclidean 2) i) *
                fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) +
            fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) *
              radialPhaseCoeff a x (stdOrthonormalBasis Real (Euclidean 2) i))) +
          radialLaplacianCoeff a x * chi x) := by
  have hphase : ContDiffAt Real 2 (radialPhase a) x := by
    have hnorm : ContDiffAt Real 2 (fun y : Euclidean 2 => ‖y‖) x :=
      contDiffAt_norm Real hx
    have hreal : ContDiffAt Real 2 (fun y : Euclidean 2 => a * ‖y‖) x := by
      fun_prop
    have hcomplex : ContDiffAt Real 2
        (fun y : Euclidean 2 => ((a * ‖y‖ : Real) : Complex)) x := by
      exact Complex.ofRealCLM.contDiff.contDiffAt.comp x hreal
    exact (hcomplex.mul contDiffAt_const).cexp
  rw [laplacian_mul_at (radialPhase a) chi hphase hchi]
  rw [show Laplacian.laplacian (radialPhase a) x =
      radialPhase a x * (-((a ^ 2 : Real) : Complex) +
        radialLaplacianCoeff a x) by
    change Laplacian.laplacian (fun y : Euclidean 2 =>
      Complex.exp (((a * ‖y‖ : Real) : Complex) * Complex.I)) x =
        Complex.exp (((a * ‖x‖ : Real) : Complex) * Complex.I) *
          (-((a ^ 2 : Real) : Complex) +
            (((a * ‖x‖⁻¹ : Real) : Complex) * Complex.I))
    exact laplacian_radial_phase_eq a x hx]
  simp_rw [show ∀ i,
      fderiv Real (radialPhase a) x (stdOrthonormalBasis Real (Euclidean 2) i) =
        radialPhase a x *
          radialPhaseCoeff a x (stdOrthonormalBasis Real (Euclidean 2) i) by
      intro i
      change fderiv Real (fun y : Euclidean 2 =>
        Complex.exp (((a * ‖y‖ : Real) : Complex) * Complex.I)) x
          (stdOrthonormalBasis Real (Euclidean 2) i) =
        Complex.exp (((a * ‖x‖ : Real) : Complex) * Complex.I) *
          (((a * ‖x‖⁻¹ *
            inner Real x (stdOrthonormalBasis Real (Euclidean 2) i) : Real) : Complex) *
              Complex.I)
      exact fderiv_radial_phase_apply a x
        (stdOrthonormalBasis Real (Euclidean 2) i) hx]
  have hcross : ∀ i,
      radialPhase a x * radialPhaseCoeff a x (stdOrthonormalBasis Real (Euclidean 2) i) *
          fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) +
        fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) *
          (radialPhase a x * radialPhaseCoeff a x (stdOrthonormalBasis Real (Euclidean 2) i)) =
        radialPhase a x *
          (radialPhaseCoeff a x (stdOrthonormalBasis Real (Euclidean 2) i) *
            fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) +
          fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) *
            radialPhaseCoeff a x (stdOrthonormalBasis Real (Euclidean 2) i)) := by
    intro i
    ring
  simp_rw [hcross]
  rw [← Finset.mul_sum]
  have hsqC : (a : Complex) ^ 2 = (b : Complex) ^ 2 := by
    exact_mod_cast hsq
  push_cast
  rw [hsqC]
  ring

private def halfWavePhaseParameter (σ : WaveSign) (s : Real) : Real :=
  σ.toReal * (2 * Real.pi) * s

private def levelZeroCutoff (C : lpCutoffs 2) : Euclidean 2 → Complex :=
  dyadicBandpassMultiplier C.cutoff 0

private def levelZeroCutoffLaplacian (C : lpCutoffs 2) : Euclidean 2 → Complex :=
  Laplacian.laplacian (levelZeroCutoff C)

private def levelZeroRadialCutoffTerm (C : lpCutoffs 2) (σ : WaveSign) :
    Euclidean 2 → Complex := fun x =>
  (∑ i, (radialPhaseCoeff (halfWavePhaseParameter σ 1) x
        (stdOrthonormalBasis Real (Euclidean 2) i) *
      fderiv Real (levelZeroCutoff C) x
        (stdOrthonormalBasis Real (Euclidean 2) i) +
    fderiv Real (levelZeroCutoff C) x
        (stdOrthonormalBasis Real (Euclidean 2) i) *
      radialPhaseCoeff (halfWavePhaseParameter σ 1) x
        (stdOrthonormalBasis Real (Euclidean 2) i))) +
    radialLaplacianCoeff (halfWavePhaseParameter σ 1) x * levelZeroCutoff C x

private theorem halfWaveMultiplier_eq_radialPhase (σ : WaveSign) (s : Real) :
    halfWaveMultiplier σ s = radialPhase (halfWavePhaseParameter σ s) := by
  rfl

private theorem levelZeroCutoff_contDiffAt (C : lpCutoffs 2) (x : Euclidean 2) :
    ContDiffAt Real 2 (levelZeroCutoff C) x := by
  exact (dyadicBandpassMultiplier C.cutoff 0).smooth 2 |>.contDiffAt

private theorem phase_parameter_sq (σ : WaveSign) (s : Real) :
    (halfWavePhaseParameter σ s) ^ 2 = (2 * Real.pi * s) ^ 2 := by
  cases σ <;> simp [halfWavePhaseParameter, WaveSign.toReal] <;> ring

private theorem radialPhaseCoeff_scale (σ : WaveSign) (s : Real) (x v : Euclidean 2) :
    radialPhaseCoeff (halfWavePhaseParameter σ s) x v =
      s * radialPhaseCoeff (halfWavePhaseParameter σ 1) x v := by
  simp only [radialPhaseCoeff, halfWavePhaseParameter]
  push_cast
  ring

private theorem radialLaplacianCoeff_scale (σ : WaveSign) (s : Real) (x : Euclidean 2) :
    radialLaplacianCoeff (halfWavePhaseParameter σ s) x =
      s * radialLaplacianCoeff (halfWavePhaseParameter σ 1) x := by
  simp only [radialLaplacianCoeff, halfWavePhaseParameter]
  push_cast
  ring

private theorem cancelled_levelZero_phase_formula
    (C : lpCutoffs 2) (σ : WaveSign) (s : Real) (x : Euclidean 2) (hx : x ≠ 0) :
    cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s x =
      -halfWaveMultiplier σ s x *
        (levelZeroCutoffLaplacian C x + s * levelZeroRadialCutoffTerm C σ x) := by
  have hfun : (dyadicHalfWaveSchwartzSymbol C σ 0 s : Euclidean 2 → Complex) =
      fun y => radialPhase (halfWavePhaseParameter σ s) y * levelZeroCutoff C y := by
    funext y
    rw [dyadicHalfWaveSchwartzSymbol_apply]
    rfl
  rw [cancelledWaveLaplacian]
  simp only [SchwartzMap.sub_apply, neg_apply, SchwartzMap.smul_apply,
    SchwartzMap.laplacian_apply, smul_eq_mul]
  change -Laplacian.laplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s :
      Euclidean 2 → Complex) x -
      (((2 * Real.pi * s) ^ 2 : Real) : Complex) *
        dyadicHalfWaveSchwartzSymbol C σ 0 s x = _
  rw [hfun]
  rw [radial_phase_laplacian_mul_cancelled (levelZeroCutoff C)
    (halfWavePhaseParameter σ s) (2 * Real.pi * s) x hx
    (levelZeroCutoff_contDiffAt C x) (phase_parameter_sq σ s)]
  rw [← halfWaveMultiplier_eq_radialPhase]
  simp only [levelZeroCutoffLaplacian, levelZeroRadialCutoffTerm]
  have hsum : (∑ i, (radialPhaseCoeff (halfWavePhaseParameter σ s) x
          (stdOrthonormalBasis Real (Euclidean 2) i) *
        fderiv Real (levelZeroCutoff C) x
          (stdOrthonormalBasis Real (Euclidean 2) i) +
      fderiv Real (levelZeroCutoff C) x
          (stdOrthonormalBasis Real (Euclidean 2) i) *
        radialPhaseCoeff (halfWavePhaseParameter σ s) x
          (stdOrthonormalBasis Real (Euclidean 2) i))) =
        s * (∑ i,
          (radialPhaseCoeff (halfWavePhaseParameter σ 1) x
            (stdOrthonormalBasis Real (Euclidean 2) i) *
            fderiv Real (levelZeroCutoff C) x
              (stdOrthonormalBasis Real (Euclidean 2) i) +
          fderiv Real (levelZeroCutoff C) x
            (stdOrthonormalBasis Real (Euclidean 2) i) *
            radialPhaseCoeff (halfWavePhaseParameter σ 1) x
              (stdOrthonormalBasis Real (Euclidean 2) i))) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    rw [radialPhaseCoeff_scale]
    ring
  have hradial : radialLaplacianCoeff (halfWavePhaseParameter σ s) x *
      levelZeroCutoff C x =
      s * (radialLaplacianCoeff (halfWavePhaseParameter σ 1) x *
        levelZeroCutoff C x) := by
    rw [radialLaplacianCoeff_scale]
    ring
  rw [hsum, hradial]
  ring

private theorem halfWaveMultiplier_neg_one_mul_one
    (σ : WaveSign) (x : Euclidean 2) :
    halfWaveMultiplier σ (-1) x * halfWaveMultiplier σ 1 x = 1 := by
  rw [← halfWaveMultiplier_add]
  norm_num [halfWaveMultiplier_zero]

private theorem cancelled_levelZero_phase_affine
    (C : lpCutoffs 2) (σ : WaveSign) (s : Real) (x : Euclidean 2) (hx : x ≠ 0) :
    cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s x =
      halfWaveMultiplier σ s x *
        (cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 0) 0 x +
          s * (halfWaveMultiplier σ (-1) x *
              cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 1) 1 x -
            cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 0) 0 x)) := by
  rw [cancelled_levelZero_phase_formula C σ s x hx,
    cancelled_levelZero_phase_formula C σ 0 x hx,
    cancelled_levelZero_phase_formula C σ 1 x hx]
  rw [halfWaveMultiplier_zero]
  have hinv : halfWaveMultiplier σ (-1) x * halfWaveMultiplier σ 1 x = 1 :=
    halfWaveMultiplier_neg_one_mul_one σ x
  have hdephase : halfWaveMultiplier σ (-1) x *
      (halfWaveMultiplier σ 1 x *
        (levelZeroCutoffLaplacian C x + levelZeroRadialCutoffTerm C σ x)) =
      levelZeroCutoffLaplacian C x + levelZeroRadialCutoffTerm C σ x := by
    calc
      _ = (halfWaveMultiplier σ (-1) x * halfWaveMultiplier σ 1 x) *
          (levelZeroCutoffLaplacian C x + levelZeroRadialCutoffTerm C σ x) := by ring
      _ = (1 : Complex) *
          (levelZeroCutoffLaplacian C x + levelZeroRadialCutoffTerm C σ x) := by rw [hinv]
      _ = _ := by ring
  norm_num
  rw [hdephase]
  ring

private theorem integral_norm_sq_phase_affine_le
    (r r0 r1 A p : Euclidean 2 → Complex) (s : Real)
    (hs : 1 ≤ s) (hp : ∀ x, ‖p x‖ = 1)
    (hidentity : ∀ᵐ x ∂volume, r x = p x * (r0 x + s * A x))
    (hA : ∀ x, ‖A x‖ ≤ ‖r1 x‖ + ‖r0 x‖)
    (hr : Integrable (fun x => ‖r x‖ ^ 2))
    (hr0 : Integrable (fun x => ‖r0 x‖ ^ 2))
    (hr1 : Integrable (fun x => ‖r1 x‖ ^ 2)) :
    (∫ x : Euclidean 2, ‖r x‖ ^ 2) ≤
      s ^ 2 * (8 * (∫ x : Euclidean 2, ‖r0 x‖ ^ 2) +
        2 * (∫ x : Euclidean 2, ‖r1 x‖ ^ 2)) := by
  have hH : Integrable (fun x : Euclidean 2 =>
      8 * ‖r0 x‖ ^ 2 + 2 * ‖r1 x‖ ^ 2) :=
    (hr0.const_mul 8).add (hr1.const_mul 2)
  have hHs : Integrable (fun x : Euclidean 2 =>
      s ^ 2 * (8 * ‖r0 x‖ ^ 2 + 2 * ‖r1 x‖ ^ 2)) :=
    hH.const_mul (s ^ 2)
  have hpoint : ∀ᵐ x : Euclidean 2 ∂volume,
      ‖r x‖ ^ 2 ≤ s ^ 2 * (8 * ‖r0 x‖ ^ 2 + 2 * ‖r1 x‖ ^ 2) :=
    hidentity.mono fun x hident => by
    rw [hident, norm_mul, hp x, one_mul]
    have hnonneg : 0 ≤ 2 * ‖r0 x‖ + ‖r1 x‖ := by positivity
    have hs0 : 0 ≤ s := by linarith
    have hlin : ‖r0 x + s * A x‖ ≤ s * (2 * ‖r0 x‖ + ‖r1 x‖) := by
      calc
        ‖r0 x + s * A x‖ ≤ ‖r0 x‖ + ‖s * A x‖ := norm_add_le _ _
        _ = ‖r0 x‖ + s * ‖A x‖ := by
          rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (by linarith)]
        _ ≤ ‖r0 x‖ + s * (‖r1 x‖ + ‖r0 x‖) := by
          exact add_le_add_right
            (mul_le_mul_of_nonneg_left (hA x) hs0) _
        _ ≤ s * (2 * ‖r0 x‖ + ‖r1 x‖) := by
          nlinarith [norm_nonneg (r0 x), norm_nonneg (r1 x)]
    have hsq : ‖r0 x + s * A x‖ ^ 2 ≤
        (s * (2 * ‖r0 x‖ + ‖r1 x‖)) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) (mul_nonneg hs0 hnonneg)).mpr hlin
    calc
      ‖r0 x + s * A x‖ ^ 2 ≤ (s * (2 * ‖r0 x‖ + ‖r1 x‖)) ^ 2 := hsq
      _ ≤ s ^ 2 * (8 * ‖r0 x‖ ^ 2 + 2 * ‖r1 x‖ ^ 2) := by
        nlinarith [sq_nonneg (2 * ‖r0 x‖ - ‖r1 x‖)]
  calc
    (∫ x : Euclidean 2, ‖r x‖ ^ 2) ≤
        ∫ x : Euclidean 2, s ^ 2 * (8 * ‖r0 x‖ ^ 2 + 2 * ‖r1 x‖ ^ 2) :=
      integral_mono_ae hr hHs hpoint
    _ = s ^ 2 * (8 * (∫ x : Euclidean 2, ‖r0 x‖ ^ 2) +
        2 * (∫ x : Euclidean 2, ‖r1 x‖ ^ 2)) := by
      rw [integral_const_mul, integral_add (hr0.const_mul 8) (hr1.const_mul 2),
        integral_const_mul, integral_const_mul]

/-- The cancelled frequency-side energy of the level-zero cutoff half-wave is
uniformly `O(s²)` for both half-wave orientations. -/
theorem exists_cancelled_levelZero_dyadicHalfWave_energy_bound
    (C : lpCutoffs 2) :
    ∃ R : Real, ∀ (σ : WaveSign) (s : Real), 2 ≤ s →
      (∫ ξ : Euclidean 2,
        ‖cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s ξ‖ ^ 2) ≤
          R * s ^ 2 := by
  let r0 : WaveSign → Euclidean 2 → Complex := fun σ =>
    cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 0) 0
  let r1 : WaveSign → Euclidean 2 → Complex := fun σ =>
    cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 1) 1
  let H : WaveSign → Real := fun σ =>
    8 * (∫ x : Euclidean 2, ‖r0 σ x‖ ^ 2) +
      2 * (∫ x : Euclidean 2, ‖r1 σ x‖ ^ 2)
  let R : Real := H WaveSign.plus + H WaveSign.minus
  have hHnonneg (σ : WaveSign) : 0 ≤ H σ := by
    dsimp only [H]
    exact add_nonneg
      (mul_nonneg (by norm_num) (integral_nonneg fun x => sq_nonneg (‖r0 σ x‖)))
      (mul_nonneg (by norm_num) (integral_nonneg fun x => sq_nonneg (‖r1 σ x‖)))
  have hHle (σ : WaveSign) : H σ ≤ R := by
    cases σ <;> dsimp only [R] <;> linarith [hHnonneg WaveSign.plus,
      hHnonneg WaveSign.minus]
  refine ⟨R, ?_⟩
  intro σ s hs
  let r : Euclidean 2 → Complex :=
    cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s
  let A : Euclidean 2 → Complex := fun x =>
    halfWaveMultiplier σ (-1) x * r1 σ x - r0 σ x
  have hr : Integrable (fun x => ‖r x‖ ^ 2) := by
    dsimp only [r]
    exact (cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s).memLp
      2 volume |>.integrable_norm_pow (by norm_num)
  have hr0 : Integrable (fun x => ‖r0 σ x‖ ^ 2) := by
    dsimp only [r0]
    exact (cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 0) 0).memLp
      2 volume |>.integrable_norm_pow (by norm_num)
  have hr1 : Integrable (fun x => ‖r1 σ x‖ ^ 2) := by
    dsimp only [r1]
    exact (cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 1) 1).memLp
      2 volume |>.integrable_norm_pow (by norm_num)
  have hA : ∀ x, ‖A x‖ ≤ ‖r1 σ x‖ + ‖r0 σ x‖ := by
    intro x
    dsimp only [A]
    calc
      ‖halfWaveMultiplier σ (-1) x * r1 σ x - r0 σ x‖ ≤
          ‖halfWaveMultiplier σ (-1) x * r1 σ x‖ + ‖r0 σ x‖ := norm_sub_le _ _
      _ = ‖r1 σ x‖ + ‖r0 σ x‖ := by
        rw [norm_mul, norm_halfWaveMultiplier, one_mul]
  have hidentity : ∀ᵐ x : Euclidean 2 ∂volume,
      r x = halfWaveMultiplier σ s x * (r0 σ x + s * A x) := by
    have hne : ∀ᵐ x : Euclidean 2 ∂volume, x ≠ 0 := by
      simp [ae_iff, measure_singleton]
    filter_upwards [hne] with x hx
    exact cancelled_levelZero_phase_affine C σ s x hx
  have hbound := integral_norm_sq_phase_affine_le r (r0 σ) (r1 σ) A
    (halfWaveMultiplier σ s) s (by linarith) (norm_halfWaveMultiplier σ s)
    hidentity hA hr hr0 hr1
  change (∫ ξ : Euclidean 2,
    ‖cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s ξ‖ ^ 2) ≤
      R * s ^ 2
  calc
    (∫ ξ : Euclidean 2,
      ‖cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s ξ‖ ^ 2) =
        ∫ x : Euclidean 2, ‖r x‖ ^ 2 := by rfl
    _ ≤ s ^ 2 * H σ := hbound
    _ ≤ s ^ 2 * R := mul_le_mul_of_nonneg_left (hHle σ) (sq_nonneg _)
    _ = R * s ^ 2 := by ring

private theorem integral_norm_sq_fourierInv_schwartz_eq
    (q : SchwartzMap (Euclidean 2) Complex) :
    (∫ x : Euclidean 2, ‖(𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2) =
      ∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2 := by
  calc
    (∫ x : Euclidean 2, ‖(𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2) =
        ∫ ξ : Euclidean 2,
          ‖𝓕 ((𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex) ξ‖ ^ 2 :=
      (_root_.Codex.Spherical.FourierRadius.integral_norm_sq_fourier_schwartz_eq
        (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)).symm
    _ = ∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2 := by
      apply integral_congr_ae
      filter_upwards with ξ
      rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]

private theorem cone_weight_pointwise
    (q : SchwartzMap (Euclidean 2) Complex) (s : Real) (hs : s ≠ 0)
    (x : Euclidean 2) :
    coneWeight s x * ‖(𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2 =
      ‖(𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2 +
        s⁻¹ ^ 2 * ‖(SchwartzMap.smulLeftCLM Complex
          (fun y : Euclidean 2 => ‖y‖ ^ 2 - s ^ 2)
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) x‖ ^ 2 := by
  have hmul :
      (SchwartzMap.smulLeftCLM Complex
        (fun y : Euclidean 2 => ‖y‖ ^ 2 - s ^ 2)
        (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) x =
      ((‖x‖ ^ 2 - s ^ 2 : Real) : Complex) *
        (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x := by
    simpa [smul_eq_mul] using congrFun (SchwartzMap.smulLeftCLM_apply
      (show (fun y : Euclidean 2 => ‖y‖ ^ 2 - s ^ 2).HasTemperateGrowth by fun_prop)
      (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) x
  rw [coneWeight, hmul, norm_mul, Complex.norm_real, Real.norm_eq_abs, mul_pow, sq_abs]
  field_simp [hs]

/-- The physical cone-weighted energy of an inverse Fourier transform is
integrable at every nonzero time. -/
theorem integrable_coneWeightedEnergy_fourierInv
    (q : SchwartzMap (Euclidean 2) Complex) (s : Real) (hs : s ≠ 0) :
    Integrable (fun x : Euclidean 2 =>
      coneWeight s x * ‖(𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2) := by
  let K : SchwartzMap (Euclidean 2) Complex := 𝓕⁻ q
  let P : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex (fun x : Euclidean 2 => ‖x‖ ^ 2 - s ^ 2) K
  have hK : Integrable (fun x : Euclidean 2 => ‖K x‖ ^ 2) :=
    (K.memLp 2 volume).integrable_norm_pow (by norm_num)
  have hP : Integrable (fun x : Euclidean 2 => ‖P x‖ ^ 2) :=
    (P.memLp 2 volume).integrable_norm_pow (by norm_num)
  have hsum : Integrable (fun x : Euclidean 2 =>
      ‖K x‖ ^ 2 + s⁻¹ ^ 2 * ‖P x‖ ^ 2) :=
    hK.add (hP.const_mul _)
  refine hsum.congr ?_
  filter_upwards with x
  dsimp only [K, P]
  exact (cone_weight_pointwise q s hs x).symm

private theorem integral_cone_moment_le_cancelled
    (q : SchwartzMap (Euclidean 2) Complex) (s : Real) :
    (∫ x : Euclidean 2, ‖(SchwartzMap.smulLeftCLM Complex
      (fun y : Euclidean 2 => ‖y‖ ^ 2 - s ^ 2)
      (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) x‖ ^ 2) ≤
      ∫ ξ : Euclidean 2, ‖cancelledWaveLaplacian q s ξ‖ ^ 2 := by
  let K : SchwartzMap (Euclidean 2) Complex := 𝓕⁻ q
  let P : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex (fun x : Euclidean 2 => ‖x‖ ^ 2 - s ^ 2) K
  let r : SchwartzMap (Euclidean 2) Complex := cancelledWaveLaplacian q s
  let c : Complex := (((2 * Real.pi) ^ 2 : Real) : Complex)
  have hphase : (𝓕⁻ r : SchwartzMap (Euclidean 2) Complex) = c • P := by
    dsimp only [r, c, P, K, cancelledWaveLaplacian]
    exact fourierInv_cancelled_laplacian_eq_cone_quadratic q s
  have hc : (1 : Real) ≤ ‖c‖ := by
    dsimp only [c]
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
    nlinarith [Real.one_le_pi_div_two]
  have hP : Integrable (fun x : Euclidean 2 => ‖P x‖ ^ 2) :=
    (P.memLp 2 volume).integrable_norm_pow (by norm_num)
  have hR : Integrable (fun x : Euclidean 2 =>
      ‖(𝓕⁻ r : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2) :=
    ((𝓕⁻ r : SchwartzMap (Euclidean 2) Complex).memLp 2 volume).integrable_norm_pow
      (by norm_num)
  have hpoint (x : Euclidean 2) : ‖P x‖ ^ 2 ≤
      ‖(𝓕⁻ r : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2 := by
    rw [hphase, smul_apply, norm_smul]
    apply (sq_le_sq₀ (norm_nonneg _) (mul_nonneg (norm_nonneg _) (norm_nonneg _))).mpr
    exact le_mul_of_one_le_left (norm_nonneg _) hc
  change (∫ x : Euclidean 2, ‖P x‖ ^ 2) ≤ ∫ ξ : Euclidean 2, ‖r ξ‖ ^ 2
  calc
    (∫ x : Euclidean 2, ‖P x‖ ^ 2) ≤
        ∫ x : Euclidean 2, ‖(𝓕⁻ r : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2 :=
      integral_mono hP hR hpoint
    _ = ∫ ξ : Euclidean 2, ‖r ξ‖ ^ 2 :=
      integral_norm_sq_fourierInv_schwartz_eq r

/-- Plancherel converts the physical cone-weighted energy of `𝓕⁻ q` into
the ordinary energy of `q` plus the scaled energy of the cancelled wave
Laplacian.  This is the bridge from Fourier-side phase calculus to the sharp
kernel estimate. -/
theorem integral_coneWeightedEnergy_fourierInv_le
    (q : SchwartzMap (Euclidean 2) Complex) (s : Real) (hs : 0 < s) :
    (∫ x : Euclidean 2,
      coneWeight s x * ‖(𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2) ≤
      (∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2) + s⁻¹ ^ 2 *
        ∫ ξ : Euclidean 2, ‖cancelledWaveLaplacian q s ξ‖ ^ 2 := by
  let K : SchwartzMap (Euclidean 2) Complex := 𝓕⁻ q
  let P : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex (fun x : Euclidean 2 => ‖x‖ ^ 2 - s ^ 2) K
  let r : SchwartzMap (Euclidean 2) Complex := cancelledWaveLaplacian q s
  have hK : Integrable (fun x : Euclidean 2 => ‖K x‖ ^ 2) :=
    (K.memLp 2 volume).integrable_norm_pow (by norm_num)
  have hP : Integrable (fun x : Euclidean 2 => ‖P x‖ ^ 2) :=
    (P.memLp 2 volume).integrable_norm_pow (by norm_num)
  have hweight : (∫ x : Euclidean 2,
      coneWeight s x * ‖K x‖ ^ 2) =
      ∫ x : Euclidean 2, ‖K x‖ ^ 2 + s⁻¹ ^ 2 * ‖P x‖ ^ 2 := by
    apply integral_congr_ae
    filter_upwards with x
    dsimp only [K, P]
    exact cone_weight_pointwise q s hs.ne' x
  have hsum : (∫ x : Euclidean 2, ‖K x‖ ^ 2 + s⁻¹ ^ 2 * ‖P x‖ ^ 2) =
      (∫ x : Euclidean 2, ‖K x‖ ^ 2) + s⁻¹ ^ 2 *
        ∫ x : Euclidean 2, ‖P x‖ ^ 2 := by
    rw [integral_add hK (hP.const_mul _), integral_const_mul]
  have hmoment : (∫ x : Euclidean 2, ‖P x‖ ^ 2) ≤
      ∫ ξ : Euclidean 2, ‖r ξ‖ ^ 2 := by
    simpa only [P, K, r] using integral_cone_moment_le_cancelled q s
  have hinv : 0 ≤ s⁻¹ ^ 2 := sq_nonneg _
  calc
    (∫ x : Euclidean 2, coneWeight s x * ‖(𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2) =
        ∫ x : Euclidean 2, coneWeight s x * ‖K x‖ ^ 2 := by rfl
    _ = ∫ x : Euclidean 2, ‖K x‖ ^ 2 + s⁻¹ ^ 2 * ‖P x‖ ^ 2 := hweight
    _ = (∫ x : Euclidean 2, ‖K x‖ ^ 2) + s⁻¹ ^ 2 *
        ∫ x : Euclidean 2, ‖P x‖ ^ 2 := hsum
    _ ≤ (∫ x : Euclidean 2, ‖K x‖ ^ 2) + s⁻¹ ^ 2 *
        ∫ ξ : Euclidean 2, ‖r ξ‖ ^ 2 := by gcongr
    _ = (∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2) + s⁻¹ ^ 2 *
        ∫ ξ : Euclidean 2, ‖r ξ‖ ^ 2 := by
      rw [show (∫ x : Euclidean 2, ‖K x‖ ^ 2) = ∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2 by
        simpa only [K] using integral_norm_sq_fourierInv_schwartz_eq q]

/-- A pointwise square bound for a compactly supported planar Schwartz
function integrates to the bound times the measure of its support container. -/
theorem integral_norm_sq_le_of_support_subset
    (q : SchwartzMap (Euclidean 2) Complex) (K : Set (Euclidean 2))
    (hK : MeasurableSet K) (hKfinite : volume K ≠ (⊤ : ENNReal))
    {A : Real} (hpoint : ∀ ξ : Euclidean 2, ‖q ξ‖ ^ 2 ≤ A)
    (hsupport : Function.support (q : Euclidean 2 → Complex) ⊆ K) :
    (∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2) ≤ A * volume.real K := by
  have hq : Integrable (fun ξ : Euclidean 2 => ‖q ξ‖ ^ 2) :=
    (q.memLp 2 volume).integrable_norm_pow (by norm_num)
  have hI : Integrable (K.indicator (fun _ : Euclidean 2 => A)) := by
    rw [integrable_indicator_iff hK]
    exact integrableOn_const hKfinite (by finiteness)
  have hmono : (fun ξ : Euclidean 2 => ‖q ξ‖ ^ 2) ≤
      K.indicator (fun _ : Euclidean 2 => A) := by
    intro ξ
    by_cases hξ : ξ ∈ K
    · rw [indicator_of_mem hξ]
      exact hpoint ξ
    · rw [indicator_of_notMem hξ]
      have hzero : q ξ = 0 := by
        by_contra hqzero
        exact hξ (hsupport (Function.mem_support.mpr hqzero))
      simp [hzero]
  calc
    (∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2) ≤
        ∫ ξ : Euclidean 2, K.indicator (fun _ : Euclidean 2 => A) ξ :=
      integral_mono hq hI hmono
    _ = volume.real K * A := by
      simpa only [smul_eq_mul] using
        (integral_indicator_const (μ := volume) (e := A) hK)
    _ = A * volume.real K := by ring

/-- A pointwise `O(s)` bound on a compactly supported planar Schwartz
function yields the scale-compatible `O(s²)` energy estimate. -/
theorem integral_norm_sq_le_scaled_of_norm_le_of_support_subset
    (q : SchwartzMap (Euclidean 2) Complex) (K : Set (Euclidean 2))
    (hK : MeasurableSet K) (hKfinite : volume K ≠ (⊤ : ENNReal))
    {B s : Real} (hB : 0 ≤ B) (hs : 0 ≤ s)
    (hpoint : ∀ ξ : Euclidean 2, ‖q ξ‖ ≤ B * s)
    (hsupport : Function.support (q : Euclidean 2 → Complex) ⊆ K) :
    (∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2) ≤ (B ^ 2 * volume.real K) * s ^ 2 := by
  have hBs : 0 ≤ B * s := mul_nonneg hB hs
  have hpointSq : ∀ ξ : Euclidean 2, ‖q ξ‖ ^ 2 ≤ (B * s) ^ 2 := by
    intro ξ
    nlinarith [norm_nonneg (q ξ), hpoint ξ, hBs]
  calc
    (∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2) ≤ (B * s) ^ 2 * volume.real K :=
      integral_norm_sq_le_of_support_subset q K hK hKfinite hpointSq hsupport
    _ = (B ^ 2 * volume.real K) * s ^ 2 := by ring

/-- The level-zero cutoff half-wave symbols have a uniform `L²` bound,
independent of orientation and time. -/
theorem integral_norm_sq_levelZero_dyadicHalfWaveSchwartzSymbol_le
    (C : lpCutoffs 2) (σ : WaveSign) (s : Real) :
    (∫ ξ : Euclidean 2,
      ‖dyadicHalfWaveSchwartzSymbol C σ 0 s ξ‖ ^ 2) ≤
      4 * volume.real (Metric.closedBall (0 : Euclidean 2) 4) := by
  apply integral_norm_sq_le_of_support_subset
    (q := dyadicHalfWaveSchwartzSymbol C σ 0 s)
    (K := Metric.closedBall (0 : Euclidean 2) 4)
  · exact measurableSet_closedBall
  · exact measure_closedBall_lt_top.ne
  · intro ξ
    nlinarith [norm_nonneg (dyadicHalfWaveSchwartzSymbol C σ 0 s ξ),
      norm_dyadicHalfWaveSchwartzSymbol_le_two C σ 0 s ξ]
  · intro ξ hξ
    by_contra hξK
    have hnorm : (4 : Real) ≤ ‖ξ‖ := by
      rw [Metric.mem_closedBall, dist_zero_right] at hξK
      exact le_of_not_ge hξK
    have hband : dyadicBandpassMultiplier C.cutoff 0 ξ = 0 :=
      dyadicBandpass_eq_zero_of_le_norm C (by
        norm_num
        exact hnorm)
    have hzero : dyadicHalfWaveSchwartzSymbol C σ 0 s ξ = 0 := by
      rw [dyadicHalfWaveSchwartzSymbol_apply, dyadicHalfWaveSymbol, hband, mul_zero]
    change dyadicHalfWaveSchwartzSymbol C σ 0 s ξ ≠ 0 at hξ
    exact hξ hzero

/-- A uniform level-zero cone-weighted energy bound for both wave signs.

This is the precise Fourier-side cancellation input needed for the sharp
physical kernel endpoint.  It is deliberately separated from the
physical-space Cauchy--Schwarz and scaling argument. -/
def HasUniformConeWeightedKernelEnergy (C : lpCutoffs 2) : Prop :=
  ∃ A : Real, 0 < A ∧ ∀ (σ : WaveSign) (s : Real), 2 ≤ s →
    Integrable (fun x : Euclidean 2 =>
      coneWeight s x * ‖dyadicHalfWaveKernel C σ 0 s x‖ ^ 2) ∧
      (∫ x : Euclidean 2,
        coneWeight s x * ‖dyadicHalfWaveKernel C σ 0 s x‖ ^ 2) ≤ A

/-- Uniform ordinary and cancelled frequency-side energies imply the
level-zero cone-weighted kernel energy used by the sharp MSS kernel bound. -/
theorem hasUniformConeWeightedKernelEnergy_of_frequencyBounds
    (C : lpCutoffs 2) {Q R : Real}
    (hQ : ∀ (σ : WaveSign) (s : Real), 2 ≤ s →
      (∫ ξ : Euclidean 2,
        ‖dyadicHalfWaveSchwartzSymbol C σ 0 s ξ‖ ^ 2) ≤ Q)
    (hR : ∀ (σ : WaveSign) (s : Real), 2 ≤ s →
      (∫ ξ : Euclidean 2,
        ‖cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s ξ‖ ^ 2) ≤
          R * s ^ 2) :
    HasUniformConeWeightedKernelEnergy C := by
  let A : Real := |Q| + |R| + 1
  have hA : 0 < A := by
    dsimp only [A]
    positivity
  refine ⟨A, hA, ?_⟩
  intro σ s hs
  have hs0 : s ≠ 0 := by linarith
  constructor
  · simpa only [dyadicHalfWaveKernel] using
      integrable_coneWeightedEnergy_fourierInv
        (dyadicHalfWaveSchwartzSymbol C σ 0 s) s hs0
  · calc
      (∫ x : Euclidean 2,
        coneWeight s x * ‖dyadicHalfWaveKernel C σ 0 s x‖ ^ 2) ≤
          (∫ ξ : Euclidean 2,
            ‖dyadicHalfWaveSchwartzSymbol C σ 0 s ξ‖ ^ 2) + s⁻¹ ^ 2 *
              ∫ ξ : Euclidean 2,
                ‖cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s ξ‖ ^ 2 := by
            simpa only [dyadicHalfWaveKernel] using
              integral_coneWeightedEnergy_fourierInv_le
                (dyadicHalfWaveSchwartzSymbol C σ 0 s) s (by linarith)
      _ ≤ Q + s⁻¹ ^ 2 * (R * s ^ 2) := by
        gcongr
        · exact hQ σ s hs
        · exact hR σ s hs
      _ = Q + R := by
        field_simp [hs0]
      _ ≤ A := by
        dsimp only [A]
        linarith [le_abs_self Q, le_abs_self R]

/-- After the elementary cutoff-symbol energy is absorbed, the cancelled
frequency energy alone is sufficient for the uniform kernel cone energy. -/
theorem hasUniformConeWeightedKernelEnergy_of_cancelledEnergyBound
    (C : lpCutoffs 2) {R : Real}
    (hR : ∀ (σ : WaveSign) (s : Real), 2 ≤ s →
      (∫ ξ : Euclidean 2,
        ‖cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s ξ‖ ^ 2) ≤
          R * s ^ 2) :
    HasUniformConeWeightedKernelEnergy C := by
  apply hasUniformConeWeightedKernelEnergy_of_frequencyBounds C
    (Q := 4 * volume.real (Metric.closedBall (0 : Euclidean 2) 4)) (R := R)
  · intro σ s _
    exact integral_norm_sq_levelZero_dyadicHalfWaveSchwartzSymbol_le C σ s
  · exact hR

/-- The level-zero cutoff half-wave has uniformly bounded cone-weighted
physical energy.  Its proof is the Fourier-side phase cancellation above,
combined with Plancherel. -/
theorem hasUniformConeWeightedKernelEnergy (C : lpCutoffs 2) :
    HasUniformConeWeightedKernelEnergy C := by
  rcases exists_cancelled_levelZero_dyadicHalfWave_energy_bound C with ⟨R, hR⟩
  exact hasUniformConeWeightedKernelEnergy_of_cancelledEnergyBound C hR

/-- At level zero, a cone-weighted energy bound controls the physical
kernel `L¹` norm. -/
theorem levelZeroKernelL1_le_of_coneWeightedEnergy
    (C : lpCutoffs 2) (σ : WaveSign) (s : Real) (hs : 0 < s)
    {A : Real}
    (henergy : Integrable (fun x : Euclidean 2 =>
      coneWeight s x * ‖dyadicHalfWaveKernel C σ 0 s x‖ ^ 2))
    (hbound : (∫ x : Euclidean 2,
      coneWeight s x * ‖dyadicHalfWaveKernel C σ 0 s x‖ ^ 2) ≤ A) :
    dyadicHalfWaveKernelL1 C σ 0 s ≤
      A ^ ((2 : Real)⁻¹) *
        ((volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s) ^ ((2 : Real)⁻¹) := by
  have hmain := integral_norm_le_coneWeightedEnergy
    (dyadicHalfWaveKernel C σ 0 s) s hs henergy
  have henergy_nonneg : 0 ≤ ∫ x : Euclidean 2,
      coneWeight s x * ‖dyadicHalfWaveKernel C σ 0 s x‖ ^ 2 :=
    integral_nonneg fun x => mul_nonneg (coneWeight_pos s x).le (sq_nonneg _)
  have hfactor_nonneg : 0 ≤
      ((volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s) ^ ((2 : Real)⁻¹) := by
    apply Real.rpow_nonneg
    exact mul_nonneg (mul_nonneg MeasureTheory.measureReal_nonneg Real.pi_pos.le) hs.le
  change (∫ x : Euclidean 2, ‖dyadicHalfWaveKernel C σ 0 s x‖) ≤ _
  calc
    (∫ x : Euclidean 2, ‖dyadicHalfWaveKernel C σ 0 s x‖) ≤
        (∫ x : Euclidean 2,
          coneWeight s x * ‖dyadicHalfWaveKernel C σ 0 s x‖ ^ 2) ^ ((2 : Real)⁻¹) *
          ((volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s) ^ ((2 : Real)⁻¹) := hmain
    _ ≤ A ^ ((2 : Real)⁻¹) *
        ((volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s) ^ ((2 : Real)⁻¹) :=
      mul_le_mul_of_nonneg_right
        (Real.rpow_le_rpow henergy_nonneg hbound (by positivity)) hfactor_nonneg

/-- A uniform level-zero cone-energy estimate yields the sharp `2^{j/2}`
bound for every dyadic physical kernel on the MSS unit time interval. -/
theorem waveKernelL1_sharp_of_uniformConeWeightedEnergy
    (C : lpCutoffs 2) (hcone : HasUniformConeWeightedKernelEnergy C) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : WaveSign) (j : Nat), 1 ≤ j →
      ∀ t : Real, t ∈ Icc (1 : Real) 2 →
        dyadicHalfWaveKernelL1 C σ j t ≤ B * Real.sqrt ((2 : Real) ^ j) := by
  rcases hcone with ⟨A, hA, hcone⟩
  let D : Real := volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi
  let B : Real := 1 + A ^ ((2 : Real)⁻¹) * (D * 2) ^ ((2 : Real)⁻¹)
  have hD : 0 ≤ D := by
    dsimp only [D]
    exact mul_nonneg MeasureTheory.measureReal_nonneg Real.pi_pos.le
  have hD2 : 0 ≤ D * (2 : Real) := mul_nonneg hD (by norm_num)
  have hB : 0 < B := by
    have hterm : 0 ≤ A ^ ((2 : Real)⁻¹) * (D * 2) ^ ((2 : Real)⁻¹) :=
      mul_nonneg (Real.rpow_nonneg hA.le _) (Real.rpow_nonneg hD2 _)
    dsimp only [B]
    linarith
  refine ⟨B, hB, ?_⟩
  intro σ j hj t ht
  let q : Real := (2 : Real) ^ j
  let s : Real := q * t
  have hqpos : 0 < q := by
    dsimp only [q]
    positivity
  have hqnonneg : 0 ≤ q := hqpos.le
  have hqge : 2 ≤ q := by
    dsimp only [q]
    calc
      (2 : Real) = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ j := by exact pow_le_pow_right₀ (by norm_num) hj
  have hspos : 0 < s := by
    dsimp only [s]
    exact mul_pos hqpos (lt_of_lt_of_le (by norm_num) ht.1)
  have hsge : 2 ≤ s := by
    dsimp only [s]
    calc
      (2 : Real) ≤ q := hqge
      _ = q * 1 := (mul_one q).symm
      _ ≤ q * t := mul_le_mul_of_nonneg_left ht.1 hqnonneg
  obtain ⟨henergy, henergy_bound⟩ := hcone σ s hsge
  have hlevel := levelZeroKernelL1_le_of_coneWeightedEnergy
    C σ s hspos henergy henergy_bound
  have hscale : dyadicHalfWaveKernelL1 C σ j t = dyadicHalfWaveKernelL1 C σ 0 s := by
    simpa only [s, q] using dyadicHalfWaveKernelL1_eq_levelZero_scaled C σ j t
  rw [hscale]
  have hst : s ≤ q * 2 := by
    dsimp only [s]
    exact mul_le_mul_of_nonneg_left ht.2 hqnonneg
  have hDst : D * s ≤ D * (q * 2) := mul_le_mul_of_nonneg_left hst hD
  have hcone_nonneg : 0 ≤ D * s := mul_nonneg hD hspos.le
  calc
    dyadicHalfWaveKernelL1 C σ 0 s ≤ A ^ ((2 : Real)⁻¹) * (D * s) ^ ((2 : Real)⁻¹) := by
      simpa only [D] using hlevel
    _ ≤ A ^ ((2 : Real)⁻¹) * (D * (q * 2)) ^ ((2 : Real)⁻¹) := by
      apply mul_le_mul_of_nonneg_left
      · exact Real.rpow_le_rpow hcone_nonneg hDst (by positivity)
      · exact Real.rpow_nonneg hA.le _
    _ = (A ^ ((2 : Real)⁻¹) * (D * 2) ^ ((2 : Real)⁻¹)) * Real.sqrt q := by
      rw [show D * (q * 2) = (D * 2) * q by ring,
        Real.mul_rpow hD2 hqnonneg]
      have hqsqrt : q ^ ((2 : Real)⁻¹) = Real.sqrt q := by
        rw [show (2 : Real)⁻¹ = 1 / 2 by norm_num, ← Real.sqrt_eq_rpow]
      rw [hqsqrt]
      ring
    _ ≤ B * Real.sqrt ((2 : Real) ^ j) := by
      change (A ^ ((2 : Real)⁻¹) * (D * 2) ^ ((2 : Real)⁻¹)) * Real.sqrt q ≤
        B * Real.sqrt q
      apply mul_le_mul_of_nonneg_right
      · dsimp only [B]
        linarith
      · exact Real.sqrt_nonneg _

/-- The physical fixed-time `L∞` endpoint that follows formally from any
sharp dyadic kernel `L¹` estimate. -/
theorem mssLInfinityEndpoint_of_waveKernelL1_sharp
    (C : lpCutoffs 2) {B : Real}
    (hkernel : ∀ (σ : WaveSign) (j : Nat), 1 ≤ j →
      ∀ t : Real, t ∈ Icc (1 : Real) 2 →
        dyadicHalfWaveKernelL1 C σ j t ≤ B * Real.sqrt ((2 : Real) ^ j)) :
    ∀ (σ : WaveSign) (j : Nat), 1 ≤ j →
      ∀ t : Real, t ∈ Icc (1 : Real) 2 →
        ∀ (f : SchwartzMap (Euclidean 2) Complex) {A : Real},
          (∀ x, ‖f x‖ ≤ A) → ∀ x,
            ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
              (B * Real.sqrt ((2 : Real) ^ j)) * A := by
  intro σ j hj t ht f A hf x
  have hA : 0 ≤ A := le_trans (norm_nonneg (f 0)) (hf 0)
  calc
    ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
        A * dyadicHalfWaveKernelL1 C σ j t :=
      fixedTimePhysicalLInfinityEndpoint C σ j t f hf x
    _ ≤ A * (B * Real.sqrt ((2 : Real) ^ j)) :=
      mul_le_mul_of_nonneg_left (hkernel σ j hj t ht) hA
    _ = (B * Real.sqrt ((2 : Real) ^ j)) * A := by ring

/-- The conditional MSS physical `L∞` endpoint resulting from a uniform
level-zero cone-weighted energy bound. -/
theorem mssLInfinityEndpoint_of_uniformConeWeightedEnergy
    (C : lpCutoffs 2) (hcone : HasUniformConeWeightedKernelEnergy C) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : WaveSign) (j : Nat), 1 ≤ j →
      ∀ t : Real, t ∈ Icc (1 : Real) 2 →
        ∀ (f : SchwartzMap (Euclidean 2) Complex) {A : Real},
          (∀ x, ‖f x‖ ≤ A) → ∀ x,
            ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
              (B * Real.sqrt ((2 : Real) ^ j)) * A := by
  rcases waveKernelL1_sharp_of_uniformConeWeightedEnergy C hcone with ⟨B, hB, hkernel⟩
  exact ⟨B, hB, mssLInfinityEndpoint_of_waveKernelL1_sharp C hkernel⟩

/-- The sharp dyadic planar half-wave kernel bound on the MSS unit-time
interval. -/
theorem waveKernelL1_sharp (C : lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : WaveSign) (j : Nat), 1 ≤ j →
      ∀ t : Real, t ∈ Icc (1 : Real) 2 →
        dyadicHalfWaveKernelL1 C σ j t ≤ B * Real.sqrt ((2 : Real) ^ j) :=
  waveKernelL1_sharp_of_uniformConeWeightedEnergy C
    (hasUniformConeWeightedKernelEnergy C)

/-- The fixed-time planar MSS `L∞` endpoint obtained from the sharp kernel
bound. -/
theorem mssLInfinityEndpoint (C : lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : WaveSign) (j : Nat), 1 ≤ j →
      ∀ t : Real, t ∈ Icc (1 : Real) 2 →
        ∀ (f : SchwartzMap (Euclidean 2) Complex) {A : Real},
          (∀ x, ‖f x‖ ≤ A) → ∀ x,
            ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
              (B * Real.sqrt ((2 : Real) ^ j)) * A :=
  mssLInfinityEndpoint_of_uniformConeWeightedEnergy C
    (hasUniformConeWeightedKernelEnergy C)

/-- Fixed-time pointwise endpoint obtained directly from Fourier inversion.
It is an `L∞` estimate in the physical output variable, with the natural
Fourier-`L¹` norm on the Schwartz input. -/
theorem fixedTimeFourierL1Endpoint (C : lpCutoffs 2) (σ : WaveSign)
    (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) :
    ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
      2 * ∫ ξ : Euclidean 2, ‖𝓕 (f : Euclidean 2 → Complex) ξ‖ := by
  have hfourier : Integrable (𝓕 (f : Euclidean 2 → Complex)) := by
    rw [← SchwartzMap.fourier_coe]
    exact (𝓕 f).integrable
  have hmajor : Integrable (fun ξ : Euclidean 2 =>
      2 * ‖𝓕 (f : Euclidean 2 → Complex) ξ‖) :=
    hfourier.norm.const_mul (2 : Real)
  rw [dyadicHalfWave, Real.fourierInv_eq']
  simp only [smul_eq_mul]
  calc
    ‖∫ ξ : Euclidean 2,
        Complex.exp (((2 * Real.pi * inner Real ξ x : Real) : Complex) * Complex.I) *
          (halfWaveMultiplier σ t ξ * dyadicBandpassMultiplier C.cutoff j ξ *
            𝓕 (f : Euclidean 2 → Complex) ξ)‖ ≤
        ∫ ξ : Euclidean 2, 2 * ‖𝓕 (f : Euclidean 2 → Complex) ξ‖ := by
      refine norm_integral_le_of_norm_le
        (f := fun ξ : Euclidean 2 =>
          Complex.exp (((2 * Real.pi * inner Real ξ x : Real) : Complex) * Complex.I) *
            (halfWaveMultiplier σ t ξ * dyadicBandpassMultiplier C.cutoff j ξ *
              𝓕 (f : Euclidean 2 → Complex) ξ))
        (g := fun ξ : Euclidean 2 => 2 * ‖𝓕 (f : Euclidean 2 → Complex) ξ‖)
        hmajor ?_
      filter_upwards with ξ
      rw [norm_mul, norm_mul, norm_mul, Complex.norm_exp_ofReal_mul_I,
        norm_halfWaveMultiplier]
      simpa only [one_mul] using mul_le_mul_of_nonneg_right
        (norm_dyadicBandpassMultiplier_le_two C j ξ)
        (norm_nonneg _)
    _ = 2 * ∫ ξ : Euclidean 2, ‖𝓕 (f : Euclidean 2 → Complex) ξ‖ := by
      rw [integral_const_mul]

/-- Blueprint-facing name for the proved fixed-time pointwise (`L∞` in the
output variable) endpoint. -/
theorem lInfinityEndpoint (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (t : Real) (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
      2 * ∫ ξ : Euclidean 2, ‖𝓕 (f : Euclidean 2 → Complex) ξ‖ :=
  fixedTimeFourierL1Endpoint C σ j t f x

/-- The square of a fixed-time cutoff half-wave is integrable.  This is the
Schwartz regularity input needed to apply product-measure Fubini. -/
theorem integrable_norm_sq_dyadicHalfWave (C : lpCutoffs 2) (σ : WaveSign)
    (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun x : Euclidean 2 => ‖dyadicHalfWave C.cutoff σ j t f x‖ ^ 2) := by
  let h : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex
      (dyadicHalfWaveSchwartzSymbol C σ j t : Euclidean 2 → Complex) (𝓕 f)
  let g : SchwartzMap (Euclidean 2) Complex := 𝓕⁻ h
  have hEq : (fun x : Euclidean 2 => dyadicHalfWave C.cutoff σ j t f x) = g := by
    funext x
    change 𝓕⁻ (fun ξ : Euclidean 2 =>
      halfWaveMultiplier σ t ξ * dyadicBandpassMultiplier C.cutoff j ξ *
        𝓕 (f : Euclidean 2 → Complex) ξ) x =
      (𝓕⁻ h : SchwartzMap (Euclidean 2) Complex) x
    rw [SchwartzMap.fourierInv_coe]
    apply congrArg (fun q : Euclidean 2 → Complex => 𝓕⁻ q x)
    funext ξ
    simp only [h, SchwartzMap.smulLeftCLM_apply
      (dyadicHalfWaveSchwartzSymbol C σ j t).hasTemperateGrowth, smul_eq_mul,
      dyadicHalfWaveSchwartzSymbol_apply, dyadicHalfWaveSymbol,
      SchwartzMap.fourier_coe]
  have hpow : (fun x : Euclidean 2 => ‖dyadicHalfWave C.cutoff σ j t f x‖ ^ 2) =
      fun x => ‖g x‖ ^ 2 := by
    funext x
    rw [congrFun hEq x]
  rw [hpow]
  exact (g.memLp 2 volume).integrable_norm_pow (by norm_num)

/-- The local space--time measure used for the time interval `[1,2]`. -/
def localSmoothingMeasure : Measure (Euclidean 2 × Real) :=
  (volume : Measure (Euclidean 2)).prod (volume.restrict (Icc (1 : Real) 2))

/-- The frequency-localized half-wave considered as a space--time function. -/
def dyadicHalfWaveSpaceTime (χ : SchwartzMap (Euclidean 2) Complex)
    (σ : WaveSign) (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    Euclidean 2 × Real → Complex :=
  fun z => dyadicHalfWave χ σ j z.2 f z.1

/-- A cutoff half-wave is jointly continuous in space and time.  The proof
uses compact frequency support to turn the inverse Fourier integral into a
continuous parametric integral. -/
theorem continuous_dyadicHalfWaveSpaceTime (C : lpCutoffs 2) (σ : WaveSign)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    Continuous (dyadicHalfWaveSpaceTime C.cutoff σ j f) := by
  let K : Set (Euclidean 2) := Metric.closedBall 0 ((2 : Real) ^ (j + 2))
  have hK : IsCompact K := isCompact_closedBall _ _
  have hKmeas : MeasurableSet K := hK.measurableSet
  let G : (Euclidean 2 × Real) → Euclidean 2 → Complex := fun z ξ =>
    (Real.fourierChar (inner Real ξ z.1) : Complex) *
      (halfWaveMultiplier σ z.2 ξ * dyadicBandpassMultiplier C.cutoff j ξ *
        𝓕 (f : Euclidean 2 → Complex) ξ)
  have hGcont : Continuous (Function.uncurry G) := by
    change Continuous (fun q : (Euclidean 2 × Real) × Euclidean 2 =>
      (Real.fourierChar (inner Real q.2 q.1.1) : Complex) *
        (halfWaveMultiplier σ q.1.2 q.2 * dyadicBandpassMultiplier C.cutoff j q.2 *
          𝓕 (f : Euclidean 2 → Complex) q.2))
    have hchar : Continuous (fun q : (Euclidean 2 × Real) × Euclidean 2 =>
        (Real.fourierChar (inner Real q.2 q.1.1) : Complex)) := by
      fun_prop
    have hphaseArg : Continuous (fun q : (Euclidean 2 × Real) × Euclidean 2 =>
        ((σ.toReal * (2 * Real.pi) * q.1.2 * ‖q.2‖ : Real) : Complex) * Complex.I) :=
      ((Complex.continuous_ofReal.comp (by fun_prop)).mul continuous_const)
    have hphase : Continuous (fun q : (Euclidean 2 × Real) × Euclidean 2 =>
        halfWaveMultiplier σ q.1.2 q.2) := by
      change Continuous (fun q : (Euclidean 2 × Real) × Euclidean 2 =>
        Complex.exp (((σ.toReal * (2 * Real.pi) * q.1.2 * ‖q.2‖ : Real) : Complex) *
          Complex.I))
      exact Complex.continuous_exp.comp hphaseArg
    exact hchar.mul ((hphase.mul
      ((dyadicBandpassMultiplier C.cutoff j).continuous.comp continuous_snd)).mul
        ((𝓕 f).continuous.comp continuous_snd))
  have hGsupport (z : Euclidean 2 × Real) : Function.support (G z) ⊆ K := by
    intro ξ hξ
    by_contra hξK
    have hnorm : (2 : Real) ^ (j + 2) ≤ ‖ξ‖ := by
      change ξ ∉ Metric.closedBall 0 ((2 : Real) ^ (j + 2)) at hξK
      rw [Metric.mem_closedBall, dist_zero_right] at hξK
      exact le_of_not_ge hξK
    have hband : dyadicBandpassMultiplier C.cutoff j ξ = 0 :=
      dyadicBandpass_eq_zero_of_le_norm C hnorm
    change G z ξ ≠ 0 at hξ
    exact hξ (by simp [G, hband])
  have hGintegral (z : Euclidean 2 × Real) :
      (∫ ξ : Euclidean 2, G z ξ) = ∫ ξ in K, G z ξ := by
    rw [← MeasureTheory.integral_indicator hKmeas]
    rw [Set.indicator_eq_self.mpr (hGsupport z)]
  have hEq (z : Euclidean 2 × Real) :
      dyadicHalfWaveSpaceTime C.cutoff σ j f z = ∫ ξ in K, G z ξ := by
    rw [show dyadicHalfWaveSpaceTime C.cutoff σ j f z =
        ∫ ξ : Euclidean 2, G z ξ by
      dsimp only [dyadicHalfWaveSpaceTime, dyadicHalfWave, G]
      rw [Real.fourierInv_eq]
      rfl]
    exact hGintegral z
  rw [show dyadicHalfWaveSpaceTime C.cutoff σ j f = fun z => ∫ ξ in K, G z ξ by
    funext z
    exact hEq z]
  exact continuous_parametric_integral_of_continuous (μ := volume) hGcont hK

/-- The joint-continuity result supplies the measurability input for Fubini
and space--time norm arguments. -/
theorem aestronglyMeasurable_dyadicHalfWaveSpaceTime (C : lpCutoffs 2)
    (σ : WaveSign) (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    AEStronglyMeasurable (dyadicHalfWaveSpaceTime C.cutoff σ j f)
      localSmoothingMeasure :=
  (continuous_dyadicHalfWaveSpaceTime C σ j f).aestronglyMeasurable

/-- The local square of a cutoff half-wave is integrable on the unit time
slab.  This is the Fubini regularity part of the local `L²` endpoint. -/
theorem integrable_norm_sq_dyadicHalfWaveSpaceTime (C : lpCutoffs 2)
    (σ : WaveSign) (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun z : Euclidean 2 × Real =>
      ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖ ^ 2) localSmoothingMeasure := by
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  let F : Euclidean 2 × Real → Real := fun z =>
    ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖ ^ 2
  let J : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hFmeas : AEStronglyMeasurable F ((volume : Measure (Euclidean 2)).prod ν) := by
    change AEStronglyMeasurable F localSmoothingMeasure
    convert (aestronglyMeasurable_dyadicHalfWaveSpaceTime C σ j f).norm.pow 2 using 1
    funext z
    simp only [F, Pi.pow_apply]
  have hsliceInt (t : Real) : Integrable (fun x : Euclidean 2 => F (x, t)) := by
    simpa only [F, dyadicHalfWaveSpaceTime] using
      integrable_norm_sq_dyadicHalfWave C σ j t f
  have hsliceBound (t : Real) :
      (∫ x : Euclidean 2, F (x, t)) ≤ 4 * J := by
    simpa only [F, J, dyadicHalfWaveSpaceTime] using
      fixedTimeL2Endpoint C σ j t f
  have houterMeas : AEStronglyMeasurable (fun t : Real =>
      ∫ x : Euclidean 2, F (x, t)) ν := by
    convert hFmeas.prod_swap.integral_prod_right' using 1
    funext t
    apply integral_congr_ae
    filter_upwards with x
    rfl
  have hconst : Integrable (fun _ : Real => 4 * J) ν :=
    integrable_const _
  have houterInt : Integrable (fun t : Real => ∫ x : Euclidean 2, F (x, t)) ν :=
    hconst.mono' houterMeas (by
      filter_upwards with t
      rw [Real.norm_of_nonneg (integral_nonneg fun x => sq_nonneg _)]
      exact hsliceBound t)
  have houterNormInt : Integrable (fun t : Real =>
      ∫ x : Euclidean 2, ‖F (x, t)‖) ν := by
    convert houterInt using 1
    funext t
    apply integral_congr_ae
    filter_upwards with x
    exact Real.norm_of_nonneg (by dsimp only [F]; exact sq_nonneg _)
  have hFint : Integrable F ((volume : Measure (Euclidean 2)).prod ν) :=
    (integrable_prod_iff' hFmeas).mpr
      ⟨Filter.Eventually.of_forall hsliceInt, houterNormInt⟩
  change Integrable F ((volume : Measure (Euclidean 2)).prod ν)
  exact hFint

/-- Fubini upgrades the uniform fixed-time Plancherel estimate to the local
space--time square-integral estimate.  The time interval has length one. -/
theorem integral_norm_sq_dyadicHalfWaveSpaceTime_le_four (C : lpCutoffs 2)
    (σ : WaveSign) (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    (∫ z : Euclidean 2 × Real,
      ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖ ^ 2 ∂localSmoothingMeasure) ≤
      4 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  let F : Euclidean 2 × Real → Real := fun z =>
    ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖ ^ 2
  let J : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hFmeas : AEStronglyMeasurable F ((volume : Measure (Euclidean 2)).prod ν) := by
    change AEStronglyMeasurable F localSmoothingMeasure
    convert (aestronglyMeasurable_dyadicHalfWaveSpaceTime C σ j f).norm.pow 2 using 1
    funext z
    simp only [F, Pi.pow_apply]
  have hsliceInt (t : Real) : Integrable (fun x : Euclidean 2 => F (x, t)) := by
    simpa only [F, dyadicHalfWaveSpaceTime] using
      integrable_norm_sq_dyadicHalfWave C σ j t f
  have hsliceBound (t : Real) :
      (∫ x : Euclidean 2, F (x, t)) ≤ 4 * J := by
    simpa only [F, J, dyadicHalfWaveSpaceTime] using
      fixedTimeL2Endpoint C σ j t f
  have hJnonneg : 0 ≤ J := by
    dsimp only [J]
    exact integral_nonneg fun _ => sq_nonneg _
  have houterMeas : AEStronglyMeasurable (fun t : Real =>
      ∫ x : Euclidean 2, F (x, t)) ν := by
    convert hFmeas.prod_swap.integral_prod_right' using 1
    funext t
    apply integral_congr_ae
    filter_upwards with x
    rfl
  have hconst : Integrable (fun _ : Real => 4 * J) ν :=
    integrable_const _
  have houterInt : Integrable (fun t : Real => ∫ x : Euclidean 2, F (x, t)) ν :=
    hconst.mono' houterMeas (by
      filter_upwards with t
      rw [Real.norm_of_nonneg (integral_nonneg fun x => sq_nonneg _)]
      exact hsliceBound t)
  have houterNormInt : Integrable (fun t : Real =>
      ∫ x : Euclidean 2, ‖F (x, t)‖) ν := by
    convert houterInt using 1
    funext t
    apply integral_congr_ae
    filter_upwards with x
    exact Real.norm_of_nonneg (by dsimp only [F]; exact sq_nonneg _)
  have hFint : Integrable F ((volume : Measure (Euclidean 2)).prod ν) :=
    (integrable_prod_iff' hFmeas).mpr
      ⟨Filter.Eventually.of_forall hsliceInt, houterNormInt⟩
  have hνuniv : ν.real Set.univ = 1 := by
    dsimp only [ν]
    rw [measureReal_restrict_apply_univ, Real.volume_real_Icc_of_le (by norm_num)]
    norm_num
  change (∫ z : Euclidean 2 × Real, F z ∂(volume : Measure (Euclidean 2)).prod ν) ≤
    4 * J
  calc
    (∫ z : Euclidean 2 × Real, F z ∂(volume : Measure (Euclidean 2)).prod ν) =
        ∫ t : Real, ∫ x : Euclidean 2, F (x, t) ∂volume ∂ν :=
      integral_prod_symm F hFint
    _ ≤ ∫ _ : Real, 4 * J ∂ν :=
      integral_mono houterInt hconst hsliceBound
    _ = 4 * J := by
      rw [integral_const, smul_eq_mul, hνuniv, one_mul]

/-- The full space--time `L²` endpoint in the form interpolated in the MSS
argument.  This is a target predicate rather than a claim: the source-checked
fixed-time Plancherel theorem is `l2Endpoint`; passing it through Fubini
requires the remaining joint-measurability layer. -/
def localL2Endpoint (C : lpCutoffs 2) : Prop :=
  ∀ j : Nat, ∀ f : SchwartzMap (Euclidean 2) Complex, ∀ σ : WaveSign,
    eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j f) (ENNReal.ofReal 2)
        localSmoothingMeasure ≤
      ENNReal.ofReal 2 *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal 2) volume

/-- The local space--time `L²` endpoint, obtained from the fixed-time
Plancherel estimate by Fubini over the unit-length time interval. -/
theorem localL2Endpoint_proof (C : lpCutoffs 2) : localL2Endpoint C := by
  intro j f σ
  let u : Euclidean 2 × Real → Complex := dyadicHalfWaveSpaceTime C.cutoff σ j f
  have huMeas : AEStronglyMeasurable u localSmoothingMeasure := by
    simpa only [u] using aestronglyMeasurable_dyadicHalfWaveSpaceTime C σ j f
  have huSqInt : Integrable (fun z : Euclidean 2 × Real => ‖u z‖ ^ 2)
      localSmoothingMeasure := by
    simpa only [u] using integrable_norm_sq_dyadicHalfWaveSpaceTime C σ j f
  have huMem : MemLp u 2 localSmoothingMeasure :=
    (memLp_two_iff_integrable_sq_norm huMeas).mpr huSqInt
  have hfMem : MemLp (f : Euclidean 2 → Complex) 2 volume := f.memLp 2 volume
  let Iu : Real := ∫ z : Euclidean 2 × Real, ‖u z‖ ^ 2 ∂localSmoothingMeasure
  let If : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hsq : Iu ≤ 4 * If := by
    simpa only [Iu, If, u] using
      integral_norm_sq_dyadicHalfWaveSpaceTime_le_four C σ j f
  have hsqrt : Real.sqrt Iu ≤ 2 * Real.sqrt If := by
    calc
      Real.sqrt Iu ≤ Real.sqrt (4 * If) := Real.sqrt_le_sqrt hsq
      _ = 2 * Real.sqrt If := by
        calc
          Real.sqrt (4 * If) = Real.sqrt ((2 : Real) ^ 2) * Real.sqrt If := by
            rw [show (4 : Real) = 2 ^ 2 by norm_num, Real.sqrt_mul
              (by positivity : (0 : Real) ≤ 2 ^ 2)]
          _ = 2 * Real.sqrt If := by
            congr 1
            exact Real.sqrt_sq (by norm_num : (0 : Real) ≤ 2)
  have hroot : Iu ^ (2 : Real)⁻¹ ≤ 2 * If ^ (2 : Real)⁻¹ := by
    rw [show (2 : Real)⁻¹ = 1 / 2 by norm_num, ← Real.sqrt_eq_rpow,
      ← Real.sqrt_eq_rpow]
    exact hsqrt
  have hNormu : eLpNorm u 2 localSmoothingMeasure =
      ENNReal.ofReal (Iu ^ (2 : Real)⁻¹) := by
    rw [huMem.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    norm_num [Iu]
  have hNormf : eLpNorm (f : Euclidean 2 → Complex) 2 volume =
      ENNReal.ofReal (If ^ (2 : Real)⁻¹) := by
    rw [hfMem.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    norm_num [If]
  change eLpNorm u (ENNReal.ofReal 2) localSmoothingMeasure ≤
    ENNReal.ofReal 2 * eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal 2) volume
  norm_num
  rw [hNormu, hNormf]
  calc
    ENNReal.ofReal (Iu ^ (2 : Real)⁻¹) ≤
        ENNReal.ofReal (2 * If ^ (2 : Real)⁻¹) := ENNReal.ofReal_le_ofReal hroot
    _ = ENNReal.ofReal (2 : Real) * ENNReal.ofReal (If ^ (2 : Real)⁻¹) := by
      rw [ENNReal.ofReal_mul (by norm_num)]
    _ ≤ 2 * ENNReal.ofReal (If ^ (2 : Real)⁻¹) := by norm_num

/-- A positive local-smoothing gain for the planar half-wave at exponent `p`.

This is the precise form required by the Bourgain reduction.  It is only a
definition here; proving it is the geometric Mockenhaupt--Seeger--Sogge part
of this development. -/
def HasPositiveLocalSmoothingGain (χ : SchwartzMap (Euclidean 2) Complex)
    (p ρ : Real) : Prop :=
  2 < p ∧ 0 < ρ ∧ ∃ C : Real, 0 < C ∧
    ∀ j : Nat, 1 ≤ j → ∀ f : SchwartzMap (Euclidean 2) Complex,
      ∀ σ : WaveSign,
        eLpNorm (dyadicHalfWaveSpaceTime χ σ j f) (ENNReal.ofReal p)
            localSmoothingMeasure ≤
          ENNReal.ofReal (C * (2 : Real) ^
            ((j : Real) * (1 / 2 - 1 / p - ρ))) *
            eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume

/-- The MSS gain, in its piecewise form on the full real line.  The intended
range is `2 < p < ∞`. -/
def mssGain (p : Real) : Real :=
  if p ≤ 4 then (1 / 2) * (1 / 2 - 1 / p) else 1 / (2 * p)

/-- First branch of the MSS gain. -/
theorem mssGain_of_le_four {p : Real} (hp : p ≤ 4) :
    mssGain p = (1 / 2) * (1 / 2 - 1 / p) := by
  simp [mssGain, hp]

/-- Second branch of the MSS gain. -/
theorem mssGain_of_four_lt {p : Real} (hp : 4 < p) :
    mssGain p = 1 / (2 * p) := by
  simp [mssGain, not_le.mpr hp]

/-- The two formulas defining the MSS gain agree at `p = 4`. -/
theorem mssGain_four : mssGain 4 = 1 / 8 := by
  norm_num [mssGain]

/-- The MSS gain is positive throughout its intended range. -/
theorem mssGain_pos {p : Real} (hp : 2 < p) : 0 < mssGain p := by
  by_cases hfour : p ≤ 4
  · rw [mssGain_of_le_four hfour]
    have hp0 : 0 < p := lt_trans (by norm_num) hp
    have hrecip : 1 / p < 1 / 2 := by
      rw [div_lt_div_iff₀ hp0 (by norm_num : (0 : Real) < 2)]
      simpa using hp
    positivity
  · rw [mssGain, if_neg hfour]
    have hp0 : 0 < p := lt_trans (by norm_num) hp
    positivity

/-- The exact continuous local-smoothing assertion in the introductory MSS
theorem.  It is packaged as a proposition so that the geometric proof and
the later Bourgain reduction have a common, normalization-sensitive target. -/
def localSmoothing (χ : SchwartzMap (Euclidean 2) Complex)
    (p η : Real) : Prop :=
  2 < p ∧ 0 < η ∧ ∃ C : Real, 0 < C ∧
    ∀ j : Nat, 1 ≤ j → ∀ f : SchwartzMap (Euclidean 2) Complex,
      ∀ σ : WaveSign,
        eLpNorm (dyadicHalfWaveSpaceTime χ σ j f) (ENNReal.ofReal p)
            localSmoothingMeasure ≤
          ENNReal.ofReal (C * (2 : Real) ^
            ((j : Real) * (1 / 2 - 1 / p - mssGain p + η))) *
            eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume

/-- The `p = 4` endpoint form of the MSS local-smoothing theorem.  At this
exponent `mssGain_four` turns the power in `localSmoothing` into
`1 / 8 + η`, exactly as in the blueprint. -/
def p4LocalSmoothing (χ : SchwartzMap (Euclidean 2) Complex) : Prop :=
  ∀ η : Real, 0 < η → localSmoothing χ 4 η

/-- The positive-gain form required by the circular-maximal reduction is an
immediate algebraic consequence of the exact local-smoothing statement once
the permitted loss is smaller than the MSS gain. -/
theorem localSmoothing_to_hasPositiveLocalSmoothingGain
    {χ : SchwartzMap (Euclidean 2) Complex} {p η : Real}
    (hlocal : localSmoothing χ p η) (hη : η < mssGain p) :
    HasPositiveLocalSmoothingGain χ p (mssGain p - η) := by
  rcases hlocal with ⟨hp, hηpos, C, hC, hbound⟩
  refine ⟨hp, sub_pos.mpr hη, C, hC, ?_⟩
  intro j hj f σ
  have hexponent :
      (j : Real) * (1 / 2 - 1 / p - (mssGain p - η)) =
        (j : Real) * (1 / 2 - 1 / p - mssGain p + η) := by
    ring
  rw [hexponent]
  exact hbound j hj f σ

/-- The conditional `p = 4` MSS endpoint supplies every smaller positive
gain needed by the Bourgain reduction. -/
theorem p4LocalSmoothing_to_hasPositiveLocalSmoothingGain
    {χ : SchwartzMap (Euclidean 2) Complex} (hlocal : p4LocalSmoothing χ)
    {ρ : Real} (hρ : 0 < ρ) (hρlt : ρ < (1 / 8 : Real)) :
    HasPositiveLocalSmoothingGain χ 4 ρ := by
  let η : Real := (1 / 8 : Real) - ρ
  have hη : 0 < η := by
    dsimp only [η]
    linarith
  have hηlt : η < mssGain 4 := by
    rw [mssGain_four]
    dsimp only [η]
    linarith
  have hgain := localSmoothing_to_hasPositiveLocalSmoothingGain
    (hlocal η hη) hηlt
  have heq : mssGain 4 - η = ρ := by
    rw [mssGain_four]
    dsimp only [η]
    ring
  rw [heq] at hgain
  exact hgain

/-- The time mesh used in the discretized MSS statement. -/
def dyadicTimeScale (j : Nat) : Real := (2 : Real) ^ (-(j : Int))

/-- A finite maximal `2^{-j}`-separated subset of the time interval `[1,2]`.
The covering clause is the finite-set form of maximality: every point in the
interval lies strictly within one mesh width of a selected time. -/
def MaximalSeparated (j : Nat) (T : Finset Real) : Prop :=
  (∀ t ∈ T, t ∈ Icc (1 : Real) 2) ∧
  (∀ ⦃s⦄, s ∈ T → ∀ ⦃t⦄, t ∈ T → s ≠ t →
    dyadicTimeScale j ≤ |s - t|) ∧
  ∀ t ∈ Icc (1 : Real) 2, ∃ s ∈ T, |t - s| < dyadicTimeScale j

/-- The exact discretized full-time local-smoothing assertion from the
introductory blueprint.  `ENNReal` powers encode the outer `ℓ^p` norm without
introducing an artificial finiteness hypothesis on individual norms. -/
def discreteLocalSmoothing (χ : SchwartzMap (Euclidean 2) Complex)
    (p η : Real) : Prop :=
  2 < p ∧ 0 < η ∧ ∃ C : Real, 0 < C ∧
    ∀ j : Nat, 1 ≤ j → ∀ T : Finset Real, MaximalSeparated j T →
      ∀ f : SchwartzMap (Euclidean 2) Complex, ∀ σ : WaveSign,
        (∑ t ∈ T,
          (eLpNorm (dyadicHalfWave χ σ j t f) (ENNReal.ofReal p) volume) ^ p) ^
            (p⁻¹) ≤
          ENNReal.ofReal (C * (2 : Real) ^
            ((j : Real) * (1 / 2 - mssGain p + η))) *
            eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume

/-- The physical space--time used for the constant-coefficient wave equation. -/
abbrev WaveSpaceTime := Euclidean 2 × Real

/-- Space--time Fourier transform in Mathlib's unitary `2π` convention.
It is written as the iterated spatial and temporal transforms, so it uses
the existing Fourier APIs directly on `Euclidean 2` and `Real`. -/
noncomputable def spaceTimeFourier (G : WaveSpaceTime → Complex) :
    WaveSpaceTime → Complex :=
  fun ζ => 𝓕 (fun t : Real => 𝓕 (fun x : Euclidean 2 => G (x, t)) ζ.1) ζ.2

/-- Inverse space--time Fourier transform in the same convention, again
written as an iterated transform. -/
noncomputable def spaceTimeFourierInv (G : WaveSpaceTime → Complex) :
    WaveSpaceTime → Complex :=
  fun z => 𝓕⁻ (fun τ : Real => 𝓕⁻ (fun η : Euclidean 2 => G (η, τ)) z.1) z.2

/-- The vertical Fourier multiplier used in the MSS radial decomposition.
The frequency scale is `sqrt scale`, matching the radial width
`scale^(1/2)`. -/
def verticalMultiplier (β : Real → Complex) (scale : Real) (n : Int) :
    WaveSpaceTime → Complex :=
  fun ζ => β ((Real.sqrt scale)⁻¹ * ζ.2 - n)

/-- The literal space--time Fourier multiplier `V_n^scale`.  No boundedness is
claimed here: quantitative estimates require the smooth cutoff hypotheses
and Fourier multiplier analysis later in the MSS proof. -/
noncomputable def verticalProjection (β : Real → Complex) (scale : Real) (n : Int)
    (G : WaveSpaceTime → Complex) : WaveSpaceTime → Complex :=
  spaceTimeFourierInv (fun ζ => verticalMultiplier β scale n ζ * spaceTimeFourier G ζ)

/-- The one-dimensional temporal multiplier which is the exact action of a
vertical projection on a separable space--time packet.  Keeping this literal
inverse Fourier formula exposes the physical time analysis needed for the
eventual vector-valued endpoint, without asserting that endpoint here. -/
noncomputable def verticalTemporalProjection (β : Real → Complex) (scale : Real) (n : Int)
    (g : Real → Complex) : Real → Complex :=
  fun t => 𝓕⁻ (fun τ : Real => β ((Real.sqrt scale)⁻¹ * τ - n) * 𝓕 g τ) t

/-- A spatial Schwartz profile times an arbitrary temporal profile.  These
are the literal finite packets on which the iterated space--time Fourier
definition of `verticalProjection` separates exactly. -/
noncomputable def verticalSeparablePacket (F : SchwartzMap (Euclidean 2) Complex)
    (g : Real → Complex) : WaveSpaceTime → Complex :=
  fun z => g z.2 * F z.1

private theorem aux_fourier_const_mul_apply {E : Type*}
    [NormedAddCommGroup E] [InnerProductSpace Real E]
    [MeasurableSpace E] [BorelSpace E] [FiniteDimensional Real E]
    (c : Complex) (f : E → Complex) (ξ : E) :
    𝓕 (fun x => c * f x) ξ = c * 𝓕 f ξ := by
  rw [Real.fourier_eq, Real.fourier_eq]
  change (∫ x : E,
    (Real.fourierChar (-inner Real x ξ) : Complex) * (c * f x)) =
      c * ∫ x : E, (Real.fourierChar (-inner Real x ξ) : Complex) * f x
  rw [show (fun x : E =>
      (Real.fourierChar (-inner Real x ξ) : Complex) * (c * f x)) =
      fun x : E => c * ((Real.fourierChar (-inner Real x ξ) : Complex) * f x) by
        funext x
        ring]
  rw [integral_const_mul]

private theorem aux_fourierInv_const_mul_apply {E : Type*}
    [NormedAddCommGroup E] [InnerProductSpace Real E]
    [MeasurableSpace E] [BorelSpace E] [FiniteDimensional Real E]
    (c : Complex) (f : E → Complex) (x : E) :
    𝓕⁻ (fun ξ => c * f ξ) x = c * 𝓕⁻ f x := by
  rw [Real.fourierInv_eq, Real.fourierInv_eq]
  change (∫ ξ : E,
    (Real.fourierChar (inner Real ξ x) : Complex) * (c * f ξ)) =
      c * ∫ ξ : E, (Real.fourierChar (inner Real ξ x) : Complex) * f ξ
  rw [show (fun ξ : E =>
      (Real.fourierChar (inner Real ξ x) : Complex) * (c * f ξ)) =
      fun ξ : E => c * ((Real.fourierChar (inner Real ξ x) : Complex) * f ξ) by
        funext ξ
        ring]
  rw [integral_const_mul]

private theorem aux_fourierInv_fourier_schwartz_apply
    (F : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    𝓕⁻ (𝓕 (F : Euclidean 2 → Complex)) x = F x := by
  have hfourier : (𝓕⁻ (𝓕 F) : SchwartzMap (Euclidean 2) Complex) = F :=
    FourierTransform.fourierInv_fourier_eq F
  have h := congrArg (fun q : SchwartzMap (Euclidean 2) Complex => q x) hfourier
  simpa only [SchwartzMap.fourierInv_coe, SchwartzMap.fourier_coe] using h

/-- The iterated space--time Fourier transform of a literal separable packet
is exactly the product of its spatial and temporal Fourier factors. -/
theorem spaceTimeFourier_verticalSeparablePacket
    (F : SchwartzMap (Euclidean 2) Complex) (g : Real → Complex)
    (ξ : Euclidean 2) (τ : Real) :
    spaceTimeFourier (verticalSeparablePacket F g) (ξ, τ) =
      𝓕 (F : Euclidean 2 → Complex) ξ * 𝓕 g τ := by
  unfold spaceTimeFourier verticalSeparablePacket
  have hspace (t : Real) :
      𝓕 (fun x : Euclidean 2 => g t * F x) ξ =
        g t * 𝓕 (F : Euclidean 2 → Complex) ξ := by
    exact aux_fourier_const_mul_apply (g t) (F : Euclidean 2 → Complex) ξ
  rw [show (fun t : Real => 𝓕 (fun x : Euclidean 2 => g t * F x) ξ) =
      fun t : Real => g t * 𝓕 (F : Euclidean 2 → Complex) ξ by
        funext t
        exact hspace t]
  rw [show (fun t : Real => g t * 𝓕 (F : Euclidean 2 → Complex) ξ) =
      fun t : Real => 𝓕 (F : Euclidean 2 → Complex) ξ * g t by
        funext t
        ring]
  exact aux_fourier_const_mul_apply
    (𝓕 (F : Euclidean 2 → Complex) ξ) g τ

/-- The space--time Fourier support of a literal separable packet is contained
in the Cartesian product of the supports of its actual spatial and temporal
Fourier factors.  This is only a separable-packet fact: it makes no
space--time support assertion for the time-dependent half-wave packets used
elsewhere in the MSS construction. -/
theorem support_spaceTimeFourier_verticalSeparablePacket_subset_prod
    (F : SchwartzMap (Euclidean 2) Complex) (g : Real → Complex) :
    Function.support (spaceTimeFourier (verticalSeparablePacket F g)) ⊆
      Function.support (𝓕 (F : Euclidean 2 → Complex)) ×ˢ Function.support (𝓕 g) := by
  intro z hz
  change spaceTimeFourier (verticalSeparablePacket F g) z ≠ 0 at hz
  rw [spaceTimeFourier_verticalSeparablePacket] at hz
  constructor
  · change 𝓕 (F : Euclidean 2 → Complex) z.1 ≠ 0
    exact (mul_ne_zero_iff.mp hz).1
  · change 𝓕 g z.2 ≠ 0
    exact (mul_ne_zero_iff.mp hz).2

/-- Any concrete set containing the Fourier-factor support product contains
the space--time Fourier support of the corresponding literal separable
packet.  The conic-plate specialization is obtained by supplying that
product containment; this does not turn a half-wave packet into a separable
one. -/
theorem support_spaceTimeFourier_verticalSeparablePacket_subset
    (F : SchwartzMap (Euclidean 2) Complex) (g : Real → Complex)
    (S : Set WaveSpaceTime)
    (hS : Function.support (𝓕 (F : Euclidean 2 → Complex)) ×ˢ Function.support (𝓕 g) ⊆ S) :
    Function.support (spaceTimeFourier (verticalSeparablePacket F g)) ⊆ S :=
  (support_spaceTimeFourier_verticalSeparablePacket_subset_prod F g).trans hS

/-- A literal vertical projection of a separable packet is precisely its
one-dimensional temporal projection times its unchanged spatial profile. -/
theorem verticalProjection_verticalSeparablePacket
    (β : Real → Complex) (scale : Real) (n : Int)
    (F : SchwartzMap (Euclidean 2) Complex) (g : Real → Complex)
    (z : WaveSpaceTime) :
    verticalProjection β scale n (verticalSeparablePacket F g) z =
      verticalTemporalProjection β scale n g z.2 * F z.1 := by
  unfold verticalProjection spaceTimeFourierInv verticalTemporalProjection
  have hfourier (η : Euclidean 2) (τ : Real) :
      spaceTimeFourier (verticalSeparablePacket F g) (η, τ) =
        𝓕 (F : Euclidean 2 → Complex) η * 𝓕 g τ :=
    spaceTimeFourier_verticalSeparablePacket F g η τ
  have hspace (τ : Real) :
      𝓕⁻ (fun η : Euclidean 2 =>
        verticalMultiplier β scale n (η, τ) *
          spaceTimeFourier (verticalSeparablePacket F g) (η, τ)) z.1 =
        (β ((Real.sqrt scale)⁻¹ * τ - n) * 𝓕 g τ) * F z.1 := by
    rw [show (fun η : Euclidean 2 =>
        verticalMultiplier β scale n (η, τ) *
          spaceTimeFourier (verticalSeparablePacket F g) (η, τ)) =
        fun η : Euclidean 2 =>
          (β ((Real.sqrt scale)⁻¹ * τ - n) * 𝓕 g τ) *
            𝓕 (F : Euclidean 2 → Complex) η by
      funext η
      rw [verticalMultiplier, hfourier]
      ring]
    rw [aux_fourierInv_const_mul_apply]
    rw [aux_fourierInv_fourier_schwartz_apply]
  rw [show (fun τ : Real =>
      𝓕⁻ (fun η : Euclidean 2 =>
        verticalMultiplier β scale n (η, τ) *
          spaceTimeFourier (verticalSeparablePacket F g) (η, τ)) z.1) =
      fun τ : Real => (β ((Real.sqrt scale)⁻¹ * τ - n) * 𝓕 g τ) * F z.1 by
        funext τ
        exact hspace τ]
  rw [show (fun τ : Real => (β ((Real.sqrt scale)⁻¹ * τ - n) * 𝓕 g τ) * F z.1) =
      fun τ : Real => F z.1 * (β ((Real.sqrt scale)⁻¹ * τ - n) * 𝓕 g τ) by
        funext τ
        ring]
  rw [aux_fourierInv_const_mul_apply]
  ring

private noncomputable def aux_verticalTemporalMultiplierProfile
    (m g : SchwartzMap Real Complex) : SchwartzMap Real Complex :=
  SchwartzMap.smulLeftCLM Complex (m : Real → Complex) (𝓕 g)

private theorem aux_verticalTemporalMultiplierProfile_apply
    (m g : SchwartzMap Real Complex) (τ : Real) :
    aux_verticalTemporalMultiplierProfile m g τ =
      m τ * 𝓕 (g : Real → Complex) τ := by
  simp only [aux_verticalTemporalMultiplierProfile,
    SchwartzMap.smulLeftCLM_apply_apply m.hasTemperateGrowth,
    smul_eq_mul, SchwartzMap.fourier_coe]

private theorem aux_fourier_fourierInv_schwartzReal_apply
    (h : SchwartzMap Real Complex) (τ : Real) :
    𝓕 ((𝓕⁻ h : SchwartzMap Real Complex) : Real → Complex) τ = h τ := by
  have hfourier : (𝓕 (𝓕⁻ h) : SchwartzMap Real Complex) = h :=
    FourierTransform.fourier_fourierInv_eq h
  have hpoint := congrArg (fun q : SchwartzMap Real Complex => q τ) hfourier
  simpa only [SchwartzMap.fourier_coe, SchwartzMap.fourierInv_coe] using hpoint

private theorem aux_verticalTemporalProjection_eq_fourierInv_profile
    (β : Real → Complex) (scale : Real) (n : Int)
    (m g : SchwartzMap Real Complex)
    (hprofile : ∀ τ : Real, m τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (t : Real) :
    verticalTemporalProjection β scale n (g : Real → Complex) t =
      ((𝓕⁻ (aux_verticalTemporalMultiplierProfile m g) : SchwartzMap Real Complex) :
        Real → Complex) t := by
  unfold verticalTemporalProjection
  rw [SchwartzMap.fourierInv_coe]
  apply congrArg (fun q : Real → Complex => 𝓕⁻ q t)
  funext τ
  calc
    β ((Real.sqrt scale)⁻¹ * τ - n) * 𝓕 (g : Real → Complex) τ =
        m τ * 𝓕 (g : Real → Complex) τ := by rw [hprofile τ]
    _ = aux_verticalTemporalMultiplierProfile m g τ :=
      (aux_verticalTemporalMultiplierProfile_apply m g τ).symm

/-- If the already shifted/scaled temporal multiplier has a supplied
Schwartz representative, a literal vertical projection has its expected
space--time Fourier multiplier identity on a separable packet with Schwartz
temporal factor.  This is termwise only: it makes no assertion for arbitrary
space--time functions or for a physical-time-cutoff half-wave. -/
theorem spaceTimeFourier_verticalProjection_verticalSeparablePacket_of_schwartzProfile
    (β : Real → Complex) (scale : Real) (n : Int)
    (m g : SchwartzMap Real Complex)
    (hprofile : ∀ τ : Real, m τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : SchwartzMap (Euclidean 2) Complex) (ξ : Euclidean 2) (τ : Real) :
    spaceTimeFourier
        (verticalProjection β scale n
          (verticalSeparablePacket F (g : Real → Complex))) (ξ, τ) =
      verticalMultiplier β scale n (ξ, τ) *
        spaceTimeFourier (verticalSeparablePacket F (g : Real → Complex)) (ξ, τ) := by
  have hphysical : verticalProjection β scale n
      (verticalSeparablePacket F (g : Real → Complex)) =
      verticalSeparablePacket F
        ((𝓕⁻ (aux_verticalTemporalMultiplierProfile m g) : SchwartzMap Real Complex) :
          Real → Complex) := by
    funext z
    rw [verticalProjection_verticalSeparablePacket]
    rw [aux_verticalTemporalProjection_eq_fourierInv_profile β scale n m g hprofile]
    rfl
  rw [hphysical, spaceTimeFourier_verticalSeparablePacket,
    aux_fourier_fourierInv_schwartzReal_apply,
    spaceTimeFourier_verticalSeparablePacket, verticalMultiplier]
  rw [aux_verticalTemporalMultiplierProfile_apply, hprofile τ]
  ring

/-- The matched radial piece from the MSS decomposition, as its literal
spatial Fourier multiplier. -/
noncomputable def radialPiece (β : Real → Complex) (scale : Real) (n : Int)
    (f : Euclidean 2 → Complex) : Euclidean 2 → Complex :=
  𝓕⁻ (fun ξ => β ((Real.sqrt scale)⁻¹ * ‖ξ‖ - n) * 𝓕 f ξ)

/-- The conically localized constant-coefficient half-wave operator.  The
amplitude and time cutoff are parameters; their smooth support hypotheses
are kept separate from this exact Fourier formula. -/
noncomputable def conicOperator (scale : Real) (a : Euclidean 2 → Complex)
    (ϑ : Real → Complex) (f : Euclidean 2 → Complex) :
    WaveSpaceTime → Complex :=
  fun z => ϑ z.2 * 𝓕⁻ (fun ξ =>
    a (scale⁻¹ • ξ) * halfWaveMultiplier WaveSign.plus z.2 ξ * 𝓕 f ξ) z.1

/-- At dyadic scale `2^j`, the level-zero annular amplitude in the conic
normal form is exactly the level-`j` Littlewood--Paley multiplier.  On the
unit time slab, where `ϑ = 1`, the conic operator is therefore the positive
dyadic half-wave. -/
theorem conicOperator_eq_dyadicHalfWaveSpaceTime_plus
    (C : lpCutoffs 2) (ϑ : Real → Complex) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) (z : WaveSpaceTime)
    (hϑ : ϑ z.2 = 1) :
    conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) ϑ
        (f : Euclidean 2 → Complex) z =
      dyadicHalfWaveSpaceTime C.cutoff WaveSign.plus j f z := by
  rw [conicOperator, dyadicHalfWaveSpaceTime, dyadicHalfWave, hϑ, one_mul]
  apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g z.1)
  funext ξ
  change dyadicBandpassMultiplier C.cutoff 0 (((2 : Real) ^ j)⁻¹ • ξ) *
      halfWaveMultiplier WaveSign.plus z.2 ξ * 𝓕 (f : Euclidean 2 → Complex) ξ =
    halfWaveMultiplier WaveSign.plus z.2 ξ * dyadicBandpassMultiplier C.cutoff j ξ *
      𝓕 (f : Euclidean 2 → Complex) ξ
  rw [← dyadicBandpassMultiplier_eq_levelZero_scaled C j ξ]
  ring

/-- The local `[1,2]` space--time measure is dominated by full Lebesgue
measure, allowing a global conic estimate to control its local restriction. -/
theorem localSmoothingMeasure_le_volume :
    localSmoothingMeasure ≤ (volume : Measure WaveSpaceTime) := by
  rw [localSmoothingMeasure, Measure.volume_eq_prod]
  exact Measure.prod_mono le_rfl Measure.restrict_le_self

/-- The positive dyadic half-wave and the matched conic normal form agree
almost everywhere on the local time slab. -/
theorem ae_eq_conicOperator_dyadicHalfWaveSpaceTime_plus
    (C : lpCutoffs 2) (ϑ : Real → Complex) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex)
    (hϑ : ∀ t ∈ Icc (1 : Real) 2, ϑ t = 1) :
    conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) ϑ
        (f : Euclidean 2 → Complex) =ᵐ[localSmoothingMeasure]
      dyadicHalfWaveSpaceTime C.cutoff WaveSign.plus j f := by
  have htime : ∀ᵐ t : Real ∂(volume.restrict (Icc (1 : Real) 2)),
      t ∈ Icc (1 : Real) 2 := ae_restrict_mem measurableSet_Icc
  have hslab : ∀ᵐ z : WaveSpaceTime ∂localSmoothingMeasure,
      z.2 ∈ Icc (1 : Real) 2 := by
    rw [localSmoothingMeasure]
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards with x
      exact htime
    · exact measurableSet_Icc.preimage measurable_snd
  filter_upwards [hslab] with z hz
  exact conicOperator_eq_dyadicHalfWaveSpaceTime_plus C ϑ j f z (hϑ z.2 hz)

/-- A global conic `L⁴` estimate transfers to the local positive dyadic
half-wave at the matching scale.  The negative orientation is intentionally
not folded into this lemma: it requires its own reflected conic input. -/
theorem eLpNorm_dyadicHalfWaveSpaceTime_plus_le_conicOperator
    (C : lpCutoffs 2) (ϑ : Real → Complex) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex)
    (hϑ : ∀ t ∈ Icc (1 : Real) 2, ϑ t = 1) :
    eLpNorm (dyadicHalfWaveSpaceTime C.cutoff WaveSign.plus j f) (4 : ENNReal)
        localSmoothingMeasure ≤
      eLpNorm (conicOperator ((2 : Real) ^ j)
        (dyadicBandpassMultiplier C.cutoff 0) ϑ (f : Euclidean 2 → Complex))
        (4 : ENNReal) volume := by
  rw [← eLpNorm_congr_ae
    (ae_eq_conicOperator_dyadicHalfWaveSpaceTime_plus C ϑ j f hϑ)]
  exact eLpNorm_mono_measure _ localSmoothingMeasure_le_volume

/-- Time reflection in the space--time ambient space.  This is kept private:
its only use here is transporting the positive conic normal form to the
negative half-wave orientation. -/
private def timeReflectWaveSpaceTime (z : WaveSpaceTime) : WaveSpaceTime :=
  (z.1, -z.2)

private theorem timeReflectWaveSpaceTime_measurePreserving :
    MeasurePreserving timeReflectWaveSpaceTime (volume : Measure WaveSpaceTime) volume := by
  rw [Measure.volume_eq_prod]
  change MeasurePreserving (Prod.map id Neg.neg)
    ((volume : Measure (Euclidean 2)).prod (volume : Measure Real))
    ((volume : Measure (Euclidean 2)).prod (volume : Measure Real))
  exact MeasurePreserving.prod (MeasurePreserving.id _) (Measure.measurePreserving_neg _)

private theorem halfWaveMultiplier_plus_neg_eq_minus
    (t : Real) (ξ : Euclidean 2) :
    halfWaveMultiplier WaveSign.plus (-t) ξ =
      halfWaveMultiplier WaveSign.minus t ξ := by
  simp only [halfWaveMultiplier, WaveSign.toReal]
  congr 2
  ring_nf

/-- Evaluating the positive conic normal form at reflected time gives the
negative dyadic half-wave at the matched dyadic scale. -/
theorem conicOperator_timeReflect_eq_dyadicHalfWaveSpaceTime_minus
    (C : lpCutoffs 2) (ϑ : Real → Complex) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) (z : WaveSpaceTime)
    (hϑ : ϑ (-z.2) = 1) :
    conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) ϑ
        (f : Euclidean 2 → Complex) (timeReflectWaveSpaceTime z) =
      dyadicHalfWaveSpaceTime C.cutoff WaveSign.minus j f z := by
  rw [conicOperator, timeReflectWaveSpaceTime, dyadicHalfWaveSpaceTime, dyadicHalfWave,
    hϑ, one_mul]
  apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g z.1)
  funext ξ
  change dyadicBandpassMultiplier C.cutoff 0 (((2 : Real) ^ j)⁻¹ • ξ) *
      halfWaveMultiplier WaveSign.plus (-z.2) ξ * 𝓕 (f : Euclidean 2 → Complex) ξ =
    halfWaveMultiplier WaveSign.minus z.2 ξ * dyadicBandpassMultiplier C.cutoff j ξ *
      𝓕 (f : Euclidean 2 → Complex) ξ
  rw [← dyadicBandpassMultiplier_eq_levelZero_scaled C j ξ,
    halfWaveMultiplier_plus_neg_eq_minus]
  ring

/-- The reflected-time conic normal form and negative dyadic half-wave agree
almost everywhere on the local time slab when the conic time cutoff is one on
the reflected slab. -/
theorem ae_eq_conicOperator_timeReflect_dyadicHalfWaveSpaceTime_minus
    (C : lpCutoffs 2) (ϑ : Real → Complex) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex)
    (hϑ : ∀ t ∈ Icc (1 : Real) 2, ϑ (-t) = 1) :
    (fun z => conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) ϑ
        (f : Euclidean 2 → Complex) (timeReflectWaveSpaceTime z)) =ᵐ[localSmoothingMeasure]
      dyadicHalfWaveSpaceTime C.cutoff WaveSign.minus j f := by
  have htime : ∀ᵐ t : Real ∂(volume.restrict (Icc (1 : Real) 2)),
      t ∈ Icc (1 : Real) 2 := ae_restrict_mem measurableSet_Icc
  have hslab : ∀ᵐ z : WaveSpaceTime ∂localSmoothingMeasure,
      z.2 ∈ Icc (1 : Real) 2 := by
    rw [localSmoothingMeasure]
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards with x
      exact htime
    · exact measurableSet_Icc.preimage measurable_snd
  filter_upwards [hslab] with z hz
  exact conicOperator_timeReflect_eq_dyadicHalfWaveSpaceTime_minus C ϑ j f z
    (hϑ z.2 hz)

/-- A global positive-conic `L⁴` norm controls the local negative half-wave
at the matching scale, after time reflection.  The explicit measurability
hypothesis is needed for the measure-preserving change of variables. -/
theorem eLpNorm_dyadicHalfWaveSpaceTime_minus_le_conicOperator
    (C : lpCutoffs 2) (ϑ : Real → Complex) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex)
    (hϑ : ∀ t ∈ Icc (1 : Real) 2, ϑ (-t) = 1)
    (hmeas : AEStronglyMeasurable
      (conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) ϑ
        (f : Euclidean 2 → Complex)) volume) :
    eLpNorm (dyadicHalfWaveSpaceTime C.cutoff WaveSign.minus j f) (4 : ENNReal)
        localSmoothingMeasure ≤
      eLpNorm (conicOperator ((2 : Real) ^ j)
        (dyadicBandpassMultiplier C.cutoff 0) ϑ (f : Euclidean 2 → Complex))
        (4 : ENNReal) volume := by
  let g : WaveSpaceTime → Complex := conicOperator ((2 : Real) ^ j)
    (dyadicBandpassMultiplier C.cutoff 0) ϑ (f : Euclidean 2 → Complex)
  have hg : AEStronglyMeasurable g volume := hmeas
  have hae : (g ∘ timeReflectWaveSpaceTime) =ᵐ[localSmoothingMeasure]
      dyadicHalfWaveSpaceTime C.cutoff WaveSign.minus j f := by
    change (fun z => g (timeReflectWaveSpaceTime z)) =ᵐ[localSmoothingMeasure]
      dyadicHalfWaveSpaceTime C.cutoff WaveSign.minus j f
    exact ae_eq_conicOperator_timeReflect_dyadicHalfWaveSpaceTime_minus C ϑ j f hϑ
  have hglobal : eLpNorm (g ∘ timeReflectWaveSpaceTime) (4 : ENNReal) volume =
      eLpNorm g (4 : ENNReal) volume :=
    eLpNorm_comp_measurePreserving hg timeReflectWaveSpaceTime_measurePreserving
  change eLpNorm (dyadicHalfWaveSpaceTime C.cutoff WaveSign.minus j f) (4 : ENNReal)
      localSmoothingMeasure ≤ eLpNorm g (4 : ENNReal) volume
  rw [← eLpNorm_congr_ae hae]
  calc
    eLpNorm (g ∘ timeReflectWaveSpaceTime) (4 : ENNReal) localSmoothingMeasure ≤
      eLpNorm (g ∘ timeReflectWaveSpaceTime) (4 : ENNReal) volume :=
      eLpNorm_mono_measure _ localSmoothingMeasure_le_volume
    _ = eLpNorm g (4 : ENNReal) volume := hglobal

/-- The set of radial indices relevant to a frequency annulus at scale
`scale`.  This is the direct formal spelling of the distance-to-interval
condition in the MSS decomposition. -/
def relevantRadialIndices (scale : Real) : Set Int :=
  {n | ∃ s ∈ Icc (Real.sqrt scale / 2) (2 * Real.sqrt scale),
    |(n : Real) - s| < 3}

/-- Membership in the set of relevant radial indices is precisely the
witnessed distance-to-interval condition. -/
theorem mem_relevantRadialIndices_iff (scale : Real) (n : Int) :
    n ∈ relevantRadialIndices scale ↔
      ∃ s ∈ Icc (Real.sqrt scale / 2) (2 * Real.sqrt scale), |(n : Real) - s| < 3 :=
  Iff.rfl

/-- The support calculation behind the relevant-index lemma: a frequency in
the annulus, whose normalized radius is within three of an integer label,
has that label in the finite radial family. -/
theorem mem_relevantRadialIndices_of_mem_annulus_of_abs_sub_lt
    {scale : Real} (hscale : 0 < scale) {ξ : Euclidean 2} {n : Int}
    (hξ : ‖ξ‖ ∈ Icc (scale / 2) (2 * scale))
    (hn : |(n : Real) - (Real.sqrt scale)⁻¹ * ‖ξ‖| < 3) :
    n ∈ relevantRadialIndices scale := by
  have hsqrt : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
  have hleft : Real.sqrt scale / 2 ≤ (Real.sqrt scale)⁻¹ * ‖ξ‖ := by
    rw [show (Real.sqrt scale)⁻¹ * ‖ξ‖ = ‖ξ‖ / Real.sqrt scale by
      rw [div_eq_mul_inv, mul_comm]]
    apply (le_div_iff₀ hsqrt).2
    calc
      Real.sqrt scale / 2 * Real.sqrt scale = (Real.sqrt scale) ^ 2 / 2 := by
        ring
      _ = scale / 2 := by rw [Real.sq_sqrt hscale.le]
      _ ≤ ‖ξ‖ := hξ.1
  have hright : (Real.sqrt scale)⁻¹ * ‖ξ‖ ≤ 2 * Real.sqrt scale := by
    rw [show (Real.sqrt scale)⁻¹ * ‖ξ‖ = ‖ξ‖ / Real.sqrt scale by
      rw [div_eq_mul_inv, mul_comm]]
    apply (div_le_iff₀ hsqrt).2
    calc
      ‖ξ‖ ≤ 2 * scale := hξ.2
      _ = 2 * Real.sqrt scale * Real.sqrt scale := by
        nlinarith [Real.sq_sqrt hscale.le]
  exact ⟨(Real.sqrt scale)⁻¹ * ‖ξ‖, ⟨hleft, hright⟩, hn⟩

/-- A finite enumeration of the relevant radial indices at every scale.  Its
existence and cardinality estimate are part of the radial localization work;
this predicate records the exact interface needed by the reconstruction. -/
def HasRelevantRadialEnumeration (indices : Real → Finset Int) : Prop :=
  ∀ scale : Real, ∀ n : Int,
    n ∈ indices scale ↔ n ∈ relevantRadialIndices scale

/-- A concrete finite interval containing every radial index which can meet
the annulus at a given scale. -/
noncomputable def relevantRadialIndexBounds (scale : Real) : Finset Int :=
  Finset.Icc ⌊Real.sqrt scale / 2 - 3⌋ ⌈2 * Real.sqrt scale + 3⌉

/-- The exact finite enumeration of radial indices relevant to the annulus.
It is obtained by filtering the explicit integer interval of possible labels. -/
noncomputable def relevantRadialIndexEnumeration (scale : Real) : Finset Int := by
  classical
  exact (relevantRadialIndexBounds scale).filter
    (fun n => n ∈ relevantRadialIndices scale)

/-- Every relevant radial index lies in the explicit finite interval used for
the enumeration. -/
theorem mem_relevantRadialIndexBounds_of_mem_relevantRadialIndices
    (scale : Real) (n : Int) (hn : n ∈ relevantRadialIndices scale) :
    n ∈ relevantRadialIndexBounds scale := by
  rcases hn with ⟨s, hs, hdist⟩
  rw [relevantRadialIndexBounds, Finset.mem_Icc]
  have hdist' : -3 < (n : Real) - s ∧ (n : Real) - s < 3 := abs_lt.mp hdist
  constructor
  · have hlower : Real.sqrt scale / 2 - 3 ≤ (n : Real) := by
      linarith [hs.1, hdist'.1]
    have hfloor := Int.floor_le_floor hlower
    simpa using hfloor
  · have hupper : (n : Real) ≤ 2 * Real.sqrt scale + 3 := by
      linarith [hs.2, hdist'.2]
    have hceil := Int.ceil_le_ceil hupper
    simpa using hceil

/-- Membership in the explicit enumeration is exactly relevance to the
frequency annulus. -/
theorem mem_relevantRadialIndexEnumeration_iff (scale : Real) (n : Int) :
    n ∈ relevantRadialIndexEnumeration scale ↔ n ∈ relevantRadialIndices scale := by
  classical
  simp only [relevantRadialIndexEnumeration, Finset.mem_filter]
  constructor
  · exact fun h => h.2
  · intro hn
    exact ⟨mem_relevantRadialIndexBounds_of_mem_relevantRadialIndices scale n hn, hn⟩

/-- The explicit radial-index family supplies the finite enumeration required
by the radial--time reconstruction. -/
theorem hasRelevantRadialEnumeration_relevantRadialIndexEnumeration :
    HasRelevantRadialEnumeration relevantRadialIndexEnumeration := by
  intro scale n
  exact mem_relevantRadialIndexEnumeration_iff scale n

/-- The explicit radial enumeration is a subfamily of its bounding integer
interval. -/
theorem relevantRadialIndexEnumeration_subset_bounds (scale : Real) :
    relevantRadialIndexEnumeration scale ⊆ relevantRadialIndexBounds scale := by
  classical
  rw [relevantRadialIndexEnumeration]
  exact Finset.filter_subset _ _

/-- Exact cardinality of the integer interval used to bound the radial labels. -/
theorem card_relevantRadialIndexBounds (scale : Real) :
    (relevantRadialIndexBounds scale).card =
      (⌈2 * Real.sqrt scale + 3⌉ + 1 - ⌊Real.sqrt scale / 2 - 3⌋).toNat := by
  simp [relevantRadialIndexBounds, Int.card_Icc]

/-- Exact finite cardinality bound for the relevant radial labels. -/
theorem card_relevantRadialIndexEnumeration_le (scale : Real) :
    (relevantRadialIndexEnumeration scale).card ≤
      (⌈2 * Real.sqrt scale + 3⌉ + 1 - ⌊Real.sqrt scale / 2 - 3⌋).toNat := by
  calc
    (relevantRadialIndexEnumeration scale).card ≤
        (relevantRadialIndexBounds scale).card :=
      Finset.card_le_card (relevantRadialIndexEnumeration_subset_bounds scale)
    _ = (⌈2 * Real.sqrt scale + 3⌉ + 1 - ⌊Real.sqrt scale / 2 - 3⌋).toNat :=
      card_relevantRadialIndexBounds scale

/-- A simple scale-explicit count of the relevant radial labels.  This is the
finite-index estimate used before vertical recombination. -/
theorem card_relevantRadialIndexEnumeration_le_two_mul_natCeil_sqrt_add_seven
    (scale : Real) :
    (relevantRadialIndexEnumeration scale).card ≤
      2 * ⌈Real.sqrt scale⌉₊ + 7 := by
  let bounds : Finset Int :=
    Finset.Icc (-3) (2 * (⌈Real.sqrt scale⌉₊ : Int) + 3)
  have hsubset : relevantRadialIndexEnumeration scale ⊆ bounds := by
    intro n hn
    have hn' : n ∈ relevantRadialIndices scale :=
      (mem_relevantRadialIndexEnumeration_iff scale n).mp hn
    rcases hn' with ⟨s, hs, hdist⟩
    have hdist' : -3 < (n : Real) - s ∧ (n : Real) - s < 3 := abs_lt.mp hdist
    have hsnonneg : 0 ≤ s := by
      have hroot : 0 ≤ Real.sqrt scale / 2 := by positivity
      exact hroot.trans hs.1
    have hlower : (-3 : Real) ≤ (n : Real) := by
      linarith [hdist'.1]
    have hceil : Real.sqrt scale ≤ (⌈Real.sqrt scale⌉₊ : Real) := Nat.le_ceil _
    have hupper : (n : Real) ≤ 2 * (⌈Real.sqrt scale⌉₊ : Real) + 3 := by
      linarith [hs.2, hdist'.2]
    dsimp [bounds]
    rw [Finset.mem_Icc]
    constructor
    · exact_mod_cast hlower
    · exact_mod_cast hupper
  calc
    (relevantRadialIndexEnumeration scale).card ≤ bounds.card :=
      Finset.card_le_card hsubset
    _ = 2 * ⌈Real.sqrt scale⌉₊ + 7 := by
      dsimp [bounds]
      rw [Int.card_Icc]
      have hcast :
          2 * (⌈Real.sqrt scale⌉₊ : Int) + 3 + 1 + 3 =
            ((2 * ⌈Real.sqrt scale⌉₊ + 7 : Nat) : Int) := by
        push_cast
        ring
      simp only [sub_neg_eq_add]
      rw [hcast]
      rfl

/-- The relevant radial labels have cardinality `O(sqrt scale)` with an
explicit absolute constant on the scales used in the MSS argument. -/
theorem card_relevantRadialIndexEnumeration_le_eleven_mul_sqrt
    {scale : Real} (hscale : 2 ≤ scale) :
    ((relevantRadialIndexEnumeration scale).card : Real) ≤ 11 * Real.sqrt scale := by
  have hcount :
      ((relevantRadialIndexEnumeration scale).card : Real) ≤
        2 * (⌈Real.sqrt scale⌉₊ : Real) + 7 := by
    exact_mod_cast
      card_relevantRadialIndexEnumeration_le_two_mul_natCeil_sqrt_add_seven scale
  have hsqrt : 1 ≤ Real.sqrt scale := by
    exact Real.one_le_sqrt.mpr (by linarith)
  have hceil : (⌈Real.sqrt scale⌉₊ : Real) ≤ Real.sqrt scale + 1 :=
    (Nat.ceil_lt_add_one (Real.sqrt_nonneg _)).le
  calc
    ((relevantRadialIndexEnumeration scale).card : Real) ≤
        2 * (⌈Real.sqrt scale⌉₊ : Real) + 7 := hcount
    _ ≤ 11 * Real.sqrt scale := by linarith

/-- The finite radial--vertical reconstruction from the MSS decomposition. -/
noncomputable def radialTimeReconstruction (verticalCutoff radialCutoff : Real → Complex)
    (indices : Real → Finset Int) (scale : Real) (a : Euclidean 2 → Complex)
    (ϑ : Real → Complex) (f : Euclidean 2 → Complex) : WaveSpaceTime → Complex :=
  fun z => ∑ n ∈ indices scale,
    verticalProjection verticalCutoff scale n
      (conicOperator scale a ϑ (radialPiece radialCutoff scale n f)) z

/-- The error remaining after the finite radial--vertical reconstruction. -/
noncomputable def radialTimeResidual (verticalCutoff radialCutoff : Real → Complex)
    (indices : Real → Finset Int) (scale : Real) (a : Euclidean 2 → Complex)
    (ϑ : Real → Complex) (f : Euclidean 2 → Complex) : WaveSpaceTime → Complex :=
  fun z => conicOperator scale a ϑ f z -
    radialTimeReconstruction verticalCutoff radialCutoff indices scale a ϑ f z

/-- The finite-exponent radial--time localization target.  It is the exact
rapid-decay remainder estimate from the blueprint, parameterized by a finite
enumeration of the relevant indices.  The endpoint `p = ∞` is deliberately
left to a separate target because the present `ENNReal` formulation records
the finite-`Lp` multiplier estimate used in the later square-function proof. -/
def radialTimeLocalization (verticalCutoff radialCutoff : Real → Complex)
    (indices : Real → Finset Int) (a : Euclidean 2 → Complex)
    (ϑ : Real → Complex) : Prop :=
  HasRelevantRadialEnumeration indices ∧
    ∀ (p : Real) (N : Nat), 1 ≤ p → ∃ C : Real, 0 < C ∧
      ∀ scale : Real, 2 ≤ scale →
        ∀ f : SchwartzMap (Euclidean 2) Complex,
          eLpNorm
              (radialTimeResidual verticalCutoff radialCutoff indices scale a ϑ
                (f : Euclidean 2 → Complex))
              (ENNReal.ofReal p) volume ≤
            ENNReal.ofReal (C * (scale⁻¹) ^ N) *
              eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume

/-- An exact finite enumeration of the relevant radial labels is unique. -/
theorem relevantRadialIndexEnumeration_eq_of_hasRelevantRadialEnumeration
    (indices : Real → Finset Int) (hindices : HasRelevantRadialEnumeration indices)
    (scale : Real) :
    relevantRadialIndexEnumeration scale = indices scale := by
  ext n
  rw [mem_relevantRadialIndexEnumeration_iff, hindices scale n]

/-- Radial--time reconstruction is independent of the chosen presentation of
the exact finite index enumeration. -/
theorem radialTimeReconstruction_eq_of_hasRelevantRadialEnumeration
    (verticalCutoff radialCutoff : Real → Complex) (indices : Real → Finset Int)
    (hindices : HasRelevantRadialEnumeration indices) (scale : Real)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex) (f : Euclidean 2 → Complex) :
    radialTimeReconstruction verticalCutoff radialCutoff indices scale a ϑ f =
      radialTimeReconstruction verticalCutoff radialCutoff relevantRadialIndexEnumeration
        scale a ϑ f := by
  have hfun : indices = relevantRadialIndexEnumeration := by
    funext r
    exact (relevantRadialIndexEnumeration_eq_of_hasRelevantRadialEnumeration
      indices hindices r).symm
  rw [hfun]

/-- The corresponding radial--time residual is likewise independent of an
exact presentation of the finite relevant-index family. -/
theorem radialTimeResidual_eq_of_hasRelevantRadialEnumeration
    (verticalCutoff radialCutoff : Real → Complex) (indices : Real → Finset Int)
    (hindices : HasRelevantRadialEnumeration indices) (scale : Real)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex) (f : Euclidean 2 → Complex) :
    radialTimeResidual verticalCutoff radialCutoff indices scale a ϑ f =
      radialTimeResidual verticalCutoff radialCutoff relevantRadialIndexEnumeration
        scale a ϑ f := by
  have hfun : indices = relevantRadialIndexEnumeration := by
    funext r
    exact (relevantRadialIndexEnumeration_eq_of_hasRelevantRadialEnumeration
      indices hindices r).symm
  rw [hfun]

/-- For the explicit enumeration, radial--time localization reduces exactly
to its rapid-decay estimate; its finite-index premise is already proved. -/
theorem radialTimeLocalization_iff_estimate_relevantRadialIndexEnumeration
    (verticalCutoff radialCutoff : Real → Complex) (a : Euclidean 2 → Complex)
    (ϑ : Real → Complex) :
    radialTimeLocalization verticalCutoff radialCutoff relevantRadialIndexEnumeration a ϑ ↔
      ∀ (p : Real) (N : Nat), 1 ≤ p → ∃ C : Real, 0 < C ∧
        ∀ scale : Real, 2 ≤ scale →
          ∀ f : SchwartzMap (Euclidean 2) Complex,
            eLpNorm
                (radialTimeResidual verticalCutoff radialCutoff
                  relevantRadialIndexEnumeration scale a ϑ
                  (f : Euclidean 2 → Complex))
                (ENNReal.ofReal p) volume ≤
              ENNReal.ofReal (C * (scale⁻¹) ^ N) *
                eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
  constructor
  · exact fun h => h.2
  · intro h
    exact ⟨hasRelevantRadialEnumeration_relevantRadialIndexEnumeration, h⟩

/-- The square function over a finite family of space--time functions. -/
noncomputable def verticalSquareFunction (indices : Finset Int)
    (H : Int → WaveSpaceTime → Complex) : WaveSpaceTime → Real :=
  fun z => Real.sqrt (∑ n ∈ indices, ‖H n z‖ ^ 2)

/-- The finite vertical square function is pointwise nonnegative. -/
theorem verticalSquareFunction_nonneg (indices : Finset Int)
    (H : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    0 ≤ verticalSquareFunction indices H z :=
  Real.sqrt_nonneg _

/-- Each summand is pointwise dominated by its finite vertical square
function. -/
theorem norm_le_verticalSquareFunction (indices : Finset Int)
    (H : Int → WaveSpaceTime → Complex) {n : Int} (hn : n ∈ indices)
    (z : WaveSpaceTime) :
    ‖H n z‖ ≤ verticalSquareFunction indices H z := by
  unfold verticalSquareFunction
  apply (Real.le_sqrt (norm_nonneg _) (by positivity)).2
  exact Finset.single_le_sum (fun m hm => sq_nonneg (‖H m z‖)) hn

/-- A finite sum costs at most the cardinality times its vertical square
function, without any projection boundedness hypothesis. -/
theorem norm_finset_sum_le_card_nsmul_verticalSquareFunction
    (indices : Finset Int) (H : Int → WaveSpaceTime → Complex)
    (z : WaveSpaceTime) :
    ‖∑ n ∈ indices, H n z‖ ≤ indices.card • verticalSquareFunction indices H z := by
  calc
    ‖∑ n ∈ indices, H n z‖ ≤ ∑ n ∈ indices, ‖H n z‖ := norm_sum_le _ _
    _ ≤ ∑ _n ∈ indices, verticalSquareFunction indices H z :=
      Finset.sum_le_sum fun n hn => norm_le_verticalSquareFunction indices H hn z
    _ = indices.card • verticalSquareFunction indices H z := by simp

/-- The finite vertical recombination operator appearing in the MSS proof. -/
noncomputable def verticalRecombined (verticalCutoff : Real → Complex)
    (scale : Real) (indices : Finset Int)
    (H : Int → WaveSpaceTime → Complex) : WaveSpaceTime → Complex :=
  fun z => ∑ n ∈ indices, verticalProjection verticalCutoff scale n (H n) z

/-- Exact finite packet form of literal vertical recombination.  It removes
the iterated three-dimensional Fourier notation term-by-term, leaving the
actual one-dimensional temporal multipliers which need to satisfy the
separate vector-valued endpoint estimate. -/
theorem verticalRecombined_verticalSeparablePackets
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → Real → Complex) (z : WaveSpaceTime) :
    verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n)) z =
      ∑ n ∈ indices,
        verticalTemporalProjection β scale n (g n) z.2 * F n z.1 := by
  classical
  unfold verticalRecombined
  apply Finset.sum_congr rfl
  intro n hn
  exact verticalProjection_verticalSeparablePacket β scale n (F n) (g n) z

private theorem aux_sum_schwartzReal_apply {ι : Type*}
    (indices : Finset ι) (h : ι → SchwartzMap Real Complex) (t : Real) :
    (∑ n ∈ indices, h n) t = ∑ n ∈ indices, h n t := by
  change
    ((FunLike.coeAddMonoidHom (SchwartzMap Real Complex) Real Complex)
      (∑ n ∈ indices, h n)) t =
        ∑ n ∈ indices,
          ((FunLike.coeAddMonoidHom (SchwartzMap Real Complex) Real Complex) (h n)) t
  simpa only [Finset.sum_apply] using
    congrFun (map_sum
      (FunLike.coeAddMonoidHom (SchwartzMap Real Complex) Real Complex) h indices) t

private noncomputable def aux_verticalRecombinedTemporalProfile
    (indices : Finset Int) (m g : Int → SchwartzMap Real Complex) :
    SchwartzMap Real Complex :=
  ∑ n ∈ indices, 𝓕⁻ (aux_verticalTemporalMultiplierProfile (m n) (g n))

private theorem aux_verticalRecombinedTemporalProfile_fourier_apply
    (indices : Finset Int) (m g : Int → SchwartzMap Real Complex) (τ : Real) :
    𝓕 ((aux_verticalRecombinedTemporalProfile indices m g :
      SchwartzMap Real Complex) : Real → Complex) τ =
      ∑ n ∈ indices, aux_verticalTemporalMultiplierProfile (m n) (g n) τ := by
  have hsum :
      𝓕 (aux_verticalRecombinedTemporalProfile indices m g :
        SchwartzMap Real Complex) =
        ∑ n ∈ indices, aux_verticalTemporalMultiplierProfile (m n) (g n) := by
    unfold aux_verticalRecombinedTemporalProfile
    rw [FourierTransform.fourier_sum]
    apply Finset.sum_congr rfl
    intro n hn
    exact FourierTransform.fourier_fourierInv_eq _
  have hpoint := congrArg (fun q : SchwartzMap Real Complex => q τ) hsum
  calc
    𝓕 ((aux_verticalRecombinedTemporalProfile indices m g :
      SchwartzMap Real Complex) : Real → Complex) τ =
        (∑ n ∈ indices, aux_verticalTemporalMultiplierProfile (m n) (g n)) τ := by
      simpa only [SchwartzMap.fourier_coe] using hpoint
    _ = ∑ n ∈ indices, aux_verticalTemporalMultiplierProfile (m n) (g n) τ :=
      aux_sum_schwartzReal_apply indices
        (fun n => aux_verticalTemporalMultiplierProfile (m n) (g n)) τ

/-- For a finite vertical recombination of literal separable packets sharing
one spatial Schwartz factor, the space--time Fourier multiplier identity
holds after collecting the finite temporal sum into a Schwartz profile.  This
is a common-spatial-factor finite-tensor theorem; it does not cover the
general recombination with both spatial and temporal factors varying, nor a
physical-time-cutoff half-wave. -/
theorem spaceTimeFourier_verticalRecombined_verticalSeparablePackets_of_schwartzProfiles_common_spatial
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : SchwartzMap (Euclidean 2) Complex) (ξ : Euclidean 2) (τ : Real) :
    spaceTimeFourier
        (verticalRecombined β scale indices
          (fun n => verticalSeparablePacket F (g n : Real → Complex))) (ξ, τ) =
      ∑ n ∈ indices,
        verticalMultiplier β scale n (ξ, τ) *
          spaceTimeFourier (verticalSeparablePacket F (g n : Real → Complex)) (ξ, τ) := by
  have hphysical : verticalRecombined β scale indices
      (fun n => verticalSeparablePacket F (g n : Real → Complex)) =
      verticalSeparablePacket F
        ((aux_verticalRecombinedTemporalProfile indices m g :
          SchwartzMap Real Complex) : Real → Complex) := by
    funext z
    rw [verticalRecombined_verticalSeparablePackets]
    unfold verticalSeparablePacket
    unfold aux_verticalRecombinedTemporalProfile
    rw [aux_sum_schwartzReal_apply]
    rw [Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro n hn
    rw [aux_verticalTemporalProjection_eq_fourierInv_profile β scale n
      (m n) (g n) (hprofile n hn)]
  rw [hphysical, spaceTimeFourier_verticalSeparablePacket,
    aux_verticalRecombinedTemporalProfile_fourier_apply]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro n hn
  rw [aux_verticalTemporalMultiplierProfile_apply, hprofile n hn,
    spaceTimeFourier_verticalSeparablePacket, verticalMultiplier]
  ring

private theorem aux_spaceTimeFourier_finset_sum_verticalSeparablePackets
    (indices : Finset Int)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → SchwartzMap Real Complex)
    (ξ : Euclidean 2) (τ : Real) :
    spaceTimeFourier
        (fun z => ∑ n ∈ indices,
          verticalSeparablePacket (F n) (g n : Real → Complex) z) (ξ, τ) =
      ∑ n ∈ indices,
        spaceTimeFourier (verticalSeparablePacket (F n) (g n : Real → Complex)) (ξ, τ) := by
  have hspace (t : Real) :
      𝓕 (fun x : Euclidean 2 => ∑ n ∈ indices, g n t * F n x) ξ =
        ∑ n ∈ indices, g n t * 𝓕 (F n : Euclidean 2 → Complex) ξ := by
    let H : SchwartzMap (Euclidean 2) Complex :=
      ∑ n ∈ indices, (g n t) • F n
    have hH (x : Euclidean 2) : H x = ∑ n ∈ indices, g n t * F n x := by
      dsimp only [H]
      rw [sum_apply]
      simp only [smul_apply, smul_eq_mul]
    rw [show (fun x : Euclidean 2 => ∑ n ∈ indices, g n t * F n x) = H by
      funext x
      exact (hH x).symm]
    change (𝓕 H : SchwartzMap (Euclidean 2) Complex) ξ = _
    rw [show H = ∑ n ∈ indices, (g n t) • F n by rfl]
    rw [FourierTransform.fourier_sum, sum_apply]
    apply Finset.sum_congr rfl
    intro n hn
    rw [FourierTransform.fourier_smul]
    simp only [smul_apply, smul_eq_mul, SchwartzMap.fourier_coe]
  have hright :
      (∑ n ∈ indices,
        spaceTimeFourier (verticalSeparablePacket (F n) (g n : Real → Complex)) (ξ, τ)) =
        ∑ n ∈ indices,
          𝓕 (F n : Euclidean 2 → Complex) ξ * 𝓕 (g n : Real → Complex) τ := by
    apply Finset.sum_congr rfl
    intro n hn
    exact spaceTimeFourier_verticalSeparablePacket (F n) (g n : Real → Complex) ξ τ
  rw [hright]
  unfold spaceTimeFourier
  change 𝓕 (fun t : Real =>
    𝓕 (fun x : Euclidean 2 => ∑ n ∈ indices, g n t * F n x) ξ) τ = _
  rw [show (fun t : Real =>
    𝓕 (fun x : Euclidean 2 => ∑ n ∈ indices, g n t * F n x) ξ) =
      fun t : Real => ∑ n ∈ indices, g n t * 𝓕 (F n : Euclidean 2 → Complex) ξ by
        funext t
        exact hspace t]
  let K : SchwartzMap Real Complex :=
    ∑ n ∈ indices, (𝓕 (F n : Euclidean 2 → Complex) ξ) • g n
  have hK (t : Real) : K t =
      ∑ n ∈ indices, g n t * 𝓕 (F n : Euclidean 2 → Complex) ξ := by
    dsimp only [K]
    rw [sum_apply]
    simp only [smul_apply, smul_eq_mul]
    apply Finset.sum_congr rfl
    intro n hn
    ring
  rw [show (fun t : Real => ∑ n ∈ indices,
    g n t * 𝓕 (F n : Euclidean 2 → Complex) ξ) = K by
      funext t
      exact (hK t).symm]
  change (𝓕 K : SchwartzMap Real Complex) τ = _
  rw [show K = ∑ n ∈ indices,
    (𝓕 (F n : Euclidean 2 → Complex) ξ) • g n by rfl]
  rw [FourierTransform.fourier_sum, sum_apply]
  apply Finset.sum_congr rfl
  intro n hn
  rw [FourierTransform.fourier_smul]
  simp only [smul_apply, smul_eq_mul, SchwartzMap.fourier_coe]

/-- A finite vertical recombination of literal separable packets has the
expected space--time Fourier multiplier identity when every translated
temporal cutoff has a supplied Schwartz representative.  Unlike the
common-spatial-factor corollary, both the spatial and temporal factors may
vary with the radial index.  The proof uses only finite sums of actual
Schwartz maps at each Fourier stage; it does not assert an arbitrary-function
Fourier-additivity or cover physical-time-cutoff half-waves. -/
theorem spaceTimeFourier_verticalRecombined_verticalSeparablePackets_of_schwartzProfiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : Int → SchwartzMap (Euclidean 2) Complex) (ξ : Euclidean 2) (τ : Real) :
    spaceTimeFourier
        (verticalRecombined β scale indices
          (fun n => verticalSeparablePacket (F n) (g n : Real → Complex))) (ξ, τ) =
      ∑ n ∈ indices,
        verticalMultiplier β scale n (ξ, τ) *
          spaceTimeFourier (verticalSeparablePacket (F n) (g n : Real → Complex)) (ξ, τ) := by
  let h : Int → SchwartzMap Real Complex := fun n =>
    𝓕⁻ (aux_verticalTemporalMultiplierProfile (m n) (g n))
  have hpiece (n : Int) (hn : n ∈ indices) :
      verticalProjection β scale n
        (verticalSeparablePacket (F n) (g n : Real → Complex)) =
      verticalSeparablePacket (F n) (h n : Real → Complex) := by
    funext z
    rw [verticalProjection_verticalSeparablePacket]
    rw [aux_verticalTemporalProjection_eq_fourierInv_profile β scale n
      (m n) (g n) (hprofile n hn)]
    rfl
  have hphysical : verticalRecombined β scale indices
      (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) =
      fun z => ∑ n ∈ indices,
        verticalSeparablePacket (F n) (h n : Real → Complex) z := by
    funext z
    unfold verticalRecombined
    apply Finset.sum_congr rfl
    intro n hn
    rw [hpiece n hn]
  rw [hphysical, aux_spaceTimeFourier_finset_sum_verticalSeparablePackets]
  apply Finset.sum_congr rfl
  intro n hn
  rw [← hpiece n hn]
  exact spaceTimeFourier_verticalProjection_verticalSeparablePacket_of_schwartzProfile
    β scale n (m n) (g n) (hprofile n hn) (F n) ξ τ

/-- A literal finite `L²` recombination endpoint for the one-dimensional
vertical multipliers.  The supplied `m n` are actual Schwartz representatives
of the translated cutoff profiles, and their pointwise square-overlap is the
only Fourier-side estimate used here. -/
theorem integral_norm_sq_sum_verticalTemporalProjection_le_of_schwartz_profiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex) {C : Real}
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ) ≤ C) :
    (∫ t : Real, ‖∑ n ∈ indices,
      verticalTemporalProjection β scale n (g n) t‖ ^ (2 : ℕ)) ≤
      C * ∑ n ∈ indices, ∫ t : Real, ‖g n t‖ ^ (2 : ℕ) := by
  classical
  let h : Int → SchwartzMap Real Complex := fun n =>
    SchwartzMap.smulLeftCLM Complex (m n : Real → Complex) (𝓕 (g n))
  let hsum : SchwartzMap Real Complex := ∑ n ∈ indices, h n
  let out : SchwartzMap Real Complex := 𝓕⁻ hsum
  have hpiece (n : Int) (t : Real) :
      (𝓕⁻ (h n) : SchwartzMap Real Complex) t =
        𝓕⁻ (fun τ : Real => m n τ * 𝓕 (g n : Real → Complex) τ) t := by
    rw [SchwartzMap.fourierInv_coe]
    apply congrArg (fun q : Real → Complex => 𝓕⁻ q t)
    funext τ
    simp only [h, SchwartzMap.smulLeftCLM_apply (m n).hasTemperateGrowth,
      smul_eq_mul, SchwartzMap.fourier_coe]
  have hvertical (n : Int) (hn : n ∈ indices) (t : Real) :
      verticalTemporalProjection β scale n (g n) t =
        𝓕⁻ (fun τ : Real => m n τ * 𝓕 (g n : Real → Complex) τ) t := by
    unfold verticalTemporalProjection
    apply congrArg (fun q : Real → Complex => 𝓕⁻ q t)
    funext τ
    rw [hprofile n hn τ]
  have hactual (t : Real) :
      (∑ n ∈ indices, verticalTemporalProjection β scale n (g n) t) = out t := by
    symm
    calc
      out t = ∑ n ∈ indices, (𝓕⁻ (h n) : SchwartzMap Real Complex) t := by
        dsimp only [out, hsum]
        rw [FourierTransform.fourierInv_sum]
        simp
      _ = ∑ n ∈ indices,
          𝓕⁻ (fun τ : Real => m n τ * 𝓕 (g n : Real → Complex) τ) t := by
        apply Finset.sum_congr rfl
        intro n hn
        exact hpiece n t
      _ = ∑ n ∈ indices, verticalTemporalProjection β scale n (g n) t := by
        apply Finset.sum_congr rfl
        intro n hn
        exact (hvertical n hn t).symm
  have hsum_apply (τ : Real) :
      hsum τ = ∑ n ∈ indices, m n τ * 𝓕 (g n : Real → Complex) τ := by
    dsimp only [hsum]
    rw [sum_apply]
    apply Finset.sum_congr rfl
    intro n hn
    simp only [h, SchwartzMap.smulLeftCLM_apply (m n).hasTemperateGrowth,
      smul_eq_mul, SchwartzMap.fourier_coe]
  have hsum_integrable : Integrable (fun τ : Real => ‖hsum τ‖ ^ (2 : ℕ)) volume :=
    (memLp_two_iff_integrable_sq_norm hsum.continuous.aestronglyMeasurable).mp
      (hsum.memLp 2 volume)
  have hg_integrable (n : Int) :
      Integrable (fun τ : Real => ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ)) volume := by
    rw [← SchwartzMap.fourier_coe]
    exact (memLp_two_iff_integrable_sq_norm
      (𝓕 (g n)).continuous.aestronglyMeasurable).mp ((𝓕 (g n)).memLp 2 volume)
  have hright_integrable : Integrable (fun τ : Real =>
      C * ∑ n ∈ indices, ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ)) volume :=
    (integrable_finsetSum indices (fun n hn => hg_integrable n)).const_mul C
  have hpoint (τ : Real) :
      ‖∑ n ∈ indices, m n τ * 𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) ≤
        C * ∑ n ∈ indices, ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) := by
    have hnorm :
        ‖∑ n ∈ indices, m n τ * 𝓕 (g n : Real → Complex) τ‖ ≤
          Real.sqrt (∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ)) *
            Real.sqrt (∑ n ∈ indices, ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ)) := by
      calc
        ‖∑ n ∈ indices, m n τ * 𝓕 (g n : Real → Complex) τ‖ ≤
            ∑ n ∈ indices, ‖m n τ * 𝓕 (g n : Real → Complex) τ‖ := norm_sum_le _ _
        _ = ∑ n ∈ indices, ‖m n τ‖ * ‖𝓕 (g n : Real → Complex) τ‖ := by
          apply Finset.sum_congr rfl
          intro n hn
          rw [norm_mul]
        _ ≤ Real.sqrt (∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ)) *
            Real.sqrt (∑ n ∈ indices, ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ)) :=
          Real.sum_mul_le_sqrt_mul_sqrt _ _ _
    calc
      ‖∑ n ∈ indices, m n τ * 𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) ≤
          (Real.sqrt (∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ)) *
            Real.sqrt (∑ n ∈ indices, ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ))) ^ (2 : ℕ) :=
        (sq_le_sq₀ (norm_nonneg _) (mul_nonneg (Real.sqrt_nonneg _)
          (Real.sqrt_nonneg _))).mpr hnorm
      _ = (∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ)) *
          (∑ n ∈ indices, ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ)) := by
        rw [mul_pow, Real.sq_sqrt (Finset.sum_nonneg fun _ _ => sq_nonneg _),
          Real.sq_sqrt (Finset.sum_nonneg fun _ _ => sq_nonneg _)]
      _ ≤ C * ∑ n ∈ indices, ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) :=
        mul_le_mul_of_nonneg_right (hoverlap τ)
          (Finset.sum_nonneg fun _ _ => sq_nonneg _)
  calc
    (∫ t : Real, ‖∑ n ∈ indices,
        verticalTemporalProjection β scale n (g n) t‖ ^ (2 : ℕ)) =
        ∫ t : Real, ‖out t‖ ^ (2 : ℕ) := by
      apply integral_congr_ae
      filter_upwards with t
      rw [hactual t]
    _ = ∫ τ : Real, ‖𝓕 (out : Real → Complex) τ‖ ^ (2 : ℕ) :=
      (FourierRadius.integral_norm_sq_fourier_schwartz_eq out).symm
    _ = ∫ τ : Real, ‖hsum τ‖ ^ (2 : ℕ) := by
      apply integral_congr_ae
      filter_upwards with τ
      rw [← SchwartzMap.fourier_coe]
      change ‖(𝓕 out : SchwartzMap Real Complex) τ‖ ^ (2 : ℕ) = _
      rw [show 𝓕 out = hsum by
        dsimp only [out]
        exact FourierTransform.fourier_fourierInv_eq _]
    _ = ∫ τ : Real,
        ‖∑ n ∈ indices, m n τ * 𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) := by
      apply integral_congr_ae
      filter_upwards with τ
      rw [hsum_apply τ]
    _ ≤ ∫ τ : Real, C * ∑ n ∈ indices,
        ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) := by
      calc
        (∫ τ : Real,
            ‖∑ n ∈ indices, m n τ * 𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ)) =
            ∫ τ : Real, ‖hsum τ‖ ^ (2 : ℕ) := by
          apply integral_congr_ae
          filter_upwards with τ
          rw [hsum_apply τ]
        _ ≤ ∫ τ : Real, C * ∑ n ∈ indices,
            ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) :=
          integral_mono hsum_integrable hright_integrable (fun τ => by
            rw [hsum_apply τ]
            exact hpoint τ)
    _ = C * ∑ n ∈ indices, ∫ τ : Real,
        ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) := by
      rw [integral_const_mul, integral_finsetSum indices (fun n hn => hg_integrable n)]
    _ = C * ∑ n ∈ indices, ∫ t : Real, ‖g n t‖ ^ (2 : ℕ) := by
      congr 1
      apply Finset.sum_congr rfl
      intro n hn
      exact FourierRadius.integral_norm_sq_fourier_schwartz_eq (g n)

private theorem aux_verticalTemporalProjection_const_mul
    (β : Real → Complex) (scale : Real) (n : Int)
    (c : Complex) (g : Real → Complex) (t : Real) :
    verticalTemporalProjection β scale n (fun s => c * g s) t =
      c * verticalTemporalProjection β scale n g t := by
  unfold verticalTemporalProjection
  rw [show (fun τ : Real => β ((Real.sqrt scale)⁻¹ * τ - n) *
      𝓕 (fun s : Real => c * g s) τ) =
      fun τ : Real => β ((Real.sqrt scale)⁻¹ * τ - n) *
        (c * 𝓕 g τ) by
        funext τ
        rw [aux_fourier_const_mul_apply]]
  rw [show (fun τ : Real => β ((Real.sqrt scale)⁻¹ * τ - n) *
      (c * 𝓕 g τ)) =
      fun τ : Real => c *
        (β ((Real.sqrt scale)⁻¹ * τ - n) * 𝓕 g τ) by
        funext τ
        ring]
  exact aux_fourierInv_const_mul_apply c _ t

private noncomputable def aux_verticalTemporalOutputProfile
    (m g : SchwartzMap Real Complex) : SchwartzMap Real Complex :=
  𝓕⁻ (SchwartzMap.smulLeftCLM Complex (m : Real → Complex) (𝓕 g))

private theorem aux_verticalTemporalProjection_eq_outputProfile
    (β : Real → Complex) (scale : Real) (n : Int)
    (m g : SchwartzMap Real Complex)
    (hprofile : ∀ τ : Real, m τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (t : Real) :
    verticalTemporalProjection β scale n (g : Real → Complex) t =
      (aux_verticalTemporalOutputProfile m g : Real → Complex) t := by
  unfold verticalTemporalProjection aux_verticalTemporalOutputProfile
  rw [SchwartzMap.fourierInv_coe]
  apply congrArg (fun q : Real → Complex => 𝓕⁻ q t)
  funext τ
  simp only [SchwartzMap.smulLeftCLM_apply (m).hasTemperateGrowth,
    smul_eq_mul, SchwartzMap.fourier_coe]
  rw [hprofile τ]

private theorem aux_integrable_norm_sq_verticalRecombined_verticalSeparablePackets_of_profiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : Int → SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun z : WaveSpaceTime =>
      ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) volume := by
  classical
  let h : Int → SchwartzMap Real Complex := fun n =>
    aux_verticalTemporalOutputProfile (m n) (g n)
  have hvertical (n : Int) (hn : n ∈ indices) (t : Real) :
      verticalTemporalProjection β scale n (g n : Real → Complex) t = h n t := by
    exact aux_verticalTemporalProjection_eq_outputProfile β scale n (m n) (g n)
      (hprofile n hn) t
  have houtput (z : WaveSpaceTime) :
      verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z =
        ∑ n ∈ indices, h n z.2 * F n z.1 := by
    rw [verticalRecombined_verticalSeparablePackets]
    apply Finset.sum_congr rfl
    intro n hn
    rw [hvertical n hn z.2]
  have hF_integrable (n : Int) :
      Integrable (fun x : Euclidean 2 => ‖F n x‖ ^ (2 : ℕ)) volume :=
    (memLp_two_iff_integrable_sq_norm
      (F n).continuous.aestronglyMeasurable).mp ((F n).memLp 2 volume)
  have hh_integrable (n : Int) :
      Integrable (fun t : Real => ‖h n t‖ ^ (2 : ℕ)) volume :=
    (memLp_two_iff_integrable_sq_norm
      (h n).continuous.aestronglyMeasurable).mp ((h n).memLp 2 volume)
  have hterm_integrable (n : Int) :
      Integrable (fun z : WaveSpaceTime => ‖h n z.2 * F n z.1‖ ^ (2 : ℕ)) volume := by
    simpa only [Measure.volume_eq_prod, norm_mul, mul_pow, mul_comm] using
      (hF_integrable n).mul_prod (hh_integrable n)
  have hterm_memLp (n : Int) :
      MemLp (fun z : WaveSpaceTime => h n z.2 * F n z.1) 2 volume := by
    apply (memLp_two_iff_integrable_sq_norm
      (((h n).continuous.comp continuous_snd).mul
        ((F n).continuous.comp continuous_fst)).aestronglyMeasurable).mpr
    exact hterm_integrable n
  have hsum_memLp : MemLp (fun z : WaveSpaceTime =>
      ∑ n ∈ indices, h n z.2 * F n z.1) 2 volume :=
    memLp_finsetSum indices (fun n hn => hterm_memLp n)
  rw [show (fun z : WaveSpaceTime =>
      ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) =
      fun z : WaveSpaceTime => ‖∑ n ∈ indices, h n z.2 * F n z.1‖ ^ (2 : ℕ) by
        funext z
        rw [houtput z]]
  exact (memLp_two_iff_integrable_sq_norm hsum_memLp.1).mp hsum_memLp

private theorem aux_integral_norm_sq_verticalSeparablePacket_eq_product
    (F : SchwartzMap (Euclidean 2) Complex) (g : SchwartzMap Real Complex) :
    (∫ z : WaveSpaceTime,
      ‖verticalSeparablePacket F (g : Real → Complex) z‖ ^ (2 : ℕ)) =
      (∫ x : Euclidean 2, ‖F x‖ ^ (2 : ℕ)) *
        (∫ t : Real, ‖g t‖ ^ (2 : ℕ)) := by
  have hF_integrable : Integrable (fun x : Euclidean 2 => ‖F x‖ ^ (2 : ℕ)) volume :=
    (memLp_two_iff_integrable_sq_norm
      F.continuous.aestronglyMeasurable).mp (F.memLp 2 volume)
  have hg_integrable : Integrable (fun t : Real => ‖g t‖ ^ (2 : ℕ)) volume :=
    (memLp_two_iff_integrable_sq_norm
      g.continuous.aestronglyMeasurable).mp (g.memLp 2 volume)
  have hpacket_integrable : Integrable (fun z : WaveSpaceTime =>
      ‖verticalSeparablePacket F (g : Real → Complex) z‖ ^ (2 : ℕ)) volume := by
    simpa only [verticalSeparablePacket, Measure.volume_eq_prod, norm_mul, mul_pow, mul_comm] using
      hF_integrable.mul_prod hg_integrable
  calc
    (∫ z : WaveSpaceTime,
        ‖verticalSeparablePacket F (g : Real → Complex) z‖ ^ (2 : ℕ)) =
        ∫ x : Euclidean 2, ∫ t : Real,
          ‖verticalSeparablePacket F (g : Real → Complex) (x, t)‖ ^ (2 : ℕ) := by
      rw [Measure.volume_eq_prod]
      exact integral_prod _ (by
        simpa only [Measure.volume_eq_prod] using hpacket_integrable)
    _ = ∫ x : Euclidean 2,
        ‖F x‖ ^ (2 : ℕ) * ∫ t : Real, ‖g t‖ ^ (2 : ℕ) := by
      apply integral_congr_ae
      filter_upwards with x
      rw [show (fun t : Real =>
        ‖verticalSeparablePacket F (g : Real → Complex) (x, t)‖ ^ (2 : ℕ)) =
          fun t : Real => ‖F x‖ ^ (2 : ℕ) * ‖g t‖ ^ (2 : ℕ) by
            funext t
            simp only [verticalSeparablePacket, norm_mul, mul_pow, mul_comm]]
      rw [integral_const_mul]
    _ = (∫ x : Euclidean 2, ‖F x‖ ^ (2 : ℕ)) *
        (∫ t : Real, ‖g t‖ ^ (2 : ℕ)) := by
      rw [integral_mul_const]

private theorem aux_iterated_integral_norm_sq_verticalRecombined_verticalSeparablePackets_le
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex) {C : Real}
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ) ≤ C)
    (F : Int → SchwartzMap (Euclidean 2) Complex) :
    (∫ x : Euclidean 2, ∫ t : Real,
      ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) (x, t)‖ ^ (2 : ℕ)) ≤
      C * ∑ n ∈ indices,
        (∫ x : Euclidean 2, ‖F n x‖ ^ (2 : ℕ)) *
          (∫ t : Real, ‖g n t‖ ^ (2 : ℕ)) := by
  classical
  let h : Int → SchwartzMap Real Complex := fun n =>
    aux_verticalTemporalOutputProfile (m n) (g n)
  have hvertical (n : Int) (hn : n ∈ indices) (t : Real) :
      verticalTemporalProjection β scale n (g n : Real → Complex) t = h n t := by
    exact aux_verticalTemporalProjection_eq_outputProfile β scale n (m n) (g n)
      (hprofile n hn) t
  have houtput (z : WaveSpaceTime) :
      verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z =
        ∑ n ∈ indices, h n z.2 * F n z.1 := by
    rw [verticalRecombined_verticalSeparablePackets]
    apply Finset.sum_congr rfl
    intro n hn
    rw [hvertical n hn z.2]
  have hscaled (x : Euclidean 2) (n : Int) :
      (∫ t : Real, ‖((F n x) • g n : SchwartzMap Real Complex) t‖ ^ (2 : ℕ)) =
        ‖F n x‖ ^ (2 : ℕ) * ∫ t : Real, ‖g n t‖ ^ (2 : ℕ) := by
    rw [show (fun t : Real => ‖((F n x) • g n : SchwartzMap Real Complex) t‖ ^ (2 : ℕ)) =
        fun t : Real => ‖F n x‖ ^ (2 : ℕ) * ‖g n t‖ ^ (2 : ℕ) by
          funext t
          simp only [smul_apply, smul_eq_mul, norm_mul, mul_pow]]
    rw [integral_const_mul]
  have hslice (x : Euclidean 2) :
      (∫ t : Real,
        ‖verticalRecombined β scale indices
          (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) (x, t)‖ ^ (2 : ℕ)) ≤
        C * ∑ n ∈ indices,
          ‖F n x‖ ^ (2 : ℕ) * ∫ t : Real, ‖g n t‖ ^ (2 : ℕ) := by
    have htemporal :=
      integral_norm_sq_sum_verticalTemporalProjection_le_of_schwartz_profiles
        β scale indices m (fun n => (F n x) • g n) hprofile hoverlap
    calc
      (∫ t : Real,
          ‖verticalRecombined β scale indices
            (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) (x, t)‖ ^
              (2 : ℕ)) =
          ∫ t : Real, ‖∑ n ∈ indices,
            verticalTemporalProjection β scale n
              (((F n x) • g n : SchwartzMap Real Complex) : Real → Complex) t‖ ^
              (2 : ℕ) := by
            apply integral_congr_ae
            filter_upwards with t
            rw [verticalRecombined_verticalSeparablePackets]
            apply congrArg (fun w : Complex => ‖w‖ ^ (2 : ℕ))
            apply Finset.sum_congr rfl
            intro n hn
            change verticalTemporalProjection β scale n (g n : Real → Complex) t * F n x =
              verticalTemporalProjection β scale n
                (fun s : Real => F n x * g n s) t
            rw [aux_verticalTemporalProjection_const_mul]
            ring
      _ ≤ C * ∑ n ∈ indices, ∫ t : Real,
          ‖((F n x) • g n : SchwartzMap Real Complex) t‖ ^ (2 : ℕ) := htemporal
      _ = C * ∑ n ∈ indices,
          ‖F n x‖ ^ (2 : ℕ) * ∫ t : Real, ‖g n t‖ ^ (2 : ℕ) := by
        congr 1
        apply Finset.sum_congr rfl
        intro n hn
        exact hscaled x n
  have hF_integrable (n : Int) :
      Integrable (fun x : Euclidean 2 => ‖F n x‖ ^ (2 : ℕ)) volume :=
    (memLp_two_iff_integrable_sq_norm
      (F n).continuous.aestronglyMeasurable).mp ((F n).memLp 2 volume)
  have hright_integrable : Integrable (fun x : Euclidean 2 =>
      C * ∑ n ∈ indices, ‖F n x‖ ^ (2 : ℕ) *
        ∫ t : Real, ‖g n t‖ ^ (2 : ℕ)) volume := by
    apply (integrable_finsetSum indices (fun n hn =>
      (hF_integrable n).mul_const (∫ t : Real, ‖g n t‖ ^ (2 : ℕ)))).const_mul C
  have houtput_cont : Continuous (fun z : WaveSpaceTime =>
      ∑ n ∈ indices, h n z.2 * F n z.1) := by
    apply continuous_finsetSum
    intro n hn
    exact ((h n).continuous.comp continuous_snd).mul
      ((F n).continuous.comp continuous_fst)
  have hsq_cont : Continuous (fun z : WaveSpaceTime =>
      ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) := by
    rw [show (fun z : WaveSpaceTime =>
      ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) =
      fun z : WaveSpaceTime => ‖∑ n ∈ indices, h n z.2 * F n z.1‖ ^ (2 : ℕ) by
        funext z
        rw [houtput z]]
    exact houtput_cont.norm.pow _
  have hslice_meas : AEStronglyMeasurable (fun x : Euclidean 2 =>
      ∫ t : Real, ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) (x, t)‖ ^ (2 : ℕ)) volume :=
    hsq_cont.stronglyMeasurable.integral_prod_right'.aestronglyMeasurable
  have hleft_integrable : Integrable (fun x : Euclidean 2 =>
      ∫ t : Real, ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) (x, t)‖ ^ (2 : ℕ)) volume := by
    refine hright_integrable.mono' hslice_meas ?_
    filter_upwards with x
    rw [Real.norm_eq_abs, abs_of_nonneg]
    · exact hslice x
    · exact integral_nonneg fun t => sq_nonneg _
  calc
    (∫ x : Euclidean 2, ∫ t : Real,
        ‖verticalRecombined β scale indices
          (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) (x, t)‖ ^
            (2 : ℕ)) ≤
        ∫ x : Euclidean 2, C * ∑ n ∈ indices,
          ‖F n x‖ ^ (2 : ℕ) * ∫ t : Real, ‖g n t‖ ^ (2 : ℕ) :=
      integral_mono hleft_integrable hright_integrable hslice
    _ = C * ∑ n ∈ indices,
        (∫ x : Euclidean 2, ‖F n x‖ ^ (2 : ℕ)) *
          (∫ t : Real, ‖g n t‖ ^ (2 : ℕ)) := by
      rw [integral_const_mul, integral_finsetSum]
      · congr 1
        apply Finset.sum_congr rfl
        intro n hn
        rw [integral_mul_const]
      · intro n hn
        exact (hF_integrable n).mul_const _

/-- A literal finite space--time `L²` endpoint for the varying-spatial
separable family from the mixed vertical Fourier identity.  The proof uses
the same exact physical tensor representation, so it does not assert a
continuum `verticalRecombination` estimate. -/
theorem integral_norm_sq_verticalRecombined_verticalSeparablePackets_le_of_schwartz_profiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex) {C : Real}
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ) ≤ C)
    (F : Int → SchwartzMap (Euclidean 2) Complex) :
    (∫ z : WaveSpaceTime,
      ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) ≤
      C * ∑ n ∈ indices,
        (∫ x : Euclidean 2, ‖F n x‖ ^ (2 : ℕ)) *
          (∫ t : Real, ‖g n t‖ ^ (2 : ℕ)) := by
  have hintegrable :=
    aux_integrable_norm_sq_verticalRecombined_verticalSeparablePackets_of_profiles
      β scale indices m g hprofile F
  have hiterated :=
    aux_iterated_integral_norm_sq_verticalRecombined_verticalSeparablePackets_le
      β scale indices m g hprofile hoverlap F
  calc
    (∫ z : WaveSpaceTime,
        ‖verticalRecombined β scale indices
          (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) =
        ∫ x : Euclidean 2, ∫ t : Real,
          ‖verticalRecombined β scale indices
            (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) (x, t)‖ ^
              (2 : ℕ) := by
      rw [Measure.volume_eq_prod]
      exact integral_prod _ (by
        simpa only [Measure.volume_eq_prod] using hintegrable)
    _ ≤ C * ∑ n ∈ indices,
        (∫ x : Euclidean 2, ‖F n x‖ ^ (2 : ℕ)) *
          (∫ t : Real, ‖g n t‖ ^ (2 : ℕ)) := hiterated

/-- Input-energy form of the literal finite tensor `L²` endpoint. -/
theorem integral_norm_sq_verticalRecombined_verticalSeparablePackets_le_sum_inputEnergy_of_schwartz_profiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex) {C : Real}
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ) ≤ C)
    (F : Int → SchwartzMap (Euclidean 2) Complex) :
    (∫ z : WaveSpaceTime,
      ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) ≤
      C * ∑ n ∈ indices, ∫ z : WaveSpaceTime,
        ‖verticalSeparablePacket (F n) (g n : Real → Complex) z‖ ^ (2 : ℕ) := by
  calc
    (∫ z : WaveSpaceTime,
        ‖verticalRecombined β scale indices
          (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) ≤
        C * ∑ n ∈ indices,
          (∫ x : Euclidean 2, ‖F n x‖ ^ (2 : ℕ)) *
            (∫ t : Real, ‖g n t‖ ^ (2 : ℕ)) :=
      integral_norm_sq_verticalRecombined_verticalSeparablePackets_le_of_schwartz_profiles
        β scale indices m g hprofile hoverlap F
    _ = C * ∑ n ∈ indices, ∫ z : WaveSpaceTime,
        ‖verticalSeparablePacket (F n) (g n : Real → Complex) z‖ ^ (2 : ℕ) := by
      congr 1
      apply Finset.sum_congr rfl
      intro n hn
      exact (aux_integral_norm_sq_verticalSeparablePacket_eq_product (F n) (g n)).symm

/-- Pointwise Cauchy--Schwarz for a finite literal separable vertical
recombination.  This is the common physical-space core of the `L²` and
`L∞` finite packet endpoints below. -/
private theorem aux_norm_verticalRecombined_verticalSeparablePackets_le_temporal_spatial
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → Real → Complex)
    (z : WaveSpaceTime) :
    ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n)) z‖ ≤
      Real.sqrt (∑ n ∈ indices,
        ‖verticalTemporalProjection β scale n (g n) z.2‖ ^ (2 : Nat)) *
        Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) := by
  rw [verticalRecombined_verticalSeparablePackets]
  calc
    ‖∑ n ∈ indices,
        verticalTemporalProjection β scale n (g n) z.2 * F n z.1‖ ≤
        ∑ n ∈ indices,
          ‖verticalTemporalProjection β scale n (g n) z.2 * F n z.1‖ :=
      norm_sum_le _ _
    _ = ∑ n ∈ indices,
        ‖verticalTemporalProjection β scale n (g n) z.2‖ * ‖F n z.1‖ := by
      apply Finset.sum_congr rfl
      intro n hn
      rw [norm_mul]
    _ ≤ Real.sqrt (∑ n ∈ indices,
        ‖verticalTemporalProjection β scale n (g n) z.2‖ ^ (2 : Nat)) *
        Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) :=
      Real.sum_mul_le_sqrt_mul_sqrt indices
        (fun n => ‖verticalTemporalProjection β scale n (g n) z.2‖)
        (fun n => ‖F n z.1‖)

/-- Finite separable-packet endpoint from an explicit pointwise square bound
for the actual one-dimensional vertical outputs.  It is deliberately a
literal finite statement, so a later kernel estimate can be paired with the
already proved Fourier-overlap `L²` endpoint for real interpolation. -/
theorem norm_verticalRecombined_verticalSeparablePackets_le_of_temporal_square_bound
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → Real → Complex) {B : Real}
    (hB : 0 ≤ B)
    (htemporal : ∀ t : Real, ∑ n ∈ indices,
      ‖verticalTemporalProjection β scale n (g n) t‖ ^ (2 : Nat) ≤ B ^ (2 : Nat))
    (z : WaveSpaceTime) :
    ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n)) z‖ ≤
      B * Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) := by
  have hsqrt : Real.sqrt (∑ n ∈ indices,
      ‖verticalTemporalProjection β scale n (g n) z.2‖ ^ (2 : Nat)) ≤ B :=
    (Real.sqrt_le_left hB).mpr (htemporal z.2)
  calc
    ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n)) z‖ ≤
      Real.sqrt (∑ n ∈ indices,
        ‖verticalTemporalProjection β scale n (g n) z.2‖ ^ (2 : Nat)) *
        Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) :=
      aux_norm_verticalRecombined_verticalSeparablePackets_le_temporal_spatial
        β scale indices F g z
    _ ≤ B * Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) :=
      mul_le_mul_of_nonneg_right hsqrt (Real.sqrt_nonneg _)

/-- A finite common-time-kernel endpoint for literal separable vertical
packets.  The supplied `m n` are actual Schwartz representatives of the
translated multiplier profiles.  The hypothesis `hkernel` is a literal
inverse-Fourier time-kernel envelope with one common nonnegative function
`κ`, and explicit finite coefficients `a n`; no continuum vertical
recombination or half-wave packet is asserted here. -/
theorem norm_verticalRecombined_verticalSeparablePackets_le_of_schwartz_profiles_of_common_time_kernel
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (κ : Real → Real) (a : Int → Real)
    (hκ : ∀ t : Real, 0 ≤ κ t)
    (hkernel : ∀ n ∈ indices, ∀ t : Real,
      ‖𝓕⁻ (fun τ : Real => m n τ * 𝓕 (g n : Real → Complex) τ) t‖ ≤
        κ t * a n)
    (z : WaveSpaceTime) :
    ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ≤
      κ z.2 * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) *
        Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) := by
  have hprojection (n : Int) (hn : n ∈ indices) (t : Real) :
      verticalTemporalProjection β scale n (g n : Real → Complex) t =
        𝓕⁻ (fun τ : Real => m n τ * 𝓕 (g n : Real → Complex) τ) t := by
    unfold verticalTemporalProjection
    apply congrArg (fun q : Real → Complex => 𝓕⁻ q t)
    funext τ
    rw [← hprofile n hn τ]
  rw [verticalRecombined_verticalSeparablePackets]
  calc
    ‖∑ n ∈ indices,
        verticalTemporalProjection β scale n (g n : Real → Complex) z.2 * F n z.1‖ ≤
        ∑ n ∈ indices,
          ‖verticalTemporalProjection β scale n (g n : Real → Complex) z.2 * F n z.1‖ :=
      norm_sum_le _ _
    _ = ∑ n ∈ indices,
        ‖verticalTemporalProjection β scale n (g n : Real → Complex) z.2‖ * ‖F n z.1‖ := by
      apply Finset.sum_congr rfl
      intro n hn
      rw [norm_mul]
    _ ≤ ∑ n ∈ indices, (κ z.2 * a n) * ‖F n z.1‖ := by
      apply Finset.sum_le_sum
      intro n hn
      exact mul_le_mul_of_nonneg_right (by
        rw [hprojection n hn z.2]
        exact hkernel n hn z.2) (norm_nonneg _)
    _ = κ z.2 * ∑ n ∈ indices, a n * ‖F n z.1‖ := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro n hn
      ring
    _ ≤ κ z.2 *
        (Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) *
          Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat))) := by
      exact mul_le_mul_of_nonneg_left
        (Real.sum_mul_le_sqrt_mul_sqrt indices a (fun n => ‖F n z.1‖))
        (hκ z.2)
    _ = κ z.2 * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) *
        Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) := by ring

/-- Uniform spatial and time envelopes turn the previous finite
common-time-kernel theorem into its literal pointwise `L∞` form. -/
theorem norm_verticalRecombined_verticalSeparablePackets_le_of_schwartz_profiles_of_common_time_kernel_and_spatial_envelope
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (κ : Real → Real) (a : Int → Real) {A B : Real}
    (hA : 0 ≤ A) (hκ : ∀ t : Real, 0 ≤ κ t)
    (hκbound : ∀ t : Real, κ t ≤ B)
    (hkernel : ∀ n ∈ indices, ∀ t : Real,
      ‖𝓕⁻ (fun τ : Real => m n τ * 𝓕 (g n : Real → Complex) τ) t‖ ≤
        κ t * a n)
    (hspatial : ∀ x : Euclidean 2, ∑ n ∈ indices,
      ‖F n x‖ ^ (2 : Nat) ≤ A ^ (2 : Nat))
    (z : WaveSpaceTime) :
    ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ≤
      B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) * A := by
  have hspatial_sqrt : Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) ≤ A :=
    (Real.sqrt_le_left hA).mpr (hspatial z.1)
  have hcoeff_nonneg : 0 ≤ Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) :=
    Real.sqrt_nonneg _
  have htemporal : κ z.2 * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) ≤
      B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) :=
    mul_le_mul_of_nonneg_right (hκbound z.2) hcoeff_nonneg
  calc
    ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ≤
      (κ z.2 * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat))) *
        Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) := by
      exact norm_verticalRecombined_verticalSeparablePackets_le_of_schwartz_profiles_of_common_time_kernel
        β scale indices m g hprofile F κ a hκ hkernel z
    _ ≤ (B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat))) *
        Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) :=
      mul_le_mul_of_nonneg_right htemporal (Real.sqrt_nonneg _)
    _ ≤ (B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat))) * A := by
      have hleft_nonneg : 0 ≤ B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) := by
        have : 0 ≤ B := le_trans (hκ z.2) (hκbound z.2)
        positivity
      exact mul_le_mul_of_nonneg_left hspatial_sqrt hleft_nonneg
    _ = B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) * A := by ring

/-- The Schwartz-profile hypotheses make the literal finite vertical output
measurable.  This is kept separate from the `L²` estimate so the following
interpolation theorem applies to the actual `verticalRecombined` function,
rather than to a packaged endpoint proposition. -/
private theorem aux_aestronglyMeasurable_verticalRecombined_verticalSeparablePackets_of_profiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : Int → SchwartzMap (Euclidean 2) Complex) :
    AEStronglyMeasurable
      (verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex))) volume := by
  classical
  let h : Int → SchwartzMap Real Complex := fun n =>
    aux_verticalTemporalOutputProfile (m n) (g n)
  have hvertical (n : Int) (hn : n ∈ indices) (t : Real) :
      verticalTemporalProjection β scale n (g n : Real → Complex) t = h n t := by
    exact aux_verticalTemporalProjection_eq_outputProfile β scale n (m n) (g n)
      (hprofile n hn) t
  have houtput (z : WaveSpaceTime) :
      verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z =
        ∑ n ∈ indices, h n z.2 * F n z.1 := by
    rw [verticalRecombined_verticalSeparablePackets]
    apply Finset.sum_congr rfl
    intro n hn
    rw [hvertical n hn z.2]
  have hcont : Continuous (fun z : WaveSpaceTime =>
      ∑ n ∈ indices, h n z.2 * F n z.1) := by
    apply continuous_finsetSum
    intro n hn
    exact ((h n).continuous.comp continuous_snd).mul
      ((F n).continuous.comp continuous_fst)
  rw [show verticalRecombined β scale indices
      (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) =
      fun z : WaveSpaceTime => ∑ n ∈ indices, h n z.2 * F n z.1 by
        funext z
        exact houtput z]
  exact hcont.aestronglyMeasurable

/-- A literal finite tensor `L²`--`L⁴`--`L∞` interpolation estimate for the
actual vertical recombination.  The `L²` factor is the proved Fourier-overlap
bound on the supplied Schwartz multiplier profiles, and the `L∞` factor is
the explicit common-time-kernel/spatial-envelope bound.  Thus the conclusion
is finite and packet-level; it makes no continuum recombination claim. -/
theorem eLpNorm_four_rpow_two_verticalRecombined_verticalSeparablePackets_le_of_schwartz_profiles_of_common_time_kernel_and_spatial_envelope
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex) {C : Real}
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ) ≤ C)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (κ : Real → Real) (a : Int → Real) {A B : Real}
    (hA : 0 ≤ A) (hκ : ∀ t : Real, 0 ≤ κ t)
    (hκbound : ∀ t : Real, κ t ≤ B)
    (hkernel : ∀ n ∈ indices, ∀ t : Real,
      ‖𝓕⁻ (fun τ : Real => m n τ * 𝓕 (g n : Real → Complex) τ) t‖ ≤
        κ t * a n)
    (hspatial : ∀ x : Euclidean 2, ∑ n ∈ indices,
      ‖F n x‖ ^ (2 : ℕ) ≤ A ^ (2 : ℕ)) :
    (eLpNorm
      (verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)))
      (4 : ENNReal) volume) ^ (2 : Real) ≤
      ENNReal.ofReal (Real.sqrt (C * ∑ n ∈ indices, ∫ z : WaveSpaceTime,
        ‖verticalSeparablePacket (F n) (g n : Real → Complex) z‖ ^ (2 : ℕ))) *
        ENNReal.ofReal (B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : ℕ)) * A) := by
  let out : WaveSpaceTime → Complex :=
    verticalRecombined β scale indices
      (fun n => verticalSeparablePacket (F n) (g n : Real → Complex))
  let E : Real := ∑ n ∈ indices, ∫ z : WaveSpaceTime,
    ‖verticalSeparablePacket (F n) (g n : Real → Complex) z‖ ^ (2 : ℕ)
  let L : Real := B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : ℕ)) * A
  have houtmeas : AEStronglyMeasurable out volume := by
    dsimp only [out]
    exact aux_aestronglyMeasurable_verticalRecombined_verticalSeparablePackets_of_profiles
      β scale indices m g hprofile F
  have houtintegrable : Integrable (fun z : WaveSpaceTime => ‖out z‖ ^ (2 : ℕ)) volume := by
    dsimp only [out]
    exact aux_integrable_norm_sq_verticalRecombined_verticalSeparablePackets_of_profiles
      β scale indices m g hprofile F
  have houtmem : MemLp out 2 volume :=
    (memLp_two_iff_integrable_sq_norm houtmeas).mpr houtintegrable
  have hraw : (∫ z : WaveSpaceTime, ‖out z‖ ^ (2 : ℕ)) ≤ C * E := by
    dsimp only [out, E]
    exact
      integral_norm_sq_verticalRecombined_verticalSeparablePackets_le_sum_inputEnergy_of_schwartz_profiles
        β scale indices m g hprofile hoverlap F
  have htwo : eLpNorm out (2 : ENNReal) volume ≤
      ENNReal.ofReal (Real.sqrt (C * E)) := by
    rw [houtmem.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    apply ENNReal.ofReal_le_ofReal
    calc
      (∫ z : WaveSpaceTime, ‖out z‖ ^ (2 : Real)) ^ (2 : Real)⁻¹ =
          Real.sqrt (∫ z : WaveSpaceTime, ‖out z‖ ^ (2 : ℕ)) := by
        rw [Real.sqrt_eq_rpow]
        congr 1
        · apply integral_congr_ae
          filter_upwards with z
          exact Real.rpow_two _
        · norm_num
      _ ≤ Real.sqrt (C * E) := Real.sqrt_le_sqrt hraw
  have htop : eLpNorm out ⊤ volume ≤ ENNReal.ofReal L := by
    rw [eLpNorm_exponent_top]
    apply eLpNormEssSup_le_of_ae_bound
    filter_upwards with z
    dsimp only [out, L]
    exact
      norm_verticalRecombined_verticalSeparablePackets_le_of_schwartz_profiles_of_common_time_kernel_and_spatial_envelope
        β scale indices m g hprofile F κ a hA hκ hκbound hkernel hspatial z
  have hinterp := eLpNorm_four_rpow_two_le_two_mul_top out houtmeas
  change (eLpNorm out (4 : ENNReal) volume) ^ (2 : Real) ≤
    ENNReal.ofReal (Real.sqrt (C * E)) * ENNReal.ofReal L
  exact hinterp.trans (mul_le_mul htwo htop bot_le (by simp))

/-- The literal radial--time reconstruction is the vertical recombination of
its conic radial pieces.  This identifies the finite-packet-to-continuum
vertical estimate with the reconstruction term used by the MSS decomposition. -/
theorem radialTimeReconstruction_eq_verticalRecombined
    (verticalCutoff radialCutoff : Real → Complex) (indices : Real → Finset Int)
    (scale : Real) (a : Euclidean 2 → Complex) (ϑ : Real → Complex)
    (f : Euclidean 2 → Complex) :
    radialTimeReconstruction verticalCutoff radialCutoff indices scale a ϑ f =
      verticalRecombined verticalCutoff scale (indices scale)
        (fun n => conicOperator scale a ϑ (radialPiece radialCutoff scale n f)) := rfl

/-- The honest finite-family Minkowski estimate for vertical recombination.
It makes no claim about the norm of a vertical projection; those individual
measurability hypotheses are kept explicit. -/
theorem eLpNorm_verticalRecombined_le_sum
    (verticalCutoff : Real → Complex) (scale : Real) (indices : Finset Int)
    (H : Int → WaveSpaceTime → Complex) (p : ENNReal)
    (hmeas : ∀ n ∈ indices,
      AEStronglyMeasurable (verticalProjection verticalCutoff scale n (H n)) volume)
    (hp : 1 ≤ p) :
    eLpNorm (verticalRecombined verticalCutoff scale indices H) p volume ≤
      ∑ n ∈ indices, eLpNorm (verticalProjection verticalCutoff scale n (H n)) p volume := by
  calc
    eLpNorm (verticalRecombined verticalCutoff scale indices H) p volume =
        eLpNorm (∑ n ∈ indices, verticalProjection verticalCutoff scale n (H n)) p volume := by
      apply eLpNorm_congr_ae
      filter_upwards with z
      simp [verticalRecombined]
    _ ≤ ∑ n ∈ indices, eLpNorm (verticalProjection verticalCutoff scale n (H n)) p volume :=
      eLpNorm_sum_le (f := fun n => verticalProjection verticalCutoff scale n (H n))
        (s := indices) hmeas hp

/-- If every vertical projection has a common `Lᵖ` bound, finite
recombination costs at most the cardinality of its index family. -/
theorem eLpNorm_verticalRecombined_le_card_nsmul_of_bound
    (verticalCutoff : Real → Complex) (scale : Real) (indices : Finset Int)
    (H : Int → WaveSpaceTime → Complex) (p B : ENNReal)
    (hmeas : ∀ n ∈ indices,
      AEStronglyMeasurable (verticalProjection verticalCutoff scale n (H n)) volume)
    (hp : 1 ≤ p)
    (hbound : ∀ n ∈ indices,
      eLpNorm (verticalProjection verticalCutoff scale n (H n)) p volume ≤ B) :
    eLpNorm (verticalRecombined verticalCutoff scale indices H) p volume ≤
      indices.card • B := by
  calc
    eLpNorm (verticalRecombined verticalCutoff scale indices H) p volume ≤
        ∑ n ∈ indices, eLpNorm (verticalProjection verticalCutoff scale n (H n)) p volume :=
      eLpNorm_verticalRecombined_le_sum verticalCutoff scale indices H p hmeas hp
    _ ≤ ∑ _n ∈ indices, B :=
      Finset.sum_le_sum fun n hn => hbound n hn
    _ = indices.card • B := by simp

/-- Applying the finite Minkowski estimate to the explicit relevant radial
family gives a completely concrete scale-dependent finite count. -/
theorem eLpNorm_verticalRecombined_relevantRadialIndexEnumeration_le_of_bound
    (verticalCutoff : Real → Complex) (scale : Real)
    (H : Int → WaveSpaceTime → Complex) (p B : ENNReal)
    (hmeas : ∀ n ∈ relevantRadialIndexEnumeration scale,
      AEStronglyMeasurable
        (verticalProjection verticalCutoff scale n (H n)) volume)
    (hp : 1 ≤ p)
    (hbound : ∀ n ∈ relevantRadialIndexEnumeration scale,
      eLpNorm (verticalProjection verticalCutoff scale n (H n)) p volume ≤ B) :
    eLpNorm
        (verticalRecombined verticalCutoff scale (relevantRadialIndexEnumeration scale) H)
        p volume ≤
      (2 * ⌈Real.sqrt scale⌉₊ + 7) • B := by
  calc
    eLpNorm
        (verticalRecombined verticalCutoff scale (relevantRadialIndexEnumeration scale) H)
        p volume ≤ (relevantRadialIndexEnumeration scale).card • B :=
      eLpNorm_verticalRecombined_le_card_nsmul_of_bound verticalCutoff scale
        (relevantRadialIndexEnumeration scale) H p B hmeas hp hbound
    _ ≤ (2 * ⌈Real.sqrt scale⌉₊ + 7) • B :=
      nsmul_le_nsmul_left (by positivity : 0 ≤ B)
        (card_relevantRadialIndexEnumeration_le_two_mul_natCeil_sqrt_add_seven scale)

/-- A pointwise-envelope form of the finite recombination estimate. -/
theorem norm_verticalRecombined_le_card_nsmul_of_pointwise_bound
    (verticalCutoff : Real → Complex) (scale : Real) (indices : Finset Int)
    (H : Int → WaveSpaceTime → Complex) (B : WaveSpaceTime → Real)
    (hbound : ∀ n ∈ indices, ∀ z : WaveSpaceTime,
      ‖verticalProjection verticalCutoff scale n (H n) z‖ ≤ B z)
    (z : WaveSpaceTime) :
    ‖verticalRecombined verticalCutoff scale indices H z‖ ≤ indices.card • B z := by
  calc
    ‖verticalRecombined verticalCutoff scale indices H z‖ =
        ‖∑ n ∈ indices, verticalProjection verticalCutoff scale n (H n) z‖ := rfl
    _ ≤ ∑ n ∈ indices, ‖verticalProjection verticalCutoff scale n (H n) z‖ :=
      norm_sum_le _ _
    _ ≤ ∑ _n ∈ indices, B z :=
      Finset.sum_le_sum fun n hn => hbound n hn z
    _ = indices.card • B z := by simp

/-- The exponent supplied by vertical recombination.  The `∞` branch is the
endpoint exponent `1/4`; the other branch is the finite-`Lp` formula. -/
def verticalRecombinationGain (p : ENNReal) : Real :=
  if p = ⊤ then 1 / 4 else 1 / 4 - 1 / (2 * p.toReal)

/-- The vertical recombination target, including both the finite and
`L∞` exponents.  It is left as a proposition because its proof is precisely
where the vector-valued Riesz--Thorin step is needed. -/
def verticalRecombination (verticalCutoff : Real → Complex) : Prop :=
  ∀ (p : ENNReal) (C₀ : Real), ENNReal.ofReal 2 ≤ p → 0 < C₀ →
    ∃ C : Real, 0 < C ∧ ∀ scale : Real, 2 ≤ scale →
      ∀ indices : Finset Int,
        (indices.card : Real) ≤ C₀ * Real.sqrt scale →
        ∀ H : Int → WaveSpaceTime → Complex,
          eLpNorm (verticalRecombined verticalCutoff scale indices H) p volume ≤
            ENNReal.ofReal (C * scale ^ verticalRecombinationGain p) *
              eLpNorm (verticalSquareFunction indices H) p volume

/-- A literal `L⁴` finite-packet-to-continuum transfer for vertical
recombination.  Each `packets k` is an actual family of space--time
functions, rather than an abstract finite-model output.  Thus a concrete
packet construction can supply its uniform finite-packet estimate and the
two displayed `L⁴` convergences, and this theorem closes the passage to the
literal Fourier-multiplier recombination.

This does not assert that such a packet construction exists.  To use it for
the MSS proof, one still has to construct finite measurable packet families
representing `verticalProjection`, prove their uniform vector-valued `L⁴`
bound (via a genuine `L²`--`L∞` analytic interpolation datum, not the
counting-measure proxy), and establish both convergences below. -/
theorem eLpNorm_verticalRecombined_le_of_tendsto_eLpNorm
    (verticalCutoff : Real → Complex) (scale : Real) (indices : Finset Int)
    (H : Int → WaveSpaceTime → Complex)
    (packets : Nat → Int → WaveSpaceTime → Complex) (A : ENNReal) (hA : A ≠ ∞)
    (houtput_meas : AEStronglyMeasurable
      (verticalRecombined verticalCutoff scale indices H) volume)
    (hpacket_output_meas : ∀ k, AEStronglyMeasurable
      (verticalRecombined verticalCutoff scale indices (packets k)) volume)
    (hsquare_meas : AEStronglyMeasurable (verticalSquareFunction indices H) volume)
    (hpacket_square_meas : ∀ k, AEStronglyMeasurable
      (verticalSquareFunction indices (packets k)) volume)
    (hpacket_bound : ∀ k,
      eLpNorm (verticalRecombined verticalCutoff scale indices (packets k))
          (4 : ENNReal) volume ≤
        A * eLpNorm (verticalSquareFunction indices (packets k)) (4 : ENNReal) volume)
    (houtput_tendsto : Tendsto (fun k =>
      eLpNorm
        (verticalRecombined verticalCutoff scale indices (packets k) -
          verticalRecombined verticalCutoff scale indices H)
        (4 : ENNReal) volume) atTop (𝓝 0))
    (hsquare_tendsto : Tendsto (fun k =>
      eLpNorm
        (verticalSquareFunction indices (packets k) - verticalSquareFunction indices H)
        (4 : ENNReal) volume) atTop (𝓝 0)) :
    eLpNorm (verticalRecombined verticalCutoff scale indices H) (4 : ENNReal) volume ≤
      A * eLpNorm (verticalSquareFunction indices H) (4 : ENNReal) volume := by
  let P : ENNReal := eLpNorm
    (verticalRecombined verticalCutoff scale indices H) (4 : ENNReal) volume
  let S : ENNReal := eLpNorm (verticalSquareFunction indices H) (4 : ENNReal) volume
  let eout : Nat → ENNReal := fun k => eLpNorm
    (verticalRecombined verticalCutoff scale indices (packets k) -
      verticalRecombined verticalCutoff scale indices H)
    (4 : ENNReal) volume
  let esq : Nat → ENNReal := fun k => eLpNorm
    (verticalSquareFunction indices (packets k) - verticalSquareFunction indices H)
    (4 : ENNReal) volume
  have hp : (1 : ENNReal) ≤ (4 : ENNReal) := by norm_num
  have hpoint : ∀ k, P ≤ eout k + A * (esq k + S) := by
    intro k
    dsimp only [P, eout, esq, S]
    have houtput_triangle :
        eLpNorm (verticalRecombined verticalCutoff scale indices H) (4 : ENNReal) volume ≤
          eLpNorm
              (verticalRecombined verticalCutoff scale indices (packets k) -
                verticalRecombined verticalCutoff scale indices H)
              (4 : ENNReal) volume +
            eLpNorm (verticalRecombined verticalCutoff scale indices (packets k))
              (4 : ENNReal) volume := by
      calc
        eLpNorm (verticalRecombined verticalCutoff scale indices H) (4 : ENNReal) volume =
            eLpNorm
              ((verticalRecombined verticalCutoff scale indices H -
                verticalRecombined verticalCutoff scale indices (packets k)) +
                verticalRecombined verticalCutoff scale indices (packets k))
              (4 : ENNReal) volume := by
          congr 1
          ext z
          simp
        _ ≤ eLpNorm
              (verticalRecombined verticalCutoff scale indices H -
                verticalRecombined verticalCutoff scale indices (packets k))
              (4 : ENNReal) volume +
            eLpNorm (verticalRecombined verticalCutoff scale indices (packets k))
              (4 : ENNReal) volume :=
          eLpNorm_add_le (houtput_meas.sub (hpacket_output_meas k))
            (hpacket_output_meas k) hp
        _ = eLpNorm
              (verticalRecombined verticalCutoff scale indices (packets k) -
                verticalRecombined verticalCutoff scale indices H)
              (4 : ENNReal) volume +
            eLpNorm (verticalRecombined verticalCutoff scale indices (packets k))
              (4 : ENNReal) volume := by
          have hneg :
              verticalRecombined verticalCutoff scale indices H -
                  verticalRecombined verticalCutoff scale indices (packets k) =
                -(verticalRecombined verticalCutoff scale indices (packets k) -
                  verticalRecombined verticalCutoff scale indices H) := by
            ext z
            simp
          rw [hneg, eLpNorm_neg]
    calc
      eLpNorm (verticalRecombined verticalCutoff scale indices H) (4 : ENNReal) volume ≤
          eLpNorm
              (verticalRecombined verticalCutoff scale indices (packets k) -
                verticalRecombined verticalCutoff scale indices H)
              (4 : ENNReal) volume +
            eLpNorm (verticalRecombined verticalCutoff scale indices (packets k))
              (4 : ENNReal) volume := houtput_triangle
      _ ≤ eLpNorm
              (verticalRecombined verticalCutoff scale indices (packets k) -
                verticalRecombined verticalCutoff scale indices H)
              (4 : ENNReal) volume +
            A * eLpNorm (verticalSquareFunction indices (packets k))
              (4 : ENNReal) volume := by
        gcongr
        exact hpacket_bound k
      _ ≤ eLpNorm
              (verticalRecombined verticalCutoff scale indices (packets k) -
                verticalRecombined verticalCutoff scale indices H)
              (4 : ENNReal) volume +
            A * (eLpNorm
              (verticalSquareFunction indices (packets k) - verticalSquareFunction indices H)
              (4 : ENNReal) volume +
              eLpNorm (verticalSquareFunction indices H) (4 : ENNReal) volume) := by
        gcongr
        have hsquare_triangle :
            eLpNorm (verticalSquareFunction indices (packets k)) (4 : ENNReal) volume ≤
              eLpNorm
                  (verticalSquareFunction indices (packets k) - verticalSquareFunction indices H)
                  (4 : ENNReal) volume +
                eLpNorm (verticalSquareFunction indices H) (4 : ENNReal) volume := by
          calc
            eLpNorm (verticalSquareFunction indices (packets k)) (4 : ENNReal) volume =
                eLpNorm
                  ((verticalSquareFunction indices (packets k) - verticalSquareFunction indices H) +
                    verticalSquareFunction indices H)
                  (4 : ENNReal) volume := by
              congr 1
              ext z
              simp
            _ ≤ eLpNorm
                  (verticalSquareFunction indices (packets k) - verticalSquareFunction indices H)
                  (4 : ENNReal) volume +
                eLpNorm (verticalSquareFunction indices H) (4 : ENNReal) volume :=
              eLpNorm_add_le ((hpacket_square_meas k).sub hsquare_meas) hsquare_meas hp
        exact hsquare_triangle
  have heout : Tendsto eout atTop (𝓝 0) := by
    simpa only [eout] using houtput_tendsto
  have hesq : Tendsto esq atTop (𝓝 0) := by
    simpa only [esq] using hsquare_tendsto
  have hright : Tendsto (fun k => eout k + A * (esq k + S)) atTop (𝓝 (A * S)) := by
    have hsq_plus : Tendsto (fun k => esq k + S) atTop (𝓝 (0 + S)) :=
      hesq.add (tendsto_const_nhds : Tendsto (fun _ : Nat => S) atTop (𝓝 S))
    have hmul : Tendsto (fun k => A * (esq k + S)) atTop (𝓝 (A * (0 + S))) :=
      ENNReal.Tendsto.const_mul hsq_plus (Or.inr hA)
    simpa using heout.add hmul
  have hle : P ≤ A * S := ge_of_tendsto hright (Eventually.of_forall hpoint)
  simpa only [P, S] using hle

/-- The angularly localized summand of the conic half-wave operator. -/
noncomputable def angularPiece (scale : Real) (a χ : Euclidean 2 → Complex)
    (ϑ : Real → Complex) (f : Euclidean 2 → Complex) :
    WaveSpaceTime → Complex :=
  fun z => ϑ z.2 * 𝓕⁻ (fun ξ =>
    χ ξ * a (scale⁻¹ • ξ) * halfWaveMultiplier WaveSign.plus z.2 ξ * 𝓕 f ξ) z.1

/-- A metric encoding of an angular sector around a unit direction.  This
avoids choosing polar coordinates while expressing the aperture used in the
conic-plate definitions. -/
def angularSector (direction : Euclidean 2) (aperture : Real) : Set (Euclidean 2) :=
  {ξ | ξ ≠ 0 ∧ ‖(‖ξ‖)⁻¹ • ξ - direction‖ ≤ aperture}

/-- The geometric data carried by an angular partition at one frequency
scale.  The centers are unit directions in one fixed narrow sector and their
chordal distances are uniformly comparable to the scaled differences of
their consecutive integer labels.  The three constants are fixed before the
plate-overlap statement, so its constants may depend on this angular
partition geometry but not on the scale or the chosen finite subfamily. -/
def angularSectorGeometry (scale : Real) (indices : Finset Int)
    (directions : Int → Euclidean 2)
    (sectorRadius spacingLower spacingUpper : Real) : Prop :=
  0 < sectorRadius ∧ sectorRadius ≤ 1 / 4 ∧
  0 < spacingLower ∧ 0 < spacingUpper ∧
  ∃ center : Euclidean 2, ‖center‖ = 1 ∧
    ∀ ν ∈ indices, ‖directions ν‖ = 1 ∧
      ‖directions ν - center‖ ≤ sectorRadius ∧
      ∀ ν' ∈ indices,
        spacingLower * ((ν - ν').natAbs : Real) *
            scale ^ (-(1 / 2 : Real)) ≤ ‖directions ν - directions ν'‖ ∧
        ‖directions ν - directions ν'‖ ≤
          spacingUpper * ((ν - ν').natAbs : Real) *
            scale ^ (-(1 / 2 : Real))

/-- The lower separation part of `angularSectorGeometry` makes the labelled
angular directions injective on the finite angular index set.  This is the
first exact finite-overlap input: distinct labels cannot denote the same
plate direction. -/
theorem angularSectorGeometry_direction_injective
    {scale sectorRadius spacingLower spacingUpper : Real} {indices : Finset Int}
    {directions : Int → Euclidean 2}
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    {ν ν' : Int} (hν : ν ∈ indices) (hν' : ν' ∈ indices)
    (hdirections : directions ν = directions ν') : ν = ν' := by
  rcases hgeometry with ⟨_, _, hspacingLower, _, center, hcenter, hdata⟩
  by_contra hne
  have hlabel : 0 < ((ν - ν').natAbs : Real) := by
    exact_mod_cast Int.natAbs_pos.mpr (sub_ne_zero.mpr hne)
  have hscalePow : 0 < scale ^ (-(1 / 2 : Real)) :=
    Real.rpow_pos_of_pos hscale _
  have hpositive : 0 <
      spacingLower * ((ν - ν').natAbs : Real) * scale ^ (-(1 / 2 : Real)) :=
    mul_pos (mul_pos hspacingLower hlabel) hscalePow
  have hseparation := ((hdata ν hν).2.2 ν' hν').1
  rw [hdirections, sub_self, norm_zero] at hseparation
  linarith

/-- The Fourier multiplier for a wave-front projection. -/
def wavefrontMultiplier (angularCutoff : Euclidean 2 → Complex)
    (normalCutoff : Real → Complex) (scale gamma : Real) :
    WaveSpaceTime → Complex :=
  fun ζ => angularCutoff ζ.1 *
    normalCutoff (scale ^ (-gamma) * (ζ.2 - ‖ζ.1‖))

/-- The literal wave-front Fourier projection `Q_ν^(scale,gamma)`. -/
noncomputable def wavefrontProjection (angularCutoff : Euclidean 2 → Complex)
    (normalCutoff : Real → Complex) (scale gamma : Real)
    (G : WaveSpaceTime → Complex) : WaveSpaceTime → Complex :=
  spaceTimeFourierInv (fun ζ =>
    wavefrontMultiplier angularCutoff normalCutoff scale gamma ζ *
      spaceTimeFourier G ζ)

/-- The conic plate supporting a wave-front localized radial/angular piece.
The angular sector is represented by normalized Euclidean distance from its
central direction, an equivalent concrete aperture convention. -/
def conicPlate (scale gamma angularConstant : Real) (n : Int)
    (direction : Euclidean 2) : Set WaveSpaceTime :=
  {ζ | scale / 4 ≤ ‖ζ.1‖ ∧ ‖ζ.1‖ ≤ 4 * scale ∧
    ζ.1 ∈ angularSector direction
      (angularConstant * scale ^ (-(1 / 2 : Real))) ∧
    |(Real.sqrt scale)⁻¹ * ζ.2 - n| ≤ 1 ∧
    |ζ.2 - ‖ζ.1‖| ≤ 2 * scale ^ gamma}

/-- A spectral tensor packet, localized in the radial label by the literal
vertical multiplier.  Its temporal factor is Schwartz; in particular this is
not a compact physical-time-cutoff half-wave. -/
noncomputable def spectralRadialNormalPacket
    (β : Real → Complex) (scale : Real) (n : Int)
    (F : SchwartzMap (Euclidean 2) Complex) (g : SchwartzMap Real Complex) :
    WaveSpaceTime → Complex :=
  verticalProjection β scale n (verticalSeparablePacket F (g : Real → Complex))

/-- The exact space-time Fourier multiplier formula for the literal spectral
tensor packet.  A Schwartz representative for the one-dimensional vertical
multiplier is the only regularity input. -/
theorem spaceTimeFourier_spectralRadialNormalPacket_of_schwartzProfile
    (β : Real → Complex) (scale : Real) (n : Int)
    (m g : SchwartzMap Real Complex)
    (hprofile : ∀ τ : Real, m τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : SchwartzMap (Euclidean 2) Complex) (ξ : Euclidean 2) (τ : Real) :
    spaceTimeFourier (spectralRadialNormalPacket β scale n F g) (ξ, τ) =
      verticalMultiplier β scale n (ξ, τ) *
        spaceTimeFourier (verticalSeparablePacket F (g : Real → Complex)) (ξ, τ) := by
  exact spaceTimeFourier_verticalProjection_verticalSeparablePacket_of_schwartzProfile
    β scale n m g hprofile F ξ τ

/-- Exact conic-plate support for a genuinely spectral Schwartz tensor
packet.  The normal condition is imposed on the joint spectral support;
there is deliberately no assertion for a compact physical-time cutoff. -/
theorem support_spaceTimeFourier_spectralRadialNormalPacket_subset_conicPlate
    (β : Real → Complex) (scale gamma angularConstant : Real) (n : Int)
    (direction : Euclidean 2)
    (m g : SchwartzMap Real Complex)
    (hprofile : ∀ τ : Real, m τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : SchwartzMap (Euclidean 2) Complex)
    (hspatial : Function.support (𝓕 (F : Euclidean 2 → Complex)) ⊆
      {ξ | scale / 4 ≤ ‖ξ‖ ∧ ‖ξ‖ ≤ 4 * scale ∧
        ξ ∈ angularSector direction (angularConstant * scale ^ (-(1 / 2 : Real)))})
    (hvertical : ∀ τ : Real,
      β ((Real.sqrt scale)⁻¹ * τ - n) ≠ 0 →
        |(Real.sqrt scale)⁻¹ * τ - n| ≤ 1)
    (hnormal : ∀ ξ : Euclidean 2,
      ξ ∈ Function.support (𝓕 (F : Euclidean 2 → Complex)) →
      ∀ τ : Real, τ ∈ Function.support (𝓕 (g : Real → Complex)) →
      β ((Real.sqrt scale)⁻¹ * τ - n) ≠ 0 →
        |τ - ‖ξ‖| ≤ 2 * scale ^ gamma) :
    Function.support (spaceTimeFourier (spectralRadialNormalPacket β scale n F g)) ⊆
      conicPlate scale gamma angularConstant n direction := by
  intro ζ hζ
  change spaceTimeFourier (spectralRadialNormalPacket β scale n F g) ζ ≠ 0 at hζ
  rw [spaceTimeFourier_spectralRadialNormalPacket_of_schwartzProfile
    β scale n m g hprofile F ζ.1 ζ.2] at hζ
  rw [verticalMultiplier, spaceTimeFourier_verticalSeparablePacket] at hζ
  rcases mul_ne_zero_iff.mp hζ with ⟨hβ, hproduct⟩
  rcases mul_ne_zero_iff.mp hproduct with ⟨hF, hg⟩
  rcases hspatial hF with ⟨hlower, hupper, hangular⟩
  exact ⟨hlower, hupper, hangular, hvertical ζ.2 hβ,
    hnormal ζ.1 hF ζ.2 hg hβ⟩

/-- A spectral radial/normal packet whose spatial frequency factor is an
actual Schwartz cube multiplier.  The physical spatial factor is its inverse
Fourier transform, so this model interfaces directly with the finite cube
cutoffs while remaining spectral in time. -/
noncomputable def spectralCubeRadialNormalPacket
    (β : Real → Complex) (scale : Real) (n : Int)
    (cubeProfile : SchwartzMap (Euclidean 2) Complex)
    (g : SchwartzMap Real Complex) : WaveSpaceTime → Complex :=
  spectralRadialNormalPacket β scale n
    (𝓕⁻ cubeProfile : SchwartzMap (Euclidean 2) Complex) g

/-- Exact Fourier formula for the spectral packet built from a literal
Schwartz cube multiplier. -/
theorem spaceTimeFourier_spectralCubeRadialNormalPacket_of_schwartzProfile
    (β : Real → Complex) (scale : Real) (n : Int)
    (temporalProfile g : SchwartzMap Real Complex)
    (hprofile : ∀ τ : Real, temporalProfile τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (cubeProfile : SchwartzMap (Euclidean 2) Complex) (ξ : Euclidean 2) (τ : Real) :
    spaceTimeFourier
        (spectralCubeRadialNormalPacket β scale n cubeProfile g) (ξ, τ) =
      β ((Real.sqrt scale)⁻¹ * τ - n) *
        (cubeProfile ξ * 𝓕 (g : Real → Complex) τ) := by
  rw [spectralCubeRadialNormalPacket,
    spaceTimeFourier_spectralRadialNormalPacket_of_schwartzProfile
      β scale n temporalProfile g hprofile]
  rw [verticalMultiplier, spaceTimeFourier_verticalSeparablePacket]
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]

/-- An actual spectral cube packet has exact conic-plate support once the
cube profile and temporal Schwartz profile obey the displayed radial,
angular, vertical, and normal support conditions. -/
theorem support_spaceTimeFourier_spectralCubeRadialNormalPacket_subset_conicPlate
    (β : Real → Complex) (scale gamma angularConstant : Real) (n : Int)
    (direction : Euclidean 2)
    (temporalProfile g : SchwartzMap Real Complex)
    (hprofile : ∀ τ : Real, temporalProfile τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (cubeProfile : SchwartzMap (Euclidean 2) Complex)
    (hspatial : Function.support (cubeProfile : Euclidean 2 → Complex) ⊆
      {ξ | scale / 4 ≤ ‖ξ‖ ∧ ‖ξ‖ ≤ 4 * scale ∧
        ξ ∈ angularSector direction (angularConstant * scale ^ (-(1 / 2 : Real)))})
    (hvertical : ∀ τ : Real,
      β ((Real.sqrt scale)⁻¹ * τ - n) ≠ 0 →
        |(Real.sqrt scale)⁻¹ * τ - n| ≤ 1)
    (hnormal : ∀ ξ : Euclidean 2,
      ξ ∈ Function.support (cubeProfile : Euclidean 2 → Complex) →
      ∀ τ : Real, τ ∈ Function.support (𝓕 (g : Real → Complex)) →
      β ((Real.sqrt scale)⁻¹ * τ - n) ≠ 0 →
        |τ - ‖ξ‖| ≤ 2 * scale ^ gamma) :
    Function.support
        (spaceTimeFourier (spectralCubeRadialNormalPacket β scale n cubeProfile g)) ⊆
      conicPlate scale gamma angularConstant n direction := by
  intro ζ hζ
  change spaceTimeFourier
      (spectralCubeRadialNormalPacket β scale n cubeProfile g) ζ ≠ 0 at hζ
  rw [spaceTimeFourier_spectralCubeRadialNormalPacket_of_schwartzProfile
    β scale n temporalProfile g hprofile cubeProfile ζ.1 ζ.2] at hζ
  rcases mul_ne_zero_iff.mp hζ with ⟨hβ, hproduct⟩
  rcases mul_ne_zero_iff.mp hproduct with ⟨hcube, hg⟩
  rcases hspatial hcube with ⟨hlower, hupper, hangular⟩
  exact ⟨hlower, hupper, hangular, hvertical ζ.2 hβ,
    hnormal ζ.1 hcube ζ.2 hg hβ⟩

/-- The preceding literal spectral packets supply exactly the Fourier-support
premise required by `overlapSquareFunction`, simultaneously for a finite
radial/angular family. -/
theorem spectralCubeRadialNormalPackets_satisfy_conicPlateSupport
    (β : Real → Complex) (scale gamma angularConstant : Real)
    (radialIndices angularIndices : Finset Int) (directions : Int → Euclidean 2)
    (temporalProfiles g : Int → Int → SchwartzMap Real Complex)
    (cubeProfiles : Int → Int → SchwartzMap (Euclidean 2) Complex)
    (hprofile : ∀ n ∈ radialIndices, ∀ ν ∈ angularIndices, ∀ τ : Real,
      temporalProfiles n ν τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (hspatial : ∀ n ∈ radialIndices, ∀ ν ∈ angularIndices,
      Function.support (cubeProfiles n ν : Euclidean 2 → Complex) ⊆
        {ξ | scale / 4 ≤ ‖ξ‖ ∧ ‖ξ‖ ≤ 4 * scale ∧
          ξ ∈ angularSector (directions ν)
            (angularConstant * scale ^ (-(1 / 2 : Real)))})
    (hvertical : ∀ n ∈ radialIndices, ∀ τ : Real,
      β ((Real.sqrt scale)⁻¹ * τ - n) ≠ 0 →
        |(Real.sqrt scale)⁻¹ * τ - n| ≤ 1)
    (hnormal : ∀ n ∈ radialIndices, ∀ ν ∈ angularIndices,
      ∀ ξ : Euclidean 2,
      ξ ∈ Function.support (cubeProfiles n ν : Euclidean 2 → Complex) →
      ∀ τ : Real, τ ∈ Function.support (𝓕 (g n ν : Real → Complex)) →
      β ((Real.sqrt scale)⁻¹ * τ - n) ≠ 0 →
        |τ - ‖ξ‖| ≤ 2 * scale ^ gamma) :
    ∀ n ∈ radialIndices, ∀ ν ∈ angularIndices,
      Function.support
          (spaceTimeFourier
            (spectralCubeRadialNormalPacket β scale n (cubeProfiles n ν) (g n ν))) ⊆
        conicPlate scale gamma angularConstant n (directions ν) := by
  intro n hn ν hν
  exact support_spaceTimeFourier_spectralCubeRadialNormalPacket_subset_conicPlate
    β scale gamma angularConstant n (directions ν)
    (temporalProfiles n ν) (g n ν) (hprofile n hn ν hν)
    (cubeProfiles n ν) (hspatial n hn ν hν)
    (hvertical n hn) (hnormal n hn ν hν)

/-- The two-parameter square function used after wave-front localization. -/
noncomputable def angularRadialSquareFunction (radialIndices angularIndices : Finset Int)
    (H : Int → Int → WaveSpaceTime → Complex) : WaveSpaceTime → Real :=
  fun z => Real.sqrt (∑ n ∈ radialIndices, ∑ ν ∈ angularIndices, ‖H n ν z‖ ^ 2)

/-- The square function after recombining the angular pieces for each fixed
radial label.  It is the left-hand square function in the plate-overlap
consequence from the MSS blueprint. -/
noncomputable def aux_angularRadialRecombinedSquareFunction
    (radialIndices angularIndices : Finset Int)
    (H : Int → Int → WaveSpaceTime → Complex) : WaveSpaceTime → Real :=
  fun z => Real.sqrt (∑ n ∈ radialIndices, ‖∑ ν ∈ angularIndices, H n ν z‖ ^ 2)

/-- The vector-valued estimate removing the vertical projections from the
radial/angular square function.  This is the common-positive-kernel
Minkowski step in the MSS blueprint. -/
def removeVerticalProjections (verticalCutoff : Real → Complex) : Prop :=
  ∃ C : Real, 0 < C ∧ ∀ scale : Real, 2 ≤ scale →
    ∀ radialIndices angularIndices : Finset Int,
      ∀ H : Int → Int → WaveSpaceTime → Complex,
        eLpNorm
            (angularRadialSquareFunction radialIndices angularIndices
              (fun n ν => verticalProjection verticalCutoff scale n (H n ν)))
            (4 : ENNReal) volume ≤
          ENNReal.ofReal C *
            eLpNorm (angularRadialSquareFunction radialIndices angularIndices H)
              (4 : ENNReal) volume

/-- The radial, angular, and vertically localized half-wave summand before
wave-front projection. -/
noncomputable def angularRadialWave (verticalCutoff radialCutoff : Real → Complex)
    (angularCutoff : Int → Euclidean 2 → Complex) (scale : Real)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex) (n ν : Int)
    (f : Euclidean 2 → Complex) : WaveSpaceTime → Complex :=
  verticalProjection verticalCutoff scale n
    (angularPiece scale a (angularCutoff ν) ϑ
      (radialPiece radialCutoff scale n f))

/-- The wave-front projected version of an angular/radial half-wave summand. -/
noncomputable def wavefrontAngularRadialWave
    (verticalCutoff radialCutoff : Real → Complex)
    (angularCutoff wavefrontCutoff : Int → Euclidean 2 → Complex)
    (normalCutoff : Real → Complex) (scale gamma : Real)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex) (n ν : Int)
    (f : Euclidean 2 → Complex) : WaveSpaceTime → Complex :=
  wavefrontProjection (wavefrontCutoff ν) normalCutoff scale gamma
    (angularRadialWave verticalCutoff radialCutoff angularCutoff scale a ϑ n ν f)

/-- The quantitative wave-front localization target.  This is the rapidly
decaying square-function error in the blueprint, stated with finite radial
and angular index families. -/
def wavefrontLocalization (verticalCutoff radialCutoff : Real → Complex)
    (angularCutoff wavefrontCutoff : Int → Euclidean 2 → Complex)
    (normalCutoff : Real → Complex) (radialIndices angularIndices : Real → Finset Int)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex) (gamma : Real) : Prop :=
  ∀ N : Nat, ∃ C : Real, 0 < C ∧ ∀ scale : Real, 2 ≤ scale →
    ∀ f : SchwartzMap (Euclidean 2) Complex,
      eLpNorm
          (angularRadialSquareFunction (radialIndices scale) (angularIndices scale)
            (fun n ν =>
              fun z => angularRadialWave verticalCutoff radialCutoff angularCutoff
                  scale a ϑ n ν (f : Euclidean 2 → Complex) z -
                wavefrontAngularRadialWave verticalCutoff radialCutoff angularCutoff
                  wavefrontCutoff normalCutoff scale gamma a ϑ n ν
                    (f : Euclidean 2 → Complex) z))
          (ENNReal.ofReal 4) volume ≤
        ENNReal.ofReal (C * (scale⁻¹) ^ N) *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume

/-- The Fourier-support target for a wave-front localized summand. -/
def wavefrontPlateSupport (verticalCutoff radialCutoff : Real → Complex)
    (angularCutoff wavefrontCutoff : Int → Euclidean 2 → Complex)
    (normalCutoff : Real → Complex) (directions : Int → Euclidean 2)
    (angularConstant gamma : Real) (a : Euclidean 2 → Complex) (ϑ : Real → Complex) : Prop :=
  ∀ scale : Real, 2 ≤ scale → ∀ n ν : Int,
    ∀ f : SchwartzMap (Euclidean 2) Complex,
      Function.support
          (spaceTimeFourier
            (wavefrontAngularRadialWave verticalCutoff radialCutoff angularCutoff
              wavefrontCutoff normalCutoff scale gamma a ϑ n ν
                (f : Euclidean 2 → Complex))) ⊆
        conicPlate scale gamma angularConstant n (directions ν)

/-- The `k`th dyadic angular-separation relation on ordered angular indices. -/
def angularSeparationClass (k : Nat) (ν ν' : Int) : Prop :=
  if k = 0 then (ν - ν').natAbs ≤ 1 else
    2 ^ (k - 1) < (ν - ν').natAbs ∧ (ν - ν').natAbs ≤ 2 ^ k

/-- The finite set of angular pairs at one dyadic separation. -/
noncomputable def angularSeparationPairs (indices : Finset Int) (k : Nat) : Finset (Int × Int) := by
  classical
  exact (indices.product indices).filter
    (fun pair => angularSeparationClass k pair.1 pair.2)

/-- Membership in an angular-separation class is the literal conjunction of
membership in the angular index set and the dyadic separation condition. -/
theorem mem_angularSeparationPairs_iff (indices : Finset Int) (k : Nat)
    (pair : Int × Int) :
    pair ∈ angularSeparationPairs indices k ↔
      pair.1 ∈ indices ∧ pair.2 ∈ indices ∧
        angularSeparationClass k pair.1 pair.2 := by
  classical
  simp [angularSeparationPairs, and_assoc]

/-- At level zero, angular separation means that the two labels are adjacent. -/
theorem angularSeparationClass_zero_iff (m m' : Int) :
    angularSeparationClass 0 m m' ↔ (m - m').natAbs ≤ 1 := by
  simp [angularSeparationClass]

/-- At a positive level, angular separation lies in the corresponding dyadic
annulus of index differences. -/
theorem angularSeparationClass_succ_iff (k : Nat) (m m' : Int) :
    angularSeparationClass (k + 1) m m' ↔
      2 ^ k < (m - m').natAbs ∧ (m - m').natAbs ≤ 2 ^ (k + 1) := by
  simp [angularSeparationClass]

/-- Angular separation is symmetric in the two ordered labels. -/
theorem angularSeparationClass_comm (k : Nat) (m m' : Int) :
    angularSeparationClass k m m' ↔ angularSeparationClass k m' m := by
  have hdiff : (m' - m).natAbs = (m - m').natAbs := by
    rw [show m' - m = -(m - m') by ring, Int.natAbs_neg]
  simp only [angularSeparationClass]
  rw [hdiff]

/-- The finite family of ordered pairs at a fixed angular separation is
closed under swapping the two labels. -/
theorem mem_swap_angularSeparationPairs_iff (indices : Finset Int) (k : Nat)
    (m m' : Int) :
    (m', m) ∈ angularSeparationPairs indices k ↔
      (m, m') ∈ angularSeparationPairs indices k := by
  rw [mem_angularSeparationPairs_iff, mem_angularSeparationPairs_iff]
  constructor
  · rintro ⟨hm', hm, hsep⟩
    exact ⟨hm, hm', (angularSeparationClass_comm k m m').mpr hsep⟩
  · rintro ⟨hm, hm', hsep⟩
    exact ⟨hm', hm, (angularSeparationClass_comm k m m').mp hsep⟩

/-- Separation pairs are, in particular, pairs of elements of the original
finite angular index family. -/
theorem angularSeparationPairs_subset_product (indices : Finset Int) (k : Nat) :
    angularSeparationPairs indices k ⊆ indices.product indices := by
  classical
  rw [angularSeparationPairs]
  exact Finset.filter_subset _ _

/-- There are at most quadratically many ordered angular pairs at any one
separation level. -/
theorem card_angularSeparationPairs_le (indices : Finset Int) (k : Nat) :
    (angularSeparationPairs indices k).card ≤ indices.card ^ 2 := by
  classical
  calc
    (angularSeparationPairs indices k).card ≤ (indices.product indices).card :=
      Finset.card_le_card (angularSeparationPairs_subset_product indices k)
    _ = indices.card ^ 2 := by simp [pow_two]

/-- Finite Cauchy--Schwarz for the family of ordered angular pairs in one
separation class.  This is the purely algebraic input preceding the
geometric plate-overlap estimate. -/
theorem sq_sum_norm_angularSeparationPairs_le_card_mul_sum_sq
    (indices : Finset Int) (k : Nat)
    (F : Int × Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    (∑ pair ∈ angularSeparationPairs indices k, ‖F pair z‖) ^ 2 ≤
      ((angularSeparationPairs indices k).card : Real) *
        ∑ pair ∈ angularSeparationPairs indices k, ‖F pair z‖ ^ 2 :=
  sq_sum_le_card_mul_sum_sq

/-- The same finite Cauchy--Schwarz estimate with the elementary quadratic
bound on the number of angular pairs substituted in.  It has no geometric
plate-overlap hypothesis. -/
theorem sq_sum_norm_angularSeparationPairs_le_card_sq_mul_sum_sq
    (indices : Finset Int) (k : Nat)
    (F : Int × Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    (∑ pair ∈ angularSeparationPairs indices k, ‖F pair z‖) ^ 2 ≤
      (indices.card : Real) ^ 2 *
        ∑ pair ∈ angularSeparationPairs indices k, ‖F pair z‖ ^ 2 := by
  have hcard : ((angularSeparationPairs indices k).card : Real) ≤
      (indices.card : Real) ^ 2 := by
    exact_mod_cast card_angularSeparationPairs_le indices k
  have henergy : 0 ≤ ∑ pair ∈ angularSeparationPairs indices k, ‖F pair z‖ ^ 2 :=
    Finset.sum_nonneg fun pair hpair => sq_nonneg (‖F pair z‖)
  calc
    (∑ pair ∈ angularSeparationPairs indices k, ‖F pair z‖) ^ 2 ≤
        ((angularSeparationPairs indices k).card : Real) *
          ∑ pair ∈ angularSeparationPairs indices k, ‖F pair z‖ ^ 2 :=
      sq_sum_norm_angularSeparationPairs_le_card_mul_sum_sq indices k F z
    _ ≤ (indices.card : Real) ^ 2 *
        ∑ pair ∈ angularSeparationPairs indices k, ‖F pair z‖ ^ 2 :=
      mul_le_mul_of_nonneg_right hcard henergy

/-- Minkowski sum of two subsets of space--time frequency space. -/
def minkowskiSum (A B : Set WaveSpaceTime) : Set WaveSpaceTime :=
  {Z | ∃ z ∈ A, ∃ w ∈ B, z + w = Z}

/-- Membership in a Minkowski sum is its defining two-point decomposition. -/
theorem mem_minkowskiSum_iff (A B : Set WaveSpaceTime) (Z : WaveSpaceTime) :
    Z ∈ minkowskiSum A B ↔ ∃ z ∈ A, ∃ w ∈ B, z + w = Z := Iff.rfl

/-- Minkowski addition of frequency sets is commutative. -/
theorem minkowskiSum_comm (A B : Set WaveSpaceTime) :
    minkowskiSum A B = minkowskiSum B A := by
  ext Z
  constructor
  · rintro ⟨z, hz, w, hw, hzw⟩
    exact ⟨w, hw, z, hz, by simpa [add_comm] using hzw⟩
  · rintro ⟨w, hw, z, hz, hwz⟩
    exact ⟨z, hz, w, hw, by simpa [add_comm] using hwz⟩

/-- A finite set has cardinality at most two if, after choosing any two
distinct elements, every remaining element is one of those two.  This small
finite-combinatorial reduction lets the planar two-circle intersection fact
be applied directly to a finite overlap fiber. -/
theorem finset_card_le_two_of_forall_mem_eq_or_eq {α : Type*} [DecidableEq α]
    (s : Finset α)
    (h : ∀ a ∈ s, ∀ b ∈ s, a ≠ b → ∀ c ∈ s, c = a ∨ c = b) :
    s.card ≤ 2 := by
  classical
  by_cases hnonempty : s.Nonempty
  · obtain ⟨a, ha⟩ := hnonempty
    by_cases hsingle : ∀ b ∈ s, b = a
    · have hsubset : s ⊆ ({a} : Finset α) := by
        intro b hb
        simp [hsingle b hb]
      exact (Finset.card_le_card hsubset).trans (by simp)
    · obtain ⟨b, hb, hba⟩ : ∃ b, b ∈ s ∧ b ≠ a := by
        push Not at hsingle
        exact hsingle
      have hsubset : s ⊆ ({a, b} : Finset α) := by
        intro c hc
        rcases h a ha b hb (Ne.symm hba) c hc with hca | hcb
        · simp [hca]
        · simp [hcb]
      exact (Finset.card_le_card hsubset).trans Finset.card_le_two
  · have hs : s = ∅ := Finset.not_nonempty_iff_eq_empty.mp hnonempty
    simp [hs]

/-- The zero-normal-thickness, fixed-radius point at the center of a conic
plate.  This is the exact model in which the essential pair-sum injection can
be stated before controlling thick plates. -/
def zeroThicknessConicPoint (radius : Real) (direction : Euclidean 2) :
    WaveSpaceTime :=
  (radius • direction, radius)

/-- The zero-thickness, fixed-radius model conic plate. -/
def zeroThicknessConicPlate (radius : Real) (direction : Euclidean 2) :
    Set WaveSpaceTime :=
  {zeroThicknessConicPoint radius direction}

/-- The center of the Minkowski sum of two zero-thickness model plates. -/
def zeroThicknessPlatePairSum (radius radius' : Real)
    (directions : Int → Euclidean 2) (pair : Int × Int) : WaveSpaceTime :=
  zeroThicknessConicPoint radius (directions pair.1) +
    zeroThicknessConicPoint radius' (directions pair.2)

/-- Scaling a unit direction by a nonnegative radius has exactly that norm. -/
theorem norm_smul_unit_direction_of_nonneg {radius : Real}
    (hradius : 0 ≤ radius) {direction : Euclidean 2} (hdirection : ‖direction‖ = 1) :
    ‖radius • direction‖ = radius := by
  rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hradius, hdirection, mul_one]

/-- The spatial first summand in a zero-thickness pair sum lies on the
circle of its prescribed first radius. -/
theorem dist_zero_zeroThicknessPlatePairSum_first
    {radius : Real} {directions : Int → Euclidean 2} {pair : Int × Int}
    (hradius : 0 ≤ radius) (hdirection : ‖directions pair.1‖ = 1) :
    dist (radius • directions pair.1) 0 = radius := by
  rw [dist_zero_right]
  exact norm_smul_unit_direction_of_nonneg hradius hdirection

/-- The spatial first summand in a zero-thickness pair sum lies on the
circle centred at the total spatial frequency with the prescribed second
radius. -/
theorem dist_zeroThicknessPlatePairSum_first_spatial
    {radius radius' : Real} {directions : Int → Euclidean 2} {pair : Int × Int}
    (hradius' : 0 ≤ radius') (hdirection : ‖directions pair.2‖ = 1) :
    dist (radius • directions pair.1)
      (zeroThicknessPlatePairSum radius radius' directions pair).1 = radius' := by
  change dist (radius • directions pair.1)
    (radius • directions pair.1 + radius' • directions pair.2) = radius'
  calc
    dist (radius • directions pair.1)
        (radius • directions pair.1 + radius' • directions pair.2) =
        ‖-(radius' • directions pair.2)‖ := by
      rw [dist_eq_norm_sub]
      congr 1
      module
    _ = ‖radius' • directions pair.2‖ := norm_neg _
    _ = radius' := norm_smul_unit_direction_of_nonneg hradius' hdirection

/-- Positive-radius unit directions from one sector of radius at most `1/4`
cannot have zero weighted sum.  This removes the coincident-circle
degeneracy when the planar two-circle intersection theorem is applied to a
zero-thickness overlap fiber. -/
theorem zeroThicknessPlatePairSum_spatial_ne_zero_of_angularSectorGeometry
    {scale sectorRadius spacingLower spacingUpper radius radius' : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2}
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hradius : 0 < radius) (hradius' : 0 < radius')
    {i j : Int} (hi : i ∈ indices) (hj : j ∈ indices) :
    (zeroThicknessPlatePairSum radius radius' directions (i, j)).1 ≠ 0 := by
  rcases hgeometry with ⟨hsectorPos, hsectorBound, hspacingLower, hspacingUpper,
    center, hcenter, hdata⟩
  intro hzero
  change radius • directions i + radius' • directions j = 0 at hzero
  have hiunit : ‖directions i‖ = 1 := (hdata i hi).1
  have hjunit : ‖directions j‖ = 1 := (hdata j hj).1
  have hsum : radius • directions i = -(radius' • directions j) :=
    eq_neg_of_add_eq_zero_left hzero
  have hradii : radius = radius' := by
    calc
      radius = ‖radius • directions i‖ :=
        (norm_smul_unit_direction_of_nonneg hradius.le hiunit).symm
      _ = ‖-(radius' • directions j)‖ := congrArg norm hsum
      _ = ‖radius' • directions j‖ := norm_neg _
      _ = radius' := norm_smul_unit_direction_of_nonneg hradius'.le hjunit
  have hsumSameRadius : radius • directions i = -(radius • directions j) := by
    simpa [hradii] using hsum
  have hdirectionsOpposite : directions i = -directions j := by
    apply smul_right_injective _ hradius.ne'
    calc
      radius • directions i = -(radius • directions j) := hsumSameRadius
      _ = radius • (-directions j) := by rw [smul_neg]
  have hdirectionsReverse : directions j = -directions i := by
    rw [hdirectionsOpposite]
    simp
  have hfar : ‖directions i - directions j‖ = 2 := by
    calc
      ‖directions i - directions j‖ = ‖(2 : Real) • directions i‖ := by
        rw [hdirectionsReverse]
        congr 1
        module
      _ = 2 := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (by norm_num), hiunit, mul_one]
  have hnearI : ‖directions i - center‖ ≤ sectorRadius := (hdata i hi).2.1
  have hnearJ : ‖directions j - center‖ ≤ sectorRadius := (hdata j hj).2.1
  have hclose : ‖directions i - directions j‖ ≤ 1 / 2 := by
    calc
      ‖directions i - directions j‖ =
          ‖(directions i - center) - (directions j - center)‖ := by
        congr 1
        module
      _ ≤ ‖directions i - center‖ + ‖directions j - center‖ := norm_sub_le _ _
      _ ≤ sectorRadius + sectorRadius := add_le_add hnearI hnearJ
      _ ≤ 1 / 2 := by linarith
  rw [hfar] at hclose
  norm_num at hclose

/-- For fixed first angular label, equality of two zero-thickness pair sums
forces equality of the corresponding second directions whenever the second
radius is nonzero. -/
theorem zeroThicknessPlatePairSum_eq_right_of_fst_eq
    {radius radius' : Real} {directions : Int → Euclidean 2}
    {i j j' : Int} (hradius' : radius' ≠ 0)
    (hsum : zeroThicknessPlatePairSum radius radius' directions (i, j) =
      zeroThicknessPlatePairSum radius radius' directions (i, j')) :
    directions j = directions j' := by
  have hspace := congrArg Prod.fst hsum
  change radius • directions i + radius' • directions j =
      radius • directions i + radius' • directions j' at hspace
  exact smul_right_injective _ hradius' (add_left_cancel hspace)

/-- Combining a nonzero second radius with the separation in
`angularSectorGeometry` makes the zero-thickness pair-sum map injective in
its second angular label after the first label has been fixed. -/
theorem zeroThicknessPlatePairSum_right_injective_of_angularSectorGeometry
    {scale sectorRadius spacingLower spacingUpper radius radius' : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2}
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    {i j j' : Int} (hj : j ∈ indices) (hj' : j' ∈ indices)
    (hradius' : radius' ≠ 0)
    (hsum : zeroThicknessPlatePairSum radius radius' directions (i, j) =
      zeroThicknessPlatePairSum radius radius' directions (i, j')) :
    j = j' :=
  angularSectorGeometry_direction_injective hscale hgeometry hj hj'
    (zeroThicknessPlatePairSum_eq_right_of_fst_eq hradius' hsum)

/-- A zero-thickness center point lies in the corresponding full conic plate
whenever its radius and radial label satisfy the plate inequalities.  Thus the
model pair-sum geometry is a genuine core of the current `conicPlate`
definition, rather than an unrelated abstraction. -/
theorem zeroThicknessConicPoint_mem_conicPlate
    {scale radius gamma angularConstant : Real} {n : Int}
    {direction : Euclidean 2}
    (hscale : 0 < scale) (hradius : 0 < radius)
    (hangular : 0 ≤ angularConstant) (hdirection : ‖direction‖ = 1)
    (hrange : scale / 4 ≤ radius ∧ radius ≤ 4 * scale)
    (hradial : |(Real.sqrt scale)⁻¹ * radius - n| ≤ 1) :
    zeroThicknessConicPoint radius direction ∈
      conicPlate scale gamma angularConstant n direction := by
  have hdirection_ne : direction ≠ 0 := by
    intro hzero
    simp [hzero] at hdirection
  have hpoint_ne : radius • direction ≠ 0 :=
    smul_ne_zero (ne_of_gt hradius) hdirection_ne
  have hnorm : ‖radius • direction‖ = radius := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hradius, hdirection, mul_one]
  have hnormalized : (‖radius • direction‖)⁻¹ • (radius • direction) = direction := by
    rw [hnorm, smul_smul, inv_mul_cancel₀ (ne_of_gt hradius), one_smul]
  have haperture : 0 ≤ angularConstant * scale ^ (-(1 / 2 : Real)) := by
    positivity
  have hthickness : 0 ≤ 2 * scale ^ gamma := by
    positivity
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · simpa [zeroThicknessConicPoint, hnorm] using hrange.1
  · simpa [zeroThicknessConicPoint, hnorm] using hrange.2
  · refine ⟨hpoint_ne, ?_⟩
    change ‖(‖radius • direction‖)⁻¹ • (radius • direction) - direction‖ ≤ _
    rw [hnormalized]
    simpa using haperture
  · simpa [zeroThicknessConicPoint] using hradial
  · simp only [zeroThicknessConicPoint, hnorm, sub_self, abs_zero]
    exact hthickness

/-- In the zero-thickness model, membership in a Minkowski sum is exactly
equality with the corresponding pair-sum center. -/
theorem mem_minkowskiSum_zeroThicknessConicPlates_iff
    (radius radius' : Real) (direction direction' : Euclidean 2)
    (Z : WaveSpaceTime) :
    Z ∈ minkowskiSum (zeroThicknessConicPlate radius direction)
        (zeroThicknessConicPlate radius' direction') ↔
      zeroThicknessConicPoint radius direction +
        zeroThicknessConicPoint radius' direction' = Z := by
  constructor
  · rintro ⟨z, hz, w, hw, hzw⟩
    have hz' : z = zeroThicknessConicPoint radius direction := by
      simpa [zeroThicknessConicPlate] using hz
    have hw' : w = zeroThicknessConicPoint radius' direction' := by
      simpa [zeroThicknessConicPlate] using hw
    subst z
    subst w
    exact hzw
  · intro h
    exact ⟨zeroThicknessConicPoint radius direction,
      by simp [zeroThicknessConicPlate],
      zeroThicknessConicPoint radius' direction',
      by simp [zeroThicknessConicPlate], h⟩

/-- The active ordered angular pairs in the zero-thickness, fixed-radius
model at one prescribed output frequency. -/
noncomputable def zeroThicknessPlateOverlapPairs (radius radius' : Real)
    (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) : Finset (Int × Int) := by
  classical
  exact (angularSeparationPairs indices k).filter
    (fun pair => zeroThicknessPlatePairSum radius radius' directions pair = Z)

/-- The corresponding zero-thickness overlap multiplicity. -/
noncomputable def zeroThicknessPlateOverlapMultiplicity (radius radius' : Real)
    (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) : Nat :=
  (zeroThicknessPlateOverlapPairs radius radius' indices directions k Z).card

/-- The first spatial summands occurring in one fixed zero-thickness
plate-overlap fiber.  They will lie in the intersection of two circles. -/
noncomputable def zeroThicknessPlateOverlapFirstSpatialPoints
    (radius radius' : Real) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime) :
    Finset (Euclidean 2) := by
  classical
  exact (zeroThicknessPlateOverlapPairs radius radius' indices directions k Z).image
    (fun pair => radius • directions pair.1)

/-- Under the nonzero-radius and angular-spacing hypotheses, recording the
first spatial summand loses no information from an active zero-thickness
ordered pair. -/
theorem zeroThicknessPlateOverlapPairs_firstSpatial_injective_of_angularSectorGeometry
    {scale sectorRadius spacingLower spacingUpper radius radius' : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2} (k : Nat)
    (Z : WaveSpaceTime) (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hradius : radius ≠ 0) (hradius' : radius' ≠ 0) :
    Set.InjOn (fun pair : Int × Int => radius • directions pair.1)
      (zeroThicknessPlateOverlapPairs radius radius' indices directions k Z) := by
  intro pair hpair pair' hpair' hfirst
  rcases pair with ⟨i, j⟩
  rcases pair' with ⟨i', j'⟩
  change radius • directions i = radius • directions i' at hfirst
  have hdirectionFirst : directions i = directions i' :=
    smul_right_injective _ hradius hfirst
  have hpairBase : (i, j) ∈ angularSeparationPairs indices k ∧
      zeroThicknessPlatePairSum radius radius' directions (i, j) = Z := by
    simpa [zeroThicknessPlateOverlapPairs] using hpair
  have hpairBase' : (i', j') ∈ angularSeparationPairs indices k ∧
      zeroThicknessPlatePairSum radius radius' directions (i', j') = Z := by
    simpa [zeroThicknessPlateOverlapPairs] using hpair'
  have hi : i ∈ indices :=
    (mem_angularSeparationPairs_iff indices k (i, j)).mp hpairBase.1 |>.1
  have hi' : i' ∈ indices :=
    (mem_angularSeparationPairs_iff indices k (i', j')).mp hpairBase'.1 |>.1
  have hii : i = i' :=
    angularSectorGeometry_direction_injective hscale hgeometry hi hi' hdirectionFirst
  subst i'
  have hj : j ∈ indices :=
    (mem_angularSeparationPairs_iff indices k (i, j)).mp hpairBase.1 |>.2.1
  have hj' : j' ∈ indices :=
    (mem_angularSeparationPairs_iff indices k (i, j')).mp hpairBase'.1 |>.2.1
  have hsum : zeroThicknessPlatePairSum radius radius' directions (i, j) =
      zeroThicknessPlatePairSum radius radius' directions (i, j') :=
    hpairBase.2.trans hpairBase'.2.symm
  exact Prod.ext rfl
    (zeroThicknessPlatePairSum_right_injective_of_angularSectorGeometry
      hscale hgeometry hj hj' hradius' hsum)

/-- Every first spatial summand in an active zero-thickness pair fiber lies
simultaneously on the circle of radius `radius` around zero and the circle of
radius `radius'` around the prescribed output spatial frequency. -/
theorem mem_zeroThicknessPlateOverlapFirstSpatialPoints_two_spheres
    {scale sectorRadius spacingLower spacingUpper radius radius' : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2} (k : Nat)
    (Z : WaveSpaceTime) (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hradius : 0 ≤ radius) (hradius' : 0 ≤ radius')
    {p : Euclidean 2}
    (hp : p ∈ zeroThicknessPlateOverlapFirstSpatialPoints
      radius radius' indices directions k Z) :
    p ∈ (⟨0, radius⟩ : EuclideanGeometry.Sphere (Euclidean 2)) ∧
      p ∈ (⟨Z.1, radius'⟩ : EuclideanGeometry.Sphere (Euclidean 2)) := by
  classical
  rcases Finset.mem_image.mp hp with ⟨pair, hpair, rfl⟩
  have hpairBase : pair ∈ angularSeparationPairs indices k ∧
      zeroThicknessPlatePairSum radius radius' directions pair = Z := by
    simpa [zeroThicknessPlateOverlapFirstSpatialPoints,
      zeroThicknessPlateOverlapPairs] using hpair
  have hfirst : ‖directions pair.1‖ = 1 :=
    (hgeometry.2.2.2.2.choose_spec.2 pair.1
      ((mem_angularSeparationPairs_iff indices k pair).mp hpairBase.1).1).1
  have hsecond : ‖directions pair.2‖ = 1 :=
    (hgeometry.2.2.2.2.choose_spec.2 pair.2
      ((mem_angularSeparationPairs_iff indices k pair).mp hpairBase.1).2.1).1
  constructor
  · rw [EuclideanGeometry.mem_sphere]
    exact dist_zero_zeroThicknessPlatePairSum_first hradius hfirst
  · rw [EuclideanGeometry.mem_sphere]
    have hspatial : (zeroThicknessPlatePairSum radius radius' directions pair).1 = Z.1 :=
      congrArg Prod.fst hpairBase.2
    rw [← hspatial]
    exact dist_zeroThicknessPlatePairSum_first_spatial hradius' hsecond

/-- In the nondegenerate-output case, the planar zero-thickness overlap
fiber has multiplicity at most two.  The proof uses the exact two-circle
intersection theorem in `ℝ²`, together with the angular-spacing hypothesis
to recover ordered labels from the first spatial summand. -/
theorem zeroThicknessPlateOverlapMultiplicity_le_two_of_angularSectorGeometry_of_spatial_ne_zero
    {scale sectorRadius spacingLower spacingUpper radius radius' : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2} (k : Nat)
    (Z : WaveSpaceTime) (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hradius : 0 < radius) (hradius' : 0 < radius') (hZ : Z.1 ≠ 0) :
    zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z ≤ 2 := by
  classical
  let active := zeroThicknessPlateOverlapPairs radius radius' indices directions k Z
  let firstPoints := active.image (fun pair : Int × Int => radius • directions pair.1)
  have hinjective : Set.InjOn (fun pair : Int × Int => radius • directions pair.1)
      (active : Set (Int × Int)) := by
    simpa [active] using
      (zeroThicknessPlateOverlapPairs_firstSpatial_injective_of_angularSectorGeometry
        k Z hscale hgeometry hradius.ne' hradius'.ne')
  let s₁ : EuclideanGeometry.Sphere (Euclidean 2) := ⟨0, radius⟩
  let s₂ : EuclideanGeometry.Sphere (Euclidean 2) := ⟨Z.1, radius'⟩
  have hspheres : s₁ ≠ s₂ := by
    intro hs
    have hcenters := congrArg EuclideanGeometry.Sphere.center hs
    change (0 : Euclidean 2) = Z.1 at hcenters
    exact hZ hcenters.symm
  have hfinrank : Module.finrank Real (Euclidean 2) = 2 := by
    simp [Euclidean]
  have hcircle : ∀ p ∈ firstPoints, p ∈ s₁ ∧ p ∈ s₂ := by
    intro p hp
    simpa [firstPoints, active, s₁, s₂] using
      (mem_zeroThicknessPlateOverlapFirstSpatialPoints_two_spheres k Z hgeometry
        hradius.le hradius'.le hp)
  have hpointsCard : firstPoints.card ≤ 2 := by
    apply finset_card_le_two_of_forall_mem_eq_or_eq
    intro a ha b hb hab c hc
    rcases hcircle a ha with ⟨ha₁, ha₂⟩
    rcases hcircle b hb with ⟨hb₁, hb₂⟩
    rcases hcircle c hc with ⟨hc₁, hc₂⟩
    exact EuclideanGeometry.eq_of_mem_sphere_of_mem_sphere_of_finrank_eq_two
      hfinrank hspheres hab ha₁ hb₁ hc₁ ha₂ hb₂ hc₂
  have hcard : active.card = firstPoints.card := by
    change active.card =
      (active.image (fun pair : Int × Int => radius • directions pair.1)).card
    exact (Finset.card_image_of_injOn hinjective).symm
  calc
    zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z = active.card := rfl
    _ = firstPoints.card := hcard
    _ ≤ 2 := hpointsCard

/-- The fully nondegenerate zero-thickness plate-overlap theorem in the
stated planar angular-sector geometry.  If the fiber is nonempty, the common
sector condition forces its output spatial frequency to be nonzero, so the
two-circle intersection argument applies; if it is empty the conclusion is
immediate. -/
theorem zeroThicknessPlateOverlapMultiplicity_le_two_of_angularSectorGeometry
    {scale sectorRadius spacingLower spacingUpper radius radius' : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2} (k : Nat)
    (Z : WaveSpaceTime) (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hradius : 0 < radius) (hradius' : 0 < radius') :
    zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z ≤ 2 := by
  classical
  by_cases hnonempty :
      (zeroThicknessPlateOverlapPairs radius radius' indices directions k Z).Nonempty
  · obtain ⟨pair, hpair⟩ := hnonempty
    have hpairBase : pair ∈ angularSeparationPairs indices k ∧
        zeroThicknessPlatePairSum radius radius' directions pair = Z := by
      simpa [zeroThicknessPlateOverlapPairs] using hpair
    have hi : pair.1 ∈ indices :=
      (mem_angularSeparationPairs_iff indices k pair).mp hpairBase.1 |>.1
    have hj : pair.2 ∈ indices :=
      (mem_angularSeparationPairs_iff indices k pair).mp hpairBase.1 |>.2.1
    have hsumNe : (zeroThicknessPlatePairSum radius radius' directions pair).1 ≠ 0 :=
      zeroThicknessPlatePairSum_spatial_ne_zero_of_angularSectorGeometry
        hgeometry hradius hradius' hi hj
    have hZ : Z.1 ≠ 0 := by
      intro hzero
      apply hsumNe
      rw [hpairBase.2, hzero]
    exact
      zeroThicknessPlateOverlapMultiplicity_le_two_of_angularSectorGeometry_of_spatial_ne_zero
        k Z hscale hgeometry hradius hradius' hZ
  · have hempty : zeroThicknessPlateOverlapPairs radius radius' indices directions k Z = ∅ :=
      Finset.not_nonempty_iff_eq_empty.mp hnonempty
    simp [zeroThicknessPlateOverlapMultiplicity, hempty]

/-- The elementary zero-thickness plate-overlap bound furnished directly by
the prescribed angular-sector geometry.  Once the first label is fixed, a
nonzero second radius and equality of pair sums determine the second
direction, and the lower spacing condition determines its label.  Thus the
active ordered-pair fiber injects into its first-label projection.  This is
a genuine linear finite-overlap reduction; the sharp MSS geometry improves
the remaining cardinality factor to a scale-small bound. -/
theorem zeroThicknessPlateOverlapMultiplicity_le_card_of_angularSectorGeometry
    {scale sectorRadius spacingLower spacingUpper radius radius' : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2} (k : Nat)
    (Z : WaveSpaceTime) (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hradius' : radius' ≠ 0) :
    zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z ≤
      indices.card := by
  classical
  let active := zeroThicknessPlateOverlapPairs radius radius' indices directions k Z
  have hmaps : Set.MapsTo Prod.fst (active : Set (Int × Int)) (indices : Set Int) := by
    intro pair hpair
    have hpairBase : pair ∈ angularSeparationPairs indices k ∧
        zeroThicknessPlatePairSum radius radius' directions pair = Z := by
      simpa [active, zeroThicknessPlateOverlapPairs] using hpair
    exact (mem_angularSeparationPairs_iff indices k pair).mp hpairBase.1 |>.1
  have hinjective : (active : Set (Int × Int)).InjOn Prod.fst := by
    intro pair hpair pair' hpair' hfst
    rcases pair with ⟨i, j⟩
    rcases pair' with ⟨i', j'⟩
    change i = i' at hfst
    subst i'
    have hpairBase : (i, j) ∈ angularSeparationPairs indices k ∧
        zeroThicknessPlatePairSum radius radius' directions (i, j) = Z := by
      simpa [active, zeroThicknessPlateOverlapPairs] using hpair
    have hpairBase' : (i, j') ∈ angularSeparationPairs indices k ∧
        zeroThicknessPlatePairSum radius radius' directions (i, j') = Z := by
      simpa [active, zeroThicknessPlateOverlapPairs] using hpair'
    have hj : j ∈ indices :=
      (mem_angularSeparationPairs_iff indices k (i, j)).mp hpairBase.1 |>.2.1
    have hj' : j' ∈ indices :=
      (mem_angularSeparationPairs_iff indices k (i, j')).mp hpairBase'.1 |>.2.1
    have hsum : zeroThicknessPlatePairSum radius radius' directions (i, j) =
        zeroThicknessPlatePairSum radius radius' directions (i, j') :=
      hpairBase.2.trans hpairBase'.2.symm
    exact Prod.ext rfl
      (zeroThicknessPlatePairSum_right_injective_of_angularSectorGeometry
        hscale hgeometry hj hj' hradius' hsum)
  change active.card ≤ indices.card
  exact Finset.card_le_card_of_injOn Prod.fst hmaps hinjective

/-- A strengthened geometric hypothesis for the fixed-radius model: a
pair-sum fiber contains only a pair itself and, at most, its reversed ordered
pair.  This is the appropriate replacement for literal injectivity because
equal-radius sums are invariant under swapping the two directions. -/
def zeroThicknessPairSumAtMostTwo (radius radius' : Real)
    (indices : Finset Int) (directions : Int → Euclidean 2) (k : Nat) : Prop :=
  ∀ ⦃pair⦄, pair ∈ angularSeparationPairs indices k →
    ∀ ⦃pair'⦄, pair' ∈ angularSeparationPairs indices k →
      zeroThicknessPlatePairSum radius radius' directions pair =
        zeroThicknessPlatePairSum radius radius' directions pair' →
        pair = pair' ∨ pair = (pair'.2, pair'.1)

/-- Under the explicit two-to-one pair-sum geometry, every zero-thickness
model overlap multiplicity is at most two. -/
theorem zeroThicknessPlateOverlapMultiplicity_le_two_of_pairSumAtMostTwo
    (radius radius' : Real) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime)
    (hgeom : zeroThicknessPairSumAtMostTwo radius radius' indices directions k) :
    zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z ≤ 2 := by
  classical
  let active := zeroThicknessPlateOverlapPairs radius radius' indices directions k Z
  by_cases hnonempty : active.Nonempty
  · obtain ⟨pair, hpair⟩ := hnonempty
    have hpairBase : pair ∈ angularSeparationPairs indices k ∧
        zeroThicknessPlatePairSum radius radius' directions pair = Z := by
      simpa [active, zeroThicknessPlateOverlapPairs] using hpair
    have hsubset : active ⊆ ({pair, (pair.2, pair.1)} : Finset (Int × Int)) := by
      intro pair' hactive
      have hpairActive : pair' ∈ angularSeparationPairs indices k ∧
          zeroThicknessPlatePairSum radius radius' directions pair' = Z := by
        simpa [active, zeroThicknessPlateOverlapPairs] using hactive
      rcases hgeom (pair := pair') hpairActive.1 (pair' := pair) hpairBase.1
        (hpairActive.2.trans hpairBase.2.symm) with h | h
      · exact Finset.mem_insert.mpr (Or.inl h)
      · exact Finset.mem_insert.mpr
          (Or.inr (Finset.mem_singleton.mpr h))
    change active.card ≤ 2
    exact (Finset.card_le_card hsubset).trans Finset.card_le_two
  · have hempty : active = ∅ := Finset.not_nonempty_iff_eq_empty.mp hnonempty
    change active.card ≤ 2
    simp [hempty]

/-- At equal radii the zero-thickness pair-sum is invariant under swapping
the two ordered angular labels. -/
theorem zeroThicknessPlatePairSum_swap (radius : Real)
    (directions : Int → Euclidean 2) (pair : Int × Int) :
    zeroThicknessPlatePairSum radius radius directions (pair.2, pair.1) =
      zeroThicknessPlatePairSum radius radius directions pair := by
  simp [zeroThicknessPlatePairSum, add_comm]

/-- The swap symmetry gives an exact obstruction to a false multiplicity-one
claim for ordered pairs at equal radii. -/
theorem two_le_zeroThicknessPlateOverlapMultiplicity_of_offDiagonalPair
    (radius : Real) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (pair : Int × Int)
    (hpair : pair ∈ angularSeparationPairs indices k)
    (hoff : pair ≠ (pair.2, pair.1)) :
    2 ≤ zeroThicknessPlateOverlapMultiplicity radius radius indices directions k
      (zeroThicknessPlatePairSum radius radius directions pair) := by
  classical
  let Z := zeroThicknessPlatePairSum radius radius directions pair
  let active := zeroThicknessPlateOverlapPairs radius radius indices directions k Z
  have hswap : (pair.2, pair.1) ∈ angularSeparationPairs indices k :=
    (mem_swap_angularSeparationPairs_iff indices k pair.1 pair.2).mpr hpair
  have hpairActive : pair ∈ active := by
    have : pair ∈ angularSeparationPairs indices k ∧
        zeroThicknessPlatePairSum radius radius directions pair = Z := ⟨hpair, rfl⟩
    simpa [active, zeroThicknessPlateOverlapPairs] using this
  have hswapActive : (pair.2, pair.1) ∈ active := by
    have hsum : zeroThicknessPlatePairSum radius radius directions (pair.2, pair.1) = Z := by
      simpa [Z] using zeroThicknessPlatePairSum_swap radius directions pair
    have : (pair.2, pair.1) ∈ angularSeparationPairs indices k ∧
        zeroThicknessPlatePairSum radius radius directions (pair.2, pair.1) = Z :=
      ⟨hswap, hsum⟩
    simpa [active, zeroThicknessPlateOverlapPairs] using this
  have hsubset : ({pair, (pair.2, pair.1)} : Finset (Int × Int)) ⊆ active := by
    intro pair' hpair'
    simp only [Finset.mem_insert, Finset.mem_singleton] at hpair'
    rcases hpair' with h | h
    · simpa [h] using hpairActive
    · simpa [h] using hswapActive
  change 2 ≤ active.card
  calc
    2 = ({pair, (pair.2, pair.1)} : Finset (Int × Int)).card :=
      (Finset.card_pair hoff).symm
    _ ≤ active.card := Finset.card_le_card hsubset

/-- A unit-normal-thickness conic plate translated in the normal coordinate.
The radial and angular windows are unchanged.  This is the genuinely needed
input for a thick-plate cover argument; it is not the zero-thickness model. -/
def unitNormalConicPlate (scale angularConstant normalShift : Real) (n : Int)
    (direction : Euclidean 2) : Set WaveSpaceTime :=
  {ζ | scale / 4 ≤ ‖ζ.1‖ ∧ ‖ζ.1‖ ≤ 4 * scale ∧
    ζ.1 ∈ angularSector direction
      (angularConstant * scale ^ (-(1 / 2 : Real))) ∧
    |(Real.sqrt scale)⁻¹ * ζ.2 - n| ≤ 1 ∧
    |(ζ.2 - ‖ζ.1‖) - normalShift| ≤ 2}

/-- A finite normal-coordinate cover of each thick conic plate by translated
unit-normal-thickness plates. -/
def normalCoordinatePlateCover (scale gamma angularConstant : Real)
    (normalShifts : Finset Real) : Prop :=
  ∀ (n : Int) (direction : Euclidean 2) (ζ : WaveSpaceTime),
    ζ ∈ conicPlate scale gamma angularConstant n direction →
      ∃ shift ∈ normalShifts,
        ζ ∈ unitNormalConicPlate scale angularConstant shift n direction

/-- The finite family of angular pairs whose translated unit-normal-thickness
plates can contribute to a prescribed Minkowski-sum frequency. -/
noncomputable def unitNormalPlateOverlapPairs
    (scale angularConstant : Real) (normalShift normalShift' : Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) : Finset (Int × Int) := by
  classical
  exact (angularSeparationPairs indices k).filter (fun pair =>
    Z ∈ minkowskiSum
      (unitNormalConicPlate scale angularConstant normalShift n (directions pair.1))
      (unitNormalConicPlate scale angularConstant normalShift' n' (directions pair.2)))

/-- Membership in a translated unit-normal-thickness overlap fiber. -/
theorem mem_unitNormalPlateOverlapPairs_iff
    (scale angularConstant : Real) (normalShift normalShift' : Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (pair : Int × Int) :
    pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
        n n' indices directions k Z ↔
      pair ∈ angularSeparationPairs indices k ∧
        Z ∈ minkowskiSum
          (unitNormalConicPlate scale angularConstant normalShift n (directions pair.1))
          (unitNormalConicPlate scale angularConstant normalShift' n' (directions pair.2)) := by
  classical
  simp [unitNormalPlateOverlapPairs]

/-- The cardinality of a translated unit-normal-thickness overlap fiber. -/
noncomputable def unitNormalPlateOverlapMultiplicity
    (scale angularConstant : Real) (normalShift normalShift' : Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) : Nat :=
  (unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
    n n' indices directions k Z).card

/-- Every real normal coordinate is within unit-normal thickness of a
translate from the `4 ℤ` lattice. -/
theorem abs_sub_four_mul_floor_le_two (q : Real) :
    |q - 4 * (⌊(q + 2) / 4⌋ : Int)| ≤ 2 := by
  have hfloor : ((⌊(q + 2) / 4⌋ : Int) : Real) ≤ (q + 2) / 4 :=
    Int.floor_le _
  have hlt : (q + 2) / 4 < ((⌊(q + 2) / 4⌋ : Int) : Real) + 1 :=
    Int.lt_floor_add_one _
  rw [abs_le]
  constructor <;> linarith

/-- The explicit finite `4 ℤ` normal-coordinate cover of a window with
radius `2 * R`. -/
noncomputable def normalCoverShifts (R : Real) : Finset Real :=
  (Finset.Icc (-⌈R / 2⌉ - 1) (⌈R / 2⌉ + 1)).image
    (fun m : Int => (4 : Real) * m)

/-- The floor-selected normal translate belongs to the explicit cover range. -/
theorem floor_mem_normalCoverShifts (R q : Real)
    (hq : |q| ≤ 2 * R) :
    (4 : Real) * (⌊(q + 2) / 4⌋ : Int) ∈ normalCoverShifts R := by
  refine Finset.mem_image.mpr ?_
  refine ⟨⌊(q + 2) / 4⌋, ?_, rfl⟩
  rw [Finset.mem_Icc]
  rw [abs_le] at hq
  have hceil : R / 2 ≤ ((⌈R / 2⌉ : Int) : Real) := Int.le_ceil _
  constructor
  · rw [Int.le_floor]
    norm_num
    linarith
  · have hfloor : ((⌊(q + 2) / 4⌋ : Int) : Real) ≤ (q + 2) / 4 :=
      Int.floor_le _
    have hcast : ((⌊(q + 2) / 4⌋ : Int) : Real) ≤
        ((⌈R / 2⌉ + 1 : Int) : Real) := by
      norm_num
      linarith
    exact_mod_cast hcast

/-- The explicit `4 ℤ` family covers the normal window of every thick plate.
This is a direct interval calculation; no conic-overlap geometry is used. -/
theorem normalCoordinatePlateCover_normalCoverShifts
    (scale gamma angularConstant : Real) :
    normalCoordinatePlateCover scale gamma angularConstant
      (normalCoverShifts (scale ^ gamma)) := by
  intro n direction z hz
  rcases hz with ⟨hradialLower, hradialUpper, hangular, hvør, hnormal⟩
  let q : Real := z.2 - ‖z.1‖
  let shift : Real := 4 * ((⌊(q + 2) / 4⌋ : Int) : Real)
  refine ⟨shift, ?_, ?_⟩
  · change (4 : Real) * ((⌊(q + 2) / 4⌋ : Int) : Real) ∈
      normalCoverShifts (scale ^ gamma)
    apply floor_mem_normalCoverShifts
    simpa [q] using hnormal
  · exact ⟨hradialLower, hradialUpper, hangular, hvør, by
      change |q - 4 * ((⌊(q + 2) / 4⌋ : Int) : Real)| ≤ 2
      exact abs_sub_four_mul_floor_le_two q⟩

/-- The explicit normal-coordinate cover has at most `6 R` members whenever
`R ≥ 1`. -/
theorem card_normalCoverShifts_le_six_mul (R : Real) (hR : 1 ≤ R) :
    ((normalCoverShifts R).card : Real) ≤ 6 * R := by
  let c : Int := ⌈R / 2⌉
  have hc : R / 2 ≤ (c : Real) := by
    exact Int.le_ceil _
  have hc0 : 0 ≤ c := by
    have hc0real : 0 ≤ (c : Real) := by linarith
    exact_mod_cast hc0real
  have hcount_nonneg : 0 ≤ c + 1 + 1 - (-c - 1) := by omega
  have hcard : (normalCoverShifts R).card ≤
      (Finset.Icc (-c - 1) (c + 1)).card := by
    unfold normalCoverShifts
    exact Finset.card_image_le
  have hIcc : (Finset.Icc (-c - 1) (c + 1)).card = (2 * c + 3).toNat := by
    rw [Int.card_Icc]
    congr 1
    omega
  have hcount : (((2 * c + 3).toNat : Nat) : Real) = 2 * (c : Real) + 3 := by
    have hcast : (((2 * c + 3).toNat : Nat) : Int) = 2 * c + 3 :=
      Int.toNat_of_nonneg (by omega)
    exact_mod_cast hcast
  have hcardReal : ((normalCoverShifts R).card : Real) ≤
      2 * (c : Real) + 3 := by
    have hnat : (normalCoverShifts R).card ≤ (2 * c + 3).toNat :=
      hcard.trans_eq hIcc
    have hnatReal : ((normalCoverShifts R).card : Real) ≤
        (((2 * c + 3).toNat : Nat) : Real) := by
      exact_mod_cast hnat
    rw [hcount] at hnatReal
    exact hnatReal
  have hcupper : (c : Real) < R / 2 + 1 := by
    exact_mod_cast Int.ceil_lt_add_one (R / 2)
  linarith

/-- At the MSS scales, the explicit normal-coordinate cover has cardinality
at most `6 * scale^gamma`. -/
theorem card_normalCoverShifts_at_scale_le_six_mul
    (scale gamma : Real) (hscale : 2 ≤ scale) (hgamma : 0 ≤ gamma) :
    ((normalCoverShifts (scale ^ gamma)).card : Real) ≤ 6 * scale ^ gamma := by
  apply card_normalCoverShifts_le_six_mul
  apply Real.one_le_rpow
  · linarith
  · exact hgamma

/-- The finite family of angular pairs whose two conic plates can contribute
to a prescribed Minkowski-sum frequency. -/
noncomputable def plateOverlapPairs (scale gamma angularConstant : Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) : Finset (Int × Int) := by
  classical
  exact (angularSeparationPairs indices k).filter (fun pair =>
    Z ∈ minkowskiSum (conicPlate scale gamma angularConstant n (directions pair.1))
      (conicPlate scale gamma angularConstant n' (directions pair.2)))

/-- Membership in the active pair family is precisely angular separation
together with containment of the prescribed frequency in the plate sum. -/
theorem mem_plateOverlapPairs_iff (scale gamma angularConstant : Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (pair : Int × Int) :
    pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z ↔
      pair ∈ angularSeparationPairs indices k ∧
        Z ∈ minkowskiSum
          (conicPlate scale gamma angularConstant n (directions pair.1))
          (conicPlate scale gamma angularConstant n' (directions pair.2)) := by
  classical
  simp [plateOverlapPairs]

/-- Active plate-overlap pairs form a subfamily of the fixed separation
class. -/
theorem plateOverlapPairs_subset_angularSeparationPairs
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime) :
    plateOverlapPairs scale gamma angularConstant n n' indices directions k Z ⊆
      angularSeparationPairs indices k := by
  classical
  rw [plateOverlapPairs]
  exact Finset.filter_subset _ _

/-- The number of pairs of conic plates at a prescribed angular separation
whose Minkowski sum contains a given frequency point. -/
noncomputable def plateOverlapMultiplicity (scale gamma angularConstant : Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) : Nat :=
  (plateOverlapPairs scale gamma angularConstant n n' indices directions k Z).card

/-- The overlap multiplicity is exactly the cardinality of its active finite
pair family. -/
theorem plateOverlapMultiplicity_eq_card_plateOverlapPairs
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime) :
    plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z =
      (plateOverlapPairs scale gamma angularConstant n n' indices directions k Z).card := rfl

private noncomputable def normalCoverOverlapPairs
    (scale angularConstant : Real) (normalShifts : Finset Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) : Finset (Int × Int) := by
  classical
  exact (normalShifts.product normalShifts).biUnion (fun shifts =>
    unitNormalPlateOverlapPairs scale angularConstant shifts.1 shifts.2
      n n' indices directions k Z)

private theorem plateOverlapPairs_subset_normalCoverOverlapPairs
    (scale gamma angularConstant : Real) (normalShifts : Finset Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime)
    (hcover : normalCoordinatePlateCover scale gamma angularConstant normalShifts) :
    plateOverlapPairs scale gamma angularConstant n n' indices directions k Z ⊆
      normalCoverOverlapPairs scale angularConstant normalShifts
        n n' indices directions k Z := by
  classical
  intro pair hpair
  rcases (mem_plateOverlapPairs_iff scale gamma angularConstant n n' indices directions k Z pair).mp
    hpair with ⟨hseparation, hsum⟩
  rcases hsum with ⟨z, hz, w, hw, hzw⟩
  rcases hcover n (directions pair.1) z hz with ⟨shift, hshift, hzshift⟩
  rcases hcover n' (directions pair.2) w hw with ⟨shift', hshift', hwshift⟩
  apply Finset.mem_biUnion.mpr
  refine ⟨(shift, shift'), Finset.mem_product.mpr ⟨hshift, hshift'⟩, ?_⟩
  apply (mem_unitNormalPlateOverlapPairs_iff scale angularConstant shift shift'
    n n' indices directions k Z pair).mpr
  exact ⟨hseparation, ⟨z, hzshift, w, hwshift, hzw⟩⟩

/-- A finite cover by translated unit-normal plates transfers a uniform
unit-normal overlap bound to the original thick plate. -/
theorem plateOverlapMultiplicity_le_normalCover_mul_unitBound
    (scale gamma angularConstant : Real) (normalShifts : Finset Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (M : Nat)
    (hcover : normalCoordinatePlateCover scale gamma angularConstant normalShifts)
    (hunit : ∀ shift ∈ normalShifts, ∀ shift' ∈ normalShifts,
      unitNormalPlateOverlapMultiplicity scale angularConstant shift shift'
        n n' indices directions k Z ≤ M) :
    plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z ≤
      normalShifts.card * normalShifts.card * M := by
  classical
  have hsubset := plateOverlapPairs_subset_normalCoverOverlapPairs
    scale gamma angularConstant normalShifts n n' indices directions k Z hcover
  calc
    plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z =
        (plateOverlapPairs scale gamma angularConstant n n' indices directions k Z).card := rfl
    _ ≤ (normalCoverOverlapPairs scale angularConstant normalShifts
        n n' indices directions k Z).card := Finset.card_le_card hsubset
    _ ≤ (normalShifts.product normalShifts).card * M := by
      apply Finset.card_biUnion_le_card_mul
      intro shifts hshifts
      rcases Finset.mem_product.mp hshifts with ⟨hleft, hright⟩
      simpa [unitNormalPlateOverlapMultiplicity] using hunit shifts.1 hleft shifts.2 hright
    _ = normalShifts.card * normalShifts.card * M := by
      have hcard : (normalShifts.product normalShifts).card =
          normalShifts.card * normalShifts.card := by
        exact Finset.card_product _ _
      rw [hcard]

/-- Cauchy--Schwarz on the active finite pair family.  The factor is the
literal plate-overlap multiplicity; no geometric bound for it is used. -/
theorem sq_sum_norm_plateOverlapPairs_le_plateOverlapMultiplicity_mul_sum_sq
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime)
    (F : Int × Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
        ‖F pair z‖) ^ 2 ≤
      (plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z : Real) *
        ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
          ‖F pair z‖ ^ 2 := by
  rw [plateOverlapMultiplicity_eq_card_plateOverlapPairs]
  exact sq_sum_le_card_mul_sum_sq

/-- The preceding active-pair inequality in the product form used by the
finite fourth-power calculation. -/
theorem sq_sum_norm_mul_plateOverlapPairs_le_plateOverlapMultiplicity_mul_sum_sq
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime)
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
        ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
      (plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z : Real) *
        ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
          ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
  calc
    (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
        ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
        (plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z : Real) *
          ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
            ‖(fun pair z => F pair.1 z * G pair.2 z) pair z‖ ^ 2 :=
      sq_sum_norm_plateOverlapPairs_le_plateOverlapMultiplicity_mul_sum_sq
        scale gamma angularConstant n n' indices directions k Z
        (fun pair z => F pair.1 z * G pair.2 z) z
    _ = (plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z : Real) *
        ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
          ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
      congr 1
      apply Finset.sum_congr rfl
      intro pair hpair
      rw [norm_mul]
      ring

/-- A plate-overlap multiplicity is bounded by the number of angular pairs
under consideration. -/
theorem plateOverlapMultiplicity_le_card_angularSeparationPairs
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime) :
    plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z ≤
      (angularSeparationPairs indices k).card := by
  rw [plateOverlapMultiplicity_eq_card_plateOverlapPairs]
  exact Finset.card_le_card
    (plateOverlapPairs_subset_angularSeparationPairs scale gamma angularConstant n n'
      indices directions k Z)

/-- The trivial finite-index bound for a plate-overlap multiplicity.  The
geometric plate-overlap lemma improves this quadratic estimate. -/
theorem plateOverlapMultiplicity_le_card_sq
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime) :
    plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z ≤
      indices.card ^ 2 :=
  (plateOverlapMultiplicity_le_card_angularSeparationPairs scale gamma angularConstant
    n n' indices directions k Z).trans (card_angularSeparationPairs_le indices k)

/-- Substituting the elementary finite pair-count bound gives a fully
geometric-free fourth-power estimate.  The sharp MSS argument replaces this
quadratic factor by the plate-overlap estimate. -/
theorem sq_sum_norm_mul_plateOverlapPairs_le_card_sq_mul_sum_sq
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime)
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
        ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
      (indices.card : Real) ^ 2 *
        ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
          ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
  have hmult :
      (plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z : Real) ≤
        (indices.card : Real) ^ 2 := by
    exact_mod_cast
      plateOverlapMultiplicity_le_card_sq scale gamma angularConstant n n' indices directions k Z
  have henergy : 0 ≤
      ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
        ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
    Finset.sum_nonneg fun pair hpair =>
      mul_nonneg (sq_nonneg (‖F pair.1 z‖)) (sq_nonneg (‖G pair.2 z‖))
  calc
    (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
        ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
        (plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z : Real) *
          ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
            ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
      sq_sum_norm_mul_plateOverlapPairs_le_plateOverlapMultiplicity_mul_sum_sq
        scale gamma angularConstant n n' indices directions k Z F G z
    _ ≤ (indices.card : Real) ^ 2 *
        ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
          ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
      mul_le_mul_of_nonneg_right hmult henergy

/-- The geometric plate-overlap target.  `maxLevel` is supplied by the
angular decomposition; for the blueprint it is the ceiling-logarithmic bound
on the number of angular sectors.  Unlike an unconstrained family of vectors,
the directions are required to arise from a uniformly spaced, ordered angular
sector geometry.  The multiplicative constant is allowed to depend on the
normal-thickness parameter `gamma`, as in the blueprint. -/
def plateOverlap (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real) : Prop :=
  0 < angularConstant ∧ ∃ overlapExponent : Real, 0 < overlapExponent ∧
    ∀ gamma : Real, 0 < gamma → gamma < 1 / 10 →
      ∃ Cgamma : Real, 0 < Cgamma ∧
        ∀ scale : Real, 2 ≤ scale → ∀ radialIndices angularIndices : Finset Int,
          ∀ directions : Int → Euclidean 2,
            angularSectorGeometry scale angularIndices directions
              sectorRadius spacingLower spacingUpper →
            ∀ n ∈ radialIndices, ∀ n' ∈ radialIndices,
              ∀ k : Nat, k ≤ maxLevel scale → ∀ Z : WaveSpaceTime,
                (plateOverlapMultiplicity scale gamma angularConstant n n'
                  angularIndices directions k Z : Real) ≤
                    Cgamma * scale ^ (overlapExponent * gamma)

/-- The cited geometric input needed by the finite normal-coordinate cover.
It bounds overlap fibers for arbitrary *translated* unit-normal-thickness
plates uniformly in the translations.  This is intentionally stronger than
the proved zero-thickness two-circle theorem. -/
def translatedUnitNormalPlateOverlap (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real) : Prop :=
  ∃ M : Nat, ∀ scale : Real, 2 ≤ scale →
    ∀ radialIndices angularIndices : Finset Int,
      ∀ directions : Int → Euclidean 2,
        angularSectorGeometry scale angularIndices directions
          sectorRadius spacingLower spacingUpper →
        ∀ n ∈ radialIndices, ∀ n' ∈ radialIndices,
          ∀ k : Nat, k ≤ maxLevel scale → ∀ Z : WaveSpaceTime,
            ∀ normalShift normalShift' : Real,
              unitNormalPlateOverlapMultiplicity scale angularConstant
                normalShift normalShift' n n' angularIndices directions k Z ≤ M

private theorem aux_abs_time_sub_radialLabel_mul_sqrt_le
    {scale : Real} (hscale : 0 < scale) {n : Int} {t : Real}
    (ht : |(Real.sqrt scale)⁻¹ * t - n| ≤ 1) :
    |t - (n : Real) * Real.sqrt scale| ≤ Real.sqrt scale := by
  have hs : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
  have hsne : Real.sqrt scale ≠ 0 := ne_of_gt hs
  have hrewrite :
      (Real.sqrt scale)⁻¹ * t - (n : Real) =
        (Real.sqrt scale)⁻¹ * (t - (n : Real) * Real.sqrt scale) := by
    field_simp [hsne]
  rw [hrewrite, abs_mul, abs_of_pos (inv_pos.mpr hs)] at ht
  have hmul := mul_le_mul_of_nonneg_left ht hs.le
  calc
    |t - (n : Real) * Real.sqrt scale| =
        (Real.sqrt scale * (Real.sqrt scale)⁻¹) *
          |t - (n : Real) * Real.sqrt scale| := by
            rw [mul_inv_cancel₀ hsne, one_mul]
    _ = Real.sqrt scale *
          ((Real.sqrt scale)⁻¹ * |t - (n : Real) * Real.sqrt scale|) :=
      mul_assoc _ _ _
    _ ≤ Real.sqrt scale * 1 := hmul
    _ = Real.sqrt scale := by ring

private theorem aux_mem_unitNormalConicPlate_time_localized
    {scale angularConstant normalShift : Real} {n : Int}
    {direction : _root_.Codex.Spherical.SurfaceCore.Euclidean 2} {z : WaveSpaceTime}
    (hscale : 0 < scale)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction) :
    |z.2 - (n : Real) * Real.sqrt scale| ≤ Real.sqrt scale := by
  exact aux_abs_time_sub_radialLabel_mul_sqrt_le hscale hz.2.2.2.1

private theorem aux_mem_unitNormalConicPlate_radius_localized
    {scale angularConstant normalShift : Real} {n : Int}
    {direction : _root_.Codex.Spherical.SurfaceCore.Euclidean 2} {z : WaveSpaceTime}
    (hscale : 0 < scale)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction) :
    |‖z.1‖ - ((n : Real) * Real.sqrt scale - normalShift)| ≤
      Real.sqrt scale + 2 := by
  have htime := aux_mem_unitNormalConicPlate_time_localized hscale hz
  have hnormal : |(z.2 - ‖z.1‖) - normalShift| ≤ 2 := hz.2.2.2.2
  calc
    |‖z.1‖ - ((n : Real) * Real.sqrt scale - normalShift)| =
        |(z.2 - (n : Real) * Real.sqrt scale) -
          ((z.2 - ‖z.1‖) - normalShift)| := by ring_nf
    _ = |(z.2 - (n : Real) * Real.sqrt scale) +
          -((z.2 - ‖z.1‖) - normalShift)| := by ring_nf
    _ ≤ |z.2 - (n : Real) * Real.sqrt scale| +
          |-((z.2 - ‖z.1‖) - normalShift)| := abs_add_le _ _
    _ = |z.2 - (n : Real) * Real.sqrt scale| +
          |(z.2 - ‖z.1‖) - normalShift| := by rw [abs_neg]
    _ ≤ Real.sqrt scale + 2 := add_le_add htime hnormal

private theorem aux_mem_unitNormalConicPlate_direction_localized
    {scale angularConstant normalShift : Real} {n : Int}
    {direction : _root_.Codex.Spherical.SurfaceCore.Euclidean 2} {z : WaveSpaceTime}
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction) :
    z.1 ≠ 0 ∧
      ‖(‖z.1‖)⁻¹ • z.1 - direction‖ ≤
        angularConstant * scale ^ (-(1 / 2 : Real)) := by
  exact hz.2.2.1

private theorem aux_mem_minkowskiSum_unitNormalConicPlate_twoCone
    {scale angularConstant normalShift normalShift' : Real} {n n' : Int}
    {direction direction' : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {Z : WaveSpaceTime}
    (hZ : Z ∈ minkowskiSum
      (unitNormalConicPlate scale angularConstant normalShift n direction)
      (unitNormalConicPlate scale angularConstant normalShift' n' direction')) :
    ∃ z ∈ unitNormalConicPlate scale angularConstant normalShift n direction,
      ∃ w ∈ unitNormalConicPlate scale angularConstant normalShift' n' direction',
        z + w = Z ∧
          |(Z.2 - (‖z.1‖ + ‖w.1‖)) - (normalShift + normalShift')| ≤ 4 := by
  rcases hZ with ⟨z, hz, w, hw, hsum⟩
  refine ⟨z, hz, w, hw, hsum, ?_⟩
  have htime : z.2 + w.2 = Z.2 := congrArg Prod.snd hsum
  have hzNormal : |(z.2 - ‖z.1‖) - normalShift| ≤ 2 := hz.2.2.2.2
  have hwNormal : |(w.2 - ‖w.1‖) - normalShift'| ≤ 2 := hw.2.2.2.2
  calc
    |(Z.2 - (‖z.1‖ + ‖w.1‖)) - (normalShift + normalShift')| =
        |((z.2 - ‖z.1‖) - normalShift) +
          ((w.2 - ‖w.1‖) - normalShift')| := by
            rw [← htime]
            ring_nf
    _ ≤ |(z.2 - ‖z.1‖) - normalShift| +
          |(w.2 - ‖w.1‖) - normalShift'| := abs_add_le _ _
    _ ≤ 4 := by linarith

private theorem aux_twoCone_polar_identity
    (X x : _root_.Codex.Spherical.SurfaceCore.Euclidean 2) (hx : ‖x‖ ≠ 0) :
    2 * ‖x‖ *
        ((‖x‖ + ‖X - x‖) -
          inner Real X (‖x‖⁻¹ • x)) =
      (‖x‖ + ‖X - x‖) ^ 2 - ‖X‖ ^ 2 := by
  let r : Real := ‖x‖
  let s : Real := ‖X - x‖
  let u : _root_.Codex.Spherical.SurfaceCore.Euclidean 2 := r⁻¹ • x
  have hr : r ≠ 0 := by simpa only [r] using hx
  have hxu : x = r • u := by
    dsimp [u]
    rw [smul_smul, mul_inv_cancel₀ hr, one_smul]
  have hinner : inner Real X x = r * inner Real X u := by
    rw [hxu, inner_smul_right]
  have hnorm : s ^ 2 = ‖X‖ ^ 2 - 2 * inner Real X x + r ^ 2 := by
    simpa only [r, s] using norm_sub_sq_real X x
  change 2 * r * ((r + s) - inner Real X u) = (r + s) ^ 2 - ‖X‖ ^ 2
  rw [show inner Real X u = r⁻¹ * inner Real X x by
    dsimp [u]
    rw [inner_smul_right]]
  field_simp [hr]
  nlinarith [hnorm]

private theorem aux_twoCone_polar_solve_inner
    (X x : _root_.Codex.Spherical.SurfaceCore.Euclidean 2) (hx : ‖x‖ ≠ 0) :
    inner Real X (‖x‖⁻¹ • x) =
      (‖x‖ + ‖X - x‖) -
        ((‖x‖ + ‖X - x‖) ^ 2 - ‖X‖ ^ 2) / (2 * ‖x‖) := by
  have h := aux_twoCone_polar_identity X x hx
  have hden : 2 * ‖x‖ ≠ 0 := mul_ne_zero (by norm_num) hx
  field_simp [hden] at h ⊢
  linarith

/-- The output radial defect is exactly the squared chordal angular defect of
the two normalized inputs.  This is the quantitative invariant separating the
transverse and near-tangent branches. -/
private theorem aux_twoCone_angular_defect_identity
    (x y : _root_.Codex.Spherical.SurfaceCore.Euclidean 2)
    (hx : ‖x‖ ≠ 0) (hy : ‖y‖ ≠ 0) :
    (‖x‖ + ‖y‖) ^ 2 - ‖x + y‖ ^ 2 =
      ‖x‖ * ‖y‖ * ‖(‖x‖)⁻¹ • x - (‖y‖)⁻¹ • y‖ ^ 2 := by
  let r : Real := ‖x‖
  let s : Real := ‖y‖
  let u : _root_.Codex.Spherical.SurfaceCore.Euclidean 2 := r⁻¹ • x
  let v : _root_.Codex.Spherical.SurfaceCore.Euclidean 2 := s⁻¹ • y
  have hrpos : 0 < r := by
    dsimp [r]
    exact lt_of_le_of_ne (norm_nonneg _) (Ne.symm hx)
  have hspos : 0 < s := by
    dsimp [s]
    exact lt_of_le_of_ne (norm_nonneg _) (Ne.symm hy)
  have hr : r ≠ 0 := ne_of_gt hrpos
  have hs : s ≠ 0 := ne_of_gt hspos
  have hunitu : ‖u‖ = 1 := by
    change ‖r⁻¹ • x‖ = 1
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hrpos)]
    change r⁻¹ * r = 1
    field_simp [hr]
  have hunitv : ‖v‖ = 1 := by
    change ‖s⁻¹ • y‖ = 1
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hspos)]
    change s⁻¹ * s = 1
    field_simp [hs]
  have hxu : x = r • u := by
    dsimp [u]
    rw [smul_smul, mul_inv_cancel₀ hr, one_smul]
  have hyv : y = s • v := by
    dsimp [v]
    rw [smul_smul, mul_inv_cancel₀ hs, one_smul]
  have hru : ‖r • u‖ = r := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hrpos.le, hunitu, mul_one]
  have hsv : ‖s • v‖ = s := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hspos.le, hunitv, mul_one]
  have hinter : inner Real (r • u) (s • v) = r * s * inner Real u v := by
    rw [inner_smul_left, inner_smul_right]
    simp [mul_assoc]
  have hsum : ‖x + y‖ ^ 2 = r ^ 2 + 2 * r * s * inner Real u v + s ^ 2 := by
    calc
      ‖x + y‖ ^ 2 = ‖r • u + s • v‖ ^ 2 := by rw [hxu, hyv]
      _ = ‖r • u‖ ^ 2 + 2 * inner Real (r • u) (s • v) + ‖s • v‖ ^ 2 :=
        norm_add_sq_real _ _
      _ = r ^ 2 + 2 * r * s * inner Real u v + s ^ 2 := by
        rw [hru, hsv, hinter]
        ring
  have hsub : ‖u - v‖ ^ 2 = 2 - 2 * inner Real u v := by
    rw [norm_sub_sq_real, hunitu, hunitv]
    ring
  change (r + s) ^ 2 - ‖x + y‖ ^ 2 = r * s * ‖u - v‖ ^ 2
  rw [hsum, hsub]
  ring

/-- On either fixed oriented branch of the unit circle, controlling the
inner-product coordinate against a nonzero vector controls the direction.
This is the transverse half of the two-branch reduction. -/
private theorem aux_unit_same_area_branch_direction_bound
    (o : Orientation Real (_root_.Codex.Spherical.SurfaceCore.Euclidean 2) (Fin 2))
    {X u u' : _root_.Codex.Spherical.SurfaceCore.Euclidean 2} {A D : Real}
    (hX : 0 < ‖X‖) (hA : 0 < A)
    (hu : ‖u‖ = 1) (hu' : ‖u'‖ = 1)
    (harea : A ≤ |(o.areaForm X) u| ∧ A ≤ |(o.areaForm X) u'|)
    (hsign : (0 ≤ (o.areaForm X) u ∧ 0 ≤ (o.areaForm X) u') ∨
      ((o.areaForm X) u ≤ 0 ∧ (o.areaForm X) u' ≤ 0))
    (hinner : |inner Real X u - inner Real X u'| ≤ D) :
    ‖u - u'‖ ≤ D / ‖X‖ + D / A := by
  let N : Real := ‖X‖
  let c : Real := inner Real X u
  let c' : Real := inner Real X u'
  let a : Real := (o.areaForm X) u
  let a' : Real := (o.areaForm X) u'
  have hN : 0 < N := by simpa only [N] using hX
  have hcircle : c ^ 2 + a ^ 2 = N ^ 2 := by
    calc
      c ^ 2 + a ^ 2 = ‖X‖ ^ 2 * ‖u‖ ^ 2 := by
        simpa only [c, a] using o.inner_sq_add_areaForm_sq X u
      _ = N ^ 2 := by rw [hu]; simp only [N, one_pow, mul_one]
  have hcircle' : c' ^ 2 + a' ^ 2 = N ^ 2 := by
    calc
      c' ^ 2 + a' ^ 2 = ‖X‖ ^ 2 * ‖u'‖ ^ 2 := by
        simpa only [c', a'] using o.inner_sq_add_areaForm_sq X u'
      _ = N ^ 2 := by rw [hu']; simp only [N, one_pow, mul_one]
  have hc : |c| ≤ N := by
    simpa only [N, c, hu, mul_one] using abs_real_inner_le_norm X u
  have hc' : |c'| ≤ N := by
    simpa only [N, c', hu', mul_one] using abs_real_inner_le_norm X u'
  have hsumc : |c + c'| ≤ 2 * N := by
    calc
      |c + c'| ≤ |c| + |c'| := abs_add_le _ _
      _ ≤ N + N := add_le_add hc hc'
      _ = 2 * N := by ring
  have hsumapos : 2 * A ≤ |a + a'| := by
    rcases hsign with hnonneg | hnonpos
    · have hnonneg' : 0 ≤ a ∧ 0 ≤ a' := by
        simpa only [a, a'] using hnonneg
      change A ≤ |a| ∧ A ≤ |a'| at harea
      rw [abs_of_nonneg hnonneg'.1, abs_of_nonneg hnonneg'.2] at harea
      rw [abs_of_nonneg (add_nonneg hnonneg'.1 hnonneg'.2)]
      linarith [harea.1, harea.2]
    · have hnonpos' : a ≤ 0 ∧ a' ≤ 0 := by
        simpa only [a, a'] using hnonpos
      change A ≤ |a| ∧ A ≤ |a'| at harea
      rw [abs_of_nonpos hnonpos'.1, abs_of_nonpos hnonpos'.2] at harea
      rw [abs_of_nonpos (add_nonpos hnonpos'.1 hnonpos'.2)]
      linarith [harea.1, harea.2]
  have hprod : |a - a'| * |a + a'| = |c - c'| * |c + c'| := by
    rw [← abs_mul, ← abs_mul]
    have hfactor : (a - a') * (a + a') = -((c - c') * (c + c')) := by
      nlinarith [hcircle, hcircle']
    rw [hfactor, abs_neg]
  have hdiffc : |c - c'| ≤ D := by
    simpa only [c, c', sub_eq_add_neg, abs_neg] using hinner
  have hDnonneg : 0 ≤ D := le_trans (abs_nonneg _) hdiffc
  have hareaTimes : |a - a'| * (2 * A) ≤ D * (2 * N) := by
    calc
      |a - a'| * (2 * A) ≤ |a - a'| * |a + a'| := by
        gcongr
      _ = |c - c'| * |c + c'| := hprod
      _ ≤ D * (2 * N) := by gcongr
  have haDiff : |a - a'| ≤ D * N / A := by
    have hAne : A ≠ 0 := ne_of_gt hA
    field_simp [hAne]
    nlinarith [hareaTimes]
  have hinter : c * c' + a * a' = N ^ 2 * inner Real u u' := by
    simpa only [N, c, c', a, a'] using o.inner_mul_inner_add_areaForm_mul_areaForm X u u'
  have hmetric : N ^ 2 * ‖u - u'‖ ^ 2 = (c - c') ^ 2 + (a - a') ^ 2 := by
    rw [norm_sub_sq_real, hu, hu']
    nlinarith [hcircle, hcircle', hinter]
  have hnonneg : 0 ≤ |c - c'| + |a - a'| := add_nonneg (abs_nonneg _) (abs_nonneg _)
  have hsquare : ‖u - u'‖ ^ 2 ≤ ((|c - c'| + |a - a'|) / N) ^ 2 := by
    have hsumSquares : (c - c') ^ 2 + (a - a') ^ 2 ≤
        (|c - c'| + |a - a'|) ^ 2 := by
      nlinarith [sq_abs (c - c'), sq_abs (a - a'),
        abs_nonneg (c - c'), abs_nonneg (a - a')]
    have hNne : N ≠ 0 := ne_of_gt hN
    field_simp [hNne]
    nlinarith [hmetric, hsumSquares]
  have hdirection : ‖u - u'‖ ≤ (|c - c'| + |a - a'|) / N := by
    apply (sq_le_sq₀ (norm_nonneg _) (div_nonneg hnonneg hN.le)).mp
    exact hsquare
  calc
    ‖u - u'‖ ≤ (|c - c'| + |a - a'|) / N := hdirection
    _ ≤ (D + D * N / A) / N := by gcongr
    _ = D / N + D / A := by
      field_simp [ne_of_gt hN, ne_of_gt hA]
    _ = D / ‖X‖ + D / A := by rfl

/-- Normalizing a vector which is close to a positive multiple of a unit
direction changes it by at most twice the relative approximation error. -/
private theorem aux_normalized_sub_unit_le_two_mul_error_div
    {x u : _root_.Codex.Spherical.SurfaceCore.Euclidean 2} {a e : Real}
    (hx : x ≠ 0) (ha : 0 < a) (hu : ‖u‖ = 1)
    (happrox : ‖x - a • u‖ ≤ e) :
    ‖(‖x‖)⁻¹ • x - u‖ ≤ 2 * e / a := by
  let N : Real := ‖x‖
  have hN : 0 < N := by
    change 0 < ‖x‖
    exact norm_pos_iff.mpr hx
  have hNne : N ≠ 0 := ne_of_gt hN
  have hane : a ≠ 0 := ne_of_gt ha
  have hnormau : ‖a • u‖ = a := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos ha, hu, mul_one]
  have hradial : |N - a| ≤ e := by
    change |‖x‖ - a| ≤ e
    calc
      |‖x‖ - a| = |‖x‖ - ‖a • u‖| := by rw [hnormau]
      _ ≤ ‖x - a • u‖ := abs_norm_sub_norm_le _ _
      _ ≤ e := happrox
  have hdecomp :
      N⁻¹ • x - u = (N⁻¹ - a⁻¹) • x + a⁻¹ • (x - a • u) := by
    calc
      N⁻¹ • x - u = N⁻¹ • x - (a⁻¹ * a) • u := by
        rw [inv_mul_cancel₀ hane, one_smul]
      _ = N⁻¹ • x - a⁻¹ • (a • u) := by rw [smul_smul]
      _ = (N⁻¹ - a⁻¹) • x + a⁻¹ • (x - a • u) := by
        rw [sub_smul, smul_sub]
        abel
  have hinv : |N⁻¹ - a⁻¹| * N = |N - a| / a := by
    have hformula : N⁻¹ - a⁻¹ = (a - N) / (N * a) := by
      field_simp [hNne, hane]
    rw [hformula, abs_div]
    rw [abs_of_pos (mul_pos hN ha), abs_sub_comm]
    field_simp [hNne, hane]
  have hnormx : ‖x‖ = N := rfl
  have hinva : ‖a⁻¹‖ = a⁻¹ := by
    rw [Real.norm_eq_abs, abs_of_pos (inv_pos.mpr ha)]
  calc
    ‖(‖x‖)⁻¹ • x - u‖ = ‖N⁻¹ • x - u‖ := by rfl
    _ = ‖(N⁻¹ - a⁻¹) • x + a⁻¹ • (x - a • u)‖ := by rw [hdecomp]
    _ ≤ ‖(N⁻¹ - a⁻¹) • x‖ + ‖a⁻¹ • (x - a • u)‖ := norm_add_le _ _
    _ = |N⁻¹ - a⁻¹| * N + a⁻¹ * ‖x - a • u‖ := by
      rw [norm_smul, norm_smul, Real.norm_eq_abs, hnormx, hinva]
    _ = |N - a| / a + a⁻¹ * ‖x - a • u‖ := by rw [hinv]
    _ ≤ e / a + a⁻¹ * e := by gcongr
    _ = 2 * e / a := by
      field_simp [hane]
      ring

/-- Exact chord--area relation for two unit directions in the plane. -/
private theorem aux_unit_area_sq_eq_chord
    (o : Orientation Real (_root_.Codex.Spherical.SurfaceCore.Euclidean 2) (Fin 2))
    {u v : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hu : ‖u‖ = 1) (hv : ‖v‖ = 1) :
    ((o.areaForm u) v) ^ 2 =
      ‖u - v‖ ^ 2 * (1 - ‖u - v‖ ^ 2 / 4) := by
  have harea := o.inner_sq_add_areaForm_sq u v
  have hsub := norm_sub_sq_real u v
  rw [hu, hv] at harea hsub
  nlinarith [harea, hsub]

private theorem aux_unit_chord_le_two_mul_abs_area_of_norm_sub_le_one
    (o : Orientation Real (_root_.Codex.Spherical.SurfaceCore.Euclidean 2) (Fin 2))
    {u v : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hu : ‖u‖ = 1) (hv : ‖v‖ = 1) (hclose : ‖u - v‖ ≤ 1) :
    ‖u - v‖ ≤ 2 * |(o.areaForm u) v| := by
  have harea := aux_unit_area_sq_eq_chord o hu hv
  have hnorm : 0 ≤ ‖u - v‖ := norm_nonneg _
  have hcloseSq : ‖u - v‖ ^ 2 ≤ 1 := by
    have hprod := mul_nonneg hnorm (sub_nonneg.mpr hclose)
    nlinarith
  have hthree : 0 ≤ 3 - ‖u - v‖ ^ 2 := by linarith
  have hfactor : 0 ≤ ‖u - v‖ ^ 2 * (3 - ‖u - v‖ ^ 2) :=
    mul_nonneg (sq_nonneg _) hthree
  have hsq : ‖u - v‖ ^ 2 ≤ (2 * |(o.areaForm u) v|) ^ 2 := by
    nlinarith [harea, sq_abs ((o.areaForm u) v)]
  apply (sq_le_sq₀ hnorm (by positivity)).mp
  exact hsq

private theorem aux_area_sum_right
    (o : Orientation Real (_root_.Codex.Spherical.SurfaceCore.Euclidean 2) (Fin 2))
    (r s : Real) (u v : _root_.Codex.Spherical.SurfaceCore.Euclidean 2) :
    (o.areaForm (r • u + s • v)) u = s * (o.areaForm v) u := by
  rw [map_add, map_smul, map_smul]
  change r * (o.areaForm u) u + s * (o.areaForm v) u = s * (o.areaForm v) u
  rw [o.areaForm_apply_self, mul_zero, zero_add]

private theorem aux_two_mul_sqrt_div_sum_le_scaled
    {scale r s C : Real} (hscale : 0 < scale) (hC : 0 ≤ C)
    (hr : scale / 4 ≤ r) (hs : scale / 4 ≤ s) :
    2 * (2 * C * Real.sqrt scale) / (r + s) ≤
      8 * C * scale ^ (-(1 / 2 : Real)) := by
  have hsum : scale / 2 ≤ r + s := by linarith
  have hsumpos : 0 < r + s := by linarith
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  have hrpow : scale ^ (-(1 / 2 : Real)) * scale = Real.sqrt scale := by
    calc
      scale ^ (-(1 / 2 : Real)) * scale =
          scale ^ (-(1 / 2 : Real)) * scale ^ (1 : Real) := by rw [Real.rpow_one]
      _ = scale ^ (-(1 / 2 : Real) + (1 : Real)) :=
        (Real.rpow_add hscale _ _).symm
      _ = Real.sqrt scale := by
        convert (Real.sqrt_eq_rpow scale).symm using 1 <;> norm_num
  apply (div_le_iff₀ hsumpos).mpr
  calc
    2 * (2 * C * Real.sqrt scale) =
        (8 * C * scale ^ (-(1 / 2 : Real))) * (scale / 2) := by
      rw [← hrpow]
      ring
    _ ≤ (8 * C * scale ^ (-(1 / 2 : Real))) * (r + s) := by
      gcongr

/-- Small output-oriented area is the tangent alternative: because both
input radii are elliptic-scale, the first normalized input lies in one
`O(scale⁻¹ᐟ²)` cap about the normalized output direction. -/
private theorem aux_tangent_cap_of_small_area
    (o : Orientation Real (_root_.Codex.Spherical.SurfaceCore.Euclidean 2) (Fin 2))
    {scale r s C : Real} {X u v : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hscale : 0 < scale) (hC : 0 ≤ C)
    (hr : scale / 4 ≤ r) (hs : scale / 4 ≤ s)
    (hX : X = r • u + s • v) (hXnonzero : X ≠ 0)
    (hu : ‖u‖ = 1) (hv : ‖v‖ = 1) (hclose : ‖u - v‖ ≤ 1)
    (hsmall : |(o.areaForm X) u| ≤ C * Real.sqrt scale) :
    ‖(‖X‖)⁻¹ • X - u‖ ≤ 8 * C * scale ^ (-(1 / 2 : Real)) := by
  have hsnonneg : 0 ≤ s := by linarith
  have hsumpos : 0 < r + s := by linarith
  have hareaX : (o.areaForm X) u = s * (o.areaForm v) u := by
    rw [hX]
    exact aux_area_sum_right o r s u v
  have hchord : ‖u - v‖ ≤ 2 * |(o.areaForm v) u| := by
    have h := aux_unit_chord_le_two_mul_abs_area_of_norm_sub_le_one o hu hv hclose
    have hswap : |(o.areaForm u) v| = |(o.areaForm v) u| := by
      rw [o.areaForm_swap, abs_neg]
    rw [hswap] at h
    exact h
  have hsd : s * ‖u - v‖ ≤ 2 * |(o.areaForm X) u| := by
    calc
      s * ‖u - v‖ ≤ s * (2 * |(o.areaForm v) u|) :=
        mul_le_mul_of_nonneg_left hchord hsnonneg
      _ = 2 * |s * (o.areaForm v) u| := by
        rw [abs_mul, abs_of_nonneg hsnonneg]
        ring
      _ = 2 * |(o.areaForm X) u| := by rw [← hareaX]
  have hsdsmall : s * ‖u - v‖ ≤ 2 * C * Real.sqrt scale := by
    calc
      s * ‖u - v‖ ≤ 2 * |(o.areaForm X) u| := hsd
      _ ≤ 2 * (C * Real.sqrt scale) := by gcongr
      _ = 2 * C * Real.sqrt scale := by ring
  have hsub : X - (r + s) • u = s • (v - u) := by
    rw [hX, add_smul, smul_sub]
    abel
  have happrox : ‖X - (r + s) • u‖ ≤ s * ‖u - v‖ := by
    calc
      ‖X - (r + s) • u‖ = ‖s • (v - u)‖ := by rw [hsub]
      _ = s * ‖v - u‖ := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hsnonneg]
      _ = s * ‖u - v‖ := by rw [norm_sub_rev]
      _ ≤ s * ‖u - v‖ := le_rfl
  have hnormal := aux_normalized_sub_unit_le_two_mul_error_div
    hXnonzero hsumpos hu happrox
  calc
    ‖(‖X‖)⁻¹ • X - u‖ ≤ 2 * (s * ‖u - v‖) / (r + s) := hnormal
    _ ≤ 2 * (2 * C * Real.sqrt scale) / (r + s) := by gcongr
    _ ≤ 8 * C * scale ^ (-(1 / 2 : Real)) :=
      aux_two_mul_sqrt_div_sum_le_scaled hscale hC hr hs

/-- In the transverse alternative, a lower chordal separation of the two
normalized inputs forces output-oriented area of order `sqrt scale`. -/
private theorem aux_transverse_area_lower_of_chord_lower
    (o : Orientation Real (_root_.Codex.Spherical.SurfaceCore.Euclidean 2) (Fin 2))
    {scale r s lambda : Real} {X u v : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hscale : 0 < scale) (hs : scale / 4 ≤ s) (hlambda : 0 ≤ lambda)
    (hX : X = r • u + s • v)
    (hu : ‖u‖ = 1) (hv : ‖v‖ = 1) (hclose : ‖u - v‖ ≤ 1)
    (hgap : lambda * scale ^ (-(1 / 2 : Real)) ≤ ‖u - v‖) :
    lambda * Real.sqrt scale / 8 ≤ |(o.areaForm X) u| := by
  have hsnonneg : 0 ≤ s := by linarith
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  have hrpow : scale ^ (-(1 / 2 : Real)) * scale = Real.sqrt scale := by
    calc
      scale ^ (-(1 / 2 : Real)) * scale =
          scale ^ (-(1 / 2 : Real)) * scale ^ (1 : Real) := by rw [Real.rpow_one]
      _ = scale ^ (-(1 / 2 : Real) + (1 : Real)) :=
        (Real.rpow_add hscale _ _).symm
      _ = Real.sqrt scale := by
        convert (Real.sqrt_eq_rpow scale).symm using 1 <;> norm_num
  have hareaX : (o.areaForm X) u = s * (o.areaForm v) u := by
    rw [hX]
    exact aux_area_sum_right o r s u v
  have hchord : ‖u - v‖ ≤ 2 * |(o.areaForm v) u| := by
    have h := aux_unit_chord_le_two_mul_abs_area_of_norm_sub_le_one o hu hv hclose
    have hswap : |(o.areaForm u) v| = |(o.areaForm v) u| := by
      rw [o.areaForm_swap, abs_neg]
    rw [hswap] at h
    exact h
  have hsd : s * ‖u - v‖ ≤ 2 * |(o.areaForm X) u| := by
    calc
      s * ‖u - v‖ ≤ s * (2 * |(o.areaForm v) u|) :=
        mul_le_mul_of_nonneg_left hchord hsnonneg
      _ = 2 * |s * (o.areaForm v) u| := by
        rw [abs_mul, abs_of_nonneg hsnonneg]
        ring
      _ = 2 * |(o.areaForm X) u| := by rw [← hareaX]
  have hscaled : (scale / 4) * (lambda * scale ^ (-(1 / 2 : Real))) ≤
      2 * |(o.areaForm X) u| := by
    calc
      (scale / 4) * (lambda * scale ^ (-(1 / 2 : Real))) ≤
          s * (lambda * scale ^ (-(1 / 2 : Real))) := by
        gcongr
      _ ≤ s * ‖u - v‖ := mul_le_mul_of_nonneg_left hgap hsnonneg
      _ ≤ 2 * |(o.areaForm X) u| := hsd
  have hrewrite :
      (scale / 4) * (lambda * scale ^ (-(1 / 2 : Real))) =
        lambda * Real.sqrt scale / 4 := by
    rw [← hrpow]

    ring
  rw [hrewrite] at hscaled
  linarith

private theorem aux_chord_lower_of_center_direction_bounds
    {h L A : Real} {a b u v : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hcenters : L * h ≤ ‖a - b‖)
    (hu : ‖u - a‖ ≤ A * h) (hv : ‖v - b‖ ≤ A * h) :
    (L - 2 * A) * h ≤ ‖u - v‖ := by
  have htriangle : ‖a - b‖ ≤ ‖a - u‖ + ‖u - v‖ + ‖v - b‖ := by
    calc
      ‖a - b‖ = ‖(a - u) + (u - v) + (v - b)‖ := by congr 1 <;> abel
      _ ≤ ‖(a - u) + (u - v)‖ + ‖v - b‖ := norm_add_le _ _
      _ ≤ ‖a - u‖ + ‖u - v‖ + ‖v - b‖ := by
        gcongr
        exact norm_add_le _ _
  rw [norm_sub_rev] at hu
  nlinarith [hcenters, htriangle, hu, hv]

private theorem aux_chord_upper_of_center_direction_bounds
    {h U A : Real} {a b u v : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hcenters : ‖a - b‖ ≤ U * h)
    (hu : ‖u - a‖ ≤ A * h) (hv : ‖v - b‖ ≤ A * h) :
    ‖u - v‖ ≤ (U + 2 * A) * h := by
  have htriangle : ‖u - v‖ ≤ ‖u - a‖ + ‖a - b‖ + ‖b - v‖ := by
    calc
      ‖u - v‖ = ‖(u - a) + (a - b) + (b - v)‖ := by congr 1 <;> abel
      _ ≤ ‖(u - a) + (a - b)‖ + ‖b - v‖ := norm_add_le _ _
      _ ≤ ‖u - a‖ + ‖a - b‖ + ‖b - v‖ := by
        gcongr
        exact norm_add_le _ _
  rw [norm_sub_rev] at hv
  nlinarith [hcenters, htriangle, hu, hv]

private theorem aux_output_normalized_cap_of_chord_upper
    {scale r s B : Real} {X u v : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hscale : 0 < scale) (hB : 0 ≤ B)
    (hr : scale / 4 ≤ r) (hs : scale / 4 ≤ s) (hsupper : s ≤ 4 * scale)
    (hX : X = r • u + s • v) (hXnonzero : X ≠ 0) (hu : ‖u‖ = 1)
    (hchord : ‖u - v‖ ≤ B * scale ^ (-(1 / 2 : Real))) :
    ‖(‖X‖)⁻¹ • X - u‖ ≤ 16 * B * scale ^ (-(1 / 2 : Real)) := by
  have hsnonneg : 0 ≤ s := by linarith
  have hsumpos : 0 < r + s := by linarith
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  have hrpow : scale ^ (-(1 / 2 : Real)) * scale = Real.sqrt scale := by
    calc
      scale ^ (-(1 / 2 : Real)) * scale =
          scale ^ (-(1 / 2 : Real)) * scale ^ (1 : Real) := by rw [Real.rpow_one]
      _ = scale ^ (-(1 / 2 : Real) + (1 : Real)) :=
        (Real.rpow_add hscale _ _).symm
      _ = Real.sqrt scale := by
        convert (Real.sqrt_eq_rpow scale).symm using 1 <;> norm_num
  have hsub : X - (r + s) • u = s • (v - u) := by
    rw [hX, add_smul, smul_sub]
    abel
  have happrox : ‖X - (r + s) • u‖ ≤ s * ‖u - v‖ := by
    calc
      ‖X - (r + s) • u‖ = ‖s • (v - u)‖ := by rw [hsub]
      _ = s * ‖v - u‖ := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hsnonneg]
      _ = s * ‖u - v‖ := by rw [norm_sub_rev]
      _ ≤ s * ‖u - v‖ := le_rfl
  have herror : s * ‖u - v‖ ≤ 4 * B * Real.sqrt scale := by
    calc
      s * ‖u - v‖ ≤ s * (B * scale ^ (-(1 / 2 : Real))) :=
        mul_le_mul_of_nonneg_left hchord hsnonneg
      _ ≤ (4 * scale) * (B * scale ^ (-(1 / 2 : Real))) := by
        gcongr
      _ = 4 * B * Real.sqrt scale := by
        rw [← hrpow]
        ring
  have hnormal := aux_normalized_sub_unit_le_two_mul_error_div
    hXnonzero hsumpos hu happrox
  calc
    ‖(‖X‖)⁻¹ • X - u‖ ≤ 2 * (s * ‖u - v‖) / (r + s) := hnormal
    _ ≤ 2 * (4 * B * Real.sqrt scale) / (r + s) := by gcongr
    _ = 2 * (2 * (2 * B) * Real.sqrt scale) / (r + s) := by ring
    _ ≤ 8 * (2 * B) * scale ^ (-(1 / 2 : Real)) :=
      aux_two_mul_sqrt_div_sum_le_scaled hscale (by positivity) hr hs
    _ = 16 * B * scale ^ (-(1 / 2 : Real)) := by ring

/-- Stability of the polar inner-product coordinate under coupled changes in
the total radius and the first radius.  The two error terms are exactly the
ones supplied by the normal/time and radial plate windows. -/
private theorem aux_polar_inner_coordinate_difference_bound
    {r r' tau tau' defect defect' : Real}
    (hr : 0 < r) (hr' : 0 < r') (hdefect' : 0 ≤ defect') :
    |(tau - defect / (2 * r)) - (tau' - defect' / (2 * r'))| ≤
      |tau - tau'| + |defect - defect'| / (2 * r) +
        defect' * |r - r'| / (2 * r * r') := by
  have hrne : r ≠ 0 := ne_of_gt hr
  have hr'ne : r' ≠ 0 := ne_of_gt hr'
  have hden : 0 < 2 * r := by positivity
  have hden' : 0 < 2 * r * r' := by positivity
  have hid : defect / (2 * r) - defect' / (2 * r') =
      (defect - defect') / (2 * r) +
        defect' * (r' - r) / (2 * r * r') := by
    field_simp [hrne, hr'ne]
    ring
  calc
    |(tau - defect / (2 * r)) - (tau' - defect' / (2 * r'))| =
        |(tau - tau') -
          ((defect - defect') / (2 * r) +
            defect' * (r' - r) / (2 * r * r'))| := by
      rw [sub_sub_sub_comm, hid]
    _ ≤ |tau - tau'| +
        |(defect - defect') / (2 * r) +
          defect' * (r' - r) / (2 * r * r')| := by
      calc
        |(tau - tau') -
            ((defect - defect') / (2 * r) +
              defect' * (r' - r) / (2 * r * r'))| ≤
            |(tau - tau') - 0| +
              |0 - ((defect - defect') / (2 * r) +
                defect' * (r' - r) / (2 * r * r'))| :=
          abs_sub_le _ _ _
        _ = |tau - tau'| +
            |(defect - defect') / (2 * r) +
              defect' * (r' - r) / (2 * r * r')| := by
          rw [sub_zero, zero_sub, abs_neg]
    _ ≤ |tau - tau'| + |(defect - defect') / (2 * r)| +
        |defect' * (r' - r) / (2 * r * r')| := by
      simpa only [add_comm, add_left_comm, add_assoc] using
        add_le_add_left
          (abs_add_le ((defect - defect') / (2 * r))
            (defect' * (r' - r) / (2 * r * r')))
          |tau - tau'|
    _ = |tau - tau'| + |defect - defect'| / (2 * r) +
        defect' * |r - r'| / (2 * r * r') := by
      rw [abs_div, abs_of_pos hden, abs_div, abs_mul, abs_of_nonneg hdefect',
        abs_of_pos hden']
      rw [show |r' - r| = |r - r'| by exact abs_sub_comm _ _]

private theorem aux_abs_sub_le_two_mul_common_window
    {a b center E : Real} (ha : |a - center| ≤ E) (hb : |b - center| ≤ E) :
    |a - b| ≤ 2 * E := by
  calc
    |a - b| ≤ |a - center| + |center - b| := abs_sub_le _ _ _
    _ = |a - center| + |b - center| := by
      exact congrArg (fun q : Real => |a - center| + q) (abs_sub_comm center b)
    _ ≤ E + E := add_le_add ha hb
    _ = 2 * E := by ring

private theorem aux_radial_window_difference_le_six_sqrt
    {scale r r' center : Real} (hscale : 2 ≤ scale)
    (hr : |r - center| ≤ Real.sqrt scale + 2)
    (hr' : |r' - center| ≤ Real.sqrt scale + 2) :
    |r - r'| ≤ 6 * Real.sqrt scale := by
  have hsqrt : 1 ≤ Real.sqrt scale := by
    rw [← Real.sqrt_one]
    exact Real.sqrt_le_sqrt (le_trans (by norm_num) hscale)
  have hdiff := aux_abs_sub_le_two_mul_common_window hr hr'
  nlinarith

/-- The literal unit-normal windows for two summands with the same output
give a scale-free bound for the difference of their total radii. -/
private theorem aux_total_radius_difference_le_eight
    {a b center : Real} (ha : |a - center| ≤ 4) (hb : |b - center| ≤ 4) :
    |a - b| ≤ 8 := by
  have h := aux_abs_sub_le_two_mul_common_window ha hb
  norm_num at h ⊢
  exact h

private theorem aux_sum_radius_bounds
    {scale r s : Real} (hscale : 0 ≤ scale)
    (hrlo : scale / 4 ≤ r) (hrhi : r ≤ 4 * scale)
    (hslo : scale / 4 ≤ s) (hshi : s ≤ 4 * scale) :
    scale / 2 ≤ r + s ∧ r + s ≤ 8 * scale := by
  constructor <;> nlinarith

/-- Squared total-radius defects of two active pairs sharing an output differ
by at most `128 * scale` once each total radius lies in `[scale/2, 8 scale]`
and the normal-coordinate windows give a difference at most eight. -/
private theorem aux_defect_difference_le_one_twenty_eight_mul_scale
    {scale tau tau' Xnorm : Real} (hscale : 0 ≤ scale)
    (htau : 0 ≤ tau) (htau' : 0 ≤ tau')
    (htauupper : tau ≤ 8 * scale) (htau'upper : tau' ≤ 8 * scale)
    (hdiff : |tau - tau'| ≤ 8) :
    |(tau ^ 2 - Xnorm ^ 2) - (tau' ^ 2 - Xnorm ^ 2)| ≤ 128 * scale := by
  have hsum : |tau + tau'| ≤ 16 * scale := by
    rw [abs_of_nonneg (by linarith)]
    linarith
  have hfactor :
      |(tau ^ 2 - Xnorm ^ 2) - (tau' ^ 2 - Xnorm ^ 2)| =
        |tau - tau'| * |tau + tau'| := by
    rw [← abs_mul]
    congr 1
    ring
  rw [hfactor]
  calc
    |tau - tau'| * |tau + tau'| ≤ 8 * (16 * scale) :=
      mul_le_mul hdiff hsum (abs_nonneg _) (by norm_num)
    _ = 128 * scale := by ring

/-- Direct polar-coordinate stability for two literal plate witnesses.  The
three terms are respectively the normal/time window, the resulting total
radius-defect window, and the radial-label window. -/
private theorem aux_polar_inner_coordinate_difference_le_constant
    {scale r r' tau tau' defect defect' B : Real}
    (hscale : 2 ≤ scale)
    (hr : scale / 4 ≤ r) (hr' : scale / 4 ≤ r')
    (htau : |tau - tau'| ≤ 8)
    (hdefect : |defect - defect'| ≤ 128 * scale)
    (hdefect'nonneg : 0 ≤ defect')
    (hdefect'upper : defect' ≤ 16 * B ^ 2 * scale)
    (hradial : |r - r'| ≤ 6 * Real.sqrt scale) :
    |(tau - defect / (2 * r)) - (tau' - defect' / (2 * r'))| ≤
      264 + 768 * B ^ 2 * scale ^ (-(1 / 2 : Real)) := by
  have hscalepos : 0 < scale := by linarith
  have hrpos : 0 < r := by linarith
  have hr'pos : 0 < r' := by linarith
  have hsqrtnonneg : 0 ≤ Real.sqrt scale := Real.sqrt_nonneg _
  have hrpow : scale ^ (-(1 / 2 : Real)) * scale = Real.sqrt scale := by
    calc
      scale ^ (-(1 / 2 : Real)) * scale =
          scale ^ (-(1 / 2 : Real)) * scale ^ (1 : Real) := by rw [Real.rpow_one]
      _ = scale ^ (-(1 / 2 : Real) + (1 : Real)) :=
        (Real.rpow_add hscalepos _ _).symm
      _ = Real.sqrt scale := by
        convert (Real.sqrt_eq_rpow scale).symm using 1 <;> norm_num
  have hrr : scale ^ 2 / 16 ≤ r * r' := by
    have hmul := mul_le_mul hr hr' (by linarith : 0 ≤ scale / 4) (by linarith : 0 ≤ r)
    nlinarith [hmul]
  have hterm₂ : |defect - defect'| / (2 * r) ≤ 256 := by
    have hden : 0 < 2 * r := by positivity
    calc
      |defect - defect'| / (2 * r) ≤ (128 * scale) / (2 * r) :=
        div_le_div_of_nonneg_right hdefect hden.le
      _ ≤ 256 := by
        apply (div_le_iff₀ hden).mpr
        nlinarith
  have hterm₃ : defect' * |r - r'| / (2 * r * r') ≤
      768 * B ^ 2 * scale ^ (-(1 / 2 : Real)) := by
    have hden : 0 < 2 * r * r' := by positivity
    have hupper : 0 ≤ 16 * B ^ 2 * scale := by positivity
    have hnum : defect' * |r - r'| ≤
        (16 * B ^ 2 * scale) * (6 * Real.sqrt scale) :=
      by exact mul_le_mul hdefect'upper hradial (abs_nonneg _) hupper
    calc
      defect' * |r - r'| / (2 * r * r') ≤
          ((16 * B ^ 2 * scale) * (6 * Real.sqrt scale)) / (2 * r * r') :=
        div_le_div_of_nonneg_right hnum hden.le
      _ ≤ 768 * B ^ 2 * scale ^ (-(1 / 2 : Real)) := by
        apply (div_le_iff₀ hden).mpr
        calc
          (16 * B ^ 2 * scale) * (6 * Real.sqrt scale) ≤
              96 * B ^ 2 * (scale * Real.sqrt scale) := by
            nlinarith
          _ = (768 * B ^ 2 * scale ^ (-(1 / 2 : Real))) *
              (2 * (scale ^ 2 / 16)) := by
            rw [show scale * Real.sqrt scale =
              scale ^ (-(1 / 2 : Real)) * scale ^ 2 by
                calc
                  scale * Real.sqrt scale = Real.sqrt scale * scale := mul_comm _ _
                  _ = (scale ^ (-(1 / 2 : Real)) * scale) * scale := by rw [hrpow]
                  _ = scale ^ (-(1 / 2 : Real)) * scale ^ 2 := by ring]
            ring
          _ ≤ (768 * B ^ 2 * scale ^ (-(1 / 2 : Real))) *
              (2 * (r * r')) := by gcongr
          _ = (768 * B ^ 2 * scale ^ (-(1 / 2 : Real))) *
              (2 * r * r') := by ring
  calc
    |(tau - defect / (2 * r)) - (tau' - defect' / (2 * r'))| ≤
        |tau - tau'| + |defect - defect'| / (2 * r) +
          defect' * |r - r'| / (2 * r * r') :=
      aux_polar_inner_coordinate_difference_bound hrpos hr'pos hdefect'nonneg
    _ ≤ 8 + 256 + 768 * B ^ 2 * scale ^ (-(1 / 2 : Real)) := by gcongr
    _ = 264 + 768 * B ^ 2 * scale ^ (-(1 / 2 : Real)) := by ring

/-- An angular chord of size `B * scale⁻¹ᐟ²` gives a defect of order
`B² * scale` on the literal dyadic annulus. -/
private theorem aux_defect_upper_of_chord_upper
    {scale r s defect B chord : Real}
    (hscale : 0 < scale) (hB : 0 ≤ B)
    (hrnonneg : 0 ≤ r) (hsnonneg : 0 ≤ s)
    (hrupper : r ≤ 4 * scale) (hsupper : s ≤ 4 * scale)
    (hdefect : defect = r * s * chord ^ 2)
    (hchord : chord ≤ B * scale ^ (-(1 / 2 : Real)))
    (hchordnonneg : 0 ≤ chord) :
    defect ≤ 16 * B ^ 2 * scale := by
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  have hright : 0 ≤ B * scale ^ (-(1 / 2 : Real)) := mul_nonneg hB hpow
  have hchordSq : chord ^ 2 ≤ (B * scale ^ (-(1 / 2 : Real))) ^ 2 := by
    exact (sq_le_sq₀ hchordnonneg hright).mpr hchord
  have hrs : r * s ≤ (4 * scale) * (4 * scale) :=
    mul_le_mul hrupper hsupper hsnonneg (by positivity)
  have hprod : r * s * chord ^ 2 ≤
      ((4 * scale) * (4 * scale)) *
        (B * scale ^ (-(1 / 2 : Real))) ^ 2 := by
    exact mul_le_mul hrs hchordSq (sq_nonneg _) (by positivity)
  have hsqrt : (Real.sqrt scale) ^ 2 = scale := Real.sq_sqrt hscale.le
  have hinv : Real.sqrt scale * scale ^ (-(1 / 2 : Real)) = 1 := by
    calc
      Real.sqrt scale * scale ^ (-(1 / 2 : Real)) =
          scale ^ (1 / 2 : Real) * scale ^ (-(1 / 2 : Real)) := by
            rw [← Real.sqrt_eq_rpow]
      _ = scale ^ ((1 / 2 : Real) + (-(1 / 2 : Real))) :=
        (Real.rpow_add hscale _ _).symm
      _ = 1 := by norm_num
  have hscalePow : scale ^ 2 * (scale ^ (-(1 / 2 : Real))) ^ 2 = scale := by
    calc
      scale ^ 2 * (scale ^ (-(1 / 2 : Real))) ^ 2 =
          ((Real.sqrt scale) ^ 2) ^ 2 *
            (scale ^ (-(1 / 2 : Real))) ^ 2 := by rw [hsqrt]
      _ = (Real.sqrt scale) ^ 2 *
            (Real.sqrt scale * scale ^ (-(1 / 2 : Real))) ^ 2 := by
              ring
      _ = (Real.sqrt scale) ^ 2 := by rw [hinv, one_pow, mul_one]
      _ = scale := hsqrt
  calc
    defect = r * s * chord ^ 2 := hdefect
    _ ≤ ((4 * scale) * (4 * scale)) *
        (B * scale ^ (-(1 / 2 : Real))) ^ 2 := hprod
    _ = 16 * B ^ 2 * (scale ^ 2 * (scale ^ (-(1 / 2 : Real))) ^ 2) := by ring
    _ = 16 * B ^ 2 * scale := by rw [hscalePow]

private theorem aux_real_inner_ge_seven_eighth_of_unit_dist_le_half
    {c u : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hc : ‖c‖ = 1) (hu : ‖u‖ = 1) (huc : ‖u - c‖ ≤ 1 / 2) :
    7 / 8 ≤ inner Real c u := by
  have hsq := norm_sub_sq_real c u
  rw [hc, hu] at hsq
  have hnonneg : 0 ≤ ‖u - c‖ := norm_nonneg _
  have hsubsq : ‖c - u‖ ^ 2 ≤ 1 / 4 := by
    rw [norm_sub_rev]
    nlinarith
  nlinarith

/-- A common unit-sector centre keeps a positive weighted sum away from the
origin once both normalized summands are within one half of that centre. -/
private theorem aux_weighted_unit_sum_norm_lower_of_common_center
    {r s : Real} {c u v : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hc : ‖c‖ = 1) (hu : ‖u‖ = 1) (hv : ‖v‖ = 1)
    (huc : ‖u - c‖ ≤ 1 / 2) (hvc : ‖v - c‖ ≤ 1 / 2)
    (hr : 0 ≤ r) (hs : 0 ≤ s) :
    (r + s) / 2 ≤ ‖r • u + s • v‖ := by
  have hinneru : 7 / 8 ≤ inner Real c u :=
    aux_real_inner_ge_seven_eighth_of_unit_dist_le_half hc hu huc
  have hinnerv : 7 / 8 ≤ inner Real c v :=
    aux_real_inner_ge_seven_eighth_of_unit_dist_le_half hc hv hvc
  have hsuminner : 7 / 8 * (r + s) ≤ inner Real c (r • u + s • v) := by
    rw [inner_add_right, inner_smul_right, inner_smul_right]
    nlinarith [mul_le_mul_of_nonneg_left hinneru hr,
      mul_le_mul_of_nonneg_left hinnerv hs]
  have hinnernorm : inner Real c (r • u + s • v) ≤ ‖r • u + s • v‖ := by
    calc
      inner Real c (r • u + s • v) ≤ |inner Real c (r • u + s • v)| := le_abs_self _
      _ ≤ ‖c‖ * ‖r • u + s • v‖ := abs_real_inner_le_norm _ _
      _ = ‖r • u + s • v‖ := by rw [hc, one_mul]
  nlinarith

/-- Convert cap control for normalized witnesses into cap control for their
angular plate centres. -/
private theorem aux_direction_centres_close_of_normalized_output_caps
    {h A C : Real} {a a' u u' xhat : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hh : 0 ≤ h)
    (hua : ‖u - a‖ ≤ A * h) (hu'a' : ‖u' - a'‖ ≤ A * h)
    (hux : ‖u - xhat‖ ≤ C * h) (hu'x : ‖u' - xhat‖ ≤ C * h) :
    ‖a - a'‖ ≤ (2 * A + 2 * C) * h := by
  have htriangle : ‖a - a'‖ ≤ ‖a - u‖ + ‖u - xhat‖ +
      ‖xhat - u'‖ + ‖u' - a'‖ := by
    calc
      ‖a - a'‖ = ‖(a - u) + (u - xhat) + (xhat - u') + (u' - a')‖ := by
        congr 1
        abel
      _ ≤ ‖(a - u) + (u - xhat) + (xhat - u')‖ + ‖u' - a'‖ := norm_add_le _ _
      _ ≤ ‖(a - u) + (u - xhat)‖ + ‖xhat - u'‖ + ‖u' - a'‖ := by
        gcongr
        exact norm_add_le _ _
      _ ≤ ‖a - u‖ + ‖u - xhat‖ + ‖xhat - u'‖ + ‖u' - a'‖ := by
        gcongr
        exact norm_add_le _ _
  rw [norm_sub_rev] at hua
  rw [norm_sub_rev] at hu'x
  calc
    ‖a - a'‖ ≤ ‖a - u‖ + ‖u - xhat‖ + ‖xhat - u'‖ + ‖u' - a'‖ := htriangle
    _ ≤ A * h + C * h + C * h + A * h := by gcongr
    _ = (2 * A + 2 * C) * h := by ring

private theorem aux_direction_centres_close_of_normalized_pair
    {h A C : Real}
    {a a' u u' : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hua : ‖u - a‖ ≤ A * h) (hu'a' : ‖u' - a'‖ ≤ A * h)
    (huu' : ‖u - u'‖ ≤ C * h) :
    ‖a - a'‖ ≤ (2 * A + C) * h := by
  have htriangle : ‖a - a'‖ ≤ ‖a - u‖ + ‖u - u'‖ + ‖u' - a'‖ := by
    calc
      ‖a - a'‖ = ‖(a - u) + (u - u') + (u' - a')‖ := by
        congr 1
        abel
      _ ≤ ‖(a - u) + (u - u')‖ + ‖u' - a'‖ := norm_add_le _ _
      _ ≤ ‖a - u‖ + ‖u - u'‖ + ‖u' - a'‖ := by
        gcongr
        exact norm_add_le _ _
  rw [norm_sub_rev] at hua
  calc
    ‖a - a'‖ ≤ ‖a - u‖ + ‖u - u'‖ + ‖u' - a'‖ := htriangle
    _ ≤ A * h + C * h + A * h := by gcongr
    _ = (2 * A + C) * h := by ring

private theorem aux_norm_normalized_eq_one
    {x : _root_.Codex.Spherical.SurfaceCore.Euclidean 2} (hx : x ≠ 0) :
    ‖(‖x‖)⁻¹ • x‖ = 1 := by
  have hnormpos : 0 < ‖x‖ := norm_pos_iff.mpr hx
  have hnormne : ‖x‖ ≠ 0 := ne_of_gt hnormpos
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hnormpos)]
  field_simp [hnormne]

private theorem aux_eq_norm_smul_normalized
    {x : _root_.Codex.Spherical.SurfaceCore.Euclidean 2} (hx : x ≠ 0) :
    x = ‖x‖ • ((‖x‖)⁻¹ • x) := by
  have hnormne : ‖x‖ ≠ 0 := norm_ne_zero_iff.mpr hx
  rw [smul_smul, mul_inv_cancel₀ hnormne, one_smul]

private theorem aux_normalized_near_common_sector_center
    {scale angularConstant : Real}
    {x direction center : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hscale : 0 < scale) (hx : x ≠ 0)
    (hactual : ‖(‖x‖)⁻¹ • x - direction‖ ≤
      angularConstant * scale ^ (-(1 / 2 : Real)))
    (hdircenter : ‖direction - center‖ ≤ 1 / 4)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4) :
    ‖(‖x‖)⁻¹ • x - center‖ ≤ 1 / 2 := by
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  have habs : ‖(‖x‖)⁻¹ • x - direction‖ ≤
      |angularConstant| * scale ^ (-(1 / 2 : Real)) := by
    calc
      ‖(‖x‖)⁻¹ • x - direction‖ ≤
          angularConstant * scale ^ (-(1 / 2 : Real)) := hactual
      _ ≤ |angularConstant| * scale ^ (-(1 / 2 : Real)) :=
        mul_le_mul_of_nonneg_right (le_abs_self angularConstant) hpow
  calc
    ‖(‖x‖)⁻¹ • x - center‖ ≤
        ‖(‖x‖)⁻¹ • x - direction‖ + ‖direction - center‖ := by
      rw [show (‖x‖)⁻¹ • x - center =
        ((‖x‖)⁻¹ • x - direction) + (direction - center) by abel]
      exact norm_add_le _ _
    _ ≤ |angularConstant| * scale ^ (-(1 / 2 : Real)) + 1 / 4 := by gcongr
    _ ≤ 1 / 2 := by linarith

private theorem aux_angular_direction_chord_bounds_succ
    {scale sectorRadius spacingLower spacingUpper : Real}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {i j : Int} {k : Nat}
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hpair : (i, j) ∈ angularSeparationPairs indices (k + 1)) :
    spacingLower * ((2 ^ k : Nat) : Real) * scale ^ (-(1 / 2 : Real)) ≤
        ‖directions i - directions j‖ ∧
      ‖directions i - directions j‖ ≤
        spacingUpper * ((2 ^ (k + 1) : Nat) : Real) *
          scale ^ (-(1 / 2 : Real)) := by
  rcases hgeometry with ⟨_, _, hspacingLower, _, _, _, hdata⟩
  rcases (mem_angularSeparationPairs_iff indices (k + 1) (i, j)).mp hpair with
    ⟨hi, hj, hseparation⟩
  rcases (angularSeparationClass_succ_iff k i j).mp hseparation with ⟨hlower, hupper⟩
  have hlowNat : 2 ^ k ≤ (i - j).natAbs := Nat.le_of_lt hlower
  have hlowReal : ((2 ^ k : Nat) : Real) ≤ ((i - j).natAbs : Real) := by
    exact_mod_cast hlowNat
  have hupperReal : ((i - j).natAbs : Real) ≤ ((2 ^ (k + 1) : Nat) : Real) := by
    exact_mod_cast hupper
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  have hdataij := (hdata i hi).2.2 j hj
  constructor
  · calc
      spacingLower * ((2 ^ k : Nat) : Real) * scale ^ (-(1 / 2 : Real)) ≤
          spacingLower * ((i - j).natAbs : Real) * scale ^ (-(1 / 2 : Real)) := by
            gcongr
      _ ≤ ‖directions i - directions j‖ := hdataij.1
  · calc
      ‖directions i - directions j‖ ≤
          spacingUpper * ((i - j).natAbs : Real) * scale ^ (-(1 / 2 : Real)) := hdataij.2
      _ ≤ spacingUpper * ((2 ^ (k + 1) : Nat) : Real) *
          scale ^ (-(1 / 2 : Real)) := by gcongr

private theorem aux_scaled_dyadic_index_le_half
    {scale sectorRadius spacingLower spacingUpper : Real}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {i j : Int} {k : Nat}
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hpair : (i, j) ∈ angularSeparationPairs indices (k + 1)) :
    spacingLower * ((2 ^ k : Nat) : Real) * scale ^ (-(1 / 2 : Real)) ≤ 1 / 2 := by
  have hlower := (aux_angular_direction_chord_bounds_succ hscale hgeometry hpair).1
  rcases hgeometry with ⟨_, hsector, _, _, center, _, hdata⟩
  rcases (mem_angularSeparationPairs_iff indices (k + 1) (i, j)).mp hpair with
    ⟨hi, hj, _⟩
  have hupper : ‖directions i - directions j‖ ≤ 1 / 2 := by
    calc
      ‖directions i - directions j‖ ≤
          ‖directions i - center‖ + ‖center - directions j‖ := by
        rw [show directions i - directions j =
          (directions i - center) + (center - directions j) by abel]
        exact norm_add_le _ _
      _ = ‖directions i - center‖ + ‖directions j - center‖ := by
        exact congrArg (fun q : Real => ‖directions i - center‖ + q)
          (norm_sub_rev _ _)
      _ ≤ sectorRadius + sectorRadius := add_le_add (hdata i hi).2.1 (hdata j hj).2.1

      _ ≤ 1 / 2 := by linarith
  exact le_trans hlower hupper

private theorem aux_same_sign_direction_bound_of_coordinate_bounds
    (o : Orientation Real (_root_.Codex.Spherical.SurfaceCore.Euclidean 2) (Fin 2))
    {A D CX CA h : Real}
    {X U U' : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hX : 0 < ‖X‖) (hA : 0 < A)
    (hU : ‖U‖ = 1) (hU' : ‖U'‖ = 1)
    (harea : A ≤ |(o.areaForm X) U| ∧ A ≤ |(o.areaForm X) U'|)
    (hsign : (0 ≤ (o.areaForm X) U ∧ 0 ≤ (o.areaForm X) U') ∨
      ((o.areaForm X) U ≤ 0 ∧ (o.areaForm X) U' ≤ 0))
    (hinner : |inner Real X U - inner Real X U'| ≤ D)
    (hXquot : D / ‖X‖ ≤ CX * h) (hAquot : D / A ≤ CA * h) :
    ‖U - U'‖ ≤ (CX + CA) * h := by
  calc
    ‖U - U'‖ ≤ D / ‖X‖ + D / A :=
      aux_unit_same_area_branch_direction_bound o hX hA hU hU' harea hsign hinner
    _ ≤ CX * h + CA * h := add_le_add hXquot hAquot
    _ = (CX + CA) * h := by ring

/-- The scale bookkeeping for the transverse branch.  `B` is the upper
angular-chord coefficient, `lambda` the lower one, and `C` compares them.
The two conclusions are the output-radius and oriented-area quotient bounds
used by the two-coordinate circle estimate. -/
private theorem aux_transverse_coordinate_quotient_bounds
    {scale h sq B lambda C ell : Real}
    (hscale : 2 ≤ scale) (hh : 0 < h) (hsq : 1 ≤ sq)
    (hhsq : h * sq = 1) (hhsquare : h ^ 2 * scale = 1)
    (hell : 0 < ell) (helllambda : ell ≤ lambda)
    (hC : 0 ≤ C) (hB : 0 ≤ B) (hlambda : 0 ≤ lambda)
    (hcompare : B ≤ C * lambda) (hlambdah : lambda * h ≤ 1 / 4) :
    (264 + 768 * B ^ 2 * h) / (scale / 4) ≤
        (1056 + 192 * C ^ 2) * h ∧
      (264 + 768 * B ^ 2 * h) / (lambda * sq / 8) ≤
        (4224 / ell + 1536 * C ^ 2) * h := by
  have hscalepos : 0 < scale := by linarith
  have hlambdapos : 0 < lambda := lt_of_lt_of_le hell helllambda
  have hClambda : 0 ≤ C * lambda := mul_nonneg hC hlambda
  have hBsquare : B ^ 2 ≤ (C * lambda) ^ 2 :=
    (sq_le_sq₀ hB hClambda).mpr hcompare
  have hlambdahnonneg : 0 ≤ lambda * h := mul_nonneg hlambda hh.le
  have hlambdahsq : (lambda * h) ^ 2 ≤ (1 / 4 : Real) ^ 2 :=
    (sq_le_sq₀ hlambdahnonneg (by norm_num)).mpr hlambdah
  have hlambdasq : lambda ^ 2 ≤ scale / 16 := by
    have hrewrite : lambda ^ 2 = (lambda * h) ^ 2 * scale := by
      calc
        lambda ^ 2 = lambda ^ 2 * (h ^ 2 * scale) := by rw [hhsquare, mul_one]
        _ = (lambda * h) ^ 2 * scale := by ring
    rw [hrewrite]
    calc
      (lambda * h) ^ 2 * scale ≤ (1 / 4 : Real) ^ 2 * scale :=
        mul_le_mul_of_nonneg_right hlambdahsq hscalepos.le
      _ = scale / 16 := by ring
  have hBsquare' : B ^ 2 ≤ C ^ 2 * lambda ^ 2 := by
    calc
      B ^ 2 ≤ (C * lambda) ^ 2 := hBsquare
      _ = C ^ 2 * lambda ^ 2 := by ring
  have hBsquareScale : 16 * B ^ 2 ≤ C ^ 2 * scale := by
    have hmul : C ^ 2 * lambda ^ 2 ≤ C ^ 2 * (scale / 16) :=
      mul_le_mul_of_nonneg_left hlambdasq (sq_nonneg C)
    nlinarith [hBsquare', hmul]
  have hBlinear : 4 * B ^ 2 * h ≤ C ^ 2 * lambda := by
    have hmul : B ^ 2 * h ≤ C ^ 2 * lambda ^ 2 * h :=
      mul_le_mul_of_nonneg_right hBsquare' hh.le
    have hright : C ^ 2 * lambda ^ 2 * h ≤ C ^ 2 * lambda / 4 := by
      calc
        C ^ 2 * lambda ^ 2 * h = C ^ 2 * lambda * (lambda * h) := by ring
        _ ≤ C ^ 2 * lambda * (1 / 4) := by gcongr
        _ = C ^ 2 * lambda / 4 := by ring
    nlinarith [hmul, hright]
  constructor
  · have hden : 0 < scale / 4 := by positivity
    apply (div_le_iff₀ hden).mpr
    have hscaleh : h * scale = sq := by
      apply mul_left_cancel₀ (ne_of_gt hh)
      calc
        h * (h * scale) = h ^ 2 * scale := by ring
        _ = 1 := hhsquare
        _ = h * sq := hhsq.symm
    have hsqbound : 1 ≤ h * scale := by rw [hscaleh]; exact hsq
    have htermOne : 264 ≤ 264 * (h * scale) := by
      nlinarith [hsqbound]
    have htermB : 768 * B ^ 2 * h ≤ 48 * C ^ 2 * (h * scale) := by
      have hmul := mul_le_mul_of_nonneg_right hBsquareScale hh.le
      nlinarith
    nlinarith [htermOne, htermB]
  · have hden : 0 < lambda * sq / 8 := by positivity
    apply (div_le_iff₀ hden).mpr
    have hsqrewrite : h * sq = 1 := hhsq
    have hfirst : 264 ≤ 528 * lambda / ell := by
      have hratio : 1 ≤ lambda / ell := (one_le_div₀ hell).mpr helllambda
      calc
        264 ≤ 528 * (lambda / ell) := by nlinarith
        _ = 528 * lambda / ell := by field_simp [ne_of_gt hell]
    have hright :
        (4224 / ell + 1536 * C ^ 2) * h * (lambda * sq / 8) =
          528 * lambda / ell + 192 * C ^ 2 * lambda := by
      rw [show (4224 / ell + 1536 * C ^ 2) * h * (lambda * sq / 8) =
        (4224 / ell + 1536 * C ^ 2) * (h * sq) * lambda / 8 by ring,
        hsqrewrite]
      field_simp [ne_of_gt hell]
      ring
    rw [hright]
    nlinarith [hBlinear]

private theorem aux_rpow_neg_half_mul_sqrt_eq_one
    {scale : Real} (hscale : 0 < scale) :
    scale ^ (-(1 / 2 : Real)) * Real.sqrt scale = 1 := by
  calc
    scale ^ (-(1 / 2 : Real)) * Real.sqrt scale =
        scale ^ (-(1 / 2 : Real)) * scale ^ (1 / 2 : Real) := by
          rw [← Real.sqrt_eq_rpow]
    _ = scale ^ ((-(1 / 2 : Real)) + (1 / 2 : Real)) :=
      (Real.rpow_add hscale _ _).symm
    _ = 1 := by norm_num

private theorem aux_rpow_neg_half_sq_mul_scale_eq_one
    {scale : Real} (hscale : 0 < scale) :
    (scale ^ (-(1 / 2 : Real))) ^ 2 * scale = 1 := by
  have hsq : (Real.sqrt scale) ^ 2 = scale := Real.sq_sqrt hscale.le
  have hinv := aux_rpow_neg_half_mul_sqrt_eq_one hscale
  calc
    (scale ^ (-(1 / 2 : Real))) ^ 2 * scale =
        (scale ^ (-(1 / 2 : Real))) ^ 2 * (Real.sqrt scale) ^ 2 := by rw [hsq]
    _ = (scale ^ (-(1 / 2 : Real)) * Real.sqrt scale) ^ 2 := by ring
    _ = 1 := by rw [hinv, one_pow]

private theorem aux_output_norm_lower_of_high_sector_witnesses
    {scale angularConstant normalShift normalShift' : Real} {n n' : Int}
    {direction direction' center : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {Z z w : WaveSpaceTime}
    (hscale : 2 ≤ scale)
    (hcenter : ‖center‖ = 1)
    (hdircenter : ‖direction - center‖ ≤ 1 / 4)
    (hdircenter' : ‖direction' - center‖ ≤ 1 / 4)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction)
    (hw : w ∈ unitNormalConicPlate scale angularConstant normalShift' n' direction')
    (hzw : z + w = Z) :
    scale / 4 ≤ ‖Z.1‖ := by
  have hscalepos : 0 < scale := by linarith
  have hznonzero : z.1 ≠ 0 := hz.2.2.1.1
  have hwnonzero : w.1 ≠ 0 := hw.2.2.1.1
  have hzu : ‖(‖z.1‖)⁻¹ • z.1‖ = 1 := aux_norm_normalized_eq_one hznonzero
  have hwu : ‖(‖w.1‖)⁻¹ • w.1‖ = 1 := aux_norm_normalized_eq_one hwnonzero
  have hzuclose : ‖(‖z.1‖)⁻¹ • z.1 - center‖ ≤ 1 / 2 :=
    aux_normalized_near_common_sector_center hscalepos hznonzero
      hz.2.2.1.2 hdircenter hhigh
  have hwuclose : ‖(‖w.1‖)⁻¹ • w.1 - center‖ ≤ 1 / 2 :=
    aux_normalized_near_common_sector_center hscalepos hwnonzero
      hw.2.2.1.2 hdircenter' hhigh
  have hspace : z.1 + w.1 = Z.1 := congrArg Prod.fst hzw
  have hzsmul := aux_eq_norm_smul_normalized hznonzero
  have hwsmul := aux_eq_norm_smul_normalized hwnonzero
  have hrepr : Z.1 =
      ‖z.1‖ • ((‖z.1‖)⁻¹ • z.1) + ‖w.1‖ • ((‖w.1‖)⁻¹ • w.1) := by
    calc
      Z.1 = z.1 + w.1 := hspace.symm
      _ = ‖z.1‖ • ((‖z.1‖)⁻¹ • z.1) + ‖w.1‖ • ((‖w.1‖)⁻¹ • w.1) := by
        exact congrArg₂ (· + ·) hzsmul hwsmul
  have hsumlower : (‖z.1‖ + ‖w.1‖) / 2 ≤ ‖Z.1‖ := by
    have hgeneric := aux_weighted_unit_sum_norm_lower_of_common_center
      (r := ‖z.1‖) (s := ‖w.1‖) (c := center)
      (u := (‖z.1‖)⁻¹ • z.1) (v := (‖w.1‖)⁻¹ • w.1)
      hcenter hzu hwu hzuclose hwuclose (norm_nonneg _) (norm_nonneg _)
    calc
      (‖z.1‖ + ‖w.1‖) / 2 ≤
          ‖‖z.1‖ • ((‖z.1‖)⁻¹ • z.1) + ‖w.1‖ • ((‖w.1‖)⁻¹ • w.1)‖ := hgeneric
      _ = ‖Z.1‖ := by rw [← hrepr]
  nlinarith [hz.1, hw.1, hsumlower]

private theorem aux_active_pair_exists_witness
    (scale angularConstant normalShift normalShift' : Real) (n n' : Int)
    (indices : Finset Int) (directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (pair : Int × Int)
    (hpair : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions k Z) :
    ∃ zw : WaveSpaceTime × WaveSpaceTime,
      zw.1 ∈ unitNormalConicPlate scale angularConstant normalShift n (directions pair.1) ∧
      zw.2 ∈ unitNormalConicPlate scale angularConstant normalShift' n' (directions pair.2) ∧
      zw.1 + zw.2 = Z := by
  rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
    n n' indices directions k Z pair).mp hpair with ⟨_, z, hz, w, hw, hzw⟩
  exact ⟨(z, w), hz, hw, hzw⟩

private noncomputable def aux_active_pair_witness
    (scale angularConstant normalShift normalShift' : Real) (n n' : Int)
    (indices : Finset Int) (directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (pair : Int × Int) : WaveSpaceTime × WaveSpaceTime :=
  if hpair : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions k Z then
    Classical.choose (aux_active_pair_exists_witness scale angularConstant normalShift normalShift'
      n n' indices directions k Z pair hpair)
  else (0, 0)

private theorem aux_active_pair_witness_spec
    (scale angularConstant normalShift normalShift' : Real) (n n' : Int)
    (indices : Finset Int) (directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (pair : Int × Int)
    (hpair : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions k Z) :
    (aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions k Z pair).1 ∈
        unitNormalConicPlate scale angularConstant normalShift n (directions pair.1) ∧
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions k Z pair).2 ∈
        unitNormalConicPlate scale angularConstant normalShift' n' (directions pair.2) ∧
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions k Z pair).1 +
        (aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions k Z pair).2 = Z := by
  rw [aux_active_pair_witness, dif_pos hpair]
  exact Classical.choose_spec (aux_active_pair_exists_witness scale angularConstant normalShift normalShift'
    n n' indices directions k Z pair hpair)

private noncomputable def aux_activeFirstNormalized
    (scale angularConstant normalShift normalShift' : Real) (n n' : Int)
    (indices : Finset Int) (directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (pair : Int × Int) :
    _root_.Codex.Spherical.SurfaceCore.Euclidean 2 :=
  (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
    n n' indices directions k Z pair).1.1‖)⁻¹ •
    (aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions k Z pair).1.1

private noncomputable def aux_activeSecondNormalized
    (scale angularConstant normalShift normalShift' : Real) (n n' : Int)
    (indices : Finset Int) (directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (pair : Int × Int) :
    _root_.Codex.Spherical.SurfaceCore.Euclidean 2 :=
  (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
    n n' indices directions k Z pair).2.1‖)⁻¹ •
    (aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions k Z pair).2.1

private theorem aux_output_cap_of_high_sector_witness
    {scale angularConstant normalShift normalShift' B : Real} {n n' : Int}
    {direction direction' center : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {Z z w : WaveSpaceTime}
    (hscale : 2 ≤ scale) (hB : 0 ≤ B)
    (hcenter : ‖center‖ = 1)
    (hdircenter : ‖direction - center‖ ≤ 1 / 4)
    (hdircenter' : ‖direction' - center‖ ≤ 1 / 4)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction)
    (hw : w ∈ unitNormalConicPlate scale angularConstant normalShift' n' direction')
    (hzw : z + w = Z)
    (hchord : ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ≤
      B * scale ^ (-(1 / 2 : Real))) :
    ‖(‖Z.1‖)⁻¹ • Z.1 - (‖z.1‖)⁻¹ • z.1‖ ≤
      16 * B * scale ^ (-(1 / 2 : Real)) := by
  have hXlower := aux_output_norm_lower_of_high_sector_witnesses hscale hcenter
    hdircenter hdircenter' hhigh hz hw hzw
  have hXnonzero : Z.1 ≠ 0 := by
    intro hzero
    have : ‖Z.1‖ = 0 := norm_eq_zero.mpr hzero
    linarith
  have hznonzero : z.1 ≠ 0 := hz.2.2.1.1
  have hwnonzero : w.1 ≠ 0 := hw.2.2.1.1
  have hspace : z.1 + w.1 = Z.1 := congrArg Prod.fst hzw
  have hzsmul := aux_eq_norm_smul_normalized hznonzero
  have hwsmul := aux_eq_norm_smul_normalized hwnonzero
  have hrepr : Z.1 =
      ‖z.1‖ • ((‖z.1‖)⁻¹ • z.1) + ‖w.1‖ • ((‖w.1‖)⁻¹ • w.1) := by
    calc
      Z.1 = z.1 + w.1 := hspace.symm
      _ = ‖z.1‖ • ((‖z.1‖)⁻¹ • z.1) + ‖w.1‖ • ((‖w.1‖)⁻¹ • w.1) :=
        congrArg₂ (· + ·) hzsmul hwsmul
  have hresult := aux_output_normalized_cap_of_chord_upper
    (scale := scale) (r := ‖z.1‖) (s := ‖w.1‖) (B := B) (X := Z.1)
    (u := (‖z.1‖)⁻¹ • z.1) (v := (‖w.1‖)⁻¹ • w.1)
    (by linarith) hB hz.1 hw.1 hw.2.1 hrepr hXnonzero
    (aux_norm_normalized_eq_one hznonzero) hchord
  exact hresult

private theorem aux_plate_normalized_direction_bound_abs
    {scale angularConstant normalShift : Real} {n : Int}
    {direction : _root_.Codex.Spherical.SurfaceCore.Euclidean 2} {z : WaveSpaceTime}
    (hscale : 0 < scale)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction) :
    ‖(‖z.1‖)⁻¹ • z.1 - direction‖ ≤
      |angularConstant| * scale ^ (-(1 / 2 : Real)) := by
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  calc
    ‖(‖z.1‖)⁻¹ • z.1 - direction‖ ≤
        angularConstant * scale ^ (-(1 / 2 : Real)) := hz.2.2.1.2
    _ ≤ |angularConstant| * scale ^ (-(1 / 2 : Real)) :=
      mul_le_mul_of_nonneg_right (le_abs_self angularConstant) hpow

/-- Once the first normalized direction is stable, the coupled vector-sum
identity and the common radial-label windows stabilize the second direction
at the same dyadic scale. -/
private theorem aux_second_direction_bound_of_first_and_radial_windows
    {scale r r' s s' C : Real}
    {X u u' v v' : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hscale : 0 < scale) (hC : 0 ≤ C)
    (hrnonneg : 0 ≤ r) (hrupper : r ≤ 4 * scale) (hslower : scale / 4 ≤ s)
    (hrdiff : |r - r'| ≤ 6 * Real.sqrt scale)
    (hsdiff : |s - s'| ≤ 6 * Real.sqrt scale)
    (huu' : ‖u - u'‖ ≤ C * scale ^ (-(1 / 2 : Real)))
    (hu' : ‖u'‖ = 1) (hv' : ‖v'‖ = 1)
    (hX : X = r • u + s • v) (hX' : X = r' • u' + s' • v') :
    ‖v - v'‖ ≤ (48 + 16 * C) * scale ^ (-(1 / 2 : Real)) := by
  have hspos : 0 < s := by linarith
  have hsnonneg : 0 ≤ s := hspos.le
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  have hrpow : scale ^ (-(1 / 2 : Real)) * scale = Real.sqrt scale := by
    calc
      scale ^ (-(1 / 2 : Real)) * scale =
          scale ^ (-(1 / 2 : Real)) * scale ^ (1 : Real) := by rw [Real.rpow_one]
      _ = scale ^ (-(1 / 2 : Real) + (1 : Real)) :=
        (Real.rpow_add hscale _ _).symm
      _ = Real.sqrt scale := by
        convert (Real.sqrt_eq_rpow scale).symm using 1 <;> norm_num
  have hidentity : s • (v - v') =
      (r' - r) • u' + r • (u' - u) + (s' - s) • v' := by
    have hrel : s • v = r' • u' + s' • v' - r • u := by
      calc
        s • v = X - r • u := by rw [hX]; abel
        _ = r' • u' + s' • v' - r • u := by rw [hX']
    rw [smul_sub, hrel]
    module
  have hbound : s * ‖v - v'‖ ≤
      |r' - r| + r * ‖u' - u‖ + |s' - s| := by
    calc
      s * ‖v - v'‖ = ‖s • (v - v')‖ := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hsnonneg]
      _ = ‖(r' - r) • u' + r • (u' - u) + (s' - s) • v'‖ := by rw [hidentity]
      _ ≤ ‖(r' - r) • u'‖ + ‖r • (u' - u)‖ + ‖(s' - s) • v'‖ := by
        calc
          ‖(r' - r) • u' + r • (u' - u) + (s' - s) • v'‖ ≤
              ‖(r' - r) • u' + r • (u' - u)‖ + ‖(s' - s) • v'‖ := norm_add_le _ _
          _ ≤ ‖(r' - r) • u'‖ + ‖r • (u' - u)‖ + ‖(s' - s) • v'‖ := by
            gcongr
            exact norm_add_le _ _
      _ = |r' - r| + r * ‖u' - u‖ + |s' - s| := by
        rw [norm_smul, norm_smul, norm_smul, Real.norm_eq_abs,
          Real.norm_eq_abs, Real.norm_eq_abs, hu', hv', mul_one, mul_one,
          abs_of_nonneg hrnonneg]
  have huudiff : ‖u' - u‖ ≤ C * scale ^ (-(1 / 2 : Real)) := by
    rw [norm_sub_rev]
    exact huu'
  have hrdiff' : |r' - r| ≤ 6 * Real.sqrt scale := by
    rw [abs_sub_comm]
    exact hrdiff
  have hnumerator : |r' - r| + r * ‖u' - u‖ + |s' - s| ≤
      (12 + 4 * C) * Real.sqrt scale := by
    have hterm : r * ‖u' - u‖ ≤ 4 * C * Real.sqrt scale := by
      calc
        r * ‖u' - u‖ ≤ r * (C * scale ^ (-(1 / 2 : Real))) :=
          mul_le_mul_of_nonneg_left huudiff hrnonneg
        _ ≤ (4 * scale) * (C * scale ^ (-(1 / 2 : Real))) := by gcongr
        _ = 4 * C * Real.sqrt scale := by rw [← hrpow]; ring
    calc
      |r' - r| + r * ‖u' - u‖ + |s' - s| ≤
          (6 * Real.sqrt scale) + (4 * C * Real.sqrt scale) +
            (6 * Real.sqrt scale) := by
        apply add_le_add
        · exact add_le_add hrdiff' hterm
        · rwa [abs_sub_comm]
      _ = (12 + 4 * C) * Real.sqrt scale := by ring
  have htarget : (12 + 4 * C) * Real.sqrt scale ≤
      ((48 + 16 * C) * scale ^ (-(1 / 2 : Real))) * s := by
    calc
      (12 + 4 * C) * Real.sqrt scale =
          ((48 + 16 * C) * scale ^ (-(1 / 2 : Real))) * (scale / 4) := by
        rw [← hrpow]
        ring
      _ ≤ ((48 + 16 * C) * scale ^ (-(1 / 2 : Real))) * s := by
        have hnonneg : 0 ≤ (48 + 16 * C) * scale ^ (-(1 / 2 : Real)) := by positivity
        gcongr
  have hdiv : ‖v - v'‖ ≤
      (|r' - r| + r * ‖u' - u‖ + |s' - s|) / s := by
    apply (le_div_iff₀ hspos).mpr
    simpa [mul_comm] using hbound
  calc
    ‖v - v'‖ ≤
        (|r' - r| + r * ‖u' - u‖ + |s' - s|) / s := hdiv
    _ ≤ ((12 + 4 * C) * Real.sqrt scale) / s :=
      div_le_div_of_nonneg_right hnumerator hsnonneg
    _ ≤ (48 + 16 * C) * scale ^ (-(1 / 2 : Real)) := by
      apply (div_le_iff₀ hspos).mpr
      simpa [mul_comm] using htarget

/-- A uniform normalized chord bound for two literal high-sector witnesses
puts their first angular centres in one dyadic cap. -/
private theorem aux_high_active_first_direction_bound_of_normalized_chord
    {scale angularConstant normalShift normalShift' U : Real} {n n' : Int}
    {direction direction' mate mate' center : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {Z z w z' w' : WaveSpaceTime}
    (hscale : 2 ≤ scale) (hU : 0 ≤ U) (hcenter : ‖center‖ = 1)
    (hdirection : ‖direction - center‖ ≤ 1 / 4)
    (hmate : ‖mate - center‖ ≤ 1 / 4)
    (hdirection' : ‖direction' - center‖ ≤ 1 / 4)
    (hmate' : ‖mate' - center‖ ≤ 1 / 4)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction)
    (hw : w ∈ unitNormalConicPlate scale angularConstant normalShift' n' mate)
    (hz' : z' ∈ unitNormalConicPlate scale angularConstant normalShift n direction')
    (hw' : w' ∈ unitNormalConicPlate scale angularConstant normalShift' n' mate')
    (hzw : z + w = Z) (hz'w' : z' + w' = Z)
    (hchord : ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ≤
      U * scale ^ (-(1 / 2 : Real)))
    (hchord' : ‖(‖z'.1‖)⁻¹ • z'.1 - (‖w'.1‖)⁻¹ • w'.1‖ ≤
      U * scale ^ (-(1 / 2 : Real))) :
    ‖direction - direction'‖ ≤
      (2 * |angularConstant| + 32 * U) * scale ^ (-(1 / 2 : Real)) := by
  have hscalepos : 0 < scale := by linarith
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscalepos.le _
  have hzerr := aux_plate_normalized_direction_bound_abs hscalepos hz
  have hz'err := aux_plate_normalized_direction_bound_abs hscalepos hz'
  have hcap := aux_output_cap_of_high_sector_witness hscale hU hcenter
    hdirection hmate hhigh hz hw hzw hchord
  have hcap' := aux_output_cap_of_high_sector_witness hscale hU hcenter
    hdirection' hmate' hhigh hz' hw' hz'w' hchord'
  have hcaprev : ‖(‖z.1‖)⁻¹ • z.1 - (‖Z.1‖)⁻¹ • Z.1‖ ≤
      16 * U * scale ^ (-(1 / 2 : Real)) := by
    rw [norm_sub_rev]
    exact hcap
  have hcaprev' : ‖(‖z'.1‖)⁻¹ • z'.1 - (‖Z.1‖)⁻¹ • Z.1‖ ≤
      16 * U * scale ^ (-(1 / 2 : Real)) := by
    rw [norm_sub_rev]
    exact hcap'
  convert aux_direction_centres_close_of_normalized_output_caps hpow hzerr hz'err
    hcaprev hcaprev' using 1 <;> ring

private theorem aux_normalized_chord_le_one_of_high_common_sector
    {scale angularConstant normalShift normalShift' : Real} {n n' : Int}
    {direction mate : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {z w : WaveSpaceTime}
    (hscale : 0 < scale)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (hcenters : ‖direction - mate‖ ≤ 1 / 2)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction)
    (hw : w ∈ unitNormalConicPlate scale angularConstant normalShift' n' mate) :
    ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ≤ 1 := by
  have hzerr := aux_plate_normalized_direction_bound_abs hscale hz
  have hwerr := aux_plate_normalized_direction_bound_abs hscale hw
  have hzsmall : ‖(‖z.1‖)⁻¹ • z.1 - direction‖ ≤ 1 / 4 := le_trans hzerr hhigh
  have hwsmall : ‖(‖w.1‖)⁻¹ • w.1 - mate‖ ≤ 1 / 4 := le_trans hwerr hhigh
  have htriangle : ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ≤
      ‖(‖z.1‖)⁻¹ • z.1 - direction‖ + ‖direction - mate‖ +
        ‖mate - (‖w.1‖)⁻¹ • w.1‖ := by
    calc
      ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ =
          ‖((‖z.1‖)⁻¹ • z.1 - direction) + (direction - mate) +
            (mate - (‖w.1‖)⁻¹ • w.1)‖ := by congr 1 <;> abel
      _ ≤ ‖(‖z.1‖)⁻¹ • z.1 - direction‖ + ‖direction - mate‖ +
          ‖mate - (‖w.1‖)⁻¹ • w.1‖ := by
        calc
          _ ≤ ‖(‖z.1‖)⁻¹ • z.1 - direction + (direction - mate)‖ +
              ‖mate - (‖w.1‖)⁻¹ • w.1‖ := norm_add_le _ _
          _ ≤ _ := by gcongr; exact norm_add_le _ _
  rw [norm_sub_rev] at hwsmall
  linarith

private def aux_pre_labelBox (anchor : Int × Int) (B : Nat) : Finset (Int × Int) :=
  Finset.Icc (anchor.1 - (B : Int)) (anchor.1 + (B : Int)) ×ˢ
    Finset.Icc (anchor.2 - (B : Int)) (anchor.2 + (B : Int))

private theorem aux_pre_mem_labelBox_of_natAbs_sub_le
    {pair anchor : Int × Int} {B : Nat}
    (hfirst : (pair.1 - anchor.1).natAbs ≤ B)
    (hsecond : (pair.2 - anchor.2).natAbs ≤ B) :
    pair ∈ aux_pre_labelBox anchor B := by
  simp only [aux_pre_labelBox, Finset.mem_product, Finset.mem_Icc]
  constructor <;> constructor <;> omega

private theorem aux_pre_card_labelBox (anchor : Int × Int) (B : Nat) :
    (aux_pre_labelBox anchor B).card = (2 * B + 1) ^ 2 := by
  simp only [aux_pre_labelBox, Finset.card_product, Int.card_Icc]
  have hfirst :
      (anchor.1 + (B : Int) + 1 - (anchor.1 - (B : Int))).toNat = 2 * B + 1 := by
    omega
  have hsecond :
      (anchor.2 + (B : Int) + 1 - (anchor.2 - (B : Int))).toNat = 2 * B + 1 := by
    omega
  rw [hfirst, hsecond]
  ring

private theorem aux_pre_card_le_two_labelBoxes
    (active : Finset (Int × Int)) (anchor₁ anchor₂ : Int × Int) (B : Nat)
    (hcover : active ⊆ aux_pre_labelBox anchor₁ B ∪ aux_pre_labelBox anchor₂ B) :
    active.card ≤ 2 * (2 * B + 1) ^ 2 := by
  calc
    active.card ≤ (aux_pre_labelBox anchor₁ B ∪ aux_pre_labelBox anchor₂ B).card :=
      Finset.card_le_card hcover
    _ ≤ (aux_pre_labelBox anchor₁ B).card + (aux_pre_labelBox anchor₂ B).card :=
      Finset.card_union_le _ _
    _ = 2 * (2 * B + 1) ^ 2 := by
      rw [aux_pre_card_labelBox, aux_pre_card_labelBox]
      ring

private theorem aux_pre_natAbs_sub_le_of_scaled_direction_bound
    {scale sectorRadius spacingLower spacingUpper D : Real}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {i anchor : Int} {B : Nat}
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions

      sectorRadius spacingLower spacingUpper)
    (hi : i ∈ indices) (hanchor : anchor ∈ indices)
    (hD : D ≤ spacingLower * (B : Real))
    (hdist : ‖directions i - directions anchor‖ ≤
      D * scale ^ (-(1 / 2 : Real))) :
    (i - anchor).natAbs ≤ B := by
  rcases hgeometry with ⟨_, _, hspacingLower, _, _, _, hdata⟩
  have hpow : 0 < scale ^ (-(1 / 2 : Real)) := Real.rpow_pos_of_pos hscale _
  have hlow : spacingLower * ((i - anchor).natAbs : Real) *
      scale ^ (-(1 / 2 : Real)) ≤ ‖directions i - directions anchor‖ :=
    (hdata i hi).2.2 anchor hanchor |>.1
  have hscaled :
      (spacingLower * ((i - anchor).natAbs : Real)) *
        scale ^ (-(1 / 2 : Real)) ≤ D * scale ^ (-(1 / 2 : Real)) := by
    exact le_trans hlow hdist
  have hquot : spacingLower * ((i - anchor).natAbs : Real) ≤ D := by
    nlinarith [hscaled]
  have hreal : ((i - anchor).natAbs : Real) ≤ B := by
    nlinarith [hquot, hD]
  exact_mod_cast hreal

private theorem aux_pre_card_le_two_labelBoxes_of_direction_boxes
    {scale sectorRadius spacingLower spacingUpper D : Real}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (active : Finset (Int × Int)) (anchor₁ anchor₂ : Int × Int) (B : Nat)
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hanchor₁ : anchor₁.1 ∈ indices ∧ anchor₁.2 ∈ indices)
    (hanchor₂ : anchor₂.1 ∈ indices ∧ anchor₂.2 ∈ indices)
    (hactive : ∀ pair ∈ active, pair.1 ∈ indices ∧ pair.2 ∈ indices)
    (hD : D ≤ spacingLower * (B : Real))
    (hcover : ∀ pair ∈ active,
      (‖directions pair.1 - directions anchor₁.1‖ ≤ D * scale ^ (-(1 / 2 : Real)) ∧
        ‖directions pair.2 - directions anchor₁.2‖ ≤ D * scale ^ (-(1 / 2 : Real))) ∨
      (‖directions pair.1 - directions anchor₂.1‖ ≤ D * scale ^ (-(1 / 2 : Real)) ∧
        ‖directions pair.2 - directions anchor₂.2‖ ≤ D * scale ^ (-(1 / 2 : Real))) ) :
    active.card ≤ 2 * (2 * B + 1) ^ 2 := by
  apply aux_pre_card_le_two_labelBoxes active anchor₁ anchor₂ B
  intro pair hpair
  rcases hactive pair hpair with ⟨hfirst, hsecond⟩
  rcases hcover pair hpair with hleft | hright
  · apply Finset.mem_union_left
    exact aux_pre_mem_labelBox_of_natAbs_sub_le
      (aux_pre_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hfirst hanchor₁.1 hD hleft.1)
      (aux_pre_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hsecond hanchor₁.2 hD hleft.2)
  · apply Finset.mem_union_right
    exact aux_pre_mem_labelBox_of_natAbs_sub_le
      (aux_pre_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hfirst hanchor₂.1 hD hright.1)
      (aux_pre_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hsecond hanchor₂.2 hD hright.2)

/-- A high-sector literal overlap fiber is uniformly packed whenever every
canonical witness has a common normalized angular-chord bound. -/
private theorem aux_high_overlap_card_bound_of_normalized_chord
    {scale angularConstant sectorRadius spacingLower spacingUpper : Real}
    {normalShift normalShift' U : Real} {n n' : Int}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {k : Nat} {Z : WaveSpaceTime} {B : Nat}
    (hscale : 2 ≤ scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (hU : 0 ≤ U)
    (hB : 2 * |angularConstant| + 32 * U ≤ spacingLower * (B : Real))
    (hchord : ∀ pair,
      pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
        n n' indices directions k Z →
      ‖aux_activeFirstNormalized scale angularConstant normalShift normalShift'
          n n' indices directions k Z pair -
        aux_activeSecondNormalized scale angularConstant normalShift normalShift'
          n n' indices directions k Z pair‖ ≤
        U * scale ^ (-(1 / 2 : Real))) :
    (unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions k Z).card ≤ 2 * (2 * B + 1) ^ 2 := by
  classical
  let active := unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
    n n' indices directions k Z
  have hgeometryFull := hgeometry
  rcases hgeometry with ⟨_, hsector, _, _, center, hcenter, hdata⟩
  have hscalepos : 0 < scale := by linarith
  by_cases hnonempty : active.Nonempty
  · obtain ⟨anchor, hanchor⟩ := hnonempty
    apply aux_pre_card_le_two_labelBoxes_of_direction_boxes
      (active := active) (anchor₁ := anchor) (anchor₂ := anchor)
      (D := 2 * |angularConstant| + 32 * U) (B := B) hscalepos hgeometryFull
    · have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hanchor
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z anchor).mp hanchor' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.2.1⟩
    · have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hanchor
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z anchor).mp hanchor' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.2.1⟩
    · intro pair hpair
      have hpair' : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hpair
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z pair).mp hpair' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices k pair).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices k pair).mp hsep |>.2.1⟩
    · exact hB
    · intro pair hpair
      have hpair' : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hpair
      have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hanchor
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z pair).mp hpair' with ⟨hpsep, _⟩
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z anchor).mp hanchor' with ⟨hasep, _⟩
      have hpdata := (mem_angularSeparationPairs_iff indices k pair).mp hpsep
      have hadata := (mem_angularSeparationPairs_iff indices k anchor).mp hasep
      rcases aux_active_pair_witness_spec scale angularConstant normalShift normalShift'
        n n' indices directions k Z pair hpair' with ⟨hpz, hpw, hpzw⟩
      rcases aux_active_pair_witness_spec scale angularConstant normalShift normalShift'
        n n' indices directions k Z anchor hanchor' with ⟨haz, haw, hazw⟩
      have hpchord : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions k Z pair).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z pair).1.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z pair).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z pair).2.1‖ ≤
          U * scale ^ (-(1 / 2 : Real)) := by
        simpa only [aux_activeFirstNormalized, aux_activeSecondNormalized] using hchord pair hpair'
      have hachord : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions k Z anchor).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z anchor).1.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z anchor).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z anchor).2.1‖ ≤
          U * scale ^ (-(1 / 2 : Real)) := by
        simpa only [aux_activeFirstNormalized, aux_activeSecondNormalized] using hchord anchor hanchor'
      have hfirst := aux_high_active_first_direction_bound_of_normalized_chord
        hscale hU hcenter
        (le_trans (hdata pair.1 hpdata.1).2.1 hsector)
        (le_trans (hdata pair.2 hpdata.2.1).2.1 hsector)
        (le_trans (hdata anchor.1 hadata.1).2.1 hsector)
        (le_trans (hdata anchor.2 hadata.2.1).2.1 hsector)
        hhigh hpz hpw haz haw hpzw hazw hpchord hachord
      have hpzwrev : (aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions k Z pair).2 +
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z pair).1 = Z := by
        rw [add_comm]
        exact hpzw
      have hazwrev : (aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions k Z anchor).2 +
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z anchor).1 = Z := by
        rw [add_comm]
        exact hazw
      have hpchordrev : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions k Z pair).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z pair).2.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z pair).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z pair).1.1‖ ≤
          U * scale ^ (-(1 / 2 : Real)) := by
        rw [norm_sub_rev]
        exact hpchord
      have hachordrev : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions k Z anchor).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z anchor).2.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z anchor).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z anchor).1.1‖ ≤
          U * scale ^ (-(1 / 2 : Real)) := by
        rw [norm_sub_rev]
        exact hachord
      have hsecond := aux_high_active_first_direction_bound_of_normalized_chord
        (normalShift := normalShift') (normalShift' := normalShift) (n := n') (n' := n)
        (direction := directions pair.2) (mate := directions pair.1)
        (direction' := directions anchor.2) (mate' := directions anchor.1)
        hscale hU hcenter
        (le_trans (hdata pair.2 hpdata.2.1).2.1 hsector)
        (le_trans (hdata pair.1 hpdata.1).2.1 hsector)
        (le_trans (hdata anchor.2 hadata.2.1).2.1 hsector)
        (le_trans (hdata anchor.1 hadata.1).2.1 hsector)
        hhigh hpw hpz haw haz hpzwrev hazwrev hpchordrev hachordrev
      exact Or.inl ⟨hfirst, hsecond⟩
  · have hempty : active = ∅ := Finset.not_nonempty_iff_eq_empty.mp hnonempty
    simp [active, hempty]

/-- In the high-scale, small-separation regime, angular spacing itself gives
a uniform normalized chord bound, hence a literal finite overlap packing. -/
private theorem aux_high_tangent_overlap_card_bound
    {scale angularConstant sectorRadius spacingLower spacingUpper : Real}
    {normalShift normalShift' : Real} {n n' : Int}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {m : Nat} {Z : WaveSpaceTime} {B : Nat}
    (hscale : 2 ≤ scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (htangent : spacingLower * ((2 ^ m : Nat) : Real) ≤ 4 * |angularConstant|)
    (hB : 2 * |angularConstant| +
      32 * (8 * |angularConstant| * spacingUpper / spacingLower +
        2 * |angularConstant|) ≤ spacingLower * (B : Real)) :
    (unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z).card ≤ 2 * (2 * B + 1) ^ 2 := by
  have hgeometryFull := hgeometry
  rcases hgeometry with ⟨_, _, hspacingLower, hspacingUpper, _, _, _⟩
  have hscalepos : 0 < scale := by linarith
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscalepos.le _
  have hq : ((2 ^ m : Nat) : Real) ≤ 4 * |angularConstant| / spacingLower := by
    apply (le_div_iff₀ hspacingLower).mpr
    simpa [mul_comm] using htangent
  have hcoefficient : spacingUpper * ((2 ^ (m + 1) : Nat) : Real) ≤
      8 * |angularConstant| * spacingUpper / spacingLower := by
    calc
      spacingUpper * ((2 ^ (m + 1) : Nat) : Real) =
          2 * spacingUpper * ((2 ^ m : Nat) : Real) := by
            rw [pow_succ, Nat.cast_mul]
            norm_num
            ring
      _ ≤ 2 * spacingUpper * (4 * |angularConstant| / spacingLower) := by
            gcongr
      _ = 8 * |angularConstant| * spacingUpper / spacingLower := by ring
  apply aux_high_overlap_card_bound_of_normalized_chord hscale hgeometryFull hhigh
    (by positivity : 0 ≤ 8 * |angularConstant| * spacingUpper / spacingLower +
      2 * |angularConstant|) hB
  intro pair hpair
  have hsep := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
    normalShift' n n' indices directions (m + 1) Z pair).mp hpair |>.1
  have hcenters := aux_angular_direction_chord_bounds_succ hscalepos hgeometryFull hsep
  have hcenterUpper : ‖directions pair.1 - directions pair.2‖ ≤
      (8 * |angularConstant| * spacingUpper / spacingLower) *
        scale ^ (-(1 / 2 : Real)) := by
    calc
      ‖directions pair.1 - directions pair.2‖ ≤
          spacingUpper * ((2 ^ (m + 1) : Nat) : Real) *
            scale ^ (-(1 / 2 : Real)) := hcenters.2
      _ ≤ (8 * |angularConstant| * spacingUpper / spacingLower) *
            scale ^ (-(1 / 2 : Real)) :=
        mul_le_mul_of_nonneg_right hcoefficient hpow
  rcases aux_active_pair_witness_spec scale angularConstant normalShift normalShift'
    n n' indices directions (m + 1) Z pair hpair with ⟨hz, hw, hzw⟩
  have hzerr := aux_plate_normalized_direction_bound_abs hscalepos hz
  have hwerr := aux_plate_normalized_direction_bound_abs hscalepos hw
  simpa only [aux_activeFirstNormalized, aux_activeSecondNormalized] using
    aux_chord_upper_of_center_direction_bounds hcenterUpper hzerr hwerr

private theorem aux_high_zero_unitNormal_overlap_card_bound
    {scale angularConstant sectorRadius spacingLower spacingUpper : Real}
    {normalShift normalShift' : Real} {n n' : Int}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {Z : WaveSpaceTime} {B : Nat}
    (hscale : 2 ≤ scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (hB : 2 * |angularConstant| +
      32 * (spacingUpper + 2 * |angularConstant|) ≤ spacingLower * (B : Real)) :
    (unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions 0 Z).card ≤ 2 * (2 * B + 1) ^ 2 := by
  classical
  let active := unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
    n n' indices directions 0 Z
  have hgeometryFull := hgeometry
  rcases hgeometry with ⟨hsectorPos, hsector, hspacingLower, hspacingUpper,
    center, hcenter, hdata⟩
  have hscalepos : 0 < scale := by linarith
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscalepos.le _
  have hBzero : 0 ≤ spacingUpper + 2 * |angularConstant| := by positivity
  by_cases hnonempty : active.Nonempty
  · obtain ⟨anchor, hanchor⟩ := hnonempty
    apply aux_pre_card_le_two_labelBoxes_of_direction_boxes
      (active := active) (anchor₁ := anchor) (anchor₂ := anchor) (D :=
        2 * |angularConstant| + 32 * (spacingUpper + 2 * |angularConstant|))
      (B := B) hscalepos hgeometryFull
    · have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions 0 Z := by simpa [active] using hanchor
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions 0 Z anchor).mp hanchor' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices 0 anchor).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices 0 anchor).mp hsep |>.2.1⟩
    · have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions 0 Z := by simpa [active] using hanchor
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions 0 Z anchor).mp hanchor' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices 0 anchor).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices 0 anchor).mp hsep |>.2.1⟩
    · intro pair hpair
      have hpair' : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions 0 Z := by simpa [active] using hpair
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions 0 Z pair).mp hpair' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices 0 pair).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices 0 pair).mp hsep |>.2.1⟩
    · exact hB
    · intro pair hpair
      have hpair' : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions 0 Z := by simpa [active] using hpair
      have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions 0 Z := by simpa [active] using hanchor
      have hpsep := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
        normalShift' n n' indices directions 0 Z pair).mp hpair' |>.1
      have hasep := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
        normalShift' n n' indices directions 0 Z anchor).mp hanchor' |>.1
      have hpdata := (mem_angularSeparationPairs_iff indices 0 pair).mp hpsep
      have hadata := (mem_angularSeparationPairs_iff indices 0 anchor).mp hasep
      have hcenterUpper : ‖directions pair.1 - directions pair.2‖ ≤
          spacingUpper * scale ^ (-(1 / 2 : Real)) := by
        have hraw := (hdata pair.1 hpdata.1).2.2 pair.2 hpdata.2.1 |>.2
        have hclass := (angularSeparationClass_zero_iff pair.1 pair.2).mp hpdata.2.2
        calc
          ‖directions pair.1 - directions pair.2‖ ≤
              spacingUpper * ((pair.1 - pair.2).natAbs : Real) *
                scale ^ (-(1 / 2 : Real)) := hraw
          _ ≤ spacingUpper * 1 * scale ^ (-(1 / 2 : Real)) := by
            gcongr
            exact_mod_cast hclass
          _ = spacingUpper * scale ^ (-(1 / 2 : Real)) := by ring
      have hcenterUpperA : ‖directions anchor.1 - directions anchor.2‖ ≤
          spacingUpper * scale ^ (-(1 / 2 : Real)) := by
        have hraw := (hdata anchor.1 hadata.1).2.2 anchor.2 hadata.2.1 |>.2
        have hclass := (angularSeparationClass_zero_iff anchor.1 anchor.2).mp hadata.2.2
        calc
          ‖directions anchor.1 - directions anchor.2‖ ≤
              spacingUpper * ((anchor.1 - anchor.2).natAbs : Real) *
                scale ^ (-(1 / 2 : Real)) := hraw
          _ ≤ spacingUpper * 1 * scale ^ (-(1 / 2 : Real)) := by
            gcongr
            exact_mod_cast hclass
          _ = spacingUpper * scale ^ (-(1 / 2 : Real)) := by ring
      rcases aux_active_pair_witness_spec scale angularConstant normalShift normalShift'
        n n' indices directions 0 Z pair hpair' with ⟨hz, hw, hzw⟩
      rcases aux_active_pair_witness_spec scale angularConstant normalShift normalShift'
        n n' indices directions 0 Z anchor hanchor' with ⟨az, aw, hazw⟩
      have hpzerr := aux_plate_normalized_direction_bound_abs hscalepos hz
      have hpwerr := aux_plate_normalized_direction_bound_abs hscalepos hw
      have hazerr := aux_plate_normalized_direction_bound_abs hscalepos az
      have hawerr := aux_plate_normalized_direction_bound_abs hscalepos aw
      have hpchord : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z pair).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z pair).1.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z pair).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z pair).2.1‖ ≤
          (spacingUpper + 2 * |angularConstant|) * scale ^ (-(1 / 2 : Real)) := by
        exact aux_chord_upper_of_center_direction_bounds hcenterUpper hpzerr hpwerr
      have hachord : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z anchor).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z anchor).1.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z anchor).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z anchor).2.1‖ ≤
          (spacingUpper + 2 * |angularConstant|) * scale ^ (-(1 / 2 : Real)) := by
        exact aux_chord_upper_of_center_direction_bounds hcenterUpperA hazerr hawerr
      have hcapP := aux_output_cap_of_high_sector_witness hscale hBzero hcenter
        (le_trans (hdata pair.1 hpdata.1).2.1 hsector)
        (le_trans (hdata pair.2 hpdata.2.1).2.1 hsector) hhigh hz hw hzw hpchord
      have hcapA := aux_output_cap_of_high_sector_witness hscale hBzero hcenter
        (le_trans (hdata anchor.1 hadata.1).2.1 hsector)
        (le_trans (hdata anchor.2 hadata.2.1).2.1 hsector) hhigh az aw hazw hachord
      have hcapP' : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z pair).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z pair).1.1 - (‖Z.1‖)⁻¹ • Z.1‖ ≤
          16 * (spacingUpper + 2 * |angularConstant|) *
            scale ^ (-(1 / 2 : Real)) := by
        rw [norm_sub_rev]
        exact hcapP
      have hcapA' : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z anchor).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z anchor).1.1 - (‖Z.1‖)⁻¹ • Z.1‖ ≤
          16 * (spacingUpper + 2 * |angularConstant|) *
            scale ^ (-(1 / 2 : Real)) := by
        rw [norm_sub_rev]
