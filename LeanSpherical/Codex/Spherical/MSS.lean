      have hsecond := by
        have hpzw : (aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z pair).2 +
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z pair).1 = Z := by
          rw [add_comm]
          exact hzw
        have hazw' : (aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z anchor).2 +
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z anchor).1 = Z := by
          rw [add_comm]
          exact hazw
        have hcapP2 := aux_output_cap_of_high_sector_witness hscale hBzero hcenter
          (le_trans (hdata pair.2 hpdata.2.1).2.1 hsector)
          (le_trans (hdata pair.1 hpdata.1).2.1 hsector) hhigh hw hz hpzw (by
            rw [norm_sub_rev]
            exact hpchord)
        have hcapA2 := aux_output_cap_of_high_sector_witness hscale hBzero hcenter
          (le_trans (hdata anchor.2 hadata.2.1).2.1 hsector)
          (le_trans (hdata anchor.1 hadata.1).2.1 hsector) hhigh aw az hazw' (by
            rw [norm_sub_rev]
            exact hachord)
        have hcapP2' : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z pair).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z pair).2.1 - (‖Z.1‖)⁻¹ • Z.1‖ ≤
          16 * (spacingUpper + 2 * |angularConstant|) *
            scale ^ (-(1 / 2 : Real)) := by
          rw [norm_sub_rev]
          exact hcapP2
        have hcapA2' : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z anchor).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z anchor).2.1 - (‖Z.1‖)⁻¹ • Z.1‖ ≤
          16 * (spacingUpper + 2 * |angularConstant|) *
            scale ^ (-(1 / 2 : Real)) := by
          rw [norm_sub_rev]
          exact hcapA2
        exact aux_direction_centres_close_of_normalized_output_caps hpow
          hpwerr hawerr hcapP2' hcapA2'
      exact Or.inl ⟨by convert hfirst using 1 <;> ring,
        by convert hsecond using 1 <;> ring⟩
  · have hempty : active = ∅ := Finset.not_nonempty_iff_eq_empty.mp hnonempty
    simp [active, hempty]

/-- Two literal witnesses for the same translated unit-normal output have
uniformly stable polar inner coordinates.  This is the analytic core of the
fixed-area-sign cap reduction. -/
private theorem aux_two_active_polar_inner_coordinate_stable
    {scale angularConstant normalShift normalShift' B : Real} {n n' : Int}
    {direction mate direction' mate' : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {Z z w z' w' : WaveSpaceTime}
    (hscale : 2 ≤ scale) (hB : 0 ≤ B)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction)
    (hw : w ∈ unitNormalConicPlate scale angularConstant normalShift' n' mate)
    (hz' : z' ∈ unitNormalConicPlate scale angularConstant normalShift n direction')
    (hw' : w' ∈ unitNormalConicPlate scale angularConstant normalShift' n' mate')
    (hzw : z + w = Z) (hz'w' : z' + w' = Z)
    (hchord : ‖(‖z'.1‖)⁻¹ • z'.1 - (‖w'.1‖)⁻¹ • w'.1‖ ≤
      B * scale ^ (-(1 / 2 : Real))) :
    |inner Real Z.1 ((‖z.1‖)⁻¹ • z.1) -
        inner Real Z.1 ((‖z'.1‖)⁻¹ • z'.1)| ≤
      264 + 768 * B ^ 2 * scale ^ (-(1 / 2 : Real)) := by
  have hscalepos : 0 < scale := by linarith
  have hznonzero : z.1 ≠ 0 := hz.2.2.1.1
  have hwnonzero : w.1 ≠ 0 := hw.2.2.1.1
  have hz'nonzero : z'.1 ≠ 0 := hz'.2.2.1.1
  have hw'nonzero : w'.1 ≠ 0 := hw'.2.2.1.1
  have hznorm : ‖z.1‖ ≠ 0 := norm_ne_zero_iff.mpr hznonzero
  have hz'norm : ‖z'.1‖ ≠ 0 := norm_ne_zero_iff.mpr hz'nonzero
  have hspace : z.1 + w.1 = Z.1 := congrArg Prod.fst hzw
  have hspace' : z'.1 + w'.1 = Z.1 := congrArg Prod.fst hz'w'
  have hsub : Z.1 - z.1 = w.1 := by rw [← hspace]; abel
  have hsub' : Z.1 - z'.1 = w'.1 := by rw [← hspace']; abel
  have hnormal :
      |(Z.2 - (‖z.1‖ + ‖w.1‖)) - (normalShift + normalShift')| ≤ 4 := by
    have htime : z.2 + w.2 = Z.2 := congrArg Prod.snd hzw
    have hznormal : |(z.2 - ‖z.1‖) - normalShift| ≤ 2 := hz.2.2.2.2
    have hwnormal : |(w.2 - ‖w.1‖) - normalShift'| ≤ 2 := hw.2.2.2.2
    calc
      |(Z.2 - (‖z.1‖ + ‖w.1‖)) - (normalShift + normalShift')| =
          |((z.2 - ‖z.1‖) - normalShift) +
            ((w.2 - ‖w.1‖) - normalShift')| := by
              rw [← htime]
              ring_nf
      _ ≤ |(z.2 - ‖z.1‖) - normalShift| +
          |(w.2 - ‖w.1‖) - normalShift'| := abs_add_le _ _
      _ ≤ 4 := by linarith
  have hnormal' :
      |(Z.2 - (‖z'.1‖ + ‖w'.1‖)) - (normalShift + normalShift')| ≤ 4 := by
    have htime : z'.2 + w'.2 = Z.2 := congrArg Prod.snd hz'w'
    have hznormal : |(z'.2 - ‖z'.1‖) - normalShift| ≤ 2 := hz'.2.2.2.2
    have hwnormal : |(w'.2 - ‖w'.1‖) - normalShift'| ≤ 2 := hw'.2.2.2.2
    calc
      |(Z.2 - (‖z'.1‖ + ‖w'.1‖)) - (normalShift + normalShift')| =
          |((z'.2 - ‖z'.1‖) - normalShift) +
            ((w'.2 - ‖w'.1‖) - normalShift')| := by
              rw [← htime]
              ring_nf
      _ ≤ |(z'.2 - ‖z'.1‖) - normalShift| +
          |(w'.2 - ‖w'.1‖) - normalShift'| := abs_add_le _ _
      _ ≤ 4 := by linarith
  have htau :
      |(‖z.1‖ + ‖w.1‖) - (‖z'.1‖ + ‖w'.1‖)| ≤ 8 := by
    refine aux_total_radius_difference_le_eight
      (center := Z.2 - (normalShift + normalShift')) ?_ ?_
    · calc
        |(‖z.1‖ + ‖w.1‖) - (Z.2 - (normalShift + normalShift'))| =
            |-((Z.2 - (‖z.1‖ + ‖w.1‖)) -
              (normalShift + normalShift'))| := by congr 1 <;> ring

        _ = |(Z.2 - (‖z.1‖ + ‖w.1‖) -
              (normalShift + normalShift'))| := by rw [abs_neg]
        _ = |(Z.2 - (‖z.1‖ + ‖w.1‖)) -
              (normalShift + normalShift')| := by ring_nf
        _ ≤ 4 := hnormal
    · calc
        |(‖z'.1‖ + ‖w'.1‖) - (Z.2 - (normalShift + normalShift'))| =
            |-((Z.2 - (‖z'.1‖ + ‖w'.1‖)) -
              (normalShift + normalShift'))| := by congr 1 <;> ring
        _ = |(Z.2 - (‖z'.1‖ + ‖w'.1‖) -
              (normalShift + normalShift'))| := by rw [abs_neg]
        _ = |(Z.2 - (‖z'.1‖ + ‖w'.1‖)) -
              (normalShift + normalShift')| := by ring_nf
        _ ≤ 4 := hnormal'
  have hzradius := aux_mem_unitNormalConicPlate_radius_localized hscalepos hz
  have hz'radius := aux_mem_unitNormalConicPlate_radius_localized hscalepos hz'
  have hradial : |‖z.1‖ - ‖z'.1‖| ≤ 6 * Real.sqrt scale :=
    aux_radial_window_difference_le_six_sqrt hscale hzradius hz'radius
  have htaubounds := aux_sum_radius_bounds (by linarith : 0 ≤ scale)
    hz.1 hz.2.1 hw.1 hw.2.1
  have htau'bounds := aux_sum_radius_bounds (by linarith : 0 ≤ scale)
    hz'.1 hz'.2.1 hw'.1 hw'.2.1
  have hdefect :
      (‖z.1‖ + ‖w.1‖) ^ 2 - ‖Z.1‖ ^ 2 =
        ‖z.1‖ * ‖w.1‖ * ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ^ 2 := by
    calc
      (‖z.1‖ + ‖w.1‖) ^ 2 - ‖Z.1‖ ^ 2 =
          (‖z.1‖ + ‖w.1‖) ^ 2 - ‖z.1 + w.1‖ ^ 2 := by rw [hspace]
      _ = ‖z.1‖ * ‖w.1‖ *
          ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ^ 2 :=
        aux_twoCone_angular_defect_identity z.1 w.1 hznorm (norm_ne_zero_iff.mpr hwnonzero)
  have hdefect' :
      (‖z'.1‖ + ‖w'.1‖) ^ 2 - ‖Z.1‖ ^ 2 =
        ‖z'.1‖ * ‖w'.1‖ * ‖(‖z'.1‖)⁻¹ • z'.1 - (‖w'.1‖)⁻¹ • w'.1‖ ^ 2 := by
    calc
      (‖z'.1‖ + ‖w'.1‖) ^ 2 - ‖Z.1‖ ^ 2 =
          (‖z'.1‖ + ‖w'.1‖) ^ 2 - ‖z'.1 + w'.1‖ ^ 2 := by rw [hspace']
      _ = ‖z'.1‖ * ‖w'.1‖ *
          ‖(‖z'.1‖)⁻¹ • z'.1 - (‖w'.1‖)⁻¹ • w'.1‖ ^ 2 :=
        aux_twoCone_angular_defect_identity z'.1 w'.1 hz'norm (norm_ne_zero_iff.mpr hw'nonzero)
  have hdefect'nonneg : 0 ≤ (‖z'.1‖ + ‖w'.1‖) ^ 2 - ‖Z.1‖ ^ 2 := by
    rw [hdefect']
    positivity
  have hdefect'upper :
      (‖z'.1‖ + ‖w'.1‖) ^ 2 - ‖Z.1‖ ^ 2 ≤ 16 * B ^ 2 * scale := by
    exact aux_defect_upper_of_chord_upper hscalepos hB (norm_nonneg _) (norm_nonneg _)
      hz'.2.1 hw'.2.1 hdefect' hchord (norm_nonneg _)
  have hdefectdiff :
      |((‖z.1‖ + ‖w.1‖) ^ 2 - ‖Z.1‖ ^ 2) -
          ((‖z'.1‖ + ‖w'.1‖) ^ 2 - ‖Z.1‖ ^ 2)| ≤ 128 * scale :=
    aux_defect_difference_le_one_twenty_eight_mul_scale (by linarith : 0 ≤ scale)
      (by positivity) (by positivity) htaubounds.2 htau'bounds.2 htau
  have hstable := aux_polar_inner_coordinate_difference_le_constant
    hscale hz.1 hz'.1 htau hdefectdiff hdefect'nonneg hdefect'upper hradial
  have hpz : inner Real Z.1 ((‖z.1‖)⁻¹ • z.1) =
      (‖z.1‖ + ‖w.1‖) -
        ((‖z.1‖ + ‖w.1‖) ^ 2 - ‖Z.1‖ ^ 2) / (2 * ‖z.1‖) := by
    simpa only [hsub] using aux_twoCone_polar_solve_inner Z.1 z.1 hznorm
  have hpz' : inner Real Z.1 ((‖z'.1‖)⁻¹ • z'.1) =
      (‖z'.1‖ + ‖w'.1‖) -
        ((‖z'.1‖ + ‖w'.1‖) ^ 2 - ‖Z.1‖ ^ 2) / (2 * ‖z'.1‖) := by
    simpa only [hsub'] using aux_twoCone_polar_solve_inner Z.1 z'.1 hz'norm
  rw [hpz, hpz']
  exact hstable

/-- A literal overlap pair supplies all of the coupled two-cone data for the
ellipse reduction.  In particular, the normal-coordinate estimates pin the
*sum* of the two radii, rather than merely placing the summands in independent
annuli. -/
private theorem aux_mem_unitNormalPlateOverlapPairs_twoCone_polar
    {scale angularConstant normalShift normalShift' : Real} {n n' : Int}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {k : Nat} {Z : WaveSpaceTime} {pair : Int × Int}
    (hscale : 0 < scale)
    (hpair : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions k Z) :
    pair ∈ angularSeparationPairs indices k ∧
      ∃ z ∈ unitNormalConicPlate scale angularConstant normalShift n (directions pair.1),
        ∃ w ∈ unitNormalConicPlate scale angularConstant normalShift' n' (directions pair.2),
          z + w = Z ∧
          |(Z.2 - (‖z.1‖ + ‖w.1‖)) - (normalShift + normalShift')| ≤ 4 ∧
          |‖z.1‖ - ((n : Real) * Real.sqrt scale - normalShift)| ≤ Real.sqrt scale + 2 ∧
          |‖w.1‖ - ((n' : Real) * Real.sqrt scale - normalShift')| ≤ Real.sqrt scale + 2 ∧
          ‖(‖z.1‖)⁻¹ • z.1 - directions pair.1‖ ≤
            angularConstant * scale ^ (-(1 / 2 : Real)) ∧
          ‖(‖w.1‖)⁻¹ • w.1 - directions pair.2‖ ≤
            angularConstant * scale ^ (-(1 / 2 : Real)) ∧
          2 * ‖z.1‖ *
              ((‖z.1‖ + ‖w.1‖) - inner Real Z.1 ((‖z.1‖)⁻¹ • z.1)) =
            (‖z.1‖ + ‖w.1‖) ^ 2 - ‖Z.1‖ ^ 2 := by
  rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
    n n' indices directions k Z pair).mp hpair with ⟨hseparation, hsum⟩
  refine ⟨hseparation, ?_⟩
  rcases aux_mem_minkowskiSum_unitNormalConicPlate_twoCone hsum with
    ⟨z, hz, w, hw, hzw, htime⟩
  have hzradial := aux_mem_unitNormalConicPlate_radius_localized hscale hz
  have hwradial := aux_mem_unitNormalConicPlate_radius_localized hscale hw
  have hzdirection := (aux_mem_unitNormalConicPlate_direction_localized hz).2
  have hwdirection := (aux_mem_unitNormalConicPlate_direction_localized hw).2
  have hznonzero := (aux_mem_unitNormalConicPlate_direction_localized hz).1
  have hznormnonzero : ‖z.1‖ ≠ 0 := norm_ne_zero_iff.mpr hznonzero
  have hspace : z.1 + w.1 = Z.1 := congrArg Prod.fst hzw
  have hsub : Z.1 - z.1 = w.1 := by
    rw [← hspace]
    abel
  have hpolar := aux_twoCone_polar_identity Z.1 z.1 hznormnonzero
  refine ⟨z, hz, w, hw, hzw, htime, hzradial, hwradial, hzdirection, hwdirection, ?_⟩
  simpa only [hsub] using hpolar

/-- A pair of bounded integer label windows, used as the final discrete
packing target after the two-branch geometric reduction. -/
private def aux_labelBox (anchor : Int × Int) (B : Nat) : Finset (Int × Int) :=
  Finset.Icc (anchor.1 - (B : Int)) (anchor.1 + (B : Int)) ×ˢ
    Finset.Icc (anchor.2 - (B : Int)) (anchor.2 + (B : Int))

private theorem aux_mem_labelBox_of_natAbs_sub_le
    {pair anchor : Int × Int} {B : Nat}
    (hfirst : (pair.1 - anchor.1).natAbs ≤ B)
    (hsecond : (pair.2 - anchor.2).natAbs ≤ B) :
    pair ∈ aux_labelBox anchor B := by
  simp only [aux_labelBox, Finset.mem_product, Finset.mem_Icc]
  constructor <;> constructor <;> omega

private theorem aux_card_labelBox (anchor : Int × Int) (B : Nat) :
    (aux_labelBox anchor B).card = (2 * B + 1) ^ 2 := by
  simp only [aux_labelBox, Finset.card_product, Int.card_Icc]
  have hfirst :
      (anchor.1 + (B : Int) + 1 - (anchor.1 - (B : Int))).toNat = 2 * B + 1 := by
    omega
  have hsecond :
      (anchor.2 + (B : Int) + 1 - (anchor.2 - (B : Int))).toNat = 2 * B + 1 := by
    omega
  rw [hfirst, hsecond]
  ring

private theorem aux_card_le_two_labelBoxes
    (active : Finset (Int × Int)) (anchor₁ anchor₂ : Int × Int) (B : Nat)
    (hcover : active ⊆ aux_labelBox anchor₁ B ∪ aux_labelBox anchor₂ B) :
    active.card ≤ 2 * (2 * B + 1) ^ 2 := by
  calc
    active.card ≤ (aux_labelBox anchor₁ B ∪ aux_labelBox anchor₂ B).card :=
      Finset.card_le_card hcover
    _ ≤ (aux_labelBox anchor₁ B).card + (aux_labelBox anchor₂ B).card :=
      Finset.card_union_le _ _
    _ = 2 * (2 * B + 1) ^ 2 := by
      rw [aux_card_labelBox, aux_card_labelBox]
      ring

private theorem aux_card_le_three_labelBoxes
    (active : Finset (Int × Int)) (anchor₁ anchor₂ anchor₃ : Int × Int) (B : Nat)
    (hcover : active ⊆ aux_labelBox anchor₁ B ∪ aux_labelBox anchor₂ B ∪
      aux_labelBox anchor₃ B) :
    active.card ≤ 3 * (2 * B + 1) ^ 2 := by
  calc
    active.card ≤
        (aux_labelBox anchor₁ B ∪ aux_labelBox anchor₂ B ∪
          aux_labelBox anchor₃ B).card := Finset.card_le_card hcover
    _ ≤ (aux_labelBox anchor₁ B ∪ aux_labelBox anchor₂ B).card +
        (aux_labelBox anchor₃ B).card := Finset.card_union_le _ _
    _ ≤ (aux_labelBox anchor₁ B).card + (aux_labelBox anchor₂ B).card +
        (aux_labelBox anchor₃ B).card := by
      gcongr
      exact Finset.card_union_le _ _
    _ = 3 * (2 * B + 1) ^ 2 := by
      rw [aux_card_labelBox, aux_card_labelBox, aux_card_labelBox]
      ring

/-- The lower half of `angularSectorGeometry` turns one direction ball of
radius `D * scale⁻¹ᐟ²` into a fixed integer label window. -/
private theorem aux_natAbs_sub_le_of_scaled_direction_bound
    {scale sectorRadius spacingLower spacingUpper D : Real}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {i anchor : Int} {B : Nat}
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hi : i ∈ indices) (hanchor : anchor ∈ indices)
    (hD : D ≤ spacingLower * (B : Real))
    (hdist : ‖directions i - directions anchor‖ ≤
      D * scale ^ (-(1 / 2 : Real))) :
    (i - anchor).natAbs ≤ B := by
  rcases hgeometry with ⟨_, _, hspacingLower, _, _, _, hdata⟩
  have hpow : 0 < scale ^ (-(1 / 2 : Real)) :=
    Real.rpow_pos_of_pos hscale _
  have hlow : spacingLower * ((i - anchor).natAbs : Real) *
      scale ^ (-(1 / 2 : Real)) ≤ ‖directions i - directions anchor‖ :=
    (hdata i hi).2.2 anchor hanchor |>.1
  have hscaled :
      (spacingLower * ((i - anchor).natAbs : Real)) *
        scale ^ (-(1 / 2 : Real)) ≤
      D * scale ^ (-(1 / 2 : Real)) := by
    exact le_trans hlow hdist
  have hquot : spacingLower * ((i - anchor).natAbs : Real) ≤ D := by
    nlinarith [hscaled]
  have hreal : ((i - anchor).natAbs : Real) ≤ B := by
    nlinarith [hquot, hD]
  exact_mod_cast hreal

/-- The discrete conclusion needed from the continuous two-branch geometry:
two `scale⁻¹ᐟ²` direction boxes around active label pairs give a uniform
overlap-cardinality bound. -/
private theorem aux_card_le_two_labelBoxes_of_direction_boxes
    {scale sectorRadius spacingLower spacingUpper D : Real}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (active : Finset (Int × Int)) (anchor₁ anchor₂ : Int × Int) (B : Nat)
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hanchor₁ : anchor₁.1 ∈ indices ∧ anchor₁.2 ∈ indices)
    (hanchor₂ : anchor₂.1 ∈ indices ∧ anchor₂.2 ∈ indices)
    (hactive : ∀ pair ∈ active, pair.1 ∈ indices ∧ pair.2 ∈ indices)
    (hD : D ≤ spacingLower * (B : Real))
    (hcover : ∀ pair ∈ active,
      (‖directions pair.1 - directions anchor₁.1‖ ≤ D * scale ^ (-(1 / 2 : Real)) ∧
        ‖directions pair.2 - directions anchor₁.2‖ ≤ D * scale ^ (-(1 / 2 : Real))) ∨
      (‖directions pair.1 - directions anchor₂.1‖ ≤ D * scale ^ (-(1 / 2 : Real)) ∧
        ‖directions pair.2 - directions anchor₂.2‖ ≤ D * scale ^ (-(1 / 2 : Real))) ) :
    active.card ≤ 2 * (2 * B + 1) ^ 2 := by
  apply aux_card_le_two_labelBoxes active anchor₁ anchor₂ B
  intro pair hpair
  rcases hactive pair hpair with ⟨hfirst, hsecond⟩
  rcases hcover pair hpair with hleft | hright
  · apply Finset.mem_union_left
    apply aux_mem_labelBox_of_natAbs_sub_le
    · exact aux_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hfirst
        hanchor₁.1 hD hleft.1
    · exact aux_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hsecond
        hanchor₁.2 hD hleft.2
  · apply Finset.mem_union_right
    apply aux_mem_labelBox_of_natAbs_sub_le
    · exact aux_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hfirst
        hanchor₂.1 hD hright.1
    · exact aux_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hsecond
        hanchor₂.2 hD hright.2

private theorem aux_low_scale_unitNormal_overlap_card_bound
    {scale angularConstant sectorRadius spacingLower spacingUpper : Real}
    {normalShift normalShift' : Real} {n n' : Int}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {k : Nat} {Z : WaveSpaceTime} {B : Nat}
    (hscale : 2 ≤ scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hcap : 1 / 2 ≤ 2 * |angularConstant| * scale ^ (-(1 / 2 : Real)))
    (hB : 2 * |angularConstant| ≤ spacingLower * (B : Real)) :
    (unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions k Z).card ≤ 2 * (2 * B + 1) ^ 2 := by
  classical
  let active := unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
    n n' indices directions k Z
  have hgeometryFull := hgeometry
  rcases hgeometry with ⟨_, hsector, _, _, center, _, hdata⟩
  have hscalepos : 0 < scale := by linarith
  by_cases hnonempty : active.Nonempty
  · obtain ⟨anchor, hanchor⟩ := hnonempty
    apply aux_card_le_two_labelBoxes_of_direction_boxes
      (active := active) (anchor₁ := anchor) (anchor₂ := anchor)
      (D := 2 * |angularConstant|) (B := B) hscalepos hgeometryFull
    · have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hanchor
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z anchor).mp hanchor' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.2.1⟩
    · have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hanchor
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z anchor).mp hanchor' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.2.1⟩
    · intro pair hpair
      have hpair' : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hpair
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z pair).mp hpair' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices k pair).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices k pair).mp hsep |>.2.1⟩
    · exact hB
    · intro pair hpair
      have hpair' : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hpair
      have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hanchor
      have hpsep := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
        normalShift' n n' indices directions k Z pair).mp hpair' |>.1
      have hasep := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
        normalShift' n n' indices directions k Z anchor).mp hanchor' |>.1
      have hpdata := (mem_angularSeparationPairs_iff indices k pair).mp hpsep
      have hadata := (mem_angularSeparationPairs_iff indices k anchor).mp hasep
      have hfirst : ‖directions pair.1 - directions anchor.1‖ ≤ 1 / 2 := by
        calc
          ‖directions pair.1 - directions anchor.1‖ ≤
              ‖directions pair.1 - center‖ + ‖center - directions anchor.1‖ := by
            rw [show directions pair.1 - directions anchor.1 =
              (directions pair.1 - center) + (center - directions anchor.1) by abel]
            exact norm_add_le _ _
          _ = ‖directions pair.1 - center‖ + ‖directions anchor.1 - center‖ := by
            exact congrArg (fun q : Real => ‖directions pair.1 - center‖ + q)
              (norm_sub_rev _ _)
          _ ≤ sectorRadius + sectorRadius := add_le_add
            (hdata pair.1 hpdata.1).2.1 (hdata anchor.1 hadata.1).2.1
          _ ≤ 1 / 2 := by linarith
      have hsecond : ‖directions pair.2 - directions anchor.2‖ ≤ 1 / 2 := by
        calc
          ‖directions pair.2 - directions anchor.2‖ ≤
              ‖directions pair.2 - center‖ + ‖center - directions anchor.2‖ := by
            rw [show directions pair.2 - directions anchor.2 =
              (directions pair.2 - center) + (center - directions anchor.2) by abel]
            exact norm_add_le _ _
          _ = ‖directions pair.2 - center‖ + ‖directions anchor.2 - center‖ := by
            exact congrArg (fun q : Real => ‖directions pair.2 - center‖ + q)
              (norm_sub_rev _ _)
          _ ≤ sectorRadius + sectorRadius := add_le_add
            (hdata pair.2 hpdata.2.1).2.1 (hdata anchor.2 hadata.2.1).2.1
          _ ≤ 1 / 2 := by linarith
      exact Or.inl ⟨le_trans hfirst hcap, le_trans hsecond hcap⟩
  · have hempty : active = ∅ := Finset.not_nonempty_iff_eq_empty.mp hnonempty
    simp [active, hempty]

/-- The coupled polar-coordinate calculation on one fixed area-sign branch.
This is deliberately phrased for literal witnesses so the finite packing step
can classify canonical witnesses without losing the normal/time coupling. -/
private theorem aux_transverse_same_sign_first_normalized_bound
    (o : Orientation Real (_root_.Codex.Spherical.SurfaceCore.Euclidean 2) (Fin 2))
    {scale h sq B lambda C ell angularConstant normalShift normalShift' : Real}
    {n n' : Int}
    {direction mate direction' mate' : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {Z z w z' w' : WaveSpaceTime}
    (hscale : 2 ≤ scale) (hh : 0 < h) (hhdef : h = scale ^ (-(1 / 2 : Real)))
    (hsq : 1 ≤ sq) (hsqroot : sq = Real.sqrt scale)
    (hhsq : h * sq = 1) (hhsquare : h ^ 2 * scale = 1)
    (hell : 0 < ell) (helllambda : ell ≤ lambda)
    (hC : 0 ≤ C) (hB : 0 ≤ B) (hlambda : 0 ≤ lambda)
    (hcompare : B ≤ C * lambda) (hlambdah : lambda * h ≤ 1 / 4)
    (hXlower : scale / 4 ≤ ‖Z.1‖)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction)
    (hw : w ∈ unitNormalConicPlate scale angularConstant normalShift' n' mate)
    (hz' : z' ∈ unitNormalConicPlate scale angularConstant normalShift n direction')
    (hw' : w' ∈ unitNormalConicPlate scale angularConstant normalShift' n' mate')
    (hzw : z + w = Z) (hz'w' : z' + w' = Z)
    (hchord : ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ≤ B * h)
    (hchord' : ‖(‖z'.1‖)⁻¹ • z'.1 - (‖w'.1‖)⁻¹ • w'.1‖ ≤ B * h)
    (hclose : ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ≤ 1)
    (hclose' : ‖(‖z'.1‖)⁻¹ • z'.1 - (‖w'.1‖)⁻¹ • w'.1‖ ≤ 1)
    (hgap : lambda * h ≤ ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖)
    (hgap' : lambda * h ≤ ‖(‖z'.1‖)⁻¹ • z'.1 - (‖w'.1‖)⁻¹ • w'.1‖)
    (hsign :
      (0 ≤ (o.areaForm Z.1) ((‖z.1‖)⁻¹ • z.1) ∧
        0 ≤ (o.areaForm Z.1) ((‖z'.1‖)⁻¹ • z'.1)) ∨
      ((o.areaForm Z.1) ((‖z.1‖)⁻¹ • z.1) ≤ 0 ∧
        (o.areaForm Z.1) ((‖z'.1‖)⁻¹ • z'.1) ≤ 0)) :
    ‖(‖z.1‖)⁻¹ • z.1 - (‖z'.1‖)⁻¹ • z'.1‖ ≤
      ((1056 + 192 * C ^ 2) + (4224 / ell + 1536 * C ^ 2)) * h := by
  have hscalepos : 0 < scale := by linarith
  have hlambdapos : 0 < lambda := lt_of_lt_of_le hell helllambda
  have hXpos : 0 < ‖Z.1‖ := by linarith
  have hXnonzero : Z.1 ≠ 0 := norm_ne_zero_iff.mp (ne_of_gt hXpos)
  have hznonzero : z.1 ≠ 0 := hz.2.2.1.1
  have hwnonzero : w.1 ≠ 0 := hw.2.2.1.1
  have hz'nonzero : z'.1 ≠ 0 := hz'.2.2.1.1
  have hw'nonzero : w'.1 ≠ 0 := hw'.2.2.1.1
  have hzu := aux_norm_normalized_eq_one hznonzero
  have hwu := aux_norm_normalized_eq_one hwnonzero
  have hzu' := aux_norm_normalized_eq_one hz'nonzero
  have hwu' := aux_norm_normalized_eq_one hw'nonzero
  have hspace : z.1 + w.1 = Z.1 := congrArg Prod.fst hzw
  have hspace' : z'.1 + w'.1 = Z.1 := congrArg Prod.fst hz'w'
  have hzrepr := aux_eq_norm_smul_normalized hznonzero
  have hwrepr := aux_eq_norm_smul_normalized hwnonzero
  have hz'repr := aux_eq_norm_smul_normalized hz'nonzero
  have hw'repr := aux_eq_norm_smul_normalized hw'nonzero
  have hrepr : Z.1 =
      ‖z.1‖ • ((‖z.1‖)⁻¹ • z.1) + ‖w.1‖ • ((‖w.1‖)⁻¹ • w.1) := by
    calc
      Z.1 = z.1 + w.1 := hspace.symm
      _ = ‖z.1‖ • ((‖z.1‖)⁻¹ • z.1) + ‖w.1‖ • ((‖w.1‖)⁻¹ • w.1) :=
        congrArg₂ (· + ·) hzrepr hwrepr
  have hrepr' : Z.1 =
      ‖z'.1‖ • ((‖z'.1‖)⁻¹ • z'.1) + ‖w'.1‖ • ((‖w'.1‖)⁻¹ • w'.1) := by
    calc
      Z.1 = z'.1 + w'.1 := hspace'.symm
      _ = ‖z'.1‖ • ((‖z'.1‖)⁻¹ • z'.1) + ‖w'.1‖ • ((‖w'.1‖)⁻¹ • w'.1) :=
        congrArg₂ (· + ·) hz'repr hw'repr
  have harea : lambda * sq / 8 ≤ |(o.areaForm Z.1) ((‖z.1‖)⁻¹ • z.1)| := by
    have harea' := aux_transverse_area_lower_of_chord_lower o hscalepos hw.1 hlambda
      hrepr hzu hwu hclose (by simpa [hhdef] using hgap)
    simpa [hsqroot] using harea'
  have harea' : lambda * sq / 8 ≤ |(o.areaForm Z.1) ((‖z'.1‖)⁻¹ • z'.1)| := by
    have harea'' := aux_transverse_area_lower_of_chord_lower o hscalepos hw'.1 hlambda
      hrepr' hzu' hwu' hclose' (by simpa [hhdef] using hgap')
    simpa [hsqroot] using harea''
  have hinner := aux_two_active_polar_inner_coordinate_stable hscale hB
    hz hw hz' hw' hzw hz'w' (by
      simpa [hhdef] using hchord')
  have hinner' : |inner Real Z.1 ((‖z.1‖)⁻¹ • z.1) -
      inner Real Z.1 ((‖z'.1‖)⁻¹ • z'.1)| ≤ 264 + 768 * B ^ 2 * h := by
    simpa [hhdef] using hinner
  have hquot := aux_transverse_coordinate_quotient_bounds
    hscale hh hsq hhsq hhsquare hell helllambda hC hB hlambda hcompare hlambdah
  have hDnonneg : 0 ≤ 264 + 768 * B ^ 2 * h := by positivity
  have hquarterpos : 0 < scale / 4 := by linarith
  have hXquot : (264 + 768 * B ^ 2 * h) / ‖Z.1‖ ≤
      (1056 + 192 * C ^ 2) * h := by
    calc
      (264 + 768 * B ^ 2 * h) / ‖Z.1‖ ≤
          (264 + 768 * B ^ 2 * h) / (scale / 4) := by
        exact div_le_div_of_nonneg_left hDnonneg hquarterpos hXlower
      _ ≤ (1056 + 192 * C ^ 2) * h := hquot.1
  exact aux_same_sign_direction_bound_of_coordinate_bounds o hXpos
    (by positivity : 0 < lambda * sq / 8) hzu hzu' ⟨harea, harea'⟩ hsign hinner'
    hXquot hquot.2

private def aux_transverseCoreConstant (spacingLower spacingUpper : Real) : Real :=
  (1056 + 192 * (4 * spacingUpper / spacingLower + 1) ^ 2) +
    (4224 / (spacingLower / 2) +
      1536 * (4 * spacingUpper / spacingLower + 1) ^ 2)

private def aux_transverseCapConstant
    (angularConstant spacingLower spacingUpper : Real) : Real :=
  2 * |angularConstant| + 48 +
    16 * aux_transverseCoreConstant spacingLower spacingUpper

set_option maxHeartbeats 800000 in
/-- The high transverse branch has two stable directional caps, one for each
area sign.  This is the literal pairwise cap estimate used by the finite
label-box cover. -/
private theorem aux_high_transverse_same_sign_direction_boxes
    (o : Orientation Real (_root_.Codex.Spherical.SurfaceCore.Euclidean 2) (Fin 2))
    {scale angularConstant sectorRadius spacingLower spacingUpper : Real}
    {normalShift normalShift' : Real} {n n' : Int}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {m : Nat} {Z : WaveSpaceTime} {pair anchor : Int × Int}
    (hscale : 2 ≤ scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (htransverse : 4 * |angularConstant| <
      spacingLower * ((2 ^ m : Nat) : Real))
    (hpair : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z)
    (hanchor : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z)
    (hsign :
      (0 ≤ (o.areaForm Z.1)
          (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair) ∧
        0 ≤ (o.areaForm Z.1)
          (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor)) ∨
      ((o.areaForm Z.1)
          (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair) ≤ 0 ∧
        (o.areaForm Z.1)
          (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor) ≤ 0)) :
    ‖directions pair.1 - directions anchor.1‖ ≤
        aux_transverseCapConstant angularConstant spacingLower spacingUpper *
          scale ^ (-(1 / 2 : Real)) ∧
      ‖directions pair.2 - directions anchor.2‖ ≤
        aux_transverseCapConstant angularConstant spacingLower spacingUpper *
          scale ^ (-(1 / 2 : Real)) := by
  have hgeometryFull := hgeometry
  rcases hgeometry with ⟨_, hsector, hspacingLower, hspacingUpper,
    center, hcenter, hdata⟩
  have hscalepos : 0 < scale := by linarith
  have hpowpos : 0 < scale ^ (-(1 / 2 : Real)) := Real.rpow_pos_of_pos hscalepos _
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := hpowpos.le
  have hsq : 1 ≤ Real.sqrt scale := Real.one_le_sqrt.mpr (by linarith)
  have hhsq := aux_rpow_neg_half_mul_sqrt_eq_one hscalepos
  have hhsquare := aux_rpow_neg_half_sq_mul_scale_eq_one hscalepos
  have hqpos : 0 < ((2 ^ m : Nat) : Real) := by positivity
  have hqone : 1 ≤ ((2 ^ m : Nat) : Real) := by
    exact_mod_cast (Nat.one_le_two_pow)
  have hell : 0 < spacingLower / 2 := by positivity
  have helllambda : spacingLower / 2 ≤
      spacingLower * ((2 ^ m : Nat) : Real) / 2 := by
    have hmul : spacingLower * 1 ≤ spacingLower * ((2 ^ m : Nat) : Real) :=
      mul_le_mul_of_nonneg_left hqone hspacingLower.le
    nlinarith [hmul]
  have hlambda : 0 ≤ spacingLower * ((2 ^ m : Nat) : Real) / 2 := by positivity
  have hU : 0 ≤ 2 * spacingUpper * ((2 ^ m : Nat) : Real) + 2 * |angularConstant| := by
    positivity
  have hC : 0 ≤ 4 * spacingUpper / spacingLower + 1 := by positivity
  have hcompare :
      2 * spacingUpper * ((2 ^ m : Nat) : Real) + 2 * |angularConstant| ≤
        (4 * spacingUpper / spacingLower + 1) *
          (spacingLower * ((2 ^ m : Nat) : Real) / 2) := by
    have harea : 2 * |angularConstant| ≤
        spacingLower * ((2 ^ m : Nat) : Real) / 2 := by
      nlinarith [htransverse]
    calc
      2 * spacingUpper * ((2 ^ m : Nat) : Real) + 2 * |angularConstant| ≤
          2 * spacingUpper * ((2 ^ m : Nat) : Real) +
            spacingLower * ((2 ^ m : Nat) : Real) / 2 := by gcongr
      _ = (4 * spacingUpper / spacingLower + 1) *
          (spacingLower * ((2 ^ m : Nat) : Real) / 2) := by
          field_simp [ne_of_gt hspacingLower]
          ring
  have hsepPair := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
    normalShift' n n' indices directions (m + 1) Z pair).mp hpair |>.1

  have hsepAnchor := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
    normalShift' n n' indices directions (m + 1) Z anchor).mp hanchor |>.1
  have hcentersPair := aux_angular_direction_chord_bounds_succ hscalepos hgeometryFull hsepPair
  have hcentersAnchor := aux_angular_direction_chord_bounds_succ hscalepos hgeometryFull hsepAnchor
  have hscaled := aux_scaled_dyadic_index_le_half hscalepos hgeometryFull hsepPair
  have hlambdah : (spacingLower * ((2 ^ m : Nat) : Real) / 2) *
      scale ^ (-(1 / 2 : Real)) ≤ 1 / 4 := by
    nlinarith [hscaled]
  have hpdata := (mem_angularSeparationPairs_iff indices (m + 1) pair).mp hsepPair
  have hadata := (mem_angularSeparationPairs_iff indices (m + 1) anchor).mp hsepAnchor
  rcases aux_active_pair_witness_spec scale angularConstant normalShift normalShift'
    n n' indices directions (m + 1) Z pair hpair with ⟨hpz, hpw, hpzw⟩
  rcases aux_active_pair_witness_spec scale angularConstant normalShift normalShift'
    n n' indices directions (m + 1) Z anchor hanchor with ⟨haz, haw, hazw⟩
  have hpzerr := aux_plate_normalized_direction_bound_abs hscalepos hpz
  have hpwerr := aux_plate_normalized_direction_bound_abs hscalepos hpw
  have hazerr := aux_plate_normalized_direction_bound_abs hscalepos haz
  have hawerr := aux_plate_normalized_direction_bound_abs hscalepos haw
  have hpchordlower : (spacingLower * ((2 ^ m : Nat) : Real) / 2) *
      scale ^ (-(1 / 2 : Real)) ≤
        ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions (m + 1) Z pair).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair).1.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair).2.1‖ := by
    have hraw := aux_chord_lower_of_center_direction_bounds hcentersPair.1 hpzerr hpwerr
    calc
      (spacingLower * ((2 ^ m : Nat) : Real) / 2) *
          scale ^ (-(1 / 2 : Real)) ≤
          (spacingLower * ((2 ^ m : Nat) : Real) - 2 * |angularConstant|) *
            scale ^ (-(1 / 2 : Real)) := by
          apply mul_le_mul_of_nonneg_right _ hpow
          nlinarith [htransverse]
      _ ≤ _ := hraw
  have hachordlower : (spacingLower * ((2 ^ m : Nat) : Real) / 2) *
      scale ^ (-(1 / 2 : Real)) ≤
        ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions (m + 1) Z anchor).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor).1.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor).2.1‖ := by
    have hraw := aux_chord_lower_of_center_direction_bounds hcentersAnchor.1 hazerr hawerr
    calc
      (spacingLower * ((2 ^ m : Nat) : Real) / 2) *
          scale ^ (-(1 / 2 : Real)) ≤
          (spacingLower * ((2 ^ m : Nat) : Real) - 2 * |angularConstant|) *
            scale ^ (-(1 / 2 : Real)) := by
          apply mul_le_mul_of_nonneg_right _ hpow
          nlinarith [htransverse]
      _ ≤ _ := hraw
  have hpchord : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z pair).1.1‖)⁻¹ •
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z pair).1.1 -
      (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z pair).2.1‖)⁻¹ •
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z pair).2.1‖ ≤
      (2 * spacingUpper * ((2 ^ m : Nat) : Real) + 2 * |angularConstant|) *
        scale ^ (-(1 / 2 : Real)) := by
    have hupper : ‖directions pair.1 - directions pair.2‖ ≤
        (2 * spacingUpper * ((2 ^ m : Nat) : Real)) *
          scale ^ (-(1 / 2 : Real)) := by
      calc
        ‖directions pair.1 - directions pair.2‖ ≤
            spacingUpper * ((2 ^ (m + 1) : Nat) : Real) *
              scale ^ (-(1 / 2 : Real)) := hcentersPair.2
        _ = (2 * spacingUpper * ((2 ^ m : Nat) : Real)) *
              scale ^ (-(1 / 2 : Real)) := by
              have hpowtwo : ((2 ^ (m + 1) : Nat) : Real) =
                  2 * ((2 ^ m : Nat) : Real) := by
                rw [pow_succ, Nat.cast_mul]
                norm_num
                ring
              rw [hpowtwo]
              ring
    exact aux_chord_upper_of_center_direction_bounds hupper hpzerr hpwerr
  have hachord : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z anchor).1.1‖)⁻¹ •
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z anchor).1.1 -
      (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z anchor).2.1‖)⁻¹ •
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z anchor).2.1‖ ≤
      (2 * spacingUpper * ((2 ^ m : Nat) : Real) + 2 * |angularConstant|) *
        scale ^ (-(1 / 2 : Real)) := by
    have hupper : ‖directions anchor.1 - directions anchor.2‖ ≤
        (2 * spacingUpper * ((2 ^ m : Nat) : Real)) *
          scale ^ (-(1 / 2 : Real)) := by
      calc
        ‖directions anchor.1 - directions anchor.2‖ ≤
            spacingUpper * ((2 ^ (m + 1) : Nat) : Real) *
              scale ^ (-(1 / 2 : Real)) := hcentersAnchor.2
        _ = (2 * spacingUpper * ((2 ^ m : Nat) : Real)) *
              scale ^ (-(1 / 2 : Real)) := by
              have hpowtwo : ((2 ^ (m + 1) : Nat) : Real) =
                  2 * ((2 ^ m : Nat) : Real) := by
                rw [pow_succ, Nat.cast_mul]
                norm_num
                ring
              rw [hpowtwo]
              ring
    exact aux_chord_upper_of_center_direction_bounds hupper hazerr hawerr
  have hcenterPair : ‖directions pair.1 - directions pair.2‖ ≤ 1 / 2 := by
    calc
      ‖directions pair.1 - directions pair.2‖ ≤
          ‖directions pair.1 - center‖ + ‖center - directions pair.2‖ := by
        rw [show directions pair.1 - directions pair.2 =
          (directions pair.1 - center) + (center - directions pair.2) by abel]
        exact norm_add_le _ _
      _ = ‖directions pair.1 - center‖ + ‖directions pair.2 - center‖ := by
        exact congrArg (fun q : Real => ‖directions pair.1 - center‖ + q)
          (norm_sub_rev center (directions pair.2))
      _ ≤ sectorRadius + sectorRadius := by
        apply add_le_add
        · exact (hdata pair.1 hpdata.1).2.1
        · exact (hdata pair.2 hpdata.2.1).2.1
      _ ≤ 1 / 2 := by linarith
  have hcenterAnchor : ‖directions anchor.1 - directions anchor.2‖ ≤ 1 / 2 := by
    calc
      ‖directions anchor.1 - directions anchor.2‖ ≤
          ‖directions anchor.1 - center‖ + ‖center - directions anchor.2‖ := by
        rw [show directions anchor.1 - directions anchor.2 =
          (directions anchor.1 - center) + (center - directions anchor.2) by abel]
        exact norm_add_le _ _
      _ = ‖directions anchor.1 - center‖ + ‖directions anchor.2 - center‖ := by
        exact congrArg (fun q : Real => ‖directions anchor.1 - center‖ + q)
          (norm_sub_rev center (directions anchor.2))
      _ ≤ sectorRadius + sectorRadius := by
        apply add_le_add
        · exact (hdata anchor.1 hadata.1).2.1
        · exact (hdata anchor.2 hadata.2.1).2.1
      _ ≤ 1 / 2 := by linarith
  have hpclose := aux_normalized_chord_le_one_of_high_common_sector hscalepos hhigh
    hcenterPair hpz hpw
  have haclose := aux_normalized_chord_le_one_of_high_common_sector hscalepos hhigh
    hcenterAnchor haz haw
  have hXlower := aux_output_norm_lower_of_high_sector_witnesses hscale hcenter
    (le_trans (hdata pair.1 hpdata.1).2.1 hsector)
    (le_trans (hdata pair.2 hpdata.2.1).2.1 hsector) hhigh hpz hpw hpzw
  have hfirstnorm := aux_transverse_same_sign_first_normalized_bound o
    hscale hpowpos rfl hsq rfl hhsq hhsquare hell helllambda hC hU hlambda hcompare hlambdah
    hXlower hpz hpw haz haw hpzw hazw hpchord hachord hpclose haclose
    hpchordlower hachordlower (by
      simpa only [aux_activeFirstNormalized] using hsign)
  have hcore : 0 ≤ aux_transverseCoreConstant spacingLower spacingUpper := by
    simp only [aux_transverseCoreConstant]
    positivity
  have hfirstnorm' : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z pair).1.1‖)⁻¹ •
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z pair).1.1 -
      (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z anchor).1.1‖)⁻¹ •
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z anchor).1.1‖ ≤
      aux_transverseCoreConstant spacingLower spacingUpper *
        scale ^ (-(1 / 2 : Real)) := by
    simpa only [aux_transverseCoreConstant] using hfirstnorm
  have hfirst := aux_direction_centres_close_of_normalized_pair
    hpzerr hazerr hfirstnorm'
  have hzradial := aux_mem_unitNormalConicPlate_radius_localized hscalepos hpz
  have hazradial := aux_mem_unitNormalConicPlate_radius_localized hscalepos haz
  have hwradial := aux_mem_unitNormalConicPlate_radius_localized hscalepos hpw
  have hawradial := aux_mem_unitNormalConicPlate_radius_localized hscalepos haw
  have hrdiff := aux_radial_window_difference_le_six_sqrt hscale hzradial hazradial
  have hsdiff := aux_radial_window_difference_le_six_sqrt hscale hwradial hawradial
  have hpznonzero : (aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z pair).1.1 ≠ 0 := hpz.2.2.1.1
  have hpwnonzero : (aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z pair).2.1 ≠ 0 := hpw.2.2.1.1
  have haznonzero : (aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z anchor).1.1 ≠ 0 := haz.2.2.1.1
  have hawnonzero : (aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z anchor).2.1 ≠ 0 := haw.2.2.1.1
  have hsecondnorm := aux_second_direction_bound_of_first_and_radial_windows
    hscalepos hcore (norm_nonneg _) hpz.2.1 hpw.1 hrdiff hsdiff hfirstnorm'
    (aux_norm_normalized_eq_one haznonzero)
    (aux_norm_normalized_eq_one hawnonzero)
    (by
      have hpzrepr := aux_eq_norm_smul_normalized hpznonzero
      have hpwrepr := aux_eq_norm_smul_normalized hpwnonzero
      have hspace : (aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions (m + 1) Z pair).1.1 +
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair).2.1 = Z.1 := congrArg Prod.fst hpzw
      calc
        Z.1 = (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair).1.1 +
            (aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z pair).2.1 := hspace.symm
        _ = ‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair).1.1‖ •
            ((‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z pair).1.1‖)⁻¹ •
              (aux_active_pair_witness scale angularConstant normalShift normalShift'
                n n' indices directions (m + 1) Z pair).1.1) +
            ‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z pair).2.1‖ •
            ((‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z pair).2.1‖)⁻¹ •
              (aux_active_pair_witness scale angularConstant normalShift normalShift'
                n n' indices directions (m + 1) Z pair).2.1) := congrArg₂ (· + ·) hpzrepr hpwrepr)
    (by
      have hazrepr := aux_eq_norm_smul_normalized haznonzero
      have hawrepr := aux_eq_norm_smul_normalized hawnonzero
      have hspace : (aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions (m + 1) Z anchor).1.1 +
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor).2.1 = Z.1 := congrArg Prod.fst hazw
      calc
        Z.1 = (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor).1.1 +
            (aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z anchor).2.1 := hspace.symm
        _ = ‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor).1.1‖ •
            ((‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z anchor).1.1‖)⁻¹ •
              (aux_active_pair_witness scale angularConstant normalShift normalShift'
                n n' indices directions (m + 1) Z anchor).1.1) +
            ‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z anchor).2.1‖ •
            ((‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z anchor).2.1‖)⁻¹ •
              (aux_active_pair_witness scale angularConstant normalShift normalShift'
                n n' indices directions (m + 1) Z anchor).2.1) := congrArg₂ (· + ·) hazrepr hawrepr)
  have hsecond := aux_direction_centres_close_of_normalized_pair hpwerr hawerr hsecondnorm
  constructor
  · calc
      ‖directions pair.1 - directions anchor.1‖ ≤
          (2 * |angularConstant| + aux_transverseCoreConstant spacingLower spacingUpper) *
            scale ^ (-(1 / 2 : Real)) := hfirst
      _ ≤ aux_transverseCapConstant angularConstant spacingLower spacingUpper *
            scale ^ (-(1 / 2 : Real)) := by
            apply mul_le_mul_of_nonneg_right _ hpow
            simp only [aux_transverseCapConstant]
            nlinarith [hcore]
  · calc
      ‖directions pair.2 - directions anchor.2‖ ≤
          (2 * |angularConstant| +
            (48 + 16 * aux_transverseCoreConstant spacingLower spacingUpper)) *
            scale ^ (-(1 / 2 : Real)) := hsecond
      _ = aux_transverseCapConstant angularConstant spacingLower spacingUpper *
            scale ^ (-(1 / 2 : Real)) := by
            simp only [aux_transverseCapConstant]
            ring

private theorem aux_card_le_one_labelBox_of_direction_box
    {scale sectorRadius spacingLower spacingUpper D : Real}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (active : Finset (Int × Int)) (anchor : Int × Int) (B : Nat)
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hanchor : anchor.1 ∈ indices ∧ anchor.2 ∈ indices)
    (hactive : ∀ pair ∈ active, pair.1 ∈ indices ∧ pair.2 ∈ indices)
    (hD : D ≤ spacingLower * (B : Real))
    (hcover : ∀ pair ∈ active,
      ‖directions pair.1 - directions anchor.1‖ ≤ D * scale ^ (-(1 / 2 : Real)) ∧
      ‖directions pair.2 - directions anchor.2‖ ≤ D * scale ^ (-(1 / 2 : Real))) :
    active.card ≤ (2 * B + 1) ^ 2 := by
  calc
    active.card ≤ (aux_labelBox anchor B).card := by
      apply Finset.card_le_card
      intro pair hpair
      rcases hactive pair hpair with ⟨hfirst, hsecond⟩
      rcases hcover pair hpair with ⟨hfirstbox, hsecondbox⟩
      exact aux_mem_labelBox_of_natAbs_sub_le
        (aux_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hfirst hanchor.1 hD hfirstbox)
        (aux_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hsecond hanchor.2 hD hsecondbox)
    _ = (2 * B + 1) ^ 2 := aux_card_labelBox anchor B

set_option maxHeartbeats 1200000 in
private theorem aux_high_transverse_overlap_card_bound
    {scale angularConstant sectorRadius spacingLower spacingUpper : Real}
    {normalShift normalShift' : Real} {n n' : Int}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {m : Nat} {Z : WaveSpaceTime} {B : Nat}
    (hscale : 2 ≤ scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (htransverse : 4 * |angularConstant| <
      spacingLower * ((2 ^ m : Nat) : Real))
    (hB : aux_transverseCapConstant angularConstant spacingLower spacingUpper ≤
      spacingLower * (B : Real)) :
    (unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z).card ≤ 2 * (2 * B + 1) ^ 2 := by
  classical
  let active := unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
    n n' indices directions (m + 1) Z
  let o : Orientation Real (_root_.Codex.Spherical.SurfaceCore.Euclidean 2) (Fin 2) :=
    (EuclideanSpace.basisFun (Fin 2) Real).toBasis.orientation
  let positive : Finset (Int × Int) := active.filter fun pair =>
    0 ≤ (o.areaForm Z.1)
      (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z pair)
  let negative : Finset (Int × Int) := active.filter fun pair =>
    ¬ 0 ≤ (o.areaForm Z.1)
      (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z pair)
  have hscalepos : 0 < scale := by linarith
  have hactiveIndices : ∀ pair ∈ active, pair.1 ∈ indices ∧ pair.2 ∈ indices := by
    intro pair hpair
    have hpair' : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
        normalShift' n n' indices directions (m + 1) Z := by simpa [active] using hpair
    have hsep := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
      normalShift' n n' indices directions (m + 1) Z pair).mp hpair' |>.1
    exact ⟨(mem_angularSeparationPairs_iff indices (m + 1) pair).mp hsep |>.1,
      (mem_angularSeparationPairs_iff indices (m + 1) pair).mp hsep |>.2.1⟩
  have hsplit : active ⊆ positive ∪ negative := by
    intro pair hpair
    by_cases hp : 0 ≤ (o.areaForm Z.1)
        (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
          n n' indices directions (m + 1) Z pair)
    · apply Finset.mem_union_left
      exact Finset.mem_filter.mpr ⟨hpair, hp⟩
    · apply Finset.mem_union_right
      exact Finset.mem_filter.mpr ⟨hpair, hp⟩
  have hpositiveBound : positive.card ≤ (2 * B + 1) ^ 2 := by
    by_cases hpos : positive.Nonempty
    · obtain ⟨anchor, hanchor⟩ := hpos
      apply aux_card_le_one_labelBox_of_direction_box positive anchor B hscalepos hgeometry
      · exact hactiveIndices anchor (Finset.mem_filter.mp hanchor).1
      · intro pair hpair
        exact hactiveIndices pair (Finset.mem_filter.mp hpair).1
      · exact hB
      · intro pair hpair
        have hpairActive := (Finset.mem_filter.mp hpair).1
        have hpairSign := (Finset.mem_filter.mp hpair).2
        have hanchorActive := (Finset.mem_filter.mp hanchor).1
        have hanchorSign := (Finset.mem_filter.mp hanchor).2
        have hboxes := aux_high_transverse_same_sign_direction_boxes o hscale hgeometry
          hhigh htransverse
          (by simpa [active] using hpairActive)
          (by simpa [active] using hanchorActive)
          (Or.inl ⟨hpairSign, hanchorSign⟩)
        exact hboxes
    · have hempty : positive = ∅ := Finset.not_nonempty_iff_eq_empty.mp hpos
      simp [hempty]
  have hnegativeBound : negative.card ≤ (2 * B + 1) ^ 2 := by
    by_cases hneg : negative.Nonempty
    · obtain ⟨anchor, hanchor⟩ := hneg
      apply aux_card_le_one_labelBox_of_direction_box negative anchor B hscalepos hgeometry
      · exact hactiveIndices anchor (Finset.mem_filter.mp hanchor).1
      · intro pair hpair
        exact hactiveIndices pair (Finset.mem_filter.mp hpair).1
      · exact hB
      · intro pair hpair
        have hpairActive := (Finset.mem_filter.mp hpair).1
        have hpairSign := (Finset.mem_filter.mp hpair).2
        have hanchorActive := (Finset.mem_filter.mp hanchor).1
        have hanchorSign := (Finset.mem_filter.mp hanchor).2
        have hpairNonpos : (o.areaForm Z.1)
            (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z pair) ≤ 0 :=
          le_of_lt (lt_of_not_ge hpairSign)
        have hanchorNonpos : (o.areaForm Z.1)
            (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z anchor) ≤ 0 :=
          le_of_lt (lt_of_not_ge hanchorSign)
        have hboxes := aux_high_transverse_same_sign_direction_boxes o hscale hgeometry
          hhigh htransverse
          (by simpa [active] using hpairActive)
          (by simpa [active] using hanchorActive)
          (Or.inr ⟨hpairNonpos, hanchorNonpos⟩)
        exact hboxes
    · have hempty : negative = ∅ := Finset.not_nonempty_iff_eq_empty.mp hneg
      simp [hempty]
  calc
    active.card ≤ (positive ∪ negative).card := Finset.card_le_card hsplit
    _ ≤ positive.card + negative.card := Finset.card_union_le _ _
    _ ≤ (2 * B + 1) ^ 2 + (2 * B + 1) ^ 2 := add_le_add hpositiveBound hnegativeBound
    _ = 2 * (2 * B + 1) ^ 2 := by ring

set_option maxHeartbeats 1200000 in
theorem translatedUnitNormalPlateOverlap_of_angularSectorGeometry
    (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real) :
    translatedUnitNormalPlateOverlap maxLevel angularConstant sectorRadius
      spacingLower spacingUpper := by
  classical
  by_cases hspacingLower : 0 < spacingLower
  · by_cases hspacingUpper : 0 < spacingUpper
    · let Dlow : Real := 2 * |angularConstant|
      let Dzero : Real := 2 * |angularConstant| +
        32 * (spacingUpper + 2 * |angularConstant|)
      let Dtangent : Real := 2 * |angularConstant| +
        32 * (8 * |angularConstant| * spacingUpper / spacingLower +
          2 * |angularConstant|)
      let Dtransverse : Real :=
        aux_transverseCapConstant angularConstant spacingLower spacingUpper
      let D : Real := Dlow + Dzero + Dtangent + Dtransverse
      have hDlow0 : 0 ≤ Dlow := by
        simp only [Dlow]
        positivity
      have hDzero0 : 0 ≤ Dzero := by
        simp only [Dzero]
        positivity
      have hDtangent0 : 0 ≤ Dtangent := by
        simp only [Dtangent]
        positivity
      have hDtransverse0 : 0 ≤ Dtransverse := by
        simp only [Dtransverse, aux_transverseCapConstant,
          aux_transverseCoreConstant]
        positivity
      have hDlow : Dlow ≤ D := by
        dsimp [D]
        nlinarith
      have hDzero : Dzero ≤ D := by
        dsimp [D]
        nlinarith
      have hDtangent : Dtangent ≤ D := by
        dsimp [D]
        nlinarith
      have hDtransverse : Dtransverse ≤ D := by
        dsimp [D]
        nlinarith
      obtain ⟨B, hB⟩ := exists_nat_gt (D / spacingLower)
      refine ⟨2 * (2 * B + 1) ^ 2, ?_⟩
      intro scale hscale radialIndices angularIndices directions hgeometry
        n hn n' hn' k hk Z normalShift normalShift'
      have hBD : D ≤ spacingLower * (B : Real) := by
        simpa [mul_comm] using (div_lt_iff₀ hspacingLower).mp hB |>.le
      have hBlow : 2 * |angularConstant| ≤ spacingLower * (B : Real) := by
        calc
          2 * |angularConstant| = Dlow := by simp only [Dlow]
          _ ≤ D := hDlow
          _ ≤ spacingLower * (B : Real) := hBD
      have hBzero : 2 * |angularConstant| +
          32 * (spacingUpper + 2 * |angularConstant|) ≤ spacingLower * (B : Real) := by
        calc
          2 * |angularConstant| + 32 * (spacingUpper + 2 * |angularConstant|) = Dzero := by
            simp only [Dzero]
          _ ≤ D := hDzero
          _ ≤ spacingLower * (B : Real) := hBD
      have hBtangent : 2 * |angularConstant| +
          32 * (8 * |angularConstant| * spacingUpper / spacingLower +
            2 * |angularConstant|) ≤ spacingLower * (B : Real) := by
        calc
          2 * |angularConstant| +
              32 * (8 * |angularConstant| * spacingUpper / spacingLower +
                2 * |angularConstant|) = Dtangent := by simp only [Dtangent]
          _ ≤ D := hDtangent
          _ ≤ spacingLower * (B : Real) := hBD
      have hBtransverse : aux_transverseCapConstant angularConstant spacingLower spacingUpper ≤
          spacingLower * (B : Real) := by
        calc
          aux_transverseCapConstant angularConstant spacingLower spacingUpper = Dtransverse := by
            simp only [Dtransverse]
          _ ≤ D := hDtransverse
          _ ≤ spacingLower * (B : Real) := hBD
      by_cases hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4
      · cases k with
        | zero =>
            simpa [unitNormalPlateOverlapMultiplicity] using
              (aux_high_zero_unitNormal_overlap_card_bound hscale hgeometry hhigh hBzero)
        | succ m =>
            by_cases htangent : spacingLower * ((2 ^ m : Nat) : Real) ≤
                4 * |angularConstant|
            · simpa [unitNormalPlateOverlapMultiplicity] using
                (aux_high_tangent_overlap_card_bound hscale hgeometry hhigh htangent hBtangent)
            · have htransverse : 4 * |angularConstant| <
                spacingLower * ((2 ^ m : Nat) : Real) := lt_of_not_ge htangent
              simpa [unitNormalPlateOverlapMultiplicity] using
                (aux_high_transverse_overlap_card_bound hscale hgeometry hhigh htransverse
                  hBtransverse)
      · have hcap : 1 / 2 ≤
          2 * |angularConstant| * scale ^ (-(1 / 2 : Real)) := by
            nlinarith [lt_of_not_ge hhigh]
        simpa [unitNormalPlateOverlapMultiplicity] using
          (aux_low_scale_unitNormal_overlap_card_bound hscale hgeometry hcap hBlow)
    · refine ⟨0, ?_⟩
      intro scale hscale radialIndices angularIndices directions hgeometry
        n hn n' hn' k hk Z normalShift normalShift'
      rcases hgeometry with ⟨_, _, _, hupper, _, _, _⟩
      exact False.elim (hspacingUpper hupper)
  · refine ⟨0, ?_⟩
    intro scale hscale radialIndices angularIndices directions hgeometry
      n hn n' hn' k hk Z normalShift normalShift'
    rcases hgeometry with ⟨_, _, hlower, _, _, _, _⟩
    exact False.elim (hspacingLower hlower)

/-- Conditional thick-plate overlap transfer.  The only geometric hypothesis
is `translatedUnitNormalPlateOverlap`; the finite `4 ℤ` normal cover and its
two-factor cardinality loss are proved above. -/
theorem plateOverlap_of_translatedUnitNormalPlateOverlap
    (maxLevel : Real → Nat) (angularConstant sectorRadius spacingLower spacingUpper : Real)
    (hangular : 0 < angularConstant)
    (hunit : translatedUnitNormalPlateOverlap maxLevel angularConstant
      sectorRadius spacingLower spacingUpper) :
    plateOverlap maxLevel angularConstant sectorRadius spacingLower spacingUpper := by
  rcases hunit with ⟨M, hM⟩
  refine ⟨hangular, 2, by norm_num, ?_⟩
  intro gamma hgamma hgammaUpper
  refine ⟨36 * (M : Real) + 1, by positivity, ?_⟩
  intro scale hscale radialIndices angularIndices directions hgeometry n hn n' hn' k hk Z
  let normalShifts : Finset Real := normalCoverShifts (scale ^ gamma)
  have hcover : normalCoordinatePlateCover scale gamma angularConstant normalShifts := by
    simpa [normalShifts] using
      normalCoordinatePlateCover_normalCoverShifts scale gamma angularConstant
  have hunitBound : ∀ shift ∈ normalShifts, ∀ shift' ∈ normalShifts,
      unitNormalPlateOverlapMultiplicity scale angularConstant shift shift'
        n n' angularIndices directions k Z ≤ M := by
    intro shift hshift shift' hshift'
    exact hM scale hscale radialIndices angularIndices directions hgeometry n hn n' hn'
      k hk Z shift shift'
  have hnat := plateOverlapMultiplicity_le_normalCover_mul_unitBound
    scale gamma angularConstant normalShifts n n' angularIndices directions k Z M hcover hunitBound
  have hmult : (plateOverlapMultiplicity scale gamma angularConstant n n'
      angularIndices directions k Z : Real) ≤
      (normalShifts.card : Real) * (normalShifts.card : Real) * (M : Real) := by
    exact_mod_cast hnat
  have hcard : (normalShifts.card : Real) ≤ 6 * scale ^ gamma := by
    simpa [normalShifts] using
      card_normalCoverShifts_at_scale_le_six_mul scale gamma hscale hgamma.le
  have hcard0 : 0 ≤ (normalShifts.card : Real) := Nat.cast_nonneg _
  have hsquare : (normalShifts.card : Real) * (normalShifts.card : Real) ≤
      (6 * scale ^ gamma) * (6 * scale ^ gamma) :=
    mul_self_le_mul_self hcard0 hcard
  have hM0 : 0 ≤ (M : Real) := Nat.cast_nonneg _
  have hscaled : (normalShifts.card : Real) * (normalShifts.card : Real) * (M : Real) ≤
      (6 * scale ^ gamma) * (6 * scale ^ gamma) * (M : Real) :=
    mul_le_mul_of_nonneg_right hsquare hM0
  have hscale0 : 0 ≤ scale := by linarith
  have hscalePos : 0 < scale := by linarith
  have hrpow : scale ^ gamma * scale ^ gamma = scale ^ (2 * gamma) := by
    rw [← Real.rpow_add hscalePos]
    congr 1
    ring
  have htarget0 : 0 ≤ scale ^ (2 * gamma) := Real.rpow_nonneg hscale0 _
  calc
    (plateOverlapMultiplicity scale gamma angularConstant n n'
        angularIndices directions k Z : Real) ≤
        (normalShifts.card : Real) * (normalShifts.card : Real) * (M : Real) := hmult
    _ ≤ (6 * scale ^ gamma) * (6 * scale ^ gamma) * (M : Real) := hscaled
    _ = 36 * (M : Real) * scale ^ (2 * gamma) := by rw [← hrpow]; ring
    _ ≤ (36 * (M : Real) + 1) * scale ^ (2 * gamma) := by
      apply mul_le_mul_of_nonneg_right
      · linarith
      · exact htarget0

/-- The literal unit-normal overlap theorem closes the conditional plate-overlap transfer. -/
theorem plateOverlap_of_angularSectorGeometry
    (maxLevel : Real → Nat) (angularConstant sectorRadius spacingLower spacingUpper : Real)
    (hangular : 0 < angularConstant) :
    plateOverlap maxLevel angularConstant sectorRadius spacingLower spacingUpper := by
  exact plateOverlap_of_translatedUnitNormalPlateOverlap maxLevel angularConstant
    sectorRadius spacingLower spacingUpper hangular
    (translatedUnitNormalPlateOverlap_of_angularSectorGeometry maxLevel angularConstant
      sectorRadius spacingLower spacingUpper)

/-- The finite output-frequency fourth-power quantity attached to the literal
thick conic plate-overlap fibers. -/
noncomputable def finitePlateOverlapSquareEnergy
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (outputs : Finset WaveSpaceTime)
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) : Real :=
  ∑ Z ∈ outputs,
    (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
      ‖F pair.1 z * G pair.2 z‖) ^ 2

/-- The actual finite cube identifiers whose supplied output-frequency label
equals a specified conic pair-sum frequency. -/
noncomputable def plateOverlapCubeOutputFiber {κ : Type*} [DecidableEq κ]
    (cubes : Finset κ) (output : κ → WaveSpaceTime) (Z : WaveSpaceTime) : Finset κ := by
  classical
  exact cubes.filter (fun cube => output cube = Z)

theorem mem_plateOverlapCubeOutputFiber_iff {κ : Type*} [DecidableEq κ]
    (cubes : Finset κ) (output : κ → WaveSpaceTime) (Z : WaveSpaceTime) (cube : κ) :
    cube ∈ plateOverlapCubeOutputFiber cubes output Z ↔ cube ∈ cubes ∧ output cube = Z := by
  classical
  simp [plateOverlapCubeOutputFiber]

/-- A finite concrete realization of plate pairs.  The data explicitly give
each cube an angular-pair owner and an output-frequency label, require the
label to lie in that pair's plate sum, and require `(output, owner)` to be
injective on the selected cubes.  Thus each output fiber injects into the
literal plate-overlap fiber.  This is combinatorial only: it does not assert
that the existing half-wave cube packets supply these data. -/
theorem card_plateOverlapCubeOutputFiber_le_plateOverlapMultiplicity_of_pairRealization
    {κ : Type*} [DecidableEq κ]
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat)
    (cubes : Finset κ) (owner : κ → Int × Int) (output : κ → WaveSpaceTime)
    (howner : ∀ cube ∈ cubes, owner cube ∈ angularSeparationPairs indices k)
    (hsum : ∀ cube ∈ cubes,
      output cube ∈ minkowskiSum
        (conicPlate scale gamma angularConstant n (directions (owner cube).1))
        (conicPlate scale gamma angularConstant n' (directions (owner cube).2)))
    (hinj : ∀ ⦃cube cube' : κ⦄, cube ∈ cubes → cube' ∈ cubes →
      output cube = output cube' → owner cube = owner cube' → cube = cube')
    (Z : WaveSpaceTime) :
    (plateOverlapCubeOutputFiber cubes output Z).card ≤
      plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z := by
  classical
  apply Finset.card_le_card_of_injOn owner
  · intro cube hcube
    have hcube' := (mem_plateOverlapCubeOutputFiber_iff cubes output Z cube).mp hcube
    apply (mem_plateOverlapPairs_iff scale gamma angularConstant n n' indices directions k Z
      (owner cube)).mpr
    refine ⟨howner cube hcube'.1, ?_⟩
    simpa only [hcube'.2] using hsum cube hcube'.1
  · intro cube hcube cube' hcube' hownerEq
    have hcubeMem := (mem_plateOverlapCubeOutputFiber_iff cubes output Z cube).mp hcube
    have hcubeMem' := (mem_plateOverlapCubeOutputFiber_iff cubes output Z cube').mp hcube'
    exact hinj hcubeMem.1 hcubeMem'.1 (hcubeMem.2.trans hcubeMem'.2.symm) hownerEq

/-- Combining a finite cube-to-pair realization with `plateOverlap` controls
every concrete output fiber by the same geometric scale loss. -/
theorem exists_card_plateOverlapCubeOutputFiber_le_scaled_of_plateOverlap
    {κ : Type*} [DecidableEq κ]
    (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real)
    (hplate : plateOverlap maxLevel angularConstant sectorRadius spacingLower spacingUpper)
    (gamma : Real) (hgamma : 0 < gamma) (hgammaUpper : gamma < 1 / 10)
    (scale : Real) (hscale : 2 ≤ scale)
    (radialIndices angularIndices : Finset Int) (directions : Int → Euclidean 2)
    (hgeometry : angularSectorGeometry scale angularIndices directions
      sectorRadius spacingLower spacingUpper)
    (n : Int) (hn : n ∈ radialIndices) (n' : Int) (hn' : n' ∈ radialIndices)
    (k : Nat) (hk : k ≤ maxLevel scale)
    (cubes : Finset κ) (owner : κ → Int × Int) (output : κ → WaveSpaceTime)
    (howner : ∀ cube ∈ cubes, owner cube ∈ angularSeparationPairs angularIndices k)
    (hsum : ∀ cube ∈ cubes,
      output cube ∈ minkowskiSum
        (conicPlate scale gamma angularConstant n (directions (owner cube).1))
        (conicPlate scale gamma angularConstant n' (directions (owner cube).2)))
    (hinj : ∀ ⦃cube cube' : κ⦄, cube ∈ cubes → cube' ∈ cubes →
      output cube = output cube' → owner cube = owner cube' → cube = cube')
    (Z : WaveSpaceTime) :
    ∃ overlapExponent : Real, 0 < overlapExponent ∧
      ∃ Cgamma : Real, 0 < Cgamma ∧
        ((plateOverlapCubeOutputFiber cubes output Z).card : Real) ≤
          Cgamma * scale ^ (overlapExponent * gamma) := by
  rcases hplate with ⟨_, overlapExponent, hoverlapExponent, hplate⟩
  rcases hplate gamma hgamma hgammaUpper with ⟨Cgamma, hCgamma, hbound⟩
  refine ⟨overlapExponent, hoverlapExponent, Cgamma, hCgamma, ?_⟩
  have hcard := card_plateOverlapCubeOutputFiber_le_plateOverlapMultiplicity_of_pairRealization
    scale gamma angularConstant n n' angularIndices directions k cubes owner output
    howner hsum hinj Z
  have hcardReal : ((plateOverlapCubeOutputFiber cubes output Z).card : Real) ≤
      (plateOverlapMultiplicity scale gamma angularConstant n n'
        angularIndices directions k Z : Real) := by
    exact_mod_cast hcard
  exact hcardReal.trans
    (hbound scale hscale radialIndices angularIndices directions hgeometry
      n hn n' hn' k hk Z)

/-- The literal thick-plate overlap predicate supplies the expected scaled
finite Cauchy--Schwarz estimate for one output fiber. -/
theorem exists_sq_sum_norm_mul_plateOverlapPairs_le_scaled_of_plateOverlap
    (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real)
    (hplate : plateOverlap maxLevel angularConstant sectorRadius spacingLower spacingUpper)
    (gamma : Real) (hgamma : 0 < gamma) (hgammaUpper : gamma < 1 / 10)
    (scale : Real) (hscale : 2 ≤ scale)
    (radialIndices angularIndices : Finset Int) (directions : Int → Euclidean 2)
    (hgeometry : angularSectorGeometry scale angularIndices directions
      sectorRadius spacingLower spacingUpper)
    (n : Int) (hn : n ∈ radialIndices) (n' : Int) (hn' : n' ∈ radialIndices)
    (k : Nat) (hk : k ≤ maxLevel scale) (Z : WaveSpaceTime)
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    ∃ overlapExponent : Real, 0 < overlapExponent ∧
      ∃ Cgamma : Real, 0 < Cgamma ∧
        (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
            angularIndices directions k Z, ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
          (Cgamma * scale ^ (overlapExponent * gamma)) *
            ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
              angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
  rcases hplate with ⟨_, overlapExponent, hoverlapExponent, hplate⟩
  rcases hplate gamma hgamma hgammaUpper with ⟨Cgamma, hCgamma, hbound⟩
  refine ⟨overlapExponent, hoverlapExponent, Cgamma, hCgamma, ?_⟩
  have hmult :
      (plateOverlapMultiplicity scale gamma angularConstant n n'
        angularIndices directions k Z : Real) ≤
        Cgamma * scale ^ (overlapExponent * gamma) :=
    hbound scale hscale radialIndices angularIndices directions hgeometry
      n hn n' hn' k hk Z
  have henergy : 0 ≤
      ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
          angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
    Finset.sum_nonneg fun pair hpair =>
      mul_nonneg (sq_nonneg _) (sq_nonneg _)
  calc
    (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
        angularIndices directions k Z, ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
        (plateOverlapMultiplicity scale gamma angularConstant n n'
          angularIndices directions k Z : Real) *
          ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
            angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
      sq_sum_norm_mul_plateOverlapPairs_le_plateOverlapMultiplicity_mul_sum_sq
        scale gamma angularConstant n n' angularIndices directions k Z F G z
    _ ≤ (Cgamma * scale ^ (overlapExponent * gamma)) *
          ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
            angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
      mul_le_mul_of_nonneg_right hmult henergy

/-- Summing the preceding literal plate-overlap estimate over a finite output
frequency set gives the finite fourth-power overlap-square-function bound. -/
theorem exists_finitePlateOverlapSquareEnergy_le_scaled_of_plateOverlap
    (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real)
    (hplate : plateOverlap maxLevel angularConstant sectorRadius spacingLower spacingUpper)
    (gamma : Real) (hgamma : 0 < gamma) (hgammaUpper : gamma < 1 / 10)
    (scale : Real) (hscale : 2 ≤ scale)
    (radialIndices angularIndices : Finset Int) (directions : Int → Euclidean 2)
    (hgeometry : angularSectorGeometry scale angularIndices directions
      sectorRadius spacingLower spacingUpper)
    (n : Int) (hn : n ∈ radialIndices) (n' : Int) (hn' : n' ∈ radialIndices)
    (k : Nat) (hk : k ≤ maxLevel scale) (outputs : Finset WaveSpaceTime)
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    ∃ overlapExponent : Real, 0 < overlapExponent ∧
      ∃ Cgamma : Real, 0 < Cgamma ∧
        finitePlateOverlapSquareEnergy scale gamma angularConstant n n'
          angularIndices directions k outputs F G z ≤
          (Cgamma * scale ^ (overlapExponent * gamma)) *
            ∑ Z ∈ outputs,
              ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
                angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
  rcases hplate with ⟨_, overlapExponent, hoverlapExponent, hplate⟩
  rcases hplate gamma hgamma hgammaUpper with ⟨Cgamma, hCgamma, hbound⟩
  refine ⟨overlapExponent, hoverlapExponent, Cgamma, hCgamma, ?_⟩
  unfold finitePlateOverlapSquareEnergy
  calc
    (∑ Z ∈ outputs,
      (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
          angularIndices directions k Z, ‖F pair.1 z * G pair.2 z‖) ^ 2) ≤
        ∑ Z ∈ outputs, (Cgamma * scale ^ (overlapExponent * gamma)) *
          ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
            angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
      apply Finset.sum_le_sum
      intro Z hZ
      have hmult :
          (plateOverlapMultiplicity scale gamma angularConstant n n'
            angularIndices directions k Z : Real) ≤
            Cgamma * scale ^ (overlapExponent * gamma) :=
        hbound scale hscale radialIndices angularIndices directions hgeometry
          n hn n' hn' k hk Z
      have henergy : 0 ≤
          ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
              angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
        Finset.sum_nonneg fun pair hpair =>
          mul_nonneg (sq_nonneg _) (sq_nonneg _)
      calc
        (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
            angularIndices directions k Z, ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
            (plateOverlapMultiplicity scale gamma angularConstant n n'
              angularIndices directions k Z : Real) *
              ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
                angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
          sq_sum_norm_mul_plateOverlapPairs_le_plateOverlapMultiplicity_mul_sum_sq
            scale gamma angularConstant n n' angularIndices directions k Z F G z
        _ ≤ (Cgamma * scale ^ (overlapExponent * gamma)) *
              ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
                angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
          mul_le_mul_of_nonneg_right hmult henergy
    _ = (Cgamma * scale ^ (overlapExponent * gamma)) *
        ∑ Z ∈ outputs,
          ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
            angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
      rw [Finset.mul_sum]

/-- The newly proved angular-sector plate-overlap theorem therefore gives a
literal finite overlap-square-function estimate without a cube or continuum
reconstruction claim. -/
theorem exists_finitePlateOverlapSquareEnergy_le_scaled_of_angularSectorGeometry
    (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real)
    (hangular : 0 < angularConstant)
    (gamma : Real) (hgamma : 0 < gamma) (hgammaUpper : gamma < 1 / 10)
    (scale : Real) (hscale : 2 ≤ scale)
    (radialIndices angularIndices : Finset Int) (directions : Int → Euclidean 2)
