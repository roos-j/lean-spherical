  let T : Int → Int → WaveSpaceTime → Complex :=
    fun n nu => temporalSchwartzAnnularNormalTail
      (B n nu) (u n nu) (vartheta n nu) (beta n nu) (rho n nu)
  have hdecomp : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices, ∀ z,
