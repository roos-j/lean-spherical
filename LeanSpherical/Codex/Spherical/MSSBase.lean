        ∀ xi ∈ Function.support (B n nu : Euclidean 2 → Complex),
        ∀ s ∈ Function.support (beta n nu : Real → Complex),
          |(Real.sqrt scale)⁻¹ * (rho n nu xi + s) - n| ≤ 1) →
