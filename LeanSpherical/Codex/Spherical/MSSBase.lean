theorem fixedTimePhysicalLInfinityEndpoint (C : lpCutoffs 2) (σ : WaveSign)
    (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex)
    {A : Real} (hfbound : ∀ x, ‖f x‖ ≤ A) (x : Euclidean 2) :
    ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤ A * dyadicHalfWaveKernelL1 C σ j t := by
  exact norm_dyadicHalfWave_le_kernelL1 C σ j t f hfbound x

/-- Scale-explicit form of the physical fixed-time endpoint.  This is an
exact reduction of the dyadic kernel bound to the level-zero kernel at time
`2^j t`; it does not assert a numerical oscillatory-kernel estimate. -/
theorem fixedTimePhysicalLInfinityEndpoint_scaled (C : lpCutoffs 2)
    (σ : WaveSign) (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex)
    {A : Real} (hfbound : ∀ x, ‖f x‖ ≤ A) (x : Euclidean 2) :
    ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
      A * dyadicHalfWaveKernelL1 C σ 0 ((2 : Real) ^ j * t) := by
  rw [← dyadicHalfWaveKernelL1_eq_levelZero_scaled]
  exact fixedTimePhysicalLInfinityEndpoint C σ j t f hfbound x

/-- Any explicit upper bound for the physical kernel `L¹` norm yields the
corresponding fixed-time physical `L∞` estimate. -/
theorem fixedTimePhysicalLInfinityEndpoint_of_kernelL1_le (C : lpCutoffs 2)
    (σ : WaveSign) (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex)
    {A B : Real} (hfbound : ∀ x, ‖f x‖ ≤ A)
    (hkernel : dyadicHalfWaveKernelL1 C σ j t ≤ B) (x : Euclidean 2) :
    ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤ A * B := by
  have hA : 0 ≤ A := le_trans (norm_nonneg (f 0)) (hfbound 0)
  calc
    ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤ A * dyadicHalfWaveKernelL1 C σ j t :=
      fixedTimePhysicalLInfinityEndpoint C σ j t f hfbound x
    _ ≤ A * B := mul_le_mul_of_nonneg_left hkernel hA

/-- The compact cutoff half-wave symbol has an integrable physical-space
kernel.  This is the qualitative kernel fact supplied directly by the
Schwartz calculus; obtaining a numerical bound on this norm over a time
range requires a separate oscillatory-kernel estimate. -/
theorem waveKernelL1 (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real) :
    Integrable (dyadicHalfWaveKernel C σ j t : Euclidean 2 → Complex) := by
  exact (dyadicHalfWaveKernel C σ j t).integrable

set_option maxHeartbeats 1000000 in
/-- The inverse Fourier transform turns a frequency Laplacian into
multiplication by `-4 π² ‖x‖²` in the plane. -/
private theorem fourierInv_laplacian_eq_normSq_smul
    (q : SchwartzMap (Euclidean 2) Complex) :
    (𝓕⁻ (Laplacian.laplacian q) : SchwartzMap (Euclidean 2) Complex) =
        ((-(2 * Real.pi) ^ 2 : Real) : Complex) •
          (SchwartzMap.smulLeftCLM Complex
            (fun x : Euclidean 2 => ‖x‖ ^ 2)
            (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) := by
  classical
  let b := stdOrthonormalBasis Real (Euclidean 2)
  rw [SchwartzMap.laplacian_eq_sum b q]
  rw [fourierInv_sum]
  ext x
  change (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean 2) Complex)
      (Euclidean 2) Complex)
      (∑ i, 𝓕⁻ (LineDeriv.lineDerivOp (b i)
        (LineDeriv.lineDerivOp (b i) q))) x = _
  rw [map_sum, Finset.sum_apply]
  simp_rw [SchwartzMap.fourierInv_lineDerivOp_eq]
  have hsmul (a : Complex) (f : SchwartzMap (Euclidean 2) Complex) :
      (a • f) x = a * f x := by
    simpa [smul_eq_mul] using (smul_apply f a x)
  have hmul_inner (i : Fin (Module.finrank Real (Euclidean 2)))
      (f : SchwartzMap (Euclidean 2) Complex) :
      (SchwartzMap.smulLeftCLM Complex (fun y => inner Real y (b i)) f) x =
        ((inner Real x (b i) : Real) : Complex) * f x := by
    simpa [smul_eq_mul] using
      congrFun (SchwartzMap.smulLeftCLM_apply
        (show (fun y : Euclidean 2 => inner Real y (b i)).HasTemperateGrowth by fun_prop) f) x
  have hmul_norm (f : SchwartzMap (Euclidean 2) Complex) :
      (SchwartzMap.smulLeftCLM Complex
        (fun y : Euclidean 2 => ‖y‖ ^ 2) f) x =
        ((‖x‖ ^ 2 : Real) : Complex) * f x := by
    simpa [smul_eq_mul] using congrFun (SchwartzMap.smulLeftCLM_apply
      (show (fun y : Euclidean 2 => ‖y‖ ^ 2).HasTemperateGrowth by fun_prop) f) x
  change (∑ i, ((-(2 * ↑Real.pi * Complex.I) : Complex) •
      (SchwartzMap.smulLeftCLM Complex (fun y => inner Real y (b i))
        ((-(2 * ↑Real.pi * Complex.I) : Complex) •
          (SchwartzMap.smulLeftCLM Complex (fun y => inner Real y (b i))
            (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)))) :
        SchwartzMap (Euclidean 2) Complex) x) =
      (((-(2 * Real.pi) ^ 2 : Real) : Complex) •
        (SchwartzMap.smulLeftCLM Complex
          (fun y : Euclidean 2 => ‖y‖ ^ 2)
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex))) x
  simp_rw [hsmul]
  simp_rw [hmul_inner, hmul_norm]
  simp_rw [hsmul]
  simp_rw [hmul_inner]
  have hc : (-(2 * ↑Real.pi * Complex.I) : Complex) *
      (-(2 * ↑Real.pi * Complex.I) : Complex) =
      ((-(2 * Real.pi) ^ 2 : Real) : Complex) := by
    push_cast
    calc
      -(2 * ↑Real.pi * Complex.I) * -(2 * ↑Real.pi * Complex.I) =
          (2 * (Real.pi : Complex)) ^ 2 * (Complex.I * Complex.I) := by ring
      _ = -(2 * (Real.pi : Complex)) ^ 2 := by rw [Complex.I_mul_I]; ring
      _ = -(2 * ↑Real.pi) ^ 2 := by ring
  calc
    (∑ i, (-(2 * ↑Real.pi * Complex.I) : Complex) *
        (((inner Real x (b i) : Real) : Complex) *
          ((-(2 * ↑Real.pi * Complex.I) : Complex) *
            (((inner Real x (b i) : Real) : Complex) *
              (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x)))) =
        ∑ i, ((-(2 * Real.pi) ^ 2 : Real) : Complex) *
          ((inner Real x (b i) : Real) : Complex) ^ 2 *
            (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x := by
      apply Finset.sum_congr rfl
      intro i hi
      calc
        _ = ((-(2 * ↑Real.pi * Complex.I) : Complex) *
            (-(2 * ↑Real.pi * Complex.I) : Complex)) *
            ((inner Real x (b i) : Real) : Complex) ^ 2 *
              (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x := by ring
        _ = _ := by rw [hc]
    _ = ((-(2 * Real.pi) ^ 2 : Real) : Complex) *
        (∑ i, ((inner Real x (b i) : Real) : Complex) ^ 2) *
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x := by
      rw [Finset.mul_sum, Finset.sum_mul]
    _ = ((-(2 * Real.pi) ^ 2 : Real) : Complex) *
        (((‖x‖ ^ 2 : Real) : Complex) *
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x) := by
      rw [show ∑ i, ((inner Real x (b i) : Real) : Complex) ^ 2 =
        ((‖x‖ ^ 2 : Real) : Complex) by
          norm_cast
          exact b.sum_sq_inner_left x]
      ring

/-- The exact Fourier identity behind the quadratic distance-to-cone weight.
The phase-specific argument only has to bound the cancelled frequency symbol
on the left. -/
theorem fourierInv_cancelled_laplacian_eq_cone_quadratic
    (q : SchwartzMap (Euclidean 2) Complex) (s : Real) :
    (𝓕⁻ (-Laplacian.laplacian q -
        (((2 * Real.pi * s) ^ 2 : Real) : Complex) • q) :
        SchwartzMap (Euclidean 2) Complex) =
      (((2 * Real.pi) ^ 2 : Real) : Complex) •
        (SchwartzMap.smulLeftCLM Complex
          (fun x : Euclidean 2 => ‖x‖ ^ 2 - s ^ 2)
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) := by
  rw [sub_eq_add_neg, fourierInv_add, fourierInv_neg, fourierInv_neg,
    fourierInv_smul, fourierInv_laplacian_eq_normSq_smul]
  ext x
  have hsmul (a : Complex) (f : SchwartzMap (Euclidean 2) Complex) :
      (a • f) x = a * f x := by
    simpa [smul_eq_mul] using (smul_apply f a x)
  have hmul_norm (f : SchwartzMap (Euclidean 2) Complex) :
      (SchwartzMap.smulLeftCLM Complex
        (fun y : Euclidean 2 => ‖y‖ ^ 2) f) x =
        ((‖x‖ ^ 2 : Real) : Complex) * f x := by
    simpa [smul_eq_mul] using congrFun (SchwartzMap.smulLeftCLM_apply
      (show (fun y : Euclidean 2 => ‖y‖ ^ 2).HasTemperateGrowth by fun_prop) f) x
  have hmul_cone (f : SchwartzMap (Euclidean 2) Complex) :
      (SchwartzMap.smulLeftCLM Complex
        (fun y : Euclidean 2 => ‖y‖ ^ 2 - s ^ 2) f) x =
        ((‖x‖ ^ 2 - s ^ 2 : Real) : Complex) * f x := by
    simpa [smul_eq_mul] using congrFun (SchwartzMap.smulLeftCLM_apply
      (show (fun y : Euclidean 2 => ‖y‖ ^ 2 - s ^ 2).HasTemperateGrowth by fun_prop) f) x
  change (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean 2) Complex)
      (Euclidean 2) Complex)
      (-((( -(2 * Real.pi) ^ 2 : Real) : Complex) •
          (SchwartzMap.smulLeftCLM Complex (fun y : Euclidean 2 => ‖y‖ ^ 2)
            (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex))) +
        -((((2 * Real.pi * s) ^ 2 : Real) : Complex) •
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex))) x = _
  rw [map_add, map_neg, map_neg]
  simp only [Pi.add_apply, Pi.neg_apply]
  change
    -(((-(2 * Real.pi) ^ 2 : Real) : Complex) •
        (SchwartzMap.smulLeftCLM Complex (fun y : Euclidean 2 => ‖y‖ ^ 2)
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex))) x +
      -((((2 * Real.pi * s) ^ 2 : Real) : Complex) •
        (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) x =
      (((2 * Real.pi) ^ 2 : Real) : Complex) *
        (SchwartzMap.smulLeftCLM Complex
          (fun y : Euclidean 2 => ‖y‖ ^ 2 - s ^ 2)
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) x
  rw [hsmul, hsmul]
  rw [hmul_norm, hmul_cone]
  push_cast
  ring

/-- The quadratic weight measuring distance to the planar wave cone at time
`s`.  Dividing the radial discrepancy `‖x‖² - s²` by `s` makes the resulting
reciprocal weight have mass of order `s`. -/
def coneWeight (s : Real) (x : Euclidean 2) : Real :=
  1 + ((‖x‖ ^ 2 - s ^ 2) / s) ^ 2

/-- The reciprocal of the planar wave-cone weight. -/
def coneReciprocal (s : Real) (x : Euclidean 2) : Real :=
  (coneWeight s x)⁻¹

/-- The planar cone weight is strictly positive, including at `s = 0`. -/
theorem coneWeight_pos (s : Real) (x : Euclidean 2) : 0 < coneWeight s x := by
  unfold coneWeight
  positivity

private theorem integrable_radius_coneReciprocal (s : Real) (hs : 0 < s) :
    IntegrableOn (fun r : Real => r * (1 + ((r ^ 2 - s ^ 2) / s) ^ 2)⁻¹) (Ioi 0) := by
  let g : Real → Real := fun u => (1 + u ^ 2)⁻¹
  let q : Real → Real := fun u => g ((u - s ^ 2) / s)
  have hg : Integrable g := by
    simpa only [g] using integrable_inv_one_add_sq
  have hq : Integrable q := by
    have hshift : Integrable (fun u : Real => g (u - s)) := hg.comp_sub_right s
    have hscale : Integrable (fun u : Real => g ((s : Real)⁻¹ * u - s)) := by
      exact (MeasureTheory.integrable_comp_mul_left_iff
        (fun u : Real => g (u - s)) (inv_ne_zero hs.ne')).mpr hshift
    refine hscale.congr ?_
    filter_upwards with u
    dsimp only [q]
    congr 1
    field_simp [hs.ne']
  have hqIoi : IntegrableOn q (Ioi 0) := hq.integrableOn
  have hqSquareIoi : IntegrableOn (fun r : Real => r * q (r ^ 2)) (Ioi 0) := by
    have h := (integrableOn_Ioi_comp_rpow_iff' q (by norm_num : (2 : Real) ≠ 0)).mpr hqIoi
    norm_num at h
    simpa only [smul_eq_mul, one_mul] using h
  refine hqSquareIoi.congr ?_
  filter_upwards with r
  rfl

/-- The radial integral of the reciprocal wave-cone weight is an elementary
one-dimensional Cauchy profile. -/
theorem integral_radius_coneReciprocal (s : Real) (hs : 0 < s) :
    (∫ r : Real in Ioi 0, r * (1 + ((r ^ 2 - s ^ 2) / s) ^ 2)⁻¹) =
      (s / 2) * (∫ u : Real in Ioi (-s), (1 + u ^ 2)⁻¹) := by
  let g : Real → Real := fun u => (1 + u ^ 2)⁻¹
  let f : Real → Real := fun r => (r ^ 2 - s ^ 2) / s
  let f' : Real → Real := fun r => (2 * r) / s
  let q : Real → Real := fun u => g ((u - s ^ 2) / s)
  have hg : Integrable g := by
    simpa only [g] using integrable_inv_one_add_sq
  have hq : Integrable q := by
    have hshift : Integrable (fun u : Real => g (u - s)) := hg.comp_sub_right s
    have hscale : Integrable (fun u : Real => g ((s : Real)⁻¹ * u - s)) := by
      exact (MeasureTheory.integrable_comp_mul_left_iff
        (fun u : Real => g (u - s)) (inv_ne_zero hs.ne')).mpr hshift
    refine hscale.congr ?_
    filter_upwards with u
    dsimp only [q]
    congr 1
    field_simp [hs.ne']
  have hqIoi : IntegrableOn q (Ioi 0) := hq.integrableOn
  have hqSquareIoi : IntegrableOn (fun r : Real => r * q (r ^ 2)) (Ioi 0) := by
    have h := (integrableOn_Ioi_comp_rpow_iff' q (by norm_num : (2 : Real) ≠ 0)).mpr hqIoi
    norm_num at h
    simpa only [smul_eq_mul, one_mul] using h
  have hqSquareIci : IntegrableOn (fun r : Real => r * q (r ^ 2)) (Ici 0) :=
    (integrableOn_Ici_iff_integrableOn_Ioi).mpr hqSquareIoi
  have hcomp : IntegrableOn (fun r : Real => (g ∘ f) r * f' r) (Ici 0) := by
    have h := hqSquareIci.const_mul (2 / s)
    refine h.congr ?_
    filter_upwards with r
    dsimp only [f, f', q, Function.comp_apply]
    field_simp [hs.ne']
  have hfcont : Continuous f := by
    dsimp only [f]
    fun_prop
  have hftend : Tendsto f atTop atTop := by
    apply tendsto_atTop.2
    intro b
    filter_upwards [eventually_ge_atTop (max 1 (s * b + s ^ 2))] with r hr
    have hrone : 1 ≤ r := (le_max_left _ _).trans hr
    have hrlin : r ≤ r ^ 2 := by nlinarith
    have hbound : s * b + s ^ 2 ≤ r ^ 2 :=
      (le_max_right _ _).trans (hr.trans hrlin)
    dsimp only [f]
    apply (le_div_iff₀ hs).mpr
    nlinarith
  have hfderiv : ∀ r ∈ Ioi (0 : Real), HasDerivWithinAt f (f' r) (Ioi r) r := by
    intro r hr
    have hpow : HasDerivAt (fun x : Real => x ^ 2) (2 * r) r := by
      simpa using! (hasDerivAt_id r).pow 2
    simpa only [f, f'] using ((hpow.sub_const (s ^ 2)).div_const s).hasDerivWithinAt
  have hgcont : Continuous g := by
    dsimp only [g]
    apply Continuous.inv₀
    · fun_prop
    · intro u
      positivity
  have hchange := integral_comp_mul_deriv_Ioi
    (f := f) (f' := f') (g := g) (a := (0 : Real)) hfcont.continuousOn hftend hfderiv
      hgcont.continuousOn hg.integrableOn hcomp
  have hfactor : (fun r : Real => r * (1 + ((r ^ 2 - s ^ 2) / s) ^ 2)⁻¹) =
      fun r => (s / 2) * ((g ∘ f) r * f' r) := by
    funext r
    dsimp only [f, f', g, Function.comp_apply]
    field_simp [hs.ne']
  have hfzero : f 0 = -s := by
    dsimp only [f]
    field_simp [hs.ne']
    ring
  rw [hfactor, integral_const_mul, hchange, hfzero]

/-- The reciprocal planar wave-cone weight is integrable for positive time. -/
theorem integrable_coneReciprocal (s : Real) (hs : 0 < s) :
    Integrable (fun x : Euclidean 2 => coneReciprocal s x) := by
  let w : Real → Real := fun r => (1 + ((r ^ 2 - s ^ 2) / s) ^ 2)⁻¹
  have hrewrite : (fun x : Euclidean 2 => coneReciprocal s x) =
      fun x => w ‖x‖ := rfl
  rw [hrewrite]
  rw [integrable_fun_norm_addHaar (E := Euclidean 2)
    (μ := (volume : Measure (Euclidean 2)))]
  norm_num [finrank_euclideanSpace_fin, smul_eq_mul]
  exact integrable_radius_coneReciprocal s hs

/-- The total mass of the reciprocal planar wave-cone weight is `O(s)`. -/
theorem integral_coneReciprocal_le (s : Real) (hs : 0 < s) :
    (∫ x : Euclidean 2, coneReciprocal s x) ≤
      (volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s := by
  have hrad := integral_fun_norm_addHaar (E := Euclidean 2)
    (μ := (volume : Measure (Euclidean 2)))
    (fun r : Real => (1 + ((r ^ 2 - s ^ 2) / s) ^ 2)⁻¹)
  have hrewrite : (fun x : Euclidean 2 => coneReciprocal s x) =
      fun x => (1 + ((‖x‖ ^ 2 - s ^ 2) / s) ^ 2)⁻¹ := rfl
  rw [hrewrite]
  have hmeasure : 0 ≤ volume.real (Metric.ball (0 : Euclidean 2) 1) :=
    MeasureTheory.measureReal_nonneg
  have hpi : 0 ≤ Real.pi := Real.pi_pos.le
  have hI : (∫ u : Real in Ioi (-s), (1 + u ^ 2)⁻¹) ≤ Real.pi := by
    rw [integral_Ioi_inv_one_add_sq, Real.arctan_neg]
    linarith [Real.arctan_lt_pi_div_two s]
  have hradius := integral_radius_coneReciprocal s hs
  norm_num [finrank_euclideanSpace_fin, smul_eq_mul] at hrad
  rw [hradius] at hrad
  rw [hrad]
  calc
    2 * (volume.real (Metric.ball (0 : Euclidean 2) 1) *
        ((s / 2) * ∫ u : Real in Ioi (-s), (1 + u ^ 2)⁻¹)) ≤
      2 * (volume.real (Metric.ball (0 : Euclidean 2) 1) *
        ((s / 2) * Real.pi)) := by
      gcongr
    _ = (volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s := by
      ring

private theorem weighted_cauchy_schwarz
    (K : Euclidean 2 → Complex) (w : Euclidean 2 → Real)
    (hwpos : ∀ x, 0 < w x)
    (henergy : Integrable (fun x => w x * ‖K x‖ ^ 2))
    (hinv : Integrable (fun x => (w x)⁻¹)) :
    (∫ x : Euclidean 2, ‖K x‖) ≤
      (∫ x : Euclidean 2, w x * ‖K x‖ ^ 2) ^ ((2 : Real)⁻¹) *
        (∫ x : Euclidean 2, (w x)⁻¹) ^ ((2 : Real)⁻¹) := by
  let F : Euclidean 2 → Real := fun x => Real.sqrt (w x * ‖K x‖ ^ 2)
  let G : Euclidean 2 → Real := fun x => Real.sqrt ((w x)⁻¹)
  have hFmeas : AEStronglyMeasurable F volume := by
    exact Real.continuous_sqrt.comp_aestronglyMeasurable henergy.aestronglyMeasurable
  have hGmeas : AEStronglyMeasurable G volume := by
    exact Real.continuous_sqrt.comp_aestronglyMeasurable hinv.aestronglyMeasurable
  have hFsq : Integrable (fun x => F x ^ 2) := by
    refine henergy.congr ?_
    filter_upwards with x
    dsimp only [F]
    exact (Real.sq_sqrt (mul_nonneg (hwpos x).le (sq_nonneg _))).symm
  have hGsq : Integrable (fun x => G x ^ 2) := by
    refine hinv.congr ?_
    filter_upwards with x
    dsimp only [G]
    exact (Real.sq_sqrt (inv_nonneg.mpr (hwpos x).le)).symm
  have hFmem : MemLp F 2 volume :=
    (memLp_two_iff_integrable_sq hFmeas).mpr hFsq
  have hGmem : MemLp G 2 volume :=
    (memLp_two_iff_integrable_sq hGmeas).mpr hGsq
  have hFmem' : MemLp F (ENNReal.ofReal 2) volume := by
    norm_num
    exact hFmem
  have hGmem' : MemLp G (ENNReal.ofReal 2) volume := by
    norm_num
    exact hGmem
  have hholder := integral_mul_le_Lp_mul_Lq_of_nonneg (f := F) (g := G)
    Real.HolderConjugate.two_two
    (Eventually.of_forall fun x => Real.sqrt_nonneg _)
    (Eventually.of_forall fun x => Real.sqrt_nonneg _) hFmem' hGmem'
  have hleft : (fun x : Euclidean 2 => ‖K x‖) = fun x => F x * G x := by
    funext x
    dsimp only [F, G]
    have hroot : Real.sqrt (w x) ≠ 0 := ne_of_gt (Real.sqrt_pos.2 (hwpos x))
    symm
    calc
      Real.sqrt (w x * ‖K x‖ ^ 2) * Real.sqrt ((w x)⁻¹) =
          (Real.sqrt (w x) * Real.sqrt (‖K x‖ ^ 2)) * (Real.sqrt (w x))⁻¹ := by
        rw [Real.sqrt_mul (hwpos x).le, Real.sqrt_inv]
      _ = ‖K x‖ := by
        rw [Real.sqrt_sq (norm_nonneg _)]
        field_simp
  have hFint : (∫ x : Euclidean 2, F x ^ 2) =
      ∫ x : Euclidean 2, w x * ‖K x‖ ^ 2 := by
    apply integral_congr_ae
    filter_upwards with x
    dsimp only [F]
    exact Real.sq_sqrt (mul_nonneg (hwpos x).le (sq_nonneg _))
  have hGint : (∫ x : Euclidean 2, G x ^ 2) =
      ∫ x : Euclidean 2, (w x)⁻¹ := by
    apply integral_congr_ae
    filter_upwards with x
    dsimp only [G]
    exact Real.sq_sqrt (inv_nonneg.mpr (hwpos x).le)
  calc
    (∫ x : Euclidean 2, ‖K x‖) = ∫ x : Euclidean 2, F x * G x := by rw [hleft]
    _ ≤ (∫ x : Euclidean 2, F x ^ (2 : Real)) ^ (1 / (2 : Real)) *
        (∫ x : Euclidean 2, G x ^ (2 : Real)) ^ (1 / (2 : Real)) := hholder
    _ = (∫ x : Euclidean 2, w x * ‖K x‖ ^ 2) ^ ((2 : Real)⁻¹) *
        (∫ x : Euclidean 2, (w x)⁻¹) ^ ((2 : Real)⁻¹) := by
      rw [show (fun x : Euclidean 2 => F x ^ (2 : Real)) = fun x => F x ^ 2 by
        funext x
        rw [Real.rpow_two],
        show (fun x : Euclidean 2 => G x ^ (2 : Real)) = fun x => G x ^ 2 by
        funext x
        rw [Real.rpow_two], hFint, hGint]
      ring_nf

/-- A conditional weighted-`L²` estimate implies the planar wave-kernel
`L¹` bound needed for the sharp half-wave endpoint.  The only hypothesis is
integrability of the cone-weighted energy; the Fourier-side cancellation is
supplied separately. -/
theorem integral_norm_le_coneWeightedEnergy
    (K : Euclidean 2 → Complex) (s : Real) (hs : 0 < s)
    (henergy : Integrable (fun x => coneWeight s x * ‖K x‖ ^ 2)) :
    (∫ x : Euclidean 2, ‖K x‖) ≤
      (∫ x : Euclidean 2, coneWeight s x * ‖K x‖ ^ 2) ^ ((2 : Real)⁻¹) *
        ((volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s) ^ ((2 : Real)⁻¹) := by
  have hinv : Integrable (fun x : Euclidean 2 => (coneWeight s x)⁻¹) := by
    simpa only [coneReciprocal] using integrable_coneReciprocal s hs
  have hcs := weighted_cauchy_schwarz K (coneWeight s) (coneWeight_pos s) henergy hinv
  calc
    (∫ x : Euclidean 2, ‖K x‖) ≤
        (∫ x : Euclidean 2, coneWeight s x * ‖K x‖ ^ 2) ^ ((2 : Real)⁻¹) *
          (∫ x : Euclidean 2, (coneWeight s x)⁻¹) ^ ((2 : Real)⁻¹) := hcs
    _ ≤ (∫ x : Euclidean 2, coneWeight s x * ‖K x‖ ^ 2) ^ ((2 : Real)⁻¹) *
        ((volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s) ^ ((2 : Real)⁻¹) := by
      apply mul_le_mul_of_nonneg_left
      · apply Real.rpow_le_rpow
        · exact integral_nonneg fun x => inv_nonneg.mpr (coneWeight_pos s x).le
        · simpa only [coneReciprocal] using integral_coneReciprocal_le s hs
        · positivity
      · exact Real.rpow_nonneg
          (integral_nonneg fun x => mul_nonneg (coneWeight_pos s x).le (sq_nonneg _)) _

/-- The frequency-space wave operator whose leading `s²` contribution is
cancelled by the half-wave phase. -/
def cancelledWaveLaplacian
    (q : SchwartzMap (Euclidean 2) Complex) (s : Real) :
    SchwartzMap (Euclidean 2) Complex :=
  -Laplacian.laplacian q - (((2 * Real.pi * s) ^ 2 : Real) : Complex) • q

private def radialPhase (a : Real) : Euclidean 2 → Complex :=
  fun x => Complex.exp (((a * ‖x‖ : Real) : Complex) * Complex.I)

private def radialPhaseCoeff (a : Real) (x v : Euclidean 2) : Complex :=
  (((a * ‖x‖⁻¹ * inner Real x v : Real) : Complex) * Complex.I)

private def radialLaplacianCoeff (a : Real) (x : Euclidean 2) : Complex :=
  (((a * ‖x‖⁻¹ : Real) : Complex) * Complex.I)

private theorem radial_phase_laplacian_mul_cancelled
    (chi : Euclidean 2 → Complex) (a b : Real) (x : Euclidean 2)
    (hx : x ≠ 0) (hchi : ContDiffAt Real 2 chi x) (hsq : a ^ 2 = b ^ 2) :
    -Laplacian.laplacian (fun y => radialPhase a y * chi y) x -
        ((b ^ 2 : Real) : Complex) * (radialPhase a x * chi x) =
      -radialPhase a x *
        (Laplacian.laplacian chi x +
          (∑ i, (radialPhaseCoeff a x (stdOrthonormalBasis Real (Euclidean 2) i) *
                fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) +
            fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) *
              radialPhaseCoeff a x (stdOrthonormalBasis Real (Euclidean 2) i))) +
          radialLaplacianCoeff a x * chi x) := by
  have hphase : ContDiffAt Real 2 (radialPhase a) x := by
    have hnorm : ContDiffAt Real 2 (fun y : Euclidean 2 => ‖y‖) x :=
      contDiffAt_norm Real hx
    have hreal : ContDiffAt Real 2 (fun y : Euclidean 2 => a * ‖y‖) x := by
      fun_prop
    have hcomplex : ContDiffAt Real 2
        (fun y : Euclidean 2 => ((a * ‖y‖ : Real) : Complex)) x := by
      exact Complex.ofRealCLM.contDiff.contDiffAt.comp x hreal
    exact (hcomplex.mul contDiffAt_const).cexp
  rw [laplacian_mul_at (radialPhase a) chi hphase hchi]
  rw [show Laplacian.laplacian (radialPhase a) x =
      radialPhase a x * (-((a ^ 2 : Real) : Complex) +
        radialLaplacianCoeff a x) by
    change Laplacian.laplacian (fun y : Euclidean 2 =>
      Complex.exp (((a * ‖y‖ : Real) : Complex) * Complex.I)) x =
        Complex.exp (((a * ‖x‖ : Real) : Complex) * Complex.I) *
          (-((a ^ 2 : Real) : Complex) +
            (((a * ‖x‖⁻¹ : Real) : Complex) * Complex.I))
    exact laplacian_radial_phase_eq a x hx]
  simp_rw [show ∀ i,
      fderiv Real (radialPhase a) x (stdOrthonormalBasis Real (Euclidean 2) i) =
        radialPhase a x *
          radialPhaseCoeff a x (stdOrthonormalBasis Real (Euclidean 2) i) by
      intro i
      change fderiv Real (fun y : Euclidean 2 =>
        Complex.exp (((a * ‖y‖ : Real) : Complex) * Complex.I)) x
          (stdOrthonormalBasis Real (Euclidean 2) i) =
        Complex.exp (((a * ‖x‖ : Real) : Complex) * Complex.I) *
          (((a * ‖x‖⁻¹ *
            inner Real x (stdOrthonormalBasis Real (Euclidean 2) i) : Real) : Complex) *
              Complex.I)
      exact fderiv_radial_phase_apply a x
        (stdOrthonormalBasis Real (Euclidean 2) i) hx]
  have hcross : ∀ i,
      radialPhase a x * radialPhaseCoeff a x (stdOrthonormalBasis Real (Euclidean 2) i) *
          fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) +
        fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) *
          (radialPhase a x * radialPhaseCoeff a x (stdOrthonormalBasis Real (Euclidean 2) i)) =
        radialPhase a x *
          (radialPhaseCoeff a x (stdOrthonormalBasis Real (Euclidean 2) i) *
            fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) +
          fderiv Real chi x (stdOrthonormalBasis Real (Euclidean 2) i) *
            radialPhaseCoeff a x (stdOrthonormalBasis Real (Euclidean 2) i)) := by
    intro i
    ring
  simp_rw [hcross]
  rw [← Finset.mul_sum]
  have hsqC : (a : Complex) ^ 2 = (b : Complex) ^ 2 := by
    exact_mod_cast hsq
  push_cast
  rw [hsqC]
  ring

private def halfWavePhaseParameter (σ : WaveSign) (s : Real) : Real :=
  σ.toReal * (2 * Real.pi) * s

private def levelZeroCutoff (C : lpCutoffs 2) : Euclidean 2 → Complex :=
  dyadicBandpassMultiplier C.cutoff 0

private def levelZeroCutoffLaplacian (C : lpCutoffs 2) : Euclidean 2 → Complex :=
  Laplacian.laplacian (levelZeroCutoff C)

private def levelZeroRadialCutoffTerm (C : lpCutoffs 2) (σ : WaveSign) :
    Euclidean 2 → Complex := fun x =>
  (∑ i, (radialPhaseCoeff (halfWavePhaseParameter σ 1) x
        (stdOrthonormalBasis Real (Euclidean 2) i) *
      fderiv Real (levelZeroCutoff C) x
        (stdOrthonormalBasis Real (Euclidean 2) i) +
    fderiv Real (levelZeroCutoff C) x
        (stdOrthonormalBasis Real (Euclidean 2) i) *
      radialPhaseCoeff (halfWavePhaseParameter σ 1) x
        (stdOrthonormalBasis Real (Euclidean 2) i))) +
    radialLaplacianCoeff (halfWavePhaseParameter σ 1) x * levelZeroCutoff C x

private theorem halfWaveMultiplier_eq_radialPhase (σ : WaveSign) (s : Real) :
    halfWaveMultiplier σ s = radialPhase (halfWavePhaseParameter σ s) := by
  rfl

private theorem levelZeroCutoff_contDiffAt (C : lpCutoffs 2) (x : Euclidean 2) :
    ContDiffAt Real 2 (levelZeroCutoff C) x := by
  exact (dyadicBandpassMultiplier C.cutoff 0).smooth 2 |>.contDiffAt

private theorem phase_parameter_sq (σ : WaveSign) (s : Real) :
    (halfWavePhaseParameter σ s) ^ 2 = (2 * Real.pi * s) ^ 2 := by
  cases σ <;> simp [halfWavePhaseParameter, WaveSign.toReal] <;> ring

private theorem radialPhaseCoeff_scale (σ : WaveSign) (s : Real) (x v : Euclidean 2) :
    radialPhaseCoeff (halfWavePhaseParameter σ s) x v =
      s * radialPhaseCoeff (halfWavePhaseParameter σ 1) x v := by
  simp only [radialPhaseCoeff, halfWavePhaseParameter]
  push_cast
  ring

private theorem radialLaplacianCoeff_scale (σ : WaveSign) (s : Real) (x : Euclidean 2) :
    radialLaplacianCoeff (halfWavePhaseParameter σ s) x =
      s * radialLaplacianCoeff (halfWavePhaseParameter σ 1) x := by
  simp only [radialLaplacianCoeff, halfWavePhaseParameter]
  push_cast
  ring

private theorem cancelled_levelZero_phase_formula
    (C : lpCutoffs 2) (σ : WaveSign) (s : Real) (x : Euclidean 2) (hx : x ≠ 0) :
    cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s x =
      -halfWaveMultiplier σ s x *
        (levelZeroCutoffLaplacian C x + s * levelZeroRadialCutoffTerm C σ x) := by
  have hfun : (dyadicHalfWaveSchwartzSymbol C σ 0 s : Euclidean 2 → Complex) =
      fun y => radialPhase (halfWavePhaseParameter σ s) y * levelZeroCutoff C y := by
    funext y
    rw [dyadicHalfWaveSchwartzSymbol_apply]
    rfl
  rw [cancelledWaveLaplacian]
  simp only [SchwartzMap.sub_apply, neg_apply, SchwartzMap.smul_apply,
    SchwartzMap.laplacian_apply, smul_eq_mul]
  change -Laplacian.laplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s :
      Euclidean 2 → Complex) x -
      (((2 * Real.pi * s) ^ 2 : Real) : Complex) *
        dyadicHalfWaveSchwartzSymbol C σ 0 s x = _
  rw [hfun]
  rw [radial_phase_laplacian_mul_cancelled (levelZeroCutoff C)
    (halfWavePhaseParameter σ s) (2 * Real.pi * s) x hx
    (levelZeroCutoff_contDiffAt C x) (phase_parameter_sq σ s)]
  rw [← halfWaveMultiplier_eq_radialPhase]
  simp only [levelZeroCutoffLaplacian, levelZeroRadialCutoffTerm]
  have hsum : (∑ i, (radialPhaseCoeff (halfWavePhaseParameter σ s) x
          (stdOrthonormalBasis Real (Euclidean 2) i) *
        fderiv Real (levelZeroCutoff C) x
          (stdOrthonormalBasis Real (Euclidean 2) i) +
      fderiv Real (levelZeroCutoff C) x
          (stdOrthonormalBasis Real (Euclidean 2) i) *
        radialPhaseCoeff (halfWavePhaseParameter σ s) x
          (stdOrthonormalBasis Real (Euclidean 2) i))) =
        s * (∑ i,
          (radialPhaseCoeff (halfWavePhaseParameter σ 1) x
            (stdOrthonormalBasis Real (Euclidean 2) i) *
            fderiv Real (levelZeroCutoff C) x
              (stdOrthonormalBasis Real (Euclidean 2) i) +
          fderiv Real (levelZeroCutoff C) x
            (stdOrthonormalBasis Real (Euclidean 2) i) *
            radialPhaseCoeff (halfWavePhaseParameter σ 1) x
              (stdOrthonormalBasis Real (Euclidean 2) i))) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    rw [radialPhaseCoeff_scale]
    ring
  have hradial : radialLaplacianCoeff (halfWavePhaseParameter σ s) x *
      levelZeroCutoff C x =
      s * (radialLaplacianCoeff (halfWavePhaseParameter σ 1) x *
        levelZeroCutoff C x) := by
    rw [radialLaplacianCoeff_scale]
    ring
  rw [hsum, hradial]
  ring

private theorem halfWaveMultiplier_neg_one_mul_one
    (σ : WaveSign) (x : Euclidean 2) :
    halfWaveMultiplier σ (-1) x * halfWaveMultiplier σ 1 x = 1 := by
  rw [← halfWaveMultiplier_add]
  norm_num [halfWaveMultiplier_zero]

private theorem cancelled_levelZero_phase_affine
    (C : lpCutoffs 2) (σ : WaveSign) (s : Real) (x : Euclidean 2) (hx : x ≠ 0) :
    cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s x =
      halfWaveMultiplier σ s x *
        (cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 0) 0 x +
          s * (halfWaveMultiplier σ (-1) x *
              cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 1) 1 x -
            cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 0) 0 x)) := by
  rw [cancelled_levelZero_phase_formula C σ s x hx,
    cancelled_levelZero_phase_formula C σ 0 x hx,
    cancelled_levelZero_phase_formula C σ 1 x hx]
  rw [halfWaveMultiplier_zero]
  have hinv : halfWaveMultiplier σ (-1) x * halfWaveMultiplier σ 1 x = 1 :=
    halfWaveMultiplier_neg_one_mul_one σ x
  have hdephase : halfWaveMultiplier σ (-1) x *
      (halfWaveMultiplier σ 1 x *
        (levelZeroCutoffLaplacian C x + levelZeroRadialCutoffTerm C σ x)) =
      levelZeroCutoffLaplacian C x + levelZeroRadialCutoffTerm C σ x := by
    calc
      _ = (halfWaveMultiplier σ (-1) x * halfWaveMultiplier σ 1 x) *
          (levelZeroCutoffLaplacian C x + levelZeroRadialCutoffTerm C σ x) := by ring
      _ = (1 : Complex) *
          (levelZeroCutoffLaplacian C x + levelZeroRadialCutoffTerm C σ x) := by rw [hinv]
      _ = _ := by ring
  norm_num
  rw [hdephase]
  ring

private theorem integral_norm_sq_phase_affine_le
    (r r0 r1 A p : Euclidean 2 → Complex) (s : Real)
    (hs : 1 ≤ s) (hp : ∀ x, ‖p x‖ = 1)
    (hidentity : ∀ᵐ x ∂volume, r x = p x * (r0 x + s * A x))
    (hA : ∀ x, ‖A x‖ ≤ ‖r1 x‖ + ‖r0 x‖)
    (hr : Integrable (fun x => ‖r x‖ ^ 2))
    (hr0 : Integrable (fun x => ‖r0 x‖ ^ 2))
    (hr1 : Integrable (fun x => ‖r1 x‖ ^ 2)) :
    (∫ x : Euclidean 2, ‖r x‖ ^ 2) ≤
      s ^ 2 * (8 * (∫ x : Euclidean 2, ‖r0 x‖ ^ 2) +
        2 * (∫ x : Euclidean 2, ‖r1 x‖ ^ 2)) := by
  have hH : Integrable (fun x : Euclidean 2 =>
      8 * ‖r0 x‖ ^ 2 + 2 * ‖r1 x‖ ^ 2) :=
    (hr0.const_mul 8).add (hr1.const_mul 2)
  have hHs : Integrable (fun x : Euclidean 2 =>
      s ^ 2 * (8 * ‖r0 x‖ ^ 2 + 2 * ‖r1 x‖ ^ 2)) :=
    hH.const_mul (s ^ 2)
  have hpoint : ∀ᵐ x : Euclidean 2 ∂volume,
      ‖r x‖ ^ 2 ≤ s ^ 2 * (8 * ‖r0 x‖ ^ 2 + 2 * ‖r1 x‖ ^ 2) :=
    hidentity.mono fun x hident => by
    rw [hident, norm_mul, hp x, one_mul]
    have hnonneg : 0 ≤ 2 * ‖r0 x‖ + ‖r1 x‖ := by positivity
    have hs0 : 0 ≤ s := by linarith
    have hlin : ‖r0 x + s * A x‖ ≤ s * (2 * ‖r0 x‖ + ‖r1 x‖) := by
      calc
        ‖r0 x + s * A x‖ ≤ ‖r0 x‖ + ‖s * A x‖ := norm_add_le _ _
        _ = ‖r0 x‖ + s * ‖A x‖ := by
          rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (by linarith)]
        _ ≤ ‖r0 x‖ + s * (‖r1 x‖ + ‖r0 x‖) := by
          exact add_le_add_right
            (mul_le_mul_of_nonneg_left (hA x) hs0) _
        _ ≤ s * (2 * ‖r0 x‖ + ‖r1 x‖) := by
          nlinarith [norm_nonneg (r0 x), norm_nonneg (r1 x)]
    have hsq : ‖r0 x + s * A x‖ ^ 2 ≤
        (s * (2 * ‖r0 x‖ + ‖r1 x‖)) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) (mul_nonneg hs0 hnonneg)).mpr hlin
    calc
      ‖r0 x + s * A x‖ ^ 2 ≤ (s * (2 * ‖r0 x‖ + ‖r1 x‖)) ^ 2 := hsq
      _ ≤ s ^ 2 * (8 * ‖r0 x‖ ^ 2 + 2 * ‖r1 x‖ ^ 2) := by
        nlinarith [sq_nonneg (2 * ‖r0 x‖ - ‖r1 x‖)]
  calc
    (∫ x : Euclidean 2, ‖r x‖ ^ 2) ≤
        ∫ x : Euclidean 2, s ^ 2 * (8 * ‖r0 x‖ ^ 2 + 2 * ‖r1 x‖ ^ 2) :=
      integral_mono_ae hr hHs hpoint
    _ = s ^ 2 * (8 * (∫ x : Euclidean 2, ‖r0 x‖ ^ 2) +
        2 * (∫ x : Euclidean 2, ‖r1 x‖ ^ 2)) := by
      rw [integral_const_mul, integral_add (hr0.const_mul 8) (hr1.const_mul 2),
        integral_const_mul, integral_const_mul]

/-- The cancelled frequency-side energy of the level-zero cutoff half-wave is
uniformly `O(s²)` for both half-wave orientations. -/
theorem exists_cancelled_levelZero_dyadicHalfWave_energy_bound
    (C : lpCutoffs 2) :
    ∃ R : Real, ∀ (σ : WaveSign) (s : Real), 2 ≤ s →
      (∫ ξ : Euclidean 2,
        ‖cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s ξ‖ ^ 2) ≤
          R * s ^ 2 := by
  let r0 : WaveSign → Euclidean 2 → Complex := fun σ =>
    cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 0) 0
  let r1 : WaveSign → Euclidean 2 → Complex := fun σ =>
    cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 1) 1
  let H : WaveSign → Real := fun σ =>
    8 * (∫ x : Euclidean 2, ‖r0 σ x‖ ^ 2) +
      2 * (∫ x : Euclidean 2, ‖r1 σ x‖ ^ 2)
  let R : Real := H WaveSign.plus + H WaveSign.minus
  have hHnonneg (σ : WaveSign) : 0 ≤ H σ := by
    dsimp only [H]
    exact add_nonneg
      (mul_nonneg (by norm_num) (integral_nonneg fun x => sq_nonneg (‖r0 σ x‖)))
      (mul_nonneg (by norm_num) (integral_nonneg fun x => sq_nonneg (‖r1 σ x‖)))
  have hHle (σ : WaveSign) : H σ ≤ R := by
    cases σ <;> dsimp only [R] <;> linarith [hHnonneg WaveSign.plus,
      hHnonneg WaveSign.minus]
  refine ⟨R, ?_⟩
  intro σ s hs
  let r : Euclidean 2 → Complex :=
    cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s
  let A : Euclidean 2 → Complex := fun x =>
    halfWaveMultiplier σ (-1) x * r1 σ x - r0 σ x
  have hr : Integrable (fun x => ‖r x‖ ^ 2) := by
    dsimp only [r]
    exact (cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s).memLp
      2 volume |>.integrable_norm_pow (by norm_num)
  have hr0 : Integrable (fun x => ‖r0 σ x‖ ^ 2) := by
    dsimp only [r0]
    exact (cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 0) 0).memLp
      2 volume |>.integrable_norm_pow (by norm_num)
  have hr1 : Integrable (fun x => ‖r1 σ x‖ ^ 2) := by
    dsimp only [r1]
    exact (cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 1) 1).memLp
      2 volume |>.integrable_norm_pow (by norm_num)
  have hA : ∀ x, ‖A x‖ ≤ ‖r1 σ x‖ + ‖r0 σ x‖ := by
    intro x
    dsimp only [A]
    calc
      ‖halfWaveMultiplier σ (-1) x * r1 σ x - r0 σ x‖ ≤
          ‖halfWaveMultiplier σ (-1) x * r1 σ x‖ + ‖r0 σ x‖ := norm_sub_le _ _
      _ = ‖r1 σ x‖ + ‖r0 σ x‖ := by
        rw [norm_mul, norm_halfWaveMultiplier, one_mul]
  have hidentity : ∀ᵐ x : Euclidean 2 ∂volume,
      r x = halfWaveMultiplier σ s x * (r0 σ x + s * A x) := by
    have hne : ∀ᵐ x : Euclidean 2 ∂volume, x ≠ 0 := by
      simp [ae_iff, measure_singleton]
    filter_upwards [hne] with x hx
    exact cancelled_levelZero_phase_affine C σ s x hx
  have hbound := integral_norm_sq_phase_affine_le r (r0 σ) (r1 σ) A
    (halfWaveMultiplier σ s) s (by linarith) (norm_halfWaveMultiplier σ s)
    hidentity hA hr hr0 hr1
  change (∫ ξ : Euclidean 2,
    ‖cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s ξ‖ ^ 2) ≤
      R * s ^ 2
  calc
    (∫ ξ : Euclidean 2,
      ‖cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s ξ‖ ^ 2) =
        ∫ x : Euclidean 2, ‖r x‖ ^ 2 := by rfl
    _ ≤ s ^ 2 * H σ := hbound
    _ ≤ s ^ 2 * R := mul_le_mul_of_nonneg_left (hHle σ) (sq_nonneg _)
    _ = R * s ^ 2 := by ring

private theorem integral_norm_sq_fourierInv_schwartz_eq
    (q : SchwartzMap (Euclidean 2) Complex) :
    (∫ x : Euclidean 2, ‖(𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2) =
      ∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2 := by
  calc
    (∫ x : Euclidean 2, ‖(𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2) =
        ∫ ξ : Euclidean 2,
          ‖𝓕 ((𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex) ξ‖ ^ 2 :=
      (_root_.Codex.Spherical.FourierRadius.integral_norm_sq_fourier_schwartz_eq
        (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)).symm
    _ = ∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2 := by
      apply integral_congr_ae
      filter_upwards with ξ
      rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]

private theorem cone_weight_pointwise
    (q : SchwartzMap (Euclidean 2) Complex) (s : Real) (hs : s ≠ 0)
    (x : Euclidean 2) :
    coneWeight s x * ‖(𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2 =
      ‖(𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2 +
        s⁻¹ ^ 2 * ‖(SchwartzMap.smulLeftCLM Complex
          (fun y : Euclidean 2 => ‖y‖ ^ 2 - s ^ 2)
          (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) x‖ ^ 2 := by
  have hmul :
      (SchwartzMap.smulLeftCLM Complex
        (fun y : Euclidean 2 => ‖y‖ ^ 2 - s ^ 2)
        (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) x =
      ((‖x‖ ^ 2 - s ^ 2 : Real) : Complex) *
        (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x := by
    simpa [smul_eq_mul] using congrFun (SchwartzMap.smulLeftCLM_apply
      (show (fun y : Euclidean 2 => ‖y‖ ^ 2 - s ^ 2).HasTemperateGrowth by fun_prop)
      (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) x
  rw [coneWeight, hmul, norm_mul, Complex.norm_real, Real.norm_eq_abs, mul_pow, sq_abs]
  field_simp [hs]

/-- The physical cone-weighted energy of an inverse Fourier transform is
integrable at every nonzero time. -/
theorem integrable_coneWeightedEnergy_fourierInv
    (q : SchwartzMap (Euclidean 2) Complex) (s : Real) (hs : s ≠ 0) :
    Integrable (fun x : Euclidean 2 =>
      coneWeight s x * ‖(𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2) := by
  let K : SchwartzMap (Euclidean 2) Complex := 𝓕⁻ q
  let P : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex (fun x : Euclidean 2 => ‖x‖ ^ 2 - s ^ 2) K
  have hK : Integrable (fun x : Euclidean 2 => ‖K x‖ ^ 2) :=
    (K.memLp 2 volume).integrable_norm_pow (by norm_num)
  have hP : Integrable (fun x : Euclidean 2 => ‖P x‖ ^ 2) :=
    (P.memLp 2 volume).integrable_norm_pow (by norm_num)
  have hsum : Integrable (fun x : Euclidean 2 =>
      ‖K x‖ ^ 2 + s⁻¹ ^ 2 * ‖P x‖ ^ 2) :=
    hK.add (hP.const_mul _)
  refine hsum.congr ?_
  filter_upwards with x
  dsimp only [K, P]
  exact (cone_weight_pointwise q s hs x).symm

private theorem integral_cone_moment_le_cancelled
    (q : SchwartzMap (Euclidean 2) Complex) (s : Real) :
    (∫ x : Euclidean 2, ‖(SchwartzMap.smulLeftCLM Complex
      (fun y : Euclidean 2 => ‖y‖ ^ 2 - s ^ 2)
      (𝓕⁻ q : SchwartzMap (Euclidean 2) Complex)) x‖ ^ 2) ≤
      ∫ ξ : Euclidean 2, ‖cancelledWaveLaplacian q s ξ‖ ^ 2 := by
  let K : SchwartzMap (Euclidean 2) Complex := 𝓕⁻ q
  let P : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex (fun x : Euclidean 2 => ‖x‖ ^ 2 - s ^ 2) K
  let r : SchwartzMap (Euclidean 2) Complex := cancelledWaveLaplacian q s
  let c : Complex := (((2 * Real.pi) ^ 2 : Real) : Complex)
  have hphase : (𝓕⁻ r : SchwartzMap (Euclidean 2) Complex) = c • P := by
    dsimp only [r, c, P, K, cancelledWaveLaplacian]
    exact fourierInv_cancelled_laplacian_eq_cone_quadratic q s
  have hc : (1 : Real) ≤ ‖c‖ := by
    dsimp only [c]
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
    nlinarith [Real.one_le_pi_div_two]
  have hP : Integrable (fun x : Euclidean 2 => ‖P x‖ ^ 2) :=
    (P.memLp 2 volume).integrable_norm_pow (by norm_num)
  have hR : Integrable (fun x : Euclidean 2 =>
      ‖(𝓕⁻ r : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2) :=
    ((𝓕⁻ r : SchwartzMap (Euclidean 2) Complex).memLp 2 volume).integrable_norm_pow
      (by norm_num)
  have hpoint (x : Euclidean 2) : ‖P x‖ ^ 2 ≤
      ‖(𝓕⁻ r : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2 := by
    rw [hphase, smul_apply, norm_smul]
    apply (sq_le_sq₀ (norm_nonneg _) (mul_nonneg (norm_nonneg _) (norm_nonneg _))).mpr
    exact le_mul_of_one_le_left (norm_nonneg _) hc
  change (∫ x : Euclidean 2, ‖P x‖ ^ 2) ≤ ∫ ξ : Euclidean 2, ‖r ξ‖ ^ 2
  calc
    (∫ x : Euclidean 2, ‖P x‖ ^ 2) ≤
        ∫ x : Euclidean 2, ‖(𝓕⁻ r : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2 :=
      integral_mono hP hR hpoint
    _ = ∫ ξ : Euclidean 2, ‖r ξ‖ ^ 2 :=
      integral_norm_sq_fourierInv_schwartz_eq r

/-- Plancherel converts the physical cone-weighted energy of `𝓕⁻ q` into
the ordinary energy of `q` plus the scaled energy of the cancelled wave
Laplacian.  This is the bridge from Fourier-side phase calculus to the sharp
kernel estimate. -/
theorem integral_coneWeightedEnergy_fourierInv_le
    (q : SchwartzMap (Euclidean 2) Complex) (s : Real) (hs : 0 < s) :
    (∫ x : Euclidean 2,
      coneWeight s x * ‖(𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2) ≤
      (∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2) + s⁻¹ ^ 2 *
        ∫ ξ : Euclidean 2, ‖cancelledWaveLaplacian q s ξ‖ ^ 2 := by
  let K : SchwartzMap (Euclidean 2) Complex := 𝓕⁻ q
  let P : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex (fun x : Euclidean 2 => ‖x‖ ^ 2 - s ^ 2) K
  let r : SchwartzMap (Euclidean 2) Complex := cancelledWaveLaplacian q s
  have hK : Integrable (fun x : Euclidean 2 => ‖K x‖ ^ 2) :=
    (K.memLp 2 volume).integrable_norm_pow (by norm_num)
  have hP : Integrable (fun x : Euclidean 2 => ‖P x‖ ^ 2) :=
    (P.memLp 2 volume).integrable_norm_pow (by norm_num)
  have hweight : (∫ x : Euclidean 2,
      coneWeight s x * ‖K x‖ ^ 2) =
      ∫ x : Euclidean 2, ‖K x‖ ^ 2 + s⁻¹ ^ 2 * ‖P x‖ ^ 2 := by
    apply integral_congr_ae
    filter_upwards with x
    dsimp only [K, P]
    exact cone_weight_pointwise q s hs.ne' x
  have hsum : (∫ x : Euclidean 2, ‖K x‖ ^ 2 + s⁻¹ ^ 2 * ‖P x‖ ^ 2) =
      (∫ x : Euclidean 2, ‖K x‖ ^ 2) + s⁻¹ ^ 2 *
        ∫ x : Euclidean 2, ‖P x‖ ^ 2 := by
    rw [integral_add hK (hP.const_mul _), integral_const_mul]
  have hmoment : (∫ x : Euclidean 2, ‖P x‖ ^ 2) ≤
      ∫ ξ : Euclidean 2, ‖r ξ‖ ^ 2 := by
    simpa only [P, K, r] using integral_cone_moment_le_cancelled q s
  have hinv : 0 ≤ s⁻¹ ^ 2 := sq_nonneg _
  calc
    (∫ x : Euclidean 2, coneWeight s x * ‖(𝓕⁻ q : SchwartzMap (Euclidean 2) Complex) x‖ ^ 2) =
        ∫ x : Euclidean 2, coneWeight s x * ‖K x‖ ^ 2 := by rfl
    _ = ∫ x : Euclidean 2, ‖K x‖ ^ 2 + s⁻¹ ^ 2 * ‖P x‖ ^ 2 := hweight
    _ = (∫ x : Euclidean 2, ‖K x‖ ^ 2) + s⁻¹ ^ 2 *
        ∫ x : Euclidean 2, ‖P x‖ ^ 2 := hsum
    _ ≤ (∫ x : Euclidean 2, ‖K x‖ ^ 2) + s⁻¹ ^ 2 *
        ∫ ξ : Euclidean 2, ‖r ξ‖ ^ 2 := by gcongr
    _ = (∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2) + s⁻¹ ^ 2 *
        ∫ ξ : Euclidean 2, ‖r ξ‖ ^ 2 := by
      rw [show (∫ x : Euclidean 2, ‖K x‖ ^ 2) = ∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2 by
        simpa only [K] using integral_norm_sq_fourierInv_schwartz_eq q]

/-- A pointwise square bound for a compactly supported planar Schwartz
function integrates to the bound times the measure of its support container. -/
theorem integral_norm_sq_le_of_support_subset
    (q : SchwartzMap (Euclidean 2) Complex) (K : Set (Euclidean 2))
    (hK : MeasurableSet K) (hKfinite : volume K ≠ (⊤ : ENNReal))
    {A : Real} (hpoint : ∀ ξ : Euclidean 2, ‖q ξ‖ ^ 2 ≤ A)
    (hsupport : Function.support (q : Euclidean 2 → Complex) ⊆ K) :
    (∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2) ≤ A * volume.real K := by
  have hq : Integrable (fun ξ : Euclidean 2 => ‖q ξ‖ ^ 2) :=
    (q.memLp 2 volume).integrable_norm_pow (by norm_num)
  have hI : Integrable (K.indicator (fun _ : Euclidean 2 => A)) := by
    rw [integrable_indicator_iff hK]
    exact integrableOn_const hKfinite (by finiteness)
  have hmono : (fun ξ : Euclidean 2 => ‖q ξ‖ ^ 2) ≤
      K.indicator (fun _ : Euclidean 2 => A) := by
    intro ξ
    by_cases hξ : ξ ∈ K
    · rw [indicator_of_mem hξ]
      exact hpoint ξ
    · rw [indicator_of_notMem hξ]
      have hzero : q ξ = 0 := by
        by_contra hqzero
        exact hξ (hsupport (Function.mem_support.mpr hqzero))
      simp [hzero]
  calc
    (∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2) ≤
        ∫ ξ : Euclidean 2, K.indicator (fun _ : Euclidean 2 => A) ξ :=
      integral_mono hq hI hmono
    _ = volume.real K * A := by
      simpa only [smul_eq_mul] using
        (integral_indicator_const (μ := volume) (e := A) hK)
    _ = A * volume.real K := by ring

/-- A pointwise `O(s)` bound on a compactly supported planar Schwartz
function yields the scale-compatible `O(s²)` energy estimate. -/
theorem integral_norm_sq_le_scaled_of_norm_le_of_support_subset
    (q : SchwartzMap (Euclidean 2) Complex) (K : Set (Euclidean 2))
    (hK : MeasurableSet K) (hKfinite : volume K ≠ (⊤ : ENNReal))
    {B s : Real} (hB : 0 ≤ B) (hs : 0 ≤ s)
    (hpoint : ∀ ξ : Euclidean 2, ‖q ξ‖ ≤ B * s)
    (hsupport : Function.support (q : Euclidean 2 → Complex) ⊆ K) :
    (∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2) ≤ (B ^ 2 * volume.real K) * s ^ 2 := by
  have hBs : 0 ≤ B * s := mul_nonneg hB hs
  have hpointSq : ∀ ξ : Euclidean 2, ‖q ξ‖ ^ 2 ≤ (B * s) ^ 2 := by
    intro ξ
    nlinarith [norm_nonneg (q ξ), hpoint ξ, hBs]
  calc
    (∫ ξ : Euclidean 2, ‖q ξ‖ ^ 2) ≤ (B * s) ^ 2 * volume.real K :=
      integral_norm_sq_le_of_support_subset q K hK hKfinite hpointSq hsupport
    _ = (B ^ 2 * volume.real K) * s ^ 2 := by ring

/-- The level-zero cutoff half-wave symbols have a uniform `L²` bound,
independent of orientation and time. -/
theorem integral_norm_sq_levelZero_dyadicHalfWaveSchwartzSymbol_le
    (C : lpCutoffs 2) (σ : WaveSign) (s : Real) :
    (∫ ξ : Euclidean 2,
      ‖dyadicHalfWaveSchwartzSymbol C σ 0 s ξ‖ ^ 2) ≤
      4 * volume.real (Metric.closedBall (0 : Euclidean 2) 4) := by
  apply integral_norm_sq_le_of_support_subset
    (q := dyadicHalfWaveSchwartzSymbol C σ 0 s)
    (K := Metric.closedBall (0 : Euclidean 2) 4)
  · exact measurableSet_closedBall
  · exact measure_closedBall_lt_top.ne
  · intro ξ
    nlinarith [norm_nonneg (dyadicHalfWaveSchwartzSymbol C σ 0 s ξ),
      norm_dyadicHalfWaveSchwartzSymbol_le_two C σ 0 s ξ]
  · intro ξ hξ
    by_contra hξK
    have hnorm : (4 : Real) ≤ ‖ξ‖ := by
      rw [Metric.mem_closedBall, dist_zero_right] at hξK
      exact le_of_not_ge hξK
    have hband : dyadicBandpassMultiplier C.cutoff 0 ξ = 0 :=
      dyadicBandpass_eq_zero_of_le_norm C (by
        norm_num
        exact hnorm)
    have hzero : dyadicHalfWaveSchwartzSymbol C σ 0 s ξ = 0 := by
      rw [dyadicHalfWaveSchwartzSymbol_apply, dyadicHalfWaveSymbol, hband, mul_zero]
    change dyadicHalfWaveSchwartzSymbol C σ 0 s ξ ≠ 0 at hξ
    exact hξ hzero

/-- A uniform level-zero cone-weighted energy bound for both wave signs.

This is the precise Fourier-side cancellation input needed for the sharp
physical kernel endpoint.  It is deliberately separated from the
physical-space Cauchy--Schwarz and scaling argument. -/
def HasUniformConeWeightedKernelEnergy (C : lpCutoffs 2) : Prop :=
  ∃ A : Real, 0 < A ∧ ∀ (σ : WaveSign) (s : Real), 2 ≤ s →
    Integrable (fun x : Euclidean 2 =>
      coneWeight s x * ‖dyadicHalfWaveKernel C σ 0 s x‖ ^ 2) ∧
      (∫ x : Euclidean 2,
        coneWeight s x * ‖dyadicHalfWaveKernel C σ 0 s x‖ ^ 2) ≤ A

/-- Uniform ordinary and cancelled frequency-side energies imply the
level-zero cone-weighted kernel energy used by the sharp MSS kernel bound. -/
theorem hasUniformConeWeightedKernelEnergy_of_frequencyBounds
    (C : lpCutoffs 2) {Q R : Real}
    (hQ : ∀ (σ : WaveSign) (s : Real), 2 ≤ s →
      (∫ ξ : Euclidean 2,
        ‖dyadicHalfWaveSchwartzSymbol C σ 0 s ξ‖ ^ 2) ≤ Q)
    (hR : ∀ (σ : WaveSign) (s : Real), 2 ≤ s →
      (∫ ξ : Euclidean 2,
        ‖cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s ξ‖ ^ 2) ≤
          R * s ^ 2) :
    HasUniformConeWeightedKernelEnergy C := by
  let A : Real := |Q| + |R| + 1
  have hA : 0 < A := by
    dsimp only [A]
    positivity
  refine ⟨A, hA, ?_⟩
  intro σ s hs
  have hs0 : s ≠ 0 := by linarith
  constructor
  · simpa only [dyadicHalfWaveKernel] using
      integrable_coneWeightedEnergy_fourierInv
        (dyadicHalfWaveSchwartzSymbol C σ 0 s) s hs0
  · calc
      (∫ x : Euclidean 2,
        coneWeight s x * ‖dyadicHalfWaveKernel C σ 0 s x‖ ^ 2) ≤
          (∫ ξ : Euclidean 2,
            ‖dyadicHalfWaveSchwartzSymbol C σ 0 s ξ‖ ^ 2) + s⁻¹ ^ 2 *
              ∫ ξ : Euclidean 2,
                ‖cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s ξ‖ ^ 2 := by
            simpa only [dyadicHalfWaveKernel] using
              integral_coneWeightedEnergy_fourierInv_le
                (dyadicHalfWaveSchwartzSymbol C σ 0 s) s (by linarith)
      _ ≤ Q + s⁻¹ ^ 2 * (R * s ^ 2) := by
        gcongr
        · exact hQ σ s hs
        · exact hR σ s hs
      _ = Q + R := by
        field_simp [hs0]
      _ ≤ A := by
        dsimp only [A]
        linarith [le_abs_self Q, le_abs_self R]

/-- After the elementary cutoff-symbol energy is absorbed, the cancelled
frequency energy alone is sufficient for the uniform kernel cone energy. -/
theorem hasUniformConeWeightedKernelEnergy_of_cancelledEnergyBound
    (C : lpCutoffs 2) {R : Real}
    (hR : ∀ (σ : WaveSign) (s : Real), 2 ≤ s →
      (∫ ξ : Euclidean 2,
        ‖cancelledWaveLaplacian (dyadicHalfWaveSchwartzSymbol C σ 0 s) s ξ‖ ^ 2) ≤
          R * s ^ 2) :
    HasUniformConeWeightedKernelEnergy C := by
  apply hasUniformConeWeightedKernelEnergy_of_frequencyBounds C
    (Q := 4 * volume.real (Metric.closedBall (0 : Euclidean 2) 4)) (R := R)
  · intro σ s _
    exact integral_norm_sq_levelZero_dyadicHalfWaveSchwartzSymbol_le C σ s
  · exact hR

/-- The level-zero cutoff half-wave has uniformly bounded cone-weighted
physical energy.  Its proof is the Fourier-side phase cancellation above,
combined with Plancherel. -/
theorem hasUniformConeWeightedKernelEnergy (C : lpCutoffs 2) :
    HasUniformConeWeightedKernelEnergy C := by
  rcases exists_cancelled_levelZero_dyadicHalfWave_energy_bound C with ⟨R, hR⟩
  exact hasUniformConeWeightedKernelEnergy_of_cancelledEnergyBound C hR

/-- At level zero, a cone-weighted energy bound controls the physical
kernel `L¹` norm. -/
theorem levelZeroKernelL1_le_of_coneWeightedEnergy
    (C : lpCutoffs 2) (σ : WaveSign) (s : Real) (hs : 0 < s)
    {A : Real}
    (henergy : Integrable (fun x : Euclidean 2 =>
      coneWeight s x * ‖dyadicHalfWaveKernel C σ 0 s x‖ ^ 2))
    (hbound : (∫ x : Euclidean 2,
      coneWeight s x * ‖dyadicHalfWaveKernel C σ 0 s x‖ ^ 2) ≤ A) :
    dyadicHalfWaveKernelL1 C σ 0 s ≤
      A ^ ((2 : Real)⁻¹) *
        ((volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s) ^ ((2 : Real)⁻¹) := by
  have hmain := integral_norm_le_coneWeightedEnergy
    (dyadicHalfWaveKernel C σ 0 s) s hs henergy
  have henergy_nonneg : 0 ≤ ∫ x : Euclidean 2,
      coneWeight s x * ‖dyadicHalfWaveKernel C σ 0 s x‖ ^ 2 :=
    integral_nonneg fun x => mul_nonneg (coneWeight_pos s x).le (sq_nonneg _)
  have hfactor_nonneg : 0 ≤
      ((volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s) ^ ((2 : Real)⁻¹) := by
    apply Real.rpow_nonneg
    exact mul_nonneg (mul_nonneg MeasureTheory.measureReal_nonneg Real.pi_pos.le) hs.le
  change (∫ x : Euclidean 2, ‖dyadicHalfWaveKernel C σ 0 s x‖) ≤ _
  calc
    (∫ x : Euclidean 2, ‖dyadicHalfWaveKernel C σ 0 s x‖) ≤
        (∫ x : Euclidean 2,
          coneWeight s x * ‖dyadicHalfWaveKernel C σ 0 s x‖ ^ 2) ^ ((2 : Real)⁻¹) *
          ((volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s) ^ ((2 : Real)⁻¹) := hmain
    _ ≤ A ^ ((2 : Real)⁻¹) *
        ((volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi) * s) ^ ((2 : Real)⁻¹) :=
      mul_le_mul_of_nonneg_right
        (Real.rpow_le_rpow henergy_nonneg hbound (by positivity)) hfactor_nonneg

/-- A uniform level-zero cone-energy estimate yields the sharp `2^{j/2}`
bound for every dyadic physical kernel on the MSS unit time interval. -/
theorem waveKernelL1_sharp_of_uniformConeWeightedEnergy
    (C : lpCutoffs 2) (hcone : HasUniformConeWeightedKernelEnergy C) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : WaveSign) (j : Nat), 1 ≤ j →
      ∀ t : Real, t ∈ Icc (1 : Real) 2 →
        dyadicHalfWaveKernelL1 C σ j t ≤ B * Real.sqrt ((2 : Real) ^ j) := by
  rcases hcone with ⟨A, hA, hcone⟩
  let D : Real := volume.real (Metric.ball (0 : Euclidean 2) 1) * Real.pi
  let B : Real := 1 + A ^ ((2 : Real)⁻¹) * (D * 2) ^ ((2 : Real)⁻¹)
  have hD : 0 ≤ D := by
    dsimp only [D]
    exact mul_nonneg MeasureTheory.measureReal_nonneg Real.pi_pos.le
  have hD2 : 0 ≤ D * (2 : Real) := mul_nonneg hD (by norm_num)
  have hB : 0 < B := by
    have hterm : 0 ≤ A ^ ((2 : Real)⁻¹) * (D * 2) ^ ((2 : Real)⁻¹) :=
      mul_nonneg (Real.rpow_nonneg hA.le _) (Real.rpow_nonneg hD2 _)
    dsimp only [B]
    linarith
  refine ⟨B, hB, ?_⟩
  intro σ j hj t ht
  let q : Real := (2 : Real) ^ j
  let s : Real := q * t
  have hqpos : 0 < q := by
    dsimp only [q]
    positivity
  have hqnonneg : 0 ≤ q := hqpos.le
  have hqge : 2 ≤ q := by
    dsimp only [q]
    calc
      (2 : Real) = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ j := by exact pow_le_pow_right₀ (by norm_num) hj
  have hspos : 0 < s := by
    dsimp only [s]
    exact mul_pos hqpos (lt_of_lt_of_le (by norm_num) ht.1)
  have hsge : 2 ≤ s := by
    dsimp only [s]
    calc
      (2 : Real) ≤ q := hqge
      _ = q * 1 := (mul_one q).symm
      _ ≤ q * t := mul_le_mul_of_nonneg_left ht.1 hqnonneg
  obtain ⟨henergy, henergy_bound⟩ := hcone σ s hsge
  have hlevel := levelZeroKernelL1_le_of_coneWeightedEnergy
    C σ s hspos henergy henergy_bound
  have hscale : dyadicHalfWaveKernelL1 C σ j t = dyadicHalfWaveKernelL1 C σ 0 s := by
    simpa only [s, q] using dyadicHalfWaveKernelL1_eq_levelZero_scaled C σ j t
  rw [hscale]
  have hst : s ≤ q * 2 := by
    dsimp only [s]
    exact mul_le_mul_of_nonneg_left ht.2 hqnonneg
  have hDst : D * s ≤ D * (q * 2) := mul_le_mul_of_nonneg_left hst hD
  have hcone_nonneg : 0 ≤ D * s := mul_nonneg hD hspos.le
  calc
    dyadicHalfWaveKernelL1 C σ 0 s ≤ A ^ ((2 : Real)⁻¹) * (D * s) ^ ((2 : Real)⁻¹) := by
      simpa only [D] using hlevel
    _ ≤ A ^ ((2 : Real)⁻¹) * (D * (q * 2)) ^ ((2 : Real)⁻¹) := by
      apply mul_le_mul_of_nonneg_left
      · exact Real.rpow_le_rpow hcone_nonneg hDst (by positivity)
      · exact Real.rpow_nonneg hA.le _
    _ = (A ^ ((2 : Real)⁻¹) * (D * 2) ^ ((2 : Real)⁻¹)) * Real.sqrt q := by
      rw [show D * (q * 2) = (D * 2) * q by ring,
        Real.mul_rpow hD2 hqnonneg]
      have hqsqrt : q ^ ((2 : Real)⁻¹) = Real.sqrt q := by
        rw [show (2 : Real)⁻¹ = 1 / 2 by norm_num, ← Real.sqrt_eq_rpow]
      rw [hqsqrt]
      ring
    _ ≤ B * Real.sqrt ((2 : Real) ^ j) := by
      change (A ^ ((2 : Real)⁻¹) * (D * 2) ^ ((2 : Real)⁻¹)) * Real.sqrt q ≤
        B * Real.sqrt q
      apply mul_le_mul_of_nonneg_right
      · dsimp only [B]
        linarith
      · exact Real.sqrt_nonneg _

/-- The physical fixed-time `L∞` endpoint that follows formally from any
sharp dyadic kernel `L¹` estimate. -/
theorem mssLInfinityEndpoint_of_waveKernelL1_sharp
    (C : lpCutoffs 2) {B : Real}
    (hkernel : ∀ (σ : WaveSign) (j : Nat), 1 ≤ j →
      ∀ t : Real, t ∈ Icc (1 : Real) 2 →
        dyadicHalfWaveKernelL1 C σ j t ≤ B * Real.sqrt ((2 : Real) ^ j)) :
    ∀ (σ : WaveSign) (j : Nat), 1 ≤ j →
      ∀ t : Real, t ∈ Icc (1 : Real) 2 →
        ∀ (f : SchwartzMap (Euclidean 2) Complex) {A : Real},
          (∀ x, ‖f x‖ ≤ A) → ∀ x,
            ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
              (B * Real.sqrt ((2 : Real) ^ j)) * A := by
  intro σ j hj t ht f A hf x
  have hA : 0 ≤ A := le_trans (norm_nonneg (f 0)) (hf 0)
  calc
    ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
        A * dyadicHalfWaveKernelL1 C σ j t :=
      fixedTimePhysicalLInfinityEndpoint C σ j t f hf x
    _ ≤ A * (B * Real.sqrt ((2 : Real) ^ j)) :=
      mul_le_mul_of_nonneg_left (hkernel σ j hj t ht) hA
    _ = (B * Real.sqrt ((2 : Real) ^ j)) * A := by ring

/-- The conditional MSS physical `L∞` endpoint resulting from a uniform
level-zero cone-weighted energy bound. -/
theorem mssLInfinityEndpoint_of_uniformConeWeightedEnergy
    (C : lpCutoffs 2) (hcone : HasUniformConeWeightedKernelEnergy C) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : WaveSign) (j : Nat), 1 ≤ j →
      ∀ t : Real, t ∈ Icc (1 : Real) 2 →
        ∀ (f : SchwartzMap (Euclidean 2) Complex) {A : Real},
          (∀ x, ‖f x‖ ≤ A) → ∀ x,
            ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
              (B * Real.sqrt ((2 : Real) ^ j)) * A := by
  rcases waveKernelL1_sharp_of_uniformConeWeightedEnergy C hcone with ⟨B, hB, hkernel⟩
  exact ⟨B, hB, mssLInfinityEndpoint_of_waveKernelL1_sharp C hkernel⟩

/-- The sharp dyadic planar half-wave kernel bound on the MSS unit-time
interval. -/
theorem waveKernelL1_sharp (C : lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : WaveSign) (j : Nat), 1 ≤ j →
      ∀ t : Real, t ∈ Icc (1 : Real) 2 →
        dyadicHalfWaveKernelL1 C σ j t ≤ B * Real.sqrt ((2 : Real) ^ j) :=
  waveKernelL1_sharp_of_uniformConeWeightedEnergy C
    (hasUniformConeWeightedKernelEnergy C)

/-- The fixed-time planar MSS `L∞` endpoint obtained from the sharp kernel
bound. -/
theorem mssLInfinityEndpoint (C : lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : WaveSign) (j : Nat), 1 ≤ j →
      ∀ t : Real, t ∈ Icc (1 : Real) 2 →
        ∀ (f : SchwartzMap (Euclidean 2) Complex) {A : Real},
          (∀ x, ‖f x‖ ≤ A) → ∀ x,
            ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
              (B * Real.sqrt ((2 : Real) ^ j)) * A :=
  mssLInfinityEndpoint_of_uniformConeWeightedEnergy C
    (hasUniformConeWeightedKernelEnergy C)

/-- Fixed-time pointwise endpoint obtained directly from Fourier inversion.
It is an `L∞` estimate in the physical output variable, with the natural
Fourier-`L¹` norm on the Schwartz input. -/
theorem fixedTimeFourierL1Endpoint (C : lpCutoffs 2) (σ : WaveSign)
    (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) :
    ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
      2 * ∫ ξ : Euclidean 2, ‖𝓕 (f : Euclidean 2 → Complex) ξ‖ := by
  have hfourier : Integrable (𝓕 (f : Euclidean 2 → Complex)) := by
    rw [← SchwartzMap.fourier_coe]
    exact (𝓕 f).integrable
  have hmajor : Integrable (fun ξ : Euclidean 2 =>
      2 * ‖𝓕 (f : Euclidean 2 → Complex) ξ‖) :=
    hfourier.norm.const_mul (2 : Real)
  rw [dyadicHalfWave, Real.fourierInv_eq']
  simp only [smul_eq_mul]
  calc
    ‖∫ ξ : Euclidean 2,
        Complex.exp (((2 * Real.pi * inner Real ξ x : Real) : Complex) * Complex.I) *
          (halfWaveMultiplier σ t ξ * dyadicBandpassMultiplier C.cutoff j ξ *
            𝓕 (f : Euclidean 2 → Complex) ξ)‖ ≤
        ∫ ξ : Euclidean 2, 2 * ‖𝓕 (f : Euclidean 2 → Complex) ξ‖ := by
      refine norm_integral_le_of_norm_le
        (f := fun ξ : Euclidean 2 =>
          Complex.exp (((2 * Real.pi * inner Real ξ x : Real) : Complex) * Complex.I) *
            (halfWaveMultiplier σ t ξ * dyadicBandpassMultiplier C.cutoff j ξ *
              𝓕 (f : Euclidean 2 → Complex) ξ))
        (g := fun ξ : Euclidean 2 => 2 * ‖𝓕 (f : Euclidean 2 → Complex) ξ‖)
        hmajor ?_
      filter_upwards with ξ
      rw [norm_mul, norm_mul, norm_mul, Complex.norm_exp_ofReal_mul_I,
        norm_halfWaveMultiplier]
      simpa only [one_mul] using mul_le_mul_of_nonneg_right
        (norm_dyadicBandpassMultiplier_le_two C j ξ)
        (norm_nonneg _)
    _ = 2 * ∫ ξ : Euclidean 2, ‖𝓕 (f : Euclidean 2 → Complex) ξ‖ := by
      rw [integral_const_mul]

/-- Blueprint-facing name for the proved fixed-time pointwise (`L∞` in the
output variable) endpoint. -/
theorem lInfinityEndpoint (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (t : Real) (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
      2 * ∫ ξ : Euclidean 2, ‖𝓕 (f : Euclidean 2 → Complex) ξ‖ :=
  fixedTimeFourierL1Endpoint C σ j t f x

/-- The square of a fixed-time cutoff half-wave is integrable.  This is the
Schwartz regularity input needed to apply product-measure Fubini. -/
theorem integrable_norm_sq_dyadicHalfWave (C : lpCutoffs 2) (σ : WaveSign)
    (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun x : Euclidean 2 => ‖dyadicHalfWave C.cutoff σ j t f x‖ ^ 2) := by
  let h : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex
      (dyadicHalfWaveSchwartzSymbol C σ j t : Euclidean 2 → Complex) (𝓕 f)
  let g : SchwartzMap (Euclidean 2) Complex := 𝓕⁻ h
  have hEq : (fun x : Euclidean 2 => dyadicHalfWave C.cutoff σ j t f x) = g := by
    funext x
    change 𝓕⁻ (fun ξ : Euclidean 2 =>
      halfWaveMultiplier σ t ξ * dyadicBandpassMultiplier C.cutoff j ξ *
        𝓕 (f : Euclidean 2 → Complex) ξ) x =
      (𝓕⁻ h : SchwartzMap (Euclidean 2) Complex) x
    rw [SchwartzMap.fourierInv_coe]
    apply congrArg (fun q : Euclidean 2 → Complex => 𝓕⁻ q x)
    funext ξ
    simp only [h, SchwartzMap.smulLeftCLM_apply
      (dyadicHalfWaveSchwartzSymbol C σ j t).hasTemperateGrowth, smul_eq_mul,
      dyadicHalfWaveSchwartzSymbol_apply, dyadicHalfWaveSymbol,
      SchwartzMap.fourier_coe]
  have hpow : (fun x : Euclidean 2 => ‖dyadicHalfWave C.cutoff σ j t f x‖ ^ 2) =
      fun x => ‖g x‖ ^ 2 := by
    funext x
    rw [congrFun hEq x]
  rw [hpow]
  exact (g.memLp 2 volume).integrable_norm_pow (by norm_num)

/-- The local space--time measure used for the time interval `[1,2]`. -/
def localSmoothingMeasure : Measure (Euclidean 2 × Real) :=
  (volume : Measure (Euclidean 2)).prod (volume.restrict (Icc (1 : Real) 2))

/-- The frequency-localized half-wave considered as a space--time function. -/
def dyadicHalfWaveSpaceTime (χ : SchwartzMap (Euclidean 2) Complex)
    (σ : WaveSign) (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    Euclidean 2 × Real → Complex :=
  fun z => dyadicHalfWave χ σ j z.2 f z.1

/-- A cutoff half-wave is jointly continuous in space and time.  The proof
uses compact frequency support to turn the inverse Fourier integral into a
continuous parametric integral. -/
theorem continuous_dyadicHalfWaveSpaceTime (C : lpCutoffs 2) (σ : WaveSign)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    Continuous (dyadicHalfWaveSpaceTime C.cutoff σ j f) := by
  let K : Set (Euclidean 2) := Metric.closedBall 0 ((2 : Real) ^ (j + 2))
  have hK : IsCompact K := isCompact_closedBall _ _
  have hKmeas : MeasurableSet K := hK.measurableSet
  let G : (Euclidean 2 × Real) → Euclidean 2 → Complex := fun z ξ =>
    (Real.fourierChar (inner Real ξ z.1) : Complex) *
      (halfWaveMultiplier σ z.2 ξ * dyadicBandpassMultiplier C.cutoff j ξ *
        𝓕 (f : Euclidean 2 → Complex) ξ)
  have hGcont : Continuous (Function.uncurry G) := by
    change Continuous (fun q : (Euclidean 2 × Real) × Euclidean 2 =>
      (Real.fourierChar (inner Real q.2 q.1.1) : Complex) *
        (halfWaveMultiplier σ q.1.2 q.2 * dyadicBandpassMultiplier C.cutoff j q.2 *
          𝓕 (f : Euclidean 2 → Complex) q.2))
    have hchar : Continuous (fun q : (Euclidean 2 × Real) × Euclidean 2 =>
        (Real.fourierChar (inner Real q.2 q.1.1) : Complex)) := by
      fun_prop
    have hphaseArg : Continuous (fun q : (Euclidean 2 × Real) × Euclidean 2 =>
        ((σ.toReal * (2 * Real.pi) * q.1.2 * ‖q.2‖ : Real) : Complex) * Complex.I) :=
      ((Complex.continuous_ofReal.comp (by fun_prop)).mul continuous_const)
    have hphase : Continuous (fun q : (Euclidean 2 × Real) × Euclidean 2 =>
        halfWaveMultiplier σ q.1.2 q.2) := by
      change Continuous (fun q : (Euclidean 2 × Real) × Euclidean 2 =>
        Complex.exp (((σ.toReal * (2 * Real.pi) * q.1.2 * ‖q.2‖ : Real) : Complex) *
          Complex.I))
      exact Complex.continuous_exp.comp hphaseArg
    exact hchar.mul ((hphase.mul
      ((dyadicBandpassMultiplier C.cutoff j).continuous.comp continuous_snd)).mul
        ((𝓕 f).continuous.comp continuous_snd))
  have hGsupport (z : Euclidean 2 × Real) : Function.support (G z) ⊆ K := by
    intro ξ hξ
    by_contra hξK
    have hnorm : (2 : Real) ^ (j + 2) ≤ ‖ξ‖ := by
      change ξ ∉ Metric.closedBall 0 ((2 : Real) ^ (j + 2)) at hξK
      rw [Metric.mem_closedBall, dist_zero_right] at hξK
      exact le_of_not_ge hξK
    have hband : dyadicBandpassMultiplier C.cutoff j ξ = 0 :=
      dyadicBandpass_eq_zero_of_le_norm C hnorm
    change G z ξ ≠ 0 at hξ
    exact hξ (by simp [G, hband])
  have hGintegral (z : Euclidean 2 × Real) :
      (∫ ξ : Euclidean 2, G z ξ) = ∫ ξ in K, G z ξ := by
    rw [← MeasureTheory.integral_indicator hKmeas]
    rw [Set.indicator_eq_self.mpr (hGsupport z)]
  have hEq (z : Euclidean 2 × Real) :
      dyadicHalfWaveSpaceTime C.cutoff σ j f z = ∫ ξ in K, G z ξ := by
    rw [show dyadicHalfWaveSpaceTime C.cutoff σ j f z =
        ∫ ξ : Euclidean 2, G z ξ by
      dsimp only [dyadicHalfWaveSpaceTime, dyadicHalfWave, G]
      rw [Real.fourierInv_eq]
      rfl]
    exact hGintegral z
  rw [show dyadicHalfWaveSpaceTime C.cutoff σ j f = fun z => ∫ ξ in K, G z ξ by
    funext z
    exact hEq z]
  exact continuous_parametric_integral_of_continuous (μ := volume) hGcont hK

/-- The joint-continuity result supplies the measurability input for Fubini
and space--time norm arguments. -/
theorem aestronglyMeasurable_dyadicHalfWaveSpaceTime (C : lpCutoffs 2)
    (σ : WaveSign) (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    AEStronglyMeasurable (dyadicHalfWaveSpaceTime C.cutoff σ j f)
      localSmoothingMeasure :=
  (continuous_dyadicHalfWaveSpaceTime C σ j f).aestronglyMeasurable

/-- The local square of a cutoff half-wave is integrable on the unit time
slab.  This is the Fubini regularity part of the local `L²` endpoint. -/
theorem integrable_norm_sq_dyadicHalfWaveSpaceTime (C : lpCutoffs 2)
    (σ : WaveSign) (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun z : Euclidean 2 × Real =>
      ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖ ^ 2) localSmoothingMeasure := by
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  let F : Euclidean 2 × Real → Real := fun z =>
    ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖ ^ 2
  let J : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hFmeas : AEStronglyMeasurable F ((volume : Measure (Euclidean 2)).prod ν) := by
    change AEStronglyMeasurable F localSmoothingMeasure
    convert (aestronglyMeasurable_dyadicHalfWaveSpaceTime C σ j f).norm.pow 2 using 1
    funext z
    simp only [F, Pi.pow_apply]
  have hsliceInt (t : Real) : Integrable (fun x : Euclidean 2 => F (x, t)) := by
    simpa only [F, dyadicHalfWaveSpaceTime] using
      integrable_norm_sq_dyadicHalfWave C σ j t f
  have hsliceBound (t : Real) :
      (∫ x : Euclidean 2, F (x, t)) ≤ 4 * J := by
    simpa only [F, J, dyadicHalfWaveSpaceTime] using
      fixedTimeL2Endpoint C σ j t f
  have houterMeas : AEStronglyMeasurable (fun t : Real =>
      ∫ x : Euclidean 2, F (x, t)) ν := by
    convert hFmeas.prod_swap.integral_prod_right' using 1
    funext t
    apply integral_congr_ae
    filter_upwards with x
    rfl
  have hconst : Integrable (fun _ : Real => 4 * J) ν :=
    integrable_const _
  have houterInt : Integrable (fun t : Real => ∫ x : Euclidean 2, F (x, t)) ν :=
    hconst.mono' houterMeas (by
      filter_upwards with t
      rw [Real.norm_of_nonneg (integral_nonneg fun x => sq_nonneg _)]
      exact hsliceBound t)
  have houterNormInt : Integrable (fun t : Real =>
      ∫ x : Euclidean 2, ‖F (x, t)‖) ν := by
    convert houterInt using 1
    funext t
    apply integral_congr_ae
    filter_upwards with x
    exact Real.norm_of_nonneg (by dsimp only [F]; exact sq_nonneg _)
  have hFint : Integrable F ((volume : Measure (Euclidean 2)).prod ν) :=
    (integrable_prod_iff' hFmeas).mpr
      ⟨Filter.Eventually.of_forall hsliceInt, houterNormInt⟩
  change Integrable F ((volume : Measure (Euclidean 2)).prod ν)
  exact hFint

/-- Fubini upgrades the uniform fixed-time Plancherel estimate to the local
space--time square-integral estimate.  The time interval has length one. -/
theorem integral_norm_sq_dyadicHalfWaveSpaceTime_le_four (C : lpCutoffs 2)
    (σ : WaveSign) (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    (∫ z : Euclidean 2 × Real,
      ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖ ^ 2 ∂localSmoothingMeasure) ≤
      4 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  let F : Euclidean 2 × Real → Real := fun z =>
    ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖ ^ 2
  let J : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hFmeas : AEStronglyMeasurable F ((volume : Measure (Euclidean 2)).prod ν) := by
    change AEStronglyMeasurable F localSmoothingMeasure
    convert (aestronglyMeasurable_dyadicHalfWaveSpaceTime C σ j f).norm.pow 2 using 1
    funext z
    simp only [F, Pi.pow_apply]
  have hsliceInt (t : Real) : Integrable (fun x : Euclidean 2 => F (x, t)) := by
    simpa only [F, dyadicHalfWaveSpaceTime] using
      integrable_norm_sq_dyadicHalfWave C σ j t f
  have hsliceBound (t : Real) :
      (∫ x : Euclidean 2, F (x, t)) ≤ 4 * J := by
    simpa only [F, J, dyadicHalfWaveSpaceTime] using
      fixedTimeL2Endpoint C σ j t f
  have hJnonneg : 0 ≤ J := by
    dsimp only [J]
    exact integral_nonneg fun _ => sq_nonneg _
  have houterMeas : AEStronglyMeasurable (fun t : Real =>
      ∫ x : Euclidean 2, F (x, t)) ν := by
    convert hFmeas.prod_swap.integral_prod_right' using 1
    funext t
    apply integral_congr_ae
    filter_upwards with x
    rfl
  have hconst : Integrable (fun _ : Real => 4 * J) ν :=
    integrable_const _
  have houterInt : Integrable (fun t : Real => ∫ x : Euclidean 2, F (x, t)) ν :=
    hconst.mono' houterMeas (by
      filter_upwards with t
      rw [Real.norm_of_nonneg (integral_nonneg fun x => sq_nonneg _)]
      exact hsliceBound t)
  have houterNormInt : Integrable (fun t : Real =>
      ∫ x : Euclidean 2, ‖F (x, t)‖) ν := by
    convert houterInt using 1
    funext t
    apply integral_congr_ae
    filter_upwards with x
    exact Real.norm_of_nonneg (by dsimp only [F]; exact sq_nonneg _)
  have hFint : Integrable F ((volume : Measure (Euclidean 2)).prod ν) :=
    (integrable_prod_iff' hFmeas).mpr
      ⟨Filter.Eventually.of_forall hsliceInt, houterNormInt⟩
  have hνuniv : ν.real Set.univ = 1 := by
    dsimp only [ν]
    rw [measureReal_restrict_apply_univ, Real.volume_real_Icc_of_le (by norm_num)]
    norm_num
  change (∫ z : Euclidean 2 × Real, F z ∂(volume : Measure (Euclidean 2)).prod ν) ≤
    4 * J
  calc
    (∫ z : Euclidean 2 × Real, F z ∂(volume : Measure (Euclidean 2)).prod ν) =
        ∫ t : Real, ∫ x : Euclidean 2, F (x, t) ∂volume ∂ν :=
      integral_prod_symm F hFint
    _ ≤ ∫ _ : Real, 4 * J ∂ν :=
      integral_mono houterInt hconst hsliceBound
    _ = 4 * J := by
      rw [integral_const, smul_eq_mul, hνuniv, one_mul]

/-- The full space--time `L²` endpoint in the form interpolated in the MSS
argument.  This is a target predicate rather than a claim: the source-checked
fixed-time Plancherel theorem is `l2Endpoint`; passing it through Fubini
requires the remaining joint-measurability layer. -/
def localL2Endpoint (C : lpCutoffs 2) : Prop :=
  ∀ j : Nat, ∀ f : SchwartzMap (Euclidean 2) Complex, ∀ σ : WaveSign,
    eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j f) (ENNReal.ofReal 2)
        localSmoothingMeasure ≤
      ENNReal.ofReal 2 *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal 2) volume

/-- The local space--time `L²` endpoint, obtained from the fixed-time
Plancherel estimate by Fubini over the unit-length time interval. -/
theorem localL2Endpoint_proof (C : lpCutoffs 2) : localL2Endpoint C := by
  intro j f σ
  let u : Euclidean 2 × Real → Complex := dyadicHalfWaveSpaceTime C.cutoff σ j f
  have huMeas : AEStronglyMeasurable u localSmoothingMeasure := by
    simpa only [u] using aestronglyMeasurable_dyadicHalfWaveSpaceTime C σ j f
  have huSqInt : Integrable (fun z : Euclidean 2 × Real => ‖u z‖ ^ 2)
      localSmoothingMeasure := by
    simpa only [u] using integrable_norm_sq_dyadicHalfWaveSpaceTime C σ j f
  have huMem : MemLp u 2 localSmoothingMeasure :=
    (memLp_two_iff_integrable_sq_norm huMeas).mpr huSqInt
  have hfMem : MemLp (f : Euclidean 2 → Complex) 2 volume := f.memLp 2 volume
  let Iu : Real := ∫ z : Euclidean 2 × Real, ‖u z‖ ^ 2 ∂localSmoothingMeasure
  let If : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hsq : Iu ≤ 4 * If := by
    simpa only [Iu, If, u] using
      integral_norm_sq_dyadicHalfWaveSpaceTime_le_four C σ j f
  have hsqrt : Real.sqrt Iu ≤ 2 * Real.sqrt If := by
    calc
      Real.sqrt Iu ≤ Real.sqrt (4 * If) := Real.sqrt_le_sqrt hsq
      _ = 2 * Real.sqrt If := by
        calc
          Real.sqrt (4 * If) = Real.sqrt ((2 : Real) ^ 2) * Real.sqrt If := by
            rw [show (4 : Real) = 2 ^ 2 by norm_num, Real.sqrt_mul
              (by positivity : (0 : Real) ≤ 2 ^ 2)]
          _ = 2 * Real.sqrt If := by
            congr 1
            exact Real.sqrt_sq (by norm_num : (0 : Real) ≤ 2)
  have hroot : Iu ^ (2 : Real)⁻¹ ≤ 2 * If ^ (2 : Real)⁻¹ := by
    rw [show (2 : Real)⁻¹ = 1 / 2 by norm_num, ← Real.sqrt_eq_rpow,
      ← Real.sqrt_eq_rpow]
    exact hsqrt
  have hNormu : eLpNorm u 2 localSmoothingMeasure =
      ENNReal.ofReal (Iu ^ (2 : Real)⁻¹) := by
    rw [huMem.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    norm_num [Iu]
  have hNormf : eLpNorm (f : Euclidean 2 → Complex) 2 volume =
      ENNReal.ofReal (If ^ (2 : Real)⁻¹) := by
    rw [hfMem.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    norm_num [If]
  change eLpNorm u (ENNReal.ofReal 2) localSmoothingMeasure ≤
    ENNReal.ofReal 2 * eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal 2) volume
  norm_num
  rw [hNormu, hNormf]
  calc
    ENNReal.ofReal (Iu ^ (2 : Real)⁻¹) ≤
        ENNReal.ofReal (2 * If ^ (2 : Real)⁻¹) := ENNReal.ofReal_le_ofReal hroot
    _ = ENNReal.ofReal (2 : Real) * ENNReal.ofReal (If ^ (2 : Real)⁻¹) := by
      rw [ENNReal.ofReal_mul (by norm_num)]
    _ ≤ 2 * ENNReal.ofReal (If ^ (2 : Real)⁻¹) := by norm_num

/-- A positive local-smoothing gain for the planar half-wave at exponent `p`.

This is the precise form required by the Bourgain reduction.  It is only a
definition here; proving it is the geometric Mockenhaupt--Seeger--Sogge part
of this development. -/
def HasPositiveLocalSmoothingGain (χ : SchwartzMap (Euclidean 2) Complex)
    (p ρ : Real) : Prop :=
  2 < p ∧ 0 < ρ ∧ ∃ C : Real, 0 < C ∧
    ∀ j : Nat, 1 ≤ j → ∀ f : SchwartzMap (Euclidean 2) Complex,
      ∀ σ : WaveSign,
        eLpNorm (dyadicHalfWaveSpaceTime χ σ j f) (ENNReal.ofReal p)
            localSmoothingMeasure ≤
          ENNReal.ofReal (C * (2 : Real) ^
            ((j : Real) * (1 / 2 - 1 / p - ρ))) *
            eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume

/-- The MSS gain, in its piecewise form on the full real line.  The intended
range is `2 < p < ∞`. -/
def mssGain (p : Real) : Real :=
  if p ≤ 4 then (1 / 2) * (1 / 2 - 1 / p) else 1 / (2 * p)

/-- First branch of the MSS gain. -/
theorem mssGain_of_le_four {p : Real} (hp : p ≤ 4) :
    mssGain p = (1 / 2) * (1 / 2 - 1 / p) := by
  simp [mssGain, hp]

/-- Second branch of the MSS gain. -/
theorem mssGain_of_four_lt {p : Real} (hp : 4 < p) :
    mssGain p = 1 / (2 * p) := by
  simp [mssGain, not_le.mpr hp]

/-- The two formulas defining the MSS gain agree at `p = 4`. -/
theorem mssGain_four : mssGain 4 = 1 / 8 := by
  norm_num [mssGain]

/-- The MSS gain is positive throughout its intended range. -/
theorem mssGain_pos {p : Real} (hp : 2 < p) : 0 < mssGain p := by
  by_cases hfour : p ≤ 4
  · rw [mssGain_of_le_four hfour]
    have hp0 : 0 < p := lt_trans (by norm_num) hp
    have hrecip : 1 / p < 1 / 2 := by
      rw [div_lt_div_iff₀ hp0 (by norm_num : (0 : Real) < 2)]
      simpa using hp
    positivity
  · rw [mssGain, if_neg hfour]
    have hp0 : 0 < p := lt_trans (by norm_num) hp
    positivity

/-- The exact continuous local-smoothing assertion in the introductory MSS
theorem.  It is packaged as a proposition so that the geometric proof and
the later Bourgain reduction have a common, normalization-sensitive target. -/
def localSmoothing (χ : SchwartzMap (Euclidean 2) Complex)
    (p η : Real) : Prop :=
  2 < p ∧ 0 < η ∧ ∃ C : Real, 0 < C ∧
    ∀ j : Nat, 1 ≤ j → ∀ f : SchwartzMap (Euclidean 2) Complex,
      ∀ σ : WaveSign,
        eLpNorm (dyadicHalfWaveSpaceTime χ σ j f) (ENNReal.ofReal p)
            localSmoothingMeasure ≤
          ENNReal.ofReal (C * (2 : Real) ^
            ((j : Real) * (1 / 2 - 1 / p - mssGain p + η))) *
            eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume

/-- The `p = 4` endpoint form of the MSS local-smoothing theorem.  At this
exponent `mssGain_four` turns the power in `localSmoothing` into
`1 / 8 + η`, exactly as in the blueprint. -/
def p4LocalSmoothing (χ : SchwartzMap (Euclidean 2) Complex) : Prop :=
  ∀ η : Real, 0 < η → localSmoothing χ 4 η

/-- The positive-gain form required by the circular-maximal reduction is an
immediate algebraic consequence of the exact local-smoothing statement once
the permitted loss is smaller than the MSS gain. -/
theorem localSmoothing_to_hasPositiveLocalSmoothingGain
    {χ : SchwartzMap (Euclidean 2) Complex} {p η : Real}
    (hlocal : localSmoothing χ p η) (hη : η < mssGain p) :
    HasPositiveLocalSmoothingGain χ p (mssGain p - η) := by
  rcases hlocal with ⟨hp, hηpos, C, hC, hbound⟩
  refine ⟨hp, sub_pos.mpr hη, C, hC, ?_⟩
  intro j hj f σ
  have hexponent :
      (j : Real) * (1 / 2 - 1 / p - (mssGain p - η)) =
        (j : Real) * (1 / 2 - 1 / p - mssGain p + η) := by
    ring
  rw [hexponent]
  exact hbound j hj f σ

/-- The conditional `p = 4` MSS endpoint supplies every smaller positive
gain needed by the Bourgain reduction. -/
theorem p4LocalSmoothing_to_hasPositiveLocalSmoothingGain
    {χ : SchwartzMap (Euclidean 2) Complex} (hlocal : p4LocalSmoothing χ)
    {ρ : Real} (hρ : 0 < ρ) (hρlt : ρ < (1 / 8 : Real)) :
    HasPositiveLocalSmoothingGain χ 4 ρ := by
  let η : Real := (1 / 8 : Real) - ρ
  have hη : 0 < η := by
    dsimp only [η]
    linarith
  have hηlt : η < mssGain 4 := by
    rw [mssGain_four]
    dsimp only [η]
    linarith
  have hgain := localSmoothing_to_hasPositiveLocalSmoothingGain
    (hlocal η hη) hηlt
  have heq : mssGain 4 - η = ρ := by
    rw [mssGain_four]
    dsimp only [η]
    ring
  rw [heq] at hgain
  exact hgain

/-- The time mesh used in the discretized MSS statement. -/
def dyadicTimeScale (j : Nat) : Real := (2 : Real) ^ (-(j : Int))

/-- A finite maximal `2^{-j}`-separated subset of the time interval `[1,2]`.
The covering clause is the finite-set form of maximality: every point in the
interval lies strictly within one mesh width of a selected time. -/
def MaximalSeparated (j : Nat) (T : Finset Real) : Prop :=
  (∀ t ∈ T, t ∈ Icc (1 : Real) 2) ∧
  (∀ ⦃s⦄, s ∈ T → ∀ ⦃t⦄, t ∈ T → s ≠ t →
    dyadicTimeScale j ≤ |s - t|) ∧
  ∀ t ∈ Icc (1 : Real) 2, ∃ s ∈ T, |t - s| < dyadicTimeScale j

/-- The exact discretized full-time local-smoothing assertion from the
introductory blueprint.  `ENNReal` powers encode the outer `ℓ^p` norm without
introducing an artificial finiteness hypothesis on individual norms. -/
def discreteLocalSmoothing (χ : SchwartzMap (Euclidean 2) Complex)
    (p η : Real) : Prop :=
  2 < p ∧ 0 < η ∧ ∃ C : Real, 0 < C ∧
    ∀ j : Nat, 1 ≤ j → ∀ T : Finset Real, MaximalSeparated j T →
      ∀ f : SchwartzMap (Euclidean 2) Complex, ∀ σ : WaveSign,
        (∑ t ∈ T,
          (eLpNorm (dyadicHalfWave χ σ j t f) (ENNReal.ofReal p) volume) ^ p) ^
            (p⁻¹) ≤
          ENNReal.ofReal (C * (2 : Real) ^
            ((j : Real) * (1 / 2 - mssGain p + η))) *
            eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume

/-- The physical space--time used for the constant-coefficient wave equation. -/
abbrev WaveSpaceTime := Euclidean 2 × Real

/-- Space--time Fourier transform in Mathlib's unitary `2π` convention.
It is written as the iterated spatial and temporal transforms, so it uses
the existing Fourier APIs directly on `Euclidean 2` and `Real`. -/
noncomputable def spaceTimeFourier (G : WaveSpaceTime → Complex) :
    WaveSpaceTime → Complex :=
  fun ζ => 𝓕 (fun t : Real => 𝓕 (fun x : Euclidean 2 => G (x, t)) ζ.1) ζ.2

/-- Inverse space--time Fourier transform in the same convention, again
written as an iterated transform. -/
noncomputable def spaceTimeFourierInv (G : WaveSpaceTime → Complex) :
    WaveSpaceTime → Complex :=
  fun z => 𝓕⁻ (fun τ : Real => 𝓕⁻ (fun η : Euclidean 2 => G (η, τ)) z.1) z.2

/-- The Hilbert coordinate model for genuinely joint Schwartz space--time
data.  The raw product `WaveSpaceTime` does not itself carry the joint inner
product structure needed by `SchwartzMap`; `WithLp 2` supplies that structure
without changing the underlying product coordinates. -/
abbrev JointWaveSpaceTime := WithLp 2 WaveSpaceTime

private theorem aux_joint_norm_le_coordinate_sum (z : JointWaveSpaceTime) :
    ‖z‖ ≤ ‖z.fst‖ + ‖z.snd‖ := by
  have hz : z = WithLp.idemFst z + WithLp.idemSnd z := by
    have hz' := DFunLike.congr_fun
      (WithLp.idemFst_add_idemSnd (p := 2) (α := Euclidean 2) (β := Real)) z
    change WithLp.idemFst z + WithLp.idemSnd z = z at hz'
    exact hz'.symm
  calc
    ‖z‖ = ‖WithLp.idemFst z + WithLp.idemSnd z‖ := congrArg norm hz
    _ ≤ ‖WithLp.idemFst z‖ + ‖WithLp.idemSnd z‖ :=
      norm_add_le _ _
    _ = ‖z.fst‖ + ‖z.snd‖ := by
      simp only [WithLp.idemFst_apply, WithLp.idemSnd_apply,
        WithLp.norm_toLp_fst, WithLp.norm_toLp_snd]

private theorem aux_joint_one_add_norm_pow_le
    (k : Nat) (z : JointWaveSpaceTime) :
    (1 + ‖z‖) ^ k ≤ (1 + ‖z.fst‖) ^ k * (1 + ‖z.snd‖) ^ k := by
  have hbase : 1 + ‖z‖ ≤ (1 + ‖z.fst‖) * (1 + ‖z.snd‖) := by
    calc
      1 + ‖z‖ ≤ 1 + (‖z.fst‖ + ‖z.snd‖) := by
        gcongr
        exact aux_joint_norm_le_coordinate_sum z
      _ ≤ (1 + ‖z.fst‖) * (1 + ‖z.snd‖) := by
        nlinarith [mul_nonneg (norm_nonneg z.fst) (norm_nonneg z.snd)]
  calc
    (1 + ‖z‖) ^ k ≤ ((1 + ‖z.fst‖) * (1 + ‖z.snd‖)) ^ k := by
      gcongr
    _ = (1 + ‖z.fst‖) ^ k * (1 + ‖z.snd‖) ^ k := mul_pow _ _ _

private theorem aux_joint_norm_pow_le_coordinate_weights
    (k : Nat) (z : JointWaveSpaceTime) :
    ‖z‖ ^ k ≤ (1 + ‖z.fst‖) ^ k * (1 + ‖z.snd‖) ^ k := by
  calc
    ‖z‖ ^ k ≤ (1 + ‖z‖) ^ k :=
      pow_le_pow_left₀ (norm_nonneg _) (by linarith [norm_nonneg z]) _
    _ ≤ (1 + ‖z.fst‖) ^ k * (1 + ‖z.snd‖) ^ k :=
      aux_joint_one_add_norm_pow_le k z

private theorem aux_joint_fstL_norm_le_one :
    ‖WithLp.fstL 2 Real (Euclidean 2) Real‖ ≤ 1 := by
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
  intro z
  simpa using WithLp.norm_fst_le (p := 2) (Euclidean 2) z

private theorem aux_joint_sndL_norm_le_one :
    ‖WithLp.sndL 2 Real (Euclidean 2) Real‖ ≤ 1 := by
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
  intro z
  simpa using WithLp.norm_snd_le (p := 2) (Euclidean 2) z

private theorem aux_iteratedFDeriv_joint_fst_le
    (B : SchwartzMap (Euclidean 2) Complex)
    (n : Nat) (z : JointWaveSpaceTime) :
    ‖iteratedFDeriv Real n
        (fun w : JointWaveSpaceTime => B (WithLp.fstL 2 Real (Euclidean 2) Real w)) z‖ ≤
      ‖iteratedFDeriv Real n B z.fst‖ := by
  let L : JointWaveSpaceTime →L[Real] Euclidean 2 :=
    WithLp.fstL 2 Real (Euclidean 2) Real
  change ‖iteratedFDeriv Real n (B ∘ L) z‖ ≤
    ‖iteratedFDeriv Real n B (L z)‖
  rw [L.iteratedFDeriv_comp_right (B.smooth (⊤ : ℕ∞)) z (by exact_mod_cast le_top)]
  calc
    ‖(iteratedFDeriv Real n B (L z)).compContinuousLinearMap (fun _ => L)‖ ≤
        ‖iteratedFDeriv Real n B (L z)‖ * ∏ _ : Fin n, ‖L‖ :=
      ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv Real n B (L z)‖ * ∏ _ : Fin n, (1 : Real) := by
      gcongr
      exact aux_joint_fstL_norm_le_one
    _ = ‖iteratedFDeriv Real n B (L z)‖ := by simp

private theorem aux_iteratedFDeriv_joint_snd_le
    (h : SchwartzMap Real Complex)
    (n : Nat) (z : JointWaveSpaceTime) :
    ‖iteratedFDeriv Real n
        (fun w : JointWaveSpaceTime => h (WithLp.sndL 2 Real (Euclidean 2) Real w)) z‖ ≤
      ‖iteratedFDeriv Real n h z.snd‖ := by
  let L : JointWaveSpaceTime →L[Real] Real :=
    WithLp.sndL 2 Real (Euclidean 2) Real
  change ‖iteratedFDeriv Real n (h ∘ L) z‖ ≤
    ‖iteratedFDeriv Real n h (L z)‖
  rw [L.iteratedFDeriv_comp_right (h.smooth (⊤ : ℕ∞)) z (by exact_mod_cast le_top)]
  calc
    ‖(iteratedFDeriv Real n h (L z)).compContinuousLinearMap (fun _ => L)‖ ≤
        ‖iteratedFDeriv Real n h (L z)‖ * ∏ _ : Fin n, ‖L‖ :=
      ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv Real n h (L z)‖ * ∏ _ : Fin n, (1 : Real) := by
      gcongr
      exact aux_joint_sndL_norm_le_one
    _ = ‖iteratedFDeriv Real n h (L z)‖ := by simp

private theorem aux_weighted_iteratedFDeriv_joint_fst_le
    (B : SchwartzMap (Euclidean 2) Complex)
    (k n : Nat) (z : JointWaveSpaceTime) :
    (1 + ‖z.fst‖) ^ k *
        ‖iteratedFDeriv Real n
          (fun w : JointWaveSpaceTime => B (WithLp.fstL 2 Real (Euclidean 2) Real w)) z‖ ≤
      2 ^ k * ((Finset.Iic (k, n)).sup fun m =>
        SchwartzMap.seminorm Complex m.1 m.2) B := by
  calc
    (1 + ‖z.fst‖) ^ k *
        ‖iteratedFDeriv Real n
          (fun w : JointWaveSpaceTime => B (WithLp.fstL 2 Real (Euclidean 2) Real w)) z‖ ≤
        (1 + ‖z.fst‖) ^ k * ‖iteratedFDeriv Real n B z.fst‖ := by
      gcongr
      exact aux_iteratedFDeriv_joint_fst_le B n z
    _ ≤ 2 ^ k * ((Finset.Iic (k, n)).sup fun m =>
        SchwartzMap.seminorm Complex m.1 m.2) B :=
      SchwartzMap.one_add_le_sup_seminorm_apply (m := (k, n)) (k := k) (n := n)
        (le_refl _) (le_refl _) B z.fst

private theorem aux_weighted_iteratedFDeriv_joint_snd_le
    (h : SchwartzMap Real Complex)
    (k n : Nat) (z : JointWaveSpaceTime) :
    (1 + ‖z.snd‖) ^ k *
        ‖iteratedFDeriv Real n
          (fun w : JointWaveSpaceTime => h (WithLp.sndL 2 Real (Euclidean 2) Real w)) z‖ ≤
      2 ^ k * ((Finset.Iic (k, n)).sup fun m =>
        SchwartzMap.seminorm Complex m.1 m.2) h := by
  calc
    (1 + ‖z.snd‖) ^ k *
        ‖iteratedFDeriv Real n
          (fun w : JointWaveSpaceTime => h (WithLp.sndL 2 Real (Euclidean 2) Real w)) z‖ ≤
        (1 + ‖z.snd‖) ^ k * ‖iteratedFDeriv Real n h z.snd‖ := by
      gcongr
      exact aux_iteratedFDeriv_joint_snd_le h n z
    _ ≤ 2 ^ k * ((Finset.Iic (k, n)).sup fun m =>
        SchwartzMap.seminorm Complex m.1 m.2) h :=
      SchwartzMap.one_add_le_sup_seminorm_apply (m := (k, n)) (k := k) (n := n)
        (le_refl _) (le_refl _) h z.snd

/-- The joint Schwartz external product of a planar spectral profile and a temporal profile.
Its raw `WaveSpaceTime` representative is the literal product of the two coordinate functions. -/
noncomputable def jointSchwartzExternalProduct
    (B : SchwartzMap (Euclidean 2) Complex)
    (h : SchwartzMap Real Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  { toFun := fun z =>
      B (WithLp.fstL 2 Real (Euclidean 2) Real z) *
        h (WithLp.sndL 2 Real (Euclidean 2) Real z)
    smooth' := by
      fun_prop
    decay' := by
      intro k n
      let b : JointWaveSpaceTime → Complex := fun w =>
        B (WithLp.fstL 2 Real (Euclidean 2) Real w)
      let c : JointWaveSpaceTime → Complex := fun w =>
        h (WithLp.sndL 2 Real (Euclidean 2) Real w)
      have hb := by
        simpa only [b] using
          (B.smooth ⊤).comp_continuousLinearMap
            (g := WithLp.fstL 2 Real (Euclidean 2) Real)
      have hc := by
        simpa only [c] using
          (h.smooth ⊤).comp_continuousLinearMap
            (g := WithLp.sndL 2 Real (Euclidean 2) Real)
      let C : Real := ∑ i ∈ Finset.range (n + 1),
        (n.choose i : Real) *
          (2 ^ k * ((Finset.Iic (k, i)).sup fun m =>
            SchwartzMap.seminorm Complex m.1 m.2) B) *
          (2 ^ k * ((Finset.Iic (k, n - i)).sup fun m =>
            SchwartzMap.seminorm Complex m.1 m.2) h)
      refine ⟨C, fun z => ?_⟩
      change ‖z‖ ^ k * ‖iteratedFDeriv Real n (fun w : JointWaveSpaceTime => b w * c w) z‖ ≤ C
      calc
        ‖z‖ ^ k * ‖iteratedFDeriv Real n (fun w : JointWaveSpaceTime => b w * c w) z‖ ≤
            ‖z‖ ^ k * ∑ i ∈ Finset.range (n + 1),
              (n.choose i : Real) * ‖iteratedFDeriv Real i b z‖ *
                ‖iteratedFDeriv Real (n - i) c z‖ := by
          gcongr
          exact norm_iteratedFDeriv_mul_le hb hc z (by exact_mod_cast le_top)
        _ = ∑ i ∈ Finset.range (n + 1),
            ‖z‖ ^ k * ((n.choose i : Real) * ‖iteratedFDeriv Real i b z‖ *
              ‖iteratedFDeriv Real (n - i) c z‖) := by
          rw [Finset.mul_sum]
        _ ≤ C := by
          dsimp only [C]
          apply Finset.sum_le_sum
          intro i hi
          have hprod :
              ‖z‖ ^ k * ‖iteratedFDeriv Real i b z‖ *
                  ‖iteratedFDeriv Real (n - i) c z‖ ≤
                (2 ^ k * ((Finset.Iic (k, i)).sup fun m =>
                  SchwartzMap.seminorm Complex m.1 m.2) B) *
                (2 ^ k * ((Finset.Iic (k, n - i)).sup fun m =>
                  SchwartzMap.seminorm Complex m.1 m.2) h) := by
            calc
              ‖z‖ ^ k * ‖iteratedFDeriv Real i b z‖ *
                    ‖iteratedFDeriv Real (n - i) c z‖ ≤
                  ((1 + ‖z.fst‖) ^ k * (1 + ‖z.snd‖) ^ k) *
                    ‖iteratedFDeriv Real i b z‖ *
                    ‖iteratedFDeriv Real (n - i) c z‖ := by
                gcongr
                exact aux_joint_norm_pow_le_coordinate_weights k z
              _ = ((1 + ‖z.fst‖) ^ k * ‖iteratedFDeriv Real i b z‖) *
                  ((1 + ‖z.snd‖) ^ k * ‖iteratedFDeriv Real (n - i) c z‖) := by
                ring
              _ ≤ _ := by
                apply mul_le_mul
                · simpa only [b] using aux_weighted_iteratedFDeriv_joint_fst_le B k i z
                · simpa only [c] using aux_weighted_iteratedFDeriv_joint_snd_le h k (n - i) z
                · positivity
                · positivity
          calc
            ‖z‖ ^ k * ((n.choose i : Real) * ‖iteratedFDeriv Real i b z‖ *
                ‖iteratedFDeriv Real (n - i) c z‖) =
                (n.choose i : Real) *
                  (‖z‖ ^ k * ‖iteratedFDeriv Real i b z‖ *
                    ‖iteratedFDeriv Real (n - i) c z‖) := by
              ring
            _ ≤ (n.choose i : Real) *
                ((2 ^ k * ((Finset.Iic (k, i)).sup fun m =>
                  SchwartzMap.seminorm Complex m.1 m.2) B) *
                (2 ^ k * ((Finset.Iic (k, n - i)).sup fun m =>
                  SchwartzMap.seminorm Complex m.1 m.2) h)) := by
              gcongr
            _ = _ := by ring }

/-- The raw-coordinate formula for `jointSchwartzExternalProduct`. -/
theorem jointSchwartzExternalProduct_apply
    (B : SchwartzMap (Euclidean 2) Complex)
    (h : SchwartzMap Real Complex)
    (z : WaveSpaceTime) :
    jointSchwartzExternalProduct B h (WithLp.toLp 2 z) = B z.1 * h z.2 := by
  change B ((WithLp.toLp 2 z).fst) * h ((WithLp.toLp 2 z).snd) = B z.1 * h z.2
  simp

private theorem aux_smoothAnnularNormExtension_eventuallyEq_zero_at_zero
    (u : SchwartzMap (Euclidean 2) Real)
    (ε : Real) (hε : 0 < ε)
    (hzero : ∀ x : Euclidean 2, ‖x‖ < ε → u x = 0) :
    (fun x : Euclidean 2 => u x * ‖x‖) =ᶠ[𝓝 0] fun _ => 0 := by
  filter_upwards [Metric.ball_mem_nhds (0 : Euclidean 2) hε] with x hx
  change dist x 0 < ε at hx
  rw [dist_zero_right] at hx
  simp [hzero x hx]

private theorem aux_contDiff_smoothAnnularNormExtension
    (u : SchwartzMap (Euclidean 2) Real)
    (ε : Real) (hε : 0 < ε)
    (hzero : ∀ x : Euclidean 2, ‖x‖ < ε → u x = 0) :
    ContDiff Real (⊤ : ℕ∞) (fun x : Euclidean 2 => u x * ‖x‖) := by
  rw [contDiff_iff_contDiffAt]
  intro x
  by_cases hx : x = 0
  · subst x
    exact (contDiffAt_const (c := (0 : Real))).congr_of_eventuallyEq
      (aux_smoothAnnularNormExtension_eventuallyEq_zero_at_zero u ε hε hzero)
  · exact ((u.smooth (⊤ : ℕ∞)).contDiffAt).mul (contDiffAt_norm Real hx)

/-- A compactly supported Schwartz cutoff that vanishes near the origin can be
multiplied by the radial norm while remaining Schwartz. -/
noncomputable def smoothAnnularNormExtension
    (u : SchwartzMap (Euclidean 2) Real)
    (hucompact : HasCompactSupport (u : Euclidean 2 → Real))
    (ε : Real) (hε : 0 < ε)
    (hzero : ∀ x : Euclidean 2, ‖x‖ < ε → u x = 0) :
    SchwartzMap (Euclidean 2) Real :=
  (hucompact.mul_right).toSchwartzMap
    (aux_contDiff_smoothAnnularNormExtension u ε hε hzero)

/-- The literal evaluation formula for `smoothAnnularNormExtension`. -/
theorem smoothAnnularNormExtension_apply
    (u : SchwartzMap (Euclidean 2) Real)
    (hucompact : HasCompactSupport (u : Euclidean 2 → Real))
    (ε : Real) (hε : 0 < ε)
    (hzero : ∀ x : Euclidean 2, ‖x‖ < ε → u x = 0)
    (x : Euclidean 2) :
    smoothAnnularNormExtension u hucompact ε hε hzero x = u x * ‖x‖ := by
  rfl

/-- On a point where the cutoff is one, the annular extension is the radial norm. -/
theorem smoothAnnularNormExtension_eq_norm_of_eq_one
    (u : SchwartzMap (Euclidean 2) Real)
    (hucompact : HasCompactSupport (u : Euclidean 2 → Real))
    (ε : Real) (hε : 0 < ε)
    (hzero : ∀ x : Euclidean 2, ‖x‖ < ε → u x = 0)
    (x : Euclidean 2) (hx : u x = 1) :
    smoothAnnularNormExtension u hucompact ε hε hzero x = ‖x‖ := by
  rw [smoothAnnularNormExtension_apply, hx, one_mul]

/-- If an annular cutoff equals one on a planar Schwartz profile's frequency support,
its norm extension agrees there with the radial norm. -/
theorem smoothAnnularNormExtension_eq_norm_on_support
    (u : SchwartzMap (Euclidean 2) Real)
    (hucompact : HasCompactSupport (u : Euclidean 2 → Real))
    (ε : Real) (hε : 0 < ε)
    (hzero : ∀ x : Euclidean 2, ‖x‖ < ε → u x = 0)
    (B : SchwartzMap (Euclidean 2) Complex)
    (hone : ∀ x ∈ Function.support (B : Euclidean 2 → Complex), u x = 1) :
    ∀ x ∈ Function.support (B : Euclidean 2 → Complex),
      smoothAnnularNormExtension u hucompact ε hε hzero x = ‖x‖ := by
  intro x hx
  exact smoothAnnularNormExtension_eq_norm_of_eq_one u hucompact ε hε hzero x (hone x hx)

private noncomputable def jointSchwartzSndEmbedding :
    Real →L[Real] JointWaveSpaceTime :=
  (WithLp.prodContinuousLinearEquiv 2 Real (Euclidean 2) Real).symm.toContinuousLinearMap.comp
    (ContinuousLinearMap.inr Real (Euclidean 2) Real)

/-- The spectral shear which translates the temporal frequency by a smooth radial profile. -/
private noncomputable def jointRadialShear
    (rho : SchwartzMap (Euclidean 2) Real) :
    JointWaveSpaceTime → JointWaveSpaceTime :=
  fun z => z - jointSchwartzSndEmbedding (rho z.fst)

private theorem jointRadialShear_apply
    (rho : SchwartzMap (Euclidean 2) Real) (z : JointWaveSpaceTime) :
    jointRadialShear rho z =
      WithLp.toLp 2 (z.fst, z.snd - rho z.fst) := by
  apply (WithLp.ext_iff 2).2
  change WithLp.ofLp z - (0, rho z.fst) =
    (z.fst, z.snd - rho z.fst)
  apply Prod.ext <;> simp

private theorem jointRadialShear_hasTemperateGrowth
    (rho : SchwartzMap (Euclidean 2) Real) :
    (jointRadialShear rho).HasTemperateGrowth := by
  let L : JointWaveSpaceTime →L[Real] Euclidean 2 :=
    WithLp.fstL 2 Real (Euclidean 2) Real
  let e : Real →L[Real] JointWaveSpaceTime := jointSchwartzSndEmbedding
  have hρ : (rho ∘ L).HasTemperateGrowth :=
    rho.hasTemperateGrowth.comp L.hasTemperateGrowth
  have hρ' : (fun z : JointWaveSpaceTime => rho z.fst).HasTemperateGrowth := by
    change (fun z : JointWaveSpaceTime => rho (L z)).HasTemperateGrowth at hρ
    change (fun z : JointWaveSpaceTime => rho (L z)).HasTemperateGrowth
    exact hρ
  have he : (e : Real → JointWaveSpaceTime).HasTemperateGrowth :=
    e.hasTemperateGrowth
  have heρ : (fun z : JointWaveSpaceTime => e (rho z.fst)).HasTemperateGrowth := by
    change (e ∘ fun z : JointWaveSpaceTime => rho z.fst).HasTemperateGrowth
    exact he.comp hρ'
  have hid : (fun z : JointWaveSpaceTime => z).HasTemperateGrowth :=
    Function.HasTemperateGrowth.id'
  change (fun z : JointWaveSpaceTime =>
    z - jointSchwartzSndEmbedding (rho z.fst)).HasTemperateGrowth
  have hfun :
      (fun z : JointWaveSpaceTime => z) -
          (fun z : JointWaveSpaceTime => jointSchwartzSndEmbedding (rho z.fst)) =
        fun z : JointWaveSpaceTime => z - jointSchwartzSndEmbedding (rho z.fst) := by
    ext z
    rfl
  rw [← hfun]
  simpa only [e] using hid.sub heρ

private theorem jointRadialShear_proper
    (rho : SchwartzMap (Euclidean 2) Real) :
    ∃ (k : Nat) (C : Real), ∀ z : JointWaveSpaceTime,
      ‖z‖ ≤ C * (1 + ‖jointRadialShear rho z‖) ^ k := by
  rcases rho.decay 0 0 with ⟨C, hCpos, hC⟩
  refine ⟨1, 2 + C, fun z => ?_⟩
  have hρ : ‖rho z.fst‖ ≤ C := by
    simpa using hC z.fst
  have hfst : (jointRadialShear rho z).fst = z.fst := by
    rw [jointRadialShear_apply]
    simp
  have hsnd : (jointRadialShear rho z).snd = z.snd - rho z.fst := by
    rw [jointRadialShear_apply]
    simp
  have hsnd' : z.snd = (jointRadialShear rho z).snd + rho z.fst := by
    rw [hsnd]
    ring
  calc
    ‖z‖ ≤ ‖z.fst‖ + ‖z.snd‖ := aux_joint_norm_le_coordinate_sum z
    _ = ‖(jointRadialShear rho z).fst‖ +
          ‖(jointRadialShear rho z).snd + rho z.fst‖ := by rw [hfst, hsnd']
    _ ≤ ‖(jointRadialShear rho z).fst‖ +
          (‖(jointRadialShear rho z).snd‖ + ‖rho z.fst‖) := by
      gcongr
      exact norm_add_le _ _
    _ ≤ ‖jointRadialShear rho z‖ + (‖jointRadialShear rho z‖ + C) := by
      exact add_le_add
        (WithLp.norm_fst_le (p := 2) (Euclidean 2) _)
        (add_le_add (WithLp.norm_snd_le (p := 2) (Euclidean 2) _) hρ)
    _ ≤ (2 + C) * (1 + ‖jointRadialShear rho z‖) ^ 1 := by
      rw [pow_one]
      nlinarith [norm_nonneg (jointRadialShear rho z)]

/-- Precompose a joint Schwartz spectral profile with the smooth radial shear
`(ξ, τ) ↦ (ξ, τ - rho ξ)`.  This is a spectral Schwartz construction only. -/
noncomputable def jointSchwartzPrecompRadialShear
    (rho : SchwartzMap (Euclidean 2) Real)
    (Q : SchwartzMap JointWaveSpaceTime Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  SchwartzMap.compCLM Complex (jointRadialShear_hasTemperateGrowth rho)
    (jointRadialShear_proper rho) Q

/-- The raw product-coordinate formula for `jointSchwartzPrecompRadialShear`. -/
theorem jointSchwartzPrecompRadialShear_apply
    (rho : SchwartzMap (Euclidean 2) Real)
    (Q : SchwartzMap JointWaveSpaceTime Complex)
    (z : WaveSpaceTime) :
    jointSchwartzPrecompRadialShear rho Q (WithLp.toLp 2 z) =
      Q (WithLp.toLp 2 (z.1, z.2 - rho z.1)) := by
  change (Q ∘ jointRadialShear rho) (WithLp.toLp 2 z) =
    Q (WithLp.toLp 2 (z.1, z.2 - rho z.1))
  rw [Function.comp_apply, jointRadialShear_apply]
  simp

/-- The joint spectral profile obtained by applying the smooth radial shear
to a planar-frequency and temporal-Schwartz external product. -/
noncomputable def jointSchwartzModulatedAnnularProfile
    (B : SchwartzMap (Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    SchwartzMap JointWaveSpaceTime Complex :=
  jointSchwartzPrecompRadialShear rho
    (jointSchwartzExternalProduct B (FourierTransform.fourier vartheta))

/-- The raw product-coordinate formula for the modulated annular profile. -/
theorem jointSchwartzModulatedAnnularProfile_apply
    (B : SchwartzMap (Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (z : WaveSpaceTime) :
    jointSchwartzModulatedAnnularProfile B vartheta rho (WithLp.toLp 2 z) =
      B z.1 * FourierTransform.fourier (vartheta : Real → Complex) (z.2 - rho z.1) := by
  unfold jointSchwartzModulatedAnnularProfile
  rw [jointSchwartzPrecompRadialShear_apply, jointSchwartzExternalProduct_apply]
  simp only [SchwartzMap.fourier_coe]

/-- If the radial profile agrees with the norm on the planar profile support,
the modulated annular profile has the literal norm phase there. -/
theorem jointSchwartzModulatedAnnularProfile_eq_norm_on_support
    (B : SchwartzMap (Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hrho : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), rho xi = ‖xi‖)
    (z : WaveSpaceTime) (hz : z.1 ∈ Function.support (B : Euclidean 2 → Complex)) :
    jointSchwartzModulatedAnnularProfile B vartheta rho (WithLp.toLp 2 z) =
      B z.1 * FourierTransform.fourier (vartheta : Real → Complex) (z.2 - ‖z.1‖) := by
  rw [jointSchwartzModulatedAnnularProfile_apply, hrho z.1 hz]

/-- The physical-coordinate representative of a joint Schwartz function.
This is deliberately a spectral/Schwartz construction, rather than an
assertion about a compact physical-time cutoff. -/
noncomputable def jointSchwartzRaw
    (G : SchwartzMap JointWaveSpaceTime Complex) : WaveSpaceTime → Complex :=
  fun z => G (WithLp.toLp 2 z)

/-- The `WithLp` product coordinate map is volume preserving for the global
Haar/Borel measure selected by the joint Fourier transform.  The explicit
argument through Borel measurability avoids identifying that measure structure
definitionally with `WithLp.measurableSpace`. -/
private theorem aux_jointWaveSpaceTime_volumePreserving_toLp :
    MeasurePreserving
      (WithLp.toLp 2 : Euclidean 2 × Real → JointWaveSpaceTime)
      (volume.prod volume) volume := by
  let μ : Measure JointWaveSpaceTime := volume
  have hmeas : Measurable
      (WithLp.toLp 2 : Euclidean 2 × Real → JointWaveSpaceTime) :=
    WithLp.measurable_toLp 2 (Euclidean 2 × Real)
  refine ⟨hmeas, ?_⟩
  ext s hs
  rw [Measure.map_apply hmeas hs]
  have hsBorel : @MeasurableSet JointWaveSpaceTime
      (borel JointWaveSpaceTime) s := by
    rwa [← BorelSpace.measurable_eq (α := JointWaveSpaceTime)]
  have hmeasure :
      (volume.prod volume)
          ((WithLp.toLp 2 : Euclidean 2 × Real → JointWaveSpaceTime) ⁻¹' s) =
        μ s := by
    letI : MeasurableSpace JointWaveSpaceTime :=
      WithLp.measurableSpace 2 (Euclidean 2 × Real)
    letI : BorelSpace JointWaveSpaceTime :=
      WithLp.borelSpace 2 (Euclidean 2) Real
    letI : MeasureSpace JointWaveSpaceTime := { volume := μ }
    have hs' : MeasurableSet s := by
      rwa [BorelSpace.measurable_eq (α := JointWaveSpaceTime)]
    have hpres := WithLp.volume_preserving_toLp (Euclidean 2) Real
    calc
      (volume.prod volume)
          ((WithLp.toLp 2 : Euclidean 2 × Real → JointWaveSpaceTime) ⁻¹' s) =
          Measure.map (WithLp.toLp 2 : Euclidean 2 × Real → JointWaveSpaceTime)
            (volume.prod volume) s :=
        (Measure.map_apply (WithLp.measurable_toLp 2 (Euclidean 2 × Real)) hs').symm
      _ = μ s := by
        simpa only [Measure.volume_eq_prod] using
          congrArg (fun ν : Measure JointWaveSpaceTime => ν s) hpres.map_eq
  exact hmeasure

/-- Rewrite the joint Fourier integral in the product coordinates used by
`spaceTimeFourier`. -/
private theorem aux_integral_jointSchwartz_to_product
    (G : SchwartzMap JointWaveSpaceTime Complex) (ζ : WaveSpaceTime) :
    (integral volume (fun v : JointWaveSpaceTime =>
      Real.fourierChar (-inner Real v (WithLp.toLp 2 ζ)) • G v)) =
    (integral volume (fun p : WaveSpaceTime =>
      Real.fourierChar (-inner Real (WithLp.toLp 2 p) (WithLp.toLp 2 ζ)) •
        G (WithLp.toLp 2 p))) := by
  have hpres : MeasurePreserving
      (MeasurableEquiv.toLp 2 WaveSpaceTime) volume volume :=
    WithLp.volume_preserving_toLp (Euclidean 2) Real
  let φ : JointWaveSpaceTime → Complex := fun v =>
    Real.fourierChar (-inner Real v (WithLp.toLp 2 ζ)) • G v
  have htransport :
      integral volume (fun p : WaveSpaceTime =>
        φ (MeasurableEquiv.toLp 2 WaveSpaceTime p)) =
      integral volume φ :=
    hpres.integral_comp' φ
  simpa only [φ, MeasurableEquiv.coe_toLp] using htransport.symm

/-- The joint `WithLp` Fourier character splits into its spatial and temporal
product factors. -/
private theorem aux_fourierChar_jointWaveSpaceTime_toLp_prod
    (x ξ : Euclidean 2) (t τ : Real) (c : Complex) :
    Real.fourierChar
        (-inner Real (WithLp.toLp 2 (x, t)) (WithLp.toLp 2 (ξ, τ))) • c =
      Real.fourierChar (-inner Real t τ) •
        (Real.fourierChar (-inner Real x ξ) • c) := by
  simp only [WithLp.prod_inner_apply]
  rw [neg_add, Real.fourierChar.map_add_eq_mul, mul_smul]
  rw [← mul_smul, ← mul_smul, mul_comm]

/-- The literal iterated space--time Fourier transform of a joint Schwartz
representative agrees with the canonical Fourier transform on the Hilbert
`WithLp` model. -/
theorem spaceTimeFourier_jointSchwartzRaw
    (G : SchwartzMap JointWaveSpaceTime Complex) (ζ : WaveSpaceTime) :
    spaceTimeFourier (jointSchwartzRaw G) ζ =
      FourierTransform.fourier (G : JointWaveSpaceTime → Complex)
        (WithLp.toLp 2 ζ) := by
  let K : Euclidean 2 → Real → Complex := fun x t =>
    Real.fourierChar (-inner Real t ζ.2) •
      (Real.fourierChar (-inner Real x ζ.1) •
        jointSchwartzRaw G (x, t))
  have hK : Integrable (Function.uncurry K) (volume.prod volume) := by
    have hpres := aux_jointWaveSpaceTime_volumePreserving_toLp
    have hraw : Integrable (fun p : Euclidean 2 × Real =>
        G (WithLp.toLp 2 p)) (volume.prod volume) :=
      (hpres.integrable_comp_emb
        (MeasurableEquiv.toLp 2 (Euclidean 2 × Real)).measurableEmbedding).mpr G.integrable
    refine hraw.congr' ?_ ?_
    · exact
        ((Real.continuous_fourierChar.comp (by fun_prop)).aestronglyMeasurable.smul
          ((Real.continuous_fourierChar.comp (by fun_prop)).aestronglyMeasurable.smul
            hraw.aestronglyMeasurable))
    filter_upwards with p
    simp only [K, Function.uncurry, jointSchwartzRaw, Circle.norm_smul]
  have hleft :
      spaceTimeFourier (jointSchwartzRaw G) ζ =
        ∫ t : Real, ∫ x : Euclidean 2, K x t := by
    unfold spaceTimeFourier
    rw [Real.fourier_eq]
    apply integral_congr_ae
    filter_upwards with t
    rw [Real.fourier_eq]
    change
      (↑(Real.fourierChar (-inner Real t ζ.2)) : Complex) •
          ∫ v : Euclidean 2,
            (↑(Real.fourierChar (-inner Real v ζ.1)) : Complex) •
              G (WithLp.toLp 2 (v, t)) =
        ∫ x : Euclidean 2,
          (↑(Real.fourierChar (-inner Real t ζ.2)) : Complex) •
            ((↑(Real.fourierChar (-inner Real x ζ.1)) : Complex) •
              G (WithLp.toLp 2 (x, t)))
    rw [← integral_smul]
  have hswap :
      (∫ t : Real, ∫ x : Euclidean 2, K x t) =
        ∫ x : Euclidean 2, ∫ t : Real, K x t :=
    integral_integral_swap hK.swap
  have hprod :
      (∫ x : Euclidean 2, ∫ t : Real, K x t) =
        ∫ p : WaveSpaceTime, K p.1 p.2 := by
    rw [Measure.volume_eq_prod]
    exact (integral_prod (Function.uncurry K) hK).symm
  have hfactor :
      (∫ p : WaveSpaceTime, K p.1 p.2) =
        ∫ p : WaveSpaceTime,
          Real.fourierChar
              (-inner Real (WithLp.toLp 2 p) (WithLp.toLp 2 ζ)) •
            G (WithLp.toLp 2 p) := by
    apply integral_congr_ae
    filter_upwards with p
    simpa only [K, jointSchwartzRaw] using
      (aux_fourierChar_jointWaveSpaceTime_toLp_prod p.1 ζ.1 p.2 ζ.2
        (G (WithLp.toLp 2 p))).symm
  calc
    spaceTimeFourier (jointSchwartzRaw G) ζ =
        ∫ t : Real, ∫ x : Euclidean 2, K x t := hleft
    _ = ∫ x : Euclidean 2, ∫ t : Real, K x t := hswap
    _ = ∫ p : WaveSpaceTime, K p.1 p.2 := hprod
    _ = ∫ p : WaveSpaceTime,
          Real.fourierChar
              (-inner Real (WithLp.toLp 2 p) (WithLp.toLp 2 ζ)) •
            G (WithLp.toLp 2 p) := hfactor
    _ = ∫ v : JointWaveSpaceTime,
          Real.fourierChar (-inner Real v (WithLp.toLp 2 ζ)) • G v :=
      (aux_integral_jointSchwartz_to_product G ζ).symm
    _ = FourierTransform.fourier (G : JointWaveSpaceTime → Complex)
          (WithLp.toLp 2 ζ) :=
      (Real.fourier_eq _ _).symm

private theorem aux_eLpNorm_two_fourier_jointSchwartz
    (G : SchwartzMap JointWaveSpaceTime Complex) :
    eLpNorm (FourierTransform.fourier (G : JointWaveSpaceTime → Complex)) 2 volume =
      eLpNorm (G : JointWaveSpaceTime → Complex) 2 volume := by
  calc
    eLpNorm (FourierTransform.fourier (G : JointWaveSpaceTime → Complex)) 2 volume =
        ‖(FourierTransform.fourier G).toLp 2 volume‖ₑ :=
      (Lp.enorm_toLp ((FourierTransform.fourier G).memLp 2 volume)).symm
    _ = ‖FourierTransform.fourier (G.toLp 2 volume)‖ₑ := by
      rw [SchwartzMap.toLp_fourier_eq]
    _ = ‖G.toLp 2 volume‖ₑ := by
      rw [enorm_eq_iff_norm_eq]
      exact Lp.norm_fourier_eq _
    _ = eLpNorm (G : JointWaveSpaceTime → Complex) 2 volume :=
      Lp.enorm_toLp (G.memLp 2 volume)

/-- The literal iterated Fourier transform preserves the `L²` seminorm of a
joint-Schwartz representative in product space--time coordinates. -/
theorem eLpNorm_spaceTimeFourier_jointSchwartzRaw_two_eq
    (G : SchwartzMap JointWaveSpaceTime Complex) :
    eLpNorm (spaceTimeFourier (jointSchwartzRaw G)) 2 volume =
      eLpNorm (jointSchwartzRaw G) 2 volume := by
  let e : WaveSpaceTime → JointWaveSpaceTime := WithLp.toLp 2
  have hpres : MeasurePreserving e volume volume := by
    simpa only [e] using
      (WithLp.volume_preserving_toLp (Euclidean 2) Real)
  calc
    eLpNorm (spaceTimeFourier (jointSchwartzRaw G)) 2 volume =
        eLpNorm ((FourierTransform.fourier (G : JointWaveSpaceTime → Complex)) ∘ e)
          2 volume := by
      apply eLpNorm_congr_ae
      filter_upwards with zeta
      simpa only [Function.comp_apply] using
        (spaceTimeFourier_jointSchwartzRaw G zeta)
    _ = eLpNorm (FourierTransform.fourier (G : JointWaveSpaceTime → Complex)) 2 volume :=
      eLpNorm_comp_measurePreserving
        ((FourierTransform.fourier G).memLp 2 volume).aestronglyMeasurable hpres
    _ = eLpNorm (G : JointWaveSpaceTime → Complex) 2 volume :=
      aux_eLpNorm_two_fourier_jointSchwartz G
    _ = eLpNorm (jointSchwartzRaw G) 2 volume := by
      symm
      exact eLpNorm_comp_measurePreserving (G.memLp 2 volume).aestronglyMeasurable hpres

/-- The iterated inverse transform is the iterated forward transform at the
negated frequency. -/
private theorem aux_spaceTimeFourierInv_eq_spaceTimeFourier_neg
    (H : WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    spaceTimeFourierInv H z = spaceTimeFourier H (-z) := by
  simp only [spaceTimeFourierInv, spaceTimeFourier,
    Real.fourierInv_eq_fourier_neg, Prod.fst_neg, Prod.snd_neg]

/-- The literal iterated inverse space--time Fourier transform of a joint
Schwartz representative agrees with canonical inverse Fourier transform on
the Hilbert `WithLp` model. -/
theorem spaceTimeFourierInv_jointSchwartzRaw
    (P : SchwartzMap JointWaveSpaceTime Complex) (z : WaveSpaceTime) :
    spaceTimeFourierInv (jointSchwartzRaw P) z =
      FourierTransform.fourierInv (P : JointWaveSpaceTime → Complex)
        (WithLp.toLp 2 z) := by
  calc
    spaceTimeFourierInv (jointSchwartzRaw P) z =
        spaceTimeFourier (jointSchwartzRaw P) (-z) :=
      aux_spaceTimeFourierInv_eq_spaceTimeFourier_neg _ _
    _ = FourierTransform.fourier (P : JointWaveSpaceTime → Complex)
          (WithLp.toLp 2 (-z)) :=
      spaceTimeFourier_jointSchwartzRaw P (-z)
    _ = FourierTransform.fourier (P : JointWaveSpaceTime → Complex)
          (-(WithLp.toLp 2 z)) := by simp
    _ = FourierTransform.fourierInv (P : JointWaveSpaceTime → Complex)
          (WithLp.toLp 2 z) :=
      (Real.fourierInv_eq_fourier_neg _ _).symm

/-- Applying the iterated space--time Fourier transform after the iterated
inverse transform recovers a joint Schwartz profile in raw product
coordinates. -/
theorem spaceTimeFourier_spaceTimeFourierInv_jointSchwartzRaw
    (P : SchwartzMap JointWaveSpaceTime Complex) (zeta : WaveSpaceTime) :
    spaceTimeFourier (spaceTimeFourierInv (jointSchwartzRaw P)) zeta =
      P (WithLp.toLp 2 zeta) := by
  have hraw :
      spaceTimeFourierInv (jointSchwartzRaw P) =
        jointSchwartzRaw (FourierTransform.fourierInv P) := by
    funext z
    rw [spaceTimeFourierInv_jointSchwartzRaw]
    change FourierTransform.fourierInv (P : JointWaveSpaceTime → Complex)
        (WithLp.toLp 2 z) =
      (FourierTransform.fourierInv P : SchwartzMap JointWaveSpaceTime Complex)
        (WithLp.toLp 2 z)
    exact (congrFun (SchwartzMap.fourierInv_coe P) (WithLp.toLp 2 z)).symm
  rw [hraw, spaceTimeFourier_jointSchwartzRaw]
  have hpair :
      FourierTransform.fourier
          ((FourierTransform.fourierInv P : SchwartzMap JointWaveSpaceTime Complex) :
            JointWaveSpaceTime → Complex) =
        (P : JointWaveSpaceTime → Complex) := by
    rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  exact congrFun hpair (WithLp.toLp 2 zeta)

private theorem aux_fourierInv_fourier_sub_schwartz
    (vartheta : SchwartzMap Real Complex) (a t : Real) :
    FourierTransform.fourierInv
        (fun tau : Real => FourierTransform.fourier (vartheta : Real → Complex) (tau - a)) t =
      Real.fourierChar (a * t) • vartheta t := by
  rw [Real.fourierInv_eq_fourier_neg]
  have hshift := VectorFourier.fourierIntegral_comp_add_right
    (V := Real) (W := Real) (E := Complex)
    Real.fourierChar volume (innerₗ Real)
    (FourierTransform.fourier (vartheta : Real → Complex)) (-a)
  change VectorFourier.fourierIntegral Real.fourierChar volume (innerₗ Real)
      (fun tau : Real => FourierTransform.fourier (vartheta : Real → Complex) (tau - a)) (-t) = _
  have htranslate :
      (fun tau : Real => FourierTransform.fourier (vartheta : Real → Complex) (tau - a)) =
        Function.comp (FourierTransform.fourier (vartheta : Real → Complex))
          (fun tau : Real => tau + (-a)) := by
    funext tau
    congr 1
  rw [htranslate, hshift]
  have hdouble :
      FourierTransform.fourier
          (FourierTransform.fourier (vartheta : Real → Complex)) (-t) = vartheta t := by
    calc
      FourierTransform.fourier
          (FourierTransform.fourier (vartheta : Real → Complex)) (-t) =
          FourierTransform.fourierInv
            (FourierTransform.fourier (vartheta : Real → Complex)) t :=
        (Real.fourierInv_eq_fourier_neg _ t).symm
      _ = (FourierTransform.fourierInv
            (FourierTransform.fourier vartheta) : SchwartzMap Real Complex) t := by
        simpa only [SchwartzMap.fourier_coe] using
          (congrFun (SchwartzMap.fourierInv_coe
            (FourierTransform.fourier vartheta)) t).symm
      _ = vartheta t := congrArg (fun q : SchwartzMap Real Complex => q t)
        (FourierTransform.fourierInv_fourier_eq vartheta)
  have hdoubleVec :
      VectorFourier.fourierIntegral Real.fourierChar volume (innerₗ Real)
          (FourierTransform.fourier (vartheta : Real → Complex)) (-t) = vartheta t := by
    change FourierTransform.fourier
      (FourierTransform.fourier (vartheta : Real → Complex)) (-t) = vartheta t
    exact hdouble
  change Real.fourierChar ((innerₗ Real (-a)) (-t)) •
      VectorFourier.fourierIntegral Real.fourierChar volume (innerₗ Real)
        (FourierTransform.fourier (vartheta : Real → Complex)) (-t) =
      Real.fourierChar (a * t) • vartheta t
  rw [hdoubleVec]
  congr 1
  simp only [innerₗ_apply_apply, Real.inner_apply]
  congr 1
  ring

private theorem aux_temporal_shift_integral
    (vartheta : SchwartzMap Real Complex) (a t : Real) :
    (∫ tau : Real,
      (Real.fourierChar (inner Real tau t) : Complex) *
        FourierTransform.fourier (vartheta : Real → Complex) (tau - a)) =
      (Real.fourierChar (a * t) : Complex) * vartheta t := by
  calc
    (∫ tau : Real,
      (Real.fourierChar (inner Real tau t) : Complex) *
        FourierTransform.fourier (vartheta : Real → Complex) (tau - a)) =
        FourierTransform.fourierInv
          (fun tau : Real => FourierTransform.fourier (vartheta : Real → Complex) (tau - a)) t := by
      rw [Real.fourierInv_eq]
      apply integral_congr_ae
      filter_upwards with tau
      rfl
    _ = Real.fourierChar (a * t) • vartheta t :=
      aux_fourierInv_fourier_sub_schwartz vartheta a t
    _ = (Real.fourierChar (a * t) : Complex) * vartheta t := by
      rfl

private theorem aux_integrable_jointSchwartzModulatedAnnularProfile_raw
    (B : SchwartzMap (Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    Integrable (fun p : WaveSpaceTime =>
      jointSchwartzModulatedAnnularProfile B vartheta rho (WithLp.toLp 2 p))
      (volume.prod volume) := by
  let G : SchwartzMap JointWaveSpaceTime Complex :=
    jointSchwartzModulatedAnnularProfile B vartheta rho
  have hpres : MeasurePreserving
      (MeasurableEquiv.toLp 2 WaveSpaceTime) volume volume :=
    WithLp.volume_preserving_toLp (Euclidean 2) Real
  have hraw : Integrable (fun p : WaveSpaceTime => G (WithLp.toLp 2 p))
      (volume.prod volume) :=
    (hpres.integrable_comp_emb
      (MeasurableEquiv.toLp 2 (Euclidean 2 × Real)).measurableEmbedding).mpr G.integrable
  simpa only [G] using hraw

private theorem aux_integrable_inverse_jointSchwartzModulatedAnnularProfile_kernel
    (B : SchwartzMap (Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (z : WaveSpaceTime) :
    Integrable (Function.uncurry (fun xi : Euclidean 2 => fun tau : Real =>
      Real.fourierChar (inner Real tau z.2) •
        (Real.fourierChar (inner Real xi z.1) •
          jointSchwartzModulatedAnnularProfile B vartheta rho (WithLp.toLp 2 (xi, tau)))))
      (volume.prod volume) := by
  let K : Euclidean 2 → Real → Complex := fun xi tau =>
    Real.fourierChar (inner Real tau z.2) •
      (Real.fourierChar (inner Real xi z.1) •
        jointSchwartzModulatedAnnularProfile B vartheta rho (WithLp.toLp 2 (xi, tau)))
  change Integrable (Function.uncurry K) (volume.prod volume)
  have hraw := aux_integrable_jointSchwartzModulatedAnnularProfile_raw B vartheta rho
  refine hraw.congr' ?_ ?_
  · exact
      ((Real.continuous_fourierChar.comp (by fun_prop)).aestronglyMeasurable.smul
        ((Real.continuous_fourierChar.comp (by fun_prop)).aestronglyMeasurable.smul
          hraw.aestronglyMeasurable))
  · filter_upwards with p
    simp only [K, Function.uncurry, Circle.norm_smul]

/-- Inverting the joint modulated annular Schwartz profile factors into its
temporal Schwartz factor and the corresponding spatial oscillatory inverse
transform. -/
theorem spaceTimeFourierInv_jointSchwartzModulatedAnnularProfile
    (B : SchwartzMap (Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (z : WaveSpaceTime) :
    spaceTimeFourierInv
        (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho)) z =
      vartheta z.2 * FourierTransform.fourierInv
        (fun xi : Euclidean 2 =>
          B xi * (Real.fourierChar (rho xi * z.2) : Complex)) z.1 := by
  let K : Euclidean 2 → Real → Complex := fun xi tau =>
    Real.fourierChar (inner Real tau z.2) •
      (Real.fourierChar (inner Real xi z.1) •
        jointSchwartzModulatedAnnularProfile B vartheta rho (WithLp.toLp 2 (xi, tau)))
  have hK : Integrable (Function.uncurry K) (volume.prod volume) := by
    simpa only [K] using
      aux_integrable_inverse_jointSchwartzModulatedAnnularProfile_kernel B vartheta rho z
  have hleft :
      spaceTimeFourierInv
          (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho)) z =
        ∫ tau : Real, ∫ xi : Euclidean 2, K xi tau := by
    unfold spaceTimeFourierInv
    rw [Real.fourierInv_eq]
    apply integral_congr_ae
    filter_upwards with tau
    rw [Real.fourierInv_eq]
    change
      (Real.fourierChar (inner Real tau z.2) : Complex) *
          ∫ xi : Euclidean 2,
            (Real.fourierChar (inner Real xi z.1) : Complex) *
              jointSchwartzModulatedAnnularProfile B vartheta rho
                (WithLp.toLp 2 (xi, tau)) =
        ∫ xi : Euclidean 2, K xi tau
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with xi
    simp only [K, Circle.smul_def, smul_eq_mul]
  have hKswap : Integrable
      (Function.uncurry (fun tau : Real => fun xi : Euclidean 2 => K xi tau))
      (volume.prod volume) := by
    convert hK.swap using 1
    ext w
    rcases w with ⟨tau, xi⟩
    rfl
  have hswap :
      (∫ tau : Real, ∫ xi : Euclidean 2, K xi tau) =
        ∫ xi : Euclidean 2, ∫ tau : Real, K xi tau :=
    integral_integral_swap hKswap
  have hinner (xi : Euclidean 2) :
      (∫ tau : Real, K xi tau) =
        ((Real.fourierChar (inner Real xi z.1) : Complex) * B xi) *
          ((Real.fourierChar (rho xi * z.2) : Complex) * vartheta z.2) := by
    have htemporal :
        (∫ tau : Real,
          (Real.fourierChar (inner Real tau z.2) : Complex) *
            FourierTransform.fourier (vartheta : Real → Complex) (tau - rho xi)) =
          (Real.fourierChar (rho xi * z.2) : Complex) * vartheta z.2 :=
      aux_temporal_shift_integral vartheta (rho xi) z.2
    calc
      (∫ tau : Real, K xi tau) =
          ((Real.fourierChar (inner Real xi z.1) : Complex) * B xi) *
            ∫ tau : Real,
              (Real.fourierChar (inner Real tau z.2) : Complex) *
                FourierTransform.fourier (vartheta : Real → Complex) (tau - rho xi) := by
          rw [← integral_const_mul]
          apply integral_congr_ae
          filter_upwards with tau
          simp only [K, Circle.smul_def, smul_eq_mul]
          rw [jointSchwartzModulatedAnnularProfile_apply]
          ring
      _ = ((Real.fourierChar (inner Real xi z.1) : Complex) * B xi) *
          ((Real.fourierChar (rho xi * z.2) : Complex) * vartheta z.2) := by
        rw [htemporal]
  calc
    spaceTimeFourierInv
        (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho)) z =
        ∫ tau : Real, ∫ xi : Euclidean 2, K xi tau := hleft
    _ = ∫ xi : Euclidean 2, ∫ tau : Real, K xi tau := hswap
    _ = ∫ xi : Euclidean 2,
        ((Real.fourierChar (inner Real xi z.1) : Complex) * B xi) *
          ((Real.fourierChar (rho xi * z.2) : Complex) * vartheta z.2) := by
      apply integral_congr_ae
      filter_upwards with xi
      exact hinner xi
    _ = vartheta z.2 * FourierTransform.fourierInv
        (fun xi : Euclidean 2 =>
          B xi * (Real.fourierChar (rho xi * z.2) : Complex)) z.1 := by
      rw [Real.fourierInv_eq]
      change
        (∫ xi : Euclidean 2,
          ((Real.fourierChar (inner Real xi z.1) : Complex) * B xi) *
            ((Real.fourierChar (rho xi * z.2) : Complex) * vartheta z.2)) =
          vartheta z.2 * ∫ xi : Euclidean 2,
            (Real.fourierChar (inner Real xi z.1) : Complex) *
              (B xi * (Real.fourierChar (rho xi * z.2) : Complex))
      rw [← integral_const_mul]
      apply integral_congr_ae
      filter_upwards with xi
      ring

private theorem aux_spaceTimeFourierInv_jointSchwartzModulatedAnnularProfile_eq_norm_on_support
    (B : SchwartzMap (Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hrho : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), rho xi = ‖xi‖)
    (z : WaveSpaceTime) :
    spaceTimeFourierInv
        (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho)) z =
      vartheta z.2 * FourierTransform.fourierInv
        (fun xi : Euclidean 2 =>
          B xi * (Real.fourierChar (‖xi‖ * z.2) : Complex)) z.1 := by
  have hprofile :
      (fun xi : Euclidean 2 =>
        B xi * (Real.fourierChar (rho xi * z.2) : Complex)) =
      fun xi : Euclidean 2 =>
        B xi * (Real.fourierChar (‖xi‖ * z.2) : Complex) := by
    funext xi
    by_cases hB : B xi = 0
    · simp [hB]
    · rw [hrho xi hB]
  calc
    spaceTimeFourierInv
        (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho)) z =
        vartheta z.2 * FourierTransform.fourierInv
          (fun xi : Euclidean 2 =>
            B xi * (Real.fourierChar (rho xi * z.2) : Complex)) z.1 :=
      spaceTimeFourierInv_jointSchwartzModulatedAnnularProfile B vartheta rho z
    _ = vartheta z.2 * FourierTransform.fourierInv
        (fun xi : Euclidean 2 =>
          B xi * (Real.fourierChar (‖xi‖ * z.2) : Complex)) z.1 := by
      rw [hprofile]

private theorem aux_fourierChar_norm_eq_halfWaveMultiplier_plus
    (t : Real) (xi : Euclidean 2) :
    (Real.fourierChar (‖xi‖ * t) : Complex) =
      halfWaveMultiplier WaveSign.plus t xi := by
  rw [Real.fourierChar_apply]
  simp only [halfWaveMultiplier, WaveSign.toReal]
  congr 2
  push_cast
  ring

/-- If the radial extension equals the norm on the planar Schwartz profile
support, the joint inverse profile is the positive half-wave weighted by its
temporal Schwartz factor. -/
theorem spaceTimeFourierInv_jointSchwartzModulatedAnnularProfile_eq_halfWave_of_eq_norm_on_support
    (B : SchwartzMap (Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hrho : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), rho xi = ‖xi‖)
    (z : WaveSpaceTime) :
    spaceTimeFourierInv
        (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho)) z =
      vartheta z.2 * FourierTransform.fourierInv
        (fun xi : Euclidean 2 =>
          B xi * halfWaveMultiplier WaveSign.plus z.2 xi) z.1 := by
  rw [aux_spaceTimeFourierInv_jointSchwartzModulatedAnnularProfile_eq_norm_on_support
    B vartheta rho hrho z]
  congr 2
  apply congrArg (fun f : Euclidean 2 → Complex =>
    FourierTransform.fourierInv f z.1)
  funext xi
  rw [aux_fourierChar_norm_eq_halfWaveMultiplier_plus]

/-- The iterated space--time Fourier transform of the supplied
temporal-Schwartz positive annular half-wave is its joint modulated annular
profile.  This is a spectral identity, with no conic-support assertion. -/
theorem spaceTimeFourier_temporalSchwartzHalfWave_eq_jointSchwartzModulatedAnnularProfile
    (B : SchwartzMap (Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hrho : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), rho xi = ‖xi‖)
    (zeta : WaveSpaceTime) :
    spaceTimeFourier
        (fun z : WaveSpaceTime =>
          vartheta z.2 * FourierTransform.fourierInv
            (fun xi : Euclidean 2 =>
              B xi * halfWaveMultiplier WaveSign.plus z.2 xi) z.1) zeta =
      jointSchwartzModulatedAnnularProfile B vartheta rho (WithLp.toLp 2 zeta) := by
  have hphysical :
      (fun z : WaveSpaceTime =>
        vartheta z.2 * FourierTransform.fourierInv
          (fun xi : Euclidean 2 =>
            B xi * halfWaveMultiplier WaveSign.plus z.2 xi) z.1) =
        spaceTimeFourierInv
          (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho)) := by
    funext z
    exact (spaceTimeFourierInv_jointSchwartzModulatedAnnularProfile_eq_halfWave_of_eq_norm_on_support
      B vartheta rho hrho z).symm
  rw [hphysical]
  exact spaceTimeFourier_spaceTimeFourierInv_jointSchwartzRaw
    (jointSchwartzModulatedAnnularProfile B vartheta rho) zeta

/-- The vertical Fourier multiplier used in the MSS radial decomposition.
The frequency scale is `sqrt scale`, matching the radial width
`scale^(1/2)`. -/
def verticalMultiplier (β : Real → Complex) (scale : Real) (n : Int) :
    WaveSpaceTime → Complex :=
  fun ζ => β ((Real.sqrt scale)⁻¹ * ζ.2 - n)

/-- The literal space--time Fourier multiplier `V_n^scale`.  No boundedness is
claimed here: quantitative estimates require the smooth cutoff hypotheses
and Fourier multiplier analysis later in the MSS proof. -/
noncomputable def verticalProjection (β : Real → Complex) (scale : Real) (n : Int)
    (G : WaveSpaceTime → Complex) : WaveSpaceTime → Complex :=
  spaceTimeFourierInv (fun ζ => verticalMultiplier β scale n ζ * spaceTimeFourier G ζ)

/-- The one-dimensional temporal multiplier which is the exact action of a
vertical projection on a separable space--time packet.  Keeping this literal
inverse Fourier formula exposes the physical time analysis needed for the
eventual vector-valued endpoint, without asserting that endpoint here. -/
noncomputable def verticalTemporalProjection (β : Real → Complex) (scale : Real) (n : Int)
    (g : Real → Complex) : Real → Complex :=
  fun t => 𝓕⁻ (fun τ : Real => β ((Real.sqrt scale)⁻¹ * τ - n) * 𝓕 g τ) t

/-- A spatial Schwartz profile times an arbitrary temporal profile.  These
are the literal finite packets on which the iterated space--time Fourier
definition of `verticalProjection` separates exactly. -/
noncomputable def verticalSeparablePacket (F : SchwartzMap (Euclidean 2) Complex)
    (g : Real → Complex) : WaveSpaceTime → Complex :=
  fun z => g z.2 * F z.1

private theorem aux_fourier_const_mul_apply {E : Type*}
    [NormedAddCommGroup E] [InnerProductSpace Real E]
    [MeasurableSpace E] [BorelSpace E] [FiniteDimensional Real E]
    (c : Complex) (f : E → Complex) (ξ : E) :
    𝓕 (fun x => c * f x) ξ = c * 𝓕 f ξ := by
  rw [Real.fourier_eq, Real.fourier_eq]
  change (∫ x : E,
    (Real.fourierChar (-inner Real x ξ) : Complex) * (c * f x)) =
      c * ∫ x : E, (Real.fourierChar (-inner Real x ξ) : Complex) * f x
  rw [show (fun x : E =>
      (Real.fourierChar (-inner Real x ξ) : Complex) * (c * f x)) =
      fun x : E => c * ((Real.fourierChar (-inner Real x ξ) : Complex) * f x) by
        funext x
        ring]
  rw [integral_const_mul]

private theorem aux_fourierInv_const_mul_apply {E : Type*}
    [NormedAddCommGroup E] [InnerProductSpace Real E]
    [MeasurableSpace E] [BorelSpace E] [FiniteDimensional Real E]
    (c : Complex) (f : E → Complex) (x : E) :
    𝓕⁻ (fun ξ => c * f ξ) x = c * 𝓕⁻ f x := by
  rw [Real.fourierInv_eq, Real.fourierInv_eq]
  change (∫ ξ : E,
    (Real.fourierChar (inner Real ξ x) : Complex) * (c * f ξ)) =
      c * ∫ ξ : E, (Real.fourierChar (inner Real ξ x) : Complex) * f ξ
  rw [show (fun ξ : E =>
      (Real.fourierChar (inner Real ξ x) : Complex) * (c * f ξ)) =
      fun ξ : E => c * ((Real.fourierChar (inner Real ξ x) : Complex) * f ξ) by
        funext ξ
        ring]
  rw [integral_const_mul]

private theorem aux_fourierInv_fourier_schwartz_apply
    (F : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    𝓕⁻ (𝓕 (F : Euclidean 2 → Complex)) x = F x := by
  have hfourier : (𝓕⁻ (𝓕 F) : SchwartzMap (Euclidean 2) Complex) = F :=
    FourierTransform.fourierInv_fourier_eq F
  have h := congrArg (fun q : SchwartzMap (Euclidean 2) Complex => q x) hfourier
  simpa only [SchwartzMap.fourierInv_coe, SchwartzMap.fourier_coe] using h

/-- The iterated space--time Fourier transform of a literal separable packet
is exactly the product of its spatial and temporal Fourier factors. -/
theorem spaceTimeFourier_verticalSeparablePacket
    (F : SchwartzMap (Euclidean 2) Complex) (g : Real → Complex)
    (ξ : Euclidean 2) (τ : Real) :
    spaceTimeFourier (verticalSeparablePacket F g) (ξ, τ) =
      𝓕 (F : Euclidean 2 → Complex) ξ * 𝓕 g τ := by
  unfold spaceTimeFourier verticalSeparablePacket
  have hspace (t : Real) :
      𝓕 (fun x : Euclidean 2 => g t * F x) ξ =
        g t * 𝓕 (F : Euclidean 2 → Complex) ξ := by
    exact aux_fourier_const_mul_apply (g t) (F : Euclidean 2 → Complex) ξ
  rw [show (fun t : Real => 𝓕 (fun x : Euclidean 2 => g t * F x) ξ) =
      fun t : Real => g t * 𝓕 (F : Euclidean 2 → Complex) ξ by
        funext t
        exact hspace t]
  rw [show (fun t : Real => g t * 𝓕 (F : Euclidean 2 → Complex) ξ) =
      fun t : Real => 𝓕 (F : Euclidean 2 → Complex) ξ * g t by
        funext t
        ring]
  exact aux_fourier_const_mul_apply
    (𝓕 (F : Euclidean 2 → Complex) ξ) g τ

/-- The space--time Fourier support of a literal separable packet is contained
in the Cartesian product of the supports of its actual spatial and temporal
Fourier factors.  This is only a separable-packet fact: it makes no
space--time support assertion for the time-dependent half-wave packets used
elsewhere in the MSS construction. -/
theorem support_spaceTimeFourier_verticalSeparablePacket_subset_prod
    (F : SchwartzMap (Euclidean 2) Complex) (g : Real → Complex) :
    Function.support (spaceTimeFourier (verticalSeparablePacket F g)) ⊆
      Function.support (𝓕 (F : Euclidean 2 → Complex)) ×ˢ Function.support (𝓕 g) := by
  intro z hz
  change spaceTimeFourier (verticalSeparablePacket F g) z ≠ 0 at hz
  rw [spaceTimeFourier_verticalSeparablePacket] at hz
  constructor
  · change 𝓕 (F : Euclidean 2 → Complex) z.1 ≠ 0
    exact (mul_ne_zero_iff.mp hz).1
  · change 𝓕 g z.2 ≠ 0
    exact (mul_ne_zero_iff.mp hz).2

/-- Any concrete set containing the Fourier-factor support product contains
the space--time Fourier support of the corresponding literal separable
packet.  The conic-plate specialization is obtained by supplying that
product containment; this does not turn a half-wave packet into a separable
one. -/
theorem support_spaceTimeFourier_verticalSeparablePacket_subset
    (F : SchwartzMap (Euclidean 2) Complex) (g : Real → Complex)
    (S : Set WaveSpaceTime)
    (hS : Function.support (𝓕 (F : Euclidean 2 → Complex)) ×ˢ Function.support (𝓕 g) ⊆ S) :
    Function.support (spaceTimeFourier (verticalSeparablePacket F g)) ⊆ S :=
  (support_spaceTimeFourier_verticalSeparablePacket_subset_prod F g).trans hS

/-- A literal vertical projection of a separable packet is precisely its
one-dimensional temporal projection times its unchanged spatial profile. -/
theorem verticalProjection_verticalSeparablePacket
    (β : Real → Complex) (scale : Real) (n : Int)
    (F : SchwartzMap (Euclidean 2) Complex) (g : Real → Complex)
    (z : WaveSpaceTime) :
    verticalProjection β scale n (verticalSeparablePacket F g) z =
      verticalTemporalProjection β scale n g z.2 * F z.1 := by
  unfold verticalProjection spaceTimeFourierInv verticalTemporalProjection
  have hfourier (η : Euclidean 2) (τ : Real) :
      spaceTimeFourier (verticalSeparablePacket F g) (η, τ) =
        𝓕 (F : Euclidean 2 → Complex) η * 𝓕 g τ :=
    spaceTimeFourier_verticalSeparablePacket F g η τ
  have hspace (τ : Real) :
      𝓕⁻ (fun η : Euclidean 2 =>
        verticalMultiplier β scale n (η, τ) *
          spaceTimeFourier (verticalSeparablePacket F g) (η, τ)) z.1 =
        (β ((Real.sqrt scale)⁻¹ * τ - n) * 𝓕 g τ) * F z.1 := by
    rw [show (fun η : Euclidean 2 =>
        verticalMultiplier β scale n (η, τ) *
          spaceTimeFourier (verticalSeparablePacket F g) (η, τ)) =
        fun η : Euclidean 2 =>
          (β ((Real.sqrt scale)⁻¹ * τ - n) * 𝓕 g τ) *
            𝓕 (F : Euclidean 2 → Complex) η by
      funext η
      rw [verticalMultiplier, hfourier]
      ring]
    rw [aux_fourierInv_const_mul_apply]
    rw [aux_fourierInv_fourier_schwartz_apply]
  rw [show (fun τ : Real =>
      𝓕⁻ (fun η : Euclidean 2 =>
        verticalMultiplier β scale n (η, τ) *
          spaceTimeFourier (verticalSeparablePacket F g) (η, τ)) z.1) =
      fun τ : Real => (β ((Real.sqrt scale)⁻¹ * τ - n) * 𝓕 g τ) * F z.1 by
        funext τ
        exact hspace τ]
  rw [show (fun τ : Real => (β ((Real.sqrt scale)⁻¹ * τ - n) * 𝓕 g τ) * F z.1) =
      fun τ : Real => F z.1 * (β ((Real.sqrt scale)⁻¹ * τ - n) * 𝓕 g τ) by
        funext τ
        ring]
  rw [aux_fourierInv_const_mul_apply]
  ring

private noncomputable def aux_verticalTemporalMultiplierProfile
    (m g : SchwartzMap Real Complex) : SchwartzMap Real Complex :=
  SchwartzMap.smulLeftCLM Complex (m : Real → Complex) (𝓕 g)

private theorem aux_verticalTemporalMultiplierProfile_apply
    (m g : SchwartzMap Real Complex) (τ : Real) :
    aux_verticalTemporalMultiplierProfile m g τ =
      m τ * 𝓕 (g : Real → Complex) τ := by
  simp only [aux_verticalTemporalMultiplierProfile,
    SchwartzMap.smulLeftCLM_apply_apply m.hasTemperateGrowth,
    smul_eq_mul, SchwartzMap.fourier_coe]

private theorem aux_fourier_fourierInv_schwartzReal_apply
    (h : SchwartzMap Real Complex) (τ : Real) :
    𝓕 ((𝓕⁻ h : SchwartzMap Real Complex) : Real → Complex) τ = h τ := by
  have hfourier : (𝓕 (𝓕⁻ h) : SchwartzMap Real Complex) = h :=
    FourierTransform.fourier_fourierInv_eq h
  have hpoint := congrArg (fun q : SchwartzMap Real Complex => q τ) hfourier
  simpa only [SchwartzMap.fourier_coe, SchwartzMap.fourierInv_coe] using hpoint

private theorem aux_verticalTemporalProjection_eq_fourierInv_profile
    (β : Real → Complex) (scale : Real) (n : Int)
    (m g : SchwartzMap Real Complex)
    (hprofile : ∀ τ : Real, m τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (t : Real) :
    verticalTemporalProjection β scale n (g : Real → Complex) t =
      ((𝓕⁻ (aux_verticalTemporalMultiplierProfile m g) : SchwartzMap Real Complex) :
        Real → Complex) t := by
  unfold verticalTemporalProjection
  rw [SchwartzMap.fourierInv_coe]
  apply congrArg (fun q : Real → Complex => 𝓕⁻ q t)
  funext τ
  calc
    β ((Real.sqrt scale)⁻¹ * τ - n) * 𝓕 (g : Real → Complex) τ =
        m τ * 𝓕 (g : Real → Complex) τ := by rw [hprofile τ]
    _ = aux_verticalTemporalMultiplierProfile m g τ :=
      (aux_verticalTemporalMultiplierProfile_apply m g τ).symm

/-- If the already shifted/scaled temporal multiplier has a supplied
Schwartz representative, a literal vertical projection has its expected
space--time Fourier multiplier identity on a separable packet with Schwartz
temporal factor.  This is termwise only: it makes no assertion for arbitrary
space--time functions or for a physical-time-cutoff half-wave. -/
theorem spaceTimeFourier_verticalProjection_verticalSeparablePacket_of_schwartzProfile
    (β : Real → Complex) (scale : Real) (n : Int)
    (m g : SchwartzMap Real Complex)
    (hprofile : ∀ τ : Real, m τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : SchwartzMap (Euclidean 2) Complex) (ξ : Euclidean 2) (τ : Real) :
    spaceTimeFourier
        (verticalProjection β scale n
          (verticalSeparablePacket F (g : Real → Complex))) (ξ, τ) =
      verticalMultiplier β scale n (ξ, τ) *
        spaceTimeFourier (verticalSeparablePacket F (g : Real → Complex)) (ξ, τ) := by
  have hphysical : verticalProjection β scale n
      (verticalSeparablePacket F (g : Real → Complex)) =
      verticalSeparablePacket F
        ((𝓕⁻ (aux_verticalTemporalMultiplierProfile m g) : SchwartzMap Real Complex) :
          Real → Complex) := by
    funext z
    rw [verticalProjection_verticalSeparablePacket]
    rw [aux_verticalTemporalProjection_eq_fourierInv_profile β scale n m g hprofile]
    rfl
  rw [hphysical, spaceTimeFourier_verticalSeparablePacket,
    aux_fourier_fourierInv_schwartzReal_apply,
    spaceTimeFourier_verticalSeparablePacket, verticalMultiplier]
  rw [aux_verticalTemporalMultiplierProfile_apply, hprofile τ]
  ring

/-- The matched radial piece from the MSS decomposition, as its literal
spatial Fourier multiplier. -/
noncomputable def radialPiece (β : Real → Complex) (scale : Real) (n : Int)
    (f : Euclidean 2 → Complex) : Euclidean 2 → Complex :=
  𝓕⁻ (fun ξ => β ((Real.sqrt scale)⁻¹ * ‖ξ‖ - n) * 𝓕 f ξ)

/-- A supplied Schwartz representative of the radial multiplier gives the
exact Fourier transform of the literal raw radial piece.  The representative
is an explicit hypothesis; no Schwartz regularity is inferred from a raw
cutoff. -/
theorem fourier_radialPiece_eq_schwartzProfile_mul_fourier
    (radialCutoff : Real → Complex) (scale : Real) (n : Int)
    (R f : SchwartzMap (Euclidean 2) Complex)
    (hR : ∀ xi : Euclidean 2,
      R xi = radialCutoff ((Real.sqrt scale)⁻¹ * ‖xi‖ - n))
    (xi : Euclidean 2) :
    FourierTransform.fourier
        (radialPiece radialCutoff scale n (f : Euclidean 2 → Complex)) xi =
      R xi * FourierTransform.fourier (f : Euclidean 2 → Complex) xi := by
  let P : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex (R : Euclidean 2 → Complex)
      (FourierTransform.fourier f)
  have hpiece : radialPiece radialCutoff scale n (f : Euclidean 2 → Complex) =
      (FourierTransform.fourierInv P : Euclidean 2 → Complex) := by
    unfold radialPiece
    rw [SchwartzMap.fourierInv_coe]
    apply congrArg FourierTransform.fourierInv
    funext eta
    dsimp only [P]
    rw [SchwartzMap.smulLeftCLM_apply_apply R.hasTemperateGrowth,
      SchwartzMap.fourier_coe, hR eta]
    rfl
  rw [hpiece]
  change FourierTransform.fourier
      ((FourierTransform.fourierInv P : SchwartzMap (Euclidean 2) Complex) :
        Euclidean 2 → Complex) xi = _
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  dsimp only [P]
  rw [SchwartzMap.smulLeftCLM_apply_apply R.hasTemperateGrowth,
    SchwartzMap.fourier_coe]
  rfl

/-- A fixed angular/radial packet with a supplied norm-radial Schwartz cutoff
admits the regular data required by the angular/radial bridge.  The scalar
cutoff is chosen from this individual packet; this does not construct a
uniform cutoff family or instantiate raw local-smoothing data. -/
theorem exists_regularAngularRadialBridgeData_of_normRadialSchwartzCutoffs
    (R f a chi : SchwartzMap (Euclidean 2) Complex)
    (hRradial : ∀ ⦃xi eta : Euclidean 2⦄, ‖xi‖ = ‖eta‖ → R xi = R eta)
    (e : Euclidean 2) (he : ‖e‖ = 1)
    (scale : Real) (hscale : 0 < scale) (n : Int) :
    ∃ (radialCutoff : Real → Complex) (B : SchwartzMap (Euclidean 2) Complex),
      (∀ xi : Euclidean 2,
        R xi = radialCutoff ((Real.sqrt scale)⁻¹ * ‖xi‖ - n)) ∧
      (∀ xi : Euclidean 2, B xi =
        (chi : Euclidean 2 → Complex) xi * a (scale⁻¹ • xi) *
          (R xi * FourierTransform.fourier (f : Euclidean 2 → Complex) xi)) := by
  let radialCutoff : Real → Complex :=
    fun s => R ((Real.sqrt scale * (s + n)) • e)
  let P : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex (R : Euclidean 2 → Complex)
      (FourierTransform.fourier f)
  let B : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex
      (fun xi : Euclidean 2 => (chi : Euclidean 2 → Complex) xi * a (scale⁻¹ • xi)) P
  have hangular : (fun xi : Euclidean 2 =>
      (chi : Euclidean 2 → Complex) xi * a (scale⁻¹ • xi)).HasTemperateGrowth := by
    fun_prop
  refine ⟨radialCutoff, B, ?_, ?_⟩
  · intro xi
    have hsqrtpos : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
    have hscalar : Real.sqrt scale *
        ((Real.sqrt scale)⁻¹ * ‖xi‖ - (n : Real) + (n : Real)) = ‖xi‖ := by
      rw [sub_add_cancel]
      calc
        Real.sqrt scale * ((Real.sqrt scale)⁻¹ * ‖xi‖) =
            (Real.sqrt scale * (Real.sqrt scale)⁻¹) * ‖xi‖ := by ring
        _ = ‖xi‖ := by rw [mul_inv_cancel₀ hsqrtpos.ne', one_mul]
    have hscalar_nonneg : 0 ≤ Real.sqrt scale *
        ((Real.sqrt scale)⁻¹ * ‖xi‖ - (n : Real) + (n : Real)) := by
      rw [hscalar]
      exact norm_nonneg _
    change R xi = R
      ((Real.sqrt scale *
        ((Real.sqrt scale)⁻¹ * ‖xi‖ - (n : Real) + (n : Real))) • e)
    apply hRradial
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hscalar_nonneg, he, hscalar]
    simp
  · intro xi
    dsimp only [B, P]
    rw [SchwartzMap.smulLeftCLM_apply_apply hangular,
      SchwartzMap.smulLeftCLM_apply_apply R.hasTemperateGrowth,
      SchwartzMap.fourier_coe]
    simp only [smul_eq_mul]

/-- The conically localized constant-coefficient half-wave operator.  The
amplitude and time cutoff are parameters; their smooth support hypotheses
are kept separate from this exact Fourier formula. -/
noncomputable def conicOperator (scale : Real) (a : Euclidean 2 → Complex)
    (ϑ : Real → Complex) (f : Euclidean 2 → Complex) :
    WaveSpaceTime → Complex :=
  fun z => ϑ z.2 * 𝓕⁻ (fun ξ =>
    a (scale⁻¹ • ξ) * halfWaveMultiplier WaveSign.plus z.2 ξ * 𝓕 f ξ) z.1

/-- The raw inverse Fourier transform distributes over a finite sum when
each summand is integrable.  This is kept local because the raw-function
Fourier API has no unconditional additive instance. -/
private theorem aux_fourierInv_finset_sum_of_integrable
    {ι : Type*} (s : Finset ι) (q : ι → Euclidean 2 → Complex)
    (hq : ∀ i ∈ s, Integrable (q i) volume) (x : Euclidean 2) :
    𝓕⁻ (fun ξ => ∑ i ∈ s, q i ξ) x =
      ∑ i ∈ s, 𝓕⁻ (q i) x := by
  have hqchar : ∀ i ∈ s, Integrable
      (fun ξ : Euclidean 2 => Real.fourierChar (inner Real ξ x) • q i ξ) volume := by
    intro i hi
    refine Integrable.mono' (hq i hi).norm ?_ ?_
    · exact (Real.continuous_fourierChar.comp (by fun_prop)).aestronglyMeasurable.smul
        (hq i hi).aestronglyMeasurable
    · filter_upwards with ξ
      simp
  rw [Real.fourierInv_eq]
  change (∫ ξ : Euclidean 2,
      Real.fourierChar (inner Real ξ x) • (∑ i ∈ s, q i ξ)) = _
  rw [show (fun ξ : Euclidean 2 =>
      Real.fourierChar (inner Real ξ x) • (∑ i ∈ s, q i ξ)) =
        fun ξ => ∑ i ∈ s, Real.fourierChar (inner Real ξ x) • q i ξ by
      funext ξ
      rw [Finset.smul_sum],
    MeasureTheory.integral_finsetSum s hqchar]
  simp only [Real.fourierInv_eq]

/-- At dyadic scale `2^j`, the level-zero annular amplitude in the conic
normal form is exactly the level-`j` Littlewood--Paley multiplier.  On the
unit time slab, where `ϑ = 1`, the conic operator is therefore the positive
dyadic half-wave. -/
theorem conicOperator_eq_dyadicHalfWaveSpaceTime_plus
    (C : lpCutoffs 2) (ϑ : Real → Complex) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) (z : WaveSpaceTime)
    (hϑ : ϑ z.2 = 1) :
    conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) ϑ
        (f : Euclidean 2 → Complex) z =
      dyadicHalfWaveSpaceTime C.cutoff WaveSign.plus j f z := by
  rw [conicOperator, dyadicHalfWaveSpaceTime, dyadicHalfWave, hϑ, one_mul]
  apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g z.1)
  funext ξ
  change dyadicBandpassMultiplier C.cutoff 0 (((2 : Real) ^ j)⁻¹ • ξ) *
      halfWaveMultiplier WaveSign.plus z.2 ξ * 𝓕 (f : Euclidean 2 → Complex) ξ =
    halfWaveMultiplier WaveSign.plus z.2 ξ * dyadicBandpassMultiplier C.cutoff j ξ *
      𝓕 (f : Euclidean 2 → Complex) ξ
  rw [← dyadicBandpassMultiplier_eq_levelZero_scaled C j ξ]
  ring

/-- At a dyadic scale, the complete conic normal form is exactly its time
cutoff times the corresponding positive dyadic half-wave. -/
private theorem conicOperator_eq_timeCutoff_mul_dyadicHalfWaveSpaceTime
    (C : lpCutoffs 2) (vartheta : Real → Complex) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) :
    conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) vartheta
        (f : Euclidean 2 → Complex) =
      fun z => vartheta z.2 * dyadicHalfWaveSpaceTime C.cutoff WaveSign.plus j f z := by
  funext z
  rw [conicOperator, dyadicHalfWaveSpaceTime, dyadicHalfWave]
  apply congrArg (fun g : Euclidean 2 → Complex => vartheta z.2 * 𝓕⁻ g z.1)
  funext xi
  rw [← dyadicBandpassMultiplier_eq_levelZero_scaled C j xi]
  ring

/-- The matched dyadic conic normal form is jointly continuous for a
continuous time cutoff. -/
theorem continuous_conicOperator_dyadicBandpass
    (C : lpCutoffs 2) (vartheta : Real → Complex) (hvartheta : Continuous vartheta)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    Continuous
      (conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) vartheta
        (f : Euclidean 2 → Complex)) := by
  rw [conicOperator_eq_timeCutoff_mul_dyadicHalfWaveSpaceTime C vartheta j f]
  exact (hvartheta.comp continuous_snd).mul
    (continuous_dyadicHalfWaveSpaceTime C WaveSign.plus j f)

/-- A measurable time cutoff makes the matched dyadic conic normal form
measurable on the full space--time ambient space. -/
theorem measurable_conicOperator_dyadicBandpass
    (C : lpCutoffs 2) (vartheta : Real → Complex) (hvartheta : Measurable vartheta)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    Measurable
      (conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) vartheta
        (f : Euclidean 2 → Complex)) := by
  rw [conicOperator_eq_timeCutoff_mul_dyadicHalfWaveSpaceTime C vartheta j f]
  exact (hvartheta.comp measurable_snd).mul
    (continuous_dyadicHalfWaveSpaceTime C WaveSign.plus j f).measurable

/-- The exact global measurability input required by the two-sided conic
local-smoothing bridge. -/
theorem aestronglyMeasurable_conicOperator_dyadicBandpass
    (C : lpCutoffs 2) (vartheta : Real → Complex) (hvartheta : Measurable vartheta)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    AEStronglyMeasurable
      (conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) vartheta
        (f : Euclidean 2 → Complex)) volume :=
  (measurable_conicOperator_dyadicBandpass C vartheta hvartheta j f).aestronglyMeasurable

/-- The local `[1,2]` space--time measure is dominated by full Lebesgue
measure, allowing a global conic estimate to control its local restriction. -/
theorem localSmoothingMeasure_le_volume :
    localSmoothingMeasure ≤ (volume : Measure WaveSpaceTime) := by
  rw [localSmoothingMeasure, Measure.volume_eq_prod]
  exact Measure.prod_mono le_rfl Measure.restrict_le_self

/-- The positive dyadic half-wave and the matched conic normal form agree
almost everywhere on the local time slab. -/
theorem ae_eq_conicOperator_dyadicHalfWaveSpaceTime_plus
    (C : lpCutoffs 2) (ϑ : Real → Complex) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex)
    (hϑ : ∀ t ∈ Icc (1 : Real) 2, ϑ t = 1) :
    conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) ϑ
        (f : Euclidean 2 → Complex) =ᵐ[localSmoothingMeasure]
      dyadicHalfWaveSpaceTime C.cutoff WaveSign.plus j f := by
  have htime : ∀ᵐ t : Real ∂(volume.restrict (Icc (1 : Real) 2)),
      t ∈ Icc (1 : Real) 2 := ae_restrict_mem measurableSet_Icc
  have hslab : ∀ᵐ z : WaveSpaceTime ∂localSmoothingMeasure,
      z.2 ∈ Icc (1 : Real) 2 := by
    rw [localSmoothingMeasure]
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards with x
      exact htime
    · exact measurableSet_Icc.preimage measurable_snd
  filter_upwards [hslab] with z hz
  exact conicOperator_eq_dyadicHalfWaveSpaceTime_plus C ϑ j f z (hϑ z.2 hz)

/-- A global conic `L⁴` estimate transfers to the local positive dyadic
half-wave at the matching scale.  The negative orientation is intentionally
not folded into this lemma: it requires its own reflected conic input. -/
theorem eLpNorm_dyadicHalfWaveSpaceTime_plus_le_conicOperator
    (C : lpCutoffs 2) (ϑ : Real → Complex) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex)
    (hϑ : ∀ t ∈ Icc (1 : Real) 2, ϑ t = 1) :
    eLpNorm (dyadicHalfWaveSpaceTime C.cutoff WaveSign.plus j f) (4 : ENNReal)
        localSmoothingMeasure ≤
      eLpNorm (conicOperator ((2 : Real) ^ j)
        (dyadicBandpassMultiplier C.cutoff 0) ϑ (f : Euclidean 2 → Complex))
        (4 : ENNReal) volume := by
  rw [← eLpNorm_congr_ae
    (ae_eq_conicOperator_dyadicHalfWaveSpaceTime_plus C ϑ j f hϑ)]
  exact eLpNorm_mono_measure _ localSmoothingMeasure_le_volume

/-- Time reflection in the space--time ambient space.  This is kept private:
its only use here is transporting the positive conic normal form to the
negative half-wave orientation. -/
private def timeReflectWaveSpaceTime (z : WaveSpaceTime) : WaveSpaceTime :=
  (z.1, -z.2)

private theorem timeReflectWaveSpaceTime_measurePreserving :
    MeasurePreserving timeReflectWaveSpaceTime (volume : Measure WaveSpaceTime) volume := by
  rw [Measure.volume_eq_prod]
  change MeasurePreserving (Prod.map id Neg.neg)
    ((volume : Measure (Euclidean 2)).prod (volume : Measure Real))
    ((volume : Measure (Euclidean 2)).prod (volume : Measure Real))
  exact MeasurePreserving.prod (MeasurePreserving.id _) (Measure.measurePreserving_neg _)

private theorem halfWaveMultiplier_plus_neg_eq_minus
    (t : Real) (ξ : Euclidean 2) :
    halfWaveMultiplier WaveSign.plus (-t) ξ =
      halfWaveMultiplier WaveSign.minus t ξ := by
  simp only [halfWaveMultiplier, WaveSign.toReal]
  congr 2
  ring_nf

/-- Evaluating the positive conic normal form at reflected time gives the
negative dyadic half-wave at the matched dyadic scale. -/
theorem conicOperator_timeReflect_eq_dyadicHalfWaveSpaceTime_minus
    (C : lpCutoffs 2) (ϑ : Real → Complex) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) (z : WaveSpaceTime)
    (hϑ : ϑ (-z.2) = 1) :
    conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) ϑ
        (f : Euclidean 2 → Complex) (timeReflectWaveSpaceTime z) =
      dyadicHalfWaveSpaceTime C.cutoff WaveSign.minus j f z := by
  rw [conicOperator, timeReflectWaveSpaceTime, dyadicHalfWaveSpaceTime, dyadicHalfWave,
    hϑ, one_mul]
  apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g z.1)
  funext ξ
  change dyadicBandpassMultiplier C.cutoff 0 (((2 : Real) ^ j)⁻¹ • ξ) *
      halfWaveMultiplier WaveSign.plus (-z.2) ξ * 𝓕 (f : Euclidean 2 → Complex) ξ =
    halfWaveMultiplier WaveSign.minus z.2 ξ * dyadicBandpassMultiplier C.cutoff j ξ *
      𝓕 (f : Euclidean 2 → Complex) ξ
  rw [← dyadicBandpassMultiplier_eq_levelZero_scaled C j ξ,
    halfWaveMultiplier_plus_neg_eq_minus]
  ring

/-- The reflected-time conic normal form and negative dyadic half-wave agree
almost everywhere on the local time slab when the conic time cutoff is one on
the reflected slab. -/
theorem ae_eq_conicOperator_timeReflect_dyadicHalfWaveSpaceTime_minus
    (C : lpCutoffs 2) (ϑ : Real → Complex) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex)
    (hϑ : ∀ t ∈ Icc (1 : Real) 2, ϑ (-t) = 1) :
    (fun z => conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) ϑ
        (f : Euclidean 2 → Complex) (timeReflectWaveSpaceTime z)) =ᵐ[localSmoothingMeasure]
      dyadicHalfWaveSpaceTime C.cutoff WaveSign.minus j f := by
  have htime : ∀ᵐ t : Real ∂(volume.restrict (Icc (1 : Real) 2)),
      t ∈ Icc (1 : Real) 2 := ae_restrict_mem measurableSet_Icc
  have hslab : ∀ᵐ z : WaveSpaceTime ∂localSmoothingMeasure,
      z.2 ∈ Icc (1 : Real) 2 := by
    rw [localSmoothingMeasure]
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards with x
      exact htime
    · exact measurableSet_Icc.preimage measurable_snd
  filter_upwards [hslab] with z hz
  exact conicOperator_timeReflect_eq_dyadicHalfWaveSpaceTime_minus C ϑ j f z
    (hϑ z.2 hz)

/-- A global positive-conic `L⁴` norm controls the local negative half-wave
at the matching scale, after time reflection.  The explicit measurability
hypothesis is needed for the measure-preserving change of variables. -/
theorem eLpNorm_dyadicHalfWaveSpaceTime_minus_le_conicOperator
    (C : lpCutoffs 2) (ϑ : Real → Complex) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex)
    (hϑ : ∀ t ∈ Icc (1 : Real) 2, ϑ (-t) = 1)
    (hmeas : AEStronglyMeasurable
      (conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) ϑ
        (f : Euclidean 2 → Complex)) volume) :
    eLpNorm (dyadicHalfWaveSpaceTime C.cutoff WaveSign.minus j f) (4 : ENNReal)
        localSmoothingMeasure ≤
      eLpNorm (conicOperator ((2 : Real) ^ j)
        (dyadicBandpassMultiplier C.cutoff 0) ϑ (f : Euclidean 2 → Complex))
        (4 : ENNReal) volume := by
  let g : WaveSpaceTime → Complex := conicOperator ((2 : Real) ^ j)
    (dyadicBandpassMultiplier C.cutoff 0) ϑ (f : Euclidean 2 → Complex)
  have hg : AEStronglyMeasurable g volume := hmeas
  have hae : (g ∘ timeReflectWaveSpaceTime) =ᵐ[localSmoothingMeasure]
      dyadicHalfWaveSpaceTime C.cutoff WaveSign.minus j f := by
    change (fun z => g (timeReflectWaveSpaceTime z)) =ᵐ[localSmoothingMeasure]
      dyadicHalfWaveSpaceTime C.cutoff WaveSign.minus j f
    exact ae_eq_conicOperator_timeReflect_dyadicHalfWaveSpaceTime_minus C ϑ j f hϑ
  have hglobal : eLpNorm (g ∘ timeReflectWaveSpaceTime) (4 : ENNReal) volume =
      eLpNorm g (4 : ENNReal) volume :=
    eLpNorm_comp_measurePreserving hg timeReflectWaveSpaceTime_measurePreserving
  change eLpNorm (dyadicHalfWaveSpaceTime C.cutoff WaveSign.minus j f) (4 : ENNReal)
      localSmoothingMeasure ≤ eLpNorm g (4 : ENNReal) volume
  rw [← eLpNorm_congr_ae hae]
  calc
    eLpNorm (g ∘ timeReflectWaveSpaceTime) (4 : ENNReal) localSmoothingMeasure ≤
      eLpNorm (g ∘ timeReflectWaveSpaceTime) (4 : ENNReal) volume :=
      eLpNorm_mono_measure _ localSmoothingMeasure_le_volume
    _ = eLpNorm g (4 : ENNReal) volume := hglobal

/-- The set of radial indices relevant to a frequency annulus at scale
`scale`.  This is the direct formal spelling of the distance-to-interval
condition in the MSS decomposition. -/
def relevantRadialIndices (scale : Real) : Set Int :=
  {n | ∃ s ∈ Icc (Real.sqrt scale / 2) (2 * Real.sqrt scale),
    |(n : Real) - s| < 3}

/-- Membership in the set of relevant radial indices is precisely the
witnessed distance-to-interval condition. -/
theorem mem_relevantRadialIndices_iff (scale : Real) (n : Int) :
    n ∈ relevantRadialIndices scale ↔
      ∃ s ∈ Icc (Real.sqrt scale / 2) (2 * Real.sqrt scale), |(n : Real) - s| < 3 :=
  Iff.rfl

/-- The support calculation behind the relevant-index lemma: a frequency in
the annulus, whose normalized radius is within three of an integer label,
has that label in the finite radial family. -/
theorem mem_relevantRadialIndices_of_mem_annulus_of_abs_sub_lt
    {scale : Real} (hscale : 0 < scale) {ξ : Euclidean 2} {n : Int}
    (hξ : ‖ξ‖ ∈ Icc (scale / 2) (2 * scale))
    (hn : |(n : Real) - (Real.sqrt scale)⁻¹ * ‖ξ‖| < 3) :
    n ∈ relevantRadialIndices scale := by
  have hsqrt : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
  have hleft : Real.sqrt scale / 2 ≤ (Real.sqrt scale)⁻¹ * ‖ξ‖ := by
    rw [show (Real.sqrt scale)⁻¹ * ‖ξ‖ = ‖ξ‖ / Real.sqrt scale by
      rw [div_eq_mul_inv, mul_comm]]
    apply (le_div_iff₀ hsqrt).2
    calc
      Real.sqrt scale / 2 * Real.sqrt scale = (Real.sqrt scale) ^ 2 / 2 := by
        ring
      _ = scale / 2 := by rw [Real.sq_sqrt hscale.le]
      _ ≤ ‖ξ‖ := hξ.1
  have hright : (Real.sqrt scale)⁻¹ * ‖ξ‖ ≤ 2 * Real.sqrt scale := by
    rw [show (Real.sqrt scale)⁻¹ * ‖ξ‖ = ‖ξ‖ / Real.sqrt scale by
      rw [div_eq_mul_inv, mul_comm]]
    apply (div_le_iff₀ hsqrt).2
    calc
      ‖ξ‖ ≤ 2 * scale := hξ.2
      _ = 2 * Real.sqrt scale * Real.sqrt scale := by
        nlinarith [Real.sq_sqrt hscale.le]
  exact ⟨(Real.sqrt scale)⁻¹ * ‖ξ‖, ⟨hleft, hright⟩, hn⟩

/-- A finite enumeration of the relevant radial indices at every scale.  Its
existence and cardinality estimate are part of the radial localization work;
this predicate records the exact interface needed by the reconstruction. -/
def HasRelevantRadialEnumeration (indices : Real → Finset Int) : Prop :=
  ∀ scale : Real, ∀ n : Int,
    n ∈ indices scale ↔ n ∈ relevantRadialIndices scale

/-- A concrete finite interval containing every radial index which can meet
the annulus at a given scale. -/
noncomputable def relevantRadialIndexBounds (scale : Real) : Finset Int :=
  Finset.Icc ⌊Real.sqrt scale / 2 - 3⌋ ⌈2 * Real.sqrt scale + 3⌉

/-- The exact finite enumeration of radial indices relevant to the annulus.
It is obtained by filtering the explicit integer interval of possible labels. -/
noncomputable def relevantRadialIndexEnumeration (scale : Real) : Finset Int := by
  classical
  exact (relevantRadialIndexBounds scale).filter
    (fun n => n ∈ relevantRadialIndices scale)

/-- Every relevant radial index lies in the explicit finite interval used for
the enumeration. -/
theorem mem_relevantRadialIndexBounds_of_mem_relevantRadialIndices
    (scale : Real) (n : Int) (hn : n ∈ relevantRadialIndices scale) :
    n ∈ relevantRadialIndexBounds scale := by
  rcases hn with ⟨s, hs, hdist⟩
  rw [relevantRadialIndexBounds, Finset.mem_Icc]
  have hdist' : -3 < (n : Real) - s ∧ (n : Real) - s < 3 := abs_lt.mp hdist
  constructor
  · have hlower : Real.sqrt scale / 2 - 3 ≤ (n : Real) := by
      linarith [hs.1, hdist'.1]
    have hfloor := Int.floor_le_floor hlower
    simpa using hfloor
  · have hupper : (n : Real) ≤ 2 * Real.sqrt scale + 3 := by
      linarith [hs.2, hdist'.2]
    have hceil := Int.ceil_le_ceil hupper
    simpa using hceil

/-- Membership in the explicit enumeration is exactly relevance to the
frequency annulus. -/
theorem mem_relevantRadialIndexEnumeration_iff (scale : Real) (n : Int) :
    n ∈ relevantRadialIndexEnumeration scale ↔ n ∈ relevantRadialIndices scale := by
  classical
  simp only [relevantRadialIndexEnumeration, Finset.mem_filter]
  constructor
  · exact fun h => h.2
  · intro hn
    exact ⟨mem_relevantRadialIndexBounds_of_mem_relevantRadialIndices scale n hn, hn⟩

/-- The explicit radial-index family supplies the finite enumeration required
by the radial--time reconstruction. -/
theorem hasRelevantRadialEnumeration_relevantRadialIndexEnumeration :
    HasRelevantRadialEnumeration relevantRadialIndexEnumeration := by
  intro scale n
  exact mem_relevantRadialIndexEnumeration_iff scale n

/-- The explicit radial enumeration is a subfamily of its bounding integer
interval. -/
theorem relevantRadialIndexEnumeration_subset_bounds (scale : Real) :
    relevantRadialIndexEnumeration scale ⊆ relevantRadialIndexBounds scale := by
  classical
  rw [relevantRadialIndexEnumeration]
  exact Finset.filter_subset _ _

/-- Exact cardinality of the integer interval used to bound the radial labels. -/
theorem card_relevantRadialIndexBounds (scale : Real) :
    (relevantRadialIndexBounds scale).card =
      (⌈2 * Real.sqrt scale + 3⌉ + 1 - ⌊Real.sqrt scale / 2 - 3⌋).toNat := by
  simp [relevantRadialIndexBounds, Int.card_Icc]

/-- Exact finite cardinality bound for the relevant radial labels. -/
theorem card_relevantRadialIndexEnumeration_le (scale : Real) :
    (relevantRadialIndexEnumeration scale).card ≤
      (⌈2 * Real.sqrt scale + 3⌉ + 1 - ⌊Real.sqrt scale / 2 - 3⌋).toNat := by
  calc
    (relevantRadialIndexEnumeration scale).card ≤
        (relevantRadialIndexBounds scale).card :=
      Finset.card_le_card (relevantRadialIndexEnumeration_subset_bounds scale)
    _ = (⌈2 * Real.sqrt scale + 3⌉ + 1 - ⌊Real.sqrt scale / 2 - 3⌋).toNat :=
      card_relevantRadialIndexBounds scale

/-- A simple scale-explicit count of the relevant radial labels.  This is the
finite-index estimate used before vertical recombination. -/
theorem card_relevantRadialIndexEnumeration_le_two_mul_natCeil_sqrt_add_seven
    (scale : Real) :
    (relevantRadialIndexEnumeration scale).card ≤
      2 * ⌈Real.sqrt scale⌉₊ + 7 := by
  let bounds : Finset Int :=
    Finset.Icc (-3) (2 * (⌈Real.sqrt scale⌉₊ : Int) + 3)
  have hsubset : relevantRadialIndexEnumeration scale ⊆ bounds := by
    intro n hn
    have hn' : n ∈ relevantRadialIndices scale :=
      (mem_relevantRadialIndexEnumeration_iff scale n).mp hn
    rcases hn' with ⟨s, hs, hdist⟩
    have hdist' : -3 < (n : Real) - s ∧ (n : Real) - s < 3 := abs_lt.mp hdist
    have hsnonneg : 0 ≤ s := by
      have hroot : 0 ≤ Real.sqrt scale / 2 := by positivity
      exact hroot.trans hs.1
    have hlower : (-3 : Real) ≤ (n : Real) := by
      linarith [hdist'.1]
    have hceil : Real.sqrt scale ≤ (⌈Real.sqrt scale⌉₊ : Real) := Nat.le_ceil _
    have hupper : (n : Real) ≤ 2 * (⌈Real.sqrt scale⌉₊ : Real) + 3 := by
      linarith [hs.2, hdist'.2]
    dsimp [bounds]
    rw [Finset.mem_Icc]
    constructor
    · exact_mod_cast hlower
    · exact_mod_cast hupper
  calc
    (relevantRadialIndexEnumeration scale).card ≤ bounds.card :=
      Finset.card_le_card hsubset
    _ = 2 * ⌈Real.sqrt scale⌉₊ + 7 := by
      dsimp [bounds]
      rw [Int.card_Icc]
      have hcast :
          2 * (⌈Real.sqrt scale⌉₊ : Int) + 3 + 1 + 3 =
            ((2 * ⌈Real.sqrt scale⌉₊ + 7 : Nat) : Int) := by
        push_cast
        ring
      simp only [sub_neg_eq_add]
      rw [hcast]
      rfl

/-- The relevant radial labels have cardinality `O(sqrt scale)` with an
explicit absolute constant on the scales used in the MSS argument. -/
theorem card_relevantRadialIndexEnumeration_le_eleven_mul_sqrt
    {scale : Real} (hscale : 2 ≤ scale) :
    ((relevantRadialIndexEnumeration scale).card : Real) ≤ 11 * Real.sqrt scale := by
  have hcount :
      ((relevantRadialIndexEnumeration scale).card : Real) ≤
        2 * (⌈Real.sqrt scale⌉₊ : Real) + 7 := by
    exact_mod_cast
      card_relevantRadialIndexEnumeration_le_two_mul_natCeil_sqrt_add_seven scale
  have hsqrt : 1 ≤ Real.sqrt scale := by
    exact Real.one_le_sqrt.mpr (by linarith)
  have hceil : (⌈Real.sqrt scale⌉₊ : Real) ≤ Real.sqrt scale + 1 :=
    (Nat.ceil_lt_add_one (Real.sqrt_nonneg _)).le
  calc
    ((relevantRadialIndexEnumeration scale).card : Real) ≤
        2 * (⌈Real.sqrt scale⌉₊ : Real) + 7 := hcount
    _ ≤ 11 * Real.sqrt scale := by linarith

/-- Blueprint-faithful cutoff data for radial--time localization.

The vertical cutoff has the squared integer-translate partition, while the
radial cutoff is one on an enlarged overlap region and supported in a
strictly smaller enlargement.  This harmless slack is a standard choice of
the blueprint cutoffs; it makes the radial norm profile smooth at the origin.
Both cutoffs and the physical time cutoff are Schwartz representatives;
compact support is kept explicit because the localization proof needs its
Fourier-side consequences. -/
structure MSSRadialTimeCutoffs where
  vertical : SchwartzMap Real Complex
  radial : SchwartzMap Real Complex
  amplitude : SchwartzMap (Euclidean 2) Complex
  time : SchwartzMap Real Complex
  /-- A smooth global representative of the radial phase on the active
  annulus.  It is auxiliary cutoff data, not a replacement for the literal
  norm in the statement of the residual. -/
  normalExtension : SchwartzMap (Euclidean 2) Real
  amplitude_compact : HasCompactSupport (amplitude : Euclidean 2 → Complex)
  amplitude_support_annulus : ∀ xi ∈ Function.support
      (amplitude : Euclidean 2 → Complex),
    ‖xi‖ ∈ Icc (1 / 2 : Real) 2
  normalExtension_eq_norm_on_amplitude : ∀ xi ∈ Function.support
      (amplitude : Euclidean 2 → Complex),
    normalExtension xi = ‖xi‖
  time_compact : HasCompactSupport (time : Real → Complex)
  time_one_on_unit_slab : ∀ t ∈ Icc (1 : Real) 2, time t = 1
  vertical_support : ∀ s : Real, vertical s ≠ 0 → |s| < 1
  vertical_square_partition : ∀ s : Real,
    ∑' n : Int, (vertical (s - n)) ^ 2 = 1
  radial_support : ∀ s : Real, radial s ≠ 0 → |s| < 11 / 4
  radial_one : ∀ s : Real, |s| ≤ 9 / 4 → radial s = 1

/-- A compactly supported vertical partition may be replaced by its finite
active subfamily once every omitted summand vanishes. -/
theorem MSSRadialTimeCutoffs.vertical_square_sum_eq_one_of_zero_off_indices
    (D : MSSRadialTimeCutoffs) (s : Real) (indices : Finset Int)
    (hzero : ∀ n : Int, n ∉ indices → D.vertical (s - n) ^ 2 = 0) :
    ∑ n ∈ indices, D.vertical (s - n) ^ 2 = 1 := by
  rw [← D.vertical_square_partition s]
  exact (tsum_eq_sum hzero).symm

/-- A vertical label which is active within one normal `sqrt scale` of the
cone is relevant, and its radial factor is identically one. -/
theorem relevantRadialIndex_and_radial_one_of_near_cone
    (D : MSSRadialTimeCutoffs) {scale : Real} (hscale : 0 < scale)
    {eta : Euclidean 2} (heta : ‖eta‖ ∈ Icc (scale / 2) (2 * scale))
    {tau : Real} {n : Int}
    (hnear : |tau - ‖eta‖| < Real.sqrt scale)
    (hvertical : D.vertical ((Real.sqrt scale)⁻¹ * tau - n) ≠ 0) :
    n ∈ relevantRadialIndices scale ∧
      D.radial ((Real.sqrt scale)⁻¹ * ‖eta‖ - n) = 1 := by
  let root : Real := Real.sqrt scale
  let s : Real := root⁻¹ * tau
  let r : Real := root⁻¹ * ‖eta‖
  have hroot : 0 < root := by
    dsimp only [root]
    exact Real.sqrt_pos.2 hscale
  have hsr : |s - r| < 1 := by
    dsimp only [s, r]
    rw [← mul_sub]
    calc
      |root⁻¹ * (tau - ‖eta‖)| = |tau - ‖eta‖| / root := by
        rw [abs_mul, abs_inv, abs_of_pos hroot, div_eq_mul_inv, mul_comm]
      _ < 1 := (div_lt_one₀ hroot).mpr (by simpa only [root] using hnear)
  have hsn : |s - n| < 1 := by
    apply D.vertical_support
    simpa only [s] using hvertical
  have hrn : |r - n| < 2 := by
    calc
      |r - n| ≤ |r - s| + |s - n| := abs_sub_le r s n
      _ = |s - r| + |s - n| := by rw [abs_sub_comm r s]
      _ < 1 + 1 := add_lt_add hsr hsn
      _ = 2 := by norm_num
  have hnr : |(n : Real) - r| < 3 := by
    calc
      |(n : Real) - r| = |r - n| := abs_sub_comm _ _
      _ < 2 := hrn
      _ < 3 := by norm_num
  constructor
  · apply mem_relevantRadialIndices_of_mem_annulus_of_abs_sub_lt hscale heta
    simpa only [r] using hnr
  · apply D.radial_one
    exact hrn.le.trans (by norm_num)

/-- The finite radial--vertical partition is exactly one on an active annular
frequency within one normal `sqrt scale` of the cone. -/
theorem finite_vertical_radial_partition_eq_one_on_near_cone
    (D : MSSRadialTimeCutoffs) {scale : Real} (hscale : 0 < scale)
    {eta : Euclidean 2} (heta : ‖eta‖ ∈ Icc (scale / 2) (2 * scale))
    {tau : Real} (hnear : |tau - ‖eta‖| < Real.sqrt scale) :
    ∑ n ∈ relevantRadialIndexEnumeration scale,
      D.vertical ((Real.sqrt scale)⁻¹ * tau - n) ^ 2 *
        D.radial ((Real.sqrt scale)⁻¹ * ‖eta‖ - n) = 1 := by
  have hzero : ∀ n : Int, n ∉ relevantRadialIndexEnumeration scale →
      D.vertical ((Real.sqrt scale)⁻¹ * tau - n) ^ 2 = 0 := by
    intro n hn
    by_cases hvertical : D.vertical ((Real.sqrt scale)⁻¹ * tau - n) = 0
    · simp [hvertical]
    · exfalso
      exact hn ((mem_relevantRadialIndexEnumeration_iff scale n).mpr
        (relevantRadialIndex_and_radial_one_of_near_cone
          D hscale heta hnear hvertical).1)
  have hverticalsum := D.vertical_square_sum_eq_one_of_zero_off_indices
    ((Real.sqrt scale)⁻¹ * tau) (relevantRadialIndexEnumeration scale) hzero
  calc
    ∑ n ∈ relevantRadialIndexEnumeration scale,
        D.vertical ((Real.sqrt scale)⁻¹ * tau - n) ^ 2 *
          D.radial ((Real.sqrt scale)⁻¹ * ‖eta‖ - n) =
      ∑ n ∈ relevantRadialIndexEnumeration scale,
        D.vertical ((Real.sqrt scale)⁻¹ * tau - n) ^ 2 := by
        apply Finset.sum_congr rfl
        intro n hn
        by_cases hvertical : D.vertical ((Real.sqrt scale)⁻¹ * tau - n) = 0
        · simp [hvertical]
        · rw [(relevantRadialIndex_and_radial_one_of_near_cone
            D hscale heta hnear hvertical).2]
          ring
    _ = 1 := hverticalsum

/-- The finite radial--vertical reconstruction from the MSS decomposition.
It has the blueprint's two vertical factors: the displayed outer projection
and the inner projection in each input packet. -/
noncomputable def radialTimeReconstruction (verticalCutoff radialCutoff : Real → Complex)
    (indices : Real → Finset Int) (scale : Real) (a : Euclidean 2 → Complex)
    (ϑ : Real → Complex) (f : Euclidean 2 → Complex) : WaveSpaceTime → Complex :=
  fun z => ∑ n ∈ indices scale,
    verticalProjection verticalCutoff scale n
      (verticalProjection verticalCutoff scale n
        (conicOperator scale a ϑ (radialPiece radialCutoff scale n f))) z

/-- The error remaining after the finite radial--vertical reconstruction. -/
noncomputable def radialTimeResidual (verticalCutoff radialCutoff : Real → Complex)
    (indices : Real → Finset Int) (scale : Real) (a : Euclidean 2 → Complex)
    (ϑ : Real → Complex) (f : Euclidean 2 → Complex) : WaveSpaceTime → Complex :=
  fun z => conicOperator scale a ϑ f z -
    radialTimeReconstruction verticalCutoff radialCutoff indices scale a ϑ f z

/-- The literal radial cutoff viewed as a planar multiplier.  The `9/4`--
`11/4` slack in `MSSRadialTimeCutoffs` makes this smooth even at the origin. -/
private def scratchRawRadialMultiplier (D : MSSRadialTimeCutoffs) (scale : Real) (n : Int) :
    Euclidean 2 → Complex :=
  fun xi => D.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n)

private theorem scratchRawRadialMultiplier_apply (D : MSSRadialTimeCutoffs)
    (scale : Real) (n : Int) (xi : Euclidean 2) :
    scratchRawRadialMultiplier D scale n xi =
      D.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n) := rfl

private theorem scratch_int_abs_le_two_or_three_le (n : Int) :
    |(n : Real)| ≤ 2 ∨ 3 ≤ |(n : Real)| := by
  by_cases hn : |n| ≤ 2
  · left
    exact_mod_cast hn
  · right
    have hn' : 3 ≤ |n| := by omega
    exact_mod_cast hn'

private theorem scratch_scaled_norm_lt_quarter_of_mem_ball
    {scale : Real} (hscale : 0 < scale) {xi : Euclidean 2}
    (hxi : xi ∈ Metric.ball (0 : Euclidean 2) (Real.sqrt scale / 4)) :
    (Real.sqrt scale)⁻¹ * ‖xi‖ < 1 / 4 := by
  have hroot : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
  have hxinorm : ‖xi‖ < Real.sqrt scale / 4 := by
    simpa only [Metric.mem_ball, dist_zero_right] using hxi
  rw [show (Real.sqrt scale)⁻¹ * ‖xi‖ = ‖xi‖ / Real.sqrt scale by ring]
  apply (div_lt_iff₀ hroot).mpr
  calc
    ‖xi‖ < Real.sqrt scale / 4 := hxinorm
    _ = (1 / 4 : Real) * Real.sqrt scale := by ring

private theorem scratchRawRadialMultiplier_eq_one_near_zero
    (D : MSSRadialTimeCutoffs) {scale : Real} (hscale : 0 < scale) (n : Int)
    (hn : |(n : Real)| ≤ 2) :
    scratchRawRadialMultiplier D scale n =ᶠ[nhds 0] fun _ => 1 := by
  have hroot : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
  filter_upwards [Metric.ball_mem_nhds (0 : Euclidean 2)
      (by positivity : 0 < Real.sqrt scale / 4)] with xi hxi
  have hscaled : (Real.sqrt scale)⁻¹ * ‖xi‖ < 1 / 4 :=
    scratch_scaled_norm_lt_quarter_of_mem_ball hscale hxi
  have hnonneg : 0 ≤ (Real.sqrt scale)⁻¹ * ‖xi‖ := by positivity
  rw [scratchRawRadialMultiplier_apply]
  apply D.radial_one
  calc
    |(Real.sqrt scale)⁻¹ * ‖xi‖ - (n : Real)| ≤
        |(Real.sqrt scale)⁻¹ * ‖xi‖| + |(n : Real)| := by
          calc
            |(Real.sqrt scale)⁻¹ * ‖xi‖ - (n : Real)| =
                |(Real.sqrt scale)⁻¹ * ‖xi‖ + -(n : Real)| := by
                  rw [sub_eq_add_neg]
            _ ≤ |(Real.sqrt scale)⁻¹ * ‖xi‖| + |-(n : Real)| := abs_add_le _ _
            _ = |(Real.sqrt scale)⁻¹ * ‖xi‖| + |(n : Real)| := by rw [abs_neg]
    _ = (Real.sqrt scale)⁻¹ * ‖xi‖ + |(n : Real)| := by rw [abs_of_nonneg hnonneg]
    _ ≤ 1 / 4 + 2 := add_le_add hscaled.le hn
    _ = 9 / 4 := by norm_num

private theorem scratchRawRadialMultiplier_eq_zero_near_zero
    (D : MSSRadialTimeCutoffs) {scale : Real} (hscale : 0 < scale) (n : Int)
    (hn : 3 ≤ |(n : Real)|) :
    scratchRawRadialMultiplier D scale n =ᶠ[nhds 0] fun _ => 0 := by
  have hroot : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
  filter_upwards [Metric.ball_mem_nhds (0 : Euclidean 2)
      (by positivity : 0 < Real.sqrt scale / 4)] with xi hxi
  have hscaled : (Real.sqrt scale)⁻¹ * ‖xi‖ < 1 / 4 :=
    scratch_scaled_norm_lt_quarter_of_mem_ball hscale hxi
  have hnonneg : 0 ≤ (Real.sqrt scale)⁻¹ * ‖xi‖ := by positivity
  rw [scratchRawRadialMultiplier_apply]
  by_contra hne
  have hsupport := D.radial_support
    ((Real.sqrt scale)⁻¹ * ‖xi‖ - n) hne
  have hlower : |(n : Real)| - (Real.sqrt scale)⁻¹ * ‖xi‖ ≤
      |(Real.sqrt scale)⁻¹ * ‖xi‖ - (n : Real)| := by
    calc
      |(n : Real)| - (Real.sqrt scale)⁻¹ * ‖xi‖ =
          |(n : Real)| - |(Real.sqrt scale)⁻¹ * ‖xi‖| := by
            rw [abs_of_nonneg hnonneg]
      _ ≤ |(n : Real) - (Real.sqrt scale)⁻¹ * ‖xi‖| :=
        abs_sub_abs_le_abs_sub _ _
      _ = |(Real.sqrt scale)⁻¹ * ‖xi‖ - (n : Real)| := abs_sub_comm _ _
  linarith

private theorem scratch_contDiff_rawRadialMultiplier
    (D : MSSRadialTimeCutoffs) {scale : Real} (hscale : 0 < scale) (n : Int) :
    ContDiff Real (⊤ : ℕ∞) (scratchRawRadialMultiplier D scale n) := by
  rw [contDiff_iff_contDiffAt]
  intro xi
  by_cases hxi : xi = 0
  · subst xi
    rcases scratch_int_abs_le_two_or_three_le n with hn | hn
    · exact (contDiffAt_const (c := (1 : Complex))).congr_of_eventuallyEq
        (scratchRawRadialMultiplier_eq_one_near_zero D hscale n hn)
    · exact (contDiffAt_const (c := (0 : Complex))).congr_of_eventuallyEq
        (scratchRawRadialMultiplier_eq_zero_near_zero D hscale n hn)
  · have hnorm : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 => ‖eta‖) xi :=
      contDiffAt_norm Real hxi
    have harg : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
        (Real.sqrt scale)⁻¹ * ‖eta‖ - (n : Real)) xi := by
      exact (contDiffAt_const.mul hnorm).sub contDiffAt_const

    exact (D.radial.smooth (⊤ : ℕ∞)).contDiffAt.comp xi harg

private theorem scratch_hasCompactSupport_rawRadialMultiplier
    (D : MSSRadialTimeCutoffs) {scale : Real} (hscale : 0 < scale) (n : Int) :
    HasCompactSupport (scratchRawRadialMultiplier D scale n) := by
  have hroot : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
  apply HasCompactSupport.intro
    (isCompact_closedBall (0 : Euclidean 2)
      (Real.sqrt scale * (|(n : Real)| + 11 / 4)))
  intro xi hxi
  have hxinorm : Real.sqrt scale * (|(n : Real)| + 11 / 4) ≤ ‖xi‖ := by
    rw [Metric.mem_closedBall, dist_zero_right] at hxi
    exact le_of_not_ge hxi
  have hscaled : |(n : Real)| + 11 / 4 ≤
      (Real.sqrt scale)⁻¹ * ‖xi‖ := by
    rw [show (Real.sqrt scale)⁻¹ * ‖xi‖ = ‖xi‖ / Real.sqrt scale by ring]
    apply (le_div_iff₀ hroot).mpr
    calc
      (|(n : Real)| + 11 / 4) * Real.sqrt scale =
          Real.sqrt scale * (|(n : Real)| + 11 / 4) := by ring
      _ ≤ ‖xi‖ := hxinorm
  have hnonneg : 0 ≤ (Real.sqrt scale)⁻¹ * ‖xi‖ := by positivity
  rw [scratchRawRadialMultiplier_apply]
  by_contra hne
  have hsupport := D.radial_support
    ((Real.sqrt scale)⁻¹ * ‖xi‖ - n) hne
  have hlower : 11 / 4 ≤
      |(Real.sqrt scale)⁻¹ * ‖xi‖ - (n : Real)| := by
    calc
      11 / 4 ≤ (Real.sqrt scale)⁻¹ * ‖xi‖ - |(n : Real)| := by linarith
      _ = |(Real.sqrt scale)⁻¹ * ‖xi‖| - |(n : Real)| := by
        rw [abs_of_nonneg hnonneg]
      _ ≤ |(Real.sqrt scale)⁻¹ * ‖xi‖ - (n : Real)| :=
        abs_sub_abs_le_abs_sub _ _
  exact (not_lt_of_ge hlower) hsupport

/-- The actual global Schwartz representative of the raw radial multiplier.
Unlike the old abstract representative hypothesis, this is constructed from
the slack of `MSSRadialTimeCutoffs`. -/
private noncomputable def scratchRadialSchwartzProfile
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    SchwartzMap (Euclidean 2) Complex :=
  (scratch_hasCompactSupport_rawRadialMultiplier D hscale n).toSchwartzMap
    (scratch_contDiff_rawRadialMultiplier D hscale n)

private theorem scratchRadialSchwartzProfile_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (xi : Euclidean 2) :
    scratchRadialSchwartzProfile D scale hscale n xi =
      D.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n) := rfl

/-- Scale the supplied normal extension so that it agrees with `‖xi‖` on
the scaled amplitude annulus. -/
private noncomputable def scratchScaledNormalExtension
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) :
    SchwartzMap (Euclidean 2) Real :=
  let A : Euclidean 2 ≃L[Real] Euclidean 2 :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 scale⁻¹ (inv_ne_zero hscale.ne'))
  scale • ((SchwartzMap.compCLMOfContinuousLinearEquiv Real A) D.normalExtension)

private theorem scratchScaledNormalExtension_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (xi : Euclidean 2) :
    scratchScaledNormalExtension D scale hscale xi =
      scale * D.normalExtension (scale⁻¹ • xi) := by
  unfold scratchScaledNormalExtension
  dsimp
  change scale • D.normalExtension (scale⁻¹ • xi) = _
  rfl

private theorem scratch_scaledAmplitude_hasTemperateGrowth
    (D : MSSRadialTimeCutoffs) (scale : Real) :
    (fun xi : Euclidean 2 => D.amplitude (scale⁻¹ • xi)).HasTemperateGrowth := by
  fun_prop

/-- The literal planar Fourier amplitude of the unprojected conic packet. -/
private noncomputable def scratchRawConicBase
    (D : MSSRadialTimeCutoffs) (scale : Real)
    (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex
    (fun xi : Euclidean 2 => D.amplitude (scale⁻¹ • xi))
    (FourierTransform.fourier f)

private theorem scratchRawConicBase_apply
    (D : MSSRadialTimeCutoffs) (scale : Real)
    (f : SchwartzMap (Euclidean 2) Complex) (xi : Euclidean 2) :
    scratchRawConicBase D scale f xi =
      D.amplitude (scale⁻¹ • xi) * FourierTransform.fourier
        (f : Euclidean 2 → Complex) xi := by
  unfold scratchRawConicBase
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (scratch_scaledAmplitude_hasTemperateGrowth D scale)]
  rw [SchwartzMap.fourier_coe]
  rfl

/-- The scaled normal extension is the literal norm wherever the raw conic
base can be nonzero. -/
private theorem scratchScaledNormalExtension_eq_norm_on_rawConicBase_support

    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (f : SchwartzMap (Euclidean 2) Complex) :
    ∀ xi ∈ Function.support (scratchRawConicBase D scale f : Euclidean 2 → Complex),
      scratchScaledNormalExtension D scale hscale xi = ‖xi‖ := by
  intro xi hxi
  have hamp : D.amplitude (scale⁻¹ • xi) ≠ 0 := by
    intro hz
    apply hxi
    rw [scratchRawConicBase_apply, hz, zero_mul]
  have hnormal := D.normalExtension_eq_norm_on_amplitude
    (scale⁻¹ • xi) hamp
  rw [scratchScaledNormalExtension_apply, hnormal, norm_smul,
    Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hscale)]
  field_simp [hscale.ne']

/-- The joint-Schwartz spectral realization of the literal unprojected
conic packet. -/
private noncomputable def scratchRawConicSpectrum
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  jointSchwartzModulatedAnnularProfile (scratchRawConicBase D scale f) D.time
    (scratchScaledNormalExtension D scale hscale)

/-- This is a raw equality: the literal `conicOperator`, not a replacement
model, is the inverse joint Fourier transform of the displayed spectrum. -/
private theorem scratch_conicOperator_eq_inverse_rawConicSpectrum
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (f : SchwartzMap (Euclidean 2) Complex) :
    conicOperator scale (D.amplitude : Euclidean 2 → Complex)
        (D.time : Real → Complex) (f : Euclidean 2 → Complex) =
      spaceTimeFourierInv (jointSchwartzRaw
        (scratchRawConicSpectrum D scale hscale f)) := by
  funext z
  unfold scratchRawConicSpectrum
  rw [spaceTimeFourierInv_jointSchwartzModulatedAnnularProfile_eq_halfWave_of_eq_norm_on_support
    (scratchRawConicBase D scale f) D.time (scratchScaledNormalExtension D scale hscale)
    (scratchScaledNormalExtension_eq_norm_on_rawConicBase_support D scale hscale f) z]
  unfold conicOperator
  apply congrArg (fun q : Euclidean 2 → Complex =>
    D.time z.2 * FourierTransform.fourierInv q z.1)
  funext xi
  rw [scratchRawConicBase_apply]
  ring

/-- The literal radial multiplier times the conic base, packaged as a
Schwartz spatial profile by the preceding slack construction. -/
private noncomputable def scratchRawConicRadialBase
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex
    (scratchRadialSchwartzProfile D scale hscale n : Euclidean 2 → Complex)
    (scratchRawConicBase D scale f)

private theorem scratchRawConicRadialBase_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex) (xi : Euclidean 2) :
    scratchRawConicRadialBase D scale hscale n f xi =
      D.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n) *
        scratchRawConicBase D scale f xi := by
  unfold scratchRawConicRadialBase
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (scratchRadialSchwartzProfile D scale hscale n).hasTemperateGrowth]
  rw [scratchRadialSchwartzProfile_apply]
  rfl

private theorem scratchRawConicRadialBase_support_subset_base
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Function.support (scratchRawConicRadialBase D scale hscale n f :
      Euclidean 2 → Complex) ⊆
      Function.support (scratchRawConicBase D scale f : Euclidean 2 → Complex) := by
  intro xi hxi
  change scratchRawConicRadialBase D scale hscale n f xi ≠ 0 at hxi
  change scratchRawConicBase D scale f xi ≠ 0
  intro hbase
  apply hxi
  rw [scratchRawConicRadialBase_apply, hbase, mul_zero]

private theorem scratchScaledNormalExtension_eq_norm_on_rawConicRadialBase_support
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    ∀ xi ∈ Function.support
        (scratchRawConicRadialBase D scale hscale n f : Euclidean 2 → Complex),
      scratchScaledNormalExtension D scale hscale xi = ‖xi‖ := by
  intro xi hxi
  exact scratchScaledNormalExtension_eq_norm_on_rawConicBase_support D scale hscale f xi
    (scratchRawConicRadialBase_support_subset_base D scale hscale n f hxi)

private noncomputable def scratchRawConicRadialSpectrum
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  jointSchwartzModulatedAnnularProfile
    (scratchRawConicRadialBase D scale hscale n f) D.time
    (scratchScaledNormalExtension D scale hscale)

private theorem scratchRawConicRadialSpectrum_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)

    (f : SchwartzMap (Euclidean 2) Complex) (zeta : WaveSpaceTime) :
    scratchRawConicRadialSpectrum D scale hscale n f (WithLp.toLp 2 zeta) =
      D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n) *
        scratchRawConicSpectrum D scale hscale f (WithLp.toLp 2 zeta) := by
  unfold scratchRawConicRadialSpectrum scratchRawConicSpectrum
  rw [jointSchwartzModulatedAnnularProfile_apply,
    jointSchwartzModulatedAnnularProfile_apply, scratchRawConicRadialBase_apply]
  ring

/-- The requested masked radial bridge: the raw conic operator on the
literal `radialPiece` is exactly the inverse joint-Schwartz radial profile. -/
private theorem scratch_conicOperator_radialPiece_eq_inverse_rawConicRadialSpectrum
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    conicOperator scale (D.amplitude : Euclidean 2 → Complex)
        (D.time : Real → Complex)
        (radialPiece (D.radial : Real → Complex) scale n
          (f : Euclidean 2 → Complex)) =
      spaceTimeFourierInv (jointSchwartzRaw
        (scratchRawConicRadialSpectrum D scale hscale n f)) := by
  funext z
  unfold scratchRawConicRadialSpectrum
  rw [spaceTimeFourierInv_jointSchwartzModulatedAnnularProfile_eq_halfWave_of_eq_norm_on_support
    (scratchRawConicRadialBase D scale hscale n f) D.time
    (scratchScaledNormalExtension D scale hscale)
    (scratchScaledNormalExtension_eq_norm_on_rawConicRadialBase_support
      D scale hscale n f) z]
  unfold conicOperator
  apply congrArg (fun q : Euclidean 2 → Complex =>
    D.time z.2 * FourierTransform.fourierInv q z.1)
  funext xi
  rw [fourier_radialPiece_eq_schwartzProfile_mul_fourier
    (D.radial : Real → Complex) scale n
    (scratchRadialSchwartzProfile D scale hscale n) f
    (scratchRadialSchwartzProfile_apply D scale hscale n) xi]
  rw [scratchRawConicRadialBase_apply, scratchRawConicBase_apply]
  rw [scratchRadialSchwartzProfile_apply]
  ring

/-- The shifted/dilated vertical window as a Schwartz temporal profile. -/
private noncomputable def scratchMaskedVerticalProfile
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) : SchwartzMap Real Complex :=
  let root : Real := Real.sqrt scale
  let A : Real ≃L[Real] Real :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 root⁻¹ (by
        dsimp only [root]
        exact inv_ne_zero (Real.sqrt_ne_zero'.mpr hscale)))
  ((SchwartzMap.compCLMOfContinuousLinearEquiv Complex A) beta).compSubConstCLM
    Complex (root * n)

private theorem scratchMaskedVerticalProfile_apply
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) (tau : Real) :
    scratchMaskedVerticalProfile beta scale n hscale tau =
      beta ((Real.sqrt scale)⁻¹ * tau - n) := by
  unfold scratchMaskedVerticalProfile
  dsimp
  change beta ((Real.sqrt scale)⁻¹ * (tau - Real.sqrt scale * n)) = _
  have hroot : Real.sqrt scale ≠ 0 := Real.sqrt_ne_zero'.mpr hscale
  field_simp [hroot]

private def scratchMaskedJointVerticalMultiplier
    (m : SchwartzMap Real Complex) : JointWaveSpaceTime → Complex :=
  fun z => m z.snd

private theorem scratchMaskedJointVerticalMultiplier_hasTemperateGrowth
    (m : SchwartzMap Real Complex) :
    (scratchMaskedJointVerticalMultiplier m).HasTemperateGrowth := by
  change (m ∘ WithLp.sndL 2 Real (Euclidean 2) Real).HasTemperateGrowth
  exact m.hasTemperateGrowth.comp
    (WithLp.sndL 2 Real (Euclidean 2) Real).hasTemperateGrowth

private noncomputable def scratchMaskedApplyVerticalSpectrum
    (m : SchwartzMap Real Complex)
    (Q : SchwartzMap JointWaveSpaceTime Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  SchwartzMap.smulLeftCLM Complex (scratchMaskedJointVerticalMultiplier m) Q

private theorem scratchMaskedApplyVerticalSpectrum_apply
    (m : SchwartzMap Real Complex)
    (Q : SchwartzMap JointWaveSpaceTime Complex) (zeta : WaveSpaceTime) :
    scratchMaskedApplyVerticalSpectrum m Q (WithLp.toLp 2 zeta) =
      m zeta.2 * Q (WithLp.toLp 2 zeta) := by
  unfold scratchMaskedApplyVerticalSpectrum
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (scratchMaskedJointVerticalMultiplier_hasTemperateGrowth m)]
  unfold scratchMaskedJointVerticalMultiplier
  rfl

private theorem scratchMasked_verticalProjection_eq_inverse_jointSpectrum
    (beta : Real → Complex) (scale : Real) (n : Int)
    (m : SchwartzMap Real Complex)
    (Q : SchwartzMap JointWaveSpaceTime Complex)
    (hprofile : ∀ tau : Real,
      m tau = beta ((Real.sqrt scale)⁻¹ * tau - n)) :
    verticalProjection beta scale n
        (spaceTimeFourierInv (jointSchwartzRaw Q)) =
      spaceTimeFourierInv

        (jointSchwartzRaw (scratchMaskedApplyVerticalSpectrum m Q)) := by
  have hmult :
      (fun zeta : WaveSpaceTime =>
        verticalMultiplier beta scale n zeta *
          spaceTimeFourier (spaceTimeFourierInv (jointSchwartzRaw Q)) zeta) =
        jointSchwartzRaw (scratchMaskedApplyVerticalSpectrum m Q) := by
    funext zeta
    rw [spaceTimeFourier_spaceTimeFourierInv_jointSchwartzRaw Q zeta]
    change verticalMultiplier beta scale n zeta * Q (WithLp.toLp 2 zeta) =
      scratchMaskedApplyVerticalSpectrum m Q (WithLp.toLp 2 zeta)
    rw [scratchMaskedApplyVerticalSpectrum_apply]
    rw [hprofile zeta.2]
    rfl
  unfold verticalProjection
  rw [hmult]

/-- The joint-Schwartz spectrum of the literal `V_n² T_lambda f_n` packet. -/
private noncomputable def scratchMaskedDoubleVerticalRadialSpectrum
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  let m := scratchMaskedVerticalProfile D.vertical scale n hscale
  scratchMaskedApplyVerticalSpectrum m
    (scratchMaskedApplyVerticalSpectrum m
      (scratchRawConicRadialSpectrum D scale hscale n f))

private noncomputable def scratchMaskedDoubleVerticalReconstructionSpectrum
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  ∑ n ∈ indices, scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f

private noncomputable def scratchMaskedDoubleVerticalResidualSpectrum
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  scratchRawConicSpectrum D scale hscale f -
    scratchMaskedDoubleVerticalReconstructionSpectrum D scale hscale indices f

private theorem scratchMaskedDoubleVerticalRadialSpectrum_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex) (zeta : WaveSpaceTime) :
    scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f
        (WithLp.toLp 2 zeta) =
      (verticalMultiplier (D.vertical : Real → Complex) scale n zeta) ^ 2 *
        D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n) *
          scratchRawConicSpectrum D scale hscale f (WithLp.toLp 2 zeta) := by
  unfold scratchMaskedDoubleVerticalRadialSpectrum
  dsimp
  rw [scratchMaskedApplyVerticalSpectrum_apply,
    scratchMaskedApplyVerticalSpectrum_apply,
    scratchRawConicRadialSpectrum_apply,
    scratchMaskedVerticalProfile_apply D.vertical scale n hscale]
  rw [verticalMultiplier]
  ring

private theorem scratchMasked_doubleVerticalRadialPhysical_eq
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    verticalProjection (D.vertical : Real → Complex) scale n
        (verticalProjection (D.vertical : Real → Complex) scale n
          (conicOperator scale (D.amplitude : Euclidean 2 → Complex)
            (D.time : Real → Complex)
            (radialPiece (D.radial : Real → Complex) scale n
              (f : Euclidean 2 → Complex)))) =
      spaceTimeFourierInv (jointSchwartzRaw
        (scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f)) := by
  rw [scratch_conicOperator_radialPiece_eq_inverse_rawConicRadialSpectrum
    D scale hscale n f]
  unfold scratchMaskedDoubleVerticalRadialSpectrum
  dsimp
  rw [scratchMasked_verticalProjection_eq_inverse_jointSpectrum
    (D.vertical : Real → Complex) scale n
    (scratchMaskedVerticalProfile D.vertical scale n hscale)
    (scratchRawConicRadialSpectrum D scale hscale n f)
    (scratchMaskedVerticalProfile_apply D.vertical scale n hscale)]
  rw [scratchMasked_verticalProjection_eq_inverse_jointSpectrum
    (D.vertical : Real → Complex) scale n
    (scratchMaskedVerticalProfile D.vertical scale n hscale)
    (scratchMaskedApplyVerticalSpectrum
      (scratchMaskedVerticalProfile D.vertical scale n hscale)
      (scratchRawConicRadialSpectrum D scale hscale n f))
    (scratchMaskedVerticalProfile_apply D.vertical scale n hscale)]

private theorem scratchMasked_doubleVerticalRadialInversePhysical_eq
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    verticalProjection (D.vertical : Real → Complex) scale n
        (verticalProjection (D.vertical : Real → Complex) scale n
          (spaceTimeFourierInv (jointSchwartzRaw
            (scratchRawConicRadialSpectrum D scale hscale n f)))) =
      spaceTimeFourierInv (jointSchwartzRaw
        (scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f)) := by
  rw [← scratch_conicOperator_radialPiece_eq_inverse_rawConicRadialSpectrum
    D scale hscale n f]
  exact scratchMasked_doubleVerticalRadialPhysical_eq D scale hscale n f

/-- The inverse transform of the explicit residual spectrum is precisely the
finite physical double-projection error, before the raw conic bridge is
substituted. -/

private theorem scratchMasked_doubleVerticalResidualPhysical_eq
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (f : SchwartzMap (Euclidean 2) Complex) :
    spaceTimeFourierInv
        (jointSchwartzRaw
          (scratchMaskedDoubleVerticalResidualSpectrum D scale hscale indices f)) =
      fun z =>
        spaceTimeFourierInv (jointSchwartzRaw
          (scratchRawConicSpectrum D scale hscale f)) z -
          ∑ n ∈ indices,
            verticalProjection (D.vertical : Real → Complex) scale n
              (verticalProjection (D.vertical : Real → Complex) scale n
                (spaceTimeFourierInv (jointSchwartzRaw
                  (scratchRawConicRadialSpectrum D scale hscale n f)))) z := by
  funext z
  rw [spaceTimeFourierInv_jointSchwartzRaw]
  unfold scratchMaskedDoubleVerticalResidualSpectrum
    scratchMaskedDoubleVerticalReconstructionSpectrum
  rw [← SchwartzMap.fourierInv_coe]
  rw [sub_eq_add_neg, FourierTransform.fourierInv_add,
    FourierTransform.fourierInv_neg, FourierTransform.fourierInv_sum]
  rw [spaceTimeFourierInv_jointSchwartzRaw]
  have hterm (n : Int) :=
    scratchMasked_doubleVerticalRadialInversePhysical_eq D scale hscale n f
  simp_rw [hterm]
  simp_rw [spaceTimeFourierInv_jointSchwartzRaw]
  simp_rw [← SchwartzMap.fourierInv_coe]
  change
    (FourierTransform.fourierInv (scratchRawConicSpectrum D scale hscale f) :
        SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 z) -
      (FunLike.coeAddMonoidHom
        (SchwartzMap JointWaveSpaceTime Complex)
        JointWaveSpaceTime Complex)
        (∑ n ∈ indices,
          FourierTransform.fourierInv
            (scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f))
          (WithLp.toLp 2 z) = _
  rw [map_sum, Finset.sum_apply]
  congr 1

/-- The literal source-level radial--time residual is exactly the inverse
joint Fourier transform of the explicit corrected double-projection profile. -/
private theorem scratchMasked_radialTimeResidual_eq_inverse_residualSpectrum
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (f : SchwartzMap (Euclidean 2) Complex) :
    radialTimeResidual (D.vertical : Real → Complex) (D.radial : Real → Complex)
        (fun _ => indices) scale (D.amplitude : Euclidean 2 → Complex)
        (D.time : Real → Complex) (f : Euclidean 2 → Complex) =
      spaceTimeFourierInv (jointSchwartzRaw
        (scratchMaskedDoubleVerticalResidualSpectrum D scale hscale indices f)) := by
  rw [scratchMasked_doubleVerticalResidualPhysical_eq D scale hscale indices f]
  funext z
  unfold radialTimeResidual radialTimeReconstruction
  rw [scratch_conicOperator_eq_inverse_rawConicSpectrum D scale hscale f]
  simp_rw [scratch_conicOperator_radialPiece_eq_inverse_rawConicRadialSpectrum
    D scale hscale]

/-- Exact Fourier-side error symbol for the finite corrected reconstruction. -/
private theorem scratchMasked_spaceTimeFourier_finiteDoubleVerticalResidual
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (f : SchwartzMap (Euclidean 2) Complex)
    (zeta : WaveSpaceTime) :
    spaceTimeFourier
        (spaceTimeFourierInv (jointSchwartzRaw
          (scratchMaskedDoubleVerticalResidualSpectrum D scale hscale indices f))) zeta =
      (1 - ∑ n ∈ indices,
        (verticalMultiplier (D.vertical : Real → Complex) scale n zeta) ^ 2 *
          D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n)) *
        scratchRawConicSpectrum D scale hscale f (WithLp.toLp 2 zeta) := by
  rw [spaceTimeFourier_spaceTimeFourierInv_jointSchwartzRaw]
  unfold scratchMaskedDoubleVerticalResidualSpectrum
    scratchMaskedDoubleVerticalReconstructionSpectrum
  have hsumapply :
      (∑ n ∈ indices,
        scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f)
          (WithLp.toLp 2 zeta) =
        ∑ n ∈ indices,
          scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f
            (WithLp.toLp 2 zeta) := by
    change (FunLike.coeAddMonoidHom
      (SchwartzMap JointWaveSpaceTime Complex)
      JointWaveSpaceTime Complex)
      (∑ n ∈ indices, scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f)
        (WithLp.toLp 2 zeta) = _
    rw [map_sum, Finset.sum_apply]
    apply Finset.sum_congr rfl
    intro n hn
    rfl
  rw [sub_apply, hsumapply]
  have hterm (n : Int) :
      scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f
          (WithLp.toLp 2 zeta) =
        (verticalMultiplier (D.vertical : Real → Complex) scale n zeta) ^ 2 *
          D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n) *
            scratchRawConicSpectrum D scale hscale f (WithLp.toLp 2 zeta) :=
    scratchMaskedDoubleVerticalRadialSpectrum_apply D scale hscale n f zeta
  simp_rw [hterm]
  rw [sub_mul, one_mul, Finset.sum_mul]

/-- The source-level corrected residual has the blueprint's exact finite

error multiplier. -/
private theorem scratchMasked_spaceTimeFourier_radialTimeResidual
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (f : SchwartzMap (Euclidean 2) Complex)
    (zeta : WaveSpaceTime) :
    spaceTimeFourier
        (radialTimeResidual (D.vertical : Real → Complex) (D.radial : Real → Complex)
          (fun _ => indices) scale (D.amplitude : Euclidean 2 → Complex)
          (D.time : Real → Complex) (f : Euclidean 2 → Complex)) zeta =
      (1 - ∑ n ∈ indices,
        (verticalMultiplier (D.vertical : Real → Complex) scale n zeta) ^ 2 *
          D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n)) *
        scratchRawConicSpectrum D scale hscale f (WithLp.toLp 2 zeta) := by
  rw [scratchMasked_radialTimeResidual_eq_inverse_residualSpectrum
    D scale hscale indices f]
  exact scratchMasked_spaceTimeFourier_finiteDoubleVerticalResidual
    D scale hscale indices f zeta

/-- The preceding raw-to-joint bridge in the source API's natural form,
where the finite enumeration is allowed to depend on the scale. -/
theorem radialTimeResidual_eq_inverse_mssRadialTimeResidualSpectrum
    (D : MSSRadialTimeCutoffs) (indices : Real → Finset Int)
    (scale : Real) (hscale : 0 < scale)
    (f : SchwartzMap (Euclidean 2) Complex) :
    radialTimeResidual (D.vertical : Real → Complex) (D.radial : Real → Complex)
        indices scale (D.amplitude : Euclidean 2 → Complex)
        (D.time : Real → Complex) (f : Euclidean 2 → Complex) =
      spaceTimeFourierInv (jointSchwartzRaw
        (scratchMaskedDoubleVerticalResidualSpectrum D scale hscale (indices scale) f)) := by
  change radialTimeResidual (D.vertical : Real → Complex) (D.radial : Real → Complex)
      (fun _ => indices scale) scale (D.amplitude : Euclidean 2 → Complex)
      (D.time : Real → Complex) (f : Euclidean 2 → Complex) = _
  exact scratchMasked_radialTimeResidual_eq_inverse_residualSpectrum
    D scale hscale (indices scale) f

theorem spaceTimeFourier_radialTimeResidual_mssRadialTime
    (D : MSSRadialTimeCutoffs) (indices : Real → Finset Int)
    (scale : Real) (hscale : 0 < scale)
    (f : SchwartzMap (Euclidean 2) Complex) (zeta : WaveSpaceTime) :
    spaceTimeFourier
        (radialTimeResidual (D.vertical : Real → Complex) (D.radial : Real → Complex)
          indices scale (D.amplitude : Euclidean 2 → Complex)
          (D.time : Real → Complex) (f : Euclidean 2 → Complex)) zeta =
      (1 - ∑ n ∈ indices scale,
        (verticalMultiplier (D.vertical : Real → Complex) scale n zeta) ^ 2 *
          D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n)) *
        scratchRawConicSpectrum D scale hscale f (WithLp.toLp 2 zeta) := by
  rw [radialTimeResidual_eq_inverse_mssRadialTimeResidualSpectrum
    D indices scale hscale f]
  exact scratchMasked_spaceTimeFourier_finiteDoubleVerticalResidual
    D scale hscale (indices scale) f zeta

/- The f-independent regular multiplier and exact residual factorization
used by the radial--time localization proof.  All declarations in this
block are private implementation details. -/
/-- The amplitude at the physical radial--time scale.  This is the spatial
Schwartz factor common to the raw conic spectrum and every projected term. -/
private noncomputable def mssRadialTimeScaledAmplitude
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) :
    SchwartzMap (Euclidean 2) Complex :=
  let A : Euclidean 2 ≃L[Real] Euclidean 2 :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 scale⁻¹ (inv_ne_zero hscale.ne'))
  (SchwartzMap.compCLMOfContinuousLinearEquiv Complex A) D.amplitude

private theorem mssRadialTimeScaledAmplitude_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (xi : Euclidean 2) :
    mssRadialTimeScaledAmplitude D scale hscale xi =
      D.amplitude (scale⁻¹ • xi) := by
  unfold mssRadialTimeScaledAmplitude
  dsimp
  rfl

private theorem scaledNormal_eq_norm_on_scaledAmplitude_support
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) :
    ∀ xi ∈ Function.support
      (mssRadialTimeScaledAmplitude D scale hscale : Euclidean 2 → Complex),
      scratchScaledNormalExtension D scale hscale xi = ‖xi‖ := by
  intro xi hxi
  change mssRadialTimeScaledAmplitude D scale hscale xi ≠ 0 at hxi
  have hamp : D.amplitude (scale⁻¹ • xi) ≠ 0 := by
    rwa [mssRadialTimeScaledAmplitude_apply] at hxi
  have hnormal := D.normalExtension_eq_norm_on_amplitude
    (scale⁻¹ • xi) hamp
  rw [scratchScaledNormalExtension_apply, hnormal, norm_smul,
    Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hscale)]
  field_simp [hscale.ne']

/-- The f-independent joint conic spectrum before the radial and vertical
projections. -/
private noncomputable def mssRadialTimeBaseMultiplier
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) :
    SchwartzMap JointWaveSpaceTime Complex :=
  jointSchwartzModulatedAnnularProfile
    (mssRadialTimeScaledAmplitude D scale hscale) D.time
    (scratchScaledNormalExtension D scale hscale)

private theorem mssRadialTimeBaseMultiplier_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (zeta : WaveSpaceTime) :
    mssRadialTimeBaseMultiplier D scale hscale (WithLp.toLp 2 zeta) =
      D.amplitude (scale⁻¹ • zeta.1) *
        FourierTransform.fourier (D.time : Real → Complex)
          (zeta.2 - scratchScaledNormalExtension D scale hscale zeta.1) := by
  unfold mssRadialTimeBaseMultiplier
  rw [jointSchwartzModulatedAnnularProfile_apply,
    mssRadialTimeScaledAmplitude_apply]

/-- The f-independent spatial radial piece of the residual multiplier. -/
private noncomputable def mssRadialTimeRadialAmplitude
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex
    (scratchRadialSchwartzProfile D scale hscale n : Euclidean 2 → Complex)
    (mssRadialTimeScaledAmplitude D scale hscale)

private theorem mssRadialTimeRadialAmplitude_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (xi : Euclidean 2) :
    mssRadialTimeRadialAmplitude D scale hscale n xi =
      D.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n) *
        D.amplitude (scale⁻¹ • xi) := by
  unfold mssRadialTimeRadialAmplitude
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (scratchRadialSchwartzProfile D scale hscale n).hasTemperateGrowth,
    scratchRadialSchwartzProfile_apply, mssRadialTimeScaledAmplitude_apply]
  rfl

/-- The raw f-independent radial spectral term. -/
private noncomputable def mssRadialTimeRadialMultiplierTerm
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    SchwartzMap JointWaveSpaceTime Complex :=
  jointSchwartzModulatedAnnularProfile
    (mssRadialTimeRadialAmplitude D scale hscale n) D.time
    (scratchScaledNormalExtension D scale hscale)

private theorem mssRadialTimeRadialMultiplierTerm_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (zeta : WaveSpaceTime) :
    mssRadialTimeRadialMultiplierTerm D scale hscale n (WithLp.toLp 2 zeta) =
      D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n) *
        mssRadialTimeBaseMultiplier D scale hscale (WithLp.toLp 2 zeta) := by
  unfold mssRadialTimeRadialMultiplierTerm mssRadialTimeBaseMultiplier
  rw [jointSchwartzModulatedAnnularProfile_apply,
    jointSchwartzModulatedAnnularProfile_apply, mssRadialTimeRadialAmplitude_apply,
    mssRadialTimeScaledAmplitude_apply]
  ring

/-- Apply the two literal vertical projections to an f-independent radial
term. -/
private noncomputable def mssRadialTimeDoubleVerticalMultiplierTerm
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    SchwartzMap JointWaveSpaceTime Complex :=
  let m := scratchMaskedVerticalProfile D.vertical scale n hscale
  scratchMaskedApplyVerticalSpectrum m
    (scratchMaskedApplyVerticalSpectrum m
      (mssRadialTimeRadialMultiplierTerm D scale hscale n))

private theorem mssRadialTimeDoubleVerticalMultiplierTerm_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (zeta : WaveSpaceTime) :
    mssRadialTimeDoubleVerticalMultiplierTerm D scale hscale n
        (WithLp.toLp 2 zeta) =
      (verticalMultiplier (D.vertical : Real → Complex) scale n zeta) ^ 2 *
        mssRadialTimeRadialMultiplierTerm D scale hscale n
          (WithLp.toLp 2 zeta) := by
  unfold mssRadialTimeDoubleVerticalMultiplierTerm
  dsimp
  rw [scratchMaskedApplyVerticalSpectrum_apply,
    scratchMaskedApplyVerticalSpectrum_apply,
    scratchMaskedVerticalProfile_apply D.vertical scale n hscale]
  rw [verticalMultiplier]
  ring

/-- The f-independent exact finite double-projection residual multiplier. -/
private noncomputable def mssRadialTimeResidualMultiplier
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) :
    SchwartzMap JointWaveSpaceTime Complex :=
  mssRadialTimeBaseMultiplier D scale hscale -
    ∑ n ∈ indices, mssRadialTimeDoubleVerticalMultiplierTerm D scale hscale n

private theorem mssRadialTimeResidualMultiplier_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (zeta : WaveSpaceTime) :
    mssRadialTimeResidualMultiplier D scale hscale indices (WithLp.toLp 2 zeta) =
      (1 - ∑ n ∈ indices,
        (verticalMultiplier (D.vertical : Real → Complex) scale n zeta) ^ 2 *
          D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n)) *
        (D.amplitude (scale⁻¹ • zeta.1) *
          FourierTransform.fourier (D.time : Real → Complex)
            (zeta.2 - scratchScaledNormalExtension D scale hscale zeta.1)) := by
  unfold mssRadialTimeResidualMultiplier
  have hsum :
      (∑ n ∈ indices,
        mssRadialTimeDoubleVerticalMultiplierTerm D scale hscale n)
          (WithLp.toLp 2 zeta) =
        ∑ n ∈ indices,
          mssRadialTimeDoubleVerticalMultiplierTerm D scale hscale n
            (WithLp.toLp 2 zeta) := by
    change
      (FunLike.coeAddMonoidHom
        (SchwartzMap JointWaveSpaceTime Complex)
        JointWaveSpaceTime Complex)
          (∑ n ∈ indices,
            mssRadialTimeDoubleVerticalMultiplierTerm D scale hscale n)
          (WithLp.toLp 2 zeta) = _
    rw [map_sum, Finset.sum_apply]
    congr 1
  rw [sub_apply, hsum, mssRadialTimeBaseMultiplier_apply]
  simp_rw [mssRadialTimeDoubleVerticalMultiplierTerm_apply,
    mssRadialTimeRadialMultiplierTerm_apply]
  rw [mssRadialTimeBaseMultiplier_apply]
  set B : Complex :=
    D.amplitude (scale⁻¹ • zeta.1) *
      FourierTransform.fourier (D.time : Real → Complex)
        (zeta.2 - scratchScaledNormalExtension D scale hscale zeta.1)
  let c : Int → Complex := fun n =>
    (verticalMultiplier (D.vertical : Real → Complex) scale n zeta) ^ 2 *
      D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n)
  change B - ∑ n ∈ indices,
      (verticalMultiplier (D.vertical : Real → Complex) scale n zeta) ^ 2 *
        (D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n) * B) =
    (1 - ∑ n ∈ indices, c n) * B
  have hsum_factor :
      (∑ n ∈ indices,
        (verticalMultiplier (D.vertical : Real → Complex) scale n zeta) ^ 2 *
          (D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n) * B)) =
        (∑ n ∈ indices, c n) * B := by
    calc
      (∑ n ∈ indices,
        (verticalMultiplier (D.vertical : Real → Complex) scale n zeta) ^ 2 *
          (D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n) * B)) =
          ∑ n ∈ indices, c n * B := by
            apply Finset.sum_congr rfl
            intro n hn
            dsimp [c]
            ring
      _ = (∑ n ∈ indices, c n) * B := (Finset.sum_mul ..).symm
  rw [hsum_factor]
  ring

/-- The unprojected residual spectrum factors through the f-independent base
multiplier and the spatial Fourier transform of the input. -/
private theorem scratchRawConicSpectrum_factor
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (f : SchwartzMap (Euclidean 2) Complex) (zeta : WaveSpaceTime) :
    scratchRawConicSpectrum D scale hscale f (WithLp.toLp 2 zeta) =
      mssRadialTimeBaseMultiplier D scale hscale (WithLp.toLp 2 zeta) *
        FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1 := by
  unfold scratchRawConicSpectrum mssRadialTimeBaseMultiplier
  rw [jointSchwartzModulatedAnnularProfile_apply,
    jointSchwartzModulatedAnnularProfile_apply, scratchRawConicBase_apply,
    mssRadialTimeScaledAmplitude_apply]
  ring

/-- Each f-dependent double-projected radial spectrum factors through its
f-independent double-projection multiplier. -/
private theorem scratchMaskedDoubleVerticalRadialSpectrum_factor
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex) (zeta : WaveSpaceTime) :
    scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f
        (WithLp.toLp 2 zeta) =
      mssRadialTimeDoubleVerticalMultiplierTerm D scale hscale n
          (WithLp.toLp 2 zeta) *
        FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1 := by
  rw [scratchMaskedDoubleVerticalRadialSpectrum_apply,
    mssRadialTimeDoubleVerticalMultiplierTerm_apply,
    mssRadialTimeRadialMultiplierTerm_apply,
    scratchRawConicSpectrum_factor]
  ring

/-- Exact f-independent factorization of the corrected finite
double-projection residual spectrum. -/
private theorem scratchMaskedDoubleVerticalResidualSpectrum_factor
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (f : SchwartzMap (Euclidean 2) Complex)
    (zeta : WaveSpaceTime) :
    scratchMaskedDoubleVerticalResidualSpectrum D scale hscale indices f
        (WithLp.toLp 2 zeta) =
      mssRadialTimeResidualMultiplier D scale hscale indices
          (WithLp.toLp 2 zeta) *
        FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1 := by
  unfold scratchMaskedDoubleVerticalResidualSpectrum
    scratchMaskedDoubleVerticalReconstructionSpectrum
  have hsource_sum :
      (∑ n ∈ indices,
        scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f)
          (WithLp.toLp 2 zeta) =
        ∑ n ∈ indices,
          scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f
            (WithLp.toLp 2 zeta) := by
    change
      (FunLike.coeAddMonoidHom
        (SchwartzMap JointWaveSpaceTime Complex)
        JointWaveSpaceTime Complex)
          (∑ n ∈ indices,
            scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f)
          (WithLp.toLp 2 zeta) = _
    rw [map_sum, Finset.sum_apply]
    congr 1
  have hmultiplier_sum :
      (∑ n ∈ indices,
        mssRadialTimeDoubleVerticalMultiplierTerm D scale hscale n)
          (WithLp.toLp 2 zeta) =
        ∑ n ∈ indices,
          mssRadialTimeDoubleVerticalMultiplierTerm D scale hscale n
            (WithLp.toLp 2 zeta) := by
    change
      (FunLike.coeAddMonoidHom
        (SchwartzMap JointWaveSpaceTime Complex)
        JointWaveSpaceTime Complex)
          (∑ n ∈ indices,
            mssRadialTimeDoubleVerticalMultiplierTerm D scale hscale n)
          (WithLp.toLp 2 zeta) = _
    rw [map_sum, Finset.sum_apply]
    congr 1
  rw [sub_apply, hsource_sum, scratchRawConicSpectrum_factor]
  simp_rw [scratchMaskedDoubleVerticalRadialSpectrum_factor]
  rw [← Finset.sum_mul]
  unfold mssRadialTimeResidualMultiplier
  rw [sub_apply, hmultiplier_sum]
  ring

/-- Raw-coordinate version of the residual factorization, tailored to the
joint inverse-Fourier/convolution bridge. -/
private theorem jointSchwartzRaw_residualSpectrum_factor
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (f : SchwartzMap (Euclidean 2) Complex)
    (zeta : WaveSpaceTime) :
    jointSchwartzRaw
        (scratchMaskedDoubleVerticalResidualSpectrum D scale hscale indices f) zeta =
      jointSchwartzRaw
          (mssRadialTimeResidualMultiplier D scale hscale indices) zeta *
        FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1 := by
  change
    scratchMaskedDoubleVerticalResidualSpectrum D scale hscale indices f
        (WithLp.toLp 2 zeta) =
      mssRadialTimeResidualMultiplier D scale hscale indices
          (WithLp.toLp 2 zeta) *
        FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1
  exact scratchMaskedDoubleVerticalResidualSpectrum_factor
    D scale hscale indices f zeta

/-- Literal source-level residual as the inverse joint transform of the
f-independent multiplier times the spatial Fourier data. -/
private theorem radialTimeResidual_eq_inverse_factorizedResidualSpectrum
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (f : SchwartzMap (Euclidean 2) Complex) :
    radialTimeResidual (D.vertical : Real → Complex) (D.radial : Real → Complex)
        (fun _ => indices) scale (D.amplitude : Euclidean 2 → Complex)
        (D.time : Real → Complex) (f : Euclidean 2 → Complex) =
      spaceTimeFourierInv (fun zeta : WaveSpaceTime =>
        jointSchwartzRaw
            (mssRadialTimeResidualMultiplier D scale hscale indices) zeta *
          FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1) := by
  rw [scratchMasked_radialTimeResidual_eq_inverse_residualSpectrum
    D scale hscale indices f]
  congr 1
  funext zeta
  exact jointSchwartzRaw_residualSpectrum_factor D scale hscale indices f zeta

/-- The literal residual Fourier transform has the exact f-independent
multiplier factorization. -/
private theorem spaceTimeFourier_radialTimeResidual_factorized
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (f : SchwartzMap (Euclidean 2) Complex)
    (zeta : WaveSpaceTime) :
    spaceTimeFourier
        (radialTimeResidual (D.vertical : Real → Complex) (D.radial : Real → Complex)
          (fun _ => indices) scale (D.amplitude : Euclidean 2 → Complex)
          (D.time : Real → Complex) (f : Euclidean 2 → Complex)) zeta =
      mssRadialTimeResidualMultiplier D scale hscale indices
          (WithLp.toLp 2 zeta) *
        FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1 := by
  rw [scratchMasked_radialTimeResidual_eq_inverse_residualSpectrum
    D scale hscale indices f]
  rw [spaceTimeFourier_spaceTimeFourierInv_jointSchwartzRaw]
  exact scratchMaskedDoubleVerticalResidualSpectrum_factor
    D scale hscale indices f zeta

/-- The blueprint's radial--time localization proposition.  The literal
double-projection residual is controlled for every `1 ≤ p ≤ ∞` from the
admissible compact cutoff data above. -/
def radialTimeLocalization (D : MSSRadialTimeCutoffs) : Prop :=
  ∀ (p : ENNReal) (N : Nat), 1 ≤ p → ∃ C : Real, 0 < C ∧
    ∀ scale : Real, 2 ≤ scale →
      ∀ f : SchwartzMap (Euclidean 2) Complex,
        eLpNorm
            (radialTimeResidual (D.vertical : Real → Complex)
              (D.radial : Real → Complex) relevantRadialIndexEnumeration
              scale (D.amplitude : Euclidean 2 → Complex) (D.time : Real → Complex)
              (f : Euclidean 2 → Complex))
            p volume ≤
          ENNReal.ofReal (C * (scale⁻¹) ^ N) *
            eLpNorm (f : Euclidean 2 → Complex) p volume

/-- An exact finite enumeration of the relevant radial labels is unique. -/
theorem relevantRadialIndexEnumeration_eq_of_hasRelevantRadialEnumeration
    (indices : Real → Finset Int) (hindices : HasRelevantRadialEnumeration indices)
    (scale : Real) :
    relevantRadialIndexEnumeration scale = indices scale := by
  ext n
  rw [mem_relevantRadialIndexEnumeration_iff, hindices scale n]

/-- Radial--time reconstruction is independent of the chosen presentation of
the exact finite index enumeration. -/
theorem radialTimeReconstruction_eq_of_hasRelevantRadialEnumeration
    (verticalCutoff radialCutoff : Real → Complex) (indices : Real → Finset Int)
    (hindices : HasRelevantRadialEnumeration indices) (scale : Real)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex) (f : Euclidean 2 → Complex) :
    radialTimeReconstruction verticalCutoff radialCutoff indices scale a ϑ f =
      radialTimeReconstruction verticalCutoff radialCutoff relevantRadialIndexEnumeration
        scale a ϑ f := by
  have hfun : indices = relevantRadialIndexEnumeration := by
    funext r
    exact (relevantRadialIndexEnumeration_eq_of_hasRelevantRadialEnumeration
      indices hindices r).symm
  rw [hfun]

/-- The corresponding radial--time residual is likewise independent of an
exact presentation of the finite relevant-index family. -/
theorem radialTimeResidual_eq_of_hasRelevantRadialEnumeration
    (verticalCutoff radialCutoff : Real → Complex) (indices : Real → Finset Int)
    (hindices : HasRelevantRadialEnumeration indices) (scale : Real)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex) (f : Euclidean 2 → Complex) :
    radialTimeResidual verticalCutoff radialCutoff indices scale a ϑ f =
      radialTimeResidual verticalCutoff radialCutoff relevantRadialIndexEnumeration
        scale a ϑ f := by
  have hfun : indices = relevantRadialIndexEnumeration := by
    funext r
    exact (relevantRadialIndexEnumeration_eq_of_hasRelevantRadialEnumeration
      indices hindices r).symm
  rw [hfun]

/-- The corrected localization predicate unfolds to its single explicit
relevant-index estimate. -/
theorem radialTimeLocalization_iff_estimate (D : MSSRadialTimeCutoffs) :
    radialTimeLocalization D ↔
      ∀ (p : ENNReal) (N : Nat), 1 ≤ p → ∃ C : Real, 0 < C ∧
        ∀ scale : Real, 2 ≤ scale →
          ∀ f : SchwartzMap (Euclidean 2) Complex,
            eLpNorm
                (radialTimeResidual (D.vertical : Real → Complex)
                  (D.radial : Real → Complex) relevantRadialIndexEnumeration
                  scale (D.amplitude : Euclidean 2 → Complex) (D.time : Real → Complex)
                  (f : Euclidean 2 → Complex))
                p volume ≤
              ENNReal.ofReal (C * (scale⁻¹) ^ N) *
                eLpNorm (f : Euclidean 2 → Complex) p volume := Iff.rfl





namespace RadialTimeLocalizationAux

/- Private smooth normal-coordinate residual calculus for the active radial--time localization proof. -/

private noncomputable def scratchRadialTimeResidualBracket
    (D : MSSRadialTimeCutoffs) (scale : Real)
    (xi : Euclidean 2) (tau : Real) : Complex :=
  1 - ∑ n ∈ relevantRadialIndexEnumeration scale,
    D.vertical ((Real.sqrt scale)⁻¹ * tau - n) ^ 2 *
      D.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n)

/-- The smooth scaled normal coordinate supplied by `MSSRadialTimeCutoffs`.
It agrees with `‖xi‖` on the scaled amplitude support. -/
private noncomputable def scratchScaledNormalCoordinate
    (D : MSSRadialTimeCutoffs) (scale : Real) (xi : Euclidean 2) : Real :=
  scale * D.normalExtension (scale⁻¹ • xi)

/-- The actual frequency-side residual multiplier before the spatial input
Fourier transform is attached. -/
private noncomputable def scratchRadialTimeResidualMultiplier
    (D : MSSRadialTimeCutoffs) (scale : Real)
    (xi : Euclidean 2) (tau : Real) : Complex :=
  D.amplitude (scale⁻¹ • xi) *
    scratchRadialTimeResidualBracket D scale xi tau *
    FourierTransform.fourier (D.time : Real → Complex)
      (tau - scratchScaledNormalCoordinate D scale xi)

private theorem scratchScaledNormalCoordinate_eq_norm_of_amplitude_ne_zero
    (D : MSSRadialTimeCutoffs) {scale : Real} (hscale : 0 < scale)
    (xi : Euclidean 2)
    (hxi : D.amplitude (scale⁻¹ • xi) ≠ 0) :
    scratchScaledNormalCoordinate D scale xi = ‖xi‖ := by
  unfold scratchScaledNormalCoordinate
  rw [D.normalExtension_eq_norm_on_amplitude (scale⁻¹ • xi) hxi,
    norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hscale)]
  field_simp [hscale.ne']

private theorem scratch_norm_mem_scaled_annulus_of_amplitude_ne_zero
    (D : MSSRadialTimeCutoffs) {scale : Real} (hscale : 0 < scale)
    (xi : Euclidean 2)
    (hxi : D.amplitude (scale⁻¹ • xi) ≠ 0) :
    ‖xi‖ ∈ Icc (scale / 2) (2 * scale) := by
  have h := D.amplitude_support_annulus (scale⁻¹ • xi) hxi
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hscale)] at h
  have hcancel : scale * (scale⁻¹ * ‖xi‖) = ‖xi‖ := by
    field_simp [hscale.ne']
  constructor
  · rw [show scale / 2 = scale * (1 / 2) by ring]
    calc
      scale * (1 / 2) ≤ scale * (scale⁻¹ * ‖xi‖) :=
        (mul_le_mul_iff_of_pos_left hscale).mpr h.1
      _ = ‖xi‖ := hcancel
  · rw [show 2 * scale = scale * 2 by ring]
    calc
      ‖xi‖ = scale * (scale⁻¹ * ‖xi‖) := hcancel.symm
      _ ≤ scale * 2 := (mul_le_mul_iff_of_pos_left hscale).mpr h.2

/-- The literal residual bracket vanishes in its `sqrt scale` normal tube.
This is the cancellation that supplies arbitrary scale decay from the fixed
Schwartz physical-time cutoff. -/
private theorem scratchRadialTimeResidualBracket_eq_zero_of_amplitude_ne_zero_of_near
    (D : MSSRadialTimeCutoffs) {scale : Real} (hscale : 0 < scale)
    (xi : Euclidean 2) (tau : Real)
    (hxi : D.amplitude (scale⁻¹ • xi) ≠ 0)
    (hnear : |tau - scratchScaledNormalCoordinate D scale xi| < Real.sqrt scale) :
    scratchRadialTimeResidualBracket D scale xi tau = 0 := by
  unfold scratchRadialTimeResidualBracket
  have hann := scratch_norm_mem_scaled_annulus_of_amplitude_ne_zero D hscale xi hxi
  have hnormal := scratchScaledNormalCoordinate_eq_norm_of_amplitude_ne_zero
    D hscale xi hxi
  rw [hnormal] at hnear
  rw [finite_vertical_radial_partition_eq_one_on_near_cone D hscale hann hnear]
  ring

/-- If the actual residual multiplier is nonzero, its normal frequency lies
outside the cancellation tube, unless the scaled amplitude itself vanishes
(in which case the conclusion is irrelevant). -/
private theorem scratch_normal_gap_of_radialTimeResidualMultiplier_ne_zero
    (D : MSSRadialTimeCutoffs) {scale : Real} (hscale : 0 < scale)
    (xi : Euclidean 2) (tau : Real)
    (hE : scratchRadialTimeResidualMultiplier D scale xi tau ≠ 0) :
    Real.sqrt scale ≤ |tau - scratchScaledNormalCoordinate D scale xi| := by
  by_contra hnot
  have hnear : |tau - scratchScaledNormalCoordinate D scale xi| < Real.sqrt scale :=
    lt_of_not_ge hnot
  have hamp : D.amplitude (scale⁻¹ • xi) ≠ 0 := by
    intro hz
    apply hE
    simp [scratchRadialTimeResidualMultiplier, hz]
  have hbracket := scratchRadialTimeResidualBracket_eq_zero_of_amplitude_ne_zero_of_near
    D hscale xi tau hamp hnear
  apply hE
  simp [scratchRadialTimeResidualMultiplier, hbracket]

/-- The spatial dilation of the supplied compact Schwartz amplitude. -/
private noncomputable def scratchScaledAmplitude
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) :
    SchwartzMap (Euclidean 2) Complex :=
  let A : Euclidean 2 ≃L[Real] Euclidean 2 :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 scale⁻¹ (inv_ne_zero hscale.ne'))
  (SchwartzMap.compCLMOfContinuousLinearEquiv Complex A) D.amplitude

private theorem scratchScaledAmplitude_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (xi : Euclidean 2) :
    scratchScaledAmplitude D scale hscale xi = D.amplitude (scale⁻¹ • xi) := by
  unfold scratchScaledAmplitude
  dsimp
  rfl

/-- A globally smooth scaled extension of the normal coordinate. -/
private noncomputable def scratchScaledNormalExtension
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) :
    SchwartzMap (Euclidean 2) Real :=
  let A : Euclidean 2 ≃L[Real] Euclidean 2 :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 scale⁻¹ (inv_ne_zero hscale.ne'))
  scale • ((SchwartzMap.compCLMOfContinuousLinearEquiv Real A) D.normalExtension)

private theorem scratchScaledNormalExtension_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (xi : Euclidean 2) :
    scratchScaledNormalExtension D scale hscale xi =
      scratchScaledNormalCoordinate D scale xi := by
  unfold scratchScaledNormalExtension scratchScaledNormalCoordinate
  dsimp
  rfl

/-- The shifted/dilated vertical cutoff, packaged as a temporal Schwartz map. -/
private noncomputable def scratchVerticalProfile
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) : SchwartzMap Real Complex :=
  let root : Real := Real.sqrt scale
  let A : Real ≃L[Real] Real :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 root⁻¹ (by
        dsimp only [root]
        exact inv_ne_zero (Real.sqrt_ne_zero'.mpr hscale)))
  ((SchwartzMap.compCLMOfContinuousLinearEquiv Complex A) beta).compSubConstCLM
    Complex (root * n)

private theorem scratchVerticalProfile_apply
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) (tau : Real) :
    scratchVerticalProfile beta scale n hscale tau =
      beta ((Real.sqrt scale)⁻¹ * tau - n) := by
  unfold scratchVerticalProfile
  dsimp
  change beta ((Real.sqrt scale)⁻¹ * (tau - Real.sqrt scale * n)) = _
  have hroot : Real.sqrt scale ≠ 0 := Real.sqrt_ne_zero'.mpr hscale
  field_simp [hroot]

/-- The smooth normal-coordinate radial factor used only underneath the
scaled amplitude.  It agrees with the literal norm factor on that support. -/
private noncomputable def scratchSmoothNormalRadialFactor
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    Euclidean 2 → Complex :=
  fun xi => D.radial
    ((Real.sqrt scale)⁻¹ * scratchScaledNormalExtension D scale hscale xi - n)

private theorem scratchSmoothNormalRadialFactor_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (n : Int) (xi : Euclidean 2) :
    scratchSmoothNormalRadialFactor D scale hscale n xi = D.radial
      ((Real.sqrt scale)⁻¹ * scratchScaledNormalCoordinate D scale xi - n) := by
  simp only [scratchSmoothNormalRadialFactor, scratchScaledNormalExtension_apply]

private theorem scratchSmoothNormalRadialFactor_eq_literal_of_amplitude_ne_zero
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (n : Int) (xi : Euclidean 2)
    (hxi : D.amplitude (scale⁻¹ • xi) ≠ 0) :
    scratchSmoothNormalRadialFactor D scale hscale n xi = D.radial
      ((Real.sqrt scale)⁻¹ * ‖xi‖ - n) := by
  rw [scratchSmoothNormalRadialFactor_apply,
    scratchScaledNormalCoordinate_eq_norm_of_amplitude_ne_zero D hscale xi hxi]

private theorem scratchSmoothNormalRadialFactor_hasTemperateGrowth
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    (scratchSmoothNormalRadialFactor D scale hscale n).HasTemperateGrowth := by
  unfold scratchSmoothNormalRadialFactor
  fun_prop

/-- A temporal Schwartz factor viewed on joint frequency space. -/
private noncomputable def scratchJointVerticalFactor
    (m : SchwartzMap Real Complex) : JointWaveSpaceTime → Complex :=
  fun z => m z.snd

private theorem scratchJointVerticalFactor_hasTemperateGrowth
    (m : SchwartzMap Real Complex) :
    (scratchJointVerticalFactor m).HasTemperateGrowth := by
  change (m ∘ WithLp.sndL 2 Real (Euclidean 2) Real).HasTemperateGrowth
  exact m.hasTemperateGrowth.comp
    (WithLp.sndL 2 Real (Euclidean 2) Real).hasTemperateGrowth

/-- A spatial smooth-normal factor viewed on joint frequency space. -/
private noncomputable def scratchJointNormalRadialFactor
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    JointWaveSpaceTime → Complex :=
  fun z => scratchSmoothNormalRadialFactor D scale hscale n z.fst

private theorem scratchJointNormalRadialFactor_hasTemperateGrowth
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    (scratchJointNormalRadialFactor D scale hscale n).HasTemperateGrowth := by
  change (scratchSmoothNormalRadialFactor D scale hscale n ∘
    WithLp.fstL 2 Real (Euclidean 2) Real).HasTemperateGrowth
  exact (scratchSmoothNormalRadialFactor_hasTemperateGrowth D scale hscale n).comp
    (WithLp.fstL 2 Real (Euclidean 2) Real).hasTemperateGrowth

/-- The globally smooth corrected double-projection bracket.  On the scaled
amplitude support it agrees with the literal bracket containing `‖xi‖`. -/
private noncomputable def scratchSmoothResidualBracket
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) : JointWaveSpaceTime → Complex :=
  fun z => 1 - ∑ n ∈ indices,
    (scratchJointVerticalFactor (scratchVerticalProfile D.vertical scale n hscale) z) ^ 2 *
      scratchJointNormalRadialFactor D scale hscale n z

private theorem scratchSmoothResidualBracket_hasTemperateGrowth
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) :
    (scratchSmoothResidualBracket D scale hscale indices).HasTemperateGrowth := by
  unfold scratchSmoothResidualBracket
  apply Function.HasTemperateGrowth.sub (Function.HasTemperateGrowth.const 1)
  apply Function.HasTemperateGrowth.sum
  intro n hn
  exact
    ((scratchJointVerticalFactor_hasTemperateGrowth
      (scratchVerticalProfile D.vertical scale n hscale)).pow 2).mul
      (scratchJointNormalRadialFactor_hasTemperateGrowth D scale hscale n)

/-- The f-independent globally smooth joint residual multiplier. -/
private noncomputable def scratchSmoothResidualProfile
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) : SchwartzMap JointWaveSpaceTime Complex :=
  SchwartzMap.smulLeftCLM Complex
    (scratchSmoothResidualBracket D scale hscale indices)
    (jointSchwartzModulatedAnnularProfile
      (scratchScaledAmplitude D scale hscale) D.time
      (scratchScaledNormalExtension D scale hscale))

private theorem scratchSmoothResidualProfile_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (xi : Euclidean 2) (tau : Real) :
    scratchSmoothResidualProfile D scale hscale indices (WithLp.toLp 2 (xi, tau)) =
      scratchSmoothResidualBracket D scale hscale indices (WithLp.toLp 2 (xi, tau)) *
        (D.amplitude (scale⁻¹ • xi) *
          FourierTransform.fourier (D.time : Real → Complex)
            (tau - scratchScaledNormalCoordinate D scale xi)) := by
  unfold scratchSmoothResidualProfile
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (scratchSmoothResidualBracket_hasTemperateGrowth D scale hscale indices)]
  rw [jointSchwartzModulatedAnnularProfile_apply,
    scratchScaledAmplitude_apply, scratchScaledNormalExtension_apply]
  change scratchSmoothResidualBracket D scale hscale indices (WithLp.toLp 2 (xi, tau)) •
      (D.amplitude (scale⁻¹ • xi) *
        FourierTransform.fourier (D.time : Real → Complex)
          (tau - scratchScaledNormalCoordinate D scale xi)) = _
  rw [smul_eq_mul]

private theorem scratchSmoothResidualBracket_eq_literal_of_amplitude_ne_zero
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (xi : Euclidean 2) (tau : Real)
    (hxi : D.amplitude (scale⁻¹ • xi) ≠ 0) :
    scratchSmoothResidualBracket D scale hscale indices (WithLp.toLp 2 (xi, tau)) =
      1 - ∑ n ∈ indices,
        D.vertical ((Real.sqrt scale)⁻¹ * tau - n) ^ 2 *
          D.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n) := by
  unfold scratchSmoothResidualBracket scratchJointVerticalFactor
    scratchJointNormalRadialFactor
  change 1 - ∑ n ∈ indices,
      scratchVerticalProfile D.vertical scale n hscale tau ^ 2 *
        scratchSmoothNormalRadialFactor D scale hscale n xi = _
  have hrad (n : Int) :
      scratchSmoothNormalRadialFactor D scale hscale n xi = D.radial
        ((Real.sqrt scale)⁻¹ * ‖xi‖ - n) :=
    scratchSmoothNormalRadialFactor_eq_literal_of_amplitude_ne_zero
      D scale hscale n xi hxi
  simp_rw [scratchVerticalProfile_apply, hrad]

private theorem scratchSmoothResidualProfile_eq_literal_multiplier
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (xi : Euclidean 2) (tau : Real) :
    scratchSmoothResidualProfile D scale hscale indices (WithLp.toLp 2 (xi, tau)) =
      D.amplitude (scale⁻¹ • xi) *
        (1 - ∑ n ∈ indices,
          D.vertical ((Real.sqrt scale)⁻¹ * tau - n) ^ 2 *
            D.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n)) *
        FourierTransform.fourier (D.time : Real → Complex)
          (tau - scratchScaledNormalCoordinate D scale xi) := by
  by_cases hxi : D.amplitude (scale⁻¹ • xi) = 0
  · rw [scratchSmoothResidualProfile_apply]
    simp [hxi]
  · rw [scratchSmoothResidualProfile_apply,
      scratchSmoothResidualBracket_eq_literal_of_amplitude_ne_zero
        D scale hscale indices xi tau hxi]
    ring

/-- The built-in normal guard.  It equals one on a strict sub-tube and is
supported inside the cancellation tube, using only the supplied radial
cutoff's `9/4`--`11/4` slack. -/
private noncomputable def scratchNormalGuard
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (z : JointWaveSpaceTime) : Complex :=
  D.radial (3 * ((Real.sqrt scale)⁻¹ *
    (z.snd - scratchScaledNormalExtension D scale hscale z.fst)))

private theorem scratchNormalGuard_ne_zero_imp_normal_near
    (D : MSSRadialTimeCutoffs) {scale : Real} (hscale : 0 < scale)
    (xi : Euclidean 2) (tau : Real)
    (hguard : scratchNormalGuard D scale hscale (WithLp.toLp 2 (xi, tau)) ≠ 0) :
    |tau - scratchScaledNormalCoordinate D scale xi| < Real.sqrt scale := by
  unfold scratchNormalGuard at hguard
  simp only [WithLp.toLp_fst, WithLp.toLp_snd,
    scratchScaledNormalExtension_apply] at hguard
  have hsupport := D.radial_support
    (3 * ((Real.sqrt scale)⁻¹ *
      (tau - scratchScaledNormalCoordinate D scale xi))) hguard
  have hroot : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
  have hscaled : (Real.sqrt scale)⁻¹ *
      |tau - scratchScaledNormalCoordinate D scale xi| < 11 / 12 := by
    rw [abs_mul, abs_of_nonneg (by norm_num : (0 : Real) ≤ 3),
      abs_mul, abs_of_pos (inv_pos.mpr hroot)] at hsupport
    nlinarith
  have hltone : (Real.sqrt scale)⁻¹ *
      |tau - scratchScaledNormalCoordinate D scale xi| < 1 :=
    hscaled.trans (by norm_num)
  rw [show (Real.sqrt scale)⁻¹ *
      |tau - scratchScaledNormalCoordinate D scale xi| =
        |tau - scratchScaledNormalCoordinate D scale xi| / Real.sqrt scale by ring] at hltone
  simpa using (div_lt_iff₀ hroot).mp hltone

private theorem scratchNormalGuard_mul_scratchSmoothResidualProfile_eq_zero
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (xi : Euclidean 2) (tau : Real) :
    scratchNormalGuard D scale hscale (WithLp.toLp 2 (xi, tau)) *
      scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale)
        (WithLp.toLp 2 (xi, tau)) = 0 := by
  by_cases hguard : scratchNormalGuard D scale hscale (WithLp.toLp 2 (xi, tau)) = 0
  · simp [hguard]
  have hnear := scratchNormalGuard_ne_zero_imp_normal_near D hscale xi tau hguard
  by_cases hxi : D.amplitude (scale⁻¹ • xi) = 0
  · rw [scratchSmoothResidualProfile_eq_literal_multiplier]
    simp [hxi]
  · have hbracket := scratchRadialTimeResidualBracket_eq_zero_of_amplitude_ne_zero_of_near
      D hscale xi tau hxi hnear
    rw [scratchSmoothResidualProfile_eq_literal_multiplier]
    simp [scratchRadialTimeResidualBracket] at hbracket
    simp [hbracket]

private theorem scratchSmoothResidualProfile_eq_one_sub_guard_mul
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (xi : Euclidean 2) (tau : Real) :
    scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale)
      (WithLp.toLp 2 (xi, tau)) =
      (1 - scratchNormalGuard D scale hscale (WithLp.toLp 2 (xi, tau))) *
        scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale)
          (WithLp.toLp 2 (xi, tau)) := by
  have hzero := scratchNormalGuard_mul_scratchSmoothResidualProfile_eq_zero
    D scale hscale xi tau
  calc
    scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale)
        (WithLp.toLp 2 (xi, tau)) =
      1 * scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale)
        (WithLp.toLp 2 (xi, tau)) := by ring
    _ = (1 - scratchNormalGuard D scale hscale (WithLp.toLp 2 (xi, tau))) *
        scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale)
          (WithLp.toLp 2 (xi, tau)) := by
      rw [sub_mul, one_mul, hzero, sub_zero]

/-- Every positive-order derivative of the scaled smooth normal extension is
uniformly bounded for `scale ≥ 1`.  This is the scale calculus behind the
normal-coordinate replacement; it is derived directly from the fixed
Schwartz cutoff data. -/
private theorem exists_scratch_scaledNormalExtension_iteratedFDeriv_uniform_bound
    (D : MSSRadialTimeCutoffs) (k : Nat) (hk : 1 ≤ k) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ xi : Euclidean 2,
        ‖iteratedFDeriv Real k
          (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) xi‖ ≤ C := by
  obtain ⟨C, hCpos, hC⟩ := D.normalExtension.decay 0 k
  refine ⟨C, hCpos.le, ?_⟩
  intro scale hscale hscaleone xi
  have hfun :
      (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) =
        fun y : Euclidean 2 => scale • D.normalExtension (scale⁻¹ • y) := by
    funext y
    rw [scratchScaledNormalExtension_apply]
    rfl
  have hsmooth : ContDiff Real k
      (fun y : Euclidean 2 => D.normalExtension (scale⁻¹ • y)) := by
    exact (D.normalExtension.smooth (k : ℕ∞)).comp
      (contDiff_id.const_smul scale⁻¹)
  have hchain : iteratedFDeriv Real k
      (fun y : Euclidean 2 => D.normalExtension (scale⁻¹ • y)) xi =
        scale⁻¹ ^ k • iteratedFDeriv Real k
          (D.normalExtension : Euclidean 2 → Real) (scale⁻¹ • xi) := by
    simpa using congrFun
      (iteratedFDeriv_comp_const_smul scale⁻¹
        (D.normalExtension.smooth (k : ℕ∞))) xi
  rw [hfun]
  change ‖iteratedFDeriv Real k
      (scale • (fun y : Euclidean 2 => D.normalExtension (scale⁻¹ • y))) xi‖ ≤ C
  rw [iteratedFDeriv_const_smul_apply hsmooth.contDiffAt, hchain,
    norm_smul, norm_smul]
  simp only [Real.norm_eq_abs, abs_of_pos hscale,
    abs_pow, abs_of_nonneg (inv_nonneg.mpr hscale.le)]
  have hpow : scale * scale⁻¹ ^ k ≤ 1 := by
    have hinv : scale⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hscaleone
    have hinv0 : 0 ≤ scale⁻¹ := inv_nonneg.mpr hscale.le
    have hinvpow : scale⁻¹ ^ (k - 1) ≤ 1 :=
      pow_le_one₀ hinv0 hinv
    have hk' : k = (k - 1) + 1 := (Nat.sub_add_cancel hk).symm
    calc
      scale * scale⁻¹ ^ k = scale * scale⁻¹ ^ ((k - 1) + 1) := by
        rw [congrArg (fun j : Nat => scale⁻¹ ^ j) hk']
      _ = scale * (scale⁻¹ ^ (k - 1) * scale⁻¹) := by rw [pow_succ]
      _ = (scale * scale⁻¹) * scale⁻¹ ^ (k - 1) := by ring
      _ = scale⁻¹ ^ (k - 1) := by field_simp [hscale.ne']
      _ ≤ 1 := hinvpow
  calc
    scale * (scale⁻¹ ^ k *
        ‖iteratedFDeriv Real k (D.normalExtension : Euclidean 2 → Real)
          (scale⁻¹ • xi)‖) =
      (scale * scale⁻¹ ^ k) *
        ‖iteratedFDeriv Real k (D.normalExtension : Euclidean 2 → Real)
          (scale⁻¹ • xi)‖ := by ring
    _ ≤ 1 * ‖iteratedFDeriv Real k (D.normalExtension : Euclidean 2 → Real)
      (scale⁻¹ • xi)‖ := by
      gcongr
    _ ≤ C := by
      simpa using hC (scale⁻¹ • xi)

/-- The smooth normal displacement on joint frequency space. -/
private noncomputable def scratchJointNormalDifference
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) :
    JointWaveSpaceTime → Real :=
  fun z => z.snd - scratchScaledNormalExtension D scale hscale z.fst

private theorem scratchJointNormalDifference_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (xi : Euclidean 2) (tau : Real) :
    scratchJointNormalDifference D scale hscale (WithLp.toLp 2 (xi, tau)) =
      tau - scratchScaledNormalCoordinate D scale xi := by
  simp [scratchJointNormalDifference, scratchScaledNormalExtension_apply]

private theorem continuous_scratchJointNormalDifference
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) :
    Continuous (scratchJointNormalDifference D scale hscale) := by
  unfold scratchJointNormalDifference
  exact (WithLp.sndL 2 Real (Euclidean 2) Real).continuous.sub
    ((scratchScaledNormalExtension D scale hscale).continuous.comp
      (WithLp.fstL 2 Real (Euclidean 2) Real).continuous)

private theorem isOpen_scratchJointNormalTube
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) :
    IsOpen {z : JointWaveSpaceTime |
      |scratchJointNormalDifference D scale hscale z| < Real.sqrt scale} := by
  exact isOpen_lt
    (continuous_abs.comp (continuous_scratchJointNormalDifference D scale hscale))
    continuous_const

private theorem scratchSmoothResidualProfile_eq_zero_of_normal_near
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (xi : Euclidean 2) (tau : Real)
    (hnear : |tau - scratchScaledNormalCoordinate D scale xi| < Real.sqrt scale) :
    scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale)
      (WithLp.toLp 2 (xi, tau)) = 0 := by
  by_cases hxi : D.amplitude (scale⁻¹ • xi) = 0
  · rw [scratchSmoothResidualProfile_eq_literal_multiplier]
    simp [hxi]
  · have hbracket := scratchRadialTimeResidualBracket_eq_zero_of_amplitude_ne_zero_of_near
      D hscale xi tau hxi hnear
    rw [scratchSmoothResidualProfile_eq_literal_multiplier]
    simpa [scratchRadialTimeResidualBracket] using
      congrArg (fun q : Complex =>
        D.amplitude (scale⁻¹ • xi) * q *
          FourierTransform.fourier (D.time : Real → Complex)
            (tau - scratchScaledNormalCoordinate D scale xi)) hbracket

private theorem scratchSmoothResidualProfile_eq_zero_on_normalTube
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (z : JointWaveSpaceTime)
    (hz : |scratchJointNormalDifference D scale hscale z| < Real.sqrt scale) :
    scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale) z = 0 := by
  have hpair : WithLp.toLp 2 (z.fst, z.snd) = z := by
    apply (WithLp.ext_iff 2).2
    rfl
  rw [← hpair]
  apply scratchSmoothResidualProfile_eq_zero_of_normal_near D scale hscale z.fst z.snd
  simpa [scratchJointNormalDifference, scratchScaledNormalExtension_apply] using hz

private theorem iteratedFDeriv_scratchSmoothResidualProfile_eq_zero_of_normal_near
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (k : Nat) (xi : Euclidean 2) (tau : Real)
    (hnear : |tau - scratchScaledNormalCoordinate D scale xi| < Real.sqrt scale) :
    iteratedFDeriv Real k
      (scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale) :
        JointWaveSpaceTime → Complex)
      (WithLp.toLp 2 (xi, tau)) = 0 := by
  let U : Set JointWaveSpaceTime := {z |
    |scratchJointNormalDifference D scale hscale z| < Real.sqrt scale}
  let z0 : JointWaveSpaceTime := WithLp.toLp 2 (xi, tau)
  have hUopen : IsOpen U := isOpen_scratchJointNormalTube D scale hscale
  have hz0 : z0 ∈ U := by
    simpa [U, z0, scratchJointNormalDifference_apply] using hnear
  have hEq : ∀ z ∈ U,
      scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale) z = 0 := by
    intro z hz
    exact scratchSmoothResidualProfile_eq_zero_on_normalTube D scale hscale z hz
  have hlocal :
      (scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale) :
        JointWaveSpaceTime → Complex) =ᶠ[𝓝 z0] 0 :=
    by
      filter_upwards [hUopen.mem_nhds hz0] with z hz
      exact hEq z hz
  have hderiv := (hlocal.iteratedFDeriv Real k).self_of_nhds
  simpa [z0] using hderiv
/-- Exact `L¹` scaling for every derivative of the compact spatial amplitude.
This records the only spatial-volume loss in the residual multiplier proof. -/
private theorem integral_norm_iteratedFDeriv_scratchScaledAmplitude
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (k : Nat) :
    (∫ xi : Euclidean 2,
      ‖iteratedFDeriv Real k
        (scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) xi‖) =
      scale⁻¹ ^ k * ((scale⁻¹) ^ 2)⁻¹ *
        ∫ eta : Euclidean 2,
          ‖iteratedFDeriv Real k
            (D.amplitude : Euclidean 2 → Complex) eta‖ := by
  have hfun :
      (scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) =
        fun y : Euclidean 2 => D.amplitude (scale⁻¹ • y) := by
    funext y
    exact scratchScaledAmplitude_apply D scale hscale y
  have hsmooth : ContDiff Real k
      (fun y : Euclidean 2 => D.amplitude (scale⁻¹ • y)) := by
    exact (D.amplitude.smooth (k : ℕ∞)).comp
      (contDiff_id.const_smul scale⁻¹)
  have hchain : iteratedFDeriv Real k
      (fun y : Euclidean 2 => D.amplitude (scale⁻¹ • y)) =
        fun xi => scale⁻¹ ^ k • iteratedFDeriv Real k
          (D.amplitude : Euclidean 2 → Complex) (scale⁻¹ • xi) := by
    exact iteratedFDeriv_comp_const_smul scale⁻¹
      (D.amplitude.smooth (k : ℕ∞))
  rw [hfun]
  change (∫ xi : Euclidean 2,
    ‖iteratedFDeriv Real k
      (fun y : Euclidean 2 => D.amplitude (scale⁻¹ • y)) xi‖) = _
  simp_rw [hchain]
  rw [show (fun xi : Euclidean 2 =>
      ‖scale⁻¹ ^ k • iteratedFDeriv Real k
        (D.amplitude : Euclidean 2 → Complex) (scale⁻¹ • xi)‖) =
      fun xi => scale⁻¹ ^ k * ‖iteratedFDeriv Real k
        (D.amplitude : Euclidean 2 → Complex) (scale⁻¹ • xi)‖ by
        funext xi
        rw [norm_smul, Real.norm_eq_abs,
          abs_of_nonneg (pow_nonneg (inv_nonneg.mpr hscale.le) k)],
    integral_const_mul]
  rw [Codex.Spherical.SurfaceCore.integral_norm_comp_smul_eq 2
    (iteratedFDeriv Real k (D.amplitude : Euclidean 2 → Complex))
    (inv_pos.mpr hscale)]
  ring

/-- Positive-order derivatives of the smooth normal radial argument have the
expected `sqrt scale` loss and no dependence on the translated label. -/
private theorem iteratedFDeriv_scratchSmoothNormalRadialArgument_eq
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (n : Int) (k : Nat) (hk : 1 ≤ k) (xi : Euclidean 2) :
    iteratedFDeriv Real k
      (fun y : Euclidean 2 =>
        (Real.sqrt scale)⁻¹ * scratchScaledNormalExtension D scale hscale y - n) xi =
      (Real.sqrt scale)⁻¹ • iteratedFDeriv Real k
        (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) xi := by
  have hrho : ContDiff Real k
      (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) :=
    (scratchScaledNormalExtension D scale hscale).smooth (k : ℕ∞)
  have hscaled : ContDiffAt Real k
      (fun y : Euclidean 2 =>
        (Real.sqrt scale)⁻¹ • scratchScaledNormalExtension D scale hscale y) xi :=
    (hrho.const_smul (Real.sqrt scale)⁻¹).contDiffAt
  have hconst : ContDiffAt Real k (fun _ : Euclidean 2 => (n : Real)) xi :=
    contDiffAt_const
  rw [show (fun y : Euclidean 2 =>
      (Real.sqrt scale)⁻¹ * scratchScaledNormalExtension D scale hscale y - n) =
      (fun y : Euclidean 2 =>
        (Real.sqrt scale)⁻¹ • scratchScaledNormalExtension D scale hscale y) -
        fun _ : Euclidean 2 => (n : Real) by
      funext y
      rfl,
    iteratedFDeriv_sub_apply hscaled hconst,
    ]
  change iteratedFDeriv Real k
      ((Real.sqrt scale)⁻¹ •
        (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real)) xi -
      iteratedFDeriv Real k (fun _ : Euclidean 2 => (n : Real)) xi = _
  rw [iteratedFDeriv_const_smul_apply hrho.contDiffAt]
  rw [iteratedFDeriv_const_of_ne (Nat.ne_of_gt (Nat.zero_lt_of_lt hk)) (n : Real)]
  simp

/-- Every fixed derivative order of the smooth normal-coordinate radial
factor is bounded uniformly in the scale and translated radial label.  This
is a finite-order consequence of the supplied Schwartz cutoffs, rather than
a new regularity hypothesis. -/
private theorem exists_scratchSmoothNormalRadialFactor_iteratedFDeriv_uniform_bound
    (D : MSSRadialTimeCutoffs) (k : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ (n : Int) (xi : Euclidean 2),
        ‖iteratedFDeriv Real k
          (scratchSmoothNormalRadialFactor D scale hscale n) xi‖ ≤ C := by
  let Cr : Nat → Real := fun i => (D.radial.decay 0 i).choose
  have hCr_pos (i : Nat) : 0 < Cr i := by
    simpa [Cr] using (D.radial.decay 0 i).choose_spec.1
  have hCr (i : Nat) (s : Real) :
      ‖iteratedFDeriv Real i (D.radial : Real → Complex) s‖ ≤ Cr i := by
    simpa [Cr] using (D.radial.decay 0 i).choose_spec.2 s
  let Cg : Real := ∑ i ∈ Finset.range (k + 1), Cr i
  have hCg_nonneg : 0 ≤ Cg := by
    apply Finset.sum_nonneg
    intro i hi
    exact hCr_pos i |>.le
  have hCg_bound {i : Nat} (hi : i ≤ k) : Cr i ≤ Cg := by
    apply (Finset.single_le_sum (s := Finset.range (k + 1))
      (f := Cr) (fun j hj => hCr_pos j |>.le))
    exact Finset.mem_range.mpr (Nat.lt_succ_of_le hi)
  let Crho : Nat → Real := fun i =>
    if hi : 1 ≤ i then
      (exists_scratch_scaledNormalExtension_iteratedFDeriv_uniform_bound D i hi).choose
    else 0
  have hCrho_nonneg {i : Nat} (hi : 1 ≤ i) : 0 ≤ Crho i := by
    simp only [Crho, dif_pos hi]
    exact (exists_scratch_scaledNormalExtension_iteratedFDeriv_uniform_bound D i hi).choose_spec.1
  have hCrho {i : Nat} (hi : 1 ≤ i) (scale : Real) (hscale : 0 < scale)
      (hscaleone : 1 ≤ scale) (xi : Euclidean 2) :
      ‖iteratedFDeriv Real i
        (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) xi‖ ≤
        Crho i := by
    simpa only [Crho, dif_pos hi] using
      (exists_scratch_scaledNormalExtension_iteratedFDeriv_uniform_bound D i hi).choose_spec.2
        scale hscale hscaleone xi
  let Cf : Real := ∑ i ∈ Finset.range (k + 1), max 1 (Crho i)
  have hCf_nonneg : 0 ≤ Cf := by
    apply Finset.sum_nonneg
    intro i hi
    exact le_trans zero_le_one (le_max_left _ _)
  have hCf_one : 1 ≤ Cf := by
    calc
      1 ≤ max 1 (Crho 0) := le_max_left _ _
      _ ≤ ∑ i ∈ Finset.range (k + 1), max 1 (Crho i) := by
        exact Finset.single_le_sum (s := Finset.range (k + 1))
          (f := fun i => max 1 (Crho i))
          (fun i hi => le_trans zero_le_one (le_max_left _ _))
          (Finset.mem_range.mpr (Nat.succ_pos k))
  have hCf_bound {i : Nat} (hi : i ≤ k) : Crho i ≤ Cf := by
    calc
      Crho i ≤ max 1 (Crho i) := le_max_right _ _
      _ ≤ ∑ j ∈ Finset.range (k + 1), max 1 (Crho j) := by
        exact Finset.single_le_sum (s := Finset.range (k + 1))
          (f := fun j => max 1 (Crho j))
          (fun j hj => le_trans zero_le_one (le_max_left _ _))
          (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
  refine ⟨(k.factorial : Real) * Cg * Cf ^ k, by positivity, ?_⟩
  intro scale hscale hscaleone n xi
  let q : Euclidean 2 → Real := fun y =>
    (Real.sqrt scale)⁻¹ * scratchScaledNormalExtension D scale hscale y - n
  have hq : ContDiff Real (k : ℕ∞) q := by
    exact (((scratchScaledNormalExtension D scale hscale).smooth (k : ℕ∞)).const_smul
      (Real.sqrt scale)⁻¹).sub contDiff_const
  have hq_eq : scratchSmoothNormalRadialFactor D scale hscale n = D.radial ∘ q := by
    funext y
    simp only [scratchSmoothNormalRadialFactor, q, Function.comp_apply]
  rw [hq_eq]
  apply norm_iteratedFDeriv_comp_le (D.radial.smooth (k : ℕ∞)) hq
    (by simp : (k : WithTop ℕ∞) ≤ ((k : ℕ∞) : WithTop ℕ∞)) xi
  · intro i hi
    exact (hCr i (q xi)).trans (hCg_bound hi)
  · intro i hi1 hi
    have harg := iteratedFDeriv_scratchSmoothNormalRadialArgument_eq
      D scale hscale n i hi1 xi
    change ‖iteratedFDeriv Real i q xi‖ ≤ Cf ^ i
    rw [show q = fun y : Euclidean 2 =>
      (Real.sqrt scale)⁻¹ * scratchScaledNormalExtension D scale hscale y - n by rfl,
      harg, norm_smul, Real.norm_eq_abs]
    have hroot : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
    rw [abs_of_pos (inv_pos.mpr hroot)]
    calc
      (Real.sqrt scale)⁻¹ *
          ‖iteratedFDeriv Real i
            (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) xi‖ ≤
          1 * Crho i := by
        gcongr
        · exact inv_le_one_of_one_le₀ (Real.one_le_sqrt.mpr hscaleone)
        · exact hCrho hi1 scale hscale hscaleone xi
      _ ≤ Cf := by simpa using hCf_bound hi
      _ ≤ Cf ^ i := le_self_pow₀ hCf_one (Nat.ne_of_gt (Nat.zero_lt_of_lt hi1))

/-- A fixed Schwartz temporal profile has arbitrary scale decay outside a
normal tube of width `sqrt scale`.  The weighted form avoids introducing any
non-Schwartz reciprocal envelope and is the basic tail estimate used for
the corrected residual multiplier. -/
private theorem exists_weighted_normal_tail_iteratedFDeriv_bound
    (h : SchwartzMap Real Complex) (i N K : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale u : Real), 1 ≤ scale →
      Real.sqrt scale ≤ |u| →
      scale ^ N * (1 + u ^ 2) ^ K *
        ‖iteratedFDeriv Real i (h : Real → Complex) u‖ ≤ C := by
  obtain ⟨C, hCpos, hC⟩ := h.decay (2 * (N + K)) i
  refine ⟨(2 : Real) ^ K * C, mul_nonneg (pow_nonneg (by norm_num) _) hCpos.le, ?_⟩
  intro scale u hscale hu
  have hscale0 : 0 ≤ scale := zero_le_one.trans hscale
  have hroot : 1 ≤ Real.sqrt scale := Real.one_le_sqrt.mpr hscale
  have huone : 1 ≤ |u| := hroot.trans hu
  have huabs2 : 1 ≤ |u| ^ 2 := one_le_pow₀ huone
  have hu2plain : 1 ≤ u ^ 2 := by simpa [sq_abs] using huabs2
  have hu2 : 1 + u ^ 2 ≤ 2 * |u| ^ 2 := by
    rw [sq_abs]
    nlinarith
  have hscale_pow : scale ^ N ≤ |u| ^ (2 * N) := by
    calc
      scale ^ N = (Real.sqrt scale ^ 2) ^ N := by rw [Real.sq_sqrt hscale0]
      _ = (Real.sqrt scale) ^ (2 * N) := by rw [pow_mul]
      _ ≤ |u| ^ (2 * N) := by
        exact pow_le_pow_left₀ (Real.sqrt_nonneg _) hu _
  have hu2pow : (1 + u ^ 2) ^ K ≤ (2 : Real) ^ K * |u| ^ (2 * K) := by
    calc
      (1 + u ^ 2) ^ K ≤ (2 * |u| ^ 2) ^ K := by
        exact pow_le_pow_left₀ (by positivity) hu2 K
      _ = (2 : Real) ^ K * |u| ^ (2 * K) := by
        rw [mul_pow, pow_mul]
  have htail : |u| ^ (2 * (N + K)) *
      ‖iteratedFDeriv Real i (h : Real → Complex) u‖ ≤ C := by
    simpa only [Real.norm_eq_abs] using hC u
  calc
    scale ^ N * (1 + u ^ 2) ^ K *
        ‖iteratedFDeriv Real i (h : Real → Complex) u‖ ≤
        (|u| ^ (2 * N) * ((2 : Real) ^ K * |u| ^ (2 * K))) *
          ‖iteratedFDeriv Real i (h : Real → Complex) u‖ := by
      gcongr
    _ = (2 : Real) ^ K *
        (|u| ^ (2 * (N + K)) *
          ‖iteratedFDeriv Real i (h : Real → Complex) u‖) := by
      ring_nf
    _ ≤ (2 : Real) ^ K * C := by
      gcongr
/-- The `i`-th ordinary derivative of a one-dimensional Schwartz profile,
kept as a Schwartz profile itself. -/
private noncomputable def scratchTemporalDerivativeProfile
    (h : SchwartzMap Real Complex) (i : Nat) : SchwartzMap Real Complex :=
  (SchwartzMap.derivCLM Complex Complex)^[i] h

private theorem scratchTemporalDerivativeProfile_apply
    (h : SchwartzMap Real Complex) (i : Nat) (u : Real) :
    scratchTemporalDerivativeProfile h i u =
      iteratedDeriv i (h : Real → Complex) u := by
  induction i generalizing u with
  | zero => simp [scratchTemporalDerivativeProfile, iteratedDeriv_zero]
  | succ i ih =>
      rw [scratchTemporalDerivativeProfile, Function.iterate_succ_apply',
        SchwartzMap.derivCLM_apply]
      change deriv (fun v : Real => scratchTemporalDerivativeProfile h i v) u = _
      rw [show (fun v : Real => scratchTemporalDerivativeProfile h i v) =
        iteratedDeriv i (h : Real → Complex) by
          funext v
          exact ih v,
        ← iteratedDeriv_succ]

/-- A polynomially weighted temporal derivative profile.  It is still
Schwartz and will provide an integrable envelope after normal shearing. -/
private noncomputable def scratchWeightedTemporalDerivativeProfile
    (h : SchwartzMap Real Complex) (i N : Nat) : SchwartzMap Real Complex :=
  SchwartzMap.smulLeftCLM Complex (fun s : Real => (1 + s ^ 2) ^ N)
    (scratchTemporalDerivativeProfile h i)

private theorem scratchWeightedTemporalDerivativeProfile_apply
    (h : SchwartzMap Real Complex) (i N : Nat) (u : Real) :
    scratchWeightedTemporalDerivativeProfile h i N u =
      ((1 + u ^ 2) ^ N : Real) • iteratedDeriv i (h : Real → Complex) u := by
  unfold scratchWeightedTemporalDerivativeProfile
  rw [SchwartzMap.smulLeftCLM_apply
    (show (fun s : Real => (1 + s ^ 2) ^ N).HasTemperateGrowth by fun_prop)]
  change ((1 + u ^ 2) ^ N : Real) • scratchTemporalDerivativeProfile h i u = _
  rw [scratchTemporalDerivativeProfile_apply]

/-- Outside the normal tube, a fixed polynomially weighted Schwartz
derivative dominates the unweighted derivative with the desired scale gain. -/
private theorem scale_pow_mul_norm_iteratedFDeriv_time_le_weighted_profile
    (h : SchwartzMap Real Complex) (i N : Nat) (scale u : Real)
    (hscale : 0 ≤ scale) (hu : Real.sqrt scale ≤ |u|) :
    scale ^ N * ‖iteratedFDeriv Real i (h : Real → Complex) u‖ ≤
      ‖scratchWeightedTemporalDerivativeProfile h i N u‖ := by
  rw [scratchWeightedTemporalDerivativeProfile_apply, norm_smul,
    Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (by positivity) _),
    norm_iteratedFDeriv_eq_norm_iteratedDeriv]
  have hscale_le_u2 : scale ≤ u ^ 2 := by
    calc
      scale = Real.sqrt scale ^ 2 := by rw [Real.sq_sqrt hscale]
      _ ≤ |u| ^ 2 := by
        exact pow_le_pow_left₀ (Real.sqrt_nonneg _) hu _
      _ = u ^ 2 := by rw [sq_abs]
  have hscale_le : scale ≤ 1 + u ^ 2 := hscale_le_u2.trans (by linarith)
  have hpow : scale ^ N ≤ (1 + u ^ 2) ^ N := by
    exact pow_le_pow_left₀ hscale hscale_le N
  gcongr

private theorem norm_iteratedFDeriv_continuousLinearMap_le_one
    (L : JointWaveSpaceTime →L[Real] Real) (hL : ‖L‖ ≤ 1)
    (k : Nat) (hk : 1 ≤ k) (z : JointWaveSpaceTime) :
    ‖iteratedFDeriv Real k (L : JointWaveSpaceTime → Real) z‖ ≤ 1 := by
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, (Nat.sub_add_cancel hk).symm⟩
  rw [← norm_iteratedFDeriv_fderiv]
  have hf : fderiv Real (L : JointWaveSpaceTime → Real) = fun _ => L := by
    funext w
    exact L.fderiv
  rw [hf]
  cases j with
  | zero =>
      simpa [norm_iteratedFDeriv_zero] using hL
  | succ j =>
      rw [iteratedFDeriv_const_of_ne (Nat.succ_ne_zero j) L]
      simp

private theorem scratch_joint_fstL_norm_le_one :
    ‖WithLp.fstL 2 Real (Euclidean 2) Real‖ ≤ 1 := by
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
  intro z
  simpa using WithLp.norm_fst_le (p := 2) (Euclidean 2) z

private theorem scratch_joint_sndL_norm_le_one :
    ‖WithLp.sndL 2 Real (Euclidean 2) Real‖ ≤ 1 := by
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
  intro z
  simpa using WithLp.norm_snd_le (p := 2) (Euclidean 2) z

private theorem norm_iteratedFDeriv_scratchScaledNormalExtension_comp_fst_le
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (k : Nat) (z : JointWaveSpaceTime) :
    ‖iteratedFDeriv Real k
      (fun w : JointWaveSpaceTime =>
        scratchScaledNormalExtension D scale hscale w.fst) z‖ ≤
      ‖iteratedFDeriv Real k
        (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) z.fst‖ := by
  let L : JointWaveSpaceTime →L[Real] Euclidean 2 :=
    WithLp.fstL 2 Real (Euclidean 2) Real
  change ‖iteratedFDeriv Real k
    ((scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) ∘ L) z‖ ≤ _
  rw [L.iteratedFDeriv_comp_right
    ((scratchScaledNormalExtension D scale hscale).smooth (k : ℕ∞)) z
    le_rfl]
  calc
    ‖(iteratedFDeriv Real k
        (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) (L z)).compContinuousLinearMap
          (fun _ => L)‖ ≤
        ‖iteratedFDeriv Real k
          (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) (L z)‖ *
          ∏ _ : Fin k, ‖L‖ :=
      ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv Real k
          (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) (L z)‖ *
          ∏ _ : Fin k, (1 : Real) := by
      gcongr
      exact scratch_joint_fstL_norm_le_one
    _ = ‖iteratedFDeriv Real k
          (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) z.fst‖ := by
      simp [L]

/-- The full joint normal difference has uniformly bounded positive-order
derivatives.  The temporal coordinate contributes only a norm-one linear
map; all other bounds come from the supplied smooth normal extension. -/
private theorem exists_scratchJointNormalDifference_iteratedFDeriv_uniform_bound
    (D : MSSRadialTimeCutoffs) (k : Nat) (hk : 1 ≤ k) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ z : JointWaveSpaceTime,
        ‖iteratedFDeriv Real k
          (scratchJointNormalDifference D scale hscale : JointWaveSpaceTime → Real) z‖ ≤ C := by
  obtain ⟨C, hCnonneg, hC⟩ :=
    exists_scratch_scaledNormalExtension_iteratedFDeriv_uniform_bound D k hk
  refine ⟨1 + C, by linarith, ?_⟩
  intro scale hscale hscaleone z
  let Ls : JointWaveSpaceTime →L[Real] Real :=
    WithLp.sndL 2 Real (Euclidean 2) Real
  let Lf : JointWaveSpaceTime →L[Real] Euclidean 2 :=
    WithLp.fstL 2 Real (Euclidean 2) Real
  let rho : SchwartzMap (Euclidean 2) Real := scratchScaledNormalExtension D scale hscale
  have hsnd : ContDiffAt Real k (fun w : JointWaveSpaceTime => Ls w) z := by
    fun_prop
  have hrhofst : ContDiffAt Real k (fun w : JointWaveSpaceTime => rho (Lf w)) z := by
    exact ((rho.smooth (k : ℕ∞)).comp_continuousLinearMap (g := Lf)).contDiffAt
  have hrepr : (scratchJointNormalDifference D scale hscale : JointWaveSpaceTime → Real) =
      fun w => Ls w - rho (Lf w) := by
    funext w
    change w.snd - scratchScaledNormalExtension D scale hscale w.fst =
      WithLp.sndL 2 Real (Euclidean 2) Real w -
        scratchScaledNormalExtension D scale hscale
          (WithLp.fstL 2 Real (Euclidean 2) Real w)
    rfl
  rw [hrepr,
    show (fun w : JointWaveSpaceTime => Ls w - rho (Lf w)) =
      (fun w => Ls w) - (fun w => rho (Lf w)) by rfl,
    iteratedFDeriv_sub_apply hsnd hrhofst]
  calc
    ‖iteratedFDeriv Real k (fun w : JointWaveSpaceTime => Ls w) z -
        iteratedFDeriv Real k (fun w : JointWaveSpaceTime => rho (Lf w)) z‖ ≤
        ‖iteratedFDeriv Real k (fun w : JointWaveSpaceTime => Ls w) z‖ +
          ‖iteratedFDeriv Real k (fun w : JointWaveSpaceTime => rho (Lf w)) z‖ :=
      norm_sub_le _ _
    _ ≤ 1 + C := by
      gcongr
      · exact norm_iteratedFDeriv_continuousLinearMap_le_one Ls
          (by simpa [Ls] using scratch_joint_sndL_norm_le_one) k hk z
      · exact (norm_iteratedFDeriv_scratchScaledNormalExtension_comp_fst_le
          D scale hscale k z).trans (hC scale hscale hscaleone z.fst)

private theorem scratchJointNormalDifference_contDiff
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (k : Nat) :
    ContDiff Real (k : ℕ∞)
      (scratchJointNormalDifference D scale hscale : JointWaveSpaceTime → Real) := by
  let Ls : JointWaveSpaceTime →L[Real] Real :=
    WithLp.sndL 2 Real (Euclidean 2) Real
  let Lf : JointWaveSpaceTime →L[Real] Euclidean 2 :=
    WithLp.fstL 2 Real (Euclidean 2) Real
  let rho : SchwartzMap (Euclidean 2) Real := scratchScaledNormalExtension D scale hscale
  have hrepr : (scratchJointNormalDifference D scale hscale : JointWaveSpaceTime → Real) =
      fun w => Ls w - rho (Lf w) := by
    funext w
    change w.snd - scratchScaledNormalExtension D scale hscale w.fst =
      WithLp.sndL 2 Real (Euclidean 2) Real w -
        scratchScaledNormalExtension D scale hscale
          (WithLp.fstL 2 Real (Euclidean 2) Real w)
    rfl
  rw [hrepr]
  exact (Ls.contDiff.sub ((rho.smooth (k : ℕ∞)).comp_continuousLinearMap (g := Lf)))
/-- The `k`-th derivative of a temporal Schwartz profile composed with the
smooth joint normal coordinate has a finite weighted-Schwartz envelope on the
normal-gap region.  The constant is uniform in the scale; the finite sum is
intentional, retaining the individual temporal derivative envelopes needed
for the eventual `L¹` integration. -/
private theorem exists_scale_pow_mul_norm_iteratedFDeriv_sheared_time_le_sum_weighted_profiles
    (D : MSSRadialTimeCutoffs) (h : SchwartzMap Real Complex) (k N : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ z : JointWaveSpaceTime,
        Real.sqrt scale ≤ |scratchJointNormalDifference D scale hscale z| →
        scale ^ N * ‖iteratedFDeriv Real k
          (fun w : JointWaveSpaceTime =>
            h (scratchJointNormalDifference D scale hscale w)) z‖ ≤
          C * ∑ i ∈ Finset.range (k + 1),
            ‖scratchWeightedTemporalDerivativeProfile h i N
              (scratchJointNormalDifference D scale hscale z)‖ := by
  let Cq : Nat → Real := fun i =>
    if hi : 1 ≤ i then
      (exists_scratchJointNormalDifference_iteratedFDeriv_uniform_bound D i hi).choose
    else 0
  have hCq {i : Nat} (hi : 1 ≤ i) (scale : Real) (hscale : 0 < scale)
      (hscaleone : 1 ≤ scale) (z : JointWaveSpaceTime) :
      ‖iteratedFDeriv Real i
        (scratchJointNormalDifference D scale hscale : JointWaveSpaceTime → Real) z‖ ≤ Cq i := by
    simpa only [Cq, dif_pos hi] using
      (exists_scratchJointNormalDifference_iteratedFDeriv_uniform_bound D i hi).choose_spec.2
        scale hscale hscaleone z
  let Cinner : Real := ∑ i ∈ Finset.range (k + 1), max 1 (Cq i)
  have hCinner_one : 1 ≤ Cinner := by
    calc
      1 ≤ max 1 (Cq 0) := le_max_left _ _
      _ ≤ ∑ i ∈ Finset.range (k + 1), max 1 (Cq i) := by
        exact Finset.single_le_sum (s := Finset.range (k + 1))
          (f := fun i => max 1 (Cq i))
          (fun i hi => le_trans zero_le_one (le_max_left _ _))
          (Finset.mem_range.mpr (Nat.succ_pos k))
  have hCinner {i : Nat} (hi : i ≤ k) : Cq i ≤ Cinner := by
    calc
      Cq i ≤ max 1 (Cq i) := le_max_right _ _
      _ ≤ ∑ j ∈ Finset.range (k + 1), max 1 (Cq j) := by
        exact Finset.single_le_sum (s := Finset.range (k + 1))
          (f := fun j => max 1 (Cq j))
          (fun j hj => le_trans zero_le_one (le_max_left _ _))
          (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
  refine ⟨(k.factorial : Real) * Cinner ^ k,
    mul_nonneg (by positivity) (pow_nonneg (le_trans zero_le_one hCinner_one) _), ?_⟩
  intro scale hscale hscaleone z hgap
  let q : JointWaveSpaceTime → Real := scratchJointNormalDifference D scale hscale
  let S : Real := ∑ i ∈ Finset.range (k + 1),
    ‖scratchWeightedTemporalDerivativeProfile h i N (q z)‖
  have hSnonneg : 0 ≤ S := by
    apply Finset.sum_nonneg
    intro i hi
    exact norm_nonneg _
  have hq : ContDiff Real (k : ℕ∞) q :=
    scratchJointNormalDifference_contDiff D scale hscale k
  have houter {i : Nat} (hi : i ≤ k) :
      ‖iteratedFDeriv Real i (h : Real → Complex) (q z)‖ ≤ scale⁻¹ ^ N * S := by
    have htime := scale_pow_mul_norm_iteratedFDeriv_time_le_weighted_profile
      h i N scale (q z) (zero_le_one.trans hscaleone) (by simpa [q] using hgap)
    have hscale_ne : scale ≠ 0 := hscale.ne'
    have hterm :
        ‖scratchWeightedTemporalDerivativeProfile h i N (q z)‖ ≤ S := by
      exact Finset.single_le_sum (s := Finset.range (k + 1))
        (f := fun j => ‖scratchWeightedTemporalDerivativeProfile h j N (q z)‖)
        (fun j hj => norm_nonneg _)
        (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
    calc
      ‖iteratedFDeriv Real i (h : Real → Complex) (q z)‖ =
          scale⁻¹ ^ N *
            (scale ^ N * ‖iteratedFDeriv Real i (h : Real → Complex) (q z)‖) := by
        rw [inv_pow]
        field_simp [pow_ne_zero N hscale_ne]
      _ ≤ scale⁻¹ ^ N *
          ‖scratchWeightedTemporalDerivativeProfile h i N (q z)‖ := by
        exact mul_le_mul_of_nonneg_left htime
          (pow_nonneg (inv_nonneg.mpr hscale.le) _)
      _ ≤ scale⁻¹ ^ N * S := by
        exact mul_le_mul_of_nonneg_left hterm
          (pow_nonneg (inv_nonneg.mpr hscale.le) _)
  have hinner {i : Nat} (hi1 : 1 ≤ i) (hi : i ≤ k) :
      ‖iteratedFDeriv Real i q z‖ ≤ Cinner ^ i := by
    calc
      ‖iteratedFDeriv Real i q z‖ ≤ Cq i := hCq hi1 scale hscale hscaleone z
      _ ≤ Cinner := hCinner hi
      _ ≤ Cinner ^ i :=
        le_self_pow₀ hCinner_one (Nat.ne_of_gt (Nat.zero_lt_of_lt hi1))
  have hchain :
      ‖iteratedFDeriv Real k ((h : Real → Complex) ∘ q) z‖ ≤
        (k.factorial : Real) * (scale⁻¹ ^ N * S) * Cinner ^ k := by
    apply norm_iteratedFDeriv_comp_le (h.smooth (k : ℕ∞)) hq
      (by simp : (k : WithTop ℕ∞) ≤ ((k : ℕ∞) : WithTop ℕ∞)) z
    · intro i hi
      exact houter hi
    · intro i hi1 hi
      exact hinner hi1 hi
  change scale ^ N * ‖iteratedFDeriv Real k ((h : Real → Complex) ∘ q) z‖ ≤ _
  calc
    scale ^ N * ‖iteratedFDeriv Real k ((h : Real → Complex) ∘ q) z‖ ≤
        scale ^ N * ((k.factorial : Real) * (scale⁻¹ ^ N * S) * Cinner ^ k) := by
      gcongr
    _ = ((k.factorial : Real) * Cinner ^ k) * S := by
      rw [inv_pow]
      field_simp [pow_ne_zero N hscale.ne']
    _ = ((k.factorial : Real) * Cinner ^ k) *
        ∑ i ∈ Finset.range (k + 1),
          ‖scratchWeightedTemporalDerivativeProfile h i N (q z)‖ := by rfl

/-- Exact scale/translation derivative formula for the vertical profile. -/
private theorem iteratedFDeriv_scratchVerticalProfile_eq
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) (k : Nat) (tau : Real) :
    iteratedFDeriv Real k
      (scratchVerticalProfile beta scale n hscale : Real → Complex) tau =
      (Real.sqrt scale)⁻¹ ^ k • iteratedFDeriv Real k
        (beta : Real → Complex) ((Real.sqrt scale)⁻¹ * tau - n) := by
  let root : Real := Real.sqrt scale
  let a : Real := root⁻¹
  let c : Real := root * n
  have hroot : root ≠ 0 := by
    exact Real.sqrt_ne_zero'.mpr hscale
  have hfun : (scratchVerticalProfile beta scale n hscale : Real → Complex) =
      fun t : Real => (fun y : Real => beta (a • y)) (t - c) := by
    funext t
    rw [scratchVerticalProfile_apply]
    change beta ((Real.sqrt scale)⁻¹ * t - n) = beta (a * (t - c))
    dsimp only [a, c, root]
    field_simp [hroot]
  rw [hfun]
  have hsub :
      iteratedFDeriv Real k
        (fun t : Real => (fun y : Real => beta (a • y)) (t - c)) tau =
      iteratedFDeriv Real k (fun y : Real => beta (a • y)) (tau - c) := by
    simpa using (iteratedFDeriv_comp_sub (𝕜 := Real)
      (f := fun y : Real => beta (a • y)) k c tau)
  rw [hsub]
  rw [iteratedFDeriv_comp_const_smul a (beta.smooth (k : ℕ∞))]
  simp only [smul_eq_mul, a, c, root]
  congr 1
  field_simp [hroot]

/-- Each fixed vertical derivative is uniformly bounded once `scale ≥ 1`. -/
private theorem exists_scratchVerticalProfile_iteratedFDeriv_uniform_bound
    (beta : SchwartzMap Real Complex) (k : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ (n : Int) (tau : Real),
        ‖iteratedFDeriv Real k
          (scratchVerticalProfile beta scale n hscale : Real → Complex) tau‖ ≤ C := by
  obtain ⟨C, hCpos, hC⟩ := beta.decay 0 k
  refine ⟨C, hCpos.le, ?_⟩
  intro scale hscale hscaleone n tau
  rw [iteratedFDeriv_scratchVerticalProfile_eq]
  rw [norm_smul, Real.norm_eq_abs]
  have hroot : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
  rw [abs_of_nonneg (pow_nonneg (inv_nonneg.mpr hroot.le) k)]
  calc
    (Real.sqrt scale)⁻¹ ^ k *
        ‖iteratedFDeriv Real k (beta : Real → Complex)
          ((Real.sqrt scale)⁻¹ * tau - n)‖ ≤
      1 * ‖iteratedFDeriv Real k (beta : Real → Complex)
          ((Real.sqrt scale)⁻¹ * tau - n)‖ := by
        gcongr
        exact pow_le_one₀ (inv_nonneg.mpr hroot.le)
          (inv_le_one_of_one_le₀ (Real.one_le_sqrt.mpr hscaleone))
    _ ≤ C := by simpa using hC ((Real.sqrt scale)⁻¹ * tau - n)

/-- Coordinate projection does not enlarge a joint iterated derivative. -/
private theorem scratch_norm_iteratedFDeriv_joint_snd_le
    (h : SchwartzMap Real Complex)
    (k : Nat) (z : JointWaveSpaceTime) :
    ‖iteratedFDeriv Real k
        (fun w : JointWaveSpaceTime => h (WithLp.sndL 2 Real (Euclidean 2) Real w)) z‖ ≤
      ‖iteratedFDeriv Real k (h : Real → Complex) z.snd‖ := by
  let L : JointWaveSpaceTime →L[Real] Real :=
    WithLp.sndL 2 Real (Euclidean 2) Real
  have hL : ‖L‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
    intro w
    simpa [L] using WithLp.norm_snd_le (p := 2) (Euclidean 2) w
  change ‖iteratedFDeriv Real k ((h : Real → Complex) ∘ L) z‖ ≤
    ‖iteratedFDeriv Real k (h : Real → Complex) (L z)‖
  rw [L.iteratedFDeriv_comp_right (h.smooth (⊤ : ℕ∞)) z (by exact_mod_cast le_top)]
  calc
    ‖(iteratedFDeriv Real k (h : Real → Complex) (L z)).compContinuousLinearMap
        (fun _ => L)‖ ≤
      ‖iteratedFDeriv Real k (h : Real → Complex) (L z)‖ * ∏ _ : Fin k, ‖L‖ :=
        ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv Real k (h : Real → Complex) (L z)‖ * ∏ _ : Fin k, (1 : Real) := by
      gcongr
    _ = ‖iteratedFDeriv Real k (h : Real → Complex) (L z)‖ := by simp

/-- Uniform joint derivative bound for each vertical factor. -/
private theorem exists_scratchJointVerticalFactor_iteratedFDeriv_uniform_bound
    (beta : SchwartzMap Real Complex) (k : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ (n : Int) (z : JointWaveSpaceTime),
        ‖iteratedFDeriv Real k
          (scratchJointVerticalFactor (scratchVerticalProfile beta scale n hscale)) z‖ ≤ C := by
  obtain ⟨C, hCnonneg, hC⟩ :=
    exists_scratchVerticalProfile_iteratedFDeriv_uniform_bound beta k
  refine ⟨C, hCnonneg, ?_⟩
  intro scale hscale hscaleone n z
  exact (scratch_norm_iteratedFDeriv_joint_snd_le
    (scratchVerticalProfile beta scale n hscale) k z).trans
    (hC scale hscale hscaleone n z.snd)

/-- Coordinate projection does not enlarge a spatial factor's joint derivatives. -/
private theorem scratch_norm_iteratedFDeriv_joint_fst_le
    (h : Euclidean 2 → Complex) (hsmooth : ContDiff Real (⊤ : ℕ∞) h)
    (k : Nat) (z : JointWaveSpaceTime) :
    ‖iteratedFDeriv Real k
        (fun w : JointWaveSpaceTime => h (WithLp.fstL 2 Real (Euclidean 2) Real w)) z‖ ≤
      ‖iteratedFDeriv Real k h z.fst‖ := by
  let L : JointWaveSpaceTime →L[Real] Euclidean 2 :=
    WithLp.fstL 2 Real (Euclidean 2) Real
  have hL : ‖L‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
    intro w
    simpa [L] using WithLp.norm_fst_le (p := 2) (Euclidean 2) w
  change ‖iteratedFDeriv Real k (h ∘ L) z‖ ≤
    ‖iteratedFDeriv Real k h (L z)‖
  rw [L.iteratedFDeriv_comp_right hsmooth z (by exact_mod_cast le_top)]
  calc
    ‖(iteratedFDeriv Real k h (L z)).compContinuousLinearMap
        (fun _ => L)‖ ≤
      ‖iteratedFDeriv Real k h (L z)‖ * ∏ _ : Fin k, ‖L‖ :=
        ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv Real k h (L z)‖ * ∏ _ : Fin k, (1 : Real) := by
      gcongr
    _ = ‖iteratedFDeriv Real k h (L z)‖ := by simp

private theorem scratchSmoothNormalRadialFactor_smooth
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    ContDiff Real (⊤ : ℕ∞) (scratchSmoothNormalRadialFactor D scale hscale n) := by
  unfold scratchSmoothNormalRadialFactor
  fun_prop

/-- The smooth-normal radial factor has a fixed-order uniform derivative
bound, derived from the cutoff data and the scaled normal-extension bound. -/
private theorem scratchBracket_exists_smoothNormalRadialFactor_iteratedFDeriv_uniform_bound
    (D : MSSRadialTimeCutoffs) (k : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ (n : Int) (xi : Euclidean 2),
        ‖iteratedFDeriv Real k
          (scratchSmoothNormalRadialFactor D scale hscale n) xi‖ ≤ C := by
  let Cr : Nat → Real := fun i => (D.radial.decay 0 i).choose
  have hCr_pos (i : Nat) : 0 < Cr i := by
    simpa [Cr] using (D.radial.decay 0 i).choose_spec.1
  have hCr (i : Nat) (s : Real) :
      ‖iteratedFDeriv Real i (D.radial : Real → Complex) s‖ ≤ Cr i := by
    simpa [Cr] using (D.radial.decay 0 i).choose_spec.2 s
  let Cg : Real := ∑ i ∈ Finset.range (k + 1), Cr i
  have hCg_nonneg : 0 ≤ Cg := by
    apply Finset.sum_nonneg
    intro i hi
    exact hCr_pos i |>.le
  have hCg_bound {i : Nat} (hi : i ≤ k) : Cr i ≤ Cg := by
    apply (Finset.single_le_sum (s := Finset.range (k + 1))
      (f := Cr) (fun j hj => hCr_pos j |>.le))
    exact Finset.mem_range.mpr (Nat.lt_succ_of_le hi)
  let Crho : Nat → Real := fun i =>
    if hi : 1 ≤ i then
      (exists_scratch_scaledNormalExtension_iteratedFDeriv_uniform_bound D i hi).choose
    else 0
  have hCrho {i : Nat} (hi : 1 ≤ i) (scale : Real) (hscale : 0 < scale)
      (hscaleone : 1 ≤ scale) (xi : Euclidean 2) :
      ‖iteratedFDeriv Real i
        (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) xi‖ ≤
        Crho i := by
    simpa only [Crho, dif_pos hi] using
      (exists_scratch_scaledNormalExtension_iteratedFDeriv_uniform_bound D i hi).choose_spec.2
        scale hscale hscaleone xi
  let Cf : Real := ∑ i ∈ Finset.range (k + 1), max 1 (Crho i)
  have hCf_nonneg : 0 ≤ Cf := by
    apply Finset.sum_nonneg
    intro i hi
    exact le_trans zero_le_one (le_max_left _ _)
  have hCf_one : 1 ≤ Cf := by
    calc
      1 ≤ max 1 (Crho 0) := le_max_left _ _
      _ ≤ ∑ i ∈ Finset.range (k + 1), max 1 (Crho i) := by
        exact Finset.single_le_sum (s := Finset.range (k + 1))
          (f := fun i => max 1 (Crho i))
          (fun i hi => le_trans zero_le_one (le_max_left _ _))
          (Finset.mem_range.mpr (Nat.succ_pos k))
  have hCf_bound {i : Nat} (hi : i ≤ k) : Crho i ≤ Cf := by
    calc
      Crho i ≤ max 1 (Crho i) := le_max_right _ _
      _ ≤ ∑ j ∈ Finset.range (k + 1), max 1 (Crho j) := by
        exact Finset.single_le_sum (s := Finset.range (k + 1))
          (f := fun j => max 1 (Crho j))
          (fun j hj => le_trans zero_le_one (le_max_left _ _))
          (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
  refine ⟨(k.factorial : Real) * Cg * Cf ^ k, by positivity, ?_⟩
  intro scale hscale hscaleone n xi
  let q : Euclidean 2 → Real := fun y =>
    (Real.sqrt scale)⁻¹ * scratchScaledNormalExtension D scale hscale y - n
  have hq : ContDiff Real (k : ℕ∞) q := by
    exact (((scratchScaledNormalExtension D scale hscale).smooth (k : ℕ∞)).const_smul
      (Real.sqrt scale)⁻¹).sub contDiff_const
  have hq_eq : scratchSmoothNormalRadialFactor D scale hscale n = D.radial ∘ q := by
    funext y
    simp only [scratchSmoothNormalRadialFactor, q, Function.comp_apply]
  rw [hq_eq]
  apply norm_iteratedFDeriv_comp_le (D.radial.smooth (k : ℕ∞)) hq
    (by simp : (k : WithTop ℕ∞) ≤ ((k : ℕ∞) : WithTop ℕ∞)) xi
  · intro i hi
    exact (hCr i (q xi)).trans (hCg_bound hi)
  · intro i hi1 hi
    have harg := iteratedFDeriv_scratchSmoothNormalRadialArgument_eq
      D scale hscale n i hi1 xi
    change ‖iteratedFDeriv Real i q xi‖ ≤ Cf ^ i
    rw [show q = fun y : Euclidean 2 =>
      (Real.sqrt scale)⁻¹ * scratchScaledNormalExtension D scale hscale y - n by rfl,
      harg, norm_smul, Real.norm_eq_abs]
    have hroot : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
    rw [abs_of_pos (inv_pos.mpr hroot)]
    calc
      (Real.sqrt scale)⁻¹ *
          ‖iteratedFDeriv Real i
            (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) xi‖ ≤
          1 * Crho i := by
        gcongr
        · exact inv_le_one_of_one_le₀ (Real.one_le_sqrt.mpr hscaleone)
        · exact hCrho hi1 scale hscale hscaleone xi
      _ ≤ Cf := by simpa using hCf_bound hi
      _ ≤ Cf ^ i := le_self_pow₀ hCf_one (Nat.ne_of_gt (Nat.zero_lt_of_lt hi1))

/-- A finite-order product estimate with constants independent of the label.
The deliberately unsimplified finite sum keeps all combinatorics local. -/
private theorem norm_iteratedFDeriv_sq_mul_le_of_uniform_bounds
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    (v r : E → Complex) (hv_smooth : ContDiff Real (⊤ : ℕ∞) v)
    (hr_smooth : ContDiff Real (⊤ : ℕ∞) r)
    (k : Nat) (z : E) (Cv Cr : Real)
    (hCv : 0 ≤ Cv) (_hCr : 0 ≤ Cr)
    (hv : ∀ i : Nat, i ≤ k → ‖iteratedFDeriv Real i v z‖ ≤ Cv)
    (hr : ∀ i : Nat, i ≤ k → ‖iteratedFDeriv Real i r z‖ ≤ Cr) :
    ‖iteratedFDeriv Real k (fun y => v y ^ 2 * r y) z‖ ≤
      ∑ i ∈ Finset.range (k + 1), (k.choose i : Real) *
        (∑ j ∈ Finset.range (i + 1), (i.choose j : Real) * Cv * Cv) * Cr := by
  calc
    ‖iteratedFDeriv Real k (fun y => v y ^ 2 * r y) z‖ ≤
        ∑ i ∈ Finset.range (k + 1), (k.choose i : Real) *
          ‖iteratedFDeriv Real i (fun y => v y ^ 2) z‖ *
            ‖iteratedFDeriv Real (k - i) r z‖ := by
      simpa only using norm_iteratedFDeriv_mul_le
        (f := fun y => v y ^ 2) (g := r)
        (N := ((⊤ : ℕ∞) : WithTop ℕ∞))
        (hv_smooth.pow 2) hr_smooth z (by exact_mod_cast le_top)
    _ ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : Real) *
        (∑ j ∈ Finset.range (i + 1), (i.choose j : Real) * Cv * Cv) * Cr := by
      apply Finset.sum_le_sum
      intro i hi
      have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      have hsquare :
          ‖iteratedFDeriv Real i (fun y => v y ^ 2) z‖ ≤
            ∑ j ∈ Finset.range (i + 1), (i.choose j : Real) * Cv * Cv := by
        calc
          ‖iteratedFDeriv Real i (fun y => v y ^ 2) z‖ ≤
              ∑ j ∈ Finset.range (i + 1), (i.choose j : Real) *
                ‖iteratedFDeriv Real j v z‖ *
                  ‖iteratedFDeriv Real (i - j) v z‖ := by
            simpa only [pow_two] using norm_iteratedFDeriv_mul_le
              (f := v) (g := v) (N := ((⊤ : ℕ∞) : WithTop ℕ∞))
              hv_smooth hv_smooth z
                (by exact_mod_cast le_top : (i : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞))
          _ ≤ ∑ j ∈ Finset.range (i + 1), (i.choose j : Real) * Cv * Cv := by
            apply Finset.sum_le_sum
            intro j hj
            have hji : j ≤ i := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
            have hjk : j ≤ k := hji.trans hik
            have hsub : i - j ≤ k := (Nat.sub_le _ _).trans hik
            calc
              (i.choose j : Real) * ‖iteratedFDeriv Real j v z‖ *
                  ‖iteratedFDeriv Real (i - j) v z‖ ≤
                  (i.choose j : Real) * Cv *
                    ‖iteratedFDeriv Real (i - j) v z‖ := by
                      gcongr
                      exact hv j hjk
              _ ≤ (i.choose j : Real) * Cv * Cv := by
                    gcongr
                    exact hv (i - j) hsub
      have hrk : k - i ≤ k := Nat.sub_le _ _
      have hsq_nonneg : 0 ≤ ∑ j ∈ Finset.range (i + 1),
          (i.choose j : Real) * Cv * Cv := by
        apply Finset.sum_nonneg
        intro j hj
        positivity
      calc
        (k.choose i : Real) * ‖iteratedFDeriv Real i (fun y => v y ^ 2) z‖ *
            ‖iteratedFDeriv Real (k - i) r z‖ ≤
            (k.choose i : Real) *
              (∑ j ∈ Finset.range (i + 1), (i.choose j : Real) * Cv * Cv) *
                ‖iteratedFDeriv Real (k - i) r z‖ := by
              gcongr
        _ ≤ (k.choose i : Real) *
              (∑ j ∈ Finset.range (i + 1), (i.choose j : Real) * Cv * Cv) * Cr := by
              gcongr
              exact hr (k - i) hrk

/-- One double vertical/radial summand of the corrected residual bracket. -/
private noncomputable def scratchDoubleProjectionTerm
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    JointWaveSpaceTime → Complex :=
  fun z =>
    scratchJointVerticalFactor (scratchVerticalProfile D.vertical scale n hscale) z ^ 2 *
      scratchJointNormalRadialFactor D scale hscale n z

private theorem scratchJointVerticalFactor_smooth
    (m : SchwartzMap Real Complex) :
    ContDiff Real (⊤ : ℕ∞) (scratchJointVerticalFactor m) := by
  unfold scratchJointVerticalFactor
  change ContDiff Real (⊤ : ℕ∞)
    ((m : Real → Complex) ∘ WithLp.sndL 2 Real (Euclidean 2) Real)
  exact (m.smooth (⊤ : ℕ∞)).comp
    (WithLp.sndL 2 Real (Euclidean 2) Real).contDiff

private theorem scratchJointNormalRadialFactor_smooth
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    ContDiff Real (⊤ : ℕ∞) (scratchJointNormalRadialFactor D scale hscale n) := by
  unfold scratchJointNormalRadialFactor
  change ContDiff Real (⊤ : ℕ∞)
    (scratchSmoothNormalRadialFactor D scale hscale n ∘
      WithLp.fstL 2 Real (Euclidean 2) Real)
  exact (scratchSmoothNormalRadialFactor_smooth D scale hscale n).comp
    (WithLp.fstL 2 Real (Euclidean 2) Real).contDiff

private theorem scratchBracket_exists_jointNormalRadialFactor_iteratedFDeriv_uniform_bound
    (D : MSSRadialTimeCutoffs) (k : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ (n : Int) (z : JointWaveSpaceTime),
        ‖iteratedFDeriv Real k
          (scratchJointNormalRadialFactor D scale hscale n) z‖ ≤ C := by
  obtain ⟨C, hCnonneg, hC⟩ :=
    scratchBracket_exists_smoothNormalRadialFactor_iteratedFDeriv_uniform_bound D k
  refine ⟨C, hCnonneg, ?_⟩
  intro scale hscale hscaleone n z
  exact (scratch_norm_iteratedFDeriv_joint_fst_le
    (scratchSmoothNormalRadialFactor D scale hscale n)
    (scratchSmoothNormalRadialFactor_smooth D scale hscale n) k z).trans
    (hC scale hscale hscaleone n z.fst)

private theorem scratchDoubleProjectionTerm_smooth
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    ContDiff Real (⊤ : ℕ∞) (scratchDoubleProjectionTerm D scale hscale n) := by
  unfold scratchDoubleProjectionTerm
  exact ((scratchJointVerticalFactor_smooth
    (scratchVerticalProfile D.vertical scale n hscale)).pow 2).mul
      (scratchJointNormalRadialFactor_smooth D scale hscale n)

private noncomputable def scratchBracketTermDerivativeBound
    (k : Nat) (Cv Cr : Real) : Real :=
  ∑ i ∈ Finset.range (k + 1), (k.choose i : Real) *
    (∑ j ∈ Finset.range (i + 1), (i.choose j : Real) * Cv * Cv) * Cr

private theorem scratchBracketTermDerivativeBound_nonneg
    (k : Nat) {Cv Cr : Real} (hCv : 0 ≤ Cv) (hCr : 0 ≤ Cr) :
    0 ≤ scratchBracketTermDerivativeBound k Cv Cr := by
  unfold scratchBracketTermDerivativeBound
  apply Finset.sum_nonneg
  intro i hi
  apply mul_nonneg
  · apply mul_nonneg
    · positivity
    · apply Finset.sum_nonneg
      intro j hj
      positivity
  · exact hCr

private theorem norm_iteratedFDeriv_scratchDoubleProjectionTerm_le_of_factor_bounds
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (k : Nat) (z : JointWaveSpaceTime) (Cv Cr : Real)
    (hCv : 0 ≤ Cv) (hCr : 0 ≤ Cr)
    (hv : ∀ i : Nat, i ≤ k →
      ‖iteratedFDeriv Real i
        (scratchJointVerticalFactor (scratchVerticalProfile D.vertical scale n hscale)) z‖ ≤ Cv)
    (hr : ∀ i : Nat, i ≤ k →
      ‖iteratedFDeriv Real i (scratchJointNormalRadialFactor D scale hscale n) z‖ ≤ Cr) :
    ‖iteratedFDeriv Real k (scratchDoubleProjectionTerm D scale hscale n) z‖ ≤
      scratchBracketTermDerivativeBound k Cv Cr := by
  unfold scratchDoubleProjectionTerm scratchBracketTermDerivativeBound
  exact norm_iteratedFDeriv_sq_mul_le_of_uniform_bounds
    (scratchJointVerticalFactor (scratchVerticalProfile D.vertical scale n hscale))
    (scratchJointNormalRadialFactor D scale hscale n)
    (scratchJointVerticalFactor_smooth _)
    (scratchSmoothNormalRadialFactor_smooth D scale hscale n |>.comp
      (WithLp.fstL 2 Real (Euclidean 2) Real).contDiff)
    k z Cv Cr hCv hCr hv hr

private theorem norm_iteratedFDeriv_finset_sum_le_card_mul_of_bound
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    {ι : Type*} (s : Finset ι) (f : ι → E → Complex) (k : Nat) (z : E)
    (hf : ∀ i ∈ s, ContDiff Real (⊤ : ℕ∞) (f i))
    {B : Real} (hB : ∀ i ∈ s, ‖iteratedFDeriv Real k (f i) z‖ ≤ B) :
    ‖iteratedFDeriv Real k (fun y => ∑ i ∈ s, f i y) z‖ ≤ s.card * B := by
  calc
    ‖iteratedFDeriv Real k (fun y => ∑ i ∈ s, f i y) z‖ =
        ‖∑ i ∈ s, iteratedFDeriv Real k (f i) z‖ := by
      rw [iteratedFDeriv_fun_sum_apply]
      intro i hi
      exact ((hf i hi).of_le (by exact_mod_cast le_top)).contDiffAt
    _ ≤ ∑ i ∈ s, ‖iteratedFDeriv Real k (f i) z‖ := norm_sum_le _ _
    _ ≤ ∑ _ ∈ s, B := by
      apply Finset.sum_le_sum
      intro i hi
      exact hB i hi
    _ = s.card * B := by simp [nsmul_eq_mul]

private theorem norm_iteratedFDeriv_const_one_le_one
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    (k : Nat) (z : E) :
    ‖iteratedFDeriv Real k (fun _ : E => (1 : Complex)) z‖ ≤ 1 := by
  cases k with
  | zero => simp
  | succ k =>
    rw [iteratedFDeriv_const_of_ne (Nat.succ_ne_zero k) (1 : Complex)]
    norm_num

/-- The only growth in the finite corrected bracket is the `O(√scale)`
number of radial labels.  The hypotheses are exactly the fixed-order uniform
factor bounds supplied by the vertical and smooth-normal radial calculus. -/
private theorem norm_iteratedFDeriv_scratchSmoothResidualBracket_le_sqrt_of_factor_bounds
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (hscale_two : 2 ≤ scale) (k : Nat) (Cv Cr : Real)
    (hCv : 0 ≤ Cv) (hCr : 0 ≤ Cr)
    (hv : ∀ (i : Nat), i ≤ k → ∀ (n : Int) (z : JointWaveSpaceTime),
      ‖iteratedFDeriv Real i
        (scratchJointVerticalFactor (scratchVerticalProfile D.vertical scale n hscale)) z‖ ≤ Cv)
    (hr : ∀ (i : Nat), i ≤ k → ∀ (n : Int) (z : JointWaveSpaceTime),
      ‖iteratedFDeriv Real i (scratchJointNormalRadialFactor D scale hscale n) z‖ ≤ Cr) :
    ∀ z : JointWaveSpaceTime,
      ‖iteratedFDeriv Real k
        (scratchSmoothResidualBracket D scale hscale
          (relevantRadialIndexEnumeration scale)) z‖ ≤
        (1 + 11 * scratchBracketTermDerivativeBound k Cv Cr) * Real.sqrt scale := by
  let indices : Finset Int := relevantRadialIndexEnumeration scale
  let B : Real := scratchBracketTermDerivativeBound k Cv Cr
  have hB : 0 ≤ B := scratchBracketTermDerivativeBound_nonneg k hCv hCr
  have hscale_one : 1 ≤ scale := by linarith
  have hroot_one : 1 ≤ Real.sqrt scale :=
    Real.one_le_sqrt.mpr hscale_one
  have hcard : (indices.card : Real) ≤ 11 * Real.sqrt scale := by
    exact card_relevantRadialIndexEnumeration_le_eleven_mul_sqrt hscale_two
  intro z
  have hterm (n : Int) (hn : n ∈ indices) :
      ‖iteratedFDeriv Real k (scratchDoubleProjectionTerm D scale hscale n) z‖ ≤ B := by
    exact norm_iteratedFDeriv_scratchDoubleProjectionTerm_le_of_factor_bounds
      D scale hscale n k z Cv Cr hCv hCr
      (fun i hi => hv i hi n z) (fun i hi => hr i hi n z)
  have hsum :
      ‖iteratedFDeriv Real k
        (fun y => ∑ n ∈ indices, scratchDoubleProjectionTerm D scale hscale n y) z‖ ≤
        indices.card * B :=
    norm_iteratedFDeriv_finset_sum_le_card_mul_of_bound indices
      (scratchDoubleProjectionTerm D scale hscale) k z
      (fun n hn => scratchDoubleProjectionTerm_smooth D scale hscale n) hterm
  have hsumAt : ContDiffAt Real k
      (fun y => ∑ n ∈ indices, scratchDoubleProjectionTerm D scale hscale n y) z := by
    apply ContDiffAt.sum
    intro n hn
    exact ((scratchDoubleProjectionTerm_smooth D scale hscale n).of_le
      (by exact_mod_cast le_top)).contDiffAt
  have hconstAt : ContDiffAt Real k
      (fun _ : JointWaveSpaceTime => (1 : Complex)) z := contDiffAt_const
  have hbracket : scratchSmoothResidualBracket D scale hscale indices =
      fun y => (1 : Complex) - ∑ n ∈ indices,
        scratchDoubleProjectionTerm D scale hscale n y := by
    rfl
  have hbase :
      ‖iteratedFDeriv Real k
        (scratchSmoothResidualBracket D scale hscale indices) z‖ ≤
        1 + indices.card * B := by
    rw [hbracket]
    change ‖iteratedFDeriv Real k
      ((fun _ : JointWaveSpaceTime => (1 : Complex)) -
        fun y => ∑ n ∈ indices, scratchDoubleProjectionTerm D scale hscale n y) z‖ ≤ _
    rw [iteratedFDeriv_sub_apply hconstAt hsumAt]
    exact (norm_sub_le _ _).trans
      (add_le_add (norm_iteratedFDeriv_const_one_le_one k z) hsum)
  calc
    ‖iteratedFDeriv Real k
        (scratchSmoothResidualBracket D scale hscale
          (relevantRadialIndexEnumeration scale)) z‖ =
        ‖iteratedFDeriv Real k
          (scratchSmoothResidualBracket D scale hscale indices) z‖ := by rfl
    _ ≤ 1 + indices.card * B := hbase
    _ ≤ 1 + (11 * Real.sqrt scale) * B := by
      gcongr
    _ ≤ (1 + 11 * B) * Real.sqrt scale := by
      nlinarith

/-- Unconditional fixed-order `O(√scale)` pointwise derivative estimate for
the corrected smooth residual bracket.  All constants are manufactured from
the cutoff data; the square-root growth is solely the radial label count. -/
private theorem exists_scratchSmoothResidualBracket_iteratedFDeriv_le_sqrt
    (D : MSSRadialTimeCutoffs) (k : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
      ∀ z : JointWaveSpaceTime,
        ‖iteratedFDeriv Real k
          (scratchSmoothResidualBracket D scale hscale
            (relevantRadialIndexEnumeration scale)) z‖ ≤ C * Real.sqrt scale := by
  let Cv : Nat → Real := fun i =>
    (exists_scratchJointVerticalFactor_iteratedFDeriv_uniform_bound D.vertical i).choose
  have hCv_nonneg (i : Nat) : 0 ≤ Cv i := by
    simpa [Cv] using
      (exists_scratchJointVerticalFactor_iteratedFDeriv_uniform_bound D.vertical i).choose_spec.1
  have hCv_apply (i : Nat) (scale : Real) (hscale : 0 < scale)
      (hscaleone : 1 ≤ scale) (n : Int) (z : JointWaveSpaceTime) :
      ‖iteratedFDeriv Real i
        (scratchJointVerticalFactor (scratchVerticalProfile D.vertical scale n hscale)) z‖ ≤ Cv i := by
    simpa [Cv] using
      (exists_scratchJointVerticalFactor_iteratedFDeriv_uniform_bound D.vertical i).choose_spec.2
        scale hscale hscaleone n z
  let Cr : Nat → Real := fun i =>
    (scratchBracket_exists_jointNormalRadialFactor_iteratedFDeriv_uniform_bound D i).choose
  have hCr_nonneg (i : Nat) : 0 ≤ Cr i := by
    simpa [Cr] using
      (scratchBracket_exists_jointNormalRadialFactor_iteratedFDeriv_uniform_bound D i).choose_spec.1
  have hCr_apply (i : Nat) (scale : Real) (hscale : 0 < scale)
      (hscaleone : 1 ≤ scale) (n : Int) (z : JointWaveSpaceTime) :
      ‖iteratedFDeriv Real i
        (scratchJointNormalRadialFactor D scale hscale n) z‖ ≤ Cr i := by
    simpa [Cr] using
      (scratchBracket_exists_jointNormalRadialFactor_iteratedFDeriv_uniform_bound D i).choose_spec.2
        scale hscale hscaleone n z
  let CvTot : Real := ∑ i ∈ Finset.range (k + 1), Cv i
  have hCvTot_nonneg : 0 ≤ CvTot := by
    apply Finset.sum_nonneg
    intro i hi
    exact hCv_nonneg i
  have hCvTot_bound {i : Nat} (hi : i ≤ k) : Cv i ≤ CvTot := by
    apply Finset.single_le_sum (s := Finset.range (k + 1))
      (f := Cv) (fun j hj => hCv_nonneg j)
    exact Finset.mem_range.mpr (Nat.lt_succ_of_le hi)
  let CrTot : Real := ∑ i ∈ Finset.range (k + 1), Cr i
  have hCrTot_nonneg : 0 ≤ CrTot := by
    apply Finset.sum_nonneg
    intro i hi
    exact hCr_nonneg i
  have hCrTot_bound {i : Nat} (hi : i ≤ k) : Cr i ≤ CrTot := by
    apply Finset.single_le_sum (s := Finset.range (k + 1))
      (f := Cr) (fun j hj => hCr_nonneg j)
    exact Finset.mem_range.mpr (Nat.lt_succ_of_le hi)
  let B : Real := scratchBracketTermDerivativeBound k CvTot CrTot
  have hB_nonneg : 0 ≤ B :=
    scratchBracketTermDerivativeBound_nonneg k hCvTot_nonneg hCrTot_nonneg
  refine ⟨1 + 11 * B, by positivity, ?_⟩
  intro scale hscale hscale_two z
  have hscale_one : 1 ≤ scale := by linarith
  exact norm_iteratedFDeriv_scratchSmoothResidualBracket_le_sqrt_of_factor_bounds
    D scale hscale hscale_two k CvTot CrTot hCvTot_nonneg hCrTot_nonneg
    (fun i hi n w => (hCv_apply i scale hscale hscale_one n w).trans
      (hCvTot_bound hi))
    (fun i hi n w => (hCr_apply i scale hscale hscale_one n w).trans
      (hCrTot_bound hi)) z

private theorem scratch_normal_shear_measurePreserving
    (rho : SchwartzMap (Euclidean 2) Real) :
    MeasurePreserving
      (fun z : WaveSpaceTime => (z.1, z.2 - rho z.1)) volume volume := by
  rw [Measure.volume_eq_prod]
  refine (MeasurePreserving.id (volume : Measure (Euclidean 2))).skew_product
    (g := fun xi (t : Real) => t - rho xi) ?_ ?_
  · exact measurable_snd.sub (rho.continuous.measurable.comp measurable_fst)
  · filter_upwards with xi
    simpa only [sub_eq_add_neg] using
      (measurePreserving_add_right (volume : Measure Real) (-rho xi)).map_eq

/-- The literal nonnegative spatial--normal product is integrable after a
normal shear whenever its spatial factor is integrable and its temporal
factor is Schwartz. -/
private theorem integrable_sheared_norm_mul_norm
    {E : Type*} [NormedAddCommGroup E]
    (A : Euclidean 2 → E) (hA : Integrable A)
    (H : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    Integrable (fun z : WaveSpaceTime =>
      ‖A z.1‖ * ‖H (z.2 - rho z.1)‖) := by
  let shear : WaveSpaceTime → WaveSpaceTime :=
    fun z => (z.1, z.2 - rho z.1)
  let P : WaveSpaceTime → Real := fun z => ‖A z.1‖ * ‖H z.2‖
  have hP : Integrable P volume := by
    rw [Measure.volume_eq_prod]
    exact hA.norm.mul_prod H.integrable.norm
  have hshear : MeasurePreserving shear volume volume := by
    simpa only [shear] using scratch_normal_shear_measurePreserving rho
  have hcomp : Integrable (P ∘ shear) volume :=
    (hshear.integrable_comp hP.aestronglyMeasurable).mpr hP
  have heq : P ∘ shear = fun z : WaveSpaceTime =>
      ‖A z.1‖ * ‖H (z.2 - rho z.1)‖ := by
    funext z
    rfl
  rw [← heq]
  exact hcomp

/-- The same literal shear product on the joint Hilbert `WithLp` coordinate
model is integrable; this is transport through `WithLp.toLp`. -/
private theorem integrable_joint_sheared_norm_mul_norm
    {E : Type*} [NormedAddCommGroup E]
    (A : Euclidean 2 → E) (hA : Integrable A)
    (H : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    Integrable (fun z : JointWaveSpaceTime =>
      ‖A z.fst‖ * ‖H (z.snd - rho z.fst)‖) := by
  let Q : JointWaveSpaceTime → Real := fun z =>
    ‖A z.fst‖ * ‖H (z.snd - rho z.fst)‖
  change Integrable Q volume
  have hraw := integrable_sheared_norm_mul_norm A hA H rho
  have hpres : MeasurePreserving
      (WithLp.toLp 2 : WaveSpaceTime → JointWaveSpaceTime) volume volume := by
    simpa only using (WithLp.volume_preserving_toLp (Euclidean 2) Real)
  rw [← hpres.integrable_comp_emb
    (MeasurableEquiv.toLp 2 WaveSpaceTime).measurableEmbedding]
  have heq : Q ∘ (WithLp.toLp 2 : WaveSpaceTime → JointWaveSpaceTime) =
      fun p : WaveSpaceTime => ‖A p.1‖ * ‖H (p.2 - rho p.1)‖ := by
    funext p
    rfl
  rw [heq]
  exact hraw

/-- Literal Fubini-plus-shear identity for an arbitrary integrable spatial
factor and a Schwartz temporal profile. -/
private theorem integral_sheared_norm_mul_norm_eq
    {E : Type*} [NormedAddCommGroup E]
    (A : Euclidean 2 → E) (hA : Integrable A)
    (H : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    (∫ z : WaveSpaceTime, ‖A z.1‖ * ‖H (z.2 - rho z.1)‖) =
      (∫ xi : Euclidean 2, ‖A xi‖) * ∫ t : Real, ‖H t‖ := by
  let shear : WaveSpaceTime → WaveSpaceTime :=
    fun z => (z.1, z.2 - rho z.1)
  let P : WaveSpaceTime → Real := fun z => ‖A z.1‖ * ‖H z.2‖
  have hPmeas : AEStronglyMeasurable P volume := by
    rw [Measure.volume_eq_prod]
    exact (hA.aestronglyMeasurable.norm.comp_fst).mul
      (H.continuous.aestronglyMeasurable.norm.comp_snd)
  have hshear : MeasurePreserving shear volume volume := by
    simpa only [shear] using scratch_normal_shear_measurePreserving rho
  have hPmeas_map : AEStronglyMeasurable P (Measure.map shear volume) := by
    rw [hshear.map_eq]
    exact hPmeas
  have htransport : (∫ z : WaveSpaceTime, P (shear z)) = ∫ z : WaveSpaceTime, P z := by
    calc
      (∫ z : WaveSpaceTime, P (shear z)) =
          ∫ z : WaveSpaceTime, P z ∂Measure.map shear volume := by
            exact (integral_map hshear.measurable.aemeasurable hPmeas_map).symm
      _ = ∫ z : WaveSpaceTime, P z := by rw [hshear.map_eq]
  calc
    (∫ z : WaveSpaceTime, ‖A z.1‖ * ‖H (z.2 - rho z.1)‖) =
        ∫ z : WaveSpaceTime, P (shear z) := by rfl
    _ = ∫ z : WaveSpaceTime, P z := htransport
    _ = (∫ xi : Euclidean 2, ‖A xi‖) * ∫ t : Real, ‖H t‖ := by
      rw [Measure.volume_eq_prod]
      exact integral_prod_mul (fun xi : Euclidean 2 => ‖A xi‖)
        (fun t : Real => ‖H t‖)

/-- `WithLp.volume_preserving_toLp` transports the raw Fubini formula to the
joint frequency Hilbert model without any extra regularity on `A`. -/
private theorem integral_joint_sheared_norm_mul_norm_eq
    {E : Type*} [NormedAddCommGroup E]
    (A : Euclidean 2 → E) (hA : Integrable A)
    (H : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    (∫ z : JointWaveSpaceTime, ‖A z.fst‖ * ‖H (z.snd - rho z.fst)‖) =
      (∫ xi : Euclidean 2, ‖A xi‖) * ∫ t : Real, ‖H t‖ := by
  let Q : JointWaveSpaceTime → Real := fun z =>
    ‖A z.fst‖ * ‖H (z.snd - rho z.fst)‖
  have hpres : MeasurePreserving
      (WithLp.toLp 2 : WaveSpaceTime → JointWaveSpaceTime) volume volume := by
    simpa only using (WithLp.volume_preserving_toLp (Euclidean 2) Real)
  have htransport :
      (∫ p : WaveSpaceTime, Q (WithLp.toLp 2 p)) =
        ∫ z : JointWaveSpaceTime, Q z :=
    hpres.integral_comp
      (MeasurableEquiv.toLp 2 WaveSpaceTime).measurableEmbedding Q
  calc
    (∫ z : JointWaveSpaceTime, ‖A z.fst‖ * ‖H (z.snd - rho z.fst)‖) =
        ∫ z : JointWaveSpaceTime, Q z := by rfl
    _ = ∫ p : WaveSpaceTime, Q (WithLp.toLp 2 p) := htransport.symm
    _ = ∫ p : WaveSpaceTime, ‖A p.1‖ * ‖H (p.2 - rho p.1)‖ := by rfl
    _ = (∫ xi : Euclidean 2, ‖A xi‖) * ∫ t : Real, ‖H t‖ :=
      integral_sheared_norm_mul_norm_eq A hA H rho
/-- Integrability of the scaled-amplitude derivative envelope in joint
coordinates. -/
private theorem integrable_joint_sheared_norm_iteratedFDeriv_scratchScaledAmplitude
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (a : Nat) (H : SchwartzMap Real Complex) :
    Integrable (fun z : JointWaveSpaceTime =>
      ‖iteratedFDeriv Real a
        (scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ *
        ‖H (z.snd - scratchScaledNormalExtension D scale hscale z.fst)‖) := by
  have hA : Integrable (fun xi : Euclidean 2 =>
      ‖iteratedFDeriv Real a
        (scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) xi‖) := by
    simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume
      (scratchScaledAmplitude D scale hscale) 0 a
  simpa only [norm_norm] using
    (integrable_joint_sheared_norm_mul_norm
      (fun xi : Euclidean 2 =>
        ‖iteratedFDeriv Real a
          (scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) xi‖)
      hA H (scratchScaledNormalExtension D scale hscale))

/-- Exact joint-coordinate version of the scaled-amplitude shear identity. -/
private theorem integral_joint_sheared_norm_iteratedFDeriv_scratchScaledAmplitude_eq
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (a : Nat) (H : SchwartzMap Real Complex) :
    (∫ z : JointWaveSpaceTime,
      ‖iteratedFDeriv Real a
        (scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ *
        ‖H (z.snd - scratchScaledNormalExtension D scale hscale z.fst)‖) =
      (scale⁻¹ ^ a * ((scale⁻¹) ^ 2)⁻¹ *
        ∫ xi : Euclidean 2,
          ‖iteratedFDeriv Real a (D.amplitude : Euclidean 2 → Complex) xi‖) *
        ∫ t : Real, ‖H t‖ := by
  have hA : Integrable (fun xi : Euclidean 2 =>
      ‖iteratedFDeriv Real a
        (scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) xi‖) := by
    simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume
      (scratchScaledAmplitude D scale hscale) 0 a
  calc
    (∫ z : JointWaveSpaceTime,
      ‖iteratedFDeriv Real a
        (scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ *
        ‖H (z.snd - scratchScaledNormalExtension D scale hscale z.fst)‖) =
        (∫ xi : Euclidean 2,
          ‖iteratedFDeriv Real a
            (scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) xi‖) *
          ∫ t : Real, ‖H t‖ := by
      simpa only [norm_norm] using
        (integral_joint_sheared_norm_mul_norm_eq
          (fun xi : Euclidean 2 =>
            ‖iteratedFDeriv Real a
              (scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) xi‖)
          hA H (scratchScaledNormalExtension D scale hscale))
    _ = (scale⁻¹ ^ a * ((scale⁻¹) ^ 2)⁻¹ *
        ∫ xi : Euclidean 2,
          ‖iteratedFDeriv Real a (D.amplitude : Euclidean 2 → Complex) xi‖) *
        ∫ t : Real, ‖H t‖ := by
      rw [integral_norm_iteratedFDeriv_scratchScaledAmplitude]

/-- The joint-coordinate envelope has at most the planar `scale²` volume
loss for `scale ≥ 1`. -/
private theorem integral_joint_sheared_norm_iteratedFDeriv_scratchScaledAmplitude_le_scale_sq
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (hscaleone : 1 ≤ scale) (a : Nat) (H : SchwartzMap Real Complex) :
    (∫ z : JointWaveSpaceTime,
      ‖iteratedFDeriv Real a
        (scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ *
        ‖H (z.snd - scratchScaledNormalExtension D scale hscale z.fst)‖) ≤
      scale ^ 2 *
        (∫ xi : Euclidean 2,
          ‖iteratedFDeriv Real a (D.amplitude : Euclidean 2 → Complex) xi‖) *
        ∫ t : Real, ‖H t‖ := by
  let IA : Real := ∫ xi : Euclidean 2,
    ‖iteratedFDeriv Real a (D.amplitude : Euclidean 2 → Complex) xi‖
  let IH : Real := ∫ t : Real, ‖H t‖
  have hIA : 0 ≤ IA := integral_nonneg fun xi => norm_nonneg _
  have hIH : 0 ≤ IH := integral_nonneg fun t => norm_nonneg _
  have hscale_inv : 0 ≤ scale⁻¹ := inv_nonneg.mpr hscale.le
  have hinvpow : scale⁻¹ ^ a ≤ 1 :=
    pow_le_one₀ hscale_inv (inv_le_one_of_one_le₀ hscaleone)
  have hjac : ((scale⁻¹) ^ 2)⁻¹ = scale ^ 2 := by
    field_simp [hscale.ne']
  have hfactor : scale⁻¹ ^ a * ((scale⁻¹) ^ 2)⁻¹ ≤ scale ^ 2 := by
    rw [hjac]
    calc
      scale⁻¹ ^ a * scale ^ 2 ≤ 1 * scale ^ 2 := by gcongr
      _ = scale ^ 2 := one_mul _
  calc
    (∫ z : JointWaveSpaceTime,
      ‖iteratedFDeriv Real a
        (scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ *
        ‖H (z.snd - scratchScaledNormalExtension D scale hscale z.fst)‖) =
      (scale⁻¹ ^ a * ((scale⁻¹) ^ 2)⁻¹ * IA) * IH := by
        simpa only [IA, IH] using
          integral_joint_sheared_norm_iteratedFDeriv_scratchScaledAmplitude_eq
            D scale hscale a H
    _ ≤ (scale ^ 2 * IA) * IH := by gcongr
    _ = scale ^ 2 * IA * IH := by ring
namespace ScratchResidualMultiplierL1

private theorem joint_fstL_norm_le_one :
    ‖WithLp.fstL 2 Real (Euclidean 2) Real‖ ≤ 1 := by
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
  intro z
  simpa using WithLp.norm_fst_le (p := 2) (Euclidean 2) z

private theorem norm_iteratedFDeriv_scaledAmplitude_comp_fst_le
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (k : Nat) (z : JointWaveSpaceTime) :
    ‖iteratedFDeriv Real k
      (fun w : JointWaveSpaceTime => scratchScaledAmplitude D scale hscale w.fst) z‖ ≤
      ‖iteratedFDeriv Real k
        (scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ := by
  let L : JointWaveSpaceTime →L[Real] Euclidean 2 :=
    WithLp.fstL 2 Real (Euclidean 2) Real
  change ‖iteratedFDeriv Real k
    ((scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) ∘ L) z‖ ≤ _
  rw [L.iteratedFDeriv_comp_right
    ((scratchScaledAmplitude D scale hscale).smooth (k : ℕ∞)) z le_rfl]
  calc
    ‖(iteratedFDeriv Real k
        (scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) (L z)).compContinuousLinearMap
          (fun _ => L)‖ ≤
        ‖iteratedFDeriv Real k
          (scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) (L z)‖ *
          ∏ _ : Fin k, ‖L‖ :=
      ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv Real k
          (scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) (L z)‖ *
          ∏ _ : Fin k, (1 : Real) := by
      gcongr
      exact joint_fstL_norm_le_one
    _ = ‖iteratedFDeriv Real k
          (scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ := by
      simp [L]

private theorem scratchSmoothResidualProfile_eq_scaledAmplitude_mul_bracket_time
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (z : JointWaveSpaceTime) :
    scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale) z =
      scratchScaledAmplitude D scale hscale z.fst *
        (scratchSmoothResidualBracket D scale hscale
          (relevantRadialIndexEnumeration scale) z *
          FourierTransform.fourier (D.time : Real → Complex)
            (scratchJointNormalDifference D scale hscale z)) := by
  have hz : WithLp.toLp 2 (z.fst, z.snd) = z := by
    apply (WithLp.ext_iff 2).2
    rfl
  rw [← hz, scratchSmoothResidualProfile_apply]
  simp only [scratchScaledAmplitude_apply, scratchScaledNormalExtension_apply,
    scratchJointNormalDifference,
    WithLp.toLp_fst, WithLp.toLp_snd]
  ring


