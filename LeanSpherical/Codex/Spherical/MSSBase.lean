private theorem overlap_lintegral_ofReal_pow_four_eq_of_integrable
    {X : Type*} [MeasurableSpace X] {mu : Measure X}
    (f : X → Real) (hf : Integrable (fun x => f x ^ (4 : Nat)) mu)
    (hfnn : ∀ x, 0 ≤ f x) :
    (∫⁻ x, (ENNReal.ofReal (f x)) ^ (4 : Real) ∂mu) =
      ENNReal.ofReal (∫ x, f x ^ (4 : Nat) ∂mu) := by
  symm
  calc
    ENNReal.ofReal (∫ x, f x ^ (4 : Nat) ∂mu) =
        ENNReal.ofReal (∫ x, ‖f x ^ (4 : Nat)‖ ∂mu) := by
          congr 2
          funext x
          rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (hfnn x) _)]
    _ = ∫⁻ x, enorm (f x ^ (4 : Nat)) ∂mu :=
      ofReal_integral_norm_eq_lintegral_enorm hf
    _ = ∫⁻ x, (ENNReal.ofReal (f x)) ^ (4 : Real) ∂mu := by
      apply lintegral_congr
      intro x
      rw [Real.enorm_eq_ofReal (pow_nonneg (hfnn x) _),
        ENNReal.ofReal_pow (hfnn x)]
      norm_num

private theorem overlap_eLpNorm_four_le_of_integral_pow_four_le
    {X : Type*} [MeasurableSpace X] {mu : Measure X}
    (f g : X → Real)
    (hf : Integrable (fun x => f x ^ (4 : Nat)) mu)
    (hg : Integrable (fun x => g x ^ (4 : Nat)) mu)
    (hfnn : ∀ x, 0 ≤ f x) (hgnn : ∀ x, 0 ≤ g x)
    {C : Real} (hC : 0 ≤ C)
    (hmoment : (∫ x, f x ^ (4 : Nat) ∂mu) ≤
      C * (∫ x, g x ^ (4 : Nat) ∂mu)) :
    eLpNorm f (4 : ENNReal) mu ≤
      ENNReal.ofReal (C ^ (1 / 4 : Real)) * eLpNorm g (4 : ENNReal) mu := by
  have hmomentF := overlap_lintegral_ofReal_pow_four_eq_of_integrable f hf hfnn
  have hmomentG := overlap_lintegral_ofReal_pow_four_eq_of_integrable g hg hgnn
  have hmoment :
      (∫⁻ x, (ENNReal.ofReal (f x)) ^ (4 : Real) ∂mu) ≤
        ENNReal.ofReal C *
          (∫⁻ x, (ENNReal.ofReal (g x)) ^ (4 : Real) ∂mu) := by
    calc
      (∫⁻ x, (ENNReal.ofReal (f x)) ^ (4 : Real) ∂mu) =
          ENNReal.ofReal (∫ x, f x ^ (4 : Nat) ∂mu) := hmomentF
      _ ≤ ENNReal.ofReal (C * (∫ x, g x ^ (4 : Nat) ∂mu)) :=
        ENNReal.ofReal_le_ofReal hmoment
      _ = ENNReal.ofReal C * ENNReal.ofReal
          (∫ x, g x ^ (4 : Nat) ∂mu) := ENNReal.ofReal_mul hC
      _ = ENNReal.ofReal C *
          (∫⁻ x, (ENNReal.ofReal (g x)) ^ (4 : Real) ∂mu) := by
        rw [hmomentG]
  have hfLp :
      (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ (4 : Real) ∂mu) =
        (eLpNorm f (4 : ENNReal) mu) ^ (4 : Real) := by
    simpa using
      (Codex.Spherical.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow
        (by norm_num : (0 : Real) < 4) f)
  have hgLp :
      (∫⁻ x, (ENNReal.ofReal ‖g x‖) ^ (4 : Real) ∂mu) =
        (eLpNorm g (4 : ENNReal) mu) ^ (4 : Real) := by
    simpa using
      (Codex.Spherical.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow
        (by norm_num : (0 : Real) < 4) g)
  have hmomentNorm :
      (eLpNorm f (4 : ENNReal) mu) ^ (4 : Real) ≤
        ENNReal.ofReal C * (eLpNorm g (4 : ENNReal) mu) ^ (4 : Real) := by
    calc
      (eLpNorm f (4 : ENNReal) mu) ^ (4 : Real) =
          (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ (4 : Real) ∂mu) := hfLp.symm
      _ = (∫⁻ x, (ENNReal.ofReal (f x)) ^ (4 : Real) ∂mu) := by
        apply lintegral_congr
        intro x
        rw [Real.norm_of_nonneg (hfnn x)]
      _ ≤ ENNReal.ofReal C *
          (∫⁻ x, (ENNReal.ofReal (g x)) ^ (4 : Real) ∂mu) := hmoment
      _ = ENNReal.ofReal C *
          (∫⁻ x, (ENNReal.ofReal ‖g x‖) ^ (4 : Real) ∂mu) := by
        congr 1
        apply lintegral_congr
        intro x
        rw [Real.norm_of_nonneg (hgnn x)]
      _ = ENNReal.ofReal C * (eLpNorm g (4 : ENNReal) mu) ^ (4 : Real) := by
        rw [hgLp]
  have hroot := ENNReal.rpow_le_rpow hmomentNorm
    (by norm_num : (0 : Real) ≤ 1 / 4)
  calc
    eLpNorm f (4 : ENNReal) mu =
        ((eLpNorm f (4 : ENNReal) mu) ^ (4 : Real)) ^ (1 / 4 : Real) := by
      rw [← ENNReal.rpow_mul]
      norm_num
    _ ≤ (ENNReal.ofReal C *
        (eLpNorm g (4 : ENNReal) mu) ^ (4 : Real)) ^ (1 / 4 : Real) := hroot
    _ = (ENNReal.ofReal C) ^ (1 / 4 : Real) * eLpNorm g (4 : ENNReal) mu := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : Real) ≤ 1 / 4),
        ← ENNReal.rpow_mul]
      norm_num
    _ = ENNReal.ofReal (C ^ (1 / 4 : Real)) * eLpNorm g (4 : ENNReal) mu := by
      rw [ENNReal.ofReal_rpow_of_nonneg hC (by norm_num : (0 : Real) ≤ 1 / 4)]

private theorem overlap_exists_gamma_for_overlap_exponent
    {eta overlapExponent : Real}
    (heta : 0 < eta) (hoverlapExponent : 0 < overlapExponent) :
    ∃ gamma : Real, 0 < gamma ∧ gamma < 1 / 10 ∧
      overlapExponent * gamma ≤ 2 * eta := by
  refine ⟨min (1 / 20 : Real) (2 * eta / overlapExponent), ?_, ?_, ?_⟩
  · exact lt_min (by norm_num)
      (div_pos (mul_pos (by norm_num) heta) hoverlapExponent)
  · calc
      min (1 / 20 : Real) (2 * eta / overlapExponent) ≤ 1 / 20 := min_le_left _ _
      _ < 1 / 10 := by norm_num
  · calc
      overlapExponent * min (1 / 20 : Real) (2 * eta / overlapExponent) ≤
          overlapExponent * (2 * eta / overlapExponent) :=
            mul_le_mul_of_nonneg_left (min_le_right _ _) hoverlapExponent.le
      _ = 2 * eta := by field_simp [hoverlapExponent.ne']

private theorem overlap_exists_Ceta_coefficient
    {eta A overlapExponent Cgamma gamma : Real}
    (heta : 0 < eta) (hA : 0 < A) (hCgamma : 0 < Cgamma)
    (hgammaLoss : overlapExponent * gamma ≤ 2 * eta) :
    ∃ Ceta : Real, 0 < Ceta ∧
      ∀ (scale : Real) (K : Nat), 2 ≤ scale ->
        ((K : Real) + 1 ≤ A * (1 + Real.log scale)) ->
        (((K : Real) + 1) * Cgamma * scale ^ (overlapExponent * gamma)) ^
            (1 / 4 : Real) ≤ Ceta * scale ^ eta := by
  let delta : Real := 2 * eta
  have hdelta : 0 < delta := by
    dsimp only [delta]
    positivity
  let Ceta : Real := (A * (1 + delta⁻¹) * Cgamma) ^ (1 / 4 : Real)
  have hinnerPos : 0 < A * (1 + delta⁻¹) * Cgamma := by
    have hinvPos : 0 < delta⁻¹ := inv_pos.mpr hdelta
    positivity
  have hCeta : 0 < Ceta := Real.rpow_pos_of_pos hinnerPos _
  refine ⟨Ceta, hCeta, ?_⟩
  intro scale K hscale hK
  have hscaleOne : 1 ≤ scale := by linarith
  have hscalePos : 0 < scale := lt_of_lt_of_le zero_lt_one hscaleOne
  have hlog : 1 + Real.log scale ≤ (1 + delta⁻¹) * scale ^ delta :=
    one_add_log_le_rpow hscaleOne hdelta
  have hlevels : (K : Real) + 1 ≤ A * ((1 + delta⁻¹) * scale ^ delta) := by
    calc
      (K : Real) + 1 ≤ A * (1 + Real.log scale) := hK
      _ ≤ A * ((1 + delta⁻¹) * scale ^ delta) :=
        mul_le_mul_of_nonneg_left hlog hA.le
  have hbase :
      ((K : Real) + 1) * Cgamma * scale ^ (overlapExponent * gamma) ≤
        (A * (1 + delta⁻¹) * Cgamma) *
          scale ^ (delta + overlapExponent * gamma) := by
    calc
      ((K : Real) + 1) * Cgamma * scale ^ (overlapExponent * gamma) ≤
          (A * ((1 + delta⁻¹) * scale ^ delta) * Cgamma) *
            scale ^ (overlapExponent * gamma) := by
              apply mul_le_mul_of_nonneg_right
              apply mul_le_mul_of_nonneg_right hlevels hCgamma.le
              exact Real.rpow_nonneg hscalePos.le _
      _ = (A * (1 + delta⁻¹) * Cgamma) *
          scale ^ (delta + overlapExponent * gamma) := by
            calc
              A * ((1 + delta⁻¹) * scale ^ delta) * Cgamma *
                  scale ^ (overlapExponent * gamma) =
                  (A * (1 + delta⁻¹) * Cgamma) *
                    (scale ^ delta * scale ^ (overlapExponent * gamma)) := by
                      ring
              _ = (A * (1 + delta⁻¹) * Cgamma) *
                    scale ^ (delta + overlapExponent * gamma) := by
                      rw [← Real.rpow_add hscalePos]
  have hexponent : delta + overlapExponent * gamma ≤ 4 * eta := by
    dsimp only [delta]
    linarith [hgammaLoss]
  have hscalePower : scale ^ (delta + overlapExponent * gamma) ≤
      scale ^ (4 * eta) :=
    Real.rpow_le_rpow_of_exponent_le hscaleOne hexponent
  have hlarge :
      ((K : Real) + 1) * Cgamma * scale ^ (overlapExponent * gamma) ≤
        (A * (1 + delta⁻¹) * Cgamma) * scale ^ (4 * eta) := by
    calc
      ((K : Real) + 1) * Cgamma * scale ^ (overlapExponent * gamma) ≤
          (A * (1 + delta⁻¹) * Cgamma) *
            scale ^ (delta + overlapExponent * gamma) := hbase
      _ ≤ (A * (1 + delta⁻¹) * Cgamma) * scale ^ (4 * eta) :=
        mul_le_mul_of_nonneg_left hscalePower hinnerPos.le
  have hleftNonneg : 0 ≤
      ((K : Real) + 1) * Cgamma * scale ^ (overlapExponent * gamma) := by
    positivity
  have hroot := Real.rpow_le_rpow hleftNonneg hlarge
    (by norm_num : (0 : Real) ≤ 1 / 4)
  calc
    (((K : Real) + 1) * Cgamma * scale ^ (overlapExponent * gamma)) ^
        (1 / 4 : Real) ≤
        ((A * (1 + delta⁻¹) * Cgamma) * scale ^ (4 * eta)) ^
          (1 / 4 : Real) := hroot
    _ = (A * (1 + delta⁻¹) * Cgamma) ^ (1 / 4 : Real) *
          (scale ^ (4 * eta)) ^ (1 / 4 : Real) := by
            rw [Real.mul_rpow hinnerPos.le (Real.rpow_nonneg hscalePos.le _)]
    _ = Ceta * scale ^ eta := by
      dsimp only [Ceta]
      rw [← Real.rpow_mul hscalePos.le]
      congr 2
      ring

private theorem overlap_eLpNorm_four_le_of_moment
    {X : Type*} [MeasurableSpace X] {mu : Measure X}
    (f g : X → Real)
    (hf : Integrable (fun x => f x ^ (4 : Nat)) mu)
    (hg : Integrable (fun x => g x ^ (4 : Nat)) mu)
    (hfnn : ∀ x, 0 ≤ f x) (hgnn : ∀ x, 0 ≤ g x)
    {M Ceta scale eta : Real} (hM : 0 ≤ M)
    (hmoment : (∫ x, f x ^ (4 : Nat) ∂mu) ≤
      M * (∫ x, g x ^ (4 : Nat) ∂mu))
    (hcoefficient : M ^ (1 / 4 : Real) ≤ Ceta * scale ^ eta) :
    eLpNorm f (4 : ENNReal) mu ≤
      ENNReal.ofReal (Ceta * scale ^ eta) * eLpNorm g (4 : ENNReal) mu := by
  calc
    eLpNorm f (4 : ENNReal) mu ≤
        ENNReal.ofReal (M ^ (1 / 4 : Real)) * eLpNorm g (4 : ENNReal) mu :=

      overlap_eLpNorm_four_le_of_integral_pow_four_le f g hf hg hfnn hgnn hM hmoment
    _ ≤ ENNReal.ofReal (Ceta * scale ^ eta) * eLpNorm g (4 : ENNReal) mu := by
      simpa only [mul_comm] using
        mul_le_mul_right (ENNReal.ofReal_le_ofReal hcoefficient)
          (eLpNorm g (4 : ENNReal) mu)

private theorem integral_pow_four_recombined_le_of_plateMultiplicity_bound
    (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real)
    (hlevels : angularSeparationLevelData maxLevel
      sectorRadius spacingLower spacingUpper)
    {overlapExponent Cgamma gamma : Real} (hCgamma : 0 < Cgamma)
    {scale : Real} (hscale : 2 ≤ scale)
    (radialIndices angularIndices : Finset Int) (directions : Int → Euclidean 2)
    (hgeometry : angularSectorGeometry scale angularIndices directions
      sectorRadius spacingLower spacingUpper)
    (P : Int → Int → SchwartzMap JointWaveSpaceTime Complex)
    (hP : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      Function.support (jointSchwartzRaw (P n nu)) ⊆
        conicPlate scale gamma angularConstant n (directions nu))
    (hmult : ∀ n ∈ radialIndices, ∀ n' ∈ radialIndices,
      ∀ k : Nat, k ≤ maxLevel scale → ∀ Z : WaveSpaceTime,
        (plateOverlapMultiplicity scale gamma angularConstant n n'
          angularIndices directions k Z : Real) ≤
          Cgamma * scale ^ (overlapExponent * gamma)) :
    (∫ z : WaveSpaceTime,
      (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices
        (fun n nu => jointInversePacket (P n nu)) z) ^ (4 : Nat)) ≤
      (((maxLevel scale + 1 : Nat) : Real) * Cgamma *
        scale ^ (overlapExponent * gamma)) *
        (∫ z : WaveSpaceTime,
          (angularRadialSquareFunction radialIndices angularIndices
            (fun n nu => jointInversePacket (P n nu)) z) ^ (4 : Nat)) := by
  classical
  let K : Nat := maxLevel scale
  let M : Real := Cgamma * scale ^ (overlapExponent * gamma)
  have hscalePos : 0 < scale := by linarith
  have hKnonneg : 0 ≤ ((K + 1 : Nat) : Real) := by positivity
  let R : Int → Int → Int × Int → SchwartzMap JointWaveSpaceTime Complex :=
    fun n n' pair => SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
      (P n pair.1) (P n' pair.2)
  have hclass (n n' : Int) (hn : n ∈ radialIndices) (hn' : n' ∈ radialIndices)
      (k : Nat) (hk : k ∈ Finset.range (K + 1)) :
      (∫ z : WaveSpaceTime,
        ‖∑ pair ∈ angularSeparationPairs angularIndices k,
          jointInversePacket (R n n' pair) z‖ ^ (2 : Nat)) ≤
        M * ∑ pair ∈ angularSeparationPairs angularIndices k,
          ∫ z : WaveSpaceTime, ‖jointInversePacket (R n n' pair) z‖ ^ (2 : Nat) := by
    have hk' : k ≤ maxLevel scale := by
      dsimp only [K] at hk ⊢
      exact Nat.le_of_lt_succ (Finset.mem_range.mp hk)
    have hM : ∀ Z : WaveSpaceTime,
        (plateOverlapMultiplicity scale gamma angularConstant n n'
          angularIndices directions k Z : Real) ≤ M := by
      intro Z
      dsimp only [M]
      exact hmult n hn n' hn' k hk' Z
    simpa only [R] using
      integral_norm_sq_angularPairProducts_le_of_plateMultiplicity
        scale gamma angularConstant n n' angularIndices directions k P
        (fun nu hnu => hP n hn nu hnu)
        (fun nu hnu => hP n' hn' nu hnu) M hM
  have hper (n n' : Int) (hn : n ∈ radialIndices) (hn' : n' ∈ radialIndices) :
      (∫ z : WaveSpaceTime,
        ‖∑ pair ∈ angularIndices.product angularIndices,
          jointInversePacket (R n n' pair) z‖ ^ (2 : Nat)) ≤
        ((K + 1 : Nat) : Real) * M *
          ∑ pair ∈ angularIndices.product angularIndices,
            ∫ z : WaveSpaceTime, ‖jointInversePacket (R n n' pair) z‖ ^ (2 : Nat) := by
    have hlevels' := integral_norm_sq_full_angularPair_sum_le_level_sums
      maxLevel sectorRadius spacingLower spacingUpper hlevels hscale
      angularIndices directions hgeometry (R n n')
    have hclassSum :
        ∑ k ∈ Finset.range (K + 1),
          (∫ z : WaveSpaceTime,
            ‖∑ pair ∈ angularSeparationPairs angularIndices k,
              jointInversePacket (R n n' pair) z‖ ^ (2 : Nat)) ≤
        ∑ k ∈ Finset.range (K + 1), M *
          ∑ pair ∈ angularSeparationPairs angularIndices k,
            ∫ z : WaveSpaceTime, ‖jointInversePacket (R n n' pair) z‖ ^ (2 : Nat) := by
      apply Finset.sum_le_sum
      intro k hk
      exact hclass n n' hn hn' k (by simpa only [K] using hk)
    have hpartition :
        ∑ k ∈ Finset.range (K + 1),
          ∑ pair ∈ angularSeparationPairs angularIndices k,
            ∫ z : WaveSpaceTime, ‖jointInversePacket (R n n' pair) z‖ ^ (2 : Nat) =
        ∑ pair ∈ angularIndices.product angularIndices,
          ∫ z : WaveSpaceTime, ‖jointInversePacket (R n n' pair) z‖ ^ (2 : Nat) := by
      dsimp only [K]
      exact sum_angularSeparationPairs_range_succ_of_levelData
        maxLevel sectorRadius spacingLower spacingUpper hlevels hscale
        angularIndices directions hgeometry
        (fun pair => ∫ z : WaveSpaceTime,
          ‖jointInversePacket (R n n' pair) z‖ ^ (2 : Nat))
    calc
      (∫ z : WaveSpaceTime,
        ‖∑ pair ∈ angularIndices.product angularIndices,
          jointInversePacket (R n n' pair) z‖ ^ (2 : Nat)) ≤
          ((K + 1 : Nat) : Real) *
            ∑ k ∈ Finset.range (K + 1),
              ∫ z : WaveSpaceTime,
                ‖∑ pair ∈ angularSeparationPairs angularIndices k,
                  jointInversePacket (R n n' pair) z‖ ^ (2 : Nat) := by
        simpa only [K] using hlevels'
      _ ≤ ((K + 1 : Nat) : Real) *
          ∑ k ∈ Finset.range (K + 1), M *
            ∑ pair ∈ angularSeparationPairs angularIndices k,
              ∫ z : WaveSpaceTime, ‖jointInversePacket (R n n' pair) z‖ ^ (2 : Nat) :=
        mul_le_mul_of_nonneg_left hclassSum hKnonneg
      _ = ((K + 1 : Nat) : Real) * M *
          ∑ k ∈ Finset.range (K + 1),
            ∑ pair ∈ angularSeparationPairs angularIndices k,
              ∫ z : WaveSpaceTime, ‖jointInversePacket (R n n' pair) z‖ ^ (2 : Nat) := by
        rw [← Finset.mul_sum]
        ring
      _ = ((K + 1 : Nat) : Real) * M *
          ∑ pair ∈ angularIndices.product angularIndices,
            ∫ z : WaveSpaceTime, ‖jointInversePacket (R n n' pair) z‖ ^ (2 : Nat) := by
        rw [hpartition]
  have haux := integral_pow_four_aux_angularRadialRecombinedSquareFunction_eq_pair_sums
    radialIndices angularIndices P
  have hfine := integral_pow_four_angularRadialSquareFunction_eq_pair_sum
    radialIndices angularIndices P
  calc
    (∫ z : WaveSpaceTime,
      (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices
        (fun n nu => jointInversePacket (P n nu)) z) ^ (4 : Nat)) =
        ∑ n ∈ radialIndices, ∑ n' ∈ radialIndices,
          ∫ z : WaveSpaceTime,
            ‖∑ pair ∈ angularIndices.product angularIndices,
              jointInversePacket (R n n' pair) z‖ ^ (2 : Nat) := by
          simpa only [R] using haux
    _ ≤ ∑ n ∈ radialIndices, ∑ n' ∈ radialIndices,
        ((K + 1 : Nat) : Real) * M *
          ∑ pair ∈ angularIndices.product angularIndices,
            ∫ z : WaveSpaceTime, ‖jointInversePacket (R n n' pair) z‖ ^ (2 : Nat) := by
      apply Finset.sum_le_sum
      intro n hn
      apply Finset.sum_le_sum
      intro n' hn'
      exact hper n n' hn hn'
    _ = ((K + 1 : Nat) : Real) * M *
        ∑ n ∈ radialIndices, ∑ n' ∈ radialIndices,
          ∑ pair ∈ angularIndices.product angularIndices,
            ∫ z : WaveSpaceTime, ‖jointInversePacket (R n n' pair) z‖ ^ (2 : Nat) := by
      symm
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro n hn
      rw [Finset.mul_sum]
    _ = ((maxLevel scale + 1 : Nat) : Real) * Cgamma *
        scale ^ (overlapExponent * gamma) *
          (∫ z : WaveSpaceTime,
            (angularRadialSquareFunction radialIndices angularIndices
              (fun n nu => jointInversePacket (P n nu)) z) ^ (4 : Nat)) := by
      dsimp only [K, M]
      rw [hfine]
      simp only [R]
      ring


private theorem aux_overlapSquareFunction_proof
    (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real) :
    overlapSquareFunction maxLevel angularConstant
      sectorRadius spacingLower spacingUpper := by
  intro hplate hlevels eta heta
  rcases hplate.2 with ⟨overlapExponent, hoverlapExponent, hplate⟩
  rcases overlap_exists_gamma_for_overlap_exponent heta hoverlapExponent with
    ⟨gamma, hgamma, hgammaUpper, hgammaLoss⟩
  rcases hplate gamma hgamma hgammaUpper with ⟨Cgamma, hCgamma, hplate⟩
  rcases hlevels.2 with ⟨A, hA, hlevelBound⟩
  rcases overlap_exists_Ceta_coefficient heta hA hCgamma hgammaLoss with
    ⟨Ceta, hCeta, hcoefficient⟩
  refine ⟨gamma, hgamma, hgammaUpper, Ceta, hCeta, ?_⟩
  intro scale hscale radialIndices angularIndices directions hgeometry P hP
  let F : WaveSpaceTime → Real :=
    aux_angularRadialRecombinedSquareFunction radialIndices angularIndices
      (fun n nu => jointInversePacket (P n nu))
  let G : WaveSpaceTime → Real :=
    angularRadialSquareFunction radialIndices angularIndices
      (fun n nu => jointInversePacket (P n nu))
  let M : Real := ((maxLevel scale + 1 : Nat) : Real) * Cgamma *
    scale ^ (overlapExponent * gamma)
  have hFint : Integrable (fun z : WaveSpaceTime => F z ^ (4 : Nat)) volume := by
    dsimp only [F]
    exact integrable_pow_four_aux_angularRadialRecombinedSquareFunction_jointInversePacket
      radialIndices angularIndices P
  have hGint : Integrable (fun z : WaveSpaceTime => G z ^ (4 : Nat)) volume := by
    dsimp only [G]
    exact integrable_pow_four_angularRadialSquareFunction_jointInversePacket
      radialIndices angularIndices P
  have hFnonneg (z : WaveSpaceTime) : 0 ≤ F z := by
    dsimp only [F, aux_angularRadialRecombinedSquareFunction]
    exact Real.sqrt_nonneg _
  have hGnonneg (z : WaveSpaceTime) : 0 ≤ G z := by
    dsimp only [G, angularRadialSquareFunction]
    exact Real.sqrt_nonneg _
  have hMnonneg : 0 ≤ M := by
    dsimp only [M]
    positivity
  have hmoment :
      (∫ z : WaveSpaceTime, F z ^ (4 : Nat)) ≤
        M * (∫ z : WaveSpaceTime, G z ^ (4 : Nat)) := by
    dsimp only [F, G, M]
    exact integral_pow_four_recombined_le_of_plateMultiplicity_bound
      maxLevel angularConstant sectorRadius spacingLower spacingUpper hlevels hCgamma hscale
      radialIndices angularIndices directions hgeometry P hP
      (fun n hn n' hn' k hk Z =>
        hplate scale hscale radialIndices angularIndices directions hgeometry
          n hn n' hn' k hk Z)
  have hroot : M ^ (1 / 4 : Real) ≤ Ceta * scale ^ eta := by
    dsimp only [M]
    convert hcoefficient scale (maxLevel scale) hscale (hlevelBound scale hscale) using 1 <;>
      norm_num
  have hnorm := overlap_eLpNorm_four_le_of_moment F G hFint hGint hFnonneg hGnonneg
    hMnonneg hmoment hroot
  change eLpNorm F (4 : ENNReal) volume ≤
    ENNReal.ofReal (Ceta * scale ^ eta) * eLpNorm G (4 : ENNReal) volume at hnorm
  simpa only [F, G, jointInversePacket] using hnorm

theorem overlapSquareFunction_of_levelData
    (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real) :
    overlapSquareFunction maxLevel angularConstant
      sectorRadius spacingLower spacingUpper :=
  aux_overlapSquareFunction_proof maxLevel angularConstant
    sectorRadius spacingLower spacingUpper



/-- A finite family of supplied temporal-Schwartz normal projections directly
consumes the analytic plate-overlap square-function hypothesis once each joint
Fourier profile satisfies the displayed conic-plate criterion.  The conclusion
is solely for this literal projected model: it neither identifies it with a
raw `angularPiece` nor asserts a separable spectral-packet representation. -/
theorem overlapSquareFunction_temporalSchwartzAnnularNormalProjections
    (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real)
    (hoverlap : overlapSquareFunctionRawHypothesis maxLevel angularConstant sectorRadius
      spacingLower spacingUpper)
    (hangular : 0 < angularConstant)
    (eta : Real) (heta : 0 < eta)
    (gamma : Real) (hgamma : 0 < gamma) (hgammaUpper : gamma < 1 / 10)
    (scale : Real) (hscale : 2 ≤ scale)
    (radialIndices angularIndices : Finset Int) (directions : Int → Euclidean 2)
    (hgeometry : angularSectorGeometry scale angularIndices directions
      sectorRadius spacingLower spacingUpper)
    (B u : Int → Int → SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : Int → Int → SchwartzMap Real Complex)
    (rho : Int → Int → SchwartzMap (Euclidean 2) Real)
    (hrho : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      ∀ xi ∈ Function.support (B n nu : Euclidean 2 → Complex),
        rho n nu xi = ‖xi‖)
    (hu : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      ∀ xi ∈ Function.support (B n nu : Euclidean 2 → Complex), u n nu xi = 1)
    (hspatial : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      Function.support (B n nu : Euclidean 2 → Complex) ⊆
        {xi | scale / 4 ≤ ‖xi‖ ∧ ‖xi‖ ≤ 4 * scale ∧
          xi ∈ angularSector (directions nu)
            (angularConstant * scale ^ (-(1 / 2 : Real)))})
    (hvertical : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      ∀ xi ∈ Function.support (B n nu : Euclidean 2 → Complex),
      ∀ s ∈ Function.support (beta n nu : Real → Complex),
        |(Real.sqrt scale)⁻¹ * (rho n nu xi + s) - n| ≤ 1)
    (hnormal : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      ∀ s ∈ Function.support (beta n nu : Real → Complex),
        |s| ≤ 2 * scale ^ gamma) :
    ∃ C : Real, 0 < C ∧
      eLpNorm
          (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices
            (fun n nu => temporalSchwartzAnnularNormalProjection
              (B n nu) (u n nu) (vartheta n nu) (beta n nu) (rho n nu)))
          (4 : ENNReal) volume ≤
        ENNReal.ofReal (C * scale ^ eta) *
          eLpNorm
            (angularRadialSquareFunction radialIndices angularIndices
              (fun n nu => temporalSchwartzAnnularNormalProjection
                (B n nu) (u n nu) (vartheta n nu) (beta n nu) (rho n nu)))
            (4 : ENNReal) volume := by
  have hplate : plateOverlap maxLevel angularConstant sectorRadius spacingLower spacingUpper :=
    plateOverlap_of_angularSectorGeometry maxLevel angularConstant sectorRadius
      spacingLower spacingUpper hangular
  rcases hoverlap hplate eta heta with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  apply hbound gamma hgamma hgammaUpper scale hscale radialIndices angularIndices directions
    hgeometry
  intro n hn nu hnu
  exact support_spaceTimeFourier_temporalSchwartzAnnularNormalProjection_subset_conicPlate
    (B n nu) (u n nu) (vartheta n nu) (beta n nu) (rho n nu)
    scale gamma angularConstant n (directions nu)
    (hrho n hn nu hnu) (hu n hn nu hnu) (hspatial n hn nu hnu)
    (hvertical n hn nu hnu) (hnormal n hn nu hnu)

private theorem aux_aestronglyMeasurable_temporalSchwartzAnnularNormalProjection
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    AEStronglyMeasurable
      (temporalSchwartzAnnularNormalProjection B u vartheta beta rho) volume := by
  unfold temporalSchwartzAnnularNormalProjection jointSchwartzSpectralCutoffOutput
    jointSchwartzRaw
  exact
    ((FourierTransform.fourierInv
      (jointSchwartzSpectralCutoffProduct
        (jointSchwartzSpatialNormalCutoff u beta rho)
        (FourierTransform.fourierInv
          (jointSchwartzModulatedAnnularProfile B vartheta rho)))).continuous.comp
        (WithLp.prod_continuous_toLp 2 _ _)).aestronglyMeasurable

private theorem aux_aestronglyMeasurable_temporalSchwartzAnnularNormalTail
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    AEStronglyMeasurable
      (temporalSchwartzAnnularNormalTail B u vartheta beta rho) volume := by
  unfold temporalSchwartzAnnularNormalTail jointSchwartzRaw
  exact
    ((FourierTransform.fourierInv
      (jointSchwartzModulatedAnnularProfile B vartheta rho -
        jointSchwartzSpectralCutoffProduct
          (jointSchwartzSpatialNormalCutoff u beta rho)
          (FourierTransform.fourierInv
            (jointSchwartzModulatedAnnularProfile B vartheta rho)))).continuous.comp
        (WithLp.prod_continuous_toLp 2 _ _)).aestronglyMeasurable

/-- A finite supplied regular angular/radial model is controlled by the
literal normal-projection overlap estimate plus its finite normal-tail error.
All radial profiles and spatial amplitudes are supplied explicitly.  This is
not an assertion about raw compact-time packets, fine square functions,
continuum limits, or `p4LocalSmoothing`. -/
theorem exists_regularAngularPiece_recombined_square_bound_of_overlap_plus_normalTails
    (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real)
    (hoverlap : overlapSquareFunctionRawHypothesis maxLevel angularConstant sectorRadius
      spacingLower spacingUpper)
    (hangular : 0 < angularConstant)
    (eta : Real) (heta : 0 < eta)
    (gamma : Real) (hgamma : 0 < gamma) (hgammaUpper : gamma < 1 / 10)
    (scale : Real) (hscale : 2 ≤ scale)
    (radialIndices angularIndices : Finset Int) (directions : Int → Euclidean 2)
    (hgeometry : angularSectorGeometry scale angularIndices directions
      sectorRadius spacingLower spacingUpper)
    (B R u : Int → Int → SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : Int → Int → SchwartzMap Real Complex)
    (rho : Int → Int → SchwartzMap (Euclidean 2) Real)
    (f : SchwartzMap (Euclidean 2) Complex)
    (a : Euclidean 2 → Complex)
    (chi : Int → Euclidean 2 → Complex)
    (radialCutoff : Real → Complex)
    (hR : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      ∀ xi : Euclidean 2,
        R n nu xi = radialCutoff ((Real.sqrt scale)⁻¹ * ‖xi‖ - n))
    (hB : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      ∀ xi : Euclidean 2, B n nu xi =
        chi nu xi * a (scale⁻¹ • xi) *
          (R n nu xi * FourierTransform.fourier (f : Euclidean 2 → Complex) xi))
    (hrho : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      ∀ xi ∈ Function.support (B n nu : Euclidean 2 → Complex),
        rho n nu xi = ‖xi‖)
    (hu : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      ∀ xi ∈ Function.support (B n nu : Euclidean 2 → Complex),
        u n nu xi = 1)
    (hspatial : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      Function.support (B n nu : Euclidean 2 → Complex) ⊆
        {xi | scale / 4 ≤ ‖xi‖ ∧ ‖xi‖ ≤ 4 * scale ∧
          xi ∈ angularSector (directions nu)
            (angularConstant * scale ^ (-(1 / 2 : Real)))})
    (hvertical : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      ∀ xi ∈ Function.support (B n nu : Euclidean 2 → Complex),
      ∀ s ∈ Function.support (beta n nu : Real → Complex),
        |(Real.sqrt scale)⁻¹ * (rho n nu xi + s) - n| ≤ 1)
    (hnormal : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      ∀ s ∈ Function.support (beta n nu : Real → Complex),
        |s| ≤ 2 * scale ^ gamma) :
    ∃ C : Real, 0 < C ∧
      eLpNorm
          (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices
            (fun n nu => angularPiece scale a (chi nu) (vartheta n nu : Real → Complex)
              (radialPiece radialCutoff scale n (f : Euclidean 2 → Complex))))
          4 volume ≤
        ENNReal.ofReal (C * scale ^ eta) *
          eLpNorm
            (angularRadialSquareFunction radialIndices angularIndices
              (fun n nu => temporalSchwartzAnnularNormalProjection
                (B n nu) (u n nu) (vartheta n nu) (beta n nu) (rho n nu)))
            4 volume +
          ∑ n ∈ radialIndices, ∑ nu ∈ angularIndices,
            eLpNorm
              (temporalSchwartzAnnularNormalTail
                (B n nu) (u n nu) (vartheta n nu) (beta n nu) (rho n nu))
              4 volume := by
  let A : Int → Int → WaveSpaceTime → Complex :=
    fun n nu => angularPiece scale a (chi nu) (vartheta n nu : Real → Complex)
      (radialPiece radialCutoff scale n (f : Euclidean 2 → Complex))
  let P : Int → Int → WaveSpaceTime → Complex :=
    fun n nu => temporalSchwartzAnnularNormalProjection
      (B n nu) (u n nu) (vartheta n nu) (beta n nu) (rho n nu)
  let T : Int → Int → WaveSpaceTime → Complex :=
    fun n nu => temporalSchwartzAnnularNormalTail
      (B n nu) (u n nu) (vartheta n nu) (beta n nu) (rho n nu)
  have hdecomp : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices, ∀ z,
      A n nu z = P n nu z + T n nu z := by
    intro n hn nu hnu z
    exact congrFun
      (angularPiece_eq_projection_add_normalTail_of_schwartzRadialProfile
        (B n nu) (R n nu) f (u n nu) (vartheta n nu) (beta n nu) (rho n nu)
        scale a (chi nu) radialCutoff n (hR n hn nu hnu) (hB n hn nu hnu)
        (hrho n hn nu hnu)) z
  have hPmeas : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      AEStronglyMeasurable (P n nu) volume := by
    intro n hn nu hnu
    exact aux_aestronglyMeasurable_temporalSchwartzAnnularNormalProjection
      (B n nu) (u n nu) (vartheta n nu) (beta n nu) (rho n nu)
  have hTmeas : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      AEStronglyMeasurable (T n nu) volume := by
    intro n hn nu hnu
    exact aux_aestronglyMeasurable_temporalSchwartzAnnularNormalTail
      (B n nu) (u n nu) (vartheta n nu) (beta n nu) (rho n nu)
  have htransfer :=
    aux_eLpNorm_aux_angularRadialRecombinedSquareFunction_full_le_main_add_sum_tails
      radialIndices angularIndices A P T hdecomp hPmeas hTmeas
      (fun n nu => eLpNorm (T n nu) 4 volume)
      (by intro n hn nu hnu; rfl)
  obtain ⟨C, hC, hP⟩ :=
    overlapSquareFunction_temporalSchwartzAnnularNormalProjections
      maxLevel angularConstant sectorRadius spacingLower spacingUpper hoverlap hangular
      eta heta gamma hgamma hgammaUpper scale hscale radialIndices angularIndices directions
      hgeometry B u vartheta beta rho hrho hu hspatial hvertical hnormal
