  apply Codex.Spherical.LpSpaceFacts.memLp_four_of_two_and_top g hg.2.1
  apply memLp_top_of_bound hg.1.aestronglyMeasurable hg.2.2.choose
  exact Filter.Eventually.of_forall hg.2.2.choose_spec.2.1

private theorem aux_norm_finiteTemporalCommonKernelOutput_le_sqrt_card_of_mem_of_bound
    {ι : Type*} [Fintype ι]
    (K : ι → Real → Complex) (κ : Real → Real)
    (hK : ∀ i, Integrable (K i) volume)
    (hκ : ∀ y, 0 ≤ κ y) (hκint : Integrable κ volume)
    (hkernel : ∀ i y, ‖K i y‖ ≤ κ y)
    {g : finiteTemporalCommonKernelBundle ι}
    (hg : g ∈ aux_finiteTemporalCommonKernelDomain ι)
    {A : Real} (hinput : ∀ t, ‖g t‖ ≤ A) (t : Real) :
    ‖finiteTemporalCommonKernelOutput K g t‖ ≤
      Real.sqrt (Fintype.card ι : Real) * (∫ y : Real, κ y) * A := by
  have hA : 0 ≤ A := (norm_nonneg (g 0)).trans (hinput 0)
  have hcoord_bound : ∀ i u, ‖aux_finiteTemporalCommonKernelCoord i g u‖ ≤ A := by
    intro i u
    exact (aux_norm_finiteTemporalCommonKernelCoord_le_norm_bundle (g u) i).trans (hinput u)
  have hprod : ∀ i : ι, Integrable
      (fun y : Real => K i y * aux_finiteTemporalCommonKernelCoord i g (t - y)) volume := by
    intro i
    exact (aux_convolutionExists_of_integrable_of_bound
      (K i) (aux_finiteTemporalCommonKernelCoord i g) (hK i)
      (aux_finiteTemporalCommonKernelCoord_aestronglyMeasurable_of_mem hg i)
      (hcoord_bound i)) t
  have hsumint : Integrable (fun y : Real => ∑ i : ι,
      K i y * aux_finiteTemporalCommonKernelCoord i g (t - y)) volume := by
    exact integrable_finsetSum Finset.univ (fun i _ => hprod i)
  have henvelope : Integrable (fun y : Real =>
      Real.sqrt (Fintype.card ι : Real) * κ y * A) volume := by
    have h := hκint.const_mul (Real.sqrt (Fintype.card ι : Real) * A)
    simpa [mul_assoc, mul_left_comm, mul_comm] using h
  have hsqr_kernel (y : Real) :
      Real.sqrt (∑ i : ι, ‖K i y‖ ^ (2 : Nat)) ≤
        Real.sqrt (Fintype.card ι : Real) * κ y := by
    have hsum : (∑ i : ι, ‖K i y‖ ^ (2 : Nat)) ≤
        (Fintype.card ι : Real) * (κ y) ^ (2 : Nat) := by
      calc
        (∑ i : ι, ‖K i y‖ ^ (2 : Nat)) ≤ ∑ i : ι, (κ y) ^ (2 : Nat) := by
          apply Finset.sum_le_sum
          intro i _
          exact sq_le_sq₀ (norm_nonneg _) (hκ y) |>.mpr (hkernel i y)
        _ = (Fintype.card ι : Real) * (κ y) ^ (2 : Nat) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
    calc
      Real.sqrt (∑ i : ι, ‖K i y‖ ^ (2 : Nat)) ≤
          Real.sqrt ((Fintype.card ι : Real) * (κ y) ^ (2 : Nat)) :=
        Real.sqrt_le_sqrt hsum
      _ = Real.sqrt (Fintype.card ι : Real) * κ y := by
        rw [Real.sqrt_mul (Nat.cast_nonneg _), Real.sqrt_sq_eq_abs,
          abs_of_nonneg (hκ y)]
  have hinput_square : ∀ u : Real,
      Real.sqrt (∑ i : ι, ‖aux_finiteTemporalCommonKernelCoord i g u‖ ^ (2 : Nat)) ≤ A := by
    intro u
    change Real.sqrt (∑ i : ι, ‖(g u).ofLp i‖ ^ (2 : Nat)) ≤ A
    rw [← PiLp.norm_eq_of_L2]
    exact hinput u
  have hpoint (y : Real) :
      ‖∑ i : ι, K i y * aux_finiteTemporalCommonKernelCoord i g (t - y)‖ ≤
        Real.sqrt (Fintype.card ι : Real) * κ y * A := by
    calc
      ‖∑ i : ι, K i y * aux_finiteTemporalCommonKernelCoord i g (t - y)‖ ≤
          ∑ i : ι, ‖K i y‖ * ‖aux_finiteTemporalCommonKernelCoord i g (t - y)‖ := by
        calc
          ‖∑ i : ι, K i y * aux_finiteTemporalCommonKernelCoord i g (t - y)‖ ≤
              ∑ i : ι, ‖K i y * aux_finiteTemporalCommonKernelCoord i g (t - y)‖ :=
            norm_sum_le _ _
          _ = ∑ i : ι, ‖K i y‖ * ‖aux_finiteTemporalCommonKernelCoord i g (t - y)‖ := by
            apply Finset.sum_congr rfl
            intro i _
            rw [norm_mul]
      _ ≤ Real.sqrt (∑ i : ι, ‖K i y‖ ^ (2 : Nat)) *
          Real.sqrt (∑ i : ι,
            ‖aux_finiteTemporalCommonKernelCoord i g (t - y)‖ ^ (2 : Nat)) :=
        Real.sum_mul_le_sqrt_mul_sqrt Finset.univ _ _
      _ ≤ (Real.sqrt (Fintype.card ι : Real) * κ y) * A := by
        exact mul_le_mul (hsqr_kernel y) (hinput_square (t - y))
          (Real.sqrt_nonneg _) (mul_nonneg (Real.sqrt_nonneg _) (hκ y))
      _ = Real.sqrt (Fintype.card ι : Real) * κ y * A := by ring
  unfold finiteTemporalCommonKernelOutput
  calc
    ‖∑ i : ι,
        (K i ⋆[ContinuousLinearMap.mul Complex Complex, volume]
          aux_finiteTemporalCommonKernelCoord i g) t‖ =
        ‖∫ y : Real, ∑ i : ι,
          K i y * aux_finiteTemporalCommonKernelCoord i g (t - y)‖ := by
          congr 2
          rw [integral_finsetSum Finset.univ (fun i _ => hprod i)]
          apply Finset.sum_congr rfl
          intro i _
          rfl
    _ ≤ ∫ y : Real, ‖∑ i : ι,
        K i y * aux_finiteTemporalCommonKernelCoord i g (t - y)‖ :=
      norm_integral_le_integral_norm _
    _ ≤ ∫ y : Real, Real.sqrt (Fintype.card ι : Real) * κ y * A :=
      integral_mono hsumint.norm henvelope hpoint
    _ = Real.sqrt (Fintype.card ι : Real) * (∫ y : Real, κ y) * A := by
      calc
        (∫ y : Real, Real.sqrt (Fintype.card ι : Real) * κ y * A) =
            ∫ y : Real, (Real.sqrt (Fintype.card ι : Real) * A) * κ y := by
              apply integral_congr_ae
              filter_upwards with y
              ring
        _ = (Real.sqrt (Fintype.card ι : Real) * A) * ∫ y : Real, κ y := by
              rw [integral_const_mul]
        _ = Real.sqrt (Fintype.card ι : Real) * (∫ y : Real, κ y) * A := by ring

private theorem aux_lintegral_norm_rpow_two_finiteTemporalHardHigh_eq
    {ι : Type*} [Fintype ι] (g : finiteTemporalCommonKernelBundle ι)
    (hg : Measurable g) (t : Real) :
    (∫⁻ x : Real,
      (ENNReal.ofReal ‖aux_finiteTemporalHardHigh g t x‖) ^ (2 : Real)) =
      ∫⁻ x in {x | t / 2 ≤ ‖g x‖},
        (ENNReal.ofReal ‖g x‖) ^ (2 : Real) := by
  rw [← lintegral_indicator]
  · apply lintegral_congr
    intro x
    by_cases hx : t / 2 ≤ ‖g x‖ <;>
      simp [aux_finiteTemporalHardHigh, hx]
  · exact measurableSet_le measurable_const hg.norm

private theorem aux_measurable_lintegral_norm_rpow_two_finiteTemporalHardHigh
    {ι : Type*} [Fintype ι] {g : finiteTemporalCommonKernelBundle ι}
    (hg : g ∈ finiteTemporalCommonKernelMeasurableDomain ι) :
    Measurable (fun t : Real => ∫⁻ x : Real,
      (ENNReal.ofReal ‖aux_finiteTemporalHardHigh g t x‖) ^ (2 : Real)) := by
  let u : Real → Real := fun x => ‖g x‖
  let baseI : Real → ENNReal := fun s =>
    ∫⁻ x in {x | s ≤ u x}, (ENNReal.ofReal (u x)) ^ (2 : Real)
  have hu : Measurable u := hg.1.norm
  have hv : Measurable (fun x => (ENNReal.ofReal (u x)) ^ (2 : Real)) :=
    ENNReal.continuous_rpow_const.measurable.comp hu.ennreal_ofReal
  have hbaseI : Measurable baseI := by
    exact Codex.Spherical.InterpolationCore.measurable_lintegral_indicator_le u hu _ hv
  have heq : (fun t : Real => ∫⁻ x : Real,
      (ENNReal.ofReal ‖aux_finiteTemporalHardHigh g t x‖) ^ (2 : Real)) =
      fun t : Real => baseI (t / 2) := by
    funext t
    exact aux_lintegral_norm_rpow_two_finiteTemporalHardHigh_eq g hg.1 t
  rw [heq]
  exact hbaseI.comp (measurable_id.div_const 2)

private theorem aux_lintegral_finiteTemporalHardHigh_tail_two_four_eq
    {ι : Type*} [Fintype ι] {g : finiteTemporalCommonKernelBundle ι}
    (hg : g ∈ finiteTemporalCommonKernelMeasurableDomain ι) :
    (∫⁻ t in Set.Ioi (0 : Real),
      (∫⁻ x : Real,
        (ENNReal.ofReal ‖aux_finiteTemporalHardHigh g t x‖) ^ (2 : Real)) *
        (ENNReal.ofReal t) ^ ((4 : Real) - 2 - 1)) =
      (ENNReal.ofReal ((4 : Real) - 2))⁻¹ *
        (ENNReal.ofReal (2 : Real)) ^ ((4 : Real) - 2) *
          ∫⁻ x : Real, (ENNReal.ofReal ‖g x‖) ^ (4 : Real) := by
  calc
    (∫⁻ t in Set.Ioi (0 : Real),
      (∫⁻ x : Real,
        (ENNReal.ofReal ‖aux_finiteTemporalHardHigh g t x‖) ^ (2 : Real)) *
        (ENNReal.ofReal t) ^ ((4 : Real) - 2 - 1)) =
        ∫⁻ t in Set.Ioi (0 : Real),
          (∫⁻ x in {x | t / 2 ≤ ‖g x‖},
            (ENNReal.ofReal ‖g x‖) ^ (2 : Real)) *
            (ENNReal.ofReal t) ^ ((4 : Real) - 2 - 1) := by
          apply lintegral_congr
          intro t
          rw [aux_lintegral_norm_rpow_two_finiteTemporalHardHigh_eq g hg.1]
    _ = _ := by
      simpa only using
        (Codex.Spherical.InterpolationTail.lintegral_high_tail_rpow_eq
          (fun x : Real => ‖g x‖) hg.1.norm (fun x => norm_nonneg _)
          (by norm_num : 0 < (2 : Real)) (by norm_num : (2 : Real) < 4))

private theorem aux_weak_two_normalized_finiteTemporalCommonKernelOutput_sharp_of_mem
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    {C : Real}
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : Nat) ≤ C)
    {Btop : Real} (hBtop : 0 < Btop)
    {g : finiteTemporalCommonKernelBundle (↥indices)}
    (hg : g ∈ aux_finiteTemporalCommonKernelDomain (↥indices))
    {s : Real} (hs : 0 < s) :
    (ENNReal.ofReal s) ^ (2 : Real) *
        volume {t | s < ‖finiteTemporalCommonKernelOutput
          (finiteTemporalCoreKernel indices m) g t‖ / Btop} ≤
      ((ENNReal.ofReal Btop) ^ (2 : Real))⁻¹ * ENNReal.ofReal C *
        ∫⁻ t : Real, (ENNReal.ofReal ‖g t‖) ^ (2 : Real) := by
  let b : ENNReal := (ENNReal.ofReal Btop) ^ (2 : Real)
  have hbpos : 0 < b := by
    exact ENNReal.rpow_pos (ENNReal.ofReal_pos.mpr hBtop) ENNReal.ofReal_ne_top
  have hbtop : b ≠ ∞ := by
    exact ENNReal.rpow_ne_top_of_nonneg (by norm_num) ENNReal.ofReal_ne_top
  have hset : {t | s < ‖finiteTemporalCommonKernelOutput
      (finiteTemporalCoreKernel indices m) g t‖ / Btop} =
      {t | s * Btop < ‖finiteTemporalCommonKernelOutput
        (finiteTemporalCoreKernel indices m) g t‖} := by
    ext t
    exact lt_div_iff₀ hBtop
  have hfactor : (ENNReal.ofReal (s * Btop)) ^ (2 : Real) =
      b * (ENNReal.ofReal s) ^ (2 : Real) := by
    dsimp [b]
    rw [ENNReal.ofReal_mul hs.le,
      ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : 0 ≤ (2 : Real))]
    ac_rfl
  apply (ENNReal.mul_le_mul_iff_right hbpos.ne' hbtop).mp
  change b * ((ENNReal.ofReal s) ^ (2 : Real) *
      volume {t | s < ‖finiteTemporalCommonKernelOutput
        (finiteTemporalCoreKernel indices m) g t‖ / Btop}) ≤
    b * (b⁻¹ * ENNReal.ofReal C * ∫⁻ t : Real,
      (ENNReal.ofReal ‖g t‖) ^ (2 : Real))
  calc
    b * ((ENNReal.ofReal s) ^ (2 : Real) *
        volume {t | s < ‖finiteTemporalCommonKernelOutput
          (finiteTemporalCoreKernel indices m) g t‖ / Btop}) =
        (ENNReal.ofReal (s * Btop)) ^ (2 : Real) *
          volume {t | s * Btop < ‖finiteTemporalCommonKernelOutput
            (finiteTemporalCoreKernel indices m) g t‖} := by
          rw [hset, hfactor]
          ac_rfl
    _ ≤ ENNReal.ofReal C * ∫⁻ t : Real,
        (ENNReal.ofReal ‖g t‖) ^ (2 : Real) :=
      aux_weak_two_finiteTemporalCommonKernelOutput_of_mem
        β scale indices m hprofile hoverlap hg (mul_pos hs hBtop)
    _ = b * (b⁻¹ * ENNReal.ofReal C * ∫⁻ t : Real,
        (ENNReal.ofReal ‖g t‖) ^ (2 : Real)) := by
      rw [show b * (b⁻¹ * ENNReal.ofReal C *
          (∫⁻ t : Real, (ENNReal.ofReal ‖g t‖) ^ (2 : Real))) =
          (b * b⁻¹) * (ENNReal.ofReal C *
            ∫⁻ t : Real, (ENNReal.ofReal ‖g t‖) ^ (2 : Real)) by ac_rfl,
        ENNReal.mul_inv_cancel hbpos.ne' hbtop, one_mul]

private noncomputable def aux_finiteTemporalCoreKernelMajorant
    (indices : Finset Int) (m : Int → SchwartzMap Real Complex) : Real → Real :=
  fun y => ∑ i : (↥indices), ‖finiteTemporalCoreKernel indices m i y‖

private theorem aux_finiteTemporalCoreKernelMajorant_nonneg
    (indices : Finset Int) (m : Int → SchwartzMap Real Complex) (y : Real) :
    0 ≤ aux_finiteTemporalCoreKernelMajorant indices m y := by
  unfold aux_finiteTemporalCoreKernelMajorant
  exact Finset.sum_nonneg fun _ _ => norm_nonneg _

private theorem aux_finiteTemporalCoreKernelMajorant_integrable
    (indices : Finset Int) (m : Int → SchwartzMap Real Complex) :
    Integrable (aux_finiteTemporalCoreKernelMajorant indices m) volume := by
  unfold aux_finiteTemporalCoreKernelMajorant
  exact integrable_finsetSum Finset.univ (fun i _ =>
    (aux_finiteTemporalCoreKernel_integrable indices m i).norm)

private theorem aux_finiteTemporalCoreKernel_le_majorant
    (indices : Finset Int) (m : Int → SchwartzMap Real Complex)
    (i : (↥indices)) (y : Real) :
    ‖finiteTemporalCoreKernel indices m i y‖ ≤
      aux_finiteTemporalCoreKernelMajorant indices m y := by
  unfold aux_finiteTemporalCoreKernelMajorant
  exact Finset.single_le_sum
    (fun (j : ↥indices) _ =>
      norm_nonneg (finiteTemporalCoreKernel indices m j y))
    (Finset.mem_univ i)

private theorem aux_lintegral_normalized_finiteTemporalCommonKernelOutput_rpow_four_le
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    {C : Real}
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : Nat) ≤ C)
    {g : finiteTemporalCommonKernelBundle (↥indices)}
    (hg : g ∈ finiteTemporalCommonKernelMeasurableDomain (↥indices)) :
    (∫⁻ t : Real,
      ENNReal.ofReal
        ((‖finiteTemporalCommonKernelOutput
          (finiteTemporalCoreKernel indices m) g t‖ /
          (1 + Real.sqrt (Fintype.card (↥indices) : Real) *
            ∫ y : Real, aux_finiteTemporalCoreKernelMajorant indices m y)) ^
          (4 : Real))) ≤
      ENNReal.ofReal (4 : Real) *
        ((ENNReal.ofReal (2 : Real)) ^ (2 : Real) *
          ((ENNReal.ofReal
            (1 + Real.sqrt (Fintype.card (↥indices) : Real) *
              ∫ y : Real, aux_finiteTemporalCoreKernelMajorant indices m y)) ^
            (2 : Real))⁻¹ * ENNReal.ofReal C *
          ((ENNReal.ofReal ((4 : Real) - 2))⁻¹ *
            (ENNReal.ofReal (2 : Real)) ^ ((4 : Real) - 2) *
              ∫⁻ x : Real, (ENNReal.ofReal ‖g x‖) ^ (4 : Real))) := by
  let K : (↥indices) → Real → Complex := finiteTemporalCoreKernel indices m
  let κ : Real → Real := aux_finiteTemporalCoreKernelMajorant indices m
  let B0 : Real := Real.sqrt (Fintype.card (↥indices) : Real) * ∫ y : Real, κ y
  let Btop : Real := 1 + B0
  let D : Set (finiteTemporalCommonKernelBundle (↥indices)) :=
    finiteTemporalCommonKernelMeasurableDomain (↥indices)
  let eval : finiteTemporalCommonKernelBundle (↥indices) → Real →
      PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex) := fun h => h
  let T : finiteTemporalCommonKernelBundle (↥indices) → Real → Real := fun h t =>
    ‖finiteTemporalCommonKernelOutput K h t‖ / Btop
  have hK : ∀ i, Integrable (K i) volume := by
    intro i
    exact aux_finiteTemporalCoreKernel_integrable indices m i
  have hκ : ∀ y, 0 ≤ κ y := by
    intro y
    exact aux_finiteTemporalCoreKernelMajorant_nonneg indices m y
  have hκint : Integrable κ volume :=
    aux_finiteTemporalCoreKernelMajorant_integrable indices m
  have hkernel : ∀ i y, ‖K i y‖ ≤ κ y := by
    intro i y
    exact aux_finiteTemporalCoreKernel_le_majorant indices m i y
  have hI : 0 ≤ ∫ y : Real, κ y := integral_nonneg hκ
  have hB0 : 0 ≤ B0 := by
    dsimp [B0]
    exact mul_nonneg (Real.sqrt_nonneg _) hI
  have hBtop : 1 ≤ Btop := by
    dsimp [Btop]
    linarith
  have hBtop_pos : 0 < Btop := lt_of_lt_of_le zero_lt_one hBtop
  have hB0_le : B0 ≤ Btop := by
    dsimp [Btop]
    linarith
  have hT_nonneg : ∀ h t, 0 ≤ T h t := by
    intro h t
    exact div_nonneg (norm_nonneg _) hBtop_pos.le
  have hT_subadd : ∀ ⦃h₁ h₂ : finiteTemporalCommonKernelBundle (↥indices)⦄,
      h₁ ∈ D → h₂ ∈ D → ∀ t, T (h₁ + h₂) t ≤ T h₁ t + T h₂ t := by
    intro h₁ h₂ hh₁ hh₂ t
    change ‖finiteTemporalCommonKernelOutput K (h₁ + h₂) t‖ / Btop ≤
      ‖finiteTemporalCommonKernelOutput K h₁ t‖ / Btop +
        ‖finiteTemporalCommonKernelOutput K h₂ t‖ / Btop
    rw [← add_div]
    apply div_le_div_of_nonneg_right
      (aux_norm_finiteTemporalCommonKernelOutput_add_le_of_mem K hK hh₁.2 hh₂.2 t)
      hBtop_pos.le
  have hweak : ∀ h : finiteTemporalCommonKernelBundle (↥indices), h ∈ D →
      ∀ {s : Real}, 0 < s →
      (ENNReal.ofReal s) ^ (2 : Real) * volume {t | s < T h t} ≤
        ((ENNReal.ofReal Btop) ^ (2 : Real))⁻¹ * ENNReal.ofReal C * ∫⁻ x : Real,
          (ENNReal.ofReal ‖eval h x‖) ^ (2 : Real) := by
    intro h hh s hs
    change (ENNReal.ofReal s) ^ (2 : Real) *
        volume {t | s < ‖finiteTemporalCommonKernelOutput K h t‖ / Btop} ≤
      ((ENNReal.ofReal Btop) ^ (2 : Real))⁻¹ * ENNReal.ofReal C *
        ∫⁻ x : Real, (ENNReal.ofReal ‖h x‖) ^ (2 : Real)
    exact aux_weak_two_normalized_finiteTemporalCommonKernelOutput_sharp_of_mem
      β scale indices m hprofile hoverlap hBtop_pos hh.2 hs
  have hT_top : ∀ h : finiteTemporalCommonKernelBundle (↥indices), h ∈ D →
      ∀ a : Real, 0 ≤ a → (∀ x, ‖eval h x‖ ≤ a) → ∀ t, T h t ≤ a := by
    intro h hh a ha hbound t
    change ‖finiteTemporalCommonKernelOutput K h t‖ / Btop ≤ a
    apply (div_le_iff₀ hBtop_pos).2
    calc
      ‖finiteTemporalCommonKernelOutput K h t‖ ≤ B0 * a := by
        exact aux_norm_finiteTemporalCommonKernelOutput_le_sqrt_card_of_mem_of_bound
          K κ hK hκ hκint hkernel hh.2 hbound t
      _ ≤ Btop * a := mul_le_mul_of_nonneg_right hB0_le ha
      _ = a * Btop := by ring
  let low : Real → finiteTemporalCommonKernelBundle (↥indices) :=
    aux_finiteTemporalHardLow g
  let high : Real → finiteTemporalCommonKernelBundle (↥indices) :=
    aux_finiteTemporalHardHigh g
  have hTf : AEMeasurable (T g) volume := by
    exact ((aux_finiteTemporalCommonKernelOutput_aestronglyMeasurable_of_mem K hK hg.2).norm.aemeasurable.div_const Btop)
  have hlow_mem : ∀ t, low t ∈ D := by
    intro t
    exact aux_finiteTemporalHardLow_mem_measurableDomain hg t
  have hhigh_mem : ∀ t, high t ∈ D := by
    intro t
    exact aux_finiteTemporalHardHigh_mem_measurableDomain hg t
  have hsplit : ∀ t, g = low t + high t := by
    intro t
    exact aux_finiteTemporalHardLow_add_high g t
  have hlow_norm : ∀ t, 0 < t → ∀ x, ‖eval (low t) x‖ ≤ t / 2 := by
    intro t ht x
    exact aux_finiteTemporalHardLow_norm_le_half_height g ht x
  have hhighI_meas : Measurable (fun t : Real =>
      ∫⁻ x : Real, (ENNReal.ofReal ‖eval (high t) x‖) ^ (2 : Real)) := by
    exact aux_measurable_lintegral_norm_rpow_two_finiteTemporalHardHigh hg
  let Aq : ENNReal := (ENNReal.ofReal ((4 : Real) - 2))⁻¹ *
    (ENNReal.ofReal (2 : Real)) ^ ((4 : Real) - 2) *
      ∫⁻ x : Real, (ENNReal.ofReal ‖g x‖) ^ (4 : Real)
  have hhigh_tail :
      (∫⁻ t in Set.Ioi (0 : Real),
        (∫⁻ x : Real, (ENNReal.ofReal ‖eval (high t) x‖) ^ (2 : Real)) *
          (ENNReal.ofReal t) ^ ((4 : Real) - 2 - 1)) ≤ Aq := by
    exact le_of_eq (aux_lintegral_finiteTemporalHardHigh_tail_two_four_eq hg)
  have hmoment := sourceOutput_marcinkiewicz_weak_q_top_on_additive_split
    D eval T hT_nonneg hT_subadd (2 : Real) (by norm_num)
    (((ENNReal.ofReal Btop) ^ (2 : Real))⁻¹ * ENNReal.ofReal C)
    hweak hT_top (by norm_num : (2 : Real) < 4) g hTf low high hlow_mem hhigh_mem
    hsplit hlow_norm hhighI_meas Aq hhigh_tail
  simpa only [K, κ, B0, Btop, D, eval, T, Aq, mul_assoc] using hmoment

private theorem aux_lintegral_finiteTemporalCommonKernelOutput_rpow_four_le
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    {C : Real}
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : Nat) ≤ C)
    {g : finiteTemporalCommonKernelBundle (↥indices)}
    (hg : g ∈ finiteTemporalCommonKernelMeasurableDomain (↥indices)) :
    (∫⁻ t : Real,
      (ENNReal.ofReal ‖finiteTemporalCommonKernelOutput
        (finiteTemporalCoreKernel indices m) g t‖) ^ (4 : Real)) ≤
      (ENNReal.ofReal
        (1 + Real.sqrt (Fintype.card (↥indices) : Real) *
          ∫ y : Real, aux_finiteTemporalCoreKernelMajorant indices m y)) ^
        (4 : Real) *
      (ENNReal.ofReal (4 : Real) *
        ((ENNReal.ofReal (2 : Real)) ^ (2 : Real) *
          ((ENNReal.ofReal
            (1 + Real.sqrt (Fintype.card (↥indices) : Real) *
              ∫ y : Real, aux_finiteTemporalCoreKernelMajorant indices m y)) ^
            (2 : Real))⁻¹ * ENNReal.ofReal C *
          ((ENNReal.ofReal ((4 : Real) - 2))⁻¹ *
            (ENNReal.ofReal (2 : Real)) ^ ((4 : Real) - 2) *
              ∫⁻ x : Real, (ENNReal.ofReal ‖g x‖) ^ (4 : Real)))) := by
  let K : (↥indices) → Real → Complex := finiteTemporalCoreKernel indices m
  let κ : Real → Real := aux_finiteTemporalCoreKernelMajorant indices m
  let Btop : Real := 1 + Real.sqrt (Fintype.card (↥indices) : Real) *
    ∫ y : Real, κ y
  let T : finiteTemporalCommonKernelBundle (↥indices) → Real → Real := fun h t =>
    ‖finiteTemporalCommonKernelOutput K h t‖ / Btop
  have hκ : ∀ y, 0 ≤ κ y := by
    intro y
    exact aux_finiteTemporalCoreKernelMajorant_nonneg indices m y
  have hI : 0 ≤ ∫ y : Real, κ y := integral_nonneg hκ
  have hBtop : 0 < Btop := by
    dsimp [Btop]
    have hnonneg : 0 ≤ Real.sqrt (Fintype.card (↥indices) : Real) * ∫ y : Real, κ y :=
      mul_nonneg (Real.sqrt_nonneg _) hI
    linarith
  have hTnonneg : ∀ t, 0 ≤ T g t := by
    intro t
    exact div_nonneg (norm_nonneg _) hBtop.le
  have hK : ∀ i, Integrable (K i) volume := by
    intro i
    exact aux_finiteTemporalCoreKernel_integrable indices m i
  have hTmeas : AEMeasurable (T g) volume := by
    exact ((aux_finiteTemporalCommonKernelOutput_aestronglyMeasurable_of_mem K hK hg.2).norm.aemeasurable.div_const Btop)
  have hraw_eq (t : Real) :
      ‖finiteTemporalCommonKernelOutput K g t‖ = Btop * T g t := by
    change ‖finiteTemporalCommonKernelOutput K g t‖ =
      Btop * (‖finiteTemporalCommonKernelOutput K g t‖ / Btop)
    field_simp [hBtop.ne']
  have hscaled := Codex.Spherical.InterpolationCore.marcinkiewicz_lintegral_ofReal_scale_rpow
    (T g) Btop (4 : Real) hBtop (by norm_num : 0 ≤ (4 : Real)) hTnonneg hTmeas
  have hmoment := aux_lintegral_normalized_finiteTemporalCommonKernelOutput_rpow_four_le
    β scale indices m hprofile hoverlap hg
  let R : ENNReal := ENNReal.ofReal (4 : Real) *
    ((ENNReal.ofReal (2 : Real)) ^ (2 : Real) *
      ((ENNReal.ofReal Btop) ^ (2 : Real))⁻¹ * ENNReal.ofReal C *
      ((ENNReal.ofReal ((4 : Real) - 2))⁻¹ *
        (ENNReal.ofReal (2 : Real)) ^ ((4 : Real) - 2) *
          ∫⁻ x : Real, (ENNReal.ofReal ‖g x‖) ^ (4 : Real)))
  calc
    (∫⁻ t : Real,
      (ENNReal.ofReal ‖finiteTemporalCommonKernelOutput K g t‖) ^ (4 : Real)) =
        ∫⁻ t : Real, ENNReal.ofReal ((Btop * T g t) ^ (4 : Real)) := by
          apply lintegral_congr
          intro t
          rw [hraw_eq t]
          exact (ENNReal.ofReal_rpow_of_nonneg
            (mul_nonneg hBtop.le (hTnonneg t))
            (by norm_num : 0 ≤ (4 : Real)))
    _ = (ENNReal.ofReal Btop) ^ (4 : Real) *
        ∫⁻ t : Real, ENNReal.ofReal ((T g t) ^ (4 : Real)) := hscaled
    _ ≤ (ENNReal.ofReal Btop) ^ (4 : Real) * R := by
          apply mul_le_mul_of_nonneg_left
          simpa only [R, K, κ, Btop, T, mul_assoc] using hmoment
          positivity
    _ = _ := by
      simp only [R, κ, Btop]

/-- The explicit common-kernel top coefficient used to normalize the finite
vector output. -/
noncomputable def finiteTemporalCoreTopCoefficient
    (indices : Finset Int) (m : Int → SchwartzMap Real Complex) : Real :=
  1 + Real.sqrt (Fintype.card (↥indices) : Real) *
    ∫ y : Real, aux_finiteTemporalCoreKernelMajorant indices m y

/-- The literal fourth-moment upper bound produced by finite-vector weak-`L²`
and top interpolation. -/
noncomputable def finiteTemporalCoreFourthMomentBound
    (C : Real) (indices : Finset Int) (m : Int → SchwartzMap Real Complex)
    (g : finiteTemporalCommonKernelBundle (↥indices)) : ENNReal :=
  (ENNReal.ofReal (finiteTemporalCoreTopCoefficient indices m)) ^ (4 : Real) *
    (ENNReal.ofReal (4 : Real) *
      ((ENNReal.ofReal (2 : Real)) ^ (2 : Real) *
        ((ENNReal.ofReal (finiteTemporalCoreTopCoefficient indices m)) ^
          (2 : Real))⁻¹ * ENNReal.ofReal C *
        ((ENNReal.ofReal ((4 : Real) - 2))⁻¹ *
          (ENNReal.ofReal (2 : Real)) ^ ((4 : Real) - 2) *
            ∫⁻ x : Real, (ENNReal.ofReal ‖g x‖) ^ (4 : Real))))

/-- The input-independent factor in the finite temporal fourth-moment bound.
It is defined only from a finite family of supplied Schwartz multipliers and
the overlap parameter; it contains no measurable-input extension claim. -/
noncomputable def finiteTemporalCoreFourthMomentCoefficient
    (C : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex) : ENNReal :=
  (ENNReal.ofReal (finiteTemporalCoreTopCoefficient indices m)) ^ (4 : Real) *
    (ENNReal.ofReal (4 : Real) *
      ((ENNReal.ofReal (2 : Real)) ^ (2 : Real) *
        ((ENNReal.ofReal (finiteTemporalCoreTopCoefficient indices m)) ^
          (2 : Real))⁻¹ * ENNReal.ofReal C *
        (ENNReal.ofReal ((4 : Real) - 2))⁻¹ *
        (ENNReal.ofReal (2 : Real)) ^ ((4 : Real) - 2)))

/-- The finite temporal fourth-moment bound is the explicit coefficient times
the fourth moment of its finite `PiLp 2` input bundle.  This algebraic
factorization lets later finite Schwartz Fubini arguments use the bound
without unfolding interpolation constants. -/
theorem finiteTemporalCoreFourthMomentBound_eq_coefficient_mul_lintegral
    (C : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (g : finiteTemporalCommonKernelBundle (↥indices)) :
    finiteTemporalCoreFourthMomentBound C indices m g =
      finiteTemporalCoreFourthMomentCoefficient C indices m *
        ∫⁻ t : Real, (ENNReal.ofReal ‖g t‖) ^ (4 : Real) := by
  simp only [finiteTemporalCoreFourthMomentBound,
    finiteTemporalCoreFourthMomentCoefficient, mul_assoc]

private theorem aux_eLpNorm_finiteTemporalCommonKernelOutput_four_le
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    {C : Real}
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : Nat) ≤ C)
    {g : finiteTemporalCommonKernelBundle (↥indices)}
    (hg : g ∈ finiteTemporalCommonKernelMeasurableDomain (↥indices)) :
    eLpNorm (finiteTemporalCommonKernelOutput
      (finiteTemporalCoreKernel indices m) g) (ENNReal.ofReal (4 : Real)) volume ≤
      (finiteTemporalCoreFourthMomentBound C indices m g) ^ ((4 : Real)⁻¹) := by
  let K : (↥indices) → Real → Complex := finiteTemporalCoreKernel indices m
  let κ : Real → Real := aux_finiteTemporalCoreKernelMajorant indices m
  let Btop : Real := finiteTemporalCoreTopCoefficient indices m
  let T : finiteTemporalCommonKernelBundle (↥indices) → Real → Real := fun h t =>
    ‖finiteTemporalCommonKernelOutput K h t‖
  let M : ENNReal := finiteTemporalCoreFourthMomentBound C indices m g
  have hTnonneg : ∀ t, 0 ≤ T g t := by
    intro t
    exact norm_nonneg _
  have hraw := aux_lintegral_finiteTemporalCommonKernelOutput_rpow_four_le
    β scale indices m hprofile hoverlap hg
  have hmoment : (∫⁻ t : Real, ENNReal.ofReal ((T g t) ^ (4 : Real))) ≤ M := by
    calc
      (∫⁻ t : Real, ENNReal.ofReal ((T g t) ^ (4 : Real))) =
          ∫⁻ t : Real,
            (ENNReal.ofReal ‖finiteTemporalCommonKernelOutput K g t‖) ^ (4 : Real) := by
            apply lintegral_congr
            intro t
            exact (ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _)
              (by norm_num : 0 ≤ (4 : Real))).symm
      _ ≤ M := by
        simpa only [K, κ, Btop, M, finiteTemporalCoreTopCoefficient,
          finiteTemporalCoreFourthMomentBound] using hraw
  have hbound := sourceOutput_eLpNorm_le_of_nonnegative_moment
    T g (by norm_num : 0 < (4 : Real)) hTnonneg M hmoment
  rw [← eLpNorm_norm]
  simpa only [K, T, M] using hbound

private theorem aux_finiteTemporalCoreFourthMomentBound_lt_top
    (C : Real) (indices : Finset Int) (m : Int → SchwartzMap Real Complex)
    {g : finiteTemporalCommonKernelBundle (↥indices)}
    (hg : g ∈ finiteTemporalCommonKernelMeasurableDomain (↥indices)) :
    finiteTemporalCoreFourthMomentBound C indices m g < ∞ := by
  let κ : Real → Real := aux_finiteTemporalCoreKernelMajorant indices m
  let Btop : Real := 1 + Real.sqrt (Fintype.card (↥indices) : Real) *
    ∫ y : Real, κ y
  let I : ENNReal := ∫⁻ x : Real, (ENNReal.ofReal ‖g x‖) ^ (4 : Real)
  have hκ : ∀ y, 0 ≤ κ y := by
    intro y
    exact aux_finiteTemporalCoreKernelMajorant_nonneg indices m y
  have hIreal : 0 ≤ ∫ y : Real, κ y := integral_nonneg hκ
  have hBtop : 0 < Btop := by
    dsimp [Btop]
    have hnonneg : 0 ≤ Real.sqrt (Fintype.card (↥indices) : Real) * ∫ y : Real, κ y :=
      mul_nonneg (Real.sqrt_nonneg _) hIreal
    linarith
  have hgfour := aux_memLp_four_of_finiteTemporalCommonKernelMeasurableDomain hg
  have hgfour_top : eLpNorm g (ENNReal.ofReal (4 : Real)) volume ≠ ∞ := by
    simpa using hgfour.eLpNorm_ne_top
  have hI : I < ∞ := by
    dsimp [I]
    rw [Codex.Spherical.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow
      (by norm_num : (0 : Real) < 4) g]
    exact ENNReal.rpow_lt_top_of_nonneg (by norm_num) hgfour_top
  have hBfour : (ENNReal.ofReal Btop) ^ (4 : Real) < ∞ :=
    ENNReal.rpow_lt_top_of_nonneg (by norm_num) ENNReal.ofReal_ne_top
  have hBtwoinv : ((ENNReal.ofReal Btop) ^ (2 : Real))⁻¹ < ∞ := by
    apply ENNReal.inv_lt_top.mpr
    exact ENNReal.rpow_pos (ENNReal.ofReal_pos.mpr hBtop)
      ENNReal.ofReal_ne_top
  have htwoSq : (ENNReal.ofReal (2 : Real)) ^ (2 : Real) < ∞ :=
    ENNReal.rpow_lt_top_of_nonneg (by norm_num) ENNReal.ofReal_ne_top
  have hfourMinusTwoInv : (ENNReal.ofReal ((4 : Real) - 2))⁻¹ < ∞ := by
    apply ENNReal.inv_lt_top.mpr
    exact ENNReal.ofReal_pos.mpr (by norm_num)
  have htwoPow : (ENNReal.ofReal (2 : Real)) ^ ((4 : Real) - 2) < ∞ :=
    ENNReal.rpow_lt_top_of_nonneg (by norm_num) ENNReal.ofReal_ne_top
  have htail :
      ((ENNReal.ofReal ((4 : Real) - 2))⁻¹ *
        (ENNReal.ofReal (2 : Real)) ^ ((4 : Real) - 2) * I) < ∞ :=
    ENNReal.mul_lt_top (ENNReal.mul_lt_top hfourMinusTwoInv htwoPow) hI
  have hmid :
      ((ENNReal.ofReal (2 : Real)) ^ (2 : Real) *
        ((ENNReal.ofReal Btop) ^ (2 : Real))⁻¹ * ENNReal.ofReal C *
        ((ENNReal.ofReal ((4 : Real) - 2))⁻¹ *
          (ENNReal.ofReal (2 : Real)) ^ ((4 : Real) - 2) * I)) < ∞ :=
    ENNReal.mul_lt_top
      (ENNReal.mul_lt_top
        (ENNReal.mul_lt_top htwoSq hBtwoinv)
        ENNReal.ofReal_lt_top)
      htail
  change (ENNReal.ofReal Btop) ^ (4 : Real) *
    (ENNReal.ofReal (4 : Real) *
      ((ENNReal.ofReal (2 : Real)) ^ (2 : Real) *
        ((ENNReal.ofReal Btop) ^ (2 : Real))⁻¹ * ENNReal.ofReal C *
        ((ENNReal.ofReal ((4 : Real) - 2))⁻¹ *
          (ENNReal.ofReal (2 : Real)) ^ ((4 : Real) - 2) * I))) < ∞
  exact ENNReal.mul_lt_top hBfour (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hmid)

private theorem aux_memLp_four_finiteTemporalCommonKernelOutput_of_overlap
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    {C : Real}
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : Nat) ≤ C)
    {g : finiteTemporalCommonKernelBundle (↥indices)}
    (hg : g ∈ finiteTemporalCommonKernelMeasurableDomain (↥indices)) :
    MemLp (finiteTemporalCommonKernelOutput
      (finiteTemporalCoreKernel indices m) g) (4 : ENNReal) volume := by
  let K : (↥indices) → Real → Complex := finiteTemporalCoreKernel indices m
  let U : Real → Real := fun t => ‖finiteTemporalCommonKernelOutput K g t‖
  have hK : ∀ i, Integrable (K i) volume := by
    intro i
    exact aux_finiteTemporalCoreKernel_integrable indices m i
  have hUmeas : AEMeasurable U volume := by
    exact (aux_finiteTemporalCommonKernelOutput_aestronglyMeasurable_of_mem K hK hg.2).norm.aemeasurable
  have hraw := aux_lintegral_finiteTemporalCommonKernelOutput_rpow_four_le
    β scale indices m hprofile hoverlap hg
  have hMtop := aux_finiteTemporalCoreFourthMomentBound_lt_top C indices m hg
  have hmoment : (∫⁻ t : Real, ENNReal.ofReal ((U t) ^ (4 : Real))) < ∞ := by
    calc
      (∫⁻ t : Real, ENNReal.ofReal ((U t) ^ (4 : Real))) =
          ∫⁻ t : Real,
            (ENNReal.ofReal ‖finiteTemporalCommonKernelOutput K g t‖) ^ (4 : Real) := by
            apply lintegral_congr
            intro t
            exact (ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _)
              (by norm_num : 0 ≤ (4 : Real))).symm
      _ ≤ finiteTemporalCoreFourthMomentBound C indices m g := by
        simpa only [K, finiteTemporalCoreFourthMomentBound,
          finiteTemporalCoreTopCoefficient] using hraw
      _ < ∞ := hMtop
  have hUnorm : MemLp U (ENNReal.ofReal (4 : Real)) volume :=
    Codex.Spherical.InterpolationTail.memLp_of_lintegral_ofReal_rpow_lt_top
      U hUmeas (fun t => norm_nonneg _) (by norm_num : 0 < (4 : Real)) hmoment
  have hUnormfour : MemLp U (4 : ENNReal) volume := by
    simpa using hUnorm
  apply (memLp_norm_iff
    (aux_finiteTemporalCommonKernelOutput_aestronglyMeasurable_of_mem K hK hg.2)).mp
  simpa only [K, U] using hUnormfour

/-- Finite common-kernel `L⁴` endpoint for a literal measurable bundle.  It
controls the exact finite temporal convolution sum and makes no continuum or
vertical-recombination claim. -/
theorem memLp_four_and_eLpNorm_finiteTemporalCommonKernelOutput_of_overlap
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    {C : Real}
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : Nat) ≤ C)
    {g : finiteTemporalCommonKernelBundle (↥indices)}
    (hg : g ∈ finiteTemporalCommonKernelMeasurableDomain (↥indices)) :
    MemLp (finiteTemporalCommonKernelOutput
      (finiteTemporalCoreKernel indices m) g) (4 : ENNReal) volume ∧
    eLpNorm (finiteTemporalCommonKernelOutput
      (finiteTemporalCoreKernel indices m) g) (ENNReal.ofReal (4 : Real)) volume ≤
      (finiteTemporalCoreFourthMomentBound C indices m g) ^ ((4 : Real)⁻¹) := by
  exact ⟨aux_memLp_four_finiteTemporalCommonKernelOutput_of_overlap
      β scale indices m hprofile hoverlap hg,
    aux_eLpNorm_finiteTemporalCommonKernelOutput_four_le
      β scale indices m hprofile hoverlap hg⟩

private noncomputable def aux_finiteTemporalSchwartzProfileBundle
    (indices : Finset Int) (g : Int → SchwartzMap Real Complex) :
    finiteTemporalCommonKernelBundle (↥indices) :=
  fun t => WithLp.toLp 2 (fun i : (↥indices) => g (i : Int) t)

private theorem aux_finiteTemporalSchwartzProfileBundle_mem_measurableDomain
    (indices : Finset Int) (g : Int → SchwartzMap Real Complex) :
    aux_finiteTemporalSchwartzProfileBundle indices g ∈
      finiteTemporalCommonKernelMeasurableDomain (↥indices) := by
  let G : finiteTemporalCommonKernelBundle (↥indices) :=
    aux_finiteTemporalSchwartzProfileBundle indices g
  change G ∈ finiteTemporalCommonKernelMeasurableDomain (↥indices)
  have hGmeas : Measurable G := by
    dsimp [G, aux_finiteTemporalSchwartzProfileBundle]
    exact ((PiLp.continuous_toLp 2 (fun _ : (↥indices) => Complex)).comp
      (continuous_pi fun i => (g (i : Int)).continuous)).measurable
  have hGtwo : MemLp G 2 volume := by
    apply MemLp.of_eval_piLp
    intro i
    change MemLp (g (i : Int) : Real → Complex) 2 volume
    exact (g (i : Int)).memLp 2 volume
  let A : Real := Real.sqrt (∑ i : (↥indices),
    ‖(g (i : Int)).toBoundedContinuousFunction‖ ^ (2 : Nat))
  have hA : 0 ≤ A := Real.sqrt_nonneg _
  have hGbound : ∀ t : Real, ‖G t‖ ≤ A := by
    intro t
    dsimp [G, A, aux_finiteTemporalSchwartzProfileBundle]
    rw [PiLp.norm_eq_of_L2]
    apply Real.sqrt_le_sqrt
    apply Finset.sum_le_sum
    intro i hi
    exact pow_le_pow_left₀ (norm_nonneg _)
      (BoundedContinuousFunction.norm_coe_le_norm
        (g (i : Int)).toBoundedContinuousFunction t) 2
  refine ⟨hGmeas, hGtwo, A, hA, hGbound, ?_⟩
  intro i
  change Integrable (g (i : Int) : Real → Complex) volume
  exact (g (i : Int)).integrable

private theorem aux_finiteTemporalCommonKernelOutput_eq_verticalTemporalSchwartzCoreRecombined
    (indices : Finset Int) (m : Int → SchwartzMap Real Complex)
    (g : Int → SchwartzMap Real Complex) :
    finiteTemporalCommonKernelOutput (finiteTemporalCoreKernel indices m)
      (aux_finiteTemporalSchwartzProfileBundle indices g) =
      verticalTemporalSchwartzCoreRecombined indices m g := by
  funext t
  unfold aux_finiteTemporalSchwartzProfileBundle finiteTemporalCommonKernelOutput
    finiteTemporalCoreKernel
  change (∑ i : (↥indices),
    (((𝓕⁻ (m (i : Int)) : SchwartzMap Real Complex)
      ⋆[ContinuousLinearMap.mul Complex Complex, volume]
      (g (i : Int) : Real → Complex)) t)) =
    ∑ n ∈ indices, verticalTemporalSchwartzMultiplier (m n) (g n) t
  calc
    ∑ i : (↥indices),
        (((𝓕⁻ (m (i : Int)) : SchwartzMap Real Complex)
          ⋆[ContinuousLinearMap.mul Complex Complex, volume]
          (g (i : Int) : Real → Complex)) t) =
        ∑ n ∈ indices,
          (((𝓕⁻ (m n) : SchwartzMap Real Complex)
            ⋆[ContinuousLinearMap.mul Complex Complex, volume]
            (g n : Real → Complex)) t) := by
          exact Finset.sum_coe_sort indices (fun n =>
            (((𝓕⁻ (m n) : SchwartzMap Real Complex)
              ⋆[ContinuousLinearMap.mul Complex Complex, volume]
              (g n : Real → Complex)) t))
    _ = ∑ n ∈ indices, verticalTemporalSchwartzMultiplier (m n) (g n) t := by
      apply Finset.sum_congr rfl
      intro n hn
      rw [verticalTemporalSchwartzMultiplier_eq_convolution]

/-- The finite supplied-Schwartz temporal core has the raw fourth-moment
bound required for a later finite spatial Fubini lift.  Its right-hand side
is the explicit temporal coefficient times the fourth moment of the literal
finite `PiLp 2` input bundle.  No measurable vector-valued extension or
space--time recombination assertion is made here. -/
theorem lintegral_norm_rpow_four_verticalTemporalSchwartzCoreRecombined_le_of_overlap
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    {C : Real}
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : Nat) ≤ C)
    (g : Int → SchwartzMap Real Complex) :
    ∫⁻ t : Real,
      (ENNReal.ofReal ‖verticalTemporalSchwartzCoreRecombined indices m g t‖) ^
        (4 : Real) ≤
      finiteTemporalCoreFourthMomentCoefficient C indices m *
        ∫⁻ t : Real,
          (ENNReal.ofReal ‖(WithLp.toLp 2
            (fun i : (↥indices) => g (i : Int) t) :
            PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex))‖) ^ (4 : Real) := by
  have hdomain := aux_finiteTemporalSchwartzProfileBundle_mem_measurableDomain
    indices g
  have hraw := aux_lintegral_finiteTemporalCommonKernelOutput_rpow_four_le
    β scale indices m hprofile hoverlap hdomain
  rw [aux_finiteTemporalCommonKernelOutput_eq_verticalTemporalSchwartzCoreRecombined
    indices m g] at hraw
  have hbound :
      ∫⁻ t : Real,
        (ENNReal.ofReal ‖verticalTemporalSchwartzCoreRecombined indices m g t‖) ^
          (4 : Real) ≤
        finiteTemporalCoreFourthMomentBound C indices m
          (aux_finiteTemporalSchwartzProfileBundle indices g) := by
    simpa only [finiteTemporalCoreFourthMomentBound,
      finiteTemporalCoreTopCoefficient] using hraw
  calc
    ∫⁻ t : Real,
      (ENNReal.ofReal ‖verticalTemporalSchwartzCoreRecombined indices m g t‖) ^
        (4 : Real) ≤
        finiteTemporalCoreFourthMomentBound C indices m
          (aux_finiteTemporalSchwartzProfileBundle indices g) := hbound
    _ = finiteTemporalCoreFourthMomentCoefficient C indices m *
        ∫⁻ t : Real,
          (ENNReal.ofReal ‖aux_finiteTemporalSchwartzProfileBundle indices g t‖) ^
            (4 : Real) :=
      finiteTemporalCoreFourthMomentBound_eq_coefficient_mul_lintegral
        C indices m (aux_finiteTemporalSchwartzProfileBundle indices g)
    _ = _ := by
      rfl

/-- Finite temporal `L⁴` control for supplied Schwartz profiles.  This packages
the profiles into the finite common-kernel domain and identifies the output
with the finite vertical Schwartz core; it makes no spatial or continuum claim. -/
theorem memLp_four_and_eLpNorm_verticalTemporalSchwartzCoreRecombined_of_overlap
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    {C : Real}
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : Nat) ≤ C)
    (g : Int → SchwartzMap Real Complex) :
    MemLp (verticalTemporalSchwartzCoreRecombined indices m g) (4 : ENNReal) volume ∧
    eLpNorm (verticalTemporalSchwartzCoreRecombined indices m g)
      (ENNReal.ofReal (4 : Real)) volume ≤
      (finiteTemporalCoreFourthMomentBound C indices m
        (fun t => WithLp.toLp 2 (fun i : (↥indices) => g (i : Int) t))) ^
          ((4 : Real)⁻¹) := by
  have hdomain := aux_finiteTemporalSchwartzProfileBundle_mem_measurableDomain
    indices g
  have houtput := aux_finiteTemporalCommonKernelOutput_eq_verticalTemporalSchwartzCoreRecombined
    indices m g
  have hendpoint := memLp_four_and_eLpNorm_finiteTemporalCommonKernelOutput_of_overlap
    β scale indices m hprofile hoverlap hdomain
  have hbundle : aux_finiteTemporalSchwartzProfileBundle indices g =
      (fun t => WithLp.toLp 2 (fun i : (↥indices) => g (i : Int) t)) := rfl
  rw [houtput] at hendpoint
  rw [hbundle] at hendpoint
  exact hendpoint

/-! ## Common-spatial finite vertical core -/

/-- With one fixed spatial Schwartz profile, the finite space--time core is
exactly the product of that profile and its finite temporal core. -/
private theorem aux_verticalSchwartzCoreRecombined_eq_commonSpatialTensor
    (indices : Finset Int) (m : Int → SchwartzMap Real Complex)
    (F : SchwartzMap (Euclidean 2) Complex)
    (g : Int → SchwartzMap Real Complex) (z : WaveSpaceTime) :
    verticalSchwartzCoreRecombined indices m (fun _ => F) g z =
      verticalTemporalSchwartzCoreRecombined indices m g z.2 * F z.1 := by
  unfold verticalSchwartzCoreRecombined verticalTemporalSchwartzCoreRecombined
  change (∑ n ∈ indices,
      verticalTemporalSchwartzMultiplier (m n) (g n) z.2 * F z.1) =
    (∑ n ∈ indices, verticalTemporalSchwartzMultiplier (m n) (g n) z.2) * F z.1
  rw [Finset.sum_mul]

/-- The fourth `eLpNorm` of a literal spatial--temporal tensor factors over
the product Lebesgue measure. -/
private theorem aux_eLpNorm_four_commonSpatialTensor
    (F : Euclidean 2 → Complex) (H : Real → Complex)
    (hF : AEMeasurable F volume) (hH : AEMeasurable H volume) :
    eLpNorm (fun z : WaveSpaceTime => H z.2 * F z.1) (4 : ENNReal) volume =
      eLpNorm F (4 : ENNReal) volume * eLpNorm H (4 : ENNReal) volume := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num)]
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num)]
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num)]
  norm_num
  rw [Measure.volume_eq_prod]
  have hFfour : AEMeasurable (fun x : Euclidean 2 => ‖F x‖ₑ ^ (4 : Nat)) volume :=
    hF.enorm.pow measurable_const.aemeasurable
  have hHfour : AEMeasurable (fun t : Real => ‖H t‖ₑ ^ (4 : Nat)) volume :=
    hH.enorm.pow measurable_const.aemeasurable
  have hprod :
      (∫⁻ z : Euclidean 2 × Real,
        (‖H z.2‖ₑ * ‖F z.1‖ₑ) ^ (4 : Nat) ∂
          ((volume : Measure (Euclidean 2)).prod volume)) =
        (∫⁻ x : Euclidean 2, ‖F x‖ₑ ^ (4 : Nat)) *
          ∫⁻ t : Real, ‖H t‖ₑ ^ (4 : Nat) := by
    calc
      (∫⁻ z : Euclidean 2 × Real,
          (‖H z.2‖ₑ * ‖F z.1‖ₑ) ^ (4 : Nat)) =
          ∫⁻ z : Euclidean 2 × Real,
            (‖F z.1‖ₑ ^ (4 : Nat)) * (‖H z.2‖ₑ ^ (4 : Nat)) := by
              apply lintegral_congr
              intro z
              rw [mul_pow]
              rw [mul_comm]
      _ = _ := by
        exact lintegral_prod_mul hFfour hHfour
  change
    (∫⁻ z : Euclidean 2 × Real,
      (‖H z.2‖ₑ * ‖F z.1‖ₑ) ^ (4 : Nat) ∂
        ((volume : Measure (Euclidean 2)).prod volume)) ^ ((1 / 4 : Real)) =
      (∫⁻ x : Euclidean 2, ‖F x‖ₑ ^ (4 : Nat)) ^ ((1 / 4 : Real)) *
        (∫⁻ t : Real, ‖H t‖ₑ ^ (4 : Nat)) ^ ((1 / 4 : Real))
  rw [hprod]
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]

/-- Tensoring a finite temporal fourth-norm estimate by one Schwartz spatial
profile preserves `MemLp 4` and multiplies its explicit coefficient by the
spatial fourth `eLpNorm`. -/
private theorem aux_memLp_four_and_eLpNorm_commonSpatialTensor_of_temporal
    (F : SchwartzMap (Euclidean 2) Complex) (H : Real → Complex)
    (hH : MemLp H (4 : ENNReal) volume) {B : ENNReal}
    (hbound : eLpNorm H (4 : ENNReal) volume ≤ B) :
    MemLp (fun z : WaveSpaceTime => H z.2 * F z.1) (4 : ENNReal) volume ∧
      eLpNorm (fun z : WaveSpaceTime => H z.2 * F z.1) (4 : ENNReal) volume ≤
        eLpNorm (F : Euclidean 2 → Complex) (4 : ENNReal) volume * B := by
  have hF : MemLp (F : Euclidean 2 → Complex) (4 : ENNReal) volume :=
    F.memLp 4 volume
  have hmeas : AEStronglyMeasurable
      (fun z : Euclidean 2 × Real => H z.2 * F z.1)
        ((volume : Measure (Euclidean 2)).prod volume) :=
    hH.1.comp_snd.mul (F.continuous.aestronglyMeasurable.comp_fst)
  have heq := aux_eLpNorm_four_commonSpatialTensor (F : Euclidean 2 → Complex) H
    F.continuous.aestronglyMeasurable.aemeasurable hH.1.aemeasurable
  have htop : eLpNorm (fun z : WaveSpaceTime => H z.2 * F z.1)
      (4 : ENNReal) volume < ∞ := by
    rw [heq]
    exact ENNReal.mul_lt_top hF.eLpNorm_lt_top hH.eLpNorm_lt_top
  refine ⟨?_, ?_⟩
  · rw [Measure.volume_eq_prod]
    exact ⟨hmeas, htop⟩
  · rw [heq]
    exact mul_le_mul_of_nonneg_left hbound bot_le

/-- Finite space--time `L⁴` control for the literal vertical Schwartz core
when every finite packet has the same spatial Schwartz profile.  The bound is
exactly the finite temporal common-kernel coefficient times the spatial fourth
`eLpNorm`; no varying-profile, continuum, or `verticalRecombination` assertion
is made. -/
theorem memLp_four_and_eLpNorm_verticalSchwartzCoreRecombined_commonSpatial_of_overlap
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    {C : Real}
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : Nat) ≤ C)
    (F : SchwartzMap (Euclidean 2) Complex)
    (g : Int → SchwartzMap Real Complex) :
    MemLp (verticalSchwartzCoreRecombined indices m (fun _ => F) g)
      (4 : ENNReal) volume ∧
      eLpNorm (verticalSchwartzCoreRecombined indices m (fun _ => F) g)
        (ENNReal.ofReal (4 : Real)) volume ≤
        eLpNorm (F : Euclidean 2 → Complex) (ENNReal.ofReal (4 : Real)) volume *
          (finiteTemporalCoreFourthMomentBound C indices m
            (fun t => WithLp.toLp 2 (fun i : (↥indices) => g (i : Int) t))) ^
              ((4 : Real)⁻¹) := by
  let H : Real → Complex := verticalTemporalSchwartzCoreRecombined indices m g
  have htemporal :=
    memLp_four_and_eLpNorm_verticalTemporalSchwartzCoreRecombined_of_overlap
      β scale indices m hprofile hoverlap g
  have htemporalBound : eLpNorm H (4 : ENNReal) volume ≤
      (finiteTemporalCoreFourthMomentBound C indices m
        (fun t => WithLp.toLp 2 (fun i : (↥indices) => g (i : Int) t))) ^
          ((4 : Real)⁻¹) := by
    simpa only [H, ENNReal.ofReal_ofNat] using htemporal.2
  have hproduct := aux_memLp_four_and_eLpNorm_commonSpatialTensor_of_temporal
    F H (by simpa only [H] using htemporal.1) htemporalBound
  have hfactor : verticalSchwartzCoreRecombined indices m (fun _ => F) g =
      fun z : WaveSpaceTime => H z.2 * F z.1 := by
    funext z
    exact aux_verticalSchwartzCoreRecombined_eq_commonSpatialTensor indices m F g z
  rw [hfactor]
  simpa only [ENNReal.ofReal_ofNat] using hproduct

private def aux_singletonTemporalSchwartzProfile
    (n : Int) (g : Int → SchwartzMap Real Complex) :
    Int → SchwartzMap Real Complex :=
  fun k => if k = n then g n else 0

private theorem aux_verticalSchwartzCoreRecombined_singletonCommonSpatial_apply
    (indices : Finset Int) (m : Int → SchwartzMap Real Complex)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → SchwartzMap Real Complex) (n : Int) (hn : n ∈ indices)
    (z : WaveSpaceTime) :
    verticalSchwartzCoreRecombined indices m (fun _ => F n)
      (aux_singletonTemporalSchwartzProfile n g) z =
      verticalTemporalSchwartzMultiplier (m n) (g n) z.2 * F n z.1 := by
  unfold verticalSchwartzCoreRecombined aux_singletonTemporalSchwartzProfile
  change (∑ k ∈ indices,
    verticalTemporalSchwartzMultiplier (m k) (if k = n then g n else 0) z.2 *
      F n z.1) =
    verticalTemporalSchwartzMultiplier (m n) (g n) z.2 * F n z.1
  rw [Finset.sum_eq_single n]
  · simp
  · intro k hk hkn
    rw [if_neg hkn, verticalTemporalSchwartzMultiplier_zero]
    change (0 : Complex) * F n z.1 = 0
    exact zero_mul _
  · intro hnot
    exact (hnot hn).elim

private theorem aux_verticalSchwartzCoreRecombined_eq_finsetSum_singletonCommonSpatial
    (indices : Finset Int) (m : Int → SchwartzMap Real Complex)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → SchwartzMap Real Complex) (z : WaveSpaceTime) :
    verticalSchwartzCoreRecombined indices m F g z =
      ∑ n ∈ indices,
        verticalSchwartzCoreRecombined indices m (fun _ => F n)
          (aux_singletonTemporalSchwartzProfile n g) z := by
  change (∑ n ∈ indices,
    verticalTemporalSchwartzMultiplier (m n) (g n) z.2 * F n z.1) = _
  apply Finset.sum_congr rfl
  intro n hn
  rw [aux_verticalSchwartzCoreRecombined_singletonCommonSpatial_apply
    indices m F g n hn z]

/-- Finite space--time `L⁴` control for supplied varying spatial Schwartz
profiles.  It applies the common-spatial corollary to singleton temporal
families and reassembles by finite Minkowski; no `verticalRecombined`,
continuum, square-function, or local-smoothing assertion is made. -/
theorem memLp_four_and_eLpNorm_verticalSchwartzCoreRecombined_of_overlap
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    {C : Real}
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : Nat) ≤ C)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → SchwartzMap Real Complex) :
    MemLp (verticalSchwartzCoreRecombined indices m F g) (4 : ENNReal) volume ∧
    eLpNorm (verticalSchwartzCoreRecombined indices m F g)
      (ENNReal.ofReal (4 : Real)) volume ≤
      ∑ n ∈ indices,
        eLpNorm (F n : Euclidean 2 → Complex) (ENNReal.ofReal (4 : Real)) volume *
          (finiteTemporalCoreFourthMomentBound C indices m
            (fun t => WithLp.toLp 2 (fun i : (↥indices) =>
              (if (i : Int) = n then g n else 0) t))) ^ ((4 : Real)⁻¹) := by
  let T : Int → WaveSpaceTime → Complex := fun n =>
    verticalSchwartzCoreRecombined indices m (fun _ => F n)
      (aux_singletonTemporalSchwartzProfile n g)
  have hpiece : ∀ n ∈ indices, MemLp (T n) (4 : ENNReal) volume ∧
      eLpNorm (T n) (4 : ENNReal) volume ≤
        eLpNorm (F n : Euclidean 2 → Complex) (4 : ENNReal) volume *
          (finiteTemporalCoreFourthMomentBound C indices m
            (fun t => WithLp.toLp 2 (fun i : (↥indices) =>
              (if (i : Int) = n then g n else 0) t))) ^ ((4 : Real)⁻¹) := by
    intro n hn
    have h := memLp_four_and_eLpNorm_verticalSchwartzCoreRecombined_commonSpatial_of_overlap
      β scale indices m hprofile hoverlap (F n)
        (aux_singletonTemporalSchwartzProfile n g)
    have hbundle :
        (fun t => WithLp.toLp 2 (fun i : (↥indices) =>
          aux_singletonTemporalSchwartzProfile n g (i : Int) t)) =
        (fun t => WithLp.toLp 2 (fun i : (↥indices) =>
          (if (i : Int) = n then g n else 0) t)) := rfl
    rw [hbundle] at h
    simpa only [T, ENNReal.ofReal_ofNat] using h
  have hdecomp : verticalSchwartzCoreRecombined indices m F g =
      fun z => ∑ n ∈ indices, T n z := by
    funext z
    simpa only [T] using
      aux_verticalSchwartzCoreRecombined_eq_finsetSum_singletonCommonSpatial
        indices m F g z
  have hsumMem : MemLp (fun z => ∑ n ∈ indices, T n z) (4 : ENNReal) volume :=
    memLp_finsetSum indices (fun n hn => (hpiece n hn).1)
  have hsumBound : eLpNorm (fun z => ∑ n ∈ indices, T n z)
      (4 : ENNReal) volume ≤
      ∑ n ∈ indices,
        eLpNorm (F n : Euclidean 2 → Complex) (4 : ENNReal) volume *
          (finiteTemporalCoreFourthMomentBound C indices m
            (fun t => WithLp.toLp 2 (fun i : (↥indices) =>
              (if (i : Int) = n then g n else 0) t))) ^ ((4 : Real)⁻¹) := by
    calc
      eLpNorm (fun z => ∑ n ∈ indices, T n z) (4 : ENNReal) volume =
          eLpNorm (∑ n ∈ indices, T n) (4 : ENNReal) volume := by
        congr 1
        funext z
        simp only [Finset.sum_apply]
      _ ≤ ∑ n ∈ indices, eLpNorm (T n) (4 : ENNReal) volume :=
        eLpNorm_sum_le (p := (4 : ENNReal)) (f := T) (s := indices)
          (fun n hn => (hpiece n hn).1.aestronglyMeasurable) (by norm_num)
      _ ≤ _ := Finset.sum_le_sum fun n hn => (hpiece n hn).2
  rw [hdecomp]
  simpa only [ENNReal.ofReal_ofNat] using ⟨hsumMem, hsumBound⟩

/-! ## Finite varying-spatial Schwartz core by Fubini -/

private theorem aux_continuous_verticalSchwartzCoreRecombined
    (indices : Finset Int) (m : Int → SchwartzMap Real Complex)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → SchwartzMap Real Complex) :
    Continuous (verticalSchwartzCoreRecombined indices m F g) := by
  unfold verticalSchwartzCoreRecombined
  simp only [AddMonoidHom.coe_mk, ZeroHom.coe_mk]
  apply continuous_finsetSum
  intro n hn
  exact
    ((verticalTemporalSchwartzMultiplier (m n) (g n)).continuous.comp continuous_snd).mul
      ((F n).continuous.comp continuous_fst)

private theorem aux_continuous_verticalSquareFunction_verticalSeparablePackets
    (indices : Finset Int) (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → SchwartzMap Real Complex) :
    Continuous (verticalSquareFunction indices
      (fun n => verticalSeparablePacket (F n) (g n : Real → Complex))) := by
  unfold verticalSquareFunction
  apply Real.continuous_sqrt.comp
  apply continuous_finsetSum
  intro n hn
  have hpacket : Continuous (verticalSeparablePacket (F n) (g n : Real → Complex)) := by
    unfold verticalSeparablePacket
    exact ((g n).continuous.comp continuous_snd).mul ((F n).continuous.comp continuous_fst)
  exact hpacket.norm.pow 2

private theorem aux_verticalSquareFunction_verticalSeparablePackets_eq_scaledBundleNorm
    (indices : Finset Int) (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → SchwartzMap Real Complex) (x : Euclidean 2) (t : Real) :
    verticalSquareFunction indices
      (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) (x, t) =
      ‖(WithLp.toLp 2 (fun i : (↥indices) =>
          ((F (i : Int) x) • g (i : Int) : SchwartzMap Real Complex) t) :
        PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex))‖ := by
  rw [verticalSquareFunction_eq_norm_piLp]
  rw [PiLp.norm_eq_of_L2, PiLp.norm_eq_of_L2]
  apply congrArg Real.sqrt
  apply Finset.sum_congr rfl
  intro i hi
  simp only [verticalSeparablePacket, smul_apply, smul_eq_mul]
  rw [mul_comm]

private theorem aux_memLp_four_verticalSeparablePacket
    (F : SchwartzMap (Euclidean 2) Complex) (h : SchwartzMap Real Complex) :
    MemLp (verticalSeparablePacket F (h : Real → Complex)) (4 : ENNReal) volume := by
  let Q : SchwartzMap JointWaveSpaceTime Complex := jointSchwartzExternalProduct F h
  have hpres : MeasurePreserving
      (WithLp.toLp 2 : WaveSpaceTime → JointWaveSpaceTime) volume volume := by
    simpa only using (WithLp.volume_preserving_toLp (Euclidean 2) Real)
  have hraw : MemLp (jointSchwartzRaw Q) (4 : ENNReal) volume := by
    change MemLp (fun z : WaveSpaceTime => Q (WithLp.toLp 2 z)) (4 : ENNReal) volume
    exact (Q.memLp 4 volume).comp_measurePreserving hpres
  have hpacket : verticalSeparablePacket F (h : Real → Complex) = jointSchwartzRaw Q := by
    funext z
    dsimp [Q, jointSchwartzRaw]
    rw [jointSchwartzExternalProduct_apply]
    unfold verticalSeparablePacket
    ring
  rw [hpacket]
  exact hraw

private theorem aux_memLp_four_verticalSchwartzCoreRecombined
    (indices : Finset Int) (m : Int → SchwartzMap Real Complex)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → SchwartzMap Real Complex) :
    MemLp (verticalSchwartzCoreRecombined indices m F g) (4 : ENNReal) volume := by
  let h : Int → SchwartzMap Real Complex := fun n =>
    verticalTemporalSchwartzMultiplier (m n) (g n)
  have hterm (n : Int) :
      MemLp (fun z : WaveSpaceTime => h n z.2 * F n z.1) (4 : ENNReal) volume := by
    change MemLp (verticalSeparablePacket (F n) (h n : Real → Complex)) (4 : ENNReal) volume
    exact aux_memLp_four_verticalSeparablePacket (F n) (h n)
  have hsum : MemLp (fun z : WaveSpaceTime =>
      ∑ n ∈ indices, h n z.2 * F n z.1) (4 : ENNReal) volume :=
    memLp_finsetSum indices (fun n hn => hterm n)
  change MemLp (fun z : WaveSpaceTime =>
    ∑ n ∈ indices,
      verticalTemporalSchwartzMultiplier (m n) (g n) z.2 * F n z.1)
      (4 : ENNReal) volume
  simpa only [h] using hsum

/-- Finite supplied-Schwartz Fubini lift of the temporal common-kernel
fourth-moment bound.  The input is the literal space--time vertical square
function of the finite separable packet family; no arbitrary measurable
family, continuum limit, vertical recombination, or local-smoothing claim is
made. -/
theorem lintegral_norm_rpow_four_verticalSchwartzCoreRecombined_le_of_overlap
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    {C : Real}
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : Nat) ≤ C)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → SchwartzMap Real Complex) :
    (∫⁻ z : WaveSpaceTime,
      (ENNReal.ofReal ‖verticalSchwartzCoreRecombined indices m F g z‖) ^
        (4 : Real)) ≤
      finiteTemporalCoreFourthMomentCoefficient C indices m *
        ∫⁻ z : WaveSpaceTime,
          (ENNReal.ofReal (verticalSquareFunction indices
            (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z)) ^
              (4 : Real) := by
  let P : WaveSpaceTime → Complex := verticalSchwartzCoreRecombined indices m F g
  let S : WaveSpaceTime → Real := verticalSquareFunction indices
    (fun n => verticalSeparablePacket (F n) (g n : Real → Complex))
  have hPcont : Continuous P := by
    dsimp [P]
    exact aux_continuous_verticalSchwartzCoreRecombined indices m F g
  have hScont : Continuous S := by
    dsimp [S]
    exact aux_continuous_verticalSquareFunction_verticalSeparablePackets indices F g
  have hPmeas : Measurable (fun z : WaveSpaceTime =>
      (ENNReal.ofReal ‖P z‖) ^ (4 : Real)) :=
    ENNReal.continuous_rpow_const.measurable.comp hPcont.norm.measurable.ennreal_ofReal
  have hSmeas : Measurable (fun z : WaveSpaceTime =>
      (ENNReal.ofReal (S z)) ^ (4 : Real)) :=
    ENNReal.continuous_rpow_const.measurable.comp hScont.measurable.ennreal_ofReal
  have hSinnerMeas : Measurable (fun x : Euclidean 2 => ∫⁻ t : Real,
      (ENNReal.ofReal (S (x, t))) ^ (4 : Real)) := by
    exact Measurable.lintegral_prod_right hSmeas
  have hfiber (x : Euclidean 2) :
      (∫⁻ t : Real, (ENNReal.ofReal ‖P (x, t)‖) ^ (4 : Real)) ≤
        finiteTemporalCoreFourthMomentCoefficient C indices m *
          ∫⁻ t : Real, (ENNReal.ofReal (S (x, t))) ^ (4 : Real) := by
    calc
      (∫⁻ t : Real, (ENNReal.ofReal ‖P (x, t)‖) ^ (4 : Real)) =
          ∫⁻ t : Real,
            (ENNReal.ofReal ‖verticalTemporalSchwartzCoreRecombined indices m
              (fun n => F n x • g n) t‖) ^ (4 : Real) := by
            apply lintegral_congr
            intro t
            dsimp [P]
            rw [verticalSchwartzCoreRecombined_fiber]
      _ ≤ finiteTemporalCoreFourthMomentCoefficient C indices m *
          ∫⁻ t : Real,
            (ENNReal.ofReal ‖(WithLp.toLp 2 (fun i : (↥indices) =>
              ((F (i : Int) x) • g (i : Int) : SchwartzMap Real Complex) t) :
              PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex))‖) ^
                (4 : Real) :=
          lintegral_norm_rpow_four_verticalTemporalSchwartzCoreRecombined_le_of_overlap
            β scale indices m hprofile hoverlap (fun n => F n x • g n)
      _ = finiteTemporalCoreFourthMomentCoefficient C indices m *
          ∫⁻ t : Real, (ENNReal.ofReal (S (x, t))) ^ (4 : Real) := by
            congr 1
            apply lintegral_congr
            intro t
            rw [← aux_verticalSquareFunction_verticalSeparablePackets_eq_scaledBundleNorm
              indices F g x t]
  have hPprod :
      (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal ‖P z‖) ^ (4 : Real)) =
        ∫⁻ x : Euclidean 2, ∫⁻ t : Real,
          (ENNReal.ofReal ‖P (x, t)‖) ^ (4 : Real) := by
    rw [Measure.volume_eq_prod]
    exact lintegral_prod _ hPmeas.aemeasurable
  have hSprod :
      (∫⁻ x : Euclidean 2, ∫⁻ t : Real,
        (ENNReal.ofReal (S (x, t))) ^ (4 : Real)) =
      ∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (4 : Real) := by
    rw [Measure.volume_eq_prod]
    exact (lintegral_prod _ hSmeas.aemeasurable).symm
  change (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal ‖P z‖) ^ (4 : Real)) ≤
    finiteTemporalCoreFourthMomentCoefficient C indices m *
      ∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (4 : Real)
  rw [hPprod]
  calc
    (∫⁻ x : Euclidean 2, ∫⁻ t : Real,
      (ENNReal.ofReal ‖P (x, t)‖) ^ (4 : Real)) ≤
        ∫⁻ x : Euclidean 2,
          finiteTemporalCoreFourthMomentCoefficient C indices m *
            ∫⁻ t : Real, (ENNReal.ofReal (S (x, t))) ^ (4 : Real) :=
      lintegral_mono hfiber
    _ = finiteTemporalCoreFourthMomentCoefficient C indices m *
        ∫⁻ x : Euclidean 2, ∫⁻ t : Real,
          (ENNReal.ofReal (S (x, t))) ^ (4 : Real) :=
      lintegral_const_mul _ hSinnerMeas
    _ = finiteTemporalCoreFourthMomentCoefficient C indices m *
        ∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (4 : Real) := by
      rw [hSprod]

private theorem aux_eLpNorm_four_verticalSchwartzCoreRecombined_le_of_overlap
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    {C : Real}
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : Nat) ≤ C)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → SchwartzMap Real Complex) :
    eLpNorm (verticalSchwartzCoreRecombined indices m F g) (4 : ENNReal) volume ≤
      (finiteTemporalCoreFourthMomentCoefficient C indices m) ^ ((4 : Real)⁻¹) *
        eLpNorm (verticalSquareFunction indices
          (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)))
          (4 : ENNReal) volume := by
  let P : WaveSpaceTime → Complex := verticalSchwartzCoreRecombined indices m F g
  let S : WaveSpaceTime → Real := verticalSquareFunction indices
    (fun n => verticalSeparablePacket (F n) (g n : Real → Complex))
  have hraw :
      (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal ‖P z‖) ^ (4 : Real)) ≤
        finiteTemporalCoreFourthMomentCoefficient C indices m *
          ∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (4 : Real) := by
    simpa only [P, S] using
      lintegral_norm_rpow_four_verticalSchwartzCoreRecombined_le_of_overlap
        β scale indices m hprofile hoverlap F g
  have hSnonneg (z : WaveSpaceTime) : 0 ≤ S z := by
    dsimp [S]
    exact verticalSquareFunction_nonneg indices
      (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z
  have hPmoment :
      (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal ‖P z‖) ^ (4 : Real)) =
        (eLpNorm P (4 : ENNReal) volume) ^ (4 : Real) := by
    simpa only [ENNReal.ofReal_ofNat] using
      (Codex.Spherical.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow
        (by norm_num : (0 : Real) < 4) P)
  have hSmoment :
      (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (4 : Real)) =
        (eLpNorm S (4 : ENNReal) volume) ^ (4 : Real) := by
    calc
      (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (4 : Real)) =
          ∫⁻ z : WaveSpaceTime, ENNReal.ofReal ((S z) ^ (4 : Real)) := by
            apply lintegral_congr
            intro z
            exact ENNReal.ofReal_rpow_of_nonneg (hSnonneg z)
              (by norm_num : (0 : Real) ≤ 4)
      _ = (eLpNorm S (4 : ENNReal) volume) ^ (4 : Real) := by
        simpa only [ENNReal.ofReal_ofNat] using
          (Codex.Spherical.LpSpaceFacts.lintegral_ofReal_rpow_eq_eLpNorm_rpow_of_nonneg
            (by norm_num : (0 : Real) < 4) S hSnonneg)
  change eLpNorm P (4 : ENNReal) volume ≤
    (finiteTemporalCoreFourthMomentCoefficient C indices m) ^ ((4 : Real)⁻¹) *
      eLpNorm S (4 : ENNReal) volume
  rw [← ENNReal.rpow_le_rpow_iff (by norm_num : (0 : Real) < 4)]
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : Real) ≤ 4)]
  rw [← ENNReal.rpow_mul]
  have hfour : (4 : Real)⁻¹ * (4 : Real) = 1 := by norm_num
  rw [hfour, ENNReal.rpow_one, ← hPmoment, ← hSmoment]
  exact hraw

/-- Finite supplied-Schwartz vector-valued `L⁴` control for the varying
spatial core.  It is the norm form of the preceding raw Fubini estimate and
uses the literal finite vertical square function as input.  It makes no
arbitrary-function, continuum, vertical-recombination, or local-smoothing
assertion. -/
theorem memLp_four_and_eLpNorm_verticalSchwartzCoreRecombined_le_of_overlap
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    {C : Real}
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : Nat) ≤ C)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → SchwartzMap Real Complex) :
    MemLp (verticalSchwartzCoreRecombined indices m F g) (4 : ENNReal) volume ∧
      eLpNorm (verticalSchwartzCoreRecombined indices m F g) (4 : ENNReal) volume ≤
        (finiteTemporalCoreFourthMomentCoefficient C indices m) ^ ((4 : Real)⁻¹) *
          eLpNorm (verticalSquareFunction indices
            (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)))
            (4 : ENNReal) volume := by
  exact ⟨aux_memLp_four_verticalSchwartzCoreRecombined indices m F g,
    aux_eLpNorm_four_verticalSchwartzCoreRecombined_le_of_overlap
      β scale indices m hprofile hoverlap F g⟩

/-- Literal finite-packet rewrite of the varying-spatial Schwartz-core
fourth-norm bound.  This is only the supplied-profile identification with
`verticalRecombined`; it does not extend the estimate to arbitrary packet
families or assert a continuum, square-function, or local-smoothing result. -/
theorem eLpNorm_four_verticalRecombined_verticalSeparablePackets_le_of_overlap
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    {C : Real}
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : Nat) ≤ C)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → SchwartzMap Real Complex) :
    eLpNorm (verticalRecombined β scale indices
      (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)))
      (4 : ENNReal) volume ≤
      (finiteTemporalCoreFourthMomentCoefficient C indices m) ^ ((4 : Real)⁻¹) *
        eLpNorm (verticalSquareFunction indices
          (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)))
          (4 : ENNReal) volume := by
  rw [← verticalSchwartzCoreRecombined_eq_verticalRecombined_of_schwartzProfiles
    β scale indices m hprofile F g]
  exact aux_eLpNorm_four_verticalSchwartzCoreRecombined_le_of_overlap
    β scale indices m hprofile hoverlap F g

/-! ## Finite-rank supplied-Schwartz vertical cores -/

/-- At a fixed spatial point, collect the finite spatial-rank expansion
inside each original vertical label.  This auxiliary profile deliberately
does not flatten the vertical labels. -/
private noncomputable def aux_finiteRankTemporalBundle
    (ranks : Int → Finset Int)
    (F : Int → Int → SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (g : Int → Int → SchwartzMap Real Complex)
    (x : SurfaceCore.Euclidean 2) : Int → SchwartzMap Real Complex :=
  fun n => ∑ r ∈ ranks n, F n r x • g n r

/-- The supplied-Schwartz space-time core with finitely many spatial ranks
inside each original vertical label.  It is finite data only and makes no
claim about arbitrary packet families. -/
noncomputable def finiteRankVerticalSchwartzCore
    (indices : Finset Int) (m : Int → SchwartzMap Real Complex)
    (ranks : Int → Finset Int)
    (F : Int → Int → SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (g : Int → Int → SchwartzMap Real Complex) : WaveSpaceTime → Complex :=
  fun z => ∑ n ∈ indices, ∑ r ∈ ranks n,
    verticalTemporalSchwartzMultiplier (m n) (g n r) z.2 * F n r z.1

/-- The literal finite spatial-rank packet family, retaining the original
vertical indexing. -/
noncomputable def finiteRankVerticalPackets
    (ranks : Int → Finset Int)
    (F : Int → Int → SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (g : Int → Int → SchwartzMap Real Complex) :
    Int → WaveSpaceTime → Complex :=
  fun n z => ∑ r ∈ ranks n,
    verticalSeparablePacket (F n r) (g n r : Real → Complex) z

private theorem aux_verticalTemporalSchwartzMultiplier_finset_sum_smul
    (m : SchwartzMap Real Complex) (s : Finset Int)
    (c : Int → Complex) (g : Int → SchwartzMap Real Complex) :
    verticalTemporalSchwartzMultiplier m (∑ r ∈ s, c r • g r) =
      ∑ r ∈ s, c r • verticalTemporalSchwartzMultiplier m (g r) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [verticalTemporalSchwartzMultiplier_zero]
  | insert r s hrs ih =>
      rw [Finset.sum_insert hrs, Finset.sum_insert hrs,
        verticalTemporalSchwartzMultiplier_add,
        verticalTemporalSchwartzMultiplier_smul, ih]

private theorem aux_finiteRankVerticalSchwartzCore_fiber
    (indices : Finset Int) (m : Int → SchwartzMap Real Complex)
    (ranks : Int → Finset Int)
    (F : Int → Int → SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (g : Int → Int → SchwartzMap Real Complex)
    (x : SurfaceCore.Euclidean 2) (t : Real) :
    finiteRankVerticalSchwartzCore indices m ranks F g (x, t) =
      verticalTemporalSchwartzCoreRecombined indices m
        (aux_finiteRankTemporalBundle ranks F g x) t := by
  classical
  unfold finiteRankVerticalSchwartzCore
    verticalTemporalSchwartzCoreRecombined aux_finiteRankTemporalBundle
  simp only [AddMonoidHom.coe_mk, ZeroHom.coe_mk]
  apply Finset.sum_congr rfl
  intro n hn
  rw [aux_verticalTemporalSchwartzMultiplier_finset_sum_smul]
  rw [sum_apply]
  apply Finset.sum_congr rfl
  intro r hr
  simp only [smul_apply]
  ring

private theorem aux_finiteRankVerticalPackets_apply
    (ranks : Int → Finset Int)
    (F : Int → Int → SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (g : Int → Int → SchwartzMap Real Complex)
    (n : Int) (x : SurfaceCore.Euclidean 2) (t : Real) :
    finiteRankVerticalPackets ranks F g n (x, t) =
      aux_finiteRankTemporalBundle ranks F g x n t := by
  classical
  unfold finiteRankVerticalPackets aux_finiteRankTemporalBundle
  rw [sum_apply]
  apply Finset.sum_congr rfl
  intro r hr
  simp only [verticalSeparablePacket, smul_apply, smul_eq_mul]
  ring

private theorem aux_verticalSquareFunction_finiteRankPackets_eq_bundleNorm
    (indices : Finset Int) (ranks : Int → Finset Int)
    (F : Int → Int → SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (g : Int → Int → SchwartzMap Real Complex)
    (x : SurfaceCore.Euclidean 2) (t : Real) :
    verticalSquareFunction indices (finiteRankVerticalPackets ranks F g) (x, t) =
      ‖(WithLp.toLp 2 (fun i : (↑indices) =>
          aux_finiteRankTemporalBundle ranks F g x (i : Int) t) :
        PiLp (2 : ENNReal) (fun _ : (↑indices) => Complex))‖ := by
  rw [verticalSquareFunction_eq_norm_piLp]
  congr 1
  apply congrArg (WithLp.toLp 2)
  funext i
  exact aux_finiteRankVerticalPackets_apply ranks F g (i : Int) x t

private theorem aux_continuous_finiteRankVerticalSchwartzCore
    (indices : Finset Int) (m : Int → SchwartzMap Real Complex)
    (ranks : Int → Finset Int)
    (F : Int → Int → SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (g : Int → Int → SchwartzMap Real Complex) :
    Continuous (finiteRankVerticalSchwartzCore indices m ranks F g) := by
  unfold finiteRankVerticalSchwartzCore
  apply continuous_finsetSum
  intro n hn
  apply continuous_finsetSum
  intro r hr
  exact
    ((verticalTemporalSchwartzMultiplier (m n) (g n r)).continuous.comp continuous_snd).mul
      ((F n r).continuous.comp continuous_fst)

private theorem aux_continuous_finiteRankVerticalSquareFunction
    (indices : Finset Int) (ranks : Int → Finset Int)
    (F : Int → Int → SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (g : Int → Int → SchwartzMap Real Complex) :
    Continuous (verticalSquareFunction indices
      (finiteRankVerticalPackets ranks F g)) := by
  unfold verticalSquareFunction
  apply Real.continuous_sqrt.comp
  apply continuous_finsetSum
  intro n hn
  have hpacket : Continuous (finiteRankVerticalPackets ranks F g n) := by
    unfold finiteRankVerticalPackets
    apply continuous_finsetSum
    intro r hr
    unfold verticalSeparablePacket
    exact ((g n r).continuous.comp continuous_snd).mul ((F n r).continuous.comp continuous_fst)
  exact hpacket.norm.pow 2

/-- Raw fourth-moment Fubini lift for a finite-rank supplied-Schwartz core.
The overlap and multiplier profile remain indexed only by the original finite
vertical labels; the rank sums stay inside those labels. -/
theorem lintegral_norm_rpow_four_finiteRankVerticalSchwartzCore_le_of_overlap
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    {C : Real}
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : Nat) ≤ C)
    (ranks : Int → Finset Int)
    (F : Int → Int → SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (g : Int → Int → SchwartzMap Real Complex) :
    (∫⁻ z : WaveSpaceTime,
      (ENNReal.ofReal ‖finiteRankVerticalSchwartzCore indices m ranks F g z‖) ^
        (4 : Real)) ≤
      finiteTemporalCoreFourthMomentCoefficient C indices m *
        ∫⁻ z : WaveSpaceTime,
          (ENNReal.ofReal (verticalSquareFunction indices
            (finiteRankVerticalPackets ranks F g) z)) ^ (4 : Real) := by
  let P : WaveSpaceTime → Complex :=
    finiteRankVerticalSchwartzCore indices m ranks F g
  let S : WaveSpaceTime → Real := verticalSquareFunction indices
    (finiteRankVerticalPackets ranks F g)
  have hPcont : Continuous P := by
    dsimp [P]
    exact aux_continuous_finiteRankVerticalSchwartzCore indices m ranks F g
  have hScont : Continuous S := by
    dsimp [S]
    exact aux_continuous_finiteRankVerticalSquareFunction indices ranks F g
  have hPmeas : Measurable (fun z : WaveSpaceTime =>
      (ENNReal.ofReal ‖P z‖) ^ (4 : Real)) :=
    ENNReal.continuous_rpow_const.measurable.comp hPcont.norm.measurable.ennreal_ofReal
  have hSmeas : Measurable (fun z : WaveSpaceTime =>
      (ENNReal.ofReal (S z)) ^ (4 : Real)) :=
    ENNReal.continuous_rpow_const.measurable.comp hScont.measurable.ennreal_ofReal
  have hSinnerMeas : Measurable (fun x : SurfaceCore.Euclidean 2 => ∫⁻ t : Real,
      (ENNReal.ofReal (S (x, t))) ^ (4 : Real)) := by
    exact Measurable.lintegral_prod_right hSmeas
  have hfiber (x : SurfaceCore.Euclidean 2) :
      (∫⁻ t : Real, (ENNReal.ofReal ‖P (x, t)‖) ^ (4 : Real)) ≤
        finiteTemporalCoreFourthMomentCoefficient C indices m *
          ∫⁻ t : Real, (ENNReal.ofReal (S (x, t))) ^ (4 : Real) := by
    calc
      (∫⁻ t : Real, (ENNReal.ofReal ‖P (x, t)‖) ^ (4 : Real)) =
          ∫⁻ t : Real,
            (ENNReal.ofReal ‖verticalTemporalSchwartzCoreRecombined indices m
              (aux_finiteRankTemporalBundle ranks F g x) t‖) ^ (4 : Real) := by
            apply lintegral_congr
            intro t
            dsimp [P]
            rw [aux_finiteRankVerticalSchwartzCore_fiber]
      _ ≤ finiteTemporalCoreFourthMomentCoefficient C indices m *
          ∫⁻ t : Real,
            (ENNReal.ofReal ‖(WithLp.toLp 2 (fun i : (↑indices) =>
              aux_finiteRankTemporalBundle ranks F g x (i : Int) t) :
              PiLp (2 : ENNReal) (fun _ : (↑indices) => Complex))‖) ^
                (4 : Real) :=
          lintegral_norm_rpow_four_verticalTemporalSchwartzCoreRecombined_le_of_overlap
            β scale indices m hprofile hoverlap
              (aux_finiteRankTemporalBundle ranks F g x)
      _ = finiteTemporalCoreFourthMomentCoefficient C indices m *
          ∫⁻ t : Real, (ENNReal.ofReal (S (x, t))) ^ (4 : Real) := by
            congr 1
            apply lintegral_congr
            intro t
            rw [← aux_verticalSquareFunction_finiteRankPackets_eq_bundleNorm
              indices ranks F g x t]
  have hPprod :
      (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal ‖P z‖) ^ (4 : Real)) =
        ∫⁻ x : SurfaceCore.Euclidean 2, ∫⁻ t : Real,
          (ENNReal.ofReal ‖P (x, t)‖) ^ (4 : Real) := by
    rw [Measure.volume_eq_prod]
    exact lintegral_prod _ hPmeas.aemeasurable
  have hSprod :
      (∫⁻ x : SurfaceCore.Euclidean 2, ∫⁻ t : Real,
        (ENNReal.ofReal (S (x, t))) ^ (4 : Real)) =
      ∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (4 : Real) := by
    rw [Measure.volume_eq_prod]
    exact (lintegral_prod _ hSmeas.aemeasurable).symm
  change (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal ‖P z‖) ^ (4 : Real)) ≤
    finiteTemporalCoreFourthMomentCoefficient C indices m *
      ∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (4 : Real)
  rw [hPprod]
  calc
    (∫⁻ x : SurfaceCore.Euclidean 2, ∫⁻ t : Real,
      (ENNReal.ofReal ‖P (x, t)‖) ^ (4 : Real)) ≤
        ∫⁻ x : SurfaceCore.Euclidean 2,
          finiteTemporalCoreFourthMomentCoefficient C indices m *
            ∫⁻ t : Real, (ENNReal.ofReal (S (x, t))) ^ (4 : Real) :=
      lintegral_mono hfiber
    _ = finiteTemporalCoreFourthMomentCoefficient C indices m *
        ∫⁻ x : SurfaceCore.Euclidean 2, ∫⁻ t : Real,
          (ENNReal.ofReal (S (x, t))) ^ (4 : Real) :=
      lintegral_const_mul _ hSinnerMeas
    _ = finiteTemporalCoreFourthMomentCoefficient C indices m *
        ∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (4 : Real) := by
      rw [hSprod]

private theorem aux_eLpNorm_four_finiteRankVerticalSchwartzCore_le_of_overlap
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    {C : Real}
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : Nat) ≤ C)
    (ranks : Int → Finset Int)
    (F : Int → Int → SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (g : Int → Int → SchwartzMap Real Complex) :
    eLpNorm (finiteRankVerticalSchwartzCore indices m ranks F g)
      (4 : ENNReal) volume ≤
      (finiteTemporalCoreFourthMomentCoefficient C indices m) ^ ((4 : Real)⁻¹) *
        eLpNorm (verticalSquareFunction indices
          (finiteRankVerticalPackets ranks F g)) (4 : ENNReal) volume := by
  let P : WaveSpaceTime → Complex :=
    finiteRankVerticalSchwartzCore indices m ranks F g
  let S : WaveSpaceTime → Real := verticalSquareFunction indices
    (finiteRankVerticalPackets ranks F g)
  have hraw :
      (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal ‖P z‖) ^ (4 : Real)) ≤
        finiteTemporalCoreFourthMomentCoefficient C indices m *
          ∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (4 : Real) := by
    simpa only [P, S] using
      lintegral_norm_rpow_four_finiteRankVerticalSchwartzCore_le_of_overlap
        β scale indices m hprofile hoverlap ranks F g
  have hSnonneg (z : WaveSpaceTime) : 0 ≤ S z := by
    dsimp [S]
    exact verticalSquareFunction_nonneg indices
      (finiteRankVerticalPackets ranks F g) z
  have hPmoment :
      (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal ‖P z‖) ^ (4 : Real)) =
        (eLpNorm P (4 : ENNReal) volume) ^ (4 : Real) := by
    simpa only [ENNReal.ofReal_ofNat] using
      (Codex.Spherical.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow
        (by norm_num : (0 : Real) < 4) P)
  have hSmoment :
      (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (4 : Real)) =
        (eLpNorm S (4 : ENNReal) volume) ^ (4 : Real) := by
    calc
      (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (4 : Real)) =
          ∫⁻ z : WaveSpaceTime, ENNReal.ofReal ((S z) ^ (4 : Real)) := by
            apply lintegral_congr
            intro z
            exact ENNReal.ofReal_rpow_of_nonneg (hSnonneg z)
              (by norm_num : (0 : Real) ≤ 4)
      _ = (eLpNorm S (4 : ENNReal) volume) ^ (4 : Real) := by
        simpa only [ENNReal.ofReal_ofNat] using
          (Codex.Spherical.LpSpaceFacts.lintegral_ofReal_rpow_eq_eLpNorm_rpow_of_nonneg
            (by norm_num : (0 : Real) < 4) S hSnonneg)
  change eLpNorm P (4 : ENNReal) volume ≤
    (finiteTemporalCoreFourthMomentCoefficient C indices m) ^ ((4 : Real)⁻¹) *
      eLpNorm S (4 : ENNReal) volume
  rw [← ENNReal.rpow_le_rpow_iff (by norm_num : (0 : Real) < 4)]
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : Real) ≤ 4)]
  rw [← ENNReal.rpow_mul]
  have hfour : (4 : Real)⁻¹ * (4 : Real) = 1 := by norm_num
  rw [hfour, ENNReal.rpow_one, ← hPmoment, ← hSmoment]
  exact hraw

private theorem aux_memLp_four_finiteRankVerticalSchwartzCore
    (indices : Finset Int) (m : Int → SchwartzMap Real Complex)
    (ranks : Int → Finset Int)
    (F : Int → Int → SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (g : Int → Int → SchwartzMap Real Complex) :
    MemLp (finiteRankVerticalSchwartzCore indices m ranks F g)
      (4 : ENNReal) volume := by
  let h : Int → Int → SchwartzMap Real Complex := fun n r =>
    verticalTemporalSchwartzMultiplier (m n) (g n r)
  have hterm (n r : Int) :
      MemLp (fun z : WaveSpaceTime => h n r z.2 * F n r z.1)
        (4 : ENNReal) volume := by
    change MemLp (verticalSeparablePacket (F n r) (h n r : Real → Complex))
      (4 : ENNReal) volume
    exact aux_memLp_four_verticalSeparablePacket (F n r) (h n r)
  have hinner (n : Int) :
      MemLp (fun z : WaveSpaceTime => ∑ r ∈ ranks n,
        h n r z.2 * F n r z.1) (4 : ENNReal) volume := by
    exact memLp_finsetSum (ranks n) (fun r hr => hterm n r)
  have hsum :
      MemLp (fun z : WaveSpaceTime => ∑ n ∈ indices, ∑ r ∈ ranks n,
        h n r z.2 * F n r z.1) (4 : ENNReal) volume := by
    exact memLp_finsetSum indices (fun n hn => hinner n)
  change MemLp (fun z : WaveSpaceTime => ∑ n ∈ indices, ∑ r ∈ ranks n,
    verticalTemporalSchwartzMultiplier (m n) (g n r) z.2 * F n r z.1)
      (4 : ENNReal) volume
  simpa only [h] using hsum

/-- Finite-rank supplied-Schwartz `L4` control for the vertical core.  The
right-hand side is the square function of the rank-summed packets, not a
flattened two-index square function. -/
theorem memLp_four_and_eLpNorm_finiteRankVerticalSchwartzCore_of_overlap
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    {C : Real}
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : Nat) ≤ C)
    (ranks : Int → Finset Int)
    (F : Int → Int → SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (g : Int → Int → SchwartzMap Real Complex) :
    MemLp (finiteRankVerticalSchwartzCore indices m ranks F g)
      (4 : ENNReal) volume ∧
      eLpNorm (finiteRankVerticalSchwartzCore indices m ranks F g)
        (4 : ENNReal) volume ≤
        (finiteTemporalCoreFourthMomentCoefficient C indices m) ^ ((4 : Real)⁻¹) *
          eLpNorm (verticalSquareFunction indices
            (finiteRankVerticalPackets ranks F g)) (4 : ENNReal) volume := by
  exact ⟨aux_memLp_four_finiteRankVerticalSchwartzCore indices m ranks F g,
    aux_eLpNorm_four_finiteRankVerticalSchwartzCore_le_of_overlap
      β scale indices m hprofile hoverlap ranks F g⟩

private theorem aux_finiteRank_spaceTimeFourier_finset_sum_verticalSeparablePackets
    (s : Finset Int)
    (F : Int → SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (g : Int → SchwartzMap Real Complex)
    (ξ : SurfaceCore.Euclidean 2) (τ : Real) :
    spaceTimeFourier
        (fun z => ∑ r ∈ s,
          verticalSeparablePacket (F r) (g r : Real → Complex) z) (ξ, τ) =
      ∑ r ∈ s,
        spaceTimeFourier (verticalSeparablePacket (F r) (g r : Real → Complex)) (ξ, τ) := by
  have hspace (t : Real) :
      𝓕 (fun x : SurfaceCore.Euclidean 2 => ∑ r ∈ s, g r t * F r x) ξ =
        ∑ r ∈ s, g r t * 𝓕 (F r : SurfaceCore.Euclidean 2 → Complex) ξ := by
    let H : SchwartzMap (SurfaceCore.Euclidean 2) Complex :=
      ∑ r ∈ s, (g r t) • F r
    have hH (x : SurfaceCore.Euclidean 2) : H x = ∑ r ∈ s, g r t * F r x := by
      dsimp only [H]
      rw [sum_apply]
      simp only [smul_apply, smul_eq_mul]
    rw [show (fun x : SurfaceCore.Euclidean 2 => ∑ r ∈ s, g r t * F r x) = H by
      funext x
      exact (hH x).symm]
    change (𝓕 H : SchwartzMap (SurfaceCore.Euclidean 2) Complex) ξ = _
    rw [show H = ∑ r ∈ s, (g r t) • F r by rfl]
    rw [FourierTransform.fourier_sum, sum_apply]
    apply Finset.sum_congr rfl
    intro r hr
    rw [FourierTransform.fourier_smul]
    simp only [smul_apply, smul_eq_mul, SchwartzMap.fourier_coe]
  have hright :
      (∑ r ∈ s,
        spaceTimeFourier (verticalSeparablePacket (F r) (g r : Real → Complex)) (ξ, τ)) =
        ∑ r ∈ s,
          𝓕 (F r : SurfaceCore.Euclidean 2 → Complex) ξ * 𝓕 (g r : Real → Complex) τ := by
    apply Finset.sum_congr rfl
    intro r hr
    exact spaceTimeFourier_verticalSeparablePacket (F r) (g r : Real → Complex) ξ τ
  rw [hright]
  unfold spaceTimeFourier
  change 𝓕 (fun t : Real =>
    𝓕 (fun x : SurfaceCore.Euclidean 2 => ∑ r ∈ s, g r t * F r x) ξ) τ = _
  rw [show (fun t : Real =>
    𝓕 (fun x : SurfaceCore.Euclidean 2 => ∑ r ∈ s, g r t * F r x) ξ) =
      fun t : Real => ∑ r ∈ s, g r t * 𝓕 (F r : SurfaceCore.Euclidean 2 → Complex) ξ by
        funext t
        exact hspace t]
  let K : SchwartzMap Real Complex :=
    ∑ r ∈ s, (𝓕 (F r : SurfaceCore.Euclidean 2 → Complex) ξ) • g r
  have hK (t : Real) : K t =
      ∑ r ∈ s, g r t * 𝓕 (F r : SurfaceCore.Euclidean 2 → Complex) ξ := by
    dsimp only [K]
    rw [sum_apply]
    simp only [smul_apply, smul_eq_mul]
    apply Finset.sum_congr rfl
    intro r hr
    ring
  rw [show (fun t : Real => ∑ r ∈ s,
    g r t * 𝓕 (F r : SurfaceCore.Euclidean 2 → Complex) ξ) = K by
      funext t
      exact (hK t).symm]
  change (𝓕 K : SchwartzMap Real Complex) τ = _
  rw [show K = ∑ r ∈ s,
    (𝓕 (F r : SurfaceCore.Euclidean 2 → Complex) ξ) • g r by rfl]
  rw [FourierTransform.fourier_sum, sum_apply]
  apply Finset.sum_congr rfl
  intro r hr
  rw [FourierTransform.fourier_smul]
  simp only [smul_apply, smul_eq_mul, SchwartzMap.fourier_coe]

private theorem aux_fourierInv_finset_sum_smul_fourier_spatial
    (s : Finset Int) (c : Int → Complex)
    (F : Int → SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (x : SurfaceCore.Euclidean 2) :
    𝓕⁻ (fun ξ : SurfaceCore.Euclidean 2 => ∑ r ∈ s,
      c r * 𝓕 (F r : SurfaceCore.Euclidean 2 → Complex) ξ) x =
      ∑ r ∈ s, c r * F r x := by
  classical
  let H : SchwartzMap (SurfaceCore.Euclidean 2) Complex :=
    ∑ r ∈ s, c r • FourierTransform.fourier (F r)
  have hH (ξ : SurfaceCore.Euclidean 2) : H ξ =
      ∑ r ∈ s, c r * 𝓕 (F r : SurfaceCore.Euclidean 2 → Complex) ξ := by
    dsimp only [H]
    rw [sum_apply]
    simp only [smul_apply, smul_eq_mul, SchwartzMap.fourier_coe]
  rw [show (fun ξ : SurfaceCore.Euclidean 2 => ∑ r ∈ s,
    c r * 𝓕 (F r : SurfaceCore.Euclidean 2 → Complex) ξ) = H by
      funext ξ
      exact (hH ξ).symm]
  rw [← SchwartzMap.fourierInv_coe]
  rw [show H = ∑ r ∈ s, c r • FourierTransform.fourier (F r) by rfl]
  rw [FourierTransform.fourierInv_sum, sum_apply]
  apply Finset.sum_congr rfl
  intro r hr
  rw [FourierTransform.fourierInv_smul, FourierTransform.fourierInv_fourier_eq]
  simp only [smul_apply, smul_eq_mul]

private theorem aux_fourierInv_finset_sum_temporalMultiplier_smul
    (s : Finset Int) (m : SchwartzMap Real Complex)
    (c : Int → Complex) (g : Int → SchwartzMap Real Complex)
    (t : Real) :
    𝓕⁻ (fun τ : Real => ∑ r ∈ s,
      (m τ * 𝓕 (g r : Real → Complex) τ) * c r) t =
      ∑ r ∈ s, verticalTemporalSchwartzMultiplier m (g r) t * c r := by
  classical
  let K : SchwartzMap Real Complex := ∑ r ∈ s, c r •
    SchwartzMap.smulLeftCLM Complex (m : Real → Complex)
      (FourierTransform.fourier (g r))
  have hK (τ : Real) : K τ = ∑ r ∈ s,
      (m τ * 𝓕 (g r : Real → Complex) τ) * c r := by
    dsimp only [K]
    rw [sum_apply]
    simp only [smul_apply, smul_eq_mul,
      SchwartzMap.smulLeftCLM_apply (m.hasTemperateGrowth), SchwartzMap.fourier_coe]
    apply Finset.sum_congr rfl
    intro r hr
    ring
  rw [show (fun τ : Real => ∑ r ∈ s,
    (m τ * 𝓕 (g r : Real → Complex) τ) * c r) = K by
      funext τ
      exact (hK τ).symm]
  rw [← SchwartzMap.fourierInv_coe]
  rw [show K = ∑ r ∈ s, c r •
    SchwartzMap.smulLeftCLM Complex (m : Real → Complex)
      (FourierTransform.fourier (g r)) by rfl]
  rw [FourierTransform.fourierInv_sum, sum_apply]
  apply Finset.sum_congr rfl
  intro r hr
  rw [FourierTransform.fourierInv_smul]
  change c r * verticalTemporalSchwartzMultiplier m (g r) t =
    verticalTemporalSchwartzMultiplier m (g r) t * c r
  ring

private theorem aux_verticalProjection_finset_verticalSeparablePackets_of_schwartzProfile
    (β : Real → Complex) (scale : Real) (n : Int)
    (m : SchwartzMap Real Complex)
    (hprofile : ∀ τ : Real, m τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (s : Finset Int)
    (F : Int → SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (g : Int → SchwartzMap Real Complex)
    (z : WaveSpaceTime) :
    verticalProjection β scale n
      (fun w => ∑ r ∈ s,
        verticalSeparablePacket (F r) (g r : Real → Complex) w) z =
      ∑ r ∈ s, verticalTemporalSchwartzMultiplier m (g r) z.2 * F r z.1 := by
  classical
  have hmult (η : SurfaceCore.Euclidean 2) (τ : Real) :
      verticalMultiplier β scale n (η, τ) *
          spaceTimeFourier
            (fun w => ∑ r ∈ s,
              verticalSeparablePacket (F r) (g r : Real → Complex) w) (η, τ) =
        ∑ r ∈ s,
          (m τ * 𝓕 (g r : Real → Complex) τ) *
            𝓕 (F r : SurfaceCore.Euclidean 2 → Complex) η := by
    rw [aux_finiteRank_spaceTimeFourier_finset_sum_verticalSeparablePackets s F g η τ]
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro r hr
    rw [verticalMultiplier, spaceTimeFourier_verticalSeparablePacket, ← hprofile τ]
    ring
  have hinvspace (τ : Real) :
      𝓕⁻ (fun η : SurfaceCore.Euclidean 2 =>
        verticalMultiplier β scale n (η, τ) *
          spaceTimeFourier
            (fun w => ∑ r ∈ s,
              verticalSeparablePacket (F r) (g r : Real → Complex) w) (η, τ)) z.1 =
        ∑ r ∈ s, (m τ * 𝓕 (g r : Real → Complex) τ) * F r z.1 := by
    rw [show (fun η : SurfaceCore.Euclidean 2 =>
      verticalMultiplier β scale n (η, τ) *
        spaceTimeFourier
          (fun w => ∑ r ∈ s,
            verticalSeparablePacket (F r) (g r : Real → Complex) w) (η, τ)) =
        fun η : SurfaceCore.Euclidean 2 => ∑ r ∈ s,
          (m τ * 𝓕 (g r : Real → Complex) τ) *
            𝓕 (F r : SurfaceCore.Euclidean 2 → Complex) η by
        funext η
        exact hmult η τ]
    exact aux_fourierInv_finset_sum_smul_fourier_spatial s
      (fun r => m τ * 𝓕 (g r : Real → Complex) τ) F z.1
  unfold verticalProjection spaceTimeFourierInv
  rw [show (fun τ : Real =>
    𝓕⁻ (fun η : SurfaceCore.Euclidean 2 =>
      verticalMultiplier β scale n (η, τ) *
        spaceTimeFourier
          (fun w => ∑ r ∈ s,
            verticalSeparablePacket (F r) (g r : Real → Complex) w) (η, τ)) z.1) =
      fun τ : Real => ∑ r ∈ s,
        (m τ * 𝓕 (g r : Real → Complex) τ) * F r z.1 by
      funext τ
      exact hinvspace τ]
  exact aux_fourierInv_finset_sum_temporalMultiplier_smul s m
    (fun r => F r z.1) g z.2

/-- Exact finite-rank supplied-Schwartz rewrite of the literal vertical
recombination.  The rank sum is kept inside each original vertical label. -/
theorem finiteRankVerticalSchwartzCore_eq_verticalRecombined_of_schwartzProfiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (ranks : Int → Finset Int)
    (F : Int → Int → SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (g : Int → Int → SchwartzMap Real Complex) :
    finiteRankVerticalSchwartzCore indices m ranks F g =
      verticalRecombined β scale indices (finiteRankVerticalPackets ranks F g) := by
  funext z
  unfold finiteRankVerticalSchwartzCore verticalRecombined
    finiteRankVerticalPackets
  apply Finset.sum_congr rfl
  intro n hn
  exact (aux_verticalProjection_finset_verticalSeparablePackets_of_schwartzProfile
    β scale n (m n) (hprofile n hn) (ranks n) (F n) (g n) z).symm

/-- Literal finite-rank `verticalRecombined` consequence of the finite
supplied-Schwartz core estimate.  This does not assert a bound for arbitrary
packet families or a vertical-recombination principle. -/
theorem eLpNorm_four_verticalRecombined_finiteRankPackets_le_of_overlap
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    {C : Real}
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : Nat) ≤ C)
    (ranks : Int → Finset Int)
    (F : Int → Int → SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (g : Int → Int → SchwartzMap Real Complex) :
    eLpNorm (verticalRecombined β scale indices
      (finiteRankVerticalPackets ranks F g)) (4 : ENNReal) volume ≤
      (finiteTemporalCoreFourthMomentCoefficient C indices m) ^ ((4 : Real)⁻¹) *
        eLpNorm (verticalSquareFunction indices
          (finiteRankVerticalPackets ranks F g)) (4 : ENNReal) volume := by
  rw [← finiteRankVerticalSchwartzCore_eq_verticalRecombined_of_schwartzProfiles
    β scale indices m hprofile ranks F g]
  exact aux_eLpNorm_four_finiteRankVerticalSchwartzCore_le_of_overlap
    β scale indices m hprofile hoverlap ranks F g

/-! ## Literal Schwartz half-wave additivity -/
/-! ## Literal Schwartz half-wave additivity -/

private noncomputable def mssHalfWaveOutputSchwartz
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) : SchwartzMap (Euclidean 2) Complex :=
  𝓕⁻ (SchwartzMap.smulLeftCLM Complex
    (dyadicHalfWaveSchwartzSymbol C σ j t : Euclidean 2 → Complex) (𝓕 f))

private theorem mssHalfWaveOutputSchwartz_apply
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    mssHalfWaveOutputSchwartz C σ j t f x = dyadicHalfWave C.cutoff σ j t f x := by
  unfold mssHalfWaveOutputSchwartz
  rw [SchwartzMap.fourierInv_coe]
  apply congrArg (fun q : Euclidean 2 → Complex => 𝓕⁻ q x)
  funext ξ
  simp only [SchwartzMap.smulLeftCLM_apply
    (dyadicHalfWaveSchwartzSymbol C σ j t).hasTemperateGrowth, smul_eq_mul,
    dyadicHalfWaveSchwartzSymbol_apply, dyadicHalfWaveSymbol,
    SchwartzMap.fourier_coe]

private theorem mssHalfWaveOutputSchwartz_add
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (f g : SchwartzMap (Euclidean 2) Complex) :
    mssHalfWaveOutputSchwartz C σ j t (f + g) =
      mssHalfWaveOutputSchwartz C σ j t f + mssHalfWaveOutputSchwartz C σ j t g := by
  unfold mssHalfWaveOutputSchwartz
  rw [fourier_add f g]
  rw [(SchwartzMap.smulLeftCLM Complex
    (dyadicHalfWaveSchwartzSymbol C σ j t : Euclidean 2 → Complex)).map_add]
  rw [fourierInv_add]

/-- The literal frequency-localized half-wave is additive on its Schwartz
input core. -/
theorem dyadicHalfWave_add
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat) (t : Real)
    (f g : SchwartzMap (Euclidean 2) Complex) :
    dyadicHalfWave C.cutoff σ j t (f + g) =
      dyadicHalfWave C.cutoff σ j t f + dyadicHalfWave C.cutoff σ j t g := by
  funext x
  rw [← mssHalfWaveOutputSchwartz_apply C σ j t (f + g) x,
    mssHalfWaveOutputSchwartz_add]
  change mssHalfWaveOutputSchwartz C σ j t f x +
      mssHalfWaveOutputSchwartz C σ j t g x = _
  rw [mssHalfWaveOutputSchwartz_apply, mssHalfWaveOutputSchwartz_apply]
  rfl

/-- The corresponding space--time half-wave is additive on Schwartz inputs. -/
theorem dyadicHalfWaveSpaceTime_add
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (f g : SchwartzMap (Euclidean 2) Complex) :
    dyadicHalfWaveSpaceTime C.cutoff σ j (f + g) =
      dyadicHalfWaveSpaceTime C.cutoff σ j f +
        dyadicHalfWaveSpaceTime C.cutoff σ j g := by
  funext z
  change dyadicHalfWave C.cutoff σ j z.2 (f + g) z.1 = _
  rw [dyadicHalfWave_add]
  rfl

/-! ## Slab-local half-wave magnitudes -/

/-- The nonnegative half-wave magnitude, set to zero off the time slab that
carries `localSmoothingMeasure`.  This wrapper lets a genuinely slab-local
pointwise endpoint feed a source--output interpolation theorem whose top
endpoint is pointwise on its full output type. -/
noncomputable def localDyadicHalfWaveMagnitude
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 × Real → Real :=
  {z | z.2 ∈ Icc (1 : Real) 2}.indicator
    (fun z => ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖)

theorem localDyadicHalfWaveMagnitude_nonneg
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) (z : Euclidean 2 × Real) :
    0 ≤ localDyadicHalfWaveMagnitude C σ j f z := by
  unfold localDyadicHalfWaveMagnitude
  by_cases hz : z ∈ {z | z.2 ∈ Icc (1 : Real) 2}
  · rw [Set.indicator_of_mem hz]
    positivity
  · rw [Set.indicator_of_notMem hz]

theorem measurable_localDyadicHalfWaveMagnitude
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Measurable (localDyadicHalfWaveMagnitude C σ j f) := by
  unfold localDyadicHalfWaveMagnitude
  apply (continuous_dyadicHalfWaveSpaceTime C σ j f).measurable.norm.indicator
  exact measurableSet_Icc.preimage measurable_snd

/-- The zero-off-slab wrapper agrees almost everywhere with the literal
space--time half-wave under the local smoothing measure. -/
theorem localDyadicHalfWaveMagnitude_ae_eq
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) :
    localDyadicHalfWaveMagnitude C σ j f =ᵐ[localSmoothingMeasure]
      fun z => ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖ := by
  have htime : ∀ᵐ t : Real ∂(volume.restrict (Icc (1 : Real) 2)),
      t ∈ Icc (1 : Real) 2 := ae_restrict_mem measurableSet_Icc
  have hslab : ∀ᵐ z : Euclidean 2 × Real ∂localSmoothingMeasure,
      z.2 ∈ Icc (1 : Real) 2 := by
    rw [localSmoothingMeasure]
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards with x
      exact htime
    · exact measurableSet_Icc.preimage measurable_snd
  filter_upwards [hslab] with z hz
  have hz' : z ∈ {z : Euclidean 2 × Real | z.2 ∈ Icc (1 : Real) 2} := hz
  rw [show localDyadicHalfWaveMagnitude C σ j f z =
      ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖ by
    unfold localDyadicHalfWaveMagnitude
    change ({z : Euclidean 2 × Real | z.2 ∈ Icc (1 : Real) 2}.indicator
      (fun z : Euclidean 2 × Real =>
        ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖)) z = _
    exact Set.indicator_of_mem hz'
      (fun z : Euclidean 2 × Real =>
        ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖)]

theorem localDyadicHalfWaveMagnitude_add_le
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    (f g : SchwartzMap (Euclidean 2) Complex) (z : Euclidean 2 × Real) :
    localDyadicHalfWaveMagnitude C σ j (f + g) z ≤
      localDyadicHalfWaveMagnitude C σ j f z +
        localDyadicHalfWaveMagnitude C σ j g z := by
  unfold localDyadicHalfWaveMagnitude
  by_cases hz : z ∈ {z | z.2 ∈ Icc (1 : Real) 2}
  · rw [Set.indicator_of_mem hz, Set.indicator_of_mem hz,
      Set.indicator_of_mem hz]
    rw [dyadicHalfWaveSpaceTime_add]
    exact norm_add_le _ _
  · rw [Set.indicator_of_notMem hz, Set.indicator_of_notMem hz,
      Set.indicator_of_notMem hz]
    positivity

/-- Transport the proved fixed-time MSS endpoint to the slab-local magnitude.
No pointwise assertion is made off the physical time slab. -/
theorem localDyadicHalfWaveMagnitude_top
    (C : lpCutoffs 2) {B : Real} (hB : 0 < B)
    (hInfty : ∀ (σ : WaveSign) (j : Nat), 1 ≤ j →
      ∀ t : Real, t ∈ Icc (1 : Real) 2 →
        ∀ (f : SchwartzMap (Euclidean 2) Complex) {A : Real},
          (∀ x, ‖f x‖ ≤ A) → ∀ x,
            ‖dyadicHalfWave C.cutoff σ j t f x‖ ≤
              (B * Real.sqrt ((2 : Real) ^ j)) * A)
    (σ : WaveSign) (j : Nat) (hj : 1 ≤ j)
    (f : SchwartzMap (Euclidean 2) Complex) {A : Real}
    (hf : ∀ x, ‖f x‖ ≤ A) :
    ∀ z, localDyadicHalfWaveMagnitude C σ j f z ≤
      (B * Real.sqrt ((2 : Real) ^ j)) * A := by
  intro z
  by_cases hz : z ∈ {z | z.2 ∈ Icc (1 : Real) 2}
  · rw [show localDyadicHalfWaveMagnitude C σ j f z =
      ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖ by
      unfold localDyadicHalfWaveMagnitude
      change ({z : Euclidean 2 × Real | z.2 ∈ Icc (1 : Real) 2}.indicator
        (fun z : Euclidean 2 × Real =>
          ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖)) z = _
      exact Set.indicator_of_mem hz
        (fun z : Euclidean 2 × Real =>
          ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖)]
    exact hInfty σ j hj z.2 hz f hf z.1
  · rw [show localDyadicHalfWaveMagnitude C σ j f z = 0 by
      unfold localDyadicHalfWaveMagnitude
      change ({z : Euclidean 2 × Real | z.2 ∈ Icc (1 : Real) 2}.indicator
        (fun z : Euclidean 2 × Real =>
          ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖)) z = _
      exact Set.indicator_of_notMem hz
        (fun z : Euclidean 2 × Real =>
          ‖dyadicHalfWaveSpaceTime C.cutoff σ j f z‖)]
    have hA : 0 ≤ A := le_trans (norm_nonneg (f 0)) (hf 0)
    positivity

/-! ## Literal Schwartz interpolation specializations -/

private theorem mss_measurable_smooth_low_profile_lintegrals
    {d : Nat} (f : SchwartzMap (Euclidean d) Complex)
    (low high : Real → SchwartzMap (Euclidean d) Complex)
    (hlow : ∀ t x, low t x =
      ((smooth_half_height_bump ((t⁻¹ : Real) • f x) : Real) : Complex) • f x)
    (_hhigh : ∀ t, high t = f - low t)
    {μ : Measure (Euclidean d)} [SFinite μ] (q : Real) :
    Measurable (fun t : Real => ∫⁻ x,
      (ENNReal.ofReal ‖low t x‖) ^ q ∂μ) := by
  have hjoint : Measurable (fun z : Real × Euclidean d => low z.1 z.2) := by
    rw [show (fun z : Real × Euclidean d => low z.1 z.2) =
      fun z => ((smooth_half_height_bump ((z.1⁻¹ : Real) • f z.2) : Real) : Complex) •
        f z.2 by
      funext z
      exact hlow z.1 z.2]
    let η : ContDiffBump (0 : Complex) := smooth_half_height_bump
    have hf : Measurable (fun z : Real × Euclidean d => f z.2) :=
      f.continuous.measurable.comp measurable_snd
    have hscale : Measurable (fun z : Real × Euclidean d =>
        (z.1⁻¹ : Real) • f z.2) :=
      measurable_fst.inv.smul hf
    have hcut_real : Measurable (fun z : Real × Euclidean d =>
        η ((z.1⁻¹ : Real) • f z.2)) :=
      η.continuous.measurable.comp hscale
    have hcut : Measurable (fun z : Real × Euclidean d =>
        ((η ((z.1⁻¹ : Real) • f z.2) : Real) : Complex)) :=
      Complex.ofRealCLM.continuous.measurable.comp hcut_real
    exact hcut.smul hf
  apply Measurable.lintegral_prod_right
  exact ENNReal.continuous_rpow_const.measurable.comp
    hjoint.norm.ennreal_ofReal

/-- The literal cutoff half-wave on the Schwartz core obeys the scaled
two-pair `L²`--`L⁴` interpolation estimate.  The scale `s` is intentionally
supplied explicitly: choosing it from the `L⁴` endpoint coefficient is what
recovers the correct interpolation exponent. -/
theorem mss_two_four_coefficient
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    {p : Real} (hp2 : 2 < p) (hp4 : p < 4)
    (B4 : ENNReal)
    (hstrong4 : ∀ g : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j g) (ENNReal.ofReal 4)
          localSmoothingMeasure ≤
        B4 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume)
    (s : Real) (hs : 0 < s)
    (f : SchwartzMap (Euclidean 2) Complex) :
    eLpNorm (localDyadicHalfWaveMagnitude C σ j f) (ENNReal.ofReal p)
        localSmoothingMeasure ≤
      (sourceOutputTwoPairMarcinkiewiczMomentCoefficient p 2 4
        ((ENNReal.ofReal 2) ^ (2 : Real)) (B4 ^ (4 : Real))
        ((ENNReal.ofReal s) ^ ((2 : Real) - p) *
          ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2)))
        ((ENNReal.ofReal s) ^ ((4 : Real) - p) *
          ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
            (ENNReal.ofReal (4 - p))⁻¹))) ^ p⁻¹ *
      eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
  letI : SFinite localSmoothingMeasure := by
    rw [localSmoothingMeasure]
    infer_instance
  let D : Set (SchwartzMap (Euclidean 2) Complex) := Set.univ
  let eval : SchwartzMap (Euclidean 2) Complex → Euclidean 2 → Complex := fun g => g
  let T : SchwartzMap (Euclidean 2) Complex → Euclidean 2 × Real → Real :=
    fun g => localDyadicHalfWaveMagnitude C σ j g
  have hTnonneg : ∀ g x, 0 ≤ T g x := by
    intro g x
    exact localDyadicHalfWaveMagnitude_nonneg C σ j g x
  have hTsub : ∀ ⦃g h : SchwartzMap (Euclidean 2) Complex⦄,
      g ∈ D → h ∈ D → ∀ x, T (g + h) x ≤ T g x + T h x := by
    intro g h _ _ x
    exact localDyadicHalfWaveMagnitude_add_le C σ j g h x
  have hTmeas : ∀ g, g ∈ D → AEStronglyMeasurable (T g) localSmoothingMeasure := by
    intro g _
    exact (measurable_localDyadicHalfWaveMagnitude C σ j g).aestronglyMeasurable
  have hstrong2 : ∀ g, g ∈ D →
      eLpNorm (T g) (ENNReal.ofReal 2) localSmoothingMeasure ≤
        ENNReal.ofReal 2 * eLpNorm (eval g) (ENNReal.ofReal 2) volume := by
    intro g _
    calc
      eLpNorm (T g) (ENNReal.ofReal 2) localSmoothingMeasure =
          eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j g)
            (ENNReal.ofReal 2) localSmoothingMeasure := by
            rw [eLpNorm_congr_ae (localDyadicHalfWaveMagnitude_ae_eq C σ j g),
              eLpNorm_norm]
      _ ≤ ENNReal.ofReal 2 * eLpNorm (g : Euclidean 2 → Complex)
          (ENNReal.ofReal 2) volume := localL2Endpoint_proof C j g σ
      _ = ENNReal.ofReal 2 * eLpNorm (eval g) (ENNReal.ofReal 2) volume := rfl
  have hstrong4' : ∀ g, g ∈ D →
      eLpNorm (T g) (ENNReal.ofReal 4) localSmoothingMeasure ≤
        B4 * eLpNorm (eval g) (ENNReal.ofReal 4) volume := by
    intro g _
    calc
      eLpNorm (T g) (ENNReal.ofReal 4) localSmoothingMeasure =
          eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j g)
            (ENNReal.ofReal 4) localSmoothingMeasure := by
            rw [eLpNorm_congr_ae (localDyadicHalfWaveMagnitude_ae_eq C σ j g),
              eLpNorm_norm]
      _ ≤ B4 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume :=
        hstrong4 g
      _ = B4 * eLpNorm (eval g) (ENNReal.ofReal 4) volume := rfl
  have hTf : AEMeasurable (T f) localSmoothingMeasure :=
    (hTmeas f (by simp [D])).aemeasurable
  rcases exists_schwartz_smooth_low_high_family f with
    ⟨low, high, hlow, hhigh, hsplit⟩
  have hlowI_raw : Measurable (fun t : Real => ∫⁻ x,
      (ENNReal.ofReal ‖low t x‖) ^ (4 : Real)) :=
    mss_measurable_smooth_low_profile_lintegrals f low high hlow hhigh 4
  have hhighI_raw : Measurable (fun t : Real => ∫⁻ x,
      (ENNReal.ofReal ‖high t x‖) ^ (2 : Real)) :=
    measurable_smooth_high_profile_lintegrals f low high hlow hhigh 2
  have hlowI_meas : Measurable (fun t =>
      (eLpNorm (eval (low t)) (ENNReal.ofReal 4) volume) ^ (4 : Real)) := by
    rw [show (fun t =>
      (eLpNorm (eval (low t)) (ENNReal.ofReal 4) volume) ^ (4 : Real)) =
      fun t => ∫⁻ x, (ENNReal.ofReal ‖low t x‖) ^ (4 : Real) by
      funext t
      exact (lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow (by norm_num) (low t)).symm]
    exact hlowI_raw
  have hhighI_meas : Measurable (fun t =>
      (eLpNorm (eval (high t)) (ENNReal.ofReal 2) volume) ^ (2 : Real)) := by
    rw [show (fun t =>
      (eLpNorm (eval (high t)) (ENNReal.ofReal 2) volume) ^ (2 : Real)) =
      fun t => ∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ (2 : Real) by
      funext t
      exact (lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow (by norm_num) (high t)).symm]
    exact hhighI_raw
  have hhighTailRaw := smooth_bump_schwartz_high_q_weighted_tail f low high hlow hhigh
    (q := 2) (p := p) (by norm_num) hp2
  have hhigh_tail :
      (∫⁻ t in Ioi (0 : Real),
        (eLpNorm (eval (high t)) (ENNReal.ofReal 2) volume) ^ (2 : Real) *
          (ENNReal.ofReal t) ^ (p - 2 - 1)) ≤
        ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2)) *
          (eLpNorm (eval f) (ENNReal.ofReal p) volume) ^ p := by
    calc
      (∫⁻ t in Ioi (0 : Real),
        (eLpNorm (eval (high t)) (ENNReal.ofReal 2) volume) ^ (2 : Real) *
          (ENNReal.ofReal t) ^ (p - 2 - 1)) =
        ∫⁻ t in Ioi (0 : Real),
          (∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ (2 : Real)) *
            (ENNReal.ofReal t) ^ (p - 2 - 1) := by
          apply lintegral_congr
          intro t
          exact congrArg (fun a => a * (ENNReal.ofReal t) ^ (p - 2 - 1))
            (lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow (by norm_num) (high t)).symm
      _ ≤ ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2)) *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := hhighTailRaw
      _ = _ := by rw [lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow (lt_trans (by norm_num) hp2) f]
  have hlowTailRaw := smooth_bump_schwartz_low_q_weighted_tail f low high hlow hhigh
    (p := p) (q := 4) (lt_trans (by norm_num) hp2) hp4
  have hlow_tail :
      (∫⁻ t in Ioi (0 : Real),
        (eLpNorm (eval (low t)) (ENNReal.ofReal 4) volume) ^ (4 : Real) *
          (ENNReal.ofReal t) ^ (p - 4 - 1)) ≤
        ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
          (ENNReal.ofReal (4 - p))⁻¹) *
          (eLpNorm (eval f) (ENNReal.ofReal p) volume) ^ p := by
    calc
      (∫⁻ t in Ioi (0 : Real),
        (eLpNorm (eval (low t)) (ENNReal.ofReal 4) volume) ^ (4 : Real) *
          (ENNReal.ofReal t) ^ (p - 4 - 1)) =
        ∫⁻ t in Ioi (0 : Real),
          (∫⁻ x, (ENNReal.ofReal ‖low t x‖) ^ (4 : Real)) *
            (ENNReal.ofReal t) ^ (p - 4 - 1) := by
          apply lintegral_congr
          intro t
          exact congrArg (fun a => a * (ENNReal.ofReal t) ^ (p - 4 - 1))
            (lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow (by norm_num) (low t)).symm
      _ ≤ ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
          (ENNReal.ofReal (4 - p))⁻¹) *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := hlowTailRaw
      _ = _ := by rw [lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow (lt_trans (by norm_num) hp2) f]
  exact sourceOutput_two_pair_eLpNorm_le_of_scaled_strong_endpoints_and_split_tails
    D eval T hTnonneg hTsub hTmeas (by norm_num) (by norm_num)
    (lt_trans (by norm_num) hp2) (ENNReal.ofReal 2) B4 hstrong2 hstrong4' f hTf low high
    (fun _ => by simp [D]) (fun _ => by simp [D])
    (fun t => by ext x; exact hsplit t x) hlowI_meas hhighI_meas
    ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2))
    ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
      (ENNReal.ofReal (4 - p))⁻¹)
    hhigh_tail hlow_tail s hs

/-- The literal cutoff half-wave on the Schwartz core obeys the supplied-split
`L⁴`--`L∞` interpolation estimate.  The top endpoint is transported through
`localDyadicHalfWaveMagnitude`, so it is never asserted outside `[1,2]`. -/
theorem mss_four_top_coefficient
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    {p : Real} (hp4 : 4 < p)
    (B4 : ENNReal)
    (hstrong4 : ∀ g : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j g) (ENNReal.ofReal 4)
          localSmoothingMeasure ≤
        B4 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume)
    (Btop : Real) (hBtop : 0 < Btop)
    (hTop : ∀ (g : SchwartzMap (Euclidean 2) Complex) (a : Real), 0 ≤ a →
      (∀ x, ‖g x‖ ≤ a) → ∀ z,
        localDyadicHalfWaveMagnitude C σ j g z ≤ Btop * a)
    (f : SchwartzMap (Euclidean 2) Complex) :
    eLpNorm (localDyadicHalfWaveMagnitude C σ j f) (ENNReal.ofReal p)
        localSmoothingMeasure ≤
      ENNReal.ofReal Btop *
        (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
          (B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) *
          ((ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)))) ^ p⁻¹ *
      eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
  letI : SFinite localSmoothingMeasure := by
    rw [localSmoothingMeasure]
    infer_instance
  let D : Set (SchwartzMap (Euclidean 2) Complex) := Set.univ
  let eval : SchwartzMap (Euclidean 2) Complex → Euclidean 2 → Complex := fun g => g
  let T : SchwartzMap (Euclidean 2) Complex → Euclidean 2 × Real → Real :=
    fun g => localDyadicHalfWaveMagnitude C σ j g
  let S : SchwartzMap (Euclidean 2) Complex → Euclidean 2 × Real → Real :=
    fun g z => T g z / Btop
  have hSnonneg : ∀ g z, 0 ≤ S g z := by
    intro g z
    exact div_nonneg (localDyadicHalfWaveMagnitude_nonneg C σ j g z) hBtop.le
  have hSsub : ∀ ⦃g h : SchwartzMap (Euclidean 2) Complex⦄,
      g ∈ D → h ∈ D → ∀ z, S (g + h) z ≤ S g z + S h z := by
    intro g h _ _ z
    change T (g + h) z / Btop ≤ T g z / Btop + T h z / Btop
    rw [← add_div]
    exact div_le_div_of_nonneg_right
      (localDyadicHalfWaveMagnitude_add_le C σ j g h z) hBtop.le
  have hSmeas : ∀ g, g ∈ D → AEStronglyMeasurable (S g) localSmoothingMeasure := by
    intro g _
    exact ((measurable_localDyadicHalfWaveMagnitude C σ j g).div_const Btop).aestronglyMeasurable
  have hSstrong : ∀ g, g ∈ D →
      eLpNorm (S g) (ENNReal.ofReal 4) localSmoothingMeasure ≤
        (B4 * (ENNReal.ofReal Btop)⁻¹) *
          eLpNorm (eval g) (ENNReal.ofReal 4) volume := by
    intro g _
    have hSeq : S g = (Btop⁻¹) • T g := by
      funext z
      change T g z / Btop = Btop⁻¹ * T g z
      field_simp [hBtop.ne']
    calc
      eLpNorm (S g) (ENNReal.ofReal 4) localSmoothingMeasure =
          ENNReal.ofReal (Btop⁻¹) * eLpNorm (T g) (ENNReal.ofReal 4)
            localSmoothingMeasure := by
            rw [hSeq, eLpNorm_const_smul]
            rw [Real.enorm_eq_ofReal (inv_nonneg.mpr hBtop.le)]
      _ ≤ ENNReal.ofReal (Btop⁻¹) *
          (B4 * eLpNorm (eval g) (ENNReal.ofReal 4) volume) := by
            apply mul_le_mul_right
            calc
              eLpNorm (T g) (ENNReal.ofReal 4) localSmoothingMeasure =
                  eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j g)
                    (ENNReal.ofReal 4) localSmoothingMeasure := by
                    rw [eLpNorm_congr_ae
                      (localDyadicHalfWaveMagnitude_ae_eq C σ j g), eLpNorm_norm]
              _ ≤ B4 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume :=
                hstrong4 g
              _ = B4 * eLpNorm (eval g) (ENNReal.ofReal 4) volume := rfl
      _ = (B4 * (ENNReal.ofReal Btop)⁻¹) *
          eLpNorm (eval g) (ENNReal.ofReal 4) volume := by
            rw [ENNReal.ofReal_inv_of_pos hBtop]
            ac_rfl
  have hSweak : ∀ g, g ∈ D → ∀ {u : Real}, 0 < u →
      (ENNReal.ofReal u) ^ (4 : Real) *
          localSmoothingMeasure {z | u < S g z} ≤
        (B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) *
          (∫⁻ x, (ENNReal.ofReal ‖eval g x‖) ^ (4 : Real)) := by
    intro g _ u hu
    have hcheb := sourceOutput_weak_distribution_of_eLpNorm (S g)
      (hSmeas g (by simp [D])) (by norm_num : (0 : Real) < 4) hu
      ((B4 * (ENNReal.ofReal Btop)⁻¹) *
        eLpNorm (eval g) (ENNReal.ofReal 4) volume) (hSstrong g (by simp [D]))
    calc
      (ENNReal.ofReal u) ^ (4 : Real) *
          localSmoothingMeasure {z | u < S g z} =
          localSmoothingMeasure {z | u < S g z} * (ENNReal.ofReal u) ^ (4 : Real) := by
            ac_rfl
      _ ≤ ((B4 * (ENNReal.ofReal Btop)⁻¹) *
          eLpNorm (eval g) (ENNReal.ofReal 4) volume) ^ (4 : Real) := hcheb
      _ = (B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) *
          (eLpNorm (eval g) (ENNReal.ofReal 4) volume) ^ (4 : Real) := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]
      _ = _ := by
            rw [← lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow (by norm_num) (eval g)]
  have hStop : ∀ g, g ∈ D → ∀ a : Real, 0 ≤ a →
      (∀ x, ‖eval g x‖ ≤ a) → ∀ z, S g z ≤ a := by
    intro g _ a ha hga z
    change T g z / Btop ≤ a
    rw [div_le_iff₀ hBtop]
    simpa [mul_comm] using hTop g a ha hga z
  rcases exists_schwartz_smooth_low_high_family f with
    ⟨low, high, hlow, hhigh, hsplit⟩
  have hhighI_meas : Measurable (fun t : Real => ∫⁻ x,
      (ENNReal.ofReal ‖eval (high t) x‖) ^ (4 : Real)) := by
    simpa only [eval] using
      (measurable_smooth_high_profile_lintegrals f low high hlow hhigh 4)
  have hhighTailRaw := smooth_bump_schwartz_high_q_weighted_tail f low high hlow hhigh
    (q := 4) (p := p) (by norm_num) hp4
  have hhigh_tail :
      (∫⁻ t in Ioi (0 : Real),
        (∫⁻ x, (ENNReal.ofReal ‖eval (high t) x‖) ^ (4 : Real)) *
          (ENNReal.ofReal t) ^ (p - 4 - 1)) ≤
        ((ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)) *
          ∫⁻ x, (ENNReal.ofReal ‖eval f x‖) ^ p := by
    simpa only [eval] using hhighTailRaw
  have hSmoment := sourceOutput_marcinkiewicz_weak_q_top_on_additive_split
    D eval S hSnonneg hSsub (4 : Real) (by norm_num)
    ((B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real)) hSweak hStop hp4 f
    (hSmeas f (by simp [D])).aemeasurable low high
    (fun _ => by simp [D]) (fun _ => by simp [D])
    (fun t => by ext x; exact hsplit t x)
    (fun t ht x => smooth_low_norm_le_half_height f (low t) ht (hlow t) x)
    hhighI_meas
    (((ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)) *
      ∫⁻ x, (ENNReal.ofReal ‖eval f x‖) ^ p)
    hhigh_tail
  let H : ENNReal := (ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)
  let K : ENNReal := ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
    (B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) * H)
  have hSmoment' : (∫⁻ z, ENNReal.ofReal ((S f z) ^ p) ∂localSmoothingMeasure) ≤
      K * (∫⁻ x, (ENNReal.ofReal ‖eval f x‖) ^ p) := by
    dsimp only [K, H]
    simpa only [mul_assoc] using hSmoment
  have hSbound := sourceOutput_eLpNorm_le_of_nonnegative_moment S f
    (lt_trans (by norm_num) hp4) (hSnonneg f)
    (K * ∫⁻ x, (ENNReal.ofReal ‖eval f x‖) ^ p) hSmoment'
  have hin : (∫⁻ x, (ENNReal.ofReal ‖eval f x‖) ^ p) =
      (eLpNorm (eval f) (ENNReal.ofReal p) volume) ^ p :=
    lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow (lt_trans (by norm_num) hp4) (eval f)
  rw [hin] at hSbound
  have hSbound' : eLpNorm (S f) (ENNReal.ofReal p) localSmoothingMeasure ≤
      K ^ p⁻¹ * eLpNorm (eval f) (ENNReal.ofReal p) volume := by
    calc
      eLpNorm (S f) (ENNReal.ofReal p) localSmoothingMeasure ≤
          (K * (eLpNorm (eval f) (ENNReal.ofReal p) volume) ^ p) ^ p⁻¹ := hSbound
      _ = K ^ p⁻¹ * eLpNorm (eval f) (ENNReal.ofReal p) volume := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr (lt_trans (by norm_num) hp4).le),
          ← ENNReal.rpow_mul]
        have hpp : p * p⁻¹ = (1 : Real) := by field_simp
        rw [hpp, ENNReal.rpow_one]
  have hTeq : T f = Btop • S f := by
    funext z
    change T f z = Btop * (T f z / Btop)
    field_simp [hBtop.ne']
  calc
    eLpNorm (localDyadicHalfWaveMagnitude C σ j f) (ENNReal.ofReal p)
        localSmoothingMeasure = eLpNorm (T f) (ENNReal.ofReal p)
          localSmoothingMeasure := rfl
    _ = ENNReal.ofReal Btop * eLpNorm (S f) (ENNReal.ofReal p)
          localSmoothingMeasure := by
          rw [hTeq, eLpNorm_const_smul, Real.enorm_eq_ofReal hBtop.le]
    _ ≤ ENNReal.ofReal Btop *
        (K ^ p⁻¹ * eLpNorm (eval f) (ENNReal.ofReal p) volume) :=
      mul_le_mul_right hSbound' _
    _ = ENNReal.ofReal Btop *
        (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
          (B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) *
          ((ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)))) ^ p⁻¹ *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
      dsimp only [K, H, eval]
      ac_rfl

/-- A finite extended-nonnegative constant can be absorbed into a positive
real coefficient.  This is used only to package scale-independent
interpolation constants in the exact `localSmoothing` format. -/
private theorem mss_ennreal_exists_pos_real_majorant
    {K : ENNReal} (hK : K ≠ ∞) :
    ∃ C : Real, 0 < C ∧ K ≤ ENNReal.ofReal C := by
  refine ⟨K.toReal + 1, by positivity, ?_⟩
  calc
    K = ENNReal.ofReal K.toReal := (ENNReal.ofReal_toReal hK).symm
    _ ≤ ENNReal.ofReal (K.toReal + 1) := by
      have hKnonneg : 0 ≤ K.toReal := ENNReal.toReal_nonneg
      exact ENNReal.ofReal_le_ofReal (by linarith)

/-- Algebraic normalization of the scale chosen for the two-pair
`L²`--`L⁴` source-output interpolation engine. -/
private theorem mss_two_four_coefficient_factor
    {p b : Real} (_hp : 0 < p) (hb : 0 < b)
    (H L : ENNReal) :
    sourceOutputTwoPairMarcinkiewiczMomentCoefficient p 2 4
        ((ENNReal.ofReal 2) ^ (2 : Real)) ((ENNReal.ofReal b) ^ (4 : Real))
        ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((2 : Real) - p) * H)
        ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((4 : Real) - p) * L) =
      (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) * (H + L))) *
        (ENNReal.ofReal b) ^ (2 * p - 4) := by
  let B : ENNReal := ENNReal.ofReal b
  let Q : ENNReal := ENNReal.ofReal 2
  have hB0 : B ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hb
  have hBtop : B ≠ ∞ := ENNReal.ofReal_ne_top
  have hQ0 : Q ≠ 0 := by norm_num [Q]
  have hQtop : Q ≠ ∞ := ENNReal.ofReal_ne_top
  have hs : ENNReal.ofReal (b⁻¹ * b⁻¹) = B ^ (-2 : Real) := by
    rw [ENNReal.ofReal_mul (inv_nonneg.mpr hb.le), ENNReal.ofReal_inv_of_pos hb]
    dsimp only [B]
    rw [← ENNReal.rpow_neg_one]
    rw [← ENNReal.rpow_add _ _ hB0 hBtop]
    congr 1
    ring
  have hpow0 : (B ^ (-2 : Real)) ^ ((2 : Real) - p) = B ^ (2 * p - 4) := by
    rw [← ENNReal.rpow_mul]
    congr 1
    ring
  have hpow1 : B ^ (4 : Real) * (B ^ (-2 : Real)) ^ ((4 : Real) - p) =
      B ^ (2 * p - 4) := by
    rw [← ENNReal.rpow_mul]
    rw [← ENNReal.rpow_add _ _ hB0 hBtop]
    congr 1
    ring
  change ENNReal.ofReal p *
      (Q ^ (2 : Real) * Q ^ (2 : Real) *
          (ENNReal.ofReal (b⁻¹ * b⁻¹) ^ ((2 : Real) - p) * H) +
        Q ^ (4 : Real) * B ^ (4 : Real) *
          (ENNReal.ofReal (b⁻¹ * b⁻¹) ^ ((4 : Real) - p) * L)) = _
  rw [hs]
  rw [hpow0]
  have hQpow : Q ^ (2 : Real) * Q ^ (2 : Real) = Q ^ (4 : Real) := by
    rw [← ENNReal.rpow_add _ _ hQ0 hQtop]
    congr 1
    ring
  rw [hQpow]
  rw [show Q ^ (4 : Real) * B ^ (4 : Real) *
      ((B ^ (-2 : Real)) ^ ((4 : Real) - p) * L) =
      Q ^ (4 : Real) *
        (B ^ (4 : Real) * (B ^ (-2 : Real)) ^ ((4 : Real) - p)) * L by
      ac_rfl, hpow1]
  rw [show Q ^ (4 : Real) * (B ^ (2 * p - 4) * H) +
      Q ^ (4 : Real) * B ^ (2 * p - 4) * L =
      (Q ^ (4 : Real) * (H + L)) * B ^ (2 * p - 4) by
      calc
        Q ^ (4 : Real) * (B ^ (2 * p - 4) * H) +
            Q ^ (4 : Real) * B ^ (2 * p - 4) * L =
            (Q ^ (4 : Real) * H + Q ^ (4 : Real) * L) * B ^ (2 * p - 4) := by
              rw [add_mul]
              ac_rfl
        _ = _ := by rw [mul_add]]
  ac_rfl

private theorem mss_two_four_root_factor
    {p : Real} (hp : 0 < p) (K b : ENNReal) :
    (K * b ^ (2 * p - 4)) ^ p⁻¹ =
      K ^ p⁻¹ * b ^ (2 - 4 / p) := by
  rw [ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hp.le),
    ← ENNReal.rpow_mul]
  congr 1
  field_simp

private theorem mss_ofReal_product_rpow
    {a r θ : Real} (ha : 0 < a) (hθ : 0 ≤ θ) (j : Nat) :
    (ENNReal.ofReal (a * (2 : Real) ^ ((j : Real) * r))) ^ θ =
      ENNReal.ofReal (a ^ θ) *
        ENNReal.ofReal ((2 : Real) ^ ((j : Real) * (r * θ))) := by
  rw [ENNReal.ofReal_mul ha.le,
    ENNReal.mul_rpow_of_nonneg _ _ hθ]
  rw [ENNReal.ofReal_rpow_of_pos ha]
  congr 1
  rw [show (2 : Real) ^ ((j : Real) * (r * θ)) =
      ((2 : Real) ^ ((j : Real) * r)) ^ θ by
      rw [← Real.rpow_mul (by norm_num : (0 : Real) ≤ 2)]
      congr 1
      ring]
  rw [ENNReal.ofReal_rpow_of_pos
    (Real.rpow_pos_of_pos (by norm_num) _)]

private theorem mss_two_four_theta_pos {p : Real} (hp2 : 2 < p) :
    0 < 2 - 4 / p := by
  have hp0 : 0 < p := lt_trans (by norm_num) hp2
  apply sub_pos.mpr
  rw [div_lt_iff₀ hp0]
  nlinarith

private theorem mss_two_four_rate
    {p η : Real} (hp : 0 < p) (hθ : 0 < 2 - 4 / p) :
    (1 / 8 + η / (2 - 4 / p)) * (2 - 4 / p) =
      1 / 4 - 1 / (2 * p) + η := by
  calc
    (1 / 8 + η / (2 - 4 / p)) * (2 - 4 / p) =
        (1 / 8) * (2 - 4 / p) + (η / (2 - 4 / p)) * (2 - 4 / p) := by ring
    _ = (1 / 8) * (2 - 4 / p) + η := by
      rw [div_mul_cancel₀ _ hθ.ne']
    _ = 1 / 4 - 1 / (2 * p) + η := by
      field_simp [hp.ne']
      ring

private theorem mss_two_four_constant_finite
    {p : Real} (hp2 : 2 < p) (hp4 : p < 4) :
    (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
      ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2) +
        ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
          (ENNReal.ofReal (4 - p))⁻¹)))) ^ p⁻¹ ≠ ∞ := by
  have hp0 : 0 < p := lt_trans (by norm_num) hp2
  have hp2' : 0 < p - 2 := sub_pos.mpr hp2
  have hp4' : 0 < 4 - p := sub_pos.mpr hp4
  apply ENNReal.rpow_ne_top_of_nonneg (inv_nonneg.mpr hp0.le)
  apply ENNReal.mul_ne_top ENNReal.ofReal_ne_top
  apply ENNReal.mul_ne_top
  · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
  apply ENNReal.add_ne_top.mpr
  constructor
  · apply ENNReal.mul_ne_top
    · exact ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hp2')
    · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
  · apply ENNReal.add_ne_top.mpr
    constructor
    · apply ENNReal.mul_ne_top
      · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
      · exact ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hp0)
    · exact ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hp4')

/-- The proved local `L²` endpoint and a literal Schwartz-core `p=4`
local-smoothing estimate interpolate to every `2 < p < 4`.  The proof uses
the radius-scaled two-pair source-output engine, so the gain has the exact
MSS exponent rather than an unscaled interpolation loss. -/
theorem p4LocalSmoothing_to_localSmoothing_two_four
    (C : lpCutoffs 2) (h4 : p4LocalSmoothing C.cutoff)
    {p η : Real} (hp2 : 2 < p) (hp4 : p < 4) (hη : 0 < η) :
    localSmoothing C.cutoff p η := by
  let θ : Real := 2 - 4 / p
  have hθ : 0 < θ := by
    dsimp only [θ]
    exact mss_two_four_theta_pos hp2
  let δ : Real := η / θ
  have hδ : 0 < δ := div_pos hη hθ
  rcases h4 δ hδ with ⟨_, _, A, hA, hA_bound⟩
  refine ⟨hp2, hη, ?_⟩
  let H : ENNReal := (ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2)
  let L : ENNReal :=
    (ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
      (ENNReal.ofReal (4 - p))⁻¹
  let K : ENNReal := ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) * (H + L))
  have hKtop : K ^ p⁻¹ ≠ ∞ := by
    dsimp only [K, H, L]
    exact mss_two_four_constant_finite hp2 hp4
  let D : Real := (K ^ p⁻¹).toReal * A ^ θ + 1
  have hD : 0 < D := by
    dsimp only [D]
    positivity
  refine ⟨D, hD, ?_⟩
  intro j hj f σ
  let b : Real := A * (2 : Real) ^ ((j : Real) * (1 / 8 + δ))
  have hb : 0 < b := by
    dsimp only [b]
    exact mul_pos hA (Real.rpow_pos_of_pos (by norm_num) _)
  have hstrong4 : ∀ g : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j g) (ENNReal.ofReal 4)
          localSmoothingMeasure ≤
        ENNReal.ofReal b * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := by
    intro g
    convert hA_bound j hj g σ using 1 <;>
      dsimp only [b] <;> rw [mssGain_four] <;> ring
  have hs : 0 < b⁻¹ * b⁻¹ := by positivity
  have hinterp := mss_two_four_coefficient C σ j hp2 hp4 (ENNReal.ofReal b)
    hstrong4 (b⁻¹ * b⁻¹) hs f
  have hcoef :
      sourceOutputTwoPairMarcinkiewiczMomentCoefficient p 2 4
          ((ENNReal.ofReal 2) ^ (2 : Real)) ((ENNReal.ofReal b) ^ (4 : Real))
          ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((2 : Real) - p) * H)
          ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((4 : Real) - p) * L) =
        K * (ENNReal.ofReal b) ^ (2 * p - 4) := by
    dsimp only [K, H, L]
    exact mss_two_four_coefficient_factor (lt_trans (by norm_num) hp2) hb _ _
  have hroot := mss_two_four_root_factor (lt_trans (by norm_num) hp2) K
    (ENNReal.ofReal b)
  have hBpow : (ENNReal.ofReal b) ^ θ =
      ENNReal.ofReal (A ^ θ) *
        ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 8 + δ) * θ))) := by
    dsimp only [b]
    exact mss_ofReal_product_rpow hA hθ.le j
  have hrate : (1 / 8 + δ) * θ =
      1 / 4 - 1 / (2 * p) + η := by
    dsimp only [δ, θ]
    exact mss_two_four_rate (lt_trans (by norm_num) hp2)
      (mss_two_four_theta_pos hp2)
  have hstatic : K ^ p⁻¹ * ENNReal.ofReal (A ^ θ) ≤ ENNReal.ofReal D := by
    calc
      K ^ p⁻¹ * ENNReal.ofReal (A ^ θ) =
          ENNReal.ofReal ((K ^ p⁻¹).toReal) * ENNReal.ofReal (A ^ θ) := by
            rw [ENNReal.ofReal_toReal hKtop]
      _ =
          ENNReal.ofReal ((K ^ p⁻¹).toReal * A ^ θ) := by
            rw [← ENNReal.ofReal_mul ENNReal.toReal_nonneg]
      _ ≤ ENNReal.ofReal ((K ^ p⁻¹).toReal * A ^ θ + 1) := by
        apply ENNReal.ofReal_le_ofReal
        have hnon : 0 ≤ (K ^ p⁻¹).toReal * A ^ θ :=
          mul_nonneg ENNReal.toReal_nonneg (Real.rpow_nonneg hA.le _)
        linarith
      _ = ENNReal.ofReal D := rfl
  have htargetrate : 1 / 2 - 1 / p - mssGain p + η =
      1 / 4 - 1 / (2 * p) + η := by
    rw [mssGain_of_le_four hp4.le]
    ring
  calc
    eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j f) (ENNReal.ofReal p)
        localSmoothingMeasure =
        eLpNorm (localDyadicHalfWaveMagnitude C σ j f) (ENNReal.ofReal p)
          localSmoothingMeasure := by
            rw [eLpNorm_congr_ae (localDyadicHalfWaveMagnitude_ae_eq C σ j f), eLpNorm_norm]
    _ ≤ (sourceOutputTwoPairMarcinkiewiczMomentCoefficient p 2 4
          ((ENNReal.ofReal 2) ^ (2 : Real)) ((ENNReal.ofReal b) ^ (4 : Real))
          ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((2 : Real) - p) * H)
          ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((4 : Real) - p) * L)) ^ p⁻¹ *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          exact hinterp
    _ = (K * (ENNReal.ofReal b) ^ (2 * p - 4)) ^ p⁻¹ *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by rw [hcoef]
    _ = (K ^ p⁻¹ * (ENNReal.ofReal b) ^ θ) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          rw [hroot]
    _ = (K ^ p⁻¹ * ENNReal.ofReal (A ^ θ) *
        ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 8 + δ) * θ)))) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          rw [hBpow]
          ac_rfl
    _ ≤ (ENNReal.ofReal D *
        ENNReal.ofReal ((2 : Real) ^ ((j : Real) *
          (1 / 4 - 1 / (2 * p) + η)))) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          rw [hrate]
          gcongr
    _ = ENNReal.ofReal (D * (2 : Real) ^
        ((j : Real) * (1 / 2 - 1 / p - mssGain p + η))) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          rw [htargetrate]
          rw [ENNReal.ofReal_mul hD.le]

private theorem mss_four_top_root_factor
    {p : Real} (hp : 0 < p) (K b4 btop : ENNReal)
    (hbtop0 : btop ≠ 0) (hbtopT : btop ≠ ∞) :
    btop * (K * (b4 * btop⁻¹) ^ (4 : Real)) ^ p⁻¹ =
      K ^ p⁻¹ * b4 ^ (4 / p) * btop ^ (1 - 4 / p) := by
  have hinv : 0 ≤ p⁻¹ := inv_nonneg.mpr hp.le
  rw [ENNReal.mul_rpow_of_nonneg _ _ hinv]
  rw [← ENNReal.rpow_mul]
  have hfour : (4 : Real) * p⁻¹ = 4 / p := by field_simp
  rw [hfour]
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : 0 ≤ 4 / p)]
  rw [ENNReal.inv_rpow]
  rw [← ENNReal.rpow_neg]
  rw [show btop * (K ^ p⁻¹ * (b4 ^ (4 / p) * btop ^ (-(4 / p)))) =
      (K ^ p⁻¹ * b4 ^ (4 / p)) * (btop * btop ^ (-(4 / p))) by ac_rfl]
  rw [show btop * btop ^ (-(4 / p)) = btop ^ (1 - 4 / p) by
    calc
      btop * btop ^ (-(4 / p)) = btop ^ (1 : Real) * btop ^ (-(4 / p)) := by
        rw [ENNReal.rpow_one]
      _ = btop ^ (1 + -(4 / p)) := (ENNReal.rpow_add _ _ hbtop0 hbtopT).symm
      _ = btop ^ (1 - 4 / p) := by congr 1 <;> ring]

private theorem mss_four_top_constant_finite
    {p : Real} (hp4 : 4 < p) :
    (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
      ((ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)))) ^ p⁻¹ ≠ ∞ := by
  have hp0 : 0 < p := lt_trans (by norm_num) hp4
  have hp4' : 0 < p - 4 := sub_pos.mpr hp4
  apply ENNReal.rpow_ne_top_of_nonneg (inv_nonneg.mpr hp0.le)
  apply ENNReal.mul_ne_top ENNReal.ofReal_ne_top
  apply ENNReal.mul_ne_top
  · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
  · apply ENNReal.mul_ne_top
    · exact ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hp4')
    · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top

private theorem mss_sqrt_two_rpow (j : Nat) :
    Real.sqrt ((2 : Real) ^ j) = (2 : Real) ^ ((j : Real) * (1 / 2)) := by
  calc
    Real.sqrt ((2 : Real) ^ j) = ((2 : Real) ^ j) ^ (1 / 2 : Real) :=
      Real.sqrt_eq_rpow _
    _ = ((2 : Real) ^ (j : Real)) ^ (1 / 2 : Real) := by
      rw [Real.rpow_natCast]
    _ = (2 : Real) ^ ((j : Real) * (1 / 2)) :=
      (Real.rpow_mul (by norm_num : (0 : Real) ≤ 2) _ _).symm

private theorem mss_four_top_rate
    {p η : Real} (hp : 0 < p) :
    (1 / 8 + p * η / 4) * (4 / p) +
      (1 / 2) * (1 - 4 / p) =
        1 / 2 - 3 / (2 * p) + η := by
  field_simp [hp.ne']
  ring

/-- A literal Schwartz-core `p=4` local-smoothing estimate and the proved
slab-local `L∞` endpoint interpolate to every `4 < p`.  The `L∞` assertion is
used only through `localDyadicHalfWaveMagnitude`, which is zero off the
physical time slab. -/
theorem p4LocalSmoothing_to_localSmoothing_four_top
    (C : lpCutoffs 2) (h4 : p4LocalSmoothing C.cutoff)
    {p η : Real} (hp4 : 4 < p) (hη : 0 < η) :
    localSmoothing C.cutoff p η := by
  let δ : Real := p * η / 4
  have hp0 : 0 < p := lt_trans (by norm_num) hp4
  have hδ : 0 < δ := by
    dsimp only [δ]
    positivity
  rcases h4 δ hδ with ⟨_, _, A, hA, hA_bound⟩
  rcases mssLInfinityEndpoint C with ⟨B, hB, hInfty⟩
  refine ⟨lt_trans (by norm_num) hp4, hη, ?_⟩
  let H : ENNReal := (ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)
  let K : ENNReal := ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) * H)
  have hKtop : K ^ p⁻¹ ≠ ∞ := by
    dsimp only [K, H]
    exact mss_four_top_constant_finite hp4
  let θ4 : Real := 4 / p
  have hθ4 : 0 < θ4 := by
    dsimp only [θ4]
    positivity
  let θtop : Real := 1 - 4 / p
  have hθtop : 0 < θtop := by
    dsimp only [θtop]
    apply sub_pos.mpr
    rw [div_lt_iff₀ hp0]
    simpa using hp4
  let S : ENNReal := K ^ p⁻¹ * ENNReal.ofReal (A ^ θ4) * ENNReal.ofReal (B ^ θtop)
  have hStop : S ≠ ∞ := by
    dsimp only [S]
    apply ENNReal.mul_ne_top
    · apply ENNReal.mul_ne_top
      · exact hKtop
      · exact ENNReal.ofReal_ne_top
    · exact ENNReal.ofReal_ne_top
  rcases mss_ennreal_exists_pos_real_majorant hStop with ⟨D, hD, hSle⟩
  refine ⟨D, hD, ?_⟩
  intro j hj f σ
  let b4 : Real := A * (2 : Real) ^ ((j : Real) * (1 / 8 + δ))
  have hb4 : 0 < b4 := by
    dsimp only [b4]
    exact mul_pos hA (Real.rpow_pos_of_pos (by norm_num) _)
  let btop : Real := B * Real.sqrt ((2 : Real) ^ j)
  have hbtop : 0 < btop := by
    dsimp only [btop]
    apply mul_pos hB
    exact Real.sqrt_pos.2 (pow_pos (by norm_num) _)
  have hstrong4 : ∀ g : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j g) (ENNReal.ofReal 4)
          localSmoothingMeasure ≤
        ENNReal.ofReal b4 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := by
    intro g
    convert hA_bound j hj g σ using 1 <;>
      dsimp only [b4] <;> rw [mssGain_four] <;> ring
  have hTop : ∀ (g : SchwartzMap (Euclidean 2) Complex) (a : Real), 0 ≤ a →
      (∀ x, ‖g x‖ ≤ a) → ∀ z,
        localDyadicHalfWaveMagnitude C σ j g z ≤ btop * a := by
    intro g a ha hga
    exact localDyadicHalfWaveMagnitude_top C hB hInfty σ j hj g hga
  have hinterp := mss_four_top_coefficient C σ j hp4 (ENNReal.ofReal b4) hstrong4
    btop hbtop hTop f
  have hcoef :
      ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
          (ENNReal.ofReal b4 * (ENNReal.ofReal btop)⁻¹) ^ (4 : Real) * H) =
        K * (ENNReal.ofReal b4 * (ENNReal.ofReal btop)⁻¹) ^ (4 : Real) := by
    dsimp only [K]
    ac_rfl
  have hroot := mss_four_top_root_factor hp0 K (ENNReal.ofReal b4)
    (ENNReal.ofReal btop) (ENNReal.ofReal_ne_zero_iff.mpr hbtop) ENNReal.ofReal_ne_top
  have hB4pow : (ENNReal.ofReal b4) ^ θ4 =
      ENNReal.ofReal (A ^ θ4) *
        ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 8 + δ) * θ4))) := by
    dsimp only [b4]
    exact mss_ofReal_product_rpow hA hθ4.le j
  have hBtoppow : (ENNReal.ofReal btop) ^ θtop =
      ENNReal.ofReal (B ^ θtop) *
        ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 2) * θtop))) := by
    dsimp only [btop]
    rw [mss_sqrt_two_rpow]
    exact mss_ofReal_product_rpow hB hθtop.le j
  have hrate : (1 / 8 + δ) * θ4 + (1 / 2) * θtop =
      1 / 2 - 3 / (2 * p) + η := by
    dsimp only [δ, θ4, θtop]
    exact mss_four_top_rate hp0
  have hscale :
      ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 8 + δ) * θ4))) *
        ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 2) * θtop))) =
      ENNReal.ofReal ((2 : Real) ^ ((j : Real) *
        (1 / 2 - 3 / (2 * p) + η))) := by
    rw [← ENNReal.ofReal_mul (Real.rpow_nonneg (by norm_num) _)]
    rw [← Real.rpow_add (by norm_num : (0 : Real) < 2)]
    congr 1
    rw [← mul_add, hrate]
  have htargetrate : 1 / 2 - 1 / p - mssGain p + η =
      1 / 2 - 3 / (2 * p) + η := by
    rw [mssGain_of_four_lt hp4]
    field_simp [hp0.ne']
    ring
  calc
    eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j f) (ENNReal.ofReal p)
        localSmoothingMeasure =
        eLpNorm (localDyadicHalfWaveMagnitude C σ j f) (ENNReal.ofReal p)
          localSmoothingMeasure := by
            rw [eLpNorm_congr_ae (localDyadicHalfWaveMagnitude_ae_eq C σ j f), eLpNorm_norm]
    _ ≤ ENNReal.ofReal btop *
        (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
          (ENNReal.ofReal b4 * (ENNReal.ofReal btop)⁻¹) ^ (4 : Real) * H)) ^ p⁻¹ *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          exact hinterp
    _ = (K ^ p⁻¹ * (ENNReal.ofReal b4) ^ θ4 *
        (ENNReal.ofReal btop) ^ θtop) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          rw [hcoef, hroot]
    _ = (K ^ p⁻¹ * ENNReal.ofReal (A ^ θ4) * ENNReal.ofReal (B ^ θtop)) *
        (ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 8 + δ) * θ4))) *
          ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 2) * θtop))) *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume) := by
          rw [hB4pow, hBtoppow]
          ac_rfl
    _ = S *
        (ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 8 + δ) * θ4))) *
          ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 2) * θtop))) *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume) := by
          rfl
    _ ≤ ENNReal.ofReal D *
        (ENNReal.ofReal ((2 : Real) ^ ((j : Real) *
          (1 / 2 - 3 / (2 * p) + η))) *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume) := by
          rw [hscale]
          gcongr
    _ = ENNReal.ofReal (D * (2 : Real) ^
        ((j : Real) * (1 / 2 - 1 / p - mssGain p + η))) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          rw [htargetrate]
          rw [ENNReal.ofReal_mul hD.le]
          ac_rfl

/-- A sharp local `p=4` estimate yields the complete real-exponent MSS
local-smoothing family.  The proof is direct at `p=4`, uses the proved local
`L²` endpoint below four, and uses the slab-local proved `L∞` endpoint above
four. -/
theorem p4LocalSmoothing_to_localSmoothing_all_p
    (C : lpCutoffs 2) (h4 : p4LocalSmoothing C.cutoff)
    {p η : Real} (hp : 2 < p) (hη : 0 < η) :
    localSmoothing C.cutoff p η := by
  by_cases hp4 : p ≤ 4
  · rcases lt_or_eq_of_le hp4 with hplt | rfl
    · exact p4LocalSmoothing_to_localSmoothing_two_four C h4 hp hplt hη
    · exact h4 η hη
  · exact p4LocalSmoothing_to_localSmoothing_four_top C h4 (lt_of_not_ge hp4) hη

/-! ## Finite joint-Schwartz vertical recombination -/

namespace aux_VerticalRecombinationProof

open scoped BigOperators

private abbrev ScratchVerticalCutoff := MSSVerticalCutoff

private theorem scratch_active_vertical_indices_card_le_three
    (B : ScratchVerticalCutoff) (indices : Finset Int) (s : Real) :
    (indices.filter fun n : Int => B.cutoff (s - n) ≠ 0).card ≤ 3 := by
  let S : Finset Int := indices.filter fun n : Int => B.cutoff (s - n) ≠ 0
  have hsub : S ⊆ Finset.Icc (⌊s⌋ - 1) (⌊s⌋ + 1) := by
    intro n hn
    have hne : B.cutoff (s - n) ≠ 0 := (Finset.mem_filter.mp hn).2
    have habs : |s - n| < 1 := B.support _ hne
    have hlow : (⌊s⌋ - 1 : Int) ≤ n := by
      have hfloor : (⌊s⌋ : Int) ≤ s := Int.floor_le s
      have hnreal : s - 1 < (n : Real) := by
        linarith [((abs_lt.mp habs).2)]
      exact_mod_cast (show (⌊s⌋ : Real) - 1 ≤ n by linarith)
    have hhigh : n ≤ ⌊s⌋ + 1 := by
      have hceil : s < (⌊s⌋ : Real) + 1 := Int.lt_floor_add_one s
      have hnreal : (n : Real) < s + 1 := by
        linarith [((abs_lt.mp habs).1)]
      have hlt : n < ⌊s⌋ + 2 := by
        exact_mod_cast (show (n : Real) < (⌊s⌋ : Real) + 2 by linarith)
      omega
    exact Finset.mem_Icc.mpr ⟨hlow, hhigh⟩
  calc
    S.card ≤ (Finset.Icc (⌊s⌋ - 1) (⌊s⌋ + 1)).card := Finset.card_le_card hsub
    _ = 3 := by
      rw [Int.card_Icc]
      omega

private theorem scratch_vertical_square_overlap_le
    (B : ScratchVerticalCutoff) (indices : Finset Int) (s : Real) :
    (∑ n ∈ indices, ‖B.cutoff (s - n)‖ ^ (2 : Nat)) ≤
      3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat) := by
  let A : Real := SchwartzMap.seminorm Complex 0 0 B.cutoff
  let S : Finset Int := indices.filter fun n : Int => B.cutoff (s - n) ≠ 0
  have hsub : S ⊆ indices := Finset.filter_subset _ _
  have hzero : ∀ n ∈ indices, n ∉ S → ‖B.cutoff (s - n)‖ ^ (2 : Nat) = 0 := by
    intro n hn hns
    have hz : B.cutoff (s - n) = 0 := by
      by_contra hne
      exact hns (Finset.mem_filter.mpr ⟨hn, hne⟩)
    simp [hz]
  have hsum : (∑ n ∈ indices, ‖B.cutoff (s - n)‖ ^ (2 : Nat)) =
      ∑ n ∈ S, ‖B.cutoff (s - n)‖ ^ (2 : Nat) :=
    (Finset.sum_subset hsub hzero).symm
  have hA : 0 ≤ A := by
    exact (norm_nonneg (B.cutoff 0)).trans
      (SchwartzMap.norm_le_seminorm Complex B.cutoff 0)
  have hterm : ∀ n ∈ S, ‖B.cutoff (s - n)‖ ^ (2 : Nat) ≤ A ^ (2 : Nat) := by
    intro n hn
    exact pow_le_pow_left₀
      (norm_nonneg _) (SchwartzMap.norm_le_seminorm Complex B.cutoff _) _
  calc
    ∑ n ∈ indices, ‖B.cutoff (s - n)‖ ^ (2 : Nat) =
        ∑ n ∈ S, ‖B.cutoff (s - n)‖ ^ (2 : Nat) := hsum
    _ ≤ S.card • (A ^ (2 : Nat)) := Finset.sum_le_card_nsmul S _ _ hterm
    _ ≤ 3 • (A ^ (2 : Nat)) := by
      gcongr
      exact scratch_active_vertical_indices_card_le_three B indices s
    _ = 3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat) := by
      simp only [nsmul_eq_mul, A]
      norm_num

private noncomputable def scratchVerticalProfile
    (B : ScratchVerticalCutoff) (scale : Real) (n : Int)
    (hscale : 0 < scale) : SchwartzMap Real Complex :=
  let root : Real := Real.sqrt scale
  let A : Real ≃L[Real] Real :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 root⁻¹ (by
        dsimp only [root]
        exact inv_ne_zero (Real.sqrt_ne_zero'.mpr hscale)))
  ((SchwartzMap.compCLMOfContinuousLinearEquiv Complex A) B.cutoff).compSubConstCLM
    Complex (root * n)

private theorem scratchVerticalProfile_apply
    (B : ScratchVerticalCutoff) (scale : Real) (n : Int)
    (hscale : 0 < scale) (tau : Real) :
    scratchVerticalProfile B scale n hscale tau =
      B.cutoff ((Real.sqrt scale)⁻¹ * tau - n) := by
  unfold scratchVerticalProfile
  dsimp
  change B.cutoff ((Real.sqrt scale)⁻¹ * (tau - Real.sqrt scale * n)) = _
  have hroot : Real.sqrt scale ≠ 0 := Real.sqrt_ne_zero'.mpr hscale
  field_simp [hroot]

private noncomputable def scratchVerticalJointMultiplier
    (m : SchwartzMap Real Complex) : JointWaveSpaceTime → Complex :=
  fun z => m z.snd

private theorem scratchVerticalJointMultiplier_hasTemperateGrowth
    (m : SchwartzMap Real Complex) :
    (scratchVerticalJointMultiplier m).HasTemperateGrowth := by
  change (m ∘ WithLp.sndL 2 Real (Euclidean 2) Real).HasTemperateGrowth
  exact m.hasTemperateGrowth.comp
    (WithLp.sndL 2 Real (Euclidean 2) Real).hasTemperateGrowth

private noncomputable def scratchApplyVerticalSpectrum
    (m : SchwartzMap Real Complex)
    (Q : SchwartzMap JointWaveSpaceTime Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  SchwartzMap.smulLeftCLM Complex (scratchVerticalJointMultiplier m) Q

private theorem scratchApplyVerticalSpectrum_apply
    (m : SchwartzMap Real Complex)
    (Q : SchwartzMap JointWaveSpaceTime Complex) (zeta : WaveSpaceTime) :
    scratchApplyVerticalSpectrum m Q (WithLp.toLp 2 zeta) =
      m zeta.2 * Q (WithLp.toLp 2 zeta) := by
  unfold scratchApplyVerticalSpectrum
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (scratchVerticalJointMultiplier_hasTemperateGrowth m)]
  unfold scratchVerticalJointMultiplier
  rfl

private theorem scratchApplyVerticalSpectrum_apply_joint
    (m : SchwartzMap Real Complex)
    (Q : SchwartzMap JointWaveSpaceTime Complex) (u : JointWaveSpaceTime) :
    scratchApplyVerticalSpectrum m Q u = m u.snd * Q u := by
  unfold scratchApplyVerticalSpectrum
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (scratchVerticalJointMultiplier_hasTemperateGrowth m)]
  unfold scratchVerticalJointMultiplier
  rfl

private noncomputable def scratchVerticalProjectionSpectrum
    (B : ScratchVerticalCutoff) (scale : Real) (n : Int)
    (hscale : 0 < scale) (G : SchwartzMap JointWaveSpaceTime Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  scratchApplyVerticalSpectrum (scratchVerticalProfile B scale n hscale)
    (FourierTransform.fourier G)

private theorem scratchVerticalProjectionSpectrum_apply
    (B : ScratchVerticalCutoff) (scale : Real) (n : Int)
    (hscale : 0 < scale) (G : SchwartzMap JointWaveSpaceTime Complex)
    (zeta : WaveSpaceTime) :
    scratchVerticalProjectionSpectrum B scale n hscale G (WithLp.toLp 2 zeta) =
      B.cutoff ((Real.sqrt scale)⁻¹ * zeta.2 - n) *
        FourierTransform.fourier (G : JointWaveSpaceTime → Complex) (WithLp.toLp 2 zeta) := by
  unfold scratchVerticalProjectionSpectrum
  rw [scratchApplyVerticalSpectrum_apply, scratchVerticalProfile_apply]
  simp only [SchwartzMap.fourier_coe]

private theorem scratchVerticalProjectionSpectrum_apply_joint
    (B : ScratchVerticalCutoff) (scale : Real) (n : Int)
    (hscale : 0 < scale) (G : SchwartzMap JointWaveSpaceTime Complex)
    (u : JointWaveSpaceTime) :
    scratchVerticalProjectionSpectrum B scale n hscale G u =
      B.cutoff ((Real.sqrt scale)⁻¹ * u.snd - n) *
        FourierTransform.fourier (G : JointWaveSpaceTime → Complex) u := by
  unfold scratchVerticalProjectionSpectrum
  rw [scratchApplyVerticalSpectrum_apply_joint, scratchVerticalProfile_apply]
  simp only [SchwartzMap.fourier_coe]

private noncomputable def scratchVerticalRecombinedSpectrum
    (B : ScratchVerticalCutoff) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) (H : Int → SchwartzMap JointWaveSpaceTime Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  ∑ n ∈ indices, scratchVerticalProjectionSpectrum B scale n hscale (H n)

private theorem scratch_spaceTimeFourierInv_jointSchwartzRaw_eq_jointSchwartzRaw_fourierInv
    (P : SchwartzMap JointWaveSpaceTime Complex) :
    spaceTimeFourierInv (jointSchwartzRaw P) =
      jointSchwartzRaw (FourierTransform.fourierInv P) := by
  funext z
  rw [spaceTimeFourierInv_jointSchwartzRaw]
  rw [← SchwartzMap.fourierInv_coe]
  rfl

private theorem scratch_integral_norm_sq_jointSchwartzRaw_eq
    (G : SchwartzMap JointWaveSpaceTime Complex) :
    (∫ z : WaveSpaceTime, ‖jointSchwartzRaw G z‖ ^ (2 : Nat)) =
      ∫ u : JointWaveSpaceTime, ‖G u‖ ^ (2 : Nat) := by
  let hpres : MeasurePreserving
      (MeasurableEquiv.toLp 2 WaveSpaceTime) volume volume :=
    WithLp.volume_preserving_toLp (Euclidean 2) Real
  have h := hpres.integral_comp' (fun u : JointWaveSpaceTime => ‖G u‖ ^ (2 : Nat))
  simpa only [jointSchwartzRaw, MeasurableEquiv.coe_toLp] using h

private theorem scratch_l2_frequency_pointwise
    (B : ScratchVerticalCutoff) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    (u : JointWaveSpaceTime) :
    ‖scratchVerticalRecombinedSpectrum B scale indices hscale H u‖ ^ (2 : Nat) ≤
      (3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat)) *
        ∑ n ∈ indices,
          ‖FourierTransform.fourier (H n : JointWaveSpaceTime → Complex) u‖ ^ (2 : Nat) := by
  classical
  have hsum_apply : scratchVerticalRecombinedSpectrum B scale indices hscale H u =
      ∑ n ∈ indices,
        B.cutoff ((Real.sqrt scale)⁻¹ * u.snd - n) *
          FourierTransform.fourier (H n : JointWaveSpaceTime → Complex) u := by
    unfold scratchVerticalRecombinedSpectrum
    rw [sum_apply]
    apply Finset.sum_congr rfl
    intro n hn
    exact scratchVerticalProjectionSpectrum_apply_joint B scale n hscale (H n) u
  rw [hsum_apply]
  have hnorm :
      ‖∑ n ∈ indices,
        B.cutoff ((Real.sqrt scale)⁻¹ * u.snd - n) *
          FourierTransform.fourier (H n : JointWaveSpaceTime → Complex) u‖ ≤
        Real.sqrt (∑ n ∈ indices,
          ‖B.cutoff ((Real.sqrt scale)⁻¹ * u.snd - n)‖ ^ (2 : Nat)) *
        Real.sqrt (∑ n ∈ indices,
          ‖FourierTransform.fourier (H n : JointWaveSpaceTime → Complex) u‖ ^ (2 : Nat)) := by
    calc
      ‖∑ n ∈ indices,
        B.cutoff ((Real.sqrt scale)⁻¹ * u.snd - n) *
          FourierTransform.fourier (H n : JointWaveSpaceTime → Complex) u‖ ≤
          ∑ n ∈ indices,
            ‖B.cutoff ((Real.sqrt scale)⁻¹ * u.snd - n) *
              FourierTransform.fourier (H n : JointWaveSpaceTime → Complex) u‖ :=
        norm_sum_le _ _
      _ = ∑ n ∈ indices,
          ‖B.cutoff ((Real.sqrt scale)⁻¹ * u.snd - n)‖ *
            ‖FourierTransform.fourier (H n : JointWaveSpaceTime → Complex) u‖ := by
          apply Finset.sum_congr rfl
          intro n hn
          rw [norm_mul]
      _ ≤ Real.sqrt (∑ n ∈ indices,
          ‖B.cutoff ((Real.sqrt scale)⁻¹ * u.snd - n)‖ ^ (2 : Nat)) *
        Real.sqrt (∑ n ∈ indices,
          ‖FourierTransform.fourier (H n : JointWaveSpaceTime → Complex) u‖ ^ (2 : Nat)) :=
          Real.sum_mul_le_sqrt_mul_sqrt _ _ _
  calc
    ‖∑ n ∈ indices,
        B.cutoff ((Real.sqrt scale)⁻¹ * u.snd - n) *
          FourierTransform.fourier (H n : JointWaveSpaceTime → Complex) u‖ ^ (2 : Nat) ≤
        (Real.sqrt (∑ n ∈ indices,
          ‖B.cutoff ((Real.sqrt scale)⁻¹ * u.snd - n)‖ ^ (2 : Nat)) *
        Real.sqrt (∑ n ∈ indices,
          ‖FourierTransform.fourier (H n : JointWaveSpaceTime → Complex) u‖ ^ (2 : Nat)) ) ^ (2 : Nat) :=
      (sq_le_sq₀ (norm_nonneg _) (mul_nonneg (Real.sqrt_nonneg _)
        (Real.sqrt_nonneg _))).mpr hnorm
    _ = (∑ n ∈ indices,
          ‖B.cutoff ((Real.sqrt scale)⁻¹ * u.snd - n)‖ ^ (2 : Nat)) *
        ∑ n ∈ indices,
          ‖FourierTransform.fourier (H n : JointWaveSpaceTime → Complex) u‖ ^ (2 : Nat) := by
      rw [mul_pow,
        Real.sq_sqrt (Finset.sum_nonneg fun _ _ => sq_nonneg _),
        Real.sq_sqrt (Finset.sum_nonneg fun _ _ => sq_nonneg _)]
    _ ≤ (3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat)) *
        ∑ n ∈ indices,
          ‖FourierTransform.fourier (H n : JointWaveSpaceTime → Complex) u‖ ^ (2 : Nat) :=
      mul_le_mul_of_nonneg_right
        (scratch_vertical_square_overlap_le B indices ((Real.sqrt scale)⁻¹ * u.snd))
        (Finset.sum_nonneg fun _ _ => sq_nonneg _)

private theorem scratch_integral_norm_sq_inverse_verticalRecombinedSpectrum_le
    (B : ScratchVerticalCutoff) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) (H : Int → SchwartzMap JointWaveSpaceTime Complex) :
    (∫ z : WaveSpaceTime,
      ‖spaceTimeFourierInv
        (jointSchwartzRaw (scratchVerticalRecombinedSpectrum B scale indices hscale H)) z‖
          ^ (2 : Nat)) ≤
      (3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat)) *
        ∑ n ∈ indices, ∫ z : WaveSpaceTime, ‖jointSchwartzRaw (H n) z‖ ^ (2 : Nat) := by
  classical
  let P : SchwartzMap JointWaveSpaceTime Complex :=
    scratchVerticalRecombinedSpectrum B scale indices hscale H
  let out : SchwartzMap JointWaveSpaceTime Complex := FourierTransform.fourierInv P
  let C : Real := 3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat)
  have hphysical :
      spaceTimeFourierInv (jointSchwartzRaw P) = jointSchwartzRaw out := by
    exact scratch_spaceTimeFourierInv_jointSchwartzRaw_eq_jointSchwartzRaw_fourierInv P
  have hP_integrable : Integrable (fun u : JointWaveSpaceTime => ‖P u‖ ^ (2 : Nat)) volume :=
    (memLp_two_iff_integrable_sq_norm P.continuous.aestronglyMeasurable).mp
      (P.memLp 2 volume)
  have hH_integrable (n : Int) :
      Integrable (fun u : JointWaveSpaceTime =>
        ‖FourierTransform.fourier (H n : JointWaveSpaceTime → Complex) u‖ ^ (2 : Nat)) volume := by
    rw [← SchwartzMap.fourier_coe]
    exact (memLp_two_iff_integrable_sq_norm
      (FourierTransform.fourier (H n)).continuous.aestronglyMeasurable).mp
      ((FourierTransform.fourier (H n)).memLp 2 volume)
  have hright_integrable : Integrable (fun u : JointWaveSpaceTime =>
      C * ∑ n ∈ indices,
        ‖FourierTransform.fourier (H n : JointWaveSpaceTime → Complex) u‖ ^ (2 : Nat)) volume :=
    (integrable_finsetSum indices (fun n _ => hH_integrable n)).const_mul C
  have hsum_apply (u : JointWaveSpaceTime) :
      P u = ∑ n ∈ indices,
        scratchVerticalProjectionSpectrum B scale n hscale (H n) u := by
    dsimp [P, scratchVerticalRecombinedSpectrum]
    rw [sum_apply]
  have hpoint (u : JointWaveSpaceTime) :
      ‖P u‖ ^ (2 : Nat) ≤ C * ∑ n ∈ indices,
        ‖FourierTransform.fourier (H n : JointWaveSpaceTime → Complex) u‖ ^ (2 : Nat) := by
    dsimp [C]
    exact scratch_l2_frequency_pointwise B scale indices hscale H u
  calc
    (∫ z : WaveSpaceTime,
      ‖spaceTimeFourierInv (jointSchwartzRaw
        (scratchVerticalRecombinedSpectrum B scale indices hscale H)) z‖ ^ (2 : Nat)) =
        ∫ u : JointWaveSpaceTime, ‖out u‖ ^ (2 : Nat) := by
      change (∫ z : WaveSpaceTime, ‖spaceTimeFourierInv (jointSchwartzRaw P) z‖ ^ (2 : Nat)) = _
      rw [hphysical]
      exact scratch_integral_norm_sq_jointSchwartzRaw_eq out
    _ = ∫ u : JointWaveSpaceTime,
        ‖FourierTransform.fourier (out : JointWaveSpaceTime → Complex) u‖ ^ (2 : Nat) :=
      (FourierRadius.integral_norm_sq_fourier_schwartz_eq out).symm
    _ = ∫ u : JointWaveSpaceTime, ‖P u‖ ^ (2 : Nat) := by
      apply integral_congr_ae
      filter_upwards with u
      rw [← SchwartzMap.fourier_coe]
      change ‖(FourierTransform.fourier out : SchwartzMap JointWaveSpaceTime Complex) u‖ ^
          (2 : Nat) = _
      rw [show FourierTransform.fourier out = P by
        dsimp only [out]
        exact FourierTransform.fourier_fourierInv_eq _]
    _ ≤ ∫ u : JointWaveSpaceTime, C * ∑ n ∈ indices,
        ‖FourierTransform.fourier (H n : JointWaveSpaceTime → Complex) u‖ ^ (2 : Nat) :=
      integral_mono hP_integrable hright_integrable hpoint
    _ = C * ∑ n ∈ indices, ∫ u : JointWaveSpaceTime,
        ‖FourierTransform.fourier (H n : JointWaveSpaceTime → Complex) u‖ ^ (2 : Nat) := by
      rw [integral_const_mul, integral_finsetSum indices (fun n _ => hH_integrable n)]
    _ = C * ∑ n ∈ indices, ∫ u : JointWaveSpaceTime, ‖H n u‖ ^ (2 : Nat) := by
      congr 1
      apply Finset.sum_congr rfl
      intro n hn
      exact FourierRadius.integral_norm_sq_fourier_schwartz_eq (H n)
    _ = (3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat)) *
        ∑ n ∈ indices, ∫ z : WaveSpaceTime, ‖jointSchwartzRaw (H n) z‖ ^ (2 : Nat) := by
      dsimp [C]
      congr 1
      apply Finset.sum_congr rfl
      intro n hn
      exact (scratch_integral_norm_sq_jointSchwartzRaw_eq (H n)).symm

private theorem scratch_jointSchwartzRaw_eq_inverse_fourier
    (G : SchwartzMap JointWaveSpaceTime Complex) :
    jointSchwartzRaw G =
      spaceTimeFourierInv (jointSchwartzRaw (FourierTransform.fourier G)) := by
  funext z
  rw [spaceTimeFourierInv_jointSchwartzRaw]
  change G (WithLp.toLp 2 z) = FourierTransform.fourierInv
      (FourierTransform.fourier (G : JointWaveSpaceTime → Complex))
      (WithLp.toLp 2 z)
  symm
  have hfourier :
      (FourierTransform.fourierInv (FourierTransform.fourier G) :
        SchwartzMap JointWaveSpaceTime Complex) = G :=
    FourierTransform.fourierInv_fourier_eq G
  have h := congrArg
    (fun Q : SchwartzMap JointWaveSpaceTime Complex => Q (WithLp.toLp 2 z))
    hfourier
  simpa only [SchwartzMap.fourierInv_coe, SchwartzMap.fourier_coe] using h

private theorem scratch_verticalProjection_eq_inverse_jointSpectrum
    (B : ScratchVerticalCutoff) (scale : Real) (n : Int)
    (m : SchwartzMap Real Complex)
    (Q : SchwartzMap JointWaveSpaceTime Complex)
    (hprofile : ∀ tau : Real,
      m tau = B.cutoff ((Real.sqrt scale)⁻¹ * tau - n)) :
    verticalProjection (B.cutoff : Real → Complex) scale n
        (spaceTimeFourierInv (jointSchwartzRaw Q)) =
      spaceTimeFourierInv (jointSchwartzRaw (scratchApplyVerticalSpectrum m Q)) := by
  have hmult :
      (fun zeta : WaveSpaceTime =>
        verticalMultiplier (B.cutoff : Real → Complex) scale n zeta *
          spaceTimeFourier (spaceTimeFourierInv (jointSchwartzRaw Q)) zeta) =
        jointSchwartzRaw (scratchApplyVerticalSpectrum m Q) := by
    funext zeta
    rw [spaceTimeFourier_spaceTimeFourierInv_jointSchwartzRaw Q zeta]
    change verticalMultiplier (B.cutoff : Real → Complex) scale n zeta *
        Q (WithLp.toLp 2 zeta) =
      scratchApplyVerticalSpectrum m Q (WithLp.toLp 2 zeta)
    rw [scratchApplyVerticalSpectrum_apply]
    rw [hprofile zeta.2]
    rfl
  unfold verticalProjection
  rw [hmult]

private theorem scratch_verticalProjection_jointSchwartzRaw_eq_inverse_spectrum
    (B : ScratchVerticalCutoff) (scale : Real) (n : Int)
    (hscale : 0 < scale) (G : SchwartzMap JointWaveSpaceTime Complex) :
    verticalProjection (B.cutoff : Real → Complex) scale n (jointSchwartzRaw G) =
      spaceTimeFourierInv
        (jointSchwartzRaw (scratchVerticalProjectionSpectrum B scale n hscale G)) := by
  rw [scratch_jointSchwartzRaw_eq_inverse_fourier G]
  exact scratch_verticalProjection_eq_inverse_jointSpectrum B scale n
    (scratchVerticalProfile B scale n hscale) (FourierTransform.fourier G)
    (fun tau => scratchVerticalProfile_apply B scale n hscale tau)

private theorem scratch_verticalRecombined_jointSchwartzRaw_eq_inverse_spectrum
    (B : ScratchVerticalCutoff) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) (H : Int → SchwartzMap JointWaveSpaceTime Complex) :
    verticalRecombined (B.cutoff : Real → Complex) scale indices
      (fun n => jointSchwartzRaw (H n)) =
      spaceTimeFourierInv
        (jointSchwartzRaw (scratchVerticalRecombinedSpectrum B scale indices hscale H)) := by
  funext z
  unfold verticalRecombined scratchVerticalRecombinedSpectrum
  simp_rw [scratch_verticalProjection_jointSchwartzRaw_eq_inverse_spectrum B scale _ hscale]
  rw [spaceTimeFourierInv_jointSchwartzRaw]
  rw [← SchwartzMap.fourierInv_coe]
  rw [FourierTransform.fourierInv_sum]
  simp_rw [spaceTimeFourierInv_jointSchwartzRaw]
  simp_rw [← SchwartzMap.fourierInv_coe]
  change (∑ n ∈ indices,
      (FourierTransform.fourierInv
        (scratchVerticalProjectionSpectrum B scale n hscale (H n)) :
          SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 z)) = _
  change (∑ n ∈ indices,
      (FourierTransform.fourierInv
        (scratchVerticalProjectionSpectrum B scale n hscale (H n)) :
          SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 z)) =
    (FunLike.coeAddMonoidHom
      (SchwartzMap JointWaveSpaceTime Complex)
      JointWaveSpaceTime Complex)
      (∑ n ∈ indices, FourierTransform.fourierInv
        (scratchVerticalProjectionSpectrum B scale n hscale (H n)))
      (WithLp.toLp 2 z)
  rw [map_sum, Finset.sum_apply]
  rfl

private theorem scratch_integral_norm_sq_verticalRecombined_jointSchwartzRaw_le
    (B : ScratchVerticalCutoff) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) (H : Int → SchwartzMap JointWaveSpaceTime Complex) :
    (∫ z : WaveSpaceTime,
      ‖verticalRecombined (B.cutoff : Real → Complex) scale indices
        (fun n => jointSchwartzRaw (H n)) z‖ ^ (2 : Nat)) ≤
      (3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat)) *
        ∑ n ∈ indices, ∫ z : WaveSpaceTime, ‖jointSchwartzRaw (H n) z‖ ^ (2 : Nat) := by
  rw [scratch_verticalRecombined_jointSchwartzRaw_eq_inverse_spectrum B scale indices hscale H]
  exact scratch_integral_norm_sq_inverse_verticalRecombinedSpectrum_le B scale indices hscale H

private theorem scratch_integral_sq_verticalSquareFunction_eq_sum
    (indices : Finset Int) (H : Int → SchwartzMap JointWaveSpaceTime Complex) :
    (∫ z : WaveSpaceTime,
      (verticalSquareFunction indices (fun n => jointSchwartzRaw (H n)) z) ^ (2 : Nat)) =
        ∑ n ∈ indices, ∫ z : WaveSpaceTime, ‖jointSchwartzRaw (H n) z‖ ^ (2 : Nat) := by
  have hH_integrable (n : Int) :
      Integrable (fun z : WaveSpaceTime => ‖jointSchwartzRaw (H n) z‖ ^ (2 : Nat)) volume := by
    rw [show (fun z : WaveSpaceTime => ‖jointSchwartzRaw (H n) z‖ ^ (2 : Nat)) =
      fun z : WaveSpaceTime => ‖H n (WithLp.toLp 2 z)‖ ^ (2 : Nat) by rfl]
    let hpres : MeasurePreserving
        (MeasurableEquiv.toLp 2 WaveSpaceTime) volume volume :=
      WithLp.volume_preserving_toLp (Euclidean 2) Real
    have hcomp : Integrable (fun u : JointWaveSpaceTime => ‖H n u‖ ^ (2 : Nat)) volume :=
      (memLp_two_iff_integrable_sq_norm (H n).continuous.aestronglyMeasurable).mp
        ((H n).memLp 2 volume)
    exact (hpres.integrable_comp_emb
      (MeasurableEquiv.toLp 2 WaveSpaceTime).measurableEmbedding).mpr hcomp
  rw [show (fun z : WaveSpaceTime =>
      (verticalSquareFunction indices (fun n => jointSchwartzRaw (H n)) z) ^ (2 : Nat)) =
      fun z : WaveSpaceTime => ∑ n ∈ indices, ‖jointSchwartzRaw (H n) z‖ ^ (2 : Nat) by
        funext z
        unfold verticalSquareFunction
        rw [Real.sq_sqrt (Finset.sum_nonneg fun _ _ => sq_nonneg _)]]
  exact integral_finsetSum indices (fun n _ => hH_integrable n)

theorem scratch_integral_norm_sq_verticalRecombined_le_squareFunction
    (B : ScratchVerticalCutoff) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) (H : Int → SchwartzMap JointWaveSpaceTime Complex) :
    (∫ z : WaveSpaceTime,
      ‖verticalRecombined (B.cutoff : Real → Complex) scale indices
        (fun n => jointSchwartzRaw (H n)) z‖ ^ (2 : Nat)) ≤
      (3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat)) *
        ∫ z : WaveSpaceTime,
          (verticalSquareFunction indices (fun n => jointSchwartzRaw (H n)) z) ^ (2 : Nat) := by
  rw [scratch_integral_sq_verticalSquareFunction_eq_sum]
  exact scratch_integral_norm_sq_verticalRecombined_jointSchwartzRaw_le
    B scale indices hscale H

private theorem scratch_lintegral_ofReal_norm_rpow_two_eq_of_integrable
    {X E : Type*} [MeasurableSpace X] [NormedAddCommGroup E]
    {f : X → E} {μ : Measure X}
    (hf : Integrable (fun x => ‖f x‖ ^ (2 : Nat)) μ) :
    (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ (2 : Real) ∂μ) =
      ENNReal.ofReal (∫ x, ‖f x‖ ^ (2 : Nat) ∂μ) := by
  symm
  calc
    ENNReal.ofReal (∫ x, ‖f x‖ ^ (2 : Nat) ∂μ) =
        ENNReal.ofReal (∫ x, ‖(‖f x‖ ^ (2 : Nat) : Real)‖ ∂μ) := by
      congr 2
      funext x
      rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
    _ = ∫⁻ x, ‖(‖f x‖ ^ (2 : Nat) : Real)‖ₑ ∂μ :=
      ofReal_integral_norm_eq_lintegral_enorm hf
    _ = ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ (2 : Real) ∂μ := by
      apply lintegral_congr
      intro x
      rw [Real.enorm_eq_ofReal (sq_nonneg _), ENNReal.ofReal_pow (norm_nonneg _)]
      norm_num

private theorem scratch_weak_two_of_strong_integral
    (O : WaveSpaceTime → Complex) (S : WaveSpaceTime → Real)
    (hOmeas : AEMeasurable O volume)
    (hOint : Integrable (fun z => ‖O z‖ ^ (2 : Nat)) volume)
    (hSint : Integrable (fun z => S z ^ (2 : Nat)) volume)
    (hSnonneg : ∀ z, 0 ≤ S z)
    {C : Real} (hC : 0 ≤ C)
    (hstrong : (∫ z : WaveSpaceTime, ‖O z‖ ^ (2 : Nat)) ≤
      C * ∫ z : WaveSpaceTime, S z ^ (2 : Nat))
    {s : Real} (_hs : 0 < s) :
    (ENNReal.ofReal s) ^ (2 : Real) * volume {z | s < ‖O z‖} ≤
      ENNReal.ofReal C *
        ∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (2 : Real) := by
  have hsub : {z | s < ‖O z‖} ⊆
      {z | (ENNReal.ofReal s) ^ (2 : Real) ≤
        (ENNReal.ofReal ‖O z‖) ^ (2 : Real)} := by
    intro z hz
    exact ENNReal.rpow_le_rpow
      (ENNReal.ofReal_le_ofReal hz.le) (by norm_num)
  have hmomentO :
      (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal ‖O z‖) ^ (2 : Real)) =
        ENNReal.ofReal (∫ z : WaveSpaceTime, ‖O z‖ ^ (2 : Nat)) :=
    scratch_lintegral_ofReal_norm_rpow_two_eq_of_integrable hOint
  have hmomentS :
      (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (2 : Real)) =
        ENNReal.ofReal (∫ z : WaveSpaceTime, S z ^ (2 : Nat)) := by
    have hSint' : Integrable (fun z : WaveSpaceTime => ‖S z‖ ^ (2 : Nat)) volume := by
      convert hSint using 1
      funext z
      rw [Real.norm_eq_abs, abs_of_nonneg (hSnonneg z)]
    calc
      (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (2 : Real)) =
          ∫⁻ z : WaveSpaceTime, (ENNReal.ofReal ‖S z‖) ^ (2 : Real) := by
        apply lintegral_congr
        intro z
        rw [Real.norm_eq_abs, abs_of_nonneg (hSnonneg z)]
      _ = ENNReal.ofReal (∫ z : WaveSpaceTime, ‖S z‖ ^ (2 : Nat)) :=
        scratch_lintegral_ofReal_norm_rpow_two_eq_of_integrable hSint'
      _ = ENNReal.ofReal (∫ z : WaveSpaceTime, S z ^ (2 : Nat)) := by
        congr 2
        funext z
        rw [Real.norm_eq_abs, abs_of_nonneg (hSnonneg z)]
  calc
    (ENNReal.ofReal s) ^ (2 : Real) * volume {z | s < ‖O z‖} ≤
        (ENNReal.ofReal s) ^ (2 : Real) *
          volume {z | (ENNReal.ofReal s) ^ (2 : Real) ≤
            (ENNReal.ofReal ‖O z‖) ^ (2 : Real)} := by
      have hmeasure :
          volume {z : WaveSpaceTime | s < ‖O z‖} ≤
            volume {z : WaveSpaceTime | (ENNReal.ofReal s) ^ (2 : Real) ≤
              (ENNReal.ofReal ‖O z‖) ^ (2 : Real)} :=
        measure_mono hsub
      calc
        (ENNReal.ofReal s) ^ (2 : Real) * volume {z | s < ‖O z‖} =
            volume {z : WaveSpaceTime | s < ‖O z‖} * (ENNReal.ofReal s) ^ (2 : Real) := by
              ac_rfl
        _ ≤ volume {z : WaveSpaceTime | (ENNReal.ofReal s) ^ (2 : Real) ≤
            (ENNReal.ofReal ‖O z‖) ^ (2 : Real)} * (ENNReal.ofReal s) ^ (2 : Real) :=
              by simpa only [mul_comm] using
                (mul_le_mul_right hmeasure ((ENNReal.ofReal s) ^ (2 : Real)))
        _ = (ENNReal.ofReal s) ^ (2 : Real) *
            volume {z : WaveSpaceTime | (ENNReal.ofReal s) ^ (2 : Real) ≤
              (ENNReal.ofReal ‖O z‖) ^ (2 : Real)} := by ac_rfl
    _ ≤ ∫⁻ z : WaveSpaceTime, (ENNReal.ofReal ‖O z‖) ^ (2 : Real) := by
      exact mul_meas_ge_le_lintegral₀
        (ENNReal.continuous_rpow_const.measurable.comp_aemeasurable
          (hOmeas.norm.ennreal_ofReal)) _
    _ = ENNReal.ofReal (∫ z : WaveSpaceTime, ‖O z‖ ^ (2 : Nat)) := hmomentO
    _ ≤ ENNReal.ofReal (C * ∫ z : WaveSpaceTime, S z ^ (2 : Nat)) :=
      ENNReal.ofReal_le_ofReal hstrong
    _ = ENNReal.ofReal C *
        ENNReal.ofReal (∫ z : WaveSpaceTime, S z ^ (2 : Nat)) :=
      ENNReal.ofReal_mul hC
    _ = ENNReal.ofReal C *
        ∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (2 : Real) := by
      rw [hmomentS]

theorem scratch_verticalRecombined_weak_two
    (B : ScratchVerticalCutoff) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    {s : Real} (hs : 0 < s) :
    (ENNReal.ofReal s) ^ (2 : Real) *
        volume {z | s < ‖verticalRecombined (B.cutoff : Real → Complex) scale indices
          (fun n => jointSchwartzRaw (H n)) z‖} ≤
      ENNReal.ofReal (3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat)) *
        ∫⁻ z : WaveSpaceTime,
          (ENNReal.ofReal
            (verticalSquareFunction indices (fun n => jointSchwartzRaw (H n)) z)) ^ (2 : Real) := by
  let P : SchwartzMap JointWaveSpaceTime Complex :=
    scratchVerticalRecombinedSpectrum B scale indices hscale H
  let O : WaveSpaceTime → Complex :=
    verticalRecombined (B.cutoff : Real → Complex) scale indices
      (fun n => jointSchwartzRaw (H n))
  let S : WaveSpaceTime → Real :=
    verticalSquareFunction indices (fun n => jointSchwartzRaw (H n))
  let C : Real := 3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat)
  have hOeq : O = spaceTimeFourierInv (jointSchwartzRaw P) := by
    exact scratch_verticalRecombined_jointSchwartzRaw_eq_inverse_spectrum
      B scale indices hscale H
  have hOeq' : O = jointSchwartzRaw (FourierTransform.fourierInv P) := by
    rw [hOeq]
    exact scratch_spaceTimeFourierInv_jointSchwartzRaw_eq_jointSchwartzRaw_fourierInv P
  have hOmeas : AEMeasurable O volume := by
    rw [hOeq']
    exact ((FourierTransform.fourierInv P).continuous.measurable.comp
      (WithLp.measurable_toLp 2 WaveSpaceTime)).aemeasurable
  have hOint : Integrable (fun z : WaveSpaceTime => ‖O z‖ ^ (2 : Nat)) volume := by
    rw [hOeq']
    rw [show (fun z : WaveSpaceTime =>
        ‖jointSchwartzRaw (FourierTransform.fourierInv P) z‖ ^ (2 : Nat)) =
      fun z : WaveSpaceTime =>
        ‖(FourierTransform.fourierInv P) (WithLp.toLp 2 z)‖ ^ (2 : Nat) by rfl]
    let hpres : MeasurePreserving
        (MeasurableEquiv.toLp 2 WaveSpaceTime) volume volume :=
      WithLp.volume_preserving_toLp (Euclidean 2) Real
    have hint : Integrable (fun u : JointWaveSpaceTime =>
        ‖(FourierTransform.fourierInv P) u‖ ^ (2 : Nat)) volume :=
      (memLp_two_iff_integrable_sq_norm
        (FourierTransform.fourierInv P).continuous.aestronglyMeasurable).mp
        ((FourierTransform.fourierInv P).memLp 2 volume)
    exact (hpres.integrable_comp_emb
      (MeasurableEquiv.toLp 2 WaveSpaceTime).measurableEmbedding).mpr hint
  have hSint : Integrable (fun z : WaveSpaceTime => S z ^ (2 : Nat)) volume := by
    rw [show (fun z : WaveSpaceTime => S z ^ (2 : Nat)) =
      fun z : WaveSpaceTime => ∑ n ∈ indices,
        ‖jointSchwartzRaw (H n) z‖ ^ (2 : Nat) by
      funext z
      dsimp [S]
      unfold verticalSquareFunction
      rw [Real.sq_sqrt (Finset.sum_nonneg fun _ _ => sq_nonneg _)]]
    apply integrable_finsetSum
    intro n hn
    rw [show (fun z : WaveSpaceTime => ‖jointSchwartzRaw (H n) z‖ ^ (2 : Nat)) =
      fun z : WaveSpaceTime => ‖H n (WithLp.toLp 2 z)‖ ^ (2 : Nat) by rfl]
    let hpres : MeasurePreserving
        (MeasurableEquiv.toLp 2 WaveSpaceTime) volume volume :=
      WithLp.volume_preserving_toLp (Euclidean 2) Real
    have hint : Integrable (fun u : JointWaveSpaceTime => ‖H n u‖ ^ (2 : Nat)) volume :=
      (memLp_two_iff_integrable_sq_norm (H n).continuous.aestronglyMeasurable).mp
        ((H n).memLp 2 volume)
    exact (hpres.integrable_comp_emb
      (MeasurableEquiv.toLp 2 WaveSpaceTime).measurableEmbedding).mpr hint
  have hSnonneg : ∀ z, 0 ≤ S z := by
    intro z
    dsimp [S]
    exact verticalSquareFunction_nonneg indices _ z
  have hC : 0 ≤ C := by
    dsimp [C]
    positivity
  have hstrong : (∫ z : WaveSpaceTime, ‖O z‖ ^ (2 : Nat)) ≤
      C * ∫ z : WaveSpaceTime, S z ^ (2 : Nat) := by
    dsimp [O, S, C]
    exact scratch_integral_norm_sq_verticalRecombined_le_squareFunction
      B scale indices hscale H
  simpa only [O, S, C] using
    (scratch_weak_two_of_strong_integral O S hOmeas hOint hSint hSnonneg hC hstrong hs)

noncomputable def scratchJointBundle
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex) :
    JointWaveSpaceTime → PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex) :=
  fun u => WithLp.toLp 2 (fun i : (↥indices) => H (i : Int) u)

private theorem scratch_verticalSquareFunction_eq_jointBundle_comp
    (indices : Finset Int) (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    (z : WaveSpaceTime) :
    verticalSquareFunction indices (fun n => jointSchwartzRaw (H n)) z =
      ‖scratchJointBundle indices H (WithLp.toLp 2 z)‖ := by
  rw [verticalSquareFunction_eq_norm_piLp]
  rfl

private theorem scratch_lintegral_squareFunction_eq_jointBundle
    (indices : Finset Int) (H : Int → SchwartzMap JointWaveSpaceTime Complex) :
    (∫⁻ z : WaveSpaceTime,
      (ENNReal.ofReal
        (verticalSquareFunction indices (fun n => jointSchwartzRaw (H n)) z)) ^ (2 : Real)) =
      ∫⁻ u : JointWaveSpaceTime,
        (ENNReal.ofReal ‖scratchJointBundle indices H u‖) ^ (2 : Real) := by
  let hpres : MeasurePreserving
      (MeasurableEquiv.toLp 2 WaveSpaceTime) volume volume :=
    WithLp.volume_preserving_toLp (Euclidean 2) Real
  have hmeas : Measurable (fun u : JointWaveSpaceTime =>
      (ENNReal.ofReal ‖scratchJointBundle indices H u‖) ^ (2 : Real)) := by
    unfold scratchJointBundle
    fun_prop
  calc
    (∫⁻ z : WaveSpaceTime,
      (ENNReal.ofReal
        (verticalSquareFunction indices (fun n => jointSchwartzRaw (H n)) z)) ^ (2 : Real)) =
      ∫⁻ z : WaveSpaceTime,
        (ENNReal.ofReal ‖scratchJointBundle indices H (WithLp.toLp 2 z)‖) ^ (2 : Real) := by
      apply lintegral_congr
      intro z
      rw [scratch_verticalSquareFunction_eq_jointBundle_comp]
    _ = ∫⁻ u : JointWaveSpaceTime,
        (ENNReal.ofReal ‖scratchJointBundle indices H u‖) ^ (2 : Real) := by
      exact hpres.lintegral_comp hmeas

theorem scratch_verticalRecombined_weak_two_jointBundle
    (B : ScratchVerticalCutoff) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    {s : Real} (hs : 0 < s) :
    (ENNReal.ofReal s) ^ (2 : Real) *
        volume {z | s < ‖verticalRecombined (B.cutoff : Real → Complex) scale indices
          (fun n => jointSchwartzRaw (H n)) z‖} ≤
      ENNReal.ofReal (3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat)) *
        ∫⁻ u : JointWaveSpaceTime,
          (ENNReal.ofReal ‖scratchJointBundle indices H u‖) ^ (2 : Real) := by
  rw [← scratch_lintegral_squareFunction_eq_jointBundle]
  exact scratch_verticalRecombined_weak_two B scale indices hscale H hs
namespace SmoothSplit

private abbrev Bundle (indices : Finset Int) :=
  PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex)

private noncomputable def bundle
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex) :
    JointWaveSpaceTime → Bundle indices :=
  fun z => WithLp.toLp 2 (fun i : (↥indices) => H (i : Int) z)

private noncomputable def coordInjection
    {indices : Finset Int} (i : (↥indices)) : Complex →L[Real] Bundle indices :=
  (WithLp.linearEquiv 2 Real (∀ _ : (↥indices), Complex)).symm.toContinuousLinearMap.comp
    (ContinuousLinearMap.single Real (fun _ : (↥indices) => Complex) i)

private theorem bundle_eq_sum
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex) (z : JointWaveSpaceTime) :
    bundle indices H z = ∑ i : (↥indices), coordInjection i (H (i : Int) z) := by
  apply PiLp.ext
  intro j
  simp [bundle, coordInjection]

private theorem bundle_hasTemperateGrowth
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex) :
    (bundle indices H).HasTemperateGrowth := by
  rw [show bundle indices H = fun z => ∑ i : (↥indices),
      coordInjection i (H (i : Int) z) by
    funext z
    exact bundle_eq_sum indices H z]
  apply Function.HasTemperateGrowth.sum
  intro i hi
  exact (coordInjection i).hasTemperateGrowth.comp (H (i : Int)).hasTemperateGrowth

private noncomputable def splitBump
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    (t : Real) : JointWaveSpaceTime → Complex :=
  let E := Bundle indices
  let η : ContDiffBump (0 : E) :=
    ⟨(1 : Real) / 4, (1 : Real) / 2, by norm_num, by norm_num⟩
  fun z => ((η ((t⁻¹ : Real) • bundle indices H z) : Real) : Complex)

private theorem splitBump_hasTemperateGrowth
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    (t : Real) :
    (splitBump indices H t).HasTemperateGrowth := by
  let E := Bundle indices
  let η : ContDiffBump (0 : E) :=
    ⟨(1 : Real) / 4, (1 : Real) / 2, by norm_num, by norm_num⟩
  let b : E → Complex := Complex.ofRealCLM ∘ η
  have hbcompact : HasCompactSupport b := by
    exact η.hasCompactSupport.comp_left (by rfl)
  have hbsmooth : ContDiff Real (⊤ : ℕ∞) b := by
    exact Complex.ofRealCLM.contDiff.comp η.contDiff
  have hb : b.HasTemperateGrowth := hbcompact.hasTemperateGrowth hbsmooth
  let A : E →L[Real] E := (t⁻¹ : Real) • ContinuousLinearMap.id Real E
  have hA : (A : E → E).HasTemperateGrowth := A.hasTemperateGrowth
  have hAB : ((A : E → E) ∘ bundle indices H).HasTemperateGrowth :=
    hA.comp (bundle_hasTemperateGrowth indices H)
  change (fun z => b (A (bundle indices H z))).HasTemperateGrowth
  exact hb.comp hAB

private noncomputable def low
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    (t : Real) (n : Int) : SchwartzMap JointWaveSpaceTime Complex :=
  if n ∈ indices then
    SchwartzMap.smulLeftCLM Complex (splitBump indices H t) (H n)
  else H n

private noncomputable def high
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    (t : Real) (n : Int) : SchwartzMap JointWaveSpaceTime Complex :=
  H n - low indices H t n

private theorem low_apply_of_mem
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    (t : Real) {n : Int} (hn : n ∈ indices) (z : JointWaveSpaceTime) :
    low indices H t n z = splitBump indices H t z * H n z := by
  simp only [low, hn, ↓reduceIte]
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (splitBump_hasTemperateGrowth indices H t)]
  rfl

private theorem high_apply_of_mem
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    (t : Real) {n : Int} (hn : n ∈ indices) (z : JointWaveSpaceTime) :
    high indices H t n z = (1 - splitBump indices H t z) * H n z := by
  unfold high
  rw [sub_apply, low_apply_of_mem indices H t hn]
  ring

private theorem low_high_split
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    (t : Real) (n : Int) :
    H n = low indices H t n + high indices H t n := by
  unfold high
  abel

private theorem low_bundle_eq_smul
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    (t : Real) (z : JointWaveSpaceTime) :
    WithLp.toLp 2 (fun i : (↥indices) => low indices H t (i : Int) z) =
      splitBump indices H t z • bundle indices H z := by
  apply PiLp.ext
  intro i
  change low indices H t (i : Int) z = _
  rw [low_apply_of_mem indices H t i.property]
  rfl

private theorem high_bundle_eq_smul
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    (t : Real) (z : JointWaveSpaceTime) :
    WithLp.toLp 2 (fun i : (↥indices) => high indices H t (i : Int) z) =
      (1 - splitBump indices H t z) • bundle indices H z := by
  apply PiLp.ext
  intro i
  change high indices H t (i : Int) z = _
  rw [high_apply_of_mem indices H t i.property]
  rfl

private theorem splitBump_nonneg
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    (t : Real) (z : JointWaveSpaceTime) :
    0 ≤ (splitBump indices H t z).re := by
  unfold splitBump
  dsimp
  exact ContDiffBump.nonneg _

private theorem splitBump_re_le_one
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    (t : Real) (z : JointWaveSpaceTime) :
    (splitBump indices H t z).re ≤ 1 := by
  unfold splitBump
  dsimp
  exact ContDiffBump.le_one _

private theorem low_bundle_norm_le_half
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    {t : Real} (ht : 0 < t) (z : JointWaveSpaceTime) :
    ‖WithLp.toLp 2 (fun i : (↥indices) => low indices H t (i : Int) z)‖ ≤
      t / 2 := by
  let E := Bundle indices
  let η : ContDiffBump (0 : E) :=
    ⟨(1 : Real) / 4, (1 : Real) / 2, by norm_num, by norm_num⟩
  let y : E := (t⁻¹ : Real) • bundle indices H z
  have hη : η y = (splitBump indices H t z).re := by rfl
  have hc : splitBump indices H t z = ((η y : Real) : Complex) := by rfl
  rw [low_bundle_eq_smul]
  by_cases hzero : η y = 0
  · rw [hc, hzero]
    simp
    positivity
  · have hy : ‖y‖ < (1 : Real) / 2 := by
      have hdist : dist y 0 < η.rOut := by
        apply lt_of_not_ge
        intro h
        exact hzero (η.zero_of_le_dist h)
      simpa [η, dist_zero_right] using hdist
    have hnorm : ‖y‖ = ‖bundle indices H z‖ / t := by
      dsimp [y]
      rw [norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos ht]
      ring
    have hH : ‖bundle indices H z‖ < t / 2 := by
      rw [hnorm] at hy
      have h := (div_lt_iff₀ ht).mp (by simpa using hy)
      simpa [div_eq_mul_inv, mul_comm] using h
    rw [norm_smul, hc, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg η.nonneg]
    calc
      (splitBump indices H t z).re * ‖bundle indices H z‖ ≤
          1 * ‖bundle indices H z‖ :=
        mul_le_mul_of_nonneg_right
          (splitBump_re_le_one indices H t z) (norm_nonneg _)
      _ = ‖bundle indices H z‖ := one_mul _
      _ ≤ t / 2 := hH.le

private theorem high_bundle_eq_zero_of_norm_le_quarter
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    {t : Real} (ht : 0 < t) (z : JointWaveSpaceTime)
    (hz : ‖bundle indices H z‖ ≤ t / 4) :
    WithLp.toLp 2 (fun i : (↥indices) => high indices H t (i : Int) z) = 0 := by
  let E := Bundle indices
  let η : ContDiffBump (0 : E) :=
    ⟨(1 : Real) / 4, (1 : Real) / 2, by norm_num, by norm_num⟩
  let y : E := (t⁻¹ : Real) • bundle indices H z
  have hη : η y = (splitBump indices H t z).re := by rfl
  have hdiv : ‖bundle indices H z‖ / t ≤ (1 : Real) / 4 := by
    apply (div_le_iff₀ ht).mpr
    simpa [div_eq_mul_inv, mul_comm] using hz
  have hnorm : ‖y‖ = ‖bundle indices H z‖ / t := by
    dsimp [y]
    rw [norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos ht]
    ring
  have hmem : y ∈ Metric.closedBall (0 : E) η.rIn := by
    rw [Metric.mem_closedBall, dist_zero_right, hnorm]
    simpa [η] using hdiv
  have hone : η y = 1 := η.one_of_mem_closedBall hmem
  have hc : splitBump indices H t z = ((η y : Real) : Complex) := by rfl
  rw [high_bundle_eq_smul]
  simp [hc, hone]

private theorem high_bundle_norm_le
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    (t : Real) (z : JointWaveSpaceTime) :
    ‖WithLp.toLp 2 (fun i : (↥indices) => high indices H t (i : Int) z)‖ ≤
      ‖bundle indices H z‖ := by
  let E := Bundle indices
  let η : ContDiffBump (0 : E) :=
    ⟨(1 : Real) / 4, (1 : Real) / 2, by norm_num, by norm_num⟩
  let y : E := (t⁻¹ : Real) • bundle indices H z
  have hc : splitBump indices H t z = ((η y : Real) : Complex) := by rfl
  rw [high_bundle_eq_smul]
  rw [norm_smul, hc]
  have hsub : (1 : Complex) - ((η y : Real) : Complex) =
      ((1 - η y : Real) : Complex) := by norm_num
  rw [hsub, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (sub_nonneg.mpr η.le_one)]
  calc
    (1 - (splitBump indices H t z).re) * ‖bundle indices H z‖ ≤
        1 * ‖bundle indices H z‖ :=
      mul_le_mul_of_nonneg_right
        (sub_le_self _ η.nonneg) (norm_nonneg _)
    _ = ‖bundle indices H z‖ := one_mul _

private theorem bundle_continuous
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex) :
    Continuous (bundle indices H) := by
  unfold bundle
  apply (PiLp.continuous_toLp 2 (fun _ : (↥indices) => Complex)).comp
  apply continuous_pi
  intro i
  exact (H (i : Int)).continuous

private theorem high_bundle_family_measurable
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex) :
    Measurable (fun q : Real × JointWaveSpaceTime =>
      WithLp.toLp 2 (fun i : (↥indices) => high indices H q.1 (i : Int) q.2)) := by
  let E := Bundle indices
  let η : ContDiffBump (0 : E) :=
    ⟨(1 : Real) / 4, (1 : Real) / 2, by norm_num, by norm_num⟩
  have hB : Measurable (fun q : Real × JointWaveSpaceTime => bundle indices H q.2) :=
    (bundle_continuous indices H).measurable.comp measurable_snd
  have hscale : Measurable (fun q : Real × JointWaveSpaceTime =>
      (q.1⁻¹ : Real) • bundle indices H q.2) :=
    measurable_fst.inv.smul hB
  have hcutR : Measurable (fun q : Real × JointWaveSpaceTime =>
      η ((q.1⁻¹ : Real) • bundle indices H q.2)) :=
    η.continuous.measurable.comp hscale
  have hcut : Measurable (fun q : Real × JointWaveSpaceTime =>
      ((η ((q.1⁻¹ : Real) • bundle indices H q.2) : Real) : Complex)) :=
    Complex.ofRealCLM.continuous.measurable.comp hcutR
  have heq : (fun q : Real × JointWaveSpaceTime =>
      WithLp.toLp 2 (fun i : (↥indices) => high indices H q.1 (i : Int) q.2)) =
      (fun q : Real × JointWaveSpaceTime =>
        (1 - ((η ((q.1⁻¹ : Real) • bundle indices H q.2) : Real) : Complex)) •
          bundle indices H q.2) := by
    funext q
    rw [high_bundle_eq_smul]
    rfl
  rw [heq]
  exact (measurable_const.sub hcut).smul hB

private theorem high_bundle_lintegral_measurable
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex) (q : Real) :
    Measurable (fun t : Real => ∫⁻ z : JointWaveSpaceTime,
      (ENNReal.ofReal ‖WithLp.toLp 2
        (fun i : (↥indices) => high indices H t (i : Int) z)‖) ^ q) := by
  apply Measurable.lintegral_prod_right
  exact ENNReal.continuous_rpow_const.measurable.comp
    (high_bundle_family_measurable indices H).norm.ennreal_ofReal

private theorem high_bundle_rpow_le_indicator
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    {t q : Real} (ht : 0 < t) (hq : 0 < q) (z : JointWaveSpaceTime) :
    (ENNReal.ofReal ‖WithLp.toLp 2
      (fun i : (↥indices) => high indices H t (i : Int) z)‖) ^ q ≤
      ({w : JointWaveSpaceTime | t / 4 ≤ ‖bundle indices H w‖}.indicator
        (fun w => (ENNReal.ofReal ‖bundle indices H w‖) ^ q) z) := by
  by_cases htz : t / 4 ≤ ‖bundle indices H z‖
  · have hz : z ∈ {w : JointWaveSpaceTime | t / 4 ≤ ‖bundle indices H w‖} := htz
    rw [Set.indicator_of_mem hz]
    exact ENNReal.rpow_le_rpow
      (ENNReal.ofReal_le_ofReal (high_bundle_norm_le indices H t z)) hq.le
  · have hz : z ∉ {w : JointWaveSpaceTime | t / 4 ≤ ‖bundle indices H w‖} := htz
    have hsmall : ‖bundle indices H z‖ ≤ t / 4 :=
      (lt_of_not_ge htz).le
    have hzero := high_bundle_eq_zero_of_norm_le_quarter indices H ht z hsmall
    rw [hzero]
    simp [Set.indicator, hz, ENNReal.zero_rpow_of_pos hq]

private theorem high_bundle_tail_le
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    {q p : Real} (hq : 0 < q) (hqp : q < p) :
    (∫⁻ t in Ioi (0 : Real),
      (∫⁻ z : JointWaveSpaceTime,
        (ENNReal.ofReal ‖WithLp.toLp 2
          (fun i : (↥indices) => high indices H t (i : Int) z)‖) ^ q) *
        (ENNReal.ofReal t) ^ (p - q - 1)) ≤
      (ENNReal.ofReal (p - q))⁻¹ *
        (ENNReal.ofReal (4 : Real)) ^ (p - q) *
          ∫⁻ z : JointWaveSpaceTime,
            (ENNReal.ofReal ‖bundle indices H z‖) ^ p := by
  let u : JointWaveSpaceTime → Real := fun z => ‖bundle indices H z‖
  have hu : Measurable u := (bundle_continuous indices H).measurable.norm
  have hu_nonneg : ∀ z, 0 ≤ u z := fun z => norm_nonneg _
  calc
    (∫⁻ t in Ioi (0 : Real),
      (∫⁻ z : JointWaveSpaceTime,
        (ENNReal.ofReal ‖WithLp.toLp 2
          (fun i : (↥indices) => high indices H t (i : Int) z)‖) ^ q) *
        (ENNReal.ofReal t) ^ (p - q - 1)) ≤
        ∫⁻ t in Ioi (0 : Real),
          (∫⁻ z : JointWaveSpaceTime in {z | t / 4 ≤ u z},
            (ENNReal.ofReal (u z)) ^ q) *
              (ENNReal.ofReal t) ^ (p - q - 1) := by
      apply lintegral_mono_ae
      filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
      apply mul_le_mul_of_nonneg_right
      · rw [← lintegral_indicator (measurableSet_le measurable_const hu)]
        apply lintegral_mono
        intro z
        simpa only [u] using high_bundle_rpow_le_indicator indices H ht hq z
      · positivity
    _ = (ENNReal.ofReal (p - q))⁻¹ *
          (ENNReal.ofReal (4 : Real)) ^ (p - q) *
            ∫⁻ z : JointWaveSpaceTime,
              (ENNReal.ofReal ‖bundle indices H z‖) ^ p := by
      simpa only [u] using
        RationalTails.lintegral_high_tail_rpow_quarter_eq u hu hu_nonneg hq hqp

/-- A global smooth split of a finite joint-Schwartz family with precisely the
low-height, measurability, and quarter-tail data consumed by the supplied-split
Marcinkiewicz theorem.  The norm is the finite `PiLp 2` square-bundle norm. -/
theorem exists_sourceOutput_compatible_jointSchwartz_smooth_split
    (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    {q p : Real} (hq : 0 < q) (hqp : q < p) :
    ∃ L U : Real → Int → SchwartzMap JointWaveSpaceTime Complex,
      (∀ t n, H n = L t n + U t n) ∧
      (∀ t, 0 < t → ∀ z : JointWaveSpaceTime,
        ‖WithLp.toLp 2 (fun i : (↥indices) => L t (i : Int) z)‖ ≤ t / 2) ∧
      Measurable (fun t : Real => ∫⁻ z : JointWaveSpaceTime,
        (ENNReal.ofReal ‖WithLp.toLp 2
          (fun i : (↥indices) => U t (i : Int) z)‖) ^ q) ∧
      (∫⁻ t in Ioi (0 : Real),
        (∫⁻ z : JointWaveSpaceTime,
          (ENNReal.ofReal ‖WithLp.toLp 2
            (fun i : (↥indices) => U t (i : Int) z)‖) ^ q) *
          (ENNReal.ofReal t) ^ (p - q - 1)) ≤
        (ENNReal.ofReal (p - q))⁻¹ *
          (ENNReal.ofReal (4 : Real)) ^ (p - q) *
            ∫⁻ z : JointWaveSpaceTime,
              (ENNReal.ofReal ‖bundle indices H z‖) ^ p := by
  refine ⟨fun t n => low indices H t n, fun t n => high indices H t n, ?_, ?_, ?_, ?_⟩
  · intro t n
    exact low_high_split indices H t n
  · intro t ht z
    exact low_bundle_norm_le_half indices H ht z
  · exact high_bundle_lintegral_measurable indices H q
  · exact high_bundle_tail_le indices H hq hqp

end SmoothSplit

open SmoothSplit

private noncomputable def affineVerticalProfile
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) : SchwartzMap Real Complex :=
  let root : Real := Real.sqrt scale
  let A : Real ≃L[Real] Real :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 root⁻¹ (by
        dsimp only [root]
        exact inv_ne_zero (Real.sqrt_ne_zero'.mpr hscale)))
  ((SchwartzMap.compCLMOfContinuousLinearEquiv Complex A) beta).compSubConstCLM
    Complex (root * n)

private theorem affineVerticalProfile_apply
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) (tau : Real) :
    affineVerticalProfile beta scale n hscale tau =
      beta ((Real.sqrt scale)⁻¹ * tau - n) := by
  unfold affineVerticalProfile
  dsimp
  change beta ((Real.sqrt scale)⁻¹ * (tau - Real.sqrt scale * n)) = _
  have hroot : Real.sqrt scale ≠ 0 := Real.sqrt_ne_zero'.mpr hscale
  field_simp [hroot]

private theorem fourierInv_sub_schwartz
    (f : SchwartzMap Real Complex) (a t : Real) :
    FourierTransform.fourierInv (fun tau : Real => (f : Real → Complex) (tau - a)) t =
      Real.fourierChar (a * t) • FourierTransform.fourierInv (f : Real → Complex) t := by
  rw [Real.fourierInv_eq_fourier_neg]
  have hshift := VectorFourier.fourierIntegral_comp_add_right
    (V := Real) (W := Real) (E := Complex)
    Real.fourierChar volume (innerₗ Real) (f : Real → Complex) (-a)
  change VectorFourier.fourierIntegral Real.fourierChar volume (innerₗ Real)
      (fun tau : Real => (f : Real → Complex) (tau - a)) (-t) = _
  have htranslate :
      (fun tau : Real => (f : Real → Complex) (tau - a)) =
        Function.comp (f : Real → Complex) (fun tau : Real => tau + (-a)) := by
    funext tau
    rfl
  rw [htranslate, hshift]
  change Real.fourierChar ((innerₗ Real (-a)) (-t)) •
      VectorFourier.fourierIntegral Real.fourierChar volume (innerₗ Real)
        (f : Real → Complex) (-t) = _
  change Real.fourierChar ((innerₗ Real (-a)) (-t)) •
      FourierTransform.fourier (f : Real → Complex) (-t) = _
  rw [← Real.fourierInv_eq_fourier_neg]
  change Real.fourierChar ((innerₗ Real (-a)) (-t)) •
      FourierTransform.fourierInv (f : Real → Complex) t = _
  congr 1
  simp only [innerₗ_apply_apply, Real.inner_apply]
  congr 1
  ring

private theorem fourierInv_affineVerticalProfile
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) (t : Real) :
    FourierTransform.fourierInv
        (affineVerticalProfile beta scale n hscale : Real → Complex) t =
      Real.sqrt scale •
        (Real.fourierChar ((n : Real) * (Real.sqrt scale * t)) •
          FourierTransform.fourierInv (beta : Real → Complex) (Real.sqrt scale * t)) := by
  let root : Real := Real.sqrt scale
  have hroot : 0 < root := by
    dsimp only [root]
    exact Real.sqrt_pos.2 hscale
  have hprofile :
      (affineVerticalProfile beta scale n hscale : Real → Complex) =
        fun tau : Real => (fun sigma : Real => (beta : Real → Complex) (sigma - n))
          (root⁻¹ • tau) := by
    funext tau
    rw [affineVerticalProfile_apply]
    change beta ((Real.sqrt scale)⁻¹ * tau - n) = beta ((root⁻¹ • tau) - n)
    simp only [smul_eq_mul]
    rfl
  rw [hprofile]
  calc
    FourierTransform.fourierInv
        (fun tau : Real => (fun sigma : Real => (beta : Real → Complex) (sigma - n))
          (root⁻¹ • tau)) t =
        root ^ Module.finrank Real Real • FourierTransform.fourierInv
          (fun sigma : Real => (beta : Real → Complex) (sigma - n)) (root • t) :=
      fourierInv_comp_inv_smul
        (g := fun sigma : Real => (beta : Real → Complex) (sigma - n)) hroot t
    _ = root • FourierTransform.fourierInv
          (fun sigma : Real => (beta : Real → Complex) (sigma - n)) (root * t) := by
      simp only [Module.finrank_self, pow_one]
      rfl
    _ = root •
        (Real.fourierChar ((n : Real) * (root * t)) •
          FourierTransform.fourierInv (beta : Real → Complex) (root * t)) := by
      exact congrArg (fun z : Complex => root • z)
        (fourierInv_sub_schwartz beta (n : Real) (root * t))
    _ = Real.sqrt scale •
        (Real.fourierChar ((n : Real) * (Real.sqrt scale * t)) •
          FourierTransform.fourierInv (beta : Real → Complex) (Real.sqrt scale * t)) := by
      dsimp only [root]

private theorem norm_fourierInv_affineVerticalProfile
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) (t : Real) :
    ‖FourierTransform.fourierInv
        (affineVerticalProfile beta scale n hscale : Real → Complex) t‖ =
      Real.sqrt scale *
        ‖FourierTransform.fourierInv (beta : Real → Complex) (Real.sqrt scale * t)‖ := by
  rw [fourierInv_affineVerticalProfile beta scale n hscale t]
  rw [norm_smul, Circle.norm_smul]
  rw [Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _)]

/-- Multiplication by a temporal Schwartz symbol, viewed on joint frequency
space.  This is the exact spectral action underlying the raw vertical
projection. -/
private def liftTemporalFrequencySymbol
    (m : SchwartzMap Real Complex) : JointWaveSpaceTime → Complex :=
  fun z => m z.snd

private theorem liftTemporalFrequencySymbol_hasTemperateGrowth
    (m : SchwartzMap Real Complex) :
    (liftTemporalFrequencySymbol m).HasTemperateGrowth := by
  change (m ∘ WithLp.sndL 2 Real (Euclidean 2) Real).HasTemperateGrowth
  exact m.hasTemperateGrowth.comp
    (WithLp.sndL 2 Real (Euclidean 2) Real).hasTemperateGrowth

private noncomputable def applyTemporalFrequencySymbol
    (m : SchwartzMap Real Complex)
    (Q : SchwartzMap JointWaveSpaceTime Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  SchwartzMap.smulLeftCLM Complex (liftTemporalFrequencySymbol m) Q

private theorem applyTemporalFrequencySymbol_apply
    (m : SchwartzMap Real Complex)
    (Q : SchwartzMap JointWaveSpaceTime Complex) (zeta : WaveSpaceTime) :
    applyTemporalFrequencySymbol m Q (WithLp.toLp 2 zeta) =
      m zeta.2 * Q (WithLp.toLp 2 zeta) := by
  unfold applyTemporalFrequencySymbol
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (liftTemporalFrequencySymbol_hasTemperateGrowth m)]
  unfold liftTemporalFrequencySymbol
  rfl

private noncomputable def jointTemporalSchwartzMultiplier
    (m : SchwartzMap Real Complex)
    (G : SchwartzMap JointWaveSpaceTime Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  FourierTransform.fourierInv
    (applyTemporalFrequencySymbol m (FourierTransform.fourier G))

private theorem verticalProjection_jointSchwartzRaw_eq_jointTemporalSchwartzMultiplier
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) (G : SchwartzMap JointWaveSpaceTime Complex) :
    verticalProjection (beta : Real → Complex) scale n (jointSchwartzRaw G) =
      jointSchwartzRaw
        (jointTemporalSchwartzMultiplier (affineVerticalProfile beta scale n hscale) G) := by
  have hmult :
      (fun zeta : WaveSpaceTime =>
        verticalMultiplier (beta : Real → Complex) scale n zeta *
          spaceTimeFourier (jointSchwartzRaw G) zeta) =
        jointSchwartzRaw
          (applyTemporalFrequencySymbol (affineVerticalProfile beta scale n hscale)
            (FourierTransform.fourier G)) := by
    funext zeta
    rw [spaceTimeFourier_jointSchwartzRaw]
    change verticalMultiplier (beta : Real → Complex) scale n zeta *
        FourierTransform.fourier (G : JointWaveSpaceTime → Complex)
          (WithLp.toLp 2 zeta) =
      applyTemporalFrequencySymbol (affineVerticalProfile beta scale n hscale)
        (FourierTransform.fourier G) (WithLp.toLp 2 zeta)
    rw [applyTemporalFrequencySymbol_apply,
      affineVerticalProfile_apply]
    rw [verticalMultiplier]
    rw [← SchwartzMap.fourier_coe]
  funext z
  unfold verticalProjection
  rw [hmult, spaceTimeFourierInv_jointSchwartzRaw]
  unfold jointTemporalSchwartzMultiplier jointSchwartzRaw
  exact (congrFun (SchwartzMap.fourierInv_coe
    (applyTemporalFrequencySymbol (affineVerticalProfile beta scale n hscale)
      (FourierTransform.fourier G))) (WithLp.toLp 2 z)).symm

private noncomputable def timeFiberEmbedding (x : Euclidean 2) :
    Real → JointWaveSpaceTime :=
  fun t => WithLp.toLp 2 (x, t)

private noncomputable def timeFiberLinear :
    Real →L[Real] JointWaveSpaceTime :=
  (WithLp.prodContinuousLinearEquiv 2 Real (Euclidean 2) Real).symm.toContinuousLinearMap.comp
    (ContinuousLinearMap.inr Real (Euclidean 2) Real)

private theorem timeFiberLinear_apply (t : Real) :
    timeFiberLinear t = WithLp.toLp 2 (0, t) := by
  unfold timeFiberLinear
  rfl

private theorem timeFiberEmbedding_hasTemperateGrowth (x : Euclidean 2) :
    (timeFiberEmbedding x).HasTemperateGrowth := by
  have hconst : (fun _ : Real => WithLp.toLp 2 (x, (0 : Real))).HasTemperateGrowth :=
    Function.HasTemperateGrowth.const _
  have hlinear : (timeFiberLinear : Real → JointWaveSpaceTime).HasTemperateGrowth :=
    timeFiberLinear.hasTemperateGrowth
  have hsum := hconst.add hlinear
  have hfun : (fun t : Real => WithLp.toLp 2 (x, (0 : Real))) + timeFiberLinear =
      timeFiberEmbedding x := by
    funext t
    change WithLp.toLp 2 (x, (0 : Real)) + timeFiberLinear t =
      WithLp.toLp 2 (x, t)
    rw [timeFiberLinear_apply]
    rw [← WithLp.toLp_add]
    congr 1; simp
  rw [hfun] at hsum
  exact hsum

private theorem timeFiberEmbedding_antilipschitz (x : Euclidean 2) :
    AntilipschitzWith 1 (timeFiberEmbedding x) := by
  apply AntilipschitzWith.of_le_mul_dist
  intro s t
  suffices h : dist s t ≤ dist (WithLp.toLp 2 (x, s)) (WithLp.toLp 2 (x, t)) by
    simpa only [NNReal.coe_one, one_mul, timeFiberEmbedding] using h
  calc
    dist s t = ‖s - t‖ := by rw [dist_eq_norm, norm_sub_rev]
    _ = ‖WithLp.toLp 2 ((0 : Euclidean 2), s - t)‖ :=
      (WithLp.norm_toLp_snd 2 (Euclidean 2) Real (s - t)).symm
    _ = ‖WithLp.toLp 2 (x, s) - WithLp.toLp 2 (x, t)‖ := by
      rw [← WithLp.toLp_sub]
      congr 1; simp
    _ ≤ dist (WithLp.toLp 2 (x, s)) (WithLp.toLp 2 (x, t)) := by
      simpa only [dist_eq_norm] using
        (le_refl ‖WithLp.toLp 2 (x, s) - WithLp.toLp 2 (x, t)‖)

private noncomputable def jointSchwartzTimeFiber
    (G : SchwartzMap JointWaveSpaceTime Complex) (x : Euclidean 2) :
    SchwartzMap Real Complex :=
  SchwartzMap.compCLMOfAntilipschitz Complex
    (timeFiberEmbedding_hasTemperateGrowth x)
    (timeFiberEmbedding_antilipschitz x) G

private theorem jointSchwartzTimeFiber_apply
    (G : SchwartzMap JointWaveSpaceTime Complex) (x : Euclidean 2) (t : Real) :
    jointSchwartzTimeFiber G x t = jointSchwartzRaw G (x, t) := by
  unfold jointSchwartzTimeFiber
  rfl

/-- Tonelli plus translation invariance for convolution in only the time
coordinate of product space--time. -/
private theorem lintegral_temporal_convolution_one
    (K : Real → ENNReal) (q : WaveSpaceTime → ENNReal)
    (hK : Measurable K) (hq : Measurable q) :
    (∫⁻ z : WaveSpaceTime, ∫⁻ y : Real, K y * q (z.1, z.2 - y)) =
      (∫⁻ y : Real, K y) * ∫⁻ z : WaveSpaceTime, q z := by
  have htranslate (y : Real) :
      (∫⁻ z : WaveSpaceTime, q (z.1, z.2 - y)) = ∫⁻ z : WaveSpaceTime, q z := by
    have hpres : MeasurePreserving
        (fun z : Euclidean 2 × Real => (z.1, z.2 - y))
        (volume.prod volume) (volume.prod volume) := by
      exact MeasurePreserving.prod (MeasurePreserving.id _) (measurePreserving_sub_right volume y)
    rw [Measure.volume_eq_prod]
    simpa only [Function.comp_apply] using hpres.lintegral_comp hq
  let H : WaveSpaceTime × Real → ENNReal := fun w =>
    K w.2 * q (w.1.1, w.1.2 - w.2)
  have hH : Measurable H := by
    exact (hK.comp measurable_snd).mul
      (hq.comp ((measurable_fst.fst).prodMk (measurable_fst.snd.sub measurable_snd)))
  calc
    (∫⁻ z : WaveSpaceTime, ∫⁻ y : Real, K y * q (z.1, z.2 - y)) =
        ∫⁻ y : Real, ∫⁻ z : WaveSpaceTime, K y * q (z.1, z.2 - y) := by
      exact lintegral_lintegral_swap hH.aemeasurable
    _ = ∫⁻ y : Real, K y * (∫⁻ z : WaveSpaceTime, q (z.1, z.2 - y)) := by
      apply lintegral_congr
      intro y
      simpa only [Function.comp_apply, Pi.sub_apply, id_eq] using
        (lintegral_const_mul (K y)
          (hq.comp ((measurable_id.fst).prodMk (measurable_id.snd.sub measurable_const))))
    _ = ∫⁻ y : Real, K y * (∫⁻ z : WaveSpaceTime, q z) := by
      apply lintegral_congr
      intro y
      rw [htranslate y]
    _ = (∫⁻ y : Real, K y) * ∫⁻ z : WaveSpaceTime, q z :=
      lintegral_mul_const _ hK

/-- Literal convolution in the physical time variable, leaving the spatial
coordinate untouched. -/
private noncomputable def temporalConvolutionJointRaw
    (k : SchwartzMap Real Complex) (G : SchwartzMap JointWaveSpaceTime Complex) :
    WaveSpaceTime → Complex :=
  fun z => ∫ y : Real, (k : Real → Complex) y * jointSchwartzRaw G (z.1, z.2 - y)

private theorem jointSchwartzRaw_integrable_prod
    (G : SchwartzMap JointWaveSpaceTime Complex) :
    Integrable (jointSchwartzRaw G) (volume.prod volume) := by
  have hpres : MeasurePreserving
      (MeasurableEquiv.toLp 2 WaveSpaceTime) volume volume :=
    WithLp.volume_preserving_toLp (Euclidean 2) Real
  exact
    (hpres.integrable_comp_emb
      (MeasurableEquiv.toLp 2 (Euclidean 2 × Real)).measurableEmbedding).mpr
      G.integrable

private noncomputable def temporalShearEquiv :
    (WaveSpaceTime × Real) ≃ᵐ (Real × WaveSpaceTime) where
  toEquiv :=
    { toFun := fun w => (w.2, (w.1.1, w.1.2 - w.2))
      invFun := fun u => ((u.2.1, u.2.2 + u.1), u.1)
      left_inv := by
        rintro ⟨⟨x, t⟩, y⟩
        simp
      right_inv := by
        rintro ⟨y, ⟨x, s⟩⟩
        simp }
  measurable_toFun := by
    change Measurable (fun w : WaveSpaceTime × Real =>
      (w.2, (w.1.1, w.1.2 - w.2)))
    fun_prop
  measurable_invFun := by
    change Measurable (fun u : Real × WaveSpaceTime =>
      ((u.2.1, u.2.2 + u.1), u.1))
    fun_prop

private theorem temporalShearEquiv_apply (w : WaveSpaceTime × Real) :
    temporalShearEquiv w = (w.2, (w.1.1, w.1.2 - w.2)) := rfl

private theorem temporalShear_measurePreserving :
    MeasurePreserving
      (fun w : WaveSpaceTime × Real => (w.2, (w.1.1, w.1.2 - w.2)))
      ((volume.prod volume).prod volume)
      (volume.prod (volume.prod volume)) := by
  let μx : Measure (Euclidean 2) := volume
  let μt : Measure Real := volume
  let μy : Measure Real := volume
  have hAssoc₁ : MeasurePreserving
      (MeasurableEquiv.prodAssoc : (Euclidean 2 × Real) × Real ≃ᵐ Euclidean 2 × (Real × Real))
      ((μx.prod μt).prod μy) (μx.prod (μt.prod μy)) :=
    measurePreserving_prodAssoc μx μt μy
  have hShear : MeasurePreserving
      (Prod.map (fun x : Euclidean 2 => x)
        (fun q : Real × Real => (q.2, q.1 - q.2)))
      (μx.prod (μt.prod μy)) (μx.prod (μy.prod μt)) := by
    exact MeasurePreserving.prod (MeasurePreserving.id _) (measurePreserving_prod_sub_swap μt μy)
  have hAssocXYT : MeasurePreserving
      (MeasurableEquiv.prodAssoc : (Euclidean 2 × Real) × Real ≃ᵐ Euclidean 2 × (Real × Real))
      ((μx.prod μy).prod μt) (μx.prod (μy.prod μt)) :=
    measurePreserving_prodAssoc μx μy μt
  have hSwap : MeasurePreserving
      (Prod.map Prod.swap (fun s : Real => s))
      ((μx.prod μy).prod μt) ((μy.prod μx).prod μt) := by
    exact MeasurePreserving.prod (Measure.measurePreserving_swap) (MeasurePreserving.id _)
  have hAssocYXT : MeasurePreserving
      (MeasurableEquiv.prodAssoc : (Real × Euclidean 2) × Real ≃ᵐ Real × (Euclidean 2 × Real))
      ((μy.prod μx).prod μt) (μy.prod (μx.prod μt)) :=
    measurePreserving_prodAssoc μy μx μt
  have hReorder : MeasurePreserving
      (fun u : Euclidean 2 × (Real × Real) => (u.2.1, (u.1, u.2.2)))
      (μx.prod (μy.prod μt)) (μy.prod (μx.prod μt)) := by
    have h := hAssocYXT.comp (hSwap.comp hAssocXYT.symm)
    convert h using 1
    funext u
    rfl
  have h := hReorder.comp (hShear.comp hAssoc₁)
  convert h using 1
  funext w
  rfl

private theorem temporalConvolutionJointRaw_triple_integrable
    (k : SchwartzMap Real Complex) (G : SchwartzMap JointWaveSpaceTime Complex) :
    Integrable (fun w : WaveSpaceTime × Real =>
      (k : Real → Complex) w.2 * jointSchwartzRaw G (w.1.1, w.1.2 - w.2))
      ((volume.prod volume).prod volume) := by
  let F : Real × WaveSpaceTime → Complex := fun u =>
    (k : Real → Complex) u.1 * jointSchwartzRaw G u.2
  have hF : Integrable F (volume.prod (volume.prod volume)) := by
    exact k.integrable.mul_prod (jointSchwartzRaw_integrable_prod G)
  have hcomp : F ∘ (fun w : WaveSpaceTime × Real =>
      (w.2, (w.1.1, w.1.2 - w.2))) =
      (fun w : WaveSpaceTime × Real =>
        (k : Real → Complex) w.2 * jointSchwartzRaw G (w.1.1, w.1.2 - w.2)) := by
    rfl
  rw [← hcomp]
  exact (temporalShear_measurePreserving.integrable_comp hF.aestronglyMeasurable).mpr hF

private theorem integrable_temporalConvolutionJointRaw
    (k : SchwartzMap Real Complex)
    (G : SchwartzMap JointWaveSpaceTime Complex) :
    Integrable (temporalConvolutionJointRaw k G) (volume.prod volume) := by
  have htriple := temporalConvolutionJointRaw_triple_integrable k G
  change Integrable (fun z : WaveSpaceTime => ∫ y : Real,
    (k : Real → Complex) y * jointSchwartzRaw G (z.1, z.2 - y))
    (volume.prod volume)
  exact htriple.integral_prod_left

private theorem continuous_temporalConvolutionJointRaw
    (k : SchwartzMap Real Complex) (G : SchwartzMap JointWaveSpaceTime Complex) :
    Continuous (temporalConvolutionJointRaw k G) := by
  have hraw : Continuous (jointSchwartzRaw G) := by
    unfold jointSchwartzRaw
    exact G.continuous.comp (WithLp.prod_continuous_toLp 2 (Euclidean 2) Real)
  let C : Real := ‖G.toBoundedContinuousFunction‖
  have hC (z : WaveSpaceTime) : ‖jointSchwartzRaw G z‖ ≤ C := by
    dsimp only [C]
    exact BoundedContinuousFunction.norm_coe_le_norm G.toBoundedContinuousFunction
      (WithLp.toLp 2 z)
  have hmajor : Integrable (fun y : Real => C * ‖(k : Real → Complex) y‖) volume :=
    k.integrable.norm.const_mul C
  apply continuous_of_dominated
  · intro z
    have hshift : Continuous (fun y : Real => jointSchwartzRaw G (z.1, z.2 - y)) :=
      hraw.comp (by fun_prop)
    change AEStronglyMeasurable (fun y : Real =>
      (k : Real → Complex) y * jointSchwartzRaw G (z.1, z.2 - y)) volume
    exact k.continuous.aestronglyMeasurable.mul hshift.aestronglyMeasurable
  · intro z
    filter_upwards with y
    rw [norm_mul]
    calc
      ‖(k : Real → Complex) y‖ * ‖jointSchwartzRaw G (z.1, z.2 - y)‖ ≤
          ‖(k : Real → Complex) y‖ * C :=
        mul_le_mul_of_nonneg_left (hC _) (norm_nonneg _)
      _ = C * ‖(k : Real → Complex) y‖ := by ring
  · exact hmajor
  · filter_upwards with y
    change Continuous (fun z : WaveSpaceTime =>
      (k : Real → Complex) y * jointSchwartzRaw G (z.1, z.2 - y))
    exact continuous_const.mul (hraw.comp (by fun_prop))

private noncomputable def jointRawLift (H : WaveSpaceTime → Complex) :
    JointWaveSpaceTime → Complex :=
  fun v => H ((MeasurableEquiv.toLp 2 WaveSpaceTime).symm v)

private theorem jointRawLift_apply_toLp (H : WaveSpaceTime → Complex)
    (z : WaveSpaceTime) :
    jointRawLift H (WithLp.toLp 2 z) = H z := by
  unfold jointRawLift
  simp

private theorem jointRawLift_integrable
    (H : WaveSpaceTime → Complex) (hH : Integrable H (volume.prod volume)) :
    Integrable (jointRawLift H) volume := by
  let e : WaveSpaceTime ≃ᵐ JointWaveSpaceTime := MeasurableEquiv.toLp 2 WaveSpaceTime
  have hpres : MeasurePreserving e (volume.prod volume) volume := by
    exact WithLp.volume_preserving_toLp (Euclidean 2) Real
  have hinv : MeasurePreserving e.symm volume (volume.prod volume) := hpres.symm e
  change Integrable (H ∘ e.symm) volume
  exact (hinv.integrable_comp hH.aestronglyMeasurable).mpr hH

private theorem continuous_jointRawLift
    (H : WaveSpaceTime → Complex) (hH : Continuous H) :
    Continuous (jointRawLift H) := by
  unfold jointRawLift
  exact hH.comp (WithLp.prodContinuousLinearEquiv 2 Real (Euclidean 2) Real).continuous

/-- Fubini form of the iterated space--time Fourier transform for an arbitrary
integrable raw product-space function. -/
private theorem spaceTimeFourier_eq_productIntegral
    (H : WaveSpaceTime → Complex) (hH : Integrable H (volume.prod volume))
    (ζ : WaveSpaceTime) :
    spaceTimeFourier H ζ =
      ∫ z : WaveSpaceTime,
        (Real.fourierChar (-inner Real z.2 ζ.2) : Complex) *
          (Real.fourierChar (-inner Real z.1 ζ.1) : Complex) * H z := by
  let K : Euclidean 2 → Real → Complex := fun x t =>
    (Real.fourierChar (-inner Real t ζ.2) : Complex) *
      (Real.fourierChar (-inner Real x ζ.1) : Complex) * H (x, t)
  have hK : Integrable (Function.uncurry K) (volume.prod volume) := by
    have hphaseT : Continuous (fun p : WaveSpaceTime =>
        (Real.fourierChar (-inner Real p.2 ζ.2) : Complex)) := by
      fun_prop
    have hphaseX : Continuous (fun p : WaveSpaceTime =>
        (Real.fourierChar (-inner Real p.1 ζ.1) : Complex)) := by
      fun_prop
    refine hH.congr' ?_ ?_
    · change AEStronglyMeasurable (fun p : WaveSpaceTime =>
          (Real.fourierChar (-inner Real p.2 ζ.2) : Complex) *
            (Real.fourierChar (-inner Real p.1 ζ.1) : Complex) * H p)
          (volume.prod volume)
      exact
        (hphaseT.aestronglyMeasurable.mul hphaseX.aestronglyMeasurable).mul
          hH.aestronglyMeasurable
    · filter_upwards with p
      simp only [K, Function.uncurry, norm_mul, Circle.norm_coe, one_mul]
  have hleft :
      spaceTimeFourier H ζ = ∫ t : Real, ∫ x : Euclidean 2, K x t := by
    unfold spaceTimeFourier
    rw [Real.fourier_eq]
    apply integral_congr_ae
    filter_upwards with t
    rw [Real.fourier_eq]
    change
      (↑(Real.fourierChar (-inner Real t ζ.2)) : Complex) •
          ∫ x : Euclidean 2,
            (↑(Real.fourierChar (-inner Real x ζ.1)) : Complex) • H (x, t) =
        ∫ x : Euclidean 2, K x t
    rw [← integral_smul]
    apply integral_congr_ae
    filter_upwards with x
    simp only [K, smul_eq_mul]
    ring
  have hKswap : Integrable
      (Function.uncurry (fun t : Real => fun x : Euclidean 2 => K x t))
      (volume.prod volume) := by
    convert hK.swap using 1
    ext z
    rcases z with ⟨t, x⟩
    rfl
  have hswap :
      (∫ t : Real, ∫ x : Euclidean 2, K x t) =
        ∫ x : Euclidean 2, ∫ t : Real, K x t :=
    integral_integral_swap hKswap
  have hprod :
      (∫ x : Euclidean 2, ∫ t : Real, K x t) =
        ∫ z : WaveSpaceTime, K z.1 z.2 := by
    rw [Measure.volume_eq_prod]
    exact (integral_prod (Function.uncurry K) hK).symm
  calc
    spaceTimeFourier H ζ = ∫ t : Real, ∫ x : Euclidean 2, K x t := hleft
    _ = ∫ x : Euclidean 2, ∫ t : Real, K x t := hswap
    _ = ∫ z : WaveSpaceTime, K z.1 z.2 := hprod
    _ = ∫ z : WaveSpaceTime,
        (Real.fourierChar (-inner Real z.2 ζ.2) : Complex) *
          (Real.fourierChar (-inner Real z.1 ζ.1) : Complex) * H z := by
      rfl

private theorem fourier_jointRawLift_eq_spaceTimeFourier
    (H : WaveSpaceTime → Complex) (hH : Integrable H (volume.prod volume))
    (ζ : WaveSpaceTime) :
    FourierTransform.fourier (jointRawLift H) (WithLp.toLp 2 ζ) =
      spaceTimeFourier H ζ := by
  let e : WaveSpaceTime ≃ᵐ JointWaveSpaceTime := MeasurableEquiv.toLp 2 WaveSpaceTime
  have hpres : MeasurePreserving e (volume.prod volume) volume := by
    exact WithLp.volume_preserving_toLp (Euclidean 2) Real
  let Φ : JointWaveSpaceTime → Complex := fun v =>
    Real.fourierChar (-inner Real v (WithLp.toLp 2 ζ)) • jointRawLift H v
  have htransport :
      (∫ p : WaveSpaceTime, Φ (e p)) = ∫ v : JointWaveSpaceTime, Φ v :=
    hpres.integral_comp e.measurableEmbedding Φ
  have hfactor (p : WaveSpaceTime) :
      Φ (e p) =
        (Real.fourierChar (-inner Real p.2 ζ.2) : Complex) *
          (Real.fourierChar (-inner Real p.1 ζ.1) : Complex) * H p := by
    dsimp only [Φ, e]
    rw [jointRawLift_apply_toLp]
    change
      Real.fourierChar
          (-inner Real (WithLp.toLp 2 p) (WithLp.toLp 2 ζ)) • H p = _
    rw [WithLp.prod_inner_apply, neg_add, Real.fourierChar.map_add_eq_mul]
    rw [mul_smul]
    change
      (Real.fourierChar (-inner Real p.1 ζ.1) : Complex) *
        ((Real.fourierChar (-inner Real p.2 ζ.2) : Complex) * H p) = _
    ring
  calc
    FourierTransform.fourier (jointRawLift H) (WithLp.toLp 2 ζ) =
        ∫ v : JointWaveSpaceTime, Φ v := by
          rw [Real.fourier_eq]
    _ = ∫ p : WaveSpaceTime, Φ (e p) := htransport.symm
    _ = ∫ p : WaveSpaceTime,
        (Real.fourierChar (-inner Real p.2 ζ.2) : Complex) *
          (Real.fourierChar (-inner Real p.1 ζ.1) : Complex) * H p := by
          apply integral_congr_ae
          filter_upwards with p
          exact hfactor p
    _ = spaceTimeFourier H ζ :=
      (spaceTimeFourier_eq_productIntegral H hH ζ).symm

private theorem temporalConvolutionJointRaw_phase_triple_integrable
    (k : SchwartzMap Real Complex) (G : SchwartzMap JointWaveSpaceTime Complex)
    (ζ : WaveSpaceTime) :
    Integrable (fun w : WaveSpaceTime × Real =>
      (Real.fourierChar (-inner Real w.1.2 ζ.2) : Complex) *
        (Real.fourierChar (-inner Real w.1.1 ζ.1) : Complex) *
          (k : Real → Complex) w.2 * jointSchwartzRaw G (w.1.1, w.1.2 - w.2))
      ((volume.prod volume).prod volume) := by
  have hbase := temporalConvolutionJointRaw_triple_integrable k G
  have hphaseT : Continuous (fun w : WaveSpaceTime × Real =>
      (Real.fourierChar (-inner Real w.1.2 ζ.2) : Complex)) := by
    fun_prop
  have hphaseX : Continuous (fun w : WaveSpaceTime × Real =>
      (Real.fourierChar (-inner Real w.1.1 ζ.1) : Complex)) := by
    fun_prop
  refine hbase.congr' ?_ ?_
  · have hmeas :=
      (hphaseT.aestronglyMeasurable.mul hphaseX.aestronglyMeasurable).mul
        hbase.aestronglyMeasurable
    convert hmeas using 1
    funext w
    simp only [Pi.mul_apply]
    ring
  · filter_upwards with w
    simp only [norm_mul, Circle.norm_coe, one_mul]

private theorem spaceTimeFourier_temporalConvolutionJointRaw
    (k : SchwartzMap Real Complex) (G : SchwartzMap JointWaveSpaceTime Complex)
    (ζ : WaveSpaceTime) :
    spaceTimeFourier (temporalConvolutionJointRaw k G) ζ =
      FourierTransform.fourier (k : Real → Complex) ζ.2 *
        spaceTimeFourier (jointSchwartzRaw G) ζ := by
  let R : WaveSpaceTime → Complex := temporalConvolutionJointRaw k G
  let P : WaveSpaceTime → Complex := fun z =>
    (Real.fourierChar (-inner Real z.2 ζ.2) : Complex) *
      (Real.fourierChar (-inner Real z.1 ζ.1) : Complex)
  have hR : Integrable R (volume.prod volume) :=
    integrable_temporalConvolutionJointRaw k G
  have htriple := temporalConvolutionJointRaw_phase_triple_integrable k G ζ
  have hexpand :
      (∫ z : WaveSpaceTime, P z * R z) =
        ∫ w : WaveSpaceTime × Real,
          P w.1 * (k : Real → Complex) w.2 *
            jointSchwartzRaw G (w.1.1, w.1.2 - w.2) := by
    calc
      (∫ z : WaveSpaceTime, P z * R z) =
          ∫ z : WaveSpaceTime, ∫ y : Real,
            P z * ((k : Real → Complex) y * jointSchwartzRaw G (z.1, z.2 - y)) := by
          apply integral_congr_ae
          filter_upwards with z
          dsimp only [R, temporalConvolutionJointRaw]
          rw [← integral_const_mul]
      _ = ∫ z : WaveSpaceTime, ∫ y : Real,
          P z * (k : Real → Complex) y * jointSchwartzRaw G (z.1, z.2 - y) := by
          apply integral_congr_ae
          filter_upwards with z
          apply integral_congr_ae
          filter_upwards with y
          ring
      _ = ∫ w : WaveSpaceTime × Real,
          P w.1 * (k : Real → Complex) w.2 *
            jointSchwartzRaw G (w.1.1, w.1.2 - w.2) := by
          exact (integral_prod (fun w : WaveSpaceTime × Real =>
            P w.1 * (k : Real → Complex) w.2 *
              jointSchwartzRaw G (w.1.1, w.1.2 - w.2)) (by
                simpa only [P] using htriple)
                (μ := volume.prod volume) (ν := volume)).symm
  let F : Real × WaveSpaceTime → Complex := fun u =>
    P (u.2.1, u.2.2 + u.1) * (k : Real → Complex) u.1 * jointSchwartzRaw G u.2
  have hFmeas : AEStronglyMeasurable F (volume.prod (volume.prod volume)) := by
    have hP : Continuous P := by
      dsimp only [P]
      fun_prop
    have hshift : Continuous (fun u : Real × WaveSpaceTime =>
        (u.2.1, u.2.2 + u.1)) := by
      fun_prop
    have hraw : Continuous (jointSchwartzRaw G) := by
      unfold jointSchwartzRaw
      exact G.continuous.comp (WithLp.prod_continuous_toLp 2 (Euclidean 2) Real)
    have hFcont : Continuous F := by
      dsimp only [F]
      exact ((hP.comp hshift).mul (k.continuous.comp continuous_fst)).mul
        (hraw.comp continuous_snd)
    exact hFcont.aestronglyMeasurable
  have hF : Integrable F (volume.prod (volume.prod volume)) := by
    have hcomp : F ∘ (fun w : WaveSpaceTime × Real =>
        (w.2, (w.1.1, w.1.2 - w.2))) =
        (fun w : WaveSpaceTime × Real =>
          P w.1 * (k : Real → Complex) w.2 *
            jointSchwartzRaw G (w.1.1, w.1.2 - w.2)) := by
      funext w
      change P (w.1.1, (w.1.2 - w.2) + w.2) *
        (k : Real → Complex) w.2 * jointSchwartzRaw G (w.1.1, w.1.2 - w.2) =
        P w.1 * (k : Real → Complex) w.2 *
          jointSchwartzRaw G (w.1.1, w.1.2 - w.2)
      rw [sub_add_cancel]
    have hcompint : Integrable (F ∘ (fun w : WaveSpaceTime × Real =>
        (w.2, (w.1.1, w.1.2 - w.2)))) ((volume.prod volume).prod volume) := by
      rw [hcomp]
      simpa only [P] using htriple
    exact (temporalShear_measurePreserving.integrable_comp hFmeas).mp hcompint
  have htransport :
      (∫ w : WaveSpaceTime × Real,
        P w.1 * (k : Real → Complex) w.2 *
          jointSchwartzRaw G (w.1.1, w.1.2 - w.2)) =
        ∫ u : Real × WaveSpaceTime, F u := by
    have hcomp : F ∘ (temporalShearEquiv : WaveSpaceTime × Real → Real × WaveSpaceTime) =
        (fun w : WaveSpaceTime × Real =>
          P w.1 * (k : Real → Complex) w.2 *
            jointSchwartzRaw G (w.1.1, w.1.2 - w.2)) := by
      funext w
      change P (w.1.1, (w.1.2 - w.2) + w.2) *
        (k : Real → Complex) w.2 * jointSchwartzRaw G (w.1.1, w.1.2 - w.2) =
        P w.1 * (k : Real → Complex) w.2 *
          jointSchwartzRaw G (w.1.1, w.1.2 - w.2)
      rw [sub_add_cancel]
    calc
      (∫ w : WaveSpaceTime × Real,
        P w.1 * (k : Real → Complex) w.2 *
          jointSchwartzRaw G (w.1.1, w.1.2 - w.2)) =
          ∫ w : WaveSpaceTime × Real, F (temporalShearEquiv w) := by
            apply integral_congr_ae
            filter_upwards with w
            exact (congrFun hcomp w).symm
      _ = ∫ u : Real × WaveSpaceTime, F u := by
            exact temporalShear_measurePreserving.integral_comp
              temporalShearEquiv.measurableEmbedding F
  have hphase (s y : Real) :
      (Real.fourierChar (-inner Real (s + y) ζ.2) : Complex) =
        (Real.fourierChar (-inner Real y ζ.2) : Complex) *
          (Real.fourierChar (-inner Real s ζ.2) : Complex) := by
    rw [inner_add_left, neg_add, Real.fourierChar.map_add_eq_mul]
    rw [Circle.coe_mul]
    ring
  have hfactor :
      (∫ u : Real × WaveSpaceTime, F u) =
        (∫ y : Real,
          (Real.fourierChar (-inner Real y ζ.2) : Complex) * (k : Real → Complex) y) *
          (∫ z : WaveSpaceTime,
            P z * jointSchwartzRaw G z) := by
    calc
      (∫ u : Real × WaveSpaceTime, F u) =
          ∫ y : Real, ∫ z : WaveSpaceTime, F (y, z) :=
        integral_prod F hF (μ := volume) (ν := volume.prod volume)
      _ = ∫ y : Real,
          ((Real.fourierChar (-inner Real y ζ.2) : Complex) * (k : Real → Complex) y) *
            (∫ z : WaveSpaceTime, P z * jointSchwartzRaw G z) := by
          apply integral_congr_ae
          filter_upwards with y
          rw [← integral_const_mul]
          apply integral_congr_ae
          filter_upwards with z
          dsimp only [F, P]
          rw [hphase z.2 y]
          ring
      _ =
          (∫ y : Real,
            (Real.fourierChar (-inner Real y ζ.2) : Complex) * (k : Real → Complex) y) *
            (∫ z : WaveSpaceTime, P z * jointSchwartzRaw G z) := by
          rw [integral_mul_const]
  have hkfourier :
      (∫ y : Real,
        (Real.fourierChar (-inner Real y ζ.2) : Complex) * (k : Real → Complex) y) =
        FourierTransform.fourier (k : Real → Complex) ζ.2 := by
    rw [Real.fourier_eq]
    rfl
  have hGfourier :
      (∫ z : WaveSpaceTime, P z * jointSchwartzRaw G z) =
        spaceTimeFourier (jointSchwartzRaw G) ζ := by
    exact (spaceTimeFourier_eq_productIntegral (jointSchwartzRaw G)
      (jointSchwartzRaw_integrable_prod G) ζ).symm
  calc
    spaceTimeFourier (temporalConvolutionJointRaw k G) ζ =
        ∫ z : WaveSpaceTime, P z * R z := by
          dsimp only [R]
          exact spaceTimeFourier_eq_productIntegral R hR ζ
    _ = ∫ w : WaveSpaceTime × Real,
        P w.1 * (k : Real → Complex) w.2 *
          jointSchwartzRaw G (w.1.1, w.1.2 - w.2) := hexpand
    _ = ∫ u : Real × WaveSpaceTime, F u := htransport
    _ = (∫ y : Real,
          (Real.fourierChar (-inner Real y ζ.2) : Complex) * (k : Real → Complex) y) *
          (∫ z : WaveSpaceTime, P z * jointSchwartzRaw G z) := hfactor
    _ = FourierTransform.fourier (k : Real → Complex) ζ.2 *
          spaceTimeFourier (jointSchwartzRaw G) ζ := by rw [hkfourier, hGfourier]

private theorem jointTemporalSchwartzMultiplier_eq_temporalConvolutionJointRaw
    (m k : SchwartzMap Real Complex) (G : SchwartzMap JointWaveSpaceTime Complex)
    (hk : FourierTransform.fourier (k : Real → Complex) = (m : Real → Complex)) :
    jointSchwartzRaw (jointTemporalSchwartzMultiplier m G) =
      temporalConvolutionJointRaw k G := by
  let R : WaveSpaceTime → Complex := temporalConvolutionJointRaw k G
  let Q : SchwartzMap JointWaveSpaceTime Complex :=
    applyTemporalFrequencySymbol m (FourierTransform.fourier G)
  have hRint : Integrable R (volume.prod volume) :=
    integrable_temporalConvolutionJointRaw k G
  have hRcont : Continuous R := continuous_temporalConvolutionJointRaw k G
  have hfourier : FourierTransform.fourier (jointRawLift R) = (Q : JointWaveSpaceTime → Complex) := by
    funext v
    let ζ : WaveSpaceTime := (MeasurableEquiv.toLp 2 WaveSpaceTime).symm v
    have hv : WithLp.toLp 2 ζ = v := by
      exact (MeasurableEquiv.apply_symm_apply (MeasurableEquiv.toLp 2 WaveSpaceTime) v)
    rw [← hv]
    rw [fourier_jointRawLift_eq_spaceTimeFourier R hRint ζ]
    rw [spaceTimeFourier_temporalConvolutionJointRaw]
    rw [spaceTimeFourier_jointSchwartzRaw]
    rw [applyTemporalFrequencySymbol_apply]
    rw [hk]
    rw [← SchwartzMap.fourier_coe]
  have hfourierInt : Integrable (FourierTransform.fourier (jointRawLift R)) volume := by
    rw [hfourier]
    exact Q.integrable
  have hinv : FourierTransform.fourierInv (FourierTransform.fourier (jointRawLift R)) =
      jointRawLift R :=
    Continuous.fourierInv_fourier_eq (continuous_jointRawLift R hRcont)
      (jointRawLift_integrable R hRint) hfourierInt
  have hjoint : jointTemporalSchwartzMultiplier m G =
      jointRawLift R := by
    unfold jointTemporalSchwartzMultiplier
    funext v
    rw [SchwartzMap.fourierInv_coe]
    have hv := congrFun hinv v
    rw [hfourier] at hv
    exact hv
  funext z
  change jointTemporalSchwartzMultiplier m G (WithLp.toLp 2 z) = R z
  rw [hjoint, jointRawLift_apply_toLp]

private theorem verticalProjection_jointSchwartzRaw_eq_temporalConvolutionJointRaw
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) (G : SchwartzMap JointWaveSpaceTime Complex) :
    verticalProjection (beta : Real → Complex) scale n (jointSchwartzRaw G) =
      temporalConvolutionJointRaw
        (FourierTransform.fourierInv (affineVerticalProfile beta scale n hscale)) G := by
  rw [verticalProjection_jointSchwartzRaw_eq_jointTemporalSchwartzMultiplier]
  apply jointTemporalSchwartzMultiplier_eq_temporalConvolutionJointRaw
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]

private theorem verticalProjection_jointSchwartzRaw_eq_temporalIntegral
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) (G : SchwartzMap JointWaveSpaceTime Complex)
    (z : WaveSpaceTime) :
    verticalProjection (beta : Real → Complex) scale n (jointSchwartzRaw G) z =
      ∫ y : Real,
        FourierTransform.fourierInv
          (affineVerticalProfile beta scale n hscale : Real → Complex) y *
          jointSchwartzRaw G (z.1, z.2 - y) := by
  rw [verticalProjection_jointSchwartzRaw_eq_temporalConvolutionJointRaw]
  unfold temporalConvolutionJointRaw
  apply integral_congr_ae
  filter_upwards with y
  rw [← SchwartzMap.fourierInv_coe]

private theorem verticalProjection_jointSchwartzRaw_eq_affineTemporalIntegral
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) (G : SchwartzMap JointWaveSpaceTime Complex)
    (z : WaveSpaceTime) :
    verticalProjection (beta : Real → Complex) scale n (jointSchwartzRaw G) z =
      ∫ y : Real,
        (Real.sqrt scale •
          (Real.fourierChar ((n : Real) * (Real.sqrt scale * y)) •
            FourierTransform.fourierInv (beta : Real → Complex) (Real.sqrt scale * y))) *
          jointSchwartzRaw G (z.1, z.2 - y) := by
  rw [verticalProjection_jointSchwartzRaw_eq_temporalIntegral]
  apply integral_congr_ae
  filter_upwards with y
  exact congrArg (fun q : Complex =>
    q * jointSchwartzRaw G (z.1, z.2 - y))
    (fourierInv_affineVerticalProfile beta scale n hscale y)
  all_goals exact hscale

private theorem verticalProjection_jointSchwartzRaw_eq_temporalMultiplier_timeFiber
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) (G : SchwartzMap JointWaveSpaceTime Complex)
    (x : Euclidean 2) (t : Real) :
    verticalProjection (beta : Real → Complex) scale n (jointSchwartzRaw G) (x, t) =
      verticalTemporalSchwartzMultiplier
        (affineVerticalProfile beta scale n hscale)
        (jointSchwartzTimeFiber G x) t := by
  rw [verticalProjection_jointSchwartzRaw_eq_temporalIntegral]
  rw [verticalTemporalSchwartzMultiplier_eq_convolution]
  unfold convolution
  apply integral_congr_ae
  filter_upwards with y
  rw [← SchwartzMap.fourierInv_coe]
  rw [jointSchwartzTimeFiber_apply]
  rfl

private theorem verticalRecombined_jointSchwartzRaw_eq_temporalSchwartzCore
    (beta : SchwartzMap Real Complex) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) (G : Int → SchwartzMap JointWaveSpaceTime Complex)
    (x : Euclidean 2) (t : Real) :
    verticalRecombined (beta : Real → Complex) scale indices
        (fun n => jointSchwartzRaw (G n)) (x, t) =
      verticalTemporalSchwartzCoreRecombined indices
        (fun n => affineVerticalProfile beta scale n hscale)
        (fun n => jointSchwartzTimeFiber (G n) x) t := by
  unfold verticalRecombined verticalTemporalSchwartzCoreRecombined
  apply Finset.sum_congr rfl
  intro n hn
  exact verticalProjection_jointSchwartzRaw_eq_temporalMultiplier_timeFiber
    beta scale n hscale (G n) x t

private theorem integral_norm_fourierInv_affineVerticalProfile_eq
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) :
    (∫ y : Real,
      ‖(FourierTransform.fourierInv
          (affineVerticalProfile beta scale n hscale) : SchwartzMap Real Complex) y‖) =
      ∫ y : Real, ‖FourierTransform.fourierInv (beta : Real → Complex) y‖ := by
  have hpoint (y : Real) :
      ‖(FourierTransform.fourierInv
          (affineVerticalProfile beta scale n hscale) : SchwartzMap Real Complex) y‖ =
        Real.sqrt scale *
          ‖FourierTransform.fourierInv (beta : Real → Complex) (Real.sqrt scale * y)‖ := by
    rw [SchwartzMap.fourierInv_coe]
    exact norm_fourierInv_affineVerticalProfile beta scale n hscale y
  rw [show (fun y : Real =>
      ‖(FourierTransform.fourierInv
          (affineVerticalProfile beta scale n hscale) : SchwartzMap Real Complex) y‖) =
      fun y : Real => Real.sqrt scale *
        ‖FourierTransform.fourierInv (beta : Real → Complex) (Real.sqrt scale * y)‖ by
      funext y
      exact hpoint y]
  rw [integral_const_mul]
  change Real.sqrt scale *
      (∫ y : Real,
        ‖FourierTransform.fourierInv (beta : Real → Complex) (Real.sqrt scale • y)‖) = _
  rw [Measure.integral_comp_smul_of_nonneg volume
    (fun y : Real => ‖FourierTransform.fourierInv (beta : Real → Complex) y‖)
    (Real.sqrt scale) (hR := Real.sqrt_nonneg _)]
  simp only [Module.finrank_self, pow_one, smul_eq_mul]
  field_simp [Real.sqrt_ne_zero'.mpr hscale]

/-- The scalar algebra underlying the temporal Young estimate. -/
private theorem rv_ennreal_weighted_factor_of_holder
    {p r : Real} (hpq : r.HolderConjugate p) (a b : ENNReal) :
    a * b = a ^ r⁻¹ * (a * b ^ p) ^ p⁻¹ := by
  have hp0 : 0 < p := hpq.symm.pos
  have hr0 : 0 < r := hpq.pos
  have hbinv : (b ^ p) ^ p⁻¹ = b := by
    calc
      (b ^ p) ^ p⁻¹ = b ^ (p * p⁻¹) := (ENNReal.rpow_mul _ _ _).symm
      _ = b := by rw [mul_inv_cancel₀ hp0.ne', ENNReal.rpow_one]
  rw [ENNReal.mul_rpow_of_nonneg _ _ hpq.symm.inv_nonneg]
  rw [hbinv]
  calc
    a * b = a ^ (r⁻¹ + p⁻¹) * b := by rw [hpq.inv_add_inv_eq_one, ENNReal.rpow_one]
    _ = (a ^ r⁻¹ * a ^ p⁻¹) * b := by
      rw [ENNReal.rpow_add_of_nonneg _ _ hpq.inv_nonneg hpq.symm.inv_nonneg]
    _ = a ^ r⁻¹ * (a ^ p⁻¹ * b) := by ring

/-- Pointwise Hölder for convolution in the time coordinate only. -/
private theorem rv_lintegral_temporal_p_pointwise
    (p r : Real) (hpq : r.HolderConjugate p)
    (K : Real → ENNReal) (q : WaveSpaceTime → ENNReal)
    (hK : Measurable K) (hq : Measurable q) (z : WaveSpaceTime) :
    (∫⁻ y : Real, K y * q (z.1, z.2 - y)) ^ p ≤
      (∫⁻ y : Real, K y) ^ (p - 1) *
        ∫⁻ y : Real, K y * q (z.1, z.2 - y) ^ p := by
  have hp0 : 0 < p := hpq.symm.pos
  have hr0 : 0 < r := hpq.pos
  let a : Real → ENNReal := fun y => K y ^ r⁻¹
  let b : Real → ENNReal := fun y =>
    (K y * q (z.1, z.2 - y) ^ p) ^ p⁻¹
  have ha : AEMeasurable a volume := by
    exact (hK.pow measurable_const).aemeasurable
  have hqz : Measurable (fun y : Real => q (z.1, z.2 - y)) :=
    hq.comp (measurable_const.prodMk (measurable_const.sub measurable_id))
  have hb : AEMeasurable b volume := by
    exact ((hK.mul (hqz.pow measurable_const)).pow measurable_const).aemeasurable
  have hholder := ENNReal.lintegral_mul_le_Lp_mul_Lq volume hpq ha hb
  have hleft : (∫⁻ y : Real, (a * b) y) =
      ∫⁻ y : Real, K y * q (z.1, z.2 - y) := by
    apply lintegral_congr
    intro y
    simp only [a, b, Pi.mul_apply]
    exact (rv_ennreal_weighted_factor_of_holder hpq (K y)
      (q (z.1, z.2 - y))).symm
  have hfirst :
      (∫⁻ y : Real, a y ^ r) = ∫⁻ y : Real, K y := by
    apply lintegral_congr
    intro y
    simp only [a]
    rw [← ENNReal.rpow_mul, inv_mul_cancel₀ hr0.ne', ENNReal.rpow_one]
  have hsecond :
      (∫⁻ y : Real, b y ^ p) =
        ∫⁻ y : Real, K y * q (z.1, z.2 - y) ^ p := by
    apply lintegral_congr
    intro y
    simp only [b]
    rw [← ENNReal.rpow_mul, inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one]
  have hholder' :
      (∫⁻ y : Real, K y * q (z.1, z.2 - y)) ≤
        (∫⁻ y : Real, K y) ^ r⁻¹ *
          (∫⁻ y : Real, K y * q (z.1, z.2 - y) ^ p) ^ p⁻¹ := by
    rw [hleft, hfirst, hsecond] at hholder
    simpa only [one_div] using hholder
  have hrp : r⁻¹ * p = p - 1 := by
    rw [← hpq.symm.one_sub_inv]
    field_simp [hp0.ne']
  have hpow := ENNReal.rpow_le_rpow hholder' hp0.le
  calc
    (∫⁻ y : Real, K y * q (z.1, z.2 - y)) ^ p ≤
        ((∫⁻ y : Real, K y) ^ r⁻¹ *
          (∫⁻ y : Real, K y * q (z.1, z.2 - y) ^ p) ^ p⁻¹) ^ p := hpow
    _ = (∫⁻ y : Real, K y) ^ (p - 1) *
        ∫⁻ y : Real, K y * q (z.1, z.2 - y) ^ p := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
      rw [← ENNReal.rpow_mul, ← ENNReal.rpow_mul, hrp,
        inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one]

/-- `Lᵖ` Young inequality for a positive kernel acting in time only. -/
private theorem rv_lintegral_temporal_p_young
    (p r : Real) (hpq : r.HolderConjugate p)
    (K : Real → ENNReal) (q : WaveSpaceTime → ENNReal)
    (hK : Measurable K) (hq : Measurable q) :
    ∫⁻ z : WaveSpaceTime, (∫⁻ y : Real, K y * q (z.1, z.2 - y)) ^ p ≤
      (∫⁻ y : Real, K y) ^ p * ∫⁻ z : WaveSpaceTime, q z ^ p := by
  have hp0 : 0 < p := hpq.symm.pos
  have hpone : 1 ≤ p := hpq.symm.lt.le
  let H : WaveSpaceTime × Real → ENNReal := fun w =>
    K w.2 * q (w.1.1, w.1.2 - w.2) ^ p
  have hH : Measurable H := by
    exact (hK.comp measurable_snd).mul
      ((hq.comp ((measurable_fst.fst).prodMk
        (measurable_fst.snd.sub measurable_snd))).pow measurable_const)
  have hinner : Measurable (fun z : WaveSpaceTime =>
      ∫⁻ y : Real, K y * q (z.1, z.2 - y) ^ p) := by
    exact hH.lintegral_prod_right
  have htranslate (y : Real) :
      (∫⁻ z : WaveSpaceTime, q (z.1, z.2 - y) ^ p) =
        ∫⁻ z : WaveSpaceTime, q z ^ p := by
    have hpres : MeasurePreserving
        (fun z : Euclidean 2 × Real => (z.1, z.2 - y))
        (volume.prod volume) (volume.prod volume) := by
      exact MeasurePreserving.prod (MeasurePreserving.id _)
        (measurePreserving_sub_right volume y)
    rw [Measure.volume_eq_prod]
    simpa only [Function.comp_apply] using hpres.lintegral_comp (hq.pow measurable_const)
  have hdouble :
      (∫⁻ z : WaveSpaceTime, ∫⁻ y : Real, K y * q (z.1, z.2 - y) ^ p) =
        (∫⁻ y : Real, K y) * ∫⁻ z : WaveSpaceTime, q z ^ p := by
    calc
      (∫⁻ z : WaveSpaceTime, ∫⁻ y : Real, K y * q (z.1, z.2 - y) ^ p) =
          ∫⁻ y : Real, ∫⁻ z : WaveSpaceTime, K y * q (z.1, z.2 - y) ^ p := by
        exact lintegral_lintegral_swap hH.aemeasurable
      _ = ∫⁻ y : Real, K y * (∫⁻ z : WaveSpaceTime, q (z.1, z.2 - y) ^ p) := by
        apply lintegral_congr
        intro y
        simpa only [Function.comp_apply, Pi.sub_apply, id_eq] using
          (lintegral_const_mul (K y)
            ((hq.comp ((measurable_id.fst).prodMk
              (measurable_id.snd.sub measurable_const))).pow measurable_const))
      _ = ∫⁻ y : Real, K y * (∫⁻ z : WaveSpaceTime, q z ^ p) := by
        apply lintegral_congr
        intro y
        rw [htranslate y]
      _ = (∫⁻ y : Real, K y) * ∫⁻ z : WaveSpaceTime, q z ^ p :=
        lintegral_mul_const _ hK
  calc
    (∫⁻ z : WaveSpaceTime, (∫⁻ y : Real, K y * q (z.1, z.2 - y)) ^ p) ≤
        ∫⁻ z : WaveSpaceTime, (∫⁻ y : Real, K y) ^ (p - 1) *
          (∫⁻ y : Real, K y * q (z.1, z.2 - y) ^ p) := by
      apply lintegral_mono
      intro z
      exact rv_lintegral_temporal_p_pointwise p r hpq K q hK hq z
    _ = (∫⁻ y : Real, K y) ^ (p - 1) *
        (∫⁻ z : WaveSpaceTime, ∫⁻ y : Real, K y * q (z.1, z.2 - y) ^ p) := by
      rw [lintegral_const_mul _ hinner]
    _ = (∫⁻ y : Real, K y) ^ (p - 1) *
        ((∫⁻ y : Real, K y) * ∫⁻ z : WaveSpaceTime, q z ^ p) := by
      rw [hdouble]
    _ = (∫⁻ y : Real, K y) ^ p * ∫⁻ z : WaveSpaceTime, q z ^ p := by
      calc
        (∫⁻ y : Real, K y) ^ (p - 1) *
            ((∫⁻ y : Real, K y) * ∫⁻ z : WaveSpaceTime, q z ^ p) =
            ((∫⁻ y : Real, K y) ^ (p - 1) *
              ∫⁻ y : Real, K y) * ∫⁻ z : WaveSpaceTime, q z ^ p := by
          ring
        _ =
            ((∫⁻ y : Real, K y) ^ (p - 1) *
              (∫⁻ y : Real, K y) ^ (1 : Real)) *
              ∫⁻ z : WaveSpaceTime, q z ^ p := by rw [ENNReal.rpow_one]
        _ = (∫⁻ y : Real, K y) ^ ((p - 1) + 1) *
              ∫⁻ z : WaveSpaceTime, q z ^ p := by
          rw [← ENNReal.rpow_add_of_nonneg _ _
            (sub_nonneg.mpr hpone) (by norm_num : (0 : Real) ≤ 1)]
        _ = (∫⁻ y : Real, K y) ^ p * ∫⁻ z : WaveSpaceTime, q z ^ p := by
          congr 2
          ring

/-- Coordinatewise complex phases with a common modulus preserve the finite `ℓ²` norm. -/
private theorem rv_pilp_two_coordinatewise_norm_eq
    {ι : Type*} [Fintype ι]
    (a u : ι → Complex) (K : Real)
    (hK : 0 ≤ K) (ha : ∀ i, ‖a i‖ = K) :
    ‖(WithLp.toLp 2 (fun i => a i * u i) :
        PiLp (2 : ENNReal) (fun _ : ι => Complex))‖ =
      K * ‖(WithLp.toLp 2 u : PiLp (2 : ENNReal) (fun _ : ι => Complex))‖ := by
  have hsum :
      (∑ i, ‖a i * u i‖ ^ (2 : Nat)) =
        K ^ (2 : Nat) * ∑ i, ‖u i‖ ^ (2 : Nat) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i hi
    rw [norm_mul, ha i]
    ring
  rw [PiLp.norm_eq_of_L2, PiLp.norm_eq_of_L2]
  rw [hsum, Real.sqrt_mul (sq_nonneg K), Real.sqrt_sq hK]

/-- Move finite coordinatewise Bochner integrals into one `PiLp` integral. -/
private theorem rv_pilp_integral_eq
    {ι : Type*} [Fintype ι]
    (a : ι → Real → Complex) (G : ι → WaveSpaceTime → Complex)
    (z : WaveSpaceTime)
    (hInt : Integrable (fun y : Real =>
      (WithLp.toLp 2 (fun i => a i y * G i (z.1, z.2 - y)) :
        PiLp (2 : ENNReal) (fun _ : ι => Complex))) volume) :
    (WithLp.toLp 2 (fun i => ∫ y : Real,
      a i y * G i (z.1, z.2 - y)) :
        PiLp (2 : ENNReal) (fun _ : ι => Complex)) =
      ∫ y : Real,
        (WithLp.toLp 2 (fun i => a i y * G i (z.1, z.2 - y)) :
          PiLp (2 : ENNReal) (fun _ : ι => Complex)) := by
  ext i
  have hcomm := (PiLp.proj (𝕜 := Complex) (p := (2 : ENNReal))
    (β := fun _ : ι => Complex) i).integral_comp_comm hInt
  exact hcomm

/-- The common-positive-kernel pointwise estimate for a finite packet bundle. -/
private theorem rv_finite_pilp_common_kernel_pointwise
    {ι : Type*} [Fintype ι]
    (a : ι → Real → Complex) (G : ι → WaveSpaceTime → Complex)
    (K : Real → Real)
    (hInt : ∀ z : WaveSpaceTime, Integrable (fun y : Real =>
      (WithLp.toLp 2 (fun i => a i y * G i (z.1, z.2 - y)) :
        PiLp (2 : ENNReal) (fun _ : ι => Complex))) volume)
    (hK : ∀ y, 0 ≤ K y)
    (hmod : ∀ i y, ‖a i y‖ = K y)
    (z : WaveSpaceTime) :
    ‖(WithLp.toLp 2 (fun i => ∫ y : Real,
      a i y * G i (z.1, z.2 - y)) :
        PiLp (2 : ENNReal) (fun _ : ι => Complex))‖ ≤
      ∫ y : Real, K y *
        ‖(WithLp.toLp 2 (fun i => G i (z.1, z.2 - y)) :
          PiLp (2 : ENNReal) (fun _ : ι => Complex))‖ := by
  rw [rv_pilp_integral_eq a G z (hInt z)]
  calc
    ‖∫ y : Real,
        (WithLp.toLp 2 (fun i => a i y * G i (z.1, z.2 - y)) :
          PiLp (2 : ENNReal) (fun _ : ι => Complex))‖ ≤
        ∫ y : Real,
          ‖(WithLp.toLp 2 (fun i => a i y * G i (z.1, z.2 - y)) :
            PiLp (2 : ENNReal) (fun _ : ι => Complex))‖ :=
      norm_integral_le_integral_norm _
    _ = ∫ y : Real, K y *
        ‖(WithLp.toLp 2 (fun i => G i (z.1, z.2 - y)) :
          PiLp (2 : ENNReal) (fun _ : ι => Complex))‖ := by
      apply integral_congr_ae
      filter_upwards with y
      exact rv_pilp_two_coordinatewise_norm_eq
        (fun i => a i y) (fun i => G i (z.1, z.2 - y)) (K y)
        (hK y) (fun i => hmod i y)

/-- ENNReal common-kernel pointwise estimate, ready for Tonelli/Hölder. -/
private theorem rv_finite_pilp_common_kernel_pointwise_enorm
    {ι : Type*} [Fintype ι]
    (a : ι → Real → Complex) (G : ι → WaveSpaceTime → Complex)
    (K : Real → Real)
    (hInt : ∀ z : WaveSpaceTime, Integrable (fun y : Real =>
      (WithLp.toLp 2 (fun i => a i y * G i (z.1, z.2 - y)) :
        PiLp (2 : ENNReal) (fun _ : ι => Complex))) volume)
    (hK : ∀ y, 0 ≤ K y)
    (hmod : ∀ i y, ‖a i y‖ = K y)
    (z : WaveSpaceTime) :
    ‖(WithLp.toLp 2 (fun i => ∫ y : Real,
      a i y * G i (z.1, z.2 - y)) :
        PiLp (2 : ENNReal) (fun _ : ι => Complex))‖ₑ ≤
      ∫⁻ y : Real, ENNReal.ofReal (K y) *
        ‖(WithLp.toLp 2 (fun i => G i (z.1, z.2 - y)) :
          PiLp (2 : ENNReal) (fun _ : ι => Complex))‖ₑ := by
  rw [rv_pilp_integral_eq a G z (hInt z)]
  calc
    ‖∫ y : Real,
        (WithLp.toLp 2 (fun i => a i y * G i (z.1, z.2 - y)) :
          PiLp (2 : ENNReal) (fun _ : ι => Complex))‖ₑ ≤
        ∫⁻ y : Real,
          ‖(WithLp.toLp 2 (fun i => a i y * G i (z.1, z.2 - y)) :
            PiLp (2 : ENNReal) (fun _ : ι => Complex))‖ₑ :=
      enorm_integral_le_lintegral_enorm _
    _ = ∫⁻ y : Real, ENNReal.ofReal (K y) *
        ‖(WithLp.toLp 2 (fun i => G i (z.1, z.2 - y)) :
          PiLp (2 : ENNReal) (fun _ : ι => Complex))‖ₑ := by
      apply lintegral_congr
      intro y
      have h := congrArg ENNReal.ofReal
        (rv_pilp_two_coordinatewise_norm_eq
          (fun i => a i y) (fun i => G i (z.1, z.2 - y)) (K y)
          (hK y) (fun i => hmod i y))
      simpa only [ENNReal.ofReal_mul (hK y), ofReal_norm] using h

/-- The finite vector-valued temporal Young fourth-moment bound. -/
private theorem rv_finite_pilp_common_kernel_lintegral_four
    {ι : Type*} [Fintype ι]
    (a : ι → Real → Complex) (G : ι → WaveSpaceTime → Complex)
    (K : Real → Real)
    (hInt : ∀ z : WaveSpaceTime, Integrable (fun y : Real =>
      (WithLp.toLp 2 (fun i => a i y * G i (z.1, z.2 - y)) :
        PiLp (2 : ENNReal) (fun _ : ι => Complex))) volume)
    (hK : ∀ y, 0 ≤ K y)
    (hmod : ∀ i y, ‖a i y‖ = K y)
    (hKmeas : Measurable (fun y : Real => ENNReal.ofReal (K y)))
    (hGmeas : Measurable (fun z : WaveSpaceTime =>
      ‖(WithLp.toLp 2 (fun i => G i z) :
        PiLp (2 : ENNReal) (fun _ : ι => Complex))‖ₑ)) :
    (∫⁻ z : WaveSpaceTime,
      ‖(WithLp.toLp 2 (fun i => ∫ y : Real,
        a i y * G i (z.1, z.2 - y)) :
          PiLp (2 : ENNReal) (fun _ : ι => Complex))‖ₑ ^ (4 : Real)) ≤
      (∫⁻ y : Real, ENNReal.ofReal (K y)) ^ (4 : Real) *
        ∫⁻ z : WaveSpaceTime,
          ‖(WithLp.toLp 2 (fun i => G i z) :
            PiLp (2 : ENNReal) (fun _ : ι => Complex))‖ₑ ^ (4 : Real) := by
  have hpq : (4 : Real).conjExponent.HolderConjugate (4 : Real) :=
    (Real.HolderConjugate.conjExponent (by norm_num)).symm
  calc
    (∫⁻ z : WaveSpaceTime,
      ‖(WithLp.toLp 2 (fun i => ∫ y : Real,
        a i y * G i (z.1, z.2 - y)) :
          PiLp (2 : ENNReal) (fun _ : ι => Complex))‖ₑ ^ (4 : Real)) ≤
        ∫⁻ z : WaveSpaceTime,
          (∫⁻ y : Real, ENNReal.ofReal (K y) *
            ‖(WithLp.toLp 2 (fun i => G i (z.1, z.2 - y)) :
              PiLp (2 : ENNReal) (fun _ : ι => Complex))‖ₑ) ^ (4 : Real) := by
      apply lintegral_mono
      intro z
      exact ENNReal.rpow_le_rpow
        (rv_finite_pilp_common_kernel_pointwise_enorm a G K hInt hK hmod z)
        (by norm_num)
    _ ≤ (∫⁻ y : Real, ENNReal.ofReal (K y)) ^ (4 : Real) *
        ∫⁻ z : WaveSpaceTime,
          ‖(WithLp.toLp 2 (fun i => G i z) :
            PiLp (2 : ENNReal) (fun _ : ι => Complex))‖ₑ ^ (4 : Real) :=
      rv_lintegral_temporal_p_young 4 (4 : Real).conjExponent hpq
        (fun y => ENNReal.ofReal (K y))
        (fun z => ‖(WithLp.toLp 2 (fun i => G i z) :
          PiLp (2 : ENNReal) (fun _ : ι => Complex))‖ₑ)
        hKmeas hGmeas

/-- The public two-index square function is literally the finite PiLp norm. -/
private theorem rv_angularRadialSquareFunction_eq_pilp
    (radialIndices angularIndices : Finset Int)
    (H : Int → Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    angularRadialSquareFunction radialIndices angularIndices H z =
      ‖(WithLp.toLp 2
        (fun i : ↥(radialIndices.product angularIndices) => H i.1.1 i.1.2 z) :
          PiLp (2 : ENNReal)
            (fun _ : ↥(radialIndices.product angularIndices) => Complex))‖ := by
  rw [PiLp.norm_eq_of_L2]
  change Real.sqrt (∑ n ∈ radialIndices, ∑ ν ∈ angularIndices,
      ‖H n ν z‖ ^ (2 : Nat)) =
    Real.sqrt (∑ i : ↥(radialIndices.product angularIndices),
      ‖H i.1.1 i.1.2 z‖ ^ (2 : Nat))
  rw [Finset.sum_coe_sort (radialIndices.product angularIndices)
    (fun i => ‖H i.1 i.2 z‖ ^ (2 : Nat))]
  exact congrArg Real.sqrt
    (Finset.sum_product radialIndices angularIndices
      (fun i : Int × Int => ‖H i.1 i.2 z‖ ^ (2 : Nat))).symm

/-- Take the exact fourth root of a fourth-moment common-kernel estimate. -/
private theorem rv_eLpNorm_four_le_of_lintegral
    {X E : Type*} [MeasurableSpace X] [NormedAddCommGroup E]
    (mu : Measure X) (f g : X → E) (A : ENNReal)
    (hmoment :
      (∫⁻ x : X, ‖f x‖ₑ ^ (4 : Real) ∂mu) ≤
        A ^ (4 : Real) * ∫⁻ x : X, ‖g x‖ₑ ^ (4 : Real) ∂mu) :
    eLpNorm f (4 : ENNReal) mu ≤ A * eLpNorm g (4 : ENNReal) mu := by
  have hroot := ENNReal.rpow_le_rpow hmoment
    (by norm_num : (0 : Real) ≤ 1 / 4)
  calc
    eLpNorm f (4 : ENNReal) mu =
        (∫⁻ x : X, ‖f x‖ₑ ^ (4 : Real) ∂mu) ^ (1 / 4 : Real) := by
      rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num)]
      norm_num
    _ ≤ (A ^ (4 : Real) * ∫⁻ x : X, ‖g x‖ₑ ^ (4 : Real) ∂mu) ^
        (1 / 4 : Real) := hroot
    _ = A * (∫⁻ x : X, ‖g x‖ₑ ^ (4 : Real) ∂mu) ^ (1 / 4 : Real) := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : Real) ≤ 1 / 4),
        ← ENNReal.rpow_mul]
      norm_num
    _ = A * eLpNorm g (4 : ENNReal) mu := by
      rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num)]
      norm_num

/-- The affine time-integrand of a joint-Schwartz vertical projection is integrable. -/
private theorem rv_integrable_affine_vertical_time_integrand
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) (G : SchwartzMap JointWaveSpaceTime Complex)
    (z : WaveSpaceTime) :
    Integrable (fun y : Real =>
      FourierTransform.fourierInv
        ((affineVerticalProfile beta scale n hscale :
          SchwartzMap Real Complex) : Real → Complex) y *
        jointSchwartzRaw G (z.1, z.2 - y)) volume := by
  let k : SchwartzMap Real Complex := FourierTransform.fourierInv
    (affineVerticalProfile beta scale n hscale)
  let g : SchwartzMap Real Complex :=
    jointSchwartzTimeFiber G z.1
  have hk : Integrable (k : Real → Complex) volume := k.integrable
  have hgmeas : AEStronglyMeasurable (fun y : Real => g (z.2 - y)) volume :=
    (g.continuous.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
  have hgbound : ∀ᵐ y : Real ∂volume,
      ‖g (z.2 - y)‖ ≤ ‖g.toBoundedContinuousFunction‖ := by
    filter_upwards with y
    exact g.toBoundedContinuousFunction.norm_coe_le_norm _
  have hprod := hk.mul_bdd hgmeas hgbound
  simpa only [k, g, SchwartzMap.fourierInv_coe,
    jointSchwartzTimeFiber_apply] using hprod

/-- The finite vector of affine time integrands is Bochner integrable. -/
private theorem rv_integrable_affine_vertical_bundle
    (beta : SchwartzMap Real Complex) (scale : Real)
    (radialIndices angularIndices : Finset Int)
    (hscale : 0 < scale)
    (H : Int → Int → SchwartzMap JointWaveSpaceTime Complex)
    (z : WaveSpaceTime) :
    Integrable (fun y : Real =>
      (WithLp.toLp 2 (fun i : ↥(radialIndices.product angularIndices) =>
        FourierTransform.fourierInv
          ((affineVerticalProfile beta scale i.1.1 hscale :
            SchwartzMap Real Complex) : Real → Complex) y *
          jointSchwartzRaw (H i.1.1 i.1.2) (z.1, z.2 - y)) :
        PiLp (2 : ENNReal)
          (fun _ : ↥(radialIndices.product angularIndices) => Complex))) volume := by
  apply Integrable.of_eval_piLp
  intro i
  change Integrable (fun y : Real =>
    FourierTransform.fourierInv
      ((affineVerticalProfile beta scale i.1.1 hscale :
        SchwartzMap Real Complex) : Real → Complex) y *
      jointSchwartzRaw (H i.1.1 i.1.2) (z.1, z.2 - y)) volume
  exact rv_integrable_affine_vertical_time_integrand beta scale i.1.1 hscale
    (H i.1.1 i.1.2) z

/-- The affine kernels have one common positive modulus. -/
private theorem rv_affine_kernel_norm_eq_common
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) (y : Real) :
    ‖FourierTransform.fourierInv
      ((affineVerticalProfile beta scale n hscale :
        SchwartzMap Real Complex) : Real → Complex) y‖ =
      Real.sqrt scale *
        ‖(FourierTransform.fourierInv beta : SchwartzMap Real Complex)
          (Real.sqrt scale * y)‖ := by
  rw [SchwartzMap.fourierInv_coe]
  simpa only [SchwartzMap.fourierInv_coe] using
    (norm_fourierInv_affineVerticalProfile beta scale n hscale y)

private theorem rv_measurable_affine_kernel_majorant
    (beta : SchwartzMap Real Complex) (scale : Real) :
    Measurable (fun y : Real => ENNReal.ofReal
      (Real.sqrt scale *
        ‖(FourierTransform.fourierInv beta : SchwartzMap Real Complex)
          (Real.sqrt scale * y)‖)) := by
  exact (ENNReal.continuous_ofReal.comp
    (continuous_const.mul
      ((FourierTransform.fourierInv beta).continuous.comp
        (continuous_const.mul continuous_id)).norm)).measurable

/-- Coordinatewise affine integral formula, bundled over finite packet labels. -/
private theorem rv_verticalProjection_bundle_eq_affine_integral
    (beta : SchwartzMap Real Complex) (scale : Real)
    (radialIndices angularIndices : Finset Int)
    (hscale : 0 < scale)
    (H : Int → Int → SchwartzMap JointWaveSpaceTime Complex) :
    (fun z : WaveSpaceTime =>
      (WithLp.toLp 2 (fun i : ↥(radialIndices.product angularIndices) =>
        verticalProjection (beta : Real → Complex) scale i.1.1
          (jointSchwartzRaw (H i.1.1 i.1.2)) z) :
        PiLp (2 : ENNReal)
          (fun _ : ↥(radialIndices.product angularIndices) => Complex))) =
      (fun z : WaveSpaceTime =>
        (WithLp.toLp 2 (fun i : ↥(radialIndices.product angularIndices) =>
          ∫ y : Real,
            FourierTransform.fourierInv
              ((affineVerticalProfile beta scale i.1.1 hscale :
                SchwartzMap Real Complex) : Real → Complex) y *
              jointSchwartzRaw (H i.1.1 i.1.2) (z.1, z.2 - y)) :
          PiLp (2 : ENNReal)
            (fun _ : ↥(radialIndices.product angularIndices) => Complex))) := by
  funext z
  congr 1
  funext i
  exact verticalProjection_jointSchwartzRaw_eq_temporalIntegral
    beta scale i.1.1 hscale (H i.1.1 i.1.2) z

private theorem rv_measurable_joint_packet_bundle_norm
    (radialIndices angularIndices : Finset Int)
    (H : Int → Int → SchwartzMap JointWaveSpaceTime Complex) :
    Measurable (fun z : WaveSpaceTime =>
      ‖(WithLp.toLp 2
        (fun i : ↥(radialIndices.product angularIndices) =>
          jointSchwartzRaw (H i.1.1 i.1.2) z) :
        PiLp (2 : ENNReal)
          (fun _ : ↥(radialIndices.product angularIndices) => Complex))‖ₑ) := by
  have hcont : Continuous (fun z : WaveSpaceTime =>
      (WithLp.toLp 2
        (fun i : ↥(radialIndices.product angularIndices) =>
          jointSchwartzRaw (H i.1.1 i.1.2) z) :
        PiLp (2 : ENNReal)
          (fun _ : ↥(radialIndices.product angularIndices) => Complex))) := by
    unfold jointSchwartzRaw
    exact (PiLp.continuous_toLp 2 _).comp
      (continuous_pi fun i => (H i.1.1 i.1.2).continuous.comp
        (WithLp.prod_continuous_toLp 2 (Euclidean 2) Real))
  exact hcont.enorm.measurable

/-- The common affine-kernel mass is the inverse-Fourier `L¹` mass of `beta`. -/
private theorem rv_lintegral_affine_kernel_majorant_eq
    (beta : SchwartzMap Real Complex) (scale : Real) (hscale : 0 < scale) :
    (∫⁻ y : Real, ENNReal.ofReal
      (Real.sqrt scale *
        ‖(FourierTransform.fourierInv beta : SchwartzMap Real Complex)
          (Real.sqrt scale * y)‖)) =
      ENNReal.ofReal (∫ y : Real,
        ‖FourierTransform.fourierInv (beta : Real → Complex) y‖) := by
  let k : SchwartzMap Real Complex := FourierTransform.fourierInv
    (affineVerticalProfile beta scale 0 hscale)
  have hmass : (∫ y : Real, ‖k y‖) =
      ∫ y : Real, ‖FourierTransform.fourierInv (beta : Real → Complex) y‖ := by
    dsimp only [k]
    exact integral_norm_fourierInv_affineVerticalProfile_eq
      beta scale 0 hscale
  calc
    (∫⁻ y : Real, ENNReal.ofReal
      (Real.sqrt scale *
        ‖(FourierTransform.fourierInv beta : SchwartzMap Real Complex)
          (Real.sqrt scale * y)‖)) =
        ∫⁻ y : Real, ‖k y‖ₑ := by
          apply lintegral_congr
          intro y
          rw [← ofReal_norm]
          congr 1
          symm
          dsimp only [k]
          simpa only [SchwartzMap.fourierInv_coe] using
            (rv_affine_kernel_norm_eq_common beta scale 0 hscale y)
    _ = ENNReal.ofReal (∫ y : Real, ‖k y‖) :=
      (ofReal_integral_norm_eq_lintegral_enorm k.integrable).symm
    _ = ENNReal.ofReal (∫ y : Real,
        ‖FourierTransform.fourierInv (beta : Real → Complex) y‖) := by
      rw [hmass]

/-- End-to-end removal of vertical projections for a finite joint-Schwartz family. -/
theorem removeVerticalProjections_of_schwartz_core
    (beta : SchwartzMap Real Complex) :
    removeVerticalProjections beta := by
  let B : Real := ∫ y : Real,
    ‖FourierTransform.fourierInv (beta : Real → Complex) y‖
  have hB : 0 ≤ B := by
    dsimp only [B]
    exact integral_nonneg fun y => norm_nonneg _
  refine ⟨1 + B, by linarith, ?_⟩
  intro scale hscale radialIndices angularIndices H
  have hscale0 : 0 < scale := by linarith
  let a : ↥(radialIndices.product angularIndices) → Real → Complex :=
    fun i y => FourierTransform.fourierInv
      ((affineVerticalProfile beta scale i.1.1 hscale0 :
        SchwartzMap Real Complex) : Real → Complex) y
  let G : ↥(radialIndices.product angularIndices) → WaveSpaceTime → Complex :=
    fun i z => jointSchwartzRaw (H i.1.1 i.1.2) z
  let K : Real → Real := fun y =>
    Real.sqrt scale *
      ‖(FourierTransform.fourierInv beta : SchwartzMap Real Complex)
        (Real.sqrt scale * y)‖
  let U : WaveSpaceTime →
      PiLp (2 : ENNReal)
        (fun _ : ↥(radialIndices.product angularIndices) => Complex) :=
    fun z => WithLp.toLp 2 (fun i => G i z)
  let V : WaveSpaceTime →
      PiLp (2 : ENNReal)
        (fun _ : ↥(radialIndices.product angularIndices) => Complex) :=
    fun z => WithLp.toLp 2 (fun i =>
      verticalProjection (beta : Real → Complex) scale i.1.1
        (jointSchwartzRaw (H i.1.1 i.1.2)) z)
  let W : WaveSpaceTime →
      PiLp (2 : ENNReal)
        (fun _ : ↥(radialIndices.product angularIndices) => Complex) :=
    fun z => WithLp.toLp 2 (fun i => ∫ y : Real,
      a i y * G i (z.1, z.2 - y))
  have hInt : ∀ z : WaveSpaceTime, Integrable (fun y : Real =>
      (WithLp.toLp 2 (fun i : ↥(radialIndices.product angularIndices) =>
        a i y * G i (z.1, z.2 - y)) :
        PiLp (2 : ENNReal)
          (fun _ : ↥(radialIndices.product angularIndices) => Complex))) volume := by
    intro z
    simpa only [a, G] using
      rv_integrable_affine_vertical_bundle beta scale radialIndices angularIndices
        hscale0 H z
  have hK : ∀ y, 0 ≤ K y := by
    intro y
    exact mul_nonneg (Real.sqrt_nonneg _) (norm_nonneg _)
  have hmod : ∀ i y, ‖a i y‖ = K y := by
    intro i y
    dsimp only [a, K]
    exact rv_affine_kernel_norm_eq_common beta scale i.1.1 hscale0 y
  have hKmeas : Measurable (fun y : Real => ENNReal.ofReal (K y)) := by
    simpa only [K] using rv_measurable_affine_kernel_majorant beta scale
  have hGmeas : Measurable (fun z : WaveSpaceTime =>
      ‖(WithLp.toLp 2 (fun i : ↥(radialIndices.product angularIndices) =>
          G i z) : PiLp (2 : ENNReal)
            (fun _ : ↥(radialIndices.product angularIndices) => Complex))‖ₑ) := by
    simpa only [G] using
      rv_measurable_joint_packet_bundle_norm radialIndices angularIndices H
  have hVW : V = W := by
    simpa only [V, W, a, G] using
      rv_verticalProjection_bundle_eq_affine_integral beta scale
        radialIndices angularIndices hscale0 H
  have hmoment :
      (∫⁻ z : WaveSpaceTime, ‖W z‖ₑ ^ (4 : Real)) ≤
        (∫⁻ y : Real, ENNReal.ofReal (K y)) ^ (4 : Real) *
          ∫⁻ z : WaveSpaceTime, ‖U z‖ₑ ^ (4 : Real) := by
    simpa only [W, U] using
      rv_finite_pilp_common_kernel_lintegral_four a G K hInt hK hmod hKmeas hGmeas
  have hfour :
      eLpNorm W (4 : ENNReal) volume ≤
        (∫⁻ y : Real, ENNReal.ofReal (K y)) *
          eLpNorm U (4 : ENNReal) volume :=
    rv_eLpNorm_four_le_of_lintegral volume W U
      (∫⁻ y : Real, ENNReal.ofReal (K y)) hmoment
  have hmass : (∫⁻ y : Real, ENNReal.ofReal (K y)) = ENNReal.ofReal B := by
    simpa only [K, B] using
      rv_lintegral_affine_kernel_majorant_eq beta scale hscale0
  have hmass_le : (∫⁻ y : Real, ENNReal.ofReal (K y)) ≤
      ENNReal.ofReal (1 + B) := by
    rw [hmass]
    exact ENNReal.ofReal_le_ofReal (by linarith)
  have hfour' : eLpNorm V (4 : ENNReal) volume ≤
      ENNReal.ofReal (1 + B) * eLpNorm U (4 : ENNReal) volume := by
    rw [hVW]
    calc
      eLpNorm W (4 : ENNReal) volume ≤
          (∫⁻ y : Real, ENNReal.ofReal (K y)) *
            eLpNorm U (4 : ENNReal) volume := hfour
      _ ≤ ENNReal.ofReal (1 + B) * eLpNorm U (4 : ENNReal) volume := by
        simpa only [mul_comm] using
          (mul_le_mul_right hmass_le (eLpNorm U (4 : ENNReal) volume))
  have hraw : angularRadialSquareFunction radialIndices angularIndices
      (fun n nu => jointSchwartzRaw (H n nu)) = fun z => ‖U z‖ := by
    funext z
    simpa only [U, G] using
      rv_angularRadialSquareFunction_eq_pilp radialIndices angularIndices
        (fun n nu => jointSchwartzRaw (H n nu)) z
  have hprojected : angularRadialSquareFunction radialIndices angularIndices
      (fun n nu => verticalProjection (beta : Real → Complex) scale n
        (jointSchwartzRaw (H n nu))) = fun z => ‖V z‖ := by
    funext z
    simpa only [V] using
      rv_angularRadialSquareFunction_eq_pilp radialIndices angularIndices
        (fun n nu => verticalProjection (beta : Real → Complex) scale n
          (jointSchwartzRaw (H n nu))) z
  calc
    eLpNorm
        (angularRadialSquareFunction radialIndices angularIndices
          (fun n nu => verticalProjection (beta : Real → Complex) scale n
            (jointSchwartzRaw (H n nu))))
        (4 : ENNReal) volume = eLpNorm V (4 : ENNReal) volume := by
      rw [hprojected, eLpNorm_norm]
    _ ≤ ENNReal.ofReal (1 + B) * eLpNorm U (4 : ENNReal) volume := hfour'
    _ = ENNReal.ofReal (1 + B) *
        eLpNorm (angularRadialSquareFunction radialIndices angularIndices
          (fun n nu => jointSchwartzRaw (H n nu))) (4 : ENNReal) volume := by
      rw [hraw, eLpNorm_norm]

private theorem norm_verticalRecombined_jointSchwartzRaw_le_commonKernelTop
    (beta : SchwartzMap Real Complex) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) (G : Int → SchwartzMap JointWaveSpaceTime Complex)
    {A : Real}
    (hinput : ∀ z : WaveSpaceTime,
      ‖(WithLp.toLp 2
          (fun i : (↥indices) => jointSchwartzRaw (G (i : Int)) z) :
        PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex))‖ ≤ A)
    (x : Euclidean 2) (t : Real) :
    ‖verticalRecombined (beta : Real → Complex) scale indices
        (fun n => jointSchwartzRaw (G n)) (x, t)‖ ≤
      Real.sqrt (indices.card : Real) *
        (∫ y : Real, ‖FourierTransform.fourierInv (beta : Real → Complex) y‖) * A := by
  let m : Int → SchwartzMap Real Complex :=
    fun n => affineVerticalProfile beta scale n hscale
  let g : Int → SchwartzMap Real Complex :=
    fun n => jointSchwartzTimeFiber (G n) x
  let κ : Real → Real := fun y =>
    ‖(FourierTransform.fourierInv (m 0) : SchwartzMap Real Complex) y‖
  have hκ : ∀ y, 0 ≤ κ y := by
    intro y
    exact norm_nonneg _
  have hκint : Integrable κ volume := by
    dsimp only [κ]
    exact (FourierTransform.fourierInv (m 0)).integrable.norm
  have hkernel : ∀ n ∈ indices, ∀ y,
      ‖(FourierTransform.fourierInv (m n) : SchwartzMap Real Complex) y‖ ≤ κ y := by
    intro n hn y
    dsimp only [κ, m]
    rw [SchwartzMap.fourierInv_coe, SchwartzMap.fourierInv_coe]
    rw [norm_fourierInv_affineVerticalProfile beta scale n hscale y,
      norm_fourierInv_affineVerticalProfile beta scale 0 hscale y]
  have hinput' : ∀ u : Real,
      Real.sqrt (∑ n ∈ indices, ‖g n u‖ ^ (2 : Nat)) ≤ A := by
    intro u
    dsimp only [g]
    simp only [jointSchwartzTimeFiber_apply]
    change verticalSquareFunction indices
      (fun n => jointSchwartzRaw (G n)) (x, u) ≤ A
    rw [verticalSquareFunction_eq_norm_piLp]
    exact hinput (x, u)
  have htop := norm_verticalTemporalSchwartzCoreRecombined_le_of_common_kernel
    indices m g κ hκ hκint hkernel hinput' t
  calc
    ‖verticalRecombined (beta : Real → Complex) scale indices
        (fun n => jointSchwartzRaw (G n)) (x, t)‖ =
        ‖verticalTemporalSchwartzCoreRecombined indices m g t‖ := by
          dsimp only [m, g]
          rw [verticalRecombined_jointSchwartzRaw_eq_temporalSchwartzCore]
    _ ≤ Real.sqrt (indices.card : Real) * (∫ y : Real, κ y) * A := htop
    _ = Real.sqrt (indices.card : Real) *
        (∫ y : Real, ‖FourierTransform.fourierInv (beta : Real → Complex) y‖) * A := by
          dsimp only [κ, m]
          rw [integral_norm_fourierInv_affineVerticalProfile_eq beta scale 0 hscale]

/-- The actual finite joint-Schwartz source carrier used by the
vertical-recombination interpolation step. -/
private noncomputable def jointVerticalRecombinedEval
    (indices : Finset Int) (G : Int → SchwartzMap JointWaveSpaceTime Complex) :
    WaveSpaceTime → PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex) :=
  fun z => WithLp.toLp 2 (fun i : (↥indices) => jointSchwartzRaw (G (i : Int)) z)

private noncomputable def jointVerticalRecombinedOutput
    (beta : SchwartzMap Real Complex) (scale : Real) (indices : Finset Int)
    (G : Int → SchwartzMap JointWaveSpaceTime Complex) : WaveSpaceTime → Real :=
  fun z => ‖verticalRecombined (beta : Real → Complex) scale indices
    (fun n => jointSchwartzRaw (G n)) z‖

private noncomputable def jointVerticalRecombinedTopCoefficient
    (beta : SchwartzMap Real Complex) (indices : Finset Int) : Real :=
  Real.sqrt (indices.card : Real) *
    ∫ y : Real, ‖FourierTransform.fourierInv (beta : Real → Complex) y‖

private noncomputable def normalizedJointVerticalRecombinedOutput
    (beta : SchwartzMap Real Complex) (scale : Real) (indices : Finset Int)
    (G : Int → SchwartzMap JointWaveSpaceTime Complex) : WaveSpaceTime → Real :=
  fun z => jointVerticalRecombinedOutput beta scale indices G z /
    (1 + jointVerticalRecombinedTopCoefficient beta indices)

private theorem jointSchwartzRaw_add
    (G H : SchwartzMap JointWaveSpaceTime Complex) :
    jointSchwartzRaw (G + H) = jointSchwartzRaw G + jointSchwartzRaw H := by
  funext z
  rfl

private theorem jointTemporalSchwartzMultiplier_add
    (m : SchwartzMap Real Complex)
    (G H : SchwartzMap JointWaveSpaceTime Complex) :
    jointTemporalSchwartzMultiplier m (G + H) =
      jointTemporalSchwartzMultiplier m G + jointTemporalSchwartzMultiplier m H := by
  unfold jointTemporalSchwartzMultiplier
  rw [FourierTransform.fourier_add]
  unfold applyTemporalFrequencySymbol
  rw [(SchwartzMap.smulLeftCLM Complex (liftTemporalFrequencySymbol m)).map_add]
  rw [FourierTransform.fourierInv_add]

private theorem verticalProjection_jointSchwartzRaw_add
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale)
    (G H : SchwartzMap JointWaveSpaceTime Complex) :
    verticalProjection (beta : Real → Complex) scale n (jointSchwartzRaw (G + H)) =
    verticalProjection (beta : Real → Complex) scale n (jointSchwartzRaw G) +
        verticalProjection (beta : Real → Complex) scale n (jointSchwartzRaw H) := by
  rw [verticalProjection_jointSchwartzRaw_eq_jointTemporalSchwartzMultiplier,
    verticalProjection_jointSchwartzRaw_eq_jointTemporalSchwartzMultiplier,
    verticalProjection_jointSchwartzRaw_eq_jointTemporalSchwartzMultiplier]
  rw [jointTemporalSchwartzMultiplier_add]
  rw [jointSchwartzRaw_add]
  all_goals exact hscale

private theorem verticalRecombined_jointSchwartzRaw_add
    (beta : SchwartzMap Real Complex) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale)
    (G H : Int → SchwartzMap JointWaveSpaceTime Complex) :
    verticalRecombined (beta : Real → Complex) scale indices
        (fun n => jointSchwartzRaw ((G + H) n)) =
      verticalRecombined (beta : Real → Complex) scale indices
          (fun n => jointSchwartzRaw (G n)) +
        verticalRecombined (beta : Real → Complex) scale indices
          (fun n => jointSchwartzRaw (H n)) := by
  funext z
  unfold verticalRecombined
  calc
    (∑ n ∈ indices,
        verticalProjection (beta : Real → Complex) scale n
          (jointSchwartzRaw ((G + H) n)) z) =
      ∑ n ∈ indices,
        (verticalProjection (beta : Real → Complex) scale n
          (jointSchwartzRaw (G n)) z +
          verticalProjection (beta : Real → Complex) scale n
            (jointSchwartzRaw (H n)) z) := by
        apply Finset.sum_congr rfl
        intro n hn
        change verticalProjection (beta : Real → Complex) scale n
          (jointSchwartzRaw (G n + H n)) z = _
        rw [verticalProjection_jointSchwartzRaw_add beta scale n hscale]
        rfl
    _ = (∑ n ∈ indices,
        verticalProjection (beta : Real → Complex) scale n
          (jointSchwartzRaw (G n)) z) +
        ∑ n ∈ indices,
          verticalProjection (beta : Real → Complex) scale n
            (jointSchwartzRaw (H n)) z := by
          rw [Finset.sum_add_distrib]

private theorem continuous_verticalRecombined_jointSchwartzRaw
    (beta : SchwartzMap Real Complex) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) (G : Int → SchwartzMap JointWaveSpaceTime Complex) :
    Continuous (verticalRecombined (beta : Real → Complex) scale indices
      (fun n => jointSchwartzRaw (G n))) := by
  unfold verticalRecombined
  apply continuous_finsetSum
  intro n hn
  rw [verticalProjection_jointSchwartzRaw_eq_temporalConvolutionJointRaw]
  exact continuous_temporalConvolutionJointRaw
    (FourierTransform.fourierInv (affineVerticalProfile beta scale n hscale)) (G n)

private theorem jointVerticalRecombinedTopCoefficient_nonneg
    (beta : SchwartzMap Real Complex) (indices : Finset Int) :
    0 ≤ jointVerticalRecombinedTopCoefficient beta indices := by
  unfold jointVerticalRecombinedTopCoefficient
  exact mul_nonneg (Real.sqrt_nonneg _)
    (integral_nonneg fun y => norm_nonneg _)

private theorem jointVerticalRecombinedOutput_nonneg
    (beta : SchwartzMap Real Complex) (scale : Real) (indices : Finset Int)
    (G : Int → SchwartzMap JointWaveSpaceTime Complex) (z : WaveSpaceTime) :
    0 ≤ jointVerticalRecombinedOutput beta scale indices G z := by
  unfold jointVerticalRecombinedOutput
  exact norm_nonneg _

private theorem jointVerticalRecombinedOutput_subadd
    (beta : SchwartzMap Real Complex) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale)
    (G H : Int → SchwartzMap JointWaveSpaceTime Complex) (z : WaveSpaceTime) :
    jointVerticalRecombinedOutput beta scale indices (G + H) z ≤
      jointVerticalRecombinedOutput beta scale indices G z +
        jointVerticalRecombinedOutput beta scale indices H z := by
  unfold jointVerticalRecombinedOutput
  rw [verticalRecombined_jointSchwartzRaw_add beta scale indices hscale]
  exact norm_add_le _ _

private theorem aestronglyMeasurable_jointVerticalRecombinedOutput
    (beta : SchwartzMap Real Complex) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) (G : Int → SchwartzMap JointWaveSpaceTime Complex) :
    AEStronglyMeasurable (jointVerticalRecombinedOutput beta scale indices G) volume := by
  unfold jointVerticalRecombinedOutput
  exact (continuous_verticalRecombined_jointSchwartzRaw beta scale indices hscale G).norm.aestronglyMeasurable

private theorem jointVerticalRecombinedOutput_top_coefficient
    (beta : SchwartzMap Real Complex) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) (G : Int → SchwartzMap JointWaveSpaceTime Complex)
    {a : Real}
    (hinput : ∀ z : WaveSpaceTime,
      ‖jointVerticalRecombinedEval indices G z‖ ≤ a) :
    ∀ z : WaveSpaceTime,
      jointVerticalRecombinedOutput beta scale indices G z ≤
        jointVerticalRecombinedTopCoefficient beta indices * a := by
  rintro ⟨x, t⟩
  unfold jointVerticalRecombinedOutput jointVerticalRecombinedTopCoefficient
  apply norm_verticalRecombined_jointSchwartzRaw_le_commonKernelTop
    beta scale indices hscale G
  simpa only [jointVerticalRecombinedEval] using hinput

private theorem normalizedJointVerticalRecombinedOutput_nonneg
    (beta : SchwartzMap Real Complex) (scale : Real) (indices : Finset Int)
    (G : Int → SchwartzMap JointWaveSpaceTime Complex) (z : WaveSpaceTime) :
    0 ≤ normalizedJointVerticalRecombinedOutput beta scale indices G z := by
  unfold normalizedJointVerticalRecombinedOutput
  have hB : 0 ≤ jointVerticalRecombinedTopCoefficient beta indices :=
    jointVerticalRecombinedTopCoefficient_nonneg beta indices
  exact div_nonneg (jointVerticalRecombinedOutput_nonneg beta scale indices G z)
    (by linarith)

private theorem normalizedJointVerticalRecombinedOutput_subadd
    (beta : SchwartzMap Real Complex) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale)
    (G H : Int → SchwartzMap JointWaveSpaceTime Complex) (z : WaveSpaceTime) :
    normalizedJointVerticalRecombinedOutput beta scale indices (G + H) z ≤
      normalizedJointVerticalRecombinedOutput beta scale indices G z +
        normalizedJointVerticalRecombinedOutput beta scale indices H z := by
  unfold normalizedJointVerticalRecombinedOutput
  rw [← add_div]
  apply div_le_div_of_nonneg_right
    (jointVerticalRecombinedOutput_subadd beta scale indices hscale G H z)
  have hB : 0 ≤ jointVerticalRecombinedTopCoefficient beta indices :=
    jointVerticalRecombinedTopCoefficient_nonneg beta indices
  linarith

private theorem aemeasurable_normalizedJointVerticalRecombinedOutput
    (beta : SchwartzMap Real Complex) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) (G : Int → SchwartzMap JointWaveSpaceTime Complex) :
    AEMeasurable (normalizedJointVerticalRecombinedOutput beta scale indices G) volume := by
  unfold normalizedJointVerticalRecombinedOutput
  exact (aestronglyMeasurable_jointVerticalRecombinedOutput beta scale indices hscale G).aemeasurable.div_const _

private theorem normalizedJointVerticalRecombinedOutput_sourceOutput_top
    (beta : SchwartzMap Real Complex) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) :
    ∀ (G : Int → SchwartzMap JointWaveSpaceTime Complex), G ∈ (Set.univ : Set _) →
      ∀ (a : Real), 0 ≤ a →
        (∀ z, ‖jointVerticalRecombinedEval indices G z‖ ≤ a) →
          ∀ z, normalizedJointVerticalRecombinedOutput beta scale indices G z ≤ a := by
  intro G _ a ha hinput z
  have hB0 : 0 ≤ jointVerticalRecombinedTopCoefficient beta indices :=
    jointVerticalRecombinedTopCoefficient_nonneg beta indices
  have hBtop_pos : 0 < 1 + jointVerticalRecombinedTopCoefficient beta indices := by
    linarith
  unfold normalizedJointVerticalRecombinedOutput
  apply (div_le_iff₀ hBtop_pos).2
  calc
    jointVerticalRecombinedOutput beta scale indices G z ≤
        jointVerticalRecombinedTopCoefficient beta indices * a :=
      jointVerticalRecombinedOutput_top_coefficient beta scale indices hscale G hinput z
    _ ≤ (1 + jointVerticalRecombinedTopCoefficient beta indices) * a :=
      mul_le_mul_of_nonneg_right (by linarith) ha
    _ = a * (1 + jointVerticalRecombinedTopCoefficient beta indices) := by ring

private theorem normalizedJointVerticalRecombinedOutput_sourceOutput_subadd
    (beta : SchwartzMap Real Complex) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) :
    ∀ ⦃G H : Int → SchwartzMap JointWaveSpaceTime Complex⦄,
      G ∈ (Set.univ : Set _) → H ∈ (Set.univ : Set _) → ∀ z,
        normalizedJointVerticalRecombinedOutput beta scale indices (G + H) z ≤
          normalizedJointVerticalRecombinedOutput beta scale indices G z +
            normalizedJointVerticalRecombinedOutput beta scale indices H z := by
  intro G H _ _ z
  exact normalizedJointVerticalRecombinedOutput_subadd beta scale indices hscale G H z

/-- The source-side finite `ℓ²` bundle.  This is definitionally the bundle
used by the public weak-two scratch endpoint, while `jointVerticalRecombinedEval`
is its physical-coordinate pullback. -/
private noncomputable def jointVerticalRecombinedSourceEval
    (indices : Finset Int) (G : Int → SchwartzMap JointWaveSpaceTime Complex) :
    JointWaveSpaceTime → PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex) :=
  fun ζ => WithLp.toLp 2 (fun i : (↥indices) => G (i : Int) ζ)

private theorem jointVerticalRecombinedSourceEval_eq_scratchJointBundle
    (indices : Finset Int) (G : Int → SchwartzMap JointWaveSpaceTime Complex) :
    jointVerticalRecombinedSourceEval indices G = scratchJointBundle indices G := rfl

private theorem jointVerticalRecombinedEval_eq_sourceEval_comp
    (indices : Finset Int) (G : Int → SchwartzMap JointWaveSpaceTime Complex)
    (z : WaveSpaceTime) :
    jointVerticalRecombinedEval indices G z =
      jointVerticalRecombinedSourceEval indices G (WithLp.toLp 2 z) := rfl

private theorem normalizedJointVerticalRecombinedOutput_sourceOutput_top_joint
    (beta : SchwartzMap Real Complex) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) :
    ∀ (G : Int → SchwartzMap JointWaveSpaceTime Complex), G ∈ (Set.univ : Set _) →
      ∀ (a : Real), 0 ≤ a →
        (∀ ζ, ‖jointVerticalRecombinedSourceEval indices G ζ‖ ≤ a) →
          ∀ z, normalizedJointVerticalRecombinedOutput beta scale indices G z ≤ a := by
  intro G hG a ha hinput z
  apply normalizedJointVerticalRecombinedOutput_sourceOutput_top
    beta scale indices hscale G hG a ha
  intro w
  rw [jointVerticalRecombinedEval_eq_sourceEval_comp]
  exact hinput _

/-- The public weak-two endpoint transports to the normalized common-kernel
source-output carrier.  The normalization is exactly what turns the sharp
finite top coefficient into the literal `T ≤ a` hypothesis of the supplied
split Marcinkiewicz lemma. -/
private theorem normalizedJointVerticalRecombinedOutput_weak_two
    (B : ScratchVerticalCutoff) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) :
    ∀ (G : Int → SchwartzMap JointWaveSpaceTime Complex), G ∈ (Set.univ : Set _) →
      ∀ {s : Real}, 0 < s →
        (ENNReal.ofReal s) ^ (2 : Real) *
          volume {z : WaveSpaceTime |
            s < normalizedJointVerticalRecombinedOutput B.cutoff scale indices G z} ≤
          ((ENNReal.ofReal
              (1 + jointVerticalRecombinedTopCoefficient B.cutoff indices)) ^ (2 : Real))⁻¹ *
            ENNReal.ofReal
              (3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat)) *
              ∫⁻ ζ : JointWaveSpaceTime,
                (ENNReal.ofReal
                  ‖jointVerticalRecombinedSourceEval indices G ζ‖) ^ (2 : Real) := by
  intro G _ s hs
  let btop : Real := 1 + jointVerticalRecombinedTopCoefficient B.cutoff indices
  let b : ENNReal := (ENNReal.ofReal btop) ^ (2 : Real)
  have hcoef : 0 ≤ jointVerticalRecombinedTopCoefficient B.cutoff indices :=
    jointVerticalRecombinedTopCoefficient_nonneg B.cutoff indices
  have hbtop : 0 < btop := by
    dsimp only [btop]
    linarith
  have hbpos : 0 < b := by
    dsimp only [b]
    exact ENNReal.rpow_pos (ENNReal.ofReal_pos.mpr hbtop) ENNReal.ofReal_ne_top
  have hbtop_ne : b ≠ ∞ := by
    dsimp only [b]
    exact ENNReal.rpow_ne_top_of_nonneg (by norm_num) ENNReal.ofReal_ne_top
  have hset :
      {z : WaveSpaceTime |
          s < normalizedJointVerticalRecombinedOutput B.cutoff scale indices G z} =
        {z : WaveSpaceTime |
          s * btop < jointVerticalRecombinedOutput B.cutoff scale indices G z} := by
    ext z
    exact lt_div_iff₀ hbtop
  have hfactor : (ENNReal.ofReal (s * btop)) ^ (2 : Real) =
      b * (ENNReal.ofReal s) ^ (2 : Real) := by
    dsimp only [b]
    rw [ENNReal.ofReal_mul hs.le,
      ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : 0 ≤ (2 : Real))]
    ac_rfl
  have hraw :
      (ENNReal.ofReal (s * btop)) ^ (2 : Real) *
          volume {z : WaveSpaceTime |
            s * btop < jointVerticalRecombinedOutput B.cutoff scale indices G z} ≤
        ENNReal.ofReal
            (3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat)) *
          ∫⁻ ζ : JointWaveSpaceTime,
            (ENNReal.ofReal
              ‖jointVerticalRecombinedSourceEval indices G ζ‖) ^ (2 : Real) := by
    simpa only [jointVerticalRecombinedOutput,
      jointVerticalRecombinedSourceEval_eq_scratchJointBundle] using
      (scratch_verticalRecombined_weak_two_jointBundle B scale indices hscale G
        (mul_pos hs hbtop))
  apply (ENNReal.mul_le_mul_iff_right hbpos.ne' hbtop_ne).mp
  change b * ((ENNReal.ofReal s) ^ (2 : Real) *
      volume {z : WaveSpaceTime |
        s < normalizedJointVerticalRecombinedOutput B.cutoff scale indices G z}) ≤
    b * (b⁻¹ * ENNReal.ofReal
      (3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat)) *
      ∫⁻ ζ : JointWaveSpaceTime,
        (ENNReal.ofReal ‖jointVerticalRecombinedSourceEval indices G ζ‖) ^ (2 : Real))
  calc
    b * ((ENNReal.ofReal s) ^ (2 : Real) *
        volume {z : WaveSpaceTime |
          s < normalizedJointVerticalRecombinedOutput B.cutoff scale indices G z}) =
        (ENNReal.ofReal (s * btop)) ^ (2 : Real) *
          volume {z : WaveSpaceTime |
            s * btop < jointVerticalRecombinedOutput B.cutoff scale indices G z} := by
      rw [hset, hfactor]
      ac_rfl
    _ ≤ ENNReal.ofReal
          (3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat)) *
        ∫⁻ ζ : JointWaveSpaceTime,
          (ENNReal.ofReal ‖jointVerticalRecombinedSourceEval indices G ζ‖) ^ (2 : Real) := hraw
    _ = b * (b⁻¹ * ENNReal.ofReal
          (3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat)) *
        ∫⁻ ζ : JointWaveSpaceTime,
          (ENNReal.ofReal ‖jointVerticalRecombinedSourceEval indices G ζ‖) ^ (2 : Real)) := by
      rw [show b * (b⁻¹ * ENNReal.ofReal
          (3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat)) *
          ∫⁻ ζ : JointWaveSpaceTime,
            (ENNReal.ofReal ‖jointVerticalRecombinedSourceEval indices G ζ‖) ^ (2 : Real)) =
          (b * b⁻¹) * (ENNReal.ofReal
            (3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat)) *
            ∫⁻ ζ : JointWaveSpaceTime,
              (ENNReal.ofReal ‖jointVerticalRecombinedSourceEval indices G ζ‖) ^ (2 : Real)) by
          ac_rfl,
        ENNReal.mul_inv_cancel hbpos.ne' hbtop_ne, one_mul]

/-- The supplied smooth split and the normalized weak-two/top package give
the exact finite-`p` Marcinkiewicz moment bound on the joint-Schwartz core. -/
private theorem normalizedJointVerticalRecombinedOutput_moment
    (B : ScratchVerticalCutoff) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) {p : Real} (hp : (2 : Real) < p)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex) :
    (∫⁻ z : WaveSpaceTime,
      ENNReal.ofReal
        ((normalizedJointVerticalRecombinedOutput B.cutoff scale indices H z) ^ p)) ≤
      ENNReal.ofReal p *
        ((ENNReal.ofReal (2 : Real)) ^ (2 : Real) *
          (((ENNReal.ofReal
              (1 + jointVerticalRecombinedTopCoefficient B.cutoff indices)) ^ (2 : Real))⁻¹ *
            ENNReal.ofReal
              (3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat))) *
          ((ENNReal.ofReal (p - 2))⁻¹ *
            (ENNReal.ofReal (4 : Real)) ^ (p - 2) *
              ∫⁻ ζ : JointWaveSpaceTime,
                (ENNReal.ofReal
                  ‖jointVerticalRecombinedSourceEval indices H ζ‖) ^ p)) := by
  rcases SmoothSplit.exists_sourceOutput_compatible_jointSchwartz_smooth_split
      indices H (by norm_num : 0 < (2 : Real)) hp with
    ⟨L, U, hsplit, hlow, hUmeas, hUtail⟩
  exact sourceOutput_marcinkiewicz_weak_q_top_on_additive_split
    (D := Set.univ) (eval := jointVerticalRecombinedSourceEval indices)
    (normalizedJointVerticalRecombinedOutput B.cutoff scale indices)
    (by
      intro g z
      exact normalizedJointVerticalRecombinedOutput_nonneg B.cutoff scale indices g z)
    (by
      intro g h hg hh z
      exact normalizedJointVerticalRecombinedOutput_sourceOutput_subadd
        B.cutoff scale indices hscale hg hh z)
    (2 : Real) (by norm_num)
    (((ENNReal.ofReal
        (1 + jointVerticalRecombinedTopCoefficient B.cutoff indices)) ^ (2 : Real))⁻¹ *
      ENNReal.ofReal
        (3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat)))
    (by
      intro g hg s hs
      exact normalizedJointVerticalRecombinedOutput_weak_two
        B scale indices hscale g hg hs)
    (by
      intro g hg a ha hga z
      exact normalizedJointVerticalRecombinedOutput_sourceOutput_top_joint
        B.cutoff scale indices hscale g hg a ha hga z)
    hp H
    (aemeasurable_normalizedJointVerticalRecombinedOutput
      B.cutoff scale indices hscale H)
    L U
    (by intro t; simp) (by intro t; simp)
    (by
      intro t
      funext n
      exact hsplit t n)
    (by
      intro t ht ζ
      simpa only [jointVerticalRecombinedSourceEval] using hlow t ht ζ)
    (by
      simpa only [jointVerticalRecombinedSourceEval] using hUmeas)
    ((ENNReal.ofReal (p - 2))⁻¹ *
      (ENNReal.ofReal (4 : Real)) ^ (p - 2) *
        ∫⁻ ζ : JointWaveSpaceTime,
          (ENNReal.ofReal
            ‖jointVerticalRecombinedSourceEval indices H ζ‖) ^ p)
    (by
      convert hUtail using 1 <;> rfl)

private noncomputable def jointVerticalFiniteInterpolationCoefficient
    (B : ScratchVerticalCutoff) (indices : Finset Int) (p : Real) : ENNReal :=
  ENNReal.ofReal p *
    ((ENNReal.ofReal (2 : Real)) ^ (2 : Real) *
      (((ENNReal.ofReal
          (1 + jointVerticalRecombinedTopCoefficient B.cutoff indices)) ^ (2 : Real))⁻¹ *
        ENNReal.ofReal
          (3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat))) *
      ((ENNReal.ofReal (p - 2))⁻¹ *
        (ENNReal.ofReal (4 : Real)) ^ (p - 2)))

/-- Exact finite-`p` norm form before the final cardinality-to-scale algebra.
The source factor is deliberately kept on `JointWaveSpaceTime`; it is carried
to the physical square function by a measure-preserving `WithLp` bridge below. -/
private theorem eLpNorm_verticalRecombined_jointSchwartz_le_finite_source
    (B : ScratchVerticalCutoff) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) {p : Real} (hp : (2 : Real) < p)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex) :
    eLpNorm
        (verticalRecombined (B.cutoff : Real → Complex) scale indices
          (fun n => jointSchwartzRaw (H n)))
        (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal
        (1 + jointVerticalRecombinedTopCoefficient B.cutoff indices) *
        (jointVerticalFiniteInterpolationCoefficient B indices p) ^ p⁻¹ *
        eLpNorm (jointVerticalRecombinedSourceEval indices H)
          (ENNReal.ofReal p) volume := by
  let btop : Real := 1 + jointVerticalRecombinedTopCoefficient B.cutoff indices
  let K : ENNReal := jointVerticalFiniteInterpolationCoefficient B indices p
  have hcoef : 0 ≤ jointVerticalRecombinedTopCoefficient B.cutoff indices :=
    jointVerticalRecombinedTopCoefficient_nonneg B.cutoff indices
  have hbtop : 0 < btop := by
    dsimp only [btop]
    linarith
  have hmoment :
      (∫⁻ z : WaveSpaceTime,
        ENNReal.ofReal
          ((normalizedJointVerticalRecombinedOutput B.cutoff scale indices H z) ^ p)) ≤
        K * ∫⁻ ζ : JointWaveSpaceTime,
          (ENNReal.ofReal
            ‖jointVerticalRecombinedSourceEval indices H ζ‖) ^ p := by
    dsimp only [K, btop, jointVerticalFiniteInterpolationCoefficient]
    simpa only [mul_assoc] using
      (normalizedJointVerticalRecombinedOutput_moment B scale indices hscale hp H)
  have hbound := sourceOutput_eLpNorm_le_of_nonnegative_moment
    (normalizedJointVerticalRecombinedOutput B.cutoff scale indices) H
    (lt_trans (by norm_num) hp)
    (normalizedJointVerticalRecombinedOutput_nonneg B.cutoff scale indices H)
    (K * ∫⁻ ζ : JointWaveSpaceTime,
      (ENNReal.ofReal ‖jointVerticalRecombinedSourceEval indices H ζ‖) ^ p)
    hmoment
  have hin :
      (∫⁻ ζ : JointWaveSpaceTime,
        (ENNReal.ofReal ‖jointVerticalRecombinedSourceEval indices H ζ‖) ^ p) =
        (eLpNorm (jointVerticalRecombinedSourceEval indices H)
          (ENNReal.ofReal p) volume) ^ p :=
    Codex.Spherical.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow
      (lt_trans (by norm_num) hp) (jointVerticalRecombinedSourceEval indices H)
  rw [hin] at hbound
  have hbound' :
      eLpNorm (normalizedJointVerticalRecombinedOutput B.cutoff scale indices H)
          (ENNReal.ofReal p) volume ≤
        K ^ p⁻¹ * eLpNorm (jointVerticalRecombinedSourceEval indices H)
          (ENNReal.ofReal p) volume := by
    calc
      eLpNorm (normalizedJointVerticalRecombinedOutput B.cutoff scale indices H)
          (ENNReal.ofReal p) volume ≤
        (K * (eLpNorm (jointVerticalRecombinedSourceEval indices H)
          (ENNReal.ofReal p) volume) ^ p) ^ p⁻¹ := hbound
      _ = K ^ p⁻¹ * eLpNorm (jointVerticalRecombinedSourceEval indices H)
          (ENNReal.ofReal p) volume := by
        rw [ENNReal.mul_rpow_of_nonneg _ _
          (inv_nonneg.mpr (lt_trans (by norm_num) hp).le),
          ← ENNReal.rpow_mul]
        have hpp : p * p⁻¹ = (1 : Real) := by field_simp
        rw [hpp, ENNReal.rpow_one]
  have hraw : jointVerticalRecombinedOutput B.cutoff scale indices H =
      btop • normalizedJointVerticalRecombinedOutput B.cutoff scale indices H := by
    funext z
    change ‖verticalRecombined (B.cutoff : Real → Complex) scale indices
      (fun n => jointSchwartzRaw (H n)) z‖ =
      btop * (‖verticalRecombined (B.cutoff : Real → Complex) scale indices
        (fun n => jointSchwartzRaw (H n)) z‖ / btop)
    field_simp [hbtop.ne']
  calc
    eLpNorm
        (verticalRecombined (B.cutoff : Real → Complex) scale indices
          (fun n => jointSchwartzRaw (H n)))
        (ENNReal.ofReal p) volume =
        eLpNorm (jointVerticalRecombinedOutput B.cutoff scale indices H)
          (ENNReal.ofReal p) volume := by
            rw [← eLpNorm_norm]
            rfl
    _ = ENNReal.ofReal btop *
        eLpNorm (normalizedJointVerticalRecombinedOutput B.cutoff scale indices H)
          (ENNReal.ofReal p) volume := by
            rw [hraw, eLpNorm_const_smul,
              Real.enorm_eq_ofReal hbtop.le]
    _ ≤ ENNReal.ofReal btop *
        (K ^ p⁻¹ * eLpNorm (jointVerticalRecombinedSourceEval indices H)
          (ENNReal.ofReal p) volume) :=
      mul_le_mul_right hbound' _
    _ = ENNReal.ofReal
        (1 + jointVerticalRecombinedTopCoefficient B.cutoff indices) *
        (jointVerticalFiniteInterpolationCoefficient B indices p) ^ p⁻¹ *
        eLpNorm (jointVerticalRecombinedSourceEval indices H)
          (ENNReal.ofReal p) volume := by
            dsimp only [K, btop]
            ac_rfl

private theorem continuous_jointVerticalRecombinedSourceEval
    (indices : Finset Int) (H : Int → SchwartzMap JointWaveSpaceTime Complex) :
    Continuous (jointVerticalRecombinedSourceEval indices H) := by
  unfold jointVerticalRecombinedSourceEval
  apply (PiLp.continuous_toLp 2 (fun _ : (↥indices) => Complex)).comp
  apply continuous_pi
  intro i
  exact (H (i : Int)).continuous

/-- The source bundle is the physical vertical square function after the
canonical measure-preserving `WithLp` change of coordinates. -/
private theorem eLpNorm_jointVerticalRecombinedSourceEval_eq_verticalSquareFunction
    (indices : Finset Int) (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    (p : ENNReal) :
    eLpNorm (jointVerticalRecombinedSourceEval indices H) p volume =
      eLpNorm (verticalSquareFunction indices
        (fun n => jointSchwartzRaw (H n))) p volume := by
  let e : WaveSpaceTime → JointWaveSpaceTime := WithLp.toLp 2
  have hpres : MeasurePreserving e volume volume := by
    simpa only [e] using
      (WithLp.volume_preserving_toLp (Euclidean 2) Real)
  calc
    eLpNorm (jointVerticalRecombinedSourceEval indices H) p volume =
        eLpNorm (jointVerticalRecombinedSourceEval indices H ∘ e) p volume := by
          symm
          apply eLpNorm_comp_measurePreserving
          · exact (continuous_jointVerticalRecombinedSourceEval indices H).aestronglyMeasurable
          · exact hpres
    _ = eLpNorm (fun z : WaveSpaceTime =>
        ‖jointVerticalRecombinedSourceEval indices H (e z)‖) p volume := by
          rw [eLpNorm_norm]
          rfl
    _ = eLpNorm (verticalSquareFunction indices
        (fun n => jointSchwartzRaw (H n))) p volume := by
          apply eLpNorm_congr_ae
          filter_upwards with z
          rw [verticalSquareFunction_eq_norm_piLp]
          rfl

private theorem eLpNorm_verticalRecombined_jointSchwartz_le_finite
    (B : ScratchVerticalCutoff) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) {p : Real} (hp : (2 : Real) < p)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex) :
    eLpNorm
        (verticalRecombined (B.cutoff : Real → Complex) scale indices
          (fun n => jointSchwartzRaw (H n)))
        (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal
        (1 + jointVerticalRecombinedTopCoefficient B.cutoff indices) *
        (jointVerticalFiniteInterpolationCoefficient B indices p) ^ p⁻¹ *
        eLpNorm (verticalSquareFunction indices
          (fun n => jointSchwartzRaw (H n))) (ENNReal.ofReal p) volume := by
  calc
    eLpNorm
        (verticalRecombined (B.cutoff : Real → Complex) scale indices
          (fun n => jointSchwartzRaw (H n)))
        (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal
          (1 + jointVerticalRecombinedTopCoefficient B.cutoff indices) *
          (jointVerticalFiniteInterpolationCoefficient B indices p) ^ p⁻¹ *
          eLpNorm (jointVerticalRecombinedSourceEval indices H)
            (ENNReal.ofReal p) volume :=
      eLpNorm_verticalRecombined_jointSchwartz_le_finite_source
        B scale indices hscale hp H
    _ = ENNReal.ofReal
        (1 + jointVerticalRecombinedTopCoefficient B.cutoff indices) *
        (jointVerticalFiniteInterpolationCoefficient B indices p) ^ p⁻¹ *
        eLpNorm (verticalSquareFunction indices
          (fun n => jointSchwartzRaw (H n))) (ENNReal.ofReal p) volume := by
      rw [eLpNorm_jointVerticalRecombinedSourceEval_eq_verticalSquareFunction]

private theorem continuous_jointVerticalRecombinedEval
    (indices : Finset Int) (H : Int → SchwartzMap JointWaveSpaceTime Complex) :
    Continuous (jointVerticalRecombinedEval indices H) := by
  unfold jointVerticalRecombinedEval jointSchwartzRaw
  exact (PiLp.continuous_toLp 2 (fun _ : (↥indices) => Complex)).comp
    (continuous_pi fun i => (H (i : Int)).continuous.comp
      (WithLp.prod_continuous_toLp 2 (Euclidean 2) Real))
private theorem jointVertical_top_constant_le_scale_quarter
    {scale C0 A card : Real}
    (hscale : (2 : Real) ≤ scale) (hC0 : 0 ≤ C0) (hA : 0 ≤ A)
    (hcard_upper : card ≤ C0 * Real.sqrt scale) :
    1 + A * Real.sqrt card ≤
      (1 + A * Real.sqrt C0) * scale ^ (1 / 4 : Real) := by
  have hscale0 : 0 ≤ scale := by linarith
  have hscale1 : 1 ≤ scale := by linarith
  have hquarter : Real.sqrt (Real.sqrt scale) = scale ^ (1 / 4 : Real) := by
    rw [Real.sqrt_eq_rpow, Real.sqrt_eq_rpow, ← Real.rpow_mul hscale0]
    congr 1
    norm_num
  have hsqrt : Real.sqrt card ≤ Real.sqrt C0 * scale ^ (1 / 4 : Real) := by
    calc
      Real.sqrt card ≤ Real.sqrt (C0 * Real.sqrt scale) :=
        Real.sqrt_le_sqrt hcard_upper
      _ = Real.sqrt C0 * Real.sqrt (Real.sqrt scale) := by
        rw [Real.sqrt_mul hC0]
      _ = Real.sqrt C0 * scale ^ (1 / 4 : Real) := by rw [hquarter]
  have hmul : A * Real.sqrt card ≤
      A * (Real.sqrt C0 * scale ^ (1 / 4 : Real)) :=
    mul_le_mul_of_nonneg_left hsqrt hA
  have hpow : 1 ≤ scale ^ (1 / 4 : Real) :=
    Real.one_le_rpow hscale1 (by norm_num)
  calc
    1 + A * Real.sqrt card ≤
        1 + A * (Real.sqrt C0 * scale ^ (1 / 4 : Real)) := by linarith
    _ ≤ scale ^ (1 / 4 : Real) +
        A * (Real.sqrt C0 * scale ^ (1 / 4 : Real)) := by linarith
    _ = (1 + A * Real.sqrt C0) * scale ^ (1 / 4 : Real) := by ring

private theorem jointVertical_verticalRecombinationGain_top :
    verticalRecombinationGain ⊤ = 1 / 4 := by
  rw [verticalRecombinationGain, if_pos rfl]

private theorem jointVertical_ennreal_sqrt_card_top_constant_le_vertical_gain_top
    {scale C0 A : Real} (indices : Finset Int)
    (hscale : (2 : Real) ≤ scale) (hC0 : 0 ≤ C0) (hA : 0 ≤ A)
    (hcard_upper : (indices.card : Real) ≤ C0 * Real.sqrt scale) :
    ENNReal.ofReal (1 + Real.sqrt (indices.card : Real) * A) ≤
      ENNReal.ofReal
        ((1 + A * Real.sqrt C0) * scale ^ verticalRecombinationGain ⊤) := by
  rw [jointVertical_verticalRecombinationGain_top]
  apply ENNReal.ofReal_le_ofReal
  simpa [mul_comm] using
    (jointVertical_top_constant_le_scale_quarter hscale hC0 hA hcard_upper)
private noncomputable def jointVerticalRecombinedSchwartz
    (beta : SchwartzMap Real Complex) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) (H : Int → SchwartzMap JointWaveSpaceTime Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  ∑ n ∈ indices,
    jointTemporalSchwartzMultiplier
      (affineVerticalProfile beta scale n hscale) (H n)

private theorem verticalRecombined_jointSchwartzRaw_eq_jointVerticalRecombinedSchwartz
    (beta : SchwartzMap Real Complex) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) (H : Int → SchwartzMap JointWaveSpaceTime Complex) :
    verticalRecombined (beta : Real → Complex) scale indices
        (fun n => jointSchwartzRaw (H n)) =
      jointSchwartzRaw
        (jointVerticalRecombinedSchwartz beta scale indices hscale H) := by
  funext z
  unfold verticalRecombined jointVerticalRecombinedSchwartz
  simp_rw [verticalProjection_jointSchwartzRaw_eq_jointTemporalSchwartzMultiplier
    beta scale _ hscale]
  change (∑ n ∈ indices,
      jointTemporalSchwartzMultiplier
        (affineVerticalProfile beta scale n hscale) (H n) (WithLp.toLp 2 z)) =
    (FunLike.coeAddMonoidHom
      (SchwartzMap JointWaveSpaceTime Complex)
      JointWaveSpaceTime Complex)
      (∑ n ∈ indices,
        jointTemporalSchwartzMultiplier
          (affineVerticalProfile beta scale n hscale) (H n)) (WithLp.toLp 2 z)
  rw [map_sum, Finset.sum_apply]
  rfl

private theorem integrable_sq_jointSchwartzRaw
    (P : SchwartzMap JointWaveSpaceTime Complex) :
    Integrable (fun z : WaveSpaceTime => ‖jointSchwartzRaw P z‖ ^ (2 : Nat)) volume := by
  rw [show (fun z : WaveSpaceTime => ‖jointSchwartzRaw P z‖ ^ (2 : Nat)) =
      fun z : WaveSpaceTime => ‖P (WithLp.toLp 2 z)‖ ^ (2 : Nat) by rfl]
  let hpres : MeasurePreserving
      (MeasurableEquiv.toLp 2 WaveSpaceTime) volume volume :=
    WithLp.volume_preserving_toLp (Euclidean 2) Real
  have hint : Integrable (fun u : JointWaveSpaceTime => ‖P u‖ ^ (2 : Nat)) volume :=
    (memLp_two_iff_integrable_sq_norm P.continuous.aestronglyMeasurable).mp
      (P.memLp 2 volume)
  exact (hpres.integrable_comp_emb
    (MeasurableEquiv.toLp 2 WaveSpaceTime).measurableEmbedding).mpr hint

private theorem integrable_sq_verticalSquareFunction_jointSchwartz
    (indices : Finset Int) (H : Int → SchwartzMap JointWaveSpaceTime Complex) :
    Integrable (fun z : WaveSpaceTime =>
      (verticalSquareFunction indices (fun n => jointSchwartzRaw (H n)) z) ^ (2 : Nat)) volume := by
  rw [show (fun z : WaveSpaceTime =>
      (verticalSquareFunction indices (fun n => jointSchwartzRaw (H n)) z) ^ (2 : Nat)) =
      fun z : WaveSpaceTime => ∑ n ∈ indices, ‖jointSchwartzRaw (H n) z‖ ^ (2 : Nat) by
        funext z
        unfold verticalSquareFunction
        rw [Real.sq_sqrt (Finset.sum_nonneg fun _ _ => sq_nonneg _)]]
  apply integrable_finsetSum
  intro n hn
  exact integrable_sq_jointSchwartzRaw (H n)

private theorem jointVertical_lintegral_ofReal_norm_rpow_two_eq_of_integrable
    {X E : Type*} [MeasurableSpace X] [NormedAddCommGroup E]
    {f : X → E} {μ : Measure X}
    (hf : Integrable (fun x => ‖f x‖ ^ (2 : Nat)) μ) :
    (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ (2 : Real) ∂μ) =
      ENNReal.ofReal (∫ x, ‖f x‖ ^ (2 : Nat) ∂μ) := by
  symm
  calc
    ENNReal.ofReal (∫ x, ‖f x‖ ^ (2 : Nat) ∂μ) =
        ENNReal.ofReal (∫ x, ‖(‖f x‖ ^ (2 : Nat) : Real)‖ ∂μ) := by
      congr 2
      funext x
      rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
    _ = ∫⁻ x, ‖(‖f x‖ ^ (2 : Nat) : Real)‖ₑ ∂μ :=
      ofReal_integral_norm_eq_lintegral_enorm hf
    _ = ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ (2 : Real) ∂μ := by
      apply lintegral_congr
      intro x
      rw [Real.enorm_eq_ofReal (sq_nonneg _), ENNReal.ofReal_pow (norm_nonneg _)]
      norm_num

/-- The physical strong `L²` consequence of the spectral-overlap estimate.
Both input and output are actual finite joint-Schwartz families. -/
private theorem eLpNorm_verticalRecombined_jointSchwartz_le_two
    (B : ScratchVerticalCutoff) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) (H : Int → SchwartzMap JointWaveSpaceTime Complex) :
    eLpNorm
        (verticalRecombined (B.cutoff : Real → Complex) scale indices
          (fun n => jointSchwartzRaw (H n))) (2 : ENNReal) volume ≤
      ENNReal.ofReal
        (Real.sqrt (3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat))) *
        eLpNorm (verticalSquareFunction indices
          (fun n => jointSchwartzRaw (H n))) (2 : ENNReal) volume := by
  let O : WaveSpaceTime → Complex :=
    verticalRecombined (B.cutoff : Real → Complex) scale indices
      (fun n => jointSchwartzRaw (H n))
  let S : WaveSpaceTime → Real :=
    verticalSquareFunction indices (fun n => jointSchwartzRaw (H n))
  let C : Real := 3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat)
  change eLpNorm O (2 : ENNReal) volume ≤
    ENNReal.ofReal (Real.sqrt C) * eLpNorm S (2 : ENNReal) volume
  have hC : 0 ≤ C := by
    dsimp only [C]
    positivity
  let P : SchwartzMap JointWaveSpaceTime Complex :=
    jointVerticalRecombinedSchwartz B.cutoff scale indices hscale H
  have hOeq : O = jointSchwartzRaw P := by
    dsimp only [O, P]
    exact verticalRecombined_jointSchwartzRaw_eq_jointVerticalRecombinedSchwartz
      B.cutoff scale indices hscale H
  have hOint : Integrable (fun z : WaveSpaceTime => ‖O z‖ ^ (2 : Nat)) volume := by
    rw [hOeq]
    exact integrable_sq_jointSchwartzRaw P
  have hSint : Integrable (fun z : WaveSpaceTime => S z ^ (2 : Nat)) volume := by
    dsimp only [S]
    exact integrable_sq_verticalSquareFunction_jointSchwartz indices H
  have hSnonneg : ∀ z, 0 ≤ S z := by
    intro z
    dsimp only [S]
    exact verticalSquareFunction_nonneg indices _ z
  have hstrong : (∫ z : WaveSpaceTime, ‖O z‖ ^ (2 : Nat)) ≤
      C * ∫ z : WaveSpaceTime, S z ^ (2 : Nat) := by
    dsimp only [O, S, C]
    exact scratch_integral_norm_sq_verticalRecombined_le_squareFunction
      B scale indices hscale H
  have hmomentO :
      (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal ‖O z‖) ^ (2 : Real)) =
        ENNReal.ofReal (∫ z : WaveSpaceTime, ‖O z‖ ^ (2 : Nat)) :=
    jointVertical_lintegral_ofReal_norm_rpow_two_eq_of_integrable hOint
  have hmomentS :
      (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (2 : Real)) =
        ENNReal.ofReal (∫ z : WaveSpaceTime, S z ^ (2 : Nat)) := by
    have hSint' : Integrable (fun z : WaveSpaceTime => ‖S z‖ ^ (2 : Nat)) volume := by
      convert hSint using 1
      funext z
      rw [Real.norm_eq_abs, abs_of_nonneg (hSnonneg z)]
    calc
      (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (2 : Real)) =
          ∫⁻ z : WaveSpaceTime, (ENNReal.ofReal ‖S z‖) ^ (2 : Real) := by
        apply lintegral_congr
        intro z
        rw [Real.norm_of_nonneg (hSnonneg z)]
      _ = ENNReal.ofReal (∫ z : WaveSpaceTime, ‖S z‖ ^ (2 : Nat)) :=
        jointVertical_lintegral_ofReal_norm_rpow_two_eq_of_integrable hSint'
      _ = ENNReal.ofReal (∫ z : WaveSpaceTime, S z ^ (2 : Nat)) := by
        congr 2
        funext z
        rw [Real.norm_eq_abs, abs_of_nonneg (hSnonneg z)]
  have hmoment :
      (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal ‖O z‖) ^ (2 : Real)) ≤
        ENNReal.ofReal C *
          ∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (2 : Real) := by
    calc
      (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal ‖O z‖) ^ (2 : Real)) =
          ENNReal.ofReal (∫ z : WaveSpaceTime, ‖O z‖ ^ (2 : Nat)) := hmomentO
      _ ≤ ENNReal.ofReal (C * ∫ z : WaveSpaceTime, S z ^ (2 : Nat)) :=
        ENNReal.ofReal_le_ofReal hstrong
      _ = ENNReal.ofReal C * ENNReal.ofReal
          (∫ z : WaveSpaceTime, S z ^ (2 : Nat)) :=
        ENNReal.ofReal_mul hC
      _ = ENNReal.ofReal C *
          ∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (2 : Real) := by
        rw [hmomentS]
  have hOlp :
      (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal ‖O z‖) ^ (2 : Real)) =
        (eLpNorm O (2 : ENNReal) volume) ^ (2 : Real) := by
    simpa using
      (Codex.Spherical.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow
        (by norm_num : (0 : Real) < 2) O)
  have hSlp :
      (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (2 : Real)) =
        (eLpNorm S (2 : ENNReal) volume) ^ (2 : Real) := by
    calc
      (∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (2 : Real)) =
          ∫⁻ z : WaveSpaceTime, ENNReal.ofReal ((S z) ^ (2 : Real)) := by
        apply lintegral_congr
        intro z
        rw [ENNReal.ofReal_rpow_of_nonneg (hSnonneg z)
          (by norm_num : (0 : Real) ≤ 2)]
      _ = (eLpNorm S (2 : ENNReal) volume) ^ (2 : Real) := by
        simpa using
          (Codex.Spherical.LpSpaceFacts.lintegral_ofReal_rpow_eq_eLpNorm_rpow_of_nonneg
            (by norm_num : (0 : Real) < 2) S hSnonneg)
  have hmomentNorm :
      (eLpNorm O (2 : ENNReal) volume) ^ (2 : Real) ≤
        ENNReal.ofReal C * (eLpNorm S (2 : ENNReal) volume) ^ (2 : Real) := by
    calc
      (eLpNorm O (2 : ENNReal) volume) ^ (2 : Real) =
          ∫⁻ z : WaveSpaceTime, (ENNReal.ofReal ‖O z‖) ^ (2 : Real) := hOlp.symm
      _ ≤ ENNReal.ofReal C *
          ∫⁻ z : WaveSpaceTime, (ENNReal.ofReal (S z)) ^ (2 : Real) := hmoment
      _ = ENNReal.ofReal C * (eLpNorm S (2 : ENNReal) volume) ^ (2 : Real) := by
        rw [hSlp]
  have hroot := ENNReal.rpow_le_rpow hmomentNorm
    (by norm_num : (0 : Real) ≤ 1 / 2)
  calc
    eLpNorm O (2 : ENNReal) volume =
        ((eLpNorm O (2 : ENNReal) volume) ^ (2 : Real)) ^ (1 / 2 : Real) := by
      rw [← ENNReal.rpow_mul]
      norm_num
    _ ≤ (ENNReal.ofReal C *
        (eLpNorm S (2 : ENNReal) volume) ^ (2 : Real)) ^ (1 / 2 : Real) := hroot
    _ = (ENNReal.ofReal C) ^ (1 / 2 : Real) *
        eLpNorm S (2 : ENNReal) volume := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : Real) ≤ 1 / 2),
        ← ENNReal.rpow_mul]
      norm_num
    _ = ENNReal.ofReal (Real.sqrt C) * eLpNorm S (2 : ENNReal) volume := by
      rw [ENNReal.ofReal_rpow_of_nonneg hC (by norm_num : (0 : Real) ≤ 1 / 2),
        ← Real.sqrt_eq_rpow]

/-- The raw output has the literal common-kernel top bound on the joint
source carrier.  The harmless `+ 1` keeps the scale parameter strictly
positive for the supplied-split interpolation engine. -/
private theorem jointVerticalRecombinedOutput_raw_sourceOutput_top
    (beta : SchwartzMap Real Complex) (scale : Real) (indices : Finset Int)
    (hscale : 0 < scale) (G : Int → SchwartzMap JointWaveSpaceTime Complex)
    (a : Real) (ha : 0 ≤ a)
    (hbound : ∀ ζ : JointWaveSpaceTime,
      ‖jointVerticalRecombinedSourceEval indices G ζ‖ ≤ a)
    (z : WaveSpaceTime) :
    jointVerticalRecombinedOutput beta scale indices G z ≤
      (1 + jointVerticalRecombinedTopCoefficient beta indices) * a := by
  rcases z with ⟨x, t⟩
  have hinput : ∀ w : WaveSpaceTime,
      ‖(WithLp.toLp 2
          (fun i : (↥indices) => jointSchwartzRaw (G (i : Int)) w) :
        PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex))‖ ≤ a := by
    intro w
    simpa only [jointVerticalRecombinedSourceEval, jointSchwartzRaw] using
      hbound (WithLp.toLp 2 w)
  have hraw := norm_verticalRecombined_jointSchwartzRaw_le_commonKernelTop
    beta scale indices hscale G hinput x t
  have htopnonneg : 0 ≤ jointVerticalRecombinedTopCoefficient beta indices :=
    jointVerticalRecombinedTopCoefficient_nonneg beta indices
  change ‖verticalRecombined (beta : Real → Complex) scale indices
    (fun n => jointSchwartzRaw (G n)) (x, t)‖ ≤
      (1 + jointVerticalRecombinedTopCoefficient beta indices) * a
  calc
    ‖verticalRecombined (beta : Real → Complex) scale indices
        (fun n => jointSchwartzRaw (G n)) (x, t)‖ ≤
        jointVerticalRecombinedTopCoefficient beta indices * a := by
      simpa only [jointVerticalRecombinedTopCoefficient] using hraw
    _ ≤ (1 + jointVerticalRecombinedTopCoefficient beta indices) * a := by
      gcongr
      linarith

/-- A common-kernel estimate controls the output by the *global* supremum of
the input bundle.  Continuity upgrades the essential input supremum to that
global bound, which is enough for the literal `L∞` endpoint. -/
private theorem jointVertical_eLpNorm_top_le_of_continuous_global_bound
    {E : Type*} [NormedAddCommGroup E]
    (S : WaveSpaceTime → E) (T : WaveSpaceTime → Real)
    (hScont : Continuous S) {B : Real} (hB : 0 < B)
    (hTnonneg : ∀ z, 0 ≤ T z)
    (hglobal : ∀ (a : Real), 0 ≤ a →
      (∀ z : WaveSpaceTime, ‖S z‖ ≤ a) → ∀ z, T z ≤ B * a) :
    eLpNorm T ⊤ volume ≤ ENNReal.ofReal B * eLpNorm S ⊤ volume := by
  rw [eLpNorm_exponent_top]
  by_cases hStop : eLpNorm S ⊤ volume = ⊤
  · rw [hStop, ENNReal.mul_top (ne_of_gt (ENNReal.ofReal_pos.mpr hB))]
    exact le_top
  let A : Real := (eLpNorm S ⊤ volume).toReal
  have hAnonneg : 0 ≤ A := ENNReal.toReal_nonneg
  have hA : ENNReal.ofReal A = eLpNorm S ⊤ volume := by
    dsimp only [A]
    exact ENNReal.ofReal_toReal hStop
  have hSaeEnorm : ∀ᵐ z : WaveSpaceTime ∂volume,
      ‖S z‖ₑ ≤ ENNReal.ofReal A := by
    simpa only [hA, eLpNorm_exponent_top] using
      (enorm_ae_le_eLpNormEssSup S volume)
  have hSae : ∀ᵐ z : WaveSpaceTime ∂volume, ‖S z‖ ≤ A := by
    filter_upwards [hSaeEnorm] with z hz
    have hz' : ENNReal.ofReal ‖S z‖ ≤ ENNReal.ofReal A := by
      simpa only [← ofReal_norm] using hz
    exact (ENNReal.ofReal_le_ofReal_iff hAnonneg).mp hz'
  let s : WaveSpaceTime → Real := fun z => ‖S z‖
  have hscont : Continuous s := hScont.norm
  have hmincont : Continuous (fun z : WaveSpaceTime => min (s z) A) :=
    hscont.min continuous_const
  have hmine : (fun z : WaveSpaceTime => min (s z) A) =ᵐ[volume] s := by
    filter_upwards [hSae] with z hz
    exact min_eq_left hz
  have hmin : (fun z : WaveSpaceTime => min (s z) A) = s :=
    (Continuous.ae_eq_iff_eq volume hmincont hscont).mp hmine
  have hSall : ∀ z : WaveSpaceTime, ‖S z‖ ≤ A := by
    intro z
    exact min_eq_left_iff.mp (congr_fun hmin z)
  have hTall : ∀ z : WaveSpaceTime, T z ≤ B * A :=
    hglobal A hAnonneg hSall
  apply eLpNormEssSup_le_of_ae_enorm_bound
  apply Eventually.of_forall
  intro z
  rw [Real.enorm_eq_ofReal (hTnonneg z), ← hA,
    ← ENNReal.ofReal_mul hB.le]
  exact (ENNReal.ofReal_le_ofReal_iff (mul_nonneg hB.le hAnonneg)).mpr (hTall z)

/-- The sharp physical `L∞` endpoint obtained from the global common-kernel
bound, with the finite index cardinality absorbed into the MSS gain. -/
private theorem eLpNorm_verticalRecombined_jointSchwartz_top_of_global_commonKernel
    (beta : SchwartzMap Real Complex) (scale C0 : Real) (indices : Finset Int)
    (H : Int → SchwartzMap JointWaveSpaceTime Complex)
    (hscale : (2 : Real) ≤ scale) (hC0 : 0 ≤ C0)
    (hcard_upper : (indices.card : Real) ≤ C0 * Real.sqrt scale) :
    eLpNorm (verticalRecombined (beta : Real → Complex) scale indices
        (fun n => jointSchwartzRaw (H n))) ⊤ volume ≤
      ENNReal.ofReal
        ((1 + (∫ y : Real, ‖FourierTransform.fourierInv
          (beta : Real → Complex) y‖) * Real.sqrt C0) *
          scale ^ verticalRecombinationGain ⊤) *
        eLpNorm (verticalSquareFunction indices
          (fun n => jointSchwartzRaw (H n))) ⊤ volume := by
  let A : Real := ∫ y : Real, ‖FourierTransform.fourierInv
    (beta : Real → Complex) y‖
  have hA : 0 ≤ A := by
    dsimp only [A]
    exact integral_nonneg fun y => norm_nonneg _
  let btop : Real := 1 + jointVerticalRecombinedTopCoefficient beta indices
  have htopnonneg : 0 ≤ jointVerticalRecombinedTopCoefficient beta indices :=
    jointVerticalRecombinedTopCoefficient_nonneg beta indices
  have hbtop : 0 < btop := by
    dsimp only [btop]
    linarith
  have hscale_pos : 0 < scale := by linarith
  have htop :
      eLpNorm (jointVerticalRecombinedOutput beta scale indices H) ⊤ volume ≤
        ENNReal.ofReal btop *
          eLpNorm (jointVerticalRecombinedEval indices H) ⊤ volume := by
    apply jointVertical_eLpNorm_top_le_of_continuous_global_bound
      (jointVerticalRecombinedEval indices H)
      (jointVerticalRecombinedOutput beta scale indices H)
      (continuous_jointVerticalRecombinedEval indices H) hbtop
      (jointVerticalRecombinedOutput_nonneg beta scale indices H)
    intro a ha hbound z
    calc
      jointVerticalRecombinedOutput beta scale indices H z ≤
          jointVerticalRecombinedTopCoefficient beta indices * a :=
        jointVerticalRecombinedOutput_top_coefficient beta scale indices hscale_pos H hbound z
      _ ≤ btop * a := by
        dsimp only [btop]
        gcongr
        linarith
  have htop' :
      eLpNorm (verticalRecombined (beta : Real → Complex) scale indices
          (fun n => jointSchwartzRaw (H n))) ⊤ volume ≤
        ENNReal.ofReal btop *
          eLpNorm (verticalSquareFunction indices
            (fun n => jointSchwartzRaw (H n))) ⊤ volume := by
    calc
      eLpNorm (verticalRecombined (beta : Real → Complex) scale indices
          (fun n => jointSchwartzRaw (H n))) ⊤ volume =
          eLpNorm (jointVerticalRecombinedOutput beta scale indices H) ⊤ volume := by
            rw [← eLpNorm_norm]
            rfl
      _ ≤ ENNReal.ofReal btop *
          eLpNorm (jointVerticalRecombinedEval indices H) ⊤ volume := htop
      _ = ENNReal.ofReal btop *
          eLpNorm (verticalSquareFunction indices
            (fun n => jointSchwartzRaw (H n))) ⊤ volume := by
            rw [eLpNorm_verticalSquareFunction_eq_eLpNorm_piLp]
            rfl
  have hcoef : ENNReal.ofReal btop ≤
      ENNReal.ofReal
        ((1 + A * Real.sqrt C0) * scale ^ verticalRecombinationGain ⊤) := by
    dsimp only [btop, jointVerticalRecombinedTopCoefficient]
    change ENNReal.ofReal (1 + Real.sqrt (indices.card : Real) * A) ≤ _
    simpa [mul_comm] using
      (jointVertical_ennreal_sqrt_card_top_constant_le_vertical_gain_top
        indices hscale hC0 hA hcard_upper)
  have hfinal := htop'.trans
    (by
      simpa [mul_comm] using
        (mul_le_mul_left
          hcoef
          (eLpNorm (verticalSquareFunction indices
            (fun n => jointSchwartzRaw (H n))) ⊤ volume)))
  simpa [A, eLpNorm_exponent_top, mul_comm, mul_left_comm, mul_assoc] using hfinal

/-- The part of the finite-`p` Marcinkiewicz coefficient independent of the
finite packet cardinality. -/
private noncomputable def jointVerticalFiniteBaseCoefficient
    (B : ScratchVerticalCutoff) (p : Real) : ENNReal :=
  ENNReal.ofReal p *
    ((ENNReal.ofReal (2 : Real)) ^ (2 : Real) *
      ENNReal.ofReal
        (3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat)) *
      ((ENNReal.ofReal (p - 2))⁻¹ *
        (ENNReal.ofReal (4 : Real)) ^ (p - 2)))

/-- Exact algebra which recovers the interpolation power of the top
coefficient from the normalized two-space Marcinkiewicz estimate. -/
private theorem jointVertical_finite_coefficient_root
    (B : ScratchVerticalCutoff) (indices : Finset Int) {p : Real}
    (hp : (2 : Real) < p) :
    ENNReal.ofReal
        (1 + jointVerticalRecombinedTopCoefficient B.cutoff indices) *
      (jointVerticalFiniteInterpolationCoefficient B indices p) ^ p⁻¹ =
        (jointVerticalFiniteBaseCoefficient B p) ^ p⁻¹ *
          (ENNReal.ofReal
            (1 + jointVerticalRecombinedTopCoefficient B.cutoff indices)) ^
              (1 - 2 / p) := by
  let btop : Real := 1 + jointVerticalRecombinedTopCoefficient B.cutoff indices
  let b : ENNReal := ENNReal.ofReal btop
  let K : ENNReal := jointVerticalFiniteBaseCoefficient B p
  have hp0 : 0 < p := lt_trans (by norm_num) hp
  have hcoef : 0 ≤ jointVerticalRecombinedTopCoefficient B.cutoff indices :=
    jointVerticalRecombinedTopCoefficient_nonneg B.cutoff indices
  have hbtop : 0 < btop := by
    dsimp only [btop]
    linarith
  have hb0 : b ≠ 0 := by
    dsimp only [b]
    exact ENNReal.ofReal_ne_zero_iff.mpr hbtop
  have hbtopE : b ≠ ⊤ := by
    dsimp only [b]
    exact ENNReal.ofReal_ne_top
  have hK : jointVerticalFiniteInterpolationCoefficient B indices p =
      K * (b ^ (2 : Real))⁻¹ := by
    dsimp only [jointVerticalFiniteInterpolationCoefficient,
      jointVerticalFiniteBaseCoefficient, K, b, btop]
    ac_rfl
  change b * (jointVerticalFiniteInterpolationCoefficient B indices p) ^ p⁻¹ =
    K ^ p⁻¹ * b ^ (1 - 2 / p)
  rw [hK, ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hp0.le)]
  rw [ENNReal.inv_rpow, ← ENNReal.rpow_neg, ← ENNReal.rpow_mul]
  rw [show b ^ (2 * -p⁻¹) = b ^ (-2 / p) by
    congr 1
    field_simp]
  rw [show b * (K ^ p⁻¹ * b ^ (-2 / p)) =
      K ^ p⁻¹ * (b * b ^ (-2 / p)) by ac_rfl]
  rw [show b * b ^ (-2 / p) = b ^ (1 - 2 / p) by
    calc
      b * b ^ (-2 / p) = b ^ (1 : Real) * b ^ (-2 / p) := by
        rw [ENNReal.rpow_one]
      _ = b ^ ((1 : Real) + -2 / p) :=
        (ENNReal.rpow_add _ _ hb0 hbtopE).symm
      _ = _ := by congr 1; ring]

private theorem jointVerticalFiniteBaseCoefficient_root_ne_top
    (B : ScratchVerticalCutoff) {p : Real} (hp : (2 : Real) < p) :
    (jointVerticalFiniteBaseCoefficient B p) ^ p⁻¹ ≠ ⊤ := by
  have hp0 : 0 < p := lt_trans (by norm_num) hp
  have hp2 : 0 < p - 2 := sub_pos.mpr hp
  apply ENNReal.rpow_ne_top_of_nonneg (inv_nonneg.mpr hp0.le)
  apply ENNReal.mul_ne_top ENNReal.ofReal_ne_top
  apply ENNReal.mul_ne_top
  · apply ENNReal.mul_ne_top
    · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
    · exact ENNReal.ofReal_ne_top
  · apply ENNReal.mul_ne_top
    · exact ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hp2)
    · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top

private theorem jointVertical_exists_pos_real_majorant
    {K : ENNReal} (hK : K ≠ ⊤) :
    ∃ D : Real, 0 < D ∧ K ≤ ENNReal.ofReal D := by
  refine ⟨K.toReal + 1, by positivity, ?_⟩
  calc
    K = ENNReal.ofReal K.toReal := (ENNReal.ofReal_toReal hK).symm
    _ ≤ ENNReal.ofReal (K.toReal + 1) := by
      have hKnonneg : 0 ≤ K.toReal := ENNReal.toReal_nonneg
      exact ENNReal.ofReal_le_ofReal (by linarith)

private theorem jointVertical_top_constant_interpolation_le_scale_gain
    {scale C0 A card p : Real}
    (hscale : (2 : Real) ≤ scale) (hC0 : 0 ≤ C0) (hA : 0 ≤ A)
    (hcard_upper : card ≤ C0 * Real.sqrt scale)
    (hp : (2 : Real) < p) :
    (1 + A * Real.sqrt card) ^ (1 - 2 / p) ≤
      (1 + A * Real.sqrt C0) ^ (1 - 2 / p) *
        scale ^ (1 / 4 - 1 / (2 * p) : Real) := by
  have hp0 : 0 < p := by linarith
  have htheta : 0 ≤ 1 - 2 / p := by
    have hdiv : 2 / p < (1 : Real) := (div_lt_one hp0).mpr hp
    linarith
  have hscale0 : 0 ≤ scale := by linarith
  have htop0 : 0 ≤ 1 + A * Real.sqrt card := by positivity
  have hbase0 : 0 ≤ 1 + A * Real.sqrt C0 := by positivity
  have hq0 : 0 ≤ scale ^ (1 / 4 : Real) := Real.rpow_nonneg hscale0 _
  have htop := jointVertical_top_constant_le_scale_quarter
    hscale hC0 hA hcard_upper
  calc
    (1 + A * Real.sqrt card) ^ (1 - 2 / p) ≤
        ((1 + A * Real.sqrt C0) * scale ^ (1 / 4 : Real)) ^ (1 - 2 / p) :=
      Real.rpow_le_rpow htop0 htop htheta
    _ = (1 + A * Real.sqrt C0) ^ (1 - 2 / p) *
        (scale ^ (1 / 4 : Real)) ^ (1 - 2 / p) :=
      Real.mul_rpow hbase0 hq0
    _ = (1 + A * Real.sqrt C0) ^ (1 - 2 / p) *
        scale ^ ((1 / 4 : Real) * (1 - 2 / p)) := by
      rw [← Real.rpow_mul hscale0]
    _ = (1 + A * Real.sqrt C0) ^ (1 - 2 / p) *
        scale ^ (1 / 4 - 1 / (2 * p) : Real) := by
      congr 2
      field_simp
      ring

private theorem jointVertical_ennreal_prefactor_sqrt_card_interpolation_le_scale_gain
    {scale C0 A D p : Real} (indices : Finset Int)
    (hscale : (2 : Real) ≤ scale) (hC0 : 0 ≤ C0) (hA : 0 ≤ A) (hD : 0 ≤ D)
    (hcard_upper : (indices.card : Real) ≤ C0 * Real.sqrt scale)
    (hp : (2 : Real) < p) :
    ENNReal.ofReal D *
        (ENNReal.ofReal (1 + Real.sqrt (indices.card : Real) * A)) ^ (1 - 2 / p) ≤
      ENNReal.ofReal
        (D * (1 + A * Real.sqrt C0) ^ (1 - 2 / p) *
          scale ^ (1 / 4 - 1 / (2 * p) : Real)) := by
  have htheta : 0 ≤ 1 - 2 / p := by
    have hp0 : 0 < p := by linarith
    have hdiv : 2 / p < (1 : Real) := (div_lt_one hp0).mpr hp
    linarith
  have htop0 : 0 ≤ 1 + Real.sqrt (indices.card : Real) * A := by positivity
  rw [ENNReal.ofReal_rpow_of_nonneg htop0 htheta]
  calc
    ENNReal.ofReal D *
        ENNReal.ofReal ((1 + Real.sqrt (indices.card : Real) * A) ^ (1 - 2 / p)) ≤
        ENNReal.ofReal D * ENNReal.ofReal
          ((1 + A * Real.sqrt C0) ^ (1 - 2 / p) *
            scale ^ (1 / 4 - 1 / (2 * p) : Real)) := by
      exact mul_le_mul_right
        (ENNReal.ofReal_le_ofReal
          (by
            simpa [mul_comm] using
              (jointVertical_top_constant_interpolation_le_scale_gain
                hscale hC0 hA hcard_upper hp))) (ENNReal.ofReal D)
    _ = ENNReal.ofReal
        (D * (1 + A * Real.sqrt C0) ^ (1 - 2 / p) *
          scale ^ (1 / 4 - 1 / (2 * p) : Real)) := by
      rw [← ENNReal.ofReal_mul hD]
      congr 1
      ring

private theorem jointVertical_verticalRecombinationGain_finite
    (p : ENNReal) (hpfin : p ≠ ⊤) :
    verticalRecombinationGain p = 1 / 4 - 1 / (2 * p.toReal) := by
  rw [verticalRecombinationGain, if_neg hpfin]

private theorem jointVertical_ennreal_prefactor_sqrt_card_interpolation_le_vertical_gain_finite
    {scale C0 A D : Real} (indices : Finset Int) (p : ENNReal)
    (hpfin : p ≠ ⊤) (hp : (2 : Real) < p.toReal)
    (hscale : (2 : Real) ≤ scale) (hC0 : 0 ≤ C0) (hA : 0 ≤ A) (hD : 0 ≤ D)
    (hcard_upper : (indices.card : Real) ≤ C0 * Real.sqrt scale) :
    ENNReal.ofReal D *
        (ENNReal.ofReal (1 + Real.sqrt (indices.card : Real) * A)) ^
          (1 - 2 / p.toReal) ≤
      ENNReal.ofReal
        (D * (1 + A * Real.sqrt C0) ^ (1 - 2 / p.toReal) *
          scale ^ verticalRecombinationGain p) := by
  rw [jointVertical_verticalRecombinationGain_finite p hpfin]
  exact jointVertical_ennreal_prefactor_sqrt_card_interpolation_le_scale_gain
    indices hscale hC0 hA hD hcard_upper hp

private theorem jointVertical_verticalRecombinationGain_two :
    verticalRecombinationGain (2 : ENNReal) = 0 := by
  rw [verticalRecombinationGain, if_neg (by norm_num : (2 : ENNReal) ≠ ⊤)]
  norm_num

private theorem jointVertical_vertical_recombination_exponent_cases
    (p : ENNReal) (hp_two : ENNReal.ofReal 2 ≤ p) :
    p = ⊤ ∨ p = (2 : ENNReal) ∨ ((p ≠ ⊤) ∧ (2 : Real) < p.toReal) := by
  by_cases hpfin : p = ⊤
  · exact Or.inl hpfin
  · have hp_two' : (2 : ENNReal) ≤ p := by
      norm_num at hp_two ⊢
      exact hp_two
    rcases lt_or_eq_of_le hp_two' with hlt | heq
    · right
      right
      have htwofin : (2 : ENNReal) ≠ ⊤ := by norm_num
      have hreal : (2 : ENNReal).toReal < p.toReal :=
        (ENNReal.toReal_lt_toReal htwofin hpfin).mpr hlt
      norm_num at hreal ⊢
      exact ⟨hpfin, hreal⟩
    · exact Or.inr (Or.inl heq.symm)

private theorem jointVertical_finite_coefficient_le_vertical_gain
    (B : ScratchVerticalCutoff) (C0 : Real) (p : ENNReal)
    (hpfin : p ≠ ⊤) (hp : (2 : Real) < p.toReal)
    (D : Real)
    (hD : (jointVerticalFiniteBaseCoefficient B p.toReal) ^ (p.toReal)⁻¹ ≤
      ENNReal.ofReal D)
    (scale : Real) (indices : Finset Int)
    (hscale : (2 : Real) ≤ scale) (hC0 : 0 ≤ C0) (hDnonneg : 0 ≤ D)
    (hcard_upper : (indices.card : Real) ≤ C0 * Real.sqrt scale) :
    ENNReal.ofReal
        (1 + jointVerticalRecombinedTopCoefficient B.cutoff indices) *
      (jointVerticalFiniteInterpolationCoefficient B indices p.toReal) ^
        (p.toReal)⁻¹ ≤
      ENNReal.ofReal
        (D *
          (1 + (∫ y : Real, ‖FourierTransform.fourierInv
            (B.cutoff : Real → Complex) y‖) * Real.sqrt C0) ^
            (1 - 2 / p.toReal) *
          scale ^ verticalRecombinationGain p) := by
  let A : Real := ∫ y : Real, ‖FourierTransform.fourierInv
    (B.cutoff : Real → Complex) y‖
  have hA : 0 ≤ A := by
    dsimp only [A]
    exact integral_nonneg fun y => norm_nonneg _
  have hroot := jointVertical_finite_coefficient_root B indices hp
  have hcard := jointVertical_ennreal_prefactor_sqrt_card_interpolation_le_vertical_gain_finite
    indices p hpfin hp hscale hC0 hA hDnonneg hcard_upper
  calc
    ENNReal.ofReal
        (1 + jointVerticalRecombinedTopCoefficient B.cutoff indices) *
      (jointVerticalFiniteInterpolationCoefficient B indices p.toReal) ^
        (p.toReal)⁻¹ =
        (jointVerticalFiniteBaseCoefficient B p.toReal) ^ (p.toReal)⁻¹ *
          (ENNReal.ofReal
            (1 + jointVerticalRecombinedTopCoefficient B.cutoff indices)) ^
              (1 - 2 / p.toReal) := hroot
    _ ≤ ENNReal.ofReal D *
          (ENNReal.ofReal
            (1 + jointVerticalRecombinedTopCoefficient B.cutoff indices)) ^
              (1 - 2 / p.toReal) :=
      mul_le_mul_left hD _
    _ = ENNReal.ofReal D *
        (ENNReal.ofReal (1 + Real.sqrt (indices.card : Real) * A)) ^
          (1 - 2 / p.toReal) := by
      rfl
    _ ≤ ENNReal.ofReal
        (D * (1 + A * Real.sqrt C0) ^ (1 - 2 / p.toReal) *
          scale ^ verticalRecombinationGain p) := hcard
    _ = ENNReal.ofReal
        (D *
          (1 + (∫ y : Real, ‖FourierTransform.fourierInv
            (B.cutoff : Real → Complex) y‖) * Real.sqrt C0) ^
            (1 - 2 / p.toReal) *
          scale ^ verticalRecombinationGain p) := by
      rfl

/-- The finite `p>2` branch in the exact vertical-recombination format. -/
private theorem exists_jointVerticalRecombined_finite_vertical_gain
    (B : ScratchVerticalCutoff) (C0 : Real) (p : ENNReal)
    (hpfin : p ≠ ⊤) (hp : (2 : Real) < p.toReal) (hC0 : 0 < C0) :
    ∃ C : Real, 0 < C ∧ ∀ scale : Real, (2 : Real) ≤ scale →
      ∀ indices : Finset Int,
        (indices.card : Real) ≤ C0 * Real.sqrt scale →
        ∀ H : Int → SchwartzMap JointWaveSpaceTime Complex,
          eLpNorm (verticalRecombined (B.cutoff : Real → Complex) scale indices
            (fun n => jointSchwartzRaw (H n))) p volume ≤
            ENNReal.ofReal (C * scale ^ verticalRecombinationGain p) *
              eLpNorm (verticalSquareFunction indices
                (fun n => jointSchwartzRaw (H n))) p volume := by
  let A : Real := ∫ y : Real, ‖FourierTransform.fourierInv
    (B.cutoff : Real → Complex) y‖
  let K : ENNReal := (jointVerticalFiniteBaseCoefficient B p.toReal) ^
    (p.toReal)⁻¹
  have hKtop : K ≠ ⊤ := by
    dsimp only [K]
    exact jointVerticalFiniteBaseCoefficient_root_ne_top B hp
  rcases jointVertical_exists_pos_real_majorant hKtop with ⟨D, hDpos, hD⟩
  let C : Real := D * (1 + A * Real.sqrt C0) ^ (1 - 2 / p.toReal)
  have hCpos : 0 < C := by
    dsimp only [C]
    apply mul_pos hDpos
    apply Real.rpow_pos_of_pos
    have hA : 0 ≤ A := by
      dsimp only [A]
      exact integral_nonneg fun y => norm_nonneg _
    positivity
  refine ⟨C, hCpos, ?_⟩
  intro scale hscale indices hcard H
  have hpEq : p = ENNReal.ofReal p.toReal :=
    (ENNReal.ofReal_toReal hpfin).symm
  have hfinite := eLpNorm_verticalRecombined_jointSchwartz_le_finite
    B scale indices (by linarith : 0 < scale) hp H
  have hcoef := jointVertical_finite_coefficient_le_vertical_gain
    B C0 p hpfin hp D (by simpa only [K] using hD)
    scale indices hscale hC0.le hDpos.le hcard
  calc
    eLpNorm (verticalRecombined (B.cutoff : Real → Complex) scale indices
        (fun n => jointSchwartzRaw (H n))) p volume =
        eLpNorm (verticalRecombined (B.cutoff : Real → Complex) scale indices
          (fun n => jointSchwartzRaw (H n))) (ENNReal.ofReal p.toReal) volume := by
          exact congrArg (fun q : ENNReal =>
            eLpNorm (verticalRecombined (B.cutoff : Real → Complex) scale indices
              (fun n => jointSchwartzRaw (H n))) q volume) hpEq
    _ ≤ ENNReal.ofReal
          (1 + jointVerticalRecombinedTopCoefficient B.cutoff indices) *
          (jointVerticalFiniteInterpolationCoefficient B indices p.toReal) ^
            (p.toReal)⁻¹ *
          eLpNorm (verticalSquareFunction indices
            (fun n => jointSchwartzRaw (H n))) (ENNReal.ofReal p.toReal) volume := hfinite
    _ ≤ ENNReal.ofReal (C * scale ^ verticalRecombinationGain p) *
          eLpNorm (verticalSquareFunction indices
            (fun n => jointSchwartzRaw (H n))) (ENNReal.ofReal p.toReal) volume := by
      exact mul_le_mul_left
        (by simpa only [C, A] using hcoef) _
    _ = ENNReal.ofReal (C * scale ^ verticalRecombinationGain p) *
          eLpNorm (verticalSquareFunction indices
            (fun n => jointSchwartzRaw (H n))) p volume := by
      exact congrArg (fun q : ENNReal =>
        ENNReal.ofReal (C * scale ^ verticalRecombinationGain p) *
          eLpNorm (verticalSquareFunction indices
            (fun n => jointSchwartzRaw (H n))) q volume) hpEq.symm

/-- The strong `L²` branch, with the zero scale gain written literally. -/
private theorem exists_jointVerticalRecombined_two_vertical_gain
    (B : ScratchVerticalCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ scale : Real, (2 : Real) ≤ scale →
      ∀ indices : Finset Int,
        ∀ H : Int → SchwartzMap JointWaveSpaceTime Complex,
          eLpNorm (verticalRecombined (B.cutoff : Real → Complex) scale indices
            (fun n => jointSchwartzRaw (H n))) (2 : ENNReal) volume ≤
            ENNReal.ofReal (C * scale ^ verticalRecombinationGain (2 : ENNReal)) *
              eLpNorm (verticalSquareFunction indices
                (fun n => jointSchwartzRaw (H n))) (2 : ENNReal) volume := by
  let c2 : Real := 3 * (SchwartzMap.seminorm Complex 0 0 B.cutoff) ^ (2 : Nat)
  let C : Real := Real.sqrt c2 + 1
  have hc2 : 0 ≤ c2 := by
    dsimp only [c2]
    positivity
  have hCpos : 0 < C := by
    dsimp only [C]
    positivity
  refine ⟨C, hCpos, ?_⟩
  intro scale hscale indices H
  have htwo := eLpNorm_verticalRecombined_jointSchwartz_le_two
    B scale indices (by linarith : 0 < scale) H
  calc
    eLpNorm (verticalRecombined (B.cutoff : Real → Complex) scale indices
        (fun n => jointSchwartzRaw (H n))) (2 : ENNReal) volume ≤
        ENNReal.ofReal (Real.sqrt c2) *
          eLpNorm (verticalSquareFunction indices
            (fun n => jointSchwartzRaw (H n))) (2 : ENNReal) volume := by
      simpa only [c2] using htwo
    _ ≤ ENNReal.ofReal C *
          eLpNorm (verticalSquareFunction indices
            (fun n => jointSchwartzRaw (H n))) (2 : ENNReal) volume := by
      apply mul_le_mul_left
      apply ENNReal.ofReal_le_ofReal
      dsimp only [C]
      linarith [Real.sqrt_nonneg c2]
    _ = ENNReal.ofReal
          (C * scale ^ verticalRecombinationGain (2 : ENNReal)) *
          eLpNorm (verticalSquareFunction indices
            (fun n => jointSchwartzRaw (H n))) (2 : ENNReal) volume := by
      rw [jointVertical_verticalRecombinationGain_two, Real.rpow_zero, mul_one]
theorem aux_verticalRecombination_proof
    (B : MSSVerticalCutoff) : verticalRecombination B := by
  intro p C0 hp_two hC0
  rcases jointVertical_vertical_recombination_exponent_cases p hp_two with
    htop | htwo | hfinite
  · subst p
    let A : Real := ∫ y : Real, ‖FourierTransform.fourierInv
      (B.cutoff : Real → Complex) y‖
    let C : Real := 1 + A * Real.sqrt C0
    have hA : 0 ≤ A := by
      dsimp only [A]
      exact integral_nonneg fun y => norm_nonneg _
    have hCpos : 0 < C := by
      dsimp only [C]
      positivity
    refine ⟨C, hCpos, ?_⟩
    intro scale hscale indices hcard H
    simpa only [C, A] using
      (eLpNorm_verticalRecombined_jointSchwartz_top_of_global_commonKernel
        B.cutoff scale C0 indices H hscale hC0.le hcard)
  · subst p
    rcases exists_jointVerticalRecombined_two_vertical_gain B with ⟨C, hC, hbound⟩
    refine ⟨C, hC, ?_⟩
    intro scale hscale indices _ H
    exact hbound scale hscale indices H
  · rcases hfinite with ⟨hpfin, hp⟩
    rcases exists_jointVerticalRecombined_finite_vertical_gain
      B C0 p hpfin hp hC0 with ⟨C, hC, hbound⟩
    exact ⟨C, hC, hbound⟩

end aux_VerticalRecombinationProof

/-- The finite joint-Schwartz `L⁴` estimate removing vertical projections. -/
theorem removeVerticalProjections_of_schwartz
    (beta : SchwartzMap Real Complex) :
    removeVerticalProjections beta :=
  aux_VerticalRecombinationProof.removeVerticalProjections_of_schwartz_core beta

/-- Finite joint-Schwartz vertical recombination for a literal compactly
supported smooth vertical cutoff. -/
theorem verticalRecombination_of_MSSVerticalCutoff
    (B : MSSVerticalCutoff) : verticalRecombination B :=
  aux_VerticalRecombinationProof.aux_verticalRecombination_proof B

end

