    change (∑ i ∈ s,
      (FunLike.coeAddMonoidHom (SchwartzMap JointWaveSpaceTime Complex)
        JointWaveSpaceTime Complex) (FourierTransform.fourierInv (R i))
        (WithLp.toLp 2 z)) = _
    dsimp only [Rinv, jointSchwartzRaw]
    symm
    change
      (FunLike.coeAddMonoidHom (SchwartzMap JointWaveSpaceTime Complex)
        JointWaveSpaceTime Complex)
          (∑ i ∈ s, FourierTransform.fourierInv (R i)) (WithLp.toLp 2 z) = _
    simpa only [Finset.sum_apply] using congrFun
      (map_sum
        (FunLike.coeAddMonoidHom (SchwartzMap JointWaveSpaceTime Complex)
          JointWaveSpaceTime Complex)
        (fun i => FourierTransform.fourierInv (R i)) s)
      (WithLp.toLp 2 z)
  have h := integrable_norm_sq_jointSchwartzRaw Rinv
  rw [← hphysical] at h
  exact h

private theorem integral_pow_four_aux_angularRadialRecombinedSquareFunction_eq_pair_sums
    (radialIndices angularIndices : Finset Int)
    (P : Int → Int → SchwartzMap JointWaveSpaceTime Complex) :
    (∫ z : WaveSpaceTime,
      (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices
        (fun n nu => jointInversePacket (P n nu)) z) ^ (4 : Nat)) =
      ∑ n ∈ radialIndices, ∑ n' ∈ radialIndices,
        ∫ z : WaveSpaceTime,
          ‖∑ pair ∈ angularIndices.product angularIndices,
            jointInversePacket
              (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
                (P n pair.1) (P n' pair.2)) z‖ ^ (2 : Nat) := by
  classical
  let R : Int → Int → Int × Int → SchwartzMap JointWaveSpaceTime Complex :=
    fun n n' pair => SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
      (P n pair.1) (P n' pair.2)
  have hRint (n n' : Int) : Integrable
      (fun z : WaveSpaceTime => ‖∑ pair ∈ angularIndices.product angularIndices,
        jointInversePacket (R n n' pair) z‖ ^ (2 : Nat)) volume :=
    integrable_norm_sq_sum_jointInversePacket (angularIndices.product angularIndices) (R n n')
  have hsumInt : Integrable
      (fun z : WaveSpaceTime => ∑ n ∈ radialIndices, ∑ n' ∈ radialIndices,
        ‖∑ pair ∈ angularIndices.product angularIndices,
          jointInversePacket (R n n' pair) z‖ ^ (2 : Nat)) volume := by
    apply integrable_finsetSum radialIndices
    intro n hn
    apply integrable_finsetSum radialIndices
    intro n' hn'
    exact hRint n n'
  have hIntegral :
      (∫ z : WaveSpaceTime, ∑ n ∈ radialIndices, ∑ n' ∈ radialIndices,
        ‖∑ pair ∈ angularIndices.product angularIndices,
          jointInversePacket (R n n' pair) z‖ ^ (2 : Nat)) =
        ∑ n ∈ radialIndices, ∑ n' ∈ radialIndices,
          ∫ z : WaveSpaceTime,
            ‖∑ pair ∈ angularIndices.product angularIndices,
              jointInversePacket (R n n' pair) z‖ ^ (2 : Nat) := by
    calc
      (∫ z : WaveSpaceTime, ∑ n ∈ radialIndices, ∑ n' ∈ radialIndices,
        ‖∑ pair ∈ angularIndices.product angularIndices,
          jointInversePacket (R n n' pair) z‖ ^ (2 : Nat)) =
          ∑ n ∈ radialIndices, ∫ z : WaveSpaceTime,
            ∑ n' ∈ radialIndices,
