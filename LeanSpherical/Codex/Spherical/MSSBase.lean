/-- Fubini form of the literal iterated inverse transform.  This is kept at
the raw product-coordinate level so it can be applied both to the kernel and
to the multiplier times the spatial Fourier transform of the input. -/
private theorem scratch_spaceTimeFourierInv_eq_productIntegral
    (G : WaveSpaceTime → Complex)
    (hG : Integrable G (volume.prod volume))
    (u : Euclidean 2) (t : Real) :
    spaceTimeFourierInv G (u, t) =
      ∫ z : WaveSpaceTime,
        (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 u) : Complex) * G z := by
  let Q : Euclidean 2 → Real → Complex := fun xi tau =>
    (Real.fourierChar (inner Real tau t) : Complex) *
      (Real.fourierChar (inner Real xi u) : Complex) * G (xi, tau)
  have hQ : Integrable (Function.uncurry Q) (volume.prod volume) := by
    have hphaseT : Continuous (fun z : WaveSpaceTime =>
        (Real.fourierChar (inner Real z.2 t) : Complex)) := by
      fun_prop
    have hphaseU : Continuous (fun z : WaveSpaceTime =>
        (Real.fourierChar (inner Real z.1 u) : Complex)) := by
      fun_prop
    refine hG.congr' ?_ ?_
    · exact
        ((hphaseT.aestronglyMeasurable.mul hphaseU.aestronglyMeasurable).mul
          hG.aestronglyMeasurable)
    · filter_upwards with z
      simp only [Q, Function.uncurry, norm_mul, Circle.norm_coe, one_mul]
  have hleft :
      spaceTimeFourierInv G (u, t) = ∫ tau : Real, ∫ xi : Euclidean 2, Q xi tau := by
    unfold spaceTimeFourierInv
    rw [Real.fourierInv_eq]
    apply integral_congr_ae
    filter_upwards with tau
    rw [Real.fourierInv_eq]
    change
      (Real.fourierChar (inner Real tau t) : Complex) *
          ∫ xi : Euclidean 2,
            (Real.fourierChar (inner Real xi u) : Complex) * G (xi, tau) =
        ∫ xi : Euclidean 2, Q xi tau
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with xi
    simp only [Q]
    ring
  have hQswap : Integrable
      (Function.uncurry (fun tau : Real => fun xi : Euclidean 2 => Q xi tau))
      (volume.prod volume) := by
    convert hQ.swap using 1
    ext z
    rcases z with ⟨tau, xi⟩
    rfl
  have hswap :
      (∫ tau : Real, ∫ xi : Euclidean 2, Q xi tau) =
        ∫ xi : Euclidean 2, ∫ tau : Real, Q xi tau :=
    integral_integral_swap hQswap
  have hprod :
      (∫ xi : Euclidean 2, ∫ tau : Real, Q xi tau) =
        ∫ z : WaveSpaceTime, Q z.1 z.2 := by
    rw [Measure.volume_eq_prod]
    exact (integral_prod (Function.uncurry Q) hQ).symm
  calc
    spaceTimeFourierInv G (u, t) = ∫ tau : Real, ∫ xi : Euclidean 2, Q xi tau := hleft
    _ = ∫ xi : Euclidean 2, ∫ tau : Real, Q xi tau := hswap
    _ = ∫ z : WaveSpaceTime, Q z.1 z.2 := hprod
    _ = ∫ z : WaveSpaceTime,
        (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 u) : Complex) * G z := by
      rfl

private theorem scratch_jointSchwartz_mul_spatialFourier_integrable
    (M : SchwartzMap JointWaveSpaceTime Complex)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun z : WaveSpaceTime =>
      M (WithLp.toLp 2 z) *
        FourierTransform.fourier (f : Euclidean 2 → Complex) z.1)
      (volume.prod volume) := by
  let Mraw : WaveSpaceTime → Complex := fun z => M (WithLp.toLp 2 z)
  have hfhat_le (xi : Euclidean 2) :
      ‖FourierTransform.fourier (f : Euclidean 2 → Complex) xi‖ ≤
        ∫ y : Euclidean 2, ‖f y‖ := by
    rw [Real.fourier_eq]
    calc
      ‖∫ y : Euclidean 2,
          Real.fourierChar (-inner Real y xi) • (f : Euclidean 2 → Complex) y‖ ≤
          ∫ y : Euclidean 2,
            ‖Real.fourierChar (-inner Real y xi) • (f : Euclidean 2 → Complex) y‖ :=
        norm_integral_le_integral_norm _
      _ = ∫ y : Euclidean 2, ‖f y‖ := by
        simp only [Circle.norm_smul]
  refine Integrable.mono'
    ((scratch_jointSchwartzRaw_integrable_prod M).norm.mul_const
      (∫ y : Euclidean 2, ‖f y‖)) ?_ ?_
  · exact
      (scratch_jointSchwartzRaw_integrable_prod M).aestronglyMeasurable.mul
        (((FourierTransform.fourier f : SchwartzMap (Euclidean 2) Complex).continuous.comp
          continuous_fst).aestronglyMeasurable)
  · filter_upwards with z
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (hfhat_le z.1)
      (norm_nonneg (M (WithLp.toLp 2 z)))

/-- A joint Schwartz multiplier acting on the spatial Fourier transform of a
Schwartz input is literally convolution in the spatial variable with its
inverse joint Fourier kernel. -/
private theorem scratch_spaceTimeFourierInv_jointSchwartz_mul_spatialFourier_eq_sourceKernel
    (M : SchwartzMap JointWaveSpaceTime Complex)
    (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) (t : Real) :
    spaceTimeFourierInv
        (fun zeta : WaveSpaceTime =>
          jointSchwartzRaw M zeta *
            FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1)
        (x, t) =
      ∫ y : Euclidean 2,
        spaceTimeFourierInv (jointSchwartzRaw M) (x - y, t) * f y := by
  let Mraw : WaveSpaceTime → Complex := fun z => M (WithLp.toLp 2 z)
  have hM : Integrable Mraw (volume.prod volume) :=
    scratch_jointSchwartzRaw_integrable_prod M
  have hMfhat : Integrable (fun z : WaveSpaceTime =>
      Mraw z * FourierTransform.fourier (f : Euclidean 2 → Complex) z.1)
      (volume.prod volume) := by
    simpa only [Mraw] using scratch_jointSchwartz_mul_spatialFourier_integrable M f
  have htriple := scratch_source_kernel_triple_integrable M f x t
  have hfourier (z : WaveSpaceTime) :
      (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
            FourierTransform.fourier (f : Euclidean 2 → Complex) z.1 =
        ∫ y : Euclidean 2,
          (Real.fourierChar (inner Real z.2 t) : Complex) *
            (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
              (Real.fourierChar (-inner Real y z.1) : Complex) * f y := by
    rw [Real.fourier_eq]
    change
      (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
          ∫ y : Euclidean 2,
            (Real.fourierChar (-inner Real y z.1) : Complex) * f y = _
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with y
    ring
  have hphase (xi y : Euclidean 2) :
      (Real.fourierChar (inner Real xi x) : Complex) *
          (Real.fourierChar (-inner Real y xi) : Complex) =
        (Real.fourierChar (inner Real xi (x - y)) : Complex) := by
    have harg :
        inner Real xi x + -inner Real y xi = inner Real xi (x - y) := by
      rw [inner_sub_right, real_inner_comm y xi]
      ring
    rw [← Circle.coe_mul, ← Real.fourierChar.map_add_eq_mul, harg]
  have hinner (y : Euclidean 2) :
      (∫ z : WaveSpaceTime,
        (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
            (Real.fourierChar (-inner Real y z.1) : Complex) * f y) =
        spaceTimeFourierInv Mraw (x - y, t) * f y := by
    calc
      (∫ z : WaveSpaceTime,
        (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
            (Real.fourierChar (-inner Real y z.1) : Complex) * f y) =
          ∫ z : WaveSpaceTime,
            ((Real.fourierChar (inner Real z.2 t) : Complex) *
              (Real.fourierChar (inner Real z.1 (x - y)) : Complex) * Mraw z) * f y := by
            apply integral_congr_ae
            filter_upwards with z
            rw [← hphase z.1 y]
            ring
      _ = (∫ z : WaveSpaceTime,
            (Real.fourierChar (inner Real z.2 t) : Complex) *
              (Real.fourierChar (inner Real z.1 (x - y)) : Complex) * Mraw z) * f y := by
            rw [integral_mul_const]
      _ = spaceTimeFourierInv Mraw (x - y, t) * f y := by
            rw [← scratch_spaceTimeFourierInv_eq_productIntegral Mraw hM (x - y) t]
  calc
    spaceTimeFourierInv
        (fun zeta : WaveSpaceTime =>
          jointSchwartzRaw M zeta *
            FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1)
        (x, t) =
        ∫ z : WaveSpaceTime,
          (Real.fourierChar (inner Real z.2 t) : Complex) *
            (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
              FourierTransform.fourier (f : Euclidean 2 → Complex) z.1 := by
          simpa only [Mraw, jointSchwartzRaw, mul_assoc] using
            (scratch_spaceTimeFourierInv_eq_productIntegral
              (fun z : WaveSpaceTime =>
                Mraw z * FourierTransform.fourier (f : Euclidean 2 → Complex) z.1)
              hMfhat x t)
    _ = ∫ z : WaveSpaceTime, ∫ y : Euclidean 2,
          (Real.fourierChar (inner Real z.2 t) : Complex) *
            (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
              (Real.fourierChar (-inner Real y z.1) : Complex) * f y := by
          apply integral_congr_ae
          filter_upwards with z
          exact hfourier z
    _ = ∫ y : Euclidean 2, ∫ z : WaveSpaceTime,
          (Real.fourierChar (inner Real z.2 t) : Complex) *
            (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
              (Real.fourierChar (-inner Real y z.1) : Complex) * f y :=
          integral_integral_swap htriple
    _ = ∫ y : Euclidean 2,
          spaceTimeFourierInv Mraw (x - y, t) * f y := by
          apply integral_congr_ae
          filter_upwards with y
          exact hinner y
    _ = ∫ y : Euclidean 2,
          spaceTimeFourierInv (jointSchwartzRaw M) (x - y, t) * f y := by
          rfl

private theorem scratch_sourceKernel_convolution_orientation
    (K : WaveSpaceTime → Complex) (f : Euclidean 2 → Complex)
    (x : Euclidean 2) (t : Real) :
    (∫ y : Euclidean 2, K (x - y, t) * f y) =
      ∫ y : Euclidean 2, K (y, t) * f (x - y) := by
  let H : Euclidean 2 → Complex := fun u => K (u, t) * f (x - u)
  calc
    (∫ y : Euclidean 2, K (x - y, t) * f y) =
        ∫ y : Euclidean 2, H (x - y) := by
          apply integral_congr_ae
          filter_upwards with y
          simp only [H]
          have hxy : x - (x - y) = y := by abel
          rw [hxy]
    _ = ∫ u : Euclidean 2, H u :=
      integral_sub_left_eq_self H volume x
    _ = ∫ y : Euclidean 2, K (y, t) * f (x - y) := by
      rfl
/-- Fourier integration by parts reduces a physical joint-Schwartz seminorm
to literal frequency-side derivative `L¹` norms.  This is dimension-agnostic;
the intended use is the corrected radial--time residual multiplier. -/
private theorem fourierInv_jointSchwartz_seminorm_le_derivativeIntegrals
    (Q : SchwartzMap JointWaveSpaceTime Complex) (N : Nat) :
    SchwartzMap.seminorm Complex N 0
      (𝓕⁻ Q : SchwartzMap JointWaveSpaceTime Complex) ≤
      (2 : Real) ^ N * ∑ n ∈ Finset.range (N + 1),
        ∫ zeta : JointWaveSpaceTime,
          ‖iteratedFDeriv Real n (Q : JointWaveSpaceTime → Complex) zeta‖ := by
  apply SchwartzMap.seminorm_le_bound Complex N 0
    (𝓕⁻ Q : SchwartzMap JointWaveSpaceTime Complex)
  · exact mul_nonneg (by positivity)
      (Finset.sum_nonneg fun _ _ => integral_nonneg fun _ => norm_nonneg _)
  · intro x
    rw [norm_iteratedFDeriv_zero]
    rw [SchwartzMap.fourierInv_coe]
    change ‖x‖ ^ N * ‖𝓕⁻ (Q : JointWaveSpaceTime → Complex) x‖ ≤ _
    have h := Real.pow_mul_norm_iteratedFDeriv_fourier_le
      (f := (Q : JointWaveSpaceTime → Complex)) (K := 0) (N := N)
      (Q.smooth N)
      (fun k n hk hn => by
        have hk' : k = 0 := by simpa using hk
        subst k
        simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume Q 0 n)
      (k := 0) (n := N) (by simp) (by simp) (-x)
    simpa [Real.fourierInv_eq_fourier_neg] using h
/-- The literal active radial--time residual is the spatial convolution by
the inverse joint transform of its f-independent residual multiplier.  This
private source-local identity is consumed by the mixed Young estimate. -/
private theorem radialTimeResidual_eq_spatialConvolution_factorized
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) (t : Real) :
    radialTimeResidual (D.vertical : Real → Complex) (D.radial : Real → Complex)
        (fun _ => indices) scale (D.amplitude : Euclidean 2 → Complex)
        (D.time : Real → Complex) (f : Euclidean 2 → Complex) (x, t) =
      ∫ y : Euclidean 2,
        spaceTimeFourierInv
            (jointSchwartzRaw
              (mssRadialTimeResidualMultiplier D scale hscale indices)) (y, t) *
          f (x - y) := by
  rw [radialTimeResidual_eq_inverse_factorizedResidualSpectrum
    D scale hscale indices f]
  rw [scratch_spaceTimeFourierInv_jointSchwartz_mul_spatialFourier_eq_sourceKernel]
  exact scratch_sourceKernel_convolution_orientation
    (spaceTimeFourierInv
      (jointSchwartzRaw (mssRadialTimeResidualMultiplier D scale hscale indices)))
    (f : Euclidean 2 → Complex) x t

/-- The same literal kernel identity in the source API's scale-indexed
enumeration form. -/
private theorem radialTimeResidual_eq_spatialConvolution_factorized_of_indices
    (D : MSSRadialTimeCutoffs) (indices : Real → Finset Int)
    (scale : Real) (hscale : 0 < scale)
    (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) (t : Real) :
    radialTimeResidual (D.vertical : Real → Complex) (D.radial : Real → Complex)
        indices scale (D.amplitude : Euclidean 2 → Complex)
        (D.time : Real → Complex) (f : Euclidean 2 → Complex) (x, t) =
      ∫ y : Euclidean 2,
        spaceTimeFourierInv
            (jointSchwartzRaw
              (mssRadialTimeResidualMultiplier D scale hscale (indices scale))) (y, t) *
          f (x - y) := by
  change radialTimeResidual (D.vertical : Real → Complex) (D.radial : Real → Complex)
      (fun _ => indices scale) scale (D.amplitude : Euclidean 2 → Complex)
      (D.time : Real → Complex) (f : Euclidean 2 → Complex) (x, t) = _
  exact radialTimeResidual_eq_spatialConvolution_factorized
    D scale hscale (indices scale) f x t
/-- The exact finite residual multiplier is pointwise the globally smooth
profile used for the normal-gap derivative estimate.  This private bridge
only relates the equivalent regular realizations in the radial--time proof. -/
private theorem mssRadialTimeResidualMultiplier_eq_scratchSmoothResidualProfile
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) :
    mssRadialTimeResidualMultiplier D scale hscale indices =
      scratchSmoothResidualProfile D scale hscale indices := by
  ext z
  have hz : WithLp.toLp 2 (z.fst, z.snd) = z := by
    apply (WithLp.ext_iff 2).2
    rfl
  rw [← hz]
  rw [mssRadialTimeResidualMultiplier_apply,
    scratchSmoothResidualProfile_eq_literal_multiplier]
  simp only [verticalMultiplier, WithLp.toLp_fst, WithLp.toLp_snd]
  rw [Codex.Spherical.MSS.scratchScaledNormalExtension_apply]
  unfold scratchScaledNormalCoordinate
  ring

private theorem exists_scale_pow_mul_integral_norm_iteratedFDeriv_mssRadialTimeResidualMultiplier_le
    (D : MSSRadialTimeCutoffs) (r N : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
      scale ^ N *
        (∫ z : JointWaveSpaceTime,
          ‖iteratedFDeriv Real r
            (mssRadialTimeResidualMultiplier D scale hscale
              (relevantRadialIndexEnumeration scale) :
                JointWaveSpaceTime → Complex) z‖) ≤ C := by
  rcases ScratchResidualMultiplierL1.exists_scale_pow_mul_integral_norm_iteratedFDeriv_scratchSmoothResidualProfile_le_uniform
      D r N with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro scale hscale hscale_two
  rw [mssRadialTimeResidualMultiplier_eq_scratchSmoothResidualProfile]
  exact hbound scale hscale hscale_two
/-- A finite `Iic (6,0)` physical Schwartz seminorm budget for the actual
residual multiplier.  This is the exact finite package consumed by the
spatial-slice kernel estimate at temporal decay order two. -/
private theorem exists_scale_pow_mul_iic_schwartzSeminorm_fourierInv_mssRadialTimeResidualMultiplier_le
    (D : MSSRadialTimeCutoffs) (N : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
      scale ^ N *
        ((Finset.Iic (6, 0)).sup fun m =>
          SchwartzMap.seminorm Complex m.1 m.2)
          (𝓕⁻ (mssRadialTimeResidualMultiplier D scale hscale
            (relevantRadialIndexEnumeration scale)) :
            SchwartzMap JointWaveSpaceTime Complex) ≤ C := by
  let c : Nat → Real := fun n =>
    (exists_scale_pow_mul_integral_norm_iteratedFDeriv_mssRadialTimeResidualMultiplier_le
      D n N).choose
  have hc_nonneg (n : Nat) : 0 ≤ c n := by
    exact (exists_scale_pow_mul_integral_norm_iteratedFDeriv_mssRadialTimeResidualMultiplier_le
      D n N).choose_spec.1
  have hc_bound (n : Nat) : ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
      scale ^ N *
        (∫ z : JointWaveSpaceTime,
          ‖iteratedFDeriv Real n
            (mssRadialTimeResidualMultiplier D scale hscale
              (relevantRadialIndexEnumeration scale) :
                JointWaveSpaceTime → Complex) z‖) ≤ c n := by
    intro scale hscale hscale_two
    exact (exists_scale_pow_mul_integral_norm_iteratedFDeriv_mssRadialTimeResidualMultiplier_le
      D n N).choose_spec.2 scale hscale hscale_two
  let CD : Real := ∑ n ∈ Finset.range 7, c n
  have hCD_nonneg : 0 ≤ CD := by
    dsimp only [CD]
    exact Finset.sum_nonneg fun n hn => hc_nonneg n
  refine ⟨(2 : Real) ^ 6 * CD, mul_nonneg (by positivity) hCD_nonneg, ?_⟩
  intro scale hscale hscale_two
  let M : SchwartzMap JointWaveSpaceTime Complex :=
    mssRadialTimeResidualMultiplier D scale hscale
      (relevantRadialIndexEnumeration scale)
  let J : Finset (Nat × Nat) := Finset.Iic (6, 0)
  let P : Nat × Nat → Seminorm Complex (SchwartzMap JointWaveSpaceTime Complex) :=
    fun m => SchwartzMap.seminorm Complex m.1 m.2
  have hscaleNpos : 0 < scale ^ N := pow_pos hscale N
  have hscaleNnonneg : 0 ≤ scale ^ N := hscaleNpos.le
  have hsum {k : Nat} (hk : k ≤ 6) :
      scale ^ N *
        (∑ n ∈ Finset.range (k + 1),
          ∫ z : JointWaveSpaceTime,
            ‖iteratedFDeriv Real n (M : JointWaveSpaceTime → Complex) z‖) ≤ CD := by
    rw [Finset.mul_sum]
    calc
      ∑ n ∈ Finset.range (k + 1), scale ^ N *
          (∫ z : JointWaveSpaceTime,
            ‖iteratedFDeriv Real n (M : JointWaveSpaceTime → Complex) z‖) ≤
          ∑ n ∈ Finset.range (k + 1), c n := by
            apply Finset.sum_le_sum
            intro n hn
            simpa only [M] using hc_bound n scale hscale hscale_two
      _ ≤ CD := by
            dsimp only [CD]
            apply Finset.sum_le_sum_of_subset_of_nonneg
            · exact (Finset.range_subset_range).2 (by omega)
            · intro n hn hnot
              exact hc_nonneg n
  have hPscaled (m : Nat × Nat) (hm : m ∈ J) :
      scale ^ N * P m (𝓕⁻ M) ≤ (2 : Real) ^ 6 * CD := by
    have hmle : m ≤ (6, 0) := Finset.mem_Iic.mp (by simpa only [J] using hm)
    have hmone : m.1 ≤ 6 := hmle.1
    have hmtwo : m.2 = 0 := Nat.eq_zero_of_le_zero hmle.2
    change scale ^ N *
        SchwartzMap.seminorm Complex m.1 m.2
          (𝓕⁻ M : SchwartzMap JointWaveSpaceTime Complex) ≤
        (2 : Real) ^ 6 * CD
    rw [hmtwo]
    have hsemi :=
      fourierInv_jointSchwartz_seminorm_le_derivativeIntegrals M m.1
    have hsum' := hsum hmone
    have hsum'_nonneg : 0 ≤
        scale ^ N *
          (∑ n ∈ Finset.range (m.1 + 1),
            ∫ z : JointWaveSpaceTime,
              ‖iteratedFDeriv Real n (M : JointWaveSpaceTime → Complex) z‖) := by
      apply mul_nonneg hscaleNnonneg
      exact Finset.sum_nonneg fun _ _ => integral_nonneg fun _ => norm_nonneg _
    calc
      scale ^ N *
          (SchwartzMap.seminorm Complex m.1 0
            (𝓕⁻ M : SchwartzMap JointWaveSpaceTime Complex) : Real) ≤ scale ^ N *
          ((2 : Real) ^ m.1 *
            ∑ n ∈ Finset.range (m.1 + 1),
              ∫ z : JointWaveSpaceTime,
                ‖iteratedFDeriv Real n (M : JointWaveSpaceTime → Complex) z‖) := by
            exact mul_le_mul_of_nonneg_left hsemi hscaleNnonneg
      _ = (2 : Real) ^ m.1 *
          (scale ^ N *
            ∑ n ∈ Finset.range (m.1 + 1),
              ∫ z : JointWaveSpaceTime,
                ‖iteratedFDeriv Real n (M : JointWaveSpaceTime → Complex) z‖) := by ring
      _ ≤ (2 : Real) ^ 6 * CD := by
            exact mul_le_mul (pow_le_pow_right₀ (by norm_num) hmone) hsum'
              hsum'_nonneg (by positivity)
  have hsup : J.sup P (𝓕⁻ M) ≤ ((2 : Real) ^ 6 * CD) / scale ^ N := by
    apply Seminorm.finset_sup_apply_le
    · exact div_nonneg (mul_nonneg (by positivity) hCD_nonneg) hscaleNnonneg
    intro m hm
    apply (mul_le_mul_iff_of_pos_left hscaleNpos).mp
    calc
      scale ^ N * P m (𝓕⁻ M) ≤ (2 : Real) ^ 6 * CD := hPscaled m hm
      _ = scale ^ N * (((2 : Real) ^ 6 * CD) / scale ^ N) := by
        field_simp [hscaleNpos.ne']
  change scale ^ N * J.sup P (𝓕⁻ M) ≤ (2 : Real) ^ 6 * CD
  calc
    scale ^ N * J.sup P (𝓕⁻ M) ≤
        scale ^ N * (((2 : Real) ^ 6 * CD) / scale ^ N) :=
      mul_le_mul_of_nonneg_left hsup hscaleNnonneg
    _ = (2 : Real) ^ 6 * CD := by field_simp [hscaleNpos.ne']

/-- A joint Schwartz profile has an integrable planar spatial slice.  This
is kept private because it only supplies the real-to-ENNReal conversion in
the radial--time localization proof. -/
private theorem integrable_jointSchwartzRaw_slice
    (K : SchwartzMap JointWaveSpaceTime Complex) (t : Real) :
    Integrable (fun x : Euclidean 2 => jointSchwartzRaw K (x, t)) volume := by
  let S : Real := (2 : Real) ^ 4 *
    ((Finset.Iic (4, 0)).sup fun m =>
      SchwartzMap.seminorm Complex m.1 m.2) K
  have hrawcont : Continuous (fun x : Euclidean 2 =>
      jointSchwartzRaw K (x, t)) := by
    change Continuous (fun x : Euclidean 2 => K (WithLp.toLp 2 (x, t)))
    exact K.continuous.comp
      ((WithLp.prod_continuous_toLp 2 (Euclidean 2) Real).comp
        (continuous_id.prodMk continuous_const))
  have hmeas : AEStronglyMeasurable (fun x : Euclidean 2 =>
      jointSchwartzRaw K (x, t)) volume := hrawcont.aestronglyMeasurable
  have hpoint : ∀ x : Euclidean 2,
      ‖jointSchwartzRaw K (x, t)‖ ≤ S * (1 + ‖x‖) ^ (-(4 : Real)) := by
    intro x
    let z : JointWaveSpaceTime := WithLp.toLp 2 (x, t)
    have hx : ‖x‖ ≤ ‖z‖ := by
      dsimp only [z]
      simpa using (WithLp.norm_fst_le (p := 2) (Euclidean 2)
        (WithLp.toLp 2 (x, t)))
    have hweight : (1 + ‖x‖) ^ 4 ≤ (1 + ‖z‖) ^ 4 := by
      gcongr
    have hsemi := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := Complex)
      (m := (4, (0 : Nat))) (k := 4) (n := (0 : Nat))
      (le_refl _) (le_refl _) K z
    simp only [norm_iteratedFDeriv_zero] at hsemi
    change ‖K z‖ ≤ S * (1 + ‖x‖) ^ (-(4 : Real))
    have hbase_pos : 0 < (1 + ‖x‖) ^ (4 : Nat) := by positivity
    have hsemi' : (1 + ‖x‖) ^ (4 : Nat) * ‖K z‖ ≤ S := by
      calc
        (1 + ‖x‖) ^ (4 : Nat) * ‖K z‖ ≤
            (1 + ‖z‖) ^ (4 : Nat) * ‖K z‖ :=
          mul_le_mul_of_nonneg_right hweight (norm_nonneg _)
        _ ≤ S := hsemi
    have hdiv : ‖K z‖ ≤ S / (1 + ‖x‖) ^ (4 : Nat) :=
      (le_div_iff₀ hbase_pos).2 (by simpa [mul_comm] using hsemi')
    rw [div_eq_mul_inv, ← inv_pow] at hdiv
    calc
      ‖K z‖ ≤ S * (1 + ‖x‖)⁻¹ ^ (4 : Nat) := hdiv
      _ = S * (1 + ‖x‖) ^ (-(4 : Real)) := by
        congr 1
        rw [Real.rpow_neg (by positivity)]
        norm_num [Real.rpow_natCast, inv_pow]
  have hweight : Integrable (fun x : Euclidean 2 =>
      S * (1 + ‖x‖) ^ (-(4 : Real))) volume := by
    have hdim : (Module.finrank Real (Euclidean 2) : Real) < 4 := by norm_num
    exact (integrable_one_add_norm hdim).const_mul S
  exact hweight.mono' hmeas (Eventually.of_forall hpoint)

/-- The ENNReal form of a real weighted slice estimate. -/
private theorem lintegral_enorm_slice_le_of_weighted_integral_norm_le
    {E : Type*} [NormedAddCommGroup E]
    (K : Euclidean 2 → Real → E)
    (hK : ∀ t : Real, Integrable (fun x : Euclidean 2 => K x t) volume)
    (A scale : Real) (N : Nat)
    (hbound : ∀ t : Real,
      (1 + |t|) ^ 2 *
          (∫ x : Euclidean 2, ‖K x t‖) ≤ A * (scale⁻¹) ^ N) :
    ∀ t : Real,
      (∫⁻ x : Euclidean 2, ‖K x t‖₊) ≤
        ENNReal.ofReal (A * (scale⁻¹) ^ N) *
          ENNReal.ofReal (((1 + |t|)⁻¹) ^ 2) := by
  intro t
  have hbase_pos : 0 < 1 + |t| := by positivity
  have hweight_pos : 0 < (1 + |t|) ^ 2 := pow_pos hbase_pos _
  have hInonneg : 0 ≤ ∫ x : Euclidean 2, ‖K x t‖ :=
    integral_nonneg fun _ => norm_nonneg _
  have hBnonneg : 0 ≤ A * (scale⁻¹) ^ N := by
    exact (mul_nonneg hweight_pos.le hInonneg).trans (hbound t)
  have hreal :
      (∫ x : Euclidean 2, ‖K x t‖) ≤
        (A * (scale⁻¹) ^ N) * ((1 + |t|)⁻¹) ^ 2 := by
    calc
      (∫ x : Euclidean 2, ‖K x t‖) ≤
          (A * (scale⁻¹) ^ N) / (1 + |t|) ^ 2 :=
        (le_div_iff₀ hweight_pos).2 (by simpa [mul_comm] using hbound t)
      _ = (A * (scale⁻¹) ^ N) * ((1 + |t|)⁻¹) ^ 2 := by
        rw [div_eq_mul_inv, ← inv_pow]
  change (∫⁻ x : Euclidean 2, ‖K x t‖ₑ) ≤ _
  rw [← ofReal_integral_norm_eq_lintegral_enorm (hK t)]
  calc
    ENNReal.ofReal (∫ x : Euclidean 2, ‖K x t‖) ≤
        ENNReal.ofReal
          ((A * (scale⁻¹) ^ N) * ((1 + |t|)⁻¹) ^ 2) :=
      ENNReal.ofReal_le_ofReal hreal
    _ = ENNReal.ofReal (A * (scale⁻¹) ^ N) *
        ENNReal.ofReal (((1 + |t|)⁻¹) ^ 2) :=
      ENNReal.ofReal_mul hBnonneg

/- Direct Schwartz slice control, kept private to avoid a Mikhlin dependency. -/
private theorem scratch_jointSchwartzRaw_pointwise_product_decay
    (K : SchwartzMap JointWaveSpaceTime Complex) (a b : Nat)
    (x : Euclidean 2) (t : Real) :
    (1 + ‖x‖) ^ a * (1 + |t|) ^ b *
        ‖jointSchwartzRaw K (x, t)‖ ≤
      (2 : Real) ^ (a + b) *
        ((Finset.Iic (a + b, 0)).sup fun m =>
          SchwartzMap.seminorm Complex m.1 m.2) K := by
  let z : JointWaveSpaceTime := WithLp.toLp 2 (x, t)
  have hx : ‖x‖ ≤ ‖z‖ := by
    dsimp only [z]
    simpa using (WithLp.norm_fst_le (p := 2) (Euclidean 2)
      (WithLp.toLp 2 (x, t)))
  have ht : |t| ≤ ‖z‖ := by
    dsimp only [z]
    have hraw := WithLp.norm_snd_le (p := 2) (Euclidean 2)
      (WithLp.toLp 2 (x, t))
    simpa only [WithLp.toLp_snd, Real.norm_eq_abs] using hraw
  have hweight : (1 + ‖x‖) ^ a * (1 + |t|) ^ b ≤
      (1 + ‖z‖) ^ (a + b) := by
    rw [pow_add]
    gcongr <;> linarith
  have hsemi := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := Complex)
    (m := (a + b, (0 : Nat))) (k := a + b) (n := (0 : Nat))
      (le_refl _) (le_refl _) K z
  simp only [norm_iteratedFDeriv_zero, pow_zero, mul_one] at hsemi
  change (1 + ‖x‖) ^ a * (1 + |t|) ^ b * ‖K (WithLp.toLp 2 (x, t))‖ ≤ _
  change (1 + ‖x‖) ^ a * (1 + |t|) ^ b * ‖K z‖ ≤ _
  calc
    (1 + ‖x‖) ^ a * (1 + |t|) ^ b * ‖K z‖ ≤
        (1 + ‖z‖) ^ (a + b) * ‖K z‖ := by
      exact mul_le_mul_of_nonneg_right hweight (norm_nonneg _)
    _ ≤ _ := hsemi

private theorem scratch_weighted_spatial_mass_jointSchwartzRaw_le
    (K : SchwartzMap JointWaveSpaceTime Complex) (b : Nat) (t : Real) :
    (1 + |t|) ^ b *
        (∫ x : Euclidean 2, ‖jointSchwartzRaw K (x, t)‖) ≤
      (2 : Real) ^ 4 *
        ((2 : Real) ^ (4 + b) *
          ((Finset.Iic (4 + b, 0)).sup fun m =>
            SchwartzMap.seminorm Complex m.1 m.2) K +
        (2 : Real) ^ (4 + b) *
          ((Finset.Iic (4 + b, 0)).sup fun m =>
            SchwartzMap.seminorm Complex m.1 m.2) K) *
        (∫ x : Euclidean 2, (1 + ‖x‖) ^ (-(4 : Real))) := by
  let T : Real := (1 + |t|) ^ b
  let S : Real := (2 : Real) ^ (4 + b) *
    ((Finset.Iic (4 + b, 0)).sup fun m =>
      SchwartzMap.seminorm Complex m.1 m.2) K
  let W : Euclidean 2 → Real := fun x => (1 + ‖x‖) ^ (-(4 : Real))
  have hT : 0 ≤ T := by
    dsimp only [T]
    positivity
  have hS : 0 ≤ S := by
    dsimp only [S]
    positivity
  have hrawcont : Continuous (fun z : WaveSpaceTime => K (WithLp.toLp 2 z)) :=
    K.continuous.comp (WithLp.prod_continuous_toLp 2 _ _)
  have hmeas : AEStronglyMeasurable
      (fun x : Euclidean 2 => T * ‖jointSchwartzRaw K (x, t)‖) volume := by
    change AEStronglyMeasurable
      (fun x : Euclidean 2 => T * ‖K (WithLp.toLp 2 (x, t))‖) volume
    exact (continuous_const.mul
      ((hrawcont.comp (continuous_id.prodMk continuous_const)).norm)).aestronglyMeasurable
  have hpoint : ∀ x : Euclidean 2,
      T * ‖jointSchwartzRaw K (x, t)‖ ≤ S * W x := by
    intro x
    have hprod := scratch_jointSchwartzRaw_pointwise_product_decay K 4 b x t
    have hprod' : (1 + ‖x‖) ^ (4 : Nat) *
        (T * ‖jointSchwartzRaw K (x, t)‖) ≤ S := by
      simpa only [T, mul_assoc] using hprod
    have hbase : 0 < (1 + ‖x‖) ^ (4 : Nat) := by positivity
    have hdiv : T * ‖jointSchwartzRaw K (x, t)‖ ≤
        S / (1 + ‖x‖) ^ (4 : Nat) :=
      (le_div_iff₀ hbase).2 (by simpa [mul_comm] using hprod')
    rw [div_eq_mul_inv, ← inv_pow] at hdiv
    calc
      T * ‖jointSchwartzRaw K (x, t)‖ ≤
          S * (1 + ‖x‖)⁻¹ ^ (4 : Nat) := hdiv
      _ = S * W x := by
        dsimp only [W]
        congr 1
        rw [Real.rpow_neg (by positivity)]
        norm_num [Real.rpow_natCast, inv_pow]
  have hW : Integrable W volume := by
    dsimp only [W]
    have hdim : (Module.finrank Real (Euclidean 2) : Real) < 4 := by norm_num
    exact integrable_one_add_norm hdim
  have hmajor : Integrable (fun x : Euclidean 2 => S * W x) volume :=
    hW.const_mul S
  have hleftInt : Integrable
      (fun x : Euclidean 2 => T * ‖jointSchwartzRaw K (x, t)‖) volume :=
    hmajor.mono' hmeas (Eventually.of_forall fun x => by
      rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hT (norm_nonneg _))]
      exact hpoint x)
  have hmain : T * (∫ x : Euclidean 2, ‖jointSchwartzRaw K (x, t)‖) ≤
      S * (∫ x : Euclidean 2, W x) := by
    calc
      T * (∫ x : Euclidean 2, ‖jointSchwartzRaw K (x, t)‖) =
          ∫ x : Euclidean 2, T * ‖jointSchwartzRaw K (x, t)‖ := by
            rw [← integral_const_mul]
      _ ≤ ∫ x : Euclidean 2, S * W x :=
          integral_mono hleftInt hmajor hpoint
      _ = S * (∫ x : Euclidean 2, W x) := by
          rw [integral_const_mul]
  have hWnonneg : 0 ≤ ∫ x : Euclidean 2, W x :=
    integral_nonneg fun _ => by
      dsimp only [W]
      positivity
  have hcoef : S ≤ (2 : Real) ^ 4 * (S + S) := by
    norm_num
    linarith
  change T * (∫ x : Euclidean 2, ‖jointSchwartzRaw K (x, t)‖) ≤
    (2 : Real) ^ 4 * (S + S) * (∫ x : Euclidean 2, W x)
  calc
    T * (∫ x : Euclidean 2, ‖jointSchwartzRaw K (x, t)‖) ≤
        S * (∫ x : Euclidean 2, W x) := hmain
    _ ≤ ((2 : Real) ^ 4 * (S + S)) * (∫ x : Euclidean 2, W x) :=
      mul_le_mul_of_nonneg_right hcoef hWnonneg
/-- The actual residual multiplier has a scale-uniform weighted real
spatial-slice bound at temporal decay order two. -/
private theorem exists_scale_pow_mul_weighted_sliceMass_mssRadialTimeResidualMultiplier_le
    (D : MSSRadialTimeCutoffs) (N : Nat) :
    ∃ A : Real, 0 ≤ A ∧ ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
      ∀ t : Real,
        (1 + |t|) ^ 2 *
          (∫ x : Euclidean 2,
            ‖jointSchwartzRaw
              (𝓕⁻ (mssRadialTimeResidualMultiplier D scale hscale
                (relevantRadialIndexEnumeration scale)) :
                  SchwartzMap JointWaveSpaceTime Complex) (x, t)‖) ≤
          A * (scale⁻¹) ^ N := by
  rcases exists_scale_pow_mul_iic_schwartzSeminorm_fourierInv_mssRadialTimeResidualMultiplier_le
      D N with ⟨C, hC, hCbound⟩
  let I : Real := ∫ x : Euclidean 2, (1 + ‖x‖) ^ (-(4 : Real))
  let L : Real := (2 : Real) ^ 4 * ((2 : Real) ^ 6 + (2 : Real) ^ 6) * I
  have hI : 0 ≤ I := by
    dsimp only [I]
    exact integral_nonneg fun _ => Real.rpow_nonneg (by positivity) _
  have hL : 0 ≤ L := by
    dsimp only [L]
    exact mul_nonneg (mul_nonneg (by positivity) (by positivity)) hI
  refine ⟨L * C, mul_nonneg hL hC, ?_⟩
  intro scale hscale hscale_two t
  let M : SchwartzMap JointWaveSpaceTime Complex :=
    mssRadialTimeResidualMultiplier D scale hscale
      (relevantRadialIndexEnumeration scale)
  let K : SchwartzMap JointWaveSpaceTime Complex := 𝓕⁻ M
  let S : Real := ((Finset.Iic (6, 0)).sup fun m =>
    SchwartzMap.seminorm Complex m.1 m.2) K
  have hscaleNpos : 0 < scale ^ N := pow_pos hscale N
  have hS : scale ^ N * S ≤ C := by
    simpa only [M, K, S] using hCbound scale hscale hscale_two
  have hSbound : S ≤ C * (scale⁻¹) ^ N := by
    calc
      S ≤ C / scale ^ N :=
        (le_div_iff₀ hscaleNpos).2 (by simpa [mul_comm] using hS)
      _ = C * (scale⁻¹) ^ N := by
        rw [div_eq_mul_inv, inv_pow]
  have hslice := scratch_weighted_spatial_mass_jointSchwartzRaw_le K 2 t
  calc
    (1 + |t|) ^ 2 *
        (∫ x : Euclidean 2, ‖jointSchwartzRaw K (x, t)‖) ≤
        (2 : Real) ^ 4 * ((2 : Real) ^ 6 * S + (2 : Real) ^ 6 * S) * I := by
          simpa only [K, S] using hslice
    _ = L * S := by
      dsimp only [L]
      ring
    _ ≤ L * (C * (scale⁻¹) ^ N) :=
      mul_le_mul_of_nonneg_left hSbound hL
    _ = (L * C) * (scale⁻¹) ^ N := by ring
private def scratch_tailWeight (t : Real) : Real := (1 + t ^ 2)⁻¹

private theorem scratch_tailWeight_nonneg (t : Real) :
    0 ≤ scratch_tailWeight t := by
  unfold scratch_tailWeight
  positivity

private theorem scratch_tailWeight_le_one (t : Real) :
    scratch_tailWeight t ≤ 1 := by
  unfold scratch_tailWeight
  have hbase : 1 ≤ 1 + t ^ 2 := by nlinarith [sq_nonneg t]
  exact (inv_le_one₀ (by positivity)).mpr hbase

private theorem scratch_tailWeight_continuous :
    Continuous scratch_tailWeight := by
  unfold scratch_tailWeight
  exact (continuous_const.add (continuous_id.pow 2)).inv₀
    (fun t => by
      have : 0 < 1 + t ^ 2 := by nlinarith [sq_nonneg t]
      exact ne_of_gt this)

private theorem scratch_tailWeight_integrable :
    Integrable scratch_tailWeight := by
  exact integrable_inv_one_add_sq

private theorem scratch_tailWeight_rpow_integrable
    (p : ENNReal) (hp : 1 ≤ p) (htop : p ≠ ∞) :
    Integrable (fun t : Real => scratch_tailWeight t ^ p.toReal) := by
  refine scratch_tailWeight_integrable.mono' ?_ ?_
  · exact (scratch_tailWeight_continuous.rpow_const
      (fun _ => Or.inr ENNReal.toReal_nonneg)).aestronglyMeasurable
  · filter_upwards with t
    rw [Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg (scratch_tailWeight_nonneg t) _)]
    have hpReal : 1 ≤ p.toReal := by
      simpa using ENNReal.toReal_mono htop hp
    exact Real.rpow_le_self_of_le_one
      (scratch_tailWeight_nonneg t) (scratch_tailWeight_le_one t) hpReal

private theorem scratch_tailWeight_eLpNorm_lt_top
    (p : ENNReal) (hp : 1 ≤ p) :
    eLpNorm scratch_tailWeight p volume < ∞ := by
  by_cases htop : p = ∞
  · rw [htop, eLpNorm_exponent_top]
    exact eLpNormEssSup_lt_top_of_ae_bound
      (Eventually.of_forall fun t => by
        rw [Real.norm_eq_abs, abs_of_nonneg (scratch_tailWeight_nonneg t)]
        exact scratch_tailWeight_le_one t)
  · have hp0 : p ≠ 0 := by
      exact ne_of_gt (lt_of_lt_of_le zero_lt_one hp)
    apply (eLpNorm_lt_top_iff_lintegral_rpow_enorm_lt_top hp0 htop).mpr
    have hpow := scratch_tailWeight_rpow_integrable p hp htop
    have hfin :
        (∫⁻ t : Real, ‖scratch_tailWeight t ^ p.toReal‖ₑ) < ∞ :=
      hpow.hasFiniteIntegral
    convert hfin using 1
    apply lintegral_congr
    intro t
    exact (Real.enorm_rpow_of_nonneg (scratch_tailWeight_nonneg t)
      ENNReal.toReal_nonneg).symm

/-- All-exponent coefficient extraction: no finite-exponent case split is
needed here, so this includes `p = ∞`. -/
private theorem scratch_eLpNorm_sliceMass_le_tailWeight
    (p : ENNReal) (S : Real → ENNReal) (c : ENNReal)
    (hS : ∀ t : Real,
      S t ≤ c * ENNReal.ofReal (scratch_tailWeight t)) :
    eLpNorm S p volume ≤ c * eLpNorm scratch_tailWeight p volume := by
  apply eLpNorm_le_mul_eLpNorm_of_ae_le_mul'' p
    scratch_tailWeight_continuous.aestronglyMeasurable
  filter_upwards with t
  simpa [Real.enorm_of_nonneg (scratch_tailWeight_nonneg t)] using hS t

private theorem scratch_absTail_le_tailWeight (t : Real) :
    ((1 + |t|)⁻¹) ^ (2 : Nat) ≤ scratch_tailWeight t := by
  have hpos : 0 < (1 + t ^ 2 : Real) := by nlinarith [sq_nonneg t]
  have hden : 1 + t ^ 2 ≤ (1 + |t|) ^ (2 : Nat) := by
    nlinarith [sq_abs t, abs_nonneg t]
  unfold scratch_tailWeight
  have hinv := one_div_le_one_div_of_le hpos hden
  simpa [one_div, inv_pow] using hinv

/-- The final time-coefficient step for the active theorem.  A pointwise
`(1 + |t|)⁻²` slice estimate produces the required scale decay in every
extended exponent, including `∞`. -/

private theorem scratch_eLpNorm_sliceMass_decay_all_p_of_real_bound_uniform
    (p : ENNReal) (hp : 1 ≤ p) (A : Real) (N : Nat) (hA : 0 ≤ A) :
    ∃ C : Real, 0 < C ∧ ∀ scale : Real, 0 < scale →
      ∀ S : Real → ENNReal,
      (∀ t : Real,
        S t ≤ ENNReal.ofReal
          (A * (scale⁻¹) ^ N * ((1 + |t|)⁻¹) ^ (2 : Nat))) →
      eLpNorm S p volume ≤ ENNReal.ofReal (C * (scale⁻¹) ^ N) := by
  let W : ENNReal := eLpNorm scratch_tailWeight p volume
  let B : Real := W.toReal
  have hWlt : W < ∞ := scratch_tailWeight_eLpNorm_lt_top p hp
  have hW : W ≠ ∞ := hWlt.ne
  refine ⟨A * B + 1, ?_, ?_⟩
  · have hAB : 0 ≤ A * B := mul_nonneg hA ENNReal.toReal_nonneg
    linarith
  · intro scale hscale S hS
    have hsnonneg : 0 ≤ (scale⁻¹) ^ N := by
      exact pow_nonneg (inv_nonneg.mpr hscale.le) _
    have hAsnonneg : 0 ≤ A * (scale⁻¹) ^ N :=
      mul_nonneg hA hsnonneg
    have htail : ∀ t : Real,
        S t ≤ ENNReal.ofReal (A * (scale⁻¹) ^ N) *
          ENNReal.ofReal (scratch_tailWeight t) := by
      intro t
      have ht := hS t
      rw [ENNReal.ofReal_mul hAsnonneg] at ht
      refine ht.trans ?_
      gcongr
      exact scratch_absTail_le_tailWeight t
    have hcoeff := scratch_eLpNorm_sliceMass_le_tailWeight p S
      (ENNReal.ofReal (A * (scale⁻¹) ^ N)) htail
    calc
      eLpNorm S p volume ≤ ENNReal.ofReal (A * (scale⁻¹) ^ N) * W := hcoeff
      _ = ENNReal.ofReal ((A * B) * (scale⁻¹) ^ N) := by
        rw [← ENNReal.ofReal_toReal hW]
        rw [← ENNReal.ofReal_mul hAsnonneg]
        congr 1
        ring
      _ ≤ ENNReal.ofReal ((A * B + 1) * (scale⁻¹) ^ N) := by
        apply ENNReal.ofReal_le_ofReal
        calc
          (A * B) * (scale⁻¹) ^ N ≤
              (A * B) * (scale⁻¹) ^ N + 1 * (scale⁻¹) ^ N :=
            le_add_of_nonneg_right (by simpa using hsnonneg)
          _ = (A * B + 1) * (scale⁻¹) ^ N := by ring

private theorem scratch_ennreal_weighted_factor_of_holder
    {p r : Real} (hpq : r.HolderConjugate p) (a b : ENNReal) :
    a * b = a ^ r⁻¹ * (a * b ^ p) ^ p⁻¹ := by
  have hp0 : 0 < p := hpq.symm.pos
  have hr0 : 0 < r := hpq.pos
  have hbinv : (b ^ p) ^ p⁻¹ = b := by
    calc
      (b ^ p) ^ p⁻¹ = b ^ (p * p⁻¹) := (ENNReal.rpow_mul _ _ _).symm
      _ = b := by rw [mul_inv_cancel₀ hp0.ne', ENNReal.rpow_one]
  rw [ENNReal.mul_rpow_of_nonneg _ _ hpq.symm.inv_nonneg]
  rw [hbinv]
  calc
    a * b = a ^ (r⁻¹ + p⁻¹) * b := by rw [hpq.inv_add_inv_eq_one, ENNReal.rpow_one]
    _ = (a ^ r⁻¹ * a ^ p⁻¹) * b := by
      rw [ENNReal.rpow_add_of_nonneg _ _ hpq.inv_nonneg hpq.symm.inv_nonneg]
    _ = a ^ r⁻¹ * (a ^ p⁻¹ * b) := by ring

private theorem scratch_lintegral_spatial_p_pointwise
    (p r : Real) (hpq : r.HolderConjugate p)
    (K q : Euclidean 2 → ENNReal)
    (hK : Measurable K) (hq : Measurable q) (x : Euclidean 2) :
    (∫⁻ y : Euclidean 2, K y * q (x - y)) ^ p ≤
      (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
        ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p := by
  have hp0 : 0 < p := hpq.symm.pos
  have hr0 : 0 < r := hpq.pos
  let a : Euclidean 2 → ENNReal := fun y => K y ^ r⁻¹
  let b : Euclidean 2 → ENNReal := fun y =>
    (K y * q (x - y) ^ p) ^ p⁻¹
  have ha : AEMeasurable a volume := by
    exact (hK.pow measurable_const).aemeasurable
  have hqx : Measurable (fun y : Euclidean 2 => q (x - y)) :=
    hq.comp (measurable_const.sub measurable_id)
  have hb : AEMeasurable b volume := by
    exact ((hK.mul (hqx.pow measurable_const)).pow measurable_const).aemeasurable
  have hholder := ENNReal.lintegral_mul_le_Lp_mul_Lq volume hpq ha hb
  have hleft : (∫⁻ y : Euclidean 2, (a * b) y) =
      ∫⁻ y : Euclidean 2, K y * q (x - y) := by
    apply lintegral_congr
    intro y
    simp only [a, b, Pi.mul_apply]
    exact (scratch_ennreal_weighted_factor_of_holder hpq (K y) (q (x - y))).symm
  have hfirst :
      (∫⁻ y : Euclidean 2, a y ^ r) = ∫⁻ y : Euclidean 2, K y := by
    apply lintegral_congr
    intro y
    simp only [a]
    rw [← ENNReal.rpow_mul, inv_mul_cancel₀ hr0.ne', ENNReal.rpow_one]
  have hsecond :
      (∫⁻ y : Euclidean 2, b y ^ p) =
        ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p := by
    apply lintegral_congr
    intro y
    simp only [b]
    rw [← ENNReal.rpow_mul, inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one]
  have hholder' :
      (∫⁻ y : Euclidean 2, K y * q (x - y)) ≤
        (∫⁻ y : Euclidean 2, K y) ^ r⁻¹ *
          (∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) ^ p⁻¹ := by
    rw [hleft, hfirst, hsecond] at hholder
    simpa only [one_div] using hholder
  have hrp : r⁻¹ * p = p - 1 := by
    rw [← hpq.symm.one_sub_inv]
    field_simp [hp0.ne']
  have hpow := ENNReal.rpow_le_rpow hholder' hp0.le
  calc
    (∫⁻ y : Euclidean 2, K y * q (x - y)) ^ p ≤
        ((∫⁻ y : Euclidean 2, K y) ^ r⁻¹ *
          (∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) ^ p⁻¹) ^ p := hpow
    _ = (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
        ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
      rw [← ENNReal.rpow_mul, ← ENNReal.rpow_mul, hrp,
        inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one]

private theorem scratch_lintegral_spatial_p_young
    (p r : Real) (hpq : r.HolderConjugate p)
    (K q : Euclidean 2 → ENNReal)
    (hK : Measurable K) (hq : Measurable q) :
    ∫⁻ x : Euclidean 2, (∫⁻ y : Euclidean 2, K y * q (x - y)) ^ p ≤
      (∫⁻ y : Euclidean 2, K y) ^ p * ∫⁻ x : Euclidean 2, q x ^ p := by
  have hp0 : 0 < p := hpq.symm.pos
  have hpone : 1 ≤ p := hpq.symm.lt.le
  let H : Euclidean 2 × Euclidean 2 → ENNReal := fun z =>
    K z.2 * q (z.1 - z.2) ^ p
  have hH : Measurable H := by
    exact (hK.comp measurable_snd).mul
      ((hq.comp (measurable_fst.sub measurable_snd)).pow measurable_const)
  have hinner : Measurable (fun x : Euclidean 2 =>
      ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) := by
    exact hH.lintegral_prod_right
  have htranslate (y : Euclidean 2) :
      (∫⁻ x : Euclidean 2, q (x - y) ^ p) = ∫⁻ x : Euclidean 2, q x ^ p := by
    exact (measurePreserving_sub_right (volume : Measure (Euclidean 2)) y).lintegral_comp
      (hq.pow measurable_const)
  have hdouble :
      (∫⁻ x : Euclidean 2, ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) =
        (∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x ^ p := by
    calc
      (∫⁻ x : Euclidean 2, ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) =
          ∫⁻ y : Euclidean 2, ∫⁻ x : Euclidean 2, K y * q (x - y) ^ p := by
        exact lintegral_lintegral_swap hH.aemeasurable
      _ = ∫⁻ y : Euclidean 2, K y * (∫⁻ x : Euclidean 2, q (x - y) ^ p) := by
        apply lintegral_congr
        intro y
        simpa only [Function.comp_apply, Pi.sub_apply, id_eq] using
          (lintegral_const_mul (K y)
            ((hq.comp (measurable_id.sub measurable_const)).pow measurable_const))
      _ = ∫⁻ y : Euclidean 2, K y * (∫⁻ x : Euclidean 2, q x ^ p) := by
        apply lintegral_congr
        intro y
        rw [htranslate y]
      _ = (∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x ^ p :=
        lintegral_mul_const _ hK
  calc
    (∫⁻ x : Euclidean 2, (∫⁻ y : Euclidean 2, K y * q (x - y)) ^ p) ≤
        ∫⁻ x : Euclidean 2, (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
          (∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) := by
      apply lintegral_mono
      intro x
      exact scratch_lintegral_spatial_p_pointwise p r hpq K q hK hq x
    _ = (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
        (∫⁻ x : Euclidean 2, ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) := by
      rw [lintegral_const_mul _ hinner]
    _ = (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
        ((∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x ^ p) := by
      rw [hdouble]
    _ = (∫⁻ y : Euclidean 2, K y) ^ p * ∫⁻ x : Euclidean 2, q x ^ p := by
      calc
        (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
            ((∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x ^ p) =
            ((∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
              ∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x ^ p := by
          ring
        _ =
            ((∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
              (∫⁻ y : Euclidean 2, K y) ^ (1 : Real)) *
              ∫⁻ x : Euclidean 2, q x ^ p := by rw [ENNReal.rpow_one]
        _ = (∫⁻ y : Euclidean 2, K y) ^ ((p - 1) + 1) *
              ∫⁻ x : Euclidean 2, q x ^ p := by
          rw [← ENNReal.rpow_add_of_nonneg _ _
            (sub_nonneg.mpr hpone) (by norm_num : (0 : Real) ≤ 1)]
        _ = (∫⁻ y : Euclidean 2, K y) ^ p * ∫⁻ x : Euclidean 2, q x ^ p := by
          congr 2
          ring

private theorem scratch_complex_spatial_convolution_p_moment
    (p : Real) (hp : 1 < p)
    (K f : Euclidean 2 → Complex)
    (hK : Measurable K) (hf : Measurable f) :
    ∫⁻ x : Euclidean 2,
        ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ^ p ≤
      (∫⁻ y : Euclidean 2, ‖K y‖ₑ) ^ p *
        ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ p := by
  have hpq : p.conjExponent.HolderConjugate p :=
    (Real.HolderConjugate.conjExponent hp).symm
  have hpoint (x : Euclidean 2) :
      ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ≤
        ∫⁻ y : Euclidean 2, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
    change ‖∫ y : Euclidean 2, K y * f (x - y)‖ₑ ≤ _
    calc
      ‖∫ y : Euclidean 2, K y * f (x - y)‖ₑ ≤
          ∫⁻ y : Euclidean 2, ‖K y * f (x - y)‖ₑ :=
        enorm_integral_le_lintegral_enorm _
      _ = ∫⁻ y : Euclidean 2, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
        apply lintegral_congr
        intro y
        rw [enorm_mul]
  calc
    (∫⁻ x : Euclidean 2,
        ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ^ p) ≤
        ∫⁻ x : Euclidean 2,
          (∫⁻ y : Euclidean 2, ‖K y‖ₑ * ‖f (x - y)‖ₑ) ^ p := by
      apply lintegral_mono
      intro x
      exact ENNReal.rpow_le_rpow (hpoint x) (by positivity)
    _ ≤ (∫⁻ y : Euclidean 2, ‖K y‖ₑ) ^ p *
        ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ p :=
      scratch_lintegral_spatial_p_young p p.conjExponent hpq
        (fun y => ‖K y‖ₑ) (fun x => ‖f x‖ₑ) hK.enorm hf.enorm

private theorem scratch_ennreal_rpow_inv_cancel
    (p : Real) (hp : 0 < p) (a : ENNReal) :
    (a ^ p) ^ p⁻¹ = a := by
  calc
    (a ^ p) ^ p⁻¹ = a ^ (p * p⁻¹) := (ENNReal.rpow_mul _ _ _).symm
    _ = a := by rw [mul_inv_cancel₀ hp.ne', ENNReal.rpow_one]

private theorem scratch_complex_spatial_convolution_p_young
    (p : Real) (hp : 1 < p)
    (K f : Euclidean 2 → Complex)
    (hK : Measurable K) (hf : Measurable f) :
    eLpNorm (K ⋆[ContinuousLinearMap.mul Complex Complex] f) (ENNReal.ofReal p) volume ≤
      (∫⁻ y : Euclidean 2, ‖K y‖ₑ) * eLpNorm f (ENNReal.ofReal p) volume := by
  have hp0 : 0 < p := lt_trans zero_lt_one hp
  let L : ENNReal := ∫⁻ y : Euclidean 2, ‖K y‖ₑ
  let J : ENNReal := ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ p
  have hmoment :
      (∫⁻ x : Euclidean 2,
          ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ^ p) ≤ L ^ p * J := by
    simpa only [L, J] using scratch_complex_spatial_convolution_p_moment p hp K f hK hf
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top]
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top]
  simp only [ENNReal.toReal_ofReal hp0.le]
  have hroot :
      (∫⁻ x : Euclidean 2,
          ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ^ p) ^ p⁻¹ ≤
        L * J ^ p⁻¹ := by
    calc
      (∫⁻ x : Euclidean 2,
          ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ^ p) ^ p⁻¹ ≤
          (L ^ p * J) ^ p⁻¹ := ENNReal.rpow_le_rpow hmoment (inv_nonneg.mpr hp0.le)
      _ = (L ^ p) ^ p⁻¹ * J ^ p⁻¹ :=
        ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hp0.le)
      _ = L * J ^ p⁻¹ := by rw [scratch_ennreal_rpow_inv_cancel p hp0]
  convert hroot using 1 <;> simp only [L, J, one_div]

private theorem scratch_lintegral_spatial_one_young
    (K q : Euclidean 2 → ENNReal)
    (hK : Measurable K) (hq : Measurable q) :
    (∫⁻ x : Euclidean 2, ∫⁻ y : Euclidean 2, K y * q (x - y)) =
      (∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x := by
  let H : Euclidean 2 × Euclidean 2 → ENNReal := fun z =>
    K z.2 * q (z.1 - z.2)
  have hH : Measurable H := by
    exact (hK.comp measurable_snd).mul
      (hq.comp (measurable_fst.sub measurable_snd))
  have htranslate (y : Euclidean 2) :
      (∫⁻ x : Euclidean 2, q (x - y)) = ∫⁻ x : Euclidean 2, q x := by
    exact (measurePreserving_sub_right (volume : Measure (Euclidean 2)) y).lintegral_comp hq
  calc
    (∫⁻ x : Euclidean 2, ∫⁻ y : Euclidean 2, K y * q (x - y)) =
        ∫⁻ y : Euclidean 2, ∫⁻ x : Euclidean 2, K y * q (x - y) := by
      exact lintegral_lintegral_swap hH.aemeasurable
    _ = ∫⁻ y : Euclidean 2, K y * (∫⁻ x : Euclidean 2, q (x - y)) := by
      apply lintegral_congr
      intro y
      simpa only [Function.comp_apply, Pi.sub_apply, id_eq] using
        (lintegral_const_mul (K y) (hq.comp (measurable_id.sub measurable_const)))
    _ = ∫⁻ y : Euclidean 2, K y * (∫⁻ x : Euclidean 2, q x) := by
      apply lintegral_congr
      intro y
      rw [htranslate y]
    _ = (∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x :=
      lintegral_mul_const _ hK

private theorem scratch_complex_spatial_convolution_one_young
    (K f : Euclidean 2 → Complex)
    (hK : Measurable K) (hf : Measurable f) :
    eLpNorm (K ⋆[ContinuousLinearMap.mul Complex Complex] f) (1 : ENNReal) volume ≤
      (∫⁻ y : Euclidean 2, ‖K y‖ₑ) * eLpNorm f (1 : ENNReal) volume := by
  rw [eLpNorm_one_eq_lintegral_enorm]
  rw [eLpNorm_one_eq_lintegral_enorm]
  have hpoint (x : Euclidean 2) :
      ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ≤
        ∫⁻ y : Euclidean 2, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
    change ‖∫ y : Euclidean 2, K y * f (x - y)‖ₑ ≤ _
    calc
      ‖∫ y : Euclidean 2, K y * f (x - y)‖ₑ ≤
          ∫⁻ y : Euclidean 2, ‖K y * f (x - y)‖ₑ :=
        enorm_integral_le_lintegral_enorm _
      _ = ∫⁻ y : Euclidean 2, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
        apply lintegral_congr
        intro y
        rw [enorm_mul]
  calc
    (∫⁻ x : Euclidean 2,
        ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ) ≤
        ∫⁻ x : Euclidean 2, ∫⁻ y : Euclidean 2, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
      apply lintegral_mono
      intro x
      exact hpoint x
    _ = (∫⁻ y : Euclidean 2, ‖K y‖ₑ) * ∫⁻ x : Euclidean 2, ‖f x‖ₑ :=
      scratch_lintegral_spatial_one_young (fun y => ‖K y‖ₑ) (fun x => ‖f x‖ₑ)
        hK.enorm hf.enorm

private theorem scratch_complex_spatial_convolution_top_young
    (K f : Euclidean 2 → Complex)
    (hK : Measurable K) :
    eLpNorm (K ⋆[ContinuousLinearMap.mul Complex Complex] f) ∞ volume ≤
      (∫⁻ y : Euclidean 2, ‖K y‖ₑ) * eLpNorm f ∞ volume := by
  rw [eLpNorm_exponent_top]
  let L : ENNReal := ∫⁻ y : Euclidean 2, ‖K y‖ₑ
  let C : ENNReal := eLpNorm f ∞ volume
  have hfess : ∀ᵐ z : Euclidean 2 ∂volume, ‖f z‖ₑ ≤ C := by
    simpa only [C, eLpNorm_exponent_top] using
      (enorm_ae_le_eLpNormEssSup f volume)
  apply eLpNormEssSup_le_of_ae_enorm_bound
  apply Eventually.of_forall
  intro x
  have hshift : ∀ᵐ y : Euclidean 2 ∂volume, ‖f (x - y)‖ₑ ≤ C := by
    exact (volume.measurePreserving_sub_left x).quasiMeasurePreserving.ae hfess
  change ‖∫ y : Euclidean 2, K y * f (x - y)‖ₑ ≤ L * C
  calc
    ‖∫ y : Euclidean 2, K y * f (x - y)‖ₑ ≤
        ∫⁻ y : Euclidean 2, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
      calc
        ‖∫ y : Euclidean 2, K y * f (x - y)‖ₑ ≤
            ∫⁻ y : Euclidean 2, ‖K y * f (x - y)‖ₑ :=
          enorm_integral_le_lintegral_enorm _
        _ = ∫⁻ y : Euclidean 2, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
          apply lintegral_congr
          intro y
          rw [enorm_mul]
    _ ≤ ∫⁻ y : Euclidean 2, ‖K y‖ₑ * C := by
      apply lintegral_mono_ae
      filter_upwards [hshift] with y hy
      gcongr
    _ = L * C := by
      exact lintegral_mul_const C hK.enorm

private theorem scratch_mixed_p_lift_of_slice_moment
    (p : Real) (hp : 0 < p)
    (G : WaveSpaceTime → Complex) (A : Real → ENNReal)
    (f : Euclidean 2 → Complex)
    (hG : AEMeasurable G volume)
    (hA : Measurable A)
    (hpoint : ∀ t : Real,
      ∫⁻ x : Euclidean 2, ‖G (x, t)‖ₑ ^ p ≤
        A t * ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ p) :
    eLpNorm G (ENNReal.ofReal p) volume ≤
      (∫⁻ t : Real, A t) ^ p⁻¹ * eLpNorm f (ENNReal.ofReal p) volume := by
  let F : WaveSpaceTime → ENNReal := fun z => ‖G z‖ₑ ^ p
  let J : ENNReal := ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ p
  have hF : AEMeasurable F volume := by
    exact hG.enorm.pow measurable_const.aemeasurable
  have hFprod : AEMeasurable F
      ((volume : Measure (Euclidean 2)).prod volume) := by
    rw [← Measure.volume_eq_prod (Euclidean 2) Real]
    exact hF
  have hFswap : AEMeasurable (fun z : Real × Euclidean 2 => F z.swap)
      (volume.prod volume) := by
    change AEMeasurable (F ∘ Prod.swap) (volume.prod volume)
    exact hFprod.comp_quasiMeasurePreserving
      ((Measure.measurePreserving_swap : MeasurePreserving Prod.swap
        (volume.prod volume) (volume.prod volume)).quasiMeasurePreserving)
  have hFubini :
      (∫⁻ z : WaveSpaceTime, F z) =
        ∫⁻ t : Real, ∫⁻ x : Euclidean 2, F (x, t) := by
    rw [Measure.volume_eq_prod (Euclidean 2) Real]
    calc
      (∫⁻ z : Euclidean 2 × Real, F z ∂volume.prod volume) =
          ∫⁻ z : Real × Euclidean 2, F z.swap ∂volume.prod volume :=
        (lintegral_prod_swap F).symm
      _ = ∫⁻ t : Real, ∫⁻ x : Euclidean 2, F (x, t) := by
        rw [lintegral_prod _ hFswap]
        rfl
  have hmoment :
      (∫⁻ z : WaveSpaceTime, F z) ≤ (∫⁻ t : Real, A t) * J := by
    calc
      (∫⁻ z : WaveSpaceTime, F z) =
          ∫⁻ t : Real, ∫⁻ x : Euclidean 2, F (x, t) := hFubini
      _ ≤ ∫⁻ t : Real, A t * J := by
        apply lintegral_mono
        intro t
        simpa only [F, J] using hpoint t
      _ = (∫⁻ t : Real, A t) * J := lintegral_mul_const J hA
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ENNReal.ofReal_ne_zero_iff.mpr hp) ENNReal.ofReal_ne_top]
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ENNReal.ofReal_ne_zero_iff.mpr hp) ENNReal.ofReal_ne_top]
  simp only [ENNReal.toReal_ofReal hp.le]
  have hroot : (∫⁻ z : WaveSpaceTime, F z) ^ p⁻¹ ≤
      (∫⁻ t : Real, A t) ^ p⁻¹ * J ^ p⁻¹ := by
    calc
      (∫⁻ z : WaveSpaceTime, F z) ^ p⁻¹ ≤
          ((∫⁻ t : Real, A t) * J) ^ p⁻¹ :=
        ENNReal.rpow_le_rpow hmoment (inv_nonneg.mpr hp.le)
      _ = (∫⁻ t : Real, A t) ^ p⁻¹ * J ^ p⁻¹ :=
        ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hp.le)
  convert hroot using 1 <;> simp only [F, J, one_div]

private theorem scratch_complex_spatial_convolution_one_moment
    (K f : Euclidean 2 → Complex)
    (hK : Measurable K) (hf : Measurable f) :
    ∫⁻ x : Euclidean 2,
        ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ≤
      (∫⁻ y : Euclidean 2, ‖K y‖ₑ) *
        ∫⁻ x : Euclidean 2, ‖f x‖ₑ := by
  simpa only [eLpNorm_one_eq_lintegral_enorm] using
    scratch_complex_spatial_convolution_one_young K f hK hf

private theorem scratch_mixed_spatial_convolution_one_young
    (K : WaveSpaceTime → Complex) (f : Euclidean 2 → Complex)
    (hK : Measurable K) (hf : Measurable f)
    (hG : AEMeasurable
      (fun z : WaveSpaceTime => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y)) volume) :
    eLpNorm (fun z : WaveSpaceTime => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y))
        (1 : ENNReal) volume ≤
      (∫⁻ t : Real, ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ) * eLpNorm f (1 : ENNReal) volume := by
  let G : WaveSpaceTime → Complex :=
    fun z => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y)
  let A : Real → ENNReal := fun t => ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ
  have hKswap : Measurable (fun z : Real × Euclidean 2 => ‖K z.swap‖ₑ) :=
    hK.enorm.comp measurable_swap
  have hA : Measurable A := by
    exact hKswap.lintegral_prod_right
  have hpoint : ∀ t : Real,
      ∫⁻ x : Euclidean 2, ‖G (x, t)‖ₑ ^ (1 : Real) ≤
        A t * ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ (1 : Real) := by
    intro t
    have hKt : Measurable (fun x : Euclidean 2 => K (x, t)) :=
      hK.comp (measurable_id.prodMk measurable_const)
    simpa only [G, A, convolution_def, ContinuousLinearMap.mul_apply', ENNReal.rpow_one] using
      scratch_complex_spatial_convolution_one_moment (fun x : Euclidean 2 => K (x, t)) f hKt hf
  simpa only [G, A, ENNReal.ofReal_one, inv_one, ENNReal.rpow_one] using
    scratch_mixed_p_lift_of_slice_moment 1 (by norm_num) G A f
      (by simpa only [G] using hG) hA hpoint

private theorem scratch_mixed_spatial_convolution_p_young
    (p : Real) (hp : 1 < p)
    (K : WaveSpaceTime → Complex) (f : Euclidean 2 → Complex)
    (hK : Measurable K) (hf : Measurable f)
    (hG : AEMeasurable
      (fun z : WaveSpaceTime => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y)) volume) :
    eLpNorm (fun z : WaveSpaceTime => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y))
        (ENNReal.ofReal p) volume ≤
      (∫⁻ t : Real, (∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ) ^ p) ^ p⁻¹ *
        eLpNorm f (ENNReal.ofReal p) volume := by
  let G : WaveSpaceTime → Complex :=
    fun z => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y)
  let A : Real → ENNReal := fun t =>
    (∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ) ^ p
  have hKswap : Measurable (fun z : Real × Euclidean 2 => ‖K z.swap‖ₑ) :=
    hK.enorm.comp measurable_swap
  have hA0 : Measurable (fun t : Real => ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ) := by
    exact hKswap.lintegral_prod_right
  have hA : Measurable A := by
    exact hA0.pow measurable_const
  have hpoint : ∀ t : Real,
      ∫⁻ x : Euclidean 2, ‖G (x, t)‖ₑ ^ p ≤
        A t * ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ p := by
    intro t
    have hKt : Measurable (fun x : Euclidean 2 => K (x, t)) :=
      hK.comp (measurable_id.prodMk measurable_const)
    simpa only [G, A, convolution_def, ContinuousLinearMap.mul_apply'] using
      scratch_complex_spatial_convolution_p_moment p hp
        (fun x : Euclidean 2 => K (x, t)) f hKt hf
  simpa only [G, A] using
    scratch_mixed_p_lift_of_slice_moment p (lt_trans zero_lt_one hp) G A f
      (by simpa only [G] using hG) hA hpoint

private theorem scratch_mixed_spatial_convolution_top_young
    (K : WaveSpaceTime → Complex) (f : Euclidean 2 → Complex)
    (hK : Measurable K) :
    eLpNorm (fun z : WaveSpaceTime => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y))
        ∞ volume ≤
      eLpNorm (fun t : Real => ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ) ∞ volume *
        eLpNorm f ∞ volume := by
  let G : WaveSpaceTime → Complex :=
    fun z => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y)
  let A : Real → ENNReal := fun t => ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ
  let B : ENNReal := eLpNorm A ∞ volume
  let C : ENNReal := eLpNorm f ∞ volume
  have hKswap : Measurable (fun z : Real × Euclidean 2 => ‖K z.swap‖ₑ) :=
    hK.enorm.comp measurable_swap
  have hA : Measurable A := by
    exact hKswap.lintegral_prod_right
  have hfess : ∀ᵐ y : Euclidean 2 ∂volume, ‖f y‖ₑ ≤ C := by
    simpa only [C, eLpNorm_exponent_top] using
      (enorm_ae_le_eLpNormEssSup f volume)
  have hAess : ∀ᵐ t : Real ∂volume, A t ≤ B := by
    simpa only [A, B, eLpNorm_exponent_top, enorm_eq_self] using
      (enorm_ae_le_eLpNormEssSup A volume)
  have hAprod : ∀ᵐ z : WaveSpaceTime ∂volume, A z.2 ≤ B := by
    rw [Measure.volume_eq_prod (Euclidean 2) Real]
    exact Measure.quasiMeasurePreserving_snd.ae hAess
  have hfixed (x : Euclidean 2) (t : Real) : ‖G (x, t)‖ₑ ≤ A t * C := by
    have hshift : ∀ᵐ y : Euclidean 2 ∂volume, ‖f (x - y)‖ₑ ≤ C := by
      exact (volume.measurePreserving_sub_left x).quasiMeasurePreserving.ae hfess
    change ‖∫ y : Euclidean 2, K (y, t) * f (x - y)‖ₑ ≤ A t * C
    calc
      ‖∫ y : Euclidean 2, K (y, t) * f (x - y)‖ₑ ≤
          ∫⁻ y : Euclidean 2, ‖K (y, t)‖ₑ * ‖f (x - y)‖ₑ := by
        calc
          ‖∫ y : Euclidean 2, K (y, t) * f (x - y)‖ₑ ≤
              ∫⁻ y : Euclidean 2, ‖K (y, t) * f (x - y)‖ₑ :=
            enorm_integral_le_lintegral_enorm _
          _ = ∫⁻ y : Euclidean 2, ‖K (y, t)‖ₑ * ‖f (x - y)‖ₑ := by
            apply lintegral_congr
            intro y
            rw [enorm_mul]
      _ ≤ ∫⁻ y : Euclidean 2, ‖K (y, t)‖ₑ * C := by
        apply lintegral_mono_ae
        filter_upwards [hshift] with y hy
        gcongr
      _ = A t * C := by
        exact lintegral_mul_const C
          ((hK.comp (measurable_id.prodMk measurable_const)).enorm)
  change eLpNorm G ∞ volume ≤ eLpNorm A ∞ volume * eLpNorm f ∞ volume
  rw [eLpNorm_exponent_top]
  change eLpNormEssSup G volume ≤ B * C
  apply eLpNormEssSup_le_of_ae_enorm_bound
  filter_upwards [hAprod] with z hz
  exact (hfixed z.1 z.2).trans (by gcongr)

private theorem scratch_mixed_spatial_convolution_young
    (p : ENNReal) (hp : 1 ≤ p)
    (K : WaveSpaceTime → Complex) (f : Euclidean 2 → Complex)
    (hK : Measurable K) (hf : Measurable f)
    (hG : AEMeasurable
      (fun z : WaveSpaceTime => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y)) volume) :
    eLpNorm (fun z : WaveSpaceTime => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y))
        p volume ≤
      eLpNorm (fun t : Real => ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ) p volume *
        eLpNorm f p volume := by
  let G : WaveSpaceTime → Complex :=
    fun z => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y)
  let A : Real → ENNReal := fun t => ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ
  change eLpNorm G p volume ≤ eLpNorm A p volume * eLpNorm f p volume
  by_cases htop : p = ∞
  · subst p
    simpa only [G, A] using scratch_mixed_spatial_convolution_top_young K f hK
  by_cases hone : p = 1
  · subst p
    simpa only [G, A, eLpNorm_one_eq_lintegral_enorm, enorm_eq_self] using
      scratch_mixed_spatial_convolution_one_young K f hK hf hG
  have hpone : 1 < p := lt_of_le_of_ne hp (Ne.symm hone)
  have hpreal : 1 < p.toReal := by
    simpa using ENNReal.toReal_strict_mono htop hpone
  have hpzero : p ≠ 0 := ne_of_gt (lt_of_lt_of_le zero_lt_one hp)
  have hpof : ENNReal.ofReal p.toReal = p := ENNReal.ofReal_toReal htop
  have hcoef :
      (∫⁻ t : Real, A t ^ p.toReal) ^ p.toReal⁻¹ = eLpNorm A p volume := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hpzero htop]
    simp only [enorm_eq_self, one_div]
  have hreal :
      eLpNorm G (ENNReal.ofReal p.toReal) volume ≤
        (∫⁻ t : Real, A t ^ p.toReal) ^ p.toReal⁻¹ *
          eLpNorm f (ENNReal.ofReal p.toReal) volume := by
    simpa only [G, A] using
      scratch_mixed_spatial_convolution_p_young p.toReal hpreal K f hK hf hG
  simpa only [hpof, hcoef] using hreal
private theorem scratch_mixed_spatial_convolution_young_of_continuous
    (p : ENNReal) (hp : 1 ≤ p)
    (K : WaveSpaceTime → Complex) (f : Euclidean 2 → Complex)
    (hK : Continuous K) (hf : Continuous f) :
    eLpNorm (fun z : WaveSpaceTime => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y))
        p volume ≤
      eLpNorm (fun t : Real => ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ) p volume *
        eLpNorm f p volume := by
  have hjoint : Continuous (fun zy : WaveSpaceTime × Euclidean 2 =>
      K (zy.2, zy.1.2) * f (zy.1.1 - zy.2)) :=
    (hK.comp (continuous_snd.prodMk continuous_fst.snd)).mul
      (hf.comp (continuous_fst.fst.sub continuous_snd))
  have hG : AEMeasurable
      (fun z : WaveSpaceTime => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y)) volume := by
    exact hjoint.stronglyMeasurable.integral_prod_right'.aemeasurable
  exact scratch_mixed_spatial_convolution_young p hp K f hK.measurable hf.measurable hG
/-- The literal iterated inverse transform of a joint Schwartz multiplier is
the raw representative of its canonical inverse Fourier transform. -/
private theorem spaceTimeFourierInv_jointSchwartzRaw_eq_jointSchwartzRaw_fourierInv
    (M : SchwartzMap JointWaveSpaceTime Complex) :
    spaceTimeFourierInv (jointSchwartzRaw M) =
      jointSchwartzRaw (𝓕⁻ M) := by
  funext z
  rw [spaceTimeFourierInv_jointSchwartzRaw]
  change FourierTransform.fourierInv (M : JointWaveSpaceTime → Complex)
      (WithLp.toLp 2 z) =
    (𝓕⁻ M : SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 z)
  exact (congrFun (SchwartzMap.fourierInv_coe M) (WithLp.toLp 2 z)).symm
/-- Internal closure of the radial--time localization predicate.  Every
constant is extracted from the supplied compact cutoff data, rather than
assumed as a kernel or seminorm hypothesis. -/
private theorem radialTimeLocalization_of_MSSRadialTimeCutoffs_aux
    (D : MSSRadialTimeCutoffs) : radialTimeLocalization D := by
  intro p N hp
  rcases exists_scale_pow_mul_weighted_sliceMass_mssRadialTimeResidualMultiplier_le
      D N with ⟨A, hA, hAbound⟩
  rcases scratch_eLpNorm_sliceMass_decay_all_p_of_real_bound_uniform
      p hp A N hA with ⟨C, hCpos, hCbound⟩
  refine ⟨C, hCpos, ?_⟩
  intro scale hscale_two f
  have hscale : 0 < scale := lt_of_lt_of_le (by norm_num) hscale_two
  let M : SchwartzMap JointWaveSpaceTime Complex :=
    mssRadialTimeResidualMultiplier D scale hscale
      (relevantRadialIndexEnumeration scale)
  let K : WaveSpaceTime → Complex :=
    spaceTimeFourierInv (jointSchwartzRaw M)
  have hKraw : K = jointSchwartzRaw (𝓕⁻ M) := by
    dsimp only [K]
    exact spaceTimeFourierInv_jointSchwartzRaw_eq_jointSchwartzRaw_fourierInv M
  have hKcont : Continuous K := by
    rw [hKraw]
    change Continuous (fun z : WaveSpaceTime =>
      (𝓕⁻ M : SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 z))
    exact (𝓕⁻ M).continuous.comp
      (WithLp.prod_continuous_toLp 2 (Euclidean 2) Real)
  have hKslice : ∀ t : Real,
      Integrable (fun x : Euclidean 2 => K (x, t)) volume := by
    intro t
    rw [hKraw]
    exact integrable_jointSchwartzRaw_slice (𝓕⁻ M) t
  have hweighted : ∀ t : Real,
      (1 + |t|) ^ 2 *
          (∫ x : Euclidean 2, ‖K (x, t)‖) ≤ A * (scale⁻¹) ^ N := by
    intro t
    rw [hKraw]
    simpa only [M] using hAbound scale hscale hscale_two t
  let S : Real → ENNReal := fun t => ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ
  have hS : ∀ t : Real,
      S t ≤ ENNReal.ofReal
        (A * (scale⁻¹) ^ N * ((1 + |t|)⁻¹) ^ (2 : Nat)) := by
    intro t
    dsimp only [S]
    have hslice := lintegral_enorm_slice_le_of_weighted_integral_norm_le
      (fun x t => K (x, t)) hKslice A scale N hweighted t
    rw [ENNReal.ofReal_mul (mul_nonneg hA
      (pow_nonneg (inv_nonneg.mpr hscale.le) _))]
    exact hslice
  have hSbound := hCbound scale hscale S hS
  have hYoung := scratch_mixed_spatial_convolution_young_of_continuous
    p hp K (f : Euclidean 2 → Complex) hKcont f.continuous
  have hres :
      radialTimeResidual (D.vertical : Real → Complex) (D.radial : Real → Complex)
          relevantRadialIndexEnumeration scale (D.amplitude : Euclidean 2 → Complex)
          (D.time : Real → Complex) (f : Euclidean 2 → Complex) =
        fun z : WaveSpaceTime => ∫ y : Euclidean 2,
          K (y, z.2) * f (z.1 - y) := by
    funext z
    exact radialTimeResidual_eq_spatialConvolution_factorized_of_indices
      D relevantRadialIndexEnumeration scale hscale f z.1 z.2
  rw [hres]
  calc
    eLpNorm (fun z : WaveSpaceTime => ∫ y : Euclidean 2,
        K (y, z.2) * f (z.1 - y)) p volume ≤
        eLpNorm S p volume * eLpNorm (f : Euclidean 2 → Complex) p volume := by
          simpa only [S] using hYoung
    _ ≤ ENNReal.ofReal (C * (scale⁻¹) ^ N) *
        eLpNorm (f : Euclidean 2 → Complex) p volume :=
      mul_le_mul_left hSbound _
end RadialTimeLocalizationAux

/-- The corrected compact radial--time cutoff data satisfy the blueprint's
all-exponent localization estimate. -/
theorem radialTimeLocalization_of_MSSRadialTimeCutoffs
    (D : MSSRadialTimeCutoffs) : radialTimeLocalization D :=
  RadialTimeLocalizationAux.radialTimeLocalization_of_MSSRadialTimeCutoffs_aux D

/-- The square function over a finite family of space--time functions. -/
noncomputable def verticalSquareFunction (indices : Finset Int)
    (H : Int → WaveSpaceTime → Complex) : WaveSpaceTime → Real :=
  fun z => Real.sqrt (∑ n ∈ indices, ‖H n z‖ ^ 2)

/-- The finite vertical square function is exactly the `ℓ²` norm of its
finite-indexed input bundle.  This is only a norm identification: it does not
provide a vector-valued operator bound for `verticalRecombined`, whose missing
common-kernel endpoint requires additional analytic hypotheses. -/
theorem verticalSquareFunction_eq_norm_piLp
    (indices : Finset Int) (H : Int → WaveSpaceTime → Complex)
    (z : WaveSpaceTime) :
    verticalSquareFunction indices H z =
      ‖(WithLp.toLp 2 (fun n : (↥indices) => H n z) :
        PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex))‖ := by
  rw [PiLp.norm_eq_of_L2]
  change verticalSquareFunction indices H z =
    Real.sqrt (∑ i : (↥indices), ‖H (i : Int) z‖ ^ (2 : Nat))
  rw [Finset.sum_coe_sort indices (fun i => ‖H i z‖ ^ (2 : Nat))]
  rfl

/-- The finite vertical square function is pointwise nonnegative. -/
theorem verticalSquareFunction_nonneg (indices : Finset Int)
    (H : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    0 ≤ verticalSquareFunction indices H z :=
  Real.sqrt_nonneg _

/-- The all-`p` norm form of `verticalSquareFunction_eq_norm_piLp`.  It is a
finite-dimensional input norm identity, not an `Lᵖ` estimate for vertical
recombination. -/
theorem eLpNorm_verticalSquareFunction_eq_eLpNorm_piLp
    (indices : Finset Int) (H : Int → WaveSpaceTime → Complex)
    (p : ENNReal) :
    eLpNorm (verticalSquareFunction indices H) p volume =
      eLpNorm
        (fun z : WaveSpaceTime =>
          (WithLp.toLp 2 (fun n : (↥indices) => H n z) :
            PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex)))
        p volume := by
  apply eLpNorm_congr_norm_ae
  filter_upwards with z
  rw [Real.norm_of_nonneg (verticalSquareFunction_nonneg indices H z),
    verticalSquareFunction_eq_norm_piLp]

private theorem aux_verticalSquareFunction_sub_le_sum_norm_tail
    (indices : Finset Int)
    (full main tail : Int → WaveSpaceTime → Complex)
    (hdecomp : ∀ i ∈ indices, ∀ z, full i z = main i z + tail i z)
    (z : WaveSpaceTime) :
    ‖verticalSquareFunction indices full z - verticalSquareFunction indices main z‖ ≤
      ∑ i ∈ indices, ‖tail i z‖ := by
  let F : PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex) :=
    WithLp.toLp 2 (fun i : (↥indices) => full (i : Int) z)
  let M : PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex) :=
    WithLp.toLp 2 (fun i : (↥indices) => main (i : Int) z)
  let T : PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex) :=
    WithLp.toLp 2 (fun i : (↥indices) => tail (i : Int) z)
  let e : (↥indices) → PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex) :=
    fun i => PiLp.single 2 i (tail (i : Int) z)
  have hFM : F = M + T := by
    dsimp [F, M, T]
    rw [← WithLp.toLp_add]
    congr 1
    funext i
    exact hdecomp i i.property z
  have hTsum : T = ∑ i : (↥indices), e i := by
    dsimp [T]
    rw [← WithLp.toLp_sum]
    congr 1
    ext i
    simp
  calc
    ‖verticalSquareFunction indices full z - verticalSquareFunction indices main z‖ =
        ‖‖F‖ - ‖M‖‖ := by
      rw [verticalSquareFunction_eq_norm_piLp, verticalSquareFunction_eq_norm_piLp]
    _ ≤ ‖F - M‖ := abs_norm_sub_norm_le _ _
    _ = ‖T‖ := by rw [hFM, add_sub_cancel_left]
    _ = ‖∑ i : (↥indices), e i‖ := by rw [hTsum]
    _ ≤ ∑ i : (↥indices), ‖e i‖ := by
      exact norm_sum_le (Finset.univ : Finset (↥indices)) e
    _ = ∑ i ∈ indices, ‖tail i z‖ := by
      simp only [e, PiLp.norm_single]
      exact Finset.sum_coe_sort indices (fun i => ‖tail i z‖)

/-- A finite square function is stable in `L⁴` under componentwise additive
tails.  This is only finite `ℓ²` stability and finite Minkowski; it makes no
recombination, continuum, square-function, or local-smoothing claim. -/
theorem eLpNorm_four_verticalSquareFunction_sub_le_sum_of_eq_add_of_tail_bounds
    (indices : Finset Int)
    (full main tail : Int → WaveSpaceTime → Complex)
    (hdecomp : ∀ i ∈ indices, ∀ z, full i z = main i z + tail i z)
    (htailMeas : ∀ i ∈ indices, AEStronglyMeasurable (tail i) volume)
    (E : Int → ENNReal)
    (hE : ∀ i ∈ indices, eLpNorm (tail i) 4 volume ≤ E i) :
    eLpNorm (verticalSquareFunction indices full - verticalSquareFunction indices main)
        4 volume ≤ ∑ i ∈ indices, E i := by
  let G : WaveSpaceTime → Real := fun z => ∑ i ∈ indices, ‖tail i z‖
  have hGnonneg (z : WaveSpaceTime) : 0 ≤ G z := by
    exact Finset.sum_nonneg fun i hi => norm_nonneg _
  have hmono (z : WaveSpaceTime) :
      ‖(verticalSquareFunction indices full - verticalSquareFunction indices main) z‖ ≤
        ‖G z‖ := by
    change |(verticalSquareFunction indices full - verticalSquareFunction indices main) z| ≤
      |G z|
    rw [abs_of_nonneg (hGnonneg z)]
    exact aux_verticalSquareFunction_sub_le_sum_norm_tail indices full main tail hdecomp z
  calc
    eLpNorm (verticalSquareFunction indices full - verticalSquareFunction indices main)
        4 volume ≤ eLpNorm G 4 volume := eLpNorm_mono hmono
    _ = eLpNorm (fun z => ∑ i ∈ indices, ‖tail i z‖) 4 volume := rfl
    _ = eLpNorm (∑ i ∈ indices, fun z => ‖tail i z‖) 4 volume := by
      congr 1
      funext z
      simp only [Finset.sum_apply]
    _ ≤ ∑ i ∈ indices, eLpNorm (fun z => ‖tail i z‖) 4 volume := by
      apply eLpNorm_sum_le
      · intro i hi
        exact (htailMeas i hi).norm
      · norm_num
    _ = ∑ i ∈ indices, eLpNorm (tail i) 4 volume := by
      apply Finset.sum_congr rfl
      intro i hi
      exact eLpNorm_norm (tail i)
    _ ≤ ∑ i ∈ indices, E i := by
      apply Finset.sum_le_sum
      intro i hi
      exact hE i hi

/-- Each summand is pointwise dominated by its finite vertical square
function. -/
theorem norm_le_verticalSquareFunction (indices : Finset Int)
    (H : Int → WaveSpaceTime → Complex) {n : Int} (hn : n ∈ indices)
    (z : WaveSpaceTime) :
    ‖H n z‖ ≤ verticalSquareFunction indices H z := by
  unfold verticalSquareFunction
  apply (Real.le_sqrt (norm_nonneg _) (by positivity)).2
  exact Finset.single_le_sum (fun m hm => sq_nonneg (‖H m z‖)) hn

/-- A finite sum costs at most the cardinality times its vertical square
function, without any projection boundedness hypothesis. -/
theorem norm_finset_sum_le_card_nsmul_verticalSquareFunction
    (indices : Finset Int) (H : Int → WaveSpaceTime → Complex)
    (z : WaveSpaceTime) :
    ‖∑ n ∈ indices, H n z‖ ≤ indices.card • verticalSquareFunction indices H z := by
  calc
    ‖∑ n ∈ indices, H n z‖ ≤ ∑ n ∈ indices, ‖H n z‖ := norm_sum_le _ _
    _ ≤ ∑ _n ∈ indices, verticalSquareFunction indices H z :=
      Finset.sum_le_sum fun n hn => norm_le_verticalSquareFunction indices H hn z
    _ = indices.card • verticalSquareFunction indices H z := by simp

/-- The finite vertical recombination operator appearing in the MSS proof. -/
noncomputable def verticalRecombined (verticalCutoff : Real → Complex)
    (scale : Real) (indices : Finset Int)
    (H : Int → WaveSpaceTime → Complex) : WaveSpaceTime → Complex :=
  fun z => ∑ n ∈ indices, verticalProjection verticalCutoff scale n (H n) z

/-- Exact finite packet form of literal vertical recombination.  It removes
the iterated three-dimensional Fourier notation term-by-term, leaving the
actual one-dimensional temporal multipliers which need to satisfy the
separate vector-valued endpoint estimate. -/
theorem verticalRecombined_verticalSeparablePackets
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → Real → Complex) (z : WaveSpaceTime) :
    verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n)) z =
      ∑ n ∈ indices,
        verticalTemporalProjection β scale n (g n) z.2 * F n z.1 := by
  classical
  unfold verticalRecombined
  apply Finset.sum_congr rfl
  intro n hn
  exact verticalProjection_verticalSeparablePacket β scale n (F n) (g n) z

/-- The literal Schwartz realization of one fixed temporal multiplier.  This
is an additive finite-Schwartz-core building block; it does not define a
projection on arbitrary measurable inputs. -/
noncomputable def verticalTemporalSchwartzMultiplier
    (m g : SchwartzMap Real Complex) : SchwartzMap Real Complex :=
  𝓕⁻ (SchwartzMap.smulLeftCLM Complex (m : Real → Complex) (𝓕 g))

theorem verticalTemporalSchwartzMultiplier_add
    (m g h : SchwartzMap Real Complex) :
    verticalTemporalSchwartzMultiplier m (g + h) =
      verticalTemporalSchwartzMultiplier m g + verticalTemporalSchwartzMultiplier m h := by
  unfold verticalTemporalSchwartzMultiplier
  rw [FourierTransform.fourier_add]
  rw [(SchwartzMap.smulLeftCLM Complex (m : Real → Complex)).map_add]
  rw [FourierTransform.fourierInv_add]

/-- The finite temporal Schwartz multiplier commutes with scalar multiplication.
This is an algebraic identity on supplied Schwartz data only. -/
theorem verticalTemporalSchwartzMultiplier_smul
    (m g : SchwartzMap Real Complex) (c : Complex) :
    verticalTemporalSchwartzMultiplier m (c • g) =
      c • verticalTemporalSchwartzMultiplier m g := by
  unfold verticalTemporalSchwartzMultiplier
  rw [FourierTransform.fourier_smul]
  rw [(SchwartzMap.smulLeftCLM Complex (m : Real → Complex)).map_smul]
  rw [FourierTransform.fourierInv_smul]

theorem verticalTemporalSchwartzMultiplier_zero
    (m : SchwartzMap Real Complex) :
    verticalTemporalSchwartzMultiplier m 0 = 0 := by
  unfold verticalTemporalSchwartzMultiplier
  rw [FourierTransform.fourier_zero]
  rw [(SchwartzMap.smulLeftCLM Complex (m : Real → Complex)).map_zero]
  rw [FourierTransform.fourierInv_zero]

/-- The finite-Schwartz temporal multiplier is literally convolution by its
inverse-Fourier kernel.  This is a core identity only; extending it to a
vector-valued measurable input space requires separate work. -/
theorem verticalTemporalSchwartzMultiplier_eq_convolution
    (m g : SchwartzMap Real Complex) (t : Real) :
    verticalTemporalSchwartzMultiplier m g t =
      (((𝓕⁻ m : SchwartzMap Real Complex) : Real → Complex)
        ⋆[ContinuousLinearMap.mul Complex Complex, volume] (g : Real → Complex)) t := by
  have h :
      (𝓕⁻ (SchwartzMap.smulLeftCLM Complex (m : Real → Complex) (𝓕 g)) :
        SchwartzMap Real Complex) =
      SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex) (𝓕⁻ m) g := by
    have hinv :
        (𝓕⁻ (𝓕 (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
          (𝓕⁻ m) g)) : SchwartzMap Real Complex) =
        SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex) (𝓕⁻ m) g := by
      exact fourierInv_fourier_eq _
    rw [← hinv]
    congr 1
    ext y
    simp [SchwartzMap.fourier_convolution, SchwartzMap.smulLeftCLM_apply_apply,
      m.hasTemperateGrowth]
  change (𝓕⁻ (SchwartzMap.smulLeftCLM Complex (m : Real → Complex) (𝓕 g)) :
      SchwartzMap Real Complex) t = _
  rw [h]
  exact SchwartzMap.convolution_apply (ContinuousLinearMap.mul Complex Complex) (𝓕⁻ m) g t

/-- The literal temporal Schwartz multiplier obeys the elementary `L∞`
bound supplied by the `L¹` norm of its inverse-Fourier kernel. -/
theorem norm_verticalTemporalSchwartzMultiplier_le
    (m g : SchwartzMap Real Complex) {C : Real}
    (hg : ∀ y, ‖g y‖ ≤ C) (t : Real) :
    ‖verticalTemporalSchwartzMultiplier m g t‖ ≤
      C * ∫ y : Real, ‖(𝓕⁻ m : SchwartzMap Real Complex) y‖ := by
  rw [verticalTemporalSchwartzMultiplier_eq_convolution]
  let k : Real → Complex := (𝓕⁻ m : SchwartzMap Real Complex)
  have hk : Integrable k volume := (𝓕⁻ m : SchwartzMap Real Complex).integrable
  have hshift : Continuous (fun y : Real => (g : Real → Complex) (t - y)) :=
    g.continuous.comp ((continuous_const : Continuous fun _ : Real => t).sub continuous_id)
  have hmajor : Integrable (fun y : Real => ‖k y‖ * C) volume :=
    hk.norm.mul_const C
  have hmeas : AEStronglyMeasurable
      (fun y : Real => k y * (g : Real → Complex) (t - y)) volume :=
    hk.aestronglyMeasurable.mul hshift.aestronglyMeasurable
  have hprod : Integrable (fun y : Real => k y * (g : Real → Complex) (t - y)) volume := by
    refine hmajor.mono' hmeas (Filter.Eventually.of_forall ?_)
    intro y
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (hg _) (norm_nonneg _)
  change ‖∫ y : Real, k y * (g : Real → Complex) (t - y)‖ ≤ _
  calc
    ‖∫ y : Real, k y * (g : Real → Complex) (t - y)‖ ≤
        ∫ y : Real, ‖k y * (g : Real → Complex) (t - y)‖ :=
      norm_integral_le_integral_norm _
    _ ≤ ∫ y : Real, ‖k y‖ * C := by
      apply integral_mono hprod.norm hmajor
      intro y
      change ‖k y * (g : Real → Complex) (t - y)‖ ≤ ‖k y‖ * C
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_left (hg _) (norm_nonneg _)
    _ = C * ∫ y : Real, ‖k y‖ := by
      rw [integral_mul_const]
      ring

/-- The literal finite vertical recombination operator on temporal Schwartz
tuples with fixed multiplier and spatial-profile families.  It is additive on
this finite Schwartz core only; no measurable, kernel, or density extension
is asserted here. -/
noncomputable def verticalSchwartzCoreRecombined
    (indices : Finset Int) (m : Int → SchwartzMap Real Complex)
    (F : Int → SchwartzMap (Euclidean 2) Complex) :
    (Int → SchwartzMap Real Complex) →+ (WaveSpaceTime → Complex) where
  toFun g := fun z => ∑ n ∈ indices,
    verticalTemporalSchwartzMultiplier (m n) (g n) z.2 * F n z.1
  map_zero' := by
    funext z
    simp [verticalTemporalSchwartzMultiplier_zero]
  map_add' := by
    intro g h
    funext z
    simp only [Pi.add_apply, verticalTemporalSchwartzMultiplier_add, add_apply, add_mul]
    rw [Finset.sum_add_distrib]

/-- On supplied Schwartz multiplier profiles, the additive core realizes the
literal finite `verticalRecombined` operator on separable Schwartz packets. -/
theorem verticalSchwartzCoreRecombined_eq_verticalRecombined_of_schwartzProfiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → SchwartzMap Real Complex) :
    verticalSchwartzCoreRecombined indices m F g =
      verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) := by
  funext z
  unfold verticalSchwartzCoreRecombined
  rw [verticalRecombined_verticalSeparablePackets]
  apply Finset.sum_congr rfl
  intro n hn
  unfold verticalTemporalSchwartzMultiplier
  rw [SchwartzMap.fourierInv_coe]
  unfold verticalTemporalProjection
  apply congrArg (fun q : Real → Complex => 𝓕⁻ q z.2 * F n z.1)
  funext τ
  simp only [SchwartzMap.smulLeftCLM_apply (m n).hasTemperateGrowth,
    smul_eq_mul, SchwartzMap.fourier_coe]
  rw [hprofile n hn τ]

/-- The temporal part of finite vertical recombination, as an additive map on
finite tuples of temporal Schwartz profiles.  It is deliberately only the
Schwartz core required for the finite overlap calculation. -/
noncomputable def verticalTemporalSchwartzCoreRecombined
    (indices : Finset Int) (m : Int → SchwartzMap Real Complex) :
    (Int → SchwartzMap Real Complex) →+ (Real → Complex) where
  toFun g := fun t => ∑ n ∈ indices,
    verticalTemporalSchwartzMultiplier (m n) (g n) t
  map_zero' := by
    funext t
    simp [verticalTemporalSchwartzMultiplier_zero]
  map_add' := by
    intro g h
    funext t
    simp only [Pi.add_apply, verticalTemporalSchwartzMultiplier_add, add_apply]
    rw [Finset.sum_add_distrib]

/-- At a fixed spatial point, the finite Schwartz space--time core is the
temporal core applied to the spatially scaled temporal profiles.  This is a
finite supplied-Schwartz fiber identity, not a statement about measurable
profiles or `verticalRecombined`. -/
theorem verticalSchwartzCoreRecombined_fiber
    (indices : Finset Int) (m : Int → SchwartzMap Real Complex)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → SchwartzMap Real Complex)
    (x : Euclidean 2) (t : Real) :
    verticalSchwartzCoreRecombined indices m F g (x, t) =
      verticalTemporalSchwartzCoreRecombined indices m
        (fun n => F n x • g n) t := by
  unfold verticalSchwartzCoreRecombined verticalTemporalSchwartzCoreRecombined
  apply Finset.sum_congr rfl
  intro n hn
  rw [verticalTemporalSchwartzMultiplier_smul]
  change verticalTemporalSchwartzMultiplier (m n) (g n) t * F n x =
    F n x * verticalTemporalSchwartzMultiplier (m n) (g n) t
  ring

/-- The temporal square function of a finite complex-valued profile family. -/
noncomputable def verticalTemporalSquareFunction
    (indices : Finset Int) (g : Int → Real → Complex) : Real → Real :=
  fun t => Real.sqrt (∑ n ∈ indices, ‖g n t‖ ^ (2 : Nat))

/-- The finite temporal square function is exactly the pointwise norm of its
natural `PiLp 2` profile bundle. -/
theorem verticalTemporalSquareFunction_eq_norm_piLp
    (indices : Finset Int) (g : Int → Real → Complex) (t : Real) :
    verticalTemporalSquareFunction indices g t =
      ‖(WithLp.toLp 2 (fun n : (↥indices) => g n t) :
        PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex))‖ := by
  rw [PiLp.norm_eq_of_L2]
  change verticalTemporalSquareFunction indices g t =
    Real.sqrt (∑ i : (↥indices), ‖g (i : Int) t‖ ^ (2 : Nat))
  rw [Finset.sum_coe_sort indices (fun i => ‖g i t‖ ^ (2 : Nat))]
  rfl

/-- The temporal square function and its finite `PiLp 2` bundle have equal
`eLpNorm` at every exponent. -/
theorem eLpNorm_verticalTemporalSquareFunction_eq_eLpNorm_piLp
    (indices : Finset Int) (g : Int → Real → Complex)
    (p : ENNReal) :
    eLpNorm (verticalTemporalSquareFunction indices g) p volume =
      eLpNorm
        (fun t : Real =>
          (WithLp.toLp 2 (fun n : (↥indices) => g n t) :
            PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex)))
        p volume := by
  apply eLpNorm_congr_norm_ae
  filter_upwards with t
  change ‖Real.sqrt (∑ n ∈ indices, ‖g n t‖ ^ (2 : Nat))‖ = _
  rw [Real.norm_of_nonneg (Real.sqrt_nonneg _)]
  simpa [verticalTemporalSquareFunction] using
    verticalTemporalSquareFunction_eq_norm_piLp indices g t

private theorem aux_norm_le_temporal_square
    (indices : Finset Int) (g : Int → SchwartzMap Real Complex)
    {n : Int} (hn : n ∈ indices) (t : Real) :
    ‖g n t‖ ≤ Real.sqrt (∑ m ∈ indices, ‖g m t‖ ^ (2 : Nat)) := by
  apply (Real.le_sqrt (norm_nonneg _) (by positivity)).2
  exact Finset.single_le_sum (fun m hm => sq_nonneg (‖g m t‖)) hn

private theorem aux_sqrt_sum_sq_kernel_le
    (indices : Finset Int) (K : Int → Real → Complex)
    (κ : Real → Real) (hκ : ∀ y, 0 ≤ κ y)
    (hK : ∀ n ∈ indices, ∀ y, ‖K n y‖ ≤ κ y) (y : Real) :
    Real.sqrt (∑ n ∈ indices, ‖K n y‖ ^ (2 : Nat)) ≤
      Real.sqrt (indices.card : Real) * κ y := by
  have hsum : (∑ n ∈ indices, ‖K n y‖ ^ (2 : Nat)) ≤
      (indices.card : Real) * (κ y) ^ (2 : Nat) := by
    calc
      (∑ n ∈ indices, ‖K n y‖ ^ (2 : Nat)) ≤
          ∑ n ∈ indices, (κ y) ^ (2 : Nat) := by
        apply Finset.sum_le_sum
        intro n hn
        exact pow_le_pow_left₀ (norm_nonneg _) (hK n hn y) 2
      _ = (indices.card : Real) * (κ y) ^ (2 : Nat) := by
        simp [nsmul_eq_mul]
  calc
    Real.sqrt (∑ n ∈ indices, ‖K n y‖ ^ (2 : Nat)) ≤
        Real.sqrt ((indices.card : Real) * (κ y) ^ (2 : Nat)) :=
      Real.sqrt_le_sqrt hsum
    _ = Real.sqrt (indices.card : Real) * Real.sqrt ((κ y) ^ (2 : Nat)) := by
      rw [Real.sqrt_mul (by positivity)]
    _ = Real.sqrt (indices.card : Real) * κ y := by
      rw [Real.sqrt_sq_eq_abs, abs_of_nonneg (hκ y)]

/-- A common pointwise inverse-Fourier kernel envelope gives the sharp finite
`sqrt(card)` top bound on the additive temporal Schwartz core.  This remains
a finite Schwartz result; it is not the measurable vector-valued extension
needed for the later interpolation step. -/
theorem norm_verticalTemporalSchwartzCoreRecombined_le_of_common_kernel
    (indices : Finset Int) (m g : Int → SchwartzMap Real Complex)
    (κ : Real → Real) (hκ : ∀ y, 0 ≤ κ y) (hκint : Integrable κ volume)
    (hkernel : ∀ n ∈ indices, ∀ y,
      ‖(𝓕⁻ (m n) : SchwartzMap Real Complex) y‖ ≤ κ y)
    {A : Real}
    (hinput : ∀ t, Real.sqrt (∑ n ∈ indices, ‖g n t‖ ^ (2 : Nat)) ≤ A)
    (t : Real) :
    ‖verticalTemporalSchwartzCoreRecombined indices m g t‖ ≤
      Real.sqrt (indices.card : Real) * (∫ y : Real, κ y) * A := by
  let K : Int → Real → Complex := fun n => (𝓕⁻ (m n) : SchwartzMap Real Complex)
  have hA : 0 ≤ A := le_trans (Real.sqrt_nonneg _) (hinput 0)
  have hg : ∀ n ∈ indices, ∀ u, ‖g n u‖ ≤ A := by
    intro n hn u
    exact (aux_norm_le_temporal_square indices g hn u).trans (hinput u)
  have hprod : ∀ n ∈ indices, Integrable
      (fun y : Real => K n y * g n (t - y)) volume := by
    intro n hn
    have hshift : Continuous (fun y : Real => (g n : Real → Complex) (t - y)) :=
      (g n).continuous.comp ((continuous_const : Continuous fun _ : Real => t).sub continuous_id)
    have hmajor : Integrable (fun y : Real => κ y * A) volume := by
      simpa [mul_comm] using hκint.mul_const A
    have hmeas : AEStronglyMeasurable
        (fun y : Real => K n y * g n (t - y)) volume :=
      (𝓕⁻ (m n) : SchwartzMap Real Complex).continuous.aestronglyMeasurable.mul
        hshift.aestronglyMeasurable
    refine hmajor.mono' hmeas (Filter.Eventually.of_forall ?_)
    intro y
    change ‖K n y * g n (t - y)‖ ≤ κ y * A
    rw [norm_mul]
    exact mul_le_mul (hkernel n hn y) (hg n hn (t - y)) (norm_nonneg _) (hκ y)
  have hsumint : Integrable
      (fun y : Real => ∑ n ∈ indices, K n y * g n (t - y)) volume := by
    exact integrable_finsetSum indices (fun n hn => hprod n hn)
  have henvelope : Integrable
      (fun y : Real => Real.sqrt (indices.card : Real) * κ y * A) volume := by
    have := hκint.const_mul (Real.sqrt (indices.card : Real) * A)
    simpa [mul_assoc, mul_left_comm, mul_comm] using this
  have hpoint (y : Real) :
      ‖∑ n ∈ indices, K n y * g n (t - y)‖ ≤
        Real.sqrt (indices.card : Real) * κ y * A := by
    calc
      ‖∑ n ∈ indices, K n y * g n (t - y)‖ ≤
          ∑ n ∈ indices, ‖K n y‖ * ‖g n (t - y)‖ := by
        calc
          ‖∑ n ∈ indices, K n y * g n (t - y)‖ ≤
              ∑ n ∈ indices, ‖K n y * g n (t - y)‖ := norm_sum_le _ _
          _ = ∑ n ∈ indices, ‖K n y‖ * ‖g n (t - y)‖ := by
            apply Finset.sum_congr rfl
            intro n hn
            rw [norm_mul]
      _ ≤ Real.sqrt (∑ n ∈ indices, ‖K n y‖ ^ (2 : Nat)) *
          Real.sqrt (∑ n ∈ indices, ‖g n (t - y)‖ ^ (2 : Nat)) :=
        Real.sum_mul_le_sqrt_mul_sqrt _ _ _
      _ ≤ (Real.sqrt (indices.card : Real) * κ y) * A := by
        exact mul_le_mul
          (aux_sqrt_sum_sq_kernel_le indices K κ hκ hkernel y)
          (hinput (t - y))
          (Real.sqrt_nonneg _)
          (mul_nonneg (Real.sqrt_nonneg _) (hκ y))
      _ = Real.sqrt (indices.card : Real) * κ y * A := by ring
  unfold verticalTemporalSchwartzCoreRecombined
  calc
    ‖∑ n ∈ indices, verticalTemporalSchwartzMultiplier (m n) (g n) t‖ =
        ‖∫ y : Real, ∑ n ∈ indices, K n y * g n (t - y)‖ := by
      congr 2
      rw [integral_finsetSum indices (fun n hn => hprod n hn)]
      apply Finset.sum_congr rfl
      intro n hn
      rw [verticalTemporalSchwartzMultiplier_eq_convolution]
      rfl
    _ ≤ ∫ y : Real, ‖∑ n ∈ indices, K n y * g n (t - y)‖ :=
      norm_integral_le_integral_norm _
    _ ≤ ∫ y : Real, Real.sqrt (indices.card : Real) * κ y * A :=
      integral_mono hsumint.norm henvelope hpoint
    _ = Real.sqrt (indices.card : Real) * (∫ y : Real, κ y) * A := by
      calc
        (∫ y : Real, Real.sqrt (indices.card : Real) * κ y * A) =
            ∫ y : Real, (Real.sqrt (indices.card : Real) * A) * κ y := by
          apply integral_congr_ae
          filter_upwards with y
          ring
        _ = (Real.sqrt (indices.card : Real) * A) * ∫ y : Real, κ y := by
          rw [integral_const_mul]
        _ = Real.sqrt (indices.card : Real) * (∫ y : Real, κ y) * A := by
          ring

/-- Supplied Schwartz profiles identify the temporal additive core with the
finite sum of literal vertical temporal projections. -/
theorem verticalTemporalSchwartzCoreRecombined_eq_sum_verticalTemporalProjection_of_schwartzProfiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (g : Int → SchwartzMap Real Complex) :
    verticalTemporalSchwartzCoreRecombined indices m g =
      fun t => ∑ n ∈ indices, verticalTemporalProjection β scale n (g n) t := by
  funext t
  unfold verticalTemporalSchwartzCoreRecombined
  apply Finset.sum_congr rfl
  intro n hn
  unfold verticalTemporalSchwartzMultiplier verticalTemporalProjection
  rw [SchwartzMap.fourierInv_coe]
  apply congrArg (fun q : Real → Complex => 𝓕⁻ q t)
  funext τ
  simp only [SchwartzMap.smulLeftCLM_apply (m n).hasTemperateGrowth,
    smul_eq_mul, SchwartzMap.fourier_coe]
  rw [hprofile n hn τ]

private theorem aux_sum_schwartzReal_apply {ι : Type*}
    (indices : Finset ι) (h : ι → SchwartzMap Real Complex) (t : Real) :
    (∑ n ∈ indices, h n) t = ∑ n ∈ indices, h n t := by
  change
    ((FunLike.coeAddMonoidHom (SchwartzMap Real Complex) Real Complex)
      (∑ n ∈ indices, h n)) t =
        ∑ n ∈ indices,
          ((FunLike.coeAddMonoidHom (SchwartzMap Real Complex) Real Complex) (h n)) t
  simpa only [Finset.sum_apply] using
    congrFun (map_sum
      (FunLike.coeAddMonoidHom (SchwartzMap Real Complex) Real Complex) h indices) t

private noncomputable def aux_verticalRecombinedTemporalProfile
    (indices : Finset Int) (m g : Int → SchwartzMap Real Complex) :
    SchwartzMap Real Complex :=
  ∑ n ∈ indices, 𝓕⁻ (aux_verticalTemporalMultiplierProfile (m n) (g n))

private theorem aux_verticalRecombinedTemporalProfile_fourier_apply
    (indices : Finset Int) (m g : Int → SchwartzMap Real Complex) (τ : Real) :
    𝓕 ((aux_verticalRecombinedTemporalProfile indices m g :
      SchwartzMap Real Complex) : Real → Complex) τ =
      ∑ n ∈ indices, aux_verticalTemporalMultiplierProfile (m n) (g n) τ := by
  have hsum :
      𝓕 (aux_verticalRecombinedTemporalProfile indices m g :
        SchwartzMap Real Complex) =
        ∑ n ∈ indices, aux_verticalTemporalMultiplierProfile (m n) (g n) := by
    unfold aux_verticalRecombinedTemporalProfile
    rw [FourierTransform.fourier_sum]
    apply Finset.sum_congr rfl
    intro n hn
    exact FourierTransform.fourier_fourierInv_eq _
  have hpoint := congrArg (fun q : SchwartzMap Real Complex => q τ) hsum
  calc
    𝓕 ((aux_verticalRecombinedTemporalProfile indices m g :
      SchwartzMap Real Complex) : Real → Complex) τ =
        (∑ n ∈ indices, aux_verticalTemporalMultiplierProfile (m n) (g n)) τ := by
      simpa only [SchwartzMap.fourier_coe] using hpoint
    _ = ∑ n ∈ indices, aux_verticalTemporalMultiplierProfile (m n) (g n) τ :=
      aux_sum_schwartzReal_apply indices
        (fun n => aux_verticalTemporalMultiplierProfile (m n) (g n)) τ

/-- For a finite vertical recombination of literal separable packets sharing
one spatial Schwartz factor, the space--time Fourier multiplier identity
holds after collecting the finite temporal sum into a Schwartz profile.  This
is a common-spatial-factor finite-tensor theorem; it does not cover the
general recombination with both spatial and temporal factors varying, nor a
physical-time-cutoff half-wave. -/
theorem spaceTimeFourier_verticalRecombined_verticalSeparablePackets_of_schwartzProfiles_common_spatial
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : SchwartzMap (Euclidean 2) Complex) (ξ : Euclidean 2) (τ : Real) :
    spaceTimeFourier
        (verticalRecombined β scale indices
          (fun n => verticalSeparablePacket F (g n : Real → Complex))) (ξ, τ) =
      ∑ n ∈ indices,
        verticalMultiplier β scale n (ξ, τ) *
          spaceTimeFourier (verticalSeparablePacket F (g n : Real → Complex)) (ξ, τ) := by
  have hphysical : verticalRecombined β scale indices
      (fun n => verticalSeparablePacket F (g n : Real → Complex)) =
      verticalSeparablePacket F
        ((aux_verticalRecombinedTemporalProfile indices m g :
          SchwartzMap Real Complex) : Real → Complex) := by
    funext z
    rw [verticalRecombined_verticalSeparablePackets]
    unfold verticalSeparablePacket
    unfold aux_verticalRecombinedTemporalProfile
    rw [aux_sum_schwartzReal_apply]
    rw [Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro n hn
    rw [aux_verticalTemporalProjection_eq_fourierInv_profile β scale n
      (m n) (g n) (hprofile n hn)]
  rw [hphysical, spaceTimeFourier_verticalSeparablePacket,
    aux_verticalRecombinedTemporalProfile_fourier_apply]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro n hn
  rw [aux_verticalTemporalMultiplierProfile_apply, hprofile n hn,
    spaceTimeFourier_verticalSeparablePacket, verticalMultiplier]
  ring

private theorem aux_spaceTimeFourier_finset_sum_verticalSeparablePackets
    (indices : Finset Int)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → SchwartzMap Real Complex)
    (ξ : Euclidean 2) (τ : Real) :
    spaceTimeFourier
        (fun z => ∑ n ∈ indices,
          verticalSeparablePacket (F n) (g n : Real → Complex) z) (ξ, τ) =
      ∑ n ∈ indices,
        spaceTimeFourier (verticalSeparablePacket (F n) (g n : Real → Complex)) (ξ, τ) := by
  have hspace (t : Real) :
      𝓕 (fun x : Euclidean 2 => ∑ n ∈ indices, g n t * F n x) ξ =
        ∑ n ∈ indices, g n t * 𝓕 (F n : Euclidean 2 → Complex) ξ := by
    let H : SchwartzMap (Euclidean 2) Complex :=
      ∑ n ∈ indices, (g n t) • F n
    have hH (x : Euclidean 2) : H x = ∑ n ∈ indices, g n t * F n x := by
      dsimp only [H]
      rw [sum_apply]
      simp only [smul_apply, smul_eq_mul]
    rw [show (fun x : Euclidean 2 => ∑ n ∈ indices, g n t * F n x) = H by
      funext x
      exact (hH x).symm]
    change (𝓕 H : SchwartzMap (Euclidean 2) Complex) ξ = _
    rw [show H = ∑ n ∈ indices, (g n t) • F n by rfl]
    rw [FourierTransform.fourier_sum, sum_apply]
    apply Finset.sum_congr rfl
    intro n hn
    rw [FourierTransform.fourier_smul]
    simp only [smul_apply, smul_eq_mul, SchwartzMap.fourier_coe]
  have hright :
      (∑ n ∈ indices,
        spaceTimeFourier (verticalSeparablePacket (F n) (g n : Real → Complex)) (ξ, τ)) =
        ∑ n ∈ indices,
          𝓕 (F n : Euclidean 2 → Complex) ξ * 𝓕 (g n : Real → Complex) τ := by
    apply Finset.sum_congr rfl
    intro n hn
    exact spaceTimeFourier_verticalSeparablePacket (F n) (g n : Real → Complex) ξ τ
  rw [hright]
  unfold spaceTimeFourier
  change 𝓕 (fun t : Real =>
    𝓕 (fun x : Euclidean 2 => ∑ n ∈ indices, g n t * F n x) ξ) τ = _
  rw [show (fun t : Real =>
    𝓕 (fun x : Euclidean 2 => ∑ n ∈ indices, g n t * F n x) ξ) =
      fun t : Real => ∑ n ∈ indices, g n t * 𝓕 (F n : Euclidean 2 → Complex) ξ by
        funext t
        exact hspace t]
  let K : SchwartzMap Real Complex :=
    ∑ n ∈ indices, (𝓕 (F n : Euclidean 2 → Complex) ξ) • g n
  have hK (t : Real) : K t =
      ∑ n ∈ indices, g n t * 𝓕 (F n : Euclidean 2 → Complex) ξ := by
    dsimp only [K]
    rw [sum_apply]
    simp only [smul_apply, smul_eq_mul]
    apply Finset.sum_congr rfl
    intro n hn
    ring
  rw [show (fun t : Real => ∑ n ∈ indices,
    g n t * 𝓕 (F n : Euclidean 2 → Complex) ξ) = K by
      funext t
      exact (hK t).symm]
  change (𝓕 K : SchwartzMap Real Complex) τ = _
  rw [show K = ∑ n ∈ indices,
    (𝓕 (F n : Euclidean 2 → Complex) ξ) • g n by rfl]
  rw [FourierTransform.fourier_sum, sum_apply]
  apply Finset.sum_congr rfl
  intro n hn
  rw [FourierTransform.fourier_smul]
  simp only [smul_apply, smul_eq_mul, SchwartzMap.fourier_coe]

/-- A finite vertical recombination of literal separable packets has the
expected space--time Fourier multiplier identity when every translated
temporal cutoff has a supplied Schwartz representative.  Unlike the
common-spatial-factor corollary, both the spatial and temporal factors may
vary with the radial index.  The proof uses only finite sums of actual
Schwartz maps at each Fourier stage; it does not assert an arbitrary-function
Fourier-additivity or cover physical-time-cutoff half-waves. -/
theorem spaceTimeFourier_verticalRecombined_verticalSeparablePackets_of_schwartzProfiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : Int → SchwartzMap (Euclidean 2) Complex) (ξ : Euclidean 2) (τ : Real) :
    spaceTimeFourier
        (verticalRecombined β scale indices
          (fun n => verticalSeparablePacket (F n) (g n : Real → Complex))) (ξ, τ) =
      ∑ n ∈ indices,
        verticalMultiplier β scale n (ξ, τ) *
          spaceTimeFourier (verticalSeparablePacket (F n) (g n : Real → Complex)) (ξ, τ) := by
  let h : Int → SchwartzMap Real Complex := fun n =>
    𝓕⁻ (aux_verticalTemporalMultiplierProfile (m n) (g n))
  have hpiece (n : Int) (hn : n ∈ indices) :
      verticalProjection β scale n
        (verticalSeparablePacket (F n) (g n : Real → Complex)) =
      verticalSeparablePacket (F n) (h n : Real → Complex) := by
    funext z
    rw [verticalProjection_verticalSeparablePacket]
    rw [aux_verticalTemporalProjection_eq_fourierInv_profile β scale n
      (m n) (g n) (hprofile n hn)]
    rfl
  have hphysical : verticalRecombined β scale indices
      (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) =
      fun z => ∑ n ∈ indices,
        verticalSeparablePacket (F n) (h n : Real → Complex) z := by
    funext z
    unfold verticalRecombined
    apply Finset.sum_congr rfl
    intro n hn
    rw [hpiece n hn]
  rw [hphysical, aux_spaceTimeFourier_finset_sum_verticalSeparablePackets]
  apply Finset.sum_congr rfl
  intro n hn
  rw [← hpiece n hn]
  exact spaceTimeFourier_verticalProjection_verticalSeparablePacket_of_schwartzProfile
    β scale n (m n) (g n) (hprofile n hn) (F n) ξ τ

/-- A literal finite `L²` recombination endpoint for the one-dimensional
vertical multipliers.  The supplied `m n` are actual Schwartz representatives
of the translated cutoff profiles, and their pointwise square-overlap is the
only Fourier-side estimate used here. -/
theorem integral_norm_sq_sum_verticalTemporalProjection_le_of_schwartz_profiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex) {C : Real}
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ) ≤ C) :
    (∫ t : Real, ‖∑ n ∈ indices,
      verticalTemporalProjection β scale n (g n) t‖ ^ (2 : ℕ)) ≤
      C * ∑ n ∈ indices, ∫ t : Real, ‖g n t‖ ^ (2 : ℕ) := by
  classical
  let h : Int → SchwartzMap Real Complex := fun n =>
    SchwartzMap.smulLeftCLM Complex (m n : Real → Complex) (𝓕 (g n))
  let hsum : SchwartzMap Real Complex := ∑ n ∈ indices, h n
  let out : SchwartzMap Real Complex := 𝓕⁻ hsum
  have hpiece (n : Int) (t : Real) :
      (𝓕⁻ (h n) : SchwartzMap Real Complex) t =
        𝓕⁻ (fun τ : Real => m n τ * 𝓕 (g n : Real → Complex) τ) t := by
    rw [SchwartzMap.fourierInv_coe]
    apply congrArg (fun q : Real → Complex => 𝓕⁻ q t)
    funext τ
    simp only [h, SchwartzMap.smulLeftCLM_apply (m n).hasTemperateGrowth,
      smul_eq_mul, SchwartzMap.fourier_coe]
  have hvertical (n : Int) (hn : n ∈ indices) (t : Real) :
      verticalTemporalProjection β scale n (g n) t =
        𝓕⁻ (fun τ : Real => m n τ * 𝓕 (g n : Real → Complex) τ) t := by
    unfold verticalTemporalProjection
    apply congrArg (fun q : Real → Complex => 𝓕⁻ q t)
    funext τ
    rw [hprofile n hn τ]
  have hactual (t : Real) :
      (∑ n ∈ indices, verticalTemporalProjection β scale n (g n) t) = out t := by
    symm
    calc
      out t = ∑ n ∈ indices, (𝓕⁻ (h n) : SchwartzMap Real Complex) t := by
        dsimp only [out, hsum]
        rw [FourierTransform.fourierInv_sum]
        simp
      _ = ∑ n ∈ indices,
          𝓕⁻ (fun τ : Real => m n τ * 𝓕 (g n : Real → Complex) τ) t := by
        apply Finset.sum_congr rfl
        intro n hn
        exact hpiece n t
      _ = ∑ n ∈ indices, verticalTemporalProjection β scale n (g n) t := by
        apply Finset.sum_congr rfl
        intro n hn
        exact (hvertical n hn t).symm
  have hsum_apply (τ : Real) :
      hsum τ = ∑ n ∈ indices, m n τ * 𝓕 (g n : Real → Complex) τ := by
    dsimp only [hsum]
    rw [sum_apply]
    apply Finset.sum_congr rfl
    intro n hn
    simp only [h, SchwartzMap.smulLeftCLM_apply (m n).hasTemperateGrowth,
      smul_eq_mul, SchwartzMap.fourier_coe]
  have hsum_integrable : Integrable (fun τ : Real => ‖hsum τ‖ ^ (2 : ℕ)) volume :=
    (memLp_two_iff_integrable_sq_norm hsum.continuous.aestronglyMeasurable).mp
      (hsum.memLp 2 volume)
  have hg_integrable (n : Int) :
      Integrable (fun τ : Real => ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ)) volume := by
    rw [← SchwartzMap.fourier_coe]
    exact (memLp_two_iff_integrable_sq_norm
      (𝓕 (g n)).continuous.aestronglyMeasurable).mp ((𝓕 (g n)).memLp 2 volume)
  have hright_integrable : Integrable (fun τ : Real =>
      C * ∑ n ∈ indices, ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ)) volume :=
    (integrable_finsetSum indices (fun n hn => hg_integrable n)).const_mul C
  have hpoint (τ : Real) :
      ‖∑ n ∈ indices, m n τ * 𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) ≤
        C * ∑ n ∈ indices, ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) := by
    have hnorm :
        ‖∑ n ∈ indices, m n τ * 𝓕 (g n : Real → Complex) τ‖ ≤
          Real.sqrt (∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ)) *
            Real.sqrt (∑ n ∈ indices, ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ)) := by
      calc
        ‖∑ n ∈ indices, m n τ * 𝓕 (g n : Real → Complex) τ‖ ≤
            ∑ n ∈ indices, ‖m n τ * 𝓕 (g n : Real → Complex) τ‖ := norm_sum_le _ _
        _ = ∑ n ∈ indices, ‖m n τ‖ * ‖𝓕 (g n : Real → Complex) τ‖ := by
          apply Finset.sum_congr rfl
          intro n hn
          rw [norm_mul]
        _ ≤ Real.sqrt (∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ)) *
            Real.sqrt (∑ n ∈ indices, ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ)) :=
          Real.sum_mul_le_sqrt_mul_sqrt _ _ _
    calc
      ‖∑ n ∈ indices, m n τ * 𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) ≤
          (Real.sqrt (∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ)) *
            Real.sqrt (∑ n ∈ indices, ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ))) ^ (2 : ℕ) :=
        (sq_le_sq₀ (norm_nonneg _) (mul_nonneg (Real.sqrt_nonneg _)
          (Real.sqrt_nonneg _))).mpr hnorm
      _ = (∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ)) *
          (∑ n ∈ indices, ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ)) := by
        rw [mul_pow, Real.sq_sqrt (Finset.sum_nonneg fun _ _ => sq_nonneg _),
          Real.sq_sqrt (Finset.sum_nonneg fun _ _ => sq_nonneg _)]
      _ ≤ C * ∑ n ∈ indices, ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) :=
        mul_le_mul_of_nonneg_right (hoverlap τ)
          (Finset.sum_nonneg fun _ _ => sq_nonneg _)
  calc
    (∫ t : Real, ‖∑ n ∈ indices,
        verticalTemporalProjection β scale n (g n) t‖ ^ (2 : ℕ)) =
        ∫ t : Real, ‖out t‖ ^ (2 : ℕ) := by
      apply integral_congr_ae
      filter_upwards with t
      rw [hactual t]
    _ = ∫ τ : Real, ‖𝓕 (out : Real → Complex) τ‖ ^ (2 : ℕ) :=
      (FourierRadius.integral_norm_sq_fourier_schwartz_eq out).symm
    _ = ∫ τ : Real, ‖hsum τ‖ ^ (2 : ℕ) := by
      apply integral_congr_ae
      filter_upwards with τ
      rw [← SchwartzMap.fourier_coe]
      change ‖(𝓕 out : SchwartzMap Real Complex) τ‖ ^ (2 : ℕ) = _
      rw [show 𝓕 out = hsum by
        dsimp only [out]
        exact FourierTransform.fourier_fourierInv_eq _]
    _ = ∫ τ : Real,
        ‖∑ n ∈ indices, m n τ * 𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) := by
      apply integral_congr_ae
      filter_upwards with τ
      rw [hsum_apply τ]
    _ ≤ ∫ τ : Real, C * ∑ n ∈ indices,
        ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) := by
      calc
        (∫ τ : Real,
            ‖∑ n ∈ indices, m n τ * 𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ)) =
            ∫ τ : Real, ‖hsum τ‖ ^ (2 : ℕ) := by
          apply integral_congr_ae
          filter_upwards with τ
          rw [hsum_apply τ]
        _ ≤ ∫ τ : Real, C * ∑ n ∈ indices,
            ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) :=
          integral_mono hsum_integrable hright_integrable (fun τ => by
            rw [hsum_apply τ]
            exact hpoint τ)
    _ = C * ∑ n ∈ indices, ∫ τ : Real,
        ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) := by
      rw [integral_const_mul, integral_finsetSum indices (fun n hn => hg_integrable n)]
    _ = C * ∑ n ∈ indices, ∫ t : Real, ‖g n t‖ ^ (2 : ℕ) := by
      congr 1
      apply Finset.sum_congr rfl
      intro n hn
      exact FourierRadius.integral_norm_sq_fourier_schwartz_eq (g n)

/-- The finite-overlap raw `L²` endpoint for the additive temporal Schwartz
core.  It is not an all-measurable vector-valued multiplier theorem. -/
theorem integral_norm_sq_verticalTemporalSchwartzCoreRecombined_le_of_schwartzProfiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    {C : Real}
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : Nat) ≤ C)
    (g : Int → SchwartzMap Real Complex) :
    (∫ t : Real,
      ‖verticalTemporalSchwartzCoreRecombined indices m g t‖ ^ (2 : Nat)) ≤
      C * ∑ n ∈ indices, ∫ t : Real, ‖g n t‖ ^ (2 : Nat) := by
  rw [verticalTemporalSchwartzCoreRecombined_eq_sum_verticalTemporalProjection_of_schwartzProfiles
    β scale indices m hprofile g]
  exact integral_norm_sq_sum_verticalTemporalProjection_le_of_schwartz_profiles
    β scale indices m g hprofile hoverlap

private theorem aux_verticalTemporalProjection_const_mul
    (β : Real → Complex) (scale : Real) (n : Int)
    (c : Complex) (g : Real → Complex) (t : Real) :
    verticalTemporalProjection β scale n (fun s => c * g s) t =
      c * verticalTemporalProjection β scale n g t := by
  unfold verticalTemporalProjection
  rw [show (fun τ : Real => β ((Real.sqrt scale)⁻¹ * τ - n) *
      𝓕 (fun s : Real => c * g s) τ) =
      fun τ : Real => β ((Real.sqrt scale)⁻¹ * τ - n) *
        (c * 𝓕 g τ) by
        funext τ
        rw [aux_fourier_const_mul_apply]]
  rw [show (fun τ : Real => β ((Real.sqrt scale)⁻¹ * τ - n) *
      (c * 𝓕 g τ)) =
      fun τ : Real => c *
        (β ((Real.sqrt scale)⁻¹ * τ - n) * 𝓕 g τ) by
        funext τ
        ring]
  exact aux_fourierInv_const_mul_apply c _ t

private noncomputable def aux_verticalTemporalOutputProfile
    (m g : SchwartzMap Real Complex) : SchwartzMap Real Complex :=
  𝓕⁻ (SchwartzMap.smulLeftCLM Complex (m : Real → Complex) (𝓕 g))

private theorem aux_verticalTemporalProjection_eq_outputProfile
    (β : Real → Complex) (scale : Real) (n : Int)
    (m g : SchwartzMap Real Complex)
    (hprofile : ∀ τ : Real, m τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (t : Real) :
    verticalTemporalProjection β scale n (g : Real → Complex) t =
      (aux_verticalTemporalOutputProfile m g : Real → Complex) t := by
  unfold verticalTemporalProjection aux_verticalTemporalOutputProfile
  rw [SchwartzMap.fourierInv_coe]
  apply congrArg (fun q : Real → Complex => 𝓕⁻ q t)
  funext τ
  simp only [SchwartzMap.smulLeftCLM_apply (m).hasTemperateGrowth,
    smul_eq_mul, SchwartzMap.fourier_coe]
  rw [hprofile τ]

private theorem aux_integrable_norm_sq_verticalRecombined_verticalSeparablePackets_of_profiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : Int → SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun z : WaveSpaceTime =>
      ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) volume := by
  classical
  let h : Int → SchwartzMap Real Complex := fun n =>
    aux_verticalTemporalOutputProfile (m n) (g n)
  have hvertical (n : Int) (hn : n ∈ indices) (t : Real) :
      verticalTemporalProjection β scale n (g n : Real → Complex) t = h n t := by
    exact aux_verticalTemporalProjection_eq_outputProfile β scale n (m n) (g n)
      (hprofile n hn) t
  have houtput (z : WaveSpaceTime) :
      verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z =
        ∑ n ∈ indices, h n z.2 * F n z.1 := by
    rw [verticalRecombined_verticalSeparablePackets]
    apply Finset.sum_congr rfl
    intro n hn
    rw [hvertical n hn z.2]
  have hF_integrable (n : Int) :
      Integrable (fun x : Euclidean 2 => ‖F n x‖ ^ (2 : ℕ)) volume :=
    (memLp_two_iff_integrable_sq_norm
      (F n).continuous.aestronglyMeasurable).mp ((F n).memLp 2 volume)
  have hh_integrable (n : Int) :
      Integrable (fun t : Real => ‖h n t‖ ^ (2 : ℕ)) volume :=
    (memLp_two_iff_integrable_sq_norm
      (h n).continuous.aestronglyMeasurable).mp ((h n).memLp 2 volume)
  have hterm_integrable (n : Int) :
      Integrable (fun z : WaveSpaceTime => ‖h n z.2 * F n z.1‖ ^ (2 : ℕ)) volume := by
    simpa only [Measure.volume_eq_prod, norm_mul, mul_pow, mul_comm] using
      (hF_integrable n).mul_prod (hh_integrable n)
  have hterm_memLp (n : Int) :
      MemLp (fun z : WaveSpaceTime => h n z.2 * F n z.1) 2 volume := by
    apply (memLp_two_iff_integrable_sq_norm
      (((h n).continuous.comp continuous_snd).mul
        ((F n).continuous.comp continuous_fst)).aestronglyMeasurable).mpr
    exact hterm_integrable n
  have hsum_memLp : MemLp (fun z : WaveSpaceTime =>
      ∑ n ∈ indices, h n z.2 * F n z.1) 2 volume :=
    memLp_finsetSum indices (fun n hn => hterm_memLp n)
  rw [show (fun z : WaveSpaceTime =>
      ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) =
      fun z : WaveSpaceTime => ‖∑ n ∈ indices, h n z.2 * F n z.1‖ ^ (2 : ℕ) by
        funext z
        rw [houtput z]]
  exact (memLp_two_iff_integrable_sq_norm hsum_memLp.1).mp hsum_memLp

private theorem aux_integral_norm_sq_verticalSeparablePacket_eq_product
    (F : SchwartzMap (Euclidean 2) Complex) (g : SchwartzMap Real Complex) :
    (∫ z : WaveSpaceTime,
      ‖verticalSeparablePacket F (g : Real → Complex) z‖ ^ (2 : ℕ)) =
      (∫ x : Euclidean 2, ‖F x‖ ^ (2 : ℕ)) *
        (∫ t : Real, ‖g t‖ ^ (2 : ℕ)) := by
  have hF_integrable : Integrable (fun x : Euclidean 2 => ‖F x‖ ^ (2 : ℕ)) volume :=
    (memLp_two_iff_integrable_sq_norm
      F.continuous.aestronglyMeasurable).mp (F.memLp 2 volume)
  have hg_integrable : Integrable (fun t : Real => ‖g t‖ ^ (2 : ℕ)) volume :=
    (memLp_two_iff_integrable_sq_norm
      g.continuous.aestronglyMeasurable).mp (g.memLp 2 volume)
  have hpacket_integrable : Integrable (fun z : WaveSpaceTime =>
      ‖verticalSeparablePacket F (g : Real → Complex) z‖ ^ (2 : ℕ)) volume := by
    simpa only [verticalSeparablePacket, Measure.volume_eq_prod, norm_mul, mul_pow, mul_comm] using
      hF_integrable.mul_prod hg_integrable
  calc
    (∫ z : WaveSpaceTime,
        ‖verticalSeparablePacket F (g : Real → Complex) z‖ ^ (2 : ℕ)) =
        ∫ x : Euclidean 2, ∫ t : Real,
          ‖verticalSeparablePacket F (g : Real → Complex) (x, t)‖ ^ (2 : ℕ) := by
      rw [Measure.volume_eq_prod]
      exact integral_prod _ (by
        simpa only [Measure.volume_eq_prod] using hpacket_integrable)
    _ = ∫ x : Euclidean 2,
        ‖F x‖ ^ (2 : ℕ) * ∫ t : Real, ‖g t‖ ^ (2 : ℕ) := by
      apply integral_congr_ae
      filter_upwards with x
      rw [show (fun t : Real =>
        ‖verticalSeparablePacket F (g : Real → Complex) (x, t)‖ ^ (2 : ℕ)) =
          fun t : Real => ‖F x‖ ^ (2 : ℕ) * ‖g t‖ ^ (2 : ℕ) by
            funext t
            simp only [verticalSeparablePacket, norm_mul, mul_pow, mul_comm]]
      rw [integral_const_mul]
    _ = (∫ x : Euclidean 2, ‖F x‖ ^ (2 : ℕ)) *
        (∫ t : Real, ‖g t‖ ^ (2 : ℕ)) := by
      rw [integral_mul_const]

private theorem aux_iterated_integral_norm_sq_verticalRecombined_verticalSeparablePackets_le
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex) {C : Real}
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ) ≤ C)
    (F : Int → SchwartzMap (Euclidean 2) Complex) :
    (∫ x : Euclidean 2, ∫ t : Real,
      ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) (x, t)‖ ^ (2 : ℕ)) ≤
      C * ∑ n ∈ indices,
        (∫ x : Euclidean 2, ‖F n x‖ ^ (2 : ℕ)) *
          (∫ t : Real, ‖g n t‖ ^ (2 : ℕ)) := by
  classical
  let h : Int → SchwartzMap Real Complex := fun n =>
    aux_verticalTemporalOutputProfile (m n) (g n)
  have hvertical (n : Int) (hn : n ∈ indices) (t : Real) :
      verticalTemporalProjection β scale n (g n : Real → Complex) t = h n t := by
    exact aux_verticalTemporalProjection_eq_outputProfile β scale n (m n) (g n)
      (hprofile n hn) t
  have houtput (z : WaveSpaceTime) :
      verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z =
        ∑ n ∈ indices, h n z.2 * F n z.1 := by
    rw [verticalRecombined_verticalSeparablePackets]
    apply Finset.sum_congr rfl
    intro n hn
    rw [hvertical n hn z.2]
  have hscaled (x : Euclidean 2) (n : Int) :
      (∫ t : Real, ‖((F n x) • g n : SchwartzMap Real Complex) t‖ ^ (2 : ℕ)) =
        ‖F n x‖ ^ (2 : ℕ) * ∫ t : Real, ‖g n t‖ ^ (2 : ℕ) := by
    rw [show (fun t : Real => ‖((F n x) • g n : SchwartzMap Real Complex) t‖ ^ (2 : ℕ)) =
        fun t : Real => ‖F n x‖ ^ (2 : ℕ) * ‖g n t‖ ^ (2 : ℕ) by
          funext t
          simp only [smul_apply, smul_eq_mul, norm_mul, mul_pow]]
    rw [integral_const_mul]
  have hslice (x : Euclidean 2) :
      (∫ t : Real,
        ‖verticalRecombined β scale indices
          (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) (x, t)‖ ^ (2 : ℕ)) ≤
        C * ∑ n ∈ indices,
          ‖F n x‖ ^ (2 : ℕ) * ∫ t : Real, ‖g n t‖ ^ (2 : ℕ) := by
    have htemporal :=
      integral_norm_sq_sum_verticalTemporalProjection_le_of_schwartz_profiles
        β scale indices m (fun n => (F n x) • g n) hprofile hoverlap
    calc
      (∫ t : Real,
          ‖verticalRecombined β scale indices
            (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) (x, t)‖ ^
              (2 : ℕ)) =
          ∫ t : Real, ‖∑ n ∈ indices,
            verticalTemporalProjection β scale n
              (((F n x) • g n : SchwartzMap Real Complex) : Real → Complex) t‖ ^
              (2 : ℕ) := by
            apply integral_congr_ae
            filter_upwards with t
            rw [verticalRecombined_verticalSeparablePackets]
            apply congrArg (fun w : Complex => ‖w‖ ^ (2 : ℕ))
            apply Finset.sum_congr rfl
            intro n hn
            change verticalTemporalProjection β scale n (g n : Real → Complex) t * F n x =
              verticalTemporalProjection β scale n
                (fun s : Real => F n x * g n s) t
            rw [aux_verticalTemporalProjection_const_mul]
            ring
      _ ≤ C * ∑ n ∈ indices, ∫ t : Real,
          ‖((F n x) • g n : SchwartzMap Real Complex) t‖ ^ (2 : ℕ) := htemporal
      _ = C * ∑ n ∈ indices,
          ‖F n x‖ ^ (2 : ℕ) * ∫ t : Real, ‖g n t‖ ^ (2 : ℕ) := by
        congr 1
        apply Finset.sum_congr rfl
        intro n hn
        exact hscaled x n
  have hF_integrable (n : Int) :
      Integrable (fun x : Euclidean 2 => ‖F n x‖ ^ (2 : ℕ)) volume :=
    (memLp_two_iff_integrable_sq_norm
      (F n).continuous.aestronglyMeasurable).mp ((F n).memLp 2 volume)
  have hright_integrable : Integrable (fun x : Euclidean 2 =>
      C * ∑ n ∈ indices, ‖F n x‖ ^ (2 : ℕ) *
        ∫ t : Real, ‖g n t‖ ^ (2 : ℕ)) volume := by
    apply (integrable_finsetSum indices (fun n hn =>
      (hF_integrable n).mul_const (∫ t : Real, ‖g n t‖ ^ (2 : ℕ)))).const_mul C
  have houtput_cont : Continuous (fun z : WaveSpaceTime =>
      ∑ n ∈ indices, h n z.2 * F n z.1) := by
    apply continuous_finsetSum
    intro n hn
    exact ((h n).continuous.comp continuous_snd).mul
      ((F n).continuous.comp continuous_fst)
  have hsq_cont : Continuous (fun z : WaveSpaceTime =>
      ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) := by
    rw [show (fun z : WaveSpaceTime =>
      ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) =
      fun z : WaveSpaceTime => ‖∑ n ∈ indices, h n z.2 * F n z.1‖ ^ (2 : ℕ) by
        funext z
        rw [houtput z]]
    exact houtput_cont.norm.pow _
  have hslice_meas : AEStronglyMeasurable (fun x : Euclidean 2 =>
      ∫ t : Real, ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) (x, t)‖ ^ (2 : ℕ)) volume :=
    hsq_cont.stronglyMeasurable.integral_prod_right'.aestronglyMeasurable
  have hleft_integrable : Integrable (fun x : Euclidean 2 =>
      ∫ t : Real, ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) (x, t)‖ ^ (2 : ℕ)) volume := by
    refine hright_integrable.mono' hslice_meas ?_
    filter_upwards with x
    rw [Real.norm_eq_abs, abs_of_nonneg]
    · exact hslice x
    · exact integral_nonneg fun t => sq_nonneg _
  calc
    (∫ x : Euclidean 2, ∫ t : Real,
        ‖verticalRecombined β scale indices
          (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) (x, t)‖ ^
            (2 : ℕ)) ≤
        ∫ x : Euclidean 2, C * ∑ n ∈ indices,
          ‖F n x‖ ^ (2 : ℕ) * ∫ t : Real, ‖g n t‖ ^ (2 : ℕ) :=
      integral_mono hleft_integrable hright_integrable hslice
    _ = C * ∑ n ∈ indices,
        (∫ x : Euclidean 2, ‖F n x‖ ^ (2 : ℕ)) *
          (∫ t : Real, ‖g n t‖ ^ (2 : ℕ)) := by
      rw [integral_const_mul, integral_finsetSum]
      · congr 1
        apply Finset.sum_congr rfl
        intro n hn
        rw [integral_mul_const]
      · intro n hn
        exact (hF_integrable n).mul_const _

/-- A literal finite space--time `L²` endpoint for the varying-spatial
separable family from the mixed vertical Fourier identity.  The proof uses
the same exact physical tensor representation, so it does not assert a
continuum `verticalRecombination` estimate. -/
theorem integral_norm_sq_verticalRecombined_verticalSeparablePackets_le_of_schwartz_profiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex) {C : Real}
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ) ≤ C)
    (F : Int → SchwartzMap (Euclidean 2) Complex) :
    (∫ z : WaveSpaceTime,
      ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) ≤
      C * ∑ n ∈ indices,
        (∫ x : Euclidean 2, ‖F n x‖ ^ (2 : ℕ)) *
          (∫ t : Real, ‖g n t‖ ^ (2 : ℕ)) := by
  have hintegrable :=
    aux_integrable_norm_sq_verticalRecombined_verticalSeparablePackets_of_profiles
      β scale indices m g hprofile F
  have hiterated :=
    aux_iterated_integral_norm_sq_verticalRecombined_verticalSeparablePackets_le
      β scale indices m g hprofile hoverlap F
  calc
    (∫ z : WaveSpaceTime,
        ‖verticalRecombined β scale indices
          (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) =
        ∫ x : Euclidean 2, ∫ t : Real,
          ‖verticalRecombined β scale indices
            (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) (x, t)‖ ^
              (2 : ℕ) := by
      rw [Measure.volume_eq_prod]
      exact integral_prod _ (by
        simpa only [Measure.volume_eq_prod] using hintegrable)
    _ ≤ C * ∑ n ∈ indices,
        (∫ x : Euclidean 2, ‖F n x‖ ^ (2 : ℕ)) *
          (∫ t : Real, ‖g n t‖ ^ (2 : ℕ)) := hiterated

/-- Input-energy form of the literal finite tensor `L²` endpoint. -/
theorem integral_norm_sq_verticalRecombined_verticalSeparablePackets_le_sum_inputEnergy_of_schwartz_profiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex) {C : Real}
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ) ≤ C)
    (F : Int → SchwartzMap (Euclidean 2) Complex) :
    (∫ z : WaveSpaceTime,
      ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) ≤
      C * ∑ n ∈ indices, ∫ z : WaveSpaceTime,
        ‖verticalSeparablePacket (F n) (g n : Real → Complex) z‖ ^ (2 : ℕ) := by
  calc
    (∫ z : WaveSpaceTime,
        ‖verticalRecombined β scale indices
          (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) ≤
        C * ∑ n ∈ indices,
          (∫ x : Euclidean 2, ‖F n x‖ ^ (2 : ℕ)) *
            (∫ t : Real, ‖g n t‖ ^ (2 : ℕ)) :=
      integral_norm_sq_verticalRecombined_verticalSeparablePackets_le_of_schwartz_profiles
        β scale indices m g hprofile hoverlap F
    _ = C * ∑ n ∈ indices, ∫ z : WaveSpaceTime,
        ‖verticalSeparablePacket (F n) (g n : Real → Complex) z‖ ^ (2 : ℕ) := by
      congr 1
      apply Finset.sum_congr rfl
      intro n hn
      exact (aux_integral_norm_sq_verticalSeparablePacket_eq_product (F n) (g n)).symm

/-- The finite-overlap raw `L²` endpoint for the additive Schwartz
space--time core.  This is a finite Schwartz theorem only; it does not
provide an `L²` extension to arbitrary functions. -/
theorem integral_norm_sq_verticalSchwartzCoreRecombined_le_of_schwartzProfiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    {C : Real}
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : Nat) ≤ C)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → SchwartzMap Real Complex) :
    (∫ z : WaveSpaceTime,
      ‖verticalSchwartzCoreRecombined indices m F g z‖ ^ (2 : Nat)) ≤
      C * ∑ n ∈ indices, ∫ z : WaveSpaceTime,
        ‖verticalSeparablePacket (F n) (g n : Real → Complex) z‖ ^ (2 : Nat) := by
  rw [verticalSchwartzCoreRecombined_eq_verticalRecombined_of_schwartzProfiles
    β scale indices m hprofile F g]
  exact integral_norm_sq_verticalRecombined_verticalSeparablePackets_le_sum_inputEnergy_of_schwartz_profiles
    β scale indices m g hprofile hoverlap F

/-- Pointwise Cauchy--Schwarz for a finite literal separable vertical
recombination.  This is the common physical-space core of the `L²` and
`L∞` finite packet endpoints below. -/
private theorem aux_norm_verticalRecombined_verticalSeparablePackets_le_temporal_spatial
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → Real → Complex)
    (z : WaveSpaceTime) :
    ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n)) z‖ ≤
      Real.sqrt (∑ n ∈ indices,
        ‖verticalTemporalProjection β scale n (g n) z.2‖ ^ (2 : Nat)) *
        Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) := by
  rw [verticalRecombined_verticalSeparablePackets]
  calc
    ‖∑ n ∈ indices,
        verticalTemporalProjection β scale n (g n) z.2 * F n z.1‖ ≤
        ∑ n ∈ indices,
          ‖verticalTemporalProjection β scale n (g n) z.2 * F n z.1‖ :=
      norm_sum_le _ _
    _ = ∑ n ∈ indices,
        ‖verticalTemporalProjection β scale n (g n) z.2‖ * ‖F n z.1‖ := by
      apply Finset.sum_congr rfl
      intro n hn
      rw [norm_mul]
    _ ≤ Real.sqrt (∑ n ∈ indices,
        ‖verticalTemporalProjection β scale n (g n) z.2‖ ^ (2 : Nat)) *
        Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) :=
      Real.sum_mul_le_sqrt_mul_sqrt indices
        (fun n => ‖verticalTemporalProjection β scale n (g n) z.2‖)
        (fun n => ‖F n z.1‖)

/-- Finite separable-packet endpoint from an explicit pointwise square bound
for the actual one-dimensional vertical outputs.  It is deliberately a
literal finite statement, so a later kernel estimate can be paired with the
already proved Fourier-overlap `L²` endpoint for real interpolation. -/
theorem norm_verticalRecombined_verticalSeparablePackets_le_of_temporal_square_bound
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → Real → Complex) {B : Real}
    (hB : 0 ≤ B)
    (htemporal : ∀ t : Real, ∑ n ∈ indices,
      ‖verticalTemporalProjection β scale n (g n) t‖ ^ (2 : Nat) ≤ B ^ (2 : Nat))
    (z : WaveSpaceTime) :
    ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n)) z‖ ≤
      B * Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) := by
  have hsqrt : Real.sqrt (∑ n ∈ indices,
      ‖verticalTemporalProjection β scale n (g n) z.2‖ ^ (2 : Nat)) ≤ B :=
    (Real.sqrt_le_left hB).mpr (htemporal z.2)
  calc
    ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n)) z‖ ≤
      Real.sqrt (∑ n ∈ indices,
        ‖verticalTemporalProjection β scale n (g n) z.2‖ ^ (2 : Nat)) *
        Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) :=
      aux_norm_verticalRecombined_verticalSeparablePackets_le_temporal_spatial
        β scale indices F g z
    _ ≤ B * Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) :=
      mul_le_mul_of_nonneg_right hsqrt (Real.sqrt_nonneg _)

/-- A finite common-time-kernel endpoint for literal separable vertical
packets.  The supplied `m n` are actual Schwartz representatives of the
translated multiplier profiles.  The hypothesis `hkernel` is a literal
inverse-Fourier time-kernel envelope with one common nonnegative function
`κ`, and explicit finite coefficients `a n`; no continuum vertical
recombination or half-wave packet is asserted here. -/
theorem norm_verticalRecombined_verticalSeparablePackets_le_of_schwartz_profiles_of_common_time_kernel
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (κ : Real → Real) (a : Int → Real)
    (hκ : ∀ t : Real, 0 ≤ κ t)
    (hkernel : ∀ n ∈ indices, ∀ t : Real,
      ‖𝓕⁻ (fun τ : Real => m n τ * 𝓕 (g n : Real → Complex) τ) t‖ ≤
        κ t * a n)
    (z : WaveSpaceTime) :
    ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ≤
      κ z.2 * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) *
        Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) := by
  have hprojection (n : Int) (hn : n ∈ indices) (t : Real) :
      verticalTemporalProjection β scale n (g n : Real → Complex) t =
        𝓕⁻ (fun τ : Real => m n τ * 𝓕 (g n : Real → Complex) τ) t := by
    unfold verticalTemporalProjection
    apply congrArg (fun q : Real → Complex => 𝓕⁻ q t)
    funext τ
    rw [← hprofile n hn τ]
  rw [verticalRecombined_verticalSeparablePackets]
  calc
    ‖∑ n ∈ indices,
        verticalTemporalProjection β scale n (g n : Real → Complex) z.2 * F n z.1‖ ≤
        ∑ n ∈ indices,
          ‖verticalTemporalProjection β scale n (g n : Real → Complex) z.2 * F n z.1‖ :=
      norm_sum_le _ _
    _ = ∑ n ∈ indices,
        ‖verticalTemporalProjection β scale n (g n : Real → Complex) z.2‖ * ‖F n z.1‖ := by
      apply Finset.sum_congr rfl
      intro n hn
      rw [norm_mul]
    _ ≤ ∑ n ∈ indices, (κ z.2 * a n) * ‖F n z.1‖ := by
      apply Finset.sum_le_sum
      intro n hn
      exact mul_le_mul_of_nonneg_right (by
        rw [hprojection n hn z.2]
        exact hkernel n hn z.2) (norm_nonneg _)
    _ = κ z.2 * ∑ n ∈ indices, a n * ‖F n z.1‖ := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro n hn
      ring
    _ ≤ κ z.2 *
        (Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) *
          Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat))) := by
      exact mul_le_mul_of_nonneg_left
        (Real.sum_mul_le_sqrt_mul_sqrt indices a (fun n => ‖F n z.1‖))
        (hκ z.2)
    _ = κ z.2 * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) *
        Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) := by ring

/-- Uniform spatial and time envelopes turn the previous finite
common-time-kernel theorem into its literal pointwise `L∞` form. -/
theorem norm_verticalRecombined_verticalSeparablePackets_le_of_schwartz_profiles_of_common_time_kernel_and_spatial_envelope
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (κ : Real → Real) (a : Int → Real) {A B : Real}
    (hA : 0 ≤ A) (hκ : ∀ t : Real, 0 ≤ κ t)
    (hκbound : ∀ t : Real, κ t ≤ B)
    (hkernel : ∀ n ∈ indices, ∀ t : Real,
      ‖𝓕⁻ (fun τ : Real => m n τ * 𝓕 (g n : Real → Complex) τ) t‖ ≤
        κ t * a n)
    (hspatial : ∀ x : Euclidean 2, ∑ n ∈ indices,
      ‖F n x‖ ^ (2 : Nat) ≤ A ^ (2 : Nat))
    (z : WaveSpaceTime) :
    ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ≤
      B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) * A := by
  have hspatial_sqrt : Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) ≤ A :=
    (Real.sqrt_le_left hA).mpr (hspatial z.1)
  have hcoeff_nonneg : 0 ≤ Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) :=
    Real.sqrt_nonneg _
  have htemporal : κ z.2 * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) ≤
      B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) :=
    mul_le_mul_of_nonneg_right (hκbound z.2) hcoeff_nonneg
  calc
    ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ≤
      (κ z.2 * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat))) *
        Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) := by
      exact norm_verticalRecombined_verticalSeparablePackets_le_of_schwartz_profiles_of_common_time_kernel
        β scale indices m g hprofile F κ a hκ hkernel z
    _ ≤ (B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat))) *
        Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) :=
      mul_le_mul_of_nonneg_right htemporal (Real.sqrt_nonneg _)
    _ ≤ (B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat))) * A := by
      have hleft_nonneg : 0 ≤ B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) := by
        have : 0 ≤ B := le_trans (hκ z.2) (hκbound z.2)
        positivity
      exact mul_le_mul_of_nonneg_left hspatial_sqrt hleft_nonneg
    _ = B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) * A := by ring

/-- The Schwartz-profile hypotheses make the literal finite vertical output
measurable.  This is kept separate from the `L²` estimate so the following
interpolation theorem applies to the actual `verticalRecombined` function,
rather than to a packaged endpoint proposition. -/
private theorem aux_aestronglyMeasurable_verticalRecombined_verticalSeparablePackets_of_profiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : Int → SchwartzMap (Euclidean 2) Complex) :
    AEStronglyMeasurable
      (verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex))) volume := by
  classical
  let h : Int → SchwartzMap Real Complex := fun n =>
    aux_verticalTemporalOutputProfile (m n) (g n)
  have hvertical (n : Int) (hn : n ∈ indices) (t : Real) :
      verticalTemporalProjection β scale n (g n : Real → Complex) t = h n t := by
    exact aux_verticalTemporalProjection_eq_outputProfile β scale n (m n) (g n)
      (hprofile n hn) t
  have houtput (z : WaveSpaceTime) :
      verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z =
        ∑ n ∈ indices, h n z.2 * F n z.1 := by
    rw [verticalRecombined_verticalSeparablePackets]
    apply Finset.sum_congr rfl
    intro n hn
    rw [hvertical n hn z.2]
  have hcont : Continuous (fun z : WaveSpaceTime =>
      ∑ n ∈ indices, h n z.2 * F n z.1) := by
    apply continuous_finsetSum
    intro n hn
    exact ((h n).continuous.comp continuous_snd).mul
      ((F n).continuous.comp continuous_fst)
  rw [show verticalRecombined β scale indices
      (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) =
      fun z : WaveSpaceTime => ∑ n ∈ indices, h n z.2 * F n z.1 by
        funext z
        exact houtput z]
  exact hcont.aestronglyMeasurable

/-- A literal finite tensor `L²`--`L⁴`--`L∞` interpolation estimate for the
actual vertical recombination.  The `L²` factor is the proved Fourier-overlap
bound on the supplied Schwartz multiplier profiles, and the `L∞` factor is
the explicit common-time-kernel/spatial-envelope bound.  Thus the conclusion
is finite and packet-level; it makes no continuum recombination claim. -/
theorem eLpNorm_four_rpow_two_verticalRecombined_verticalSeparablePackets_le_of_schwartz_profiles_of_common_time_kernel_and_spatial_envelope
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex) {C : Real}
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ) ≤ C)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (κ : Real → Real) (a : Int → Real) {A B : Real}
    (hA : 0 ≤ A) (hκ : ∀ t : Real, 0 ≤ κ t)
    (hκbound : ∀ t : Real, κ t ≤ B)
    (hkernel : ∀ n ∈ indices, ∀ t : Real,
      ‖𝓕⁻ (fun τ : Real => m n τ * 𝓕 (g n : Real → Complex) τ) t‖ ≤
        κ t * a n)
    (hspatial : ∀ x : Euclidean 2, ∑ n ∈ indices,
      ‖F n x‖ ^ (2 : ℕ) ≤ A ^ (2 : ℕ)) :
    (eLpNorm
      (verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)))
      (4 : ENNReal) volume) ^ (2 : Real) ≤
      ENNReal.ofReal (Real.sqrt (C * ∑ n ∈ indices, ∫ z : WaveSpaceTime,
        ‖verticalSeparablePacket (F n) (g n : Real → Complex) z‖ ^ (2 : ℕ))) *
        ENNReal.ofReal (B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : ℕ)) * A) := by
  let out : WaveSpaceTime → Complex :=
    verticalRecombined β scale indices
      (fun n => verticalSeparablePacket (F n) (g n : Real → Complex))
  let E : Real := ∑ n ∈ indices, ∫ z : WaveSpaceTime,
    ‖verticalSeparablePacket (F n) (g n : Real → Complex) z‖ ^ (2 : ℕ)
  let L : Real := B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : ℕ)) * A
  have houtmeas : AEStronglyMeasurable out volume := by
    dsimp only [out]
    exact aux_aestronglyMeasurable_verticalRecombined_verticalSeparablePackets_of_profiles
      β scale indices m g hprofile F
  have houtintegrable : Integrable (fun z : WaveSpaceTime => ‖out z‖ ^ (2 : ℕ)) volume := by
    dsimp only [out]
    exact aux_integrable_norm_sq_verticalRecombined_verticalSeparablePackets_of_profiles
      β scale indices m g hprofile F
  have houtmem : MemLp out 2 volume :=
    (memLp_two_iff_integrable_sq_norm houtmeas).mpr houtintegrable
  have hraw : (∫ z : WaveSpaceTime, ‖out z‖ ^ (2 : ℕ)) ≤ C * E := by
    dsimp only [out, E]
    exact
      integral_norm_sq_verticalRecombined_verticalSeparablePackets_le_sum_inputEnergy_of_schwartz_profiles
        β scale indices m g hprofile hoverlap F
  have htwo : eLpNorm out (2 : ENNReal) volume ≤
      ENNReal.ofReal (Real.sqrt (C * E)) := by
    rw [houtmem.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    apply ENNReal.ofReal_le_ofReal
    calc
      (∫ z : WaveSpaceTime, ‖out z‖ ^ (2 : Real)) ^ (2 : Real)⁻¹ =
          Real.sqrt (∫ z : WaveSpaceTime, ‖out z‖ ^ (2 : ℕ)) := by
        rw [Real.sqrt_eq_rpow]
        congr 1
        · apply integral_congr_ae
          filter_upwards with z
          exact Real.rpow_two _
        · norm_num
      _ ≤ Real.sqrt (C * E) := Real.sqrt_le_sqrt hraw
  have htop : eLpNorm out ⊤ volume ≤ ENNReal.ofReal L := by
    rw [eLpNorm_exponent_top]
    apply eLpNormEssSup_le_of_ae_bound
    filter_upwards with z
    dsimp only [out, L]
    exact
      norm_verticalRecombined_verticalSeparablePackets_le_of_schwartz_profiles_of_common_time_kernel_and_spatial_envelope
        β scale indices m g hprofile F κ a hA hκ hκbound hkernel hspatial z
  have hinterp := eLpNorm_four_rpow_two_le_two_mul_top out houtmeas
  change (eLpNorm out (4 : ENNReal) volume) ^ (2 : Real) ≤
    ENNReal.ofReal (Real.sqrt (C * E)) * ENNReal.ofReal L
  exact hinterp.trans (mul_le_mul htwo htop bot_le (by simp))

/-- The literal radial--time reconstruction is the vertical recombination of
its conic radial pieces.  This identifies the finite-packet-to-continuum
vertical estimate with the reconstruction term used by the MSS decomposition. -/
theorem radialTimeReconstruction_eq_verticalRecombined
    (verticalCutoff radialCutoff : Real → Complex) (indices : Real → Finset Int)
    (scale : Real) (a : Euclidean 2 → Complex) (ϑ : Real → Complex)
    (f : Euclidean 2 → Complex) :
    radialTimeReconstruction verticalCutoff radialCutoff indices scale a ϑ f =
      verticalRecombined verticalCutoff scale (indices scale)
        (fun n => verticalProjection verticalCutoff scale n
          (conicOperator scale a ϑ (radialPiece radialCutoff scale n f))) := rfl

/-- The honest finite-family Minkowski estimate for vertical recombination.
It makes no claim about the norm of a vertical projection; those individual
measurability hypotheses are kept explicit. -/
theorem eLpNorm_verticalRecombined_le_sum
    (verticalCutoff : Real → Complex) (scale : Real) (indices : Finset Int)
    (H : Int → WaveSpaceTime → Complex) (p : ENNReal)
    (hmeas : ∀ n ∈ indices,
      AEStronglyMeasurable (verticalProjection verticalCutoff scale n (H n)) volume)
    (hp : 1 ≤ p) :
    eLpNorm (verticalRecombined verticalCutoff scale indices H) p volume ≤
      ∑ n ∈ indices, eLpNorm (verticalProjection verticalCutoff scale n (H n)) p volume := by
  calc
    eLpNorm (verticalRecombined verticalCutoff scale indices H) p volume =
        eLpNorm (∑ n ∈ indices, verticalProjection verticalCutoff scale n (H n)) p volume := by
      apply eLpNorm_congr_ae
      filter_upwards with z
      simp [verticalRecombined]
    _ ≤ ∑ n ∈ indices, eLpNorm (verticalProjection verticalCutoff scale n (H n)) p volume :=
      eLpNorm_sum_le (f := fun n => verticalProjection verticalCutoff scale n (H n))
        (s := indices) hmeas hp

/-- If every vertical projection has a common `Lᵖ` bound, finite
recombination costs at most the cardinality of its index family. -/
theorem eLpNorm_verticalRecombined_le_card_nsmul_of_bound
    (verticalCutoff : Real → Complex) (scale : Real) (indices : Finset Int)
    (H : Int → WaveSpaceTime → Complex) (p B : ENNReal)
    (hmeas : ∀ n ∈ indices,
      AEStronglyMeasurable (verticalProjection verticalCutoff scale n (H n)) volume)
    (hp : 1 ≤ p)
    (hbound : ∀ n ∈ indices,
      eLpNorm (verticalProjection verticalCutoff scale n (H n)) p volume ≤ B) :
    eLpNorm (verticalRecombined verticalCutoff scale indices H) p volume ≤
      indices.card • B := by
  calc
    eLpNorm (verticalRecombined verticalCutoff scale indices H) p volume ≤
        ∑ n ∈ indices, eLpNorm (verticalProjection verticalCutoff scale n (H n)) p volume :=
      eLpNorm_verticalRecombined_le_sum verticalCutoff scale indices H p hmeas hp
    _ ≤ ∑ _n ∈ indices, B :=
      Finset.sum_le_sum fun n hn => hbound n hn
    _ = indices.card • B := by simp

/-- Applying the finite Minkowski estimate to the explicit relevant radial
family gives a completely concrete scale-dependent finite count. -/
theorem eLpNorm_verticalRecombined_relevantRadialIndexEnumeration_le_of_bound
    (verticalCutoff : Real → Complex) (scale : Real)
    (H : Int → WaveSpaceTime → Complex) (p B : ENNReal)
    (hmeas : ∀ n ∈ relevantRadialIndexEnumeration scale,
      AEStronglyMeasurable
        (verticalProjection verticalCutoff scale n (H n)) volume)
    (hp : 1 ≤ p)
    (hbound : ∀ n ∈ relevantRadialIndexEnumeration scale,
      eLpNorm (verticalProjection verticalCutoff scale n (H n)) p volume ≤ B) :
    eLpNorm
        (verticalRecombined verticalCutoff scale (relevantRadialIndexEnumeration scale) H)
        p volume ≤
      (2 * ⌈Real.sqrt scale⌉₊ + 7) • B := by
  calc
    eLpNorm
        (verticalRecombined verticalCutoff scale (relevantRadialIndexEnumeration scale) H)
        p volume ≤ (relevantRadialIndexEnumeration scale).card • B :=
      eLpNorm_verticalRecombined_le_card_nsmul_of_bound verticalCutoff scale
        (relevantRadialIndexEnumeration scale) H p B hmeas hp hbound
    _ ≤ (2 * ⌈Real.sqrt scale⌉₊ + 7) • B :=
      nsmul_le_nsmul_left (by positivity : 0 ≤ B)
        (card_relevantRadialIndexEnumeration_le_two_mul_natCeil_sqrt_add_seven scale)

/-- A pointwise-envelope form of the finite recombination estimate. -/
theorem norm_verticalRecombined_le_card_nsmul_of_pointwise_bound
    (verticalCutoff : Real → Complex) (scale : Real) (indices : Finset Int)
    (H : Int → WaveSpaceTime → Complex) (B : WaveSpaceTime → Real)
    (hbound : ∀ n ∈ indices, ∀ z : WaveSpaceTime,
      ‖verticalProjection verticalCutoff scale n (H n) z‖ ≤ B z)
    (z : WaveSpaceTime) :
    ‖verticalRecombined verticalCutoff scale indices H z‖ ≤ indices.card • B z := by
  calc
    ‖verticalRecombined verticalCutoff scale indices H z‖ =
        ‖∑ n ∈ indices, verticalProjection verticalCutoff scale n (H n) z‖ := rfl
    _ ≤ ∑ n ∈ indices, ‖verticalProjection verticalCutoff scale n (H n) z‖ :=
      norm_sum_le _ _
    _ ≤ ∑ _n ∈ indices, B z :=
      Finset.sum_le_sum fun n hn => hbound n hn z
    _ = indices.card • B z := by simp

/-- The exponent supplied by vertical recombination.  The `∞` branch is the
endpoint exponent `1/4`; the other branch is the finite-`Lp` formula. -/
def verticalRecombinationGain (p : ENNReal) : Real :=
  if p = ⊤ then 1 / 4 else 1 / 4 - 1 / (2 * p.toReal)

/-- A compactly supported smooth vertical cutoff in the literal blueprint
form.  The `tsupport` field records `C_c^∞((-1,1))`; the pointwise support
field is retained for the spectral-overlap argument. -/
structure MSSVerticalCutoff where
  cutoff : SchwartzMap Real Complex
  tsupport_subset : tsupport (cutoff : Real → Complex) ⊆ Set.Ioo (-1) 1
  support : ∀ s : Real, cutoff s ≠ 0 → |s| < 1

/-- The vertical recombination target on finite joint-Schwartz families,
including both the finite and `L∞` exponents. -/
def verticalRecombination (B : MSSVerticalCutoff) : Prop :=
  ∀ (p : ENNReal) (C₀ : Real), ENNReal.ofReal 2 ≤ p → 0 < C₀ →
    ∃ C : Real, 0 < C ∧ ∀ scale : Real, 2 ≤ scale →
      ∀ indices : Finset Int,
        (indices.card : Real) ≤ C₀ * Real.sqrt scale →
        ∀ H : Int → SchwartzMap JointWaveSpaceTime Complex,
          eLpNorm (verticalRecombined (B.cutoff : Real → Complex) scale indices
            (fun n => jointSchwartzRaw (H n))) p volume ≤
            ENNReal.ofReal (C * scale ^ verticalRecombinationGain p) *
              eLpNorm (verticalSquareFunction indices
                (fun n => jointSchwartzRaw (H n))) p volume

/-- A literal `L⁴` finite-packet-to-continuum transfer for vertical
recombination.  Each `packets k` is an actual family of space--time
functions, rather than an abstract finite-model output.  Thus a concrete
packet construction can supply its uniform finite-packet estimate and the
two displayed `L⁴` convergences, and this theorem closes the passage to the
literal Fourier-multiplier recombination.

This does not assert that such a packet construction exists.  To use it for
the MSS proof, one still has to construct finite measurable packet families
representing `verticalProjection`, prove their uniform vector-valued `L⁴`
bound (via a genuine `L²`--`L∞` analytic interpolation datum, not the
counting-measure proxy), and establish both convergences below. -/
theorem eLpNorm_verticalRecombined_le_of_tendsto_eLpNorm
    (verticalCutoff : Real → Complex) (scale : Real) (indices : Finset Int)
    (H : Int → WaveSpaceTime → Complex)
    (packets : Nat → Int → WaveSpaceTime → Complex) (A : ENNReal) (hA : A ≠ ∞)
    (houtput_meas : AEStronglyMeasurable
      (verticalRecombined verticalCutoff scale indices H) volume)
    (hpacket_output_meas : ∀ k, AEStronglyMeasurable
      (verticalRecombined verticalCutoff scale indices (packets k)) volume)
    (hsquare_meas : AEStronglyMeasurable (verticalSquareFunction indices H) volume)
    (hpacket_square_meas : ∀ k, AEStronglyMeasurable
      (verticalSquareFunction indices (packets k)) volume)
    (hpacket_bound : ∀ k,
      eLpNorm (verticalRecombined verticalCutoff scale indices (packets k))
          (4 : ENNReal) volume ≤
        A * eLpNorm (verticalSquareFunction indices (packets k)) (4 : ENNReal) volume)
    (houtput_tendsto : Tendsto (fun k =>
      eLpNorm
        (verticalRecombined verticalCutoff scale indices (packets k) -
          verticalRecombined verticalCutoff scale indices H)
        (4 : ENNReal) volume) atTop (𝓝 0))
    (hsquare_tendsto : Tendsto (fun k =>
      eLpNorm
        (verticalSquareFunction indices (packets k) - verticalSquareFunction indices H)
        (4 : ENNReal) volume) atTop (𝓝 0)) :
    eLpNorm (verticalRecombined verticalCutoff scale indices H) (4 : ENNReal) volume ≤
      A * eLpNorm (verticalSquareFunction indices H) (4 : ENNReal) volume := by
  let P : ENNReal := eLpNorm
    (verticalRecombined verticalCutoff scale indices H) (4 : ENNReal) volume
  let S : ENNReal := eLpNorm (verticalSquareFunction indices H) (4 : ENNReal) volume
  let eout : Nat → ENNReal := fun k => eLpNorm
    (verticalRecombined verticalCutoff scale indices (packets k) -
      verticalRecombined verticalCutoff scale indices H)
    (4 : ENNReal) volume
  let esq : Nat → ENNReal := fun k => eLpNorm
    (verticalSquareFunction indices (packets k) - verticalSquareFunction indices H)
    (4 : ENNReal) volume
  have hp : (1 : ENNReal) ≤ (4 : ENNReal) := by norm_num
  have hpoint : ∀ k, P ≤ eout k + A * (esq k + S) := by
    intro k
    dsimp only [P, eout, esq, S]
    have houtput_triangle :
        eLpNorm (verticalRecombined verticalCutoff scale indices H) (4 : ENNReal) volume ≤
          eLpNorm
              (verticalRecombined verticalCutoff scale indices (packets k) -
                verticalRecombined verticalCutoff scale indices H)
              (4 : ENNReal) volume +
            eLpNorm (verticalRecombined verticalCutoff scale indices (packets k))
              (4 : ENNReal) volume := by
      calc
        eLpNorm (verticalRecombined verticalCutoff scale indices H) (4 : ENNReal) volume =
            eLpNorm
              ((verticalRecombined verticalCutoff scale indices H -
                verticalRecombined verticalCutoff scale indices (packets k)) +
                verticalRecombined verticalCutoff scale indices (packets k))
              (4 : ENNReal) volume := by
          congr 1
          ext z
          simp
        _ ≤ eLpNorm
              (verticalRecombined verticalCutoff scale indices H -
                verticalRecombined verticalCutoff scale indices (packets k))
              (4 : ENNReal) volume +
            eLpNorm (verticalRecombined verticalCutoff scale indices (packets k))
              (4 : ENNReal) volume :=
          eLpNorm_add_le (houtput_meas.sub (hpacket_output_meas k))
            (hpacket_output_meas k) hp
        _ = eLpNorm
              (verticalRecombined verticalCutoff scale indices (packets k) -
                verticalRecombined verticalCutoff scale indices H)
              (4 : ENNReal) volume +
            eLpNorm (verticalRecombined verticalCutoff scale indices (packets k))
              (4 : ENNReal) volume := by
          have hneg :
              verticalRecombined verticalCutoff scale indices H -
                  verticalRecombined verticalCutoff scale indices (packets k) =
                -(verticalRecombined verticalCutoff scale indices (packets k) -
                  verticalRecombined verticalCutoff scale indices H) := by
            ext z
            simp
          rw [hneg, eLpNorm_neg]
    calc
      eLpNorm (verticalRecombined verticalCutoff scale indices H) (4 : ENNReal) volume ≤
          eLpNorm
              (verticalRecombined verticalCutoff scale indices (packets k) -
                verticalRecombined verticalCutoff scale indices H)
              (4 : ENNReal) volume +
            eLpNorm (verticalRecombined verticalCutoff scale indices (packets k))
              (4 : ENNReal) volume := houtput_triangle
      _ ≤ eLpNorm
              (verticalRecombined verticalCutoff scale indices (packets k) -
                verticalRecombined verticalCutoff scale indices H)
              (4 : ENNReal) volume +
            A * eLpNorm (verticalSquareFunction indices (packets k))
              (4 : ENNReal) volume := by
        gcongr
        exact hpacket_bound k
      _ ≤ eLpNorm
              (verticalRecombined verticalCutoff scale indices (packets k) -
                verticalRecombined verticalCutoff scale indices H)
              (4 : ENNReal) volume +
            A * (eLpNorm
              (verticalSquareFunction indices (packets k) - verticalSquareFunction indices H)
              (4 : ENNReal) volume +
              eLpNorm (verticalSquareFunction indices H) (4 : ENNReal) volume) := by
        gcongr
        have hsquare_triangle :
            eLpNorm (verticalSquareFunction indices (packets k)) (4 : ENNReal) volume ≤
              eLpNorm
                  (verticalSquareFunction indices (packets k) - verticalSquareFunction indices H)
                  (4 : ENNReal) volume +
                eLpNorm (verticalSquareFunction indices H) (4 : ENNReal) volume := by
          calc
            eLpNorm (verticalSquareFunction indices (packets k)) (4 : ENNReal) volume =
                eLpNorm
                  ((verticalSquareFunction indices (packets k) - verticalSquareFunction indices H) +
                    verticalSquareFunction indices H)
                  (4 : ENNReal) volume := by
              congr 1
              ext z
              simp
            _ ≤ eLpNorm
                  (verticalSquareFunction indices (packets k) - verticalSquareFunction indices H)
                  (4 : ENNReal) volume +
                eLpNorm (verticalSquareFunction indices H) (4 : ENNReal) volume :=
              eLpNorm_add_le ((hpacket_square_meas k).sub hsquare_meas) hsquare_meas hp
        exact hsquare_triangle
  have heout : Tendsto eout atTop (𝓝 0) := by
    simpa only [eout] using houtput_tendsto
  have hesq : Tendsto esq atTop (𝓝 0) := by
    simpa only [esq] using hsquare_tendsto
  have hright : Tendsto (fun k => eout k + A * (esq k + S)) atTop (𝓝 (A * S)) := by
    have hsq_plus : Tendsto (fun k => esq k + S) atTop (𝓝 (0 + S)) :=
      hesq.add (tendsto_const_nhds : Tendsto (fun _ : Nat => S) atTop (𝓝 S))
    have hmul : Tendsto (fun k => A * (esq k + S)) atTop (𝓝 (A * (0 + S))) :=
      ENNReal.Tendsto.const_mul hsq_plus (Or.inr hA)
    simpa using heout.add hmul
  have hle : P ≤ A * S := ge_of_tendsto hright (Eventually.of_forall hpoint)
  simpa only [P, S] using hle

/-- The angularly localized summand of the conic half-wave operator. -/
noncomputable def angularPiece (scale : Real) (a χ : Euclidean 2 → Complex)
    (ϑ : Real → Complex) (f : Euclidean 2 → Complex) :
    WaveSpaceTime → Complex :=
  fun z => ϑ z.2 * 𝓕⁻ (fun ξ =>
    χ ξ * a (scale⁻¹ • ξ) * halfWaveMultiplier WaveSign.plus z.2 ξ * 𝓕 f ξ) z.1

/-- A finite angular partition on the actual spatial Fourier support
reconstructs the unangularized conic half-wave. The integrability hypothesis
is explicit because this uses the raw inverse Fourier transform; no
vertical-recombination, square-function, or local-smoothing estimate is
asserted here. -/
theorem sum_angularPiece_eq_conicOperator_of_sum_eq_one_on_support
    (angularIndices : Finset Int) (chi : Int → Euclidean 2 → Complex)
    (scale : Real) (a : Euclidean 2 → Complex) (vartheta : Real → Complex)
    (g : Euclidean 2 → Complex)
    (hchi : ∀ xi ∈ Function.support
      (fun xi : Euclidean 2 => a (scale⁻¹ • xi) * 𝓕 g xi),
      ∑ nu ∈ angularIndices, chi nu xi = 1)
    (hintegrable : ∀ (t : Real) (nu : Int), nu ∈ angularIndices →
      Integrable (fun xi : Euclidean 2 =>
        chi nu xi * a (scale⁻¹ • xi) * halfWaveMultiplier WaveSign.plus t xi * 𝓕 g xi) volume) :
    (fun z => ∑ nu ∈ angularIndices,
      angularPiece scale a (chi nu) vartheta g z) =
      conicOperator scale a vartheta g := by
  classical
  funext z
  simp only [angularPiece, conicOperator]
  rw [← Finset.mul_sum]
  rw [← aux_fourierInv_finset_sum_of_integrable
    angularIndices
    (fun nu xi => chi nu xi * a (scale⁻¹ • xi) *
      halfWaveMultiplier WaveSign.plus z.2 xi * 𝓕 g xi)
    (fun nu hnu => hintegrable z.2 nu hnu) z.1]
  congr 2
  apply congrArg (fun q : Euclidean 2 → Complex => 𝓕⁻ q z.1)
  funext xi
  calc
    (∑ nu ∈ angularIndices,
        chi nu xi * a (scale⁻¹ • xi) * halfWaveMultiplier WaveSign.plus z.2 xi * 𝓕 g xi) =
        (∑ nu ∈ angularIndices, chi nu xi) *
          (a (scale⁻¹ • xi) * halfWaveMultiplier WaveSign.plus z.2 xi * 𝓕 g xi) := by
          rw [Finset.sum_mul]
          apply Finset.sum_congr rfl
          intro nu hnu
          ring
    _ = _ := by
      by_cases hxi : xi ∈ Function.support
          (fun xi : Euclidean 2 => a (scale⁻¹ • xi) * 𝓕 g xi)
      · rw [hchi xi hxi]
        simp
      · have hzero : a (scale⁻¹ • xi) * 𝓕 g xi = 0 := by
          by_contra hne
          exact hxi hne
        have hbase :
            a (scale⁻¹ • xi) * halfWaveMultiplier WaveSign.plus z.2 xi * 𝓕 g xi = 0 := by
          calc
            a (scale⁻¹ • xi) * halfWaveMultiplier WaveSign.plus z.2 xi * 𝓕 g xi =
                halfWaveMultiplier WaveSign.plus z.2 xi * (a (scale⁻¹ • xi) * 𝓕 g xi) := by
                  ring
            _ = 0 := by rw [hzero]; simp
        rw [hbase]
        simp

/-- Supplied Schwartz angular amplitudes discharge the integrability
side-condition of finite angular synthesis. This does not infer regularity
from raw cutoffs. -/
private theorem aux_integrable_angularPiece_multiplier_of_schwartz_profiles
    (angularIndices : Finset Int) (chi : Int → Euclidean 2 → Complex)
    (scale : Real) (a : Euclidean 2 → Complex)
    (radialCutoff : Real → Complex) (n : Int)
    (R f : SchwartzMap (Euclidean 2) Complex)
    (B : Int → SchwartzMap (Euclidean 2) Complex)
    (hR : ∀ xi : Euclidean 2,
      R xi = radialCutoff ((Real.sqrt scale)⁻¹ * ‖xi‖ - n))
    (hB : ∀ (nu : Int) (xi : Euclidean 2), B nu xi =
      chi nu xi * a (scale⁻¹ • xi) *
        (R xi * 𝓕 (f : Euclidean 2 → Complex) xi)) :
    ∀ (t : Real) (nu : Int), nu ∈ angularIndices →
      Integrable (fun xi : Euclidean 2 =>
        chi nu xi * a (scale⁻¹ • xi) * halfWaveMultiplier WaveSign.plus t xi *
          𝓕 (radialPiece radialCutoff scale n (f : Euclidean 2 → Complex)) xi) volume := by
  intro t nu hnu
  rw [show (fun xi : Euclidean 2 =>
      chi nu xi * a (scale⁻¹ • xi) * halfWaveMultiplier WaveSign.plus t xi *
        𝓕 (radialPiece radialCutoff scale n (f : Euclidean 2 → Complex)) xi) =
      fun xi => B nu xi * halfWaveMultiplier WaveSign.plus t xi by
        funext xi
        rw [fourier_radialPiece_eq_schwartzProfile_mul_fourier
          radialCutoff scale n R f hR xi, hB nu xi]
        ring]
  refine Integrable.mono' (B nu).integrable.norm ?_ ?_
  · have hhalf : Continuous (halfWaveMultiplier WaveSign.plus t) := by
      unfold halfWaveMultiplier
      fun_prop
    exact ((B nu).continuous.mul hhalf).aestronglyMeasurable
  · filter_upwards with xi
    rw [norm_mul, norm_halfWaveMultiplier, mul_one]

/-- A finite support-local angular partition rewrites the literal radial-time
reconstruction as a vertical recombination of angular pieces. The partition
and raw Fourier-integrability assumptions remain explicit at every radial
label; this is an exact finite algebraic identity, not a vertical endpoint,
square-function, or local-smoothing estimate. -/
theorem radialTimeReconstruction_eq_verticalRecombined_angularPiece_of_sum_eq_one_on_support
    (verticalCutoff radialCutoff : Real → Complex) (indices : Real → Finset Int)
    (angularIndices : Finset Int) (chi : Int → Euclidean 2 → Complex)
    (scale : Real) (a : Euclidean 2 → Complex) (vartheta : Real → Complex)
    (f : Euclidean 2 → Complex)
    (hchi : ∀ n ∈ indices scale, ∀ xi ∈ Function.support
      (fun xi : Euclidean 2 =>
        a (scale⁻¹ • xi) * 𝓕 (radialPiece radialCutoff scale n f) xi),
      ∑ nu ∈ angularIndices, chi nu xi = 1)
    (hintegrable : ∀ n ∈ indices scale, ∀ (t : Real) (nu : Int), nu ∈ angularIndices →
      Integrable (fun xi : Euclidean 2 =>
        chi nu xi * a (scale⁻¹ • xi) * halfWaveMultiplier WaveSign.plus t xi *
          𝓕 (radialPiece radialCutoff scale n f) xi) volume) :
    radialTimeReconstruction verticalCutoff radialCutoff indices scale a vartheta f =
      verticalRecombined verticalCutoff scale (indices scale)
        (fun n => verticalProjection verticalCutoff scale n
          (fun z => ∑ nu ∈ angularIndices,
            angularPiece scale a (chi nu) vartheta
              (radialPiece radialCutoff scale n f) z)) := by
  change radialTimeReconstruction verticalCutoff radialCutoff indices scale a vartheta f =
    (fun z => ∑ n ∈ indices scale,
      verticalProjection verticalCutoff scale n
        (verticalProjection verticalCutoff scale n
          (fun z => ∑ nu ∈ angularIndices,
            angularPiece scale a (chi nu) vartheta
              (radialPiece radialCutoff scale n f) z)) z)
  funext z
  unfold radialTimeReconstruction
  apply Finset.sum_congr rfl
  intro n hn
  rw [← sum_angularPiece_eq_conicOperator_of_sum_eq_one_on_support
    angularIndices chi scale a vartheta
    (radialPiece radialCutoff scale n f) (hchi n hn) (hintegrable n hn)]

/-- Under the same finite support-local angular partition, the conic
half-wave is its angularized finite radial reconstruction plus the literal
radial-time residual. This is an exact algebraic identity only: it makes no
vertical-recombination, square-function, or local-smoothing assertion. -/
theorem conicOperator_eq_verticalRecombined_angularPiece_add_radialTimeResidual_of_sum_eq_one_on_support
    (verticalCutoff radialCutoff : Real → Complex) (indices : Real → Finset Int)
    (angularIndices : Finset Int) (chi : Int → Euclidean 2 → Complex)
    (scale : Real) (a : Euclidean 2 → Complex) (vartheta : Real → Complex)
    (f : Euclidean 2 → Complex)
    (hchi : ∀ n ∈ indices scale, ∀ xi ∈ Function.support
      (fun xi : Euclidean 2 =>
        a (scale⁻¹ • xi) * 𝓕 (radialPiece radialCutoff scale n f) xi),
      ∑ nu ∈ angularIndices, chi nu xi = 1)
    (hintegrable : ∀ n ∈ indices scale, ∀ (t : Real) (nu : Int), nu ∈ angularIndices →
      Integrable (fun xi : Euclidean 2 =>
        chi nu xi * a (scale⁻¹ • xi) * halfWaveMultiplier WaveSign.plus t xi *
          𝓕 (radialPiece radialCutoff scale n f) xi) volume) :
    conicOperator scale a vartheta f =
      verticalRecombined verticalCutoff scale (indices scale)
        (fun n => verticalProjection verticalCutoff scale n
          (fun z => ∑ nu ∈ angularIndices,
            angularPiece scale a (chi nu) vartheta
              (radialPiece radialCutoff scale n f) z)) +
      radialTimeResidual verticalCutoff radialCutoff indices scale a vartheta f := by
  have hrec :=
    radialTimeReconstruction_eq_verticalRecombined_angularPiece_of_sum_eq_one_on_support
      verticalCutoff radialCutoff indices angularIndices chi scale a vartheta f hchi hintegrable
  calc
    conicOperator scale a vartheta f =
        radialTimeReconstruction verticalCutoff radialCutoff indices scale a vartheta f +
          radialTimeResidual verticalCutoff radialCutoff indices scale a vartheta f := by
      unfold radialTimeResidual
      funext z
      change conicOperator scale a vartheta f z =
        radialTimeReconstruction verticalCutoff radialCutoff indices scale a vartheta f z +
          (conicOperator scale a vartheta f z -
            radialTimeReconstruction verticalCutoff radialCutoff indices scale a vartheta f z)
      ring
    _ = _ := by rw [hrec]

/-- A metric encoding of an angular sector around a unit direction.  This
avoids choosing polar coordinates while expressing the aperture used in the
conic-plate definitions. -/
def angularSector (direction : Euclidean 2) (aperture : Real) : Set (Euclidean 2) :=
  {ξ | ξ ≠ 0 ∧ ‖(‖ξ‖)⁻¹ • ξ - direction‖ ≤ aperture}

/-- The geometric data carried by an angular partition at one frequency
scale.  The centers are unit directions in one fixed narrow sector and their
chordal distances are uniformly comparable to the scaled differences of
their consecutive integer labels.  The three constants are fixed before the
plate-overlap statement, so its constants may depend on this angular
partition geometry but not on the scale or the chosen finite subfamily. -/
def angularSectorGeometry (scale : Real) (indices : Finset Int)
    (directions : Int → Euclidean 2)
    (sectorRadius spacingLower spacingUpper : Real) : Prop :=
  0 < sectorRadius ∧ sectorRadius ≤ 1 / 4 ∧
  0 < spacingLower ∧ 0 < spacingUpper ∧
  ∃ center : Euclidean 2, ‖center‖ = 1 ∧
    ∀ ν ∈ indices, ‖directions ν‖ = 1 ∧
      ‖directions ν - center‖ ≤ sectorRadius ∧
      ∀ ν' ∈ indices,
        spacingLower * ((ν - ν').natAbs : Real) *
            scale ^ (-(1 / 2 : Real)) ≤ ‖directions ν - directions ν'‖ ∧
        ‖directions ν - directions ν'‖ ≤
          spacingUpper * ((ν - ν').natAbs : Real) *
            scale ^ (-(1 / 2 : Real))

/-- The lower separation part of `angularSectorGeometry` makes the labelled
angular directions injective on the finite angular index set.  This is the
first exact finite-overlap input: distinct labels cannot denote the same
plate direction. -/
theorem angularSectorGeometry_direction_injective
    {scale sectorRadius spacingLower spacingUpper : Real} {indices : Finset Int}
    {directions : Int → Euclidean 2}
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    {ν ν' : Int} (hν : ν ∈ indices) (hν' : ν' ∈ indices)
    (hdirections : directions ν = directions ν') : ν = ν' := by
  rcases hgeometry with ⟨_, _, hspacingLower, _, center, hcenter, hdata⟩
  by_contra hne
  have hlabel : 0 < ((ν - ν').natAbs : Real) := by
    exact_mod_cast Int.natAbs_pos.mpr (sub_ne_zero.mpr hne)
  have hscalePow : 0 < scale ^ (-(1 / 2 : Real)) :=
    Real.rpow_pos_of_pos hscale _
  have hpositive : 0 <
      spacingLower * ((ν - ν').natAbs : Real) * scale ^ (-(1 / 2 : Real)) :=
    mul_pos (mul_pos hspacingLower hlabel) hscalePow
  have hseparation := ((hdata ν hν).2.2 ν' hν').1
  rw [hdirections, sub_self, norm_zero] at hseparation
  linarith

/-- The Fourier multiplier for a wave-front projection. -/
def wavefrontMultiplier (angularCutoff : Euclidean 2 → Complex)
    (normalCutoff : Real → Complex) (scale gamma : Real) :
    WaveSpaceTime → Complex :=
  fun ζ => angularCutoff ζ.1 *
    normalCutoff (scale ^ (-gamma) * (ζ.2 - ‖ζ.1‖))

/-- The literal wave-front Fourier projection `Q_ν^(scale,gamma)`. -/
noncomputable def wavefrontProjection (angularCutoff : Euclidean 2 → Complex)
    (normalCutoff : Real → Complex) (scale gamma : Real)
    (G : WaveSpaceTime → Complex) : WaveSpaceTime → Complex :=
  spaceTimeFourierInv (fun ζ =>
    wavefrontMultiplier angularCutoff normalCutoff scale gamma ζ *
      spaceTimeFourier G ζ)

/-- The conic plate supporting a wave-front localized radial/angular piece.
The angular sector is represented by normalized Euclidean distance from its
central direction, an equivalent concrete aperture convention. -/
def conicPlate (scale gamma angularConstant : Real) (n : Int)
    (direction : Euclidean 2) : Set WaveSpaceTime :=
  {ζ | scale / 4 ≤ ‖ζ.1‖ ∧ ‖ζ.1‖ ≤ 4 * scale ∧
    ζ.1 ∈ angularSector direction
      (angularConstant * scale ^ (-(1 / 2 : Real))) ∧
    |(Real.sqrt scale)⁻¹ * ζ.2 - n| ≤ 1 ∧
    |ζ.2 - ‖ζ.1‖| ≤ 2 * scale ^ gamma}

/-- A genuinely joint-Schwartz spectral cutoff of joint-Schwartz data.  The
coefficient is Schwartz in all space--time variables; a separate realization
hypothesis records when it agrees with a wave-front multiplier on the relevant
Fourier support. -/
noncomputable def jointSchwartzSpectralCutoffProduct
    (q G : SchwartzMap JointWaveSpaceTime Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  SchwartzMap.smulLeftCLM Complex (q : JointWaveSpaceTime → Complex)
    (FourierTransform.fourier G)

/-- The physical-coordinate output of a joint-Schwartz spectral cutoff. -/
noncomputable def jointSchwartzSpectralCutoffOutput
    (q G : SchwartzMap JointWaveSpaceTime Complex) :
    WaveSpaceTime → Complex :=
  jointSchwartzRaw
    (FourierTransform.fourierInv (jointSchwartzSpectralCutoffProduct q G))

/-- A literal spectral realization identifies a raw wave-front projection
with a joint-Schwartz cutoff output.  The equality is required only after
multiplication by the supplied Fourier transform; no global regularity is
claimed for the raw wave-front multiplier. -/
theorem wavefrontProjection_eq_jointSchwartzSpectralCutoffOutput_of_realization
    (angularCutoff : Euclidean 2 → Complex) (normalCutoff : Real → Complex)
    (scale gamma : Real)
    (q G : SchwartzMap JointWaveSpaceTime Complex)
    (hrealize : ∀ ζ : WaveSpaceTime,
      wavefrontMultiplier angularCutoff normalCutoff scale gamma ζ *
          FourierTransform.fourier (G : JointWaveSpaceTime → Complex)
            (WithLp.toLp 2 ζ) =
        q (WithLp.toLp 2 ζ) *
          FourierTransform.fourier (G : JointWaveSpaceTime → Complex)
            (WithLp.toLp 2 ζ)) :
    wavefrontProjection angularCutoff normalCutoff scale gamma
        (jointSchwartzRaw G) =
      jointSchwartzSpectralCutoffOutput q G := by
  let P : SchwartzMap JointWaveSpaceTime Complex :=
    jointSchwartzSpectralCutoffProduct q G
  have hmult :
      (fun ζ : WaveSpaceTime =>
        wavefrontMultiplier angularCutoff normalCutoff scale gamma ζ *
          spaceTimeFourier (jointSchwartzRaw G) ζ) =
        jointSchwartzRaw P := by
    funext ζ
    rw [spaceTimeFourier_jointSchwartzRaw G ζ]
    change
      wavefrontMultiplier angularCutoff normalCutoff scale gamma ζ *
          FourierTransform.fourier (G : JointWaveSpaceTime → Complex)
            (WithLp.toLp 2 ζ) =
        P (WithLp.toLp 2 ζ)
    dsimp only [P, jointSchwartzSpectralCutoffProduct]
    rw [SchwartzMap.smulLeftCLM_apply_apply q.hasTemperateGrowth]
    rw [SchwartzMap.fourier_coe]
    simpa only [smul_eq_mul] using hrealize ζ
  funext z
  unfold wavefrontProjection jointSchwartzSpectralCutoffOutput
  rw [hmult]
  simpa only [P, jointSchwartzRaw, SchwartzMap.fourierInv_coe] using
    spaceTimeFourierInv_jointSchwartzRaw P z

/-- The literal iterated transform of a joint-Schwartz spectral cutoff output
is its joint Schwartz spectral product. -/
theorem spaceTimeFourier_jointSchwartzSpectralCutoffOutput
    (q G : SchwartzMap JointWaveSpaceTime Complex) (ζ : WaveSpaceTime) :
    spaceTimeFourier (jointSchwartzSpectralCutoffOutput q G) ζ =
      jointSchwartzSpectralCutoffProduct q G (WithLp.toLp 2 ζ) := by
  unfold jointSchwartzSpectralCutoffOutput
  rw [spaceTimeFourier_jointSchwartzRaw
    (FourierTransform.fourierInv (jointSchwartzSpectralCutoffProduct q G)) ζ]
  change
    FourierTransform.fourier
        (FourierTransform.fourierInv (jointSchwartzSpectralCutoffProduct q G) :
          JointWaveSpaceTime → Complex)
        (WithLp.toLp 2 ζ) =
      jointSchwartzSpectralCutoffProduct q G (WithLp.toLp 2 ζ)
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]

/-- A joint Schwartz spectral cutoff in planar frequency and the normal
coordinate `tau - rho xi`.  Compactness is not inferred from the Schwartz
data; it must be supplied through support hypotheses when needed. -/
noncomputable def jointSchwartzSpatialNormalCutoff
    (u : SchwartzMap (Euclidean 2) Complex)
    (beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    SchwartzMap JointWaveSpaceTime Complex :=
  jointSchwartzPrecompRadialShear rho
    (jointSchwartzExternalProduct u beta)

/-- The raw-coordinate formula for the joint spatial/normal cutoff. -/
theorem jointSchwartzSpatialNormalCutoff_apply
    (u : SchwartzMap (Euclidean 2) Complex)
    (beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (zeta : WaveSpaceTime) :
    jointSchwartzSpatialNormalCutoff u beta rho (WithLp.toLp 2 zeta) =
      u zeta.1 * beta (zeta.2 - rho zeta.1) := by
  unfold jointSchwartzSpatialNormalCutoff
  rw [jointSchwartzPrecompRadialShear_apply, jointSchwartzExternalProduct_apply]

/-- The genuine spectral projection of the supplied temporal-Schwartz
annular profile by a joint spatial/normal cutoff. -/
noncomputable def temporalSchwartzAnnularNormalProjection
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    WaveSpaceTime → Complex :=
  jointSchwartzSpectralCutoffOutput
    (jointSchwartzSpatialNormalCutoff u beta rho)
    (FourierTransform.fourierInv
      (jointSchwartzModulatedAnnularProfile B vartheta rho))

/-- The exact Schwartz spectral complement of
`temporalSchwartzAnnularNormalProjection`.  This is a literal normal-tail
model for the supplied Schwartz data; it is neither a plate projection nor a
compact physical-time expression. -/
noncomputable def temporalSchwartzAnnularNormalTail
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    WaveSpaceTime → Complex :=
  jointSchwartzRaw
    (FourierTransform.fourierInv
      (jointSchwartzModulatedAnnularProfile B vartheta rho -
        jointSchwartzSpectralCutoffProduct
          (jointSchwartzSpatialNormalCutoff u beta rho)
          (FourierTransform.fourierInv
            (jointSchwartzModulatedAnnularProfile B vartheta rho))))

/-- The supplied temporal-Schwartz normal tail satisfies the literal
space--time `L²` Plancherel identity.  This concerns only the regular model,
not raw compact-time packets. -/
theorem eLpNorm_spaceTimeFourier_temporalSchwartzAnnularNormalTail_two_eq
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    eLpNorm
        (spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) 2 volume =
      eLpNorm (temporalSchwartzAnnularNormalTail B u vartheta beta rho) 2 volume := by
  apply eLpNorm_spaceTimeFourier_jointSchwartzRaw_two_eq

private theorem aux_temporalSchwartzAnnularNormalUnprojected_eq_halfWave
    (B : SchwartzMap (Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hrho : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), rho xi = ‖xi‖) :
    jointSchwartzRaw
        (FourierTransform.fourierInv
          (jointSchwartzModulatedAnnularProfile B vartheta rho)) =
      fun z : WaveSpaceTime =>
        vartheta z.2 * FourierTransform.fourierInv
          (fun xi : Euclidean 2 =>
            B xi * halfWaveMultiplier WaveSign.plus z.2 xi) z.1 := by
  funext z
  calc
    jointSchwartzRaw
        (FourierTransform.fourierInv
          (jointSchwartzModulatedAnnularProfile B vartheta rho)) z =
        spaceTimeFourierInv
          (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho)) z := by
          simpa only [jointSchwartzRaw, SchwartzMap.fourierInv_coe] using
            (spaceTimeFourierInv_jointSchwartzRaw
              (jointSchwartzModulatedAnnularProfile B vartheta rho) z).symm
    _ = _ :=
      spaceTimeFourierInv_jointSchwartzModulatedAnnularProfile_eq_halfWave_of_eq_norm_on_support
        B vartheta rho hrho z

/-- Under the supplied norm agreement, the temporal-Schwartz positive
half-wave is exactly its spatial/normal projection plus the literal normal
tail.  No plate support is asserted for the unprojected summand. -/
theorem temporalSchwartzHalfWave_eq_projection_add_normalTail
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hrho : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), rho xi = ‖xi‖) :
    (fun z : WaveSpaceTime =>
      vartheta z.2 * FourierTransform.fourierInv
        (fun xi : Euclidean 2 =>
          B xi * halfWaveMultiplier WaveSign.plus z.2 xi) z.1) =
      temporalSchwartzAnnularNormalProjection B u vartheta beta rho +
        temporalSchwartzAnnularNormalTail B u vartheta beta rho := by
  let F : SchwartzMap JointWaveSpaceTime Complex :=
    jointSchwartzModulatedAnnularProfile B vartheta rho
  let q : SchwartzMap JointWaveSpaceTime Complex :=
    jointSchwartzSpatialNormalCutoff u beta rho
  let P : SchwartzMap JointWaveSpaceTime Complex :=
    jointSchwartzSpectralCutoffProduct q (FourierTransform.fourierInv F)
  have hsplit : FourierTransform.fourierInv F =
      FourierTransform.fourierInv P + FourierTransform.fourierInv (F - P) := by
    rw [← FourierTransform.fourierInv_add]
    congr 1
    dsimp [P]
    abel
  rw [← aux_temporalSchwartzAnnularNormalUnprojected_eq_halfWave B vartheta rho hrho]
  funext z
  change (FourierTransform.fourierInv F : SchwartzMap JointWaveSpaceTime Complex)
      (WithLp.toLp 2 z) =
    (FourierTransform.fourierInv P : SchwartzMap JointWaveSpaceTime Complex)
      (WithLp.toLp 2 z) +
      (FourierTransform.fourierInv (F - P) : SchwartzMap JointWaveSpaceTime Complex)
        (WithLp.toLp 2 z)
  rw [hsplit]
  rfl

/-- A supplied Schwartz radial Fourier profile turns a regular compact-time
half-wave amplitude into the literal raw `angularPiece`/`radialPiece` model.
All regularity is displayed in the supplied `R` and `B` equalities. -/
theorem temporalSchwartzHalfWave_eq_angularPiece_of_schwartzRadialProfile
    (B R f : SchwartzMap (Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (scale : Real) (a chi : Euclidean 2 → Complex) (radialCutoff : Real → Complex)
    (n : Int)
    (hR : ∀ xi : Euclidean 2,
      R xi = radialCutoff ((Real.sqrt scale)⁻¹ * ‖xi‖ - n))
    (hB : ∀ xi : Euclidean 2, B xi =
      chi xi * a (scale⁻¹ • xi) *
        (R xi * FourierTransform.fourier (f : Euclidean 2 → Complex) xi)) :
    (fun z : WaveSpaceTime =>
      vartheta z.2 * FourierTransform.fourierInv
        (fun xi : Euclidean 2 =>
          B xi * halfWaveMultiplier WaveSign.plus z.2 xi) z.1) =
      angularPiece scale a chi (vartheta : Real → Complex)
        (radialPiece radialCutoff scale n (f : Euclidean 2 → Complex)) := by
  funext z
  unfold angularPiece
  apply congrArg (fun q : Euclidean 2 → Complex =>
    vartheta z.2 * FourierTransform.fourierInv q z.1)
  funext xi
  rw [fourier_radialPiece_eq_schwartzProfile_mul_fourier
    radialCutoff scale n R f hR xi]
  rw [hB xi]
  ring

/-- With norm agreement on the supplied amplitude support, the same regular
angular/radial model has the literal normal-projection-plus-tail
decomposition. -/
theorem angularPiece_eq_projection_add_normalTail_of_schwartzRadialProfile
    (B R f u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (scale : Real) (a chi : Euclidean 2 → Complex) (radialCutoff : Real → Complex)
    (n : Int)
    (hR : ∀ xi : Euclidean 2,
      R xi = radialCutoff ((Real.sqrt scale)⁻¹ * ‖xi‖ - n))
    (hB : ∀ xi : Euclidean 2, B xi =
      chi xi * a (scale⁻¹ • xi) *
        (R xi * FourierTransform.fourier (f : Euclidean 2 → Complex) xi))
    (hrho : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), rho xi = ‖xi‖) :
    angularPiece scale a chi (vartheta : Real → Complex)
        (radialPiece radialCutoff scale n (f : Euclidean 2 → Complex)) =
      temporalSchwartzAnnularNormalProjection B u vartheta beta rho +
        temporalSchwartzAnnularNormalTail B u vartheta beta rho := by
  rw [← temporalSchwartzHalfWave_eq_angularPiece_of_schwartzRadialProfile
    B R f vartheta scale a chi radialCutoff n hR hB]
  exact temporalSchwartzHalfWave_eq_projection_add_normalTail
    B u vartheta beta rho hrho

/-- Exact Fourier formula for the normal tail.  The leading factor records
precisely the part discarded by the supplied spatial/normal Schwartz cutoff. -/
theorem spaceTimeFourier_temporalSchwartzAnnularNormalTail
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (zeta : WaveSpaceTime) :
    spaceTimeFourier
        (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta =
      (1 - u zeta.1 * beta (zeta.2 - rho zeta.1)) *
        (B zeta.1 * FourierTransform.fourier
          (vartheta : Real → Complex) (zeta.2 - rho zeta.1)) := by
  unfold temporalSchwartzAnnularNormalTail
  rw [spaceTimeFourier_jointSchwartzRaw]
  change FourierTransform.fourier
      (FourierTransform.fourierInv
        (jointSchwartzModulatedAnnularProfile B vartheta rho -
          jointSchwartzSpectralCutoffProduct
            (jointSchwartzSpatialNormalCutoff u beta rho)
            (FourierTransform.fourierInv
              (jointSchwartzModulatedAnnularProfile B vartheta rho))) :
          JointWaveSpaceTime → Complex)
      (WithLp.toLp 2 zeta) = _
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  rw [sub_apply]
  rw [jointSchwartzSpectralCutoffProduct,
    SchwartzMap.smulLeftCLM_apply_apply
      (jointSchwartzSpatialNormalCutoff u beta rho).hasTemperateGrowth]
  rw [FourierTransform.fourier_fourierInv_eq,
    jointSchwartzSpatialNormalCutoff_apply,
    jointSchwartzModulatedAnnularProfile_apply]
  ring

private theorem aux_spaceTimeFourier_temporalSchwartzAnnularNormalTail_eq_zero
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hu : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), u xi = 1)
    (zeta : WaveSpaceTime)
    (hbeta : beta (zeta.2 - rho zeta.1) = 1) :
    spaceTimeFourier
        (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta = 0 := by
  rw [spaceTimeFourier_temporalSchwartzAnnularNormalTail]
  by_cases hB : B zeta.1 = 0
  · simp [hB]
  · rw [hu zeta.1 hB, hbeta]
    ring

/-- The tail spectrum can occur only on the supplied annular profile support
and where the supplied normal cutoff is not one.  This is not a plate-support
claim for the unprojected temporal-Schwartz half-wave. -/
theorem support_spaceTimeFourier_temporalSchwartzAnnularNormalTail
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hu : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), u xi = 1) :
    Function.support
        (spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) ⊆
      {zeta | zeta.1 ∈ Function.support (B : Euclidean 2 → Complex) ∧
        beta (zeta.2 - rho zeta.1) ≠ 1} := by
  intro zeta hzeta
  change spaceTimeFourier
      (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta ≠ 0 at hzeta
  constructor
  · intro hB
    apply hzeta
    rw [spaceTimeFourier_temporalSchwartzAnnularNormalTail]
    simp [hB]
  · intro hbeta
    exact hzeta
      (aux_spaceTimeFourier_temporalSchwartzAnnularNormalTail_eq_zero
        B u vartheta beta rho hu zeta hbeta)

private theorem aux_exists_fourier_vartheta_rapid
    (vartheta : SchwartzMap Real Complex) (N : Nat) :
    ∃ D : Real, 0 ≤ D ∧ ∀ s : Real,
      (1 + |s|) ^ N * ‖FourierTransform.fourier (vartheta : Real → Complex) s‖ ≤ D := by
  let h : SchwartzMap Real Complex := 𝓕 vartheta
  let A : Real := 2 ^ N * ((Finset.Iic (N, 0)).sup fun q =>
    SchwartzMap.seminorm Complex q.1 q.2) h
  let D : Real := |A|
  refine ⟨D, ?_, ?_⟩
  · exact abs_nonneg _
  · intro s
    have hs := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := Complex)
      (m := (N, 0)) (k := N) (n := 0) (le_refl N) (le_refl 0) h s
    change (1 + |s|) ^ N * ‖FourierTransform.fourier (vartheta : Real → Complex) s‖ ≤ D
    simpa only [D, A, h, Real.norm_eq_abs, norm_iteratedFDeriv_zero,
      SchwartzMap.fourier_coe] using hs.trans (le_abs_self _)

/-- The literal temporal-Schwartz normal tail has arbitrary pointwise rapid
Fourier decay in its normal coordinate whenever the spatial cutoff is one on
the supplied amplitude support.  This is a Fourier-side estimate only. -/
theorem exists_nonneg_one_add_normal_pow_mul_norm_spaceTimeFourier_temporalSchwartzAnnularNormalTail_le_of_eq_one_on_support
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hu : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), u xi = 1)
    (N : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ zeta : WaveSpaceTime,
      (1 + |zeta.2 - rho zeta.1|) ^ N *
        ‖spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta‖ ≤ C := by
  obtain ⟨D, hDnonneg, hD⟩ := aux_exists_fourier_vartheta_rapid vartheta N
  let B0 : Real := SchwartzMap.seminorm Complex 0 0 B
  let beta0 : Real := SchwartzMap.seminorm Complex 0 0 beta
  have hB0nonneg : 0 ≤ B0 := by
    exact (norm_nonneg (B 0)).trans
      (SchwartzMap.norm_le_seminorm Complex B 0)
  have hbeta0nonneg : 0 ≤ beta0 := by
    exact (norm_nonneg (beta 0)).trans
      (SchwartzMap.norm_le_seminorm Complex beta 0)
  refine ⟨B0 * (1 + beta0) * D, ?_, ?_⟩
  · exact mul_nonneg (mul_nonneg hB0nonneg (add_nonneg zero_le_one hbeta0nonneg)) hDnonneg
  · intro zeta
    let s : Real := zeta.2 - rho zeta.1
    have hB : ‖B zeta.1‖ ≤ B0 := by
      exact SchwartzMap.norm_le_seminorm Complex B zeta.1
    have hbeta : ‖beta s‖ ≤ beta0 := by
      exact SchwartzMap.norm_le_seminorm Complex beta s
    have hcut : ‖(1 : Complex) - beta s‖ ≤ 1 + beta0 := by
      calc
        ‖(1 : Complex) - beta s‖ ≤ ‖(1 : Complex)‖ + ‖beta s‖ := norm_sub_le _ _
        _ = 1 + ‖beta s‖ := by rw [norm_one]
        _ ≤ 1 + beta0 := by gcongr
    have hnormal : (1 + |s|) ^ N *
        ‖FourierTransform.fourier (vartheta : Real → Complex) s‖ ≤ D := hD s
    rw [spaceTimeFourier_temporalSchwartzAnnularNormalTail]
    by_cases hBzero : B zeta.1 = 0
    · simpa [hBzero] using
        (mul_nonneg (mul_nonneg hB0nonneg (add_nonneg zero_le_one hbeta0nonneg)) hDnonneg)
    · rw [hu zeta.1 hBzero]
      have hmain : (1 + |s|) ^ N *
          ‖((1 : Complex) - beta s) *
            (B zeta.1 * FourierTransform.fourier (vartheta : Real → Complex) s)‖ ≤
          B0 * (1 + beta0) * D := by
        calc
        (1 + |s|) ^ N * ‖((1 : Complex) - beta s) *
            (B zeta.1 * FourierTransform.fourier (vartheta : Real → Complex) s)‖ =
            ‖B zeta.1‖ * ‖(1 : Complex) - beta s‖ *
              ((1 + |s|) ^ N *
                ‖FourierTransform.fourier (vartheta : Real → Complex) s‖) := by
              rw [norm_mul, norm_mul]
              ring
        _ ≤ B0 * (1 + beta0) * D := by
          gcongr
      simpa only [s, one_mul] using hmain

/-- If the supplied normal cutoff is one on the normal ball of radius `R`,
the same literal tail has arbitrary pointwise Fourier decay in `R`.  This is
still only a pointwise spectral statement. -/
theorem exists_nonneg_one_add_normal_pow_mul_norm_spaceTimeFourier_temporalSchwartzAnnularNormalTail_le_of_eq_one_on_support_of_eq_one_on_normal_ball
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hu : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), u xi = 1)
    {R : Real} (hR : 0 ≤ R)
    (hbeta : ∀ s : Real, |s| ≤ R → beta s = 1)
    (N : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ zeta : WaveSpaceTime,
      (1 + R) ^ N *
        ‖spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta‖ ≤ C := by
  obtain ⟨C, hCnonneg, hC⟩ :=
    exists_nonneg_one_add_normal_pow_mul_norm_spaceTimeFourier_temporalSchwartzAnnularNormalTail_le_of_eq_one_on_support
      B u vartheta beta rho hu N
  refine ⟨C, hCnonneg, ?_⟩
  intro zeta
  by_cases hs : |zeta.2 - rho zeta.1| ≤ R
  · have htailzero :
        spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta = 0 := by
      rw [spaceTimeFourier_temporalSchwartzAnnularNormalTail]
      by_cases hBzero : B zeta.1 = 0
      · simp [hBzero]
      · rw [hu zeta.1 hBzero, hbeta _ hs]
        ring
    simpa [htailzero] using hCnonneg
  · have hRle : R ≤ |zeta.2 - rho zeta.1| := by
      exact le_of_not_ge hs
    have hweight : (1 + R) ^ N ≤
        (1 + |zeta.2 - rho zeta.1|) ^ N := by
      gcongr
    calc
      (1 + R) ^ N *
          ‖spaceTimeFourier
            (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta‖ ≤
          (1 + |zeta.2 - rho zeta.1|) ^ N *
            ‖spaceTimeFourier
              (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta‖ :=
        mul_le_mul_of_nonneg_right hweight (norm_nonneg _)
      _ ≤ C := hC zeta

private theorem aux_normalShear_measurePreserving
    (rho : SchwartzMap (SurfaceCore.Euclidean 2) Real) :
    MeasurePreserving
      (fun z : WaveSpaceTime => (z.1, z.2 - rho z.1)) volume volume := by
  rw [Measure.volume_eq_prod]
  refine (MeasurePreserving.id (volume : Measure (SurfaceCore.Euclidean 2))).skew_product
    (g := fun xi (t : Real) => t - rho xi) ?_ ?_
  · exact measurable_snd.sub (rho.continuous.measurable.comp measurable_fst)
  · filter_upwards with xi
    simpa only [sub_eq_add_neg] using
      (measurePreserving_add_right (volume : Measure Real) (-rho xi)).map_eq

private theorem aux_jointSchwartzRaw_precompRadialShear_eq_comp_normalShear
    (rho : SchwartzMap (SurfaceCore.Euclidean 2) Real)
    (Q : SchwartzMap JointWaveSpaceTime Complex) :
    jointSchwartzRaw (jointSchwartzPrecompRadialShear rho Q) =
      (jointSchwartzRaw Q) ∘
        (fun z : WaveSpaceTime => (z.1, z.2 - rho z.1)) := by
  funext z
  change (jointSchwartzPrecompRadialShear rho Q) (WithLp.toLp 2 z) =
    Q (WithLp.toLp 2 (z.1, z.2 - rho z.1))
  exact jointSchwartzPrecompRadialShear_apply rho Q z

private noncomputable def aux_normalTailWeightedTemporalProfile
    (vartheta : SchwartzMap Real Complex) (N : Nat) :
    SchwartzMap Real Complex :=
  SchwartzMap.smulLeftCLM Complex
    (fun s : Real => (1 + s ^ 2) ^ N)
    (FourierTransform.fourier vartheta)

private theorem aux_normalTailWeightedTemporalProfile_apply
    (vartheta : SchwartzMap Real Complex) (N : Nat) (s : Real) :
    aux_normalTailWeightedTemporalProfile vartheta N s =
      ((1 + s ^ 2) ^ N : Real) •
        FourierTransform.fourier (vartheta : Real → Complex) s := by
  unfold aux_normalTailWeightedTemporalProfile
  rw [SchwartzMap.smulLeftCLM_apply
    (show (fun s : Real => (1 + s ^ 2) ^ N).HasTemperateGrowth by fun_prop)]
  simp only [SchwartzMap.fourier_coe]

private theorem aux_one_add_abs_pow_le_two_pow_mul_one_add_sq_pow
    (s : Real) (N : Nat) :
    (1 + |s|) ^ N ≤ (2 : Real) ^ N * (1 + s ^ 2) ^ N := by
  have habs : |s| ≤ 1 + s ^ 2 := by
    apply abs_le.2
    constructor
    · nlinarith [sq_nonneg (s + 1 / 2)]
    · nlinarith [sq_nonneg (s - 1 / 2)]
  have hbase : 1 + |s| ≤ 2 * (1 + s ^ 2) := by
    nlinarith
  calc
    (1 + |s|) ^ N ≤ (2 * (1 + s ^ 2)) ^ N := by
      exact pow_le_pow_left₀ (by positivity) hbase N
    _ = (2 : Real) ^ N * (1 + s ^ 2) ^ N := by
      rw [mul_pow]

private theorem aux_normalTail_weighted_fourier_le_sheared_envelope
    (B u : SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (SurfaceCore.Euclidean 2) Real)
    (N : Nat) {M R : Real}
    (hu : ∀ xi ∈ Function.support (B : SurfaceCore.Euclidean 2 → Complex), u xi = 1)
    (hM : 0 ≤ M) (hR : 0 ≤ R)
    (hbeta : ∀ s : Real, |s| ≤ R → beta s = 1)
    (hdefect : ∀ s : Real, ‖(1 : Complex) - beta s‖ ≤ M)
    (zeta : WaveSpaceTime) :
    (1 + R) ^ N *
        ‖spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta‖ ≤
      (M * (2 : Real) ^ N) *
        ‖jointSchwartzRaw
          (jointSchwartzPrecompRadialShear rho
            (jointSchwartzExternalProduct B
              (aux_normalTailWeightedTemporalProfile vartheta N))) zeta‖ := by
  let s : Real := zeta.2 - rho zeta.1
  let Q : SchwartzMap JointWaveSpaceTime Complex :=
    jointSchwartzExternalProduct B (aux_normalTailWeightedTemporalProfile vartheta N)
  let G : SchwartzMap JointWaveSpaceTime Complex :=
    jointSchwartzPrecompRadialShear rho Q
  have hGnorm : ‖jointSchwartzRaw G zeta‖ =
      (1 + s ^ 2) ^ N *
        ‖B zeta.1 * FourierTransform.fourier (vartheta : Real → Complex) s‖ := by
    change ‖G (WithLp.toLp 2 zeta)‖ = _
    dsimp only [G]
    rw [jointSchwartzPrecompRadialShear_apply]
    dsimp only [Q]
    rw [jointSchwartzExternalProduct_apply]
    rw [aux_normalTailWeightedTemporalProfile_apply]
    rw [norm_mul, norm_smul, Real.norm_eq_abs,
      abs_of_nonneg (pow_nonneg (by positivity) _), norm_mul]
    ring
  change (1 + R) ^ N *
      ‖spaceTimeFourier
        (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta‖ ≤
    (M * (2 : Real) ^ N) * ‖jointSchwartzRaw G zeta‖
  by_cases hs : |s| ≤ R
  · have htailzero :
        spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta = 0 := by
      rw [spaceTimeFourier_temporalSchwartzAnnularNormalTail]
      by_cases hBzero : B zeta.1 = 0
      · simp [hBzero]
      · rw [hu zeta.1 hBzero, hbeta s hs]
        simp
    rw [htailzero]
    have hright : 0 ≤ (M * (2 : Real) ^ N) * ‖jointSchwartzRaw G zeta‖ :=
      mul_nonneg (mul_nonneg hM (pow_nonneg (by norm_num) _)) (norm_nonneg _)
    simpa using hright
  · have hslt : R < |s| := lt_of_not_ge hs
    have hweight : (1 + R) ^ N ≤ (2 : Real) ^ N * (1 + s ^ 2) ^ N := by
      calc
        (1 + R) ^ N ≤ (1 + |s|) ^ N := by
          apply pow_le_pow_left₀
          · linarith
          · linarith
        _ ≤ (2 : Real) ^ N * (1 + s ^ 2) ^ N :=
          aux_one_add_abs_pow_le_two_pow_mul_one_add_sq_pow s N
    have htail :
        ‖spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta‖ ≤
          M * ‖B zeta.1 * FourierTransform.fourier (vartheta : Real → Complex) s‖ := by
      rw [spaceTimeFourier_temporalSchwartzAnnularNormalTail]
      by_cases hBzero : B zeta.1 = 0
      · simp [hBzero]
      · rw [hu zeta.1 hBzero]
        simp only [one_mul]
        rw [norm_mul]
        exact mul_le_mul_of_nonneg_right (hdefect s) (norm_nonneg _)
    calc
      (1 + R) ^ N *
          ‖spaceTimeFourier
            (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta‖ ≤
          (1 + R) ^ N *
            (M * ‖B zeta.1 * FourierTransform.fourier (vartheta : Real → Complex) s‖) :=
        mul_le_mul_of_nonneg_left htail (pow_nonneg (by linarith) _)
      _ = M * ((1 + R) ^ N *
            ‖B zeta.1 * FourierTransform.fourier (vartheta : Real → Complex) s‖) := by
        ring
      _ ≤ M * (((2 : Real) ^ N * (1 + s ^ 2) ^ N) *
            ‖B zeta.1 * FourierTransform.fourier (vartheta : Real → Complex) s‖) := by
        exact mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_right hweight (norm_nonneg _)) hM
      _ = (M * (2 : Real) ^ N) * ‖jointSchwartzRaw G zeta‖ := by
        rw [hGnorm]
        ring

private theorem aux_eLpNorm_jointSchwartzRaw_precompRadialShear_eq
    (rho : SchwartzMap (SurfaceCore.Euclidean 2) Real)
    (Q : SchwartzMap JointWaveSpaceTime Complex) (p : ENNReal) :
    eLpNorm (jointSchwartzRaw (jointSchwartzPrecompRadialShear rho Q)) p volume =
      eLpNorm (jointSchwartzRaw Q) p volume := by
  rw [aux_jointSchwartzRaw_precompRadialShear_eq_comp_normalShear]
  apply eLpNorm_comp_measurePreserving
  · apply Measurable.aestronglyMeasurable
    change Measurable (fun z : WaveSpaceTime => Q (WithLp.toLp 2 z))
    exact Q.continuous.measurable.comp (WithLp.measurable_toLp 2 WaveSpaceTime)
  · exact aux_normalShear_measurePreserving rho

private theorem aux_eLpNorm_jointSchwartzRaw_eq
    (Q : SchwartzMap JointWaveSpaceTime Complex) (p : ENNReal) :
    eLpNorm (jointSchwartzRaw Q) p volume =
      eLpNorm (Q : JointWaveSpaceTime → Complex) p volume := by
  let e : WaveSpaceTime → JointWaveSpaceTime := WithLp.toLp 2
  have hpres : MeasurePreserving e volume volume := by
    simpa only [e] using
      (WithLp.volume_preserving_toLp (SurfaceCore.Euclidean 2) Real)
  change eLpNorm ((Q : JointWaveSpaceTime → Complex) ∘ e) p volume =
    eLpNorm (Q : JointWaveSpaceTime → Complex) p volume
  exact eLpNorm_comp_measurePreserving (Q.memLp p volume).aestronglyMeasurable hpres

private theorem aux_eLpNorm_weighted_normalTail_le_sheared_envelope
    (B u : SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (SurfaceCore.Euclidean 2) Real)
    (N : Nat) {M R : Real}
    (hu : ∀ xi ∈ Function.support (B : SurfaceCore.Euclidean 2 → Complex), u xi = 1)
    (hM : 0 ≤ M) (hR : 0 ≤ R)
    (hbeta : ∀ s : Real, |s| ≤ R → beta s = 1)
    (hdefect : ∀ s : Real, ‖(1 : Complex) - beta s‖ ≤ M) :
    ENNReal.ofReal ((1 + R) ^ N) *
        eLpNorm (temporalSchwartzAnnularNormalTail B u vartheta beta rho) 2 volume ≤
      ENNReal.ofReal (M * (2 : Real) ^ N) *
        eLpNorm (jointSchwartzRaw
          (jointSchwartzPrecompRadialShear rho
            (jointSchwartzExternalProduct B
              (aux_normalTailWeightedTemporalProfile vartheta N)))) 2 volume := by
  let Q : SchwartzMap JointWaveSpaceTime Complex :=
    jointSchwartzExternalProduct B (aux_normalTailWeightedTemporalProfile vartheta N)
  let G : SchwartzMap JointWaveSpaceTime Complex :=
    jointSchwartzPrecompRadialShear rho Q
  let T : Real := (1 + R) ^ N
  let D : Real := M * (2 : Real) ^ N
  have hT : 0 ≤ T := pow_nonneg (by linarith) _
  have hD : 0 ≤ D := mul_nonneg hM (pow_nonneg (by norm_num) _)
  have hpoint (zeta : WaveSpaceTime) :
      T * ‖spaceTimeFourier
        (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta‖ ≤
        D * ‖jointSchwartzRaw G zeta‖ := by
    dsimp only [T, D, G, Q]
    exact aux_normalTail_weighted_fourier_le_sheared_envelope
      B u vartheta beta rho N hu hM hR hbeta hdefect zeta
  have hnorm (zeta : WaveSpaceTime) :
      ‖T • spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta‖ ≤
        ‖D • jointSchwartzRaw G zeta‖ := by
    rw [norm_smul, norm_smul, Real.norm_eq_abs, abs_of_nonneg hT,
      Real.norm_eq_abs, abs_of_nonneg hD]
    exact hpoint zeta
  have hEL :
      eLpNorm (T • spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) 2 volume ≤
        eLpNorm (D • jointSchwartzRaw G) 2 volume :=
    eLpNorm_mono hnorm
  calc
    ENNReal.ofReal ((1 + R) ^ N) *
        eLpNorm (temporalSchwartzAnnularNormalTail B u vartheta beta rho) 2 volume =
        eLpNorm (T • spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) 2 volume := by
      dsimp only [T]
      rw [eLpNorm_const_smul, Real.enorm_eq_ofReal hT,
        eLpNorm_spaceTimeFourier_temporalSchwartzAnnularNormalTail_two_eq]
    _ ≤ eLpNorm (D • jointSchwartzRaw G) 2 volume := hEL
    _ = ENNReal.ofReal (M * (2 : Real) ^ N) *
        eLpNorm (jointSchwartzRaw G) 2 volume := by
      dsimp only [D]
      rw [eLpNorm_const_smul, Real.enorm_eq_ofReal hD]

/-- A uniform bounded normal-cutoff defect and normal-ball agreement give an
arbitrarily rapid global L2 normal-tail bound for the supplied regular
Schwartz model. The constant is chosen before the cutoff, shear, and radius;
this is not a statement about raw compact-time packets or plate support. -/
theorem exists_finite_uniform_one_add_normal_radius_pow_mul_eLpNorm_two_temporalSchwartzAnnularNormalTail
    (B : SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (N : Nat) (M : Real) (hM : 0 ≤ M) :
    ∃ C : ENNReal, C < ∞ ∧ ∀
      (u : SchwartzMap (SurfaceCore.Euclidean 2) Complex)
      (beta : SchwartzMap Real Complex)
      (rho : SchwartzMap (SurfaceCore.Euclidean 2) Real) {R : Real},
      (∀ xi ∈ Function.support (B : SurfaceCore.Euclidean 2 → Complex), u xi = 1) →
      0 ≤ R →
      (∀ s : Real, |s| ≤ R → beta s = 1) →
      (∀ s : Real, ‖(1 : Complex) - beta s‖ ≤ M) →
      ENNReal.ofReal ((1 + R) ^ N) *
        eLpNorm (temporalSchwartzAnnularNormalTail B u vartheta beta rho) 2 volume ≤ C := by
  let Q : SchwartzMap JointWaveSpaceTime Complex :=
    jointSchwartzExternalProduct B (aux_normalTailWeightedTemporalProfile vartheta N)
  let C : ENNReal := ENNReal.ofReal (M * (2 : Real) ^ N) *
    eLpNorm (jointSchwartzRaw Q) 2 volume
  have hQtop : eLpNorm (jointSchwartzRaw Q) 2 volume < ∞ := by
    rw [aux_eLpNorm_jointSchwartzRaw_eq Q 2]
    exact lt_top_iff_ne_top.mpr (Q.memLp 2 volume).eLpNorm_ne_top
  refine ⟨C, ?_, ?_⟩
  · dsimp only [C]
    exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top hQtop
  · intro u beta rho R hu hR hbeta hdefect
    have hbound := aux_eLpNorm_weighted_normalTail_le_sheared_envelope
      B u vartheta beta rho N hu hM hR hbeta hdefect
    rw [aux_eLpNorm_jointSchwartzRaw_precompRadialShear_eq rho Q 2] at hbound
    exact hbound

private theorem aux_norm_fourierInv_apply_le_toLp_one
    (P : SchwartzMap JointWaveSpaceTime Complex) (w : JointWaveSpaceTime) :
    ‖FourierTransform.fourierInv (P : JointWaveSpaceTime → Complex) w‖ ≤
      ‖P.toLp 1 volume‖ := by
  rw [← SchwartzMap.fourierInv_coe]
  rw [SchwartzMap.fourierInv_apply_eq]
  change ‖(FourierTransform.fourier P) (-w)‖ ≤ ‖P.toLp 1 volume‖
  exact SchwartzMap.norm_fourier_apply_le_toLp_one P (-w)

private theorem aux_aestronglyMeasurable_jointSchwartzRaw
    (P : SchwartzMap JointWaveSpaceTime Complex) :
    AEStronglyMeasurable (jointSchwartzRaw P) volume := by
  have htoLp : Continuous (WithLp.toLp 2 : WaveSpaceTime → JointWaveSpaceTime) :=
    WithLp.prod_continuous_toLp 2 _ _
  change AEStronglyMeasurable (fun z : WaveSpaceTime => P (WithLp.toLp 2 z)) volume
  exact (P.continuous.comp htoLp).aestronglyMeasurable

private theorem aux_eLpNorm_top_jointSchwartzRaw_fourierInv_le
    (P : SchwartzMap JointWaveSpaceTime Complex) :
    eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) ⊤ volume ≤
      ENNReal.ofReal ‖P.toLp 1 volume‖ := by
  rw [eLpNorm_exponent_top]
  apply eLpNormEssSup_le_of_ae_bound
  filter_upwards with z
  change ‖(FourierTransform.fourierInv P : SchwartzMap JointWaveSpaceTime Complex)
    (WithLp.toLp 2 z)‖ ≤ ‖P.toLp 1 volume‖
  rw [SchwartzMap.fourierInv_coe]
  exact aux_norm_fourierInv_apply_le_toLp_one P _

private theorem aux_eLpNorm_four_rpow_two_jointSchwartzRaw_fourierInv_le
    (P : SchwartzMap JointWaveSpaceTime Complex) :
    (eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) 4 volume) ^ (2 : Real) ≤
      eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) 2 volume *
        ENNReal.ofReal ‖P.toLp 1 volume‖ := by
  calc
    (eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) 4 volume) ^ (2 : Real) ≤
        eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) 2 volume *
          eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) ⊤ volume :=
      Codex.Spherical.LpSpaceFacts.eLpNorm_four_rpow_two_le_two_mul_top _
        (aux_aestronglyMeasurable_jointSchwartzRaw _)
    _ ≤ eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) 2 volume *
          ENNReal.ofReal ‖P.toLp 1 volume‖ := by
        simpa only [mul_comm] using
          mul_le_mul_left (aux_eLpNorm_top_jointSchwartzRaw_fourierInv_le P)
            (eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) 2 volume)

private theorem aux_weighted_eLpNorm_four_sq_jointSchwartzRaw_fourierInv_le
    (P : SchwartzMap JointWaveSpaceTime Complex)
    (R : Real) (N : Nat) (A : ENNReal)
    (hA : (ENNReal.ofReal (1 + R)) ^ (2 * N) *
        eLpNorm (spaceTimeFourier
          (jointSchwartzRaw (FourierTransform.fourierInv P))) 2 volume ≤ A) :
    ((ENNReal.ofReal (1 + R)) ^ N *
        eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) 4 volume) ^ 2 ≤
      A * ENNReal.ofReal ‖P.toLp 1 volume‖ := by
  have hplain := aux_eLpNorm_four_rpow_two_jointSchwartzRaw_fourierInv_le P
  have hfour :
      (eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) 4 volume) ^ 2 ≤
        eLpNorm (spaceTimeFourier
          (jointSchwartzRaw (FourierTransform.fourierInv P))) 2 volume *
          ENNReal.ofReal ‖P.toLp 1 volume‖ := by
    rw [← eLpNorm_spaceTimeFourier_jointSchwartzRaw_two_eq
      (FourierTransform.fourierInv P)] at hplain
    simpa only [ENNReal.rpow_two] using hplain
  calc
    ((ENNReal.ofReal (1 + R)) ^ N *
        eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) 4 volume) ^ 2 =
        (ENNReal.ofReal (1 + R)) ^ (2 * N) *
          (eLpNorm (jointSchwartzRaw (FourierTransform.fourierInv P)) 4 volume) ^ 2 := by
      rw [mul_pow]
      congr 1
      simpa only [pow_mul, Nat.mul_comm]
    _ ≤ (ENNReal.ofReal (1 + R)) ^ (2 * N) *
          (eLpNorm (spaceTimeFourier
            (jointSchwartzRaw (FourierTransform.fourierInv P))) 2 volume *
            ENNReal.ofReal ‖P.toLp 1 volume‖) := by
      gcongr
    _ = ((ENNReal.ofReal (1 + R)) ^ (2 * N) *
          eLpNorm (spaceTimeFourier
            (jointSchwartzRaw (FourierTransform.fourierInv P))) 2 volume) *
          ENNReal.ofReal ‖P.toLp 1 volume‖ := by
      ring
    _ ≤ A * ENNReal.ofReal ‖P.toLp 1 volume‖ := by
      exact mul_le_mul_left hA _

private noncomputable def aux_temporalSchwartzAnnularNormalTailSpectrum
    (B u : SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (SurfaceCore.Euclidean 2) Real) :
    SchwartzMap JointWaveSpaceTime Complex :=
  jointSchwartzModulatedAnnularProfile B vartheta rho -
    jointSchwartzSpectralCutoffProduct
      (jointSchwartzSpatialNormalCutoff u beta rho)
      (FourierTransform.fourierInv
        (jointSchwartzModulatedAnnularProfile B vartheta rho))

private theorem aux_temporalSchwartzAnnularNormalTailSpectrum_apply_toLp_eq
    (B u : SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (SurfaceCore.Euclidean 2) Real)
    (z : WaveSpaceTime) :
    aux_temporalSchwartzAnnularNormalTailSpectrum B u vartheta beta rho
        (WithLp.toLp 2 z) =
      spaceTimeFourier
        (temporalSchwartzAnnularNormalTail B u vartheta beta rho) z := by
  rw [temporalSchwartzAnnularNormalTail,
    spaceTimeFourier_jointSchwartzRaw]
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  rfl

private theorem aux_weighted_eLpNorm_four_sq_temporalSchwartzAnnularNormalTail_le
    (B u : SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (SurfaceCore.Euclidean 2) Real)
    (R : Real) (N : Nat) (A : ENNReal)
    (hA : (ENNReal.ofReal (1 + R)) ^ (2 * N) *
        eLpNorm (spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) 2 volume ≤ A) :
    ((ENNReal.ofReal (1 + R)) ^ N *
        eLpNorm (temporalSchwartzAnnularNormalTail B u vartheta beta rho) 4 volume) ^ 2 ≤
      A * ENNReal.ofReal
        ‖(aux_temporalSchwartzAnnularNormalTailSpectrum B u vartheta beta rho).toLp
          1 volume‖ := by
  simpa only [temporalSchwartzAnnularNormalTail,
    aux_temporalSchwartzAnnularNormalTailSpectrum] using
    aux_weighted_eLpNorm_four_sq_jointSchwartzRaw_fourierInv_le
      (aux_temporalSchwartzAnnularNormalTailSpectrum B u vartheta beta rho) R N A hA

private theorem aux_enorm_toLp_one_tailSpectrum_eq_fourierTail
    (B u : SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (SurfaceCore.Euclidean 2) Real) :
    ENNReal.ofReal
        ‖(aux_temporalSchwartzAnnularNormalTailSpectrum B u vartheta beta rho).toLp
            1 volume‖ =
      eLpNorm
        (spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) 1 volume := by
  let P := aux_temporalSchwartzAnnularNormalTailSpectrum B u vartheta beta rho
  calc
    ENNReal.ofReal ‖P.toLp 1 volume‖ = ‖P.toLp 1 volume‖ₑ := by
      rw [ofReal_norm]
    _ = eLpNorm (P : JointWaveSpaceTime → Complex) 1 volume :=
      Lp.enorm_toLp (P.memLp 1 volume)
    _ = eLpNorm (jointSchwartzRaw P) 1 volume :=
      (aux_eLpNorm_jointSchwartzRaw_eq P 1).symm
    _ = eLpNorm
        (spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) 1 volume := by
      apply eLpNorm_congr_ae
      filter_upwards with z
      change P (WithLp.toLp 2 z) = _
      exact aux_temporalSchwartzAnnularNormalTailSpectrum_apply_toLp_eq
        B u vartheta beta rho z

private theorem aux_tailFourier_norm_le_smul_profile
    (B u : SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (SurfaceCore.Euclidean 2) Real)
    (M : Real)
    (hM : 0 ≤ M)
    (hu : ∀ xi ∈ Function.support (B : SurfaceCore.Euclidean 2 → Complex), u xi = 1)
    (hbeta : ∀ s : Real, ‖(1 : Complex) - beta s‖ ≤ M)
    (zeta : WaveSpaceTime) :
    ‖spaceTimeFourier
        (temporalSchwartzAnnularNormalTail B u vartheta beta rho) zeta‖ ≤
      ‖(M : Complex) •
        jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho) zeta‖ := by
  rw [spaceTimeFourier_temporalSchwartzAnnularNormalTail]
  change ‖(1 - u zeta.1 * beta (zeta.2 - rho zeta.1)) *
      (B zeta.1 * FourierTransform.fourier
        (vartheta : Real → Complex) (zeta.2 - rho zeta.1))‖ ≤
    ‖(M : Complex) •
      jointSchwartzModulatedAnnularProfile B vartheta rho (WithLp.toLp 2 zeta)‖
  rw [jointSchwartzModulatedAnnularProfile_apply]
  rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hM]
  by_cases hB : B zeta.1 = 0
  · simp [hB]
  · rw [hu zeta.1 hB]
    simp only [one_mul]
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (hbeta _) (norm_nonneg _)

private theorem aux_eLpNorm_one_spaceTimeFourier_temporalSchwartzAnnularNormalTail_le_external
    (B u : SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (SurfaceCore.Euclidean 2) Real)
    (M : Real)
    (hM : 0 ≤ M)
    (hu : ∀ xi ∈ Function.support (B : SurfaceCore.Euclidean 2 → Complex), u xi = 1)
    (hbeta : ∀ s : Real, ‖(1 : Complex) - beta s‖ ≤ M) :
    eLpNorm
        (spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) 1 volume ≤
      ENNReal.ofReal M *
        eLpNorm
          (jointSchwartzRaw
            (jointSchwartzExternalProduct B (FourierTransform.fourier vartheta)))
          1 volume := by
  have htransport :
      eLpNorm (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho))
          1 volume =
        eLpNorm
          (jointSchwartzRaw
            (jointSchwartzExternalProduct B (FourierTransform.fourier vartheta)))
          1 volume := by
    change eLpNorm
        (jointSchwartzRaw
          (jointSchwartzPrecompRadialShear rho
            (jointSchwartzExternalProduct B (FourierTransform.fourier vartheta))))
          1 volume = _
    exact aux_eLpNorm_jointSchwartzRaw_precompRadialShear_eq rho
      (jointSchwartzExternalProduct B (FourierTransform.fourier vartheta)) 1
  calc
    eLpNorm
        (spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) 1 volume ≤
        eLpNorm
          ((M : Complex) •
            jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho))
          1 volume :=
      eLpNorm_mono
        (aux_tailFourier_norm_le_smul_profile B u vartheta beta rho M hM hu hbeta)
    _ = ‖(M : Complex)‖ₑ *
          eLpNorm (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho))
            1 volume :=
      eLpNorm_const_smul (M : Complex)
        (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho)) 1 volume
    _ = ENNReal.ofReal M *
          eLpNorm (jointSchwartzRaw (jointSchwartzModulatedAnnularProfile B vartheta rho))
            1 volume := by
      congr 1
      simp [← ofReal_norm, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hM]
    _ = ENNReal.ofReal M *
          eLpNorm
            (jointSchwartzRaw
              (jointSchwartzExternalProduct B (FourierTransform.fourier vartheta)))
            1 volume := by
      rw [htransport]

private theorem aux_weighted_eLpNorm_four_sq_temporalSchwartzAnnularNormalTail_le_of_L2_L1
    (B u : SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (SurfaceCore.Euclidean 2) Real)
    (R : Real) (N : Nat) (A L : ENNReal)
    (hA : (ENNReal.ofReal (1 + R)) ^ (2 * N) *
        eLpNorm (temporalSchwartzAnnularNormalTail B u vartheta beta rho) 2 volume ≤ A)
    (hL : eLpNorm
        (spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) 1 volume ≤ L) :
    ((ENNReal.ofReal (1 + R)) ^ N *
        eLpNorm (temporalSchwartzAnnularNormalTail B u vartheta beta rho) 4 volume) ^ 2 ≤
      A * L := by
  have hA' : (ENNReal.ofReal (1 + R)) ^ (2 * N) *
      eLpNorm
        (spaceTimeFourier
          (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) 2 volume ≤ A := by
    rw [eLpNorm_spaceTimeFourier_temporalSchwartzAnnularNormalTail_two_eq]
    exact hA
  have hinterp :=
    aux_weighted_eLpNorm_four_sq_temporalSchwartzAnnularNormalTail_le
      B u vartheta beta rho R N A hA'
  rw [aux_enorm_toLp_one_tailSpectrum_eq_fourierTail B u vartheta beta rho] at hinterp
  exact hinterp.trans (by simpa only [mul_comm] using mul_le_mul_left hL A)

/-- A bounded normal-cutoff defect and normal-ball agreement give an
arbitrarily rapid uniform squared L4 envelope for the supplied regular
joint-Schwartz normal-tail model. This has no raw-packet or local-smoothing
content. -/
theorem exists_finite_uniform_one_add_normal_radius_pow_mul_eLpNorm_four_sq_temporalSchwartzAnnularNormalTail
    (B : SchwartzMap (SurfaceCore.Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (N : Nat) (M : Real) (hM : 0 ≤ M) :
    ∃ C : ENNReal, C < ∞ ∧ ∀
      (u : SchwartzMap (SurfaceCore.Euclidean 2) Complex)
      (beta : SchwartzMap Real Complex)
      (rho : SchwartzMap (SurfaceCore.Euclidean 2) Real) {R : Real},
      (∀ xi ∈ Function.support (B : SurfaceCore.Euclidean 2 → Complex), u xi = 1) →
      0 ≤ R →
      (∀ s : Real, |s| ≤ R → beta s = 1) →
      (∀ s : Real, ‖(1 : Complex) - beta s‖ ≤ M) →
      ((ENNReal.ofReal (1 + R)) ^ N *
        eLpNorm (temporalSchwartzAnnularNormalTail B u vartheta beta rho) 4 volume) ^ 2 ≤ C := by
  obtain ⟨C₂, hC₂top, hC₂⟩ :=
    exists_finite_uniform_one_add_normal_radius_pow_mul_eLpNorm_two_temporalSchwartzAnnularNormalTail
      B vartheta (2 * N) M hM
  let Q : SchwartzMap JointWaveSpaceTime Complex :=
    jointSchwartzExternalProduct B (FourierTransform.fourier vartheta)
  let C : ENNReal := C₂ *
    (ENNReal.ofReal M * eLpNorm (jointSchwartzRaw Q) 1 volume)
  have hQtop : eLpNorm (jointSchwartzRaw Q) 1 volume < ∞ := by
    rw [aux_eLpNorm_jointSchwartzRaw_eq Q 1]
    exact lt_top_iff_ne_top.mpr (Q.memLp 1 volume).eLpNorm_ne_top
  refine ⟨C, ?_, ?_⟩
  · dsimp only [C]
    exact ENNReal.mul_lt_top hC₂top
      (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hQtop)
  · intro u beta rho R hu hR hball hdefect
    have hOne : 0 ≤ 1 + R := by linarith
    have hA : (ENNReal.ofReal (1 + R)) ^ (2 * N) *
        eLpNorm (temporalSchwartzAnnularNormalTail B u vartheta beta rho) 2 volume ≤ C₂ := by
      rw [← ENNReal.ofReal_pow hOne]
      exact hC₂ u beta rho hu hR hball hdefect
    have hL :
        eLpNorm
            (spaceTimeFourier
              (temporalSchwartzAnnularNormalTail B u vartheta beta rho)) 1 volume ≤
          ENNReal.ofReal M * eLpNorm (jointSchwartzRaw Q) 1 volume := by
      dsimp only [Q]
      exact aux_eLpNorm_one_spaceTimeFourier_temporalSchwartzAnnularNormalTail_le_external
        B u vartheta beta rho M hM hu hdefect
    simpa only [C] using
      aux_weighted_eLpNorm_four_sq_temporalSchwartzAnnularNormalTail_le_of_L2_L1
        B u vartheta beta rho R N C₂
          (ENNReal.ofReal M * eLpNorm (jointSchwartzRaw Q) 1 volume) hA hL

private theorem aux_ennreal_le_one_add_of_sq_le
    {x C : ENNReal} (h : x ^ 2 ≤ C) : x ≤ 1 + C := by
  rcases le_total x 1 with hx | hx
  · exact hx.trans (by simp)
  · calc
      x = x * 1 := (mul_one x).symm
      _ ≤ x * x := by simpa [mul_comm] using mul_le_mul_left hx x
      _ = x ^ 2 := (pow_two x).symm
      _ ≤ C := h
      _ ≤ 1 + C := by simp

private theorem aux_exists_finite_uniform_weighted_normalTail_finset
    (radialIndices angularIndices : Finset Int)
    (B : Int → Int → SchwartzMap (Euclidean 2) Complex)
    (vartheta : Int → Int → SchwartzMap Real Complex)
    (N : Nat) (M : Real) (hM : 0 ≤ M) :
    ∃ D : ENNReal, D < ∞ ∧ ∀
      (u : Int → Int → SchwartzMap (Euclidean 2) Complex)
      (beta : Int → Int → SchwartzMap Real Complex)
      (rho : Int → Int → SchwartzMap (Euclidean 2) Real) {normalRadius : Real},
      (∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
        ∀ xi ∈ Function.support (B n nu : Euclidean 2 → Complex), u n nu xi = 1) →
      0 ≤ normalRadius →
      (∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
        ∀ s : Real, |s| ≤ normalRadius → beta n nu s = 1) →
      (∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
        ∀ s : Real, ‖(1 : Complex) - beta n nu s‖ ≤ M) →
      (ENNReal.ofReal (1 + normalRadius)) ^ N *
        (∑ n ∈ radialIndices, ∑ nu ∈ angularIndices,
          eLpNorm
            (temporalSchwartzAnnularNormalTail
              (B n nu) (u n nu) (vartheta n nu) (beta n nu) (rho n nu)) 4 volume) ≤ D := by
  choose C hCtop hC using fun n nu =>
    exists_finite_uniform_one_add_normal_radius_pow_mul_eLpNorm_four_sq_temporalSchwartzAnnularNormalTail
      (B n nu) (vartheta n nu) N M hM
  let D : ENNReal := ∑ n ∈ radialIndices, ∑ nu ∈ angularIndices, (1 + C n nu)
  refine ⟨D, ?_, ?_⟩
  · dsimp only [D]
    rw [ENNReal.sum_lt_top]
    intro n hn
    rw [ENNReal.sum_lt_top]
    intro nu hnu
    exact ENNReal.add_lt_top.mpr ⟨by simp, hCtop n nu⟩
  · intro u beta rho normalRadius hu hnormalRadius hball hdefect
    dsimp only [D]
    calc
      (ENNReal.ofReal (1 + normalRadius)) ^ N *
          (∑ n ∈ radialIndices, ∑ nu ∈ angularIndices,
            eLpNorm
              (temporalSchwartzAnnularNormalTail
                (B n nu) (u n nu) (vartheta n nu) (beta n nu) (rho n nu)) 4 volume) =
          ∑ n ∈ radialIndices, ∑ nu ∈ angularIndices,
            (ENNReal.ofReal (1 + normalRadius)) ^ N *
              eLpNorm
                (temporalSchwartzAnnularNormalTail
                  (B n nu) (u n nu) (vartheta n nu) (beta n nu) (rho n nu)) 4 volume := by
            simp only [Finset.mul_sum]
      _ ≤ ∑ n ∈ radialIndices, ∑ nu ∈ angularIndices, (1 + C n nu) := by
        apply Finset.sum_le_sum
        intro n hn
        apply Finset.sum_le_sum
        intro nu hnu
        apply aux_ennreal_le_one_add_of_sq_le
        exact hC n nu (u n nu) (beta n nu) (rho n nu)
          (hu n hn nu hnu) hnormalRadius (hball n hn nu hnu)
          (hdefect n hn nu hnu)

/-- A supplied regular angular/radial model is uniformly approximated by its
temporal-Schwartz normal projection, with the squared L4 error controlled by
the literal normal tail. This is a one-packet regular-model statement only. -/
theorem exists_finite_uniform_one_add_normal_radius_pow_mul_eLpNorm_four_sq_angularPiece_sub_projection_of_schwartzRadialProfile
    (B R f : SchwartzMap (Euclidean 2) Complex)
    (vartheta : SchwartzMap Real Complex)
    (scale : Real) (a chi : Euclidean 2 → Complex) (radialCutoff : Real → Complex)
    (n : Int) (N : Nat) (M : Real) (hM : 0 ≤ M)
    (hR : ∀ xi : Euclidean 2,
      R xi = radialCutoff ((Real.sqrt scale)⁻¹ * ‖xi‖ - n))
    (hB : ∀ xi : Euclidean 2, B xi =
      chi xi * a (scale⁻¹ • xi) *
        (R xi * FourierTransform.fourier (f : Euclidean 2 → Complex) xi)) :
    ∃ C : ENNReal, C < ∞ ∧ ∀
      (u : SchwartzMap (Euclidean 2) Complex)
      (beta : SchwartzMap Real Complex)
      (rho : SchwartzMap (Euclidean 2) Real) {normalRadius : Real},
      (∀ xi ∈ Function.support (B : Euclidean 2 → Complex), u xi = 1) →
      (∀ xi ∈ Function.support (B : Euclidean 2 → Complex), rho xi = ‖xi‖) →
      0 ≤ normalRadius →
      (∀ s : Real, |s| ≤ normalRadius → beta s = 1) →
      (∀ s : Real, ‖(1 : Complex) - beta s‖ ≤ M) →
      ((ENNReal.ofReal (1 + normalRadius)) ^ N *
        eLpNorm
          (angularPiece scale a chi (vartheta : Real → Complex)
            (radialPiece radialCutoff scale n (f : Euclidean 2 → Complex)) -
            temporalSchwartzAnnularNormalProjection B u vartheta beta rho)
          4 volume) ^ 2 ≤ C := by
  obtain ⟨C, hCtop, hC⟩ :=
    exists_finite_uniform_one_add_normal_radius_pow_mul_eLpNorm_four_sq_temporalSchwartzAnnularNormalTail
      B vartheta N M hM
  refine ⟨C, hCtop, ?_⟩
  intro u beta rho normalRadius hu hrho hnormalRadius hball hdefect
  have hsplit :=
    angularPiece_eq_projection_add_normalTail_of_schwartzRadialProfile
      B R f u vartheta beta rho scale a chi radialCutoff n hR hB hrho
  have htail :
      angularPiece scale a chi (vartheta : Real → Complex)
          (radialPiece radialCutoff scale n (f : Euclidean 2 → Complex)) -
          temporalSchwartzAnnularNormalProjection B u vartheta beta rho =
        temporalSchwartzAnnularNormalTail B u vartheta beta rho := by
    rw [hsplit]
    abel
  rw [htail]
  exact hC u beta rho hu hnormalRadius hball hdefect

/-- A finite exactly decomposed family is approximated in L4 by its main
terms with the sum of supplied tail bounds. This is finite Minkowski only:
it has no square-function, continuum, or local-smoothing content. -/
theorem eLpNorm_four_finset_sum_sub_le_sum_of_eq_add_of_tail_bounds
    {ι : Type*} (indices : Finset ι)
    (main tail full : ι → WaveSpaceTime → Complex)
    (hdecomp : ∀ i ∈ indices, full i = main i + tail i)
    (htailMeas : ∀ i ∈ indices, AEStronglyMeasurable (tail i) volume)
    (E : ι → ENNReal)
    (hE : ∀ i ∈ indices, eLpNorm (tail i) 4 volume ≤ E i) :
    eLpNorm ((∑ i ∈ indices, full i) - ∑ i ∈ indices, main i) 4 volume ≤
      ∑ i ∈ indices, E i := by
  have hsum : (∑ i ∈ indices, full i) - ∑ i ∈ indices, main i =
      ∑ i ∈ indices, tail i := by
    rw [← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro i hi
    rw [hdecomp i hi]
    simp
  rw [hsum]
  calc
    eLpNorm (∑ i ∈ indices, tail i) 4 volume ≤
        ∑ i ∈ indices, eLpNorm (tail i) 4 volume := by
      apply eLpNorm_sum_le
      · intro i hi
        exact htailMeas i hi
      · norm_num
    _ ≤ ∑ i ∈ indices, E i := by
      apply Finset.sum_le_sum
      intro i hi
      exact hE i hi

/-- The Fourier transform of the projected temporal-Schwartz annular
positive half-wave is exactly its joint spatial/normal cutoff times the
unprojected profile. -/
theorem spaceTimeFourier_temporalSchwartzAnnularNormalProjection
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hrho : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), rho xi = ‖xi‖)
    (zeta : WaveSpaceTime) :
    spaceTimeFourier
        (temporalSchwartzAnnularNormalProjection B u vartheta beta rho) zeta =
      jointSchwartzSpatialNormalCutoff u beta rho (WithLp.toLp 2 zeta) *
        spaceTimeFourier
          (fun z : WaveSpaceTime =>
            vartheta z.2 * FourierTransform.fourierInv
              (fun xi : Euclidean 2 =>
                B xi * halfWaveMultiplier WaveSign.plus z.2 xi) z.1) zeta := by
  unfold temporalSchwartzAnnularNormalProjection
  rw [spaceTimeFourier_jointSchwartzSpectralCutoffOutput]
  change jointSchwartzSpectralCutoffProduct
      (jointSchwartzSpatialNormalCutoff u beta rho)
      (FourierTransform.fourierInv
        (jointSchwartzModulatedAnnularProfile B vartheta rho))
      (WithLp.toLp 2 zeta) = _
  rw [jointSchwartzSpectralCutoffProduct,
    SchwartzMap.smulLeftCLM_apply_apply
      (jointSchwartzSpatialNormalCutoff u beta rho).hasTemperateGrowth]
  rw [FourierTransform.fourier_fourierInv_eq]
  simp only [smul_eq_mul]
  rw [spaceTimeFourier_temporalSchwartzHalfWave_eq_jointSchwartzModulatedAnnularProfile
    B vartheta rho hrho zeta]

/-- The supplied temporal-Schwartz normal projection has the literal joint
Fourier amplitude determined by its spatial and normal profiles.  This remains
joint in `(ξ, τ)` and is not identified with a separable spectral packet. -/
theorem spaceTimeFourier_temporalSchwartzAnnularNormalProjection_eq_jointAmplitude
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hu : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), u xi = 1)
    (xi : Euclidean 2) (tau : Real) :
    spaceTimeFourier
        (temporalSchwartzAnnularNormalProjection B u vartheta beta rho) (xi, tau) =
      B xi *
        (beta (tau - rho xi) *
          FourierTransform.fourier (vartheta : Real → Complex) (tau - rho xi)) := by
  unfold temporalSchwartzAnnularNormalProjection
  rw [spaceTimeFourier_jointSchwartzSpectralCutoffOutput]
  change jointSchwartzSpectralCutoffProduct
      (jointSchwartzSpatialNormalCutoff u beta rho)
      (FourierTransform.fourierInv
        (jointSchwartzModulatedAnnularProfile B vartheta rho))
      (WithLp.toLp 2 (xi, tau)) = _
  rw [jointSchwartzSpectralCutoffProduct,
    SchwartzMap.smulLeftCLM_apply_apply
      (jointSchwartzSpatialNormalCutoff u beta rho).hasTemperateGrowth]
  rw [FourierTransform.fourier_fourierInv_eq]
  rw [jointSchwartzSpatialNormalCutoff_apply,
    jointSchwartzModulatedAnnularProfile_apply]
  by_cases hB : B xi = 0
  · simp [hB]
  · have hxi : xi ∈ Function.support (B : Euclidean 2 → Complex) := hB
    rw [hu xi hxi]
    ring

private def aux_spatialNormalStrip
    (B : Euclidean 2 → Complex) (beta : Real → Complex)
    (rho : Euclidean 2 → Real) : Set WaveSpaceTime :=
  {zeta | zeta.1 ∈ Function.support B ∧
    zeta.2 - rho zeta.1 ∈ Function.support beta}

private theorem aux_jointSchwartzSpatialNormalCutoff_mul_spaceTimeFourier_temporalSchwartzHalfWave
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hrho : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), rho xi = ‖xi‖)
    (hu : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), u xi = 1)
    (zeta : WaveSpaceTime) :
    jointSchwartzSpatialNormalCutoff u beta rho (WithLp.toLp 2 zeta) *
        spaceTimeFourier
          (fun z : WaveSpaceTime =>
            vartheta z.2 * FourierTransform.fourierInv
              (fun xi : Euclidean 2 =>
                B xi * halfWaveMultiplier WaveSign.plus z.2 xi) z.1) zeta =
      B zeta.1 *
        (beta (zeta.2 - rho zeta.1) *
          FourierTransform.fourier (vartheta : Real → Complex)
            (zeta.2 - rho zeta.1)) := by
  rw [spaceTimeFourier_temporalSchwartzHalfWave_eq_jointSchwartzModulatedAnnularProfile
    B vartheta rho hrho zeta,
    jointSchwartzModulatedAnnularProfile_apply,
    jointSchwartzSpatialNormalCutoff_apply]
  by_cases hB : B zeta.1 = 0
  · simp [hB]
  · rw [hu zeta.1 hB]
    ring

private theorem aux_support_spaceTimeFourier_temporalSchwartzAnnularNormalProjection_subset_spatialNormalStrip
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (hrho : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), rho xi = ‖xi‖)
    (hu : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), u xi = 1) :
    Function.support
        (spaceTimeFourier
          (temporalSchwartzAnnularNormalProjection B u vartheta beta rho)) ⊆
      aux_spatialNormalStrip (B : Euclidean 2 → Complex) (beta : Real → Complex)
        (rho : Euclidean 2 → Real) := by
  intro zeta hzeta
  change spaceTimeFourier
      (temporalSchwartzAnnularNormalProjection B u vartheta beta rho) zeta ≠ 0 at hzeta
  rw [spaceTimeFourier_temporalSchwartzAnnularNormalProjection
    B u vartheta beta rho hrho zeta] at hzeta
  rw [aux_jointSchwartzSpatialNormalCutoff_mul_spaceTimeFourier_temporalSchwartzHalfWave
    B u vartheta beta rho hrho hu zeta] at hzeta
  change B zeta.1 *
      (beta (zeta.2 - rho zeta.1) *
        FourierTransform.fourier (vartheta : Real → Complex)
          (zeta.2 - rho zeta.1)) ≠ 0 at hzeta
  rcases mul_ne_zero_iff.mp hzeta with ⟨hB, htail⟩
  rcases mul_ne_zero_iff.mp htail with ⟨hbeta, _⟩
  exact ⟨hB, hbeta⟩

/-- Explicit spatial, vertical-label, and normal-width hypotheses put the
Fourier support of the projected temporal-Schwartz annular half-wave in a
conic plate.  This is a statement about the projected model only. -/
theorem support_spaceTimeFourier_temporalSchwartzAnnularNormalProjection_subset_conicPlate
    (B u : SchwartzMap (Euclidean 2) Complex)
    (vartheta beta : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real)
    (scale gamma angularConstant : Real) (n : Int) (direction : Euclidean 2)
    (hrho : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), rho xi = ‖xi‖)
    (hu : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex), u xi = 1)
    (hspatial : Function.support (B : Euclidean 2 → Complex) ⊆
      {xi | scale / 4 ≤ ‖xi‖ ∧ ‖xi‖ ≤ 4 * scale ∧
        xi ∈ angularSector direction
          (angularConstant * scale ^ (-(1 / 2 : Real)))})
    (hvertical : ∀ xi ∈ Function.support (B : Euclidean 2 → Complex),
      ∀ s ∈ Function.support (beta : Real → Complex),
        |(Real.sqrt scale)⁻¹ * (rho xi + s) - n| ≤ 1)
    (hnormal : ∀ s ∈ Function.support (beta : Real → Complex),
      |s| ≤ 2 * scale ^ gamma) :
    Function.support
        (spaceTimeFourier
          (temporalSchwartzAnnularNormalProjection B u vartheta beta rho)) ⊆
      conicPlate scale gamma angularConstant n direction := by
  intro zeta hzeta
  have hstrip :=
    aux_support_spaceTimeFourier_temporalSchwartzAnnularNormalProjection_subset_spatialNormalStrip
      B u vartheta beta rho hrho hu hzeta
  rcases hstrip with ⟨hB, hbeta⟩
  rcases hspatial hB with ⟨hlow, hhigh, hangular⟩
  refine ⟨hlow, hhigh, hangular, ?_, ?_⟩
  · have hvertical' := hvertical zeta.1 hB (zeta.2 - rho zeta.1) hbeta
    have hsum : rho zeta.1 + (zeta.2 - rho zeta.1) = zeta.2 := by
      ring
    rw [hsum] at hvertical'
    exact hvertical'
  · rw [← hrho zeta.1 hB]
    exact hnormal (zeta.2 - rho zeta.1) hbeta

/-- A joint-Schwartz spectral realization with a conically supported cutoff
gives the plate-support condition used by the retained raw-model transfer
hypothesis `overlapSquareFunctionRawHypothesis`.  The proved overlap theorem
uses joint-Schwartz spectral profiles directly.  This statement intentionally
does not apply to raw compact physical-time half-waves. -/
theorem support_spaceTimeFourier_wavefrontProjection_subset_conicPlate_of_jointSchwartzRealization
    (angularCutoff : Euclidean 2 → Complex) (normalCutoff : Real → Complex)
    (scale gamma angularConstant : Real) (n : Int) (direction : Euclidean 2)
    (q G : SchwartzMap JointWaveSpaceTime Complex)
    (hrealize : ∀ ζ : WaveSpaceTime,
      wavefrontMultiplier angularCutoff normalCutoff scale gamma ζ *
          FourierTransform.fourier (G : JointWaveSpaceTime → Complex)
            (WithLp.toLp 2 ζ) =
        q (WithLp.toLp 2 ζ) *
          FourierTransform.fourier (G : JointWaveSpaceTime → Complex)
            (WithLp.toLp 2 ζ))
    (hq : Function.support (fun ζ : WaveSpaceTime => q (WithLp.toLp 2 ζ)) ⊆
      conicPlate scale gamma angularConstant n direction) :
    Function.support
        (spaceTimeFourier
          (wavefrontProjection angularCutoff normalCutoff scale gamma
            (jointSchwartzRaw G))) ⊆
      conicPlate scale gamma angularConstant n direction := by
  rw [wavefrontProjection_eq_jointSchwartzSpectralCutoffOutput_of_realization
    angularCutoff normalCutoff scale gamma q G hrealize]
  intro ζ hζ
  change spaceTimeFourier (jointSchwartzSpectralCutoffOutput q G) ζ ≠ 0 at hζ
  rw [spaceTimeFourier_jointSchwartzSpectralCutoffOutput q G ζ] at hζ
  apply hq
  intro hqzero
  apply hζ
  change q (WithLp.toLp 2 ζ) = 0 at hqzero
  rw [jointSchwartzSpectralCutoffProduct,
    SchwartzMap.smulLeftCLM_apply_apply q.hasTemperateGrowth, hqzero]
  simp

/-- A spectral tensor packet, localized in the radial label by the literal
vertical multiplier.  Its temporal factor is Schwartz; in particular this is
not a compact physical-time-cutoff half-wave. -/
noncomputable def spectralRadialNormalPacket
    (β : Real → Complex) (scale : Real) (n : Int)
    (F : SchwartzMap (Euclidean 2) Complex) (g : SchwartzMap Real Complex) :
    WaveSpaceTime → Complex :=
  verticalProjection β scale n (verticalSeparablePacket F (g : Real → Complex))

/-- The exact space-time Fourier multiplier formula for the literal spectral
tensor packet.  A Schwartz representative for the one-dimensional vertical
multiplier is the only regularity input. -/
theorem spaceTimeFourier_spectralRadialNormalPacket_of_schwartzProfile
    (β : Real → Complex) (scale : Real) (n : Int)
    (m g : SchwartzMap Real Complex)
    (hprofile : ∀ τ : Real, m τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : SchwartzMap (Euclidean 2) Complex) (ξ : Euclidean 2) (τ : Real) :
    spaceTimeFourier (spectralRadialNormalPacket β scale n F g) (ξ, τ) =
      verticalMultiplier β scale n (ξ, τ) *
        spaceTimeFourier (verticalSeparablePacket F (g : Real → Complex)) (ξ, τ) := by
  exact spaceTimeFourier_verticalProjection_verticalSeparablePacket_of_schwartzProfile
    β scale n m g hprofile F ξ τ

/-- Exact conic-plate support for a genuinely spectral Schwartz tensor
packet.  The normal condition is imposed on the joint spectral support;
there is deliberately no assertion for a compact physical-time cutoff. -/
theorem support_spaceTimeFourier_spectralRadialNormalPacket_subset_conicPlate
    (β : Real → Complex) (scale gamma angularConstant : Real) (n : Int)
    (direction : Euclidean 2)
    (m g : SchwartzMap Real Complex)
    (hprofile : ∀ τ : Real, m τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : SchwartzMap (Euclidean 2) Complex)
    (hspatial : Function.support (𝓕 (F : Euclidean 2 → Complex)) ⊆
      {ξ | scale / 4 ≤ ‖ξ‖ ∧ ‖ξ‖ ≤ 4 * scale ∧
        ξ ∈ angularSector direction (angularConstant * scale ^ (-(1 / 2 : Real)))})
    (hvertical : ∀ τ : Real,
      β ((Real.sqrt scale)⁻¹ * τ - n) ≠ 0 →
        |(Real.sqrt scale)⁻¹ * τ - n| ≤ 1)
    (hnormal : ∀ ξ : Euclidean 2,
      ξ ∈ Function.support (𝓕 (F : Euclidean 2 → Complex)) →
      ∀ τ : Real, τ ∈ Function.support (𝓕 (g : Real → Complex)) →
      β ((Real.sqrt scale)⁻¹ * τ - n) ≠ 0 →
        |τ - ‖ξ‖| ≤ 2 * scale ^ gamma) :
    Function.support (spaceTimeFourier (spectralRadialNormalPacket β scale n F g)) ⊆
      conicPlate scale gamma angularConstant n direction := by
  intro ζ hζ
  change spaceTimeFourier (spectralRadialNormalPacket β scale n F g) ζ ≠ 0 at hζ
  rw [spaceTimeFourier_spectralRadialNormalPacket_of_schwartzProfile
    β scale n m g hprofile F ζ.1 ζ.2] at hζ
  rw [verticalMultiplier, spaceTimeFourier_verticalSeparablePacket] at hζ
  rcases mul_ne_zero_iff.mp hζ with ⟨hβ, hproduct⟩
  rcases mul_ne_zero_iff.mp hproduct with ⟨hF, hg⟩
  rcases hspatial hF with ⟨hlower, hupper, hangular⟩
  exact ⟨hlower, hupper, hangular, hvertical ζ.2 hβ,
    hnormal ζ.1 hF ζ.2 hg hβ⟩

/-- A spectral radial/normal packet whose spatial frequency factor is an
actual Schwartz cube multiplier.  The physical spatial factor is its inverse
Fourier transform, so this model interfaces directly with the finite cube
cutoffs while remaining spectral in time. -/
noncomputable def spectralCubeRadialNormalPacket
    (β : Real → Complex) (scale : Real) (n : Int)
    (cubeProfile : SchwartzMap (Euclidean 2) Complex)
    (g : SchwartzMap Real Complex) : WaveSpaceTime → Complex :=
  spectralRadialNormalPacket β scale n
    (𝓕⁻ cubeProfile : SchwartzMap (Euclidean 2) Complex) g

/-- Exact Fourier formula for the spectral packet built from a literal
Schwartz cube multiplier. -/
theorem spaceTimeFourier_spectralCubeRadialNormalPacket_of_schwartzProfile
    (β : Real → Complex) (scale : Real) (n : Int)
    (temporalProfile g : SchwartzMap Real Complex)
    (hprofile : ∀ τ : Real, temporalProfile τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (cubeProfile : SchwartzMap (Euclidean 2) Complex) (ξ : Euclidean 2) (τ : Real) :
    spaceTimeFourier
        (spectralCubeRadialNormalPacket β scale n cubeProfile g) (ξ, τ) =
      β ((Real.sqrt scale)⁻¹ * τ - n) *
        (cubeProfile ξ * 𝓕 (g : Real → Complex) τ) := by
  rw [spectralCubeRadialNormalPacket,
    spaceTimeFourier_spectralRadialNormalPacket_of_schwartzProfile
      β scale n temporalProfile g hprofile]
  rw [verticalMultiplier, spaceTimeFourier_verticalSeparablePacket]
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]

/-- An actual spectral cube packet has exact conic-plate support once the
cube profile and temporal Schwartz profile obey the displayed radial,
angular, vertical, and normal support conditions. -/
theorem support_spaceTimeFourier_spectralCubeRadialNormalPacket_subset_conicPlate
    (β : Real → Complex) (scale gamma angularConstant : Real) (n : Int)
    (direction : Euclidean 2)
    (temporalProfile g : SchwartzMap Real Complex)
    (hprofile : ∀ τ : Real, temporalProfile τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (cubeProfile : SchwartzMap (Euclidean 2) Complex)
    (hspatial : Function.support (cubeProfile : Euclidean 2 → Complex) ⊆
      {ξ | scale / 4 ≤ ‖ξ‖ ∧ ‖ξ‖ ≤ 4 * scale ∧
        ξ ∈ angularSector direction (angularConstant * scale ^ (-(1 / 2 : Real)))})
    (hvertical : ∀ τ : Real,
      β ((Real.sqrt scale)⁻¹ * τ - n) ≠ 0 →
        |(Real.sqrt scale)⁻¹ * τ - n| ≤ 1)
    (hnormal : ∀ ξ : Euclidean 2,
      ξ ∈ Function.support (cubeProfile : Euclidean 2 → Complex) →
      ∀ τ : Real, τ ∈ Function.support (𝓕 (g : Real → Complex)) →
      β ((Real.sqrt scale)⁻¹ * τ - n) ≠ 0 →
        |τ - ‖ξ‖| ≤ 2 * scale ^ gamma) :
    Function.support
        (spaceTimeFourier (spectralCubeRadialNormalPacket β scale n cubeProfile g)) ⊆
      conicPlate scale gamma angularConstant n direction := by
  intro ζ hζ
  change spaceTimeFourier
      (spectralCubeRadialNormalPacket β scale n cubeProfile g) ζ ≠ 0 at hζ
  rw [spaceTimeFourier_spectralCubeRadialNormalPacket_of_schwartzProfile
    β scale n temporalProfile g hprofile cubeProfile ζ.1 ζ.2] at hζ
  rcases mul_ne_zero_iff.mp hζ with ⟨hβ, hproduct⟩
  rcases mul_ne_zero_iff.mp hproduct with ⟨hcube, hg⟩
  rcases hspatial hcube with ⟨hlower, hupper, hangular⟩
  exact ⟨hlower, hupper, hangular, hvertical ζ.2 hβ,
    hnormal ζ.1 hcube ζ.2 hg hβ⟩

/-- The preceding literal spectral packets supply the Fourier-support premise
used by `overlapSquareFunctionRawHypothesis`, simultaneously for a finite
radial/angular family. -/
theorem spectralCubeRadialNormalPackets_satisfy_conicPlateSupport
    (β : Real → Complex) (scale gamma angularConstant : Real)
    (radialIndices angularIndices : Finset Int) (directions : Int → Euclidean 2)
    (temporalProfiles g : Int → Int → SchwartzMap Real Complex)
    (cubeProfiles : Int → Int → SchwartzMap (Euclidean 2) Complex)
    (hprofile : ∀ n ∈ radialIndices, ∀ ν ∈ angularIndices, ∀ τ : Real,
      temporalProfiles n ν τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (hspatial : ∀ n ∈ radialIndices, ∀ ν ∈ angularIndices,
      Function.support (cubeProfiles n ν : Euclidean 2 → Complex) ⊆
        {ξ | scale / 4 ≤ ‖ξ‖ ∧ ‖ξ‖ ≤ 4 * scale ∧
          ξ ∈ angularSector (directions ν)
            (angularConstant * scale ^ (-(1 / 2 : Real)))})
    (hvertical : ∀ n ∈ radialIndices, ∀ τ : Real,
      β ((Real.sqrt scale)⁻¹ * τ - n) ≠ 0 →
        |(Real.sqrt scale)⁻¹ * τ - n| ≤ 1)
    (hnormal : ∀ n ∈ radialIndices, ∀ ν ∈ angularIndices,
      ∀ ξ : Euclidean 2,
      ξ ∈ Function.support (cubeProfiles n ν : Euclidean 2 → Complex) →
      ∀ τ : Real, τ ∈ Function.support (𝓕 (g n ν : Real → Complex)) →
      β ((Real.sqrt scale)⁻¹ * τ - n) ≠ 0 →
        |τ - ‖ξ‖| ≤ 2 * scale ^ gamma) :
    ∀ n ∈ radialIndices, ∀ ν ∈ angularIndices,
      Function.support
          (spaceTimeFourier
            (spectralCubeRadialNormalPacket β scale n (cubeProfiles n ν) (g n ν))) ⊆
        conicPlate scale gamma angularConstant n (directions ν) := by
  intro n hn ν hν
  exact support_spaceTimeFourier_spectralCubeRadialNormalPacket_subset_conicPlate
    β scale gamma angularConstant n (directions ν)
    (temporalProfiles n ν) (g n ν) (hprofile n hn ν hν)
    (cubeProfiles n ν) (hspatial n hn ν hν)
    (hvertical n hn) (hnormal n hn ν hν)

/-- The two-parameter square function used after wave-front localization. -/
noncomputable def angularRadialSquareFunction (radialIndices angularIndices : Finset Int)
    (H : Int → Int → WaveSpaceTime → Complex) : WaveSpaceTime → Real :=
  fun z => Real.sqrt (∑ n ∈ radialIndices, ∑ ν ∈ angularIndices, ‖H n ν z‖ ^ 2)

/- The next finite-index helpers are deliberately private.  They formulate the
underlying `ℓ²` calculation on an arbitrary finite index type, rather than
changing the existing `Int`-indexed vertical-square API. -/
private noncomputable def aux_finiteSquareFunction {ι : Type*} [DecidableEq ι]
    (indices : Finset ι) (H : ι → WaveSpaceTime → Complex) : WaveSpaceTime → Real :=
  fun z => Real.sqrt (∑ i ∈ indices, ‖H i z‖ ^ 2)

private theorem aux_finiteSquareFunction_eq_norm_piLp
    {ι : Type*} [DecidableEq ι]
    (indices : Finset ι) (H : ι → WaveSpaceTime → Complex)
    (z : WaveSpaceTime) :
    aux_finiteSquareFunction indices H z =
      ‖(WithLp.toLp 2 (fun i : (↥indices) => H i z) :
        PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex))‖ := by
  rw [PiLp.norm_eq_of_L2]
  change aux_finiteSquareFunction indices H z =
    Real.sqrt (∑ i : (↥indices), ‖H i z‖ ^ (2 : Nat))
  rw [Finset.sum_coe_sort indices (fun i => ‖H i z‖ ^ (2 : Nat))]
  rfl

private theorem aux_finiteSquareFunction_sub_le_sum_norm_tail
    {ι : Type*} [DecidableEq ι]
    (indices : Finset ι)
    (full main tail : ι → WaveSpaceTime → Complex)
    (hdecomp : ∀ i ∈ indices, ∀ z, full i z = main i z + tail i z)
    (z : WaveSpaceTime) :
    ‖aux_finiteSquareFunction indices full z -
        aux_finiteSquareFunction indices main z‖ ≤
      ∑ i ∈ indices, ‖tail i z‖ := by
  let F : PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex) :=
    WithLp.toLp 2 (fun i : (↥indices) => full i z)
  let M : PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex) :=
    WithLp.toLp 2 (fun i : (↥indices) => main i z)
  let T : PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex) :=
    WithLp.toLp 2 (fun i : (↥indices) => tail i z)
  let e : (↥indices) → PiLp (2 : ENNReal) (fun _ : (↥indices) => Complex) :=
    fun i => PiLp.single 2 i (tail i z)
  have hFM : F = M + T := by
    dsimp [F, M, T]
    rw [← WithLp.toLp_add]
    congr 1
    funext i
    exact hdecomp i i.property z
  have hTsum : T = ∑ i : (↥indices), e i := by
    dsimp [T]
    rw [← WithLp.toLp_sum]
    congr 1
    ext i
    simp
  calc
    ‖aux_finiteSquareFunction indices full z -
        aux_finiteSquareFunction indices main z‖ = ‖‖F‖ - ‖M‖‖ := by
      rw [aux_finiteSquareFunction_eq_norm_piLp,
        aux_finiteSquareFunction_eq_norm_piLp]
    _ ≤ ‖F - M‖ := abs_norm_sub_norm_le _ _
    _ = ‖T‖ := by rw [hFM, add_sub_cancel_left]
    _ = ‖∑ i : (↥indices), e i‖ := by rw [hTsum]
    _ ≤ ∑ i : (↥indices), ‖e i‖ := by
      exact norm_sum_le (Finset.univ : Finset (↥indices)) e
    _ = ∑ i ∈ indices, ‖tail i z‖ := by
      simp only [e, PiLp.norm_single]
      exact Finset.sum_coe_sort indices (fun i => ‖tail i z‖)

private theorem aux_eLpNorm_four_finiteSquareFunction_sub_le_sum_of_eq_add_of_tail_bounds
    {ι : Type*} [DecidableEq ι]
    (indices : Finset ι)
    (full main tail : ι → WaveSpaceTime → Complex)
    (hdecomp : ∀ i ∈ indices, ∀ z, full i z = main i z + tail i z)
    (htailMeas : ∀ i ∈ indices, AEStronglyMeasurable (tail i) volume)
    (E : ι → ENNReal)
    (hE : ∀ i ∈ indices, eLpNorm (tail i) 4 volume ≤ E i) :
    eLpNorm (aux_finiteSquareFunction indices full -
      aux_finiteSquareFunction indices main) 4 volume ≤
        ∑ i ∈ indices, E i := by
  let G : WaveSpaceTime → Real := fun z => ∑ i ∈ indices, ‖tail i z‖
  have hGnonneg (z : WaveSpaceTime) : 0 ≤ G z := by
    exact Finset.sum_nonneg fun _ _ => norm_nonneg _
  have hmono (z : WaveSpaceTime) :
      ‖(aux_finiteSquareFunction indices full -
          aux_finiteSquareFunction indices main) z‖ ≤ ‖G z‖ := by
    change |(aux_finiteSquareFunction indices full -
      aux_finiteSquareFunction indices main) z| ≤ |G z|
    rw [abs_of_nonneg (hGnonneg z)]
    exact aux_finiteSquareFunction_sub_le_sum_norm_tail
      indices full main tail hdecomp z
  calc
    eLpNorm (aux_finiteSquareFunction indices full -
        aux_finiteSquareFunction indices main) 4 volume ≤ eLpNorm G 4 volume :=
      eLpNorm_mono hmono
    _ = eLpNorm (fun z => ∑ i ∈ indices, ‖tail i z‖) 4 volume := rfl
    _ = eLpNorm (∑ i ∈ indices, fun z => ‖tail i z‖) 4 volume := by
      congr 1
      funext z
      simp only [Finset.sum_apply]
    _ ≤ ∑ i ∈ indices, eLpNorm (fun z => ‖tail i z‖) 4 volume := by
      apply eLpNorm_sum_le
      · intro i hi
        exact (htailMeas i hi).norm
      · norm_num
    _ = ∑ i ∈ indices, eLpNorm (tail i) 4 volume := by
      apply Finset.sum_congr rfl
      intro i hi
      exact eLpNorm_norm (tail i)
    _ ≤ ∑ i ∈ indices, E i := by
      apply Finset.sum_le_sum
      intro i hi
      exact hE i hi

private theorem aux_angularRadialSquareFunction_eq_finiteSquareFunction_product
    (radialIndices angularIndices : Finset Int)
    (H : Int → Int → WaveSpaceTime → Complex) :
    angularRadialSquareFunction radialIndices angularIndices H =
      aux_finiteSquareFunction (radialIndices.product angularIndices)
        (fun i z => H i.1 i.2 z) := by
  funext z
  unfold angularRadialSquareFunction aux_finiteSquareFunction
  apply congrArg Real.sqrt
  exact (Finset.sum_product radialIndices angularIndices
    (fun i : Int × Int => ‖H i.1 i.2 z‖ ^ (2 : Nat))).symm

/-- A two-index finite square function is stable in `L⁴` under componentwise
additive tails.  This is an elementary finite `ℓ²`/Minkowski estimate, with no
square-function, continuum, or local-smoothing assertion. -/
theorem eLpNorm_four_angularRadialSquareFunction_sub_le_sum_of_eq_add_of_tail_bounds
    (radialIndices angularIndices : Finset Int)
    (full main tail : Int → Int → WaveSpaceTime → Complex)
    (hdecomp : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices, ∀ z,
      full n nu z = main n nu z + tail n nu z)
    (htailMeas : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      AEStronglyMeasurable (tail n nu) volume)
    (E : Int → Int → ENNReal)
    (hE : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      eLpNorm (tail n nu) 4 volume ≤ E n nu) :
    eLpNorm
        (angularRadialSquareFunction radialIndices angularIndices full -
          angularRadialSquareFunction radialIndices angularIndices main)
        4 volume ≤
      ∑ n ∈ radialIndices, ∑ nu ∈ angularIndices, E n nu := by
  let full' : Int × Int → WaveSpaceTime → Complex := fun i z => full i.1 i.2 z
  let main' : Int × Int → WaveSpaceTime → Complex := fun i z => main i.1 i.2 z
  let tail' : Int × Int → WaveSpaceTime → Complex := fun i z => tail i.1 i.2 z
  let E' : Int × Int → ENNReal := fun i => E i.1 i.2
  have hdecomp' : ∀ i ∈ radialIndices.product angularIndices, ∀ z,
      full' i z = main' i z + tail' i z := by
    intro i hi z
    obtain ⟨hn, hnu⟩ := Finset.mem_product.mp hi
    exact hdecomp i.1 hn i.2 hnu z
  have htailMeas' : ∀ i ∈ radialIndices.product angularIndices,
      AEStronglyMeasurable (tail' i) volume := by
    intro i hi
    obtain ⟨hn, hnu⟩ := Finset.mem_product.mp hi
    exact htailMeas i.1 hn i.2 hnu
  have hE' : ∀ i ∈ radialIndices.product angularIndices,
      eLpNorm (tail' i) 4 volume ≤ E' i := by
    intro i hi
    obtain ⟨hn, hnu⟩ := Finset.mem_product.mp hi
    exact hE i.1 hn i.2 hnu
  have hfinite := aux_eLpNorm_four_finiteSquareFunction_sub_le_sum_of_eq_add_of_tail_bounds
    (radialIndices.product angularIndices) full' main' tail' hdecomp' htailMeas' E' hE'
  have hfull : angularRadialSquareFunction radialIndices angularIndices full =
      aux_finiteSquareFunction (radialIndices.product angularIndices) full' := by
    dsimp only [full']
    exact aux_angularRadialSquareFunction_eq_finiteSquareFunction_product
      radialIndices angularIndices full
  have hmain : angularRadialSquareFunction radialIndices angularIndices main =
      aux_finiteSquareFunction (radialIndices.product angularIndices) main' := by
    dsimp only [main']
    exact aux_angularRadialSquareFunction_eq_finiteSquareFunction_product
      radialIndices angularIndices main
  rw [hfull, hmain]
  calc
    eLpNorm
        (aux_finiteSquareFunction (radialIndices.product angularIndices) full' -
          aux_finiteSquareFunction (radialIndices.product angularIndices) main')
        4 volume ≤
      ∑ i ∈ radialIndices.product angularIndices, E' i := hfinite
    _ = ∑ n ∈ radialIndices, ∑ nu ∈ angularIndices, E n nu := by
      dsimp only [E']
      exact Finset.sum_product radialIndices angularIndices (fun i : Int × Int => E i.1 i.2)

private theorem aux_aestronglyMeasurable_angularRadialSquareFunction
    (radialIndices angularIndices : Finset Int)
    (H : Int → Int → WaveSpaceTime → Complex)
    (hH : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      AEStronglyMeasurable (H n nu) volume) :
    AEStronglyMeasurable
      (angularRadialSquareFunction radialIndices angularIndices H) volume := by
  unfold angularRadialSquareFunction
  apply Real.continuous_sqrt.comp_aestronglyMeasurable
  apply Finset.aestronglyMeasurable_fun_sum radialIndices
  intro n hn
  apply Finset.aestronglyMeasurable_fun_sum angularIndices
  intro nu hnu
  exact (hH n hn nu hnu).norm.pow 2

/-- The square function after recombining the angular pieces for each fixed
radial label.  It is the left-hand square function in the plate-overlap
consequence from the MSS blueprint. -/
noncomputable def aux_angularRadialRecombinedSquareFunction
    (radialIndices angularIndices : Finset Int)
    (H : Int → Int → WaveSpaceTime → Complex) : WaveSpaceTime → Real :=
  fun z => Real.sqrt (∑ n ∈ radialIndices, ‖∑ ν ∈ angularIndices, H n ν z‖ ^ 2)

/-- The finite recombined angular/radial square function is stable in `L⁴`
under componentwise additive tails.  This is a finite `ℓ²`/Minkowski estimate;
it does not assert a square-function estimate, a continuum limit, or local
smoothing. -/
theorem eLpNorm_four_aux_angularRadialRecombinedSquareFunction_sub_le_sum_of_eq_add_of_tail_bounds
    (radialIndices angularIndices : Finset Int)
    (full main tail : Int → Int → WaveSpaceTime → Complex)
    (hdecomp : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices, ∀ z,
      full n nu z = main n nu z + tail n nu z)
    (htailMeas : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      AEStronglyMeasurable (tail n nu) volume)
    (E : Int → Int → ENNReal)
    (hE : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      eLpNorm (tail n nu) 4 volume ≤ E n nu) :
    eLpNorm
        (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices full -
          aux_angularRadialRecombinedSquareFunction radialIndices angularIndices main)
        4 volume ≤ ∑ n ∈ radialIndices, ∑ nu ∈ angularIndices, E n nu := by
  let full' : Int → WaveSpaceTime → Complex :=
    fun n z => ∑ nu ∈ angularIndices, full n nu z
  let main' : Int → WaveSpaceTime → Complex :=
    fun n z => ∑ nu ∈ angularIndices, main n nu z
  let tail' : Int → WaveSpaceTime → Complex :=
    fun n z => ∑ nu ∈ angularIndices, tail n nu z
  let E' : Int → ENNReal := fun n => ∑ nu ∈ angularIndices, E n nu
  have hdecomp' : ∀ n ∈ radialIndices, ∀ z, full' n z = main' n z + tail' n z := by
    intro n hn z
    dsimp [full', main', tail']
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro nu hnu
    exact hdecomp n hn nu hnu z
  have htailMeas' : ∀ n ∈ radialIndices, AEStronglyMeasurable (tail' n) volume := by
    intro n hn
    dsimp [tail']
    apply Finset.aestronglyMeasurable_fun_sum angularIndices
    intro nu hnu
    exact htailMeas n hn nu hnu
  have hE' : ∀ n ∈ radialIndices, eLpNorm (tail' n) 4 volume ≤ E' n := by
    intro n hn
    have htail'_eq : tail' n = ∑ nu ∈ angularIndices, tail n nu := by
      funext z
      simp only [tail', Finset.sum_apply]
    rw [htail'_eq]
    dsimp only [E']
    calc
      eLpNorm (∑ nu ∈ angularIndices, tail n nu) 4 volume ≤
          ∑ nu ∈ angularIndices, eLpNorm (tail n nu) 4 volume := by
        apply eLpNorm_sum_le
        · intro nu hnu
          exact htailMeas n hn nu hnu
        · norm_num
      _ ≤ ∑ nu ∈ angularIndices, E n nu := by
        apply Finset.sum_le_sum
        intro nu hnu
        exact hE n hn nu hnu
  have hvertical := eLpNorm_four_verticalSquareFunction_sub_le_sum_of_eq_add_of_tail_bounds
    radialIndices full' main' tail' hdecomp' htailMeas' E' hE'
  have hfull : aux_angularRadialRecombinedSquareFunction radialIndices angularIndices full =
      verticalSquareFunction radialIndices full' := by
    rfl
  have hmain : aux_angularRadialRecombinedSquareFunction radialIndices angularIndices main =
      verticalSquareFunction radialIndices main' := by
    rfl
  rw [hfull, hmain]
  simpa only [E'] using hvertical

private theorem aux_aestronglyMeasurable_aux_angularRadialRecombinedSquareFunction
    (radialIndices angularIndices : Finset Int)
    (H : Int → Int → WaveSpaceTime → Complex)
    (hH : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      AEStronglyMeasurable (H n nu) volume) :
    AEStronglyMeasurable
      (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices H) volume := by
  unfold aux_angularRadialRecombinedSquareFunction
  apply Real.continuous_sqrt.comp_aestronglyMeasurable
  apply Finset.aestronglyMeasurable_fun_sum radialIndices
  intro n hn
  apply AEStronglyMeasurable.pow
  apply AEStronglyMeasurable.norm
  apply Finset.aestronglyMeasurable_fun_sum angularIndices
  intro nu hnu
  exact hH n hn nu hnu

private theorem aux_eLpNorm_aux_angularRadialRecombinedSquareFunction_full_le_main_add_sum_tails
    (radialIndices angularIndices : Finset Int)
    (full main tail : Int → Int → WaveSpaceTime → Complex)
    (hdecomp : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices, ∀ z,
      full n nu z = main n nu z + tail n nu z)
    (hmainMeas : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      AEStronglyMeasurable (main n nu) volume)
    (htailMeas : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      AEStronglyMeasurable (tail n nu) volume)
    (E : Int → Int → ENNReal)
    (hE : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      eLpNorm (tail n nu) 4 volume ≤ E n nu) :
    eLpNorm
        (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices full)
        4 volume ≤
      eLpNorm
          (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices main)
          4 volume + ∑ n ∈ radialIndices, ∑ nu ∈ angularIndices, E n nu := by
  have hfullMeas : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      AEStronglyMeasurable (full n nu) volume := by
    intro n hn nu hnu
    exact ((hmainMeas n hn nu hnu).add (htailMeas n hn nu hnu)).congr
      (Filter.Eventually.of_forall fun z => (hdecomp n hn nu hnu z).symm)
  have hfullRec := aux_aestronglyMeasurable_aux_angularRadialRecombinedSquareFunction
    radialIndices angularIndices full hfullMeas
  have hmainRec := aux_aestronglyMeasurable_aux_angularRadialRecombinedSquareFunction
    radialIndices angularIndices main hmainMeas
  have htriangle :
      eLpNorm
          (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices full)
          4 volume ≤
        eLpNorm
            (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices full -
              aux_angularRadialRecombinedSquareFunction radialIndices angularIndices main)
            4 volume +
          eLpNorm
            (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices main)
            4 volume := by
    calc
      eLpNorm
          (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices full)
          4 volume =
          eLpNorm
            ((aux_angularRadialRecombinedSquareFunction radialIndices angularIndices full -
              aux_angularRadialRecombinedSquareFunction radialIndices angularIndices main) +
              aux_angularRadialRecombinedSquareFunction radialIndices angularIndices main)
            4 volume := by
          congr 1
          funext z
          simp only [Pi.sub_apply, Pi.add_apply]
          abel
      _ ≤ _ := eLpNorm_add_le (hfullRec.sub hmainRec) hmainRec (by norm_num)
  calc
    eLpNorm
        (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices full)
        4 volume ≤
      eLpNorm
          (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices full -
            aux_angularRadialRecombinedSquareFunction radialIndices angularIndices main)
          4 volume +
        eLpNorm
          (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices main)
          4 volume := htriangle
    _ ≤ (∑ n ∈ radialIndices, ∑ nu ∈ angularIndices, E n nu) +
        eLpNorm
          (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices main)
          4 volume := by
      gcongr
      exact eLpNorm_four_aux_angularRadialRecombinedSquareFunction_sub_le_sum_of_eq_add_of_tail_bounds
        radialIndices angularIndices full main tail hdecomp htailMeas E hE
    _ = _ := add_comm _ _

/-- The vector-valued estimate removing vertical projections from a finite
joint-Schwartz radial/angular family.  This is the common-positive-time-kernel
Minkowski step in the MSS blueprint.  The Schwartz cutoff is exactly the
regularity needed to construct its integrable inverse-Fourier kernel. -/
def removeVerticalProjections (beta : SchwartzMap Real Complex) : Prop :=
  ∃ C : Real, 0 < C ∧ ∀ scale : Real, 2 ≤ scale →
    ∀ radialIndices angularIndices : Finset Int,
      ∀ H : Int → Int → SchwartzMap JointWaveSpaceTime Complex,
        eLpNorm
            (angularRadialSquareFunction radialIndices angularIndices
              (fun n ν => verticalProjection (beta : Real → Complex) scale n
                (jointSchwartzRaw (H n ν))))
            (4 : ENNReal) volume ≤
          ENNReal.ofReal C *
            eLpNorm (angularRadialSquareFunction radialIndices angularIndices
              (fun n ν => jointSchwartzRaw (H n ν)))
              (4 : ENNReal) volume

/-- The radial, angular, and vertically localized half-wave summand before
wave-front projection. -/
noncomputable def angularRadialWave (verticalCutoff radialCutoff : Real → Complex)
    (angularCutoff : Int → Euclidean 2 → Complex) (scale : Real)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex) (n ν : Int)
    (f : Euclidean 2 → Complex) : WaveSpaceTime → Complex :=
  verticalProjection verticalCutoff scale n
    (angularPiece scale a (angularCutoff ν) ϑ
      (radialPiece radialCutoff scale n f))

/-- The wave-front projected version of an angular/radial half-wave summand. -/
noncomputable def wavefrontAngularRadialWave
    (verticalCutoff radialCutoff : Real → Complex)
    (angularCutoff wavefrontCutoff : Int → Euclidean 2 → Complex)
    (normalCutoff : Real → Complex) (scale gamma : Real)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex) (n ν : Int)
    (f : Euclidean 2 → Complex) : WaveSpaceTime → Complex :=
  wavefrontProjection (wavefrontCutoff ν) normalCutoff scale gamma
    (angularRadialWave verticalCutoff radialCutoff angularCutoff scale a ϑ n ν f)

/-- The scale-indexed cutoff and geometry data in the wave-front localization
lemma.  The angular partition genuinely depends on the scale: its aperture is
of order `scale⁻¹ᐟ²`. -/
structure MSSWavefrontCutoffData where
  radialTime : MSSRadialTimeCutoffs
  angularConstant : Real
  angularConstant_pos : 0 < angularConstant
  angularIndices : Real → Finset Int
  directions : Real → Int → Euclidean 2
  chi : Real → Int → Euclidean 2 → Complex
  tildeChi : Real → Int → Euclidean 2 → Complex
  normal : SchwartzMap Real Complex
  angular_card : ∃ C_a : Real, 0 < C_a ∧ ∀ scale : Real, 2 ≤ scale →
    ((angularIndices scale).card : Real) ≤ C_a * Real.sqrt scale
  direction_unit : ∀ scale : Real, ∀ nu ∈ angularIndices scale,
    ‖directions scale nu‖ = 1
  chi_support : ∀ scale : Real, ∀ nu ∈ angularIndices scale,
    Function.support (chi scale nu) ⊆
      angularSector (directions scale nu)
        (angularConstant * scale ^ (-(1 / 2 : Real)))
  tildeChi_support : ∀ scale : Real, ∀ nu ∈ angularIndices scale,
    Function.support (tildeChi scale nu) ⊆
      angularSector (directions scale nu)
        (angularConstant * scale ^ (-(1 / 2 : Real)))
  tildeChi_one_on_chi_support : ∀ scale : Real, ∀ nu ∈ angularIndices scale,
    ∀ xi : Euclidean 2, chi scale nu xi ≠ 0 → tildeChi scale nu xi = 1
  normal_tsupport_subset : tsupport (normal : Real → Complex) ⊆ Set.Ioo (-2) 2
  normal_support : ∀ s : Real, normal s ≠ 0 → |s| < 2
  normal_one_on_unit : ∀ s : Real, |s| ≤ 1 → normal s = 1

/-- Smooth packet data used internally by wave-front localization.  These are
cutoff/profile data, rather than a postulated residual or operator estimate. -/
structure MSSWavefrontKernelData extends MSSWavefrontCutoffData where
  gamma : Real
  gamma_pos : 0 < gamma
  gamma_lt_tenth : gamma < 1 / 10
  spatialProfile : Real → Int → Int → SchwartzMap (Euclidean 2) Complex
  spatialProfile_apply : ∀ scale n nu xi,
    spatialProfile scale n nu xi =
      chi scale nu xi *
        (radialTime.amplitude (scale⁻¹ • xi) *
          radialTime.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n))
  normalCoordinate : Real → SchwartzMap (Euclidean 2) Real
  normalCoordinate_apply : ∀ scale xi,
    normalCoordinate scale xi =
      scale * radialTime.normalExtension (scale⁻¹ • xi)
  normalTail : Real → SchwartzMap Real Complex
  normalTail_apply : ∀ scale u,
    normalTail scale u =
      ((1 : Complex) - normal (scale ^ (-gamma) * u)) *
        FourierTransform.fourier (radialTime.time : Real → Complex) u

/-- Global Schwartz realizations of the raw radial and enlarged angular
profiles.  They are the exact raw-to-joint bridge needed for the literal
Fourier calculations; no localization conclusion is included in this data. -/
structure MSSWavefrontRawProfileRealization (D : MSSWavefrontKernelData) where
  radialProfile : Real → Int → SchwartzMap (Euclidean 2) Complex
  radialProfile_apply : ∀ scale n xi,
    radialProfile scale n xi =
      D.radialTime.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n)
  wavefrontAngularProfile : Real → Int → SchwartzMap (Euclidean 2) Complex
  wavefrontAngularProfile_eq_on_spatial : ∀ scale n nu xi,
    D.spatialProfile scale n nu xi ≠ 0 →
      wavefrontAngularProfile scale nu xi = D.tildeChi scale nu xi

/-- The only nonautomatic regularity hypothesis in the localization result:
for each finite derivative order, the scale-indexed spatial profiles have an
`L¹` bound with some polynomial scale loss. -/
structure MSSWavefrontSpatialProfilePolynomialRegularity
    (D : MSSWavefrontKernelData) where
  spatialExponent : Nat → Nat
  derivative_l1 : ∀ r : Nat, ∃ A : Real, 0 ≤ A ∧
    ∀ (scale : Real) (n nu : Int), 2 ≤ scale →
      n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
      (∫ xi : Euclidean 2,
        ‖iteratedFDeriv Real r
          (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖) ≤
        A * scale ^ spatialExponent r

/-- The literal scale-indexed angular/radial summand determined by the cutoff
data. -/
noncomputable def mssAngularRadialWave (D : MSSWavefrontCutoffData)
    (scale : Real) (n nu : Int) (f : Euclidean 2 → Complex) :
    WaveSpaceTime → Complex :=
  angularRadialWave (D.radialTime.vertical : Real → Complex)
    (D.radialTime.radial : Real → Complex) (D.chi scale) scale
    (D.radialTime.amplitude : Euclidean 2 → Complex)
    (D.radialTime.time : Real → Complex) n nu f

/-- The corresponding literal wave-front projection, using the enlarged
scale-indexed angular cutoff and fixed normal cutoff. -/
noncomputable def mssWavefrontAngularRadialWave
    (D : MSSWavefrontCutoffData) (scale gamma : Real) (n nu : Int)
    (f : Euclidean 2 → Complex) : WaveSpaceTime → Complex :=
  wavefrontProjection (D.tildeChi scale nu) (D.normal : Real → Complex) scale gamma
    (mssAngularRadialWave D scale n nu f)

/-- The rapid `L⁴` square-function error clause of wave-front localization.
The radial family is the canonical relevant enumeration from the blueprint. -/
def wavefrontLocalizationError (D : MSSWavefrontCutoffData) (gamma : Real) : Prop :=
  0 < gamma → gamma < 1 / 10 →
  ∀ N : Nat, 1 ≤ N → ∃ C : Real, 0 < C ∧ ∀ scale : Real, 2 ≤ scale →
    ∀ f : SchwartzMap (Euclidean 2) Complex,
      eLpNorm
          (angularRadialSquareFunction (relevantRadialIndexEnumeration scale)
            (D.angularIndices scale)
            (fun n nu => fun z =>
              mssAngularRadialWave D scale n nu (f : Euclidean 2 → Complex) z -
                mssWavefrontAngularRadialWave D scale gamma n nu
                  (f : Euclidean 2 → Complex) z))
          (4 : ENNReal) volume ≤
        ENNReal.ofReal (C * (scale⁻¹) ^ N) *
          eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume

/-- The Fourier-support clause of wave-front localization, restricted to the
active radial and angular index families. -/
def wavefrontPlateSupport (D : MSSWavefrontCutoffData) (gamma : Real) : Prop :=
  ∀ scale : Real, 2 ≤ scale → ∀ n nu : Int,
    n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
    ∀ f : SchwartzMap (Euclidean 2) Complex,
      Function.support
          (spaceTimeFourier
            (mssWavefrontAngularRadialWave D scale gamma n nu
              (f : Euclidean 2 → Complex))) ⊆
        conicPlate scale gamma D.angularConstant n (D.directions scale nu)

/-- The two blueprint clauses of wave-front localization. -/
def wavefrontLocalization (D : MSSWavefrontCutoffData) (gamma : Real) : Prop :=
  wavefrontLocalizationError D gamma ∧ wavefrontPlateSupport D gamma

/- Private proof machinery for the active wave-front-localization item. -/
open scoped BigOperators

private noncomputable def scratchWavefrontVerticalProfile
    (D : MSSWavefrontKernelData) (scale : Real) (n : Int)
    (hscale : 0 < scale) : SchwartzMap Real Complex :=
  let root : Real := Real.sqrt scale
  let A : Real ≃L[Real] Real :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 root⁻¹ (by
        dsimp only [root]
        exact inv_ne_zero (Real.sqrt_ne_zero'.mpr hscale)))
  ((SchwartzMap.compCLMOfContinuousLinearEquiv Complex A) D.radialTime.vertical).compSubConstCLM
    Complex (root * n)

private theorem scratchWavefrontVerticalProfile_apply
    (D : MSSWavefrontKernelData) (scale : Real) (n : Int)
    (hscale : 0 < scale) (tau : Real) :
    scratchWavefrontVerticalProfile D scale n hscale tau =
      D.radialTime.vertical ((Real.sqrt scale)⁻¹ * tau - n) := by
  unfold scratchWavefrontVerticalProfile
  dsimp
  change D.radialTime.vertical
      ((Real.sqrt scale)⁻¹ * (tau - Real.sqrt scale * n)) = _
  have hroot : Real.sqrt scale ≠ 0 := Real.sqrt_ne_zero'.mpr hscale
  field_simp [hroot]

private def scratchWavefrontJointVerticalFactor
    (m : SchwartzMap Real Complex) : JointWaveSpaceTime → Complex :=
  fun z => m z.snd

private theorem scratchWavefrontJointVerticalFactor_hasTemperateGrowth
    (m : SchwartzMap Real Complex) :
    (scratchWavefrontJointVerticalFactor m).HasTemperateGrowth := by
  change (m ∘ WithLp.sndL 2 Real (Euclidean 2) Real).HasTemperateGrowth
  exact m.hasTemperateGrowth.comp
    (WithLp.sndL 2 Real (Euclidean 2) Real).hasTemperateGrowth

private noncomputable def scratchWavefrontApplyVertical
    (m : SchwartzMap Real Complex)
    (Q : SchwartzMap JointWaveSpaceTime Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  SchwartzMap.smulLeftCLM Complex (scratchWavefrontJointVerticalFactor m) Q

private theorem scratchWavefrontApplyVertical_apply
    (m : SchwartzMap Real Complex)
    (Q : SchwartzMap JointWaveSpaceTime Complex) (zeta : WaveSpaceTime) :
    scratchWavefrontApplyVertical m Q (WithLp.toLp 2 zeta) =
      m zeta.2 * Q (WithLp.toLp 2 zeta) := by
  unfold scratchWavefrontApplyVertical
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (scratchWavefrontJointVerticalFactor_hasTemperateGrowth m)]
  rfl

/-- The f-independent error multiplier for one canonical `(n,ν)` packet.
It is a genuine joint Schwartz multiplier; the input Fourier transform is
not part of this definition. -/
private noncomputable def scratchWavefrontPacketResidualMultiplier
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale)
    (n nu : Int) : SchwartzMap JointWaveSpaceTime Complex :=
  scratchWavefrontApplyVertical
    (scratchWavefrontVerticalProfile D scale n hscale)
    (jointSchwartzModulatedAnnularProfile
      (D.spatialProfile scale n nu)
      (FourierTransform.fourierInv (D.normalTail scale))
      (D.normalCoordinate scale))

/-- Literal formula for the f-independent residual multiplier. -/
private theorem scratchWavefrontPacketResidualMultiplier_apply
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale)
    (n nu : Int) (zeta : WaveSpaceTime) :
    scratchWavefrontPacketResidualMultiplier D scale hscale n nu
        (WithLp.toLp 2 zeta) =
      D.radialTime.vertical ((Real.sqrt scale)⁻¹ * zeta.2 - n) *
        (D.spatialProfile scale n nu zeta.1 *
          D.normalTail scale (zeta.2 - D.normalCoordinate scale zeta.1)) := by
  unfold scratchWavefrontPacketResidualMultiplier
  rw [scratchWavefrontApplyVertical_apply,
    scratchWavefrontVerticalProfile_apply,
    jointSchwartzModulatedAnnularProfile_apply]
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]

/-- On the support of the compact spatial packet, the auxiliary normal
coordinate is the literal Euclidean norm. -/
private theorem normalCoordinate_eq_norm_on_spatial_support
    (D : MSSWavefrontKernelData) {scale : Real} (hscale : 0 < scale)
    (n nu : Int) {xi : Euclidean 2}
    (hxi : D.spatialProfile scale n nu xi ≠ 0) :
    D.normalCoordinate scale xi = ‖xi‖ := by
  rw [D.spatialProfile_apply] at hxi
  rcases mul_ne_zero_iff.mp hxi with ⟨_, hxi⟩
  rcases mul_ne_zero_iff.mp hxi with ⟨hamp, _⟩
  rw [D.normalCoordinate_apply,
    D.radialTime.normalExtension_eq_norm_on_amplitude
      (scale⁻¹ • xi) hamp,
    norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hscale)]
  field_simp [hscale.ne']

/-- On an active spatial packet the multiplier is exactly the normal-cutoff
defect times the expected vertical, angular, radial, amplitude, and temporal
Fourier factors.  This is the raw `(n,ν)` factorization needed before kernel
estimates. -/
private theorem scratchWavefrontPacketResidualMultiplier_apply_on_spatial_support
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale)
    (n nu : Int) (zeta : WaveSpaceTime)
    (hspatial : D.spatialProfile scale n nu zeta.1 ≠ 0) :
    scratchWavefrontPacketResidualMultiplier D scale hscale n nu
        (WithLp.toLp 2 zeta) =
      D.radialTime.vertical ((Real.sqrt scale)⁻¹ * zeta.2 - n) *
        (D.chi scale nu zeta.1 *
          (D.radialTime.amplitude (scale⁻¹ • zeta.1) *
            (D.radialTime.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n) *
              (((1 : Complex) - D.normal
                (scale ^ (-D.gamma) * (zeta.2 - ‖zeta.1‖))) *
                FourierTransform.fourier (D.radialTime.time : Real → Complex)
                  (zeta.2 - ‖zeta.1‖)))) ) := by
  rw [scratchWavefrontPacketResidualMultiplier_apply,
    normalCoordinate_eq_norm_on_spatial_support D hscale n nu hspatial,
    D.normalTail_apply,
    D.spatialProfile_apply]
  ring

/-- The literal spectral error operator associated with the f-independent
packet multiplier.  This is the actual `f → space-time` object for the
kernel route, before its convolution representation is invoked. -/
private noncomputable def scratchWavefrontPacketResidual
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale)
    (n nu : Int) (f : SchwartzMap (Euclidean 2) Complex) :
    WaveSpaceTime → Complex :=
  spaceTimeFourierInv (fun zeta : WaveSpaceTime =>
    jointSchwartzRaw (scratchWavefrontPacketResidualMultiplier D scale hscale n nu) zeta *
      FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1)

/-- The residual definition exposes the intended f-independent Fourier
factorization pointwise, with no operator-norm hypothesis. -/
private theorem scratchWavefrontPacketResidual_eq_inverse_factorizedSpectrum
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale)
    (n nu : Int) (f : SchwartzMap (Euclidean 2) Complex) :
    scratchWavefrontPacketResidual D scale hscale n nu f =
      spaceTimeFourierInv (fun zeta : WaveSpaceTime =>
        jointSchwartzRaw (scratchWavefrontPacketResidualMultiplier D scale hscale n nu) zeta *
          FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1) := rfl

private noncomputable def wfVerticalProfile
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) : SchwartzMap Real Complex :=
  let root : Real := Real.sqrt scale
  let A : Real ≃L[Real] Real :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 root⁻¹ (by
        dsimp only [root]
        exact inv_ne_zero (Real.sqrt_ne_zero'.mpr hscale)))
  ((SchwartzMap.compCLMOfContinuousLinearEquiv Complex A) beta).compSubConstCLM
    Complex (root * n)

private theorem wfVerticalProfile_apply
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) (tau : Real) :
    wfVerticalProfile beta scale n hscale tau =
      beta ((Real.sqrt scale)⁻¹ * tau - n) := by
  unfold wfVerticalProfile
  dsimp
  change beta ((Real.sqrt scale)⁻¹ * (tau - Real.sqrt scale * n)) = _
  have hroot : Real.sqrt scale ≠ 0 := Real.sqrt_ne_zero'.mpr hscale
  field_simp [hroot]

private noncomputable def wfNormalProfile
    (normal : SchwartzMap Real Complex) (scale gamma : Real)
    (hscale : 0 < scale) : SchwartzMap Real Complex :=
  let A : Real ≃L[Real] Real :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 (scale ^ (-gamma))
        (ne_of_gt (Real.rpow_pos_of_pos hscale _)))
  (SchwartzMap.compCLMOfContinuousLinearEquiv Complex A) normal

private theorem wfNormalProfile_apply
    (normal : SchwartzMap Real Complex) (scale gamma : Real)
    (hscale : 0 < scale) (s : Real) :
    wfNormalProfile normal scale gamma hscale s =
      normal (scale ^ (-gamma) * s) := by
  unfold wfNormalProfile
  dsimp
  rfl

/-- Regular data for one literal angular--radial half-wave packet. -/
private structure WFAngularRadialProfiles
    (D : MSSRadialTimeCutoffs) (scale : Real) (n : Int)
    (chi tildeChi : Euclidean 2 → Complex)
    (f : SchwartzMap (Euclidean 2) Complex) where
  radial : SchwartzMap (Euclidean 2) Complex
  spatial : SchwartzMap (Euclidean 2) Complex
  normalExtension : SchwartzMap (Euclidean 2) Real
  wavefrontAngular : SchwartzMap (Euclidean 2) Complex
  radial_eq : ∀ xi : Euclidean 2,
    radial xi = D.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n)
  spatial_eq : ∀ xi : Euclidean 2,
    spatial xi = chi xi * D.amplitude (scale⁻¹ • xi) *
      (radial xi * FourierTransform.fourier (f : Euclidean 2 → Complex) xi)
  normal_eq_norm : ∀ xi ∈ Function.support (spatial : Euclidean 2 → Complex),
    normalExtension xi = ‖xi‖
  wavefrontAngular_eq : ∀ xi ∈ Function.support (spatial : Euclidean 2 → Complex),
    wavefrontAngular xi = tildeChi xi

private def wfJointTemporalMultiplier
    (m : SchwartzMap Real Complex) : JointWaveSpaceTime → Complex :=
  fun z => m z.snd

private theorem wfJointTemporalMultiplier_hasTemperateGrowth
    (m : SchwartzMap Real Complex) :
    (wfJointTemporalMultiplier m).HasTemperateGrowth := by
  change (m ∘ WithLp.sndL 2 Real (Euclidean 2) Real).HasTemperateGrowth
  exact m.hasTemperateGrowth.comp
    (WithLp.sndL 2 Real (Euclidean 2) Real).hasTemperateGrowth

private noncomputable def wfApplyVerticalSpectrum
    (m : SchwartzMap Real Complex)
    (Q : SchwartzMap JointWaveSpaceTime Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  SchwartzMap.smulLeftCLM Complex (wfJointTemporalMultiplier m) Q

private theorem wfApplyVerticalSpectrum_apply
    (m : SchwartzMap Real Complex)
    (Q : SchwartzMap JointWaveSpaceTime Complex) (zeta : WaveSpaceTime) :
    wfApplyVerticalSpectrum m Q (WithLp.toLp 2 zeta) =
      m zeta.2 * Q (WithLp.toLp 2 zeta) := by
  unfold wfApplyVerticalSpectrum
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (wfJointTemporalMultiplier_hasTemperateGrowth m)]
  unfold wfJointTemporalMultiplier
  rfl

private noncomputable def wfBaseSpectrum
    (D : MSSRadialTimeCutoffs) {scale : Real} {n : Int}
    {chi tildeChi : Euclidean 2 → Complex} {f : SchwartzMap (Euclidean 2) Complex}
    (P : WFAngularRadialProfiles D scale n chi tildeChi f) :
    SchwartzMap JointWaveSpaceTime Complex :=
  jointSchwartzModulatedAnnularProfile P.spatial D.time P.normalExtension

private noncomputable def wfSourceSpectrum
    (D : MSSRadialTimeCutoffs) (scale : Real) (n : Int) (hscale : 0 < scale)
    {chi tildeChi : Euclidean 2 → Complex} {f : SchwartzMap (Euclidean 2) Complex}
    (P : WFAngularRadialProfiles D scale n chi tildeChi f) :
    SchwartzMap JointWaveSpaceTime Complex :=
  wfApplyVerticalSpectrum (wfVerticalProfile D.vertical scale n hscale)
    (wfBaseSpectrum D P)

private noncomputable def wfSourceJointSchwartz
    (D : MSSRadialTimeCutoffs) (scale : Real) (n : Int) (hscale : 0 < scale)
    {chi tildeChi : Euclidean 2 → Complex} {f : SchwartzMap (Euclidean 2) Complex}
    (P : WFAngularRadialProfiles D scale n chi tildeChi f) :
    SchwartzMap JointWaveSpaceTime Complex :=
  FourierTransform.fourierInv (wfSourceSpectrum D scale n hscale P)

private noncomputable def wfWavefrontJointCutoff
    (normal : SchwartzMap Real Complex) (scale gamma : Real) (hscale : 0 < scale)
    {D : MSSRadialTimeCutoffs} {n : Int}
    {chi tildeChi : Euclidean 2 → Complex} {f : SchwartzMap (Euclidean 2) Complex}
    (P : WFAngularRadialProfiles D scale n chi tildeChi f) :
    SchwartzMap JointWaveSpaceTime Complex :=
  jointSchwartzSpatialNormalCutoff P.wavefrontAngular
    (wfNormalProfile normal scale gamma hscale) P.normalExtension

/-- The exact joint-Schwartz frequency residual used by the raw packet
factorization.  This is public in the scratch bridge so later kernel work can
compare it directly with an f-independent multiplier. -/
private noncomputable def wfResidualSpectrum
    (D : MSSRadialTimeCutoffs) (normal : SchwartzMap Real Complex)
    (scale gamma : Real) (n : Int) (hscale : 0 < scale)
    {chi tildeChi : Euclidean 2 → Complex} {f : SchwartzMap (Euclidean 2) Complex}
    (P : WFAngularRadialProfiles D scale n chi tildeChi f) :
    SchwartzMap JointWaveSpaceTime Complex :=
  wfSourceSpectrum D scale n hscale P -
    jointSchwartzSpectralCutoffProduct
      (wfWavefrontJointCutoff normal scale gamma hscale P)
      (wfSourceJointSchwartz D scale n hscale P)

/-- Before the vertical window is applied, the literal raw angular/radial
packet is the inverse joint Fourier transform of its supplied Schwartz
spectrum. -/
private theorem wfBasePhysical_eq_angularPiece
    (D : MSSRadialTimeCutoffs) (scale : Real) (n : Int)
    (chi tildeChi : Euclidean 2 → Complex)
    (f : SchwartzMap (Euclidean 2) Complex)
    (P : WFAngularRadialProfiles D scale n chi tildeChi f) :
    jointSchwartzRaw (FourierTransform.fourierInv (wfBaseSpectrum D P)) =
      angularPiece scale (D.amplitude : Euclidean 2 → Complex) chi
        (D.time : Real → Complex)
        (radialPiece (D.radial : Real → Complex) scale n
          (f : Euclidean 2 → Complex)) := by
  funext z
  calc
    jointSchwartzRaw (FourierTransform.fourierInv (wfBaseSpectrum D P)) z =
        spaceTimeFourierInv (jointSchwartzRaw (wfBaseSpectrum D P)) z := by
          simpa only [jointSchwartzRaw, SchwartzMap.fourierInv_coe] using
            (spaceTimeFourierInv_jointSchwartzRaw (wfBaseSpectrum D P) z).symm
    _ = (fun z : WaveSpaceTime =>
        D.time z.2 * FourierTransform.fourierInv (fun xi : Euclidean 2 =>
          P.spatial xi * halfWaveMultiplier WaveSign.plus z.2 xi) z.1) z := by
          unfold wfBaseSpectrum
          exact spaceTimeFourierInv_jointSchwartzModulatedAnnularProfile_eq_halfWave_of_eq_norm_on_support
            P.spatial D.time P.normalExtension P.normal_eq_norm z
    _ = angularPiece scale (D.amplitude : Euclidean 2 → Complex) chi
        (D.time : Real → Complex)
        (radialPiece (D.radial : Real → Complex) scale n
          (f : Euclidean 2 → Complex)) z := by
          exact congrFun
            (temporalSchwartzHalfWave_eq_angularPiece_of_schwartzRadialProfile
              P.spatial P.radial f D.time scale (D.amplitude : Euclidean 2 → Complex)
              chi (D.radial : Real → Complex) n P.radial_eq P.spatial_eq) z

/-- Applying a literal vertical window to an inverse joint-Schwartz spectrum
is again an inverse joint-Schwartz spectrum, with its exact affine temporal
factor. -/
private theorem wf_verticalProjection_eq_jointSchwartzRaw
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) (Q : SchwartzMap JointWaveSpaceTime Complex) :
    verticalProjection (beta : Real → Complex) scale n
        (jointSchwartzRaw (FourierTransform.fourierInv Q)) =
      jointSchwartzRaw (FourierTransform.fourierInv
        (wfApplyVerticalSpectrum (wfVerticalProfile beta scale n hscale) Q)) := by
  let m : SchwartzMap Real Complex := wfVerticalProfile beta scale n hscale
  let P : SchwartzMap JointWaveSpaceTime Complex := wfApplyVerticalSpectrum m Q
  have hmult :
      (fun zeta : WaveSpaceTime =>
        verticalMultiplier (beta : Real → Complex) scale n zeta *
          spaceTimeFourier (jointSchwartzRaw (FourierTransform.fourierInv Q)) zeta) =
        jointSchwartzRaw P := by
    funext zeta
    rw [spaceTimeFourier_jointSchwartzRaw]
    change verticalMultiplier (beta : Real → Complex) scale n zeta *
        FourierTransform.fourier
          (FourierTransform.fourierInv Q : JointWaveSpaceTime → Complex)
          (WithLp.toLp 2 zeta) = P (WithLp.toLp 2 zeta)
    rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
    dsimp only [P, m]
    rw [wfApplyVerticalSpectrum_apply, wfVerticalProfile_apply]
    rfl
  unfold verticalProjection
  rw [hmult]
  funext z
  simpa only [P, jointSchwartzRaw, SchwartzMap.fourierInv_coe] using
    (spaceTimeFourierInv_jointSchwartzRaw P z)

/-- The full literal angular/radial/vertical wave has a genuine
joint-Schwartz representative. -/
private theorem angularRadialWave_eq_jointSchwartzRaw_of_profiles
    (D : MSSRadialTimeCutoffs) (scale : Real) (n : Int)
    (angularCutoff wavefrontCutoff : Int → Euclidean 2 → Complex) (nu : Int)
    (f : SchwartzMap (Euclidean 2) Complex) (hscale : 0 < scale)
    (P : WFAngularRadialProfiles D scale n (angularCutoff nu) (wavefrontCutoff nu) f) :
    angularRadialWave (D.vertical : Real → Complex) (D.radial : Real → Complex)
        angularCutoff scale (D.amplitude : Euclidean 2 → Complex) (D.time : Real → Complex) n nu
        (f : Euclidean 2 → Complex) =
      jointSchwartzRaw (wfSourceJointSchwartz D scale n hscale P) := by
  unfold angularRadialWave wfSourceJointSchwartz wfSourceSpectrum
  rw [← wfBasePhysical_eq_angularPiece D scale n (angularCutoff nu) (wavefrontCutoff nu) f P]
  exact wf_verticalProjection_eq_jointSchwartzRaw D.vertical scale n hscale
    (wfBaseSpectrum D P)

private theorem wfSourceSpectrum_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (n : Int)
    (chi tildeChi : Euclidean 2 → Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (hscale : 0 < scale)
    (P : WFAngularRadialProfiles D scale n chi tildeChi f)
    (zeta : WaveSpaceTime) :
    wfSourceSpectrum D scale n hscale P (WithLp.toLp 2 zeta) =
      D.vertical ((Real.sqrt scale)⁻¹ * zeta.2 - n) *
        (P.spatial zeta.1 * FourierTransform.fourier
          (D.time : Real → Complex) (zeta.2 - P.normalExtension zeta.1)) := by
  unfold wfSourceSpectrum wfBaseSpectrum
  rw [wfApplyVerticalSpectrum_apply, wfVerticalProfile_apply,
    jointSchwartzModulatedAnnularProfile_apply]

/-- Exact space--time Fourier formula for the joint-Schwartz source packet. -/
private theorem spaceTimeFourier_wfSourceJointSchwartz
    (D : MSSRadialTimeCutoffs) (scale : Real) (n : Int)
    (chi tildeChi : Euclidean 2 → Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (hscale : 0 < scale)
    (P : WFAngularRadialProfiles D scale n chi tildeChi f)
    (zeta : WaveSpaceTime) :
    spaceTimeFourier (jointSchwartzRaw (wfSourceJointSchwartz D scale n hscale P)) zeta =
      D.vertical ((Real.sqrt scale)⁻¹ * zeta.2 - n) *
        (P.spatial zeta.1 * FourierTransform.fourier
          (D.time : Real → Complex) (zeta.2 - P.normalExtension zeta.1)) := by
  unfold wfSourceJointSchwartz
  rw [spaceTimeFourier_jointSchwartzRaw]
  change FourierTransform.fourier
      (FourierTransform.fourierInv (wfSourceSpectrum D scale n hscale P) :
        JointWaveSpaceTime → Complex) (WithLp.toLp 2 zeta) = _
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  exact wfSourceSpectrum_apply D scale n chi tildeChi f hscale P zeta

/-- The raw factorization made explicit: vertical, angular, annular, radial,
input Fourier, and temporal-normal factors occur in their literal order. -/
private theorem spaceTimeFourier_angularRadialWave_of_profiles
    (D : MSSRadialTimeCutoffs) (scale : Real) (n : Int)
    (angularCutoff wavefrontCutoff : Int → Euclidean 2 → Complex) (nu : Int)
    (f : SchwartzMap (Euclidean 2) Complex) (hscale : 0 < scale)
    (P : WFAngularRadialProfiles D scale n (angularCutoff nu) (wavefrontCutoff nu) f)
    (zeta : WaveSpaceTime) :
    spaceTimeFourier
        (angularRadialWave (D.vertical : Real → Complex) (D.radial : Real → Complex)
          angularCutoff scale (D.amplitude : Euclidean 2 → Complex)
          (D.time : Real → Complex) n nu (f : Euclidean 2 → Complex)) zeta =
      D.vertical ((Real.sqrt scale)⁻¹ * zeta.2 - n) *
        ((angularCutoff nu zeta.1 * D.amplitude (scale⁻¹ • zeta.1)) *
          (P.radial zeta.1 * FourierTransform.fourier
            (f : Euclidean 2 → Complex) zeta.1) *
          FourierTransform.fourier (D.time : Real → Complex)
            (zeta.2 - P.normalExtension zeta.1)) := by
  rw [angularRadialWave_eq_jointSchwartzRaw_of_profiles
    D scale n angularCutoff wavefrontCutoff nu f hscale P]
  rw [spaceTimeFourier_wfSourceJointSchwartz D scale n
    (angularCutoff nu) (wavefrontCutoff nu) f hscale P zeta]
  rw [P.spatial_eq]

/-- On the exact source spectrum, the raw wave-front multiplier is represented
by a genuine joint-Schwartz cutoff.  The two supplied local extension fields
are used only after nonvanishing forces the spatial profile to be active. -/
private theorem wfWavefrontJointCutoff_realizes_wavefrontMultiplier
    (D : MSSRadialTimeCutoffs) (normal : SchwartzMap Real Complex)
    (scale gamma : Real) (n : Int)
    (chi tildeChi : Euclidean 2 → Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (hscale : 0 < scale)
    (P : WFAngularRadialProfiles D scale n chi tildeChi f)
    (zeta : WaveSpaceTime) :
    wavefrontMultiplier tildeChi (normal : Real → Complex) scale gamma zeta *
        FourierTransform.fourier
          (wfSourceJointSchwartz D scale n hscale P : JointWaveSpaceTime → Complex)
          (WithLp.toLp 2 zeta) =
      wfWavefrontJointCutoff normal scale gamma hscale P (WithLp.toLp 2 zeta) *
        FourierTransform.fourier
          (wfSourceJointSchwartz D scale n hscale P : JointWaveSpaceTime → Complex)
          (WithLp.toLp 2 zeta) := by
  by_cases hsource : FourierTransform.fourier
      (wfSourceJointSchwartz D scale n hscale P : JointWaveSpaceTime → Complex)
      (WithLp.toLp 2 zeta) = 0
  · simp [hsource]
  · have hfactor := spaceTimeFourier_wfSourceJointSchwartz D scale n chi tildeChi f
      hscale P zeta
    rw [spaceTimeFourier_jointSchwartzRaw] at hfactor
    rw [hfactor] at hsource
    have hbase : P.spatial zeta.1 * FourierTransform.fourier
        (D.time : Real → Complex) (zeta.2 - P.normalExtension zeta.1) ≠ 0 :=
      (mul_ne_zero_iff.mp hsource).2
    have hspatial : P.spatial zeta.1 ≠ 0 := (mul_ne_zero_iff.mp hbase).1
    rw [wavefrontMultiplier]
    unfold wfWavefrontJointCutoff
    rw [jointSchwartzSpatialNormalCutoff_apply, wfNormalProfile_apply,
      P.wavefrontAngular_eq zeta.1 hspatial,
      P.normal_eq_norm zeta.1 hspatial]

/-- Exact Fourier-side residual identity.  This is the kernel-proof input:
the residual carries the literal defect `1 - Q_nu` times the fully factored
source spectrum, rather than an abstract replacement wave. -/
private theorem wfResidualSpectrum_apply
    (D : MSSRadialTimeCutoffs) (normal : SchwartzMap Real Complex)
    (scale gamma : Real) (n : Int)
    (chi tildeChi : Euclidean 2 → Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (hscale : 0 < scale)
    (P : WFAngularRadialProfiles D scale n chi tildeChi f)
    (zeta : WaveSpaceTime) :
    wfResidualSpectrum D normal scale gamma n hscale P (WithLp.toLp 2 zeta) =
      ((1 : Complex) - wavefrontMultiplier tildeChi (normal : Real → Complex)
        scale gamma zeta) *
        (D.vertical ((Real.sqrt scale)⁻¹ * zeta.2 - n) *
          (P.spatial zeta.1 * FourierTransform.fourier
            (D.time : Real → Complex) (zeta.2 - P.normalExtension zeta.1))) := by
  let S : SchwartzMap JointWaveSpaceTime Complex :=
    wfSourceSpectrum D scale n hscale P
  let G : SchwartzMap JointWaveSpaceTime Complex :=
    wfSourceJointSchwartz D scale n hscale P
  let q : SchwartzMap JointWaveSpaceTime Complex :=
    wfWavefrontJointCutoff normal scale gamma hscale P
  have hG : FourierTransform.fourier (G : JointWaveSpaceTime → Complex)
      (WithLp.toLp 2 zeta) = S (WithLp.toLp 2 zeta) := by
    dsimp only [G, S, wfSourceJointSchwartz]
    rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  have hrealized : q (WithLp.toLp 2 zeta) * S (WithLp.toLp 2 zeta) =
      wavefrontMultiplier tildeChi (normal : Real → Complex) scale gamma zeta *
        S (WithLp.toLp 2 zeta) := by
    rw [← hG]
    exact (wfWavefrontJointCutoff_realizes_wavefrontMultiplier D normal scale gamma n
      chi tildeChi f hscale P zeta).symm
  change S (WithLp.toLp 2 zeta) -
      jointSchwartzSpectralCutoffProduct q G (WithLp.toLp 2 zeta) = _
  rw [jointSchwartzSpectralCutoffProduct,
    SchwartzMap.smulLeftCLM_apply_apply q.hasTemperateGrowth]
  rw [smul_eq_mul]
  change S (WithLp.toLp 2 zeta) - q (WithLp.toLp 2 zeta) *
      FourierTransform.fourier (G : JointWaveSpaceTime → Complex)
        (WithLp.toLp 2 zeta) = _
  rw [hG, hrealized]
  rw [wfSourceSpectrum_apply D scale n chi tildeChi f hscale P zeta]
  ring

/-- The raw wave-front projection of one active angular/radial wave is a
joint-Schwartz spectral cutoff output, with no unproved raw Fourier bridge. -/
private theorem wavefrontAngularRadialWave_eq_jointSchwartzSpectralCutoffOutput_of_profiles
    (D : MSSRadialTimeCutoffs) (normal : SchwartzMap Real Complex)
    (scale gamma : Real) (n : Int)
    (angularCutoff wavefrontCutoff : Int → Euclidean 2 → Complex) (nu : Int)
    (f : SchwartzMap (Euclidean 2) Complex) (hscale : 0 < scale)
    (P : WFAngularRadialProfiles D scale n (angularCutoff nu) (wavefrontCutoff nu) f) :
    wavefrontAngularRadialWave (D.vertical : Real → Complex) (D.radial : Real → Complex)
        angularCutoff wavefrontCutoff (normal : Real → Complex) scale gamma
        (D.amplitude : Euclidean 2 → Complex) (D.time : Real → Complex) n nu
        (f : Euclidean 2 → Complex) =
      jointSchwartzSpectralCutoffOutput
        (wfWavefrontJointCutoff normal scale gamma hscale P)
        (wfSourceJointSchwartz D scale n hscale P) := by
  unfold wavefrontAngularRadialWave
  rw [angularRadialWave_eq_jointSchwartzRaw_of_profiles
    D scale n angularCutoff wavefrontCutoff nu f hscale P]
  exact wavefrontProjection_eq_jointSchwartzSpectralCutoffOutput_of_realization
    (wavefrontCutoff nu) (normal : Real → Complex) scale gamma
    (wfWavefrontJointCutoff normal scale gamma hscale P)
    (wfSourceJointSchwartz D scale n hscale P)
    (wfWavefrontJointCutoff_realizes_wavefrontMultiplier D normal scale gamma n
      (angularCutoff nu) (wavefrontCutoff nu) f hscale P)

/-- Physical-space form of the same kernel input: the literal difference in
the wave-front localization lemma is exactly the inverse joint Fourier
transform of `wfResidualSpectrum`. -/
private theorem angularRadialWave_sub_wavefrontAngularRadialWave_eq_jointSchwartzRaw_of_profiles
    (D : MSSRadialTimeCutoffs) (normal : SchwartzMap Real Complex)
    (scale gamma : Real) (n : Int)
    (angularCutoff wavefrontCutoff : Int → Euclidean 2 → Complex) (nu : Int)
    (f : SchwartzMap (Euclidean 2) Complex) (hscale : 0 < scale)
    (P : WFAngularRadialProfiles D scale n (angularCutoff nu) (wavefrontCutoff nu) f) :
    angularRadialWave (D.vertical : Real → Complex) (D.radial : Real → Complex)
        angularCutoff scale (D.amplitude : Euclidean 2 → Complex) (D.time : Real → Complex)
        n nu (f : Euclidean 2 → Complex) -
      wavefrontAngularRadialWave (D.vertical : Real → Complex) (D.radial : Real → Complex)
        angularCutoff wavefrontCutoff (normal : Real → Complex) scale gamma
        (D.amplitude : Euclidean 2 → Complex) (D.time : Real → Complex) n nu
        (f : Euclidean 2 → Complex) =
      jointSchwartzRaw (FourierTransform.fourierInv
        (wfResidualSpectrum D normal scale gamma n hscale P)) := by
  rw [angularRadialWave_eq_jointSchwartzRaw_of_profiles
    D scale n angularCutoff wavefrontCutoff nu f hscale P]
  rw [wavefrontAngularRadialWave_eq_jointSchwartzSpectralCutoffOutput_of_profiles
    D normal scale gamma n angularCutoff wavefrontCutoff nu f hscale P]
  unfold jointSchwartzSpectralCutoffOutput wfSourceJointSchwartz wfResidualSpectrum
  funext z
  change (FourierTransform.fourierInv (wfSourceSpectrum D scale n hscale P) :
      SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 z) -
      (FourierTransform.fourierInv
        (jointSchwartzSpectralCutoffProduct
          (wfWavefrontJointCutoff normal scale gamma hscale P)
          (FourierTransform.fourierInv (wfSourceSpectrum D scale n hscale P))) :
        SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 z) =
      (FourierTransform.fourierInv
        (wfSourceSpectrum D scale n hscale P -
          jointSchwartzSpectralCutoffProduct
            (wfWavefrontJointCutoff normal scale gamma hscale P)
            (FourierTransform.fourierInv (wfSourceSpectrum D scale n hscale P))) :
        SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 z)
  have hsub : FourierTransform.fourierInv
      (wfSourceSpectrum D scale n hscale P -
        jointSchwartzSpectralCutoffProduct
          (wfWavefrontJointCutoff normal scale gamma hscale P)
          (FourierTransform.fourierInv (wfSourceSpectrum D scale n hscale P))) =
      FourierTransform.fourierInv (wfSourceSpectrum D scale n hscale P) -
        FourierTransform.fourierInv
          (jointSchwartzSpectralCutoffProduct
            (wfWavefrontJointCutoff normal scale gamma hscale P)
            (FourierTransform.fourierInv (wfSourceSpectrum D scale n hscale P))) := by
      rw [sub_eq_add_neg, FourierTransform.fourierInv_add,
        FourierTransform.fourierInv_neg]
      rfl
  rw [hsub]
  rfl

private theorem wf_normal_thickness_of_support
    {scale gamma u : Real} (hscale : 0 < scale)
    (hu : |scale ^ (-gamma) * u| < 2) :
    |u| ≤ 2 * scale ^ gamma := by
  have hpowpos : 0 < scale ^ gamma := Real.rpow_pos_of_pos hscale _
  have hinv : scale ^ (-gamma) = (scale ^ gamma)⁻¹ := by
    rw [← Real.rpow_neg hscale.le]
  rw [hinv, abs_mul, abs_inv, abs_of_pos hpowpos] at hu
  have hu' : |u| / (scale ^ gamma) < 2 := by
    rw [div_eq_mul_inv]
    simpa [mul_comm] using hu
  have hlt : |u| < 2 * scale ^ gamma :=
    (div_lt_iff₀ hpowpos).mp hu'
  exact hlt.le

private theorem wf_annular_of_scaled_amplitude_nonzero
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 2 ≤ scale)
    (xi : Euclidean 2)
    (hamp : D.amplitude (scale⁻¹ • xi) ≠ 0) :
    scale / 4 ≤ ‖xi‖ ∧ ‖xi‖ ≤ 4 * scale := by
  have hscale_pos : 0 < scale := by linarith
  have hsupport := D.amplitude_support_annulus (scale⁻¹ • xi) hamp
  rw [norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hscale_pos] at hsupport
  have hsupport' : ‖xi‖ / scale ∈ Icc (1 / 2 : Real) 2 := by
    simpa [div_eq_mul_inv, mul_comm] using hsupport
  constructor
  · have hhalf : scale / 2 ≤ ‖xi‖ := by
      rw [show scale / 2 = (1 / 2 : Real) * scale by ring]
      exact (le_div_iff₀ hscale_pos).mp hsupport'.1
    linarith
  · have htwo : ‖xi‖ ≤ 2 * scale :=
      (div_le_iff₀ hscale_pos).mp hsupport'.2
    linarith

/-- Direct plate support for one active angular/radial wave.  This uses the
exact raw-to-joint factorization above, so no independent raw Fourier
realization hypothesis remains. -/
private theorem support_wavefrontAngularRadialWave_subset_conicPlate_of_profiles
    (D : MSSRadialTimeCutoffs) (normal : SchwartzMap Real Complex)
    (scale gamma angularConstant : Real) (direction : Euclidean 2) (n : Int)
    (angularCutoff wavefrontCutoff : Int → Euclidean 2 → Complex) (nu : Int)
    (f : SchwartzMap (Euclidean 2) Complex) (hscale : 2 ≤ scale)
    (P : WFAngularRadialProfiles D scale n (angularCutoff nu) (wavefrontCutoff nu) f)
    (hangular : Function.support (wavefrontCutoff nu) ⊆
      angularSector direction (angularConstant * scale ^ (-(1 / 2 : Real))))
    (hnormal : ∀ s : Real, normal s ≠ 0 → |s| < 2) :
    Function.support
        (spaceTimeFourier
          (wavefrontAngularRadialWave (D.vertical : Real → Complex)
            (D.radial : Real → Complex) angularCutoff wavefrontCutoff
            (normal : Real → Complex) scale gamma
            (D.amplitude : Euclidean 2 → Complex) (D.time : Real → Complex) n nu
            (f : Euclidean 2 → Complex))) ⊆
      conicPlate scale gamma angularConstant n direction := by
  have hscale_pos : 0 < scale := by linarith
  rw [wavefrontAngularRadialWave_eq_jointSchwartzSpectralCutoffOutput_of_profiles
    D normal scale gamma n angularCutoff wavefrontCutoff nu f hscale_pos P]
  intro zeta hzeta
  change spaceTimeFourier
      (jointSchwartzSpectralCutoffOutput
        (wfWavefrontJointCutoff normal scale gamma hscale_pos P)
        (wfSourceJointSchwartz D scale n hscale_pos P)) zeta ≠ 0 at hzeta
  rw [spaceTimeFourier_jointSchwartzSpectralCutoffOutput] at hzeta
  rw [jointSchwartzSpectralCutoffProduct,
    SchwartzMap.smulLeftCLM_apply_apply
      (wfWavefrontJointCutoff normal scale gamma hscale_pos P).hasTemperateGrowth,
    SchwartzMap.fourier_coe, smul_eq_mul] at hzeta
  have hmultSource :
      wavefrontMultiplier (wavefrontCutoff nu) (normal : Real → Complex)
          scale gamma zeta *
        FourierTransform.fourier
          (wfSourceJointSchwartz D scale n hscale_pos P : JointWaveSpaceTime → Complex)
          (WithLp.toLp 2 zeta) ≠ 0 := by
    rw [wfWavefrontJointCutoff_realizes_wavefrontMultiplier D normal scale gamma n
      (angularCutoff nu) (wavefrontCutoff nu) f hscale_pos P zeta]
    exact hzeta
  rcases mul_ne_zero_iff.mp hmultSource with ⟨hmult, hsource⟩
  rw [wavefrontMultiplier] at hmult
  rcases mul_ne_zero_iff.mp hmult with ⟨hangularActive, hnormalActive⟩
  have hsourceFactor := spaceTimeFourier_wfSourceJointSchwartz D scale n
    (angularCutoff nu) (wavefrontCutoff nu) f hscale_pos P zeta
  have hsourceRaw : spaceTimeFourier
      (jointSchwartzRaw (wfSourceJointSchwartz D scale n hscale_pos P)) zeta ≠ 0 := by
    rw [spaceTimeFourier_jointSchwartzRaw]
    exact hsource
  rw [hsourceFactor] at hsourceRaw
  rcases mul_ne_zero_iff.mp hsourceRaw with ⟨hvertical, hspatialTime⟩
  have hspatial : P.spatial zeta.1 ≠ 0 := (mul_ne_zero_iff.mp hspatialTime).1
  rw [P.spatial_eq] at hspatial
  have hamp : D.amplitude (scale⁻¹ • zeta.1) ≠ 0 := by
    exact (mul_ne_zero_iff.mp (mul_ne_zero_iff.mp hspatial).1).2
  refine ⟨(wf_annular_of_scaled_amplitude_nonzero D scale hscale zeta.1 hamp).1,
    (wf_annular_of_scaled_amplitude_nonzero D scale hscale zeta.1 hamp).2,
    hangular hangularActive, ?_, ?_⟩
  · exact (D.vertical_support _ hvertical).le
  · apply wf_normal_thickness_of_support hscale_pos
    exact hnormal _ hnormalActive


private noncomputable def scratchWavefrontInputSpatialProfile
    (D : MSSWavefrontKernelData) (scale : Real) (n nu : Int)
    (f : SchwartzMap (Euclidean 2) Complex) : SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex (D.spatialProfile scale n nu : Euclidean 2 → Complex)
    (FourierTransform.fourier f)

private theorem scratchWavefrontInputSpatialProfile_apply
    (D : MSSWavefrontKernelData) (scale : Real) (n nu : Int)
    (f : SchwartzMap (Euclidean 2) Complex) (xi : Euclidean 2) :
    scratchWavefrontInputSpatialProfile D scale n nu f xi =
      D.spatialProfile scale n nu xi *
        FourierTransform.fourier (f : Euclidean 2 → Complex) xi := by
  unfold scratchWavefrontInputSpatialProfile
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (D.spatialProfile scale n nu).hasTemperateGrowth]
  rw [smul_eq_mul]
  rw [← SchwartzMap.fourier_coe]

/-- The profile package realizing one literal raw packet. -/
private noncomputable def scratchWavefrontRawProfiles
    (D : MSSWavefrontKernelData) (R : MSSWavefrontRawProfileRealization D)
    (scale : Real) (hscale : 0 < scale) (n nu : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    WFAngularRadialProfiles D.radialTime scale n (D.chi scale nu) (D.tildeChi scale nu) f where
  radial := R.radialProfile scale n
  spatial := scratchWavefrontInputSpatialProfile D scale n nu f
  normalExtension := D.normalCoordinate scale
  wavefrontAngular := R.wavefrontAngularProfile scale nu
  radial_eq := R.radialProfile_apply scale n
  spatial_eq := by
    intro xi
    rw [scratchWavefrontInputSpatialProfile_apply, D.spatialProfile_apply,
      R.radialProfile_apply]
    ring
  normal_eq_norm := by
    intro xi hxi
    change scratchWavefrontInputSpatialProfile D scale n nu f xi ≠ 0 at hxi
    rw [scratchWavefrontInputSpatialProfile_apply] at hxi
    have hspatial : D.spatialProfile scale n nu xi ≠ 0 :=
      (mul_ne_zero_iff.mp hxi).1
    exact normalCoordinate_eq_norm_on_spatial_support D
      hscale n nu hspatial
  wavefrontAngular_eq := by
    intro xi hxi
    change scratchWavefrontInputSpatialProfile D scale n nu f xi ≠ 0 at hxi
    rw [scratchWavefrontInputSpatialProfile_apply] at hxi
    have hspatial : D.spatialProfile scale n nu xi ≠ 0 :=
      (mul_ne_zero_iff.mp hxi).1
    exact R.wavefrontAngularProfile_eq_on_spatial scale n nu xi hspatial

private def scratchWavefrontJointInputFourierFactor
    (f : SchwartzMap (Euclidean 2) Complex) : JointWaveSpaceTime → Complex :=
  fun z => FourierTransform.fourier (f : Euclidean 2 → Complex) z.fst

private theorem scratchWavefrontJointInputFourierFactor_hasTemperateGrowth
    (f : SchwartzMap (Euclidean 2) Complex) :
    (scratchWavefrontJointInputFourierFactor f).HasTemperateGrowth := by
  change ((FourierTransform.fourier (f : Euclidean 2 → Complex)) ∘
    WithLp.fstL 2 Real (Euclidean 2) Real).HasTemperateGrowth
  rw [← SchwartzMap.fourier_coe]
  exact (FourierTransform.fourier f).hasTemperateGrowth.comp
    (WithLp.fstL 2 Real (Euclidean 2) Real).hasTemperateGrowth

/-- The joint-Schwartz spectrum obtained by attaching the input Fourier
transform to the f-independent packet multiplier. -/
private noncomputable def scratchWavefrontPacketResidualSpectrum
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale)
    (n nu : Int) (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  SchwartzMap.smulLeftCLM Complex (scratchWavefrontJointInputFourierFactor f)
    (scratchWavefrontPacketResidualMultiplier D scale hscale n nu)

private theorem scratchWavefrontPacketResidualSpectrum_apply
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale)
    (n nu : Int) (f : SchwartzMap (Euclidean 2) Complex) (zeta : WaveSpaceTime) :
    scratchWavefrontPacketResidualSpectrum D scale hscale n nu f
        (WithLp.toLp 2 zeta) =
      FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1 *
        scratchWavefrontPacketResidualMultiplier D scale hscale n nu
          (WithLp.toLp 2 zeta) := by
  unfold scratchWavefrontPacketResidualSpectrum
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (scratchWavefrontJointInputFourierFactor_hasTemperateGrowth f)]
  rfl

private theorem scratchWavefrontPacketResidualSpectrum_eq_rawResidualSpectrum
    (D : MSSWavefrontKernelData) (R : MSSWavefrontRawProfileRealization D)
    (scale : Real) (hscale : 0 < scale) (n nu : Int)
    (hnu : nu ∈ D.angularIndices scale)
    (f : SchwartzMap (Euclidean 2) Complex) :
    wfResidualSpectrum D.radialTime D.normal scale D.gamma n hscale
      (scratchWavefrontRawProfiles D R scale hscale n nu f) =
      scratchWavefrontPacketResidualSpectrum D scale hscale n nu f := by
  ext z
  have hz : WithLp.toLp 2 (z.fst, z.snd) = z := by
    apply (WithLp.ext_iff 2).2
    rfl
  rw [← hz]
  let P := scratchWavefrontRawProfiles D R scale hscale n nu f
  let M := scratchWavefrontPacketResidualMultiplier D scale hscale n nu
  rw [wfResidualSpectrum_apply, scratchWavefrontPacketResidualSpectrum_apply]
  by_cases hspatial : D.spatialProfile scale n nu z.fst = 0
  · have hPzero : P.spatial z.fst = 0 := by
      change scratchWavefrontInputSpatialProfile D scale n nu f z.fst = 0
      rw [scratchWavefrontInputSpatialProfile_apply, hspatial, zero_mul]
    rw [scratchWavefrontPacketResidualMultiplier_apply, hspatial, hPzero]
    ring
  · have hchi : D.chi scale nu z.fst ≠ 0 := by
      rw [D.spatialProfile_apply] at hspatial
      exact (mul_ne_zero_iff.mp hspatial).1
    have htilde : D.tildeChi scale nu z.fst = 1 :=
      D.tildeChi_one_on_chi_support scale nu hnu z.fst hchi
    have hnormal : D.normalCoordinate scale z.fst = ‖z.fst‖ :=
      normalCoordinate_eq_norm_on_spatial_support D hscale n nu hspatial
    have hPspatial : P.spatial z.fst =
        D.spatialProfile scale n nu z.fst *
          FourierTransform.fourier (f : Euclidean 2 → Complex) z.fst := by
      change scratchWavefrontInputSpatialProfile D scale n nu f z.fst = _
      exact scratchWavefrontInputSpatialProfile_apply D scale n nu f z.fst
    rw [hPspatial]
    rw [show P.normalExtension z.fst = ‖z.fst‖ by
      rw [show P = scratchWavefrontRawProfiles D R scale hscale n nu f by rfl]
      exact hnormal]
    rw [scratchWavefrontPacketResidualMultiplier_apply,
      D.normalTail_apply, hnormal, wavefrontMultiplier, htilde]
    ring

private theorem scratchWavefrontPacketResidual_eq_jointSchwartzRaw_fourierInvSpectrum
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale)
    (n nu : Int) (f : SchwartzMap (Euclidean 2) Complex) :
    scratchWavefrontPacketResidual D scale hscale n nu f =
      jointSchwartzRaw (FourierTransform.fourierInv
        (scratchWavefrontPacketResidualSpectrum D scale hscale n nu f)) := by
  funext z
  rw [scratchWavefrontPacketResidual_eq_inverse_factorizedSpectrum]
  change spaceTimeFourierInv (fun zeta : WaveSpaceTime =>
      jointSchwartzRaw (scratchWavefrontPacketResidualMultiplier D scale hscale n nu) zeta *
        FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1) z = _
  calc
    spaceTimeFourierInv (fun zeta : WaveSpaceTime =>
        jointSchwartzRaw (scratchWavefrontPacketResidualMultiplier D scale hscale n nu) zeta *
          FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1) z =
        spaceTimeFourierInv
          (jointSchwartzRaw
            (scratchWavefrontPacketResidualSpectrum D scale hscale n nu f)) z := by
          congr 1
          funext zeta
          change scratchWavefrontPacketResidualMultiplier D scale hscale n nu
              (WithLp.toLp 2 zeta) *
              FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1 =
            scratchWavefrontPacketResidualSpectrum D scale hscale n nu f
              (WithLp.toLp 2 zeta)
          rw [scratchWavefrontPacketResidualSpectrum_apply]
          ring
    _ = jointSchwartzRaw (FourierTransform.fourierInv
        (scratchWavefrontPacketResidualSpectrum D scale hscale n nu f)) z := by
          rw [spaceTimeFourierInv_jointSchwartzRaw]
          exact (congrFun (SchwartzMap.fourierInv_coe
            (scratchWavefrontPacketResidualSpectrum D scale hscale n nu f))
              (WithLp.toLp 2 z)).symm

/-- Literal raw packet equality: the f-independent residual multiplier used
by the kernel proof is exactly `angularRadialWave - wavefrontAngularRadialWave`.
-/
private theorem mssAngularRadialWave_sub_mssWavefrontAngularRadialWave_eq_packetResidual
    (D : MSSWavefrontKernelData) (R : MSSWavefrontRawProfileRealization D)
    (scale : Real) (hscale : 0 < scale) (n nu : Int)
    (hnu : nu ∈ D.angularIndices scale)
    (f : SchwartzMap (Euclidean 2) Complex) :
    mssAngularRadialWave D.toMSSWavefrontCutoffData scale n nu (f : Euclidean 2 → Complex) -
      mssWavefrontAngularRadialWave D.toMSSWavefrontCutoffData scale D.gamma n nu
        (f : Euclidean 2 → Complex) =
      scratchWavefrontPacketResidual D scale hscale n nu f := by
  change angularRadialWave (D.radialTime.vertical : Real → Complex)
      (D.radialTime.radial : Real → Complex) (D.chi scale) scale
      (D.radialTime.amplitude : Euclidean 2 → Complex)
      (D.radialTime.time : Real → Complex) n nu (f : Euclidean 2 → Complex) -
    wavefrontAngularRadialWave (D.radialTime.vertical : Real → Complex)
      (D.radialTime.radial : Real → Complex) (D.chi scale) (D.tildeChi scale)
      (D.normal : Real → Complex) scale D.gamma
      (D.radialTime.amplitude : Euclidean 2 → Complex)
      (D.radialTime.time : Real → Complex) n nu (f : Euclidean 2 → Complex) = _
  rw [angularRadialWave_sub_wavefrontAngularRadialWave_eq_jointSchwartzRaw_of_profiles
    D.radialTime D.normal scale D.gamma n (D.chi scale) (D.tildeChi scale) nu f hscale
    (scratchWavefrontRawProfiles D R scale hscale n nu f)]
  rw [scratchWavefrontPacketResidual_eq_jointSchwartzRaw_fourierInvSpectrum]
  rw [scratchWavefrontPacketResidualSpectrum_eq_rawResidualSpectrum
    D R scale hscale n nu hnu f]

/-- The literal raw residual is measurable, as needed by finite square-function
aggregation. -/
private theorem mssAngularRadialWave_sub_mssWavefrontAngularRadialWave_aestronglyMeasurable
    (D : MSSWavefrontKernelData) (R : MSSWavefrontRawProfileRealization D)
    (scale : Real) (hscale : 0 < scale) (n nu : Int)
    (hnu : nu ∈ D.angularIndices scale)
    (f : SchwartzMap (Euclidean 2) Complex) :
    AEStronglyMeasurable
      (mssAngularRadialWave D.toMSSWavefrontCutoffData scale n nu (f : Euclidean 2 → Complex) -
        mssWavefrontAngularRadialWave D.toMSSWavefrontCutoffData scale D.gamma n nu
          (f : Euclidean 2 → Complex)) volume := by
  rw [mssAngularRadialWave_sub_mssWavefrontAngularRadialWave_eq_packetResidual
    D R scale hscale n nu hnu f]
  rw [scratchWavefrontPacketResidual_eq_jointSchwartzRaw_fourierInvSpectrum]
  change AEStronglyMeasurable (fun z : WaveSpaceTime =>
    (FourierTransform.fourierInv
      (scratchWavefrontPacketResidualSpectrum D scale hscale n nu f) :
        SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 z)) volume
  exact ((FourierTransform.fourierInv
      (scratchWavefrontPacketResidualSpectrum D scale hscale n nu f)).continuous.comp
    (WithLp.prod_continuous_toLp 2 (Euclidean 2) Real)).aestronglyMeasurable

/- Private one-packet kernel closure for wave-front localization. -/
open scoped BigOperators

private theorem scratch_wavefront_jointSchwartzRaw_integrable_prod
    (M : SchwartzMap JointWaveSpaceTime Complex) :
    Integrable (fun z : WaveSpaceTime => M (WithLp.toLp 2 z))
      (volume.prod volume) := by
  have hpres : MeasurePreserving
      (MeasurableEquiv.toLp 2 WaveSpaceTime) volume volume :=
    WithLp.volume_preserving_toLp (Euclidean 2) Real
  exact
    (hpres.integrable_comp_emb
      (MeasurableEquiv.toLp 2 (Euclidean 2 × Real)).measurableEmbedding).mpr
      M.integrable

private theorem scratch_wavefront_source_kernel_triple_integrable
    (M : SchwartzMap JointWaveSpaceTime Complex)
    (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) (t : Real) :
    Integrable (fun zy : WaveSpaceTime × Euclidean 2 =>
      (Real.fourierChar (inner Real zy.1.2 t) : Complex) *
        (Real.fourierChar (inner Real zy.1.1 x) : Complex) *
          M (WithLp.toLp 2 zy.1) *
            (Real.fourierChar (-inner Real zy.2 zy.1.1) : Complex) * f zy.2)
      ((volume.prod volume).prod volume) := by
  let Mraw : WaveSpaceTime → Complex := fun z => M (WithLp.toLp 2 z)
  have hbase : Integrable (fun zy : WaveSpaceTime × Euclidean 2 =>
      Mraw zy.1 * f zy.2) ((volume.prod volume).prod volume) :=
    (scratch_wavefront_jointSchwartzRaw_integrable_prod M).mul_prod f.integrable
  refine hbase.congr' ?_ ?_
  · fun_prop
  · filter_upwards with zy
    simp only [Mraw, norm_mul, Circle.norm_coe, one_mul]
    ring

private theorem scratch_wavefront_spaceTimeFourierInv_eq_productIntegral
    (G : WaveSpaceTime → Complex)
    (hG : Integrable G (volume.prod volume))
    (u : Euclidean 2) (t : Real) :
    spaceTimeFourierInv G (u, t) =
      ∫ z : WaveSpaceTime,
        (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 u) : Complex) * G z := by
  let Q : Euclidean 2 → Real → Complex := fun xi tau =>
    (Real.fourierChar (inner Real tau t) : Complex) *
      (Real.fourierChar (inner Real xi u) : Complex) * G (xi, tau)
  have hQ : Integrable (Function.uncurry Q) (volume.prod volume) := by
    have hphaseT : Continuous (fun z : WaveSpaceTime =>
        (Real.fourierChar (inner Real z.2 t) : Complex)) := by
      fun_prop
    have hphaseU : Continuous (fun z : WaveSpaceTime =>
        (Real.fourierChar (inner Real z.1 u) : Complex)) := by
      fun_prop
    refine hG.congr' ?_ ?_
    · exact
        ((hphaseT.aestronglyMeasurable.mul hphaseU.aestronglyMeasurable).mul
          hG.aestronglyMeasurable)
    · filter_upwards with z
      simp only [Q, Function.uncurry, norm_mul, Circle.norm_coe, one_mul]
  have hleft :
      spaceTimeFourierInv G (u, t) = ∫ tau : Real, ∫ xi : Euclidean 2, Q xi tau := by
    unfold spaceTimeFourierInv
    rw [Real.fourierInv_eq]
    apply integral_congr_ae
    filter_upwards with tau
    rw [Real.fourierInv_eq]
    change
      (Real.fourierChar (inner Real tau t) : Complex) *
          ∫ xi : Euclidean 2,
            (Real.fourierChar (inner Real xi u) : Complex) * G (xi, tau) =
        ∫ xi : Euclidean 2, Q xi tau
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with xi
    simp only [Q]
    ring
  have hQswap : Integrable
      (Function.uncurry (fun tau : Real => fun xi : Euclidean 2 => Q xi tau))
      (volume.prod volume) := by
    convert hQ.swap using 1
    ext z
    rcases z with ⟨tau, xi⟩
    rfl
  have hswap :
      (∫ tau : Real, ∫ xi : Euclidean 2, Q xi tau) =
        ∫ xi : Euclidean 2, ∫ tau : Real, Q xi tau :=
    integral_integral_swap hQswap
  have hprod :
      (∫ xi : Euclidean 2, ∫ tau : Real, Q xi tau) =
        ∫ z : WaveSpaceTime, Q z.1 z.2 := by
    rw [Measure.volume_eq_prod]
    exact (integral_prod (Function.uncurry Q) hQ).symm
  calc
    spaceTimeFourierInv G (u, t) = ∫ tau : Real, ∫ xi : Euclidean 2, Q xi tau := hleft
    _ = ∫ xi : Euclidean 2, ∫ tau : Real, Q xi tau := hswap
    _ = ∫ z : WaveSpaceTime, Q z.1 z.2 := hprod
    _ = ∫ z : WaveSpaceTime,
        (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 u) : Complex) * G z := by
      rfl

private theorem scratch_wavefront_jointSchwartz_mul_spatialFourier_integrable
    (M : SchwartzMap JointWaveSpaceTime Complex)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun z : WaveSpaceTime =>
      M (WithLp.toLp 2 z) *
        FourierTransform.fourier (f : Euclidean 2 → Complex) z.1)
      (volume.prod volume) := by
  let Mraw : WaveSpaceTime → Complex := fun z => M (WithLp.toLp 2 z)
  have hfhat_le (xi : Euclidean 2) :
      ‖FourierTransform.fourier (f : Euclidean 2 → Complex) xi‖ ≤
        ∫ y : Euclidean 2, ‖f y‖ := by
    rw [Real.fourier_eq]
    calc
      ‖∫ y : Euclidean 2,
          Real.fourierChar (-inner Real y xi) • (f : Euclidean 2 → Complex) y‖ ≤
          ∫ y : Euclidean 2,
            ‖Real.fourierChar (-inner Real y xi) • (f : Euclidean 2 → Complex) y‖ :=
        norm_integral_le_integral_norm _
      _ = ∫ y : Euclidean 2, ‖f y‖ := by
        simp only [Circle.norm_smul]
  refine Integrable.mono'
    ((scratch_wavefront_jointSchwartzRaw_integrable_prod M).norm.mul_const
      (∫ y : Euclidean 2, ‖f y‖)) ?_ ?_
  · exact
      (scratch_wavefront_jointSchwartzRaw_integrable_prod M).aestronglyMeasurable.mul
        (((FourierTransform.fourier f : SchwartzMap (Euclidean 2) Complex).continuous.comp
          continuous_fst).aestronglyMeasurable)
  · filter_upwards with z
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (hfhat_le z.1)
      (norm_nonneg (M (WithLp.toLp 2 z)))

/-- A joint Schwartz multiplier acting on spatial Fourier data is literally
spatial convolution by its inverse joint Fourier kernel. -/
private theorem scratch_wavefront_inverse_factorizedSpectrum_eq_sourceKernel
    (M : SchwartzMap JointWaveSpaceTime Complex)
    (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) (t : Real) :
    spaceTimeFourierInv
        (fun zeta : WaveSpaceTime =>
          jointSchwartzRaw M zeta *
            FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1)
        (x, t) =
      ∫ y : Euclidean 2,
        spaceTimeFourierInv (jointSchwartzRaw M) (x - y, t) * f y := by
  let Mraw : WaveSpaceTime → Complex := fun z => M (WithLp.toLp 2 z)
  have hM : Integrable Mraw (volume.prod volume) :=
    scratch_wavefront_jointSchwartzRaw_integrable_prod M
  have hMfhat : Integrable (fun z : WaveSpaceTime =>
      Mraw z * FourierTransform.fourier (f : Euclidean 2 → Complex) z.1)
      (volume.prod volume) := by
    simpa only [Mraw] using
      scratch_wavefront_jointSchwartz_mul_spatialFourier_integrable M f
  have htriple := scratch_wavefront_source_kernel_triple_integrable M f x t
  have hfourier (z : WaveSpaceTime) :
      (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
            FourierTransform.fourier (f : Euclidean 2 → Complex) z.1 =
        ∫ y : Euclidean 2,
          (Real.fourierChar (inner Real z.2 t) : Complex) *
            (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
              (Real.fourierChar (-inner Real y z.1) : Complex) * f y := by
    rw [Real.fourier_eq]
    change
      (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
          ∫ y : Euclidean 2,
            (Real.fourierChar (-inner Real y z.1) : Complex) * f y = _
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with y
    ring
  have hphase (xi y : Euclidean 2) :
      (Real.fourierChar (inner Real xi x) : Complex) *
          (Real.fourierChar (-inner Real y xi) : Complex) =
        (Real.fourierChar (inner Real xi (x - y)) : Complex) := by
    have harg :
        inner Real xi x + -inner Real y xi = inner Real xi (x - y) := by
      rw [inner_sub_right, real_inner_comm y xi]
      ring
    rw [← Circle.coe_mul, ← Real.fourierChar.map_add_eq_mul, harg]
  have hinner (y : Euclidean 2) :
      (∫ z : WaveSpaceTime,
        (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
            (Real.fourierChar (-inner Real y z.1) : Complex) * f y) =
        spaceTimeFourierInv Mraw (x - y, t) * f y := by
    calc
      (∫ z : WaveSpaceTime,
        (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
            (Real.fourierChar (-inner Real y z.1) : Complex) * f y) =
          ∫ z : WaveSpaceTime,
            ((Real.fourierChar (inner Real z.2 t) : Complex) *
              (Real.fourierChar (inner Real z.1 (x - y)) : Complex) * Mraw z) * f y := by
            apply integral_congr_ae
            filter_upwards with z
            rw [← hphase z.1 y]
            ring
      _ = (∫ z : WaveSpaceTime,
            (Real.fourierChar (inner Real z.2 t) : Complex) *
              (Real.fourierChar (inner Real z.1 (x - y)) : Complex) * Mraw z) * f y := by
            rw [integral_mul_const]
      _ = spaceTimeFourierInv Mraw (x - y, t) * f y := by
            rw [← scratch_wavefront_spaceTimeFourierInv_eq_productIntegral Mraw hM (x - y) t]
  calc
    spaceTimeFourierInv
        (fun zeta : WaveSpaceTime =>
          jointSchwartzRaw M zeta *
            FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1)
        (x, t) =
        ∫ z : WaveSpaceTime,
          (Real.fourierChar (inner Real z.2 t) : Complex) *
            (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
              FourierTransform.fourier (f : Euclidean 2 → Complex) z.1 := by
          simpa only [Mraw, jointSchwartzRaw, mul_assoc] using
            (scratch_wavefront_spaceTimeFourierInv_eq_productIntegral
              (fun z : WaveSpaceTime =>
                Mraw z * FourierTransform.fourier (f : Euclidean 2 → Complex) z.1)
              hMfhat x t)
    _ = ∫ z : WaveSpaceTime, ∫ y : Euclidean 2,
          (Real.fourierChar (inner Real z.2 t) : Complex) *
            (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
              (Real.fourierChar (-inner Real y z.1) : Complex) * f y := by
          apply integral_congr_ae
          filter_upwards with z
          exact hfourier z
    _ = ∫ y : Euclidean 2, ∫ z : WaveSpaceTime,
          (Real.fourierChar (inner Real z.2 t) : Complex) *
            (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
              (Real.fourierChar (-inner Real y z.1) : Complex) * f y :=
      integral_integral_swap htriple
    _ = ∫ y : Euclidean 2,
          spaceTimeFourierInv Mraw (x - y, t) * f y := by
          apply integral_congr_ae
          filter_upwards with y
          exact hinner y
    _ = ∫ y : Euclidean 2,
          spaceTimeFourierInv (jointSchwartzRaw M) (x - y, t) * f y := by
      rfl

/-- Orientation form used by the mixed Young inequality. -/
private theorem scratch_wavefront_sourceKernel_convolution_orientation
    (K : WaveSpaceTime → Complex) (f : Euclidean 2 → Complex)
    (x : Euclidean 2) (t : Real) :
    (∫ y : Euclidean 2, K (x - y, t) * f y) =
      ∫ y : Euclidean 2, K (y, t) * f (x - y) := by
  let H : Euclidean 2 → Complex := fun u => K (u, t) * f (x - u)
  calc
    (∫ y : Euclidean 2, K (x - y, t) * f y) =
        ∫ y : Euclidean 2, H (x - y) := by
          apply integral_congr_ae
          filter_upwards with y
          simp only [H]
          have hxy : x - (x - y) = y := by abel
          rw [hxy]
    _ = ∫ u : Euclidean 2, H u :=
      integral_sub_left_eq_self H volume x
    _ = ∫ y : Euclidean 2, K (y, t) * f (x - y) := by
      rfl


private theorem scratch_wavefront_weighted_factor_of_holder
    {p r : Real} (hpq : r.HolderConjugate p) (a b : ENNReal) :
    a * b = a ^ r⁻¹ * (a * b ^ p) ^ p⁻¹ := by
  have hp0 : 0 < p := hpq.symm.pos
  have hr0 : 0 < r := hpq.pos
  have hbinv : (b ^ p) ^ p⁻¹ = b := by
    calc
      (b ^ p) ^ p⁻¹ = b ^ (p * p⁻¹) := (ENNReal.rpow_mul _ _ _).symm
      _ = b := by rw [mul_inv_cancel₀ hp0.ne', ENNReal.rpow_one]
  rw [ENNReal.mul_rpow_of_nonneg _ _ hpq.symm.inv_nonneg]
  rw [hbinv]
  calc
    a * b = a ^ (r⁻¹ + p⁻¹) * b := by
      rw [hpq.inv_add_inv_eq_one, ENNReal.rpow_one]
    _ = (a ^ r⁻¹ * a ^ p⁻¹) * b := by
      rw [ENNReal.rpow_add_of_nonneg _ _ hpq.inv_nonneg hpq.symm.inv_nonneg]
    _ = a ^ r⁻¹ * (a ^ p⁻¹ * b) := by ring

private theorem scratch_wavefront_lintegral_spatial_p_pointwise
    (p r : Real) (hpq : r.HolderConjugate p)
    (K q : Euclidean 2 → ENNReal)
    (hK : Measurable K) (hq : Measurable q) (x : Euclidean 2) :
    (∫⁻ y : Euclidean 2, K y * q (x - y)) ^ p ≤
      (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
        ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p := by
  have hp0 : 0 < p := hpq.symm.pos
  have hr0 : 0 < r := hpq.pos
  let a : Euclidean 2 → ENNReal := fun y => K y ^ r⁻¹
  let b : Euclidean 2 → ENNReal := fun y =>
    (K y * q (x - y) ^ p) ^ p⁻¹
  have ha : AEMeasurable a volume := by
    exact (hK.pow measurable_const).aemeasurable
  have hqx : Measurable (fun y : Euclidean 2 => q (x - y)) :=
    hq.comp (measurable_const.sub measurable_id)
  have hb : AEMeasurable b volume := by
    exact ((hK.mul (hqx.pow measurable_const)).pow measurable_const).aemeasurable
  have hholder := ENNReal.lintegral_mul_le_Lp_mul_Lq volume hpq ha hb
  have hleft : (∫⁻ y : Euclidean 2, (a * b) y) =
      ∫⁻ y : Euclidean 2, K y * q (x - y) := by
    apply lintegral_congr
    intro y
    simp only [a, b, Pi.mul_apply]
    exact (scratch_wavefront_weighted_factor_of_holder hpq (K y) (q (x - y))).symm
  have hfirst :
      (∫⁻ y : Euclidean 2, a y ^ r) = ∫⁻ y : Euclidean 2, K y := by
    apply lintegral_congr
    intro y
    simp only [a]
    rw [← ENNReal.rpow_mul, inv_mul_cancel₀ hr0.ne', ENNReal.rpow_one]
  have hsecond :
      (∫⁻ y : Euclidean 2, b y ^ p) =
        ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p := by
    apply lintegral_congr
    intro y
    simp only [b]
    rw [← ENNReal.rpow_mul, inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one]
  have hholder' :
      (∫⁻ y : Euclidean 2, K y * q (x - y)) ≤
        (∫⁻ y : Euclidean 2, K y) ^ r⁻¹ *
          (∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) ^ p⁻¹ := by
    rw [hleft, hfirst, hsecond] at hholder
    simpa only [one_div] using hholder
  have hrp : r⁻¹ * p = p - 1 := by
    rw [← hpq.symm.one_sub_inv]
    field_simp [hp0.ne']
  have hpow := ENNReal.rpow_le_rpow hholder' hp0.le
  calc
    (∫⁻ y : Euclidean 2, K y * q (x - y)) ^ p ≤
        ((∫⁻ y : Euclidean 2, K y) ^ r⁻¹ *
          (∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) ^ p⁻¹) ^ p := hpow
    _ = (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
        ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
      rw [← ENNReal.rpow_mul, ← ENNReal.rpow_mul, hrp,
        inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one]

private theorem scratch_wavefront_lintegral_spatial_p_young
    (p r : Real) (hpq : r.HolderConjugate p)
    (K q : Euclidean 2 → ENNReal)
    (hK : Measurable K) (hq : Measurable q) :
    ∫⁻ x : Euclidean 2, (∫⁻ y : Euclidean 2, K y * q (x - y)) ^ p ≤
      (∫⁻ y : Euclidean 2, K y) ^ p * ∫⁻ x : Euclidean 2, q x ^ p := by
  have hpone : 1 ≤ p := hpq.symm.lt.le
  let H : Euclidean 2 × Euclidean 2 → ENNReal := fun z =>
    K z.2 * q (z.1 - z.2) ^ p
  have hH : Measurable H := by
    exact (hK.comp measurable_snd).mul
      ((hq.comp (measurable_fst.sub measurable_snd)).pow measurable_const)
  have hinner : Measurable (fun x : Euclidean 2 =>
      ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) := by
    exact hH.lintegral_prod_right
  have htranslate (y : Euclidean 2) :
      (∫⁻ x : Euclidean 2, q (x - y) ^ p) = ∫⁻ x : Euclidean 2, q x ^ p := by
    exact (measurePreserving_sub_right (volume : Measure (Euclidean 2)) y).lintegral_comp
      (hq.pow measurable_const)
  have hdouble :
      (∫⁻ x : Euclidean 2, ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) =
        (∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x ^ p := by
    calc
      (∫⁻ x : Euclidean 2, ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) =
          ∫⁻ y : Euclidean 2, ∫⁻ x : Euclidean 2, K y * q (x - y) ^ p := by
            exact lintegral_lintegral_swap hH.aemeasurable
      _ = ∫⁻ y : Euclidean 2, K y * (∫⁻ x : Euclidean 2, q (x - y) ^ p) := by
            apply lintegral_congr
            intro y
            simpa only [Function.comp_apply, Pi.sub_apply, id_eq] using
              (lintegral_const_mul (K y)
                ((hq.comp (measurable_id.sub measurable_const)).pow measurable_const))
      _ = ∫⁻ y : Euclidean 2, K y * (∫⁻ x : Euclidean 2, q x ^ p) := by
            apply lintegral_congr
            intro y
            rw [htranslate y]
      _ = (∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x ^ p :=
            lintegral_mul_const _ hK
  calc
    (∫⁻ x : Euclidean 2, (∫⁻ y : Euclidean 2, K y * q (x - y)) ^ p) ≤
        ∫⁻ x : Euclidean 2, (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
          (∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) := by
      apply lintegral_mono
      intro x
      exact scratch_wavefront_lintegral_spatial_p_pointwise p r hpq K q hK hq x
    _ = (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
        (∫⁻ x : Euclidean 2, ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) := by
      rw [lintegral_const_mul _ hinner]
    _ = (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
        ((∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x ^ p) := by
      rw [hdouble]
    _ = (∫⁻ y : Euclidean 2, K y) ^ p * ∫⁻ x : Euclidean 2, q x ^ p := by
      calc
        (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
            ((∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x ^ p) =
            ((∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
              ∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x ^ p := by
          ring
        _ =
            ((∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
              (∫⁻ y : Euclidean 2, K y) ^ (1 : Real)) *
              ∫⁻ x : Euclidean 2, q x ^ p := by rw [ENNReal.rpow_one]
        _ = (∫⁻ y : Euclidean 2, K y) ^ ((p - 1) + 1) *
              ∫⁻ x : Euclidean 2, q x ^ p := by
          rw [← ENNReal.rpow_add_of_nonneg _ _
            (sub_nonneg.mpr hpone) (by norm_num : (0 : Real) ≤ 1)]
        _ = (∫⁻ y : Euclidean 2, K y) ^ p * ∫⁻ x : Euclidean 2, q x ^ p := by
          congr 2
          ring

private theorem scratch_wavefront_complex_spatial_convolution_p_moment
    (p : Real) (hp : 1 < p)
    (K f : Euclidean 2 → Complex)
    (hK : Measurable K) (hf : Measurable f) :
    ∫⁻ x : Euclidean 2,
        ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ^ p ≤
      (∫⁻ y : Euclidean 2, ‖K y‖ₑ) ^ p *
        ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ p := by
  have hpq : p.conjExponent.HolderConjugate p :=
    (Real.HolderConjugate.conjExponent hp).symm
  have hpoint (x : Euclidean 2) :
      ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ≤
        ∫⁻ y : Euclidean 2, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
    change ‖∫ y : Euclidean 2, K y * f (x - y)‖ₑ ≤ _
    calc
      ‖∫ y : Euclidean 2, K y * f (x - y)‖ₑ ≤
          ∫⁻ y : Euclidean 2, ‖K y * f (x - y)‖ₑ :=
        enorm_integral_le_lintegral_enorm _
      _ = ∫⁻ y : Euclidean 2, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
        apply lintegral_congr
        intro y
        rw [enorm_mul]
  calc
    (∫⁻ x : Euclidean 2,
        ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ^ p) ≤
        ∫⁻ x : Euclidean 2,
          (∫⁻ y : Euclidean 2, ‖K y‖ₑ * ‖f (x - y)‖ₑ) ^ p := by
      apply lintegral_mono
      intro x
      exact ENNReal.rpow_le_rpow (hpoint x) (by positivity)
    _ ≤ (∫⁻ y : Euclidean 2, ‖K y‖ₑ) ^ p *
        ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ p :=
      scratch_wavefront_lintegral_spatial_p_young p p.conjExponent hpq
        (fun y => ‖K y‖ₑ) (fun x => ‖f x‖ₑ) hK.enorm hf.enorm

private theorem scratch_wavefront_ennreal_rpow_inv_cancel
    (p : Real) (hp : 0 < p) (a : ENNReal) :
    (a ^ p) ^ p⁻¹ = a := by
  calc
    (a ^ p) ^ p⁻¹ = a ^ (p * p⁻¹) := (ENNReal.rpow_mul _ _ _).symm
    _ = a := by rw [mul_inv_cancel₀ hp.ne', ENNReal.rpow_one]

private theorem scratch_wavefront_complex_spatial_convolution_p_young
    (p : Real) (hp : 1 < p)
    (K f : Euclidean 2 → Complex)
    (hK : Measurable K) (hf : Measurable f) :
    eLpNorm (K ⋆[ContinuousLinearMap.mul Complex Complex] f) (ENNReal.ofReal p) volume ≤
      (∫⁻ y : Euclidean 2, ‖K y‖ₑ) * eLpNorm f (ENNReal.ofReal p) volume := by
  have hp0 : 0 < p := lt_trans zero_lt_one hp
  let L : ENNReal := ∫⁻ y : Euclidean 2, ‖K y‖ₑ
  let J : ENNReal := ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ p
  have hmoment :
      (∫⁻ x : Euclidean 2,
          ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ^ p) ≤ L ^ p * J := by
    simpa only [L, J] using
      scratch_wavefront_complex_spatial_convolution_p_moment p hp K f hK hf
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top]
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top]
  simp only [ENNReal.toReal_ofReal hp0.le]
  have hroot : (∫⁻ x : Euclidean 2,
          ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ^ p) ^ p⁻¹ ≤
        L * J ^ p⁻¹ := by
    calc
      (∫⁻ x : Euclidean 2,
          ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ^ p) ^ p⁻¹ ≤
          (L ^ p * J) ^ p⁻¹ :=
        ENNReal.rpow_le_rpow hmoment (inv_nonneg.mpr hp0.le)
      _ = (L ^ p) ^ p⁻¹ * J ^ p⁻¹ :=
        ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hp0.le)
      _ = L * J ^ p⁻¹ := by
        rw [scratch_wavefront_ennreal_rpow_inv_cancel p hp0]
  convert hroot using 1 <;> simp only [L, J, one_div]

private theorem scratch_wavefront_mixed_p_lift_of_slice_moment
    (p : Real) (hp : 0 < p)
    (G : WaveSpaceTime → Complex) (A : Real → ENNReal)
    (f : Euclidean 2 → Complex)
    (hG : AEMeasurable G volume)
    (hA : Measurable A)
    (hpoint : ∀ t : Real,
      ∫⁻ x : Euclidean 2, ‖G (x, t)‖ₑ ^ p ≤
        A t * ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ p) :
    eLpNorm G (ENNReal.ofReal p) volume ≤
      (∫⁻ t : Real, A t) ^ p⁻¹ * eLpNorm f (ENNReal.ofReal p) volume := by
  let F : WaveSpaceTime → ENNReal := fun z => ‖G z‖ₑ ^ p
  let J : ENNReal := ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ p
  have hF : AEMeasurable F volume := by
    exact hG.enorm.pow measurable_const.aemeasurable
  have hFprod : AEMeasurable F
      ((volume : Measure (Euclidean 2)).prod volume) := by
    rw [← Measure.volume_eq_prod (Euclidean 2) Real]
    exact hF
  have hFswap : AEMeasurable (fun z : Real × Euclidean 2 => F z.swap)
      (volume.prod volume) := by
    change AEMeasurable (F ∘ Prod.swap) (volume.prod volume)
    exact hFprod.comp_quasiMeasurePreserving
      ((Measure.measurePreserving_swap : MeasurePreserving Prod.swap
        (volume.prod volume) (volume.prod volume)).quasiMeasurePreserving)
  have hFubini :
      (∫⁻ z : WaveSpaceTime, F z) =
        ∫⁻ t : Real, ∫⁻ x : Euclidean 2, F (x, t) := by
    rw [Measure.volume_eq_prod (Euclidean 2) Real]
    calc
      (∫⁻ z : Euclidean 2 × Real, F z ∂volume.prod volume) =
          ∫⁻ z : Real × Euclidean 2, F z.swap ∂volume.prod volume :=
        (lintegral_prod_swap F).symm
      _ = ∫⁻ t : Real, ∫⁻ x : Euclidean 2, F (x, t) := by
        rw [lintegral_prod _ hFswap]
        rfl
  have hmoment :
      (∫⁻ z : WaveSpaceTime, F z) ≤ (∫⁻ t : Real, A t) * J := by
    calc
      (∫⁻ z : WaveSpaceTime, F z) =
          ∫⁻ t : Real, ∫⁻ x : Euclidean 2, F (x, t) := hFubini
      _ ≤ ∫⁻ t : Real, A t * J := by
        apply lintegral_mono
        intro t
        simpa only [F, J] using hpoint t
      _ = (∫⁻ t : Real, A t) * J := lintegral_mul_const J hA
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ENNReal.ofReal_ne_zero_iff.mpr hp) ENNReal.ofReal_ne_top]
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ENNReal.ofReal_ne_zero_iff.mpr hp) ENNReal.ofReal_ne_top]
  simp only [ENNReal.toReal_ofReal hp.le]
  have hroot : (∫⁻ z : WaveSpaceTime, F z) ^ p⁻¹ ≤
      (∫⁻ t : Real, A t) ^ p⁻¹ * J ^ p⁻¹ := by
    calc
      (∫⁻ z : WaveSpaceTime, F z) ^ p⁻¹ ≤
          ((∫⁻ t : Real, A t) * J) ^ p⁻¹ :=
        ENNReal.rpow_le_rpow hmoment (inv_nonneg.mpr hp.le)
      _ = (∫⁻ t : Real, A t) ^ p⁻¹ * J ^ p⁻¹ :=
        ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hp.le)
  convert hroot using 1 <;> simp only [F, J, one_div]

/-- Literal mixed Young at the one exponent used by the wave-front lemma.
The left side is the actual space--time convolution of a kernel with spatial
input data; the coefficient is precisely the `L⁴` norm of its spatial slice
mass. -/
private theorem scratch_wavefront_mixed_spatial_convolution_four_young
    (K : WaveSpaceTime → Complex) (f : Euclidean 2 → Complex)
    (hK : Continuous K) (hf : Continuous f) :
    eLpNorm (fun z : WaveSpaceTime => ∫ y : Euclidean 2,
        K (y, z.2) * f (z.1 - y)) 4 volume ≤
      eLpNorm (fun t : Real => ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ) 4 volume *
        eLpNorm f 4 volume := by
  let G : WaveSpaceTime → Complex :=
    fun z => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y)
  let S : Real → ENNReal := fun t =>
    ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ
  let A : Real → ENNReal := fun t =>
    S t ^ (4 : Real)
  have hjoint : Continuous (fun zy : WaveSpaceTime × Euclidean 2 =>
      K (zy.2, zy.1.2) * f (zy.1.1 - zy.2)) :=
    (hK.comp (continuous_snd.prodMk continuous_fst.snd)).mul
      (hf.comp (continuous_fst.fst.sub continuous_snd))
  have hG : AEMeasurable G volume := by
    exact hjoint.stronglyMeasurable.integral_prod_right'.aemeasurable
  have hKswap : Measurable (fun z : Real × Euclidean 2 => ‖K z.swap‖ₑ) :=
    hK.measurable.enorm.comp measurable_swap
  have hA0 : Measurable S := by
    exact hKswap.lintegral_prod_right
  have hA : Measurable A := by
    exact hA0.pow measurable_const
  have hpoint : ∀ t : Real,
      ∫⁻ x : Euclidean 2, ‖G (x, t)‖ₑ ^ (4 : Real) ≤
        A t * ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ (4 : Real) := by
    intro t
    have hKt : Measurable (fun x : Euclidean 2 => K (x, t)) :=
      hK.measurable.comp (measurable_id.prodMk measurable_const)
    simpa only [G, A, convolution_def, ContinuousLinearMap.mul_apply'] using
      scratch_wavefront_complex_spatial_convolution_p_moment 4 (by norm_num)
        (fun x : Euclidean 2 => K (x, t)) f hKt hf.measurable
  have hmain := scratch_wavefront_mixed_p_lift_of_slice_moment 4 (by norm_num)
    G A f hG hA hpoint
  have hcoef : (∫⁻ t : Real, S t ^ (4 : Real)) ^ (4 : Real)⁻¹ =
      eLpNorm S 4 volume := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by simp)]
    simp only [enorm_eq_self, ENNReal.toReal_ofNat, one_div]
  rw [show (∫⁻ t : Real, A t) ^ (4 : Real)⁻¹ = eLpNorm S 4 volume by
    simpa only [A] using hcoef] at hmain
  have hfour : ENNReal.ofReal (4 : Real) = (4 : ENNReal) := by norm_num
  simpa only [G, S, hfour] using hmain

private theorem scratch_jointSchwartzRaw_pointwise_product_decay
    (K : SchwartzMap JointWaveSpaceTime Complex) (a b : Nat)
    (x : Euclidean 2) (t : Real) :
    (1 + ‖x‖) ^ a * (1 + |t|) ^ b *
        ‖jointSchwartzRaw K (x, t)‖ ≤
      (2 : Real) ^ (a + b) *
        ((Finset.Iic (a + b, 0)).sup fun m =>
          SchwartzMap.seminorm Complex m.1 m.2) K := by
  let z : JointWaveSpaceTime := WithLp.toLp 2 (x, t)
  have hx : ‖x‖ ≤ ‖z‖ := by
    dsimp only [z]
    simpa using (WithLp.norm_fst_le (p := 2) (Euclidean 2)
      (WithLp.toLp 2 (x, t)))
  have ht : |t| ≤ ‖z‖ := by
    dsimp only [z]
    have hraw := WithLp.norm_snd_le (p := 2) (Euclidean 2)
      (WithLp.toLp 2 (x, t))
    simpa only [WithLp.toLp_snd, Real.norm_eq_abs] using hraw
  have hweight : (1 + ‖x‖) ^ a * (1 + |t|) ^ b ≤
      (1 + ‖z‖) ^ (a + b) := by
    rw [pow_add]
    gcongr <;> linarith
  have hsemi := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := Complex)
    (m := (a + b, (0 : Nat))) (k := a + b) (n := (0 : Nat))
      (le_refl _) (le_refl _) K z
  simp only [norm_iteratedFDeriv_zero, pow_zero, mul_one] at hsemi
  change (1 + ‖x‖) ^ a * (1 + |t|) ^ b * ‖K (WithLp.toLp 2 (x, t))‖ ≤ _
  change (1 + ‖x‖) ^ a * (1 + |t|) ^ b * ‖K z‖ ≤ _
  calc
    (1 + ‖x‖) ^ a * (1 + |t|) ^ b * ‖K z‖ ≤
        (1 + ‖z‖) ^ (a + b) * ‖K z‖ := by
      exact mul_le_mul_of_nonneg_right hweight (norm_nonneg _)
    _ ≤ _ := hsemi

/-- The spatial `L¹` slice mass of a joint Schwartz profile decays faster
than any prescribed polynomial in the time coordinate.  The deliberately
unsimplified right side is a finite Schwartz seminorm times the fixed
integrable planar weight, which is the form needed by the mixed Young
estimate. -/
private theorem scratch_weighted_spatial_mass_jointSchwartzRaw_le
    (K : SchwartzMap JointWaveSpaceTime Complex) (b : Nat) (t : Real) :
    (1 + |t|) ^ b *
        (∫ x : Euclidean 2, ‖jointSchwartzRaw K (x, t)‖) ≤
      (2 : Real) ^ 4 *
        ((2 : Real) ^ (4 + b) *
          ((Finset.Iic (4 + b, 0)).sup fun m =>
            SchwartzMap.seminorm Complex m.1 m.2) K +
        (2 : Real) ^ (4 + b) *
          ((Finset.Iic (4 + b, 0)).sup fun m =>
            SchwartzMap.seminorm Complex m.1 m.2) K) *
        (∫ x : Euclidean 2, (1 + ‖x‖) ^ (-(4 : Real))) := by
  let T : Real := (1 + |t|) ^ b
  let S : Real := (2 : Real) ^ (4 + b) *
    ((Finset.Iic (4 + b, 0)).sup fun m =>
      SchwartzMap.seminorm Complex m.1 m.2) K
  have hT : 0 ≤ T := by
    dsimp only [T]
    positivity
  have htoLp : Continuous (WithLp.toLp 2 : WaveSpaceTime → JointWaveSpaceTime) :=
    WithLp.prod_continuous_toLp 2 _ _
  have hrawcont : Continuous (fun z : WaveSpaceTime => K (WithLp.toLp 2 z)) :=
    K.continuous.comp htoLp
  have hmeas : AEStronglyMeasurable
      (fun x : Euclidean 2 => T * ‖jointSchwartzRaw K (x, t)‖) volume := by
    change AEStronglyMeasurable
      (fun x : Euclidean 2 => T * ‖K (WithLp.toLp 2 (x, t))‖) volume
    exact (continuous_const.mul
      ((hrawcont.comp (continuous_id.prodMk continuous_const)).norm)).aestronglyMeasurable
  have hB : ∀ x : Euclidean 2,
      ‖T * ‖jointSchwartzRaw K (x, t)‖‖ ≤ S := by
    intro x
    have hpoint := scratch_jointSchwartzRaw_pointwise_product_decay K 4 b x t
    have hone : 1 ≤ (1 + ‖x‖) ^ 4 :=
      one_le_pow₀ (by linarith [norm_nonneg x])
    have hnonneg : 0 ≤ T * ‖jointSchwartzRaw K (x, t)‖ :=
      mul_nonneg hT (norm_nonneg _)
    rw [Real.norm_eq_abs, abs_of_nonneg hnonneg]
    calc
      T * ‖jointSchwartzRaw K (x, t)‖ ≤
          (1 + ‖x‖) ^ 4 * (T * ‖jointSchwartzRaw K (x, t)‖) :=
        le_mul_of_one_le_left hnonneg hone
      _ = (1 + ‖x‖) ^ 4 * (1 + |t|) ^ b *
          ‖jointSchwartzRaw K (x, t)‖ := by
        dsimp only [T]
        ring
      _ ≤ S := hpoint
  have hA : ∀ x : Euclidean 2,
      ‖x‖ ^ 4 * ‖T * ‖jointSchwartzRaw K (x, t)‖‖ ≤ S := by
    intro x
    have hpoint := scratch_jointSchwartzRaw_pointwise_product_decay K 4 b x t
    have hnonneg : 0 ≤ T * ‖jointSchwartzRaw K (x, t)‖ :=
      mul_nonneg hT (norm_nonneg _)
    rw [Real.norm_eq_abs, abs_of_nonneg hnonneg]
    calc
      ‖x‖ ^ 4 * (T * ‖jointSchwartzRaw K (x, t)‖) ≤
          (1 + ‖x‖) ^ 4 * (T * ‖jointSchwartzRaw K (x, t)‖) := by
        gcongr
        linarith [norm_nonneg x]
      _ = (1 + ‖x‖) ^ 4 * (1 + |t|) ^ b *
          ‖jointSchwartzRaw K (x, t)‖ := by
        dsimp only [T]
        ring
      _ ≤ S := hpoint
  have hkernel := Codex.Spherical.MikhlinHormander.integral_norm_le_uniform_and_power_decay
    (d := 2) (N := 4) (f := fun x : Euclidean 2 =>
      T * ‖jointSchwartzRaw K (x, t)‖)
    (by norm_num) hmeas hB hA
  have hleft :
      T * (∫ x : Euclidean 2, ‖jointSchwartzRaw K (x, t)‖) =
        ∫ x : Euclidean 2, ‖T * ‖jointSchwartzRaw K (x, t)‖‖ := by
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with x
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hT (norm_nonneg _))]
  change T * (∫ x : Euclidean 2, ‖jointSchwartzRaw K (x, t)‖) ≤ _
  rw [hleft]
  exact hkernel

private theorem scratch_wavefront_fourierInv_seminorm_le_derivativeIntegrals
    (Q : SchwartzMap JointWaveSpaceTime Complex) (N : Nat) :
    SchwartzMap.seminorm Complex N 0
      (𝓕⁻ Q : SchwartzMap JointWaveSpaceTime Complex) ≤
      (2 : Real) ^ N * ∑ n ∈ Finset.range (N + 1),
        ∫ zeta : JointWaveSpaceTime,
          ‖iteratedFDeriv Real n (Q : JointWaveSpaceTime → Complex) zeta‖ := by
  apply SchwartzMap.seminorm_le_bound Complex N 0
    (𝓕⁻ Q : SchwartzMap JointWaveSpaceTime Complex)
  · exact mul_nonneg (by positivity)
      (Finset.sum_nonneg fun _ _ => integral_nonneg fun _ => norm_nonneg _)
  · intro x
    rw [norm_iteratedFDeriv_zero]
    rw [SchwartzMap.fourierInv_coe]
    change ‖x‖ ^ N * ‖𝓕⁻ (Q : JointWaveSpaceTime → Complex) x‖ ≤ _
    have h := Real.pow_mul_norm_iteratedFDeriv_fourier_le
      (f := (Q : JointWaveSpaceTime → Complex)) (K := 0) (N := N)
      (Q.smooth N)
      (fun k n hk hn => by
        have hk' : k = 0 := by simpa using hk
        subst k
        simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume Q 0 n)
      (k := 0) (n := N) (by simp) (by simp) (-x)
    simpa [Real.fourierInv_eq_fourier_neg] using h

/-- The honest analytic input left after the cutoff algebra: all finite
frequency derivative `L¹` norms of the explicit one-packet multiplier are
rapid in scale, uniformly over the canonical finite `(n,ν)` family. -/
private def scratchWavefrontRapidMultiplierBounds
    (D : MSSWavefrontKernelData) : Prop :=
  ∀ (r N : Nat), ∃ C : Real, 0 ≤ C ∧
    ∀ (scale : Real) (hscale : 0 < scale) (n nu : Int), 2 ≤ scale →
      n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
      scale ^ N *
        (∫ z : JointWaveSpaceTime,
          ‖iteratedFDeriv Real r
            (scratchWavefrontPacketResidualMultiplier D scale hscale n nu :
              JointWaveSpaceTime → Complex) z‖) ≤ C

/-- Six physical weights suffice for a planar spatial slice with quadratic
time decay.  This extracts that finite seminorm budget directly from the
frequency-side regularity condition. -/
private theorem scratchWavefrontRapidMultiplierBounds.exists_iic_seminorm_bound
    {D : MSSWavefrontKernelData}
    (hrapid : scratchWavefrontRapidMultiplierBounds D) (N : Nat) :
    ∃ C : Real, 0 ≤ C ∧
      ∀ (scale : Real) (hscale : 0 < scale) (n nu : Int), 2 ≤ scale →
        n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
        scale ^ N *
          ((Finset.Iic (6, 0)).sup fun m =>
            SchwartzMap.seminorm Complex m.1 m.2)
          (𝓕⁻ (scratchWavefrontPacketResidualMultiplier D scale hscale n nu) :
            SchwartzMap JointWaveSpaceTime Complex) ≤ C := by
  let c : Nat → Real := fun r => (hrapid r N).choose
  have hc_nonneg (r : Nat) : 0 ≤ c r := (hrapid r N).choose_spec.1
  have hc_bound (r : Nat) :
      ∀ (scale : Real) (hscale : 0 < scale) (n nu : Int), 2 ≤ scale →
        n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
        scale ^ N *
          (∫ z : JointWaveSpaceTime,
            ‖iteratedFDeriv Real r
              (scratchWavefrontPacketResidualMultiplier D scale hscale n nu :
                JointWaveSpaceTime → Complex) z‖) ≤ c r := by
    intro scale hscale n nu hscale_two hn hnu
    exact (hrapid r N).choose_spec.2 scale hscale n nu hscale_two hn hnu
  let CD : Real := ∑ r ∈ Finset.range 7, c r
  have hCD_nonneg : 0 ≤ CD := by
    dsimp only [CD]
    exact Finset.sum_nonneg fun r _ => hc_nonneg r
  refine ⟨(2 : Real) ^ 6 * CD, mul_nonneg (by positivity) hCD_nonneg, ?_⟩
  intro scale hscale n nu hscale_two hn hnu
  let M : SchwartzMap JointWaveSpaceTime Complex :=
    scratchWavefrontPacketResidualMultiplier D scale hscale n nu
  let J : Finset (Nat × Nat) := Finset.Iic (6, 0)
  let P : Nat × Nat → Seminorm Complex (SchwartzMap JointWaveSpaceTime Complex) :=
    fun m => SchwartzMap.seminorm Complex m.1 m.2
  have hscaleNpos : 0 < scale ^ N := pow_pos hscale N
  have hscaleNnonneg : 0 ≤ scale ^ N := hscaleNpos.le
  have hsum {k : Nat} (hk : k ≤ 6) :
      scale ^ N *
        (∑ r ∈ Finset.range (k + 1),
          ∫ z : JointWaveSpaceTime,
            ‖iteratedFDeriv Real r (M : JointWaveSpaceTime → Complex) z‖) ≤ CD := by
    rw [Finset.mul_sum]
    calc
      ∑ r ∈ Finset.range (k + 1), scale ^ N *
          (∫ z : JointWaveSpaceTime,
            ‖iteratedFDeriv Real r (M : JointWaveSpaceTime → Complex) z‖) ≤
          ∑ r ∈ Finset.range (k + 1), c r := by
            apply Finset.sum_le_sum
            intro r hr
            simpa only [M] using hc_bound r scale hscale n nu hscale_two hn hnu
      _ ≤ CD := by
            dsimp only [CD]
            apply Finset.sum_le_sum_of_subset_of_nonneg
            · exact (Finset.range_subset_range).2 (by omega)
            · intro r hr hnot
              exact hc_nonneg r
  have hPscaled (m : Nat × Nat) (hm : m ∈ J) :
      scale ^ N * P m (𝓕⁻ M) ≤ (2 : Real) ^ 6 * CD := by
    have hmle : m ≤ (6, 0) := Finset.mem_Iic.mp (by simpa only [J] using hm)
    have hmone : m.1 ≤ 6 := hmle.1
    have hmtwo : m.2 = 0 := Nat.eq_zero_of_le_zero hmle.2
    change scale ^ N *
        SchwartzMap.seminorm Complex m.1 m.2 (𝓕⁻ M : SchwartzMap JointWaveSpaceTime Complex) ≤
      (2 : Real) ^ 6 * CD
    rw [hmtwo]
    have hsemi := scratch_wavefront_fourierInv_seminorm_le_derivativeIntegrals M m.1
    have hsum' := hsum hmone
    have hsum'_nonneg : 0 ≤
        scale ^ N *
          (∑ r ∈ Finset.range (m.1 + 1),
            ∫ z : JointWaveSpaceTime,
              ‖iteratedFDeriv Real r (M : JointWaveSpaceTime → Complex) z‖) := by
      apply mul_nonneg hscaleNnonneg
      exact Finset.sum_nonneg fun _ _ => integral_nonneg fun _ => norm_nonneg _
    calc
      scale ^ N *
          (SchwartzMap.seminorm Complex m.1 0
            (𝓕⁻ M : SchwartzMap JointWaveSpaceTime Complex) : Real) ≤
          scale ^ N *
            ((2 : Real) ^ m.1 *
              ∑ r ∈ Finset.range (m.1 + 1),
                ∫ z : JointWaveSpaceTime,
                  ‖iteratedFDeriv Real r (M : JointWaveSpaceTime → Complex) z‖) := by
            exact mul_le_mul_of_nonneg_left hsemi hscaleNnonneg
      _ = (2 : Real) ^ m.1 *
          (scale ^ N *
            ∑ r ∈ Finset.range (m.1 + 1),
              ∫ z : JointWaveSpaceTime,
                ‖iteratedFDeriv Real r (M : JointWaveSpaceTime → Complex) z‖) := by ring
      _ ≤ (2 : Real) ^ 6 * CD := by
            exact mul_le_mul (pow_le_pow_right₀ (by norm_num) hmone) hsum'
              hsum'_nonneg (by positivity)
  have hsup : J.sup P (𝓕⁻ M) ≤ ((2 : Real) ^ 6 * CD) / scale ^ N := by
    apply Seminorm.finset_sup_apply_le
    · exact div_nonneg (mul_nonneg (by positivity) hCD_nonneg) hscaleNnonneg
    intro m hm
    apply (mul_le_mul_iff_of_pos_left hscaleNpos).mp
    calc
      scale ^ N * P m (𝓕⁻ M) ≤ (2 : Real) ^ 6 * CD := hPscaled m hm
      _ = scale ^ N * (((2 : Real) ^ 6 * CD) / scale ^ N) := by
        field_simp [hscaleNpos.ne']
  change scale ^ N * J.sup P (𝓕⁻ M) ≤ (2 : Real) ^ 6 * CD
  calc
    scale ^ N * J.sup P (𝓕⁻ M) ≤
        scale ^ N * (((2 : Real) ^ 6 * CD) / scale ^ N) :=
      mul_le_mul_of_nonneg_left hsup hscaleNnonneg
    _ = (2 : Real) ^ 6 * CD := by field_simp [hscaleNpos.ne']

/-- The finite physical seminorm budget gives a uniform spatial `L¹` kernel
slice with quadratic temporal decay. -/
private theorem scratchWavefrontRapidMultiplierBounds.exists_weighted_sliceMass_bound
    {D : MSSWavefrontKernelData}
    (hrapid : scratchWavefrontRapidMultiplierBounds D) (N : Nat) :
    ∃ A : Real, 0 ≤ A ∧
      ∀ (scale : Real) (hscale : 0 < scale) (n nu : Int), 2 ≤ scale →
        n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
        ∀ t : Real,
          (1 + |t|) ^ 2 *
            (∫ x : Euclidean 2,
              ‖jointSchwartzRaw
                (𝓕⁻ (scratchWavefrontPacketResidualMultiplier D scale hscale n nu) :
                  SchwartzMap JointWaveSpaceTime Complex) (x, t)‖) ≤
            A * (scale⁻¹) ^ N := by
  rcases hrapid.exists_iic_seminorm_bound N with ⟨C, hC, hCbound⟩
  let I : Real := ∫ x : Euclidean 2, (1 + ‖x‖) ^ (-(4 : Real))
  let L : Real := (2 : Real) ^ 4 * ((2 : Real) ^ 6 + (2 : Real) ^ 6) * I
  have hI : 0 ≤ I := by
    dsimp only [I]
    exact integral_nonneg fun _ => Real.rpow_nonneg (by positivity) _
  have hL : 0 ≤ L := by
    dsimp only [L]
    exact mul_nonneg (mul_nonneg (by positivity) (by positivity)) hI
  refine ⟨L * C, mul_nonneg hL hC, ?_⟩
  intro scale hscale n nu hscale_two hn hnu t
  let M : SchwartzMap JointWaveSpaceTime Complex :=
    scratchWavefrontPacketResidualMultiplier D scale hscale n nu
  let K : SchwartzMap JointWaveSpaceTime Complex := 𝓕⁻ M
  let S : Real := ((Finset.Iic (6, 0)).sup fun m =>
    SchwartzMap.seminorm Complex m.1 m.2) K
  have hscaleNpos : 0 < scale ^ N := pow_pos hscale N
  have hS : scale ^ N * S ≤ C := by
    simpa only [M, K, S] using hCbound scale hscale n nu hscale_two hn hnu
  have hSbound : S ≤ C * (scale⁻¹) ^ N := by
    calc
      S ≤ C / scale ^ N :=
        (le_div_iff₀ hscaleNpos).2 (by simpa [mul_comm] using hS)
      _ = C * (scale⁻¹) ^ N := by
        rw [div_eq_mul_inv, inv_pow]
  have hslice := scratch_weighted_spatial_mass_jointSchwartzRaw_le K 2 t
  calc
    (1 + |t|) ^ 2 *
        (∫ x : Euclidean 2, ‖jointSchwartzRaw K (x, t)‖) ≤
        (2 : Real) ^ 4 * ((2 : Real) ^ 6 * S + (2 : Real) ^ 6 * S) * I := by
          simpa only [K, S] using hslice
    _ = L * S := by
      dsimp only [L]
      ring
    _ ≤ L * (C * (scale⁻¹) ^ N) :=
      mul_le_mul_of_nonneg_left hSbound hL
    _ = (L * C) * (scale⁻¹) ^ N := by ring

/-- Conversion of a real weighted spatial integral estimate into the
ENNReal slice-mass form consumed by mixed Young. -/
private theorem scratch_wavefront_lintegral_enorm_slice_le_of_weighted_integral_norm_le
    {E : Type*} [NormedAddCommGroup E]
    (K : Euclidean 2 → Real → E)
    (hK : ∀ t : Real, Integrable (fun x : Euclidean 2 => K x t) volume)
    (A scale : Real) (N : Nat)
    (hbound : ∀ t : Real,
      (1 + |t|) ^ 2 *
          (∫ x : Euclidean 2, ‖K x t‖) ≤ A * (scale⁻¹) ^ N) :
    ∀ t : Real,
      (∫⁻ x : Euclidean 2, ‖K x t‖ₑ) ≤
        ENNReal.ofReal (A * (scale⁻¹) ^ N) *
          ENNReal.ofReal (((1 + |t|)⁻¹) ^ 2) := by
  intro t
  have hbase_pos : 0 < 1 + |t| := by positivity
  have hweight_pos : 0 < (1 + |t|) ^ 2 := pow_pos hbase_pos _
  have hInonneg : 0 ≤ ∫ x : Euclidean 2, ‖K x t‖ :=
    integral_nonneg fun _ => norm_nonneg _
  have hBnonneg : 0 ≤ A * (scale⁻¹) ^ N := by
    exact (mul_nonneg hweight_pos.le hInonneg).trans (hbound t)
  have hreal :
      (∫ x : Euclidean 2, ‖K x t‖) ≤
        (A * (scale⁻¹) ^ N) * ((1 + |t|)⁻¹) ^ 2 := by
    calc
      (∫ x : Euclidean 2, ‖K x t‖) ≤
          (A * (scale⁻¹) ^ N) / (1 + |t|) ^ 2 :=
        (le_div_iff₀ hweight_pos).2 (by simpa [mul_comm] using hbound t)
      _ = (A * (scale⁻¹) ^ N) * ((1 + |t|)⁻¹) ^ 2 := by
        rw [div_eq_mul_inv, ← inv_pow]
  change (∫⁻ x : Euclidean 2, ‖K x t‖ₑ) ≤ _
  rw [← ofReal_integral_norm_eq_lintegral_enorm (hK t)]
  calc
    ENNReal.ofReal (∫ x : Euclidean 2, ‖K x t‖) ≤
        ENNReal.ofReal
          ((A * (scale⁻¹) ^ N) * ((1 + |t|)⁻¹) ^ 2) :=
      ENNReal.ofReal_le_ofReal hreal
    _ = ENNReal.ofReal (A * (scale⁻¹) ^ N) *
        ENNReal.ofReal (((1 + |t|)⁻¹) ^ 2) :=
      ENNReal.ofReal_mul hBnonneg

private def scratch_wavefront_tailWeight (t : Real) : Real := (1 + t ^ 2)⁻¹

private theorem scratch_wavefront_tailWeight_nonneg (t : Real) :
    0 ≤ scratch_wavefront_tailWeight t := by
  unfold scratch_wavefront_tailWeight
  positivity

private theorem scratch_wavefront_tailWeight_le_one (t : Real) :
    scratch_wavefront_tailWeight t ≤ 1 := by
  unfold scratch_wavefront_tailWeight
  have hbase : 1 ≤ 1 + t ^ 2 := by nlinarith [sq_nonneg t]
  exact (inv_le_one₀ (by positivity)).mpr hbase

private theorem scratch_wavefront_tailWeight_continuous :
    Continuous scratch_wavefront_tailWeight := by
  unfold scratch_wavefront_tailWeight
  exact (continuous_const.add (continuous_id.pow 2)).inv₀
    (fun t => by
      have : 0 < 1 + t ^ 2 := by nlinarith [sq_nonneg t]
      exact ne_of_gt this)

private theorem scratch_wavefront_tailWeight_integrable :
    Integrable scratch_wavefront_tailWeight := by
  exact integrable_inv_one_add_sq

private theorem scratch_wavefront_tailWeight_rpow_integrable
    (p : ENNReal) (hp : 1 ≤ p) (htop : p ≠ ∞) :
    Integrable (fun t : Real => scratch_wavefront_tailWeight t ^ p.toReal) := by
  refine scratch_wavefront_tailWeight_integrable.mono' ?_ ?_
  · exact (scratch_wavefront_tailWeight_continuous.rpow_const
      (fun _ => Or.inr ENNReal.toReal_nonneg)).aestronglyMeasurable
  · filter_upwards with t
    rw [Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg (scratch_wavefront_tailWeight_nonneg t) _)]
    have hpReal : 1 ≤ p.toReal := by
      simpa using ENNReal.toReal_mono htop hp
    exact Real.rpow_le_self_of_le_one
      (scratch_wavefront_tailWeight_nonneg t) (scratch_wavefront_tailWeight_le_one t) hpReal

private theorem scratch_wavefront_tailWeight_eLpNorm_lt_top
    (p : ENNReal) (hp : 1 ≤ p) :
    eLpNorm scratch_wavefront_tailWeight p volume < ∞ := by
  by_cases htop : p = ∞
  · rw [htop, eLpNorm_exponent_top]
    exact eLpNormEssSup_lt_top_of_ae_bound
      (Eventually.of_forall fun t => by
        rw [Real.norm_eq_abs, abs_of_nonneg (scratch_wavefront_tailWeight_nonneg t)]
        exact scratch_wavefront_tailWeight_le_one t)
  · have hp0 : p ≠ 0 := by
      exact ne_of_gt (lt_of_lt_of_le zero_lt_one hp)
    apply (eLpNorm_lt_top_iff_lintegral_rpow_enorm_lt_top hp0 htop).mpr
    have hpow := scratch_wavefront_tailWeight_rpow_integrable p hp htop
    have hfin :
        (∫⁻ t : Real, ‖scratch_wavefront_tailWeight t ^ p.toReal‖ₑ) < ∞ :=
      hpow.hasFiniteIntegral
    convert hfin using 1
    apply lintegral_congr
    intro t
    exact (Real.enorm_rpow_of_nonneg (scratch_wavefront_tailWeight_nonneg t)
      ENNReal.toReal_nonneg).symm

private theorem scratch_wavefront_eLpNorm_sliceMass_le_tailWeight
    (p : ENNReal) (S : Real → ENNReal) (c : ENNReal)
    (hS : ∀ t : Real,
      S t ≤ c * ENNReal.ofReal (scratch_wavefront_tailWeight t)) :
    eLpNorm S p volume ≤ c * eLpNorm scratch_wavefront_tailWeight p volume := by
  apply eLpNorm_le_mul_eLpNorm_of_ae_le_mul'' p
    scratch_wavefront_tailWeight_continuous.aestronglyMeasurable
  filter_upwards with t
  simpa [Real.enorm_of_nonneg (scratch_wavefront_tailWeight_nonneg t)] using hS t

private theorem scratch_wavefront_absTail_le_tailWeight (t : Real) :
    ((1 + |t|)⁻¹) ^ (2 : Nat) ≤ scratch_wavefront_tailWeight t := by
  have hpos : 0 < (1 + t ^ 2 : Real) := by nlinarith [sq_nonneg t]
  have hden : 1 + t ^ 2 ≤ (1 + |t|) ^ (2 : Nat) := by
    nlinarith [sq_abs t, abs_nonneg t]
  unfold scratch_wavefront_tailWeight
  have hinv := one_div_le_one_div_of_le hpos hden
  simpa [one_div, inv_pow] using hinv

/-- Quadratic temporal slice decay gives a rapid `L⁴` slice-mass bound with
one scale-independent coefficient. -/
private theorem scratch_wavefront_exists_eLpNorm_sliceMass_four_decay
    (A : Real) (N : Nat) (hA : 0 ≤ A) :
    ∃ C : Real, 0 < C ∧ ∀ scale : Real, 0 < scale →
      ∀ S : Real → ENNReal,
      (∀ t : Real,
        S t ≤ ENNReal.ofReal
          (A * (scale⁻¹) ^ N * ((1 + |t|)⁻¹) ^ (2 : Nat))) →
      eLpNorm S 4 volume ≤ ENNReal.ofReal (C * (scale⁻¹) ^ N) := by
  let W : ENNReal := eLpNorm scratch_wavefront_tailWeight 4 volume
  let B : Real := W.toReal
  have hWlt : W < ∞ := scratch_wavefront_tailWeight_eLpNorm_lt_top 4 (by norm_num)
  have hW : W ≠ ∞ := hWlt.ne
  refine ⟨A * B + 1, ?_, ?_⟩
  · have hAB : 0 ≤ A * B := mul_nonneg hA ENNReal.toReal_nonneg
    linarith
  · intro scale hscale S hS
    have hsnonneg : 0 ≤ (scale⁻¹) ^ N :=
      pow_nonneg (inv_nonneg.mpr hscale.le) _
    have hAsnonneg : 0 ≤ A * (scale⁻¹) ^ N :=
      mul_nonneg hA hsnonneg
    have htail : ∀ t : Real,
        S t ≤ ENNReal.ofReal (A * (scale⁻¹) ^ N) *
          ENNReal.ofReal (scratch_wavefront_tailWeight t) := by
      intro t
      have ht := hS t
      rw [ENNReal.ofReal_mul hAsnonneg] at ht
      refine ht.trans ?_
      gcongr
      exact scratch_wavefront_absTail_le_tailWeight t
    have hcoeff := scratch_wavefront_eLpNorm_sliceMass_le_tailWeight 4 S
      (ENNReal.ofReal (A * (scale⁻¹) ^ N)) htail
    calc
      eLpNorm S 4 volume ≤ ENNReal.ofReal (A * (scale⁻¹) ^ N) * W := hcoeff
      _ = ENNReal.ofReal ((A * B) * (scale⁻¹) ^ N) := by
        rw [← ENNReal.ofReal_toReal hW]
        rw [← ENNReal.ofReal_mul hAsnonneg]
        congr 1
        ring
      _ ≤ ENNReal.ofReal ((A * B + 1) * (scale⁻¹) ^ N) := by
        apply ENNReal.ofReal_le_ofReal
        calc
          (A * B) * (scale⁻¹) ^ N ≤
              (A * B) * (scale⁻¹) ^ N + 1 * (scale⁻¹) ^ N :=
            le_add_of_nonneg_right (by simpa using hsnonneg)
          _ = (A * B + 1) * (scale⁻¹) ^ N := by ring

/-- A joint Schwartz inverse transform has integrable planar slices. -/
private theorem scratch_wavefront_integrable_jointSchwartzRaw_slice
    (K : SchwartzMap JointWaveSpaceTime Complex) (t : Real) :
    Integrable (fun x : Euclidean 2 => jointSchwartzRaw K (x, t)) volume := by
  let S : Real := (2 : Real) ^ 4 *
    ((Finset.Iic (4, 0)).sup fun m =>
      SchwartzMap.seminorm Complex m.1 m.2) K
  have hrawcont : Continuous (fun x : Euclidean 2 =>
      jointSchwartzRaw K (x, t)) := by
    change Continuous (fun x : Euclidean 2 => K (WithLp.toLp 2 (x, t)))
    exact K.continuous.comp
      ((WithLp.prod_continuous_toLp 2 (Euclidean 2) Real).comp
        (continuous_id.prodMk continuous_const))
  have hmeas : AEStronglyMeasurable (fun x : Euclidean 2 =>
      jointSchwartzRaw K (x, t)) volume := hrawcont.aestronglyMeasurable
  have hpoint : ∀ x : Euclidean 2,
      ‖jointSchwartzRaw K (x, t)‖ ≤ S * (1 + ‖x‖) ^ (-(4 : Real)) := by
    intro x
    let z : JointWaveSpaceTime := WithLp.toLp 2 (x, t)
    have hx : ‖x‖ ≤ ‖z‖ := by
      dsimp only [z]
      simpa using (WithLp.norm_fst_le (p := 2) (Euclidean 2)
        (WithLp.toLp 2 (x, t)))
    have hweight : (1 + ‖x‖) ^ 4 ≤ (1 + ‖z‖) ^ 4 := by
      gcongr
    have hsemi := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := Complex)
      (m := (4, (0 : Nat))) (k := 4) (n := (0 : Nat))
      (le_refl _) (le_refl _) K z
    simp only [norm_iteratedFDeriv_zero] at hsemi
    change ‖K z‖ ≤ S * (1 + ‖x‖) ^ (-(4 : Real))
    have hbase_pos : 0 < (1 + ‖x‖) ^ (4 : Nat) := by positivity
    have hsemi' : (1 + ‖x‖) ^ (4 : Nat) * ‖K z‖ ≤ S := by
      calc
        (1 + ‖x‖) ^ (4 : Nat) * ‖K z‖ ≤
            (1 + ‖z‖) ^ (4 : Nat) * ‖K z‖ :=
          mul_le_mul_of_nonneg_right hweight (norm_nonneg _)
        _ ≤ S := hsemi
    have hdiv : ‖K z‖ ≤ S / (1 + ‖x‖) ^ (4 : Nat) :=
      (le_div_iff₀ hbase_pos).2 (by simpa [mul_comm] using hsemi')
    rw [div_eq_mul_inv, ← inv_pow] at hdiv
    calc
      ‖K z‖ ≤ S * (1 + ‖x‖)⁻¹ ^ (4 : Nat) := hdiv
      _ = S * (1 + ‖x‖) ^ (-(4 : Real)) := by
        congr 1
        rw [Real.rpow_neg (by positivity)]
        norm_num [Real.rpow_natCast, inv_pow]
  have hweight : Integrable (fun x : Euclidean 2 =>
      S * (1 + ‖x‖) ^ (-(4 : Real))) volume := by
    have hdim : (Module.finrank Real (Euclidean 2) : Real) < 4 := by norm_num
    exact (integrable_one_add_norm hdim).const_mul S
  exact hweight.mono' hmeas (Eventually.of_forall hpoint)

/-- One-packet rapid wave-front localization.  This is an actual
`f → space-time` estimate for the inverse multiplier residual, obtained from
the explicit spectral derivative condition by Fourier integration by parts,
kernel slices, and mixed Young. -/
private theorem scratchWavefrontRapidMultiplierBounds.exists_packet_L4_rapid_bound
    {D : MSSWavefrontKernelData}
    (hrapid : scratchWavefrontRapidMultiplierBounds D) (N : Nat) :
    ∃ C : Real, 0 < C ∧
      ∀ (scale : Real) (hscale : 0 < scale) (n nu : Int), 2 ≤ scale →
        n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
        ∀ f : SchwartzMap (Euclidean 2) Complex,
          eLpNorm (scratchWavefrontPacketResidual D scale hscale n nu f) 4 volume ≤
            ENNReal.ofReal (C * (scale⁻¹) ^ N) *
              eLpNorm (f : Euclidean 2 → Complex) 4 volume := by
  rcases hrapid.exists_weighted_sliceMass_bound N with ⟨A, hA, hAbound⟩
  rcases scratch_wavefront_exists_eLpNorm_sliceMass_four_decay A N hA with
    ⟨C, hCpos, hCbound⟩
  refine ⟨C, hCpos, ?_⟩
  intro scale hscale n nu hscale_two hn hnu f
  let M : SchwartzMap JointWaveSpaceTime Complex :=
    scratchWavefrontPacketResidualMultiplier D scale hscale n nu
  let K : WaveSpaceTime → Complex :=
    spaceTimeFourierInv (jointSchwartzRaw M)
  have hKraw : K = jointSchwartzRaw (𝓕⁻ M : SchwartzMap JointWaveSpaceTime Complex) := by
    funext z
    dsimp only [K]
    rw [spaceTimeFourierInv_jointSchwartzRaw]
    change FourierTransform.fourierInv (M : JointWaveSpaceTime → Complex)
        (WithLp.toLp 2 z) =
      (𝓕⁻ M : SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 z)
    exact (congrFun (SchwartzMap.fourierInv_coe M) (WithLp.toLp 2 z)).symm
  have hKcont : Continuous K := by
    rw [hKraw]
    change Continuous (fun z : WaveSpaceTime =>
      (𝓕⁻ M : SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 z))
    exact (𝓕⁻ M).continuous.comp
      (WithLp.prod_continuous_toLp 2 (Euclidean 2) Real)
  have hKslice : ∀ t : Real,
      Integrable (fun x : Euclidean 2 => K (x, t)) volume := by
    intro t
    rw [hKraw]
    exact scratch_wavefront_integrable_jointSchwartzRaw_slice (𝓕⁻ M) t
  have hweighted : ∀ t : Real,
      (1 + |t|) ^ 2 *
          (∫ x : Euclidean 2, ‖K (x, t)‖) ≤ A * (scale⁻¹) ^ N := by
    intro t
    rw [hKraw]
    simpa only [M] using hAbound scale hscale n nu hscale_two hn hnu t
  let S : Real → ENNReal := fun t =>
    ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ
  have hS : ∀ t : Real,
      S t ≤ ENNReal.ofReal
        (A * (scale⁻¹) ^ N * ((1 + |t|)⁻¹) ^ (2 : Nat)) := by
    intro t
    dsimp only [S]
    have hslice := scratch_wavefront_lintegral_enorm_slice_le_of_weighted_integral_norm_le
      (fun x t => K (x, t)) hKslice A scale N hweighted t
    rw [ENNReal.ofReal_mul (mul_nonneg hA
      (pow_nonneg (inv_nonneg.mpr hscale.le) _))]
    exact hslice
  have hSbound := hCbound scale hscale S hS
  have hYoung := scratch_wavefront_mixed_spatial_convolution_four_young
    K (f : Euclidean 2 → Complex) hKcont f.continuous
  have hres : scratchWavefrontPacketResidual D scale hscale n nu f =
      fun z : WaveSpaceTime => ∫ y : Euclidean 2,
        K (y, z.2) * f (z.1 - y) := by
    funext z
    change spaceTimeFourierInv (fun zeta : WaveSpaceTime =>
      jointSchwartzRaw M zeta *
        FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1) z = _
    calc
      spaceTimeFourierInv (fun zeta : WaveSpaceTime =>
        jointSchwartzRaw M zeta *
          FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1) z =
          ∫ y : Euclidean 2,
            spaceTimeFourierInv (jointSchwartzRaw M) (z.1 - y, z.2) * f y :=
        scratch_wavefront_inverse_factorizedSpectrum_eq_sourceKernel M f z.1 z.2
      _ = ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y) := by
        rw [scratch_wavefront_sourceKernel_convolution_orientation]
  rw [hres]
  calc
    eLpNorm (fun z : WaveSpaceTime => ∫ y : Euclidean 2,
        K (y, z.2) * f (z.1 - y)) 4 volume ≤
        eLpNorm S 4 volume * eLpNorm (f : Euclidean 2 → Complex) 4 volume := by
          simpa only [S] using hYoung
    _ ≤ ENNReal.ofReal (C * (scale⁻¹) ^ N) *
        eLpNorm (f : Euclidean 2 → Complex) 4 volume :=
      mul_le_mul_left hSbound _

/- Private normal-gap and finite-aggregation closure for wave-front localization. -/
open scoped BigOperators

/- Source-local versions of the radial-time derivative and normal-shear
   ingredients. The corresponding earlier declarations are lexical-private
   to the radial-time localization development; these remain private and
   serve only the present wave-front closure. -/

private noncomputable def scratchScaledNormalCoordinate
    (D : MSSRadialTimeCutoffs) (scale : Real) (xi : Euclidean 2) : Real :=
  scale * D.normalExtension (scale⁻¹ • xi)

private theorem exists_scratch_scaledNormalExtension_iteratedFDeriv_uniform_bound
    (D : MSSRadialTimeCutoffs) (k : Nat) (hk : 1 ≤ k) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ xi : Euclidean 2,
        ‖iteratedFDeriv Real k
          (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) xi‖ ≤ C := by
  obtain ⟨C, hCpos, hC⟩ := D.normalExtension.decay 0 k
  refine ⟨C, hCpos.le, ?_⟩
  intro scale hscale hscaleone xi
  have hfun :
      (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) =
        fun y : Euclidean 2 => scale • D.normalExtension (scale⁻¹ • y) := by
    funext y
    rw [scratchScaledNormalExtension_apply]
    rfl
  have hsmooth : ContDiff Real k
      (fun y : Euclidean 2 => D.normalExtension (scale⁻¹ • y)) := by
    exact (D.normalExtension.smooth (k : ℕ∞)).comp
      (contDiff_id.const_smul scale⁻¹)
  have hchain : iteratedFDeriv Real k
      (fun y : Euclidean 2 => D.normalExtension (scale⁻¹ • y)) xi =
        scale⁻¹ ^ k • iteratedFDeriv Real k
          (D.normalExtension : Euclidean 2 → Real) (scale⁻¹ • xi) := by
    simpa using congrFun
      (iteratedFDeriv_comp_const_smul scale⁻¹
        (D.normalExtension.smooth (k : ℕ∞))) xi
  rw [hfun]
  change ‖iteratedFDeriv Real k
      (scale • (fun y : Euclidean 2 => D.normalExtension (scale⁻¹ • y))) xi‖ ≤ C
  rw [iteratedFDeriv_const_smul_apply hsmooth.contDiffAt, hchain,
    norm_smul, norm_smul]
  simp only [Real.norm_eq_abs, abs_of_pos hscale,
    abs_pow, abs_of_nonneg (inv_nonneg.mpr hscale.le)]
  have hpow : scale * scale⁻¹ ^ k ≤ 1 := by
    have hinv : scale⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hscaleone
    have hinv0 : 0 ≤ scale⁻¹ := inv_nonneg.mpr hscale.le
    have hinvpow : scale⁻¹ ^ (k - 1) ≤ 1 :=
      pow_le_one₀ hinv0 hinv
    have hk' : k = (k - 1) + 1 := (Nat.sub_add_cancel hk).symm
    calc
      scale * scale⁻¹ ^ k = scale * scale⁻¹ ^ ((k - 1) + 1) := by
        rw [congrArg (fun j : Nat => scale⁻¹ ^ j) hk']
      _ = scale * (scale⁻¹ ^ (k - 1) * scale⁻¹) := by rw [pow_succ]
      _ = (scale * scale⁻¹) * scale⁻¹ ^ (k - 1) := by ring
      _ = scale⁻¹ ^ (k - 1) := by field_simp [hscale.ne']
      _ ≤ 1 := hinvpow
  calc
    scale * (scale⁻¹ ^ k *
        ‖iteratedFDeriv Real k (D.normalExtension : Euclidean 2 → Real)
          (scale⁻¹ • xi)‖) =
      (scale * scale⁻¹ ^ k) *
        ‖iteratedFDeriv Real k (D.normalExtension : Euclidean 2 → Real)
          (scale⁻¹ • xi)‖ := by ring
    _ ≤ 1 * ‖iteratedFDeriv Real k (D.normalExtension : Euclidean 2 → Real)
      (scale⁻¹ • xi)‖ := by
      gcongr
    _ ≤ C := by
      simpa using hC (scale⁻¹ • xi)

private noncomputable def scratchJointNormalDifference
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) :
    JointWaveSpaceTime → Real :=
  fun z => z.snd - scratchScaledNormalExtension D scale hscale z.fst

private theorem scratchJointNormalDifference_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (xi : Euclidean 2) (tau : Real) :
    scratchJointNormalDifference D scale hscale (WithLp.toLp 2 (xi, tau)) =
      tau - scratchScaledNormalCoordinate D scale xi := by
  simp [scratchJointNormalDifference, scratchScaledNormalExtension_apply,
    scratchScaledNormalCoordinate]

private noncomputable def scratchTemporalDerivativeProfile
    (h : SchwartzMap Real Complex) (i : Nat) : SchwartzMap Real Complex :=
  (SchwartzMap.derivCLM Complex Complex)^[i] h

private theorem scratchTemporalDerivativeProfile_apply
    (h : SchwartzMap Real Complex) (i : Nat) (u : Real) :
    scratchTemporalDerivativeProfile h i u =
      iteratedDeriv i (h : Real → Complex) u := by
  induction i generalizing u with
  | zero => simp [scratchTemporalDerivativeProfile, iteratedDeriv_zero]
  | succ i ih =>
      rw [scratchTemporalDerivativeProfile, Function.iterate_succ_apply',
        SchwartzMap.derivCLM_apply]
      change deriv (fun v : Real => scratchTemporalDerivativeProfile h i v) u = _
      rw [show (fun v : Real => scratchTemporalDerivativeProfile h i v) =
        iteratedDeriv i (h : Real → Complex) by
          funext v
          exact ih v,
        ← iteratedDeriv_succ]

private noncomputable def scratchWeightedTemporalDerivativeProfile
    (h : SchwartzMap Real Complex) (i N : Nat) : SchwartzMap Real Complex :=
  SchwartzMap.smulLeftCLM Complex (fun s : Real => (1 + s ^ 2) ^ N)
    (scratchTemporalDerivativeProfile h i)

private theorem scratchWeightedTemporalDerivativeProfile_apply
    (h : SchwartzMap Real Complex) (i N : Nat) (u : Real) :
    scratchWeightedTemporalDerivativeProfile h i N u =
      ((1 + u ^ 2) ^ N : Real) • iteratedDeriv i (h : Real → Complex) u := by
  unfold scratchWeightedTemporalDerivativeProfile
  rw [SchwartzMap.smulLeftCLM_apply
    (show (fun s : Real => (1 + s ^ 2) ^ N).HasTemperateGrowth by fun_prop)]
  change ((1 + u ^ 2) ^ N : Real) • scratchTemporalDerivativeProfile h i u = _
  rw [scratchTemporalDerivativeProfile_apply]

/-- Outside the normal tube, a fixed polynomially weighted Schwartz
derivative dominates the unweighted derivative with the desired scale gain. -/
private theorem scale_pow_mul_norm_iteratedFDeriv_time_le_weighted_profile
    (h : SchwartzMap Real Complex) (i N : Nat) (scale u : Real)
    (hscale : 0 ≤ scale) (hu : Real.sqrt scale ≤ |u|) :
    scale ^ N * ‖iteratedFDeriv Real i (h : Real → Complex) u‖ ≤
      ‖scratchWeightedTemporalDerivativeProfile h i N u‖ := by
  rw [scratchWeightedTemporalDerivativeProfile_apply, norm_smul,
    Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (by positivity) _),
    norm_iteratedFDeriv_eq_norm_iteratedDeriv]
  have hscale_le_u2 : scale ≤ u ^ 2 := by
    calc
      scale = Real.sqrt scale ^ 2 := by rw [Real.sq_sqrt hscale]
      _ ≤ |u| ^ 2 := by
        exact pow_le_pow_left₀ (Real.sqrt_nonneg _) hu _
      _ = u ^ 2 := by rw [sq_abs]
  have hscale_le : scale ≤ 1 + u ^ 2 := hscale_le_u2.trans (by linarith)
  have hpow : scale ^ N ≤ (1 + u ^ 2) ^ N := by
    exact pow_le_pow_left₀ hscale hscale_le N
  gcongr

private theorem norm_iteratedFDeriv_continuousLinearMap_le_one
    (L : JointWaveSpaceTime →L[Real] Real) (hL : ‖L‖ ≤ 1)
    (k : Nat) (hk : 1 ≤ k) (z : JointWaveSpaceTime) :
    ‖iteratedFDeriv Real k (L : JointWaveSpaceTime → Real) z‖ ≤ 1 := by
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, (Nat.sub_add_cancel hk).symm⟩
  rw [← norm_iteratedFDeriv_fderiv]
  have hf : fderiv Real (L : JointWaveSpaceTime → Real) = fun _ => L := by
    funext w
    exact L.fderiv
  rw [hf]
  cases j with
  | zero =>
      simpa [norm_iteratedFDeriv_zero] using hL
  | succ j =>
      rw [iteratedFDeriv_const_of_ne (Nat.succ_ne_zero j) L]
      simp

private theorem scratch_joint_fstL_norm_le_one :
    ‖WithLp.fstL 2 Real (Euclidean 2) Real‖ ≤ 1 := by
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
  intro z
  simpa using WithLp.norm_fst_le (p := 2) (Euclidean 2) z

private theorem scratch_joint_sndL_norm_le_one :
    ‖WithLp.sndL 2 Real (Euclidean 2) Real‖ ≤ 1 := by
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
  intro z
  simpa using WithLp.norm_snd_le (p := 2) (Euclidean 2) z

private theorem norm_iteratedFDeriv_scratchScaledNormalExtension_comp_fst_le
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (k : Nat) (z : JointWaveSpaceTime) :
    ‖iteratedFDeriv Real k
      (fun w : JointWaveSpaceTime =>
        scratchScaledNormalExtension D scale hscale w.fst) z‖ ≤
      ‖iteratedFDeriv Real k
        (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) z.fst‖ := by
  let L : JointWaveSpaceTime →L[Real] Euclidean 2 :=
    WithLp.fstL 2 Real (Euclidean 2) Real
  change ‖iteratedFDeriv Real k
    ((scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) ∘ L) z‖ ≤ _
  rw [L.iteratedFDeriv_comp_right
    ((scratchScaledNormalExtension D scale hscale).smooth (k : ℕ∞)) z
    le_rfl]
  calc
    ‖(iteratedFDeriv Real k
        (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) (L z)).compContinuousLinearMap
          (fun _ => L)‖ ≤
        ‖iteratedFDeriv Real k
          (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) (L z)‖ *
          ∏ _ : Fin k, ‖L‖ :=
      ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv Real k
          (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) (L z)‖ *
          ∏ _ : Fin k, (1 : Real) := by
      gcongr
      exact scratch_joint_fstL_norm_le_one
    _ = ‖iteratedFDeriv Real k
          (scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) z.fst‖ := by
      simp [L]

private theorem exists_scratchJointNormalDifference_iteratedFDeriv_uniform_bound
    (D : MSSRadialTimeCutoffs) (k : Nat) (hk : 1 ≤ k) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ z : JointWaveSpaceTime,
        ‖iteratedFDeriv Real k
          (scratchJointNormalDifference D scale hscale : JointWaveSpaceTime → Real) z‖ ≤ C := by
  obtain ⟨C, hCnonneg, hC⟩ :=
    exists_scratch_scaledNormalExtension_iteratedFDeriv_uniform_bound D k hk
  refine ⟨1 + C, by linarith, ?_⟩
  intro scale hscale hscaleone z
  let Ls : JointWaveSpaceTime →L[Real] Real :=
    WithLp.sndL 2 Real (Euclidean 2) Real
  let Lf : JointWaveSpaceTime →L[Real] Euclidean 2 :=
    WithLp.fstL 2 Real (Euclidean 2) Real
  let rho : SchwartzMap (Euclidean 2) Real := scratchScaledNormalExtension D scale hscale
  have hsnd : ContDiffAt Real k (fun w : JointWaveSpaceTime => Ls w) z := by
    fun_prop
  have hrhofst : ContDiffAt Real k (fun w : JointWaveSpaceTime => rho (Lf w)) z := by
    exact ((rho.smooth (k : ℕ∞)).comp_continuousLinearMap (g := Lf)).contDiffAt
  have hrepr : (scratchJointNormalDifference D scale hscale : JointWaveSpaceTime → Real) =
      fun w => Ls w - rho (Lf w) := by
    funext w
    change w.snd - scratchScaledNormalExtension D scale hscale w.fst =
      WithLp.sndL 2 Real (Euclidean 2) Real w -
        scratchScaledNormalExtension D scale hscale
          (WithLp.fstL 2 Real (Euclidean 2) Real w)
    rfl
  rw [hrepr,
    show (fun w : JointWaveSpaceTime => Ls w - rho (Lf w)) =
      (fun w => Ls w) - (fun w => rho (Lf w)) by rfl,
    iteratedFDeriv_sub_apply hsnd hrhofst]
  calc
    ‖iteratedFDeriv Real k (fun w : JointWaveSpaceTime => Ls w) z -
        iteratedFDeriv Real k (fun w : JointWaveSpaceTime => rho (Lf w)) z‖ ≤
        ‖iteratedFDeriv Real k (fun w : JointWaveSpaceTime => Ls w) z‖ +
          ‖iteratedFDeriv Real k (fun w : JointWaveSpaceTime => rho (Lf w)) z‖ :=
      norm_sub_le _ _
    _ ≤ 1 + C := by
      gcongr
      · exact norm_iteratedFDeriv_continuousLinearMap_le_one Ls
          (by simpa [Ls] using scratch_joint_sndL_norm_le_one) k hk z
      · exact (norm_iteratedFDeriv_scratchScaledNormalExtension_comp_fst_le
          D scale hscale k z).trans (hC scale hscale hscaleone z.fst)

private theorem scratch_normal_shear_measurePreserving
    (rho : SchwartzMap (Euclidean 2) Real) :
    MeasurePreserving
      (fun z : WaveSpaceTime => (z.1, z.2 - rho z.1)) volume volume := by
  rw [Measure.volume_eq_prod]
  refine (MeasurePreserving.id (volume : Measure (Euclidean 2))).skew_product
    (g := fun xi (t : Real) => t - rho xi) ?_ ?_
  · exact measurable_snd.sub (rho.continuous.measurable.comp measurable_fst)
  · filter_upwards with xi
    simpa only [sub_eq_add_neg] using
      (measurePreserving_add_right (volume : Measure Real) (-rho xi)).map_eq

/-- The literal nonnegative spatial--normal product is integrable after a
normal shear whenever its spatial factor is integrable and its temporal
factor is Schwartz. -/
private theorem integrable_sheared_norm_mul_norm
    {E : Type*} [NormedAddCommGroup E]
    (A : Euclidean 2 → E) (hA : Integrable A)
    (H : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    Integrable (fun z : WaveSpaceTime =>
      ‖A z.1‖ * ‖H (z.2 - rho z.1)‖) := by
  let shear : WaveSpaceTime → WaveSpaceTime :=
    fun z => (z.1, z.2 - rho z.1)
  let P : WaveSpaceTime → Real := fun z => ‖A z.1‖ * ‖H z.2‖
  have hP : Integrable P volume := by
    rw [Measure.volume_eq_prod]
    exact hA.norm.mul_prod H.integrable.norm
  have hshear : MeasurePreserving shear volume volume := by
    simpa only [shear] using scratch_normal_shear_measurePreserving rho
  have hcomp : Integrable (P ∘ shear) volume :=
    (hshear.integrable_comp hP.aestronglyMeasurable).mpr hP
  have heq : P ∘ shear = fun z : WaveSpaceTime =>
      ‖A z.1‖ * ‖H (z.2 - rho z.1)‖ := by
    funext z
    rfl
  rw [← heq]
  exact hcomp

/-- The same literal shear product on the joint Hilbert `WithLp` coordinate
model is integrable; this is transport through `WithLp.toLp`. -/
private theorem integrable_joint_sheared_norm_mul_norm
    {E : Type*} [NormedAddCommGroup E]
    (A : Euclidean 2 → E) (hA : Integrable A)
    (H : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    Integrable (fun z : JointWaveSpaceTime =>
      ‖A z.fst‖ * ‖H (z.snd - rho z.fst)‖) := by
  let Q : JointWaveSpaceTime → Real := fun z =>
    ‖A z.fst‖ * ‖H (z.snd - rho z.fst)‖
  change Integrable Q volume
  have hraw := integrable_sheared_norm_mul_norm A hA H rho
  have hpres : MeasurePreserving
      (WithLp.toLp 2 : WaveSpaceTime → JointWaveSpaceTime) volume volume := by
    simpa only using (WithLp.volume_preserving_toLp (Euclidean 2) Real)
  rw [← hpres.integrable_comp_emb
    (MeasurableEquiv.toLp 2 WaveSpaceTime).measurableEmbedding]
  have heq : Q ∘ (WithLp.toLp 2 : WaveSpaceTime → JointWaveSpaceTime) =
      fun p : WaveSpaceTime => ‖A p.1‖ * ‖H (p.2 - rho p.1)‖ := by
    funext p
    rfl
  rw [heq]
  exact hraw

/-- Literal Fubini-plus-shear identity for an arbitrary integrable spatial
factor and a Schwartz temporal profile. -/
private theorem integral_sheared_norm_mul_norm_eq
    {E : Type*} [NormedAddCommGroup E]
    (A : Euclidean 2 → E) (hA : Integrable A)
    (H : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    (∫ z : WaveSpaceTime, ‖A z.1‖ * ‖H (z.2 - rho z.1)‖) =
      (∫ xi : Euclidean 2, ‖A xi‖) * ∫ t : Real, ‖H t‖ := by
  let shear : WaveSpaceTime → WaveSpaceTime :=
    fun z => (z.1, z.2 - rho z.1)
  let P : WaveSpaceTime → Real := fun z => ‖A z.1‖ * ‖H z.2‖
  have hPmeas : AEStronglyMeasurable P volume := by
    rw [Measure.volume_eq_prod]
    exact (hA.aestronglyMeasurable.norm.comp_fst).mul
      (H.continuous.aestronglyMeasurable.norm.comp_snd)
  have hshear : MeasurePreserving shear volume volume := by
    simpa only [shear] using scratch_normal_shear_measurePreserving rho
  have hPmeas_map : AEStronglyMeasurable P (Measure.map shear volume) := by
    rw [hshear.map_eq]
    exact hPmeas
  have htransport : (∫ z : WaveSpaceTime, P (shear z)) = ∫ z : WaveSpaceTime, P z := by
    calc
      (∫ z : WaveSpaceTime, P (shear z)) =
          ∫ z : WaveSpaceTime, P z ∂Measure.map shear volume := by
            exact (integral_map hshear.measurable.aemeasurable hPmeas_map).symm
      _ = ∫ z : WaveSpaceTime, P z := by rw [hshear.map_eq]
  calc
    (∫ z : WaveSpaceTime, ‖A z.1‖ * ‖H (z.2 - rho z.1)‖) =
        ∫ z : WaveSpaceTime, P (shear z) := by rfl
    _ = ∫ z : WaveSpaceTime, P z := htransport
    _ = (∫ xi : Euclidean 2, ‖A xi‖) * ∫ t : Real, ‖H t‖ := by
      rw [Measure.volume_eq_prod]
      exact integral_prod_mul (fun xi : Euclidean 2 => ‖A xi‖)
        (fun t : Real => ‖H t‖)

/-- `WithLp.volume_preserving_toLp` transports the raw Fubini formula to the
joint frequency Hilbert model without any extra regularity on `A`. -/
private theorem integral_joint_sheared_norm_mul_norm_eq
    {E : Type*} [NormedAddCommGroup E]
    (A : Euclidean 2 → E) (hA : Integrable A)
    (H : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    (∫ z : JointWaveSpaceTime, ‖A z.fst‖ * ‖H (z.snd - rho z.fst)‖) =
      (∫ xi : Euclidean 2, ‖A xi‖) * ∫ t : Real, ‖H t‖ := by
  let Q : JointWaveSpaceTime → Real := fun z =>
    ‖A z.fst‖ * ‖H (z.snd - rho z.fst)‖
  have hpres : MeasurePreserving
      (WithLp.toLp 2 : WaveSpaceTime → JointWaveSpaceTime) volume volume := by
    simpa only using (WithLp.volume_preserving_toLp (Euclidean 2) Real)
  have htransport :
      (∫ p : WaveSpaceTime, Q (WithLp.toLp 2 p)) =
        ∫ z : JointWaveSpaceTime, Q z :=
    hpres.integral_comp
      (MeasurableEquiv.toLp 2 WaveSpaceTime).measurableEmbedding Q
  calc
    (∫ z : JointWaveSpaceTime, ‖A z.fst‖ * ‖H (z.snd - rho z.fst)‖) =
        ∫ z : JointWaveSpaceTime, Q z := by rfl
    _ = ∫ p : WaveSpaceTime, Q (WithLp.toLp 2 p) := htransport.symm
    _ = ∫ p : WaveSpaceTime, ‖A p.1‖ * ‖H (p.2 - rho p.1)‖ := by rfl
    _ = (∫ xi : Euclidean 2, ‖A xi‖) * ∫ t : Real, ‖H t‖ :=
      integral_sheared_norm_mul_norm_eq A hA H rho

private def scratchScaledNormalDefect
    (normal : SchwartzMap Real Complex) (scale gamma : Real) : Real → Complex :=
  fun u => (1 : Complex) - normal (scale ^ (-gamma) * u)

private theorem scratchScaledNormalDefect_eq_zero_near
    (normal : SchwartzMap Real Complex)
    (hnormal : ∀ s : Real, |s| ≤ 1 → normal s = 1)
    (scale gamma u : Real) (hscale : 0 < scale)
    (hnear : |u| < scale ^ gamma) :
    ∀ k : Nat,
      iteratedFDeriv Real k (scratchScaledNormalDefect normal scale gamma) u = 0 := by
  intro k
  have hpowpos : 0 < scale ^ (-gamma) := Real.rpow_pos_of_pos hscale _
  have hrecip : scale ^ (-gamma) * scale ^ gamma = 1 := by
    rw [← Real.rpow_add hscale]
    norm_num
  have hscaled : |scale ^ (-gamma) * u| < 1 := by
    rw [abs_mul, abs_of_pos hpowpos]
    have := (mul_lt_mul_of_pos_left hnear hpowpos)
    simpa only [hrecip] using this
  let U : Set Real := {v | |scale ^ (-gamma) * v| < 1}
  have hUopen : IsOpen U := by
    change IsOpen ((fun v : Real => |scale ^ (-gamma) * v|) ⁻¹' Set.Iio 1)
    exact isOpen_lt (continuous_const.mul continuous_id).abs continuous_const
  have hu : u ∈ U := hscaled
  have hUnear : U ∈ nhds u := hUopen.mem_nhds hu
  have hlocal : scratchScaledNormalDefect normal scale gamma =ᶠ[nhds u]
      (fun _ : Real => (0 : Complex)) := by
    filter_upwards [hUnear] with v hv
    change (1 : Complex) - normal (scale ^ (-gamma) * v) = 0
    rw [hnormal _ hv.le]
    ring
  have hderiv := (hlocal.iteratedFDeriv Real k).self_of_nhds
  simpa using hderiv

private theorem scratchScaledNormalDefect_derivative_gap
    (normal : SchwartzMap Real Complex)
    (hnormal : ∀ s : Real, |s| ≤ 1 → normal s = 1)
    (scale gamma u : Real) (hscale : 0 < scale)
    {k : Nat}
    (hneq : iteratedFDeriv Real k
      (scratchScaledNormalDefect normal scale gamma) u ≠ 0) :
    scale ^ gamma ≤ |u| := by
  by_contra hnot
  have hnear : |u| < scale ^ gamma := lt_of_not_ge hnot
  exact hneq (scratchScaledNormalDefect_eq_zero_near normal hnormal
    scale gamma u hscale hnear k)

private theorem scratchScaledNormalDefect_derivative_uniform
    (normal : SchwartzMap Real Complex) (gamma : Real) (hgamma : 0 < gamma)
    (k : Nat) :
    ∃ B : Real, 0 ≤ B ∧ ∀ (scale u : Real), 2 ≤ scale →
      ‖iteratedFDeriv Real k (scratchScaledNormalDefect normal scale gamma) u‖ ≤ B := by
  by_cases hk : k = 0
  · subst k
    let B : Real := 1 + SchwartzMap.seminorm Complex 0 0 normal
    refine ⟨B, ?_, ?_⟩
    · dsimp only [B]
      positivity
    · intro scale u hscale
      rw [norm_iteratedFDeriv_zero]
      calc
        ‖(1 : Complex) - normal (scale ^ (-gamma) * u)‖ ≤
            ‖(1 : Complex)‖ + ‖normal (scale ^ (-gamma) * u)‖ := norm_sub_le _ _
        _ = 1 + ‖normal (scale ^ (-gamma) * u)‖ := by rw [norm_one]
        _ ≤ 1 + SchwartzMap.seminorm Complex 0 0 normal := by
          gcongr
          exact SchwartzMap.norm_le_seminorm Complex normal _
        _ = B := rfl
  · let B : Real := SchwartzMap.seminorm Complex 0 k normal
    refine ⟨B, ?_, ?_⟩
    · exact (norm_nonneg (iteratedFDeriv Real k (normal : Real → Complex) 0)).trans
        (normal.norm_iteratedFDeriv_le_seminorm Complex k 0)
    · intro scale u hscale
      let a : Real := scale ^ (-gamma)
      let L : Real →L[Real] Real := a • ContinuousLinearMap.id Real Real
      have hscalepos : 0 < scale := by linarith
      have ha : 0 < a := Real.rpow_pos_of_pos hscalepos _
      have hale : a ≤ 1 := by
        dsimp only [a]
        exact Real.rpow_le_one_of_one_le_of_nonpos (by linarith) (by linarith)
      have hLnorm : ‖L‖ ≤ 1 := by
        refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
        intro x
        change ‖a • x‖ ≤ 1 * ‖x‖
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos ha, one_mul]
        exact mul_le_of_le_one_left (norm_nonneg _) hale
      have hcomp : (fun v : Real => normal (a * v)) =
          (normal : Real → Complex) ∘ L := by
        funext v
        rfl
      have hderiv : iteratedFDeriv Real k
          (fun v : Real => normal (a * v)) u =
          (iteratedFDeriv Real k (normal : Real → Complex) (a * u)).compContinuousLinearMap
            (fun _ => L) := by
        rw [hcomp]
        exact L.iteratedFDeriv_comp_right (normal.smooth (k : ℕ∞)) u le_rfl
      have hnormal : ‖iteratedFDeriv Real k
          (normal : Real → Complex) (a * u)‖ ≤ B := by
        dsimp only [B]
        exact normal.norm_iteratedFDeriv_le_seminorm Complex k _
      have hscaled : ‖iteratedFDeriv Real k
          (fun v : Real => normal (a * v)) u‖ ≤ B := by
        rw [hderiv]
        calc
          ‖(iteratedFDeriv Real k (normal : Real → Complex) (a * u)).compContinuousLinearMap
              (fun _ => L)‖ ≤
              ‖iteratedFDeriv Real k (normal : Real → Complex) (a * u)‖ *
                ∏ _ : Fin k, ‖L‖ :=
            ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
          _ ≤ ‖iteratedFDeriv Real k (normal : Real → Complex) (a * u)‖ *
                ∏ _ : Fin k, (1 : Real) := by
            gcongr
          _ = ‖iteratedFDeriv Real k (normal : Real → Complex) (a * u)‖ := by simp
          _ ≤ B := hnormal
      have hconst : iteratedFDeriv Real k (fun _ : Real => (1 : Complex)) u = 0 :=
        congrFun (iteratedFDeriv_const_of_ne hk 1) u
      change ‖iteratedFDeriv Real k
        (fun v : Real => (1 : Complex) - normal (a * v)) u‖ ≤ B
      rw [show (fun v : Real => (1 : Complex) - normal (a * v)) =
          (fun _ : Real => (1 : Complex)) - fun v : Real => normal (a * v) by rfl]
      have hconstSmooth : ContDiff Real (k : ℕ∞)
          (fun _ : Real => (1 : Complex)) := contDiff_const
      have hnormalSmooth : ContDiff Real (k : ℕ∞)
          (fun v : Real => normal (a * v)) := by
        rw [hcomp]
        exact (normal.smooth _).comp_continuousLinearMap (g := L)
      rw [iteratedFDeriv_sub hconstSmooth hnormalSmooth]
      simp only [Pi.sub_apply, hconst, zero_sub, norm_neg]
      exact hscaled

private theorem exists_scratch_wavefront_temporalTail_weightedProfile_all
    (h : SchwartzMap Real Complex) (gamma : Real) (hgamma : 0 < gamma)
    (N : Nat) :
    ∃ q : Nat, ∀ (i : Nat) (scale u : Real), 2 ≤ scale →
      scale ^ gamma ≤ |u| →
      scale ^ N * ‖iteratedFDeriv Real i (h : Real → Complex) u‖ ≤
        ‖scratchWeightedTemporalDerivativeProfile h i q u‖ := by
  obtain ⟨q, hq⟩ := exists_nat_ge ((N : Real) / (2 * gamma))
  refine ⟨q, ?_⟩
  intro i scale u hscale hgap
  let R : Real := scale ^ (2 * gamma)
  have hscaleone : 1 ≤ scale := by linarith
  have hscalenonneg : 0 ≤ scale := zero_le_one.trans hscaleone
  have hRnonneg : 0 ≤ R := Real.rpow_nonneg hscalenonneg _
  have hsqrt : Real.sqrt R = scale ^ gamma := by
    dsimp only [R]
    rw [Real.sqrt_eq_rpow, ← Real.rpow_mul hscalenonneg]
    congr 1
    ring
  have hgap' : Real.sqrt R ≤ |u| := by simpa only [hsqrt] using hgap
  have hmain := scale_pow_mul_norm_iteratedFDeriv_time_le_weighted_profile
    h i q R u hRnonneg hgap'
  have hpowexp : (N : Real) ≤ 2 * gamma * q := by
    have hpos : 0 < 2 * gamma := by positivity
    have h := (div_le_iff₀ hpos).mp hq
    nlinarith [h]
  have hpow : scale ^ N ≤ R ^ q := by
    rw [← Real.rpow_natCast]
    change scale ^ (N : Real) ≤ (scale ^ (2 * gamma)) ^ q
    rw [← Real.rpow_natCast, ← Real.rpow_mul hscalenonneg]
    exact Real.rpow_le_rpow_of_exponent_le hscaleone hpowexp
  calc
    scale ^ N * ‖iteratedFDeriv Real i (h : Real → Complex) u‖ ≤
        R ^ q * ‖iteratedFDeriv Real i (h : Real → Complex) u‖ := by
          gcongr
    _ ≤ ‖scratchWeightedTemporalDerivativeProfile h i q u‖ := hmain

/-- A uniform finite weighted-Schwartz envelope for every temporal
derivative that can occur in an order-`r` chain rule.  This is derived from
the literal cutoff defect and the gap, rather than being a residual
assumption. -/
private theorem exists_scratch_wavefront_normalTail_derivative_weightedEnvelope_all
    (normal h : SchwartzMap Real Complex)
    (hnormal : ∀ s : Real, |s| ≤ 1 → normal s = 1)
    (gamma : Real) (hgamma : 0 < gamma)
    (r N : Nat) :
    ∃ (q : Nat) (C : Real), 0 ≤ C ∧
      ∀ {i : Nat}, i ≤ r → ∀ (scale u : Real), 2 ≤ scale →
        scale ^ N *
          ‖iteratedFDeriv Real i
            (fun v : Real =>
              scratchScaledNormalDefect normal scale gamma v * h v) u‖ ≤
          C * ∑ j ∈ Finset.range (r + 1),
            ‖scratchWeightedTemporalDerivativeProfile h j q u‖ := by
  let q : Nat :=
    (exists_scratch_wavefront_temporalTail_weightedProfile_all
      h gamma hgamma N).choose
  have htime (i : Nat) : ∀ (scale u : Real), 2 ≤ scale →
      scale ^ gamma ≤ |u| →
      scale ^ N * ‖iteratedFDeriv Real i (h : Real → Complex) u‖ ≤
        ‖scratchWeightedTemporalDerivativeProfile h i q u‖ := by
    simpa only [q] using
      (exists_scratch_wavefront_temporalTail_weightedProfile_all
        h gamma hgamma N).choose_spec i
  let B : Nat → Real := fun j =>
    (scratchScaledNormalDefect_derivative_uniform normal gamma hgamma j).choose
  have hBnonneg (j : Nat) : 0 ≤ B j :=
    (scratchScaledNormalDefect_derivative_uniform normal gamma hgamma j).choose_spec.1
  have hB (j : Nat) : ∀ (scale u : Real), 2 ≤ scale →
      ‖iteratedFDeriv Real j (scratchScaledNormalDefect normal scale gamma) u‖ ≤ B j := by
    simpa only [B] using
      (scratchScaledNormalDefect_derivative_uniform normal gamma hgamma j).choose_spec.2
  let Ci : Nat → Real := fun i => ∑ a ∈ Finset.range (i + 1),
    (i.choose a : Real) * B a
  have hCinonneg (i : Nat) : 0 ≤ Ci i := by
    dsimp only [Ci]
    apply Finset.sum_nonneg
    intro a ha
    exact mul_nonneg (by positivity) (hBnonneg a)
  let C : Real := ∑ i ∈ Finset.range (r + 1), Ci i
  have hCnonneg : 0 ≤ C := by
    dsimp only [C]
    exact Finset.sum_nonneg fun i hi => hCinonneg i
  have hCileC {i : Nat} (hi : i ≤ r) : Ci i ≤ C := by
    dsimp only [C]
    exact Finset.single_le_sum (s := Finset.range (r + 1)) (f := Ci)
      (fun j hj => hCinonneg j)
      (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
  refine ⟨q, C, hCnonneg, ?_⟩
  intro i hi scale u hscale
  let d : Real → Complex := scratchScaledNormalDefect normal scale gamma
  let S : Real := ∑ j ∈ Finset.range (r + 1),
    ‖scratchWeightedTemporalDerivativeProfile h j q u‖
  have hSnonneg : 0 ≤ S := by
    dsimp only [S]
    apply Finset.sum_nonneg
    intro j hj
    exact norm_nonneg _
  have hd : ContDiff Real (i : ℕ∞) d := by
    dsimp only [d, scratchScaledNormalDefect]
    let a : Real →L[Real] Real := (scale ^ (-gamma)) • ContinuousLinearMap.id Real Real
    change ContDiff Real (i : ℕ∞) (fun v : Real =>
      (1 : Complex) - normal (a v))
    exact contDiff_const.sub ((normal.smooth _).comp_continuousLinearMap (g := a))
  have hh : ContDiff Real (i : ℕ∞) (h : Real → Complex) := h.smooth _
  have hprod := norm_iteratedFDeriv_mul_le hd hh u le_rfl
  have hpoint :
      scale ^ N * ‖iteratedFDeriv Real i (fun v : Real => d v * h v) u‖ ≤
        Ci i * S := by
    calc
      scale ^ N * ‖iteratedFDeriv Real i (fun v : Real => d v * h v) u‖ ≤
          scale ^ N *
            ∑ a ∈ Finset.range (i + 1),
              (i.choose a : Real) * ‖iteratedFDeriv Real a d u‖ *
                ‖iteratedFDeriv Real (i - a) (h : Real → Complex) u‖ := by
            exact mul_le_mul_of_nonneg_left hprod (pow_nonneg (by linarith) _)
      _ = ∑ a ∈ Finset.range (i + 1),
            (i.choose a : Real) * ‖iteratedFDeriv Real a d u‖ *
              (scale ^ N * ‖iteratedFDeriv Real (i - a) (h : Real → Complex) u‖) := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro a ha
            ring
      _ ≤ ∑ a ∈ Finset.range (i + 1),
            (i.choose a : Real) * B a * S := by
            apply Finset.sum_le_sum
            intro a ha
            by_cases hzero : iteratedFDeriv Real a d u = 0
            · rw [hzero]
              simp only [norm_zero, mul_zero, zero_mul]
              exact mul_nonneg (mul_nonneg (by positivity) (hBnonneg a)) hSnonneg
            · have hgap : scale ^ gamma ≤ |u| :=
                scratchScaledNormalDefect_derivative_gap normal hnormal scale gamma u
                  (by linarith) hzero
              have htime' := htime (i - a) scale u hscale hgap
              have hterm :
                  ‖scratchWeightedTemporalDerivativeProfile h (i - a) q u‖ ≤ S := by
                dsimp only [S]
                exact Finset.single_le_sum (s := Finset.range (r + 1))
                  (f := fun j => ‖scratchWeightedTemporalDerivativeProfile h j q u‖)
                  (fun j hj => norm_nonneg _)
                  (Finset.mem_range.mpr
                    (Nat.lt_succ_of_le (le_trans (Nat.sub_le _ _) hi)))
              have htimeS :
                  scale ^ N * ‖iteratedFDeriv Real (i - a) (h : Real → Complex) u‖ ≤ S :=
                htime'.trans hterm
              have hderiv := hB a scale u hscale
              have hchoose : 0 ≤ (i.choose a : Real) := by positivity
              have hfirst : (i.choose a : Real) * ‖iteratedFDeriv Real a d u‖ ≤
                  (i.choose a : Real) * B a :=
                mul_le_mul_of_nonneg_left hderiv hchoose
              calc
                (i.choose a : Real) * ‖iteratedFDeriv Real a d u‖ *
                    (scale ^ N * ‖iteratedFDeriv Real (i - a) (h : Real → Complex) u‖) ≤
                    ((i.choose a : Real) * B a) *
                      (scale ^ N * ‖iteratedFDeriv Real (i - a) (h : Real → Complex) u‖) :=
                  mul_le_mul_of_nonneg_right hfirst (by positivity)
                _ ≤ ((i.choose a : Real) * B a) * S :=
                  mul_le_mul_of_nonneg_left htimeS (mul_nonneg hchoose (hBnonneg a))
                _ = (i.choose a : Real) * B a * S := by ring
      _ = Ci i * S := by
            dsimp only [Ci]
            rw [Finset.sum_mul]
  calc
    scale ^ N * ‖iteratedFDeriv Real i
        (fun v : Real =>
          scratchScaledNormalDefect normal scale gamma v * h v) u‖ =
        scale ^ N * ‖iteratedFDeriv Real i (fun v : Real => d v * h v) u‖ := by rfl
    _ ≤ Ci i * S := hpoint
    _ ≤ C * S := mul_le_mul_of_nonneg_right (hCileC hi) hSnonneg
    _ = C * ∑ j ∈ Finset.range (r + 1),
          ‖scratchWeightedTemporalDerivativeProfile h j q u‖ := rfl


private theorem exists_scratchWavefront_shearedNormalTail_derivative_weightedEnvelope
    (D : MSSWavefrontKernelData) (r N : Nat) :
    ∃ (L : Nat) (C : Real), 0 ≤ C ∧
      ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
        ∀ z : JointWaveSpaceTime,
          scale ^ N *
            ‖iteratedFDeriv Real r
              (fun w : JointWaveSpaceTime =>
                D.normalTail scale
                  (scratchJointNormalDifference D.radialTime scale hscale w)) z‖ ≤
            C * ∑ i ∈ Finset.range (r + 1),
              ‖scratchWeightedTemporalDerivativeProfile
                (FourierTransform.fourier D.radialTime.time) i L
                (scratchJointNormalDifference D.radialTime scale hscale z)‖ := by
  let h : SchwartzMap Real Complex := FourierTransform.fourier D.radialTime.time
  let L : Nat :=
    (exists_scratch_wavefront_normalTail_derivative_weightedEnvelope_all
      D.normal h D.normal_one_on_unit D.gamma D.gamma_pos r N).choose
  let A : Real :=
    (exists_scratch_wavefront_normalTail_derivative_weightedEnvelope_all
      D.normal h D.normal_one_on_unit D.gamma D.gamma_pos r N).choose_spec.choose
  have hAnonneg : 0 ≤ A := by
    simpa only [A, L] using
      (exists_scratch_wavefront_normalTail_derivative_weightedEnvelope_all
        D.normal h D.normal_one_on_unit D.gamma D.gamma_pos r N).choose_spec.choose_spec.1
  have hA {i : Nat} (hi : i ≤ r) : ∀ (scale u : Real), 2 ≤ scale →
      scale ^ N * ‖iteratedFDeriv Real i
        (fun v : Real => scratchScaledNormalDefect D.normal scale D.gamma v * h v) u‖ ≤
        A * ∑ j ∈ Finset.range (r + 1),
          ‖scratchWeightedTemporalDerivativeProfile h j L u‖ := by
    simpa only [A, L] using
      (exists_scratch_wavefront_normalTail_derivative_weightedEnvelope_all
        D.normal h D.normal_one_on_unit D.gamma D.gamma_pos r N).choose_spec.choose_spec.2 hi
  let B : Nat → Real := fun i => if hi : 1 ≤ i then
    (exists_scratchJointNormalDifference_iteratedFDeriv_uniform_bound
      D.radialTime i hi).choose else 0
  have hB {i : Nat} (hi : 1 ≤ i) :
      ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
        ∀ z : JointWaveSpaceTime,
          ‖iteratedFDeriv Real i
            (scratchJointNormalDifference D.radialTime scale hscale :
              JointWaveSpaceTime → Real) z‖ ≤ B i := by
    simpa only [B, dif_pos hi] using
      (exists_scratchJointNormalDifference_iteratedFDeriv_uniform_bound
        D.radialTime i hi).choose_spec.2
  let R : Real := ∑ i ∈ Finset.range (r + 1), max 1 (B i)
  have hRone : 1 ≤ R := by
    dsimp only [R]
    calc
      1 ≤ max 1 (B 0) := le_max_left _ _
      _ ≤ ∑ i ∈ Finset.range (r + 1), max 1 (B i) :=
        Finset.single_le_sum (s := Finset.range (r + 1))
          (f := fun i => max 1 (B i))
          (fun i hi => le_trans zero_le_one (le_max_left _ _))
          (Finset.mem_range.mpr (Nat.succ_pos r))
  have hBleR {i : Nat} (hi : i ≤ r) : B i ≤ R := by
    calc
      B i ≤ max 1 (B i) := le_max_right _ _
      _ ≤ ∑ j ∈ Finset.range (r + 1), max 1 (B j) :=
        Finset.single_le_sum (s := Finset.range (r + 1))
          (f := fun j => max 1 (B j))
          (fun j hj => le_trans zero_le_one (le_max_left _ _))
          (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
  let C : Real := (r.factorial : Real) * A * R ^ r
  refine ⟨L, C, ?_, ?_⟩
  · exact mul_nonneg (mul_nonneg (by positivity) hAnonneg)
      (pow_nonneg (le_trans zero_le_one hRone) _)
  intro scale hscale hscale_two z
  let q : JointWaveSpaceTime → Real := scratchJointNormalDifference D.radialTime scale hscale
  let H : Real → Complex := D.normalTail scale
  let S : Real := ∑ i ∈ Finset.range (r + 1),
    ‖scratchWeightedTemporalDerivativeProfile h i L (q z)‖
  have hSnonneg : 0 ≤ S := by
    dsimp only [S]
    apply Finset.sum_nonneg
    intro i hi
    exact norm_nonneg _
  have hH : H = fun v : Real =>
      scratchScaledNormalDefect D.normal scale D.gamma v * h v := by
    funext v
    dsimp only [H, h, scratchScaledNormalDefect]
    rw [D.normalTail_apply]
    rw [← SchwartzMap.fourier_coe]
  have hq : ContDiff Real (r : ℕ∞) q := by
    let Ls : JointWaveSpaceTime →L[Real] Real :=
      WithLp.sndL 2 Real (Euclidean 2) Real
    let Lf : JointWaveSpaceTime →L[Real] Euclidean 2 :=
      WithLp.fstL 2 Real (Euclidean 2) Real
    let rho : SchwartzMap (Euclidean 2) Real :=
      scratchScaledNormalExtension D.radialTime scale hscale
    change ContDiff Real (r : ℕ∞) (fun w => Ls w - rho (Lf w))
    exact Ls.contDiff.sub ((rho.smooth _).comp_continuousLinearMap (g := Lf))
  have hHsmooth : ContDiff Real (r : ℕ∞) H := by
    dsimp only [H]
    exact (D.normalTail scale).smooth _
  have hscaleNpos : 0 < scale ^ N := pow_pos hscale N
  have houter {i : Nat} (hi : i ≤ r) :
      ‖iteratedFDeriv Real i H (q z)‖ ≤ (A * S) / scale ^ N := by
    have hraw := hA hi scale (q z) hscale_two
    rw [← hH] at hraw
    have hbound : scale ^ N * ‖iteratedFDeriv Real i H (q z)‖ ≤ A * S := by
      simpa only [S] using hraw
    apply (le_div_iff₀ hscaleNpos).2
    calc
      ‖iteratedFDeriv Real i H (q z)‖ * scale ^ N =
          scale ^ N * ‖iteratedFDeriv Real i H (q z)‖ := by ring
      _ ≤ A * S := hbound
  have hinner {i : Nat} (hi1 : 1 ≤ i) (hi : i ≤ r) :
      ‖iteratedFDeriv Real i q z‖ ≤ R ^ i := by
    calc
      ‖iteratedFDeriv Real i q z‖ ≤ B i := by
        dsimp only [q]
        exact hB hi1 scale hscale (by linarith) z
      _ ≤ R := hBleR hi
      _ ≤ R ^ i := le_self_pow₀ hRone (Nat.ne_of_gt (Nat.zero_lt_of_lt hi1))
  have hchain := norm_iteratedFDeriv_comp_le hHsmooth hq
      (by simp : (r : WithTop ℕ∞) ≤ ((r : ℕ∞) : WithTop ℕ∞)) z
      (fun i hi => houter hi)
      (fun i hi1 hi => hinner hi1 hi)
  change scale ^ N *
      ‖iteratedFDeriv Real r (fun w : JointWaveSpaceTime => H (q w)) z‖ ≤
        C * S
  calc
    scale ^ N *
        ‖iteratedFDeriv Real r (fun w : JointWaveSpaceTime => H (q w)) z‖ ≤
        scale ^ N * ((r.factorial : Real) * ((A * S) / scale ^ N) * R ^ r) := by
          exact mul_le_mul_of_nonneg_left hchain hscaleNpos.le
    _ = ((r.factorial : Real) * A * R ^ r) * S := by
          field_simp [hscaleNpos.ne']
    _ = C * S := rfl

private noncomputable def scratchWavefrontNormalTailProfile
    (D : MSSWavefrontKernelData) (scale : Real) (n nu : Int) :
    SchwartzMap JointWaveSpaceTime Complex :=
  jointSchwartzModulatedAnnularProfile
    (D.spatialProfile scale n nu)
    (FourierTransform.fourierInv (D.normalTail scale))
    (D.normalCoordinate scale)

/-- The temporal window viewed as a function on joint frequency space. -/
private def scratchWavefrontLiftVertical
    (m : SchwartzMap Real Complex) : JointWaveSpaceTime → Complex :=
  fun z => m z.snd

private theorem scratchWavefrontLiftVertical_smooth
    (m : SchwartzMap Real Complex) (r : ℕ∞) :
    ContDiff Real r (scratchWavefrontLiftVertical m) := by
  change ContDiff Real r (m ∘ WithLp.sndL 2 Real (Euclidean 2) Real)
  exact (m.smooth r).comp_continuousLinearMap
    (g := WithLp.sndL 2 Real (Euclidean 2) Real)

private theorem scratchWavefrontPacketResidualMultiplier_eq_vertical_mul_tail
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale)
    (n nu : Int) :
    (scratchWavefrontPacketResidualMultiplier D scale hscale n nu :
      JointWaveSpaceTime → Complex) =
      fun z =>
        scratchWavefrontLiftVertical
          (scratchWavefrontVerticalProfile D scale n hscale) z *
          scratchWavefrontNormalTailProfile D scale n nu z := by
  funext z
  have hz : WithLp.toLp 2 (z.fst, z.snd) = z := by
    apply (WithLp.ext_iff 2).2
    rfl
  rw [← hz]
  rw [scratchWavefrontPacketResidualMultiplier,
    scratchWavefrontApplyVertical_apply]
  rfl

/-- Quantitative regularity of the supplied cutoff profiles.  These are
frequency-side estimates on the data only.  In particular there is no
physical-space norm and no input function in either field. -/
private structure ScratchWavefrontCutoffProfileRegularity
    (D : MSSWavefrontKernelData) : Prop where
  /-- Uniform derivatives of the fixed vertical cutoff after its allowed
translation/dilation. -/
  vertical_derivative_uniform : ∀ r : Nat, ∃ B : Real, 0 ≤ B ∧
    ∀ (scale : Real) (hscale : 0 < scale) (n : Int), 2 ≤ scale →
      ∀ z : JointWaveSpaceTime,
        ‖iteratedFDeriv Real r
          (scratchWavefrontLiftVertical
            (scratchWavefrontVerticalProfile D scale n hscale)) z‖ ≤ B
  /-- The normal-gap tail estimate after the polynomial spatial packet cost.
This is the scale-uniform cutoff/symbol datum supplied by the angular
partition construction. -/
  normal_tail_profile_rapid : ∀ r N : Nat, ∃ C : Real, 0 ≤ C ∧
    ∀ (scale : Real) (hscale : 0 < scale) (n nu : Int), 2 ≤ scale →
      n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
      scale ^ N *
        (∫ z : JointWaveSpaceTime,
          ‖iteratedFDeriv Real r
            (scratchWavefrontNormalTailProfile D scale n nu :
              JointWaveSpaceTime → Complex) z‖) ≤ C

/-- The cutoff-profile regularity gives the derivative-integral condition
used by the kernel closure.  This is a genuine finite Leibniz calculation:
the multiplier bound is derived here and is not a hypothesis of the final
packet estimate. -/
private theorem ScratchWavefrontCutoffProfileRegularity.to_rapidMultiplierBounds
    {D : MSSWavefrontKernelData}
    (hreg : ScratchWavefrontCutoffProfileRegularity D) :
    scratchWavefrontRapidMultiplierBounds D := by
  intro r N
  let B : Nat → Real := fun a => (hreg.vertical_derivative_uniform a).choose
  have hBnonneg (a : Nat) : 0 ≤ B a :=
    (hreg.vertical_derivative_uniform a).choose_spec.1
  have hB (a : Nat) :
      ∀ (scale : Real) (hscale : 0 < scale) (n : Int), 2 ≤ scale →
        ∀ z : JointWaveSpaceTime,
          ‖iteratedFDeriv Real a
            (scratchWavefrontLiftVertical
              (scratchWavefrontVerticalProfile D scale n hscale)) z‖ ≤ B a := by
    simpa only [B] using (hreg.vertical_derivative_uniform a).choose_spec.2
  let C : Nat → Real := fun a => (hreg.normal_tail_profile_rapid a N).choose
  have hCnonneg (a : Nat) : 0 ≤ C a :=
    (hreg.normal_tail_profile_rapid a N).choose_spec.1
  have hC (a : Nat) :
      ∀ (scale : Real) (hscale : 0 < scale) (n nu : Int), 2 ≤ scale →
        n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
        scale ^ N *
          (∫ z : JointWaveSpaceTime,
            ‖iteratedFDeriv Real a
              (scratchWavefrontNormalTailProfile D scale n nu :
                JointWaveSpaceTime → Complex) z‖) ≤ C a := by
    simpa only [C] using (hreg.normal_tail_profile_rapid a N).choose_spec.2
  let E : Real := ∑ a ∈ Finset.range (r + 1),
    (r.choose a : Real) * B a * C (r - a)
  refine ⟨E, ?_, ?_⟩
  · dsimp only [E]
    apply Finset.sum_nonneg
    intro a ha
    exact mul_nonneg
      (mul_nonneg (by positivity) (hBnonneg a))
      (hCnonneg (r - a))
  intro scale hscale n nu hscale_two hn hnu
  let V : JointWaveSpaceTime → Complex :=
    scratchWavefrontLiftVertical
      (scratchWavefrontVerticalProfile D scale n hscale)
  let T : SchwartzMap JointWaveSpaceTime Complex :=
    scratchWavefrontNormalTailProfile D scale n nu
  let M : SchwartzMap JointWaveSpaceTime Complex :=
    scratchWavefrontPacketResidualMultiplier D scale hscale n nu
  have hMfactor : (M : JointWaveSpaceTime → Complex) = fun z => V z * T z := by
    simpa only [M, V, T] using
      scratchWavefrontPacketResidualMultiplier_eq_vertical_mul_tail
        D scale hscale n nu
  have hV : ContDiff Real (r : ℕ∞) V := by
    dsimp only [V]
    exact scratchWavefrontLiftVertical_smooth
      (scratchWavefrontVerticalProfile D scale n hscale) _
  have hT : ContDiff Real (r : ℕ∞) (T : JointWaveSpaceTime → Complex) :=
    T.smooth _
  let R : JointWaveSpaceTime → Real := fun z =>
    ∑ a ∈ Finset.range (r + 1),
      (r.choose a : Real) * B a *
        (scale ^ N * ‖iteratedFDeriv Real (r - a)
          (T : JointWaveSpaceTime → Complex) z‖)
  have hRnonneg (z : JointWaveSpaceTime) : 0 ≤ R z := by
    dsimp only [R]
    apply Finset.sum_nonneg
    intro a ha
    exact mul_nonneg
      (mul_nonneg (by positivity) (hBnonneg a))
      (mul_nonneg
        (pow_nonneg (le_trans (by norm_num) hscale_two) _)
        (norm_nonneg _))
  have hpoint (z : JointWaveSpaceTime) :
      scale ^ N * ‖iteratedFDeriv Real r (M : JointWaveSpaceTime → Complex) z‖ ≤ R z := by
    have hprod := norm_iteratedFDeriv_mul_le hV hT z le_rfl
    rw [hMfactor]
    calc
      scale ^ N * ‖iteratedFDeriv Real r (fun w => V w * T w) z‖ ≤
          scale ^ N *
            ∑ a ∈ Finset.range (r + 1),
              (r.choose a : Real) * ‖iteratedFDeriv Real a V z‖ *
                ‖iteratedFDeriv Real (r - a) (T : JointWaveSpaceTime → Complex) z‖ := by
            exact mul_le_mul_of_nonneg_left hprod
              (pow_nonneg (le_trans (by norm_num) hscale_two) _)
      _ = ∑ a ∈ Finset.range (r + 1),
            (r.choose a : Real) *
              (scale ^ N * ‖iteratedFDeriv Real a V z‖) *
                ‖iteratedFDeriv Real (r - a)
                  (T : JointWaveSpaceTime → Complex) z‖ := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro a ha
            ring
      _ ≤ ∑ a ∈ Finset.range (r + 1),
            (r.choose a : Real) *
              (scale ^ N * B a) *
                ‖iteratedFDeriv Real (r - a)
                  (T : JointWaveSpaceTime → Complex) z‖ := by
            apply Finset.sum_le_sum
            intro a ha
            have hderiv := hB a scale hscale n hscale_two z
            have hscaleN : 0 ≤ scale ^ N :=
              pow_nonneg (le_trans (by norm_num) hscale_two) _
            have hscaled : scale ^ N * ‖iteratedFDeriv Real a V z‖ ≤
                scale ^ N * B a :=
              mul_le_mul_of_nonneg_left hderiv hscaleN
            have hchoose : 0 ≤ (r.choose a : Real) := by positivity
            have hfirst : (r.choose a : Real) *
                (scale ^ N * ‖iteratedFDeriv Real a V z‖) ≤
                (r.choose a : Real) * (scale ^ N * B a) :=
              mul_le_mul_of_nonneg_left hscaled hchoose
            exact mul_le_mul_of_nonneg_right hfirst (norm_nonneg _)
      _ = R z := by
            dsimp only [R]
            apply Finset.sum_congr rfl
            intro a ha
            ring
  have htermIntegrable (a : Nat) : Integrable (fun z : JointWaveSpaceTime =>
      (r.choose a : Real) * B a *
        (scale ^ N * ‖iteratedFDeriv Real (r - a)
          (T : JointWaveSpaceTime → Complex) z‖)) volume := by
    have hTa : Integrable (fun z : JointWaveSpaceTime =>
        ‖iteratedFDeriv Real (r - a)
          (T : JointWaveSpaceTime → Complex) z‖) volume := by
      simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume T 0 (r - a)
    have hconst : Integrable (fun z : JointWaveSpaceTime =>
        ((r.choose a : Real) * B a * scale ^ N) *
          ‖iteratedFDeriv Real (r - a)
            (T : JointWaveSpaceTime → Complex) z‖) volume :=
      hTa.const_mul _
    simpa only [mul_assoc] using hconst
  have hRintegrable : Integrable R volume := by
    dsimp only [R]
    exact integrable_finsetSum _ fun a ha => htermIntegrable a
  have hleftnonneg : ∀ z : JointWaveSpaceTime,
      0 ≤ scale ^ N * ‖iteratedFDeriv Real r (M : JointWaveSpaceTime → Complex) z‖ := by
    intro z
    positivity
  have hint :
      ∫ z : JointWaveSpaceTime,
        scale ^ N * ‖iteratedFDeriv Real r (M : JointWaveSpaceTime → Complex) z‖ ≤
      ∫ z : JointWaveSpaceTime, R z :=
    integral_mono_of_nonneg (Eventually.of_forall hleftnonneg) hRintegrable
      (Eventually.of_forall hpoint)
  have hRformula :
      (∫ z : JointWaveSpaceTime, R z) =
        ∑ a ∈ Finset.range (r + 1),
          (r.choose a : Real) * B a *
            (scale ^ N *
              ∫ z : JointWaveSpaceTime,
                ‖iteratedFDeriv Real (r - a)
                  (T : JointWaveSpaceTime → Complex) z‖) := by
    calc
      (∫ z : JointWaveSpaceTime, R z) =
          ∑ a ∈ Finset.range (r + 1),
            ∫ z : JointWaveSpaceTime,
              (r.choose a : Real) * B a *
                (scale ^ N * ‖iteratedFDeriv Real (r - a)
                  (T : JointWaveSpaceTime → Complex) z‖) := by
            dsimp only [R]
            exact integral_finsetSum _ fun a ha => htermIntegrable a
      _ = ∑ a ∈ Finset.range (r + 1),
          (r.choose a : Real) * B a *
            (scale ^ N *
              ∫ z : JointWaveSpaceTime,
                ‖iteratedFDeriv Real (r - a)
                  (T : JointWaveSpaceTime → Complex) z‖) := by
            apply Finset.sum_congr rfl
            intro a ha
            calc
              (∫ z : JointWaveSpaceTime,
                  (r.choose a : Real) * B a *
                    (scale ^ N * ‖iteratedFDeriv Real (r - a)
                      (T : JointWaveSpaceTime → Complex) z‖)) =
                  ∫ z : JointWaveSpaceTime,
                    ((r.choose a : Real) * B a) *
                      (scale ^ N * ‖iteratedFDeriv Real (r - a)
                        (T : JointWaveSpaceTime → Complex) z‖) := by
                    apply integral_congr_ae
                    filter_upwards with z
                    ring
              _ = ((r.choose a : Real) * B a) *
                  ∫ z : JointWaveSpaceTime,
                    scale ^ N * ‖iteratedFDeriv Real (r - a)
                      (T : JointWaveSpaceTime → Complex) z‖ :=
                    integral_const_mul _ _
              _ = ((r.choose a : Real) * B a) *
                  (scale ^ N *
                    ∫ z : JointWaveSpaceTime,
                      ‖iteratedFDeriv Real (r - a)
                        (T : JointWaveSpaceTime → Complex) z‖) := by
                    rw [integral_const_mul]
  calc
    scale ^ N *
        (∫ z : JointWaveSpaceTime,
          ‖iteratedFDeriv Real r (M : JointWaveSpaceTime → Complex) z‖) =
        ∫ z : JointWaveSpaceTime,
          scale ^ N * ‖iteratedFDeriv Real r (M : JointWaveSpaceTime → Complex) z‖ := by
            rw [integral_const_mul]
    _ ≤ ∫ z : JointWaveSpaceTime, R z := hint
    _ = ∑ a ∈ Finset.range (r + 1),
          (r.choose a : Real) * B a *
            (scale ^ N *
              ∫ z : JointWaveSpaceTime,
                ‖iteratedFDeriv Real (r - a)
                  (T : JointWaveSpaceTime → Complex) z‖) := hRformula
    _ ≤ ∑ a ∈ Finset.range (r + 1),
          (r.choose a : Real) * B a * C (r - a) := by
            apply Finset.sum_le_sum
            intro a ha
            have hcoef : 0 ≤ (r.choose a : Real) * B a :=
              mul_nonneg (by positivity) (hBnonneg a)
            simpa only [mul_assoc] using
              mul_le_mul_of_nonneg_left
                (hC (r - a) scale hscale n nu hscale_two hn hnu) hcoef
    _ = E := rfl

/-- The packet (L^4) estimate now consumes only cutoff-profile regularity.
The multiplier derivative estimate is an internal consequence above. -/
private theorem ScratchWavefrontCutoffProfileRegularity.exists_packet_L4_rapid_bound
    {D : MSSWavefrontKernelData}
    (hreg : ScratchWavefrontCutoffProfileRegularity D) (N : Nat) :
    ∃ C : Real, 0 < C ∧
      ∀ (scale : Real) (hscale : 0 < scale) (n nu : Int), 2 ≤ scale →
        n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
        ∀ f : SchwartzMap (Euclidean 2) Complex,
          eLpNorm (scratchWavefrontPacketResidual D scale hscale n nu f) 4 volume ≤
            ENNReal.ofReal (C * (scale⁻¹) ^ N) *
              eLpNorm (f : Euclidean 2 → Complex) 4 volume :=
  hreg.to_rapidMultiplierBounds.exists_packet_L4_rapid_bound N

/-- Exact derivative formula for the literal scale/translation vertical
window. -/
private theorem scratchWavefront_iteratedFDeriv_verticalProfile_eq
    (D : MSSWavefrontKernelData) (scale : Real) (n : Int)
    (hscale : 0 < scale) (k : Nat) (tau : Real) :
    iteratedFDeriv Real k
      (scratchWavefrontVerticalProfile D scale n hscale : Real → Complex) tau =
      (Real.sqrt scale)⁻¹ ^ k • iteratedFDeriv Real k
        (D.radialTime.vertical : Real → Complex)
        ((Real.sqrt scale)⁻¹ * tau - n) := by
  let root : Real := Real.sqrt scale
  let a : Real := root⁻¹
  let c : Real := root * n
  have hroot : root ≠ 0 := by
    exact Real.sqrt_ne_zero'.mpr hscale
  have hfun : (scratchWavefrontVerticalProfile D scale n hscale : Real → Complex) =
      fun t : Real => (fun y : Real => D.radialTime.vertical (a • y)) (t - c) := by
    funext t
    rw [scratchWavefrontVerticalProfile_apply]
    change D.radialTime.vertical ((Real.sqrt scale)⁻¹ * t - n) =
      D.radialTime.vertical (a * (t - c))
    dsimp only [a, c, root]
    field_simp [hroot]
  rw [hfun]
  have hsub :
      iteratedFDeriv Real k
        (fun t : Real => (fun y : Real => D.radialTime.vertical (a • y)) (t - c)) tau =
      iteratedFDeriv Real k (fun y : Real => D.radialTime.vertical (a • y)) (tau - c) := by
    simpa using (iteratedFDeriv_comp_sub (𝕜 := Real)
      (f := fun y : Real => D.radialTime.vertical (a • y)) k c tau)
  rw [hsub]
  rw [iteratedFDeriv_comp_const_smul a (D.radialTime.vertical.smooth (k : ℕ∞))]
  simp only [smul_eq_mul, a, c, root]
  congr 1
  field_simp [hroot]

/-- Fixed-order bounds for the literal vertical cutoff, uniform under all
allowed scale translations and dilations. -/
private theorem exists_scratchWavefrontVerticalProfile_iteratedFDeriv_uniform_bound
    (D : MSSWavefrontKernelData) (k : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ (n : Int) (tau : Real),
        ‖iteratedFDeriv Real k
          (scratchWavefrontVerticalProfile D scale n hscale : Real → Complex) tau‖ ≤ C := by
  obtain ⟨C, hCpos, hC⟩ := D.radialTime.vertical.decay 0 k
  refine ⟨C, hCpos.le, ?_⟩
  intro scale hscale hscaleone n tau
  rw [scratchWavefront_iteratedFDeriv_verticalProfile_eq]
  rw [norm_smul, Real.norm_eq_abs]
  have hroot : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
  rw [abs_of_nonneg (pow_nonneg (inv_nonneg.mpr hroot.le) k)]
  calc
    (Real.sqrt scale)⁻¹ ^ k *
        ‖iteratedFDeriv Real k (D.radialTime.vertical : Real → Complex)
          ((Real.sqrt scale)⁻¹ * tau - n)‖ ≤
        1 * ‖iteratedFDeriv Real k (D.radialTime.vertical : Real → Complex)
          ((Real.sqrt scale)⁻¹ * tau - n)‖ := by
          gcongr
          exact pow_le_one₀ (inv_nonneg.mpr hroot.le)
            (inv_le_one_of_one_le₀ (Real.one_le_sqrt.mpr hscaleone))
    _ ≤ C := by simpa using hC ((Real.sqrt scale)⁻¹ * tau - n)

/-- Projection onto the temporal coordinate does not enlarge an iterated
derivative. -/
private theorem scratchWavefront_norm_iteratedFDeriv_joint_snd_le
    (h : SchwartzMap Real Complex) (k : Nat) (z : JointWaveSpaceTime) :
    ‖iteratedFDeriv Real k
        (fun w : JointWaveSpaceTime => h (WithLp.sndL 2 Real (Euclidean 2) Real w)) z‖ ≤
      ‖iteratedFDeriv Real k (h : Real → Complex) z.snd‖ := by
  let L : JointWaveSpaceTime →L[Real] Real :=
    WithLp.sndL 2 Real (Euclidean 2) Real
  have hL : ‖L‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
    intro w
    simpa [L] using WithLp.norm_snd_le (p := 2) (Euclidean 2) w
  change ‖iteratedFDeriv Real k ((h : Real → Complex) ∘ L) z‖ ≤
    ‖iteratedFDeriv Real k (h : Real → Complex) (L z)‖
  rw [L.iteratedFDeriv_comp_right (h.smooth (⊤ : ℕ∞)) z (by exact_mod_cast le_top)]
  calc
    ‖(iteratedFDeriv Real k (h : Real → Complex) (L z)).compContinuousLinearMap
        (fun _ => L)‖ ≤
      ‖iteratedFDeriv Real k (h : Real → Complex) (L z)‖ * ∏ _ : Fin k, ‖L‖ :=
        ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv Real k (h : Real → Complex) (L z)‖ * ∏ _ : Fin k, (1 : Real) := by
      gcongr
    _ = ‖iteratedFDeriv Real k (h : Real → Complex) (L z)‖ := by simp

/-- No additional vertical regularity axiom is needed: it follows from the
fixed Schwartz vertical cutoff and the prescribed dilation. -/
private theorem scratchWavefront_vertical_derivative_uniform
    (D : MSSWavefrontKernelData) :
    ∀ r : Nat, ∃ B : Real, 0 ≤ B ∧
      ∀ (scale : Real) (hscale : 0 < scale) (n : Int), 2 ≤ scale →
        ∀ z : JointWaveSpaceTime,
          ‖iteratedFDeriv Real r
            (scratchWavefrontLiftVertical
              (scratchWavefrontVerticalProfile D scale n hscale)) z‖ ≤ B := by
  intro r
  obtain ⟨B, hBnonneg, hB⟩ :=
    exists_scratchWavefrontVerticalProfile_iteratedFDeriv_uniform_bound D r
  refine ⟨B, hBnonneg, ?_⟩
  intro scale hscale n hscale_two z
  exact (scratchWavefront_norm_iteratedFDeriv_joint_snd_le
    (scratchWavefrontVerticalProfile D scale n hscale) r z).trans
    (hB scale hscale (by linarith) n z.snd)

private theorem normalCoordinate_eq_scratchScaledNormalExtension
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale)
    (xi : Euclidean 2) :
    D.normalCoordinate scale xi =
      scratchScaledNormalExtension D.radialTime scale hscale xi := by
  rw [D.normalCoordinate_apply, scratchScaledNormalExtension_apply]

private theorem jointNormalDifference_eq_scratch
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale) :
    (fun z : JointWaveSpaceTime => z.snd - D.normalCoordinate scale z.fst) =
      scratchJointNormalDifference D.radialTime scale hscale := by
  funext z
  unfold scratchJointNormalDifference
  rw [normalCoordinate_eq_scratchScaledNormalExtension D scale hscale z.fst]


private theorem norm_iteratedFDeriv_spatialProfile_comp_fst_le
    (B : SchwartzMap (Euclidean 2) Complex) (r : Nat) (z : JointWaveSpaceTime) :
    ‖iteratedFDeriv Real r (fun w : JointWaveSpaceTime => B w.fst) z‖ ≤
      ‖iteratedFDeriv Real r (B : Euclidean 2 → Complex) z.fst‖ := by
  let L : JointWaveSpaceTime →L[Real] Euclidean 2 :=
    WithLp.fstL 2 Real (Euclidean 2) Real
  have hL : ‖L‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
    intro w
    simpa [L] using WithLp.norm_fst_le (p := 2) (Euclidean 2) w
  change ‖iteratedFDeriv Real r ((B : Euclidean 2 → Complex) ∘ L) z‖ ≤ _
  rw [L.iteratedFDeriv_comp_right (B.smooth (r : ℕ∞)) z le_rfl]
  calc
    ‖(iteratedFDeriv Real r (B : Euclidean 2 → Complex) (L z)).compContinuousLinearMap
        (fun _ => L)‖ ≤
        ‖iteratedFDeriv Real r (B : Euclidean 2 → Complex) (L z)‖ *
          ∏ _ : Fin r, ‖L‖ :=
      ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv Real r (B : Euclidean 2 → Complex) (L z)‖ *
          ∏ _ : Fin r, (1 : Real) := by
      gcongr
    _ = ‖iteratedFDeriv Real r (B : Euclidean 2 → Complex) z.fst‖ := by
      simp [L]

/-- The normal-tail profile is literally a spatial profile times the
normal-tail factor along the source normal shear. -/
private theorem scratchWavefrontNormalTailProfile_apply_eq_spatial_mul_shearedTail
    (D : MSSWavefrontKernelData) (scale : Real) (hscale : 0 < scale)
    (n nu : Int) (z : JointWaveSpaceTime) :
    scratchWavefrontNormalTailProfile D scale n nu z =
      D.spatialProfile scale n nu z.fst *
        D.normalTail scale
          (scratchJointNormalDifference D.radialTime scale hscale z) := by
  have hz : WithLp.toLp 2 (z.fst, z.snd) = z := by
    apply (WithLp.ext_iff 2).2
    rfl
  rw [← hz]
  unfold scratchWavefrontNormalTailProfile
  rw [jointSchwartzModulatedAnnularProfile_apply,
    ← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  rw [← jointNormalDifference_eq_scratch D scale hscale]
  simp only [WithLp.toLp_fst, WithLp.toLp_snd]

/-- The lower-level normal-tail/shear datum used by the spatial assembly.
It has no angular or spatial profile in it: this is precisely the part
derived from the fixed temporal and normal cutoffs. -/
private def ScratchShearedNormalTailRapidEnvelope
    (D : MSSWavefrontKernelData) : Prop :=
  ∀ (r N : Nat), ∃ (L : Nat) (C : Real), 0 ≤ C ∧
    ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
      ∀ z : JointWaveSpaceTime,
        scale ^ N *
          ‖iteratedFDeriv Real r
            (fun w : JointWaveSpaceTime =>
              D.normalTail scale
                (scratchJointNormalDifference D.radialTime scale hscale w)) z‖ ≤
          C * ∑ i ∈ Finset.range (r + 1),
            ‖scratchWeightedTemporalDerivativeProfile
              (FourierTransform.fourier D.radialTime.time) i L
              (scratchJointNormalDifference D.radialTime scale hscale z)‖

private theorem scratchJointNormalDifference_contDiff
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (r : Nat) :
    ContDiff Real (r : ℕ∞) (scratchJointNormalDifference D scale hscale) := by
  unfold scratchJointNormalDifference
  exact (WithLp.sndL 2 Real (Euclidean 2) Real).contDiff.sub
    (((scratchScaledNormalExtension D scale hscale).smooth (r : ℕ∞)).comp_continuousLinearMap
      (g := WithLp.fstL 2 Real (Euclidean 2) Real))

/-- Finite Leibniz plus Fubini converts the cutoff-only sheared envelope and
the spatial polynomial profile bounds into the required rapid derivative-L¹
estimate for the full normal-tail profile. -/
private theorem MSSWavefrontSpatialProfilePolynomialRegularity.normalTailProfile_rapid
    {D : MSSWavefrontKernelData}
    (hspatial : MSSWavefrontSpatialProfilePolynomialRegularity D)
    (hshear : ScratchShearedNormalTailRapidEnvelope D) :
    ∀ r N : Nat, ∃ C : Real, 0 ≤ C ∧
      ∀ (scale : Real) (hscale : 0 < scale) (n nu : Int), 2 ≤ scale →
        n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
        scale ^ N *
          (∫ z : JointWaveSpaceTime,
            ‖iteratedFDeriv Real r
              (scratchWavefrontNormalTailProfile D scale n nu :
                JointWaveSpaceTime → Complex) z‖) ≤ C := by
  intro r N
  let P : Nat := ∑ a ∈ Finset.range (r + 1), hspatial.spatialExponent a
  let A : Nat → Real := fun a => (hspatial.derivative_l1 a).choose
  have hAnonneg (a : Nat) : 0 ≤ A a :=
    (hspatial.derivative_l1 a).choose_spec.1
  have hA (a : Nat) : ∀ (scale : Real) (n nu : Int), 2 ≤ scale →
      n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
      (∫ xi : Euclidean 2,
        ‖iteratedFDeriv Real a
          (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖) ≤
        A a * scale ^ hspatial.spatialExponent a := by
    simpa only [A] using (hspatial.derivative_l1 a).choose_spec.2
  have hP (a : Nat) (ha : a ∈ Finset.range (r + 1)) :
      hspatial.spatialExponent a ≤ P := by
    dsimp only [P]
    exact Finset.single_le_sum (s := Finset.range (r + 1))
      (f := hspatial.spatialExponent) (fun _ _ => Nat.zero_le _) ha
  let L : Nat → Nat := fun a => (hshear (r - a) (N + P)).choose
  let B : Nat → Real := fun a =>
    (hshear (r - a) (N + P)).choose_spec.choose
  have hB (a : Nat) : 0 ≤ B a ∧
      ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
        ∀ z : JointWaveSpaceTime,
          scale ^ (N + P) *
            ‖iteratedFDeriv Real (r - a)
              (fun w : JointWaveSpaceTime =>
                D.normalTail scale
                  (scratchJointNormalDifference D.radialTime scale hscale w)) z‖ ≤
            B a * ∑ i ∈ Finset.range (r - a + 1),
              ‖scratchWeightedTemporalDerivativeProfile
                (FourierTransform.fourier D.radialTime.time) i (L a)
                (scratchJointNormalDifference D.radialTime scale hscale z)‖ := by
    simpa only [L, B] using
      (hshear (r - a) (N + P)).choose_spec.choose_spec
  let C : Real := ∑ a ∈ Finset.range (r + 1),
    ∑ i ∈ Finset.range (r - a + 1),
      (r.choose a : Real) * B a * A a *
        (∫ t : Real,
          ‖scratchWeightedTemporalDerivativeProfile
            (FourierTransform.fourier D.radialTime.time) i (L a) t‖)
  have hCnonneg : 0 ≤ C := by
    dsimp only [C]
    apply Finset.sum_nonneg
    intro a ha
    apply Finset.sum_nonneg
    intro i hi
    exact mul_nonneg
      (mul_nonneg (mul_nonneg (by positivity) (hB a).1) (hAnonneg a))
      (integral_nonneg fun _ => norm_nonneg _)
  refine ⟨C, hCnonneg, ?_⟩
  intro scale hscale n nu hscale_two hn hnu
  let q : JointWaveSpaceTime → Real :=
    scratchJointNormalDifference D.radialTime scale hscale
  let F : SchwartzMap JointWaveSpaceTime Complex :=
    scratchWavefrontNormalTailProfile D scale n nu
  let U : JointWaveSpaceTime → Complex := fun z =>
    D.spatialProfile scale n nu z.fst
  let V : JointWaveSpaceTime → Complex := fun z => D.normalTail scale (q z)
  have hFfactor : (F : JointWaveSpaceTime → Complex) = fun z => U z * V z := by
    funext z
    dsimp only [F, U, V, q]
    exact scratchWavefrontNormalTailProfile_apply_eq_spatial_mul_shearedTail
      D scale hscale n nu z
  have hU : ContDiff Real (r : ℕ∞) U := by
    dsimp only [U]
    exact ((D.spatialProfile scale n nu).smooth (r : ℕ∞)).comp_continuousLinearMap
      (g := WithLp.fstL 2 Real (Euclidean 2) Real)
  have hV : ContDiff Real (r : ℕ∞) V := by
    dsimp only [V, q]
    exact ((D.normalTail scale).smooth (r : ℕ∞)).comp
      (scratchJointNormalDifference_contDiff D.radialTime scale hscale r)
  let M : JointWaveSpaceTime → Real := fun z =>
    ∑ a ∈ Finset.range (r + 1),
      ∑ i ∈ Finset.range (r - a + 1),
        (r.choose a : Real) * B a *
          ‖iteratedFDeriv Real a
            (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
          ‖scratchWeightedTemporalDerivativeProfile
            (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖
  have hMnonneg (z : JointWaveSpaceTime) : 0 ≤ M z := by
    dsimp only [M]
    apply Finset.sum_nonneg
    intro a ha
    apply Finset.sum_nonneg
    intro i hi
    exact mul_nonneg
      (mul_nonneg (mul_nonneg (by positivity) (hB a).1) (norm_nonneg _))
      (norm_nonneg _)
  have hpoint (z : JointWaveSpaceTime) :
      scale ^ (N + P) *
        ‖iteratedFDeriv Real r (F : JointWaveSpaceTime → Complex) z‖ ≤ M z := by
    have hprod := norm_iteratedFDeriv_mul_le hU hV z le_rfl
    rw [hFfactor]
    calc
      scale ^ (N + P) *
          ‖iteratedFDeriv Real r (fun w => U w * V w) z‖ ≤
          scale ^ (N + P) *
            ∑ a ∈ Finset.range (r + 1), (r.choose a : Real) *
              ‖iteratedFDeriv Real a U z‖ *
              ‖iteratedFDeriv Real (r - a) V z‖ := by
            exact mul_le_mul_of_nonneg_left hprod
              (pow_nonneg (by linarith) _)
      _ = ∑ a ∈ Finset.range (r + 1), (r.choose a : Real) *
            ‖iteratedFDeriv Real a U z‖ *
            (scale ^ (N + P) * ‖iteratedFDeriv Real (r - a) V z‖) := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro a ha
            ring
      _ ≤ ∑ a ∈ Finset.range (r + 1), (r.choose a : Real) *
            ‖iteratedFDeriv Real a U z‖ *
            (B a * ∑ i ∈ Finset.range (r - a + 1),
              ‖scratchWeightedTemporalDerivativeProfile
                (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖) := by
            apply Finset.sum_le_sum
            intro a ha
            have htail := (hB a).2 scale hscale hscale_two z
            exact mul_le_mul_of_nonneg_left htail
              (mul_nonneg (by positivity) (norm_nonneg _))
      _ ≤ ∑ a ∈ Finset.range (r + 1), (r.choose a : Real) *
            ‖iteratedFDeriv Real a
              (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
            (B a * ∑ i ∈ Finset.range (r - a + 1),
              ‖scratchWeightedTemporalDerivativeProfile
                (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖) := by
            apply Finset.sum_le_sum
            intro a ha
            have hfactor_nonneg : 0 ≤ B a *
                ∑ i ∈ Finset.range (r - a + 1),
                  ‖scratchWeightedTemporalDerivativeProfile
                    (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖ :=
              mul_nonneg (hB a).1
                (Finset.sum_nonneg fun _ _ => norm_nonneg _)
            have hinner := mul_le_mul_of_nonneg_right
              (norm_iteratedFDeriv_spatialProfile_comp_fst_le
                (D.spatialProfile scale n nu) a z) hfactor_nonneg
            calc
              (r.choose a : Real) * ‖iteratedFDeriv Real a U z‖ *
                  (B a * ∑ i ∈ Finset.range (r - a + 1),
                    ‖scratchWeightedTemporalDerivativeProfile
                      (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖) =
                  (r.choose a : Real) *
                    (‖iteratedFDeriv Real a U z‖ *
                      (B a * ∑ i ∈ Finset.range (r - a + 1),
                        ‖scratchWeightedTemporalDerivativeProfile
                          (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖)) := by
                    ring
              _ ≤ (r.choose a : Real) *
                    (‖iteratedFDeriv Real a
                      (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
                      (B a * ∑ i ∈ Finset.range (r - a + 1),
                        ‖scratchWeightedTemporalDerivativeProfile
                          (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖)) :=
                  mul_le_mul_of_nonneg_left hinner (by positivity)
              _ = (r.choose a : Real) *
                    ‖iteratedFDeriv Real a
                      (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
                    (B a * ∑ i ∈ Finset.range (r - a + 1),
                      ‖scratchWeightedTemporalDerivativeProfile
                        (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖) := by
                  ring
      _ = M z := by
            dsimp only [M]
            apply Finset.sum_congr rfl
            intro a ha
            calc
              (r.choose a : Real) *
                  ‖iteratedFDeriv Real a
                    (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
                  (B a * ∑ i ∈ Finset.range (r - a + 1),
                    ‖scratchWeightedTemporalDerivativeProfile
                      (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖) =
                  ((r.choose a : Real) *
                    ‖iteratedFDeriv Real a
                      (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ * B a) *
                    ∑ i ∈ Finset.range (r - a + 1),
                      ‖scratchWeightedTemporalDerivativeProfile
                        (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖ := by
                    ring
              _ = ∑ i ∈ Finset.range (r - a + 1),
                    ((r.choose a : Real) *
                      ‖iteratedFDeriv Real a
                        (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ * B a) *
                      ‖scratchWeightedTemporalDerivativeProfile
                        (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖ := by
                    rw [Finset.mul_sum]
              _ = ∑ i ∈ Finset.range (r - a + 1),
                    (r.choose a : Real) * B a *
                      ‖iteratedFDeriv Real a
                        (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
                      ‖scratchWeightedTemporalDerivativeProfile
                        (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖ := by
                    apply Finset.sum_congr rfl
                    intro i hi
                    ring
  have hMterm (a i : Nat) : Integrable (fun z : JointWaveSpaceTime =>
      (r.choose a : Real) * B a *
        ‖iteratedFDeriv Real a
          (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
        ‖scratchWeightedTemporalDerivativeProfile
          (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖) := by
    have hspatial_int : Integrable (fun xi : Euclidean 2 =>
        ‖iteratedFDeriv Real a
          (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖) := by
      simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume
        (D.spatialProfile scale n nu) 0 a
    have hbase := integrable_joint_sheared_norm_mul_norm
      (fun xi : Euclidean 2 =>
        ‖iteratedFDeriv Real a
          (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖)
      hspatial_int
      (scratchWeightedTemporalDerivativeProfile
        (FourierTransform.fourier D.radialTime.time) i (L a))
      (scratchScaledNormalExtension D.radialTime scale hscale)
    have hscaled := hbase.const_mul ((r.choose a : Real) * B a)
    simpa only [q, scratchJointNormalDifference, norm_norm, mul_assoc] using hscaled
  have hMint : Integrable M := by
    dsimp only [M]
    apply integrable_finsetSum
    intro a ha
    apply integrable_finsetSum
    intro i hi
    exact hMterm a i
  have hMformula :
      (∫ z : JointWaveSpaceTime, M z) =
        ∑ a ∈ Finset.range (r + 1),
          ∑ i ∈ Finset.range (r - a + 1),
            (r.choose a : Real) * B a *
              (∫ xi : Euclidean 2,
                ‖iteratedFDeriv Real a
                  (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖) *
              (∫ t : Real,
                ‖scratchWeightedTemporalDerivativeProfile
                  (FourierTransform.fourier D.radialTime.time) i (L a) t‖) := by
    calc
      (∫ z : JointWaveSpaceTime, M z) =
          ∑ a ∈ Finset.range (r + 1),
            ∫ z : JointWaveSpaceTime,
              ∑ i ∈ Finset.range (r - a + 1),
                (r.choose a : Real) * B a *
                  ‖iteratedFDeriv Real a
                    (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
                  ‖scratchWeightedTemporalDerivativeProfile
                    (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖ := by
            dsimp only [M]
            exact integral_finsetSum _ fun a ha =>
              integrable_finsetSum _ fun i hi => hMterm a i
      _ = ∑ a ∈ Finset.range (r + 1),
            ∑ i ∈ Finset.range (r - a + 1),
              ∫ z : JointWaveSpaceTime,
                (r.choose a : Real) * B a *
                  ‖iteratedFDeriv Real a
                    (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
                  ‖scratchWeightedTemporalDerivativeProfile
                    (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖ := by
            apply Finset.sum_congr rfl
            intro a ha
            exact integral_finsetSum _ fun i hi => hMterm a i
      _ = ∑ a ∈ Finset.range (r + 1),
            ∑ i ∈ Finset.range (r - a + 1),
              (r.choose a : Real) * B a *
                (∫ xi : Euclidean 2,
                  ‖iteratedFDeriv Real a
                    (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖) *
                (∫ t : Real,
                  ‖scratchWeightedTemporalDerivativeProfile
                    (FourierTransform.fourier D.radialTime.time) i (L a) t‖) := by
            apply Finset.sum_congr rfl
            intro a ha
            apply Finset.sum_congr rfl
            intro i hi
            have hspatial_int : Integrable (fun xi : Euclidean 2 =>
                ‖iteratedFDeriv Real a
                  (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖) := by
              simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume
                (D.spatialProfile scale n nu) 0 a
            calc
              (∫ z : JointWaveSpaceTime,
                  (r.choose a : Real) * B a *
                    ‖iteratedFDeriv Real a
                      (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
                    ‖scratchWeightedTemporalDerivativeProfile
                      (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖) =
                  ((r.choose a : Real) * B a) *
                    ∫ z : JointWaveSpaceTime,
                      ‖iteratedFDeriv Real a
                        (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
                      ‖scratchWeightedTemporalDerivativeProfile
                        (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖ := by
                    calc
                      (∫ z : JointWaveSpaceTime,
                          (r.choose a : Real) * B a *
                            ‖iteratedFDeriv Real a
                              (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
                            ‖scratchWeightedTemporalDerivativeProfile
                              (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖) =
                          ∫ z : JointWaveSpaceTime,
                            ((r.choose a : Real) * B a) *
                              (‖iteratedFDeriv Real a
                                (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
                                ‖scratchWeightedTemporalDerivativeProfile
                                  (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖) := by
                            apply integral_congr_ae
                            filter_upwards with z
                            ring
                      _ = ((r.choose a : Real) * B a) *
                            ∫ z : JointWaveSpaceTime,
                              ‖iteratedFDeriv Real a
                                (D.spatialProfile scale n nu : Euclidean 2 → Complex) z.fst‖ *
                              ‖scratchWeightedTemporalDerivativeProfile
                                (FourierTransform.fourier D.radialTime.time) i (L a) (q z)‖ :=
                            integral_const_mul _ _
              _ = ((r.choose a : Real) * B a) *
                    ((∫ xi : Euclidean 2,
                      ‖iteratedFDeriv Real a
                        (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖) *
                      ∫ t : Real,
                        ‖scratchWeightedTemporalDerivativeProfile
                          (FourierTransform.fourier D.radialTime.time) i (L a) t‖) := by
                    have hshearEq := integral_joint_sheared_norm_mul_norm_eq
                      (fun xi : Euclidean 2 =>
                        ‖iteratedFDeriv Real a
                          (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖)
                      hspatial_int
                      (scratchWeightedTemporalDerivativeProfile
                        (FourierTransform.fourier D.radialTime.time) i (L a))
                      (scratchScaledNormalExtension D.radialTime scale hscale)
                    exact congrArg (fun x : Real => ((r.choose a : Real) * B a) * x)
                      (by simpa only [q, scratchJointNormalDifference, norm_norm] using hshearEq)
              _ = (r.choose a : Real) * B a *
                    (∫ xi : Euclidean 2,
                      ‖iteratedFDeriv Real a
                        (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖) *
                    (∫ t : Real,
                      ‖scratchWeightedTemporalDerivativeProfile
                        (FourierTransform.fourier D.radialTime.time) i (L a) t‖) := by
                    ring
  have hscaleone : 1 ≤ scale := by linarith
  have hscalePpos : 0 < scale ^ P := pow_pos (by linarith) _
  have hspatial_bound (a : Nat) (ha : a ∈ Finset.range (r + 1)) :
      (∫ xi : Euclidean 2,
        ‖iteratedFDeriv Real a
          (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖) ≤
        A a * scale ^ P := by
    have hpower : scale ^ hspatial.spatialExponent a ≤ scale ^ P :=
      pow_le_pow_right₀ hscaleone (hP a ha)
    calc
      (∫ xi : Euclidean 2,
        ‖iteratedFDeriv Real a
          (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖) ≤
          A a * scale ^ hspatial.spatialExponent a :=
        hA a scale n nu hscale_two hn hnu
      _ ≤ A a * scale ^ P := mul_le_mul_of_nonneg_left hpower (hAnonneg a)
  have hMbound : (∫ z : JointWaveSpaceTime, M z) ≤ C * scale ^ P := by
    rw [hMformula]
    calc
      ∑ a ∈ Finset.range (r + 1),
          ∑ i ∈ Finset.range (r - a + 1),
            (r.choose a : Real) * B a *
              (∫ xi : Euclidean 2,
                ‖iteratedFDeriv Real a
                  (D.spatialProfile scale n nu : Euclidean 2 → Complex) xi‖) *
              (∫ t : Real,
                ‖scratchWeightedTemporalDerivativeProfile
                  (FourierTransform.fourier D.radialTime.time) i (L a) t‖) ≤
          ∑ a ∈ Finset.range (r + 1),
            ∑ i ∈ Finset.range (r - a + 1),
              (r.choose a : Real) * B a * (A a * scale ^ P) *
                (∫ t : Real,
                  ‖scratchWeightedTemporalDerivativeProfile
                    (FourierTransform.fourier D.radialTime.time) i (L a) t‖) := by
            apply Finset.sum_le_sum
            intro a ha
            apply Finset.sum_le_sum
            intro i hi
            exact mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_left (hspatial_bound a ha)
                (mul_nonneg (by positivity) (hB a).1))
              (integral_nonneg fun _ => norm_nonneg _)
      _ = C * scale ^ P := by
            dsimp only [C]
            rw [Finset.sum_mul]
            apply Finset.sum_congr rfl
            intro a ha
            rw [Finset.sum_mul]
            apply Finset.sum_congr rfl
            intro i hi
            ring
  have hFint : Integrable (fun z : JointWaveSpaceTime =>
      ‖iteratedFDeriv Real r (F : JointWaveSpaceTime → Complex) z‖) := by
    simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume F 0 r
  have hscaledFint : Integrable (fun z : JointWaveSpaceTime =>
      scale ^ (N + P) * ‖iteratedFDeriv Real r (F : JointWaveSpaceTime → Complex) z‖) :=
    hFint.const_mul _
  have hInt : scale ^ (N + P) *
      (∫ z : JointWaveSpaceTime,
        ‖iteratedFDeriv Real r (F : JointWaveSpaceTime → Complex) z‖) ≤
      ∫ z : JointWaveSpaceTime, M z := by
    rw [← integral_const_mul]
    exact integral_mono_of_nonneg
      (Eventually.of_forall fun z =>
        mul_nonneg (pow_nonneg (by linarith) _) (norm_nonneg _))
      hMint (Eventually.of_forall hpoint)
  have hbig : scale ^ (N + P) *
      (∫ z : JointWaveSpaceTime,
        ‖iteratedFDeriv Real r (F : JointWaveSpaceTime → Complex) z‖) ≤
      C * scale ^ P := hInt.trans hMbound
  apply (mul_le_mul_iff_of_pos_right hscalePpos).mp
  calc
    (scale ^ N *
        (∫ z : JointWaveSpaceTime,
          ‖iteratedFDeriv Real r
            (scratchWavefrontNormalTailProfile D scale n nu :
              JointWaveSpaceTime → Complex) z‖)) * scale ^ P =
        scale ^ (N + P) *
          (∫ z : JointWaveSpaceTime,
            ‖iteratedFDeriv Real r (F : JointWaveSpaceTime → Complex) z‖) := by
          dsimp only [F]
          rw [pow_add]
          ring
    _ ≤ C * scale ^ P := hbig

/-- The preceding spatial assembly has no residual analytic hypothesis: its
sheared input is supplied by the normal-gap/Leibniz theorem derived from the
literal cutoff and temporal Schwartz profile. -/
private theorem MSSWavefrontSpatialProfilePolynomialRegularity.normalTailProfile_rapid_derived
    {D : MSSWavefrontKernelData}
    (hspatial : MSSWavefrontSpatialProfilePolynomialRegularity D) :
    ∀ r N : Nat, ∃ C : Real, 0 ≤ C ∧
      ∀ (scale : Real) (hscale : 0 < scale) (n nu : Int), 2 ≤ scale →
        n ∈ relevantRadialIndexEnumeration scale → nu ∈ D.angularIndices scale →
        scale ^ N *
          (∫ z : JointWaveSpaceTime,
            ‖iteratedFDeriv Real r
              (scratchWavefrontNormalTailProfile D scale n nu :
                JointWaveSpaceTime → Complex) z‖) ≤ C := by
  apply hspatial.normalTailProfile_rapid
  intro r N
  simpa only [ScratchShearedNormalTailRapidEnvelope] using
    exists_scratchWavefront_shearedNormalTail_derivative_weightedEnvelope D r N

/-- Consequently the old cutoff-profile regularity package is itself a
derived consequence of the lower-level spatial polynomial condition: neither
of its two analytic fields is left as an axiom. -/
private theorem MSSWavefrontSpatialProfilePolynomialRegularity.to_cutoffProfileRegularity
    {D : MSSWavefrontKernelData}
    (hspatial : MSSWavefrontSpatialProfilePolynomialRegularity D) :
    ScratchWavefrontCutoffProfileRegularity D where
  vertical_derivative_uniform := scratchWavefront_vertical_derivative_uniform D
  normal_tail_profile_rapid := by
    intro r N
    obtain ⟨C, hCnonneg, hC⟩ := hspatial.normalTailProfile_rapid_derived r N
    refine ⟨C, hCnonneg, ?_⟩
    intro scale hscale n nu hscale_two hn hnu
    exact hC scale hscale n nu hscale_two hn hnu

private theorem scratch_eLpNorm_four_angularRadialSquareFunction_le_sum_of_bounds
    (radialIndices angularIndices : Finset Int)
    (tail : Int → Int → WaveSpaceTime → Complex)
    (htailMeas : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      AEStronglyMeasurable (tail n nu) volume)
    (E : Int → Int → ENNReal)
    (hE : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      eLpNorm (tail n nu) 4 volume ≤ E n nu) :
    eLpNorm (angularRadialSquareFunction radialIndices angularIndices tail) 4 volume ≤
      ∑ n ∈ radialIndices, ∑ nu ∈ angularIndices, E n nu := by
  have hraw := eLpNorm_four_angularRadialSquareFunction_sub_le_sum_of_eq_add_of_tail_bounds
    radialIndices angularIndices tail (fun _ _ _ => 0) tail
    (by
      intro n hn nu hnu z
      simp)
    htailMeas E hE
  have hzero : angularRadialSquareFunction radialIndices angularIndices
      (fun _ _ _ => 0) = 0 := by
    funext z
    simp [angularRadialSquareFunction]
  rw [hzero, sub_zero] at hraw
  exact hraw

/-- If every packet has the same `L⁴` majorant, the finite aggregation costs
exactly the number of radial--angular pairs. -/
private theorem scratch_eLpNorm_four_angularRadialSquareFunction_le_card_mul
    (radialIndices angularIndices : Finset Int)
    (tail : Int → Int → WaveSpaceTime → Complex)
    (htailMeas : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      AEStronglyMeasurable (tail n nu) volume)
    (E : ENNReal)
    (hE : ∀ n ∈ radialIndices, ∀ nu ∈ angularIndices,
      eLpNorm (tail n nu) 4 volume ≤ E) :
    eLpNorm (angularRadialSquareFunction radialIndices angularIndices tail) 4 volume ≤
      ((radialIndices.card * angularIndices.card : Nat) : ENNReal) * E := by
  calc
    eLpNorm (angularRadialSquareFunction radialIndices angularIndices tail) 4 volume ≤
        ∑ n ∈ radialIndices, ∑ nu ∈ angularIndices, E :=
      scratch_eLpNorm_four_angularRadialSquareFunction_le_sum_of_bounds
        radialIndices angularIndices tail htailMeas (fun _ _ => E) hE
    _ = ((radialIndices.card * angularIndices.card : Nat) : ENNReal) * E := by
      simp [Nat.cast_mul, mul_assoc]

/-- The canonical radial enumeration and the scale-indexed angular family
contain at most `11 * Cₐ * scale` packet pairs.  The angular constant is the
one bundled in the cutoff data. -/
private theorem scratch_canonicalRadialAngular_pair_card_le
    (D : MSSWavefrontCutoffData) {scale : Real} (hscale : 2 ≤ scale) :
    (((relevantRadialIndexEnumeration scale).card *
        (D.angularIndices scale).card : Nat) : ENNReal) ≤
      ENNReal.ofReal (11 * D.angular_card.choose * scale) := by
  let Ca : Real := D.angular_card.choose
  have hCa_pos : 0 < Ca := D.angular_card.choose_spec.1
  have hCa : ((D.angularIndices scale).card : Real) ≤ Ca * Real.sqrt scale :=
    D.angular_card.choose_spec.2 scale hscale
  have hrad : ((relevantRadialIndexEnumeration scale).card : Real) ≤
      11 * Real.sqrt scale :=
    card_relevantRadialIndexEnumeration_le_eleven_mul_sqrt hscale
  have hroot_nonneg : 0 ≤ Real.sqrt scale := Real.sqrt_nonneg _
  have hright_nonneg : 0 ≤ 11 * Real.sqrt scale := by positivity
  have hang_nonneg : 0 ≤ ((D.angularIndices scale).card : Real) := by positivity
  have hpairs_real :
      (((relevantRadialIndexEnumeration scale).card *
          (D.angularIndices scale).card : Nat) : Real) ≤
        11 * Ca * scale := by
    rw [Nat.cast_mul]
    calc
      ((relevantRadialIndexEnumeration scale).card : Real) *
          ((D.angularIndices scale).card : Real) ≤
          (11 * Real.sqrt scale) * (Ca * Real.sqrt scale) :=
        mul_le_mul hrad hCa hang_nonneg hright_nonneg
      _ = 11 * Ca * (Real.sqrt scale) ^ 2 := by ring
      _ = 11 * Ca * scale := by
        rw [Real.sq_sqrt (by linarith : 0 ≤ scale)]
  rw [← ENNReal.ofReal_natCast]
  exact ENNReal.ofReal_le_ofReal (by simpa only [Ca] using hpairs_real)

/-- Combining the exact finite Minkowski bound with the two cardinality
estimates loses only one power of `scale`. -/
private theorem scratch_eLpNorm_four_canonicalAngularRadialSquareFunction_le_scale_mul
    (D : MSSWavefrontCutoffData) {scale : Real} (hscale : 2 ≤ scale)
    (tail : Int → Int → WaveSpaceTime → Complex)
    (htailMeas : ∀ n ∈ relevantRadialIndexEnumeration scale,
      ∀ nu ∈ D.angularIndices scale, AEStronglyMeasurable (tail n nu) volume)
    (E : ENNReal)
    (hE : ∀ n ∈ relevantRadialIndexEnumeration scale,
      ∀ nu ∈ D.angularIndices scale,
        eLpNorm (tail n nu) 4 volume ≤ E) :
    eLpNorm (angularRadialSquareFunction (relevantRadialIndexEnumeration scale)
        (D.angularIndices scale) tail) 4 volume ≤
      ENNReal.ofReal (11 * D.angular_card.choose * scale) * E := by
  calc
    eLpNorm (angularRadialSquareFunction (relevantRadialIndexEnumeration scale)
        (D.angularIndices scale) tail) 4 volume ≤
        (((relevantRadialIndexEnumeration scale).card *
          (D.angularIndices scale).card : Nat) : ENNReal) * E :=
      scratch_eLpNorm_four_angularRadialSquareFunction_le_card_mul
        (relevantRadialIndexEnumeration scale) (D.angularIndices scale)
        tail htailMeas E hE
    _ ≤ ENNReal.ofReal (11 * D.angular_card.choose * scale) * E :=
      mul_le_mul_of_nonneg_right
        (scratch_canonicalRadialAngular_pair_card_le D hscale) bot_le

/-- A one-power loss from the finite packet family is absorbed by asking for
one additional power of rapid decay in each packet.  This is the exact
numerical closure used after the one-packet kernel bound. -/
private theorem scratch_eLpNorm_four_canonicalAngularRadialSquareFunction_rapid
    (D : MSSWavefrontCutoffData) {scale : Real} (hscale : 2 ≤ scale)
    (N : Nat) (C : Real)
    (tail : Int → Int → WaveSpaceTime → Complex)
    (htailMeas : ∀ n ∈ relevantRadialIndexEnumeration scale,
      ∀ nu ∈ D.angularIndices scale, AEStronglyMeasurable (tail n nu) volume)
    (F : ENNReal)
    (hpacket : ∀ n ∈ relevantRadialIndexEnumeration scale,
      ∀ nu ∈ D.angularIndices scale,
        eLpNorm (tail n nu) 4 volume ≤
          ENNReal.ofReal (C * (scale⁻¹) ^ (N + 1)) * F) :
    eLpNorm (angularRadialSquareFunction (relevantRadialIndexEnumeration scale)
        (D.angularIndices scale) tail) 4 volume ≤
      ENNReal.ofReal (11 * D.angular_card.choose * C * (scale⁻¹) ^ N) * F := by
  let E : ENNReal := ENNReal.ofReal (C * (scale⁻¹) ^ (N + 1)) * F
  have hsum := scratch_eLpNorm_four_canonicalAngularRadialSquareFunction_le_scale_mul
    D hscale tail htailMeas E (by
      intro n hn nu hnu
      exact hpacket n hn nu hnu)
  calc
    eLpNorm (angularRadialSquareFunction (relevantRadialIndexEnumeration scale)
        (D.angularIndices scale) tail) 4 volume ≤
        ENNReal.ofReal (11 * D.angular_card.choose * scale) * E := hsum
    _ = ENNReal.ofReal (11 * D.angular_card.choose * C * (scale⁻¹) ^ N) * F := by
      dsimp only [E]
      rw [← mul_assoc]
      rw [← ENNReal.ofReal_mul]
      · congr 2
        have hscale_pos : 0 < scale := by linarith
        have hcancel : scale * scale⁻¹ = 1 :=
          mul_inv_cancel₀ (ne_of_gt hscale_pos)
        rw [show (scale⁻¹) ^ (N + 1) = (scale⁻¹) ^ N * scale⁻¹ by
          rw [pow_succ]]
        calc
          (11 * D.angular_card.choose * scale) *
              (C * ((scale⁻¹) ^ N * scale⁻¹)) =
              (11 * D.angular_card.choose * C * (scale⁻¹) ^ N) *
                (scale * scale⁻¹) := by ring
          _ = 11 * D.angular_card.choose * C * (scale⁻¹) ^ N := by
            rw [hcancel, mul_one]
      · have hCa_pos : 0 < D.angular_card.choose := D.angular_card.choose_spec.1
        positivity

/-- The one-packet rapid kernel estimate aggregates over the canonical
radial and angular families with a single lost power of `scale`.  The
measurability premise is intentionally explicit: it is a property of the
literal physical packet realization, not an additional operator bound. -/
private theorem scratchWavefrontRapidMultiplierBounds.exists_squareFunction_L4_rapid_bound
    {D : MSSWavefrontKernelData}
    (hrapid : scratchWavefrontRapidMultiplierBounds D) (N : Nat)
    (hmeas : ∀ (scale : Real) (hscale : 0 < scale) (n nu : Int),
      2 ≤ scale → n ∈ relevantRadialIndexEnumeration scale →
        nu ∈ D.angularIndices scale →
          ∀ f : SchwartzMap (Euclidean 2) Complex,
            AEStronglyMeasurable
              (scratchWavefrontPacketResidual D scale hscale n nu f) volume) :
    ∃ C : Real, 0 < C ∧
      ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
        ∀ f : SchwartzMap (Euclidean 2) Complex,
          eLpNorm
              (angularRadialSquareFunction (relevantRadialIndexEnumeration scale)
                (D.angularIndices scale)
                (fun n nu => scratchWavefrontPacketResidual D scale hscale n nu f))
              4 volume ≤
            ENNReal.ofReal (C * (scale⁻¹) ^ N) *
              eLpNorm (f : Euclidean 2 → Complex) 4 volume := by
  rcases hrapid.exists_packet_L4_rapid_bound (N + 1) with ⟨C, hCpos, hpacket⟩
  refine ⟨11 * D.angular_card.choose * C, ?_, ?_⟩
  · have hCa_pos : 0 < D.angular_card.choose := D.angular_card.choose_spec.1
    positivity
  · intro scale hscale hscale_two f
    exact scratch_eLpNorm_four_canonicalAngularRadialSquareFunction_rapid
      D.toMSSWavefrontCutoffData hscale_two N C
      (fun n nu => scratchWavefrontPacketResidual D scale hscale n nu f)
      (fun n hn nu hnu => hmeas scale hscale n nu hscale_two hn hnu f)
      (eLpNorm (f : Euclidean 2 → Complex) 4 volume)
       (fun n hn nu hnu => hpacket scale hscale n nu hscale_two hn hnu f)

/-- Private bridge from the derived packet estimate to the literal raw
square-function error in the wave-front-localization statement. -/
private theorem wavefrontLocalizationError_of_MSSWavefrontKernelData
    (D : MSSWavefrontKernelData) (R : MSSWavefrontRawProfileRealization D)
    (hspatial : MSSWavefrontSpatialProfilePolynomialRegularity D)
    (_hgamma : 0 < D.gamma) (_hgammaSmall : D.gamma < 1 / 10) :
    wavefrontLocalizationError D.toMSSWavefrontCutoffData D.gamma := by
  intro _ _ N _hN
  let hrapid : scratchWavefrontRapidMultiplierBounds D :=
    hspatial.to_cutoffProfileRegularity.to_rapidMultiplierBounds
  obtain ⟨C, hCpos, hbound⟩ :=
    hrapid.exists_squareFunction_L4_rapid_bound N (by
      intro scale hscale n nu hscale_two hn hnu f
      rw [← mssAngularRadialWave_sub_mssWavefrontAngularRadialWave_eq_packetResidual
        D R scale hscale n nu hnu f]
      exact mssAngularRadialWave_sub_mssWavefrontAngularRadialWave_aestronglyMeasurable
        D R scale hscale n nu hnu f)
  refine ⟨C, hCpos, ?_⟩
  intro scale hscale_two f
  have hscale : 0 < scale := by linarith
  have hsq :
      angularRadialSquareFunction (relevantRadialIndexEnumeration scale)
        (D.angularIndices scale)
        (fun n nu => fun z =>
          mssAngularRadialWave D.toMSSWavefrontCutoffData scale n nu
              (f : Euclidean 2 → Complex) z -
            mssWavefrontAngularRadialWave D.toMSSWavefrontCutoffData scale D.gamma n nu
              (f : Euclidean 2 → Complex) z) =
      angularRadialSquareFunction (relevantRadialIndexEnumeration scale)
        (D.angularIndices scale)
        (fun n nu => scratchWavefrontPacketResidual D scale hscale n nu f) := by
    funext z
    unfold angularRadialSquareFunction
    apply congrArg Real.sqrt
    apply Finset.sum_congr rfl
    intro n hn
    apply Finset.sum_congr rfl
    intro nu hnu
    change ‖mssAngularRadialWave D.toMSSWavefrontCutoffData scale n nu
        (f : Euclidean 2 → Complex) z -
        mssWavefrontAngularRadialWave D.toMSSWavefrontCutoffData scale D.gamma n nu
          (f : Euclidean 2 → Complex) z‖ ^ 2 =
      ‖scratchWavefrontPacketResidual D scale hscale n nu f z‖ ^ 2
    have heq :=
      mssAngularRadialWave_sub_mssWavefrontAngularRadialWave_eq_packetResidual
        D R scale hscale n nu hnu f
    have heqz :
        mssAngularRadialWave D.toMSSWavefrontCutoffData scale n nu
            (f : Euclidean 2 → Complex) z -
          mssWavefrontAngularRadialWave D.toMSSWavefrontCutoffData scale D.gamma n nu
            (f : Euclidean 2 → Complex) z =
          scratchWavefrontPacketResidual D scale hscale n nu f z := by
      simpa only [Pi.sub_apply] using congrFun heq z
    rw [heqz]
  rw [hsq]
  exact hbound scale hscale hscale_two f

/-- Private literal Fourier-support bridge for active wave-front packets. -/
private theorem wavefrontPlateSupport_of_MSSWavefrontKernelData
    (D : MSSWavefrontKernelData) (R : MSSWavefrontRawProfileRealization D) :
    wavefrontPlateSupport D.toMSSWavefrontCutoffData D.gamma := by
  intro scale hscale_two n nu _hn hnu f
  have hscale : 0 < scale := by linarith
  let P := scratchWavefrontRawProfiles D R scale hscale n nu f
  change Function.support
      (spaceTimeFourier
        (wavefrontAngularRadialWave (D.radialTime.vertical : Real → Complex)
          (D.radialTime.radial : Real → Complex) (D.chi scale) (D.tildeChi scale)
          (D.normal : Real → Complex) scale D.gamma
          (D.radialTime.amplitude : Euclidean 2 → Complex)
          (D.radialTime.time : Real → Complex) n nu (f : Euclidean 2 → Complex))) ⊆ _
  exact support_wavefrontAngularRadialWave_subset_conicPlate_of_profiles
    D.radialTime D.normal scale D.gamma D.angularConstant (D.directions scale nu) n
    (D.chi scale) (D.tildeChi scale) nu f hscale_two P
    (D.tildeChi_support scale nu hnu) D.normal_support

/-- The active blueprint wave-front-localization lemma.  Its error clause is
derived from scale-indexed cutoff/profile regularity, and its support clause
is the literal conic-plate Fourier support of every active packet. -/
theorem wavefrontLocalization_of_MSSWavefrontKernelData
    (D : MSSWavefrontKernelData) (R : MSSWavefrontRawProfileRealization D)
    (hspatial : MSSWavefrontSpatialProfilePolynomialRegularity D) :
    wavefrontLocalization D.toMSSWavefrontCutoffData D.gamma := by
  refine ⟨?_, ?_⟩
  · exact wavefrontLocalizationError_of_MSSWavefrontKernelData D R hspatial
      D.gamma_pos D.gamma_lt_tenth
  · exact wavefrontPlateSupport_of_MSSWavefrontKernelData D R

/-- The `k`th dyadic angular-separation relation on ordered angular indices. -/
def angularSeparationClass (k : Nat) (ν ν' : Int) : Prop :=
  if k = 0 then (ν - ν').natAbs ≤ 1 else
    2 ^ (k - 1) < (ν - ν').natAbs ∧ (ν - ν').natAbs ≤ 2 ^ k

/-- The finite set of angular pairs at one dyadic separation. -/
noncomputable def angularSeparationPairs (indices : Finset Int) (k : Nat) : Finset (Int × Int) := by
  classical
  exact (indices.product indices).filter
    (fun pair => angularSeparationClass k pair.1 pair.2)

/-- Membership in an angular-separation class is the literal conjunction of
membership in the angular index set and the dyadic separation condition. -/
theorem mem_angularSeparationPairs_iff (indices : Finset Int) (k : Nat)
    (pair : Int × Int) :
    pair ∈ angularSeparationPairs indices k ↔
      pair.1 ∈ indices ∧ pair.2 ∈ indices ∧
        angularSeparationClass k pair.1 pair.2 := by
  classical
  simp [angularSeparationPairs, and_assoc]

/-- At level zero, angular separation means that the two labels are adjacent. -/
theorem angularSeparationClass_zero_iff (m m' : Int) :
    angularSeparationClass 0 m m' ↔ (m - m').natAbs ≤ 1 := by
  simp [angularSeparationClass]

/-- At a positive level, angular separation lies in the corresponding dyadic
annulus of index differences. -/
theorem angularSeparationClass_succ_iff (k : Nat) (m m' : Int) :
    angularSeparationClass (k + 1) m m' ↔
      2 ^ k < (m - m').natAbs ∧ (m - m').natAbs ≤ 2 ^ (k + 1) := by
  simp [angularSeparationClass]

/-- Angular separation is symmetric in the two ordered labels. -/
theorem angularSeparationClass_comm (k : Nat) (m m' : Int) :
    angularSeparationClass k m m' ↔ angularSeparationClass k m' m := by
  have hdiff : (m' - m).natAbs = (m - m').natAbs := by
    rw [show m' - m = -(m - m') by ring, Int.natAbs_neg]
  simp only [angularSeparationClass]
  rw [hdiff]

/-- The finite family of ordered pairs at a fixed angular separation is
closed under swapping the two labels. -/
theorem mem_swap_angularSeparationPairs_iff (indices : Finset Int) (k : Nat)
    (m m' : Int) :
    (m', m) ∈ angularSeparationPairs indices k ↔
      (m, m') ∈ angularSeparationPairs indices k := by
  rw [mem_angularSeparationPairs_iff, mem_angularSeparationPairs_iff]
  constructor
  · rintro ⟨hm', hm, hsep⟩
    exact ⟨hm, hm', (angularSeparationClass_comm k m m').mpr hsep⟩
  · rintro ⟨hm, hm', hsep⟩
    exact ⟨hm', hm, (angularSeparationClass_comm k m m').mp hsep⟩

/-- Separation pairs are, in particular, pairs of elements of the original
finite angular index family. -/
theorem angularSeparationPairs_subset_product (indices : Finset Int) (k : Nat) :
    angularSeparationPairs indices k ⊆ indices.product indices := by
  classical
  rw [angularSeparationPairs]
  exact Finset.filter_subset _ _

/-- There are at most quadratically many ordered angular pairs at any one
separation level. -/
theorem card_angularSeparationPairs_le (indices : Finset Int) (k : Nat) :
    (angularSeparationPairs indices k).card ≤ indices.card ^ 2 := by
  classical
  calc
    (angularSeparationPairs indices k).card ≤ (indices.product indices).card :=
      Finset.card_le_card (angularSeparationPairs_subset_product indices k)
    _ = indices.card ^ 2 := by simp [pow_two]

/-- Finite Cauchy--Schwarz for the family of ordered angular pairs in one
separation class.  This is the purely algebraic input preceding the
geometric plate-overlap estimate. -/
theorem sq_sum_norm_angularSeparationPairs_le_card_mul_sum_sq
    (indices : Finset Int) (k : Nat)
    (F : Int × Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    (∑ pair ∈ angularSeparationPairs indices k, ‖F pair z‖) ^ 2 ≤
      ((angularSeparationPairs indices k).card : Real) *
        ∑ pair ∈ angularSeparationPairs indices k, ‖F pair z‖ ^ 2 :=
  sq_sum_le_card_mul_sum_sq

/-- The same finite Cauchy--Schwarz estimate with the elementary quadratic
bound on the number of angular pairs substituted in.  It has no geometric
plate-overlap hypothesis. -/
theorem sq_sum_norm_angularSeparationPairs_le_card_sq_mul_sum_sq
    (indices : Finset Int) (k : Nat)
    (F : Int × Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    (∑ pair ∈ angularSeparationPairs indices k, ‖F pair z‖) ^ 2 ≤
      (indices.card : Real) ^ 2 *
        ∑ pair ∈ angularSeparationPairs indices k, ‖F pair z‖ ^ 2 := by
  have hcard : ((angularSeparationPairs indices k).card : Real) ≤
      (indices.card : Real) ^ 2 := by
    exact_mod_cast card_angularSeparationPairs_le indices k
  have henergy : 0 ≤ ∑ pair ∈ angularSeparationPairs indices k, ‖F pair z‖ ^ 2 :=
    Finset.sum_nonneg fun pair hpair => sq_nonneg (‖F pair z‖)
  calc
    (∑ pair ∈ angularSeparationPairs indices k, ‖F pair z‖) ^ 2 ≤
        ((angularSeparationPairs indices k).card : Real) *
          ∑ pair ∈ angularSeparationPairs indices k, ‖F pair z‖ ^ 2 :=
      sq_sum_norm_angularSeparationPairs_le_card_mul_sum_sq indices k F z
    _ ≤ (indices.card : Real) ^ 2 *
        ∑ pair ∈ angularSeparationPairs indices k, ‖F pair z‖ ^ 2 :=
      mul_le_mul_of_nonneg_right hcard henergy

/-- Minkowski sum of two subsets of space--time frequency space. -/
def minkowskiSum (A B : Set WaveSpaceTime) : Set WaveSpaceTime :=
  {Z | ∃ z ∈ A, ∃ w ∈ B, z + w = Z}

/-- Membership in a Minkowski sum is its defining two-point decomposition. -/
theorem mem_minkowskiSum_iff (A B : Set WaveSpaceTime) (Z : WaveSpaceTime) :
    Z ∈ minkowskiSum A B ↔ ∃ z ∈ A, ∃ w ∈ B, z + w = Z := Iff.rfl

/-- Minkowski addition of frequency sets is commutative. -/
theorem minkowskiSum_comm (A B : Set WaveSpaceTime) :
    minkowskiSum A B = minkowskiSum B A := by
  ext Z
  constructor
  · rintro ⟨z, hz, w, hw, hzw⟩
    exact ⟨w, hw, z, hz, by simpa [add_comm] using hzw⟩
  · rintro ⟨w, hw, z, hz, hwz⟩
    exact ⟨z, hz, w, hw, by simpa [add_comm] using hwz⟩

/-- A finite set has cardinality at most two if, after choosing any two
distinct elements, every remaining element is one of those two.  This small
finite-combinatorial reduction lets the planar two-circle intersection fact
be applied directly to a finite overlap fiber. -/
theorem finset_card_le_two_of_forall_mem_eq_or_eq {α : Type*} [DecidableEq α]
    (s : Finset α)
    (h : ∀ a ∈ s, ∀ b ∈ s, a ≠ b → ∀ c ∈ s, c = a ∨ c = b) :
    s.card ≤ 2 := by
  classical
  by_cases hnonempty : s.Nonempty
  · obtain ⟨a, ha⟩ := hnonempty
    by_cases hsingle : ∀ b ∈ s, b = a
    · have hsubset : s ⊆ ({a} : Finset α) := by
        intro b hb
        simp [hsingle b hb]
      exact (Finset.card_le_card hsubset).trans (by simp)
    · obtain ⟨b, hb, hba⟩ : ∃ b, b ∈ s ∧ b ≠ a := by
        push Not at hsingle
        exact hsingle
      have hsubset : s ⊆ ({a, b} : Finset α) := by
        intro c hc
        rcases h a ha b hb (Ne.symm hba) c hc with hca | hcb
        · simp [hca]
        · simp [hcb]
      exact (Finset.card_le_card hsubset).trans Finset.card_le_two
  · have hs : s = ∅ := Finset.not_nonempty_iff_eq_empty.mp hnonempty
    simp [hs]

/-- The zero-normal-thickness, fixed-radius point at the center of a conic
plate.  This is the exact model in which the essential pair-sum injection can
be stated before controlling thick plates. -/
def zeroThicknessConicPoint (radius : Real) (direction : Euclidean 2) :
    WaveSpaceTime :=
  (radius • direction, radius)

/-- The zero-thickness, fixed-radius model conic plate. -/
def zeroThicknessConicPlate (radius : Real) (direction : Euclidean 2) :
    Set WaveSpaceTime :=
  {zeroThicknessConicPoint radius direction}

/-- The center of the Minkowski sum of two zero-thickness model plates. -/
def zeroThicknessPlatePairSum (radius radius' : Real)
    (directions : Int → Euclidean 2) (pair : Int × Int) : WaveSpaceTime :=
  zeroThicknessConicPoint radius (directions pair.1) +
    zeroThicknessConicPoint radius' (directions pair.2)

/-- Scaling a unit direction by a nonnegative radius has exactly that norm. -/
theorem norm_smul_unit_direction_of_nonneg {radius : Real}
    (hradius : 0 ≤ radius) {direction : Euclidean 2} (hdirection : ‖direction‖ = 1) :
    ‖radius • direction‖ = radius := by
  rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hradius, hdirection, mul_one]

/-- The spatial first summand in a zero-thickness pair sum lies on the
circle of its prescribed first radius. -/
theorem dist_zero_zeroThicknessPlatePairSum_first
    {radius : Real} {directions : Int → Euclidean 2} {pair : Int × Int}
    (hradius : 0 ≤ radius) (hdirection : ‖directions pair.1‖ = 1) :
    dist (radius • directions pair.1) 0 = radius := by
  rw [dist_zero_right]
  exact norm_smul_unit_direction_of_nonneg hradius hdirection

/-- The spatial first summand in a zero-thickness pair sum lies on the
circle centred at the total spatial frequency with the prescribed second
radius. -/
theorem dist_zeroThicknessPlatePairSum_first_spatial
    {radius radius' : Real} {directions : Int → Euclidean 2} {pair : Int × Int}
    (hradius' : 0 ≤ radius') (hdirection : ‖directions pair.2‖ = 1) :
    dist (radius • directions pair.1)
      (zeroThicknessPlatePairSum radius radius' directions pair).1 = radius' := by
  change dist (radius • directions pair.1)
    (radius • directions pair.1 + radius' • directions pair.2) = radius'
  calc
    dist (radius • directions pair.1)
        (radius • directions pair.1 + radius' • directions pair.2) =
        ‖-(radius' • directions pair.2)‖ := by
      rw [dist_eq_norm_sub]
      congr 1
      module
    _ = ‖radius' • directions pair.2‖ := norm_neg _
    _ = radius' := norm_smul_unit_direction_of_nonneg hradius' hdirection

/-- Positive-radius unit directions from one sector of radius at most `1/4`
cannot have zero weighted sum.  This removes the coincident-circle
degeneracy when the planar two-circle intersection theorem is applied to a
zero-thickness overlap fiber. -/
theorem zeroThicknessPlatePairSum_spatial_ne_zero_of_angularSectorGeometry
    {scale sectorRadius spacingLower spacingUpper radius radius' : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2}
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hradius : 0 < radius) (hradius' : 0 < radius')
    {i j : Int} (hi : i ∈ indices) (hj : j ∈ indices) :
    (zeroThicknessPlatePairSum radius radius' directions (i, j)).1 ≠ 0 := by
  rcases hgeometry with ⟨hsectorPos, hsectorBound, hspacingLower, hspacingUpper,
    center, hcenter, hdata⟩
  intro hzero
  change radius • directions i + radius' • directions j = 0 at hzero
  have hiunit : ‖directions i‖ = 1 := (hdata i hi).1
  have hjunit : ‖directions j‖ = 1 := (hdata j hj).1
  have hsum : radius • directions i = -(radius' • directions j) :=
    eq_neg_of_add_eq_zero_left hzero
  have hradii : radius = radius' := by
    calc
      radius = ‖radius • directions i‖ :=
        (norm_smul_unit_direction_of_nonneg hradius.le hiunit).symm
      _ = ‖-(radius' • directions j)‖ := congrArg norm hsum
      _ = ‖radius' • directions j‖ := norm_neg _
      _ = radius' := norm_smul_unit_direction_of_nonneg hradius'.le hjunit
  have hsumSameRadius : radius • directions i = -(radius • directions j) := by
    simpa [hradii] using hsum
  have hdirectionsOpposite : directions i = -directions j := by
    apply smul_right_injective _ hradius.ne'
    calc
      radius • directions i = -(radius • directions j) := hsumSameRadius
      _ = radius • (-directions j) := by rw [smul_neg]
  have hdirectionsReverse : directions j = -directions i := by
    rw [hdirectionsOpposite]
    simp
  have hfar : ‖directions i - directions j‖ = 2 := by
    calc
      ‖directions i - directions j‖ = ‖(2 : Real) • directions i‖ := by
        rw [hdirectionsReverse]
        congr 1
        module
      _ = 2 := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (by norm_num), hiunit, mul_one]
  have hnearI : ‖directions i - center‖ ≤ sectorRadius := (hdata i hi).2.1
  have hnearJ : ‖directions j - center‖ ≤ sectorRadius := (hdata j hj).2.1
  have hclose : ‖directions i - directions j‖ ≤ 1 / 2 := by
    calc
      ‖directions i - directions j‖ =
          ‖(directions i - center) - (directions j - center)‖ := by
        congr 1
        module
      _ ≤ ‖directions i - center‖ + ‖directions j - center‖ := norm_sub_le _ _
      _ ≤ sectorRadius + sectorRadius := add_le_add hnearI hnearJ
      _ ≤ 1 / 2 := by linarith
  rw [hfar] at hclose
  norm_num at hclose

/-- For fixed first angular label, equality of two zero-thickness pair sums
forces equality of the corresponding second directions whenever the second
radius is nonzero. -/
theorem zeroThicknessPlatePairSum_eq_right_of_fst_eq
    {radius radius' : Real} {directions : Int → Euclidean 2}
    {i j j' : Int} (hradius' : radius' ≠ 0)
    (hsum : zeroThicknessPlatePairSum radius radius' directions (i, j) =
      zeroThicknessPlatePairSum radius radius' directions (i, j')) :
    directions j = directions j' := by
  have hspace := congrArg Prod.fst hsum
  change radius • directions i + radius' • directions j =
      radius • directions i + radius' • directions j' at hspace
  exact smul_right_injective _ hradius' (add_left_cancel hspace)

/-- Combining a nonzero second radius with the separation in
`angularSectorGeometry` makes the zero-thickness pair-sum map injective in
its second angular label after the first label has been fixed. -/
theorem zeroThicknessPlatePairSum_right_injective_of_angularSectorGeometry
    {scale sectorRadius spacingLower spacingUpper radius radius' : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2}
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    {i j j' : Int} (hj : j ∈ indices) (hj' : j' ∈ indices)
    (hradius' : radius' ≠ 0)
    (hsum : zeroThicknessPlatePairSum radius radius' directions (i, j) =
      zeroThicknessPlatePairSum radius radius' directions (i, j')) :
    j = j' :=
  angularSectorGeometry_direction_injective hscale hgeometry hj hj'
    (zeroThicknessPlatePairSum_eq_right_of_fst_eq hradius' hsum)

/-- A zero-thickness center point lies in the corresponding full conic plate
whenever its radius and radial label satisfy the plate inequalities.  Thus the
model pair-sum geometry is a genuine core of the current `conicPlate`
definition, rather than an unrelated abstraction. -/
theorem zeroThicknessConicPoint_mem_conicPlate
    {scale radius gamma angularConstant : Real} {n : Int}
    {direction : Euclidean 2}
    (hscale : 0 < scale) (hradius : 0 < radius)
    (hangular : 0 ≤ angularConstant) (hdirection : ‖direction‖ = 1)
    (hrange : scale / 4 ≤ radius ∧ radius ≤ 4 * scale)
    (hradial : |(Real.sqrt scale)⁻¹ * radius - n| ≤ 1) :
    zeroThicknessConicPoint radius direction ∈
      conicPlate scale gamma angularConstant n direction := by
  have hdirection_ne : direction ≠ 0 := by
    intro hzero
    simp [hzero] at hdirection
  have hpoint_ne : radius • direction ≠ 0 :=
    smul_ne_zero (ne_of_gt hradius) hdirection_ne
  have hnorm : ‖radius • direction‖ = radius := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hradius, hdirection, mul_one]
  have hnormalized : (‖radius • direction‖)⁻¹ • (radius • direction) = direction := by
    rw [hnorm, smul_smul, inv_mul_cancel₀ (ne_of_gt hradius), one_smul]
  have haperture : 0 ≤ angularConstant * scale ^ (-(1 / 2 : Real)) := by
    positivity
  have hthickness : 0 ≤ 2 * scale ^ gamma := by
    positivity
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · simpa [zeroThicknessConicPoint, hnorm] using hrange.1
  · simpa [zeroThicknessConicPoint, hnorm] using hrange.2
  · refine ⟨hpoint_ne, ?_⟩
    change ‖(‖radius • direction‖)⁻¹ • (radius • direction) - direction‖ ≤ _
    rw [hnormalized]
    simpa using haperture
  · simpa [zeroThicknessConicPoint] using hradial
  · simp only [zeroThicknessConicPoint, hnorm, sub_self, abs_zero]
    exact hthickness

/-- In the zero-thickness model, membership in a Minkowski sum is exactly
equality with the corresponding pair-sum center. -/
theorem mem_minkowskiSum_zeroThicknessConicPlates_iff
    (radius radius' : Real) (direction direction' : Euclidean 2)
    (Z : WaveSpaceTime) :
    Z ∈ minkowskiSum (zeroThicknessConicPlate radius direction)
        (zeroThicknessConicPlate radius' direction') ↔
      zeroThicknessConicPoint radius direction +
        zeroThicknessConicPoint radius' direction' = Z := by
  constructor
  · rintro ⟨z, hz, w, hw, hzw⟩
    have hz' : z = zeroThicknessConicPoint radius direction := by
      simpa [zeroThicknessConicPlate] using hz
    have hw' : w = zeroThicknessConicPoint radius' direction' := by
      simpa [zeroThicknessConicPlate] using hw
    subst z
    subst w
    exact hzw
  · intro h
    exact ⟨zeroThicknessConicPoint radius direction,
      by simp [zeroThicknessConicPlate],
      zeroThicknessConicPoint radius' direction',
      by simp [zeroThicknessConicPlate], h⟩

/-- The active ordered angular pairs in the zero-thickness, fixed-radius
model at one prescribed output frequency. -/
noncomputable def zeroThicknessPlateOverlapPairs (radius radius' : Real)
    (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) : Finset (Int × Int) := by
  classical
  exact (angularSeparationPairs indices k).filter
    (fun pair => zeroThicknessPlatePairSum radius radius' directions pair = Z)

/-- The corresponding zero-thickness overlap multiplicity. -/
noncomputable def zeroThicknessPlateOverlapMultiplicity (radius radius' : Real)
    (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) : Nat :=
  (zeroThicknessPlateOverlapPairs radius radius' indices directions k Z).card

/-- The first spatial summands occurring in one fixed zero-thickness
plate-overlap fiber.  They will lie in the intersection of two circles. -/
noncomputable def zeroThicknessPlateOverlapFirstSpatialPoints
    (radius radius' : Real) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime) :
    Finset (Euclidean 2) := by
  classical
  exact (zeroThicknessPlateOverlapPairs radius radius' indices directions k Z).image
    (fun pair => radius • directions pair.1)

/-- Under the nonzero-radius and angular-spacing hypotheses, recording the
first spatial summand loses no information from an active zero-thickness
ordered pair. -/
theorem zeroThicknessPlateOverlapPairs_firstSpatial_injective_of_angularSectorGeometry
    {scale sectorRadius spacingLower spacingUpper radius radius' : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2} (k : Nat)
    (Z : WaveSpaceTime) (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hradius : radius ≠ 0) (hradius' : radius' ≠ 0) :
    Set.InjOn (fun pair : Int × Int => radius • directions pair.1)
      (zeroThicknessPlateOverlapPairs radius radius' indices directions k Z) := by
  intro pair hpair pair' hpair' hfirst
  rcases pair with ⟨i, j⟩
  rcases pair' with ⟨i', j'⟩
  change radius • directions i = radius • directions i' at hfirst
  have hdirectionFirst : directions i = directions i' :=
    smul_right_injective _ hradius hfirst
  have hpairBase : (i, j) ∈ angularSeparationPairs indices k ∧
      zeroThicknessPlatePairSum radius radius' directions (i, j) = Z := by
    simpa [zeroThicknessPlateOverlapPairs] using hpair
  have hpairBase' : (i', j') ∈ angularSeparationPairs indices k ∧
      zeroThicknessPlatePairSum radius radius' directions (i', j') = Z := by
    simpa [zeroThicknessPlateOverlapPairs] using hpair'
  have hi : i ∈ indices :=
    (mem_angularSeparationPairs_iff indices k (i, j)).mp hpairBase.1 |>.1
  have hi' : i' ∈ indices :=
    (mem_angularSeparationPairs_iff indices k (i', j')).mp hpairBase'.1 |>.1
  have hii : i = i' :=
    angularSectorGeometry_direction_injective hscale hgeometry hi hi' hdirectionFirst
  subst i'
  have hj : j ∈ indices :=
    (mem_angularSeparationPairs_iff indices k (i, j)).mp hpairBase.1 |>.2.1
  have hj' : j' ∈ indices :=
    (mem_angularSeparationPairs_iff indices k (i, j')).mp hpairBase'.1 |>.2.1
  have hsum : zeroThicknessPlatePairSum radius radius' directions (i, j) =
      zeroThicknessPlatePairSum radius radius' directions (i, j') :=
    hpairBase.2.trans hpairBase'.2.symm
  exact Prod.ext rfl
    (zeroThicknessPlatePairSum_right_injective_of_angularSectorGeometry
      hscale hgeometry hj hj' hradius' hsum)

/-- Every first spatial summand in an active zero-thickness pair fiber lies
simultaneously on the circle of radius `radius` around zero and the circle of
radius `radius'` around the prescribed output spatial frequency. -/
theorem mem_zeroThicknessPlateOverlapFirstSpatialPoints_two_spheres
    {scale sectorRadius spacingLower spacingUpper radius radius' : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2} (k : Nat)
    (Z : WaveSpaceTime) (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hradius : 0 ≤ radius) (hradius' : 0 ≤ radius')
    {p : Euclidean 2}
    (hp : p ∈ zeroThicknessPlateOverlapFirstSpatialPoints
      radius radius' indices directions k Z) :
    p ∈ (⟨0, radius⟩ : EuclideanGeometry.Sphere (Euclidean 2)) ∧
      p ∈ (⟨Z.1, radius'⟩ : EuclideanGeometry.Sphere (Euclidean 2)) := by
  classical
  rcases Finset.mem_image.mp hp with ⟨pair, hpair, rfl⟩
  have hpairBase : pair ∈ angularSeparationPairs indices k ∧
      zeroThicknessPlatePairSum radius radius' directions pair = Z := by
    simpa [zeroThicknessPlateOverlapFirstSpatialPoints,
      zeroThicknessPlateOverlapPairs] using hpair
  have hfirst : ‖directions pair.1‖ = 1 :=
    (hgeometry.2.2.2.2.choose_spec.2 pair.1
      ((mem_angularSeparationPairs_iff indices k pair).mp hpairBase.1).1).1
  have hsecond : ‖directions pair.2‖ = 1 :=
    (hgeometry.2.2.2.2.choose_spec.2 pair.2
      ((mem_angularSeparationPairs_iff indices k pair).mp hpairBase.1).2.1).1
  constructor
  · rw [EuclideanGeometry.mem_sphere]
    exact dist_zero_zeroThicknessPlatePairSum_first hradius hfirst
  · rw [EuclideanGeometry.mem_sphere]
    have hspatial : (zeroThicknessPlatePairSum radius radius' directions pair).1 = Z.1 :=
      congrArg Prod.fst hpairBase.2
    rw [← hspatial]
    exact dist_zeroThicknessPlatePairSum_first_spatial hradius' hsecond

/-- In the nondegenerate-output case, the planar zero-thickness overlap
fiber has multiplicity at most two.  The proof uses the exact two-circle
intersection theorem in `ℝ²`, together with the angular-spacing hypothesis
to recover ordered labels from the first spatial summand. -/
theorem zeroThicknessPlateOverlapMultiplicity_le_two_of_angularSectorGeometry_of_spatial_ne_zero
    {scale sectorRadius spacingLower spacingUpper radius radius' : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2} (k : Nat)
    (Z : WaveSpaceTime) (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hradius : 0 < radius) (hradius' : 0 < radius') (hZ : Z.1 ≠ 0) :
    zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z ≤ 2 := by
  classical
  let active := zeroThicknessPlateOverlapPairs radius radius' indices directions k Z
  let firstPoints := active.image (fun pair : Int × Int => radius • directions pair.1)
  have hinjective : Set.InjOn (fun pair : Int × Int => radius • directions pair.1)
      (active : Set (Int × Int)) := by
    simpa [active] using
      (zeroThicknessPlateOverlapPairs_firstSpatial_injective_of_angularSectorGeometry
        k Z hscale hgeometry hradius.ne' hradius'.ne')
  let s₁ : EuclideanGeometry.Sphere (Euclidean 2) := ⟨0, radius⟩
  let s₂ : EuclideanGeometry.Sphere (Euclidean 2) := ⟨Z.1, radius'⟩
  have hspheres : s₁ ≠ s₂ := by
    intro hs
    have hcenters := congrArg EuclideanGeometry.Sphere.center hs
    change (0 : Euclidean 2) = Z.1 at hcenters
    exact hZ hcenters.symm
  have hfinrank : Module.finrank Real (Euclidean 2) = 2 := by
    simp [Euclidean]
  have hcircle : ∀ p ∈ firstPoints, p ∈ s₁ ∧ p ∈ s₂ := by
    intro p hp
    simpa [firstPoints, active, s₁, s₂] using
      (mem_zeroThicknessPlateOverlapFirstSpatialPoints_two_spheres k Z hgeometry
        hradius.le hradius'.le hp)
  have hpointsCard : firstPoints.card ≤ 2 := by
    apply finset_card_le_two_of_forall_mem_eq_or_eq
    intro a ha b hb hab c hc
    rcases hcircle a ha with ⟨ha₁, ha₂⟩
    rcases hcircle b hb with ⟨hb₁, hb₂⟩
    rcases hcircle c hc with ⟨hc₁, hc₂⟩
    exact EuclideanGeometry.eq_of_mem_sphere_of_mem_sphere_of_finrank_eq_two
      hfinrank hspheres hab ha₁ hb₁ hc₁ ha₂ hb₂ hc₂
  have hcard : active.card = firstPoints.card := by
    change active.card =
      (active.image (fun pair : Int × Int => radius • directions pair.1)).card
    exact (Finset.card_image_of_injOn hinjective).symm
  calc
    zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z = active.card := rfl
    _ = firstPoints.card := hcard
    _ ≤ 2 := hpointsCard

/-- The fully nondegenerate zero-thickness plate-overlap theorem in the
stated planar angular-sector geometry.  If the fiber is nonempty, the common
sector condition forces its output spatial frequency to be nonzero, so the
two-circle intersection argument applies; if it is empty the conclusion is
immediate. -/
theorem zeroThicknessPlateOverlapMultiplicity_le_two_of_angularSectorGeometry
    {scale sectorRadius spacingLower spacingUpper radius radius' : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2} (k : Nat)
    (Z : WaveSpaceTime) (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hradius : 0 < radius) (hradius' : 0 < radius') :
    zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z ≤ 2 := by
  classical
  by_cases hnonempty :
      (zeroThicknessPlateOverlapPairs radius radius' indices directions k Z).Nonempty
  · obtain ⟨pair, hpair⟩ := hnonempty
    have hpairBase : pair ∈ angularSeparationPairs indices k ∧
        zeroThicknessPlatePairSum radius radius' directions pair = Z := by
      simpa [zeroThicknessPlateOverlapPairs] using hpair
    have hi : pair.1 ∈ indices :=
      (mem_angularSeparationPairs_iff indices k pair).mp hpairBase.1 |>.1
    have hj : pair.2 ∈ indices :=
      (mem_angularSeparationPairs_iff indices k pair).mp hpairBase.1 |>.2.1
    have hsumNe : (zeroThicknessPlatePairSum radius radius' directions pair).1 ≠ 0 :=
      zeroThicknessPlatePairSum_spatial_ne_zero_of_angularSectorGeometry
        hgeometry hradius hradius' hi hj
    have hZ : Z.1 ≠ 0 := by
      intro hzero
      apply hsumNe
      rw [hpairBase.2, hzero]
    exact
      zeroThicknessPlateOverlapMultiplicity_le_two_of_angularSectorGeometry_of_spatial_ne_zero
        k Z hscale hgeometry hradius hradius' hZ
  · have hempty : zeroThicknessPlateOverlapPairs radius radius' indices directions k Z = ∅ :=
      Finset.not_nonempty_iff_eq_empty.mp hnonempty
    simp [zeroThicknessPlateOverlapMultiplicity, hempty]

/-- The elementary zero-thickness plate-overlap bound furnished directly by
the prescribed angular-sector geometry.  Once the first label is fixed, a
nonzero second radius and equality of pair sums determine the second
direction, and the lower spacing condition determines its label.  Thus the
active ordered-pair fiber injects into its first-label projection.  This is
a genuine linear finite-overlap reduction; the sharp MSS geometry improves
the remaining cardinality factor to a scale-small bound. -/
theorem zeroThicknessPlateOverlapMultiplicity_le_card_of_angularSectorGeometry
    {scale sectorRadius spacingLower spacingUpper radius radius' : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2} (k : Nat)
    (Z : WaveSpaceTime) (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hradius' : radius' ≠ 0) :
    zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z ≤
      indices.card := by
  classical
  let active := zeroThicknessPlateOverlapPairs radius radius' indices directions k Z
  have hmaps : Set.MapsTo Prod.fst (active : Set (Int × Int)) (indices : Set Int) := by
    intro pair hpair
    have hpairBase : pair ∈ angularSeparationPairs indices k ∧
        zeroThicknessPlatePairSum radius radius' directions pair = Z := by
      simpa [active, zeroThicknessPlateOverlapPairs] using hpair
    exact (mem_angularSeparationPairs_iff indices k pair).mp hpairBase.1 |>.1
  have hinjective : (active : Set (Int × Int)).InjOn Prod.fst := by
    intro pair hpair pair' hpair' hfst
    rcases pair with ⟨i, j⟩
    rcases pair' with ⟨i', j'⟩
    change i = i' at hfst
    subst i'
    have hpairBase : (i, j) ∈ angularSeparationPairs indices k ∧
        zeroThicknessPlatePairSum radius radius' directions (i, j) = Z := by
      simpa [active, zeroThicknessPlateOverlapPairs] using hpair
    have hpairBase' : (i, j') ∈ angularSeparationPairs indices k ∧
        zeroThicknessPlatePairSum radius radius' directions (i, j') = Z := by
      simpa [active, zeroThicknessPlateOverlapPairs] using hpair'
    have hj : j ∈ indices :=
      (mem_angularSeparationPairs_iff indices k (i, j)).mp hpairBase.1 |>.2.1
    have hj' : j' ∈ indices :=
      (mem_angularSeparationPairs_iff indices k (i, j')).mp hpairBase'.1 |>.2.1
    have hsum : zeroThicknessPlatePairSum radius radius' directions (i, j) =
        zeroThicknessPlatePairSum radius radius' directions (i, j') :=
      hpairBase.2.trans hpairBase'.2.symm
    exact Prod.ext rfl
      (zeroThicknessPlatePairSum_right_injective_of_angularSectorGeometry
        hscale hgeometry hj hj' hradius' hsum)
  change active.card ≤ indices.card
  exact Finset.card_le_card_of_injOn Prod.fst hmaps hinjective

/-- A strengthened geometric hypothesis for the fixed-radius model: a
pair-sum fiber contains only a pair itself and, at most, its reversed ordered
pair.  This is the appropriate replacement for literal injectivity because
equal-radius sums are invariant under swapping the two directions. -/
def zeroThicknessPairSumAtMostTwo (radius radius' : Real)
    (indices : Finset Int) (directions : Int → Euclidean 2) (k : Nat) : Prop :=
  ∀ ⦃pair⦄, pair ∈ angularSeparationPairs indices k →
    ∀ ⦃pair'⦄, pair' ∈ angularSeparationPairs indices k →
      zeroThicknessPlatePairSum radius radius' directions pair =
        zeroThicknessPlatePairSum radius radius' directions pair' →
        pair = pair' ∨ pair = (pair'.2, pair'.1)

/-- Under the explicit two-to-one pair-sum geometry, every zero-thickness
model overlap multiplicity is at most two. -/
theorem zeroThicknessPlateOverlapMultiplicity_le_two_of_pairSumAtMostTwo
    (radius radius' : Real) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime)
    (hgeom : zeroThicknessPairSumAtMostTwo radius radius' indices directions k) :
    zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z ≤ 2 := by
  classical
  let active := zeroThicknessPlateOverlapPairs radius radius' indices directions k Z
  by_cases hnonempty : active.Nonempty
  · obtain ⟨pair, hpair⟩ := hnonempty
    have hpairBase : pair ∈ angularSeparationPairs indices k ∧
        zeroThicknessPlatePairSum radius radius' directions pair = Z := by
      simpa [active, zeroThicknessPlateOverlapPairs] using hpair
    have hsubset : active ⊆ ({pair, (pair.2, pair.1)} : Finset (Int × Int)) := by
      intro pair' hactive
      have hpairActive : pair' ∈ angularSeparationPairs indices k ∧
          zeroThicknessPlatePairSum radius radius' directions pair' = Z := by
        simpa [active, zeroThicknessPlateOverlapPairs] using hactive
      rcases hgeom (pair := pair') hpairActive.1 (pair' := pair) hpairBase.1
        (hpairActive.2.trans hpairBase.2.symm) with h | h
      · exact Finset.mem_insert.mpr (Or.inl h)
      · exact Finset.mem_insert.mpr
          (Or.inr (Finset.mem_singleton.mpr h))
    change active.card ≤ 2
    exact (Finset.card_le_card hsubset).trans Finset.card_le_two
  · have hempty : active = ∅ := Finset.not_nonempty_iff_eq_empty.mp hnonempty
    change active.card ≤ 2
    simp [hempty]

/-- At equal radii the zero-thickness pair-sum is invariant under swapping
the two ordered angular labels. -/
theorem zeroThicknessPlatePairSum_swap (radius : Real)
    (directions : Int → Euclidean 2) (pair : Int × Int) :
    zeroThicknessPlatePairSum radius radius directions (pair.2, pair.1) =
      zeroThicknessPlatePairSum radius radius directions pair := by
  simp [zeroThicknessPlatePairSum, add_comm]

/-- The swap symmetry gives an exact obstruction to a false multiplicity-one
claim for ordered pairs at equal radii. -/
theorem two_le_zeroThicknessPlateOverlapMultiplicity_of_offDiagonalPair
    (radius : Real) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (pair : Int × Int)
    (hpair : pair ∈ angularSeparationPairs indices k)
    (hoff : pair ≠ (pair.2, pair.1)) :
    2 ≤ zeroThicknessPlateOverlapMultiplicity radius radius indices directions k
      (zeroThicknessPlatePairSum radius radius directions pair) := by
  classical
  let Z := zeroThicknessPlatePairSum radius radius directions pair
  let active := zeroThicknessPlateOverlapPairs radius radius indices directions k Z
  have hswap : (pair.2, pair.1) ∈ angularSeparationPairs indices k :=
    (mem_swap_angularSeparationPairs_iff indices k pair.1 pair.2).mpr hpair
  have hpairActive : pair ∈ active := by
    have : pair ∈ angularSeparationPairs indices k ∧
        zeroThicknessPlatePairSum radius radius directions pair = Z := ⟨hpair, rfl⟩
    simpa [active, zeroThicknessPlateOverlapPairs] using this
  have hswapActive : (pair.2, pair.1) ∈ active := by
    have hsum : zeroThicknessPlatePairSum radius radius directions (pair.2, pair.1) = Z := by
      simpa [Z] using zeroThicknessPlatePairSum_swap radius directions pair
    have : (pair.2, pair.1) ∈ angularSeparationPairs indices k ∧
        zeroThicknessPlatePairSum radius radius directions (pair.2, pair.1) = Z :=
      ⟨hswap, hsum⟩
    simpa [active, zeroThicknessPlateOverlapPairs] using this
  have hsubset : ({pair, (pair.2, pair.1)} : Finset (Int × Int)) ⊆ active := by
    intro pair' hpair'
    simp only [Finset.mem_insert, Finset.mem_singleton] at hpair'
    rcases hpair' with h | h
    · simpa [h] using hpairActive
    · simpa [h] using hswapActive
  change 2 ≤ active.card
  calc
    2 = ({pair, (pair.2, pair.1)} : Finset (Int × Int)).card :=
      (Finset.card_pair hoff).symm
    _ ≤ active.card := Finset.card_le_card hsubset

/-- A unit-normal-thickness conic plate translated in the normal coordinate.
The radial and angular windows are unchanged.  This is the genuinely needed
input for a thick-plate cover argument; it is not the zero-thickness model. -/
def unitNormalConicPlate (scale angularConstant normalShift : Real) (n : Int)
    (direction : Euclidean 2) : Set WaveSpaceTime :=
  {ζ | scale / 4 ≤ ‖ζ.1‖ ∧ ‖ζ.1‖ ≤ 4 * scale ∧
    ζ.1 ∈ angularSector direction
      (angularConstant * scale ^ (-(1 / 2 : Real))) ∧
    |(Real.sqrt scale)⁻¹ * ζ.2 - n| ≤ 1 ∧
    |(ζ.2 - ‖ζ.1‖) - normalShift| ≤ 2}

/-- A finite normal-coordinate cover of each thick conic plate by translated
unit-normal-thickness plates. -/
def normalCoordinatePlateCover (scale gamma angularConstant : Real)
    (normalShifts : Finset Real) : Prop :=
  ∀ (n : Int) (direction : Euclidean 2) (ζ : WaveSpaceTime),
    ζ ∈ conicPlate scale gamma angularConstant n direction →
      ∃ shift ∈ normalShifts,
        ζ ∈ unitNormalConicPlate scale angularConstant shift n direction

/-- The finite family of angular pairs whose translated unit-normal-thickness
plates can contribute to a prescribed Minkowski-sum frequency. -/
noncomputable def unitNormalPlateOverlapPairs
    (scale angularConstant : Real) (normalShift normalShift' : Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) : Finset (Int × Int) := by
  classical
  exact (angularSeparationPairs indices k).filter (fun pair =>
    Z ∈ minkowskiSum
      (unitNormalConicPlate scale angularConstant normalShift n (directions pair.1))
      (unitNormalConicPlate scale angularConstant normalShift' n' (directions pair.2)))

/-- Membership in a translated unit-normal-thickness overlap fiber. -/
theorem mem_unitNormalPlateOverlapPairs_iff
    (scale angularConstant : Real) (normalShift normalShift' : Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (pair : Int × Int) :
    pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
        n n' indices directions k Z ↔
      pair ∈ angularSeparationPairs indices k ∧
        Z ∈ minkowskiSum
          (unitNormalConicPlate scale angularConstant normalShift n (directions pair.1))
          (unitNormalConicPlate scale angularConstant normalShift' n' (directions pair.2)) := by
  classical
  simp [unitNormalPlateOverlapPairs]

/-- The cardinality of a translated unit-normal-thickness overlap fiber. -/
noncomputable def unitNormalPlateOverlapMultiplicity
    (scale angularConstant : Real) (normalShift normalShift' : Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) : Nat :=
  (unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
    n n' indices directions k Z).card

/-- Every real normal coordinate is within unit-normal thickness of a
translate from the `4 ℤ` lattice. -/
theorem abs_sub_four_mul_floor_le_two (q : Real) :
    |q - 4 * (⌊(q + 2) / 4⌋ : Int)| ≤ 2 := by
  have hfloor : ((⌊(q + 2) / 4⌋ : Int) : Real) ≤ (q + 2) / 4 :=
    Int.floor_le _
  have hlt : (q + 2) / 4 < ((⌊(q + 2) / 4⌋ : Int) : Real) + 1 :=
    Int.lt_floor_add_one _
  rw [abs_le]
  constructor <;> linarith

/-- The explicit finite `4 ℤ` normal-coordinate cover of a window with
radius `2 * R`. -/
noncomputable def normalCoverShifts (R : Real) : Finset Real :=
  (Finset.Icc (-⌈R / 2⌉ - 1) (⌈R / 2⌉ + 1)).image
    (fun m : Int => (4 : Real) * m)

/-- The floor-selected normal translate belongs to the explicit cover range. -/
theorem floor_mem_normalCoverShifts (R q : Real)
    (hq : |q| ≤ 2 * R) :
    (4 : Real) * (⌊(q + 2) / 4⌋ : Int) ∈ normalCoverShifts R := by
  refine Finset.mem_image.mpr ?_
  refine ⟨⌊(q + 2) / 4⌋, ?_, rfl⟩
  rw [Finset.mem_Icc]
  rw [abs_le] at hq
  have hceil : R / 2 ≤ ((⌈R / 2⌉ : Int) : Real) := Int.le_ceil _
  constructor
  · rw [Int.le_floor]
    norm_num
    linarith
  · have hfloor : ((⌊(q + 2) / 4⌋ : Int) : Real) ≤ (q + 2) / 4 :=
      Int.floor_le _
    have hcast : ((⌊(q + 2) / 4⌋ : Int) : Real) ≤
        ((⌈R / 2⌉ + 1 : Int) : Real) := by
      norm_num
      linarith
    exact_mod_cast hcast

/-- The explicit `4 ℤ` family covers the normal window of every thick plate.
This is a direct interval calculation; no conic-overlap geometry is used. -/
theorem normalCoordinatePlateCover_normalCoverShifts
    (scale gamma angularConstant : Real) :
    normalCoordinatePlateCover scale gamma angularConstant
      (normalCoverShifts (scale ^ gamma)) := by
  intro n direction z hz
  rcases hz with ⟨hradialLower, hradialUpper, hangular, hvør, hnormal⟩
  let q : Real := z.2 - ‖z.1‖
  let shift : Real := 4 * ((⌊(q + 2) / 4⌋ : Int) : Real)
  refine ⟨shift, ?_, ?_⟩
  · change (4 : Real) * ((⌊(q + 2) / 4⌋ : Int) : Real) ∈
      normalCoverShifts (scale ^ gamma)
    apply floor_mem_normalCoverShifts
    simpa [q] using hnormal
  · exact ⟨hradialLower, hradialUpper, hangular, hvør, by
      change |q - 4 * ((⌊(q + 2) / 4⌋ : Int) : Real)| ≤ 2
      exact abs_sub_four_mul_floor_le_two q⟩

/-- The explicit normal-coordinate cover has at most `6 R` members whenever
`R ≥ 1`. -/
theorem card_normalCoverShifts_le_six_mul (R : Real) (hR : 1 ≤ R) :
    ((normalCoverShifts R).card : Real) ≤ 6 * R := by
  let c : Int := ⌈R / 2⌉
  have hc : R / 2 ≤ (c : Real) := by
    exact Int.le_ceil _
  have hc0 : 0 ≤ c := by
    have hc0real : 0 ≤ (c : Real) := by linarith
    exact_mod_cast hc0real
  have hcount_nonneg : 0 ≤ c + 1 + 1 - (-c - 1) := by omega
  have hcard : (normalCoverShifts R).card ≤
      (Finset.Icc (-c - 1) (c + 1)).card := by
    unfold normalCoverShifts
    exact Finset.card_image_le
  have hIcc : (Finset.Icc (-c - 1) (c + 1)).card = (2 * c + 3).toNat := by
    rw [Int.card_Icc]
    congr 1
    omega
  have hcount : (((2 * c + 3).toNat : Nat) : Real) = 2 * (c : Real) + 3 := by
    have hcast : (((2 * c + 3).toNat : Nat) : Int) = 2 * c + 3 :=
      Int.toNat_of_nonneg (by omega)
    exact_mod_cast hcast
  have hcardReal : ((normalCoverShifts R).card : Real) ≤
      2 * (c : Real) + 3 := by
    have hnat : (normalCoverShifts R).card ≤ (2 * c + 3).toNat :=
      hcard.trans_eq hIcc
    have hnatReal : ((normalCoverShifts R).card : Real) ≤
        (((2 * c + 3).toNat : Nat) : Real) := by
      exact_mod_cast hnat
    rw [hcount] at hnatReal
    exact hnatReal
  have hcupper : (c : Real) < R / 2 + 1 := by
    exact_mod_cast Int.ceil_lt_add_one (R / 2)
  linarith

/-- At the MSS scales, the explicit normal-coordinate cover has cardinality
at most `6 * scale^gamma`. -/
theorem card_normalCoverShifts_at_scale_le_six_mul
    (scale gamma : Real) (hscale : 2 ≤ scale) (hgamma : 0 ≤ gamma) :
    ((normalCoverShifts (scale ^ gamma)).card : Real) ≤ 6 * scale ^ gamma := by
  apply card_normalCoverShifts_le_six_mul
  apply Real.one_le_rpow
  · linarith
  · exact hgamma

/-- The finite family of angular pairs whose two conic plates can contribute
to a prescribed Minkowski-sum frequency. -/
noncomputable def plateOverlapPairs (scale gamma angularConstant : Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) : Finset (Int × Int) := by
  classical
  exact (angularSeparationPairs indices k).filter (fun pair =>
    Z ∈ minkowskiSum (conicPlate scale gamma angularConstant n (directions pair.1))
      (conicPlate scale gamma angularConstant n' (directions pair.2)))

/-- Membership in the active pair family is precisely angular separation
together with containment of the prescribed frequency in the plate sum. -/
theorem mem_plateOverlapPairs_iff (scale gamma angularConstant : Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (pair : Int × Int) :
    pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z ↔
      pair ∈ angularSeparationPairs indices k ∧
        Z ∈ minkowskiSum
          (conicPlate scale gamma angularConstant n (directions pair.1))
          (conicPlate scale gamma angularConstant n' (directions pair.2)) := by
  classical
  simp [plateOverlapPairs]

/-- Active plate-overlap pairs form a subfamily of the fixed separation
class. -/
theorem plateOverlapPairs_subset_angularSeparationPairs
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime) :
    plateOverlapPairs scale gamma angularConstant n n' indices directions k Z ⊆
      angularSeparationPairs indices k := by
  classical
  rw [plateOverlapPairs]
  exact Finset.filter_subset _ _

/-- The number of pairs of conic plates at a prescribed angular separation
whose Minkowski sum contains a given frequency point. -/
noncomputable def plateOverlapMultiplicity (scale gamma angularConstant : Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) : Nat :=
  (plateOverlapPairs scale gamma angularConstant n n' indices directions k Z).card

/-- The overlap multiplicity is exactly the cardinality of its active finite
pair family. -/
theorem plateOverlapMultiplicity_eq_card_plateOverlapPairs
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime) :
    plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z =
      (plateOverlapPairs scale gamma angularConstant n n' indices directions k Z).card := rfl

private noncomputable def normalCoverOverlapPairs
    (scale angularConstant : Real) (normalShifts : Finset Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) : Finset (Int × Int) := by
  classical
  exact (normalShifts.product normalShifts).biUnion (fun shifts =>
    unitNormalPlateOverlapPairs scale angularConstant shifts.1 shifts.2
      n n' indices directions k Z)

private theorem plateOverlapPairs_subset_normalCoverOverlapPairs
    (scale gamma angularConstant : Real) (normalShifts : Finset Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime)
    (hcover : normalCoordinatePlateCover scale gamma angularConstant normalShifts) :
    plateOverlapPairs scale gamma angularConstant n n' indices directions k Z ⊆
      normalCoverOverlapPairs scale angularConstant normalShifts
        n n' indices directions k Z := by
  classical
  intro pair hpair
  rcases (mem_plateOverlapPairs_iff scale gamma angularConstant n n' indices directions k Z pair).mp
    hpair with ⟨hseparation, hsum⟩
  rcases hsum with ⟨z, hz, w, hw, hzw⟩
  rcases hcover n (directions pair.1) z hz with ⟨shift, hshift, hzshift⟩
  rcases hcover n' (directions pair.2) w hw with ⟨shift', hshift', hwshift⟩
  apply Finset.mem_biUnion.mpr
  refine ⟨(shift, shift'), Finset.mem_product.mpr ⟨hshift, hshift'⟩, ?_⟩
  apply (mem_unitNormalPlateOverlapPairs_iff scale angularConstant shift shift'
    n n' indices directions k Z pair).mpr
  exact ⟨hseparation, ⟨z, hzshift, w, hwshift, hzw⟩⟩

/-- A finite cover by translated unit-normal plates transfers a uniform
unit-normal overlap bound to the original thick plate. -/
theorem plateOverlapMultiplicity_le_normalCover_mul_unitBound
    (scale gamma angularConstant : Real) (normalShifts : Finset Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (M : Nat)
    (hcover : normalCoordinatePlateCover scale gamma angularConstant normalShifts)
    (hunit : ∀ shift ∈ normalShifts, ∀ shift' ∈ normalShifts,
      unitNormalPlateOverlapMultiplicity scale angularConstant shift shift'
        n n' indices directions k Z ≤ M) :
    plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z ≤
      normalShifts.card * normalShifts.card * M := by
  classical
  have hsubset := plateOverlapPairs_subset_normalCoverOverlapPairs
    scale gamma angularConstant normalShifts n n' indices directions k Z hcover
  calc
    plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z =
        (plateOverlapPairs scale gamma angularConstant n n' indices directions k Z).card := rfl
    _ ≤ (normalCoverOverlapPairs scale angularConstant normalShifts
        n n' indices directions k Z).card := Finset.card_le_card hsubset
    _ ≤ (normalShifts.product normalShifts).card * M := by
      apply Finset.card_biUnion_le_card_mul
      intro shifts hshifts
      rcases Finset.mem_product.mp hshifts with ⟨hleft, hright⟩
      simpa [unitNormalPlateOverlapMultiplicity] using hunit shifts.1 hleft shifts.2 hright
    _ = normalShifts.card * normalShifts.card * M := by
      have hcard : (normalShifts.product normalShifts).card =
          normalShifts.card * normalShifts.card := by
        exact Finset.card_product _ _
      rw [hcard]

/-- Cauchy--Schwarz on the active finite pair family.  The factor is the
literal plate-overlap multiplicity; no geometric bound for it is used. -/
theorem sq_sum_norm_plateOverlapPairs_le_plateOverlapMultiplicity_mul_sum_sq
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime)
    (F : Int × Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
        ‖F pair z‖) ^ 2 ≤
      (plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z : Real) *
        ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
          ‖F pair z‖ ^ 2 := by
  rw [plateOverlapMultiplicity_eq_card_plateOverlapPairs]
  exact sq_sum_le_card_mul_sum_sq

/-- The preceding active-pair inequality in the product form used by the
finite fourth-power calculation. -/
theorem sq_sum_norm_mul_plateOverlapPairs_le_plateOverlapMultiplicity_mul_sum_sq
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime)
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
        ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
      (plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z : Real) *
        ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
          ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
  calc
    (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
        ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
        (plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z : Real) *
          ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
            ‖(fun pair z => F pair.1 z * G pair.2 z) pair z‖ ^ 2 :=
      sq_sum_norm_plateOverlapPairs_le_plateOverlapMultiplicity_mul_sum_sq
        scale gamma angularConstant n n' indices directions k Z
        (fun pair z => F pair.1 z * G pair.2 z) z
    _ = (plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z : Real) *
        ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
          ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
      congr 1
      apply Finset.sum_congr rfl
      intro pair hpair
      rw [norm_mul]
      ring

/-- A plate-overlap multiplicity is bounded by the number of angular pairs
under consideration. -/
theorem plateOverlapMultiplicity_le_card_angularSeparationPairs
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime) :
    plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z ≤
      (angularSeparationPairs indices k).card := by
  rw [plateOverlapMultiplicity_eq_card_plateOverlapPairs]
  exact Finset.card_le_card
    (plateOverlapPairs_subset_angularSeparationPairs scale gamma angularConstant n n'
      indices directions k Z)

/-- The trivial finite-index bound for a plate-overlap multiplicity.  The
geometric plate-overlap lemma improves this quadratic estimate. -/
theorem plateOverlapMultiplicity_le_card_sq
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime) :
    plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z ≤
      indices.card ^ 2 :=
  (plateOverlapMultiplicity_le_card_angularSeparationPairs scale gamma angularConstant
    n n' indices directions k Z).trans (card_angularSeparationPairs_le indices k)

/-- Substituting the elementary finite pair-count bound gives a fully
geometric-free fourth-power estimate.  The sharp MSS argument replaces this
quadratic factor by the plate-overlap estimate. -/
theorem sq_sum_norm_mul_plateOverlapPairs_le_card_sq_mul_sum_sq
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime)
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
        ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
      (indices.card : Real) ^ 2 *
        ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
          ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
  have hmult :
      (plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z : Real) ≤
        (indices.card : Real) ^ 2 := by
    exact_mod_cast
      plateOverlapMultiplicity_le_card_sq scale gamma angularConstant n n' indices directions k Z
  have henergy : 0 ≤
      ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
        ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
    Finset.sum_nonneg fun pair hpair =>
      mul_nonneg (sq_nonneg (‖F pair.1 z‖)) (sq_nonneg (‖G pair.2 z‖))
  calc
    (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
        ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
        (plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z : Real) *
          ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
            ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
      sq_sum_norm_mul_plateOverlapPairs_le_plateOverlapMultiplicity_mul_sum_sq
        scale gamma angularConstant n n' indices directions k Z F G z
    _ ≤ (indices.card : Real) ^ 2 *
        ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
          ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
      mul_le_mul_of_nonneg_right hmult henergy

/-- The geometric plate-overlap target.  `maxLevel` is supplied by the
angular decomposition; for the blueprint it is the ceiling-logarithmic bound
on the number of angular sectors.  Unlike an unconstrained family of vectors,
the directions are required to arise from a uniformly spaced, ordered angular
sector geometry.  The multiplicative constant is allowed to depend on the
normal-thickness parameter `gamma`, as in the blueprint. -/
def plateOverlap (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real) : Prop :=
  0 < angularConstant ∧ ∃ overlapExponent : Real, 0 < overlapExponent ∧
    ∀ gamma : Real, 0 < gamma → gamma < 1 / 10 →
      ∃ Cgamma : Real, 0 < Cgamma ∧
        ∀ scale : Real, 2 ≤ scale → ∀ radialIndices angularIndices : Finset Int,
          ∀ directions : Int → Euclidean 2,
            angularSectorGeometry scale angularIndices directions
              sectorRadius spacingLower spacingUpper →
            ∀ n ∈ radialIndices, ∀ n' ∈ radialIndices,
              ∀ k : Nat, k ≤ maxLevel scale → ∀ Z : WaveSpaceTime,
                (plateOverlapMultiplicity scale gamma angularConstant n n'
                  angularIndices directions k Z : Real) ≤
                    Cgamma * scale ^ (overlapExponent * gamma)

/-- The cited geometric input needed by the finite normal-coordinate cover.
It bounds overlap fibers for arbitrary *translated* unit-normal-thickness
plates uniformly in the translations.  This is intentionally stronger than
the proved zero-thickness two-circle theorem. -/
def translatedUnitNormalPlateOverlap (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real) : Prop :=
  ∃ M : Nat, ∀ scale : Real, 2 ≤ scale →
    ∀ radialIndices angularIndices : Finset Int,
      ∀ directions : Int → Euclidean 2,
        angularSectorGeometry scale angularIndices directions
          sectorRadius spacingLower spacingUpper →
        ∀ n ∈ radialIndices, ∀ n' ∈ radialIndices,
          ∀ k : Nat, k ≤ maxLevel scale → ∀ Z : WaveSpaceTime,
            ∀ normalShift normalShift' : Real,
              unitNormalPlateOverlapMultiplicity scale angularConstant
                normalShift normalShift' n n' angularIndices directions k Z ≤ M

private theorem aux_abs_time_sub_radialLabel_mul_sqrt_le
    {scale : Real} (hscale : 0 < scale) {n : Int} {t : Real}
    (ht : |(Real.sqrt scale)⁻¹ * t - n| ≤ 1) :
    |t - (n : Real) * Real.sqrt scale| ≤ Real.sqrt scale := by
  have hs : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
  have hsne : Real.sqrt scale ≠ 0 := ne_of_gt hs
  have hrewrite :
      (Real.sqrt scale)⁻¹ * t - (n : Real) =
        (Real.sqrt scale)⁻¹ * (t - (n : Real) * Real.sqrt scale) := by
    field_simp [hsne]
  rw [hrewrite, abs_mul, abs_of_pos (inv_pos.mpr hs)] at ht
  have hmul := mul_le_mul_of_nonneg_left ht hs.le
  calc
    |t - (n : Real) * Real.sqrt scale| =
        (Real.sqrt scale * (Real.sqrt scale)⁻¹) *
          |t - (n : Real) * Real.sqrt scale| := by
            rw [mul_inv_cancel₀ hsne, one_mul]
    _ = Real.sqrt scale *
          ((Real.sqrt scale)⁻¹ * |t - (n : Real) * Real.sqrt scale|) :=
      mul_assoc _ _ _
    _ ≤ Real.sqrt scale * 1 := hmul
    _ = Real.sqrt scale := by ring

private theorem aux_mem_unitNormalConicPlate_time_localized
    {scale angularConstant normalShift : Real} {n : Int}
    {direction : _root_.Codex.Spherical.SurfaceCore.Euclidean 2} {z : WaveSpaceTime}
    (hscale : 0 < scale)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction) :
    |z.2 - (n : Real) * Real.sqrt scale| ≤ Real.sqrt scale := by
  exact aux_abs_time_sub_radialLabel_mul_sqrt_le hscale hz.2.2.2.1

private theorem aux_mem_unitNormalConicPlate_radius_localized
    {scale angularConstant normalShift : Real} {n : Int}
    {direction : _root_.Codex.Spherical.SurfaceCore.Euclidean 2} {z : WaveSpaceTime}
    (hscale : 0 < scale)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction) :
    |‖z.1‖ - ((n : Real) * Real.sqrt scale - normalShift)| ≤
      Real.sqrt scale + 2 := by
  have htime := aux_mem_unitNormalConicPlate_time_localized hscale hz
  have hnormal : |(z.2 - ‖z.1‖) - normalShift| ≤ 2 := hz.2.2.2.2
  calc
    |‖z.1‖ - ((n : Real) * Real.sqrt scale - normalShift)| =
        |(z.2 - (n : Real) * Real.sqrt scale) -
          ((z.2 - ‖z.1‖) - normalShift)| := by ring_nf
    _ = |(z.2 - (n : Real) * Real.sqrt scale) +
          -((z.2 - ‖z.1‖) - normalShift)| := by ring_nf
    _ ≤ |z.2 - (n : Real) * Real.sqrt scale| +
          |-((z.2 - ‖z.1‖) - normalShift)| := abs_add_le _ _
    _ = |z.2 - (n : Real) * Real.sqrt scale| +
          |(z.2 - ‖z.1‖) - normalShift| := by rw [abs_neg]
    _ ≤ Real.sqrt scale + 2 := add_le_add htime hnormal

private theorem aux_mem_unitNormalConicPlate_direction_localized
    {scale angularConstant normalShift : Real} {n : Int}
    {direction : _root_.Codex.Spherical.SurfaceCore.Euclidean 2} {z : WaveSpaceTime}
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction) :
    z.1 ≠ 0 ∧
      ‖(‖z.1‖)⁻¹ • z.1 - direction‖ ≤
        angularConstant * scale ^ (-(1 / 2 : Real)) := by
  exact hz.2.2.1

private theorem aux_mem_minkowskiSum_unitNormalConicPlate_twoCone
    {scale angularConstant normalShift normalShift' : Real} {n n' : Int}
    {direction direction' : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {Z : WaveSpaceTime}
    (hZ : Z ∈ minkowskiSum
      (unitNormalConicPlate scale angularConstant normalShift n direction)
      (unitNormalConicPlate scale angularConstant normalShift' n' direction')) :
    ∃ z ∈ unitNormalConicPlate scale angularConstant normalShift n direction,
      ∃ w ∈ unitNormalConicPlate scale angularConstant normalShift' n' direction',
        z + w = Z ∧
          |(Z.2 - (‖z.1‖ + ‖w.1‖)) - (normalShift + normalShift')| ≤ 4 := by
  rcases hZ with ⟨z, hz, w, hw, hsum⟩
  refine ⟨z, hz, w, hw, hsum, ?_⟩
  have htime : z.2 + w.2 = Z.2 := congrArg Prod.snd hsum
  have hzNormal : |(z.2 - ‖z.1‖) - normalShift| ≤ 2 := hz.2.2.2.2
  have hwNormal : |(w.2 - ‖w.1‖) - normalShift'| ≤ 2 := hw.2.2.2.2
  calc
    |(Z.2 - (‖z.1‖ + ‖w.1‖)) - (normalShift + normalShift')| =
        |((z.2 - ‖z.1‖) - normalShift) +
          ((w.2 - ‖w.1‖) - normalShift')| := by
            rw [← htime]
            ring_nf
    _ ≤ |(z.2 - ‖z.1‖) - normalShift| +
          |(w.2 - ‖w.1‖) - normalShift'| := abs_add_le _ _
    _ ≤ 4 := by linarith

private theorem aux_twoCone_polar_identity
    (X x : _root_.Codex.Spherical.SurfaceCore.Euclidean 2) (hx : ‖x‖ ≠ 0) :
    2 * ‖x‖ *
        ((‖x‖ + ‖X - x‖) -
          inner Real X (‖x‖⁻¹ • x)) =
      (‖x‖ + ‖X - x‖) ^ 2 - ‖X‖ ^ 2 := by
  let r : Real := ‖x‖
  let s : Real := ‖X - x‖
  let u : _root_.Codex.Spherical.SurfaceCore.Euclidean 2 := r⁻¹ • x
  have hr : r ≠ 0 := by simpa only [r] using hx
  have hxu : x = r • u := by
    dsimp [u]
    rw [smul_smul, mul_inv_cancel₀ hr, one_smul]
  have hinner : inner Real X x = r * inner Real X u := by
    rw [hxu, inner_smul_right]
  have hnorm : s ^ 2 = ‖X‖ ^ 2 - 2 * inner Real X x + r ^ 2 := by
    simpa only [r, s] using norm_sub_sq_real X x
  change 2 * r * ((r + s) - inner Real X u) = (r + s) ^ 2 - ‖X‖ ^ 2
  rw [show inner Real X u = r⁻¹ * inner Real X x by
    dsimp [u]
    rw [inner_smul_right]]
  field_simp [hr]
  nlinarith [hnorm]

private theorem aux_twoCone_polar_solve_inner
    (X x : _root_.Codex.Spherical.SurfaceCore.Euclidean 2) (hx : ‖x‖ ≠ 0) :
    inner Real X (‖x‖⁻¹ • x) =
      (‖x‖ + ‖X - x‖) -
        ((‖x‖ + ‖X - x‖) ^ 2 - ‖X‖ ^ 2) / (2 * ‖x‖) := by
  have h := aux_twoCone_polar_identity X x hx
  have hden : 2 * ‖x‖ ≠ 0 := mul_ne_zero (by norm_num) hx
  field_simp [hden] at h ⊢
  linarith

/-- The output radial defect is exactly the squared chordal angular defect of
the two normalized inputs.  This is the quantitative invariant separating the
transverse and near-tangent branches. -/
private theorem aux_twoCone_angular_defect_identity
    (x y : _root_.Codex.Spherical.SurfaceCore.Euclidean 2)
    (hx : ‖x‖ ≠ 0) (hy : ‖y‖ ≠ 0) :
    (‖x‖ + ‖y‖) ^ 2 - ‖x + y‖ ^ 2 =
      ‖x‖ * ‖y‖ * ‖(‖x‖)⁻¹ • x - (‖y‖)⁻¹ • y‖ ^ 2 := by
  let r : Real := ‖x‖
  let s : Real := ‖y‖
  let u : _root_.Codex.Spherical.SurfaceCore.Euclidean 2 := r⁻¹ • x
  let v : _root_.Codex.Spherical.SurfaceCore.Euclidean 2 := s⁻¹ • y
  have hrpos : 0 < r := by
    dsimp [r]
    exact lt_of_le_of_ne (norm_nonneg _) (Ne.symm hx)
  have hspos : 0 < s := by
    dsimp [s]
    exact lt_of_le_of_ne (norm_nonneg _) (Ne.symm hy)
  have hr : r ≠ 0 := ne_of_gt hrpos
  have hs : s ≠ 0 := ne_of_gt hspos
  have hunitu : ‖u‖ = 1 := by
    change ‖r⁻¹ • x‖ = 1
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hrpos)]
    change r⁻¹ * r = 1
    field_simp [hr]
  have hunitv : ‖v‖ = 1 := by
    change ‖s⁻¹ • y‖ = 1
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hspos)]
    change s⁻¹ * s = 1
    field_simp [hs]
  have hxu : x = r • u := by
    dsimp [u]
    rw [smul_smul, mul_inv_cancel₀ hr, one_smul]
  have hyv : y = s • v := by
    dsimp [v]
    rw [smul_smul, mul_inv_cancel₀ hs, one_smul]
  have hru : ‖r • u‖ = r := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hrpos.le, hunitu, mul_one]
  have hsv : ‖s • v‖ = s := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hspos.le, hunitv, mul_one]
  have hinter : inner Real (r • u) (s • v) = r * s * inner Real u v := by
    rw [inner_smul_left, inner_smul_right]
    simp [mul_assoc]
  have hsum : ‖x + y‖ ^ 2 = r ^ 2 + 2 * r * s * inner Real u v + s ^ 2 := by
    calc
      ‖x + y‖ ^ 2 = ‖r • u + s • v‖ ^ 2 := by rw [hxu, hyv]
      _ = ‖r • u‖ ^ 2 + 2 * inner Real (r • u) (s • v) + ‖s • v‖ ^ 2 :=
        norm_add_sq_real _ _
      _ = r ^ 2 + 2 * r * s * inner Real u v + s ^ 2 := by
        rw [hru, hsv, hinter]
        ring
  have hsub : ‖u - v‖ ^ 2 = 2 - 2 * inner Real u v := by
    rw [norm_sub_sq_real, hunitu, hunitv]
    ring
  change (r + s) ^ 2 - ‖x + y‖ ^ 2 = r * s * ‖u - v‖ ^ 2
  rw [hsum, hsub]
  ring

/-- On either fixed oriented branch of the unit circle, controlling the
inner-product coordinate against a nonzero vector controls the direction.
This is the transverse half of the two-branch reduction. -/
private theorem aux_unit_same_area_branch_direction_bound
    (o : Orientation Real (_root_.Codex.Spherical.SurfaceCore.Euclidean 2) (Fin 2))
    {X u u' : _root_.Codex.Spherical.SurfaceCore.Euclidean 2} {A D : Real}
    (hX : 0 < ‖X‖) (hA : 0 < A)
    (hu : ‖u‖ = 1) (hu' : ‖u'‖ = 1)
    (harea : A ≤ |(o.areaForm X) u| ∧ A ≤ |(o.areaForm X) u'|)
    (hsign : (0 ≤ (o.areaForm X) u ∧ 0 ≤ (o.areaForm X) u') ∨
      ((o.areaForm X) u ≤ 0 ∧ (o.areaForm X) u' ≤ 0))
    (hinner : |inner Real X u - inner Real X u'| ≤ D) :
    ‖u - u'‖ ≤ D / ‖X‖ + D / A := by
  let N : Real := ‖X‖
  let c : Real := inner Real X u
  let c' : Real := inner Real X u'
  let a : Real := (o.areaForm X) u
  let a' : Real := (o.areaForm X) u'
  have hN : 0 < N := by simpa only [N] using hX
  have hcircle : c ^ 2 + a ^ 2 = N ^ 2 := by
    calc
      c ^ 2 + a ^ 2 = ‖X‖ ^ 2 * ‖u‖ ^ 2 := by
        simpa only [c, a] using o.inner_sq_add_areaForm_sq X u
      _ = N ^ 2 := by rw [hu]; simp only [N, one_pow, mul_one]
  have hcircle' : c' ^ 2 + a' ^ 2 = N ^ 2 := by
    calc
      c' ^ 2 + a' ^ 2 = ‖X‖ ^ 2 * ‖u'‖ ^ 2 := by
        simpa only [c', a'] using o.inner_sq_add_areaForm_sq X u'
      _ = N ^ 2 := by rw [hu']; simp only [N, one_pow, mul_one]
  have hc : |c| ≤ N := by
    simpa only [N, c, hu, mul_one] using abs_real_inner_le_norm X u
  have hc' : |c'| ≤ N := by
    simpa only [N, c', hu', mul_one] using abs_real_inner_le_norm X u'
  have hsumc : |c + c'| ≤ 2 * N := by
    calc
      |c + c'| ≤ |c| + |c'| := abs_add_le _ _
      _ ≤ N + N := add_le_add hc hc'
      _ = 2 * N := by ring
  have hsumapos : 2 * A ≤ |a + a'| := by
    rcases hsign with hnonneg | hnonpos
    · have hnonneg' : 0 ≤ a ∧ 0 ≤ a' := by
        simpa only [a, a'] using hnonneg
      change A ≤ |a| ∧ A ≤ |a'| at harea
      rw [abs_of_nonneg hnonneg'.1, abs_of_nonneg hnonneg'.2] at harea
      rw [abs_of_nonneg (add_nonneg hnonneg'.1 hnonneg'.2)]
      linarith [harea.1, harea.2]
    · have hnonpos' : a ≤ 0 ∧ a' ≤ 0 := by
        simpa only [a, a'] using hnonpos
      change A ≤ |a| ∧ A ≤ |a'| at harea
      rw [abs_of_nonpos hnonpos'.1, abs_of_nonpos hnonpos'.2] at harea
      rw [abs_of_nonpos (add_nonpos hnonpos'.1 hnonpos'.2)]
      linarith [harea.1, harea.2]
  have hprod : |a - a'| * |a + a'| = |c - c'| * |c + c'| := by
    rw [← abs_mul, ← abs_mul]
    have hfactor : (a - a') * (a + a') = -((c - c') * (c + c')) := by
      nlinarith [hcircle, hcircle']
    rw [hfactor, abs_neg]
  have hdiffc : |c - c'| ≤ D := by
    simpa only [c, c', sub_eq_add_neg, abs_neg] using hinner
  have hDnonneg : 0 ≤ D := le_trans (abs_nonneg _) hdiffc
  have hareaTimes : |a - a'| * (2 * A) ≤ D * (2 * N) := by
    calc
      |a - a'| * (2 * A) ≤ |a - a'| * |a + a'| := by
        gcongr
      _ = |c - c'| * |c + c'| := hprod
      _ ≤ D * (2 * N) := by gcongr
  have haDiff : |a - a'| ≤ D * N / A := by
    have hAne : A ≠ 0 := ne_of_gt hA
    field_simp [hAne]
    nlinarith [hareaTimes]
  have hinter : c * c' + a * a' = N ^ 2 * inner Real u u' := by
    simpa only [N, c, c', a, a'] using o.inner_mul_inner_add_areaForm_mul_areaForm X u u'
  have hmetric : N ^ 2 * ‖u - u'‖ ^ 2 = (c - c') ^ 2 + (a - a') ^ 2 := by
    rw [norm_sub_sq_real, hu, hu']
    nlinarith [hcircle, hcircle', hinter]
  have hnonneg : 0 ≤ |c - c'| + |a - a'| := add_nonneg (abs_nonneg _) (abs_nonneg _)
  have hsquare : ‖u - u'‖ ^ 2 ≤ ((|c - c'| + |a - a'|) / N) ^ 2 := by
    have hsumSquares : (c - c') ^ 2 + (a - a') ^ 2 ≤
        (|c - c'| + |a - a'|) ^ 2 := by
      nlinarith [sq_abs (c - c'), sq_abs (a - a'),
        abs_nonneg (c - c'), abs_nonneg (a - a')]
    have hNne : N ≠ 0 := ne_of_gt hN
    field_simp [hNne]
    nlinarith [hmetric, hsumSquares]
  have hdirection : ‖u - u'‖ ≤ (|c - c'| + |a - a'|) / N := by
    apply (sq_le_sq₀ (norm_nonneg _) (div_nonneg hnonneg hN.le)).mp
    exact hsquare
  calc
    ‖u - u'‖ ≤ (|c - c'| + |a - a'|) / N := hdirection
    _ ≤ (D + D * N / A) / N := by gcongr
    _ = D / N + D / A := by
      field_simp [ne_of_gt hN, ne_of_gt hA]
    _ = D / ‖X‖ + D / A := by rfl

/-- Normalizing a vector which is close to a positive multiple of a unit
direction changes it by at most twice the relative approximation error. -/
private theorem aux_normalized_sub_unit_le_two_mul_error_div
    {x u : _root_.Codex.Spherical.SurfaceCore.Euclidean 2} {a e : Real}
    (hx : x ≠ 0) (ha : 0 < a) (hu : ‖u‖ = 1)
    (happrox : ‖x - a • u‖ ≤ e) :
    ‖(‖x‖)⁻¹ • x - u‖ ≤ 2 * e / a := by
  let N : Real := ‖x‖
  have hN : 0 < N := by
    change 0 < ‖x‖
    exact norm_pos_iff.mpr hx
  have hNne : N ≠ 0 := ne_of_gt hN
  have hane : a ≠ 0 := ne_of_gt ha
  have hnormau : ‖a • u‖ = a := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos ha, hu, mul_one]
  have hradial : |N - a| ≤ e := by
    change |‖x‖ - a| ≤ e
    calc
      |‖x‖ - a| = |‖x‖ - ‖a • u‖| := by rw [hnormau]
      _ ≤ ‖x - a • u‖ := abs_norm_sub_norm_le _ _
      _ ≤ e := happrox
  have hdecomp :
      N⁻¹ • x - u = (N⁻¹ - a⁻¹) • x + a⁻¹ • (x - a • u) := by
    calc
      N⁻¹ • x - u = N⁻¹ • x - (a⁻¹ * a) • u := by
        rw [inv_mul_cancel₀ hane, one_smul]
      _ = N⁻¹ • x - a⁻¹ • (a • u) := by rw [smul_smul]
      _ = (N⁻¹ - a⁻¹) • x + a⁻¹ • (x - a • u) := by
        rw [sub_smul, smul_sub]
        abel
  have hinv : |N⁻¹ - a⁻¹| * N = |N - a| / a := by
    have hformula : N⁻¹ - a⁻¹ = (a - N) / (N * a) := by
      field_simp [hNne, hane]
    rw [hformula, abs_div]
    rw [abs_of_pos (mul_pos hN ha), abs_sub_comm]
    field_simp [hNne, hane]
  have hnormx : ‖x‖ = N := rfl
  have hinva : ‖a⁻¹‖ = a⁻¹ := by
    rw [Real.norm_eq_abs, abs_of_pos (inv_pos.mpr ha)]
  calc
    ‖(‖x‖)⁻¹ • x - u‖ = ‖N⁻¹ • x - u‖ := by rfl
    _ = ‖(N⁻¹ - a⁻¹) • x + a⁻¹ • (x - a • u)‖ := by rw [hdecomp]
    _ ≤ ‖(N⁻¹ - a⁻¹) • x‖ + ‖a⁻¹ • (x - a • u)‖ := norm_add_le _ _
    _ = |N⁻¹ - a⁻¹| * N + a⁻¹ * ‖x - a • u‖ := by
      rw [norm_smul, norm_smul, Real.norm_eq_abs, hnormx, hinva]
    _ = |N - a| / a + a⁻¹ * ‖x - a • u‖ := by rw [hinv]
    _ ≤ e / a + a⁻¹ * e := by gcongr
    _ = 2 * e / a := by
      field_simp [hane]
      ring

/-- Exact chord--area relation for two unit directions in the plane. -/
private theorem aux_unit_area_sq_eq_chord
    (o : Orientation Real (_root_.Codex.Spherical.SurfaceCore.Euclidean 2) (Fin 2))
    {u v : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hu : ‖u‖ = 1) (hv : ‖v‖ = 1) :
    ((o.areaForm u) v) ^ 2 =
      ‖u - v‖ ^ 2 * (1 - ‖u - v‖ ^ 2 / 4) := by
  have harea := o.inner_sq_add_areaForm_sq u v
  have hsub := norm_sub_sq_real u v
  rw [hu, hv] at harea hsub
  nlinarith [harea, hsub]

private theorem aux_unit_chord_le_two_mul_abs_area_of_norm_sub_le_one
    (o : Orientation Real (_root_.Codex.Spherical.SurfaceCore.Euclidean 2) (Fin 2))
    {u v : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hu : ‖u‖ = 1) (hv : ‖v‖ = 1) (hclose : ‖u - v‖ ≤ 1) :
    ‖u - v‖ ≤ 2 * |(o.areaForm u) v| := by
  have harea := aux_unit_area_sq_eq_chord o hu hv
  have hnorm : 0 ≤ ‖u - v‖ := norm_nonneg _
  have hcloseSq : ‖u - v‖ ^ 2 ≤ 1 := by
    have hprod := mul_nonneg hnorm (sub_nonneg.mpr hclose)
    nlinarith
  have hthree : 0 ≤ 3 - ‖u - v‖ ^ 2 := by linarith
  have hfactor : 0 ≤ ‖u - v‖ ^ 2 * (3 - ‖u - v‖ ^ 2) :=
    mul_nonneg (sq_nonneg _) hthree
  have hsq : ‖u - v‖ ^ 2 ≤ (2 * |(o.areaForm u) v|) ^ 2 := by
    nlinarith [harea, sq_abs ((o.areaForm u) v)]
  apply (sq_le_sq₀ hnorm (by positivity)).mp
  exact hsq

private theorem aux_area_sum_right
    (o : Orientation Real (_root_.Codex.Spherical.SurfaceCore.Euclidean 2) (Fin 2))
    (r s : Real) (u v : _root_.Codex.Spherical.SurfaceCore.Euclidean 2) :
    (o.areaForm (r • u + s • v)) u = s * (o.areaForm v) u := by
  rw [map_add, map_smul, map_smul]
  change r * (o.areaForm u) u + s * (o.areaForm v) u = s * (o.areaForm v) u
  rw [o.areaForm_apply_self, mul_zero, zero_add]

private theorem aux_two_mul_sqrt_div_sum_le_scaled
    {scale r s C : Real} (hscale : 0 < scale) (hC : 0 ≤ C)
    (hr : scale / 4 ≤ r) (hs : scale / 4 ≤ s) :
    2 * (2 * C * Real.sqrt scale) / (r + s) ≤
      8 * C * scale ^ (-(1 / 2 : Real)) := by
  have hsum : scale / 2 ≤ r + s := by linarith
  have hsumpos : 0 < r + s := by linarith
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  have hrpow : scale ^ (-(1 / 2 : Real)) * scale = Real.sqrt scale := by
    calc
      scale ^ (-(1 / 2 : Real)) * scale =
          scale ^ (-(1 / 2 : Real)) * scale ^ (1 : Real) := by rw [Real.rpow_one]
      _ = scale ^ (-(1 / 2 : Real) + (1 : Real)) :=
        (Real.rpow_add hscale _ _).symm
      _ = Real.sqrt scale := by
        convert (Real.sqrt_eq_rpow scale).symm using 1 <;> norm_num
  apply (div_le_iff₀ hsumpos).mpr
  calc
    2 * (2 * C * Real.sqrt scale) =
        (8 * C * scale ^ (-(1 / 2 : Real))) * (scale / 2) := by
      rw [← hrpow]
      ring
    _ ≤ (8 * C * scale ^ (-(1 / 2 : Real))) * (r + s) := by
      gcongr

/-- Small output-oriented area is the tangent alternative: because both
input radii are elliptic-scale, the first normalized input lies in one
`O(scale⁻¹ᐟ²)` cap about the normalized output direction. -/
private theorem aux_tangent_cap_of_small_area
    (o : Orientation Real (_root_.Codex.Spherical.SurfaceCore.Euclidean 2) (Fin 2))
    {scale r s C : Real} {X u v : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hscale : 0 < scale) (hC : 0 ≤ C)
    (hr : scale / 4 ≤ r) (hs : scale / 4 ≤ s)
    (hX : X = r • u + s • v) (hXnonzero : X ≠ 0)
    (hu : ‖u‖ = 1) (hv : ‖v‖ = 1) (hclose : ‖u - v‖ ≤ 1)
    (hsmall : |(o.areaForm X) u| ≤ C * Real.sqrt scale) :
    ‖(‖X‖)⁻¹ • X - u‖ ≤ 8 * C * scale ^ (-(1 / 2 : Real)) := by
  have hsnonneg : 0 ≤ s := by linarith
  have hsumpos : 0 < r + s := by linarith
  have hareaX : (o.areaForm X) u = s * (o.areaForm v) u := by
    rw [hX]
    exact aux_area_sum_right o r s u v
  have hchord : ‖u - v‖ ≤ 2 * |(o.areaForm v) u| := by
    have h := aux_unit_chord_le_two_mul_abs_area_of_norm_sub_le_one o hu hv hclose
    have hswap : |(o.areaForm u) v| = |(o.areaForm v) u| := by
      rw [o.areaForm_swap, abs_neg]
    rw [hswap] at h
    exact h
  have hsd : s * ‖u - v‖ ≤ 2 * |(o.areaForm X) u| := by
    calc
      s * ‖u - v‖ ≤ s * (2 * |(o.areaForm v) u|) :=
        mul_le_mul_of_nonneg_left hchord hsnonneg
      _ = 2 * |s * (o.areaForm v) u| := by
        rw [abs_mul, abs_of_nonneg hsnonneg]
        ring
      _ = 2 * |(o.areaForm X) u| := by rw [← hareaX]
  have hsdsmall : s * ‖u - v‖ ≤ 2 * C * Real.sqrt scale := by
    calc
      s * ‖u - v‖ ≤ 2 * |(o.areaForm X) u| := hsd
      _ ≤ 2 * (C * Real.sqrt scale) := by gcongr
      _ = 2 * C * Real.sqrt scale := by ring
  have hsub : X - (r + s) • u = s • (v - u) := by
    rw [hX, add_smul, smul_sub]
    abel
  have happrox : ‖X - (r + s) • u‖ ≤ s * ‖u - v‖ := by
    calc
      ‖X - (r + s) • u‖ = ‖s • (v - u)‖ := by rw [hsub]
      _ = s * ‖v - u‖ := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hsnonneg]
      _ = s * ‖u - v‖ := by rw [norm_sub_rev]
      _ ≤ s * ‖u - v‖ := le_rfl
  have hnormal := aux_normalized_sub_unit_le_two_mul_error_div
    hXnonzero hsumpos hu happrox
  calc
    ‖(‖X‖)⁻¹ • X - u‖ ≤ 2 * (s * ‖u - v‖) / (r + s) := hnormal
    _ ≤ 2 * (2 * C * Real.sqrt scale) / (r + s) := by gcongr
    _ ≤ 8 * C * scale ^ (-(1 / 2 : Real)) :=
      aux_two_mul_sqrt_div_sum_le_scaled hscale hC hr hs

/-- In the transverse alternative, a lower chordal separation of the two
normalized inputs forces output-oriented area of order `sqrt scale`. -/
private theorem aux_transverse_area_lower_of_chord_lower
    (o : Orientation Real (_root_.Codex.Spherical.SurfaceCore.Euclidean 2) (Fin 2))
    {scale r s lambda : Real} {X u v : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hscale : 0 < scale) (hs : scale / 4 ≤ s) (hlambda : 0 ≤ lambda)
    (hX : X = r • u + s • v)
    (hu : ‖u‖ = 1) (hv : ‖v‖ = 1) (hclose : ‖u - v‖ ≤ 1)
    (hgap : lambda * scale ^ (-(1 / 2 : Real)) ≤ ‖u - v‖) :
    lambda * Real.sqrt scale / 8 ≤ |(o.areaForm X) u| := by
  have hsnonneg : 0 ≤ s := by linarith
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  have hrpow : scale ^ (-(1 / 2 : Real)) * scale = Real.sqrt scale := by
    calc
      scale ^ (-(1 / 2 : Real)) * scale =
          scale ^ (-(1 / 2 : Real)) * scale ^ (1 : Real) := by rw [Real.rpow_one]
      _ = scale ^ (-(1 / 2 : Real) + (1 : Real)) :=
        (Real.rpow_add hscale _ _).symm
      _ = Real.sqrt scale := by
        convert (Real.sqrt_eq_rpow scale).symm using 1 <;> norm_num
  have hareaX : (o.areaForm X) u = s * (o.areaForm v) u := by
    rw [hX]
    exact aux_area_sum_right o r s u v
  have hchord : ‖u - v‖ ≤ 2 * |(o.areaForm v) u| := by
    have h := aux_unit_chord_le_two_mul_abs_area_of_norm_sub_le_one o hu hv hclose
    have hswap : |(o.areaForm u) v| = |(o.areaForm v) u| := by
      rw [o.areaForm_swap, abs_neg]
    rw [hswap] at h
    exact h
  have hsd : s * ‖u - v‖ ≤ 2 * |(o.areaForm X) u| := by
    calc
      s * ‖u - v‖ ≤ s * (2 * |(o.areaForm v) u|) :=
        mul_le_mul_of_nonneg_left hchord hsnonneg
      _ = 2 * |s * (o.areaForm v) u| := by
        rw [abs_mul, abs_of_nonneg hsnonneg]
        ring
      _ = 2 * |(o.areaForm X) u| := by rw [← hareaX]
  have hscaled : (scale / 4) * (lambda * scale ^ (-(1 / 2 : Real))) ≤
      2 * |(o.areaForm X) u| := by
    calc
      (scale / 4) * (lambda * scale ^ (-(1 / 2 : Real))) ≤
          s * (lambda * scale ^ (-(1 / 2 : Real))) := by
        gcongr
      _ ≤ s * ‖u - v‖ := mul_le_mul_of_nonneg_left hgap hsnonneg
      _ ≤ 2 * |(o.areaForm X) u| := hsd
  have hrewrite :
      (scale / 4) * (lambda * scale ^ (-(1 / 2 : Real))) =
        lambda * Real.sqrt scale / 4 := by
    rw [← hrpow]

    ring
  rw [hrewrite] at hscaled
  linarith

private theorem aux_chord_lower_of_center_direction_bounds
    {h L A : Real} {a b u v : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hcenters : L * h ≤ ‖a - b‖)
    (hu : ‖u - a‖ ≤ A * h) (hv : ‖v - b‖ ≤ A * h) :
    (L - 2 * A) * h ≤ ‖u - v‖ := by
  have htriangle : ‖a - b‖ ≤ ‖a - u‖ + ‖u - v‖ + ‖v - b‖ := by
    calc
      ‖a - b‖ = ‖(a - u) + (u - v) + (v - b)‖ := by congr 1 <;> abel
      _ ≤ ‖(a - u) + (u - v)‖ + ‖v - b‖ := norm_add_le _ _
      _ ≤ ‖a - u‖ + ‖u - v‖ + ‖v - b‖ := by
        gcongr
        exact norm_add_le _ _
  rw [norm_sub_rev] at hu
  nlinarith [hcenters, htriangle, hu, hv]

private theorem aux_chord_upper_of_center_direction_bounds
    {h U A : Real} {a b u v : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hcenters : ‖a - b‖ ≤ U * h)
    (hu : ‖u - a‖ ≤ A * h) (hv : ‖v - b‖ ≤ A * h) :
    ‖u - v‖ ≤ (U + 2 * A) * h := by
  have htriangle : ‖u - v‖ ≤ ‖u - a‖ + ‖a - b‖ + ‖b - v‖ := by
    calc
      ‖u - v‖ = ‖(u - a) + (a - b) + (b - v)‖ := by congr 1 <;> abel
      _ ≤ ‖(u - a) + (a - b)‖ + ‖b - v‖ := norm_add_le _ _
      _ ≤ ‖u - a‖ + ‖a - b‖ + ‖b - v‖ := by
        gcongr
        exact norm_add_le _ _
  rw [norm_sub_rev] at hv
  nlinarith [hcenters, htriangle, hu, hv]

private theorem aux_output_normalized_cap_of_chord_upper
    {scale r s B : Real} {X u v : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hscale : 0 < scale) (hB : 0 ≤ B)
    (hr : scale / 4 ≤ r) (hs : scale / 4 ≤ s) (hsupper : s ≤ 4 * scale)
    (hX : X = r • u + s • v) (hXnonzero : X ≠ 0) (hu : ‖u‖ = 1)
    (hchord : ‖u - v‖ ≤ B * scale ^ (-(1 / 2 : Real))) :
    ‖(‖X‖)⁻¹ • X - u‖ ≤ 16 * B * scale ^ (-(1 / 2 : Real)) := by
  have hsnonneg : 0 ≤ s := by linarith
  have hsumpos : 0 < r + s := by linarith
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  have hrpow : scale ^ (-(1 / 2 : Real)) * scale = Real.sqrt scale := by
    calc
      scale ^ (-(1 / 2 : Real)) * scale =
          scale ^ (-(1 / 2 : Real)) * scale ^ (1 : Real) := by rw [Real.rpow_one]
      _ = scale ^ (-(1 / 2 : Real) + (1 : Real)) :=
        (Real.rpow_add hscale _ _).symm
      _ = Real.sqrt scale := by
        convert (Real.sqrt_eq_rpow scale).symm using 1 <;> norm_num
  have hsub : X - (r + s) • u = s • (v - u) := by
    rw [hX, add_smul, smul_sub]
    abel
  have happrox : ‖X - (r + s) • u‖ ≤ s * ‖u - v‖ := by
    calc
      ‖X - (r + s) • u‖ = ‖s • (v - u)‖ := by rw [hsub]
      _ = s * ‖v - u‖ := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hsnonneg]
      _ = s * ‖u - v‖ := by rw [norm_sub_rev]
      _ ≤ s * ‖u - v‖ := le_rfl
  have herror : s * ‖u - v‖ ≤ 4 * B * Real.sqrt scale := by
    calc
      s * ‖u - v‖ ≤ s * (B * scale ^ (-(1 / 2 : Real))) :=
        mul_le_mul_of_nonneg_left hchord hsnonneg
      _ ≤ (4 * scale) * (B * scale ^ (-(1 / 2 : Real))) := by
        gcongr
      _ = 4 * B * Real.sqrt scale := by
        rw [← hrpow]
        ring
  have hnormal := aux_normalized_sub_unit_le_two_mul_error_div
    hXnonzero hsumpos hu happrox
  calc
    ‖(‖X‖)⁻¹ • X - u‖ ≤ 2 * (s * ‖u - v‖) / (r + s) := hnormal
    _ ≤ 2 * (4 * B * Real.sqrt scale) / (r + s) := by gcongr
    _ = 2 * (2 * (2 * B) * Real.sqrt scale) / (r + s) := by ring
    _ ≤ 8 * (2 * B) * scale ^ (-(1 / 2 : Real)) :=
      aux_two_mul_sqrt_div_sum_le_scaled hscale (by positivity) hr hs
    _ = 16 * B * scale ^ (-(1 / 2 : Real)) := by ring

/-- Stability of the polar inner-product coordinate under coupled changes in
the total radius and the first radius.  The two error terms are exactly the
ones supplied by the normal/time and radial plate windows. -/
private theorem aux_polar_inner_coordinate_difference_bound
    {r r' tau tau' defect defect' : Real}
    (hr : 0 < r) (hr' : 0 < r') (hdefect' : 0 ≤ defect') :
    |(tau - defect / (2 * r)) - (tau' - defect' / (2 * r'))| ≤
      |tau - tau'| + |defect - defect'| / (2 * r) +
        defect' * |r - r'| / (2 * r * r') := by
  have hrne : r ≠ 0 := ne_of_gt hr
  have hr'ne : r' ≠ 0 := ne_of_gt hr'
  have hden : 0 < 2 * r := by positivity
  have hden' : 0 < 2 * r * r' := by positivity
  have hid : defect / (2 * r) - defect' / (2 * r') =
      (defect - defect') / (2 * r) +
        defect' * (r' - r) / (2 * r * r') := by
    field_simp [hrne, hr'ne]
    ring
  calc
    |(tau - defect / (2 * r)) - (tau' - defect' / (2 * r'))| =
        |(tau - tau') -
          ((defect - defect') / (2 * r) +
            defect' * (r' - r) / (2 * r * r'))| := by
      rw [sub_sub_sub_comm, hid]
    _ ≤ |tau - tau'| +
        |(defect - defect') / (2 * r) +
          defect' * (r' - r) / (2 * r * r')| := by
      calc
        |(tau - tau') -
            ((defect - defect') / (2 * r) +
              defect' * (r' - r) / (2 * r * r'))| ≤
            |(tau - tau') - 0| +
              |0 - ((defect - defect') / (2 * r) +
                defect' * (r' - r) / (2 * r * r'))| :=
          abs_sub_le _ _ _
        _ = |tau - tau'| +
            |(defect - defect') / (2 * r) +
              defect' * (r' - r) / (2 * r * r')| := by
          rw [sub_zero, zero_sub, abs_neg]
    _ ≤ |tau - tau'| + |(defect - defect') / (2 * r)| +
        |defect' * (r' - r) / (2 * r * r')| := by
      simpa only [add_comm, add_left_comm, add_assoc] using
        add_le_add_left
          (abs_add_le ((defect - defect') / (2 * r))
            (defect' * (r' - r) / (2 * r * r')))
          |tau - tau'|
    _ = |tau - tau'| + |defect - defect'| / (2 * r) +
        defect' * |r - r'| / (2 * r * r') := by
      rw [abs_div, abs_of_pos hden, abs_div, abs_mul, abs_of_nonneg hdefect',
        abs_of_pos hden']
      rw [show |r' - r| = |r - r'| by exact abs_sub_comm _ _]

private theorem aux_abs_sub_le_two_mul_common_window
    {a b center E : Real} (ha : |a - center| ≤ E) (hb : |b - center| ≤ E) :
    |a - b| ≤ 2 * E := by
  calc
    |a - b| ≤ |a - center| + |center - b| := abs_sub_le _ _ _
    _ = |a - center| + |b - center| := by
      exact congrArg (fun q : Real => |a - center| + q) (abs_sub_comm center b)
    _ ≤ E + E := add_le_add ha hb
    _ = 2 * E := by ring

private theorem aux_radial_window_difference_le_six_sqrt
    {scale r r' center : Real} (hscale : 2 ≤ scale)
    (hr : |r - center| ≤ Real.sqrt scale + 2)
    (hr' : |r' - center| ≤ Real.sqrt scale + 2) :
    |r - r'| ≤ 6 * Real.sqrt scale := by
  have hsqrt : 1 ≤ Real.sqrt scale := by
    rw [← Real.sqrt_one]
    exact Real.sqrt_le_sqrt (le_trans (by norm_num) hscale)
  have hdiff := aux_abs_sub_le_two_mul_common_window hr hr'
  nlinarith

/-- The literal unit-normal windows for two summands with the same output
give a scale-free bound for the difference of their total radii. -/
private theorem aux_total_radius_difference_le_eight
    {a b center : Real} (ha : |a - center| ≤ 4) (hb : |b - center| ≤ 4) :
    |a - b| ≤ 8 := by
  have h := aux_abs_sub_le_two_mul_common_window ha hb
  norm_num at h ⊢
  exact h

private theorem aux_sum_radius_bounds
    {scale r s : Real} (hscale : 0 ≤ scale)
    (hrlo : scale / 4 ≤ r) (hrhi : r ≤ 4 * scale)
    (hslo : scale / 4 ≤ s) (hshi : s ≤ 4 * scale) :
    scale / 2 ≤ r + s ∧ r + s ≤ 8 * scale := by
  constructor <;> nlinarith

/-- Squared total-radius defects of two active pairs sharing an output differ
by at most `128 * scale` once each total radius lies in `[scale/2, 8 scale]`
and the normal-coordinate windows give a difference at most eight. -/
private theorem aux_defect_difference_le_one_twenty_eight_mul_scale
    {scale tau tau' Xnorm : Real} (hscale : 0 ≤ scale)
    (htau : 0 ≤ tau) (htau' : 0 ≤ tau')
    (htauupper : tau ≤ 8 * scale) (htau'upper : tau' ≤ 8 * scale)
    (hdiff : |tau - tau'| ≤ 8) :
    |(tau ^ 2 - Xnorm ^ 2) - (tau' ^ 2 - Xnorm ^ 2)| ≤ 128 * scale := by
  have hsum : |tau + tau'| ≤ 16 * scale := by
    rw [abs_of_nonneg (by linarith)]
    linarith
  have hfactor :
      |(tau ^ 2 - Xnorm ^ 2) - (tau' ^ 2 - Xnorm ^ 2)| =
        |tau - tau'| * |tau + tau'| := by
    rw [← abs_mul]
    congr 1
    ring
  rw [hfactor]
  calc
    |tau - tau'| * |tau + tau'| ≤ 8 * (16 * scale) :=
      mul_le_mul hdiff hsum (abs_nonneg _) (by norm_num)
    _ = 128 * scale := by ring

/-- Direct polar-coordinate stability for two literal plate witnesses.  The
three terms are respectively the normal/time window, the resulting total
radius-defect window, and the radial-label window. -/
private theorem aux_polar_inner_coordinate_difference_le_constant
    {scale r r' tau tau' defect defect' B : Real}
    (hscale : 2 ≤ scale)
    (hr : scale / 4 ≤ r) (hr' : scale / 4 ≤ r')
    (htau : |tau - tau'| ≤ 8)
    (hdefect : |defect - defect'| ≤ 128 * scale)
    (hdefect'nonneg : 0 ≤ defect')
    (hdefect'upper : defect' ≤ 16 * B ^ 2 * scale)
    (hradial : |r - r'| ≤ 6 * Real.sqrt scale) :
    |(tau - defect / (2 * r)) - (tau' - defect' / (2 * r'))| ≤
      264 + 768 * B ^ 2 * scale ^ (-(1 / 2 : Real)) := by
  have hscalepos : 0 < scale := by linarith
  have hrpos : 0 < r := by linarith
  have hr'pos : 0 < r' := by linarith
  have hsqrtnonneg : 0 ≤ Real.sqrt scale := Real.sqrt_nonneg _
  have hrpow : scale ^ (-(1 / 2 : Real)) * scale = Real.sqrt scale := by
    calc
      scale ^ (-(1 / 2 : Real)) * scale =
          scale ^ (-(1 / 2 : Real)) * scale ^ (1 : Real) := by rw [Real.rpow_one]
      _ = scale ^ (-(1 / 2 : Real) + (1 : Real)) :=
        (Real.rpow_add hscalepos _ _).symm
      _ = Real.sqrt scale := by
        convert (Real.sqrt_eq_rpow scale).symm using 1 <;> norm_num
  have hrr : scale ^ 2 / 16 ≤ r * r' := by
    have hmul := mul_le_mul hr hr' (by linarith : 0 ≤ scale / 4) (by linarith : 0 ≤ r)
    nlinarith [hmul]
  have hterm₂ : |defect - defect'| / (2 * r) ≤ 256 := by
    have hden : 0 < 2 * r := by positivity
    calc
      |defect - defect'| / (2 * r) ≤ (128 * scale) / (2 * r) :=
        div_le_div_of_nonneg_right hdefect hden.le
      _ ≤ 256 := by
        apply (div_le_iff₀ hden).mpr
        nlinarith
  have hterm₃ : defect' * |r - r'| / (2 * r * r') ≤
      768 * B ^ 2 * scale ^ (-(1 / 2 : Real)) := by
    have hden : 0 < 2 * r * r' := by positivity
    have hupper : 0 ≤ 16 * B ^ 2 * scale := by positivity
    have hnum : defect' * |r - r'| ≤
        (16 * B ^ 2 * scale) * (6 * Real.sqrt scale) :=
      by exact mul_le_mul hdefect'upper hradial (abs_nonneg _) hupper
    calc
      defect' * |r - r'| / (2 * r * r') ≤
          ((16 * B ^ 2 * scale) * (6 * Real.sqrt scale)) / (2 * r * r') :=
        div_le_div_of_nonneg_right hnum hden.le
      _ ≤ 768 * B ^ 2 * scale ^ (-(1 / 2 : Real)) := by
        apply (div_le_iff₀ hden).mpr
        calc
          (16 * B ^ 2 * scale) * (6 * Real.sqrt scale) ≤
              96 * B ^ 2 * (scale * Real.sqrt scale) := by
            nlinarith
          _ = (768 * B ^ 2 * scale ^ (-(1 / 2 : Real))) *
              (2 * (scale ^ 2 / 16)) := by
            rw [show scale * Real.sqrt scale =
              scale ^ (-(1 / 2 : Real)) * scale ^ 2 by
                calc
                  scale * Real.sqrt scale = Real.sqrt scale * scale := mul_comm _ _
                  _ = (scale ^ (-(1 / 2 : Real)) * scale) * scale := by rw [hrpow]
                  _ = scale ^ (-(1 / 2 : Real)) * scale ^ 2 := by ring]
            ring
          _ ≤ (768 * B ^ 2 * scale ^ (-(1 / 2 : Real))) *
              (2 * (r * r')) := by gcongr
          _ = (768 * B ^ 2 * scale ^ (-(1 / 2 : Real))) *
              (2 * r * r') := by ring
  calc
    |(tau - defect / (2 * r)) - (tau' - defect' / (2 * r'))| ≤
        |tau - tau'| + |defect - defect'| / (2 * r) +
          defect' * |r - r'| / (2 * r * r') :=
      aux_polar_inner_coordinate_difference_bound hrpos hr'pos hdefect'nonneg
    _ ≤ 8 + 256 + 768 * B ^ 2 * scale ^ (-(1 / 2 : Real)) := by gcongr
    _ = 264 + 768 * B ^ 2 * scale ^ (-(1 / 2 : Real)) := by ring

/-- An angular chord of size `B * scale⁻¹ᐟ²` gives a defect of order
`B² * scale` on the literal dyadic annulus. -/
private theorem aux_defect_upper_of_chord_upper
    {scale r s defect B chord : Real}
    (hscale : 0 < scale) (hB : 0 ≤ B)
    (hrnonneg : 0 ≤ r) (hsnonneg : 0 ≤ s)
    (hrupper : r ≤ 4 * scale) (hsupper : s ≤ 4 * scale)
    (hdefect : defect = r * s * chord ^ 2)
    (hchord : chord ≤ B * scale ^ (-(1 / 2 : Real)))
    (hchordnonneg : 0 ≤ chord) :
    defect ≤ 16 * B ^ 2 * scale := by
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  have hright : 0 ≤ B * scale ^ (-(1 / 2 : Real)) := mul_nonneg hB hpow
  have hchordSq : chord ^ 2 ≤ (B * scale ^ (-(1 / 2 : Real))) ^ 2 := by
    exact (sq_le_sq₀ hchordnonneg hright).mpr hchord
  have hrs : r * s ≤ (4 * scale) * (4 * scale) :=
    mul_le_mul hrupper hsupper hsnonneg (by positivity)
  have hprod : r * s * chord ^ 2 ≤
      ((4 * scale) * (4 * scale)) *
        (B * scale ^ (-(1 / 2 : Real))) ^ 2 := by
    exact mul_le_mul hrs hchordSq (sq_nonneg _) (by positivity)
  have hsqrt : (Real.sqrt scale) ^ 2 = scale := Real.sq_sqrt hscale.le
  have hinv : Real.sqrt scale * scale ^ (-(1 / 2 : Real)) = 1 := by
    calc
      Real.sqrt scale * scale ^ (-(1 / 2 : Real)) =
          scale ^ (1 / 2 : Real) * scale ^ (-(1 / 2 : Real)) := by
            rw [← Real.sqrt_eq_rpow]
      _ = scale ^ ((1 / 2 : Real) + (-(1 / 2 : Real))) :=
        (Real.rpow_add hscale _ _).symm
      _ = 1 := by norm_num
  have hscalePow : scale ^ 2 * (scale ^ (-(1 / 2 : Real))) ^ 2 = scale := by
    calc
      scale ^ 2 * (scale ^ (-(1 / 2 : Real))) ^ 2 =
          ((Real.sqrt scale) ^ 2) ^ 2 *
            (scale ^ (-(1 / 2 : Real))) ^ 2 := by rw [hsqrt]
      _ = (Real.sqrt scale) ^ 2 *
            (Real.sqrt scale * scale ^ (-(1 / 2 : Real))) ^ 2 := by
              ring
      _ = (Real.sqrt scale) ^ 2 := by rw [hinv, one_pow, mul_one]
      _ = scale := hsqrt
  calc
    defect = r * s * chord ^ 2 := hdefect
    _ ≤ ((4 * scale) * (4 * scale)) *
        (B * scale ^ (-(1 / 2 : Real))) ^ 2 := hprod
    _ = 16 * B ^ 2 * (scale ^ 2 * (scale ^ (-(1 / 2 : Real))) ^ 2) := by ring
    _ = 16 * B ^ 2 * scale := by rw [hscalePow]

private theorem aux_real_inner_ge_seven_eighth_of_unit_dist_le_half
    {c u : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hc : ‖c‖ = 1) (hu : ‖u‖ = 1) (huc : ‖u - c‖ ≤ 1 / 2) :
    7 / 8 ≤ inner Real c u := by
  have hsq := norm_sub_sq_real c u
  rw [hc, hu] at hsq
  have hnonneg : 0 ≤ ‖u - c‖ := norm_nonneg _
  have hsubsq : ‖c - u‖ ^ 2 ≤ 1 / 4 := by
    rw [norm_sub_rev]
    nlinarith
  nlinarith

/-- A common unit-sector centre keeps a positive weighted sum away from the
origin once both normalized summands are within one half of that centre. -/
private theorem aux_weighted_unit_sum_norm_lower_of_common_center
    {r s : Real} {c u v : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hc : ‖c‖ = 1) (hu : ‖u‖ = 1) (hv : ‖v‖ = 1)
    (huc : ‖u - c‖ ≤ 1 / 2) (hvc : ‖v - c‖ ≤ 1 / 2)
    (hr : 0 ≤ r) (hs : 0 ≤ s) :
    (r + s) / 2 ≤ ‖r • u + s • v‖ := by
  have hinneru : 7 / 8 ≤ inner Real c u :=
    aux_real_inner_ge_seven_eighth_of_unit_dist_le_half hc hu huc
  have hinnerv : 7 / 8 ≤ inner Real c v :=
    aux_real_inner_ge_seven_eighth_of_unit_dist_le_half hc hv hvc
  have hsuminner : 7 / 8 * (r + s) ≤ inner Real c (r • u + s • v) := by
    rw [inner_add_right, inner_smul_right, inner_smul_right]
    nlinarith [mul_le_mul_of_nonneg_left hinneru hr,
      mul_le_mul_of_nonneg_left hinnerv hs]
  have hinnernorm : inner Real c (r • u + s • v) ≤ ‖r • u + s • v‖ := by
    calc
      inner Real c (r • u + s • v) ≤ |inner Real c (r • u + s • v)| := le_abs_self _
      _ ≤ ‖c‖ * ‖r • u + s • v‖ := abs_real_inner_le_norm _ _
      _ = ‖r • u + s • v‖ := by rw [hc, one_mul]
  nlinarith

/-- Convert cap control for normalized witnesses into cap control for their
angular plate centres. -/
private theorem aux_direction_centres_close_of_normalized_output_caps
    {h A C : Real} {a a' u u' xhat : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hh : 0 ≤ h)
    (hua : ‖u - a‖ ≤ A * h) (hu'a' : ‖u' - a'‖ ≤ A * h)
    (hux : ‖u - xhat‖ ≤ C * h) (hu'x : ‖u' - xhat‖ ≤ C * h) :
    ‖a - a'‖ ≤ (2 * A + 2 * C) * h := by
  have htriangle : ‖a - a'‖ ≤ ‖a - u‖ + ‖u - xhat‖ +
      ‖xhat - u'‖ + ‖u' - a'‖ := by
    calc
      ‖a - a'‖ = ‖(a - u) + (u - xhat) + (xhat - u') + (u' - a')‖ := by
        congr 1
        abel
      _ ≤ ‖(a - u) + (u - xhat) + (xhat - u')‖ + ‖u' - a'‖ := norm_add_le _ _
      _ ≤ ‖(a - u) + (u - xhat)‖ + ‖xhat - u'‖ + ‖u' - a'‖ := by
        gcongr
        exact norm_add_le _ _
      _ ≤ ‖a - u‖ + ‖u - xhat‖ + ‖xhat - u'‖ + ‖u' - a'‖ := by
        gcongr
        exact norm_add_le _ _
  rw [norm_sub_rev] at hua
  rw [norm_sub_rev] at hu'x
  calc
    ‖a - a'‖ ≤ ‖a - u‖ + ‖u - xhat‖ + ‖xhat - u'‖ + ‖u' - a'‖ := htriangle
    _ ≤ A * h + C * h + C * h + A * h := by gcongr
    _ = (2 * A + 2 * C) * h := by ring

private theorem aux_direction_centres_close_of_normalized_pair
    {h A C : Real}
    {a a' u u' : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hua : ‖u - a‖ ≤ A * h) (hu'a' : ‖u' - a'‖ ≤ A * h)
    (huu' : ‖u - u'‖ ≤ C * h) :
    ‖a - a'‖ ≤ (2 * A + C) * h := by
  have htriangle : ‖a - a'‖ ≤ ‖a - u‖ + ‖u - u'‖ + ‖u' - a'‖ := by
    calc
      ‖a - a'‖ = ‖(a - u) + (u - u') + (u' - a')‖ := by
        congr 1
        abel
      _ ≤ ‖(a - u) + (u - u')‖ + ‖u' - a'‖ := norm_add_le _ _
      _ ≤ ‖a - u‖ + ‖u - u'‖ + ‖u' - a'‖ := by
        gcongr
        exact norm_add_le _ _
  rw [norm_sub_rev] at hua
  calc
    ‖a - a'‖ ≤ ‖a - u‖ + ‖u - u'‖ + ‖u' - a'‖ := htriangle
    _ ≤ A * h + C * h + A * h := by gcongr
    _ = (2 * A + C) * h := by ring

private theorem aux_norm_normalized_eq_one
    {x : _root_.Codex.Spherical.SurfaceCore.Euclidean 2} (hx : x ≠ 0) :
    ‖(‖x‖)⁻¹ • x‖ = 1 := by
  have hnormpos : 0 < ‖x‖ := norm_pos_iff.mpr hx
  have hnormne : ‖x‖ ≠ 0 := ne_of_gt hnormpos
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hnormpos)]
  field_simp [hnormne]

private theorem aux_eq_norm_smul_normalized
    {x : _root_.Codex.Spherical.SurfaceCore.Euclidean 2} (hx : x ≠ 0) :
    x = ‖x‖ • ((‖x‖)⁻¹ • x) := by
  have hnormne : ‖x‖ ≠ 0 := norm_ne_zero_iff.mpr hx
  rw [smul_smul, mul_inv_cancel₀ hnormne, one_smul]

private theorem aux_normalized_near_common_sector_center
    {scale angularConstant : Real}
    {x direction center : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hscale : 0 < scale) (hx : x ≠ 0)
    (hactual : ‖(‖x‖)⁻¹ • x - direction‖ ≤
      angularConstant * scale ^ (-(1 / 2 : Real)))
    (hdircenter : ‖direction - center‖ ≤ 1 / 4)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4) :
    ‖(‖x‖)⁻¹ • x - center‖ ≤ 1 / 2 := by
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  have habs : ‖(‖x‖)⁻¹ • x - direction‖ ≤
      |angularConstant| * scale ^ (-(1 / 2 : Real)) := by
    calc
      ‖(‖x‖)⁻¹ • x - direction‖ ≤
          angularConstant * scale ^ (-(1 / 2 : Real)) := hactual
      _ ≤ |angularConstant| * scale ^ (-(1 / 2 : Real)) :=
        mul_le_mul_of_nonneg_right (le_abs_self angularConstant) hpow
  calc
    ‖(‖x‖)⁻¹ • x - center‖ ≤
        ‖(‖x‖)⁻¹ • x - direction‖ + ‖direction - center‖ := by
      rw [show (‖x‖)⁻¹ • x - center =
        ((‖x‖)⁻¹ • x - direction) + (direction - center) by abel]
      exact norm_add_le _ _
    _ ≤ |angularConstant| * scale ^ (-(1 / 2 : Real)) + 1 / 4 := by gcongr
    _ ≤ 1 / 2 := by linarith

private theorem aux_angular_direction_chord_bounds_succ
    {scale sectorRadius spacingLower spacingUpper : Real}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {i j : Int} {k : Nat}
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hpair : (i, j) ∈ angularSeparationPairs indices (k + 1)) :
    spacingLower * ((2 ^ k : Nat) : Real) * scale ^ (-(1 / 2 : Real)) ≤
        ‖directions i - directions j‖ ∧
      ‖directions i - directions j‖ ≤
        spacingUpper * ((2 ^ (k + 1) : Nat) : Real) *
          scale ^ (-(1 / 2 : Real)) := by
  rcases hgeometry with ⟨_, _, hspacingLower, _, _, _, hdata⟩
  rcases (mem_angularSeparationPairs_iff indices (k + 1) (i, j)).mp hpair with
    ⟨hi, hj, hseparation⟩
  rcases (angularSeparationClass_succ_iff k i j).mp hseparation with ⟨hlower, hupper⟩
  have hlowNat : 2 ^ k ≤ (i - j).natAbs := Nat.le_of_lt hlower
  have hlowReal : ((2 ^ k : Nat) : Real) ≤ ((i - j).natAbs : Real) := by
    exact_mod_cast hlowNat
  have hupperReal : ((i - j).natAbs : Real) ≤ ((2 ^ (k + 1) : Nat) : Real) := by
    exact_mod_cast hupper
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  have hdataij := (hdata i hi).2.2 j hj
  constructor
  · calc
      spacingLower * ((2 ^ k : Nat) : Real) * scale ^ (-(1 / 2 : Real)) ≤
          spacingLower * ((i - j).natAbs : Real) * scale ^ (-(1 / 2 : Real)) := by
            gcongr
      _ ≤ ‖directions i - directions j‖ := hdataij.1
  · calc
      ‖directions i - directions j‖ ≤
          spacingUpper * ((i - j).natAbs : Real) * scale ^ (-(1 / 2 : Real)) := hdataij.2
      _ ≤ spacingUpper * ((2 ^ (k + 1) : Nat) : Real) *
          scale ^ (-(1 / 2 : Real)) := by gcongr

private theorem aux_scaled_dyadic_index_le_half
    {scale sectorRadius spacingLower spacingUpper : Real}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {i j : Int} {k : Nat}
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hpair : (i, j) ∈ angularSeparationPairs indices (k + 1)) :
    spacingLower * ((2 ^ k : Nat) : Real) * scale ^ (-(1 / 2 : Real)) ≤ 1 / 2 := by
  have hlower := (aux_angular_direction_chord_bounds_succ hscale hgeometry hpair).1
  rcases hgeometry with ⟨_, hsector, _, _, center, _, hdata⟩
  rcases (mem_angularSeparationPairs_iff indices (k + 1) (i, j)).mp hpair with
    ⟨hi, hj, _⟩
  have hupper : ‖directions i - directions j‖ ≤ 1 / 2 := by
    calc
      ‖directions i - directions j‖ ≤
          ‖directions i - center‖ + ‖center - directions j‖ := by
        rw [show directions i - directions j =
          (directions i - center) + (center - directions j) by abel]
        exact norm_add_le _ _
      _ = ‖directions i - center‖ + ‖directions j - center‖ := by
        exact congrArg (fun q : Real => ‖directions i - center‖ + q)
          (norm_sub_rev _ _)
      _ ≤ sectorRadius + sectorRadius := add_le_add (hdata i hi).2.1 (hdata j hj).2.1

      _ ≤ 1 / 2 := by linarith
  exact le_trans hlower hupper

private theorem aux_same_sign_direction_bound_of_coordinate_bounds
    (o : Orientation Real (_root_.Codex.Spherical.SurfaceCore.Euclidean 2) (Fin 2))
    {A D CX CA h : Real}
    {X U U' : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hX : 0 < ‖X‖) (hA : 0 < A)
    (hU : ‖U‖ = 1) (hU' : ‖U'‖ = 1)
    (harea : A ≤ |(o.areaForm X) U| ∧ A ≤ |(o.areaForm X) U'|)
    (hsign : (0 ≤ (o.areaForm X) U ∧ 0 ≤ (o.areaForm X) U') ∨
      ((o.areaForm X) U ≤ 0 ∧ (o.areaForm X) U' ≤ 0))
    (hinner : |inner Real X U - inner Real X U'| ≤ D)
    (hXquot : D / ‖X‖ ≤ CX * h) (hAquot : D / A ≤ CA * h) :
    ‖U - U'‖ ≤ (CX + CA) * h := by
  calc
    ‖U - U'‖ ≤ D / ‖X‖ + D / A :=
      aux_unit_same_area_branch_direction_bound o hX hA hU hU' harea hsign hinner
    _ ≤ CX * h + CA * h := add_le_add hXquot hAquot
    _ = (CX + CA) * h := by ring

/-- The scale bookkeeping for the transverse branch.  `B` is the upper
angular-chord coefficient, `lambda` the lower one, and `C` compares them.
The two conclusions are the output-radius and oriented-area quotient bounds
used by the two-coordinate circle estimate. -/
private theorem aux_transverse_coordinate_quotient_bounds
    {scale h sq B lambda C ell : Real}
    (hscale : 2 ≤ scale) (hh : 0 < h) (hsq : 1 ≤ sq)
    (hhsq : h * sq = 1) (hhsquare : h ^ 2 * scale = 1)
    (hell : 0 < ell) (helllambda : ell ≤ lambda)
    (hC : 0 ≤ C) (hB : 0 ≤ B) (hlambda : 0 ≤ lambda)
    (hcompare : B ≤ C * lambda) (hlambdah : lambda * h ≤ 1 / 4) :
    (264 + 768 * B ^ 2 * h) / (scale / 4) ≤
        (1056 + 192 * C ^ 2) * h ∧
      (264 + 768 * B ^ 2 * h) / (lambda * sq / 8) ≤
        (4224 / ell + 1536 * C ^ 2) * h := by
  have hscalepos : 0 < scale := by linarith
  have hlambdapos : 0 < lambda := lt_of_lt_of_le hell helllambda
  have hClambda : 0 ≤ C * lambda := mul_nonneg hC hlambda
  have hBsquare : B ^ 2 ≤ (C * lambda) ^ 2 :=
    (sq_le_sq₀ hB hClambda).mpr hcompare
  have hlambdahnonneg : 0 ≤ lambda * h := mul_nonneg hlambda hh.le
  have hlambdahsq : (lambda * h) ^ 2 ≤ (1 / 4 : Real) ^ 2 :=
    (sq_le_sq₀ hlambdahnonneg (by norm_num)).mpr hlambdah
  have hlambdasq : lambda ^ 2 ≤ scale / 16 := by
    have hrewrite : lambda ^ 2 = (lambda * h) ^ 2 * scale := by
      calc
        lambda ^ 2 = lambda ^ 2 * (h ^ 2 * scale) := by rw [hhsquare, mul_one]
        _ = (lambda * h) ^ 2 * scale := by ring
    rw [hrewrite]
    calc
      (lambda * h) ^ 2 * scale ≤ (1 / 4 : Real) ^ 2 * scale :=
        mul_le_mul_of_nonneg_right hlambdahsq hscalepos.le
      _ = scale / 16 := by ring
  have hBsquare' : B ^ 2 ≤ C ^ 2 * lambda ^ 2 := by
    calc
      B ^ 2 ≤ (C * lambda) ^ 2 := hBsquare
      _ = C ^ 2 * lambda ^ 2 := by ring
  have hBsquareScale : 16 * B ^ 2 ≤ C ^ 2 * scale := by
    have hmul : C ^ 2 * lambda ^ 2 ≤ C ^ 2 * (scale / 16) :=
      mul_le_mul_of_nonneg_left hlambdasq (sq_nonneg C)
    nlinarith [hBsquare', hmul]
  have hBlinear : 4 * B ^ 2 * h ≤ C ^ 2 * lambda := by
    have hmul : B ^ 2 * h ≤ C ^ 2 * lambda ^ 2 * h :=
      mul_le_mul_of_nonneg_right hBsquare' hh.le
    have hright : C ^ 2 * lambda ^ 2 * h ≤ C ^ 2 * lambda / 4 := by
      calc
        C ^ 2 * lambda ^ 2 * h = C ^ 2 * lambda * (lambda * h) := by ring
        _ ≤ C ^ 2 * lambda * (1 / 4) := by gcongr
        _ = C ^ 2 * lambda / 4 := by ring
    nlinarith [hmul, hright]
  constructor
  · have hden : 0 < scale / 4 := by positivity
    apply (div_le_iff₀ hden).mpr
    have hscaleh : h * scale = sq := by
      apply mul_left_cancel₀ (ne_of_gt hh)
      calc
        h * (h * scale) = h ^ 2 * scale := by ring
        _ = 1 := hhsquare
        _ = h * sq := hhsq.symm
    have hsqbound : 1 ≤ h * scale := by rw [hscaleh]; exact hsq
    have htermOne : 264 ≤ 264 * (h * scale) := by
      nlinarith [hsqbound]
    have htermB : 768 * B ^ 2 * h ≤ 48 * C ^ 2 * (h * scale) := by
      have hmul := mul_le_mul_of_nonneg_right hBsquareScale hh.le
      nlinarith
    nlinarith [htermOne, htermB]
  · have hden : 0 < lambda * sq / 8 := by positivity
    apply (div_le_iff₀ hden).mpr
    have hsqrewrite : h * sq = 1 := hhsq
    have hfirst : 264 ≤ 528 * lambda / ell := by
      have hratio : 1 ≤ lambda / ell := (one_le_div₀ hell).mpr helllambda
      calc
        264 ≤ 528 * (lambda / ell) := by nlinarith
        _ = 528 * lambda / ell := by field_simp [ne_of_gt hell]
    have hright :
        (4224 / ell + 1536 * C ^ 2) * h * (lambda * sq / 8) =
          528 * lambda / ell + 192 * C ^ 2 * lambda := by
      rw [show (4224 / ell + 1536 * C ^ 2) * h * (lambda * sq / 8) =
        (4224 / ell + 1536 * C ^ 2) * (h * sq) * lambda / 8 by ring,
        hsqrewrite]
      field_simp [ne_of_gt hell]
      ring
    rw [hright]
    nlinarith [hBlinear]

private theorem aux_rpow_neg_half_mul_sqrt_eq_one
    {scale : Real} (hscale : 0 < scale) :
    scale ^ (-(1 / 2 : Real)) * Real.sqrt scale = 1 := by
  calc
    scale ^ (-(1 / 2 : Real)) * Real.sqrt scale =
        scale ^ (-(1 / 2 : Real)) * scale ^ (1 / 2 : Real) := by
          rw [← Real.sqrt_eq_rpow]
    _ = scale ^ ((-(1 / 2 : Real)) + (1 / 2 : Real)) :=
      (Real.rpow_add hscale _ _).symm
    _ = 1 := by norm_num

private theorem aux_rpow_neg_half_sq_mul_scale_eq_one
    {scale : Real} (hscale : 0 < scale) :
    (scale ^ (-(1 / 2 : Real))) ^ 2 * scale = 1 := by
  have hsq : (Real.sqrt scale) ^ 2 = scale := Real.sq_sqrt hscale.le
  have hinv := aux_rpow_neg_half_mul_sqrt_eq_one hscale
  calc
    (scale ^ (-(1 / 2 : Real))) ^ 2 * scale =
        (scale ^ (-(1 / 2 : Real))) ^ 2 * (Real.sqrt scale) ^ 2 := by rw [hsq]
    _ = (scale ^ (-(1 / 2 : Real)) * Real.sqrt scale) ^ 2 := by ring
    _ = 1 := by rw [hinv, one_pow]

private theorem aux_output_norm_lower_of_high_sector_witnesses
    {scale angularConstant normalShift normalShift' : Real} {n n' : Int}
    {direction direction' center : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {Z z w : WaveSpaceTime}
    (hscale : 2 ≤ scale)
    (hcenter : ‖center‖ = 1)
    (hdircenter : ‖direction - center‖ ≤ 1 / 4)
    (hdircenter' : ‖direction' - center‖ ≤ 1 / 4)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction)
    (hw : w ∈ unitNormalConicPlate scale angularConstant normalShift' n' direction')
    (hzw : z + w = Z) :
    scale / 4 ≤ ‖Z.1‖ := by
  have hscalepos : 0 < scale := by linarith
  have hznonzero : z.1 ≠ 0 := hz.2.2.1.1
  have hwnonzero : w.1 ≠ 0 := hw.2.2.1.1
  have hzu : ‖(‖z.1‖)⁻¹ • z.1‖ = 1 := aux_norm_normalized_eq_one hznonzero
  have hwu : ‖(‖w.1‖)⁻¹ • w.1‖ = 1 := aux_norm_normalized_eq_one hwnonzero
  have hzuclose : ‖(‖z.1‖)⁻¹ • z.1 - center‖ ≤ 1 / 2 :=
    aux_normalized_near_common_sector_center hscalepos hznonzero
      hz.2.2.1.2 hdircenter hhigh
  have hwuclose : ‖(‖w.1‖)⁻¹ • w.1 - center‖ ≤ 1 / 2 :=
    aux_normalized_near_common_sector_center hscalepos hwnonzero
      hw.2.2.1.2 hdircenter' hhigh
  have hspace : z.1 + w.1 = Z.1 := congrArg Prod.fst hzw
  have hzsmul := aux_eq_norm_smul_normalized hznonzero
  have hwsmul := aux_eq_norm_smul_normalized hwnonzero
  have hrepr : Z.1 =
      ‖z.1‖ • ((‖z.1‖)⁻¹ • z.1) + ‖w.1‖ • ((‖w.1‖)⁻¹ • w.1) := by
    calc
      Z.1 = z.1 + w.1 := hspace.symm
      _ = ‖z.1‖ • ((‖z.1‖)⁻¹ • z.1) + ‖w.1‖ • ((‖w.1‖)⁻¹ • w.1) := by
        exact congrArg₂ (· + ·) hzsmul hwsmul
  have hsumlower : (‖z.1‖ + ‖w.1‖) / 2 ≤ ‖Z.1‖ := by
    have hgeneric := aux_weighted_unit_sum_norm_lower_of_common_center
      (r := ‖z.1‖) (s := ‖w.1‖) (c := center)
      (u := (‖z.1‖)⁻¹ • z.1) (v := (‖w.1‖)⁻¹ • w.1)
      hcenter hzu hwu hzuclose hwuclose (norm_nonneg _) (norm_nonneg _)
    calc
      (‖z.1‖ + ‖w.1‖) / 2 ≤
          ‖‖z.1‖ • ((‖z.1‖)⁻¹ • z.1) + ‖w.1‖ • ((‖w.1‖)⁻¹ • w.1)‖ := hgeneric
      _ = ‖Z.1‖ := by rw [← hrepr]
  nlinarith [hz.1, hw.1, hsumlower]

private theorem aux_active_pair_exists_witness
    (scale angularConstant normalShift normalShift' : Real) (n n' : Int)
    (indices : Finset Int) (directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (pair : Int × Int)
    (hpair : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions k Z) :
    ∃ zw : WaveSpaceTime × WaveSpaceTime,
      zw.1 ∈ unitNormalConicPlate scale angularConstant normalShift n (directions pair.1) ∧
      zw.2 ∈ unitNormalConicPlate scale angularConstant normalShift' n' (directions pair.2) ∧
      zw.1 + zw.2 = Z := by
  rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
    n n' indices directions k Z pair).mp hpair with ⟨_, z, hz, w, hw, hzw⟩
  exact ⟨(z, w), hz, hw, hzw⟩

private noncomputable def aux_active_pair_witness
    (scale angularConstant normalShift normalShift' : Real) (n n' : Int)
    (indices : Finset Int) (directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (pair : Int × Int) : WaveSpaceTime × WaveSpaceTime :=
  if hpair : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions k Z then
    Classical.choose (aux_active_pair_exists_witness scale angularConstant normalShift normalShift'
      n n' indices directions k Z pair hpair)
  else (0, 0)

private theorem aux_active_pair_witness_spec
    (scale angularConstant normalShift normalShift' : Real) (n n' : Int)
    (indices : Finset Int) (directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (pair : Int × Int)
    (hpair : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions k Z) :
    (aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions k Z pair).1 ∈
        unitNormalConicPlate scale angularConstant normalShift n (directions pair.1) ∧
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions k Z pair).2 ∈
        unitNormalConicPlate scale angularConstant normalShift' n' (directions pair.2) ∧
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions k Z pair).1 +
        (aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions k Z pair).2 = Z := by
  rw [aux_active_pair_witness, dif_pos hpair]
  exact Classical.choose_spec (aux_active_pair_exists_witness scale angularConstant normalShift normalShift'
    n n' indices directions k Z pair hpair)

private noncomputable def aux_activeFirstNormalized
    (scale angularConstant normalShift normalShift' : Real) (n n' : Int)
    (indices : Finset Int) (directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (pair : Int × Int) :
    _root_.Codex.Spherical.SurfaceCore.Euclidean 2 :=
  (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
    n n' indices directions k Z pair).1.1‖)⁻¹ •
    (aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions k Z pair).1.1

private noncomputable def aux_activeSecondNormalized
    (scale angularConstant normalShift normalShift' : Real) (n n' : Int)
    (indices : Finset Int) (directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (pair : Int × Int) :
    _root_.Codex.Spherical.SurfaceCore.Euclidean 2 :=
  (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
    n n' indices directions k Z pair).2.1‖)⁻¹ •
    (aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions k Z pair).2.1

private theorem aux_output_cap_of_high_sector_witness
    {scale angularConstant normalShift normalShift' B : Real} {n n' : Int}
    {direction direction' center : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {Z z w : WaveSpaceTime}
    (hscale : 2 ≤ scale) (hB : 0 ≤ B)
    (hcenter : ‖center‖ = 1)
    (hdircenter : ‖direction - center‖ ≤ 1 / 4)
    (hdircenter' : ‖direction' - center‖ ≤ 1 / 4)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction)
    (hw : w ∈ unitNormalConicPlate scale angularConstant normalShift' n' direction')
    (hzw : z + w = Z)
    (hchord : ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ≤
      B * scale ^ (-(1 / 2 : Real))) :
    ‖(‖Z.1‖)⁻¹ • Z.1 - (‖z.1‖)⁻¹ • z.1‖ ≤
      16 * B * scale ^ (-(1 / 2 : Real)) := by
  have hXlower := aux_output_norm_lower_of_high_sector_witnesses hscale hcenter
    hdircenter hdircenter' hhigh hz hw hzw
  have hXnonzero : Z.1 ≠ 0 := by
    intro hzero
    have : ‖Z.1‖ = 0 := norm_eq_zero.mpr hzero
    linarith
  have hznonzero : z.1 ≠ 0 := hz.2.2.1.1
  have hwnonzero : w.1 ≠ 0 := hw.2.2.1.1
  have hspace : z.1 + w.1 = Z.1 := congrArg Prod.fst hzw
  have hzsmul := aux_eq_norm_smul_normalized hznonzero
  have hwsmul := aux_eq_norm_smul_normalized hwnonzero
  have hrepr : Z.1 =
      ‖z.1‖ • ((‖z.1‖)⁻¹ • z.1) + ‖w.1‖ • ((‖w.1‖)⁻¹ • w.1) := by
    calc
      Z.1 = z.1 + w.1 := hspace.symm
      _ = ‖z.1‖ • ((‖z.1‖)⁻¹ • z.1) + ‖w.1‖ • ((‖w.1‖)⁻¹ • w.1) :=
        congrArg₂ (· + ·) hzsmul hwsmul
  have hresult := aux_output_normalized_cap_of_chord_upper
    (scale := scale) (r := ‖z.1‖) (s := ‖w.1‖) (B := B) (X := Z.1)
    (u := (‖z.1‖)⁻¹ • z.1) (v := (‖w.1‖)⁻¹ • w.1)
    (by linarith) hB hz.1 hw.1 hw.2.1 hrepr hXnonzero
    (aux_norm_normalized_eq_one hznonzero) hchord
  exact hresult

private theorem aux_plate_normalized_direction_bound_abs
    {scale angularConstant normalShift : Real} {n : Int}
    {direction : _root_.Codex.Spherical.SurfaceCore.Euclidean 2} {z : WaveSpaceTime}
    (hscale : 0 < scale)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction) :
    ‖(‖z.1‖)⁻¹ • z.1 - direction‖ ≤
      |angularConstant| * scale ^ (-(1 / 2 : Real)) := by
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  calc
    ‖(‖z.1‖)⁻¹ • z.1 - direction‖ ≤
        angularConstant * scale ^ (-(1 / 2 : Real)) := hz.2.2.1.2
    _ ≤ |angularConstant| * scale ^ (-(1 / 2 : Real)) :=
      mul_le_mul_of_nonneg_right (le_abs_self angularConstant) hpow

/-- Once the first normalized direction is stable, the coupled vector-sum
identity and the common radial-label windows stabilize the second direction
at the same dyadic scale. -/
private theorem aux_second_direction_bound_of_first_and_radial_windows
    {scale r r' s s' C : Real}
    {X u u' v v' : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (hscale : 0 < scale) (hC : 0 ≤ C)
    (hrnonneg : 0 ≤ r) (hrupper : r ≤ 4 * scale) (hslower : scale / 4 ≤ s)
    (hrdiff : |r - r'| ≤ 6 * Real.sqrt scale)
    (hsdiff : |s - s'| ≤ 6 * Real.sqrt scale)
    (huu' : ‖u - u'‖ ≤ C * scale ^ (-(1 / 2 : Real)))
    (hu' : ‖u'‖ = 1) (hv' : ‖v'‖ = 1)
    (hX : X = r • u + s • v) (hX' : X = r' • u' + s' • v') :
    ‖v - v'‖ ≤ (48 + 16 * C) * scale ^ (-(1 / 2 : Real)) := by
  have hspos : 0 < s := by linarith
  have hsnonneg : 0 ≤ s := hspos.le
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  have hrpow : scale ^ (-(1 / 2 : Real)) * scale = Real.sqrt scale := by
    calc
      scale ^ (-(1 / 2 : Real)) * scale =
          scale ^ (-(1 / 2 : Real)) * scale ^ (1 : Real) := by rw [Real.rpow_one]
      _ = scale ^ (-(1 / 2 : Real) + (1 : Real)) :=
        (Real.rpow_add hscale _ _).symm
      _ = Real.sqrt scale := by
        convert (Real.sqrt_eq_rpow scale).symm using 1 <;> norm_num
  have hidentity : s • (v - v') =
      (r' - r) • u' + r • (u' - u) + (s' - s) • v' := by
    have hrel : s • v = r' • u' + s' • v' - r • u := by
      calc
        s • v = X - r • u := by rw [hX]; abel
        _ = r' • u' + s' • v' - r • u := by rw [hX']
    rw [smul_sub, hrel]
    module
  have hbound : s * ‖v - v'‖ ≤
      |r' - r| + r * ‖u' - u‖ + |s' - s| := by
    calc
      s * ‖v - v'‖ = ‖s • (v - v')‖ := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hsnonneg]
      _ = ‖(r' - r) • u' + r • (u' - u) + (s' - s) • v'‖ := by rw [hidentity]
      _ ≤ ‖(r' - r) • u'‖ + ‖r • (u' - u)‖ + ‖(s' - s) • v'‖ := by
        calc
          ‖(r' - r) • u' + r • (u' - u) + (s' - s) • v'‖ ≤
              ‖(r' - r) • u' + r • (u' - u)‖ + ‖(s' - s) • v'‖ := norm_add_le _ _
          _ ≤ ‖(r' - r) • u'‖ + ‖r • (u' - u)‖ + ‖(s' - s) • v'‖ := by
            gcongr
            exact norm_add_le _ _
      _ = |r' - r| + r * ‖u' - u‖ + |s' - s| := by
        rw [norm_smul, norm_smul, norm_smul, Real.norm_eq_abs,
          Real.norm_eq_abs, Real.norm_eq_abs, hu', hv', mul_one, mul_one,
          abs_of_nonneg hrnonneg]
  have huudiff : ‖u' - u‖ ≤ C * scale ^ (-(1 / 2 : Real)) := by
    rw [norm_sub_rev]
    exact huu'
  have hrdiff' : |r' - r| ≤ 6 * Real.sqrt scale := by
    rw [abs_sub_comm]
    exact hrdiff
  have hnumerator : |r' - r| + r * ‖u' - u‖ + |s' - s| ≤
      (12 + 4 * C) * Real.sqrt scale := by
    have hterm : r * ‖u' - u‖ ≤ 4 * C * Real.sqrt scale := by
      calc
        r * ‖u' - u‖ ≤ r * (C * scale ^ (-(1 / 2 : Real))) :=
          mul_le_mul_of_nonneg_left huudiff hrnonneg
        _ ≤ (4 * scale) * (C * scale ^ (-(1 / 2 : Real))) := by gcongr
        _ = 4 * C * Real.sqrt scale := by rw [← hrpow]; ring
    calc
      |r' - r| + r * ‖u' - u‖ + |s' - s| ≤
          (6 * Real.sqrt scale) + (4 * C * Real.sqrt scale) +
            (6 * Real.sqrt scale) := by
        apply add_le_add
        · exact add_le_add hrdiff' hterm
        · rwa [abs_sub_comm]
      _ = (12 + 4 * C) * Real.sqrt scale := by ring
  have htarget : (12 + 4 * C) * Real.sqrt scale ≤
      ((48 + 16 * C) * scale ^ (-(1 / 2 : Real))) * s := by
    calc
      (12 + 4 * C) * Real.sqrt scale =
          ((48 + 16 * C) * scale ^ (-(1 / 2 : Real))) * (scale / 4) := by
        rw [← hrpow]
        ring
      _ ≤ ((48 + 16 * C) * scale ^ (-(1 / 2 : Real))) * s := by
        have hnonneg : 0 ≤ (48 + 16 * C) * scale ^ (-(1 / 2 : Real)) := by positivity
        gcongr
  have hdiv : ‖v - v'‖ ≤
      (|r' - r| + r * ‖u' - u‖ + |s' - s|) / s := by
    apply (le_div_iff₀ hspos).mpr
    simpa [mul_comm] using hbound
  calc
    ‖v - v'‖ ≤
        (|r' - r| + r * ‖u' - u‖ + |s' - s|) / s := hdiv
    _ ≤ ((12 + 4 * C) * Real.sqrt scale) / s :=
      div_le_div_of_nonneg_right hnumerator hsnonneg
    _ ≤ (48 + 16 * C) * scale ^ (-(1 / 2 : Real)) := by
      apply (div_le_iff₀ hspos).mpr
      simpa [mul_comm] using htarget

/-- A uniform normalized chord bound for two literal high-sector witnesses
puts their first angular centres in one dyadic cap. -/
private theorem aux_high_active_first_direction_bound_of_normalized_chord
    {scale angularConstant normalShift normalShift' U : Real} {n n' : Int}
    {direction direction' mate mate' center : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {Z z w z' w' : WaveSpaceTime}
    (hscale : 2 ≤ scale) (hU : 0 ≤ U) (hcenter : ‖center‖ = 1)
    (hdirection : ‖direction - center‖ ≤ 1 / 4)
    (hmate : ‖mate - center‖ ≤ 1 / 4)
    (hdirection' : ‖direction' - center‖ ≤ 1 / 4)
    (hmate' : ‖mate' - center‖ ≤ 1 / 4)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction)
    (hw : w ∈ unitNormalConicPlate scale angularConstant normalShift' n' mate)
    (hz' : z' ∈ unitNormalConicPlate scale angularConstant normalShift n direction')
    (hw' : w' ∈ unitNormalConicPlate scale angularConstant normalShift' n' mate')
    (hzw : z + w = Z) (hz'w' : z' + w' = Z)
    (hchord : ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ≤
      U * scale ^ (-(1 / 2 : Real)))
    (hchord' : ‖(‖z'.1‖)⁻¹ • z'.1 - (‖w'.1‖)⁻¹ • w'.1‖ ≤
      U * scale ^ (-(1 / 2 : Real))) :
    ‖direction - direction'‖ ≤
      (2 * |angularConstant| + 32 * U) * scale ^ (-(1 / 2 : Real)) := by
  have hscalepos : 0 < scale := by linarith
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscalepos.le _
  have hzerr := aux_plate_normalized_direction_bound_abs hscalepos hz
  have hz'err := aux_plate_normalized_direction_bound_abs hscalepos hz'
  have hcap := aux_output_cap_of_high_sector_witness hscale hU hcenter
    hdirection hmate hhigh hz hw hzw hchord
  have hcap' := aux_output_cap_of_high_sector_witness hscale hU hcenter
    hdirection' hmate' hhigh hz' hw' hz'w' hchord'
  have hcaprev : ‖(‖z.1‖)⁻¹ • z.1 - (‖Z.1‖)⁻¹ • Z.1‖ ≤
      16 * U * scale ^ (-(1 / 2 : Real)) := by
    rw [norm_sub_rev]
    exact hcap
  have hcaprev' : ‖(‖z'.1‖)⁻¹ • z'.1 - (‖Z.1‖)⁻¹ • Z.1‖ ≤
      16 * U * scale ^ (-(1 / 2 : Real)) := by
    rw [norm_sub_rev]
    exact hcap'
  convert aux_direction_centres_close_of_normalized_output_caps hpow hzerr hz'err
    hcaprev hcaprev' using 1 <;> ring

private theorem aux_normalized_chord_le_one_of_high_common_sector
    {scale angularConstant normalShift normalShift' : Real} {n n' : Int}
    {direction mate : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {z w : WaveSpaceTime}
    (hscale : 0 < scale)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (hcenters : ‖direction - mate‖ ≤ 1 / 2)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction)
    (hw : w ∈ unitNormalConicPlate scale angularConstant normalShift' n' mate) :
    ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ≤ 1 := by
  have hzerr := aux_plate_normalized_direction_bound_abs hscale hz
  have hwerr := aux_plate_normalized_direction_bound_abs hscale hw
  have hzsmall : ‖(‖z.1‖)⁻¹ • z.1 - direction‖ ≤ 1 / 4 := le_trans hzerr hhigh
  have hwsmall : ‖(‖w.1‖)⁻¹ • w.1 - mate‖ ≤ 1 / 4 := le_trans hwerr hhigh
  have htriangle : ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ≤
      ‖(‖z.1‖)⁻¹ • z.1 - direction‖ + ‖direction - mate‖ +
        ‖mate - (‖w.1‖)⁻¹ • w.1‖ := by
    calc
      ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ =
          ‖((‖z.1‖)⁻¹ • z.1 - direction) + (direction - mate) +
            (mate - (‖w.1‖)⁻¹ • w.1)‖ := by congr 1 <;> abel
      _ ≤ ‖(‖z.1‖)⁻¹ • z.1 - direction‖ + ‖direction - mate‖ +
          ‖mate - (‖w.1‖)⁻¹ • w.1‖ := by
        calc
          _ ≤ ‖(‖z.1‖)⁻¹ • z.1 - direction + (direction - mate)‖ +
              ‖mate - (‖w.1‖)⁻¹ • w.1‖ := norm_add_le _ _
          _ ≤ _ := by gcongr; exact norm_add_le _ _
  rw [norm_sub_rev] at hwsmall
  linarith

private def aux_pre_labelBox (anchor : Int × Int) (B : Nat) : Finset (Int × Int) :=
  Finset.Icc (anchor.1 - (B : Int)) (anchor.1 + (B : Int)) ×ˢ
    Finset.Icc (anchor.2 - (B : Int)) (anchor.2 + (B : Int))

private theorem aux_pre_mem_labelBox_of_natAbs_sub_le
    {pair anchor : Int × Int} {B : Nat}
    (hfirst : (pair.1 - anchor.1).natAbs ≤ B)
    (hsecond : (pair.2 - anchor.2).natAbs ≤ B) :
    pair ∈ aux_pre_labelBox anchor B := by
  simp only [aux_pre_labelBox, Finset.mem_product, Finset.mem_Icc]
  constructor <;> constructor <;> omega

private theorem aux_pre_card_labelBox (anchor : Int × Int) (B : Nat) :
    (aux_pre_labelBox anchor B).card = (2 * B + 1) ^ 2 := by
  simp only [aux_pre_labelBox, Finset.card_product, Int.card_Icc]
  have hfirst :
      (anchor.1 + (B : Int) + 1 - (anchor.1 - (B : Int))).toNat = 2 * B + 1 := by
    omega
  have hsecond :
      (anchor.2 + (B : Int) + 1 - (anchor.2 - (B : Int))).toNat = 2 * B + 1 := by
    omega
  rw [hfirst, hsecond]
  ring

private theorem aux_pre_card_le_two_labelBoxes
    (active : Finset (Int × Int)) (anchor₁ anchor₂ : Int × Int) (B : Nat)
    (hcover : active ⊆ aux_pre_labelBox anchor₁ B ∪ aux_pre_labelBox anchor₂ B) :
    active.card ≤ 2 * (2 * B + 1) ^ 2 := by
  calc
    active.card ≤ (aux_pre_labelBox anchor₁ B ∪ aux_pre_labelBox anchor₂ B).card :=
      Finset.card_le_card hcover
    _ ≤ (aux_pre_labelBox anchor₁ B).card + (aux_pre_labelBox anchor₂ B).card :=
      Finset.card_union_le _ _
    _ = 2 * (2 * B + 1) ^ 2 := by
      rw [aux_pre_card_labelBox, aux_pre_card_labelBox]
      ring

private theorem aux_pre_natAbs_sub_le_of_scaled_direction_bound
    {scale sectorRadius spacingLower spacingUpper D : Real}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {i anchor : Int} {B : Nat}
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions

      sectorRadius spacingLower spacingUpper)
    (hi : i ∈ indices) (hanchor : anchor ∈ indices)
    (hD : D ≤ spacingLower * (B : Real))
    (hdist : ‖directions i - directions anchor‖ ≤
      D * scale ^ (-(1 / 2 : Real))) :
    (i - anchor).natAbs ≤ B := by
  rcases hgeometry with ⟨_, _, hspacingLower, _, _, _, hdata⟩
  have hpow : 0 < scale ^ (-(1 / 2 : Real)) := Real.rpow_pos_of_pos hscale _
  have hlow : spacingLower * ((i - anchor).natAbs : Real) *
      scale ^ (-(1 / 2 : Real)) ≤ ‖directions i - directions anchor‖ :=
    (hdata i hi).2.2 anchor hanchor |>.1
  have hscaled :
      (spacingLower * ((i - anchor).natAbs : Real)) *
        scale ^ (-(1 / 2 : Real)) ≤ D * scale ^ (-(1 / 2 : Real)) := by
    exact le_trans hlow hdist
  have hquot : spacingLower * ((i - anchor).natAbs : Real) ≤ D := by
    nlinarith [hscaled]
  have hreal : ((i - anchor).natAbs : Real) ≤ B := by
    nlinarith [hquot, hD]
  exact_mod_cast hreal

private theorem aux_pre_card_le_two_labelBoxes_of_direction_boxes
    {scale sectorRadius spacingLower spacingUpper D : Real}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (active : Finset (Int × Int)) (anchor₁ anchor₂ : Int × Int) (B : Nat)
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hanchor₁ : anchor₁.1 ∈ indices ∧ anchor₁.2 ∈ indices)
    (hanchor₂ : anchor₂.1 ∈ indices ∧ anchor₂.2 ∈ indices)
    (hactive : ∀ pair ∈ active, pair.1 ∈ indices ∧ pair.2 ∈ indices)
    (hD : D ≤ spacingLower * (B : Real))
    (hcover : ∀ pair ∈ active,
      (‖directions pair.1 - directions anchor₁.1‖ ≤ D * scale ^ (-(1 / 2 : Real)) ∧
        ‖directions pair.2 - directions anchor₁.2‖ ≤ D * scale ^ (-(1 / 2 : Real))) ∨
      (‖directions pair.1 - directions anchor₂.1‖ ≤ D * scale ^ (-(1 / 2 : Real)) ∧
        ‖directions pair.2 - directions anchor₂.2‖ ≤ D * scale ^ (-(1 / 2 : Real))) ) :
    active.card ≤ 2 * (2 * B + 1) ^ 2 := by
  apply aux_pre_card_le_two_labelBoxes active anchor₁ anchor₂ B
  intro pair hpair
  rcases hactive pair hpair with ⟨hfirst, hsecond⟩
  rcases hcover pair hpair with hleft | hright
  · apply Finset.mem_union_left
    exact aux_pre_mem_labelBox_of_natAbs_sub_le
      (aux_pre_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hfirst hanchor₁.1 hD hleft.1)
      (aux_pre_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hsecond hanchor₁.2 hD hleft.2)
  · apply Finset.mem_union_right
    exact aux_pre_mem_labelBox_of_natAbs_sub_le
      (aux_pre_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hfirst hanchor₂.1 hD hright.1)
      (aux_pre_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hsecond hanchor₂.2 hD hright.2)

/-- A high-sector literal overlap fiber is uniformly packed whenever every
canonical witness has a common normalized angular-chord bound. -/
private theorem aux_high_overlap_card_bound_of_normalized_chord
    {scale angularConstant sectorRadius spacingLower spacingUpper : Real}
    {normalShift normalShift' U : Real} {n n' : Int}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {k : Nat} {Z : WaveSpaceTime} {B : Nat}
    (hscale : 2 ≤ scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (hU : 0 ≤ U)
    (hB : 2 * |angularConstant| + 32 * U ≤ spacingLower * (B : Real))
    (hchord : ∀ pair,
      pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
        n n' indices directions k Z →
      ‖aux_activeFirstNormalized scale angularConstant normalShift normalShift'
          n n' indices directions k Z pair -
        aux_activeSecondNormalized scale angularConstant normalShift normalShift'
          n n' indices directions k Z pair‖ ≤
        U * scale ^ (-(1 / 2 : Real))) :
    (unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions k Z).card ≤ 2 * (2 * B + 1) ^ 2 := by
  classical
  let active := unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
    n n' indices directions k Z
  have hgeometryFull := hgeometry
  rcases hgeometry with ⟨_, hsector, _, _, center, hcenter, hdata⟩
  have hscalepos : 0 < scale := by linarith
  by_cases hnonempty : active.Nonempty
  · obtain ⟨anchor, hanchor⟩ := hnonempty
    apply aux_pre_card_le_two_labelBoxes_of_direction_boxes
      (active := active) (anchor₁ := anchor) (anchor₂ := anchor)
      (D := 2 * |angularConstant| + 32 * U) (B := B) hscalepos hgeometryFull
    · have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hanchor
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z anchor).mp hanchor' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.2.1⟩
    · have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hanchor
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z anchor).mp hanchor' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.2.1⟩
    · intro pair hpair
      have hpair' : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hpair
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z pair).mp hpair' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices k pair).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices k pair).mp hsep |>.2.1⟩
    · exact hB
    · intro pair hpair
      have hpair' : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hpair
      have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hanchor
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z pair).mp hpair' with ⟨hpsep, _⟩
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z anchor).mp hanchor' with ⟨hasep, _⟩
      have hpdata := (mem_angularSeparationPairs_iff indices k pair).mp hpsep
      have hadata := (mem_angularSeparationPairs_iff indices k anchor).mp hasep
      rcases aux_active_pair_witness_spec scale angularConstant normalShift normalShift'
        n n' indices directions k Z pair hpair' with ⟨hpz, hpw, hpzw⟩
      rcases aux_active_pair_witness_spec scale angularConstant normalShift normalShift'
        n n' indices directions k Z anchor hanchor' with ⟨haz, haw, hazw⟩
      have hpchord : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions k Z pair).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z pair).1.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z pair).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z pair).2.1‖ ≤
          U * scale ^ (-(1 / 2 : Real)) := by
        simpa only [aux_activeFirstNormalized, aux_activeSecondNormalized] using hchord pair hpair'
      have hachord : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions k Z anchor).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z anchor).1.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z anchor).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z anchor).2.1‖ ≤
          U * scale ^ (-(1 / 2 : Real)) := by
        simpa only [aux_activeFirstNormalized, aux_activeSecondNormalized] using hchord anchor hanchor'
      have hfirst := aux_high_active_first_direction_bound_of_normalized_chord
        hscale hU hcenter
        (le_trans (hdata pair.1 hpdata.1).2.1 hsector)
        (le_trans (hdata pair.2 hpdata.2.1).2.1 hsector)
        (le_trans (hdata anchor.1 hadata.1).2.1 hsector)
        (le_trans (hdata anchor.2 hadata.2.1).2.1 hsector)
        hhigh hpz hpw haz haw hpzw hazw hpchord hachord
      have hpzwrev : (aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions k Z pair).2 +
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z pair).1 = Z := by
        rw [add_comm]
        exact hpzw
      have hazwrev : (aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions k Z anchor).2 +
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z anchor).1 = Z := by
        rw [add_comm]
        exact hazw
      have hpchordrev : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions k Z pair).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z pair).2.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z pair).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z pair).1.1‖ ≤
          U * scale ^ (-(1 / 2 : Real)) := by
        rw [norm_sub_rev]
        exact hpchord
      have hachordrev : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions k Z anchor).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z anchor).2.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z anchor).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z anchor).1.1‖ ≤
          U * scale ^ (-(1 / 2 : Real)) := by
        rw [norm_sub_rev]
        exact hachord
      have hsecond := aux_high_active_first_direction_bound_of_normalized_chord
        (normalShift := normalShift') (normalShift' := normalShift) (n := n') (n' := n)
        (direction := directions pair.2) (mate := directions pair.1)
        (direction' := directions anchor.2) (mate' := directions anchor.1)
        hscale hU hcenter
        (le_trans (hdata pair.2 hpdata.2.1).2.1 hsector)
        (le_trans (hdata pair.1 hpdata.1).2.1 hsector)
        (le_trans (hdata anchor.2 hadata.2.1).2.1 hsector)
        (le_trans (hdata anchor.1 hadata.1).2.1 hsector)
        hhigh hpw hpz haw haz hpzwrev hazwrev hpchordrev hachordrev
      exact Or.inl ⟨hfirst, hsecond⟩
  · have hempty : active = ∅ := Finset.not_nonempty_iff_eq_empty.mp hnonempty
    simp [active, hempty]

/-- In the high-scale, small-separation regime, angular spacing itself gives
a uniform normalized chord bound, hence a literal finite overlap packing. -/
private theorem aux_high_tangent_overlap_card_bound
    {scale angularConstant sectorRadius spacingLower spacingUpper : Real}
    {normalShift normalShift' : Real} {n n' : Int}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {m : Nat} {Z : WaveSpaceTime} {B : Nat}
    (hscale : 2 ≤ scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (htangent : spacingLower * ((2 ^ m : Nat) : Real) ≤ 4 * |angularConstant|)
    (hB : 2 * |angularConstant| +
      32 * (8 * |angularConstant| * spacingUpper / spacingLower +
        2 * |angularConstant|) ≤ spacingLower * (B : Real)) :
    (unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z).card ≤ 2 * (2 * B + 1) ^ 2 := by
  have hgeometryFull := hgeometry
  rcases hgeometry with ⟨_, _, hspacingLower, hspacingUpper, _, _, _⟩
  have hscalepos : 0 < scale := by linarith
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscalepos.le _
  have hq : ((2 ^ m : Nat) : Real) ≤ 4 * |angularConstant| / spacingLower := by
    apply (le_div_iff₀ hspacingLower).mpr
    simpa [mul_comm] using htangent
  have hcoefficient : spacingUpper * ((2 ^ (m + 1) : Nat) : Real) ≤
      8 * |angularConstant| * spacingUpper / spacingLower := by
    calc
      spacingUpper * ((2 ^ (m + 1) : Nat) : Real) =
          2 * spacingUpper * ((2 ^ m : Nat) : Real) := by
            rw [pow_succ, Nat.cast_mul]
            norm_num
            ring
      _ ≤ 2 * spacingUpper * (4 * |angularConstant| / spacingLower) := by
            gcongr
      _ = 8 * |angularConstant| * spacingUpper / spacingLower := by ring
  apply aux_high_overlap_card_bound_of_normalized_chord hscale hgeometryFull hhigh
    (by positivity : 0 ≤ 8 * |angularConstant| * spacingUpper / spacingLower +
      2 * |angularConstant|) hB
  intro pair hpair
  have hsep := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
    normalShift' n n' indices directions (m + 1) Z pair).mp hpair |>.1
  have hcenters := aux_angular_direction_chord_bounds_succ hscalepos hgeometryFull hsep
  have hcenterUpper : ‖directions pair.1 - directions pair.2‖ ≤
      (8 * |angularConstant| * spacingUpper / spacingLower) *
        scale ^ (-(1 / 2 : Real)) := by
    calc
      ‖directions pair.1 - directions pair.2‖ ≤
          spacingUpper * ((2 ^ (m + 1) : Nat) : Real) *
            scale ^ (-(1 / 2 : Real)) := hcenters.2
      _ ≤ (8 * |angularConstant| * spacingUpper / spacingLower) *
            scale ^ (-(1 / 2 : Real)) :=
        mul_le_mul_of_nonneg_right hcoefficient hpow
  rcases aux_active_pair_witness_spec scale angularConstant normalShift normalShift'
    n n' indices directions (m + 1) Z pair hpair with ⟨hz, hw, hzw⟩
  have hzerr := aux_plate_normalized_direction_bound_abs hscalepos hz
  have hwerr := aux_plate_normalized_direction_bound_abs hscalepos hw
  simpa only [aux_activeFirstNormalized, aux_activeSecondNormalized] using
    aux_chord_upper_of_center_direction_bounds hcenterUpper hzerr hwerr

private theorem aux_high_zero_unitNormal_overlap_card_bound
    {scale angularConstant sectorRadius spacingLower spacingUpper : Real}
    {normalShift normalShift' : Real} {n n' : Int}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {Z : WaveSpaceTime} {B : Nat}
    (hscale : 2 ≤ scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (hB : 2 * |angularConstant| +
      32 * (spacingUpper + 2 * |angularConstant|) ≤ spacingLower * (B : Real)) :
    (unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions 0 Z).card ≤ 2 * (2 * B + 1) ^ 2 := by
  classical
  let active := unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
    n n' indices directions 0 Z
  have hgeometryFull := hgeometry
  rcases hgeometry with ⟨hsectorPos, hsector, hspacingLower, hspacingUpper,
    center, hcenter, hdata⟩
  have hscalepos : 0 < scale := by linarith
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscalepos.le _
  have hBzero : 0 ≤ spacingUpper + 2 * |angularConstant| := by positivity
  by_cases hnonempty : active.Nonempty
  · obtain ⟨anchor, hanchor⟩ := hnonempty
    apply aux_pre_card_le_two_labelBoxes_of_direction_boxes
      (active := active) (anchor₁ := anchor) (anchor₂ := anchor) (D :=
        2 * |angularConstant| + 32 * (spacingUpper + 2 * |angularConstant|))
      (B := B) hscalepos hgeometryFull
    · have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions 0 Z := by simpa [active] using hanchor
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions 0 Z anchor).mp hanchor' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices 0 anchor).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices 0 anchor).mp hsep |>.2.1⟩
    · have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions 0 Z := by simpa [active] using hanchor
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions 0 Z anchor).mp hanchor' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices 0 anchor).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices 0 anchor).mp hsep |>.2.1⟩
    · intro pair hpair
      have hpair' : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions 0 Z := by simpa [active] using hpair
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions 0 Z pair).mp hpair' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices 0 pair).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices 0 pair).mp hsep |>.2.1⟩
    · exact hB
    · intro pair hpair
      have hpair' : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions 0 Z := by simpa [active] using hpair
      have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions 0 Z := by simpa [active] using hanchor
      have hpsep := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
        normalShift' n n' indices directions 0 Z pair).mp hpair' |>.1
      have hasep := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
        normalShift' n n' indices directions 0 Z anchor).mp hanchor' |>.1
      have hpdata := (mem_angularSeparationPairs_iff indices 0 pair).mp hpsep
      have hadata := (mem_angularSeparationPairs_iff indices 0 anchor).mp hasep
      have hcenterUpper : ‖directions pair.1 - directions pair.2‖ ≤
          spacingUpper * scale ^ (-(1 / 2 : Real)) := by
        have hraw := (hdata pair.1 hpdata.1).2.2 pair.2 hpdata.2.1 |>.2
        have hclass := (angularSeparationClass_zero_iff pair.1 pair.2).mp hpdata.2.2
        calc
          ‖directions pair.1 - directions pair.2‖ ≤
              spacingUpper * ((pair.1 - pair.2).natAbs : Real) *
                scale ^ (-(1 / 2 : Real)) := hraw
          _ ≤ spacingUpper * 1 * scale ^ (-(1 / 2 : Real)) := by
            gcongr
            exact_mod_cast hclass
          _ = spacingUpper * scale ^ (-(1 / 2 : Real)) := by ring
      have hcenterUpperA : ‖directions anchor.1 - directions anchor.2‖ ≤
          spacingUpper * scale ^ (-(1 / 2 : Real)) := by
        have hraw := (hdata anchor.1 hadata.1).2.2 anchor.2 hadata.2.1 |>.2
        have hclass := (angularSeparationClass_zero_iff anchor.1 anchor.2).mp hadata.2.2
        calc
          ‖directions anchor.1 - directions anchor.2‖ ≤
              spacingUpper * ((anchor.1 - anchor.2).natAbs : Real) *
                scale ^ (-(1 / 2 : Real)) := hraw
          _ ≤ spacingUpper * 1 * scale ^ (-(1 / 2 : Real)) := by
            gcongr
            exact_mod_cast hclass
          _ = spacingUpper * scale ^ (-(1 / 2 : Real)) := by ring
      rcases aux_active_pair_witness_spec scale angularConstant normalShift normalShift'
        n n' indices directions 0 Z pair hpair' with ⟨hz, hw, hzw⟩
      rcases aux_active_pair_witness_spec scale angularConstant normalShift normalShift'
        n n' indices directions 0 Z anchor hanchor' with ⟨az, aw, hazw⟩
      have hpzerr := aux_plate_normalized_direction_bound_abs hscalepos hz
      have hpwerr := aux_plate_normalized_direction_bound_abs hscalepos hw
      have hazerr := aux_plate_normalized_direction_bound_abs hscalepos az
      have hawerr := aux_plate_normalized_direction_bound_abs hscalepos aw
      have hpchord : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z pair).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z pair).1.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z pair).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z pair).2.1‖ ≤
          (spacingUpper + 2 * |angularConstant|) * scale ^ (-(1 / 2 : Real)) := by
        exact aux_chord_upper_of_center_direction_bounds hcenterUpper hpzerr hpwerr
      have hachord : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z anchor).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z anchor).1.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z anchor).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z anchor).2.1‖ ≤
          (spacingUpper + 2 * |angularConstant|) * scale ^ (-(1 / 2 : Real)) := by
        exact aux_chord_upper_of_center_direction_bounds hcenterUpperA hazerr hawerr
      have hcapP := aux_output_cap_of_high_sector_witness hscale hBzero hcenter
        (le_trans (hdata pair.1 hpdata.1).2.1 hsector)
        (le_trans (hdata pair.2 hpdata.2.1).2.1 hsector) hhigh hz hw hzw hpchord
      have hcapA := aux_output_cap_of_high_sector_witness hscale hBzero hcenter
        (le_trans (hdata anchor.1 hadata.1).2.1 hsector)
        (le_trans (hdata anchor.2 hadata.2.1).2.1 hsector) hhigh az aw hazw hachord
      have hcapP' : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z pair).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z pair).1.1 - (‖Z.1‖)⁻¹ • Z.1‖ ≤
          16 * (spacingUpper + 2 * |angularConstant|) *
            scale ^ (-(1 / 2 : Real)) := by
        rw [norm_sub_rev]
        exact hcapP
      have hcapA' : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z anchor).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z anchor).1.1 - (‖Z.1‖)⁻¹ • Z.1‖ ≤
          16 * (spacingUpper + 2 * |angularConstant|) *
            scale ^ (-(1 / 2 : Real)) := by
        rw [norm_sub_rev]
        exact hcapA
      have hfirst := aux_direction_centres_close_of_normalized_output_caps hpow
        hpzerr hazerr hcapP' hcapA'
      have hsecond := by
        have hpzw : (aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z pair).2 +
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z pair).1 = Z := by
          rw [add_comm]
          exact hzw
        have hazw' : (aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z anchor).2 +
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z anchor).1 = Z := by
          rw [add_comm]
          exact hazw
        have hcapP2 := aux_output_cap_of_high_sector_witness hscale hBzero hcenter
          (le_trans (hdata pair.2 hpdata.2.1).2.1 hsector)
          (le_trans (hdata pair.1 hpdata.1).2.1 hsector) hhigh hw hz hpzw (by
            rw [norm_sub_rev]
            exact hpchord)
        have hcapA2 := aux_output_cap_of_high_sector_witness hscale hBzero hcenter
          (le_trans (hdata anchor.2 hadata.2.1).2.1 hsector)
          (le_trans (hdata anchor.1 hadata.1).2.1 hsector) hhigh aw az hazw' (by
            rw [norm_sub_rev]
            exact hachord)
        have hcapP2' : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z pair).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z pair).2.1 - (‖Z.1‖)⁻¹ • Z.1‖ ≤
          16 * (spacingUpper + 2 * |angularConstant|) *
            scale ^ (-(1 / 2 : Real)) := by
          rw [norm_sub_rev]
          exact hcapP2
        have hcapA2' : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z anchor).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z anchor).2.1 - (‖Z.1‖)⁻¹ • Z.1‖ ≤
          16 * (spacingUpper + 2 * |angularConstant|) *
            scale ^ (-(1 / 2 : Real)) := by
          rw [norm_sub_rev]
          exact hcapA2
        exact aux_direction_centres_close_of_normalized_output_caps hpow
          hpwerr hawerr hcapP2' hcapA2'
      exact Or.inl ⟨by convert hfirst using 1 <;> ring,
        by convert hsecond using 1 <;> ring⟩
  · have hempty : active = ∅ := Finset.not_nonempty_iff_eq_empty.mp hnonempty
    simp [active, hempty]

/-- Two literal witnesses for the same translated unit-normal output have
uniformly stable polar inner coordinates.  This is the analytic core of the
fixed-area-sign cap reduction. -/
private theorem aux_two_active_polar_inner_coordinate_stable
    {scale angularConstant normalShift normalShift' B : Real} {n n' : Int}
    {direction mate direction' mate' : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {Z z w z' w' : WaveSpaceTime}
    (hscale : 2 ≤ scale) (hB : 0 ≤ B)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction)
    (hw : w ∈ unitNormalConicPlate scale angularConstant normalShift' n' mate)
    (hz' : z' ∈ unitNormalConicPlate scale angularConstant normalShift n direction')
    (hw' : w' ∈ unitNormalConicPlate scale angularConstant normalShift' n' mate')
    (hzw : z + w = Z) (hz'w' : z' + w' = Z)
    (hchord : ‖(‖z'.1‖)⁻¹ • z'.1 - (‖w'.1‖)⁻¹ • w'.1‖ ≤
      B * scale ^ (-(1 / 2 : Real))) :
    |inner Real Z.1 ((‖z.1‖)⁻¹ • z.1) -
        inner Real Z.1 ((‖z'.1‖)⁻¹ • z'.1)| ≤
      264 + 768 * B ^ 2 * scale ^ (-(1 / 2 : Real)) := by
  have hscalepos : 0 < scale := by linarith
  have hznonzero : z.1 ≠ 0 := hz.2.2.1.1
  have hwnonzero : w.1 ≠ 0 := hw.2.2.1.1
  have hz'nonzero : z'.1 ≠ 0 := hz'.2.2.1.1
  have hw'nonzero : w'.1 ≠ 0 := hw'.2.2.1.1
  have hznorm : ‖z.1‖ ≠ 0 := norm_ne_zero_iff.mpr hznonzero
  have hz'norm : ‖z'.1‖ ≠ 0 := norm_ne_zero_iff.mpr hz'nonzero
  have hspace : z.1 + w.1 = Z.1 := congrArg Prod.fst hzw
  have hspace' : z'.1 + w'.1 = Z.1 := congrArg Prod.fst hz'w'
  have hsub : Z.1 - z.1 = w.1 := by rw [← hspace]; abel
  have hsub' : Z.1 - z'.1 = w'.1 := by rw [← hspace']; abel
  have hnormal :
      |(Z.2 - (‖z.1‖ + ‖w.1‖)) - (normalShift + normalShift')| ≤ 4 := by
    have htime : z.2 + w.2 = Z.2 := congrArg Prod.snd hzw
    have hznormal : |(z.2 - ‖z.1‖) - normalShift| ≤ 2 := hz.2.2.2.2
    have hwnormal : |(w.2 - ‖w.1‖) - normalShift'| ≤ 2 := hw.2.2.2.2
    calc
      |(Z.2 - (‖z.1‖ + ‖w.1‖)) - (normalShift + normalShift')| =
          |((z.2 - ‖z.1‖) - normalShift) +
            ((w.2 - ‖w.1‖) - normalShift')| := by
              rw [← htime]
              ring_nf
      _ ≤ |(z.2 - ‖z.1‖) - normalShift| +
          |(w.2 - ‖w.1‖) - normalShift'| := abs_add_le _ _
      _ ≤ 4 := by linarith
  have hnormal' :
      |(Z.2 - (‖z'.1‖ + ‖w'.1‖)) - (normalShift + normalShift')| ≤ 4 := by
    have htime : z'.2 + w'.2 = Z.2 := congrArg Prod.snd hz'w'
    have hznormal : |(z'.2 - ‖z'.1‖) - normalShift| ≤ 2 := hz'.2.2.2.2
    have hwnormal : |(w'.2 - ‖w'.1‖) - normalShift'| ≤ 2 := hw'.2.2.2.2
    calc
      |(Z.2 - (‖z'.1‖ + ‖w'.1‖)) - (normalShift + normalShift')| =
          |((z'.2 - ‖z'.1‖) - normalShift) +
            ((w'.2 - ‖w'.1‖) - normalShift')| := by
              rw [← htime]
              ring_nf
      _ ≤ |(z'.2 - ‖z'.1‖) - normalShift| +
          |(w'.2 - ‖w'.1‖) - normalShift'| := abs_add_le _ _
      _ ≤ 4 := by linarith
  have htau :
      |(‖z.1‖ + ‖w.1‖) - (‖z'.1‖ + ‖w'.1‖)| ≤ 8 := by
    refine aux_total_radius_difference_le_eight
      (center := Z.2 - (normalShift + normalShift')) ?_ ?_
    · calc
        |(‖z.1‖ + ‖w.1‖) - (Z.2 - (normalShift + normalShift'))| =
            |-((Z.2 - (‖z.1‖ + ‖w.1‖)) -
              (normalShift + normalShift'))| := by congr 1 <;> ring

        _ = |(Z.2 - (‖z.1‖ + ‖w.1‖) -
              (normalShift + normalShift'))| := by rw [abs_neg]
        _ = |(Z.2 - (‖z.1‖ + ‖w.1‖)) -
              (normalShift + normalShift')| := by ring_nf
        _ ≤ 4 := hnormal
    · calc
        |(‖z'.1‖ + ‖w'.1‖) - (Z.2 - (normalShift + normalShift'))| =
            |-((Z.2 - (‖z'.1‖ + ‖w'.1‖)) -
              (normalShift + normalShift'))| := by congr 1 <;> ring
        _ = |(Z.2 - (‖z'.1‖ + ‖w'.1‖) -
              (normalShift + normalShift'))| := by rw [abs_neg]
        _ = |(Z.2 - (‖z'.1‖ + ‖w'.1‖)) -
              (normalShift + normalShift')| := by ring_nf
        _ ≤ 4 := hnormal'
  have hzradius := aux_mem_unitNormalConicPlate_radius_localized hscalepos hz
  have hz'radius := aux_mem_unitNormalConicPlate_radius_localized hscalepos hz'
  have hradial : |‖z.1‖ - ‖z'.1‖| ≤ 6 * Real.sqrt scale :=
    aux_radial_window_difference_le_six_sqrt hscale hzradius hz'radius
  have htaubounds := aux_sum_radius_bounds (by linarith : 0 ≤ scale)
    hz.1 hz.2.1 hw.1 hw.2.1
  have htau'bounds := aux_sum_radius_bounds (by linarith : 0 ≤ scale)
    hz'.1 hz'.2.1 hw'.1 hw'.2.1
  have hdefect :
      (‖z.1‖ + ‖w.1‖) ^ 2 - ‖Z.1‖ ^ 2 =
        ‖z.1‖ * ‖w.1‖ * ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ^ 2 := by
    calc
      (‖z.1‖ + ‖w.1‖) ^ 2 - ‖Z.1‖ ^ 2 =
          (‖z.1‖ + ‖w.1‖) ^ 2 - ‖z.1 + w.1‖ ^ 2 := by rw [hspace]
      _ = ‖z.1‖ * ‖w.1‖ *
          ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ^ 2 :=
        aux_twoCone_angular_defect_identity z.1 w.1 hznorm (norm_ne_zero_iff.mpr hwnonzero)
  have hdefect' :
      (‖z'.1‖ + ‖w'.1‖) ^ 2 - ‖Z.1‖ ^ 2 =
        ‖z'.1‖ * ‖w'.1‖ * ‖(‖z'.1‖)⁻¹ • z'.1 - (‖w'.1‖)⁻¹ • w'.1‖ ^ 2 := by
    calc
      (‖z'.1‖ + ‖w'.1‖) ^ 2 - ‖Z.1‖ ^ 2 =
          (‖z'.1‖ + ‖w'.1‖) ^ 2 - ‖z'.1 + w'.1‖ ^ 2 := by rw [hspace']
      _ = ‖z'.1‖ * ‖w'.1‖ *
          ‖(‖z'.1‖)⁻¹ • z'.1 - (‖w'.1‖)⁻¹ • w'.1‖ ^ 2 :=
        aux_twoCone_angular_defect_identity z'.1 w'.1 hz'norm (norm_ne_zero_iff.mpr hw'nonzero)
  have hdefect'nonneg : 0 ≤ (‖z'.1‖ + ‖w'.1‖) ^ 2 - ‖Z.1‖ ^ 2 := by
    rw [hdefect']
    positivity
  have hdefect'upper :
      (‖z'.1‖ + ‖w'.1‖) ^ 2 - ‖Z.1‖ ^ 2 ≤ 16 * B ^ 2 * scale := by
    exact aux_defect_upper_of_chord_upper hscalepos hB (norm_nonneg _) (norm_nonneg _)
      hz'.2.1 hw'.2.1 hdefect' hchord (norm_nonneg _)
  have hdefectdiff :
      |((‖z.1‖ + ‖w.1‖) ^ 2 - ‖Z.1‖ ^ 2) -
          ((‖z'.1‖ + ‖w'.1‖) ^ 2 - ‖Z.1‖ ^ 2)| ≤ 128 * scale :=
    aux_defect_difference_le_one_twenty_eight_mul_scale (by linarith : 0 ≤ scale)
      (by positivity) (by positivity) htaubounds.2 htau'bounds.2 htau
  have hstable := aux_polar_inner_coordinate_difference_le_constant
    hscale hz.1 hz'.1 htau hdefectdiff hdefect'nonneg hdefect'upper hradial
  have hpz : inner Real Z.1 ((‖z.1‖)⁻¹ • z.1) =
      (‖z.1‖ + ‖w.1‖) -
        ((‖z.1‖ + ‖w.1‖) ^ 2 - ‖Z.1‖ ^ 2) / (2 * ‖z.1‖) := by
    simpa only [hsub] using aux_twoCone_polar_solve_inner Z.1 z.1 hznorm
  have hpz' : inner Real Z.1 ((‖z'.1‖)⁻¹ • z'.1) =
      (‖z'.1‖ + ‖w'.1‖) -
        ((‖z'.1‖ + ‖w'.1‖) ^ 2 - ‖Z.1‖ ^ 2) / (2 * ‖z'.1‖) := by
    simpa only [hsub'] using aux_twoCone_polar_solve_inner Z.1 z'.1 hz'norm
  rw [hpz, hpz']
  exact hstable

/-- A literal overlap pair supplies all of the coupled two-cone data for the
ellipse reduction.  In particular, the normal-coordinate estimates pin the
*sum* of the two radii, rather than merely placing the summands in independent
annuli. -/
private theorem aux_mem_unitNormalPlateOverlapPairs_twoCone_polar
    {scale angularConstant normalShift normalShift' : Real} {n n' : Int}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {k : Nat} {Z : WaveSpaceTime} {pair : Int × Int}
    (hscale : 0 < scale)
    (hpair : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions k Z) :
    pair ∈ angularSeparationPairs indices k ∧
      ∃ z ∈ unitNormalConicPlate scale angularConstant normalShift n (directions pair.1),
        ∃ w ∈ unitNormalConicPlate scale angularConstant normalShift' n' (directions pair.2),
          z + w = Z ∧
          |(Z.2 - (‖z.1‖ + ‖w.1‖)) - (normalShift + normalShift')| ≤ 4 ∧
          |‖z.1‖ - ((n : Real) * Real.sqrt scale - normalShift)| ≤ Real.sqrt scale + 2 ∧
          |‖w.1‖ - ((n' : Real) * Real.sqrt scale - normalShift')| ≤ Real.sqrt scale + 2 ∧
          ‖(‖z.1‖)⁻¹ • z.1 - directions pair.1‖ ≤
            angularConstant * scale ^ (-(1 / 2 : Real)) ∧
          ‖(‖w.1‖)⁻¹ • w.1 - directions pair.2‖ ≤
            angularConstant * scale ^ (-(1 / 2 : Real)) ∧
          2 * ‖z.1‖ *
              ((‖z.1‖ + ‖w.1‖) - inner Real Z.1 ((‖z.1‖)⁻¹ • z.1)) =
            (‖z.1‖ + ‖w.1‖) ^ 2 - ‖Z.1‖ ^ 2 := by
  rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
    n n' indices directions k Z pair).mp hpair with ⟨hseparation, hsum⟩
  refine ⟨hseparation, ?_⟩
  rcases aux_mem_minkowskiSum_unitNormalConicPlate_twoCone hsum with
    ⟨z, hz, w, hw, hzw, htime⟩
  have hzradial := aux_mem_unitNormalConicPlate_radius_localized hscale hz
  have hwradial := aux_mem_unitNormalConicPlate_radius_localized hscale hw
  have hzdirection := (aux_mem_unitNormalConicPlate_direction_localized hz).2
  have hwdirection := (aux_mem_unitNormalConicPlate_direction_localized hw).2
  have hznonzero := (aux_mem_unitNormalConicPlate_direction_localized hz).1
  have hznormnonzero : ‖z.1‖ ≠ 0 := norm_ne_zero_iff.mpr hznonzero
  have hspace : z.1 + w.1 = Z.1 := congrArg Prod.fst hzw
  have hsub : Z.1 - z.1 = w.1 := by
    rw [← hspace]
    abel
  have hpolar := aux_twoCone_polar_identity Z.1 z.1 hznormnonzero
  refine ⟨z, hz, w, hw, hzw, htime, hzradial, hwradial, hzdirection, hwdirection, ?_⟩
  simpa only [hsub] using hpolar

/-- A pair of bounded integer label windows, used as the final discrete
packing target after the two-branch geometric reduction. -/
private def aux_labelBox (anchor : Int × Int) (B : Nat) : Finset (Int × Int) :=
  Finset.Icc (anchor.1 - (B : Int)) (anchor.1 + (B : Int)) ×ˢ
    Finset.Icc (anchor.2 - (B : Int)) (anchor.2 + (B : Int))

private theorem aux_mem_labelBox_of_natAbs_sub_le
    {pair anchor : Int × Int} {B : Nat}
    (hfirst : (pair.1 - anchor.1).natAbs ≤ B)
    (hsecond : (pair.2 - anchor.2).natAbs ≤ B) :
    pair ∈ aux_labelBox anchor B := by
  simp only [aux_labelBox, Finset.mem_product, Finset.mem_Icc]
  constructor <;> constructor <;> omega

private theorem aux_card_labelBox (anchor : Int × Int) (B : Nat) :
    (aux_labelBox anchor B).card = (2 * B + 1) ^ 2 := by
  simp only [aux_labelBox, Finset.card_product, Int.card_Icc]
  have hfirst :
      (anchor.1 + (B : Int) + 1 - (anchor.1 - (B : Int))).toNat = 2 * B + 1 := by
    omega
  have hsecond :
      (anchor.2 + (B : Int) + 1 - (anchor.2 - (B : Int))).toNat = 2 * B + 1 := by
    omega
  rw [hfirst, hsecond]
  ring

private theorem aux_card_le_two_labelBoxes
    (active : Finset (Int × Int)) (anchor₁ anchor₂ : Int × Int) (B : Nat)
    (hcover : active ⊆ aux_labelBox anchor₁ B ∪ aux_labelBox anchor₂ B) :
    active.card ≤ 2 * (2 * B + 1) ^ 2 := by
  calc
    active.card ≤ (aux_labelBox anchor₁ B ∪ aux_labelBox anchor₂ B).card :=
      Finset.card_le_card hcover
    _ ≤ (aux_labelBox anchor₁ B).card + (aux_labelBox anchor₂ B).card :=
      Finset.card_union_le _ _
    _ = 2 * (2 * B + 1) ^ 2 := by
      rw [aux_card_labelBox, aux_card_labelBox]
      ring

private theorem aux_card_le_three_labelBoxes
    (active : Finset (Int × Int)) (anchor₁ anchor₂ anchor₃ : Int × Int) (B : Nat)
    (hcover : active ⊆ aux_labelBox anchor₁ B ∪ aux_labelBox anchor₂ B ∪
      aux_labelBox anchor₃ B) :
    active.card ≤ 3 * (2 * B + 1) ^ 2 := by
  calc
    active.card ≤
        (aux_labelBox anchor₁ B ∪ aux_labelBox anchor₂ B ∪
          aux_labelBox anchor₃ B).card := Finset.card_le_card hcover
    _ ≤ (aux_labelBox anchor₁ B ∪ aux_labelBox anchor₂ B).card +
        (aux_labelBox anchor₃ B).card := Finset.card_union_le _ _
    _ ≤ (aux_labelBox anchor₁ B).card + (aux_labelBox anchor₂ B).card +
        (aux_labelBox anchor₃ B).card := by
      gcongr
      exact Finset.card_union_le _ _
    _ = 3 * (2 * B + 1) ^ 2 := by
      rw [aux_card_labelBox, aux_card_labelBox, aux_card_labelBox]
      ring

/-- The lower half of `angularSectorGeometry` turns one direction ball of
radius `D * scale⁻¹ᐟ²` into a fixed integer label window. -/
private theorem aux_natAbs_sub_le_of_scaled_direction_bound
    {scale sectorRadius spacingLower spacingUpper D : Real}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {i anchor : Int} {B : Nat}
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hi : i ∈ indices) (hanchor : anchor ∈ indices)
    (hD : D ≤ spacingLower * (B : Real))
    (hdist : ‖directions i - directions anchor‖ ≤
      D * scale ^ (-(1 / 2 : Real))) :
    (i - anchor).natAbs ≤ B := by
  rcases hgeometry with ⟨_, _, hspacingLower, _, _, _, hdata⟩
  have hpow : 0 < scale ^ (-(1 / 2 : Real)) :=
    Real.rpow_pos_of_pos hscale _
  have hlow : spacingLower * ((i - anchor).natAbs : Real) *
      scale ^ (-(1 / 2 : Real)) ≤ ‖directions i - directions anchor‖ :=
    (hdata i hi).2.2 anchor hanchor |>.1
  have hscaled :
      (spacingLower * ((i - anchor).natAbs : Real)) *
        scale ^ (-(1 / 2 : Real)) ≤
      D * scale ^ (-(1 / 2 : Real)) := by
    exact le_trans hlow hdist
  have hquot : spacingLower * ((i - anchor).natAbs : Real) ≤ D := by
    nlinarith [hscaled]
  have hreal : ((i - anchor).natAbs : Real) ≤ B := by
    nlinarith [hquot, hD]
  exact_mod_cast hreal

/-- The discrete conclusion needed from the continuous two-branch geometry:
two `scale⁻¹ᐟ²` direction boxes around active label pairs give a uniform
overlap-cardinality bound. -/
private theorem aux_card_le_two_labelBoxes_of_direction_boxes
    {scale sectorRadius spacingLower spacingUpper D : Real}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (active : Finset (Int × Int)) (anchor₁ anchor₂ : Int × Int) (B : Nat)
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hanchor₁ : anchor₁.1 ∈ indices ∧ anchor₁.2 ∈ indices)
    (hanchor₂ : anchor₂.1 ∈ indices ∧ anchor₂.2 ∈ indices)
    (hactive : ∀ pair ∈ active, pair.1 ∈ indices ∧ pair.2 ∈ indices)
    (hD : D ≤ spacingLower * (B : Real))
    (hcover : ∀ pair ∈ active,
      (‖directions pair.1 - directions anchor₁.1‖ ≤ D * scale ^ (-(1 / 2 : Real)) ∧
        ‖directions pair.2 - directions anchor₁.2‖ ≤ D * scale ^ (-(1 / 2 : Real))) ∨
      (‖directions pair.1 - directions anchor₂.1‖ ≤ D * scale ^ (-(1 / 2 : Real)) ∧
        ‖directions pair.2 - directions anchor₂.2‖ ≤ D * scale ^ (-(1 / 2 : Real))) ) :
    active.card ≤ 2 * (2 * B + 1) ^ 2 := by
  apply aux_card_le_two_labelBoxes active anchor₁ anchor₂ B
  intro pair hpair
  rcases hactive pair hpair with ⟨hfirst, hsecond⟩
  rcases hcover pair hpair with hleft | hright
  · apply Finset.mem_union_left
    apply aux_mem_labelBox_of_natAbs_sub_le
    · exact aux_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hfirst
        hanchor₁.1 hD hleft.1
    · exact aux_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hsecond
        hanchor₁.2 hD hleft.2
  · apply Finset.mem_union_right
    apply aux_mem_labelBox_of_natAbs_sub_le
    · exact aux_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hfirst
        hanchor₂.1 hD hright.1
    · exact aux_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hsecond
        hanchor₂.2 hD hright.2

private theorem aux_low_scale_unitNormal_overlap_card_bound
    {scale angularConstant sectorRadius spacingLower spacingUpper : Real}
    {normalShift normalShift' : Real} {n n' : Int}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {k : Nat} {Z : WaveSpaceTime} {B : Nat}
    (hscale : 2 ≤ scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hcap : 1 / 2 ≤ 2 * |angularConstant| * scale ^ (-(1 / 2 : Real)))
    (hB : 2 * |angularConstant| ≤ spacingLower * (B : Real)) :
    (unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions k Z).card ≤ 2 * (2 * B + 1) ^ 2 := by
  classical
  let active := unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
    n n' indices directions k Z
  have hgeometryFull := hgeometry
  rcases hgeometry with ⟨_, hsector, _, _, center, _, hdata⟩
  have hscalepos : 0 < scale := by linarith
  by_cases hnonempty : active.Nonempty
  · obtain ⟨anchor, hanchor⟩ := hnonempty
    apply aux_card_le_two_labelBoxes_of_direction_boxes
      (active := active) (anchor₁ := anchor) (anchor₂ := anchor)
      (D := 2 * |angularConstant|) (B := B) hscalepos hgeometryFull
    · have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hanchor
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z anchor).mp hanchor' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.2.1⟩
    · have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hanchor
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z anchor).mp hanchor' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.2.1⟩
    · intro pair hpair
      have hpair' : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hpair
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z pair).mp hpair' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices k pair).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices k pair).mp hsep |>.2.1⟩
    · exact hB
    · intro pair hpair
      have hpair' : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hpair
      have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hanchor
      have hpsep := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
        normalShift' n n' indices directions k Z pair).mp hpair' |>.1
      have hasep := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
        normalShift' n n' indices directions k Z anchor).mp hanchor' |>.1
      have hpdata := (mem_angularSeparationPairs_iff indices k pair).mp hpsep
      have hadata := (mem_angularSeparationPairs_iff indices k anchor).mp hasep
      have hfirst : ‖directions pair.1 - directions anchor.1‖ ≤ 1 / 2 := by
        calc
          ‖directions pair.1 - directions anchor.1‖ ≤
              ‖directions pair.1 - center‖ + ‖center - directions anchor.1‖ := by
            rw [show directions pair.1 - directions anchor.1 =
              (directions pair.1 - center) + (center - directions anchor.1) by abel]
            exact norm_add_le _ _
          _ = ‖directions pair.1 - center‖ + ‖directions anchor.1 - center‖ := by
            exact congrArg (fun q : Real => ‖directions pair.1 - center‖ + q)
              (norm_sub_rev _ _)
          _ ≤ sectorRadius + sectorRadius := add_le_add
            (hdata pair.1 hpdata.1).2.1 (hdata anchor.1 hadata.1).2.1
          _ ≤ 1 / 2 := by linarith
      have hsecond : ‖directions pair.2 - directions anchor.2‖ ≤ 1 / 2 := by
        calc
          ‖directions pair.2 - directions anchor.2‖ ≤
              ‖directions pair.2 - center‖ + ‖center - directions anchor.2‖ := by
            rw [show directions pair.2 - directions anchor.2 =
              (directions pair.2 - center) + (center - directions anchor.2) by abel]
            exact norm_add_le _ _
          _ = ‖directions pair.2 - center‖ + ‖directions anchor.2 - center‖ := by
            exact congrArg (fun q : Real => ‖directions pair.2 - center‖ + q)
              (norm_sub_rev _ _)
          _ ≤ sectorRadius + sectorRadius := add_le_add
            (hdata pair.2 hpdata.2.1).2.1 (hdata anchor.2 hadata.2.1).2.1
          _ ≤ 1 / 2 := by linarith
      exact Or.inl ⟨le_trans hfirst hcap, le_trans hsecond hcap⟩
  · have hempty : active = ∅ := Finset.not_nonempty_iff_eq_empty.mp hnonempty
    simp [active, hempty]

/-- The coupled polar-coordinate calculation on one fixed area-sign branch.
This is deliberately phrased for literal witnesses so the finite packing step
can classify canonical witnesses without losing the normal/time coupling. -/
private theorem aux_transverse_same_sign_first_normalized_bound
    (o : Orientation Real (_root_.Codex.Spherical.SurfaceCore.Euclidean 2) (Fin 2))
    {scale h sq B lambda C ell angularConstant normalShift normalShift' : Real}
    {n n' : Int}
    {direction mate direction' mate' : _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {Z z w z' w' : WaveSpaceTime}
    (hscale : 2 ≤ scale) (hh : 0 < h) (hhdef : h = scale ^ (-(1 / 2 : Real)))
    (hsq : 1 ≤ sq) (hsqroot : sq = Real.sqrt scale)
    (hhsq : h * sq = 1) (hhsquare : h ^ 2 * scale = 1)
    (hell : 0 < ell) (helllambda : ell ≤ lambda)
    (hC : 0 ≤ C) (hB : 0 ≤ B) (hlambda : 0 ≤ lambda)
    (hcompare : B ≤ C * lambda) (hlambdah : lambda * h ≤ 1 / 4)
    (hXlower : scale / 4 ≤ ‖Z.1‖)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction)
    (hw : w ∈ unitNormalConicPlate scale angularConstant normalShift' n' mate)
    (hz' : z' ∈ unitNormalConicPlate scale angularConstant normalShift n direction')
    (hw' : w' ∈ unitNormalConicPlate scale angularConstant normalShift' n' mate')
    (hzw : z + w = Z) (hz'w' : z' + w' = Z)
    (hchord : ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ≤ B * h)
    (hchord' : ‖(‖z'.1‖)⁻¹ • z'.1 - (‖w'.1‖)⁻¹ • w'.1‖ ≤ B * h)
    (hclose : ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ≤ 1)
    (hclose' : ‖(‖z'.1‖)⁻¹ • z'.1 - (‖w'.1‖)⁻¹ • w'.1‖ ≤ 1)
    (hgap : lambda * h ≤ ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖)
    (hgap' : lambda * h ≤ ‖(‖z'.1‖)⁻¹ • z'.1 - (‖w'.1‖)⁻¹ • w'.1‖)
    (hsign :
      (0 ≤ (o.areaForm Z.1) ((‖z.1‖)⁻¹ • z.1) ∧
        0 ≤ (o.areaForm Z.1) ((‖z'.1‖)⁻¹ • z'.1)) ∨
      ((o.areaForm Z.1) ((‖z.1‖)⁻¹ • z.1) ≤ 0 ∧
        (o.areaForm Z.1) ((‖z'.1‖)⁻¹ • z'.1) ≤ 0)) :
    ‖(‖z.1‖)⁻¹ • z.1 - (‖z'.1‖)⁻¹ • z'.1‖ ≤
      ((1056 + 192 * C ^ 2) + (4224 / ell + 1536 * C ^ 2)) * h := by
  have hscalepos : 0 < scale := by linarith
  have hlambdapos : 0 < lambda := lt_of_lt_of_le hell helllambda
  have hXpos : 0 < ‖Z.1‖ := by linarith
  have hXnonzero : Z.1 ≠ 0 := norm_ne_zero_iff.mp (ne_of_gt hXpos)
  have hznonzero : z.1 ≠ 0 := hz.2.2.1.1
  have hwnonzero : w.1 ≠ 0 := hw.2.2.1.1
  have hz'nonzero : z'.1 ≠ 0 := hz'.2.2.1.1
  have hw'nonzero : w'.1 ≠ 0 := hw'.2.2.1.1
  have hzu := aux_norm_normalized_eq_one hznonzero
  have hwu := aux_norm_normalized_eq_one hwnonzero
  have hzu' := aux_norm_normalized_eq_one hz'nonzero
  have hwu' := aux_norm_normalized_eq_one hw'nonzero
  have hspace : z.1 + w.1 = Z.1 := congrArg Prod.fst hzw
  have hspace' : z'.1 + w'.1 = Z.1 := congrArg Prod.fst hz'w'
  have hzrepr := aux_eq_norm_smul_normalized hznonzero
  have hwrepr := aux_eq_norm_smul_normalized hwnonzero
  have hz'repr := aux_eq_norm_smul_normalized hz'nonzero
  have hw'repr := aux_eq_norm_smul_normalized hw'nonzero
  have hrepr : Z.1 =
      ‖z.1‖ • ((‖z.1‖)⁻¹ • z.1) + ‖w.1‖ • ((‖w.1‖)⁻¹ • w.1) := by
    calc
      Z.1 = z.1 + w.1 := hspace.symm
      _ = ‖z.1‖ • ((‖z.1‖)⁻¹ • z.1) + ‖w.1‖ • ((‖w.1‖)⁻¹ • w.1) :=
        congrArg₂ (· + ·) hzrepr hwrepr
  have hrepr' : Z.1 =
      ‖z'.1‖ • ((‖z'.1‖)⁻¹ • z'.1) + ‖w'.1‖ • ((‖w'.1‖)⁻¹ • w'.1) := by
    calc
      Z.1 = z'.1 + w'.1 := hspace'.symm
      _ = ‖z'.1‖ • ((‖z'.1‖)⁻¹ • z'.1) + ‖w'.1‖ • ((‖w'.1‖)⁻¹ • w'.1) :=
        congrArg₂ (· + ·) hz'repr hw'repr
  have harea : lambda * sq / 8 ≤ |(o.areaForm Z.1) ((‖z.1‖)⁻¹ • z.1)| := by
    have harea' := aux_transverse_area_lower_of_chord_lower o hscalepos hw.1 hlambda
      hrepr hzu hwu hclose (by simpa [hhdef] using hgap)
    simpa [hsqroot] using harea'
  have harea' : lambda * sq / 8 ≤ |(o.areaForm Z.1) ((‖z'.1‖)⁻¹ • z'.1)| := by
    have harea'' := aux_transverse_area_lower_of_chord_lower o hscalepos hw'.1 hlambda
      hrepr' hzu' hwu' hclose' (by simpa [hhdef] using hgap')
    simpa [hsqroot] using harea''
  have hinner := aux_two_active_polar_inner_coordinate_stable hscale hB
    hz hw hz' hw' hzw hz'w' (by
      simpa [hhdef] using hchord')
  have hinner' : |inner Real Z.1 ((‖z.1‖)⁻¹ • z.1) -
      inner Real Z.1 ((‖z'.1‖)⁻¹ • z'.1)| ≤ 264 + 768 * B ^ 2 * h := by
    simpa [hhdef] using hinner
  have hquot := aux_transverse_coordinate_quotient_bounds
    hscale hh hsq hhsq hhsquare hell helllambda hC hB hlambda hcompare hlambdah
  have hDnonneg : 0 ≤ 264 + 768 * B ^ 2 * h := by positivity
  have hquarterpos : 0 < scale / 4 := by linarith
  have hXquot : (264 + 768 * B ^ 2 * h) / ‖Z.1‖ ≤
      (1056 + 192 * C ^ 2) * h := by
    calc
      (264 + 768 * B ^ 2 * h) / ‖Z.1‖ ≤
          (264 + 768 * B ^ 2 * h) / (scale / 4) := by
        exact div_le_div_of_nonneg_left hDnonneg hquarterpos hXlower
      _ ≤ (1056 + 192 * C ^ 2) * h := hquot.1
  exact aux_same_sign_direction_bound_of_coordinate_bounds o hXpos
    (by positivity : 0 < lambda * sq / 8) hzu hzu' ⟨harea, harea'⟩ hsign hinner'
    hXquot hquot.2

private def aux_transverseCoreConstant (spacingLower spacingUpper : Real) : Real :=
  (1056 + 192 * (4 * spacingUpper / spacingLower + 1) ^ 2) +
    (4224 / (spacingLower / 2) +
      1536 * (4 * spacingUpper / spacingLower + 1) ^ 2)

private def aux_transverseCapConstant
    (angularConstant spacingLower spacingUpper : Real) : Real :=
  2 * |angularConstant| + 48 +
    16 * aux_transverseCoreConstant spacingLower spacingUpper

set_option maxHeartbeats 800000 in
/-- The high transverse branch has two stable directional caps, one for each
area sign.  This is the literal pairwise cap estimate used by the finite
label-box cover. -/
private theorem aux_high_transverse_same_sign_direction_boxes
    (o : Orientation Real (_root_.Codex.Spherical.SurfaceCore.Euclidean 2) (Fin 2))
    {scale angularConstant sectorRadius spacingLower spacingUpper : Real}
    {normalShift normalShift' : Real} {n n' : Int}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {m : Nat} {Z : WaveSpaceTime} {pair anchor : Int × Int}
    (hscale : 2 ≤ scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (htransverse : 4 * |angularConstant| <
      spacingLower * ((2 ^ m : Nat) : Real))
    (hpair : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z)
    (hanchor : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z)
    (hsign :
      (0 ≤ (o.areaForm Z.1)
          (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair) ∧
        0 ≤ (o.areaForm Z.1)
          (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor)) ∨
      ((o.areaForm Z.1)
          (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair) ≤ 0 ∧
        (o.areaForm Z.1)
          (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor) ≤ 0)) :
    ‖directions pair.1 - directions anchor.1‖ ≤
        aux_transverseCapConstant angularConstant spacingLower spacingUpper *
          scale ^ (-(1 / 2 : Real)) ∧
      ‖directions pair.2 - directions anchor.2‖ ≤
        aux_transverseCapConstant angularConstant spacingLower spacingUpper *
          scale ^ (-(1 / 2 : Real)) := by
  have hgeometryFull := hgeometry
  rcases hgeometry with ⟨_, hsector, hspacingLower, hspacingUpper,
    center, hcenter, hdata⟩
  have hscalepos : 0 < scale := by linarith
  have hpowpos : 0 < scale ^ (-(1 / 2 : Real)) := Real.rpow_pos_of_pos hscalepos _
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := hpowpos.le
  have hsq : 1 ≤ Real.sqrt scale := Real.one_le_sqrt.mpr (by linarith)
  have hhsq := aux_rpow_neg_half_mul_sqrt_eq_one hscalepos
  have hhsquare := aux_rpow_neg_half_sq_mul_scale_eq_one hscalepos
  have hqpos : 0 < ((2 ^ m : Nat) : Real) := by positivity
  have hqone : 1 ≤ ((2 ^ m : Nat) : Real) := by
    exact_mod_cast (Nat.one_le_two_pow)
  have hell : 0 < spacingLower / 2 := by positivity
  have helllambda : spacingLower / 2 ≤
      spacingLower * ((2 ^ m : Nat) : Real) / 2 := by
    have hmul : spacingLower * 1 ≤ spacingLower * ((2 ^ m : Nat) : Real) :=
      mul_le_mul_of_nonneg_left hqone hspacingLower.le
    nlinarith [hmul]
  have hlambda : 0 ≤ spacingLower * ((2 ^ m : Nat) : Real) / 2 := by positivity
  have hU : 0 ≤ 2 * spacingUpper * ((2 ^ m : Nat) : Real) + 2 * |angularConstant| := by
    positivity
  have hC : 0 ≤ 4 * spacingUpper / spacingLower + 1 := by positivity
  have hcompare :
      2 * spacingUpper * ((2 ^ m : Nat) : Real) + 2 * |angularConstant| ≤
        (4 * spacingUpper / spacingLower + 1) *
          (spacingLower * ((2 ^ m : Nat) : Real) / 2) := by
    have harea : 2 * |angularConstant| ≤
        spacingLower * ((2 ^ m : Nat) : Real) / 2 := by
      nlinarith [htransverse]
    calc
      2 * spacingUpper * ((2 ^ m : Nat) : Real) + 2 * |angularConstant| ≤
          2 * spacingUpper * ((2 ^ m : Nat) : Real) +
            spacingLower * ((2 ^ m : Nat) : Real) / 2 := by gcongr
      _ = (4 * spacingUpper / spacingLower + 1) *
          (spacingLower * ((2 ^ m : Nat) : Real) / 2) := by
          field_simp [ne_of_gt hspacingLower]
          ring
  have hsepPair := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
    normalShift' n n' indices directions (m + 1) Z pair).mp hpair |>.1

  have hsepAnchor := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
    normalShift' n n' indices directions (m + 1) Z anchor).mp hanchor |>.1
  have hcentersPair := aux_angular_direction_chord_bounds_succ hscalepos hgeometryFull hsepPair
  have hcentersAnchor := aux_angular_direction_chord_bounds_succ hscalepos hgeometryFull hsepAnchor
  have hscaled := aux_scaled_dyadic_index_le_half hscalepos hgeometryFull hsepPair
  have hlambdah : (spacingLower * ((2 ^ m : Nat) : Real) / 2) *
      scale ^ (-(1 / 2 : Real)) ≤ 1 / 4 := by
    nlinarith [hscaled]
  have hpdata := (mem_angularSeparationPairs_iff indices (m + 1) pair).mp hsepPair
  have hadata := (mem_angularSeparationPairs_iff indices (m + 1) anchor).mp hsepAnchor
  rcases aux_active_pair_witness_spec scale angularConstant normalShift normalShift'
    n n' indices directions (m + 1) Z pair hpair with ⟨hpz, hpw, hpzw⟩
  rcases aux_active_pair_witness_spec scale angularConstant normalShift normalShift'
    n n' indices directions (m + 1) Z anchor hanchor with ⟨haz, haw, hazw⟩
  have hpzerr := aux_plate_normalized_direction_bound_abs hscalepos hpz
  have hpwerr := aux_plate_normalized_direction_bound_abs hscalepos hpw
  have hazerr := aux_plate_normalized_direction_bound_abs hscalepos haz
  have hawerr := aux_plate_normalized_direction_bound_abs hscalepos haw
  have hpchordlower : (spacingLower * ((2 ^ m : Nat) : Real) / 2) *
      scale ^ (-(1 / 2 : Real)) ≤
        ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions (m + 1) Z pair).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair).1.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair).2.1‖ := by
    have hraw := aux_chord_lower_of_center_direction_bounds hcentersPair.1 hpzerr hpwerr
    calc
      (spacingLower * ((2 ^ m : Nat) : Real) / 2) *
          scale ^ (-(1 / 2 : Real)) ≤
          (spacingLower * ((2 ^ m : Nat) : Real) - 2 * |angularConstant|) *
            scale ^ (-(1 / 2 : Real)) := by
          apply mul_le_mul_of_nonneg_right _ hpow
          nlinarith [htransverse]
      _ ≤ _ := hraw
  have hachordlower : (spacingLower * ((2 ^ m : Nat) : Real) / 2) *
      scale ^ (-(1 / 2 : Real)) ≤
        ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions (m + 1) Z anchor).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor).1.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor).2.1‖ := by
    have hraw := aux_chord_lower_of_center_direction_bounds hcentersAnchor.1 hazerr hawerr
    calc
      (spacingLower * ((2 ^ m : Nat) : Real) / 2) *
          scale ^ (-(1 / 2 : Real)) ≤
          (spacingLower * ((2 ^ m : Nat) : Real) - 2 * |angularConstant|) *
            scale ^ (-(1 / 2 : Real)) := by
          apply mul_le_mul_of_nonneg_right _ hpow
          nlinarith [htransverse]
      _ ≤ _ := hraw
  have hpchord : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z pair).1.1‖)⁻¹ •
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z pair).1.1 -
      (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z pair).2.1‖)⁻¹ •
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z pair).2.1‖ ≤
      (2 * spacingUpper * ((2 ^ m : Nat) : Real) + 2 * |angularConstant|) *
        scale ^ (-(1 / 2 : Real)) := by
    have hupper : ‖directions pair.1 - directions pair.2‖ ≤
        (2 * spacingUpper * ((2 ^ m : Nat) : Real)) *
          scale ^ (-(1 / 2 : Real)) := by
      calc
        ‖directions pair.1 - directions pair.2‖ ≤
            spacingUpper * ((2 ^ (m + 1) : Nat) : Real) *
              scale ^ (-(1 / 2 : Real)) := hcentersPair.2
        _ = (2 * spacingUpper * ((2 ^ m : Nat) : Real)) *
              scale ^ (-(1 / 2 : Real)) := by
              have hpowtwo : ((2 ^ (m + 1) : Nat) : Real) =
                  2 * ((2 ^ m : Nat) : Real) := by
                rw [pow_succ, Nat.cast_mul]
                norm_num
                ring
              rw [hpowtwo]
              ring
    exact aux_chord_upper_of_center_direction_bounds hupper hpzerr hpwerr
  have hachord : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z anchor).1.1‖)⁻¹ •
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z anchor).1.1 -
      (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z anchor).2.1‖)⁻¹ •
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z anchor).2.1‖ ≤
      (2 * spacingUpper * ((2 ^ m : Nat) : Real) + 2 * |angularConstant|) *
        scale ^ (-(1 / 2 : Real)) := by
    have hupper : ‖directions anchor.1 - directions anchor.2‖ ≤
        (2 * spacingUpper * ((2 ^ m : Nat) : Real)) *
          scale ^ (-(1 / 2 : Real)) := by
      calc
        ‖directions anchor.1 - directions anchor.2‖ ≤
            spacingUpper * ((2 ^ (m + 1) : Nat) : Real) *
              scale ^ (-(1 / 2 : Real)) := hcentersAnchor.2
        _ = (2 * spacingUpper * ((2 ^ m : Nat) : Real)) *
              scale ^ (-(1 / 2 : Real)) := by
              have hpowtwo : ((2 ^ (m + 1) : Nat) : Real) =
                  2 * ((2 ^ m : Nat) : Real) := by
                rw [pow_succ, Nat.cast_mul]
                norm_num
                ring
              rw [hpowtwo]
              ring
    exact aux_chord_upper_of_center_direction_bounds hupper hazerr hawerr
  have hcenterPair : ‖directions pair.1 - directions pair.2‖ ≤ 1 / 2 := by
    calc
      ‖directions pair.1 - directions pair.2‖ ≤
          ‖directions pair.1 - center‖ + ‖center - directions pair.2‖ := by
        rw [show directions pair.1 - directions pair.2 =
          (directions pair.1 - center) + (center - directions pair.2) by abel]
        exact norm_add_le _ _
      _ = ‖directions pair.1 - center‖ + ‖directions pair.2 - center‖ := by
        exact congrArg (fun q : Real => ‖directions pair.1 - center‖ + q)
          (norm_sub_rev center (directions pair.2))
      _ ≤ sectorRadius + sectorRadius := by
        apply add_le_add
        · exact (hdata pair.1 hpdata.1).2.1
        · exact (hdata pair.2 hpdata.2.1).2.1
      _ ≤ 1 / 2 := by linarith
  have hcenterAnchor : ‖directions anchor.1 - directions anchor.2‖ ≤ 1 / 2 := by
    calc
      ‖directions anchor.1 - directions anchor.2‖ ≤
          ‖directions anchor.1 - center‖ + ‖center - directions anchor.2‖ := by
        rw [show directions anchor.1 - directions anchor.2 =
          (directions anchor.1 - center) + (center - directions anchor.2) by abel]
        exact norm_add_le _ _
      _ = ‖directions anchor.1 - center‖ + ‖directions anchor.2 - center‖ := by
        exact congrArg (fun q : Real => ‖directions anchor.1 - center‖ + q)
          (norm_sub_rev center (directions anchor.2))
      _ ≤ sectorRadius + sectorRadius := by
        apply add_le_add
        · exact (hdata anchor.1 hadata.1).2.1
        · exact (hdata anchor.2 hadata.2.1).2.1
      _ ≤ 1 / 2 := by linarith
  have hpclose := aux_normalized_chord_le_one_of_high_common_sector hscalepos hhigh
    hcenterPair hpz hpw
  have haclose := aux_normalized_chord_le_one_of_high_common_sector hscalepos hhigh
    hcenterAnchor haz haw
  have hXlower := aux_output_norm_lower_of_high_sector_witnesses hscale hcenter
    (le_trans (hdata pair.1 hpdata.1).2.1 hsector)
    (le_trans (hdata pair.2 hpdata.2.1).2.1 hsector) hhigh hpz hpw hpzw
  have hfirstnorm := aux_transverse_same_sign_first_normalized_bound o
    hscale hpowpos rfl hsq rfl hhsq hhsquare hell helllambda hC hU hlambda hcompare hlambdah
    hXlower hpz hpw haz haw hpzw hazw hpchord hachord hpclose haclose
    hpchordlower hachordlower (by
      simpa only [aux_activeFirstNormalized] using hsign)
  have hcore : 0 ≤ aux_transverseCoreConstant spacingLower spacingUpper := by
    simp only [aux_transverseCoreConstant]
    positivity
  have hfirstnorm' : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z pair).1.1‖)⁻¹ •
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z pair).1.1 -
      (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z anchor).1.1‖)⁻¹ •
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z anchor).1.1‖ ≤
      aux_transverseCoreConstant spacingLower spacingUpper *
        scale ^ (-(1 / 2 : Real)) := by
    simpa only [aux_transverseCoreConstant] using hfirstnorm
  have hfirst := aux_direction_centres_close_of_normalized_pair
    hpzerr hazerr hfirstnorm'
  have hzradial := aux_mem_unitNormalConicPlate_radius_localized hscalepos hpz
  have hazradial := aux_mem_unitNormalConicPlate_radius_localized hscalepos haz
  have hwradial := aux_mem_unitNormalConicPlate_radius_localized hscalepos hpw
  have hawradial := aux_mem_unitNormalConicPlate_radius_localized hscalepos haw
  have hrdiff := aux_radial_window_difference_le_six_sqrt hscale hzradial hazradial
  have hsdiff := aux_radial_window_difference_le_six_sqrt hscale hwradial hawradial
  have hpznonzero : (aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z pair).1.1 ≠ 0 := hpz.2.2.1.1
  have hpwnonzero : (aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z pair).2.1 ≠ 0 := hpw.2.2.1.1
  have haznonzero : (aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z anchor).1.1 ≠ 0 := haz.2.2.1.1
  have hawnonzero : (aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z anchor).2.1 ≠ 0 := haw.2.2.1.1
  have hsecondnorm := aux_second_direction_bound_of_first_and_radial_windows
    hscalepos hcore (norm_nonneg _) hpz.2.1 hpw.1 hrdiff hsdiff hfirstnorm'
    (aux_norm_normalized_eq_one haznonzero)
    (aux_norm_normalized_eq_one hawnonzero)
    (by
      have hpzrepr := aux_eq_norm_smul_normalized hpznonzero
      have hpwrepr := aux_eq_norm_smul_normalized hpwnonzero
      have hspace : (aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions (m + 1) Z pair).1.1 +
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair).2.1 = Z.1 := congrArg Prod.fst hpzw
      calc
        Z.1 = (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair).1.1 +
            (aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z pair).2.1 := hspace.symm
        _ = ‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair).1.1‖ •
            ((‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z pair).1.1‖)⁻¹ •
              (aux_active_pair_witness scale angularConstant normalShift normalShift'
                n n' indices directions (m + 1) Z pair).1.1) +
            ‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z pair).2.1‖ •
            ((‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z pair).2.1‖)⁻¹ •
              (aux_active_pair_witness scale angularConstant normalShift normalShift'
                n n' indices directions (m + 1) Z pair).2.1) := congrArg₂ (· + ·) hpzrepr hpwrepr)
    (by
      have hazrepr := aux_eq_norm_smul_normalized haznonzero
      have hawrepr := aux_eq_norm_smul_normalized hawnonzero
      have hspace : (aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions (m + 1) Z anchor).1.1 +
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor).2.1 = Z.1 := congrArg Prod.fst hazw
      calc
        Z.1 = (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor).1.1 +
            (aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z anchor).2.1 := hspace.symm
        _ = ‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor).1.1‖ •
            ((‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z anchor).1.1‖)⁻¹ •
              (aux_active_pair_witness scale angularConstant normalShift normalShift'
                n n' indices directions (m + 1) Z anchor).1.1) +
            ‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z anchor).2.1‖ •
            ((‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z anchor).2.1‖)⁻¹ •
              (aux_active_pair_witness scale angularConstant normalShift normalShift'
                n n' indices directions (m + 1) Z anchor).2.1) := congrArg₂ (· + ·) hazrepr hawrepr)
  have hsecond := aux_direction_centres_close_of_normalized_pair hpwerr hawerr hsecondnorm
  constructor
  · calc
      ‖directions pair.1 - directions anchor.1‖ ≤
          (2 * |angularConstant| + aux_transverseCoreConstant spacingLower spacingUpper) *
            scale ^ (-(1 / 2 : Real)) := hfirst
      _ ≤ aux_transverseCapConstant angularConstant spacingLower spacingUpper *
            scale ^ (-(1 / 2 : Real)) := by
            apply mul_le_mul_of_nonneg_right _ hpow
            simp only [aux_transverseCapConstant]
            nlinarith [hcore]
  · calc
      ‖directions pair.2 - directions anchor.2‖ ≤
          (2 * |angularConstant| +
            (48 + 16 * aux_transverseCoreConstant spacingLower spacingUpper)) *
            scale ^ (-(1 / 2 : Real)) := hsecond
      _ = aux_transverseCapConstant angularConstant spacingLower spacingUpper *
            scale ^ (-(1 / 2 : Real)) := by
            simp only [aux_transverseCapConstant]
            ring

private theorem aux_card_le_one_labelBox_of_direction_box
    {scale sectorRadius spacingLower spacingUpper D : Real}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    (active : Finset (Int × Int)) (anchor : Int × Int) (B : Nat)
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hanchor : anchor.1 ∈ indices ∧ anchor.2 ∈ indices)
    (hactive : ∀ pair ∈ active, pair.1 ∈ indices ∧ pair.2 ∈ indices)
    (hD : D ≤ spacingLower * (B : Real))
    (hcover : ∀ pair ∈ active,
      ‖directions pair.1 - directions anchor.1‖ ≤ D * scale ^ (-(1 / 2 : Real)) ∧
      ‖directions pair.2 - directions anchor.2‖ ≤ D * scale ^ (-(1 / 2 : Real))) :
    active.card ≤ (2 * B + 1) ^ 2 := by
  calc
    active.card ≤ (aux_labelBox anchor B).card := by
      apply Finset.card_le_card
      intro pair hpair
      rcases hactive pair hpair with ⟨hfirst, hsecond⟩
      rcases hcover pair hpair with ⟨hfirstbox, hsecondbox⟩
      exact aux_mem_labelBox_of_natAbs_sub_le
        (aux_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hfirst hanchor.1 hD hfirstbox)
        (aux_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hsecond hanchor.2 hD hsecondbox)
    _ = (2 * B + 1) ^ 2 := aux_card_labelBox anchor B

set_option maxHeartbeats 1200000 in
private theorem aux_high_transverse_overlap_card_bound
    {scale angularConstant sectorRadius spacingLower spacingUpper : Real}
    {normalShift normalShift' : Real} {n n' : Int}
    {indices : Finset Int} {directions : Int → _root_.Codex.Spherical.SurfaceCore.Euclidean 2}
    {m : Nat} {Z : WaveSpaceTime} {B : Nat}
    (hscale : 2 ≤ scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (htransverse : 4 * |angularConstant| <
      spacingLower * ((2 ^ m : Nat) : Real))
    (hB : aux_transverseCapConstant angularConstant spacingLower spacingUpper ≤
      spacingLower * (B : Real)) :
    (unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z).card ≤ 2 * (2 * B + 1) ^ 2 := by
  classical
  let active := unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
    n n' indices directions (m + 1) Z
  let o : Orientation Real (_root_.Codex.Spherical.SurfaceCore.Euclidean 2) (Fin 2) :=
    (EuclideanSpace.basisFun (Fin 2) Real).toBasis.orientation
  let positive : Finset (Int × Int) := active.filter fun pair =>
    0 ≤ (o.areaForm Z.1)
      (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z pair)
  let negative : Finset (Int × Int) := active.filter fun pair =>
    ¬ 0 ≤ (o.areaForm Z.1)
      (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z pair)
  have hscalepos : 0 < scale := by linarith
  have hactiveIndices : ∀ pair ∈ active, pair.1 ∈ indices ∧ pair.2 ∈ indices := by
    intro pair hpair
    have hpair' : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
        normalShift' n n' indices directions (m + 1) Z := by simpa [active] using hpair
    have hsep := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
      normalShift' n n' indices directions (m + 1) Z pair).mp hpair' |>.1
    exact ⟨(mem_angularSeparationPairs_iff indices (m + 1) pair).mp hsep |>.1,
      (mem_angularSeparationPairs_iff indices (m + 1) pair).mp hsep |>.2.1⟩
  have hsplit : active ⊆ positive ∪ negative := by
    intro pair hpair
    by_cases hp : 0 ≤ (o.areaForm Z.1)
        (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
          n n' indices directions (m + 1) Z pair)
    · apply Finset.mem_union_left
      exact Finset.mem_filter.mpr ⟨hpair, hp⟩
    · apply Finset.mem_union_right
      exact Finset.mem_filter.mpr ⟨hpair, hp⟩
  have hpositiveBound : positive.card ≤ (2 * B + 1) ^ 2 := by
    by_cases hpos : positive.Nonempty
    · obtain ⟨anchor, hanchor⟩ := hpos
      apply aux_card_le_one_labelBox_of_direction_box positive anchor B hscalepos hgeometry
      · exact hactiveIndices anchor (Finset.mem_filter.mp hanchor).1
      · intro pair hpair
        exact hactiveIndices pair (Finset.mem_filter.mp hpair).1
      · exact hB
      · intro pair hpair
        have hpairActive := (Finset.mem_filter.mp hpair).1
        have hpairSign := (Finset.mem_filter.mp hpair).2
        have hanchorActive := (Finset.mem_filter.mp hanchor).1
        have hanchorSign := (Finset.mem_filter.mp hanchor).2
        have hboxes := aux_high_transverse_same_sign_direction_boxes o hscale hgeometry
          hhigh htransverse
          (by simpa [active] using hpairActive)
          (by simpa [active] using hanchorActive)
          (Or.inl ⟨hpairSign, hanchorSign⟩)
        exact hboxes
    · have hempty : positive = ∅ := Finset.not_nonempty_iff_eq_empty.mp hpos
      simp [hempty]
  have hnegativeBound : negative.card ≤ (2 * B + 1) ^ 2 := by
    by_cases hneg : negative.Nonempty
    · obtain ⟨anchor, hanchor⟩ := hneg
      apply aux_card_le_one_labelBox_of_direction_box negative anchor B hscalepos hgeometry
      · exact hactiveIndices anchor (Finset.mem_filter.mp hanchor).1
      · intro pair hpair
        exact hactiveIndices pair (Finset.mem_filter.mp hpair).1
      · exact hB
      · intro pair hpair
        have hpairActive := (Finset.mem_filter.mp hpair).1
        have hpairSign := (Finset.mem_filter.mp hpair).2
        have hanchorActive := (Finset.mem_filter.mp hanchor).1
        have hanchorSign := (Finset.mem_filter.mp hanchor).2
        have hpairNonpos : (o.areaForm Z.1)
            (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z pair) ≤ 0 :=
          le_of_lt (lt_of_not_ge hpairSign)
        have hanchorNonpos : (o.areaForm Z.1)
            (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z anchor) ≤ 0 :=
          le_of_lt (lt_of_not_ge hanchorSign)
        have hboxes := aux_high_transverse_same_sign_direction_boxes o hscale hgeometry
          hhigh htransverse
          (by simpa [active] using hpairActive)
          (by simpa [active] using hanchorActive)
          (Or.inr ⟨hpairNonpos, hanchorNonpos⟩)
        exact hboxes
    · have hempty : negative = ∅ := Finset.not_nonempty_iff_eq_empty.mp hneg
      simp [hempty]
  calc
    active.card ≤ (positive ∪ negative).card := Finset.card_le_card hsplit
    _ ≤ positive.card + negative.card := Finset.card_union_le _ _
    _ ≤ (2 * B + 1) ^ 2 + (2 * B + 1) ^ 2 := add_le_add hpositiveBound hnegativeBound
    _ = 2 * (2 * B + 1) ^ 2 := by ring

set_option maxHeartbeats 1200000 in
theorem translatedUnitNormalPlateOverlap_of_angularSectorGeometry
    (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real) :
    translatedUnitNormalPlateOverlap maxLevel angularConstant sectorRadius
      spacingLower spacingUpper := by
  classical
  by_cases hspacingLower : 0 < spacingLower
  · by_cases hspacingUpper : 0 < spacingUpper
    · let Dlow : Real := 2 * |angularConstant|
      let Dzero : Real := 2 * |angularConstant| +
        32 * (spacingUpper + 2 * |angularConstant|)
      let Dtangent : Real := 2 * |angularConstant| +
        32 * (8 * |angularConstant| * spacingUpper / spacingLower +
          2 * |angularConstant|)
      let Dtransverse : Real :=
        aux_transverseCapConstant angularConstant spacingLower spacingUpper
      let D : Real := Dlow + Dzero + Dtangent + Dtransverse
      have hDlow0 : 0 ≤ Dlow := by
        simp only [Dlow]
        positivity
      have hDzero0 : 0 ≤ Dzero := by
        simp only [Dzero]
        positivity
      have hDtangent0 : 0 ≤ Dtangent := by
        simp only [Dtangent]
        positivity
      have hDtransverse0 : 0 ≤ Dtransverse := by
        simp only [Dtransverse, aux_transverseCapConstant,
          aux_transverseCoreConstant]
        positivity
      have hDlow : Dlow ≤ D := by
        dsimp [D]
        nlinarith
      have hDzero : Dzero ≤ D := by
        dsimp [D]
        nlinarith
      have hDtangent : Dtangent ≤ D := by
        dsimp [D]
        nlinarith
      have hDtransverse : Dtransverse ≤ D := by
        dsimp [D]
        nlinarith
      obtain ⟨B, hB⟩ := exists_nat_gt (D / spacingLower)
      refine ⟨2 * (2 * B + 1) ^ 2, ?_⟩
      intro scale hscale radialIndices angularIndices directions hgeometry
        n hn n' hn' k hk Z normalShift normalShift'
      have hBD : D ≤ spacingLower * (B : Real) := by
        simpa [mul_comm] using (div_lt_iff₀ hspacingLower).mp hB |>.le
      have hBlow : 2 * |angularConstant| ≤ spacingLower * (B : Real) := by
        calc
          2 * |angularConstant| = Dlow := by simp only [Dlow]
          _ ≤ D := hDlow
          _ ≤ spacingLower * (B : Real) := hBD
      have hBzero : 2 * |angularConstant| +
          32 * (spacingUpper + 2 * |angularConstant|) ≤ spacingLower * (B : Real) := by
        calc
          2 * |angularConstant| + 32 * (spacingUpper + 2 * |angularConstant|) = Dzero := by
            simp only [Dzero]
          _ ≤ D := hDzero
          _ ≤ spacingLower * (B : Real) := hBD
      have hBtangent : 2 * |angularConstant| +
          32 * (8 * |angularConstant| * spacingUpper / spacingLower +
            2 * |angularConstant|) ≤ spacingLower * (B : Real) := by
        calc
          2 * |angularConstant| +
              32 * (8 * |angularConstant| * spacingUpper / spacingLower +
                2 * |angularConstant|) = Dtangent := by simp only [Dtangent]
          _ ≤ D := hDtangent
          _ ≤ spacingLower * (B : Real) := hBD
      have hBtransverse : aux_transverseCapConstant angularConstant spacingLower spacingUpper ≤
          spacingLower * (B : Real) := by
        calc
          aux_transverseCapConstant angularConstant spacingLower spacingUpper = Dtransverse := by
            simp only [Dtransverse]
          _ ≤ D := hDtransverse
          _ ≤ spacingLower * (B : Real) := hBD
      by_cases hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4
      · cases k with
        | zero =>
            simpa [unitNormalPlateOverlapMultiplicity] using
              (aux_high_zero_unitNormal_overlap_card_bound hscale hgeometry hhigh hBzero)
        | succ m =>
            by_cases htangent : spacingLower * ((2 ^ m : Nat) : Real) ≤
                4 * |angularConstant|
            · simpa [unitNormalPlateOverlapMultiplicity] using
                (aux_high_tangent_overlap_card_bound hscale hgeometry hhigh htangent hBtangent)
            · have htransverse : 4 * |angularConstant| <
                spacingLower * ((2 ^ m : Nat) : Real) := lt_of_not_ge htangent
              simpa [unitNormalPlateOverlapMultiplicity] using
                (aux_high_transverse_overlap_card_bound hscale hgeometry hhigh htransverse
                  hBtransverse)
      · have hcap : 1 / 2 ≤
          2 * |angularConstant| * scale ^ (-(1 / 2 : Real)) := by
            nlinarith [lt_of_not_ge hhigh]
        simpa [unitNormalPlateOverlapMultiplicity] using
          (aux_low_scale_unitNormal_overlap_card_bound hscale hgeometry hcap hBlow)
    · refine ⟨0, ?_⟩
      intro scale hscale radialIndices angularIndices directions hgeometry
        n hn n' hn' k hk Z normalShift normalShift'
      rcases hgeometry with ⟨_, _, _, hupper, _, _, _⟩
      exact False.elim (hspacingUpper hupper)
  · refine ⟨0, ?_⟩
    intro scale hscale radialIndices angularIndices directions hgeometry
      n hn n' hn' k hk Z normalShift normalShift'
    rcases hgeometry with ⟨_, _, hlower, _, _, _, _⟩
    exact False.elim (hspacingLower hlower)

/-- Conditional thick-plate overlap transfer.  The only geometric hypothesis
is `translatedUnitNormalPlateOverlap`; the finite `4 ℤ` normal cover and its
two-factor cardinality loss are proved above. -/
theorem plateOverlap_of_translatedUnitNormalPlateOverlap
    (maxLevel : Real → Nat) (angularConstant sectorRadius spacingLower spacingUpper : Real)
    (hangular : 0 < angularConstant)
    (hunit : translatedUnitNormalPlateOverlap maxLevel angularConstant
      sectorRadius spacingLower spacingUpper) :
    plateOverlap maxLevel angularConstant sectorRadius spacingLower spacingUpper := by
  rcases hunit with ⟨M, hM⟩
  refine ⟨hangular, 2, by norm_num, ?_⟩
  intro gamma hgamma hgammaUpper
  refine ⟨36 * (M : Real) + 1, by positivity, ?_⟩
  intro scale hscale radialIndices angularIndices directions hgeometry n hn n' hn' k hk Z
  let normalShifts : Finset Real := normalCoverShifts (scale ^ gamma)
  have hcover : normalCoordinatePlateCover scale gamma angularConstant normalShifts := by
    simpa [normalShifts] using
      normalCoordinatePlateCover_normalCoverShifts scale gamma angularConstant
  have hunitBound : ∀ shift ∈ normalShifts, ∀ shift' ∈ normalShifts,
      unitNormalPlateOverlapMultiplicity scale angularConstant shift shift'
        n n' angularIndices directions k Z ≤ M := by
    intro shift hshift shift' hshift'
    exact hM scale hscale radialIndices angularIndices directions hgeometry n hn n' hn'
      k hk Z shift shift'
  have hnat := plateOverlapMultiplicity_le_normalCover_mul_unitBound
    scale gamma angularConstant normalShifts n n' angularIndices directions k Z M hcover hunitBound
  have hmult : (plateOverlapMultiplicity scale gamma angularConstant n n'
      angularIndices directions k Z : Real) ≤
      (normalShifts.card : Real) * (normalShifts.card : Real) * (M : Real) := by
    exact_mod_cast hnat
  have hcard : (normalShifts.card : Real) ≤ 6 * scale ^ gamma := by
    simpa [normalShifts] using
      card_normalCoverShifts_at_scale_le_six_mul scale gamma hscale hgamma.le
  have hcard0 : 0 ≤ (normalShifts.card : Real) := Nat.cast_nonneg _
  have hsquare : (normalShifts.card : Real) * (normalShifts.card : Real) ≤
      (6 * scale ^ gamma) * (6 * scale ^ gamma) :=
    mul_self_le_mul_self hcard0 hcard
  have hM0 : 0 ≤ (M : Real) := Nat.cast_nonneg _
  have hscaled : (normalShifts.card : Real) * (normalShifts.card : Real) * (M : Real) ≤
      (6 * scale ^ gamma) * (6 * scale ^ gamma) * (M : Real) :=
    mul_le_mul_of_nonneg_right hsquare hM0
  have hscale0 : 0 ≤ scale := by linarith
  have hscalePos : 0 < scale := by linarith
  have hrpow : scale ^ gamma * scale ^ gamma = scale ^ (2 * gamma) := by
    rw [← Real.rpow_add hscalePos]
    congr 1
    ring
  have htarget0 : 0 ≤ scale ^ (2 * gamma) := Real.rpow_nonneg hscale0 _
  calc
    (plateOverlapMultiplicity scale gamma angularConstant n n'
        angularIndices directions k Z : Real) ≤
        (normalShifts.card : Real) * (normalShifts.card : Real) * (M : Real) := hmult
    _ ≤ (6 * scale ^ gamma) * (6 * scale ^ gamma) * (M : Real) := hscaled
    _ = 36 * (M : Real) * scale ^ (2 * gamma) := by rw [← hrpow]; ring
    _ ≤ (36 * (M : Real) + 1) * scale ^ (2 * gamma) := by
      apply mul_le_mul_of_nonneg_right
      · linarith
      · exact htarget0

/-- The literal unit-normal overlap theorem closes the conditional plate-overlap transfer. -/
theorem plateOverlap_of_angularSectorGeometry
    (maxLevel : Real → Nat) (angularConstant sectorRadius spacingLower spacingUpper : Real)
    (hangular : 0 < angularConstant) :
    plateOverlap maxLevel angularConstant sectorRadius spacingLower spacingUpper := by
  exact plateOverlap_of_translatedUnitNormalPlateOverlap maxLevel angularConstant
    sectorRadius spacingLower spacingUpper hangular
    (translatedUnitNormalPlateOverlap_of_angularSectorGeometry maxLevel angularConstant
      sectorRadius spacingLower spacingUpper)

/-- The finite output-frequency fourth-power quantity attached to the literal
thick conic plate-overlap fibers. -/
noncomputable def finitePlateOverlapSquareEnergy
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (outputs : Finset WaveSpaceTime)
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) : Real :=
  ∑ Z ∈ outputs,
    (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
      ‖F pair.1 z * G pair.2 z‖) ^ 2

/-- The actual finite cube identifiers whose supplied output-frequency label
equals a specified conic pair-sum frequency. -/
noncomputable def plateOverlapCubeOutputFiber {κ : Type*} [DecidableEq κ]
    (cubes : Finset κ) (output : κ → WaveSpaceTime) (Z : WaveSpaceTime) : Finset κ := by
  classical
  exact cubes.filter (fun cube => output cube = Z)

theorem mem_plateOverlapCubeOutputFiber_iff {κ : Type*} [DecidableEq κ]
    (cubes : Finset κ) (output : κ → WaveSpaceTime) (Z : WaveSpaceTime) (cube : κ) :
    cube ∈ plateOverlapCubeOutputFiber cubes output Z ↔ cube ∈ cubes ∧ output cube = Z := by
  classical
  simp [plateOverlapCubeOutputFiber]

/-- A finite concrete realization of plate pairs.  The data explicitly give
each cube an angular-pair owner and an output-frequency label, require the
label to lie in that pair's plate sum, and require `(output, owner)` to be
injective on the selected cubes.  Thus each output fiber injects into the
literal plate-overlap fiber.  This is combinatorial only: it does not assert
that the existing half-wave cube packets supply these data. -/
theorem card_plateOverlapCubeOutputFiber_le_plateOverlapMultiplicity_of_pairRealization
    {κ : Type*} [DecidableEq κ]
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat)
    (cubes : Finset κ) (owner : κ → Int × Int) (output : κ → WaveSpaceTime)
    (howner : ∀ cube ∈ cubes, owner cube ∈ angularSeparationPairs indices k)
    (hsum : ∀ cube ∈ cubes,
      output cube ∈ minkowskiSum
        (conicPlate scale gamma angularConstant n (directions (owner cube).1))
        (conicPlate scale gamma angularConstant n' (directions (owner cube).2)))
    (hinj : ∀ ⦃cube cube' : κ⦄, cube ∈ cubes → cube' ∈ cubes →
      output cube = output cube' → owner cube = owner cube' → cube = cube')
    (Z : WaveSpaceTime) :
    (plateOverlapCubeOutputFiber cubes output Z).card ≤
      plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z := by
  classical
  apply Finset.card_le_card_of_injOn owner
  · intro cube hcube
    have hcube' := (mem_plateOverlapCubeOutputFiber_iff cubes output Z cube).mp hcube
    apply (mem_plateOverlapPairs_iff scale gamma angularConstant n n' indices directions k Z
      (owner cube)).mpr
    refine ⟨howner cube hcube'.1, ?_⟩
    simpa only [hcube'.2] using hsum cube hcube'.1
  · intro cube hcube cube' hcube' hownerEq
    have hcubeMem := (mem_plateOverlapCubeOutputFiber_iff cubes output Z cube).mp hcube
    have hcubeMem' := (mem_plateOverlapCubeOutputFiber_iff cubes output Z cube').mp hcube'
    exact hinj hcubeMem.1 hcubeMem'.1 (hcubeMem.2.trans hcubeMem'.2.symm) hownerEq

/-- Combining a finite cube-to-pair realization with `plateOverlap` controls
every concrete output fiber by the same geometric scale loss. -/
theorem exists_card_plateOverlapCubeOutputFiber_le_scaled_of_plateOverlap
    {κ : Type*} [DecidableEq κ]
    (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real)
    (hplate : plateOverlap maxLevel angularConstant sectorRadius spacingLower spacingUpper)
    (gamma : Real) (hgamma : 0 < gamma) (hgammaUpper : gamma < 1 / 10)
    (scale : Real) (hscale : 2 ≤ scale)
    (radialIndices angularIndices : Finset Int) (directions : Int → Euclidean 2)
    (hgeometry : angularSectorGeometry scale angularIndices directions
      sectorRadius spacingLower spacingUpper)
    (n : Int) (hn : n ∈ radialIndices) (n' : Int) (hn' : n' ∈ radialIndices)
    (k : Nat) (hk : k ≤ maxLevel scale)
    (cubes : Finset κ) (owner : κ → Int × Int) (output : κ → WaveSpaceTime)
    (howner : ∀ cube ∈ cubes, owner cube ∈ angularSeparationPairs angularIndices k)
    (hsum : ∀ cube ∈ cubes,
      output cube ∈ minkowskiSum
        (conicPlate scale gamma angularConstant n (directions (owner cube).1))
        (conicPlate scale gamma angularConstant n' (directions (owner cube).2)))
    (hinj : ∀ ⦃cube cube' : κ⦄, cube ∈ cubes → cube' ∈ cubes →
      output cube = output cube' → owner cube = owner cube' → cube = cube')
    (Z : WaveSpaceTime) :
    ∃ overlapExponent : Real, 0 < overlapExponent ∧
      ∃ Cgamma : Real, 0 < Cgamma ∧
        ((plateOverlapCubeOutputFiber cubes output Z).card : Real) ≤
          Cgamma * scale ^ (overlapExponent * gamma) := by
  rcases hplate with ⟨_, overlapExponent, hoverlapExponent, hplate⟩
  rcases hplate gamma hgamma hgammaUpper with ⟨Cgamma, hCgamma, hbound⟩
  refine ⟨overlapExponent, hoverlapExponent, Cgamma, hCgamma, ?_⟩
  have hcard := card_plateOverlapCubeOutputFiber_le_plateOverlapMultiplicity_of_pairRealization
    scale gamma angularConstant n n' angularIndices directions k cubes owner output
    howner hsum hinj Z
  have hcardReal : ((plateOverlapCubeOutputFiber cubes output Z).card : Real) ≤
      (plateOverlapMultiplicity scale gamma angularConstant n n'
        angularIndices directions k Z : Real) := by
    exact_mod_cast hcard
  exact hcardReal.trans
    (hbound scale hscale radialIndices angularIndices directions hgeometry
      n hn n' hn' k hk Z)

/-- The literal thick-plate overlap predicate supplies the expected scaled
finite Cauchy--Schwarz estimate for one output fiber. -/
theorem exists_sq_sum_norm_mul_plateOverlapPairs_le_scaled_of_plateOverlap
    (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real)
    (hplate : plateOverlap maxLevel angularConstant sectorRadius spacingLower spacingUpper)
    (gamma : Real) (hgamma : 0 < gamma) (hgammaUpper : gamma < 1 / 10)
    (scale : Real) (hscale : 2 ≤ scale)
    (radialIndices angularIndices : Finset Int) (directions : Int → Euclidean 2)
    (hgeometry : angularSectorGeometry scale angularIndices directions
      sectorRadius spacingLower spacingUpper)
    (n : Int) (hn : n ∈ radialIndices) (n' : Int) (hn' : n' ∈ radialIndices)
    (k : Nat) (hk : k ≤ maxLevel scale) (Z : WaveSpaceTime)
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    ∃ overlapExponent : Real, 0 < overlapExponent ∧
      ∃ Cgamma : Real, 0 < Cgamma ∧
        (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
            angularIndices directions k Z, ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
          (Cgamma * scale ^ (overlapExponent * gamma)) *
            ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
              angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
  rcases hplate with ⟨_, overlapExponent, hoverlapExponent, hplate⟩
  rcases hplate gamma hgamma hgammaUpper with ⟨Cgamma, hCgamma, hbound⟩
  refine ⟨overlapExponent, hoverlapExponent, Cgamma, hCgamma, ?_⟩
  have hmult :
      (plateOverlapMultiplicity scale gamma angularConstant n n'
        angularIndices directions k Z : Real) ≤
        Cgamma * scale ^ (overlapExponent * gamma) :=
    hbound scale hscale radialIndices angularIndices directions hgeometry
      n hn n' hn' k hk Z
  have henergy : 0 ≤
      ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
          angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
    Finset.sum_nonneg fun pair hpair =>
      mul_nonneg (sq_nonneg _) (sq_nonneg _)
  calc
    (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
        angularIndices directions k Z, ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
        (plateOverlapMultiplicity scale gamma angularConstant n n'
          angularIndices directions k Z : Real) *
          ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
            angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
      sq_sum_norm_mul_plateOverlapPairs_le_plateOverlapMultiplicity_mul_sum_sq
        scale gamma angularConstant n n' angularIndices directions k Z F G z
    _ ≤ (Cgamma * scale ^ (overlapExponent * gamma)) *
          ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
            angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
      mul_le_mul_of_nonneg_right hmult henergy

/-- Summing the preceding literal plate-overlap estimate over a finite output
frequency set gives the finite fourth-power overlap-square-function bound. -/
theorem exists_finitePlateOverlapSquareEnergy_le_scaled_of_plateOverlap
    (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real)
    (hplate : plateOverlap maxLevel angularConstant sectorRadius spacingLower spacingUpper)
    (gamma : Real) (hgamma : 0 < gamma) (hgammaUpper : gamma < 1 / 10)
    (scale : Real) (hscale : 2 ≤ scale)
    (radialIndices angularIndices : Finset Int) (directions : Int → Euclidean 2)
    (hgeometry : angularSectorGeometry scale angularIndices directions
      sectorRadius spacingLower spacingUpper)
    (n : Int) (hn : n ∈ radialIndices) (n' : Int) (hn' : n' ∈ radialIndices)
    (k : Nat) (hk : k ≤ maxLevel scale) (outputs : Finset WaveSpaceTime)
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    ∃ overlapExponent : Real, 0 < overlapExponent ∧
      ∃ Cgamma : Real, 0 < Cgamma ∧
        finitePlateOverlapSquareEnergy scale gamma angularConstant n n'
          angularIndices directions k outputs F G z ≤
          (Cgamma * scale ^ (overlapExponent * gamma)) *
            ∑ Z ∈ outputs,
              ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
                angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
  rcases hplate with ⟨_, overlapExponent, hoverlapExponent, hplate⟩
  rcases hplate gamma hgamma hgammaUpper with ⟨Cgamma, hCgamma, hbound⟩
  refine ⟨overlapExponent, hoverlapExponent, Cgamma, hCgamma, ?_⟩
  unfold finitePlateOverlapSquareEnergy
  calc
    (∑ Z ∈ outputs,
      (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
          angularIndices directions k Z, ‖F pair.1 z * G pair.2 z‖) ^ 2) ≤
        ∑ Z ∈ outputs, (Cgamma * scale ^ (overlapExponent * gamma)) *
          ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
            angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
      apply Finset.sum_le_sum
      intro Z hZ
      have hmult :
          (plateOverlapMultiplicity scale gamma angularConstant n n'
            angularIndices directions k Z : Real) ≤
            Cgamma * scale ^ (overlapExponent * gamma) :=
        hbound scale hscale radialIndices angularIndices directions hgeometry
          n hn n' hn' k hk Z
      have henergy : 0 ≤
          ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
              angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
        Finset.sum_nonneg fun pair hpair =>
          mul_nonneg (sq_nonneg _) (sq_nonneg _)
      calc
        (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
            angularIndices directions k Z, ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
            (plateOverlapMultiplicity scale gamma angularConstant n n'
              angularIndices directions k Z : Real) *
              ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
                angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
          sq_sum_norm_mul_plateOverlapPairs_le_plateOverlapMultiplicity_mul_sum_sq
            scale gamma angularConstant n n' angularIndices directions k Z F G z
        _ ≤ (Cgamma * scale ^ (overlapExponent * gamma)) *
              ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
                angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
          mul_le_mul_of_nonneg_right hmult henergy
