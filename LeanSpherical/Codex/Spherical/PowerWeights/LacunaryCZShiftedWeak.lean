        intro x hx hball
        apply hx
        exact Set.mem_iUnion₂.mpr ⟨q, hq, hball⟩
      have hmono :
          (∫ x : Euclidean d in (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ,
            lacunaryRelativeBandpassPhysicalThreeWayTail psi j r q.scale
