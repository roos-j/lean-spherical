private theorem weak_one_iSup_int_exhaustion
    {α : Type*} [MeasurableSpace α] {μ : Measure α}
    (u : ℤ → α → ℝ) (C J : ENNReal)
    (hbound : ∀ (K : Finset ℤ) (hK : K.Nonempty) {s : ℝ}, 0 < s →
      ENNReal.ofReal s * μ {x | s < K.sup' hK (fun k => u k x)} ≤ C * J) :
    ∀ {s : ℝ}, 0 < s →
      ENNReal.ofReal s * μ {x | ENNReal.ofReal s <
        ⨆ k : ℤ, ENNReal.ofReal (u k x)} ≤ C * J := by
  intro s hs
  let K : ℕ → Finset ℤ := fun n => Finset.Icc (-((n : ℤ))) (n : ℤ)
  have hKnonempty (n : ℕ) : (K n).Nonempty := by
    refine ⟨0, ?_⟩
    simp [K]
  let v : ℕ → α → ℝ := fun n x =>
    (K n).sup' (hKnonempty n) (fun k => u k x)
  have hK_mono (n m : ℕ) (hnm : n ≤ m) : K n ⊆ K m := by
    intro k hk
    rw [Finset.mem_Icc] at hk ⊢
    constructor <;> omega
  have hv_mono : Monotone v := by
    intro n m hnm x
    change (K n).sup' (hKnonempty n) (fun k => u k x) ≤
      (K m).sup' (hKnonempty m) (fun k => u k x)
    exact Finset.sup'_mono _ (hK_mono n m hnm) (hKnonempty n)
  let A : ℕ → Set α := fun n => {x | s < v n x}
  have hA_mono : Monotone A := by
    intro n m hnm x hx
    exact hx.trans_le (hv_mono hnm x)
  have hsub : {x | ENNReal.ofReal s <
      ⨆ k : ℤ, ENNReal.ofReal (u k x)} ⊆ ⋃ n : ℕ, A n := by
    intro x hx
    change ENNReal.ofReal s < ⨆ k : ℤ, ENNReal.ofReal (u k x) at hx
    obtain ⟨k, hk⟩ := lt_iSup_iff.mp hx
    let n : ℕ := k.natAbs
    have hkn : k ∈ K n := by
      simp only [K, Finset.mem_Icc]
      dsimp only [n]
      omega
    have hreal : s < u k x :=
      (ENNReal.ofReal_lt_ofReal_iff'.mp hk).1
    have hle : u k x ≤ v n x := by
      change u k x ≤ (K n).sup' (hKnonempty n) (fun l => u l x)
      exact Finset.le_sup' (fun l => u l x) hkn
    exact Set.mem_iUnion.mpr ⟨n, hreal.trans_le hle⟩
  calc
    ENNReal.ofReal s * μ {x | ENNReal.ofReal s <
        ⨆ k : ℤ, ENNReal.ofReal (u k x)} ≤
        ENNReal.ofReal s * μ (⋃ n : ℕ, A n) :=
      mul_le_mul_of_nonneg_left (measure_mono hsub) (by positivity)
    _ = ENNReal.ofReal s * ⨆ n : ℕ, μ (A n) := by
      rw [hA_mono.measure_iUnion]
    _ = ⨆ n : ℕ, ENNReal.ofReal s * μ (A n) := by
      rw [ENNReal.mul_iSup]
    _ ≤ C * J := by
      apply iSup_le
      intro n
      simpa only [A, v] using hbound (K n) (hKnonempty n) hs

