private theorem lintegral_iSup_int_exhaustion_rpow_le
    {α : Type*} [MeasurableSpace α] {μ : Measure α}
    (u : ℤ → α → ℝ) (hu_meas : ∀ k, Measurable (u k))
    (hu_nonneg : ∀ k x, 0 ≤ u k x) (p : ℝ) (hp : 0 < p) {B : ENNReal}
    (hbound : ∀ (K : Finset ℤ) (hK : K.Nonempty),
      (∫⁻ x, (ENNReal.ofReal (K.sup' hK (fun k => u k x))) ^ p ∂μ) ≤ B) :
    (∫⁻ x, (⨆ k : ℤ, ENNReal.ofReal (u k x)) ^ p ∂μ) ≤ B := by
  let K : ℕ → Finset ℤ := fun n => Finset.Icc (-((n : ℤ))) (n : ℤ)
  have hKnonempty (n : ℕ) : (K n).Nonempty := by
    refine ⟨0, ?_⟩
    simp [K]
  let v : ℕ → α → ℝ := fun n x =>
    (K n).sup' (hKnonempty n) (fun k => u k x)
  have hv_meas (n : ℕ) : Measurable (v n) := by
    have hsup_apply : ((K n).sup' (hKnonempty n) u : α → ℝ) = v n := by
      funext x
      exact Finset.sup'_apply (hKnonempty n) u x
    rw [← hsup_apply]
    exact Finset.measurable_sup' (hKnonempty n) (fun k _ => hu_meas k)
  have hv_nonneg (n : ℕ) (x : α) : 0 ≤ v n x := by
    obtain ⟨k, hk, hmax⟩ :=
      (K n).exists_mem_eq_sup' (hKnonempty n) (fun k => u k x)
    change 0 ≤ (K n).sup' (hKnonempty n) (fun k => u k x)
    rw [hmax]
    exact hu_nonneg k x
  have hK_mono (n m : ℕ) (hnm : n ≤ m) : K n ⊆ K m := by
    intro k hk
    rw [Finset.mem_Icc] at hk ⊢
    constructor <;> omega
  have hv_mono : Monotone v := by
    intro n m hnm x
    change (K n).sup' (hKnonempty n) (fun k => u k x) ≤
      (K m).sup' (hKnonempty m) (fun k => u k x)
    exact Finset.sup'_mono _ (hK_mono n m hnm) (hKnonempty n)
  have hF_meas (n : ℕ) : Measurable (fun x => (ENNReal.ofReal (v n x)) ^ p) :=
    ENNReal.continuous_rpow_const.measurable.comp
      (ENNReal.continuous_ofReal.measurable.comp (hv_meas n))
  have hF_mono : Monotone (fun n : ℕ => fun x => (ENNReal.ofReal (v n x)) ^ p) := by
    intro n m hnm x
    exact ENNReal.rpow_le_rpow
      (ENNReal.ofReal_le_ofReal (hv_mono hnm x)) hp.le
  have hexhaust (x : α) :
      (⨆ k : ℤ, ENNReal.ofReal (u k x)) =
        ⨆ n : ℕ, ENNReal.ofReal (v n x) := by
    apply le_antisymm
    · apply iSup_le
      intro k
      let n : ℕ := k.natAbs
      have hk : k ∈ K n := by
        simp only [K, Finset.mem_Icc]
        dsimp only [n]
        omega
      exact le_iSup_of_le n (ENNReal.ofReal_le_ofReal
        (Finset.le_sup' (fun l => u l x) hk))
    · apply iSup_le
      intro n
      obtain ⟨k, hk, hmax⟩ :=
        (K n).exists_mem_eq_sup' (hKnonempty n) (fun k => u k x)
      change ENNReal.ofReal ((K n).sup' (hKnonempty n) (fun k => u k x)) ≤ _
      rw [hmax]
      exact le_iSup (fun l : ℤ => ENNReal.ofReal (u l x)) k
  have hpow_le (x : α) :
      (⨆ n : ℕ, ENNReal.ofReal (v n x)) ^ p ≤
        ⨆ n : ℕ, (ENNReal.ofReal (v n x)) ^ p := by
    have hroot : (⨆ n : ℕ, ENNReal.ofReal (v n x)) ≤
        (⨆ n : ℕ, (ENNReal.ofReal (v n x)) ^ p) ^ (1 / p) := by
      apply iSup_le
      intro n
      calc
        ENNReal.ofReal (v n x) = ((ENNReal.ofReal (v n x)) ^ p) ^ (1 / p) := by
          symm
          rw [← ENNReal.rpow_mul, mul_one_div_cancel hp.ne', ENNReal.rpow_one]
        _ ≤ (⨆ n : ℕ, (ENNReal.ofReal (v n x)) ^ p) ^ (1 / p) :=
          ENNReal.rpow_le_rpow (le_iSup (fun n : ℕ =>
            (ENNReal.ofReal (v n x)) ^ p) n) (one_div_nonneg.mpr hp.le)
    calc
      (⨆ n : ℕ, ENNReal.ofReal (v n x)) ^ p ≤
          ((⨆ n : ℕ, (ENNReal.ofReal (v n x)) ^ p) ^ (1 / p)) ^ p :=
        ENNReal.rpow_le_rpow hroot hp.le
      _ = ⨆ n : ℕ, (ENNReal.ofReal (v n x)) ^ p := by
        rw [← ENNReal.rpow_mul]
        field_simp
        simp
  calc
    (∫⁻ x, (⨆ k : ℤ, ENNReal.ofReal (u k x)) ^ p ∂μ) =
        ∫⁻ x, (⨆ n : ℕ, ENNReal.ofReal (v n x)) ^ p ∂μ := by
          congr with x
          rw [hexhaust]
    _ ≤ ∫⁻ x, ⨆ n : ℕ, (ENNReal.ofReal (v n x)) ^ p ∂μ :=
      lintegral_mono hpow_le
    _ = ⨆ n : ℕ, ∫⁻ x, (ENNReal.ofReal (v n x)) ^ p ∂μ :=
