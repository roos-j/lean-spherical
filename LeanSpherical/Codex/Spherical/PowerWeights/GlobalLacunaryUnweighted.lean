/-- A uniform weak-one bound for each colour costs only the cardinality of
the finite entropy palette.  This is the selector contribution in the
finite-block palette comparison. -/
theorem weak_one_lacunaryRelativeBandpassFinitePhysicalPaletteMaximal
    {d N : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (r : Fin N → ℤ → PositiveRadius) (S : Finset ℤ) (hS : S.Nonempty)
    (W : ENNReal)
    (hweak : ∀ i : Fin N, ∀ (g : SchwartzMap (Euclidean d) ℂ) {t : ℝ}, 0 < t →
      ENNReal.ofReal t * volume {x |
        t < lacunaryRelativeBandpassFinitePhysicalMaximal psi j (r i) S hS
          (g : Euclidean d → ℂ) x} ≤
        W * ∫⁻ x, ENNReal.ofReal ‖g x‖)
    (f : SchwartzMap (Euclidean d) ℂ) {t : ℝ} (ht : 0 < t) :
    ENNReal.ofReal t * volume {x |
      ENNReal.ofReal t < lacunaryRelativeBandpassFinitePhysicalPaletteMaximal psi j r S hS
        (f : Euclidean d → ℂ) x} ≤
      (N : ENNReal) * W * ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
  let A : Fin N → Set (Euclidean d) := fun i => {x |
    t < lacunaryRelativeBandpassFinitePhysicalMaximal psi j (r i) S hS
      (f : Euclidean d → ℂ) x}
  have hsub : {x |
      ENNReal.ofReal t < lacunaryRelativeBandpassFinitePhysicalPaletteMaximal psi j r S hS
        (f : Euclidean d → ℂ) x} ⊆ ⋃ i ∈ (Finset.univ : Finset (Fin N)), A i := by
    intro x hx
    change ENNReal.ofReal t < ⨆ i : Fin N, ENNReal.ofReal
      (lacunaryRelativeBandpassFinitePhysicalMaximal psi j (r i) S hS
        (f : Euclidean d → ℂ) x) at hx
    rcases (lt_iSup_iff.mp hx) with ⟨i, hi⟩
    change ENNReal.ofReal t < ENNReal.ofReal
      (lacunaryRelativeBandpassFinitePhysicalMaximal psi j (r i) S hS
        (f : Euclidean d → ℂ) x) at hi
    have hi' : t < lacunaryRelativeBandpassFinitePhysicalMaximal psi j (r i) S hS
        (f : Euclidean d → ℂ) x :=
      (ENNReal.ofReal_lt_ofReal_iff_of_nonneg ht.le).mp hi
    exact Set.mem_iUnion.mpr ⟨i, Set.mem_iUnion.mpr ⟨Finset.mem_univ i, hi'⟩⟩
  have hmeasure : volume {x |
      ENNReal.ofReal t < lacunaryRelativeBandpassFinitePhysicalPaletteMaximal psi j r S hS
        (f : Euclidean d → ℂ) x} ≤ ∑ i : Fin N, volume (A i) := by
    calc
      volume {x |
          ENNReal.ofReal t < lacunaryRelativeBandpassFinitePhysicalPaletteMaximal psi j r S hS
            (f : Euclidean d → ℂ) x} ≤
          volume (⋃ i ∈ (Finset.univ : Finset (Fin N)), A i) := measure_mono hsub
      _ ≤ ∑ i ∈ (Finset.univ : Finset (Fin N)), volume (A i) :=
        measure_biUnion_finset_le _ _
      _ = ∑ i : Fin N, volume (A i) := by simp
  have hsum : ∑ i : Fin N, ENNReal.ofReal t * volume (A i) ≤
      ∑ i : Fin N, W * ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
    apply Finset.sum_le_sum
    intro i _
    exact hweak i f ht
  calc
    ENNReal.ofReal t * volume {x |
        ENNReal.ofReal t < lacunaryRelativeBandpassFinitePhysicalPaletteMaximal psi j r S hS
          (f : Euclidean d → ℂ) x} ≤
        ENNReal.ofReal t * ∑ i : Fin N, volume (A i) :=
      by simpa only [mul_comm] using
        mul_le_mul_right hmeasure (ENNReal.ofReal t)
    _ = ∑ i : Fin N, ENNReal.ofReal t * volume (A i) := by
      rw [Finset.mul_sum]
    _ ≤ ∑ i : Fin N, W * ∫⁻ x, ENNReal.ofReal ‖f x‖ := hsum
    _ = (N : ENNReal) * W * ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
      simp [Finset.sum_const, nsmul_eq_mul]
      ring

/-- The all-scale version of the finite entropy palette. -/
def lacunaryRelativeBandpassPhysicalPaletteMaximalAll
    {d N : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (r : Fin N → ℤ → PositiveRadius) (g : Euclidean d → ℂ) : Euclidean d → ENNReal :=
  fun x => ⨆ i : Fin N, lacunaryRelativeBandpassPhysicalMaximalAll psi j (r i) g x

/-- Passing every colour to all physical scales preserves the palette
weak-one cost `N`. -/
theorem weak_one_lacunaryRelativeBandpassPhysicalPaletteMaximalAll_of_finite
    {d N : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (r : Fin N → ℤ → PositiveRadius) (W : ENNReal)
    (hweak : ∀ i : Fin N, ∀ (S : Finset ℤ) (hS : S.Nonempty)
      (g : SchwartzMap (Euclidean d) ℂ) {t : ℝ}, 0 < t →
      ENNReal.ofReal t * volume {x |
        t < lacunaryRelativeBandpassFinitePhysicalMaximal psi j (r i) S hS
          (g : Euclidean d → ℂ) x} ≤
        W * ∫⁻ x, ENNReal.ofReal ‖g x‖)
    (f : SchwartzMap (Euclidean d) ℂ) {t : ℝ} (ht : 0 < t) :
    ENNReal.ofReal t * volume {x |
      ENNReal.ofReal t < lacunaryRelativeBandpassPhysicalPaletteMaximalAll psi j r
        (f : Euclidean d → ℂ) x} ≤
      (N : ENNReal) * W * ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
  let A : Fin N → Set (Euclidean d) := fun i => {x |
    ENNReal.ofReal t < lacunaryRelativeBandpassPhysicalMaximalAll psi j (r i)
      (f : Euclidean d → ℂ) x}
  have hcolor (i : Fin N) : ENNReal.ofReal t * volume (A i) ≤
      W * ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
    exact weak_one_lacunaryRelativeBandpassPhysicalMaximalAll_of_finite
      psi j (r i) (f : Euclidean d → ℂ) W (∫⁻ x, ENNReal.ofReal ‖f x‖)
      (fun S hS {s} hs => hweak i S hS f hs) ht
  have hsub : {x |
      ENNReal.ofReal t < lacunaryRelativeBandpassPhysicalPaletteMaximalAll psi j r
        (f : Euclidean d → ℂ) x} ⊆ ⋃ i ∈ (Finset.univ : Finset (Fin N)), A i := by
    intro x hx
    change ENNReal.ofReal t < ⨆ i : Fin N,
      lacunaryRelativeBandpassPhysicalMaximalAll psi j (r i)
        (f : Euclidean d → ℂ) x at hx
    rcases (lt_iSup_iff.mp hx) with ⟨i, hi⟩
    exact Set.mem_iUnion.mpr ⟨i, Set.mem_iUnion.mpr ⟨Finset.mem_univ i, hi⟩⟩
  have hmeasure : volume {x |
      ENNReal.ofReal t < lacunaryRelativeBandpassPhysicalPaletteMaximalAll psi j r
        (f : Euclidean d → ℂ) x} ≤ ∑ i : Fin N, volume (A i) := by
    calc
      volume {x |
          ENNReal.ofReal t < lacunaryRelativeBandpassPhysicalPaletteMaximalAll psi j r
            (f : Euclidean d → ℂ) x} ≤
          volume (⋃ i ∈ (Finset.univ : Finset (Fin N)), A i) := measure_mono hsub
      _ ≤ ∑ i ∈ (Finset.univ : Finset (Fin N)), volume (A i) :=
        measure_biUnion_finset_le _ _
      _ = ∑ i : Fin N, volume (A i) := by simp
  have hsum : ∑ i : Fin N, ENNReal.ofReal t * volume (A i) ≤
      ∑ i : Fin N, W * ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
    apply Finset.sum_le_sum
    intro i _
    exact hcolor i
  calc
    ENNReal.ofReal t * volume {x |
        ENNReal.ofReal t < lacunaryRelativeBandpassPhysicalPaletteMaximalAll psi j r
          (f : Euclidean d → ℂ) x} ≤
        ENNReal.ofReal t * ∑ i : Fin N, volume (A i) :=
      by simpa only [mul_comm] using
        mul_le_mul_right hmeasure (ENNReal.ofReal t)
    _ = ∑ i : Fin N, ENNReal.ofReal t * volume (A i) := by
      rw [Finset.mul_sum]
    _ ≤ ∑ i : Fin N, W * ∫⁻ x, ENNReal.ofReal ‖f x‖ := hsum
    _ = (N : ENNReal) * W * ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
      simp [Finset.sum_const, nsmul_eq_mul]
      ring

end

