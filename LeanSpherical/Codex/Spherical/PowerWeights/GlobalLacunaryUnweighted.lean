        (4 * ENNReal.ofReal (C ^ (2 : ℕ)) * A₂ +
          2 * lacunaryRelativeBandpassFinitePhysicalWeakOneConstant psi j C * A₁) := by
  dsimp only
  apply lacunaryRelativeBandpassPhysicalMaximalAll_lintegral_rpow_le_of_finite
    psi j r f (by linarith)
  intro S hS
  exact lacunaryRelativeBandpassFinitePhysical_lintegral_rpow_of_isDyadicLacunaryRadiusSelector
    hn C0 C1 hC0 hC1 hdecay hderiv phi psi hphi_one hphi_zero hphi_norm hpsi
    j r hr S hS hp1 hp2 f

