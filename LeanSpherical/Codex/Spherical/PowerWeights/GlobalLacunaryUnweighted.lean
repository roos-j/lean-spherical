/-- A uniform finite strong moment for physical lacunary maxima passes to the
countable all-scale physical maximum. -/
theorem lacunaryRelativeBandpassPhysicalMaximalAll_lintegral_rpow_le_of_finite
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (r : ℤ → PositiveRadius) (f : SchwartzMap (Euclidean d) ℂ)
    {p : ℝ} (hp : 0 < p) {B : ENNReal}
    (hfinite : ∀ (S : Finset ℤ) (hS : S.Nonempty),
      (∫⁻ x, ENNReal.ofReal
        ((lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
          (f : Euclidean d → ℂ) x) ^ p)) ≤ B) :
    (∫⁻ x, (lacunaryRelativeBandpassPhysicalMaximalAll psi j r
      (f : Euclidean d → ℂ) x) ^ p) ≤ B := by
  let u : ℤ → Euclidean d → ℝ := fun k x =>
    ‖lacunaryRelativeBandpassPhysicalTerm psi j (r k : ℝ)
      (f : Euclidean d → ℂ) x‖
  change (∫⁻ x, (⨆ k : ℤ, ENNReal.ofReal (u k x)) ^ p) ≤ B
  refine lintegral_iSup_int_exhaustion_rpow_le u (fun k => ?_)
    (fun k x => ?_) p hp ?_
  ·
    exact (continuous_lacunaryRelativeBandpassPhysicalTerm psi j
      (r k).2 (f : Euclidean d → ℂ) f.integrable).norm.measurable
  ·
    exact norm_nonneg _
  · intro S hS
    have hsup_nonneg (x : Euclidean d) :
        0 ≤ S.sup' hS (fun k => u k x) := by
      obtain ⟨k, hk, hmax⟩ := S.exists_mem_eq_sup' hS (fun k => u k x)
      rw [hmax]
      exact norm_nonneg _
    calc
      (∫⁻ x, (ENNReal.ofReal (S.sup' hS (fun k => u k x))) ^ p) =
          ∫⁻ x, ENNReal.ofReal ((S.sup' hS (fun k => u k x)) ^ p) := by
            congr with x
            exact ENNReal.ofReal_rpow_of_nonneg (hsup_nonneg x) hp.le
      _ ≤ B := by
        simpa only [u, lacunaryRelativeBandpassFinitePhysicalMaximal] using
          hfinite S hS

/-- The literal all-scale physical maximum associated to a lacunary selector
has a uniform subquadratic moment in dimension at least three. -/
theorem lacunaryRelativeBandpassPhysicalMaximalAll_lintegral_rpow_of_isDyadicLacunaryRadiusSelector
    {n : Nat} (hn : 2 ≤ n) (C0 C1 : ℝ) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ xi : Euclidean (n + 1), 1 ≤ ‖xi‖ →
      ‖surfaceFourier (n + 1) xi‖ ≤ C0 / ‖xi‖ ^ ((n : ℝ) / 2))
    (hderiv : ∀ xi : Euclidean (n + 1), ∀ s : ℝ, 1 ≤ ‖xi‖ →
      s ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun t : ℝ => surfaceFourier (n + 1) (t • xi)) s‖ ≤
        C1 / ‖xi‖ ^ ((n : ℝ) / 2 - 1))
    (phi psi : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1)
    (hpsi : ∀ ξ : Euclidean (n + 1),
