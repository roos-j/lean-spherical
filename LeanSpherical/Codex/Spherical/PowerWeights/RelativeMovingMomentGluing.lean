/-!
# Gluing the three moving-window contributions

The central cap estimate and the two off-window estimates are naturally
pointwise estimates on the same output shell.  This small lemma is the
literal passage from those three estimates to one `p`-moment.  It is kept in
terms of functions rather than introducing another maximal-operator wrapper.
-/

namespace LeanSpherical.HarmonicAnalysis

open MeasureTheory Set
open scoped ENNReal NNReal

noncomputable section

private theorem ennreal_rpow_three_sum_le (a b c : ENNReal) {p : Real}
    (hp : 1 <= p) :
    (a + b + c) ^ p <=
      (2 ^ (p - 1) * 2 ^ (p - 1)) * (a ^ p + b ^ p + c ^ p) := by
  let q : ENNReal := 2 ^ (p - 1)
  have hab := ENNReal.rpow_add_le_mul_rpow_add_rpow a b hp
  have hc0 := ENNReal.rpow_add_le_mul_rpow_add_rpow c 0 hp
  have habc := ENNReal.rpow_add_le_mul_rpow_add_rpow (a + b) (c + 0) hp
  have hp0 : 0 < p := lt_of_lt_of_le zero_lt_one hp
  change (a + b + c) ^ p <= (q * q) * (a ^ p + b ^ p + c ^ p)
  calc
    (a + b + c) ^ p = ((a + b) + (c + 0)) ^ p := by simp
    _ <= q * ((a + b) ^ p + (c + 0) ^ p) := by
      simpa only [q] using habc
    _ <= q * (q * (a ^ p + b ^ p) + q * (c ^ p + 0 ^ p)) := by
      simpa only [mul_comm] using mul_le_mul_left (add_le_add hab hc0) q
    _ = (q * q) * (a ^ p + b ^ p + c ^ p) := by
      simp only [ENNReal.zero_rpow_of_pos hp0, add_zero]
      ring

/-- Pointwise domination by a central term and the two parameter tails gives
one output-shell moment bound. -/
theorem lintegral_rpow_restrict_le_of_le_add_add
    {X : Type*} [MeasurableSpace X] (mu : Measure X) (B : Set X)
    {p : Real} (hp : 1 <= p)
    (F G H I : X -> ENNReal)
    (hB : MeasurableSet B)
    (hpoint : forall x, x ∈ B -> F x <= G x + H x + I x)
    (hGmeas : Measurable (fun x => (G x) ^ p))
    (hHmeas : Measurable (fun x => (H x) ^ p))
    (hImeas : Measurable (fun x => (I x) ^ p)) :
    (∫⁻ x in B, (F x) ^ p ∂mu) <=
      (2 ^ (p - 1) * 2 ^ (p - 1)) *
        ((∫⁻ x in B, (G x) ^ p ∂mu) +
          (∫⁻ x in B, (H x) ^ p ∂mu) +
            (∫⁻ x in B, (I x) ^ p ∂mu)) := by
  let nu : Measure X := mu.restrict B
  let q : ENNReal := 2 ^ (p - 1)
  have hpow (x : X) (hx : x ∈ B) : F x ^ p <=
      (q * q) * (G x ^ p + H x ^ p + I x ^ p) := by
    calc
      F x ^ p <= (G x + H x + I x) ^ p :=
        ENNReal.rpow_le_rpow (hpoint x hx) (by linarith)
      _ <= (q * q) * (G x ^ p + H x ^ p + I x ^ p) := by
        simpa only [q] using ennreal_rpow_three_sum_le (G x) (H x) (I x) hp
  have hsummeas : Measurable (fun x => G x ^ p + H x ^ p + I x ^ p) :=
    (hGmeas.add hHmeas).add hImeas
  have hpow_ae : ∀ᵐ x ∂nu, F x ^ p <=
      (q * q) * (G x ^ p + H x ^ p + I x ^ p) := by
    filter_upwards [ae_restrict_mem hB] with x hx
    exact hpow x hx
  let g : X -> ENNReal := fun x => G x ^ p
  let h : X -> ENNReal := fun x => H x ^ p
  let i : X -> ENNReal := fun x => I x ^ p
  have hg : Measurable g := hGmeas
  have hh : Measurable h := hHmeas
  have hsplit :
      (∫⁻ x, G x ^ p + H x ^ p + I x ^ p ∂nu) =
        (∫⁻ x, G x ^ p ∂nu) + (∫⁻ x, H x ^ p ∂nu) +
          (∫⁻ x, I x ^ p ∂nu) := by
    have hgi : (∫⁻ x, g x + (h x + i x) ∂nu) =
        (∫⁻ x, g x ∂nu) + (∫⁻ x, h x + i x ∂nu) :=
      lintegral_add_left hg _
    have hhi : (∫⁻ x, h x + i x ∂nu) =
        (∫⁻ x, h x ∂nu) + (∫⁻ x, i x ∂nu) :=
      lintegral_add_left hh _
    calc
      (∫⁻ x, G x ^ p + H x ^ p + I x ^ p ∂nu) =
          ∫⁻ x, g x + (h x + i x) ∂nu := by
            apply lintegral_congr
            intro x
            dsimp only [g, h, i]
            ac_rfl
      _ = (∫⁻ x, g x ∂nu) + (∫⁻ x, h x + i x ∂nu) := hgi
      _ = (∫⁻ x, g x ∂nu) + ((∫⁻ x, h x ∂nu) + (∫⁻ x, i x ∂nu)) := by
        rw [hhi]
      _ = (∫⁻ x, G x ^ p ∂nu) + (∫⁻ x, H x ^ p ∂nu) +
          (∫⁻ x, I x ^ p ∂nu) := by
        simp only [g, h, i]
        ac_rfl
  calc
    (∫⁻ x in B, (F x) ^ p ∂mu) = ∫⁻ x, F x ^ p ∂nu := by rfl
    _ <= ∫⁻ x, (q * q) * (G x ^ p + H x ^ p + I x ^ p) ∂nu :=
      lintegral_mono_ae hpow_ae
    _ = (q * q) *
        ((∫⁻ x, G x ^ p ∂nu) + (∫⁻ x, H x ^ p ∂nu) +
          (∫⁻ x, I x ^ p ∂nu)) := by
      rw [lintegral_const_mul _ hsummeas, hsplit]
    _ = (2 ^ (p - 1) * 2 ^ (p - 1)) *
        ((∫⁻ x in B, (G x) ^ p ∂mu) +
          (∫⁻ x in B, (H x) ^ p ∂mu) +
            (∫⁻ x in B, (I x) ^ p ∂mu)) := by rfl

/-- The usable version of `lintegral_rpow_restrict_le_of_le_add_add`, with
the three shell moments already replaced by their explicit bounds. -/
theorem lintegral_rpow_restrict_le_of_le_add_add_of_moments
    {X : Type*} [MeasurableSpace X] (mu : Measure X) (B : Set X)
    {p : Real} (hp : 1 <= p)
    (F G H I : X -> ENNReal)
    (hB : MeasurableSet B)
    (hpoint : forall x, x ∈ B -> F x <= G x + H x + I x)
    (hGmeas : Measurable (fun x => (G x) ^ p))
    (hHmeas : Measurable (fun x => (H x) ^ p))
    (hImeas : Measurable (fun x => (I x) ^ p))
    (QG QH QI : ENNReal)
    (hG : (∫⁻ x in B, (G x) ^ p ∂mu) <= QG)
    (hH : (∫⁻ x in B, (H x) ^ p ∂mu) <= QH)
    (hI : (∫⁻ x in B, (I x) ^ p ∂mu) <= QI) :
    (∫⁻ x in B, (F x) ^ p ∂mu) <=
      (2 ^ (p - 1) * 2 ^ (p - 1)) * (QG + QH + QI) := by
  calc
    (∫⁻ x in B, (F x) ^ p ∂mu) <=
        (2 ^ (p - 1) * 2 ^ (p - 1)) *
          ((∫⁻ x in B, (G x) ^ p ∂mu) +
            (∫⁻ x in B, (H x) ^ p ∂mu) +
              (∫⁻ x in B, (I x) ^ p ∂mu)) :=
