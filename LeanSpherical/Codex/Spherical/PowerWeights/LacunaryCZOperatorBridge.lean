/-- A finite lacunary Calderón--Zygmund decomposition can be substituted
directly into the physical kernel integral. -/
theorem lacunaryCZ_kernel_integral_decomposition
    {d : Nat} (K : Euclidean d → ℂ) (hK : Continuous K)
    {C : ℝ} (hKbound : ∀ z, ‖K z‖ ≤ C)
    (f : Euclidean d → ℂ) (hf : Integrable f volume)
    (U : Finset (Euclidean d × ℤ)) (x : Euclidean d) :
    (∫ y : Euclidean d, f y * K (x - y)) =
      (∫ y : Euclidean d, lacunaryCZGoodPart f U y * K (x - y)) +
        ∑ a ∈ U, ∫ y : Euclidean d,
          lacunaryCZBadAtom f a y * K (x - y) := by
  have harg : Continuous (fun y : Euclidean d => x - y) :=
    continuous_const.sub continuous_id
  have hKx : Continuous (fun y : Euclidean d => K (x - y)) := hK.comp harg
  have hmul (g : Euclidean d → ℂ) (hg : Integrable g volume) :
      Integrable (fun y : Euclidean d => g y * K (x - y)) volume := by
    have hmajor : Integrable (fun y : Euclidean d => ‖g y‖ * C) volume :=
      hg.norm.mul_const C
    refine hmajor.mono' (hg.aestronglyMeasurable.mul hKx.aestronglyMeasurable)
      (Filter.Eventually.of_forall fun y => ?_)
    change ‖g y * K (x - y)‖ ≤ ‖g y‖ * C
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (hKbound _) (norm_nonneg _)
  have hfK : Integrable (fun y : Euclidean d => f y * K (x - y)) volume :=
    hmul f hf
  have hgood : Integrable (lacunaryCZGoodPart f U) volume :=
    integrable_lacunaryCZGoodPart f U hf
  have hgoodK : Integrable (fun y : Euclidean d =>
      lacunaryCZGoodPart f U y * K (x - y)) volume :=
    hmul _ hgood
  have hbadK (a : Euclidean d × ℤ) (ha : a ∈ U) : Integrable (fun y : Euclidean d =>
      lacunaryCZBadAtom f a y * K (x - y)) volume :=
    hmul _ (integrable_lacunaryCZBadAtom f a hf)
  have hsumK : Integrable (fun y : Euclidean d =>
      ∑ a ∈ U, lacunaryCZBadAtom f a y * K (x - y)) volume :=
    integrable_finsetSum U fun a ha => hbadK a ha
  calc
    (∫ y : Euclidean d, f y * K (x - y)) =
        ∫ y : Euclidean d,
          lacunaryCZGoodPart f U y * K (x - y) +
            ∑ a ∈ U, lacunaryCZBadAtom f a y * K (x - y) := by
          apply integral_congr_ae
          filter_upwards with y
          rw [lacunaryCZGoodPart_add_sum_eq f U y]
          rw [add_mul, Finset.sum_mul]
    _ = (∫ y : Euclidean d, lacunaryCZGoodPart f U y * K (x - y)) +
          ∫ y : Euclidean d,
            ∑ a ∈ U, lacunaryCZBadAtom f a y * K (x - y) :=
          integral_add hgoodK hsumK
    _ = (∫ y : Euclidean d, lacunaryCZGoodPart f U y * K (x - y)) +
          ∑ a ∈ U, ∫ y : Euclidean d,
            lacunaryCZBadAtom f a y * K (x - y) := by
          rw [integral_finsetSum U fun a ha => hbadK a ha]

