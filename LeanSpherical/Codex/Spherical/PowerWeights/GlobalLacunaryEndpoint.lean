    {d : Nat} (K : Euclidean d → ℂ) (hK : Integrable K volume)
    (b : Euclidean d → ℂ) (hb : Integrable b) :
    Integrable (fun x : Euclidean d => ‖∫ y : Euclidean d, b y * K (x - y)‖)
      volume := by
  let F : Euclidean d × Euclidean d → ℂ := fun p =>
    b p.2 * K (p.1 - p.2)
  have hF : Integrable F (volume.prod volume) := by
    simpa only [F, ContinuousLinearMap.mul_apply'] using
      hb.convolution_integrand (ContinuousLinearMap.mul ℂ ℂ) hK
  have hleft : Integrable (fun x : Euclidean d =>
      ‖∫ y : Euclidean d, F (x, y)‖) volume :=
    hF.integral_prod_left.norm
  simpa only [F] using hleft

