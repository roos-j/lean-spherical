      ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ)
      (by simpa using (𝓕⁻ psi).smooth (1 : ℕ∞)) hs
  have htranslate :
      (∫ y : Euclidean d, ‖K (y + h) - K y‖) ≤
        ‖h‖ * ∫ y : Euclidean d, ‖fderiv ℝ (K : Euclidean d → ℂ) y‖ :=
    integral_norm_sub_translate_le_norm_mul_integral_norm_fderiv
      (K : Euclidean d → ℂ) hKdiff hKderiv h
  calc
    (∫ x : Euclidean d,
      ‖sphericalAverage d
          (fun y : Euclidean d => (s ^ d) •
            (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • y)) r (x + h) -
        sphericalAverage d
          (fun y : Euclidean d => (s ^ d) •
            (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • y)) r x‖) =
