theorem integral_norm_mean_zero_kernel_convolution_le
    {d : Nat} (K : Euclidean d → ℂ) (hK : Integrable K volume)
    (b : Euclidean d → ℂ) (hb : Integrable b volume)
    (hzero : (∫ y : Euclidean d, b y) = 0) (c : Euclidean d) :
    (∫ x : Euclidean d, ‖∫ y : Euclidean d, b y * K (x - y)‖) ≤
      ∫ y : Euclidean d, ‖b y‖ *
        (∫ x : Euclidean d, ‖K (x - y) - K (x - c)‖) := by
  let F : Euclidean d × Euclidean d → ℂ := fun p =>
    b p.2 * K (p.1 - p.2)
  let G : Euclidean d × Euclidean d → ℂ := fun p =>
    b p.2 * K (p.1 - c)
  have hF : Integrable F (volume.prod volume) := by
    simpa only [F, ContinuousLinearMap.mul_apply'] using
      hb.convolution_integrand (ContinuousLinearMap.mul ℂ ℂ) hK
  have hKshift : Integrable (fun x : Euclidean d => K (x - c)) volume :=
    hK.comp_sub_right c
  have hGmeas : AEStronglyMeasurable G (volume.prod volume) := by
    exact hb.aestronglyMeasurable.comp_snd.mul
      hKshift.aestronglyMeasurable.comp_fst
  have hG : Integrable G (volume.prod volume) := by
    apply (integrable_prod_iff hGmeas).mpr
    constructor
    · filter_upwards with x
      exact hb.mul_const (K (x - c))
    · have houter : Integrable (fun x : Euclidean d =>
          (∫ y : Euclidean d, ‖b y‖) * ‖K (x - c)‖) volume :=
        hKshift.norm.const_mul _
      convert houter using 1
      funext x
      change (∫ y : Euclidean d, ‖b y * K (x - c)‖) = _
      calc
        (∫ y : Euclidean d, ‖b y * K (x - c)‖) =
            ∫ y : Euclidean d, ‖b y‖ * ‖K (x - c)‖ := by
              apply integral_congr_ae
              filter_upwards with y
              rw [norm_mul]
        _ = _ := integral_mul_const (‖K (x - c)‖)
          (fun y : Euclidean d => ‖b y‖)
  have hdiff : Integrable (F - G) (volume.prod volume) := hF.sub hG
  have hFib : ∀ᵐ x : Euclidean d ∂volume,
      Integrable (fun y : Euclidean d => F (x, y)) volume :=
    (integrable_prod_iff hF.aestronglyMeasurable).mp hF |>.1
  have hcancel : ∀ᵐ x : Euclidean d ∂volume,
      (∫ y : Euclidean d, F (x, y)) =
        ∫ y : Euclidean d, (F - G) (x, y) := by
    filter_upwards [hFib] with x hx
    change (∫ y : Euclidean d, F (x, y)) =
      ∫ y : Euclidean d, F (x, y) - G (x, y)
    rw [integral_sub hx (hb.mul_const (K (x - c)))]
    have hGint : (∫ y : Euclidean d, G (x, y)) = 0 := by
      change (∫ y : Euclidean d, b y * K (x - c)) = 0
      rw [integral_mul_const, hzero, zero_mul]
    rw [hGint, sub_zero]
  have hright : Integrable (fun x : Euclidean d =>
      ∫ y : Euclidean d, ‖(F - G) (x, y)‖) volume :=
    hdiff.norm.integral_prod_left
  have hleft : Integrable (fun x : Euclidean d =>
      ‖∫ y : Euclidean d, F (x, y)‖) volume :=
    hF.integral_prod_left.norm
  calc
    (∫ x : Euclidean d, ‖∫ y : Euclidean d, b y * K (x - y)‖) =
        ∫ x : Euclidean d, ‖∫ y : Euclidean d, F (x, y)‖ := by rfl
    _ ≤ ∫ x : Euclidean d, ∫ y : Euclidean d, ‖(F - G) (x, y)‖ := by
      apply integral_mono_ae hleft hright
      filter_upwards [hcancel] with x hxc
      exact (congrArg norm hxc).trans_le (norm_integral_le_integral_norm _)
    _ = ∫ y : Euclidean d, ∫ x : Euclidean d, ‖(F - G) (x, y)‖ := by
      exact integral_integral_swap hdiff.norm
    _ = ∫ y : Euclidean d, ‖b y‖ *
        (∫ x : Euclidean d, ‖K (x - y) - K (x - c)‖) := by
      apply integral_congr_ae
      filter_upwards with y
      change (∫ x : Euclidean d,
        ‖b y * K (x - y) - b y * K (x - c)‖) = _
      calc
        (∫ x : Euclidean d,
          ‖b y * K (x - y) - b y * K (x - c)‖) =
            ∫ x : Euclidean d, ‖b y‖ * ‖K (x - y) - K (x - c)‖ := by
              apply integral_congr_ae
              filter_upwards with x
              rw [← mul_sub, norm_mul]
        _ = ‖b y‖ * (∫ x : Euclidean d, ‖K (x - y) - K (x - c)‖) :=
          integral_const_mul (‖b y‖)
            (fun x : Euclidean d => ‖K (x - y) - K (x - c)‖)

/-- Spherical averaging commutes with convolution in the literal order
needed by a mean-zero atom.  The finite surface measure and the displayed
boundedness hypothesis make the Fubini exchange completely explicit. -/
theorem sphericalAverage_convolution_eq_integral_sphericalAverage
    {d : Nat} (k : Euclidean d → ℂ) (hk : Continuous k)
    {C : ℝ} (hkbound : ∀ z, ‖k z‖ ≤ C)
    (b : Euclidean d → ℂ) (hb : Integrable b) (r : ℝ) (x : Euclidean d) :
    sphericalAverage d (k ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] b) r x =
      ∫ y : Euclidean d, b y * sphericalAverage d k r (x - y) := by
  let F : Metric.sphere (0 : Euclidean d) 1 × Euclidean d → ℂ := fun p =>
    b p.2 * k ((x - p.2) + r • (p.1 : Euclidean d))
  have hargcont : Continuous (fun p : Metric.sphere (0 : Euclidean d) 1 × Euclidean d =>
      (x - p.2) + r • (p.1 : Euclidean d)) :=
    (continuous_const.sub continuous_snd).add
      ((continuous_const : Continuous fun _ : Metric.sphere (0 : Euclidean d) 1 × Euclidean d => r).smul
        (continuous_subtype_val.comp continuous_fst))
  have hFmeas : AEStronglyMeasurable F
      ((unitSurfaceMeasure d).prod volume) := by
    exact hb.aestronglyMeasurable.comp_snd.mul
      (hk.comp hargcont).aestronglyMeasurable
  have hmajor : Integrable (fun p : Metric.sphere (0 : Euclidean d) 1 × Euclidean d =>
      C * ‖b p.2‖) ((unitSurfaceMeasure d).prod volume) :=
    (hb.norm.comp_snd (unitSurfaceMeasure d)).const_mul C
  have hF : Integrable F ((unitSurfaceMeasure d).prod volume) := by
    refine hmajor.mono' hFmeas (Filter.Eventually.of_forall ?_)
    intro p
    calc
      ‖F p‖ = ‖b p.2‖ * ‖k ((x - p.2) + r • (p.1 : Euclidean d))‖ := by
        dsimp [F]
        rw [norm_mul]
      _ ≤ ‖b p.2‖ * C :=
        mul_le_mul_of_nonneg_left (hkbound _) (norm_nonneg _)
      _ = C * ‖b p.2‖ := by ring
  have hswap :
      (∫ omega : Metric.sphere (0 : Euclidean d) 1,
        ∫ y : Euclidean d, F (omega, y) ∂volume ∂unitSurfaceMeasure d) =
        ∫ y : Euclidean d,
          ∫ omega : Metric.sphere (0 : Euclidean d) 1,
            F (omega, y) ∂unitSurfaceMeasure d ∂volume :=
    integral_integral_swap hF
  calc
    sphericalAverage d (k ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] b) r x =
        ∫ omega : Metric.sphere (0 : Euclidean d) 1,
          ∫ y : Euclidean d,
            k (x + r • (omega : Euclidean d) - y) * b y
              ∂volume ∂unitSurfaceMeasure d := by
              unfold sphericalAverage
              apply integral_congr_ae
              filter_upwards with omega
              rw [convolution_mul_swap]
    _ = ∫ omega : Metric.sphere (0 : Euclidean d) 1,
        ∫ y : Euclidean d, F (omega, y) ∂volume ∂unitSurfaceMeasure d := by
          apply integral_congr_ae
          filter_upwards with omega
          apply integral_congr_ae
          filter_upwards with y
          dsimp [F]
          rw [mul_comm]
          congr 1
          abel
    _ = ∫ y : Euclidean d,
        ∫ omega : Metric.sphere (0 : Euclidean d) 1,
          F (omega, y) ∂unitSurfaceMeasure d ∂volume := hswap
    _ = ∫ y : Euclidean d, b y * sphericalAverage d k r (x - y) := by
          apply integral_congr_ae
          filter_upwards with y
          dsimp [F]
          rw [integral_const_mul]
          rfl

/-- The preceding Fubini identity in the literal normalization of a scaled
inverse-Schwartz lacunary kernel. -/
theorem sphericalAverage_complexScaled_fourierInv_convolution_eq_integral
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ)
    {s : ℝ} (hs : 0 < s) (r : ℝ)
    (b : Euclidean d → ℂ) (hb : Integrable b) (x : Euclidean d) :
    sphericalAverage d
      ((fun z : Euclidean d => ((s ^ d : ℝ) : ℂ) •
        (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z))
        ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] b) r x =
      ∫ y : Euclidean d, b y *
        sphericalAverage d
          (fun z : Euclidean d => ((s ^ d : ℝ) : ℂ) •
            (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)) r (x - y) := by
  let k : Euclidean d → ℂ := fun z => ((s ^ d : ℝ) : ℂ) •
    (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)
  have hk : Continuous k := by
    change Continuous (fun z : Euclidean d => ((s ^ d : ℝ) : ℂ) *
      (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z))
    exact continuous_const.mul
      ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ).continuous.comp
        ((continuous_const : Continuous fun _ : Euclidean d => s).smul continuous_id))
  let C : ℝ := s ^ d * ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ).toBoundedContinuousFunction‖
  have hkbound (z : Euclidean d) : ‖k z‖ ≤ C := by
    dsimp [k, C]
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (pow_nonneg hs.le _)]
    exact mul_le_mul_of_nonneg_left
      (BoundedContinuousFunction.norm_coe_le_norm
        ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ).toBoundedContinuousFunction) (s • z))
      (pow_nonneg hs.le _)
  simpa only [k] using
    sphericalAverage_convolution_eq_integral_sphericalAverage
      k hk hkbound b hb r x

/-- The exact relative-frequency surface multiplier is the atom-friendly
physical integral against the spherical average of its scaled kernel. -/
theorem fourierInv_relative_surface_scaled_schwartz_multiplier_eq_integral_sphericalAverage
    {d : Nat} (psi f : SchwartzMap (Euclidean d) ℂ) (j : ℕ)
    {r : ℝ} (hr : 0 < r) (x : Euclidean d) :
    𝓕⁻ (fun ξ : Euclidean d =>
      surfaceFourier d (-r • ξ) * psi (((2 : ℝ) ^ j)⁻¹ • (r • ξ)) *
        𝓕 (f : Euclidean d → ℂ) ξ) x =
      ∫ y : Euclidean d, f y *
        sphericalAverage d
          (fun z : Euclidean d =>
            (((((((2 : ℝ) ^ j)⁻¹ * r)⁻¹) ^ d : ℝ) : ℂ) •
              (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
                (((((2 : ℝ) ^ j)⁻¹ * r)⁻¹) • z))) r (x - y) := by
  let s : ℝ := (((2 : ℝ) ^ j)⁻¹ * r)⁻¹
  have hs : 0 < s := by
    dsimp [s]
    apply inv_pos.mpr
    exact mul_pos (inv_pos.mpr (pow_pos (by norm_num) _)) hr
  calc
    𝓕⁻ (fun ξ : Euclidean d =>
      surfaceFourier d (-r • ξ) * psi (((2 : ℝ) ^ j)⁻¹ • (r • ξ)) *
        𝓕 (f : Euclidean d → ℂ) ξ) x =
        sphericalAverage d
          ((fun z : Euclidean d => ((s ^ d : ℝ) : ℂ) •
            (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z))
            ⋆[ContinuousLinearMap.mul ℂ ℂ, (volume : Measure (Euclidean d))]
              (f : Euclidean d → ℂ)) r x := by
          rw [fourierInv_relative_surface_scaled_schwartz_multiplier_eq_surface_convolution
            psi f j hr x]
          rfl
    _ = ∫ y : Euclidean d, f y *
        sphericalAverage d
          (fun z : Euclidean d => ((s ^ d : ℝ) : ℂ) •
            (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)) r (x - y) :=
      sphericalAverage_complexScaled_fourierInv_convolution_eq_integral psi hs r f f.integrable x
    _ = _ := by rfl

private theorem integrable_weighted_kernel_difference
    {d : Nat} (K : Euclidean d → ℂ) (hK : Integrable K volume)
    (b : Euclidean d → ℂ) (hb : Integrable b volume) (c : Euclidean d) :
    Integrable (fun p : Euclidean d × Euclidean d =>
      b p.2 * (K (p.1 - p.2) - K (p.1 - c))) (volume.prod volume) := by
  let F : Euclidean d × Euclidean d → ℂ := fun p =>
    b p.2 * K (p.1 - p.2)
  let G : Euclidean d × Euclidean d → ℂ := fun p =>
    b p.2 * K (p.1 - c)
  have hF : Integrable F (volume.prod volume) := by
    simpa only [F, ContinuousLinearMap.mul_apply'] using
      hb.convolution_integrand (ContinuousLinearMap.mul ℂ ℂ) hK
  have hKshift : Integrable (fun x : Euclidean d => K (x - c)) volume :=
    hK.comp_sub_right c
  have hGmeas : AEStronglyMeasurable G (volume.prod volume) := by
    exact hb.aestronglyMeasurable.comp_snd.mul
      hKshift.aestronglyMeasurable.comp_fst
  have hG : Integrable G (volume.prod volume) := by
    apply (integrable_prod_iff hGmeas).mpr
    constructor
    · filter_upwards with x
      exact hb.mul_const (K (x - c))
    · have houter : Integrable (fun x : Euclidean d =>
          (∫ y : Euclidean d, ‖b y‖) * ‖K (x - c)‖) volume :=
        hKshift.norm.const_mul _
      convert houter using 1
      funext x
      change (∫ y : Euclidean d, ‖b y * K (x - c)‖) = _
      calc
        (∫ y : Euclidean d, ‖b y * K (x - c)‖) =
            ∫ y : Euclidean d, ‖b y‖ * ‖K (x - c)‖ := by
              apply integral_congr_ae
              filter_upwards with y
              rw [norm_mul]
        _ = _ := integral_mul_const (‖K (x - c)‖)
          (fun y : Euclidean d => ‖b y‖)
  convert hF.sub hG using 1
  funext p
  dsimp [F, G]
  ring

private theorem integrable_norm_mul_integral_kernel_difference
    {d : Nat} (K : Euclidean d → ℂ) (hK : Integrable K volume)
    (b : Euclidean d → ℂ) (hb : Integrable b volume) (c : Euclidean d) :
    Integrable (fun y : Euclidean d => ‖b y‖ *
      (∫ x : Euclidean d, ‖K (x - y) - K (x - c)‖)) volume := by
  have hprod := integrable_weighted_kernel_difference K hK b hb c
  have hright : Integrable (fun y : Euclidean d =>
      ∫ x : Euclidean d,
        ‖b y * (K (x - y) - K (x - c))‖) volume :=
    hprod.norm.integral_prod_right
  have hfun : (fun y : Euclidean d => ‖b y‖ *
      (∫ x : Euclidean d, ‖K (x - y) - K (x - c)‖)) =
      fun y : Euclidean d => ∫ x : Euclidean d,
        ‖b y * (K (x - y) - K (x - c))‖ := by
    funext y
    symm
    calc
      (∫ x : Euclidean d,
        ‖b y * (K (x - y) - K (x - c))‖) =
          ∫ x : Euclidean d, ‖b y‖ * ‖K (x - y) - K (x - c)‖ := by
            apply integral_congr_ae
            filter_upwards with x
            rw [norm_mul]
      _ = _ := integral_const_mul (‖b y‖)
        (fun x : Euclidean d => ‖K (x - y) - K (x - c)‖)
  rw [hfun]
  exact hright

/-- The global `L¹` bound for one mean-zero atom against a single smoothed
spherical kernel.  It is the large-radius part of the lacunary endpoint. -/
theorem integral_norm_mean_zero_sphericalAverage_complexScaled_fourierInv_atom_le
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ)
    {s : ℝ} (hs : 0 < s) (r : ℝ)
    (b : Euclidean d → ℂ) (hb : Integrable b)
    (hzero : (∫ y : Euclidean d, b y) = 0)
    {c : Euclidean d} {ρ : ℝ}
    (hbsupp : ∀ y, b y ≠ 0 → ‖y - c‖ ≤ ρ) :
    (∫ x : Euclidean d, ‖∫ y : Euclidean d, b y *
      sphericalAverage d
        (fun z : Euclidean d => ((s ^ d : ℝ) : ℂ) •
          (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)) r (x - y)‖) ≤
      surfaceMass d * ρ * s *
        (∫ x : Euclidean d,
          ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
            Euclidean d → ℂ) x‖) *
        (∫ y : Euclidean d, ‖b y‖) := by
  let K : Euclidean d → ℂ := sphericalAverage d
    (fun z : Euclidean d => ((s ^ d : ℝ) : ℂ) •
      (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)) r
  have hbasecont : Continuous (fun z : Euclidean d => ((s ^ d : ℝ) : ℂ) •
      (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)) := by
    change Continuous (fun z : Euclidean d => ((s ^ d : ℝ) : ℂ) *
      (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z))
    exact continuous_const.mul
      ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ).continuous.comp
        ((continuous_const : Continuous fun _ : Euclidean d => s).smul continuous_id))
  have hbaseint : Integrable (fun z : Euclidean d => ((s ^ d : ℝ) : ℂ) •
      (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)) volume := by
    simpa only [Complex.real_smul, smul_eq_mul] using integrable_scaled_fourierInv psi hs
  have hK : Integrable K volume :=
    integrable_sphericalAverage _ hbasecont hbaseint r
  have hfirst := integral_norm_mean_zero_kernel_convolution_le K hK b hb hzero c
  have hRHS : Integrable (fun y : Euclidean d => ‖b y‖ *
      (∫ x : Euclidean d, ‖K (x - y) - K (x - c)‖)) volume :=
    integrable_norm_mul_integral_kernel_difference K hK b hb c
  have hbound (y : Euclidean d) :
      (∫ x : Euclidean d, ‖K (x - y) - K (x - c)‖) ≤
        surfaceMass d * ‖c - y‖ * s *
          (∫ x : Euclidean d,
            ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
              Euclidean d → ℂ) x‖) := by
    let T : Euclidean d → ℝ := fun z => ‖K (z + (c - y)) - K z‖
    have htranslate : (∫ z : Euclidean d, T z) ≤
        surfaceMass d * ‖c - y‖ * s *
          (∫ z : Euclidean d,
            ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
              Euclidean d → ℂ) z‖) := by
      dsimp [T, K]
      exact integral_norm_sphericalAverage_complexScaled_fourierInv_sub_translate_le
        psi hs r (c - y)
    calc
      (∫ x : Euclidean d, ‖K (x - y) - K (x - c)‖) =
          ∫ x : Euclidean d, T (x - c) := by
            apply integral_congr_ae
            filter_upwards with x
            dsimp [T]
            congr 2 <;> abel
      _ = ∫ x : Euclidean d, T x := integral_sub_right_eq_self T c
      _ ≤ _ := htranslate
  have hmajor : Integrable (fun y : Euclidean d =>
      ‖b y‖ *
        (surfaceMass d * ρ * s *
          (∫ x : Euclidean d,
            ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
              Euclidean d → ℂ) x‖))) volume := by
    exact hb.norm.mul_const _
  have hpoint (y : Euclidean d) :
      ‖b y‖ * (∫ x : Euclidean d, ‖K (x - y) - K (x - c)‖) ≤
        ‖b y‖ *
          (surfaceMass d * ρ * s *
            (∫ x : Euclidean d,
              ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
                Euclidean d → ℂ) x‖)) := by
    by_cases hy : b y = 0
    · simp [hy]
    · have hyc : ‖c - y‖ ≤ ρ := by simpa [norm_sub_rev] using hbsupp y hy
      have hC : 0 ≤ surfaceMass d * s *
          (∫ x : Euclidean d,
            ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
              Euclidean d → ℂ) x‖) := by
        exact mul_nonneg (mul_nonneg measureReal_nonneg hs.le)
          (integral_nonneg fun _ => norm_nonneg _)
      have hscale : surfaceMass d * ‖c - y‖ * s *
          (∫ x : Euclidean d,
            ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
              Euclidean d → ℂ) x‖) ≤
          surfaceMass d * ρ * s *
          (∫ x : Euclidean d,
            ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
              Euclidean d → ℂ) x‖) := by
        nlinarith
      exact mul_le_mul_of_nonneg_left (hbound y |>.trans hscale) (norm_nonneg _)
  calc
    (∫ x : Euclidean d, ‖∫ y : Euclidean d, b y *
      sphericalAverage d
        (fun z : Euclidean d => ((s ^ d : ℝ) : ℂ) •
          (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)) r (x - y)‖) =
        ∫ x : Euclidean d, ‖∫ y : Euclidean d, b y * K (x - y)‖ := by rfl
    _ ≤ ∫ y : Euclidean d, ‖b y‖ *
        (∫ x : Euclidean d, ‖K (x - y) - K (x - c)‖) := hfirst
    _ ≤ ∫ y : Euclidean d, ‖b y‖ *
        (surfaceMass d * ρ * s *
          (∫ x : Euclidean d,
            ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
              Euclidean d → ℂ) x‖)) :=
      integral_mono_ae hRHS hmajor (Filter.Eventually.of_forall hpoint)
    _ = _ := by
      rw [integral_mul_const]
      ring

/-- The normalized inverse-Schwartz kernel has the explicit rapid-decay
inequality used for selected radii below a bad-ball scale.  The polynomial
weight is deliberately retained on the left, avoiding any division at the
origin. -/
theorem scaled_fourierInv_norm_mul_distance_pow_le_seminorm
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) {s : ℝ} (hs : 0 < s)
    (z : Euclidean d) :
    (s * ‖z‖) ^ (d + 2) *
        ‖((s ^ d : ℝ) : ℂ) •
          (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)‖ ≤
      s ^ d * SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi) := by
  have hsemi := SchwartzMap.norm_pow_mul_le_seminorm ℂ
    (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (d + 2) (s • z)
  have hspow : 0 ≤ s ^ d := pow_nonneg hs.le _
  calc
    (s * ‖z‖) ^ (d + 2) *
        ‖((s ^ d : ℝ) : ℂ) •
          (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)‖ =
        s ^ d * (‖s • z‖ ^ (d + 2) *
          ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)‖) := by
            rw [norm_smul, Complex.norm_real, Real.norm_eq_abs,
              abs_of_nonneg hspow, norm_smul, Real.norm_eq_abs,
              abs_of_nonneg hs.le]
            ring
    _ ≤ s ^ d * SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi) :=
      mul_le_mul_of_nonneg_left hsemi hspow

/-- Away from the origin, the polynomial Schwartz estimate can be written as
an explicit inverse-power bound.  This is used for selected radii smaller
than the Calderón--Zygmund ball scale. -/
theorem norm_complexScaled_fourierInv_le_seminorm_div_distance_pow
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) {s : ℝ} (hs : 0 < s)
    {z : Euclidean d} (hz : 0 < s * ‖z‖) :
    ‖((s ^ d : ℝ) : ℂ) •
        (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)‖ ≤
      (s ^ d * SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi)) /
        (s * ‖z‖) ^ (d + 2) := by
  apply (le_div_iff₀ (pow_pos hz _)).mpr
  simpa only [mul_comm] using
    scaled_fourierInv_norm_mul_distance_pow_le_seminorm psi hs z

/-- The physical kernel at a radius no larger than a bad-ball radius has
rapid decay outside the triple of that ball.  This is the small-radius half
of the off-support estimate in the global lacunary argument. -/
theorem norm_sphericalAverage_complexScaled_fourierInv_le_of_small_radius_far
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) {s ρ r : ℝ}
    (hs : 0 < s) (hρ : 0 < ρ) (hr : 0 ≤ r) (hrρ : r ≤ ρ)
    {c x y : Euclidean d} (hy : ‖y - c‖ ≤ ρ) (hx : 3 * ρ ≤ ‖x - c‖) :
    ‖sphericalAverage d
        (fun z : Euclidean d => ((s ^ d : ℝ) : ℂ) •
          (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)) r (x - y)‖ ≤
      ((s ^ d * SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi)) /
        (s * ρ) ^ (d + 2)) * surfaceMass d := by
  rw [show surfaceMass d = (unitSurfaceMeasure d).real univ from rfl]
  unfold sphericalAverage
  apply norm_integral_le_of_norm_le_const
  filter_upwards with ω
  have hgeom : ρ ≤ ‖(x - y) + r • (ω : Euclidean d)‖ := by
    simpa only [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
      radius_le_norm_add_smul_sub hρ.le hr hrρ hy hx ω
  have hz : 0 < s * ‖(x - y) + r • (ω : Euclidean d)‖ :=
    mul_pos hs (lt_of_lt_of_le hρ hgeom)
  have hkernel := norm_complexScaled_fourierInv_le_seminorm_div_distance_pow
    psi hs hz
  have hsemi : 0 ≤ SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi) := by
    calc
      0 ≤ ‖(0 : Euclidean d)‖ ^ (d + 2) *
          ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) 0‖ := by positivity
      _ ≤ SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi) :=
        SchwartzMap.norm_pow_mul_le_seminorm ℂ
          (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (d + 2) 0
  have hnum : 0 ≤ s ^ d * SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi) := by
    exact mul_nonneg (pow_nonneg hs.le _) hsemi
  have hden : 0 < (s * ρ) ^ (d + 2) :=
    pow_pos (mul_pos hs hρ) _
  have hscale : s * ρ ≤ s * ‖(x - y) + r • (ω : Euclidean d)‖ :=
    mul_le_mul_of_nonneg_left hgeom hs.le
  have hpowscale : (s * ρ) ^ (d + 2) ≤
      (s * ‖(x - y) + r • (ω : Euclidean d)‖) ^ (d + 2) := by
    exact pow_le_pow_left₀ (mul_nonneg hs.le hρ.le) hscale _
  calc
    ‖((s ^ d : ℝ) : ℂ) •
        (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
          (s • ((x - y) + r • (ω : Euclidean d)))‖ ≤
        (s ^ d * SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi)) /
          (s * ‖(x - y) + r • (ω : Euclidean d)‖) ^ (d + 2) := hkernel
    _ ≤ (s ^ d * SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi)) /
        (s * ρ) ^ (d + 2) :=
      div_le_div_of_nonneg_left hnum hden hpowscale

/-- The positive surface-smoothed kernel obeys the same off-support bound.
This is the form that can be integrated against the absolute value of a
Calderón--Zygmund bad atom. -/
theorem integral_norm_complexScaled_fourierInv_le_of_small_radius_far
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) {s ρ r : ℝ}
    (hs : 0 < s) (hρ : 0 < ρ) (hr : 0 ≤ r) (hrρ : r ≤ ρ)
    {c x y : Euclidean d} (hy : ‖y - c‖ ≤ ρ) (hx : 3 * ρ ≤ ‖x - c‖) :
    (∫ ω : Metric.sphere (0 : Euclidean d) 1,
      ‖((s ^ d : ℝ) : ℂ) •
        (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
          (s • ((x - y) + r • (ω : Euclidean d)))‖
        ∂unitSurfaceMeasure d) ≤
      ((s ^ d * SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi)) /
        (s * ρ) ^ (d + 2)) * surfaceMass d := by
  let C : ℝ :=
    (s ^ d * SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi)) /
      (s * ρ) ^ (d + 2)
  have hsemi : 0 ≤ SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi) := by
    calc
      0 ≤ ‖(0 : Euclidean d)‖ ^ (d + 2) *
          ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) 0‖ := by positivity
      _ ≤ SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi) :=
        SchwartzMap.norm_pow_mul_le_seminorm ℂ
          (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (d + 2) 0
  have hnum : 0 ≤ s ^ d * SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi) :=
    mul_nonneg (pow_nonneg hs.le _) hsemi
  have hden : 0 < (s * ρ) ^ (d + 2) :=
    pow_pos (mul_pos hs hρ) _
  have hC : 0 ≤ C := div_nonneg hnum hden.le
  have hpoint (ω : Metric.sphere (0 : Euclidean d) 1) :
      ‖((s ^ d : ℝ) : ℂ) •
          (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
            (s • ((x - y) + r • (ω : Euclidean d)))‖ ≤ C := by
    have hgeom : ρ ≤ ‖(x - y) + r • (ω : Euclidean d)‖ := by
      simpa only [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
        radius_le_norm_add_smul_sub hρ.le hr hrρ hy hx ω
    have hz : 0 < s * ‖(x - y) + r • (ω : Euclidean d)‖ :=
      mul_pos hs (lt_of_lt_of_le hρ hgeom)
    have hkernel := norm_complexScaled_fourierInv_le_seminorm_div_distance_pow
      psi hs hz
    have hscale : s * ρ ≤ s * ‖(x - y) + r • (ω : Euclidean d)‖ :=
      mul_le_mul_of_nonneg_left hgeom hs.le
    have hpowscale : (s * ρ) ^ (d + 2) ≤
        (s * ‖(x - y) + r • (ω : Euclidean d)‖) ^ (d + 2) := by
      exact pow_le_pow_left₀ (mul_nonneg hs.le hρ.le) hscale _
    calc
      ‖((s ^ d : ℝ) : ℂ) •
          (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
            (s • ((x - y) + r • (ω : Euclidean d)))‖ ≤
          (s ^ d * SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi)) /
            (s * ‖(x - y) + r • (ω : Euclidean d)‖) ^ (d + 2) := hkernel
      _ ≤ C := div_le_div_of_nonneg_left hnum hden hpowscale
  have hcont : Continuous (fun ω : Metric.sphere (0 : Euclidean d) 1 =>
      ‖((s ^ d : ℝ) : ℂ) •
        (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
          (s • ((x - y) + r • (ω : Euclidean d)))‖) := by
    fun_prop
  have hconst : Integrable (fun _ : Metric.sphere (0 : Euclidean d) 1 => C)
      (unitSurfaceMeasure d) := integrable_const _
  have hint : Integrable (fun ω : Metric.sphere (0 : Euclidean d) 1 =>
      ‖((s ^ d : ℝ) : ℂ) •
        (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
          (s • ((x - y) + r • (ω : Euclidean d)))‖)
      (unitSurfaceMeasure d) := by
    refine hconst.mono' hcont.aestronglyMeasurable ?_
    filter_upwards with ω
    simpa only [Real.norm_of_nonneg (norm_nonneg _)] using hpoint ω
  calc
    (∫ ω : Metric.sphere (0 : Euclidean d) 1,
      ‖((s ^ d : ℝ) : ℂ) •
        (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
          (s • ((x - y) + r • (ω : Euclidean d)))‖
        ∂unitSurfaceMeasure d) ≤
        ∫ _ : Metric.sphere (0 : Euclidean d) 1, C ∂unitSurfaceMeasure d :=
      integral_mono_ae hint hconst (Filter.Eventually.of_forall hpoint)
    _ = C * surfaceMass d := by simp [surfaceMass, mul_comm]

/-- Retaining the exterior distance in the preceding estimate gives the
integrable spatial decay needed when the small selected radii are summed
outside a bad ball. -/
theorem integral_norm_complexScaled_fourierInv_le_of_small_radius_far_distance
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) {s ρ r : ℝ}
    (hs : 0 < s) (hρ : 0 < ρ) (hr : 0 ≤ r) (hrρ : r ≤ ρ)
    {c x y : Euclidean d} (hy : ‖y - c‖ ≤ ρ) (hx : 3 * ρ ≤ ‖x - c‖) :
    (∫ ω : Metric.sphere (0 : Euclidean d) 1,
      ‖((s ^ d : ℝ) : ℂ) •
        (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
          (s • ((x - y) + r • (ω : Euclidean d)))‖
        ∂unitSurfaceMeasure d) ≤
      ((s ^ d * SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi)) /
        (s * (‖x - c‖ / 3)) ^ (d + 2)) * surfaceMass d := by
  have hxc : 0 < ‖x - c‖ := by
    have : 0 < 3 * ρ := mul_pos (by norm_num) hρ
    exact lt_of_lt_of_le this hx
  have hD : 0 < ‖x - c‖ / 3 := div_pos hxc (by norm_num)
  have hrD : r ≤ ‖x - c‖ / 3 := by
    apply (le_div_iff₀ (by norm_num : (0 : ℝ) < 3)).mpr
    nlinarith
  have hyD : ‖y - c‖ ≤ ‖x - c‖ / 3 := by
    apply (le_div_iff₀ (by norm_num : (0 : ℝ) < 3)).mpr
    nlinarith
  have hxD : 3 * (‖x - c‖ / 3) ≤ ‖x - c‖ := by nlinarith
  exact integral_norm_complexScaled_fourierInv_le_of_small_radius_far
    psi hs hD hr hrD hyD hxD

/-- A single small selected radius applied to an integrable bad atom is
controlled off the triple ball by the atom's `L¹` norm.  The support
hypothesis is intentionally literal, so this can be fed directly by a
finite Calderón--Zygmund decomposition. -/
theorem integral_norm_mul_integral_norm_complexScaled_fourierInv_le_of_small_radius_far
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) {s ρ r : ℝ}
    (hs : 0 < s) (hρ : 0 < ρ) (hr : 0 ≤ r) (hrρ : r ≤ ρ)
    {c x : Euclidean d} (hx : 3 * ρ ≤ ‖x - c‖)
    (b : Euclidean d → ℂ) (hb : Integrable b)
    (hbsupp : ∀ y, b y ≠ 0 → ‖y - c‖ ≤ ρ) :
    (∫ y : Euclidean d, ‖b y‖ *
      (∫ ω : Metric.sphere (0 : Euclidean d) 1,
        ‖((s ^ d : ℝ) : ℂ) •
          (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
            (s • ((x - y) + r • (ω : Euclidean d)))‖
          ∂unitSurfaceMeasure d)) ≤
      ((s ^ d * SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi)) /
        (s * ρ) ^ (d + 2)) * surfaceMass d *
          ∫ y : Euclidean d, ‖b y‖ := by
  let C : ℝ :=
    (s ^ d * SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi)) /
      (s * ρ) ^ (d + 2)
  let W : Euclidean d → ℝ := fun y =>
    ∫ ω : Metric.sphere (0 : Euclidean d) 1,
      ‖((s ^ d : ℝ) : ℂ) •
        (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
          (s • ((x - y) + r • (ω : Euclidean d)))‖
        ∂unitSurfaceMeasure d
  let B : ℝ := C * surfaceMass d
  have hWnonneg (y : Euclidean d) : 0 ≤ W y := by
    dsimp [W]
    exact integral_nonneg fun _ => norm_nonneg _
  have hWjoint : Continuous (Function.uncurry
      (fun (y : Euclidean d) (ω : Metric.sphere (0 : Euclidean d) 1) =>
        ‖((s ^ d : ℝ) : ℂ) •
          (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
            (s • ((x - y) + r • (ω : Euclidean d)))‖)) := by
    fun_prop
  have hWcont : Continuous W := by
    dsimp [W]
    simpa only [Measure.restrict_univ, smul_eq_mul] using
      (continuous_parametric_integral_of_continuous
        (μ := unitSurfaceMeasure d) hWjoint isCompact_univ)
  have hWbound (y : Euclidean d) (hy : ‖y - c‖ ≤ ρ) : W y ≤ B := by
    dsimp [W, B, C]
    exact integral_norm_complexScaled_fourierInv_le_of_small_radius_far
      psi hs hρ hr hrρ hy hx
  have hkernel (y : Euclidean d) : ‖b y‖ * W y ≤ ‖b y‖ * B := by
    by_cases hby : b y = 0
    · simp [hby]
    · exact mul_le_mul_of_nonneg_left (hWbound y (hbsupp y hby)) (norm_nonneg _)
  have hprodmeas : AEStronglyMeasurable (fun y : Euclidean d => ‖b y‖ * W y)
      volume := hb.norm.aestronglyMeasurable.mul hWcont.aestronglyMeasurable
  have hrightint : Integrable (fun y : Euclidean d => ‖b y‖ * B) volume :=
    hb.norm.mul_const B
  have hleftint : Integrable (fun y : Euclidean d => ‖b y‖ * W y) volume := by
    refine hrightint.mono' hprodmeas (Filter.Eventually.of_forall fun y => ?_)
    rw [Real.norm_of_nonneg]
    · exact hkernel y
    · exact mul_nonneg (norm_nonneg _) (hWnonneg _)
  change (∫ y : Euclidean d, ‖b y‖ * W y) ≤ B * ∫ y : Euclidean d, ‖b y‖
  calc
    (∫ y : Euclidean d, ‖b y‖ * W y) ≤
        ∫ y : Euclidean d, ‖b y‖ * B :=
      integral_mono hleftint hrightint hkernel
    _ = B * ∫ y : Euclidean d, ‖b y‖ := by
      rw [← integral_const_mul]
      apply integral_congr_ae
      filter_upwards with y
      ring

/-- The bad-atom estimate retaining the distance to the ball centre.  Its
right side is integrable over the exterior once the selected-scale geometric
sum has been taken. -/
theorem integral_norm_mul_integral_norm_complexScaled_fourierInv_le_of_small_radius_far_distance
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) {s ρ r : ℝ}
    (hs : 0 < s) (hρ : 0 < ρ) (hr : 0 ≤ r) (hrρ : r ≤ ρ)
    {c x : Euclidean d} (hx : 3 * ρ ≤ ‖x - c‖)
    (b : Euclidean d → ℂ) (hb : Integrable b)
    (hbsupp : ∀ y, b y ≠ 0 → ‖y - c‖ ≤ ρ) :
    (∫ y : Euclidean d, ‖b y‖ *
      (∫ ω : Metric.sphere (0 : Euclidean d) 1,
        ‖((s ^ d : ℝ) : ℂ) •
          (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
            (s • ((x - y) + r • (ω : Euclidean d)))‖
          ∂unitSurfaceMeasure d)) ≤
      ((s ^ d * SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi)) /
        (s * (‖x - c‖ / 3)) ^ (d + 2)) * surfaceMass d *
          ∫ y : Euclidean d, ‖b y‖ := by
  have hxc : 0 < ‖x - c‖ := by
    have : 0 < 3 * ρ := mul_pos (by norm_num) hρ
    exact lt_of_lt_of_le this hx
  have hD : 0 < ‖x - c‖ / 3 := div_pos hxc (by norm_num)
  have hrD : r ≤ ‖x - c‖ / 3 := by
    apply (le_div_iff₀ (by norm_num : (0 : ℝ) < 3)).mpr
    nlinarith
  have hxD : 3 * (‖x - c‖ / 3) ≤ ‖x - c‖ := by nlinarith
  apply integral_norm_mul_integral_norm_complexScaled_fourierInv_le_of_small_radius_far
    psi hs hD hr hrD hxD b hb
  intro y hby
  apply (le_div_iff₀ (by norm_num : (0 : ℝ) < 3)).mpr
  nlinarith [hbsupp y hby]

/-- The small-radius bad-atom bounds add over a finite collection of selected
radii.  No abstract operator is introduced: the left side is the literal
positive surface kernel appearing in the physical realization. -/
theorem sum_integral_norm_mul_integral_norm_complexScaled_fourierInv_le_of_small_radii_far
    {d : Nat} {ι : Type*} (psi : SchwartzMap (Euclidean d) ℂ)
    (I : Finset ι) (s r : ι → ℝ) {ρ : ℝ}
    (hs : ∀ i ∈ I, 0 < s i) (hρ : 0 < ρ)
    (hr : ∀ i ∈ I, 0 ≤ r i) (hrρ : ∀ i ∈ I, r i ≤ ρ)
    {c x : Euclidean d} (hx : 3 * ρ ≤ ‖x - c‖)
    (b : Euclidean d → ℂ) (hb : Integrable b)
    (hbsupp : ∀ y, b y ≠ 0 → ‖y - c‖ ≤ ρ) :
    (∑ i ∈ I, ∫ y : Euclidean d, ‖b y‖ *
      (∫ ω : Metric.sphere (0 : Euclidean d) 1,
        ‖(((s i) ^ d : ℝ) : ℂ) •
          (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
            ((s i) • ((x - y) + (r i) • (ω : Euclidean d)))‖
          ∂unitSurfaceMeasure d)) ≤
      (∑ i ∈ I,
        ((((s i) ^ d * SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi)) /
          ((s i) * ρ) ^ (d + 2)) * surfaceMass d)) *
        ∫ y : Euclidean d, ‖b y‖ := by
  calc
    (∑ i ∈ I, ∫ y : Euclidean d, ‖b y‖ *
      (∫ ω : Metric.sphere (0 : Euclidean d) 1,
        ‖(((s i) ^ d : ℝ) : ℂ) •
          (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
            ((s i) • ((x - y) + (r i) • (ω : Euclidean d)))‖
          ∂unitSurfaceMeasure d)) ≤
        ∑ i ∈ I,
          ((((s i) ^ d * SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi)) /
            ((s i) * ρ) ^ (d + 2)) * surfaceMass d) *
            ∫ y : Euclidean d, ‖b y‖ := by
          refine Finset.sum_le_sum fun i hi => ?_
          exact
            integral_norm_mul_integral_norm_complexScaled_fourierInv_le_of_small_radius_far
              psi (hs i hi) hρ (hr i hi) (hrρ i hi) hx b hb hbsupp
    _ = (∑ i ∈ I,
        ((((s i) ^ d * SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi)) /
          ((s i) * ρ) ^ (d + 2)) * surfaceMass d)) *
        ∫ y : Euclidean d, ‖b y‖ := by
      rw [Finset.sum_mul]

private theorem inverse_scale_kernel_coefficient_eq
    {d : Nat} {u ρ A : ℝ} (hu : 0 < u) (hρ : 0 < ρ) :
    ((u⁻¹) ^ d * A) / ((u⁻¹ * ρ) ^ (d + 2)) =
      (u ^ 2 * A) / ρ ^ (d + 2) := by
  simp only [div_eq_mul_inv, inv_pow, pow_add, mul_pow]
  field_simp [hu.ne', hρ.ne']

private theorem dyadic_lacunary_past_small_scale_coefficient_sum_le
    {d : Nat} (A : ℝ) (hA : 0 ≤ A)
    (r : ℤ → PositiveRadius) (hr : IsDyadicLacunaryRadiusSelector r)
    (j : ℕ) (K : ℤ) (S : Finset ℕ) {D : ℝ} (hD : 0 < D) :
    let u : ℕ → ℝ := fun n =>
      ((2 : ℝ) ^ j)⁻¹ * (r (K - (n : ℤ)) : ℝ)
    ∑ n ∈ S, (((u n)⁻¹) ^ d * A) / (((u n)⁻¹ * D) ^ (d + 2)) ≤
      ((((2 : ℝ) ^ j)⁻¹) ^ 2 * A / D ^ (d + 2)) *
        ((16 / 3 : ℝ) * ((2 : ℝ) ^ K) ^ 2) := by
  dsimp
  let u : ℕ → ℝ := fun n =>
    ((2 : ℝ) ^ j)⁻¹ * (r (K - (n : ℤ)) : ℝ)
  have hu (n : ℕ) : 0 < u n := by
    dsimp [u]
    exact mul_pos
      (inv_pos.mpr (pow_pos (by norm_num) _))
      (r (K - (n : ℤ))).2
  have hterm (n : ℕ) :
      ((u n)⁻¹ ^ d * A) / ((u n)⁻¹ * D) ^ (d + 2) =
        ((((2 : ℝ) ^ j)⁻¹ ^ 2 * A) / D ^ (d + 2)) *
          (r (K - (n : ℤ)) : ℝ) ^ 2 := by
    rw [inverse_scale_kernel_coefficient_eq (hu n) hD]
    dsimp [u]
    rw [mul_pow]
    ring
  have hconstant : 0 ≤ (((2 : ℝ) ^ j)⁻¹ ^ 2 * A) / D ^ (d + 2) := by
    exact div_nonneg
      (mul_nonneg (pow_nonneg (inv_nonneg.mpr (pow_pos (by norm_num) _).le) _) hA)
      (pow_nonneg hD.le _)
  calc
    ∑ n ∈ S, ((u n)⁻¹ ^ d * A) / ((u n)⁻¹ * D) ^ (d + 2) =
        ∑ n ∈ S,
          ((((2 : ℝ) ^ j)⁻¹ ^ 2 * A) / D ^ (d + 2)) *
            (r (K - (n : ℤ)) : ℝ) ^ 2 := by
          apply Finset.sum_congr rfl
          intro n hn
          exact hterm n
    _ = ((((2 : ℝ) ^ j)⁻¹ ^ 2 * A) / D ^ (d + 2)) *
        ∑ n ∈ S, (r (K - (n : ℤ)) : ℝ) ^ 2 := by
          rw [Finset.mul_sum]
    _ ≤ ((((2 : ℝ) ^ j)⁻¹ ^ 2 * A) / D ^ (d + 2)) *
        ((16 / 3 : ℝ) * ((2 : ℝ) ^ K) ^ 2) :=
      mul_le_mul_of_nonneg_left
        (dyadic_lacunary_selector_finset_past_sq_le r hr K S) hconstant

/-- The finite small-radius portion of a dyadic lacunary selector has an
integrable off-support bad-atom bound.  The displayed inverse power of the
distance is the literal tail used in the weak-`L¹` Calderón argument. -/
theorem dyadic_lacunary_past_small_radius_atom_tail_le
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ)
    (r : ℤ → PositiveRadius) (hr : IsDyadicLacunaryRadiusSelector r)
    (j : ℕ) (K : ℤ) (S : Finset ℕ) {ρ : ℝ} (hρ : 0 < ρ)
    (hsmall : ∀ n ∈ S, (r (K - (n : ℤ)) : ℝ) ≤ ρ)
    {c x : Euclidean d} (hx : 3 * ρ ≤ ‖x - c‖)
    (b : Euclidean d → ℂ) (hb : Integrable b)
    (hbsupp : ∀ y, b y ≠ 0 → ‖y - c‖ ≤ ρ) :
    (∑ n ∈ S, ∫ y : Euclidean d, ‖b y‖ *
      (∫ ω : Metric.sphere (0 : Euclidean d) 1,
        ‖((((((2 : ℝ) ^ j)⁻¹ * (r (K - (n : ℤ)) : ℝ))⁻¹) ^ d : ℝ) : ℂ) •
          (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
            (((((2 : ℝ) ^ j)⁻¹ * (r (K - (n : ℤ)) : ℝ))⁻¹) •
              ((x - y) + (r (K - (n : ℤ)) : ℝ) • (ω : Euclidean d)))‖
          ∂unitSurfaceMeasure d)) ≤
      (
        ((((2 : ℝ) ^ j)⁻¹) ^ 2 *
          SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi) /
            (‖x - c‖ / 3) ^ (d + 2)) *
          ((16 / 3 : ℝ) * ((2 : ℝ) ^ K) ^ 2) *
        surfaceMass d *
        (∫ y : Euclidean d, ‖b y‖)
      ) := by
  let s : ℕ → ℝ := fun n =>
    (((2 : ℝ) ^ j)⁻¹ * (r (K - (n : ℤ)) : ℝ))⁻¹
  let D : ℝ := ‖x - c‖ / 3
  let A : ℝ := SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi)
  have hA : 0 ≤ A := by
    dsimp [A]
    calc
      0 ≤ ‖(0 : Euclidean d)‖ ^ (d + 2) *
          ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) 0‖ := by positivity
      _ ≤ SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi) :=
        SchwartzMap.norm_pow_mul_le_seminorm ℂ
          (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (d + 2) 0
  have hxc : 0 < ‖x - c‖ := by
    have : 0 < 3 * ρ := mul_pos (by norm_num) hρ
    exact lt_of_lt_of_le this hx
  have hD : 0 < D := by
    dsimp [D]
    exact div_pos hxc (by norm_num)
  have hs (n : ℕ) (hn : n ∈ S) : 0 < s n := by
    dsimp [s]
    apply inv_pos.mpr
    exact mul_pos
      (inv_pos.mpr (pow_pos (by norm_num) _))
      (r (K - (n : ℤ))).2
  have hcoeff :
      (∑ n ∈ S, ((s n) ^ d * A) / ((s n) * D) ^ (d + 2)) ≤
        ((((2 : ℝ) ^ j)⁻¹ ^ 2 * A / D ^ (d + 2)) *
          ((16 / 3 : ℝ) * ((2 : ℝ) ^ K) ^ 2)) := by
    simpa only [s] using
      dyadic_lacunary_past_small_scale_coefficient_sum_le
        (d := d) A hA r hr j K S hD
  have hsum :
      (∑ n ∈ S, ∫ y : Euclidean d, ‖b y‖ *
        (∫ ω : Metric.sphere (0 : Euclidean d) 1,
          ‖(((s n) ^ d : ℝ) : ℂ) •
            (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
              ((s n) • ((x - y) + (r (K - (n : ℤ)) : ℝ) •
                (ω : Euclidean d)))‖
            ∂unitSurfaceMeasure d)) ≤
        (∑ n ∈ S, ((s n) ^ d * A) / ((s n) * D) ^ (d + 2)) *
          surfaceMass d * (∫ y : Euclidean d, ‖b y‖) := by
    calc
      (∑ n ∈ S, ∫ y : Euclidean d, ‖b y‖ *
        (∫ ω : Metric.sphere (0 : Euclidean d) 1,
          ‖(((s n) ^ d : ℝ) : ℂ) •
            (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
              ((s n) • ((x - y) + (r (K - (n : ℤ)) : ℝ) •
                (ω : Euclidean d)))‖
            ∂unitSurfaceMeasure d)) ≤
          ∑ n ∈ S, (((s n) ^ d * A) / ((s n) * D) ^ (d + 2)) *
            surfaceMass d * (∫ y : Euclidean d, ‖b y‖) := by
            refine Finset.sum_le_sum fun n hn => ?_
            exact
              integral_norm_mul_integral_norm_complexScaled_fourierInv_le_of_small_radius_far_distance
                psi (hs n hn) hρ (r (K - (n : ℤ))).2.le (hsmall n hn)
                hx b hb hbsupp
      _ = (∑ n ∈ S, ((s n) ^ d * A) / ((s n) * D) ^ (d + 2)) *
          surfaceMass d * (∫ y : Euclidean d, ‖b y‖) := by
            rw [Finset.sum_mul, Finset.sum_mul]
  have hright : 0 ≤ surfaceMass d * (∫ y : Euclidean d, ‖b y‖) :=
    mul_nonneg measureReal_nonneg (integral_nonneg fun _ => norm_nonneg _)
  calc
    (∑ n ∈ S, ∫ y : Euclidean d, ‖b y‖ *
      (∫ ω : Metric.sphere (0 : Euclidean d) 1,
        ‖((((((2 : ℝ) ^ j)⁻¹ * (r (K - (n : ℤ)) : ℝ))⁻¹) ^ d : ℝ) : ℂ) •
          (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
            (((((2 : ℝ) ^ j)⁻¹ * (r (K - (n : ℤ)) : ℝ))⁻¹) •
              ((x - y) + (r (K - (n : ℤ)) : ℝ) • (ω : Euclidean d)))‖
          ∂unitSurfaceMeasure d)) ≤
        (∑ n ∈ S, ((s n) ^ d * A) / ((s n) * D) ^ (d + 2)) *
          surfaceMass d * (∫ y : Euclidean d, ‖b y‖) := by
          simpa only [s] using hsum
    _ ≤ ((((2 : ℝ) ^ j)⁻¹ ^ 2 * A / D ^ (d + 2)) *
          ((16 / 3 : ℝ) * ((2 : ℝ) ^ K) ^ 2)) *
        surfaceMass d * (∫ y : Euclidean d, ‖b y‖) := by
          simpa only [mul_assoc] using
            mul_le_mul_of_nonneg_right hcoeff hright
    _ = (((((2 : ℝ) ^ j)⁻¹) ^ 2 *
          SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi) /
            (‖x - c‖ / 3) ^ (d + 2)) *
          ((16 / 3 : ℝ) * ((2 : ℝ) ^ K) ^ 2) *
          surfaceMass d * (∫ y : Euclidean d, ‖b y‖)) := by
          rfl

/-- Summing the literal translation estimates over a finite collection of
selected scales only costs the sum of their physical frequencies.  This is
the large-radius contribution that is later paired with the geometric tail
of a dyadic lacunary selector. -/
theorem sum_integral_norm_sphericalAverage_complexScaled_fourierInv_sub_translate_le
    {d : Nat} {ι : Type*} (psi : SchwartzMap (Euclidean d) ℂ)
    (I : Finset ι) (s r : ι → ℝ) (hs : ∀ i ∈ I, 0 < s i)
    (h : Euclidean d) :
    (∑ i ∈ I, ∫ x : Euclidean d,
      ‖sphericalAverage d
          (fun y : Euclidean d => (((s i) ^ d : ℝ) : ℂ) •
            (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) ((s i) • y)) (r i) (x + h) -
        sphericalAverage d
          (fun y : Euclidean d => (((s i) ^ d : ℝ) : ℂ) •
            (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) ((s i) • y)) (r i) x‖) ≤
      surfaceMass d * ‖h‖ * (∑ i ∈ I, s i) *
        ∫ x : Euclidean d,
          ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
            Euclidean d → ℂ) x‖ := by
  calc
    (∑ i ∈ I, ∫ x : Euclidean d,
      ‖sphericalAverage d
          (fun y : Euclidean d => (((s i) ^ d : ℝ) : ℂ) •
            (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) ((s i) • y)) (r i) (x + h) -
        sphericalAverage d
          (fun y : Euclidean d => (((s i) ^ d : ℝ) : ℂ) •
            (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) ((s i) • y)) (r i) x‖) ≤
        ∑ i ∈ I, surfaceMass d * ‖h‖ * s i *
          ∫ x : Euclidean d,
            ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
              Euclidean d → ℂ) x‖ := by
          refine Finset.sum_le_sum fun i hi => ?_
          exact integral_norm_sphericalAverage_complexScaled_fourierInv_sub_translate_le
            psi (hs i hi) (r i) h
    _ = (∑ i ∈ I, surfaceMass d * ‖h‖ * s i) *
        ∫ x : Euclidean d,
          ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
            Euclidean d → ℂ) x‖ := by
          rw [Finset.sum_mul]
    _ = surfaceMass d * ‖h‖ * (∑ i ∈ I, s i) *
        ∫ x : Euclidean d,
          ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
            Euclidean d → ℂ) x‖ := by
          rw [Finset.mul_sum]

/-- For a dyadic lacunary selector, summing the large-radius translation
cost over any finite future tail gives the expected geometric bound.  This
is the concrete analytic half of the bad-ball estimate; cancellation of the
input atom is handled at the next stage. -/
theorem dyadic_lacunary_tail_integral_norm_sphericalAverage_complexScaled_fourierInv_sub_translate_le
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ)
    (r : ℤ → PositiveRadius) (hr : IsDyadicLacunaryRadiusSelector r)
    (j : ℕ) (K : ℤ) (S : Finset ℕ) (h : Euclidean d) :
    (∑ n ∈ S, ∫ x : Euclidean d,
      ‖sphericalAverage d
          (fun y : Euclidean d =>
            ((((((2 : ℝ) ^ j)⁻¹ * (r (K + (n : ℤ)) : ℝ))⁻¹) ^ d : ℝ) : ℂ) •
              (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
                (((((2 : ℝ) ^ j)⁻¹ * (r (K + (n : ℤ)) : ℝ))⁻¹) • y))
          (r (K + (n : ℤ)) : ℝ) (x + h) -
        sphericalAverage d
          (fun y : Euclidean d =>
            ((((((2 : ℝ) ^ j)⁻¹ * (r (K + (n : ℤ)) : ℝ))⁻¹) ^ d : ℝ) : ℂ) •
              (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
                (((((2 : ℝ) ^ j)⁻¹ * (r (K + (n : ℤ)) : ℝ))⁻¹) • y))
          (r (K + (n : ℤ)) : ℝ) x‖) ≤
      surfaceMass d * ‖h‖ *
        (2 * (2 : ℝ) ^ j * ((2 : ℝ) ^ K)⁻¹) *
          ∫ x : Euclidean d,
            ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
              Euclidean d → ℂ) x‖ := by
  let s : ℕ → ℝ := fun n =>
    (((2 : ℝ) ^ j)⁻¹ * (r (K + (n : ℤ)) : ℝ))⁻¹
  have hs (n : ℕ) (hn : n ∈ S) : 0 < s n := by
    dsimp [s]
    apply inv_pos.mpr
    apply mul_pos
    · exact inv_pos.mpr (pow_pos (by norm_num) _)
    · exact (r (K + (n : ℤ))).2
  have hsum :=
    sum_integral_norm_sphericalAverage_complexScaled_fourierInv_sub_translate_le
      psi S s (fun n => (r (K + (n : ℤ)) : ℝ)) hs h
  have htail : (∑ n ∈ S, s n) ≤
      2 * (2 : ℝ) ^ j * ((2 : ℝ) ^ K)⁻¹ := by
    simpa only [s] using dyadic_lacunary_selector_finset_tail_le r hr j K S
  have hsurface : 0 ≤ surfaceMass d * ‖h‖ :=
    mul_nonneg measureReal_nonneg (norm_nonneg _)
  have hderiv : 0 ≤ ∫ x : Euclidean d,
      ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) x‖ :=
    integral_nonneg fun _ => norm_nonneg _
  calc
    (∑ n ∈ S, ∫ x : Euclidean d,
      ‖sphericalAverage d
          (fun y : Euclidean d =>
            ((((((2 : ℝ) ^ j)⁻¹ * (r (K + (n : ℤ)) : ℝ))⁻¹) ^ d : ℝ) : ℂ) •
              (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
                (((((2 : ℝ) ^ j)⁻¹ * (r (K + (n : ℤ)) : ℝ))⁻¹) • y))
          (r (K + (n : ℤ)) : ℝ) (x + h) -
        sphericalAverage d
          (fun y : Euclidean d =>
            ((((((2 : ℝ) ^ j)⁻¹ * (r (K + (n : ℤ)) : ℝ))⁻¹) ^ d : ℝ) : ℂ) •
              (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
                (((((2 : ℝ) ^ j)⁻¹ * (r (K + (n : ℤ)) : ℝ))⁻¹) • y))
          (r (K + (n : ℤ)) : ℝ) x‖) ≤
        surfaceMass d * ‖h‖ * (∑ n ∈ S, s n) *
          ∫ x : Euclidean d,
            ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
              Euclidean d → ℂ) x‖ := by
          simpa only [s] using hsum
    _ ≤ surfaceMass d * ‖h‖ *
        (2 * (2 : ℝ) ^ j * ((2 : ℝ) ^ K)⁻¹) *
          ∫ x : Euclidean d,
            ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
              Euclidean d → ℂ) x‖ := by
          exact mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left htail hsurface) hderiv

/-- The finite future tail of a dyadic lacunary selector applied to one
mean-zero bad atom has the expected global `L¹` bound. -/
theorem dyadic_lacunary_future_atom_tail_le
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ)
    (r : ℤ → PositiveRadius) (hr : IsDyadicLacunaryRadiusSelector r)
    (j : ℕ) (K : ℤ) (S : Finset ℕ)
    (b : Euclidean d → ℂ) (hb : Integrable b)
    (hzero : (∫ y : Euclidean d, b y) = 0)
    {c : Euclidean d} {ρ : ℝ} (hρ : 0 ≤ ρ)
    (hbsupp : ∀ y, b y ≠ 0 → ‖y - c‖ ≤ ρ) :
    (∑ n ∈ S, ∫ x : Euclidean d, ‖∫ y : Euclidean d, b y *
      sphericalAverage d
        (fun z : Euclidean d =>
          ((((((2 : ℝ) ^ j)⁻¹ * (r (K + (n : ℤ)) : ℝ))⁻¹) ^ d : ℝ) : ℂ) •
            (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
              (((((2 : ℝ) ^ j)⁻¹ * (r (K + (n : ℤ)) : ℝ))⁻¹) • z))
        (r (K + (n : ℤ)) : ℝ) (x - y)‖) ≤
      surfaceMass d * ρ *
        (2 * (2 : ℝ) ^ j * ((2 : ℝ) ^ K)⁻¹) *
          (∫ x : Euclidean d,
            ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
              Euclidean d → ℂ) x‖) *
          (∫ y : Euclidean d, ‖b y‖) := by
  let s : ℕ → ℝ := fun n =>
    (((2 : ℝ) ^ j)⁻¹ * (r (K + (n : ℤ)) : ℝ))⁻¹
  let D : ℝ := ∫ x : Euclidean d,
    ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
      Euclidean d → ℂ) x‖
  let B : ℝ := ∫ y : Euclidean d, ‖b y‖
  have hs (n : ℕ) (hn : n ∈ S) : 0 < s n := by
    dsimp [s]
    apply inv_pos.mpr
    exact mul_pos
      (inv_pos.mpr (pow_pos (by norm_num) _))
      (r (K + (n : ℤ))).2
  have hD : 0 ≤ D := by
    dsimp [D]
    exact integral_nonneg fun _ => norm_nonneg _
  have hB : 0 ≤ B := by
    dsimp [B]
    exact integral_nonneg fun _ => norm_nonneg _
  let C : ℝ := surfaceMass d * ρ * D * B
  have hC : 0 ≤ C := by
    dsimp [C]
    exact mul_nonneg
      (mul_nonneg (mul_nonneg measureReal_nonneg hρ) hD) hB
  have hsum :
      (∑ n ∈ S, ∫ x : Euclidean d, ‖∫ y : Euclidean d, b y *
        sphericalAverage d
          (fun z : Euclidean d => (((s n) ^ d : ℝ) : ℂ) •
            (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) ((s n) • z))
          (r (K + (n : ℤ)) : ℝ) (x - y)‖) ≤
        ∑ n ∈ S, C * s n := by
    refine Finset.sum_le_sum fun n hn => ?_
    have hsingle :=
      integral_norm_mean_zero_sphericalAverage_complexScaled_fourierInv_atom_le
        psi (hs n hn) (r (K + (n : ℤ)) : ℝ) b hb hzero hbsupp
    calc
      (∫ x : Euclidean d, ‖∫ y : Euclidean d, b y *
        sphericalAverage d
          (fun z : Euclidean d => (((s n) ^ d : ℝ) : ℂ) •
            (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) ((s n) • z))
          (r (K + (n : ℤ)) : ℝ) (x - y)‖) ≤
          surfaceMass d * ρ * s n * D * B := by
            simpa only [D, B] using hsingle
      _ = C * s n := by
        dsimp [C]
        ring
  have htail : (∑ n ∈ S, s n) ≤
      2 * (2 : ℝ) ^ j * ((2 : ℝ) ^ K)⁻¹ := by
    simpa only [s] using dyadic_lacunary_selector_finset_tail_le r hr j K S
  calc
    (∑ n ∈ S, ∫ x : Euclidean d, ‖∫ y : Euclidean d, b y *
      sphericalAverage d
        (fun z : Euclidean d =>
          ((((((2 : ℝ) ^ j)⁻¹ * (r (K + (n : ℤ)) : ℝ))⁻¹) ^ d : ℝ) : ℂ) •
            (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
              (((((2 : ℝ) ^ j)⁻¹ * (r (K + (n : ℤ)) : ℝ))⁻¹) • z))
        (r (K + (n : ℤ)) : ℝ) (x - y)‖) =
        ∑ n ∈ S, ∫ x : Euclidean d, ‖∫ y : Euclidean d, b y *
          sphericalAverage d
            (fun z : Euclidean d => (((s n) ^ d : ℝ) : ℂ) •
              (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) ((s n) • z))
            (r (K + (n : ℤ)) : ℝ) (x - y)‖ := by
          simp only [s]
    _ ≤ ∑ n ∈ S, C * s n := hsum
    _ = C * (∑ n ∈ S, s n) := by
      rw [Finset.mul_sum]
    _ ≤ C * (2 * (2 : ℝ) ^ j * ((2 : ℝ) ^ K)⁻¹) :=
      mul_le_mul_of_nonneg_left htail hC
    _ = surfaceMass d * ρ *
        (2 * (2 : ℝ) ^ j * ((2 : ℝ) ^ K)⁻¹) * D * B := by
          dsimp [C]
          ring
    _ = _ := by rfl

/-- Before summing selected scales, the signed physical action of an
integrable atom is bounded by the corresponding literal positive surface
kernel.  This is the pointwise bridge between the cancellation estimates and
the small-radius exterior tail. -/
theorem norm_integral_sphericalAverage_complexScaled_fourierInv_le_positive
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ)
    {s : ℝ} (hs : 0 < s) (r : ℝ)
    (b : Euclidean d → ℂ) (hb : Integrable b) (x : Euclidean d) :
    ‖∫ y : Euclidean d, b y *
      sphericalAverage d
        (fun z : Euclidean d => ((s ^ d : ℝ) : ℂ) •
          (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)) r (x - y)‖ ≤
      ∫ y : Euclidean d, ‖b y‖ *
        (∫ ω : Metric.sphere (0 : Euclidean d) 1,
          ‖((s ^ d : ℝ) : ℂ) •
            (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ)
              (s • ((x - y) + r • (ω : Euclidean d)))‖
          ∂unitSurfaceMeasure d) := by
  let k : Euclidean d → ℂ := fun z => ((s ^ d : ℝ) : ℂ) •
    (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)
  let W : Euclidean d → ℝ := fun y =>
    ∫ ω : Metric.sphere (0 : Euclidean d) 1,
      ‖k ((x - y) + r • (ω : Euclidean d))‖ ∂unitSurfaceMeasure d
  let B : ℝ := s ^ d *
    ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ).toBoundedContinuousFunction‖
  have hspow : 0 ≤ s ^ d := pow_nonneg hs.le _
  have hB : 0 ≤ B := by
    dsimp [B]
    exact mul_nonneg hspow (norm_nonneg _)
  have hkbound (z : Euclidean d) : ‖k z‖ ≤ B := by
    dsimp [k, B]
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg hspow]
    exact mul_le_mul_of_nonneg_left
      (BoundedContinuousFunction.norm_coe_le_norm
        ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ).toBoundedContinuousFunction)
        (s • z)) hspow
  have hWnonneg (y : Euclidean d) : 0 ≤ W y := by
    dsimp [W]
    exact integral_nonneg fun _ => norm_nonneg _
  have hWjoint : Continuous (Function.uncurry
      (fun (y : Euclidean d) (ω : Metric.sphere (0 : Euclidean d) 1) =>
        ‖k ((x - y) + r • (ω : Euclidean d))‖)) := by
    have hkcont : Continuous k := by
      dsimp [k]
      exact continuous_const.mul
        ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ).continuous.comp
          ((continuous_const : Continuous fun _ : Euclidean d => s).smul continuous_id))
    exact (hkcont.comp
      ((continuous_const.sub continuous_fst).add
        ((continuous_const : Continuous fun _ :
          Euclidean d × Metric.sphere (0 : Euclidean d) 1 => r).smul
          (continuous_subtype_val.comp continuous_snd)))).norm
  have hWcont : Continuous W := by
    dsimp [W]
    simpa only [Measure.restrict_univ, smul_eq_mul] using
      (continuous_parametric_integral_of_continuous
        (μ := unitSurfaceMeasure d) hWjoint isCompact_univ)
  have hWbound (y : Euclidean d) : W y ≤ B * surfaceMass d := by
    calc
      W y = ‖W y‖ := (Real.norm_of_nonneg (hWnonneg y)).symm
      _ ≤ B * surfaceMass d := by
        rw [show surfaceMass d = (unitSurfaceMeasure d).real univ from rfl]
        dsimp [W]
        apply norm_integral_le_of_norm_le_const
          (f := fun ω : Metric.sphere (0 : Euclidean d) 1 =>
            ‖k ((x - y) + r • (ω : Euclidean d))‖) (C := B)
        filter_upwards with ω
        rw [Real.norm_of_nonneg (norm_nonneg _)]
        exact hkbound _
  have hprodmeas : AEStronglyMeasurable (fun y : Euclidean d => ‖b y‖ * W y)
      volume := hb.norm.aestronglyMeasurable.mul hWcont.aestronglyMeasurable
  have hrightint : Integrable (fun y : Euclidean d => ‖b y‖ *
      (B * surfaceMass d)) volume := hb.norm.mul_const _
  have hleftint : Integrable (fun y : Euclidean d => ‖b y‖ * W y) volume := by
    refine hrightint.mono' hprodmeas (Filter.Eventually.of_forall fun y => ?_)
    rw [Real.norm_of_nonneg]
    · exact mul_le_mul_of_nonneg_left (hWbound y) (norm_nonneg _)
    · exact mul_nonneg (norm_nonneg _) (hWnonneg _)
  have hsa (y : Euclidean d) :
      ‖sphericalAverage d k r (x - y)‖ ≤ W y := by
    unfold sphericalAverage
    exact norm_integral_le_integral_norm _
  calc
    ‖∫ y : Euclidean d, b y *
      sphericalAverage d
        (fun z : Euclidean d => ((s ^ d : ℝ) : ℂ) •
          (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)) r (x - y)‖ =
        ‖∫ y : Euclidean d, b y * sphericalAverage d k r (x - y)‖ := by rfl
    _ ≤ ∫ y : Euclidean d, ‖b y * sphericalAverage d k r (x - y)‖ :=
      norm_integral_le_integral_norm _
    _ = ∫ y : Euclidean d, ‖b y‖ * ‖sphericalAverage d k r (x - y)‖ := by
      apply integral_congr_ae
      filter_upwards with y
      rw [norm_mul]
    _ ≤ ∫ y : Euclidean d, ‖b y‖ * W y := by
      apply integral_mono_of_nonneg
      · filter_upwards with y
        exact mul_nonneg (norm_nonneg _) (norm_nonneg _)
      · exact hleftint
      · filter_upwards with y
        exact mul_le_mul_of_nonneg_left (hsa y) (norm_nonneg _)
    _ = _ := by rfl

end

end LeanSpherical.HarmonicAnalysis
