The estimate is uniform in the spherical radius. -/
theorem integral_norm_sphericalAverage_scaled_fourierInv_sub_translate_le
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ)
    {s : ℝ} (hs : 0 < s) (r : ℝ) (h : Euclidean d) :
    (∫ x : Euclidean d,
      ‖sphericalAverage d
          (fun y : Euclidean d => (s ^ d) •
            (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • y)) r (x + h) -
        sphericalAverage d
          (fun y : Euclidean d => (s ^ d) •
            (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • y)) r x‖) ≤
      surfaceMass d * ‖h‖ * s *
        ∫ x : Euclidean d,
          ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
            Euclidean d → ℂ) x‖ := by
  let A : Euclidean d ≃L[ℝ] Euclidean d :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 s hs.ne')
  let K : SchwartzMap (Euclidean d) ℂ :=
    (s ^ d) • (SchwartzMap.compCLMOfContinuousLinearEquiv ℂ A) (𝓕⁻ psi)
  have hKform (y : Euclidean d) :
      K y = (s ^ d) • (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • y) := by
    change (s ^ d) • (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (A y) = _
    simp [A]
  have hKdiff : ContDiff ℝ 1 (K : Euclidean d → ℂ) := by
    simpa using K.smooth (1 : ℕ∞)
  have hKcont : Continuous (K : Euclidean d → ℂ) := hKdiff.continuous
  have hKfun : (K : Euclidean d → ℂ) = fun y : Euclidean d =>
      (s ^ d) • (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • y) := by
    funext y
    exact hKform y
  have hKderiv : Integrable (fderiv ℝ (K : Euclidean d → ℂ)) volume := by
    let dK : SchwartzMap (Euclidean d) (Euclidean d →L[ℝ] ℂ) :=
      (SchwartzMap.fderivCLM ℂ (Euclidean d) ℂ) K
