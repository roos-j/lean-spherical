      atTop.liminf (fun n => ∫⁻ x, (F n x) ^ p.toReal ∂μ) := by
    calc
      ∫⁻ x, ‖atTop.liminf (fun n => F n x)‖ₑ ^ p.toReal ∂μ =
          ∫⁻ x, atTop.liminf (fun n => (F n x) ^ p.toReal) ∂μ := by
        simp_rw [enorm_eq_self, hpow_liminf]
      _ ≤ atTop.liminf (fun n => ∫⁻ x, (F n x) ^ p.toReal ∂μ) := by
        apply lintegral_liminf_le'
        intro n
        exact (ENNReal.continuous_rpow_const.measurable.comp (hmeas n)).aemeasurable
  calc
    (∫⁻ x, ‖atTop.liminf (fun n => F n x)‖ₑ ^ p.toReal ∂μ) ^
        (1 / p.toReal) ≤
        (atTop.liminf (fun n => ∫⁻ x, (F n x) ^ p.toReal ∂μ)) ^
          (1 / p.toReal) := ENNReal.rpow_le_rpow hIntegral (by positivity)
    _ = atTop.liminf (fun n =>
        (∫⁻ x, (F n x) ^ p.toReal ∂μ) ^ (1 / p.toReal)) := by
      let e : ℝ≥0∞ ≃o ℝ≥0∞ :=
        ENNReal.orderIsoRpow (1 / p.toReal) (by positivity)
      change e (atTop.liminf (fun n => ∫⁻ x, (F n x) ^ p.toReal ∂μ)) =
        atTop.liminf (fun n => e (∫⁻ x, (F n x) ^ p.toReal ∂μ))
      exact OrderIso.liminf_apply e (by isBoundedDefault) (by isBoundedDefault)
        (by isBoundedDefault) (by isBoundedDefault)
    _ = atTop.liminf (fun n => eLpNorm (F n) p μ) := by
      congr 1
      funext n
      rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop]
      simp only [enorm_eq_self]

private theorem eLpNorm_le_of_ae_le_liminf_of_uniform {α : Type*} [MeasurableSpace α]
    {μ : Measure α} {p : ℝ≥0∞} (hp0 : p ≠ 0) (hptop : p ≠ ∞)
    {F : α → ℝ≥0∞} {G : ℕ → α → ℝ≥0∞} {K : ℝ≥0∞}
    (hle : ∀ᵐ x ∂μ, F x ≤ atTop.liminf (fun n => G n x))
    (hmeas : ∀ n, Measurable (G n))
    (hbound : ∀ n, eLpNorm (G n) p μ ≤ K) :
    eLpNorm F p μ ≤ K := by
  calc
    eLpNorm F p μ ≤ eLpNorm (fun x => atTop.liminf (fun n => G n x)) p μ :=
      eLpNorm_mono_enorm_ae (hle.mono fun x hx => by
        simpa only [enorm_eq_self] using hx)
    _ ≤ K := eLpNorm_liminf_le_of_uniform hp0 hptop hmeas hbound

private def smoothPos (ε z : ℝ) : ℝ :=
  z * Real.smoothTransition (z / ε)

private theorem smoothPos_nonneg {ε z : ℝ} (hε : 0 < ε) :
    0 ≤ smoothPos ε z := by
  by_cases hz : z ≤ 0
  · rw [show smoothPos ε z = 0 by
      simp [smoothPos, Real.smoothTransition.zero_of_nonpos
        (div_nonpos_of_nonpos_of_nonneg hz hε.le)]]
  · exact mul_nonneg (le_of_lt (lt_of_not_ge hz))
      (Real.smoothTransition.nonneg _)

private theorem smoothPos_le_max {ε z : ℝ} (hε : 0 < ε) :
    smoothPos ε z ≤ max 0 z := by
  by_cases hz : z ≤ 0
  · rw [show smoothPos ε z = 0 by
      simp [smoothPos, Real.smoothTransition.zero_of_nonpos
        (div_nonpos_of_nonpos_of_nonneg hz hε.le)], max_eq_left hz]
  · rw [max_eq_right (le_of_lt (lt_of_not_ge hz))]
    exact mul_le_of_le_one_right (lt_of_not_ge hz).le
      (Real.smoothTransition.le_one _)

private theorem max_le_smoothPos_add {ε z : ℝ} (hε : 0 < ε) :
    max 0 z ≤ smoothPos ε z + ε := by
  by_cases hz : z ≤ 0
  · rw [max_eq_left hz]
    linarith [smoothPos_nonneg hε (z := z)]
  · rw [max_eq_right (le_of_lt (lt_of_not_ge hz))]
    by_cases hze : ε ≤ z
    · have hdiv : 1 ≤ z / ε := (le_div_iff₀ hε).2 (by simpa using hze)
      rw [smoothPos, Real.smoothTransition.one_of_one_le hdiv]
      linarith
    · have hlt : z < ε := lt_of_not_ge hze
      linarith [smoothPos_nonneg hε (z := z)]

private theorem contDiff_smoothPos {ε : ℝ} (_ : ε ≠ 0) :
    ContDiff ℝ (⊤ : ℕ∞) (smoothPos ε) := by
  exact contDiff_id.mul
    (Real.smoothTransition.contDiff.comp (contDiff_id.div_const ε))

private theorem exists_smooth_minorant_of_continuous_compact
    {d : ℕ} (c : EuclideanSpace ℝ (Fin d) → ℝ) (hc : Continuous c)
    (hcsupp : HasCompactSupport c) (hc0 : ∀ x, 0 ≤ c x)
    {ε : ℝ} (hε : 0 < ε) :
    ∃ w : EuclideanSpace ℝ (Fin d) → ℝ,
      HasCompactSupport w ∧ ContDiff ℝ (⊤ : ℕ∞) w ∧
        (∀ x, 0 ≤ w x) ∧ (∀ x, w x ≤ c x) ∧
          ∀ x, c x ≤ w x + 3 * ε := by
  have huc : UniformContinuous c :=
    hc.uniformContinuous_of_tendsto_cocompact hcsupp.is_zero_at_infty
  obtain ⟨v, hv, hvclose⟩ := huc.exists_contDiff_dist_le hε
  let w : EuclideanSpace ℝ (Fin d) → ℝ := fun x => smoothPos ε (v x - ε)
  have hvupper (x : EuclideanSpace ℝ (Fin d)) : v x - ε < c x := by
    have h := hvclose x
    rw [Real.dist_eq] at h
    linarith [le_abs_self (v x - c x)]
  have hvlower (x : EuclideanSpace ℝ (Fin d)) : c x - ε < v x := by
    have h := hvclose x
    rw [Real.dist_eq] at h
    linarith [neg_le_abs (v x - c x)]
  refine ⟨w, ?_, ?_, ?_, ?_, ?_⟩
  · apply hcsupp.mono
    intro x hx
    by_contra hxc
    have hczero : c x = 0 := by
      rw [← Function.notMem_support]
      exact hxc
    have hneg : v x - ε < 0 := by linarith [hvupper x]
    have hwzero : w x = 0 := by
      change (v x - ε) * Real.smoothTransition ((v x - ε) / ε) = 0
      rw [Real.smoothTransition.zero_of_nonpos
        (div_nonpos_of_nonpos_of_nonneg hneg.le hε.le)]
      ring
    exact hx hwzero
  · exact (contDiff_smoothPos hε.ne').comp (hv.sub contDiff_const)
  · intro x
    exact smoothPos_nonneg hε
  · intro x
    calc
      w x ≤ max 0 (v x - ε) := smoothPos_le_max hε
      _ ≤ c x := by
        rw [max_le_iff]
        exact ⟨hc0 x, le_of_lt (hvupper x)⟩
  · intro x
    have hpos : max 0 (v x - ε) ≤ w x + ε := max_le_smoothPos_add hε
    have haux : c x ≤ max 0 (v x - ε) + 2 * ε := by
      by_cases hcx : c x ≤ 2 * ε
      · have : 0 ≤ max 0 (v x - ε) := le_max_left _ _
        linarith
      · rw [max_eq_right]
        · linarith [hvlower x]
        · linarith [hvlower x, hcx]
    linarith

private def lowerEnvelope {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (G : X → ℝ) (n : ℕ) (x : X) : ℝ :=
  ⨅ y : X, G y + (n : ℝ) * dist x y

private theorem lowerEnvelope_bddBelow {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (G : X → ℝ) (hG0 : ∀ x, 0 ≤ G x)
    (n : ℕ) (x : X) :
    BddBelow (range fun y : X => G y + (n : ℝ) * dist x y) := by
  refine ⟨0, ?_⟩
  rintro z ⟨y, rfl⟩
  exact add_nonneg (hG0 y) (mul_nonneg (Nat.cast_nonneg _) dist_nonneg)

private theorem lowerEnvelope_nonneg {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (G : X → ℝ) (hG0 : ∀ x, 0 ≤ G x)
    (n : ℕ) (x : X) : 0 ≤ lowerEnvelope G n x := by
  unfold lowerEnvelope
  apply le_ciInf
  intro y
  exact add_nonneg (hG0 y) (mul_nonneg (Nat.cast_nonneg _) dist_nonneg)

private theorem lowerEnvelope_le {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (G : X → ℝ) (hG0 : ∀ x, 0 ≤ G x)
    (n : ℕ) (x : X) : lowerEnvelope G n x ≤ G x := by
  unfold lowerEnvelope
  simpa using ciInf_le (lowerEnvelope_bddBelow G hG0 n x) x

private theorem lowerEnvelope_lipschitz {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (G : X → ℝ) (hG0 : ∀ x, 0 ≤ G x)
    (n : ℕ) : LipschitzWith (n : NNReal) (lowerEnvelope G n) := by
  apply LipschitzWith.of_le_add_mul
  intro x y
  unfold lowerEnvelope
  have hmono :
      (⨅ z : X, G z + (n : ℝ) * dist x z) ≤
        (⨅ z : X, G z + (n : ℝ) * dist y z + (n : ℝ) * dist x y) := by
    apply ciInf_mono (lowerEnvelope_bddBelow G hG0 n x)
    intro z
    calc
      G z + (n : ℝ) * dist x z ≤
          G z + (n : ℝ) * (dist y z + dist x y) := by
            gcongr
            calc
              dist x z ≤ dist x y + dist y z := dist_triangle _ _ _
              _ = dist y z + dist x y := by ring
      _ = G z + (n : ℝ) * dist y z + (n : ℝ) * dist x y := by ring
  have hadd :
      (⨅ z : X, G z + (n : ℝ) * dist y z + (n : ℝ) * dist x y) =
        (⨅ z : X, G z + (n : ℝ) * dist y z) + (n : ℝ) * dist x y := by
    refine (Monotone.map_ciInf_of_continuousAt
      (f := fun u : ℝ => u + (n : ℝ) * dist x y)
      (g := fun z : X => G z + (n : ℝ) * dist y z) ?_ ?_ ?_).symm
    · exact continuousAt_id.add continuousAt_const
    · intro a b hab
      simpa [add_comm] using add_le_add_right hab ((n : ℝ) * dist x y)
    · exact lowerEnvelope_bddBelow G hG0 n y
  simpa using hmono.trans_eq hadd

private theorem lowerEnvelope_continuous {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (G : X → ℝ) (hG0 : ∀ x, 0 ≤ G x)
    (n : ℕ) : Continuous (lowerEnvelope G n) :=
  (lowerEnvelope_lipschitz G hG0 n).continuous

private theorem eventually_lt_lowerEnvelope_of_lt {X : Type*} [NormedAddCommGroup X]
    [NormedSpace ℝ X]
    (G : X → ℝ) (hG0 : ∀ x, 0 ≤ G x) {B : ℝ} (hGB : ∀ x, G x ≤ B)
    (hG : LowerSemicontinuous G) (x : X) {a : ℝ} (ha : a < G x) :
    ∀ᶠ n : ℕ in atTop, a < lowerEnvelope G n x := by
  obtain ⟨b, hab, hb⟩ := exists_between ha
  obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.mp (hG.isOpen_preimage b) x hb
  obtain ⟨N, hN⟩ : ∃ N : ℕ, B / δ < N := exists_nat_gt (B / δ)
  filter_upwards [eventually_ge_atTop N] with n hn
  have hncast : (N : ℝ) ≤ n := by exact_mod_cast hn
  have hnreal : B / δ < (n : ℝ) := hN.trans_le hncast
  have hndelta : B < (n : ℝ) * δ := (div_lt_iff₀ hδ).mp hnreal
  unfold lowerEnvelope
  refine lt_of_lt_of_le hab (le_ciInf fun y => ?_)
  by_cases hy : y ∈ Metric.ball x δ
  · exact (hball hy).le.trans (le_add_of_nonneg_right
      (mul_nonneg (Nat.cast_nonneg _) dist_nonneg))
  · have hdist : δ ≤ dist x y := by
      apply le_of_not_gt
      intro hlt
      apply hy
      rw [Metric.mem_ball]
      simpa [dist_comm] using hlt
    have hbB : b ≤ B := hb.le.trans (hGB x)
    exact (calc
      b ≤ B := hbB
      _ < (n : ℝ) * δ := hndelta
      _ ≤ G y + (n : ℝ) * dist x y := by
        simpa using add_le_add (hG0 y)
          (mul_le_mul_of_nonneg_left hdist (Nat.cast_nonneg n))).le

private theorem exists_schwartz_minorants_of_bounded_lsc
    {d : ℕ} (G : EuclideanSpace ℝ (Fin d) → ℝ) (hG0 : ∀ x, 0 ≤ G x)
    {B : ℝ} (hGB : ∀ x, G x ≤ B) (hG : LowerSemicontinuous G) :
    ∃ ψ : ℕ → SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ,
      (∀ n x, ψ n x = ((ψ n x).re : ℂ)) ∧
      (∀ n x, 0 ≤ (ψ n x).re) ∧
      (∀ n x, (ψ n x).re ≤ G x) ∧
      ∀ x, Tendsto (fun n => (ψ n x).re) atTop (𝓝 (G x)) := by
  let L : ℕ → EuclideanSpace ℝ (Fin d) → ℝ := lowerEnvelope G
  let b : ℕ → ContDiffBump (0 : EuclideanSpace ℝ (Fin d)) := fun n =>
    ⟨(n : ℝ) + 1, (n : ℝ) + 2, by positivity, by linarith⟩
  let c : ℕ → EuclideanSpace ℝ (Fin d) → ℝ := fun n x => b n x * L n x
  have hL0 (n : ℕ) (x : EuclideanSpace ℝ (Fin d)) : 0 ≤ L n x :=
    lowerEnvelope_nonneg G hG0 n x
  have hLle (n : ℕ) (x : EuclideanSpace ℝ (Fin d)) : L n x ≤ G x :=
    lowerEnvelope_le G hG0 n x
  have hLcont (n : ℕ) : Continuous (L n) :=
    lowerEnvelope_continuous G hG0 n
  have hLtend (x : EuclideanSpace ℝ (Fin d)) :
      Tendsto (fun n => L n x) atTop (𝓝 (G x)) := by
    apply tendsto_order.2
    constructor
    · intro a ha
      exact eventually_lt_lowerEnvelope_of_lt G hG0 hGB hG x ha
    · intro a ha
      filter_upwards with n
      exact (hLle n x).trans_lt ha
  have hb_tend (x : EuclideanSpace ℝ (Fin d)) :
      Tendsto (fun n => b n x) atTop (𝓝 1) := by
    apply tendsto_nhds_of_eventually_eq
    obtain ⟨N, hN⟩ : ∃ N : ℕ, ‖x‖ ≤ (N : ℝ) := exists_nat_ge ‖x‖
    filter_upwards [eventually_ge_atTop N] with n hn
    apply (b n).one_of_mem_closedBall
    rw [Metric.mem_closedBall, dist_zero_right]
    change ‖x‖ ≤ (n : ℝ) + 1
    have hnreal : (N : ℝ) ≤ n := by exact_mod_cast hn
    linarith
  have hc0 (n : ℕ) (x : EuclideanSpace ℝ (Fin d)) : 0 ≤ c n x := by
    exact mul_nonneg ((b n).nonneg' x) (hL0 n x)
  have hcle (n : ℕ) (x : EuclideanSpace ℝ (Fin d)) : c n x ≤ G x := by
    change b n x * L n x ≤ G x
    calc
      b n x * L n x ≤ 1 * L n x :=
        mul_le_mul_of_nonneg_right (ContDiffBump.le_one (b n)) (hL0 n x)
      _ = L n x := one_mul _
      _ ≤ G x := hLle n x
  have hccont (n : ℕ) : Continuous (c n) :=
    ((b n).contDiff (n := (⊤ : ℕ∞))).continuous.mul (hLcont n)
  have hcsupp (n : ℕ) : HasCompactSupport (c n) :=
    (b n).hasCompactSupport.mul_right
  have hctend (x : EuclideanSpace ℝ (Fin d)) :
      Tendsto (fun n => c n x) atTop (𝓝 (G x)) := by
    have hmul := (hb_tend x).mul (hLtend x)
    simpa [c] using hmul
  choose w hwsupp hwsmooth hw0 hwle hwerr using fun n =>
    exists_smooth_minorant_of_continuous_compact (c n) (hccont n) (hcsupp n) (hc0 n)
      (by positivity : 0 < 1 / ((n : ℝ) + 1))
  let ψ : ℕ → SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ := fun n =>
    ((hwsupp n).comp_left (g := Complex.ofRealCLM) rfl).toSchwartzMap
      (Complex.ofRealCLM.contDiff.comp (hwsmooth n))
  refine ⟨ψ, ?_, ?_, ?_, ?_⟩
  · intro n x
    simp [ψ]
  · intro n x
    simpa [ψ] using hw0 n x
  · intro n x
    have hψle : (ψ n x).re ≤ c n x := by
      simpa [ψ] using hwle n x
    exact hψle.trans (hcle n x)
  · intro x
    have hε : Tendsto (fun n : ℕ => 3 * (1 / ((n : ℝ) + 1))) atTop (𝓝 0) := by
      simpa using
        (show Tendsto (fun n : ℕ => (3 : ℝ) * (1 / ((n : ℝ) + 1))) atTop
          (𝓝 (3 * 0)) from
          (tendsto_const_nhds.mul tendsto_one_div_add_atTop_nhds_zero_nat))
    have hupper : ∀ n, (ψ n x).re ≤ c n x := fun n => by
      simpa [ψ] using hwle n x
    have hlower : ∀ n, c n x - 3 * (1 / ((n : ℝ) + 1)) ≤ (ψ n x).re := fun n => by
      apply sub_le_iff_le_add.mpr
      simpa [ψ] using hwerr n x
    have hlowt : Tendsto (fun n : ℕ => c n x - 3 * (1 / ((n : ℝ) + 1))) atTop
        (𝓝 (G x)) := by
      simpa using (hctend x).sub hε
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le' hlowt (hctend x)
      (Eventually.of_forall hlower) (Eventually.of_forall hupper)

private theorem restrictedSphericalMaximal_ofReal_le_liminf_schwartz
    {d : ℕ} {E : Set ℝ} {G : (ℝ^d) → ℝ} {B : ℝ}
    (_hG0 : ∀ x, 0 ≤ G x) (hGB : ∀ x, G x ≤ B)
    (ψ : ℕ → SchwartzMap (ℝ^d) ℂ)
    (hreal : ∀ n x, ψ n x = ((ψ n x).re : ℂ))
    (hψ0 : ∀ n x, 0 ≤ (ψ n x).re)
    (hψG : ∀ n x, (ψ n x).re ≤ G x)
    (hψtend : ∀ x, Tendsto (fun n => (ψ n x).re) atTop (𝓝 (G x)))
    (x : ℝ^d) :
    M E (fun y => (G y : ℂ)) x ≤
      atTop.liminf (fun n => M E (ψ n : (ℝ^d) → ℂ) x) := by
  have hcont (n : ℕ) : Continuous (ψ n : (ℝ^d) → ℂ) := (ψ n).continuous
  have hbound (n : ℕ) (y : ℝ^d) : ‖ψ n y‖ ≤ B := by
    calc
      ‖ψ n y‖ = ‖((ψ n y).re : ℂ)‖ := congrArg norm (hreal n y)
      _ = ‖(ψ n y).re‖ := Complex.norm_real _
      _ = (ψ n y).re := by rw [Real.norm_eq_abs, abs_of_nonneg (hψ0 n y)]
      _ ≤ G y := hψG n y
      _ ≤ B := hGB y
  have htend (y : ℝ^d) : Tendsto (fun n => ψ n y) atTop (𝓝 ((G y : ℝ) : ℂ)) := by
    have h := (Complex.continuous_ofReal.tendsto (G y)).comp (hψtend y)
    apply h.congr'
    filter_upwards with n
    exact (hreal n y).symm
  unfold M restrictedSphericalMaximal
  simp_rw [iSup_subtype']
  calc
    (⨆ t : ↥(E ∩ Ioi 0),
        ENNReal.ofReal ‖sphericalAverage t (fun y => (G y : ℂ)) x‖) ≤
        ⨆ t : ↥(E ∩ Ioi 0), atTop.liminf (fun n =>
          ENNReal.ofReal ‖sphericalAverage t (ψ n : (ℝ^d) → ℂ) x‖) := by
      apply iSup_mono
      intro t
      have havg := sphericalAverage_tendsto_of_bound hcont hbound htend t x
      have hnorm : Tendsto (fun n => ‖sphericalAverage t (ψ n : (ℝ^d) → ℂ) x‖)
          atTop (𝓝 ‖sphericalAverage t (fun y => (G y : ℂ)) x‖) :=
        tendsto_norm.comp havg
      have hofreal : Tendsto (fun n =>
          ENNReal.ofReal ‖sphericalAverage t (ψ n : (ℝ^d) → ℂ) x‖) atTop
          (𝓝 (ENNReal.ofReal ‖sphericalAverage t (fun y => (G y : ℂ)) x‖)) :=
        (ENNReal.continuous_ofReal.tendsto _).comp hnorm
      rw [hofreal.liminf_eq]
    _ ≤ atTop.liminf (fun n =>
        ⨆ t : ↥(E ∩ Ioi 0),
          ENNReal.ofReal ‖sphericalAverage t (ψ n : (ℝ^d) → ℂ) x‖) :=
      Filter.iSup_liminf_le_liminf_iSup

private theorem exists_measurable_envelope_of_bounded_lsc
    {d : ℕ} {E : Set ℝ} {μ : Measure (ℝ^d)} {p : ℝ≥0∞} (hp0 : p ≠ 0) (hptop : p ≠ ∞)
    {C : ℝ≥0∞}
    (hstrong : ∀ φ : SchwartzMap (ℝ^d) ℂ,
      eLpNorm (M E (φ : (ℝ^d) → ℂ)) p μ ≤
        C * eLpNorm (φ : (ℝ^d) → ℂ) p μ)
    {G : (ℝ^d) → ℝ} {B : ℝ}
    (hG0 : ∀ x, 0 ≤ G x) (hGB : ∀ x, G x ≤ B)
    (ψ : ℕ → SchwartzMap (ℝ^d) ℂ)
    (hreal : ∀ n x, ψ n x = ((ψ n x).re : ℂ))
    (hψ0 : ∀ n x, 0 ≤ (ψ n x).re)
    (hψG : ∀ n x, (ψ n x).re ≤ G x)
    (hψtend : ∀ x, Tendsto (fun n => (ψ n x).re) atTop (𝓝 (G x))) :
    ∃ J : (ℝ^d) → ℝ≥0∞, Measurable J ∧
      (∀ x, M E (fun y => (G y : ℂ)) x ≤ J x) ∧
      eLpNorm J p μ ≤ C * eLpNorm (fun y => (G y : ℂ)) p μ := by
  let J : (ℝ^d) → ℝ≥0∞ := fun x =>
    atTop.liminf (fun n => M E (ψ n : (ℝ^d) → ℂ) x)
  have hMmeas (n : ℕ) : Measurable (M E (ψ n : (ℝ^d) → ℂ)) := by
    change Measurable (restrictedSphericalMaximal E (ψ n : (ℝ^d) → ℂ))
    rw [restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal]
    exact measurable_restrictedNormalizedSphericalMaximal_schwartz E (ψ n)
  have hJmeas : Measurable J := by
    exact Measurable.liminf hMmeas
  have hψnorm (n : ℕ) :
      eLpNorm (ψ n : (ℝ^d) → ℂ) p μ ≤
        eLpNorm (fun y => (G y : ℂ)) p μ := by
    apply eLpNorm_mono
    intro y
    calc
      ‖ψ n y‖ = ‖((ψ n y).re : ℂ)‖ := congrArg norm (hreal n y)
      _ = ‖(ψ n y).re‖ := Complex.norm_real _
      _ = (ψ n y).re := by rw [Real.norm_eq_abs, abs_of_nonneg (hψ0 n y)]
      _ ≤ G y := hψG n y
      _ = ‖(G y : ℂ)‖ := by
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hG0 y)]
  refine ⟨J, hJmeas, ?_, ?_⟩
  · intro x
    exact restrictedSphericalMaximal_ofReal_le_liminf_schwartz hG0 hGB ψ hreal hψ0
      hψG hψtend x
  · apply eLpNorm_liminf_le_of_uniform hp0 hptop hMmeas
    intro n
    calc
      eLpNorm (M E (ψ n : (ℝ^d) → ℂ)) p μ ≤
          C * eLpNorm (ψ n : (ℝ^d) → ℂ) p μ := hstrong (ψ n)
      _ ≤ C * eLpNorm (fun y => (G y : ℂ)) p μ :=
        mul_le_mul_right (hψnorm n) C

private theorem exists_bounded_nonneg_lsc_root_majorant
    {d : ℕ} {μ : Measure (ℝ^d)} [μ.WeaklyRegular] [SigmaFinite μ]
    (u : (ℝ^d) → ℝ≥0) (hu : AEMeasurable u μ)
    {q : ℝ} (hq : 0 < q) {B : ℝ≥0} (hB : ∀ x, u x ≤ B)
    {ε : ℝ≥0∞} (hε : ε ≠ 0) :
    ∃ G : (ℝ^d) → ℝ,
      (∀ x, 0 ≤ G x) ∧
      (∀ x, G x ≤ (B : ℝ) ^ q⁻¹) ∧
      LowerSemicontinuous G ∧
      (∀ x, (u x : ℝ) ^ q⁻¹ ≤ G x) ∧
      (∫⁻ x, ENNReal.ofReal (G x ^ q) ∂μ) ≤
        (∫⁻ x, (u x : ℝ≥0∞) ∂μ) + ε := by
  obtain ⟨g, hug, hglsc, hgint⟩ :=
    exists_lt_lowerSemicontinuous_lintegral_ge_of_aemeasurable μ u hu hε
  let T : ℝ≥0∞ := B
  have hTtop : T ≠ ∞ := by simp [T]
  let H : (ℝ^d) → ℝ := fun x => ENNReal.truncateToReal T (g x)
  have hHnonneg (x : ℝ^d) : 0 ≤ H x := by
    exact ENNReal.truncateToReal_nonneg
  have hHle (x : ℝ^d) : H x ≤ (B : ℝ) := by
    simpa [H, T] using ENNReal.truncateToReal_le hTtop (x := g x)
  let G : (ℝ^d) → ℝ := fun x => (max 0 (H x)) ^ q⁻¹
  have hGnonneg (x : ℝ^d) : 0 ≤ G x := by
    dsimp [G]
    exact Real.rpow_nonneg (le_max_left _ _) _
  have hGlsc : LowerSemicontinuous G := by
    have hHlsc : LowerSemicontinuous H := by
      exact (ENNReal.continuous_truncateToReal hTtop).comp_lowerSemicontinuous hglsc
        (ENNReal.monotone_truncateToReal hTtop)
    have hbasecont : Continuous fun z : ℝ => max 0 z := continuous_const.max continuous_id
    have hbase : Continuous fun z : ℝ => (max 0 z) ^ q⁻¹ :=
      hbasecont.rpow_const (fun z => Or.inr (inv_nonneg.mpr hq.le))
    exact hbase.comp_lowerSemicontinuous hHlsc (by
      intro a b hab
      exact Real.rpow_le_rpow (le_max_left _ _) (max_le_max_left _ hab)
        (inv_nonneg.mpr hq.le))
  have hGle (x : ℝ^d) : G x ≤ (B : ℝ) ^ q⁻¹ := by
    dsimp [G]
    rw [max_eq_right (hHnonneg x)]
    exact Real.rpow_le_rpow (hHnonneg x) (hHle x) (inv_nonneg.mpr hq.le)
  have huG (x : ℝ^d) : (u x : ℝ) ^ q⁻¹ ≤ G x := by
    have hmin : (u x : ℝ≥0∞) ≤ min T (g x) := by
      refine le_min ?_ (le_of_lt (hug x))
      simpa [T] using (hB x)
    have hmin_top : min T (g x) ≠ ∞ := by
      refine ne_top_of_le_ne_top hTtop ?_
      exact min_le_left _ _
    have huH : (u x : ℝ) ≤ H x := by
      change ((u x : ℝ≥0∞).toReal) ≤ (min T (g x)).toReal
      exact (ENNReal.toReal_le_toReal (by simp) hmin_top).2 hmin
    dsimp [G]
    rw [max_eq_right (hHnonneg x)]
    exact Real.rpow_le_rpow (NNReal.coe_nonneg _) huH (inv_nonneg.mpr hq.le)
  have hGpow (x : ℝ^d) : ENNReal.ofReal (G x ^ q) = min T (g x) := by
    have hmin_top : min T (g x) ≠ ∞ := by
      refine ne_top_of_le_ne_top hTtop ?_
      exact min_le_left _ _
    change ENNReal.ofReal (((max 0 (H x)) ^ q⁻¹) ^ q) = min T (g x)
    rw [max_eq_right (hHnonneg x), Real.rpow_inv_rpow (hHnonneg x) hq.ne']
    change ENNReal.ofReal ((min T (g x)).toReal) = min T (g x)
    exact ENNReal.ofReal_toReal hmin_top
  refine ⟨G, hGnonneg, hGle, hGlsc, huG, ?_⟩
  calc
    ∫⁻ x, ENNReal.ofReal (G x ^ q) ∂μ = ∫⁻ x, min T (g x) ∂μ := by
      apply lintegral_congr
      intro x
      exact hGpow x
    _ ≤ ∫⁻ x, g x ∂μ := by
      apply lintegral_mono
      intro x
      exact min_le_right _ _
    _ ≤ ∫⁻ x, (u x : ℝ≥0∞) ∂μ + ε := hgint

private theorem exists_bounded_nonneg_lsc_majorant_of_memLp
    {d : ℕ} {μ : Measure (ℝ^d)} [μ.WeaklyRegular] [SigmaFinite μ]
    (f : (ℝ^d) → ℂ) {p : ℝ≥0∞} (hp0 : p ≠ 0) (hptop : p ≠ ∞)
    (hf : MemLp f p μ) (n : ℕ) {ε : ℝ≥0∞} (hε : ε ≠ 0) :
    ∃ G : (ℝ^d) → ℝ,
      (∀ x, 0 ≤ G x) ∧
      (∀ x, G x ≤ n) ∧
      LowerSemicontinuous G ∧
      (∀ x, min ‖f x‖ n ≤ G x) ∧
      (∫⁻ x, ENNReal.ofReal (G x ^ p.toReal) ∂μ) ≤
        (∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) + ε := by
  have hq : 0 < p.toReal := ENNReal.toReal_pos hp0 hptop
  let N : ℝ≥0 := n
  let u : (ℝ^d) → ℝ≥0 := fun x => (min ‖f x‖₊ N) ^ p.toReal
  have hu : AEMeasurable u μ := by
    dsimp [u]
    exact (NNReal.continuous_rpow_const hq.le).measurable.comp_aemeasurable
      (hf.aemeasurable.nnnorm.min measurable_const.aemeasurable)
  have huN (x : ℝ^d) : u x ≤ N ^ p.toReal := by
    dsimp [u]
    exact NNReal.rpow_le_rpow (min_le_right _ _) hq.le
  obtain ⟨G, hG0, hGN, hGlsc, huG, hGint⟩ :=
    exists_bounded_nonneg_lsc_root_majorant u hu hq huN hε
  refine ⟨G, hG0, ?_, hGlsc, ?_, ?_⟩
  · intro x
    have hN0 : 0 ≤ (N : ℝ) := NNReal.coe_nonneg _
    have hpow : ((N : ℝ) ^ p.toReal) ^ (p.toReal)⁻¹ = N := by
      rw [Real.rpow_rpow_inv hN0 hq.ne']
    calc
      G x ≤ ((N ^ p.toReal : ℝ≥0) : ℝ) ^ (p.toReal)⁻¹ := hGN x
      _ = ((N : ℝ) ^ p.toReal) ^ (p.toReal)⁻¹ := by rw [NNReal.coe_rpow]
      _ = N := hpow
      _ = n := by simp [N]
  · intro x
    let a : ℝ := ((min ‖f x‖₊ N : ℝ≥0) : ℝ)
    have hbase0 : 0 ≤ a := by
      dsimp [a]
      exact NNReal.coe_nonneg _
    have hroot : (a ^ p.toReal) ^ (p.toReal)⁻¹ = a := by
      rw [Real.rpow_rpow_inv hbase0 hq.ne']
    have hreal : min ‖f x‖ (n : ℝ) = a := by simp [a, N]
    have hu_eq : ((u x : ℝ≥0) : ℝ) = a ^ p.toReal := by
      dsimp [u, a]
    calc
      min ‖f x‖ (n : ℝ) = a := hreal
      _ = ((u x : ℝ≥0) : ℝ) ^ (p.toReal)⁻¹ := by
        rw [hu_eq]
        exact hroot.symm
      _ ≤ G x := huG x
  · calc
      ∫⁻ x, ENNReal.ofReal (G x ^ p.toReal) ∂μ ≤
          (∫⁻ x, (u x : ℝ≥0∞) ∂μ) + ε := hGint
      _ ≤ (∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) + ε := by
        gcongr
        calc
          (u x : ℝ≥0∞) = (↑(min ‖f x‖₊ N) : ℝ≥0∞) ^ p.toReal := by
            rw [ENNReal.coe_rpow_of_nonneg _ hq.le]
          _ ≤ (↑‖f x‖₊ : ℝ≥0∞) ^ p.toReal := by
            apply ENNReal.rpow_le_rpow
            · exact_mod_cast min_le_left _ _
            · exact hq.le
          _ = ‖f x‖ₑ ^ p.toReal := by rw [enorm_eq_nnnorm]

private theorem exists_measurable_raw_envelope_at_eps
    {d : ℕ} {E : Set ℝ} {μ : Measure (ℝ^d)} [μ.WeaklyRegular] [SigmaFinite μ]
    {p : ℝ≥0∞} (hp0 : p ≠ 0) (hptop : p ≠ ∞)
    {C : ℝ≥0∞}
    (hstrong : ∀ φ : SchwartzMap (ℝ^d) ℂ,
      eLpNorm (M E (φ : (ℝ^d) → ℂ)) p μ ≤
        C * eLpNorm (φ : (ℝ^d) → ℂ) p μ)
    {f : (ℝ^d) → ℂ} (hf : MemLp f p μ)
    {ε : ℝ≥0∞} (hε : ε ≠ 0) :
    ∃ J : (ℝ^d) → ℝ≥0∞, Measurable J ∧ (∀ x, M E f x ≤ J x) ∧
      eLpNorm J p μ ≤ C *
        ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) + ε) ^ (p.toReal)⁻¹ := by
  choose G hG0 hGbound hGlsc hGmajor hGint using fun n : ℕ =>
    exists_bounded_nonneg_lsc_majorant_of_memLp f hp0 hptop hf n hε
  choose ψ hψreal hψ0 hψG hψtend using fun n : ℕ =>
    exists_schwartz_minorants_of_bounded_lsc (G n) (hG0 n) (hGbound n) (hGlsc n)
  choose J hJmeas hJG hJbound using fun n : ℕ =>
    exists_measurable_envelope_of_bounded_lsc hp0 hptop hstrong
      (hG0 n) (hGbound n) (ψ n) (hψreal n) (hψ0 n) (hψG n) (hψtend n)
  let H : (ℝ^d) → ℝ≥0∞ := fun x => atTop.liminf (fun n => J n x)
  have hHmeas : Measurable H := by
    exact Measurable.liminf hJmeas
  have hHdom (x : ℝ^d) : M E f x ≤ H x := by
    calc
      M E f x ≤ atTop.liminf (fun n => M E (fun y => (G n y : ℂ)) x) :=
        restrictedSphericalMaximal_le_liminf_of_trunc_majorants f G
          (fun n => (hGlsc n).measurable) hGbound hG0 hGmajor x
      _ ≤ atTop.liminf (fun n => J n x) := by
        refine Filter.liminf_le_liminf ?_ (by isBoundedDefault) (by isBoundedDefault)
        filter_upwards with n
        exact hJG n x
      _ = H x := rfl
  refine ⟨H, hHmeas, hHdom, ?_⟩
  apply eLpNorm_liminf_le_of_uniform hp0 hptop hJmeas
  intro n
  calc
    eLpNorm (J n) p μ ≤ C * eLpNorm (fun y => (G n y : ℂ)) p μ :=
      hJbound n
    _ ≤ C * ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) + ε) ^ (p.toReal)⁻¹ := by
      exact mul_le_mul_of_nonneg_left
        (eLpNorm_real_le_of_lintegral_rpow_le hp0 hptop (hG0 n) (hGint n)) bot_le

theorem exists_measurable_raw_envelope_of_memLp
    {d : ℕ} {E : Set ℝ} {μ : Measure (ℝ^d)} [μ.WeaklyRegular] [SigmaFinite μ]
    {p : ℝ≥0∞} (hp0 : p ≠ 0) (hptop : p ≠ ∞)
    {C : ℝ≥0∞} (hCtop : C ≠ ∞)
    (hstrong : ∀ φ : SchwartzMap (ℝ^d) ℂ,
      eLpNorm (M E (φ : (ℝ^d) → ℂ)) p μ ≤
        C * eLpNorm (φ : (ℝ^d) → ℂ) p μ)
    {f : (ℝ^d) → ℂ} (hf : MemLp f p μ) :
    ∃ J : (ℝ^d) → ℝ≥0∞, Measurable J ∧ (∀ x, M E f x ≤ J x) ∧
      eLpNorm J p μ ≤ C * eLpNorm f p μ := by
  choose J hJmeas hJdom hJbound using fun n : ℕ =>
    exists_measurable_raw_envelope_at_eps hp0 hptop hstrong hf
      (by simp : (((n + 1 : ℕ) : ℝ≥0∞)⁻¹) ≠ 0)
  let H : (ℝ^d) → ℝ≥0∞ := fun x => atTop.liminf (fun n => J n x)
  have hHmeas : Measurable H := by
    exact Measurable.liminf hJmeas
  have hHdom (x : ℝ^d) : M E f x ≤ H x := by
    change M E f x ≤ atTop.liminf (fun n => J n x)
    rw [Filter.le_liminf_iff]
    intro y hy
    filter_upwards with n
    exact hy.trans_le (hJdom n x)
  have hshiftNat : Tendsto (fun n : ℕ => n + 1) atTop atTop :=
    (Filter.tendsto_add_atTop_iff_nat 1).2 tendsto_id
  have hinv : Tendsto (fun n : ℕ => ((n + 1 : ℕ) : ℝ≥0∞)⁻¹) atTop (𝓝 0) :=
    ENNReal.tendsto_inv_nat_nhds_zero.comp hshiftNat
  have hsum : Tendsto (fun n : ℕ =>
      (∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) + ((n + 1 : ℕ)⁻¹ : ℝ≥0∞)) atTop
      (𝓝 ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) + 0)) :=
    tendsto_const_nhds.add hinv
  have hpow : Tendsto (fun n : ℕ =>
      ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) + ((n + 1 : ℕ)⁻¹ : ℝ≥0∞)) ^
        (p.toReal)⁻¹) atTop
      (𝓝 ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) ^ (p.toReal)⁻¹)) := by
    change Tendsto ((fun z : ℝ≥0∞ => z ^ (p.toReal)⁻¹) ∘
      fun n : ℕ => (∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) +
        ((n + 1 : ℕ)⁻¹ : ℝ≥0∞)) atTop
      (𝓝 ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) ^ (p.toReal)⁻¹))
    simpa only [add_zero] using
      (ENNReal.continuous_rpow_const.tendsto
        ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) + 0)).comp hsum
  have hKlim : Tendsto (fun n : ℕ => C *
      ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) + ((n + 1 : ℕ)⁻¹ : ℝ≥0∞)) ^
        (p.toReal)⁻¹) atTop
      (𝓝 (C * (∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) ^ (p.toReal)⁻¹)) :=
    ((ENNReal.continuous_const_mul hCtop).tendsto
      ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) ^ (p.toReal)⁻¹)).comp hpow
  refine ⟨H, hHmeas, hHdom, ?_⟩
  calc
    eLpNorm H p μ ≤ atTop.liminf (fun n => eLpNorm (J n) p μ) :=
      eLpNorm_liminf_le_liminf hp0 hptop hJmeas
    _ ≤ atTop.liminf (fun n => C *
        ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) + ((n + 1 : ℕ)⁻¹ : ℝ≥0∞)) ^
          (p.toReal)⁻¹) := by
      refine Filter.liminf_le_liminf ?_ (by isBoundedDefault) (by isBoundedDefault)
      filter_upwards with n
      exact hJbound n
    _ = C * (∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) ^ (p.toReal)⁻¹ :=
      hKlim.liminf_eq
    _ = C * eLpNorm f p μ := by
      rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop]
      rw [show 1 / p.toReal = (p.toReal)⁻¹ by ring]


end

