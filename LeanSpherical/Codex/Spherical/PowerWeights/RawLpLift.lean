        apply liminf_le_of_le (by isBoundedDefault)
        intro b hb
        obtain ⟨n, hn⟩ := hb.exists
        have hn' := hbound n
        rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop] at hn'
        have hpow := ENNReal.rpow_le_rpow hn' hq.le
        rw [show 1 / p.toReal = (p.toReal)⁻¹ by ring] at hpow
        rw [ENNReal.rpow_inv_rpow hq.ne'] at hpow
        simpa only [enorm_eq_self] using hn.trans hpow
  calc
    (∫⁻ x, ‖atTop.liminf (fun n => F n x)‖ₑ ^ p.toReal ∂μ) ^
        (1 / p.toReal) ≤ (K ^ p.toReal) ^ (1 / p.toReal) :=
      ENNReal.rpow_le_rpow hIntegral (by positivity)
    _ = K := by
      rw [show 1 / p.toReal = (p.toReal)⁻¹ by ring]
      exact ENNReal.rpow_rpow_inv hq.ne' K

private theorem eLpNorm_liminf_le_liminf
    {α : Type*} [MeasurableSpace α] {μ : Measure α} {p : ℝ≥0∞}
    (hp0 : p ≠ 0) (hptop : p ≠ ∞)
    {F : ℕ → α → ℝ≥0∞}
    (hmeas : ∀ n, Measurable (F n)) :
    eLpNorm (fun x => atTop.liminf (fun n => F n x)) p μ ≤
      atTop.liminf (fun n => eLpNorm (F n) p μ) := by
  have hq : 0 < p.toReal := ENNReal.toReal_pos hp0 hptop
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop]
  have hpow_liminf (x : α) :
      (atTop.liminf (fun n => F n x)) ^ p.toReal =
        atTop.liminf (fun n => (F n x) ^ p.toReal) := by
    let e : ℝ≥0∞ ≃o ℝ≥0∞ := ENNReal.orderIsoRpow p.toReal hq
    change e (atTop.liminf (fun n => F n x)) =
      atTop.liminf (fun n => e (F n x))
    exact OrderIso.liminf_apply e (by isBoundedDefault) (by isBoundedDefault)
      (by isBoundedDefault) (by isBoundedDefault)
  have hIntegral : ∫⁻ x, ‖atTop.liminf (fun n => F n x)‖ₑ ^ p.toReal ∂μ ≤
      atTop.liminf (fun n => ∫⁻ x, (F n x) ^ p.toReal ∂μ) := by
    calc
      ∫⁻ x, ‖atTop.liminf (fun n => F n x)‖ₑ ^ p.toReal ∂μ =
          ∫⁻ x, atTop.liminf (fun n => (F n x) ^ p.toReal) ∂μ := by
        simp_rw [enorm_eq_self, hpow_liminf]
      _ ≤ atTop.liminf (fun n => ∫⁻ x, (F n x) ^ p.toReal ∂μ) := by
        apply lintegral_liminf_le'
        intro n
        exact (ENNReal.continuous_rpow_const.measurable.comp (hmeas n)).aemeasurable
  calc
    (∫⁻ x, ‖atTop.liminf (fun n => F n x)‖ₑ ^ p.toReal ∂μ) ^
        (1 / p.toReal) ≤
        (atTop.liminf (fun n => ∫⁻ x, (F n x) ^ p.toReal ∂μ)) ^
          (1 / p.toReal) := ENNReal.rpow_le_rpow hIntegral (by positivity)
    _ = atTop.liminf (fun n =>
        (∫⁻ x, (F n x) ^ p.toReal ∂μ) ^ (1 / p.toReal)) := by
      let e : ℝ≥0∞ ≃o ℝ≥0∞ :=
        ENNReal.orderIsoRpow (1 / p.toReal) (by positivity)
      change e (atTop.liminf (fun n => ∫⁻ x, (F n x) ^ p.toReal ∂μ)) =
        atTop.liminf (fun n => e (∫⁻ x, (F n x) ^ p.toReal ∂μ))
      exact OrderIso.liminf_apply e (by isBoundedDefault) (by isBoundedDefault)
        (by isBoundedDefault) (by isBoundedDefault)
    _ = atTop.liminf (fun n => eLpNorm (F n) p μ) := by
      congr 1
      funext n
      rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop]
      simp only [enorm_eq_self]

private theorem eLpNorm_le_of_ae_le_liminf_of_uniform {α : Type*} [MeasurableSpace α]
    {μ : Measure α} {p : ℝ≥0∞} (hp0 : p ≠ 0) (hptop : p ≠ ∞)
    {F : α → ℝ≥0∞} {G : ℕ → α → ℝ≥0∞} {K : ℝ≥0∞}
    (hle : ∀ᵐ x ∂μ, F x ≤ atTop.liminf (fun n => G n x))
    (hmeas : ∀ n, Measurable (G n))
    (hbound : ∀ n, eLpNorm (G n) p μ ≤ K) :
    eLpNorm F p μ ≤ K := by
  calc
    eLpNorm F p μ ≤ eLpNorm (fun x => atTop.liminf (fun n => G n x)) p μ :=
      eLpNorm_mono_enorm_ae (hle.mono fun x hx => by
        simpa only [enorm_eq_self] using hx)
    _ ≤ K := eLpNorm_liminf_le_of_uniform hp0 hptop hmeas hbound

private def smoothPos (ε z : ℝ) : ℝ :=
  z * Real.smoothTransition (z / ε)

private theorem smoothPos_nonneg {ε z : ℝ} (hε : 0 < ε) :
    0 ≤ smoothPos ε z := by
  by_cases hz : z ≤ 0
  · rw [show smoothPos ε z = 0 by
      simp [smoothPos, Real.smoothTransition.zero_of_nonpos
        (div_nonpos_of_nonpos_of_nonneg hz hε.le)]]
  · exact mul_nonneg (le_of_lt (lt_of_not_ge hz))
      (Real.smoothTransition.nonneg _)

private theorem smoothPos_le_max {ε z : ℝ} (hε : 0 < ε) :
    smoothPos ε z ≤ max 0 z := by
  by_cases hz : z ≤ 0
  · rw [show smoothPos ε z = 0 by
      simp [smoothPos, Real.smoothTransition.zero_of_nonpos
        (div_nonpos_of_nonpos_of_nonneg hz hε.le)], max_eq_left hz]
  · rw [max_eq_right (le_of_lt (lt_of_not_ge hz))]
    exact mul_le_of_le_one_right (lt_of_not_ge hz).le
      (Real.smoothTransition.le_one _)

private theorem max_le_smoothPos_add {ε z : ℝ} (hε : 0 < ε) :
    max 0 z ≤ smoothPos ε z + ε := by
  by_cases hz : z ≤ 0
  · rw [max_eq_left hz]
    linarith [smoothPos_nonneg hε (z := z)]
  · rw [max_eq_right (le_of_lt (lt_of_not_ge hz))]
    by_cases hze : ε ≤ z
    · have hdiv : 1 ≤ z / ε := (le_div_iff₀ hε).2 (by simpa using hze)
      rw [smoothPos, Real.smoothTransition.one_of_one_le hdiv]
      linarith
    · have hlt : z < ε := lt_of_not_ge hze
      linarith [smoothPos_nonneg hε (z := z)]

private theorem contDiff_smoothPos {ε : ℝ} (_ : ε ≠ 0) :
    ContDiff ℝ (⊤ : ℕ∞) (smoothPos ε) := by
  exact contDiff_id.mul
    (Real.smoothTransition.contDiff.comp (contDiff_id.div_const ε))

private theorem exists_smooth_minorant_of_continuous_compact
    {d : ℕ} (c : EuclideanSpace ℝ (Fin d) → ℝ) (hc : Continuous c)
    (hcsupp : HasCompactSupport c) (hc0 : ∀ x, 0 ≤ c x)
    {ε : ℝ} (hε : 0 < ε) :
    ∃ w : EuclideanSpace ℝ (Fin d) → ℝ,
      HasCompactSupport w ∧ ContDiff ℝ (⊤ : ℕ∞) w ∧
        (∀ x, 0 ≤ w x) ∧ (∀ x, w x ≤ c x) ∧
          ∀ x, c x ≤ w x + 3 * ε := by
  have huc : UniformContinuous c :=
    hc.uniformContinuous_of_tendsto_cocompact hcsupp.is_zero_at_infty
  obtain ⟨v, hv, hvclose⟩ := huc.exists_contDiff_dist_le hε
  let w : EuclideanSpace ℝ (Fin d) → ℝ := fun x => smoothPos ε (v x - ε)
  have hvupper (x : EuclideanSpace ℝ (Fin d)) : v x - ε < c x := by
    have h := hvclose x
    rw [Real.dist_eq] at h
    linarith [le_abs_self (v x - c x)]
  have hvlower (x : EuclideanSpace ℝ (Fin d)) : c x - ε < v x := by
    have h := hvclose x
    rw [Real.dist_eq] at h
    linarith [neg_le_abs (v x - c x)]
  refine ⟨w, ?_, ?_, ?_, ?_, ?_⟩
  · apply hcsupp.mono
    intro x hx
    by_contra hxc
    have hczero : c x = 0 := by
      rw [← Function.notMem_support]
      exact hxc
    have hneg : v x - ε < 0 := by linarith [hvupper x]
    have hwzero : w x = 0 := by
      change (v x - ε) * Real.smoothTransition ((v x - ε) / ε) = 0
      rw [Real.smoothTransition.zero_of_nonpos
        (div_nonpos_of_nonpos_of_nonneg hneg.le hε.le)]
      ring
    exact hx hwzero
  · exact (contDiff_smoothPos hε.ne').comp (hv.sub contDiff_const)
  · intro x
    exact smoothPos_nonneg hε
  · intro x
    calc
      w x ≤ max 0 (v x - ε) := smoothPos_le_max hε
      _ ≤ c x := by
        rw [max_le_iff]
        exact ⟨hc0 x, le_of_lt (hvupper x)⟩
  · intro x
    have hpos : max 0 (v x - ε) ≤ w x + ε := max_le_smoothPos_add hε
    have haux : c x ≤ max 0 (v x - ε) + 2 * ε := by
      by_cases hcx : c x ≤ 2 * ε
      · have : 0 ≤ max 0 (v x - ε) := le_max_left _ _
        linarith
      · rw [max_eq_right]
        · linarith [hvlower x]
        · linarith [hvlower x, hcx]
    linarith

private def lowerEnvelope {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (G : X → ℝ) (n : ℕ) (x : X) : ℝ :=
  ⨅ y : X, G y + (n : ℝ) * dist x y

private theorem lowerEnvelope_bddBelow {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (G : X → ℝ) (hG0 : ∀ x, 0 ≤ G x)
    (n : ℕ) (x : X) :
    BddBelow (range fun y : X => G y + (n : ℝ) * dist x y) := by
  refine ⟨0, ?_⟩
  rintro z ⟨y, rfl⟩
  exact add_nonneg (hG0 y) (mul_nonneg (Nat.cast_nonneg _) dist_nonneg)

private theorem lowerEnvelope_nonneg {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (G : X → ℝ) (hG0 : ∀ x, 0 ≤ G x)
    (n : ℕ) (x : X) : 0 ≤ lowerEnvelope G n x := by
  unfold lowerEnvelope
  apply le_ciInf
  intro y
  exact add_nonneg (hG0 y) (mul_nonneg (Nat.cast_nonneg _) dist_nonneg)

private theorem lowerEnvelope_le {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (G : X → ℝ) (hG0 : ∀ x, 0 ≤ G x)
    (n : ℕ) (x : X) : lowerEnvelope G n x ≤ G x := by
  unfold lowerEnvelope
  simpa using ciInf_le (lowerEnvelope_bddBelow G hG0 n x) x

private theorem lowerEnvelope_lipschitz {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (G : X → ℝ) (hG0 : ∀ x, 0 ≤ G x)
    (n : ℕ) : LipschitzWith (n : NNReal) (lowerEnvelope G n) := by
  apply LipschitzWith.of_le_add_mul
  intro x y
  unfold lowerEnvelope
  have hmono :
      (⨅ z : X, G z + (n : ℝ) * dist x z) ≤
        (⨅ z : X, G z + (n : ℝ) * dist y z + (n : ℝ) * dist x y) := by
    apply ciInf_mono (lowerEnvelope_bddBelow G hG0 n x)
    intro z
    calc
      G z + (n : ℝ) * dist x z ≤
          G z + (n : ℝ) * (dist y z + dist x y) := by
            gcongr
            calc
              dist x z ≤ dist x y + dist y z := dist_triangle _ _ _
              _ = dist y z + dist x y := by ring
      _ = G z + (n : ℝ) * dist y z + (n : ℝ) * dist x y := by ring
  have hadd :
      (⨅ z : X, G z + (n : ℝ) * dist y z + (n : ℝ) * dist x y) =
        (⨅ z : X, G z + (n : ℝ) * dist y z) + (n : ℝ) * dist x y := by
    refine (Monotone.map_ciInf_of_continuousAt
      (f := fun u : ℝ => u + (n : ℝ) * dist x y)
      (g := fun z : X => G z + (n : ℝ) * dist y z) ?_ ?_ ?_).symm
    · exact continuousAt_id.add continuousAt_const
    · intro a b hab
      simpa [add_comm] using add_le_add_right hab ((n : ℝ) * dist x y)
    · exact lowerEnvelope_bddBelow G hG0 n y
  simpa using hmono.trans_eq hadd

private theorem lowerEnvelope_continuous {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (G : X → ℝ) (hG0 : ∀ x, 0 ≤ G x)
    (n : ℕ) : Continuous (lowerEnvelope G n) :=
  (lowerEnvelope_lipschitz G hG0 n).continuous

private theorem eventually_lt_lowerEnvelope_of_lt {X : Type*} [NormedAddCommGroup X]
    [NormedSpace ℝ X]
    (G : X → ℝ) (hG0 : ∀ x, 0 ≤ G x) {B : ℝ} (hGB : ∀ x, G x ≤ B)
    (hG : LowerSemicontinuous G) (x : X) {a : ℝ} (ha : a < G x) :
    ∀ᶠ n : ℕ in atTop, a < lowerEnvelope G n x := by
  obtain ⟨b, hab, hb⟩ := exists_between ha
  obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.mp (hG.isOpen_preimage b) x hb
  obtain ⟨N, hN⟩ : ∃ N : ℕ, B / δ < N := exists_nat_gt (B / δ)
  filter_upwards [eventually_ge_atTop N] with n hn
  have hncast : (N : ℝ) ≤ n := by exact_mod_cast hn
  have hnreal : B / δ < (n : ℝ) := hN.trans_le hncast
  have hndelta : B < (n : ℝ) * δ := (div_lt_iff₀ hδ).mp hnreal
  unfold lowerEnvelope
  refine lt_of_lt_of_le hab (le_ciInf fun y => ?_)
  by_cases hy : y ∈ Metric.ball x δ
  · exact (hball hy).le.trans (le_add_of_nonneg_right
      (mul_nonneg (Nat.cast_nonneg _) dist_nonneg))
  · have hdist : δ ≤ dist x y := by
      apply le_of_not_gt
      intro hlt
      apply hy
      rw [Metric.mem_ball]
      simpa [dist_comm] using hlt
    have hbB : b ≤ B := hb.le.trans (hGB x)
    exact (calc
      b ≤ B := hbB
      _ < (n : ℝ) * δ := hndelta
      _ ≤ G y + (n : ℝ) * dist x y := by
        simpa using add_le_add (hG0 y)
          (mul_le_mul_of_nonneg_left hdist (Nat.cast_nonneg n))).le

private theorem exists_schwartz_minorants_of_bounded_lsc
    {d : ℕ} (G : EuclideanSpace ℝ (Fin d) → ℝ) (hG0 : ∀ x, 0 ≤ G x)
    {B : ℝ} (hGB : ∀ x, G x ≤ B) (hG : LowerSemicontinuous G) :
    ∃ ψ : ℕ → SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ,
      (∀ n x, ψ n x = ((ψ n x).re : ℂ)) ∧
      (∀ n x, 0 ≤ (ψ n x).re) ∧
      (∀ n x, (ψ n x).re ≤ G x) ∧
      ∀ x, Tendsto (fun n => (ψ n x).re) atTop (𝓝 (G x)) := by
  let L : ℕ → EuclideanSpace ℝ (Fin d) → ℝ := lowerEnvelope G
  let b : ℕ → ContDiffBump (0 : EuclideanSpace ℝ (Fin d)) := fun n =>
    ⟨(n : ℝ) + 1, (n : ℝ) + 2, by positivity, by linarith⟩
  let c : ℕ → EuclideanSpace ℝ (Fin d) → ℝ := fun n x => b n x * L n x
  have hL0 (n : ℕ) (x : EuclideanSpace ℝ (Fin d)) : 0 ≤ L n x :=
    lowerEnvelope_nonneg G hG0 n x
  have hLle (n : ℕ) (x : EuclideanSpace ℝ (Fin d)) : L n x ≤ G x :=
    lowerEnvelope_le G hG0 n x
  have hLcont (n : ℕ) : Continuous (L n) :=
    lowerEnvelope_continuous G hG0 n
  have hLtend (x : EuclideanSpace ℝ (Fin d)) :
      Tendsto (fun n => L n x) atTop (𝓝 (G x)) := by
    apply tendsto_order.2
    constructor
    · intro a ha
      exact eventually_lt_lowerEnvelope_of_lt G hG0 hGB hG x ha
    · intro a ha
      filter_upwards with n
      exact (hLle n x).trans_lt ha
  have hb_tend (x : EuclideanSpace ℝ (Fin d)) :
      Tendsto (fun n => b n x) atTop (𝓝 1) := by
    apply tendsto_nhds_of_eventually_eq
    obtain ⟨N, hN⟩ : ∃ N : ℕ, ‖x‖ ≤ (N : ℝ) := exists_nat_ge ‖x‖
    filter_upwards [eventually_ge_atTop N] with n hn
    apply (b n).one_of_mem_closedBall
    rw [Metric.mem_closedBall, dist_zero_right]
    change ‖x‖ ≤ (n : ℝ) + 1
    have hnreal : (N : ℝ) ≤ n := by exact_mod_cast hn
    linarith
  have hc0 (n : ℕ) (x : EuclideanSpace ℝ (Fin d)) : 0 ≤ c n x := by
    exact mul_nonneg ((b n).nonneg' x) (hL0 n x)
  have hcle (n : ℕ) (x : EuclideanSpace ℝ (Fin d)) : c n x ≤ G x := by
    change b n x * L n x ≤ G x
    calc
      b n x * L n x ≤ 1 * L n x :=
        mul_le_mul_of_nonneg_right (ContDiffBump.le_one (b n)) (hL0 n x)
      _ = L n x := one_mul _
      _ ≤ G x := hLle n x
  have hccont (n : ℕ) : Continuous (c n) :=
    ((b n).contDiff (n := (⊤ : ℕ∞))).continuous.mul (hLcont n)
  have hcsupp (n : ℕ) : HasCompactSupport (c n) :=
    (b n).hasCompactSupport.mul_right
  have hctend (x : EuclideanSpace ℝ (Fin d)) :
      Tendsto (fun n => c n x) atTop (𝓝 (G x)) := by
    have hmul := (hb_tend x).mul (hLtend x)
    simpa [c] using hmul
  choose w hwsupp hwsmooth hw0 hwle hwerr using fun n =>
    exists_smooth_minorant_of_continuous_compact (c n) (hccont n) (hcsupp n) (hc0 n)
      (by positivity : 0 < 1 / ((n : ℝ) + 1))
  let ψ : ℕ → SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ := fun n =>
    ((hwsupp n).comp_left (g := Complex.ofRealCLM) rfl).toSchwartzMap
      (Complex.ofRealCLM.contDiff.comp (hwsmooth n))
  refine ⟨ψ, ?_, ?_, ?_, ?_⟩
  · intro n x
    simp [ψ]
  · intro n x
    simpa [ψ] using hw0 n x
  · intro n x
    have hψle : (ψ n x).re ≤ c n x := by
      simpa [ψ] using hwle n x
    exact hψle.trans (hcle n x)
  · intro x
    have hε : Tendsto (fun n : ℕ => 3 * (1 / ((n : ℝ) + 1))) atTop (𝓝 0) := by
      simpa using
        (show Tendsto (fun n : ℕ => (3 : ℝ) * (1 / ((n : ℝ) + 1))) atTop
          (𝓝 (3 * 0)) from
          (tendsto_const_nhds.mul tendsto_one_div_add_atTop_nhds_zero_nat))
    have hupper : ∀ n, (ψ n x).re ≤ c n x := fun n => by
      simpa [ψ] using hwle n x
    have hlower : ∀ n, c n x - 3 * (1 / ((n : ℝ) + 1)) ≤ (ψ n x).re := fun n => by
      apply sub_le_iff_le_add.mpr
      simpa [ψ] using hwerr n x
    have hlowt : Tendsto (fun n : ℕ => c n x - 3 * (1 / ((n : ℝ) + 1))) atTop
        (𝓝 (G x)) := by
      simpa using (hctend x).sub hε
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le' hlowt (hctend x)
      (Eventually.of_forall hlower) (Eventually.of_forall hupper)

private theorem restrictedSphericalMaximal_ofReal_le_liminf_schwartz
    {d : ℕ} {E : Set ℝ} {G : (ℝ^d) → ℝ} {B : ℝ}
    (_hG0 : ∀ x, 0 ≤ G x) (hGB : ∀ x, G x ≤ B)
    (ψ : ℕ → SchwartzMap (ℝ^d) ℂ)
    (hreal : ∀ n x, ψ n x = ((ψ n x).re : ℂ))
    (hψ0 : ∀ n x, 0 ≤ (ψ n x).re)
    (hψG : ∀ n x, (ψ n x).re ≤ G x)
    (hψtend : ∀ x, Tendsto (fun n => (ψ n x).re) atTop (𝓝 (G x)))
    (x : ℝ^d) :
    M E (fun y => (G y : ℂ)) x ≤
      atTop.liminf (fun n => M E (ψ n : (ℝ^d) → ℂ) x) := by
  have hcont (n : ℕ) : Continuous (ψ n : (ℝ^d) → ℂ) := (ψ n).continuous
  have hbound (n : ℕ) (y : ℝ^d) : ‖ψ n y‖ ≤ B := by
    calc
      ‖ψ n y‖ = ‖((ψ n y).re : ℂ)‖ := congrArg norm (hreal n y)
      _ = ‖(ψ n y).re‖ := Complex.norm_real _
      _ = (ψ n y).re := by rw [Real.norm_eq_abs, abs_of_nonneg (hψ0 n y)]
      _ ≤ G y := hψG n y
      _ ≤ B := hGB y
  have htend (y : ℝ^d) : Tendsto (fun n => ψ n y) atTop (𝓝 ((G y : ℝ) : ℂ)) := by
    have h := (Complex.continuous_ofReal.tendsto (G y)).comp (hψtend y)
    apply h.congr'
    filter_upwards with n
    exact (hreal n y).symm
  unfold M restrictedSphericalMaximal
  simp_rw [iSup_subtype']
  calc
    (⨆ t : ↥(E ∩ Ioi 0),
        ENNReal.ofReal ‖sphericalAverage t (fun y => (G y : ℂ)) x‖) ≤
        ⨆ t : ↥(E ∩ Ioi 0), atTop.liminf (fun n =>
          ENNReal.ofReal ‖sphericalAverage t (ψ n : (ℝ^d) → ℂ) x‖) := by
      apply iSup_mono
      intro t
      have havg := sphericalAverage_tendsto_of_bound hcont hbound htend t x
      have hnorm : Tendsto (fun n => ‖sphericalAverage t (ψ n : (ℝ^d) → ℂ) x‖)
          atTop (𝓝 ‖sphericalAverage t (fun y => (G y : ℂ)) x‖) :=
        tendsto_norm.comp havg
      have hofreal : Tendsto (fun n =>
          ENNReal.ofReal ‖sphericalAverage t (ψ n : (ℝ^d) → ℂ) x‖) atTop
          (𝓝 (ENNReal.ofReal ‖sphericalAverage t (fun y => (G y : ℂ)) x‖)) :=
        (ENNReal.continuous_ofReal.tendsto _).comp hnorm
      rw [hofreal.liminf_eq]
    _ ≤ atTop.liminf (fun n =>
        ⨆ t : ↥(E ∩ Ioi 0),
          ENNReal.ofReal ‖sphericalAverage t (ψ n : (ℝ^d) → ℂ) x‖) :=
      Filter.iSup_liminf_le_liminf_iSup

private theorem exists_measurable_envelope_of_bounded_lsc
    {d : ℕ} {E : Set ℝ} {μ : Measure (ℝ^d)} {p : ℝ≥0∞} (hp0 : p ≠ 0) (hptop : p ≠ ∞)
    {C : ℝ≥0∞}
    (hstrong : ∀ φ : SchwartzMap (ℝ^d) ℂ,
      eLpNorm (M E (φ : (ℝ^d) → ℂ)) p μ ≤
        C * eLpNorm (φ : (ℝ^d) → ℂ) p μ)
    {G : (ℝ^d) → ℝ} {B : ℝ}
    (hG0 : ∀ x, 0 ≤ G x) (hGB : ∀ x, G x ≤ B)
    (ψ : ℕ → SchwartzMap (ℝ^d) ℂ)
    (hreal : ∀ n x, ψ n x = ((ψ n x).re : ℂ))
    (hψ0 : ∀ n x, 0 ≤ (ψ n x).re)
    (hψG : ∀ n x, (ψ n x).re ≤ G x)
    (hψtend : ∀ x, Tendsto (fun n => (ψ n x).re) atTop (𝓝 (G x))) :
    ∃ J : (ℝ^d) → ℝ≥0∞, Measurable J ∧
      (∀ x, M E (fun y => (G y : ℂ)) x ≤ J x) ∧
      eLpNorm J p μ ≤ C * eLpNorm (fun y => (G y : ℂ)) p μ := by
  let J : (ℝ^d) → ℝ≥0∞ := fun x =>
    atTop.liminf (fun n => M E (ψ n : (ℝ^d) → ℂ) x)
  have hMmeas (n : ℕ) : Measurable (M E (ψ n : (ℝ^d) → ℂ)) := by
    change Measurable (restrictedSphericalMaximal E (ψ n : (ℝ^d) → ℂ))
    rw [restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal]
    exact measurable_restrictedNormalizedSphericalMaximal_schwartz E (ψ n)
  have hJmeas : Measurable J := by
    exact Measurable.liminf hMmeas
  have hψnorm (n : ℕ) :
      eLpNorm (ψ n : (ℝ^d) → ℂ) p μ ≤
        eLpNorm (fun y => (G y : ℂ)) p μ := by
    apply eLpNorm_mono
    intro y
    calc
      ‖ψ n y‖ = ‖((ψ n y).re : ℂ)‖ := congrArg norm (hreal n y)
      _ = ‖(ψ n y).re‖ := Complex.norm_real _
      _ = (ψ n y).re := by rw [Real.norm_eq_abs, abs_of_nonneg (hψ0 n y)]
      _ ≤ G y := hψG n y
      _ = ‖(G y : ℂ)‖ := by
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hG0 y)]
  refine ⟨J, hJmeas, ?_, ?_⟩
  · intro x
    exact restrictedSphericalMaximal_ofReal_le_liminf_schwartz hG0 hGB ψ hreal hψ0
      hψG hψtend x
  · apply eLpNorm_liminf_le_of_uniform hp0 hptop hMmeas
    intro n
    calc
      eLpNorm (M E (ψ n : (ℝ^d) → ℂ)) p μ ≤
          C * eLpNorm (ψ n : (ℝ^d) → ℂ) p μ := hstrong (ψ n)
      _ ≤ C * eLpNorm (fun y => (G y : ℂ)) p μ :=
        mul_le_mul_right (hψnorm n) C

private theorem exists_bounded_nonneg_lsc_root_majorant
    {d : ℕ} {μ : Measure (ℝ^d)} [μ.WeaklyRegular] [SigmaFinite μ]
    (u : (ℝ^d) → ℝ≥0) (hu : AEMeasurable u μ)
    {q : ℝ} (hq : 0 < q) {B : ℝ≥0} (hB : ∀ x, u x ≤ B)
    {ε : ℝ≥0∞} (hε : ε ≠ 0) :
    ∃ G : (ℝ^d) → ℝ,
      (∀ x, 0 ≤ G x) ∧
      (∀ x, G x ≤ (B : ℝ) ^ q⁻¹) ∧
      LowerSemicontinuous G ∧
      (∀ x, (u x : ℝ) ^ q⁻¹ ≤ G x) ∧
      (∫⁻ x, ENNReal.ofReal (G x ^ q) ∂μ) ≤
        (∫⁻ x, (u x : ℝ≥0∞) ∂μ) + ε := by
  obtain ⟨g, hug, hglsc, hgint⟩ :=
    exists_lt_lowerSemicontinuous_lintegral_ge_of_aemeasurable μ u hu hε
  let T : ℝ≥0∞ := B
  have hTtop : T ≠ ∞ := by simp [T]
  let H : (ℝ^d) → ℝ := fun x => ENNReal.truncateToReal T (g x)
  have hHnonneg (x : ℝ^d) : 0 ≤ H x := by
    exact ENNReal.truncateToReal_nonneg
  have hHle (x : ℝ^d) : H x ≤ (B : ℝ) := by
    simpa [H, T] using ENNReal.truncateToReal_le hTtop (x := g x)
  let G : (ℝ^d) → ℝ := fun x => (max 0 (H x)) ^ q⁻¹
  have hGnonneg (x : ℝ^d) : 0 ≤ G x := by
    dsimp [G]
    exact Real.rpow_nonneg (le_max_left _ _) _
  have hGlsc : LowerSemicontinuous G := by
    have hHlsc : LowerSemicontinuous H := by
      exact (ENNReal.continuous_truncateToReal hTtop).comp_lowerSemicontinuous hglsc
        (ENNReal.monotone_truncateToReal hTtop)
    have hbasecont : Continuous fun z : ℝ => max 0 z := continuous_const.max continuous_id
    have hbase : Continuous fun z : ℝ => (max 0 z) ^ q⁻¹ :=
      hbasecont.rpow_const (fun z => Or.inr (inv_nonneg.mpr hq.le))
    exact hbase.comp_lowerSemicontinuous hHlsc (by
      intro a b hab
      exact Real.rpow_le_rpow (le_max_left _ _) (max_le_max_left _ hab)
        (inv_nonneg.mpr hq.le))
  have hGle (x : ℝ^d) : G x ≤ (B : ℝ) ^ q⁻¹ := by
    dsimp [G]
    rw [max_eq_right (hHnonneg x)]
    exact Real.rpow_le_rpow (hHnonneg x) (hHle x) (inv_nonneg.mpr hq.le)
  have huG (x : ℝ^d) : (u x : ℝ) ^ q⁻¹ ≤ G x := by
    have hmin : (u x : ℝ≥0∞) ≤ min T (g x) := by
      refine le_min ?_ (le_of_lt (hug x))
      simpa [T] using (hB x)
    have hmin_top : min T (g x) ≠ ∞ := by
      refine ne_top_of_le_ne_top hTtop ?_
      exact min_le_left _ _
    have huH : (u x : ℝ) ≤ H x := by
      change ((u x : ℝ≥0∞).toReal) ≤ (min T (g x)).toReal
      exact (ENNReal.toReal_le_toReal (by simp) hmin_top).2 hmin
    dsimp [G]
    rw [max_eq_right (hHnonneg x)]
    exact Real.rpow_le_rpow (NNReal.coe_nonneg _) huH (inv_nonneg.mpr hq.le)
  have hGpow (x : ℝ^d) : ENNReal.ofReal (G x ^ q) = min T (g x) := by
    have hmin_top : min T (g x) ≠ ∞ := by
      refine ne_top_of_le_ne_top hTtop ?_
      exact min_le_left _ _
    change ENNReal.ofReal (((max 0 (H x)) ^ q⁻¹) ^ q) = min T (g x)
    rw [max_eq_right (hHnonneg x), Real.rpow_inv_rpow (hHnonneg x) hq.ne']
    change ENNReal.ofReal ((min T (g x)).toReal) = min T (g x)
    exact ENNReal.ofReal_toReal hmin_top
  refine ⟨G, hGnonneg, hGle, hGlsc, huG, ?_⟩
  calc
    ∫⁻ x, ENNReal.ofReal (G x ^ q) ∂μ = ∫⁻ x, min T (g x) ∂μ := by
      apply lintegral_congr
      intro x
      exact hGpow x
    _ ≤ ∫⁻ x, g x ∂μ := by
      apply lintegral_mono
      intro x
      exact min_le_right _ _
    _ ≤ ∫⁻ x, (u x : ℝ≥0∞) ∂μ + ε := hgint

private theorem exists_bounded_nonneg_lsc_majorant_of_memLp
    {d : ℕ} {μ : Measure (ℝ^d)} [μ.WeaklyRegular] [SigmaFinite μ]
    (f : (ℝ^d) → ℂ) {p : ℝ≥0∞} (hp0 : p ≠ 0) (hptop : p ≠ ∞)
    (hf : MemLp f p μ) (n : ℕ) {ε : ℝ≥0∞} (hε : ε ≠ 0) :
    ∃ G : (ℝ^d) → ℝ,
      (∀ x, 0 ≤ G x) ∧
      (∀ x, G x ≤ n) ∧
      LowerSemicontinuous G ∧
      (∀ x, min ‖f x‖ n ≤ G x) ∧
      (∫⁻ x, ENNReal.ofReal (G x ^ p.toReal) ∂μ) ≤
        (∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) + ε := by
  have hq : 0 < p.toReal := ENNReal.toReal_pos hp0 hptop
  let N : ℝ≥0 := n
  let u : (ℝ^d) → ℝ≥0 := fun x => (min ‖f x‖₊ N) ^ p.toReal
  have hu : AEMeasurable u μ := by
    dsimp [u]
    exact (NNReal.continuous_rpow_const hq.le).measurable.comp_aemeasurable
      (hf.aemeasurable.nnnorm.min measurable_const.aemeasurable)
  have huN (x : ℝ^d) : u x ≤ N ^ p.toReal := by
    dsimp [u]
    exact NNReal.rpow_le_rpow (min_le_right _ _) hq.le
  obtain ⟨G, hG0, hGN, hGlsc, huG, hGint⟩ :=
    exists_bounded_nonneg_lsc_root_majorant u hu hq huN hε
  refine ⟨G, hG0, ?_, hGlsc, ?_, ?_⟩
  · intro x
    have hN0 : 0 ≤ (N : ℝ) := NNReal.coe_nonneg _
    have hpow : ((N : ℝ) ^ p.toReal) ^ (p.toReal)⁻¹ = N := by
      rw [Real.rpow_rpow_inv hN0 hq.ne']
    calc
      G x ≤ ((N ^ p.toReal : ℝ≥0) : ℝ) ^ (p.toReal)⁻¹ := hGN x
      _ = ((N : ℝ) ^ p.toReal) ^ (p.toReal)⁻¹ := by rw [NNReal.coe_rpow]
      _ = N := hpow
      _ = n := by simp [N]
  · intro x
    let a : ℝ := ((min ‖f x‖₊ N : ℝ≥0) : ℝ)
    have hbase0 : 0 ≤ a := by
      dsimp [a]
      exact NNReal.coe_nonneg _
    have hroot : (a ^ p.toReal) ^ (p.toReal)⁻¹ = a := by
      rw [Real.rpow_rpow_inv hbase0 hq.ne']
    have hreal : min ‖f x‖ (n : ℝ) = a := by simp [a, N]
    have hu_eq : ((u x : ℝ≥0) : ℝ) = a ^ p.toReal := by
      dsimp [u, a]
    calc
      min ‖f x‖ (n : ℝ) = a := hreal
      _ = ((u x : ℝ≥0) : ℝ) ^ (p.toReal)⁻¹ := by
        rw [hu_eq]
        exact hroot.symm
      _ ≤ G x := huG x
  · calc
      ∫⁻ x, ENNReal.ofReal (G x ^ p.toReal) ∂μ ≤
          (∫⁻ x, (u x : ℝ≥0∞) ∂μ) + ε := hGint
      _ ≤ (∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) + ε := by
        gcongr
        calc
          (u x : ℝ≥0∞) = (↑(min ‖f x‖₊ N) : ℝ≥0∞) ^ p.toReal := by
            rw [ENNReal.coe_rpow_of_nonneg _ hq.le]
          _ ≤ (↑‖f x‖₊ : ℝ≥0∞) ^ p.toReal := by
            apply ENNReal.rpow_le_rpow
            · exact_mod_cast min_le_left _ _
            · exact hq.le
          _ = ‖f x‖ₑ ^ p.toReal := by rw [enorm_eq_nnnorm]

private theorem exists_measurable_raw_envelope_at_eps
    {d : ℕ} {E : Set ℝ} {μ : Measure (ℝ^d)} [μ.WeaklyRegular] [SigmaFinite μ]
    {p : ℝ≥0∞} (hp0 : p ≠ 0) (hptop : p ≠ ∞)
    {C : ℝ≥0∞}
    (hstrong : ∀ φ : SchwartzMap (ℝ^d) ℂ,
      eLpNorm (M E (φ : (ℝ^d) → ℂ)) p μ ≤
        C * eLpNorm (φ : (ℝ^d) → ℂ) p μ)
    {f : (ℝ^d) → ℂ} (hf : MemLp f p μ)
    {ε : ℝ≥0∞} (hε : ε ≠ 0) :
    ∃ J : (ℝ^d) → ℝ≥0∞, Measurable J ∧ (∀ x, M E f x ≤ J x) ∧
      (∀ x, (⨆ m : ℕ,
        M E (fun y => ((min ‖f y‖ (m : ℝ) : ℝ) : ℂ)) x) ≤ J x) ∧
      eLpNorm J p μ ≤ C *
        ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) + ε) ^ (p.toReal)⁻¹ := by
  choose G hG0 hGbound hGlsc hGmajor hGint using fun n : ℕ =>
    exists_bounded_nonneg_lsc_majorant_of_memLp f hp0 hptop hf n hε
  choose ψ hψreal hψ0 hψG hψtend using fun n : ℕ =>
    exists_schwartz_minorants_of_bounded_lsc (G n) (hG0 n) (hGbound n) (hGlsc n)
  choose J hJmeas hJG hJbound using fun n : ℕ =>
    exists_measurable_envelope_of_bounded_lsc hp0 hptop hstrong
      (hG0 n) (hGbound n) (ψ n) (hψreal n) (hψ0 n) (hψG n) (hψtend n)
  let H : (ℝ^d) → ℝ≥0∞ := fun x => atTop.liminf (fun n => J n x)
  have hHmeas : Measurable H := by
    exact Measurable.liminf hJmeas
  have hHdom (x : ℝ^d) : M E f x ≤ H x := by
    calc
      M E f x ≤ atTop.liminf (fun n => M E (fun y => (G n y : ℂ)) x) :=
        restrictedSphericalMaximal_le_liminf_of_trunc_majorants f G
          (fun n => (hGlsc n).measurable) hGbound hG0 hGmajor x
      _ ≤ atTop.liminf (fun n => J n x) := by
        refine Filter.liminf_le_liminf ?_ (by isBoundedDefault) (by isBoundedDefault)
        filter_upwards with n
        exact hJG n x
      _ = H x := rfl
  have hHPdom (x : ℝ^d) :
      (⨆ m : ℕ, M E (fun y => ((min ‖f y‖ (m : ℝ) : ℝ) : ℂ)) x) ≤ H x := by
    calc
      (⨆ m : ℕ, M E (fun y => ((min ‖f y‖ (m : ℝ) : ℝ) : ℂ)) x) ≤
          atTop.liminf (fun n => M E (fun y => (G n y : ℂ)) x) :=
        iSup_restrictedSphericalMaximal_norm_trunc_le_liminf_of_trunc_majorants f G
          (fun n => (hGlsc n).measurable) hGbound hG0 hGmajor x
      _ ≤ atTop.liminf (fun n => J n x) := by
        refine Filter.liminf_le_liminf ?_ (by isBoundedDefault) (by isBoundedDefault)
        filter_upwards with n
        exact hJG n x
      _ = H x := rfl
  refine ⟨H, hHmeas, hHdom, hHPdom, ?_⟩
  apply eLpNorm_liminf_le_of_uniform hp0 hptop hJmeas
  intro n
  calc
    eLpNorm (J n) p μ ≤ C * eLpNorm (fun y => (G n y : ℂ)) p μ :=
      hJbound n
    _ ≤ C * ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) + ε) ^ (p.toReal)⁻¹ := by
      exact mul_le_mul_of_nonneg_left
        (eLpNorm_real_le_of_lintegral_rpow_le hp0 hptop (hG0 n) (hGint n)) bot_le

private theorem exists_measurable_raw_and_truncation_envelope_of_memLp
    {d : ℕ} {E : Set ℝ} {μ : Measure (ℝ^d)} [μ.WeaklyRegular] [SigmaFinite μ]
    {p : ℝ≥0∞} (hp0 : p ≠ 0) (hptop : p ≠ ∞)
    {C : ℝ≥0∞} (hCtop : C ≠ ∞)
    (hstrong : ∀ φ : SchwartzMap (ℝ^d) ℂ,
      eLpNorm (M E (φ : (ℝ^d) → ℂ)) p μ ≤
        C * eLpNorm (φ : (ℝ^d) → ℂ) p μ)
    {f : (ℝ^d) → ℂ} (hf : MemLp f p μ) :
    ∃ J : (ℝ^d) → ℝ≥0∞, Measurable J ∧ (∀ x, M E f x ≤ J x) ∧
      (∀ x, (⨆ m : ℕ,
        M E (fun y => ((min ‖f y‖ (m : ℝ) : ℝ) : ℂ)) x) ≤ J x) ∧
      eLpNorm J p μ ≤ C * eLpNorm f p μ := by
  choose J hJmeas hJdom hJPdom hJbound using fun n : ℕ =>
    exists_measurable_raw_envelope_at_eps hp0 hptop hstrong hf
      (by simp : (((n + 1 : ℕ) : ℝ≥0∞)⁻¹) ≠ 0)
  let H : (ℝ^d) → ℝ≥0∞ := fun x => atTop.liminf (fun n => J n x)
  have hHmeas : Measurable H := by
    exact Measurable.liminf hJmeas
  have hHdom (x : ℝ^d) : M E f x ≤ H x := by
    change M E f x ≤ atTop.liminf (fun n => J n x)
    rw [Filter.le_liminf_iff]
    intro y hy
    filter_upwards with n
    exact hy.trans_le (hJdom n x)
  have hHPdom (x : ℝ^d) :
      (⨆ m : ℕ, M E (fun y => ((min ‖f y‖ (m : ℝ) : ℝ) : ℂ)) x) ≤ H x := by
    change (⨆ m : ℕ, M E (fun y => ((min ‖f y‖ (m : ℝ) : ℝ) : ℂ)) x) ≤
      atTop.liminf (fun n => J n x)
    rw [Filter.le_liminf_iff]
    intro y hy
    filter_upwards with n
    exact hy.trans_le (hJPdom n x)
  have hshiftNat : Tendsto (fun n : ℕ => n + 1) atTop atTop :=
    (Filter.tendsto_add_atTop_iff_nat 1).2 tendsto_id
  have hinv : Tendsto (fun n : ℕ => ((n + 1 : ℕ) : ℝ≥0∞)⁻¹) atTop (𝓝 0) :=
    ENNReal.tendsto_inv_nat_nhds_zero.comp hshiftNat
  have hsum : Tendsto (fun n : ℕ =>
      (∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) + ((n + 1 : ℕ)⁻¹ : ℝ≥0∞)) atTop
      (𝓝 ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) + 0)) :=
    tendsto_const_nhds.add hinv
  have hpow : Tendsto (fun n : ℕ =>
      ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) + ((n + 1 : ℕ)⁻¹ : ℝ≥0∞)) ^
        (p.toReal)⁻¹) atTop
      (𝓝 ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) ^ (p.toReal)⁻¹)) := by
    change Tendsto ((fun z : ℝ≥0∞ => z ^ (p.toReal)⁻¹) ∘
      fun n : ℕ => (∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) +
        ((n + 1 : ℕ)⁻¹ : ℝ≥0∞)) atTop
      (𝓝 ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) ^ (p.toReal)⁻¹))
    simpa only [add_zero] using
      (ENNReal.continuous_rpow_const.tendsto
        ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) + 0)).comp hsum
  have hKlim : Tendsto (fun n : ℕ => C *
      ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) + ((n + 1 : ℕ)⁻¹ : ℝ≥0∞)) ^
        (p.toReal)⁻¹) atTop
      (𝓝 (C * (∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) ^ (p.toReal)⁻¹)) :=
    ((ENNReal.continuous_const_mul hCtop).tendsto
      ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) ^ (p.toReal)⁻¹)).comp hpow
  refine ⟨H, hHmeas, hHdom, hHPdom, ?_⟩
  calc
    eLpNorm H p μ ≤ atTop.liminf (fun n => eLpNorm (J n) p μ) :=
      eLpNorm_liminf_le_liminf hp0 hptop hJmeas
    _ ≤ atTop.liminf (fun n => C *
        ((∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) + ((n + 1 : ℕ)⁻¹ : ℝ≥0∞)) ^
          (p.toReal)⁻¹) := by
      refine Filter.liminf_le_liminf ?_ (by isBoundedDefault) (by isBoundedDefault)
      filter_upwards with n
      exact hJbound n
    _ = C * (∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) ^ (p.toReal)⁻¹ :=
      hKlim.liminf_eq
    _ = C * eLpNorm f p μ := by
      rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop]
      rw [show 1 / p.toReal = (p.toReal)⁻¹ by ring]

theorem exists_measurable_raw_envelope_of_memLp
    {d : ℕ} {E : Set ℝ} {μ : Measure (ℝ^d)} [μ.WeaklyRegular] [SigmaFinite μ]
    {p : ℝ≥0∞} (hp0 : p ≠ 0) (hptop : p ≠ ∞)
    {C : ℝ≥0∞} (hCtop : C ≠ ∞)
    (hstrong : ∀ φ : SchwartzMap (ℝ^d) ℂ,
      eLpNorm (M E (φ : (ℝ^d) → ℂ)) p μ ≤
        C * eLpNorm (φ : (ℝ^d) → ℂ) p μ)
    {f : (ℝ^d) → ℂ} (hf : MemLp f p μ) :
    ∃ J : (ℝ^d) → ℝ≥0∞, Measurable J ∧ (∀ x, M E f x ≤ J x) ∧
      eLpNorm J p μ ≤ C * eLpNorm f p μ := by
  obtain ⟨J, hJmeas, hJraw, -, hJbound⟩ :=
    exists_measurable_raw_and_truncation_envelope_of_memLp hp0 hptop hCtop hstrong hf
  exact ⟨J, hJmeas, hJraw, hJbound⟩

private theorem sphere_comp_bound_int
    {d : ℕ} {g : (ℝ^d) → ℂ} (hg : StronglyMeasurable g)
    (x : ℝ^d) (t : ℝ) (n : ℕ) :
    Integrable (fun ω : Metric.sphere (0 : ℝ^d) 1 =>
      min ‖g (x + t • (ω : ℝ^d))‖ (n : ℝ)) (unitSphereMeasure d) := by
  letI : IsFiniteMeasure (unitSphereMeasure d) := by
    unfold unitSphereMeasure
    infer_instance
  refine Integrable.of_bound ?_ (n : ℝ) ?_
  · exact ((continuous_id.min continuous_const).comp_stronglyMeasurable
      ((hg.comp_measurable
        ((continuous_const : Continuous fun _ : Metric.sphere (0 : ℝ^d) 1 => x).add
          ((continuous_const : Continuous fun _ : Metric.sphere (0 : ℝ^d) 1 => t).smul
            continuous_subtype_val)).measurable).norm)).aestronglyMeasurable
  · filter_upwards with ω
    rw [Real.norm_eq_abs, abs_of_nonneg]
    · exact min_le_right _ _
    · exact le_min (norm_nonneg _) (Nat.cast_nonneg _)

private theorem sphere_comp_trunc_integral_eq_norm_average
    {d : ℕ} {g : (ℝ^d) → ℂ} (hg : StronglyMeasurable g)
    (x : ℝ^d) (t : ℝ) (n : ℕ) :
    (∫⁻ ω : Metric.sphere (0 : ℝ^d) 1,
      ENNReal.ofReal (min ‖g (x + t • (ω : ℝ^d))‖ (n : ℝ)) ∂unitSphereMeasure d) =
      ENNReal.ofReal ‖sphericalAverage t
        (fun y => ((min ‖g y‖ (n : ℝ) : ℝ) : ℂ)) x‖ := by
  let G : Metric.sphere (0 : ℝ^d) 1 → ℝ :=
    fun ω => min ‖g (x + t • (ω : ℝ^d))‖ (n : ℝ)
  have hGint : Integrable G (unitSphereMeasure d) := by
    simpa [G] using sphere_comp_bound_int hg x t n
  have hG0 (ω) : 0 ≤ G ω := by
    dsimp [G]
    exact le_min (norm_nonneg _) (Nat.cast_nonneg _)
  have hnorm : ‖sphericalAverage t (fun y => ((min ‖g y‖ (n : ℝ) : ℝ) : ℂ)) x‖ =
      ∫ ω, G ω ∂unitSphereMeasure d := by
    unfold sphericalAverage
    change ‖∫ y : Metric.sphere (0 : ℝ^d) 1,
        Complex.ofRealCLM (G y) ∂unitSphereMeasure d‖ = _
    rw [Complex.ofRealCLM.integral_comp_comm hGint]
    change ‖((∫ ω, G ω ∂unitSphereMeasure d : ℝ) : ℂ)‖ = _
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg]
    exact integral_nonneg fun ω => hG0 ω
  rw [hnorm]
  symm
  rw [ofReal_integral_eq_lintegral_ofReal hGint (Filter.Eventually.of_forall hG0)]

private theorem integrable_sphere_of_truncation_max_bound
    {d : ℕ} {E : Set ℝ} {g : (ℝ^d) → ℂ} (hg : StronglyMeasurable g)
    (x : ℝ^d) {t : ℝ} (ht : t ∈ E ∩ Ioi (0 : ℝ))
    {J : (ℝ^d) → ℝ≥0∞}
    (hPJ : (⨆ n : ℕ, M E (fun y => ((min ‖g y‖ (n : ℝ) : ℝ) : ℂ)) x) ≤ J x)
    (hJtop : J x < ∞) :
    Integrable (fun ω : Metric.sphere (0 : ℝ^d) 1 =>
      g (x + t • (ω : ℝ^d))) (unitSphereMeasure d) := by
  let F : Metric.sphere (0 : ℝ^d) 1 → ℂ :=
    fun ω => g (x + t • (ω : ℝ^d))
  have hFmeas : AEStronglyMeasurable F (unitSphereMeasure d) := by
    apply hg.aestronglyMeasurable.comp_measurable
    exact ((continuous_const : Continuous fun _ : Metric.sphere (0 : ℝ^d) 1 => x).add
      ((continuous_const : Continuous fun _ : Metric.sphere (0 : ℝ^d) 1 => t).smul
        continuous_subtype_val)).measurable
  let u : ℕ → Metric.sphere (0 : ℝ^d) 1 → ℝ≥0∞ := fun n ω =>
    ENNReal.ofReal (min ‖F ω‖ (n : ℝ))
  have hu_meas (n : ℕ) : AEMeasurable (u n) (unitSphereMeasure d) := by
    dsimp [u]
    exact ((continuous_id.min continuous_const).comp_aestronglyMeasurable hFmeas.norm).aemeasurable.ennreal_ofReal
  have hu_mono : ∀ ω, Monotone fun n : ℕ => u n ω := by
    intro ω m n hmn
    dsimp [u]
    apply ENNReal.ofReal_le_ofReal
    exact min_le_min_left _ (by exact_mod_cast hmn)
  have hu_tend : ∀ ω, Tendsto (fun n : ℕ => u n ω) atTop (𝓝 ‖F ω‖ₑ) := by
    intro ω
    obtain ⟨N, hN⟩ := exists_nat_ge ‖F ω‖
    have heq : (fun n : ℕ => min ‖F ω‖ (n : ℝ)) =ᶠ[atTop] fun _ => ‖F ω‖ := by
      filter_upwards [eventually_ge_atTop N] with n hn
      rw [min_eq_left]
      exact hN.trans (by exact_mod_cast hn)
    have hreal : Tendsto (fun n : ℕ => min ‖F ω‖ (n : ℝ)) atTop (𝓝 ‖F ω‖) :=
      heq.tendsto
    change Tendsto (fun n : ℕ => ENNReal.ofReal (min ‖F ω‖ (n : ℝ))) atTop
      (𝓝 ‖F ω‖₊)
    have hh := ENNReal.continuous_ofReal.tendsto ‖F ω‖ |>.comp hreal
    rw [ofReal_norm] at hh
    rw [← enorm_eq_nnnorm]
    simpa [Function.comp_def] using hh
  have hterm (n : ℕ) : (∫⁻ ω, u n ω ∂unitSphereMeasure d) ≤ J x := by
    calc
      (∫⁻ ω, u n ω ∂unitSphereMeasure d) =
          ENNReal.ofReal ‖sphericalAverage t
            (fun y => ((min ‖g y‖ (n : ℝ) : ℝ) : ℂ)) x‖ := by
              simpa [u, F] using sphere_comp_trunc_integral_eq_norm_average hg x t n
      _ ≤ M E (fun y => ((min ‖g y‖ (n : ℝ) : ℝ) : ℂ)) x := by
        unfold M restrictedSphericalMaximal
        exact le_iSup_of_le t (le_iSup_of_le ht le_rfl)
      _ ≤ ⨆ n : ℕ, M E (fun y => ((min ‖g y‖ (n : ℝ) : ℝ) : ℂ)) x :=
        le_iSup (fun n : ℕ => M E (fun y => ((min ‖g y‖ (n : ℝ) : ℝ) : ℂ)) x) n
      _ ≤ J x := hPJ
  refine ⟨hFmeas, ?_⟩
  rw [hasFiniteIntegral_iff_enorm]
  have hlin : (∫⁻ ω, ‖F ω‖ₑ ∂unitSphereMeasure d) ≤ J x := by
    calc
      (∫⁻ ω, ‖F ω‖ₑ ∂unitSphereMeasure d) = ∫⁻ ω, ⨆ n : ℕ, u n ω ∂unitSphereMeasure d := by
        apply lintegral_congr
        intro ω
        exact tendsto_nhds_unique (hu_tend ω) (tendsto_atTop_iSup (hu_mono ω))
      _ = ⨆ n : ℕ, ∫⁻ ω, u n ω ∂unitSphereMeasure d :=
        lintegral_iSup' hu_meas (Filter.Eventually.of_forall hu_mono)
      _ ≤ J x := iSup_le hterm
  exact hlin.trans_lt hJtop

private theorem exists_schwartz_eLpNorm_sub_lt
    {d : ℕ} {μ : Measure (ℝ^d)} [μ.HasTemperateGrowth] [IsFiniteMeasureOnCompacts μ]
    {p : ℝ≥0∞} [Fact (1 ≤ p)] (hptop : p ≠ ∞)
    {f : (ℝ^d) → ℂ} (hf : MemLp f p μ) {ε : ℝ} (hε : 0 < ε) :
    ∃ φ : SchwartzMap (ℝ^d) ℂ,
      eLpNorm (f - (φ : (ℝ^d) → ℂ)) p μ < ENNReal.ofReal ε := by
  obtain ⟨φ, hφ⟩ :=
    (SchwartzMap.denseRange_toLpCLM (E := ℝ^d) (F := ℂ) hptop).exists_dist_lt
      (hf.toLp f) hε
  refine ⟨φ, ?_⟩
  have hφmem : MemLp (φ : (ℝ^d) → ℂ) p μ := φ.memLp p μ
  have hdist : dist (hf.toLp f) (φ.toLp p μ) =
      (eLpNorm (f - (φ : (ℝ^d) → ℂ)) p μ).toReal := by
    rw [dist_eq_norm_sub]
    change ‖hf.toLp f - hφmem.toLp (φ : (ℝ^d) → ℂ)‖ = _
    rw [← MemLp.toLp_sub hf hφmem]
    exact Lp.norm_toLp _ _
  have htop : eLpNorm (f - (φ : (ℝ^d) → ℂ)) p μ ≠ ∞ :=
    (hf.sub hφmem).eLpNorm_ne_top
  apply (ENNReal.toReal_lt_toReal htop ENNReal.ofReal_ne_top).mp
  rw [ENNReal.toReal_ofReal hε.le]
  exact hdist ▸ hφ

private theorem exists_fast_schwartz_approximation
    {d : ℕ} {μ : Measure (ℝ^d)} [μ.HasTemperateGrowth] [IsFiniteMeasureOnCompacts μ]
    {p : ℝ≥0∞} [Fact (1 ≤ p)] (hptop : p ≠ ∞)
    {f : (ℝ^d) → ℂ} (hf : MemLp f p μ) :
    ∃ φ : ℕ → SchwartzMap (ℝ^d) ℂ, ∀ n,
      eLpNorm (f - (φ n : (ℝ^d) → ℂ)) p μ ≤
        ENNReal.ofReal ((2 : ℝ)⁻¹ ^ n) := by
  choose φ hφ using fun n : ℕ =>
    exists_schwartz_eLpNorm_sub_lt hptop hf
      (show 0 < ((2 : ℝ)⁻¹ ^ n) by positivity)
  exact ⟨φ, fun n => (hφ n).le⟩

private theorem restrictedSphericalMaximal_add_le_of_integrable_slices
    {d : ℕ} {E : Set ℝ} {f g : (ℝ^d) → ℂ} {x : ℝ^d}
    (hf : ∀ t ∈ E ∩ Ioi (0 : ℝ), Integrable
      (fun ω : Metric.sphere (0 : ℝ^d) 1 => f (x + t • (ω : ℝ^d)))
      (unitSphereMeasure d))
    (hg : ∀ t ∈ E ∩ Ioi (0 : ℝ), Integrable
      (fun ω : Metric.sphere (0 : ℝ^d) 1 => g (x + t • (ω : ℝ^d)))
      (unitSphereMeasure d)) :
    M E (f + g) x ≤ M E f x + M E g x := by
  unfold M restrictedSphericalMaximal
  apply iSup_le
  intro t
  apply iSup_le
  intro ht
  have havg : sphericalAverage t (f + g) x =
      sphericalAverage t f x + sphericalAverage t g x := by
    unfold sphericalAverage
    change (∫ ω : Metric.sphere (0 : ℝ^d) 1,
      (f (x + t • (ω : ℝ^d)) + g (x + t • (ω : ℝ^d))) ∂unitSphereMeasure d) = _
    rw [integral_add (hf t ht) (hg t ht)]
  rw [havg]
  calc
    ENNReal.ofReal ‖sphericalAverage t f x + sphericalAverage t g x‖ ≤
        ENNReal.ofReal (‖sphericalAverage t f x‖ + ‖sphericalAverage t g x‖) :=
      ENNReal.ofReal_le_ofReal (norm_add_le _ _)
    _ = ENNReal.ofReal ‖sphericalAverage t f x‖ +
        ENNReal.ofReal ‖sphericalAverage t g x‖ := by
      rw [ENNReal.ofReal_add (norm_nonneg _) (norm_nonneg _)]
    _ ≤ (⨆ s ∈ E ∩ Ioi (0 : ℝ),
        ENNReal.ofReal ‖sphericalAverage s f x‖) +
        ⨆ s ∈ E ∩ Ioi (0 : ℝ),
          ENNReal.ofReal ‖sphericalAverage s g x‖ := by
      gcongr
      · exact le_iSup_of_le t (le_iSup_of_le ht le_rfl)
      · exact le_iSup_of_le t (le_iSup_of_le ht le_rfl)

private theorem restrictedSphericalMaximal_neg_eq
    {d : ℕ} {E : Set ℝ} (f : (ℝ^d) → ℂ) :
    M E (fun x => -f x) = M E f := by
  funext x
  unfold M restrictedSphericalMaximal
  apply iSup_congr
  intro t
  apply iSup_congr
  intro ht
  unfold sphericalAverage
  rw [integral_neg]
  rw [norm_neg]

private theorem ae_lt_top_of_measurable_memLp
    {X : Type*} [MeasurableSpace X] {μ : Measure X} {p : ℝ≥0∞}
    (hp0 : p ≠ 0) (hptop : p ≠ ∞) {J : X → ℝ≥0∞}
    (hJmeas : Measurable J) (hJmem : MemLp J p μ) :
    ∀ᵐ x ∂μ, J x < ∞ := by
  have hlin : (∫⁻ x, J x ^ p.toReal ∂μ) < ∞ := by
    have h := (eLpNorm_lt_top_iff_lintegral_rpow_enorm_lt_top hp0 hptop).mp
      hJmem.eLpNorm_lt_top
    simpa only [enorm_eq_self] using h
  filter_upwards [ae_lt_top' (hJmeas.aemeasurable.pow_const p.toReal) hlin.ne] with x hx
  apply lt_top_iff_ne_top.mpr
  intro hJtop
  rw [hJtop, ENNReal.top_rpow_of_pos (ENNReal.toReal_pos hp0 hptop)] at hx
  exact lt_irrefl _ hx

private theorem geometric_ennreal_error (n : ℕ) :
    ENNReal.ofReal ((2 : ℝ)⁻¹ ^ n) = ((2 : ℝ≥0∞)⁻¹) ^ n := by
  rw [ENNReal.ofReal_pow (by positivity)]
  congr 1
  rw [ENNReal.ofReal_inv_of_pos (by norm_num)]
  norm_num

private theorem ae_tendsto_toReal_zero_of_geometric_eLpNorm_mul
    {α : Type*} [MeasurableSpace α] {μ : Measure α} {p : ℝ≥0∞} [Fact (1 ≤ p)]
    {A : ℝ≥0∞} (hAtop : A ≠ ∞)
    (J : ℕ → α → ℝ≥0∞) (hJmeas : ∀ n, Measurable (J n))
    (hJbound : ∀ n, eLpNorm (J n) p μ ≤
      A * ENNReal.ofReal ((2 : ℝ)⁻¹ ^ n)) :
    ∀ᵐ x ∂μ, Tendsto (fun n => (J n x).toReal) atTop (𝓝 0) := by
  let K : ℕ → α → ℝ := fun n x => (J n x).toReal
  have hKmeas (n : ℕ) : AEStronglyMeasurable (K n) μ :=
    (hJmeas n).ennreal_toReal.aestronglyMeasurable
  have hKbound (n : ℕ) : eLpNorm (K n) p μ ≤ A * ((2 : ℝ≥0∞)⁻¹) ^ n := by
    calc
      eLpNorm (K n) p μ ≤ eLpNorm (J n) p μ := by
        apply eLpNorm_mono_enorm
        intro x
        rw [Real.enorm_eq_ofReal ENNReal.toReal_nonneg, enorm_eq_self]
        exact ENNReal.ofReal_toReal_le
      _ ≤ A * ENNReal.ofReal ((2 : ℝ)⁻¹ ^ n) := hJbound n
      _ = A * ((2 : ℝ≥0∞)⁻¹) ^ n := by rw [geometric_ennreal_error]
  have hsum : (∑' n, eLpNorm (K n) p μ) ≠ ∞ := by
    apply ne_top_of_le_ne_top ?_ (ENNReal.tsum_le_tsum hKbound)
    rw [ENNReal.tsum_mul_left, ENNReal.tsum_geometric]
    exact ENNReal.mul_ne_top hAtop (by norm_num)
  have hsummable : ∀ᵐ x ∂μ, Summable (fun n => ‖K n x‖) :=
    summable_norm_of_tsum_eLpNorm_ne_top Fact.out hKmeas hsum
  filter_upwards [hsummable] with x hx
  have hzero : Tendsto (fun n => ‖K n x‖) atTop (𝓝 0) :=
    hx.tendsto_atTop_zero
  simpa [K, Real.norm_eq_abs, abs_of_nonneg ENNReal.toReal_nonneg] using hzero

/-!
The envelope theorem above is deliberately pointwise: it gives a measurable
majorant even before one knows that the literal supremum over radii is
measurable.  The next two lemmas record the representative-safety part of the
usual lifting argument.  A null modification is first covered by a bounded
measurable null function.  The maximal bound makes the latter vanish on every
spherical fibre simultaneously, which is strong enough to compare the raw
Bochner integrals without assuming that either of the two inputs is integrable
on that fibre.
-/

private theorem raw_null_of_measurable_envelope
    {d : ℕ} {E : Set ℝ} {μ : Measure (ℝ^d)} {p : ℝ≥0∞} (hp0 : p ≠ 0)
    {A : ℝ≥0∞}
    (hlift : ∀ h : (ℝ^d) → ℂ, MemLp h p μ →
      ∃ J : (ℝ^d) → ℝ≥0∞, Measurable J ∧
        (∀ x, M E h x ≤ J x) ∧
        eLpNorm J p μ ≤ A * eLpNorm h p μ)
    (h : (ℝ^d) → ℂ) (hhzero : h =ᵐ[μ] 0) :
    M E h =ᵐ[μ] 0 := by
  have hh : MemLp h p μ := by
    exact MemLp.ae_eq hhzero.symm MemLp.zero
  obtain ⟨J, hJmeas, hdom, hJbound⟩ := hlift h hh
  have hnormh : eLpNorm h p μ = 0 := eLpNorm_eq_zero_of_ae_zero hhzero
  have hnormJ : eLpNorm J p μ = 0 := by
    apply le_antisymm
    · simpa [hnormh] using hJbound
    · exact bot_le
  have hJzero : J =ᵐ[μ] 0 :=
    (eLpNorm_eq_zero_iff hJmeas.aestronglyMeasurable hp0).mp hnormJ
  filter_upwards [hJzero] with x hx
  apply le_antisymm
  · simpa [hx] using hdom x
  · exact bot_le

private theorem restrictedSphericalMaximal_ae_eq_of_ae_eq_of_envelope
    {d : ℕ} {E : Set ℝ} {μ : Measure (ℝ^d)} {p : ℝ≥0∞} (hp0 : p ≠ 0)
    {A : ℝ≥0∞}
    (hlift : ∀ h : (ℝ^d) → ℂ, MemLp h p μ →
      ∃ J : (ℝ^d) → ℝ≥0∞, Measurable J ∧
        (∀ x, M E h x ≤ J x) ∧
        eLpNorm J p μ ≤ A * eLpNorm h p μ)
    {f g : (ℝ^d) → ℂ} (hfg : f =ᵐ[μ] g) :
    M E f =ᵐ[μ] M E g := by
  have hbad : μ {x | f x ≠ g x} = 0 := by
    rw [← ae_iff]
    change ∀ᵐ x ∂μ, f x = g x at hfg
    simpa only [not_ne_iff] using hfg
  obtain ⟨N, hsub, hNmeas, hNzero⟩ := exists_measurable_superset_of_null hbad
  let b : (ℝ^d) → ℝ := N.indicator fun _ => 1
  have hbmeas : Measurable b := measurable_const.indicator hNmeas
  have hbnonneg : ∀ y, 0 ≤ b y := by
    intro y
    by_cases hy : y ∈ N <;> simp [b, hy]
  have hbbound : ∀ y, ‖b y‖ ≤ 1 := by
    intro y
    by_cases hy : y ∈ N <;> simp [b, hy]
  have hbzero : (fun y => (b y : ℂ)) =ᵐ[μ] 0 := by
    filter_upwards [compl_mem_ae_iff.mpr hNzero] with y hy
    have hy' : y ∉ N := by simpa using hy
    simp [b, hy']
  have hbmem : MemLp (fun y => (b y : ℂ)) p μ :=
    MemLp.ae_eq hbzero.symm MemLp.zero
  have hMbzero : M E (fun y => (b y : ℂ)) =ᵐ[μ] 0 :=
    raw_null_of_measurable_envelope hp0 hlift _ hbzero
  filter_upwards [hMbzero] with x hx
  have havg (t : ℝ) (ht : t ∈ E ∩ Ioi (0 : ℝ)) :
      sphericalAverage t f x = sphericalAverage t g x := by
    let Φ : Metric.sphere (0 : ℝ^d) 1 → ℝ^d :=
      fun ω => x + t • (ω : ℝ^d)
    have hbint : Integrable (fun ω : Metric.sphere (0 : ℝ^d) 1 => b (Φ ω))
        (unitSphereMeasure d) := by
      apply integrable_sphere_comp_of_bounded_measurable hbmeas hbbound t x
    have hterm : ENNReal.ofReal ‖sphericalAverage t (fun y => (b y : ℂ)) x‖ = 0 := by
      apply le_antisymm
      · have hle : ENNReal.ofReal ‖sphericalAverage t (fun y => (b y : ℂ)) x‖ ≤
            M E (fun y => (b y : ℂ)) x := by
          unfold M restrictedSphericalMaximal
          apply le_iSup_of_le t
          apply le_iSup_of_le ht
          exact le_rfl
        simpa using hle.trans_eq hx
      · exact bot_le
    have havgbzero : sphericalAverage t (fun y => (b y : ℂ)) x = 0 := by
      apply norm_eq_zero.mp
      exact le_antisymm (ENNReal.ofReal_eq_zero.mp hterm) (norm_nonneg _)
    have hbintegral : (∫ ω : Metric.sphere (0 : ℝ^d) 1, b (Φ ω)
        ∂unitSphereMeasure d) = 0 := by
      rw [← norm_sphericalAverage_ofReal_eq_integral_of_integrable hbint hbnonneg]
      simpa using congrArg norm havgbzero
    have hbslice : (fun ω : Metric.sphere (0 : ℝ^d) 1 => b (Φ ω))
        =ᵐ[unitSphereMeasure d] 0 :=
      (integral_eq_zero_iff_of_nonneg (fun ω => hbnonneg (Φ ω)) hbint).mp hbintegral
    have hfgslice : (fun ω : Metric.sphere (0 : ℝ^d) 1 => f (Φ ω))
        =ᵐ[unitSphereMeasure d] fun ω => g (Φ ω) := by
      filter_upwards [hbslice] with ω hω
      have hnotN : Φ ω ∉ N := by
        intro hN
        have : b (Φ ω) = 1 := by simp [b, hN]
        rw [this] at hω
        norm_num at hω
      by_contra hne
      exact hnotN (hsub hne)
    simpa only [Φ, sphericalAverage] using integral_congr_ae hfgslice
  apply le_antisymm
  · unfold M restrictedSphericalMaximal
    apply iSup_le
    intro t
    apply iSup_le
    intro ht
    rw [havg t ht]
    exact le_iSup_of_le t (le_iSup_of_le ht le_rfl)
  · unfold M restrictedSphericalMaximal
    apply iSup_le
    intro t
    apply iSup_le
    intro ht
    rw [← havg t ht]
    exact le_iSup_of_le t (le_iSup_of_le ht le_rfl)

theorem memLp_restrictedSphericalMaximal_of_memLp_of_schwartz_bound
    {d : ℕ} {E : Set ℝ} {μ : Measure (ℝ^d)} [μ.WeaklyRegular] [SigmaFinite μ]
    [μ.HasTemperateGrowth] [IsFiniteMeasureOnCompacts μ]
    {p : ℝ≥0∞} (hp : 1 ≤ p) (hp0 : p ≠ 0) (hptop : p ≠ ∞)
    {C : ℝ}
    (hstrong : ∀ φ : SchwartzMap (ℝ^d) ℂ,
      eLpNorm (M E (φ : (ℝ^d) → ℂ)) p μ ≤
        ENNReal.ofReal C * eLpNorm (φ : (ℝ^d) → ℂ) p μ)
    {f : (ℝ^d) → ℂ} (hf : MemLp f p μ) :
    MemLp (M E f) p μ ∧
      eLpNorm (M E f) p μ ≤ ENNReal.ofReal C * eLpNorm f p μ := by
  letI : Fact (1 ≤ p) := ⟨hp⟩
  let g : (ℝ^d) → ℂ := AEStronglyMeasurable.mk f hf.1
  have hfg : f =ᵐ[μ] g := hf.1.ae_eq_mk
  have hgmeas : StronglyMeasurable g := hf.1.stronglyMeasurable_mk
  have hgmem : MemLp g p μ := MemLp.ae_eq hfg hf
  have hlift : ∀ h : (ℝ^d) → ℂ, MemLp h p μ →
      ∃ J : (ℝ^d) → ℝ≥0∞, Measurable J ∧
        (∀ x, M E h x ≤ J x) ∧
        eLpNorm J p μ ≤ ENNReal.ofReal C * eLpNorm h p μ := by
    intro h hh
    exact exists_measurable_raw_envelope_of_memLp hp0 hptop ENNReal.ofReal_ne_top
      hstrong hh
  have hMfg : M E f =ᵐ[μ] M E g :=
    restrictedSphericalMaximal_ae_eq_of_ae_eq_of_envelope hp0 hlift hfg
  obtain ⟨K, hKmeas, hKraw, hKtrunc, hKbound⟩ :=
    exists_measurable_raw_and_truncation_envelope_of_memLp hp0 hptop
      ENNReal.ofReal_ne_top hstrong hgmem
  have hKnorm : eLpNorm K p μ < ∞ :=
    hKbound.trans_lt (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hgmem.eLpNorm_lt_top)
  have hKmem : MemLp K p μ := ⟨hKmeas.aestronglyMeasurable, hKnorm⟩
  have hKfinite : ∀ᵐ x ∂μ, K x < ∞ :=
    ae_lt_top_of_measurable_memLp hp0 hptop hKmeas hKmem
  obtain ⟨φ, hφ⟩ := exists_fast_schwartz_approximation hptop hgmem
  have hφmem (n : ℕ) : MemLp (φ n : (ℝ^d) → ℂ) p μ :=
    (φ n).memLp p μ
  choose J hJmeas hJraw hJbound using fun n : ℕ =>
    exists_measurable_raw_envelope_of_memLp hp0 hptop ENNReal.ofReal_ne_top
      hstrong (hgmem.sub (hφmem n))
  have hJgeom (n : ℕ) : eLpNorm (J n) p μ ≤
      ENNReal.ofReal C * ENNReal.ofReal ((2 : ℝ)⁻¹ ^ n) := by
    calc
      eLpNorm (J n) p μ ≤ ENNReal.ofReal C *
          eLpNorm (g - (φ n : (ℝ^d) → ℂ)) p μ := hJbound n
      _ ≤ ENNReal.ofReal C * ENNReal.ofReal ((2 : ℝ)⁻¹ ^ n) :=
        mul_le_mul_of_nonneg_left (hφ n) bot_le
  have hJzero : ∀ᵐ x ∂μ, Tendsto (fun n => (J n x).toReal) atTop (𝓝 0) :=
    ae_tendsto_toReal_zero_of_geometric_eLpNorm_mul ENNReal.ofReal_ne_top J hJmeas hJgeom
  have hJnorm (n : ℕ) : eLpNorm (J n) p μ < ∞ :=
    hJgeom n |>.trans_lt
      (ENNReal.mul_lt_top ENNReal.ofReal_lt_top ENNReal.ofReal_lt_top)
  have hJmem (n : ℕ) : MemLp (J n) p μ :=
    ⟨(hJmeas n).aestronglyMeasurable, hJnorm n⟩
  have hJfinite : ∀ᵐ x ∂μ, ∀ n, J n x < ∞ := by
    rw [ae_all_iff]
    intro n
    exact ae_lt_top_of_measurable_memLp hp0 hptop (hJmeas n) (hJmem n)
  have hMglim : ∀ᵐ x ∂μ, Tendsto
      (fun n => (M E (φ n : (ℝ^d) → ℂ) x).toReal) atTop (𝓝 (M E g x).toReal) := by
    filter_upwards [hKfinite, hJfinite, hJzero] with x hxK hxJ hxJzero
    have hgslice (t : ℝ) (ht : t ∈ E ∩ Ioi (0 : ℝ)) : Integrable
        (fun ω : Metric.sphere (0 : ℝ^d) 1 => g (x + t • (ω : ℝ^d)))
        (unitSphereMeasure d) :=
      integrable_sphere_of_truncation_max_bound hgmeas x ht (hKtrunc x) hxK
    have hφslice (n : ℕ) (t : ℝ) : Integrable
        (fun ω : Metric.sphere (0 : ℝ^d) 1 =>
          (φ n : (ℝ^d) → ℂ) (x + t • (ω : ℝ^d)))
        (unitSphereMeasure d) :=
      integrable_sphere_comp_of_continuous_complex (φ n).continuous t x
    have hplusSlice (n : ℕ) (t : ℝ) (ht : t ∈ E ∩ Ioi (0 : ℝ)) : Integrable
        (fun ω : Metric.sphere (0 : ℝ^d) 1 =>
          (g - (φ n : (ℝ^d) → ℂ)) (x + t • (ω : ℝ^d)))
        (unitSphereMeasure d) := by
      apply Integrable.congr ((hgslice t ht).sub (hφslice n t))
      filter_upwards with ω
      rfl
    have hMgfinite : M E g x < ∞ := (hKraw x).trans_lt hxK
    have hdist (n : ℕ) :
        dist (M E (φ n : (ℝ^d) → ℂ) x).toReal (M E g x).toReal ≤
          (J n x).toReal + (J n x).toReal := by
      have hforward : M E g x ≤ M E (φ n : (ℝ^d) → ℂ) x + J n x := by
        rw [show g = (φ n : (ℝ^d) → ℂ) + (g - (φ n : (ℝ^d) → ℂ)) by
          funext y
          simp]
        exact (restrictedSphericalMaximal_add_le_of_integrable_slices
          (fun t ht => hφslice n t) (fun t ht => hplusSlice n t ht)).trans
          (add_le_add le_rfl (hJraw n x))
      have hreverse : M E (φ n : (ℝ^d) → ℂ) x ≤ M E g x + J n x := by
        rw [show (φ n : (ℝ^d) → ℂ) = g + (fun y => -(g - (φ n : (ℝ^d) → ℂ)) y) by
          funext y
          simp]
        calc
          M E (g + fun y => -(g - (φ n : (ℝ^d) → ℂ)) y) x ≤
              M E g x + M E (fun y => -(g - (φ n : (ℝ^d) → ℂ)) y) x :=
            restrictedSphericalMaximal_add_le_of_integrable_slices
              (fun t ht => hgslice t ht) (fun t ht => (hplusSlice n t ht).neg)
          _ = M E g x + M E (g - (φ n : (ℝ^d) → ℂ)) x := by
            rw [restrictedSphericalMaximal_neg_eq]
          _ ≤ M E g x + J n x := add_le_add le_rfl (hJraw n x)
      have hMφfinite : M E (φ n : (ℝ^d) → ℂ) x < ∞ :=
        hreverse.trans_lt (ENNReal.add_lt_top.mpr ⟨hMgfinite, hxJ n⟩)
      have hforwardReal : (M E g x).toReal ≤
          (M E (φ n : (ℝ^d) → ℂ) x).toReal + (J n x).toReal := by
        calc
          (M E g x).toReal ≤
              (M E (φ n : (ℝ^d) → ℂ) x + J n x).toReal :=
            (ENNReal.toReal_le_toReal hMgfinite.ne
              (ENNReal.add_ne_top.mpr ⟨hMφfinite.ne, (hxJ n).ne⟩)).mpr hforward
          _ = _ := ENNReal.toReal_add hMφfinite.ne (hxJ n).ne
      have hreverseReal : (M E (φ n : (ℝ^d) → ℂ) x).toReal ≤
          (M E g x).toReal + (J n x).toReal := by
        calc
          (M E (φ n : (ℝ^d) → ℂ) x).toReal ≤
              (M E g x + J n x).toReal :=
            (ENNReal.toReal_le_toReal hMφfinite.ne
              (ENNReal.add_ne_top.mpr ⟨hMgfinite.ne, (hxJ n).ne⟩)).mpr hreverse
          _ = _ := ENNReal.toReal_add hMgfinite.ne (hxJ n).ne
      rw [Real.dist_eq, abs_le]
      constructor <;> linarith
    apply tendsto_iff_dist_tendsto_zero.mpr
    apply squeeze_zero' (Eventually.of_forall fun n => dist_nonneg)
      (Eventually.of_forall hdist)
    simpa using hxJzero.add hxJzero
  have hMgToRealMeas : AEMeasurable (fun x => (M E g x).toReal) μ :=
    aemeasurable_of_tendsto_metrizable_ae'
      (fun n => by
        have hmeas : Measurable (M E (φ n : (ℝ^d) → ℂ)) := by
          change Measurable (_root_.Spherical.restrictedSphericalMaximal E
            (φ n : (ℝ^d) → ℂ))
          rw [restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal]
          exact measurable_restrictedNormalizedSphericalMaximal_schwartz E (φ n)
        exact hmeas.ennreal_toReal.aemeasurable)
      hMglim
  have hMg_eq_toReal : M E g =ᵐ[μ] fun x => ENNReal.ofReal (M E g x).toReal := by
    filter_upwards [hKfinite] with x hx
    exact (ENNReal.ofReal_toReal ((hKraw x).trans_lt hx).ne).symm
  have hMgmeas : AEMeasurable (M E g) μ :=
    hMgToRealMeas.ennreal_ofReal.congr hMg_eq_toReal.symm
  have hMmeas : AEMeasurable (M E f) μ := hMgmeas.congr hMfg.symm
  obtain ⟨Jf, hJfmeas, hJfraw, hJfbound⟩ := hlift f hf
  have hMnorm : eLpNorm (M E f) p μ ≤ ENNReal.ofReal C * eLpNorm f p μ :=
    (eLpNorm_mono_enorm hJfraw).trans hJfbound
  refine ⟨⟨hMmeas.aestronglyMeasurable, ?_⟩, hMnorm⟩
  exact hMnorm.trans_lt
    (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hf.eLpNorm_lt_top)


end

end Codex.Spherical.PowerWeights.RawLpLift
