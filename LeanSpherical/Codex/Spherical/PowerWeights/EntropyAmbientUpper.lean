      (logRadiusSet (E ∩ multiplicativeInterval c diam)) ≤ _
  calc
    Metric.externalCoveringNumber (δ / 2)
        (logRadiusSet (E ∩ multiplicativeInterval c diam)) ≤
        (C : Set ℝ).encard := hcover.externalCoveringNumber_le_encard
    _ ≤ (N : ℕ∞) := by
      simp only [C]
      exact_mod_cast Finset.card_image_le.trans (Finset.card_range N).le
    _ = (Nat.floor (2 / (δ : ℝ)) + 1 : ℕ∞) := rfl

/-- At sufficiently small scales the cardinality of the elementary grid is
bounded by the inverse square of the scale.  The deliberately spare power
is convenient for a uniform limsup estimate. -/
theorem grid_card_le_inv_square
    {δ : ℝ≥0} (hδ : 0 < δ) (hsmall : δ ≤ (1 : ℝ≥0) / 4) :
    (Nat.floor (2 / (δ : ℝ)) + 1 : ℕ∞) ≤
      ((δ : ℝ≥0∞)⁻¹) ^ (2 : ℕ) := by
  have hδreal : 0 < (δ : ℝ) := by exact_mod_cast hδ
  have hsmallreal : (δ : ℝ) ≤ (1 : ℝ) / 4 := by
    exact_mod_cast hsmall
  have hfloor : (Nat.floor (2 / (δ : ℝ)) : ℝ) ≤ 2 / (δ : ℝ) := by
    exact Nat.floor_le (by positivity)
  have hcoarse : 2 / (δ : ℝ) + 1 ≤ ((δ : ℝ)⁻¹) ^ (2 : ℕ) := by
    field_simp
    nlinarith
  have hreal : ((Nat.floor (2 / (δ : ℝ)) + 1 : ℕ) : ℝ) ≤
      ((δ : ℝ)⁻¹) ^ (2 : ℕ) := by
    calc
      ((Nat.floor (2 / (δ : ℝ)) + 1 : ℕ) : ℝ) =
          (Nat.floor (2 / (δ : ℝ)) : ℝ) + 1 := by norm_num
      _ ≤ 2 / (δ : ℝ) + 1 := by
        simpa only [add_comm] using add_le_add_right hfloor 1
      _ ≤ ((δ : ℝ)⁻¹) ^ (2 : ℕ) := hcoarse
  have hright : ENNReal.ofReal (((δ : ℝ)⁻¹) ^ (2 : ℕ)) =
      ((δ : ℝ≥0∞)⁻¹) ^ (2 : ℕ) := by
    rw [ENNReal.ofReal_pow (inv_nonneg.mpr hδreal.le),
      ENNReal.ofReal_inv_of_pos hδreal, ENNReal.ofReal_coe_nnreal]
  calc
    (Nat.floor (2 / (δ : ℝ)) + 1 : ℕ∞) =
        ENNReal.ofReal ((Nat.floor (2 / (δ : ℝ)) + 1 : ℕ) : ℝ) := by
      rw [ENNReal.ofReal_natCast]
      norm_num [Nat.cast_add]
    _ ≤ ENNReal.ofReal (((δ : ℝ)⁻¹) ^ (2 : ℕ)) :=
      ENNReal.ofReal_le_ofReal hreal
    _ = ((δ : ℝ≥0∞)⁻¹) ^ (2 : ℕ) := hright

/-- The elementary line-grid estimate gives a uniform (intentionally
non-sharp) ambient upper bound for every nonnegative Legendre parameter. -/
theorem multiplicativeLegendreAssouadProfile_le_inv_rpow_add_two
    (E : Set ℝ) {rho : ℝ} (hrho : 0 ≤ rho) {δ : ℝ≥0}
    (hδ : 0 < δ) (hsmall : δ ≤ (1 : ℝ≥0) / 4) :
    multiplicativeLegendreAssouadProfile E rho δ ≤
      ((δ : ℝ≥0∞)⁻¹) ^ (rho + 2) := by
