      apply Finset.mem_image.mpr
      refine ⟨k, ?_, rfl⟩
      exact Finset.mem_range.mpr (by
        dsimp only [N]
        exact Nat.lt_succ_of_le hk_le)
    refine ⟨logRadius c - (1 : ℝ) / 2 + (k : ℝ) * q, hkC, ?_⟩
    change edist (logRadius r)
      (logRadius c - (1 : ℝ) / 2 + (k : ℝ) * q) ≤ ↑(δ / 2)
    rw [edist_dist]
    rw [ENNReal.ofReal_le_coe, Real.dist_eq]
