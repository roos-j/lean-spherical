/-- A local multiplicative interval of diameter at most one has an explicit
finite grid cover at every positive scale. -/
theorem localMultiplicativeEntropy_le_grid
    (E : Set ℝ) (c : PositiveRadius) (diam δ : ℝ≥0)
    (hdiam : diam ≤ 1) (hδ : 0 < δ) :
    localMultiplicativeEntropy E c diam δ ≤
      (Nat.floor (2 / (δ : ℝ)) + 1 : ℕ∞) := by
  let q : ℝ := (δ : ℝ) / 2
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  let N : ℕ := Nat.floor (2 / (δ : ℝ)) + 1
  let C : Finset ℝ := (Finset.range N).image
    (fun k : ℕ => logRadius c - (1 : ℝ) / 2 + (k : ℝ) * q)
  have hcover : Metric.IsCover (δ / 2)
      (logRadiusSet (E ∩ multiplicativeInterval c diam)) (C : Set ℝ) := by
    intro u hu
    rcases hu with ⟨r, hr, rfl⟩
    have hrint := hr.2
    change 0 < (r : ℝ) ∧
      |logRadius r - logRadius c| ≤ (diam : ℝ) / 2 at hrint
    have hshift_nonneg : 0 ≤ logRadius r - logRadius c + (1 : ℝ) / 2 := by
      have hbound : |logRadius r - logRadius c| ≤ (diam : ℝ) / 2 := hrint.2
      have hdiam' : (diam : ℝ) / 2 ≤ (1 : ℝ) / 2 := by
        exact div_le_div_of_nonneg_right (by exact_mod_cast hdiam) (by norm_num)
      linarith [neg_le.mp (abs_le.mp hbound).1, hdiam']
    let k : ℕ := Nat.floor ((logRadius r - logRadius c + (1 : ℝ) / 2) / q)
    have hkfloor : (k : ℝ) ≤
        (logRadius r - logRadius c + (1 : ℝ) / 2) / q := by
      dsimp only [k]
      exact Nat.floor_le (div_nonneg hshift_nonneg hq.le)
    have hkupper :
        (logRadius r - logRadius c + (1 : ℝ) / 2) / q < (k : ℝ) + 1 := by
      dsimp only [k]
      exact Nat.lt_floor_add_one _
    have hshift_upper : logRadius r - logRadius c + (1 : ℝ) / 2 ≤ 1 := by
      have hbound : |logRadius r - logRadius c| ≤ (diam : ℝ) / 2 := hrint.2
      have hdiam' : (diam : ℝ) / 2 ≤ (1 : ℝ) / 2 := by
        exact div_le_div_of_nonneg_right (by exact_mod_cast hdiam) (by norm_num)
      linarith [(abs_le.mp hbound).2, hdiam']
    have hk_le : k ≤ Nat.floor (2 / (δ : ℝ)) := by
      apply Nat.floor_le_floor
      calc
        (logRadius r - logRadius c + (1 : ℝ) / 2) / q ≤ 1 / q :=
          (div_le_div_of_nonneg_right hshift_upper hq.le)
        _ = 2 / (δ : ℝ) := by
          dsimp only [q]
          field_simp
