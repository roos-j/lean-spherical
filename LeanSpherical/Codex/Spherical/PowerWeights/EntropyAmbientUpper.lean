        logRadius r - (logRadius c - (1 : ℝ) / 2 + (k : ℝ) * q) := by
      have hmul : (k : ℝ) * q ≤
          logRadius r - logRadius c + (1 : ℝ) / 2 :=
        (le_div_iff₀ hq).mp hkfloor
      linarith
    rw [abs_of_nonneg hdiff_nonneg]
    have hdiff_le :
        logRadius r - (logRadius c - (1 : ℝ) / 2 + (k : ℝ) * q) ≤ q := by
      have := (div_lt_iff₀ hq).mp hkupper
      linarith
    simpa only [q, NNReal.coe_div, NNReal.coe_ofNat] using hdiff_le
