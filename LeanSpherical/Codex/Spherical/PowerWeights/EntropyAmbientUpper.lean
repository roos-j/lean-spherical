  apply iSup_le
  intro c
  apply iSup_le
  intro diam
  have hδdiam : (δ : ℝ≥0∞) ≤ (diam.1 : ℝ≥0∞) := by
    exact_mod_cast diam.2.1
  have hfactor : ((diam.1 : ℝ≥0∞) ^ (-rho)) ≤
      ((δ : ℝ≥0∞)⁻¹) ^ rho := by
    calc
      ((diam.1 : ℝ≥0∞) ^ (-rho)) =
          (((diam.1 : ℝ≥0∞) ^ rho)⁻¹) := ENNReal.rpow_neg _ _
      _ = ((diam.1 : ℝ≥0∞)⁻¹) ^ rho := (ENNReal.inv_rpow _ _).symm
      _ ≤ ((δ : ℝ≥0∞)⁻¹) ^ rho :=
        ENNReal.rpow_le_rpow (ENNReal.inv_le_inv' hδdiam) hrho
  have hgridfirst : (localMultiplicativeEntropy E c diam.1 δ : ℝ≥0∞) ≤
      (Nat.floor (2 / (δ : ℝ)) + 1 : ℕ∞) := by
    exact_mod_cast localMultiplicativeEntropy_le_grid E c diam.1 δ diam.2.2 hδ
  have hgrid : (localMultiplicativeEntropy E c diam.1 δ : ℝ≥0∞) ≤
      ((δ : ℝ≥0∞)⁻¹) ^ (2 : ℕ) :=
    hgridfirst.trans (grid_card_le_inv_square hδ hsmall)
  calc
    ((diam.1 : ℝ≥0∞) ^ (-rho)) *
        localMultiplicativeEntropy E c diam.1 δ ≤
        (((δ : ℝ≥0∞)⁻¹) ^ rho) *
          (((δ : ℝ≥0∞)⁻¹) ^ (2 : ℕ)) :=
      mul_le_mul hfactor hgrid bot_le (by positivity)
    _ = ((δ : ℝ≥0∞)⁻¹) ^ (rho + 2) := by
      rw [ENNReal.rpow_add_of_nonneg rho (2 : ℝ) hrho (by norm_num)]
      norm_num

/-- A direct inverse-power bound at a positive scale bounds its logarithmic
entropy quotient. -/
theorem entropyLogQuotient_le_of_le_inv_rpow
    {N : ℝ≥0∞} {δ : ℝ≥0} {s : ℝ}
    (hδ0 : 0 < δ) (hδ1 : δ < 1)
    (hN : N ≤ ((δ : ℝ≥0∞)⁻¹) ^ s) :
    entropyLogQuotient N δ ≤ (s : EReal) := by
  have hδreal0 : 0 < (δ : ℝ) := by exact_mod_cast hδ0
  have hδreal1 : (δ : ℝ) < 1 := by exact_mod_cast hδ1
  have hloginv : 0 < Real.log ((δ : ℝ)⁻¹) := by
    apply Real.log_pos
    exact (one_lt_inv₀ hδreal0).mpr hδreal1
  let D : EReal := (Real.log ((δ : ℝ)⁻¹) : EReal)
  have hDpos : 0 < D := by
    dsimp [D]
    exact_mod_cast hloginv
  have hDtop : D ≠ ⊤ := by
    dsimp [D]
    exact EReal.coe_ne_top _
  have hDlog : D = ENNReal.log ((δ : ℝ≥0∞)⁻¹) := by
    dsimp [D]
    rw [ENNReal.log_inv, ENNReal.log_of_nnreal hδ0.ne', Real.log_inv]
    norm_cast
  have hlog : ENNReal.log N ≤ (s : EReal) * D := by
    calc
      ENNReal.log N ≤ ENNReal.log (((δ : ℝ≥0∞)⁻¹) ^ s) :=
        ENNReal.log_le_log hN
      _ = (s : EReal) * ENNReal.log ((δ : ℝ≥0∞)⁻¹) := ENNReal.log_rpow
      _ = (s : EReal) * D := by rw [hDlog]
  apply (EReal.div_le_iff_le_mul hDpos hDtop).mpr
  simpa only [entropyLogQuotient, D, mul_comm] using hlog

