/-- After reflection through its axial point, the outer support of the cutoff
is a genuine thin shell cap.  The deliberately generous radius `6 * s`
keeps the proof to elementary quadratic estimates. -/
theorem sub_northRadialCapOuter_mem_thinShellCap
    (n : ℕ) {a s δ : ℝ} (ha : 0 < a) (hs : 0 < s)
    (hδs : δ ≤ s) (hsbound : 24 * s ≤ a)
    {y : Euclidean (n + 1)} (hy : y ∈ northRadialCapOuter n a s δ) :
    joinCoordinates n (0, a) - y ∈
      thinShellCap (n + 1) (joinCoordinates n (0, a)) a (6 * s) (2 * δ) := by
  rcases hy with ⟨hyz, hyrad, hyvert⟩
  have hnormlo : a - 2 * δ < ‖y‖ := by
    rw [abs_lt] at hyrad
    linarith [hyrad.1]
  have htpos : 0 < (succCoordinates n y).2 := by
    rw [abs_lt] at hyvert
    linarith [hyvert.1]
  have hnormsq := norm_sq_succCoordinates n y
  have hzsq : ‖(succCoordinates n y).1‖ ^ 2 < (2 * s) ^ 2 :=
    (sq_lt_sq₀ (norm_nonneg _) (by positivity)).mpr hyz
  have hnloSq : (a - 2 * δ) ^ 2 < ‖y‖ ^ 2 := by
    have hlow : 0 ≤ a - 2 * δ := by nlinarith
    exact (sq_lt_sq₀ hlow (norm_nonneg _)).mpr hnormlo
  have htSq : (a / 2) ^ 2 < (succCoordinates n y).2 ^ 2 := by
    nlinarith
  have htlow : a / 2 < (succCoordinates n y).2 := by
    nlinarith [sq_nonneg ((succCoordinates n y).2 + a / 2)]
  have htlen : (succCoordinates n y).2 ≤ ‖y‖ := by
    calc
      (succCoordinates n y).2 ≤ |(succCoordinates n y).2| := le_abs_self _
      _ ≤ ‖y‖ := abs_snd_succCoordinates_le_norm n y
  have hgapnonneg : 0 ≤ ‖y‖ - (succCoordinates n y).2 := sub_nonneg.mpr htlen
  have hsum : a / 2 ≤ ‖y‖ + (succCoordinates n y).2 := by
    nlinarith [norm_nonneg y]
  have hprod : (‖y‖ - (succCoordinates n y).2) *
      (‖y‖ + (succCoordinates n y).2) = ‖(succCoordinates n y).1‖ ^ 2 := by
    nlinarith
  have hgap : ‖y‖ - (succCoordinates n y).2 ≤ s := by
    by_contra hnot
    have hsl : s < ‖y‖ - (succCoordinates n y).2 := lt_of_not_ge hnot
    have hsumpos : 0 < ‖y‖ + (succCoordinates n y).2 := by linarith
    have hmul : s * (‖y‖ + (succCoordinates n y).2) <
        (‖y‖ - (succCoordinates n y).2) * (‖y‖ + (succCoordinates n y).2) :=
      mul_lt_mul_of_pos_right hsl hsumpos
    have hleft : s * (a / 2) ≤ s * (‖y‖ + (succCoordinates n y).2) := by
      gcongr
    have hsmall : (2 * s) ^ 2 ≤ s * (a / 2) := by nlinarith
    nlinarith
  have htdev : |a - (succCoordinates n y).2| < 3 * s := by
    calc
      |a - (succCoordinates n y).2| =
          |(a - ‖y‖) + (‖y‖ - (succCoordinates n y).2)| := by congr 1 <;> ring
      _ ≤ |a - ‖y‖| + |‖y‖ - (succCoordinates n y).2| := abs_add_le _ _
      _ = |‖y‖ - a| + (‖y‖ - (succCoordinates n y).2) := by
        rw [abs_sub_comm, abs_of_nonneg hgapnonneg]
      _ < 2 * δ + s := add_lt_add_of_lt_of_le hyrad hgap
      _ ≤ 3 * s := by linarith
  have hlocal : ‖joinCoordinates n (0, a) - y‖ < 6 * s := by
    have hcoords : succCoordinates n (joinCoordinates n (0, a) - y) =
        (-(succCoordinates n y).1, a - (succCoordinates n y).2) := by
      rw [succCoordinates_sub, succCoordinates_joinCoordinates]
      apply Prod.ext <;> simp
    calc
      ‖joinCoordinates n (0, a) - y‖ ≤
          ‖(succCoordinates n (joinCoordinates n (0, a) - y)).1‖ +
            |(succCoordinates n (joinCoordinates n (0, a) - y)).2| :=
        norm_le_succCoordinates n _
      _ = ‖(succCoordinates n y).1‖ + |a - (succCoordinates n y).2| := by
        rw [hcoords]
        simp
      _ < 2 * s + 3 * s := add_lt_add hyz htdev
      _ < 6 * s := by linarith
  constructor
  · simpa only [mem_ball, dist_zero_right] using hlocal
  · rw [show joinCoordinates n (0, a) - (joinCoordinates n (0, a) - y) = y by abel]
    exact hyrad

/-- The outer support has the required `s ^ n * δ` volume scale. -/
theorem volume_northRadialCapOuter_le
    (n : ℕ) {a s δ : ℝ} (ha : 0 < a) (hs : 0 < s) (hδ : 0 < δ)
    (hδs : δ ≤ s) (hsbound : 24 * s ≤ a) :
    volume (northRadialCapOuter n a s δ) ≤
      volume (ball (0 : Euclidean n) (6 * s)) * ENNReal.ofReal (12 * δ) := by
  let c : Euclidean (n + 1) := joinCoordinates n (0, a)
  let F : Euclidean (n + 1) → Euclidean (n + 1) := fun y => c - y
  let S : Set (Euclidean (n + 1)) := thinShellCap (n + 1) c a (6 * s) (2 * δ)
  have hc : ‖c‖ = a := by
    dsimp only [c]
    have hsq := norm_sq_succCoordinates n (joinCoordinates n (0, a))
    rw [succCoordinates_joinCoordinates] at hsq
    norm_num at hsq
    nlinarith [norm_nonneg (joinCoordinates n (0, a))]
  have hs6 : 0 < 6 * s := by positivity
  have hcsmall : 6 * s < ‖c‖ := by rw [hc]; nlinarith
  have hsmall : 4 * (6 * s) ≤ a := by nlinarith
  have hδ2 : 0 < 2 * δ := by positivity
  have hδr : 2 * δ ≤ a / 4 := by nlinarith
  have hS : MeasurableSet S := by
    exact measurableSet_thinShellCap (n + 1) c a (6 * s) (2 * δ)
  have hF : Measurable F := by
    dsimp only [F]
    fun_prop
  have hpre : northRadialCapOuter n a s δ ⊆ F ⁻¹' S := by
    intro y hy
    change c - y ∈ S
    dsimp only [S, c]
    exact sub_northRadialCapOuter_mem_thinShellCap n ha hs hδs hsbound hy
  have hpres : MeasurePreserving F volume volume := by
    dsimp only [F]
    exact MeasureTheory.Measure.measurePreserving_sub_left volume c
  calc
    volume (northRadialCapOuter n a s δ) ≤ volume (F ⁻¹' S) := measure_mono hpre
    _ = Measure.map F volume S := (Measure.map_apply hF hS).symm
    _ = volume S := by rw [hpres.map_eq]
    _ ≤ volume (ball (0 : Euclidean n) (6 * s)) * ENNReal.ofReal (6 * (2 * δ)) :=
      volume_thinShellCap_le n c ha hs6 hcsmall hsmall hδ2 hδr
    _ = volume (ball (0 : Euclidean n) (6 * s)) * ENNReal.ofReal (12 * δ) := by
      ring_nf

/-- For a nonpositive power, the weight on the outer support is controlled by
its inner radial edge. -/
theorem powerWeightedVolume_northRadialCapOuter_le_of_nonpos
    (n : ℕ) {α a s δ : ℝ} (hα : α ≤ 0) (haδ : 0 < a - 2 * δ) :
    powerWeightedVolume (n + 1) α (northRadialCapOuter n a s δ) ≤
      (ENNReal.ofReal (a - 2 * δ)) ^ α * volume (northRadialCapOuter n a s δ) := by
  let D : Set (Euclidean (n + 1)) := northRadialCapOuter n a s δ
  have hD : MeasurableSet D := measurableSet_northRadialCapOuter n a s δ
  have hpoint (y : Euclidean (n + 1)) (hy : y ∈ D) :
      radialPowerWeight (n + 1) α y ≤ (ENNReal.ofReal (a - 2 * δ)) ^ α := by
    rcases hy with ⟨_, hyrad, _⟩
    have hnorm : a - 2 * δ ≤ ‖y‖ := by
      rw [abs_lt] at hyrad
      linarith [hyrad.1]
    exact radialPowerWeight_le_of_norm_lower hα haδ hnorm
  calc
    powerWeightedVolume (n + 1) α D =
        ∫⁻ y in D, radialPowerWeight (n + 1) α y ∂volume := by
      rw [powerWeightedVolume, withDensity_apply _ hD]
    _ ≤ ∫⁻ _y in D, (ENNReal.ofReal (a - 2 * δ)) ^ α ∂volume := by
      exact setLIntegral_mono measurable_const hpoint
    _ = (ENNReal.ofReal (a - 2 * δ)) ^ α * volume D := setLIntegral_const _ _

/-- The radial-cap cutoff has its weighted input norm controlled by the
literal outer support. -/
theorem eLpNorm_northRadialCap_cutoff_le
    (n : ℕ) {p α a s δ : ℝ} (hp0 : ENNReal.ofReal p ≠ 0)
    (g : Euclidean (n + 1) → ℝ) (f : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hfg : ∀ y, f y = (g y : ℂ))
    (hgnonneg : ∀ y, 0 ≤ g y) (hgle_one : ∀ y, g y ≤ 1)
    (hsupport : ∀ y ∉ northRadialCapOuter n a s δ, g y = 0) :
    eLpNorm (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p)
        (powerWeightedVolume (n + 1) α) ≤
      (powerWeightedVolume (n + 1) α (northRadialCapOuter n a s δ)) ^
        (1 / (ENNReal.ofReal p).toReal) := by
  let D : Set (Euclidean (n + 1)) := northRadialCapOuter n a s δ
  have hD : MeasurableSet D := measurableSet_northRadialCapOuter n a s δ
  calc
    eLpNorm (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p)
        (powerWeightedVolume (n + 1) α) ≤
      eLpNorm (D.indicator (fun _ : Euclidean (n + 1) => (1 : ℂ)))
        (ENNReal.ofReal p) (powerWeightedVolume (n + 1) α) := by
          apply eLpNorm_mono
          intro y
          by_cases hy : y ∈ D
          · rw [indicator_of_mem hy, hfg]
            rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hgnonneg y)]
            simpa using hgle_one y
          · rw [indicator_of_notMem hy, hfg, hsupport y (by simpa only [D] using hy)]
            norm_num
    _ = (powerWeightedVolume (n + 1) α D) ^
          (1 / (ENNReal.ofReal p).toReal) := by
      rw [eLpNorm_indicator_const hD hp0 ENNReal.ofReal_ne_top]
      norm_num [enorm]
    _ = (powerWeightedVolume (n + 1) α (northRadialCapOuter n a s δ)) ^
          (1 / (ENNReal.ofReal p).toReal) := by rfl

/-- A bounded radial-cap cutoff is an admissible weighted input as soon as
its explicit outer support has finite weighted volume.  This is kept beside
the cutoff rather than rebuilt in each lower-test specialization. -/
theorem schwartz_memLp_of_northRadialCapOuter_support
    (n : ℕ) {p α a s δ : ℝ}
    (g : Euclidean (n + 1) → ℝ) (f : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hfg : ∀ y, f y = (g y : ℂ))
    (hgnonneg : ∀ y, 0 ≤ g y) (hgle_one : ∀ y, g y ≤ 1)
    (hsupport : ∀ y ∉ northRadialCapOuter n a s δ, g y = 0)
    (hfinite : powerWeightedVolume (n + 1) α
      (northRadialCapOuter n a s δ) < (∞ : ℝ≥0∞)) :
    MemLp (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p)
      (powerWeightedVolume (n + 1) α) := by
  let D : Set (Euclidean (n + 1)) := northRadialCapOuter n a s δ
  have hD : MeasurableSet D := measurableSet_northRadialCapOuter n a s δ
  letI : IsFiniteMeasure ((powerWeightedVolume (n + 1) α).restrict D) :=
    ⟨by simpa only [Measure.restrict_apply_univ] using hfinite⟩
  have hmem_restrict : MemLp (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p)
      ((powerWeightedVolume (n + 1) α).restrict D) := by
    apply MemLp.of_bound (f.continuous.aestronglyMeasurable.restrict) 1
    filter_upwards with y
    rw [hfg, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hgnonneg y)]
    exact hgle_one y
  have hmem_indicator : MemLp (D.indicator (f : Euclidean (n + 1) → ℂ))
      (ENNReal.ofReal p) (powerWeightedVolume (n + 1) α) :=
    (memLp_indicator_iff_restrict hD).mpr hmem_restrict
  apply (memLp_congr_ae ?_).mp hmem_indicator
  filter_upwards with y
  by_cases hy : y ∈ D
  · rw [Set.indicator_of_mem hy]
  · rw [Set.indicator_of_notMem hy, hfg,
      hsupport y (by simpa only [D] using hy)]
    norm_num

end

end Codex.Spherical.PowerWeights.SmallDiameterCutoff