decomposition can invoke this lemma term-by-term without introducing another
maximal-operator wrapper. -/
theorem eLpNorm_finite_annular_shell_relativeBandpass_sum_le_of_moments
    {d : Nat} {p α : ℝ} (hp : 1 ≤ p) (E : Set ℝ)
    (phi : SchwartzMap (Euclidean d) ℂ) (f : SchwartzMap (Euclidean d) ℂ)
    (K J : Finset ℕ) (s : ℕ → ℝ)
    (hAmeas : ∀ k ∈ K,
      MeasurableSet (euclideanAnnulus d (s k / 4) (s k / 2)))
    (hband_meas : ∀ j ∈ J,
      Measurable (fun x : Euclidean d =>
        (restrictedRelativeBandpassSphericalMaximal d E phi j f x).toReal))
    (Q : ℕ → ℕ → ENNReal)
    (hQ : ∀ k ∈ K, ∀ j ∈ J,
      (∫⁻ x in euclideanAnnulus d (s k / 4) (s k / 2),
        ENNReal.ofReal
          ((restrictedRelativeBandpassSphericalMaximal d E phi j f x).toReal ^ p)
          ∂powerWeightedVolume d α) ≤ Q k j) :
    eLpNorm
      ((⋃ k ∈ (K : Set ℕ), euclideanAnnulus d (s k / 4) (s k / 2)).indicator
        (fun x : Euclidean d => ∑ j ∈ J,
          (restrictedRelativeBandpassSphericalMaximal d E phi j f x).toReal))
      (ENNReal.ofReal p) (powerWeightedVolume d α) ≤
      ∑ k ∈ K, ∑ j ∈ J, (Q k j) ^ p⁻¹ := by
  let μ : Measure (Euclidean d) := powerWeightedVolume d α
  let A : ℕ → Set (Euclidean d) := fun k =>
    euclideanAnnulus d (s k / 4) (s k / 2)
  let M : ℕ → Euclidean d → ℝ := fun j x =>
    (restrictedRelativeBandpassSphericalMaximal d E phi j f x).toReal
  let g : ℕ × ℕ → Euclidean d → ℝ := fun kj =>
    (A kj.1).indicator (M kj.2)
  let S : Finset (ℕ × ℕ) := K.product J
  let q : ℕ × ℕ → ENNReal := fun kj => Q kj.1 kj.2
  have hgmeas : ∀ ij ∈ S, AEStronglyMeasurable (g ij) μ := by
    intro ij hij
    have hik : ij.1 ∈ K := (Finset.mem_product.mp hij).1
    have hij' : ij.2 ∈ J := (Finset.mem_product.mp hij).2
    exact ((hband_meas ij.2 hij').indicator (hAmeas ij.1 hik)).aestronglyMeasurable
  have hgnonneg : ∀ ij ∈ S, ∀ x : Euclidean d, 0 ≤ g ij x := by
    intro ij hij x
    dsimp only [g]
    by_cases hx : x ∈ A ij.1
    · rw [Set.indicator_of_mem hx]
      exact ENNReal.toReal_nonneg
    · simp [hx]
  have hq : ∀ ij ∈ S,
      (∫⁻ x, ENNReal.ofReal ((g ij x) ^ p) ∂μ) ≤ q ij := by
    intro ij hij
    have hik : ij.1 ∈ K := (Finset.mem_product.mp hij).1
    have hij' : ij.2 ∈ J := (Finset.mem_product.mp hij).2
    have hpow : (fun x : Euclidean d => ENNReal.ofReal ((g ij x) ^ p)) =
        (A ij.1).indicator (fun x => ENNReal.ofReal ((M ij.2 x) ^ p)) := by
      funext x
      by_cases hx : x ∈ A ij.1
      · simp [g, hx]
      · simp [g, hx, (ne_of_gt (lt_of_lt_of_le zero_lt_one hp))]
    rw [hpow, lintegral_indicator (hAmeas ij.1 hik)]
    simpa only [μ, A, M, q] using hQ ij.1 hik ij.2 hij'
  have hsum := eLpNorm_finset_sum_real_nonneg_le_of_lintegral_bounds_on
    μ hp g S hgmeas hgnonneg q hq
  have hpoint (x : Euclidean d) :
      (⋃ k ∈ (K : Set ℕ), A k).indicator (fun x => ∑ j ∈ J, M j x) x ≤
        ∑ ij ∈ S, g ij x := by
    by_cases hx : x ∈ ⋃ k ∈ (K : Set ℕ), A k
    · rw [Set.indicator_of_mem hx]
      rcases Set.mem_iUnion.mp hx with ⟨k, hx⟩
      rcases Set.mem_iUnion.mp hx with ⟨hk, hxA⟩
      have hk' : k ∈ K := by simpa using hk
      change (∑ j ∈ J, M j x) ≤ ∑ ij ∈ K.product J, g ij x
      calc
        (∑ j ∈ J, M j x) ≤ ∑ j ∈ J, ∑ k' ∈ K, (A k').indicator (M j) x := by
          apply Finset.sum_le_sum
          intro j hj
          have hsingle : (A k).indicator (M j) x ≤
              ∑ k' ∈ K, (A k').indicator (M j) x := by
            exact Finset.single_le_sum
              (fun k' hk'' =>
                hgnonneg (k', j) (Finset.mem_product.mpr ⟨hk'', hj⟩) x)
              hk'
          simpa only [Set.indicator_of_mem hxA] using hsingle
        _ = ∑ k' ∈ K, ∑ j ∈ J, (A k').indicator (M j) x := by
          exact Finset.sum_comm
        _ = ∑ ij ∈ S, g ij x := by
          change (∑ k' ∈ K, ∑ j ∈ J, (A k').indicator (M j) x) =
            ∑ ij ∈ K.product J, g ij x
          change (∑ k' ∈ K, ∑ j ∈ J, (A k').indicator (M j) x) =
            ∑ ij ∈ K.product J, (A ij.1).indicator (M ij.2) x
          exact (Finset.sum_product K J
            (fun ij => (A ij.1).indicator (M ij.2) x)).symm
    · rw [Set.indicator_of_notMem hx]
      exact Finset.sum_nonneg fun ij hij => hgnonneg ij hij x
  have hmono : eLpNorm
      ((⋃ k ∈ (K : Set ℕ), A k).indicator (fun x => ∑ j ∈ J, M j x))
      (ENNReal.ofReal p) μ ≤
      eLpNorm (fun x => ∑ ij ∈ S, g ij x) (ENNReal.ofReal p) μ := by
    apply eLpNorm_mono
    intro x
    rw [Real.norm_eq_abs,
      abs_of_nonneg (by
        by_cases hx : x ∈ ⋃ k ∈ (K : Set ℕ), A k
        · rw [Set.indicator_of_mem hx]
          exact Finset.sum_nonneg fun j hj => ENNReal.toReal_nonneg
        · change 0 ≤
            (⋃ k ∈ (K : Set ℕ), A k).indicator (fun x => ∑ j ∈ J, M j x) x
          rw [Set.indicator_of_notMem hx]),
      Real.norm_eq_abs,
      abs_of_nonneg (Finset.sum_nonneg fun ij hij => hgnonneg ij hij x)]
    exact hpoint x
  calc
    eLpNorm
        ((⋃ k ∈ (K : Set ℕ), euclideanAnnulus d (s k / 4) (s k / 2)).indicator
          (fun x : Euclidean d => ∑ j ∈ J,
            (restrictedRelativeBandpassSphericalMaximal d E phi j f x).toReal))
        (ENNReal.ofReal p) (powerWeightedVolume d α) =
        eLpNorm
          ((⋃ k ∈ (K : Set ℕ), A k).indicator (fun x => ∑ j ∈ J, M j x))
          (ENNReal.ofReal p) μ := by rfl
    _ ≤ eLpNorm (fun x => ∑ ij ∈ S, g ij x) (ENNReal.ofReal p) μ := hmono
    _ ≤ ∑ ij ∈ S, (q ij) ^ p⁻¹ := hsum
    _ = ∑ k ∈ K, ∑ j ∈ J, (Q k j) ^ p⁻¹ := by
      change (∑ ij ∈ K.product J, (Q ij.1 ij.2) ^ p⁻¹) = _
      exact Finset.sum_product K J (fun ij => (Q ij.1 ij.2) ^ p⁻¹)

/-- The finite reassembly has a uniform geometric form.  The two ratios are
kept separate because the local proof gets one from spatial shells and one
from relative frequencies.  The finiteness conclusion is what permits the
finite cutoff bounds to pass to the limiting cutoff. -/
theorem eLpNorm_finite_annular_shell_relativeBandpass_sum_le_of_geometric_moments
    {d : Nat} {p α : ℝ} (hp : 1 ≤ p) (E : Set ℝ)
    (phi : SchwartzMap (Euclidean d) ℂ) (f : SchwartzMap (Euclidean d) ℂ)
    (K J : Finset ℕ) (s : ℕ → ℝ)
    (hAmeas : ∀ k ∈ K,
      MeasurableSet (euclideanAnnulus d (s k / 4) (s k / 2)))
    (hband_meas : ∀ j ∈ J,
      Measurable (fun x : Euclidean d =>
        (restrictedRelativeBandpassSphericalMaximal d E phi j f x).toReal))
    (Q : ℕ → ℕ → ENNReal)
    (hQ : ∀ k ∈ K, ∀ j ∈ J,
      (∫⁻ x in euclideanAnnulus d (s k / 4) (s k / 2),
        ENNReal.ofReal
          ((restrictedRelativeBandpassSphericalMaximal d E phi j f x).toReal ^ p)
          ∂powerWeightedVolume d α) ≤ Q k j)
    (A I ρ σ : ENNReal) (hAtop : A ≠ ⊤) (hItop : I ≠ ⊤)
    (hρ : ρ < 1) (hσ : σ < 1)
    (hgeometric : ∀ k ∈ K, ∀ j ∈ J,
      (Q k j) ^ p⁻¹ ≤ A * ρ ^ k * σ ^ j * I) :
    eLpNorm
      ((⋃ k ∈ (K : Set ℕ), euclideanAnnulus d (s k / 4) (s k / 2)).indicator
        (fun x : Euclidean d => ∑ j ∈ J,
          (restrictedRelativeBandpassSphericalMaximal d E phi j f x).toReal))
      (ENNReal.ofReal p) (powerWeightedVolume d α) ≤
        A * (1 - ρ)⁻¹ * (1 - σ)⁻¹ * I ∧
      A * (1 - ρ)⁻¹ * (1 - σ)⁻¹ * I ≠ ⊤ := by
  have hbase := eLpNorm_finite_annular_shell_relativeBandpass_sum_le_of_moments
    hp E phi f K J s hAmeas hband_meas Q hQ
  have hsum_geometric :
      (∑ k ∈ K, ∑ j ∈ J, (Q k j) ^ p⁻¹) ≤
        ∑ k ∈ K, ∑ j ∈ J, A * ρ ^ k * σ ^ j * I := by
    apply Finset.sum_le_sum
    intro k hk
    apply Finset.sum_le_sum
    intro j hj
    exact hgeometric k hk j hj
  have hsum_formula :
      (∑ k ∈ K, ∑ j ∈ J, A * ρ ^ k * σ ^ j * I) =
        (A * I) * (∑ k ∈ K, ρ ^ k) * (∑ j ∈ J, σ ^ j) := by
    calc
      (∑ k ∈ K, ∑ j ∈ J, A * ρ ^ k * σ ^ j * I) =
          ∑ k ∈ K, (A * ρ ^ k * I) * (∑ j ∈ J, σ ^ j) := by
            apply Finset.sum_congr rfl
            intro k hk
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro j hj
            ring
      _ = (∑ k ∈ K, A * ρ ^ k * I) * (∑ j ∈ J, σ ^ j) := by
            rw [Finset.sum_mul]
      _ = (A * I) * (∑ k ∈ K, ρ ^ k) * (∑ j ∈ J, σ ^ j) := by
            congr 1
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro k hk
            ring
  have hsumρ : (∑ k ∈ K, ρ ^ k) ≤ (1 - ρ)⁻¹ := by
    calc
      (∑ k ∈ K, ρ ^ k) ≤ ∑' k : ℕ, ρ ^ k := ENNReal.sum_le_tsum K
      _ = (1 - ρ)⁻¹ := ENNReal.tsum_geometric ρ
  have hsumσ : (∑ j ∈ J, σ ^ j) ≤ (1 - σ)⁻¹ := by
    calc
      (∑ j ∈ J, σ ^ j) ≤ ∑' j : ℕ, σ ^ j := ENNReal.sum_le_tsum J
      _ = (1 - σ)⁻¹ := ENNReal.tsum_geometric σ
  have hseries_bound :
      (A * I) * (∑ k ∈ K, ρ ^ k) * (∑ j ∈ J, σ ^ j) ≤
        A * (1 - ρ)⁻¹ * (1 - σ)⁻¹ * I := by
    calc
      (A * I) * (∑ k ∈ K, ρ ^ k) * (∑ j ∈ J, σ ^ j) ≤
          (A * I) * (1 - ρ)⁻¹ * (1 - σ)⁻¹ := by
            gcongr
      _ = A * (1 - ρ)⁻¹ * (1 - σ)⁻¹ * I := by ring
  have hρtop : (1 - ρ)⁻¹ ≠ ⊤ := by
    apply ENNReal.inv_ne_top.mpr
    exact (tsub_pos_iff_lt.mpr hρ).ne'
  have hσtop : (1 - σ)⁻¹ ≠ ⊤ := by
    apply ENNReal.inv_ne_top.mpr
    exact (tsub_pos_iff_lt.mpr hσ).ne'
  constructor
  · calc
      eLpNorm
          ((⋃ k ∈ (K : Set ℕ), euclideanAnnulus d (s k / 4) (s k / 2)).indicator
            (fun x : Euclidean d => ∑ j ∈ J,
              (restrictedRelativeBandpassSphericalMaximal d E phi j f x).toReal))
          (ENNReal.ofReal p) (powerWeightedVolume d α) ≤
          ∑ k ∈ K, ∑ j ∈ J, (Q k j) ^ p⁻¹ := hbase
      _ ≤ ∑ k ∈ K, ∑ j ∈ J, A * ρ ^ k * σ ^ j * I := hsum_geometric
      _ = (A * I) * (∑ k ∈ K, ρ ^ k) * (∑ j ∈ J, σ ^ j) := hsum_formula
      _ ≤ A * (1 - ρ)⁻¹ * (1 - σ)⁻¹ * I := hseries_bound
  · exact ENNReal.mul_ne_top
      (ENNReal.mul_ne_top (ENNReal.mul_ne_top hAtop hρtop) hσtop) hItop

/-- Literal moving bands are subadditive over a finite input-annulus
decomposition.  The distinguished first summand avoids any artificial
zero-input convention and is exactly the form used when the central annulus
is split into finitely many separated pieces. -/
theorem toReal_restrictedRelativeBandpassSphericalMaximal_add_finset_sum_le
    {d : Nat} (hd : 0 < d) (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2)
    (phi f₀ : SchwartzMap (Euclidean d) ℂ)
    (f : ℕ → SchwartzMap (Euclidean d) ℂ) (S : Finset ℕ)
    (j : ℕ) (x : Euclidean d) :
    (restrictedRelativeBandpassSphericalMaximal d E phi j
      (f₀ + ∑ i ∈ S, f i) x).toReal ≤
        (restrictedRelativeBandpassSphericalMaximal d E phi j f₀ x).toReal +
          ∑ i ∈ S,
            (restrictedRelativeBandpassSphericalMaximal d E phi j (f i) x).toReal := by
  induction S using Finset.induction_on with
  | empty => simp
  | insert a S ha hS =>
      rw [Finset.sum_insert ha]
      have hadd := toReal_restrictedRelativeBandpassSphericalMaximal_add_le
        hd E hE phi (f₀ + ∑ i ∈ S, f i) (f a) j x
      calc
        (restrictedRelativeBandpassSphericalMaximal d E phi j
            (f₀ + (f a + ∑ i ∈ S, f i)) x).toReal =
            (restrictedRelativeBandpassSphericalMaximal d E phi j
              ((f₀ + ∑ i ∈ S, f i) + f a) x).toReal := by
              congr 2
              abel
        _ ≤ (restrictedRelativeBandpassSphericalMaximal d E phi j
              (f₀ + ∑ i ∈ S, f i) x).toReal +
            (restrictedRelativeBandpassSphericalMaximal d E phi j (f a) x).toReal := hadd
        _ ≤ ((restrictedRelativeBandpassSphericalMaximal d E phi j f₀ x).toReal +
              ∑ i ∈ S,
                (restrictedRelativeBandpassSphericalMaximal d E phi j (f i) x).toReal) +
            (restrictedRelativeBandpassSphericalMaximal d E phi j (f a) x).toReal :=
              add_le_add hS le_rfl
        _ = (restrictedRelativeBandpassSphericalMaximal d E phi j f₀ x).toReal +
            ((restrictedRelativeBandpassSphericalMaximal d E phi j (f a) x).toReal +
              ∑ i ∈ S,
                (restrictedRelativeBandpassSphericalMaximal d E phi j (f i) x).toReal) := by
              ring
        _ = (restrictedRelativeBandpassSphericalMaximal d E phi j f₀ x).toReal +
            ∑ i ∈ insert a S,
              (restrictedRelativeBandpassSphericalMaximal d E phi j (f i) x).toReal := by
              rw [Finset.sum_insert ha]

/-- The strict implicit condition supplies a single finite entropy cover at
every sufficiently fine dyadic relative-frequency scale.  This is the form
of the entropy input used by the finite cap-shell reassembly; the sharper
local diameter factor remains available in the preceding strict-slack
theorem. -/
theorem exists_tail_global_entropy_nat_bound_of_strict_implicit
    {d : ℕ} (hd : 3 ≤ d) {E : Set ℝ} {p α : ℝ} (hp : 1 < p)
    (hE : E ⊆ Icc (1 : ℝ) 2)
    (hstrict :
      max ((α : EReal) + multiplicativeMinkowskiExponent E)
          (multiplicativeLegendreAssouadExponent E
            (((d : ℝ) - 1) * (p - 2) - α)) <
        ((((d : ℝ) - 1) * (p - 1) : ℝ) : EReal)) :
    ∃ ε : ℝ, 0 < ε ∧ ε < ((d : ℝ) - 1) * (p - 1) ∧
      ((α : EReal) + multiplicativeMinkowskiExponent E) <
        ((((d : ℝ) - 1) * (p - 1) - ε : ℝ) : EReal) ∧
      multiplicativeLegendreAssouadExponent E
          (((d : ℝ) - 1) * (p - 2) - α) <
        ((((d : ℝ) - 1) * (p - 1) - ε : ℝ) : EReal) ∧
      ∃ j₀ : ℕ, ∀ j ≥ j₀, ∃ N : ℕ,
        multiplicativeEntropy E (dyadicMultiplicativeScale j) ≤ N ∧
        (N : ENNReal) ≤
          ((dyadicMultiplicativeScale j : ENNReal)⁻¹) ^
            (((d : ℝ) - 1) * (p - 1) - ε) := by
  obtain ⟨ε, hε, hεlt, hMinkowski, hLegendre, hlocal⟩ :=
    exists_eventually_localMultiplicativeEntropy_power_bound_of_strict_implicit
      hd hp hstrict
  have htail : ∀ᶠ j : ℕ in Filter.atTop,
      ∀ (c : PositiveRadius) (diam : Icc (dyadicMultiplicativeScale j) 1),
        localMultiplicativeEntropy E c diam.1 (dyadicMultiplicativeScale j) ≤
          ((diam.1 : ENNReal) ^ (((d : ℝ) - 1) * (p - 2) - α)) *
            ((dyadicMultiplicativeScale j : ENNReal)⁻¹) ^
              (((d : ℝ) - 1) * (p - 1) - ε) :=
    tendsto_dyadicMultiplicativeScale_atTop_nhdsWithin_zero.eventually hlocal
  rcases (eventually_atTop.1 htail) with ⟨j₀, hj₀⟩
  refine ⟨ε, hε, hεlt, hMinkowski, hLegendre, j₀, ?_⟩
  intro j hj
  let δ : NNReal := dyadicMultiplicativeScale j
  have hδpos : 0 < δ := dyadicMultiplicativeScale_pos j
  have hδone : δ ≤ 1 := by
    dsimp only [δ, dyadicMultiplicativeScale]
    exact pow_le_one₀ (by positivity) (by norm_num)
  let diam : Icc δ 1 := ⟨1, hδone, le_rfl⟩
  have hunit : (unitMultiplicativeEntropy E δ : ENNReal) ≤
      ((δ : ENNReal)⁻¹) ^ (((d : ℝ) - 1) * (p - 1) - ε) := by
    unfold unitMultiplicativeEntropy
    rw [ENat.toENNReal_iSup]
    apply iSup_le
    intro c
    have h := hj₀ j hj c diam
    simpa [diam] using h
  have hglobal : (multiplicativeEntropy E δ : ENNReal) ≤
      ((δ : ENNReal)⁻¹) ^ (((d : ℝ) - 1) * (p - 1) - ε) :=
    (ENat.toENNReal_mono
      (multiplicativeEntropy_le_unitMultiplicativeEntropy_of_subset_Icc_one_two hE δ)).trans hunit
  have hsnonneg : 0 ≤ ((d : ℝ) - 1) * (p - 1) - ε := by
    linarith
  have hBtop : ((δ : ENNReal)⁻¹) ^
      (((d : ℝ) - 1) * (p - 1) - ε) < ⊤ := by
    apply ENNReal.rpow_lt_top_of_nonneg hsnonneg
    exact ENNReal.inv_ne_top.mpr (ENNReal.coe_ne_zero.mpr hδpos.ne')
  obtain ⟨N, hN, hNbound⟩ :=
    exists_nat_le_of_enat_toENNReal_le (multiplicativeEntropy E δ) hBtop hglobal
  refine ⟨N, hN, ?_⟩
  simpa only [δ] using hNbound

end

