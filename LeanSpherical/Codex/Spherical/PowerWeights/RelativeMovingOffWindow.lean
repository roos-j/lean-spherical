/-- At a dyadic output scale, every cap level strictly below
j minus k minus one has thickness at most the spatial scale two to the
negative k. -/
theorem dyadic_cap_thickness_le_spatial_scale
    (j k m : Nat) (hm : m < j - k - 1) :
    (2 : ℝ) * (2 : ℝ) ^ (m + 1) / ((2 : ℝ) ^ j) ≤
      ((2 : ℝ) ^ k)⁻¹ := by
  have hmk : m + 2 ≤ j - k := by omega
  have hkj : k ≤ j := by omega
  have hpow : (2 : ℝ) ^ (m + 2) ≤ (2 : ℝ) ^ (j - k) :=
    pow_le_pow_right₀ (by norm_num) hmk
  have hden : 0 < (2 : ℝ) ^ j := pow_pos (by norm_num) _
  have hdiv :
      (2 : ℝ) ^ (m + 2) / ((2 : ℝ) ^ j) ≤
        (2 : ℝ) ^ (j - k) / ((2 : ℝ) ^ j) :=
    (div_le_div_iff_of_pos_right hden).2 hpow
  calc
    (2 : ℝ) * (2 : ℝ) ^ (m + 1) / ((2 : ℝ) ^ j) =
        (2 : ℝ) ^ (m + 2) / ((2 : ℝ) ^ j) := by
          rw [show m + 2 = (m + 1) + 1 by omega, pow_succ]
          ring
    _ ≤ (2 : ℝ) ^ (j - k) / ((2 : ℝ) ^ j) := hdiv
    _ = ((2 : ℝ) ^ k)⁻¹ := by
      rw [show j = (j - k) + k by omega, pow_add]
      field_simp
      congr 1
      omega

/-- The preceding dyadic thickness estimate is uniform for every normalized
radius at most two. -/
theorem dyadic_relative_cap_scale_le_spatial_scale
    {b s : ℝ} (j k m : Nat) (hb : b ≤ 2)
    (hs : s = ((2 : ℝ) ^ k)⁻¹) (hm : m < j - k - 1) :
    b * (2 : ℝ) ^ (m + 1) / ((2 : ℝ) ^ j) ≤ s := by
  calc
    b * (2 : ℝ) ^ (m + 1) / ((2 : ℝ) ^ j) ≤
        (2 : ℝ) * (2 : ℝ) ^ (m + 1) / ((2 : ℝ) ^ j) := by
          gcongr
    _ ≤ ((2 : ℝ) ^ k)⁻¹ :=
      dyadic_cap_thickness_le_spatial_scale j k m hm
    _ = s := hs.symm

/-- The pointwise moving-cap theorem and the lower radial-gap truncation give
an actual off-window bound for one literal relative band. The right side is
