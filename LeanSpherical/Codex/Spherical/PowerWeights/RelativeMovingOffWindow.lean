    (n : Nat) (phi : SchwartzMap (Euclidean (n + 1)) Complex) :
    ∃ C : Real, 0 < C ∧ ∀ (j : Nat)
      (f : SchwartzMap (Euclidean (n + 1)) Complex) (E : Set Real)
      {a b s : Real} (r ell : Nat),
      4 ≤ j → E ⊆ Icc a b → a ≤ b → 1 ≤ a → b ≤ 2 →
      (hs : 0 < s) → 0 < s * ((r : Real) - 1 / 4) →
      (∀ m ∈ Finset.range (j - 3), m < ell →
        s * ((r : Real) + 5 / 4) + s +
          ((b - a) + b * (2 : Real) ^ (m + 1) / ((2 : Real) ^ j)) ≤ b) →
      ∀ x : Euclidean (n + 1), x ∈ ball 0 s →
        restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j
          (SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
            (thinRadialPartition (n + 1) s hs r)) x ≤
          ((j : ENNReal) *
              (ENNReal.ofReal (C * (2 : Real) ^ j) *
                (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ ell) +
            ENNReal.ofReal (C * (2 : Real) ^ j) *
              (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ (j - 3)) *
            ∫⁻ y : Euclidean (n + 1),
              ENNReal.ofReal ‖(SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
                (thinRadialPartition (n + 1) s hs r)) y‖ := by
  obtain ⟨C, hC, hcap⟩ :=
    exists_restrictedRelativeBandpass_interval_pointwise_cap_majorant n phi
  refine ⟨C, hC, ?_⟩
  intro j f E a b s r ell hj hE hab ha hb hs hr hgap x hx
  let g : SchwartzMap (Euclidean (n + 1)) Complex :=
    SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
      (thinRadialPartition (n + 1) s hs r)
  let q : ENNReal := ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))
  let A : ENNReal := ENNReal.ofReal (C * (2 : Real) ^ j)
  have hq : q ≤ 1 := by
    dsimp only [q]
    rw [ENNReal.ofReal_le_one]
    exact pow_le_one₀ (by positivity) (by norm_num)
  have hpoint := hcap j g E hj hE hab ha hb x hx
  have htail (y : Euclidean (n + 1)) :
      ENNReal.ofReal ‖g y‖ *
          relativeIntervalTailMajorant n y a b s j A q x ≤
        ((j : ENNReal) * (A * q ^ ell) + A * q ^ (j - 3)) *
          ENNReal.ofReal ‖g y‖ := by
    dsimp only [g]
    exact thinRadialPartition_piece_mul_relativeIntervalTailMajorant_le_of_upper_gaps
      hs f r hr y x a b j A q ell hq hx hgap
  have hgmeas : Measurable (fun y : Euclidean (n + 1) => ENNReal.ofReal ‖g y‖) :=
    (ENNReal.continuous_ofReal.comp g.continuous.norm).measurable
  calc
    restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x ≤
        ∫⁻ y : Euclidean (n + 1), ENNReal.ofReal ‖g y‖ *
          relativeIntervalTailMajorant n y a b s j A q x := hpoint
    _ ≤ ∫⁻ y : Euclidean (n + 1),
        ((j : ENNReal) * (A * q ^ ell) + A * q ^ (j - 3)) *
          ENNReal.ofReal ‖g y‖ := lintegral_mono htail
    _ = ((j : ENNReal) * (A * q ^ ell) + A * q ^ (j - 3)) *
        ∫⁻ y : Euclidean (n + 1), ENNReal.ofReal ‖g y‖ :=
      lintegral_const_mul _ hgmeas

/-- Finite subadditivity for the literal moving relative band, retaining one
distinguished input piece. This is the exact reassembly shape needed to add
the finitely many off-window thin radial errors to the near-window term. -/
theorem restrictedRelativeBandpassSphericalMaximal_add_finset_sum_le
    {n : Nat} (E : Set ℝ) (phi f₀ : SchwartzMap (Euclidean (n + 1)) ℂ)
    (f : ℕ → SchwartzMap (Euclidean (n + 1)) ℂ) (S : Finset ℕ)
    (j : ℕ) (x : Euclidean (n + 1)) :
    restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j
      (f₀ + ∑ r ∈ S, f r) x ≤
        restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f₀ x +
          ∑ r ∈ S,
            restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j (f r) x := by
  induction S using Finset.induction_on with
  | empty => simp
  | insert r S hr hS =>
      rw [Finset.sum_insert hr]
      have hadd := restrictedRelativeBandpassSphericalMaximal_add_le E phi
        (f₀ + ∑ q ∈ S, f q) (f r) j x
      calc
        restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j
            (f₀ + (f r + ∑ q ∈ S, f q)) x =
            restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j
              ((f₀ + ∑ q ∈ S, f q) + f r) x := by
                have heq :
                    f₀ + (f r + ∑ q ∈ S, f q) =
                      (f₀ + ∑ q ∈ S, f q) + f r := by
                  abel
                rw [heq]
        _ ≤ restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j
              (f₀ + ∑ q ∈ S, f q) x +
            restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j (f r) x := hadd
        _ ≤ (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f₀ x +
              ∑ q ∈ S,
                restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j (f q) x) +
            restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j (f r) x :=
              add_le_add hS le_rfl
        _ = restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f₀ x +
            (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j (f r) x +
              ∑ q ∈ S,
                restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j (f q) x) := by
              ring
        _ = restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f₀ x +
            ∑ q ∈ insert r S,
              restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j (f q) x := by
              rw [Finset.sum_insert hr]

/-- The total unweighted L1 mass of a finite family of positive thin
partition pieces is controlled by four times the mass of the original
input.  The constant is the pointwise two-fold overlap times the
pointwise cutoff bound. -/
theorem sum_lintegral_enorm_thinRadialPartition_piece_le
    {d : Nat} {s : ℝ} (hs : 0 < s) (f : SchwartzMap (Euclidean d) ℂ)
    (M : Finset Nat)
    (hM : ∀ m ∈ M, 0 < s * ((m : ℝ) - 1 / 4)) :
    (∑ m ∈ M, ∫⁻ y : Euclidean d,
      ENNReal.ofReal ‖(SchwartzMap.pairing (ContinuousLinearMap.mul ℂ ℂ) f
        (thinRadialPartition d s hs m)) y‖) ≤
      4 * ∫⁻ y : Euclidean d, ENNReal.ofReal ‖f y‖ := by
  rw [← lintegral_finsetSum]
  · calc
      (∫⁻ y : Euclidean d, ∑ m ∈ M,
          ENNReal.ofReal ‖(SchwartzMap.pairing (ContinuousLinearMap.mul ℂ ℂ) f
            (thinRadialPartition d s hs m)) y‖) ≤
          ∫⁻ y : Euclidean d, 4 * ENNReal.ofReal ‖f y‖ := by
            apply lintegral_mono
            intro y
            dsimp
            change (∑ m ∈ M,
                ENNReal.ofReal ‖f y * thinRadialPartition d s hs m y‖) ≤
                4 * ENNReal.ofReal ‖f y‖
            simp only [ofReal_norm_eq_enorm]
            have hpoint := sum_enorm_rpow_thinRadialPartition_piece_le
              hs f M hM (p := (1 : ℝ)) zero_lt_one y
            change (∑ m ∈ M,
                ‖f y * thinRadialPartition d s hs m y‖ₑ ^ (1 : ℝ)) ≤
                (ENNReal.ofReal 2) ^ (1 : ℝ) * 2 * ‖f y‖ₑ ^ (1 : ℝ) at hpoint
            calc
              ∑ m ∈ M, ‖f y * thinRadialPartition d s hs m y‖ₑ ≤
                  2 * (2 * ‖f y‖ₑ) := by
                    simpa only [ENNReal.rpow_one,
                      ENNReal.ofReal_ofNat, one_mul, mul_assoc] using hpoint
              _ = 4 * ‖f y‖ₑ := by ring
      _ = 4 * ∫⁻ y : Euclidean d, ENNReal.ofReal ‖f y‖ :=
        lintegral_const_mul _ (ENNReal.continuous_ofReal.comp f.continuous.norm).measurable
  · intro m hm
    exact (ENNReal.continuous_ofReal.comp
      (SchwartzMap.pairing (ContinuousLinearMap.mul ℂ ℂ) f
        (thinRadialPartition d s hs m)).continuous.norm).measurable

/-- The preceding finite thin-partition estimate in the eLpNorm notation
used by the weighted error conversion. -/
theorem sum_lintegral_enorm_thinRadialPartition_piece_le_eLpNorm_one
    {d : Nat} {s : ℝ} (hs : 0 < s) (f : SchwartzMap (Euclidean d) ℂ)
    (M : Finset Nat)
    (hM : ∀ m ∈ M, 0 < s * ((m : ℝ) - 1 / 4)) :
    (∑ m ∈ M, ∫⁻ y : Euclidean d,
      ENNReal.ofReal ‖(SchwartzMap.pairing (ContinuousLinearMap.mul ℂ ℂ) f
        (thinRadialPartition d s hs m)) y‖) ≤
      4 * eLpNorm (f : Euclidean d → ℂ) 1 volume := by
  simpa only [eLpNorm_one_eq_lintegral_enorm, ofReal_norm] using
    sum_lintegral_enorm_thinRadialPartition_piece_le hs f M hM

/-- A finite family of thin radial pieces satisfying lower radial gaps has
one near term plus an explicit sum of off-window cap-tail errors. This is
the finite radial-shell reassembly used before the frequency and spatial
cutoffs are sent to infinity. -/
theorem exists_restrictedRelativeBandpass_thinRadialPartition_tail_sum_le_of_lower_gaps
    (n : Nat) (phi : SchwartzMap (Euclidean (n + 1)) ℂ) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : Nat)
      (f f₀ : SchwartzMap (Euclidean (n + 1)) ℂ) (E : Set ℝ)
      {a b s : ℝ} (S : Finset Nat) (ell : Nat → Nat),
      4 ≤ j → E ⊆ Icc a b → a ≤ b → 1 ≤ a → b ≤ 2 →
      (hs : 0 < s) →
      (∀ r ∈ S, 0 < s * ((r : ℝ) - 1 / 4)) →
      (∀ r ∈ S, ∀ m ∈ Finset.range (j - 3), m < ell r →
        b + ((b - a) + b * (2 : ℝ) ^ (m + 1) / ((2 : ℝ) ^ j)) + s ≤
          s * ((r : ℝ) - 1 / 4)) →
      ∀ x : Euclidean (n + 1), x ∈ ball 0 s →
        restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j
          (f₀ + ∑ r ∈ S,
            SchwartzMap.pairing (ContinuousLinearMap.mul ℂ ℂ) f
              (thinRadialPartition (n + 1) s hs r)) x ≤
          restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f₀ x +
            ∑ r ∈ S,
              ((j : ENNReal) *
                  (ENNReal.ofReal (C * (2 : ℝ) ^ j) *
                    (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ (ell r)) +
                ENNReal.ofReal (C * (2 : ℝ) ^ j) *
                  (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ (j - 3)) *
                ∫⁻ y : Euclidean (n + 1),
                  ENNReal.ofReal ‖(SchwartzMap.pairing
                    (ContinuousLinearMap.mul ℂ ℂ) f
                    (thinRadialPartition (n + 1) s hs r)) y‖ := by
  obtain ⟨C, hC, htail⟩ :=
    exists_restrictedRelativeBandpass_thinRadialPartition_tail_le_of_lower_gaps n phi
  refine ⟨C, hC, ?_⟩
  intro j f f₀ E a b s S ell hj hE hab ha hb hs hr hgap x hx
  let g : Nat → SchwartzMap (Euclidean (n + 1)) ℂ := fun r =>
    SchwartzMap.pairing (ContinuousLinearMap.mul ℂ ℂ) f
      (thinRadialPartition (n + 1) s hs r)
  have hsub := restrictedRelativeBandpassSphericalMaximal_add_finset_sum_le
    E phi f₀ g S j x
  calc
    restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j
        (f₀ + ∑ r ∈ S, g r) x ≤
        restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f₀ x +
          ∑ r ∈ S,
            restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j (g r) x := hsub
    _ ≤ restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f₀ x +
          ∑ r ∈ S,
            ((j : ENNReal) *
                (ENNReal.ofReal (C * (2 : ℝ) ^ j) *
                  (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ (ell r)) +
              ENNReal.ofReal (C * (2 : ℝ) ^ j) *
                (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ (j - 3)) *
              ∫⁻ y : Euclidean (n + 1), ENNReal.ofReal ‖g r y‖ := by
        gcongr with r hrS
        exact htail j f E r (ell r) hj hE hab ha hb hs (hr r hrS)
          (hgap r hrS) x hx

/-- If every off-window thin piece has the same tail cutoff level, its
finite radial sum is bounded by one explicit error coefficient times the
unweighted L1 norm of the original input. -/
theorem exists_restrictedRelativeBandpass_thinRadialPartition_tail_sum_le_of_lower_gaps_common
    (n : Nat) (phi : SchwartzMap (Euclidean (n + 1)) ℂ) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : Nat)
      (f f₀ : SchwartzMap (Euclidean (n + 1)) ℂ) (E : Set ℝ)
      {a b s : ℝ} (S : Finset Nat) (ell : Nat),
      4 ≤ j → E ⊆ Icc a b → a ≤ b → 1 ≤ a → b ≤ 2 →
      (hs : 0 < s) →
      (∀ r ∈ S, 0 < s * ((r : ℝ) - 1 / 4)) →
      (∀ r ∈ S, ∀ m ∈ Finset.range (j - 3), m < ell →
        b + ((b - a) + b * (2 : ℝ) ^ (m + 1) / ((2 : ℝ) ^ j)) + s ≤
          s * ((r : ℝ) - 1 / 4)) →
      ∀ x : Euclidean (n + 1), x ∈ ball 0 s →
        restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j
          (f₀ + ∑ r ∈ S,
            SchwartzMap.pairing (ContinuousLinearMap.mul ℂ ℂ) f
              (thinRadialPartition (n + 1) s hs r)) x ≤
          restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f₀ x +
            ((j : ENNReal) *
                (ENNReal.ofReal (C * (2 : ℝ) ^ j) *
                  (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ ell) +
              ENNReal.ofReal (C * (2 : ℝ) ^ j) *
                (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ (j - 3)) *
              (4 * eLpNorm (f : Euclidean (n + 1) → ℂ) 1 volume) := by
  obtain ⟨C, hC, htail⟩ :=
    exists_restrictedRelativeBandpass_thinRadialPartition_tail_sum_le_of_lower_gaps n phi
  refine ⟨C, hC, ?_⟩
  intro j f f₀ E a b s S ell hj hE hab ha hb hs hr hgap x hx
  let Q : ENNReal :=
    (j : ENNReal) *
        (ENNReal.ofReal (C * (2 : ℝ) ^ j) *
          (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ ell) +
      ENNReal.ofReal (C * (2 : ℝ) ^ j) *
        (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ (j - 3)
  have hbase := htail j f f₀ E S (fun _ => ell) hj hE hab ha hb hs hr
    (fun r hrS m hm hmell => hgap r hrS m hm hmell) x hx
  have hbase' :
      restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j
          (f₀ + ∑ r ∈ S,
            SchwartzMap.pairing (ContinuousLinearMap.mul ℂ ℂ) f
              (thinRadialPartition (n + 1) s hs r)) x ≤
        restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f₀ x +
          ∑ r ∈ S, Q *
            ∫⁻ y : Euclidean (n + 1),
              ENNReal.ofReal ‖(SchwartzMap.pairing
                (ContinuousLinearMap.mul ℂ ℂ) f
                (thinRadialPartition (n + 1) s hs r)) y‖ := by
    simpa only [Q] using hbase
  have hmass := sum_lintegral_enorm_thinRadialPartition_piece_le_eLpNorm_one
    hs f S hr
  calc
    restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j
        (f₀ + ∑ r ∈ S,
          SchwartzMap.pairing (ContinuousLinearMap.mul ℂ ℂ) f
            (thinRadialPartition (n + 1) s hs r)) x ≤
        restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f₀ x +
          ∑ r ∈ S, Q *
            ∫⁻ y : Euclidean (n + 1),
              ENNReal.ofReal ‖(SchwartzMap.pairing
                (ContinuousLinearMap.mul ℂ ℂ) f
                (thinRadialPartition (n + 1) s hs r)) y‖ := hbase'
    _ = restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f₀ x +
        Q * (∑ r ∈ S, ∫⁻ y : Euclidean (n + 1),
          ENNReal.ofReal ‖(SchwartzMap.pairing
            (ContinuousLinearMap.mul ℂ ℂ) f
            (thinRadialPartition (n + 1) s hs r)) y‖) := by
          rw [Finset.mul_sum]
    _ ≤ restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f₀ x +
        Q * (4 * eLpNorm (f : Euclidean (n + 1) → ℂ) 1 volume) :=
      by
        gcongr
    _ = restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f₀ x +
          ((j : ENNReal) *
              (ENNReal.ofReal (C * (2 : ℝ) ^ j) *
                (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ ell) +
            ENNReal.ofReal (C * (2 : ℝ) ^ j) *
              (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ (j - 3)) *
            (4 * eLpNorm (f : Euclidean (n + 1) → ℂ) 1 volume) := by
      rfl

/-- The common-level finite off-window error has a weighted shell bound for
compactly supported input.  The first conjunct is the literal pointwise
reassembly; the second is the corresponding weighted norm of its explicit
constant error envelope. -/
theorem exists_restrictedRelativeBandpass_thinRadialPartition_tail_sum_compact_shell
    (n : Nat) (phi : SchwartzMap (Euclidean (n + 1)) ℂ) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : Nat)
      (f f₀ : SchwartzMap (Euclidean (n + 1)) ℂ) (E : Set ℝ)
      {a b s S0 p α : ℝ} (S : Finset Nat) (ell : Nat)
      (B : Set (Euclidean (n + 1))),
      4 ≤ j → E ⊆ Icc a b → a ≤ b → 1 ≤ a → b ≤ 2 →
      (hs : 0 < s) →
      (∀ r ∈ S, 0 < s * ((r : ℝ) - 1 / 4)) →
      (∀ r ∈ S, ∀ m ∈ Finset.range (j - 3), m < ell →
        b + ((b - a) + b * (2 : ℝ) ^ (m + 1) / ((2 : ℝ) ^ j)) + s ≤
          s * ((r : ℝ) - 1 / 4)) →
      1 < p → α ≤ 0 → 0 < S0 → MeasurableSet B →
      (∀ y : Euclidean (n + 1), y ∉ closedBall 0 S0 → f y = 0) →
      let Q : ENNReal :=
        (j : ENNReal) *
            (ENNReal.ofReal (C * (2 : ℝ) ^ j) *
              (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ ell) +
          ENNReal.ofReal (C * (2 : ℝ) ^ j) *
            (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ (j - 3)
      (∀ x : Euclidean (n + 1), x ∈ ball 0 s →
        restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j
          (f₀ + ∑ r ∈ S,
            SchwartzMap.pairing (ContinuousLinearMap.mul ℂ ℂ) f
              (thinRadialPartition (n + 1) s hs r)) x ≤
          restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f₀ x +
            Q * (4 * eLpNorm (f : Euclidean (n + 1) → ℂ) 1 volume)) ∧
      ((ENNReal.ofReal S0) ^ α) ^ p⁻¹ *
          eLpNorm (B.indicator (fun _ : Euclidean (n + 1) =>
            Q * (4 * eLpNorm (f : Euclidean (n + 1) → ℂ) 1 volume)))
            (ENNReal.ofReal p) (powerWeightedVolume (n + 1) α) ≤
        (Q * 4) * (powerWeightedVolume (n + 1) α B) ^ p⁻¹ *
          eLpNorm (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p)
            (powerWeightedVolume (n + 1) α) *
          (volume (closedBall (0 : Euclidean (n + 1)) S0)) ^ (1 - p⁻¹) := by
  obtain ⟨C, hC, htail⟩ :=
    exists_restrictedRelativeBandpass_thinRadialPartition_tail_sum_le_of_lower_gaps_common n phi
  refine ⟨C, hC, ?_⟩
  intro j f f₀ E a b s S0 p α S ell B hj hE hab ha hb hs hr hgap hp hα hS0 hB hfsupp
  let Q : ENNReal :=
    (j : ENNReal) *
        (ENNReal.ofReal (C * (2 : ℝ) ^ j) *
          (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ ell) +
      ENNReal.ofReal (C * (2 : ℝ) ^ j) *
        (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ (j - 3)
  have hpoint := htail j f f₀ E S ell hj hE hab ha hb hs hr hgap
  have herr :=
    outerPower_rpow_mul_eLpNorm_indicator_const_mul_eLpNorm_one_le_weighted
      hp hα hS0 B hB (Q * 4) f hfsupp
  constructor
  · intro x hx
    simpa only [Q, mul_assoc] using hpoint x hx
  · simpa only [Q, mul_assoc] using herr

/-- A finite family of thin radial pieces satisfying upper radial gaps has
one near term plus the literal sum of its individual cap-tail errors.  This
is the inner counterpart of the outer individual-level reassembly above. -/
theorem exists_restrictedRelativeBandpass_thinRadialPartition_tail_sum_le_of_upper_gaps
    (n : Nat) (phi : SchwartzMap (Euclidean (n + 1)) Complex) :
    ∃ C : Real, 0 < C ∧ ∀ (j : Nat)
      (f f0 : SchwartzMap (Euclidean (n + 1)) Complex) (E : Set Real)
      {a b s : Real} (S : Finset Nat) (ell : Nat → Nat),
      4 ≤ j → E ⊆ Icc a b → a ≤ b → 1 ≤ a → b ≤ 2 →
      (hs : 0 < s) →
      (∀ r ∈ S, 0 < s * ((r : Real) - 1 / 4)) →
      (∀ r ∈ S, ∀ m ∈ Finset.range (j - 3), m < ell r →
        s * ((r : Real) + 5 / 4) + s +
          ((b - a) + b * (2 : Real) ^ (m + 1) / ((2 : Real) ^ j)) ≤ b) →
      ∀ x : Euclidean (n + 1), x ∈ ball 0 s →
        restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j
          (f0 + ∑ r ∈ S,
            SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
              (thinRadialPartition (n + 1) s hs r)) x ≤
          restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f0 x +
            ∑ r ∈ S,
              ((j : ENNReal) *
                  (ENNReal.ofReal (C * (2 : Real) ^ j) *
                    (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ (ell r)) +
                ENNReal.ofReal (C * (2 : Real) ^ j) *
                  (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ (j - 3)) *
                ∫⁻ y : Euclidean (n + 1),
                  ENNReal.ofReal ‖(SchwartzMap.pairing
                    (ContinuousLinearMap.mul Complex Complex) f
                    (thinRadialPartition (n + 1) s hs r)) y‖ := by
  obtain ⟨C, hC, htail⟩ :=
    exists_restrictedRelativeBandpass_thinRadialPartition_tail_le_of_upper_gaps n phi
  refine ⟨C, hC, ?_⟩
  intro j f f0 E a b s S ell hj hE hab ha hb hs hr hgap x hx
  let g : Nat → SchwartzMap (Euclidean (n + 1)) Complex := fun r =>
    SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
      (thinRadialPartition (n + 1) s hs r)
  have hsub := restrictedRelativeBandpassSphericalMaximal_add_finset_sum_le
    E phi f0 g S j x
  calc
    restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j
        (f0 + ∑ r ∈ S, g r) x ≤
        restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f0 x +
          ∑ r ∈ S,
            restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j (g r) x := hsub
    _ ≤ restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f0 x +
          ∑ r ∈ S,
            ((j : ENNReal) *
                (ENNReal.ofReal (C * (2 : Real) ^ j) *
                  (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ (ell r)) +
              ENNReal.ofReal (C * (2 : Real) ^ j) *
                (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ (j - 3)) *
              ∫⁻ y : Euclidean (n + 1), ENNReal.ofReal ‖g r y‖ := by
        gcongr with r hrS
        exact htail j f E r (ell r) hj hE hab ha hb hs (hr r hrS)
          (hgap r hrS) x hx

/-- The common-level finite reassembly for thin pieces lying strictly inside
the parameter window.  Together with the outer version above, this gives the
two off-window tails required by the central thin partition. -/
theorem exists_restrictedRelativeBandpass_thinRadialPartition_tail_sum_le_of_upper_gaps_common
    (n : Nat) (phi : SchwartzMap (Euclidean (n + 1)) Complex) :
    ∃ C : Real, 0 < C ∧ ∀ (j : Nat)
      (f f0 : SchwartzMap (Euclidean (n + 1)) Complex) (E : Set Real)
      {a b s : Real} (S : Finset Nat) (ell : Nat),
      4 ≤ j → E ⊆ Icc a b → a ≤ b → 1 ≤ a → b ≤ 2 →
      (hs : 0 < s) →
      (∀ r ∈ S, 0 < s * ((r : Real) - 1 / 4)) →
      (∀ r ∈ S, ∀ m ∈ Finset.range (j - 3), m < ell →
        s * ((r : Real) + 5 / 4) + s +
          ((b - a) + b * (2 : Real) ^ (m + 1) / ((2 : Real) ^ j)) ≤ b) →
      ∀ x : Euclidean (n + 1), x ∈ ball 0 s →
        restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j
          (f0 + ∑ r ∈ S,
            SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
              (thinRadialPartition (n + 1) s hs r)) x ≤
          restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f0 x +
            ((j : ENNReal) *
                (ENNReal.ofReal (C * (2 : Real) ^ j) *
                  (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ ell) +
              ENNReal.ofReal (C * (2 : Real) ^ j) *
                (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ (j - 3)) *
              (4 * eLpNorm (f : Euclidean (n + 1) → Complex) 1 volume) := by
  obtain ⟨C, hC, htail⟩ :=
    exists_restrictedRelativeBandpass_thinRadialPartition_tail_le_of_upper_gaps n phi
  refine ⟨C, hC, ?_⟩
  intro j f f0 E a b s S ell hj hE hab ha hb hs hr hgap x hx
  let Q : ENNReal :=
    (j : ENNReal) *
        (ENNReal.ofReal (C * (2 : Real) ^ j) *
          (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ ell) +
      ENNReal.ofReal (C * (2 : Real) ^ j) *
        (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ (j - 3)
  let g : Nat → SchwartzMap (Euclidean (n + 1)) Complex := fun r =>
    SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
      (thinRadialPartition (n + 1) s hs r)
  have hsub := restrictedRelativeBandpassSphericalMaximal_add_finset_sum_le
    E phi f0 g S j x
  have hmass := sum_lintegral_enorm_thinRadialPartition_piece_le_eLpNorm_one
    hs f S hr
  calc
    restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j
        (f0 + ∑ r ∈ S, g r) x ≤
        restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f0 x +
          ∑ r ∈ S, restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j (g r) x := hsub
    _ ≤ restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f0 x +
          ∑ r ∈ S, Q * ∫⁻ y : Euclidean (n + 1), ENNReal.ofReal ‖g r y‖ := by
          gcongr with r hrS
          exact htail j f E r ell hj hE hab ha hb hs (hr r hrS)
            (hgap r hrS) x hx
    _ = restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f0 x +
        Q * (∑ r ∈ S, ∫⁻ y : Euclidean (n + 1), ENNReal.ofReal ‖g r y‖) := by
          rw [Finset.mul_sum]
    _ ≤ restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f0 x +
        Q * (4 * eLpNorm (f : Euclidean (n + 1) → Complex) 1 volume) := by
          gcongr
    _ = restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f0 x +
          ((j : ENNReal) *
              (ENNReal.ofReal (C * (2 : Real) ^ j) *
                (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ ell) +
            ENNReal.ofReal (C * (2 : Real) ^ j) *
              (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ (j - 3)) *
            (4 * eLpNorm (f : Euclidean (n + 1) → Complex) 1 volume) := by
      rfl

/-- Weighted-shell form of the inner off-window error.  It mirrors the
outer compact-shell estimate and is deliberately stated with the literal
thin partition still visible. -/
theorem exists_restrictedRelativeBandpass_thinRadialPartition_tail_sum_compact_shell_upper
    (n : Nat) (phi : SchwartzMap (Euclidean (n + 1)) Complex) :
    ∃ C : Real, 0 < C ∧ ∀ (j : Nat)
      (f f0 : SchwartzMap (Euclidean (n + 1)) Complex) (E : Set Real)
      {a b s S0 p α : Real} (S : Finset Nat) (ell : Nat)
      (B : Set (Euclidean (n + 1))),
      4 ≤ j → E ⊆ Icc a b → a ≤ b → 1 ≤ a → b ≤ 2 →
      (hs : 0 < s) →
      (∀ r ∈ S, 0 < s * ((r : Real) - 1 / 4)) →
      (∀ r ∈ S, ∀ m ∈ Finset.range (j - 3), m < ell →
        s * ((r : Real) + 5 / 4) + s +
          ((b - a) + b * (2 : Real) ^ (m + 1) / ((2 : Real) ^ j)) ≤ b) →
      1 < p → α ≤ 0 → 0 < S0 → MeasurableSet B →
      (∀ y : Euclidean (n + 1), y ∉ closedBall 0 S0 → f y = 0) →
      let Q : ENNReal :=
        (j : ENNReal) *
            (ENNReal.ofReal (C * (2 : Real) ^ j) *
              (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ ell) +
          ENNReal.ofReal (C * (2 : Real) ^ j) *
            (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ (j - 3)
      (∀ x : Euclidean (n + 1), x ∈ ball 0 s →
        restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j
          (f0 + ∑ r ∈ S,
            SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
              (thinRadialPartition (n + 1) s hs r)) x ≤
          restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f0 x +
            Q * (4 * eLpNorm (f : Euclidean (n + 1) → Complex) 1 volume)) ∧
      ((ENNReal.ofReal S0) ^ α) ^ p⁻¹ *
          eLpNorm (B.indicator (fun _ : Euclidean (n + 1) =>
            Q * (4 * eLpNorm (f : Euclidean (n + 1) → Complex) 1 volume)))
            (ENNReal.ofReal p) (powerWeightedVolume (n + 1) α) ≤
        (Q * 4) * (powerWeightedVolume (n + 1) α B) ^ p⁻¹ *
          eLpNorm (f : Euclidean (n + 1) → Complex) (ENNReal.ofReal p)
            (powerWeightedVolume (n + 1) α) *
          (volume (closedBall (0 : Euclidean (n + 1)) S0)) ^ (1 - p⁻¹) := by
  obtain ⟨C, hC, htail⟩ :=
    exists_restrictedRelativeBandpass_thinRadialPartition_tail_sum_le_of_upper_gaps_common n phi
  refine ⟨C, hC, ?_⟩
  intro j f f0 E a b s S0 p α S ell B hj hE hab ha hb hs hr hgap hp hα hS0 hB hfsupp
  let Q : ENNReal :=
    (j : ENNReal) *
        (ENNReal.ofReal (C * (2 : Real) ^ j) *
          (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ ell) +
      ENNReal.ofReal (C * (2 : Real) ^ j) *
        (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ (j - 3)
  have hpoint := htail j f f0 E S ell hj hE hab ha hb hs hr hgap
  have herr :=
    outerPower_rpow_mul_eLpNorm_indicator_const_mul_eLpNorm_one_le_weighted
      hp hα hS0 B hB (Q * 4) f hfsupp
  constructor
  · intro x hx
    simpa only [Q, mul_assoc] using hpoint x hx
  · simpa only [Q, mul_assoc] using herr

end

