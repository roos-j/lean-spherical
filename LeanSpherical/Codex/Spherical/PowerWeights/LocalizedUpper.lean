      ((continuous_const : Continuous fun _ : Metric.sphere (0 : Euclidean d) 1 => x).add
        ((continuous_const : Continuous fun _ : Metric.sphere (0 : Euclidean d) 1 => r).smul
          continuous_subtype_val))).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  unfold sphericalAverage
  have hsum_apply (ω : Metric.sphere (0 : Euclidean d) 1) :
      (∑ j ∈ s, gs j) (x + r • (ω : Euclidean d)) =
        ∑ j ∈ s, gs j (x + r • (ω : Euclidean d)) := by
    change (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean d) ℂ)
      (Euclidean d) ℂ) (∑ j ∈ s, gs j) (x + r • (ω : Euclidean d)) =
        ∑ j ∈ s,
          (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean d) ℂ)
            (Euclidean d) ℂ) (gs j) (x + r • (ω : Euclidean d))
    simpa only [Finset.sum_apply] using
      congrFun (map_sum (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean d) ℂ)
        (Euclidean d) ℂ) gs s) (x + r • (ω : Euclidean d))
  rw [show (fun ω : Metric.sphere (0 : Euclidean d) 1 =>
      (g + ∑ j ∈ s, gs j) (x + r • (ω : Euclidean d))) =
        fun (ω : Metric.sphere (0 : Euclidean d) 1) =>
          g (x + r • (ω : Euclidean d)) +
            ∑ j ∈ s, gs j (x + r • (ω : Euclidean d)) by
      funext ω
      rw [add_apply, hsum_apply ω]]
  have hsum : Integrable (fun ω : Metric.sphere (0 : Euclidean d) 1 =>
      ∑ j ∈ s, gs j (x + r • (ω : Euclidean d))) (unitSurfaceMeasure d) := by
    apply integrable_finsetSum
    intro j hj
    exact hgs j
  rw [MeasureTheory.integral_add hg hsum]
  rw [MeasureTheory.integral_finsetSum s (fun j _ => hgs j)]

private theorem restricted_surface_multiplier_reassembles_from_schwartz_data
    {d : ℕ} (gN g : SchwartzMap (Euclidean d) ℂ)
    (gs : ℕ → SchwartzMap (Euclidean d) ℂ) (s : Finset ℕ)
    (r : ℝ) (x : Euclidean d)
    (hdata : gN = g + ∑ j ∈ s, gs j) :
    𝓕⁻ (fun ξ : Euclidean d => surfaceFourier d (-r • ξ) * gN ξ) x =
      𝓕⁻ (fun ξ : Euclidean d => surfaceFourier d (-r • ξ) * g ξ) x +
        ∑ j ∈ s,
          𝓕⁻ (fun ξ : Euclidean d => surfaceFourier d (-r • ξ) * gs j ξ) x := by
  have hinv : (𝓕⁻ gN : SchwartzMap (Euclidean d) ℂ) =
      (𝓕⁻ g : SchwartzMap (Euclidean d) ℂ) +
        ∑ j ∈ s, (𝓕⁻ (gs j) : SchwartzMap (Euclidean d) ℂ) := by
    rw [hdata, fourierInv_add, fourierInv_sum]
  calc
    𝓕⁻ (fun ξ : Euclidean d => surfaceFourier d (-r • ξ) * gN ξ) x =
        sphericalAverage d ((𝓕⁻ gN : SchwartzMap (Euclidean d) ℂ) :
          Euclidean d → ℂ) r x :=
      (congrFun (sphericalAverage_fourierInv_schwartz_eq_surfaceMultiplier gN r) x).symm
    _ = sphericalAverage d
        ((((𝓕⁻ g : SchwartzMap (Euclidean d) ℂ) +
          ∑ j ∈ s, (𝓕⁻ (gs j) : SchwartzMap (Euclidean d) ℂ)) :
            SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) r x := by
      rw [hinv]
    _ = sphericalAverage d ((𝓕⁻ g : SchwartzMap (Euclidean d) ℂ) :
          Euclidean d → ℂ) r x +
        ∑ j ∈ s, sphericalAverage d
          ((𝓕⁻ (gs j) : SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) r x :=
      restricted_sphericalAverage_schwartz_add_finset_sum
        (𝓕⁻ g : SchwartzMap (Euclidean d) ℂ)
        (fun j => (𝓕⁻ (gs j) : SchwartzMap (Euclidean d) ℂ)) s r x
    _ = 𝓕⁻ (fun ξ : Euclidean d => surfaceFourier d (-r • ξ) * g ξ) x +
        ∑ j ∈ s,
          𝓕⁻ (fun ξ : Euclidean d => surfaceFourier d (-r • ξ) * gs j ξ) x := by
      rw [sphericalAverage_fourierInv_schwartz_eq_surfaceMultiplier g r]
      apply congrArg (fun z : ℂ =>
        𝓕⁻ (fun ξ : Euclidean d => surfaceFourier d (-r • ξ) * g ξ) x + z)
      apply Finset.sum_congr rfl
      intro j hj
      exact congrFun
        (sphericalAverage_fourierInv_schwartz_eq_surfaceMultiplier (gs j) r) x

private theorem restricted_relative_cutoff_fixed_radius_le_low_add_band_sum
    {d : ℕ} {E : Set ℝ} (phi : SchwartzMap (Euclidean d) ℂ)
    (N : ℕ) (f : SchwartzMap (Euclidean d) ℂ)
    (r : ↥(E ∩ Ioi (0 : ℝ))) (x : Euclidean d) :
    ‖𝓕⁻ (fun ξ : Euclidean d =>
        surfaceFourier d (-r.1 • ξ) *
          phi (((2 : ℝ) ^ N)⁻¹ • (r.1 • ξ)) *
          𝓕 (f : Euclidean d → ℂ) ξ) x‖ ≤
      ‖𝓕⁻ (fun ξ : Euclidean d =>
          surfaceFourier d (-r.1 • ξ) * phi (r.1 • ξ) *
            𝓕 (f : Euclidean d → ℂ) ξ) x‖ +
        ∑ j ∈ Finset.range N, ‖𝓕⁻ (fun ξ : Euclidean d =>
          surfaceFourier d (-r.1 • ξ) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • ξ)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ))) *
            𝓕 (f : Euclidean d → ℂ) ξ) x‖ := by
  let gN : SchwartzMap (Euclidean d) ℂ :=
    restricted_relative_radius_data phi r N f
  let g : SchwartzMap (Euclidean d) ℂ :=
    restricted_relative_radius_data phi r 0 f
  let gs : ℕ → SchwartzMap (Euclidean d) ℂ := fun j =>
    restricted_relative_radius_data phi r (j + 1) f -
      restricted_relative_radius_data phi r j f
  have hdata : gN = g + ∑ j ∈ Finset.range N, gs j := by
    dsimp only [gN, g, gs]
    exact restricted_relative_radius_data_telescopes phi r N f
  have hreassemble :=
    restricted_surface_multiplier_reassembles_from_schwartz_data
      gN g gs (Finset.range N) r.1 x hdata
  have hgN : (fun ξ : Euclidean d => surfaceFourier d (-r.1 • ξ) * gN ξ) =
      fun ξ => surfaceFourier d (-r.1 • ξ) *
        phi (((2 : ℝ) ^ N)⁻¹ • (r.1 • ξ)) *
          𝓕 (f : Euclidean d → ℂ) ξ := by
    funext ξ
    dsimp only [gN]
    rw [restricted_relative_radius_data_apply]
    ring
  have hg : (fun ξ : Euclidean d => surfaceFourier d (-r.1 • ξ) * g ξ) =
      fun ξ => surfaceFourier d (-r.1 • ξ) * phi (r.1 • ξ) *
        𝓕 (f : Euclidean d → ℂ) ξ := by
    funext ξ
    dsimp only [g]
    rw [restricted_relative_radius_data_apply]
    norm_num
    ring
  have hgs (j : ℕ) :
      (fun ξ : Euclidean d => surfaceFourier d (-r.1 • ξ) * gs j ξ) =
        fun ξ => surfaceFourier d (-r.1 • ξ) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • ξ)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ))) *
          𝓕 (f : Euclidean d → ℂ) ξ := by
    funext ξ
    dsimp only [gs]
    rw [sub_apply, restricted_relative_radius_data_apply,
      restricted_relative_radius_data_apply]
    ring
  rw [hgN, hg] at hreassemble
  rw [show (∑ j ∈ Finset.range N,
      𝓕⁻ (fun ξ : Euclidean d => surfaceFourier d (-r.1 • ξ) * gs j ξ) x) =
        ∑ j ∈ Finset.range N, 𝓕⁻ (fun ξ : Euclidean d =>
          surfaceFourier d (-r.1 • ξ) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • ξ)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ))) *
            𝓕 (f : Euclidean d → ℂ) ξ) x by
      apply Finset.sum_congr rfl
      intro j hj
      rw [hgs j]] at hreassemble
  have hsum :
      ‖∑ j ∈ Finset.range N, 𝓕⁻ (fun ξ : Euclidean d =>
          surfaceFourier d (-r.1 • ξ) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • ξ)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ))) *
            𝓕 (f : Euclidean d → ℂ) ξ) x‖ ≤
        ∑ j ∈ Finset.range N, ‖𝓕⁻ (fun ξ : Euclidean d =>
          surfaceFourier d (-r.1 • ξ) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • ξ)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ))) *
            𝓕 (f : Euclidean d → ℂ) ξ) x‖ :=
    norm_sum_le _ _
  calc
    _ = ‖𝓕⁻ (fun ξ : Euclidean d =>
        surfaceFourier d (-r.1 • ξ) * phi (r.1 • ξ) *
          𝓕 (f : Euclidean d → ℂ) ξ) x +
        ∑ j ∈ Finset.range N, 𝓕⁻ (fun ξ : Euclidean d =>
          surfaceFourier d (-r.1 • ξ) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • ξ)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ))) *
            𝓕 (f : Euclidean d → ℂ) ξ) x‖ := congrArg norm hreassemble
    _ ≤ ‖𝓕⁻ (fun ξ : Euclidean d =>
        surfaceFourier d (-r.1 • ξ) * phi (r.1 • ξ) *
          𝓕 (f : Euclidean d → ℂ) ξ) x‖ +
        ‖∑ j ∈ Finset.range N, 𝓕⁻ (fun ξ : Euclidean d =>
          surfaceFourier d (-r.1 • ξ) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • ξ)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ))) *
            𝓕 (f : Euclidean d → ℂ) ξ) x‖ := norm_add_le _ _
    _ ≤ _ := add_le_add_right hsum _

/-- Literal finite telescoping for the restricted relative cutoff. -/
theorem restrictedRelativeCutoffSphericalMaximal_le_lowpass_add_band_sum
    {d : ℕ} (E : Set ℝ) (phi : SchwartzMap (Euclidean d) ℂ)
    (N : ℕ) (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    restrictedRelativeCutoffSphericalMaximal d E phi N f x ≤
      restrictedRelativeLowpassSphericalMaximal d E phi f x +
        ∑ j ∈ Finset.range N,
          restrictedRelativeBandpassSphericalMaximal d E phi j f x := by
  unfold restrictedRelativeCutoffSphericalMaximal
    restrictedRelativeLowpassSphericalMaximal
    restrictedRelativeBandpassSphericalMaximal
  apply iSup_le
  intro r
  have hfixed := restricted_relative_cutoff_fixed_radius_le_low_add_band_sum
    phi N f r x
  have hfixed' : ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean d =>
      surfaceFourier d (-r.1 • ξ) *
        phi (((2 : ℝ) ^ N)⁻¹ • (r.1 • ξ)) *
        𝓕 (f : Euclidean d → ℂ) ξ) x‖ ≤
      ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean d =>
        surfaceFourier d (-r.1 • ξ) * phi (r.1 • ξ) *
          𝓕 (f : Euclidean d → ℂ) ξ) x‖ +
        ∑ j ∈ Finset.range N, ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean d =>
          surfaceFourier d (-r.1 • ξ) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • ξ)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ))) *
            𝓕 (f : Euclidean d → ℂ) ξ) x‖ := by
    rw [← ENNReal.ofReal_sum_of_nonneg (fun j _ => norm_nonneg _)]
    rw [← ENNReal.ofReal_add (norm_nonneg _)
      (Finset.sum_nonneg fun j _ => norm_nonneg _)]
    exact ENNReal.ofReal_le_ofReal hfixed
  calc
    ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean d =>
        surfaceFourier d (-r.1 • ξ) *
          phi (((2 : ℝ) ^ N)⁻¹ • (r.1 • ξ)) *
          𝓕 (f : Euclidean d → ℂ) ξ) x‖ ≤
        ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean d =>
          surfaceFourier d (-r.1 • ξ) * phi (r.1 • ξ) *
            𝓕 (f : Euclidean d → ℂ) ξ) x‖ +
          ∑ j ∈ Finset.range N, ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean d =>
            surfaceFourier d (-r.1 • ξ) *
              (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • ξ)) -
                phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ))) *
              𝓕 (f : Euclidean d → ℂ) ξ) x‖ := hfixed'
    _ ≤ (⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
        ‖𝓕⁻ (fun ξ : Euclidean d =>
          surfaceFourier d (-s.1 • ξ) * phi (s.1 • ξ) *
            𝓕 (f : Euclidean d → ℂ) ξ) x‖) +
          ∑ j ∈ Finset.range N, ⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
            ‖𝓕⁻ (fun ξ : Euclidean d =>
              surfaceFourier d (-s.1 • ξ) *
                (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s.1 • ξ)) -
                  phi (((2 : ℝ) ^ j)⁻¹ • (s.1 • ξ))) *
                𝓕 (f : Euclidean d → ℂ) ξ) x‖ := by
      apply add_le_add
      · exact le_iSup (fun s : ↥(E ∩ Ioi (0 : ℝ)) => ENNReal.ofReal
          ‖𝓕⁻ (fun ξ : Euclidean d =>
            surfaceFourier d (-s.1 • ξ) * phi (s.1 • ξ) *
              𝓕 (f : Euclidean d → ℂ) ξ) x‖) r
      · apply Finset.sum_le_sum
        intro j hj
        exact le_iSup (fun s : ↥(E ∩ Ioi (0 : ℝ)) => ENNReal.ofReal
          ‖𝓕⁻ (fun ξ : Euclidean d =>
            surfaceFourier d (-s.1 • ξ) *
              (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s.1 • ξ)) -
                phi (((2 : ℝ) ^ j)⁻¹ • (s.1 • ξ))) *
              𝓕 (f : Euclidean d → ℂ) ξ) x‖) r

/-- The literal finite restricted cutoff is measurable when the profile is
compactly supported.  The proof rewrites each fixed-radius multiplier as a
continuous scaled Schwartz multiplier before taking the supremum. -/
theorem measurable_restrictedRelativeCutoffSphericalMaximal
    {d : ℕ} (E : Set ℝ) (phi : SchwartzMap (Euclidean d) ℂ)
    (hphi_compact : HasCompactSupport (phi : Euclidean d → ℂ))
    (N : ℕ) (f : SchwartzMap (Euclidean d) ℂ) :
    Measurable (restrictedRelativeCutoffSphericalMaximal d E phi N f) := by
  let A₀ : Euclidean d ≃L[ℝ] Euclidean d :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 ((2 : ℝ) ^ N)⁻¹ (inv_ne_zero (pow_ne_zero N (by norm_num))))
  let psi : SchwartzMap (Euclidean d) ℂ :=
    SchwartzMap.compCLMOfContinuousLinearEquiv ℂ A₀ phi
  have hpsi (ξ : Euclidean d) : psi ξ = phi (((2 : ℝ) ^ N)⁻¹ • ξ) := by
    change phi (A₀ ξ) = _
    simp [A₀]
  have hpsi_compact : HasCompactSupport (psi : Euclidean d → ℂ) := by
    change HasCompactSupport ((phi : Euclidean d → ℂ) ∘
      (A₀.toHomeomorph : Euclidean d → Euclidean d))
    exact hphi_compact.comp_homeomorph A₀.toHomeomorph
  obtain ⟨chi, hchi⟩ :=
    exists_schwartz_compactSupport_mul_surfaceFourier psi hpsi_compact 1
  have hchi' (ξ : Euclidean d) :
      chi ξ = psi ξ * surfaceFourier d (-ξ) := by
    simpa using hchi ξ
  have hrewrite : restrictedRelativeCutoffSphericalMaximal d E phi N f =
      fun x : Euclidean d =>
        ⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
          ‖𝓕⁻ (fun ξ : Euclidean d =>
            chi (r.1 • ξ) * 𝓕 (f : Euclidean d → ℂ) ξ) x‖ := by
    funext x
    dsimp only [restrictedRelativeCutoffSphericalMaximal]
    apply iSup_congr
    intro r
    congr 2
    apply congrArg (fun g : Euclidean d → ℂ => 𝓕⁻ g x)
    funext ξ
    rw [hchi', hpsi]
    simp only [neg_smul]
    ring
  rw [hrewrite]
  apply LowerSemicontinuous.measurable
  apply lowerSemicontinuous_iSup
  intro r
  have hrinv : 0 < r.1⁻¹ := inv_pos.mpr r.2.2
  have hcont : Continuous (fun x : Euclidean d =>
      𝓕⁻ (fun ξ : Euclidean d => chi (r.1 • ξ) *
        𝓕 (f : Euclidean d → ℂ) ξ) x) := by
    simpa [inv_inv] using
      (continuous_fourierInv_scaled_schwartz_multiplier chi f hrinv)
  exact (ENNReal.continuous_ofReal.comp hcont.norm).lowerSemicontinuous

/-- The finite cutoff has the expected literal `Lᵖ` reassembly bound.  This
contains no operator abstraction: its two terms are precisely the displayed
lowpass and smooth band cutoffs above. -/
theorem eLpNorm_restrictedRelativeCutoff_le_lowpass_add_band_sum
    {d : ℕ} {p α : ℝ} (hp : 1 ≤ p) (E : Set ℝ)
    (phi : SchwartzMap (Euclidean d) ℂ)
    (hphi_compact : HasCompactSupport (phi : Euclidean d → ℂ))
    (N : ℕ) (f : SchwartzMap (Euclidean d) ℂ)
    (hlow : MemLp (restrictedRelativeLowpassSphericalMaximal d E phi f)
      (ENNReal.ofReal p) (powerWeightedVolume d α))
    (hband : ∀ j ∈ Finset.range N,
      MemLp (restrictedRelativeBandpassSphericalMaximal d E phi j f)
        (ENNReal.ofReal p) (powerWeightedVolume d α)) :
    MemLp (restrictedRelativeCutoffSphericalMaximal d E phi N f)
        (ENNReal.ofReal p) (powerWeightedVolume d α) ∧
      eLpNorm (restrictedRelativeCutoffSphericalMaximal d E phi N f)
          (ENNReal.ofReal p) (powerWeightedVolume d α) ≤
        eLpNorm (restrictedRelativeLowpassSphericalMaximal d E phi f)
            (ENNReal.ofReal p) (powerWeightedVolume d α) +
          ∑ j ∈ Finset.range N,
            eLpNorm (restrictedRelativeBandpassSphericalMaximal d E phi j f)
              (ENNReal.ofReal p) (powerWeightedVolume d α) := by
  let μ : Measure (Euclidean d) := powerWeightedVolume d α
  let L : Euclidean d → ENNReal :=
    restrictedRelativeLowpassSphericalMaximal d E phi f
  let B : ℕ → Euclidean d → ENNReal := fun j =>
    restrictedRelativeBandpassSphericalMaximal d E phi j f
  let P : Euclidean d → ENNReal :=
    restrictedRelativeCutoffSphericalMaximal d E phi N f
  let S : Euclidean d → ENNReal := fun x => ∑ j ∈ Finset.range N, B j x
  have hpENN : (1 : ENNReal) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]
    exact ENNReal.ofReal_le_ofReal hp
  have hSmem : MemLp S (ENNReal.ofReal p) μ := by
    change MemLp (fun x => ∑ j ∈ Finset.range N, B j x)
      (ENNReal.ofReal p) μ
    exact memLp_finsetSum (μ := μ) (p := ENNReal.ofReal p) (Finset.range N)
      (f := B) (fun j hj => hband j hj)
  have hLmem : MemLp L (ENNReal.ofReal p) μ := by
    simpa only [L] using hlow
  have hLSmem : MemLp (L + S) (ENNReal.ofReal p) μ := by
    exact hLmem.add hSmem
  have hPmeas : AEStronglyMeasurable P μ := by
    dsimp only [P]
    exact (measurable_restrictedRelativeCutoffSphericalMaximal E phi
      hphi_compact N f).aestronglyMeasurable
  have hpoint (x : Euclidean d) : P x ≤ L x + S x := by
    dsimp only [P, L, S, B]
    exact restrictedRelativeCutoffSphericalMaximal_le_lowpass_add_band_sum E phi N f x
  have hPmem : MemLp P (ENNReal.ofReal p) μ := by
    apply hLSmem.mono'_enorm hPmeas
    filter_upwards with x
    simpa only [enorm_eq_self, Pi.add_apply] using hpoint x
  refine ⟨hPmem, ?_⟩
  calc
    eLpNorm P (ENNReal.ofReal p) μ ≤ eLpNorm (L + S) (ENNReal.ofReal p) μ := by
      apply eLpNorm_mono_enorm
      intro x
      simpa only [enorm_eq_self, Pi.add_apply] using hpoint x
    _ ≤ eLpNorm L (ENNReal.ofReal p) μ + eLpNorm S (ENNReal.ofReal p) μ :=
      eLpNorm_add_le (by simpa only [L] using hlow.1) hSmem.1 hpENN
    _ ≤ eLpNorm L (ENNReal.ofReal p) μ +
        ∑ j ∈ Finset.range N, eLpNorm (B j) (ENNReal.ofReal p) μ := by
      apply add_le_add_right
      calc
        eLpNorm S (ENNReal.ofReal p) μ =
            eLpNorm (∑ j ∈ Finset.range N, B j) (ENNReal.ofReal p) μ := by
              apply eLpNorm_congr_ae
              filter_upwards with x
              simp only [S, Finset.sum_apply]
        _ ≤ ∑ j ∈ Finset.range N, eLpNorm (B j) (ENNReal.ofReal p) μ :=
          eLpNorm_sum_le (f := B) (s := Finset.range N)
            (fun j hj => (hband j hj).1) hpENN

/-- A finite relative cutoff has the expected moment estimate once the
literal lowpass term and its literal smooth dyadic bands have been bounded.
For a centrally supported input, the lowpass hypothesis is precisely the
one furnished by the central lowpass estimate; no maximal-operator wrapper
is introduced here. -/
theorem restrictedRelativeCutoff_lintegral_rpow_le_of_lowpass_and_band_bounds
    {d : ℕ} {p α : ℝ} (hp : 1 < p) (E : Set ℝ)
    (phi : SchwartzMap (Euclidean d) ℂ)
    (hphi_compact : HasCompactSupport (phi : Euclidean d → ℂ))
    (N : ℕ) (f : SchwartzMap (Euclidean d) ℂ)
    (lowConst : ENNReal) (bandConst : ℕ → ENNReal)
    (hlow :
      MemLp (restrictedRelativeLowpassSphericalMaximal d E phi f)
        (ENNReal.ofReal p) (powerWeightedVolume d α) ∧
      eLpNorm (restrictedRelativeLowpassSphericalMaximal d E phi f)
        (ENNReal.ofReal p) (powerWeightedVolume d α) ≤
        lowConst * eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p)
          (powerWeightedVolume d α))
    (hband : ∀ j ∈ Finset.range N,
      MemLp (restrictedRelativeBandpassSphericalMaximal d E phi j f)
        (ENNReal.ofReal p) (powerWeightedVolume d α) ∧
      eLpNorm (restrictedRelativeBandpassSphericalMaximal d E phi j f)
        (ENNReal.ofReal p) (powerWeightedVolume d α) ≤
        bandConst j * eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p)
          (powerWeightedVolume d α)) :
    AEMeasurable (fun x : Euclidean d =>
      (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p)
        (powerWeightedVolume d α) ∧
    (∫⁻ x : Euclidean d,
      (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p ∂
        powerWeightedVolume d α) ≤
      (lowConst + ∑ j ∈ Finset.range N, bandConst j) ^ p *
        ∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p ∂
          powerWeightedVolume d α := by
  let μ : Measure (Euclidean d) := powerWeightedVolume d α
  let P : Euclidean d → ENNReal :=
    restrictedRelativeCutoffSphericalMaximal d E phi N f
  let I : ENNReal := ∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p ∂μ
  let J : ENNReal := ∫⁻ x : Euclidean d, (P x) ^ p ∂μ
  let K : ENNReal := lowConst + ∑ j ∈ Finset.range N, bandConst j
  have hp0 : 0 < p := lt_trans zero_lt_one hp
  have hpNN : 0 ≤ p := hp0.le
  obtain ⟨hPmem, hPreassembly⟩ :=
    eLpNorm_restrictedRelativeCutoff_le_lowpass_add_band_sum hp.le E phi
      hphi_compact N f hlow.1 (fun j hj => (hband j hj).1)
  have hPnorm : eLpNorm P (ENNReal.ofReal p) μ = J ^ p⁻¹ := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
      (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top]
    simp only [ENNReal.toReal_ofReal hpNN, enorm_eq_self, J]
    rw [one_div]
  have hfnorm : eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p) μ = I ^ p⁻¹ := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
      (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top]
    simp only [ENNReal.toReal_ofReal hpNN, ofReal_norm, I]
    rw [one_div]
  have hnorm : eLpNorm P (ENNReal.ofReal p) μ ≤
      K * eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p) μ := by
    calc
      eLpNorm P (ENNReal.ofReal p) μ ≤
          eLpNorm (restrictedRelativeLowpassSphericalMaximal d E phi f)
              (ENNReal.ofReal p) μ +
            ∑ j ∈ Finset.range N,
              eLpNorm (restrictedRelativeBandpassSphericalMaximal d E phi j f)
                (ENNReal.ofReal p) μ := by
          simpa only [P, μ] using hPreassembly
      _ ≤ lowConst * eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p) μ +
            ∑ j ∈ Finset.range N,
              bandConst j * eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p) μ := by
          apply add_le_add hlow.2
          apply Finset.sum_le_sum
          intro j hj
          exact hband j hj |>.2
      _ = K * eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p) μ := by
          dsimp only [K]
          rw [add_mul, Finset.sum_mul]
  refine ⟨?_, ?_⟩
  · exact ENNReal.continuous_rpow_const.aemeasurable.comp_aemeasurable
      hPmem.1.aemeasurable
  · have hroot : J ^ p⁻¹ ≤ K * I ^ p⁻¹ := by
      simpa only [hPnorm, hfnorm] using hnorm
    calc
      J = (J ^ p⁻¹) ^ p := by
        rw [← ENNReal.rpow_mul, inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one]
      _ ≤ (K * I ^ p⁻¹) ^ p := ENNReal.rpow_le_rpow hroot hpNN
      _ = K ^ p * I := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hpNN, ← ENNReal.rpow_mul,
          inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one]
      _ = (lowConst + ∑ j ∈ Finset.range N, bandConst j) ^ p *
          ∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p ∂μ := by
        rfl

/-- The finite-cutoff estimate in the geometric form needed after choosing
strict entropy slack.  The hypotheses still name the literal lowpass and
relative band cutoffs; the only summation performed here is the elementary
geometric series. -/
theorem restrictedRelativeCutoff_lintegral_rpow_le_of_lowpass_and_geometric_band_bounds
    {d : ℕ} {p α : ℝ} (hp : 1 < p) (E : Set ℝ)
    (phi : SchwartzMap (Euclidean d) ℂ)
    (hphi_compact : HasCompactSupport (phi : Euclidean d → ℂ))
    (N : ℕ) (f : SchwartzMap (Euclidean d) ℂ)
    (lowConst bandConst rho : ENNReal)
    (hlowConst : lowConst ≠ ∞) (hbandConst : bandConst ≠ ∞)
    (hrho : rho < 1)
    (hlow :
      MemLp (restrictedRelativeLowpassSphericalMaximal d E phi f)
        (ENNReal.ofReal p) (powerWeightedVolume d α) ∧
      eLpNorm (restrictedRelativeLowpassSphericalMaximal d E phi f)
        (ENNReal.ofReal p) (powerWeightedVolume d α) ≤
        lowConst * eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p)
          (powerWeightedVolume d α))
    (hband : ∀ j ∈ Finset.range N,
      MemLp (restrictedRelativeBandpassSphericalMaximal d E phi j f)
        (ENNReal.ofReal p) (powerWeightedVolume d α) ∧
      eLpNorm (restrictedRelativeBandpassSphericalMaximal d E phi j f)
        (ENNReal.ofReal p) (powerWeightedVolume d α) ≤
        bandConst * rho ^ j * eLpNorm (f : Euclidean d → ℂ)
          (ENNReal.ofReal p) (powerWeightedVolume d α)) :
    AEMeasurable (fun x : Euclidean d =>
      (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p)
        (powerWeightedVolume d α) ∧
    (∫⁻ x : Euclidean d,
      (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p ∂
        powerWeightedVolume d α) ≤
      (lowConst + bandConst * (1 - rho)⁻¹) ^ p *
        ∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p ∂
          powerWeightedVolume d α ∧
    (lowConst + bandConst * (1 - rho)⁻¹) ^ p ≠ ∞ := by
  let K : ENNReal := lowConst + bandConst * (1 - rho)⁻¹
  have hp0 : 0 < p := lt_trans zero_lt_one hp
  have hsum : ∑ j ∈ Finset.range N, bandConst * rho ^ j ≤
      bandConst * (1 - rho)⁻¹ := by
    calc
      ∑ j ∈ Finset.range N, bandConst * rho ^ j =
          bandConst * ∑ j ∈ Finset.range N, rho ^ j := by
            rw [Finset.mul_sum]
      _ ≤ bandConst * ∑' j : ℕ, rho ^ j := by
            exact mul_le_mul_right (ENNReal.sum_le_tsum (Finset.range N)) bandConst
      _ = bandConst * (1 - rho)⁻¹ := by
            rw [ENNReal.tsum_geometric]
  have hKtop : K ≠ ∞ := by
    dsimp only [K]
    apply ENNReal.add_ne_top.mpr
    refine ⟨hlowConst, ENNReal.mul_ne_top hbandConst ?_⟩
    apply ENNReal.inv_ne_top.mpr
    exact (tsub_pos_iff_lt.mpr hrho).ne'
  have hfinite :=
    restrictedRelativeCutoff_lintegral_rpow_le_of_lowpass_and_band_bounds
      hp E phi hphi_compact N f lowConst (fun j => bandConst * rho ^ j)
      hlow hband
  refine ⟨hfinite.1, ?_, ENNReal.rpow_ne_top_of_nonneg hp0.le hKtop⟩
  calc
    (∫⁻ x : Euclidean d,
      (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p ∂
        powerWeightedVolume d α) ≤
        (lowConst + ∑ j ∈ Finset.range N, bandConst * rho ^ j) ^ p *
          ∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p ∂
            powerWeightedVolume d α := hfinite.2
    _ ≤ K ^ p *
        ∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p ∂
          powerWeightedVolume d α := by
        apply mul_le_mul_left
        refine ENNReal.rpow_le_rpow ?_ hp0.le
        dsimp only [K]
        exact add_le_add_right hsum lowConst
    _ = (lowConst + bandConst * (1 - rho)⁻¹) ^ p *
        ∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p ∂
          powerWeightedVolume d α := by rfl


/-- At a fixed positive radius, the literal relative cutoff multiplier tends
to the unnormalized spherical average. -/
theorem tendsto_relativeCutoffSphericalAverage
    {d : ℕ} (hd0 : 0 < d) (phi : SchwartzMap (Euclidean d) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (f : SchwartzMap (Euclidean d) ℂ) (r : ℝ) (x : Euclidean d) :
    Tendsto (fun N : ℕ =>
      𝓕⁻ (fun ξ : Euclidean d =>
        surfaceFourier d (-r • ξ) *
          phi (((2 : ℝ) ^ N)⁻¹ • (r • ξ)) *
            𝓕 (f : Euclidean d → ℂ) ξ) x) atTop
      (𝓝 (sphericalAverage d (f : Euclidean d → ℂ) r x)) := by
  have hmass : 0 < surfaceMass d := surfaceMass_pos hd0
  have hphi_bound (ξ : Euclidean d) : ‖phi ξ‖ ≤ ‖phi.toBoundedContinuousFunction‖ := by
    change ‖phi.toBoundedContinuousFunction ξ‖ ≤ ‖phi.toBoundedContinuousFunction‖
    exact BoundedContinuousFunction.norm_coe_le_norm _ _
  have hchar (ξ : Euclidean d) :
      ‖(Real.fourierChar (inner ℝ ξ x) : ℂ)‖ = 1 := by
    rw [Real.fourierChar_apply]
    exact Complex.norm_exp_ofReal_mul_I _
  have hchar_cont : Continuous
      (fun ξ : Euclidean d => (Real.fourierChar (inner ℝ ξ x) : ℂ)) :=
    (Real.continuous_fourierChar.comp
      (continuous_id.inner (continuous_const : Continuous fun _ : Euclidean d => x))
      |> continuous_subtype_val.comp)
  let F : ℕ → Euclidean d → ℂ := fun N ξ =>
    (Real.fourierChar (inner ℝ ξ x) : ℂ) *
      (surfaceFourier d (-r • ξ) *
        phi (((2 : ℝ) ^ N)⁻¹ • (r • ξ)) *
          𝓕 (f : Euclidean d → ℂ) ξ)
  let G : Euclidean d → ℂ := fun ξ =>
    (Real.fourierChar (inner ℝ ξ x) : ℂ) *
      (surfaceFourier d (-r • ξ) * 𝓕 (f : Euclidean d → ℂ) ξ)
  have hFmeas (N : ℕ) : AEStronglyMeasurable (F N) volume := by
    dsimp only [F]
    have hsurf : Continuous (fun ξ : Euclidean d => surfaceFourier d (-r • ξ)) :=
      (continuous_surfaceFourier d).comp
        ((continuous_const : Continuous fun _ : Euclidean d => -r).smul continuous_id)
    have hcut : Continuous (fun ξ : Euclidean d =>
        phi (((2 : ℝ) ^ N)⁻¹ • (r • ξ))) :=
      phi.continuous.comp
        ((continuous_const : Continuous fun _ : Euclidean d => ((2 : ℝ) ^ N)⁻¹).smul
          ((continuous_const : Continuous fun _ : Euclidean d => r).smul continuous_id))
    exact (hchar_cont.mul ((hsurf.mul hcut).mul (𝓕 f).continuous)).aestronglyMeasurable
  let B : ℝ := surfaceMass d * ‖phi.toBoundedContinuousFunction‖
  have hB : 0 ≤ B := by
    dsimp only [B]
    positivity
  have hbound_int : Integrable (fun ξ : Euclidean d =>
      B * ‖𝓕 (f : Euclidean d → ℂ) ξ‖) volume :=
    (𝓕 f).integrable.norm.const_mul B
  have hbound (N : ℕ) : ∀ᵐ ξ : Euclidean d ∂volume,
      ‖F N ξ‖ ≤ B * ‖𝓕 (f : Euclidean d → ℂ) ξ‖ := by
    filter_upwards with ξ
    dsimp only [F]
    rw [norm_mul, hchar, one_mul, norm_mul, norm_mul]
    apply mul_le_mul_of_nonneg_right
    · exact mul_le_mul
        (by simpa [surfaceMass] using
          norm_surfaceFourier_le_surfaceMass d (-r • ξ))
        (hphi_bound (((2 : ℝ) ^ N)⁻¹ • (r • ξ))) (norm_nonneg _) hmass.le
    · exact norm_nonneg _
  have hscale (ξ : Euclidean d) : Tendsto (fun N : ℕ =>
      ((2 : ℝ) ^ N)⁻¹ • (r • ξ)) atTop (𝓝 0) := by
    have hpow : Tendsto (fun N : ℕ => ((2 : ℝ)⁻¹) ^ N) atTop (𝓝 0) :=
      tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)
    have hconst : Tendsto (fun _ : ℕ => r • ξ) atTop (𝓝 (r • ξ)) :=
      tendsto_const_nhds
    simpa [inv_pow] using hpow.smul hconst
  have hphi_lim (ξ : Euclidean d) : Tendsto (fun N : ℕ =>
      phi (((2 : ℝ) ^ N)⁻¹ • (r • ξ))) atTop (𝓝 (1 : ℂ)) := by
    have hzero : phi (0 : Euclidean d) = 1 := hphi_one 0 (by simp)
    rw [← hzero]
    exact phi.continuous.tendsto 0 |>.comp (hscale ξ)
  have hFlim : ∀ᵐ ξ : Euclidean d ∂volume,
      Tendsto (fun N : ℕ => F N ξ) atTop (𝓝 (G ξ)) := by
    filter_upwards with ξ
    dsimp only [F, G]
    have hchar' : Tendsto
        (fun _ : ℕ => (Real.fourierChar (inner ℝ ξ x) : ℂ)) atTop
        (𝓝 (Real.fourierChar (inner ℝ ξ x) : ℂ)) := tendsto_const_nhds
    have hsurf' : Tendsto (fun _ : ℕ => surfaceFourier d (-r • ξ)) atTop
        (𝓝 (surfaceFourier d (-r • ξ))) := tendsto_const_nhds
    have hfourier' : Tendsto (fun _ : ℕ => 𝓕 (f : Euclidean d → ℂ) ξ) atTop
        (𝓝 (𝓕 (f : Euclidean d → ℂ) ξ)) := tendsto_const_nhds
    simpa using hchar'.mul ((hsurf'.mul (hphi_lim ξ)).mul hfourier')
  have hInt := tendsto_integral_of_dominated_convergence
    (F := F) (f := G) (fun ξ : Euclidean d =>
      B * ‖𝓕 (f : Euclidean d → ℂ) ξ‖)
    hFmeas hbound_int hbound hFlim
  rw [show (fun N : ℕ =>
      𝓕⁻ (fun ξ : Euclidean d =>
        surfaceFourier d (-r • ξ) *
          phi (((2 : ℝ) ^ N)⁻¹ • (r • ξ)) *
            𝓕 (f : Euclidean d → ℂ) ξ) x) =
      fun N => ∫ ξ : Euclidean d, F N ξ by
        funext N
        rw [Real.fourierInv_eq]
        rfl,
    show sphericalAverage d (f : Euclidean d → ℂ) r x = ∫ ξ : Euclidean d, G ξ by
      rw [sphericalAverage_eq_fourierInv_surfaceMultiplier_schwartz f r,
        Real.fourierInv_eq]
      rfl]
  exact hInt

/-- A fixed radius in the restricted cutoff is dominated by the cutoff
maximal function after taking a positive power. -/
theorem sphericalAverage_power_le_liminf_restrictedRelativeCutoff
    {d : ℕ} {p : ℝ} (hd0 : 0 < d) (hpNN : 0 ≤ p)
    (E : Set ℝ) (phi : SchwartzMap (Euclidean d) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (f : SchwartzMap (Euclidean d) ℂ)
    (r : ↥(E ∩ Ioi (0 : ℝ))) (x : Euclidean d) :
    ENNReal.ofReal (‖sphericalAverage d (f : Euclidean d → ℂ) r.1 x‖ ^ p) ≤
      liminf (fun N : ℕ =>
        (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p) atTop := by
  let W : ℕ → ℂ := fun N => 𝓕⁻ (fun ξ : Euclidean d =>
    surfaceFourier d (-r.1 • ξ) *
      phi (((2 : ℝ) ^ N)⁻¹ • (r.1 • ξ)) *
      𝓕 (f : Euclidean d → ℂ) ξ) x
  have hW : Tendsto W atTop
      (𝓝 (sphericalAverage d (f : Euclidean d → ℂ) r.1 x)) := by
    simpa only [W] using
      tendsto_relativeCutoffSphericalAverage hd0 phi hphi_one f r.1 x
  have hE : Tendsto (fun N : ℕ => ENNReal.ofReal ‖W N‖) atTop
      (𝓝 (ENNReal.ofReal ‖sphericalAverage d (f : Euclidean d → ℂ) r.1 x‖)) :=
    (ENNReal.continuous_ofReal.tendsto _).comp hW.norm
  have hPow : Tendsto (fun N : ℕ => (ENNReal.ofReal ‖W N‖) ^ p) atTop
      (𝓝 ((ENNReal.ofReal
        ‖sphericalAverage d (f : Euclidean d → ℂ) r.1 x‖) ^ p)) :=
    (ENNReal.continuous_rpow_const.tendsto _).comp hE
  have hPow' : Tendsto (fun N : ℕ => ENNReal.ofReal (‖W N‖ ^ p)) atTop
      (𝓝 (ENNReal.ofReal
        (‖sphericalAverage d (f : Euclidean d → ℂ) r.1 x‖ ^ p))) := by
    simpa only [ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hpNN] using hPow
  have hle (N : ℕ) : ENNReal.ofReal (‖W N‖ ^ p) ≤
      (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p := by
    rw [← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hpNN]
    apply ENNReal.rpow_le_rpow _ hpNN
    dsimp only [restrictedRelativeCutoffSphericalMaximal, W]
    exact le_iSup (fun s : ↥(E ∩ Ioi (0 : ℝ)) => ENNReal.ofReal
      ‖𝓕⁻ (fun ξ : Euclidean d =>
        surfaceFourier d (-s.1 • ξ) *
          phi (((2 : ℝ) ^ N)⁻¹ • (s.1 • ξ)) *
          𝓕 (f : Euclidean d → ℂ) ξ) x‖) r
  calc
    ENNReal.ofReal (‖sphericalAverage d (f : Euclidean d → ℂ) r.1 x‖ ^ p) =
        liminf (fun N : ℕ => ENNReal.ofReal (‖W N‖ ^ p)) atTop :=
      hPow'.liminf_eq.symm
    _ ≤ liminf (fun N : ℕ =>
        (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p) atTop :=
      Filter.liminf_le_liminf (Filter.Eventually.of_forall hle)

/-- The literal restricted cutoff controls the restricted normalized maximal
function pointwise after taking a positive power. -/
theorem restrictedNormalizedSphericalMaximal_power_le_liminf_relativeCutoff
    {d : ℕ} {p : ℝ} (hd0 : 0 < d) (hp0 : 0 < p) (hpNN : 0 ≤ p)
    (E : Set ℝ) (phi : SchwartzMap (Euclidean d) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x) ^ p ≤
      (ENNReal.ofReal ((surfaceMass d)⁻¹)) ^ p *
        liminf (fun N : ℕ =>
          (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p) atTop := by
  have hmass : 0 < surfaceMass d := surfaceMass_pos hd0
  let K : ENNReal := (ENNReal.ofReal ((surfaceMass d)⁻¹)) ^ p
  have hnorm (r : ℝ) :
      (ENNReal.ofReal ‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r x‖) ^ p =
        K * ENNReal.ofReal (‖sphericalAverage d (f : Euclidean d → ℂ) r x‖ ^ p) := by
    dsimp only [K]
    rw [normalizedSphericalAverage, norm_mul, norm_inv, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos hmass]
    rw [ENNReal.ofReal_mul (inv_nonneg.mpr hmass.le),
      ENNReal.mul_rpow_of_nonneg _ _ hpNN,
      ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hpNN]
  have hnormalfixed (r : ↥(E ∩ Ioi (0 : ℝ))) :
      (ENNReal.ofReal
          ‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖) ^ p ≤
        K * liminf (fun N : ℕ =>
          (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p) atTop := by
    rw [hnorm]
    exact mul_le_mul_right
      (sphericalAverage_power_le_liminf_restrictedRelativeCutoff hd0 hpNN E phi
        hphi_one f r x) K
  unfold restrictedNormalizedSphericalMaximal
  have hpowmax :
      (⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
        ENNReal.ofReal ‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖) ^ p =
        ⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
          (ENNReal.ofReal
            ‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖) ^ p := by
    let e : ENNReal ≃o ENNReal :=
      (ENNReal.strictMono_rpow_of_pos hp0).orderIsoOfSurjective _
        (ENNReal.rpow_left_bijective hp0.ne.symm).2
    change e (⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
      ENNReal.ofReal ‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖) =
        ⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
          e (ENNReal.ofReal
            ‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖)
    exact e.map_iSup _
  rw [hpowmax]
  apply iSup_le
  intro r
  exact hnormalfixed r

/-- A uniform moment estimate for the literal finite relative cutoffs passes
to the restricted normalized spherical maximal function.  This is the
weighted Fatou reassembly step used by the localized upper bound. -/
theorem restrictedNormalizedSphericalMaximal_lintegral_rpow_le_of_uniform_relativeCutoff
    {d : ℕ} {p α : ℝ} (hd0 : 0 < d) (hp0 : 0 < p)
    (E : Set ℝ) (phi : SchwartzMap (Euclidean d) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (A : ENNReal) (hAtop : A ≠ ⊤)
    (hfinite : ∀ (N : ℕ) (f : SchwartzMap (Euclidean d) ℂ),
      AEMeasurable (fun x : Euclidean d =>
        (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p)
          (powerWeightedVolume d α) ∧
      (∫⁻ x : Euclidean d,
        (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p ∂
          powerWeightedVolume d α) ≤
        A * ∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p ∂
          powerWeightedVolume d α)
    (f : SchwartzMap (Euclidean d) ℂ) :
    (∫⁻ x : Euclidean d,
      (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x) ^ p ∂
        powerWeightedVolume d α) ≤
      (ENNReal.ofReal ((surfaceMass d)⁻¹)) ^ p * A *
        ∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p ∂
          powerWeightedVolume d α := by
  have hpNN : 0 ≤ p := hp0.le
  let K : ENNReal := (ENNReal.ofReal ((surfaceMass d)⁻¹)) ^ p
  have hKtop : K ≠ ⊤ := by
    dsimp only [K]
    exact ENNReal.rpow_ne_top_of_nonneg hpNN ENNReal.ofReal_ne_top
  have hFatou :
      (∫⁻ x : Euclidean d,
        (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x) ^ p ∂
          powerWeightedVolume d α) ≤
        K * liminf (fun N : ℕ =>
          ∫⁻ x : Euclidean d,
            (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p ∂
              powerWeightedVolume d α) atTop := by
    calc
      (∫⁻ x : Euclidean d,
        (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x) ^ p ∂
          powerWeightedVolume d α) ≤
          ∫⁻ x : Euclidean d, K * liminf (fun N : ℕ =>
            (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p) atTop ∂
              powerWeightedVolume d α :=
        lintegral_mono (fun x =>
          restrictedNormalizedSphericalMaximal_power_le_liminf_relativeCutoff
            hd0 hp0 hpNN E phi hphi_one f x)
      _ = K * (∫⁻ x : Euclidean d,
          liminf (fun N : ℕ =>
            (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p) atTop ∂
              powerWeightedVolume d α) :=
        lintegral_const_mul' K _ hKtop
      _ ≤ K * liminf (fun N : ℕ =>
          ∫⁻ x : Euclidean d,
            (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p ∂
              powerWeightedVolume d α) atTop :=
        mul_le_mul_right
          (lintegral_liminf_le' fun N => (hfinite N f).1) K
  have hLiminf : liminf (fun N : ℕ =>
      ∫⁻ x : Euclidean d,
        (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p ∂
          powerWeightedVolume d α) atTop ≤
        A * ∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p ∂
          powerWeightedVolume d α :=
    Filter.liminf_le_of_frequently_le'
      (Filter.Frequently.of_forall fun N => (hfinite N f).2)
  calc
    (∫⁻ x : Euclidean d,
      (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x) ^ p ∂
        powerWeightedVolume d α) ≤
        K * liminf (fun N : ℕ =>
          ∫⁻ x : Euclidean d,
            (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p ∂
              powerWeightedVolume d α) atTop := hFatou
    _ ≤ K * (A * ∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p ∂
          powerWeightedVolume d α) := mul_le_mul_right hLiminf K
    _ = (ENNReal.ofReal ((surfaceMass d)⁻¹)) ^ p * A *
        ∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p ∂
          powerWeightedVolume d α := by
      simp only [K, mul_assoc]

/-- The preceding Fatou passage with the compact spatial hypothesis needed
by the global spatial-shell reassembly.  The finite cutoffs themselves are
not asserted to be spatially local; the support condition is imposed only on
the input to which their uniform estimate is applied. -/
theorem restrictedNormalizedSphericalMaximal_lintegral_rpow_le_of_uniform_relativeCutoff_on_annular_support
    {d : ℕ} {p α : ℝ} (hd0 : 0 < d) (hp0 : 0 < p)
    (E : Set ℝ) (phi : SchwartzMap (Euclidean d) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (A : ENNReal) (hAtop : A ≠ ⊤)
    (hfinite : ∀ (N : ℕ) (f : SchwartzMap (Euclidean d) ℂ),
      (∀ x : Euclidean d, x ∉ euclideanAnnulus d (1 / 4 : ℝ) 8 → f x = 0) →
      AEMeasurable (fun x : Euclidean d =>
        (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p)
          (powerWeightedVolume d α) ∧
      (∫⁻ x : Euclidean d,
        (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p ∂
          powerWeightedVolume d α) ≤
        A * ∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p ∂
          powerWeightedVolume d α)
    (f : SchwartzMap (Euclidean d) ℂ)
    (hfsupport : ∀ x : Euclidean d,
      x ∉ euclideanAnnulus d (1 / 4 : ℝ) 8 → f x = 0) :
    (∫⁻ x : Euclidean d,
      (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x) ^ p ∂
        powerWeightedVolume d α) ≤
      (ENNReal.ofReal ((surfaceMass d)⁻¹)) ^ p * A *
        ∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p ∂
          powerWeightedVolume d α := by
  have hpNN : 0 ≤ p := hp0.le
  let K : ENNReal := (ENNReal.ofReal ((surfaceMass d)⁻¹)) ^ p
  have hKtop : K ≠ ⊤ := by
    dsimp only [K]
    exact ENNReal.rpow_ne_top_of_nonneg hpNN ENNReal.ofReal_ne_top
  have hFatou :
      (∫⁻ x : Euclidean d,
        (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x) ^ p ∂
          powerWeightedVolume d α) ≤
        K * liminf (fun N : ℕ =>
          ∫⁻ x : Euclidean d,
            (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p ∂
              powerWeightedVolume d α) atTop := by
    calc
      (∫⁻ x : Euclidean d,
        (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x) ^ p ∂
          powerWeightedVolume d α) ≤
          ∫⁻ x : Euclidean d, K * liminf (fun N : ℕ =>
            (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p) atTop ∂
              powerWeightedVolume d α :=
        lintegral_mono (fun x =>
          restrictedNormalizedSphericalMaximal_power_le_liminf_relativeCutoff
            hd0 hp0 hpNN E phi hphi_one f x)
      _ = K * (∫⁻ x : Euclidean d,
          liminf (fun N : ℕ =>
            (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p) atTop ∂
              powerWeightedVolume d α) :=
        lintegral_const_mul' K _ hKtop
      _ ≤ K * liminf (fun N : ℕ =>
          ∫⁻ x : Euclidean d,
            (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p ∂
              powerWeightedVolume d α) atTop :=
        mul_le_mul_right
          (lintegral_liminf_le' fun N => (hfinite N f hfsupport).1) K
  have hLiminf : liminf (fun N : ℕ =>
      ∫⁻ x : Euclidean d,
        (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p ∂
          powerWeightedVolume d α) atTop ≤
        A * ∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p ∂
          powerWeightedVolume d α :=
    Filter.liminf_le_of_frequently_le'
      (Filter.Frequently.of_forall fun N => (hfinite N f hfsupport).2)
  calc
    (∫⁻ x : Euclidean d,
      (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x) ^ p ∂
        powerWeightedVolume d α) ≤
        K * liminf (fun N : ℕ =>
          ∫⁻ x : Euclidean d,
            (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p ∂
              powerWeightedVolume d α) atTop := hFatou
    _ ≤ K * (A * ∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p ∂
          powerWeightedVolume d α) := mul_le_mul_right hLiminf K
    _ = (ENNReal.ofReal ((surfaceMass d)⁻¹)) ^ p * A *
        ∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p ∂
          powerWeightedVolume d α := by
      simp only [K, mul_assoc]

/-- The literal finite-cutoff moment premise gives the project's restricted
weighted strong-type predicate.  The constant is intentionally chosen only
after the cutoff estimate has been supplied. -/
theorem hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_of_uniform_relativeCutoff
    {d : ℕ} {p α : ℝ} (hd0 : 0 < d) (hp0 : 0 < p)
    (E : Set ℝ) (phi : SchwartzMap (Euclidean d) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (A : ENNReal) (hAtop : A ≠ ⊤)
    (hfinite : ∀ (N : ℕ) (f : SchwartzMap (Euclidean d) ℂ),
      AEMeasurable (fun x : Euclidean d =>
        (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p)
          (powerWeightedVolume d α) ∧
      (∫⁻ x : Euclidean d,
        (restrictedRelativeCutoffSphericalMaximal d E phi N f x) ^ p ∂
          powerWeightedVolume d α) ≤
        A * ∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p ∂
          powerWeightedVolume d α) :
    HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E p α := by
  have hpNN : 0 ≤ p := hp0.le
  have hpInvNN : 0 ≤ p⁻¹ := inv_nonneg.mpr hpNN
  let K : ENNReal := (ENNReal.ofReal ((surfaceMass d)⁻¹)) ^ p
  have hKtop : K ≠ ⊤ := by
    dsimp only [K]
    exact ENNReal.rpow_ne_top_of_nonneg hpNN ENNReal.ofReal_ne_top
  let D : ENNReal := K ^ p⁻¹ * A ^ p⁻¹
  have hDtop : D ≠ ⊤ := by
    dsimp only [D]
    apply ENNReal.mul_ne_top
    · exact ENNReal.rpow_ne_top_of_nonneg hpInvNN hKtop
    · exact ENNReal.rpow_ne_top_of_nonneg hpInvNN hAtop
  let C : ℝ := D.toReal + 1
  have hC : 0 < C := by
    dsimp only [C]
    positivity
  refine ⟨C, hC, ?_⟩
  intro f hf
  let μ : Measure (Euclidean d) := powerWeightedVolume d α
  let M : Euclidean d → ENNReal :=
    restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ)
  let I : ENNReal := ∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p ∂μ
  have hmoment : (∫⁻ x : Euclidean d, (M x) ^ p ∂μ) ≤ K * A * I := by
    simpa only [M, I, μ, K] using
      restrictedNormalizedSphericalMaximal_lintegral_rpow_le_of_uniform_relativeCutoff
        hd0 hp0 E phi hphi_one A hAtop hfinite f
  have hMnorm : eLpNorm M (ENNReal.ofReal p) μ =
      (∫⁻ x : Euclidean d, (M x) ^ p ∂μ) ^ p⁻¹ := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
      (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top]
    simp only [ENNReal.toReal_ofReal hpNN, enorm_eq_self]
    rw [one_div]
  have hInorm : eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p) μ = I ^ p⁻¹ := by
    dsimp only [I]
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
      (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top]
    simp only [ENNReal.toReal_ofReal hpNN, ofReal_norm]
    rw [one_div]
  have hnormD : eLpNorm M (ENNReal.ofReal p) μ ≤
      D * eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p) μ := by
    rw [hMnorm, hInorm]
    calc
      (∫⁻ x : Euclidean d, (M x) ^ p ∂μ) ^ p⁻¹ ≤
          (K * A * I) ^ p⁻¹ := ENNReal.rpow_le_rpow hmoment hpInvNN
      _ = D * I ^ p⁻¹ := by
        dsimp only [D]
        rw [ENNReal.mul_rpow_of_nonneg _ _ hpInvNN,
          ENNReal.mul_rpow_of_nonneg _ _ hpInvNN]
  have hDleC : D ≤ ENNReal.ofReal C := by
    calc
      D = ENNReal.ofReal D.toReal := (ENNReal.ofReal_toReal hDtop).symm
      _ ≤ ENNReal.ofReal C := by
        apply ENNReal.ofReal_le_ofReal
        dsimp only [C]
        exact le_add_of_nonneg_right zero_le_one
  have hnorm : eLpNorm M (ENNReal.ofReal p) μ ≤
      ENNReal.ofReal C * eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p) μ :=
    hnormD.trans (by
      simpa only [mul_comm] using
        mul_le_mul_of_nonneg_right hDleC
          (bot_le : 0 ≤ eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p) μ))
  have hMtop : eLpNorm M (ENNReal.ofReal p) μ < ⊤ :=
    lt_of_le_of_lt hnorm
      (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hf.eLpNorm_lt_top)
  have hMmeas : AEStronglyMeasurable M μ := by
    dsimp only [M]
    exact (measurable_restrictedNormalizedSphericalMaximal_schwartz E f).aestronglyMeasurable
  exact ⟨⟨hMmeas, hMtop⟩, hnorm⟩

end

end Codex.Spherical.PowerWeights.LocalizedUpper