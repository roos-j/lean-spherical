      apply (div_le_div_iff_of_pos_right hlogtwo).2
      exact Real.strictMonoOn_log.monotoneOn u.2 v.2 huv
    have hsep' : (δ : ℝ) / 2 < logRadius v - logRadius u := by
      rw [abs_of_nonpos (sub_nonpos.mpr hloguv)] at huvsep
      linarith
    have hdiff : Real.log 2 * ((δ : ℝ) / 2) <
        Real.log (v : ℝ) - Real.log (u : ℝ) := by
      apply (div_lt_div_iff_of_pos_right hlogtwo).mp
      calc
        (Real.log 2 * ((δ : ℝ) / 2)) / Real.log 2 = (δ : ℝ) / 2 := by
          field_simp
