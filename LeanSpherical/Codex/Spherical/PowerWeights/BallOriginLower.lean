/-- Every radius in a unit multiplicative interval is at least half its
centre.  This deliberately weak form is enough for the log-to-physical
separation conversion below. -/
theorem half_center_le_radius_of_mem_unitMultiplicativeInterval
    (c : PositiveRadius) {r : PositiveRadius}
    (hr : (r : ℝ) ∈ multiplicativeInterval c 1) :
    (c : ℝ) / 2 ≤ (r : ℝ) := by
  have hrlog : |Real.log (r : ℝ) / Real.log 2 - logRadius c| ≤ (1 : ℝ) / 2 :=
    hr.2
  have hlog : logRadius c - (1 : ℝ) / 2 ≤ logRadius r := by
    change logRadius c - (1 : ℝ) / 2 ≤ Real.log (r : ℝ) / Real.log 2
    have h := (abs_le.mp hrlog).1
    linarith
  have hmono :=
    (Real.strictMono_rpow_of_base_gt_one (by norm_num : (1 : ℝ) < 2)).monotone
  have hpow : (2 : ℝ) ^ (logRadius c - (1 : ℝ) / 2) ≤
      (2 : ℝ) ^ logRadius r := hmono hlog
  rw [two_rpow_logRadius] at hpow
  have hhalf : (1 : ℝ) / 2 ≤ (2 : ℝ) ^ (-(1 : ℝ) / 2) := by
    rw [show (1 : ℝ) / 2 = (2 : ℝ) ^ (-(1 : ℝ)) by
      norm_num [Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2)]]
    apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
    norm_num
  have hcpos : 0 < (c : ℝ) := c.2
  calc
    (c : ℝ) / 2 = (c : ℝ) * ((1 : ℝ) / 2) := by ring
    _ ≤ (c : ℝ) * (2 : ℝ) ^ (-(1 : ℝ) / 2) :=
      mul_le_mul_of_nonneg_left hhalf hcpos.le
    _ = (2 : ℝ) ^ (logRadius c - (1 : ℝ) / 2) := by
      rw [Real.rpow_sub (by norm_num : (0 : ℝ) < 2), two_rpow_logRadius]
      rw [show (-(1 : ℝ) / 2) = -((1 : ℝ) / 2) by ring,
        Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2)]
      simp [div_eq_mul_inv]
    _ ≤ (r : ℝ) := hpow

/-- Every radius in a unit multiplicative interval is at most twice its
centre.  Together with the preceding lower bound this is the only size
information about the interval used in the origin-ball parameter choice. -/
theorem radius_le_two_center_of_mem_unitMultiplicativeInterval
    (c : PositiveRadius) {r : PositiveRadius}
    (hr : (r : ℝ) ∈ multiplicativeInterval c 1) :
    (r : ℝ) ≤ 2 * (c : ℝ) := by
  have hrlog : |Real.log (r : ℝ) / Real.log 2 - logRadius c| ≤ (1 : ℝ) / 2 :=
    hr.2
  have hlog : logRadius r ≤ logRadius c + (1 : ℝ) / 2 := by
    change Real.log (r : ℝ) / Real.log 2 ≤ logRadius c + (1 : ℝ) / 2
    have h := (abs_le.mp hrlog).2
    linarith
  have hmono :=
    (Real.strictMono_rpow_of_base_gt_one (by norm_num : (1 : ℝ) < 2)).monotone
  have hpow : (2 : ℝ) ^ logRadius r ≤
      (2 : ℝ) ^ (logRadius c + (1 : ℝ) / 2) := hmono hlog
  rw [two_rpow_logRadius] at hpow
  have hhalf : (2 : ℝ) ^ ((1 : ℝ) / 2) ≤ 2 := by
    calc
      (2 : ℝ) ^ ((1 : ℝ) / 2) ≤ (2 : ℝ) ^ (1 : ℝ) := by
        apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
        norm_num
      _ = 2 := Real.rpow_one _
  have hcpos : 0 < (c : ℝ) := c.2
  calc
    (r : ℝ) ≤ (2 : ℝ) ^ (logRadius c + (1 : ℝ) / 2) := hpow
    _ = (c : ℝ) * (2 : ℝ) ^ ((1 : ℝ) / 2) := by
      rw [Real.rpow_add (by norm_num : (0 : ℝ) < 2), two_rpow_logRadius]
    _ ≤ (c : ℝ) * 2 := mul_le_mul_of_nonneg_left hhalf hcpos.le
    _ = 2 * (c : ℝ) := by ring

