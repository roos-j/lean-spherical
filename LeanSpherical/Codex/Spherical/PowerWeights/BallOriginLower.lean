      (∀ r : PositiveRadius, (r : ℝ) ∈ F →
        ∃ t ∈ T, |logRadius r - logRadius t| ≤ (δ : ℝ) / 2) ∧
      Metric.IsSeparated (((δ / 2 : ℝ≥0) : ℝ≥0∞))
        (logRadius '' (↑T : Set PositiveRadius)) ∧
      (∀ r ∈ T, ∀ s ∈ T, r ≠ s →
        (c : ℝ) * Real.log 2 * (δ : ℝ) / 4 < |(r : ℝ) - (s : ℝ)|) := by
