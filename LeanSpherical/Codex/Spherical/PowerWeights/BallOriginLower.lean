    have hrA : logRadius r ∈ A := ⟨r, hrF, rfl⟩
    obtain ⟨u, huC, hdist⟩ := hCcover hrA
    refine ⟨radiusOfLog u, ?_, ?_⟩
    · apply Finset.mem_image.mpr
      refine ⟨u, ?_, rfl⟩
      change u ∈ hCfinite.toFinset
      exact hCfinite.mem_toFinset.mpr huC
    · rw [hlog_radiusOfLog]
      change edist (logRadius r) u ≤ (ε : ℝ≥0∞) at hdist
      rw [edist_dist] at hdist
      have hdist' : dist (logRadius r) u ≤ (ε : ℝ) :=
        ENNReal.ofReal_le_coe.mp hdist
      simpa only [Real.dist_eq, ε, NNReal.coe_div, NNReal.coe_ofNat] using hdist'
  · have hlogT : logRadius '' (↑T : Set PositiveRadius) = C := by
      ext u
      constructor
      · rintro ⟨r, hrT, rfl⟩
        rcases Finset.mem_image.mp hrT with ⟨v, hvS, rfl⟩
        rw [hlog_radiusOfLog]
        change v ∈ C
        change v ∈ hCfinite.toFinset at hvS
        exact hCfinite.mem_toFinset.mp hvS
      · intro huC
        have huS : u ∈ S := by
          change u ∈ hCfinite.toFinset
          exact hCfinite.mem_toFinset.mpr huC
        refine ⟨radiusOfLog u, Finset.mem_image.mpr ⟨u, huS, rfl⟩, ?_⟩
        exact hlog_radiusOfLog u
    rw [hlogT]
    exact hCsep
  · intro r hrT s hsT hrs
    rcases Finset.mem_image.mp hrT with ⟨u, huS, hru⟩
    rcases Finset.mem_image.mp hsT with ⟨v, hvS, hsv⟩
    subst r
    subst s
    have huC : u ∈ C := by
      change u ∈ hCfinite.toFinset at huS
      exact hCfinite.mem_toFinset.mp huS
    have hvC : v ∈ C := by
      change v ∈ hCfinite.toFinset at hvS
      exact hCfinite.mem_toFinset.mp hvS
    have huv : u ≠ v := by
      intro huv
      apply hrs
      simp only [huv]
    have huvsep : (ε : ℝ≥0∞) < edist u v := hCsep huC hvC huv
    have huvsep' : (δ : ℝ) / 2 < |u - v| := by
      rw [edist_dist] at huvsep
      have huvsep'' : (ε : ℝ) < dist u v := by
        apply (ENNReal.ofReal_lt_ofReal_iff_of_nonneg (by positivity)).mp
        simpa only [ENNReal.ofReal_coe_nnreal] using huvsep
      simpa only [ε, NNReal.coe_div, NNReal.coe_ofNat, Real.dist_eq] using huvsep''
    apply physical_separation_of_logRadius_separation c hδ
    · apply hF
      apply hT
      exact Finset.mem_image.mpr ⟨u, huS, rfl⟩
    · apply hF
      apply hT
      exact Finset.mem_image.mpr ⟨v, hvS, rfl⟩
    · simpa only [hlog_radiusOfLog] using huvsep'

/-- The same packing construction works in every multiplicative interval of
diameter at most one.  The physical separation is measured at the ambient
centre, which is exactly the scale required by the graph-tube test. -/
theorem exists_finset_multiplicative_packing
    (F : Set ℝ) (c : PositiveRadius) (diam δ : ℝ≥0) (hδ : 0 < δ)
    (hdiam : diam ≤ 1) (hF : F ⊆ multiplicativeInterval c diam) :
    ∃ T : Finset PositiveRadius,
      (∀ r ∈ T, (r : ℝ) ∈ F) ∧
      (∀ r : PositiveRadius, (r : ℝ) ∈ F →
        ∃ t ∈ T, |logRadius r - logRadius t| ≤ (δ : ℝ) / 2) ∧
      Metric.IsSeparated (((δ / 2 : ℝ≥0) : ℝ≥0∞))
        (logRadius '' (↑T : Set PositiveRadius)) ∧
      (∀ r ∈ T, ∀ s ∈ T, r ≠ s →
        (c : ℝ) * Real.log 2 * (δ : ℝ) / 4 < |(r : ℝ) - (s : ℝ)|) := by
  apply exists_finset_unitMultiplicative_packing F c δ hδ
  intro r hr
  refine ⟨(hF hr).1, ?_⟩
  change |Real.log r / Real.log 2 - logRadius c| ≤ (1 : ℝ) / 2
  calc
    |Real.log r / Real.log 2 - logRadius c| ≤ (diam : ℝ) / 2 := (hF hr).2
    _ ≤ (1 : ℝ) / 2 := by
      apply div_le_div_of_nonneg_right
      · exact_mod_cast hdiam
      · norm_num

theorem measurableSet_radialShell (d : ℕ) (r b : ℝ) :
    MeasurableSet (radialShell d r b) := by
  unfold radialShell
  exact (continuous_norm.sub continuous_const).abs.isOpen_preimage _ isOpen_Iio |>.measurableSet

/-- The closed-ball scaling formula in the Euclidean spaces used by the
origin-ball input. -/
theorem volume_closedBall_scale {d : ℕ} (hd : 0 < d) {R : ℝ} :
    volume (closedBall (0 : Euclidean d) R) =
      (ENNReal.ofReal R) ^ d * volume (closedBall (0 : Euclidean d) 1) := by
  letI : Nonempty (Fin d) := Fin.pos_iff_nonempty.mp hd
  rw [EuclideanSpace.volume_closedBall, EuclideanSpace.volume_closedBall]
  simp only [Fintype.card_fin, ENNReal.ofReal_one, one_pow, one_mul]

theorem disjoint_radialShell_of_radius_separated (d : ℕ) {r s b : ℝ}
    (hsep : 2 * b ≤ |r - s|) :
    Disjoint (radialShell d r b) (radialShell d s b) := by
  rw [Set.disjoint_left]
  intro x hxr hxs
  change |‖x‖ - r| < b at hxr
  change |‖x‖ - s| < b at hxs
  have hclose : |r - s| < 2 * b := by
    calc
      |r - s| = |(r - ‖x‖) + (‖x‖ - s)| := by congr 1; ring
      _ ≤ |r - ‖x‖| + |‖x‖ - s| := abs_add_le _ _
      _ = |‖x‖ - r| + |‖x‖ - s| := by rw [abs_sub_comm]
      _ < b + b := add_lt_add hxr hxs
      _ = 2 * b := by ring
  exact (not_lt_of_ge hsep) hclose

/-- A graph tube based on the radius-`r` sphere is contained in the radial
shell of the same thickness.  Its horizontal aperture can therefore supply
the full `rⁿ b` output volume in the origin-ball test. -/
theorem graphTube_subset_radialShell (n : ℕ) {r ρ b : ℝ}
    (hr : 0 ≤ r) (hρr : ρ ≤ r) :
    graphTube n r 0 ρ b ⊆ radialShell (n + 1) r b := by
  intro x hx
  rcases (mem_graphTube_iff n r 0 ρ b x).1 hx with ⟨hhor, hvert⟩
  let z : Euclidean n := (succCoordinates n x).1
  let t : ℝ := (succCoordinates n x).2
  let y : Euclidean (n + 1) := joinCoordinates n (z, graphHeight r 0 z)
  have hz : ‖z‖ ≤ r :=
    (le_of_lt (by simpa only [z] using hhor)).trans hρr
  have hradic : 0 ≤ r ^ 2 - ‖z‖ ^ 2 := by
    nlinarith [norm_nonneg z]
  have hynormsq : ‖y‖ ^ 2 = r ^ 2 := by
    have hsq := norm_sq_succCoordinates n y
    rw [succCoordinates_joinCoordinates] at hsq
    change ‖y‖ ^ 2 = ‖z‖ ^ 2 + graphHeight r 0 z ^ 2 at hsq
    unfold graphHeight at hsq
    nlinarith [Real.sq_sqrt hradic]
  have hynorm : ‖y‖ = r := by
    have hy0 : 0 ≤ ‖y‖ := norm_nonneg _
    nlinarith
  have hcoords : succCoordinates n (x - y) =
      (0, t - graphHeight r 0 z) := by
    rw [succCoordinates_sub, succCoordinates_joinCoordinates]
    apply Prod.ext
    · dsimp only [z]
      simp
    · dsimp only [z, t]
      rfl
  have hdiffsq : ‖x - y‖ ^ 2 = (t - graphHeight r 0 z) ^ 2 := by
    have hsq := norm_sq_succCoordinates n (x - y)
    rw [hcoords] at hsq
    norm_num at hsq
    linarith
  have hdiff : ‖x - y‖ = |t - graphHeight r 0 z| := by
    have hleft : 0 ≤ ‖x - y‖ := norm_nonneg _
    have hright : 0 ≤ |t - graphHeight r 0 z| := abs_nonneg _
    nlinarith [sq_abs (t - graphHeight r 0 z)]
  change |‖x‖ - r| < b
  calc
    |‖x‖ - r| = |‖x‖ - ‖y‖| := by rw [hynorm]
    _ ≤ ‖x - y‖ := abs_norm_sub_norm_le _ _
    _ = |t - graphHeight r 0 z| := hdiff
    _ < b := by simpa only [t, z] using hvert

/-- A nonnegative power weight is bounded below once the norm is bounded
below. -/
theorem radialPowerWeight_ge_of_norm_lower_nonneg
    {d : ℕ} {α L : ℝ} (hα : 0 ≤ α) {x : Euclidean d}
    (hx : L ≤ ‖x‖) :
    (ENNReal.ofReal L) ^ α ≤ radialPowerWeight d α x := by
  unfold radialPowerWeight
  exact ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal hx) hα

/-- The weighted measure of a measurable set is bounded below by its volume
times a nonnegative power weight at any lower radial bound. -/
theorem powerWeightedVolume_set_lower_of_norm_lower_nonneg
    {d : ℕ} {α L : ℝ} (hα : 0 ≤ α) {S : Set (Euclidean d)}
    (hS : MeasurableSet S) (hL : ∀ x ∈ S, L ≤ ‖x‖) :
    (ENNReal.ofReal L) ^ α * volume S ≤ powerWeightedVolume d α S := by
  rw [powerWeightedVolume, withDensity_apply _ hS]
  calc
    (ENNReal.ofReal L) ^ α * volume S =
        ∫⁻ _x in S, (ENNReal.ofReal L) ^ α := (setLIntegral_const _ _).symm
    _ ≤ ∫⁻ x in S, radialPowerWeight d α x := by
      apply setLIntegral_mono (measurable_radialPowerWeight d α)
      intro x hx
      exact radialPowerWeight_ge_of_norm_lower_nonneg hα (hL x hx)

/-- The graph-tube output has the expected `r^α ρⁿ b` lower size for a
nonnegative weight when it is used as a patch of a radial shell. -/
theorem powerWeightedVolume_graphTube_lower_of_nonneg
    (n : ℕ) {α r ρ b : ℝ} (hα : 0 ≤ α) (hr : 0 ≤ r) (hρr : ρ ≤ r) :
    (ENNReal.ofReal (r - b)) ^ α *
        (volume (ball (0 : Euclidean n) ρ) * ENNReal.ofReal (2 * b)) ≤
      powerWeightedVolume (n + 1) α (graphTube n r 0 ρ b) := by
  calc
    (ENNReal.ofReal (r - b)) ^ α *
        (volume (ball (0 : Euclidean n) ρ) * ENNReal.ofReal (2 * b)) =
        (ENNReal.ofReal (r - b)) ^ α * volume (graphTube n r 0 ρ b) := by
      rw [volume_graphTube]
    _ ≤ powerWeightedVolume (n + 1) α (graphTube n r 0 ρ b) := by
      apply powerWeightedVolume_set_lower_of_norm_lower_nonneg hα
        (measurableSet_graphTube n r 0 ρ b)
      intro x hx
      have hshell := graphTube_subset_radialShell n hr hρr hx
      change |‖x‖ - r| < b at hshell
      rcases abs_lt.mp hshell with ⟨hlow, _⟩
      linarith

/-- A chordal cap around the inward radial direction sends a point in a thin
radial shell into the origin-centred input ball. -/
theorem inwardRadial_cap_translate_subset_ball
    {n : ℕ} {r b h R : ℝ} (hr : 0 < r) (hinner : b < r)
    (hmargin : b + r * h ≤ R) {x : Euclidean (n + 1)}
    (hx : x ∈ radialShell (n + 1) r b)
    {w : sphere (0 : Euclidean (n + 1)) 1}
    (hw : w ∈ sphericalCap n (inwardRadialDirection x) h) :
    x + r • (w : Euclidean (n + 1)) ∈ ball (0 : Euclidean (n + 1)) R := by
  have hxshell : |‖x‖ - r| < b := hx
  have hxnorm : 0 < ‖x‖ := by
    have : r - b < ‖x‖ := by
      rcases abs_lt.mp hxshell with ⟨hlow, _⟩
      linarith
    linarith
  let δ : Euclidean (n + 1) := (w : Euclidean (n + 1)) - inwardRadialDirection x
  have hδ : ‖δ‖ < h := by
    change dist (w : Euclidean (n + 1)) (inwardRadialDirection x) < h at hw
    simpa only [δ, dist_eq_norm] using hw
  have hsplit : x + r • (w : Euclidean (n + 1)) =
      (x + r • inwardRadialDirection x) + r • δ := by
    dsimp only [δ]
    module
  have hcentre : ‖x + r • inwardRadialDirection x‖ = |‖x‖ - r| := by
    unfold inwardRadialDirection
    have hrewrite : x + r • (-(‖x‖⁻¹ • x)) =
        (1 - r * ‖x‖⁻¹) • x := by
      module
    rw [hrewrite, norm_smul, Real.norm_eq_abs]
    have hnormnonneg : 0 ≤ ‖x‖ := norm_nonneg _
    calc
      |1 - r * ‖x‖⁻¹| * ‖x‖ = |1 - r * ‖x‖⁻¹| * |‖x‖| := by
        rw [abs_of_nonneg hnormnonneg]
      _ = |(1 - r * ‖x‖⁻¹) * ‖x‖| := (abs_mul _ _).symm
      _ = |‖x‖ - r| := by
        congr 1
        field_simp [hxnorm.ne']
  rw [Metric.mem_ball, dist_zero_right]
  calc
    ‖x + r • (w : Euclidean (n + 1))‖ =
        ‖(x + r • inwardRadialDirection x) + r • δ‖ := by rw [hsplit]
    _ ≤ ‖x + r • inwardRadialDirection x‖ + ‖r • δ‖ := norm_add_le _ _
    _ = |‖x‖ - r| + r * ‖δ‖ := by
      rw [hcentre, norm_smul, Real.norm_eq_abs, abs_of_pos hr]
    _ < b + r * h := by
      exact add_lt_add hxshell (mul_lt_mul_of_pos_left hδ hr)
    _ ≤ R := hmargin

/-- The moving-cap lower bound for a small origin-centred input ball on one
radial shell. -/
theorem radialShell_cap_average_lower (n : ℕ) (hn : 2 ≤ n)
    {r b h R : ℝ} (hr : 0 < r) (hinner : b < r)
    (hmargin : b + r * h ≤ R) (hh : 0 < h) (hhone : h ≤ 1)
    (g : Euclidean (n + 1) → ℝ) (hgContinuous : Continuous g)
    (hgnonneg : ∀ y, 0 ≤ g y)
    (hg_one : ∀ y, ‖y‖ ≤ R → g y = 1)
    {x : Euclidean (n + 1)} (hx : x ∈ radialShell (n + 1) r b) :
    (ENNReal.ofReal (surfaceMass n) *
        ((ENNReal.ofReal (h / 2)) ^ (n - 2) * ENNReal.ofReal (h ^ 2 / 4))) /
        ENNReal.ofReal (surfaceMass (n + 1)) ≤
      ENNReal.ofReal ‖normalizedSphericalAverage (n + 1)
        (fun y => (g y : ℂ)) r x‖ := by
  have hxshell : |‖x‖ - r| < b := hx
  have hxnorm : 0 < ‖x‖ := by
    have : r - b < ‖x‖ := by
      rcases abs_lt.mp hxshell with ⟨hlow, _⟩
      linarith
    linarith
  have hdir : ‖inwardRadialDirection x‖ = 1 :=
    norm_inwardRadialDirection hxnorm
  have hgi : Integrable (fun w : sphere (0 : Euclidean (n + 1)) 1 =>
      g (x + r • (w : Euclidean (n + 1))))
      (unitSurfaceMeasure (n + 1)) := by
    have hcont : Continuous (fun w : sphere (0 : Euclidean (n + 1)) 1 =>
        g (x + r • (w : Euclidean (n + 1)))) := by
      apply hgContinuous.comp
      fun_prop
    exact hcont.integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  apply poleCap_lower_le_ennreal_norm_normalizedSphericalAverage
    hn g r x hdir hh hhone hgi
  · intro w
    exact hgnonneg _
  · intro w hw
    apply hg_one
    have hmem := inwardRadial_cap_translate_subset_ball (n := n)
      hr hinner hmargin hx hw
    rw [Metric.mem_ball, dist_zero_right] at hmem
    exact hmem.le

/-- The nonnegative smooth ball cutoff has weighted input norm controlled by
the literal doubled input ball. -/
theorem eLpNorm_nonnegative_ball_cutoff_le
    (d : ℕ) {p α R : ℝ} (hp0 : ENNReal.ofReal p ≠ 0)
    (g : Euclidean d → ℝ) (f : SchwartzMap (Euclidean d) ℂ)
    (hfg : ∀ y, f y = (g y : ℂ))
    (hgnonneg : ∀ y, 0 ≤ g y) (hgle_one : ∀ y, g y ≤ 1)
    (hsupport : ∀ y, 2 * R ≤ ‖y‖ → g y = 0) :
    eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p)
        (powerWeightedVolume d α) ≤
      (powerWeightedVolume d α (closedBall (0 : Euclidean d) (2 * R))) ^
        (1 / (ENNReal.ofReal p).toReal) := by
  let D : Set (Euclidean d) := closedBall 0 (2 * R)
  have hD : MeasurableSet D := measurableSet_closedBall
  calc
    eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p)
        (powerWeightedVolume d α) ≤
      eLpNorm (D.indicator (fun _ : Euclidean d => (1 : ℂ)))
        (ENNReal.ofReal p) (powerWeightedVolume d α) := by
      apply eLpNorm_mono
      intro y
      by_cases hy : y ∈ D
      · rw [indicator_of_mem hy, hfg]
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hgnonneg y)]
        simpa using hgle_one y
      · rw [indicator_of_notMem hy, hfg]
        have hnorm : 2 * R ≤ ‖y‖ := by
          rw [Metric.mem_closedBall, dist_zero_right] at hy
          exact le_of_lt (lt_of_not_ge hy)
        rw [hsupport y hnorm]
        norm_num
    _ = (powerWeightedVolume d α D) ^
        (1 / (ENNReal.ofReal p).toReal) := by
      rw [eLpNorm_indicator_const hD hp0 ENNReal.ofReal_ne_top]
      norm_num [enorm]
    _ = (powerWeightedVolume d α (closedBall (0 : Euclidean d) (2 * R))) ^
        (1 / (ENNReal.ofReal p).toReal) := by rfl

/-- The finite ball-at-origin test with a fixed strong-type constant.  The
output is exactly the union of the disjoint radial shells associated to the
selected radii. -/
theorem restrictedStrongType_ballOrigin_finite_lower_of_bound
    (n : ℕ) (hn : 2 ≤ n) {E : Set ℝ} {p α C : ℝ}
    (hstrong : ∀ f : SchwartzMap (Euclidean (n + 1)) ℂ,
      MemLp (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p)
        (powerWeightedVolume (n + 1) α) →
        MemLp (restrictedNormalizedSphericalMaximal (n + 1) E
          (f : Euclidean (n + 1) → ℂ)) (ENNReal.ofReal p)
          (powerWeightedVolume (n + 1) α) ∧
        eLpNorm (restrictedNormalizedSphericalMaximal (n + 1) E
          (f : Euclidean (n + 1) → ℂ)) (ENNReal.ofReal p)
          (powerWeightedVolume (n + 1) α) ≤
          ENNReal.ofReal C * eLpNorm (f : Euclidean (n + 1) → ℂ)
            (ENNReal.ofReal p) (powerWeightedVolume (n + 1) α))
    (T : Finset PositiveRadius) {b h R : ℝ} {m : ℝ≥0∞}
    (hT : ∀ r ∈ T, (r : ℝ) ∈ E)
    (hsep : ∀ r ∈ T, ∀ s ∈ T, r ≠ s → 2 * b ≤ |(r : ℝ) - (s : ℝ)|)
    (hm : ∀ r ∈ T, m ≤ powerWeightedVolume (n + 1) α
      (radialShell (n + 1) (r : ℝ) b))
    (hppos : 0 < p) (hRpos : 0 < R) (hh : 0 < h) (hhone : h ≤ 1)
    (hinner : ∀ r ∈ T, b < (r : ℝ))
    (hmargin : ∀ r ∈ T, b + (r : ℝ) * h ≤ R)
    (hDfinite : powerWeightedVolume (n + 1) α
      (closedBall (0 : Euclidean (n + 1)) (2 * R)) ≠ (∞ : ℝ≥0∞)) :
    ((ENNReal.ofReal (surfaceMass n) *
        ((ENNReal.ofReal (h / 2)) ^ (n - 2) * ENNReal.ofReal (h ^ 2 / 4))) /
        ENNReal.ofReal (surfaceMass (n + 1))) *
      ((T.card : ℝ≥0∞) * m) ^ (1 / (ENNReal.ofReal p).toReal) ≤
      ENNReal.ofReal C *
        (powerWeightedVolume (n + 1) α
          (closedBall (0 : Euclidean (n + 1)) (2 * R))) ^
            (1 / (ENNReal.ofReal p).toReal) := by
  classical
  let D : Set (Euclidean (n + 1)) := closedBall 0 (2 * R)
  let U : PositiveRadius → Set (Euclidean (n + 1)) :=
    fun r => radialShell (n + 1) (r : ℝ) b
  let V : Set (Euclidean (n + 1)) := ⋃ r ∈ (↑T : Set PositiveRadius), U r
  rcases exists_schwartz_nonnegative_ball_test (n + 1) hRpos with
    ⟨g, f, hfg, hgcont, hgnonneg, hgleone, hgone, hzero⟩
  have hp0 : ENNReal.ofReal p ≠ 0 := ne_of_gt (ENNReal.ofReal_pos.mpr hppos)
  have hinput : eLpNorm (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p)
      (powerWeightedVolume (n + 1) α) ≤
      (powerWeightedVolume (n + 1) α D) ^
        (1 / (ENNReal.ofReal p).toReal) := by
    dsimp only [D]
    exact eLpNorm_nonnegative_ball_cutoff_le (n + 1) hp0 g f hfg
      hgnonneg hgleone hzero
  have hq : 0 ≤ 1 / (ENNReal.ofReal p).toReal := by
    rw [ENNReal.toReal_ofReal hppos.le]
    positivity
  have hf : MemLp (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p)
      (powerWeightedVolume (n + 1) α) := by
    refine ⟨f.continuous.aestronglyMeasurable, ?_⟩
    refine lt_of_le_of_lt hinput ?_
    exact ENNReal.rpow_lt_top_of_nonneg hq (by simpa only [D] using hDfinite)
  have hUmeas : ∀ r ∈ T, MeasurableSet (U r) := by
    intro r hr
    exact measurableSet_radialShell (n + 1) (r : ℝ) b
  have hUdisjoint : (↑T : Set PositiveRadius).PairwiseDisjoint U := by
    intro r hr s hs hrs
    change Disjoint (U r) (U s)
    exact disjoint_radialShell_of_radius_separated (n + 1)
      (hsep r (by simpa using hr) s (by simpa using hs) hrs)
  have hVmeas : MeasurableSet V := by
    dsimp only [V]
    exact T.measurableSet_biUnion hUmeas
  have hpoint : ∀ x ∈ V,
      (ENNReal.ofReal (surfaceMass n) *
          ((ENNReal.ofReal (h / 2)) ^ (n - 2) * ENNReal.ofReal (h ^ 2 / 4))) /
          ENNReal.ofReal (surfaceMass (n + 1)) ≤
        restrictedNormalizedSphericalMaximal (n + 1) E
          (f : Euclidean (n + 1) → ℂ) x := by
    intro x hx
    rcases Set.mem_iUnion.mp hx with ⟨r, hx⟩
    rcases Set.mem_iUnion.mp hx with ⟨hrT, hxr⟩
    calc
      (ENNReal.ofReal (surfaceMass n) *
          ((ENNReal.ofReal (h / 2)) ^ (n - 2) * ENNReal.ofReal (h ^ 2 / 4))) /
          ENNReal.ofReal (surfaceMass (n + 1)) ≤
          ENNReal.ofReal ‖normalizedSphericalAverage (n + 1)
            (fun y => (g y : ℂ)) (r : ℝ) x‖ :=
        radialShell_cap_average_lower n hn r.2 (hinner r hrT) (hmargin r hrT)
          hh hhone g hgcont hgnonneg hgone hxr
      _ = ENNReal.ofReal ‖normalizedSphericalAverage (n + 1)
          (f : Euclidean (n + 1) → ℂ) (r : ℝ) x‖ := by
        have hfun : (fun y : Euclidean (n + 1) => (g y : ℂ)) =
            (f : Euclidean (n + 1) → ℂ) := by
          funext y
          exact (hfg y).symm
        rw [hfun]
      _ ≤ restrictedNormalizedSphericalMaximal (n + 1) E
          (f : Euclidean (n + 1) → ℂ) x :=
        ennreal_norm_normalizedSphericalAverage_le_restrictedNormalizedSphericalMaximal
          f (hT r hrT) r.2 x
  have hvolume : (T.card : ℝ≥0∞) * m ≤ powerWeightedVolume (n + 1) α V := by
    calc
      (T.card : ℝ≥0∞) * m = ∑ r ∈ T, m := by simp [mul_comm]
      _ ≤ ∑ r ∈ T, powerWeightedVolume (n + 1) α (U r) := by
        gcongr with r hr
        exact hm r hr
      _ = powerWeightedVolume (n + 1) α V := by
        dsimp only [V]
        exact (measure_biUnion_finset hUdisjoint hUmeas).symm
  have hbound := restrictedStrongType_knapp_entropy_test_bound_of_bound
    hstrong (f := f) hf hVmeas hpoint hinput hvolume hppos
  simpa only [D] using hbound

/-- Existential-constant form of the finite origin-ball test. -/
theorem restrictedStrongType_ballOrigin_finite_lower
    (n : ℕ) (hn : 2 ≤ n) {E : Set ℝ} {p α : ℝ}
    (hstrong : HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType
      (n + 1) E p α)
    (T : Finset PositiveRadius) {b h R : ℝ} {m : ℝ≥0∞}
    (hT : ∀ r ∈ T, (r : ℝ) ∈ E)
    (hsep : ∀ r ∈ T, ∀ s ∈ T, r ≠ s → 2 * b ≤ |(r : ℝ) - (s : ℝ)|)
    (hm : ∀ r ∈ T, m ≤ powerWeightedVolume (n + 1) α
      (radialShell (n + 1) (r : ℝ) b))
    (hppos : 0 < p) (hRpos : 0 < R) (hh : 0 < h) (hhone : h ≤ 1)
    (hinner : ∀ r ∈ T, b < (r : ℝ))
    (hmargin : ∀ r ∈ T, b + (r : ℝ) * h ≤ R)
    (hDfinite : powerWeightedVolume (n + 1) α
      (closedBall (0 : Euclidean (n + 1)) (2 * R)) ≠ (∞ : ℝ≥0∞)) :
    ∃ C : ℝ, 0 < C ∧
      ((ENNReal.ofReal (surfaceMass n) *
          ((ENNReal.ofReal (h / 2)) ^ (n - 2) * ENNReal.ofReal (h ^ 2 / 4))) /
          ENNReal.ofReal (surfaceMass (n + 1))) *
        ((T.card : ℝ≥0∞) * m) ^ (1 / (ENNReal.ofReal p).toReal) ≤
        ENNReal.ofReal C *
          (powerWeightedVolume (n + 1) α
            (closedBall (0 : Euclidean (n + 1)) (2 * R))) ^
              (1 / (ENNReal.ofReal p).toReal) := by
  rcases hstrong with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  exact restrictedStrongType_ballOrigin_finite_lower_of_bound n hn hbound T
    hT hsep hm hppos hRpos hh hhone hinner hmargin hDfinite

/-- The ball-at-origin lower test with the cardinality of a finite radial
packing replaced by the local multiplicative entropy at the same scale.

The net condition is deliberately stated with radius `δ / 2`: this is exactly
the covering radius in the definition of `localMultiplicativeEntropy E c diam
δ`.  The separation hypothesis remains in physical radius because it is what
makes the radial shells disjoint. -/
theorem restrictedStrongType_ballOrigin_localEntropy_lower_of_bound
    (n : ℕ) (hn : 2 ≤ n) {E : Set ℝ} {p α C : ℝ}
    (hstrong : ∀ f : SchwartzMap (Euclidean (n + 1)) ℂ,
      MemLp (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p)
        (powerWeightedVolume (n + 1) α) →
        MemLp (restrictedNormalizedSphericalMaximal (n + 1) E
          (f : Euclidean (n + 1) → ℂ)) (ENNReal.ofReal p)
          (powerWeightedVolume (n + 1) α) ∧
        eLpNorm (restrictedNormalizedSphericalMaximal (n + 1) E
          (f : Euclidean (n + 1) → ℂ)) (ENNReal.ofReal p)
          (powerWeightedVolume (n + 1) α) ≤
          ENNReal.ofReal C * eLpNorm (f : Euclidean (n + 1) → ℂ)
            (ENNReal.ofReal p) (powerWeightedVolume (n + 1) α))
    (c : PositiveRadius) (diam δ : ℝ≥0) (T : Finset PositiveRadius)
    {b h R : ℝ} {m : ℝ≥0∞}
    (hT : ∀ r ∈ T, (r : ℝ) ∈ E ∩ multiplicativeInterval c diam)
    (hnet : ∀ r : PositiveRadius, (r : ℝ) ∈ E ∩ multiplicativeInterval c diam →
      ∃ t ∈ T, |logRadius r - logRadius t| ≤ ((δ : ℝ≥0) : ℝ) / 2)
    (hsep : ∀ r ∈ T, ∀ s ∈ T, r ≠ s → 2 * b ≤ |(r : ℝ) - (s : ℝ)|)
    (hm : ∀ r ∈ T, m ≤ powerWeightedVolume (n + 1) α
      (radialShell (n + 1) (r : ℝ) b))
    (hppos : 0 < p) (hRpos : 0 < R) (hh : 0 < h) (hhone : h ≤ 1)
    (hinner : ∀ r ∈ T, b < (r : ℝ))
    (hmargin : ∀ r ∈ T, b + (r : ℝ) * h ≤ R)
    (hDfinite : powerWeightedVolume (n + 1) α
      (closedBall (0 : Euclidean (n + 1)) (2 * R)) ≠ (∞ : ℝ≥0∞)) :
    ((ENNReal.ofReal (surfaceMass n) *
        ((ENNReal.ofReal (h / 2)) ^ (n - 2) * ENNReal.ofReal (h ^ 2 / 4))) /
        ENNReal.ofReal (surfaceMass (n + 1))) *
      ((localMultiplicativeEntropy E c diam δ).toENNReal * m) ^
        (1 / (ENNReal.ofReal p).toReal) ≤
      ENNReal.ofReal C *
        (powerWeightedVolume (n + 1) α
          (closedBall (0 : Euclidean (n + 1)) (2 * R))) ^
            (1 / (ENNReal.ofReal p).toReal) := by
  classical
  let F : Set ℝ := E ∩ multiplicativeInterval c diam
  let centers : Set ℝ := logRadius '' (↑T : Set PositiveRadius)
  have hcover : Metric.IsCover (δ / 2) (logRadiusSet F) centers := by
    rintro u ⟨r, hrF, rfl⟩
    obtain ⟨t, htT, hrt⟩ := hnet r (by simpa only [F] using hrF)
    refine ⟨logRadius t, ⟨t, htT, rfl⟩, ?_⟩
    change edist (logRadius r) (logRadius t) ≤ ((δ / 2 : ℝ≥0) : ℝ≥0∞)
    rw [edist_dist]
    apply ENNReal.ofReal_le_coe.mpr
    simpa only [Real.dist_eq, NNReal.coe_div, NNReal.coe_ofNat] using hrt
  have hCcard : centers.encard = T.card := by
    have hC : centers = (↑(T.image logRadius) : Set ℝ) := by
      ext u
      simp [centers]
    rw [hC, Set.encard_coe_eq_coe_finsetCard,
      Finset.card_image_of_injective T logRadius_injective]
  have hentropyENat : localMultiplicativeEntropy E c diam δ ≤ T.card := by
    change Metric.externalCoveringNumber (δ / 2) (logRadiusSet F) ≤ T.card
    rw [← hCcard]
    exact hcover.externalCoveringNumber_le_encard
  have hentropy : (localMultiplicativeEntropy E c diam δ).toENNReal ≤
      (T.card : ℝ≥0∞) := by
    exact_mod_cast ENat.toENNReal_mono hentropyENat
  have hq : 0 ≤ 1 / (ENNReal.ofReal p).toReal := by
    rw [ENNReal.toReal_ofReal hppos.le]
    positivity
  have hbound :=
    restrictedStrongType_ballOrigin_finite_lower_of_bound n hn hstrong T
      (fun r hr => (hT r hr).1) hsep hm hppos hRpos hh hhone hinner hmargin hDfinite
  calc
    ((ENNReal.ofReal (surfaceMass n) *
          ((ENNReal.ofReal (h / 2)) ^ (n - 2) * ENNReal.ofReal (h ^ 2 / 4))) /
          ENNReal.ofReal (surfaceMass (n + 1))) *
        ((localMultiplicativeEntropy E c diam δ).toENNReal * m) ^
          (1 / (ENNReal.ofReal p).toReal) ≤
        ((ENNReal.ofReal (surfaceMass n) *
          ((ENNReal.ofReal (h / 2)) ^ (n - 2) * ENNReal.ofReal (h ^ 2 / 4))) /
          ENNReal.ofReal (surfaceMass (n + 1))) *
        ((T.card : ℝ≥0∞) * m) ^ (1 / (ENNReal.ofReal p).toReal) := by
      gcongr
    _ ≤ ENNReal.ofReal C *
        (powerWeightedVolume (n + 1) α
          (closedBall (0 : Euclidean (n + 1)) (2 * R))) ^
            (1 / (ENNReal.ofReal p).toReal) := hbound

/-- Existential-constant form of the local entropy origin-ball test. -/
theorem restrictedStrongType_ballOrigin_localEntropy_lower
    (n : ℕ) (hn : 2 ≤ n) {E : Set ℝ} {p α : ℝ}
    (hstrong : HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType
      (n + 1) E p α)
    (c : PositiveRadius) (diam δ : ℝ≥0) (T : Finset PositiveRadius)
    {b h R : ℝ} {m : ℝ≥0∞}
    (hT : ∀ r ∈ T, (r : ℝ) ∈ E ∩ multiplicativeInterval c diam)
    (hnet : ∀ r : PositiveRadius, (r : ℝ) ∈ E ∩ multiplicativeInterval c diam →
      ∃ t ∈ T, |logRadius r - logRadius t| ≤ ((δ : ℝ≥0) : ℝ) / 2)
    (hsep : ∀ r ∈ T, ∀ s ∈ T, r ≠ s → 2 * b ≤ |(r : ℝ) - (s : ℝ)|)
    (hm : ∀ r ∈ T, m ≤ powerWeightedVolume (n + 1) α
      (radialShell (n + 1) (r : ℝ) b))
    (hppos : 0 < p) (hRpos : 0 < R) (hh : 0 < h) (hhone : h ≤ 1)
    (hinner : ∀ r ∈ T, b < (r : ℝ))
    (hmargin : ∀ r ∈ T, b + (r : ℝ) * h ≤ R)
    (hDfinite : powerWeightedVolume (n + 1) α
      (closedBall (0 : Euclidean (n + 1)) (2 * R)) ≠ (∞ : ℝ≥0∞)) :
    ∃ C : ℝ, 0 < C ∧
      ((ENNReal.ofReal (surfaceMass n) *
          ((ENNReal.ofReal (h / 2)) ^ (n - 2) * ENNReal.ofReal (h ^ 2 / 4))) /
          ENNReal.ofReal (surfaceMass (n + 1))) *
        ((localMultiplicativeEntropy E c diam δ).toENNReal * m) ^
          (1 / (ENNReal.ofReal p).toReal) ≤
        ENNReal.ofReal C *
          (powerWeightedVolume (n + 1) α
            (closedBall (0 : Euclidean (n + 1)) (2 * R))) ^
              (1 / (ENNReal.ofReal p).toReal) := by
  rcases hstrong with ⟨C, hC, hbound⟩
