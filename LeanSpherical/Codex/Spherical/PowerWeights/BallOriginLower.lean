      (u : ℝ) ∈ multiplicativeInterval c 1 → (u : ℝ) ≤ (v : ℝ) →
      ((δ : ℝ) / 2) < |logRadius u - logRadius v| →
      (c : ℝ) * Real.log 2 * (δ : ℝ) / 4 < (v : ℝ) - (u : ℝ) := by
    intro u v hu huv huvsep
    have hupos : 0 < (u : ℝ) := u.2
