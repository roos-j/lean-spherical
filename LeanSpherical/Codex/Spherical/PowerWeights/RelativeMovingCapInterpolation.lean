  have hf_mem : f ∈ 𝒟 := hfsupport
  have hTf : AEMeasurable (T f) μ := hTmeas f hf_mem
  obtain ⟨low, high, hlow, hhigh, hsplit⟩ :=
    exists_schwartz_rational_low_high_family f
  have hlow_zero (t : ℝ) (x : Euclidean (n + 1)) (hx : x ∉ B) : low t x = 0 := by
