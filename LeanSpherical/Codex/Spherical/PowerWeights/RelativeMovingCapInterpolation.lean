      _ = ∫⁻ x in A, ENNReal.ofReal
          ((restrictedRelativeBandpassSphericalMaximal (n + 1) (R : Set ℝ) phi j g x).toReal ^
            (2 : ℕ)) ∂ν := by
        rw [show (fun x : Euclidean (n + 1) => ENNReal.ofReal ((T g x) ^ (2 : ℕ))) =
          A.indicator (fun x => ENNReal.ofReal
            ((restrictedRelativeBandpassSphericalMaximal (n + 1) (R : Set ℝ) phi j g x).toReal ^
