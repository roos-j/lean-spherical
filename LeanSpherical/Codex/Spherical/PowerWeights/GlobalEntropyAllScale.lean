        ‖𝓕⁻ (fun xi : Euclidean (d + 1) =>
          surfaceFourier (d + 1) (-r.1 • xi) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
            𝓕 (f : Euclidean (d + 1) → ℂ) xi) x‖ ≤ u k x := by
      rw [hraw_eq]
      have hG : ‖G k r.1 x‖ ≤ v k x :=
        hG_le_v k x ⟨r.1, hrEblock⟩
      simpa only [G, huv] using hG
    have hTnonneg : 0 ≤
        (Finset.Icc (-((n : ℤ))) (n : ℤ)).sup'
          (by refine ⟨0, ?_⟩; simp) (fun l => u l x) := by
      obtain ⟨l, hl, hsup⟩ :=
        (Finset.Icc (-((n : ℤ))) (n : ℤ)).exists_mem_eq_sup'
          (by refine ⟨0, ?_⟩; simp) (fun l => u l x)
      rw [hsup]
      exact hu_nonneg l x
    have hle :
        ‖𝓕⁻ (fun xi : Euclidean (d + 1) =>
          surfaceFourier (d + 1) (-r.1 • xi) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
            𝓕 (f : Euclidean (d + 1) → ℂ) xi) x‖ ≤
        (Finset.Icc (-((n : ℤ))) (n : ℤ)).sup'
          (by refine ⟨0, ?_⟩; simp) (fun l => u l x) :=
      hterm.trans (Finset.le_sup' (fun l => u l x) hkN)
    exact le_iSup_of_le n (ENNReal.ofReal_le_ofReal
      ((sq_le_sq₀ (norm_nonneg _) hTnonneg).mpr hle))
  have hQlin : (∫⁻ x, Q x) ≤ ENNReal.ofReal B := by
    calc
      (∫⁻ x, Q x) ≤ ∫⁻ x, ⨆ n : ℕ, ENNReal.ofReal
          (((Finset.Icc (-((n : ℤ))) (n : ℤ)).sup'
            (by refine ⟨0, ?_⟩; simp) (fun k => u k x)) ^ 2) :=
        lintegral_mono hcover
      _ ≤ ENNReal.ofReal B := htrunc
  constructor
  · simpa only [B, L, J] using hB
  · simpa only [Q, B, L, J] using hQlin

/-- The sharp entropy square estimate in a directly usable `L²` form for
the literal restricted relative band.  Its constant is uniform over all
physical dyadic radius blocks of `E`. -/
theorem memLp_two_restrictedRelativeBandpassSphericalMaximal_global_of_unitEntropy
    {d : Nat} (hd : 2 ≤ d) (C0 C1 : ℝ) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ xi : Euclidean (d + 1), 1 ≤ ‖xi‖ →
      ‖surfaceFourier (d + 1) xi‖ ≤ C0 / ‖xi‖ ^ ((d : ℝ) / 2))
    (hderiv : ∀ xi : Euclidean (d + 1), ∀ r : ℝ, 1 ≤ ‖xi‖ →
      r ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun s : ℝ => surfaceFourier (d + 1) (s • xi)) r‖ ≤
        C1 / ‖xi‖ ^ ((d : ℝ) / 2 - 1))
    (phi f : SchwartzMap (Euclidean (d + 1)) ℂ)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1)
    (j : Nat) (E : Set ℝ) (hEne : E.Nonempty) (hEpos : E ⊆ Ioi (0 : ℝ))
    (δ : ℝ≥0) (N : ℕ) (hN : unitMultiplicativeEntropy E δ ≤ N)
    (hδ : Real.log 2 * (δ : ℝ) ≤ 1) :
    MemLp (fun x =>
      (restrictedRelativeBandpassSphericalMaximal (d + 1) E phi j f x).toReal) 2 volume ∧
      (∫ x : Euclidean (d + 1),
        ‖(restrictedRelativeBandpassSphericalMaximal (d + 1) E phi j f x).toReal‖ ^ 2) ≤
        24 * (N : ℝ) *
          (2 * ((4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)) ^ 2 +
            2 * (8 * Real.log 2 * (δ : ℝ)) ^ 2 *
              (2 * (
                ((4 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1) +
                  (12 * C0 *
                    ‖((SchwartzMap.fderivCLM ℂ
                      (Euclidean (d + 1)) ℂ) phi).toBoundedContinuousFunction‖) /
                    (dyadicScale j) ^ ((d : ℝ) / 2)))) ^ 2) *
          (∫ x : Euclidean (d + 1), ‖f x‖ ^ 2) := by
  let F : ↥(E ∩ Ioi (0 : ℝ)) → Euclidean (d + 1) → ℂ := fun r x =>
    𝓕⁻ (fun xi : Euclidean (d + 1) =>
      surfaceFourier (d + 1) (-r.1 • xi) *
        (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
          phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
        𝓕 (f : Euclidean (d + 1) → ℂ) xi) x
  let Q : Euclidean (d + 1) → ENNReal := fun x =>
    ⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal (‖F r x‖ ^ 2)
  let T : Euclidean (d + 1) → ℝ := fun x =>
    (⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal ‖F r x‖).toReal
  obtain ⟨hB, hQlin⟩ :=
    raw_square_iSup_restricted_relative_dyadic_moving_bandpass_global_of_unitEntropy
      hd C0 C1 hC0 hC1 hdecay hderiv phi f hphi_one hphi_zero hphi_norm
      j E hEne hEpos δ N hN hδ
  have hQlin' : (∫⁻ x, Q x) ≤
      ENNReal.ofReal
        (24 * (N : ℝ) *
          (2 * ((4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)) ^ 2 +
            2 * (8 * Real.log 2 * (δ : ℝ)) ^ 2 *
              (2 * (
                ((4 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1) +
                  (12 * C0 *
                    ‖((SchwartzMap.fderivCLM ℂ
                      (Euclidean (d + 1)) ℂ) phi).toBoundedContinuousFunction‖) /
                    (dyadicScale j) ^ ((d : ℝ) / 2)))) ^ 2) *
          (∫ x : Euclidean (d + 1), ‖f x‖ ^ 2)) := by
    simpa only [Q, F] using hQlin
  have hmeas := measurable_restricted_raw_relative_dyadic_maxima
    phi f hphi_one hphi_zero j E
  have hQmeas : Measurable Q := by
    simpa only [Q, F] using hmeas.1
  have hTmeas : AEMeasurable T volume := by
    have hTmeas' : Measurable T := by
      simpa only [T, F] using hmeas.2
    exact hTmeas'.aemeasurable
  have hresult := memLp_two_toReal_iSup_ennreal_norm_of_sq_lintegral
    F hQmeas hTmeas hB hQlin'
  simpa only [F, T, restrictedRelativeBandpassSphericalMaximal] using hresult

end

