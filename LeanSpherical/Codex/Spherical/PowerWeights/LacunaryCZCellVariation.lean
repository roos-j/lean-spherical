  apply ENNReal.tendsto_ofReal
  exact ((tendsto_lacunaryRelativeBandpassPhysicalTerm_of_tendsto_toLp psi j
    (lt_of_lt_of_le ha har) x f g hg2 hfg).sub
      (tendsto_lacunaryRelativeBandpassPhysicalTerm_of_tendsto_toLp psi j ha x f g hg2 hfg)).norm.pow 2

private theorem finite_cell_iSup_le_liminf
    {ι : Type*} (I : Finset ι) (a b : ι → ℝ)
    (_ha : ∀ q ∈ I, 0 < a q) (hab : ∀ q ∈ I, a q ≤ b q)
    (F : ℕ → ι → ℝ → ENNReal) (F0 : ι → ℝ → ENNReal)
    (hconv : ∀ q ∈ I, ∀ t : Icc (a q) (b q),
      Tendsto (fun n => F n q t.1) atTop (𝓝 (F0 q t.1))) :
    (∑ q ∈ I, ⨆ t : Icc (a q) (b q), F0 q t.1) ≤
      liminf (fun n => ∑ q ∈ I, ⨆ t : Icc (a q) (b q), F n q t.1) atTop := by
  classical
  let κ : (↥I) → Type _ := fun q => Icc (a q.1) (b q.1)
  letI : ∀ q : (↥I), Nonempty (κ q) := fun q => by
    rcases nonempty_Icc.mpr (hab q.1 q.2) with ⟨t, ht⟩
    exact ⟨⟨t, by simpa only [κ] using ht⟩⟩
  let A : (∀ q : (↥I), κ q) → ENNReal := fun u =>
    ∑ q ∈ I.attach, F0 q.1 (u q).1
  let B : (∀ q : (↥I), κ q) → ℕ → ENNReal := fun u n =>
    ∑ q ∈ I.attach, F n q.1 (u q).1
  have hB_tendsto (u : ∀ q : (↥I), κ q) :
      Tendsto (B u) atTop (𝓝 (A u)) := by
    dsimp only [A, B]
    apply tendsto_finsetSum
    intro q hq
    exact hconv q.1 q.2 (u q)
  have hB_le (n : ℕ) (u : ∀ q : (↥I), κ q) :
      B u n ≤ ∑ q ∈ I.attach, ⨆ t : κ q, F n q.1 t.1 := by
    dsimp only [B]
    apply Finset.sum_le_sum
    intro q hq
    exact le_iSup (fun t : κ q => F n q.1 t.1) (u q)
  have hsup_le :
      (∑ q ∈ I.attach, ⨆ t : κ q, F0 q.1 t.1) ≤ ⨆ u : ∀ q : (↥I), κ q, A u := by
    simpa only [zero_add] using
      add_sum_iSup_le_of_forall_selection I.attach κ
        (fun q t => F0 q.1 t.1) 0 (⨆ u : ∀ q : (↥I), κ q, A u)
        (fun u => by simpa only [A, zero_add] using le_iSup A u)
  calc
    (∑ q ∈ I, ⨆ t : Icc (a q) (b q), F0 q t.1) =
        ∑ q ∈ I.attach, ⨆ t : κ q, F0 q.1 t.1 := by
          simpa only [κ] using (Finset.sum_attach I
            (fun q => ⨆ t : Icc (a q) (b q), F0 q t.1)).symm
    _ ≤ ⨆ u : ∀ q : (↥I), κ q, A u := hsup_le
    _ = ⨆ u : ∀ q : (↥I), κ q, liminf (B u) atTop := by
          apply iSup_congr
          intro u
          exact (hB_tendsto u).liminf_eq.symm
    _ ≤ liminf (fun n => ⨆ u : ∀ q : (↥I), κ q, B u n) atTop :=
      iSup_liminf_le_liminf_iSup
    _ ≤ liminf (fun n => ∑ q ∈ I.attach, ⨆ t : κ q, F n q.1 t.1) atTop :=
      Filter.liminf_le_liminf (Filter.Eventually.of_forall fun n =>
        iSup_le fun u => hB_le n u)
    _ = liminf (fun n => ∑ q ∈ I, ⨆ t : Icc (a q) (b q), F n q t.1) atTop := by
          congr 1
          funext n
          simpa only [κ] using (Finset.sum_attach I
            (fun q => ⨆ t : Icc (a q) (b q), F n q t.1))

private theorem measurable_lacunaryRelativeBandpassPhysicalCellSquareVariation_schwartz
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d → ℂ)) (j : Nat)
    {ι : Type*} (I : Finset ι) (a b : ι → ℝ)
    (ha : ∀ q ∈ I, 0 < a q) (hab : ∀ q ∈ I, a q ≤ b q)
    (f : SchwartzMap (Euclidean d) ℂ) :
    Measurable (lacunaryRelativeBandpassPhysicalCellSquareVariation psi j I a b
      (f : Euclidean d → ℂ)) := by
  classical
  unfold lacunaryRelativeBandpassPhysicalCellSquareVariation
  refine Finset.measurable_fun_sum I ?_
  intro q hq
  have hG : Measurable (⨆ t : Icc (a q) (b q), fun x : Euclidean d =>
      ENNReal.ofReal
        (‖lacunaryRelativeBandpassPhysicalTerm psi j t.1
            (f : Euclidean d → ℂ) x -
          lacunaryRelativeBandpassPhysicalTerm psi j (a q)
            (f : Euclidean d → ℂ) x‖ ^ 2)) := by
    apply measurable_iSup_of_lowerSemicontinuous
    · intro t
      have htpos : 0 < t.1 := lt_of_lt_of_le (ha q hq) t.2.1
      exact (ENNReal.continuous_ofReal.comp
        (((continuous_lacunaryRelativeBandpassPhysicalTerm psi j htpos
          (f : Euclidean d → ℂ) f.integrable).sub
          (continuous_lacunaryRelativeBandpassPhysicalTerm psi j (ha q hq)
            (f : Euclidean d → ℂ) f.integrable)).norm.pow 2)).measurable
    · intro x
      have hterm : Continuous (fun t : Icc (a q) (b q) =>
          lacunaryRelativeBandpassPhysicalTerm psi j t.1
            (f : Euclidean d → ℂ) x) := by
        change Continuous ((Icc (a q) (b q)).restrict (fun r : ℝ =>
          lacunaryRelativeBandpassPhysicalTerm psi j r
            (f : Euclidean d → ℂ) x))
        exact (continuousOn_lacunaryRelativeBandpassPhysicalTerm_radius_schwartz
          hd psi hpsiCompact j f (ha q hq) (hab q hq) x).restrict
      exact (ENNReal.continuous_ofReal.comp
        ((hterm.sub continuous_const).norm.pow 2)).lowerSemicontinuous
  have hEq : (fun x : Euclidean d =>
      ⨆ t : Icc (a q) (b q), ENNReal.ofReal
        (‖lacunaryRelativeBandpassPhysicalTerm psi j t.1
            (f : Euclidean d → ℂ) x -
          lacunaryRelativeBandpassPhysicalTerm psi j (a q)
            (f : Euclidean d → ℂ) x‖ ^ 2)) =
      ⨆ t : Icc (a q) (b q), fun x : Euclidean d => ENNReal.ofReal
        (‖lacunaryRelativeBandpassPhysicalTerm psi j t.1
            (f : Euclidean d → ℂ) x -
          lacunaryRelativeBandpassPhysicalTerm psi j (a q)
            (f : Euclidean d → ℂ) x‖ ^ 2) := by
    funext x
    exact (iSup_apply
      (f := fun t : Icc (a q) (b q) => fun x : Euclidean d =>
        ENNReal.ofReal
          (‖lacunaryRelativeBandpassPhysicalTerm psi j t.1
              (f : Euclidean d → ℂ) x -
            lacunaryRelativeBandpassPhysicalTerm psi j (a q)
              (f : Euclidean d → ℂ) x‖ ^ 2)) (a := x)).symm
  rw [hEq]
  exact hG

private theorem exists_schwartz_tendsto_toLp_two
    {d : Nat} (g : Euclidean d → ℂ) (hg2 : MemLp g 2 volume) :
    ∃ f : ℕ → SchwartzMap (Euclidean d) ℂ,
      Tendsto (fun n => (f n).toLp 2 volume) atTop (𝓝 (hg2.toLp g)) := by
  let G : Lp ℂ 2 (volume : Measure (Euclidean d)) := hg2.toLp g
  have hdense : DenseRange (fun f : SchwartzMap (Euclidean d) ℂ =>
      f.toLp 2 volume) :=
    SchwartzMap.denseRange_toLpCLM ENNReal.ofNat_ne_top
  have hclosure : G ∈ closure (Set.range fun f : SchwartzMap (Euclidean d) ℂ =>
      f.toLp 2 volume) := hdense G
  have hnear (n : ℕ) : ∃ f : SchwartzMap (Euclidean d) ℂ,
      dist (f.toLp 2 volume) G < (n + 1 : ℝ)⁻¹ := by
    rcases (Metric.mem_closure_iff.mp hclosure ((n + 1 : ℝ)⁻¹) (by positivity)) with
      ⟨F, hF, hdist⟩
    rcases hF with ⟨f, rfl⟩
    exact ⟨f, by simpa only [dist_comm] using hdist⟩
  choose f hf using hnear
  refine ⟨f, ?_⟩
  rw [Metric.tendsto_atTop]
  intro ε hε
  obtain ⟨N, hN⟩ : ∃ N : ℕ, (N + 1 : ℝ)⁻¹ < ε := by
    simpa only [one_div] using exists_nat_one_div_lt hε
  refine ⟨N, fun n hn => ?_⟩
  exact lt_of_lt_of_le (hf n) (by
    have hmono : (n + 1 : ℝ)⁻¹ ≤ (N + 1 : ℝ)⁻¹ :=
      (inv_le_inv₀ (by positivity) (by positivity)).2 (by
        exact_mod_cast Nat.succ_le_succ hn)
    exact hmono.trans hN.le)

private theorem lintegral_ennreal_norm_sq_eq_of_memLp_two
    {d : Nat} (u : Euclidean d → ℂ) (hu : MemLp u 2 volume) :
    (∫⁻ x, ENNReal.ofReal (‖u x‖ ^ 2)) =
      ENNReal.ofReal (‖hu.toLp u‖ ^ 2) := by
  have hint : Integrable (fun x : Euclidean d => ‖u x‖ ^ 2) volume :=
    (memLp_two_iff_integrable_sq_norm hu.1).1 hu
  have hnon : ∀ᵐ x : Euclidean d ∂volume, 0 ≤ ‖u x‖ ^ 2 :=
    Filter.Eventually.of_forall fun _ => sq_nonneg _
  rw [← ofReal_integral_eq_lintegral_ofReal hint hnon]
  rw [norm_toLp_two_eq_sqrt_integral_norm_sq_general volume u hu]
  rw [Real.sq_sqrt (integral_nonneg fun _ => sq_nonneg _)]

/-- A literal finite physical cell square estimate, proved first for Schwartz
inputs, extends to every `L²` input.  The proof keeps the uncountable cell
suprema intact: pointwise `L²` convergence is passed through every finite
family of cells by exact finite selection, then Fatou closes the estimate. -/
theorem lintegral_lacunaryRelativeBandpassPhysicalCellSquareVariation_of_schwartz_core
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d → ℂ)) (j : Nat)
    {ι : Type*} (I : Finset ι) (a b : ι → ℝ)
    (ha : ∀ q ∈ I, 0 < a q) (hab : ∀ q ∈ I, a q ≤ b q)
    (C : ℝ)
    (hcore : ∀ f : SchwartzMap (Euclidean d) ℂ,
      (∫⁻ x, lacunaryRelativeBandpassPhysicalCellSquareVariation psi j I a b
        (f : Euclidean d → ℂ) x) ≤
        (ENNReal.ofReal C) ^ 2 *
          ∫⁻ x, ENNReal.ofReal (‖(f : Euclidean d → ℂ) x‖ ^ 2))
    (g : Euclidean d → ℂ) (hg2 : MemLp g 2 volume) :
    (∫⁻ x, lacunaryRelativeBandpassPhysicalCellSquareVariation psi j I a b g x) ≤
      (ENNReal.ofReal C) ^ 2 * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ 2) := by
  obtain ⟨f, hfg⟩ := exists_schwartz_tendsto_toLp_two g hg2
  let V : (Euclidean d → ℂ) → Euclidean d → ENNReal :=
    lacunaryRelativeBandpassPhysicalCellSquareVariation psi j I a b
  have hpoint (x : Euclidean d) : V g x ≤ liminf (fun n => V (f n) x) atTop := by
    dsimp only [V, lacunaryRelativeBandpassPhysicalCellSquareVariation]
    exact finite_cell_iSup_le_liminf I a b ha hab
      (fun n q r => ENNReal.ofReal
        (‖lacunaryRelativeBandpassPhysicalTerm psi j r
            (f n : Euclidean d → ℂ) x -
          lacunaryRelativeBandpassPhysicalTerm psi j (a q)
            (f n : Euclidean d → ℂ) x‖ ^ 2))
      (fun q r => ENNReal.ofReal
        (‖lacunaryRelativeBandpassPhysicalTerm psi j r g x -
          lacunaryRelativeBandpassPhysicalTerm psi j (a q) g x‖ ^ 2))
      (by
        intro q hq t
        exact tendsto_lacunaryRelativeBandpassPhysicalTerm_difference_square_of_tendsto_toLp
          psi j (ha q hq) t.2.1 x f g hg2 hfg)
  have hfatou :
      (∫⁻ x, liminf (fun n => V (f n) x) atTop) ≤
        liminf (fun n => ∫⁻ x, V (f n) x) atTop := by
    exact MeasureTheory.lintegral_liminf_le'
      (fun n =>
        (measurable_lacunaryRelativeBandpassPhysicalCellSquareVariation_schwartz
          hd psi hpsiCompact j I a b ha hab (f n)).aemeasurable)
  have henergy :
      Tendsto (fun n => ∫⁻ x, ENNReal.ofReal (‖(f n : Euclidean d → ℂ) x‖ ^ 2))
        atTop (𝓝 (∫⁻ x, ENNReal.ofReal (‖g x‖ ^ 2))) := by
    have hfun :
        (fun n => ∫⁻ x, ENNReal.ofReal (‖(f n : Euclidean d → ℂ) x‖ ^ 2)) =
          fun n => ENNReal.ofReal (‖(f n).toLp 2 volume‖ ^ 2) := by
      funext n
      exact lintegral_ennreal_norm_sq_eq_of_memLp_two
        (f n : Euclidean d → ℂ) ((f n).memLp 2 volume)
    have hlim : (∫⁻ x, ENNReal.ofReal (‖g x‖ ^ 2)) =
        ENNReal.ofReal (‖hg2.toLp g‖ ^ 2) :=
      lintegral_ennreal_norm_sq_eq_of_memLp_two g hg2
    rw [hfun, hlim]
    exact ENNReal.tendsto_ofReal ((hfg.norm).pow 2)
  have hscaled :
      Tendsto (fun n => (ENNReal.ofReal C) ^ 2 *
        ∫⁻ x, ENNReal.ofReal (‖(f n : Euclidean d → ℂ) x‖ ^ 2)) atTop
        (𝓝 ((ENNReal.ofReal C) ^ 2 *
          ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ 2))) := by
    exact ENNReal.Tendsto.const_mul henergy (Or.inr (by simp))
  have hcore_liminf :
      liminf (fun n => ∫⁻ x, V (f n) x) atTop ≤
        liminf (fun n => (ENNReal.ofReal C) ^ 2 *
          ∫⁻ x, ENNReal.ofReal (‖(f n : Euclidean d → ℂ) x‖ ^ 2)) atTop := by
    apply Filter.liminf_le_liminf
    · filter_upwards with n
      exact hcore (f n)
    · exact isBoundedUnder_of_eventually_ge
        (Filter.Eventually.of_forall fun _ => bot_le)
    · exact hscaled.isCoboundedUnder_ge
  calc
    (∫⁻ x, V g x) ≤ ∫⁻ x, liminf (fun n => V (f n) x) atTop :=
      lintegral_mono hpoint
    _ ≤ liminf (fun n => ∫⁻ x, V (f n) x) atTop := hfatou
    _ ≤ liminf (fun n => (ENNReal.ofReal C) ^ 2 *
        ∫⁻ x, ENNReal.ofReal (‖(f n : Euclidean d → ℂ) x‖ ^ 2)) atTop := hcore_liminf
    _ = (ENNReal.ofReal C) ^ 2 *
        ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ 2) := hscaled.liminf_eq

/-- The Schwartz-core cell-square estimate admits a measurable `liminf`
majorant for an arbitrary `L²` input.  This is the form used before applying
the weak-type (Markov) step: the literal interval suprema remain unchanged,
but their possibly nonmeasurable pointwise expression is dominated almost
everywhere by a measurable function with the same `L²` bound. -/
theorem exists_aemeasurable_lacunaryRelativeBandpassPhysicalCellSquareVariation_majorant_of_schwartz_core
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d → ℂ)) (j : Nat)
    {ι : Type*} (I : Finset ι) (a b : ι → ℝ)
    (ha : ∀ q ∈ I, 0 < a q) (hab : ∀ q ∈ I, a q ≤ b q)
    (C : ℝ)
    (hcore : ∀ f : SchwartzMap (Euclidean d) ℂ,
      (∫⁻ x, lacunaryRelativeBandpassPhysicalCellSquareVariation psi j I a b
        (f : Euclidean d → ℂ) x) ≤
        (ENNReal.ofReal C) ^ 2 *
          ∫⁻ x, ENNReal.ofReal (‖(f : Euclidean d → ℂ) x‖ ^ 2))
    (g : Euclidean d → ℂ) (hg2 : MemLp g 2 volume) :
    ∃ M : Euclidean d → ENNReal, AEMeasurable M volume ∧
      (∀ᵐ x ∂volume,
        lacunaryRelativeBandpassPhysicalCellSquareVariation psi j I a b g x ≤ M x) ∧
      (∫⁻ x, M x) ≤
        (ENNReal.ofReal C) ^ 2 * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ 2) := by
  obtain ⟨f, hfg⟩ := exists_schwartz_tendsto_toLp_two g hg2
  let V : (Euclidean d → ℂ) → Euclidean d → ENNReal :=
    lacunaryRelativeBandpassPhysicalCellSquareVariation psi j I a b
  let M : Euclidean d → ENNReal := fun x => liminf (fun n => V (f n) x) atTop
  have hpoint (x : Euclidean d) : V g x ≤ M x := by
    dsimp only [M, V, lacunaryRelativeBandpassPhysicalCellSquareVariation]
    exact finite_cell_iSup_le_liminf I a b ha hab
      (fun n q r => ENNReal.ofReal
        (‖lacunaryRelativeBandpassPhysicalTerm psi j r
            (f n : Euclidean d → ℂ) x -
          lacunaryRelativeBandpassPhysicalTerm psi j (a q)
            (f n : Euclidean d → ℂ) x‖ ^ 2))
      (fun q r => ENNReal.ofReal
        (‖lacunaryRelativeBandpassPhysicalTerm psi j r g x -
          lacunaryRelativeBandpassPhysicalTerm psi j (a q) g x‖ ^ 2))
      (by
        intro q hq t
        exact tendsto_lacunaryRelativeBandpassPhysicalTerm_difference_square_of_tendsto_toLp
          psi j (ha q hq) t.2.1 x f g hg2 hfg)
  have hMmeas : Measurable M := by
    dsimp only [M]
    exact Measurable.liminf fun n =>
      measurable_lacunaryRelativeBandpassPhysicalCellSquareVariation_schwartz
        hd psi hpsiCompact j I a b ha hab (f n)
  have hfatou :
      (∫⁻ x, M x) ≤ liminf (fun n => ∫⁻ x, V (f n) x) atTop := by
    dsimp only [M]
    exact MeasureTheory.lintegral_liminf_le'
      (fun n =>
        (measurable_lacunaryRelativeBandpassPhysicalCellSquareVariation_schwartz
          hd psi hpsiCompact j I a b ha hab (f n)).aemeasurable)
  have henergy :
      Tendsto (fun n => ∫⁻ x, ENNReal.ofReal (‖(f n : Euclidean d → ℂ) x‖ ^ 2))
        atTop (𝓝 (∫⁻ x, ENNReal.ofReal (‖g x‖ ^ 2))) := by
    have hfun :
        (fun n => ∫⁻ x, ENNReal.ofReal (‖(f n : Euclidean d → ℂ) x‖ ^ 2)) =
          fun n => ENNReal.ofReal (‖(f n).toLp 2 volume‖ ^ 2) := by
      funext n
      exact lintegral_ennreal_norm_sq_eq_of_memLp_two
        (f n : Euclidean d → ℂ) ((f n).memLp 2 volume)
    have hlim : (∫⁻ x, ENNReal.ofReal (‖g x‖ ^ 2)) =
        ENNReal.ofReal (‖hg2.toLp g‖ ^ 2) :=
      lintegral_ennreal_norm_sq_eq_of_memLp_two g hg2
    rw [hfun, hlim]
    exact ENNReal.tendsto_ofReal ((hfg.norm).pow 2)
  have hscaled :
      Tendsto (fun n => (ENNReal.ofReal C) ^ 2 *
        ∫⁻ x, ENNReal.ofReal (‖(f n : Euclidean d → ℂ) x‖ ^ 2)) atTop
        (𝓝 ((ENNReal.ofReal C) ^ 2 *
          ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ 2))) := by
    exact ENNReal.Tendsto.const_mul henergy (Or.inr (by simp))
  have hcore_liminf :
      liminf (fun n => ∫⁻ x, V (f n) x) atTop ≤
        liminf (fun n => (ENNReal.ofReal C) ^ 2 *
          ∫⁻ x, ENNReal.ofReal (‖(f n : Euclidean d → ℂ) x‖ ^ 2)) atTop := by
    apply Filter.liminf_le_liminf
    · filter_upwards with n
      exact hcore (f n)
    · exact isBoundedUnder_of_eventually_ge
        (Filter.Eventually.of_forall fun _ => bot_le)
    · exact hscaled.isCoboundedUnder_ge
  refine ⟨M, hMmeas.aemeasurable, Filter.Eventually.of_forall hpoint, ?_⟩
  calc
    (∫⁻ x, M x) ≤ liminf (fun n => ∫⁻ x, V (f n) x) atTop := hfatou
    _ ≤ liminf (fun n => (ENNReal.ofReal C) ^ 2 *
        ∫⁻ x, ENNReal.ofReal (‖(f n : Euclidean d → ℂ) x‖ ^ 2)) atTop := hcore_liminf
    _ = (ENNReal.ofReal C) ^ 2 *
        ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ 2) := hscaled.liminf_eq

end

end Codex.Spherical.PowerWeights.LacunaryCZCellVariation