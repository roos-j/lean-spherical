  let I2 : ℝ := ∫ x : Euclidean d,
    ‖fderiv ℝ (fderiv ℝ (k : Euclidean d → ℂ)) x‖
  have hDHScaled :
      (∫ x : Euclidean d, ‖fderiv ℝ H x‖) ≤
        surfaceMass d * (s * I1) := by
    calc
      (∫ x : Euclidean d, ‖fderiv ℝ H x‖) ≤
          surfaceMass d * ∫ x : Euclidean d,
            ‖fderiv ℝ (K : Euclidean d → ℂ) x‖ := hDHBound
      _ = _ := by rw [hKDerivIntEq]
  have hJ2Scaled :
      (∫ x : Euclidean d, ‖x‖ * ‖J2 x‖) ≤
        surfaceMass d * (s * M2 + s ^ 2 * I2) := by
    calc
      (∫ x : Euclidean d, ‖x‖ * ‖J2 x‖) ≤
