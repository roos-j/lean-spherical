  have hM2 : 0 ≤ M2 := by
    dsimp only [M2]
    exact integral_nonneg fun _ => mul_nonneg (norm_nonneg _) (norm_nonneg _)
  have hI2 : 0 ≤ I2 := by
    dsimp only [I2]
    exact integral_nonneg fun _ => norm_nonneg _
