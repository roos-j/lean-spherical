        exact hS
      · exact hD
    have hmiddle : surfaceMass d * (s * M2 + s ^ 2 * I2) ≤
        surfaceMass d * (s ^ 2 * M2 + s ^ 2 * I2) := by
      apply mul_le_mul_of_nonneg_left
      exact add_le_add (mul_le_mul_of_nonneg_right hsSq hM2) le_rfl
      exact hS
    calc
      ((d : ℝ) + 1) * (surfaceMass d * (s * I1)) +
          surfaceMass d * (s * M2 + s ^ 2 * I2) ≤
            ((d : ℝ) + 1) * (surfaceMass d * (s ^ 2 * I1)) +
              surfaceMass d * (s ^ 2 * M2 + s ^ 2 * I2) := add_le_add hfirst hmiddle
      _ = s ^ 2 * surfaceMass d * (((d : ℝ) + 1) * I1 + M2 + I2) := by ring
  calc
    (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) ≤
        ((d : ℝ) + 1) * (∫ x : Euclidean d, ‖fderiv ℝ H x‖) +
