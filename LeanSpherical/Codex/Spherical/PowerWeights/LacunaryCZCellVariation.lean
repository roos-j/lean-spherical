    _ ≤ ((d : ℝ) + 1) * (surfaceMass d * (s * I1)) +
          surfaceMass d * (s * M2 + s ^ 2 * I2) :=
      add_le_add (mul_le_mul_of_nonneg_left hDHScaled hD) hJ2Scaled
    _ ≤ s ^ 2 * surfaceMass d * (((d : ℝ) + 1) * I1 + M2 + I2) := hlinear
    _ = ((2 : ℝ) ^ j) ^ 2 *
        lacunaryRelativeBandpassPhysicalKernelRadiusGeneratorFDerivConstant psi := by
      dsimp only [s, I1, M2, I2, k,
        lacunaryRelativeBandpassPhysicalKernelRadiusGeneratorFDerivConstant]
