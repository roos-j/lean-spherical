/-- The radius-derivative kernel has the translation estimate required for
the future part of the shifted Calderón--Zygmund split.  The fixed generator
is supplied explicitly, rather than hidden behind a general maximal-kernel
interface: after one radius derivative the cost is exactly `r⁻²`. -/
theorem integral_norm_lacunaryRelativeBandpassPhysicalKernelRadiusDerivative_sub_translate_le
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (G : SchwartzMap (Euclidean d) ℂ)
    (hG : ∀ x : Euclidean d,
      G x = lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j x)
    {r : ℝ} (hr : 0 < r) (h : Euclidean d) :
    (∫ x : Euclidean d,
      ‖lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j r (x + h) -
        lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j r x‖) ≤
      ‖h‖ * r⁻¹ ^ 2 *
        ∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖ := by
  let R : ℝ := r⁻¹
  have hR : 0 < R := by
    dsimp [R]
    exact inv_pos.mpr hr
  let A : Euclidean d ≃L[ℝ] Euclidean d :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 R hR.ne')
  let F : SchwartzMap (Euclidean d) ℂ :=
    (R ^ d) • (SchwartzMap.compCLMOfContinuousLinearEquiv ℂ A) G
  have hFform (x : Euclidean d) :
      F x = (R ^ d : ℝ) • G (R • x) := by
    change (R ^ d) • G (A x) = _
    simp [A]
  have hFfun : (F : Euclidean d → ℂ) =
      fun x => (R ^ d : ℝ) • G (R • x) := by
    funext x
    exact hFform x
  have hFdiff : ContDiff ℝ 1 (F : Euclidean d → ℂ) := by
    simpa using F.smooth (1 : ℕ∞)
  let dF : SchwartzMap (Euclidean d) (Euclidean d →L[ℝ] ℂ) :=
    SchwartzMap.fderivCLM ℝ (Euclidean d) ℂ F
  have hdF : (dF : Euclidean d → (Euclidean d →L[ℝ] ℂ)) =
      fderiv ℝ (F : Euclidean d → ℂ) := by
    funext x
    exact SchwartzMap.fderivCLM_apply ℝ F x
  have hFderivInt : Integrable (fderiv ℝ (F : Euclidean d → ℂ)) volume := by
    rw [← hdF]
    exact dF.integrable
  have htranslate :
      (∫ x : Euclidean d, ‖F (x + h) - F x‖) ≤
        ‖h‖ * ∫ x : Euclidean d, ‖fderiv ℝ (F : Euclidean d → ℂ) x‖ :=
    integral_norm_sub_translate_le_norm_mul_integral_norm_fderiv
      (F : Euclidean d → ℂ) hFdiff hFderivInt h
  have hFderivEq :
      (∫ x : Euclidean d, ‖fderiv ℝ (F : Euclidean d → ℂ) x‖) =
        R * ∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖ := by
    rw [hFfun]
    exact integral_norm_fderiv_dilate_eq (G : Euclidean d → ℂ)
      (by simpa using G.smooth (1 : ℕ∞)) hR
  have hkernel (x : Euclidean d) :
      lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j r x =
        R • F x := by
    rw [lacunaryRelativeBandpassPhysicalKernelRadiusDerivative_eq_dilate_generator
      hd psi j hr]
    rw [show lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j (R • x) =
        G (R • x) by exact (hG (R • x)).symm]
    rw [hFform]
    dsimp [R]
    rw [pow_succ]
    push_cast
    ring
  have hleft :
      (∫ x : Euclidean d,
        ‖lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j r (x + h) -
          lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j r x‖) =
        R * ∫ x : Euclidean d, ‖F (x + h) - F x‖ := by
    rw [show (fun x : Euclidean d =>
        ‖lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j r (x + h) -
          lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j r x‖) =
        fun x => R * ‖F (x + h) - F x‖ by
      funext x
      rw [hkernel, hkernel, ← smul_sub, norm_smul,
        Real.norm_eq_abs, abs_of_pos hR]]
    rw [integral_const_mul]
  calc
    (∫ x : Euclidean d,
      ‖lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j r (x + h) -
        lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j r x‖) =
        R * ∫ x : Euclidean d, ‖F (x + h) - F x‖ := hleft
    _ ≤ R * (‖h‖ * ∫ x : Euclidean d,
        ‖fderiv ℝ (F : Euclidean d → ℂ) x‖) :=
      mul_le_mul_of_nonneg_left htranslate hR.le
    _ = ‖h‖ * r⁻¹ ^ 2 *
        ∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖ := by
      rw [hFderivEq]
      dsimp [R]
      ring

/-- A radius-derivative kernel is integrable once its literal Schwartz
generator has been supplied.  This is the form used before applying the
mean-zero convolution lemma to a Calderón--Zygmund atom. -/
theorem integrable_lacunaryRelativeBandpassPhysicalKernelRadiusDerivative_of_schwartz_generator
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (G : SchwartzMap (Euclidean d) ℂ)
    (hG : ∀ x : Euclidean d,
      G x = lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j x)
    {r : ℝ} (hr : 0 < r) :
    Integrable (lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j r) volume := by
  let R : ℝ := r⁻¹
  have hR : 0 < R := by
    dsimp [R]
    exact inv_pos.mpr hr
  have hform : lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j r =
      fun x : Euclidean d => (R ^ (d + 1) : ℝ) • G (R • x) := by
    funext x
    rw [lacunaryRelativeBandpassPhysicalKernelRadiusDerivative_eq_dilate_generator
      hd psi j hr]
    rw [show lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j (R • x) =
        G (R • x) by exact (hG (R • x)).symm]
  rw [hform]
  exact Integrable.smul (R ^ (d + 1) : ℝ)
    (Integrable.comp_smul G.integrable hR.ne')

/-- On a compact positive radius interval, the translated generator dilation
is jointly integrable in radius and space.  This is the Fubini input for the
future part of a short-cell Calderón--Zygmund tail. -/
private theorem integrable_uncurry_radiusGeneratorDilation_sub_translate_on_Icc
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (G : SchwartzMap (Euclidean d) ℂ)
    (hG : ∀ x : Euclidean d,
      G x = lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j x)
    {a b : ℝ} (ha : 0 < a) (h : Euclidean d) :
    Integrable (fun p : ℝ × Euclidean d =>
      (p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • (p.2 + h)) -
        (p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • p.2))
      ((volume.restrict (Icc a b)).prod volume) := by
  let ν : Measure ℝ := volume.restrict (Icc a b)
  let H : ℝ → Euclidean d → ℂ := fun t x =>
    (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • x)
  let D : ℝ → Euclidean d → ℂ := fun t x => H t (x + h) - H t x
  have hDmeas : AEStronglyMeasurable (Function.uncurry D) (ν.prod volume) := by
    apply Measurable.aestronglyMeasurable
    dsimp [D, H]
    fun_prop
  have hDslice (t : ℝ) (ht : 0 < t) : Integrable (D t) volume := by
    have hH : Integrable (H t) volume := by
      dsimp [H]
      exact Integrable.smul (t⁻¹ ^ (d + 1) : ℝ)
        (Integrable.comp_smul G.integrable (inv_ne_zero ht.ne'))
    exact (hH.comp_add_right h).sub hH
  have hHactual (t : ℝ) (ht : 0 < t) (x : Euclidean d) :
      H t x = lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t x := by
    rw [lacunaryRelativeBandpassPhysicalKernelRadiusDerivative_eq_dilate_generator
      hd psi j ht]
    rw [← hG (t⁻¹ • x)]
  have hDactual (t : ℝ) (ht : 0 < t) : D t = fun x =>
      lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t (x + h) -
        lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t x := by
    funext x
    dsimp [D]
    rw [hHactual t ht, hHactual t ht]
  have hDnorm_outer : Integrable (fun t : ℝ => ∫ x : Euclidean d, ‖D t x‖) ν := by
    let M : ℝ := ‖h‖ * a⁻¹ ^ 2 *
      (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖)
    refine Integrable.mono' (g := fun _ : ℝ => M) (integrable_const M) ?_ ?_
    · exact hDmeas.norm.integral_prod_right'
    · filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
      have htpos : 0 < t := lt_of_lt_of_le ha ht.1
      have htranslate : (∫ x : Euclidean d, ‖D t x‖) ≤
          ‖h‖ * t⁻¹ ^ 2 *
            (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) := by
        rw [hDactual t htpos]
        exact integral_norm_lacunaryRelativeBandpassPhysicalKernelRadiusDerivative_sub_translate_le
          hd psi j G hG htpos h
      have hinv : t⁻¹ ≤ a⁻¹ := inv_anti₀ ha ht.1
      have hsq : t⁻¹ ^ 2 ≤ a⁻¹ ^ 2 := by
        nlinarith [inv_pos.mpr htpos, inv_pos.mpr ha]
      have hscale : ‖h‖ * t⁻¹ ^ 2 *
          (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) ≤ M := by
        have hCI : 0 ≤ ‖h‖ *
            (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) :=
          mul_nonneg (norm_nonneg _) (integral_nonneg fun _ => norm_nonneg _)
        calc
          ‖h‖ * t⁻¹ ^ 2 *
              (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) =
              (‖h‖ * (∫ x : Euclidean d,
                ‖fderiv ℝ (G : Euclidean d → ℂ) x‖)) * t⁻¹ ^ 2 := by ring
          _ ≤ (‖h‖ * (∫ x : Euclidean d,
                ‖fderiv ℝ (G : Euclidean d → ℂ) x‖)) * a⁻¹ ^ 2 :=
              mul_le_mul_of_nonneg_left hsq hCI
          _ = M := by
              dsimp [M]
              ring
      rw [Real.norm_eq_abs, abs_of_nonneg]
      · exact htranslate.trans hscale
      · exact integral_nonneg fun _ => norm_nonneg _
  have hDprod : Integrable (Function.uncurry D) (ν.prod volume) := by
    refine (integrable_prod_iff hDmeas).2 ?_
    constructor
    · filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
      exact hDslice t (lt_of_lt_of_le ha ht.1)
    · exact hDnorm_outer
  change Integrable (Function.uncurry D) (ν.prod volume)
  exact hDprod

/-- Integrating the translated derivative generator over one positive radius
cell costs its length times `a⁻²`.  The statement is kept in the literal
generator form because it is inserted under the atom integral in the
three-way future-tail estimate. -/
private theorem intervalIntegral_integral_norm_radiusGeneratorDilation_sub_translate_le
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (G : SchwartzMap (Euclidean d) ℂ)
    (hG : ∀ x : Euclidean d,
      G x = lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j x)
    {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) (h : Euclidean d) :
    (∫ t in a..b, ∫ x : Euclidean d,
      ‖(t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x + h)) -
        (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • x)‖) ≤
      (b - a) * ‖h‖ * a⁻¹ ^ 2 *
        (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) := by
  let ν : Measure ℝ := volume.restrict (Icc a b)
  let H : ℝ → Euclidean d → ℂ := fun t x =>
    (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • x)
  let D : ℝ → Euclidean d → ℂ := fun t x => H t (x + h) - H t x
  have hprod := integrable_uncurry_radiusGeneratorDilation_sub_translate_on_Icc
    hd psi j G hG (b := b) ha h
  have houter : Integrable (fun t : ℝ => ∫ x : Euclidean d, ‖D t x‖) ν := by
    change Integrable (fun t : ℝ => ∫ x : Euclidean d,
      ‖(t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x + h)) -
        (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • x)‖) ν
    exact hprod.norm.integral_prod_left
  have hinterval : IntervalIntegrable (fun t : ℝ => ∫ x : Euclidean d, ‖D t x‖)
      volume a b := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le hab]
    change Integrable (fun t : ℝ => ∫ x : Euclidean d, ‖D t x‖) ν
    exact houter
  let M : ℝ := ‖h‖ * a⁻¹ ^ 2 *
    (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖)
  have hconst : IntervalIntegrable (fun _ : ℝ => M) volume a b :=
    intervalIntegrable_const
  have hHactual (t : ℝ) (ht : 0 < t) (x : Euclidean d) :
      H t x = lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t x := by
    rw [lacunaryRelativeBandpassPhysicalKernelRadiusDerivative_eq_dilate_generator
      hd psi j ht]
    rw [← hG (t⁻¹ • x)]
  have hpoint (t : ℝ) (ht : t ∈ Icc a b) : (∫ x : Euclidean d, ‖D t x‖) ≤ M := by
    have htpos : 0 < t := lt_of_lt_of_le ha ht.1
    have hDactual : D t = fun x =>
        lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t (x + h) -
          lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t x := by
      funext x
      dsimp [D]
      rw [hHactual t htpos, hHactual t htpos]
    have htranslate : (∫ x : Euclidean d, ‖D t x‖) ≤
        ‖h‖ * t⁻¹ ^ 2 *
          (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) := by
      rw [hDactual]
      exact integral_norm_lacunaryRelativeBandpassPhysicalKernelRadiusDerivative_sub_translate_le
        hd psi j G hG htpos h
    have hinv : t⁻¹ ≤ a⁻¹ := inv_anti₀ ha ht.1
    have hsq : t⁻¹ ^ 2 ≤ a⁻¹ ^ 2 := by
      nlinarith [inv_pos.mpr htpos, inv_pos.mpr ha]
    have hCI : 0 ≤ ‖h‖ *
        (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) :=
      mul_nonneg (norm_nonneg _) (integral_nonneg fun _ => norm_nonneg _)
    calc
      (∫ x : Euclidean d, ‖D t x‖) ≤
          ‖h‖ * t⁻¹ ^ 2 *
            (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) := htranslate
      _ = (‖h‖ * (∫ x : Euclidean d,
            ‖fderiv ℝ (G : Euclidean d → ℂ) x‖)) * t⁻¹ ^ 2 := by ring
      _ ≤ (‖h‖ * (∫ x : Euclidean d,
            ‖fderiv ℝ (G : Euclidean d → ℂ) x‖)) * a⁻¹ ^ 2 :=
          mul_le_mul_of_nonneg_left hsq hCI
      _ = M := by
          dsimp [M]
          ring
  change (∫ t in a..b, ∫ x : Euclidean d, ‖D t x‖) ≤ _
  calc
    (∫ t in a..b, ∫ x : Euclidean d, ‖D t x‖) ≤ ∫ t in a..b, M := by
      apply intervalIntegral.integral_mono_on hab hinterval hconst
      intro t ht
      exact hpoint t ht
    _ = (b - a) * M := by
      rw [intervalIntegral.integral_const, smul_eq_mul]
    _ = _ := by
      dsimp [M]
      ring

/-- Translating the spatial variable of the radius-generator difference
preserves its product-space integrability.  This is the form in which the
mean-zero atom is centred before the final Fubini step. -/
private theorem integrable_uncurry_radiusGeneratorDilation_sub_translate_sub_right_on_Icc
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (G : SchwartzMap (Euclidean d) ℂ)
    (hG : ∀ x : Euclidean d,
      G x = lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j x)
    {a b : ℝ} (ha : 0 < a) (h c : Euclidean d) :
    Integrable
      (fun p : ℝ × Euclidean d =>
        (p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • (p.2 + h - c)) -
          (p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • (p.2 - c)))
      ((volume.restrict (Icc a b)).prod volume) := by
  let ν : Measure ℝ := volume.restrict (Icc a b)
  let A : ℝ × Euclidean d → ℂ := fun p =>
    (p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • (p.2 + h)) -
      (p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • p.2)
  have hA : Integrable A (ν.prod volume) := by
    simpa only [A, ν] using
      integrable_uncurry_radiusGeneratorDilation_sub_translate_on_Icc
        hd psi j G hG (b := b) ha h
  let τ : ℝ × Euclidean d → ℝ × Euclidean d := fun p => (p.1, p.2 - c)
  have hτ : MeasurePreserving τ (ν.prod volume) (ν.prod volume) := by
    change MeasurePreserving (Prod.map id (fun x : Euclidean d => x - c))
      (ν.prod volume) (ν.prod volume)
    exact (MeasurePreserving.id ν).prod
      (measurePreserving_sub_right (volume : Measure (Euclidean d)) c)
  have hcomp : Integrable (A ∘ τ) (ν.prod volume) :=
    (hτ.integrable_comp hA.aestronglyMeasurable).mpr hA
  refine hcomp.congr ?_
  filter_upwards with p
  dsimp only [Function.comp_def, A, τ]
  congr 2 <;> abel

/-- On a positive interval, the translated radius-generator difference has
the same `L¹` bound as the unshifted one. -/
private theorem integral_norm_radiusGeneratorDilation_sub_translate_sub_right_on_Icc_le
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (G : SchwartzMap (Euclidean d) ℂ)
    (hG : ∀ x : Euclidean d,
      G x = lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j x)
    {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) (h c : Euclidean d) :
    (∫ p : ℝ × Euclidean d,
      ‖(p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • (p.2 + h - c)) -
        (p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • (p.2 - c))‖
        ∂((volume.restrict (Icc a b)).prod volume)) ≤
      (b - a) * ‖h‖ * a⁻¹ ^ 2 *
        (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) := by
  let ν : Measure ℝ := volume.restrict (Icc a b)
  let A : ℝ × Euclidean d → ℂ := fun p =>
    (p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • (p.2 + h)) -
      (p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • p.2)
  let B : ℝ × Euclidean d → ℂ := fun p =>
    (p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • (p.2 + h - c)) -
      (p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • (p.2 - c))
  have hA : Integrable A (ν.prod volume) := by
    simpa only [A, ν] using
      integrable_uncurry_radiusGeneratorDilation_sub_translate_on_Icc
        hd psi j G hG (b := b) ha h
  have hB : Integrable B (ν.prod volume) := by
    simpa only [B, ν] using
      integrable_uncurry_radiusGeneratorDilation_sub_translate_sub_right_on_Icc
        hd psi j G hG (b := b) ha h c
  have hAinterval : (∫ p : ℝ × Euclidean d, ‖A p‖ ∂(ν.prod volume)) ≤
      (b - a) * ‖h‖ * a⁻¹ ^ 2 *
        (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) := by
    calc
      (∫ p : ℝ × Euclidean d, ‖A p‖ ∂(ν.prod volume)) =
          ∫ t : ℝ, ∫ x : Euclidean d, ‖A (t, x)‖ ∂volume ∂ν :=
            integral_prod _ hA.norm
      _ = (∫ t in a..b, ∫ x : Euclidean d, ‖A (t, x)‖) := by
            simp only [ν]
            rw [intervalIntegral.integral_of_le hab, ← integral_Icc_eq_integral_Ioc]
      _ ≤ _ := by
        simpa only [A] using
          intervalIntegral_integral_norm_radiusGeneratorDilation_sub_translate_le
            hd psi j G hG ha hab h
  have htranslate (t : ℝ) :
      (∫ x : Euclidean d, ‖B (t, x)‖) =
        ∫ x : Euclidean d, ‖A (t, x)‖ := by
    let T : Euclidean d → ℝ := fun x => ‖A (t, x)‖
    calc
      (∫ x : Euclidean d, ‖B (t, x)‖) = ∫ x : Euclidean d, T (x - c) := by
        apply integral_congr_ae
        filter_upwards with x
        dsimp only [B, T, A]
        congr 2 <;> abel
      _ = ∫ x : Euclidean d, T x := integral_sub_right_eq_self T c
      _ = ∫ x : Euclidean d, ‖A (t, x)‖ := by rfl
  change (∫ p : ℝ × Euclidean d, ‖B p‖ ∂(ν.prod volume)) ≤ _
  calc
    (∫ p : ℝ × Euclidean d, ‖B p‖ ∂(ν.prod volume)) =
        ∫ t : ℝ, ∫ x : Euclidean d, ‖B (t, x)‖ ∂volume ∂ν :=
          integral_prod _ hB.norm
    _ = ∫ t : ℝ, ∫ x : Euclidean d, ‖A (t, x)‖ ∂volume ∂ν := by
      apply integral_congr_ae
      filter_upwards with t
      exact htranslate t
    _ = ∫ p : ℝ × Euclidean d, ‖A p‖ ∂(ν.prod volume) :=
      (integral_prod _ hA.norm).symm
    _ ≤ _ := hAinterval

/-- Integrating the centred radius-generator difference over one positive
radius cell gains the atom radius.  This is the cancellation estimate used
for the future part of the cell-variation Calderón--Zygmund tail. -/
theorem intervalIntegral_integral_norm_mean_zero_radiusGeneratorDilation_atom_difference_le
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (G : SchwartzMap (Euclidean d) ℂ)
    (hG : ∀ x : Euclidean d,
      G x = lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j x)
    {a b : ℝ} (ha : 0 < a) (hab : a ≤ b)
    (atom : Euclidean d → ℂ) (hatom : Integrable atom volume)
    {c : Euclidean d} {ρ : ℝ} (hρ : 0 ≤ ρ)
    (hatom_supp : ∀ y, atom y ≠ 0 → ‖y - c‖ ≤ ρ) :
    (∫ t in a..b, ∫ x : Euclidean d,
      ‖∫ y : Euclidean d, atom y *
        ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)) -
          (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - c)))‖) ≤
      ρ * (b - a) * a⁻¹ ^ 2 *
        (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) *
          (∫ y : Euclidean d, ‖atom y‖) := by
  let ν : Measure ℝ := volume.restrict (Icc a b)
  let K : (ℝ × Euclidean d) → Euclidean d → ℂ := fun p y =>
    (p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • (p.2 - y)) -
      (p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • (p.2 - c))
  let F : (ℝ × Euclidean d) × Euclidean d → ℂ := fun p =>
    atom p.2 * K p.1 p.2
  let C : ℝ := (b - a) * a⁻¹ ^ 2 *
    (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖)
  let M : ℝ := ρ * C
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg
      (mul_nonneg (sub_nonneg.mpr hab) (sq_nonneg _))
      (integral_nonneg fun _ => norm_nonneg _)
  have hM : 0 ≤ M := by
    dsimp only [M]
    exact mul_nonneg hρ hC
  have hKmeas : AEStronglyMeasurable
      (fun p : (ℝ × Euclidean d) × Euclidean d => K p.1 p.2)
      ((ν.prod volume).prod volume) := by
    exact (by
      fun_prop : Measurable (fun p : (ℝ × Euclidean d) × Euclidean d =>
        K p.1 p.2)).aestronglyMeasurable
  have hatommeas : AEStronglyMeasurable
      (fun p : (ℝ × Euclidean d) × Euclidean d => atom p.2)
      ((ν.prod volume).prod volume) := by
    exact AEStronglyMeasurable.comp_snd
      (μ := ν.prod (volume : Measure (Euclidean d)))
      (ν := (volume : Measure (Euclidean d))) hatom.aestronglyMeasurable
  have hFmeas : AEStronglyMeasurable F ((ν.prod volume).prod volume) := by
    exact hatommeas.mul hKmeas
  have hKint (y : Euclidean d) : Integrable (K · y) (ν.prod volume) := by
    have hbase :=
      integrable_uncurry_radiusGeneratorDilation_sub_translate_sub_right_on_Icc
        hd psi j G hG (b := b) ha (c - y) c
    refine hbase.congr ?_
    filter_upwards with p
    dsimp only [K]
    congr 2 <;> abel
  have hKbound (y : Euclidean d) :
      (∫ p : ℝ × Euclidean d, ‖K p y‖ ∂(ν.prod volume)) ≤ ‖c - y‖ * C := by
    have hbase :=
      integral_norm_radiusGeneratorDilation_sub_translate_sub_right_on_Icc_le
        hd psi j G hG (b := b) ha hab (c - y) c
    calc
      (∫ p : ℝ × Euclidean d, ‖K p y‖ ∂(ν.prod volume)) =
          ∫ p : ℝ × Euclidean d,
            ‖(p.1⁻¹ ^ (d + 1) : ℝ) • G
                (p.1⁻¹ • (p.2 + (c - y) - c)) -
              (p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • (p.2 - c))‖
              ∂(ν.prod volume) := by
            apply integral_congr_ae
            filter_upwards with p
            dsimp only [K]
            congr 2 <;> abel
      _ ≤ (b - a) * ‖c - y‖ * a⁻¹ ^ 2 *
          (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) := by
            simpa only [ν] using hbase
      _ = ‖c - y‖ * C := by
            dsimp only [C]
            ring
  have hFint : Integrable F ((ν.prod volume).prod volume) := by
    refine (integrable_prod_iff' hFmeas).2 ?_
    constructor
    · filter_upwards with y
      exact (hKint y).const_mul (atom y)
    · have houtermeas : AEStronglyMeasurable
          (fun y : Euclidean d => ∫ p : ℝ × Euclidean d,
            ‖atom y * K p y‖ ∂(ν.prod volume)) volume := by
        have hswap := hFmeas.prod_swap
        exact hswap.norm.integral_prod_right'
      have hmajor : Integrable (fun y : Euclidean d => ‖atom y‖ * M) volume :=
        hatom.norm.mul_const M
      refine Integrable.mono' hmajor houtermeas ?_
      filter_upwards with y
      by_cases hy : atom y = 0
      · simp [hy, F]
      · have hyc : ‖c - y‖ ≤ ρ := by
          simpa only [norm_sub_rev] using hatom_supp y hy
        have hscale : ‖c - y‖ * C ≤ M := by
          dsimp only [M]
          exact mul_le_mul_of_nonneg_right hyc hC
        rw [Real.norm_of_nonneg (integral_nonneg fun _ => norm_nonneg _)]
        calc
          (∫ p : ℝ × Euclidean d, ‖atom y * K p y‖ ∂(ν.prod volume)) =
              ∫ p : ℝ × Euclidean d, ‖atom y‖ * ‖K p y‖ ∂(ν.prod volume) := by
                apply integral_congr_ae
                filter_upwards with p
                rw [norm_mul]
          _ = ‖atom y‖ * (∫ p : ℝ × Euclidean d, ‖K p y‖ ∂(ν.prod volume)) := by
                rw [integral_const_mul]
          _ ≤ ‖atom y‖ * (‖c - y‖ * C) :=
                mul_le_mul_of_nonneg_left (hKbound y) (norm_nonneg _)
          _ ≤ ‖atom y‖ * M :=
                mul_le_mul_of_nonneg_left hscale (norm_nonneg _)
  have hDint : Integrable (fun p : ℝ × Euclidean d => ∫ y : Euclidean d, F (p, y))
      (ν.prod volume) := hFint.integral_prod_left
  have hRint : Integrable (fun p : ℝ × Euclidean d =>
      ∫ y : Euclidean d, ‖F (p, y)‖) (ν.prod volume) :=
    hFint.norm.integral_prod_left
  have hslices : ∀ᵐ p : ℝ × Euclidean d ∂(ν.prod volume),
      Integrable (fun y : Euclidean d => F (p, y)) volume :=
    (integrable_prod_iff hFmeas).mp hFint |>.1
  have hpoint : ∀ᵐ p : ℝ × Euclidean d ∂(ν.prod volume),
      ‖∫ y : Euclidean d, F (p, y)‖ ≤ ∫ y : Euclidean d, ‖F (p, y)‖ := by
    filter_upwards [hslices] with p hp
    exact norm_integral_le_of_norm_le hp.norm (Filter.Eventually.of_forall fun _ => le_rfl)
  have htriangle :
      (∫ p : ℝ × Euclidean d, ‖∫ y : Euclidean d, F (p, y)‖ ∂(ν.prod volume)) ≤
        ∫ p : ℝ × Euclidean d,
          (∫ y : Euclidean d, ‖F (p, y)‖) ∂(ν.prod volume) :=
    integral_mono_ae hDint.norm hRint hpoint
  have houterint :
      (∫ y : Euclidean d, ∫ p : ℝ × Euclidean d,
        ‖F (p, y)‖ ∂(ν.prod volume)) ≤
        ∫ y : Euclidean d, ‖atom y‖ * M := by
    have hleft : Integrable (fun y : Euclidean d =>
        ∫ p : ℝ × Euclidean d, ‖F (p, y)‖ ∂(ν.prod volume)) volume :=
      hFint.norm.integral_prod_right
    have hright : Integrable (fun y : Euclidean d => ‖atom y‖ * M) volume :=
      hatom.norm.mul_const M
    apply integral_mono_ae hleft hright
    filter_upwards with y
    by_cases hy : atom y = 0
    · simp [hy, F]
    · have hyc : ‖c - y‖ ≤ ρ := by
        simpa only [norm_sub_rev] using hatom_supp y hy
      have hscale : ‖c - y‖ * C ≤ M := by
        dsimp only [M]
        exact mul_le_mul_of_nonneg_right hyc hC
      calc
        (∫ p : ℝ × Euclidean d, ‖F (p, y)‖ ∂(ν.prod volume)) =
            ∫ p : ℝ × Euclidean d, ‖atom y‖ * ‖K p y‖ ∂(ν.prod volume) := by
              apply integral_congr_ae
              filter_upwards with p
              dsimp only [F]
              rw [norm_mul]
        _ = ‖atom y‖ * (∫ p : ℝ × Euclidean d, ‖K p y‖ ∂(ν.prod volume)) := by
              rw [integral_const_mul]
        _ ≤ ‖atom y‖ * (‖c - y‖ * C) :=
              mul_le_mul_of_nonneg_left (hKbound y) (norm_nonneg _)
        _ ≤ ‖atom y‖ * M :=
              mul_le_mul_of_nonneg_left hscale (norm_nonneg _)
  have hFswap :
      (∫ p : ℝ × Euclidean d,
        (∫ y : Euclidean d, ‖F (p, y)‖) ∂(ν.prod volume)) =
        ∫ y : Euclidean d, ∫ p : ℝ × Euclidean d, ‖F (p, y)‖ ∂(ν.prod volume) :=
    integral_integral_swap hFint.norm
  have hmain :
      (∫ p : ℝ × Euclidean d, ‖∫ y : Euclidean d, F (p, y)‖ ∂(ν.prod volume)) ≤
        M * ∫ y : Euclidean d, ‖atom y‖ := by
    calc
      (∫ p : ℝ × Euclidean d, ‖∫ y : Euclidean d, F (p, y)‖ ∂(ν.prod volume)) ≤
          ∫ p : ℝ × Euclidean d,
            (∫ y : Euclidean d, ‖F (p, y)‖) ∂(ν.prod volume) :=
            htriangle
      _ = ∫ y : Euclidean d, ∫ p : ℝ × Euclidean d,
          ‖F (p, y)‖ ∂(ν.prod volume) := hFswap
      _ ≤ ∫ y : Euclidean d, ‖atom y‖ * M := houterint
      _ = M * ∫ y : Euclidean d, ‖atom y‖ := by
        rw [integral_mul_const]
        ring
  change (∫ t in a..b, ∫ x : Euclidean d, ‖∫ y : Euclidean d, F ((t, x), y)‖) ≤ _
  have hFubini :
      (∫ t in a..b, ∫ x : Euclidean d, ‖∫ y : Euclidean d, F ((t, x), y)‖) =
        ∫ p : ℝ × Euclidean d, ‖∫ y : Euclidean d, F (p, y)‖ ∂(ν.prod volume) := by
    calc
      (∫ t in a..b, ∫ x : Euclidean d, ‖∫ y : Euclidean d, F ((t, x), y)‖) =
          ∫ t : ℝ, ∫ x : Euclidean d, ‖∫ y : Euclidean d, F ((t, x), y)‖ ∂volume ∂ν := by
            simp only [ν]
            rw [intervalIntegral.integral_of_le hab, ← integral_Icc_eq_integral_Ioc]
      _ = ∫ p : ℝ × Euclidean d, ‖∫ y : Euclidean d, F (p, y)‖ ∂(ν.prod volume) :=
            (integral_prod _ hDint.norm).symm
  rw [hFubini]
  calc
    (∫ p : ℝ × Euclidean d, ‖∫ y : Euclidean d, F (p, y)‖ ∂(ν.prod volume)) ≤
        M * ∫ y : Euclidean d, ‖atom y‖ := hmain
    _ = ρ * (b - a) * a⁻¹ ^ 2 *
        (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) *
          (∫ y : Euclidean d, ‖atom y‖) := by
      dsimp only [M, C]
      ring

/-- Mean-zero cancellation for one literal radius derivative.  Compared with
the usual lacunary kernel estimate, differentiating in the radius costs one
additional inverse power of the radius; this is precisely compensated by the
width of a `2⁻ʲ` entropy cell in the later three-way split. -/
theorem integral_norm_mean_zero_lacunaryRelativeBandpassPhysicalKernelRadiusDerivative_atom_le
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (G : SchwartzMap (Euclidean d) ℂ)
    (hG : ∀ x : Euclidean d,
      G x = lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j x)
    {r : ℝ} (hr : 0 < r)
    (b : Euclidean d → ℂ) (hb : Integrable b volume)
    (hzero : (∫ y : Euclidean d, b y) = 0)
    {c : Euclidean d} {ρ : ℝ} (hρ : 0 ≤ ρ)
    (hbsupp : ∀ y, b y ≠ 0 → ‖y - c‖ ≤ ρ) :
    (∫ x : Euclidean d, ‖∫ y : Euclidean d, b y *
      lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j r (x - y)‖) ≤
      ρ * r⁻¹ ^ 2 *
        (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) *
          (∫ y : Euclidean d, ‖b y‖) := by
  let K : Euclidean d → ℂ :=
    lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j r
  have hK : Integrable K volume :=
    integrable_lacunaryRelativeBandpassPhysicalKernelRadiusDerivative_of_schwartz_generator
      hd psi j G hG hr
  have hfirst := integral_norm_mean_zero_kernel_convolution_le K hK b hb hzero c
  have hprod : Integrable (fun p : Euclidean d × Euclidean d =>
      b p.2 * (K (p.1 - p.2) - K (p.1 - c))) (volume.prod volume) := by
    let F : Euclidean d × Euclidean d → ℂ := fun p =>
      b p.2 * K (p.1 - p.2)
    let H : Euclidean d × Euclidean d → ℂ := fun p =>
      b p.2 * K (p.1 - c)
    have hF : Integrable F (volume.prod volume) := by
      simpa only [F, ContinuousLinearMap.mul_apply'] using
        hb.convolution_integrand (ContinuousLinearMap.mul ℂ ℂ) hK
    have hKshift : Integrable (fun x : Euclidean d => K (x - c)) volume :=
      hK.comp_sub_right c
    have hHmeas : AEStronglyMeasurable H (volume.prod volume) := by
      exact hb.aestronglyMeasurable.comp_snd.mul
        hKshift.aestronglyMeasurable.comp_fst
    have hH : Integrable H (volume.prod volume) := by
      apply (integrable_prod_iff hHmeas).mpr
      constructor
      · filter_upwards with x
        exact hb.mul_const (K (x - c))
      · have houter : Integrable (fun x : Euclidean d =>
            (∫ y : Euclidean d, ‖b y‖) * ‖K (x - c)‖) volume :=
          hKshift.norm.const_mul _
        convert houter using 1
        funext x
        change (∫ y : Euclidean d, ‖b y * K (x - c)‖) = _
        calc
          (∫ y : Euclidean d, ‖b y * K (x - c)‖) =
              ∫ y : Euclidean d, ‖b y‖ * ‖K (x - c)‖ := by
                apply integral_congr_ae
                filter_upwards with y
                rw [norm_mul]
          _ = _ := integral_mul_const (‖K (x - c)‖)
            (fun y : Euclidean d => ‖b y‖)
    convert hF.sub hH using 1
    funext p
    dsimp [F, H]
    ring
  have hRHS : Integrable (fun y : Euclidean d => ‖b y‖ *
      (∫ x : Euclidean d, ‖K (x - y) - K (x - c)‖)) volume := by
    have hright : Integrable (fun y : Euclidean d =>
        ∫ x : Euclidean d, ‖b y * (K (x - y) - K (x - c))‖) volume :=
      hprod.norm.integral_prod_right
    have hfun : (fun y : Euclidean d => ‖b y‖ *
        (∫ x : Euclidean d, ‖K (x - y) - K (x - c)‖)) =
        fun y : Euclidean d => ∫ x : Euclidean d,
          ‖b y * (K (x - y) - K (x - c))‖ := by
      funext y
      symm
      calc
        (∫ x : Euclidean d, ‖b y * (K (x - y) - K (x - c))‖) =
            ∫ x : Euclidean d, ‖b y‖ * ‖K (x - y) - K (x - c)‖ := by
              apply integral_congr_ae
              filter_upwards with x
              rw [norm_mul]
        _ = _ := integral_const_mul (‖b y‖)
          (fun x : Euclidean d => ‖K (x - y) - K (x - c)‖)
    rw [hfun]
    exact hright
  have hbound (y : Euclidean d) :
      (∫ x : Euclidean d, ‖K (x - y) - K (x - c)‖) ≤
        ‖c - y‖ * r⁻¹ ^ 2 *
          (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) := by
    let T : Euclidean d → ℝ := fun z => ‖K (z + (c - y)) - K z‖
    have htranslate : (∫ z : Euclidean d, T z) ≤
        ‖c - y‖ * r⁻¹ ^ 2 *
          (∫ z : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) z‖) := by
      dsimp [T, K]
      exact integral_norm_lacunaryRelativeBandpassPhysicalKernelRadiusDerivative_sub_translate_le
        hd psi j G hG hr (c - y)
    calc
      (∫ x : Euclidean d, ‖K (x - y) - K (x - c)‖) =
          ∫ x : Euclidean d, T (x - c) := by
            apply integral_congr_ae
            filter_upwards with x
            dsimp [T]
            congr 2 <;> abel
      _ = ∫ x : Euclidean d, T x := integral_sub_right_eq_self T c
      _ ≤ _ := htranslate
  have hmajor : Integrable (fun y : Euclidean d => ‖b y‖ *
      (ρ * r⁻¹ ^ 2 *
        (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖))) volume := by
    exact hb.norm.mul_const _
  have hpoint (y : Euclidean d) :
      ‖b y‖ * (∫ x : Euclidean d, ‖K (x - y) - K (x - c)‖) ≤
        ‖b y‖ * (ρ * r⁻¹ ^ 2 *
          (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖)) := by
    by_cases hy : b y = 0
    · simp [hy]
    · have hyc : ‖c - y‖ ≤ ρ := by
        simpa [norm_sub_rev] using hbsupp y hy
      have hC : 0 ≤ r⁻¹ ^ 2 *
          (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) := by
        exact mul_nonneg (sq_nonneg _) (integral_nonneg fun _ => norm_nonneg _)
      have hscale : ‖c - y‖ * r⁻¹ ^ 2 *
          (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) ≤
          ρ * r⁻¹ ^ 2 *
          (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) := by
        nlinarith
      exact mul_le_mul_of_nonneg_left (hbound y |>.trans hscale) (norm_nonneg _)
  calc
    (∫ x : Euclidean d, ‖∫ y : Euclidean d, b y *
      lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j r (x - y)‖) =
        ∫ x : Euclidean d, ‖∫ y : Euclidean d, b y * K (x - y)‖ := by rfl
    _ ≤ ∫ y : Euclidean d, ‖b y‖ *
        (∫ x : Euclidean d, ‖K (x - y) - K (x - c)‖) := hfirst
    _ ≤ ∫ y : Euclidean d, ‖b y‖ * (ρ * r⁻¹ ^ 2 *
        (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖)) :=
      integral_mono_ae hRHS hmajor (Filter.Eventually.of_forall hpoint)
    _ = _ := by
      rw [integral_mul_const]
      ring

/-- The direct-kernel contribution from finitely many past radius cells.
For this small-radius part no derivative or cancellation is needed: each
cell variation is bounded by the two endpoint-sized physical kernels, and
the square sum of the cell endpoints is retained explicitly. -/
theorem lacunaryRelativeBandpassPhysicalCellPast_atom_tail_le
    {d : Nat} (psi : SchwartzMap (Euclidean d) Complex) (j : Nat)
    {ι : Type*} (I : Finset ι) (a b : ι → Real)
    (ha : ∀ q ∈ I, 0 < a q) (hab : ∀ q ∈ I, a q ≤ b q)
    {rho Q : Real} (hrho : 0 < rho)
    (hsmall : ∀ q ∈ I, b q ≤ rho)
    (hSq : ∑ q ∈ I, (b q) ^ 2 ≤ Q)
    (c : Euclidean d) (atom : Euclidean d → Complex)
    (hatom : Integrable atom volume)
    (hatom_supp : ∀ y, atom y ≠ 0 → ‖y - c‖ ≤ rho)
    {x : Euclidean d} (hx : 3 * rho ≤ ‖x - c‖) :
    (∑ q ∈ I, ⨆ t : Icc (a q) (b q),
      ENNReal.ofReal ‖lacunaryRelativeBandpassPhysicalTerm psi j t.1 atom x -
        lacunaryRelativeBandpassPhysicalTerm psi j (a q) atom x‖) ≤
      ENNReal.ofReal
        (2 * (((2 : Real) ^ j)⁻¹ ^ 2 *
          SchwartzMap.seminorm Complex (d + 2) 0 (𝓕⁻ psi) /
            (‖x - c‖ / 3) ^ (d + 2)) * Q * surfaceMass d *
          ∫ y : Euclidean d, ‖atom y‖) := by
  let D : Real := ‖x - c‖ / 3
  let A : Real := ((2 : Real) ^ j)⁻¹ ^ 2 *
    SchwartzMap.seminorm Complex (d + 2) 0 (𝓕⁻ psi) / D ^ (d + 2)
  let B : Real := ∫ y : Euclidean d, ‖atom y‖
  let C : Real := A * surfaceMass d * B
  have hDpos : 0 < D := by
    dsimp only [D]
    have hxc : 0 < ‖x - c‖ :=
      lt_of_lt_of_le (mul_pos (by norm_num) hrho) hx
    positivity
  have hsemi : 0 ≤ SchwartzMap.seminorm Complex (d + 2) 0 (𝓕⁻ psi) := by
    calc
      0 ≤ ‖(0 : Euclidean d)‖ ^ (d + 2) *
          ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) Complex) 0‖ := by positivity
      _ ≤ SchwartzMap.seminorm Complex (d + 2) 0 (𝓕⁻ psi) :=
        SchwartzMap.norm_pow_mul_le_seminorm Complex
          (𝓕⁻ psi : SchwartzMap (Euclidean d) Complex) (d + 2) 0
  have hA : 0 ≤ A := by
    dsimp only [A]
    exact div_nonneg
      (mul_nonneg (sq_nonneg _) hsemi)
      (pow_nonneg hDpos.le _)
  have hB : 0 ≤ B := by
    dsimp only [B]
    exact integral_nonneg fun _ => norm_nonneg _
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg (mul_nonneg hA measureReal_nonneg) hB
  have hsumSqNonneg : 0 ≤ ∑ q ∈ I, (b q) ^ 2 := by
    exact Finset.sum_nonneg fun q hq => sq_nonneg (b q)
  have hQ : 0 ≤ Q := hsumSqNonneg.trans hSq
  have hsingle (q : ι) (hq : q ∈ I) (t : Icc (a q) (b q)) :
      ‖lacunaryRelativeBandpassPhysicalTerm psi j t.1 atom x -
          lacunaryRelativeBandpassPhysicalTerm psi j (a q) atom x‖ ≤
        2 * C * (b q) ^ 2 := by
    have hapos : 0 < a q := ha q hq
    have hbnonneg : 0 ≤ b q := hapos.le.trans (hab q hq)
    have htpos : 0 < t.1 := lt_of_lt_of_le hapos t.2.1
    have htsmall : t.1 ≤ rho := t.2.2.trans (hsmall q hq)
    have hasmall : a q ≤ rho := (hab q hq).trans (hsmall q hq)
    have htsq : t.1 ^ 2 ≤ (b q) ^ 2 :=
      pow_le_pow_left₀ htpos.le t.2.2 2
    have hasq : (a q) ^ 2 ≤ (b q) ^ 2 :=
      pow_le_pow_left₀ hapos.le (hab q hq) 2
    have ht := norm_lacunaryRelativeBandpassPhysicalTerm_le_small_radius_far_distance
      psi j htpos hrho htsmall hx atom hatom hatom_supp
    have ha' := norm_lacunaryRelativeBandpassPhysicalTerm_le_small_radius_far_distance
      psi j hapos hrho hasmall hx atom hatom hatom_supp
    have htC : ‖lacunaryRelativeBandpassPhysicalTerm psi j t.1 atom x‖ ≤
        C * t.1 ^ 2 := by
      calc
        ‖lacunaryRelativeBandpassPhysicalTerm psi j t.1 atom x‖ ≤
            (((2 : Real) ^ j)⁻¹ ^ 2 *
              SchwartzMap.seminorm Complex (d + 2) 0 (𝓕⁻ psi) /
                (‖x - c‖ / 3) ^ (d + 2)) * t.1 ^ 2 * surfaceMass d *
              ∫ y : Euclidean d, ‖atom y‖ := ht
        _ = C * t.1 ^ 2 := by
          dsimp only [C, A, B, D]
          ring
    have haC : ‖lacunaryRelativeBandpassPhysicalTerm psi j (a q) atom x‖ ≤
        C * (a q) ^ 2 := by
      calc
        ‖lacunaryRelativeBandpassPhysicalTerm psi j (a q) atom x‖ ≤
            (((2 : Real) ^ j)⁻¹ ^ 2 *
              SchwartzMap.seminorm Complex (d + 2) 0 (𝓕⁻ psi) /
                (‖x - c‖ / 3) ^ (d + 2)) * (a q) ^ 2 * surfaceMass d *
              ∫ y : Euclidean d, ‖atom y‖ := ha'
        _ = C * (a q) ^ 2 := by
          dsimp only [C, A, B, D]
          ring
    calc
      ‖lacunaryRelativeBandpassPhysicalTerm psi j t.1 atom x -
          lacunaryRelativeBandpassPhysicalTerm psi j (a q) atom x‖ ≤
          ‖lacunaryRelativeBandpassPhysicalTerm psi j t.1 atom x‖ +
            ‖lacunaryRelativeBandpassPhysicalTerm psi j (a q) atom x‖ := norm_sub_le _ _
      _ ≤ C * t.1 ^ 2 + C * (a q) ^ 2 := add_le_add htC haC
      _ ≤ C * (b q) ^ 2 + C * (b q) ^ 2 := by
        exact add_le_add
          (mul_le_mul_of_nonneg_left htsq hC)
          (mul_le_mul_of_nonneg_left hasq hC)
      _ = 2 * C * (b q) ^ 2 := by ring
  have hsup (q : ι) (hq : q ∈ I) :
      (⨆ t : Icc (a q) (b q),
        ENNReal.ofReal ‖lacunaryRelativeBandpassPhysicalTerm psi j t.1 atom x -
          lacunaryRelativeBandpassPhysicalTerm psi j (a q) atom x‖) ≤
        ENNReal.ofReal (2 * C * (b q) ^ 2) := by
    apply iSup_le
    intro t
    exact ENNReal.ofReal_le_ofReal (hsingle q hq t)
  have htermNonneg (q : ι) (hq : q ∈ I) : 0 ≤ 2 * C * (b q) ^ 2 := by
    positivity
  have hsum :
      (∑ q ∈ I, ⨆ t : Icc (a q) (b q),
        ENNReal.ofReal ‖lacunaryRelativeBandpassPhysicalTerm psi j t.1 atom x -
          lacunaryRelativeBandpassPhysicalTerm psi j (a q) atom x‖) ≤
        ENNReal.ofReal (2 * C * Q) := by
    calc
      (∑ q ∈ I, ⨆ t : Icc (a q) (b q),
        ENNReal.ofReal ‖lacunaryRelativeBandpassPhysicalTerm psi j t.1 atom x -
          lacunaryRelativeBandpassPhysicalTerm psi j (a q) atom x‖) ≤
          ∑ q ∈ I, ENNReal.ofReal (2 * C * (b q) ^ 2) := by
            exact Finset.sum_le_sum fun q hq => hsup q hq
      _ = ENNReal.ofReal (∑ q ∈ I, 2 * C * (b q) ^ 2) := by
        rw [ENNReal.ofReal_sum_of_nonneg htermNonneg]
      _ = ENNReal.ofReal (2 * C * (∑ q ∈ I, (b q) ^ 2)) := by
        congr 1
        rw [Finset.mul_sum]
      _ ≤ ENNReal.ofReal (2 * C * Q) := by
        exact ENNReal.ofReal_le_ofReal
          (mul_le_mul_of_nonneg_left hSq (mul_nonneg zero_le_two hC))
  calc
    (∑ q ∈ I, ⨆ t : Icc (a q) (b q),
      ENNReal.ofReal ‖lacunaryRelativeBandpassPhysicalTerm psi j t.1 atom x -
        lacunaryRelativeBandpassPhysicalTerm psi j (a q) atom x‖) ≤
        ENNReal.ofReal (2 * C * Q) := hsum
    _ = ENNReal.ofReal
        (2 * (((2 : Real) ^ j)⁻¹ ^ 2 *
          SchwartzMap.seminorm Complex (d + 2) 0 (𝓕⁻ psi) /
            (‖x - c‖ / 3) ^ (d + 2)) * Q * surfaceMass d *
          ∫ y : Euclidean d, ‖atom y‖) := by
          congr 1
          dsimp only [C, A, B, D]
          ring

/-- For a fixed spatial point, a compact positive radius cell can be passed
through an `L¹` atom.  This is the Fubini input for the signed future-cell
fundamental-theorem calculation. -/
theorem integrable_uncurry_radiusGeneratorDilation_atom_on_Icc
    {d : Nat} (G : SchwartzMap (Euclidean d) ℂ)
    {a b : ℝ} (ha : 0 < a)
    (atom : Euclidean d → ℂ) (hatom : Integrable atom volume)
    (x : Euclidean d) :
    Integrable (fun p : ℝ × Euclidean d => atom p.2 *
      ((p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • (x - p.2))))
      ((volume.restrict (Icc a b)).prod volume) := by
  let ν : Measure ℝ := volume.restrict (Icc a b)
  letI : IsFiniteMeasure ν := by
    dsimp only [ν]
    infer_instance
  let L : ℝ × Euclidean d → ℂ := fun p =>
    (p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • (x - p.2))
  let A : ℝ := a⁻¹ ^ (d + 1) * ‖G.toBoundedContinuousFunction‖
  have hGbound (z : Euclidean d) :
      ‖G z‖ ≤ ‖G.toBoundedContinuousFunction‖ := by
    change ‖G.toBoundedContinuousFunction z‖ ≤ ‖G.toBoundedContinuousFunction‖
    exact BoundedContinuousFunction.norm_coe_le_norm _ _
  have hLmeasurable : Measurable L := by
    dsimp only [L]
    fun_prop
  have hLmeas : AEStronglyMeasurable L (ν.prod volume) :=
    hLmeasurable.aestronglyMeasurable
  have hatom_snd : Integrable (fun p : ℝ × Euclidean d => atom p.2)
      (ν.prod volume) := by
    exact hatom.comp_snd ν
  have hLset : MeasurableSet {p : ℝ × Euclidean d | ‖L p‖ ≤ A} := by
    exact measurableSet_le hLmeasurable.norm measurable_const
  have hLbound : ∀ᵐ p : ℝ × Euclidean d ∂(ν.prod volume), ‖L p‖ ≤ A := by
    rw [Measure.ae_prod_iff_ae_ae hLset]
    filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
    filter_upwards with y
    have htpos : 0 < t := lt_of_lt_of_le ha ht.1
    have hinv : t⁻¹ ≤ a⁻¹ := inv_anti₀ ha ht.1
    have hpow : t⁻¹ ^ (d + 1) ≤ a⁻¹ ^ (d + 1) :=
      pow_le_pow_left₀ (inv_nonneg.mpr htpos.le) hinv _
    dsimp only [L, A]
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg]
    · calc
        t⁻¹ ^ (d + 1) * ‖G (t⁻¹ • (x - y))‖ ≤
            t⁻¹ ^ (d + 1) * ‖G.toBoundedContinuousFunction‖ :=
          mul_le_mul_of_nonneg_left (hGbound _) (pow_nonneg (inv_nonneg.mpr htpos.le) _)
        _ ≤ a⁻¹ ^ (d + 1) * ‖G.toBoundedContinuousFunction‖ :=
          mul_le_mul_of_nonneg_right hpow (norm_nonneg _)
    · exact pow_nonneg (inv_nonneg.mpr htpos.le) _
  have hprod : Integrable (fun p : ℝ × Euclidean d => L p * atom p.2)
      (ν.prod volume) :=
    hatom_snd.bdd_mul hLmeas hLbound
  refine hprod.congr ?_
  filter_upwards with p
  dsimp only [L]
  ring

private theorem integrable_radiusGeneratorDilation_atom
    {d : Nat} (G : SchwartzMap (Euclidean d) ℂ)
    (t : ℝ) (atom : Euclidean d → ℂ) (hatom : Integrable atom volume)
    (x : Euclidean d) :
    Integrable (fun y : Euclidean d => atom y *
      ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)))) volume := by
  let K : Euclidean d → ℂ := fun y =>
    (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y))
  let B : ℝ := ‖t⁻¹ ^ (d + 1)‖ * ‖G.toBoundedContinuousFunction‖
  have hGbound (z : Euclidean d) :
      ‖G z‖ ≤ ‖G.toBoundedContinuousFunction‖ := by
    change ‖G.toBoundedContinuousFunction z‖ ≤ ‖G.toBoundedContinuousFunction‖
    exact BoundedContinuousFunction.norm_coe_le_norm _ _
  have hKmeas : AEStronglyMeasurable K volume := by
    apply Measurable.aestronglyMeasurable
    dsimp only [K]
    fun_prop
  have hKbound : ∀ᵐ y : Euclidean d ∂volume, ‖K y‖ ≤ B := by
    filter_upwards with y
    dsimp only [K, B]
    rw [norm_smul]
    exact mul_le_mul_of_nonneg_left (hGbound _) (norm_nonneg _)
  have hprod : Integrable (fun y : Euclidean d => K y * atom y) volume :=
    hatom.bdd_mul hKmeas hKbound
  refine hprod.congr ?_
  filter_upwards with y
  dsimp only [K]
  ring

/-- Signed Fubini form of the fundamental theorem of calculus for one
physical convolution cell. -/
theorem lacunaryRelativeBandpassPhysicalTerm_sub_left_eq_intervalIntegral_generator
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (G : SchwartzMap (Euclidean d) ℂ)
    (hG : ∀ z : Euclidean d,
      G z = lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j z)
    {a r : ℝ} (ha : 0 < a) (har : a ≤ r)
    (atom : Euclidean d → ℂ) (hatom : Integrable atom volume)
    (x : Euclidean d) :
    lacunaryRelativeBandpassPhysicalTerm psi j r atom x -
        lacunaryRelativeBandpassPhysicalTerm psi j a atom x =
      ∫ t in a..r, ∫ y : Euclidean d, atom y *
        ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y))) := by
  have hendpoint (s : ℝ) (hs : 0 < s) : Integrable (fun y : Euclidean d =>
      atom y * lacunaryRelativeBandpassPhysicalKernel psi j s (x - y)) volume := by
    let K : Euclidean d → ℂ := fun y =>
      lacunaryRelativeBandpassPhysicalKernel psi j s (x - y)
    let B : ℝ := (((((2 : ℝ) ^ j)⁻¹ * s)⁻¹) ^ d *
      ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ).toBoundedContinuousFunction‖) * surfaceMass d
    have hKmeas : AEStronglyMeasurable K volume := by
      apply Measurable.aestronglyMeasurable
      dsimp only [K]
      exact (continuous_lacunaryRelativeBandpassPhysicalKernel psi j hs).measurable.comp
        (measurable_const.sub measurable_id)
    have hKbound : ∀ᵐ y : Euclidean d ∂volume, ‖K y‖ ≤ B := by
      filter_upwards with y
      dsimp only [K, B]
      exact norm_lacunaryRelativeBandpassPhysicalKernel_le psi j hs (x - y)
    have hprod : Integrable (fun y : Euclidean d => K y * atom y) volume :=
      hatom.bdd_mul hKmeas hKbound
    refine hprod.congr ?_
    filter_upwards with y
    dsimp only [K]
    ring
  have hr : 0 < r := lt_of_lt_of_le ha har
  have hterm :
      lacunaryRelativeBandpassPhysicalTerm psi j r atom x -
          lacunaryRelativeBandpassPhysicalTerm psi j a atom x =
        ∫ y : Euclidean d, atom y *
          (lacunaryRelativeBandpassPhysicalKernel psi j r (x - y) -
            lacunaryRelativeBandpassPhysicalKernel psi j a (x - y)) := by
    calc
      lacunaryRelativeBandpassPhysicalTerm psi j r atom x -
          lacunaryRelativeBandpassPhysicalTerm psi j a atom x =
          (∫ y : Euclidean d, atom y *
            lacunaryRelativeBandpassPhysicalKernel psi j r (x - y)) -
            ∫ y : Euclidean d, atom y *
              lacunaryRelativeBandpassPhysicalKernel psi j a (x - y) := rfl
      _ = ∫ y : Euclidean d,
          atom y * lacunaryRelativeBandpassPhysicalKernel psi j r (x - y) -
            atom y * lacunaryRelativeBandpassPhysicalKernel psi j a (x - y) :=
          (integral_sub (hendpoint r hr) (hendpoint a ha)).symm
      _ = _ := by
        apply integral_congr_ae
        filter_upwards with y
        ring
  have hkernel :
      (∫ y : Euclidean d, atom y *
        (lacunaryRelativeBandpassPhysicalKernel psi j r (x - y) -
          lacunaryRelativeBandpassPhysicalKernel psi j a (x - y))) =
        ∫ y : Euclidean d, atom y *
          (∫ t in a..r,
            lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t (x - y)) := by
    apply integral_congr_ae
    filter_upwards with y
    rw [lacunaryRelativeBandpassPhysicalKernel_sub_left_eq_intervalIntegral_radiusDerivative
      psi j ha har (x - y)]
  have hgenerator :
      (∫ y : Euclidean d, atom y *
        (∫ t in a..r,
          lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t (x - y))) =
        ∫ y : Euclidean d, atom y *
          (∫ t in a..r, (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y))) := by
    apply integral_congr_ae
    filter_upwards with y
    congr 1
    apply intervalIntegral.integral_congr
    intro t ht
    have htIcc : t ∈ Icc a r := by
      simpa only [uIcc_of_le har] using ht
    have htpos : 0 < t := lt_of_lt_of_le ha htIcc.1
    change lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t (x - y) = _
    rw [lacunaryRelativeBandpassPhysicalKernelRadiusDerivative_eq_dilate_generator
      hd psi j htpos]
    rw [← hG]
  let ν : Measure ℝ := volume.restrict (Icc a r)
  let F : ℝ × Euclidean d → ℂ := fun p => atom p.2 *
    ((p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • (x - p.2)))
  have hFint : Integrable F (ν.prod volume) := by
    simpa only [ν, F] using
      integrable_uncurry_radiusGeneratorDilation_atom_on_Icc
        G (a := a) (b := r) ha atom hatom x
  have hswap :
      (∫ t : ℝ, ∫ y : Euclidean d, F (t, y) ∂volume ∂ν) =
        ∫ y : Euclidean d, ∫ t : ℝ, F (t, y) ∂ν ∂volume :=
    integral_integral_swap hFint
  have hFubini :
      (∫ y : Euclidean d, atom y *
        (∫ t in a..r, (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)))) =
        ∫ t in a..r, ∫ y : Euclidean d, atom y *
          ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y))) := by
    calc
      (∫ y : Euclidean d, atom y *
        (∫ t in a..r, (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)))) =
          ∫ y : Euclidean d, ∫ t : ℝ, F (t, y) ∂ν := by
            apply integral_congr_ae
            filter_upwards with y
            dsimp only [ν, F]
            rw [← intervalIntegral.integral_const_mul]
            rw [intervalIntegral.integral_of_le har, ← integral_Icc_eq_integral_Ioc]
      _ = ∫ t : ℝ, ∫ y : Euclidean d, F (t, y) ∂volume ∂ν := hswap.symm
      _ = ∫ t in a..r, ∫ y : Euclidean d, atom y *
          ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y))) := by
            dsimp only [ν, F]
            rw [intervalIntegral.integral_of_le har, ← integral_Icc_eq_integral_Ioc]
  exact hterm.trans (hkernel.trans (hgenerator.trans hFubini))

/-- Pointwise future-cell estimate for a mean-zero atom.  The signed radius
fundamental theorem is taken before cancellation, so the atom gains the
centred generator difference inside the radius integral. -/
theorem norm_lacunaryRelativeBandpassPhysicalTerm_sub_left_le_intervalIntegral_mean_zero_generator
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (G : SchwartzMap (Euclidean d) ℂ)
    (hG : ∀ z : Euclidean d,
      G z = lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j z)
    {a b r : ℝ} (ha : 0 < a) (hab : a ≤ b) (hr : r ∈ Icc a b)
    (atom : Euclidean d → ℂ) (hatom : Integrable atom volume)
    (hzero : (∫ y : Euclidean d, atom y) = 0)
    (c x : Euclidean d) :
    ‖lacunaryRelativeBandpassPhysicalTerm psi j r atom x -
        lacunaryRelativeBandpassPhysicalTerm psi j a atom x‖ ≤
      ∫ t in a..b, ‖∫ y : Euclidean d, atom y *
        ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)) -
          (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - c)))‖ := by
  let H₀ : ℝ → ℂ := fun t => ∫ y : Euclidean d, atom y *
    ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)))
  let H : ℝ → ℂ := fun t => ∫ y : Euclidean d, atom y *
    ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)) -
      (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - c)))
  have hcenter (t : ℝ) : H₀ t = H t := by
    have hfirst := integrable_radiusGeneratorDilation_atom G t atom hatom x
    have hconst : Integrable (fun y : Euclidean d => atom y *
        ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - c)))) volume :=
      hatom.mul_const _
    dsimp only [H₀, H]
    calc
      (∫ y : Euclidean d, atom y *
          ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)))) =
          (∫ y : Euclidean d, atom y *
            ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)))) -
            (∫ y : Euclidean d, atom y *
              ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - c)))) := by
            rw [integral_mul_const, hzero, zero_mul, sub_zero]
      _ = ∫ y : Euclidean d,
          atom y * ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y))) - atom y *
            ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - c))) :=
          (integral_sub hfirst hconst).symm
      _ = _ := by
        apply integral_congr_ae
        filter_upwards with y
        ring
  have hFTC :
      lacunaryRelativeBandpassPhysicalTerm psi j r atom x -
          lacunaryRelativeBandpassPhysicalTerm psi j a atom x =
        ∫ t in a..r, H₀ t := by
    simpa only [H₀] using
      lacunaryRelativeBandpassPhysicalTerm_sub_left_eq_intervalIntegral_generator
        hd psi j G hG ha hr.1 atom hatom x
  have hFint := integrable_uncurry_radiusGeneratorDilation_atom_on_Icc
    G (a := a) (b := b) ha atom hatom x
  have hH₀int : IntervalIntegrable H₀ volume a b := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le hab]
    change Integrable (fun t : ℝ => ∫ y : Euclidean d, atom y *
      ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y))))
        (volume.restrict (Icc a b))
    exact hFint.integral_prod_left
  calc
    ‖lacunaryRelativeBandpassPhysicalTerm psi j r atom x -
        lacunaryRelativeBandpassPhysicalTerm psi j a atom x‖ =
        ‖∫ t in a..r, H₀ t‖ := by rw [hFTC]
    _ ≤ ∫ t in a..r, ‖H₀ t‖ :=
      intervalIntegral.norm_integral_le_integral_norm hr.1
    _ ≤ ∫ t in a..b, ‖H₀ t‖ := by
      apply intervalIntegral.integral_mono_interval le_rfl hr.1 hr.2
      · filter_upwards with t
        exact norm_nonneg _
      · exact hH₀int.norm
    _ = ∫ t in a..b, ‖H t‖ := by
      apply intervalIntegral.integral_congr
      intro t ht
      change ‖H₀ t‖ = ‖H t‖
      rw [hcenter t]
    _ = _ := rfl

/-- The finite future-cell `L¹` bound for the centred generator integrals.
Together with the pointwise signed FTOC estimate above, this is the
future-radius contribution to the finite Calderón--Zygmund atom tail. -/
theorem lacunaryRelativeBandpassPhysicalCellFuture_atom_tail_le
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (G : SchwartzMap (Euclidean d) ℂ)
    (hG : ∀ z : Euclidean d,
      G z = lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j z)
    {ι : Type*} (I : Finset ι) (a b : ι → ℝ)
    (ha : ∀ q ∈ I, 0 < a q) (hab : ∀ q ∈ I, a q ≤ b q)
    (atom : Euclidean d → ℂ) (hatom : Integrable atom volume)
    {c : Euclidean d} {ρ : ℝ} (hρ : 0 ≤ ρ)
    (hatom_supp : ∀ y, atom y ≠ 0 → ‖y - c‖ ≤ ρ) :
    (∑ q ∈ I, ∫ t in a q..b q, ∫ x : Euclidean d,
      ‖∫ y : Euclidean d, atom y *
        ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)) -
          (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - c)))‖) ≤
      ρ * (∑ q ∈ I, (b q - a q) * (a q)⁻¹ ^ 2) *
        (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) *
          (∫ y : Euclidean d, ‖atom y‖) := by
  let A : ℝ := ∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖
  let B : ℝ := ∫ y : Euclidean d, ‖atom y‖
  have hsingle (q : ι) (hq : q ∈ I) :
      (∫ t in a q..b q, ∫ x : Euclidean d,
        ‖∫ y : Euclidean d, atom y *
          ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)) -
            (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - c)))‖) ≤
        ρ * (b q - a q) * (a q)⁻¹ ^ 2 * A * B := by
    simpa only [A, B] using
      intervalIntegral_integral_norm_mean_zero_radiusGeneratorDilation_atom_difference_le
        hd psi j G hG (ha q hq) (hab q hq) atom hatom hρ hatom_supp
  calc
    (∑ q ∈ I, ∫ t in a q..b q, ∫ x : Euclidean d,
      ‖∫ y : Euclidean d, atom y *
        ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)) -
          (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - c)))‖) ≤
        ∑ q ∈ I, ρ * (b q - a q) * (a q)⁻¹ ^ 2 * A * B := by
          exact Finset.sum_le_sum fun q hq => hsingle q hq
    _ = ∑ q ∈ I, (ρ * A * B) * ((b q - a q) * (a q)⁻¹ ^ 2) := by
      apply Finset.sum_congr rfl
      intro q hq
      ring
    _ = (ρ * A * B) * (∑ q ∈ I, (b q - a q) * (a q)⁻¹ ^ 2) := by
      rw [Finset.mul_sum]
    _ = ρ * (∑ q ∈ I, (b q - a q) * (a q)⁻¹ ^ 2) * A * B := by
      ring
    _ = _ := by rfl

private theorem integrable_uncurry_mean_zero_radiusGeneratorDilation_atom_difference_on_Icc
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (G : SchwartzMap (Euclidean d) ℂ)
    (hG : ∀ z : Euclidean d,
      G z = lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j z)
    {a b : ℝ} (ha : 0 < a) (hab : a ≤ b)
    (atom : Euclidean d → ℂ) (hatom : Integrable atom volume)
    {c : Euclidean d} {ρ : ℝ} (hρ : 0 ≤ ρ)
    (hatom_supp : ∀ y, atom y ≠ 0 → ‖y - c‖ ≤ ρ) :
    Integrable (fun p : (ℝ × Euclidean d) × Euclidean d => atom p.2 *
      ((p.1.1⁻¹ ^ (d + 1) : ℝ) • G (p.1.1⁻¹ • (p.1.2 - p.2)) -
        (p.1.1⁻¹ ^ (d + 1) : ℝ) • G (p.1.1⁻¹ • (p.1.2 - c))))
      (((volume.restrict (Icc a b)).prod volume).prod volume) := by
  let ν : Measure ℝ := volume.restrict (Icc a b)
  let K : (ℝ × Euclidean d) → Euclidean d → ℂ := fun p y =>
    (p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • (p.2 - y)) -
      (p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • (p.2 - c))
  let F : (ℝ × Euclidean d) × Euclidean d → ℂ := fun p =>
    atom p.2 * K p.1 p.2
  let C : ℝ := (b - a) * a⁻¹ ^ 2 *
    (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖)
  let M : ℝ := ρ * C
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg
      (mul_nonneg (sub_nonneg.mpr hab) (sq_nonneg _))
      (integral_nonneg fun _ => norm_nonneg _)
  have hM : 0 ≤ M := by
    dsimp only [M]
    exact mul_nonneg hρ hC
  have hKmeas : AEStronglyMeasurable
      (fun p : (ℝ × Euclidean d) × Euclidean d => K p.1 p.2)
      ((ν.prod volume).prod volume) := by
    exact (by
      fun_prop : Measurable (fun p : (ℝ × Euclidean d) × Euclidean d =>
        K p.1 p.2)).aestronglyMeasurable
  have hatommeas : AEStronglyMeasurable
      (fun p : (ℝ × Euclidean d) × Euclidean d => atom p.2)
      ((ν.prod volume).prod volume) := by
    exact AEStronglyMeasurable.comp_snd
      (μ := ν.prod (volume : Measure (Euclidean d)))
      (ν := (volume : Measure (Euclidean d))) hatom.aestronglyMeasurable
  have hFmeas : AEStronglyMeasurable F ((ν.prod volume).prod volume) := by
    exact hatommeas.mul hKmeas
  have hKint (y : Euclidean d) : Integrable (K · y) (ν.prod volume) := by
    have hbase :=
      integrable_uncurry_radiusGeneratorDilation_sub_translate_sub_right_on_Icc
        hd psi j G hG (b := b) ha (c - y) c
    refine hbase.congr ?_
    filter_upwards with p
    dsimp only [K]
    congr 2 <;> abel
  have hKbound (y : Euclidean d) :
      (∫ p : ℝ × Euclidean d, ‖K p y‖ ∂(ν.prod volume)) ≤ ‖c - y‖ * C := by
    have hbase :=
      integral_norm_radiusGeneratorDilation_sub_translate_sub_right_on_Icc_le
        hd psi j G hG (b := b) ha hab (c - y) c
    calc
      (∫ p : ℝ × Euclidean d, ‖K p y‖ ∂(ν.prod volume)) =
          ∫ p : ℝ × Euclidean d,
            ‖(p.1⁻¹ ^ (d + 1) : ℝ) • G
                (p.1⁻¹ • (p.2 + (c - y) - c)) -
              (p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • (p.2 - c))‖
              ∂(ν.prod volume) := by
            apply integral_congr_ae
            filter_upwards with p
            dsimp only [K]
            congr 2 <;> abel
      _ ≤ (b - a) * ‖c - y‖ * a⁻¹ ^ 2 *
          (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) := by
            simpa only [ν] using hbase
      _ = ‖c - y‖ * C := by
            dsimp only [C]
            ring
  have hFint : Integrable F ((ν.prod volume).prod volume) := by
    refine (integrable_prod_iff' hFmeas).2 ?_
    constructor
    · filter_upwards with y
      exact (hKint y).const_mul (atom y)
    · have houtermeas : AEStronglyMeasurable
          (fun y : Euclidean d => ∫ p : ℝ × Euclidean d,
            ‖atom y * K p y‖ ∂(ν.prod volume)) volume := by
        have hswap := hFmeas.prod_swap
        exact hswap.norm.integral_prod_right'
      have hmajor : Integrable (fun y : Euclidean d => ‖atom y‖ * M) volume :=
        hatom.norm.mul_const M
      refine Integrable.mono' hmajor houtermeas ?_
      filter_upwards with y
      by_cases hy : atom y = 0
      · simp [hy, F]
      · have hyc : ‖c - y‖ ≤ ρ := by
          simpa only [norm_sub_rev] using hatom_supp y hy
        have hscale : ‖c - y‖ * C ≤ M := by
          dsimp only [M]
          exact mul_le_mul_of_nonneg_right hyc hC
        rw [Real.norm_of_nonneg (integral_nonneg fun _ => norm_nonneg _)]
        calc
          (∫ p : ℝ × Euclidean d, ‖atom y * K p y‖ ∂(ν.prod volume)) =
              ∫ p : ℝ × Euclidean d, ‖atom y‖ * ‖K p y‖ ∂(ν.prod volume) := by
                apply integral_congr_ae
                filter_upwards with p
                rw [norm_mul]
          _ = ‖atom y‖ * (∫ p : ℝ × Euclidean d, ‖K p y‖ ∂(ν.prod volume)) := by
                rw [integral_const_mul]
          _ ≤ ‖atom y‖ * (‖c - y‖ * C) :=
              mul_le_mul_of_nonneg_left (hKbound y) (norm_nonneg _)
          _ ≤ ‖atom y‖ * M :=
              mul_le_mul_of_nonneg_left hscale (norm_nonneg _)
  simpa only [ν, F, K] using hFint

/-- The concrete Fubini package for one positive physical radius cell.  This
is deliberately stated in the literal centred-generator form needed by the
Calderón--Zygmund bad-part estimate. -/
theorem integrable_and_integral_lacunaryRelativeBandpassPhysicalCell_centeredGenerator
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (G : SchwartzMap (Euclidean d) ℂ)
    (hG : ∀ z : Euclidean d,
      G z = lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j z)
    {a b : ℝ} (ha : 0 < a) (hab : a ≤ b)
    (atom : Euclidean d → ℂ) (hatom : Integrable atom volume)
    {c : Euclidean d} {ρ : ℝ} (hρ : 0 ≤ ρ)
    (hatom_supp : ∀ y, atom y ≠ 0 → ‖y - c‖ ≤ ρ) :
    Integrable (fun x : Euclidean d =>
      ∫ t in a..b, ‖∫ y : Euclidean d, atom y *
        ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)) -
          (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - c)))‖) volume ∧
      (∫ x : Euclidean d, ∫ t in a..b, ‖∫ y : Euclidean d, atom y *
        ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)) -
          (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - c)))‖) =
        ∫ t in a..b, ∫ x : Euclidean d, ‖∫ y : Euclidean d, atom y *
          ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)) -
            (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - c)))‖ := by
  let ν : Measure ℝ := volume.restrict (Icc a b)
  let K : ℝ × Euclidean d → Euclidean d → ℂ := fun p y =>
    (p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • (p.2 - y)) -
      (p.1⁻¹ ^ (d + 1) : ℝ) • G (p.1⁻¹ • (p.2 - c))
  let F : (ℝ × Euclidean d) × Euclidean d → ℂ := fun p =>
    atom p.2 * K p.1 p.2
  have hFint : Integrable F ((ν.prod volume).prod volume) := by
    simpa only [ν, F, K] using
      integrable_uncurry_mean_zero_radiusGeneratorDilation_atom_difference_on_Icc
        hd psi j G hG ha hab atom hatom hρ hatom_supp
  let H : ℝ × Euclidean d → ℝ := fun p => ‖∫ y : Euclidean d, F (p, y)‖
  have hHint : Integrable H (ν.prod volume) := by
    simpa only [H] using hFint.integral_prod_left.norm
  let Q : Euclidean d → ℝ := fun x => ∫ t in a..b, H (t, x)
  let Qν : Euclidean d → ℝ := fun x => ∫ t : ℝ, H (t, x) ∂ν
  have hQeq : Q = Qν := by
    funext x
    dsimp only [Q, Qν, ν]
    rw [intervalIntegral.integral_of_le hab, ← integral_Icc_eq_integral_Ioc]
  have hQint : Integrable Qν volume := hHint.integral_prod_right
  have hswap :
      (∫ t : ℝ, ∫ x : Euclidean d, H (t, x) ∂volume ∂ν) =
        ∫ x : Euclidean d, ∫ t : ℝ, H (t, x) ∂ν ∂volume := by
    simpa only [Function.uncurry] using integral_integral_swap hHint
  have hleft :
      (∫ x : Euclidean d, Q x) =
        ∫ x : Euclidean d, ∫ t : ℝ, H (t, x) ∂ν ∂volume := by
    rw [hQeq]
  have hright :
      (∫ t in a..b, ∫ x : Euclidean d, H (t, x)) =
        ∫ t : ℝ, ∫ x : Euclidean d, H (t, x) ∂volume ∂ν := by
    rw [intervalIntegral.integral_of_le hab, ← integral_Icc_eq_integral_Ioc]
  constructor
  · rw [show (fun x : Euclidean d =>
        ∫ t in a..b, ‖∫ y : Euclidean d, atom y *
          ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)) -
            (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - c)))‖) = Q by
        funext x
        rfl]
    rw [hQeq]
    exact hQint
  · change (∫ x : Euclidean d, Q x) =
      ∫ t in a..b, ∫ x : Euclidean d, H (t, x)
    rw [hleft, hright]
    exact hswap.symm

private theorem continuousOn_lacunaryRelativeBandpassPhysicalTerm_radius_schwartz
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d → ℂ)) (j : Nat)
    (f : SchwartzMap (Euclidean d) ℂ) {a b : ℝ}
    (ha : 0 < a) (hab : a ≤ b) (x : Euclidean d) :
    ContinuousOn (fun r : ℝ =>
      lacunaryRelativeBandpassPhysicalTerm psi j r (f : Euclidean d → ℂ) x)
      (Icc a b) := by
  obtain ⟨G, hG⟩ :=
    exists_schwartz_lacunaryRelativeBandpassPhysicalKernelRadiusGenerator
      psi hpsiCompact j
  let H : ℝ → ℂ := fun t => ∫ y : Euclidean d,
    (f : Euclidean d → ℂ) y *
      ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)))
  have hHint : IntervalIntegrable H volume a b := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le hab]
    change Integrable H (volume.restrict (Icc a b))
    simpa only [H] using
      (integrable_uncurry_radiusGeneratorDilation_atom_on_Icc
        G (a := a) (b := b) ha (f : Euclidean d → ℂ) f.integrable x).integral_prod_left
  have hprimitive : ContinuousOn (fun r : ℝ => ∫ t in a..r, H t) (Icc a b) := by
    have haI : a ∈ uIcc a b := by
      rw [uIcc_of_le hab]
      exact ⟨le_rfl, hab⟩
    simpa only [uIcc_of_le hab] using
      intervalIntegral.continuousOn_primitive_interval' hHint haI
  apply (hprimitive.add continuousOn_const).congr
  intro r hr
  change lacunaryRelativeBandpassPhysicalTerm psi j r
      (f : Euclidean d → ℂ) x =
    (∫ t in a..r, H t) +
      lacunaryRelativeBandpassPhysicalTerm psi j a
        (f : Euclidean d → ℂ) x
  rw [← sub_eq_iff_eq_add]
  simpa only [H] using
    lacunaryRelativeBandpassPhysicalTerm_sub_left_eq_intervalIntegral_generator
      hd psi j G hG ha hr.1 (f : Euclidean d → ℂ) f.integrable x

private theorem add_sum_iSup_le_of_forall_selection
    {ι : Type*} (s : Finset ι) (κ : ι → Type*) [∀ i, Nonempty (κ i)]
    (F : ∀ i, κ i → ENNReal) (A L : ENNReal)
    (h : ∀ u : ∀ i, κ i, A + ∑ i ∈ s, F i (u i) ≤ L) :
    A + ∑ i ∈ s, ⨆ t : κ i, F i t ≤ L := by
  classical
  induction s using Finset.induction_on generalizing A with
  | empty =>
      simpa using h (fun i => Classical.choice (inferInstance : Nonempty (κ i)))
  | insert a s ha ih =>
      rw [Finset.sum_insert ha, ← add_assoc, ENNReal.add_iSup, ENNReal.iSup_add]
      apply iSup_le
      intro t
      apply ih (A := A + F a t)
      intro u
      let v : ∀ i, κ i := fun i => if hia : i = a then hia ▸ t else u i
      have hv := h v
      have hvat : v a = t := by simp [v]
      have hvsum : (∑ i ∈ s, F i (v i)) = ∑ i ∈ s, F i (u i) := by
        apply Finset.sum_congr rfl
        intro i hi
        have hne : i ≠ a := by
          intro hia
          exact ha (hia ▸ hi)
        simp [v, hne]
      rw [Finset.sum_insert ha, hvat, hvsum] at hv
      simpa only [add_assoc] using hv

private theorem memLp_two_conj_lacunaryRelativeBandpassPhysicalKernel_sub_left
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    {r : ℝ} (hr : 0 < r) (x : Euclidean d) :
    MemLp (fun y : Euclidean d =>
      conj (lacunaryRelativeBandpassPhysicalKernel psi j r (x - y))) 2 volume := by
  let K := lacunaryRelativeBandpassPhysicalKernel psi j r
  let B : ℝ := (((((2 : ℝ) ^ j)⁻¹ * r)⁻¹) ^ d *
    ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ).toBoundedContinuousFunction‖) * surfaceMass d
  have hK : Integrable K volume :=
    integrable_lacunaryRelativeBandpassPhysicalKernel psi j hr
  have hKB : ∀ z, ‖K z‖ ≤ B := by
    intro z
    exact norm_lacunaryRelativeBandpassPhysicalKernel_le psi j hr z
  have hKsq : Integrable (fun z : Euclidean d => ‖K z‖ ^ 2) volume := by
    refine Integrable.mono (hK.norm.const_mul B) ?_ ?_
    · exact (hK.aestronglyMeasurable.norm.pow 2)
    · filter_upwards with z
      have hnon : 0 ≤ B := le_trans (norm_nonneg _) (hKB z)
      rw [Real.norm_of_nonneg (sq_nonneg _), Real.norm_of_nonneg
        (mul_nonneg hnon (norm_nonneg _))]
      calc
        ‖K z‖ ^ 2 = ‖K z‖ * ‖K z‖ := by ring
        _ ≤ B * ‖K z‖ := mul_le_mul_of_nonneg_right (hKB z) (norm_nonneg _)
  have hshift_sq : Integrable (fun y : Euclidean d => ‖K (x - y)‖ ^ 2) volume :=
    hKsq.comp_sub_left x
  have hshift_meas : AEStronglyMeasurable (fun y : Euclidean d => K (x - y)) volume := by
    exact ((continuous_lacunaryRelativeBandpassPhysicalKernel psi j hr).comp
      (continuous_const.sub continuous_id)).aestronglyMeasurable
  have hshift : MemLp (fun y : Euclidean d => K (x - y)) 2 volume :=
    (memLp_two_iff_integrable_sq_norm hshift_meas).2 hshift_sq
  change MemLp (fun y : Euclidean d =>
    (Complex.conjCLE : ℂ →L[ℝ] ℂ) (K (x - y))) 2 volume
  exact hshift.continuousLinearMap_comp Complex.conjCLE.toContinuousLinearMap

private theorem inner_conj_lacunaryRelativeBandpassPhysicalKernel_eq_physicalTerm
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    {r : ℝ} (hr : 0 < r) (x : Euclidean d)
    (u : Euclidean d → ℂ) (hu : MemLp u 2 volume) :
    inner ℂ
      ((memLp_two_conj_lacunaryRelativeBandpassPhysicalKernel_sub_left psi j hr x).toLp
        (fun y : Euclidean d =>
          conj (lacunaryRelativeBandpassPhysicalKernel psi j r (x - y))))
      (hu.toLp u) =
        lacunaryRelativeBandpassPhysicalTerm psi j r u x := by
  rw [L2.inner_def]
  apply integral_congr_ae
  filter_upwards [
    (memLp_two_conj_lacunaryRelativeBandpassPhysicalKernel_sub_left psi j hr x).coeFn_toLp,
    hu.coeFn_toLp] with y hK hu
  rw [hK, hu, RCLike.inner_apply]
  simp only [starRingEnd_apply, star_star]

private theorem tendsto_lacunaryRelativeBandpassPhysicalTerm_of_tendsto_toLp
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    {r : ℝ} (hr : 0 < r) (x : Euclidean d)
    (f : ℕ → SchwartzMap (Euclidean d) ℂ)
    (g : Euclidean d → ℂ) (hg2 : MemLp g 2 volume)
    (hfg : Tendsto (fun n => (f n).toLp 2 volume) atTop (𝓝 (hg2.toLp g))) :
    Tendsto (fun n => lacunaryRelativeBandpassPhysicalTerm psi j r
      (f n : Euclidean d → ℂ) x) atTop
        (𝓝 (lacunaryRelativeBandpassPhysicalTerm psi j r g x)) := by
  have hinter : Tendsto
      (fun n => inner ℂ
        ((memLp_two_conj_lacunaryRelativeBandpassPhysicalKernel_sub_left psi j hr x).toLp
          (fun y : Euclidean d =>
            conj (lacunaryRelativeBandpassPhysicalKernel psi j r (x - y))))
        ((f n).toLp 2 volume)) atTop
      (𝓝 (inner ℂ
        ((memLp_two_conj_lacunaryRelativeBandpassPhysicalKernel_sub_left psi j hr x).toLp
          (fun y : Euclidean d =>
            conj (lacunaryRelativeBandpassPhysicalKernel psi j r (x - y))))
        (hg2.toLp g))) := by
    exact tendsto_const_nhds.inner hfg
  have hfun :
      (fun n => inner ℂ
        ((memLp_two_conj_lacunaryRelativeBandpassPhysicalKernel_sub_left psi j hr x).toLp
          (fun y : Euclidean d =>
            conj (lacunaryRelativeBandpassPhysicalKernel psi j r (x - y))))
        ((f n).toLp 2 volume)) =
      fun n => lacunaryRelativeBandpassPhysicalTerm psi j r
        (f n : Euclidean d → ℂ) x := by
    funext n
    exact inner_conj_lacunaryRelativeBandpassPhysicalKernel_eq_physicalTerm psi j hr x
      (f n : Euclidean d → ℂ) ((f n).memLp 2 volume)
  have hlim : inner ℂ
      ((memLp_two_conj_lacunaryRelativeBandpassPhysicalKernel_sub_left psi j hr x).toLp
        (fun y : Euclidean d =>
          conj (lacunaryRelativeBandpassPhysicalKernel psi j r (x - y))))
      (hg2.toLp g) = lacunaryRelativeBandpassPhysicalTerm psi j r g x :=
    inner_conj_lacunaryRelativeBandpassPhysicalKernel_eq_physicalTerm psi j hr x g hg2
  rw [hfun, hlim] at hinter
  exact hinter

private theorem tendsto_lacunaryRelativeBandpassPhysicalTerm_difference_square_of_tendsto_toLp
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    {a r : ℝ} (ha : 0 < a) (har : a ≤ r) (x : Euclidean d)
    (f : ℕ → SchwartzMap (Euclidean d) ℂ)
    (g : Euclidean d → ℂ) (hg2 : MemLp g 2 volume)
    (hfg : Tendsto (fun n => (f n).toLp 2 volume) atTop (𝓝 (hg2.toLp g))) :
    Tendsto (fun n => ENNReal.ofReal
      (‖lacunaryRelativeBandpassPhysicalTerm psi j r
          (f n : Euclidean d → ℂ) x -
        lacunaryRelativeBandpassPhysicalTerm psi j a
          (f n : Euclidean d → ℂ) x‖ ^ 2)) atTop
      (𝓝 (ENNReal.ofReal
        (‖lacunaryRelativeBandpassPhysicalTerm psi j r g x -
