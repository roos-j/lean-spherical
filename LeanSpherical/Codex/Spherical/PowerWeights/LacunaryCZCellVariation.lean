      exact (continuous_norm.mul hderiv_cont.norm).aestronglyMeasurable
    · filter_upwards with x
      rw [Real.norm_of_nonneg (mul_nonneg (norm_nonneg _) (norm_nonneg _))]
      exact hpoint x
  have hswap :
      (∫ x : Euclidean d,
        ∫ omega : Metric.sphere (0 : Euclidean d) 1, P (x, omega)
          ∂unitSurfaceMeasure d) =
        ∫ omega : Metric.sphere (0 : Euclidean d) 1,
          (∫ x : Euclidean d, P (x, omega)) ∂unitSurfaceMeasure d :=
    integral_integral_swap hPprod
  have hinner (omega : Metric.sphere (0 : Euclidean d) 1) :
      (∫ x : Euclidean d, P (x, omega)) =
        (∫ x : Euclidean d, ‖x‖ * ‖fderiv ℝ f x‖) +
          ∫ x : Euclidean d, ‖fderiv ℝ f x‖ := by
    dsimp only [P]
    simp_rw [mul_add, mul_one]
    have hfirstslice : Integrable (fun x : Euclidean d =>
        ‖D (x, omega)‖ * ‖x + (omega : Euclidean d)‖) volume := by
      dsimp only [D]
      simpa only [mul_comm] using
        hweighted.comp_add_right (omega : Euclidean d)
    have hsecondslice : Integrable (fun x : Euclidean d =>
        ‖D (x, omega)‖) volume := by
      dsimp only [D]
      exact hdf.norm.comp_add_right (omega : Euclidean d)
    rw [integral_add hfirstslice hsecondslice]
    dsimp only [D]
    rw [show (∫ x : Euclidean d,
        ‖fderiv ℝ f (x + (omega : Euclidean d))‖ * ‖x + (omega : Euclidean d)‖) =
        ∫ x : Euclidean d, ‖x‖ * ‖fderiv ℝ f x‖ by
      simpa only [mul_comm] using
        (integral_add_right_eq_self (μ := volume)
          (fun x : Euclidean d => ‖x‖ * ‖fderiv ℝ f x‖) (omega : Euclidean d)),
      integral_add_right_eq_self (μ := volume)
        (fun x : Euclidean d => ‖fderiv ℝ f x‖) (omega : Euclidean d)]
  refine ⟨hleft, ?_⟩
  calc
      (∫ x : Euclidean d,
        ‖x‖ * ‖fderiv ℝ (sphericalAverage d f 1) x‖) ≤
          ∫ x : Euclidean d,
            ∫ omega : Metric.sphere (0 : Euclidean d) 1, P (x, omega)
              ∂unitSurfaceMeasure d :=
        integral_mono hleft hPint hpoint
      _ = ∫ omega : Metric.sphere (0 : Euclidean d) 1,
            (∫ x : Euclidean d, P (x, omega)) ∂unitSurfaceMeasure d := hswap
      _ = _ := by
        rw [show (fun omega : Metric.sphere (0 : Euclidean d) 1 =>
            ∫ x : Euclidean d, P (x, omega)) =
            fun _ => (∫ x : Euclidean d, ‖x‖ * ‖fderiv ℝ f x‖) +
              ∫ x : Euclidean d, ‖fderiv ℝ f x‖ by
          funext omega
          exact hinner omega]
        simp [surfaceMass]

private theorem contDiff_one_lacunaryRelativeBandpassPhysicalKernel_one
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat) :
    ContDiff ℝ 1 (lacunaryRelativeBandpassPhysicalKernel psi j 1) := by
  let s : ℝ := (2 : ℝ) ^ j
  have hs : 0 < s := by
    dsimp [s]
    positivity
  let A : Euclidean d ≃L[ℝ] Euclidean d :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 s hs.ne')
  let K : SchwartzMap (Euclidean d) ℂ :=
    (s ^ d) • (SchwartzMap.compCLMOfContinuousLinearEquiv ℂ A) (𝓕⁻ psi)
  have hKform (x : Euclidean d) :
      K x = ((s ^ d : ℝ) : ℂ) • (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • x) := by
    change (s ^ d) • (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (A x) = _
    simp [A]
  have hscale : (((2 : ℝ) ^ j)⁻¹ * (1 : ℝ))⁻¹ = s := by
    dsimp [s]
    field_simp
  have hkernel : lacunaryRelativeBandpassPhysicalKernel psi j 1 =
      sphericalAverage d (K : Euclidean d → ℂ) 1 := by
    funext x
    unfold lacunaryRelativeBandpassPhysicalKernel
    rw [hscale]
    apply congrArg (fun f : Euclidean d → ℂ => sphericalAverage d f 1 x)
    funext z
    exact hKform z
  rw [hkernel]
  apply contDiff_one_sphericalAverage_fixed_of_bounded_fderiv
    (K : Euclidean d → ℂ) (by simpa using K.smooth (1 : ℕ∞))
    ‖((SchwartzMap.fderivCLM ℂ (Euclidean d) ℂ) K).toBoundedContinuousFunction‖
  intro x
  change ‖((SchwartzMap.fderivCLM ℂ (Euclidean d) ℂ) K) x‖ ≤ _
  exact BoundedContinuousFunction.norm_coe_le_norm
    ((SchwartzMap.fderivCLM ℂ (Euclidean d) ℂ) K).toBoundedContinuousFunction x

private theorem hasDerivAt_lacunaryRelativeBandpassPhysicalKernel
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    {r : ℝ} (hr : 0 < r) (x : Euclidean d) :
    HasDerivAt (fun s : ℝ => lacunaryRelativeBandpassPhysicalKernel psi j s x)
      ((r⁻¹ ^ d : ℝ) •
          (fderiv ℝ (lacunaryRelativeBandpassPhysicalKernel psi j 1)
            (r⁻¹ • x)) (-(r⁻¹ ^ 2) • x) +
        ((d : ℝ) * r⁻¹ ^ (d - 1) * (-(r⁻¹ ^ 2))) •
          lacunaryRelativeBandpassPhysicalKernel psi j 1 (r⁻¹ • x)) r := by
  let H : Euclidean d → ℂ := lacunaryRelativeBandpassPhysicalKernel psi j 1
  have hH : ContDiff ℝ 1 H := by
    simpa only [H] using contDiff_one_lacunaryRelativeBandpassPhysicalKernel_one psi j
  have hderiv := hasDerivAt_normalizedPhysicalDilation H hH hr.ne' x
  refine hderiv.congr_of_eventuallyEq ?_
  filter_upwards [eventually_gt_nhds hr] with s hs
  simpa only [H, normalizedPhysicalDilation] using
    lacunaryRelativeBandpassPhysicalKernel_dilate psi j hs x

private def lacunaryRelativeBandpassPhysicalKernelRadiusDerivative
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (r : ℝ) (x : Euclidean d) : ℂ :=
  ((r⁻¹ ^ d : ℝ) •
      (fderiv ℝ (lacunaryRelativeBandpassPhysicalKernel psi j 1)
        (r⁻¹ • x)) (-(r⁻¹ ^ 2) • x) +
    ((d : ℝ) * r⁻¹ ^ (d - 1) * (-(r⁻¹ ^ 2))) •
      lacunaryRelativeBandpassPhysicalKernel psi j 1 (r⁻¹ • x))

/-- The fixed physical generator for a relative-radius derivative. -/
def lacunaryRelativeBandpassPhysicalKernelRadiusGenerator
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (z : Euclidean d) : ℂ :=
  -((d : ℝ) • lacunaryRelativeBandpassPhysicalKernel psi j 1 z +
    (fderiv ℝ (lacunaryRelativeBandpassPhysicalKernel psi j 1) z) z)

/-- Radius differentiation of the relative physical kernel is a normalized
dilation of its fixed generator. -/
theorem lacunaryRelativeBandpassPhysicalKernelRadiusDerivative_eq_dilate_generator
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    {r : ℝ} (hr : 0 < r) (x : Euclidean d) :
    lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j r x =
      (r⁻¹ ^ (d + 1) : ℝ) •
        lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j (r⁻¹ • x) := by
  have hr0 : r ≠ 0 := hr.ne'
  unfold lacunaryRelativeBandpassPhysicalKernelRadiusDerivative
    lacunaryRelativeBandpassPhysicalKernelRadiusGenerator
  rw [show -(r⁻¹ ^ 2) • x = (-r⁻¹) • (r⁻¹ • x) by
    rw [smul_smul]
    congr 1
    ring]
  simp only [map_smul, Complex.real_smul, smul_add, smul_neg]
  have hd1 : 1 ≤ d := hd
  have hpow : ((r : ℂ)⁻¹) ^ 2 * ((r : ℂ)⁻¹) ^ (d - 1) =
      (r : ℂ)⁻¹ * ((r : ℂ)⁻¹) ^ d := by
    calc
      ((r : ℂ)⁻¹) ^ 2 * ((r : ℂ)⁻¹) ^ (d - 1) =
          ((r : ℂ)⁻¹) ^ (2 + (d - 1)) := (pow_add _ _ _).symm
      _ = ((r : ℂ)⁻¹) ^ (d + 1) := by congr 1 <;> omega
      _ = ((r : ℂ)⁻¹) ^ d * (r : ℂ)⁻¹ := pow_succ _ _
      _ = (r : ℂ)⁻¹ * ((r : ℂ)⁻¹) ^ d := by ring
  push_cast
  ring_nf
  rw [hpow]
  ring

private theorem hasDerivAt_lacunaryRelativeBandpassPhysicalKernel_radiusDerivative
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    {r : ℝ} (hr : 0 < r) (x : Euclidean d) :
    HasDerivAt (fun s : ℝ => lacunaryRelativeBandpassPhysicalKernel psi j s x)
      (lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j r x) r := by
  simpa only [lacunaryRelativeBandpassPhysicalKernelRadiusDerivative] using
    hasDerivAt_lacunaryRelativeBandpassPhysicalKernel psi j hr x

private theorem continuousOn_lacunaryRelativeBandpassPhysicalKernel_radiusDerivative
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat) (x : Euclidean d) :
    ContinuousOn (fun r : ℝ =>
      lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j r x) (Ioi 0) := by
  let H : Euclidean d → ℂ := lacunaryRelativeBandpassPhysicalKernel psi j 1
  have hH : ContDiff ℝ 1 H := by
    simpa only [H] using contDiff_one_lacunaryRelativeBandpassPhysicalKernel_one psi j
  have hDH : Continuous (fderiv ℝ H) := hH.continuous_fderiv (by norm_num)
  intro r hr
  have hr0 : r ≠ 0 := ne_of_gt hr
  unfold lacunaryRelativeBandpassPhysicalKernelRadiusDerivative
  dsimp only [H] at hDH ⊢
  have hinv : ContinuousAt (fun s : ℝ => s⁻¹) r := continuousAt_inv₀ hr0
  have harg : ContinuousAt (fun s : ℝ => s⁻¹ • x) r := hinv.smul_const x
  have hDarg : ContinuousAt (fun s : ℝ =>
      fderiv ℝ (lacunaryRelativeBandpassPhysicalKernel psi j 1) (s⁻¹ • x)) r :=
    hDH.continuousAt.comp harg
  have hv : ContinuousAt (fun s : ℝ => -(s⁻¹ ^ 2) • x) r :=
    (hinv.pow 2).neg.smul_const x
  have happly : ContinuousAt (fun s : ℝ =>
      (fderiv ℝ (lacunaryRelativeBandpassPhysicalKernel psi j 1) (s⁻¹ • x))
        (-(s⁻¹ ^ 2) • x)) r :=
    hDarg.clm_apply hv
  have hfirst : ContinuousAt (fun s : ℝ =>
      (s⁻¹ ^ d : ℝ) •
        (fderiv ℝ (lacunaryRelativeBandpassPhysicalKernel psi j 1) (s⁻¹ • x))
          (-(s⁻¹ ^ 2) • x)) r :=
    (hinv.pow d).smul happly
  have hcoef : ContinuousAt (fun s : ℝ =>
      (d : ℝ) * s⁻¹ ^ (d - 1) * (-(s⁻¹ ^ 2))) r :=
    ((continuousAt_const.mul (hinv.pow (d - 1))).mul (hinv.pow 2).neg)
  have hHarg : ContinuousAt (fun s : ℝ =>
      lacunaryRelativeBandpassPhysicalKernel psi j 1 (s⁻¹ • x)) r :=
    hH.continuous.continuousAt.comp harg
  exact (hfirst.add (hcoef.smul hHarg)).continuousWithinAt

/-- The literal signed fundamental-theorem-of-calculus identity for one
relative-radius cell.  Keeping this identity signed is essential: after a
Calderón--Zygmund bad atom is inserted, its mean-zero cancellation applies to
the radius derivative before any absolute values are taken. -/
theorem lacunaryRelativeBandpassPhysicalKernel_sub_left_eq_intervalIntegral_radiusDerivative
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    {a r : ℝ} (ha : 0 < a) (har : a ≤ r) (x : Euclidean d) :
    lacunaryRelativeBandpassPhysicalKernel psi j r x -
        lacunaryRelativeBandpassPhysicalKernel psi j a x =
      ∫ t in a..r,
        lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t x := by
  let F : ℝ → ℂ := fun t =>
    lacunaryRelativeBandpassPhysicalKernel psi j t x -
      lacunaryRelativeBandpassPhysicalKernel psi j a x
  have hcont : ContinuousOn (fun t : ℝ =>
      lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t x) (Icc a r) := by
    apply ContinuousOn.mono
      (continuousOn_lacunaryRelativeBandpassPhysicalKernel_radiusDerivative psi j x)
    intro t ht
    exact lt_of_lt_of_le ha ht.1
  have hFcont : ContinuousOn F (Icc a r) := by
    intro t ht
    have htpos : 0 < t := lt_of_lt_of_le ha ht.1
    exact ((hasDerivAt_lacunaryRelativeBandpassPhysicalKernel_radiusDerivative psi j htpos x).sub
      (hasDerivAt_const t _)).continuousAt.continuousWithinAt
  have hFTC : (∫ t in a..r,
      lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t x) = F r - F a := by
    apply intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le har hFcont
    · intro t ht
      have htpos : 0 < t := lt_of_lt_of_le ha (le_of_lt ht.1)
      simpa only [F, sub_zero] using
        (hasDerivAt_lacunaryRelativeBandpassPhysicalKernel_radiusDerivative psi j htpos x).sub_const
          (lacunaryRelativeBandpassPhysicalKernel psi j a x)
    · apply (show ContinuousOn (fun t : ℝ =>
          lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t x) (uIcc a r) by
        simpa only [uIcc_of_le har] using hcont).intervalIntegrable
  simpa only [F, sub_self, sub_zero] using hFTC.symm

private theorem norm_lacunaryRelativeBandpassPhysicalKernel_sub_left_le_intervalIntegral
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    {a b r : ℝ} (ha : 0 < a) (hab : a ≤ b) (hr : r ∈ Icc a b)
    (x : Euclidean d) :
    ‖lacunaryRelativeBandpassPhysicalKernel psi j r x -
        lacunaryRelativeBandpassPhysicalKernel psi j a x‖ ≤
      ∫ t in a..b,
        ‖lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t x‖ := by
  let F : ℝ → ℂ := fun t =>
    lacunaryRelativeBandpassPhysicalKernel psi j t x -
      lacunaryRelativeBandpassPhysicalKernel psi j a x
  have hcont : ContinuousOn (fun t : ℝ =>
      lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t x) (Icc a b) := by
    apply ContinuousOn.mono
      (continuousOn_lacunaryRelativeBandpassPhysicalKernel_radiusDerivative psi j x)
    intro t ht
    exact lt_of_lt_of_le ha ht.1
  have hFcont : ContinuousOn F (Icc a b) := by
    intro t ht
    have htpos : 0 < t := lt_of_lt_of_le ha ht.1
    exact ((hasDerivAt_lacunaryRelativeBandpassPhysicalKernel_radiusDerivative psi j htpos x).sub
      (hasDerivAt_const t _)).continuousAt.continuousWithinAt
  have hFcont_ar : ContinuousOn F (Icc a r) :=
    hFcont.mono (Icc_subset_Icc le_rfl hr.2)
  have hcont_ar : ContinuousOn (fun t : ℝ =>
      lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t x) (Icc a r) :=
    hcont.mono (Icc_subset_Icc le_rfl hr.2)
  have hFTC : (∫ t in a..r,
      lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t x) = F r - F a := by
    apply intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le hr.1 hFcont_ar
    · intro t ht
      have htpos : 0 < t := lt_of_lt_of_le ha (le_of_lt ht.1)
      simpa only [F, sub_zero] using
        (hasDerivAt_lacunaryRelativeBandpassPhysicalKernel_radiusDerivative psi j htpos x).sub_const
          (lacunaryRelativeBandpassPhysicalKernel psi j a x)
    · apply (show ContinuousOn (fun t : ℝ =>
          lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t x) (uIcc a r) by
        simpa only [uIcc_of_le hr.1] using hcont_ar).intervalIntegrable
  have hnorm : ‖F r‖ ≤ ∫ t in a..r,
      ‖lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t x‖ := by
    have hFzero : F a = 0 := by
      simp only [F, sub_self]
    calc
      ‖F r‖ = ‖F r - F a‖ := by rw [hFzero, sub_zero]
      _ = ‖∫ t in a..r,
          lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t x‖ := by rw [hFTC]
      _ ≤ ∫ t in a..r,
          ‖lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t x‖ :=
        intervalIntegral.norm_integral_le_integral_norm hr.1
  have hmono : (∫ t in a..r,
      ‖lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t x‖) ≤
      ∫ t in a..b,
        ‖lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t x‖ := by
    apply intervalIntegral.integral_mono_interval le_rfl hr.1 hr.2
    · filter_upwards with t
      exact norm_nonneg _
    · apply (show ContinuousOn (fun t : ℝ =>
          ‖lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t x‖) (uIcc a b) by
        simpa only [uIcc_of_le hab] using hcont.norm).intervalIntegrable
  simpa only [F, sub_self, norm_zero, zero_add] using hnorm.trans hmono

/-- The literal short-cell fundamental-theorem estimate in the form used by
the finite physical palette. -/
theorem norm_lacunaryRelativeBandpassPhysicalKernel_sub_left_le_intervalIntegral_generator
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    {a b r : ℝ} (ha : 0 < a) (hab : a ≤ b) (hr : r ∈ Icc a b)
    (x : Euclidean d) :
    ‖lacunaryRelativeBandpassPhysicalKernel psi j r x -
        lacunaryRelativeBandpassPhysicalKernel psi j a x‖ ≤
      ∫ t in a..b,
        t⁻¹ ^ (d + 1) *
          ‖lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j (t⁻¹ • x)‖ := by
  calc
    ‖lacunaryRelativeBandpassPhysicalKernel psi j r x -
        lacunaryRelativeBandpassPhysicalKernel psi j a x‖ ≤
        ∫ t in a..b,
          ‖lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t x‖ :=
      norm_lacunaryRelativeBandpassPhysicalKernel_sub_left_le_intervalIntegral
        psi j ha hab hr x
    _ = ∫ t in a..b,
        t⁻¹ ^ (d + 1) *
          ‖lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j (t⁻¹ • x)‖ := by
      apply intervalIntegral.integral_congr
      intro t ht
      have htIcc : t ∈ Icc a b := by
        simpa only [uIcc_of_le hab] using ht
      have htpos : 0 < t := lt_of_lt_of_le ha htIcc.1
      change ‖lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j t x‖ = _
      rw [lacunaryRelativeBandpassPhysicalKernelRadiusDerivative_eq_dilate_generator
        hd psi j htpos x, norm_smul, Real.norm_eq_abs, abs_of_nonneg]
      exact pow_nonneg (inv_nonneg.mpr htpos.le) _

/-- The relative-radius generator has the expected one factor of the
frequency scale in `L¹`.  The displayed constant is intentionally literal:
only its finiteness and its independence of `j` are used later. -/
theorem integral_norm_lacunaryRelativeBandpassPhysicalKernelRadiusGenerator_le
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat) :
    (∫ x : Euclidean d,
      ‖lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j x‖) ≤
      (2 : ℝ) ^ j * surfaceMass d *
        ((d : ℝ) * (∫ x : Euclidean d,
            ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) x‖) +
          (∫ x : Euclidean d, ‖x‖ *
            ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
              Euclidean d → ℂ) x‖) +
          ∫ x : Euclidean d,
            ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
              Euclidean d → ℂ) x‖) := by
  let s : ℝ := (2 : ℝ) ^ j
  have hs : 0 < s := by
    dsimp [s]
    positivity
  let A : Euclidean d ≃L[ℝ] Euclidean d :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 s hs.ne')
  let k : SchwartzMap (Euclidean d) ℂ := 𝓕⁻ psi
  let K : SchwartzMap (Euclidean d) ℂ :=
    (s ^ d) • (SchwartzMap.compCLMOfContinuousLinearEquiv ℂ A) k
  have hKform (x : Euclidean d) :
      K x = ((s ^ d : ℝ) : ℂ) • k (s • x) := by
    change (s ^ d) • k (A x) = _
    simp [A]
  have hKfun : (K : Euclidean d → ℂ) =
      fun x => (s ^ d) • k (s • x) := by
    funext x
    exact hKform x
  have hscale : (((2 : ℝ) ^ j)⁻¹ * (1 : ℝ))⁻¹ = s := by
    dsimp [s]
    field_simp
  have hkernel : lacunaryRelativeBandpassPhysicalKernel psi j 1 =
      sphericalAverage d (K : Euclidean d → ℂ) 1 := by
    funext x
    unfold lacunaryRelativeBandpassPhysicalKernel
    rw [hscale]
    apply congrArg (fun q : Euclidean d → ℂ => sphericalAverage d q 1 x)
    funext z
    exact hKform z
  have hkSmooth : ContDiff ℝ 1 (k : Euclidean d → ℂ) := by
    simpa [k] using (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ).smooth (1 : ℕ∞)
  have hKSmooth : ContDiff ℝ 1 (K : Euclidean d → ℂ) := by
    simpa [K] using K.smooth (1 : ℕ∞)
  let dk : SchwartzMap (Euclidean d) (Euclidean d →L[ℝ] ℂ) :=
    (SchwartzMap.fderivCLM ℂ (Euclidean d) ℂ) k
  have hdk : (dk : Euclidean d → (Euclidean d →L[ℝ] ℂ)) =
      fderiv ℝ (k : Euclidean d → ℂ) := by
    funext x
    exact SchwartzMap.fderivCLM_apply ℂ k x
  have hkInt : Integrable (k : Euclidean d → ℂ) volume := k.integrable
  have hkDerivInt : Integrable (fderiv ℝ (k : Euclidean d → ℂ)) volume := by
    rw [← hdk]
    exact dk.integrable
  have hkWeighted : Integrable (fun x : Euclidean d =>
      ‖x‖ * ‖fderiv ℝ (k : Euclidean d → ℂ) x‖) volume := by
    rw [← hdk]
    simpa only [pow_one] using dk.integrable_pow_mul volume 1
  have hKInt : Integrable (K : Euclidean d → ℂ) volume := by
    rw [hKfun]
    exact integrable_dilate d (k : Euclidean d → ℂ) hs hkInt
  have hKDerivInt : Integrable (fderiv ℝ (K : Euclidean d → ℂ)) volume := by
    let dK : SchwartzMap (Euclidean d) (Euclidean d →L[ℝ] ℂ) :=
      (SchwartzMap.fderivCLM ℂ (Euclidean d) ℂ) K
    have hdK : (dK : Euclidean d → (Euclidean d →L[ℝ] ℂ)) =
        fderiv ℝ (K : Euclidean d → ℂ) := by
      funext x
      exact SchwartzMap.fderivCLM_apply ℂ K x
    rw [← hdK]
    exact dK.integrable
  have hKWeighted : Integrable (fun x : Euclidean d =>
      ‖x‖ * ‖fderiv ℝ (K : Euclidean d → ℂ) x‖) volume := by
    let dK : SchwartzMap (Euclidean d) (Euclidean d →L[ℝ] ℂ) :=
      (SchwartzMap.fderivCLM ℂ (Euclidean d) ℂ) K
    have hdK : (dK : Euclidean d → (Euclidean d →L[ℝ] ℂ)) =
        fderiv ℝ (K : Euclidean d → ℂ) := by
      funext x
      exact SchwartzMap.fderivCLM_apply ℂ K x
    rw [← hdK]
    simpa only [pow_one] using dK.integrable_pow_mul volume 1
  have hKbound (x : Euclidean d) :
      ‖fderiv ℝ (K : Euclidean d → ℂ) x‖ ≤
        ‖((SchwartzMap.fderivCLM ℂ (Euclidean d) ℂ) K).toBoundedContinuousFunction‖ := by
    rw [← SchwartzMap.fderivCLM_apply ℂ K x]
    exact BoundedContinuousFunction.norm_coe_le_norm
      ((SchwartzMap.fderivCLM ℂ (Euclidean d) ℂ) K).toBoundedContinuousFunction x
  let H : Euclidean d → ℂ := sphericalAverage d (K : Euclidean d → ℂ) 1
  have hkernelH : lacunaryRelativeBandpassPhysicalKernel psi j 1 = H := by
    simpa only [H] using hkernel
  have hHsmooth : ContDiff ℝ 1 H := by
    dsimp only [H]
    exact contDiff_one_sphericalAverage_fixed_of_bounded_fderiv
      (K : Euclidean d → ℂ) hKSmooth
      ‖((SchwartzMap.fderivCLM ℂ (Euclidean d) ℂ) K).toBoundedContinuousFunction‖ hKbound 1
  have hHInt : Integrable H volume := by
    dsimp only [H]
    exact integrable_sphericalAverage _ hKSmooth.continuous hKInt 1
  have hHWeightedData :=
    integral_norm_mul_fderiv_sphericalAverage_one_le
      (K : Euclidean d → ℂ) hKSmooth
      ‖((SchwartzMap.fderivCLM ℂ (Euclidean d) ℂ) K).toBoundedContinuousFunction‖
      hKbound hKDerivInt hKWeighted
  have hHWeighted : Integrable (fun x : Euclidean d =>
      ‖x‖ * ‖fderiv ℝ H x‖) volume := by
    simpa only [H] using hHWeightedData.1
  have hHWeightedBound :
      (∫ x : Euclidean d, ‖x‖ * ‖fderiv ℝ H x‖) ≤
        surfaceMass d *
          ((∫ x : Euclidean d, ‖x‖ * ‖fderiv ℝ (K : Euclidean d → ℂ) x‖) +
            ∫ x : Euclidean d, ‖fderiv ℝ (K : Euclidean d → ℂ) x‖) := by
    simpa only [H] using hHWeightedData.2
  have hHIntBound :
      (∫ x : Euclidean d, ‖H x‖) ≤
        surfaceMass d * ∫ x : Euclidean d, ‖K x‖ := by
    dsimp only [H]
    exact integral_norm_sphericalAverage_le_surfaceMass_mul
      (K : Euclidean d → ℂ) hKSmooth.continuous hKInt 1
  have hKIntEq :
      (∫ x : Euclidean d, ‖K x‖) = ∫ x : Euclidean d, ‖k x‖ := by
    rw [hKfun]
    exact integral_norm_dilate_eq d (k : Euclidean d → ℂ) hs
  have hKDerivIntEq :
      (∫ x : Euclidean d, ‖fderiv ℝ (K : Euclidean d → ℂ) x‖) =
        s * ∫ x : Euclidean d, ‖fderiv ℝ (k : Euclidean d → ℂ) x‖ := by
    rw [hKfun]
    exact integral_norm_fderiv_dilate_eq (k : Euclidean d → ℂ) hkSmooth hs
  have hKWeightedEq :
      (∫ x : Euclidean d, ‖x‖ * ‖fderiv ℝ (K : Euclidean d → ℂ) x‖) =
        ∫ x : Euclidean d, ‖x‖ * ‖fderiv ℝ (k : Euclidean d → ℂ) x‖ := by
    rw [hKfun]
    exact integral_norm_mul_fderiv_dilate_eq (k : Euclidean d → ℂ) hkSmooth hs
  have hpoint (x : Euclidean d) :
      ‖lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j x‖ ≤
        (d : ℝ) * ‖H x‖ + ‖x‖ * ‖fderiv ℝ H x‖ := by
    unfold lacunaryRelativeBandpassPhysicalKernelRadiusGenerator
    rw [hkernelH]
    calc
      ‖-((d : ℝ) • H x + (fderiv ℝ H x) x)‖ =
          ‖(d : ℝ) • H x + (fderiv ℝ H x) x‖ := norm_neg _
      _ ≤ ‖(d : ℝ) • H x‖ + ‖(fderiv ℝ H x) x‖ := norm_add_le _ _
      _ = (d : ℝ) * ‖H x‖ + ‖(fderiv ℝ H x) x‖ := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (Nat.cast_nonneg d)]
      _ ≤
          (d : ℝ) * ‖H x‖ + ‖fderiv ℝ H x‖ * ‖x‖ :=
        add_le_add le_rfl (ContinuousLinearMap.le_opNorm _ _)
      _ = _ := by ring
  have happlyCont : Continuous (fun x : Euclidean d => (fderiv ℝ H x) x) :=
    (hHsmooth.continuous_fderiv (by norm_num)).clm_apply continuous_id
  have happlyNormInt : Integrable (fun x : Euclidean d =>
      ‖(fderiv ℝ H x) x‖) volume := by
    refine hHWeighted.mono' happlyCont.norm.aestronglyMeasurable ?_
    filter_upwards with x
    calc
      ‖‖(fderiv ℝ H x) x‖‖ = ‖(fderiv ℝ H x) x‖ :=
        Real.norm_of_nonneg (norm_nonneg _)
      _ ≤ ‖fderiv ℝ H x‖ * ‖x‖ := ContinuousLinearMap.le_opNorm _ _
      _ = _ := by ring
  have happlyInt : Integrable (fun x : Euclidean d =>
      (fderiv ℝ H x) x) volume :=
    (integrable_norm_iff happlyCont.aestronglyMeasurable).mp happlyNormInt
  have hgenInt : Integrable
      (lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j) volume := by
    rw [show lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j =
        fun x => -((d : ℝ) • H x + (fderiv ℝ H x) x) by
      funext x
      unfold lacunaryRelativeBandpassPhysicalKernelRadiusGenerator
      rw [hkernelH]]
    exact ((Integrable.smul (d : ℝ) hHInt).add happlyInt).neg
  have hrightInt : Integrable (fun x : Euclidean d =>
      (d : ℝ) * ‖H x‖ + ‖x‖ * ‖fderiv ℝ H x‖) volume :=
    (hHInt.norm.const_mul (d : ℝ)).add hHWeighted
  calc
    (∫ x : Euclidean d,
      ‖lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j x‖) ≤
        ∫ x : Euclidean d,
          ((d : ℝ) * ‖H x‖ + ‖x‖ * ‖fderiv ℝ H x‖) := by
        exact integral_mono hgenInt.norm hrightInt hpoint
    _ = (d : ℝ) * (∫ x : Euclidean d, ‖H x‖) +
        ∫ x : Euclidean d, ‖x‖ * ‖fderiv ℝ H x‖ := by
        rw [integral_add (hHInt.norm.const_mul (d : ℝ)) hHWeighted, integral_const_mul]
    _ ≤ (d : ℝ) * (surfaceMass d * ∫ x : Euclidean d, ‖K x‖) +
        surfaceMass d *
          ((∫ x : Euclidean d, ‖x‖ * ‖fderiv ℝ (K : Euclidean d → ℂ) x‖) +
            ∫ x : Euclidean d, ‖fderiv ℝ (K : Euclidean d → ℂ) x‖) := by
        exact add_le_add
          (mul_le_mul_of_nonneg_left hHIntBound (Nat.cast_nonneg d)) hHWeightedBound
    _ = surfaceMass d *
        ((d : ℝ) * (∫ x : Euclidean d, ‖k x‖) +
          (∫ x : Euclidean d, ‖x‖ * ‖fderiv ℝ (k : Euclidean d → ℂ) x‖) +
          s * ∫ x : Euclidean d, ‖fderiv ℝ (k : Euclidean d → ℂ) x‖) := by
        rw [hKIntEq, hKWeightedEq, hKDerivIntEq]
        ring
    _ ≤ s * surfaceMass d *
        ((d : ℝ) * (∫ x : Euclidean d, ‖k x‖) +
          (∫ x : Euclidean d, ‖x‖ * ‖fderiv ℝ (k : Euclidean d → ℂ) x‖) +
          ∫ x : Euclidean d, ‖fderiv ℝ (k : Euclidean d → ℂ) x‖) := by
        have hsone : 1 ≤ s := by
          dsimp only [s]
          exact one_le_pow₀ (by norm_num : (1 : ℝ) ≤ 2)
        have hA : 0 ≤ (d : ℝ) * (∫ x : Euclidean d, ‖k x‖) :=
          mul_nonneg (Nat.cast_nonneg d) (integral_nonneg fun _ => norm_nonneg _)
        have hB : 0 ≤ ∫ x : Euclidean d,
            ‖x‖ * ‖fderiv ℝ (k : Euclidean d → ℂ) x‖ :=
          integral_nonneg fun _ => mul_nonneg (norm_nonneg _) (norm_nonneg _)
        have hC : 0 ≤ ∫ x : Euclidean d, ‖fderiv ℝ (k : Euclidean d → ℂ) x‖ :=
          integral_nonneg fun _ => norm_nonneg _
        have hsum : (d : ℝ) * (∫ x : Euclidean d, ‖k x‖) +
            (∫ x : Euclidean d, ‖x‖ * ‖fderiv ℝ (k : Euclidean d → ℂ) x‖) +
            s * ∫ x : Euclidean d, ‖fderiv ℝ (k : Euclidean d → ℂ) x‖ ≤
          s * ((d : ℝ) * (∫ x : Euclidean d, ‖k x‖) +
            (∫ x : Euclidean d, ‖x‖ * ‖fderiv ℝ (k : Euclidean d → ℂ) x‖) +
            ∫ x : Euclidean d, ‖fderiv ℝ (k : Euclidean d → ℂ) x‖) := by
          nlinarith [mul_le_mul_of_nonneg_right hsone hA,
            mul_le_mul_of_nonneg_right hsone hB]
        nlinarith [surfaceMass_pos hd]
    _ = _ := by rfl

/-- A literal, scale-independent coefficient for one more spatial derivative
of the relative-radius generator.  The second-derivative moment is exactly
what the cancellation estimate for the shifted future cells consumes. -/
def lacunaryRelativeBandpassPhysicalKernelRadiusGeneratorFDerivConstant
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) : ℝ :=
  surfaceMass d *
    (((d : ℝ) + 1) *
      (∫ x : Euclidean d,
        ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
          Euclidean d → ℂ) x‖) +
      (∫ x : Euclidean d,
        ‖x‖ * ‖fderiv ℝ
          (fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
            Euclidean d → ℂ)) x‖) +
      ∫ x : Euclidean d,
        ‖fderiv ℝ
          (fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
            Euclidean d → ℂ)) x‖)

/-- The `L¹` norm of the literal radius derivative is the fixed generator
norm times `r⁻¹`.  Combined with the preceding theorem, a cell of relative
width `O(2⁻ʲ)` has a scale-uniform cost. -/
theorem integral_norm_lacunaryRelativeBandpassPhysicalKernelRadiusDerivative_le
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    {r : ℝ} (hr : 0 < r) :
    (∫ x : Euclidean d,
      ‖lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j r x‖) ≤
      r⁻¹ * ((2 : ℝ) ^ j * surfaceMass d *
        ((d : ℝ) * (∫ x : Euclidean d,
            ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) x‖) +
          (∫ x : Euclidean d, ‖x‖ *
            ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
              Euclidean d → ℂ) x‖) +
          ∫ x : Euclidean d,
            ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
              Euclidean d → ℂ) x‖)) := by
  let G : Euclidean d → ℂ :=
    lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j
  have hG := integral_norm_lacunaryRelativeBandpassPhysicalKernelRadiusGenerator_le
    hd psi j
  have hrinv : 0 < r⁻¹ := inv_pos.mpr hr
  have hnorm :
      (∫ x : Euclidean d,
        ‖lacunaryRelativeBandpassPhysicalKernelRadiusDerivative psi j r x‖) =
        r⁻¹ * ∫ x : Euclidean d, ‖G x‖ := by
    simp_rw [lacunaryRelativeBandpassPhysicalKernelRadiusDerivative_eq_dilate_generator
      hd psi j hr]
    calc
      (∫ x : Euclidean d, ‖(r⁻¹ ^ (d + 1) : ℝ) • G (r⁻¹ • x)‖) =
          r⁻¹ ^ (d + 1) *
            ∫ x : Euclidean d, ‖G (r⁻¹ • x)‖ := by
          rw [show (fun x : Euclidean d =>
              ‖(r⁻¹ ^ (d + 1) : ℝ) • G (r⁻¹ • x)‖) =
              fun x => r⁻¹ ^ (d + 1) * ‖G (r⁻¹ • x)‖ by
            funext x
            rw [norm_smul, Real.norm_eq_abs,
              abs_of_nonneg (pow_nonneg hrinv.le _)], integral_const_mul]
      _ = r⁻¹ ^ (d + 1) * ((r⁻¹ ^ d)⁻¹ *
          ∫ x : Euclidean d, ‖G x‖) := by
          rw [integral_norm_comp_smul_eq d G hrinv]
      _ = r⁻¹ * ∫ x : Euclidean d, ‖G x‖ := by
          have hr0 : r ≠ 0 := hr.ne'
          have hpow : r⁻¹ ^ (d + 1) * (r⁻¹ ^ d)⁻¹ = r⁻¹ := by
            have hinvpow : (r⁻¹ ^ d)⁻¹ = r ^ d := by
              rw [← inv_pow, inv_inv]
            rw [hinvpow, pow_succ]
            calc
              r⁻¹ ^ d * r⁻¹ * r ^ d =
                  r⁻¹ * (r⁻¹ ^ d * r ^ d) := by ring
              _ = r⁻¹ * ((r⁻¹ * r) ^ d) := by rw [mul_pow]
              _ = r⁻¹ := by rw [inv_mul_cancel₀ hr0, one_pow, mul_one]
          rw [← mul_assoc, hpow]
  rw [hnorm]
  exact mul_le_mul_of_nonneg_left hG (inv_nonneg.mpr hr.le)

/-- A single physical radius no larger than the bad-ball scale has the
standard rapid off-support estimate.  The coefficient is written in the
physical radius rather than in the reciprocal frequency scale, which makes
it suitable for taking a supremum over one short radius cell. -/
theorem norm_lacunaryRelativeBandpassPhysicalTerm_le_small_radius_far_distance
    {d : Nat} (psi : SchwartzMap (Euclidean d) Complex) (j : Nat)
    {r rho : Real} (hr : 0 < r) (hrho : 0 < rho) (hrrho : r ≤ rho)
    {c x : Euclidean d} (hx : 3 * rho ≤ ‖x - c‖)
    (b : Euclidean d → Complex) (hb : Integrable b volume)
    (hbsupp : ∀ y, b y ≠ 0 → ‖y - c‖ ≤ rho) :
    ‖lacunaryRelativeBandpassPhysicalTerm psi j r b x‖ ≤
      (((2 : Real) ^ j)⁻¹ ^ 2 *
          SchwartzMap.seminorm Complex (d + 2) 0 (𝓕⁻ psi) /
            (‖x - c‖ / 3) ^ (d + 2)) * r ^ 2 * surfaceMass d *
        ∫ y : Euclidean d, ‖b y‖ := by
  let s : Real := (((2 : Real) ^ j)⁻¹ * r)⁻¹
  have hs : 0 < s := by
    dsimp [s]
    exact inv_pos.mpr (mul_pos (inv_pos.mpr (pow_pos (by norm_num) _)) hr)
  have hpositive :=
    norm_integral_sphericalAverage_complexScaled_fourierInv_le_positive
      psi hs r b hb x
  have hfar :=
    integral_norm_mul_integral_norm_complexScaled_fourierInv_le_of_small_radius_far_distance
      psi hs hrho hr.le hrrho hx b hb hbsupp
  let D : Real := ‖x - c‖ / 3
  have hDpos : 0 < D := by
    dsimp [D]
    have hxc : 0 < ‖x - c‖ := by
      exact lt_of_lt_of_le (mul_pos (by norm_num) hrho) hx
    positivity
  have hcoef (A : Real) :
      s ^ d * A / (s * D) ^ (d + 2) =
        (((2 : Real) ^ j)⁻¹ ^ 2 * r ^ 2 * A) / D ^ (d + 2) := by
    have hs0 : s ≠ 0 := hs.ne'
    have hD0 : D ≠ 0 := hDpos.ne'
    have hr0 : r ≠ 0 := hr.ne'
    have hrinv : r ^ 2 * r⁻¹ ^ 2 = 1 := by
      rw [← mul_pow, mul_inv_cancel₀ hr0, one_pow]
    dsimp [s]
    field_simp [mul_pow, pow_add, hs0, hD0]
    ring_nf
    rw [hrinv]
    ring
  have hkernel : lacunaryRelativeBandpassPhysicalTerm psi j r b x =
      ∫ y : Euclidean d, b y * sphericalAverage d
        (fun z : Euclidean d => ((s ^ d : Real) : Complex) •
          (𝓕⁻ psi : SchwartzMap (Euclidean d) Complex) (s • z)) r (x - y) := by
    rfl
  rw [hkernel]
  calc
    ‖∫ y : Euclidean d, b y * sphericalAverage d
        (fun z : Euclidean d => ((s ^ d : Real) : Complex) •
          (𝓕⁻ psi : SchwartzMap (Euclidean d) Complex) (s • z)) r (x - y)‖ ≤
        ∫ y : Euclidean d, ‖b y‖ *
          ∫ omega : Metric.sphere (0 : Euclidean d) 1,
            ‖((s ^ d : Real) : Complex) •
              (𝓕⁻ psi : SchwartzMap (Euclidean d) Complex)
                (s • ((x - y) + r • (omega : Euclidean d)))‖ ∂unitSurfaceMeasure d :=
      hpositive
    _ ≤ (s ^ d * SchwartzMap.seminorm Complex (d + 2) 0 (𝓕⁻ psi) /
          (s * (‖x - c‖ / 3)) ^ (d + 2)) * surfaceMass d *
          ∫ y : Euclidean d, ‖b y‖ := hfar
    _ = _ := by
      rw [show ‖x - c‖ / 3 = D by rfl, hcoef]
      ring

/-- With a compact frequency cutoff, the radius-one physical kernel is itself
a literal Schwartz function.  This is the convenient form of the short-cell
kernel for the generic Calderón--Zygmund tails: no spherical structure remains
after the radius has been normalized to one. -/
theorem exists_schwartz_lacunaryRelativeBandpassPhysicalKernel_one
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d → ℂ)) (j : Nat) :
    ∃ K : SchwartzMap (Euclidean d) ℂ,
      ∀ x : Euclidean d, K x = lacunaryRelativeBandpassPhysicalKernel psi j 1 x := by
  let s : ℝ := (2 : ℝ) ^ j
  have hs : 0 < s := by
    dsimp [s]
    positivity
  let A : Euclidean d ≃L[ℝ] Euclidean d :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 s⁻¹ (inv_ne_zero hs.ne'))
  let psiJ : SchwartzMap (Euclidean d) ℂ :=
    SchwartzMap.compCLMOfContinuousLinearEquiv ℂ A psi
  have hpsiJ (xi : Euclidean d) : psiJ xi = psi (s⁻¹ • xi) := by
    change psi (A xi) = psi (s⁻¹ • xi)
    simp [A]
  have hpsiJcompact : HasCompactSupport (psiJ : Euclidean d → ℂ) := by
    change HasCompactSupport
      ((psi : Euclidean d → ℂ) ∘ (A.toHomeomorph : Euclidean d → Euclidean d))
    exact hpsiCompact.comp_homeomorph A.toHomeomorph
  obtain ⟨m, hm⟩ :=
    exists_schwartz_compactSupport_mul_surfaceFourier psiJ hpsiJcompact 1
  let K : SchwartzMap (Euclidean d) ℂ := 𝓕⁻ m
  have hinv (z : Euclidean d) :
      (𝓕⁻ psiJ : SchwartzMap (Euclidean d) ℂ) z =
        (s ^ d : ℝ) • (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z) := by
    rw [SchwartzMap.fourierInv_coe]
    rw [show (psiJ : Euclidean d → ℂ) = fun xi => psi (s⁻¹ • xi) by
      funext xi
      exact hpsiJ xi]
    simpa only [finrank_euclideanSpace_fin, SchwartzMap.fourierInv_coe] using
      (fourierInv_comp_inv_smul (psi : Euclidean d → ℂ) hs z)
  have hphysical : lacunaryRelativeBandpassPhysicalKernel psi j 1 =
      sphericalAverage d ((𝓕⁻ psiJ : SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) 1 := by
    funext x
    unfold lacunaryRelativeBandpassPhysicalKernel
    have hscale : (((2 : ℝ) ^ j)⁻¹ * (1 : ℝ))⁻¹ = s := by
      dsimp [s]
      field_simp
    rw [hscale]
    apply congrArg (fun q : Euclidean d → ℂ => sphericalAverage d q 1 x)
    funext z
    rw [hinv]
    simp only [Complex.real_smul, smul_eq_mul]
  have hsurface : sphericalAverage d
      ((𝓕⁻ psiJ : SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) 1 = K := by
    funext x
    rw [sphericalAverage_fourierInv_schwartz_eq_surfaceMultiplier psiJ 1]
    change 𝓕⁻ (fun xi : Euclidean d => surfaceFourier d (-1 • xi) * psiJ xi) x =
      (𝓕⁻ m : SchwartzMap (Euclidean d) ℂ) x
    rw [SchwartzMap.fourierInv_coe]
    apply congrArg (fun q : Euclidean d → ℂ => 𝓕⁻ q x)
    funext xi
    rw [hm xi]
    ring
  refine ⟨K, ?_⟩
  intro x
  exact (congrFun hsurface x).symm.trans (congrFun hphysical x).symm

/-- The fixed generator occurring after radius differentiation is Schwartz
whenever the dyadic frequency cutoff is compactly supported. -/
theorem exists_schwartz_lacunaryRelativeBandpassPhysicalKernelRadiusGenerator
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d → ℂ)) (j : Nat) :
    ∃ G : SchwartzMap (Euclidean d) ℂ,
      ∀ x : Euclidean d,
        G x = lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j x := by
  obtain ⟨K, hK⟩ :=
    exists_schwartz_lacunaryRelativeBandpassPhysicalKernel_one psi hpsiCompact j
  have hid : Function.HasTemperateGrowth (fun x : Euclidean d => x) := by
    fun_prop
  let DK : SchwartzMap (Euclidean d) (Euclidean d →L[ℝ] ℂ) :=
    SchwartzMap.fderivCLM ℝ (Euclidean d) ℂ K
  let R : SchwartzMap (Euclidean d) ℂ :=
    SchwartzMap.bilinLeftCLM (ContinuousLinearMap.apply ℝ ℂ).flip hid DK
  let G : SchwartzMap (Euclidean d) ℂ := -((d : ℝ) • K + R)
  have hKfun : (K : Euclidean d → ℂ) =
      lacunaryRelativeBandpassPhysicalKernel psi j 1 := by
    funext x
    exact hK x
  refine ⟨G, ?_⟩
  intro x
  unfold lacunaryRelativeBandpassPhysicalKernelRadiusGenerator
  rw [show lacunaryRelativeBandpassPhysicalKernel psi j 1 =
      (K : Euclidean d → ℂ) by exact hKfun.symm]
  change -((d : ℝ) • K x +
      ((ContinuousLinearMap.apply ℝ ℂ).flip (DK x)) x) = _
  rw [ContinuousLinearMap.flip_apply, ContinuousLinearMap.apply_apply,
    SchwartzMap.fderivCLM_apply]

set_option maxHeartbeats 800000 in
-- The literal second-derivative/Fubini scaling calculation is intentionally expanded below.
/-- The extra spatial derivative of the fixed relative-radius generator costs
at most two dyadic frequency factors.  This is deliberately stated for an
arbitrary Schwartz representative of the generator, so it can be inserted
directly in the shifted cell Calderón--Zygmund tail. -/
theorem integral_norm_fderiv_lacunaryRelativeBandpassPhysicalKernelRadiusGenerator_le
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d → ℂ)) (j : Nat)
    (G : SchwartzMap (Euclidean d) ℂ)
    (hG : ∀ x : Euclidean d,
      G x = lacunaryRelativeBandpassPhysicalKernelRadiusGenerator psi j x) :
    (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) ≤
      ((2 : ℝ) ^ j) ^ 2 *
        lacunaryRelativeBandpassPhysicalKernelRadiusGeneratorFDerivConstant psi := by
  letI : SeminormedAddGroup (Euclidean d →L[ℝ] Euclidean d →L[ℝ] ℂ) :=
    { __ := (inferInstance : SeminormedAddCommGroup
      (Euclidean d →L[ℝ] Euclidean d →L[ℝ] ℂ)) }
  letI : NormedAddCommGroup (Euclidean d →L[ℝ] Euclidean d →L[ℝ] ℂ) :=
    NormedAddCommGroup.ofSeparation (fun f hf => by
      apply ContinuousLinearMap.ext
      intro x
      apply norm_eq_zero.mp
      have hx := f.le_opNorm x
      rw [hf, zero_mul] at hx
      exact le_antisymm hx (norm_nonneg _))
  let nestedNormSmul : NormSMulClass ℝ
      (Euclidean d →L[ℝ] Euclidean d →L[ℝ] ℂ) := by
    refine ⟨?_⟩
    intro r x
    by_cases hr : r = 0
    · subst r
      have hzero : (0 : ℝ) • x = 0 := by
        apply ContinuousLinearMap.ext
        intro y
        apply ContinuousLinearMap.ext
        intro z
        simp
      rw [hzero]
      simp
    apply le_antisymm
    · exact ContinuousLinearMap.opNorm_smul_le r x
    · have hinv := ContinuousLinearMap.opNorm_smul_le r⁻¹ (r • x)
      rw [inv_smul_smul₀ hr, norm_inv] at hinv
      exact (le_inv_mul_iff₀ (norm_pos_iff.mpr hr)).mp hinv
  letI : NormSMulClass ℝ (Euclidean d →L[ℝ] Euclidean d →L[ℝ] ℂ) := nestedNormSmul
  let s : ℝ := (2 : ℝ) ^ j
  have hs : 0 < s := by
    dsimp [s]
    positivity
