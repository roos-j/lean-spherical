/-- The first spatial moment of the derivative of a normalized Euclidean
dilation is scale invariant. -/
private theorem integral_norm_mul_fderiv_dilate_eq
    {d : Nat} (k : Euclidean d → ℂ) (hk : ContDiff ℝ 1 k)
    {R : ℝ} (hR : 0 < R) :
    (∫ x : Euclidean d,
      ‖x‖ * ‖fderiv ℝ (fun y : Euclidean d => (R ^ d) • k (R • y)) x‖) =
      ∫ x : Euclidean d, ‖x‖ * ‖fderiv ℝ k x‖ := by
  have hpoint (x : Euclidean d) :
      ‖x‖ * ‖fderiv ℝ (fun y : Euclidean d => (R ^ d) • k (R • y)) x‖ =
        (R ^ d) * (‖R • x‖ * ‖fderiv ℝ k (R • x)‖) := by
    rw [fderiv_dilate k hk R x, norm_smul, Real.norm_eq_abs, abs_of_pos]
    · rw [norm_smul, Real.norm_eq_abs, abs_of_pos]
      ring
      exact hR
    · positivity
  calc
    (∫ x : Euclidean d,
      ‖x‖ * ‖fderiv ℝ (fun y : Euclidean d => (R ^ d) • k (R • y)) x‖) =
        ∫ x : Euclidean d, (R ^ d) * (‖R • x‖ * ‖fderiv ℝ k (R • x)‖) := by
          apply integral_congr_ae
          filter_upwards with x
          exact hpoint x
    _ = (R ^ d) * ∫ x : Euclidean d, ‖R • x‖ * ‖fderiv ℝ k (R • x)‖ := by
      rw [integral_const_mul]
    _ = (R ^ d) * ((R ^ d)⁻¹ *
        ∫ x : Euclidean d, ‖x‖ * ‖fderiv ℝ k x‖) := by
      rw [Measure.integral_comp_smul_of_nonneg volume
        (fun x : Euclidean d => ‖x‖ * ‖fderiv ℝ k x‖) R (hR := hR.le)]
      simp only [finrank_euclideanSpace_fin, smul_eq_mul]
    _ = _ := by
      have hpow : R ^ d ≠ 0 := pow_ne_zero _ hR.ne'
      field_simp

