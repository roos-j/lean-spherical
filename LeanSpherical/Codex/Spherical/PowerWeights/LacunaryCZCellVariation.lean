    {ι : Type*} (I : Finset ι) (a b : ι → ℝ)
    (g : Euclidean d → ℂ) : Euclidean d → ENNReal :=
  fun x => ∑ q ∈ I,
    ⨆ t : Icc (a q) (b q), ENNReal.ofReal
      ‖lacunaryRelativeBandpassPhysicalTerm psi j t.1 g x -
        lacunaryRelativeBandpassPhysicalTerm psi j (a q) g x‖

