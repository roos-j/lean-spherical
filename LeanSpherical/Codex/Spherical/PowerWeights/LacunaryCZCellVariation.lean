    rw [hGfd]
    calc
      ‖-((d : ℝ) • fderiv ℝ H x + fderiv ℝ R x)‖ =
          ‖(d : ℝ) • fderiv ℝ H x + fderiv ℝ R x‖ := norm_neg _
      _ ≤ ‖(d : ℝ) • fderiv ℝ H x‖ + ‖fderiv ℝ R x‖ := norm_add_le _ _
      _ = (d : ℝ) * ‖fderiv ℝ H x‖ + ‖fderiv ℝ R x‖ := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (Nat.cast_nonneg d)]
