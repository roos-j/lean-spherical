    (∑ s ∈ S, ENNReal.ofReal
      (2 * ((unitScaleEntropyCell δ s).2 - (unitScaleEntropyCell δ s).1) ^ 2 * C ^ 2 * J)) ≤
      (N : ENNReal) * ENNReal.ofReal
        (2 * (8 * Real.log 2 * (δ : ℝ)) ^ 2 * C ^ 2 * J) := by
  let L : ℝ := 8 * Real.log 2 * (δ : ℝ)
  have hL : 0 ≤ L := by
    dsimp only [L]
    positivity
  have hterm (s : PositiveRadius) (hsS : s ∈ S) :
      ENNReal.ofReal
        (2 * ((unitScaleEntropyCell δ s).2 - (unitScaleEntropyCell δ s).1) ^ 2 * C ^ 2 * J) ≤
        ENNReal.ofReal (2 * L ^ 2 * C ^ 2 * J) := by
    apply ENNReal.ofReal_le_ofReal
    have hsunit := hS s hsS
    have hcenter := mem_unitScaleEntropyCell_center δ s hsunit
    have hwidth : 0 ≤ (unitScaleEntropyCell δ s).2 - (unitScaleEntropyCell δ s).1 :=
      sub_nonneg.mpr (hcenter.1.trans hcenter.2)
    have hlength : (unitScaleEntropyCell δ s).2 - (unitScaleEntropyCell δ s).1 ≤ L := by
      simpa only [L] using unitScaleEntropyCell_length_le_linear δ s hsunit hδ
    have hsq : ((unitScaleEntropyCell δ s).2 - (unitScaleEntropyCell δ s).1) ^ 2 ≤ L ^ 2 := by
      nlinarith [mul_nonneg (show 0 ≤ L -
        ((unitScaleEntropyCell δ s).2 - (unitScaleEntropyCell δ s).1) by linarith)
        (show 0 ≤ L +
          ((unitScaleEntropyCell δ s).2 - (unitScaleEntropyCell δ s).1) by linarith)]
    exact mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hsq (by norm_num)) (sq_nonneg C)) hJ
  calc
    (∑ s ∈ S, ENNReal.ofReal
