  have hBJnonneg : 0 ≤ B * J := mul_nonneg hB.le hJnonneg
  have hleft :
      (∫⁻ x, ENNReal.ofReal ((T x) ^ p) ∂μ) < ∞ := by
    have hlin' :
        (∫⁻ x, ENNReal.ofReal ((T x) ^ p) ∂μ) ≤ ENNReal.ofReal (B * J) := by
      simpa only [T, J, μ] using hlin
    exact hlin'.trans_lt ENNReal.ofReal_lt_top
  have hTmem : MemLp T (ENNReal.ofReal p) μ :=
    memLp_of_lintegral_ofReal_rpow_lt_top T hTmeas.aemeasurable hTnonneg hp hleft
  have hMmem :
      MemLp (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ))
        (ENNReal.ofReal p) μ := by
    refine ⟨(measurable_restrictedNormalizedSphericalMaximal_schwartz E f).aestronglyMeasurable,
      ?_⟩
    rw [← eLpNorm_restrictedNormalizedSphericalMaximalReal_schwartz_eq hd0 E f]
    exact hTmem.eLpNorm_lt_top
  have hfint : Integrable (fun x : Euclidean d => ‖f x‖ ^ p) μ := by
    simpa only [ENNReal.toReal_ofReal hp.le] using
      hf.integrable_norm_rpow (ENNReal.ofReal_ne_zero_iff.mpr hp)
        ENNReal.ofReal_ne_top
  have hinput :
      (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ) = ENNReal.ofReal J := by
    calc
      (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ) =
          ∫⁻ x, ENNReal.ofReal (‖f x‖ ^ p) ∂μ := by
            apply lintegral_congr
            intro x
            exact ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp.le
      _ = ENNReal.ofReal J := by
        dsimp only [J]
        exact (ofReal_integral_eq_lintegral_ofReal hfint
          (Filter.Eventually.of_forall fun x => Real.rpow_nonneg (norm_nonneg _) p)).symm
  have hfnorm :
      eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p) μ =
        (ENNReal.ofReal J) ^ p⁻¹ := by
    calc
      eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p) μ =
          (∫⁻ x, ‖f x‖ₑ ^ p ∂μ) ^ p⁻¹ := by
            rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
              (ENNReal.ofReal_ne_zero_iff.mpr hp) ENNReal.ofReal_ne_top]
            simp only [ENNReal.toReal_ofReal hp.le, one_div]
      _ = (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ) ^ p⁻¹ := by
            congr 1
            apply lintegral_congr
            intro x
            rw [← ofReal_norm]
      _ = (ENNReal.ofReal J) ^ p⁻¹ := by rw [hinput]
  have hroot_eq :
      (ENNReal.ofReal (B * J)) ^ p⁻¹ =
        ENNReal.ofReal D * eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p) μ := by
    rw [ENNReal.ofReal_mul hB.le,
      ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hp.le),
      ENNReal.ofReal_rpow_of_nonneg hB.le (inv_nonneg.mpr hp.le), hfnorm]
  have hTnorm :
      eLpNorm T (ENNReal.ofReal p) μ ≤
        ENNReal.ofReal D * eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p) μ := by
    calc
      eLpNorm T (ENNReal.ofReal p) μ ≤
          (ENNReal.ofReal (B * J)) ^ p⁻¹ :=
        eLpNorm_real_nonneg_le_of_lintegral_ofReal_rpow_le μ T hp hTnonneg
          (by simpa only [T, J, μ] using hlin)
      _ = _ := hroot_eq
  refine ⟨by simpa only [μ] using hMmem, ?_⟩
  rw [← eLpNorm_restrictedNormalizedSphericalMaximalReal_schwartz_eq hd0 E f]
  exact hTnorm

end

