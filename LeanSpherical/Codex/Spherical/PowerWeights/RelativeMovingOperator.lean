    change psi (A xi) = psi (a • (r • xi))
    change psi (R⁻¹ • xi) = psi (a • (r • xi))
    dsimp only [R]
    rw [inv_inv]
    simp only [smul_smul]
  have hhf (xi : Euclidean d) : hf xi =
      psi (a • (r • xi)) * 𝓕 (f : Euclidean d → ℂ) xi := by
    simp only [hf, SchwartzMap.smulLeftCLM_apply psiR.hasTemperateGrowth,
      SchwartzMap.fourier_coe, smul_eq_mul]
    rw [hpsiR]
  have hhg (xi : Euclidean d) : hg xi =
      psi (a • (r • xi)) * 𝓕 (g : Euclidean d → ℂ) xi := by
    simp only [hg, SchwartzMap.smulLeftCLM_apply psiR.hasTemperateGrowth,
      SchwartzMap.fourier_coe, smul_eq_mul]
    rw [hpsiR]
  have hhfg (xi : Euclidean d) : hfg xi =
      psi (a • (r • xi)) *
        𝓕 ((f + g : SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) xi := by
    simp only [hfg, SchwartzMap.smulLeftCLM_apply psiR.hasTemperateGrowth,
      SchwartzMap.fourier_coe, smul_eq_mul]
    rw [hpsiR]
