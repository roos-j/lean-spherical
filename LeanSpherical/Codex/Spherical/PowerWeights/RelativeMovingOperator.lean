/-- The restricted literal moving band is subadditive before passing to real
values.  The radius set stays restricted throughout the proof. -/
theorem restrictedRelativeBandpassSphericalMaximal_add_le
    {d : Nat} (E : Set ℝ) (phi f g : SchwartzMap (Euclidean d) ℂ)
    (j : Nat) (x : Euclidean d) :
    restrictedRelativeBandpassSphericalMaximal d E phi j (f + g) x ≤
      restrictedRelativeBandpassSphericalMaximal d E phi j f x +
        restrictedRelativeBandpassSphericalMaximal d E phi j g x := by
  unfold restrictedRelativeBandpassSphericalMaximal
  apply iSup_le
  intro r
  rw [fourierInv_literal_relative_dyadic_bandpass_add phi f g j r.2.2 x]
  calc
    ENNReal.ofReal ‖𝓕⁻ (fun xi : Euclidean d =>
      surfaceFourier d (-r.1 • xi) *
        (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
          phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
        𝓕 (f : Euclidean d → ℂ) xi) x +
      𝓕⁻ (fun xi : Euclidean d =>
        surfaceFourier d (-r.1 • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
          𝓕 (g : Euclidean d → ℂ) xi) x‖ ≤
        ENNReal.ofReal
          (‖𝓕⁻ (fun xi : Euclidean d =>
            surfaceFourier d (-r.1 • xi) *
              (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
                phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
              𝓕 (f : Euclidean d → ℂ) xi) x‖ +
            ‖𝓕⁻ (fun xi : Euclidean d =>
              surfaceFourier d (-r.1 • xi) *
                (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
                  phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
                𝓕 (g : Euclidean d → ℂ) xi) x‖) :=
      ENNReal.ofReal_le_ofReal (norm_add_le _ _)
    _ = ENNReal.ofReal ‖𝓕⁻ (fun xi : Euclidean d =>
      surfaceFourier d (-r.1 • xi) *
        (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
          phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
        𝓕 (f : Euclidean d → ℂ) xi) x‖ +
        ENNReal.ofReal ‖𝓕⁻ (fun xi : Euclidean d =>
          surfaceFourier d (-r.1 • xi) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
            𝓕 (g : Euclidean d → ℂ) xi) x‖ := by
      rw [ENNReal.ofReal_add (norm_nonneg _) (norm_nonneg _)]
    _ ≤ restrictedRelativeBandpassSphericalMaximal d E phi j f x +
        restrictedRelativeBandpassSphericalMaximal d E phi j g x := by
      apply add_le_add
      · exact le_iSup (fun s : ↥(E ∩ Ioi (0 : ℝ)) => ENNReal.ofReal
          ‖𝓕⁻ (fun xi : Euclidean d =>
            surfaceFourier d (-s.1 • xi) *
              (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s.1 • xi)) -
                phi (((2 : ℝ) ^ j)⁻¹ • (s.1 • xi))) *
              𝓕 (f : Euclidean d → ℂ) xi) x‖) r
      · exact le_iSup (fun s : ↥(E ∩ Ioi (0 : ℝ)) => ENNReal.ofReal
          ‖𝓕⁻ (fun xi : Euclidean d =>
            surfaceFourier d (-s.1 • xi) *
              (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s.1 • xi)) -
                phi (((2 : ℝ) ^ j)⁻¹ • (s.1 • xi))) *
              𝓕 (g : Euclidean d → ℂ) xi) x‖) r

/-- The real-valued restricted moving band is subadditive on `[1,2]`; the
physical endpoint supplies the finiteness needed for `ENNReal.toReal`. -/
theorem toReal_restrictedRelativeBandpassSphericalMaximal_add_le
    {d : Nat} (hd : 0 < d) (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2)
    (phi f g : SchwartzMap (Euclidean d) ℂ) (j : Nat) (x : Euclidean d) :
    (restrictedRelativeBandpassSphericalMaximal d E phi j (f + g) x).toReal ≤
      (restrictedRelativeBandpassSphericalMaximal d E phi j f x).toReal +
        (restrictedRelativeBandpassSphericalMaximal d E phi j g x).toReal := by
  obtain ⟨D, hD, hphysical⟩ :=
    exists_restrictedRelativeBandpass_pointwise_le_integral hd phi
  have hfin (h : SchwartzMap (Euclidean d) ℂ) :
      restrictedRelativeBandpassSphericalMaximal d E phi j h x ≠ ⊤ :=
    ne_top_of_le_ne_top ENNReal.ofReal_ne_top (hphysical j E hE h x)
  have hraw := restrictedRelativeBandpassSphericalMaximal_add_le E phi f g j x
  calc
    (restrictedRelativeBandpassSphericalMaximal d E phi j (f + g) x).toReal ≤
        (restrictedRelativeBandpassSphericalMaximal d E phi j f x +
          restrictedRelativeBandpassSphericalMaximal d E phi j g x).toReal :=
      (ENNReal.toReal_le_toReal (hfin (f + g))
        (ENNReal.add_ne_top.mpr ⟨hfin f, hfin g⟩)).2 hraw
    _ = (restrictedRelativeBandpassSphericalMaximal d E phi j f x).toReal +
        (restrictedRelativeBandpassSphericalMaximal d E phi j g x).toReal :=
      ENNReal.toReal_add (hfin f) (hfin g)

/-- The entropy square endpoint in the finite annular restriction of the
power-weighted measure, written for the real-valued literal moving band. -/
theorem restrictedRelativeBandpass_annular_lintegral_two_le_of_sharp_restrict
    {d : Nat} (hd : 2 ≤ d) (C0 C1 : ℝ) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ xi : Euclidean (d + 1), 1 ≤ ‖xi‖ →
      ‖surfaceFourier (d + 1) xi‖ ≤ C0 / ‖xi‖ ^ ((d : ℝ) / 2))
    (hderiv : ∀ xi : Euclidean (d + 1), ∀ s : ℝ, 1 ≤ ‖xi‖ →
      s ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun u : ℝ => surfaceFourier (d + 1) (u • xi)) s‖ ≤
        C1 / ‖xi‖ ^ ((d : ℝ) / 2 - 1))
    (phi : SchwartzMap (Euclidean (d + 1)) ℂ)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    (δ : ℝ≥0) (N : ℕ) (hN : multiplicativeEntropy E δ ≤ N)
    (hδ : Real.log 2 * (δ : ℝ) ≤ 1)
    {α r R : ℝ} (hα : α ≤ 0) (hr : 0 < r) (hrR : r ≤ R)
    (g : SchwartzMap (Euclidean (d + 1)) ℂ)
    (hgsupport : ∀ x, x ∉ euclideanAnnulus (d + 1) r R → g x = 0) :
    let A : Set (Euclidean (d + 1)) := euclideanAnnulus (d + 1) r R
    let ν : Measure (Euclidean (d + 1)) := powerWeightedVolume (d + 1) α
    let μ : Measure (Euclidean (d + 1)) := ν.restrict A
    let T : Euclidean (d + 1) → ℝ := A.indicator (fun x =>
      (restrictedRelativeBandpassSphericalMaximal (d + 1) E phi j g x).toReal)
    let B : ℝ := (4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)
    let C : ℝ := 2 *
      ((4 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1) +
        (12 * C0 *
          ‖((SchwartzMap.fderivCLM ℂ (Euclidean (d + 1)) ℂ) phi).toBoundedContinuousFunction‖) /
          (dyadicScale j) ^ ((d : ℝ) / 2))
    let L : ℝ := 8 * Real.log 2 * (δ : ℝ)
    let wᵢ : ENNReal := (ENNReal.ofReal r) ^ α
    let wₒ : ENNReal := (ENNReal.ofReal R) ^ α
    (∫⁻ x, ENNReal.ofReal ((T x) ^ (2 : ℕ)) ∂μ) ≤
      wᵢ * (N : ENNReal) * ENNReal.ofReal
        (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) * wₒ⁻¹ *
        ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) ∂μ := by
  dsimp only
  let A : Set (Euclidean (d + 1)) := euclideanAnnulus (d + 1) r R
  let ν : Measure (Euclidean (d + 1)) := powerWeightedVolume (d + 1) α
  let μ : Measure (Euclidean (d + 1)) := ν.restrict A
  let T : Euclidean (d + 1) → ℝ := A.indicator (fun x =>
    (restrictedRelativeBandpassSphericalMaximal (d + 1) E phi j g x).toReal)
  let B : ℝ := (4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)
  let C : ℝ := 2 *
    ((4 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1) +
      (12 * C0 *
        ‖((SchwartzMap.fderivCLM ℂ (Euclidean (d + 1)) ℂ) phi).toBoundedContinuousFunction‖) /
        (dyadicScale j) ^ ((d : ℝ) / 2))
  let L : ℝ := 8 * Real.log 2 * (δ : ℝ)
  let wᵢ : ENNReal := (ENNReal.ofReal r) ^ α
  let wₒ : ENNReal := (ENNReal.ofReal R) ^ α
  let M : Euclidean (d + 1) → ENNReal :=
    restrictedRelativeBandpassSphericalMaximal (d + 1) E phi j g
  let M₂ : Euclidean (d + 1) → ENNReal := fun x =>
    ⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
      (‖𝓕⁻ (fun xi : Euclidean (d + 1) =>
        surfaceFourier (d + 1) (-s.1 • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s.1 • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (s.1 • xi))) *
          𝓕 (g : Euclidean (d + 1) → ℂ) xi) x‖ ^ 2)
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  have hEne' : E.Nonempty := hEne
  obtain ⟨r₀, hr₀⟩ := hEne
  have hr₀pos : 0 < r₀ := lt_of_lt_of_le zero_lt_one (hE hr₀).1
  letI : Nonempty ↥(E ∩ Ioi (0 : ℝ)) := ⟨⟨r₀, hr₀, hr₀pos⟩⟩
  obtain ⟨D, hD, hphysical⟩ :=
    exists_restrictedRelativeBandpass_pointwise_le_integral (Nat.succ_pos d) phi
  have hMfin (x : Euclidean (d + 1)) : M x ≠ ⊤ :=
    ne_top_of_le_ne_top ENNReal.ofReal_ne_top (hphysical j E hE g x)
  have hM₂_eq (x : Euclidean (d + 1)) : M₂ x = (M x) ^ 2 := by
    dsimp only [M₂, M, restrictedRelativeBandpassSphericalMaximal]
    exact iSup_ennreal_norm_sq_eq_sq_iSup_ennreal_norm
      (fun s : ↥(E ∩ Ioi (0 : ℝ)) =>
        𝓕⁻ (fun xi : Euclidean (d + 1) =>
          surfaceFourier (d + 1) (-s.1 • xi) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s.1 • xi)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (s.1 • xi))) *
            𝓕 (g : Euclidean (d + 1) → ℂ) xi) x)
  have hT_sq (x : Euclidean (d + 1)) :
      ENNReal.ofReal ((T x) ^ (2 : ℕ)) = A.indicator M₂ x := by
    by_cases hx : x ∈ A
    · simp only [T, Set.indicator_of_mem hx]
      rw [ENNReal.ofReal_pow ENNReal.toReal_nonneg,
        ENNReal.ofReal_toReal (hMfin x), ← hM₂_eq]
    · simp [T, hx]
  have hglobal :=
    literal_relative_dyadic_moving_bandpass_annular_lintegral_two_le_of_sharp
      hd C0 C1 hC0 hC1 hdecay hderiv phi hphi_one hphi_zero hphi_norm j
      E hE hEne' δ N hN hδ hα hr hrR g hgsupport
  have hglobal' :
      (∫⁻ x in A, M₂ x ∂ν) ≤
        wᵢ * (N : ENNReal) * ENNReal.ofReal
          (2 * B ^ 2 + 2 * L ^ 2 * C ^ 2) * wₒ⁻¹ *
          ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ 2) ∂ν := by
    simpa only [A, ν, B, C, L, wᵢ, wₒ, M₂] using hglobal
  have hGsupport : ∀ x, x ∉ A → ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) = 0 := by
    intro x hx
    simp [hgsupport x hx]
  have hin_eq := lintegral_eq_lintegral_restrict_of_support A hA
    (fun x : Euclidean (d + 1) => ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)))
    hGsupport (ν := ν)
  have hTout : ∀ x, x ∉ A → ENNReal.ofReal ((T x) ^ (2 : ℕ)) = 0 := by
    intro x hx
    simp [T, hx]
  have hout_eq := lintegral_eq_lintegral_restrict_of_support A hA
    (fun x : Euclidean (d + 1) => ENNReal.ofReal ((T x) ^ (2 : ℕ)))
    hTout (ν := ν)
  calc
    (∫⁻ x, ENNReal.ofReal ((T x) ^ (2 : ℕ)) ∂μ) =
        ∫⁻ x, ENNReal.ofReal ((T x) ^ (2 : ℕ)) ∂ν := hout_eq.symm
    _ = ∫⁻ x in A, M₂ x ∂ν := by
      rw [show (fun x : Euclidean (d + 1) =>
        ENNReal.ofReal ((T x) ^ (2 : ℕ))) = A.indicator M₂ by
          funext x
          exact hT_sq x,
        lintegral_indicator hA]
    _ ≤ wᵢ * (N : ENNReal) * ENNReal.ofReal
        (2 * B ^ 2 + 2 * L ^ 2 * C ^ 2) * wₒ⁻¹ *
        ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ 2) ∂ν := hglobal'
    _ = wᵢ * (N : ENNReal) * ENNReal.ofReal
        (2 * B ^ 2 + 2 * L ^ 2 * C ^ 2) * wₒ⁻¹ *
        ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) ∂μ := by
      rw [hin_eq]

/-- The same literal physical endpoint in the finite annular measure used
by the interpolation theorem. -/
theorem exists_restrictedRelativeBandpass_annular_lintegral_one_le_restrict
    {d : Nat} (hd : 0 < d) {α r R : ℝ} (hα : α ≤ 0) (hr : 0 < r)
    (hrR : r ≤ R) (phi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2)
    (g : SchwartzMap (Euclidean d) ℂ)
    (hgsupport : ∀ x, x ∉ euclideanAnnulus d r R → g x = 0) :
    ∃ D : ℝ, 0 < D ∧
      let A : Set (Euclidean d) := euclideanAnnulus d r R
      let ν : Measure (Euclidean d) := powerWeightedVolume d α
      let μ : Measure (Euclidean d) := ν.restrict A
      let T : Euclidean d → ℝ := A.indicator (fun x =>
        (restrictedRelativeBandpassSphericalMaximal d E phi j g x).toReal)
      let c : ENNReal := ENNReal.ofReal (D * (2 : ℝ) ^ j)
      let w : ENNReal := (ENNReal.ofReal R) ^ α
      (∫⁻ x, ENNReal.ofReal (T x) ∂μ) ≤
        c * ν A * w⁻¹ * ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂μ := by
  obtain ⟨D, hD, hglobal⟩ :=
    exists_restrictedRelativeBandpass_annular_lintegral_one_le
      hd hα hr hrR phi j E hE g hgsupport
  refine ⟨D, hD, ?_⟩
  dsimp only
  let A : Set (Euclidean d) := euclideanAnnulus d r R
  let ν : Measure (Euclidean d) := powerWeightedVolume d α
  let μ : Measure (Euclidean d) := ν.restrict A
  let T : Euclidean d → ℝ := A.indicator (fun x =>
    (restrictedRelativeBandpassSphericalMaximal d E phi j g x).toReal)
  let c : ENNReal := ENNReal.ofReal (D * (2 : ℝ) ^ j)
  let w : ENNReal := (ENNReal.ofReal R) ^ α
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  have hglobal' : (∫⁻ x, ENNReal.ofReal (T x) ∂ν) ≤
      c * ν A * w⁻¹ * ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂ν := by
    simpa only [A, ν, T, c, w] using hglobal
  have hTout : ∀ x, x ∉ A → ENNReal.ofReal (T x) = 0 := by
    intro x hx
    simp [T, hx]
  have hGin : ∀ x, x ∉ A → ENNReal.ofReal ‖g x‖ = 0 := by
    intro x hx
    simp [hgsupport x hx]
  have hout_eq := lintegral_eq_lintegral_restrict_of_support A hA
    (fun x : Euclidean d => ENNReal.ofReal (T x)) hTout (ν := ν)
  have hin_eq := lintegral_eq_lintegral_restrict_of_support A hA
    (fun x : Euclidean d => ENNReal.ofReal ‖g x‖) hGin (ν := ν)
  calc
    (∫⁻ x, ENNReal.ofReal (T x) ∂μ) = ∫⁻ x, ENNReal.ofReal (T x) ∂ν :=
      hout_eq.symm
    _ ≤ c * ν A * w⁻¹ * ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂ν := hglobal'
    _ = c * ν A * w⁻¹ * ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂μ := by
      rw [hin_eq]

/-- The restricted-measure version of the literal physical endpoint, with
the pointwise kernel estimate left as an explicit hypothesis.  Keeping the
constant outside the input is what the interpolation argument needs. -/
theorem restrictedRelativeBandpass_annular_lintegral_one_le_of_pointwise_restrict
    {d : Nat} {α r R : ℝ} (hα : α ≤ 0) (hr : 0 < r) (hrR : r ≤ R)
    (D : ℝ) (hD : 0 ≤ D) (phi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (E : Set ℝ)
    (hpointwise : ∀ (g : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d),
      restrictedRelativeBandpassSphericalMaximal d E phi j g x ≤
        ENNReal.ofReal (D * (2 : ℝ) ^ j * ∫ y : Euclidean d, ‖g y‖))
    (g : SchwartzMap (Euclidean d) ℂ)
    (hgsupport : ∀ x, x ∉ euclideanAnnulus d r R → g x = 0) :
    let A : Set (Euclidean d) := euclideanAnnulus d r R
    let ν : Measure (Euclidean d) := powerWeightedVolume d α
    let μ : Measure (Euclidean d) := ν.restrict A
    let T : Euclidean d → ℝ := A.indicator (fun x =>
      (restrictedRelativeBandpassSphericalMaximal d E phi j g x).toReal)
    let c : ENNReal := ENNReal.ofReal (D * (2 : ℝ) ^ j)
    let w : ENNReal := (ENNReal.ofReal R) ^ α
    (∫⁻ x, ENNReal.ofReal (T x) ∂μ) ≤
      c * ν A * w⁻¹ * ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂μ := by
  dsimp only
  let A : Set (Euclidean d) := euclideanAnnulus d r R
  let ν : Measure (Euclidean d) := powerWeightedVolume d α
  let μ : Measure (Euclidean d) := ν.restrict A
  let T : Euclidean d → ℝ := A.indicator (fun x =>
    (restrictedRelativeBandpassSphericalMaximal d E phi j g x).toReal)
  let c : ENNReal := ENNReal.ofReal (D * (2 : ℝ) ^ j)
  let w : ENNReal := (ENNReal.ofReal R) ^ α
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  have hglobal : (∫⁻ x, ENNReal.ofReal (T x) ∂ν) ≤
      c * ν A * w⁻¹ * ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂ν := by
    simpa only [A, ν, T, c, w] using
      (restrictedRelativeBandpass_annular_lintegral_one_le_of_pointwise
        hα hr hrR D hD phi j E hpointwise g hgsupport)
  have hTout : ∀ x, x ∉ A → ENNReal.ofReal (T x) = 0 := by
    intro x hx
    simp [T, hx]
  have hGin : ∀ x, x ∉ A → ENNReal.ofReal ‖g x‖ = 0 := by
    intro x hx
    simp [hgsupport x hx]
  have hout_eq := lintegral_eq_lintegral_restrict_of_support A hA
    (fun x : Euclidean d => ENNReal.ofReal (T x)) hTout (ν := ν)
  have hin_eq := lintegral_eq_lintegral_restrict_of_support A hA
    (fun x : Euclidean d => ENNReal.ofReal ‖g x‖) hGin (ν := ν)
  calc
    (∫⁻ x, ENNReal.ofReal (T x) ∂μ) = ∫⁻ x, ENNReal.ofReal (T x) ∂ν :=
      hout_eq.symm
    _ ≤ c * ν A * w⁻¹ * ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂ν := hglobal
    _ = c * ν A * w⁻¹ * ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂μ := by
      rw [hin_eq]

end

end Codex.Spherical.PowerWeights.RelativeMovingOperator