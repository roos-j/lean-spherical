  let a : ℝ := ((2 : ℝ) ^ j)⁻¹
  have ha : 0 < a := by
    dsimp only [a]
    exact inv_pos.mpr (pow_pos (by norm_num) _)
  let R : ℝ := (a * r)⁻¹
  have hR : 0 < R := inv_pos.mpr (mul_pos ha hr)
  let A : Euclidean d ≃L[ℝ] Euclidean d :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 R⁻¹ (inv_ne_zero hR.ne'))
  let psiR : SchwartzMap (Euclidean d) ℂ :=
    SchwartzMap.compCLMOfContinuousLinearEquiv ℂ A psi
  let hf : SchwartzMap (Euclidean d) ℂ :=
    SchwartzMap.smulLeftCLM ℂ (psiR : Euclidean d → ℂ) (𝓕 f)
  let hg : SchwartzMap (Euclidean d) ℂ :=
    SchwartzMap.smulLeftCLM ℂ (psiR : Euclidean d → ℂ) (𝓕 g)
  let hfg : SchwartzMap (Euclidean d) ℂ :=
    SchwartzMap.smulLeftCLM ℂ (psiR : Euclidean d → ℂ) (𝓕 (f + g))
