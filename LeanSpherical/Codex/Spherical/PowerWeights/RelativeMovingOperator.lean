/-- At one positive radius, the literal moving relative-band multiplier is
linear in its Schwartz input.  The proof packages the radius-dependent
frequency factor as a Schwartz multiplier before applying Fourier inversion. -/
theorem fourierInv_literal_relative_dyadic_bandpass_add
    {d : Nat} (phi f g : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    {r : ℝ} (hr : 0 < r) (x : Euclidean d) :
    𝓕⁻ (fun xi : Euclidean d =>
      surfaceFourier d (-r • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r • xi)) -
          phi (((2 : ℝ) ^ j)⁻¹ • (r • xi))) *
        𝓕 ((f + g : SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) xi) x =
      𝓕⁻ (fun xi : Euclidean d =>
        surfaceFourier d (-r • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (r • xi))) *
          𝓕 (f : Euclidean d → ℂ) xi) x +
        𝓕⁻ (fun xi : Euclidean d =>
          surfaceFourier d (-r • xi) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r • xi)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r • xi))) *
            𝓕 (g : Euclidean d → ℂ) xi) x := by
