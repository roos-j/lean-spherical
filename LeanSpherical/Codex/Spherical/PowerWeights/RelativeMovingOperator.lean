        sphericalAverage d ((𝓕⁻ hf : SchwartzMap (Euclidean d) ℂ) :
          Euclidean d → ℂ) r x +
          sphericalAverage d ((𝓕⁻ hg : SchwartzMap (Euclidean d) ℂ) :
