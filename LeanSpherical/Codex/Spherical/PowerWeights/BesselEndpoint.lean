          Real.norm_eq_abs, abs_of_nonneg hmass_nonneg]
      _ ≤ (surfaceMass d)⁻¹ *
          ∫ ω : sphere (0 : Euclidean d) 1,
            ‖f (x + r • (ω : Euclidean d))‖ ∂unitSurfaceMeasure d := by
        exact mul_le_mul_of_nonneg_left
          (norm_integral_le_integral_norm _) (inv_nonneg.mpr hmass_nonneg)
      _ ≤ (surfaceMass d)⁻¹ *
          ∫ ω : sphere (0 : Euclidean d) 1,
            B * (besselPowerWeight a (x + r • (ω : Euclidean d)))⁻¹
            ∂unitSurfaceMeasure d := by
        exact mul_le_mul_of_nonneg_left hintegral (inv_nonneg.mpr hmass_nonneg)
  have hkernel' :
      besselPowerWeight a x *
          ((surfaceMass d)⁻¹ *
            (∫ ω : sphere (0 : Euclidean d) 1,
              B * (besselPowerWeight a (x + r • (ω : Euclidean d)))⁻¹
              ∂unitSurfaceMeasure d)) ≤ B * K := by
    rw [integral_const_mul]
    calc
      besselPowerWeight a x *
          ((surfaceMass d)⁻¹ *
            (B * ∫ ω : sphere (0 : Euclidean d) 1,
              (besselPowerWeight a (x + r • (ω : Euclidean d)))⁻¹
              ∂unitSurfaceMeasure d)) =
          B *
            (besselPowerWeight a x *
              ((surfaceMass d)⁻¹ *
                ∫ ω : sphere (0 : Euclidean d) 1,
                  (besselPowerWeight a (x + r • (ω : Euclidean d)))⁻¹
                  ∂unitSurfaceMeasure d)) := by
            ring
      _ ≤ B * K := mul_le_mul_of_nonneg_left hkernel hB
  exact (mul_le_mul_of_nonneg_left havg (besselPowerWeight_nonneg a x)).trans hkernel'

/-- Taking the supremum over a restricted radius set preserves the preceding
Bessel-weighted endpoint once the same reciprocal-kernel estimate is uniform
in the radius.  The conclusion stays in `ℝ≥0∞`, which avoids any separate
finiteness argument for an arbitrary continuous input. -/
theorem restrictedNormalizedSphericalMaximal_le_of_bessel_kernel
    {d : ℕ} (hd : 0 < d) (E : Set ℝ) {a B K : ℝ}
    (hB : 0 ≤ B) (f : Euclidean d → ℂ) (hf : Continuous f)
    (x : Euclidean d)
    (hpoint : ∀ y : Euclidean d,
      ‖f y‖ ≤ B * (besselPowerWeight a y)⁻¹)
    (hkernel : ∀ r : ↥(E ∩ Ioi (0 : ℝ)),
      besselPowerWeight a x *
          ((surfaceMass d)⁻¹ *
            ∫ ω : sphere (0 : Euclidean d) 1,
              (besselPowerWeight a (x + r.1 • (ω : Euclidean d)))⁻¹
              ∂unitSurfaceMeasure d) ≤ K) :
    restrictedNormalizedSphericalMaximal d E f x ≤
      ENNReal.ofReal (B * K / besselPowerWeight a x) := by
  unfold restrictedNormalizedSphericalMaximal
  apply iSup_le
  intro r
  apply ENNReal.ofReal_le_ofReal
  apply (le_div_iff₀ (besselPowerWeight_pos a x)).mpr
  have hr := bessel_weighted_norm_normalizedSphericalAverage_le_of_kernel
    hd hB f hf x r.1 hpoint (hkernel r)
  simpa only [mul_comm] using hr

/-- The preceding extended-real endpoint has the expected real-valued form
on Schwartz inputs.  This is the top-endpoint shape used by the
weak-`(q,q)`--`L∞` interpolation argument. -/
theorem bessel_weighted_restrictedNormalizedSphericalMaximal_toReal_le_of_kernel
    {d : ℕ} (hd : 0 < d) (E : Set ℝ) {a B K : ℝ}
    (hB : 0 ≤ B) (hBK : 0 ≤ B * K)
    (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d)
    (hpoint : ∀ y : Euclidean d,
      ‖f y‖ ≤ B * (besselPowerWeight a y)⁻¹)
    (hkernel : ∀ r : ↥(E ∩ Ioi (0 : ℝ)),
      besselPowerWeight a x *
          ((surfaceMass d)⁻¹ *
            ∫ ω : sphere (0 : Euclidean d) 1,
              (besselPowerWeight a (x + r.1 • (ω : Euclidean d)))⁻¹
              ∂unitSurfaceMeasure d) ≤ K) :
    besselPowerWeight a x *
        (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x).toReal ≤
      B * K := by
  have hmax := restrictedNormalizedSphericalMaximal_le_of_bessel_kernel
    hd E hB (f : Euclidean d → ℂ) f.continuous x hpoint hkernel
  have hquot_nonneg : 0 ≤ B * K / besselPowerWeight a x :=
    div_nonneg hBK (besselPowerWeight_nonneg a x)
  have hreal :
      (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x).toReal ≤
        B * K / besselPowerWeight a x := by
    rw [← ENNReal.toReal_ofReal hquot_nonneg]
    exact (ENNReal.toReal_le_toReal
      (restrictedNormalizedSphericalMaximal_ne_top_schwartz hd E f x)
      ENNReal.ofReal_ne_top).mpr hmax
  calc
    besselPowerWeight a x *
        (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x).toReal ≤
        besselPowerWeight a x * (B * K / besselPowerWeight a x) :=
      mul_le_mul_of_nonneg_left hreal (besselPowerWeight_nonneg a x)
    _ = B * K := by
      field_simp [besselPowerWeight_ne_zero]

/-- The geometric inverse-power estimate supplies the weighted `L∞` endpoint
for every restricted spherical maximal operator in dimensions at least two.
The radius set is arbitrary because the Bessel kernel estimate is uniform in
every positive radius. -/
theorem exists_bessel_weighted_restrictedNormalizedSphericalMaximal_top_endpoint
    {d : ℕ} (hd : 2 ≤ d) {a : ℝ} (ha : 0 ≤ a)
    (ha_lt : a < (d : ℝ) - 1) (E : Set ℝ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (f : SchwartzMap (Euclidean d) ℂ) (B : ℝ), 0 ≤ B →
      (∀ y : Euclidean d, ‖f y‖ ≤ B * (besselPowerWeight a y)⁻¹) →
      ∀ x : Euclidean d,
        besselPowerWeight a x *
          (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x).toReal ≤
          B * K := by
  obtain ⟨K, hK, hkernel⟩ :=
    exists_uniform_bessel_spherical_kernel_bound hd ha ha_lt
  refine ⟨K, hK, ?_⟩
  intro f B hB hpoint x
  apply bessel_weighted_restrictedNormalizedSphericalMaximal_toReal_le_of_kernel
    (show 0 < d by omega) E hB (mul_nonneg hB hK) f x hpoint
  intro r
  exact hkernel x r.2.2

/-- In conjugated form, the geometric endpoint is an ordinary `L∞` bound on
the input Schwartz map.  The harmless `+1` makes the endpoint constant
strictly positive, as required by the Marcinkiewicz interpolation interface. -/
theorem exists_besselConjugatedRestrictedNormalizedSphericalMaximal_top_endpoint
    {d : ℕ} (hd : 2 ≤ d) {a : ℝ} (ha : 0 ≤ a)
    (ha_lt : a < (d : ℝ) - 1) (E : Set ℝ) :
    ∃ K : ℝ, 0 < K ∧ ∀ (f : SchwartzMap (Euclidean d) ℂ) (u : ℝ), 0 ≤ u →
      (∀ x : Euclidean d, ‖f x‖ ≤ u) → ∀ x : Euclidean d,
        besselConjugatedRestrictedNormalizedSphericalMaximal a E f x ≤ K * u := by
  obtain ⟨K, hK, hendpoint⟩ :=
    exists_bessel_weighted_restrictedNormalizedSphericalMaximal_top_endpoint
      hd ha ha_lt E
  refine ⟨K + 1, by linarith, ?_⟩
  intro f u hu hfu x
  have hmult_bound (y : Euclidean d) :
      ‖besselSchwartzMultiplier (-a) f y‖ ≤
        u * (besselPowerWeight a y)⁻¹ := by
    rw [besselSchwartzMultiplier_apply, norm_mul, Complex.norm_real,
      Real.norm_eq_abs, abs_of_nonneg (besselPowerWeight_nonneg (-a) y),
      besselPowerWeight_inv]
    simpa only [mul_comm] using
      mul_le_mul_of_nonneg_left (hfu y) (besselPowerWeight_nonneg (-a) y)
  have htop := hendpoint (besselSchwartzMultiplier (-a) f) u hu hmult_bound x
  unfold besselConjugatedRestrictedNormalizedSphericalMaximal
  calc
    besselPowerWeight a x *
        (restrictedNormalizedSphericalMaximal d E
          (besselSchwartzMultiplier (-a) f : Euclidean d → ℂ) x).toReal ≤
        u * K := htop
    _ ≤ (K + 1) * u := by nlinarith

end

end Codex.Spherical.PowerWeights.BesselEndpoint