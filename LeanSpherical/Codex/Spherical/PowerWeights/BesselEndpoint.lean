      ∫⁻ ω : sphere (0 : Euclidean d) 1,
        ENNReal.ofReal
          (besselPowerWeight a x *
            (besselPowerWeight a (x + r • (ω : Euclidean d)))⁻¹)
          ∂unitSurfaceMeasure d ≤ C := by
  obtain ⟨C, hC_top, hC⟩ :=
    exists_unitSurfaceMeasure_inverse_power_lintegral_le hd ha ha_lt
  let A : ℝ≥0∞ := ENNReal.ofReal ((3 : ℝ) ^ a)
  let D : ℝ≥0∞ := A * ((unitSurfaceMeasure d) univ + C)
  refine ⟨D, ?_, ?_⟩
  · dsimp [D, A]
    exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top
      (ENNReal.add_ne_top.mpr ⟨measure_ne_top _ _, hC_top⟩)
  intro x r hr
  let z : Euclidean d := -(r⁻¹) • x
  have hkernel_meas : Measurable (fun ω : sphere (0 : Euclidean d) 1 =>
      (ENNReal.ofReal ‖(ω : Euclidean d) - z‖) ^ (-a)) := by
    exact ENNReal.continuous_rpow_const.measurable.comp
      (ENNReal.continuous_ofReal.comp
        ((continuous_subtype_val.sub continuous_const).norm)).measurable
  have hpoint (ω : sphere (0 : Euclidean d) 1) :
      ENNReal.ofReal
          (besselPowerWeight a x *
            (besselPowerWeight a (x + r • (ω : Euclidean d)))⁻¹) ≤
        A * (1 + (ENNReal.ofReal ‖(ω : Euclidean d) - z‖) ^ (-a)) := by
    simpa only [A, z] using
      ennreal_bessel_ratio_le_inverse_sphere_kernel ha x hr ω
  calc
    ∫⁻ ω : sphere (0 : Euclidean d) 1,
        ENNReal.ofReal
          (besselPowerWeight a x *
            (besselPowerWeight a (x + r • (ω : Euclidean d)))⁻¹)
          ∂unitSurfaceMeasure d ≤
        ∫⁻ ω : sphere (0 : Euclidean d) 1,
          A * (1 + (ENNReal.ofReal ‖(ω : Euclidean d) - z‖) ^ (-a))
          ∂unitSurfaceMeasure d := lintegral_mono hpoint
    _ = A *
        ∫⁻ ω : sphere (0 : Euclidean d) 1,
          (1 + (ENNReal.ofReal ‖(ω : Euclidean d) - z‖) ^ (-a))
