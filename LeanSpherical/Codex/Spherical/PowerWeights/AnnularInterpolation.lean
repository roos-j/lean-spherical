/-- A nonnegative function supported in an annulus has its unweighted lower
integral controlled by the power-weighted one, after retaining the outer
annular weight on the left. -/
theorem outerPower_mul_lintegral_volume_le_powerWeightedVolume_of_annular_support
    {d : Nat} {α r R : ℝ} (hα : α ≤ 0) (hr : 0 < r)
    (G : Euclidean d → ENNReal) (hG : Measurable G)
    (hGsupport : ∀ x, x ∉ euclideanAnnulus d r R → G x = 0) :
    (ENNReal.ofReal R) ^ α * (∫⁻ x, G x ∂volume) ≤
      ∫⁻ x, G x ∂powerWeightedVolume d α := by
  let A : Set (Euclidean d) := euclideanAnnulus d r R
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  have hindicator : A.indicator G = G := by
    funext x
    by_cases hx : x ∈ A
    · simp [hx]
    · simp [hx, hGsupport x hx]
  calc
    (ENNReal.ofReal R) ^ α * (∫⁻ x, G x ∂volume) =
        (ENNReal.ofReal R) ^ α * (∫⁻ x, A.indicator G x ∂volume) := by
      rw [hindicator]
    _ = (ENNReal.ofReal R) ^ α * (∫⁻ x in A, G x ∂volume) := by
      rw [lintegral_indicator hA]
    _ ≤ ∫⁻ x in A, G x ∂powerWeightedVolume d α :=
      setLIntegral_le_powerWeightedVolume_euclideanAnnulus hα hr G hG
    _ = ∫⁻ x, A.indicator G x ∂powerWeightedVolume d α := by
      rw [lintegral_indicator hA]
    _ = ∫⁻ x, G x ∂powerWeightedVolume d α := by rw [hindicator]

/-- The division form of the preceding annular comparison.  It is used only
inside the interpolation endpoints, where the outer radius is positive. -/
theorem lintegral_volume_le_outerPower_inv_mul_powerWeightedVolume_of_annular_support
    {d : Nat} {α r R : ℝ} (hα : α ≤ 0) (hr : 0 < r) (hrR : r ≤ R)
    (G : Euclidean d → ENNReal) (hG : Measurable G)
    (hGsupport : ∀ x, x ∉ euclideanAnnulus d r R → G x = 0) :
    (∫⁻ x, G x ∂volume) ≤
      ((ENNReal.ofReal R) ^ α)⁻¹ * ∫⁻ x, G x ∂powerWeightedVolume d α := by
  let w : ENNReal := (ENNReal.ofReal R) ^ α
  have hR : 0 < R := lt_of_lt_of_le hr hrR
  have hwpos : 0 < w := by
    dsimp only [w]
    exact ENNReal.rpow_pos (ENNReal.ofReal_pos.mpr hR) ENNReal.ofReal_ne_top
  have hw0 : w ≠ 0 := hwpos.ne'
  have hwtop : w ≠ ⊤ := by
    dsimp only [w]
    exact ENNReal.rpow_ne_top_of_ne_zero
      (ENNReal.ofReal_ne_zero_iff.mpr hR) ENNReal.ofReal_ne_top
  have hweight :=
    outerPower_mul_lintegral_volume_le_powerWeightedVolume_of_annular_support
      hα hr G hG hGsupport
  have hweight' : w * (∫⁻ x, G x ∂volume) ≤
      ∫⁻ x, G x ∂powerWeightedVolume d α := by
    simpa only [w] using hweight
  calc
    (∫⁻ x, G x ∂volume) = w⁻¹ * (w * ∫⁻ x, G x ∂volume) := by
      rw [← mul_assoc, ENNReal.inv_mul_cancel hw0 hwtop, one_mul]
    _ ≤ w⁻¹ * (∫⁻ x, G x ∂powerWeightedVolume d α) :=
      mul_le_mul_right hweight' _

/-- A lower integral is unchanged on restricting the measure to a measurable
set outside which its integrand vanishes. -/
theorem lintegral_eq_lintegral_restrict_of_support
    {X : Type*} [MeasurableSpace X] {ν : Measure X} (A : Set X)
    (hA : MeasurableSet A) (G : X → ENNReal)
    (hGsupport : ∀ x, x ∉ A → G x = 0) :
    (∫⁻ x, G x ∂ν) = ∫⁻ x, G x ∂ν.restrict A := by
  have hindicator : A.indicator G = G := by
    funext x
    by_cases hx : x ∈ A
    · simp [hx]
    · simp [hx, hGsupport x hx]
  calc
    (∫⁻ x, G x ∂ν) = ∫⁻ x, A.indicator G x ∂ν := by rw [hindicator]
    _ = ∫⁻ x, G x ∂ν.restrict A := by rw [lintegral_indicator hA]

/-- Hölder on one annular support set.  This retains the measure of that
annulus, rather than replacing it with the volume of a fixed containing
ball; the thin-radial tail argument needs exactly this factor. -/
theorem eLpNorm_one_volume_le_eLpNorm_mul_annulus_volume_of_annular_support
    {d : Nat} {p r R : Real} (hp : 1 < p)
    (f : SchwartzMap (Euclidean d) Complex)
    (hfsupport : ∀ x : Euclidean d, x ∉ euclideanAnnulus d r R → f x = 0) :
    eLpNorm (f : Euclidean d → Complex) 1 volume ≤
      eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume *
        (volume (euclideanAnnulus d r R)) ^ (1 - p⁻¹) := by
  let A : Set (Euclidean d) := euclideanAnnulus d r R
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  have hp0 : 0 < p := lt_trans zero_lt_one hp
  have hf_indicator : A.indicator (f : Euclidean d → Complex) =
      (f : Euclidean d → Complex) := by
    funext x
    by_cases hx : x ∈ A
    · simp [hx]
    · simp [hx, hfsupport x hx]
  have hone_restrict :
      eLpNorm (f : Euclidean d → Complex) 1 volume =
        eLpNorm (f : Euclidean d → Complex) 1 (volume.restrict A) := by
    calc
      eLpNorm (f : Euclidean d → Complex) 1 volume =
          eLpNorm (A.indicator (f : Euclidean d → Complex)) 1 volume :=
        congrArg (fun g : Euclidean d → Complex => eLpNorm g 1 volume)
          hf_indicator |>.symm
      _ = eLpNorm (f : Euclidean d → Complex) 1 (volume.restrict A) :=
        eLpNorm_indicator_eq_eLpNorm_restrict hA
  have hp_restrict :
      eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume =
        eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p)
          (volume.restrict A) := by
    calc
      eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume =
          eLpNorm (A.indicator (f : Euclidean d → Complex))
            (ENNReal.ofReal p) volume :=
        congrArg (fun g : Euclidean d → Complex =>
          eLpNorm g (ENNReal.ofReal p) volume) hf_indicator |>.symm
      _ = eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p)
          (volume.restrict A) := eLpNorm_indicator_eq_eLpNorm_restrict hA
  have hholder := eLpNorm_le_eLpNorm_mul_rpow_measure_univ
    (μ := volume.restrict A) (f := (f : Euclidean d → Complex))
    (show (1 : ENNReal) ≤ ENNReal.ofReal p by
      rw [← ENNReal.ofReal_one]
      exact ENNReal.ofReal_le_ofReal hp.le)
    f.continuous.aestronglyMeasurable
  have hholder' :
      eLpNorm (f : Euclidean d → Complex) 1 (volume.restrict A) ≤
        eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p)
          (volume.restrict A) *
          (volume A) ^ (1 - p⁻¹) := by
    simpa [Measure.restrict_apply, hA, ENNReal.toReal_ofReal hp0.le] using hholder
  calc
    eLpNorm (f : Euclidean d → Complex) 1 volume =
        eLpNorm (f : Euclidean d → Complex) 1 (volume.restrict A) := hone_restrict
    _ ≤ eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p)
          (volume.restrict A) * (volume A) ^ (1 - p⁻¹) := hholder'
    _ = eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume *
          (volume (euclideanAnnulus d r R)) ^ (1 - p⁻¹) := by
      rw [← hp_restrict]

/-- The raw `L¹` moment of annularly supported input is bounded by its
weighted `Lᵖ` moment with the sharp annulus-volume factor. -/
theorem lintegral_enorm_rpow_le_annulus_volume_mul_powerWeighted_of_annular_support
    {d : Nat} {p α r R : Real} (hp : 1 < p) (hα : α ≤ 0)
    (hr : 0 < r) (hrR : r ≤ R)
    (f : SchwartzMap (Euclidean d) Complex)
    (hfsupport : ∀ x : Euclidean d, x ∉ euclideanAnnulus d r R → f x = 0) :
    (∫⁻ x, ‖f x‖ₑ) ^ p ≤
      (volume (euclideanAnnulus d r R)) ^ (p - 1) *
        ((ENNReal.ofReal R) ^ α)⁻¹ *
          ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d α := by
  let A : Set (Euclidean d) := euclideanAnnulus d r R
  let I : ENNReal := ∫⁻ x, ‖f x‖ₑ
  let J : ENNReal := ∫⁻ x, ‖f x‖ₑ ^ p ∂volume
  let K : ENNReal := ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d α
  let V : ENNReal := volume A
  let w : ENNReal := (ENNReal.ofReal R) ^ α
  have hp0 : 0 < p := lt_trans zero_lt_one hp
  have hpnn : 0 ≤ p := hp0.le
  have hholder := eLpNorm_one_volume_le_eLpNorm_mul_annulus_volume_of_annular_support
    hp f hfsupport
  have hholder' : I ≤
      eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume *
        V ^ (1 - p⁻¹) := by
    simpa only [I, V, A, eLpNorm_one_eq_lintegral_enorm] using hholder
  have hGmeas : Measurable (fun x : Euclidean d => ‖f x‖ₑ ^ p) :=
    ENNReal.continuous_rpow_const.measurable.comp f.continuous.enorm.measurable
  have hGsupport : ∀ x : Euclidean d, x ∉ A → ‖f x‖ₑ ^ p = 0 := by
    intro x hx
    simp [hfsupport x hx, ENNReal.zero_rpow_of_pos hp0]
  have hinput : J ≤ w⁻¹ * K := by
    dsimp only [J, K, w, A]
    exact lintegral_volume_le_outerPower_inv_mul_powerWeightedVolume_of_annular_support
      hα hr hrR _ hGmeas hGsupport
  have hPpow :
      (eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume) ^ p = J := by
    dsimp only [J]
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
      (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top]
    simp only [ENNReal.toReal_ofReal hpnn]
    rw [← ENNReal.rpow_mul]
    field_simp
    rw [ENNReal.rpow_one]
  have hraised := ENNReal.rpow_le_rpow hholder' hpnn
  calc
    (∫⁻ x, ‖f x‖ₑ) ^ p = I ^ p := by rfl
    _ ≤ (eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume *
          V ^ (1 - p⁻¹)) ^ p := hraised
    _ = (eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume) ^ p *
          (V ^ (1 - p⁻¹)) ^ p := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ hpnn]
    _ = J * V ^ (p - 1) := by
          rw [hPpow, ← ENNReal.rpow_mul]
          congr 1
          field_simp
    _ = V ^ (p - 1) * J := by ring
    _ ≤ V ^ (p - 1) * (w⁻¹ * K) := mul_le_mul_right hinput _
    _ = (volume (euclideanAnnulus d r R)) ^ (p - 1) *
          ((ENNReal.ofReal R) ^ α)⁻¹ *
            ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d α := by
          dsimp only [V, w, K, A]
          ring

/-- The radius-restricted raw spherical maximal norm is subadditive on
continuous inputs.  Unlike the compact-interval helper in `SphericalAverages`,
this keeps an arbitrary subset of radii visible. -/
theorem restricted_iSup_ennreal_norm_sphericalAverage_add_le
    {d : Nat} (E : Set ℝ) (f g : Euclidean d → ℂ)
    (hf : Continuous f) (hg : Continuous g) (x : Euclidean d) :
    (⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
      ENNReal.ofReal ‖sphericalAverage d (f + g) r.1 x‖) ≤
      (⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
        ENNReal.ofReal ‖sphericalAverage d f r.1 x‖) +
        ⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
          ENNReal.ofReal ‖sphericalAverage d g r.1 x‖ := by
  apply iSup_le
  intro r
  have hint (h : Euclidean d → ℂ) (hh : Continuous h) : Integrable
      (fun ω : sphere (0 : Euclidean d) 1 => h (x + r.1 • (ω : Euclidean d)))
      (unitSurfaceMeasure d) := by
    apply Continuous.integrable_of_hasCompactSupport
    · exact hh.comp
        ((continuous_const : Continuous fun _ : sphere (0 : Euclidean d) 1 => x).add
          ((continuous_const : Continuous fun _ : sphere (0 : Euclidean d) 1 => r.1).smul
            continuous_subtype_val))
    · exact HasCompactSupport.of_compactSpace _
  have havg : sphericalAverage d (f + g) r.1 x =
      sphericalAverage d f r.1 x + sphericalAverage d g r.1 x := by
    unfold sphericalAverage
    change (∫ ω : sphere (0 : Euclidean d) 1,
      (f (x + r.1 • (ω : Euclidean d)) + g (x + r.1 • (ω : Euclidean d)))
      ∂unitSurfaceMeasure d) = _
    rw [MeasureTheory.integral_add (hint f hf) (hint g hg)]
  rw [havg]
  calc
    ENNReal.ofReal ‖sphericalAverage d f r.1 x + sphericalAverage d g r.1 x‖ ≤
        ENNReal.ofReal (‖sphericalAverage d f r.1 x‖ +
          ‖sphericalAverage d g r.1 x‖) :=
      ENNReal.ofReal_le_ofReal (norm_add_le _ _)
    _ = ENNReal.ofReal ‖sphericalAverage d f r.1 x‖ +
          ENNReal.ofReal ‖sphericalAverage d g r.1 x‖ := by
      rw [ENNReal.ofReal_add (norm_nonneg _) (norm_nonneg _)]
    _ ≤ (⨆ s : ↥(E ∩ Ioi (0 : ℝ)),
          ENNReal.ofReal ‖sphericalAverage d f s.1 x‖) +
        ⨆ s : ↥(E ∩ Ioi (0 : ℝ)),
          ENNReal.ofReal ‖sphericalAverage d g s.1 x‖ := by
      gcongr
      · exact le_iSup (fun s : ↥(E ∩ Ioi (0 : ℝ)) =>
          ENNReal.ofReal ‖sphericalAverage d f s.1 x‖) r
      · exact le_iSup (fun s : ↥(E ∩ Ioi (0 : ℝ)) =>
          ENNReal.ofReal ‖sphericalAverage d g s.1 x‖) r

