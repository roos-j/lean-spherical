  intro r
  exact le_iSup
    (fun s : Icc (1 : ℝ) 2 =>
      ENNReal.ofReal ‖sphericalAverage d (Pg : Euclidean d → ℂ) s.1 x‖)
    ⟨r.1, hE r.2.1⟩

/-- The real-valued restricted smooth dyadic maximal output is subadditive on
Schwartz inputs. -/
theorem restricted_smooth_dyadic_sphericalMaximal_add_le
    {d : Nat} (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2)
    (psi f g : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    (⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
      ‖sphericalAverage d
        ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 (f + g))) :
          SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) r.1 x‖).toReal ≤
      (⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
        ‖sphericalAverage d
          ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 f)) :
            SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) r.1 x‖).toReal +
        (⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
          ‖sphericalAverage d
            ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 g)) :
              SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) r.1 x‖).toReal := by
  let Pf : SchwartzMap (Euclidean d) ℂ :=
    𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 f))
  let Pg : SchwartzMap (Euclidean d) ℂ :=
    𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 g))
  have hPadd :
      (𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 (f + g))) :
        SchwartzMap (Euclidean d) ℂ) = Pf + Pg := by
    rw [fourier_add f g]
    rw [(SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ)).map_add]
    rw [fourierInv_add]
  have hfin_f :=
    restricted_iSup_ennreal_norm_smooth_dyadic_sphericalAverage_ne_top E hE psi f x
  have hfin_g :=
    restricted_iSup_ennreal_norm_smooth_dyadic_sphericalAverage_ne_top E hE psi g x
  have hfin_fg :=
    restricted_iSup_ennreal_norm_smooth_dyadic_sphericalAverage_ne_top E hE psi (f + g) x
  have hfin_fg' :
      (⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
        ENNReal.ofReal ‖sphericalAverage d ((Pf + Pg : SchwartzMap (Euclidean d) ℂ) :
          Euclidean d → ℂ) r.1 x‖) ≠ ⊤ := by
    simpa only [hPadd] using hfin_fg
  have hsumfin :
      (⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
        ENNReal.ofReal ‖sphericalAverage d (Pf : Euclidean d → ℂ) r.1 x‖) +
          ⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
            ENNReal.ofReal ‖sphericalAverage d (Pg : Euclidean d → ℂ) r.1 x‖ ≠ ⊤ :=
    ENNReal.add_ne_top.mpr ⟨hfin_f, hfin_g⟩
  calc
    (⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
      ‖sphericalAverage d
        ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 (f + g))) :
          SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) r.1 x‖).toReal =
        (⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
          ENNReal.ofReal ‖sphericalAverage d ((Pf + Pg : SchwartzMap (Euclidean d) ℂ) :
            Euclidean d → ℂ) r.1 x‖).toReal := by rw [hPadd]
    _ ≤
        ((⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
          ENNReal.ofReal ‖sphericalAverage d (Pf : Euclidean d → ℂ) r.1 x‖) +
          ⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
            ENNReal.ofReal ‖sphericalAverage d (Pg : Euclidean d → ℂ) r.1 x‖).toReal :=
      (ENNReal.toReal_le_toReal hfin_fg' hsumfin).2
        (restricted_iSup_ennreal_norm_sphericalAverage_add_le E
          (Pf : Euclidean d → ℂ) (Pg : Euclidean d → ℂ) Pf.continuous Pg.continuous x)
    _ = (⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
          ENNReal.ofReal ‖sphericalAverage d (Pf : Euclidean d → ℂ) r.1 x‖).toReal +
        (⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
          ENNReal.ofReal ‖sphericalAverage d (Pg : Euclidean d → ℂ) r.1 x‖).toReal :=
      ENNReal.toReal_add hfin_f hfin_g

