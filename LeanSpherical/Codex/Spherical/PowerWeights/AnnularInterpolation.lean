        ENNReal.ofReal ‖G (r.1, x)‖) (a := x)).symm
  have hbase : Measurable (fun x : Euclidean d =>
      ⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
        ‖sphericalAverage d (Pg : Euclidean d → ℂ) r.1 x‖) := by
    rw [hEq]
    exact hMeas
  exact ENNReal.measurable_toReal.comp hbase

/-- Squaring commutes with the supremum of nonnegative extended-real values
over a nonempty radius set. -/
theorem iSup_ennreal_norm_sq_eq_sq_iSup_ennreal_norm
    {ι : Type*} [Nonempty ι] (F : ι → ℂ) :
    (⨆ i : ι, ENNReal.ofReal (‖F i‖ ^ (2 : ℕ))) =
      (⨆ i : ι, ENNReal.ofReal ‖F i‖) ^ (2 : ℕ) := by
  rw [ENNReal.iSup_pow]
  apply iSup_congr
  intro i
  rw [ENNReal.ofReal_pow (norm_nonneg _)]

/-- The finite entropy cover has a uniform square-function coefficient.  The
two terms retain respectively the frequency decay and the short-radius
derivative gain. -/
theorem entropy_interval_coefficient_sum_le
    (T : Finset (ℝ × ℝ)) (N : ℕ)
    (B C L : ℝ) (hcard : T.card ≤ N) (hordered : ∀ q ∈ T, q.1 ≤ q.2)
    (hlength : ∀ q ∈ T, q.2 - q.1 ≤ L) (hL : 0 ≤ L) :
    (∑ q ∈ T, ENNReal.ofReal
      (2 * B ^ (2 : ℕ) + 2 * (q.2 - q.1) ^ (2 : ℕ) * C ^ (2 : ℕ))) ≤
      (N : ENNReal) * ENNReal.ofReal
        (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) := by
  have hterm (q : ℝ × ℝ) (hq : q ∈ T) :
      ENNReal.ofReal
          (2 * B ^ (2 : ℕ) + 2 * (q.2 - q.1) ^ (2 : ℕ) * C ^ (2 : ℕ)) ≤
        ENNReal.ofReal (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) := by
    apply ENNReal.ofReal_le_ofReal
    have hq0 : 0 ≤ q.2 - q.1 := sub_nonneg.mpr (hordered q hq)
    have hql : q.2 - q.1 ≤ L := hlength q hq
    have hsq : (q.2 - q.1) ^ (2 : ℕ) ≤ L ^ (2 : ℕ) := by
      nlinarith [mul_nonneg (show 0 ≤ L - (q.2 - q.1) by linarith)
        (show 0 ≤ L + (q.2 - q.1) by linarith)]
    gcongr
  calc
    (∑ q ∈ T, ENNReal.ofReal
      (2 * B ^ (2 : ℕ) + 2 * (q.2 - q.1) ^ (2 : ℕ) * C ^ (2 : ℕ))) ≤
        ∑ q ∈ T, ENNReal.ofReal
          (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) := by
      apply Finset.sum_le_sum
      intro q hq
      exact hterm q hq
    _ = (T.card : ENNReal) * ENNReal.ofReal
        (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) := by simp
    _ ≤ (N : ENNReal) * ENNReal.ofReal
        (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) := by
      gcongr

/-- The physical endpoint, restricted to a spatial annulus, as a lower
integral estimate for the literal smooth dyadic maximal piece.  The input
support hypothesis is exactly where the lower annular weight comparison is
used. -/
theorem smooth_dyadic_annular_lintegral_one_le_of_pointwise
    {d : Nat} {α r R : ℝ} (hα : α ≤ 0) (hr : 0 < r) (hrR : r ≤ R)
    (D : ℝ) (hD : 0 ≤ D) (j : Nat) (psi : SchwartzMap (Euclidean d) ℂ)
    (E : Set ℝ)
    (hpointwise : ∀ (g : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d),
      (⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
        ‖sphericalAverage d
          ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 g)) :
            SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) s.1 x‖) ≤
        ENNReal.ofReal (D * (2 : ℝ) ^ j * ∫ y : Euclidean d, ‖g y‖))
    (g : SchwartzMap (Euclidean d) ℂ)
    (hgsupport : ∀ x, x ∉ euclideanAnnulus d r R → g x = 0) :
    let A : Set (Euclidean d) := euclideanAnnulus d r R
    let μ : Measure (Euclidean d) := powerWeightedVolume d α
    let T : Euclidean d → ℝ := A.indicator (fun x =>
      (⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
        ‖sphericalAverage d
          ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 g)) :
            SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) s.1 x‖).toReal)
    let c : ENNReal := ENNReal.ofReal (D * (2 : ℝ) ^ j)
    let w : ENNReal := (ENNReal.ofReal R) ^ α
    (∫⁻ x, ENNReal.ofReal (T x) ∂μ) ≤
      c * μ A * w⁻¹ *
        ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂μ := by
  dsimp only
  let A : Set (Euclidean d) := euclideanAnnulus d r R
  let μ : Measure (Euclidean d) := powerWeightedVolume d α
  let M : Euclidean d → ENNReal := fun x =>
    ⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
      ‖sphericalAverage d
        ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 g)) :
          SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) s.1 x‖
  let T : Euclidean d → ℝ := A.indicator (fun x => (M x).toReal)
  let c : ENNReal := ENNReal.ofReal (D * (2 : ℝ) ^ j)
  let w : ENNReal := (ENNReal.ofReal R) ^ α
  let I : ENNReal := ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂volume
  let J : ENNReal := ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂μ
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  have hDpow : 0 ≤ D * (2 : ℝ) ^ j := by positivity
  have hI : I = ENNReal.ofReal (∫ x : Euclidean d, ‖g x‖) := by
    dsimp only [I]
    symm
    simpa only [ofReal_norm] using
      ofReal_integral_norm_eq_lintegral_enorm (μ := volume) g.integrable
  have hMpoint (x : Euclidean d) : M x ≤ c * I := by
    calc
      M x ≤ ENNReal.ofReal (D * (2 : ℝ) ^ j * ∫ y : Euclidean d, ‖g y‖) :=
        hpointwise g x
      _ = c * I := by
        rw [ENNReal.ofReal_mul hDpow, ← hI]
  have hMfin (x : Euclidean d) : M x ≠ ⊤ :=
    ne_top_of_le_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top
      (by rw [hI]; exact ENNReal.ofReal_ne_top)) (hMpoint x)
  have hTpoint (x : Euclidean d) :
      ENNReal.ofReal (T x) ≤ A.indicator (fun _ : Euclidean d => c * I) x := by
    by_cases hx : x ∈ A
    · simp only [T, Set.indicator_of_mem hx]
      rw [ENNReal.ofReal_toReal (hMfin x)]
      exact hMpoint x
    · simp only [T, Set.indicator_of_notMem hx]
      simp
  have hGmeas : Measurable (fun x : Euclidean d => ENNReal.ofReal ‖g x‖) :=
    g.continuous.norm.measurable.ennreal_ofReal
  have hGsupport : ∀ x, x ∉ A → ENNReal.ofReal ‖g x‖ = 0 := by
    intro x hx
    simp [hgsupport x hx]
  have hinput : I ≤ w⁻¹ * J := by
    dsimp only [I, J, w, μ]
    exact lintegral_volume_le_outerPower_inv_mul_powerWeightedVolume_of_annular_support
      hα hr hrR _ hGmeas hGsupport
  calc
    (∫⁻ x, ENNReal.ofReal (T x) ∂μ) ≤
        ∫⁻ x, A.indicator (fun _ : Euclidean d => c * I) x ∂μ :=
      lintegral_mono hTpoint
    _ = c * I * μ A := by
      rw [lintegral_indicator hA, setLIntegral_const]
    _ = c * μ A * I := by ring
    _ ≤ c * μ A * (w⁻¹ * J) := mul_le_mul_right hinput _
    _ = c * μ A * w⁻¹ * J := by ring

/-- The preceding annular physical endpoint in the finite restricted measure
needed by the interpolation core. -/
theorem smooth_dyadic_annular_lintegral_one_le_of_pointwise_restrict
    {d : Nat} {α r R : ℝ} (hα : α ≤ 0) (hr : 0 < r) (hrR : r ≤ R)
    (D : ℝ) (hD : 0 ≤ D) (j : Nat) (psi : SchwartzMap (Euclidean d) ℂ)
    (E : Set ℝ)
    (hpointwise : ∀ (g : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d),
      (⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
        ‖sphericalAverage d
          ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 g)) :
            SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) s.1 x‖) ≤
        ENNReal.ofReal (D * (2 : ℝ) ^ j * ∫ y : Euclidean d, ‖g y‖))
    (g : SchwartzMap (Euclidean d) ℂ)
    (hgsupport : ∀ x, x ∉ euclideanAnnulus d r R → g x = 0) :
    let A : Set (Euclidean d) := euclideanAnnulus d r R
    let ν : Measure (Euclidean d) := powerWeightedVolume d α
    let μ : Measure (Euclidean d) := ν.restrict A
    let T : Euclidean d → ℝ := A.indicator (fun x =>
      (⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
        ‖sphericalAverage d
          ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 g)) :
            SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) s.1 x‖).toReal)
    let c : ENNReal := ENNReal.ofReal (D * (2 : ℝ) ^ j)
    let w : ENNReal := (ENNReal.ofReal R) ^ α
    (∫⁻ x, ENNReal.ofReal (T x) ∂μ) ≤
      c * ν A * w⁻¹ *
        ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂μ := by
  dsimp only
  let A : Set (Euclidean d) := euclideanAnnulus d r R
  let ν : Measure (Euclidean d) := powerWeightedVolume d α
  let μ : Measure (Euclidean d) := ν.restrict A
  let T : Euclidean d → ℝ := A.indicator (fun x =>
    (⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
      ‖sphericalAverage d
        ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 g)) :
          SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) s.1 x‖).toReal)
  let c : ENNReal := ENNReal.ofReal (D * (2 : ℝ) ^ j)
  let w : ENNReal := (ENNReal.ofReal R) ^ α
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  have hglobal : (∫⁻ x, ENNReal.ofReal (T x) ∂ν) ≤
      c * ν A * w⁻¹ * ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂ν := by
    simpa only [A, ν, T, c, w] using
      (smooth_dyadic_annular_lintegral_one_le_of_pointwise
        hα hr hrR D hD j psi E hpointwise g hgsupport)
  have hTout : ∀ x, x ∉ A → ENNReal.ofReal (T x) = 0 := by
    intro x hx
    simp [T, hx]
  have hGin : ∀ x, x ∉ A → ENNReal.ofReal ‖g x‖ = 0 := by
    intro x hx
    simp [hgsupport x hx]
  have hout_eq := lintegral_eq_lintegral_restrict_of_support A hA
    (fun x : Euclidean d => ENNReal.ofReal (T x)) hTout (ν := ν)
  have hin_eq := lintegral_eq_lintegral_restrict_of_support A hA
    (fun x : Euclidean d => ENNReal.ofReal ‖g x‖) hGin (ν := ν)
  calc
    (∫⁻ x, ENNReal.ofReal (T x) ∂μ) = ∫⁻ x, ENNReal.ofReal (T x) ∂ν := by
      exact hout_eq.symm
    _ ≤ c * ν A * w⁻¹ * ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂ν := hglobal
    _ = c * ν A * w⁻¹ * ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂μ := by rw [hin_eq]

/-- The entropy `L²` endpoint on a spatial annulus, converted to the same
power-weighted input measure as the physical endpoint.  The displayed
coefficient keeps both the entropy cardinality and short-interval gain. -/
theorem smooth_dyadic_annular_lintegral_two_le_of_sharp
    {d : Nat} (hd : 2 ≤ d) (C0 C1 : ℝ) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ ξ : Euclidean (d + 1), 1 ≤ ‖ξ‖ →
      ‖surfaceFourier (d + 1) ξ‖ ≤ C0 / ‖ξ‖ ^ ((d : ℝ) / 2))
    (hderiv : ∀ ξ : Euclidean (d + 1), ∀ u : ℝ, 1 ≤ ‖ξ‖ →
      u ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun s : ℝ => surfaceFourier (d + 1) (s • ξ)) u‖ ≤
        C1 / ‖ξ‖ ^ ((d : ℝ) / 2 - 1))
    (phi psi : SchwartzMap (Euclidean (d + 1)) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ, ‖phi ξ‖ ≤ 1) (j : Nat)
    (hpsi : ∀ ξ : Euclidean (d + 1),
      psi ξ = phi (((2 : ℝ) ^ (j + 1))⁻¹ • ξ) -
        phi (((2 : ℝ) ^ j)⁻¹ • ξ))
    (hpsi_compact : HasCompactSupport (psi : Euclidean (d + 1) → ℂ))
    (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    (δ : ℝ≥0) (N : ℕ) (hN : multiplicativeEntropy E δ ≤ N)
    (hδ : Real.log 2 * (δ : ℝ) ≤ 1)
    {α r R : ℝ} (hα : α ≤ 0) (hr : 0 < r) (hrR : r ≤ R)
    (g : SchwartzMap (Euclidean (d + 1)) ℂ)
    (hgsupport : ∀ x, x ∉ euclideanAnnulus (d + 1) r R → g x = 0) :
    let A : Set (Euclidean (d + 1)) := euclideanAnnulus (d + 1) r R
    let μ : Measure (Euclidean (d + 1)) := powerWeightedVolume (d + 1) α
    let T : Euclidean (d + 1) → ℝ := A.indicator (fun x =>
      (⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
        ‖sphericalAverage (d + 1)
          ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ
            (psi : Euclidean (d + 1) → ℂ) (𝓕 g)) :
              SchwartzMap (Euclidean (d + 1)) ℂ) : Euclidean (d + 1) → ℂ)
          s.1 x‖).toReal)
    let B : ℝ := (2 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)
    let C : ℝ := (2 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1)
    let L : ℝ := 8 * Real.log 2 * (δ : ℝ)
    let wᵢ : ENNReal := (ENNReal.ofReal r) ^ α
    let wₒ : ENNReal := (ENNReal.ofReal R) ^ α
    (∫⁻ x, ENNReal.ofReal ((T x) ^ (2 : ℕ)) ∂μ) ≤
      wᵢ * (N : ENNReal) * ENNReal.ofReal
        (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) * wₒ⁻¹ *
        ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) ∂μ := by
  dsimp only
  let A : Set (Euclidean (d + 1)) := euclideanAnnulus (d + 1) r R
  let μ : Measure (Euclidean (d + 1)) := powerWeightedVolume (d + 1) α
  let M₁ : Euclidean (d + 1) → ENNReal := fun x =>
    ⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
      ‖sphericalAverage (d + 1)
        ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ
          (psi : Euclidean (d + 1) → ℂ) (𝓕 g)) :
            SchwartzMap (Euclidean (d + 1)) ℂ) : Euclidean (d + 1) → ℂ)
        s.1 x‖
  let M₂ : Euclidean (d + 1) → ENNReal := fun x =>
    ⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
      (‖sphericalAverage (d + 1)
        ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ
          (psi : Euclidean (d + 1) → ℂ) (𝓕 g)) :
            SchwartzMap (Euclidean (d + 1)) ℂ) : Euclidean (d + 1) → ℂ)
        s.1 x‖ ^ (2 : ℕ))
  let T : Euclidean (d + 1) → ℝ := A.indicator (fun x => (M₁ x).toReal)
  let B : ℝ := (2 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)
  let C : ℝ := (2 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1)
  let L : ℝ := 8 * Real.log 2 * (δ : ℝ)
  let wᵢ : ENNReal := (ENNReal.ofReal r) ^ α
  let wₒ : ENNReal := (ENNReal.ofReal R) ^ α
  let I : ENNReal := ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) ∂volume
  let J : ENNReal := ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) ∂μ
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  have hIintegrable : Integrable (fun x : Euclidean (d + 1) =>
      ‖g x‖ ^ (2 : ℕ)) volume :=
    (memLp_two_iff_integrable_sq_norm g.continuous.aestronglyMeasurable).mp
      (g.memLp 2 volume)
  have hI : I = ENNReal.ofReal (∫ x : Euclidean (d + 1), ‖g x‖ ^ (2 : ℕ)) := by
    dsimp only [I]
    exact (ofReal_integral_eq_lintegral_ofReal hIintegrable
      (Filter.Eventually.of_forall fun x => sq_nonneg (‖g x‖))).symm
  have hposE : ∀ t ∈ E, 0 < t := by
    intro t ht
    exact lt_of_lt_of_le zero_lt_one (hE ht).1
  rcases hEne with ⟨t₀, ht₀⟩
  letI : Nonempty ↥(E ∩ Ioi (0 : ℝ)) := ⟨⟨t₀, ht₀, hposE t₀ ht₀⟩⟩
  have hMfin (x : Euclidean (d + 1)) : M₁ x ≠ ⊤ := by
    dsimp only [M₁]
    exact restricted_iSup_ennreal_norm_smooth_dyadic_sphericalAverage_ne_top
      E hE psi g x
  have hM₂_eq (x : Euclidean (d + 1)) : M₂ x = (M₁ x) ^ (2 : ℕ) := by
    dsimp only [M₂, M₁]
    exact iSup_ennreal_norm_sq_eq_sq_iSup_ennreal_norm
      (fun s : ↥(E ∩ Ioi (0 : ℝ)) =>
        sphericalAverage (d + 1)
          ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ
            (psi : Euclidean (d + 1) → ℂ) (𝓕 g)) :
              SchwartzMap (Euclidean (d + 1)) ℂ) : Euclidean (d + 1) → ℂ)
          s.1 x)
  have hT_sq (x : Euclidean (d + 1)) :
      ENNReal.ofReal ((T x) ^ (2 : ℕ)) = A.indicator M₂ x := by
    by_cases hx : x ∈ A
    · simp only [T, Set.indicator_of_mem hx, M₂]
      rw [ENNReal.ofReal_pow ENNReal.toReal_nonneg,
        ENNReal.ofReal_toReal (hMfin x), ← hM₂_eq]
    · simp [T, hx]
  obtain ⟨S, hScard, hSordered, _hSends, hSlength, hSbound⟩ :=
    exists_entropy_interval_lintegral_iSup_ennreal_norm_sq_smooth_dyadic_on_annulus_of_sharp
      hd C0 C1 hC0 hC1 hdecay hderiv phi g psi hphi_one hphi_zero hphi_norm
      j hpsi hpsi_compact E hE ⟨t₀, ht₀⟩ δ N hN hδ hα hr (R := R)
  have hLnonneg : 0 ≤ L := by
    dsimp only [L]
    positivity
  have hSsum := entropy_interval_coefficient_sum_le S N B C L
    hScard hSordered hSlength hLnonneg
  have hSbound' :
      (∫⁻ x in A, M₂ x ∂μ) ≤
        wᵢ *
          (∑ q ∈ S, ENNReal.ofReal
            (2 * B ^ (2 : ℕ) + 2 * (q.2 - q.1) ^ (2 : ℕ) * C ^ (2 : ℕ)) * I) := by
    calc
      (∫⁻ x in A, M₂ x ∂μ) ≤
          wᵢ *
            (∑ q ∈ S, ENNReal.ofReal
              ((2 * B ^ (2 : ℕ) + 2 * (q.2 - q.1) ^ (2 : ℕ) * C ^ (2 : ℕ)) *
                ∫ x : Euclidean (d + 1), ‖g x‖ ^ (2 : ℕ))) := by
        simpa only [A, μ, M₂, B, C, wᵢ] using hSbound
      _ = wᵢ *
          (∑ q ∈ S, ENNReal.ofReal
            (2 * B ^ (2 : ℕ) + 2 * (q.2 - q.1) ^ (2 : ℕ) * C ^ (2 : ℕ)) * I) := by
        congr 2
        funext q
        rw [ENNReal.ofReal_mul (by positivity), ← hI]
  have hbound :
      (∫⁻ x in A, M₂ x ∂μ) ≤
        wᵢ * (N : ENNReal) * ENNReal.ofReal
          (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) * I := by
    calc
      (∫⁻ x in A, M₂ x ∂μ) ≤
          wᵢ *
            (∑ q ∈ S, ENNReal.ofReal
              (2 * B ^ (2 : ℕ) + 2 * (q.2 - q.1) ^ (2 : ℕ) * C ^ (2 : ℕ)) * I) := by
        exact hSbound'
      _ = wᵢ *
          ((∑ q ∈ S, ENNReal.ofReal
            (2 * B ^ (2 : ℕ) + 2 * (q.2 - q.1) ^ (2 : ℕ) * C ^ (2 : ℕ))) * I) := by
        rw [← Finset.sum_mul]
      _ ≤ wᵢ *
          (((N : ENNReal) * ENNReal.ofReal
            (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ))) * I) := by
        calc
          wᵢ *
              ((∑ q ∈ S, ENNReal.ofReal
                (2 * B ^ (2 : ℕ) + 2 * (q.2 - q.1) ^ (2 : ℕ) * C ^ (2 : ℕ))) * I) =
              wᵢ *
                (I * ∑ q ∈ S, ENNReal.ofReal
                  (2 * B ^ (2 : ℕ) + 2 * (q.2 - q.1) ^ (2 : ℕ) * C ^ (2 : ℕ))) := by ring
          _ ≤ wᵢ *
              (I * ((N : ENNReal) * ENNReal.ofReal
                (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)))) :=
            mul_le_mul_right (mul_le_mul_right hSsum I) wᵢ
          _ = wᵢ *
              (((N : ENNReal) * ENNReal.ofReal
                (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ))) * I) := by ring
      _ = wᵢ * (N : ENNReal) * ENNReal.ofReal
          (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) * I := by ring
  have hGmeas : Measurable (fun x : Euclidean (d + 1) =>
      ENNReal.ofReal (‖g x‖ ^ (2 : ℕ))) :=
    (g.continuous.norm.pow 2).measurable.ennreal_ofReal
  have hGsupport : ∀ x, x ∉ A → ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) = 0 := by
    intro x hx
    simp [hgsupport x hx]
  have hinput : I ≤ wₒ⁻¹ * J := by
    dsimp only [I, J, wₒ, μ]
    exact lintegral_volume_le_outerPower_inv_mul_powerWeightedVolume_of_annular_support
      hα hr hrR _ hGmeas hGsupport
  calc
    (∫⁻ x, ENNReal.ofReal ((T x) ^ (2 : ℕ)) ∂μ) = ∫⁻ x in A, M₂ x ∂μ := by
      rw [show (fun x : Euclidean (d + 1) => ENNReal.ofReal ((T x) ^ (2 : ℕ))) =
          A.indicator M₂ by
        funext x
        exact hT_sq x,
        lintegral_indicator hA]
    _ ≤ wᵢ * (N : ENNReal) * ENNReal.ofReal
        (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) * I := hbound
    _ ≤ wᵢ * (N : ENNReal) * ENNReal.ofReal
        (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) * (wₒ⁻¹ * J) :=
      mul_le_mul_right hinput _
    _ = wᵢ * (N : ENNReal) * ENNReal.ofReal
        (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) * wₒ⁻¹ * J := by ring

/-- The entropy `L²` endpoint in the finite annular restriction of the power
measure. -/
theorem smooth_dyadic_annular_lintegral_two_le_of_sharp_restrict
    {d : Nat} (hd : 2 ≤ d) (C0 C1 : ℝ) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ ξ : Euclidean (d + 1), 1 ≤ ‖ξ‖ →
      ‖surfaceFourier (d + 1) ξ‖ ≤ C0 / ‖ξ‖ ^ ((d : ℝ) / 2))
    (hderiv : ∀ ξ : Euclidean (d + 1), ∀ u : ℝ, 1 ≤ ‖ξ‖ →
      u ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun s : ℝ => surfaceFourier (d + 1) (s • ξ)) u‖ ≤
        C1 / ‖ξ‖ ^ ((d : ℝ) / 2 - 1))
    (phi psi : SchwartzMap (Euclidean (d + 1)) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ, ‖phi ξ‖ ≤ 1) (j : Nat)
    (hpsi : ∀ ξ : Euclidean (d + 1),
      psi ξ = phi (((2 : ℝ) ^ (j + 1))⁻¹ • ξ) -
        phi (((2 : ℝ) ^ j)⁻¹ • ξ))
    (hpsi_compact : HasCompactSupport (psi : Euclidean (d + 1) → ℂ))
    (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    (δ : ℝ≥0) (N : ℕ) (hN : multiplicativeEntropy E δ ≤ N)
    (hδ : Real.log 2 * (δ : ℝ) ≤ 1)
    {α r R : ℝ} (hα : α ≤ 0) (hr : 0 < r) (hrR : r ≤ R)
    (g : SchwartzMap (Euclidean (d + 1)) ℂ)
    (hgsupport : ∀ x, x ∉ euclideanAnnulus (d + 1) r R → g x = 0) :
    let A : Set (Euclidean (d + 1)) := euclideanAnnulus (d + 1) r R
    let ν : Measure (Euclidean (d + 1)) := powerWeightedVolume (d + 1) α
    let μ : Measure (Euclidean (d + 1)) := ν.restrict A
    let T : Euclidean (d + 1) → ℝ := A.indicator (fun x =>
      (⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
        ‖sphericalAverage (d + 1)
          ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ
            (psi : Euclidean (d + 1) → ℂ) (𝓕 g)) :
              SchwartzMap (Euclidean (d + 1)) ℂ) : Euclidean (d + 1) → ℂ)
          s.1 x‖).toReal)
    let B : ℝ := (2 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)
    let C : ℝ := (2 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1)
    let L : ℝ := 8 * Real.log 2 * (δ : ℝ)
    let wᵢ : ENNReal := (ENNReal.ofReal r) ^ α
    let wₒ : ENNReal := (ENNReal.ofReal R) ^ α
    (∫⁻ x, ENNReal.ofReal ((T x) ^ (2 : ℕ)) ∂μ) ≤
      wᵢ * (N : ENNReal) * ENNReal.ofReal
        (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) * wₒ⁻¹ *
        ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) ∂μ := by
  dsimp only
  let A : Set (Euclidean (d + 1)) := euclideanAnnulus (d + 1) r R
  let ν : Measure (Euclidean (d + 1)) := powerWeightedVolume (d + 1) α
  let μ : Measure (Euclidean (d + 1)) := ν.restrict A
  let T : Euclidean (d + 1) → ℝ := A.indicator (fun x =>
    (⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
      ‖sphericalAverage (d + 1)
        ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ
          (psi : Euclidean (d + 1) → ℂ) (𝓕 g)) :
            SchwartzMap (Euclidean (d + 1)) ℂ) : Euclidean (d + 1) → ℂ)
        s.1 x‖).toReal)
  let B : ℝ := (2 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)
  let C : ℝ := (2 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1)
  let L : ℝ := 8 * Real.log 2 * (δ : ℝ)
  let wᵢ : ENNReal := (ENNReal.ofReal r) ^ α
  let wₒ : ENNReal := (ENNReal.ofReal R) ^ α
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  have hglobal : (∫⁻ x, ENNReal.ofReal ((T x) ^ (2 : ℕ)) ∂ν) ≤
      wᵢ * (N : ENNReal) * ENNReal.ofReal
        (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) * wₒ⁻¹ *
        ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) ∂ν := by
    simpa only [A, ν, T, B, C, L, wᵢ, wₒ] using
      (smooth_dyadic_annular_lintegral_two_le_of_sharp
        hd C0 C1 hC0 hC1 hdecay hderiv phi psi hphi_one hphi_zero hphi_norm j
        hpsi hpsi_compact E hE hEne δ N hN hδ hα hr hrR g hgsupport)
  have hTout : ∀ x, x ∉ A → ENNReal.ofReal ((T x) ^ (2 : ℕ)) = 0 := by
    intro x hx
    simp [T, hx]
  have hGin : ∀ x, x ∉ A → ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) = 0 := by
    intro x hx
    simp [hgsupport x hx]
  have hout_eq := lintegral_eq_lintegral_restrict_of_support A hA
    (fun x : Euclidean (d + 1) => ENNReal.ofReal ((T x) ^ (2 : ℕ))) hTout (ν := ν)
  have hin_eq := lintegral_eq_lintegral_restrict_of_support A hA
    (fun x : Euclidean (d + 1) => ENNReal.ofReal (‖g x‖ ^ (2 : ℕ))) hGin (ν := ν)
  calc
    (∫⁻ x, ENNReal.ofReal ((T x) ^ (2 : ℕ)) ∂μ) =
        ∫⁻ x, ENNReal.ofReal ((T x) ^ (2 : ℕ)) ∂ν := hout_eq.symm
    _ ≤ wᵢ * (N : ENNReal) * ENNReal.ofReal
        (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) * wₒ⁻¹ *
          ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) ∂ν := hglobal
    _ = wᵢ * (N : ENNReal) * ENNReal.ofReal
        (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) * wₒ⁻¹ *
          ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) ∂μ := by rw [hin_eq]

/-- The literal smooth dyadic maximal piece on one spatial annulus, obtained
by interpolating its physical `L¹` endpoint with the entropy `L²` endpoint.
The scale `s` is deliberately retained: choosing it later exposes the
summable dyadic gain under the local entropy hypothesis. -/
theorem smooth_dyadic_annular_lintegral_rpow_le_of_pointwise
    {d : Nat} (hd : 2 ≤ d) (C0 C1 : ℝ) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ ξ : Euclidean (d + 1), 1 ≤ ‖ξ‖ →
      ‖surfaceFourier (d + 1) ξ‖ ≤ C0 / ‖ξ‖ ^ ((d : ℝ) / 2))
    (hderiv : ∀ ξ : Euclidean (d + 1), ∀ u : ℝ, 1 ≤ ‖ξ‖ →
      u ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun z : ℝ => surfaceFourier (d + 1) (z • ξ)) u‖ ≤
        C1 / ‖ξ‖ ^ ((d : ℝ) / 2 - 1))
    (phi psi : SchwartzMap (Euclidean (d + 1)) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ, ‖phi ξ‖ ≤ 1) (j : Nat)
    (hpsi : ∀ ξ : Euclidean (d + 1),
      psi ξ = phi (((2 : ℝ) ^ (j + 1))⁻¹ • ξ) -
        phi (((2 : ℝ) ^ j)⁻¹ • ξ))
    (hpsi_compact : HasCompactSupport (psi : Euclidean (d + 1) → ℂ))
    (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    (δ : ℝ≥0) (N : ℕ) (hN : multiplicativeEntropy E δ ≤ N)
    (hδ : Real.log 2 * (δ : ℝ) ≤ 1)
    (D : ℝ) (hD : 0 ≤ D)
    (hpointwise : ∀ (g : SchwartzMap (Euclidean (d + 1)) ℂ)
      (x : Euclidean (d + 1)),
      (⨆ u : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
        ‖sphericalAverage (d + 1)
          ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ
            (psi : Euclidean (d + 1) → ℂ) (𝓕 g)) :
              SchwartzMap (Euclidean (d + 1)) ℂ) : Euclidean (d + 1) → ℂ)
          u.1 x‖) ≤
        ENNReal.ofReal (D * (2 : ℝ) ^ j * ∫ y : Euclidean (d + 1), ‖g y‖))
    {p α r R : ℝ} (hp1 : 1 < p) (hp2 : p < 2)
    (hα : α ≤ 0) (hr : 0 < r) (hrR : r ≤ R)
    (f : SchwartzMap (Euclidean (d + 1)) ℂ)
    (hfsupport : ∀ x, x ∉ euclideanAnnulus (d + 1) r R → f x = 0)
    (s : ℝ) (hs : 0 < s) :
    let A : Set (Euclidean (d + 1)) := euclideanAnnulus (d + 1) r R
    let ν : Measure (Euclidean (d + 1)) := powerWeightedVolume (d + 1) α
    let μ : Measure (Euclidean (d + 1)) := ν.restrict A
    let T : SchwartzMap (Euclidean (d + 1)) ℂ → Euclidean (d + 1) → ℝ :=
      fun g => A.indicator (fun x =>
        (⨆ u : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
          ‖sphericalAverage (d + 1)
            ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ
              (psi : Euclidean (d + 1) → ℂ) (𝓕 g)) :
                SchwartzMap (Euclidean (d + 1)) ℂ) : Euclidean (d + 1) → ℂ)
            u.1 x‖).toReal)
    let B : ℝ := (2 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)
    let C : ℝ := (2 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1)
    let L : ℝ := 8 * Real.log 2 * (δ : ℝ)
    let c₁ : ENNReal := ENNReal.ofReal (D * (2 : ℝ) ^ j) * ν A *
      ((ENNReal.ofReal R) ^ α)⁻¹
    let c₂ : ENNReal := (ENNReal.ofReal r) ^ α * (N : ENNReal) *
      ENNReal.ofReal (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) *
        ((ENNReal.ofReal R) ^ α)⁻¹
    let a₂ : ENNReal :=
      (ENNReal.ofReal ((1 : ℝ) / 4) * (ENNReal.ofReal p)⁻¹ +
        (ENNReal.ofReal (2 - p))⁻¹) *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ
    let a₁ : ENNReal :=
      ((ENNReal.ofReal (p - 1))⁻¹ + (ENNReal.ofReal (3 - p))⁻¹) *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ
    (∫⁻ x, ENNReal.ofReal ((T f x) ^ p) ∂μ) ≤
      ENNReal.ofReal p *
        (4 * c₂ * ((ENNReal.ofReal s) ^ (2 - p) * a₂) +
          2 * c₁ * ((ENNReal.ofReal s) ^ (1 - p) * a₁)) := by
  dsimp only
  let A : Set (Euclidean (d + 1)) := euclideanAnnulus (d + 1) r R
  let ν : Measure (Euclidean (d + 1)) := powerWeightedVolume (d + 1) α
  let μ : Measure (Euclidean (d + 1)) := ν.restrict A
  let T : SchwartzMap (Euclidean (d + 1)) ℂ → Euclidean (d + 1) → ℝ :=
    fun g => A.indicator (fun x =>
      (⨆ u : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
        ‖sphericalAverage (d + 1)
          ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ
            (psi : Euclidean (d + 1) → ℂ) (𝓕 g)) :
              SchwartzMap (Euclidean (d + 1)) ℂ) : Euclidean (d + 1) → ℂ)
          u.1 x‖).toReal)
  let B : ℝ := (2 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)
  let C : ℝ := (2 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1)
  let L : ℝ := 8 * Real.log 2 * (δ : ℝ)
  let c₁ : ENNReal := ENNReal.ofReal (D * (2 : ℝ) ^ j) * ν A *
    ((ENNReal.ofReal R) ^ α)⁻¹
  let c₂ : ENNReal := (ENNReal.ofReal r) ^ α * (N : ENNReal) *
    ENNReal.ofReal (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) *
      ((ENNReal.ofReal R) ^ α)⁻¹
  let a₂ : ENNReal :=
    (ENNReal.ofReal ((1 : ℝ) / 4) * (ENNReal.ofReal p)⁻¹ +
      (ENNReal.ofReal (2 - p))⁻¹) *
        ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ
  let a₁ : ENNReal :=
    ((ENNReal.ofReal (p - 1))⁻¹ + (ENNReal.ofReal (3 - p))⁻¹) *
      ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ
  let 𝒟 : Set (SchwartzMap (Euclidean (d + 1)) ℂ) :=
    {g | ∀ x, x ∉ A → g x = 0}
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  letI : IsFiniteMeasure μ :=
    ⟨by
      dsimp only [μ]
      simpa only [Measure.restrict_apply_univ] using
        (powerWeightedVolume_euclideanAnnulus_lt_top_any
          (d := d + 1) (α := α) hr)⟩
  have hT_nonneg : ∀ g x, 0 ≤ T g x := by
    intro g x
    by_cases hx : x ∈ A
    · simp [T, hx, ENNReal.toReal_nonneg]
    · simp [T, hx]
  have hT_subadd : ∀ ⦃g h : SchwartzMap (Euclidean (d + 1)) ℂ⦄,
      g ∈ 𝒟 → h ∈ 𝒟 → ∀ x, T (g + h) x ≤ T g x + T h x := by
    intro g h _ _ x
    by_cases hx : x ∈ A
    · simp only [T, Set.indicator_of_mem hx]
      exact restricted_smooth_dyadic_sphericalMaximal_add_le E hE psi g h x
    · simp [T, hx]
  have hTmeas : ∀ (g : SchwartzMap (Euclidean (d + 1)) ℂ), g ∈ 𝒟 →
      AEMeasurable (T g) μ := by
    intro g _
    exact ((measurable_restricted_smooth_dyadic_sphericalMaximal E psi g).indicator hA).aemeasurable
  have hstrong_one : ∀ (g : SchwartzMap (Euclidean (d + 1)) ℂ), g ∈ 𝒟 →
      (∫⁻ x, ENNReal.ofReal (T g x) ∂μ) ≤
        c₁ * ∫⁻ x, ENNReal.ofReal ‖(g : Euclidean (d + 1) → ℂ) x‖ ∂μ := by
    intro g hg
    simpa only [A, ν, μ, T, c₁] using
      (smooth_dyadic_annular_lintegral_one_le_of_pointwise_restrict
        hα hr hrR D hD j psi E hpointwise g hg)
  have hstrong_two : ∀ (g : SchwartzMap (Euclidean (d + 1)) ℂ), g ∈ 𝒟 →
      (∫⁻ x, ENNReal.ofReal ((T g x) ^ (2 : ℕ)) ∂μ) ≤
        c₂ * ∫⁻ x, ENNReal.ofReal (‖(g : Euclidean (d + 1) → ℂ) x‖ ^ (2 : ℕ)) ∂μ := by
    intro g hg
    simpa only [A, ν, μ, T, B, C, L, c₂] using
      (smooth_dyadic_annular_lintegral_two_le_of_sharp_restrict
        hd C0 C1 hC0 hC1 hdecay hderiv phi psi hphi_one hphi_zero hphi_norm j
        hpsi hpsi_compact E hE hEne δ N hN hδ hα hr hrR g hg)
  have hf_mem : f ∈ 𝒟 := hfsupport
  have hTf : AEMeasurable (T f) μ := hTmeas f hf_mem
  obtain ⟨low, high, hlow, hhigh, hsplit⟩ :=
    exists_schwartz_rational_low_high_family f
  have hlow_zero (t : ℝ) (x : Euclidean (d + 1)) (hx : x ∉ A) : low t x = 0 := by
    rw [hlow t x, hfsupport x hx]
    simp
  have hlow_mem : ∀ t, low t ∈ 𝒟 := by
    intro t x hx
    exact hlow_zero t x hx
  have hhigh_mem : ∀ t, high t ∈ 𝒟 := by
    intro t x hx
    rw [hhigh t]
    simp only [sub_apply, hfsupport x hx, hlow_zero t x hx, sub_zero]
  have hsplit' : ∀ t, f = low t + high t := by
    intro t
    ext x
    exact hsplit t x
  have hprofiles := measurable_rational_low_high_profile_lintegrals
    f low high hlow hhigh (μ := μ)
  have hlow_tail :
      (∫⁻ t in Ioi (0 : ℝ),
        (∫⁻ x, ENNReal.ofReal (‖low t x‖ ^ (2 : ℕ)) ∂μ) *
          (ENNReal.ofReal t) ^ (p - 3)) ≤ a₂ := by
    dsimp only [a₂]
    apply weighted_low_tail_le_of_two_region_bounds
      (u := fun x : Euclidean (d + 1) => ‖f x‖)
      (low := fun t x => low t x)
    · exact f.continuous.norm.measurable
    · intro x
      exact norm_nonneg _
    · intro t x ht htx
      apply ENNReal.ofReal_le_ofReal
      have h := (rational_low_high_pointwise_tail_bounds f (low t) (high t)
        ht (hlow t) (hhigh t) x).1
      simpa [htx] using h
    · intro t x ht htx
      apply ENNReal.ofReal_le_ofReal
      have h := (rational_low_high_pointwise_tail_bounds f (low t) (high t)
        ht (hlow t) (hhigh t) x).1
      have hnot : ¬ t ≤ ‖f x‖ := not_le_of_gt htx
      simpa [hnot] using h
    · exact hp1
    · exact hp2
  have hhigh_tail :
      (∫⁻ t in Ioi (0 : ℝ),
        (∫⁻ x, ENNReal.ofReal ‖high t x‖ ∂μ) *
          (ENNReal.ofReal t) ^ (p - 2)) ≤ a₁ := by
    dsimp only [a₁]
    apply rational_high_weighted_tail_le
      (u := fun x : Euclidean (d + 1) => ‖f x‖)
      (high := fun t x => high t x)
    · exact f.continuous.norm.measurable
    · intro x
      exact norm_nonneg _
    · have heq : (fun q : ℝ × Euclidean (d + 1) => ENNReal.ofReal ‖high q.1 q.2‖) =
          (fun q : ℝ × Euclidean (d + 1) => ENNReal.ofReal
            ‖f q.2 - ((1 + ‖(q.1⁻¹ : ℝ) • f q.2‖ ^ 2) ^ (-1 : ℝ)) • f q.2‖) := by
        funext q
        rw [hhigh q.1]
        simp only [sub_apply]
        rw [hlow q.1 q.2]
      rw [heq]
      exact (measurable_rational_high_family f).norm.ennreal_ofReal
    · intro t x ht htx
      apply ENNReal.ofReal_le_ofReal
      have h := (rational_low_high_pointwise_tail_bounds f (low t) (high t)
        ht (hlow t) (hhigh t) x).2
      simpa [htx] using h
    · intro t x ht htx
      apply ENNReal.ofReal_le_ofReal
      have h := (rational_low_high_pointwise_tail_bounds f (low t) (high t)
        ht (hlow t) (hhigh t) x).2
      have hnot : ¬ t ≤ ‖f x‖ := not_le_of_gt htx
      simpa [hnot] using h
    · exact hp1
    · exact hp2
  have hlowI_meas : Measurable (fun t : ℝ =>
      ∫⁻ x, ENNReal.ofReal (‖low (s * t) x‖ ^ (2 : ℕ)) ∂μ) :=
    hprofiles.1.comp (measurable_const_mul s)
  have hhighI_meas : Measurable (fun t : ℝ =>
      ∫⁻ x, ENNReal.ofReal ‖high (s * t) x‖ ∂μ) :=
    hprofiles.2.comp (measurable_const_mul s)
  have hlow_tail_scaled :
      (∫⁻ t in Ioi (0 : ℝ),
        (∫⁻ x, ENNReal.ofReal (‖low (s * t) x‖ ^ (2 : ℕ)) ∂μ) *
          (ENNReal.ofReal t) ^ (p - 3)) ≤
        (ENNReal.ofReal s) ^ (2 - p) * a₂ := by
    calc
      (∫⁻ t in Ioi (0 : ℝ),
        (∫⁻ x, ENNReal.ofReal (‖low (s * t) x‖ ^ (2 : ℕ)) ∂μ) *
          (ENNReal.ofReal t) ^ (p - 3)) =
          (ENNReal.ofReal s) ^ (2 - p) *
            (∫⁻ u in Ioi (0 : ℝ),
              (∫⁻ x, ENNReal.ofReal (‖low u x‖ ^ (2 : ℕ)) ∂μ) *
                (ENNReal.ofReal u) ^ (p - 3)) :=
        lintegral_Ioi_comp_mul_low_weight
          (fun u => ∫⁻ x, ENNReal.ofReal (‖low u x‖ ^ (2 : ℕ)) ∂μ)
          hprofiles.1 s hs p
      _ ≤ (ENNReal.ofReal s) ^ (2 - p) * a₂ :=
        mul_le_mul_right hlow_tail _
  have hhigh_tail_scaled :
      (∫⁻ t in Ioi (0 : ℝ),
        (∫⁻ x, ENNReal.ofReal ‖high (s * t) x‖ ∂μ) *
          (ENNReal.ofReal t) ^ (p - 2)) ≤
        (ENNReal.ofReal s) ^ (1 - p) * a₁ := by
    calc
      (∫⁻ t in Ioi (0 : ℝ),
        (∫⁻ x, ENNReal.ofReal ‖high (s * t) x‖ ∂μ) *
          (ENNReal.ofReal t) ^ (p - 2)) =
          (ENNReal.ofReal s) ^ (1 - p) *
            (∫⁻ u in Ioi (0 : ℝ),
              (∫⁻ x, ENNReal.ofReal ‖high u x‖ ∂μ) *
                (ENNReal.ofReal u) ^ (p - 2)) :=
        lintegral_Ioi_comp_mul_high_weight
          (fun u => ∫⁻ x, ENNReal.ofReal ‖high u x‖ ∂μ)
          hprofiles.2 s hs p
      _ ≤ (ENNReal.ofReal s) ^ (1 - p) * a₁ :=
        mul_le_mul_right hhigh_tail _
  exact marcinkiewicz_one_two_on_additive_split
    (α := Euclidean (d + 1)) (E := ℂ)
    (F := SchwartzMap (Euclidean (d + 1)) ℂ) (μ := μ)
    𝒟 (fun g => (g : Euclidean (d + 1) → ℂ)) T hT_nonneg hT_subadd hTmeas
    c₁ c₂ hstrong_one hstrong_two hp1 hp2 f hTf
    (fun t => low (s * t)) (fun t => high (s * t))
    (fun t => hlow_mem (s * t)) (fun t => hhigh_mem (s * t))
    (fun t => hsplit' (s * t)) hlowI_meas hhighI_meas
    ((ENNReal.ofReal s) ^ (2 - p) * a₂)
    ((ENNReal.ofReal s) ^ (1 - p) * a₁)
    hlow_tail_scaled hhigh_tail_scaled

/-- The preceding interpolation estimate with its physical-space endpoint
supplied by the literal smooth dyadic kernel theorem.  The witness `D` depends
only on the fixed low-pass cutoff `phi`, not on the entropy cover or input. -/
theorem exists_smooth_dyadic_annular_lintegral_rpow_le_of_sharp
    {d : Nat} (hd : 2 ≤ d) (C0 C1 : ℝ) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ ξ : Euclidean (d + 1), 1 ≤ ‖ξ‖ →
      ‖surfaceFourier (d + 1) ξ‖ ≤ C0 / ‖ξ‖ ^ ((d : ℝ) / 2))
    (hderiv : ∀ ξ : Euclidean (d + 1), ∀ u : ℝ, 1 ≤ ‖ξ‖ →
      u ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun z : ℝ => surfaceFourier (d + 1) (z • ξ)) u‖ ≤
        C1 / ‖ξ‖ ^ ((d : ℝ) / 2 - 1))
    (phi psi : SchwartzMap (Euclidean (d + 1)) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ, ‖phi ξ‖ ≤ 1) (j : Nat)
    (hpsi : ∀ ξ : Euclidean (d + 1),
      psi ξ = phi (((2 : ℝ) ^ (j + 1))⁻¹ • ξ) -
        phi (((2 : ℝ) ^ j)⁻¹ • ξ))
    (hpsi_compact : HasCompactSupport (psi : Euclidean (d + 1) → ℂ))
    (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    (δ : ℝ≥0) (N : ℕ) (hN : multiplicativeEntropy E δ ≤ N)
    (hδ : Real.log 2 * (δ : ℝ) ≤ 1)
    {p α r R : ℝ} (hp1 : 1 < p) (hp2 : p < 2)
    (hα : α ≤ 0) (hr : 0 < r) (hrR : r ≤ R)
    (f : SchwartzMap (Euclidean (d + 1)) ℂ)
    (hfsupport : ∀ x, x ∉ euclideanAnnulus (d + 1) r R → f x = 0)
    (s : ℝ) (hs : 0 < s) :
    ∃ D : ℝ, 0 < D ∧
      let A : Set (Euclidean (d + 1)) := euclideanAnnulus (d + 1) r R
      let ν : Measure (Euclidean (d + 1)) := powerWeightedVolume (d + 1) α
      let μ : Measure (Euclidean (d + 1)) := ν.restrict A
      let T : SchwartzMap (Euclidean (d + 1)) ℂ → Euclidean (d + 1) → ℝ :=
        fun g => A.indicator (fun x =>
          (⨆ u : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
            ‖sphericalAverage (d + 1)
              ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ
                (psi : Euclidean (d + 1) → ℂ) (𝓕 g)) :
                  SchwartzMap (Euclidean (d + 1)) ℂ) : Euclidean (d + 1) → ℂ)
              u.1 x‖).toReal)
      let B : ℝ := (2 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)
      let C : ℝ := (2 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1)
      let L : ℝ := 8 * Real.log 2 * (δ : ℝ)
      let c₁ : ENNReal := ENNReal.ofReal (D * (2 : ℝ) ^ j) * ν A *
        ((ENNReal.ofReal R) ^ α)⁻¹
      let c₂ : ENNReal := (ENNReal.ofReal r) ^ α * (N : ENNReal) *
        ENNReal.ofReal (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) *
          ((ENNReal.ofReal R) ^ α)⁻¹
      let a₂ : ENNReal :=
        (ENNReal.ofReal ((1 : ℝ) / 4) * (ENNReal.ofReal p)⁻¹ +
          (ENNReal.ofReal (2 - p))⁻¹) *
            ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ
      let a₁ : ENNReal :=
        ((ENNReal.ofReal (p - 1))⁻¹ + (ENNReal.ofReal (3 - p))⁻¹) *
            ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ
      (∫⁻ x, ENNReal.ofReal ((T f x) ^ p) ∂μ) ≤
        ENNReal.ofReal p *
          (4 * c₂ * ((ENNReal.ofReal s) ^ (2 - p) * a₂) +
            2 * c₁ * ((ENNReal.ofReal s) ^ (1 - p) * a₁)) := by
  obtain ⟨D, hD, hphysical⟩ :=
    exists_iSup_ennreal_norm_smooth_dyadic_sphericalAverage_le_integral
      (d := d + 1) (Nat.succ_pos d) phi
  refine ⟨D, hD, ?_⟩
  exact smooth_dyadic_annular_lintegral_rpow_le_of_pointwise
    hd C0 C1 hC0 hC1 hdecay hderiv phi psi hphi_one hphi_zero hphi_norm j
    hpsi hpsi_compact E hE hEne δ N hN hδ D hD.le
    (fun g x => hphysical j psi hpsi E hE g x)
    hp1 hp2 hα hr hrR f hfsupport s hs

end

end Codex.Spherical.PowerWeights.AnnularInterpolation