  have htheta_first : phi ((8 * P)⁻¹ • xi) = 1 :=
    hphi_one _ htheta_first_small
  have htheta_second : phi ((P / 4)⁻¹ • xi) = 0 :=
    hphi_zero _ htheta_second_large
  rw [htheta xi, htheta_first, htheta_second, sub_zero, mul_one]

/-- The preceding short-radius estimate with its auxiliary compact cutoff
removed.  This is the literal moving multiplier used by the relative
frequency cutoff reassembly. -/
theorem measurable_and_lintegral_iSup_literal_relative_dyadic_moving_bandpass_interval_of_sharp
    {d : Nat} (hd : 2 ≤ d) (C0 C1 : ℝ) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ xi : Euclidean (d + 1), 1 ≤ ‖xi‖ →
      ‖surfaceFourier (d + 1) xi‖ ≤ C0 / ‖xi‖ ^ ((d : ℝ) / 2))
    (hderiv : ∀ xi : Euclidean (d + 1), ∀ r : ℝ, 1 ≤ ‖xi‖ →
      r ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun s : ℝ => surfaceFourier (d + 1) (s • xi)) r‖ ≤
        C1 / ‖xi‖ ^ ((d : ℝ) / 2 - 1))
    (phi f : SchwartzMap (Euclidean (d + 1)) ℂ)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    {a b : ℝ} (hab : a ≤ b) (ha : 1 ≤ a) (hb : b ≤ 2) :
    let F : ℝ → Euclidean (d + 1) → ℂ := fun s x =>
      𝓕⁻ (fun xi : Euclidean (d + 1) =>
        surfaceFourier (d + 1) (-s • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) *
          𝓕 (f : Euclidean (d + 1) → ℂ) xi) x
    let B : ℝ := (4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)
    let S : ℝ := (4 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1)
    let U : ℝ := (12 * C0 *
      ‖((SchwartzMap.fderivCLM ℂ (Euclidean (d + 1)) ℂ) phi).toBoundedContinuousFunction‖) /
        (dyadicScale j) ^ ((d : ℝ) / 2)
    let C : ℝ := 2 * (S + U)
    let J : ℝ := ∫ x : Euclidean (d + 1), ‖𝓕 (f : Euclidean (d + 1) → ℂ) x‖ ^ 2
    Measurable (fun x : Euclidean (d + 1) =>
      ⨆ r : Icc a b, ENNReal.ofReal (‖F r.1 x‖ ^ 2)) ∧
      (∫⁻ x : Euclidean (d + 1),
        ⨆ r : Icc a b, ENNReal.ofReal (‖F r.1 x‖ ^ 2)) ≤
        ENNReal.ofReal ((2 * B ^ 2 + 2 * (b - a) ^ 2 * C ^ 2) * J) := by
  dsimp only
  obtain ⟨theta, htheta_compact, htheta_norm, htheta_active⟩ :=
    exists_compact_cutoff_one_on_relative_dyadic_bandpass
      phi hphi_one hphi_zero hphi_norm j
  let F : ℝ → Euclidean (d + 1) → ℂ := fun s x =>
    𝓕⁻ (fun xi : Euclidean (d + 1) =>
      surfaceFourier (d + 1) (-s • xi) *
        (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
          phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) *
        𝓕 (f : Euclidean (d + 1) → ℂ) xi) x
  let Ftheta : ℝ → Euclidean (d + 1) → ℂ := fun s x =>
    𝓕⁻ (fun xi : Euclidean (d + 1) =>
      surfaceFourier (d + 1) (-s • xi) *
        (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
          phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) * theta xi *
        𝓕 (f : Euclidean (d + 1) → ℂ) xi) x
  have hFtheta_eq (s : ℝ) (hs : s ∈ Icc a b) : Ftheta s = F s := by
    funext x
    apply congrArg (fun h : Euclidean (d + 1) → ℂ => 𝓕⁻ h x)
    funext xi
    have hs' : s ∈ Icc (1 : ℝ) 2 := ⟨ha.trans hs.1, hs.2.trans hb⟩
    calc
      surfaceFourier (d + 1) (-s • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) * theta xi *
          𝓕 (f : Euclidean (d + 1) → ℂ) xi =
        surfaceFourier (d + 1) (-s • xi) *
          ((phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) * theta xi) *
          𝓕 (f : Euclidean (d + 1) → ℂ) xi := by ring
      _ = surfaceFourier (d + 1) (-s • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) *
          𝓕 (f : Euclidean (d + 1) → ℂ) xi := by
        rw [htheta_active s hs' xi]
  have hlocal :=
    measurable_and_lintegral_iSup_relative_dyadic_moving_bandpass_interval_of_sharp
      hd C0 C1 hC0 hC1 hdecay hderiv phi theta f hphi_one hphi_zero hphi_norm
      htheta_compact htheta_norm j hab ha hb
  have hlocal' :
      Measurable (fun x : Euclidean (d + 1) =>
        ⨆ r : Icc a b, ENNReal.ofReal (‖Ftheta r.1 x‖ ^ 2)) ∧
        (∫⁻ x : Euclidean (d + 1),
          ⨆ r : Icc a b, ENNReal.ofReal (‖Ftheta r.1 x‖ ^ 2)) ≤
          ENNReal.ofReal
            ((2 * ((4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)) ^ 2 +
              2 * (b - a) ^ 2 *
                (2 * ((4 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1) +
                  (12 * C0 *
                    ‖((SchwartzMap.fderivCLM ℂ (Euclidean (d + 1)) ℂ) phi).toBoundedContinuousFunction‖) /
                    (dyadicScale j) ^ ((d : ℝ) / 2))) ^ 2) *
              ∫ xi : Euclidean (d + 1), ‖𝓕 (f : Euclidean (d + 1) → ℂ) xi‖ ^ 2) := by
    simpa only [Ftheta] using hlocal
  have hQeq : (fun x : Euclidean (d + 1) =>
      ⨆ r : Icc a b, ENNReal.ofReal (‖F r.1 x‖ ^ 2)) =
      fun x : Euclidean (d + 1) =>
        ⨆ r : Icc a b, ENNReal.ofReal (‖Ftheta r.1 x‖ ^ 2) := by
    funext x
    apply iSup_congr
    intro r
    rw [hFtheta_eq r.1 r.2]
  constructor
  · rw [hQeq]
    exact hlocal'.1
  · rw [hQeq]
    simpa only [F, Ftheta] using hlocal'.2

/-- Measurability of the literal moving-band square maximal function on an
arbitrary radius subset of `[1,2]`.  The auxiliary cutoff is used only to
obtain joint continuity; it cancels identically on the active band. -/
theorem measurable_iSup_ennreal_norm_sq_literal_relative_dyadic_moving_bandpass
    {d : Nat} (phi f : SchwartzMap (Euclidean (d + 1)) ℂ)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2) :
    Measurable (fun x : Euclidean (d + 1) =>
      ⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
        (‖𝓕⁻ (fun xi : Euclidean (d + 1) =>
          surfaceFourier (d + 1) (-r.1 • xi) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
            𝓕 (f : Euclidean (d + 1) → ℂ) xi) x‖ ^ 2)) := by
  obtain ⟨theta, htheta_compact, htheta_norm, htheta_active⟩ :=
    exists_compact_cutoff_one_on_relative_dyadic_bandpass
      phi hphi_one hphi_zero hphi_norm j
  let F : ℝ → Euclidean (d + 1) → ℂ := fun s x =>
    𝓕⁻ (fun xi : Euclidean (d + 1) =>
      surfaceFourier (d + 1) (-s • xi) *
        (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
          phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) *
        𝓕 (f : Euclidean (d + 1) → ℂ) xi) x
  let Ftheta : ℝ → Euclidean (d + 1) → ℂ := fun s x =>
    𝓕⁻ (fun xi : Euclidean (d + 1) =>
      surfaceFourier (d + 1) (-s • xi) *
        (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
          phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) * theta xi *
        𝓕 (f : Euclidean (d + 1) → ℂ) xi) x
  have hFtheta_eq (s : ℝ) (hs : s ∈ Icc (1 : ℝ) 2) : Ftheta s = F s := by
    funext x
    apply congrArg (fun h : Euclidean (d + 1) → ℂ => 𝓕⁻ h x)
    funext xi
    calc
      surfaceFourier (d + 1) (-s • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) * theta xi *
          𝓕 (f : Euclidean (d + 1) → ℂ) xi =
        surfaceFourier (d + 1) (-s • xi) *
          ((phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) * theta xi) *
          𝓕 (f : Euclidean (d + 1) → ℂ) xi := by ring
      _ = surfaceFourier (d + 1) (-s • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) *
          𝓕 (f : Euclidean (d + 1) → ℂ) xi := by
        rw [htheta_active s hs xi]
  have hjoint := continuous_and_hasDerivAt_fourierInv_relative_dyadic_bandpass
    phi theta f htheta_compact j
  dsimp only at hjoint
  have hcont : Continuous (Function.uncurry Ftheta) := by
    simpa only [Ftheta] using hjoint.1
  have hmeas : Measurable (⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
      fun x : Euclidean (d + 1) => ENNReal.ofReal (‖Ftheta r.1 x‖ ^ 2)) := by
    apply measurable_iSup_of_lowerSemicontinuous
    · intro r
      exact (ENNReal.continuous_ofReal.comp
        ((hcont.comp (continuous_const.prodMk continuous_id)).norm.pow 2)).measurable
    · intro x
      exact (ENNReal.continuous_ofReal.comp
        ((hcont.comp (continuous_subtype_val.prodMk continuous_const)).norm.pow 2)).lowerSemicontinuous
  have hmeas' : Measurable (fun x : Euclidean (d + 1) =>
      ⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal (‖Ftheta r.1 x‖ ^ 2)) := by
    rw [show (fun x : Euclidean (d + 1) =>
        ⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal (‖Ftheta r.1 x‖ ^ 2)) =
        ⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
          fun x : Euclidean (d + 1) => ENNReal.ofReal (‖Ftheta r.1 x‖ ^ 2) by
      funext x
      exact (iSup_apply
        (f := fun r : ↥(E ∩ Ioi (0 : ℝ)) =>
          fun x : Euclidean (d + 1) => ENNReal.ofReal (‖Ftheta r.1 x‖ ^ 2))
        (a := x)).symm]
    exact hmeas
  have heq : (fun x : Euclidean (d + 1) =>
      ⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal (‖F r.1 x‖ ^ 2)) =
      fun x : Euclidean (d + 1) =>
        ⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal (‖Ftheta r.1 x‖ ^ 2) := by
    funext x
    apply iSup_congr
    intro r
    rw [hFtheta_eq r.1 (hE r.2.1)]
  rw [show (fun x : Euclidean (d + 1) =>
      ⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
        (‖𝓕⁻ (fun xi : Euclidean (d + 1) =>
          surfaceFourier (d + 1) (-r.1 • xi) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
            𝓕 (f : Euclidean (d + 1) → ℂ) xi) x‖ ^ 2)) =
        fun x : Euclidean (d + 1) =>
          ⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal (‖F r.1 x‖ ^ 2) by
      rfl,
    heq]
  exact hmeas'

end

