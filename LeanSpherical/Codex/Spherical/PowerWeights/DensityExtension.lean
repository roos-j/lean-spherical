/-- The weighted version of the reusable Schwartz-core extension principle.
It is deliberately parametrized by the measure, since density of Schwartz
functions requires the three stated regularity hypotheses. -/
theorem exists_schwartzLp_extension_of_a_priori_bound_measure
    {d : ℕ} {q : ENNReal} [Fact (1 ≤ q)] (hqtop : q ≠ ⊤)
    (μ : Measure (Euclidean d)) [μ.HasTemperateGrowth]
    [IsFiniteMeasureOnCompacts μ] [μ.IsOpenPosMeasure]
    (T : SchwartzMap (Euclidean d) ℂ → Lp ℝ q μ)
    (C : ℝ) (hC : 0 ≤ C) (hT0 : T 0 = 0)
    (hdiff : ∀ f g, dist (T f) (T g) ≤ ‖T (f - g)‖)
    (hbound : ∀ f, ‖T f‖ ≤ C * ‖f.toLp q μ‖) :
    ∃ Tbar : Lp ℂ q μ → Lp ℝ q μ,
      (∀ f, Tbar ((SchwartzMap.toLpCLM ℝ ℂ q μ) f) = T f) ∧
        LipschitzWith C.toNNReal Tbar ∧ ∀ F, ‖Tbar F‖ ≤ C * ‖F‖ := by
  apply exists_lipschitz_extension_of_denseRange_norm_bound
    (e := fun f : SchwartzMap (Euclidean d) ℂ =>
      (SchwartzMap.toLpCLM ℝ ℂ q μ) f)
    (a0 := (0 : SchwartzMap (Euclidean d) ℂ))
  · exact SchwartzMap.denseRange_toLpCLM hqtop
  · simpa only [SchwartzMap.toLpCLM_apply] using
      (SchwartzMap.injective_toLp (E := Euclidean d) (F := ℂ) q μ)
  · exact hC
  · change (SchwartzMap.toLpCLM ℝ ℂ q μ) 0 = 0
    exact map_zero _
  · exact hT0
  · intro f g
    calc
      dist (T f) (T g) ≤ ‖T (f - g)‖ := hdiff f g
      _ ≤ C * ‖(f - g).toLp q μ‖ := hbound (f - g)
      _ = C * dist ((SchwartzMap.toLpCLM ℝ ℂ q μ) f)
          ((SchwartzMap.toLpCLM ℝ ℂ q μ) g) := by
        change C * ‖(SchwartzMap.toLpCLM ℝ ℂ q μ) (f - g)‖ = _
        rw [map_sub, ← dist_eq_norm_sub]

