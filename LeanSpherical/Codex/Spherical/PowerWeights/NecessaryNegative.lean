    (n : ℕ) (hn : 0 < n) {α t D : ℝ}
    (hα : α < 0) (ht : 0 < t) (hD : 0 < D)
    (hsmall : t * D ≤ (1 : ℝ)) :
    (ENNReal.ofReal (1 - t * D / 2)) ^ α *
        (volume (ball (0 : Euclidean n) (t / 16)) *
          ENNReal.ofReal (t * D)) ≤
      negativeLargeInputConstant n α * (ENNReal.ofReal t) ^ (n + 1) *
        ENNReal.ofReal D := by
  have hbase : (1 : ℝ) / 2 ≤ 1 - t * D / 2 := by linarith
  have hbasepos : 0 < 1 - t * D / 2 := lt_of_lt_of_le (by norm_num) hbase
  have hweightReal : (1 - t * D / 2) ^ α ≤ ((1 : ℝ) / 2) ^ α :=
    Real.rpow_le_rpow_of_nonpos (by norm_num) hbase hα.le
  have hweight : (ENNReal.ofReal (1 - t * D / 2)) ^ α ≤
      (ENNReal.ofReal ((1 : ℝ) / 2)) ^ α := by
    rw [ENNReal.ofReal_rpow_of_pos hbasepos,
      ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 1 / 2)]
    exact ENNReal.ofReal_le_ofReal hweightReal
  have hvolbase : ENNReal.ofReal (t / 16) =
      ENNReal.ofReal t * ENNReal.ofReal ((1 : ℝ) / 16) := by
    rw [show t / 16 = t * ((1 : ℝ) / 16) by ring,
      ENNReal.ofReal_mul ht.le]
  have hvol : volume (ball (0 : Euclidean n) (t / 16)) =
      (ENNReal.ofReal t) ^ n *
        ((ENNReal.ofReal ((1 : ℝ) / 16)) ^ n *
          volume (ball (0 : Euclidean n) 1)) := by
    rw [volume_ball_scale hn, hvolbase, mul_pow]
    ring
  have hthick : ENNReal.ofReal (t * D) =
      ENNReal.ofReal t * ENNReal.ofReal D :=
    ENNReal.ofReal_mul ht.le
  have htpow : (ENNReal.ofReal t) ^ n * ENNReal.ofReal t =
      (ENNReal.ofReal t) ^ (n + 1) := by
    rw [← pow_succ]
  unfold negativeLargeInputConstant
  calc
    (ENNReal.ofReal (1 - t * D / 2)) ^ α *
        (volume (ball (0 : Euclidean n) (t / 16)) *
          ENNReal.ofReal (t * D)) ≤
        (ENNReal.ofReal ((1 : ℝ) / 2)) ^ α *
          (volume (ball (0 : Euclidean n) (t / 16)) *
            ENNReal.ofReal (t * D)) := by gcongr
    _ = (ENNReal.ofReal ((1 : ℝ) / 2)) ^ α *
          ((ENNReal.ofReal ((1 : ℝ) / 16)) ^ n *
            volume (ball (0 : Euclidean n) 1)) *
          ((ENNReal.ofReal t) ^ n * ENNReal.ofReal t) * ENNReal.ofReal D := by
            rw [hvol, hthick]
            ring
    _ = (ENNReal.ofReal ((1 : ℝ) / 2)) ^ α *
          ((ENNReal.ofReal ((1 : ℝ) / 16)) ^ n *
            volume (ball (0 : Euclidean n) 1)) *
          (ENNReal.ofReal t) ^ (n + 1) * ENNReal.ofReal D := by rw [htpow]

private theorem negativeCapConstant_pos (n : ℕ) (hn : 2 ≤ n) :
    0 < negativeCapConstant n := by
  unfold negativeCapConstant
  have hnum : 0 < ENNReal.ofReal (surfaceMass n) *
      (ENNReal.ofReal ((1 : ℝ) / 256) ^ (n - 2) *
        ENNReal.ofReal ((1 : ℝ) / 65536)) := by
    apply ENNReal.mul_pos
    · exact (ENNReal.ofReal_pos.mpr (surfaceMass_pos (by omega))).ne'
    · have hsub : 0 < ENNReal.ofReal ((1 : ℝ) / 256) ^ (n - 2) *
          ENNReal.ofReal ((1 : ℝ) / 65536) := by
        apply ENNReal.mul_pos
        · exact (ENNReal.pow_pos (ENNReal.ofReal_pos.mpr (by norm_num)) _).ne'
        · exact (ENNReal.ofReal_pos.mpr (by norm_num)).ne'
      exact hsub.ne'
  apply ENNReal.div_pos
  · exact hnum.ne'
  · exact ENNReal.ofReal_ne_top

private theorem negativeCapConstant_ne_top (n : ℕ) :
    negativeCapConstant n ≠ (∞ : ℝ≥0∞) := by
  unfold negativeCapConstant
  apply ENNReal.div_ne_top
  · apply ENNReal.mul_ne_top
    · exact ENNReal.ofReal_ne_top
    · apply ENNReal.mul_ne_top
      · exact ENNReal.pow_ne_top ENNReal.ofReal_ne_top
      · exact ENNReal.ofReal_ne_top
  · exact (ENNReal.ofReal_pos.mpr
      (surfaceMass_pos (show 0 < n + 1 by omega))).ne'

private theorem negativeOutputConstant_pos (n : ℕ) (hn : 0 < n) (α : ℝ) :
    0 < negativeOutputConstant n α := by
  unfold negativeOutputConstant
  have hfirst : (ENNReal.ofReal (2 : ℝ)) ^ α ≠ 0 :=
    (ENNReal.rpow_pos (ENNReal.ofReal_pos.mpr (by norm_num))
      ENNReal.ofReal_ne_top).ne'
  have hsecond : ENNReal.ofReal ((1 : ℝ) / 128) ^ n *
      volume (ball (0 : Euclidean n) 1) *
        ENNReal.ofReal (Real.log 2 / 512) ≠ 0 := by
    have hpos : 0 < ENNReal.ofReal ((1 : ℝ) / 128) ^ n *
        volume (ball (0 : Euclidean n) 1) *
          ENNReal.ofReal (Real.log 2 / 512) := by
      apply ENNReal.mul_pos
      · have hsub : 0 < ENNReal.ofReal ((1 : ℝ) / 128) ^ n *
            volume (ball (0 : Euclidean n) 1) := by
          apply ENNReal.mul_pos
          · exact (ENNReal.pow_pos (ENNReal.ofReal_pos.mpr (by norm_num)) _).ne'
          · exact (Metric.measure_ball_pos volume (0 : Euclidean n) (by norm_num)).ne'
        exact hsub.ne'
      · exact (ENNReal.ofReal_pos.mpr
          (show 0 < Real.log 2 / 512 by positivity)).ne'
    exact hpos.ne'
  apply ENNReal.mul_pos
  · exact hfirst
  · exact hsecond

private theorem negativeOutputConstant_ne_top (n : ℕ) (α : ℝ) :
    negativeOutputConstant n α ≠ (∞ : ℝ≥0∞) := by
  unfold negativeOutputConstant
  apply ENNReal.mul_ne_top
  · exact ENNReal.rpow_ne_top_of_ne_zero
      (ENNReal.ofReal_pos.mpr (by norm_num)).ne' ENNReal.ofReal_ne_top
  · apply ENNReal.mul_ne_top
    · apply ENNReal.mul_ne_top
      · exact ENNReal.pow_ne_top ENNReal.ofReal_ne_top
      · exact (measure_ball_lt_top (μ := volume) (x := (0 : Euclidean n))
          (r := (1 : ℝ))).ne
    · exact ENNReal.ofReal_ne_top

private theorem negativeSmallInputConstant_ne_top (n : ℕ) (α : ℝ) :
    negativeSmallInputConstant n α ≠ (∞ : ℝ≥0∞) := by
  unfold negativeSmallInputConstant
  apply ENNReal.mul_ne_top
  · exact ENNReal.rpow_ne_top_of_ne_zero
      (ENNReal.ofReal_pos.mpr (by norm_num)).ne' ENNReal.ofReal_ne_top
  · apply ENNReal.mul_ne_top
    · apply ENNReal.mul_ne_top
      · exact ENNReal.pow_ne_top ENNReal.ofReal_ne_top
      · exact (measure_ball_lt_top (μ := volume) (x := (0 : Euclidean n))
          (r := (1 : ℝ))).ne
    · exact ENNReal.ofReal_ne_top

private theorem negativeLargeInputConstant_ne_top (n : ℕ) (α : ℝ) :
    negativeLargeInputConstant n α ≠ (∞ : ℝ≥0∞) := by
  unfold negativeLargeInputConstant
  apply ENNReal.mul_ne_top
  · exact ENNReal.rpow_ne_top_of_ne_zero
      (ENNReal.ofReal_pos.mpr (by norm_num)).ne' ENNReal.ofReal_ne_top
  · apply ENNReal.mul_ne_top
    · exact ENNReal.pow_ne_top ENNReal.ofReal_ne_top
    · exact (measure_ball_lt_top (μ := volume) (x := (0 : Euclidean n))
        (r := (1 : ℝ))).ne

private theorem small_normalized_cap_conditions
    {δ D r : ℝ} (hδ : 0 < δ) (hD : 0 < D) (hδD : δ ≤ D)
    (hparabolic : D ^ 2 ≤ δ / 128) (hr0 : 0 ≤ r) (hr2 : r ≤ 2)
    (hrdist : |r - 1| ≤ D) :
    D / 128 + r * (δ / (128 * D)) ≤ δ / (32 * D) ∧
      (D / 128) ^ 2 + 2 * r * (D / 128) * (δ / (128 * D)) +
          8 * r * (|1 - r| + Real.log 2 * δ / 1024) *
              (δ / (128 * D)) ^ 2 +
          2 * Real.log 2 * δ / 1024 +
            (Real.log 2 * δ / 1024) ^ 2 < δ ∧
      0 < 1 - Real.log 2 * δ / 1024 -
        4 * r * (δ / (128 * D)) ^ 2 := by
  let q : ℝ := δ / D
  have hq : 0 < q := by dsimp only [q]; positivity
  have hqone : q ≤ 1 := by
    dsimp only [q]
    exact (div_le_one₀ hD).mpr hδD
  have hDq : D ≤ q / 128 := by
    calc
      D = D ^ 2 / D := by field_simp
      _ ≤ (δ / 128) / D :=
        div_le_div_of_nonneg_right hparabolic hD.le
      _ = q / 128 := by
        dsimp only [q]
        field_simp
  have hDleq : D ≤ q := hDq.trans (by nlinarith)
  have hlog : 0 < Real.log 2 := Real.log_pos one_lt_two
  have hlogle : Real.log 2 ≤ 1 := by
    nlinarith [Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)]
  have hδsmall : δ ≤ (1 : ℝ) / 128 := by
    have hDsmall : D ≤ (1 : ℝ) / 128 := by nlinarith [hparabolic]
    exact hδD.trans hDsmall
  have hbreal : 0 ≤ Real.log 2 * δ / 1024 := by positivity
  have hble : Real.log 2 * δ / 1024 ≤ D := by
    have hlogdelta : Real.log 2 * δ ≤ δ := by
      simpa using mul_le_mul_of_nonneg_right hlogle hδ.le
    calc
      Real.log 2 * δ / 1024 ≤ δ / 1024 :=
        div_le_div_of_nonneg_right hlogdelta (by norm_num)
      _ ≤ D := by nlinarith
  have hbq : Real.log 2 * δ / 1024 ≤ q * D / 1024 := by
    have hlogdelta : Real.log 2 * δ ≤ δ := by
      simpa using mul_le_mul_of_nonneg_right hlogle hδ.le
    calc
      Real.log 2 * δ / 1024 ≤ δ / 1024 :=
        div_le_div_of_nonneg_right hlogdelta (by norm_num)
      _ = q * D / 1024 := by
        dsimp only [q]
        field_simp
  have hbsmall : Real.log 2 * δ / 1024 ≤ (1 : ℝ) / 1024 := by
    have hlogdelta : Real.log 2 * δ ≤ δ := by
      simpa using mul_le_mul_of_nonneg_right hlogle hδ.le
    calc
      Real.log 2 * δ / 1024 ≤ δ / 1024 :=
        div_le_div_of_nonneg_right hlogdelta (by norm_num)
      _ ≤ (1 : ℝ) / 1024 := by nlinarith
  have hhor : D / 128 + r * (δ / (128 * D)) ≤ δ / (32 * D) := by
    have hDratio : D / 128 ≤ δ / (128 * D) := by
      calc
        D / 128 ≤ q / 128 := div_le_div_of_nonneg_right hDleq (by norm_num)
        _ = δ / (128 * D) := by
          dsimp only [q]
          field_simp
    have hrterm : r * (δ / (128 * D)) ≤ 2 * (δ / (128 * D)) := by
      gcongr
    have hrhs : δ / (32 * D) = 4 * (δ / (128 * D)) := by
      field_simp
      norm_num
    rw [hrhs]
    nlinarith
  refine ⟨hhor, ?_, ?_⟩
  · have hrho : (D / 128) ^ 2 ≤ q * D / 1024 := by
      nlinarith [mul_nonneg hD.le (sub_nonneg.mpr hDq)]
    have hqidentity : δ / (128 * D) = q / 128 := by
      dsimp only [q]
      field_simp
    have hcross : 2 * r * (D / 128) * (δ / (128 * D)) ≤ q * D / 1024 := by
      rw [hqidentity]
      calc
        2 * r * (D / 128) * (q / 128) ≤
        2 * 2 * (D / 128) * (q / 128) := by gcongr
        _ = q * D / 4096 := by ring
        _ ≤ q * D / 1024 := by nlinarith [mul_nonneg hq.le hD.le]
    have hsum : |1 - r| + Real.log 2 * δ / 1024 ≤ 2 * D := by
      rw [abs_sub_comm]
      nlinarith
    have hqSq : q ^ 2 ≤ q := by
      nlinarith [mul_nonneg hq.le (sub_nonneg.mpr hqone)]
    have hquad : 8 * r * (|1 - r| + Real.log 2 * δ / 1024) *
        (δ / (128 * D)) ^ 2 ≤ q * D / 256 := by
      rw [hqidentity]
      calc
        8 * r * (|1 - r| + Real.log 2 * δ / 1024) * (q / 128) ^ 2 ≤
            8 * 2 * (2 * D) * (q / 128) ^ 2 := by gcongr
        _ = q ^ 2 * D / 512 := by ring
        _ ≤ q * D / 512 := by
          nlinarith [mul_nonneg hD.le (sub_nonneg.mpr hqone)]
        _ ≤ q * D / 256 := by nlinarith [mul_nonneg hq.le hD.le]
    have hlinear : 2 * Real.log 2 * δ / 1024 ≤ q * D / 512 := by
      nlinarith [hbq]
    have hsq : (Real.log 2 * δ / 1024) ^ 2 ≤ q * D / 1024 := by
      have hbleone : Real.log 2 * δ / 1024 ≤ 1 :=
        hbsmall.trans (by norm_num)
      have hsqle : (Real.log 2 * δ / 1024) ^ 2 ≤
          Real.log 2 * δ / 1024 := by
        nlinarith [mul_nonneg hbreal (sub_nonneg.mpr hbleone)]
      exact hsqle.trans hbq
    have hqD : q * D = δ := by
      dsimp only [q]
      field_simp
    nlinarith only [hrho, hcross, hquad, hlinear, hsq, hqD, hδ]
  · have hqidentity : δ / (128 * D) = q / 128 := by
      dsimp only [q]
      field_simp
    rw [hqidentity]
    have hqsq : (q / 128) ^ 2 ≤ (1 : ℝ) / 16384 := by
      nlinarith [mul_nonneg hq.le (sub_nonneg.mpr hqone)]
    nlinarith only [hbsmall, hr2, hqsq]

private theorem normalized_small_local_entropy_bound
    (n : ℕ) (hn : 2 ≤ n) {E : Set ℝ} {p α C : ℝ}
    (hstrong : ∀ f : SchwartzMap (Euclidean (n + 1)) ℂ,
      MemLp (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p)
        (powerWeightedVolume (n + 1) α) →
        MemLp (restrictedNormalizedSphericalMaximal (n + 1) E
          (f : Euclidean (n + 1) → ℂ)) (ENNReal.ofReal p)
          (powerWeightedVolume (n + 1) α) ∧
        eLpNorm (restrictedNormalizedSphericalMaximal (n + 1) E
          (f : Euclidean (n + 1) → ℂ)) (ENNReal.ofReal p)
          (powerWeightedVolume (n + 1) α) ≤
          ENNReal.ofReal C * eLpNorm (f : Euclidean (n + 1) → ℂ)
            (ENNReal.ofReal p) (powerWeightedVolume (n + 1) α))
    (hp : 0 < p) (hα : α < 0) {diam δ : ℝ≥0}
    (hδ : 0 < δ) (hδdiam : δ ≤ diam) (hdiamone : diam ≤ 1)
    (hparabolic : (diam : ℝ) ^ 2 ≤ (δ : ℝ) / 128) :
    (localMultiplicativeEntropy E ⟨1, by simp⟩ diam δ).toENNReal ≤
      ((ENNReal.ofReal C) ^ p * negativeSmallInputConstant n α /
        (negativeCapConstant n ^ p * negativeOutputConstant n α)) *
        (ENNReal.ofReal ((δ : ℝ) / (diam : ℝ))) ^
          (-((n : ℝ) * (p - 1))) *
        (ENNReal.ofReal (diam : ℝ)) ^ (-α - n) := by
  classical
  let t : ℝ := (δ : ℝ) / (diam : ℝ)
  let D : ℝ := (diam : ℝ)
  have hδr : 0 < (δ : ℝ) := by exact_mod_cast hδ
  have hdiamr : 0 < (diam : ℝ) :=
    lt_of_lt_of_le hδr (by exact_mod_cast hδdiam)
  have hDr : 0 < D := by
    dsimp only [D]
    exact hdiamr
  have hδD : (δ : ℝ) ≤ D := by exact_mod_cast hδdiam
  have hDone : D ≤ 1 := by
    dsimp only [D]
    exact_mod_cast hdiamone
  have ht : 0 < t := by
    dsimp only [t]
    positivity
  have htone : t ≤ 1 := by
    dsimp only [t]
    exact (div_le_one₀ hDr).mpr hδD
  have htD : t * D = (δ : ℝ) := by
    dsimp only [t, D]
    field_simp [hdiamr.ne']
  have hparabolic' : D ^ 2 ≤ (δ : ℝ) / 128 := by
    simpa only [D] using hparabolic
  have hDsmall : D ≤ (1 : ℝ) / 128 := by
    nlinarith [hparabolic']
  have hδsmall : (δ : ℝ) ≤ (1 : ℝ) / 128 := hδD.trans hDsmall
  have hinner : 0 < 1 - 2 * (δ : ℝ) := by nlinarith
  have hs : 0 < t / 32 := by positivity
  have hsbound : t / 32 ≤ (1 : ℝ) / 4 := by nlinarith
  have hδbound : (δ : ℝ) ≤ (1 : ℝ) / 8 := by nlinarith
  have hδle_s : (δ : ℝ) ≤ t / 32 := by
    have hsrewrite : t / 32 = (δ : ℝ) / (32 * D) := by
      dsimp only [t, D]
      field_simp [hdiamr.ne']
    rw [hsrewrite]
    apply (le_div_iff₀ (by positivity : 0 < 32 * (diam : ℝ))).mpr
    nlinarith [hDsmall]
  have hsouter : 24 * (t / 32) ≤ 1 := by nlinarith
  rcases exists_schwartz_northRadialCap_cutoff n (a := 1) (s := t / 32)
      (δ := (δ : ℝ)) (by norm_num) hs hδr hinner hsbound hδbound with
    ⟨g, f, hfg, hgcont, hgnonneg, hgleone, hgone, hzeroH, hzeroR, hzeroV⟩
  let W : ℝ≥0∞ := powerWeightedVolume (n + 1) α
    (northRadialCapOuter n 1 (t / 32) (δ : ℝ))
  have hWupper : W ≤ negativeSmallInputConstant n α *
      (ENNReal.ofReal t) ^ (n + 1) * ENNReal.ofReal D := by
    dsimp only [W]
    calc
      powerWeightedVolume (n + 1) α
          (northRadialCapOuter n 1 (t / 32) (δ : ℝ)) ≤
          (ENNReal.ofReal (1 - 2 * (δ : ℝ))) ^ α *
            volume (northRadialCapOuter n 1 (t / 32) (δ : ℝ)) :=
        powerWeightedVolume_northRadialCapOuter_le_of_nonpos n hα.le hinner
      _ ≤ (ENNReal.ofReal (1 - 2 * (δ : ℝ))) ^ α *
          (volume (ball (0 : Euclidean n) (6 * (t / 32))) *
            ENNReal.ofReal (12 * (δ : ℝ))) := by
              gcongr
              exact volume_northRadialCapOuter_le n (by norm_num) hs hδr hδle_s hsouter
      _ = (ENNReal.ofReal (1 - 2 * (t * D))) ^ α *
          (volume (ball (0 : Euclidean n) (6 * (t / 32))) *
            ENNReal.ofReal (12 * (t * D))) := by
              rw [htD]
      _ ≤ negativeSmallInputConstant n α *
          (ENNReal.ofReal t) ^ (n + 1) * ENNReal.ofReal D :=
        negative_small_input_mass_upper n (by omega) hα ht hDr (by
          rw [htD]
          nlinarith [hδsmall])
  have hinputTop : negativeSmallInputConstant n α *
      (ENNReal.ofReal t) ^ (n + 1) * ENNReal.ofReal D ≠ (∞ : ℝ≥0∞) := by
    apply ENNReal.mul_ne_top
    · apply ENNReal.mul_ne_top
      · exact negativeSmallInputConstant_ne_top n α
      · exact ENNReal.pow_ne_top ENNReal.ofReal_ne_top
    · exact ENNReal.ofReal_ne_top
  have hWfinite : W < (∞ : ℝ≥0∞) :=
    lt_of_le_of_lt hWupper (lt_top_iff_ne_top.mpr hinputTop)
  have hsupport : ∀ y ∉ northRadialCapOuter n 1 (t / 32) (δ : ℝ), g y = 0 := by
    intro y hy
    exact eq_zero_of_not_mem_northRadialCapOuter n hzeroH hzeroR hzeroV hy
  have hf : MemLp (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p)
      (powerWeightedVolume (n + 1) α) :=
    schwartz_memLp_of_northRadialCapOuter_support n g f hfg hgnonneg hgleone
      hsupport hWfinite
  have hnorm : eLpNorm (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p)
      (powerWeightedVolume (n + 1) α) ≤ W ^ (1 / (ENNReal.ofReal p).toReal) := by
    dsimp only [W]
    exact eLpNorm_northRadialCap_cutoff_le n (ENNReal.ofReal_pos.mpr hp).ne'
      g f hfg hgnonneg hgleone hsupport
  let b : ℝ := Real.log 2 * (δ : ℝ) / 1024
  obtain ⟨T, hT, hnet, hlogsep, hphyssep⟩ :=
    exists_finset_multiplicative_packing
      (E ∩ multiplicativeInterval ⟨1, by simp⟩ diam) ⟨1, by simp⟩ diam δ hδ hdiamone
      (by intro r hr; exact hr.2)
  have hsep : ∀ r ∈ T, ∀ q ∈ T, r ≠ q →
      2 * b ≤ |(r : ℝ) - (q : ℝ)| := by
    intro r hr q hq hrq
    have hphysical := hphyssep r hr q hq hrq
    have hphysical' : Real.log 2 * (δ : ℝ) / 4 < |(r : ℝ) - (q : ℝ)| := by
      simpa using hphysical
    have hlog : 0 < Real.log 2 := Real.log_pos one_lt_two
    have hscale : 2 * b ≤ Real.log 2 * (δ : ℝ) / 4 := by
      dsimp only [b]
      nlinarith
    exact hscale.trans hphysical'.le
  have hhEq : t / 128 = (δ : ℝ) / (128 * D) := by
    dsimp only [t, D]
    field_simp [hdiamr.ne']
  have hsEq : t / 32 = (δ : ℝ) / (32 * D) := by
    dsimp only [t, D]
    field_simp [hdiamr.ne']
  have hcapHorizontal : ∀ r ∈ T, D / 128 + (r : ℝ) * (t / 128) ≤ t / 32 := by
    intro r hr
    rw [hhEq, hsEq]
    exact (small_normalized_cap_conditions hδr hDr hδD hparabolic' r.2.le
      (le_two_of_mem_multiplicativeInterval_one hdiamone (hT r hr).2)
      (abs_sub_one_le_diam_of_mem_multiplicativeInterval_one hdiamone (hT r hr).2)).1
  have hcapError : ∀ r ∈ T,
      (D / 128) ^ 2 + 2 * (r : ℝ) * (D / 128) * (t / 128) +
          8 * (r : ℝ) * (|1 - (r : ℝ)| + b) * (t / 128) ^ 2 +
          2 * b + b ^ 2 < (δ : ℝ) := by
    intro r hr
    rw [hhEq]
    have hgeometry := (small_normalized_cap_conditions hδr hDr hδD hparabolic' r.2.le
      (le_two_of_mem_multiplicativeInterval_one hdiamone (hT r hr).2)
      (abs_sub_one_le_diam_of_mem_multiplicativeInterval_one hdiamone (hT r hr).2)).2.1
    dsimp only [b]
    convert hgeometry using 1 <;> ring
  have hcapVertical : ∀ r ∈ T, 0 < 1 - b - 4 * (r : ℝ) * (t / 128) ^ 2 := by
    intro r hr
    rw [hhEq]
    simpa only [b] using (small_normalized_cap_conditions hδr hDr hδD hparabolic' r.2.le
      (le_two_of_mem_multiplicativeInterval_one hdiamone (hT r hr).2)
      (abs_sub_one_le_diam_of_mem_multiplicativeInterval_one hdiamone (hT r hr).2)).2.2
  let m : ℝ≥0∞ := (ENNReal.ofReal (2 * D)) ^ α *
    (volume (ball (0 : Euclidean n) (D / 128)) * ENNReal.ofReal (2 * b))
  have hm : ∀ r ∈ T, m ≤ powerWeightedVolume (n + 1) α
      (horizontalSlab n (D / 128) (1 - (r : ℝ) - b) (1 - (r : ℝ) + b)) := by
    intro r hr
    dsimp only [m]
    apply powerWeightedVolume_horizontalSlab_lower_of_near_origin n hα
    · positivity
    · have hdist := abs_sub_one_le_diam_of_mem_multiplicativeInterval_one hdiamone
        (hT r hr).2
      have hlogle : Real.log 2 ≤ 1 := by
        nlinarith [Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)]
      have hlogdelta : Real.log 2 * (δ : ℝ) ≤ (δ : ℝ) := by
        simpa using mul_le_mul_of_nonneg_right hlogle hδr.le
      have hb : b ≤ D / 1024 := by
        dsimp only [b]
        calc
          Real.log 2 * (δ : ℝ) / 1024 ≤ (δ : ℝ) / 1024 := by
            exact div_le_div_of_nonneg_right hlogdelta (by norm_num)
          _ ≤ D / 1024 := by
            exact div_le_div_of_nonneg_right hδD (by norm_num)
      have hdistD : |1 - (r : ℝ)| ≤ D := by
        rw [abs_sub_comm]
        simpa only [D] using hdist
      nlinarith
  have htest := restrictedStrongType_smallDiameter_localEntropy_power_lower_of_bound
    n hn hstrong ⟨1, by simp⟩ diam δ T hT hlogsep hnet hsep hm hp (by norm_num)
      (by positivity : 0 ≤ D / 128) (by positivity : 0 ≤ b) (by positivity : 0 < t / 128)
      (by nlinarith [htone] : t / 128 ≤ 1 / 4) hcapHorizontal (by simpa using hcapError) hcapVertical
      g f hfg hgcont hgnonneg hgone hf hnorm
  have htest' :
      ((ENNReal.ofReal (surfaceMass n) *
        ((ENNReal.ofReal ((t / 128) / 2)) ^ (n - 2) *
          ENNReal.ofReal ((t / 128) ^ 2 / 4))) /
        ENNReal.ofReal (surfaceMass (n + 1))) ^ p *
        ((localMultiplicativeEntropy E ⟨1, by simp⟩ diam δ).toENNReal * m) ≤
      (ENNReal.ofReal C) ^ p * W := by
    calc
      ((ENNReal.ofReal (surfaceMass n) *
        ((ENNReal.ofReal ((t / 128) / 2)) ^ (n - 2) *
          ENNReal.ofReal ((t / 128) ^ 2 / 4))) /
        ENNReal.ofReal (surfaceMass (n + 1))) ^ p *
        ((localMultiplicativeEntropy E ⟨1, by simp⟩ diam δ).toENNReal * m) ≤
          (ENNReal.ofReal C * W ^ (1 / (ENNReal.ofReal p).toReal)) ^ p := htest
      _ = (ENNReal.ofReal C) ^ p * W := by
        have hq : 1 / (ENNReal.ofReal p).toReal = p⁻¹ := by
          rw [ENNReal.toReal_ofReal hp.le]
          simp only [one_div]
        rw [hq, ENNReal.mul_rpow_of_nonneg _ _ hp.le,
          ENNReal.rpow_inv_rpow hp.ne']
  have hknapp :
      ((negativeCapConstant n * (ENNReal.ofReal t) ^ n) ^ p) *
        ((localMultiplicativeEntropy E ⟨1, by simp⟩ diam δ).toENNReal *
          (negativeOutputConstant n α * ENNReal.ofReal t *
            (ENNReal.ofReal D) ^ (α + (n + 1 : ℕ)))) ≤
      (ENNReal.ofReal C) ^ p *
        (negativeSmallInputConstant n α * (ENNReal.ofReal t) ^ (n + 1) *
          ENNReal.ofReal D) := by
    have hright : (ENNReal.ofReal C) ^ p * W ≤ (ENNReal.ofReal C) ^ p *
        (negativeSmallInputConstant n α * (ENNReal.ofReal t) ^ (n + 1) *
          ENNReal.ofReal D) :=
      by gcongr
    have hraw := htest'.trans hright
    have hcap := negative_cap_factor_scale n hn ht
    have hmScale : m = negativeOutputConstant n α * ENNReal.ofReal t *
        (ENNReal.ofReal D) ^ (α + (n + 1 : ℕ)) := by
      dsimp only [m, b]
      rw [show 2 * (Real.log 2 * (δ : ℝ) / 1024) =
          Real.log 2 * (t * D) / 512 by rw [htD]; ring]
      exact negative_output_mass_scale n (by omega) ht hDr
    rw [hcap, hmScale] at hraw
    exact hraw
  have hresult := two_scale_entropy_algebra (n := n) hp
    (ENNReal.ofReal_pos.mpr ht).ne' ENNReal.ofReal_ne_top
    (ENNReal.ofReal_pos.mpr hDr).ne' ENNReal.ofReal_ne_top
    (negativeCapConstant_pos n hn).ne' (negativeCapConstant_ne_top n)
    (negativeOutputConstant_pos n (by omega) α).ne'
    (negativeOutputConstant_ne_top n α) hknapp
  simpa only [t, D] using hresult

private theorem normalized_large_local_entropy_bound
    (n : ℕ) (hn : 2 ≤ n) {E : Set ℝ} {p α C : ℝ}
    (hstrong : ∀ f : SchwartzMap (Euclidean (n + 1)) ℂ,
      MemLp (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p)
        (powerWeightedVolume (n + 1) α) →
        MemLp (restrictedNormalizedSphericalMaximal (n + 1) E
          (f : Euclidean (n + 1) → ℂ)) (ENNReal.ofReal p)
          (powerWeightedVolume (n + 1) α) ∧
        eLpNorm (restrictedNormalizedSphericalMaximal (n + 1) E
          (f : Euclidean (n + 1) → ℂ)) (ENNReal.ofReal p)
          (powerWeightedVolume (n + 1) α) ≤
          ENNReal.ofReal C * eLpNorm (f : Euclidean (n + 1) → ℂ)
            (ENNReal.ofReal p) (powerWeightedVolume (n + 1) α))
    (hp : 0 < p) (hα : α < 0) {diam δ : ℝ≥0}
    (hδ : 0 < δ) (hδdiam : δ ≤ diam) (hdiamone : diam ≤ 1)
    (hnonparabolic : (δ : ℝ) / 128 < (diam : ℝ) ^ 2) :
    (localMultiplicativeEntropy E ⟨1, by simp⟩ diam δ).toENNReal ≤
      ((ENNReal.ofReal C) ^ p * negativeLargeInputConstant n α /
        (negativeCapConstant n ^ p * negativeOutputConstant n α)) *
        (ENNReal.ofReal ((δ : ℝ) / (diam : ℝ))) ^
          (-((n : ℝ) * (p - 1))) *
        (ENNReal.ofReal (diam : ℝ)) ^ (-α - n) := by
  classical
  let t : ℝ := (δ : ℝ) / (diam : ℝ)
  let D : ℝ := (diam : ℝ)
  have hδr : 0 < (δ : ℝ) := by exact_mod_cast hδ
  have hdiamr : 0 < (diam : ℝ) :=
    lt_of_lt_of_le hδr (by exact_mod_cast hδdiam)
  have hDr : 0 < D := by
    dsimp only [D]
    exact hdiamr
  have hδD : (δ : ℝ) ≤ D := by exact_mod_cast hδdiam
  have hDone : D ≤ 1 := by
    dsimp only [D]
    exact_mod_cast hdiamone
  have ht : 0 < t := by
    dsimp only [t]
    positivity
  have htone : t ≤ 1 := by
    dsimp only [t]
    exact (div_le_one₀ hDr).mpr hδD
  have htD : t * D = (δ : ℝ) := by
    dsimp only [t, D]
    field_simp [hdiamr.ne']
  have hnonparabolic' : (δ : ℝ) / 128 < D ^ 2 := by
    simpa only [D] using hnonparabolic
  have htlarge : t < 128 * D := by
    apply lt_of_mul_lt_mul_right (a := D) _ hDr.le
    rw [htD]
    nlinarith [hnonparabolic']
  have hδsmall : (δ : ℝ) ≤ 1 := hδD.trans hDone
  let b : ℝ := Real.log 2 * (δ : ℝ) / 1024
  obtain ⟨T, hT, hnet, hlogsep, hphyssep⟩ :=
    exists_finset_multiplicative_packing
      (E ∩ multiplicativeInterval ⟨1, by simp⟩ diam) ⟨1, by simp⟩ diam δ hδ hdiamone
      (by intro r hr; exact hr.2)
  have hsep : ∀ r ∈ T, ∀ q ∈ T, r ≠ q →
      2 * b ≤ |(r : ℝ) - (q : ℝ)| := by
    intro r hr q hq hrq
    have hphysical := hphyssep r hr q hq hrq
    have hphysical' : Real.log 2 * (δ : ℝ) / 4 < |(r : ℝ) - (q : ℝ)| := by
      simpa using hphysical
    have hlog : 0 < Real.log 2 := Real.log_pos one_lt_two
    have hscale : 2 * b ≤ Real.log 2 * (δ : ℝ) / 4 := by
      dsimp only [b]
      nlinarith
    exact hscale.trans hphysical'.le
  have hrunit : ∀ r ∈ T, (r : ℝ) ∈ multiplicativeInterval ⟨1, by simp⟩ 1 := by
    intro r hr
    refine ⟨(hT r hr).2.1, ?_⟩
    calc
      |Real.log (r : ℝ) / Real.log 2 - logRadius ⟨1, by simp⟩| ≤
          (diam : ℝ) / 2 := (hT r hr).2.2
      _ ≤ (1 : ℝ) / 2 := by exact_mod_cast (div_le_div_of_nonneg_right hdiamone (by norm_num))
  have hrhalf : ∀ r ∈ T, (1 : ℝ) / 2 ≤ (r : ℝ) := by
    intro r hr
    simpa using half_center_le_radius_of_mem_unitMultiplicativeInterval ⟨1, by simp⟩
      (hrunit r hr)
  have hrle : ∀ r ∈ T, (r : ℝ) ≤ 2 := by
    intro r hr
    exact le_two_of_mem_multiplicativeInterval_one hdiamone (hT r hr).2
  have hρ : ∀ r ∈ T, D / 128 ≤ (r : ℝ) := by
    intro r hr
    nlinarith [hrhalf r hr, hDone]
  have hhemisphere : ∀ r ∈ T, 2 * (D / 128) ≤ (r : ℝ) := by
    intro r hr
    nlinarith [hrhalf r hr, hDone]
  have hcapHorizontal : ∀ r ∈ T, (r : ℝ) * (t / 128) < t / 32 := by
    intro r hr
    nlinarith [hrle r hr, ht]
  have hlogle : Real.log 2 ≤ 1 := by
    nlinarith [Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)]
  have hbδ : b ≤ (δ : ℝ) / 1024 := by
    dsimp only [b]
    have hlogδ : Real.log 2 * (δ : ℝ) ≤ (δ : ℝ) := by
      simpa using mul_le_mul_of_nonneg_right hlogle hδr.le
    exact div_le_div_of_nonneg_right hlogδ (by norm_num)
  have htsq : t ^ 2 ≤ 128 * (t * D) := by
    have hnonneg : 0 ≤ t * (128 * D - t) :=
      mul_nonneg ht.le (sub_nonneg.mpr htlarge.le)
    nlinarith
  have hcapVertical : ∀ r ∈ T,
      b + 4 * (D / 128 * (t / 128) + (r : ℝ) * (t / 128) ^ 2) ≤ (δ : ℝ) / 4 := by
    intro r hr
    have hrh : (r : ℝ) * (t / 128) ^ 2 ≤ t ^ 2 / 8192 := by
      calc
        (r : ℝ) * (t / 128) ^ 2 ≤ 2 * (t / 128) ^ 2 :=
          mul_le_mul_of_nonneg_right (hrle r hr) (sq_nonneg _)
        _ = t ^ 2 / 8192 := by ring
    have htsq' : t ^ 2 / 8192 ≤ (δ : ℝ) / 64 := by
      have htsq'' : t ^ 2 ≤ 128 * (δ : ℝ) := by
        simpa only [htD] using htsq
      nlinarith
    have hρh : D / 128 * (t / 128) = (δ : ℝ) / 16384 := by
      rw [← htD]
      ring
    rw [hρh]
    nlinarith [hrh.trans htsq']
  have hinputAway : 0 < 1 - 2 * ((δ : ℝ) / 4) := by
    nlinarith
  have hnear : ∀ r ∈ T, |1 - (r : ℝ)| + 2 * (D / 128) + b ≤ 2 * D := by
    intro r hr
    have hdist := abs_sub_one_le_diam_of_mem_multiplicativeInterval_one hdiamone
      (hT r hr).2
    have hdistD : |1 - (r : ℝ)| ≤ D := by
      rw [abs_sub_comm]
      simpa only [D] using hdist
    have hbD : b ≤ D / 1024 := hbδ.trans
      (div_le_div_of_nonneg_right hδD (by norm_num))
    nlinarith
  have htest := restrictedStrongType_graphTube_localEntropy_nearOrigin_power_lower_of_bound
    n hn hstrong ⟨1, by simp⟩ diam δ T hT hlogsep hnet hsep hρ hhemisphere hp hα
      (by positivity : 0 < t / 32) (by positivity : 0 < (δ : ℝ) / 4)
      (by positivity : 0 < t / 128) (by nlinarith [htone] : t / 128 ≤ 1 / 4)
      hcapHorizontal (by simpa only [b] using hcapVertical) (by simpa using hinputAway)
      (by positivity : 0 < 2 * D) (by simpa using hnear)
  have hinput :
      (ENNReal.ofReal (1 - 2 * ((δ : ℝ) / 4))) ^ α *
          (volume (ball (0 : Euclidean n) (2 * (t / 32))) *
            ENNReal.ofReal (2 * (2 * ((δ : ℝ) / 4)))) ≤
        negativeLargeInputConstant n α * (ENNReal.ofReal t) ^ (n + 1) *
          ENNReal.ofReal D := by
    calc
      (ENNReal.ofReal (1 - 2 * ((δ : ℝ) / 4))) ^ α *
          (volume (ball (0 : Euclidean n) (2 * (t / 32))) *
            ENNReal.ofReal (2 * (2 * ((δ : ℝ) / 4)))) =
          (ENNReal.ofReal (1 - t * D / 2)) ^ α *
            (volume (ball (0 : Euclidean n) (t / 16)) * ENNReal.ofReal (t * D)) := by
              rw [htD]
              congr 3 <;> ring
      _ ≤ negativeLargeInputConstant n α * (ENNReal.ofReal t) ^ (n + 1) *
          ENNReal.ofReal D :=
        negative_large_input_mass_upper n (by omega) hα ht hDr (by
          rw [htD]
          exact hδsmall)
  have hknapp :
      ((negativeCapConstant n * (ENNReal.ofReal t) ^ n) ^ p) *
        ((localMultiplicativeEntropy E ⟨1, by simp⟩ diam δ).toENNReal *
          (negativeOutputConstant n α * ENNReal.ofReal t *
            (ENNReal.ofReal D) ^ (α + (n + 1 : ℕ)))) ≤
      (ENNReal.ofReal C) ^ p *
        (negativeLargeInputConstant n α * (ENNReal.ofReal t) ^ (n + 1) *
          ENNReal.ofReal D) := by
    have hraw :
        ((ENNReal.ofReal (surfaceMass n) *
          ((ENNReal.ofReal ((t / 128) / 2)) ^ (n - 2) *
            ENNReal.ofReal ((t / 128) ^ 2 / 4))) /
          ENNReal.ofReal (surfaceMass (n + 1))) ^ p *
          ((localMultiplicativeEntropy E ⟨1, by simp⟩ diam δ).toENNReal *
            ((ENNReal.ofReal (2 * D)) ^ α *
              (volume (ball (0 : Euclidean n) (D / 128)) * ENNReal.ofReal (2 * b)))) ≤
        (ENNReal.ofReal C) ^ p *
          (negativeLargeInputConstant n α * (ENNReal.ofReal t) ^ (n + 1) *
            ENNReal.ofReal D) := by
      calc
        ((ENNReal.ofReal (surfaceMass n) *
          ((ENNReal.ofReal ((t / 128) / 2)) ^ (n - 2) *
            ENNReal.ofReal ((t / 128) ^ 2 / 4))) /
          ENNReal.ofReal (surfaceMass (n + 1))) ^ p *
          ((localMultiplicativeEntropy E ⟨1, by simp⟩ diam δ).toENNReal *
            ((ENNReal.ofReal (2 * D)) ^ α *
              (volume (ball (0 : Euclidean n) (D / 128)) * ENNReal.ofReal (2 * b)))) ≤
            (ENNReal.ofReal C) ^ p *
              ((ENNReal.ofReal (1 - 2 * ((δ : ℝ) / 4))) ^ α *
                (volume (ball (0 : Euclidean n) (2 * (t / 32))) *
                  ENNReal.ofReal (2 * (2 * ((δ : ℝ) / 4))))) := by
              simpa only [one_mul] using htest
        _ ≤ (ENNReal.ofReal C) ^ p *
            (negativeLargeInputConstant n α * (ENNReal.ofReal t) ^ (n + 1) *
              ENNReal.ofReal D) := by gcongr
    have hcap := negative_cap_factor_scale n hn ht
    have hmScale : (ENNReal.ofReal (2 * D)) ^ α *
        (volume (ball (0 : Euclidean n) (D / 128)) * ENNReal.ofReal (2 * b)) =
        negativeOutputConstant n α * ENNReal.ofReal t *
          (ENNReal.ofReal D) ^ (α + (n + 1 : ℕ)) := by
      dsimp only [b]
      rw [show 2 * (Real.log 2 * (δ : ℝ) / 1024) =
          Real.log 2 * (t * D) / 512 by rw [htD]; ring]
      exact negative_output_mass_scale n (by omega) ht hDr
    rw [hcap, hmScale] at hraw
    exact hraw
  have hresult := two_scale_entropy_algebra (n := n) hp
    (ENNReal.ofReal_pos.mpr ht).ne' ENNReal.ofReal_ne_top
    (ENNReal.ofReal_pos.mpr hDr).ne' ENNReal.ofReal_ne_top
    (negativeCapConstant_pos n hn).ne' (negativeCapConstant_ne_top n)
    (negativeOutputConstant_pos n (by omega) α).ne'
    (negativeOutputConstant_ne_top n α) hknapp
  simpa only [t, D] using hresult

theorem powerWeightEntropyImplicitCondition_of_restrictedStrongType_of_neg
    (n : ℕ) (hn : 2 ≤ n) {E : Set ℝ} {p α : ℝ}
    (_hE : E.Nonempty) (_hEpos : E ⊆ Ioi 0)
    (hp : 1 ≤ p) (hα : α < 0)
    (hstrong : HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType
      (n + 1) E p α) :
    powerWeightEntropyImplicitCondition (n + 1) E p α := by
  rcases hstrong with ⟨C, hC, hbound⟩
  let ρ : ℝ := (n : ℝ) * (p - 2) - α
  let T : ℝ := (n : ℝ) * (p - 1)
  let Ksmall : ℝ≥0∞ :=
    (ENNReal.ofReal C) ^ p * negativeSmallInputConstant n α /
      (negativeCapConstant n ^ p * negativeOutputConstant n α)
  let Klarge : ℝ≥0∞ :=
    (ENNReal.ofReal C) ^ p * negativeLargeInputConstant n α /
      (negativeCapConstant n ^ p * negativeOutputConstant n α)
  let A : ℝ≥0∞ := max Ksmall Klarge
  have hp0 : 0 < p := lt_of_lt_of_le zero_lt_one hp
  have hden0 : negativeCapConstant n ^ p * negativeOutputConstant n α ≠ 0 := by
    apply mul_ne_zero
    · exact (ENNReal.rpow_pos (negativeCapConstant_pos n hn)
        (negativeCapConstant_ne_top n)).ne'
    · exact (negativeOutputConstant_pos n (by omega) α).ne'
  have hKsmallTop : Ksmall ≠ (∞ : ℝ≥0∞) := by
    dsimp only [Ksmall]
    apply ENNReal.div_ne_top
    · apply ENNReal.mul_ne_top
      · exact ENNReal.rpow_ne_top_of_nonneg hp0.le ENNReal.ofReal_ne_top
      · exact negativeSmallInputConstant_ne_top n α
    · exact hden0
  have hKlargeTop : Klarge ≠ (∞ : ℝ≥0∞) := by
    dsimp only [Klarge]
    apply ENNReal.div_ne_top
    · apply ENNReal.mul_ne_top
      · exact ENNReal.rpow_ne_top_of_nonneg hp0.le ENNReal.ofReal_ne_top
      · exact negativeLargeInputConstant_ne_top n α
    · exact hden0
  have hAtop : A ≠ (∞ : ℝ≥0∞) := by
    apply lt_top_iff_ne_top.mp
    dsimp only [A]
    exact max_lt (lt_top_iff_ne_top.mpr hKsmallTop) (lt_top_iff_ne_top.mpr hKlargeTop)
  have hprofile : ∀ᶠ δ : ℝ≥0 in 𝓝[>] (0 : ℝ≥0),
      multiplicativeLegendreAssouadProfile E ρ δ ≤
        A * (δ : ℝ≥0∞) ^ (-T) := by
    have hsmall : ∀ᶠ δ : ℝ≥0 in 𝓝[>] (0 : ℝ≥0), δ ∈ Ioo 0 1 :=
      nhdsGT_basis 0 |>.mem_of_mem zero_lt_one
    filter_upwards [hsmall] with δ hδ
    unfold multiplicativeLegendreAssouadProfile
    apply iSup_le
    intro c
    apply iSup_le
    intro diam
    let E' : Set ℝ := dilateRadiusSet (c : ℝ)⁻¹ E
    have hcpos : 0 < (c : ℝ)⁻¹ := inv_pos.mpr c.2
    have hbound' := restrictedNormalizedSphericalMaximal_dilateRadiusSet_bound
      (d := n + 1) (by omega) hp0 hcpos hbound
    have hδr : 0 < (δ : ℝ) := by exact_mod_cast hδ.1
    have hdiamr : 0 < (diam.1 : ℝ) :=
      lt_of_lt_of_le hδr (by exact_mod_cast diam.2.1)
    have hlocal' :
        (localMultiplicativeEntropy E' ⟨1, by simp⟩ diam.1 δ).toENNReal ≤
          (if (diam.1 : ℝ) ^ 2 ≤ (δ : ℝ) / 128 then Ksmall else Klarge) *
            (ENNReal.ofReal ((δ : ℝ) / (diam.1 : ℝ))) ^ (-T) *
            (ENNReal.ofReal (diam.1 : ℝ)) ^ (-α - n) := by
      by_cases hparabolic : (diam.1 : ℝ) ^ 2 ≤ (δ : ℝ) / 128
      · simpa only [if_pos hparabolic, Ksmall, T] using
          normalized_small_local_entropy_bound n hn hbound' hp0 hα hδ.1 diam.2.1 diam.2.2
            hparabolic
      · simpa only [if_neg hparabolic, Klarge, T] using
          normalized_large_local_entropy_bound n hn hbound' hp0 hα hδ.1 diam.2.1 diam.2.2
            (lt_of_not_ge hparabolic)
    have hlocalEq : localMultiplicativeEntropy E' ⟨1, by simp⟩ diam.1 δ =
        localMultiplicativeEntropy E c diam.1 δ := by
      let c' : PositiveRadius := ⟨(c : ℝ)⁻¹ * (c : ℝ),
        mul_pos hcpos c.2⟩
      have hc' : c' = ⟨1, by simp⟩ := by
        apply Subtype.ext
        dsimp only [c']
        exact inv_mul_cancel₀ (ne_of_gt c.2)
      have hdilate := localMultiplicativeEntropy_dilateRadiusSet E c diam.1 δ hcpos
      change localMultiplicativeEntropy E' c' diam.1 δ =
        localMultiplicativeEntropy E c diam.1 δ at hdilate
      rw [hc'] at hdilate
      exact hdilate
    rw [hlocalEq] at hlocal'
    have hK : (if (diam.1 : ℝ) ^ 2 ≤ (δ : ℝ) / 128 then Ksmall else Klarge) ≤ A := by
      dsimp only [A]
      split
      · exact le_max_left _ _
      · exact le_max_right _ _
    have hlocal : (localMultiplicativeEntropy E c diam.1 δ).toENNReal ≤
        A * (ENNReal.ofReal ((δ : ℝ) / (diam.1 : ℝ))) ^ (-T) *
          (ENNReal.ofReal (diam.1 : ℝ)) ^ (-α - n) := by
      calc
        (localMultiplicativeEntropy E c diam.1 δ).toENNReal ≤
            (if (diam.1 : ℝ) ^ 2 ≤ (δ : ℝ) / 128 then Ksmall else Klarge) *
              (ENNReal.ofReal ((δ : ℝ) / (diam.1 : ℝ))) ^ (-T) *
              (ENNReal.ofReal (diam.1 : ℝ)) ^ (-α - n) := hlocal'
        _ ≤ A * (ENNReal.ofReal ((δ : ℝ) / (diam.1 : ℝ))) ^ (-T) *
              (ENNReal.ofReal (diam.1 : ℝ)) ^ (-α - n) := by gcongr
    simpa [ρ, T] using profile_bound_of_local_bound hδr hdiamr hlocal
  have hright : multiplicativeLegendreAssouadExponent E ρ ≤ (T : EReal) :=
    multiplicativeLegendreAssouadExponent_le_of_profile_power_bound hAtop hprofile
  have hleft : (α : EReal) + multiplicativeMinkowskiExponent E ≤ (T : EReal) := by
    calc
      (α : EReal) + multiplicativeMinkowskiExponent E ≤
          (0 : EReal) + multiplicativeMinkowskiExponent E := by
            gcongr
            exact_mod_cast hα.le
      _ = multiplicativeMinkowskiExponent E := zero_add _
      _ ≤ multiplicativeLegendreAssouadExponent E ρ :=
        multiplicativeMinkowskiExponent_le_multiplicativeLegendreAssouadExponent E ρ
      _ ≤ (T : EReal) := hright
  unfold powerWeightEntropyImplicitCondition
  simp only [Nat.cast_add, Nat.cast_one, add_sub_cancel_right]
  change max ((α : EReal) + multiplicativeMinkowskiExponent E)
    (multiplicativeLegendreAssouadExponent E ρ) ≤ (T : EReal)
  exact max_le hleft hright

end

