    ∀ k : ↥S, ∃ Tbar :
      Lp ℂ 2 (volume : Measure (Euclidean d)) → Lp ℂ 2 volume,
      (∀ f : SchwartzMap (Euclidean d) ℂ,
        Tbar (f.toLp 2 volume) =
          (memLp_two_lacunaryRelativeBandpassPhysicalTerm_of_integrable_of_norm_le
            psi j (r k.1).2 (f : Euclidean d → ℂ) f.integrable
            ‖f.toBoundedContinuousFunction‖ (norm_nonneg _)
            (fun x => BoundedContinuousFunction.norm_coe_le_norm
              f.toBoundedContinuousFunction x)).toLp
            (lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ)
              (f : Euclidean d → ℂ))) ∧
      LipschitzWith C.toNNReal Tbar := by
  classical
  letI : Fact (1 ≤ (2 : ENNReal)) := ⟨by norm_num⟩
  intro k
  let htermMem : ∀ f : SchwartzMap (Euclidean d) ℂ,
      MemLp (lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ)
        (f : Euclidean d → ℂ)) 2 volume := fun f =>
    memLp_two_lacunaryRelativeBandpassPhysicalTerm_of_integrable_of_norm_le
      psi j (r k.1).2 (f : Euclidean d → ℂ) f.integrable
      ‖f.toBoundedContinuousFunction‖ (norm_nonneg _)
      (fun x => BoundedContinuousFunction.norm_coe_le_norm
        f.toBoundedContinuousFunction x)
  let Tcore : SchwartzMap (Euclidean d) ℂ → Lp ℂ 2 volume := fun f =>
    (htermMem f).toLp (lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ)
      (f : Euclidean d → ℂ))
  have hterm_bound (f : SchwartzMap (Euclidean d) ℂ) :
      ‖Tcore f‖ ≤ C * ‖f.toLp 2 volume‖ := by
    calc
      ‖Tcore f‖ ≤ ‖(hcoreMem f).toLp
          (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
            (f : Euclidean d → ℂ))‖ := by
        apply Lp.norm_le_norm_of_ae_le
        filter_upwards [
          (htermMem f).coeFn_toLp,
          (hcoreMem f).coeFn_toLp] with x hterm hM
        rw [hterm, hM, Real.norm_of_nonneg]
        · exact Finset.le_sup' (fun n : ℤ =>
            ‖lacunaryRelativeBandpassPhysicalTerm psi j (r n : ℝ)
              (f : Euclidean d → ℂ) x‖) k.2
        · exact le_trans (norm_nonneg _)
            (Finset.le_sup' (fun n : ℤ =>
              ‖lacunaryRelativeBandpassPhysicalTerm psi j (r n : ℝ)
                (f : Euclidean d → ℂ) x‖) hS.choose_spec)
      _ ≤ C * ‖f.toLp 2 volume‖ := hcoreBound f
  have hTcore_zero : Tcore 0 = 0 := by
    apply norm_eq_zero.mp
    apply le_antisymm
    · have hzero : (0 : SchwartzMap (Euclidean d) ℂ).toLp 2 volume = 0 := by
        change (SchwartzMap.toLpCLM ℝ ℂ 2 volume) 0 = 0
        exact map_zero _
      simpa [hzero] using hterm_bound (0 : SchwartzMap (Euclidean d) ℂ)
    · exact norm_nonneg _
  have hTcore_sub (f g : SchwartzMap (Euclidean d) ℂ) :
      Tcore (f - g) = Tcore f - Tcore g := by
    apply Lp.ext
    filter_upwards [(htermMem (f - g)).coeFn_toLp, (htermMem f).coeFn_toLp,
      (htermMem g).coeFn_toLp, Lp.coeFn_sub (Tcore f) (Tcore g)]
      with x hfg hf hg hsub
    calc
      (Tcore (f - g) : Euclidean d → ℂ) x =
          lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ)
            (fun y => f y - g y) x := hfg
      _ = lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ)
            (f : Euclidean d → ℂ) x -
          lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ)
            (g : Euclidean d → ℂ) x :=
        lacunaryRelativeBandpassPhysicalTerm_sub psi j (r k.1).2 f g x
      _ = (Tcore f : Euclidean d → ℂ) x - (Tcore g : Euclidean d → ℂ) x := by
        rw [hf, hg]
      _ = ((Tcore f - Tcore g : Lp ℂ 2 volume) : Euclidean d → ℂ) x := hsub.symm
  have hTcore_lip (f g : SchwartzMap (Euclidean d) ℂ) :
      dist (Tcore f) (Tcore g) ≤ C * dist (f.toLp 2 volume) (g.toLp 2 volume) := by
    calc
      dist (Tcore f) (Tcore g) = ‖Tcore f - Tcore g‖ := by
        rw [Lp.dist_eq_norm]
        rw [show -Tcore f + Tcore g = -(Tcore f - Tcore g) by abel, norm_neg]
      _ = ‖Tcore (f - g)‖ := by rw [hTcore_sub]
      _ ≤ C * ‖(f - g).toLp 2 volume‖ := hterm_bound (f - g)
      _ = C * dist (f.toLp 2 volume) (g.toLp 2 volume) := by
        have htoLp_sub : (f - g).toLp 2 volume =
            f.toLp 2 volume - g.toLp 2 volume := by
          change (SchwartzMap.toLpCLM ℝ ℂ 2 volume) (f - g) =
            (SchwartzMap.toLpCLM ℝ ℂ 2 volume) f -
              (SchwartzMap.toLpCLM ℝ ℂ 2 volume) g
          exact map_sub _ _ _
        rw [htoLp_sub, Lp.dist_eq_norm]
        rw [show -f.toLp 2 volume + g.toLp 2 volume =
          -(f.toLp 2 volume - g.toLp 2 volume) by abel, norm_neg]
  obtain ⟨Tbar, hagree, hLip, _⟩ :=
    exists_lipschitz_extension_of_denseRange_norm_bound
      (e := fun f : SchwartzMap (Euclidean d) ℂ => f.toLp 2 volume)
      (a0 := (0 : SchwartzMap (Euclidean d) ℂ))
      (SchwartzMap.denseRange_toLpCLM ENNReal.ofNat_ne_top)
      (by
        simpa only [SchwartzMap.toLpCLM_apply] using
          (SchwartzMap.injective_toLp (E := Euclidean d) (F := ℂ) 2 volume))
      Tcore C hC
      (by
        change (SchwartzMap.toLpCLM ℝ ℂ 2 volume) 0 = 0
        exact map_zero _)
      hTcore_zero hTcore_lip
  refine ⟨Tbar, ?_, hLip⟩
  intro f
  simpa only [Tcore, htermMem] using hagree f

private def lpPointwiseNorm {d : Nat}
    (F : Lp ℂ 2 (volume : Measure (Euclidean d))) :
    Lp ℝ 2 (volume : Measure (Euclidean d)) :=
  (Lp.memLp F).norm.toLp (fun x => ‖(F : Euclidean d → ℂ) x‖)

private theorem lpPointwiseNorm_coe {d : Nat}
    (F : Lp ℂ 2 (volume : Measure (Euclidean d))) :
    (lpPointwiseNorm F : Euclidean d → ℝ) =ᵐ[volume]
      fun x => ‖(F : Euclidean d → ℂ) x‖ := by
  exact (Lp.memLp F).norm.coeFn_toLp

private theorem continuous_lpPointwiseNorm {d : Nat} :
    Continuous (lpPointwiseNorm :
      Lp ℂ 2 (volume : Measure (Euclidean d)) →
        Lp ℝ 2 (volume : Measure (Euclidean d))) := by
  refine (show LipschitzWith (1 : NNReal) lpPointwiseNorm from ?_).continuous
  apply LipschitzWith.of_dist_le_mul
  intro F G
  simp only [NNReal.coe_one, one_mul]
  rw [Lp.dist_eq_norm, Lp.dist_eq_norm]
  apply Lp.norm_le_norm_of_ae_le
  filter_upwards [lpPointwiseNorm_coe F, lpPointwiseNorm_coe G,
    Lp.coeFn_neg (lpPointwiseNorm F),
    Lp.coeFn_add (-lpPointwiseNorm F) (lpPointwiseNorm G),
    Lp.coeFn_neg F, Lp.coeFn_add (-F) G] with x hF hG hneg hsum hFneg hFG
  simp only [Pi.add_apply, Pi.neg_apply] at hneg hsum hFneg hFG
  rw [hsum, hneg, hF, hG, hFG, hFneg, Real.norm_eq_abs]
  calc
    abs (-‖(F : Euclidean d → ℂ) x‖ + ‖(G : Euclidean d → ℂ) x‖) =
        abs (-(‖(F : Euclidean d → ℂ) x‖ - ‖(G : Euclidean d → ℂ) x‖)) := by
          congr 1
          ring
    _ = abs (‖(F : Euclidean d → ℂ) x‖ - ‖(G : Euclidean d → ℂ) x‖) := abs_neg _
    _ ≤ ‖(F : Euclidean d → ℂ) x - (G : Euclidean d → ℂ) x‖ :=
      abs_norm_sub_norm_le _ _
    _ = ‖-(F : Euclidean d → ℂ) x + (G : Euclidean d → ℂ) x‖ := by
      rw [show -(F : Euclidean d → ℂ) x + (G : Euclidean d → ℂ) x =
        -((F : Euclidean d → ℂ) x - (G : Euclidean d → ℂ) x) by abel,
        norm_neg]

private theorem memLp_two_convolutionPhysicalAdjoint_schwartz
    {d : Nat} (K : Euclidean d → ℂ) (h : SchwartzMap (Euclidean d) ℂ)
    (hK : Integrable K volume) :
    MemLp (convolutionPhysicalAdjoint K h) 2 volume := by
  let Kstar : Euclidean d → ℂ := fun z => conj (K (-z))
  have hKneg : Integrable (fun z : Euclidean d => K (-z)) volume := by
    simpa using hK.comp_neg
  have hKstar : Integrable Kstar volume := by
    change Integrable (fun z : Euclidean d =>
      (Complex.conjCLE : ℂ →L[ℝ] ℂ) (K (-z))) volume
    exact (Complex.conjCLE : ℂ →L[ℝ] ℂ).integrable_comp hKneg
  have hconv := memLp_two_convolution_of_integrable_of_norm_le Kstar
    (h : Euclidean d → ℂ) hKstar h.integrable
    ‖h.toBoundedContinuousFunction‖ (norm_nonneg _)
    (fun x => BoundedContinuousFunction.norm_coe_le_norm h.toBoundedContinuousFunction x)
  have heq : convolutionPhysicalAdjoint K h = fun y : Euclidean d =>
      ∫ x : Euclidean d, h x * Kstar (y - x) := by
    funext y
    apply integral_congr_ae
    filter_upwards with x
    dsimp [convolutionPhysicalAdjoint, Kstar]
    congr 2
    congr 1
    abel
  rw [heq]
  exact hconv

private theorem inner_convolution_eq_physicalAdjoint
    {d : Nat} (K g : Euclidean d → ℂ) (h : SchwartzMap (Euclidean d) ℂ)
    (hK : Integrable K volume) (hg : Integrable g volume)
    (hg2 : MemLp g 2 volume)
    (hP : MemLp (fun x : Euclidean d => ∫ y : Euclidean d, g y * K (x - y)) 2 volume)
    (hA : MemLp (convolutionPhysicalAdjoint K h) 2 volume) :
    inner ℂ (hP.toLp (fun x : Euclidean d => ∫ y : Euclidean d, g y * K (x - y)))
        ((h.memLp 2 volume).toLp (h : Euclidean d → ℂ)) =
      inner ℂ (hg2.toLp g) (hA.toLp (convolutionPhysicalAdjoint K h)) := by
  rw [L2.inner_def, L2.inner_def]
  have hleft :
      (∫ x : Euclidean d,
        inner ℂ (hP.toLp (fun x : Euclidean d => ∫ y : Euclidean d, g y * K (x - y)) x)
          ((h.memLp 2 volume).toLp (h : Euclidean d → ℂ) x)) =
        ∫ x : Euclidean d, h x * conj (∫ y : Euclidean d, g y * K (x - y)) := by
    apply integral_congr_ae
    filter_upwards [hP.coeFn_toLp, (h.memLp 2 volume).coeFn_toLp] with x hPx hhx
    rw [hPx, hhx, RCLike.inner_apply]
  have hright :
      (∫ y : Euclidean d,
        inner ℂ (hg2.toLp g y) (hA.toLp (convolutionPhysicalAdjoint K h) y)) =
        ∫ y : Euclidean d, convolutionPhysicalAdjoint K h y * conj (g y) := by
    apply integral_congr_ae
    filter_upwards [hg2.coeFn_toLp, hA.coeFn_toLp] with y hgy hAy
    rw [hgy, hAy, RCLike.inner_apply]
  rw [hleft, hright]
  exact integral_schwartz_mul_star_convolution_eq K g h hK hg

private theorem lipschitz_extension_eq_physical_convolution
    {d : Nat} (K : Euclidean d → ℂ)
    (Tbar : Lp ℂ 2 (volume : Measure (Euclidean d)) → Lp ℂ 2 volume)
    (hTbarCont : Continuous Tbar) (hK : Integrable K volume)
    (hTbarCore : ∀ f : SchwartzMap (Euclidean d) ℂ,
      Tbar (f.toLp 2 volume) =
        (memLp_two_convolution_of_integrable_of_norm_le K (f : Euclidean d → ℂ)
          hK f.integrable ‖f.toBoundedContinuousFunction‖ (norm_nonneg _)
          (fun x => BoundedContinuousFunction.norm_coe_le_norm
            f.toBoundedContinuousFunction x)).toLp
          (fun x : Euclidean d => ∫ y : Euclidean d, f y * K (x - y)))
    (g : Euclidean d → ℂ) (hg : Integrable g volume) (hg2 : MemLp g 2 volume)
    (B : ℝ) (hB : 0 ≤ B) (hgB : ∀ x, ‖g x‖ ≤ B) :
    Tbar (hg2.toLp g) =
      (memLp_two_convolution_of_integrable_of_norm_le K g hK hg B hB hgB).toLp
        (fun x : Euclidean d => ∫ y : Euclidean d, g y * K (x - y)) := by
  letI : Fact (1 ≤ (2 : ENNReal)) := ⟨by norm_num⟩
  let hP : MemLp (fun x : Euclidean d => ∫ y : Euclidean d, g y * K (x - y)) 2 volume :=
    memLp_two_convolution_of_integrable_of_norm_le K g hK hg B hB hgB
  let hA : ∀ h : SchwartzMap (Euclidean d) ℂ,
      MemLp (convolutionPhysicalAdjoint K h) 2 volume := fun h =>
    memLp_two_convolutionPhysicalAdjoint_schwartz K h hK
  apply (SchwartzMap.denseRange_toLpCLM (E := Euclidean d) (F := ℂ)
    (p := (2 : ENNReal)) ENNReal.ofNat_ne_top).eq_of_inner_left ℂ
  intro h
  have hcorePair (f : SchwartzMap (Euclidean d) ℂ) :
      inner ℂ (Tbar (f.toLp 2 volume))
          ((h.memLp 2 volume).toLp (h : Euclidean d → ℂ)) =
        inner ℂ (f.toLp 2 volume)
          ((hA h).toLp (convolutionPhysicalAdjoint K h)) := by
    rw [hTbarCore f]
    exact inner_convolution_eq_physicalAdjoint K (f : Euclidean d → ℂ) h hK f.integrable
      (f.memLp 2 volume)
      (memLp_two_convolution_of_integrable_of_norm_le K (f : Euclidean d → ℂ)
        hK f.integrable ‖f.toBoundedContinuousFunction‖ (norm_nonneg _)
        (fun x => BoundedContinuousFunction.norm_coe_le_norm f.toBoundedContinuousFunction x))
      (hA h)
  have hpairs (G : Lp ℂ 2 (volume : Measure (Euclidean d))) :
      inner ℂ (Tbar G) ((h.memLp 2 volume).toLp (h : Euclidean d → ℂ)) =
        inner ℂ G ((hA h).toLp (convolutionPhysicalAdjoint K h)) := by
    let left : Lp ℂ 2 (volume : Measure (Euclidean d)) → ℂ := fun G =>
      inner ℂ (Tbar G) ((h.memLp 2 volume).toLp (h : Euclidean d → ℂ))
    let right : Lp ℂ 2 (volume : Measure (Euclidean d)) → ℂ := fun G =>
      inner ℂ G ((hA h).toLp (convolutionPhysicalAdjoint K h))
    have hleftCont : Continuous left := by
      change Continuous (fun G : Lp ℂ 2 (volume : Measure (Euclidean d)) =>
        inner ℂ (Tbar G) ((h.memLp 2 volume).toLp (h : Euclidean d → ℂ)))
      exact continuous_inner.comp (hTbarCont.prodMk continuous_const)
    have hrightCont : Continuous right := by
      change Continuous (fun G : Lp ℂ 2 (volume : Measure (Euclidean d)) =>
        inner ℂ G ((hA h).toLp (convolutionPhysicalAdjoint K h)))
      exact continuous_inner.comp (continuous_id.prodMk continuous_const)
    have heq : left ∘ (fun f : SchwartzMap (Euclidean d) ℂ => f.toLp 2 volume) =
        right ∘ (fun f : SchwartzMap (Euclidean d) ℂ => f.toLp 2 volume) := by
      funext f
      exact hcorePair f
    change left G = right G
    exact congrFun
      ((SchwartzMap.denseRange_toLpCLM (E := Euclidean d) (F := ℂ)
        (p := (2 : ENNReal)) ENNReal.ofNat_ne_top).equalizer hleftCont hrightCont heq) G
  calc
    inner ℂ (Tbar (hg2.toLp g)) ((h.memLp 2 volume).toLp (h : Euclidean d → ℂ)) =
        inner ℂ (hg2.toLp g) ((hA h).toLp (convolutionPhysicalAdjoint K h)) :=
      hpairs (hg2.toLp g)
    _ = inner ℂ (hP.toLp (fun x : Euclidean d => ∫ y : Euclidean d, g y * K (x - y)))
        ((h.memLp 2 volume).toLp (h : Euclidean d → ℂ)) :=
      (inner_convolution_eq_physicalAdjoint K g h hK hg hg2 hP (hA h)).symm

/-- A finite physical lacunary maximum inherits an `L²` estimate from the
corresponding estimate on Schwartz inputs.  The core hypotheses are stated
with the literal finite maximum, so this is the direct bridge used by the
Calderón--Zygmund good part. -/
theorem memLp_two_lacunaryRelativeBandpassFinitePhysicalMaximal_of_core_bound
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (r : ℤ → PositiveRadius) (S : Finset ℤ) (hS : S.Nonempty)
    (C : ℝ) (hC : 0 ≤ C)
    (hcoreMem : ∀ f : SchwartzMap (Euclidean d) ℂ,
      MemLp (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
        (f : Euclidean d → ℂ)) 2 volume)
    (hcoreBound : ∀ f : SchwartzMap (Euclidean d) ℂ,
      ‖(hcoreMem f).toLp
        (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
          (f : Euclidean d → ℂ))‖ ≤ C * ‖f.toLp 2 volume‖)
    (g : Euclidean d → ℂ) (hg : Integrable g volume)
    (hg2 : MemLp g 2 volume) (B : ℝ) (hB : 0 ≤ B)
    (hgB : ∀ x, ‖g x‖ ≤ B) :
    ∃ hmax : MemLp
        (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS g) 2 volume,
      ‖hmax.toLp
        (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS g)‖ ≤
        C * ‖hg2.toLp g‖ := by
  classical
  letI : Fact (1 ≤ (2 : ENNReal)) := ⟨by norm_num⟩
  have hindividual :=
    exists_lipschitz_lacunaryRelativeBandpassPhysicalTerm_extension
      psi j r S hS C hC hcoreMem hcoreBound
  choose Tbar hTbarCore hTbarLip using hindividual
  have hSattach : S.attach.Nonempty := by
    rcases hS with ⟨k, hk⟩
    exact ⟨⟨k, hk⟩, by simp⟩
  let Mbar : Lp ℂ 2 (volume : Measure (Euclidean d)) → Lp ℝ 2 volume := fun G =>
    S.attach.sup' hSattach (fun k => lpPointwiseNorm (Tbar k G))
  have hMbarCont : Continuous Mbar := by
    let U : ↥S → Lp ℂ 2 (volume : Measure (Euclidean d)) → Lp ℝ 2 volume :=
      fun k => lpPointwiseNorm ∘ Tbar k
    change Continuous (fun G => S.attach.sup' hSattach
      (fun k => U k G))
    rw [show (fun G => S.attach.sup' hSattach (fun k => U k G)) =
        S.attach.sup' hSattach U by
          funext G
          exact (Finset.sup'_apply hSattach U G).symm]
    exact Continuous.finset_sup' hSattach
      (fun k _ => continuous_lpPointwiseNorm.comp (hTbarLip k).continuous)
  let coreLp : SchwartzMap (Euclidean d) ℂ → Lp ℝ 2 volume := fun f =>
    (hcoreMem f).toLp (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
      (f : Euclidean d → ℂ))
  have hTbarCoreCoe (k : ↥S) (f : SchwartzMap (Euclidean d) ℂ) :
      (Tbar k (f.toLp 2 volume) : Euclidean d → ℂ) =ᵐ[volume]
        lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ)
          (f : Euclidean d → ℂ) := by
    rw [hTbarCore k f]
    exact (memLp_two_lacunaryRelativeBandpassPhysicalTerm_of_integrable_of_norm_le
      psi j (r k.1).2 (f : Euclidean d → ℂ) f.integrable
      ‖f.toBoundedContinuousFunction‖ (norm_nonneg _)
      (fun x => BoundedContinuousFunction.norm_coe_le_norm
        f.toBoundedContinuousFunction x)).coeFn_toLp
  have hMbarCoreLe (f : SchwartzMap (Euclidean d) ℂ) :
      Mbar (f.toLp 2 volume) ≤ coreLp f := by
    change S.attach.sup' hSattach (fun k =>
      lpPointwiseNorm (Tbar k (f.toLp 2 volume))) ≤ coreLp f
    apply Finset.sup'_le hSattach _
    intro k _
    apply (Lp.coeFn_le _ _).mp
    filter_upwards [lpPointwiseNorm_coe (Tbar k (f.toLp 2 volume)),
      hTbarCoreCoe k f, (hcoreMem f).coeFn_toLp] with x hN hT hM
    rw [hN, hT, hM]
    exact Finset.le_sup' (fun n : ℤ =>
      ‖lacunaryRelativeBandpassPhysicalTerm psi j (r n : ℝ)
        (f : Euclidean d → ℂ) x‖) k.2
  have hCoordNonneg (k : ↥S) (G : Lp ℂ 2 (volume : Measure (Euclidean d))) :
      0 ≤ lpPointwiseNorm (Tbar k G) := by
    apply (Lp.coeFn_le _ _).mp
    filter_upwards [Lp.coeFn_zero ℝ 2 volume,
      lpPointwiseNorm_coe (Tbar k G)] with x hzero hN
    rw [hzero, hN]
    exact norm_nonneg ((Tbar k G : Euclidean d → ℂ) x)
  have hMbarNonneg (G : Lp ℂ 2 (volume : Measure (Euclidean d))) : 0 ≤ Mbar G := by
    let k0 : ↥S := hSattach.choose
    have hle : lpPointwiseNorm (Tbar k0 G) ≤ Mbar G := by
      change lpPointwiseNorm (Tbar k0 G) ≤
        S.attach.sup' hSattach (fun k => lpPointwiseNorm (Tbar k G))
      exact Finset.le_sup' (fun k => lpPointwiseNorm (Tbar k G)) hSattach.choose_spec
    exact (hCoordNonneg k0 G).trans hle
  have hMbarCoreNorm (f : SchwartzMap (Euclidean d) ℂ) :
      ‖Mbar (f.toLp 2 volume)‖ ≤ ‖coreLp f‖ := by
    apply Lp.norm_le_norm_of_ae_le
    filter_upwards [(Lp.coeFn_le _ _).mpr (hMbarCoreLe f),
      (Lp.coeFn_le _ _).mpr (hMbarNonneg (f.toLp 2 volume)),
      Lp.coeFn_zero ℝ 2 volume, (hcoreMem f).coeFn_toLp]
      with x hle hnonneg hzero hcore
    have hnonneg' : 0 ≤ (Mbar (f.toLp 2 volume) : Euclidean d → ℝ) x := by
      rw [hzero] at hnonneg
      simpa only [Pi.zero_apply] using hnonneg
    have hle' : (Mbar (f.toLp 2 volume) : Euclidean d → ℝ) x ≤
        lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
          (f : Euclidean d → ℂ) x := by
      rw [hcore] at hle
      exact hle
    rw [Real.norm_of_nonneg hnonneg', hcore, Real.norm_of_nonneg]
    · exact hle'
    · exact le_trans (norm_nonneg _)
        (Finset.le_sup' (fun n : ℤ =>
          ‖lacunaryRelativeBandpassPhysicalTerm psi j (r n : ℝ)
            (f : Euclidean d → ℂ) x‖) hS.choose_spec)
  have hMbarCoreBound (f : SchwartzMap (Euclidean d) ℂ) :
      ‖Mbar (f.toLp 2 volume)‖ ≤ C * ‖f.toLp 2 volume‖ := by
    exact (hMbarCoreNorm f).trans (hcoreBound f)
  have hMbarBound (G : Lp ℂ 2 (volume : Measure (Euclidean d))) :
      ‖Mbar G‖ ≤ C * ‖G‖ := by
    refine (SchwartzMap.denseRange_toLpCLM (E := Euclidean d) (F := ℂ)
      (p := (2 : ENNReal)) ENNReal.ofNat_ne_top).induction_on G ?_ ?_
    · exact isClosed_le (continuous_norm.comp hMbarCont)
        (continuous_const.mul continuous_norm)
    · intro f
      simpa only [SchwartzMap.toLpCLM_apply] using hMbarCoreBound f
  let hterm : ∀ k : ↥S,
      MemLp (lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ) g) 2 volume :=
    fun k => memLp_two_lacunaryRelativeBandpassPhysicalTerm_of_integrable_of_norm_le
      psi j (r k.1).2 g hg B hB hgB
  have hTbarPhysical (k : ↥S) :
      Tbar k (hg2.toLp g) =
        (hterm k).toLp
          (lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ) g) := by
    change Tbar k (hg2.toLp g) = (hterm k).toLp (fun x : Euclidean d =>
      ∫ y : Euclidean d, g y *
        lacunaryRelativeBandpassPhysicalKernel psi j (r k.1 : ℝ) (x - y))
    exact lipschitz_extension_eq_physical_convolution
      (lacunaryRelativeBandpassPhysicalKernel psi j (r k.1 : ℝ))
      (Tbar k) (hTbarLip k).continuous
      (integrable_lacunaryRelativeBandpassPhysicalKernel psi j (r k.1).2)
      (by
        intro f
        rw [hTbarCore k f]
        rfl)
      g hg hg2 B hB hgB
  have hTbarPhysicalCoe (k : ↥S) :
      (Tbar k (hg2.toLp g) : Euclidean d → ℂ) =ᵐ[volume]
        lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ) g := by
    rw [hTbarPhysical k]
    exact (hterm k).coeFn_toLp
  have hCoordLe (k : ↥S) :
      lpPointwiseNorm (Tbar k (hg2.toLp g)) ≤ Mbar (hg2.toLp g) := by
    change lpPointwiseNorm (Tbar k (hg2.toLp g)) ≤
      S.attach.sup' hSattach (fun l => lpPointwiseNorm (Tbar l (hg2.toLp g)))
    exact Finset.le_sup' (fun l => lpPointwiseNorm (Tbar l (hg2.toLp g))) (by simp)
  have hCoordAE (k : ↥S) : ∀ᵐ x : Euclidean d,
      ‖lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ) g x‖ ≤
        (Mbar (hg2.toLp g) : Euclidean d → ℝ) x := by
    filter_upwards [lpPointwiseNorm_coe (Tbar k (hg2.toLp g)),
      hTbarPhysicalCoe k, (Lp.coeFn_le _ _).mpr (hCoordLe k)] with x hN hT hle
    calc
      ‖lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ) g x‖ =
          ‖(Tbar k (hg2.toLp g) : Euclidean d → ℂ) x‖ := by rw [hT]
      _ = (lpPointwiseNorm (Tbar k (hg2.toLp g)) : Euclidean d → ℝ) x := hN.symm
      _ ≤ (Mbar (hg2.toLp g) : Euclidean d → ℝ) x := hle
  have hcoordsAux (t : Finset ↥S) : ∀ᵐ x : Euclidean d,
      ∀ k ∈ t, ‖lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ) g x‖ ≤
        (Mbar (hg2.toLp g) : Euclidean d → ℝ) x := by
    induction t using Finset.induction_on with
    | empty =>
        filter_upwards with x k hk
        simp at hk
    | insert a t hat ih =>
        filter_upwards [hCoordAE a, ih] with x ha ht k hk
        rcases Finset.mem_insert.mp hk with hka | hkt
        · subst k
          exact ha
        · exact ht k hkt
  have hphysicalLe : ∀ᵐ x : Euclidean d,
      lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS g x ≤
        (Mbar (hg2.toLp g) : Euclidean d → ℝ) x := by
    filter_upwards [hcoordsAux S.attach] with x hx
    apply Finset.sup'_le hS _
    intro k hk
    exact hx ⟨k, hk⟩ (by simp)
  have hphysicalMem : MemLp
      (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS g) 2 volume := by
    let F : ℤ → Euclidean d → ℝ := fun k x =>
      ‖lacunaryRelativeBandpassPhysicalTerm psi j (r k : ℝ) g x‖
    change MemLp (fun x => S.sup' hS (fun k => F k x)) 2 volume
    rw [show (fun x => S.sup' hS (fun k => F k x)) = S.sup' hS F by
      funext x
      exact (Finset.sup'_apply hS F x).symm]
    refine Finset.sup'_induction (p := fun F : Euclidean d → ℝ => MemLp F 2 volume) hS
      F ?_ ?_
    · intro F hF G hG
      exact hF.sup hG
    · intro k hk
      exact (hterm ⟨k, hk⟩).norm
  have hphysicalNonneg (x : Euclidean d) : 0 ≤
      lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS g x := by
    exact le_trans (norm_nonneg _)
      (Finset.le_sup' (fun k =>
        ‖lacunaryRelativeBandpassPhysicalTerm psi j (r k : ℝ) g x‖)
        hS.choose_spec)
  have hphysicalNorm :
      ‖hphysicalMem.toLp
        (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS g)‖ ≤
        ‖Mbar (hg2.toLp g)‖ := by
    apply Lp.norm_le_norm_of_ae_le
    filter_upwards [hphysicalLe,
      (Lp.coeFn_le _ _).mpr (hMbarNonneg (hg2.toLp g)),
      Lp.coeFn_zero ℝ 2 volume, hphysicalMem.coeFn_toLp]
      with x hle hnonneg hzero hphysical
    have hnonneg' : 0 ≤ (Mbar (hg2.toLp g) : Euclidean d → ℝ) x := by
      rw [hzero] at hnonneg
      simpa only [Pi.zero_apply] using hnonneg
    rw [hphysical, Real.norm_of_nonneg (hphysicalNonneg x),
      Real.norm_of_nonneg hnonneg']
    exact hle
  exact ⟨hphysicalMem, hphysicalNorm.trans (hMbarBound (hg2.toLp g))⟩

end

