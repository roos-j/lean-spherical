    (l := 0) (u := 1) (z := (theta : Complex)) (by norm_num)
    hz hanalytic hbounded hleft hright

/--
An explicit analytic-pairing datum for Riesz--Thorin interpolation.

The usual proof does not apply three-lines directly to `T f`: both the input
and the dual test function are deformed with the strip variable.  Rather than
hiding that construction in an unsound blanket theorem about arbitrary
`Lp`-spaces, this structure records exactly the data it must supply.  The
`inputNorm` and `outputNorm` fields are intended to be the interpolated
`Lᵖ` norms (or the corresponding vector-valued norms).  `norming` is the
standard duality step saying that the specified normalized tests determine
the output norm.

The endpoint fields already include the analytic input and dual-test
normalizations.  Consequently the theorem below is applicable both to the
scalar and to the `Lᵖ(X; ℓ²)` source form once those standard deformations
have been constructed. -/
structure RieszThorinAnalyticDatum
    {X Y : Type*} [AddCommMonoid X] [Module Complex X]
    [AddCommMonoid Y] [Module Complex Y]
    (T : X →ₗ[Complex] Y) (inputNorm : X → Real) (outputNorm : Y → Real)
    (M₀ M₁ theta : Real) where
  /-- Normalized output tests, normally the unit ball of the dual `L^{p'}`. -/
  Test : Type*
  /-- The scalar pairing against a normalized output test. -/
  pairing : Y → Test → Complex
  /-- Analytic deformation of an interpolated source vector. -/
  inputFamily : X → Complex → X
  /-- Analytic deformation of a normalized output test. -/
  testFamily : Test → Complex → Test
  theta_mem : theta ∈ Icc (0 : Real) 1
  inputNorm_nonneg : ∀ x, 0 ≤ inputNorm x
  inputNorm_eq_zero : ∀ x, inputNorm x = 0 → x = 0
  outputNorm_zero : outputNorm 0 = 0
  M₀_nonneg : 0 ≤ M₀
  M₁_nonneg : 0 ≤ M₁
  input_theta : ∀ x, inputFamily x (theta : Complex) = x
  test_theta : ∀ g, testFamily g (theta : Complex) = g
  analytic : ∀ x g,
    ScalarAnalyticFamily 0 1
      (fun z => pairing (T (inputFamily x z)) (testFamily g z))
  bounded : ∀ x g,
    BddAbove ((norm ∘ fun z => pairing (T (inputFamily x z)) (testFamily g z)) ''
      verticalClosedStrip 0 1)
  left : ∀ x g w, w ∈ Complex.re ⁻¹' ({(0 : Real)} : Set Real) →
    ‖pairing (T (inputFamily x w)) (testFamily g w)‖ ≤ M₀ * inputNorm x
  right : ∀ x g w, w ∈ Complex.re ⁻¹' ({(1 : Real)} : Set Real) →
    ‖pairing (T (inputFamily x w)) (testFamily g w)‖ ≤ M₁ * inputNorm x
  norming : ∀ y C, (∀ g, ‖pairing y g‖ ≤ C) → outputNorm y ≤ C

/--
Riesz--Thorin interpolation from an explicitly supplied analytic pairing
datum.  In the standard `Lp` application, `inputNorm` and `outputNorm` are
the `Lᵖ` norms, `Test` is the normalized `L^{p'}` test class, and the four
analytic-family fields are supplied by the usual complex powers.  Thus this
is the genuine different-exponent conclusion, while all measurability and
integrability work needed to build the powers remains visible to the caller.
-/
theorem rieszThorin_of_analyticDatum
    {X Y : Type*} [AddCommMonoid X] [Module Complex X]
    [AddCommMonoid Y] [Module Complex Y]
    {T : X →ₗ[Complex] Y} {inputNorm : X → Real} {outputNorm : Y → Real}
    {M₀ M₁ theta : Real}
  (D : RieszThorinAnalyticDatum T inputNorm outputNorm M₀ M₁ theta)
    (x : X) :
    outputNorm (T x) ≤ M₀ ^ (1 - theta) * M₁ ^ theta * inputNorm x := by
  by_cases hx : x = 0
  · subst x
    rw [map_zero, D.outputNorm_zero]
    exact mul_nonneg
      (mul_nonneg (Real.rpow_nonneg D.M₀_nonneg _) (Real.rpow_nonneg D.M₁_nonneg _))
      (D.inputNorm_nonneg 0)
  have hinput_ne : inputNorm x ≠ 0 := by
    intro hzero
    exact hx (D.inputNorm_eq_zero x hzero)
  have hinput_pos : 0 < inputNorm x :=
    lt_of_le_of_ne (D.inputNorm_nonneg x) (Ne.symm hinput_ne)
  apply D.norming (T x) _
  intro g
  have hscalar := scalarThreeLines_unit
    (F := fun z => D.pairing (T (D.inputFamily x z)) (D.testFamily g z))
    (A0 := M₀ * inputNorm x) (A1 := M₁ * inputNorm x) D.theta_mem
    (D.analytic x g) (D.bounded x g)
    (by
      intro w hw
      exact D.left x g w hw)
    (by
      intro w hw
      exact D.right x g w hw)
  rw [D.input_theta x, D.test_theta g] at hscalar
  calc
    ‖D.pairing (T x) g‖ ≤
        (M₀ * inputNorm x) ^ (1 - theta) * (M₁ * inputNorm x) ^ theta := hscalar
    _ = M₀ ^ (1 - theta) * M₁ ^ theta * inputNorm x := by
      rw [Real.mul_rpow D.M₀_nonneg (D.inputNorm_nonneg x),
        Real.mul_rpow D.M₁_nonneg (D.inputNorm_nonneg x)]
      have hpow : inputNorm x ^ (1 - theta) * inputNorm x ^ theta = inputNorm x := by
        have hsum : (1 - theta) + theta = (1 : Real) := by ring
        calc
          inputNorm x ^ (1 - theta) * inputNorm x ^ theta =
              inputNorm x ^ ((1 - theta) + theta) := (Real.rpow_add hinput_pos _ _).symm
          _ = inputNorm x ^ (1 : Real) := by rw [hsum]
          _ = inputNorm x := by simp only [Real.rpow_one]
      calc
        M₀ ^ (1 - theta) * inputNorm x ^ (1 - theta) *
            (M₁ ^ theta * inputNorm x ^ theta) =
            (M₀ ^ (1 - theta) * M₁ ^ theta) *
              (inputNorm x ^ (1 - theta) * inputNorm x ^ theta) := by ring
        _ = M₀ ^ (1 - theta) * M₁ ^ theta * inputNorm x := by rw [hpow]

/-! ## Direct real interpolation from a strong `L^q` endpoint and `L∞`

The standard Riesz--Thorin theorem in the blueprint is sharp and complex
analytic.  The following result is its independent real-interpolation
counterpart at an upper `L∞` endpoint.  It is deliberately stated for raw
measurable, normed-space-valued inputs and a nonnegative sublinear output.
The proof uses the canonical amplitude truncations and the layer-cake
argument already formalized in `InterpolationTail`; in particular it does
not hide any analytic-family hypothesis in the statement.

The coefficient is not the sharp complex-interpolation coefficient: it has
the usual explicit Marcinkiewicz loss depending on `p` and `p - q`.  This is
nevertheless the form that is useful for the `L^4`--`L∞` part of the MSS
argument once endpoint estimates are available pointwise. -/

/-- The canonical real-interpolation conclusion in integral form.  A strong
`L^q` endpoint is supplied in its equivalent `q`-th-power lower-integral
form, while the `L∞` endpoint is a pointwise bound on bounded inputs.  The
input and output are unbundled functions, so this applies equally to scalar
functions and to vector-valued source functions such as `ℓ²` families. -/
theorem rieszThorin_q_top_lintegral
    {α E : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    [MeasurableSpace E] [BorelSpace E]
    {μ : Measure α} [SFinite μ]
    (T : (α → E) → α → Real)
    (hT_nonneg : ∀ g x, 0 ≤ T g x)
    (hT_subadd : ∀ g h x, T (g + h) x ≤ T g x + T h x)
    (hTmeas : ∀ g, AEMeasurable (T g) μ)
    {q : Real} (hq : 0 < q) (Cq : ENNReal) (hCq : Cq < ∞)
    (hstrong_q : ∀ g : α → E, Measurable g →
      (∫⁻ x, (ENNReal.ofReal (T g x)) ^ q ∂μ) ≤
        Cq * ∫⁻ x, (ENNReal.ofReal ‖g x‖) ^ q ∂μ)
    (Ctop : Real) (hCtop : 0 < Ctop)
    (hT_top : ∀ (g : α → E) (a : Real), 0 ≤ a →
      (∀ x, ‖g x‖ ≤ a) → ∀ x, T g x ≤ Ctop * a)
    {p : Real} (hqp : q < p)
    (f : α → E) (hf : Measurable f) :
    (∫⁻ x, ENNReal.ofReal ((T f x) ^ p) ∂μ) ≤
      ENNReal.ofReal p *
        ((ENNReal.ofReal (2 : Real)) ^ q * Cq *
          ((ENNReal.ofReal (p - q))⁻¹ *
            (ENNReal.ofReal (2 : Real)) ^ (p - q) *
              ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ) *
          (ENNReal.ofReal Ctop) ^ (p - q)) := by
  let D : Set (α → E) := {g | Measurable g}
  let u : α → Real := fun x => ‖f x‖
  let low : Real → α → E := fun t => {x | u x < t / 2}.indicator f
  let high : Real → α → E := fun t => {x | t / 2 ≤ u x}.indicator f
  have hu : Measurable u := by
    simpa only [u] using hf.norm
  have hu_nonneg : ∀ x, 0 ≤ u x := fun x => by
    dsimp only [u]
    exact norm_nonneg _
  have hp : 0 < p := hq.trans hqp
  have hweak_q : ∀ (g : α → E), g ∈ D → ∀ {s : Real}, 0 < s →
      (ENNReal.ofReal s) ^ q * μ {x | s < T g x} ≤
        Cq * ∫⁻ x, (ENNReal.ofReal ‖g x‖) ^ q ∂μ := by
    intro g hg s hs
    have hgmeas : Measurable g := hg
    calc
      (ENNReal.ofReal s) ^ q * μ {x | s < T g x} ≤
          (ENNReal.ofReal s) ^ q *
            μ {x | (ENNReal.ofReal s) ^ q ≤
              (ENNReal.ofReal (T g x)) ^ q} := by
        apply mul_le_mul_right
        apply measure_mono
        intro x hx
        change ENNReal.ofReal s ^ q ≤ ENNReal.ofReal (T g x) ^ q
        exact ENNReal.rpow_le_rpow
          (ENNReal.ofReal_le_ofReal (le_of_lt hx)) hq.le
      _ ≤ ∫⁻ x, (ENNReal.ofReal (T g x)) ^ q ∂μ :=
        mul_meas_ge_le_lintegral₀
          (ENNReal.continuous_rpow_const.measurable.comp_aemeasurable
            ((hTmeas g).ennreal_ofReal)) ((ENNReal.ofReal s) ^ q)
      _ ≤ Cq * ∫⁻ x, (ENNReal.ofReal ‖g x‖) ^ q ∂μ :=
        hstrong_q g hgmeas
  have hsub : ∀ ⦃g h : α → E⦄, g ∈ D → h ∈ D →
      ∀ x, T (g + h) x ≤ T g x + T h x := by
    intro g h _ _ x
    exact hT_subadd g h x
  have htop : ∀ (g : α → E), g ∈ D → ∀ (a : Real), 0 ≤ a →
      (∀ x, ‖g x‖ ≤ a) → ∀ x, T g x ≤ Ctop * a := by
    intro g _ a ha hga x
    exact hT_top g a ha hga x
  have hlow_mem : ∀ t, low t ∈ D := by
    intro t
    change Measurable ({x | u x < t / 2}.indicator f)
    exact hf.indicator (measurableSet_lt hu measurable_const)
  have hhigh_mem : ∀ t, high t ∈ D := by
    intro t
    change Measurable ({x | t / 2 ≤ u x}.indicator f)
    exact hf.indicator (measurableSet_le measurable_const hu)
  have hsplit : ∀ t, f = low t + high t := by
    intro t
    funext x
    by_cases hx : u x < t / 2
    · simp [low, high, hx]
    · have hx' : t / 2 ≤ u x := le_of_not_gt hx
      simp [low, high, hx, hx']
  have hlow_norm : ∀ t, 0 < t → ∀ x, ‖low t x‖ ≤ t / 2 := by
    intro t ht x
    change ‖{x | u x < t / 2}.indicator f x‖ ≤ t / 2
    by_cases hx : u x < t / 2
    · simpa [hx, u] using hx.le
    · have hx' : x ∉ {x | u x < t / 2} := by
        simpa only [Set.mem_setOf_eq] using hx
      rw [Set.indicator_of_notMem hx', norm_zero]
      positivity
  have hhigh_norm (t : Real) :
      (∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ) =
        ∫⁻ x in {x | t / 2 ≤ u x}, (ENNReal.ofReal (u x)) ^ q ∂μ := by
    change (∫⁻ x,
      (ENNReal.ofReal ‖{x | t / 2 ≤ u x}.indicator f x‖) ^ q ∂μ) = _
    have hset : MeasurableSet {x | t / 2 ≤ u x} :=
      measurableSet_le measurable_const hu
    rw [← lintegral_indicator hset]
    apply lintegral_congr
    intro x
    by_cases hx : t / 2 ≤ u x
    · simp [hx, u]
    · simp [hx, ENNReal.zero_rpow_of_pos hq]
  have hhighI_meas : Measurable (fun t : Real =>
      ∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ) := by
    let baseI : Real → ENNReal := fun s =>
      ∫⁻ x in {x | s ≤ u x}, (ENNReal.ofReal (u x)) ^ q ∂μ
    have hbaseI : Measurable baseI := by
      dsimp only [baseI]
      exact Codex.Spherical.InterpolationCore.measurable_lintegral_indicator_le u hu _
        (ENNReal.continuous_rpow_const.measurable.comp hu.ennreal_ofReal)
    have hfun : (fun t : Real =>
        ∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ) =
        fun t => baseI (t / 2) := by
      funext t
      exact hhigh_norm t
    rw [hfun]
    exact hbaseI.comp (measurable_id.div_const 2)
  let Aq : ENNReal := (ENNReal.ofReal (p - q))⁻¹ *
    (ENNReal.ofReal (2 : Real)) ^ (p - q) *
      ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ
  have hhigh_tail :
      (∫⁻ t in Ioi (0 : Real),
        (∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ) *
          (ENNReal.ofReal t) ^ (p - q - 1)) ≤ Aq := by
    calc
      (∫⁻ t in Ioi (0 : Real),
        (∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ) *
          (ENNReal.ofReal t) ^ (p - q - 1)) =
          ∫⁻ t in Ioi (0 : Real),
            (∫⁻ x in {x | t / 2 ≤ u x},
              (ENNReal.ofReal (u x)) ^ q ∂μ) *
              (ENNReal.ofReal t) ^ (p - q - 1) := by
          apply lintegral_congr
          intro t
          rw [hhigh_norm t]
      _ ≤ Aq := by
          exact le_of_eq (by
            simpa only [Aq, u] using
              (Codex.Spherical.InterpolationTail.lintegral_high_tail_rpow_eq
                u hu hu_nonneg hq hqp))
  simpa only [D, Aq] using
    (Codex.Spherical.InterpolationTail.marcinkiewicz_weak_q_top_on_additive_split_ennreal_top_scaled
      D (fun g : α → E => g) T hT_nonneg hsub q hq Cq Ctop hCtop
      hweak_q htop hqp f (hTmeas f) low high hlow_mem hhigh_mem hsplit hlow_norm
      hhighI_meas Aq hhigh_tail)

/-- The elementary power identity used to pass from a weak `L^q` level-set
bound to the `L^p` layer-cake integral. -/
theorem rieszThorin_ofReal_rpow_weight_q
    {q p t : Real} (ht : 0 < t) :
    ENNReal.ofReal (t ^ (p - 1)) =
      (ENNReal.ofReal (2 : Real)) ^ q *
        ((ENNReal.ofReal (t / 2)) ^ q *
          ENNReal.ofReal (t ^ (p - q - 1))) := by
  have hreal : t ^ (p - 1) =
      2 ^ q * ((t / 2) ^ q * t ^ (p - q - 1)) := by
    calc
      t ^ (p - 1) = t ^ q * t ^ (p - q - 1) := by
        rw [← Real.rpow_add ht]
        congr 1
        ring
      _ = (2 * (t / 2)) ^ q * t ^ (p - q - 1) := by
        congr 2
        ring
      _ = 2 ^ q * ((t / 2) ^ q * t ^ (p - q - 1)) := by
        rw [Real.mul_rpow (by norm_num) (by positivity)]
        ring
  calc
    ENNReal.ofReal (t ^ (p - 1)) =
        ENNReal.ofReal (2 ^ q * ((t / 2) ^ q * t ^ (p - q - 1))) :=
      congrArg ENNReal.ofReal hreal
    _ = (ENNReal.ofReal (2 : Real)) ^ q *
        ((ENNReal.ofReal (t / 2)) ^ q *
          ENNReal.ofReal (t ^ (p - q - 1))) := by
      rw [ENNReal.ofReal_mul (Real.rpow_nonneg (by norm_num) _)]
      rw [ENNReal.ofReal_mul (Real.rpow_nonneg (by positivity) _)]
      rw [← ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : Real) < 2)]
      rw [← ENNReal.ofReal_rpow_of_pos (by positivity : 0 < t / 2)]

/-- Direct, source--target real interpolation between a strong `L^q`
endpoint and a pointwise `L∞` contraction.  Unlike the earlier
same-measure-space Marcinkiewicz interfaces, the source `α, μ` and target
`β, ν` are independent.  This is therefore usable for a spatial-to-
space--time operator such as the MSS half-wave operator. -/
theorem rieszThorin_q_top_lintegral_source_output
    {α β E : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    {μ : Measure α} {ν : Measure β} [SFinite μ] [SFinite ν]
    (T : (α → E) → β → Real)
    (hT_nonneg : ∀ g y, 0 ≤ T g y)
    (hT_subadd : ∀ g h y, T (g + h) y ≤ T g y + T h y)
    (hTmeas : ∀ g, AEMeasurable (T g) ν)
    {q : Real} (hq : 0 < q) (Cq : ENNReal)
    (hstrong_q : ∀ g : α → E, Measurable g →
      (∫⁻ y, (ENNReal.ofReal (T g y)) ^ q ∂ν) ≤
        Cq * ∫⁻ x, (ENNReal.ofReal ‖g x‖) ^ q ∂μ)
    (hT_top : ∀ (g : α → E) (a : Real), 0 ≤ a →
      (∀ x, ‖g x‖ ≤ a) → ∀ y, T g y ≤ a)
    {p : Real} (hqp : q < p)
    (f : α → E) (hf : Measurable f) :
    (∫⁻ y, ENNReal.ofReal ((T f y) ^ p) ∂ν) ≤
      ENNReal.ofReal p *
        ((ENNReal.ofReal (2 : Real)) ^ q * Cq *
          ((ENNReal.ofReal (p - q))⁻¹ *
            (ENNReal.ofReal (2 : Real)) ^ (p - q) *
              ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ)) := by
  let u : α → Real := fun x => ‖f x‖
  let low : Real → α → E := fun t => {x | u x < t / 2}.indicator f
  let high : Real → α → E := fun t => {x | t / 2 ≤ u x}.indicator f
  have hu : Measurable u := by
    simpa only [u] using hf.norm
  have hu_nonneg : ∀ x, 0 ≤ u x := fun x => by
    dsimp only [u]
    exact norm_nonneg _
  have hp : 0 < p := hq.trans hqp
  have hlow_meas (t : Real) : Measurable (low t) := by
    change Measurable ({x | u x < t / 2}.indicator f)
    exact hf.indicator (measurableSet_lt hu measurable_const)
  have hhigh_meas (t : Real) : Measurable (high t) := by
    change Measurable ({x | t / 2 ≤ u x}.indicator f)
    exact hf.indicator (measurableSet_le measurable_const hu)
  have hsplit (t : Real) : f = low t + high t := by
    funext x
    by_cases hx : u x < t / 2
    · simp [low, high, hx]
    · have hx' : t / 2 ≤ u x := le_of_not_gt hx
      simp [low, high, hx, hx']
  have hlow_norm (t : Real) (ht : 0 < t) : ∀ x, ‖low t x‖ ≤ t / 2 := by
    intro x
    change ‖{x | u x < t / 2}.indicator f x‖ ≤ t / 2
    by_cases hx : u x < t / 2
    · simpa [hx, u] using hx.le
    · have hx' : x ∉ {x | u x < t / 2} := by
        simpa only [Set.mem_setOf_eq] using hx
      rw [Set.indicator_of_notMem hx', norm_zero]
      positivity
  have hlow_bound (t : Real) (ht : 0 < t) (y : β) :
      T (low t) y ≤ t / 2 := by
    exact hT_top (low t) (t / 2) (by positivity) (hlow_norm t ht) y
  have hdistribution (t : Real) (ht : 0 < t) :
      ν {y | t < T f y} ≤ ν {y | t / 2 < T (high t) y} := by
    apply measure_mono
    intro y hy
    rw [hsplit t] at hy
    have hsum := hT_subadd (low t) (high t) y
    have hlow := hlow_bound t ht y
    by_contra h
    have hhigh : T (high t) y ≤ t / 2 := le_of_not_gt h
    have hbound : T (low t + high t) y ≤ t := by
      calc
        T (low t + high t) y ≤ T (low t) y + T (high t) y := hsum
        _ ≤ t / 2 + t / 2 := add_le_add hlow hhigh
        _ = t := by ring
    exact (not_lt_of_ge hbound) hy
  have hhigh_norm (t : Real) :
      (∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ) =
        ∫⁻ x in {x | t / 2 ≤ u x}, (ENNReal.ofReal (u x)) ^ q ∂μ := by
    change (∫⁻ x,
      (ENNReal.ofReal ‖{x | t / 2 ≤ u x}.indicator f x‖) ^ q ∂μ) = _
    have hset : MeasurableSet {x | t / 2 ≤ u x} :=
      measurableSet_le measurable_const hu
    rw [← lintegral_indicator hset]
    apply lintegral_congr
    intro x
    by_cases hx : t / 2 ≤ u x
    · simp [hx, u]
    · simp [hx, ENNReal.zero_rpow_of_pos hq]
  have hhighI_meas : Measurable (fun t : Real =>
      ∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ) := by
    let baseI : Real → ENNReal := fun s =>
      ∫⁻ x in {x | s ≤ u x}, (ENNReal.ofReal (u x)) ^ q ∂μ
    have hbaseI : Measurable baseI := by
      dsimp only [baseI]
      exact Codex.Spherical.InterpolationCore.measurable_lintegral_indicator_le u hu _
        (ENNReal.continuous_rpow_const.measurable.comp hu.ennreal_ofReal)
    have hfun : (fun t : Real =>
        ∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ) =
        fun t => baseI (t / 2) := by
      funext t
      exact hhigh_norm t
    rw [hfun]
    exact hbaseI.comp (measurable_id.div_const 2)
  have hhigh_tail :
      (∫⁻ t in Ioi (0 : Real),
        (∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ) *
          (ENNReal.ofReal t) ^ (p - q - 1)) =
        (ENNReal.ofReal (p - q))⁻¹ *
          (ENNReal.ofReal (2 : Real)) ^ (p - q) *
            ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ := by
    calc
      (∫⁻ t in Ioi (0 : Real),
        (∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ) *
          (ENNReal.ofReal t) ^ (p - q - 1)) =
          ∫⁻ t in Ioi (0 : Real),
            (∫⁻ x in {x | t / 2 ≤ u x},
              (ENNReal.ofReal (u x)) ^ q ∂μ) *
              (ENNReal.ofReal t) ^ (p - q - 1) := by
          apply lintegral_congr
          intro t
          rw [hhigh_norm t]
      _ = _ := by
          simpa only [u] using
            (Codex.Spherical.InterpolationTail.lintegral_high_tail_rpow_eq
              u hu hu_nonneg hq hqp)
  have hhigh_endpoint (t : Real) (ht : 0 < t) :
      (ENNReal.ofReal (t / 2)) ^ q * ν {y | t / 2 < T (high t) y} ≤
        Cq * ∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ := by
    calc
      (ENNReal.ofReal (t / 2)) ^ q * ν {y | t / 2 < T (high t) y} ≤
          (ENNReal.ofReal (t / 2)) ^ q *
            ν {y | (ENNReal.ofReal (t / 2)) ^ q ≤
              (ENNReal.ofReal (T (high t) y)) ^ q} := by
        apply mul_le_mul_right
        apply measure_mono
        intro y hy
        change ENNReal.ofReal (t / 2) ^ q ≤
          ENNReal.ofReal (T (high t) y) ^ q
        exact ENNReal.rpow_le_rpow
          (ENNReal.ofReal_le_ofReal (le_of_lt hy)) hq.le
      _ ≤ ∫⁻ y, (ENNReal.ofReal (T (high t) y)) ^ q ∂ν :=
        mul_meas_ge_le_lintegral₀
          (ENNReal.continuous_rpow_const.measurable.comp_aemeasurable
            ((hTmeas (high t)).ennreal_ofReal)) ((ENNReal.ofReal (t / 2)) ^ q)
      _ ≤ Cq * ∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ :=
        hstrong_q (high t) (hhigh_meas t)
  have hdistribution_weight (t : Real) (ht : 0 < t) :
      ν {y | t < T f y} * ENNReal.ofReal (t ^ (p - 1)) ≤
        (ENNReal.ofReal (2 : Real)) ^ q * Cq *
          (∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ) *
            (ENNReal.ofReal t) ^ (p - q - 1) := by
    rw [rieszThorin_ofReal_rpow_weight_q ht]
    calc
      ν {y | t < T f y} *
          ((ENNReal.ofReal (2 : Real)) ^ q *
            ((ENNReal.ofReal (t / 2)) ^ q *
              ENNReal.ofReal (t ^ (p - q - 1)))) =
          ((ENNReal.ofReal (t / 2)) ^ q * ν {y | t < T f y}) *
            ((ENNReal.ofReal (2 : Real)) ^ q *
              ENNReal.ofReal (t ^ (p - q - 1))) := by ac_rfl
      _ ≤ ((ENNReal.ofReal (t / 2)) ^ q *
          ν {y | t / 2 < T (high t) y}) *
            ((ENNReal.ofReal (2 : Real)) ^ q *
              ENNReal.ofReal (t ^ (p - q - 1))) := by
          exact mul_le_mul_left
            (mul_le_mul_right (hdistribution t ht) ((ENNReal.ofReal (t / 2)) ^ q)) _
      _ ≤ (Cq * ∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ) *
            ((ENNReal.ofReal (2 : Real)) ^ q *
              ENNReal.ofReal (t ^ (p - q - 1))) := by
          exact mul_le_mul_left (hhigh_endpoint t ht) _
      _ = (ENNReal.ofReal (2 : Real)) ^ q * Cq *
          (∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ) *
            (ENNReal.ofReal t) ^ (p - q - 1) := by
          rw [ENNReal.ofReal_rpow_of_pos ht]
          ac_rfl
  have hdistribution_integral :
      (∫⁻ t in Ioi (0 : Real),
        ν {y | t < T f y} * ENNReal.ofReal (t ^ (p - 1))) ≤
        ∫⁻ t in Ioi (0 : Real),
          (ENNReal.ofReal (2 : Real)) ^ q * Cq *
            (∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ) *
              (ENNReal.ofReal t) ^ (p - q - 1) := by
    apply lintegral_mono_ae
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    exact hdistribution_weight t ht
  have hhigh_integral :
      (∫⁻ t in Ioi (0 : Real),
        (ENNReal.ofReal (2 : Real)) ^ q * Cq *
          (∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ) *
            (ENNReal.ofReal t) ^ (p - q - 1)) =
        (ENNReal.ofReal (2 : Real)) ^ q * Cq *
          ((ENNReal.ofReal (p - q))⁻¹ *
            (ENNReal.ofReal (2 : Real)) ^ (p - q) *
              ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ) := by
    calc
      (∫⁻ t in Ioi (0 : Real),
        (ENNReal.ofReal (2 : Real)) ^ q * Cq *
          (∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ) *
            (ENNReal.ofReal t) ^ (p - q - 1)) =
          ((ENNReal.ofReal (2 : Real)) ^ q * Cq) *
            (∫⁻ t in Ioi (0 : Real),
              (∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ) *
                (ENNReal.ofReal t) ^ (p - q - 1)) := by
          have hmeas : Measurable (fun t : Real =>
              (∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ) *
                (ENNReal.ofReal t) ^ (p - q - 1)) :=
            hhighI_meas.mul
              (ENNReal.continuous_rpow_const.measurable.comp
                measurable_id.ennreal_ofReal)
          calc
            (∫⁻ t in Ioi (0 : Real),
              (ENNReal.ofReal (2 : Real)) ^ q * Cq *
                (∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ) *
                  (ENNReal.ofReal t) ^ (p - q - 1)) =
                ∫⁻ t in Ioi (0 : Real),
                  ((ENNReal.ofReal (2 : Real)) ^ q * Cq) *
                    ((∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ) *
                      (ENNReal.ofReal t) ^ (p - q - 1)) := by
                apply lintegral_congr
                intro t
                ac_rfl
            _ = ((ENNReal.ofReal (2 : Real)) ^ q * Cq) *
                (∫⁻ t in Ioi (0 : Real),
                  (∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ) *
                    (ENNReal.ofReal t) ^ (p - q - 1)) :=
              lintegral_const_mul _ hmeas
      _ = _ := by rw [hhigh_tail]
  calc
    (∫⁻ y, ENNReal.ofReal ((T f y) ^ p) ∂ν) =
        ENNReal.ofReal p *
          (∫⁻ t in Ioi (0 : Real),
            ν {y | t < T f y} * ENNReal.ofReal (t ^ (p - 1))) := by
      simpa using (lintegral_rpow_eq_lintegral_meas_lt_mul ν
        (Filter.Eventually.of_forall (hT_nonneg f)) (hTmeas f) hp)
    _ ≤ ENNReal.ofReal p *
        (∫⁻ t in Ioi (0 : Real),
          (ENNReal.ofReal (2 : Real)) ^ q * Cq *
            (∫⁻ x, (ENNReal.ofReal ‖high t x‖) ^ q ∂μ) *
              (ENNReal.ofReal t) ^ (p - q - 1)) :=
      mul_le_mul_right hdistribution_integral _
    _ = _ := by rw [hhigh_integral]

/-- Finiteness companion to
`rieszThorin_q_top_lintegral_source_output`.  Thus the real interpolation
argument genuinely maps `L^p(μ; E)` into `L^p(ν)`, not merely finite
truncations, whenever the endpoint coefficient is finite. -/
theorem rieszThorin_q_top_memLp_source_output
    {α β E : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    {μ : Measure α} {ν : Measure β} [SFinite μ] [SFinite ν]
    (T : (α → E) → β → Real)
    (hT_nonneg : ∀ g y, 0 ≤ T g y)
    (hT_subadd : ∀ g h y, T (g + h) y ≤ T g y + T h y)
    (hTmeas : ∀ g, AEMeasurable (T g) ν)
    {q : Real} (hq : 0 < q) (Cq : ENNReal) (hCq : Cq < ∞)
    (hstrong_q : ∀ g : α → E, Measurable g →
      (∫⁻ y, (ENNReal.ofReal (T g y)) ^ q ∂ν) ≤
        Cq * ∫⁻ x, (ENNReal.ofReal ‖g x‖) ^ q ∂μ)
    (hT_top : ∀ (g : α → E) (a : Real), 0 ≤ a →
      (∀ x, ‖g x‖ ≤ a) → ∀ y, T g y ≤ a)
    {p : Real} (hqp : q < p)
    (f : α → E) (hf : Measurable f) (hfp : MemLp f (ENNReal.ofReal p) μ) :
    MemLp (T f) (ENNReal.ofReal p) ν := by
  have hp : 0 < p := hq.trans hqp
  have hp0 : ENNReal.ofReal p ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp
  have hptop : ENNReal.ofReal p ≠ ∞ := ENNReal.ofReal_ne_top
  have hinput :
      (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ) < ∞ := by
    have h := (eLpNorm_lt_top_iff_lintegral_rpow_enorm_lt_top hp0 hptop).mp hfp.2
    simpa [ENNReal.toReal_ofReal hp.le, enorm_eq_nnnorm] using h
  have hpq : 0 < p - q := sub_pos.mpr hqp
  have hinv : (ENNReal.ofReal (p - q))⁻¹ < ∞ :=
    ENNReal.inv_lt_top.mpr (ENNReal.ofReal_pos.mpr hpq)
  have htwoq : (ENNReal.ofReal (2 : Real)) ^ q < ∞ :=
    ENNReal.rpow_lt_top_of_nonneg hq.le ENNReal.ofReal_ne_top
  have htwopq : (ENNReal.ofReal (2 : Real)) ^ (p - q) < ∞ :=
    ENNReal.rpow_lt_top_of_nonneg hpq.le ENNReal.ofReal_ne_top
  have hright :
      ENNReal.ofReal p *
        ((ENNReal.ofReal (2 : Real)) ^ q * Cq *
          ((ENNReal.ofReal (p - q))⁻¹ *
            (ENNReal.ofReal (2 : Real)) ^ (p - q) *
              ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ)) < ∞ := by
    apply ENNReal.mul_lt_top ENNReal.ofReal_lt_top
    apply ENNReal.mul_lt_top
    · apply ENNReal.mul_lt_top htwoq hCq
    · apply ENNReal.mul_lt_top
      · apply ENNReal.mul_lt_top hinv htwopq
      · exact hinput
  apply Codex.Spherical.InterpolationTail.memLp_of_lintegral_ofReal_rpow_lt_top
    (T f) (hTmeas f) (hT_nonneg f) hp
  apply lt_of_le_of_lt
    (rieszThorin_q_top_lintegral_source_output T hT_nonneg hT_subadd hTmeas
      hq Cq hstrong_q hT_top hqp f hf)
  exact hright

/-- The explicit constant produced by the direct real-interpolation proof.
It includes the (non-sharp) Marcinkiewicz layer-cake loss. -/
def rieszThorinQTopConstant (q p : Real) (Cq : ENNReal) : ENNReal :=
  ENNReal.ofReal p *
    ((ENNReal.ofReal (2 : Real)) ^ q * Cq *
      ((ENNReal.ofReal (p - q))⁻¹ *
        (ENNReal.ofReal (2 : Real)) ^ (p - q)))

/-- Norm-form direct real interpolation from an `L^q` bound and an `L∞`
contraction, between arbitrary source and target measure spaces.  The
source may be vector valued.  This is intentionally called `q_top`, rather
than `rieszThorin`: it is a proved real-interpolation substitute with an
explicit Marcinkiewicz loss, not the sharp complex Riesz--Thorin theorem. -/
theorem rieszThorin_q_top
    {α β E : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    {μ : Measure α} {ν : Measure β} [SFinite μ] [SFinite ν]
    (T : (α → E) → β → Real)
    (hT_nonneg : ∀ g y, 0 ≤ T g y)
    (hT_subadd : ∀ g h y, T (g + h) y ≤ T g y + T h y)
    (hTmeas : ∀ g, AEMeasurable (T g) ν)
    {q : Real} (hq : 0 < q) (A : ENNReal)
    (hstrong_q : ∀ g : α → E, Measurable g →
      eLpNorm (T g) (ENNReal.ofReal q) ν ≤
        A * eLpNorm g (ENNReal.ofReal q) μ)
    (hT_top : ∀ (g : α → E) (a : Real), 0 ≤ a →
      (∀ x, ‖g x‖ ≤ a) → ∀ y, T g y ≤ a)
    {p : Real} (hqp : q < p)
    (f : α → E) (hf : Measurable f) :
    eLpNorm (T f) (ENNReal.ofReal p) ν ≤
      (rieszThorinQTopConstant q p (A ^ q)) ^ p⁻¹ *
        eLpNorm f (ENNReal.ofReal p) μ := by
  have hp : 0 < p := hq.trans hqp
  have hmoment : ∀ g : α → E, Measurable g →
      (∫⁻ y, (ENNReal.ofReal (T g y)) ^ q ∂ν) ≤
        (A ^ q) * ∫⁻ x, (ENNReal.ofReal ‖g x‖) ^ q ∂μ := by
    intro g hg
    calc
      (∫⁻ y, (ENNReal.ofReal (T g y)) ^ q ∂ν) =
          (eLpNorm (T g) (ENNReal.ofReal q) ν) ^ q :=
        (by
          calc
            (∫⁻ y, (ENNReal.ofReal (T g y)) ^ q ∂ν) =
                ∫⁻ y, ENNReal.ofReal ((T g y) ^ q) ∂ν := by
              apply lintegral_congr
              intro y
              exact ENNReal.ofReal_rpow_of_nonneg (hT_nonneg g y) hq.le
            _ = _ := lintegral_ofReal_rpow_eq_eLpNorm_rpow_of_nonneg
              (μ := ν) hq (T g) (hT_nonneg g))
      _ ≤ (A * eLpNorm g (ENNReal.ofReal q) μ) ^ q :=
        ENNReal.rpow_le_rpow (hstrong_q g hg) hq.le
      _ = A ^ q * (eLpNorm g (ENNReal.ofReal q) μ) ^ q := by
        exact ENNReal.mul_rpow_of_nonneg _ _ hq.le
      _ = (A ^ q) * ∫⁻ x, (ENNReal.ofReal ‖g x‖) ^ q ∂μ := by
        rw [← lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow hq g]
  have hmoment_bound := rieszThorin_q_top_lintegral_source_output
    T hT_nonneg hT_subadd hTmeas hq (A ^ q) hmoment hT_top hqp f hf
  have hout : eLpNorm (T f) (ENNReal.ofReal p) ν ≤
      (rieszThorinQTopConstant q p (A ^ q) *
        ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ) ^ p⁻¹ := by
    apply eLpNorm_real_nonneg_le_of_lintegral_ofReal_rpow_le ν (T f) hp
      (hT_nonneg f)
    simpa only [rieszThorinQTopConstant, mul_assoc] using hmoment_bound
  have hin : eLpNorm f (ENNReal.ofReal p) μ =
      (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ) ^ p⁻¹ := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
      (ENNReal.ofReal_ne_zero_iff.mpr hp) ENNReal.ofReal_ne_top]
    simp only [ENNReal.toReal_ofReal hp.le, ofReal_norm, one_div]
  calc
    eLpNorm (T f) (ENNReal.ofReal p) ν ≤
        (rieszThorinQTopConstant q p (A ^ q) *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ) ^ p⁻¹ := hout
    _ = (rieszThorinQTopConstant q p (A ^ q)) ^ p⁻¹ *
        (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ) ^ p⁻¹ := by
      exact ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hp.le)
    _ = _ := by rw [← hin]

/-- The coefficient in the direct `L^q`--`L∞` real interpolation estimate
when the upper endpoint has norm `B` rather than one.  It is obtained by
normalizing the output by `B`, applying `rieszThorin_q_top`, and scaling
back. -/
def rieszThorinQTopScaledConstant (q p : Real) (A B : ENNReal) : ENNReal :=
  B * (rieszThorinQTopConstant q p ((A * B⁻¹) ^ q)) ^ p⁻¹

/-- Direct source--target real interpolation from a strong `L^q` endpoint
with constant `A` and an `L∞` endpoint with constant `B`.  The theorem
normalizes by `B` explicitly, so its homogeneous dependence retains the
expected `A^(q/p) B^(1-q/p)` behaviour (up to the Marcinkiewicz loss). -/
theorem rieszThorin_q_top_scaled
    {α β E : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    {μ : Measure α} {ν : Measure β} [SFinite μ] [SFinite ν]
    (T : (α → E) → β → Real)
    (hT_nonneg : ∀ g y, 0 ≤ T g y)
    (hT_subadd : ∀ g h y, T (g + h) y ≤ T g y + T h y)
    (hTmeas : ∀ g, AEMeasurable (T g) ν)
    {q : Real} (hq : 0 < q) (A : ENNReal)
    (hstrong_q : ∀ g : α → E, Measurable g →
      eLpNorm (T g) (ENNReal.ofReal q) ν ≤
        A * eLpNorm g (ENNReal.ofReal q) μ)
    (B : Real) (hB : 0 < B)
    (hT_top : ∀ (g : α → E) (a : Real), 0 ≤ a →
      (∀ x, ‖g x‖ ≤ a) → ∀ y, T g y ≤ B * a)
    {p : Real} (hqp : q < p)
    (f : α → E) (hf : Measurable f) :
    eLpNorm (T f) (ENNReal.ofReal p) ν ≤
      rieszThorinQTopScaledConstant q p A (ENNReal.ofReal B) *
        eLpNorm f (ENNReal.ofReal p) μ := by
  let S : (α → E) → β → Real := fun g y => T g y / B
  have hS_nonneg : ∀ g y, 0 ≤ S g y := by
    intro g y
    exact div_nonneg (hT_nonneg g y) hB.le
  have hS_subadd : ∀ g h y, S (g + h) y ≤ S g y + S h y := by
    intro g h y
    change T (g + h) y / B ≤ T g y / B + T h y / B
    rw [← add_div]
    exact div_le_div_of_nonneg_right (hT_subadd g h y) hB.le
  have hSmeas : ∀ g, AEMeasurable (S g) ν := by
    intro g
    change AEMeasurable (fun y => T g y / B) ν
    exact (hTmeas g).div_const B
  have hS_top : ∀ (g : α → E) (a : Real), 0 ≤ a →
      (∀ x, ‖g x‖ ≤ a) → ∀ y, S g y ≤ a := by
    intro g a ha hga y
    change T g y / B ≤ a
    rw [div_le_iff₀ hB]
    simpa [mul_comm] using hT_top g a ha hga y
  have hS_strong : ∀ g : α → E, Measurable g →
      eLpNorm (S g) (ENNReal.ofReal q) ν ≤
        (A * (ENNReal.ofReal B)⁻¹) * eLpNorm g (ENNReal.ofReal q) μ := by
    intro g hg
    have hSeq : S g = (B⁻¹) • T g := by
      funext y
      change T g y / B = B⁻¹ * T g y
      field_simp [hB.ne']
    calc
      eLpNorm (S g) (ENNReal.ofReal q) ν =
          ENNReal.ofReal (B⁻¹) * eLpNorm (T g) (ENNReal.ofReal q) ν := by
        rw [hSeq, eLpNorm_const_smul]
        rw [Real.enorm_eq_ofReal (inv_nonneg.mpr hB.le)]
      _ ≤ ENNReal.ofReal (B⁻¹) *
          (A * eLpNorm g (ENNReal.ofReal q) μ) := by
        exact mul_le_mul_right (hstrong_q g hg) _
      _ = (A * (ENNReal.ofReal B)⁻¹) * eLpNorm g (ENNReal.ofReal q) μ := by
        rw [ENNReal.ofReal_inv_of_pos hB]
        ac_rfl
  have hSbound := rieszThorin_q_top S hS_nonneg hS_subadd hSmeas hq
    (A * (ENNReal.ofReal B)⁻¹) hS_strong hS_top hqp f hf
  have hTeq : T f = B • S f := by
    funext y
    change T f y = B * (T f y / B)
    field_simp [hB.ne']
  calc
    eLpNorm (T f) (ENNReal.ofReal p) ν =
        ENNReal.ofReal B * eLpNorm (S f) (ENNReal.ofReal p) ν := by
      rw [hTeq, eLpNorm_const_smul]
      rw [Real.enorm_eq_ofReal hB.le]
    _ ≤ ENNReal.ofReal B *
        ((rieszThorinQTopConstant q p
          ((A * (ENNReal.ofReal B)⁻¹) ^ q)) ^ p⁻¹ *
          eLpNorm f (ENNReal.ofReal p) μ) := by
      exact mul_le_mul_right hSbound _
    _ = _ := by
      simp only [rieszThorinQTopScaledConstant]
      ac_rfl

/-- The `L²`--`L∞` to `L⁴` instance of the direct real interpolation theorem.
This is the concrete vector-valued endpoint form used by the finite vertical
recombination step in the MSS argument. -/
theorem rieszThorin_two_top_four
    {α β E : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    {μ : Measure α} {ν : Measure β} [SFinite μ] [SFinite ν]
    (T : (α → E) → β → Real)
    (hT_nonneg : ∀ g y, 0 ≤ T g y)
    (hT_subadd : ∀ g h y, T (g + h) y ≤ T g y + T h y)
    (hTmeas : ∀ g, AEMeasurable (T g) ν)
    (A : ENNReal)
    (hstrong_two : ∀ g : α → E, Measurable g →
      eLpNorm (T g) (2 : ENNReal) ν ≤ A * eLpNorm g (2 : ENNReal) μ)
    (B : Real) (hB : 0 < B)
    (hT_top : ∀ (g : α → E) (a : Real), 0 ≤ a →
      (∀ x, ‖g x‖ ≤ a) → ∀ y, T g y ≤ B * a)
    (f : α → E) (hf : Measurable f) :
    eLpNorm (T f) (4 : ENNReal) ν ≤
      rieszThorinQTopScaledConstant 2 4 A (ENNReal.ofReal B) *
        eLpNorm f (4 : ENNReal) μ := by
  have hq : (0 : Real) < 2 := by norm_num
  have hqp : (2 : Real) < 4 := by norm_num
  have hstrong : ∀ g : α → E, Measurable g →
      eLpNorm (T g) (ENNReal.ofReal (2 : Real)) ν ≤
        A * eLpNorm g (ENNReal.ofReal (2 : Real)) μ := by
    intro g hg
    simpa using hstrong_two g hg
  simpa using
    (rieszThorin_q_top_scaled T hT_nonneg hT_subadd hTmeas hq A hstrong B hB
      hT_top hqp f hf)

/-- Additive/linear-operator spelling of `rieszThorin_q_top_scaled`.  A
complex- or real-linear map can be supplied through its additive map, and
the theorem applies it to `T g y = ‖L g y‖`. -/
theorem rieszThorin_q_top_scaled_of_additive
    {α β E F : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedAddCommGroup F]
    [MeasurableSpace E] [BorelSpace E] [MeasurableSpace F] [BorelSpace F]
    {μ : Measure α} {ν : Measure β} [SFinite μ] [SFinite ν]
    (L : (α → E) →+ (β → F))
    (hLmeas : ∀ g, AEMeasurable (L g) ν)
    {q : Real} (hq : 0 < q) (A : ENNReal)
    (hstrong_q : ∀ g : α → E, Measurable g →
      eLpNorm (L g) (ENNReal.ofReal q) ν ≤
        A * eLpNorm g (ENNReal.ofReal q) μ)
    (B : Real) (hB : 0 < B)
    (hL_top : ∀ (g : α → E) (a : Real), 0 ≤ a →
      (∀ x, ‖g x‖ ≤ a) → ∀ y, ‖L g y‖ ≤ B * a)
    {p : Real} (hqp : q < p)
    (f : α → E) (hf : Measurable f) :
    eLpNorm (L f) (ENNReal.ofReal p) ν ≤
      rieszThorinQTopScaledConstant q p A (ENNReal.ofReal B) *
        eLpNorm f (ENNReal.ofReal p) μ := by
  simpa only [eLpNorm_norm] using
    (rieszThorin_q_top_scaled (T := fun g y => ‖L g y‖)
      (fun g y => norm_nonneg _) (fun g h y => by
        have hLadd : L (g + h) = L g + L h := L.map_add g h
        rw [hLadd]
        exact norm_add_le (L g y) (L h y))
      (fun g => (hLmeas g).norm) hq A
      (fun g hg => by simpa only [eLpNorm_norm] using hstrong_q g hg)
      B hB hL_top hqp f hf)

/-- Additive/linear-operator `L²`--`L∞` to `L⁴` corollary. -/
theorem rieszThorin_two_top_four_of_additive
    {α β E F : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedAddCommGroup F]
    [MeasurableSpace E] [BorelSpace E] [MeasurableSpace F] [BorelSpace F]
    {μ : Measure α} {ν : Measure β} [SFinite μ] [SFinite ν]
    (L : (α → E) →+ (β → F))
    (hLmeas : ∀ g, AEMeasurable (L g) ν)
    (A : ENNReal)
    (hstrong_two : ∀ g : α → E, Measurable g →
      eLpNorm (L g) (2 : ENNReal) ν ≤ A * eLpNorm g (2 : ENNReal) μ)
    (B : Real) (hB : 0 < B)
    (hL_top : ∀ (g : α → E) (a : Real), 0 ≤ a →
      (∀ x, ‖g x‖ ≤ a) → ∀ y, ‖L g y‖ ≤ B * a)
    (f : α → E) (hf : Measurable f) :
    eLpNorm (L f) (4 : ENNReal) ν ≤
      rieszThorinQTopScaledConstant 2 4 A (ENNReal.ofReal B) *
        eLpNorm f (4 : ENNReal) μ := by
  have hq : (0 : Real) < 2 := by norm_num
  have hqp : (2 : Real) < 4 := by norm_num
  have hstrong : ∀ g : α → E, Measurable g →
      eLpNorm (L g) (ENNReal.ofReal (2 : Real)) ν ≤
        A * eLpNorm g (ENNReal.ofReal (2 : Real)) μ := by
    intro g hg
    simpa using hstrong_two g hg
  simpa using
    (rieszThorin_q_top_scaled_of_additive L hLmeas hq A hstrong B hB
      hL_top hqp f hf)

end

/-! ## Finite atomic complex-power primitives

The sharp finite-dimensional Riesz--Thorin argument deforms both the input
and the dual test vector by complex powers. The definitions below use a
zero-safe convention: a zero coordinate stays zero on the whole strip. This
is the convention needed at an `L∞` endpoint, where the exponent has real
part zero. They are independent of any assumed analytic-family datum. -/

noncomputable section

section FiniteAtomic

/-- The zero-safe coordinate complex power used in the finite atomic
interpolation argument. -/
def finiteAtomicCpow (a : Complex) (e : Complex → Complex) : Complex → Complex :=
  fun z ↦ if a = 0 then 0 else a ^ e z

/-- A zero-safe complex power is entire when its exponent is entire. -/
theorem differentiable_finiteAtomicCpow (a : Complex) {e : Complex → Complex}
    (he : Differentiable Complex e) :
    Differentiable Complex (finiteAtomicCpow a e) := by
  unfold finiteAtomicCpow
  by_cases ha : a = 0
  · simp only [ha, if_true]
    exact differentiable_const 0
  · letI : NeZero a := ⟨ha⟩
    simp only [if_neg ha]
    simpa [Function.comp_def] using
      (differentiable_const_cpow_of_neZero a).comp he

/-- Coordinatewise complex-power deformation of a finite atomic vector. -/
def finiteAtomicPowerFamily {I : Type*} (f : I → Complex)
    (e : Complex → Complex) : Complex → I → Complex :=
  fun z i ↦ (f i / (‖f i‖ : Complex)) *
    finiteAtomicCpow (‖f i‖ : Complex) e z

/-- The finite atomic complex-power deformation is holomorphic coordinatewise. -/
theorem differentiable_finiteAtomicPowerFamily {I : Type*} (f : I → Complex)
    {e : Complex → Complex} (he : Differentiable Complex e) :
    Differentiable Complex (finiteAtomicPowerFamily f e) := by
  rw [differentiable_pi]
  intro i
  exact (differentiable_finiteAtomicCpow (‖f i‖ : Complex) he).const_mul _

/-- Pointwise norm control for the finite atomic power family. -/
theorem norm_finiteAtomicPowerFamily_le_rpow {I : Type*} (f : I → Complex)
    (e : Complex → Complex) (z : Complex) (i : I) :
    ‖finiteAtomicPowerFamily f e z i‖ ≤ ‖f i‖ ^ (e z).re := by
  unfold finiteAtomicPowerFamily
  by_cases hfi : f i = 0
  · simp only [hfi, norm_zero, Complex.ofReal_zero, zero_div, zero_mul]
    exact Real.zero_rpow_nonneg _
  · have hn : ‖f i‖ ≠ 0 := norm_ne_zero_iff.mpr hfi
    have hpos : 0 < ‖f i‖ := norm_pos_iff.mpr hfi
    have hphase : ‖f i / (‖f i‖ : Complex)‖ = 1 := by
      rw [norm_div, Complex.norm_real, Real.norm_of_nonneg (norm_nonneg _), div_self hn]
    have hbase : (‖f i‖ : Complex) ≠ 0 := Complex.ofReal_ne_zero.mpr hn
    rw [finiteAtomicCpow, if_neg hbase, norm_mul, hphase, one_mul,
      Complex.norm_cpow_eq_rpow_re_of_pos hpos]

/-- Away from exponent real part zero, the finite atomic power family has the
expected coordinate norm exactly. -/
theorem norm_finiteAtomicPowerFamily_eq_rpow_of_re_pos {I : Type*}
    (f : I → Complex) (e : Complex → Complex) (z : Complex) (i : I)
    (hre : 0 < (e z).re) :
    ‖finiteAtomicPowerFamily f e z i‖ = ‖f i‖ ^ (e z).re := by
  unfold finiteAtomicPowerFamily
  by_cases hfi : f i = 0
  · simp only [hfi, norm_zero, Complex.ofReal_zero, zero_div, zero_mul]
    exact (Real.zero_rpow (ne_of_gt hre)).symm
  · have hn : ‖f i‖ ≠ 0 := norm_ne_zero_iff.mpr hfi
    have hpos : 0 < ‖f i‖ := norm_pos_iff.mpr hfi
    have hphase : ‖f i / (‖f i‖ : Complex)‖ = 1 := by
      rw [norm_div, Complex.norm_real, Real.norm_of_nonneg (norm_nonneg _), div_self hn]
    have hbase : (‖f i‖ : Complex) ≠ 0 := Complex.ofReal_ne_zero.mpr hn
    rw [finiteAtomicCpow, if_neg hbase, norm_mul, hphase, one_mul,
      Complex.norm_cpow_eq_rpow_re_of_pos hpos]

/-- At exponent one, the finite atomic deformation is the original vector. -/
theorem finiteAtomicPowerFamily_apply_of_exponent_one {I : Type*}
    (f : I → Complex) (e : Complex → Complex) (z : Complex)
    (he : e z = 1) : finiteAtomicPowerFamily f e z = f := by
  funext i
  unfold finiteAtomicPowerFamily
  rw [finiteAtomicCpow, he]
  by_cases hfi : f i = 0
  · simp [hfi]
  · have hn : ‖f i‖ ≠ 0 := norm_ne_zero_iff.mpr hfi
    have hbase : (‖f i‖ : Complex) ≠ 0 := Complex.ofReal_ne_zero.mpr hn
    rw [if_neg hbase, Complex.cpow_one]
    field_simp

/-! ### General reciprocal-exponent interpolation data

The complex-power construction uses affine functions of the reciprocal
endpoint exponents.  Keeping this elementary algebra independent of a
particular pair of Lebesgue exponents makes the later finite-simple and
measure-space arguments reusable beyond the `2`--`∞` model case. -/

/-- An affine complex exponent with prescribed real endpoint values. -/
def affineExponent (scale c0 c1 : Real) (z : Complex) : Complex :=
  (scale : Complex) * ((1 - z) * (c0 : Complex) + z * (c1 : Complex))

/-- The affine interpolation of two reciprocal exponents. -/
def recipBlend (θ s0 s1 : Real) : Real := (1 - θ) * s0 + θ * s1

/-- Canonical Hölder-dual exponent of an `ENNReal` exponent at least one. -/
def ennrealHolderDual (p : ENNReal) : ENNReal := (1 - p⁻¹)⁻¹

/-- The canonical dual exponent is Hölder conjugate to the original one. -/
theorem ennreal_holderConjugate_ennrealHolderDual {p : ENNReal} (hp : 1 ≤ p) :
    ENNReal.HolderConjugate p (ennrealHolderDual p) := by
  constructor
  rw [show (1 : ENNReal)⁻¹ = 1 by simp, ennrealHolderDual, inv_inv]
  exact add_tsub_cancel_of_le (by simpa using (ENNReal.inv_le_inv.mpr hp))

/-- Input exponent used by the general Riesz--Thorin complex-power family. -/
def rieszThorinInputExponent (p s0 s1 : Real) : Complex → Complex :=
  affineExponent p s0 s1

/-- Dual-test exponent used by the general Riesz--Thorin complex-power family. -/
def rieszThorinTestExponent (p' s0 s1 : Real) : Complex → Complex :=
  affineExponent p' (1 - s0) (1 - s1)

/-- Affine exponent functions are entire. -/
theorem differentiable_affineExponent (scale c0 c1 : Real) :
    Differentiable Complex (affineExponent scale c0 c1) := by
  unfold affineExponent
  fun_prop

/-- Real part of an affine exponent. -/
theorem affineExponent_re (scale c0 c1 : Real) (z : Complex) :
    (affineExponent scale c0 c1 z).re =
      scale * ((1 - z.re) * c0 + z.re * c1) := by
  simp [affineExponent]

/-- Left boundary value of an affine exponent. -/
theorem affineExponent_re_zero (scale c0 c1 : Real) :
    (affineExponent scale c0 c1 0).re = scale * c0 := by
  rw [affineExponent_re]
  norm_num

/-- Right boundary value of an affine exponent. -/
theorem affineExponent_re_one (scale c0 c1 : Real) :
    (affineExponent scale c0 c1 1).re = scale * c1 := by
  rw [affineExponent_re]
  norm_num

/-- The input exponent is entire. -/
theorem differentiable_rieszThorinInputExponent (p s0 s1 : Real) :
    Differentiable Complex (rieszThorinInputExponent p s0 s1) :=
  differentiable_affineExponent p s0 s1

/-- The test exponent is entire. -/
theorem differentiable_rieszThorinTestExponent (p' s0 s1 : Real) :
    Differentiable Complex (rieszThorinTestExponent p' s0 s1) :=
  differentiable_affineExponent p' (1 - s0) (1 - s1)

/-- Real part of the input exponent. -/
theorem rieszThorinInputExponent_re (p s0 s1 : Real) (z : Complex) :
    (rieszThorinInputExponent p s0 s1 z).re =
      p * ((1 - z.re) * s0 + z.re * s1) :=
  affineExponent_re p s0 s1 z

/-- Real part of the dual-test exponent. -/
theorem rieszThorinTestExponent_re (p' s0 s1 : Real) (z : Complex) :
    (rieszThorinTestExponent p' s0 s1 z).re =
      p' * ((1 - z.re) * (1 - s0) + z.re * (1 - s1)) :=
  affineExponent_re p' (1 - s0) (1 - s1) z

/-- Boundary values of the input exponent. -/
theorem rieszThorinInputExponent_re_zero (p s0 s1 : Real) :
    (rieszThorinInputExponent p s0 s1 0).re = p * s0 :=
  affineExponent_re_zero p s0 s1

/-- Boundary values of the input exponent. -/
theorem rieszThorinInputExponent_re_one (p s0 s1 : Real) :
    (rieszThorinInputExponent p s0 s1 1).re = p * s1 :=
  affineExponent_re_one p s0 s1

/-- Boundary values of the dual-test exponent. -/
theorem rieszThorinTestExponent_re_zero (p' s0 s1 : Real) :
    (rieszThorinTestExponent p' s0 s1 0).re = p' * (1 - s0) :=
  affineExponent_re_zero p' (1 - s0) (1 - s1)

/-- Boundary values of the dual-test exponent. -/
theorem rieszThorinTestExponent_re_one (p' s0 s1 : Real) :
    (rieszThorinTestExponent p' s0 s1 1).re = p' * (1 - s1) :=
  affineExponent_re_one p' (1 - s0) (1 - s1)

/-- Evaluation of an affine exponent at a real point. -/
theorem affineExponent_at_real (scale c0 c1 θ : Real) :
    affineExponent scale c0 c1 (θ : Complex) =
      (scale * ((1 - θ) * c0 + θ * c1) : Real) := by
  simp [affineExponent]

/-- An affine exponent is one at a real point when its scalar moment is one. -/
theorem affineExponent_at_real_eq_one (scale c0 c1 θ : Real)
    (h : scale * ((1 - θ) * c0 + θ * c1) = 1) :
    affineExponent scale c0 c1 (θ : Complex) = 1 := by
  rw [affineExponent_at_real, h]
  norm_num

/-- Affine exponent on an arbitrary point of the left boundary line. -/
theorem affineExponent_left_re (scale c0 c1 : Real) (w : Complex) (hw : w.re = 0) :
    (affineExponent scale c0 c1 w).re = scale * c0 := by
  rw [affineExponent_re, hw]
  ring

/-- Affine exponent on an arbitrary point of the right boundary line. -/
theorem affineExponent_right_re (scale c0 c1 : Real) (w : Complex) (hw : w.re = 1) :
    (affineExponent scale c0 c1 w).re = scale * c1 := by
  rw [affineExponent_re, hw]
  ring

/-- Nonnegativity of an affine exponent throughout the closed unit strip. -/
theorem affineExponent_re_nonneg_on_verticalClosedStrip
    {scale c0 c1 : Real} (hscale : 0 ≤ scale) (hc0 : 0 ≤ c0) (hc1 : 0 ≤ c1)
    (z : Complex) (hz : z ∈ verticalClosedStrip 0 1) :
    0 ≤ (affineExponent scale c0 c1 z).re := by
  rw [affineExponent_re]
  apply mul_nonneg hscale
  apply add_nonneg
  · exact mul_nonneg (by linarith [hz.1, hz.2]) hc0
  · exact mul_nonneg hz.1 hc1

/-- A uniform bound for the real part of an affine exponent on the closed
unit strip. -/
theorem affineExponent_re_le_max_on_verticalClosedStrip
    {scale c0 c1 : Real} (z : Complex) (hz : z ∈ verticalClosedStrip 0 1) :
    (affineExponent scale c0 c1 z).re ≤ max (scale * c0) (scale * c1) := by
  rw [affineExponent_re]
  calc
    scale * ((1 - z.re) * c0 + z.re * c1) =
        (1 - z.re) * (scale * c0) + z.re * (scale * c1) := by ring
    _ ≤ (1 - z.re) * max (scale * c0) (scale * c1) +
          z.re * max (scale * c0) (scale * c1) := by
        apply add_le_add
        · exact mul_le_mul_of_nonneg_left (le_max_left _ _) (by linarith [hz.1, hz.2])
        · exact mul_le_mul_of_nonneg_left (le_max_right _ _) hz.1
    _ = max (scale * c0) (scale * c1) := by ring

/-- On the left boundary, the input Riesz--Thorin exponent has the expected
reciprocal-endpoint real part. -/
theorem rieszThorinInputExponent_left_re (p s0 s1 : Real) (w : Complex)
    (hw : w.re = 0) :
    (rieszThorinInputExponent p s0 s1 w).re = p * s0 :=
  affineExponent_left_re p s0 s1 w hw

/-- On the right boundary, the input Riesz--Thorin exponent has the expected
reciprocal-endpoint real part. -/
theorem rieszThorinInputExponent_right_re (p s0 s1 : Real) (w : Complex)
    (hw : w.re = 1) :
    (rieszThorinInputExponent p s0 s1 w).re = p * s1 :=
  affineExponent_right_re p s0 s1 w hw

/-- On the left boundary, the dual Riesz--Thorin exponent has the expected
complementary reciprocal-endpoint real part. -/
theorem rieszThorinTestExponent_left_re (p' s0 s1 : Real) (w : Complex)
    (hw : w.re = 0) :
    (rieszThorinTestExponent p' s0 s1 w).re = p' * (1 - s0) :=
  affineExponent_left_re p' (1 - s0) (1 - s1) w hw

/-- On the right boundary, the dual Riesz--Thorin exponent has the expected
complementary reciprocal-endpoint real part. -/
theorem rieszThorinTestExponent_right_re (p' s0 s1 : Real) (w : Complex)
    (hw : w.re = 1) :
    (rieszThorinTestExponent p' s0 s1 w).re = p' * (1 - s1) :=
  affineExponent_right_re p' (1 - s0) (1 - s1) w hw

/-- Input exponent nonnegativity on the strip for reciprocal data in
`[0,1]`. -/
theorem rieszThorinInputExponent_re_nonneg_on_verticalClosedStrip
    {p s0 s1 : Real} (hp : 0 ≤ p) (hs0 : 0 ≤ s0) (hs1 : 0 ≤ s1)
    (z : Complex) (hz : z ∈ verticalClosedStrip 0 1) :
    0 ≤ (rieszThorinInputExponent p s0 s1 z).re :=
  affineExponent_re_nonneg_on_verticalClosedStrip hp hs0 hs1 z hz

/-- Dual-test exponent nonnegativity on the strip for reciprocal data in
`[0,1]`. -/
theorem rieszThorinTestExponent_re_nonneg_on_verticalClosedStrip
    {p' s0 s1 : Real} (hp' : 0 ≤ p') (hs0 : s0 ≤ 1) (hs1 : s1 ≤ 1)
    (z : Complex) (hz : z ∈ verticalClosedStrip 0 1) :
    0 ≤ (rieszThorinTestExponent p' s0 s1 z).re :=
  affineExponent_re_nonneg_on_verticalClosedStrip hp'
    (sub_nonneg.mpr hs0) (sub_nonneg.mpr hs1) z hz

/-- Uniform strip upper bound for the input Riesz--Thorin exponent. -/
theorem rieszThorinInputExponent_re_le_max_on_verticalClosedStrip
    {p s0 s1 : Real} (z : Complex)
    (hz : z ∈ verticalClosedStrip 0 1) :
    (rieszThorinInputExponent p s0 s1 z).re ≤ max (p * s0) (p * s1) :=
  affineExponent_re_le_max_on_verticalClosedStrip z hz

/-- Uniform strip upper bound for the dual Riesz--Thorin exponent. -/
theorem rieszThorinTestExponent_re_le_max_on_verticalClosedStrip
    {p' s0 s1 : Real} (z : Complex)
    (hz : z ∈ verticalClosedStrip 0 1) :
    (rieszThorinTestExponent p' s0 s1 z).re ≤
      max (p' * (1 - s0)) (p' * (1 - s1)) :=
  affineExponent_re_le_max_on_verticalClosedStrip z hz

/-- The input radial power recovers the input at the interpolation point. -/
theorem rieszThorinInputExponent_theta (p θ s0 s1 : Real)
    (h : p * recipBlend θ s0 s1 = 1) :
    rieszThorinInputExponent p s0 s1 (θ : Complex) = 1 := by
  apply affineExponent_at_real_eq_one
  simpa [rieszThorinInputExponent, recipBlend] using h

/-- The dual radial power recovers the test function at the interpolation point. -/
theorem rieszThorinTestExponent_theta (p' θ s0 s1 : Real)
    (h : p' * (1 - recipBlend θ s0 s1) = 1) :
    rieszThorinTestExponent p' s0 s1 (θ : Complex) = 1 := by
  apply affineExponent_at_real_eq_one
  calc
    p' * ((1 - θ) * (1 - s0) + θ * (1 - s1)) =
        p' * (1 - recipBlend θ s0 s1) := by
      congr 1
      simp [recipBlend]
      ring
    _ = 1 := h

/-- The input endpoint moment identity for a finite Lebesgue exponent. -/
theorem finite_input_endpoint_identity (p p0 : Real) (hp0 : 0 < p0) :
    p0 * (p * p0⁻¹) = p := by
  field_simp [hp0.ne']

/-- The dual endpoint moment identity for a finite Lebesgue exponent. -/
theorem finite_test_endpoint_identity (p' p0 : Real) (hp0 : 1 < p0) :
    p0.conjExponent * (p' * (1 - p0⁻¹)) = p' := by
  rw [Real.conjExponent]
  field_simp [ne_of_gt (sub_pos.mpr hp0)]

/-- `ENNReal` form of the finite input endpoint moment identity. -/
theorem ennreal_finite_input_endpoint_identity (p p0 : Real) (hp0 : 0 < p0) :
    ENNReal.ofReal p0 * ENNReal.ofReal (p * p0⁻¹) = ENNReal.ofReal p := by
  rw [← ENNReal.ofReal_mul hp0.le]
  exact congrArg ENNReal.ofReal (finite_input_endpoint_identity p p0 hp0)

/-- `ENNReal` form of the finite dual-test endpoint moment identity. -/
theorem ennreal_finite_test_endpoint_identity (p' p0 : Real) (hp0 : 1 < p0) :
    ENNReal.ofReal p0.conjExponent * ENNReal.ofReal (p' * (1 - p0⁻¹)) =
      ENNReal.ofReal p' := by
  rw [← ENNReal.ofReal_mul
    (le_of_lt (Real.HolderConjugate.conjExponent hp0).symm.pos)]
  exact congrArg ENNReal.ofReal (finite_test_endpoint_identity p' p0 hp0)

/-- A finite nonzero `ENNReal` endpoint times the real reciprocal power has
the prescribed moment.  This is the endpoint arithmetic used directly by
the finite-simple radial-power estimates. -/
theorem ennreal_mul_ofReal_mul_reciprocal_toReal
    {P : ENNReal} (hP0 : P ≠ 0) (hPtop : P ≠ ⊤)
    (p : Real) :
    P * ENNReal.ofReal (p * (P⁻¹).toReal) = ENNReal.ofReal p := by
  rw [ENNReal.toReal_inv]
  have hpos : 0 < P.toReal := ENNReal.toReal_pos hP0 hPtop
  rw [show P = ENNReal.ofReal P.toReal from (ENNReal.ofReal_toReal hPtop).symm,
    ← ENNReal.ofReal_mul ENNReal.toReal_nonneg]
  congr 1
  rw [ENNReal.toReal_ofReal ENNReal.toReal_nonneg]
  field_simp [hpos.ne']

/-- Reciprocals of Hölder-conjugate endpoints have complementary real
reciprocals. -/
theorem holderConjugate_reciprocal_toReal {P Q : ENNReal}
    [ENNReal.HolderConjugate P Q] :
    (Q⁻¹).toReal = 1 - (P⁻¹).toReal := by
  have hPge : 1 ≤ P := ENNReal.HolderConjugate.one_le P Q
  have hPinv : P⁻¹ ≤ 1 := by
    simpa using (ENNReal.inv_le_inv.mpr hPge)
  rw [← ENNReal.HolderConjugate.one_sub_inv P Q]
  rw [ENNReal.toReal_sub_of_le hPinv one_ne_top]
  simp

/-- Finite/endpoint-uniform moment identity for the dual test exponent.
The only exceptional conjugate endpoint is `P = 1`, where the dual exponent
is zero and is handled by the separate `L∞` power estimate. -/
theorem ennreal_holderConjugate_test_moment
    {P Q : ENNReal} [ENNReal.HolderConjugate P Q] (hPone : P ≠ 1)
    (p' : Real) :
    Q * ENNReal.ofReal (p' * (1 - (P⁻¹).toReal)) = ENNReal.ofReal p' := by
  have hQ0 : Q ≠ 0 := ENNReal.HolderConjugate.ne_zero Q P
  have hQtop : Q ≠ ⊤ := by
    intro hQ
    apply hPone
    exact (ENNReal.HolderConjugate.eq_top_iff_eq_one Q P).mp hQ
  rw [← holderConjugate_reciprocal_toReal (P := P) (Q := Q)]
  exact ennreal_mul_ofReal_mul_reciprocal_toReal hQ0 hQtop p'


/-- The input exponent for the sharp finite atomic `L²`--`L∞` interpolation
at the `L⁴` midpoint. -/
def finiteAtomicTwoTopInputExponent (z : Complex) : Complex := 2 * (1 - z)

/-- The test-vector exponent dual to
`finiteAtomicTwoTopInputExponent`. -/
def finiteAtomicTwoTopTestExponent (z : Complex) : Complex := (2 / 3) * (1 + z)

/-- The finite atomic input exponent is entire. -/
theorem differentiable_finiteAtomicTwoTopInputExponent :
    Differentiable Complex finiteAtomicTwoTopInputExponent := by
  unfold finiteAtomicTwoTopInputExponent
  fun_prop

/-- The finite atomic dual-test exponent is entire. -/
theorem differentiable_finiteAtomicTwoTopTestExponent :
    Differentiable Complex finiteAtomicTwoTopTestExponent := by
  unfold finiteAtomicTwoTopTestExponent
  fun_prop

/-- Both finite atomic deformations recover their original vectors at the
midpoint of the strip. -/
theorem finiteAtomicTwoTopInputExponent_half :
    finiteAtomicTwoTopInputExponent ((1 / 2 : Real) : Complex) = 1 := by
  norm_num [finiteAtomicTwoTopInputExponent]

/-- Both finite atomic deformations recover their original vectors at the
midpoint of the strip. -/
theorem finiteAtomicTwoTopTestExponent_half :
    finiteAtomicTwoTopTestExponent ((1 / 2 : Real) : Complex) = 1 := by
  norm_num [finiteAtomicTwoTopTestExponent]

/-- Real part of the finite atomic input exponent. -/
theorem finiteAtomicTwoTopInputExponent_re (z : Complex) :
    (finiteAtomicTwoTopInputExponent z).re = 2 * (1 - z.re) := by
  simp [finiteAtomicTwoTopInputExponent]

/-- Real part of the finite atomic dual-test exponent. -/
theorem finiteAtomicTwoTopTestExponent_re (z : Complex) :
    (finiteAtomicTwoTopTestExponent z).re =
      (2 / 3 : Real) * (1 + z.re) := by
  simp [finiteAtomicTwoTopTestExponent]

/-- A normalized finite atomic `L⁴` vector has all coordinates at most one. -/
theorem finiteAtomic_coordinate_norm_le_one_of_sum_four_le_one
    {I : Type*} [Fintype I] (f : I → Complex)
    (hf : ∑ i, ‖f i‖ ^ 4 ≤ 1) (i : I) : ‖f i‖ ≤ 1 := by
  have hterm : ‖f i‖ ^ 4 ≤ ∑ j, ‖f j‖ ^ 4 :=
    Finset.single_le_sum (fun j _ ↦ pow_nonneg (norm_nonneg _) _) (Finset.mem_univ _)
  have hpow : ‖f i‖ ^ 4 ≤ 1 := hterm.trans hf
  by_contra hnot
  have hgt : 1 < ‖f i‖ := lt_of_not_ge hnot
  nlinarith [sq_nonneg (‖f i‖ ^ 2 + 1), sq_nonneg (‖f i‖ - 1)]

/-- A finite atomic complex-power coordinate remains bounded by one on any
region where its base is at most one and its exponent has nonnegative real
part. -/
theorem finiteAtomicPowerFamily_norm_le_one_of_norm_le_one
    {I : Type*} (f : I → Complex) (e : Complex → Complex) (z : Complex) (i : I)
    (hfi : ‖f i‖ ≤ 1) (hre : 0 ≤ (e z).re) :
    ‖finiteAtomicPowerFamily f e z i‖ ≤ 1 :=
  (norm_finiteAtomicPowerFamily_le_rpow f e z i).trans
    (Real.rpow_le_one (norm_nonneg _) hfi hre)

/-- A coarse global bound for a finite atomic power coordinate whose exponent
has real part in `[0, 2]`.  It supplies the strip boundedness required by
Hadamard's theorem without postulating it as analytic-family data. -/
theorem finiteAtomicPowerFamily_norm_le_square_max {I : Type*}
    [Fintype I] (f : I → Complex) (e : Complex → Complex) (z : Complex) (i : I)
    (hre0 : 0 ≤ (e z).re) (hre2 : (e z).re ≤ 2) :
    ‖finiteAtomicPowerFamily f e z i‖ ≤ (max 1 ‖f‖) ^ 2 := by
  have hcoord : ‖f i‖ ≤ ‖f‖ := norm_le_pi_norm f i
  have hmax : max 1 ‖f i‖ ≤ max 1 ‖f‖ :=
    max_le (le_max_left _ _) (hcoord.trans (le_max_right _ _))
  calc
    ‖finiteAtomicPowerFamily f e z i‖ ≤ ‖f i‖ ^ (e z).re :=
      norm_finiteAtomicPowerFamily_le_rpow f e z i
    _ ≤ (max 1 ‖f i‖) ^ (e z).re :=
      Real.rpow_le_rpow (norm_nonneg _) (le_max_right _ _) hre0
    _ ≤ (max 1 ‖f i‖) ^ (2 : Real) :=
      Real.rpow_le_rpow_of_exponent_le (le_max_left _ _) hre2
    _ = (max 1 ‖f i‖) ^ 2 := Real.rpow_natCast _ 2
    _ ≤ (max 1 ‖f‖) ^ 2 := by
      rw [pow_two, pow_two]
      exact mul_self_le_mul_self (by positivity) hmax

/-- The input deformation has the normalized `L²` norm on the left boundary. -/
theorem finiteAtomicTwoTopInput_left_square_norm {I : Type*} [Fintype I]
    (f : I → Complex) (w : Complex) (hwre : w.re = 0) :
    ∑ i, ‖finiteAtomicPowerFamily f finiteAtomicTwoTopInputExponent w i‖ ^ 2 =
      ∑ i, ‖f i‖ ^ 4 := by
  apply Finset.sum_congr rfl
  intro i _
  have hre : (finiteAtomicTwoTopInputExponent w).re = 2 := by
    rw [finiteAtomicTwoTopInputExponent_re, hwre]
    norm_num
  rw [norm_finiteAtomicPowerFamily_eq_rpow_of_re_pos f _ _ _ (by rw [hre]; norm_num), hre]
  calc
    (‖f i‖ ^ (2 : Real)) ^ 2 = Real.rpow (‖f i‖ ^ (2 : Real)) 2 := by
      symm
      exact Real.rpow_natCast _ 2
    _ = ‖f i‖ ^ ((2 : Real) * 2) :=
      (Real.rpow_mul (norm_nonneg _) _ _).symm
    _ = ‖f i‖ ^ (4 : Real) := by norm_num
    _ = ‖f i‖ ^ 4 := Real.rpow_natCast _ 4

/-- The dual-test deformation has the normalized `L²` norm on the left
boundary. -/
theorem finiteAtomicTwoTopTest_left_square_norm {J : Type*} [Fintype J]
    (g : J → Complex) (w : Complex) (hwre : w.re = 0) :
    ∑ j, ‖finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent w j‖ ^ 2 =
      ∑ j, ‖g j‖ ^ (4 / 3 : Real) := by
  apply Finset.sum_congr rfl
  intro j _
  have hre : (finiteAtomicTwoTopTestExponent w).re = (2 / 3 : Real) := by
    rw [finiteAtomicTwoTopTestExponent_re, hwre]
    norm_num
  rw [norm_finiteAtomicPowerFamily_eq_rpow_of_re_pos g _ _ _ (by rw [hre]; norm_num), hre]
  calc
    (‖g j‖ ^ (2 / 3 : Real)) ^ 2 =
        Real.rpow (‖g j‖ ^ (2 / 3 : Real)) 2 := by
      symm
      exact Real.rpow_natCast _ 2
    _ = ‖g j‖ ^ ((2 / 3 : Real) * 2) :=
      (Real.rpow_mul (norm_nonneg _) _ _).symm
    _ = ‖g j‖ ^ (4 / 3 : Real) := by norm_num

/-- The dual-test deformation has normalized `L¹` norm on the right boundary. -/
theorem finiteAtomicTwoTopTest_right_one_norm {J : Type*} [Fintype J]
    (g : J → Complex) (w : Complex) (hwre : w.re = 1) :
    ∑ j, ‖finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent w j‖ =
      ∑ j, ‖g j‖ ^ (4 / 3 : Real) := by
  apply Finset.sum_congr rfl
  intro j _
  have hre : (finiteAtomicTwoTopTestExponent w).re = (4 / 3 : Real) := by
    rw [finiteAtomicTwoTopTestExponent_re, hwre]
    norm_num
  rw [norm_finiteAtomicPowerFamily_eq_rpow_of_re_pos g _ _ _ (by rw [hre]; norm_num), hre]

/-- The scalar pairing to which three-lines is applied in the finite atomic
proof. -/
def finiteAtomicPairing {I J : Type*} [Fintype I] [Fintype J]
    (T : (I → Complex) →L[Complex] (J → Complex))
    (f : I → Complex) (a : Complex → Complex)
    (g : J → Complex) (b : Complex → Complex) : Complex → Complex :=
  fun z ↦ ∑ j, T (finiteAtomicPowerFamily f a z) j *
    finiteAtomicPowerFamily g b z j

/-- The finite atomic pairing is entire when its two exponent functions are
entire. -/
theorem differentiable_finiteAtomicPairing {I J : Type*} [Fintype I] [Fintype J]
    (T : (I → Complex) →L[Complex] (J → Complex))
    (f : I → Complex) {a : Complex → Complex}
    (g : J → Complex) {b : Complex → Complex}
    (ha : Differentiable Complex a) (hb : Differentiable Complex b) :
    Differentiable Complex (finiteAtomicPairing T f a g b) := by
  classical
  unfold finiteAtomicPairing
  have h : Differentiable Complex (Finset.univ.sum (fun j z ↦
      T (finiteAtomicPowerFamily f a z) j * finiteAtomicPowerFamily g b z j)) :=
    Differentiable.sum (u := Finset.univ) (fun j _ ↦ by
      have hvector : Differentiable Complex (fun z ↦
          T (finiteAtomicPowerFamily f a z)) := by
        simpa [Function.comp_def] using T.differentiable.comp
          (differentiable_finiteAtomicPowerFamily f ha)
      have hT : Differentiable Complex (fun z ↦
          T (finiteAtomicPowerFamily f a z) j) :=
        (differentiable_pi.mp hvector) j
      exact hT.mul
        ((differentiable_pi.mp (differentiable_finiteAtomicPowerFamily g hb)) j))
  convert h using 1
  ext z
  simp only [Finset.sum_apply]

/-- The finite atomic pairing is a valid analytic family on the unit strip. -/
theorem finiteAtomicPairing_analytic {I J : Type*} [Fintype I] [Fintype J]
    (T : (I → Complex) →L[Complex] (J → Complex))
    (f : I → Complex) {a : Complex → Complex}
    (g : J → Complex) {b : Complex → Complex}
    (ha : Differentiable Complex a) (hb : Differentiable Complex b) :
    ScalarAnalyticFamily 0 1 (finiteAtomicPairing T f a g b) :=
  (differentiable_finiteAtomicPairing T f g ha hb).diffContOnCl

/-- The concrete finite atomic pairing is bounded on the full closed unit
strip.  The bound is deliberately coarse: only boundedness, rather than its
constant, is needed by three-lines. -/
theorem finiteAtomicTwoTopPairing_bddAbove {I J : Type*} [Fintype I] [Fintype J]
    (T : (I → Complex) →L[Complex] (J → Complex))
    (f : I → Complex) (g : J → Complex) :
    BddAbove ((fun z ↦ ‖finiteAtomicPairing T f finiteAtomicTwoTopInputExponent g
      finiteAtomicTwoTopTestExponent z‖) '' verticalClosedStrip 0 1) := by
  rw [bddAbove_def]
  apply Exists.intro ((Fintype.card J : Real) * (‖T‖ * (max 1 ‖f‖) ^ 2) *
    (max 1 ‖g‖) ^ 2)
  intro y hy
  rcases hy with ⟨z, hz, rfl⟩
  have hz0 : 0 ≤ z.re := hz.1
  have hz1 : z.re ≤ 1 := hz.2
  have hinre0 : 0 ≤ (finiteAtomicTwoTopInputExponent z).re := by
    rw [finiteAtomicTwoTopInputExponent_re]
    nlinarith
  have hinre2 : (finiteAtomicTwoTopInputExponent z).re ≤ 2 := by
    rw [finiteAtomicTwoTopInputExponent_re]
    nlinarith
  have htestre0 : 0 ≤ (finiteAtomicTwoTopTestExponent z).re := by
    rw [finiteAtomicTwoTopTestExponent_re]
    nlinarith
  have htestre2 : (finiteAtomicTwoTopTestExponent z).re ≤ 2 := by
    rw [finiteAtomicTwoTopTestExponent_re]
    nlinarith
  have hfi : ∀ i, ‖finiteAtomicPowerFamily f finiteAtomicTwoTopInputExponent z i‖ ≤
      (max 1 ‖f‖) ^ 2 := by
    intro i
    exact finiteAtomicPowerFamily_norm_le_square_max f _ z i hinre0 hinre2
  have hgj : ∀ j, ‖finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent z j‖ ≤
      (max 1 ‖g‖) ^ 2 := by
    intro j
    exact finiteAtomicPowerFamily_norm_le_square_max g _ z j htestre0 htestre2
  have hinputnorm : ‖finiteAtomicPowerFamily f finiteAtomicTwoTopInputExponent z‖ ≤
      (max 1 ‖f‖) ^ 2 := by
    apply (pi_norm_le_iff_of_nonneg (by positivity)).mpr
    exact hfi
  have hTnorm : ‖T (finiteAtomicPowerFamily f finiteAtomicTwoTopInputExponent z)‖ ≤
      ‖T‖ * (max 1 ‖f‖) ^ 2 :=
    T.le_opNorm_of_le hinputnorm
  unfold finiteAtomicPairing
  calc
    ‖∑ j, T (finiteAtomicPowerFamily f finiteAtomicTwoTopInputExponent z) j *
          finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent z j‖ ≤
        ∑ j, ‖T (finiteAtomicPowerFamily f finiteAtomicTwoTopInputExponent z) j‖ *
            ‖finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent z j‖ := by
          refine (norm_sum_le _ _).trans_eq ?_
          apply Finset.sum_congr rfl
          intro j _
          rw [norm_mul]
    _ ≤ ∑ j, (‖T‖ * (max 1 ‖f‖) ^ 2) * (max 1 ‖g‖) ^ 2 := by
          apply Finset.sum_le_sum
          intro j _
          exact mul_le_mul
            ((norm_le_pi_norm
              (T (finiteAtomicPowerFamily f finiteAtomicTwoTopInputExponent z)) j).trans hTnorm)
            (hgj j) (norm_nonneg _) (by positivity)
    _ = (Fintype.card J : Real) * (‖T‖ * (max 1 ‖f‖) ^ 2) *
        (max 1 ‖g‖) ^ 2 := by
          simp [nsmul_eq_mul]
          ring

/-- Cauchy--Schwarz for the finite complex pairing used at the `L²`
boundary. -/
theorem finiteAtomic_sum_norm_mul_le_sqrt {J : Type*} [Fintype J]
    (x y : J → Complex) :
    ‖∑ j, x j * y j‖ ≤
      Real.sqrt (∑ j, ‖x j‖ ^ 2) * Real.sqrt (∑ j, ‖y j‖ ^ 2) := by
  calc
    ‖∑ j, x j * y j‖ ≤ ∑ j, ‖x j * y j‖ := norm_sum_le _ _
    _ = ∑ j, ‖x j‖ * ‖y j‖ := by
      apply Finset.sum_congr rfl
      intro j _
      rw [norm_mul]
    _ ≤ Real.sqrt (∑ j, ‖x j‖ ^ 2) * Real.sqrt (∑ j, ‖y j‖ ^ 2) :=
      Real.sum_mul_le_sqrt_mul_sqrt _ _ _

/-- Literal normalized left-boundary estimate for the finite atomic pairing.
The hypotheses are precisely a finite `ℓ²` endpoint bound and normalized
finite `ℓ⁴` / `ℓ^(4/3)` moments. -/
theorem finiteAtomicTwoTopPairing_left_bound {I J : Type*} [Fintype I] [Fintype J]
    (T : (I → Complex) →L[Complex] (J → Complex)) (A : Real) (hA : 0 ≤ A)
    (hT : ∀ u, Real.sqrt (∑ j, ‖T u j‖ ^ 2) ≤ A *
      Real.sqrt (∑ i, ‖u i‖ ^ 2))
    (f : I → Complex) (g : J → Complex) (w : Complex)
    (hw : w.re = 0)
    (hf : ∑ i, ‖f i‖ ^ 4 ≤ 1)
    (hg : ∑ j, ‖g j‖ ^ (4 / 3 : Real) ≤ 1) :
    ‖finiteAtomicPairing T f finiteAtomicTwoTopInputExponent g
      finiteAtomicTwoTopTestExponent w‖ ≤ A := by
  unfold finiteAtomicPairing
  have hinput := finiteAtomicTwoTopInput_left_square_norm f w hw
  have htest := finiteAtomicTwoTopTest_left_square_norm g w hw
  have hxf : Real.sqrt
      (∑ i, ‖finiteAtomicPowerFamily f finiteAtomicTwoTopInputExponent w i‖ ^ 2) ≤ 1 := by
    rw [hinput, ← Real.sqrt_one]
    exact Real.sqrt_le_sqrt hf
  have hyg : Real.sqrt
      (∑ j, ‖finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent w j‖ ^ 2) ≤ 1 := by
    rw [htest, ← Real.sqrt_one]
    exact Real.sqrt_le_sqrt hg
  have hTx : Real.sqrt
      (∑ j, ‖T (finiteAtomicPowerFamily f finiteAtomicTwoTopInputExponent w) j‖ ^ 2) ≤ A := by
    calc
      Real.sqrt (∑ j, ‖T (finiteAtomicPowerFamily f finiteAtomicTwoTopInputExponent w) j‖ ^ 2) ≤
          A * Real.sqrt
            (∑ i, ‖finiteAtomicPowerFamily f finiteAtomicTwoTopInputExponent w i‖ ^ 2) :=
        hT _
      _ ≤ A * 1 := mul_le_mul_of_nonneg_left hxf hA
      _ = A := by ring
  calc
    ‖∑ j, T (finiteAtomicPowerFamily f finiteAtomicTwoTopInputExponent w) j *
          finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent w j‖ ≤
        Real.sqrt (∑ j, ‖T (finiteAtomicPowerFamily f finiteAtomicTwoTopInputExponent w) j‖ ^ 2) *
          Real.sqrt (∑ j, ‖finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent w j‖ ^ 2) :=
      finiteAtomic_sum_norm_mul_le_sqrt _ _
    _ ≤ A * 1 := mul_le_mul hTx hyg (Real.sqrt_nonneg _) hA
    _ = A := by ring

/-- Literal normalized right-boundary estimate for the finite atomic pairing.
The operator hypothesis is a finite `ℓ∞` endpoint bound. -/
theorem finiteAtomicTwoTopPairing_right_bound {I J : Type*} [Fintype I] [Fintype J]
    (T : (I → Complex) →L[Complex] (J → Complex)) (B : Real) (hB : 0 ≤ B)
    (hT : ∀ (u : I → Complex) (a : Real), 0 ≤ a →
      (∀ i, ‖u i‖ ≤ a) → ∀ j, ‖T u j‖ ≤ B * a)
    (f : I → Complex) (g : J → Complex) (w : Complex)
    (hw : w.re = 1)
    (hg : ∑ j, ‖g j‖ ^ (4 / 3 : Real) ≤ 1) :
    ‖finiteAtomicPairing T f finiteAtomicTwoTopInputExponent g
      finiteAtomicTwoTopTestExponent w‖ ≤ B := by
  unfold finiteAtomicPairing
  have hre : (finiteAtomicTwoTopInputExponent w).re = 0 := by
    rw [finiteAtomicTwoTopInputExponent_re, hw]
    norm_num
  have hinput : ∀ i, ‖finiteAtomicPowerFamily f finiteAtomicTwoTopInputExponent w i‖ ≤ 1 := by
    intro i
    calc
      ‖finiteAtomicPowerFamily f finiteAtomicTwoTopInputExponent w i‖ ≤
          ‖f i‖ ^ (finiteAtomicTwoTopInputExponent w).re :=
        norm_finiteAtomicPowerFamily_le_rpow f _ _ _
      _ = ‖f i‖ ^ (0 : Real) := by rw [hre]
      _ = 1 := Real.rpow_zero _
  have hTpoint : ∀ j, ‖T (finiteAtomicPowerFamily f finiteAtomicTwoTopInputExponent w) j‖ ≤ B := by
    intro j
    simpa using hT _ 1 (by norm_num) hinput j
  have htest := finiteAtomicTwoTopTest_right_one_norm g w hw
  have hgy : ∑ j, ‖finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent w j‖ ≤ 1 := by
    rw [htest]
    exact hg
  calc
    ‖∑ j, T (finiteAtomicPowerFamily f finiteAtomicTwoTopInputExponent w) j *
          finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent w j‖ ≤
        ∑ j, ‖T (finiteAtomicPowerFamily f finiteAtomicTwoTopInputExponent w) j‖ *
          ‖finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent w j‖ := by
      refine (norm_sum_le _ _).trans_eq ?_
      apply Finset.sum_congr rfl
      intro j _
      rw [norm_mul]
    _ ≤ ∑ j, B * ‖finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent w j‖ := by
      apply Finset.sum_le_sum
      intro j _
      exact mul_le_mul_of_nonneg_right (hTpoint j) (norm_nonneg _)
    _ = B * ∑ j, ‖finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent w j‖ := by
      rw [Finset.mul_sum]
    _ ≤ B * 1 := mul_le_mul_of_nonneg_left hgy hB
    _ = B := by ring

/-- Sharp midpoint pairing estimate obtained directly from the two literal
finite endpoint bounds, the explicit complex powers, and three-lines. -/
theorem finiteAtomicTwoTopPairing_midpoint_bound {I J : Type*} [Fintype I] [Fintype J]
    (T : (I → Complex) →L[Complex] (J → Complex))
    (A B : Real) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hTtwo : ∀ u, Real.sqrt (∑ j, ‖T u j‖ ^ 2) ≤ A *
      Real.sqrt (∑ i, ‖u i‖ ^ 2))
    (hTtop : ∀ (u : I → Complex) (a : Real), 0 ≤ a →
      (∀ i, ‖u i‖ ≤ a) → ∀ j, ‖T u j‖ ≤ B * a)
    (f : I → Complex) (g : J → Complex)
    (hf : ∑ i, ‖f i‖ ^ 4 ≤ 1)
    (hg : ∑ j, ‖g j‖ ^ (4 / 3 : Real) ≤ 1) :
    ‖∑ j, T f j * g j‖ ≤ A ^ (1 / 2 : Real) * B ^ (1 / 2 : Real) := by
  have hanalytic : ScalarAnalyticFamily 0 1
      (finiteAtomicPairing T f finiteAtomicTwoTopInputExponent g finiteAtomicTwoTopTestExponent) :=
    finiteAtomicPairing_analytic T f g differentiable_finiteAtomicTwoTopInputExponent
      differentiable_finiteAtomicTwoTopTestExponent
  have hbounded := finiteAtomicTwoTopPairing_bddAbove T f g
  have hleft : ∀ w ∈ Complex.re ⁻¹' ({(0 : Real)} : Set Real),
      ‖finiteAtomicPairing T f finiteAtomicTwoTopInputExponent g finiteAtomicTwoTopTestExponent w‖ ≤ A := by
    intro w hw
    exact finiteAtomicTwoTopPairing_left_bound T A hA hTtwo f g w (by simpa using hw) hf hg
  have hright : ∀ w ∈ Complex.re ⁻¹' ({(1 : Real)} : Set Real),
      ‖finiteAtomicPairing T f finiteAtomicTwoTopInputExponent g finiteAtomicTwoTopTestExponent w‖ ≤ B := by
    intro w hw
    exact finiteAtomicTwoTopPairing_right_bound T B hB hTtop f g w (by simpa using hw) hg
  have hthree := scalarThreeLines_unit (F :=
      finiteAtomicPairing T f finiteAtomicTwoTopInputExponent g finiteAtomicTwoTopTestExponent)
      (A0 := A) (A1 := B) (theta := (1 / 2 : Real)) (by norm_num)
      hanalytic hbounded hleft hright
  have hfhalf : finiteAtomicPowerFamily f finiteAtomicTwoTopInputExponent
      ((1 / 2 : Real) : Complex) = f :=
    finiteAtomicPowerFamily_apply_of_exponent_one f finiteAtomicTwoTopInputExponent
      ((1 / 2 : Real) : Complex) finiteAtomicTwoTopInputExponent_half
  have hghalf : finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent
      ((1 / 2 : Real) : Complex) = g :=
    finiteAtomicPowerFamily_apply_of_exponent_one g finiteAtomicTwoTopTestExponent
      ((1 / 2 : Real) : Complex) finiteAtomicTwoTopTestExponent_half
  unfold finiteAtomicPairing at hthree
  rw [hfhalf, hghalf] at hthree
  convert hthree using 1 <;> norm_num

/-- The conjugate phase of a complex coordinate, with the convention that
the phase of zero is zero. -/
def finiteAtomicPhase (y : Complex) : Complex :=
  (starRingEnd Complex y) / ((‖y‖ : Real) : Complex)

/-- Phase-lift a nonnegative finite dual vector to a complex dual vector. -/
def finiteAtomicDualTest (φ : NNReal) (y : Complex) : Complex :=
  (φ : Complex) * finiteAtomicPhase y

/-- The phase-lift pairs exactly with its original coordinate. -/
theorem finiteAtomic_mul_phase {y : Complex} : y * finiteAtomicPhase y = (‖y‖ : Complex) := by
  unfold finiteAtomicPhase
  by_cases hy : y = 0
  · subst y
    simp
  · have hn : ¬ (((‖y‖ : Real) : Complex) = 0) :=
      Complex.ofReal_ne_zero.mpr (norm_ne_zero_iff.mpr hy)
    rw [← mul_div_assoc, Complex.mul_conj']
    field_simp

/-- The complex phase lift has the expected pointwise pairing. -/
theorem finiteAtomicDualTest_pair (φ : NNReal) (y : Complex) :
    y * finiteAtomicDualTest φ y = ((φ * ‖y‖₊ : NNReal) : Complex) := by
  unfold finiteAtomicDualTest
  calc
    y * ((φ : Complex) * finiteAtomicPhase y) =
        (φ : Complex) * (y * finiteAtomicPhase y) := by ring
    _ = (φ : Complex) * (‖y‖ : Complex) := by rw [finiteAtomic_mul_phase]
    _ = ((φ * ‖y‖₊ : NNReal) : Complex) := by
      rw [NNReal.coe_mul, coe_nnnorm]
      exact (Complex.ofReal_mul (φ : Real) (‖y‖)).symm

/-- A phase has norm at most one, including at a zero coordinate. -/
theorem finiteAtomicPhase_norm_le_one (y : Complex) : ‖finiteAtomicPhase y‖ ≤ 1 := by
  unfold finiteAtomicPhase
  by_cases hy : y = 0
  · simp [hy]
  · rw [norm_div, Complex.norm_conj, Complex.norm_real,
      Real.norm_eq_abs, abs_of_nonneg (norm_nonneg y)]
    exact (div_self (norm_ne_zero_iff.mpr hy)).le

/-- The phase-lifted dual coordinate is bounded by the underlying
nonnegative dual coordinate. -/
theorem finiteAtomicDualTest_norm_le (φ : NNReal) (y : Complex) :
    ‖finiteAtomicDualTest φ y‖ ≤ (φ : Real) := by
  unfold finiteAtomicDualTest
  calc
    ‖(φ : Complex) * finiteAtomicPhase y‖ = (φ : Real) * ‖finiteAtomicPhase y‖ := by
      rw [norm_mul, Complex.norm_real, NNReal.norm_eq]
    _ ≤ (φ : Real) * 1 :=
      mul_le_mul_of_nonneg_left (finiteAtomicPhase_norm_le_one y) φ.2
    _ = (φ : Real) := by ring

/-- A phase-lifted finite dual vector has controlled `ℓ^(4/3)` moment. -/
theorem finiteAtomicDualTest_moment_le_one {J : Type*} [Fintype J]
    (y : J → Complex) (φ : J → NNReal)
    (hφ : ∑ j, φ j ^ (4 / 3 : Real) ≤ 1) :
    ∑ j, ‖finiteAtomicDualTest (φ j) (y j)‖ ^ (4 / 3 : Real) ≤ 1 := by
  calc
    ∑ j, ‖finiteAtomicDualTest (φ j) (y j)‖ ^ (4 / 3 : Real) ≤
        ∑ j, ((φ j : Real) ^ (4 / 3 : Real)) := by
      apply Finset.sum_le_sum
      intro j _
      exact Real.rpow_le_rpow (norm_nonneg _)
        (finiteAtomicDualTest_norm_le (φ j) (y j)) (by norm_num)
    _ = ↑(∑ j, φ j ^ (4 / 3 : Real)) := by
      symm
      rw [NNReal.coe_sum]
      apply Finset.sum_congr rfl
      intro j _
      exact NNReal.coe_rpow (φ j) (4 / 3 : Real)
    _ ≤ 1 := by exact_mod_cast hφ

/-- The phase lift realizes the finite nonnegative dual maximizer as a
complex pairing. -/
theorem finiteAtomicDualTest_pairing_eq {J : Type*} [Fintype J]
    (y : J → Complex) (φ : J → NNReal)
    (hEq : (∑ i, ‖y i‖₊ * φ i) =
      (∑ i, ‖y i‖₊ ^ (4 : Real)) ^ (1 / 4 : Real)) :
    ∑ j, y j * finiteAtomicDualTest (φ j) (y j) =
      (((∑ j, ‖y j‖₊ ^ (4 : Real)) ^ (1 / 4 : Real) : NNReal) : Complex) := by
  calc
    ∑ j, y j * finiteAtomicDualTest (φ j) (y j) =
        ∑ j, ((φ j * ‖y j‖₊ : NNReal) : Complex) := by
      apply Finset.sum_congr rfl
      intro j _
      exact finiteAtomicDualTest_pair (φ j) (y j)
    _ = ((∑ j, φ j * ‖y j‖₊ : NNReal) : Complex) := by
      rw [← Complex.ofReal_sum, ← NNReal.coe_sum]
    _ = ((∑ j, ‖y j‖₊ * φ j : NNReal) : Complex) := by
      have h : (∑ j, φ j * ‖y j‖₊ : NNReal) = ∑ j, ‖y j‖₊ * φ j := by
        apply Finset.sum_congr rfl
        intro j _
        rw [mul_comm]
      rw [h]
    _ = (((∑ j, ‖y j‖₊ ^ (4 : Real)) ^ (1 / 4 : Real) : NNReal) : Complex) := by
      exact congrArg (fun r : NNReal ↦ (r : Complex)) hEq

/-- Exact finite complex `ℓ⁴` norming: a phase-lifted `ℓ^(4/3)` test vector
attains the finite `ℓ⁴` norm. -/
theorem finiteAtomic_exists_l4_dualTest {J : Type*} [Fintype J] (y : J → Complex) :
    ∃ g : J → Complex,
      (∑ j, ‖g j‖ ^ (4 / 3 : Real) ≤ 1) ∧
      (∑ j, y j * g j) =
        (((∑ j, ‖y j‖₊ ^ (4 : Real)) ^ (1 / 4 : Real) : NNReal) : Complex) := by
  have hpq : (4 : Real).HolderConjugate (4 / 3 : Real) := by
    rw [Real.holderConjugate_iff]
    norm_num
  have hgreat := NNReal.isGreatest_Lp Finset.univ (fun j ↦ ‖y j‖₊) hpq
  rcases hgreat.1 with ⟨φ, hφ, hEq⟩
  refine ⟨fun j ↦ finiteAtomicDualTest (φ j) (y j), ?_, ?_⟩
  · exact finiteAtomicDualTest_moment_le_one y φ hφ
  · exact finiteAtomicDualTest_pairing_eq y φ hEq

/-- The finite atomic `ℓ⁴` norm, expressed as a nonnegative real so that its
finite phase-duality formula is exact. -/
def finiteAtomicL4Norm {J : Type*} [Fintype J] (y : J → Complex) : NNReal :=
  (∑ j, ‖y j‖₊ ^ (4 : Real)) ^ (1 / 4 : Real)

/-- Direct sharp normalized finite atomic `L²`--`L∞` to `L⁴` estimate.  This
has only literal endpoint assumptions; its proof combines the explicit
complex-power pairing with the phase-lifted finite dual norming theorem. -/
theorem finiteAtomicTwoTopFour_normalized {I J : Type*} [Fintype I] [Fintype J]
    (T : (I → Complex) →L[Complex] (J → Complex))
    (A B : Real) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hTtwo : ∀ u, Real.sqrt (∑ j, ‖T u j‖ ^ 2) ≤ A *
      Real.sqrt (∑ i, ‖u i‖ ^ 2))
    (hTtop : ∀ (u : I → Complex) (a : Real), 0 ≤ a →
      (∀ i, ‖u i‖ ≤ a) → ∀ j, ‖T u j‖ ≤ B * a)
    (f : I → Complex) (hf : ∑ i, ‖f i‖ ^ 4 ≤ 1) :
    (finiteAtomicL4Norm (T f) : Real) ≤
      A ^ (1 / 2 : Real) * B ^ (1 / 2 : Real) := by
  obtain ⟨g, hg, hpair⟩ := finiteAtomic_exists_l4_dualTest (T f)
  have hnorm : ‖∑ j, T f j * g j‖ = (finiteAtomicL4Norm (T f) : Real) := by
    rw [hpair, Complex.norm_real, NNReal.norm_eq]
    rfl
  calc
    (finiteAtomicL4Norm (T f) : Real) = ‖∑ j, T f j * g j‖ := hnorm.symm
    _ ≤ A ^ (1 / 2 : Real) * B ^ (1 / 2 : Real) :=
      finiteAtomicTwoTopPairing_midpoint_bound T A B hA hB hTtwo hTtop f g hf hg

/-- Scalar multiplication is homogeneous for the finite atomic `ℓ⁴` norm. -/
theorem finiteAtomicL4Norm_smul {J : Type*} [Fintype J]
    (c : Complex) (y : J → Complex) :
    finiteAtomicL4Norm (c • y) = ‖c‖₊ * finiteAtomicL4Norm y := by
  unfold finiteAtomicL4Norm
  have hsum : (∑ j, ‖(c • y) j‖₊ ^ (4 : Real)) =
      ‖c‖₊ ^ (4 : Real) * (∑ j, ‖y j‖₊ ^ (4 : Real)) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j hj
    rw [Pi.smul_apply, nnnorm_smul, NNReal.mul_rpow]
  rw [hsum, NNReal.mul_rpow]
  have hc : (‖c‖₊ ^ (4 : Real)) ^ (1 / 4 : Real) = ‖c‖₊ := by
    rw [← NNReal.rpow_mul]
    norm_num
  rw [hc]

/-- The fourth power of the finite atomic `ℓ⁴` norm is its defining moment. -/
theorem finiteAtomicL4Norm_pow_four {J : Type*} [Fintype J]
    (y : J → Complex) :
    (finiteAtomicL4Norm y) ^ (4 : Nat) = ∑ j, ‖y j‖₊ ^ (4 : Real) := by
  unfold finiteAtomicL4Norm
  rw [← NNReal.rpow_natCast, ← NNReal.rpow_mul]
  norm_num

/-- The real fourth-power moment agrees with the coercion of its nonnegative
finite counterpart. -/
theorem finiteAtomic_sum_norm_four_eq_coe {I : Type*} [Fintype I]
    (f : I → Complex) :
    (∑ i, ‖f i‖ ^ (4 : Nat)) =
      ↑(∑ i, ‖f i‖₊ ^ (4 : Real)) := by
  rw [NNReal.coe_sum]
  apply Finset.sum_congr rfl
  intro i hi
  rw [NNReal.coe_rpow, coe_nnnorm]
  exact (Real.rpow_natCast ‖f i‖ 4).symm

/-- The finite atomic `ℓ⁴` norm vanishes exactly at the zero vector. -/
theorem finiteAtomicL4Norm_eq_zero_iff {I : Type*} [Fintype I]
    (f : I → Complex) : finiteAtomicL4Norm f = 0 ↔ f = 0 := by
  constructor
  · intro h
    have hmoment : (∑ i, ‖f i‖₊ ^ (4 : Real)) = 0 := by
      rw [← finiteAtomicL4Norm_pow_four f, h]
      norm_num
    funext i
    have hi : ‖f i‖₊ ^ (4 : Real) = 0 :=
      ((Finset.sum_eq_zero_iff_of_nonneg (by
        intro k hk
        positivity)).mp hmoment)
        i (Finset.mem_univ _)
    exact nnnorm_eq_zero.mp (NNReal.rpow_eq_zero_iff.mp hi).1
  · intro h
    subst f
    simp [finiteAtomicL4Norm]

/-- Direct homogeneous sharp finite atomic `L²`--`L∞` to `L⁴` estimate.

Unlike the earlier analytic-datum interface, this theorem takes the literal
endpoint estimates on a complex linear operator. -/
theorem finiteAtomicTwoTopFour {I J : Type*} [Fintype I] [Fintype J]
    (T : (I → Complex) →L[Complex] (J → Complex))
    (A B : Real) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hTtwo : ∀ u, Real.sqrt (∑ j, ‖T u j‖ ^ 2) ≤ A *
      Real.sqrt (∑ i, ‖u i‖ ^ 2))
    (hTtop : ∀ (u : I → Complex) (a : Real), 0 ≤ a →
      (∀ i, ‖u i‖ ≤ a) → ∀ j, ‖T u j‖ ≤ B * a)
    (f : I → Complex) :
    (finiteAtomicL4Norm (T f) : Real) ≤
      A ^ (1 / 2 : Real) * B ^ (1 / 2 : Real) * (finiteAtomicL4Norm f : Real) := by
  by_cases hr : finiteAtomicL4Norm f = 0
  · have hfzero : f = 0 := (finiteAtomicL4Norm_eq_zero_iff f).mp hr
    subst f
    simp [finiteAtomicL4Norm]
  · let r : NNReal := finiteAtomicL4Norm f
    let f₀ : I → Complex := (r : Complex)⁻¹ • f
    have hr0 : r ≠ 0 := by simpa [r] using hr
    have hf₀norm : finiteAtomicL4Norm f₀ = 1 := by
      dsimp [f₀]
      rw [finiteAtomicL4Norm_smul]
      simp [nnnorm_inv, NNReal.nnnorm_eq]
      change r⁻¹ * r = 1
      exact inv_mul_cancel₀ hr0
    have hf₀ : (∑ i, ‖f₀ i‖ ^ (4 : Nat)) ≤ 1 := by
      rw [finiteAtomic_sum_norm_four_eq_coe]
      have hpow := congrArg (fun s : NNReal => s ^ (4 : Nat)) hf₀norm
      rw [finiteAtomicL4Norm_pow_four] at hpow
      norm_num at hpow
      exact_mod_cast hpow.le
    have hbound :=
      finiteAtomicTwoTopFour_normalized T A B hA hB hTtwo hTtop f₀ hf₀
    have hmap : T f₀ = (r : Complex)⁻¹ • T f := by
      simp [f₀]
    rw [hmap, finiteAtomicL4Norm_smul] at hbound
    have hrescaled : (r : Real)⁻¹ * (finiteAtomicL4Norm (T f) : Real) ≤
        A ^ (1 / 2 : Real) * B ^ (1 / 2 : Real) := by
      simpa [nnnorm_inv, NNReal.nnnorm_eq, r] using hbound
    have hrpos : 0 < (r : Real) := NNReal.coe_pos.mpr (pos_iff_ne_zero.mpr hr0)
    calc
      (finiteAtomicL4Norm (T f) : Real) =
          (r : Real) * ((r : Real)⁻¹ * (finiteAtomicL4Norm (T f) : Real)) := by
        field_simp
      _ ≤ (r : Real) * (A ^ (1 / 2 : Real) * B ^ (1 / 2 : Real)) :=
        mul_le_mul_of_nonneg_left hrescaled hrpos.le
      _ = A ^ (1 / 2 : Real) * B ^ (1 / 2 : Real) *
          (finiteAtomicL4Norm f : Real) := by
        simp only [r]
        ring

/-! ### Vector-valued finite atomic inputs

The source coordinates in the local-smoothing argument take values in a
complex normed space (eventually a finite `ℓ²` space).  The same radial
complex-power construction therefore needs a vector-valued form; it is kept
separate from the scalar output test family above. -/

/-- Zero-safe radial complex-power deformation of a vector-valued finite
atomic input. -/
def finiteAtomicVectorPowerFamily {I E : Type*}
    [NormedAddCommGroup E] [NormedSpace Complex E] (f : I → E)
    (e : Complex → Complex) : Complex → I → E :=
  fun z i ↦ finiteAtomicCpow (‖f i‖ : Complex) e z •
    ((‖f i‖ : Complex)⁻¹ • f i)

/-- The vector-valued radial finite atomic deformation is holomorphic
coordinatewise. -/
theorem differentiable_finiteAtomicVectorPowerFamily {I E : Type*}
    [NormedAddCommGroup E] [NormedSpace Complex E] (f : I → E)
    {e : Complex → Complex} (he : Differentiable Complex e) :
    Differentiable Complex (finiteAtomicVectorPowerFamily f e) := by
  rw [differentiable_pi]
  intro i
  unfold finiteAtomicVectorPowerFamily
  exact (differentiable_finiteAtomicCpow (‖f i‖ : Complex) he).smul_const _

/-- Pointwise norm control for a vector-valued finite atomic power family. -/
theorem norm_finiteAtomicVectorPowerFamily_le_rpow {I E : Type*}
    [NormedAddCommGroup E] [NormedSpace Complex E] (f : I → E)
    (e : Complex → Complex) (z : Complex) (i : I) :
    ‖finiteAtomicVectorPowerFamily f e z i‖ ≤ ‖f i‖ ^ (e z).re := by
  unfold finiteAtomicVectorPowerFamily
  by_cases hfi : f i = 0
  · simp [hfi, finiteAtomicCpow]
    exact Real.zero_rpow_nonneg _
  · have hn : ‖f i‖ ≠ 0 := norm_ne_zero_iff.mpr hfi
    have hpos : 0 < ‖f i‖ := norm_pos_iff.mpr hfi
    have hbase : (‖f i‖ : Complex) ≠ 0 := Complex.ofReal_ne_zero.mpr hn
    rw [finiteAtomicCpow, if_neg hbase, norm_smul, norm_smul,
      Complex.norm_cpow_eq_rpow_re_of_pos hpos, norm_inv,
      Complex.norm_real, Real.norm_of_nonneg (norm_nonneg _)]
    field_simp
    norm_num

/-- Away from exponent real part zero, the vector-valued power deformation
has the expected coordinate norm exactly. -/
theorem norm_finiteAtomicVectorPowerFamily_eq_rpow_of_re_pos {I E : Type*}
    [NormedAddCommGroup E] [NormedSpace Complex E] (f : I → E)
    (e : Complex → Complex) (z : Complex) (i : I)
    (hre : 0 < (e z).re) :
    ‖finiteAtomicVectorPowerFamily f e z i‖ = ‖f i‖ ^ (e z).re := by
  unfold finiteAtomicVectorPowerFamily
  by_cases hfi : f i = 0
  · simp [hfi, finiteAtomicCpow]
    exact (Real.zero_rpow (ne_of_gt hre)).symm
  · have hn : ‖f i‖ ≠ 0 := norm_ne_zero_iff.mpr hfi
    have hpos : 0 < ‖f i‖ := norm_pos_iff.mpr hfi
    have hbase : (‖f i‖ : Complex) ≠ 0 := Complex.ofReal_ne_zero.mpr hn
    rw [finiteAtomicCpow, if_neg hbase, norm_smul, norm_smul,
      Complex.norm_cpow_eq_rpow_re_of_pos hpos, norm_inv,
      Complex.norm_real, Real.norm_of_nonneg (norm_nonneg _)]
    field_simp

/-- At exponent one, the vector-valued radial deformation recovers its
original finite atomic vector. -/
theorem finiteAtomicVectorPowerFamily_apply_of_exponent_one {I E : Type*}
    [NormedAddCommGroup E] [NormedSpace Complex E] (f : I → E)
    (e : Complex → Complex) (z : Complex) (he : e z = 1) :
    finiteAtomicVectorPowerFamily f e z = f := by
  funext i
  unfold finiteAtomicVectorPowerFamily
  rw [finiteAtomicCpow, he]
  by_cases hfi : f i = 0
  · simp [hfi]
  · have hn : ‖f i‖ ≠ 0 := norm_ne_zero_iff.mpr hfi
    have hbase : (‖f i‖ : Complex) ≠ 0 := Complex.ofReal_ne_zero.mpr hn
    rw [if_neg hbase, Complex.cpow_one, smul_smul]
    rw [mul_inv_cancel₀ hbase, one_smul]

/-- A vector-valued finite atomic complex-power coordinate remains bounded by
one when its base is at most one and its exponent has nonnegative real part. -/
theorem finiteAtomicVectorPowerFamily_norm_le_one_of_norm_le_one
    {I E : Type*} [NormedAddCommGroup E] [NormedSpace Complex E]
    (f : I → E) (e : Complex → Complex) (z : Complex) (i : I)
    (hfi : ‖f i‖ ≤ 1) (hre : 0 ≤ (e z).re) :
    ‖finiteAtomicVectorPowerFamily f e z i‖ ≤ 1 :=
  (norm_finiteAtomicVectorPowerFamily_le_rpow f e z i).trans
    (Real.rpow_le_one (norm_nonneg _) hfi hre)

/-- A coarse global coordinate bound for a vector-valued finite atomic power
family on the unit strip. -/
theorem finiteAtomicVectorPowerFamily_norm_le_square_max {I E : Type*}
    [Fintype I] [NormedAddCommGroup E] [NormedSpace Complex E]
    (f : I → E) (e : Complex → Complex) (z : Complex) (i : I)
    (hre0 : 0 ≤ (e z).re) (hre2 : (e z).re ≤ 2) :
    ‖finiteAtomicVectorPowerFamily f e z i‖ ≤ (max 1 ‖f‖) ^ 2 := by
  have hcoord : ‖f i‖ ≤ ‖f‖ := norm_le_pi_norm f i
  have hmax : max 1 ‖f i‖ ≤ max 1 ‖f‖ :=
    max_le (le_max_left _ _) (hcoord.trans (le_max_right _ _))
  calc
    ‖finiteAtomicVectorPowerFamily f e z i‖ ≤ ‖f i‖ ^ (e z).re :=
      norm_finiteAtomicVectorPowerFamily_le_rpow f e z i
    _ ≤ (max 1 ‖f i‖) ^ (e z).re :=
      Real.rpow_le_rpow (norm_nonneg _) (le_max_right _ _) hre0
    _ ≤ (max 1 ‖f i‖) ^ (2 : Real) :=
      Real.rpow_le_rpow_of_exponent_le (le_max_left _ _) hre2
    _ = (max 1 ‖f i‖) ^ 2 := Real.rpow_natCast _ 2
    _ ≤ (max 1 ‖f‖) ^ 2 := by
      rw [pow_two, pow_two]
      exact mul_self_le_mul_self (by positivity) hmax

/-- Scalar pairing for a vector-valued finite atomic source and scalar finite
atomic output test vector. -/
def finiteAtomicVectorPairing {I J E : Type*} [Fintype I] [Fintype J]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    (T : (I → E) →L[Complex] (J → Complex))
    (f : I → E) (a : Complex → Complex)
    (g : J → Complex) (b : Complex → Complex) : Complex → Complex :=
  fun z ↦ ∑ j, T (finiteAtomicVectorPowerFamily f a z) j *
    finiteAtomicPowerFamily g b z j

/-- The vector-source finite atomic pairing is entire. -/
theorem differentiable_finiteAtomicVectorPairing {I J E : Type*}
    [Fintype I] [Fintype J] [NormedAddCommGroup E] [NormedSpace Complex E]
    (T : (I → E) →L[Complex] (J → Complex))
    (f : I → E) {a : Complex → Complex}
    (g : J → Complex) {b : Complex → Complex}
    (ha : Differentiable Complex a) (hb : Differentiable Complex b) :
    Differentiable Complex (finiteAtomicVectorPairing T f a g b) := by
  classical
  unfold finiteAtomicVectorPairing
  have h : Differentiable Complex (Finset.univ.sum (fun j z ↦
      T (finiteAtomicVectorPowerFamily f a z) j * finiteAtomicPowerFamily g b z j)) :=
    Differentiable.sum (u := Finset.univ) (fun j _ ↦ by
      have hvector : Differentiable Complex (fun z ↦
          T (finiteAtomicVectorPowerFamily f a z)) := by
        simpa [Function.comp_def] using T.differentiable.comp
          (differentiable_finiteAtomicVectorPowerFamily f ha)
      have hT : Differentiable Complex (fun z ↦
          T (finiteAtomicVectorPowerFamily f a z) j) :=
        (differentiable_pi.mp hvector) j
      exact hT.mul
        ((differentiable_pi.mp (differentiable_finiteAtomicPowerFamily g hb)) j))
  convert h using 1
  ext z
  simp only [Finset.sum_apply]

/-- The vector-source finite atomic pairing is an analytic family on the unit
strip. -/
theorem finiteAtomicVectorPairing_analytic {I J E : Type*}
    [Fintype I] [Fintype J] [NormedAddCommGroup E] [NormedSpace Complex E]
    (T : (I → E) →L[Complex] (J → Complex))
    (f : I → E) {a : Complex → Complex}
    (g : J → Complex) {b : Complex → Complex}
    (ha : Differentiable Complex a) (hb : Differentiable Complex b) :
    ScalarAnalyticFamily 0 1 (finiteAtomicVectorPairing T f a g b) :=
  (differentiable_finiteAtomicVectorPairing T f g ha hb).diffContOnCl

/-- The vector-source finite atomic pairing is bounded on the full closed
unit strip.  As in the scalar-source proof, a coarse bound is sufficient. -/
theorem finiteAtomicTwoTopVectorPairing_bddAbove {I J E : Type*}
    [Fintype I] [Fintype J] [NormedAddCommGroup E] [NormedSpace Complex E]
    (T : (I → E) →L[Complex] (J → Complex))
    (f : I → E) (g : J → Complex) :
    BddAbove ((fun z ↦ ‖finiteAtomicVectorPairing T f finiteAtomicTwoTopInputExponent g
      finiteAtomicTwoTopTestExponent z‖) '' verticalClosedStrip 0 1) := by
  rw [bddAbove_def]
  apply Exists.intro ((Fintype.card J : Real) * (‖T‖ * (max 1 ‖f‖) ^ 2) *
    (max 1 ‖g‖) ^ 2)
  intro y hy
  rcases hy with ⟨z, hz, rfl⟩
  have hz0 : 0 ≤ z.re := hz.1
  have hz1 : z.re ≤ 1 := hz.2
  have hinre0 : 0 ≤ (finiteAtomicTwoTopInputExponent z).re := by
    rw [finiteAtomicTwoTopInputExponent_re]
    nlinarith
  have hinre2 : (finiteAtomicTwoTopInputExponent z).re ≤ 2 := by
    rw [finiteAtomicTwoTopInputExponent_re]
    nlinarith
  have htestre0 : 0 ≤ (finiteAtomicTwoTopTestExponent z).re := by
    rw [finiteAtomicTwoTopTestExponent_re]
    nlinarith
  have htestre2 : (finiteAtomicTwoTopTestExponent z).re ≤ 2 := by
    rw [finiteAtomicTwoTopTestExponent_re]
    nlinarith
  have hfi : ∀ i, ‖finiteAtomicVectorPowerFamily f finiteAtomicTwoTopInputExponent z i‖ ≤
      (max 1 ‖f‖) ^ 2 := by
    intro i
    exact finiteAtomicVectorPowerFamily_norm_le_square_max f _ z i hinre0 hinre2
  have hgj : ∀ j, ‖finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent z j‖ ≤
      (max 1 ‖g‖) ^ 2 := by
    intro j
    exact finiteAtomicPowerFamily_norm_le_square_max g _ z j htestre0 htestre2
  have hinputnorm : ‖finiteAtomicVectorPowerFamily f finiteAtomicTwoTopInputExponent z‖ ≤
      (max 1 ‖f‖) ^ 2 := by
    apply (pi_norm_le_iff_of_nonneg (by positivity)).mpr
    exact hfi
  have hTnorm : ‖T (finiteAtomicVectorPowerFamily f finiteAtomicTwoTopInputExponent z)‖ ≤
      ‖T‖ * (max 1 ‖f‖) ^ 2 :=
    T.le_opNorm_of_le hinputnorm
  unfold finiteAtomicVectorPairing
  calc
    ‖∑ j, T (finiteAtomicVectorPowerFamily f finiteAtomicTwoTopInputExponent z) j *
          finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent z j‖ ≤
        ∑ j, ‖T (finiteAtomicVectorPowerFamily f finiteAtomicTwoTopInputExponent z) j‖ *
            ‖finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent z j‖ := by
          refine (norm_sum_le _ _).trans_eq ?_
          apply Finset.sum_congr rfl
          intro j _
          rw [norm_mul]
    _ ≤ ∑ j, (‖T‖ * (max 1 ‖f‖) ^ 2) * (max 1 ‖g‖) ^ 2 := by
          apply Finset.sum_le_sum
          intro j _
          exact mul_le_mul
            ((norm_le_pi_norm
              (T (finiteAtomicVectorPowerFamily f finiteAtomicTwoTopInputExponent z)) j).trans hTnorm)
            (hgj j) (norm_nonneg _) (by positivity)
    _ = (Fintype.card J : Real) * (‖T‖ * (max 1 ‖f‖) ^ 2) *
        (max 1 ‖g‖) ^ 2 := by
          simp [nsmul_eq_mul]
          ring

/-- The vector-valued input deformation has the normalized `ℓ²` moment on
the left boundary. -/
theorem finiteAtomicTwoTopVectorInput_left_square_norm {I E : Type*}
    [Fintype I] [NormedAddCommGroup E] [NormedSpace Complex E]
    (f : I → E) (w : Complex) (hwre : w.re = 0) :
    ∑ i, ‖finiteAtomicVectorPowerFamily f finiteAtomicTwoTopInputExponent w i‖ ^ 2 =
      ∑ i, ‖f i‖ ^ 4 := by
  apply Finset.sum_congr rfl
  intro i _
  have hre : (finiteAtomicTwoTopInputExponent w).re = 2 := by
    rw [finiteAtomicTwoTopInputExponent_re, hwre]
    norm_num
  rw [norm_finiteAtomicVectorPowerFamily_eq_rpow_of_re_pos f _ _ _
    (by rw [hre]; norm_num), hre]
  calc
    (‖f i‖ ^ (2 : Real)) ^ 2 = Real.rpow (‖f i‖ ^ (2 : Real)) 2 := by
      symm
      exact Real.rpow_natCast _ 2
    _ = ‖f i‖ ^ ((2 : Real) * 2) :=
      (Real.rpow_mul (norm_nonneg _) _ _).symm
    _ = ‖f i‖ ^ (4 : Real) := by norm_num
    _ = ‖f i‖ ^ 4 := Real.rpow_natCast _ 4

/-- Literal normalized left-boundary estimate for the vector-source finite
atomic pairing. -/
theorem finiteAtomicTwoTopVectorPairing_left_bound {I J E : Type*}
    [Fintype I] [Fintype J] [NormedAddCommGroup E] [NormedSpace Complex E]
    (T : (I → E) →L[Complex] (J → Complex)) (A : Real) (hA : 0 ≤ A)
    (hT : ∀ u, Real.sqrt (∑ j, ‖T u j‖ ^ 2) ≤ A *
      Real.sqrt (∑ i, ‖u i‖ ^ 2))
    (f : I → E) (g : J → Complex) (w : Complex)
    (hw : w.re = 0)
    (hf : ∑ i, ‖f i‖ ^ 4 ≤ 1)
    (hg : ∑ j, ‖g j‖ ^ (4 / 3 : Real) ≤ 1) :
    ‖finiteAtomicVectorPairing T f finiteAtomicTwoTopInputExponent g
      finiteAtomicTwoTopTestExponent w‖ ≤ A := by
  unfold finiteAtomicVectorPairing
  have hinput := finiteAtomicTwoTopVectorInput_left_square_norm f w hw
  have htest := finiteAtomicTwoTopTest_left_square_norm g w hw
  have hxf : Real.sqrt
      (∑ i, ‖finiteAtomicVectorPowerFamily f finiteAtomicTwoTopInputExponent w i‖ ^ 2) ≤ 1 := by
    rw [hinput, ← Real.sqrt_one]
    exact Real.sqrt_le_sqrt hf
  have hyg : Real.sqrt
      (∑ j, ‖finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent w j‖ ^ 2) ≤ 1 := by
    rw [htest, ← Real.sqrt_one]
    exact Real.sqrt_le_sqrt hg
  have hTx : Real.sqrt
      (∑ j, ‖T (finiteAtomicVectorPowerFamily f finiteAtomicTwoTopInputExponent w) j‖ ^ 2) ≤ A := by
    calc
      Real.sqrt (∑ j, ‖T (finiteAtomicVectorPowerFamily f finiteAtomicTwoTopInputExponent w) j‖ ^ 2) ≤
          A * Real.sqrt
            (∑ i, ‖finiteAtomicVectorPowerFamily f finiteAtomicTwoTopInputExponent w i‖ ^ 2) :=
        hT _
      _ ≤ A * 1 := mul_le_mul_of_nonneg_left hxf hA
      _ = A := by ring
  calc
    ‖∑ j, T (finiteAtomicVectorPowerFamily f finiteAtomicTwoTopInputExponent w) j *
          finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent w j‖ ≤
        Real.sqrt (∑ j, ‖T (finiteAtomicVectorPowerFamily f finiteAtomicTwoTopInputExponent w) j‖ ^ 2) *
          Real.sqrt (∑ j, ‖finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent w j‖ ^ 2) :=
      finiteAtomic_sum_norm_mul_le_sqrt _ _
    _ ≤ A * 1 := mul_le_mul hTx hyg (Real.sqrt_nonneg _) hA
    _ = A := by ring

/-- Literal normalized right-boundary estimate for the vector-source finite
atomic pairing. -/
theorem finiteAtomicTwoTopVectorPairing_right_bound {I J E : Type*}
    [Fintype I] [Fintype J] [NormedAddCommGroup E] [NormedSpace Complex E]
    (T : (I → E) →L[Complex] (J → Complex)) (B : Real) (hB : 0 ≤ B)
    (hT : ∀ (u : I → E) (a : Real), 0 ≤ a →
      (∀ i, ‖u i‖ ≤ a) → ∀ j, ‖T u j‖ ≤ B * a)
    (f : I → E) (g : J → Complex) (w : Complex)
    (hw : w.re = 1)
    (hg : ∑ j, ‖g j‖ ^ (4 / 3 : Real) ≤ 1) :
    ‖finiteAtomicVectorPairing T f finiteAtomicTwoTopInputExponent g
      finiteAtomicTwoTopTestExponent w‖ ≤ B := by
  unfold finiteAtomicVectorPairing
  have hre : (finiteAtomicTwoTopInputExponent w).re = 0 := by
    rw [finiteAtomicTwoTopInputExponent_re, hw]
    norm_num
  have hinput : ∀ i, ‖finiteAtomicVectorPowerFamily f finiteAtomicTwoTopInputExponent w i‖ ≤ 1 := by
    intro i
    calc
      ‖finiteAtomicVectorPowerFamily f finiteAtomicTwoTopInputExponent w i‖ ≤
          ‖f i‖ ^ (finiteAtomicTwoTopInputExponent w).re :=
        norm_finiteAtomicVectorPowerFamily_le_rpow f _ _ _
      _ = ‖f i‖ ^ (0 : Real) := by rw [hre]
      _ = 1 := Real.rpow_zero _
  have hTpoint : ∀ j, ‖T (finiteAtomicVectorPowerFamily f finiteAtomicTwoTopInputExponent w) j‖ ≤ B := by
    intro j
    simpa using hT _ 1 (by norm_num) hinput j
  have htest := finiteAtomicTwoTopTest_right_one_norm g w hw
  have hgy : ∑ j, ‖finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent w j‖ ≤ 1 := by
    rw [htest]
    exact hg
  calc
    ‖∑ j, T (finiteAtomicVectorPowerFamily f finiteAtomicTwoTopInputExponent w) j *
          finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent w j‖ ≤
        ∑ j, ‖T (finiteAtomicVectorPowerFamily f finiteAtomicTwoTopInputExponent w) j‖ *
            ‖finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent w j‖ := by
          refine (norm_sum_le _ _).trans_eq ?_
          apply Finset.sum_congr rfl
          intro j _
          rw [norm_mul]
    _ ≤ ∑ j, B * ‖finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent w j‖ := by
          apply Finset.sum_le_sum
          intro j _
          exact mul_le_mul_of_nonneg_right (hTpoint j) (norm_nonneg _)
    _ = B * ∑ j, ‖finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent w j‖ := by
      rw [Finset.mul_sum]
    _ ≤ B * 1 := mul_le_mul_of_nonneg_left hgy hB
    _ = B := by ring

/-- Sharp midpoint pairing estimate for a vector-valued finite atomic source,
obtained directly from literal endpoint bounds and three-lines. -/
theorem finiteAtomicTwoTopVectorPairing_midpoint_bound {I J E : Type*}
    [Fintype I] [Fintype J] [NormedAddCommGroup E] [NormedSpace Complex E]
    (T : (I → E) →L[Complex] (J → Complex))
    (A B : Real) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hTtwo : ∀ u, Real.sqrt (∑ j, ‖T u j‖ ^ 2) ≤ A *
      Real.sqrt (∑ i, ‖u i‖ ^ 2))
    (hTtop : ∀ (u : I → E) (a : Real), 0 ≤ a →
      (∀ i, ‖u i‖ ≤ a) → ∀ j, ‖T u j‖ ≤ B * a)
    (f : I → E) (g : J → Complex)
    (hf : ∑ i, ‖f i‖ ^ 4 ≤ 1)
    (hg : ∑ j, ‖g j‖ ^ (4 / 3 : Real) ≤ 1) :
    ‖∑ j, T f j * g j‖ ≤ A ^ (1 / 2 : Real) * B ^ (1 / 2 : Real) := by
  have hanalytic : ScalarAnalyticFamily 0 1
      (finiteAtomicVectorPairing T f finiteAtomicTwoTopInputExponent g
        finiteAtomicTwoTopTestExponent) :=
    finiteAtomicVectorPairing_analytic T f g differentiable_finiteAtomicTwoTopInputExponent
      differentiable_finiteAtomicTwoTopTestExponent
  have hbounded := finiteAtomicTwoTopVectorPairing_bddAbove T f g
  have hleft : ∀ w ∈ Complex.re ⁻¹' ({(0 : Real)} : Set Real),
      ‖finiteAtomicVectorPairing T f finiteAtomicTwoTopInputExponent g
        finiteAtomicTwoTopTestExponent w‖ ≤ A := by
    intro w hw
    exact finiteAtomicTwoTopVectorPairing_left_bound T A hA hTtwo f g w
      (by simpa using hw) hf hg
  have hright : ∀ w ∈ Complex.re ⁻¹' ({(1 : Real)} : Set Real),
      ‖finiteAtomicVectorPairing T f finiteAtomicTwoTopInputExponent g
        finiteAtomicTwoTopTestExponent w‖ ≤ B := by
    intro w hw
    exact finiteAtomicTwoTopVectorPairing_right_bound T B hB hTtop f g w
      (by simpa using hw) hg
  have hthree := scalarThreeLines_unit (F :=
      finiteAtomicVectorPairing T f finiteAtomicTwoTopInputExponent g
        finiteAtomicTwoTopTestExponent)
      (A0 := A) (A1 := B) (theta := (1 / 2 : Real)) (by norm_num)
      hanalytic hbounded hleft hright
  have hfhalf : finiteAtomicVectorPowerFamily f finiteAtomicTwoTopInputExponent
      ((1 / 2 : Real) : Complex) = f :=
    finiteAtomicVectorPowerFamily_apply_of_exponent_one f finiteAtomicTwoTopInputExponent
      ((1 / 2 : Real) : Complex) finiteAtomicTwoTopInputExponent_half
  have hghalf : finiteAtomicPowerFamily g finiteAtomicTwoTopTestExponent
      ((1 / 2 : Real) : Complex) = g :=
    finiteAtomicPowerFamily_apply_of_exponent_one g finiteAtomicTwoTopTestExponent
      ((1 / 2 : Real) : Complex) finiteAtomicTwoTopTestExponent_half
  unfold finiteAtomicVectorPairing at hthree
  rw [hfhalf, hghalf] at hthree
  convert hthree using 1 <;> norm_num

/-- Direct sharp normalized finite atomic `L²`--`L∞` to `L⁴` estimate with a
vector-valued complex source. -/
theorem finiteAtomicTwoTopFour_vector_normalized {I J E : Type*}
    [Fintype I] [Fintype J] [NormedAddCommGroup E] [NormedSpace Complex E]
    (T : (I → E) →L[Complex] (J → Complex))
    (A B : Real) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hTtwo : ∀ u, Real.sqrt (∑ j, ‖T u j‖ ^ 2) ≤ A *
      Real.sqrt (∑ i, ‖u i‖ ^ 2))
    (hTtop : ∀ (u : I → E) (a : Real), 0 ≤ a →
      (∀ i, ‖u i‖ ≤ a) → ∀ j, ‖T u j‖ ≤ B * a)
    (f : I → E) (hf : ∑ i, ‖f i‖ ^ 4 ≤ 1) :
    (finiteAtomicL4Norm (T f) : Real) ≤
      A ^ (1 / 2 : Real) * B ^ (1 / 2 : Real) := by
  obtain ⟨g, hg, hpair⟩ := finiteAtomic_exists_l4_dualTest (T f)
  have hnorm : ‖∑ j, T f j * g j‖ = (finiteAtomicL4Norm (T f) : Real) := by
    rw [hpair, Complex.norm_real, NNReal.norm_eq]
    rfl
  calc
    (finiteAtomicL4Norm (T f) : Real) = ‖∑ j, T f j * g j‖ := hnorm.symm
    _ ≤ A ^ (1 / 2 : Real) * B ^ (1 / 2 : Real) :=
      finiteAtomicTwoTopVectorPairing_midpoint_bound T A B hA hB hTtwo hTtop f g hf hg

/-- The finite atomic `ℓ⁴` norm for a vector-valued source. -/
def finiteAtomicVectorL4Norm {I E : Type*} [Fintype I] [NormedAddCommGroup E]
    (f : I → E) : NNReal :=
  (∑ i, ‖f i‖₊ ^ (4 : Real)) ^ (1 / 4 : Real)

/-- Scalar multiplication is homogeneous for the vector-valued finite atomic
`ℓ⁴` norm. -/
theorem finiteAtomicVectorL4Norm_smul {I E : Type*}
    [Fintype I] [NormedAddCommGroup E] [NormedSpace Complex E]
    (c : Complex) (f : I → E) :
    finiteAtomicVectorL4Norm (c • f) = ‖c‖₊ * finiteAtomicVectorL4Norm f := by
  unfold finiteAtomicVectorL4Norm
  have hsum : (∑ i, ‖(c • f) i‖₊ ^ (4 : Real)) =
      ‖c‖₊ ^ (4 : Real) * (∑ i, ‖f i‖₊ ^ (4 : Real)) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i hi
    rw [Pi.smul_apply, nnnorm_smul, NNReal.mul_rpow]
  rw [hsum, NNReal.mul_rpow]
  have hc : (‖c‖₊ ^ (4 : Real)) ^ (1 / 4 : Real) = ‖c‖₊ := by
    rw [← NNReal.rpow_mul]
    norm_num
  rw [hc]

/-- The fourth power of the vector-valued finite atomic `ℓ⁴` norm is its
defining moment. -/
theorem finiteAtomicVectorL4Norm_pow_four {I E : Type*}
    [Fintype I] [NormedAddCommGroup E] (f : I → E) :
    (finiteAtomicVectorL4Norm f) ^ (4 : Nat) = ∑ i, ‖f i‖₊ ^ (4 : Real) := by
  unfold finiteAtomicVectorL4Norm
  rw [← NNReal.rpow_natCast, ← NNReal.rpow_mul]
  norm_num

/-- The real vector-valued fourth-power moment agrees with the coercion of
its nonnegative finite counterpart. -/
theorem finiteAtomicVector_sum_norm_four_eq_coe {I E : Type*}
    [Fintype I] [NormedAddCommGroup E] (f : I → E) :
    (∑ i, ‖f i‖ ^ (4 : Nat)) =
      ↑(∑ i, ‖f i‖₊ ^ (4 : Real)) := by
  rw [NNReal.coe_sum]
  apply Finset.sum_congr rfl
  intro i hi
  rw [NNReal.coe_rpow, coe_nnnorm]
  exact (Real.rpow_natCast ‖f i‖ 4).symm

/-- The vector-valued finite atomic `ℓ⁴` norm vanishes exactly at the zero
vector. -/
theorem finiteAtomicVectorL4Norm_eq_zero_iff {I E : Type*}
    [Fintype I] [NormedAddCommGroup E] (f : I → E) :
    finiteAtomicVectorL4Norm f = 0 ↔ f = 0 := by
  constructor
  · intro h
    have hmoment : (∑ i, ‖f i‖₊ ^ (4 : Real)) = 0 := by
      rw [← finiteAtomicVectorL4Norm_pow_four f, h]
      norm_num
    funext i
    have hi : ‖f i‖₊ ^ (4 : Real) = 0 :=
      ((Finset.sum_eq_zero_iff_of_nonneg (by
        intro k hk
        positivity)).mp hmoment)
        i (Finset.mem_univ _)
    exact nnnorm_eq_zero.mp (NNReal.rpow_eq_zero_iff.mp hi).1
  · intro h
    subst f
    simp [finiteAtomicVectorL4Norm]

/-- Direct homogeneous sharp finite atomic `L²`--`L∞` to `L⁴` estimate with
a vector-valued complex source.  The endpoint hypotheses are literal and the
source norm is the unflattened moment `∑ i ‖f i‖⁴`. -/
theorem finiteAtomicTwoTopFour_vector {I J E : Type*}
    [Fintype I] [Fintype J] [NormedAddCommGroup E] [NormedSpace Complex E]
    (T : (I → E) →L[Complex] (J → Complex))
    (A B : Real) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hTtwo : ∀ u, Real.sqrt (∑ j, ‖T u j‖ ^ 2) ≤ A *
      Real.sqrt (∑ i, ‖u i‖ ^ 2))
    (hTtop : ∀ (u : I → E) (a : Real), 0 ≤ a →
      (∀ i, ‖u i‖ ≤ a) → ∀ j, ‖T u j‖ ≤ B * a)
    (f : I → E) :
    (finiteAtomicL4Norm (T f) : Real) ≤
      A ^ (1 / 2 : Real) * B ^ (1 / 2 : Real) *
        (finiteAtomicVectorL4Norm f : Real) := by
  by_cases hr : finiteAtomicVectorL4Norm f = 0
  · have hfzero : f = 0 := (finiteAtomicVectorL4Norm_eq_zero_iff f).mp hr
    subst f
    simp [finiteAtomicL4Norm, finiteAtomicVectorL4Norm]
  · let r : NNReal := finiteAtomicVectorL4Norm f
    let f₀ : I → E := (r : Complex)⁻¹ • f
    have hr0 : r ≠ 0 := by simpa [r] using hr
    have hf₀norm : finiteAtomicVectorL4Norm f₀ = 1 := by
      dsimp [f₀]
      rw [finiteAtomicVectorL4Norm_smul]
      simp [nnnorm_inv, NNReal.nnnorm_eq]
      change r⁻¹ * r = 1
      exact inv_mul_cancel₀ hr0
    have hf₀ : (∑ i, ‖f₀ i‖ ^ (4 : Nat)) ≤ 1 := by
      rw [finiteAtomicVector_sum_norm_four_eq_coe]
      have hpow := congrArg (fun s : NNReal => s ^ (4 : Nat)) hf₀norm
      rw [finiteAtomicVectorL4Norm_pow_four] at hpow
      norm_num at hpow
      exact_mod_cast hpow.le
    have hbound :=
      finiteAtomicTwoTopFour_vector_normalized T A B hA hB hTtwo hTtop f₀ hf₀
    have hmap : T f₀ = (r : Complex)⁻¹ • T f := by
      simp [f₀]
    rw [hmap, finiteAtomicL4Norm_smul] at hbound
    have hrescaled : (r : Real)⁻¹ * (finiteAtomicL4Norm (T f) : Real) ≤
        A ^ (1 / 2 : Real) * B ^ (1 / 2 : Real) := by
      simpa [nnnorm_inv, NNReal.nnnorm_eq, r] using hbound
    have hrpos : 0 < (r : Real) := NNReal.coe_pos.mpr (pos_iff_ne_zero.mpr hr0)
    calc
      (finiteAtomicL4Norm (T f) : Real) =
          (r : Real) * ((r : Real)⁻¹ * (finiteAtomicL4Norm (T f) : Real)) := by
        field_simp
      _ ≤ (r : Real) * (A ^ (1 / 2 : Real) * B ^ (1 / 2 : Real)) :=
        mul_le_mul_of_nonneg_left hrescaled hrpos.le
      _ = A ^ (1 / 2 : Real) * B ^ (1 / 2 : Real) *
          (finiteAtomicVectorL4Norm f : Real) := by
        simp only [r]
        ring

/-! ### Finite-support simple-function powers

The next layer of the sharp argument replaces counting atoms by the finitely
many nonzero fibers of a `SimpleFunc` on an arbitrary measure space.  The
power deformation remains a simple function, which is the key point that
makes its pairing with a linear operator a finite analytic sum. -/

section FiniteSimple

/-- Zero-safe radial complex-power deformation of a vector-valued simple
function. -/
def finiteSimpleVectorPowerFamily {α E : Type*} [MeasurableSpace α]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    (f : SimpleFunc α E) (e : Complex → Complex) : Complex → SimpleFunc α E :=
  fun z ↦ f.map (fun a ↦ finiteAtomicCpow (‖a‖ : Complex) e z •
    ((‖a‖ : Complex)⁻¹ • a))

/-- Pointwise form of the vector-valued simple-function power family. -/
theorem finiteSimpleVectorPowerFamily_apply {α E : Type*} [MeasurableSpace α]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    (f : SimpleFunc α E) (e : Complex → Complex) (z : Complex) (x : α) :
    finiteSimpleVectorPowerFamily f e z x =
      finiteAtomicCpow (‖f x‖ : Complex) e z • ((‖f x‖ : Complex)⁻¹ • f x) := by
  simp [finiteSimpleVectorPowerFamily]

/-- The simple-function radial power deformation recovers the original
simple function at exponent one. -/
theorem finiteSimpleVectorPowerFamily_apply_of_exponent_one {α E : Type*}
    [MeasurableSpace α] [NormedAddCommGroup E] [NormedSpace Complex E]
    (f : SimpleFunc α E) (e : Complex → Complex) (z : Complex)
    (he : e z = 1) : finiteSimpleVectorPowerFamily f e z = f := by
  apply SimpleFunc.ext
  intro x
  rw [finiteSimpleVectorPowerFamily_apply, finiteAtomicCpow, he]
  by_cases hfx : f x = 0
  · simp [hfx]
  · have hn : ‖f x‖ ≠ 0 := norm_ne_zero_iff.mpr hfx
    have hbase : (‖f x‖ : Complex) ≠ 0 := Complex.ofReal_ne_zero.mpr hn
    rw [if_neg hbase, Complex.cpow_one, smul_smul]
    rw [mul_inv_cancel₀ hbase, one_smul]

/-- Pointwise norm control for the vector-valued simple-function power
family. -/
theorem norm_finiteSimpleVectorPowerFamily_le_rpow {α E : Type*}
    [MeasurableSpace α] [NormedAddCommGroup E] [NormedSpace Complex E]
    (f : SimpleFunc α E) (e : Complex → Complex) (z : Complex) (x : α) :
    ‖finiteSimpleVectorPowerFamily f e z x‖ ≤ ‖f x‖ ^ (e z).re := by
  rw [finiteSimpleVectorPowerFamily_apply]
  exact norm_finiteAtomicVectorPowerFamily_le_rpow (fun x ↦ f x) e z x

/-- Exact pointwise norm formula for a simple-function power family away
from exponent real part zero. -/
theorem norm_finiteSimpleVectorPowerFamily_eq_rpow_of_re_pos {α E : Type*}
    [MeasurableSpace α] [NormedAddCommGroup E] [NormedSpace Complex E]
    (f : SimpleFunc α E) (e : Complex → Complex) (z : Complex) (x : α)
    (hre : 0 < (e z).re) :
    ‖finiteSimpleVectorPowerFamily f e z x‖ = ‖f x‖ ^ (e z).re := by
  rw [finiteSimpleVectorPowerFamily_apply]
  exact norm_finiteAtomicVectorPowerFamily_eq_rpow_of_re_pos
    (fun x ↦ f x) e z x hre

/-- Exact `eLpNorm` transformation law for a finite simple-function radial
power.  It is the measure-space analogue of the finite counting-atom moment
identities used at the two strip boundaries. -/
theorem eLpNorm_finiteSimpleVectorPowerFamily_eq_rpow {α E : Type*}
    [MeasurableSpace α] [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} {p : ENNReal}
    (f : SimpleFunc α E) (e : Complex → Complex) (z : Complex)
    (hre : 0 < (e z).re) :
    eLpNorm (finiteSimpleVectorPowerFamily f e z : α → E) p μ =
      eLpNorm (f : α → E) (p * ENNReal.ofReal (e z).re) μ ^ (e z).re := by
  calc
    eLpNorm (finiteSimpleVectorPowerFamily f e z : α → E) p μ =
        eLpNorm (fun x => ‖f x‖ ^ (e z).re) p μ := by
      apply eLpNorm_congr_norm_ae
      filter_upwards with x
      simpa [Real.norm_eq_abs,
        abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)] using
        (norm_finiteSimpleVectorPowerFamily_eq_rpow_of_re_pos f e z x hre)
    _ = _ := eLpNorm_norm_rpow (f : α → E) hre

/-- Endpoint form of the finite-simple radial power identity.  The moment
identity packages exactly the exponent arithmetic used when an interpolated
`Lp` exponent is compared with an endpoint exponent. -/
theorem eLpNorm_finiteSimpleVectorPowerFamily_eq_rpow_of_moment_identity
    {α E : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    [NormedSpace Complex E] {μ : Measure α} {pin pend : ENNReal} {a : Real}
    (f : SimpleFunc α E) (e : Complex → Complex) (z : Complex)
    (hre : (e z).re = a) (ha : 0 < a)
    (hmoment : pend * ENNReal.ofReal a = pin) :
    eLpNorm (finiteSimpleVectorPowerFamily f e z : α → E) pend μ =
      eLpNorm (f : α → E) pin μ ^ a := by
  rw [eLpNorm_finiteSimpleVectorPowerFamily_eq_rpow f e z (hre ▸ ha), hre, hmoment]

/-- A normalized finite-simple function produces a normalized radial power
at any positive finite endpoint satisfying the stated moment identity. -/
theorem eLpNorm_finiteSimpleVectorPowerFamily_le_one_of_moment_identity
    {α E : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    [NormedSpace Complex E] {μ : Measure α} {pin pend : ENNReal} {a : Real}
    (f : SimpleFunc α E) (e : Complex → Complex) (z : Complex)
    (hre : (e z).re = a) (ha : 0 < a)
    (hmoment : pend * ENNReal.ofReal a = pin)
    (hunit : eLpNorm (f : α → E) pin μ ≤ 1) :
    eLpNorm (finiteSimpleVectorPowerFamily f e z : α → E) pend μ ≤ 1 := by
  rw [eLpNorm_finiteSimpleVectorPowerFamily_eq_rpow_of_moment_identity
    f e z hre ha hmoment]
  exact ENNReal.rpow_le_one hunit (by linarith)

/-- The rational exponent conversion appearing in the `L²`--`L∞` to `L⁴`
complex-power argument. -/
theorem finiteSimple_two_mul_ofReal_two_div_three :
    (2 : ENNReal) * ENNReal.ofReal (2 / 3 : Real) = (4 / 3 : ENNReal) := by
  norm_num [ENNReal.ofReal_div_of_pos]
  rw [← mul_div_assoc]
  norm_num

/-- The left-boundary `L²` norm identity for the input deformation. -/
theorem eLpNorm_finiteSimpleTwoTopInput_left {α E : Type*}
    [MeasurableSpace α] [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} (f : SimpleFunc α E) (w : Complex) (hw : w.re = 0) :
    eLpNorm (finiteSimpleVectorPowerFamily f finiteAtomicTwoTopInputExponent w : α → E) 2 μ =
      eLpNorm (f : α → E) 4 μ ^ (2 : Real) := by
  rw [eLpNorm_finiteSimpleVectorPowerFamily_eq_rpow]
  · have hre : (finiteAtomicTwoTopInputExponent w).re = 2 := by
      rw [finiteAtomicTwoTopInputExponent_re, hw]
      norm_num
    rw [hre]
    norm_num
  · rw [finiteAtomicTwoTopInputExponent_re, hw]
    norm_num

/-- The left-boundary `L²` norm identity for the scalar dual-test
deformation. -/
theorem eLpNorm_finiteSimpleTwoTopTest_left {α : Type*} [MeasurableSpace α]
    {μ : Measure α} (g : SimpleFunc α Complex) (w : Complex) (hw : w.re = 0) :
    eLpNorm (finiteSimpleVectorPowerFamily g finiteAtomicTwoTopTestExponent w : α → Complex) 2 μ =
      eLpNorm (g : α → Complex) (4 / 3 : ENNReal) μ ^ (2 / 3 : Real) := by
  rw [eLpNorm_finiteSimpleVectorPowerFamily_eq_rpow]
  · have hre : (finiteAtomicTwoTopTestExponent w).re = (2 / 3 : Real) := by
      rw [finiteAtomicTwoTopTestExponent_re, hw]
      norm_num
    rw [hre, finiteSimple_two_mul_ofReal_two_div_three]
  · rw [finiteAtomicTwoTopTestExponent_re, hw]
    norm_num

/-- The right-boundary `L¹` norm identity for the scalar dual-test
deformation. -/
theorem eLpNorm_finiteSimpleTwoTopTest_right {α : Type*} [MeasurableSpace α]
    {μ : Measure α} (g : SimpleFunc α Complex) (w : Complex) (hw : w.re = 1) :
    eLpNorm (finiteSimpleVectorPowerFamily g finiteAtomicTwoTopTestExponent w : α → Complex) 1 μ =
      eLpNorm (g : α → Complex) (4 / 3 : ENNReal) μ ^ (4 / 3 : Real) := by
  rw [eLpNorm_finiteSimpleVectorPowerFamily_eq_rpow]
  · have hre : (finiteAtomicTwoTopTestExponent w).re = (4 / 3 : Real) := by
      rw [finiteAtomicTwoTopTestExponent_re, hw]
      norm_num
    rw [hre]
    norm_num [ENNReal.ofReal_div_of_pos]
  · rw [finiteAtomicTwoTopTestExponent_re, hw]
    norm_num

/-- At the right boundary the input deformation is pointwise bounded by one,
and hence has `L∞` norm at most one on every measure space. -/
theorem eLpNorm_finiteSimpleTwoTopInput_right_le_one {α E : Type*}
    [MeasurableSpace α] [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} (f : SimpleFunc α E) (w : Complex) (hw : w.re = 1) :
    eLpNorm (finiteSimpleVectorPowerFamily f finiteAtomicTwoTopInputExponent w : α → E) ⊤ μ ≤ 1 := by
  rw [eLpNorm_exponent_top]
  have h := eLpNormEssSup_le_of_ae_bound (μ := μ)
    (f := (finiteSimpleVectorPowerFamily f finiteAtomicTwoTopInputExponent w : α → E))
    (C := 1) (Filter.Eventually.of_forall fun x => by
      calc
        ‖finiteSimpleVectorPowerFamily f finiteAtomicTwoTopInputExponent w x‖ ≤
            ‖f x‖ ^ (finiteAtomicTwoTopInputExponent w).re :=
          norm_finiteSimpleVectorPowerFamily_le_rpow f _ _ _
        _ = 1 := by rw [finiteAtomicTwoTopInputExponent_re, hw]; simp)
  norm_num at h ⊢
  exact h

/-- The left-boundary input deformation is in `L²` whenever the original
simple vector function is in `L⁴`. -/
theorem finiteSimpleTwoTopInput_left_memLp {α E : Type*}
    [MeasurableSpace α] [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} (f : SimpleFunc α E) (hf : MemLp (f : α → E) 4 μ)
    (w : Complex) (hw : w.re = 0) :
    MemLp (finiteSimpleVectorPowerFamily f finiteAtomicTwoTopInputExponent w : α → E) 2 μ := by
  constructor
  · exact (finiteSimpleVectorPowerFamily f finiteAtomicTwoTopInputExponent w).aestronglyMeasurable
  · rw [eLpNorm_finiteSimpleTwoTopInput_left f w hw]
    exact ENNReal.rpow_lt_top_of_nonneg (by norm_num) hf.eLpNorm_ne_top

/-- The left-boundary dual-test deformation is in `L²` whenever the original
scalar simple test belongs to `L^(4/3)`. -/
theorem finiteSimpleTwoTopTest_left_memLp {α : Type*} [MeasurableSpace α]
    {μ : Measure α} (g : SimpleFunc α Complex)
    (hg : MemLp (g : α → Complex) (4 / 3 : ENNReal) μ)
    (w : Complex) (hw : w.re = 0) :
    MemLp (finiteSimpleVectorPowerFamily g finiteAtomicTwoTopTestExponent w : α → Complex) 2 μ := by
  constructor
  · exact (finiteSimpleVectorPowerFamily g finiteAtomicTwoTopTestExponent w).aestronglyMeasurable
  · rw [eLpNorm_finiteSimpleTwoTopTest_left g w hw]
    exact ENNReal.rpow_lt_top_of_nonneg (by norm_num) hg.eLpNorm_ne_top

/-- The right-boundary dual-test deformation is integrable whenever the
original scalar simple test belongs to `L^(4/3)`. -/
theorem finiteSimpleTwoTopTest_right_memLp {α : Type*} [MeasurableSpace α]
    {μ : Measure α} (g : SimpleFunc α Complex)
    (hg : MemLp (g : α → Complex) (4 / 3 : ENNReal) μ)
    (w : Complex) (hw : w.re = 1) :
    MemLp (finiteSimpleVectorPowerFamily g finiteAtomicTwoTopTestExponent w : α → Complex) 1 μ := by
  constructor
  · exact (finiteSimpleVectorPowerFamily g finiteAtomicTwoTopTestExponent w).aestronglyMeasurable
  · rw [eLpNorm_finiteSimpleTwoTopTest_right g w hw]
    exact ENNReal.rpow_lt_top_of_nonneg (by norm_num) hg.eLpNorm_ne_top

/-- The right-boundary input deformation belongs to `L∞`, independently of
the original input norm. -/
theorem finiteSimpleTwoTopInput_right_memLp {α E : Type*}
    [MeasurableSpace α] [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} (f : SimpleFunc α E) (w : Complex) (hw : w.re = 1) :
    MemLp (finiteSimpleVectorPowerFamily f finiteAtomicTwoTopInputExponent w : α → E) ⊤ μ := by
  apply memLp_top_of_bound
    (finiteSimpleVectorPowerFamily f finiteAtomicTwoTopInputExponent w).aestronglyMeasurable 1
  filter_upwards with x
  calc
    ‖finiteSimpleVectorPowerFamily f finiteAtomicTwoTopInputExponent w x‖ ≤
        ‖f x‖ ^ (finiteAtomicTwoTopInputExponent w).re :=
      norm_finiteSimpleVectorPowerFamily_le_rpow f _ _ _
    _ = 1 := by rw [finiteAtomicTwoTopInputExponent_re, hw]; simp

/-- Finite-measure support is preserved by the zero-safe simple-function
power deformation. -/
theorem finiteSimpleVectorPowerFamily_finMeasSupp {α E : Type*}
    [MeasurableSpace α] [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} (f : SimpleFunc α E) (hf : f.FinMeasSupp μ)
    (e : Complex → Complex) (z : Complex) :
    (finiteSimpleVectorPowerFamily f e z).FinMeasSupp μ := by
  unfold finiteSimpleVectorPowerFamily
  apply hf.map
  simp [finiteAtomicCpow]

/-- A finite-`Lp` simple function stays in the same `Lp` space under any
zero-safe radial complex-power deformation.  This is membership only; the
precise boundary norm identities are proved separately. -/
theorem finiteSimpleVectorPowerFamily_memLp_of_memLp {α E : Type*}
    [MeasurableSpace α] [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} {p : ENNReal} (hp0 : p ≠ 0) (hpTop : p ≠ ⊤)
    (f : SimpleFunc α E) (hf : MemLp (f : α → E) p μ)
    (e : Complex → Complex) (z : Complex) :
    MemLp (finiteSimpleVectorPowerFamily f e z : α → E) p μ := by
  apply (SimpleFunc.memLp_iff_finMeasSupp hp0 hpTop).mpr
  apply finiteSimpleVectorPowerFamily_finMeasSupp f
  exact (SimpleFunc.memLp_iff_finMeasSupp hp0 hpTop).mp hf

/-- If the real part of a radial exponent vanishes, the resulting simple
power is pointwise bounded by one and hence has `L∞` norm at most one. -/
theorem eLpNorm_finiteSimpleVectorPowerFamily_top_le_one_of_re_zero {α E : Type*}
    [MeasurableSpace α] [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} (f : SimpleFunc α E) (e : Complex → Complex) (z : Complex)
    (hre : (e z).re = 0) :
    eLpNorm (finiteSimpleVectorPowerFamily f e z : α → E) ⊤ μ ≤ 1 := by
  rw [eLpNorm_exponent_top]
  have h := eLpNormEssSup_le_of_ae_bound (μ := μ)
    (f := (finiteSimpleVectorPowerFamily f e z : α → E)) (C := 1)
    (Filter.Eventually.of_forall fun x => by
      calc
        ‖finiteSimpleVectorPowerFamily f e z x‖ ≤ ‖f x‖ ^ (e z).re :=
          norm_finiteSimpleVectorPowerFamily_le_rpow f e z x
        _ = 1 := by rw [hre]; simp)
  norm_num at h ⊢
  exact h

/-- The zero-real-part radial power belongs to `L∞` on every measure space. -/
theorem finiteSimpleVectorPowerFamily_memLp_top_of_re_zero {α E : Type*}
    [MeasurableSpace α] [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} (f : SimpleFunc α E) (e : Complex → Complex) (z : Complex)
    (hre : (e z).re = 0) :
    MemLp (finiteSimpleVectorPowerFamily f e z : α → E) ⊤ μ := by
  apply memLp_top_of_bound (finiteSimpleVectorPowerFamily f e z).aestronglyMeasurable 1
  filter_upwards with x
  calc
    ‖finiteSimpleVectorPowerFamily f e z x‖ ≤ ‖f x‖ ^ (e z).re :=
      norm_finiteSimpleVectorPowerFamily_le_rpow f e z x
    _ = 1 := by rw [hre]; simp

/-- Exact finite-simple norm transformation on the left boundary of a
general affine exponent, provided its real part is positive. -/
theorem eLpNorm_finiteSimpleVectorPowerFamily_affineExponent_left
    {α E : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    [NormedSpace Complex E] {μ : Measure α} {q : ENNReal}
    (f : SimpleFunc α E) (scale c0 c1 : Real) (w : Complex) (hw : w.re = 0)
    (hpos : 0 < scale * c0) :
    eLpNorm (finiteSimpleVectorPowerFamily f (affineExponent scale c0 c1) w : α → E) q μ =
      eLpNorm (f : α → E) (q * ENNReal.ofReal (scale * c0)) μ ^ (scale * c0) := by
  have hre : 0 < (affineExponent scale c0 c1 w).re := by
    rw [affineExponent_left_re scale c0 c1 w hw]
    exact hpos
  rw [eLpNorm_finiteSimpleVectorPowerFamily_eq_rpow f
    (affineExponent scale c0 c1) w hre,
    affineExponent_left_re scale c0 c1 w hw]

/-- Exact finite-simple norm transformation on the right boundary of a
general affine exponent, provided its real part is positive. -/
theorem eLpNorm_finiteSimpleVectorPowerFamily_affineExponent_right
    {α E : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    [NormedSpace Complex E] {μ : Measure α} {q : ENNReal}
    (f : SimpleFunc α E) (scale c0 c1 : Real) (w : Complex) (hw : w.re = 1)
    (hpos : 0 < scale * c1) :
    eLpNorm (finiteSimpleVectorPowerFamily f (affineExponent scale c0 c1) w : α → E) q μ =
      eLpNorm (f : α → E) (q * ENNReal.ofReal (scale * c1)) μ ^ (scale * c1) := by
  have hre : 0 < (affineExponent scale c0 c1 w).re := by
    rw [affineExponent_right_re scale c0 c1 w hw]
    exact hpos
  rw [eLpNorm_finiteSimpleVectorPowerFamily_eq_rpow f
    (affineExponent scale c0 c1) w hre,
    affineExponent_right_re scale c0 c1 w hw]

/-- The finite index set of nonzero fibers of a simple function.  Excluding
the zero fiber is essential on an infinite-measure space. -/
noncomputable def finiteSimpleNonzeroRange {α E : Type*} [MeasurableSpace α]
    [Zero E] (f : SimpleFunc α E) : Finset E := by
  classical
  exact f.range.filter (fun v ↦ v ≠ 0)

/-- A normalized simple-function atom supported on one value fiber. -/
def finiteSimpleVectorAtom {α E : Type*} [MeasurableSpace α]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    (f : SimpleFunc α E) (v : E) : SimpleFunc α E :=
  (SimpleFunc.const α ((‖v‖ : Complex)⁻¹ • v)).restrict (f ⁻¹' {v})

/-- Pointwise spelling of a normalized simple-function atom. -/
theorem finiteSimpleVectorAtom_apply {α E : Type*} [MeasurableSpace α]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    (f : SimpleFunc α E) (v : E) (x : α) :
    finiteSimpleVectorAtom f v x =
      (f ⁻¹' {v}).indicator (fun _ : α ↦ ((‖v‖ : Complex)⁻¹ • v)) x := by
  unfold finiteSimpleVectorAtom
  rw [SimpleFunc.coe_restrict _ (f.measurableSet_fiber v)]
  rfl

/-- Evaluation commutes with a finite simple-function linear combination. -/
theorem finiteSimple_sum_smul_atom_apply {α E : Type*} [MeasurableSpace α]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    (s : Finset E) (c : E → Complex) (a : E → SimpleFunc α E) (x : α) :
    (∑ v ∈ s, c v • a v) x = ∑ v ∈ s, c v • (a v) x := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert v s hv ih =>
      rw [Finset.sum_insert hv, Finset.sum_insert hv]
      rw [SimpleFunc.coe_add]
      change (c v • a v) x + (∑ y ∈ s, c y • a y) x =
        c v • (a v) x + ∑ y ∈ s, c y • (a y) x
      rw [SimpleFunc.coe_smul]
      simp only [Pi.smul_apply]
      rw [ih]

/-- The vector-valued simple-function complex power is the finite sum of its
nonzero-fiber atoms.  This makes subsequent pairings finite sums rather than
parameter-dependent integrals. -/
theorem finiteSimpleVectorPowerFamily_eq_sum_atoms {α E : Type*}
    [MeasurableSpace α] [NormedAddCommGroup E] [NormedSpace Complex E]
    (f : SimpleFunc α E) (e : Complex → Complex) (z : Complex) :
    finiteSimpleVectorPowerFamily f e z =
      ∑ v ∈ finiteSimpleNonzeroRange f,
        finiteAtomicCpow (‖v‖ : Complex) e z • finiteSimpleVectorAtom f v := by
  classical
  apply SimpleFunc.ext
  intro x
  rw [finiteSimpleVectorPowerFamily_apply]
  rw [finiteSimple_sum_smul_atom_apply]
  by_cases hx : f x = 0
  · rw [hx]
    simp [finiteAtomicCpow]
    symm
    apply Finset.sum_eq_zero
    intro v hv
    have hv' : v ∈ f.range.filter (fun v ↦ v ≠ 0) := by
      simpa [finiteSimpleNonzeroRange] using hv
    have hv0 : v ≠ 0 := (Finset.mem_filter.mp hv').2
    have hnot : x ∉ f ⁻¹' {v} := by
      rintro hmem
      have h0v : (0 : E) = v := by simpa [Set.mem_preimage, hx] using hmem
      exact hv0 h0v.symm
    simp [finiteSimpleVectorAtom, SimpleFunc.coe_restrict,
      f.measurableSet_fiber v, hnot, hv0]
  · let v := f x
    have hv : v ∈ finiteSimpleNonzeroRange f := by
      simp [finiteSimpleNonzeroRange, v, hx, f.mem_range_self x]
    rw [Finset.sum_eq_single_of_mem v hv]
    · simp [finiteSimpleVectorAtom, SimpleFunc.coe_restrict,
        f.measurableSet_fiber v, v]
    · intro w hw hwv
      have hnot : x ∉ f ⁻¹' {w} := by
        rintro hmem
        have hxw : f x = w := by simpa [Set.mem_preimage] using hmem
        apply hwv
        calc
          w = f x := hxw.symm
          _ = v := rfl
      simp [finiteSimpleVectorAtom, SimpleFunc.coe_restrict,
        f.measurableSet_fiber w, hnot]

/-- A nonzero-fiber atom of a finite-`Lp` simple function belongs to the same
`Lp` space.  The nonzero-fiber restriction supplies the necessary finite
measure support on an arbitrary measure space. -/
theorem finiteSimpleVectorAtom_memLp_of_memLp {α E : Type*}
    [MeasurableSpace α] [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} {p : ENNReal} (hp0 : p ≠ 0) (hpTop : p ≠ ⊤)
    (f : SimpleFunc α E) (hf : MemLp (f : α → E) p μ)
    (v : E) (hv : v ∈ finiteSimpleNonzeroRange f) :
    MemLp (finiteSimpleVectorAtom f v : α → E) p μ := by
  classical
  have hv' : v ∈ f.range.filter (fun v ↦ v ≠ 0) := by
    simpa [finiteSimpleNonzeroRange] using hv
  have hv0 : v ≠ 0 := (Finset.mem_filter.mp hv').2
  have hmeasure : μ (f ⁻¹' {v}) < ⊤ :=
    SimpleFunc.measure_preimage_lt_top_of_memLp hp0 hpTop f hf v hv0
  have hatom := memLp_indicator_const p (f.measurableSet_fiber v)
    ((‖v‖ : Complex)⁻¹ • v) (Or.inr (ne_of_lt hmeasure))
  convert hatom using 1
  ext x
  rw [finiteSimpleVectorAtom_apply]

/-- Once a nonzero fiber of a simple function has finite measure, its
normalized atom belongs to every `Lp` space.  The source exponent and the
target exponent are deliberately independent. -/
theorem finiteSimpleVectorAtom_memLp_of_memLp_any_exponent {α E : Type*}
    [MeasurableSpace α] [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} {p q : ENNReal}
    (hp0 : p ≠ 0) (hpTop : p ≠ ⊤)
    (f : SimpleFunc α E) (hf : MemLp (f : α → E) p μ)
    (v : E) (hv : v ∈ finiteSimpleNonzeroRange f) :
    MemLp (finiteSimpleVectorAtom f v : α → E) q μ := by
  classical
  have hv' : v ∈ f.range.filter (fun v ↦ v ≠ 0) := by
    simpa [finiteSimpleNonzeroRange] using hv
  have hv0 : v ≠ 0 := (Finset.mem_filter.mp hv').2
  have hmeasure : μ (f ⁻¹' {v}) < ⊤ :=
    SimpleFunc.measure_preimage_lt_top_of_memLp hp0 hpTop f hf v hv0
  have hatom := memLp_indicator_const q (f.measurableSet_fiber v)
    ((‖v‖ : Complex)⁻¹ • v) (Or.inr (ne_of_lt hmeasure))
  convert hatom using 1
  ext x
  rw [finiteSimpleVectorAtom_apply]

/-- Differentiability of a scalar finite sum, in a form convenient for the
finite-fiber analytic pairings below. -/
theorem finiteSimple_differentiable_finset_sum {ι : Type*}
    (s : Finset ι) (F : ι → Complex → Complex)
    (hF : ∀ i ∈ s, Differentiable Complex (F i)) :
    Differentiable Complex (fun z ↦ ∑ i ∈ s, F i z) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using (differentiable_const (c := (0 : Complex)))
  | insert i s hi ih =>
      simp_rw [Finset.sum_insert hi]
      exact (hF i (Finset.mem_insert_self _ _)).add
        (ih (fun j hj ↦ hF j (Finset.mem_insert_of_mem hj)))

/-- The explicit finite-fiber analytic pairing for a vector-valued simple
source and a scalar simple output test.  It is a finite double sum, so no
interchange of a complex derivative and an integral is assumed. -/
def finiteSimpleVectorPairing {α β E : Type*}
    [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex)) (ν : Measure β)
    (f : SimpleFunc α E) (a : Complex → Complex)
    (g : SimpleFunc β Complex) (b : Complex → Complex) : Complex → Complex :=
  fun z ↦ ∑ v ∈ finiteSimpleNonzeroRange f, ∑ w ∈ finiteSimpleNonzeroRange g,
    (finiteAtomicCpow (‖v‖ : Complex) a z *
      finiteAtomicCpow (‖w‖ : Complex) b z) *
      (((‖w‖ : Complex)⁻¹ * w) *
        ∫ y in g ⁻¹' {w}, T (finiteSimpleVectorAtom f v) y ∂ν)

/-- The finite-fiber simple pairing is holomorphic whenever the two exponent
functions are holomorphic. -/
theorem differentiable_finiteSimpleVectorPairing {α β E : Type*}
    [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex)) (ν : Measure β)
    (f : SimpleFunc α E) {a : Complex → Complex}
    (g : SimpleFunc β Complex) {b : Complex → Complex}
    (ha : Differentiable Complex a) (hb : Differentiable Complex b) :
    Differentiable Complex (finiteSimpleVectorPairing T ν f a g b) := by
  unfold finiteSimpleVectorPairing
  apply finiteSimple_differentiable_finset_sum
  intro v hv
  apply finiteSimple_differentiable_finset_sum
  intro w hw
  exact ((differentiable_finiteAtomicCpow (‖v‖ : Complex) ha).mul
    (differentiable_finiteAtomicCpow (‖w‖ : Complex) hb)).mul_const _

/-- The finite-fiber simple pairing is a scalar analytic family on the unit
strip. -/
theorem finiteSimpleVectorPairing_analytic {α β E : Type*}
    [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex)) (ν : Measure β)
    (f : SimpleFunc α E) {a : Complex → Complex}
    (g : SimpleFunc β Complex) {b : Complex → Complex}
    (ha : Differentiable Complex a) (hb : Differentiable Complex b) :
    ScalarAnalyticFamily 0 1 (finiteSimpleVectorPairing T ν f a g b) :=
  (differentiable_finiteSimpleVectorPairing T ν f g ha hb).diffContOnCl

/-- A coarse strip bound for a zero-safe complex power whose base is a
nonnegative real embedded in `Complex`.  This is the scalar ingredient for
boundedness of the finite-fiber pairing on the closed strip. -/
theorem norm_finiteAtomicCpow_ofReal_le_square_max
    (r : Real) (hr : 0 ≤ r) (e : Complex → Complex) (z : Complex)
    (hre0 : 0 ≤ (e z).re) (hre2 : (e z).re ≤ 2) :
    ‖finiteAtomicCpow (r : Complex) e z‖ ≤ (max 1 r) ^ 2 := by
  by_cases hzero : r = 0
  · simp [finiteAtomicCpow, hzero]
  · have hpos : 0 < r := lt_of_le_of_ne hr (Ne.symm hzero)
    have hbase : (r : Complex) ≠ 0 := Complex.ofReal_ne_zero.mpr hzero
    rw [finiteAtomicCpow, if_neg hbase,
      Complex.norm_cpow_eq_rpow_re_of_pos hpos]
    calc
      r ^ (e z).re ≤ (max 1 r) ^ (e z).re :=
        Real.rpow_le_rpow hr (le_max_right _ _) hre0
      _ ≤ (max 1 r) ^ (2 : Real) :=
        Real.rpow_le_rpow_of_exponent_le (le_max_left _ _) hre2
      _ = (max 1 r) ^ 2 := Real.rpow_natCast _ 2

/-- A zero-safe complex power with nonnegative real exponent bounded by an
arbitrary real number is controlled by the corresponding power of
`max 1 r`.  This is the strip-boundedness estimate needed for general
Riesz--Thorin affine exponent families. -/
theorem norm_finiteAtomicCpow_ofReal_le_rpow_max
    (r : Real) (hr : 0 ≤ r) (e : Complex → Complex) (z : Complex) (M : Real)
    (hre0 : 0 ≤ (e z).re) (hreM : (e z).re ≤ M) :
    ‖finiteAtomicCpow (r : Complex) e z‖ ≤ (max 1 r) ^ M := by
  by_cases hzero : r = 0
  · simp [finiteAtomicCpow, hzero]
  · have hpos : 0 < r := lt_of_le_of_ne hr (Ne.symm hzero)
    have hbase : (r : Complex) ≠ 0 := Complex.ofReal_ne_zero.mpr hzero
    rw [finiteAtomicCpow, if_neg hbase,
      Complex.norm_cpow_eq_rpow_re_of_pos hpos]
    calc
      r ^ (e z).re ≤ (max 1 r) ^ (e z).re :=
        Real.rpow_le_rpow hr (le_max_right _ _) hre0
      _ ≤ (max 1 r) ^ M :=
        Real.rpow_le_rpow_of_exponent_le (le_max_left _ _) hreM

/-- The finite-fiber analytic pairing is bounded on the full closed unit
strip.  The displayed bound is deliberately coarse: it only uses finiteness
of the two value ranges and fixed atom-integral coefficients. -/
theorem finiteSimpleVectorPairing_bddAbove {α β E : Type*}
    [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex)) (ν : Measure β)
    (f : SimpleFunc α E) (g : SimpleFunc β Complex) :
    BddAbove ((fun z ↦ ‖finiteSimpleVectorPairing T ν f finiteAtomicTwoTopInputExponent g
      finiteAtomicTwoTopTestExponent z‖) '' verticalClosedStrip 0 1) := by
  rw [bddAbove_def]
  refine ⟨∑ v ∈ finiteSimpleNonzeroRange f, ∑ w ∈ finiteSimpleNonzeroRange g,
    (max 1 ‖v‖) ^ 2 * (max 1 ‖w‖) ^ 2 *
      ‖((‖w‖ : Complex)⁻¹ * w) *
        ∫ y in g ⁻¹' {w}, T (finiteSimpleVectorAtom f v) y ∂ν‖, ?_⟩
  intro y hy
  rcases hy with ⟨z, hz, rfl⟩
  have hz0 : 0 ≤ z.re := hz.1
  have hz1 : z.re ≤ 1 := hz.2
  have hinre0 : 0 ≤ (finiteAtomicTwoTopInputExponent z).re := by
    rw [finiteAtomicTwoTopInputExponent_re]
    nlinarith
  have hinre2 : (finiteAtomicTwoTopInputExponent z).re ≤ 2 := by
    rw [finiteAtomicTwoTopInputExponent_re]
    nlinarith
  have htestre0 : 0 ≤ (finiteAtomicTwoTopTestExponent z).re := by
    rw [finiteAtomicTwoTopTestExponent_re]
    nlinarith
  have htestre2 : (finiteAtomicTwoTopTestExponent z).re ≤ 2 := by
    rw [finiteAtomicTwoTopTestExponent_re]
    nlinarith
  unfold finiteSimpleVectorPairing
  calc
    ‖∑ v ∈ finiteSimpleNonzeroRange f, ∑ w ∈ finiteSimpleNonzeroRange g,
        (finiteAtomicCpow (‖v‖ : Complex) finiteAtomicTwoTopInputExponent z *
          finiteAtomicCpow (‖w‖ : Complex) finiteAtomicTwoTopTestExponent z) *
          (((‖w‖ : Complex)⁻¹ * w) *
            ∫ y in g ⁻¹' {w}, T (finiteSimpleVectorAtom f v) y ∂ν)‖ ≤
        ∑ v ∈ finiteSimpleNonzeroRange f, ∑ w ∈ finiteSimpleNonzeroRange g,
          ‖(finiteAtomicCpow (‖v‖ : Complex) finiteAtomicTwoTopInputExponent z *
            finiteAtomicCpow (‖w‖ : Complex) finiteAtomicTwoTopTestExponent z) *
            (((‖w‖ : Complex)⁻¹ * w) *
              ∫ y in g ⁻¹' {w}, T (finiteSimpleVectorAtom f v) y ∂ν)‖ := by
      calc
        _ ≤ ∑ v ∈ finiteSimpleNonzeroRange f,
            ‖∑ w ∈ finiteSimpleNonzeroRange g,
              (finiteAtomicCpow (‖v‖ : Complex) finiteAtomicTwoTopInputExponent z *
                finiteAtomicCpow (‖w‖ : Complex) finiteAtomicTwoTopTestExponent z) *
                (((‖w‖ : Complex)⁻¹ * w) *
                  ∫ y in g ⁻¹' {w}, T (finiteSimpleVectorAtom f v) y ∂ν)‖ := norm_sum_le _ _
        _ ≤ _ := by
          apply Finset.sum_le_sum
          intro v hv
          exact norm_sum_le _ _
    _ ≤ ∑ v ∈ finiteSimpleNonzeroRange f, ∑ w ∈ finiteSimpleNonzeroRange g,
      (max 1 ‖v‖) ^ 2 * (max 1 ‖w‖) ^ 2 *
        ‖((‖w‖ : Complex)⁻¹ * w) *
          ∫ y in g ⁻¹' {w}, T (finiteSimpleVectorAtom f v) y ∂ν‖ := by
      apply Finset.sum_le_sum
      intro v hv
      apply Finset.sum_le_sum
      intro w hw
      have hvpow := norm_finiteAtomicCpow_ofReal_le_square_max ‖v‖ (norm_nonneg _)
        finiteAtomicTwoTopInputExponent z hinre0 hinre2
      have hwpow := norm_finiteAtomicCpow_ofReal_le_square_max ‖w‖ (norm_nonneg _)
        finiteAtomicTwoTopTestExponent z htestre0 htestre2
      calc
        ‖(finiteAtomicCpow (‖v‖ : Complex) finiteAtomicTwoTopInputExponent z *
          finiteAtomicCpow (‖w‖ : Complex) finiteAtomicTwoTopTestExponent z) *
          (((‖w‖ : Complex)⁻¹ * w) *
            ∫ y in g ⁻¹' {w}, T (finiteSimpleVectorAtom f v) y ∂ν)‖ =
            ‖finiteAtomicCpow (‖v‖ : Complex) finiteAtomicTwoTopInputExponent z‖ *
              ‖finiteAtomicCpow (‖w‖ : Complex) finiteAtomicTwoTopTestExponent z‖ *
                ‖((‖w‖ : Complex)⁻¹ * w) *
                  ∫ y in g ⁻¹' {w}, T (finiteSimpleVectorAtom f v) y ∂ν‖ := by
            rw [norm_mul, norm_mul]
        _ ≤ (max 1 ‖v‖) ^ 2 * (max 1 ‖w‖) ^ 2 *
                ‖((‖w‖ : Complex)⁻¹ * w) *
                  ∫ y in g ⁻¹' {w}, T (finiteSimpleVectorAtom f v) y ∂ν‖ := by
            apply mul_le_mul
            · exact mul_le_mul hvpow hwpow (norm_nonneg _) (by positivity)
            · exact le_rfl
            · exact norm_nonneg _
            · exact mul_nonneg (by positivity) (by positivity)

/-- A finite-fiber analytic pairing is bounded on the closed unit strip as
soon as the real parts of both explicit complex-power exponents are bounded
there.  No analytic boundedness datum is assumed: the proof is the finite
sum estimate supplied by the simple-function fibers. -/
theorem finiteSimpleVectorPairing_bddAbove_of_re_bounds {α β E : Type*}
    [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex)) (ν : Measure β)
    (f : SimpleFunc α E) (a : Complex → Complex)
    (g : SimpleFunc β Complex) (b : Complex → Complex) (Ma Mb : Real)
    (ha0 : ∀ z ∈ verticalClosedStrip 0 1, 0 ≤ (a z).re)
    (haM : ∀ z ∈ verticalClosedStrip 0 1, (a z).re ≤ Ma)
    (hb0 : ∀ z ∈ verticalClosedStrip 0 1, 0 ≤ (b z).re)
    (hbM : ∀ z ∈ verticalClosedStrip 0 1, (b z).re ≤ Mb) :
    BddAbove ((fun z ↦ ‖finiteSimpleVectorPairing T ν f a g b z‖) ''
      verticalClosedStrip 0 1) := by
  rw [bddAbove_def]
  refine ⟨∑ v ∈ finiteSimpleNonzeroRange f, ∑ w ∈ finiteSimpleNonzeroRange g,
    (max 1 ‖v‖) ^ Ma * (max 1 ‖w‖) ^ Mb *
      ‖((‖w‖ : Complex)⁻¹ * w) *
        ∫ y in g ⁻¹' {w}, T (finiteSimpleVectorAtom f v) y ∂ν‖, ?_⟩
  intro y hy
  rcases hy with ⟨z, hz, rfl⟩
  unfold finiteSimpleVectorPairing
  calc
    ‖∑ v ∈ finiteSimpleNonzeroRange f, ∑ w ∈ finiteSimpleNonzeroRange g,
        (finiteAtomicCpow (‖v‖ : Complex) a z *
          finiteAtomicCpow (‖w‖ : Complex) b z) *
          (((‖w‖ : Complex)⁻¹ * w) *
            ∫ y in g ⁻¹' {w}, T (finiteSimpleVectorAtom f v) y ∂ν)‖ ≤
        ∑ v ∈ finiteSimpleNonzeroRange f, ∑ w ∈ finiteSimpleNonzeroRange g,
          ‖(finiteAtomicCpow (‖v‖ : Complex) a z *
            finiteAtomicCpow (‖w‖ : Complex) b z) *
            (((‖w‖ : Complex)⁻¹ * w) *
              ∫ y in g ⁻¹' {w}, T (finiteSimpleVectorAtom f v) y ∂ν)‖ := by
      calc
        _ ≤ ∑ v ∈ finiteSimpleNonzeroRange f,
            ‖∑ w ∈ finiteSimpleNonzeroRange g,
              (finiteAtomicCpow (‖v‖ : Complex) a z *
                finiteAtomicCpow (‖w‖ : Complex) b z) *
                (((‖w‖ : Complex)⁻¹ * w) *
                  ∫ y in g ⁻¹' {w}, T (finiteSimpleVectorAtom f v) y ∂ν)‖ := norm_sum_le _ _
        _ ≤ _ := by
          apply Finset.sum_le_sum
          intro v hv
          exact norm_sum_le _ _
    _ ≤ ∑ v ∈ finiteSimpleNonzeroRange f, ∑ w ∈ finiteSimpleNonzeroRange g,
      (max 1 ‖v‖) ^ Ma * (max 1 ‖w‖) ^ Mb *
        ‖((‖w‖ : Complex)⁻¹ * w) *
          ∫ y in g ⁻¹' {w}, T (finiteSimpleVectorAtom f v) y ∂ν‖ := by
      apply Finset.sum_le_sum
      intro v hv
      apply Finset.sum_le_sum
      intro w hw
      have hvpow := norm_finiteAtomicCpow_ofReal_le_rpow_max ‖v‖ (norm_nonneg _)
        a z Ma (ha0 z hz) (haM z hz)
      have hwpow := norm_finiteAtomicCpow_ofReal_le_rpow_max ‖w‖ (norm_nonneg _)
        b z Mb (hb0 z hz) (hbM z hz)
      calc
        ‖(finiteAtomicCpow (‖v‖ : Complex) a z *
          finiteAtomicCpow (‖w‖ : Complex) b z) *
          (((‖w‖ : Complex)⁻¹ * w) *
            ∫ y in g ⁻¹' {w}, T (finiteSimpleVectorAtom f v) y ∂ν)‖ =
            ‖finiteAtomicCpow (‖v‖ : Complex) a z‖ *
              ‖finiteAtomicCpow (‖w‖ : Complex) b z‖ *
                ‖((‖w‖ : Complex)⁻¹ * w) *
                  ∫ y in g ⁻¹' {w}, T (finiteSimpleVectorAtom f v) y ∂ν‖ := by
            rw [norm_mul, norm_mul]
        _ ≤ (max 1 ‖v‖) ^ Ma * (max 1 ‖w‖) ^ Mb *
                ‖((‖w‖ : Complex)⁻¹ * w) *
                  ∫ y in g ⁻¹' {w}, T (finiteSimpleVectorAtom f v) y ∂ν‖ := by
            apply mul_le_mul
            · exact mul_le_mul hvpow hwpow (norm_nonneg _) (by positivity)
            · exact le_rfl
            · exact norm_nonneg _
            · exact mul_nonneg (by positivity) (by positivity)

/-- Strip boundedness for the finite-simple pairing built from the general
Riesz--Thorin reciprocal exponent data. -/
theorem finiteSimpleVectorPairing_rieszThorin_bddAbove {α β E : Type*}
    [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex)) (ν : Measure β)
    (f : SimpleFunc α E) (g : SimpleFunc β Complex)
    {p p' s0 s1 : Real} (hp : 0 ≤ p) (hp' : 0 ≤ p')
    (hs0 : 0 ≤ s0) (hs1 : 0 ≤ s1) (hs0one : s0 ≤ 1) (hs1one : s1 ≤ 1) :
    BddAbove ((fun z ↦ ‖finiteSimpleVectorPairing T ν f
      (rieszThorinInputExponent p s0 s1) g
      (rieszThorinTestExponent p' s0 s1) z‖) '' verticalClosedStrip 0 1) := by
  apply finiteSimpleVectorPairing_bddAbove_of_re_bounds T ν f
    (rieszThorinInputExponent p s0 s1) g (rieszThorinTestExponent p' s0 s1)
    (max (p * s0) (p * s1)) (max (p' * (1 - s0)) (p' * (1 - s1)))
  · intro z hz
    exact rieszThorinInputExponent_re_nonneg_on_verticalClosedStrip hp hs0 hs1 z hz
  · intro z hz
    exact rieszThorinInputExponent_re_le_max_on_verticalClosedStrip z hz
  · intro z hz
    exact rieszThorinTestExponent_re_nonneg_on_verticalClosedStrip hp' hs0one hs1one z hz
  · intro z hz
    exact rieszThorinTestExponent_re_le_max_on_verticalClosedStrip z hz

/-- Hadamard three-lines estimate for the finite-simple pairing associated to
general reciprocal endpoint data.  The hypotheses are literal bounds on the
two boundary pairings; their derivation from endpoint operator estimates is
factored through `finiteSimpleVectorPairing_endpoint_enorm_bound`. -/
theorem finiteSimpleVectorPairing_rieszThorin_threeLines {α β E : Type*}
    [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex)) (ν : Measure β)
    (f : SimpleFunc α E) (g : SimpleFunc β Complex)
    {p p' s0 s1 θ A0 A1 : Real}
    (hp : 0 ≤ p) (hp' : 0 ≤ p')
    (hs0 : 0 ≤ s0) (hs1 : 0 ≤ s1) (hs0one : s0 ≤ 1) (hs1one : s1 ≤ 1)
    (hθ : θ ∈ Set.Icc (0 : Real) 1)
    (hleft : ∀ w ∈ Complex.re ⁻¹' ({(0 : Real)} : Set Real),
      ‖finiteSimpleVectorPairing T ν f (rieszThorinInputExponent p s0 s1) g
        (rieszThorinTestExponent p' s0 s1) w‖ ≤ A0)
    (hright : ∀ w ∈ Complex.re ⁻¹' ({(1 : Real)} : Set Real),
      ‖finiteSimpleVectorPairing T ν f (rieszThorinInputExponent p s0 s1) g
        (rieszThorinTestExponent p' s0 s1) w‖ ≤ A1) :
    ‖finiteSimpleVectorPairing T ν f (rieszThorinInputExponent p s0 s1) g
      (rieszThorinTestExponent p' s0 s1) (θ : Complex)‖ ≤
        A0 ^ (1 - θ) * A1 ^ θ := by
  apply scalarThreeLines_unit hθ
  · exact finiteSimpleVectorPairing_analytic T ν f g
      (differentiable_rieszThorinInputExponent p s0 s1)
      (differentiable_rieszThorinTestExponent p' s0 s1)
  · exact finiteSimpleVectorPairing_rieszThorin_bddAbove T ν f g hp hp' hs0 hs1 hs0one hs1one
  · exact hleft
  · exact hright

/-- Pairing against one normalized scalar simple-function atom reduces to an
integral on its value fiber.  This identity needs no integrability
assumption: Mathlib's Bochner integral is total. -/
theorem finiteSimple_integral_mul_scalar_atom {α : Type*} [MeasurableSpace α]
    {μ : Measure α} (h : α → Complex) (g : SimpleFunc α Complex) (v : Complex) :
    ∫ x, h x * finiteSimpleVectorAtom g v x ∂μ =
      ((‖v‖ : Complex)⁻¹ * v) * ∫ x in g ⁻¹' {v}, h x ∂μ := by
  let c : Complex := (‖v‖ : Complex)⁻¹ * v
  let s : Set α := g ⁻¹' {v}
  have hs : MeasurableSet s := g.measurableSet_fiber v
  have hpoint : (fun x => h x * finiteSimpleVectorAtom g v x) =
      fun x => s.indicator (fun x => h x * c) x := by
    funext x
    rw [finiteSimpleVectorAtom_apply]
    simp only [Set.indicator, Set.mem_preimage, Set.mem_singleton_iff]
    by_cases hx : g x = v <;> simp [s, c, hx]
  rw [hpoint, integral_indicator hs]
  change (∫ x, h x * c ∂(μ.restrict s)) = c * ∫ x, h x ∂(μ.restrict s)
  simpa [smul_eq_mul, mul_comm] using (integral_smul (μ := μ.restrict s) c h)

/-- Expand a pairing with a scalar simple-function power deformation into a
finite sum over its nonzero fibers.  The supplied integrability hypotheses
make the finite integral interchange explicit. -/
theorem finiteSimple_pairing_expand {α : Type*} [MeasurableSpace α]
    {μ : Measure α} (h : α → Complex) (g : SimpleFunc α Complex)
    (e : Complex → Complex) (z : Complex)
    (hint : ∀ v ∈ finiteSimpleNonzeroRange g,
      Integrable (fun x => h x * finiteSimpleVectorAtom g v x) μ) :
    ∫ x, h x * finiteSimpleVectorPowerFamily g e z x ∂μ =
      ∑ v ∈ finiteSimpleNonzeroRange g,
        finiteAtomicCpow (‖v‖ : Complex) e z *
          (((‖v‖ : Complex)⁻¹ * v) * ∫ x in g ⁻¹' {v}, h x ∂μ) := by
  classical
  let s := finiteSimpleNonzeroRange g
  let c : Complex → Complex := fun v => finiteAtomicCpow (‖v‖ : Complex) e z
  let a : Complex → SimpleFunc α Complex := finiteSimpleVectorAtom g
  have hsum := finiteSimpleVectorPowerFamily_eq_sum_atoms g e z
  calc
    (∫ x, h x * finiteSimpleVectorPowerFamily g e z x ∂μ) =
        ∫ x, h x * (∑ v ∈ s, c v • a v) x ∂μ := by
      apply integral_congr_ae
      filter_upwards with x
      rw [← hsum]
    _ = ∫ x, ∑ v ∈ s, c v * (h x * a v x) ∂μ := by
      congr with x
      rw [finiteSimple_sum_smul_atom_apply]
      simp only [smul_eq_mul]
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro v hv
      ring
    _ = ∑ v ∈ s, c v * ∫ x, h x * a v x ∂μ := by
      rw [integral_finsetSum]
      · apply Finset.sum_congr rfl
        intro v hv
        simpa [smul_eq_mul] using
          (integral_smul (μ := μ) (c v) (fun x => h x * a v x))
      · intro v hv
        exact (hint v (by simpa [s] using hv)).const_mul (c v)
    _ = _ := by
      dsimp [s, c, a]
      apply Finset.sum_congr rfl
      intro v hv
      rw [finiteSimple_integral_mul_scalar_atom]

/-- First, atom-level form of `finiteSimple_pairing_expand`, before each
scalar atom integral is evaluated on its fiber. -/
theorem finiteSimple_pairing_expand_atoms {α : Type*} [MeasurableSpace α]
    {μ : Measure α} (h : α → Complex) (g : SimpleFunc α Complex)
    (e : Complex → Complex) (z : Complex)
    (hint : ∀ v ∈ finiteSimpleNonzeroRange g,
      Integrable (fun x => h x * finiteSimpleVectorAtom g v x) μ) :
    ∫ x, h x * finiteSimpleVectorPowerFamily g e z x ∂μ =
      ∑ v ∈ finiteSimpleNonzeroRange g,
        finiteAtomicCpow (‖v‖ : Complex) e z *
          ∫ x, h x * finiteSimpleVectorAtom g v x ∂μ := by
  classical
  let s := finiteSimpleNonzeroRange g
  let c : Complex → Complex := fun v => finiteAtomicCpow (‖v‖ : Complex) e z
  let a : Complex → SimpleFunc α Complex := finiteSimpleVectorAtom g
  have hsum := finiteSimpleVectorPowerFamily_eq_sum_atoms g e z
  calc
    (∫ x, h x * finiteSimpleVectorPowerFamily g e z x ∂μ) =
        ∫ x, h x * (∑ v ∈ s, c v • a v) x ∂μ := by
      apply integral_congr_ae
      filter_upwards with x
      rw [← hsum]
    _ = ∫ x, ∑ v ∈ s, c v * (h x * a v x) ∂μ := by
      congr with x
      rw [finiteSimple_sum_smul_atom_apply]
      simp only [smul_eq_mul]
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro v hv
      ring
    _ = _ := by
      rw [integral_finsetSum]
      · apply Finset.sum_congr rfl
        intro v hv
        simpa [smul_eq_mul] using
          (integral_smul (μ := μ) (c v) (fun x => h x * a v x))
      · intro v hv
        exact (hint v (by simpa [s] using hv)).const_mul (c v)

/-- Applying a complex-linear map to a vector-valued simple-function power
expands into the corresponding finite sum of image atoms. -/
theorem finiteSimpleVectorPowerFamily_map_eq_sum_atoms {α β E : Type*}
    [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex))
    (f : SimpleFunc α E) (e : Complex → Complex) (z : Complex) :
    T (finiteSimpleVectorPowerFamily f e z) =
      ∑ v ∈ finiteSimpleNonzeroRange f,
        finiteAtomicCpow (‖v‖ : Complex) e z • T (finiteSimpleVectorAtom f v) := by
  rw [finiteSimpleVectorPowerFamily_eq_sum_atoms]
  simp

/-- Expand one output-atom pairing after expanding the vector-valued simple
input into its finite nonzero-fiber atoms. -/
theorem finiteSimple_source_pairing_expand {α β E : Type*}
    [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E] {ν : Measure β}
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex))
    (f : SimpleFunc α E) (e : Complex → Complex) (z : Complex)
    (g : SimpleFunc β Complex) (w : Complex)
    (hint : ∀ v ∈ finiteSimpleNonzeroRange f,
      Integrable (fun y => T (finiteSimpleVectorAtom f v) y *
        finiteSimpleVectorAtom g w y) ν) :
    ∫ y, T (finiteSimpleVectorPowerFamily f e z) y *
        finiteSimpleVectorAtom g w y ∂ν =
      ∑ v ∈ finiteSimpleNonzeroRange f,
        finiteAtomicCpow (‖v‖ : Complex) e z *
          ∫ y, T (finiteSimpleVectorAtom f v) y *
            finiteSimpleVectorAtom g w y ∂ν := by
  rw [finiteSimpleVectorPowerFamily_map_eq_sum_atoms]
  calc
    (∫ y, (∑ v ∈ finiteSimpleNonzeroRange f,
      finiteAtomicCpow (‖v‖ : Complex) e z • T (finiteSimpleVectorAtom f v)) y *
        finiteSimpleVectorAtom g w y ∂ν) =
      ∫ y, ∑ v ∈ finiteSimpleNonzeroRange f,
        finiteAtomicCpow (‖v‖ : Complex) e z *
          (T (finiteSimpleVectorAtom f v) y * finiteSimpleVectorAtom g w y) ∂ν := by
        apply integral_congr_ae
        filter_upwards with y
        rw [Finset.sum_apply]
        simp only [Pi.smul_apply]
        rw [Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro v hv
        ring
    _ = _ := by
      rw [integral_finsetSum]
      · apply Finset.sum_congr rfl
        intro v hv
        simpa using (integral_smul (μ := ν)
          (finiteAtomicCpow (‖v‖ : Complex) e z)
          (fun y => T (finiteSimpleVectorAtom f v) y * finiteSimpleVectorAtom g w y))
      · intro v hv
        exact (hint v hv).const_mul _

/-- The explicit finite-fiber pairing is the literal integral pairing of the
two simple-function power deformations.  All interchange of a finite sum and
an integral is discharged by the atom-pairing integrability assumption. -/
theorem finiteSimpleVectorPairing_eq_integral {α β E : Type*}
    [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E] {ν : Measure β}
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex))
    (f : SimpleFunc α E) (a : Complex → Complex)
    (g : SimpleFunc β Complex) (b : Complex → Complex) (z : Complex)
    (hint : ∀ v ∈ finiteSimpleNonzeroRange f,
      ∀ w ∈ finiteSimpleNonzeroRange g,
        Integrable (fun y => T (finiteSimpleVectorAtom f v) y *
          finiteSimpleVectorAtom g w y) ν) :
    finiteSimpleVectorPairing T ν f a g b z =
      ∫ y, T (finiteSimpleVectorPowerFamily f a z) y *
        finiteSimpleVectorPowerFamily g b z y ∂ν := by
  classical
  have houtput : ∀ w ∈ finiteSimpleNonzeroRange g,
      Integrable (fun y => T (finiteSimpleVectorPowerFamily f a z) y *
        finiteSimpleVectorAtom g w y) ν := by
    intro w hw
    rw [finiteSimpleVectorPowerFamily_map_eq_sum_atoms]
    have hsum : Integrable (fun y => ∑ v ∈ finiteSimpleNonzeroRange f,
        finiteAtomicCpow (‖v‖ : Complex) a z *
          (T (finiteSimpleVectorAtom f v) y * finiteSimpleVectorAtom g w y)) ν := by
      apply integrable_finsetSum
      intro v hv
      exact (hint v hv w hw).const_mul _
    convert hsum using 1
    funext y
    rw [Finset.sum_apply]
    simp only [Pi.smul_apply]
    rw [Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro v hv
    ring
  have hsource : ∀ w ∈ finiteSimpleNonzeroRange g,
      ∫ y, T (finiteSimpleVectorPowerFamily f a z) y *
        finiteSimpleVectorAtom g w y ∂ν =
        ∑ v ∈ finiteSimpleNonzeroRange f,
          finiteAtomicCpow (‖v‖ : Complex) a z *
            ∫ y, T (finiteSimpleVectorAtom f v) y *
              finiteSimpleVectorAtom g w y ∂ν := by
    intro w hw
    exact finiteSimple_source_pairing_expand T f a z g w
      (fun v hv ↦ hint v hv w hw)
  have htest := finiteSimple_pairing_expand_atoms
    (μ := ν) (fun y => T (finiteSimpleVectorPowerFamily f a z) y) g b z houtput
  calc
    finiteSimpleVectorPairing T ν f a g b z =
        ∑ v ∈ finiteSimpleNonzeroRange f, ∑ w ∈ finiteSimpleNonzeroRange g,
          (finiteAtomicCpow (‖v‖ : Complex) a z *
            finiteAtomicCpow (‖w‖ : Complex) b z) *
            ∫ y, T (finiteSimpleVectorAtom f v) y *
              finiteSimpleVectorAtom g w y ∂ν := by
      unfold finiteSimpleVectorPairing
      apply Finset.sum_congr rfl
      intro v hv
      apply Finset.sum_congr rfl
      intro w hw
      rw [finiteSimple_integral_mul_scalar_atom]
    _ = ∑ w ∈ finiteSimpleNonzeroRange g,
        finiteAtomicCpow (‖w‖ : Complex) b z *
          ∑ v ∈ finiteSimpleNonzeroRange f,
            finiteAtomicCpow (‖v‖ : Complex) a z *
              ∫ y, T (finiteSimpleVectorAtom f v) y *
                finiteSimpleVectorAtom g w y ∂ν := by
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro w hw
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro v hv
      ring
    _ = ∑ w ∈ finiteSimpleNonzeroRange g,
        finiteAtomicCpow (‖w‖ : Complex) b z *
          ∫ y, T (finiteSimpleVectorPowerFamily f a z) y *
            finiteSimpleVectorAtom g w y ∂ν := by
      apply Finset.sum_congr rfl
      intro w hw
      rw [hsource w hw, Finset.mul_sum]
    _ = ∫ y, T (finiteSimpleVectorPowerFamily f a z) y *
        finiteSimpleVectorPowerFamily g b z y ∂ν := htest.symm

/-- Complex `L²` pairing bound in `eLpNorm` form.  It packages the exact
Hölder step used at the left boundary of the simple-function construction. -/
theorem enorm_integral_mul_le_eLpNorm_two_mul {β : Type*} [MeasurableSpace β]
    {ν : Measure β} (F G : β → Complex)
    (hF : MemLp F 2 ν) (hG : MemLp G 2 ν) :
    ‖∫ y, F y * G y ∂ν‖ₑ ≤ eLpNorm F 2 ν * eLpNorm G 2 ν := by
  calc
    ‖∫ y, F y * G y ∂ν‖ₑ ≤ ∫⁻ y, ‖F y * G y‖ₑ ∂ν :=
      enorm_integral_le_lintegral_enorm _
    _ = eLpNorm (fun y => F y * G y) 1 ν := by
      rw [eLpNorm_one_eq_lintegral_enorm]
    _ ≤ eLpNorm F 2 ν * eLpNorm G 2 ν := by
      simpa using eLpNorm_le_eLpNorm_mul_eLpNorm_of_nnnorm (p := 2) (q := 2) (r := 1)
        hF.1 hG.1 (fun x y => x * y) 1
        (Filter.Eventually.of_forall fun x => by simp)

/-- Complex `L∞`--`L¹` pairing bound in `eLpNorm` form.  This is the right
boundary counterpart of `enorm_integral_mul_le_eLpNorm_two_mul`. -/
theorem enorm_integral_mul_le_eLpNorm_top_one_mul {β : Type*} [MeasurableSpace β]
    {ν : Measure β} (F G : β → Complex)
    (hF : MemLp F ⊤ ν) (hG : MemLp G 1 ν) :
    ‖∫ y, F y * G y ∂ν‖ₑ ≤ eLpNorm F ⊤ ν * eLpNorm G 1 ν := by
  calc
    ‖∫ y, F y * G y ∂ν‖ₑ ≤ ∫⁻ y, ‖F y * G y‖ₑ ∂ν :=
      enorm_integral_le_lintegral_enorm _
    _ = eLpNorm (fun y => F y * G y) 1 ν := by
      rw [eLpNorm_one_eq_lintegral_enorm]
    _ ≤ eLpNorm F ⊤ ν * eLpNorm G 1 ν := by
      simpa using eLpNorm_le_eLpNorm_mul_eLpNorm_of_nnnorm (p := ⊤) (q := 1) (r := 1)
        hF.1 hG.1 (fun x y => x * y) 1
        (Filter.Eventually.of_forall fun x => by simp)

/-- Complex `L⁴`--`L^(4/3)` pairing bound in `eLpNorm` form.  In addition to
the boundary estimates, this controls the error when an explicit `L^(4/3)`
phase test is approximated by simple functions. -/
theorem enorm_integral_mul_le_eLpNorm_four_fourThird_mul
    {β : Type*} [MeasurableSpace β] {ν : Measure β}
    (F G : β → Complex) (hF : MemLp F 4 ν)
    (hG : MemLp G (4 / 3 : ENNReal) ν) :
    ‖∫ y, F y * G y ∂ν‖ₑ ≤
      eLpNorm F 4 ν * eLpNorm G (4 / 3 : ENNReal) ν := by
  letI : ENNReal.HolderTriple (4 : ENNReal) (4 / 3 : ENNReal) 1 :=
    ENNReal.HolderTriple.of_toReal (by constructor <;> norm_num)
  calc
    ‖∫ y, F y * G y ∂ν‖ₑ ≤ ∫⁻ y, ‖F y * G y‖ₑ ∂ν :=
      enorm_integral_le_lintegral_enorm _
    _ = eLpNorm (fun y => F y * G y) 1 ν := by
      rw [eLpNorm_one_eq_lintegral_enorm]
    _ ≤ eLpNorm F 4 ν * eLpNorm G (4 / 3 : ENNReal) ν := by
      simpa using eLpNorm_le_eLpNorm_mul_eLpNorm_of_nnnorm
        (p := 4) (q := (4 / 3 : ENNReal)) (r := 1)
        hF.1 hG.1 (fun x y => x * y) 1
        (Filter.Eventually.of_forall fun x => by simp)

/-- The explicit complex phase test which norms an `L⁴` scalar function.
It is `conj h · ‖h‖²`, so its pointwise product with `h` is `‖h‖⁴`. -/
def fourDualTest {β : Type*} (h : β → Complex) : β → Complex :=
  fun y => (starRingEnd Complex (h y)) * ((‖h y‖ : Complex) ^ (2 : Nat))

/-- The `L⁴` phase test belongs to the Hölder-dual `L^(4/3)` space. -/
theorem fourDualTest_memLp {β : Type*} [MeasurableSpace β] {ν : Measure β}
    (h : β → Complex) (hh : MemLp h 4 ν) :
    MemLp (fourDualTest h) (4 / 3 : ENNReal) ν := by
  have hpow : MemLp (fun y => ‖h y‖ ^ (3 : Real)) (4 / 3 : ENNReal) ν := by
    convert hh.norm_rpow_div (3 : ENNReal) using 1 <;> norm_num
  apply hpow.of_le
  · unfold fourDualTest
    exact hh.1.star.mul
      ((Complex.continuous_ofReal.comp_aestronglyMeasurable hh.1.norm).pow 2)
  · filter_upwards with y
    unfold fourDualTest
    rw [norm_mul, Complex.norm_conj, norm_pow, Complex.norm_real,
      Real.norm_of_nonneg (norm_nonneg _)]
    have hident : ‖h y‖ * ‖h y‖ ^ (2 : Nat) = ‖h y‖ ^ (3 : Real) := by
      by_cases hz : ‖h y‖ = 0
      · simp [hz]
      · have hpos : 0 < ‖h y‖ := lt_of_le_of_ne (norm_nonneg _) (Ne.symm hz)
        calc
          ‖h y‖ * ‖h y‖ ^ (2 : Nat) = ‖h y‖ ^ (1 : Real) * ‖h y‖ ^ (2 : Real) := by
            rw [Real.rpow_one, Real.rpow_two]
          _ = ‖h y‖ ^ ((1 : Real) + 2) := (Real.rpow_add hpos 1 2).symm
          _ = ‖h y‖ ^ (3 : Real) := by norm_num
    rw [hident, Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)]

/-- Exact norm identity for the `L⁴` phase test. -/
theorem eLpNorm_fourDualTest {β : Type*} [MeasurableSpace β] {ν : Measure β}
    (h : β → Complex) :
    eLpNorm (fourDualTest h) (4 / 3 : ENNReal) ν =
      eLpNorm h 4 ν ^ (3 : Real) := by
  calc
    eLpNorm (fourDualTest h) (4 / 3 : ENNReal) ν =
        eLpNorm (fun y => ‖h y‖ ^ (3 : Real)) (4 / 3 : ENNReal) ν := by
      apply eLpNorm_congr_norm_ae
      filter_upwards with y
      unfold fourDualTest
      rw [norm_mul, Complex.norm_conj, norm_pow, Complex.norm_real,
        Real.norm_of_nonneg (norm_nonneg _)]
      have hident : ‖h y‖ * ‖h y‖ ^ (2 : Nat) = ‖h y‖ ^ (3 : Real) := by
        by_cases hz : ‖h y‖ = 0
        · simp [hz]
        · have hpos : 0 < ‖h y‖ := lt_of_le_of_ne (norm_nonneg _) (Ne.symm hz)
          calc
            ‖h y‖ * ‖h y‖ ^ (2 : Nat) = ‖h y‖ ^ (1 : Real) * ‖h y‖ ^ (2 : Real) := by
              rw [Real.rpow_one, Real.rpow_two]
            _ = ‖h y‖ ^ ((1 : Real) + 2) := (Real.rpow_add hpos 1 2).symm
            _ = ‖h y‖ ^ (3 : Real) := by norm_num
      rw [hident, Real.norm_eq_abs,
        abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)]
    _ = eLpNorm h 4 ν ^ (3 : Real) := by
      rw [eLpNorm_norm_rpow h (by norm_num : (0 : Real) < 3)]
      congr 2
      simpa using
        (ENNReal.div_mul_cancel (a := (3 : ENNReal)) (b := (4 : ENNReal))
          (by norm_num) ENNReal.ofNat_ne_top)

/-- Pointwise phase identity underlying `L⁴` dual norming. -/
theorem mul_fourDualTest (h : β → Complex) (y : β) :
    h y * fourDualTest h y = ((‖h y‖ ^ (4 : Nat) : Real) : Complex) := by
  unfold fourDualTest
  rw [← mul_assoc, Complex.mul_conj']
  norm_num [pow_succ]
  ring

/-- The phase pairing is exactly the fourth norm moment. -/
theorem integral_mul_fourDualTest {β : Type*} [MeasurableSpace β]
    {ν : Measure β} (h : β → Complex) :
    ∫ y, h y * fourDualTest h y ∂ν =
      ∫ y, ((‖h y‖ ^ (4 : Nat) : Real) : Complex) ∂ν := by
  apply integral_congr_ae
  filter_upwards with y
  exact mul_fourDualTest h y

/-- An `eLpNorm` upper bound by a finite quantity, together with strong
measurability, supplies the corresponding `MemLp` fact. -/
theorem memLp_of_aestronglyMeasurable_of_eLpNorm_le
    {β F : Type*} [MeasurableSpace β] [NormedAddCommGroup F]
    {ν : Measure β} {p C : ENNReal} {h : β → F}
    (hmeas : AEStronglyMeasurable h ν) (hbound : eLpNorm h p ν ≤ C)
    (hC : C < ⊤) : MemLp h p ν :=
  ⟨hmeas, hbound.trans_lt hC⟩

/-- Literal normalized left-boundary estimate for the finite-simple analytic
pairing.  The hypotheses are raw `L²` endpoint bounds and output
measurability; the proof constructs all atom-pair integrability needed to
identify the finite analytic sum with its integral. -/
theorem finiteSimpleTwoTopPairing_left_enorm_bound {α β E : Type*}
    [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} {ν : Measure β}
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex)) (A : ENNReal)
    (hA : A < ⊤) (hTmeas : ∀ u, AEStronglyMeasurable (T u) ν)
    (hTtwo : ∀ u, eLpNorm (T u) 2 ν ≤ A * eLpNorm (u : α → E) 2 μ)
    (f : SimpleFunc α E) (g : SimpleFunc β Complex)
    (hfmem : MemLp (f : α → E) 4 μ)
    (hgmem : MemLp (g : β → Complex) (4 / 3 : ENNReal) ν)
    (hf : eLpNorm (f : α → E) 4 μ ≤ 1)
    (hg : eLpNorm (g : β → Complex) (4 / 3 : ENNReal) ν ≤ 1)
    (w : Complex) (hw : w.re = 0) :
    ‖finiteSimpleVectorPairing T ν f finiteAtomicTwoTopInputExponent g
      finiteAtomicTwoTopTestExponent w‖ₑ ≤ A := by
  have hinmem := finiteSimpleTwoTopInput_left_memLp f hfmem w hw
  have htestmem := finiteSimpleTwoTopTest_left_memLp g hgmem w hw
  have hinnorm : eLpNorm
      (finiteSimpleVectorPowerFamily f finiteAtomicTwoTopInputExponent w : α → E) 2 μ ≤ 1 := by
    rw [eLpNorm_finiteSimpleTwoTopInput_left f w hw]
    exact ENNReal.rpow_le_one hf (by norm_num)
  have htestnorm : eLpNorm
      (finiteSimpleVectorPowerFamily g finiteAtomicTwoTopTestExponent w : β → Complex) 2 ν ≤ 1 := by
    rw [eLpNorm_finiteSimpleTwoTopTest_left g w hw]
    exact ENNReal.rpow_le_one hg (by norm_num)
  have houtbound : eLpNorm
      (T (finiteSimpleVectorPowerFamily f finiteAtomicTwoTopInputExponent w)) 2 ν ≤ A := by
    calc
      eLpNorm (T (finiteSimpleVectorPowerFamily f finiteAtomicTwoTopInputExponent w)) 2 ν ≤
          A * eLpNorm
            (finiteSimpleVectorPowerFamily f finiteAtomicTwoTopInputExponent w : α → E) 2 μ :=
        hTtwo _
      _ ≤ A * 1 := mul_le_mul le_rfl hinnorm zero_le zero_le
      _ = A := by simp
  have houtmem := memLp_of_aestronglyMeasurable_of_eLpNorm_le
    (hTmeas _) houtbound hA
  have hatomint : ∀ v ∈ finiteSimpleNonzeroRange f,
      ∀ u ∈ finiteSimpleNonzeroRange g,
        Integrable (fun y => T (finiteSimpleVectorAtom f v) y *
          finiteSimpleVectorAtom g u y) ν := by
    intro v hv u hu
    have hvin := finiteSimpleVectorAtom_memLp_of_memLp_any_exponent
      (p := (4 : ENNReal)) (q := (2 : ENNReal)) (by norm_num) (by norm_num)
      f hfmem v hv
    have hvoutbound : eLpNorm (T (finiteSimpleVectorAtom f v)) 2 ν ≤
        A * eLpNorm (finiteSimpleVectorAtom f v : α → E) 2 μ := hTtwo _
    have hvout := memLp_of_aestronglyMeasurable_of_eLpNorm_le
      (hTmeas _) hvoutbound (ENNReal.mul_lt_top hA hvin.eLpNorm_lt_top)
    have huin := finiteSimpleVectorAtom_memLp_of_memLp_any_exponent
      (p := (4 / 3 : ENNReal)) (q := (2 : ENNReal)) (by norm_num) (by finiteness)
      g hgmem u hu
    change Integrable (T (finiteSimpleVectorAtom f v) *
      (finiteSimpleVectorAtom g u : β → Complex)) ν
    exact hvout.integrable_mul huin
  rw [finiteSimpleVectorPairing_eq_integral T f finiteAtomicTwoTopInputExponent g
    finiteAtomicTwoTopTestExponent w hatomint]
  calc
    ‖∫ y, T (finiteSimpleVectorPowerFamily f finiteAtomicTwoTopInputExponent w) y *
        finiteSimpleVectorPowerFamily g finiteAtomicTwoTopTestExponent w y ∂ν‖ₑ ≤
        eLpNorm (T (finiteSimpleVectorPowerFamily f finiteAtomicTwoTopInputExponent w)) 2 ν *
          eLpNorm (finiteSimpleVectorPowerFamily g finiteAtomicTwoTopTestExponent w : β → Complex) 2 ν :=
      enorm_integral_mul_le_eLpNorm_two_mul _ _ houtmem htestmem
    _ ≤ A * 1 := mul_le_mul houtbound htestnorm zero_le zero_le
    _ = A := by simp

/-- Literal normalized right-boundary estimate for the finite-simple analytic
pairing.  The source deformation is uniformly bounded by one, while the
scalar test deformation lies in `L¹`. -/
theorem finiteSimpleTwoTopPairing_right_enorm_bound {α β E : Type*}
    [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} {ν : Measure β}
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex)) (B : ENNReal)
    (hB : B < ⊤) (hTmeas : ∀ u, AEStronglyMeasurable (T u) ν)
    (hTtop : ∀ u, eLpNorm (T u) ⊤ ν ≤ B * eLpNorm (u : α → E) ⊤ μ)
    (f : SimpleFunc α E) (g : SimpleFunc β Complex)
    (hgmem : MemLp (g : β → Complex) (4 / 3 : ENNReal) ν)
    (hg : eLpNorm (g : β → Complex) (4 / 3 : ENNReal) ν ≤ 1)
    (w : Complex) (hw : w.re = 1) :
    ‖finiteSimpleVectorPairing T ν f finiteAtomicTwoTopInputExponent g
      finiteAtomicTwoTopTestExponent w‖ₑ ≤ B := by
  have hinmem := finiteSimpleTwoTopInput_right_memLp (μ := μ) f w hw
  have htestmem := finiteSimpleTwoTopTest_right_memLp (μ := ν) g hgmem w hw
  have hinnorm : eLpNorm
      (finiteSimpleVectorPowerFamily f finiteAtomicTwoTopInputExponent w : α → E) ⊤ μ ≤ 1 :=
    eLpNorm_finiteSimpleTwoTopInput_right_le_one (μ := μ) f w hw
  have htestnorm : eLpNorm
      (finiteSimpleVectorPowerFamily g finiteAtomicTwoTopTestExponent w : β → Complex) 1 ν ≤ 1 := by
    rw [eLpNorm_finiteSimpleTwoTopTest_right g w hw]
    exact ENNReal.rpow_le_one hg (by norm_num)
  have houtbound : eLpNorm
      (T (finiteSimpleVectorPowerFamily f finiteAtomicTwoTopInputExponent w)) ⊤ ν ≤ B := by
    calc
      eLpNorm (T (finiteSimpleVectorPowerFamily f finiteAtomicTwoTopInputExponent w)) ⊤ ν ≤
          B * eLpNorm
            (finiteSimpleVectorPowerFamily f finiteAtomicTwoTopInputExponent w : α → E) ⊤ μ :=
        hTtop _
      _ ≤ B * 1 := mul_le_mul le_rfl hinnorm zero_le zero_le
      _ = B := by simp
  have houtmem := memLp_of_aestronglyMeasurable_of_eLpNorm_le
    (hTmeas _) houtbound hB
  have hatomint : ∀ v ∈ finiteSimpleNonzeroRange f,
      ∀ u ∈ finiteSimpleNonzeroRange g,
        Integrable (fun y => T (finiteSimpleVectorAtom f v) y *
          finiteSimpleVectorAtom g u y) ν := by
    intro v hv u hu
    have hvin : MemLp (finiteSimpleVectorAtom f v : α → E) ⊤ μ :=
      SimpleFunc.memLp_top _ _
    have hvoutbound : eLpNorm (T (finiteSimpleVectorAtom f v)) ⊤ ν ≤
        B * eLpNorm (finiteSimpleVectorAtom f v : α → E) ⊤ μ := hTtop _
    have hvout := memLp_of_aestronglyMeasurable_of_eLpNorm_le
      (hTmeas _) hvoutbound (ENNReal.mul_lt_top hB hvin.eLpNorm_lt_top)
    have huin := finiteSimpleVectorAtom_memLp_of_memLp_any_exponent
      (p := (4 / 3 : ENNReal)) (q := (1 : ENNReal)) (by norm_num) (by finiteness)
      g hgmem u hu
    change Integrable (T (finiteSimpleVectorAtom f v) *
      (finiteSimpleVectorAtom g u : β → Complex)) ν
    exact hvout.integrable_mul huin
  rw [finiteSimpleVectorPairing_eq_integral T f finiteAtomicTwoTopInputExponent g
    finiteAtomicTwoTopTestExponent w hatomint]
  calc
    ‖∫ y, T (finiteSimpleVectorPowerFamily f finiteAtomicTwoTopInputExponent w) y *
        finiteSimpleVectorPowerFamily g finiteAtomicTwoTopTestExponent w y ∂ν‖ₑ ≤
        eLpNorm (T (finiteSimpleVectorPowerFamily f finiteAtomicTwoTopInputExponent w)) ⊤ ν *
          eLpNorm (finiteSimpleVectorPowerFamily g finiteAtomicTwoTopTestExponent w : β → Complex) 1 ν :=
      enorm_integral_mul_le_eLpNorm_top_one_mul _ _ houtmem htestmem
    _ ≤ B * 1 := mul_le_mul houtbound htestnorm zero_le zero_le
    _ = B := by simp

/-- Sharp midpoint estimate for the finite-simple analytic pairing, obtained
directly from the raw `L²` and `L∞` endpoint hypotheses.  This remains a
pairing theorem; the final `L⁴` output-norm step still requires a separate
duality/density argument. -/
theorem finiteSimpleTwoTopPairing_midpoint_enorm_bound {α β E : Type*}
    [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} {ν : Measure β}
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex)) (A B : ENNReal)
    (hA : A < ⊤) (hB : B < ⊤) (hTmeas : ∀ u, AEStronglyMeasurable (T u) ν)
    (hTtwo : ∀ u, eLpNorm (T u) 2 ν ≤ A * eLpNorm (u : α → E) 2 μ)
    (hTtop : ∀ u, eLpNorm (T u) ⊤ ν ≤ B * eLpNorm (u : α → E) ⊤ μ)
    (f : SimpleFunc α E) (g : SimpleFunc β Complex)
    (hfmem : MemLp (f : α → E) 4 μ)
    (hgmem : MemLp (g : β → Complex) (4 / 3 : ENNReal) ν)
    (hf : eLpNorm (f : α → E) 4 μ ≤ 1)
    (hg : eLpNorm (g : β → Complex) (4 / 3 : ENNReal) ν ≤ 1) :
    ‖finiteSimpleVectorPairing T ν f finiteAtomicTwoTopInputExponent g
      finiteAtomicTwoTopTestExponent ((1 / 2 : Real) : Complex)‖ₑ ≤
        (A * B) ^ (1 / 2 : Real) := by
  have hanalytic : ScalarAnalyticFamily 0 1
      (finiteSimpleVectorPairing T ν f finiteAtomicTwoTopInputExponent g
        finiteAtomicTwoTopTestExponent) :=
    finiteSimpleVectorPairing_analytic T ν f g
      differentiable_finiteAtomicTwoTopInputExponent
      differentiable_finiteAtomicTwoTopTestExponent
  have hbounded := finiteSimpleVectorPairing_bddAbove T ν f g
  have hleft : ∀ w ∈ Complex.re ⁻¹' ({(0 : Real)} : Set Real),
      ‖finiteSimpleVectorPairing T ν f finiteAtomicTwoTopInputExponent g
        finiteAtomicTwoTopTestExponent w‖ ≤ A.toReal := by
    intro w hw
    have henorm := finiteSimpleTwoTopPairing_left_enorm_bound T A hA hTmeas hTtwo f g
      hfmem hgmem hf hg w (by simpa using hw)
    exact (ENNReal.toReal_le_toReal (by finiteness) hA.ne).mpr henorm
  have hright : ∀ w ∈ Complex.re ⁻¹' ({(1 : Real)} : Set Real),
      ‖finiteSimpleVectorPairing T ν f finiteAtomicTwoTopInputExponent g
        finiteAtomicTwoTopTestExponent w‖ ≤ B.toReal := by
    intro w hw
    have henorm := finiteSimpleTwoTopPairing_right_enorm_bound T B hB hTmeas hTtop f g
      hgmem hg w (by simpa using hw)
    exact (ENNReal.toReal_le_toReal (by finiteness) hB.ne).mpr henorm
  have hthree := scalarThreeLines_unit (F :=
      finiteSimpleVectorPairing T ν f finiteAtomicTwoTopInputExponent g
        finiteAtomicTwoTopTestExponent)
      (A0 := A.toReal) (A1 := B.toReal) (theta := (1 / 2 : Real)) (by norm_num)
      hanalytic hbounded hleft hright
  have htarget : (A * B) ^ (1 / 2 : Real) =
      ENNReal.ofReal (A.toReal ^ (1 / 2 : Real) * B.toReal ^ (1 / 2 : Real)) := by
    have hhalf : 0 ≤ (1 / 2 : Real) := by norm_num
    have hAt : A = ENNReal.ofReal A.toReal := (ENNReal.ofReal_toReal hA.ne).symm
    have hBt : B = ENNReal.ofReal B.toReal := (ENNReal.ofReal_toReal hB.ne).symm
    rw [hAt, hBt]
    simp only [ENNReal.toReal_ofReal ENNReal.toReal_nonneg]
    rw [← ENNReal.ofReal_mul ENNReal.toReal_nonneg]
    rw [ENNReal.ofReal_rpow_of_nonneg
      (mul_nonneg ENNReal.toReal_nonneg ENNReal.toReal_nonneg) hhalf]
    rw [Real.mul_rpow ENNReal.toReal_nonneg ENNReal.toReal_nonneg]
  rw [htarget, ← ofReal_norm_eq_enorm]
  apply (ENNReal.ofReal_le_ofReal_iff (by positivity)).mpr
  norm_num at hthree ⊢
  exact hthree

/-- The midpoint finite-simple pairing estimate in its literal integral form.
At the midpoint both radial complex-power deformations are the original
simple functions. -/
theorem finiteSimpleTwoTopPairing_midpoint_integral_enorm_bound {α β E : Type*}
    [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} {ν : Measure β}
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex)) (A B : ENNReal)
    (hA : A < ⊤) (hB : B < ⊤) (hTmeas : ∀ u, AEStronglyMeasurable (T u) ν)
    (hTtwo : ∀ u, eLpNorm (T u) 2 ν ≤ A * eLpNorm (u : α → E) 2 μ)
    (hTtop : ∀ u, eLpNorm (T u) ⊤ ν ≤ B * eLpNorm (u : α → E) ⊤ μ)
    (f : SimpleFunc α E) (g : SimpleFunc β Complex)
    (hfmem : MemLp (f : α → E) 4 μ)
    (hgmem : MemLp (g : β → Complex) (4 / 3 : ENNReal) ν)
    (hf : eLpNorm (f : α → E) 4 μ ≤ 1)
    (hg : eLpNorm (g : β → Complex) (4 / 3 : ENNReal) ν ≤ 1) :
    ‖∫ y, T f y * g y ∂ν‖ₑ ≤ (A * B) ^ (1 / 2 : Real) := by
  have hatomint : ∀ v ∈ finiteSimpleNonzeroRange f,
      ∀ u ∈ finiteSimpleNonzeroRange g,
        Integrable (fun y => T (finiteSimpleVectorAtom f v) y *
          finiteSimpleVectorAtom g u y) ν := by
    intro v hv u hu
    have hvin := finiteSimpleVectorAtom_memLp_of_memLp_any_exponent
      (p := (4 : ENNReal)) (q := (2 : ENNReal)) (by norm_num) (by norm_num)
      f hfmem v hv
    have hvoutbound : eLpNorm (T (finiteSimpleVectorAtom f v)) 2 ν ≤
        A * eLpNorm (finiteSimpleVectorAtom f v : α → E) 2 μ := hTtwo _
    have hvout := memLp_of_aestronglyMeasurable_of_eLpNorm_le
      (hTmeas _) hvoutbound (ENNReal.mul_lt_top hA hvin.eLpNorm_lt_top)
    have huin := finiteSimpleVectorAtom_memLp_of_memLp_any_exponent
      (p := (4 / 3 : ENNReal)) (q := (2 : ENNReal)) (by norm_num) (by finiteness)
      g hgmem u hu
    change Integrable (T (finiteSimpleVectorAtom f v) *
      (finiteSimpleVectorAtom g u : β → Complex)) ν
    exact hvout.integrable_mul huin
  have hpair := finiteSimpleTwoTopPairing_midpoint_enorm_bound T A B hA hB hTmeas
    hTtwo hTtop f g hfmem hgmem hf hg
  rw [finiteSimpleVectorPairing_eq_integral T f finiteAtomicTwoTopInputExponent g
    finiteAtomicTwoTopTestExponent ((1 / 2 : Real) : Complex) hatomint] at hpair
  rw [finiteSimpleVectorPowerFamily_apply_of_exponent_one f
      finiteAtomicTwoTopInputExponent ((1 / 2 : Real) : Complex)
      finiteAtomicTwoTopInputExponent_half,
    finiteSimpleVectorPowerFamily_apply_of_exponent_one g
      finiteAtomicTwoTopTestExponent ((1 / 2 : Real) : Complex)
      finiteAtomicTwoTopTestExponent_half] at hpair
  exact hpair

/-- Multiplying a finite simple scalar test by the reciprocal of its
`eLpNorm` produces a test in the closed unit ball.  This deliberately uses
the total inverse, so it also covers the zero test. -/
theorem finiteSimple_eLpNorm_reciprocal_smul_le_one {β : Type*}
    [MeasurableSpace β] {ν : Measure β} {q : ENNReal}
    (g : SimpleFunc β Complex) (hg : MemLp (g : β → Complex) q ν) :
    eLpNorm
        (((((eLpNorm (g : β → Complex) q ν).toReal)⁻¹ : Complex) • g :
          SimpleFunc β Complex) : β → Complex) q ν ≤ 1 := by
  let N : ENNReal := eLpNorm (g : β → Complex) q ν
  let c : Complex := (N.toReal)⁻¹
  change eLpNorm ((c • g : SimpleFunc β Complex) : β → Complex) q ν ≤ 1
  have hsmul : eLpNorm ((c • g : SimpleFunc β Complex) : β → Complex) q ν =
      ‖c‖ₑ * eLpNorm (g : β → Complex) q ν := by
    simpa only [SimpleFunc.coe_smul] using
      (eLpNorm_const_smul c (g : β → Complex) q ν)
  rw [hsmul]
  calc
    ‖c‖ₑ * eLpNorm (g : β → Complex) q ν =
        ENNReal.ofReal (N.toReal⁻¹) * N := by
      by_cases hN : N.toReal = 0
      · simp [c, N, hN]
      · rw [show c = ((N.toReal : Complex)⁻¹) by rfl,
          enorm_inv (Complex.ofReal_ne_zero.mpr hN)]
        have hpos : 0 < N.toReal :=
          lt_of_le_of_ne ENNReal.toReal_nonneg (Ne.symm hN)
        rw [ENNReal.ofReal_inv_of_pos hpos]
        congr 1
        rw [← ofReal_norm]
        simp [Complex.norm_real, abs_of_nonneg ENNReal.toReal_nonneg]
    _ ≤ (ENNReal.ofReal N.toReal)⁻¹ * N :=
      mul_le_mul_of_nonneg_right ENNReal.ofReal_inv_le zero_le
    _ = N⁻¹ * N := by rw [ENNReal.ofReal_toReal hg.eLpNorm_ne_top]
    _ ≤ 1 := ENNReal.inv_mul_le_one N

/-- Hölder's integral estimate in a form usable at arbitrary interpolation
endpoints. -/
theorem enorm_integral_mul_le_eLpNorm_mul_of_holderTriple
    {β : Type*} [MeasurableSpace β] {ν : Measure β} {p q : ENNReal}
    [ENNReal.HolderTriple p q 1] (F G : β → Complex)
    (hF : MemLp F p ν) (hG : MemLp G q ν) :
    ‖∫ y, F y * G y ∂ν‖ₑ ≤ eLpNorm F p ν * eLpNorm G q ν := by
  calc
    ‖∫ y, F y * G y ∂ν‖ₑ ≤ ∫⁻ y, ‖F y * G y‖ₑ ∂ν :=
      enorm_integral_le_lintegral_enorm _
    _ = eLpNorm (fun y => F y * G y) 1 ν := by
      rw [eLpNorm_one_eq_lintegral_enorm]
    _ ≤ eLpNorm F p ν * eLpNorm G q ν := by
      simpa using eLpNorm_le_eLpNorm_mul_eLpNorm_of_nnnorm
        (p := p) (q := q) (r := 1) hF.1 hG.1 (fun x y => x * y) 1
        (Filter.Eventually.of_forall fun x => by simp)

/-- Raw endpoint estimate for a finite-simple analytic pairing.  All
operator information is a literal endpoint `eLpNorm` bound; the remaining
hypotheses record the endpoint properties of the explicit radial powers.
This is the common boundary step for arbitrary finite or infinite endpoint
exponents. -/
theorem finiteSimpleVectorPairing_endpoint_enorm_bound
    {α β E : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} {ν : Measure β} {p q r : ENNReal}
    [ENNReal.HolderTriple p q 1]
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex)) (A : ENNReal)
    (hA : A < ⊤) (hTmeas : ∀ u, AEStronglyMeasurable (T u) ν)
    (hT : ∀ u, eLpNorm (T u) p ν ≤ A * eLpNorm (u : α → E) r μ)
    (f : SimpleFunc α E) (ef : Complex → Complex)
    (g : SimpleFunc β Complex) (eg : Complex → Complex) (z : Complex)
    (htest : MemLp (finiteSimpleVectorPowerFamily g eg z : β → Complex) q ν)
    (hinputnorm : eLpNorm (finiteSimpleVectorPowerFamily f ef z : α → E) r μ ≤ 1)
    (htestnorm : eLpNorm (finiteSimpleVectorPowerFamily g eg z : β → Complex) q ν ≤ 1)
    (hatomint : ∀ v ∈ finiteSimpleNonzeroRange f,
      ∀ u ∈ finiteSimpleNonzeroRange g,
        Integrable (fun y => T (finiteSimpleVectorAtom f v) y *
          finiteSimpleVectorAtom g u y) ν) :
    ‖finiteSimpleVectorPairing T ν f ef g eg z‖ₑ ≤ A := by
  have houtbound : eLpNorm (T (finiteSimpleVectorPowerFamily f ef z)) p ν ≤ A := by
    calc
      eLpNorm (T (finiteSimpleVectorPowerFamily f ef z)) p ν ≤
          A * eLpNorm (finiteSimpleVectorPowerFamily f ef z : α → E) r μ := hT _
      _ ≤ A * 1 := mul_le_mul le_rfl hinputnorm zero_le zero_le
      _ = A := by simp
  have hout := memLp_of_aestronglyMeasurable_of_eLpNorm_le (hTmeas _) houtbound hA
  rw [finiteSimpleVectorPairing_eq_integral T f ef g eg z hatomint]
  calc
    ‖∫ y, T (finiteSimpleVectorPowerFamily f ef z) y *
        finiteSimpleVectorPowerFamily g eg z y ∂ν‖ₑ ≤
        eLpNorm (T (finiteSimpleVectorPowerFamily f ef z)) p ν *
          eLpNorm (finiteSimpleVectorPowerFamily g eg z : β → Complex) q ν :=
      enorm_integral_mul_le_eLpNorm_mul_of_holderTriple _ _ hout htest
    _ ≤ A * 1 := mul_le_mul houtbound htestnorm zero_le zero_le
    _ = A := by simp

/-- Literal unit-ball estimate for the input radial power at a finite
endpoint.  The endpoint is encoded by its actual `ENNReal` reciprocal,
not by an externally supplied analytic-family bound. -/
theorem finiteSimple_inputPower_le_one_of_finite_endpoint
    {α E : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    [NormedSpace Complex E] {μ : Measure α} {P : ENNReal}
    (hP0 : P ≠ 0) (hPtop : P ≠ ⊤) {p : Real} (hp : 0 < p)
    (f : SimpleFunc α E) (ef : Complex → Complex) (z : Complex)
    (hre : (ef z).re = p * (P⁻¹).toReal)
    (hunit : eLpNorm (f : α → E) (ENNReal.ofReal p) μ ≤ 1) :
    eLpNorm (finiteSimpleVectorPowerFamily f ef z : α → E) P μ ≤ 1 := by
  have hinvpos : 0 < (P⁻¹).toReal :=
    ENNReal.toReal_pos (ENNReal.inv_ne_zero.mpr hPtop) (ENNReal.inv_ne_top.mpr hP0)
  have hlam : 0 < p * (P⁻¹).toReal := mul_pos hp hinvpos
  exact eLpNorm_finiteSimpleVectorPowerFamily_le_one_of_moment_identity f ef z
    hre hlam (ennreal_mul_ofReal_mul_reciprocal_toReal hP0 hPtop p) hunit

/-- Literal unit-ball estimate for the input radial power at the `L∞`
endpoint.  Its reciprocal is zero, so the zero-safe power is uniformly
bounded by one. -/
theorem finiteSimple_inputPower_top_le_one_of_infinite_endpoint
    {α E : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    [NormedSpace Complex E] {μ : Measure α} {P : ENNReal}
    (hP : P = ⊤) {p : Real}
    (f : SimpleFunc α E) (ef : Complex → Complex) (z : Complex)
    (hre : (ef z).re = p * (P⁻¹).toReal) :
    eLpNorm (finiteSimpleVectorPowerFamily f ef z : α → E) P μ ≤ 1 := by
  subst P
  apply eLpNorm_finiteSimpleVectorPowerFamily_top_le_one_of_re_zero f ef z
  simpa using hre

/-- The input radial power at the `L∞` endpoint is genuinely in `L∞`. -/
theorem finiteSimple_inputPower_memLp_top_of_infinite_endpoint
    {α E : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    [NormedSpace Complex E] {μ : Measure α} {P : ENNReal}
    (hP : P = ⊤) {p : Real}
    (f : SimpleFunc α E) (ef : Complex → Complex) (z : Complex)
    (hre : (ef z).re = p * (P⁻¹).toReal) :
    MemLp (finiteSimpleVectorPowerFamily f ef z : α → E) P μ := by
  subst P
  apply finiteSimpleVectorPowerFamily_memLp_top_of_re_zero f ef z
  simpa using hre

/-- At a non-`L¹` output endpoint, the complementary test radial power is
in its literal Hölder-conjugate `Lp` space. -/
theorem finiteSimple_testPower_memLp_of_nonone_endpoint
    {β : Type*} [MeasurableSpace β] {ν : Measure β}
    {Q Qstar : ENNReal} [ENNReal.HolderConjugate Q Qstar]
    (hQone : Q ≠ 1) {qstar : Real} (hqstar : 0 < qstar)
    (g : SimpleFunc β Complex) (eg : Complex → Complex) (z : Complex)
    (hre : (eg z).re = qstar * (1 - (Q⁻¹).toReal))
    (hg : MemLp (g : β → Complex) (ENNReal.ofReal qstar) ν) :
    MemLp (finiteSimpleVectorPowerFamily g eg z : β → Complex) Qstar ν := by
  have hQstar0 : Qstar ≠ 0 := ENNReal.HolderConjugate.ne_zero Qstar Q
  have hQstarTop : Qstar ≠ ⊤ := by
    intro htop
    apply hQone
    exact (ENNReal.HolderConjugate.eq_top_iff_eq_one Qstar Q).mp htop
  have hcomp : 1 - (Q⁻¹).toReal = (Qstar⁻¹).toReal :=
    (holderConjugate_reciprocal_toReal (P := Q) (Q := Qstar)).symm
  have hlam : 0 < qstar * (1 - (Q⁻¹).toReal) := by
    rw [hcomp]
    exact mul_pos hqstar
      (ENNReal.toReal_pos (ENNReal.inv_ne_zero.mpr hQstarTop)
        (ENNReal.inv_ne_top.mpr hQstar0))
  have hnorm := eLpNorm_finiteSimpleVectorPowerFamily_eq_rpow_of_moment_identity
    (μ := ν) g eg z hre hlam (ennreal_holderConjugate_test_moment (P := Q) (Q := Qstar)
      hQone qstar)
  refine ⟨(finiteSimpleVectorPowerFamily g eg z).aestronglyMeasurable, ?_⟩
  rw [hnorm]
  exact ENNReal.rpow_lt_top_of_nonneg (le_of_lt hlam) hg.eLpNorm_ne_top

/-- At a non-`L¹` output endpoint, the complementary test radial power is
in the closed unit ball of the literal Hölder-conjugate space. -/
theorem finiteSimple_testPower_le_one_of_nonone_endpoint
    {β : Type*} [MeasurableSpace β] {ν : Measure β}
    {Q Qstar : ENNReal} [ENNReal.HolderConjugate Q Qstar]
    (hQone : Q ≠ 1) {qstar : Real} (hqstar : 0 < qstar)
    (g : SimpleFunc β Complex) (eg : Complex → Complex) (z : Complex)
    (hre : (eg z).re = qstar * (1 - (Q⁻¹).toReal))
    (hunit : eLpNorm (g : β → Complex) (ENNReal.ofReal qstar) ν ≤ 1) :
    eLpNorm (finiteSimpleVectorPowerFamily g eg z : β → Complex) Qstar ν ≤ 1 := by
  have hQstar0 : Qstar ≠ 0 := ENNReal.HolderConjugate.ne_zero Qstar Q
  have hQstarTop : Qstar ≠ ⊤ := by
    intro htop
    apply hQone
    exact (ENNReal.HolderConjugate.eq_top_iff_eq_one Qstar Q).mp htop
  have hcomp : 1 - (Q⁻¹).toReal = (Qstar⁻¹).toReal :=
    (holderConjugate_reciprocal_toReal (P := Q) (Q := Qstar)).symm
  have hlam : 0 < qstar * (1 - (Q⁻¹).toReal) := by
    rw [hcomp]
    exact mul_pos hqstar
      (ENNReal.toReal_pos (ENNReal.inv_ne_zero.mpr hQstarTop)
        (ENNReal.inv_ne_top.mpr hQstar0))
  exact eLpNorm_finiteSimpleVectorPowerFamily_le_one_of_moment_identity g eg z
    (μ := ν) hre hlam (ennreal_holderConjugate_test_moment (P := Q) (Q := Qstar)
      hQone qstar) hunit

/-- At the `L¹` output endpoint, the dual test power has zero real exponent,
so it lies in the unit ball of `L∞`. -/
theorem finiteSimple_testPower_top_of_one_endpoint
    {β : Type*} [MeasurableSpace β] {ν : Measure β}
    {Q Qstar : ENNReal} [ENNReal.HolderConjugate Q Qstar]
    (hQ : Q = 1) {qstar : Real}
    (g : SimpleFunc β Complex) (eg : Complex → Complex) (z : Complex)
    (hre : (eg z).re = qstar * (1 - (Q⁻¹).toReal)) :
    MemLp (finiteSimpleVectorPowerFamily g eg z : β → Complex) Qstar ν ∧
      eLpNorm (finiteSimpleVectorPowerFamily g eg z : β → Complex) Qstar ν ≤ 1 := by
  have hQstar : Qstar = ⊤ :=
    (ENNReal.HolderConjugate.eq_top_iff_eq_one Qstar Q).mpr hQ
  subst Qstar
  constructor
  · apply finiteSimpleVectorPowerFamily_memLp_top_of_re_zero g eg z
    simpa [hQ] using hre
  · apply eLpNorm_finiteSimpleVectorPowerFamily_top_le_one_of_re_zero g eg z
    simpa [hQ] using hre

/-- The finite atom-pair integrability required by the explicit analytic
pairing follows directly from a literal endpoint operator bound.  This
separates the measure-theoretic bridge from the three-lines argument. -/
theorem finiteSimple_atomPair_integrable_of_endpoint_bound
    {α β E : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} {ν : Measure β} {P Q Qstar pin qtest : ENNReal}
    [ENNReal.HolderTriple Q Qstar 1]
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex)) (A : ENNReal)
    (hA : A < ⊤) (hTmeas : ∀ u, AEStronglyMeasurable (T u) ν)
    (hT : ∀ u, eLpNorm (T u) Q ν ≤ A * eLpNorm (u : α → E) P μ)
    (f : SimpleFunc α E) (hf : MemLp (f : α → E) pin μ)
    (hpin0 : pin ≠ 0) (hpinTop : pin ≠ ⊤)
    (g : SimpleFunc β Complex) (hg : MemLp (g : β → Complex) qtest ν)
    (hqtest0 : qtest ≠ 0) (hqtestTop : qtest ≠ ⊤) :
    ∀ v ∈ finiteSimpleNonzeroRange f, ∀ w ∈ finiteSimpleNonzeroRange g,
      Integrable (fun y => T (finiteSimpleVectorAtom f v) y *
        finiteSimpleVectorAtom g w y) ν := by
  intro v hv w hw
  have hvin := finiteSimpleVectorAtom_memLp_of_memLp_any_exponent
    (p := pin) (q := P) hpin0 hpinTop f hf v hv
  have hvoutbound : eLpNorm (T (finiteSimpleVectorAtom f v)) Q ν ≤
      A * eLpNorm (finiteSimpleVectorAtom f v : α → E) P μ := hT _
  have hvout := memLp_of_aestronglyMeasurable_of_eLpNorm_le
    (hTmeas _) hvoutbound (ENNReal.mul_lt_top hA hvin.eLpNorm_lt_top)
  have hwin := finiteSimpleVectorAtom_memLp_of_memLp_any_exponent
    (p := qtest) (q := Qstar) hqtest0 hqtestTop g hg w hw
  change Integrable (T (finiteSimpleVectorAtom f v) *
    (finiteSimpleVectorAtom g w : β → Complex)) ν
  exact hvout.integrable_mul hwin

/-- Direct finite-simple boundary pairing estimate for a finite source
endpoint and a non-`L¹` target endpoint.  Every boundary fact is derived
from the literal endpoint `eLpNorm` operator bound and the reciprocal
exponents of the two endpoint spaces. -/
theorem finiteSimpleVectorPairing_endpoint_of_finiteSource_nononeTarget
    {α β E : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} {ν : Measure β} {P Q Qstar : ENNReal}
    [ENNReal.HolderTriple Q Qstar 1]
    (hP0 : P ≠ 0) (hPtop : P ≠ ⊤) (hQone : Q ≠ 1)
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex)) (A : ENNReal)
    (hA : A < ⊤) (hTmeas : ∀ u, AEStronglyMeasurable (T u) ν)
    (hT : ∀ u, eLpNorm (T u) Q ν ≤ A * eLpNorm (u : α → E) P μ)
    {p qstar : Real} (hp : 0 < p) (hqstar : 0 < qstar)
    (f : SimpleFunc α E) (hf : MemLp (f : α → E) (ENNReal.ofReal p) μ)
    (hfunit : eLpNorm (f : α → E) (ENNReal.ofReal p) μ ≤ 1)
    (g : SimpleFunc β Complex) (hg : MemLp (g : β → Complex) (ENNReal.ofReal qstar) ν)
    (hgunit : eLpNorm (g : β → Complex) (ENNReal.ofReal qstar) ν ≤ 1)
    (ef eg : Complex → Complex) (z : Complex)
    (hinre : (ef z).re = p * (P⁻¹).toReal)
    (htestre : (eg z).re = qstar * (1 - (Q⁻¹).toReal)) :
    ‖finiteSimpleVectorPairing T ν f ef g eg z‖ₑ ≤ A := by
  have hinputnorm := finiteSimple_inputPower_le_one_of_finite_endpoint
    hP0 hPtop hp f ef z hinre hfunit
  have htest := finiteSimple_testPower_memLp_of_nonone_endpoint
    (Q := Q) (Qstar := Qstar) hQone hqstar g eg z htestre hg
  have htestnorm := finiteSimple_testPower_le_one_of_nonone_endpoint
    (Q := Q) (Qstar := Qstar) hQone hqstar g eg z htestre hgunit
  have hp0 : ENNReal.ofReal p ≠ 0 := (ENNReal.ofReal_pos.mpr hp).ne'
  have hqstar0 : ENNReal.ofReal qstar ≠ 0 := (ENNReal.ofReal_pos.mpr hqstar).ne'
  have hatomint := finiteSimple_atomPair_integrable_of_endpoint_bound
    (P := P) (Q := Q) (Qstar := Qstar) (pin := ENNReal.ofReal p)
    (qtest := ENNReal.ofReal qstar)
    T A hA hTmeas hT f hf hp0 ENNReal.ofReal_ne_top
    g hg hqstar0 ENNReal.ofReal_ne_top
  exact finiteSimpleVectorPairing_endpoint_enorm_bound T A hA hTmeas hT f ef g eg z
    htest hinputnorm htestnorm hatomint

/-- Direct finite-simple boundary pairing estimate for an `L∞` source
endpoint and a non-`L¹` target endpoint. -/
theorem finiteSimpleVectorPairing_endpoint_of_infiniteSource_nononeTarget
    {α β E : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} {ν : Measure β} {P Q Qstar : ENNReal}
    [ENNReal.HolderTriple Q Qstar 1]
    (hP : P = ⊤) (hQone : Q ≠ 1)
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex)) (A : ENNReal)
    (hA : A < ⊤) (hTmeas : ∀ u, AEStronglyMeasurable (T u) ν)
    (hT : ∀ u, eLpNorm (T u) Q ν ≤ A * eLpNorm (u : α → E) P μ)
    {p qstar : Real} (hp : 0 < p) (hqstar : 0 < qstar)
    (f : SimpleFunc α E) (hf : MemLp (f : α → E) (ENNReal.ofReal p) μ)
    (g : SimpleFunc β Complex) (hg : MemLp (g : β → Complex) (ENNReal.ofReal qstar) ν)
    (hgunit : eLpNorm (g : β → Complex) (ENNReal.ofReal qstar) ν ≤ 1)
    (ef eg : Complex → Complex) (z : Complex)
    (hinre : (ef z).re = p * (P⁻¹).toReal)
    (htestre : (eg z).re = qstar * (1 - (Q⁻¹).toReal)) :
    ‖finiteSimpleVectorPairing T ν f ef g eg z‖ₑ ≤ A := by
  have hinputnorm := finiteSimple_inputPower_top_le_one_of_infinite_endpoint
    (μ := μ) hP f ef z hinre
  have htest := finiteSimple_testPower_memLp_of_nonone_endpoint
    (Q := Q) (Qstar := Qstar) hQone hqstar g eg z htestre hg
  have htestnorm := finiteSimple_testPower_le_one_of_nonone_endpoint
    (Q := Q) (Qstar := Qstar) hQone hqstar g eg z htestre hgunit
  have hp0 : ENNReal.ofReal p ≠ 0 := (ENNReal.ofReal_pos.mpr hp).ne'
  have hqstar0 : ENNReal.ofReal qstar ≠ 0 := (ENNReal.ofReal_pos.mpr hqstar).ne'
  have hatomint := finiteSimple_atomPair_integrable_of_endpoint_bound
    (P := P) (Q := Q) (Qstar := Qstar) (pin := ENNReal.ofReal p)
    (qtest := ENNReal.ofReal qstar)
    T A hA hTmeas hT f hf hp0 ENNReal.ofReal_ne_top
    g hg hqstar0 ENNReal.ofReal_ne_top
  exact finiteSimpleVectorPairing_endpoint_enorm_bound T A hA hTmeas hT f ef g eg z
    htest hinputnorm htestnorm hatomint

/-- Direct finite-simple boundary pairing estimate for a finite source
endpoint and an `L¹` target endpoint.  The test radial power is handled by
the zero-real-part `L∞` branch. -/
theorem finiteSimpleVectorPairing_endpoint_of_finiteSource_oneTarget
    {α β E : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} {ν : Measure β} {P Q Qstar : ENNReal}
    [ENNReal.HolderTriple Q Qstar 1]
    (hP0 : P ≠ 0) (hPtop : P ≠ ⊤) (hQ : Q = 1)
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex)) (A : ENNReal)
    (hA : A < ⊤) (hTmeas : ∀ u, AEStronglyMeasurable (T u) ν)
    (hT : ∀ u, eLpNorm (T u) Q ν ≤ A * eLpNorm (u : α → E) P μ)
    {p qstar : Real} (hp : 0 < p) (hqstar : 0 < qstar)
    (f : SimpleFunc α E) (hf : MemLp (f : α → E) (ENNReal.ofReal p) μ)
    (hfunit : eLpNorm (f : α → E) (ENNReal.ofReal p) μ ≤ 1)
    (g : SimpleFunc β Complex) (hg : MemLp (g : β → Complex) (ENNReal.ofReal qstar) ν)
    (ef eg : Complex → Complex) (z : Complex)
    (hinre : (ef z).re = p * (P⁻¹).toReal)
    (htestre : (eg z).re = qstar * (1 - (Q⁻¹).toReal)) :
    ‖finiteSimpleVectorPairing T ν f ef g eg z‖ₑ ≤ A := by
  have hinputnorm := finiteSimple_inputPower_le_one_of_finite_endpoint
    hP0 hPtop hp f ef z hinre hfunit
  rcases finiteSimple_testPower_top_of_one_endpoint
    (Q := Q) (Qstar := Qstar) hQ g eg z htestre with ⟨htest, htestnorm⟩
  have hp0 : ENNReal.ofReal p ≠ 0 := (ENNReal.ofReal_pos.mpr hp).ne'
  have hqstar0 : ENNReal.ofReal qstar ≠ 0 := (ENNReal.ofReal_pos.mpr hqstar).ne'
  have hatomint := finiteSimple_atomPair_integrable_of_endpoint_bound
    (P := P) (Q := Q) (Qstar := Qstar) (pin := ENNReal.ofReal p)
    (qtest := ENNReal.ofReal qstar)
    T A hA hTmeas hT f hf hp0 ENNReal.ofReal_ne_top
    g hg hqstar0 ENNReal.ofReal_ne_top
  exact finiteSimpleVectorPairing_endpoint_enorm_bound T A hA hTmeas hT f ef g eg z
    htest hinputnorm htestnorm hatomint

/-- Direct finite-simple boundary pairing estimate for the `L∞` source and
`L¹` target endpoint combination. -/
theorem finiteSimpleVectorPairing_endpoint_of_infiniteSource_oneTarget
    {α β E : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} {ν : Measure β} {P Q Qstar : ENNReal}
    [ENNReal.HolderTriple Q Qstar 1]
    (hP : P = ⊤) (hQ : Q = 1)
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex)) (A : ENNReal)
    (hA : A < ⊤) (hTmeas : ∀ u, AEStronglyMeasurable (T u) ν)
    (hT : ∀ u, eLpNorm (T u) Q ν ≤ A * eLpNorm (u : α → E) P μ)
    {p qstar : Real} (hp : 0 < p) (hqstar : 0 < qstar)
    (f : SimpleFunc α E) (hf : MemLp (f : α → E) (ENNReal.ofReal p) μ)
    (g : SimpleFunc β Complex) (hg : MemLp (g : β → Complex) (ENNReal.ofReal qstar) ν)
    (ef eg : Complex → Complex) (z : Complex)
    (hinre : (ef z).re = p * (P⁻¹).toReal)
    (htestre : (eg z).re = qstar * (1 - (Q⁻¹).toReal)) :
    ‖finiteSimpleVectorPairing T ν f ef g eg z‖ₑ ≤ A := by
  have hinputnorm := finiteSimple_inputPower_top_le_one_of_infinite_endpoint
    (μ := μ) hP f ef z hinre
  rcases finiteSimple_testPower_top_of_one_endpoint
    (Q := Q) (Qstar := Qstar) hQ g eg z htestre with ⟨htest, htestnorm⟩
  have hp0 : ENNReal.ofReal p ≠ 0 := (ENNReal.ofReal_pos.mpr hp).ne'
  have hqstar0 : ENNReal.ofReal qstar ≠ 0 := (ENNReal.ofReal_pos.mpr hqstar).ne'
  have hatomint := finiteSimple_atomPair_integrable_of_endpoint_bound
    (P := P) (Q := Q) (Qstar := Qstar) (pin := ENNReal.ofReal p)
    (qtest := ENNReal.ofReal qstar)
    T A hA hTmeas hT f hf hp0 ENNReal.ofReal_ne_top
    g hg hqstar0 ENNReal.ofReal_ne_top
  exact finiteSimpleVectorPairing_endpoint_enorm_bound T A hA hTmeas hT f ef g eg z
    htest hinputnorm htestnorm hatomint

/-- Zero-safe `L^p` norming dual test: at `y = 0` it is zero. -/
def pRawDualTest {β : Type*} (p : Real) (y : β → Complex) : β → Complex :=
  fun x => ((‖y x‖ ^ (p - 1) : Real) : Complex) * finiteAtomicPhase (y x)

/-- The zero-safe complex phase has norm one away from the origin. -/
theorem finiteAtomicPhase_norm_eq_one {y : Complex} (hy : y ≠ 0) :
    ‖finiteAtomicPhase y‖ = 1 := by
  unfold finiteAtomicPhase
  rw [norm_div, Complex.norm_conj, Complex.norm_real,
    Real.norm_of_nonneg (norm_nonneg _), div_self]
  exact norm_ne_zero_iff.mpr hy

/-- Strong measurability of the explicit `L^p` norming test. -/
theorem aestronglyMeasurable_pRawDualTest {β : Type*} [MeasurableSpace β]
    {ν : Measure β} {p : Real} (hp : 1 < p) {y : β → Complex}
    (hy : AEStronglyMeasurable y ν) :
    AEStronglyMeasurable (pRawDualTest p y) ν := by
  unfold pRawDualTest
  apply AEStronglyMeasurable.mul
  · exact (Complex.continuous_ofReal.comp_aestronglyMeasurable
      ((Real.continuous_rpow_const (sub_nonneg.mpr hp.le)).comp_aestronglyMeasurable hy.norm))
  · exact (Complex.conjCLE.continuous.comp_aestronglyMeasurable hy).div₀
      (Complex.continuous_ofReal.comp_aestronglyMeasurable hy.norm)

/-- Pointwise norming identity for the explicit complex phase test. -/
theorem pRawDualTest_pair_pointwise {β : Type*} {p : Real} (hp : 1 < p)
    (y : β → Complex) (x : β) :
    y x * pRawDualTest p y x = ((‖y x‖ ^ p : Real) : Complex) := by
  unfold pRawDualTest
  by_cases hzero : y x = 0
  · simp [hzero, Real.zero_rpow (by linarith : p - 1 ≠ 0),
      Real.zero_rpow (by linarith : p ≠ 0)]
  · have hnpos : 0 < ‖y x‖ := norm_pos_iff.mpr hzero
    calc
      y x * (((‖y x‖ ^ (p - 1) : Real) : Complex) * finiteAtomicPhase (y x)) =
          ((‖y x‖ ^ (p - 1) : Real) : Complex) * (y x * finiteAtomicPhase (y x)) := by ring
      _ = ((‖y x‖ ^ (p - 1) : Real) : Complex) * (‖y x‖ : Complex) := by
          rw [finiteAtomic_mul_phase]
      _ = ((‖y x‖ ^ (p - 1) * ‖y x‖ : Real) : Complex) := by
          rw [Complex.ofReal_mul]
      _ = ((‖y x‖ ^ p : Real) : Complex) := by
          congr 1
          calc
            ‖y x‖ ^ (p - 1) * ‖y x‖ =
                ‖y x‖ ^ (p - 1) * ‖y x‖ ^ (1 : Real) := by rw [Real.rpow_one]
            _ = ‖y x‖ ^ ((p - 1) + 1) := (Real.rpow_add hnpos _ _).symm
            _ = ‖y x‖ ^ p := by congr 1 <;> ring

/-- Pointwise norm identity for the explicit complex phase test. -/
theorem norm_pRawDualTest {β : Type*} {p : Real} (hp : 1 < p)
    (y : β → Complex) (x : β) :
    ‖pRawDualTest p y x‖ = ‖y x‖ ^ (p - 1) := by
  unfold pRawDualTest
  by_cases hzero : y x = 0
  · simp [hzero, Real.zero_rpow (by linarith : p - 1 ≠ 0)]
  · rw [norm_mul, Complex.norm_real,
      Real.norm_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _),
      finiteAtomicPhase_norm_eq_one hzero, mul_one]

/-- Elementary exponent identity used by the `L^p` phase test. -/
theorem p_conjExponent_mul_sub_one (p : Real) (hp : 1 < p) :
    p.conjExponent * (p - 1) = p := by
  rw [Real.conjExponent]
  field_simp [ne_of_gt (sub_pos.mpr hp)]

/-- The dual exponent in `ENNReal` form. -/
theorem ofReal_p_div_sub_one (p : Real) (hp : 1 < p) :
    ENNReal.ofReal p / ENNReal.ofReal (p - 1) = ENNReal.ofReal p.conjExponent := by
  rw [← ENNReal.ofReal_div_of_pos (sub_pos.mpr hp)]
  congr 1

/-- The exponent moment identity for the `L^p` phase test. -/
theorem ofReal_pconj_mul_sub_one (p : Real) (hp : 1 < p) :
    ENNReal.ofReal p.conjExponent * ENNReal.ofReal (p - 1) = ENNReal.ofReal p := by
  rw [← ENNReal.ofReal_mul (le_of_lt (Real.HolderConjugate.conjExponent hp).symm.pos)]
  exact congrArg ENNReal.ofReal (p_conjExponent_mul_sub_one p hp)

/-- The explicit phase test is in the literal Hölder-dual space. -/
theorem memLp_pRawDualTest {β : Type*} [MeasurableSpace β]
    {ν : Measure β} {p : Real} (hp : 1 < p) {y : β → Complex}
    (hy : MemLp y (ENNReal.ofReal p) ν) :
    MemLp (pRawDualTest p y) (ENNReal.ofReal p.conjExponent) ν := by
  have hbase := hy.norm_rpow_div (ENNReal.ofReal (p - 1))
  have htoReal : (ENNReal.ofReal (p - 1)).toReal = p - 1 :=
    ENNReal.toReal_ofReal (sub_nonneg.mpr hp.le)
  simp only [htoReal] at hbase
  rw [ofReal_p_div_sub_one p hp] at hbase
  refine hbase.congr_norm (aestronglyMeasurable_pRawDualTest hp hy.1) ?_
  filter_upwards with x
  rw [norm_pRawDualTest hp]
  simp only [Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)]

/-- Exact `eLpNorm` identity for the explicit phase test. -/
theorem eLpNorm_pRawDualTest {β : Type*} [MeasurableSpace β]
    {ν : Measure β} {p : Real} (hp : 1 < p) (y : β → Complex) :
    eLpNorm (pRawDualTest p y) (ENNReal.ofReal p.conjExponent) ν =
      eLpNorm y (ENNReal.ofReal p) ν ^ (p - 1) := by
  calc
    eLpNorm (pRawDualTest p y) (ENNReal.ofReal p.conjExponent) ν =
        eLpNorm (fun x => ‖y x‖ ^ (p - 1)) (ENNReal.ofReal p.conjExponent) ν := by
          apply eLpNorm_congr_norm_ae
          filter_upwards with x
          rw [norm_pRawDualTest hp]
          simp only [Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)]
    _ = eLpNorm y
          (ENNReal.ofReal p.conjExponent * ENNReal.ofReal (p - 1)) ν ^ (p - 1) := by
          rw [eLpNorm_norm_rpow _ (sub_pos.mpr hp)]
    _ = eLpNorm y (ENNReal.ofReal p) ν ^ (p - 1) := by
          rw [ofReal_pconj_mul_sub_one p hp]

/-- The phase pairing is the `p`-th norm moment. -/
theorem integral_pRawDualTest_pairing {β : Type*} [MeasurableSpace β]
    {ν : Measure β} {p : Real} (hp : 1 < p) (y : β → Complex) :
    ∫ x, y x * pRawDualTest p y x ∂ν =
      ((∫ x, ‖y x‖ ^ p ∂ν : Real) : Complex) := by
  rw [← integral_complex_ofReal]
  apply integral_congr_ae
  filter_upwards with x
  exact pRawDualTest_pair_pointwise hp y x

/-- The `p`-th power of the real `Lp` seminorm is its norm moment. -/
theorem lpNorm_p_pow_eq_integral_norm_rpow {β : Type*} [MeasurableSpace β]
    {ν : Measure β} {p : Real} (hp : 1 < p) {y : β → Complex}
    (hy : MemLp y (ENNReal.ofReal p) ν) :
    lpNorm y (ENNReal.ofReal p) ν ^ p = ∫ x, ‖y x‖ ^ p ∂ν := by
  have hp_pos : 0 < p := lt_trans zero_lt_one hp
  have hform := lpNorm_eq_integral_norm_rpow_toReal
    (f := y) (μ := ν) (p := ENNReal.ofReal p)
    (ne_of_gt (ENNReal.ofReal_pos.mpr hp_pos)) (by simp) hy.1
  have hnonneg : 0 ≤ ∫ x, ‖y x‖ ^ p ∂ν :=
    integral_nonneg fun x => Real.rpow_nonneg (norm_nonneg _) _
  rw [ENNReal.toReal_ofReal hp_pos.le] at hform
  rw [hform]
  rw [← Real.rpow_mul hnonneg]
  field_simp [hp_pos.ne']
  rw [Real.rpow_one]

/-- The phase pairing is the `p`-th power of the `Lp` seminorm. -/
theorem integral_pRawDualTest_pairing_eq_lpNorm_pow {β : Type*} [MeasurableSpace β]
    {ν : Measure β} {p : Real} (hp : 1 < p) {y : β → Complex}
    (hy : MemLp y (ENNReal.ofReal p) ν) :
    ∫ x, y x * pRawDualTest p y x ∂ν =
      ((lpNorm y (ENNReal.ofReal p) ν ^ p : Real) : Complex) := by
  rw [integral_pRawDualTest_pairing hp y]
  rw [← lpNorm_p_pow_eq_integral_norm_rpow hp hy]

/-- The real `p` and its real conjugate define a literal `ENNReal`
Hölder pair. -/
theorem ofReal_holderConjugate (p : Real) (hp : 1 < p) :
    ENNReal.HolderConjugate (ENNReal.ofReal p)
      (ENNReal.ofReal p.conjExponent) := by
  constructor
  rw [← ENNReal.ofReal_inv_of_pos (lt_trans zero_lt_one hp),
    ← ENNReal.ofReal_inv_of_pos
      ((Real.HolderConjugate.conjExponent hp).symm.pos),
    ← ENNReal.ofReal_add (inv_nonneg.mpr (by linarith))
      (inv_nonneg.mpr (le_of_lt (Real.HolderConjugate.conjExponent hp).symm.pos))]
  rw [(Real.HolderConjugate.conjExponent hp).inv_add_inv_eq_one]
  norm_num

/-- The Hölder estimate at an arbitrary finite real exponent. -/
theorem enorm_integral_mul_le_eLpNorm_p_pconj_mul
    {β : Type*} [MeasurableSpace β] {ν : Measure β}
    {p : Real} (hp : 1 < p) (F G : β → Complex)
    (hF : MemLp F (ENNReal.ofReal p) ν)
    (hG : MemLp G (ENNReal.ofReal p.conjExponent) ν) :
    ‖∫ x, F x * G x ∂ν‖ₑ ≤
      eLpNorm F (ENNReal.ofReal p) ν *
        eLpNorm G (ENNReal.ofReal p.conjExponent) ν := by
  letI : ENNReal.HolderConjugate (ENNReal.ofReal p)
      (ENNReal.ofReal p.conjExponent) := ofReal_holderConjugate p hp
  calc
    ‖∫ x, F x * G x ∂ν‖ₑ ≤ ∫⁻ x, ‖F x * G x‖ₑ ∂ν :=
      enorm_integral_le_lintegral_enorm _
    _ = eLpNorm (fun x => F x * G x) 1 ν := by
      rw [eLpNorm_one_eq_lintegral_enorm]
    _ ≤ eLpNorm F (ENNReal.ofReal p) ν *
        eLpNorm G (ENNReal.ofReal p.conjExponent) ν := by
      simpa using eLpNorm_le_eLpNorm_mul_eLpNorm_of_nnnorm
        hF.1 hG.1 (fun x y => x * y) 1
        (Filter.Eventually.of_forall fun x => by simp)

/-- A bound on a dense subspace of scalar `Lp` tests extends to every
test. -/
theorem norm_bound_of_dense_simple_tests {β : Type*} [MeasurableSpace β]
    {ν : Measure β} {q : ENNReal} [Fact (1 ≤ q)] (hq_top : q ≠ ∞)
    (Φ : Lp Complex q ν →L[Complex] Complex) (K : Real)
    (h : ∀ g : Lp.simpleFunc Complex q ν,
      ‖Φ (g : Lp Complex q ν)‖ ≤ K * ‖(g : Lp Complex q ν)‖)
    (z : Lp Complex q ν) :
    ‖Φ z‖ ≤ K * ‖z‖ := by
  refine (Lp.simpleFunc.denseRange (E := Complex) (μ := ν) (p := q) hq_top).induction_on z ?_ ?_
  · exact isClosed_le Φ.continuous.norm (continuous_id.norm.const_mul K)
  · intro g
    exact h g

/-- The conjugate exponent of a finite `p > 1` lies in the normed range. -/
theorem one_le_ofReal_conjExponent (p : Real) (hp : 1 < p) :
    1 ≤ ENNReal.ofReal p.conjExponent := by
  rw [← ENNReal.ofReal_one]
  exact ENNReal.ofReal_le_ofReal
    (le_of_lt (Real.HolderConjugate.conjExponent hp).symm.lt)

/-- Norm of the `Lp` element represented by the explicit phase test. -/
theorem norm_toLp_pRawDualTest {β : Type*} [MeasurableSpace β]
    {ν : Measure β} {p : Real} (hp : 1 < p) {y : β → Complex}
    (hy : MemLp y (ENNReal.ofReal p) ν) :
    ‖(memLp_pRawDualTest hp hy).toLp (pRawDualTest p y)‖ =
      lpNorm y (ENNReal.ofReal p) ν ^ (p - 1) := by
  rw [Lp.norm_toLp, eLpNorm_pRawDualTest hp y, ← ENNReal.toReal_rpow]
  rw [← ofReal_lpNorm hy]
  simp only [ENNReal.toReal_ofReal (lpNorm_nonneg)]

/-- Identifies Mathlib's continuous `Lp` pairing with the raw integral. -/
theorem lpPairing_apply_toLp_eq_integral {β : Type*} [MeasurableSpace β]
    {ν : Measure β} {p : Real}
    [Fact (1 ≤ ENNReal.ofReal p)]
    [Fact (1 ≤ ENNReal.ofReal p.conjExponent)]
    [ENNReal.HolderConjugate (ENNReal.ofReal p) (ENNReal.ofReal p.conjExponent)]
    {y : β → Complex}
    (hy : MemLp y (ENNReal.ofReal p) ν)
    (g : Lp Complex (ENNReal.ofReal p.conjExponent) ν) :
    ((ContinuousLinearMap.lpPairing ν (ENNReal.ofReal p)
      (ENNReal.ofReal p.conjExponent) (ContinuousLinearMap.mul Complex Complex))
      (hy.toLp y)) g = ∫ x, y x * g x ∂ν := by
  rw [ContinuousLinearMap.lpPairing_eq_integral]
  apply integral_congr_ae
  filter_upwards [hy.coeFn_toLp] with x hx
  rw [hx]
  rfl

/-- Dense simple tests norm a scalar function in a finite `Lp` space. -/
theorem lpNorm_le_of_simple_test_pairing_bound
    {β : Type*} [MeasurableSpace β] {ν : Measure β} {p K : Real}
    (hp : 1 < p) (hK : 0 ≤ K) {y : β → Complex}
    (hy : MemLp y (ENNReal.ofReal p) ν)
    (hSimple : ∀ g : Lp.simpleFunc Complex (ENNReal.ofReal p.conjExponent) ν,
      ‖∫ x, y x * (g : Lp Complex (ENNReal.ofReal p.conjExponent) ν) x ∂ν‖ ≤
        K * ‖(g : Lp Complex (ENNReal.ofReal p.conjExponent) ν)‖) :
    lpNorm y (ENNReal.ofReal p) ν ≤ K := by
  letI : Fact (1 ≤ ENNReal.ofReal p) :=
    ⟨by
      rw [← ENNReal.ofReal_one]
      exact ENNReal.ofReal_le_ofReal hp.le⟩
  letI : Fact (1 ≤ ENNReal.ofReal p.conjExponent) :=
    ⟨one_le_ofReal_conjExponent p hp⟩
  letI : ENNReal.HolderConjugate (ENNReal.ofReal p)
      (ENNReal.ofReal p.conjExponent) := ofReal_holderConjugate p hp
  let Φ : Lp Complex (ENNReal.ofReal p.conjExponent) ν →L[Complex] Complex :=
    (ContinuousLinearMap.lpPairing ν (ENNReal.ofReal p)
      (ENNReal.ofReal p.conjExponent) (ContinuousLinearMap.mul Complex Complex)) (hy.toLp y)
  have hΦsimple : ∀ g : Lp.simpleFunc Complex (ENNReal.ofReal p.conjExponent) ν,
      ‖Φ (g : Lp Complex (ENNReal.ofReal p.conjExponent) ν)‖ ≤
        K * ‖(g : Lp Complex (ENNReal.ofReal p.conjExponent) ν)‖ := by
    intro g
    rw [show Φ = (ContinuousLinearMap.lpPairing ν (ENNReal.ofReal p)
      (ENNReal.ofReal p.conjExponent) (ContinuousLinearMap.mul Complex Complex)) (hy.toLp y) by rfl,
      lpPairing_apply_toLp_eq_integral hy]
    exact hSimple g
  let hrawMem : MemLp (pRawDualTest p y) (ENNReal.ofReal p.conjExponent) ν :=
    memLp_pRawDualTest hp hy
  have hraw := norm_bound_of_dense_simple_tests
    (q := ENNReal.ofReal p.conjExponent) (by simp) Φ K hΦsimple
    (hrawMem.toLp (pRawDualTest p y))
  have hraw_integral :
      ∫ x, y x * (hrawMem.toLp (pRawDualTest p y) : β → Complex) x ∂ν =
        ∫ x, y x * pRawDualTest p y x ∂ν := by
    apply integral_congr_ae
    filter_upwards [hrawMem.coeFn_toLp] with x hx
    rw [hx]
  rw [show Φ = (ContinuousLinearMap.lpPairing ν (ENNReal.ofReal p)
      (ENNReal.ofReal p.conjExponent) (ContinuousLinearMap.mul Complex Complex)) (hy.toLp y) by rfl,
    lpPairing_apply_toLp_eq_integral hy,
    norm_toLp_pRawDualTest hp hy,
    hraw_integral,
    integral_pRawDualTest_pairing_eq_lpNorm_pow hp hy] at hraw
  simp only [Complex.norm_real,
    Real.norm_of_nonneg (Real.rpow_nonneg (lpNorm_nonneg) _)] at hraw
  by_cases hzero : lpNorm y (ENNReal.ofReal p) ν = 0
  · simpa [hzero] using hK
  · have hpos : 0 < lpNorm y (ENNReal.ofReal p) ν :=
      lt_of_le_of_ne (lpNorm_nonneg) (Ne.symm hzero)
    have hpowpos : 0 < lpNorm y (ENNReal.ofReal p) ν ^ (p - 1) :=
      Real.rpow_pos_of_pos hpos _
    apply le_of_mul_le_mul_left (a0 := hpowpos)
    calc
      lpNorm y (ENNReal.ofReal p) ν ^ (p - 1) * lpNorm y (ENNReal.ofReal p) ν =
          lpNorm y (ENNReal.ofReal p) ν ^ p := by
            calc
              lpNorm y (ENNReal.ofReal p) ν ^ (p - 1) * lpNorm y (ENNReal.ofReal p) ν =
                  lpNorm y (ENNReal.ofReal p) ν ^ (p - 1) *
                    lpNorm y (ENNReal.ofReal p) ν ^ (1 : Real) := by rw [Real.rpow_one]
              _ = lpNorm y (ENNReal.ofReal p) ν ^ ((p - 1) + 1) :=
                (Real.rpow_add hpos _ _).symm
              _ = lpNorm y (ENNReal.ofReal p) ν ^ p := by congr 1 <;> ring
      _ ≤ K * lpNorm y (ENNReal.ofReal p) ν ^ (p - 1) := hraw
      _ = lpNorm y (ENNReal.ofReal p) ν ^ (p - 1) * K := by ring

/-- Version of generic output norming which accepts raw `SimpleFunc` tests. -/
theorem lpNorm_le_of_raw_simpleFunc_test_pairing_bound
    {β : Type*} [MeasurableSpace β] {ν : Measure β} {p K : Real}
    (hp : 1 < p) (hK : 0 ≤ K) {y : β → Complex}
    (hy : MemLp y (ENNReal.ofReal p) ν)
    (hSimple : ∀ (g : SimpleFunc β Complex)
      (hg : MemLp (g : β → Complex) (ENNReal.ofReal p.conjExponent) ν),
      ‖∫ x, y x * g x ∂ν‖ ≤
        K * ‖hg.toLp (g : β → Complex)‖) :
    lpNorm y (ENNReal.ofReal p) ν ≤ K := by
  apply lpNorm_le_of_simple_test_pairing_bound hp hK hy
  intro g
  have hpair := hSimple (Lp.simpleFunc.toSimpleFunc g) (Lp.simpleFunc.memLp g)
  have hEq : ((Lp.simpleFunc.memLp g).toLp (Lp.simpleFunc.toSimpleFunc g : β → Complex) :
      Lp Complex (ENNReal.ofReal p.conjExponent) ν) =
      (g : Lp Complex (ENNReal.ofReal p.conjExponent) ν) :=
    congrArg Subtype.val (Lp.simpleFunc.toLp_toSimpleFunc g)
  calc
    ‖∫ x, y x * (g : Lp Complex (ENNReal.ofReal p.conjExponent) ν) x ∂ν‖ =
        ‖∫ x, y x * (Lp.simpleFunc.toSimpleFunc g) x ∂ν‖ := by
          congr 1
          apply integral_congr_ae
          filter_upwards [Lp.simpleFunc.toSimpleFunc_eq_toFun g] with x hx
          rw [hx]
    _ ≤ K * ‖(Lp.simpleFunc.memLp g).toLp (Lp.simpleFunc.toSimpleFunc g : β → Complex)‖ := hpair
    _ = K * ‖(g : Lp Complex (ENNReal.ofReal p.conjExponent) ν)‖ := by rw [hEq]

/-- Homogenize a raw-simple-function unit-ball pairing estimate. -/
theorem raw_simpleFunc_pairing_bound_of_unit_bound
    {β : Type*} [MeasurableSpace β] {ν : Measure β} {q : ENNReal} [Fact (1 ≤ q)]
    (K : Real) (y : β → Complex)
    (hUnit : ∀ (g : SimpleFunc β Complex) (hg : MemLp (g : β → Complex) q ν),
      ‖hg.toLp (g : β → Complex)‖ ≤ 1 → ‖∫ x, y x * g x ∂ν‖ ≤ K)
    (g : SimpleFunc β Complex) (hg : MemLp (g : β → Complex) q ν) :
    ‖∫ x, y x * g x ∂ν‖ ≤ K * ‖hg.toLp (g : β → Complex)‖ := by
  let N : Real := ‖hg.toLp (g : β → Complex)‖
  by_cases hN : N = 0
  · have hN' : ‖hg.toLp (g : β → Complex)‖ = 0 := by simpa [N] using hN
    have hLpzero : hg.toLp (g : β → Complex) = 0 := norm_eq_zero.mp hN'
    have hgaezero : (g : β → Complex) =ᵐ[ν] 0 := by
      filter_upwards [hg.coeFn_toLp, Lp.coeFn_zero Complex q ν] with x hx hzero
      rw [← hx, hLpzero, hzero]
    have hprod : (fun x => y x * g x) =ᵐ[ν] 0 := by
      filter_upwards [hgaezero] with x hx
      simp [hx]
    have hIntegral : ∫ x, y x * g x ∂ν = 0 := by
      rw [integral_congr_ae hprod]
      simp
    rw [hIntegral]
    simp [N, hN]
  · have hNnonneg : 0 ≤ N := by
      dsimp [N]
      exact norm_nonneg _
    have hNpos : 0 < N := lt_of_le_of_ne hNnonneg (Ne.symm hN)
    let c : Complex := ((N⁻¹ : Real) : Complex)
    let gc : SimpleFunc β Complex := c • g
    have hgc : MemLp (gc : β → Complex) q ν := by
      change MemLp ((c • g : SimpleFunc β Complex) : β → Complex) q ν
      simpa only [SimpleFunc.coe_smul] using hg.const_smul c
    have hgc_toLp : hgc.toLp (gc : β → Complex) = c • hg.toLp (g : β → Complex) := by
      change hgc.toLp ((c • g : SimpleFunc β Complex) : β → Complex) = c • hg.toLp (g : β → Complex)
      simpa only [SimpleFunc.coe_smul] using hg.toLp_const_smul c
    have hgc_norm : ‖hgc.toLp (gc : β → Complex)‖ ≤ 1 := by
      rw [hgc_toLp, norm_smul]
      dsimp [c]
      change ‖((N⁻¹ : Real) : Complex)‖ * ‖hg.toLp (g : β → Complex)‖ ≤ 1
      change ‖((N⁻¹ : Real) : Complex)‖ * N ≤ 1
      rw [Complex.norm_real,
        Real.norm_of_nonneg (inv_nonneg.mpr hNnonneg)]
      rw [inv_mul_cancel₀ hN]
    have hunit := hUnit gc hgc hgc_norm
    have hgc_integral :
        ∫ x, y x * gc x ∂ν = c * ∫ x, y x * g x ∂ν := by
      calc
        ∫ x, y x * gc x ∂ν = ∫ x, c * (y x * g x) ∂ν := by
          apply integral_congr_ae
          filter_upwards with x
          change y x * (c * g x) = c * (y x * g x)
          ring
        _ = c * ∫ x, y x * g x ∂ν := by
          simpa [smul_eq_mul] using (integral_smul (μ := ν) c (fun x => y x * g x))
    rw [hgc_integral, norm_mul] at hunit
    dsimp [c] at hunit
    change ‖((N⁻¹ : Real) : Complex)‖ * ‖∫ x, y x * g x ∂ν‖ ≤ K at hunit
    rw [Complex.norm_real,
      Real.norm_of_nonneg (inv_nonneg.mpr hNnonneg)] at hunit
    calc
      ‖∫ x, y x * g x ∂ν‖ = N * (N⁻¹ * ‖∫ x, y x * g x ∂ν‖) := by
        field_simp [hN]
      _ ≤ N * K := mul_le_mul_of_nonneg_left hunit hNnonneg
      _ = K * ‖hg.toLp (g : β → Complex)‖ := by
        simp only [N]
        ring

/-- Direct generic output norming from unit-ball bounds for raw simple tests. -/
theorem lpNorm_le_of_raw_simpleFunc_unit_test_pairing_bound
    {β : Type*} [MeasurableSpace β] {ν : Measure β} {p K : Real}
    (hp : 1 < p) (hK : 0 ≤ K) {y : β → Complex}
    (hy : MemLp y (ENNReal.ofReal p) ν)
    (hUnit : ∀ (g : SimpleFunc β Complex)
      (hg : MemLp (g : β → Complex) (ENNReal.ofReal p.conjExponent) ν),
      ‖hg.toLp (g : β → Complex)‖ ≤ 1 → ‖∫ x, y x * g x ∂ν‖ ≤ K) :
    lpNorm y (ENNReal.ofReal p) ν ≤ K := by
  letI : Fact (1 ≤ ENNReal.ofReal p.conjExponent) :=
    ⟨one_le_ofReal_conjExponent p hp⟩
  apply lpNorm_le_of_raw_simpleFunc_test_pairing_bound hp hK hy
  intro g hg
  exact raw_simpleFunc_pairing_bound_of_unit_bound K y hUnit g hg

/-- `ENNReal` form of generic output norming from unit raw-simple tests. -/
theorem eLpNorm_le_of_raw_simpleFunc_unit_test_pairing_enorm_bound
    {β : Type*} [MeasurableSpace β] {ν : Measure β} {p : Real} {K : ENNReal}
    (hp : 1 < p) (hK : K < ∞) {y : β → Complex}
    (hy : MemLp y (ENNReal.ofReal p) ν)
    (hUnit : ∀ (g : SimpleFunc β Complex)
      (hg : MemLp (g : β → Complex) (ENNReal.ofReal p.conjExponent) ν),
      eLpNorm (g : β → Complex) (ENNReal.ofReal p.conjExponent) ν ≤ 1 →
        ‖∫ x, y x * g x ∂ν‖ₑ ≤ K) :
    eLpNorm y (ENNReal.ofReal p) ν ≤ K := by
  have hrealUnit : ∀ (g : SimpleFunc β Complex)
      (hg : MemLp (g : β → Complex) (ENNReal.ofReal p.conjExponent) ν),
      ‖hg.toLp (g : β → Complex)‖ ≤ 1 → ‖∫ x, y x * g x ∂ν‖ ≤ K.toReal := by
    intro g hg hgnorm
    rw [Lp.norm_toLp] at hgnorm
    have hgelp : eLpNorm (g : β → Complex) (ENNReal.ofReal p.conjExponent) ν ≤ 1 :=
      (ENNReal.toReal_le_toReal hg.eLpNorm_ne_top (by simp)).mp hgnorm
    have hpair := hUnit g hg hgelp
    have hpairtop : ‖∫ x, y x * g x ∂ν‖ₑ ≠ ∞ :=
      ne_of_lt (lt_of_le_of_lt hpair hK)
    calc
      ‖∫ x, y x * g x ∂ν‖ = ‖∫ x, y x * g x ∂ν‖ₑ.toReal := by simp
      _ ≤ K.toReal :=
        (ENNReal.toReal_le_toReal hpairtop hK.ne).mpr hpair
  have hreal := lpNorm_le_of_raw_simpleFunc_unit_test_pairing_bound hp
    ENNReal.toReal_nonneg hy hrealUnit
  rw [← ofReal_lpNorm hy]
  rw [← ENNReal.ofReal_toReal hK.ne]
  exact ENNReal.ofReal_le_ofReal hreal

/-- Interpolating two `MemLp` facts by taking real norm powers.  This is the
measure-theoretic membership step needed before the phase-test duality
argument; it also works when either endpoint exponent is `∞`. -/
theorem memLp_of_norm_power_interpolation
    {β : Type*} [MeasurableSpace β] {ν : Measure β}
    {P₀ P₁ P c₀ c₁ : ENNReal} [ENNReal.HolderTriple (P₀ / c₀) (P₁ / c₁) P]
    {y : β → Complex} (hymeas : AEStronglyMeasurable y ν)
    (hy₀ : MemLp y P₀ ν) (hy₁ : MemLp y P₁ ν)
    (hc₀ : 0 < c₀.toReal) (hc₁ : 0 < c₁.toReal)
    (hcsum : c₀.toReal + c₁.toReal = 1) :
    MemLp y P ν := by
  letI : ENNReal.HolderTriple (P₀ / c₀) (P₁ / c₁) P := inferInstance
  have hpow : MemLp (fun x => ‖y x‖ ^ c₀.toReal * ‖y x‖ ^ c₁.toReal) P ν :=
    (hy₁.norm_rpow_div c₁).mul' (hy₀.norm_rpow_div c₀)
  have hprod : (fun x => ‖y x‖ ^ c₀.toReal * ‖y x‖ ^ c₁.toReal) =
      fun x => ‖y x‖ := by
    funext x
    by_cases hx : y x = 0
    · simp [hx, Real.zero_rpow (ne_of_gt hc₀), Real.zero_rpow (ne_of_gt hc₁)]
    · have hnormpos : 0 < ‖y x‖ := norm_pos_iff.mpr hx
      rw [← Real.rpow_add hnormpos, hcsum, Real.rpow_one]
  rw [hprod] at hpow
  exact (memLp_norm_iff hymeas).mp hpow

/-- Interpolate `MemLp` membership from the two endpoint spaces by Hölder on
the two real norm powers.  Unlike a finite-measure exponent comparison, this
works on arbitrary measure spaces and permits `∞` endpoint exponents. -/
theorem memLp_of_power_interpolation
    {α E : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    {μ : Measure α} {P₀ P₁ P : ENNReal} {θ : Real} {y : α → E}
    (hθ0 : 0 < θ) (hθ1 : θ < 1)
    (hrecip : (P₀ / ENNReal.ofReal (1 - θ))⁻¹ +
        (P₁ / ENNReal.ofReal θ)⁻¹ = P⁻¹)
    (hy₀ : MemLp y P₀ μ) (hy₁ : MemLp y P₁ μ) :
    MemLp y P μ := by
  let q₀ : ENNReal := P₀ / ENNReal.ofReal (1 - θ)
  let q₁ : ENNReal := P₁ / ENNReal.ofReal θ
  have hθnonneg : 0 ≤ θ := hθ0.le
  have hone_sub_nonneg : 0 ≤ 1 - θ := by linarith
  have hu : MemLp (fun x => ‖y x‖ ^ (1 - θ)) q₀ μ := by
    simpa only [q₀, ENNReal.toReal_ofReal hone_sub_nonneg] using
      hy₀.norm_rpow_div (ENNReal.ofReal (1 - θ))
  have hv : MemLp (fun x => ‖y x‖ ^ θ) q₁ μ := by
    simpa only [q₁, ENNReal.toReal_ofReal hθnonneg] using
      hy₁.norm_rpow_div (ENNReal.ofReal θ)
  let r : ENNReal := (q₀⁻¹ + q₁⁻¹)⁻¹
  letI : ENNReal.HolderTriple q₀ q₁ r := ENNReal.HolderTriple.of q₀ q₁
  have huv : MemLp (fun x => ‖y x‖ ^ (1 - θ) * ‖y x‖ ^ θ) r μ :=
    hv.mul' hu
  have hpow : MemLp (fun x => ‖y x‖) r μ := by
    apply huv.ae_eq
    filter_upwards with x
    by_cases hx : ‖y x‖ = 0
    · rw [hx]
      simp [Real.zero_rpow (sub_pos.mpr hθ1).ne', Real.zero_rpow hθ0.ne']
    · have hxpos : 0 < ‖y x‖ := lt_of_le_of_ne (norm_nonneg _) (Ne.symm hx)
      calc
        ‖y x‖ ^ (1 - θ) * ‖y x‖ ^ θ = ‖y x‖ ^ ((1 - θ) + θ) :=
          (Real.rpow_add hxpos _ _).symm
        _ = ‖y x‖ := by simp
  have hrP : r = P := by
    apply inv_injective
    simpa only [r, inv_inv, q₀, q₁] using hrecip
  rw [hrP] at hpow
  exact (memLp_norm_iff hy₀.1).mp hpow

/-- A simple function whose nonzero fibers have finite measure belongs to
every nonzero `Lp` space.  A finite source `Lp` hypothesis supplies exactly
that finite-fiber condition, even when the ambient measure is infinite. -/
theorem finiteSimple_memLp_of_memLp_any_exponent
    {α E : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    {μ : Measure α} {p q : ENNReal}
    (hp0 : p ≠ 0) (hpTop : p ≠ ⊤) (hq0 : q ≠ 0)
    (f : SimpleFunc α E) (hf : MemLp (f : α → E) p μ) :
    MemLp (f : α → E) q μ := by
  have hfin : f.FinMeasSupp μ :=
    (SimpleFunc.memLp_iff_finMeasSupp hp0 hpTop).mp hf
  by_cases hqTop : q = ⊤
  · subst q
    exact SimpleFunc.memLp_top _ _
  · exact (SimpleFunc.memLp_iff_finMeasSupp hq0 hqTop).mpr hfin

/-- The usual reciprocal interpolation relation supplies exactly the Hölder
triple needed by `memLp_of_power_interpolation`. -/
theorem reciprocal_power_interpolation_identity
    {P₀ P₁ P₀star P₁star : ENNReal}
    [ENNReal.HolderConjugate P₀ P₀star]
    [ENNReal.HolderConjugate P₁ P₁star]
    {p θ : Real} (hp : 0 < p) (hθ0 : 0 < θ) (hθ1 : θ < 1)
    (hmid : p * recipBlend θ (P₀⁻¹).toReal (P₁⁻¹).toReal = 1) :
    (P₀ / ENNReal.ofReal (1 - θ))⁻¹ +
        (P₁ / ENNReal.ofReal θ)⁻¹ = (ENNReal.ofReal p)⁻¹ := by
  have hP₀ : P₀ ≠ 0 := ENNReal.HolderConjugate.ne_zero P₀ P₀star
  have hP₁ : P₁ ≠ 0 := ENNReal.HolderConjugate.ne_zero P₁ P₁star
  have honeθ : 0 < 1 - θ := sub_pos.mpr hθ1
  rw [ENNReal.inv_div (Or.inl ENNReal.ofReal_ne_top)
      (Or.inl (ENNReal.ofReal_pos.mpr honeθ).ne'),
    ENNReal.inv_div (Or.inl ENNReal.ofReal_ne_top)
      (Or.inl (ENNReal.ofReal_pos.mpr hθ0).ne'),
    ENNReal.div_eq_inv_mul, ENNReal.div_eq_inv_mul,
    ← ENNReal.ofReal_toReal (ENNReal.inv_ne_top.mpr hP₀),
    ← ENNReal.ofReal_toReal (ENNReal.inv_ne_top.mpr hP₁),
    ← ENNReal.ofReal_mul ENNReal.toReal_nonneg,
    ← ENNReal.ofReal_mul ENNReal.toReal_nonneg,
    ← ENNReal.ofReal_add]
  · rw [← ENNReal.ofReal_inv_of_pos hp]
    congr 1
    have hblend : recipBlend θ (P₀⁻¹).toReal (P₁⁻¹).toReal = p⁻¹ := by
      calc
        recipBlend θ (P₀⁻¹).toReal (P₁⁻¹).toReal = 1 / p :=
          (eq_div_iff hp.ne').mpr (by simpa [mul_comm] using hmid)
        _ = p⁻¹ := one_div _
    calc
      (P₀⁻¹).toReal * (1 - θ) + (P₁⁻¹).toReal * θ =
          recipBlend θ (P₀⁻¹).toReal (P₁⁻¹).toReal := by
            simp only [recipBlend]
            ring
      _ = p⁻¹ := hblend
  · exact mul_nonneg ENNReal.toReal_nonneg honeθ.le
  · exact mul_nonneg ENNReal.toReal_nonneg hθ0.le

/-- The sharp `ENNReal` geometric interpolation constant agrees with the
corresponding real constant when both endpoint constants are finite. -/
theorem ennreal_weighted_geometricMean_eq_ofReal
    {A₀ A₁ : ENNReal} {θ : Real} (hA₀ : A₀ < ⊤) (hA₁ : A₁ < ⊤)
    (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1) :
    A₀ ^ (1 - θ) * A₁ ^ θ =
      ENNReal.ofReal (A₀.toReal ^ (1 - θ) * A₁.toReal ^ θ) := by
  have hleft : 0 ≤ 1 - θ := sub_nonneg.mpr hθ1
  rw [show A₀ = ENNReal.ofReal A₀.toReal from (ENNReal.ofReal_toReal hA₀.ne).symm,
    show A₁ = ENNReal.ofReal A₁.toReal from (ENNReal.ofReal_toReal hA₁.ne).symm,
    ENNReal.ofReal_rpow_of_nonneg ENNReal.toReal_nonneg hleft,
    ENNReal.ofReal_rpow_of_nonneg ENNReal.toReal_nonneg hθ0,
    ← ENNReal.ofReal_mul]
  · simp
  · exact Real.rpow_nonneg ENNReal.toReal_nonneg _

/-- Direct diagonal finite-simple Riesz--Thorin pairing estimate at arbitrary
finite middle exponents.  The endpoint bounds are literal raw `eLpNorm`
estimates; the proof makes the finite/infinite and one/nonone endpoint cases
explicit through the direct boundary wrappers. -/
theorem finiteSimpleRieszThorin_diagonal_unit_pairing
    {α β E : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} {ν : Measure β}
    {P₀ P₁ P₀star P₁star : ENNReal}
    [ENNReal.HolderConjugate P₀ P₀star]
    [ENNReal.HolderConjugate P₁ P₁star]
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex))
    {A₀ A₁ : ENNReal} (hA₀ : A₀ < ⊤) (hA₁ : A₁ < ⊤)
    (hTmeas : ∀ u, AEStronglyMeasurable (T u) ν)
    (hT₀ : ∀ u, eLpNorm (T u) P₀ ν ≤ A₀ * eLpNorm (u : α → E) P₀ μ)
    (hT₁ : ∀ u, eLpNorm (T u) P₁ ν ≤ A₁ * eLpNorm (u : α → E) P₁ μ)
    {p p' θ : Real} (hp : 1 < p) (hp' : 0 < p')
    (hθ : θ ∈ Set.Ioo (0 : Real) 1)
    (hmidInput : p * recipBlend θ (P₀⁻¹).toReal (P₁⁻¹).toReal = 1)
    (hmidTest : p' * (1 - recipBlend θ (P₀⁻¹).toReal (P₁⁻¹).toReal) = 1)
    (f : SimpleFunc α E) (hf : MemLp (f : α → E) (ENNReal.ofReal p) μ)
    (hfunit : eLpNorm (f : α → E) (ENNReal.ofReal p) μ ≤ 1)
    (g : SimpleFunc β Complex) (hg : MemLp (g : β → Complex) (ENNReal.ofReal p') ν)
    (hgunit : eLpNorm (g : β → Complex) (ENNReal.ofReal p') ν ≤ 1) :
    ‖∫ y, T f y * g y ∂ν‖ ≤ A₀.toReal ^ (1 - θ) * A₁.toReal ^ θ := by
  let s₀ : Real := (P₀⁻¹).toReal
  let s₁ : Real := (P₁⁻¹).toReal
  have hp0 : 0 < p := lt_trans (by norm_num) hp
  have hs₀ : 0 ≤ s₀ := ENNReal.toReal_nonneg
  have hs₁ : 0 ≤ s₁ := ENNReal.toReal_nonneg
  have hP₀one : 1 ≤ P₀ := ENNReal.HolderConjugate.one_le P₀ P₀star
  have hP₁one : 1 ≤ P₁ := ENNReal.HolderConjugate.one_le P₁ P₁star
  have hs₀one : s₀ ≤ 1 := by
    dsimp [s₀]
    rw [← ENNReal.toReal_one]
    apply ENNReal.toReal_mono one_ne_top
    simpa using (ENNReal.inv_le_inv.mpr hP₀one)
  have hs₁one : s₁ ≤ 1 := by
    dsimp [s₁]
    rw [← ENNReal.toReal_one]
    apply ENNReal.toReal_mono one_ne_top
    simpa using (ENNReal.inv_le_inv.mpr hP₁one)
  have hmidInput' : p * recipBlend θ s₀ s₁ = 1 := by
    simpa only [s₀, s₁] using hmidInput
  have hmidTest' : p' * (1 - recipBlend θ s₀ s₁) = 1 := by
    simpa only [s₀, s₁] using hmidTest
  have hleft : ∀ w ∈ Complex.re ⁻¹' ({(0 : Real)} : Set Real),
      ‖finiteSimpleVectorPairing T ν f (rieszThorinInputExponent p s₀ s₁) g
        (rieszThorinTestExponent p' s₀ s₁) w‖ ≤ A₀.toReal := by
    intro w hw
    have hw0 : w.re = 0 := by simpa using hw
    have hinre : (rieszThorinInputExponent p s₀ s₁ w).re = p * (P₀⁻¹).toReal := by
      simpa only [s₀] using rieszThorinInputExponent_left_re p s₀ s₁ w hw0
    have htestre : (rieszThorinTestExponent p' s₀ s₁ w).re =
        p' * (1 - (P₀⁻¹).toReal) := by
      simpa only [s₀] using rieszThorinTestExponent_left_re p' s₀ s₁ w hw0
    have hbound : ‖finiteSimpleVectorPairing T ν f (rieszThorinInputExponent p s₀ s₁) g
        (rieszThorinTestExponent p' s₀ s₁) w‖ₑ ≤ A₀ := by
      by_cases hPtop : P₀ = ⊤
      · by_cases hPone : P₀ = 1
        · exact finiteSimpleVectorPairing_endpoint_of_infiniteSource_oneTarget
            (P := P₀) (Q := P₀) (Qstar := P₀star) hPtop hPone T A₀ hA₀ hTmeas hT₀
            hp0 hp' f hf g hg (rieszThorinInputExponent p s₀ s₁)
            (rieszThorinTestExponent p' s₀ s₁) w hinre htestre
        · exact finiteSimpleVectorPairing_endpoint_of_infiniteSource_nononeTarget
            (P := P₀) (Q := P₀) (Qstar := P₀star) hPtop hPone T A₀ hA₀ hTmeas hT₀
            hp0 hp' f hf g hg hgunit (rieszThorinInputExponent p s₀ s₁)
            (rieszThorinTestExponent p' s₀ s₁) w hinre htestre
      · have hPzero : P₀ ≠ 0 := ENNReal.HolderConjugate.ne_zero P₀ P₀star
        by_cases hPone : P₀ = 1
        · exact finiteSimpleVectorPairing_endpoint_of_finiteSource_oneTarget
            (P := P₀) (Q := P₀) (Qstar := P₀star) hPzero hPtop hPone T A₀ hA₀ hTmeas hT₀
            hp0 hp' f hf hfunit g hg (rieszThorinInputExponent p s₀ s₁)
            (rieszThorinTestExponent p' s₀ s₁) w hinre htestre
        · exact finiteSimpleVectorPairing_endpoint_of_finiteSource_nononeTarget
            (P := P₀) (Q := P₀) (Qstar := P₀star) hPzero hPtop hPone T A₀ hA₀ hTmeas hT₀
            hp0 hp' f hf hfunit g hg hgunit (rieszThorinInputExponent p s₀ s₁)
            (rieszThorinTestExponent p' s₀ s₁) w hinre htestre
    exact (ENNReal.toReal_le_toReal enorm_ne_top hA₀.ne).mpr hbound
  have hright : ∀ w ∈ Complex.re ⁻¹' ({(1 : Real)} : Set Real),
      ‖finiteSimpleVectorPairing T ν f (rieszThorinInputExponent p s₀ s₁) g
        (rieszThorinTestExponent p' s₀ s₁) w‖ ≤ A₁.toReal := by
    intro w hw
    have hw1 : w.re = 1 := by simpa using hw
    have hinre : (rieszThorinInputExponent p s₀ s₁ w).re = p * (P₁⁻¹).toReal := by
      simpa only [s₁] using rieszThorinInputExponent_right_re p s₀ s₁ w hw1
    have htestre : (rieszThorinTestExponent p' s₀ s₁ w).re =
        p' * (1 - (P₁⁻¹).toReal) := by
      simpa only [s₁] using rieszThorinTestExponent_right_re p' s₀ s₁ w hw1
    have hbound : ‖finiteSimpleVectorPairing T ν f (rieszThorinInputExponent p s₀ s₁) g
        (rieszThorinTestExponent p' s₀ s₁) w‖ₑ ≤ A₁ := by
      by_cases hPtop : P₁ = ⊤
      · by_cases hPone : P₁ = 1
        · exact finiteSimpleVectorPairing_endpoint_of_infiniteSource_oneTarget
            (P := P₁) (Q := P₁) (Qstar := P₁star) hPtop hPone T A₁ hA₁ hTmeas hT₁
            hp0 hp' f hf g hg (rieszThorinInputExponent p s₀ s₁)
            (rieszThorinTestExponent p' s₀ s₁) w hinre htestre
        · exact finiteSimpleVectorPairing_endpoint_of_infiniteSource_nononeTarget
            (P := P₁) (Q := P₁) (Qstar := P₁star) hPtop hPone T A₁ hA₁ hTmeas hT₁
            hp0 hp' f hf g hg hgunit (rieszThorinInputExponent p s₀ s₁)
            (rieszThorinTestExponent p' s₀ s₁) w hinre htestre
      · have hPzero : P₁ ≠ 0 := ENNReal.HolderConjugate.ne_zero P₁ P₁star
        by_cases hPone : P₁ = 1
        · exact finiteSimpleVectorPairing_endpoint_of_finiteSource_oneTarget
            (P := P₁) (Q := P₁) (Qstar := P₁star) hPzero hPtop hPone T A₁ hA₁ hTmeas hT₁
            hp0 hp' f hf hfunit g hg (rieszThorinInputExponent p s₀ s₁)
            (rieszThorinTestExponent p' s₀ s₁) w hinre htestre
        · exact finiteSimpleVectorPairing_endpoint_of_finiteSource_nononeTarget
            (P := P₁) (Q := P₁) (Qstar := P₁star) hPzero hPtop hPone T A₁ hA₁ hTmeas hT₁
            hp0 hp' f hf hfunit g hg hgunit (rieszThorinInputExponent p s₀ s₁)
            (rieszThorinTestExponent p' s₀ s₁) w hinre htestre
    exact (ENNReal.toReal_le_toReal enorm_ne_top hA₁.ne).mpr hbound
  have hthree := finiteSimpleVectorPairing_rieszThorin_threeLines T ν f g
    (le_of_lt hp0) (le_of_lt hp') hs₀ hs₁ hs₀one hs₁one
    ⟨hθ.1.le, hθ.2.le⟩ hleft hright
  have hpennzero : ENNReal.ofReal p ≠ 0 := (ENNReal.ofReal_pos.mpr hp0).ne'
  have hpstarenzero : ENNReal.ofReal p' ≠ 0 := (ENNReal.ofReal_pos.mpr hp').ne'
  have hatomint := finiteSimple_atomPair_integrable_of_endpoint_bound
    (P := P₀) (Q := P₀) (Qstar := P₀star) (pin := ENNReal.ofReal p)
    (qtest := ENNReal.ofReal p') T A₀ hA₀ hTmeas hT₀ f hf hpennzero
    ENNReal.ofReal_ne_top g hg hpstarenzero ENNReal.ofReal_ne_top
  rw [finiteSimpleVectorPairing_eq_integral T f (rieszThorinInputExponent p s₀ s₁)
    g (rieszThorinTestExponent p' s₀ s₁) (θ : Complex) hatomint] at hthree
  rw [finiteSimpleVectorPowerFamily_apply_of_exponent_one f
      (rieszThorinInputExponent p s₀ s₁) (θ : Complex)
      (rieszThorinInputExponent_theta p θ s₀ s₁ hmidInput'),
    finiteSimpleVectorPowerFamily_apply_of_exponent_one g
      (rieszThorinTestExponent p' s₀ s₁) (θ : Complex)
      (rieszThorinTestExponent_theta p' θ s₀ s₁ hmidTest')] at hthree
  exact hthree

/-- The real conjugate exponent supplies the complementary test moment once
the input reciprocal moment is normalized. -/
theorem conjugate_test_moment_of_input_moment
    {p θ s₀ s₁ : Real} (hp : 1 < p)
    (hinput : p * recipBlend θ s₀ s₁ = 1) :
    p.conjExponent * (1 - recipBlend θ s₀ s₁) = 1 := by
  rw [Real.conjExponent]
  have hp0 : p ≠ 0 := ne_of_gt (lt_trans (by norm_num) hp)
  have hpminus : p - 1 ≠ 0 := ne_of_gt (sub_pos.mpr hp)
  have hblend : recipBlend θ s₀ s₁ = p⁻¹ := by
    rw [← one_div]
    apply (eq_div_iff hp0).mpr
    simpa [mul_comm] using hinput
  rw [hblend]
  field_simp

/-- Standard finite-simple diagonal pairing form, using the usual real
conjugate exponent for the test function. -/
theorem finiteSimpleRieszThorin_diagonal_unit_pairing_conjugate
    {α β E : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} {ν : Measure β}
    {P₀ P₁ P₀star P₁star : ENNReal}
    [ENNReal.HolderConjugate P₀ P₀star]
    [ENNReal.HolderConjugate P₁ P₁star]
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex))
    {A₀ A₁ : ENNReal} (hA₀ : A₀ < ⊤) (hA₁ : A₁ < ⊤)
    (hTmeas : ∀ u, AEStronglyMeasurable (T u) ν)
    (hT₀ : ∀ u, eLpNorm (T u) P₀ ν ≤ A₀ * eLpNorm (u : α → E) P₀ μ)
    (hT₁ : ∀ u, eLpNorm (T u) P₁ ν ≤ A₁ * eLpNorm (u : α → E) P₁ μ)
    {p θ : Real} (hp : 1 < p) (hθ : θ ∈ Set.Ioo (0 : Real) 1)
    (hmidInput : p * recipBlend θ (P₀⁻¹).toReal (P₁⁻¹).toReal = 1)
    (f : SimpleFunc α E) (hf : MemLp (f : α → E) (ENNReal.ofReal p) μ)
    (hfunit : eLpNorm (f : α → E) (ENNReal.ofReal p) μ ≤ 1)
    (g : SimpleFunc β Complex)
    (hg : MemLp (g : β → Complex) (ENNReal.ofReal p.conjExponent) ν)
    (hgunit : eLpNorm (g : β → Complex) (ENNReal.ofReal p.conjExponent) ν ≤ 1) :
    ‖∫ y, T f y * g y ∂ν‖ ≤ A₀.toReal ^ (1 - θ) * A₁.toReal ^ θ := by
  exact finiteSimpleRieszThorin_diagonal_unit_pairing
    (P₀ := P₀) (P₁ := P₁) (P₀star := P₀star) (P₁star := P₁star)
    (p := p) (p' := p.conjExponent) (θ := θ)
    T hA₀ hA₁ hTmeas hT₀ hT₁ hp
    (by rw [Real.conjExponent]; positivity) hθ hmidInput
    (conjugate_test_moment_of_input_moment hp hmidInput)
    f hf hfunit g hg hgunit

/-- Honest sharp diagonal Riesz--Thorin estimate on finite simple source
functions.  This has literal endpoint `eLpNorm` hypotheses, no analytic
datum, and concludes the intermediate `eLpNorm` estimate itself. -/
theorem finiteSimpleRieszThorin_diagonal_eLpNorm
    {α β E : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} {ν : Measure β}
    {P₀ P₁ P₀star P₁star : ENNReal}
    [ENNReal.HolderConjugate P₀ P₀star]
    [ENNReal.HolderConjugate P₁ P₁star]
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex))
    {A₀ A₁ : ENNReal} (hA₀ : A₀ < ⊤) (hA₁ : A₁ < ⊤)
    (hTmeas : ∀ u, AEStronglyMeasurable (T u) ν)
    (hT₀ : ∀ u, eLpNorm (T u) P₀ ν ≤ A₀ * eLpNorm (u : α → E) P₀ μ)
    (hT₁ : ∀ u, eLpNorm (T u) P₁ ν ≤ A₁ * eLpNorm (u : α → E) P₁ μ)
    {p θ : Real} (hp : 1 < p) (hθ : θ ∈ Set.Ioo (0 : Real) 1)
    (hmidInput : p * recipBlend θ (P₀⁻¹).toReal (P₁⁻¹).toReal = 1)
    (f : SimpleFunc α E) (hf : MemLp (f : α → E) (ENNReal.ofReal p) μ)
    (hfunit : eLpNorm (f : α → E) (ENNReal.ofReal p) μ ≤ 1) :
    eLpNorm (T f) (ENNReal.ofReal p) ν ≤ A₀ ^ (1 - θ) * A₁ ^ θ := by
  let K : ENNReal := A₀ ^ (1 - θ) * A₁ ^ θ
  have hp0 : 0 < p := lt_trans (by norm_num) hp
  have hpenn0 : ENNReal.ofReal p ≠ 0 := (ENNReal.ofReal_pos.mpr hp0).ne'
  have hf₀ : MemLp (f : α → E) P₀ μ :=
    finiteSimple_memLp_of_memLp_any_exponent hpenn0 ENNReal.ofReal_ne_top
      (ENNReal.HolderConjugate.ne_zero P₀ P₀star) f hf
  have hf₁ : MemLp (f : α → E) P₁ μ :=
    finiteSimple_memLp_of_memLp_any_exponent hpenn0 ENNReal.ofReal_ne_top
      (ENNReal.HolderConjugate.ne_zero P₁ P₁star) f hf
  have hTf₀bound : eLpNorm (T f) P₀ ν ≤ A₀ * eLpNorm (f : α → E) P₀ μ := hT₀ f
  have hTf₁bound : eLpNorm (T f) P₁ ν ≤ A₁ * eLpNorm (f : α → E) P₁ μ := hT₁ f
  have hTf₀ : MemLp (T f) P₀ ν :=
    memLp_of_aestronglyMeasurable_of_eLpNorm_le (hTmeas f) hTf₀bound
      (ENNReal.mul_lt_top hA₀ hf₀.eLpNorm_lt_top)
  have hTf₁ : MemLp (T f) P₁ ν :=
    memLp_of_aestronglyMeasurable_of_eLpNorm_le (hTmeas f) hTf₁bound
      (ENNReal.mul_lt_top hA₁ hf₁.eLpNorm_lt_top)
  have hrecip : (P₀ / ENNReal.ofReal (1 - θ))⁻¹ +
      (P₁ / ENNReal.ofReal θ)⁻¹ = (ENNReal.ofReal p)⁻¹ :=
    reciprocal_power_interpolation_identity
      (P₀ := P₀) (P₁ := P₁) (P₀star := P₀star) (P₁star := P₁star)
      hp0 hθ.1 hθ.2 hmidInput
  have hTf : MemLp (T f) (ENNReal.ofReal p) ν :=
    memLp_of_power_interpolation hθ.1 hθ.2 hrecip hTf₀ hTf₁
  have hKtop : K < ⊤ := by
    dsimp [K]
    exact ENNReal.mul_lt_top
      (ENNReal.rpow_lt_top_of_nonneg (sub_nonneg.mpr hθ.2.le) hA₀.ne)
      (ENNReal.rpow_lt_top_of_nonneg hθ.1.le hA₁.ne)
  apply eLpNorm_le_of_raw_simpleFunc_unit_test_pairing_enorm_bound hp hKtop hTf
  intro g hg hgunit
  have hpair := finiteSimpleRieszThorin_diagonal_unit_pairing_conjugate
    (P₀ := P₀) (P₁ := P₁) (P₀star := P₀star) (P₁star := P₁star)
    T hA₀ hA₁ hTmeas hT₀ hT₁ hp hθ hmidInput f hf hfunit g hg hgunit
  change ‖∫ x, T f x * g x ∂ν‖ₑ ≤ A₀ ^ (1 - θ) * A₁ ^ θ
  rw [← ofReal_norm,
    ennreal_weighted_geometricMean_eq_ofReal hA₀ hA₁ hθ.1.le hθ.2.le]
  exact ENNReal.ofReal_le_ofReal hpair

/-- Radial normalization of a finite simple vector-valued input places it in
the closed unit ball of its finite `Lp` space. -/
theorem finiteSimpleVector_eLpNorm_reciprocal_smul_le_one
    {α E : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    [NormedSpace Complex E] {μ : Measure α} {q : ENNReal}
    (f : SimpleFunc α E) (hf : MemLp (f : α → E) q μ) :
    eLpNorm
        (((((eLpNorm (f : α → E) q μ).toReal)⁻¹ : Complex) • f :
          SimpleFunc α E) : α → E) q μ ≤ 1 := by
  let N : ENNReal := eLpNorm (f : α → E) q μ
  let c : Complex := (N.toReal)⁻¹
  change eLpNorm ((c • f : SimpleFunc α E) : α → E) q μ ≤ 1
  have hsmul : eLpNorm ((c • f : SimpleFunc α E) : α → E) q μ =
      ‖c‖ₑ * eLpNorm (f : α → E) q μ := by
    simpa only [SimpleFunc.coe_smul] using
      (eLpNorm_const_smul c (f : α → E) q μ)
  rw [hsmul]
  calc
    ‖c‖ₑ * eLpNorm (f : α → E) q μ =
        ENNReal.ofReal (N.toReal⁻¹) * N := by
      by_cases hN : N.toReal = 0
      · simp [c, N, hN]
      · rw [show c = ((N.toReal : Complex)⁻¹) by rfl,
          enorm_inv (Complex.ofReal_ne_zero.mpr hN)]
        have hpos : 0 < N.toReal :=
          lt_of_le_of_ne ENNReal.toReal_nonneg (Ne.symm hN)
        rw [ENNReal.ofReal_inv_of_pos hpos]
        congr 1
        rw [← ofReal_norm]
        simp [Complex.norm_real, abs_of_nonneg ENNReal.toReal_nonneg]
    _ ≤ (ENNReal.ofReal N.toReal)⁻¹ * N :=
      mul_le_mul_of_nonneg_right ENNReal.ofReal_inv_le zero_le
    _ = N⁻¹ * N := by rw [ENNReal.ofReal_toReal hf.eLpNorm_ne_top]
    _ ≤ 1 := ENNReal.inv_mul_le_one N

/-- Homogeneous sharp diagonal Riesz--Thorin estimate on finite simple
source functions. -/
theorem finiteSimpleRieszThorin_diagonal_eLpNorm_homogeneous
    {α β E : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} {ν : Measure β}
    {P₀ P₁ P₀star P₁star : ENNReal}
    [ENNReal.HolderConjugate P₀ P₀star]
    [ENNReal.HolderConjugate P₁ P₁star]
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex))
    {A₀ A₁ : ENNReal} (hA₀ : A₀ < ⊤) (hA₁ : A₁ < ⊤)
    (hTmeas : ∀ u, AEStronglyMeasurable (T u) ν)
    (hT₀ : ∀ u, eLpNorm (T u) P₀ ν ≤ A₀ * eLpNorm (u : α → E) P₀ μ)
    (hT₁ : ∀ u, eLpNorm (T u) P₁ ν ≤ A₁ * eLpNorm (u : α → E) P₁ μ)
    {p θ : Real} (hp : 1 < p) (hθ : θ ∈ Set.Ioo (0 : Real) 1)
    (hmidInput : p * recipBlend θ (P₀⁻¹).toReal (P₁⁻¹).toReal = 1)
    (f : SimpleFunc α E) (hf : MemLp (f : α → E) (ENNReal.ofReal p) μ) :
    eLpNorm (T f) (ENNReal.ofReal p) ν ≤
      (A₀ ^ (1 - θ) * A₁ ^ θ) * eLpNorm (f : α → E) (ENNReal.ofReal p) μ := by
  let N : ENNReal := eLpNorm (f : α → E) (ENNReal.ofReal p) μ
  let K : ENNReal := A₀ ^ (1 - θ) * A₁ ^ θ
  have hp0 : 0 < p := lt_trans (by norm_num) hp
  have hpenn0 : ENNReal.ofReal p ≠ 0 := (ENNReal.ofReal_pos.mpr hp0).ne'
  have hNtop : N ≠ ⊤ := by
    exact hf.eLpNorm_ne_top
  change eLpNorm (T f) (ENNReal.ofReal p) ν ≤ K * N
  by_cases hNzero : N = 0
  · have hfae : (f : α → E) =ᵐ[μ] 0 :=
      (eLpNorm_eq_zero_iff hf.1 hpenn0).mp hNzero
    have hfP₀zero : eLpNorm (f : α → E) P₀ μ = 0 := by
      rw [eLpNorm_congr_ae hfae]
      exact eLpNorm_zero
    have hTfP₀zero : eLpNorm (T f) P₀ ν = 0 := by
      apply le_zero_iff.mp
      simpa [hfP₀zero] using hT₀ f
    have hTfae : T f =ᵐ[ν] 0 :=
      (eLpNorm_eq_zero_iff (hTmeas f)
        (ENNReal.HolderConjugate.ne_zero P₀ P₀star)).mp hTfP₀zero
    have hTfzero : eLpNorm (T f) (ENNReal.ofReal p) ν = 0 := by
      rw [eLpNorm_congr_ae hTfae]
      exact eLpNorm_zero
    rw [hTfzero, hNzero, mul_zero]
  · have hNpos : 0 < N := pos_iff_ne_zero.mpr hNzero
    have hNrealpos : 0 < N.toReal := ENNReal.toReal_pos hNzero hNtop
    let c : Complex := ((N.toReal)⁻¹ : Real)
    have hcnorm : ‖c‖ₑ = N⁻¹ := by
      dsimp [c]
      rw [← ofReal_norm, Complex.norm_real,
        Real.norm_of_nonneg (inv_nonneg.mpr ENNReal.toReal_nonneg),
        ENNReal.ofReal_inv_of_pos hNrealpos,
        ENNReal.ofReal_toReal hNtop]
    have hfc : MemLp ((c • f : SimpleFunc α E) : α → E) (ENNReal.ofReal p) μ := by
      simpa only [SimpleFunc.coe_smul] using hf.const_smul c
    have hfcunit : eLpNorm ((c • f : SimpleFunc α E) : α → E)
        (ENNReal.ofReal p) μ ≤ 1 := by
      rw [SimpleFunc.coe_smul, eLpNorm_const_smul, hcnorm]
      exact le_of_eq (ENNReal.inv_mul_cancel hNzero hNtop)
    have hscaled := finiteSimpleRieszThorin_diagonal_eLpNorm
      (P₀ := P₀) (P₁ := P₁) (P₀star := P₀star) (P₁star := P₁star)
      T hA₀ hA₁ hTmeas hT₀ hT₁ hp hθ hmidInput (c • f) hfc hfcunit
    have hscaled' : N⁻¹ * eLpNorm (T f) (ENNReal.ofReal p) ν ≤ K := by
      simpa only [K, T.map_smul, eLpNorm_const_smul, hcnorm] using hscaled
    calc
      eLpNorm (T f) (ENNReal.ofReal p) ν =
          N * (N⁻¹ * eLpNorm (T f) (ENNReal.ofReal p) ν) := by
            rw [← mul_assoc, ENNReal.mul_inv_cancel hNzero hNtop, one_mul]
      _ ≤ N * K := mul_le_mul_right hscaled' N
      _ = K * N := mul_comm _ _

/-! ### Completion of a raw finite-simple-function core to `Lp`

The sharp interpolation argument above is formulated on raw `SimpleFunc`s.
This section performs the necessary quotient and density step without adding
an a.e.-compatibility hypothesis: the literal finite-exponent estimate itself
forces that compatibility. -/

section RawLpExtension

variable {α β E : Type*}
variable [MeasurableSpace α] [MeasurableSpace β]
variable [NormedAddCommGroup E] [NormedSpace Complex E]
variable {μ : Measure α} {ν : Measure β} {p C : ENNReal}
variable [Fact (1 ≤ p)]

local instance : SMul Complex (Lp.simpleFunc E p μ) := Lp.simpleFunc.smul
local instance : Module Complex (Lp.simpleFunc E p μ) := Lp.simpleFunc.module
local instance : IsBoundedSMul Complex (Lp.simpleFunc E p μ) :=
  Lp.simpleFunc.isBoundedSMul
local instance : NormedSpace Complex (Lp.simpleFunc E p μ) :=
  Lp.simpleFunc.normedSpace

/-- A raw finite-simple-function estimate supplies target `MemLp`. -/
theorem rawCore_memLp
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex))
    (hC : C < ∞) (hTmeas : ∀ f, AEStronglyMeasurable (T f) ν)
    (hbound : ∀ (f : SimpleFunc α E) (hf : MemLp (f : α → E) p μ),
      eLpNorm (T f) p ν ≤ C * eLpNorm (f : α → E) p μ)
    {f : SimpleFunc α E} (hf : MemLp (f : α → E) p μ) :
    MemLp (T f) p ν := by
  refine ⟨hTmeas f, lt_of_le_of_lt (hbound f hf) ?_⟩
  exact ENNReal.mul_lt_top hC hf.eLpNorm_lt_top

/-- A raw finite-exponent `eLpNorm` estimate forces the operator to respect
almost-everywhere equality on simple inputs. -/
theorem rawCore_ae_compatible
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex))
    (hp0 : p ≠ 0) (hTmeas : ∀ f, AEStronglyMeasurable (T f) ν)
    (hbound : ∀ (f : SimpleFunc α E) (hf : MemLp (f : α → E) p μ),
      eLpNorm (T f) p ν ≤ C * eLpNorm (f : α → E) p μ)
    {f g : SimpleFunc α E} (hf : MemLp (f : α → E) p μ)
    (hg : MemLp (g : α → E) p μ) (hfg : (f : α → E) =ᵐ[μ] g) :
    T f =ᵐ[ν] T g := by
  have hsub : ((f - g : SimpleFunc α E) : α → E) =ᵐ[μ] 0 := by
    filter_upwards [hfg] with x hx
    simpa using sub_eq_zero.mpr hx
  have hsubmem : MemLp ((f - g : SimpleFunc α E) : α → E) p μ := by
    simpa only [SimpleFunc.coe_sub] using hf.sub hg
  have hinzero : eLpNorm ((f - g : SimpleFunc α E) : α → E) p μ = 0 :=
    eLpNorm_eq_zero_of_ae_zero hsub
  have houtle : eLpNorm (T (f - g)) p ν ≤ 0 := by
    calc
      eLpNorm (T (f - g)) p ν ≤
          C * eLpNorm ((f - g : SimpleFunc α E) : α → E) p μ :=
        hbound (f - g) hsubmem
      _ = 0 := by rw [hinzero, mul_zero]
  have houtzero : eLpNorm (T (f - g)) p ν = 0 := le_antisymm houtle bot_le
  have hdiff : T (f - g) =ᵐ[ν] 0 :=
    (eLpNorm_eq_zero_iff (hTmeas _) hp0).mp houtzero
  filter_upwards [hdiff] with y hy
  have hy' : T f y - T g y = 0 := by
    simpa only [T.map_sub, Pi.sub_apply, Pi.zero_apply] using hy
  exact sub_eq_zero.mp hy'

/-- Descend a raw simple-function operator to the simple subspace of `Lp`. -/
noncomputable def rawSimpleCore
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex))
    (hp0 : p ≠ 0) (hC : C < ∞)
    (hTmeas : ∀ f, AEStronglyMeasurable (T f) ν)
    (hbound : ∀ (f : SimpleFunc α E) (hf : MemLp (f : α → E) p μ),
      eLpNorm (T f) p ν ≤ C * eLpNorm (f : α → E) p μ) :
    Lp.simpleFunc E p μ →ₗ[Complex] Lp Complex p ν where
  toFun := fun u =>
    (rawCore_memLp T hC hTmeas hbound (Lp.simpleFunc.memLp u)).toLp
      (T (Lp.simpleFunc.toSimpleFunc u))
  map_add' := by
    intro u v
    let hsum : MemLp (T (Lp.simpleFunc.toSimpleFunc (u + v))) p ν :=
      rawCore_memLp T hC hTmeas hbound (Lp.simpleFunc.memLp (u + v))
    let hu : MemLp (T (Lp.simpleFunc.toSimpleFunc u)) p ν :=
      rawCore_memLp T hC hTmeas hbound (Lp.simpleFunc.memLp u)
    let hv : MemLp (T (Lp.simpleFunc.toSimpleFunc v)) p ν :=
      rawCore_memLp T hC hTmeas hbound (Lp.simpleFunc.memLp v)
    change hsum.toLp (T (Lp.simpleFunc.toSimpleFunc (u + v))) =
      hu.toLp (T (Lp.simpleFunc.toSimpleFunc u)) +
        hv.toLp (T (Lp.simpleFunc.toSimpleFunc v))
    rw [← MemLp.toLp_add hu hv]
    apply MemLp.toLp_congr hsum (hu.add hv)
    calc
      T (Lp.simpleFunc.toSimpleFunc (u + v)) =ᵐ[ν]
          T (Lp.simpleFunc.toSimpleFunc u + Lp.simpleFunc.toSimpleFunc v) :=
        rawCore_ae_compatible T hp0 hTmeas hbound
          (Lp.simpleFunc.memLp (u + v))
          (by
            simpa only [SimpleFunc.coe_add] using
              (Lp.simpleFunc.memLp u).add (Lp.simpleFunc.memLp v))
          (Lp.simpleFunc.add_toSimpleFunc u v)
      _ =ᵐ[ν] T (Lp.simpleFunc.toSimpleFunc u) + T (Lp.simpleFunc.toSimpleFunc v) :=
        Filter.EventuallyEq.of_eq (T.map_add _ _)
  map_smul' := by
    intro c u
    let hcu : MemLp (T (Lp.simpleFunc.toSimpleFunc (c • u))) p ν :=
      rawCore_memLp T hC hTmeas hbound (Lp.simpleFunc.memLp (c • u))
    let hu : MemLp (T (Lp.simpleFunc.toSimpleFunc u)) p ν :=
      rawCore_memLp T hC hTmeas hbound (Lp.simpleFunc.memLp u)
    change hcu.toLp (T (Lp.simpleFunc.toSimpleFunc (c • u))) =
      c • hu.toLp (T (Lp.simpleFunc.toSimpleFunc u))
    rw [← MemLp.toLp_const_smul c hu]
    apply MemLp.toLp_congr hcu (hu.const_smul c)
    calc
      T (Lp.simpleFunc.toSimpleFunc (c • u)) =ᵐ[ν]
          T (c • Lp.simpleFunc.toSimpleFunc u) :=
        rawCore_ae_compatible T hp0 hTmeas hbound
          (Lp.simpleFunc.memLp (c • u))
          (by
            simpa only [SimpleFunc.coe_smul] using
              (Lp.simpleFunc.memLp u).const_smul c)
          (Lp.simpleFunc.smul_toSimpleFunc c u)
      _ =ᵐ[ν] c • T (Lp.simpleFunc.toSimpleFunc u) :=
        Filter.EventuallyEq.of_eq (T.map_smul c _)

/-- On a raw simple input, `rawSimpleCore` agrees with `T` in the `Lp`
quotient. -/
theorem rawSimpleCore_apply_toLp
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex))
    (hp0 : p ≠ 0) (hC : C < ∞)
    (hTmeas : ∀ f, AEStronglyMeasurable (T f) ν)
    (hbound : ∀ (f : SimpleFunc α E) (hf : MemLp (f : α → E) p μ),
      eLpNorm (T f) p ν ≤ C * eLpNorm (f : α → E) p μ)
    (f : SimpleFunc α E) (hf : MemLp (f : α → E) p μ) :
    rawSimpleCore T hp0 hC hTmeas hbound (SimpleFunc.toLp f hf) =
      (rawCore_memLp T hC hTmeas hbound hf).toLp (T f) := by
  let hleft : MemLp (T (Lp.simpleFunc.toSimpleFunc (SimpleFunc.toLp f hf))) p ν :=
    rawCore_memLp T hC hTmeas hbound
      (Lp.simpleFunc.memLp (SimpleFunc.toLp f hf))
  let hright : MemLp (T f) p ν := rawCore_memLp T hC hTmeas hbound hf
  change hleft.toLp (T (Lp.simpleFunc.toSimpleFunc (SimpleFunc.toLp f hf))) =
    hright.toLp (T f)
  apply MemLp.toLp_congr hleft hright
  apply rawCore_ae_compatible T hp0 hTmeas hbound
  · exact Lp.simpleFunc.memLp (SimpleFunc.toLp f hf)
  · exact hf
  · exact Lp.simpleFunc.toSimpleFunc_toLp f hf

/-- The raw `eLpNorm` estimate becomes an ordinary norm bound on the descended
simple `Lp` core. -/
theorem norm_rawSimpleCore_apply_le
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex))
    (hp0 : p ≠ 0) (hC : C < ∞)
    (hTmeas : ∀ f, AEStronglyMeasurable (T f) ν)
    (hbound : ∀ (f : SimpleFunc α E) (hf : MemLp (f : α → E) p μ),
      eLpNorm (T f) p ν ≤ C * eLpNorm (f : α → E) p μ)
    (u : Lp.simpleFunc E p μ) :
    ‖rawSimpleCore T hp0 hC hTmeas hbound u‖ ≤ C.toReal * ‖u‖ := by
  let f : SimpleFunc α E := Lp.simpleFunc.toSimpleFunc u
  let hf : MemLp (f : α → E) p μ := Lp.simpleFunc.memLp u
  let hTf : MemLp (T f) p ν := rawCore_memLp T hC hTmeas hbound hf
  have hboundf := hbound f hf
  have hright : C * eLpNorm (f : α → E) p μ ≠ ∞ :=
    (ENNReal.mul_lt_top hC hf.eLpNorm_lt_top).ne
  have hreal : (eLpNorm (T f) p ν).toReal ≤
      (C * eLpNorm (f : α → E) p μ).toReal :=
    (ENNReal.toReal_le_toReal hTf.eLpNorm_ne_top hright).mpr hboundf
  change ‖hTf.toLp (T f)‖ ≤ C.toReal * ‖u‖
  rw [Lp.norm_toLp, Lp.simpleFunc.norm_toSimpleFunc]
  simpa only [ENNReal.toReal_mul] using hreal

/-- The dense embedding of finite-exponent simple `Lp` functions. -/
noncomputable def rawCoreEmbedding :
    Lp.simpleFunc E p μ →ₗ[Complex] Lp E p μ :=
  (Lp.simpleFunc.coeToLp (p := p) (μ := μ) α E Complex).toLinearMap

/-- The bounded `Lp` extension of a raw simple-function operator after its
same-exponent `eLpNorm` estimate has been established. -/
noncomputable def rawLpExtension
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex))
    (hp0 : p ≠ 0) (hC : C < ∞)
    (hTmeas : ∀ f, AEStronglyMeasurable (T f) ν)
    (hbound : ∀ (f : SimpleFunc α E) (hf : MemLp (f : α → E) p μ),
      eLpNorm (T f) p ν ≤ C * eLpNorm (f : α → E) p μ) :
    Lp E p μ →L[Complex] Lp Complex p ν :=
  (rawSimpleCore T hp0 hC hTmeas hbound).extendOfNorm rawCoreEmbedding

/-- The `Lp` extension agrees with the raw operator on integrable simple
functions. -/
theorem rawLpExtension_apply_toLp
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex))
    (hp0 : p ≠ 0) (hpTop : p ≠ ∞) (hC : C < ∞)
    (hTmeas : ∀ f, AEStronglyMeasurable (T f) ν)
    (hbound : ∀ (f : SimpleFunc α E) (hf : MemLp (f : α → E) p μ),
      eLpNorm (T f) p ν ≤ C * eLpNorm (f : α → E) p μ)
    (f : SimpleFunc α E) (hf : MemLp (f : α → E) p μ) :
    rawLpExtension T hp0 hC hTmeas hbound (SimpleFunc.toLp f hf) =
      (rawCore_memLp T hC hTmeas hbound hf).toLp (T f) := by
  let S := rawSimpleCore T hp0 hC hTmeas hbound
  let e : Lp.simpleFunc E p μ →ₗ[Complex] Lp E p μ := rawCoreEmbedding
  have hdense : DenseRange e := by
    change DenseRange ((↑) : Lp.simpleFunc E p μ → Lp E p μ)
    exact Lp.simpleFunc.denseRange hpTop
  have hnorm : ∀ u, ‖S u‖ ≤ C.toReal * ‖e u‖ := by
    change ∀ u, ‖S u‖ ≤ C.toReal * ‖(u : Lp E p μ)‖
    intro u
    exact norm_rawSimpleCore_apply_le T hp0 hC hTmeas hbound u
  change S.extendOfNorm e (e (SimpleFunc.toLp f hf)) =
    (rawCore_memLp T hC hTmeas hbound hf).toLp (T f)
  rw [LinearMap.extendOfNorm_eq hdense ⟨C.toReal, hnorm⟩]
  exact rawSimpleCore_apply_toLp T hp0 hC hTmeas hbound f hf

/-- Pointwise norm estimate for the bounded raw-core extension. -/
theorem norm_rawLpExtension_apply_le
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex))
    (hp0 : p ≠ 0) (hpTop : p ≠ ∞) (hC : C < ∞)
    (hTmeas : ∀ f, AEStronglyMeasurable (T f) ν)
    (hbound : ∀ (f : SimpleFunc α E) (hf : MemLp (f : α → E) p μ),
      eLpNorm (T f) p ν ≤ C * eLpNorm (f : α → E) p μ)
    (u : Lp E p μ) :
    ‖rawLpExtension T hp0 hC hTmeas hbound u‖ ≤ C.toReal * ‖u‖ := by
  let S := rawSimpleCore T hp0 hC hTmeas hbound
  let e : Lp.simpleFunc E p μ →ₗ[Complex] Lp E p μ := rawCoreEmbedding
  have hdense : DenseRange e := by
    change DenseRange ((↑) : Lp.simpleFunc E p μ → Lp E p μ)
    exact Lp.simpleFunc.denseRange hpTop
  have hnorm : ∀ u, ‖S u‖ ≤ C.toReal * ‖e u‖ := by
    change ∀ u, ‖S u‖ ≤ C.toReal * ‖(u : Lp E p μ)‖
    intro u
    exact norm_rawSimpleCore_apply_le T hp0 hC hTmeas hbound u
  change ‖S.extendOfNorm e u‖ ≤ C.toReal * ‖u‖
  exact LinearMap.norm_extendOfNorm_apply_le hdense C.toReal hnorm u

/-- Operator-norm estimate for the bounded raw-core extension. -/
theorem opNorm_rawLpExtension_le
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex))
    (hp0 : p ≠ 0) (hpTop : p ≠ ∞) (hC : C < ∞)
    (hTmeas : ∀ f, AEStronglyMeasurable (T f) ν)
    (hbound : ∀ (f : SimpleFunc α E) (hf : MemLp (f : α → E) p μ),
      eLpNorm (T f) p ν ≤ C * eLpNorm (f : α → E) p μ) :
    ‖rawLpExtension T hp0 hC hTmeas hbound‖ ≤ C.toReal := by
  let S := rawSimpleCore T hp0 hC hTmeas hbound
  let e : Lp.simpleFunc E p μ →ₗ[Complex] Lp E p μ := rawCoreEmbedding
  have hdense : DenseRange e := by
    change DenseRange ((↑) : Lp.simpleFunc E p μ → Lp E p μ)
    exact Lp.simpleFunc.denseRange hpTop
  have hnorm : ∀ u, ‖S u‖ ≤ C.toReal * ‖e u‖ := by
    change ∀ u, ‖S u‖ ≤ C.toReal * ‖(u : Lp E p μ)‖
    intro u
    exact norm_rawSimpleCore_apply_le T hp0 hC hTmeas hbound u
  change ‖S.extendOfNorm e‖ ≤ C.toReal
  apply LinearMap.opNorm_extendOfNorm_le hdense ENNReal.toReal_nonneg hnorm

/-- Completion from a direct same-exponent simple-core estimate.  Once the
analytic argument establishes `hmid`, no extra a.e.-compatibility hypothesis
is needed to obtain an operator on all of finite-exponent `Lp`. -/
theorem exists_rawLpExtension_of_midpoint
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex))
    (hp0 : p ≠ 0) (hpTop : p ≠ ∞) (hC : C < ∞)
    (hTmeas : ∀ f, AEStronglyMeasurable (T f) ν)
    (hmid : ∀ (f : SimpleFunc α E) (hf : MemLp (f : α → E) p μ),
      eLpNorm (T f) p ν ≤ C * eLpNorm (f : α → E) p μ) :
    ∃ S : Lp E p μ →L[Complex] Lp Complex p ν,
      ‖S‖ ≤ C.toReal ∧
      ∀ (f : SimpleFunc α E) (hf : MemLp (f : α → E) p μ),
        MemLp (T f) p ν ∧ S (hf.toLp f) =ᵐ[ν] T f := by
  refine ⟨rawLpExtension T hp0 hC hTmeas hmid,
    opNorm_rawLpExtension_le T hp0 hpTop hC hTmeas hmid, ?_⟩
  intro f hf
  let hTf : MemLp (T f) p ν := rawCore_memLp T hC hTmeas hmid hf
  refine ⟨hTf, ?_⟩
  rw [show hf.toLp f = (SimpleFunc.toLp f hf : Lp E p μ) by rfl,
    rawLpExtension_apply_toLp T hp0 hpTop hC hTmeas hmid f hf]
  exact MemLp.coeFn_toLp hTf

end RawLpExtension

/-- Convert the public ENNReal reciprocal-exponent relation to the real
midpoint identity used by the finite-simple analytic core. -/
theorem real_midpoint_of_ennreal_reciprocal
    {P₀ P₁ P₀star P₁star : ENNReal}
    [ENNReal.HolderConjugate P₀ P₀star]
    [ENNReal.HolderConjugate P₁ P₁star]
    {p θ : Real} (hp : 0 < p) (hθ : θ ∈ Set.Ioo (0 : Real) 1)
    (hrecip : (ENNReal.ofReal p)⁻¹ =
      ENNReal.ofReal (1 - θ) * P₀⁻¹ + ENNReal.ofReal θ * P₁⁻¹) :
    p * recipBlend θ (P₀⁻¹).toReal (P₁⁻¹).toReal = 1 := by
  have hP₀0 : P₀ ≠ 0 := ENNReal.HolderConjugate.ne_zero P₀ P₀star
  have hP₁0 : P₁ ≠ 0 := ENNReal.HolderConjugate.ne_zero P₁ P₁star
  have hterm₀top : ENNReal.ofReal (1 - θ) * P₀⁻¹ ≠ ∞ :=
    ENNReal.mul_ne_top ENNReal.ofReal_ne_top (ENNReal.inv_ne_top.mpr hP₀0)
  have hterm₁top : ENNReal.ofReal θ * P₁⁻¹ ≠ ∞ :=
    ENNReal.mul_ne_top ENNReal.ofReal_ne_top (ENNReal.inv_ne_top.mpr hP₁0)
  have hreal := congrArg ENNReal.toReal hrecip
  rw [ENNReal.toReal_inv, ENNReal.toReal_ofReal hp.le,
    ENNReal.toReal_add hterm₀top hterm₁top,
    ENNReal.toReal_mul, ENNReal.toReal_mul,
    ENNReal.toReal_ofReal (sub_nonneg.mpr hθ.2.le),
    ENNReal.toReal_ofReal hθ.1.le] at hreal
  have hblend : recipBlend θ (P₀⁻¹).toReal (P₁⁻¹).toReal = p⁻¹ := by
    simpa [recipBlend] using hreal.symm
  rw [hblend]
  exact mul_inv_cancel₀ hp.ne'

/-- The honest diagonal Riesz--Thorin theorem at a finite interior exponent.

It assumes only literal endpoint `eLpNorm` estimates for a raw
simple-function operator and constructs the sharp bounded extension to the
intermediate `Lp` space.  The endpoint exponents may include `∞`; their
reciprocal contribution in `hmidInput` is then zero. -/
theorem rieszThorin
    {α β E : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} {ν : Measure β}
    {P₀ P₁ P₀star P₁star : ENNReal}
    [ENNReal.HolderConjugate P₀ P₀star]
    [ENNReal.HolderConjugate P₁ P₁star]
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex))
    {A₀ A₁ : ENNReal} (hA₀ : A₀ < ∞) (hA₁ : A₁ < ∞)
    (hTmeas : ∀ u, AEStronglyMeasurable (T u) ν)
    (hT₀ : ∀ u, eLpNorm (T u) P₀ ν ≤ A₀ * eLpNorm (u : α → E) P₀ μ)
    (hT₁ : ∀ u, eLpNorm (T u) P₁ ν ≤ A₁ * eLpNorm (u : α → E) P₁ μ)
    {p θ : Real} (hp : 1 < p) (hθ : θ ∈ Set.Ioo (0 : Real) 1)
    (hrecip : (ENNReal.ofReal p)⁻¹ =
      ENNReal.ofReal (1 - θ) * P₀⁻¹ + ENNReal.ofReal θ * P₁⁻¹)
    [Fact (1 ≤ ENNReal.ofReal p)] :
    ∃ S : Lp E (ENNReal.ofReal p) μ →L[Complex] Lp Complex (ENNReal.ofReal p) ν,
      ‖S‖ ≤ (A₀ ^ (1 - θ) * A₁ ^ θ).toReal ∧
      ∀ (f : SimpleFunc α E) (hf : MemLp (f : α → E) (ENNReal.ofReal p) μ),
        MemLp (T f) (ENNReal.ofReal p) ν ∧ S (hf.toLp f) =ᵐ[ν] T f := by
  let C : ENNReal := A₀ ^ (1 - θ) * A₁ ^ θ
  have hp0 : 0 < p := lt_trans (by norm_num) hp
  have hpenn0 : ENNReal.ofReal p ≠ 0 := (ENNReal.ofReal_pos.mpr hp0).ne'
  have hmidInput : p * recipBlend θ (P₀⁻¹).toReal (P₁⁻¹).toReal = 1 :=
    real_midpoint_of_ennreal_reciprocal
      (P₀star := P₀star) (P₁star := P₁star) hp0 hθ hrecip
  have hC : C < ∞ := by
    dsimp [C]
    exact ENNReal.mul_lt_top
      (ENNReal.rpow_lt_top_of_nonneg (sub_nonneg.mpr hθ.2.le) hA₀.ne)
      (ENNReal.rpow_lt_top_of_nonneg hθ.1.le hA₁.ne)
  apply exists_rawLpExtension_of_midpoint T hpenn0 ENNReal.ofReal_ne_top hC hTmeas
  intro f hf
  simpa only [C] using
    finiteSimpleRieszThorin_diagonal_eLpNorm_homogeneous
      (P₀ := P₀) (P₁ := P₁) (P₀star := P₀star) (P₁star := P₁star)
      T hA₀ hA₁ hTmeas hT₀ hT₁ hp hθ hmidInput f hf

/-- The smaller of two nonnegative endpoint constants is at most their
weighted geometric mean. -/
theorem min_le_weighted_geometricMean
    {a b θ : Real} (ha : 0 ≤ a) (hb : 0 ≤ b)
    (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1) :
    min a b ≤ a ^ (1 - θ) * b ^ θ := by
  by_cases ha0 : a = 0
  · rw [ha0]
    rw [min_eq_left hb]
    exact mul_nonneg (Real.rpow_nonneg (show (0 : Real) ≤ 0 by norm_num) _)
      (Real.rpow_nonneg hb _)
  by_cases hb0 : b = 0
  · rw [hb0]
    rw [min_eq_right ha]
    exact mul_nonneg (Real.rpow_nonneg ha _)
      (Real.rpow_nonneg (show (0 : Real) ≤ 0 by norm_num) _)
  have hapos : 0 < a := lt_of_le_of_ne ha (Ne.symm ha0)
  have hbpos : 0 < b := lt_of_le_of_ne hb (Ne.symm hb0)
  have hleft_exp : 0 ≤ 1 - θ := sub_nonneg.mpr hθ1
  by_cases hab : a ≤ b
  · rw [min_eq_left hab]
    calc
      a = a ^ ((1 - θ) + θ) := by
        rw [show (1 - θ) + θ = 1 by ring, Real.rpow_one]
      _ = a ^ (1 - θ) * a ^ θ := Real.rpow_add hapos _ _
      _ ≤ a ^ (1 - θ) * b ^ θ :=
        mul_le_mul_of_nonneg_left (Real.rpow_le_rpow ha hab hθ0)
          (Real.rpow_nonneg ha _)
  · have hba : b ≤ a := le_of_not_ge hab
    rw [min_eq_right hba]
    calc
      b = b ^ ((1 - θ) + θ) := by
        rw [show (1 - θ) + θ = 1 by ring, Real.rpow_one]
      _ = b ^ (1 - θ) * b ^ θ := Real.rpow_add hbpos _ _
      _ ≤ a ^ (1 - θ) * b ^ θ :=
        mul_le_mul_of_nonneg_right (Real.rpow_le_rpow hb hba hleft_exp)
          (Real.rpow_nonneg hb _)

/-- Convert a finite `eLpNorm` estimate between existing `Lp` elements to an
ordinary norm estimate. -/
theorem norm_le_toReal_mul_of_eLpNorm_le
    {α β E F : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedAddCommGroup F]
    {μ : Measure α} {ν : Measure β} {p C : ENNReal}
    (hC : C < ∞) (f : Lp E p μ) (g : Lp F p ν)
    (h : eLpNorm g p ν ≤ C * eLpNorm f p μ) :
    ‖g‖ ≤ C.toReal * ‖f‖ := by
  have hright : C * eLpNorm f p μ ≠ ∞ :=
    (ENNReal.mul_lt_top hC (Lp.eLpNorm_lt_top f)).ne
  have hreal : (eLpNorm g p ν).toReal ≤ (C * eLpNorm f p μ).toReal :=
    (ENNReal.toReal_le_toReal (Lp.eLpNorm_ne_top g) hright).mpr h
  rw [Lp.norm_def, Lp.norm_def]
  simpa only [ENNReal.toReal_mul] using hreal

/-- The direct degenerate `∞,∞ → ∞` branch.  Since simple functions need not
be dense in arbitrary `L∞`, its operator is supplied on full `L∞`. -/
theorem rieszThorin_top_top
    {α β E : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} {ν : Measure β}
    (T : Lp E ⊤ μ →L[Complex] Lp Complex ⊤ ν)
    {M₀ M₁ : ENNReal} {θ : Real}
    (hM₀ : M₀ < ⊤) (hM₁ : M₁ < ⊤)
    (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1)
    (hT₀ : ‖T‖ ≤ M₀.toReal) (hT₁ : ‖T‖ ≤ M₁.toReal) :
    ‖T‖ ≤ (M₀ ^ (1 - θ) * M₁ ^ θ).toReal := by
  rw [ENNReal.toReal_mul, ← ENNReal.toReal_rpow, ← ENNReal.toReal_rpow]
  exact le_trans (le_min hT₀ hT₁)
    (min_le_weighted_geometricMean ENNReal.toReal_nonneg ENNReal.toReal_nonneg hθ0 hθ1)

/-- Literal endpoint-estimate spelling of the degenerate `∞,∞ → ∞` branch. -/
theorem rieszThorin_top_top_of_eLpNorm
    {α β E : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} {ν : Measure β}
    (T : Lp E ⊤ μ →L[Complex] Lp Complex ⊤ ν)
    {M₀ M₁ : ENNReal} {θ : Real}
    (hM₀ : M₀ < ⊤) (hM₁ : M₁ < ⊤)
    (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1)
    (hT₀ : ∀ f, eLpNorm (T f) ⊤ ν ≤ M₀ * eLpNorm f ⊤ μ)
    (hT₁ : ∀ f, eLpNorm (T f) ⊤ ν ≤ M₁ * eLpNorm f ⊤ μ) :
    ‖T‖ ≤ (M₀ ^ (1 - θ) * M₁ ^ θ).toReal := by
  apply rieszThorin_top_top T hM₀ hM₁ hθ0 hθ1
  · exact T.opNorm_le_bound ENNReal.toReal_nonneg
      (fun f => norm_le_toReal_mul_of_eLpNorm_le hM₀ f (T f) (hT₀ f))
  · exact T.opNorm_le_bound ENNReal.toReal_nonneg
      (fun f => norm_le_toReal_mul_of_eLpNorm_le hM₁ f (T f) (hT₁ f))

/-- The direct degenerate `1,1 → 1` branch.  It constructs the bounded
extension from a raw simple-function operator and retains the sharp weighted
geometric endpoint constant. -/
theorem rieszThorin_one_one
    {α β E : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [NormedAddCommGroup E] [NormedSpace Complex E]
    {μ : Measure α} {ν : Measure β}
    (T : (SimpleFunc α E) →ₗ[Complex] (β → Complex))
    {A₀ A₁ : ENNReal} (hA₀ : A₀ < ∞) (hA₁ : A₁ < ∞)
    (hTmeas : ∀ u, AEStronglyMeasurable (T u) ν)
    (hT₀ : ∀ u, eLpNorm (T u) 1 ν ≤ A₀ * eLpNorm (u : α → E) 1 μ)
    (hT₁ : ∀ u, eLpNorm (T u) 1 ν ≤ A₁ * eLpNorm (u : α → E) 1 μ)
    {θ : Real} (hθ : θ ∈ Set.Icc (0 : Real) 1) :
    ∃ S : Lp E 1 μ →L[Complex] Lp Complex 1 ν,
      ‖S‖ ≤ (A₀ ^ (1 - θ) * A₁ ^ θ).toReal ∧
      ∀ (f : SimpleFunc α E) (hf : MemLp (f : α → E) 1 μ),
        MemLp (T f) 1 ν ∧ S (hf.toLp f) =ᵐ[ν] T f := by
  let C : ENNReal := min A₀ A₁
  have hC : C < ∞ := by
    dsimp [C]
    exact lt_of_le_of_lt (min_le_left _ _) hA₀
  have hmid : ∀ (f : SimpleFunc α E) (hf : MemLp (f : α → E) 1 μ),
      eLpNorm (T f) 1 ν ≤ C * eLpNorm (f : α → E) 1 μ := by
    intro f _
    dsimp [C]
    rcases le_total A₀ A₁ with hle | hle
    · simpa only [min_eq_left hle] using hT₀ f
    · simpa only [min_eq_right hle] using hT₁ f
  obtain ⟨S, hS, hRaw⟩ :=
    exists_rawLpExtension_of_midpoint T one_ne_zero one_ne_top hC hTmeas hmid
  refine ⟨S, ?_, hRaw⟩
  calc
    ‖S‖ ≤ C.toReal := hS
    _ = min A₀.toReal A₁.toReal := by
      dsimp [C]
      exact ENNReal.toReal_min hA₀.ne hA₁.ne
    _ ≤ A₀.toReal ^ (1 - θ) * A₁.toReal ^ θ :=
      min_le_weighted_geometricMean ENNReal.toReal_nonneg ENNReal.toReal_nonneg hθ.1 hθ.2
    _ = (A₀ ^ (1 - θ) * A₁ ^ θ).toReal := by
      rw [ENNReal.toReal_mul, ← ENNReal.toReal_rpow, ← ENNReal.toReal_rpow]

end FiniteSimple

