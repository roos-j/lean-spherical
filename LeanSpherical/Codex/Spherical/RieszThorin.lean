theorem operatorThreeLines_apply
    {X Y : Type*} [NormedAddCommGroup X] [NormedSpace Complex X]
    [NormedAddCommGroup Y] [NormedSpace Complex Y]
    {T : Complex → X →L[Complex] Y} {z : Complex} {A0 A1 l u : Real}
    (hlu : l < u) (hz : z ∈ verticalClosedStrip l u)
    (hanalytic : OperatorAnalyticFamily l u T)
    (hbounded : ∀ x (g : StrongDual Complex Y),
      BddAbove ((norm ∘ fun w => g (T w x)) '' verticalClosedStrip l u))
    (hleft : ∀ w ∈ Complex.re ⁻¹' ({l} : Set Real), ‖T w‖ ≤ A0)
    (hright : ∀ w ∈ Complex.re ⁻¹' ({u} : Set Real), ‖T w‖ ≤ A1)
    (x : X) :
    ‖T z x‖ ≤ (A0 * ‖x‖) ^ (1 - (z.re - l) / (u - l)) *
      (A1 * ‖x‖) ^ ((z.re - l) / (u - l)) := by
  apply operatorThreeLines_apply_of_dualBounds hlu hz hanalytic hbounded
  · intro w hw x g hg
    calc
      ‖g (T w x)‖ ≤ ‖g‖ * ‖T w x‖ := g.le_opNorm (T w x)
      _ ≤ ‖g‖ * (‖T w‖ * ‖x‖) :=
        mul_le_mul_of_nonneg_left ((T w).le_opNorm x) (norm_nonneg _)
      _ ≤ 1 * (‖T w‖ * ‖x‖) :=
        mul_le_mul_of_nonneg_right hg (mul_nonneg (norm_nonneg _) (norm_nonneg _))
      _ ≤ 1 * (A0 * ‖x‖) :=
        mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_right (hleft w hw) (norm_nonneg _)) zero_le_one
      _ = A0 * ‖x‖ := one_mul _
  · intro w hw x g hg
    calc
      ‖g (T w x)‖ ≤ ‖g‖ * ‖T w x‖ := g.le_opNorm (T w x)
      _ ≤ ‖g‖ * (‖T w‖ * ‖x‖) :=
        mul_le_mul_of_nonneg_left ((T w).le_opNorm x) (norm_nonneg _)
      _ ≤ 1 * (‖T w‖ * ‖x‖) :=
        mul_le_mul_of_nonneg_right hg (mul_nonneg (norm_nonneg _) (norm_nonneg _))
      _ ≤ 1 * (A1 * ‖x‖) :=
        mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_right (hright w hw) (norm_nonneg _)) zero_le_one
      _ = A1 * ‖x‖ := one_mul _

/-- The full operator-norm three-lines estimate for a normed-space-valued analytic
family.  This is the reusable scalar-pairing/Hahn--Banach core of the
Riesz--Thorin argument. -/
theorem operatorNormThreeLines
    {X Y : Type*} [NormedAddCommGroup X] [NormedSpace Complex X]
    [NormedAddCommGroup Y] [NormedSpace Complex Y]
    {T : Complex → X →L[Complex] Y} {z : Complex} {A0 A1 l u : Real}
    (hlu : l < u) (hz : z ∈ verticalClosedStrip l u)
    (hanalytic : OperatorAnalyticFamily l u T)
    (hbounded : ∀ x (g : StrongDual Complex Y),
      BddAbove ((norm ∘ fun w => g (T w x)) '' verticalClosedStrip l u))
    (hleft : ∀ w ∈ Complex.re ⁻¹' ({l} : Set Real), ‖T w‖ ≤ A0)
    (hright : ∀ w ∈ Complex.re ⁻¹' ({u} : Set Real), ‖T w‖ ≤ A1) :
    ‖T z‖ ≤ A0 ^ (1 - (z.re - l) / (u - l)) *
      A1 ^ ((z.re - l) / (u - l)) := by
  have hA0 : 0 ≤ A0 := by
    exact (norm_nonneg (T (l : Complex))).trans (hleft (l : Complex) (by simp))
  have hA1 : 0 ≤ A1 := by
    exact (norm_nonneg (T (u : Complex))).trans (hright (u : Complex) (by simp))
  apply ContinuousLinearMap.opNorm_le_bound _
    (mul_nonneg (Real.rpow_nonneg hA0 _) (Real.rpow_nonneg hA1 _))
  intro x
  by_cases hx : x = 0
  · simp [hx]
  have hxpos : 0 < ‖x‖ := norm_pos_iff.mpr hx
  calc
    ‖T z x‖ ≤ (A0 * ‖x‖) ^ (1 - (z.re - l) / (u - l)) *
        (A1 * ‖x‖) ^ ((z.re - l) / (u - l)) :=
      operatorThreeLines_apply hlu hz hanalytic hbounded hleft hright x
    _ = (A0 ^ (1 - (z.re - l) / (u - l)) *
          A1 ^ ((z.re - l) / (u - l))) * ‖x‖ := by
      rw [Real.mul_rpow hA0 (norm_nonneg _), Real.mul_rpow hA1 (norm_nonneg _)]
      have hrpow : ‖x‖ ^ (1 - (z.re - l) / (u - l)) *
          ‖x‖ ^ ((z.re - l) / (u - l)) = ‖x‖ := by
        rw [← Real.rpow_add hxpos]
        rw [show (1 - (z.re - l) / (u - l)) + (z.re - l) / (u - l) = 1 by ring]
        exact Real.rpow_one _
      calc
        A0 ^ (1 - (z.re - l) / (u - l)) * ‖x‖ ^ (1 - (z.re - l) / (u - l)) *
            (A1 ^ ((z.re - l) / (u - l)) * ‖x‖ ^ ((z.re - l) / (u - l))) =
            (A0 ^ (1 - (z.re - l) / (u - l)) * A1 ^ ((z.re - l) / (u - l))) *
              (‖x‖ ^ (1 - (z.re - l) / (u - l)) * ‖x‖ ^ ((z.re - l) / (u - l))) := by
              ring
        _ = (A0 ^ (1 - (z.re - l) / (u - l)) * A1 ^ ((z.re - l) / (u - l))) * ‖x‖ := by
              rw [hrpow]

