/-- In the plane, the Laplacian of `exp (i a ‖ξ‖)` has the exact radial
form used to cancel the leading `a²` term of the wave operator. -/
theorem laplacian_radial_phase_eq (a : Real)
    (x : Euclidean 2) (hx : x ≠ 0) :
    Laplacian.laplacian (fun y : Euclidean 2 =>
      Complex.exp (((a * ‖y‖ : Real) : Complex) * Complex.I)) x =
      Complex.exp (((a * ‖x‖ : Real) : Complex) * Complex.I) *
        (-((a ^ 2 : Real) : Complex) +
          ((a * ‖x‖⁻¹ : Real) : Complex) * Complex.I) := by
  classical
  let b := stdOrthonormalBasis Real (Euclidean 2)
  rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis
    (fun y : Euclidean 2 =>
      Complex.exp (((a * ‖y‖ : Real) : Complex) * Complex.I)) b]
  simp_rw [iteratedFDeriv_phase_diag a x _ hx]
  rw [← Finset.mul_sum]
  congr 1
  have hnorm : ∀ i, ‖b i‖ = 1 := fun i => b.norm_eq_one i
  simp_rw [hnorm]
  have hinner : ∑ i, (inner Real x (b i)) ^ 2 = ‖x‖ ^ 2 :=
    b.sum_sq_inner_left x
  have hinnerC : ∑ i, ((inner Real x (b i) : Real) : Complex) ^ 2 =
      ((‖x‖ ^ 2 : Real) : Complex) := by
    norm_cast
  let A : Complex := ((a * ‖x‖⁻¹ : Real) : Complex) * Complex.I
  let D : Complex := ((a * (‖x‖ ^ 2)⁻¹ * ‖x‖⁻¹ : Real) : Complex) * Complex.I
  have hterm : ∀ i,
      (((a * ‖x‖⁻¹ * inner Real x (b i) : Real) : Complex) * Complex.I) ^ 2 +
          ((a * (‖x‖⁻¹ * 1 ^ 2 -
            (‖x‖ ^ 2)⁻¹ * ‖x‖⁻¹ * (inner Real x (b i)) ^ 2) : Real) : Complex) *
              Complex.I =
        (A ^ 2 - D) * ((inner Real x (b i) : Real) : Complex) ^ 2 + A := by
    intro i
    dsimp only [A, D]
    push_cast
    ring
  simp_rw [hterm]
  rw [Finset.sum_add_distrib, ← Finset.mul_sum, hinnerC,
    Finset.sum_const, Finset.card_univ]
  norm_num [finrank_euclideanSpace_fin]
  have hnorm0 : ‖x‖ ≠ 0 := norm_ne_zero_iff.mpr hx
  have hnormC : (‖x‖ : Complex) ≠ 0 := by exact_mod_cast hnorm0
  dsimp only [A, D]
  push_cast
  rw [mul_pow, Complex.I_sq]
  field_simp [hnorm0, hnormC]
  ring

private theorem iteratedFDeriv_mul_diag_at
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace Real E]
    (u v : E → Complex) {x w : E}
    (hu : ContDiffAt Real 2 u x) (hv : ContDiffAt Real 2 v x) :
    iteratedFDeriv Real 2 (fun y => u y * v y) x ![w, w] =
      iteratedFDeriv Real 2 u x ![w, w] * v x +
        (fderiv Real u x w * fderiv Real v x w +
          fderiv Real v x w * fderiv Real u x w) +
        u x * iteratedFDeriv Real 2 v x ![w, w] := by
  have hu1 : DifferentiableAt Real u x := hu.differentiableAt (by norm_num)
  have hv1 : DifferentiableAt Real v x := hv.differentiableAt (by norm_num)
  have huD : DifferentiableAt Real (fderiv Real u) x :=
    (hu.fderiv_right (m := 1) (by norm_num)).differentiableAt one_ne_zero
  have hvD : DifferentiableAt Real (fderiv Real v) x :=
    (hv.fderiv_right (m := 1) (by norm_num)).differentiableAt one_ne_zero
  have huDw : DifferentiableAt Real (fun y => fderiv Real u y w) x :=
    huD.clm_apply (differentiableAt_const (c := w))
  have hvDw : DifferentiableAt Real (fun y => fderiv Real v y w) x :=
    hvD.clm_apply (differentiableAt_const (c := w))
  have huItD : DifferentiableAt Real (iteratedFDeriv Real 1 u) x :=
    hu.differentiableAt_iteratedFDeriv (by norm_num)
  have hvItD : DifferentiableAt Real (iteratedFDeriv Real 1 v) x :=
    hv.differentiableAt_iteratedFDeriv (by norm_num)
  have hsecond_u :
      fderiv Real (fun y => fderiv Real u y w) x w =
        iteratedFDeriv Real 2 u x ![w, w] := by
    symm
    convert huItD.iteratedFDeriv_succ_apply_left' (m := ![w, w]) using 1 <;>
      simp [iteratedFDeriv_one_apply]
  have hsecond_v :
      fderiv Real (fun y => fderiv Real v y w) x w =
        iteratedFDeriv Real 2 v x ![w, w] := by
    symm
    convert hvItD.iteratedFDeriv_succ_apply_left' (m := ![w, w]) using 1 <;>
      simp [iteratedFDeriv_one_apply]
  rw [iteratedFDeriv_two_apply]
  have hfirst : fderiv Real (fun y => u y * v y) =ᶠ[𝓝 x]
      fun y => u y • fderiv Real v y + v y • fderiv Real u y := by
    filter_upwards [hu.eventually (by norm_num), hv.eventually (by norm_num)] with y huy hvy
    exact fderiv_mul (huy.differentiableAt (by norm_num))
      (hvy.differentiableAt (by norm_num))
  rw [hfirst.fderiv_eq]
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one]
  let c : E → E →L[Real] Complex :=
    fun y => u y • fderiv Real v y + v y • fderiv Real u y
  have hc : DifferentiableAt Real c x :=
    (hu1.smul hvD).add (hv1.smul huD)
  have hEval : (fderiv Real c x w) w =
      fderiv Real (fun y => c y w) x w := by
    have h := hc.hasFDerivAt.clm_apply (hasFDerivAt_const (x := x) w)
    have h' : fderiv Real (fun y => c y w) x = (fderiv Real c x).flip w := by
      simpa using h.fderiv
    rw [h']
    rfl
  change (fderiv Real c x w) w = _
  rw [hEval]
  change fderiv Real
    ((fun y => u y * fderiv Real v y w) +
      (fun y => v y * fderiv Real u y w)) x w = _
  rw [fderiv_add]
  · change (fderiv Real ((fun y => u y) * (fun y => fderiv Real v y w)) x +
        fderiv Real ((fun y => v y) * (fun y => fderiv Real u y w)) x) w = _
    have hmul1 := fderiv_mul hu1 hvDw
    have hmul2 := fderiv_mul hv1 huDw
    rw [hmul1, hmul2]
    change u x * (fderiv Real (fun y => fderiv Real v y w) x w) +
        fderiv Real v x w * fderiv Real u x w +
        (v x * (fderiv Real (fun y => fderiv Real u y w) x w) +
          fderiv Real u x w * fderiv Real v x w) = _
    rw [hsecond_u, hsecond_v]
    ring
  · exact hu1.mul hvDw
  · exact hv1.mul huDw

/-- Local product rule for the planar Laplacian.  The hypotheses are local so
it applies directly to a radial phase away from the origin. -/
theorem laplacian_mul_at
    (u v : Euclidean 2 → Complex) {x : Euclidean 2}
    (hu : ContDiffAt Real 2 u x) (hv : ContDiffAt Real 2 v x) :
    Laplacian.laplacian (fun y => u y * v y) x =
      Laplacian.laplacian u x * v x +
        (∑ i, (fderiv Real u x (stdOrthonormalBasis Real (Euclidean 2) i) *
          fderiv Real v x (stdOrthonormalBasis Real (Euclidean 2) i) +
          fderiv Real v x (stdOrthonormalBasis Real (Euclidean 2) i) *
            fderiv Real u x (stdOrthonormalBasis Real (Euclidean 2) i))) +
        u x * Laplacian.laplacian v x := by
  let b := stdOrthonormalBasis Real (Euclidean 2)
  rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis
    (fun y => u y * v y) b]
  rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis u b]
  rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis v b]
  simp_rw [iteratedFDeriv_mul_diag_at u v hu hv]
  rw [Finset.sum_add_distrib]
  rw [Finset.sum_add_distrib]
  rw [Finset.sum_mul, Finset.mul_sum]

end

